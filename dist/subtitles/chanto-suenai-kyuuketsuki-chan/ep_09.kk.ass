Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.00,0:00:10.61,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:00:19.01,0:00:22.02,Default,,0,0,0,,Уф.
Dialogue: 0,0:00:22.02,0:00:41.70,Default,,0,0,0,,♬～
Dialogue: 0,0:00:41.70,0:00:46.04,Default,,0,0,0,,《Теңіз көңілді болды.
Dialogue: 0,0:00:46.04,0:00:50.21,Default,,0,0,0,,Жазғы демалыс әлі жақын.
Dialogue: 0,0:00:50.21,0:00:53.12,Default,,0,0,0,,Көптеген қызықты істер болатын сияқты! 》
Dialogue: 0,0:00:55.05,0:01:02.66,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:01:02.66,0:01:04.86,Default,,0,0,0,,《Мен солай ойладым...》
Dialogue: 0,0:01:06.83,0:01:09.53,Default,,0,0,0,,Әй, үлкен құс.
Dialogue: 0,0:01:11.50,0:01:14.60,Default,,0,0,0,,Сәлем Исикава мырза.
Dialogue: 0,0:01:21.51,0:01:25.01,Default,,0,0,0,,Күн ыстық. Иә.
Dialogue: 0,0:01:25.01,0:01:28.52,Default,,0,0,0,,Cooler Менің ойымша, бұл жақсы емес пе?
Dialogue: 0,0:01:31.02,0:01:35.19,Default,,0,0,0,,Сунтомоға дейін. Эй.
Dialogue: 0,0:01:35.19,0:01:37.86,Default,,0,0,0,,Әй, мұғалім, мен сені іздеп келейін.
Dialogue: 0,0:01:37.86,0:01:39.86,Default,,0,0,0,,Исикава мырза да келе ме?
Dialogue: 0,0:01:39.86,0:01:42.20,Default,,0,0,0,,Иә, мен ыстық соққы алып жатырмын.
Dialogue: 0,0:01:42.20,0:01:46.20,Default,,0,0,0,,Олай болса, мен сені бос сыныпта салқындатуға рұқсат етсем қалай болады?
Dialogue: 0,0:01:46.20,0:01:49.87,Default,,0,0,0,,Бүгінгі белсенділік сонда.
Dialogue: 0,0:01:49.87,0:01:52.07,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:03:40.35,0:03:43.85,Default,,0,0,0,,Жазғы демалыс болса да, адамдар аз емес пе?
Dialogue: 0,0:03:43.85,0:03:48.02,Default,,0,0,0,,Мереке деп аталса да, бұл мектеп фестиваліне дайындық уақыты болғандықтан шығар.
Dialogue: 0,0:03:48.02,0:03:50.03,Default,,0,0,0,,Шұғыл хабар, шұғыл хабар!
Dialogue: 0,0:03:50.03,0:03:53.70,Default,,0,0,0,,Исикава мырза өткен жылы алдыңғы мектебінде не істеді?
Dialogue: 0,0:03:53.70,0:03:58.37,Default,,0,0,0,,А, м, мен түсіндім...
Dialogue: 0,0:03:58.37,0:04:02.47,Default,,0,0,0,,Негізі өткен жылға дейін шетелде болдым➨
Dialogue: 0,0:04:02.47,0:04:05.97,Default,,0,0,0,,Оның үстіне мен жалғыз студент болдым.
Dialogue: 0,0:04:08.48,0:04:12.98,Default,,0,0,0,,⸨Ал, бұл ингредиент жүйкеге әсер етеді...⸩
Dialogue: 0,0:04:12.98,0:04:15.32,Default,,0,0,0,,Жарайды... дұрыс.
Dialogue: 0,0:04:15.32,0:04:18.15,Default,,0,0,0,,Керісінше, мектеп мерекесі қандай?
Dialogue: 0,0:04:18.15,0:04:21.66,Default,,0,0,0,,Ум, а.
Dialogue: 0,0:04:21.66,0:04:26.83,Default,,0,0,0,,Менің мектебімде бірінші сынып оқушылары негізінен аналогтық ойындар ойнайды...
Dialogue: 0,0:04:26.83,0:04:28.83,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:04:28.83,0:04:31.83,Default,,0,0,0,,Екінші курстан бастап студенттер мейрамхана аша алады.
Dialogue: 0,0:04:31.83,0:04:33.84,Default,,0,0,0,,Тамақ ішу!
Dialogue: 0,0:04:33.84,0:04:39.01,Default,,0,0,0,,Өткен жылы бізде қуырылған кеспе, карри, карумеяки, кәмпит алмалары және гиоза болды.
Dialogue: 0,0:04:39.01,0:04:41.01,Default,,0,0,0,,Ура!
Dialogue: 0,0:04:41.01,0:04:44.35,Default,,0,0,0,,Мүшелерді жинап, топ құратын адамдар да бар.
Dialogue: 0,0:04:44.35,0:04:47.52,Default,,0,0,0,,♬ (гитара)
Dialogue: 0,0:04:47.52,0:04:49.52,Default,,0,0,0,,Уау.
Dialogue: 0,0:04:49.52,0:04:52.19,Default,,0,0,0,,Сонымен қатар, афтер-партиде билеу➨
Dialogue: 0,0:04:52.19,0:04:58.36,Default,,0,0,0,,Клуб хабарландырулары, үрмелі аспаптар оркестрі, драма үйірмесі және, әрине, өнер үйірмесі.
Dialogue: 0,0:04:58.36,0:05:00.96,Default,,0,0,0,,Уау, бұл тамаша фестиваль!
Dialogue: 0,0:05:00.96,0:05:03.97,Default,,0,0,0,,Біз де… сынып мүшелеріміз➨
Dialogue: 0,0:05:03.97,0:05:06.64,Default,,0,0,0,,Өнер үйірмесінде не көрсету керектігін ойлауым керек.
Dialogue: 0,0:05:06.64,0:05:10.64,Default,,0,0,0,,Әй, сен таң қаларлықтай бос емессің, солай емес пе? Бірақ...
Dialogue: 0,0:05:10.64,0:05:14.31,Default,,0,0,0,,Жалғыз ғана жұмыс тақтасын жасау және...
Dialogue: 0,0:05:14.31,0:05:16.31,Default,,0,0,0,,Өйткені бұл осында. Бірақ бұл жақсырақ➨
Dialogue: 0,0:05:16.31,0:05:18.31,Default,,0,0,0,,Жақсы емес пе? иә? Шынымен бе?
Dialogue: 0,0:05:22.32,0:05:27.32,Default,,0,0,0,,Фу, бұл Исикава-сан мен Отори!
Dialogue: 0,0:05:27.32,0:05:29.32,Default,,0,0,0,,Не! ?
Dialogue: 0,0:05:29.32,0:05:33.33,Default,,0,0,0,,Иә? барлығы. Ишикава-сан, сен бүгін де сүйкімді көрінесің.
Dialogue: 0,0:05:33.33,0:05:35.66,Default,,0,0,0,,Иә. Исикава мырза!
Dialogue: 0,0:05:35.66,0:05:41.67,Default,,0,0,0,,Осы жерге жазыңыз! Апыр-ай!
Dialogue: 0,0:05:41.67,0:05:44.17,Default,,0,0,0,,Қол қоюға рұқсат етілмейді.
Dialogue: 0,0:05:44.17,0:05:46.84,Default,,0,0,0,,Төраға: Сіз қашан менеджер болдыңыз?
Dialogue: 0,0:05:46.84,0:05:50.18,Default,,0,0,0,,Өйткені бүгін жалғыз күн!
Dialogue: 0,0:05:50.18,0:05:52.18,Default,,0,0,0,,Басқаша айтқанда, Исикава мырза бүгін➨
Dialogue: 0,0:05:52.18,0:05:54.38,Default,,0,0,0,,Өйткені бүгін бізде бар нәрсе.
Dialogue: 0,0:05:56.35,0:05:59.19,Default,,0,0,0,,Ал, менде тағы бір карта бар.
Dialogue: 0,0:05:59.19,0:06:01.12,Default,,0,0,0,,Тұтынушыларға тыйым салынады.
Dialogue: 0,0:06:01.12,0:06:05.46,Default,,0,0,0,,Төраға! Кешіріңіз, мені жіберіңіз...
Dialogue: 0,0:06:05.46,0:06:08.63,Default,,0,0,0,,Екеуіңіз де үйірме жұмыстарына қатысасыз ба? Ой, драма үйірмесі.
Dialogue: 0,0:06:08.63,0:06:10.63,Default,,0,0,0,,Сонымен практикада.
Dialogue: 0,0:06:10.63,0:06:13.13,Default,,0,0,0,,Салқындатқыш қосылмаса тозақ болар деп ойладым.
Dialogue: 0,0:06:13.13,0:06:15.14,Default,,0,0,0,,Бұл да?
Dialogue: 0,0:06:15.14,0:06:18.14,Default,,0,0,0,,Зақымданған тек өнер бөлмесі ғана емес.
Dialogue: 0,0:06:18.14,0:06:20.14,Default,,0,0,0,,Кохон!
Dialogue: 0,0:06:20.14,0:06:23.65,Default,,0,0,0,,Дәл қазір төрағаға ұқсайтын біреу келді.
Dialogue: 0,0:06:25.98,0:06:29.65,Default,,0,0,0,,Кешіріңіз, бүгін барлық салқындатқыш тексерулер күні➨
Dialogue: 0,0:06:29.65,0:06:32.65,Default,,0,0,0,,Мен сізге айтуды ұмытып кетіппін! Өйткені.
Dialogue: 0,0:06:32.65,0:06:34.66,Default,,0,0,0,,Е! ?
Dialogue: 0,0:06:34.66,0:06:36.66,Default,,0,0,0,,Олар бір-біріне ұқсайды! Дұрыс па?
Dialogue: 0,0:06:36.66,0:06:41.00,Default,,0,0,0,,Бұл туралы. Ертең жөнделеді.
Dialogue: 0,0:06:41.00,0:06:44.33,Default,,0,0,0,,Ал, бүгін шыдамды бол!
Dialogue: 0,0:06:44.33,0:06:47.67,Default,,0,0,0,,Мен өз шегіме әлдеқашан жақындап қалдым.
Dialogue: 0,0:06:47.67,0:06:50.51,Default,,0,0,0,,А... Пиджактың кесірінен емес пе?
Dialogue: 0,0:06:50.51,0:06:54.34,Default,,0,0,0,,Аа, олар сол жерде жақсы нәрселерді таратып жатты.
Dialogue: 0,0:06:54.34,0:06:56.34,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:07:01.62,0:07:04.29,Default,,0,0,0,,Шыдамдылығыңыз үшін рахмет.
Dialogue: 0,0:07:04.29,0:07:06.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:06.29,0:07:08.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:08.29,0:07:11.29,Default,,0,0,0,,Хмм, өте ыстық!
Dialogue: 0,0:07:11.29,0:07:13.30,Default,,0,0,0,,Шындығында, бұл екінші.
Dialogue: 0,0:07:13.30,0:07:16.63,Default,,0,0,0,,Дәмді. Дәмді!
Dialogue: 0,0:07:16.63,0:07:19.47,Default,,0,0,0,,<Тоңазытқыш сәтті жөнделді>
Dialogue: 0,0:07:19.47,0:07:22.47,Default,,0,0,0,,Менго!
Dialogue: 0,0:07:22.47,0:07:27.64,Default,,0,0,0,,Ал, сыныптың орындауы шешілді➨
Dialogue: 0,0:07:27.64,0:07:30.31,Default,,0,0,0,,Костюм жасайық!
Dialogue: 0,0:07:30.31,0:07:32.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:32.65,0:07:45.33,Default,,0,0,0,,♬～
Dialogue: 0,0:07:45.33,0:07:47.33,Default,,0,0,0,,Менің үйімде ата-анам екеуі де жұмыс істейді➡
Dialogue: 0,0:07:47.33,0:07:51.83,Default,,0,0,0,,Сынып іші әбігер болды, оны табу үшін біраз уақыт кетті.
Dialogue: 0,0:07:51.83,0:07:53.84,Default,,0,0,0,,Қазір ғана құмар көздеріңмен мені шолып тұрдың ғой, иә?
Dialogue: 0,0:07:56.17,0:07:59.17,Default,,0,0,0,,Тағы не? Мен бәрін істеймін.
Dialogue: 0,0:07:59.17,0:08:01.61,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:08:01.61,0:08:04.78,Default,,0,0,0,,Бұл әлі де бар ма? Мен де саған көмектесемін.
Dialogue: 0,0:08:04.78,0:08:06.78,Default,,0,0,0,,Ал, рахмет. Маған беріңіз, маған беріңіз ....
Dialogue: 0,0:08:06.78,0:08:11.12,Default,,0,0,0,,Бірақ қайшы үлкен және қауіпті.
Dialogue: 0,0:08:11.12,0:08:13.62,Default,,0,0,0,,Жасағым келеді Жасағым келеді!
Dialogue: 0,0:08:13.62,0:08:17.79,Default,,0,0,0,,Қайшы жақсы! Маған қарыз бер, маған қарыз бер!
Dialogue: 0,0:08:17.79,0:08:20.10,Default,,0,0,0,,Хмм. Хмф!
Dialogue: 0,0:08:23.47,0:08:25.97,Default,,0,0,0,,Цукина-чан, сен сондай ынталысың.
Dialogue: 0,0:08:25.97,0:08:28.77,Default,,0,0,0,,Өйткені, бұл менің алғашқы мәдени фестивалім.
Dialogue: 0,0:08:30.81,0:08:34.31,Default,,0,0,0,,Барлығының қызметші киімдері дайын бұйымдардан құрастырылған ба?
Dialogue: 0,0:08:34.31,0:08:37.81,Default,,0,0,0,,Дұрыс, мен бір жағдайға байланысты үлгі жасадым.
Dialogue: 0,0:08:37.81,0:08:41.65,Default,,0,0,0,,Уау, сондай сүйкімді! (Кусуноки) Дұрыс па?
Dialogue: 0,0:08:41.65,0:08:43.65,Default,,0,0,0,,Миса күткендей!
Dialogue: 0,0:08:43.65,0:08:46.82,Default,,0,0,0,,Ишикава мені жақсы сезінеді.
Dialogue: 0,0:08:46.82,0:08:50.99,Default,,0,0,0,,Жоқ, өткен күні сыныптағы балалар маған бұны берді.
Dialogue: 0,0:08:50.99,0:08:52.99,Default,,0,0,0,,⸨Сен~жоқ!
Dialogue: 0,0:08:52.99,0:08:58.00,Default,,0,0,0,,Исикава ханымның қызметші киімін байсалды етіп көрсетіңіз!
Dialogue: 0,0:08:58.00,0:09:01.00,Default,,0,0,0,,Рахмет! ⸩
Dialogue: 0,0:09:03.44,0:09:05.77,Default,,0,0,0,,О, мен оны асыға күтемін!
Dialogue: 0,0:09:05.77,0:09:07.78,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:09:07.78,0:09:10.78,Default,,0,0,0,,Екеуіңе де лента жасап берейін деп ойлаймын.
Dialogue: 0,0:09:10.78,0:09:12.78,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:09:12.78,0:09:15.58,Default,,0,0,0,,Мен көп нәрсе жасаймын! О!
Dialogue: 0,0:09:24.46,0:09:26.46,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:09:26.46,0:09:29.46,Default,,0,0,0,,Жақсы! (Отори/Сакума) О!
Dialogue: 0,0:09:29.46,0:09:33.13,Default,,0,0,0,,Бұл керемет, Исикава мырза. Эххе!
Dialogue: 0,0:09:33.13,0:09:35.14,Default,,0,0,0,,Сіз өте шеберсіз.
Dialogue: 0,0:09:35.14,0:09:37.14,Default,,0,0,0,,Мен тұлыптарды жөндегендіктен болар.
Dialogue: 0,0:09:37.14,0:09:41.81,Default,,0,0,0,,Керемет! Бұл жақында бітеді деп ойлаймын!
Dialogue: 0,0:09:41.81,0:09:45.01,Default,,0,0,0,,Жарайды, жалғастырайық!
Dialogue: 0,0:09:49.48,0:09:51.49,Default,,0,0,0,,О!
Dialogue: 0,0:09:56.16,0:09:58.66,Default,,0,0,0,,Юбкалар үшін! ? Алыңыз!
Dialogue: 0,0:09:58.66,0:10:01.50,Default,,0,0,0,,Уау! Юбкаңызды көтермеңіз!
Dialogue: 0,0:10:01.50,0:10:06.67,Default,,0,0,0,,Сакума! Мен егжей-тегжейлі білмеймін ...
Dialogue: 0,0:10:06.67,0:10:09.50,Default,,0,0,0,,А, бәрі тынышталсын!
Dialogue: 0,0:10:09.50,0:10:11.51,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:10:11.51,0:10:14.18,Default,,0,0,0,,Сәлеметсіз бе. Сәлем.
Dialogue: 0,0:10:14.18,0:10:16.18,Default,,0,0,0,,Тыныш отырыңыз!
Dialogue: 0,0:10:18.35,0:10:22.18,Default,,0,0,0,,Күте тұрыңыз! Мен қазір лентаны алып беремін!
Dialogue: 0,0:10:22.18,0:10:25.35,Default,,0,0,0,,Сакума тоқта!
Dialogue: 0,0:10:25.35,0:10:30.36,Default,,0,0,0,,Әй, сен қызық көрінетін нәрсе істеп жатырсың.
Dialogue: 0,0:10:30.36,0:10:32.36,Default,,0,0,0,,Әй, төраға! ?
Dialogue: 0,0:10:32.36,0:10:36.53,Default,,0,0,0,,Ciao! Ол сыныпта жоқ, сондықтан мен оны іздедім.
Dialogue: 0,0:10:36.53,0:10:40.37,Default,,0,0,0,,Иә Кірістіру. рақмет сізге.
Dialogue: 0,0:10:40.37,0:10:42.54,Default,,0,0,0,,Мисузу-чан!
Dialogue: 0,0:10:42.54,0:10:46.04,Default,,0,0,0,,Цукина-чан, сен бүгін жақсы сияқтысың!
Dialogue: 0,0:10:46.04,0:10:48.38,Default,,0,0,0,,Иә, менде бәрі жақсы!
Dialogue: 0,0:10:48.38,0:10:50.38,Default,,0,0,0,,Сіз жақсы достарсыз ба?
Dialogue: 0,0:10:50.38,0:10:53.55,Default,,0,0,0,,Мен мектептерді ауыстырған кезде көрсеткен көмегіңіз үшін рахмет!
Dialogue: 0,0:10:53.55,0:10:56.55,Default,,0,0,0,,Иә. Солай ма?
Dialogue: 0,0:10:59.05,0:11:01.66,Default,,0,0,0,,Сәлем. рақмет сізге.
Dialogue: 0,0:11:01.66,0:11:05.83,Default,,0,0,0,,О? Костюмдер қолдан жасалған. Бұл тамаша!
Dialogue: 0,0:11:05.83,0:11:08.33,Default,,0,0,0,,Кусуноки мен үшін жасап жатыр.
Dialogue: 0,0:11:08.33,0:11:10.33,Default,,0,0,0,,Йосеяи.
Dialogue: 0,0:11:10.33,0:11:13.33,Default,,0,0,0,,Дұрыс, Ишикава, мен оны осы жерде сәйкестендіруді қалаймын.
Dialogue: 0,0:11:13.33,0:11:17.84,Default,,0,0,0,,Әлі бітірдіңіз бе? (Кусуноки) Әлі де біраз өрескел.
Dialogue: 0,0:11:17.84,0:11:21.34,Default,,0,0,0,,Керемет! Мен оны кигім келеді, оны кигім келеді! (Сакума) Менің де көргім келеді!
Dialogue: 0,0:11:21.34,0:11:25.51,Default,,0,0,0,,Мен дайындық бөлмесіне барамын. Иә.
Dialogue: 0,0:11:25.51,0:11:28.35,Default,,0,0,0,,Бұл әлі аяқталған жоқ, сондықтан үміт артпаңыз.
Dialogue: 0,0:11:28.35,0:11:30.65,Default,,0,0,0,,Бірақ мен оны асыға күтемін!
Dialogue: 0,0:11:33.02,0:11:37.03,Default,,0,0,0,,Уууу, керемет, жастар.
Dialogue: 0,0:11:39.03,0:11:41.03,Default,,0,0,0,,Жол! Сізге де ұнады ма?
Dialogue: 0,0:11:41.03,0:11:44.53,Default,,0,0,0,,Е-е, иә, қызық екен.
Dialogue: 0,0:11:44.53,0:11:46.53,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:11:48.70,0:11:51.54,Default,,0,0,0,,Цукина-чанның да жағдайы жақсы➨
Dialogue: 0,0:11:51.54,0:11:53.88,Default,,0,0,0,,Менің ойымша, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:11:53.88,0:11:59.05,Default,,0,0,0,,Мен уайымдап тұрмын... Исикава мырза маған ертерек қамқорлық жасады.
Dialogue: 0,0:11:59.05,0:12:02.48,Default,,0,0,0,,О, бұл? Айтайын дегенім, маған қамқор бол...
Dialogue: 0,0:12:02.48,0:12:05.49,Default,,0,0,0,,Цукина-чан мұнда келгенде➨
Dialogue: 0,0:12:05.49,0:12:07.99,Default,,0,0,0,,Шынымен ұялшақ және тыныш➨
Dialogue: 0,0:12:07.99,0:12:12.99,Default,,0,0,0,,Кейде мен сөйлесетінмін.
Dialogue: 0,0:12:12.99,0:12:19.83,Default,,0,0,0,,Мектепке кіргеннен кейін де сіз өте сақ болған сияқтысыз.
Dialogue: 0,0:12:19.83,0:12:24.67,Default,,0,0,0,,⸨Себебі оның мінезі сондай. Кейіпкер! ⸩
Dialogue: 0,0:12:24.67,0:12:27.58,Default,,0,0,0,,Қазір солай.
Dialogue: 0,0:12:30.68,0:12:35.02,Default,,0,0,0,,Белді аздап қысып, паннирлерге көбірек көлем қосу керек пе?
Dialogue: 0,0:12:35.02,0:12:37.02,Default,,0,0,0,,Мен тағы да шілтер қосқым келеді. Мен үйдемін!
Dialogue: 0,0:12:37.02,0:12:39.02,Default,,0,0,0,,Қош келдіңіз, Исикава мырза.
Dialogue: 0,0:12:39.02,0:12:44.53,Default,,0,0,0,,Ал, өлшем алып, киім ауыстырайық➨
Dialogue: 0,0:12:44.53,0:12:49.53,Default,,0,0,0,,Бұл таңғаларлық дене күшін қажет етеді...
Dialogue: 0,0:12:49.53,0:12:52.37,Default,,0,0,0,,Әй.
Dialogue: 0,0:12:52.37,0:12:55.54,Default,,0,0,0,,Исикава мырза, өтінемін.
Dialogue: 0,0:12:55.54,0:12:59.64,Default,,0,0,0,,Иә! Итадакимашу!
Dialogue: 0,0:13:14.32,0:13:19.33,Default,,0,0,0,,《Ол маған жақсырақ қарайды.》
Dialogue: 0,0:13:19.33,0:13:21.33,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:13:21.33,0:13:26.17,Default,,0,0,0,,Эй, Тацута-кун. Цукина-чан, анаңа да айт!
Dialogue: 0,0:13:26.17,0:13:30.17,Default,,0,0,0,,Ей, тәрбиеші, суретке түспе! Өйткені!
Dialogue: 0,0:13:30.17,0:13:32.67,Default,,0,0,0,,Present Delicious!
Dialogue: 0,0:13:32.67,0:13:37.08,Default,,0,0,0,,Бұл Үлкен құсқа сыйлық! рақмет сізге.
Dialogue: 0,0:13:48.02,0:13:51.53,Default,,0,0,0,,Пу, Исикава мырза. Иә?
Dialogue: 0,0:13:51.53,0:13:54.03,Default,,0,0,0,,Сіз оны кез келген уақытта кесіп тастай аласыз.
Dialogue: 0,0:13:54.03,0:13:57.03,Default,,0,0,0,,Әлі таң атпайды, істейтін іс бар ма?
Dialogue: 0,0:13:57.03,0:14:00.97,Default,,0,0,0,,Маған мектеп қақпасын безендіру тапсырылды. иә?
Dialogue: 0,0:14:00.97,0:14:04.64,Default,,0,0,0,,Сондықтан оған қанша уақыт кететінін білмеймін➨
Dialogue: 0,0:14:04.64,0:14:07.14,Default,,0,0,0,,Сонымен, біз бүгін тараймыз.
Dialogue: 0,0:14:07.14,0:14:10.65,Default,,0,0,0,,Мм... Мм!
Dialogue: 0,0:14:10.65,0:14:13.65,Default,,0,0,0,,Иә? Мен де көмектесе аламын ба?
Dialogue: 0,0:14:13.65,0:14:15.85,Default,,0,0,0,,О, шынымен бе?
Dialogue: 0,0:14:19.82,0:14:22.82,Default,,0,0,0,,Мен әкелдім! рақмет сізге.
Dialogue: 0,0:14:22.82,0:14:26.49,Default,,0,0,0,,Оотори Бұл жақсы ма? рақмет сізге.
Dialogue: 0,0:14:26.49,0:14:29.83,Default,,0,0,0,,Рахмет, Исикава мырза. Көбірек әкелейін бе?
Dialogue: 0,0:14:29.83,0:14:31.83,Default,,0,0,0,,Олай болса, тағы біреуін қалайсыз ба?
Dialogue: 0,0:14:31.83,0:14:36.67,Default,,0,0,0,,А, олай болса, мен оны ертерек бояумен бірге алып келдім.
Dialogue: 0,0:14:36.67,0:14:40.58,Default,,0,0,0,,Иә! ? Қашан? рақмет сізге.
Dialogue: 0,0:14:43.51,0:14:46.18,Default,,0,0,0,,Тағы не? Мен бәрін істеймін!
Dialogue: 0,0:14:46.18,0:14:49.68,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:14:49.68,0:14:51.69,Default,,0,0,0,,Содан кейін Исикава мырза➨
Dialogue: 0,0:14:51.69,0:14:53.69,Default,,0,0,0,,Егер сіз осында келсеңіз, мен бақытты болар едім.
Dialogue: 0,0:14:53.69,0:14:56.86,Default,,0,0,0,,Мочи! Оотори, мен саған көмектесемін!
Dialogue: 0,0:14:56.86,0:14:58.86,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:15:01.80,0:15:05.97,Default,,0,0,0,,Исикава мырза келді. Эх, Исикава мырза! ?
Dialogue: 0,0:15:05.97,0:15:08.30,Default,,0,0,0,,Мен көмектесуге келдім!
Dialogue: 0,0:15:08.30,0:15:10.30,Default,,0,0,0,,Сіз осы уақытқа дейін келдіңіз! ?
Dialogue: 0,0:15:10.30,0:15:13.47,Default,,0,0,0,,Рас! ? Бұл Исикава-сан!
Dialogue: 0,0:15:13.47,0:15:15.48,Default,,0,0,0,,Исикава мырза, егер сізге ұнаса!
Dialogue: 0,0:15:15.48,0:15:17.48,Default,,0,0,0,,Иә, бірақ менде әлі ештеңе жоқ...
Dialogue: 0,0:15:17.48,0:15:20.65,Default,,0,0,0,,Жарайды, жарайды! Өтінемін ішіңіз!
Dialogue: 0,0:15:20.65,0:15:22.65,Default,,0,0,0,,Ах, рахмет.
Dialogue: 0,0:15:22.65,0:15:24.65,Default,,0,0,0,,Бұл көмектеседі...
Dialogue: 0,0:15:24.65,0:15:27.16,Default,,0,0,0,,Ишикава-сан, бар болғаны жеткілікті.
Dialogue: 0,0:15:27.16,0:15:30.49,Default,,0,0,0,,Мен көмектесуге келдім. Уау, бұл Исикава-сан!
Dialogue: 0,0:15:30.49,0:15:32.49,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:32.49,0:15:34.50,Default,,0,0,0,,I…. (Оқушылар қыздар) Жеңдер, жеңдер!
Dialogue: 0,0:15:34.50,0:15:36.50,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:36.50,0:15:39.50,Default,,0,0,0,,Рахмет! Рақмет сізге!
Dialogue: 0,0:15:39.50,0:15:42.67,Default,,0,0,0,,Мм, мен ештеңе істеген жоқпын.
Dialogue: 0,0:15:42.67,0:15:45.01,Default,,0,0,0,,Исикава мырзаның келгеніне қуаныштымын.
Dialogue: 0,0:15:45.01,0:15:48.11,Default,,0,0,0,,Саған табынғаннан кейін өзімді жақсы сезінемін. Рақмет сізге!
Dialogue: 0,0:15:50.51,0:15:53.01,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:15:53.01,0:15:57.85,Default,,0,0,0,,Оотори Үзіліс... Е! ?
Dialogue: 0,0:15:57.85,0:15:59.85,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:15:59.85,0:16:02.12,Default,,0,0,0,,Әй, ә!
Dialogue: 0,0:16:02.12,0:16:04.13,Default,,0,0,0,,Ой.
Dialogue: 0,0:16:04.13,0:16:08.80,Default,,0,0,0,,Исикава мырза, сіз көп нәрсе алдыңыз.
Dialogue: 0,0:16:08.80,0:16:11.63,Default,,0,0,0,,Бұл мектеп қақпасының алдындағы ма?
Dialogue: 0,0:16:11.63,0:16:14.14,Default,,0,0,0,,No 1 сынып маңдайшасы.
Dialogue: 0,0:16:14.14,0:16:16.14,Default,,0,0,0,,Сіз де солай істеп жатырсыз ба?
Dialogue: 0,0:16:16.14,0:16:18.14,Default,,0,0,0,,Бізде адамдар жеткіліксіз, сондықтан бұл пайдалы.
Dialogue: 0,0:16:18.14,0:16:21.14,Default,,0,0,0,,Аа, мен мектеп қақпасындағыны бітірдім.
Dialogue: 0,0:16:21.14,0:16:23.98,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:16:23.98,0:16:30.15,Default,,0,0,0,,Үлкен құс! Үлкен құс!
Dialogue: 0,0:16:30.15,0:16:32.65,Default,,0,0,0,,Кешіріңіз! Мен мұның мұқабасын сұрай аламын ба? ?
Dialogue: 0,0:16:32.65,0:16:36.49,Default,,0,0,0,,Эй, мынаған қарама! ?
Dialogue: 0,0:16:36.49,0:16:38.49,Default,,0,0,0,,Қонақ қолжазбаны ала аламын ба?
Dialogue: 0,0:16:38.49,0:16:41.16,Default,,0,0,0,,Маған көмектесіңіз!
Dialogue: 0,0:16:41.16,0:16:45.07,Default,,0,0,0,,Эй... Эй!
Dialogue: 0,0:16:48.67,0:16:50.67,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:50.67,0:16:54.51,Default,,0,0,0,,Бұл көмектеседі! Жақсы рахмет!
Dialogue: 0,0:16:54.51,0:16:56.68,Default,,0,0,0,,Эй, сәл күте тұрыңыз! ?
Dialogue: 0,0:16:56.68,0:16:58.68,Default,,0,0,0,,Мен сұрағаныма өте қуаныштымын!
Dialogue: 0,0:16:58.68,0:17:01.62,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:17:01.62,0:17:04.79,Default,,0,0,0,,Үлкен құс…. ⚟Уау!
Dialogue: 0,0:17:04.79,0:17:06.79,Default,,0,0,0,,тармақ….
Dialogue: 0,0:17:06.79,0:17:09.79,Default,,0,0,0,,Жақсысың ба? Ах...
Dialogue: 0,0:17:09.79,0:17:12.46,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:17:12.46,0:17:15.63,Default,,0,0,0,,Жарайды. Мен оны қайтадан салуым керек.
Dialogue: 0,0:17:15.63,0:17:18.47,Default,,0,0,0,,Басыңды ұрдың ба? Сіз оята аласыз ба?
Dialogue: 0,0:17:18.47,0:17:20.47,Default,,0,0,0,,Мәселе жоқ, рахмет.
Dialogue: 0,0:17:20.47,0:17:22.80,Default,,0,0,0,,Сенің зардап шекпегеніңе қуаныштымын.
Dialogue: 0,0:17:22.80,0:17:27.98,Default,,0,0,0,,Бұл жерде қауіпті көрінеді, сондықтан аулаға көшейік.
Dialogue: 0,0:17:27.98,0:17:32.98,Default,,0,0,0,,Кешіріңіз, Исикава мырза. Алдымен үзіліс жасаңыз.
Dialogue: 0,0:17:32.98,0:17:34.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:37.99,0:17:40.82,Default,,0,0,0,,Хмм….
Dialogue: 0,0:17:40.82,0:17:59.01,Default,,0,0,0,,♬～
Dialogue: 0,0:17:59.01,0:18:00.94,Default,,0,0,0,,Хмм….
Dialogue: 0,0:18:00.94,0:18:02.94,Default,,0,0,0,,Ах, рахмет, Исикава мырза.
Dialogue: 0,0:18:02.94,0:18:06.61,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:18:06.61,0:18:08.62,Default,,0,0,0,,Сіздің қарныңыз ашты ма?
Dialogue: 0,0:18:11.79,0:18:14.12,Default,,0,0,0,,Бұл менің жолым!
Dialogue: 0,0:18:14.12,0:18:16.79,Default,,0,0,0,,Жұмысың көп, Үлкен құс!
Dialogue: 0,0:18:16.79,0:18:18.99,Default,,0,0,0,,Не? Ах.
Dialogue: 0,0:18:20.96,0:18:23.30,Default,,0,0,0,,Эй, мен бар күшімді салуым керек.
Dialogue: 0,0:18:23.30,0:18:25.30,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:18:29.47,0:18:32.64,Default,,0,0,0,,Шамадан тыс асып түсіп, құлап кетсем не істеуім керек?
Dialogue: 0,0:18:32.64,0:18:35.64,Default,,0,0,0,,А... О, жоқ.
Dialogue: 0,0:18:35.64,0:18:37.65,Default,,0,0,0,,Хмм!
Dialogue: 0,0:18:37.65,0:18:39.81,Default,,0,0,0,,Мен сенің аңқау екеніңді білемін, бірақ➨
Dialogue: 0,0:18:39.81,0:18:44.32,Default,,0,0,0,,Қиындыққа тап болсаңыз, көмектескіңіз келеді.
Dialogue: 0,0:18:48.49,0:18:51.99,Default,,0,0,0,,⸨Менімен жаттығуға қалай қарайсыз?
Dialogue: 0,0:18:51.99,0:18:54.60,Default,,0,0,0,,Қайта... жаттығу? ⸩
Dialogue: 0,0:18:59.93,0:19:01.94,Default,,0,0,0,,Исикава мырза?
Dialogue: 0,0:19:01.94,0:19:04.44,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:19:04.44,0:19:08.78,Default,,0,0,0,,Бірақ келесі жолы маған да сәлем айт!
Dialogue: 0,0:19:08.78,0:19:12.28,Default,,0,0,0,,О, тым жаман, бүгін де...
Dialogue: 0,0:19:12.28,0:19:16.95,Default,,0,0,0,,Біріншіден, мен үнемі Оториге сенемін!
Dialogue: 0,0:19:16.95,0:19:19.79,Default,,0,0,0,,Олай болмаса да, біз жақсы доспыз➨
Dialogue: 0,0:19:19.79,0:19:22.79,Default,,0,0,0,,Мен аздап сенім артқым келеді.
Dialogue: 0,0:19:28.30,0:19:31.97,Default,,0,0,0,,Жарайды, мен саған сенемін деп ойлаймын.
Dialogue: 0,0:19:31.97,0:19:35.64,Default,,0,0,0,,Маған қалдырыңыз! рақмет сізге.
Dialogue: 0,0:19:35.64,0:19:38.81,Default,,0,0,0,,Шындығында, мен осыдан кейін онымен жұмыс істеуді жоспарлап отырмын...
Dialogue: 0,0:19:38.81,0:19:41.48,Default,,0,0,0,,Жарайды, бірден!
Dialogue: 0,0:19:41.48,0:19:43.48,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:19:43.48,0:19:45.48,Default,,0,0,0,,Хахехехе….
Dialogue: 0,0:19:45.48,0:19:48.48,Default,,0,0,0,,Алдымен тамақтанып алайық, солай ма?
Dialogue: 0,0:19:48.48,0:19:50.48,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:57.49,0:20:01.66,Default,,0,0,0,,Кез келген адам бос па? Иә, не?
Dialogue: 0,0:20:01.66,0:20:04.50,Default,,0,0,0,,Интерьер де біршама жақсырақ көрінеді.
Dialogue: 0,0:20:04.50,0:20:07.67,Default,,0,0,0,,Ол кофеханаға көбірек ұқсай бастады.
Dialogue: 0,0:20:07.67,0:20:10.84,Default,,0,0,0,,Иә! Кешіріңіз!
Dialogue: 0,0:20:10.84,0:20:13.14,Default,,0,0,0,,Мына картон қорапты алыңыз!
Dialogue: 0,0:20:15.18,0:20:17.18,Default,,0,0,0,,Мен әкелемін!
Dialogue: 0,0:20:17.18,0:20:19.68,Default,,0,0,0,,Менің үйімде ата-анам екеуі де жұмыс істейді➡
Dialogue: 0,0:20:19.68,0:20:23.08,Default,,0,0,0,,Күшті! Күткендей.
Dialogue: 0,0:20:26.69,0:20:29.86,Default,,0,0,0,,Қағаз гүл аяқталды!
Dialogue: 0,0:20:29.86,0:20:32.86,Default,,0,0,0,,Иә! Сіз қолыңыздан келгеннің бәрін жасадыңыз!
Dialogue: 0,0:20:32.86,0:20:34.86,Default,,0,0,0,,Жақсы жұмыс.
Dialogue: 0,0:20:34.86,0:20:36.86,Default,,0,0,0,,Сізге тағы не керек?
Dialogue: 0,0:20:36.86,0:20:39.87,Default,,0,0,0,,Бұл шәйнек пе, әлде тіреуіш сияқты ма?
Dialogue: 0,0:20:39.87,0:20:41.87,Default,,0,0,0,,Содан кейін оны үйде де алуға болады.
Dialogue: 0,0:20:41.87,0:20:44.21,Default,,0,0,0,,Үйге кел! Ха! ?
Dialogue: 0,0:20:44.21,0:20:46.71,Default,,0,0,0,,Шынымен бе? Мен оны қарызға аламын ба?
Dialogue: 0,0:20:46.71,0:20:49.21,Default,,0,0,0,,Иә! Келгеніңізге қуаныштымын!
Dialogue: 0,0:20:49.21,0:20:52.05,Default,,0,0,0,,Цукина-чанның үйі Мен оны асыға күтемін!
Dialogue: 0,0:20:52.05,0:20:54.05,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:57.05,0:20:59.89,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:59.89,0:21:03.49,Default,,0,0,0,,Үлкен! Эй...
Dialogue: 0,0:21:03.49,0:21:08.10,Default,,0,0,0,,Бұл мен ойлағаннан да қалыпты жағдай. Ол таулардың тереңінде екені сөзсіз.
Dialogue: 0,0:21:15.84,0:21:17.84,Default,,0,0,0,,Қандай қиял! ?
Dialogue: 0,0:21:17.84,0:21:20.51,Default,,0,0,0,,Менің айтайын дегенім, бұл вампирдің үйі, солай ма?
Dialogue: 0,0:21:20.51,0:21:22.51,Default,,0,0,0,,Кез келген жағдайда.
Dialogue: 0,0:21:26.68,0:21:29.08,Default,,0,0,0,,Мен қиындыққа тап болдым!
Dialogue: 0,0:21:31.52,0:21:33.52,Default,,0,0,0,,Иә? Кіреберіс емес пе?
Dialogue: 0,0:21:33.52,0:21:35.86,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:21:35.86,0:21:38.06,Default,,0,0,0,,басыңыз!
Dialogue: 0,0:21:42.20,0:21:44.20,Default,,0,0,0,,Лифт.
Dialogue: 0,0:21:44.20,0:21:47.37,Default,,0,0,0,,Жүр, мін! (Сакума) Ух... иә.
Dialogue: 0,0:21:47.37,0:21:51.07,Default,,0,0,0,,Кешіріңіз. (Кусуноки) Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:22:03.65,0:22:07.05,Default,,0,0,0,,Tch... Underground~! ?
Dialogue: 0,0:22:08.55,0:22:14.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory