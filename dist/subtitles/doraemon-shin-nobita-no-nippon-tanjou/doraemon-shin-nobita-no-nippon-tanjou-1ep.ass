Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.41,0:00:40.58,Default,,0,0,0,,О
Dialogue: 0,0:00:42.70,0:00:44.21,Default,,0,0,0,,ммм
Dialogue: 0,0:00:44.50,0:00:45.54,Default,,0,0,0,,Уау
Dialogue: 0,0:00:46.83,0:00:48.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:50.25,0:00:51.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:51.88,0:00:53.13,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:00:57.30,0:00:57.97,Default,,0,0,0,,Хмм.
Dialogue: 0,0:00:58.93,0:01:00.97,Default,,0,0,0,,(Джозеф) Бұл Спидвагон қорының геликоптері.
Dialogue: 0,0:01:23.33,0:01:25.46,Default,,0,0,0,,Пухаха хаха
Dialogue: 0,0:01:26.21,0:01:27.71,Default,,0,0,0,,Урао
Dialogue: 0,0:01:27.83,0:01:30.00,Default,,0,0,0,,(жаңғырық дауыс)
Dialogue: 0,0:01:30.84,0:01:34.13,Default,,0,0,0,,Хахаха хехехе уау
Dialogue: 0,0:01:36.55,0:01:37.55,Default,,0,0,0,,Хаха
Dialogue: 0,0:01:39.30,0:01:40.39,Default,,0,0,0,,Ах
Dialogue: 0,0:01:46.56,0:01:48.23,Default,,0,0,0,,Ахххх
Dialogue: 0,0:01:53.19,0:01:54.44,Default,,0,0,0,,Тону
Dialogue: 0,0:01:56.90,0:01:58.20,Default,,0,0,0,,Каноэ
Dialogue: 0,0:01:59.91,0:02:01.62,Default,,0,0,0,,Тону
Dialogue: 0,0:02:02.62,0:02:04.54,Default,,0,0,0,,Каноэ
Dialogue: 0,0:02:04.91,0:02:07.12,Default,,0,0,0,,(жаңғырық дауыс)
Dialogue: 0,0:02:12.46,0:02:14.42,Default,,0,0,0,,Ууук
Dialogue: 0,0:02:14.75,0:02:17.05,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:02:20.84,0:02:22.97,Default,,0,0,0,,Иә? Ааа аа
Dialogue: 0,0:02:31.44,0:02:33.65,Default,,0,0,0,,Уф аааа
Dialogue: 0,0:02:34.65,0:02:36.03,Default,,0,0,0,,Уау~
Dialogue: 0,0:02:43.28,0:02:44.03,Default,,0,0,0,,Ах
Dialogue: 0,0:02:45.33,0:02:48.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:55.80,0:02:57.46,Default,,0,0,0,,Нобита
Dialogue: 0,0:02:57.71,0:03:01.34,Default,,0,0,0,,Мен айттым ғой, бұл неге болып жатыр?
Dialogue: 0,0:03:02.05,0:03:03.80,Default,,0,0,0,,Маған мұғалім телефон соқты.
Dialogue: 0,0:03:04.05,0:03:06.76,Default,,0,0,0,,Анам қаншалықты ұялды?
Dialogue: 0,0:03:07.22,0:03:09.73,Default,,0,0,0,,Ал бұл не? Бұл
Dialogue: 0,0:03:10.02,0:03:14.02,Default,,0,0,0,,Тест бос орындарға толы болса да, мен дудлдарды мұқият салуды қадағаладым.
Dialogue: 0,0:03:14.31,0:03:17.36,Default,,0,0,0,,Бұл граффити емес, бұл Pegasus.
Dialogue: 0,0:03:17.65,0:03:21.24,Default,,0,0,0,,Pegasus? А... Әйтеуір...
Dialogue: 0,0:03:21.49,0:03:23.49,Default,,0,0,0,,Өйткені мен тек арман сияқты нәрселерді ойлап жүрмін
Dialogue: 0,0:03:23.74,0:03:25.41,Default,,0,0,0,,Бұл не болады?
Dialogue: 0,0:03:25.66,0:03:28.45,Default,,0,0,0,,Бүгіннен бастап көшеге шығуға болмайды Ұйықтауға болмайды
Dialogue: 0,0:03:28.70,0:03:30.20,Default,,0,0,0,,Манга мен теледидарға тыйым салынады
Dialogue: 0,0:03:30.50,0:03:32.42,Default,,0,0,0,,Бұл өте рас...!
Dialogue: 0,0:03:32.67,0:03:33.88,Default,,0,0,0,,Уф
Dialogue: 0,0:03:35.29,0:03:36.42,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:03:38.84,0:03:41.55,Default,,0,0,0,,Мен бүгін шыдай алмаймын.
Dialogue: 0,0:03:41.84,0:03:45.60,Default,,0,0,0,,Мектепте де, үйде де ұрысудан шаршадым.
Dialogue: 0,0:03:46.51,0:03:49.64,Default,,0,0,0,,Мен үйден қашуды шештім.
Dialogue: 0,0:03:49.77,0:03:51.23,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:51.52,0:03:52.64,Default,,0,0,0,,Мм.
Dialogue: 0,0:03:52.89,0:03:55.48,Default,,0,0,0,,Тоқтама, тоқтағаннан пайда жоқ.
Dialogue: 0,0:03:55.73,0:03:57.36,Default,,0,0,0,,Мен тоқтамаймын.
Dialogue: 0,0:03:57.61,0:03:59.98,Default,,0,0,0,,Мен бәрібір жақында қайтамын.
Dialogue: 0,0:04:02.86,0:04:04.49,Default,,0,0,0,,Мені мазақ етпе
Dialogue: 0,0:04:04.74,0:04:07.33,Default,,0,0,0,,Бұл жолы менде жоспар бар.
Dialogue: 0,0:04:07.58,0:04:09.49,Default,,0,0,0,,Жоспар? қандай?
Dialogue: 0,0:04:09.99,0:04:13.46,Default,,0,0,0,,Негізі мен бұл туралы біраздан бері жасырын ойлап жүрмін.
Dialogue: 0,0:04:13.71,0:04:17.34,Default,,0,0,0,,Ешкімге сенбей өз бетімше өмір сүргім келеді.
Dialogue: 0,0:04:17.88,0:04:21.30,Default,,0,0,0,,Бізге аман қалу үшін не қажет? Яғни...
Dialogue: 0,0:04:21.59,0:04:23.13,Default,,0,0,0,,Тамақ, киім, баспана
Dialogue: 0,0:04:23.38,0:04:26.47,Default,,0,0,0,,Не киесің, не жейсің және тұратын үйің.
Dialogue: 0,0:04:26.80,0:04:29.81,Default,,0,0,0,,Эй, сен бірдеңе істеу керексің.
Dialogue: 0,0:04:30.06,0:04:32.60,Default,,0,0,0,,Дұрыс па? Дұрыс па? Сонымен, киім-кешек камерасымен
Dialogue: 0,0:04:32.85,0:04:35.44,Default,,0,0,0,,Маған дәмді үстел сөресі мен кемпинг капсуласын беріңіз~
Dialogue: 0,0:04:35.69,0:04:39.11,Default,,0,0,0,,Шок болды Сіз менің құралдарыма сенесіз бе?
Dialogue: 0,0:04:39.40,0:04:42.07,Default,,0,0,0,,Олар дос, солай ма? Олар ең жақсы достар, солай ма? Тоқта!
Dialogue: 0,0:04:43.57,0:04:45.53,Default,,0,0,0,,Неге ешкімге сенбейсің?
Dialogue: 0,0:04:45.78,0:04:47.53,Default,,0,0,0,,Ауыр сөз айтпа
Dialogue: 0,0:04:49.99,0:04:53.87,Default,,0,0,0,,Бостандық пен тәуелсіздікке алғашқы қадам жасайық
Dialogue: 0,0:04:55.08,0:04:56.42,Default,,0,0,0,,Ой-а-а
Dialogue: 0,0:05:00.00,0:05:02.17,Default,,0,0,0,,Бірінші қадамды жіберіп алды
Dialogue: 0,0:05:02.67,0:05:07.05,Default,,0,0,0,,Дораэмон жасаңыз
Dialogue: 0,0:05:07.72,0:05:13.73,Default,,0,0,0,,(♪〝Армандарыңды орында, Дораемон〞)
Dialogue: 0,0:06:30.05,0:06:36.06,Default,,0,0,0,,〜♪
Dialogue: 0,0:06:37.73,0:06:39.73,Default,,0,0,0,,Не туралы әбігер бар? иә?
Dialogue: 0,0:06:41.19,0:06:43.52,Default,,0,0,0,,Көптен бері көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,0:06:43.77,0:06:46.69,Default,,0,0,0,,Сіз сабақ оқымай-ақ ойнауды жоспарлап отырсыз ба?
Dialogue: 0,0:06:47.03,0:06:50.49,Default,,0,0,0,,Мен саған айтамын, мен кешкі асты өткізіп жатырмын.
Dialogue: 0,0:06:52.12,0:06:54.83,Default,,0,0,0,,Эй, мен қазір үйге бармаймын.
Dialogue: 0,0:06:55.16,0:06:56.58,Default,,0,0,0,,Нобита
Dialogue: 0,0:07:02.00,0:07:03.50,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:07:03.79,0:07:04.84,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:07:06.13,0:07:07.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:07.13,0:07:08.51,Default,,0,0,0,,Нобита Нобита-сан
Dialogue: 0,0:07:08.76,0:07:10.51,Default,,0,0,0,,Менің үйіме қош келдіңіз
Dialogue: 0,0:07:10.88,0:07:13.01,Default,,0,0,0,,Мен үйден қашып, осында көштім.
Dialogue: 0,0:07:13.30,0:07:17.77,Default,,0,0,0,,Сіз мектепке бармай-ақ еркін және жайлы өмір сүре аласыз.
Dialogue: 0,0:07:18.02,0:07:19.93,Default,,0,0,0,,Үйден қашпа.
Dialogue: 0,0:07:20.18,0:07:22.52,Default,,0,0,0,,Мен оны бір рет болса да аяқтамасам да.
Dialogue: 0,0:07:22.81,0:07:24.73,Default,,0,0,0,,Бұл жолы неше сағатқа созылады?
Dialogue: 0,0:07:24.98,0:07:28.03,Default,,0,0,0,,Хахахаха (Нобита) Күтіңіз~
Dialogue: 0,0:07:29.69,0:07:32.95,Default,,0,0,0,,Тексеріңіз, бәрі мені мазақ етеді.
Dialogue: 0,0:07:33.74,0:07:36.83,Default,,0,0,0,,Жарайды. Әзірше ұйықтап алайын.
Dialogue: 0,0:07:36.95,0:07:38.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:42.12,0:07:45.38,Default,,0,0,0,,Қиындыққа тап болдың, үйімді соқпа.
Dialogue: 0,0:07:45.63,0:07:47.09,Default,,0,0,0,,Бұл мәселе
Dialogue: 0,0:07:47.34,0:07:49.84,Default,,0,0,0,,Менің жеріме осындай нәрсе сал
Dialogue: 0,0:07:50.17,0:07:52.68,Default,,0,0,0,,Бос жердің иесі бар ма?
Dialogue: 0,0:07:52.93,0:07:54.14,Default,,0,0,0,,Әрине
Dialogue: 0,0:07:58.31,0:08:00.93,Default,,0,0,0,,Шизука-чан, соңында мен...
Dialogue: 0,0:08:01.18,0:08:04.44,Default,,0,0,0,,Артқы тауларда жаңа өмір бастауды шештім.
Dialogue: 0,0:08:04.69,0:08:06.61,Default,,0,0,0,,Шизука-чан, бізге қосылыңыз...
Dialogue: 0,0:08:06.86,0:08:08.90,Default,,0,0,0,,Уф аааа
Dialogue: 0,0:08:12.65,0:08:15.87,Default,,0,0,0,,Мен құладым~
Dialogue: 0,0:08:16.82,0:08:18.53,Default,,0,0,0,,Бұл жеке жер.
Dialogue: 0,0:08:18.78,0:08:20.91,Default,,0,0,0,,Мен қазір кетуім керек.
Dialogue: 0,0:08:21.16,0:08:23.08,Default,,0,0,0,,(Йотаро Куджо) Өкінішті, бірақ осы сапарда… Какёинге жарыстан шығудан басқа амал қалмауы мүмкін.
Dialogue: 0,0:08:24.04,0:08:26.75,Default,,0,0,0,,Иә? Эй, үйде ерте кездескенше.
Dialogue: 0,0:08:27.00,0:08:28.96,Default,,0,0,0,,Мен қайтып келген жоқпын, иә?
Dialogue: 0,0:08:29.38,0:08:31.51,Default,,0,0,0,,Ей, маған есікті кез келген жерден қарызға бер.
Dialogue: 0,0:08:31.76,0:08:32.80,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:08:33.05,0:08:35.76,Default,,0,0,0,,Сіз ешкімнің көмегінсіз өмір сүресіз, солай ма?
Dialogue: 0,0:08:36.05,0:08:38.93,Default,,0,0,0,,Өтінемін, бұл соңғы рет.
Dialogue: 0,0:08:40.72,0:08:42.35,Default,,0,0,0,,Баратын жеріңіз бар ма?
Dialogue: 0,0:08:42.64,0:08:44.94,Default,,0,0,0,,Иә, мен сізге жақын арада хат арқылы хабарлаймын.
Dialogue: 0,0:08:45.23,0:08:47.52,Default,,0,0,0,,Ал, сенімді болыңыз
Dialogue: 0,0:08:47.77,0:08:50.11,Default,,0,0,0,,Қолайсыздығы аз, қараусыз қалған ауыл
Dialogue: 0,0:08:50.36,0:08:53.07,Default,,0,0,0,,Мұнда ешкім шағымданбайды.
Dialogue: 0,0:08:53.44,0:08:56.16,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:08:56.41,0:08:58.12,Default,,0,0,0,,Қоймашы, арамшөп, т.б.
Dialogue: 0,0:08:58.41,0:09:01.54,Default,,0,0,0,,Мен сенің анаңның құлы емеспін.
Dialogue: 0,0:09:02.75,0:09:07.08,Default,,0,0,0,,Құл болып жұмыс істегеннен кейін осындай жолдарды айтасыз.
Dialogue: 0,0:09:08.83,0:09:10.00,Default,,0,0,0,,Уф
Dialogue: 0,0:09:10.63,0:09:12.26,Default,,0,0,0,,Анамның ақымақ!
Dialogue: 0,0:09:12.80,0:09:14.80,Default,,0,0,0,,Сәлем Ватат
Dialogue: 0,0:09:15.13,0:09:17.30,Default,,0,0,0,,Уау, Такеши!
Dialogue: 0,0:09:17.43,0:09:22.14,Default,,0,0,0,,Маған бұл енді ұнамайды. Мен үйден қашып бара жатырмын. Ой, жоқ~
Dialogue: 0,0:09:22.39,0:09:24.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:25.35,0:09:26.81,Default,,0,0,0,,Сунео Сунео
Dialogue: 0,0:09:27.10,0:09:28.81,Default,,0,0,0,,Сіз Нобитаны білмейсіз бе? Сіз Нобитаны көрдіңіз бе?
Dialogue: 0,0:09:29.11,0:09:29.86,Default,,0,0,0,,Жер
Dialogue: 0,0:09:30.11,0:09:31.77,Default,,0,0,0,,Сіз де қашқынсыз ба?
Dialogue: 0,0:09:32.02,0:09:34.32,Default,,0,0,0,,Джия, менің жүрегімнің досы
Dialogue: 0,0:09:34.65,0:09:37.74,Default,,0,0,0,,Mamatteba Ағылшын Қытай Француз тілі—
Dialogue: 0,0:09:37.99,0:09:39.49,Default,,0,0,0,,Мен саған бәрін үйреніп ал деп жатырмын~
Dialogue: 0,0:09:39.78,0:09:43.08,Default,,0,0,0,,Түсіндім, ата-ананың экологиясы осындай.
Dialogue: 0,0:09:43.33,0:09:46.16,Default,,0,0,0,,Олай десеңіз, бұл эго.
Dialogue: 0,0:09:46.46,0:09:49.00,Default,,0,0,0,,Эй, сен Нобита-санды көрмедің бе?
Dialogue: 0,0:09:49.25,0:09:51.63,Default,,0,0,0,,Не? Шизука-чан
Dialogue: 0,0:09:51.92,0:09:54.55,Default,,0,0,0,,Кез келген жағдайда, Шизука-чан да үйден қашып кетті ме?
Dialogue: 0,0:09:54.84,0:09:57.55,Default,,0,0,0,,Үйден қашып кеткенім көп емес.
Dialogue: 0,0:09:57.80,0:10:01.01,Default,,0,0,0,,Анамның үміті - қысым хаха...
Dialogue: 0,0:10:01.26,0:10:04.52,Default,,0,0,0,,Әркімнің өз уайымы бар.
Dialogue: 0,0:10:04.81,0:10:08.73,Default,,0,0,0,,Әйтеуір, Нобитаны тауып, қашқындар қатарына қосайық.
Dialogue: 0,0:10:08.98,0:10:10.69,Default,,0,0,0,,Иә
Dialogue: 0,0:10:11.98,0:10:13.94,Default,,0,0,0,,...
Dialogue: 0,0:10:14.19,0:10:17.78,Default,,0,0,0,,Иә? иә? Жақсы ма?
Dialogue: 0,0:10:18.82,0:10:21.57,Default,,0,0,0,,Ой, не істеп жатырсың?
Dialogue: 0,0:10:21.82,0:10:25.37,Default,,0,0,0,,Ауыл бөгет түбіне батып кетті.
Dialogue: 0,0:10:32.17,0:10:34.05,Default,,0,0,0,,Құрсаудан өтіңіз!
Dialogue: 0,0:10:39.09,0:10:42.22,Default,,0,0,0,,Бүкіл бөлмені су басқан жоқ па?
Dialogue: 0,0:10:42.51,0:10:44.89,Default,,0,0,0,,Иесі жоқ жер бар ма?
Dialogue: 0,0:10:45.18,0:10:46.77,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:10:47.02,0:10:49.89,Default,,0,0,0,,Мемлекет жеке меншіктен басқа барлық жердің иесі болып табылады.
Dialogue: 0,0:10:50.19,0:10:53.56,Default,,0,0,0,,Олай болса, топырақ жасайтын машинаны шығарыңыз.
Dialogue: 0,0:10:53.86,0:10:55.94,Default,,0,0,0,,Рұқсатсыз құралдарды жасамаңыз
Dialogue: 0,0:10:59.32,0:11:03.78,Default,,0,0,0,,Берілмеңіз. Үйден қашып құтыла алмайсың.
Dialogue: 0,0:11:04.03,0:11:06.83,Default,,0,0,0,,Тест тапсырмасын бірге шешейік
Dialogue: 0,0:11:09.21,0:11:12.58,Default,,0,0,0,,Жоқ, жоқ, мен міндетті түрде үйден қашамын~
Dialogue: 0,0:11:12.83,0:11:14.84,Default,,0,0,0,,Мен түсінбеймін, о...
Dialogue: 0,0:11:16.38,0:11:17.42,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:18.34,0:11:21.22,Default,,0,0,0,,Мен енді Дораемоннан сұрамаймын
Dialogue: 0,0:11:22.26,0:11:25.05,Default,,0,0,0,,Өйткені сіз айырмашылықты мүлдем білмейсіз.
Dialogue: 0,0:11:25.30,0:11:27.85,Default,,0,0,0,,Дора-чан, иә?
Dialogue: 0,0:11:28.10,0:11:29.31,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:11:30.98,0:11:32.44,Default,,0,0,0,,О, егеуқұйрық!
Dialogue: 0,0:11:33.23,0:11:36.44,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ, жоқ, жоқ...
Dialogue: 0,0:11:38.28,0:11:41.40,Default,,0,0,0,,Бұл егеуқұйрық емес, хомяк.
Dialogue: 0,0:11:42.07,0:11:44.78,Default,,0,0,0,,Бәрі жақсы, мені тез шығар.
Dialogue: 0,0:11:45.07,0:11:47.12,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:11:47.37,0:11:51.12,Default,,0,0,0,,Менеджер отбасылық сапарда болған кезде оған қамқорлық жасауды өтінді.
Dialogue: 0,0:11:51.37,0:11:55.08,Default,,0,0,0,,Қайсысы маңыздырақ, менеджер ме, әлде мен бе? О, тәңірім
Dialogue: 0,0:11:55.33,0:11:58.46,Default,,0,0,0,,Түсінбейтін нәрселерді айтпа.
Dialogue: 0,0:12:03.80,0:12:05.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:05.55,0:12:06.89,Default,,0,0,0,,О, міне сен (Нобита), иә?
Dialogue: 0,0:12:07.18,0:12:08.85,Default,,0,0,0,,Сәлем Нобита
Dialogue: 0,0:12:09.10,0:12:09.93,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:12:10.27,0:12:11.81,Default,,0,0,0,,Сіз үйден қашып, ауыр жұмыс істеп жатырсыз ба?
Dialogue: 0,0:12:12.10,0:12:13.69,Default,,0,0,0,,Сіз бірнеше пайдалы құралдарды алдыңыз, солай ма?
Dialogue: 0,0:12:13.94,0:12:15.35,Default,,0,0,0,,Біз де қосылайық.
Dialogue: 0,0:12:15.60,0:12:16.81,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:17.11,0:12:18.36,Default,,0,0,0,,Сізге бұл ұнамайды ма? (Нобита) Иә?
Dialogue: 0,0:12:18.61,0:12:20.36,Default,,0,0,0,,Сіз мұның бәрін өзіңізге сақтауға тырысасыз.
Dialogue: 0,0:12:20.61,0:12:22.15,Default,,0,0,0,,Бұл қорқынышты, Нобита-сан.
Dialogue: 0,0:12:22.45,0:12:25.11,Default,,0,0,0,,Жоқ, сатқын.
Dialogue: 0,0:12:25.36,0:12:27.32,Default,,0,0,0,,Күтіңіз~ Нобита-сан
Dialogue: 0,0:12:27.58,0:12:29.08,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:12:29.33,0:12:30.33,Default,,0,0,0,,Уф уау
Dialogue: 0,0:12:34.25,0:12:35.62,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:12:35.92,0:12:37.84,Default,,0,0,0,,Мен де қашып бара жатырмын
Dialogue: 0,0:12:39.09,0:12:43.17,Default,,0,0,0,,Бұл орын алған кезде жер мәселесі барған сайын өзекті бола бастайды.
Dialogue: 0,0:12:43.47,0:12:46.84,Default,,0,0,0,,Жапонияның әр бұрышының иесі бар.
Dialogue: 0,0:12:47.14,0:12:48.43,Default,,0,0,0,,Уф
Dialogue: 0,0:12:48.68,0:12:50.89,Default,,0,0,0,,Бұл біртүрлі деп ойламайсыз ба?
Dialogue: 0,0:12:51.14,0:12:52.93,Default,,0,0,0,,Жалпы айтқанда, жер зат емес.
Dialogue: 0,0:12:53.18,0:12:57.31,Default,,0,0,0,,Жер 4,6 миллиард жыл бұрын жаратылғаннан бері бар, солай емес пе?
Dialogue: 0,0:12:57.56,0:13:00.90,Default,,0,0,0,,Оны кейінірек келген адамның кесіп тастауы мүмкін емес.
Dialogue: 0,0:13:01.15,0:13:02.90,Default,,0,0,0,,О, әрине, біртүрлі.
Dialogue: 0,0:13:03.15,0:13:05.82,Default,,0,0,0,,Бірінші келген, бірінші қызмет ететін емес пе?
Dialogue: 0,0:13:06.07,0:13:08.16,Default,,0,0,0,,Бірінші келген, бірінші қызмет...
Dialogue: 0,0:13:08.49,0:13:09.87,Default,,0,0,0,,Кино түсірілім алаңында алыстан-ақ ол басты рөлдегі актерді байқады
Dialogue: 0,0:13:11.04,0:13:13.33,Default,,0,0,0,,Басқа ешкім жоқ уақытқа барыңыз
Dialogue: 0,0:13:14.37,0:13:17.71,Default,,0,0,0,,Жапонияда ешкім тұрмайтын уақыт болды, солай ма?
Dialogue: 0,0:13:18.00,0:13:21.25,Default,,0,0,0,,Сол дәуірге оралсақ, бүкіл Жапония біздікі болады.
Dialogue: 0,0:13:21.50,0:13:24.13,Default,,0,0,0,,Әй, болды, болды.
Dialogue: 0,0:13:25.93,0:13:28.68,Default,,0,0,0,,Жарайды, бөлме жинақы.
Dialogue: 0,0:13:28.93,0:13:31.01,Default,,0,0,0,,Бұл ұзақ әңгіме, енді барайық.
Dialogue: 0,0:13:31.31,0:13:33.68,Default,,0,0,0,,Оны итермеңіз, барлығы міне алады.
Dialogue: 0,0:13:34.27,0:13:36.10,Default,,0,0,0,,Фу~
Dialogue: 0,0:13:36.35,0:13:38.40,Default,,0,0,0,,Уау~ Мен үйден қашып жатырмын Үйден қашып барамын
Dialogue: 0,0:13:38.65,0:13:41.07,Default,,0,0,0,,Тарихтағы ең үлкен қашқын
Dialogue: 0,0:13:41.36,0:13:43.32,Default,,0,0,0,,Бұл мүлдем зорлық-зомбылық.
Dialogue: 0,0:13:43.61,0:13:46.90,Default,,0,0,0,,Айтпақшы, сіз қай дәуірге барасыз?
Dialogue: 0,0:13:47.20,0:13:51.91,Default,,0,0,0,,Сондықтан жапондар келгенше, көпке барғым келеді.
Dialogue: 0,0:13:52.20,0:13:55.33,Default,,0,0,0,,Бұл ақпарат енгізілмеген
Dialogue: 0,0:13:55.58,0:13:59.25,Default,,0,0,0,,Дораемон, ол болашақ робот болса да, білмейсің бе?
Dialogue: 0,0:13:59.54,0:14:01.92,Default,,0,0,0,,Мен бәрібір арзанмын.
Dialogue: 0,0:14:02.17,0:14:03.88,Default,,0,0,0,,Олай ойлама.
Dialogue: 0,0:14:04.13,0:14:08.13,Default,,0,0,0,,Қазбалар мен тас құралдарға қарап, олар 30 000 жыл бұрын болған сияқты.
Dialogue: 0,0:14:08.38,0:14:10.39,Default,,0,0,0,,Дәлелдер табылмағандықтан
Dialogue: 0,0:14:10.64,0:14:13.22,Default,,0,0,0,,Ол бұдан да ұзақ уақыт болған болуы мүмкін.
Dialogue: 0,0:14:13.47,0:14:14.72,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:14:14.97,0:14:18.06,Default,,0,0,0,,Көрші Қытайда 500 000 жыл бұрын...
Dialogue: 0,0:14:18.35,0:14:20.90,Default,,0,0,0,,Иә? Бұл жерде бір нәрсе дұрыс емес
Dialogue: 0,0:14:22.06,0:14:24.86,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:14:27.36,0:14:28.24,Default,,0,0,0,,Ах… Ах… Ааах…
Dialogue: 0,0:14:28.49,0:14:30.74,Default,,0,0,0,,Не болып жатыр? (Сунео) Құлап жатыр~
Dialogue: 0,0:14:30.99,0:14:32.95,Default,,0,0,0,,Төтенше жағдай Төтенше жағдай
Dialogue: 0,0:14:33.24,0:14:34.66,Default,,0,0,0,,Кеңістік-уақыт турбуленттілік генерациясы
Dialogue: 0,0:14:34.91,0:14:36.16,Default,,0,0,0,,Кеңістік-уақыт турбуленттігі?
Dialogue: 0,0:14:36.41,0:14:38.33,Default,,0,0,0,,Өзіңе тартылған соң, ешқашан артқа қайта алмайсың.
Dialogue: 0,0:14:38.58,0:14:42.00,Default,,0,0,0,,Ұстаңыз, мен бар жылдамдықпен өтемін
Dialogue: 0,0:14:48.84,0:14:50.05,Default,,0,0,0,,Артық емес~
Dialogue: 0,0:14:50.34,0:14:51.59,Default,,0,0,0,,Құлау~
Dialogue: 0,0:14:51.80,0:14:53.93,Default,,0,0,0,,Джиджи…
Dialogue: 0,0:14:56.22,0:14:59.06,Default,,0,0,0,,Турбо өшірілген.
Dialogue: 0,0:15:00.60,0:15:01.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:02.10,0:15:04.23,Default,,0,0,0,,Кеңістік-уақыт турбуленттігінен аман қалды
Dialogue: 0,0:15:04.48,0:15:06.32,Default,,0,0,0,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,0:15:06.61,0:15:09.32,Default,,0,0,0,,Кеңістік-уақыт әлі де тұрақсыз
Dialogue: 0,0:15:09.49,0:15:10.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:10.24,0:15:12.28,Default,,0,0,0,,Баратын жеріңізді ертерек шешіңіз.
Dialogue: 0,0:15:12.53,0:15:16.24,Default,,0,0,0,,60 000 жыл бұрын, 30 000 жыл бұрынғыдан екі есе көп емес пе?
Dialogue: 0,0:15:16.49,0:15:19.54,Default,,0,0,0,,Тек сенімді болу үшін тағы 10 000 жыл артқа оралайық.
Dialogue: 0,0:15:20.12,0:15:23.50,Default,,0,0,0,,Жапонияға 70 000 жыл бұрын қабылданған шешім
Dialogue: 0,0:15:28.30,0:15:31.18,Default,,0,0,0,,Фу~ Фу~
Dialogue: 0,0:15:32.47,0:15:34.43,Default,,0,0,0,,Яй 70 000 жыл Фу~
Dialogue: 0,0:15:34.68,0:15:36.60,Default,,0,0,0,,Ия иә иә
Dialogue: 0,0:15:38.43,0:15:39.81,Default,,0,0,0,,Уау~
Dialogue: 0,0:15:55.49,0:15:56.99,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:15:57.28,0:15:59.54,Default,,0,0,0,,Қандай ашық жасыл түс!
Dialogue: 0,0:15:59.79,0:16:01.21,Default,,0,0,0,,Ауасы дәмді
Dialogue: 0,0:16:02.16,0:16:03.54,Default,,0,0,0,,кең
Dialogue: 0,0:16:05.33,0:16:07.71,Default,,0,0,0,,Бұл өзіміздің Жапония.
Dialogue: 0,0:16:08.13,0:16:10.34,Default,,0,0,0,,Кел, осы жерде жұмақ жасайық.
Dialogue: 0,0:16:10.59,0:16:12.30,Default,,0,0,0,,Жарайды (Сунэо) Yahoo.
Dialogue: 0,0:16:13.34,0:16:14.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:18.18,0:16:19.18,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:19.43,0:16:21.43,Default,,0,0,0,,Жануарлар бұзық болса жаман.
Dialogue: 0,0:16:21.73,0:16:23.94,Default,,0,0,0,,Ол уақыт машинасын тығып жатыр.
Dialogue: 0,0:16:24.19,0:16:24.90,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:16:25.19,0:16:26.52,Default,,0,0,0,,Бұл домбыра ұнтағы.
Dialogue: 0,0:16:26.77,0:16:29.82,Default,,0,0,0,,Бұны қолданған кезде айнала судай болады.
Dialogue: 0,0:16:30.36,0:16:32.40,Default,,0,0,0,,Қараңыз, қараңыз.
Dialogue: 0,0:16:32.70,0:16:33.78,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:16:34.20,0:16:35.91,Default,,0,0,0,,Hacksion
Dialogue: 0,0:16:36.62,0:16:38.33,Default,,0,0,0,,Күрсін, ақымақ суық емес пе?
Dialogue: 0,0:16:38.58,0:16:39.91,Default,,0,0,0,,Иә
Dialogue: 0,0:16:40.20,0:16:42.04,Default,,0,0,0,,Мен дірілдеп тұрмын.
Dialogue: 0,0:16:42.29,0:16:45.08,Default,,0,0,0,,70 000 жыл бұрын бұл 4-ші плейстоцен болды.
Dialogue: 0,0:16:45.33,0:16:47.96,Default,,0,0,0,,Вурм мұз дәуірі басталған уақыт шамасында ма?
Dialogue: 0,0:16:48.21,0:16:49.34,Default,,0,0,0,,Мұз дәуірі дегеніміз не?
Dialogue: 0,0:16:49.59,0:16:50.92,Default,,0,0,0,,Мұздық таралады
Dialogue: 0,0:16:51.13,0:16:54.30,Default,,0,0,0,,Бүкіл жердің суыған кезі.
Dialogue: 0,0:16:54.55,0:16:57.09,Default,,0,0,0,,Мен суық жұмақты қаламаймын.
Dialogue: 0,0:16:57.34,0:17:00.56,Default,,0,0,0,,Мен бұл туралы кейінірек бірдеңе істеймін.
Dialogue: 0,0:17:00.89,0:17:02.89,Default,,0,0,0,,Мұның қандай әлем болғанын қалайсыз?
Dialogue: 0,0:17:03.18,0:17:05.14,Default,,0,0,0,,Біз әркімнің идеясын іздейміз
Dialogue: 0,0:17:05.44,0:17:06.35,Default,,0,0,0,,Ұйқыдағы қонақ үй
Dialogue: 0,0:17:06.65,0:17:07.48,Default,,0,0,0,,Ойын орталығы
Dialogue: 0,0:17:07.73,0:17:09.40,Default,,0,0,0,,Концерт залы
Dialogue: 0,0:17:09.65,0:17:11.44,Default,,0,0,0,,Менің арманым жоқ.
Dialogue: 0,0:17:11.73,0:17:15.15,Default,,0,0,0,,Көл жағасын гүлзарға айналдырсақ қалай болады?
Dialogue: 0,0:17:15.40,0:17:16.45,Default,,0,0,0,,Жақсы~
Dialogue: 0,0:17:16.91,0:17:19.28,Default,,0,0,0,,Аспанда үлкен кемпірқосақ ілулі тұр
Dialogue: 0,0:17:19.53,0:17:20.41,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:17:20.66,0:17:22.58,Default,,0,0,0,,Аврора түнде жарқырайды
Dialogue: 0,0:17:22.83,0:17:24.37,Default,,0,0,0,,Мүмкін болса да
Dialogue: 0,0:17:24.62,0:17:26.50,Default,,0,0,0,,Тексеріңіз, бұл қызықсыз.
Dialogue: 0,0:17:26.75,0:17:28.63,Default,,0,0,0,,Барайық (Сунео) Иә.
Dialogue: 0,0:17:28.88,0:17:30.09,Default,,0,0,0,,Уф, күте тұрыңыз~
Dialogue: 0,0:17:30.34,0:17:32.21,Default,,0,0,0,,Біз қалаған нәрсе
Dialogue: 0,0:17:32.46,0:17:34.21,Default,,0,0,0,,Толығырақ қызықты оқиғалар
Dialogue: 0,0:17:34.47,0:17:37.13,Default,,0,0,0,,Иә, жабайы және қарабайыр
Dialogue: 0,0:17:37.76,0:17:41.10,Default,,0,0,0,,Ах ха ха Джан мен саған суретке түсемін.
Dialogue: 0,0:17:41.39,0:17:44.06,Default,,0,0,0,,Шынымен бе? Керемет суретке түсіріңіз
Dialogue: 0,0:17:44.31,0:17:47.14,Default,,0,0,0,,Түпнұсқа жақсы болмағандықтан, мен барамын.
Dialogue: 0,0:17:47.44,0:17:48.98,Default,,0,0,0,,Иә Чи…
Dialogue: 0,0:17:49.23,0:17:50.48,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:17:50.77,0:17:51.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:52.02,0:17:53.73,Default,,0,0,0,,Джа Джан артқа оралды
Dialogue: 0,0:17:53.98,0:17:55.15,Default,,0,0,0,,Иә? артында?
Dialogue: 0,0:17:55.44,0:17:56.99,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:00.03,0:18:02.49,Default,,0,0,0,,Бұл бизон~
Dialogue: 0,0:18:03.66,0:18:05.16,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:05.41,0:18:06.66,Default,,0,0,0,,Уау
Dialogue: 0,0:18:08.42,0:18:10.67,Default,,0,0,0,,Ах~
Dialogue: 0,0:18:10.96,0:18:12.84,Default,,0,0,0,,Маған көмектесіңіз~
Dialogue: 0,0:18:13.13,0:18:13.80,Default,,0,0,0,,«Қиын екен.»
Dialogue: 0,0:18:14.05,0:18:17.34,Default,,0,0,0,,Өздігіңнен шығасың, Тореадор!
Dialogue: 0,0:18:21.51,0:18:23.01,Default,,0,0,0,,Оле
Dialogue: 0,0:18:25.14,0:18:26.06,Default,,0,0,0,,Оле
Dialogue: 0,0:18:26.31,0:18:29.35,Default,,0,0,0,,Таңғажайып, корридашы сияқты
Dialogue: 0,0:18:29.65,0:18:30.85,Default,,0,0,0,,Уау
Dialogue: 0,0:18:35.15,0:18:35.94,Default,,0,0,0,,Оле
Dialogue: 0,0:18:37.49,0:18:38.53,Default,,0,0,0,,Оле
Dialogue: 0,0:18:39.66,0:18:43.53,Default,,0,0,0,,Маған қалдырсаң, мені алысқа апарады.
Dialogue: 0,0:18:44.91,0:18:47.45,Default,,0,0,0,,Қарапайым өмір жиынтығы!
Dialogue: 0,0:18:48.04,0:18:50.37,Default,,0,0,0,,Бұл киім кондиционер костюмі деп аталады.
Dialogue: 0,0:18:50.67,0:18:54.38,Default,,0,0,0,,Ол сіздің денеңіздің айналасындағы ауаны жылытуы немесе салқындатуы мүмкін.
Dialogue: 0,0:18:54.67,0:18:56.21,Default,,0,0,0,,Бұл рас, жылы.
Dialogue: 0,0:18:56.51,0:18:57.46,Default,,0,0,0,,Гах-гах-гах
Dialogue: 0,0:18:58.01,0:19:00.88,Default,,0,0,0,,Бұл тас найза өте жеңіл, бірақ
Dialogue: 0,0:19:01.14,0:19:02.89,Default,,0,0,0,,Бұл мүлде ауырмайды
Dialogue: 0,0:19:03.47,0:19:04.85,Default,,0,0,0,,Бұл түйме дегеніміз не?
Dialogue: 0,0:19:05.35,0:19:06.47,Default,,0,0,0,,...
Dialogue: 0,0:19:06.68,0:19:10.19,Default,,0,0,0,,Бұл соққы таяқшасы. Ол тіпті пілді де таң қалдырады.
Dialogue: 0,0:19:10.44,0:19:12.27,Default,,0,0,0,,Алдымен маған айт...
Dialogue: 0,0:19:12.56,0:19:13.44,Default,,0,0,0,,Ах~
Dialogue: 0,0:19:13.69,0:19:16.86,Default,,0,0,0,,Жарайды, мен бүгіннен бастап осында тұрамын.
Dialogue: 0,0:19:17.15,0:19:19.24,Default,,0,0,0,,Біріншіден, қайда тұру керектігін шешу керек
Dialogue: 0,0:19:19.53,0:19:22.74,Default,,0,0,0,,Үй, жарай ма?
Dialogue: 0,0:19:23.03,0:19:25.70,Default,,0,0,0,,Менің жерім мына жерден
Dialogue: 0,0:19:25.95,0:19:28.20,Default,,0,0,0,,А, сен лассың, Сунео.
Dialogue: 0,0:19:28.45,0:19:29.25,Default,,0,0,0,,Қулық
Dialogue: 0,0:19:29.87,0:19:33.08,Default,,0,0,0,,Мына жаққа кел, 1000 цубо, бұл менікі.
Dialogue: 0,0:19:33.46,0:19:35.59,Default,,0,0,0,,Мен мұнда 10 000 цубомын.
Dialogue: 0,0:19:35.84,0:19:37.46,Default,,0,0,0,,10 000... Бұл менің жерім ғана.
Dialogue: 0,0:19:37.71,0:19:40.26,Default,,0,0,0,,Urusee (Нобита) Менің танысу күнім
Dialogue: 0,0:19:40.55,0:19:42.13,Default,,0,0,0,,Қандай аянышты хаха
Dialogue: 0,0:19:42.55,0:19:44.76,Default,,0,0,0,,Қарабайыр дәуірге не үшін келдің?
Dialogue: 0,0:19:45.01,0:19:46.93,Default,,0,0,0,,Жер көп
Dialogue: 0,0:19:47.18,0:19:49.06,Default,,0,0,0,,Жоқ, бұл ұят.
Dialogue: 0,0:19:49.43,0:19:51.98,Default,,0,0,0,,Ол жағы жақсы, жар оңтүстік-шығысқа қарайды
Dialogue: 0,0:19:52.27,0:19:54.10,Default,,0,0,0,,Күн де ашық сияқты.
Dialogue: 0,0:19:54.94,0:19:58.94,Default,,0,0,0,,Осы жерден шұңқыр қазайық. Бұл тас дәуірі сияқты, солай емес пе?
Dialogue: 0,0:19:59.19,0:20:02.07,Default,,0,0,0,,Сіз мұны қазып жатырсыз ба? Бұл жалықтырады
Dialogue: 0,0:20:03.53,0:20:05.49,Default,,0,0,0,,Жеңіл күрек!
Dialogue: 0,0:20:05.74,0:20:08.49,Default,,0,0,0,,Неліктен мұны қолданбайсыз? (Нобита)
Dialogue: 0,0:20:09.70,0:20:10.37,Default,,0,0,0,,О~
Dialogue: 0,0:20:10.87,0:20:14.33,Default,,0,0,0,,Тіпті қатты тау жыныстарын да тофу сияқты оңай қазып алуға болады.
Dialogue: 0,0:20:14.58,0:20:16.00,Default,,0,0,0,,Басқа да көптеген нәрселер бар.
Dialogue: 0,0:20:16.25,0:20:17.04,Default,,0,0,0,,Уау~
Dialogue: 0,0:20:17.29,0:20:20.30,Default,,0,0,0,,Қызық көрінеді, мен жасайын
Dialogue: 0,0:20:20.76,0:20:24.09,Default,,0,0,0,,Айла, менікі, маған бер.
Dialogue: 0,0:20:25.09,0:20:27.97,Default,,0,0,0,,Ұсқынсыз ұсқынсыз барлық жерде
Dialogue: 0,0:20:28.64,0:20:29.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:30.10,0:20:32.43,Default,,0,0,0,,Ауыр жүкті маған қалдырыңыз.
Dialogue: 0,0:20:32.73,0:20:33.77,Default,,0,0,0,,Сіз шағымданасыз ба?
Dialogue: 0,0:20:34.02,0:20:36.27,Default,,0,0,0,,Министр сенімен төбелесіп жатыр... Ах...
Dialogue: 0,0:20:36.61,0:20:39.48,Default,,0,0,0,,Құрылыс министрі болып тағайындалмау
Dialogue: 0,0:20:39.78,0:20:41.24,Default,,0,0,0,,Құрмет
Dialogue: 0,0:20:41.90,0:20:44.66,Default,,0,0,0,,Келесі, Hanazono цилиндрі!
Dialogue: 0,0:20:44.91,0:20:47.57,Default,,0,0,0,,Ұсақ тұқымдар газ тәрізді шашылады
Dialogue: 0,0:20:47.82,0:20:50.12,Default,,0,0,0,,Аз уақытта гүл баққа айналады
Dialogue: 0,0:20:50.37,0:20:51.83,Default,,0,0,0,,Маған орындауға рұқсат етіңіз
Dialogue: 0,0:20:52.12,0:20:54.71,Default,,0,0,0,,Шизука-чан – Қоршаған ортаны қорғау министрі
Dialogue: 0,0:20:56.00,0:20:56.67,Default,,0,0,0,,Мен де
Dialogue: 0,0:20:56.96,0:20:58.46,Default,,0,0,0,,Не қалды?
Dialogue: 0,0:20:58.59,0:20:59.92,Default,,0,0,0,,Ауыл және орман шаруашылығы министрі
Dialogue: 0,0:21:01.21,0:21:03.01,Default,,0,0,0,,Далада мейрамхана!
Dialogue: 0,0:21:03.26,0:21:04.51,Default,,0,0,0,,Мұнда келу қандай да бір қорқынышты іс сияқты…
Dialogue: 0,0:21:04.76,0:21:08.85,Default,,0,0,0,,Бұл Нобита үшін жарамсыз. Олар жыл сайын таңғы даңқты өлтірмейді ме?
Dialogue: 0,0:21:09.10,0:21:10.26,Default,,0,0,0,,Хехехей
Dialogue: 0,0:21:10.51,0:21:12.52,Default,,0,0,0,,Менің де министр болғым келеді
Dialogue: 0,0:21:12.81,0:21:15.06,Default,,0,0,0,,Дұрыс, мына кең дүниеде...
Dialogue: 0,0:21:15.31,0:21:17.77,Default,,0,0,0,,Жалғыз біз болған кезде
Dialogue: 0,0:21:18.02,0:21:20.07,Default,,0,0,0,,Үй жануарын жасауға бола ма?
Dialogue: 0,0:21:20.32,0:21:21.36,Default,,0,0,0,,Үй жануарлары?
Dialogue: 0,0:21:22.15,0:21:25.78,Default,,0,0,0,,Жануарлар генінің ампулалары және жұмыртқаны клондау!
Dialogue: 0,0:21:26.03,0:21:29.57,Default,,0,0,0,,Ампуладағы сұйықтықты жұмыртқаға енгізіңіз.
Dialogue: 0,0:21:29.87,0:21:31.08,Default,,0,0,0,,Сіз де жасай аласыз
Dialogue: 0,0:21:31.37,0:21:33.00,Default,,0,0,0,,Бұл қай министр?
Dialogue: 0,0:21:33.20,0:21:36.33,Default,,0,0,0,,Хмм, менің ойымша, сіз оны үй жануарлары министрі деп атай аласыз.
Dialogue: 0,0:21:37.42,0:21:39.75,Default,,0,0,0,,Ол аса тәкаппар емес сияқты.
Dialogue: 0,0:21:42.67,0:21:44.46,Default,,0,0,0,,Иә? Бұл өзен
Dialogue: 0,0:21:47.01,0:21:49.30,Default,,0,0,0,,Жұмыртқаларды шығару үшін жақсы болуы мүмкін
Dialogue: 0,0:21:50.97,0:21:52.89,Default,,0,0,0,,Үй жануарлары министрі?
Dialogue: 0,0:21:53.18,0:21:56.10,Default,,0,0,0,,Тіпті Дорэмон мені мазақ етті
Dialogue: 0,0:21:56.56,0:21:57.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:59.73,0:22:03.40,Default,,0,0,0,,Мына екі ағаш бір-бірімен араласқан...
Dialogue: 0,0:22:04.03,0:22:06.07,Default,,0,0,0,,Иә? Бұл дұрыс
Dialogue: 0,0:22:06.36,0:22:10.07,Default,,0,0,0,,Мұны барлығын таң қалдыру үшін пайдаланыңыз.
Dialogue: 0,0:22:10.57,0:22:12.62,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:22:12.95,0:22:16.79,Default,,0,0,0,,Ах... хмм.
Dialogue: 0,0:22:17.12,0:22:18.92,Default,,0,0,0,,Иә? Хехе
Dialogue: 0,0:22:19.71,0:22:21.08,Default,,0,0,0,,Қашқын ба?
Dialogue: 0,0:22:21.67,0:22:23.88,Default,,0,0,0,,Менің де есімде.
Dialogue: 0,0:22:24.17,0:22:25.59,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:22:26.05,0:22:27.92,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:22:28.68,0:22:31.64,Default,,0,0,0,,Қараңғы түскенде қайтамын.
Dialogue: 0,0:22:40.40,0:22:44.73,Default,,0,0,0,,Үнемі кәрзеңкеде қалсаң, тұншығасың.
Dialogue: 0,0:23:05.17,0:23:06.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:23:07.34,0:23:08.47,Default,,0,0,0,,О
Dialogue: 0,0:23:13.60,0:23:15.35,Default,,0,0,0,,Ваа...
Dialogue: 0,0:23:15.72,0:23:19.81,Default,,0,0,0,,Ух хаа ух хаахахахах...
Dialogue: 0,0:23:21.27,0:23:23.98,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:23:24.27,0:23:25.86,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:23:26.78,0:23:31.82,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:23:35.99,0:23:38.66,Default,,0,0,0,,Сәлем, Қоршаған ортаны қорғау министрі
Dialogue: 0,0:23:38.91,0:23:39.75,Default,,0,0,0,,Дора-чан
Dialogue: 0,0:23:40.29,0:23:42.62,Default,,0,0,0,,Егіс жақсы жүріп жатыр ма?
Dialogue: 0,0:23:42.92,0:23:44.46,Default,,0,0,0,,Отырғызу аяқталуға жақын
Dialogue: 0,0:23:44.79,0:23:47.42,Default,,0,0,0,,Ерте нүктелерде бүршіктер өсіп тұрған сияқты.
Dialogue: 0,0:23:47.80,0:23:50.51,Default,,0,0,0,,Бұл жерде жаңбыр жауады деп үміттенемін.
Dialogue: 0,0:23:50.76,0:23:52.43,Default,,0,0,0,,Олай болса
Dialogue: 0,0:23:53.14,0:23:55.35,Default,,0,0,0,,Радио басқарылатын жаңбыр бұлттары!
Dialogue: 0,0:23:55.60,0:24:00.18,Default,,0,0,0,,Жаңбырды қажетінше, қажет кезде жаудыруға болады.
Dialogue: 0,0:24:00.43,0:24:01.23,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:24:01.48,0:24:04.81,Default,,0,0,0,,Жаңбырдың құрамында да тыңайтқыш бар.
Dialogue: 0,0:24:05.48,0:24:08.65,Default,,0,0,0,,Рахмет, мен сені жақсы көремін.
Dialogue: 0,0:24:08.90,0:24:10.78,Default,,0,0,0,,Шизука-чан күткендей
Dialogue: 0,0:24:11.03,0:24:13.20,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,0:24:13.49,0:24:15.70,Default,,0,0,0,,Әй, бұл дауыс Ауыл және орман шаруашылығы министрі.
Dialogue: 0,0:24:16.37,0:24:18.58,Default,,0,0,0,,Бұл тамаша аспаздық сала.
Dialogue: 0,0:24:18.87,0:24:22.00,Default,,0,0,0,,Түрлі тұқым сепсем де, бұл біртүрлі.
Dialogue: 0,0:24:22.25,0:24:24.58,Default,,0,0,0,,Өскендердің бәрі біртүрлі жапырақтар еді.
Dialogue: 0,0:24:24.88,0:24:26.88,Default,,0,0,0,,Бұл жақсы. (Сунео) Иә?
Dialogue: 0,0:24:27.13,0:24:30.13,Default,,0,0,0,,Күн сәулесін көп берсең, ол тезірек өседі.
Dialogue: 0,0:24:31.26,0:24:34.05,Default,,0,0,0,,Радиомен басқарылатын күн!
Dialogue: 0,0:24:34.30,0:24:38.10,Default,,0,0,0,,Оны Шизука-чанмен және осы жаңбыр бұлтымен бірге пайдаланыңыз.
Dialogue: 0,0:24:38.35,0:24:39.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:24:39.85,0:24:42.52,Default,,0,0,0,,Құрылыс министрінің жұмысы қалай?
Dialogue: 0,0:24:42.85,0:24:45.60,Default,,0,0,0,,О, бәрі жақсы болып жатыр.
Dialogue: 0,0:24:46.15,0:24:46.90,Default,,0,0,0,,Уау
Dialogue: 0,0:24:47.19,0:24:48.73,Default,,0,0,0,,жаман жаман
Dialogue: 0,0:24:49.02,0:24:51.28,Default,,0,0,0,,Үңгірді қазу аяқталуға жақын.
Dialogue: 0,0:24:51.57,0:24:53.40,Default,,0,0,0,,Бұл бәрінен бұрын
Dialogue: 0,0:24:54.91,0:24:57.32,Default,,0,0,0,,Нобир су құбыры!
Dialogue: 0,0:24:57.57,0:24:58.74,Default,,0,0,0,,Егер сіз оны жерге жабыстырсаңыз -
Dialogue: 0,0:24:58.99,0:25:02.04,Default,,0,0,0,,Мүмкіндігінше созылып, жер асты су тамырларын іздеу
Dialogue: 0,0:25:02.29,0:25:04.29,Default,,0,0,0,,Газ құбырлары мен канализация құбырлары да бар.
Dialogue: 0,0:25:04.54,0:25:06.75,Default,,0,0,0,,Жарайды, оны орнатамыз.
Dialogue: 0,0:25:07.38,0:25:10.75,Default,,0,0,0,,Енді мәселе үй жануарлары министрі.
Dialogue: 0,0:25:11.88,0:25:14.67,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:25:20.35,0:25:21.60,Default,,0,0,0,,Хмм.
Dialogue: 0,0:25:22.56,0:25:25.35,Default,,0,0,0,,А, а, жоқ~
Dialogue: 0,0:25:27.02,0:25:28.27,Default,,0,0,0,,Тоқтау~
Dialogue: 0,0:25:29.06,0:25:29.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:31.19,0:25:32.03,Default,,0,0,0,,Уау~
Dialogue: 0,0:25:35.90,0:25:38.28,Default,,0,0,0,,Пуха гохо гохо
Dialogue: 0,0:25:39.03,0:25:39.70,Default,,0,0,0,,Ах
Dialogue: 0,0:25:40.12,0:25:41.20,Default,,0,0,0,,О
Dialogue: 0,0:25:42.08,0:25:43.66,Default,,0,0,0,,Жұмыртқалар ұшып келеді
Dialogue: 0,0:25:47.33,0:25:48.58,Default,,0,0,0,,О
Dialogue: 0,0:25:52.05,0:25:54.30,Default,,0,0,0,,Хихи~н
Dialogue: 0,0:26:00.68,0:26:01.97,Default,,0,0,0,,Уау~
Dialogue: 0,0:26:03.27,0:26:04.35,Default,,0,0,0,,Сәлем
Dialogue: 0,0:26:04.60,0:26:07.85,Default,,0,0,0,,Иә, иә! Пегас дүниеге келді
Dialogue: 0,0:26:08.10,0:26:10.98,Default,,0,0,0,,Аққу мен жылқы ампуласын бір уақытта қалай пайдалануға болады?
Dialogue: 0,0:26:11.27,0:26:12.52,Default,,0,0,0,,Мен данышпанмын
Dialogue: 0,0:26:18.28,0:26:21.03,Default,,0,0,0,,Уау, уау!
Dialogue: 0,0:26:22.12,0:26:23.03,Default,,0,0,0,,Уау~
Dialogue: 0,0:26:24.58,0:26:27.21,Default,,0,0,0,,Бүркіт пен арыстаннан жасалған грифон.
Dialogue: 0,0:26:27.46,0:26:30.33,Default,,0,0,0,,Крокодил, бұғы және жарғанат айдаһар
Dialogue: 0,0:26:32.09,0:26:34.17,Default,,0,0,0,,Пегадан Гуриден Дракоға
Dialogue: 0,0:26:34.46,0:26:38.47,Default,,0,0,0,,Бүгіннен бастап мен барлығының анасымын.
Dialogue: 0,0:26:38.97,0:26:40.89,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:26:41.14,0:26:42.89,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:26:43.14,0:26:43.97,Default,,0,0,0,,Дораемон
Dialogue: 0,0:26:45.60,0:26:47.35,Default,,0,0,0,,Осы жерге тез тығылыңыз.
Dialogue: 0,0:26:47.60,0:26:49.94,Default,,0,0,0,,Мен жарайды дегенше шықпа.
Dialogue: 0,0:26:50.48,0:26:51.81,Default,,0,0,0,,Итита
Dialogue: 0,0:26:52.06,0:26:55.36,Default,,0,0,0,,арқылы не жасадыңыз? ит? мысық?
Dialogue: 0,0:26:55.61,0:26:57.36,Default,,0,0,0,,Сосын мен ұйықтадым.
Dialogue: 0,0:26:57.65,0:27:01.32,Default,,0,0,0,,Әй, сен сондай жігітсің ғой.
Dialogue: 0,0:27:02.16,0:27:05.95,Default,,0,0,0,,Сіз жауапты боласыз. Қазір отставкаға кетіңіз.
Dialogue: 0,0:27:06.24,0:27:08.62,Default,,0,0,0,,Егер сіз тынышталсаңыз... А?
Dialogue: 0,0:27:09.00,0:27:11.42,Default,,0,0,0,,Жоқ, жоқ, жоқ деген не?
Dialogue: 0,0:27:12.08,0:27:14.38,Default,,0,0,0,,Григ Гуруруру~
Dialogue: 0,0:27:14.63,0:27:16.05,Default,,0,0,0,,Ауырады, ауырады, ауырады
Dialogue: 0,0:27:16.30,0:27:19.34,Default,,0,0,0,,Хахахаха мен шынымен жақсы емеспін.
Dialogue: 0,0:27:19.59,0:27:22.30,Default,,0,0,0,,Түсінсең, байыппен істе.
Dialogue: 0,0:27:23.68,0:27:26.22,Default,,0,0,0,,Жануарларға арналған әмбебап тамақ!
Dialogue: 0,0:27:26.51,0:27:29.43,Default,,0,0,0,,Жұмыртқадан шыққанда, оны тамақтандырыңыз.
Dialogue: 0,0:27:29.68,0:27:30.69,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:27:30.94,0:27:35.73,Default,,0,0,0,,Тамақ ішетін уақыт болды, тынышталған кезде қайтыңыз.
Dialogue: 0,0:27:36.73,0:27:40.45,Default,,0,0,0,,Ха, өздігінен шықса жақсы болмай ма?
Dialogue: 0,0:27:42.99,0:27:44.82,Default,,0,0,0,,Уау хехехе
Dialogue: 0,0:27:50.33,0:27:53.25,Default,,0,0,0,,Дұрыс тамақтанып, үлкен болып өс.
Dialogue: 0,0:27:53.50,0:27:55.09,Default,,0,0,0,,...
Dialogue: 0,0:27:55.71,0:28:00.05,Default,,0,0,0,,Сіз сондай құлықсыз адамсыз. Дүрбелеңнің қажеті жоқ, бұл өте көп.
Dialogue: 0,0:28:00.26,0:28:01.09,Default,,0,0,0,,Каа
Dialogue: 0,0:28:02.18,0:28:03.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:04.64,0:28:05.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:05.80,0:28:07.43,Default,,0,0,0,,(Жапырақтардың дірілдеген дыбысы)
Dialogue: 0,0:28:07.56,0:28:09.93,Default,,0,0,0,,Менің де қарным ашты.
Dialogue: 0,0:28:10.23,0:28:12.94,Default,,0,0,0,,Бұл катсудон дайын ба?
Dialogue: 0,0:28:13.40,0:28:16.11,Default,,0,0,0,,Иә? Хмф
Dialogue: 0,0:28:16.98,0:28:18.90,Default,,0,0,0,,Бұл шалғам емес.
Dialogue: 0,0:28:19.19,0:28:19.94,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:28:22.07,0:28:23.28,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:28:23.41,0:28:24.82,Default,,0,0,0,,Шизука-чан, иә?
Dialogue: 0,0:28:25.37,0:28:28.12,Default,,0,0,0,,Бір демалып, тамақтанып алайық
Dialogue: 0,0:28:28.37,0:28:30.29,Default,,0,0,0,,Мен бірден барамын
Dialogue: 0,0:28:31.62,0:28:34.71,Default,,0,0,0,,Қараңдаршы, бөлменің бәрі бітті.
Dialogue: 0,0:28:34.96,0:28:37.79,Default,,0,0,0,,Өте кең
Dialogue: 0,0:28:38.25,0:28:42.26,Default,,0,0,0,,Артқы жағында жеке бөлме, сонымен қатар ас үй мен күзет бөлмесі бар.
Dialogue: 0,0:28:42.51,0:28:43.51,Default,,0,0,0,,Джиан күткендей
Dialogue: 0,0:28:43.80,0:28:45.72,Default,,0,0,0,,Тұруға ыңғайлы жер сияқты.
Dialogue: 0,0:28:46.09,0:28:48.72,Default,,0,0,0,,Олай болса, мырзалар, алайық.
Dialogue: 0,0:28:49.06,0:28:51.81,Default,,0,0,0,,Шалғамды осылай қалай жейсің?
Dialogue: 0,0:28:52.10,0:28:54.14,Default,,0,0,0,,Сіз катсудонға тапсырыс берген болуыңыз керек.
Dialogue: 0,0:28:54.44,0:28:56.65,Default,,0,0,0,,Мен спагетти жегім келді
Dialogue: 0,0:28:56.90,0:28:59.07,Default,,0,0,0,,Оны бұлай жеме.
Dialogue: 0,0:28:59.32,0:29:01.82,Default,,0,0,0,,Бұл жерден үзу оңай.
Dialogue: 0,0:29:03.03,0:29:05.03,Default,,0,0,0,,Уау~ Уау
Dialogue: 0,0:29:07.41,0:29:08.99,Default,,0,0,0,,Ооо хахахаха
Dialogue: 0,0:29:10.12,0:29:11.41,Default,,0,0,0,,Олай айтсаң, тіпті Дайкоку аға да қарсылық білдіре алмайды.
Dialogue: 0,0:29:11.66,0:29:13.83,Default,,0,0,0,,Менікі де
Dialogue: 0,0:29:15.25,0:29:17.21,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:29:18.46,0:29:19.34,Default,,0,0,0,,Себорн
Dialogue: 0,0:29:23.59,0:29:25.93,Default,,0,0,0,,Сунео-сан, бұл өте дәмді.
Dialogue: 0,0:29:26.22,0:29:29.89,Default,,0,0,0,,Шынымен бе? Мен фермер болуым керек пе?
Dialogue: 0,0:29:30.60,0:29:34.64,Default,,0,0,0,,Хахахахаха (Нобита) Уау~ Иісі жақсы.
Dialogue: 0,0:29:35.35,0:29:37.23,Default,,0,0,0,,Жалпақ асқазан
Dialogue: 0,0:29:37.60,0:29:38.86,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:29:39.40,0:29:42.28,Default,,0,0,0,,Сонымен сен қандай үй жануарын жасадың?
Dialogue: 0,0:29:42.61,0:29:44.82,Default,,0,0,0,,Міне... (Сунео) Хуфуфуфуфу
Dialogue: 0,0:29:45.07,0:29:46.49,Default,,0,0,0,,Сіз бәрібір ұйықтап жатырсыз, солай ма?
Dialogue: 0,0:29:46.74,0:29:48.16,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:29:48.41,0:29:51.33,Default,,0,0,0,,Қанша істесем де, жиі ұйықтамаймын.
Dialogue: 0,0:29:51.62,0:29:53.24,Default,,0,0,0,,Сонымен, сен не істеп жүрсің?
Dialogue: 0,0:29:53.79,0:29:56.08,Default,,0,0,0,,Мен ұйықтап қалдым хахахахаха
Dialogue: 0,0:29:56.33,0:29:57.71,Default,,0,0,0,,Зуко
Dialogue: 0,0:29:58.71,0:30:00.42,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:30:01.50,0:30:04.17,Default,,0,0,0,,Иә, бұл дәмді.
Dialogue: 0,0:30:10.14,0:30:12.85,Default,,0,0,0,,Өте тегін!
Dialogue: 0,0:30:13.18,0:30:16.81,Default,,0,0,0,,Бостандық (Сунео) Бостандық - ең жақсы
Dialogue: 0,0:30:17.06,0:30:19.40,Default,,0,0,0,,Табиғат аясында осылай болу
Dialogue: 0,0:30:19.69,0:30:22.77,Default,,0,0,0,,Кішкентай уайымдар енді маңызды емес
Dialogue: 0,0:30:36.91,0:30:40.42,Default,,0,0,0,,Мен бір рет үйге барамын деп ойладым...
Dialogue: 0,0:30:40.67,0:30:43.00,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:30:43.25,0:30:45.80,Default,,0,0,0,,Енді онша ашуланбайсың.
Dialogue: 0,0:30:46.51,0:30:47.76,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:30:48.05,0:30:48.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:49.22,0:30:51.26,Default,,0,0,0,,Бос болсам да
Dialogue: 0,0:30:51.51,0:30:54.51,Default,,0,0,0,,Неліктен мен үйге баруым керек?
Dialogue: 0,0:30:55.81,0:30:57.60,Default,,0,0,0,,Жалғыз болсам да қаламын
Dialogue: 0,0:30:58.43,0:31:01.65,Default,,0,0,0,,Бірақ аналардың алаңдайтынына сенімдімін.
Dialogue: 0,0:31:01.90,0:31:05.36,Default,,0,0,0,,Дұрыс, қыңыр болмай үйге қайтайық.
Dialogue: 0,0:31:06.19,0:31:07.57,Default,,0,0,0,,Шулы
Dialogue: 0,0:31:07.94,0:31:10.07,Default,,0,0,0,,Мен үйден қашуды тоқтатпаймын
Dialogue: 0,0:31:10.82,0:31:12.57,Default,,0,0,0,,Үйден қашуды тоқтатпа
Dialogue: 0,0:31:13.28,0:31:15.29,Default,,0,0,0,,Қысқа үзіліс.
Dialogue: 0,0:31:15.58,0:31:18.54,Default,,0,0,0,,Келгіңіз келсе, кез келген уақытта қайта аласыз.
Dialogue: 0,0:31:19.41,0:31:21.50,Default,,0,0,0,,Жарайды, онда шағымданба.
Dialogue: 0,0:31:21.96,0:31:25.30,Default,,0,0,0,,Тыңда, бұл бізге ғана құпия.
Dialogue: 0,0:31:25.59,0:31:28.51,Default,,0,0,0,,Ата-анаңа немесе мектептегі адамдарға айтсаң, мен сені сабаймын.
Dialogue: 0,0:31:28.76,0:31:29.47,Default,,0,0,0,,Иә
Dialogue: 0,0:31:29.72,0:31:31.63,Default,,0,0,0,,Тас найзаға ант айту
Dialogue: 0,0:31:31.93,0:31:34.22,Default,,0,0,0,,Тас найзаға ант айту
Dialogue: 0,0:31:35.31,0:31:39.39,Default,,0,0,0,,Айтпақшы, мен үйден неге қашып кеттім?
Dialogue: 0,0:31:40.02,0:31:42.23,Default,,0,0,0,,Ертең кездескенше (Сунео)
Dialogue: 0,0:31:42.48,0:31:45.27,Default,,0,0,0,,Қайырлы түн (Нобита) Иә Қайырлы түн
Dialogue: 0,0:31:47.53,0:31:49.32,Default,,0,0,0,,Дораемон шықты!
Dialogue: 0,0:31:49.61,0:31:51.65,Default,,0,0,0,,Маған ұнамайды, хомяктан қорқамын.
Dialogue: 0,0:31:51.91,0:31:53.57,Default,,0,0,0,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,0:31:53.82,0:31:55.87,Default,,0,0,0,,Ой, тоқта.
Dialogue: 0,0:31:56.24,0:31:58.16,Default,,0,0,0,,(баспалдақпен жүгіру)
Dialogue: 0,0:31:58.45,0:32:02.62,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:32:08.25,0:32:10.55,Default,,0,0,0,,Осы сағатқа дейін қайда жүрдің?
Dialogue: 0,0:32:11.55,0:32:14.76,Default,,0,0,0,,Куу
Dialogue: 0,0:32:17.43,0:32:18.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:20.85,0:32:23.69,Default,,0,0,0,,Қолды жуып, тез тамақтан.
Dialogue: 0,0:32:23.94,0:32:24.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:24.81,0:32:26.44,Default,,0,0,0,,Жемесең, мен тазалаймын.
Dialogue: 0,0:32:26.69,0:32:28.36,Default,,0,0,0,,жеп ал
Dialogue: 0,0:32:33.74,0:32:36.66,Default,,0,0,0,,Анамның уағыз айтпағаны қызық.
Dialogue: 0,0:32:36.91,0:32:39.79,Default,,0,0,0,,Уау?
Dialogue: 0,0:32:40.08,0:32:41.16,Default,,0,0,0,,Қасқыр?
Dialogue: 0,0:32:41.83,0:32:43.37,Default,,0,0,0,,Егер ол ондаған күн бойы осылай көңілді жүретін болса, онда Киса қалыпты емес болар еді.
Dialogue: 0,0:32:48.63,0:32:52.05,Default,,0,0,0,,(Джозеф) Бұл Спидвагон қорының геликоптері.
Dialogue: 0,0:32:56.47,0:32:58.39,Default,,0,0,0,,Бұл кеше болды
Dialogue: 0,0:32:58.68,0:33:00.56,Default,,0,0,0,,Егер Джайко құлыпты ашпаса...
Dialogue: 0,0:33:00.85,0:33:03.27,Default,,0,0,0,,Мен түні бойы далада тұруға мәжбүр боламын.
Dialogue: 0,0:33:03.64,0:33:04.89,Default,,0,0,0,,Учимо
Dialogue: 0,0:33:05.40,0:33:08.48,Default,,0,0,0,,Коменданттық сағатты сақтамаған бала менің балам емес.
Dialogue: 0,0:33:08.82,0:33:10.44,Default,,0,0,0,,Біз сөйлесеміз
Dialogue: 0,0:33:10.73,0:33:13.49,Default,,0,0,0,,Мен француз тілінде біреуін ала алдым.
Dialogue: 0,0:33:14.36,0:33:15.32,Default,,0,0,0,,Нобита ше?
Dialogue: 0,0:33:15.61,0:33:18.16,Default,,0,0,0,,Үй? Біз...
Dialogue: 0,0:33:18.41,0:33:19.58,Default,,0,0,0,,Қалай болғанда да—
Dialogue: 0,0:33:19.83,0:33:22.70,Default,,0,0,0,,Бұл үлкен әбігерге айналады, өйткені бәрі бірден үйден қашады.
Dialogue: 0,0:33:22.95,0:33:25.79,Default,,0,0,0,,Күніне 3 сағат болса, ол байқалмайды, солай ма?
Dialogue: 0,0:33:26.04,0:33:28.38,Default,,0,0,0,,Бұл қашқын ба?
Dialogue: 0,0:33:28.63,0:33:30.17,Default,,0,0,0,,Бұл шу тудырмайды.
Dialogue: 0,0:33:30.42,0:33:31.30,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:33:31.55,0:33:33.13,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:33:33.76,0:33:35.05,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:33:35.30,0:33:37.05,Default,,0,0,0,,Ууу
Dialogue: 0,0:33:37.30,0:33:38.55,Default,,0,0,0,,Не болды?
Dialogue: 0,0:33:39.22,0:33:42.60,Default,,0,0,0,,Ол менің Дораякиімді жеді.
Dialogue: 0,0:33:43.77,0:33:44.68,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:33:44.98,0:33:46.10,Default,,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:33:46.39,0:33:48.73,Default,,0,0,0,,хомяк менің дораякиімді жеп қойды
Dialogue: 0,0:33:50.02,0:33:52.28,Default,,0,0,0,,Ugg
Dialogue: 0,0:33:52.57,0:33:55.45,Default,,0,0,0,,Уф, мен мұны шешемін.
Dialogue: 0,0:33:55.74,0:33:57.28,Default,,0,0,0,,Жарайды
Dialogue: 0,0:33:58.41,0:34:03.08,Default,,0,0,0,,Жақсы кадр, иә? Сіз әлі оралмадыңыз ба?
Dialogue: 0,0:34:03.33,0:34:04.54,Default,,0,0,0,,Мектеп сөмкесі бар.
Dialogue: 0,0:34:04.79,0:34:06.04,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:34:06.29,0:34:09.29,Default,,0,0,0,,Жарайды, қазір киімімізді ауыстырайық.
Dialogue: 0,0:34:09.58,0:34:10.50,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:34:10.75,0:34:13.50,Default,,0,0,0,,Жоқ, мұнда өзгермеңіз.
Dialogue: 0,0:34:13.76,0:34:15.76,Default,,0,0,0,,Сонымен, киімімді қайда ауыстыруым керек?
Dialogue: 0,0:34:16.01,0:34:17.22,Default,,0,0,0,,Сыртқа шықсам ше?
Dialogue: 0,0:34:17.51,0:34:19.30,Default,,0,0,0,,Сыртта одан да жаман.
Dialogue: 0,0:34:19.59,0:34:20.22,Default,,0,0,0,,Ах
Dialogue: 0,0:34:20.64,0:34:22.56,Default,,0,0,0,,Иә? Шкафта біреу бар ма?
Dialogue: 0,0:34:22.85,0:34:23.68,Default,,0,0,0,,Не? (Сунео) Өтірік
Dialogue: 0,0:34:23.97,0:34:25.52,Default,,0,0,0,,Дораэмон, солай ма?
Dialogue: 0,0:34:25.77,0:34:27.52,Default,,0,0,0,,Оны аш, Сунео. (Сунео) Иә?
Dialogue: 0,0:34:27.77,0:34:31.11,Default,,0,0,0,,Мынау... Уау Уау Уау
Dialogue: 0,0:34:33.23,0:34:35.15,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:34:35.69,0:34:36.78,Default,,0,0,0,,Уау
Dialogue: 0,0:34:38.45,0:34:39.70,Default,,0,0,0,,Элементтер
Dialogue: 0,0:34:42.12,0:34:44.83,Default,,0,0,0,,Бұл жігіт тамаша жұмыс жасады.
Dialogue: 0,0:34:46.08,0:34:46.83,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:34:47.79,0:34:49.25,Default,,0,0,0,,Жаса, Джан
Dialogue: 0,0:34:49.50,0:34:51.71,Default,,0,0,0,,Қойшы мені, мысықтың мейірімі...
Dialogue: 0,0:34:52.00,0:34:54.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:55.96,0:34:56.67,Default,,0,0,0,,Ах
Dialogue: 0,0:34:56.96,0:34:58.72,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:34:59.13,0:35:00.34,Default,,0,0,0,,Яй Нобита
Dialogue: 0,0:35:00.47,0:35:02.89,Default,,0,0,0,,Жарайсың бұл жігітке сырыңды ашқаның үшін.
Dialogue: 0,0:35:03.14,0:35:04.56,Default,,0,0,0,,Мен бұл қызды танымаймын.
Dialogue: 0,0:35:04.81,0:35:05.85,Default,,0,0,0,,Егер ойында жеңбесең
Dialogue: 0,0:35:06.02,0:35:08.52,Default,,0,0,0,,Егер сен ақымақ болмасаң, ол қазірдің өзінде шулы.
Dialogue: 0,0:35:08.81,0:35:09.52,Default,,0,0,0,,Бұл ана
Dialogue: 0,0:35:09.81,0:35:12.02,Default,,0,0,0,,Мазаламай тұрып кетейік.
Dialogue: 0,0:35:12.40,0:35:15.02,Default,,0,0,0,,Чикушо Бұл кім? Сіз
Dialogue: 0,0:35:19.11,0:35:21.11,Default,,0,0,0,,Нобита? а?
Dialogue: 0,0:35:21.36,0:35:23.16,Default,,0,0,0,,Сондықтан сіз білмейсіз
Dialogue: 0,0:35:23.41,0:35:26.33,Default,,0,0,0,,Өтірікші болсаң, неге бұлай киініп жүрсің?
Dialogue: 0,0:35:26.62,0:35:28.12,Default,,0,0,0,,Мен кенеттен соққыға жығылдым.
Dialogue: 0,0:35:28.66,0:35:30.54,Default,,0,0,0,,Әйтеуір~
Dialogue: 0,0:35:30.83,0:35:31.87,Default,,0,0,0,,Тас найза?
Dialogue: 0,0:35:32.50,0:35:35.80,Default,,0,0,0,,Бұл бала нағыз қарабайыр адам болуы мүмкін бе?
Dialogue: 0,0:35:36.05,0:35:37.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:38.01,0:35:40.76,Default,,0,0,0,,Біз шынымен қарабайыр адамдармыз ба?
Dialogue: 0,0:35:41.05,0:35:42.43,Default,,0,0,0,,Бірақ бұл біртүрлі.
Dialogue: 0,0:35:42.68,0:35:46.22,Default,,0,0,0,,21 ғасырда Токиода неліктен қарабайыр адамдар бар?
Dialogue: 0,0:35:46.81,0:35:48.39,Default,,0,0,0,,Мүмкін солай ма?
Dialogue: 0,0:35:48.68,0:35:49.68,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:35:50.18,0:35:51.77,Default,,0,0,0,,Кеңістік-уақыт турбуленттігі
Dialogue: 0,0:35:52.85,0:35:55.90,Default,,0,0,0,,Бұл сирек кездесетін құбылыс, бірақ кеңістік-уақыттың бұрмалануы...
Dialogue: 0,0:35:56.15,0:35:59.49,Default,,0,0,0,,Қара құрдым сияқты, былайша айтқанда, тұзақ құрыңыз.
Dialogue: 0,0:35:59.78,0:36:01.70,Default,,0,0,0,,Егер сіз осы шұңқырға түссеңіз...
Dialogue: 0,0:36:01.99,0:36:05.58,Default,,0,0,0,,Ол адам дүниеден кенет жоғалып кетеді.
Dialogue: 0,0:36:05.87,0:36:07.24,Default,,0,0,0,,Адамдар жойылып кете ме?
Dialogue: 0,0:36:07.54,0:36:09.58,Default,,0,0,0,,Мен мұндайды естімеппін.
Dialogue: 0,0:36:09.87,0:36:12.83,Default,,0,0,0,,Сіз бір кездері рухтан қашу туралы естідіңіз бе?
Dialogue: 0,0:36:13.12,0:36:15.71,Default,,0,0,0,,Бұл көне жапон аңызы.
Dialogue: 0,0:36:16.21,0:36:20.80,Default,,0,0,0,,Дүние жүзінде адамдардың кенеттен жоғалып кеткен мысалдары бар.
Dialogue: 0,0:36:22.55,0:36:24.89,Default,,0,0,0,,Сонда бұл бала да ерте заманнан келе ме?
Dialogue: 0,0:36:25.14,0:36:26.60,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:36:26.97,0:36:28.76,Default,,0,0,0,,Бұл көңіл көншітеді.
Dialogue: 0,0:36:29.06,0:36:32.89,Default,,0,0,0,,Адамдар Жапонияда 70 000 жыл бұрын өмір сүрген.
Dialogue: 0,0:36:33.02,0:36:34.98,Default,,0,0,0,,Мен бұл туралы әлі білмеймін.
Dialogue: 0,0:36:35.10,0:36:35.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:36.06,0:36:40.53,Default,,0,0,0,,Бұл баланың қашан, қайдан шыққанын нақты анықтауымыз керек.
Dialogue: 0,0:36:40.82,0:36:42.82,Default,,0,0,0,,Нобита екеуміз зерттейміз.
Dialogue: 0,0:36:43.07,0:36:46.62,Default,,0,0,0,,Джан мен Сунео осы жерде біреу тұра ма деп іздеді.
Dialogue: 0,0:36:46.87,0:36:48.49,Default,,0,0,0,,Маған қалдырыңыз (Сунео) Жарайды.
Dialogue: 0,0:36:48.74,0:36:50.91,Default,,0,0,0,,Шизука-чан, мына балаға қамқор болшы.
Dialogue: 0,0:36:51.16,0:36:52.50,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:36:53.04,0:36:55.46,Default,,0,0,0,,Кеңістік-уақыт жер сілкінісінің есептегіші!
Dialogue: 0,0:36:55.75,0:36:58.29,Default,,0,0,0,,Бақылау сферасының уақыт тесігінде қалқыуы
Dialogue: 0,0:36:58.46,0:37:00.84,Default,,0,0,0,,Кеңістік пен уақытта толқындардың іздерін іздеу
Dialogue: 0,0:37:01.59,0:37:02.63,Default,,0,0,0,,Толқын?
Dialogue: 0,0:37:03.97,0:37:06.84,Default,,0,0,0,,Бұл кеңістік пен уақыттағы көрінбейтін бұзылыс.
Dialogue: 0,0:37:08.10,0:37:09.85,Default,,0,0,0,,Деректер жақында келеді.
Dialogue: 0,0:37:10.10,0:37:12.64,Default,,0,0,0,,Кешегі күнге оралайық
Dialogue: 0,0:37:13.68,0:37:17.40,Default,,0,0,0,,Міне. Осы толқынға ілесейік.
Dialogue: 0,0:37:17.65,0:37:20.32,Default,,0,0,0,,Ол қай жерден басталып, нешеге дейін аяқталады?
Dialogue: 0,0:37:21.11,0:37:23.82,Default,,0,0,0,,Бұл мүлдем қызықсыз.
Dialogue: 0,0:37:24.45,0:37:27.20,Default,,0,0,0,,Менің үй жануарыма не болды?
Dialogue: 0,0:37:27.99,0:37:31.49,Default,,0,0,0,,Пега? Гури? Драко?
Dialogue: 0,0:37:32.29,0:37:34.16,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:37:34.75,0:37:36.92,Default,,0,0,0,,Эй, шық!
Dialogue: 0,0:37:37.96,0:37:38.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:40.67,0:37:41.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:42.13,0:37:43.34,Default,,0,0,0,,Иә, уау
Dialogue: 0,0:37:44.01,0:37:46.18,Default,,0,0,0,,Кім? Онда біреу бар ма?
Dialogue: 0,0:37:48.64,0:37:50.64,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:37:52.60,0:37:53.68,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:37:53.93,0:37:57.31,Default,,0,0,0,,Уау уау хахахахаха
Dialogue: 0,0:37:57.81,0:37:59.98,Default,,0,0,0,,Сіз үлкейдіңіз.
Dialogue: 0,0:38:00.82,0:38:03.48,Default,,0,0,0,,Сен мені есіңе түсірдің.
Dialogue: 0,0:38:05.32,0:38:06.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:08.32,0:38:10.37,Default,,0,0,0,,Глуг гурува
Dialogue: 0,0:38:12.99,0:38:15.54,Default,,0,0,0,,Маған бересің бе? Толық
Dialogue: 0,0:38:18.96,0:38:20.33,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:38:21.96,0:38:24.76,Default,,0,0,0,,...
Dialogue: 0,0:38:25.51,0:38:27.93,Default,,0,0,0,,Түсіндім, түсіндім. Жақсы.
Dialogue: 0,0:38:28.18,0:38:29.05,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:38:29.51,0:38:30.22,Default,,0,0,0,,О, жоқ болып кетті.
Dialogue: 0,0:38:35.27,0:38:36.56,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:38:39.02,0:38:40.69,Default,,0,0,0,,Жақсы, Гури.
Dialogue: 0,0:38:43.40,0:38:46.11,Default,,0,0,0,,Қараңдаршы, бұл дәу ибистердің отары.
Dialogue: 0,0:38:46.40,0:38:48.65,Default,,0,0,0,,О, керемет емес пе?
Dialogue: 0,0:38:48.90,0:38:52.07,Default,,0,0,0,,Жапондық ибис 20 ғасырда жойылды.
Dialogue: 0,0:38:52.33,0:38:54.16,Default,,0,0,0,,Мен өкінішті нәрсе жасадым.
Dialogue: 0,0:38:54.74,0:38:57.66,Default,,0,0,0,,Екеуміз жабысып қалғандықтан—
Dialogue: 0,0:38:58.12,0:39:01.29,Default,,0,0,0,,Тону каноэ ах
Dialogue: 0,0:39:04.71,0:39:06.59,Default,,0,0,0,,Ой
Dialogue: 0,0:39:07.30,0:39:09.97,Default,,0,0,0,,Уау хахаха Уау
Dialogue: 0,0:39:10.22,0:39:12.39,Default,,0,0,0,,Тону каноэ
Dialogue: 0,0:39:12.64,0:39:14.10,Default,,0,0,0,,Уау~
Dialogue: 0,0:39:15.72,0:39:17.10,Default,,0,0,0,,Хахаха~
Dialogue: 0,0:39:17.31,0:39:18.14,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:39:20.73,0:39:21.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:22.94,0:39:25.27,Default,,0,0,0,,Ой!
Dialogue: 0,0:39:26.28,0:39:28.28,Default,,0,0,0,,Ууу
Dialogue: 0,0:39:28.99,0:39:32.78,Default,,0,0,0,,Мен ренжідім. Сіз өте қорқынышты жағдайда болған болуыңыз керек.
Dialogue: 0,0:39:33.16,0:39:34.28,Default,,0,0,0,,Уф
Dialogue: 0,0:39:36.20,0:39:38.66,Default,,0,0,0,,Жақсы, сіз байқадыңыз.
Dialogue: 0,0:39:39.83,0:39:41.46,Default,,0,0,0,,Уау хмф
Dialogue: 0,0:39:41.83,0:39:43.08,Default,,0,0,0,,Ал қазір, шын мәнінде, өте жақсы сезімдемін
Dialogue: 0,0:39:44.04,0:39:45.84,Default,,0,0,0,,Гар Вудхэм Сабха
Dialogue: 0,0:39:46.17,0:39:47.67,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:39:47.92,0:39:50.76,Default,,0,0,0,,Мұнда сені қорлайтын ешкім жоқ.
Dialogue: 0,0:39:51.05,0:39:52.30,Default,,0,0,0,,Хмм!
Dialogue: 0,0:39:53.51,0:39:54.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:54.89,0:39:58.89,Default,,0,0,0,,Сіздің жарақатыңыз әлі жазылмады. Тыныш ұйықтау керек.
Dialogue: 0,0:39:59.14,0:40:00.27,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:40:01.10,0:40:03.23,Default,,0,0,0,,Иә, ыстық сорпа.
Dialogue: 0,0:40:03.73,0:40:05.11,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:40:05.31,0:40:06.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:12.28,0:40:13.61,Default,,0,0,0,,Маруна
Dialogue: 0,0:40:13.86,0:40:17.16,Default,,0,0,0,,Уух, сенің қарның қатты ашқан болуы керек.
Dialogue: 0,0:40:17.45,0:40:19.04,Default,,0,0,0,,Сондай-ақ толтыру бар.
Dialogue: 0,0:40:19.33,0:40:23.08,Default,,0,0,0,,Егер сіз көп тамақтанып, тыныш ұйықтасаңыз, тез арада жақсы сезінесіз.
Dialogue: 0,0:40:23.33,0:40:24.29,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:40:24.46,0:40:26.67,Default,,0,0,0,,Тоқта, Джан.
Dialogue: 0,0:40:26.96,0:40:29.76,Default,,0,0,0,,Кім ұзақ сүңгій алатынын білу үшін жарысайық
Dialogue: 0,0:40:30.01,0:40:31.84,Default,,0,0,0,,Жарайды, мен жеңілмеймін.
Dialogue: 0,0:40:33.26,0:40:34.55,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:40:39.81,0:40:41.14,Default,,0,0,0,,О, о...
Dialogue: 0,0:40:45.52,0:40:47.86,Default,,0,0,0,,Алдамаңыз, иә?
Dialogue: 0,0:40:48.15,0:40:49.61,Default,,0,0,0,,Ал, бұрын ше?
Dialogue: 0,0:40:56.78,0:40:58.99,Default,,0,0,0,,...
Dialogue: 0,0:40:59.45,0:41:00.70,Default,,0,0,0,,Жарайды, мен жеңдім.
Dialogue: 0,0:41:01.00,0:41:02.33,Default,,0,0,0,,Тіпті олай емес.
Dialogue: 0,0:41:02.62,0:41:04.75,Default,,0,0,0,,Ой-о-о-о?
Dialogue: 0,0:41:05.00,0:41:06.83,Default,,0,0,0,,Алып саламандра даттеба
Dialogue: 0,0:41:09.00,0:41:12.26,Default,,0,0,0,,Деки (Сунео) Мен жей аламын!
Dialogue: 0,0:41:12.92,0:41:15.30,Default,,0,0,0,,Енді жоқ
Dialogue: 0,0:41:18.97,0:41:20.18,Default,,0,0,0,,Гун
Dialogue: 0,0:41:24.44,0:41:26.23,Default,,0,0,0,,Гриффин мен айдаһар?
Dialogue: 0,0:41:26.48,0:41:27.73,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:41:27.98,0:41:29.23,Default,,0,0,0,,Эй
Dialogue: 0,0:41:30.61,0:41:32.15,Default,,0,0,0,,Нобита
Dialogue: 0,0:41:32.53,0:41:34.61,Default,,0,0,0,,Бұл қиын, бәрі.
Dialogue: 0,0:41:34.99,0:41:36.16,Default,,0,0,0,,Дора-чан
Dialogue: 0,0:41:37.49,0:41:40.08,Default,,0,0,0,,Қараңызшы, оның қазір бәрі жақсы.
Dialogue: 0,0:41:40.33,0:41:41.12,Default,,0,0,0,,Жақсы
Dialogue: 0,0:41:41.62,0:41:45.75,Default,,0,0,0,,Бұл одан да үлкен жаңалық. Тергеу нәтижесі таң қалдырады.
Dialogue: 0,0:41:46.04,0:41:47.58,Default,,0,0,0,,Дораэмон (2 адам) Иә?
Dialogue: 0,0:41:48.29,0:41:49.54,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:41:50.04,0:41:51.30,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:41:53.09,0:41:54.92,Default,,0,0,0,,Бұл мен жасаған үй жануарлары.
Dialogue: 0,0:41:55.17,0:41:56.93,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл керемет болар еді
Dialogue: 0,0:41:57.18,0:41:58.97,Default,,0,0,0,,Мен қатты қорықтым.
Dialogue: 0,0:41:59.22,0:42:00.47,Default,,0,0,0,,Керемет
Dialogue: 0,0:42:00.89,0:42:02.81,Default,,0,0,0,,Маунгапеси Бостбост
Dialogue: 0,0:42:03.06,0:42:06.10,Default,,0,0,0,,Иә? Дұрыс, сенің кім екеніңді білдім.
Dialogue: 0,0:42:06.89,0:42:09.94,Default,,0,0,0,,Бұл бала кеңістік-уақыт турбуленттігіне сіңіп кетті.
Dialogue: 0,0:42:10.23,0:42:14.82,Default,,0,0,0,,Ендік 31 градус 7 минут солтүстік, бойлық 118 градус 2 минут шығыс
Dialogue: 0,0:42:15.15,0:42:16.78,Default,,0,0,0,,Жоқ, егер сіз мұны айтсаңыз да.
Dialogue: 0,0:42:17.03,0:42:18.11,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:42:18.41,0:42:19.45,Default,,0,0,0,,Иә
Dialogue: 0,0:42:20.03,0:42:23.83,Default,,0,0,0,,Басқаша айтқанда, 21 ғасырда ол материктік Қытайдағы Хэсиан төңірегінде болады.
Dialogue: 0,0:42:24.12,0:42:25.25,Default,,0,0,0,,Қытай?
Dialogue: 0,0:42:25.50,0:42:26.83,Default,,0,0,0,,Ол дерлік сатылып кеткен екен.
Dialogue: 0,0:42:27.08,0:42:29.75,Default,,0,0,0,,Хоньяку Конняку соя соусының дәмі!
Dialogue: 0,0:42:30.38,0:42:33.84,Default,,0,0,0,,Жүр, сен туралы бірдеңе айт.
Dialogue: 0,0:42:34.80,0:42:36.80,Default,,0,0,0,,Менің не айтып тұрғанымды түсіндің бе?
Dialogue: 0,0:42:37.68,0:42:39.51,Default,,0,0,0,,Менің атым Кукуру
Dialogue: 0,0:42:39.80,0:42:42.89,Default,,0,0,0,,Хикари тайпасы Тәжіқара мен Қоияменің ұлы
Dialogue: 0,0:42:43.22,0:42:46.31,Default,,0,0,0,,Ауылға қайтқанда көктегі бір шұңқырға сіңіп кеттім.
Dialogue: 0,0:42:46.68,0:42:48.85,Default,,0,0,0,,Бұл кеңістік-уақыт турбуленттігі туралы.
Dialogue: 0,0:42:49.10,0:42:51.11,Default,,0,0,0,,Қалғандары да сорып алды ма?
Dialogue: 0,0:42:51.36,0:42:53.69,Default,,0,0,0,,Отбасы, ауыл достары, т.б.
Dialogue: 0,0:42:53.94,0:42:57.15,Default,,0,0,0,,Жоқ, оны Кураями тайпасы алды.
Dialogue: 0,0:42:57.44,0:42:58.49,Default,,0,0,0,,Кураями тайпасы?
Dialogue: 0,0:42:58.74,0:43:01.49,Default,,0,0,0,,Ол көптен бері нысана болды.
Dialogue: 0,0:43:01.87,0:43:04.37,Default,,0,0,0,,Қанша қашсам да, Артыңнан еремін.
Dialogue: 0,0:43:04.62,0:43:07.29,Default,,0,0,0,,Шабуылға ұшырағандармен не болады?
Dialogue: 0,0:43:07.58,0:43:11.33,Default,,0,0,0,,Мен білмеймін. Олар мені солтүстікке апарып жатқан сияқты.
Dialogue: 0,0:43:11.63,0:43:12.92,Default,,0,0,0,,Осыдан кейін...
Dialogue: 0,0:43:13.54,0:43:16.55,Default,,0,0,0,,Сен неге Макура тайпасымен соғыспайсың?
Dialogue: 0,0:43:16.84,0:43:18.38,Default,,0,0,0,,Джан Кураями тайпасы
Dialogue: 0,0:43:18.92,0:43:21.01,Default,,0,0,0,,Бұл күресуге тұрарлық па?
Dialogue: 0,0:43:21.22,0:43:24.35,Default,,0,0,0,,Олардың қорқынышты одақтасы бар.
Dialogue: 0,0:43:24.89,0:43:27.02,Default,,0,0,0,,Өлмейтін Рух Патшасы...
Dialogue: 0,0:43:27.68,0:43:29.06,Default,,0,0,0,,Гига зомби!
Dialogue: 0,0:43:32.69,0:43:33.77,Default,,0,0,0,,Гига зомби?
Dialogue: 0,0:43:34.02,0:43:36.03,Default,,0,0,0,,Рух патшасы дегеніміз не?
Dialogue: 0,0:43:36.28,0:43:37.40,Default,,0,0,0,,Бұл елес болуы мүмкін бе?
Dialogue: 0,0:43:37.65,0:43:41.36,Default,,0,0,0,,Хаха~ Сиқыршы сияқты ғой, солай емес пе?
Dialogue: 0,0:43:41.61,0:43:44.70,Default,,0,0,0,,Ертедегі адамдар бұл дүниедегі барлық нәрселермен айналысқан.
Dialogue: 0,0:43:44.99,0:43:47.41,Default,,0,0,0,,Мен ол жерде рух бар деп ойладым.
Dialogue: 0,0:43:48.00,0:43:52.25,Default,,0,0,0,,Демек, сиқыр салып, аруақты тыныштандыратын құдіреті бар адам
Dialogue: 0,0:43:52.50,0:43:54.88,Default,,0,0,0,,Құрметті және қорқады
Dialogue: 0,0:43:55.17,0:43:57.00,Default,,0,0,0,,Бұл қандай ырым?
Dialogue: 0,0:43:57.25,0:43:59.63,Default,,0,0,0,,Бұрынғы адамдар ештеңе білмейтін.
Dialogue: 0,0:44:01.26,0:44:02.93,Default,,0,0,0,,Уайымдама, Кукуру
Dialogue: 0,0:44:03.18,0:44:05.93,Default,,0,0,0,,Шарлатандардан қорқатындар біз емеспіз.
Dialogue: 0,0:44:06.18,0:44:08.97,Default,,0,0,0,,Жарайды, оны ғылыми өркениет дейміз...
Dialogue: 0,0:44:09.22,0:44:10.93,Default,,0,0,0,,Бұл жалған емес
Dialogue: 0,0:44:11.19,0:44:13.98,Default,,0,0,0,,Гига зомбиінің сиқырлы күшіне сәйкес келетін адамдар бар ма?
Dialogue: 0,0:44:14.27,0:44:15.90,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:44:16.19,0:44:18.23,Default,,0,0,0,,Сен осылай қала бересің бе?
Dialogue: 0,0:44:18.65,0:44:21.61,Default,,0,0,0,,Әке мен шешеңе көмектесуің керек емес пе?
Dialogue: 0,0:44:22.03,0:44:24.24,Default,,0,0,0,,Әрине көмектесемін.
Dialogue: 0,0:44:24.53,0:44:26.87,Default,,0,0,0,,Жарайды, оны маған қалдырыңыз.
Dialogue: 0,0:44:27.12,0:44:29.83,Default,,0,0,0,,Біз толқулар мен шытырман оқиғаларды жақсы көреміз.
Dialogue: 0,0:44:30.08,0:44:31.21,Default,,0,0,0,,Бұл маған көмектеседі
Dialogue: 0,0:44:31.62,0:44:33.92,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:44:34.17,0:44:36.46,Default,,0,0,0,,Тұтқынға алынған Хикари тайпасын құтқару үшін—
Dialogue: 0,0:44:36.71,0:44:39.38,Default,,0,0,0,,Ертең материк Қытайға аттанайық.
Dialogue: 0,0:44:39.63,0:44:41.09,Default,,0,0,0,,О
Dialogue: 0,0:44:47.68,0:44:50.10,Default,,0,0,0,,(ит ысқырығы)
Dialogue: 0,0:44:51.68,0:44:54.02,Default,,0,0,0,,(ит ысқырығы)
Dialogue: 0,0:44:55.40,0:44:57.27,Default,,0,0,0,,(ит ысқырығы)
Dialogue: 0,0:44:58.98,0:45:01.28,Default,,0,0,0,,(ит ысқырығы)
Dialogue: 0,0:45:03.53,0:45:05.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:06.28,0:45:07.28,Default,,0,0,0,,Хмм
Dialogue: 0,0:45:07.57,0:45:10.62,Default,,0,0,0,,О, менмін, менмін
Dialogue: 0,0:45:12.25,0:45:13.29,Default,,0,0,0,,Иә
Dialogue: 0,0:45:15.58,0:45:17.33,Default,,0,0,0,,Сіз әлі ұйықтаған жоқсыз ба?
Dialogue: 0,0:45:18.09,0:45:20.80,Default,,0,0,0,,Гига зомби келуі мүмкін
Dialogue: 0,0:45:21.30,0:45:22.76,Default,,0,0,0,,Оның келуі мүмкін емес.
Dialogue: 0,0:45:23.01,0:45:26.05,Default,,0,0,0,,Қалай ойлайсыңдар, бұл жерден Қытайға дейінгі қашықтық қанша?
Dialogue: 0,0:45:27.51,0:45:30.97,Default,,0,0,0,,Ұйқың келмесе, ертеңгі жолың қиын болады.
Dialogue: 0,0:45:31.27,0:45:33.18,Default,,0,0,0,,Менің бөлмемде бірге ұйықтайық
Dialogue: 0,0:45:33.81,0:45:36.69,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:45:39.19,0:45:40.07,Default,,0,0,0,,Иә
Dialogue: 0,0:45:40.73,0:45:42.69,Default,,0,0,0,,Олай болса, мен қалаған нәрсені істеуім керек пе?
Dialogue: 0,0:45:51.29,0:45:52.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:02.50,0:46:03.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:07.55,0:46:09.43,Default,,0,0,0,,Гига зомби?
Dialogue: 0,0:46:20.61,0:46:23.69,Default,,0,0,0,,Күте тұрыңыз, Кукуру, өтінемін, соншалықты абай болмаңыз.
Dialogue: 0,0:46:24.19,0:46:26.20,Default,,0,0,0,,Бүгін таңертең не болды?
Dialogue: 0,0:46:26.49,0:46:28.57,Default,,0,0,0,,Кукул Қытайға жалғыз барады.
Dialogue: 0,0:46:28.82,0:46:29.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:31.07,0:46:34.62,Default,,0,0,0,,Ақымақ, сен бізге әлі сенбейсің бе?
Dialogue: 0,0:46:35.83,0:46:39.17,Default,,0,0,0,,Қарсыластар - қатыгез Кураями тайпасы және Гига зомбилері.
Dialogue: 0,0:46:39.46,0:46:41.71,Default,,0,0,0,,Үйге тірі бара алмайсың.
Dialogue: 0,0:46:42.84,0:46:45.13,Default,,0,0,0,,Балалар сендер жақсы адамдарсыңдар.
Dialogue: 0,0:46:45.67,0:46:47.30,Default,,0,0,0,,Сонымен, бәрі де көп
Dialogue: 0,0:46:48.22,0:46:51.35,Default,,0,0,0,,Иә, мұны басыңызға қойыңыз
Dialogue: 0,0:46:51.60,0:46:52.55,Default,,0,0,0,,Баста?
Dialogue: 0,0:46:52.80,0:46:54.01,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:46:56.14,0:47:00.15,Default,,0,0,0,,Иә? Уау...
Dialogue: 0,0:47:00.44,0:47:02.73,Default,,0,0,0,,Уваа
Dialogue: 0,0:47:06.36,0:47:07.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:08.24,0:47:10.24,Default,,0,0,0,,Аспанда ұштың ба?
Dialogue: 0,0:47:11.20,0:47:14.54,Default,,0,0,0,,Мен желдің рухына сені ұшыруды бұйырдым.
Dialogue: 0,0:47:14.83,0:47:15.58,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:47:15.83,0:47:19.25,Default,,0,0,0,,Бұл адам Дразомби, ұлы сиқыршы!
Dialogue: 0,0:47:19.92,0:47:24.17,Default,,0,0,0,,Ағаш рухы да, су рухы да Дразомбидің мейірімінде.
Dialogue: 0,0:47:24.42,0:47:26.84,Default,,0,0,0,,Сіз мұны маған тыныштықпен қалдыра аласыз, солай ма?
Dialogue: 0,0:47:27.71,0:47:28.80,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:47:29.05,0:47:30.97,Default,,0,0,0,,Дразомби-сама
Dialogue: 0,0:47:31.22,0:47:33.51,Default,,0,0,0,,Тоқта, бұл ұят
Dialogue: 0,0:47:33.64,0:47:35.31,Default,,0,0,0,,Эй
Dialogue: 0,0:47:36.72,0:47:40.19,Default,,0,0,0,,Ааа~ Бірдеңе болды ма?
Dialogue: 0,0:47:40.52,0:47:42.15,Default,,0,0,0,,Гааах!
Dialogue: 0,0:47:57.62,0:47:59.96,Default,,0,0,0,,үшін дайын ба?
Dialogue: 0,0:48:03.54,0:48:09.34,Default,,0,0,0,,Материк Қытайға барайық, хаха!
Dialogue: 0,0:48:23.98,0:48:25.44,Default,,0,0,0,,Сәлем
Dialogue: 0,0:48:25.98,0:48:29.86,Default,,0,0,0,,Иә, ақ боз атты рыцарь келді.
Dialogue: 0,0:48:30.11,0:48:33.28,Default,,0,0,0,,Тексеріңіз, Нобита жай ғана салқын болуға тырысады.
Dialogue: 0,0:48:33.53,0:48:36.37,Default,,0,0,0,,Мен көмектесе алмаймын, мен үй жануарларының министрімін.
Dialogue: 0,0:48:36.78,0:48:40.54,Default,,0,0,0,,Түсінсең де ашуланба.
Dialogue: 0,0:48:40.79,0:48:43.21,Default,,0,0,0,,Гури-чан, қиын, бірақ рахмет.
Dialogue: 0,0:48:43.46,0:48:44.50,Default,,0,0,0,,Гуруру
Dialogue: 0,0:48:44.79,0:48:49.50,Default,,0,0,0,,2000 км-ден астам Тікелей жол қашықтығы Хэсиан, Анки провинциясы, Қытай
Dialogue: 0,0:48:49.80,0:48:53.51,Default,,0,0,0,,Осы жылдамдықпен кешке дейін жетеміз деп ойлаймын.
Dialogue: 0,0:48:53.76,0:48:57.97,Default,,0,0,0,,Бірақ Жапония мен Қытайдың арасында кең мұхит бар, солай емес пе?
Dialogue: 0,0:48:58.22,0:49:00.47,Default,,0,0,0,,Драко мен басқалары жолда шаршап қалса ше?
Dialogue: 0,0:49:00.72,0:49:05.73,Default,,0,0,0,,Уайымдамаңыз, мен сенімді болу үшін кетер алдында спутниктік суретке түсірдім.
Dialogue: 0,0:49:05.98,0:49:07.19,Default,,0,0,0,,Эй (Нобита) Уау
Dialogue: 0,0:49:07.48,0:49:09.36,Default,,0,0,0,,Уа, ау, ау
Dialogue: 0,0:49:09.61,0:49:10.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:12.65,0:49:16.74,Default,,0,0,0,,Аа, Жапония материкке қосылған.
Dialogue: 0,0:49:16.99,0:49:19.33,Default,,0,0,0,,Өйткені біз мұз дәуіріндеміз
Dialogue: 0,0:49:19.62,0:49:22.79,Default,,0,0,0,,Жер суыған сайын мұз көбейіп, су азаяды.
Dialogue: 0,0:49:23.46,0:49:27.71,Default,,0,0,0,,Су азайған сайын теңіз деңгейі төмендеп, жер көлемі ұлғаяды.
Dialogue: 0,0:49:28.00,0:49:31.21,Default,,0,0,0,,Сонда сіз әрқашан төмен түсіп, демалуға болады.
Dialogue: 0,0:49:32.92,0:49:36.59,Default,,0,0,0,,Енді теңізге шықтыңыз, жағалау сызығымен батысқа қарай жүріңіз.
Dialogue: 0,0:49:36.84,0:49:38.22,Default,,0,0,0,,О
Dialogue: 0,0:49:38.51,0:49:40.72,Default,,0,0,0,,Үлкен тау көрінді
Dialogue: 0,0:49:41.01,0:49:43.68,Default,,0,0,0,,Эй, мүмкін солай ма?
Dialogue: 0,0:49:45.39,0:49:48.27,Default,,0,0,0,,Фудзи тауы, таңғажайып
Dialogue: 0,0:49:48.81,0:49:53.03,Default,,0,0,0,,Фудзи тауы шамамен 100 000 жыл бұрын дүниеге келген.
Dialogue: 0,0:49:53.32,0:49:56.45,Default,,0,0,0,,Дұрыс. Түскі асты осында ішейік.
Dialogue: 0,0:49:56.70,0:49:58.57,Default,,0,0,0,,О
Dialogue: 0,0:50:00.78,0:50:02.20,Default,,0,0,0,,О
Dialogue: 0,0:50:02.54,0:50:05.66,Default,,0,0,0,,Бізде түскі асқа гамбургер, картоп және кола да бар.
Dialogue: 0,0:50:05.91,0:50:08.38,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:50:10.50,0:50:11.46,Default,,0,0,0,,Хмм
Dialogue: 0,0:50:13.92,0:50:15.13,Default,,0,0,0,,Дәмді
Dialogue: 0,0:50:15.47,0:50:18.18,Default,,0,0,0,,Менің ойымша, үңгір адамдары да гамбургерді ұнататын.
Dialogue: 0,0:50:18.39,0:50:20.14,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:50:20.80,0:50:22.31,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:50:24.73,0:50:28.27,Default,,0,0,0,,Жапон халқының ата-бабалары Қытайдан қоныс аударған.
Dialogue: 0,0:50:28.56,0:50:29.31,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:50:29.69,0:50:30.77,Default,,0,0,0,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:50:31.06,0:50:32.90,Default,,0,0,0,,Сондай-ақ Корея мен Сібір
Dialogue: 0,0:50:33.15,0:50:36.28,Default,,0,0,0,,Адамдар оңтүстік аралдардан да көшіп келген сияқты.
Dialogue: 0,0:50:36.57,0:50:39.78,Default,,0,0,0,,Адамзат алыс Африка жерінде дүниеге келгеннен бері
Dialogue: 0,0:50:40.03,0:50:44.24,Default,,0,0,0,,Дүние жүзіне таралу үшін ондаған мың жыл қажет болды.
Dialogue: 0,0:50:44.58,0:50:46.79,Default,,0,0,0,,Әртүрлі елдерден келген адамдар бар.
Dialogue: 0,0:50:47.04,0:50:51.71,Default,,0,0,0,,Егер сіз алыстағы ата-бабаларыңызды іздесеңіз, бүкіл әлемдегі адамдар туыс.
Dialogue: 0,0:50:52.13,0:50:54.67,Default,,0,0,0,,Олай болса, кез келген жағдайда Кукуру менікі...
Dialogue: 0,0:50:54.92,0:50:58.43,Default,,0,0,0,,Атаның атасының атасы...
Dialogue: 0,0:50:58.72,0:51:00.68,Default,,0,0,0,,Тоқта, ата!
Dialogue: 0,0:51:01.09,0:51:03.56,Default,,0,0,0,,Ол көңілді ата.
Dialogue: 0,0:51:03.97,0:51:05.10,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:51:05.35,0:51:07.85,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:51:11.61,0:51:14.65,Default,,0,0,0,,Біраз уақыттан бері бірде-бір үлкен ағаш жоқ.
Dialogue: 0,0:51:14.94,0:51:17.32,Default,,0,0,0,,Ол ойлы-қырлы тастарға толы.
Dialogue: 0,0:51:17.57,0:51:20.66,Default,,0,0,0,,Соңғы уақытқа дейін мұхит түбінде болған.
Dialogue: 0,0:51:20.95,0:51:24.33,Default,,0,0,0,,Осы құрлық көпірі аймағынан өткеннен кейін сіз Қытай материгінде боласыз.
Dialogue: 0,0:51:24.91,0:51:26.20,Default,,0,0,0,,Түн жақындап қалды
Dialogue: 0,0:51:26.45,0:51:30.29,Default,,0,0,0,,Баратын жеріңізге жету үшін жақсы уақыт.
Dialogue: 0,0:51:32.00,0:51:32.71,Default,,0,0,0,,Ах (Нобита) Иә?
Dialogue: 0,0:51:33.00,0:51:35.42,Default,,0,0,0,,Бұл менің балық аулайтын өзен.
Dialogue: 0,0:51:35.75,0:51:38.17,Default,,0,0,0,,Жарайды, төмен түсейік.
Dialogue: 0,0:51:43.51,0:51:44.89,Default,,0,0,0,,Ол толығымен күйіп кеткен.
Dialogue: 0,0:51:45.14,0:51:46.72,Default,,0,0,0,,Білмеймін. Не туралы айтып тұрсың? Мен түсінбеймін, Дио.
Dialogue: 0,0:51:47.72,0:51:49.60,Default,,0,0,0,,Жылама, Кукуру
Dialogue: 0,0:51:49.85,0:51:52.23,Default,,0,0,0,,Біз оны міндетті түрде табамыз.
Dialogue: 0,0:51:52.94,0:51:56.07,Default,,0,0,0,,Әйтеуір, біз бастапқы сызыққа жеттік.
Dialogue: 0,0:51:56.65,0:52:00.15,Default,,0,0,0,,Таң атқаннан кейін Кураями тайпасын қадағалауды бастайық.
Dialogue: 0,0:52:08.50,0:52:10.25,Default,,0,0,0,,Жақсы тіл табысайық, иә?
Dialogue: 0,0:52:10.75,0:52:13.42,Default,,0,0,0,,Хехехе, қытықтайды, хехехе
Dialogue: 0,0:52:15.17,0:52:16.55,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:52:18.51,0:52:19.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:20.42,0:52:26.22,Default,,0,0,0,,(3 жылау)
Dialogue: 0,0:52:26.68,0:52:30.93,Default,,0,0,0,,Түсіндім, мен бейтаныс жерде болғандықтан ұйықтай алмаймын.
Dialogue: 0,0:52:31.39,0:52:34.10,Default,,0,0,0,,Жарайды, бүгін бірге ұйықтайық.
Dialogue: 0,0:52:34.31,0:52:36.90,Default,,0,0,0,,Хехе, қайырлы түн
Dialogue: 0,0:52:49.49,0:52:50.79,Default,,0,0,0,,Хехехе
Dialogue: 0,0:53:00.26,0:53:02.72,Default,,0,0,0,,Сұрау таяқшасы!
Dialogue: 0,0:53:02.92,0:53:03.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:04.09,0:53:08.43,Default,,0,0,0,,Бұл таяқ сізге қаралып отырған адамның бағытын айтып береді.
Dialogue: 0,0:53:10.10,0:53:11.27,Default,,0,0,0,,Солтүстік-солтүстік-батыс
Dialogue: 0,0:53:12.10,0:53:15.44,Default,,0,0,0,,Онда алынған хикари тайпасы сонда болуы керек.
Dialogue: 0,0:53:16.27,0:53:17.48,Default,,0,0,0,,Тезірек кетейік
Dialogue: 0,0:53:17.77,0:53:18.86,Default,,0,0,0,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:53:20.15,0:53:24.32,Default,,0,0,0,,Пега мен басқаларды осында қалдырып, Баспропеллер арқылы қозғалайық.
Dialogue: 0,0:53:24.61,0:53:25.41,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:53:25.66,0:53:27.37,Default,,0,0,0,,Тым көзге түсетін
Dialogue: 0,0:53:27.62,0:53:31.49,Default,,0,0,0,,Кураями тайпасы бізді тауып, жасырып қалса, біз оларды іздеуге мүмкіндік жоқ.
Dialogue: 0,0:53:31.75,0:53:32.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:53:35.71,0:53:38.67,Default,,0,0,0,,Бұл сізге 3 күнге жетеді.
Dialogue: 0,0:53:39.21,0:53:43.17,Default,,0,0,0,,Амансың ба? Мен мұнда тыныш тұрамын.
Dialogue: 0,0:53:46.13,0:53:48.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:48.22,0:53:49.89,Default,,0,0,0,,(3 жылау)
Dialogue: 0,0:53:50.51,0:53:53.85,Default,,0,0,0,,Жоқ, мен сені өзіммен бірге ала алмаймын.
Dialogue: 0,0:53:54.85,0:53:58.69,Default,,0,0,0,,Жақында қайтамын, жақсы қыз бол.
Dialogue: 0,0:53:59.65,0:54:01.44,Default,,0,0,0,,(3 жылау)
Dialogue: 0,0:54:03.53,0:54:06.20,Default,,0,0,0,,Олар қанша қашықтықта?
Dialogue: 0,0:54:06.49,0:54:08.37,Default,,0,0,0,,4 күн бұрын шабуыл жасалды
Dialogue: 0,0:54:08.62,0:54:11.33,Default,,0,0,0,,4 күн жүрсең онша алыс емес.
Dialogue: 0,0:54:11.99,0:54:14.29,Default,,0,0,0,,Бір жерде лагерь қирандылары болуы керек.
Dialogue: 0,0:54:16.54,0:54:17.21,Default,,0,0,0,,Ах
Dialogue: 0,0:54:20.17,0:54:22.46,Default,,0,0,0,,Егер мен мұнда үлкен мәселе етіп көтермесем, қашан көтеремін?
Dialogue: 0,0:54:22.71,0:54:24.21,Default,,0,0,0,,Сіз бірдеңе көрдіңіз бе?
Dialogue: 0,0:54:24.51,0:54:26.13,Default,,0,0,0,,Бұл Кураями тайпасының найзасы.
Dialogue: 0,0:54:26.38,0:54:28.93,Default,,0,0,0,,Міне, мен аң ауладым, олжамды жедім.
Dialogue: 0,0:54:29.30,0:54:32.22,Default,,0,0,0,,Бұл бірінші күннен бастап лагерь алаңы ма?
Dialogue: 0,0:54:32.51,0:54:35.68,Default,,0,0,0,,Бөлініп қалмас үшін алыстан іздейік.
Dialogue: 0,0:54:36.43,0:54:38.90,Default,,0,0,0,,Бұл екінші күннен бастап лагерь болды.
Dialogue: 0,0:54:39.15,0:54:41.36,Default,,0,0,0,,3-ші күн, яғни Юбе
Dialogue: 0,0:54:41.86,0:54:44.90,Default,,0,0,0,,Тезірек, біз жақынбыз. (үшін) Иә.
Dialogue: 0,0:54:52.08,0:54:54.08,Default,,0,0,0,,Ааа
Dialogue: 0,0:54:55.08,0:54:56.08,Default,,0,0,0,,Ақсақал
Dialogue: 0,0:54:56.37,0:54:58.75,Default,,0,0,0,,Алға, мен үшін уайымдама.
Dialogue: 0,0:54:59.25,0:55:01.42,Default,,0,0,0,,Иә? Сіз немен айналысып жатырсыз?
Dialogue: 0,0:55:01.67,0:55:02.42,Default,,0,0,0,,Тұру
Dialogue: 0,0:55:02.67,0:55:05.09,Default,,0,0,0,,Өтінемін, маған біраз демалуға рұқсат етіңіз.
Dialogue: 0,0:55:05.34,0:55:06.38,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:55:07.51,0:55:09.09,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:55:10.59,0:55:11.34,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:55:12.05,0:55:13.26,Default,,0,0,0,,Уау! (Хикари тайпасы В) Эй!
Dialogue: 0,0:55:14.06,0:55:15.77,Default,,0,0,0,,Гига~
Dialogue: 0,0:55:16.77,0:55:18.85,Default,,0,0,0,,Цучидама-сама, саған бірдеңе керек пе?
Dialogue: 0,0:55:19.39,0:55:23.15,Default,,0,0,0,,Саған қарсы қимылдайтындарды, жүрмейтіндерді өлтіріп, алға ұмтыл.
Dialogue: 0,0:55:23.40,0:55:26.78,Default,,0,0,0,,Токоями сарайына баратын жол әлі ұзақ.
Dialogue: 0,0:55:27.07,0:55:28.32,Default,,0,0,0,,Сәлем
Dialogue: 0,0:55:31.41,0:55:32.07,Default,,0,0,0,,Жолдан шығыңыз
Dialogue: 0,0:55:33.45,0:55:34.08,Default,,0,0,0,,Хамф!
Dialogue: 0,0:55:34.33,0:55:36.45,Default,,0,0,0,,Кел, қолыңнан келсе, істе.
Dialogue: 0,0:55:36.75,0:55:40.46,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:55:41.54,0:55:42.96,Default,,0,0,0,,Уау~ (адамдар айқайлайды)
Dialogue: 0,0:55:44.63,0:55:46.92,Default,,0,0,0,,үшінң тыңдаңдар.
Dialogue: 0,0:55:47.38,0:55:51.18,Default,,0,0,0,,Мен Ұлы Рух патшасы Дразомбимін
Dialogue: 0,0:55:51.38,0:55:54.85,Default,,0,0,0,,Хикари тайпасын дереу босатыңыз.
Dialogue: 0,0:55:55.26,0:56:00.64,Default,,0,0,0,,Әйтпесе, мен барбекюге найзағайдың рухын қоздырамын.
Dialogue: 0,0:56:00.94,0:56:02.19,Default,,0,0,0,,Иә? Рух патшасы?
Dialogue: 0,0:56:02.48,0:56:03.31,Default,,0,0,0,,Дразомби?
Dialogue: 0,0:56:03.56,0:56:06.61,Default,,0,0,0,,Түсінбейсіз бе? Сонда мен саған көрсетемін
Dialogue: 0,0:56:06.86,0:56:08.82,Default,,0,0,0,,Дразомбидің күші
Dialogue: 0,0:56:09.03,0:56:10.65,Default,,0,0,0,,Уау
Dialogue: 0,0:56:10.95,0:56:12.82,Default,,0,0,0,,Хо хо хо
Dialogue: 0,0:56:13.45,0:56:15.49,Default,,0,0,0,,Дора-чан нағыз сиқыршыға ұқсайды
Dialogue: 0,0:56:15.78,0:56:17.33,Default,,0,0,0,,Оған кіру таңқаларлық оңай.
Dialogue: 0,0:56:17.54,0:56:19.16,Default,,0,0,0,,Біз де барайық (Нобита) Иә.
Dialogue: 0,0:56:19.29,0:56:20.50,Default,,0,0,0,,Жарайды
Dialogue: 0,0:56:21.41,0:56:22.62,Default,,0,0,0,,Міне.
Dialogue: 0,0:56:22.87,0:56:24.54,Default,,0,0,0,,Бұл Кукуру
Dialogue: 0,0:56:24.79,0:56:27.63,Default,,0,0,0,,Яаа
Dialogue: 0,0:56:28.13,0:56:29.38,Default,,0,0,0,,Қара, қара, қара!
Dialogue: 0,0:56:29.63,0:56:30.47,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,0:56:30.72,0:56:32.34,Default,,0,0,0,,Иә, сағ.
Dialogue: 0,0:56:34.26,0:56:35.43,Default,,0,0,0,,Уау
Dialogue: 0,0:56:36.64,0:56:38.72,Default,,0,0,0,,Эй, артқа кет!
Dialogue: 0,0:56:41.60,0:56:43.48,Default,,0,0,0,,Ия, мен жеңдім, мен жеңдім.
Dialogue: 0,0:56:43.73,0:56:44.85,Default,,0,0,0,,Бұл қандай зат?
Dialogue: 0,0:56:45.11,0:56:46.86,Default,,0,0,0,,Кукуру Кукуру
Dialogue: 0,0:56:48.15,0:56:50.86,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:56:51.19,0:56:52.70,Default,,0,0,0,,Cucur
Dialogue: 0,0:56:53.66,0:56:55.12,Default,,0,0,0,,Сен жақсысың деп үміттенемін.
Dialogue: 0,0:56:55.37,0:56:57.49,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін деп ойладым.
Dialogue: 0,0:56:57.74,0:56:59.74,Default,,0,0,0,,Сіз маған көмектесуге жиі келетінсіз.
Dialogue: 0,0:57:00.62,0:57:02.87,Default,,0,0,0,,Сіз отбасыңызбен қайта қосыла алдыңыз.
Dialogue: 0,0:57:03.16,0:57:06.00,Default,,0,0,0,,Мен мұндай жағдайларда әлсізмін.
Dialogue: 0,0:57:06.25,0:57:07.71,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:57:08.17,0:57:11.21,Default,,0,0,0,,Гига~
Dialogue: 0,0:57:11.51,0:57:12.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:12.67,0:57:14.38,Default,,0,0,0,,Не? Гига~
Dialogue: 0,0:57:14.63,0:57:16.22,Default,,0,0,0,,Мен оны осы жерден естимін.
Dialogue: 0,0:57:16.51,0:57:19.26,Default,,0,0,0,,Ги~га~ (үшін) Уау!
Dialogue: 0,0:57:22.89,0:57:25.06,Default,,0,0,0,,Гига~
Dialogue: 0,0:57:25.35,0:57:27.06,Default,,0,0,0,,Саз жұмысы сөйлеп тұр
Dialogue: 0,0:57:27.69,0:57:29.65,Default,,0,0,0,,Мен Цучидамамын
Dialogue: 0,0:57:29.90,0:57:33.07,Default,,0,0,0,,Мен Кига Зомби-саманың адал қызметшісімін.
Dialogue: 0,0:57:33.32,0:57:34.28,Default,,0,0,0,,Гига зомби?
Dialogue: 0,0:57:34.53,0:57:36.41,Default,,0,0,0,,Конняро, төмен түс.
Dialogue: 0,0:57:36.70,0:57:38.37,Default,,0,0,0,,Ақымақтар
Dialogue: 0,0:57:40.20,0:57:41.91,Default,,0,0,0,,О? Ааааа
Dialogue: 0,0:57:42.20,0:57:43.54,Default,,0,0,0,,Джан
Dialogue: 0,0:57:43.79,0:57:45.92,Default,,0,0,0,,Қазір бұл не? Бұл соққы толқыны
Dialogue: 0,0:57:46.67,0:57:48.75,Default,,0,0,0,,Соққы таяқшасымен қарсы шабуыл
Dialogue: 0,0:57:53.38,0:57:56.43,Default,,0,0,0,,Менің қаншалықты қорқынышты екенімді әлі де түсінбейсің бе?
Dialogue: 0,0:57:57.22,0:57:58.76,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:57:59.93,0:58:01.76,Default,,0,0,0,,Жартастың артына тығылған
Dialogue: 0,0:58:05.27,0:58:07.02,Default,,0,0,0,,Ах (Нобита) Жартас
Dialogue: 0,0:58:07.27,0:58:08.48,Default,,0,0,0,,Нобита-сан (Нобита) Уау
Dialogue: 0,0:58:10.57,0:58:12.90,Default,,0,0,0,,Нобитаға көмектесіңіз
Dialogue: 0,0:58:13.40,0:58:14.61,Default,,0,0,0,,Cucur
Dialogue: 0,0:58:15.57,0:58:18.28,Default,,0,0,0,,Дораемон! Бірдеңе жасаңыз
Dialogue: 0,0:58:18.53,0:58:21.03,Default,,0,0,0,,Мынау да, мынау да болған жоқ.
Dialogue: 0,0:58:21.53,0:58:23.08,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:58:25.58,0:58:26.75,Default,,0,0,0,,Ei
Dialogue: 0,0:58:27.62,0:58:28.79,Default,,0,0,0,,Хирари плащы!
Dialogue: 0,0:58:31.00,0:58:34.26,Default,,0,0,0,,Джиджи? Гига!
Dialogue: 0,0:58:38.76,0:58:41.64,Default,,0,0,0,,Уау, мен жасадым! Дораэмон күткендей
Dialogue: 0,0:58:42.26,0:58:45.93,Default,,0,0,0,,Сөйтсе де, неге мұндай кесек топырақ бар...
Dialogue: 0,0:58:46.23,0:58:49.19,Default,,0,0,0,,Ол қозғалды ма, әлде сөйледі ме?
Dialogue: 0,0:58:49.48,0:58:50.65,Default,,0,0,0,,Дораемон
Dialogue: 0,0:58:51.06,0:58:52.27,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:58:52.52,0:58:55.61,Default,,0,0,0,,Хикари тайпасының барлығы рахмет айтқысы келеді.
Dialogue: 0,0:58:56.44,0:59:00.99,Default,,0,0,0,,Дразомби мырза, ризашылығымды қалай білдіруге болады?
Dialogue: 0,0:59:01.24,0:59:04.33,Default,,0,0,0,,Менің атым Дораемон. О?
Dialogue: 0,0:59:04.58,0:59:06.70,Default,,0,0,0,,Жарайды, айдаһар зомби болып қал.
Dialogue: 0,0:59:07.29,0:59:11.79,Default,,0,0,0,,Эй, сен барлық Хикари тайпасын Жапонияға апарғың келе ме?
Dialogue: 0,0:59:11.96,0:59:13.50,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:59:13.75,0:59:16.92,Default,,0,0,0,,Кураями тайпасының тағы қашан шабуыл жасайтынын ешқашан білмейсіз.
Dialogue: 0,0:59:17.17,0:59:20.39,Default,,0,0,0,,Жарайды, барлық жерде есік болды.
Dialogue: 0,0:59:20.68,0:59:23.22,Default,,0,0,0,,Сіз есіктерді барлық жерде пайдалана алмайсыз, солай емес пе?
Dialogue: 0,0:59:23.51,0:59:28.43,Default,,0,0,0,,Мен оған Жапониядан келгенге дейін жолды жаттап алуға мәжбүрледім.
Dialogue: 0,0:59:28.94,0:59:30.52,Default,,0,0,0,,Олай болса, Жапонияға барайық.
Dialogue: 0,0:59:30.81,0:59:34.02,Default,,0,0,0,,Күте тұрыңыз, мен Пега мен басқаларды алуым керек.
Dialogue: 0,0:59:34.40,0:59:35.57,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:59:35.82,0:59:38.86,Default,,0,0,0,,Алдымен Хошендегі Хикари ауылына барыңыз.
Dialogue: 0,0:59:40.49,0:59:43.37,Default,,0,0,0,,О, бұл шынымен менің ауылым.
Dialogue: 0,0:59:43.87,0:59:45.83,Default,,0,0,0,,үшін өтті ме?
Dialogue: 0,0:59:56.67,0:59:59.38,Default,,0,0,0,,Менің енот ит құбыжық
Dialogue: 0,0:59:59.63,1:00:04.39,Default,,0,0,0,,Мен бұл ренішті қалдыруым керек пе?
Dialogue: 0,1:00:06.01,1:00:06.93,Default,,0,0,0,,Пега
Dialogue: 0,1:00:07.10,1:00:08.73,Default,,0,0,0,,Гри Драко
Dialogue: 0,1:00:09.64,1:00:11.27,Default,,0,0,0,,Мен Жапонияға қайтамын.
Dialogue: 0,1:00:11.52,1:00:13.23,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,1:00:13.52,1:00:15.23,Default,,0,0,0,,үшін~
Dialogue: 0,1:00:17.32,1:00:19.11,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,1:00:21.53,1:00:22.61,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,1:00:23.20,1:00:27.08,Default,,0,0,0,,Мен заттарды тастап кеткендіктен адасып қаламын.
Dialogue: 0,1:00:28.16,1:00:31.83,Default,,0,0,0,,Уайымдама, ол балалар мықты.
Dialogue: 0,1:00:32.21,1:00:35.54,Default,,0,0,0,,Сіз өз еркіндігіңізден күтпеген жерден ләззат алуыңыз мүмкін.
Dialogue: 0,1:00:35.84,1:00:37.80,Default,,0,0,0,,Әзірше Жапонияға оралайық.
Dialogue: 0,1:00:38.21,1:00:41.55,Default,,0,0,0,,Жоқ, оны тапқанша іздеңіз.
Dialogue: 0,1:00:41.80,1:00:43.43,Default,,0,0,0,,Сенің сезіміңді түсінемін, бірақ
Dialogue: 0,1:00:43.68,1:00:48.60,Default,,0,0,0,,Хикари тайпасын мүмкіндігінше тезірек Жапониядағы қауіпсіз жерге жеткізуіміз керек.
Dialogue: 0,1:00:57.15,1:01:00.03,Default,,0,0,0,,О, қандай әдемі
Dialogue: 0,1:01:00.69,1:01:03.07,Default,,0,0,0,,Сіз осында өмір сүре алатыныңызға сенімдісіз бе?
Dialogue: 0,1:01:03.32,1:01:05.32,Default,,0,0,0,,Ол жерде әлі ешкім тұрмайтын сияқты.
Dialogue: 0,1:01:05.62,1:01:08.24,Default,,0,0,0,,Қалаған жеріңе ауыл сал.
Dialogue: 0,1:01:08.49,1:01:10.83,Default,,0,0,0,,Уау Уау Уау Уау!
Dialogue: 0,1:01:11.58,1:01:15.46,Default,,0,0,0,,Маған бұл жер ұнайды. Көрініс тамаша, көл жақын.
Dialogue: 0,1:01:17.59,1:01:18.63,Default,,0,0,0,,Иә
Dialogue: 0,1:01:22.92,1:01:25.01,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:01:26.30,1:01:29.26,Default,,0,0,0,,Үйге бағана жасау үшін ағаштарды кесу
Dialogue: 0,1:01:29.60,1:01:32.39,Default,,0,0,0,,Тас осьтер күңгірт және қиын.
Dialogue: 0,1:01:32.68,1:01:33.52,Default,,0,0,0,,Иә.
Dialogue: 0,1:01:35.69,1:01:36.98,Default,,0,0,0,,Дразомби-сама
Dialogue: 0,1:01:37.23,1:01:40.23,Default,,0,0,0,,Бұл жердегі бірінші ойын.
Dialogue: 0,1:01:40.48,1:01:42.53,Default,,0,0,0,,Тамағыңыздан ләззат алыңыз.
Dialogue: 0,1:01:42.69,1:01:45.45,Default,,0,0,0,,Уау~ мен жеймін
Dialogue: 0,1:01:46.49,1:01:47.57,Default,,0,0,0,,Дәмді~
Dialogue: 0,1:01:47.82,1:01:49.41,Default,,0,0,0,,Дораемон иә?
Dialogue: 0,1:01:49.66,1:01:52.66,Default,,0,0,0,,үшінна жеңіл құралдарды беріңіз.
Dialogue: 0,1:01:52.91,1:01:53.91,Default,,0,0,0,,Жоқ (2 адам) Иә?
Dialogue: 0,1:01:54.62,1:01:57.17,Default,,0,0,0,,Тас дәуіріндегі адамдар футуристік құралдарды пайдаланса ше?
Dialogue: 0,1:01:57.42,1:01:59.42,Default,,0,0,0,,Тарих шатастырады
Dialogue: 0,1:01:59.79,1:02:04.84,Default,,0,0,0,,Адамдардың тапқырлығы және олар көрген қиындықтардың орнын толтыру үшін пайдалы құралдарды жасайды.
Dialogue: 0,1:02:05.26,1:02:08.18,Default,,0,0,0,,Бұл өркениеттің дамуы деп аталады.
Dialogue: 0,1:02:09.35,1:02:11.85,Default,,0,0,0,,Тексер, икемсіз жігіт.
Dialogue: 0,1:02:12.14,1:02:13.18,Default,,0,0,0,,Сараң зомби
Dialogue: 0,1:02:13.43,1:02:15.64,Default,,0,0,0,,Мәселе осы емес пе?
Dialogue: 0,1:02:16.06,1:02:18.31,Default,,0,0,0,,Шизукача~фуу
Dialogue: 0,1:02:19.02,1:02:21.52,Default,,0,0,0,,Шапқан шөпті не істейсің?
Dialogue: 0,1:02:21.77,1:02:24.44,Default,,0,0,0,,Оны сол жерге жинап қойыңыз.
Dialogue: 0,1:02:24.99,1:02:28.87,Default,,0,0,0,,Тас дәуірінің балалары еңбекқор болған.
Dialogue: 0,1:02:29.12,1:02:30.78,Default,,0,0,0,,Біз де көмектесеміз бе?
Dialogue: 0,1:02:31.03,1:02:31.74,Default,,0,0,0,,Иә
Dialogue: 0,1:02:32.16,1:02:34.95,Default,,0,0,0,,Ағай, апа, мен мынаны осында қалдырамын.
Dialogue: 0,1:02:35.20,1:02:37.21,Default,,0,0,0,,А, бұл пайдалы. (2 адам) Хехехе
Dialogue: 0,1:02:37.83,1:02:41.09,Default,,0,0,0,,Нобита бос емес кезде не істеп жатыр?
Dialogue: 0,1:02:41.38,1:02:43.71,Default,,0,0,0,,Сен бәрібір өзеннің жағасында ұйықтайсың.
Dialogue: 0,1:02:56.98,1:02:58.19,Default,,0,0,0,,Ха!
Dialogue: 0,1:02:59.65,1:03:00.40,Default,,0,0,0,,Pega
Dialogue: 0,1:03:17.29,1:03:19.17,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:21.21,1:03:22.59,Default,,0,0,0,,Бұл иттің ысқырығы.
Dialogue: 0,1:03:22.88,1:03:25.63,Default,,0,0,0,,Кесілген бұғы сүйектерінен жасалған.
Dialogue: 0,1:03:25.88,1:03:28.13,Default,,0,0,0,,Бұл Заңды шақырғанда да қолданылған.
Dialogue: 0,1:03:28.55,1:03:29.59,Default,,0,0,0,,Заң?
Dialogue: 0,1:03:29.84,1:03:32.76,Default,,0,0,0,,Ол мен ұстайтын қасқырдың баласы.
Dialogue: 0,1:03:33.39,1:03:36.60,Default,,0,0,0,,Ол менімен жақсы араласатын сүйкімді жігіт еді.
Dialogue: 0,1:03:38.06,1:03:40.77,Default,,0,0,0,,Бірде ауылды аралап шықтым.
Dialogue: 0,1:03:41.06,1:03:43.77,Default,,0,0,0,,Жақын жерде аң аулайтын олжа жоқ.
Dialogue: 0,1:03:44.98,1:03:47.78,Default,,0,0,0,,Күн батып, шығады
Dialogue: 0,1:03:48.03,1:03:50.45,Default,,0,0,0,,Бату және көтерілу
Dialogue: 0,1:03:50.78,1:03:53.12,Default,,0,0,0,,Бұл ұзақ, ұзақ жол болды.
Dialogue: 0,1:03:54.12,1:03:56.62,Default,,0,0,0,,Біз мамонттардың үйірін таптық.
Dialogue: 0,1:03:56.91,1:03:59.46,Default,,0,0,0,,Мен айқайлап, оны балшықта бұрышқа қыстым.
Dialogue: 0,1:03:59.75,1:04:02.29,Default,,0,0,0,,Мамонтқа да, бізге де қауіп төніп тұр.
Dialogue: 0,1:04:02.58,1:04:04.92,Default,,0,0,0,,Бұл қазірдің өзінде үлкен шу.
Dialogue: 0,1:04:06.09,1:04:09.01,Default,,0,0,0,,Сонда мен білмей тұрып, Заң кетіп қалды.
Dialogue: 0,1:04:09.26,1:04:10.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:12.01,1:04:15.81,Default,,0,0,0,,Сізді мамонт басып қалды ма? Сіз балшыққа батып кеттіңіз бе?
Dialogue: 0,1:04:16.06,1:04:18.60,Default,,0,0,0,,Мүмкін сіз оны артта қалдырған шығарсыз?
Dialogue: 0,1:04:18.89,1:04:20.89,Default,,0,0,0,,Сіз өзімшілмін деп айта алмайсыз.
Dialogue: 0,1:04:21.35,1:04:24.81,Default,,0,0,0,,Сонда да мен мұны күнде ойнай бердім.
Dialogue: 0,1:04:25.77,1:04:28.82,Default,,0,0,0,,Сосын бір күн, бір айдан астам уақыт өткен соң...
Dialogue: 0,1:04:29.07,1:04:30.74,Default,,0,0,0,,Ван Ван Ван Ван
Dialogue: 0,1:04:30.99,1:04:33.99,Default,,0,0,0,,Жараланып, лай басып қалсам да.
Dialogue: 0,1:04:34.28,1:04:37.49,Default,,0,0,0,,Тіке кеудеме секірді.
Dialogue: 0,1:04:39.45,1:04:43.71,Default,,0,0,0,,Аңдар өз иелерін табуда ұшқыр сезімге ие.
Dialogue: 0,1:04:44.08,1:04:47.50,Default,,0,0,0,,Сонымен Нобитаның үш жануары...
Dialogue: 0,1:04:47.96,1:04:48.67,Default,,0,0,0,,Эй
Dialogue: 0,1:04:50.21,1:04:51.09,Default,,0,0,0,,Иә
Dialogue: 0,1:04:51.34,1:04:55.26,Default,,0,0,0,,Ауыл бітуге жақын. Сен маған көмектесе аласың ба?
Dialogue: 0,1:04:55.47,1:04:56.60,Default,,0,0,0,,Әрине
Dialogue: 0,1:05:00.68,1:05:02.98,Default,,0,0,0,,Енді жоқ, қозғала алмаймын.
Dialogue: 0,1:05:03.23,1:05:05.48,Default,,0,0,0,,Жарты жолда әлсіреп кетсем де
Dialogue: 0,1:05:05.73,1:05:07.52,Default,,0,0,0,,Менің қолыма бұршақ болды.
Dialogue: 0,1:05:07.77,1:05:09.48,Default,,0,0,0,,Шөп мені барлық жерді кесіп тастады.
Dialogue: 0,1:05:09.90,1:05:14.86,Default,,0,0,0,,Енді сіз күнделікті өмірдің қаншалықты ыңғайлы және жайлы екенін білесіз бе?
Dialogue: 0,1:05:15.16,1:05:17.99,Default,,0,0,0,,Мен көптен бері теледидар көрмедім.
Dialogue: 0,1:05:18.24,1:05:19.87,Default,,0,0,0,,Мен де үй тапсырмасын орындауым керек.
Dialogue: 0,1:05:20.12,1:05:23.08,Default,,0,0,0,,Хмм, мен қазір үйге қайтатын шығармын.
Dialogue: 0,1:05:23.33,1:05:24.21,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,1:05:24.71,1:05:27.34,Default,,0,0,0,,Бірақ анам тағы да ұрсады.
Dialogue: 0,1:05:27.63,1:05:31.92,Default,,0,0,0,,Жарайды, уақыт машинасын пайдаланып, үйден шыққаннан кейін кері қайтыңыз.
Dialogue: 0,1:05:32.17,1:05:32.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:05:33.17,1:05:35.01,Default,,0,0,0,,Жаса, сараң зомби
Dialogue: 0,1:05:35.30,1:05:36.55,Default,,0,0,0,,Сараң зомби емес
Dialogue: 0,1:05:36.80,1:05:39.31,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,1:05:42.98,1:05:43.73,Default,,0,0,0,,Иә
Dialogue: 0,1:05:44.10,1:05:48.23,Default,,0,0,0,,Мен жақында ораламын, бірақ олар қайтып келгенде, қазықтарды тамақтандырыңыз.
Dialogue: 0,1:05:48.52,1:05:49.73,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:05:50.32,1:05:54.20,Default,,0,0,0,,Дразомби-сама жоқ болса, мен қайғырамын.
Dialogue: 0,1:05:54.45,1:05:55.40,Default,,0,0,0,,Жарайды
Dialogue: 0,1:05:55.70,1:05:58.70,Default,,0,0,0,,Гига зомбилері мен Кураями тайпасы ешқашан келмейді.
Dialogue: 0,1:05:58.95,1:06:00.91,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,1:06:01.20,1:06:04.08,Default,,0,0,0,,(Хикари тайпасы қолдау көрсету)
Dialogue: 0,1:06:09.84,1:06:12.00,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,1:06:12.25,1:06:17.93,Default,,0,0,0,,Токоями сарайын аяқтау үшін бізге әлі де көбірек құл жинау керек.
Dialogue: 0,1:06:18.22,1:06:22.47,Default,,0,0,0,,Сондықтан мен сені сол маймылдарға қостым.
Dialogue: 0,1:06:22.72,1:06:25.27,Default,,0,0,0,,Мен қорқамын, зомби Гига мырза
Dialogue: 0,1:06:25.52,1:06:28.27,Default,,0,0,0,,Хикари тайпасында күшті одақтас пайда болды.
Dialogue: 0,1:06:28.56,1:06:32.90,Default,,0,0,0,,Ол өзін Ұлы Рух патшасы Дразомби деп атайтын енот ит құбыжығы.
Dialogue: 0,1:06:33.15,1:06:36.90,Default,,0,0,0,,Не? Бұл айдаһар зомби ме?
Dialogue: 0,1:06:37.15,1:06:39.07,Default,,0,0,0,,Ұлы Рух Патшасы туралы не деуге болады?
Dialogue: 0,1:06:39.37,1:06:42.87,Default,,0,0,0,,Оның күші менікінен артық дейсің бе?
Dialogue: 0,1:06:42.99,1:06:45.29,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,1:06:45.58,1:06:48.46,Default,,0,0,0,,Үніңді жап, керексіз адам.
Dialogue: 0,1:06:49.04,1:06:50.92,Default,,0,0,0,,Гига~
Dialogue: 0,1:06:53.92,1:06:57.38,Default,,0,0,0,,Жарайсыз ба? Айдаһар зомбиін табыңыз
Dialogue: 0,1:06:57.63,1:07:00.14,Default,,0,0,0,,Менің алдыма әкел
Dialogue: 0,1:07:00.26,1:07:01.51,Default,,0,0,0,,Га
Dialogue: 0,1:07:03.47,1:07:08.56,Default,,0,0,0,,Мен сені жердің түкпір-түкпіріне дейін аңдып, жыртып тастаймын.
Dialogue: 0,1:07:08.69,1:07:12.94,Default,,0,0,0,,Фухахахахахаха
Dialogue: 0,1:07:18.78,1:07:22.99,Default,,0,0,0,,Ой, менің басым әлі жеңіл.
Dialogue: 0,1:07:23.28,1:07:25.41,Default,,0,0,0,,70 000 жыл реактивті лаг.
Dialogue: 0,1:07:26.08,1:07:27.87,Default,,0,0,0,,Ммм
Dialogue: 0,1:07:29.54,1:07:32.08,Default,,0,0,0,,Не болды? қиын бет жасау
Dialogue: 0,1:07:32.33,1:07:35.34,Default,,0,0,0,,Мынаны қарашы (Нобита) Иә? бұл?
Dialogue: 0,1:07:35.63,1:07:39.80,Default,,0,0,0,,Бұл Цучидаманың білегі. Мен бір кесек әкелдім.
Dialogue: 0,1:07:41.09,1:07:42.18,Default,,0,0,0,,Дат
Dialogue: 0,1:07:42.47,1:07:43.47,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,1:07:43.97,1:07:46.31,Default,,0,0,0,,Енді не істейміз? Кенеттен.
Dialogue: 0,1:07:46.47,1:07:47.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:50.10,1:07:51.15,Default,,0,0,0,,тұрып қалды
Dialogue: 0,1:07:51.69,1:07:54.40,Default,,0,0,0,,Ол мен бұрын көрмеген ингредиенттерден жасалған.
Dialogue: 0,1:07:54.57,1:07:58.15,Default,,0,0,0,,Мен қазір бұл деректерді Дорамиге тергеуге жіберіп жатырмын.
Dialogue: 0,1:07:58.40,1:07:59.95,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,1:08:00.20,1:08:02.07,Default,,0,0,0,,Сәлеметсіз бе? үлкен аға?
Dialogue: 0,1:08:04.74,1:08:09.37,Default,,0,0,0,,Талдау оның пішінді есте сақтаулы керамикадан жасалғаны анықталды.
Dialogue: 0,1:08:09.91,1:08:13.88,Default,,0,0,0,,Әрбір молекула өзінің орналасуын есте сақтайды.
Dialogue: 0,1:08:14.13,1:08:16.34,Default,,0,0,0,,Өзін-өзі емдеу қасиеті бар металдар
Dialogue: 0,1:08:16.92,1:08:19.38,Default,,0,0,0,,Мен әрі қарай зерттеуді жалғастырамын.
Dialogue: 0,1:08:21.43,1:08:23.89,Default,,0,0,0,,Неліктен тас дәуірінде мұндай нәрсе болды?
Dialogue: 0,1:08:24.18,1:08:25.39,Default,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,1:08:25.85,1:08:27.81,Default,,0,0,0,,Мен айта алатын жалғыз нәрсе:
Dialogue: 0,1:08:28.64,1:08:32.98,Default,,0,0,0,,Бұл Гига Зомби жай сиқыршы емес екенін білдіреді.
Dialogue: 0,1:08:36.57,1:08:38.86,Default,,0,0,0,,тым кеш болды.
Dialogue: 0,1:08:43.41,1:08:44.24,Default,,0,0,0,,Cucur
Dialogue: 0,1:08:44.53,1:08:46.78,Default,,0,0,0,,Фухахахахаха
Dialogue: 0,1:08:47.49,1:08:48.91,Default,,0,0,0,,Үлкен көлеңке!
Dialogue: 0,1:08:49.16,1:08:50.75,Default,,0,0,0,,Бұл гига зомби ме?
Dialogue: 0,1:08:51.37,1:08:54.67,Default,,0,0,0,,Сізді көргеніме қуаныштымын, Дразомби.
Dialogue: 0,1:08:54.96,1:08:57.67,Default,,0,0,0,,Мен саған жаңа құл аламын.
Dialogue: 0,1:08:58.05,1:09:00.71,Default,,0,0,0,,Эй, маған Кукуру мен басқаларын қайтар.
Dialogue: 0,1:09:01.13,1:09:05.30,Default,,0,0,0,,Егер сіз оны қайтарғыңыз келсе, Токоями сарайына келіңіз.
Dialogue: 0,1:09:05.55,1:09:09.60,Default,,0,0,0,,Дегенмен, ешқашан үйге оралмауға дайын болыңыз.
Dialogue: 0,1:09:09.89,1:09:12.06,Default,,0,0,0,,Сіз мұндай қорқытуды қабылдайсыз ба?
Dialogue: 0,1:09:12.31,1:09:15.02,Default,,0,0,0,,Фухахахахаха
Dialogue: 0,1:09:15.65,1:09:16.69,Default,,0,0,0,,Бұл пайдасыз.
Dialogue: 0,1:09:16.94,1:09:20.99,Default,,0,0,0,,Бұл хабарды жеткізу үшін елес.
Dialogue: 0,1:09:24.32,1:09:28.45,Default,,0,0,0,,Бұл жерде Цучидамамен соғысып, Хикари тайпасын сақтап қалдық.
Dialogue: 0,1:09:28.78,1:09:31.12,Default,,0,0,0,,Токоями сарайы қандай орын?
Dialogue: 0,1:09:31.33,1:09:33.96,Default,,0,0,0,,Мен Гига Зомбидің қандай қарсылас екенін білмеймін.
Dialogue: 0,1:09:34.67,1:09:38.38,Default,,0,0,0,,Маңызды емес, Кукуру біздің досымыз.
Dialogue: 0,1:09:38.63,1:09:41.38,Default,,0,0,0,,Сіз жан жарыңызды тастап кеттіңіз бе?
Dialogue: 0,1:09:41.63,1:09:43.13,Default,,0,0,0,,Біраз қорқынышты
Dialogue: 0,1:09:44.63,1:09:48.43,Default,,0,0,0,,Олай болса, шексіз материктің қойнауына барайық.
Dialogue: 0,1:09:48.68,1:09:49.89,Default,,0,0,0,,Бұл өкінішті мәңгі бойымен арқалап жүремін.
Dialogue: 0,1:09:51.47,1:09:53.89,Default,,0,0,0,,Жер мәңгілікке жалғасады
Dialogue: 0,1:09:54.06,1:09:56.35,Default,,0,0,0,,Бұл Жапониядан үлкенірек.
Dialogue: 0,1:09:56.73,1:09:58.69,Default,,0,0,0,,Алыста
Dialogue: 0,1:09:58.94,1:10:02.32,Default,,0,0,0,,Гига зомби Кукуру мен басқаларды қалай тапты?
Dialogue: 0,1:10:02.61,1:10:05.49,Default,,0,0,0,,Мен білмеймін. Оның орнына Токоями сарайы...
Dialogue: 0,1:10:05.78,1:10:08.32,Default,,0,0,0,,Сіз оны таба аласыз ба деген сұрақ туындайды.
Dialogue: 0,1:10:08.82,1:10:10.41,Default,,0,0,0,,Бірақ бұл біртүрлі.
Dialogue: 0,1:10:10.66,1:10:11.79,Default,,0,0,0,,Не?
Dialogue: 0,1:10:11.95,1:10:14.54,Default,,0,0,0,,Гига зомбилері соншалықты ұзақ жол жүрді.
Dialogue: 0,1:10:14.75,1:10:17.08,Default,,0,0,0,,Бар-жоғы бір күнде бардыңыз, солай ма?
Dialogue: 0,1:10:17.29,1:10:19.50,Default,,0,0,0,,Не, қорқып тұрсың ба?
Dialogue: 0,1:10:19.79,1:10:23.09,Default,,0,0,0,,Мұны сіз Гига Зомбиімен кездескенде түсінесіз.
Dialogue: 0,1:10:23.34,1:10:25.34,Default,,0,0,0,,Бұл рас.
Dialogue: 0,1:10:27.26,1:10:29.01,Default,,0,0,0,,Қараңдаршы, қар жауып тұр
Dialogue: 0,1:10:29.80,1:10:32.18,Default,,0,0,0,,Кенет салқындап барады.
Dialogue: 0,1:10:32.35,1:10:33.93,Default,,0,0,0,,Мен де (Нобитаның түшкіруі)
Dialogue: 0,1:10:34.48,1:10:38.85,Default,,0,0,0,,Бұл біртүрлі. Кондиционер костюмдері сізді суықтан қорғауы керек.
Dialogue: 0,1:10:39.15,1:10:42.61,Default,,0,0,0,,Таңқаларлық емес, қазіргі температура -50 градус.
Dialogue: 0,1:10:42.82,1:10:43.36,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:43.57,1:10:46.32,Default,,0,0,0,,Тіпті кондиционердің костюмі де мұның бәрін жаба алмайды.
Dialogue: 0,1:10:47.45,1:10:48.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:48.86,1:10:51.16,Default,,0,0,0,,Баспропеллер-де бірдеңе дұрыс емес.
Dialogue: 0,1:10:51.41,1:10:52.83,Default,,0,0,0,,үшін төменге түседі
Dialogue: 0,1:10:53.08,1:10:54.25,Default,,0,0,0,,Тағы да?
Dialogue: 0,1:10:54.70,1:10:58.37,Default,,0,0,0,,Жоқ, ол үздіксіз жұмыс істеуге байланысты қызып кетті.
Dialogue: 0,1:10:58.62,1:11:00.71,Default,,0,0,0,,Сізде қозғалатын басқа құралдар жоқ па?
Dialogue: 0,1:11:01.09,1:11:02.71,Default,,0,0,0,,Кейбіреулер бар, бірақ
Dialogue: 0,1:11:02.96,1:11:06.38,Default,,0,0,0,,Оны тегіс емес жерде пайдалану қауіпті.
Dialogue: 0,1:11:07.68,1:11:10.09,Default,,0,0,0,,Өзіңді сызықты моторлы көлік ретінде көрсет!
Dialogue: 0,1:11:10.59,1:11:13.35,Default,,0,0,0,,Жарайды, өйткені ешкім қарап тұрмайды.
Dialogue: 0,1:11:13.60,1:11:15.81,Default,,0,0,0,,Осы жасымда мен тіпті пойыз ойнай да алмаймын.
Dialogue: 0,1:11:16.06,1:11:19.56,Default,,0,0,0,,ренжімеңіз Кетудің барысы
Dialogue: 0,1:11:20.06,1:11:21.52,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:11:21.90,1:11:24.11,Default,,0,0,0,,Асығыңыз
Dialogue: 0,1:11:24.48,1:11:26.99,Default,,0,0,0,,Менің басым айналады ~ Мен дем ала алмаймын
Dialogue: 0,1:11:27.24,1:11:28.40,Default,,0,0,0,,Тоқта, тоқта, тоқта
Dialogue: 0,1:11:28.65,1:11:30.70,Default,,0,0,0,,Дәл қазір 400км/сағ~
Dialogue: 0,1:11:30.95,1:11:31.78,Default,,0,0,0,,Уау
Dialogue: 0,1:11:38.83,1:11:39.58,Default,,0,0,0,,Уау
Dialogue: 0,1:11:44.75,1:11:45.84,Default,,0,0,0,,Уау
Dialogue: 0,1:11:49.13,1:11:52.97,Default,,0,0,0,,Сәлем роликтер
Dialogue: 0,1:11:56.89,1:11:59.98,Default,,0,0,0,,Жоқ, мен алға жылжи алмаймын.
Dialogue: 0,1:12:00.60,1:12:02.65,Default,,0,0,0,,Эй, үңгір бар.
Dialogue: 0,1:12:02.90,1:12:05.82,Default,,0,0,0,,Аспан жәрдемі, сонда пана ал
Dialogue: 0,1:12:06.11,1:12:08.40,Default,,0,0,0,,Бұл пайдалы болды.
Dialogue: 0,1:12:08.65,1:12:11.82,Default,,0,0,0,,Тоңып өле жаздадым.
Dialogue: 0,1:12:12.07,1:12:15.20,Default,,0,0,0,,үшінның қауіпсіз болғанына қуаныштымын. үшін...
Dialogue: 0,1:12:15.49,1:12:16.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:16.49,1:12:17.41,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:17.58,1:12:19.29,Default,,0,0,0,,Нобита-кун жоқ!
Dialogue: 0,1:12:20.04,1:12:21.33,Default,,0,0,0,,Бұл ыңғайсыз
Dialogue: 0,1:12:21.58,1:12:23.92,Default,,0,0,0,,Мен жолда құлап қалдым.
Dialogue: 0,1:12:24.17,1:12:26.17,Default,,0,0,0,,Мен саған көмектесемін.
Dialogue: 0,1:12:26.42,1:12:28.55,Default,,0,0,0,,Не? Тоқта
Dialogue: 0,1:12:28.80,1:12:30.67,Default,,0,0,0,,Тіпті Джиан қиыншылыққа ұшырайды.
Dialogue: 0,1:12:30.97,1:12:34.85,Default,,0,0,0,,Өйткені! Егер мен оны жалғыз қалдырсам, ол өледі, солай ма?
Dialogue: 0,1:12:35.60,1:12:37.93,Default,,0,0,0,,Бұндай қарлы боранда мені табу мүмкін емес.
Dialogue: 0,1:12:38.18,1:12:39.35,Default,,0,0,0,,Жоспар
Dialogue: 0,1:12:40.81,1:12:42.73,Default,,0,0,0,,Құтқарушы бөтелке!
Dialogue: 0,1:12:42.98,1:12:45.98,Default,,0,0,0,,Оның құрамында емдік энергетикалық сусын бар.
Dialogue: 0,1:12:46.27,1:12:49.40,Default,,0,0,0,,Қиындыққа ұшыраған адамдарды іздеп, құтқарады.
Dialogue: 0,1:12:49.69,1:12:52.74,Default,,0,0,0,,Бірақ Нобита-санды қалай табамыз?
Dialogue: 0,1:12:52.99,1:12:55.37,Default,,0,0,0,,Иісі бар нәрсе...
Dialogue: 0,1:12:55.62,1:12:57.41,Default,,0,0,0,,Ой, бұл жақсы
Dialogue: 0,1:12:57.99,1:13:00.08,Default,,0,0,0,,0 ұпай жауап!
Dialogue: 0,1:13:00.33,1:13:03.54,Default,,0,0,0,,Амансың ба? Мен жиенімді осыншама іздеп жүрмін.
Dialogue: 0,1:13:03.92,1:13:05.13,Default,,0,0,0,,Анан
Dialogue: 0,1:13:06.46,1:13:08.30,Default,,0,0,0,,Мен сізден бар күшіңізді салуыңызды өтіндім.
Dialogue: 0,1:13:08.55,1:13:10.67,Default,,0,0,0,,Кеш болмай тұрғанда мені тауып ал
Dialogue: 0,1:13:17.35,1:13:21.56,Default,,0,0,0,,үшінна Дораемон!
Dialogue: 0,1:13:22.06,1:13:25.94,Default,,0,0,0,,Бұл қорқынышты, мені жалғыз қалдырды.
Dialogue: 0,1:13:26.19,1:13:27.56,Default,,0,0,0,,Уф уау
Dialogue: 0,1:13:31.03,1:13:32.86,Default,,0,0,0,,Тоңып өлу
Dialogue: 0,1:13:33.11,1:13:34.07,Default,,0,0,0,,Ах
Dialogue: 0,1:13:34.66,1:13:36.53,Default,,0,0,0,,Ух~ Самусаму
Dialogue: 0,1:13:36.78,1:13:41.50,Default,,0,0,0,,Әке, әй, бұл пеш, мен де қосайын.
Dialogue: 0,1:13:41.75,1:13:47.25,Default,,0,0,0,,Нобита Сіз ешкімнен қарыз алмайсыз, солай ма?
Dialogue: 0,1:13:47.88,1:13:48.75,Default,,0,0,0,,Га
Dialogue: 0,1:13:51.00,1:13:52.38,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,1:13:54.26,1:13:55.76,Default,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,1:13:56.05,1:13:56.93,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,1:13:57.89,1:14:00.68,Default,,0,0,0,,Маған рамен берші, мен сорпа ішейін.
Dialogue: 0,1:14:01.68,1:14:04.02,Default,,0,0,0,,Сіз жалғыз тұруыңыз керек емес пе?
Dialogue: 0,1:14:04.31,1:14:05.06,Default,,0,0,0,,Га
Dialogue: 0,1:14:07.02,1:14:08.36,Default,,0,0,0,,Бұл...
Dialogue: 0,1:14:10.07,1:14:11.28,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:14:12.36,1:14:15.74,Default,,0,0,0,,О, солай.
Dialogue: 0,1:14:16.78,1:14:18.28,Default,,0,0,0,,Артық емес
Dialogue: 0,1:14:20.03,1:14:21.70,Default,,0,0,0,,Мен бір қадам да қозғала алмаймын.
Dialogue: 0,1:14:26.92,1:14:29.96,Default,,0,0,0,,Әй, мен кетейін деп едім.
Dialogue: 0,1:14:30.25,1:14:33.63,Default,,0,0,0,,Үйден қашқанда солай болады.
Dialogue: 0,1:14:33.92,1:14:37.63,Default,,0,0,0,,Тыныш болып, мұғалім мен анаңның айтқанын тыңдасаңшы.
Dialogue: 0,1:14:37.89,1:14:40.64,Default,,0,0,0,,Мен қазір жылы футонда болсам да.
Dialogue: 0,1:14:41.26,1:14:46.64,Default,,0,0,0,,Жоқ, мен оны сынап көргім келді.
Dialogue: 0,1:14:46.94,1:14:49.35,Default,,0,0,0,,Хмф, бұл босқа.
Dialogue: 0,1:14:49.61,1:14:53.03,Default,,0,0,0,,Соңында жалғыз ештеңе істей алмайсың.
Dialogue: 0,1:14:53.28,1:14:56.82,Default,,0,0,0,,Одан гөрі неге тезірек ұйықтамайсың?
Dialogue: 0,1:14:57.95,1:15:02.20,Default,,0,0,0,,Мен Кукукуруға көмектесуім керек.
Dialogue: 0,1:15:04.24,1:15:08.04,Default,,0,0,0,,Иә, онда қалағаныңды істе.
Dialogue: 0,1:15:09.58,1:15:13.13,Default,,0,0,0,,Кукуру Кукуру...
Dialogue: 0,1:15:13.38,1:15:15.01,Default,,0,0,0,,Энн Энн
Dialogue: 0,1:15:20.80,1:15:24.01,Default,,0,0,0,,Бұл не? Күдікті
Dialogue: 0,1:15:24.39,1:15:26.06,Default,,0,0,0,,Гига
Dialogue: 0,1:15:29.81,1:15:31.61,Default,,0,0,0,,​​Хмм.
Dialogue: 0,1:15:32.48,1:15:33.90,Default,,0,0,0,,Хмм...
Dialogue: 0,1:15:34.98,1:15:37.03,Default,,0,0,0,,Уф...
Dialogue: 0,1:15:37.69,1:15:39.53,Default,,0,0,0,,Тітіркенуден пайда жоқ
Dialogue: 0,1:15:39.78,1:15:42.03,Default,,0,0,0,,Сіз тек бөтелкеге сеніп, күте аласыз.
Dialogue: 0,1:15:43.08,1:15:45.99,Default,,0,0,0,,Мен шыдамдылықпен күте алмаймын.
Dialogue: 0,1:15:46.87,1:15:49.37,Default,,0,0,0,,Тым тереңге түссең, адасып кетесің.
Dialogue: 0,1:15:49.67,1:15:53.75,Default,,0,0,0,,Сондықтан мен Нобитаны жек көремін
Dialogue: 0,1:15:53.88,1:15:55.67,Default,,0,0,0,,Сунео Сунео
Dialogue: 0,1:15:55.84,1:15:59.59,Default,,0,0,0,,Аа, жер астына апаратын баспалдақтар бар.
Dialogue: 0,1:16:00.51,1:16:01.89,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:16:02.14,1:16:03.85,Default,,0,0,0,,…мойынының артына дәл осы пішіндегі дақ шыққан.
Dialogue: 0,1:16:04.26,1:16:06.68,Default,,0,0,0,,Жарайсың, осы уақытқа дейін жеттің.
Dialogue: 0,1:16:06.97,1:16:10.23,Default,,0,0,0,,Жау болсам да, Мақтаймын шын жүректен.
Dialogue: 0,1:16:31.08,1:16:32.75,Default,,0,0,0,,(иттің ысқырығы)
Dialogue: 0,1:16:33.71,1:16:35.17,Default,,0,0,0,,(иттің ысқырығы)
Dialogue: 0,1:16:38.71,1:16:41.17,Default,,0,0,0,,(иттің ысқырығы)
Dialogue: 0,1:16:41.72,1:16:44.05,Default,,0,0,0,,(ит ысқырығы)
Dialogue: 0,1:16:47.06,1:16:47.93,Default,,0,0,0,,Уф...
Dialogue: 0,1:17:16.88,1:17:19.46,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,1:17:19.76,1:17:21.84,Default,,0,0,0,,Ол жерді жарып өтуі мүмкін
Dialogue: 0,1:17:23.05,1:17:25.26,Default,,0,0,0,,Күте тұрыңыз, ішінде жарық бар.
Dialogue: 0,1:17:25.51,1:17:26.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:26.76,1:17:29.39,Default,,0,0,0,,Бұл не? кеттік
Dialogue: 0,1:17:29.77,1:17:30.81,Default,,0,0,0,,Ах
Dialogue: 0,1:17:40.19,1:17:43.07,Default,,0,0,0,,Қаншама хикари халқы құл болды
Dialogue: 0,1:17:43.32,1:17:45.99,Default,,0,0,0,,Бұл Токоямидің сарайы ғой.
Dialogue: 0,1:17:46.28,1:17:48.78,Default,,0,0,0,,Қараңдаршы, анау жерде қоңыз бар.
Dialogue: 0,1:17:49.45,1:17:50.37,Default,,0,0,0,,Уау
Dialogue: 0,1:17:50.91,1:17:53.58,Default,,0,0,0,,Уау Уау
Dialogue: 0,1:17:53.87,1:17:56.08,Default,,0,0,0,,Хахахаха уф
Dialogue: 0,1:17:56.29,1:18:00.80,Default,,0,0,0,,Бұл бейбақ, мен құлдықтан басқа ештеңеге шыдамаймын.
Dialogue: 0,1:18:01.05,1:18:03.76,Default,,0,0,0,,Ультра секундомер!
Dialogue: 0,1:18:04.01,1:18:04.68,Default,,0,0,0,,Уау
Dialogue: 0,1:18:07.97,1:18:10.22,Default,,0,0,0,,Иә? Бәрі қатып қалғандай
Dialogue: 0,1:18:10.47,1:18:11.72,Default,,0,0,0,,Ол қозғалуды тоқтатты.
Dialogue: 0,1:18:12.14,1:18:13.85,Default,,0,0,0,,Бұл уақыт құлпы.
Dialogue: 0,1:18:14.23,1:18:17.19,Default,,0,0,0,,Біз өзімізден басқаның бәріне уақыт ағынын тоқтаттық.
Dialogue: 0,1:18:17.73,1:18:23.28,Default,,0,0,0,,Сізді тоқтаған уақыт ағымынан шығару үшін оған аздап қол тигізсеңіз болғаны.
Dialogue: 0,1:18:23.94,1:18:26.66,Default,,0,0,0,,Иә? Уау, солай!
Dialogue: 0,1:18:27.32,1:18:29.53,Default,,0,0,0,,Біз барлығына тез көмектесуіміз керек.
Dialogue: 0,1:18:29.78,1:18:32.04,Default,,0,0,0,,Көп адам бірден қашып кетсін.
Dialogue: 0,1:18:32.29,1:18:34.16,Default,,0,0,0,,Біз қашу жолын қамтамасыз етуіміз керек.
Dialogue: 0,1:18:34.91,1:18:38.13,Default,,0,0,0,,Таныс өтетін шеңбер!
Dialogue: 0,1:18:38.71,1:18:41.04,Default,,0,0,0,,Енді сіз бірден жерге түсе аласыз.
Dialogue: 0,1:18:41.29,1:18:42.59,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,1:18:43.84,1:18:46.55,Default,,0,0,0,,Мен жер бетіне жете алатынымды тексеремін.
Dialogue: 0,1:18:46.80,1:18:47.84,Default,,0,0,0,,Қашпа! Тікелей айтшы!
Dialogue: 0,1:18:48.09,1:18:49.55,Default,,0,0,0,,Мен оны сұрадым, Дора-чан.
Dialogue: 0,1:18:50.14,1:18:51.35,Default,,0,0,0,,Уф...
Dialogue: 0,1:18:54.02,1:18:55.31,Default,,0,0,0,,Күлкілі
Dialogue: 0,1:18:55.56,1:18:58.44,Default,,0,0,0,,Бұлай бұрмаланған болуы мүмкін емес.
Dialogue: 0,1:18:59.77,1:19:02.44,Default,,0,0,0,,О? Е, бұл өтірік!
Dialogue: 0,1:19:02.86,1:19:04.86,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,1:19:07.20,1:19:09.41,Default,,0,0,0,,Сіз бұл жерге қалай келдіңіз?
Dialogue: 0,1:19:10.24,1:19:14.33,Default,,0,0,0,,Тас дәуірінде жер астында осындай машина болған.
Dialogue: 0,1:19:14.83,1:19:17.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:17.75,1:19:22.75,Default,,0,0,0,,Әй, уақыт ағымы тоқтап қалса да, ақымақсың.
Dialogue: 0,1:19:25.84,1:19:27.09,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:29.47,1:19:30.72,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:37.39,1:19:40.15,Default,,0,0,0,,Қош келдіңіз Дразомби-кун
Dialogue: 0,1:19:40.94,1:19:44.11,Default,,0,0,0,,Бұл бөлме ешкім кірмейтін қасиетті жер.
Dialogue: 0,1:19:44.36,1:19:48.07,Default,,0,0,0,,Ерлігің үшін саған құрмет көрсеттім.
Dialogue: 0,1:19:48.32,1:19:52.03,Default,,0,0,0,,Қалай қозғалуға болады? Уақыт тоқтап қалса да
Dialogue: 0,1:19:52.28,1:19:55.54,Default,,0,0,0,,Мен уақыт құлпын бұздым.
Dialogue: 0,1:19:55.95,1:19:57.37,Default,,0,0,0,,Шығарылды ма?
Dialogue: 0,1:19:57.62,1:19:59.46,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,1:20:00.67,1:20:02.46,Default,,0,0,0,,Сіз болашақтансыз ба?
Dialogue: 0,1:20:03.17,1:20:06.92,Default,,0,0,0,,Ол тарихты қайта жазуға тырысатын кеңістік-уақыт қылмыскері.
Dialogue: 0,1:20:07.17,1:20:10.38,Default,,0,0,0,,Нухахахаха, мен оны көрдім.
Dialogue: 0,1:20:10.63,1:20:13.43,Default,,0,0,0,,Бірақ мен оны қылмыскер деп ойламаймын.
Dialogue: 0,1:20:14.10,1:20:18.31,Default,,0,0,0,,Мен тарих құдайымын.
Dialogue: 0,1:20:18.60,1:20:21.31,Default,,0,0,0,,Надан примитивтерді бағындырыңыз -
Dialogue: 0,1:20:21.56,1:20:24.77,Default,,0,0,0,,Шіріген болашақты өшіруге келдім.
Dialogue: 0,1:20:25.02,1:20:26.48,Default,,0,0,0,,Мұндай өзімшіл нәрсе
Dialogue: 0,1:20:26.78,1:20:28.99,Default,,0,0,0,,Time Patrol оны лақтырмайды.
Dialogue: 0,1:20:29.24,1:20:33.78,Default,,0,0,0,,Сондықтан біз жердің тереңіне құпия негіз салдық.
Dialogue: 0,1:20:34.07,1:20:37.99,Default,,0,0,0,,Ақымақ патруль білмеуі үшін.
Dialogue: 0,1:20:38.41,1:20:41.71,Default,,0,0,0,,Қосалқы кеңістікті жою құрылғысын қараңыз.
Dialogue: 0,1:20:52.22,1:20:54.09,Default,,0,0,0,,Осы құрылғыны пайдалансаңыз—
Dialogue: 0,1:20:54.34,1:20:57.85,Default,,0,0,0,,Сіз кеңістік-уақыт турбуленттігін еркін жасай аласыз.
Dialogue: 0,1:20:58.14,1:20:59.43,Default,,0,0,0,,Кеңістік-уақыт турбуленттігі?
Dialogue: 0,1:20:59.68,1:21:02.81,Default,,0,0,0,,Дұрыс, Кукуру екеуміз де қатыстық.
Dialogue: 0,1:21:03.06,1:21:04.77,Default,,0,0,0,,Бұл сіздің әрекетіңіз болды ма?
Dialogue: 0,1:21:05.02,1:21:07.11,Default,,0,0,0,,Бұл құрметсіздік
Dialogue: 0,1:21:07.40,1:21:09.78,Default,,0,0,0,,Мен жаңа ғана сынақ жасадым.
Dialogue: 0,1:21:10.24,1:21:13.20,Default,,0,0,0,,Егер сіз плазмалық шарды кеңістік-уақыт турбуленттілігіне түсірсеңіз —
Dialogue: 0,1:21:13.49,1:21:16.78,Default,,0,0,0,,Уақыт туннелі бөлшектеп жойылуы мүмкін.
Dialogue: 0,1:21:17.16,1:21:20.37,Default,,0,0,0,,Бұл дәуірге ешкімнің кіруіне рұқсат етілмейді.
Dialogue: 0,1:21:20.66,1:21:24.08,Default,,0,0,0,,Мәңгілік әулеттің билеушісі боламын.
Dialogue: 0,1:21:24.33,1:21:27.88,Default,,0,0,0,,Сіз сияқты біреудің әлем патшасы болғанын қалайсыз ба?
Dialogue: 0,1:21:28.17,1:21:31.80,Default,,0,0,0,,Ал, сіз бұл туралы не істейсіз?
Dialogue: 0,1:21:32.05,1:21:33.68,Default,,0,0,0,,Дразомби-кун
Dialogue: 0,1:21:34.09,1:21:38.05,Default,,0,0,0,,Мен сені ұстап алып, Уақыт патрульіне тапсырамын!
Dialogue: 0,1:21:38.35,1:21:41.68,Default,,0,0,0,,Жарайды, көріңіз.
Dialogue: 0,1:21:43.18,1:21:45.23,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:45.52,1:21:46.56,Default,,0,0,0,,Ол… ол тұрып кетті!
Dialogue: 0,1:21:46.86,1:21:49.69,Default,,0,0,0,,Егер сен берілсең, мен сені қызметші ете аламын.
Dialogue: 0,1:21:50.32,1:21:52.19,Default,,0,0,0,,Сізді кім ойлайды?
Dialogue: 0,1:21:52.44,1:21:54.95,Default,,0,0,0,,Толық қуат taa
Dialogue: 0,1:21:55.07,1:21:56.70,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:21:56.99,1:21:58.24,Default,,0,0,0,,Тааа!
Dialogue: 0,1:21:59.66,1:22:00.62,Default,,0,0,0,,Хааа
Dialogue: 0,1:22:09.42,1:22:11.05,Default,,0,0,0,,...
Dialogue: 0,1:22:12.01,1:22:14.38,Default,,0,0,0,,Гуу
Dialogue: 0,1:22:14.80,1:22:16.51,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,1:22:16.72,1:22:20.60,Default,,0,0,0,,22 ғасыр құралдары жұмыс істемейді
Dialogue: 0,1:22:21.39,1:22:22.27,Default,,0,0,0,,Иә
Dialogue: 0,1:22:22.56,1:22:25.10,Default,,0,0,0,,Гига
Dialogue: 0,1:22:30.48,1:22:32.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:32.73,1:22:35.95,Default,,0,0,0,,22 ғасыр құралдары қазба қалдықтарынан басқа ештеңе емес
Dialogue: 0,1:22:36.24,1:22:39.41,Default,,0,0,0,,Мен 23 ғасырданмын.
Dialogue: 0,1:22:39.66,1:22:40.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:41.33,1:22:44.29,Default,,0,0,0,,Ғасырдан айырылғанымыз өкінішті?
Dialogue: 0,1:22:49.79,1:22:52.38,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,1:22:52.84,1:22:55.05,Default,,0,0,0,,Пегагри
Dialogue: 0,1:22:56.22,1:22:57.13,Default,,0,0,0,,Драко
Dialogue: 0,1:22:57.55,1:23:01.10,Default,,0,0,0,,Ахахха, менің ойымша, бәрі қауіпсіз болды.
Dialogue: 0,1:23:01.51,1:23:03.52,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін деп ойладым.
Dialogue: 0,1:23:04.31,1:23:05.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:06.10,1:23:08.81,Default,,0,0,0,,Иә, мен қарға құладым.
Dialogue: 0,1:23:09.06,1:23:09.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:11.40,1:23:14.90,Default,,0,0,0,,Мүмкін маған бәрі көмектескен шығар?
Dialogue: 0,1:23:15.15,1:23:16.99,Default,,0,0,0,,(3 жылау)
Dialogue: 0,1:23:18.36,1:23:22.74,Default,,0,0,0,,Ахаха рахмет барлығыңызға рахмет
Dialogue: 0,1:23:24.87,1:23:27.33,Default,,0,0,0,,Доремондар қайда?
Dialogue: 0,1:23:27.62,1:23:30.29,Default,,0,0,0,,Токоями сарайын таптыңыз ба?
Dialogue: 0,1:23:30.63,1:23:31.96,Default,,0,0,0,,Гваа?
Dialogue: 0,1:23:32.38,1:23:35.30,Default,,0,0,0,,Иә? Гри, бірдеңе таптың ба?
Dialogue: 0,1:23:36.59,1:23:37.67,Default,,0,0,0,,Грул
Dialogue: 0,1:23:37.92,1:23:40.68,Default,,0,0,0,,Бұл... менің жауап парағым
Dialogue: 0,1:23:41.26,1:23:45.06,Default,,0,0,0,,Бұл Дораемонның осында екенін білдіреді.
Dialogue: 0,1:23:45.43,1:23:49.02,Default,,0,0,0,,Айай Отитао Айай Отитао
Dialogue: 0,1:23:49.31,1:23:53.02,Default,,0,0,0,,Айай Отитао Айай Отитао
Dialogue: 0,1:23:53.65,1:23:55.98,Default,,0,0,0,,Гига
Dialogue: 0,1:23:56.28,1:23:59.03,Default,,0,0,0,,Мен тіпті Дора-чан жеңіледі деп ешқашан ойламадым.
Dialogue: 0,1:23:59.32,1:24:00.36,Default,,0,0,0,,Масқара
Dialogue: 0,1:24:00.53,1:24:03.03,Default,,0,0,0,,Критикалық уақытта бұл пайдасыз.
Dialogue: 0,1:24:03.32,1:24:04.87,Default,,0,0,0,,Сондықтан сіз кешірім сұрайсыз, солай ма?
Dialogue: 0,1:24:05.12,1:24:07.04,Default,,0,0,0,,(қоршау ашылған дыбыс)
Dialogue: 0,1:24:11.50,1:24:12.38,Default,,0,0,0,,Гао!
Dialogue: 0,1:24:12.63,1:24:13.59,Default,,0,0,0,,Уау
Dialogue: 0,1:24:13.88,1:24:16.13,Default,,0,0,0,,Қылшын тісті жолбарыс?
Dialogue: 0,1:24:16.59,1:24:17.71,Default,,0,0,0,,Сіз оны жей аласыз ба?
Dialogue: 0,1:24:17.96,1:24:19.38,Default,,0,0,0,,Бірдеңе істе, Дораемон
Dialogue: 0,1:24:19.63,1:24:21.30,Default,,0,0,0,,Бұл мүмкін емес (Сунео) Мама~
Dialogue: 0,1:24:21.55,1:24:25.01,Default,,0,0,0,,Фухахахаха Бекер күресуді доғар.
Dialogue: 0,1:24:25.26,1:24:29.64,Default,,0,0,0,,Қараңғылық рухына құрбан боласың.
Dialogue: 0,1:24:30.98,1:24:31.81,Default,,0,0,0,,Гао!
Dialogue: 0,1:24:32.48,1:24:34.40,Default,,0,0,0,,Джанды дәмді тағамға арналған Джиан жегені үшін
Dialogue: 0,1:24:34.69,1:24:35.61,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,1:24:36.98,1:24:38.11,Default,,0,0,0,,Артық емес
Dialogue: 0,1:24:38.36,1:24:40.20,Default,,0,0,0,,Соңына дейін берілме
Dialogue: 0,1:24:40.45,1:24:42.41,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:44.53,1:24:45.74,Default,,0,0,0,,(Әскерлердің үрейлі дауыстары)
Dialogue: 0,1:24:47.04,1:24:48.08,Default,,0,0,0,,Не?
Dialogue: 0,1:24:50.87,1:24:52.29,Default,,0,0,0,,Уау
Dialogue: 0,1:24:52.54,1:24:53.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:56.25,1:24:57.34,Default,,0,0,0,,Яғни
Dialogue: 0,1:24:58.55,1:24:59.84,Default,,0,0,0,,Жер
Dialogue: 0,1:25:00.47,1:25:02.30,Default,,0,0,0,,Хихи~н
Dialogue: 0,1:25:04.39,1:25:05.76,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:25:06.39,1:25:08.43,Default,,0,0,0,,үшін көмекке келді.
Dialogue: 0,1:25:08.68,1:25:10.10,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,1:25:10.39,1:25:12.10,Default,,0,0,0,,Сен жақсысың деп үміттенемін.
Dialogue: 0,1:25:12.35,1:25:15.06,Default,,0,0,0,,Нуу, сенің әлі де достарың болды ма?
Dialogue: 0,1:25:15.31,1:25:15.94,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,1:25:16.15,1:25:17.52,Default,,0,0,0,,(ит ысқырығы)
Dialogue: 0,1:25:17.77,1:25:20.44,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:20.74,1:25:22.45,Default,,0,0,0,,Дразомби-саманы сақтаңыз
Dialogue: 0,1:25:22.70,1:25:24.32,Default,,0,0,0,,Гига зомбиін жеңіңіз!
Dialogue: 0,1:25:27.12,1:25:28.87,Default,,0,0,0,,Мен мұны білмей тұрып
Dialogue: 0,1:25:29.33,1:25:32.33,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:25:36.54,1:25:37.88,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:25:39.50,1:25:40.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:40.59,1:25:41.76,Default,,0,0,0,,Хехе
Dialogue: 0,1:25:43.30,1:25:44.13,Default,,0,0,0,,Cucur
Dialogue: 0,1:25:44.43,1:25:45.64,Default,,0,0,0,,Ei
Dialogue: 0,1:25:45.89,1:25:46.85,Default,,0,0,0,,Жоқққ!
Dialogue: 0,1:25:48.10,1:25:49.64,Default,,0,0,0,,Жер бетінде қалай?
Dialogue: 0,1:25:49.93,1:25:51.85,Default,,0,0,0,,Нобита маған көмектесті
Dialogue: 0,1:25:52.39,1:25:54.60,Default,,0,0,0,,Нобита сондай тәкаппар
Dialogue: 0,1:25:56.69,1:25:57.65,Default,,0,0,0,,Гао!
Dialogue: 0,1:25:58.94,1:26:00.44,Default,,0,0,0,,Гун
Dialogue: 0,1:26:04.78,1:26:05.99,Default,,0,0,0,,Уау!
Dialogue: 0,1:26:09.53,1:26:11.04,Default,,0,0,0,,Хихи~н
Dialogue: 0,1:26:11.41,1:26:12.91,Default,,0,0,0,,Өтінемін, Пега.
Dialogue: 0,1:26:13.20,1:26:14.04,Default,,0,0,0,,Бұл...!
Dialogue: 0,1:26:14.29,1:26:15.50,Default,,0,0,0,,Иә
Dialogue: 0,1:26:17.13,1:26:18.88,Default,,0,0,0,,Үйкелемеңіз
Dialogue: 0,1:26:19.46,1:26:20.80,Default,,0,0,0,,Хэхе~да
Dialogue: 0,1:26:21.05,1:26:23.30,Default,,0,0,0,,Цучидамаға барыңыз
Dialogue: 0,1:26:23.76,1:26:25.01,Default,,0,0,0,,Не? Уау~
Dialogue: 0,1:26:25.43,1:26:27.18,Default,,0,0,0,,Маған көмектесіңіз~
Dialogue: 0,1:26:27.43,1:26:29.93,Default,,0,0,0,,Қанша қиратса да, пайдасы жоқ.
Dialogue: 0,1:26:30.51,1:26:32.39,Default,,0,0,0,,Лезде жабысатын пистолет!
Dialogue: 0,1:26:32.93,1:26:36.06,Default,,0,0,0,,үшін, Цучидаманы осымен мақсат етіңдер.
Dialogue: 0,1:26:37.31,1:26:38.65,Default,,0,0,0,,Гига~
Dialogue: 0,1:26:39.69,1:26:40.94,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,1:26:42.65,1:26:43.86,Default,,0,0,0,,Гига~
Dialogue: 0,1:26:44.15,1:26:45.53,Default,,0,0,0,,Гига~
Dialogue: 0,1:26:45.82,1:26:47.99,Default,,0,0,0,,Ия, мен жасадым.
Dialogue: 0,1:26:48.32,1:26:50.66,Default,,0,0,0,,Көмегіңе рахмет (барлығы күледі)
Dialogue: 0,1:26:51.41,1:26:53.54,Default,,0,0,0,,Ах, Гига Зомби қашып кетті.
Dialogue: 0,1:26:53.79,1:26:57.21,Default,,0,0,0,,Гига зомбиін қуу үшін оны маған және Сунеоға қалдырыңыз.
Dialogue: 0,1:26:57.50,1:26:58.29,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:26:59.17,1:27:01.71,Default,,0,0,0,,Барайық Нобита-кун (Нобита) Иә.
Dialogue: 0,1:27:01.92,1:27:02.75,Default,,0,0,0,,Цк
Dialogue: 0,1:27:03.42,1:27:04.76,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:27:05.22,1:27:09.05,Default,,0,0,0,,Оряоря~ (Сунео) Бағыну~
Dialogue: 0,1:27:10.47,1:27:14.06,Default,,0,0,0,,Ха, сен табанды бейбақ.
Dialogue: 0,1:27:14.47,1:27:15.43,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:27:20.52,1:27:22.27,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін
Dialogue: 0,1:27:22.86,1:27:24.98,Default,,0,0,0,,Диаграммаға түспеңіз
Dialogue: 0,1:27:36.62,1:27:38.00,Default,,0,0,0,,Паон
Dialogue: 0,1:27:38.25,1:27:40.38,Default,,0,0,0,,Мамонт? Бұл робот
Dialogue: 0,1:27:41.83,1:27:42.84,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:27:48.55,1:27:49.26,Default,,0,0,0,,Ах
Dialogue: 0,1:27:49.55,1:27:50.51,Default,,0,0,0,,Уау!
Dialogue: 0,1:27:51.22,1:27:55.52,Default,,0,0,0,,Егер бұл орын алса, мен ішкі кеңістікті жою құрылғысын іске қосамын.
Dialogue: 0,1:28:14.62,1:28:15.83,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,1:28:16.08,1:28:17.37,Default,,0,0,0,,Нобита (Нобита) иә?
Dialogue: 0,1:28:19.87,1:28:21.12,Default,,0,0,0,,Хихи~н
Dialogue: 0,1:28:21.71,1:28:22.71,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:28:26.75,1:28:30.13,Default,,0,0,0,,Ол пішінді есте сақтайтын керамикадан жасалған.
Dialogue: 0,1:28:30.38,1:28:31.59,Default,,0,0,0,,Желім пистолет туралы не деуге болады?
Dialogue: 0,1:28:31.84,1:28:34.30,Default,,0,0,0,,Қозғалысты бөгеу үшін тым үлкен
Dialogue: 0,1:28:34.60,1:28:37.85,Default,,0,0,0,,Мамонтпен күрескенде, оны балшыққа айдаңыз.
Dialogue: 0,1:28:38.10,1:28:41.10,Default,,0,0,0,,лай... А!
Dialogue: 0,1:28:41.60,1:28:42.44,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:28:42.85,1:28:44.94,Default,,0,0,0,,Дораэмон Міне, солай! Міне бітті!
Dialogue: 0,1:28:45.61,1:28:46.98,Default,,0,0,0,,Бұл домбыра ұнтағы.
Dialogue: 0,1:28:47.11,1:28:49.82,Default,,0,0,0,,Сізде бұл қол болды ма? (Паон)
Dialogue: 0,1:28:50.07,1:28:52.82,Default,,0,0,0,,Уф уау уау уау
Dialogue: 0,1:28:53.32,1:28:54.82,Default,,0,0,0,,Хихи~н
Dialogue: 0,1:28:58.12,1:28:58.79,Default,,0,0,0,,Cucur
Dialogue: 0,1:29:00.16,1:29:02.17,Default,,0,0,0,,Мамонттың мазмұнын себіңіз
Dialogue: 0,1:29:02.54,1:29:04.04,Default,,0,0,0,,Шизука-чан да
Dialogue: 0,1:29:04.29,1:29:05.13,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:29:08.30,1:29:09.46,Default,,0,0,0,,Уууу
Dialogue: 0,1:29:11.26,1:29:12.47,Default,,0,0,0,,Міне.
Dialogue: 0,1:29:21.98,1:29:23.90,Default,,0,0,0,,Паон
Dialogue: 0,1:29:38.58,1:29:41.29,Default,,0,0,0,,Жоқ, кіре беріс өте тар.
Dialogue: 0,1:29:41.54,1:29:44.42,Default,,0,0,0,,Пега мен Гури осында күте тұрсын, өзіміз барайық.
Dialogue: 0,1:29:44.67,1:29:45.58,Default,,0,0,0,,Иә
Dialogue: 0,1:29:48.34,1:29:49.46,Default,,0,0,0,,Ах
Dialogue: 0,1:29:50.00,1:29:51.80,Default,,0,0,0,,Уақыт туннелі
Dialogue: 0,1:29:52.09,1:29:54.97,Default,,0,0,0,,Ішкі кеңістікті жою құрылғысы іске қосылды.
Dialogue: 0,1:29:55.22,1:29:56.97,Default,,0,0,0,,Фухахахахаха
Dialogue: 0,1:29:57.39,1:30:01.93,Default,,0,0,0,,Өкінішті, мен енді дайындалып жатырмын.
Dialogue: 0,1:30:02.35,1:30:04.73,Default,,0,0,0,,Ішкі кеңістікті жойғаннан кейін...
Dialogue: 0,1:30:05.02,1:30:08.40,Default,,0,0,0,,Бұл дүниенің өзі жоғалып кетуі мүмкін.
Dialogue: 0,1:30:08.69,1:30:12.40,Default,,0,0,0,,Қызық, неге байқамасқа?
Dialogue: 0,1:30:16.53,1:30:18.20,Default,,0,0,0,,Кеңістік-уақыт турбуленттігі?
Dialogue: 0,1:30:18.70,1:30:20.54,Default,,0,0,0,,Оны қалай тоқтатуға болады?
Dialogue: 0,1:30:20.79,1:30:25.46,Default,,0,0,0,,Егер плазмалық шарға құйылатын энергия ағынын кесіп тастай алсақ...
Dialogue: 0,1:30:25.71,1:30:28.25,Default,,0,0,0,,Мұндай биікке шығу мүмкін емес.
Dialogue: 0,1:30:28.54,1:30:29.42,Default,,0,0,0,,Баспропеллер туралы не деуге болады?
Dialogue: 0,1:30:29.71,1:30:31.00,Default,,0,0,0,,Жұмыс істемейді
Dialogue: 0,1:30:33.09,1:30:34.05,Default,,0,0,0,,Ах
Dialogue: 0,1:30:36.09,1:30:36.76,Default,,0,0,0,,Nu?
Dialogue: 0,1:30:37.05,1:30:37.80,Default,,0,0,0,,Cucur
Dialogue: 0,1:30:39.35,1:30:41.93,Default,,0,0,0,,Уау
Dialogue: 0,1:30:44.06,1:30:45.43,Default,,0,0,0,,Хаах
Dialogue: 0,1:30:46.73,1:30:47.44,Default,,0,0,0,,Уау
Dialogue: 0,1:30:47.77,1:30:48.94,Default,,0,0,0,,Cucur
Dialogue: 0,1:30:51.57,1:30:53.32,Default,,0,0,0,,Уф... хмм...
Dialogue: 0,1:30:55.40,1:30:56.32,Default,,0,0,0,,Хмм!
Dialogue: 0,1:30:57.57,1:31:00.32,Default,,0,0,0,,Маймыл, сен не істейсің?
Dialogue: 0,1:31:14.09,1:31:15.55,Default,,0,0,0,,Куу…
Dialogue: 0,1:31:17.13,1:31:19.09,Default,,0,0,0,,Мен ол таяқшаны сындырамын.
Dialogue: 0,1:31:19.34,1:31:22.10,Default,,0,0,0,,Ууу
Dialogue: 0,1:31:24.27,1:31:27.60,Default,,0,0,0,,Қасиетті құрылғыдағы ақымақ маймыл
Dialogue: 0,1:31:31.27,1:31:32.94,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:31:33.86,1:31:36.90,Default,,0,0,0,,Бұл артта қалып, үйге жүгіру ме?
Dialogue: 0,1:31:37.15,1:31:39.32,Default,,0,0,0,,Бейсбол екі шығудан басталады.
Dialogue: 0,1:31:39.61,1:31:41.49,Default,,0,0,0,,Джан Сунео
Dialogue: 0,1:31:41.78,1:31:43.41,Default,,0,0,0,,Біз де сол жаққа барамыз
Dialogue: 0,1:31:46.95,1:31:50.08,Default,,0,0,0,,Ууу
Dialogue: 0,1:31:52.71,1:31:54.17,Default,,0,0,0,,Уа, ау
Dialogue: 0,1:31:54.55,1:31:56.13,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:57.55,1:31:58.55,Default,,0,0,0,,Cucur
Dialogue: 0,1:32:01.22,1:32:04.14,Default,,0,0,0,,Нуаа, плазма энергиясы
Dialogue: 0,1:32:07.85,1:32:09.06,Default,,0,0,0,,Боқта~
Dialogue: 0,1:32:09.31,1:32:11.81,Default,,0,0,0,,Міне!
Dialogue: 0,1:32:12.77,1:32:17.94,Default,,0,0,0,,үшін осында болса, бір ғасырлық айырмашылық қорқынышты емес.
Dialogue: 0,1:32:18.24,1:32:22.91,Default,,0,0,0,,Бала күтуші робот сізді ыңғайсыздандырады
Dialogue: 0,1:32:23.16,1:32:25.95,Default,,0,0,0,,Егер қолыңыздан келсе, жасап көріңіз.
Dialogue: 0,1:32:26.33,1:32:29.62,Default,,0,0,0,,Гигаааа
Dialogue: 0,1:32:29.79,1:32:30.67,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:30.79,1:32:33.00,Default,,0,0,0,,О… Они… И-чан
Dialogue: 0,1:32:34.09,1:32:34.84,Default,,0,0,0,,Столкер… не болып жатыр өзі?
Dialogue: 0,1:32:36.17,1:32:38.42,Default,,0,0,0,,Гуаа
Dialogue: 0,1:32:41.34,1:32:43.14,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:44.93,1:32:47.68,Default,,0,0,0,,Ішек, ақымақ.
Dialogue: 0,1:32:48.68,1:32:51.06,Default,,0,0,0,,Кез келген машинаны бөлшектеуге болады.
Dialogue: 0,1:32:51.35,1:32:53.15,Default,,0,0,0,,Бұл машина емес (3 адам) Иә?
Dialogue: 0,1:32:53.44,1:32:57.11,Default,,0,0,0,,Бұл найза Кукуру қолданған нағыз тас найза.
Dialogue: 0,1:32:58.19,1:33:03.03,Default,,0,0,0,,Жалған тарих нақты тарихты жеңе алмайды.
Dialogue: 0,1:33:03.28,1:33:05.99,Default,,0,0,0,,Нууу ах
Dialogue: 0,1:33:09.70,1:33:11.54,Default,,0,0,0,,Ах!
Dialogue: 0,1:33:21.88,1:33:23.76,Default,,0,0,0,,Уақытша патруль?
Dialogue: 0,1:33:27.22,1:33:29.43,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:33:29.89,1:33:33.39,Default,,0,0,0,,Уау~ Ақыры келді~ Мен жасадым~
Dialogue: 0,1:33:35.27,1:33:37.32,Default,,0,0,0,,Мен сені іздедім, аға.
Dialogue: 0,1:33:37.57,1:33:38.32,Default,,0,0,0,,Дорами?
Dialogue: 0,1:33:38.57,1:33:39.86,Default,,0,0,0,,Дорами-чан
Dialogue: 0,1:33:40.86,1:33:42.32,Default,,0,0,0,,Ах!
Dialogue: 0,1:33:42.49,1:33:45.28,Default,,0,0,0,,Күтіңіз, тоқтаңыз.
Dialogue: 0,1:33:46.24,1:33:49.24,Default,,0,0,0,,Тәтті, бір қадам қалды
Dialogue: 0,1:33:49.49,1:33:54.25,Default,,0,0,0,,Гига зомби тарихты жою әрекеті үшін қамауға алынды
Dialogue: 0,1:33:57.34,1:33:58.34,Default,,0,0,0,,Дорами-чан
Dialogue: 0,1:33:58.63,1:34:00.13,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,1:34:00.42,1:34:05.30,Default,,0,0,0,,Осыдан кейін мен Цучидаманың 23 ғасырда жасалғанын білдім.
Dialogue: 0,1:34:05.55,1:34:09.06,Default,,0,0,0,,Мүмкін бұл кеңістік-уақыт қылмысы шығар?
Dialogue: 0,1:34:09.31,1:34:12.98,Default,,0,0,0,,Дорами-чан күткендей, сен өз ағаңнан басқашасың.
Dialogue: 0,1:34:13.23,1:34:16.98,Default,,0,0,0,,Не? Бұл қорқынышты емес пе?
Dialogue: 0,1:34:17.40,1:34:20.98,Default,,0,0,0,,Ол Giga Zombie-ге жақсы қарсы тұрды.
Dialogue: 0,1:34:21.23,1:34:24.03,Default,,0,0,0,,Батылдығыңыз үшін көп рахмет.
Dialogue: 0,1:34:27.16,1:34:28.07,Default,,0,0,0,,Хмф!
Dialogue: 0,1:34:28.20,1:34:30.74,Default,,0,0,0,,Уау... Иә?
Dialogue: 0,1:34:30.95,1:34:34.50,Default,,0,0,0,,Мен бұл базаны тарихта қалмас үшін жарып жіберемін.
Dialogue: 0,1:34:34.79,1:34:36.17,Default,,0,0,0,,Борттағы барлық адамдар
Dialogue: 0,1:34:36.46,1:34:37.67,Default,,0,0,0,,Иә
Dialogue: 0,1:34:48.64,1:34:52.10,Default,,0,0,0,,Енді сізге ешкім шабуыл жасамайды.
Dialogue: 0,1:34:52.35,1:34:55.64,Default,,0,0,0,,Кураями де өз орындарына оралды.
Dialogue: 0,1:34:55.89,1:34:58.23,Default,,0,0,0,,Рахмет
Dialogue: 0,1:34:58.48,1:35:02.19,Default,,0,0,0,,Көмегің үшін Дразомби-самаға көп рахмет.
Dialogue: 0,1:35:02.48,1:35:05.57,Default,,0,0,0,,Бұл жолы тамаша ауыл саламыз.
Dialogue: 0,1:35:06.03,1:35:10.32,Default,,0,0,0,,Дәл осы жерде Жапония елі алғашқы қадамын жасайды.
Dialogue: 0,1:35:10.57,1:35:13.04,Default,,0,0,0,,Біздің ата-бабаларымыз?
Dialogue: 0,1:35:13.29,1:35:15.58,Default,,0,0,0,,Бұл есте қалатын сәт.
Dialogue: 0,1:35:16.96,1:35:18.04,Default,,0,0,0,,Cucur
Dialogue: 0,1:35:18.96,1:35:19.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:20.46,1:35:25.51,Default,,0,0,0,,Мына ит ысқырығы менің өмірімді сақтап қалды.
Dialogue: 0,1:35:30.30,1:35:32.22,Default,,0,0,0,,Мен оны Нобитаға беремін.
Dialogue: 0,1:35:32.47,1:35:33.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:33.51,1:35:34.89,Default,,0,0,0,,Оның орнына...
Dialogue: 0,1:35:35.64,1:35:38.14,Default,,0,0,0,,Мен туралы ұмытпа
Dialogue: 0,1:35:40.35,1:35:42.65,Default,,0,0,0,,Иә, мен ұмытамын.
Dialogue: 0,1:35:46.49,1:35:47.90,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,1:35:51.45,1:35:53.70,Default,,0,0,0,,Нобита-кун (Нобита) Иә
Dialogue: 0,1:35:54.49,1:35:56.91,Default,,0,0,0,,Сіз сол үш жануардың иесісіз бе?
Dialogue: 0,1:35:57.16,1:36:00.21,Default,,0,0,0,,Иә, бұл менің мақтан тұтатын үй жануарым.
Dialogue: 0,1:36:00.83,1:36:03.88,Default,,0,0,0,,Өкінішке орай, бұл балалар
Dialogue: 0,1:36:04.13,1:36:06.80,Default,,0,0,0,,Мен сені қиял-ғажайып сафари саябағына апарамын.
Dialogue: 0,1:36:07.05,1:36:09.30,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:36:10.01,1:36:14.26,Default,,0,0,0,,Ойдан шығарылған жануарлар ешбір дәуірде болмауы керек.
Dialogue: 0,1:36:14.56,1:36:15.51,Default,,0,0,0,,Бұл...
Dialogue: 0,1:36:17.35,1:36:21.77,Default,,0,0,0,,Жоқ, мен барлығының анасымын.
Dialogue: 0,1:36:22.02,1:36:24.61,Default,,0,0,0,,Біз мәңгі бірге өмір сүреміз
Dialogue: 0,1:36:25.40,1:36:28.44,Default,,0,0,0,,Нобита-кун, мен сенің сезіміңді түсінемін.
Dialogue: 0,1:36:28.69,1:36:32.91,Default,,0,0,0,,Біз Пега мен басқаларды не бақытты ететінін ойлауымыз керек.
Dialogue: 0,1:36:33.16,1:36:34.45,Default,,0,0,0,,Нобита
Dialogue: 0,1:36:34.74,1:36:35.87,Default,,0,0,0,,Нобита-сан
Dialogue: 0,1:36:36.12,1:36:37.50,Default,,0,0,0,,Нобита
Dialogue: 0,1:36:38.66,1:36:40.21,Default,,0,0,0,,Гун
Dialogue: 0,1:36:41.58,1:36:42.92,Default,,0,0,0,,Грул
Dialogue: 0,1:36:44.04,1:36:45.42,Default,,0,0,0,,Пуруруру
Dialogue: 0,1:36:57.26,1:37:02.10,Default,,0,0,0,,Драко ашкөз болғандықтан...
Dialogue: 0,1:37:03.02,1:37:05.98,Default,,0,0,0,,Көп тамақтанбау үшін абай болыңыз
Dialogue: 0,1:37:07.86,1:37:12.78,Default,,0,0,0,,Гури ағаш бұтақтарын алғанды ұнатады.
Dialogue: 0,1:37:13.53,1:37:16.58,Default,,0,0,0,,Содан кейін Пега...
Dialogue: 0,1:37:17.62,1:37:18.91,Default,,0,0,0,,Pega...
Dialogue: 0,1:37:23.17,1:37:25.08,Default,,0,0,0,,Әр түнде щеткамен тазалаңыз...
Dialogue: 0,1:37:26.09,1:37:28.42,Default,,0,0,0,,Қоңырау шалыңыз
Dialogue: 0,1:37:39.60,1:37:43.48,Default,,0,0,0,,Түсіндім, мен сізге хабарлаймын.
Dialogue: 0,1:37:43.73,1:37:47.69,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:37:56.66,1:37:59.37,Default,,0,0,0,,Мен сені аман-есен шығарып саламын~
Dialogue: 0,1:37:59.66,1:38:00.70,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:38:01.00,1:38:03.00,Default,,0,0,0,,Мен мұны сұрадым, Дорами.
Dialogue: 0,1:38:03.25,1:38:04.37,Default,,0,0,0,,Қош бол
Dialogue: 0,1:38:04.67,1:38:06.29,Default,,0,0,0,,Оны ұмытпа.
Dialogue: 0,1:38:15.09,1:38:17.14,Default,,0,0,0,,Хихи~н
Dialogue: 0,1:38:18.18,1:38:20.10,Default,,0,0,0,,Пега!
Dialogue: 0,1:38:24.69,1:38:27.56,Default,,0,0,0,,Гри Драко!
Dialogue: 0,1:38:32.15,1:38:36.41,Default,,0,0,0,,Болашақтың балалары сені жақсы көрсін.
Dialogue: 0,1:38:37.70,1:38:40.24,Default,,0,0,0,,Мен сені көруге келетініме сенімдімін!
Dialogue: 0,1:38:40.58,1:38:41.58,Default,,0,0,0,,Уау!
Dialogue: 0,1:38:43.87,1:38:44.91,Default,,0,0,0,,Мен де...
Dialogue: 0,1:38:47.04,1:38:50.17,Default,,0,0,0,,Мен де бар күшімді саламын!
Dialogue: 0,1:38:51.88,1:38:55.51,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,1:39:20.99,1:39:22.12,Default,,0,0,0,,Иә...
Dialogue: 0,1:39:24.70,1:39:28.08,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,1:39:28.62,1:39:30.25,Default,,0,0,0,,Менеджерге сәлем
Dialogue: 0,1:39:30.54,1:39:32.84,Default,,0,0,0,,А, мен барамын.
Dialogue: 0,1:39:40.26,1:39:43.43,Default,,0,0,0,,Нобита? Мен кешігіп қаламын.
Dialogue: 0,1:39:45.93,1:39:46.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:39:47.27,1:39:50.02,Default,,0,0,0,,Тынш, бар болғаны 10 минут қалды.
Dialogue: 0,1:39:50.81,1:39:52.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:52.44,1:39:53.44,Default,,0,0,0,,Хехехе
Dialogue: 0,1:39:58.36,1:40:00.07,Default,,0,0,0,,Хехехе
Dialogue: 0,1:40:02.91,1:40:04.45,Default,,0,0,0,,Нобита...
Dialogue: 0,1:40:06.87,1:40:08.46,Default,,0,0,0,,Үйден қашуды аяқтадыңыз ба?
Dialogue: 0,1:40:08.71,1:40:11.00,Default,,0,0,0,,Мүмкін хехехе
Dialogue: 0,1:40:13.29,1:40:15.96,Default,,0,0,0,,Нобитаға қош келдіңіз
Dialogue: 0,1:40:18.80,1:40:24.81,Default,,0,0,0,,(♪ «Аспанға»)
Dialogue: 0,1:43:07.51,1:43:13.52,Default,,0,0,0,,〜♪
