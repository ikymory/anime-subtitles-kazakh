Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.58,0:00:10.51,Default,,0,0,0,,(Цзиньтанның ауыр тыныс алуы)
Dialogue: 0,0:00:35.99,0:00:38.12,Default,,0,0,0,,(Цзиньтанның ауыр тыныс алуы)
Dialogue: 0,0:00:39.45,0:00:40.62,Default,,0,0,0,,Ум...
Dialogue: 0,0:00:42.20,0:00:43.62,Default,,0,0,0,,Сол көпір...
Dialogue: 0,0:00:59.26,0:01:03.06,Default,,0,0,0,,Сол көпірден өтсең, көресің.
Dialogue: 0,0:01:10.36,0:01:13.03,Default,,0,0,0,,Әр адамның құпия негізі
Dialogue: 0,0:01:21.41,0:01:26.96,Default,,0,0,0,,Джинтанто, Юкиацуто —
Dialogue: 0,0:01:27.54,0:01:30.13,Default,,0,0,0,,Цурукото Попото—
Dialogue: 0,0:01:31.88,0:01:33.05,Default,,0,0,0,,Менмато
Dialogue: 0,0:01:37.18,0:01:41.22,Default,,0,0,0,,Super Peace Busters құпия базасы
Dialogue: 0,0:01:43.52,0:01:45.10,Default,,0,0,0,,Дж... Джинтан?
Dialogue: 0,0:01:45.23,0:01:47.89,Default,,0,0,0,,Хахаха
Dialogue: 0,0:01:48.02,0:01:48.85,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:01:48.98,0:01:49.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:52.77,0:01:54.69,Default,,0,0,0,,Менма? Менма!
Dialogue: 0,0:01:54.82,0:01:55.65,Default,,0,0,0,,Менма!
Dialogue: 0,0:01:55.78,0:01:57.03,Default,,0,0,0,,Сәлем Джинтан?
Dialogue: 0,0:01:57.61,0:01:59.49,Default,,0,0,0,,Не болды? Амал жоқ...
Dialogue: 0,0:01:59.95,0:02:02.33,Default,,0,0,0,,Менма Мүмкін... солай!
Dialogue: 0,0:02:02.45,0:02:04.16,Default,,0,0,0,,Джин…тан
Dialogue: 0,0:02:04.29,0:02:05.50,Default,,0,0,0,,Менма?
Dialogue: 0,0:02:05.79,0:02:08.67,Default,,0,0,0,,Бұл не? Сен қайдасың? Тез шық!
Dialogue: 0,0:02:08.79,0:02:09.62,Default,,0,0,0,,Менма
Dialogue: 0,0:02:10.13,0:02:11.84,Default,,0,0,0,,Менма Менма!
Dialogue: 0,0:02:11.96,0:02:13.55,Default,,0,0,0,,Сәлем Джинтан Менма!
Dialogue: 0,0:02:13.67,0:02:15.46,Default,,0,0,0,,Не болды, Менма!
Dialogue: 0,0:02:15.59,0:02:18.93,Default,,0,0,0,,Немесе... бұл жасырынбақ.
Dialogue: 0,0:02:19.55,0:02:22.64,Default,,0,0,0,,Не... жасырынбақ деген не?
Dialogue: 0,0:02:22.93,0:02:26.02,Default,,0,0,0,,Цзиньтан Мэнма Сіз жасырынбақ ойнайсыз ба?
Dialogue: 0,0:02:26.14,0:02:27.56,Default,,0,0,0,,Ішің ауырған сияқты... әлгі... өзіңді өзің бүлдіріп алған жоқсың ғой?
Dialogue: 0,0:02:28.98,0:02:30.77,Default,,0,0,0,,Эй Джинтан, эй!
Dialogue: 0,0:02:30.90,0:02:32.73,Default,,0,0,0,,Менма!
Dialogue: 0,0:02:32.86,0:02:33.98,Default,,0,0,0,,Әй, біз де
Dialogue: 0,0:02:34.11,0:02:35.28,Default,,0,0,0,,Иә... кеттік.
Dialogue: 0,0:02:35.40,0:02:36.44,Default,,0,0,0,,Иә
Dialogue: 0,0:02:39.99,0:02:43.32,Default,,0,0,0,,Әлі емес... әлі жоқ.
Dialogue: 0,0:02:46.54,0:02:47.37,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:02:47.91,0:02:50.58,Default,,0,0,0,,Мен дұрыстап қоштасуым керек.
Dialogue: 0,0:02:50.71,0:02:52.88,Default,,0,0,0,,Менма!
Dialogue: 0,0:02:53.00,0:02:55.30,Default,,0,0,0,,Менма!
Dialogue: 0,0:02:57.09,0:02:59.92,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:02.18,0:03:04.51,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:09.68,0:03:12.35,Default,,0,0,0,,Е, е м... е м
Dialogue: 0,0:03:12.81,0:03:15.44,Default,,0,0,0,,Хмм, мен шештім.
Dialogue: 0,0:03:15.57,0:03:17.40,Default,,0,0,0,,Иә, онда мен...
Dialogue: 0,0:03:17.57,0:03:19.78,Default,,0,0,0,,Сәлем поппо! бұл мен
Dialogue: 0,0:03:19.90,0:03:20.95,Default,,0,0,0,,Не?!
Dialogue: 0,0:03:21.07,0:03:24.53,Default,,0,0,0,,Өйткені мен осындамын, иә
Dialogue: 0,0:03:25.20,0:03:26.70,Default,,0,0,0,,Иә
Dialogue: 0,0:03:26.83,0:03:29.95,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:03:30.46,0:03:33.33,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:36.21,0:03:37.21,Default,,0,0,0,,Ах
Dialogue: 0,0:03:43.43,0:03:45.72,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:03:48.31,0:03:50.10,Default,,0,0,0,,Джинтан Тыныш!
Dialogue: 0,0:03:50.39,0:03:52.52,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:03:52.69,0:03:55.27,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:03:55.65,0:03:56.81,Default,,0,0,0,,Менмане
Dialogue: 0,0:03:57.40,0:04:00.61,Default,,0,0,0,,Кейде біртүрлі болып көрінеді.
Dialogue: 0,0:04:01.07,0:04:02.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:04.36,0:04:06.87,Default,,0,0,0,,Уау! Itte
Dialogue: 0,0:04:06.99,0:04:08.91,Default,,0,0,0,,Пуфуфуфу поппо микке
Dialogue: 0,0:04:09.37,0:04:16.17,Default,,0,0,0,,Менма қазір барлығымен ойнап жүр.
Dialogue: 0,0:04:17.38,0:04:19.30,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:04:19.42,0:04:20.80,Default,,0,0,0,,Анару Микке
Dialogue: 0,0:04:20.92,0:04:22.76,Default,,0,0,0,,Эх!
Dialogue: 0,0:04:39.61,0:04:40.98,Default,,0,0,0,,Менмахане
Dialogue: 0,0:04:41.53,0:04:44.82,Default,,0,0,0,,«Дос алмасу» мүмкін емес.
Dialogue: 0,0:04:52.20,0:04:56.29,Default,,0,0,0,,Содан кейін таңдалған топ басшысы жетекшілік етеді...
Dialogue: 0,0:04:56.42,0:04:58.88,Default,,0,0,0,,Бәріміз топ құрайық
Dialogue: 0,0:05:01.05,0:05:02.80,Default,,0,0,0,,Сол жерге жиналайық.
Dialogue: 0,0:05:02.92,0:05:05.17,Default,,0,0,0,,Айла (Б қыз) Бірге топтасайық
Dialogue: 0,0:05:05.34,0:05:09.85,Default,,0,0,0,,Менма «барлығы» бола алмайды
Dialogue: 0,0:05:10.31,0:05:12.31,Default,,0,0,0,,Мен әрқашан осылай ойладым
Dialogue: 0,0:05:13.68,0:05:15.18,Default,,0,0,0,,Өйткені Менма
Dialogue: 0,0:05:16.23,0:05:17.90,Default,,0,0,0,,Өйткені бұл Нокемон
Dialogue: 0,0:05:22.53,0:05:23.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:23.48,0:05:25.28,Default,,0,0,0,,Сіз менің командамдасыз.
Dialogue: 0,0:05:25.45,0:05:26.86,Default,,0,0,0,,Команда?
Dialogue: 0,0:05:28.41,0:05:30.83,Default,,0,0,0,,Хи хи хи хи
Dialogue: 0,0:05:32.29,0:05:34.58,Default,,0,0,0,,Мен саудалаған бірінші Покемон болды
Dialogue: 0,0:05:35.33,0:05:36.91,Default,,0,0,0,,Бұл Пипитон болатын.
Dialogue: 0,0:05:37.04,0:05:39.54,Default,,0,0,0,,Жарайды, дайын
Dialogue: 0,0:05:40.79,0:05:42.38,Default,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,0:05:42.50,0:05:43.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.34,0:05:47.80,Default,,0,0,0,,Менма Яграны шығарсын. Сонымен, Пипитон?
Dialogue: 0,0:05:47.93,0:05:49.68,Default,,0,0,0,,Джинтан Хиди
Dialogue: 0,0:05:49.80,0:05:51.43,Default,,0,0,0,,бұл жақсы емес дегенді білдіреді
Dialogue: 0,0:05:51.55,0:05:53.14,Default,,0,0,0,,Эй, эй, мына жігіт...
Dialogue: 0,0:05:53.31,0:05:54.77,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:05:54.89,0:05:58.23,Default,,0,0,0,,Мен... Менма, маған Пипитон ұнайды.
Dialogue: 0,0:05:58.35,0:05:59.48,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:59.65,0:06:00.48,Default,,0,0,0,,Иә
Dialogue: 0,0:06:02.27,0:06:03.57,Default,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:06:03.69,0:06:05.78,Default,,0,0,0,,Жарайды, егер менма ұнаса.
Dialogue: 0,0:06:05.90,0:06:06.86,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:06.99,0:06:10.49,Default,,0,0,0,,Өйткені Пипитонның ерекше шеберлігі
Dialogue: 0,0:06:11.28,0:06:14.12,Default,,0,0,0,,«Барлығы билейді»
Dialogue: 0,0:06:20.88,0:06:22.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:22.42,0:06:23.54,Default,,0,0,0,,Уф
Dialogue: 0,0:06:23.84,0:06:24.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:27.09,0:06:27.92,Default,,0,0,0,,О!
Dialogue: 0,0:06:28.05,0:06:29.93,Default,,0,0,0,,Барлығы білдіреді
Dialogue: 0,0:06:30.05,0:06:34.14,Default,,0,0,0,,Бұл тұшпара тәрізді бір түйір ғана емес.
Dialogue: 0,0:06:34.56,0:06:35.64,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:52.45,0:06:55.28,Default,,0,0,0,,Күріш дәніндей
Dialogue: 0,0:06:55.74,0:06:58.91,Default,,0,0,0,,Бірінен соң бірі дірілдейді
Dialogue: 0,0:06:59.71,0:07:03.92,Default,,0,0,0,,Олар жиналып, қатқанда не пайда болды...
Dialogue: 0,0:07:04.46,0:07:05.29,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:05.50,0:07:07.09,Default,,0,0,0,,Барлығы қандай?
Dialogue: 0,0:07:09.55,0:07:10.80,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:07:11.84,0:07:13.47,Default,,0,0,0,,Цуруко Микке
Dialogue: 0,0:07:13.76,0:07:16.89,Default,,0,0,0,,Цуруко тым оңай!
Dialogue: 0,0:07:17.01,0:07:19.14,Default,,0,0,0,,Ол жақсы жасырылды.
Dialogue: 0,0:07:19.98,0:07:22.10,Default,,0,0,0,,Қалғандары - Цзиньтан мен Менмака
Dialogue: 0,0:07:22.23,0:07:25.31,Default,,0,0,0,,Эй, Джинтан, сен ғибадатхананың ішінде емессің бе?
Dialogue: 0,0:07:25.44,0:07:27.98,Default,,0,0,0,,Ғибадатхананың ішінде барабан таяқшалары соғылады.
Dialogue: 0,0:07:28.11,0:07:30.24,Default,,0,0,0,,Бірақ менің ойымша, Джинтан мұны жасайды.
Dialogue: 0,0:07:30.65,0:07:31.49,Default,,0,0,0,,Ябе
Dialogue: 0,0:07:32.03,0:07:33.36,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:07:33.49,0:07:34.95,Default,,0,0,0,,Ах
Dialogue: 0,0:07:35.07,0:07:36.83,Default,,0,0,0,,Ах! Қарғыс атсын
Dialogue: 0,0:07:38.20,0:07:39.04,Default,,0,0,0,,Эххе
Dialogue: 0,0:07:40.25,0:07:44.21,Default,,0,0,0,,Мен Джинтан Менманы таптым!
Dialogue: 0,0:07:44.54,0:07:47.59,Default,,0,0,0,,♪～
Dialogue: 0,0:07:58.47,0:08:02.10,Default,,0,0,0,,～♪
Dialogue: 0,0:08:20.62,0:08:22.62,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:25.79,0:08:27.75,Default,,0,0,0,,...сен бастауыш сынып оқушысысың ба?
Dialogue: 0,0:08:27.88,0:08:34.30,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:08:34.43,0:08:36.34,Default,,0,0,0,,Иә Не? Цуруко
Dialogue: 0,0:08:36.55,0:08:40.31,Default,,0,0,0,,Не? Иә, бүгін сағат 6.
Dialogue: 0,0:08:41.02,0:08:41.97,Default,,0,0,0,,Ах
Dialogue: 0,0:08:42.10,0:08:43.89,Default,,0,0,0,,Әй, сен хат жаздың ба?
Dialogue: 0,0:08:44.85,0:08:48.15,Default,,0,0,0,,Керемет, күткендей.
Dialogue: 0,0:08:48.27,0:08:51.03,Default,,0,0,0,,Мен не жазарымды білмеймін.
Dialogue: 0,0:08:52.07,0:08:55.86,Default,,0,0,0,,Менмаға айтқыңыз келетін көп нәрсе бар, солай ма?
Dialogue: 0,0:08:56.24,0:08:59.58,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,0:09:00.54,0:09:01.45,Default,,0,0,0,,Ах
Dialogue: 0,0:09:02.33,0:09:04.21,Default,,0,0,0,,Мен қателік жібердім, иә?
Dialogue: 0,0:09:04.33,0:09:05.79,Default,,0,0,0,,Менма үшін—
Dialogue: 0,0:09:05.92,0:09:08.58,Default,,0,0,0,,Мен не айтуым керек?
Dialogue: 0,0:09:08.71,0:09:12.09,Default,,0,0,0,,Маған айту керек пе?
Dialogue: 0,0:09:12.21,0:09:13.67,Default,,0,0,0,,Өзіңіз ойлап көріңіз
Dialogue: 0,0:09:13.80,0:09:15.55,Default,,0,0,0,,А... Онда сағат 6 болды.
Dialogue: 0,0:09:15.68,0:09:16.51,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:09:16.63,0:09:18.14,Default,,0,0,0,,(Қоңырау ажыратылған дыбыс)
Dialogue: 0,0:09:18.26,0:09:21.60,Default,,0,0,0,,Ах Му Цуруко жоғарыдан қарап
Dialogue: 0,0:09:24.48,0:09:25.43,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:49.00,0:09:50.42,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:09:53.25,0:09:56.26,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:09:56.42,0:09:58.34,Default,,0,0,0,,Е... бірақ
Dialogue: 0,0:09:58.80,0:10:01.72,Default,,0,0,0,,Бұндай нәрсе бұзақыға ұқсайды.
Dialogue: 0,0:10:02.68,0:10:04.43,Default,,0,0,0,,Сіз де білгіңіз келеді.
Dialogue: 0,0:10:04.72,0:10:07.23,Default,,0,0,0,,Мен білгім келеді...
Dialogue: 0,0:10:07.77,0:10:08.89,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:09.60,0:10:10.44,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:10:10.56,0:10:12.15,Default,,0,0,0,,Менің ойымша, сізге Джинтан ұнайды.
Dialogue: 0,0:10:12.27,0:10:13.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.28,0:10:15.44,Default,,0,0,0,,Иә
Dialogue: 0,0:10:16.69,0:10:21.32,Default,,0,0,0,,Мен Джинтанды әрқашан жақсы көретінмін.
Dialogue: 0,0:10:22.16,0:10:24.58,Default,,0,0,0,,(Ойын дыбысы)
Dialogue: 0,0:10:24.70,0:10:27.54,Default,,0,0,0,,Эй, бұл Джинтан.
Dialogue: 0,0:10:27.79,0:10:28.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:29.12,0:10:32.21,Default,,0,0,0,,Маған Менма ұнайды... неге?
Dialogue: 0,0:10:32.54,0:10:34.17,Default,,0,0,0,,Не? а?
Dialogue: 0,0:10:34.30,0:10:35.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:36.88,0:10:39.55,Default,,0,0,0,,Не... не айтып тұрсың!
Dialogue: 0,0:10:39.80,0:10:41.55,Default,,0,0,0,,Адал бол
Dialogue: 0,0:10:41.97,0:10:44.43,Default,,0,0,0,,Super Peace Busters-тің жасыратын ештеңесі жоқ.
Dialogue: 0,0:10:44.56,0:10:45.60,Default,,0,0,0,,Юкиацу
Dialogue: 0,0:10:45.72,0:10:48.77,Default,,0,0,0,,Айт, айт, айт!
Dialogue: 0,0:10:48.89,0:10:51.48,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:10:51.94,0:10:53.98,Default,,0,0,0,,Айт, айт
Dialogue: 0,0:10:54.69,0:10:56.19,Default,,0,0,0,,Айт, айт!
Dialogue: 0,0:10:56.32,0:10:58.40,Default,,0,0,0,,Мынау кім шіркін?
Dialogue: 0,0:10:59.78,0:11:00.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:01.45,0:11:02.70,Default,,0,0,0,,Ах
Dialogue: 0,0:11:09.83,0:11:11.04,Default,,0,0,0,,Эххе
Dialogue: 0,0:11:11.46,0:11:12.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:15.29,0:11:17.42,Default,,0,0,0,,А, күте тұр, Джинтан!
Dialogue: 0,0:11:18.01,0:11:19.38,Default,,0,0,0,,Джинтан!
Dialogue: 0,0:11:19.59,0:11:23.09,Default,,0,0,0,,Сол күні мен Менмамен ажырастым
Dialogue: 0,0:11:24.85,0:11:26.76,Default,,0,0,0,,Ол енді келмейді
Dialogue: 0,0:11:28.64,0:11:30.23,Default,,0,0,0,,Маған жетпеген сөздер
Dialogue: 0,0:11:31.73,0:11:33.23,Default,,0,0,0,,Қабылданған сөздер
Dialogue: 0,0:11:37.23,0:11:39.61,Default,,0,0,0,,Берілуі тиіс сөздер
Dialogue: 0,0:11:42.45,0:11:43.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:47.95,0:11:49.62,Default,,0,0,0,,Осы суретте олар мінсіз жұп сияқты көрінеді, иә?
Dialogue: 0,0:11:50.25,0:11:51.96,Default,,0,0,0,,Нокемон өтінемін
Dialogue: 0,0:11:52.08,0:11:54.42,Default,,0,0,0,,Вау Расуичи (Бала C) Бақытты
Dialogue: 0,0:11:54.54,0:11:56.29,Default,,0,0,0,,Абуни
Dialogue: 0,0:11:57.59,0:11:59.59,Default,,0,0,0,,4800 иен
Dialogue: 0,0:11:59.71,0:12:00.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:00.67,0:12:03.38,Default,,0,0,0,,Сіз 4600 иен дедіңіз.
Dialogue: 0,0:12:03.51,0:12:05.30,Default,,0,0,0,,8 6 сияқты болды
Dialogue: 0,0:12:05.43,0:12:08.47,Default,,0,0,0,,Ах! Мен ертерек шырын ішуім керек еді.
Dialogue: 0,0:12:08.60,0:12:11.18,Default,,0,0,0,,Не істеу керек? Эй, эй (Бала А) О.
Dialogue: 0,0:12:11.31,0:12:14.06,Default,,0,0,0,,Мм, мен оны бірден аламын, сондықтан...
Dialogue: 0,0:12:14.19,0:12:15.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:16.11,0:12:17.73,Default,,0,0,0,,Покемон бар ма?
Dialogue: 0,0:12:18.94,0:12:20.36,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:12:21.69,0:12:22.57,Default,,0,0,0,,Уф
Dialogue: 0,0:12:24.20,0:12:26.16,Default,,0,0,0,,Кешіріңіз, ол сатылып кетті.
Dialogue: 0,0:12:26.28,0:12:28.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:28.53,0:12:30.79,Default,,0,0,0,,Өйткені, брондау мүмкін емес.
Dialogue: 0,0:12:31.50,0:12:33.54,Default,,0,0,0,,Асығыңыз және 200 иен алыңыз.
Dialogue: 0,0:12:34.75,0:12:37.17,Default,,0,0,0,,Бір сағат ішінде (Бала А) Иә!
Dialogue: 0,0:12:37.63,0:12:38.67,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:12:38.79,0:12:40.96,Default,,0,0,0,,Ол таңқаларлық жақсы жігіт.
Dialogue: 0,0:12:42.38,0:12:45.76,Default,,0,0,0,,Сен оны сол бейбақ дейсің бе?
Dialogue: 0,0:12:46.09,0:12:47.55,Default,,0,0,0,,Шукууми-кун
Dialogue: 0,0:12:48.10,0:12:50.72,Default,,0,0,0,,Мен жаңа ғана үзіліске шықтым.
Dialogue: 0,0:12:50.85,0:12:53.18,Default,,0,0,0,,Аа, кешіріңіз, онда жалғастырыңыз.
Dialogue: 0,0:12:59.69,0:13:02.19,Default,,0,0,0,,Менма, қалайсың?
Dialogue: 0,0:13:04.15,0:13:07.62,Default,,0,0,0,,«Қалайсың?» деп сұраудың өзі біртүрлі.
Dialogue: 0,0:13:08.91,0:13:13.25,Default,,0,0,0,,Содан бері мен мектепке кейде барамын, кейде бармаймын.
Dialogue: 0,0:13:14.04,0:13:15.46,Default,,0,0,0,,Жақсы, мен өте жақсы жұмыс істеп жатырмын.
Dialogue: 0,0:13:17.04,0:13:18.79,Default,,0,0,0,,Күні кеше мен толық емес жұмыс күнімде ағамен бірге болдым.
Dialogue: 0,0:13:18.92,0:13:21.00,Default,,0,0,0,,Ол мені караокеге апарды.
Dialogue: 0,0:13:21.96,0:13:25.26,Default,,0,0,0,,Мұндай жерге бірінші рет баруым.
Dialogue: 0,0:13:26.26,0:13:29.97,Default,,0,0,0,,Адамдардың алдында ән айту шынымен де ұят.
Dialogue: 0,0:13:30.64,0:13:33.60,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:13:33.72,0:13:34.68,Default,,0,0,0,,Келесі Кім?
Dialogue: 0,0:13:34.81,0:13:36.77,Default,,0,0,0,,А, бұл менмін.
Dialogue: 0,0:13:41.36,0:13:45.65,Default,,0,0,0,,♪ Көргім келеді, көргім келеді, қалтырап
Dialogue: 0,0:13:45.78,0:13:48.32,Default,,0,0,0,,♪ Мен сен туралы көбірек ойлаймын
Dialogue: 0,0:13:48.53,0:13:51.20,Default,,0,0,0,,Барлығы фальсеттоны пайдаланады.
Dialogue: 0,0:13:51.33,0:13:53.37,Default,,0,0,0,,Мен көп әндерді білемін.
Dialogue: 0,0:13:54.41,0:13:55.91,Default,,0,0,0,,Не?
Dialogue: 0,0:13:56.04,0:13:58.29,Default,,0,0,0,,Барлығы керемет деп ойлады.
Dialogue: 0,0:13:59.04,0:14:02.67,Default,,0,0,0,,Ал, бір караоке - бұл асыра сілтеу.
Dialogue: 0,0:14:09.51,0:14:10.80,Default,,0,0,0,,Иә
Dialogue: 0,0:14:10.93,0:14:13.35,Default,,0,0,0,,Маңызды емес нәрсені таң қалдыратын нәрсе...
Dialogue: 0,0:14:14.22,0:14:15.85,Default,,0,0,0,,Мұның бәрі сіздің арқаңыз деп ойлаймын.
Dialogue: 0,0:14:17.52,0:14:20.65,Default,,0,0,0,,Мен өзімді сөреге қойдым—
Dialogue: 0,0:14:20.77,0:14:23.02,Default,,0,0,0,,Мен айналамдағы адамдарды мазақ еттім.
Dialogue: 0,0:14:25.36,0:14:26.94,Default,,0,0,0,,Сіз келгенше...
Dialogue: 0,0:14:36.79,0:14:39.21,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:14:39.33,0:14:40.29,Default,,0,0,0,,Чигет
Dialogue: 0,0:14:40.42,0:14:43.29,Default,,0,0,0,,Бірақ сіздің кеудеңіз үлкенірек болды.
Dialogue: 0,0:14:43.42,0:14:45.84,Default,,0,0,0,,Бұл аздап қорқынышты
Dialogue: 0,0:14:45.96,0:14:47.46,Default,,0,0,0,,Өл, өл, өл, өл
Dialogue: 0,0:14:47.59,0:14:49.17,Default,,0,0,0,,Өл, өл, өл, өл
Dialogue: 0,0:14:49.30,0:14:51.26,Default,,0,0,0,,Рецессивті гендеріңізді қалдырмаңыз.
Dialogue: 0,0:14:51.39,0:14:54.35,Default,,0,0,0,,Өл, мүйізді аң, өл.
Dialogue: 0,0:14:54.47,0:14:55.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:55.93,0:14:57.52,Default,,0,0,0,,Эй, бұл құрылысшы ма?
Dialogue: 0,0:14:57.64,0:15:00.77,Default,,0,0,0,,Жоқ, әйелдердің миы төмен екені рас.
Dialogue: 0,0:15:00.90,0:15:03.19,Default,,0,0,0,,Иә? Бірақ ұқсас
Dialogue: 0,0:15:03.31,0:15:05.32,Default,,0,0,0,,Ерін, қарашы, олар сондай қалың
Dialogue: 0,0:15:05.44,0:15:06.61,Default,,0,0,0,,Кез келген себеппен...
Dialogue: 0,0:15:06.73,0:15:09.61,Default,,0,0,0,,Соробан Джукудағы қария да құрылысшы...
Dialogue: 0,0:15:09.74,0:15:11.36,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:11.70,0:15:13.78,Default,,0,0,0,,Бірақ келіңіз.
Dialogue: 0,0:15:13.91,0:15:15.74,Default,,0,0,0,,Иә? Джинтан?
Dialogue: 0,0:15:19.16,0:15:20.00,Default,,0,0,0,,Джинтан?
Dialogue: 0,0:15:21.25,0:15:22.63,Default,,0,0,0,,Жазғы аң
Dialogue: 0,0:15:22.88,0:15:25.96,Default,,0,0,0,,Өте... қатыгез.
Dialogue: 0,0:15:26.09,0:15:27.50,Default,,0,0,0,,О, сен соншалықты қу екенсің!
Dialogue: 0,0:15:27.63,0:15:30.01,Default,,0,0,0,,Менманы да жеңіз Тұз рамен
Dialogue: 0,0:15:31.01,0:15:32.97,Default,,0,0,0,,Иә? О, жұмыртқа
Dialogue: 0,0:15:33.09,0:15:36.76,Default,,0,0,0,,Менмане Катама жақсы. Катама жақсы.
Dialogue: 0,0:15:40.56,0:15:41.52,Default,,0,0,0,,Эй
Dialogue: 0,0:15:42.44,0:15:45.56,Default,,0,0,0,,Жұмыртқалар қатая ма?
Dialogue: 0,0:15:47.40,0:15:50.11,Default,,0,0,0,,Жұмыртқа Араластырыңыз, араластырыңыз, араластырыңыз!
Dialogue: 0,0:15:50.24,0:15:51.86,Default,,0,0,0,,Уа, қандай рамен?
Dialogue: 0,0:15:52.28,0:15:53.32,Default,,0,0,0,,Бұл жақсы. Әй, бұл ағай.
Dialogue: 0,0:15:53.45,0:15:56.12,Default,,0,0,0,,Джинта, менікі де жасап берші. Мен сені мазалап жүрмін.
Dialogue: 0,0:15:57.87,0:15:58.70,Default,,0,0,0,,Джинта?
Dialogue: 0,0:15:59.33,0:16:00.41,Default,,0,0,0,,Қажеті жоқ. Айтқым келетін ешкім жоқ.
Dialogue: 0,0:16:00.54,0:16:02.75,Default,,0,0,0,,Иә, сүйкімді
Dialogue: 0,0:16:02.87,0:16:04.96,Default,,0,0,0,,Әр нәрседе сүйкімді болатын әдеті.
Dialogue: 0,0:16:05.08,0:16:05.92,Default,,0,0,0,,Тоқтау керек емес пе?
Dialogue: 0,0:16:06.04,0:16:08.21,Default,,0,0,0,,Жақсы сөз екен.
Dialogue: 0,0:16:08.34,0:16:09.84,Default,,0,0,0,,Кез келген нәрсеге қолдануға болады
Dialogue: 0,0:16:09.96,0:16:11.84,Default,,0,0,0,,Әдетте оны пайдалана алмайсыз.
Dialogue: 0,0:16:12.01,0:16:13.01,Default,,0,0,0,,Жұмыртқа туралы не деуге болады?
Dialogue: 0,0:16:13.13,0:16:15.09,Default,,0,0,0,,1 тамшы доп, оны сындырмаңыз
Dialogue: 0,0:16:15.26,0:16:16.30,Default,,0,0,0,,Жарайды, ә!
Dialogue: 0,0:16:16.43,0:16:17.51,Default,,0,0,0,,Тіпті аға!
Dialogue: 0,0:16:17.64,0:16:20.27,Default,,0,0,0,,Сүйікті Сүйікті орта жастағы адамдар!
Dialogue: 0,0:16:21.18,0:16:22.81,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:16:23.35,0:16:25.19,Default,,0,0,0,,Теледидар
Dialogue: 0,0:16:25.31,0:16:26.52,Default,,0,0,0,,Аа, мысық сүйкімді
Dialogue: 0,0:16:27.23,0:16:29.98,Default,,0,0,0,,Әкем кәдімгідей кәсіппен айналысады.
Dialogue: 0,0:16:30.48,0:16:32.24,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:32.36,0:16:33.86,Default,,0,0,0,,Эй Джинтан!
Dialogue: 0,0:16:34.70,0:16:35.53,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:16:35.66,0:16:36.74,Default,,0,0,0,,Ия!
Dialogue: 0,0:16:36.87,0:16:37.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:38.37,0:16:39.99,Default,,0,0,0,,Эмилияны құтқарғың келеді деп айтқан жоқсың.
Dialogue: 0,0:16:40.12,0:16:41.83,Default,,0,0,0,,Бұрыш бұрышы
Dialogue: 0,0:16:42.00,0:16:45.04,Default,,0,0,0,,Бұрыш бұрыш Жарайды.
Dialogue: 0,0:16:47.17,0:16:48.96,Default,,0,0,0,,Мен менманы да жеймін.
Dialogue: 0,0:16:49.09,0:16:49.92,Default,,0,0,0,,Джинта?
Dialogue: 0,0:16:50.05,0:16:52.13,Default,,0,0,0,,А, жоқ, эй...
Dialogue: 0,0:16:52.67,0:16:54.01,Default,,0,0,0,,Таяқшалар қайда?
Dialogue: 0,0:16:54.13,0:16:54.97,Default,,0,0,0,,Таяқшалар!
Dialogue: 0,0:16:55.09,0:16:56.01,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:56.72,0:16:58.43,Default,,0,0,0,,А... а...
Dialogue: 0,0:16:59.39,0:17:00.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:02.39,0:17:03.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:03.35,0:17:05.73,Default,,0,0,0,,Не болып жатыр? Үйде ыстық соққы болды ма?
Dialogue: 0,0:17:05.85,0:17:07.35,Default,,0,0,0,,Сүйкімді, бірақ қиын!
Dialogue: 0,0:17:07.48,0:17:08.81,Default,,0,0,0,,Джинтан?
Dialogue: 0,0:17:09.06,0:17:12.03,Default,,0,0,0,,Жазғы аң Менмаха
Dialogue: 0,0:17:12.19,0:17:15.45,Default,,0,0,0,,Ол менің алдымнан шығып, осылай деді.
Dialogue: 0,0:17:15.95,0:17:17.87,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:17:18.20,0:17:21.33,Default,,0,0,0,,Менің ойымша, сіз өз тілегіңіздің орындалғанын қалайсыз, Менма.
Dialogue: 0,0:17:22.33,0:17:25.71,Default,,0,0,0,,Өтінемін? Бұл не?
Dialogue: 0,0:17:25.83,0:17:28.21,Default,,0,0,0,,Хмм, бұл да...
Dialogue: 0,0:17:28.50,0:17:30.38,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:17:31.17,0:17:33.67,Default,,0,0,0,,Егер сіз өз тілектеріңізді түсінбесеңіз, оларды орындауға ешқандай мүмкіндік жоқ!
Dialogue: 0,0:17:33.80,0:17:37.59,Default,,0,0,0,,Хмм, бірақ мен солай сезінемін.
Dialogue: 0,0:17:37.93,0:17:39.93,Default,,0,0,0,,Шынымен де, бұл не екені маған таң қалды.
Dialogue: 0,0:17:40.05,0:17:40.89,Default,,0,0,0,,Мен білемін бе?
Dialogue: 0,0:17:41.01,0:17:42.31,Default,,0,0,0,,А, мен оған түкірдім.
Dialogue: 0,0:17:42.43,0:17:43.93,Default,,0,0,0,,Маған енді ұнамайды.
Dialogue: 0,0:17:44.06,0:17:45.43,Default,,0,0,0,,Тосқауыл
Dialogue: 0,0:17:46.19,0:17:49.94,Default,,0,0,0,,Бұл жаздың аңы, күйзелісім
Dialogue: 0,0:17:50.23,0:17:51.65,Default,,0,0,0,,Менің жарақатым
Dialogue: 0,0:17:51.77,0:17:53.03,Default,,0,0,0,,Әзірге
Dialogue: 0,0:17:53.57,0:17:55.65,Default,,0,0,0,,Бұл тілекті есте сақтаңыз.
Dialogue: 0,0:17:55.82,0:17:57.70,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:17:57.82,0:18:00.41,Default,,0,0,0,,Бұл әркім ғана орындай алатын өтініш еді.
Dialogue: 0,0:18:00.53,0:18:03.37,Default,,0,0,0,,Не, бәрі?
Dialogue: 0,0:18:03.66,0:18:05.20,Default,,0,0,0,,Ал Менма...
Dialogue: 0,0:18:05.33,0:18:06.41,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:07.33,0:18:09.12,Default,,0,0,0,,Хехе, эй
Dialogue: 0,0:18:10.67,0:18:11.75,Default,,0,0,0,,(жылжымалы есіктің ашылу дыбысы)
Dialogue: 0,0:18:13.59,0:18:14.71,Default,,0,0,0,,Мен
Dialogue: 0,0:18:16.01,0:18:19.55,Default,,0,0,0,,Мен сені жазғы күннің астына күштеп алып шықтым.
Dialogue: 0,0:18:22.93,0:18:23.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:24.06,0:18:26.31,Default,,0,0,0,,О, Яббе, осыншама ұзақ па?
Dialogue: 0,0:18:30.02,0:18:32.82,Default,,0,0,0,,Содан бері көп нәрсе болды.
Dialogue: 0,0:18:34.78,0:18:36.28,Default,,0,0,0,,Мені сен тартып алдың
Dialogue: 0,0:18:37.40,0:18:39.91,Default,,0,0,0,,Жоқ... Мен одан мені тартуын өтіндім.
Dialogue: 0,0:18:41.99,0:18:45.49,Default,,0,0,0,,Сонда да бес жыл өте ұзақ уақыт.
Dialogue: 0,0:18:46.79,0:18:49.62,Default,,0,0,0,,Әркімнің өз тілегін орындауы мүмкін емес...
Dialogue: 0,0:18:51.04,0:18:52.21,Default,,0,0,0,,Қаш
Dialogue: 0,0:18:54.25,0:18:55.50,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:56.13,0:18:57.59,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:57.71,0:19:00.43,Default,,0,0,0,,Менма өз тілегін орындау үшін қайтып келеді.
Dialogue: 0,0:19:01.51,0:19:05.47,Default,,0,0,0,,Алдымен Поппо сіздің келгеніңізге сенді.
Dialogue: 0,0:19:10.98,0:19:12.31,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:19:13.69,0:19:17.28,Default,,0,0,0,,Менің ішімде бірдеңе тұрып қалғаны анық...
Dialogue: 0,0:19:17.57,0:19:19.49,Default,,0,0,0,,Мен қайтадан қозғала бастағандай болдым.
Dialogue: 0,0:19:19.99,0:19:21.61,Default,,0,0,0,,Дүкен менеджерін ауыстыру
Dialogue: 0,0:19:21.74,0:19:22.82,Default,,0,0,0,,Ой
Dialogue: 0,0:19:28.16,0:19:30.66,Default,,0,0,0,,Менма! Сіз тамақ жеп жатырсыз ба?
Dialogue: 0,0:19:30.79,0:19:33.13,Default,,0,0,0,,Ой, бұл біртүрлі
Dialogue: 0,0:19:33.25,0:19:35.50,Default,,0,0,0,,Мүмкін мен қайта туылған шығармын.
Dialogue: 0,0:19:36.67,0:19:37.80,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:19:37.92,0:19:40.63,Default,,0,0,0,,Жақын жерде болсаңыз, маған қоңырау шалыңыз.
Dialogue: 0,0:19:43.09,0:19:44.43,Default,,0,0,0,,Әрқашан велосипедте—
Dialogue: 0,0:19:44.55,0:19:48.22,Default,,0,0,0,,Мен Бабунмен бірге жүгіремін!
Dialogue: 0,0:19:48.35,0:19:51.89,Default,,0,0,0,,Аа, бірақ мен саған сәби кезімде телефон соға алмаймын.
Dialogue: 0,0:19:52.02,0:19:54.10,Default,,0,0,0,,Мен теруді баса алмаймын.
Dialogue: 0,0:19:54.48,0:19:55.69,Default,,0,0,0,,Ондай жағдайда ана...
Dialogue: 0,0:19:55.81,0:19:59.44,Default,,0,0,0,,Сізге қоңырау шалуымды сұрай аласыз ба?
Dialogue: 0,0:20:00.94,0:20:02.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:03.74,0:20:06.91,Default,,0,0,0,,Қызық... иә?
Dialogue: 0,0:20:09.70,0:20:13.79,Default,,0,0,0,,Менма, осы уақытқа дейін кешірім сұраймын.
Dialogue: 0,0:20:14.75,0:20:19.50,Default,,0,0,0,,Ішіне көптен бері гүл салып жүрмін.
Dialogue: 0,0:20:19.80,0:20:25.89,Default,,0,0,0,,Сол күні сен барған жерде жайқалған гүл
Dialogue: 0,0:20:29.68,0:20:34.90,Default,,0,0,0,,Мен қорқамын, мен қорқамын
Dialogue: 0,0:20:35.85,0:20:37.65,Default,,0,0,0,,Ештеңе істеу мүмкін болмады
Dialogue: 0,0:20:43.61,0:20:46.87,Default,,0,0,0,,Оны киюде бір нәрсе бар...
Dialogue: 0,0:20:46.99,0:20:51.54,Default,,0,0,0,,Бұл өзімнің жазам деп ойладым.
Dialogue: 0,0:20:52.54,0:20:53.91,Default,,0,0,0,,Жасыру, солай ма?
Dialogue: 0,0:20:54.21,0:20:58.13,Default,,0,0,0,,Мен сені қорқынышты құдай деп ойладым.
Dialogue: 0,0:20:59.13,0:21:01.76,Default,,0,0,0,,Мен сізден кешірім сұрағым келді
Dialogue: 0,0:21:02.34,0:21:06.01,Default,,0,0,0,,Сондықтан мен Менмаға осында екенімді айта бастадым.
Dialogue: 0,0:21:06.13,0:21:08.89,Default,,0,0,0,,Шынымды айтсам, мен бақытты болдым.
Dialogue: 0,0:21:10.31,0:21:15.19,Default,,0,0,0,,Джинтанның айтқанына 100% сенбедім.
Dialogue: 0,0:21:15.73,0:21:20.44,Default,,0,0,0,,Менма туралы үнемі ойлайтын жалғыз мен емес екенмін.
Dialogue: 0,0:21:20.94,0:21:22.69,Default,,0,0,0,,Сіз бақытты болған шығарсыз.
Dialogue: 0,0:21:23.36,0:21:24.74,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:25.74,0:21:29.07,Default,,0,0,0,,Мәңгі, Мен Менманы көре алмаймын
Dialogue: 0,0:21:29.95,0:21:33.95,Default,,0,0,0,,Менма әлі маған ашулы.
Dialogue: 0,0:21:34.75,0:21:37.96,Default,,0,0,0,,Сондықтан мен оны көре алмайтын шығармын.
Dialogue: 0,0:21:38.08,0:21:39.21,Default,,0,0,0,,Содан кейін—
Dialogue: 0,0:21:41.09,0:21:42.84,Default,,0,0,0,,Мен ренжіп барамын...
Dialogue: 0,0:21:44.01,0:21:46.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:50.39,0:21:53.47,Default,,0,0,0,,Сен неге менің үйімде тамақ ішесің?
Dialogue: 0,0:21:53.60,0:21:56.06,Default,,0,0,0,,Жабайы көкөністерді ұсынбадың ба?
Dialogue: 0,0:21:56.23,0:21:59.02,Default,,0,0,0,,Хмм, бұл сөзсіз темпура.
Dialogue: 0,0:21:59.48,0:22:02.36,Default,,0,0,0,,Поппо Сіз дәмді жейсіз, солай емес пе?
Dialogue: 0,0:22:02.48,0:22:04.03,Default,,0,0,0,,Мұрынның үстіңгі жағы лас.
Dialogue: 0,0:22:04.15,0:22:05.15,Default,,0,0,0,,О
Dialogue: 0,0:22:05.94,0:22:07.99,Default,,0,0,0,,Аа, дұрыс. Менмай осында ма?
Dialogue: 0,0:22:08.45,0:22:10.70,Default,,0,0,0,,Иә, мен осындамын.
Dialogue: 0,0:22:10.82,0:22:12.41,Default,,0,0,0,,Менманы да же, темпура
Dialogue: 0,0:22:12.53,0:22:13.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:14.70,0:22:15.66,Default,,0,0,0,,…ең жақсы нұсқа!
Dialogue: 0,0:22:16.37,0:22:18.67,Default,,0,0,0,,Сіз Менмага шындап сенесіз бе?
Dialogue: 0,0:22:18.79,0:22:21.34,Default,,0,0,0,,Мен саған өткен күні айтпадым ба?
Dialogue: 0,0:22:21.54,0:22:22.38,Default,,0,0,0,,Бірақ
Dialogue: 0,0:22:24.46,0:22:26.80,Default,,0,0,0,,Мен бұл туралы тағы да ойладым.
Dialogue: 0,0:22:26.92,0:22:27.80,Default,,0,0,0,,О
Dialogue: 0,0:22:27.92,0:22:31.55,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ Менманың осында болуының өзі...
Dialogue: 0,0:22:31.89,0:22:33.14,Default,,0,0,0,,Жақсы нәрсе емес шығар.
Dialogue: 0,0:22:33.51,0:22:34.47,Default,,0,0,0,,Ах
Dialogue: 0,0:22:34.60,0:22:36.89,Default,,0,0,0,,Сіз Буддалыққа жете алмайсыз.
Dialogue: 0,0:22:37.93,0:22:39.60,Default,,0,0,0,,Міне, сондықтан емес пе?
Dialogue: 0,0:22:39.98,0:22:42.15,Default,,0,0,0,,Буддалық…
Dialogue: 0,0:22:44.19,0:22:46.32,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,0:22:46.49,0:22:48.07,Default,,0,0,0,,Міне... Солай.
Dialogue: 0,0:22:48.24,0:22:49.07,Default,,0,0,0,,Джинтан?
Dialogue: 0,0:22:49.20,0:22:50.36,Default,,0,0,0,,Менма!
Dialogue: 0,0:22:51.07,0:22:51.99,Default,,0,0,0,,Менма, сен сондасың ба?
Dialogue: 0,0:22:52.12,0:22:54.12,Default,,0,0,0,,Е, а, анау...
Dialogue: 0,0:22:54.24,0:22:55.79,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:22:55.95,0:22:56.79,Default,,0,0,0,,ше? Эй...
Dialogue: 0,0:22:56.91,0:22:58.41,Default,,0,0,0,,Сәлем Менма
Dialogue: 0,0:22:58.54,0:23:01.00,Default,,0,0,0,,Кішкене болса да, Хинт-кун?
Dialogue: 0,0:23:01.12,0:23:01.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:02.33,0:23:04.92,Default,,0,0,0,,Мен покупокучинмін.
Dialogue: 0,0:23:05.71,0:23:07.51,Default,,0,0,0,,Қалайсыз, солай ма?
Dialogue: 0,0:23:07.84,0:23:10.59,Default,,0,0,0,,Эй, сен де маған сене аласың.
Dialogue: 0,0:23:10.72,0:23:14.05,Default,,0,0,0,,Мен сізге Буддалыққа жетуге көмектесе аламын.
Dialogue: 0,0:23:14.18,0:23:16.77,Default,,0,0,0,,Сәлем Хисакава Эй Менма
Dialogue: 0,0:23:17.43,0:23:19.18,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:23:19.31,0:23:22.06,Default,,0,0,0,,Бірақ бұл тек Цзиньтан ғана емес.
Dialogue: 0,0:23:22.19,0:23:24.19,Default,,0,0,0,,Менің де алдымнан шығуыңызды өтінемін.
Dialogue: 0,0:23:24.98,0:23:26.48,Default,,0,0,0,,Жоқ? Эй
Dialogue: 0,0:23:26.61,0:23:27.90,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:23:30.07,0:23:34.74,Default,,0,0,0,,Мен барлығымен менма туралы сөйлескім келеді.
Dialogue: 0,0:23:37.24,0:23:39.37,Default,,0,0,0,,Бірақ мен түсінбеймін.
Dialogue: 0,0:23:39.50,0:23:40.33,Default,,0,0,0,,Барлығы бірге...
Dialogue: 0,0:23:40.46,0:23:42.04,Default,,0,0,0,,Өтініш...
Dialogue: 0,0:23:42.46,0:23:44.75,Default,,0,0,0,,Буддалық немесе соған ұқсас нәрсе
Dialogue: 0,0:23:45.38,0:23:46.55,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:23:46.67,0:23:47.96,Default,,0,0,0,,Сәлем, жарай ма?
Dialogue: 0,0:23:48.09,0:23:50.38,Default,,0,0,0,,Өтінемін, бәріміз ойланайық.
Dialogue: 0,0:23:50.51,0:23:52.18,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:23:52.55,0:23:53.47,Default,,0,0,0,,Сонда Менма бар...
Dialogue: 0,0:23:53.59,0:23:54.51,Default,,0,0,0,,Поппо!
Dialogue: 0,0:23:55.18,0:24:00.23,Default,,0,0,0,,(Менманың жылауы)
Dialogue: 0,0:24:00.35,0:24:01.81,Default,,0,0,0,,Сіз мұны тоқтата аласыз ба?
Dialogue: 0,0:24:02.56,0:24:03.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:06.57,0:24:09.61,Default,,0,0,0,,Өтінемін, тоқтатыңыз.
Dialogue: 0,0:24:12.32,0:24:13.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:14.82,0:24:17.58,Default,,0,0,0,,Мен кешірім сұрағым келген кезде
Dialogue: 0,0:24:17.91,0:24:23.46,Default,,0,0,0,,Мен сені одан сайын қайғырдым.
Dialogue: 0,0:24:26.33,0:24:29.38,Default,,0,0,0,,Бұл шынымен аянышты оқиға.
Dialogue: 0,0:24:29.50,0:24:30.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:36.60,0:24:38.47,Default,,0,0,0,,Бүгінгі үйірме жұмыстарынан кейін сізде бір нәрсе бар ма?
Dialogue: 0,0:24:38.60,0:24:39.43,Default,,0,0,0,,Бөлек
Dialogue: 0,0:24:39.56,0:24:41.22,Default,,0,0,0,,Эй, күте тұрыңыз...
Dialogue: 0,0:24:41.35,0:24:42.31,Default,,0,0,0,,Ах, ханзада
Dialogue: 0,0:24:42.43,0:24:43.44,Default,,0,0,0,,Ханзада?
Dialogue: 0,0:24:43.56,0:24:46.65,Default,,0,0,0,,Қараңызшы, бірінші жылы өсек болған, екінші жылы
Dialogue: 0,0:24:46.77,0:24:47.69,Default,,0,0,0,,О, бұл
Dialogue: 0,0:24:47.81,0:24:49.77,Default,,0,0,0,,Е, бұл қауіпті емес пе?
Dialogue: 0,0:24:49.90,0:24:51.23,Default,,0,0,0,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,0:24:51.36,0:24:53.32,Default,,0,0,0,,Білсең, ұрысады.
Dialogue: 0,0:24:53.45,0:24:54.74,Default,,0,0,0,,Менма
Dialogue: 0,0:24:55.49,0:24:58.91,Default,,0,0,0,,Сіз маған еңбекқор екенімді айттыңыз, бірақ...
Dialogue: 0,0:24:59.49,0:25:02.50,Default,,0,0,0,,Шынымды айтсам, мен мүлдем сергек емеспін.
Dialogue: 0,0:25:03.25,0:25:05.79,Default,,0,0,0,,Соңғы кездері көп жүгірмеймін.
Dialogue: 0,0:25:06.54,0:25:09.75,Default,,0,0,0,,Бірақ бұл да жаман емес деп ойлаймын.
Dialogue: 0,0:25:10.71,0:25:12.34,Default,,0,0,0,,Енді ойлаймын
Dialogue: 0,0:25:13.22,0:25:18.35,Default,,0,0,0,,Мүмкін мен жүгіріп құтылғым келген шығар.
Dialogue: 0,0:25:19.39,0:25:22.35,Default,,0,0,0,,Сенсіз... шындықтан
Dialogue: 0,0:25:23.98,0:25:24.81,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:25:29.36,0:25:30.48,Default,,0,0,0,,Ах
Dialogue: 0,0:25:30.61,0:25:31.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:31.86,0:25:34.24,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:25:41.83,0:25:42.99,Default,,0,0,0,,Джинтан!
Dialogue: 0,0:25:44.50,0:25:45.58,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:25:45.71,0:25:46.54,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:25:50.84,0:25:51.96,Default,,0,0,0,,Кук
Dialogue: 0,0:25:53.55,0:25:55.51,Default,,0,0,0,,Ю… Юкиацу
Dialogue: 0,0:26:00.39,0:26:02.72,Default,,0,0,0,,Абайлаңыз, Цзиньтан
Dialogue: 0,0:26:03.89,0:26:05.77,Default,,0,0,0,,Уау, Ядуми?
Dialogue: 0,0:26:06.10,0:26:07.27,Default,,0,0,0,,Жарайды
Dialogue: 0,0:26:13.36,0:26:14.40,Default,,0,0,0,,Юкиацу
Dialogue: 0,0:26:15.53,0:26:17.78,Default,,0,0,0,,Бұл көйлек...
Dialogue: 0,0:26:19.41,0:26:21.53,Default,,0,0,0,,Менма киген киімге ұқсас...
Dialogue: 0,0:26:23.41,0:26:26.54,Default,,0,0,0,,Қалай... неге олай киініп жүрсің?
Dialogue: 0,0:26:28.87,0:26:31.46,Default,,0,0,0,,Ум... жақсысың ба?
Dialogue: 0,0:26:33.42,0:26:36.13,Default,,0,0,0,,Жақсысың ба... көресің бе?
Dialogue: 0,0:26:42.43,0:26:44.56,Default,,0,0,0,,Мұқият қараңыз!
Dialogue: 0,0:26:44.68,0:26:46.52,Default,,0,0,0,,Сәлем Юкиацу
Dialogue: 0,0:26:48.23,0:26:49.98,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:26:50.10,0:26:52.19,Default,,0,0,0,,О, бірақ... бірақ
Dialogue: 0,0:26:52.31,0:26:53.65,Default,,0,0,0,,Бұл мүмкіндік.
Dialogue: 0,0:26:53.77,0:26:57.53,Default,,0,0,0,,Егер мен мұны өткізіп алсам, мен сенімдімін ...
Dialogue: 0,0:26:57.90,0:26:58.86,Default,,0,0,0,,Цуруко
Dialogue: 0,0:27:03.28,0:27:06.66,Default,,0,0,0,,Эй, сен Менмаға ұқсайсың ба?
Dialogue: 0,0:27:06.79,0:27:09.25,Default,,0,0,0,,Сіз Менманы көре аласыз, солай ма?
Dialogue: 0,0:27:09.96,0:27:12.00,Default,,0,0,0,,Мен Менмаға ұқсаймын ба?
Dialogue: 0,0:27:12.13,0:27:13.54,Default,,0,0,0,,Юкиацу... Сіз дұрыс көре аласыз ба?
Dialogue: 0,0:27:15.34,0:27:16.96,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:27:17.67,0:27:21.47,Default,,0,0,0,,Менманың сол күні қайтыс болуына менің кінәм болды.
Dialogue: 0,0:27:22.47,0:27:23.60,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:27:23.72,0:27:25.76,Default,,0,0,0,,Бұл сенің кінәң емес! Бұл менің кінәм...
Dialogue: 0,0:27:25.89,0:27:27.85,Default,,0,0,0,,Сіз бұл менің кінәм деп жатқан шығарсыз!
Dialogue: 0,0:27:28.52,0:27:30.69,Default,,0,0,0,,Менмаға бұлай айтпасам...
Dialogue: 0,0:27:30.94,0:27:32.40,Default,,0,0,0,,Менма өлген жоқ
Dialogue: 0,0:27:32.94,0:27:35.48,Default,,0,0,0,,Мен Менманың өліміне себепкер болдым!
Dialogue: 0,0:27:39.57,0:27:42.61,Default,,0,0,0,,Менма пайда болса, менің алдымда болар еді.
Dialogue: 0,0:27:42.82,0:27:45.08,Default,,0,0,0,,Бетперде болсам да, Қарғыс айтсам да
Dialogue: 0,0:27:45.49,0:27:46.33,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:27:46.79,0:27:48.62,Default,,0,0,0,,Менің алдымда!
Dialogue: 0,0:27:52.83,0:27:56.34,Default,,0,0,0,,Бірақ Менма көрінбеді.
Dialogue: 0,0:27:58.51,0:27:59.88,Default,,0,0,0,,Менің алдымда
Dialogue: 0,0:28:00.84,0:28:01.76,Default,,0,0,0,,Юкиацу
Dialogue: 0,0:28:01.88,0:28:04.64,Default,,0,0,0,,Сондықтан Менма енді жоқ.
Dialogue: 0,0:28:05.01,0:28:07.60,Default,,0,0,0,,Ол еш жерде жоқ!
Dialogue: 0,0:28:08.06,0:28:11.85,Default,,0,0,0,,(Юкиацу жылап жатыр)
Dialogue: 0,0:28:11.98,0:28:12.81,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:28:20.61,0:28:24.36,Default,,0,0,0,,Менма өзінің осында екенін айтады.
Dialogue: 0,0:28:25.70,0:28:28.87,Default,,0,0,0,,Сіз әлі де солайсыз...
Dialogue: 0,0:28:30.54,0:28:31.62,Default,,0,0,0,,Мен... Менмага—
Dialogue: 0,0:28:32.37,0:28:35.33,Default,,0,0,0,,«Патчин» үшін Юкиацуға рахмет
Dialogue: 0,0:28:37.38,0:28:39.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:28:42.26,0:28:46.01,Default,,0,0,0,,А... білесің бе, мен шынымен түсінбеймін.
Dialogue: 0,0:28:46.72,0:28:47.55,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:28:47.68,0:28:48.51,Default,,0,0,0,,Ах
Dialogue: 0,0:28:48.64,0:28:50.18,Default,,0,0,0,,Юкиацу?
Dialogue: 0,0:28:50.52,0:28:54.81,Default,,0,0,0,,Мен саған бір күні берген «Пачин» туралы.
Dialogue: 0,0:28:56.73,0:28:58.61,Default,,0,0,0,,Менің сүйікті Менма!
Dialogue: 0,0:28:59.23,0:29:00.23,Default,,0,0,0,,Га
Dialogue: 0,0:29:09.33,0:29:10.58,Default,,0,0,0,,Кешіріңіз! иә?
Dialogue: 0,0:29:11.08,0:29:13.00,Default,,0,0,0,,Мен... Мен барайын деп жатырмын.
Dialogue: 0,0:29:13.58,0:29:16.04,Default,,0,0,0,,Менма Цзинтан мен сені қууым керек...
Dialogue: 0,0:29:16.17,0:29:18.17,Default,,0,0,0,,Ал...кейін кездескенше!
Dialogue: 0,0:29:19.71,0:29:20.80,Default,,0,0,0,,Менма
Dialogue: 0,0:29:20.92,0:29:24.38,Default,,0,0,0,,Мен сенің барыңды білемін
Dialogue: 0,0:29:24.76,0:29:27.09,Default,,0,0,0,,Бұл мені қатты сендірді, мен жоқ дедім.
Dialogue: 0,0:29:27.72,0:29:30.51,Default,,0,0,0,,Ал мен...
Dialogue: 0,0:29:33.89,0:29:36.52,Default,,0,0,0,,Мен Джинтанды ешқашан жеңе алмаймын
Dialogue: 0,0:29:38.40,0:29:39.36,Default,,0,0,0,,Иә
Dialogue: 0,0:29:40.40,0:29:43.57,Default,,0,0,0,,Бұндай сөздерді мысқылдап айту ренжітеді.
Dialogue: 0,0:29:43.69,0:29:45.28,Default,,0,0,0,,Цуруко маған айтты
Dialogue: 0,0:29:45.99,0:29:49.95,Default,,0,0,0,,Анару, мен танымал бола алмайтын түрім екені анық.
Dialogue: 0,0:29:50.41,0:29:51.74,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:29:51.87,0:29:53.04,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:29:54.87,0:29:55.91,Default,,0,0,0,,Ах
Dialogue: 0,0:29:56.12,0:29:57.96,Default,,0,0,0,,Қараңдар! Ендеше тоқтайық
Dialogue: 0,0:29:58.08,0:29:59.88,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,0:30:00.00,0:30:01.63,Default,,0,0,0,,Мм... шынымен.
Dialogue: 0,0:30:01.84,0:30:02.88,Default,,0,0,0,,Мм...
Dialogue: 0,0:30:03.00,0:30:04.05,Default,,0,0,0,,Тыныш
Dialogue: 0,0:30:04.17,0:30:05.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:07.76,0:30:10.01,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:30:11.26,0:30:12.47,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:30:12.60,0:30:15.14,Default,,0,0,0,,Уау! Сізге көп рахмет
Dialogue: 0,0:30:15.27,0:30:16.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:16.81,0:30:19.98,Default,,0,0,0,,Қараңызшы, бұл өте керемет, солай емес пе?
Dialogue: 0,0:30:32.45,0:30:33.91,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:30:34.04,0:30:34.91,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:30:36.29,0:30:38.71,Default,,0,0,0,,Жазғы демалыс екеніне таң қалдым.
Dialogue: 0,0:30:38.83,0:30:40.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:30:40.71,0:30:43.84,Default,,0,0,0,,Мектепке не үшін бару керек? Сіз әлі хат жаздыңыз ба?
Dialogue: 0,0:30:44.00,0:30:45.88,Default,,0,0,0,,А, кітапханада.
Dialogue: 0,0:30:46.88,0:30:50.22,Default,,0,0,0,,Үйде жалғыз жазып отырсам, жылап жіберетіндей боламын.
Dialogue: 0,0:30:50.34,0:30:51.59,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:30:53.05,0:30:54.10,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:30:54.22,0:30:56.35,Default,,0,0,0,,Мен оны баяғыда жазғанмын
Dialogue: 0,0:30:56.47,0:30:57.68,Default,,0,0,0,,Хмм.
Dialogue: 0,0:30:59.27,0:31:01.31,Default,,0,0,0,,Маған жақындама, иә?
Dialogue: 0,0:31:02.11,0:31:04.23,Default,,0,0,0,,Жақын келме
Dialogue: 0,0:31:08.32,0:31:09.53,Default,,0,0,0,,Ахсо
Dialogue: 0,0:31:10.11,0:31:10.95,Default,,0,0,0,,Ах
Dialogue: 0,0:31:12.03,0:31:13.12,Default,,0,0,0,,Иә
Dialogue: 0,0:31:13.32,0:31:14.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:15.74,0:31:18.12,Default,,0,0,0,,Менің аяғым ұзын емес пе?
Dialogue: 0,0:31:18.25,0:31:20.62,Default,,0,0,0,,Мен бұған да біраз түс қостым деп ойладым.
Dialogue: 0,0:31:20.75,0:31:22.33,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:31:22.50,0:31:24.00,Default,,0,0,0,,Жалғастырыңыз
Dialogue: 0,0:31:24.17,0:31:27.05,Default,,0,0,0,,Мен мұны тағы да жасаймын
Dialogue: 0,0:31:27.38,0:31:29.97,Default,,0,0,0,,Түсіндім, сосын алға.
Dialogue: 0,0:31:30.72,0:31:31.76,Default,,0,0,0,,Ах
Dialogue: 0,0:31:33.14,0:31:35.68,Default,,0,0,0,,Бұл сурет өте жақсы.
Dialogue: 0,0:31:37.10,0:31:38.10,Default,,0,0,0,,Nja
Dialogue: 0,0:31:38.22,0:31:39.68,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:31:45.73,0:31:47.03,Default,,0,0,0,,Аа...
Dialogue: 0,0:31:49.82,0:31:51.82,Default,,0,0,0,,Сәлем Менма
Dialogue: 0,0:31:52.32,0:31:56.41,Default,,0,0,0,,Сіз менің суреттерімді үнемі мақтап отырдыңыз.
Dialogue: 0,0:31:56.95,0:32:01.79,Default,,0,0,0,,Иә, мен сурет салғанды ​​жақсы көретінмін.
Dialogue: 0,0:32:02.42,0:32:05.67,Default,,0,0,0,,Бірақ сіз қанша тырыссаңыз да,
Dialogue: 0,0:32:06.13,0:32:10.42,Default,,0,0,0,,Белгілі бір деңгейден асып түсуге қабілетім жоқ екенін түсіндім.
Dialogue: 0,0:32:11.13,0:32:14.09,Default,,0,0,0,,Сондықтан мен бағытты тез өзгерттім.
Dialogue: 0,0:32:14.39,0:32:18.77,Default,,0,0,0,,Мен әрі қарай сурет салуды жалғастырсам, ештеңе қалмайды.
Dialogue: 0,0:32:21.06,0:32:22.23,Default,,0,0,0,,Хмм.
Dialogue: 0,0:32:22.85,0:32:23.77,Default,,0,0,0,,Ах
Dialogue: 0,0:32:24.90,0:32:27.19,Default,,0,0,0,,Мен әрқашан тым көп ойлаймын
Dialogue: 0,0:32:27.32,0:32:29.65,Default,,0,0,0,,Алдымен нәтижелерді беру
Dialogue: 0,0:32:30.32,0:32:32.11,Default,,0,0,0,,Юкиацу туралы да
Dialogue: 0,0:32:32.61,0:32:36.32,Default,,0,0,0,,Мен сені әрқашан жақсы көрдім, бірақ мен...
Dialogue: 0,0:32:36.45,0:32:38.28,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:32:38.45,0:32:39.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:32:40.75,0:32:43.08,Default,,0,0,0,,Менма жеңуге мүмкіндік жоқ дейді.
Dialogue: 0,0:32:44.17,0:32:47.50,Default,,0,0,0,,Осыдан кейін, тіпті Менма кетсе де—
Dialogue: 0,0:32:49.09,0:32:53.05,Default,,0,0,0,,Мен сенің жаныңда болуым керек
Dialogue: 0,0:32:53.88,0:32:57.47,Default,,0,0,0,,Сіз шынымен де осыны қалайсыз деп ойлау
Dialogue: 0,0:33:01.68,0:33:04.35,Default,,0,0,0,,Өйткені сол кезде—
Dialogue: 0,0:33:05.77,0:33:09.40,Default,,0,0,0,,Мен сенімдімін... Мен зардап шекпеймін.
Dialogue: 0,0:33:11.78,0:33:15.82,Default,,0,0,0,,Мен сіздің қайтып келгеніңізді естігенде,
Dialogue: 0,0:33:16.41,0:33:20.24,Default,,0,0,0,,Мен өзімді сілкілеуден қорықтым
Dialogue: 0,0:33:20.91,0:33:22.08,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:33:26.75,0:33:28.29,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:33:28.42,0:33:32.26,Default,,0,0,0,,Барлығы сізге шындап сене бастады.
Dialogue: 0,0:33:33.34,0:33:35.93,Default,,0,0,0,,Сіз! Қандай жақсы орта?
Dialogue: 0,0:33:36.05,0:33:37.47,Default,,0,0,0,,Шайқау
Dialogue: 0,0:33:38.85,0:33:39.89,Default,,0,0,0,,Дәл солай. Өте ықтимал.
Dialogue: 0,0:33:42.39,0:33:43.52,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:33:43.85,0:33:47.06,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:33:48.19,0:33:49.48,Default,,0,0,0,,Иә
Dialogue: 0,0:33:49.61,0:33:52.03,Default,,0,0,0,,Не болды? Сіз хат жаза алдыңыз ба?
Dialogue: 0,0:33:52.15,0:33:55.19,Default,,0,0,0,,Әлі де… жазу.
Dialogue: 0,0:33:55.86,0:33:57.03,Default,,0,0,0,,Ахсо
Dialogue: 0,0:33:57.70,0:33:58.91,Default,,0,0,0,,Сәлем Цуруко
Dialogue: 0,0:34:00.16,0:34:03.33,Default,,0,0,0,,Менмаға бірдеңе айтқым келеді.
Dialogue: 0,0:34:03.54,0:34:05.37,Default,,0,0,0,,Иә? О
Dialogue: 0,0:34:05.54,0:34:09.13,Default,,0,0,0,,Бірақ мен Менмаға айта алсам да...
Dialogue: 0,0:34:09.25,0:34:11.38,Default,,0,0,0,,Ақыр соңында, мен оларға бұл жерде айта алмаймын.
Dialogue: 0,0:34:11.71,0:34:14.71,Default,,0,0,0,,Мына жақта, Джинтан?
Dialogue: 0,0:34:17.43,0:34:21.55,Default,,0,0,0,,Сіз оны жасыра бересіз және қайта біртүрлі өзін-өзі жоймайсыз деп үміттенемін.
Dialogue: 0,0:34:21.68,0:34:23.68,Default,,0,0,0,,«Біртүрлі өзін-өзі жою»
Dialogue: 0,0:34:23.93,0:34:25.73,Default,,0,0,0,,Сонымен қатар Цурукоға не болды?
Dialogue: 0,0:34:25.89,0:34:27.19,Default,,0,0,0,,Не болды?
Dialogue: 0,0:34:27.35,0:34:29.52,Default,,0,0,0,,Мен Юкиацуға қатты дауыспен айттым.
Dialogue: 0,0:34:29.65,0:34:31.02,Default,,0,0,0,,Бұл дөрекі сөз.
Dialogue: 0,0:34:31.15,0:34:32.65,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:34:34.86,0:34:38.07,Default,,0,0,0,,Ал, мен бұл туралы сенімді емеспін... Менің ойымша
Dialogue: 0,0:34:38.53,0:34:39.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:34:39.91,0:34:42.45,Default,,0,0,0,,Жарайды, оған көмектесу мүмкін емес.
Dialogue: 0,0:34:42.70,0:34:44.74,Default,,0,0,0,,Мен қараңғы жаққа көбірек құлаймын ...
Dialogue: 0,0:34:44.87,0:34:47.75,Default,,0,0,0,,Юкиацу Менма маған ұнады.
Dialogue: 0,0:34:48.16,0:34:49.12,Default,,0,0,0,,Иә
Dialogue: 0,0:34:50.42,0:34:52.50,Default,,0,0,0,,Бірақ бұл оңайырақ болды.
Dialogue: 0,0:34:52.63,0:34:55.00,Default,,0,0,0,,Иә, оңай ма?
Dialogue: 0,0:34:55.46,0:34:56.30,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:34:56.42,0:34:58.26,Default,,0,0,0,,Бұл қазірдің өзінде ұзақ
Dialogue: 0,0:34:58.47,0:35:01.09,Default,,0,0,0,,Жақын арада баруға дайындалмасаңыз, уақытында үлгермеуіңіз мүмкін.
Dialogue: 0,0:35:01.26,0:35:03.30,Default,,0,0,0,,Не? Сіз де асығыңыз
Dialogue: 0,0:35:03.43,0:35:05.89,Default,,0,0,0,,А... Иә, сонда.
Dialogue: 0,0:35:14.77,0:35:18.07,Default,,0,0,0,,Құрметті Менма, хатыңызға рахмет.
Dialogue: 0,0:35:18.61,0:35:20.15,Default,,0,0,0,,Менма - мен
Dialogue: 0,0:35:20.28,0:35:23.41,Default,,0,0,0,,Сіз мені берік адам деп айттыңыз.
Dialogue: 0,0:35:23.53,0:35:26.87,Default,,0,0,0,,Бірақ мен өзім олай ойламаймын.
Dialogue: 0,0:35:27.41,0:35:29.83,Default,,0,0,0,,Мен ылғи теңселіп жүремін.
Dialogue: 0,0:35:30.87,0:35:34.71,Default,,0,0,0,,Менма әрқашан адамдарға тура қарайды, солай ма?
Dialogue: 0,0:35:35.50,0:35:37.80,Default,,0,0,0,,Мен мұны қызғандым.
Dialogue: 0,0:35:38.55,0:35:40.42,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:35:41.22,0:35:45.56,Default,,0,0,0,,Маңызды нәрсе туралы неғұрлым көп ойласам, соғұрлым басқа жаққа қараймын.
Dialogue: 0,0:35:47.18,0:35:49.35,Default,,0,0,0,,Менма қайтып келгендіктен...
Dialogue: 0,0:35:49.85,0:35:53.44,Default,,0,0,0,,Мен саған тағы да жақындай алдым.
Dialogue: 0,0:35:58.28,0:36:02.32,Default,,0,0,0,,Мен Менмадан кешірім сұрағым келді, сондықтан сіздің өтінішіңізді қанағаттандыруды ойладым.
Dialogue: 0,0:36:04.12,0:36:05.78,Default,,0,0,0,,Қашаннан бері...
Dialogue: 0,0:36:07.33,0:36:10.29,Default,,0,0,0,,Содан бері I
Dialogue: 0,0:36:15.75,0:36:16.59,Default,,0,0,0,,Иә
Dialogue: 0,0:36:23.38,0:36:25.47,Default,,0,0,0,,А, бұл...мәтін
Dialogue: 0,0:36:25.60,0:36:28.22,Default,,0,0,0,,Бұл қызықты болды ма, әлде көңілді болды ма? Оның еш айырмашылығы жоқ.
Dialogue: 0,0:36:28.39,0:36:29.22,Default,,0,0,0,,Я...
Dialogue: 0,0:36:29.81,0:36:32.69,Default,,0,0,0,,Шығарма жазуға шебер емес еді.
Dialogue: 0,0:36:32.81,0:36:34.94,Default,,0,0,0,,А, бұл сәл басқаша.
Dialogue: 0,0:36:35.10,0:36:37.77,Default,,0,0,0,,«Мен бүгін барлығымен ойнап жүріп құлап қалдым».
Dialogue: 0,0:36:37.90,0:36:39.23,Default,,0,0,0,,«Мен сонда болғым келді».
Dialogue: 0,0:36:39.36,0:36:41.32,Default,,0,0,0,,О, бұл жерде де басқаша.
Dialogue: 0,0:36:41.44,0:36:42.36,Default,,0,0,0,,«Бүгін бәріміз...»
Dialogue: 0,0:36:42.49,0:36:44.24,Default,,0,0,0,,«Мен Джинтанның анасына қонаққа бардым.»
Dialogue: 0,0:36:44.36,0:36:45.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:46.37,0:36:48.20,Default,,0,0,0,,Жанашырлық...?
Dialogue: 0,0:36:49.33,0:36:53.87,Default,,0,0,0,,Айтпақшы, мен ол жерге көп бардым. Барлығы қатты толқыды.
Dialogue: 0,0:36:54.29,0:36:56.71,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,0:36:57.79,0:37:01.55,Default,,0,0,0,,Джинтанның анасы үнемі ауруханада.
Dialogue: 0,0:37:02.01,0:37:04.97,Default,,0,0,0,,Иә! Құдайға хат жіберейік
Dialogue: 0,0:37:05.09,0:37:08.89,Default,,0,0,0,,Джинтанның анасы тезірек сауығып кетуін сұрайды.
Dialogue: 0,0:37:09.01,0:37:09.97,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:37:10.10,0:37:11.43,Default,,0,0,0,,Хмм.
Dialogue: 0,0:37:13.85,0:37:15.31,Default,,0,0,0,,Цзиньтан Бұл!
Dialogue: 0,0:37:15.44,0:37:16.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:19.73,0:37:21.48,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:37:24.57,0:37:27.24,Default,,0,0,0,,А, иә, сол кезде.
Dialogue: 0,0:37:27.91,0:37:29.08,Default,,0,0,0,,Джинтан?
Dialogue: 0,0:37:29.95,0:37:32.79,Default,,0,0,0,,«Біз бірге отшашу жасауға шешім қабылдадық».
Dialogue: 0,0:37:32.91,0:37:34.75,Default,,0,0,0,,«Мен бұл қиын деп ойладым».
Dialogue: 0,0:37:35.00,0:37:37.08,Default,,0,0,0,,«Бірақ мен қолымнан келгеннің бәрін жасаймын».
Dialogue: 0,0:37:37.21,0:37:38.08,Default,,0,0,0,,Ах
Dialogue: 0,0:37:38.21,0:37:39.50,Default,,0,0,0,,Қандай қатыгез қимыл…
Dialogue: 0,0:37:39.63,0:37:43.38,Default,,0,0,0,,Отшашу атылатын зымыранға хат сал, Құдайға жеткіземін.
Dialogue: 0,0:37:43.55,0:37:46.09,Default,,0,0,0,,Сәлем! Бұл емес пе? Өтінемін
Dialogue: 0,0:37:46.22,0:37:48.64,Default,,0,0,0,,Иә! Мен сенімдімін
Dialogue: 0,0:37:48.76,0:37:51.31,Default,,0,0,0,,Сол кезде мен оны жасауға тырыстым, бірақ ол сәтсіз аяқталды.
Dialogue: 0,0:37:51.43,0:37:52.60,Default,,0,0,0,,Сәлем, Ядуми?
Dialogue: 0,0:37:53.22,0:37:56.98,Default,,0,0,0,,Менің... анама
Dialogue: 0,0:38:01.98,0:38:05.36,Default,,0,0,0,,Сол кезде мен түсіндім
Dialogue: 0,0:38:06.24,0:38:09.37,Default,,0,0,0,,Джинтанның сезімі және менің сезімім
Dialogue: 0,0:38:10.20,0:38:12.83,Default,,0,0,0,,Иә? Сіз толық емес жұмыс уақытыңызды қайтадан арттырдыңыз ба?
Dialogue: 0,0:38:12.95,0:38:15.96,Default,,0,0,0,,Ах, Гатен түрі жақсы мәнге ие.
Dialogue: 0,0:38:16.08,0:38:17.96,Default,,0,0,0,,Бозарып кеткен сияқтысыз ба?
Dialogue: 0,0:38:18.08,0:38:19.92,Default,,0,0,0,,Хмм, мен ұйықтамаймын.
Dialogue: 0,0:38:20.04,0:38:21.59,Default,,0,0,0,,Ал, сәл күте тұрыңыз.
Dialogue: 0,0:38:21.71,0:38:24.96,Default,,0,0,0,,Осы уақытқа дейін мен тамақ ішіп, ұйықтап өмір сүрдім.
Dialogue: 0,0:38:25.42,0:38:27.47,Default,,0,0,0,,Ұйқыны үнемдеу көп
Dialogue: 0,0:38:28.80,0:38:30.22,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:38:31.05,0:38:33.81,Default,,0,0,0,,Қалайша қатты жұмыс істей аласың?
Dialogue: 0,0:38:34.93,0:38:36.81,Default,,0,0,0,,Менма туралы көп...
Dialogue: 0,0:38:36.98,0:38:38.44,Default,,0,0,0,,Ах
Dialogue: 0,0:38:40.06,0:38:42.19,Default,,0,0,0,,Эй... Джинтан! ?
Dialogue: 0,0:38:42.94,0:38:44.94,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:38:47.78,0:38:48.74,Default,,0,0,0,,Иә Су
Dialogue: 0,0:38:48.86,0:38:50.45,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:38:50.57,0:38:53.66,Default,,0,0,0,,Сондай-ақ, осы тағамдық қоспаны қазір қабылдаңыз.
Dialogue: 0,0:38:54.95,0:38:56.37,Default,,0,0,0,,Аа...
Dialogue: 0,0:38:57.00,0:38:58.46,Default,,0,0,0,,Мен көп тынышталдым.
Dialogue: 0,0:38:59.12,0:39:00.08,Default,,0,0,0,,Иә
Dialogue: 0,0:39:01.33,0:39:02.38,Default,,0,0,0,,Цзиньтан
Dialogue: 0,0:39:02.50,0:39:03.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:03.79,0:39:05.38,Default,,0,0,0,,Мұны істеуді доғарайық.
Dialogue: 0,0:39:07.63,0:39:10.84,Default,,0,0,0,,Джинтанның жарасы жеткілікті, солай емес пе?
Dialogue: 0,0:39:10.97,0:39:12.76,Default,,0,0,0,,Мұны істеуді доғарайық, жарай ма?
Dialogue: 0,0:39:12.89,0:39:14.10,Default,,0,0,0,,«Осындай нәрсе» дегенді қалай түсінесіңдер?
Dialogue: 0,0:39:14.22,0:39:15.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:15.18,0:39:17.81,Default,,0,0,0,,Мен әлі жұмыс істеймін.
Dialogue: 0,0:39:24.86,0:39:26.15,Default,,0,0,0,,Менің барғым келмейді
Dialogue: 0,0:39:26.28,0:39:28.19,Default,,0,0,0,,Не? Амал жоқ
Dialogue: 0,0:39:29.24,0:39:32.82,Default,,0,0,0,,Сол кезде де мен сенің барғаныңды қаламадым.
Dialogue: 0,0:39:32.95,0:39:34.33,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:39:35.66,0:39:36.87,Default,,0,0,0,,Мен...
Dialogue: 0,0:39:37.66,0:39:40.66,Default,,0,0,0,,Енді сіз өзіңіздің мінезіңіз туралы шынымен жаман нәрсе айтасыз ба?
Dialogue: 0,0:39:40.87,0:39:41.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:41.87,0:39:42.96,Default,,0,0,0,,Сол кезде —
Dialogue: 0,0:39:43.17,0:39:46.92,Default,,0,0,0,,Негізі мен жеңілдеп қалдым.
Dialogue: 0,0:39:47.59,0:39:51.38,Default,,0,0,0,,Менма туралы Джинтан оны ұнатпайтынын айтты.
Dialogue: 0,0:39:51.68,0:39:55.30,Default,,0,0,0,,Мен ең нашармын, бірақ мен аздап қуандым.
Dialogue: 0,0:39:57.26,0:39:58.39,Default,,0,0,0,,Бірақ
Dialogue: 0,0:39:58.89,0:40:00.06,Default,,0,0,0,,Эххе
Dialogue: 0,0:40:00.18,0:40:01.44,Default,,0,0,0,,Ах
Dialogue: 0,0:40:04.73,0:40:06.73,Default,,0,0,0,,Егер сіз осылай жүрсеңіз -
Dialogue: 0,0:40:08.07,0:40:12.24,Default,,0,0,0,,Мен Менманы жақсы көремін деген сияқты емес.
Dialogue: 0,0:40:14.53,0:40:16.33,Default,,0,0,0,,Содан бері ауырады.
Dialogue: 0,0:40:16.95,0:40:18.24,Default,,0,0,0,,Сол сәт
Dialogue: 0,0:40:18.58,0:40:21.12,Default,,0,0,0,,Қуанғаным үшін өзімді кешіре алмаймын.
Dialogue: 0,0:40:21.75,0:40:25.29,Default,,0,0,0,,Мен Менманы ренжіттім, ақыры солай болды.
Dialogue: 0,0:40:25.88,0:40:27.13,Default,,0,0,0,,Цзиньтан...
Dialogue: 0,0:40:28.34,0:40:31.59,Default,,0,0,0,,Джинтанды жақсы көргенім үшін өзімді кешіре алмаймын.
Dialogue: 0,0:40:34.34,0:40:35.76,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:40:36.18,0:40:38.89,Default,,0,0,0,,I… Күткендей.
Dialogue: 0,0:40:46.65,0:40:49.02,Default,,0,0,0,,Сіз бәрібір барасыз ба?
Dialogue: 0,0:40:51.19,0:40:53.11,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,0:40:54.91,0:40:59.03,Default,,0,0,0,,Менма шынымен Джинтанда болса ше!
Dialogue: 0,0:40:59.16,0:41:01.83,Default,,0,0,0,,Егер мен сіздің өтінішіңізді орындасам, Менма жоғалады! ?
Dialogue: 0,0:41:02.91,0:41:05.50,Default,,0,0,0,,Менма жоғалып кетсе жақсы ма?
Dialogue: 0,0:41:05.62,0:41:06.92,Default,,0,0,0,,Маған ұнаса да!
Dialogue: 0,0:41:08.63,0:41:10.63,Default,,0,0,0,,Ай! (Мектеп оқушысы) Ой, қоңырау соғылды.
Dialogue: 0,0:41:11.26,0:41:12.63,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:41:12.76,0:41:13.97,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:41:14.13,0:41:15.84,Default,,0,0,0,,Цзиньтан...
Dialogue: 0,0:41:17.01,0:41:19.97,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:41:21.47,0:41:24.06,Default,,0,0,0,,Менің ақымақ...
Dialogue: 0,0:41:24.39,0:41:26.19,Default,,0,0,0,,Рас
Dialogue: 0,0:41:26.31,0:41:29.06,Default,,0,0,0,,шынымен де
Dialogue: 0,0:41:29.19,0:41:30.32,Default,,0,0,0,,Рас!
Dialogue: 0,0:41:31.82,0:41:33.57,Default,,0,0,0,,Уау, шынымен ақымақ
Dialogue: 0,0:41:33.69,0:41:35.78,Default,,0,0,0,,Сен жақсырақ білесің, ақымақ!
Dialogue: 0,0:41:35.91,0:41:39.33,Default,,0,0,0,,Иә, мен ақымақпын!
Dialogue: 0,0:41:40.87,0:41:42.87,Default,,0,0,0,,Шектеу дегенді білмейсіңдер ғой…
Dialogue: 0,0:41:43.00,0:41:44.29,Default,,0,0,0,,Иә...
Dialogue: 0,0:41:46.25,0:41:48.96,Default,,0,0,0,,А, сен не істеп жатырсың?
Dialogue: 0,0:41:50.46,0:41:52.13,Default,,0,0,0,,Бірақ бұл дұрыс.
Dialogue: 0,0:41:52.92,0:41:55.01,Default,,0,0,0,,Мен ондай ұятты көрдім.
Dialogue: 0,0:41:55.63,0:41:58.51,Default,,0,0,0,,Оны бөлшектеп, жақсы сезінейік
Dialogue: 0,0:41:58.97,0:41:59.80,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,0:42:01.85,0:42:03.68,Default,,0,0,0,,Ахх!
Dialogue: 0,0:42:03.81,0:42:05.85,Default,,0,0,0,,Мен... Кешіріңіз (Әйел тұтынушы) А...
Dialogue: 0,0:42:05.98,0:42:07.77,Default,,0,0,0,,Ах! Картоп - бұл
Dialogue: 0,0:42:07.90,0:42:09.56,Default,,0,0,0,,Аа, кешіріңіз, кешіріңіз.
Dialogue: 0,0:42:09.69,0:42:10.52,Default,,0,0,0,,Мм, орамал...
Dialogue: 0,0:42:10.65,0:42:12.02,Default,,0,0,0,,Жарайды, жас ханым.
Dialogue: 0,0:42:12.15,0:42:12.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:13.48,0:42:16.78,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ өзіңізді көп айыптамаңыз.
Dialogue: 0,0:42:16.90,0:42:18.91,Default,,0,0,0,,Иә, бұл ақымақтық.
Dialogue: 0,0:42:19.03,0:42:21.70,Default,,0,0,0,,Қараңдаршы, біз аманбыз, картоп, солай ма?
Dialogue: 0,0:42:21.83,0:42:24.95,Default,,0,0,0,,Дұрыс, сен ақымақ емессің, ақылды көрінесің.
Dialogue: 0,0:42:25.08,0:42:26.46,Default,,0,0,0,,Шынымен, шынында, эй.
Dialogue: 0,0:42:26.58,0:42:28.67,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:42:34.00,0:42:34.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:36.38,0:42:37.38,Default,,0,0,0,,Хмм.
Dialogue: 0,0:42:38.18,0:42:41.76,Default,,0,0,0,,Менің ойымша, бұл сәл көбірек сияқты.
Dialogue: 0,0:42:46.31,0:42:49.48,Default,,0,0,0,,Мен үнемі абдырап қаламын.
Dialogue: 0,0:42:50.35,0:42:54.23,Default,,0,0,0,,Жоқ, ол кезде жалғыз мен емес едім.
Dialogue: 0,0:42:54.61,0:42:55.44,Default,,0,0,0,,Ах
Dialogue: 0,0:42:57.74,0:42:58.99,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:43:02.28,0:43:05.12,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:43:06.04,0:43:10.37,Default,,0,0,0,,Иә, біз әрқашан адасып қаламыз.
Dialogue: 0,0:43:10.54,0:43:13.75,Default,,0,0,0,,Түсіндім, сол кезде...
Dialogue: 0,0:43:13.88,0:43:18.17,Default,,0,0,0,,Шатасуымды азайтқым келеді, бірдеңе түсінікті болсын.
Dialogue: 0,0:43:20.84,0:43:22.97,Default,,0,0,0,,Олар неге келмейді?
Dialogue: 0,0:43:23.10,0:43:25.35,Default,,0,0,0,,Жарайды, ертең кездесеміз.
Dialogue: 0,0:43:25.85,0:43:27.31,Default,,0,0,0,,Енді бастайық
Dialogue: 0,0:43:27.77,0:43:28.93,Default,,0,0,0,,Мен сізге қоңырау шаламын.
Dialogue: 0,0:43:29.10,0:43:30.64,Default,,0,0,0,,Эй, Поппо
Dialogue: 0,0:43:31.06,0:43:32.27,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:43:32.40,0:43:33.61,Default,,0,0,0,,Цуруко!
Dialogue: 0,0:43:34.82,0:43:36.07,Default,,0,0,0,,Мен тәттілер сатып алдым.
Dialogue: 0,0:43:36.19,0:43:38.57,Default,,0,0,0,,О, айтпақшы, Цуруко!
Dialogue: 0,0:43:38.74,0:43:39.99,Default,,0,0,0,,Шырын да
Dialogue: 0,0:43:40.11,0:43:42.87,Default,,0,0,0,,О! мен сені сүйемін
Dialogue: 0,0:43:42.99,0:43:45.33,Default,,0,0,0,,Уау! Бұл кеш!
Dialogue: 0,0:43:45.45,0:43:51.50,Default,,0,0,0,,(Поппо Менманың көңілді дауысы)
Dialogue: 0,0:43:51.62,0:43:53.21,Default,,0,0,0,,Уа, маған бұл өте ұнайды.
Dialogue: 0,0:43:53.38,0:43:55.46,Default,,0,0,0,,Біз бәріміз біргеміз, иә?
Dialogue: 0,0:43:55.59,0:43:56.84,Default,,0,0,0,,Жоқ
Dialogue: 0,0:43:58.17,0:44:02.05,Default,,0,0,0,,Ақырзаман жақындап келе жатқандай сезіледі.
Dialogue: 0,0:44:05.14,0:44:08.60,Default,,0,0,0,,Иә, Менма-сан екеуміз Super Peace Busters тобын құрдық...
Dialogue: 0,0:44:08.72,0:44:10.02,Default,,0,0,0,,Алғы сөз жақсы
Dialogue: 0,0:44:10.14,0:44:12.90,Default,,0,0,0,,Иә, басты кейіпкер Менма-сан.
Dialogue: 0,0:44:13.02,0:44:13.94,Default,,0,0,0,,Алға жүріңіз
Dialogue: 0,0:44:17.02,0:44:18.86,Default,,0,0,0,,Иә! Хмф
Dialogue: 0,0:44:21.95,0:44:24.16,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:44:38.50,0:44:40.46,Default,,0,0,0,,Бұл Менманың сәлемдесу еді!
Dialogue: 0,0:44:40.59,0:44:43.22,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:44:45.59,0:44:47.18,Default,,0,0,0,,Эй Менма, мынаны жегің келе ме?
Dialogue: 0,0:44:47.30,0:44:50.64,Default,,0,0,0,,Бұл ашық қызыл. Мен ащы тамақты ұнатпаймын, себебі ол ауырады.
Dialogue: 0,0:44:50.81,0:44:52.73,Default,,0,0,0,,Ащы...
Dialogue: 0,0:44:52.85,0:44:54.65,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:44:54.77,0:44:56.36,Default,,0,0,0,,Жарайды, аздап тістеп ал.
Dialogue: 0,0:44:58.11,0:44:59.57,Default,,0,0,0,,Ойын-сауық жоқ па?
Dialogue: 0,0:44:59.69,0:45:00.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:00.90,0:45:03.03,Default,,0,0,0,,Бұл жай ғана ішіп-жеу емес пе?
Dialogue: 0,0:45:03.28,0:45:06.74,Default,,0,0,0,,Бұл митинг, солай ма? Бірдеңе істейік, өйткені бұл үлкен мәселе
Dialogue: 0,0:45:06.87,0:45:08.08,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:45:08.20,0:45:10.16,Default,,0,0,0,,Көңіл көтеру туралы не деуге болады?
Dialogue: 0,0:45:10.29,0:45:11.45,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:45:12.20,0:45:15.42,Default,,0,0,0,,Моккай мен оны сол күні істеймін.
Dialogue: 0,0:45:16.17,0:45:17.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:17.96,0:45:22.05,Default,,0,0,0,,Сол күні осы жерде болған оқиғаны қайта құруға тырысайық.
Dialogue: 0,0:45:23.59,0:45:25.13,Default,,0,0,0,,Мұнда не болды...
Dialogue: 0,0:45:25.76,0:45:26.68,Default,,0,0,0,,Юкиацу
Dialogue: 0,0:45:27.64,0:45:30.01,Default,,0,0,0,,Ақымақ болма! Мұны істеудің мәні неде?
Dialogue: 0,0:45:30.14,0:45:31.35,Default,,0,0,0,,Анару
Dialogue: 0,0:45:37.69,0:45:39.82,Default,,0,0,0,,Бұл... Джинтан.
Dialogue: 0,0:45:39.94,0:45:40.77,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:45:41.65,0:45:45.20,Default,,0,0,0,,Маған Менма ұнайды... неге?
Dialogue: 0,0:45:46.11,0:45:46.95,Default,,0,0,0,,Балалар
Dialogue: 0,0:45:48.20,0:45:51.24,Default,,0,0,0,,Айтыңызшы, Менма да осында, солай ма?
Dialogue: 0,0:45:51.41,0:45:52.62,Default,,0,0,0,,Ашық сөйлеңіз
Dialogue: 0,0:45:53.00,0:45:54.25,Default,,0,0,0,,Юкиацу
Dialogue: 0,0:45:54.96,0:45:56.54,Default,,0,0,0,,Айтыңыз
Dialogue: 0,0:45:57.79,0:46:01.38,Default,,0,0,0,,Айт... айт
Dialogue: 0,0:46:01.88,0:46:05.17,Default,,0,0,0,,Айт... айт
Dialogue: 0,0:46:05.30,0:46:08.05,Default,,0,0,0,,Айт, айт
Dialogue: 0,0:46:08.18,0:46:10.76,Default,,0,0,0,,Эй, мен мұндай нәрсені жасайтыныма сене алар емеспін...
Dialogue: 0,0:46:10.89,0:46:13.72,Default,,0,0,0,,Айт... айт
Dialogue: 0,0:46:14.56,0:46:17.60,Default,,0,0,0,,Айт, айт
Dialogue: 0,0:46:18.35,0:46:22.19,Default,,0,0,0,,Айт, айт
Dialogue: 0,0:46:22.32,0:46:25.28,Default,,0,0,0,,Айт, айт
Dialogue: 0,0:46:26.15,0:46:27.20,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:46:29.16,0:46:30.74,Default,,0,0,0,,Мен Менмамын
Dialogue: 0,0:46:32.12,0:46:34.79,Default,,0,0,0,,Қашып кетсең де солай болады!
Dialogue: 0,0:46:36.54,0:46:39.21,Default,,0,0,0,,(Цзиньтанның ауыр тыныс алуы)
Dialogue: 0,0:46:51.72,0:46:54.72,Default,,0,0,0,,Үнемі адасып жүрген арамызда
Dialogue: 0,0:46:55.02,0:46:57.27,Default,,0,0,0,,Джинтан күшті
Dialogue: 0,0:46:58.48,0:47:01.02,Default,,0,0,0,,Көшбасшы күткендей.
Dialogue: 0,0:47:01.94,0:47:02.98,Default,,0,0,0,,Сондықтан Менма
Dialogue: 0,0:47:03.11,0:47:06.03,Default,,0,0,0,,Джинтанның алдына шықтыңыз ба?
Dialogue: 0,0:47:06.15,0:47:07.69,Default,,0,0,0,,Менің біраз шаруам қалды.
Dialogue: 0,0:47:08.32,0:47:10.03,Default,,0,0,0,,Эй, менің бір ісім бар.
Dialogue: 0,0:47:10.36,0:47:11.37,Default,,0,0,0,,Не?
Dialogue: 0,0:47:14.03,0:47:15.24,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:47:17.29,0:47:20.37,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:47:20.50,0:47:24.50,Default,,0,0,0,,Нокемон мен Гайжин бір мағынаны білдіреді.
Dialogue: 0,0:47:24.80,0:47:26.55,Default,,0,0,0,,Менма Мен оны аштым.
Dialogue: 0,0:47:26.67,0:47:28.42,Default,,0,0,0,,Хмм.
Dialogue: 0,0:47:29.47,0:47:31.47,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:47:31.76,0:47:34.47,Default,,0,0,0,,Гайжин шетелдіктерді білдіреді, солай ма?
Dialogue: 0,0:47:35.18,0:47:38.18,Default,,0,0,0,,Неліктен ол Пипитонмен бірдей?
Dialogue: 0,0:47:39.56,0:47:40.77,Default,,0,0,0,,Гэйджин дегеніміз не?
Dialogue: 0,0:47:40.89,0:47:44.23,Default,,0,0,0,,Сіз оны канжимен қалай жазу керектігін білесіз бе? Джинтан
Dialogue: 0,0:47:44.36,0:47:46.78,Default,,0,0,0,,Мені мазақ етпе
Dialogue: 0,0:47:46.98,0:47:49.70,Default,,0,0,0,,«Сыртқы адам» Дұрыс.
Dialogue: 0,0:47:49.82,0:47:53.12,Default,,0,0,0,,Сонымен, Нокемон нені білдіретінін білесіз бе?
Dialogue: 0,0:47:53.24,0:47:54.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:54.70,0:47:56.24,Default,,0,0,0,,Нокемон.
Dialogue: 0,0:47:56.37,0:47:59.50,Default,,0,0,0,,«Мен сырттамын, ішке кіре алмаймын» дегенді білдіре ме?
Dialogue: 0,0:47:59.62,0:48:00.54,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:48:00.66,0:48:02.83,Default,,0,0,0,,Эй, бұл бір нәрсені білдіреді, солай ма?
Dialogue: 0,0:48:03.25,0:48:04.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:04.54,0:48:05.38,Default,,0,0,0,,Міне.
Dialogue: 0,0:48:05.50,0:48:08.17,Default,,0,0,0,,Менма - Нокемон және Гайджин.
Dialogue: 0,0:48:09.01,0:48:11.26,Default,,0,0,0,,Менма Себебі мен бөгде адаммын
Dialogue: 0,0:48:11.38,0:48:14.22,Default,,0,0,0,,Сіз шынымен ішке кірмеуіңіз керек.
Dialogue: 0,0:48:14.39,0:48:16.60,Default,,0,0,0,,Мектеп, үй, т.б.
Dialogue: 0,0:48:17.18,0:48:20.35,Default,,0,0,0,,Көршімнің ит үйінде жатуым керек шығар.
Dialogue: 0,0:48:20.73,0:48:22.98,Default,,0,0,0,,Бұл сыртта, иә?
Dialogue: 0,0:48:23.10,0:48:26.77,Default,,0,0,0,,Әлгі ит Менма туралы үнемі үреді.
Dialogue: 0,0:48:27.36,0:48:29.32,Default,,0,0,0,,Біз жақсы араласа аламыз ба?
Dialogue: 0,0:48:29.86,0:48:31.57,Default,,0,0,0,,Қызық, мені тістеп алар ма?
Dialogue: 0,0:48:32.24,0:48:35.99,Default,,0,0,0,,Әй, бұл не әңгіме?
Dialogue: 0,0:48:38.70,0:48:44.00,Default,,0,0,0,,Жапон тілі сабағында бізге әңгіме жазуды тапсырды, солай ма? үй тапсырмасы
Dialogue: 0,0:48:45.42,0:48:48.17,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:48:48.84,0:48:52.72,Default,,0,0,0,,Бұл Нокемон Гайжиндегі Менма бейнесі туралы.
Dialogue: 0,0:48:56.39,0:48:58.51,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:48:58.97,0:48:59.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:01.89,0:49:04.27,Default,,0,0,0,,Сізде құпия база бар.
Dialogue: 0,0:49:04.56,0:49:05.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:06.15,0:49:08.57,Default,,0,0,0,,Super Peace Busters құпия базасы
Dialogue: 0,0:49:09.02,0:49:11.36,Default,,0,0,0,,Барлығы кез келген уақытта орала алатын орын
Dialogue: 0,0:49:15.66,0:49:16.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:22.87,0:49:24.21,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:49:24.83,0:49:26.63,Default,,0,0,0,,Эй, бірдеңе жегің келе ме?
Dialogue: 0,0:49:26.75,0:49:28.84,Default,,0,0,0,,Жарайды, не істегіңіз келеді?
Dialogue: 0,0:49:28.96,0:49:31.71,Default,,0,0,0,,Хмм, мен кеше соба жедім.
Dialogue: 0,0:49:31.84,0:49:33.30,Default,,0,0,0,,Сонымен, Вараджи Катсудон ше?
Dialogue: 0,0:49:33.76,0:49:35.13,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:49:35.26,0:49:37.97,Default,,0,0,0,,Иә, бұл үлкен және жақсы.
Dialogue: 0,0:49:39.64,0:49:41.64,Default,,0,0,0,,Кешіріңіз, Джинтан
Dialogue: 0,0:49:42.31,0:49:44.81,Default,,0,0,0,,Осындай нәрсені жасаңыз.
Dialogue: 0,0:49:45.10,0:49:46.06,Default,,0,0,0,,Поппо
Dialogue: 0,0:49:46.19,0:49:51.82,Default,,0,0,0,,Әйтеуір... Бәрі артқа оралғандай болды.
Dialogue: 0,0:49:52.28,0:49:53.82,Default,,0,0,0,,Артқа айналдыру…
Dialogue: 0,0:49:54.32,0:49:55.15,Default,,0,0,0,,Эй
Dialogue: 0,0:49:56.11,0:49:58.03,Default,,0,0,0,,Бұл рас па? иә?
Dialogue: 0,0:49:58.57,0:50:01.16,Default,,0,0,0,,Хо... бұл рас.
Dialogue: 0,0:50:02.20,0:50:04.66,Default,,0,0,0,,Менма да Джинтанды жақсы көреді!
Dialogue: 0,0:50:04.79,0:50:06.25,Default,,0,0,0,,Мен... мен сені сүйемін...
Dialogue: 0,0:50:06.37,0:50:09.17,Default,,0,0,0,,Бұл достарыңызға ұнау ғана емес.
Dialogue: 0,0:50:09.29,0:50:12.55,Default,,0,0,0,,Білемін, саған менің әйелім болған ұнайды, солай ма?
Dialogue: 0,0:50:12.67,0:50:13.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:50:14.84,0:50:19.39,Default,,0,0,0,,Менма өскенде осындай болса...
Dialogue: 0,0:50:19.51,0:50:23.01,Default,,0,0,0,,Қызық, Мэнма Джинтанның әйелі болды ма?
Dialogue: 0,0:50:26.31,0:50:28.77,Default,,0,0,0,,Бұл қалыпты болмаса да...
Dialogue: 0,0:50:28.90,0:50:29.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:29.86,0:50:31.98,Default,,0,0,0,,Буддалыққа жетпесең де
Dialogue: 0,0:50:32.32,0:50:34.48,Default,,0,0,0,,Осы жерде қалуың керек емес пе?
Dialogue: 0,0:50:35.61,0:50:36.45,Default,,0,0,0,,Цзиньтан…
Dialogue: 0,0:50:39.95,0:50:42.16,Default,,0,0,0,,Айт... кетті.
Dialogue: 0,0:50:50.13,0:50:51.50,Default,,0,0,0,,Мен Буддалыққа қол жеткіземін.
Dialogue: 0,0:50:51.63,0:50:52.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:52.79,0:50:55.26,Default,,0,0,0,,Білесіз бе, бұл реинкарнация.
Dialogue: 0,0:50:55.38,0:50:58.47,Default,,0,0,0,,Егер сіз Буддалыққа қол жеткізбесеңіз, оны жасай алмайсыз.
Dialogue: 0,0:50:58.63,0:51:00.84,Default,,0,0,0,,Мен барлығымен дұрыс сөйлесе алмаймын.
Dialogue: 0,0:51:02.64,0:51:05.10,Default,,0,0,0,,Сіз дұрыс таңдау жасадыңыз.
Dialogue: 0,0:51:05.22,0:51:06.39,Default,,0,0,0,,Антоки
Dialogue: 0,0:51:07.81,0:51:11.56,Default,,0,0,0,,Күрсін, мен сондай аяныштымын.
Dialogue: 0,0:51:11.98,0:51:13.15,Default,,0,0,0,,Чивасу
Dialogue: 0,0:51:14.11,0:51:16.07,Default,,0,0,0,,Әй, қарағым, мен сені шақырдым.
Dialogue: 0,0:51:16.53,0:51:18.61,Default,,0,0,0,,Аа, жоқ, мен де мұнда жаңа келдім.
Dialogue: 0,0:51:18.74,0:51:21.53,Default,,0,0,0,,Түсіндім, рахмет...
Dialogue: 0,0:51:21.66,0:51:23.95,Default,,0,0,0,,Не? Сіз сондай үлкен болып кеттіңіз.
Dialogue: 0,0:51:24.08,0:51:25.29,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:51:25.41,0:51:28.08,Default,,0,0,0,,Джинта-сенпай өсуді тоқтатқан жоқ па?
Dialogue: 0,0:51:28.21,0:51:30.33,Default,,0,0,0,,Мынау Джинта-сенпай деуді доғар.
Dialogue: 0,0:51:30.46,0:51:34.00,Default,,0,0,0,,Хехехе Ах, сонда... Бүгін не болып жатыр?
Dialogue: 0,0:51:34.13,0:51:37.26,Default,,0,0,0,,А, міне, солай. (Сатоши) Иә?
Dialogue: 0,0:51:37.38,0:51:38.80,Default,,0,0,0,,А, бұл менма...
Dialogue: 0,0:51:39.59,0:51:42.22,Default,,0,0,0,,Сіз оны әпкеңіздің буддалық құрбандық үстеліне бере аласыз ба?
Dialogue: 0,0:51:42.34,0:51:44.55,Default,,0,0,0,,Бұл буға пісірілген нан ба?
Dialogue: 0,0:51:44.68,0:51:45.68,Default,,0,0,0,,О
Dialogue: 0,0:51:46.10,0:51:47.85,Default,,0,0,0,,Әкемнен жаңа ғана үйрендім.
Dialogue: 0,0:51:48.18,0:51:51.56,Default,,0,0,0,,Бұл дұрыс емес, Джинта-кун.
Dialogue: 0,0:51:51.69,0:51:54.48,Default,,0,0,0,,Неліктен? Егер сіз қопсытқыш ұнтақ қоссаңыз ...
Dialogue: 0,0:51:54.61,0:51:56.44,Default,,0,0,0,,Үлпілдек болмай ма?
Dialogue: 0,0:51:56.86,0:51:59.40,Default,,0,0,0,,Токо-санның талғамының сыры?
Dialogue: 0,0:51:59.74,0:52:02.28,Default,,0,0,0,,Иә, бұл құймақ қоспасы
Dialogue: 0,0:52:02.41,0:52:04.41,Default,,0,0,0,,Иә? Құймақ?
Dialogue: 0,0:52:05.20,0:52:07.37,Default,,0,0,0,,Осы арқылы буға пісірілген нан жасауға да болады.
Dialogue: 0,0:52:07.49,0:52:10.87,Default,,0,0,0,,Қараңдар, артқа қараңдар. Буға пісірілген нанның рецепті де бар.
Dialogue: 0,0:52:11.00,0:52:12.17,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:52:12.50,0:52:14.75,Default,,0,0,0,,Сіз таң қаларлықтай көңіл көтердіңіз, мама.
Dialogue: 0,0:52:14.88,0:52:17.42,Default,,0,0,0,,Тоуко-сан тамақ дайындауда да аздап нашар.
Dialogue: 0,0:52:17.55,0:52:18.76,Default,,0,0,0,,Бұл сүйкімді болды, солай емес пе?
Dialogue: 0,0:52:19.34,0:52:22.84,Default,,0,0,0,,Жоқ, бұл таңқаларлық оңай болды.
Dialogue: 0,0:52:22.97,0:52:25.51,Default,,0,0,0,,Әй, дәмді көрінеді.
Dialogue: 0,0:52:25.64,0:52:29.77,Default,,0,0,0,,Бірақ менің үйіме тура келсең болды.
Dialogue: 0,0:52:29.89,0:52:31.35,Default,,0,0,0,,Тіпті ата-ана да...
Dialogue: 0,0:52:33.77,0:52:35.81,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:52:37.32,0:52:39.61,Default,,0,0,0,,Келесі жолы бәріңді жіберемін.
Dialogue: 0,0:52:40.61,0:52:43.24,Default,,0,0,0,,Әй супер бейбітшілік бұзушылар
Dialogue: 0,0:52:43.36,0:52:45.78,Default,,0,0,0,,О...
Dialogue: 0,0:52:47.16,0:52:48.03,Default,,0,0,0,,Иә
Dialogue: 0,0:52:49.49,0:52:50.75,Default,,0,0,0,,Хаа…
Dialogue: 0,0:52:52.04,0:52:53.58,Default,,0,0,0,,Айтайын ба?
Dialogue: 0,0:52:54.79,0:52:59.46,Default,,0,0,0,,Жұмыс істемесе де... айтайын ба?
Dialogue: 0,0:53:01.26,0:53:06.68,Default,,0,0,0,,Бірақ Менманың арқасында бәріміз дос бола алдық.
Dialogue: 0,0:53:08.35,0:53:10.77,Default,,0,0,0,,Егер ол серпілсе
Dialogue: 0,0:53:11.73,0:53:12.64,Default,,0,0,0,,Анар?
Dialogue: 0,0:53:13.14,0:53:14.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:14.77,0:53:15.94,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:53:17.02,0:53:18.40,Default,,0,0,0,,Бармайсың ба? негіз
Dialogue: 0,0:53:18.52,0:53:20.78,Default,,0,0,0,,Не? Әй?
Dialogue: 0,0:53:21.23,0:53:22.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:22.19,0:53:23.74,Default,,0,0,0,,Жоқ... сіз міндетті түрде барасыз, солай ма?
Dialogue: 0,0:53:23.86,0:53:25.82,Default,,0,0,0,,Неге сонша ашуланасың?
Dialogue: 0,0:53:25.95,0:53:26.78,Default,,0,0,0,,Кеттік
Dialogue: 0,0:53:43.34,0:53:47.26,Default,,0,0,0,,Джинтанса Бойыңыз тағы да ұзартылды ма?
Dialogue: 0,0:53:47.43,0:53:49.30,Default,,0,0,0,,Менің өсуім тоқтап қалған сияқты.
Dialogue: 0,0:53:49.43,0:53:50.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:50.39,0:53:51.31,Default,,0,0,0,,Жоқ
Dialogue: 0,0:53:51.43,0:53:54.14,Default,,0,0,0,,Бұл енді қаруға ұқсайтын аяқ киім кимейтіндіктен емес пе?
Dialogue: 0,0:53:54.27,0:53:57.27,Default,,0,0,0,,Әй, кісі өлтіру қаруы қандай?
Dialogue: 0,0:54:00.23,0:54:03.61,Default,,0,0,0,,Өтірік Мен өстім
Dialogue: 0,0:54:07.70,0:54:09.24,Default,,0,0,0,,Аноса Джинтан
Dialogue: 0,0:54:09.37,0:54:10.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:10.70,0:54:11.87,Default,,0,0,0,,Ум...
Dialogue: 0,0:54:12.58,0:54:15.37,Default,,0,0,0,,Сонымен... хатты дұрыс жаздыңыз ба? 3 дана блокнот
Dialogue: 0,0:54:15.50,0:54:17.96,Default,,0,0,0,,Үш бөлік? Ондай квота болды ма?
Dialogue: 0,0:54:18.08,0:54:19.71,Default,,0,0,0,,Бұл анық!
Dialogue: 0,0:54:19.83,0:54:21.96,Default,,0,0,0,,Егер ол өліп қалған болса
Dialogue: 0,0:54:22.80,0:54:26.22,Default,,0,0,0,,Мен әлі бір бет жазған болсам да.
Dialogue: 0,0:54:26.84,0:54:28.93,Default,,0,0,0,,Егер сіз эмоционалды болсаңыз, қалағаныңызша көп суретке түсіре аласыз.
Dialogue: 0,0:54:30.18,0:54:31.14,Default,,0,0,0,,Жаз…
Dialogue: 0,0:54:33.22,0:54:34.43,Default,,0,0,0,,Сол жаз
Dialogue: 0,0:54:35.93,0:54:37.10,Default,,0,0,0,,Сол жаз
Dialogue: 0,0:54:37.56,0:54:38.90,Default,,0,0,0,,Мен енді түсінбеймін.
Dialogue: 0,0:54:39.06,0:54:40.65,Default,,0,0,0,,Қанша жаз қайталасақ та
Dialogue: 0,0:54:41.94,0:54:45.36,Default,,0,0,0,,Өйткені, менің айтар сөзім жоқ...
Dialogue: 0,0:54:50.32,0:54:53.37,Default,,0,0,0,,Бір ғана нәрсе.
Dialogue: 0,0:55:06.88,0:55:09.80,Default,,0,0,0,,Апай, сәл күте тұрыңыз.
Dialogue: 0,0:55:10.14,0:55:12.18,Default,,0,0,0,,Өйткені барлығы отшашуды жағады
Dialogue: 0,0:55:12.80,0:55:15.77,Default,,0,0,0,,Тағы біраз күтіңіз...
Dialogue: 0,0:55:17.39,0:55:20.56,Default,,0,0,0,,О! Тым кеш.
Dialogue: 0,0:55:20.69,0:55:22.19,Default,,0,0,0,,Не, біз соңғымыз ба?
Dialogue: 0,0:55:22.31,0:55:23.90,Default,,0,0,0,,Біз де жақында келдік.
Dialogue: 0,0:55:24.02,0:55:25.32,Default,,0,0,0,,Иә
Dialogue: 0,0:55:26.61,0:55:27.78,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:55:28.32,0:55:31.99,Default,,0,0,0,,Super Peace Busters барлығы осында.
Dialogue: 0,0:55:32.37,0:55:34.20,Default,,0,0,0,,Эй, Цуруко да жәндіктерге қарсы дәрі қолдана ма?
Dialogue: 0,0:55:34.33,0:55:35.20,Default,,0,0,0,,Мен көп сурет салдым
Dialogue: 0,0:55:35.33,0:55:36.16,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:55:36.79,0:55:38.87,Default,,0,0,0,,Хатты өртеу?
Dialogue: 0,0:55:40.17,0:55:43.75,Default,,0,0,0,,Қазір айту қиын, бірақ бұл өте жапондық стиль.
Dialogue: 0,0:55:43.88,0:55:47.96,Default,,0,0,0,,Керемет емес пе? Бұл нағыз Жаңа Бон фестивалі.
Dialogue: 0,0:55:48.38,0:55:50.43,Default,,0,0,0,,Бұл Жаңа Bon фестивалі ме?
Dialogue: 0,0:55:51.09,0:55:54.60,Default,,0,0,0,,Бірақ, сыртта әлі де жарқырап тұр.
Dialogue: 0,0:55:54.76,0:55:58.35,Default,,0,0,0,,Түнгі аспанды да бұлт бүркеп тұрған жоқ па?
Dialogue: 0,0:55:58.48,0:55:59.31,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:55:59.43,0:56:01.14,Default,,0,0,0,,Уа, мен сәтсіздікке ұшырадым!
Dialogue: 0,0:56:01.27,0:56:03.77,Default,,0,0,0,,Мен күтіп тұрғанда шашлык дайындап жатырмын.
Dialogue: 0,0:56:03.90,0:56:06.78,Default,,0,0,0,,Сен не барбекю жасап жатырсың?
Dialogue: 0,0:56:07.03,0:56:10.32,Default,,0,0,0,,О, дұрыс, дұрыс, сәл күте тұрыңыз!
Dialogue: 0,0:56:10.45,0:56:12.07,Default,,0,0,0,,Жақсы
Dialogue: 0,0:56:13.57,0:56:14.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:56:14.91,0:56:16.99,Default,,0,0,0,,Не? отшашу
Dialogue: 0,0:56:17.12,0:56:18.29,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,0:56:18.41,0:56:21.04,Default,,0,0,0,,Сен әкелдің, солай ма? Анал-сан.
Dialogue: 0,0:56:21.16,0:56:22.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:22.12,0:56:24.63,Default,,0,0,0,,Алдыңғы барбекюге қараңыз.
Dialogue: 0,0:56:26.84,0:56:28.17,Default,,0,0,0,,О
Dialogue: 0,0:56:28.92,0:56:30.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:56:30.51,0:56:32.68,Default,,0,0,0,,Сол кезде Юкиацу біртүрлі әрекет етті.
Dialogue: 0,0:56:32.80,0:56:34.05,Default,,0,0,0,,Эй, не?
Dialogue: 0,0:56:34.47,0:56:35.35,Default,,0,0,0,,Ах... ахах
Dialogue: 0,0:56:35.47,0:56:36.43,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:56:36.55,0:56:37.85,Default,,0,0,0,,Артық айтпаңыз
Dialogue: 0,0:56:37.97,0:56:39.27,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:56:39.39,0:56:41.77,Default,,0,0,0,,Барлығымыздың бас қосқанымызға біраз болды.
Dialogue: 0,0:56:41.89,0:56:44.02,Default,,0,0,0,,Көңіл көтеріп, көңіл көтерейік
Dialogue: 0,0:56:44.15,0:56:45.23,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:56:45.36,0:56:47.48,Default,,0,0,0,,Мұнда әркім анда-санда келетін, бірақ...
Dialogue: 0,0:56:47.61,0:56:49.78,Default,,0,0,0,,Барлығының бірге болғанына біраз болды ма?
Dialogue: 0,0:56:49.90,0:56:51.24,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:56:51.65,0:56:53.95,Default,,0,0,0,,Әй, түстен кейінгі алаудан —
Dialogue: 0,0:56:54.07,0:56:56.32,Default,,0,0,0,,Күндізгі отшашулар әлдеқайда оғаш емес пе?
Dialogue: 0,0:56:56.45,0:56:58.24,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:56:58.37,0:57:01.33,Default,,0,0,0,,Зымыран отшашуы күндіз жасалса, қызықтырақ болар еді.
Dialogue: 0,0:57:01.45,0:57:05.58,Default,,0,0,0,,Өткен жылы олар күндіз үлкен нәрсені іске қосты.
Dialogue: 0,0:57:06.21,0:57:09.25,Default,,0,0,0,,О, бұл керемет болды.
Dialogue: 0,0:57:09.71,0:57:11.76,Default,,0,0,0,,Бұл ақшаға жұмсалған болуы керек.
Dialogue: 0,0:57:11.88,0:57:13.59,Default,,0,0,0,,Бұл, әрине, әдемі болды.
Dialogue: 0,0:57:13.93,0:57:14.76,Default,,0,0,0,,Иә
Dialogue: 0,0:57:14.88,0:57:15.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:16.47,0:57:19.26,Default,,0,0,0,,Менма да қуанып қалды.
Dialogue: 0,0:57:23.81,0:57:26.40,Default,,0,0,0,,Отшашу... атылды.
Dialogue: 0,0:57:50.75,0:57:55.09,Default,,0,0,0,,Біз сенген отшашулар сенің тілегің болды.
Dialogue: 0,0:57:59.72,0:58:00.93,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:58:01.43,0:58:04.73,Default,,0,0,0,,Уау, аспанда гүлдер жайқалған!
Dialogue: 0,0:58:05.14,0:58:06.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:09.06,0:58:10.15,Default,,0,0,0,,Ах... Қайта?
Dialogue: 0,0:58:11.15,0:58:12.86,Default,,0,0,0,,Менма…
Dialogue: 0,0:58:13.53,0:58:15.32,Default,,0,0,0,,Сіз жоғалып кеткен жоқсыз
Dialogue: 0,0:58:15.78,0:58:16.82,Default,,0,0,0,,Техехе
Dialogue: 0,0:58:19.24,0:58:20.53,Default,,0,0,0,,Иә? Мен оны пайдалана алмаймын
Dialogue: 0,0:58:20.66,0:58:23.33,Default,,0,0,0,,Ол кезде шок болуы керек еді.
Dialogue: 0,0:58:24.25,0:58:26.46,Default,,0,0,0,,Мен бір жерде жеңілдеп қалдым
Dialogue: 0,0:58:27.00,0:58:28.88,Default,,0,0,0,,Ораора!
Dialogue: 0,0:58:29.00,0:58:30.84,Default,,0,0,0,,...Мүмкін емес пе?
Dialogue: 0,0:58:31.54,0:58:32.92,Default,,0,0,0,,басқа қабылдау
Dialogue: 0,0:58:33.05,0:58:34.34,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:58:34.76,0:58:37.30,Default,,0,0,0,,Менманың тілегі енді түсінілмейді
Dialogue: 0,0:58:38.18,0:58:40.89,Default,,0,0,0,,Біздің сезімдеріміздің баратын жері жоқ.
Dialogue: 0,0:58:42.85,0:58:43.97,Default,,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:58:44.81,0:58:48.27,Default,,0,0,0,,Біздің сезімдер өзімізге бағытталған—
Dialogue: 0,0:58:49.73,0:58:52.40,Default,,0,0,0,,Көптен бері тұтанған сезімдерді айқайлаңыз
Dialogue: 0,0:58:53.94,0:58:54.82,Default,,0,0,0,,Айқай
Dialogue: 0,0:58:58.24,0:58:59.41,Default,,0,0,0,,Және…
Dialogue: 0,0:59:00.87,0:59:02.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:59:03.83,0:59:05.08,Default,,0,0,0,,Уф, хм…
Dialogue: 0,0:59:06.50,0:59:07.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:07.71,0:59:09.83,Default,,0,0,0,,Джинтан енді маңызды емес!
Dialogue: 0,0:59:09.96,0:59:12.04,Default,,0,0,0,,Менмадан дұрыс кешірім сұраңыз және...
Dialogue: 0,0:59:12.17,0:59:13.75,Default,,0,0,0,,А... А, не!
Dialogue: 0,0:59:14.42,0:59:15.63,Default,,0,0,0,,Кірпіктер
Dialogue: 0,0:59:15.76,0:59:16.59,Default,,0,0,0,,Екі бар
Dialogue: 0,0:59:16.71,0:59:18.47,Default,,0,0,0,,Е... Жоқ, мен киемін.
Dialogue: 0,0:59:18.59,0:59:20.18,Default,,0,0,0,,(Күлкін ұстап тұрған дауыс)
Dialogue: 0,0:59:20.84,0:59:22.01,Default,,0,0,0,,Сәлем, Юкиацу!
Dialogue: 0,0:59:22.14,0:59:25.64,Default,,0,0,0,,Ақыр соңында, сіз көзіңіз өзгерді деп ойладыңыз, солай ма?
Dialogue: 0,0:59:25.77,0:59:27.02,Default,,0,0,0,,Цуруко, сен...
Dialogue: 0,0:59:27.14,0:59:30.10,Default,,0,0,0,,Бұл үлпілдек шашты өсірудің қажеті жоқ, солай ма?
Dialogue: 0,0:59:30.23,0:59:31.56,Default,,0,0,0,,Анару
Dialogue: 0,0:59:31.69,0:59:33.86,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:59:34.69,0:59:36.36,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:59:36.48,0:59:38.82,Default,,0,0,0,,Бірақ олай айтпа!
Dialogue: 0,0:59:38.95,0:59:41.32,Default,,0,0,0,,...Енді ойлап қарасам
Dialogue: 0,0:59:41.45,0:59:43.49,Default,,0,0,0,,Барлығы өз лақап аттарына оралды.
Dialogue: 0,0:59:43.62,0:59:44.99,Default,,0,0,0,,Рас
Dialogue: 0,0:59:45.58,0:59:50.58,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:59:52.79,0:59:54.84,Default,,0,0,0,,Бұл дәл Юкиацу айтқандай.
Dialogue: 0,0:59:54.96,0:59:55.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:55.92,0:59:57.05,Default,,0,0,0,,Мен бір жерде
Dialogue: 0,0:59:57.17,1:00:00.05,Default,,0,0,0,,Мен Менманы ғана көре алатыныма қуандым.
Dialogue: 0,1:00:00.17,1:00:01.18,Default,,0,0,0,,Цзиньтан…
Dialogue: 0,1:00:01.30,1:00:03.55,Default,,0,0,0,,Бірақ Менма басқаша.
Dialogue: 0,1:00:03.68,1:00:04.51,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:04.64,1:00:05.47,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:00:06.10,1:00:08.77,Default,,0,0,0,,Мен Буддалыққа жетудің қажеті жоқ деп ойладым.
Dialogue: 0,1:00:09.85,1:00:12.27,Default,,0,0,0,,Бірақ ол басқаша болды.
Dialogue: 0,1:00:13.23,1:00:16.77,Default,,0,0,0,,Мен ғана емес, барлығымен сөйлескім келеді.
Dialogue: 0,1:00:17.40,1:00:19.82,Default,,0,0,0,,Сондықтан мен Буддалыққа жетіп, қайта туғым келеді.
Dialogue: 0,1:00:22.57,1:00:24.62,Default,,0,0,0,,Менманың тілегін орындайық
Dialogue: 0,1:00:24.74,1:00:25.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:26.45,1:00:29.87,Default,,0,0,0,,Менмаға да қоңырау шалып, күнделігіңізбен дұрыс сөйлесіңіз.
Dialogue: 0,1:00:30.46,1:00:33.37,Default,,0,0,0,,Менмамен тағы да
Dialogue: 0,1:00:33.50,1:00:35.21,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:00:35.34,1:00:37.09,Default,,0,0,0,,Менмасыз сөйлесудің мәні жоқ.
Dialogue: 0,1:00:37.21,1:00:38.05,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:00:38.17,1:00:40.13,Default,,0,0,0,,Алтауымыз -
Dialogue: 0,1:00:40.26,1:00:42.47,Default,,0,0,0,,Бұл Super Peace Busters.
Dialogue: 0,1:00:42.59,1:00:43.43,Default,,0,0,0,,Ой
Dialogue: 0,1:00:43.55,1:00:45.26,Default,,0,0,0,,Әй, менің желім!
Dialogue: 0,1:00:46.64,1:00:47.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:47.97,1:00:50.48,Default,,0,0,0,,Өтінемін, көшбасшы.
Dialogue: 0,1:00:52.06,1:00:52.94,Default,,0,0,0,,О
Dialogue: 0,1:00:53.39,1:00:56.73,Default,,0,0,0,,Мен Менманы бірден әкелемін. Құпия базада кездесейік!
Dialogue: 0,1:00:57.77,1:01:00.15,Default,,0,0,0,,(жану дыбысы жеңілірек)
Dialogue: 0,1:01:00.49,1:01:02.36,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз
Dialogue: 0,1:01:02.49,1:01:05.03,Default,,0,0,0,,Жоқ, менің ойымша, бұл дерлік осында.
Dialogue: 0,1:01:05.16,1:01:07.28,Default,,0,0,0,,Сіз дәл осылай айттыңыз.
Dialogue: 0,1:01:07.41,1:01:09.08,Default,,0,0,0,,Айтпақшы, көшбасшы
Dialogue: 0,1:01:09.20,1:01:10.12,Default,,0,0,0,,Не, көшбасшы...
Dialogue: 0,1:01:10.24,1:01:12.21,Default,,0,0,0,,Бұл толық емес жұмыс әлі де жалғасып жатыр ма?
Dialogue: 0,1:01:12.79,1:01:14.75,Default,,0,0,0,,Мені сол көшбасшы деп атауды доғар.
Dialogue: 0,1:01:15.33,1:01:17.71,Default,,0,0,0,,Мен ойын дүкенінде тұрып қалдым.
Dialogue: 0,1:01:17.84,1:01:20.55,Default,,0,0,0,,Мектеп? Мен дұрыс ілгерілей аламын ба?
Dialogue: 0,1:01:21.63,1:01:25.34,Default,,0,0,0,,Мүмкін болса, мен қатысушылардың санын санадым және ол желіде болды...
Dialogue: 0,1:01:25.93,1:01:28.30,Default,,0,0,0,,...Мені екі жақтан да айып етпеңіздер демекпін!
Dialogue: 0,1:01:28.43,1:01:29.89,Default,,0,0,0,,Балалар сендер жақсы достарсыңдар!
Dialogue: 0,1:01:30.01,1:01:31.31,Default,,0,0,0,,А... Иә?
Dialogue: 0,1:01:32.06,1:01:33.31,Default,,0,0,0,,Бұл қандай реакция?
Dialogue: 0,1:01:33.43,1:01:34.27,Default,,0,0,0,,Уф
Dialogue: 0,1:01:35.85,1:01:36.73,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,1:01:36.85,1:01:39.07,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,1:01:39.19,1:01:43.07,Default,,0,0,0,,Сәлем! Өтінемін, маған жарқырап кетуді тоқтатуға көмектесіңіз.
Dialogue: 0,1:01:43.19,1:01:45.41,Default,,0,0,0,,Оны маған біраз уақытқа қарызға бер.
Dialogue: 0,1:01:45.53,1:01:47.07,Default,,0,0,0,,Көбірек атыс күші...
Dialogue: 0,1:01:47.20,1:01:48.66,Default,,0,0,0,,Эй, абай бол.
Dialogue: 0,1:01:48.78,1:01:50.58,Default,,0,0,0,,Егер мен жай ғана бас тартсам ше?
Dialogue: 0,1:01:50.70,1:01:53.04,Default,,0,0,0,,Бас тартсаң, мұнымен бітпейді.
Dialogue: 0,1:01:53.16,1:01:55.21,Default,,0,0,0,,Қандай баскетбол мұғалімі?
Dialogue: 0,1:01:55.67,1:01:59.00,Default,,0,0,0,,Цзиньтан Баяу.
Dialogue: 0,1:01:59.63,1:02:03.72,Default,,0,0,0,,Бәрі бірге ойнап жатыр ма деп ойлаймын. Күшті.
Dialogue: 0,1:02:04.51,1:02:07.18,Default,,0,0,0,,Бірақ Менма, бұл былай.
Dialogue: 0,1:02:07.30,1:02:10.72,Default,,0,0,0,,Барсаң да бәрінің басын қағасың.
Dialogue: 0,1:02:13.68,1:02:15.81,Default,,0,0,0,,Рахмет, апай.
Dialogue: 0,1:02:16.64,1:02:21.52,Default,,0,0,0,,Менма, барлығын қайта көргеніме қатты қуандым.
Dialogue: 0,1:02:22.73,1:02:26.15,Default,,0,0,0,,Соңында дұрыстап қоштасқым келді.
Dialogue: 0,1:02:27.53,1:02:28.87,Default,,0,0,0,,(шу)
Dialogue: 0,1:02:30.58,1:02:31.49,Default,,0,0,0,,Ах
Dialogue: 0,1:02:31.62,1:02:34.45,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:02:34.62,1:02:37.87,Default,,0,0,0,,Ақыр соңында, Цзиньтан...
Dialogue: 0,1:02:42.38,1:02:43.42,Default,,0,0,0,,Менма!
Dialogue: 0,1:02:49.43,1:02:50.43,Default,,0,0,0,,Менма…
Dialogue: 0,1:02:52.72,1:02:54.35,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:02:58.85,1:03:00.44,Default,,0,0,0,,Сәлем Менма
Dialogue: 0,1:03:01.02,1:03:03.11,Default,,0,0,0,,Не болып жатыр? Бұл неге...
Dialogue: 0,1:03:03.23,1:03:05.65,Default,,0,0,0,,Менманың өтініші... солай ма?
Dialogue: 0,1:03:06.07,1:03:08.11,Default,,0,0,0,,Бұл орындалған сияқты
Dialogue: 0,1:03:08.24,1:03:09.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:09.32,1:03:11.78,Default,,0,0,0,,Менма, есіме түсті.
Dialogue: 0,1:03:11.95,1:03:15.37,Default,,0,0,0,,Джинтанның ханымына берген уәдем
Dialogue: 0,1:03:15.62,1:03:17.58,Default,,0,0,0,,Әлде... анаммен бе?
Dialogue: 0,1:03:18.12,1:03:21.63,Default,,0,0,0,,Бір ғана нәрсе.
Dialogue: 0,1:03:21.75,1:03:22.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:22.71,1:03:24.59,Default,,0,0,0,,Джинта жыламайды
Dialogue: 0,1:03:25.42,1:03:28.01,Default,,0,0,0,,Мүмкін менің осылай болғанымнан шығар.
Dialogue: 0,1:03:28.13,1:03:30.26,Default,,0,0,0,,Менің ойымша, сіз үнемі сақ болып жүрсіз.
Dialogue: 0,1:03:30.38,1:03:31.76,Default,,0,0,0,,Апай?
Dialogue: 0,1:03:31.93,1:03:36.68,Default,,0,0,0,,Мен қайта туылуды асыға күтемін, бірақ мені алаңдататын жалғыз нәрсе осы.
Dialogue: 0,1:03:37.77,1:03:39.98,Default,,0,0,0,,Мен сені көп ұстауға мәжбүр еттім
Dialogue: 0,1:03:40.65,1:03:43.82,Default,,0,0,0,,Негізі мен көбірек күлдім, ашуландым.
Dialogue: 0,1:03:44.15,1:03:47.53,Default,,0,0,0,,Жыласаңыз екен...
Dialogue: 0,1:03:47.86,1:03:48.99,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,1:03:50.74,1:03:54.83,Default,,0,0,0,,Менма сені жылатуға уәде береді!
Dialogue: 0,1:03:58.37,1:03:59.33,Default,,0,0,0,,Иә
Dialogue: 0,1:04:00.00,1:04:02.00,Default,,0,0,0,,Менма-чанға рахмет
Dialogue: 0,1:04:02.92,1:04:05.92,Default,,0,0,0,,Жарайды, мен сенен бір жақсылық сұрайын деп тұрмын.
Dialogue: 0,1:04:07.42,1:04:08.55,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:11.51,1:04:14.85,Default,,0,0,0,,Бірақ, мен бұл туралы көп ойладым.
Dialogue: 0,1:04:14.97,1:04:19.39,Default,,0,0,0,,Менма, мен не істерімді білмеймін.
Dialogue: 0,1:04:19.93,1:04:21.06,Default,,0,0,0,,Сол себепті
Dialogue: 0,1:04:22.02,1:04:26.86,Default,,0,0,0,,Барлығына хабарласып, жиналуын өтінемін.
Dialogue: 0,1:04:27.65,1:04:29.69,Default,,0,0,0,,Әй, бәріміз оны қорлап, жылатайық...
Dialogue: 0,1:04:29.82,1:04:31.07,Default,,0,0,0,,Менмага
Dialogue: 0,1:04:33.16,1:04:38.58,Default,,0,0,0,,Осы жерге қайтып келгенше орындағым келген тілегім...
Dialogue: 0,1:04:40.66,1:04:42.42,Default,,0,0,0,,Бірақ бәрібір...
Dialogue: 0,1:04:43.79,1:04:45.50,Default,,0,0,0,,Бұл орындалмады
Dialogue: 0,1:04:46.88,1:04:51.92,Default,,0,0,0,,Құпия ұстадым... Барабан соққан шығар.
Dialogue: 0,1:04:52.05,1:04:53.97,Default,,0,0,0,,Бұл барабан емес.
Dialogue: 0,1:04:54.18,1:04:56.97,Default,,0,0,0,,Мен барамын, құпия болса да бәрібір.
Dialogue: 0,1:04:57.93,1:05:00.68,Default,,0,0,0,,Мен не болса да, кез келген уақытта барамын.
Dialogue: 0,1:05:01.39,1:05:02.73,Default,,0,0,0,,Сол жерде
Dialogue: 0,1:05:04.56,1:05:07.40,Default,,0,0,0,,Джинтан тағы да жылады
Dialogue: 0,1:05:09.36,1:05:14.70,Default,,0,0,0,,Бірақ, Менма, маған Джинтанның күлімдеген жүзі ұнайды.
Dialogue: 0,1:05:15.66,1:05:16.49,Default,,0,0,0,,Га
Dialogue: 0,1:05:16.62,1:05:20.24,Default,,0,0,0,,Қоштасатын кез келді деп ойлаймын...
Dialogue: 0,1:05:21.25,1:05:22.20,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,1:05:22.33,1:05:23.62,Default,,0,0,0,,Әлі жоқ, күте тұрыңыз!
Dialogue: 0,1:05:23.75,1:05:24.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:25.00,1:05:26.96,Default,,0,0,0,,Мен мұны жалғыз істей алмаймын
Dialogue: 0,1:05:29.21,1:05:31.21,Default,,0,0,0,,Мен сенімен танысқым келді.
Dialogue: 0,1:05:31.96,1:05:33.97,Default,,0,0,0,,Мен сенімен әрқашан кездескім келді
Dialogue: 0,1:05:34.09,1:05:36.05,Default,,0,0,0,,Мен сенің атыңды атағым келді
Dialogue: 0,1:05:36.76,1:05:38.64,Default,,0,0,0,,Мен сізден кешірім сұрағым келді.
Dialogue: 0,1:05:39.14,1:05:40.10,Default,,0,0,0,,Мен сені сүйемін деп айтқым келді
Dialogue: 0,1:05:40.22,1:05:41.06,Default,,0,0,0,,Цзиньтан
Dialogue: 0,1:05:41.22,1:05:42.06,Default,,0,0,0,,Бірақ
Dialogue: 0,1:05:42.56,1:05:46.60,Default,,0,0,0,,Барлығы бірдей болды. Сен барлығына ұнадың.
Dialogue: 0,1:05:46.94,1:05:49.11,Default,,0,0,0,,Барлығы сенімен танысқысы келді!
Dialogue: 0,1:05:49.69,1:05:52.99,Default,,0,0,0,,Барлығы сені күтуде, бізді күтуде.
Dialogue: 0,1:05:53.11,1:05:56.45,Default,,0,0,0,,Мм... біздің жерде.
Dialogue: 0,1:06:05.79,1:06:06.71,Default,,0,0,0,,Аа...
Dialogue: 0,1:06:08.29,1:06:12.67,Default,,0,0,0,,(Цзиньтанның ауыр тыныс алуы)
Dialogue: 0,1:06:29.23,1:06:30.52,Default,,0,0,0,,Цзиньтан
Dialogue: 0,1:06:30.65,1:06:33.15,Default,,0,0,0,,Мен сенің тілегіңді орындағым келді.
Dialogue: 0,1:06:33.28,1:06:34.44,Default,,0,0,0,,Мен Джинтанды жақсы көремін
Dialogue: 0,1:06:35.11,1:06:37.53,Default,,0,0,0,,Бірақ кенеттен
Dialogue: 0,1:06:37.66,1:06:39.62,Default,,0,0,0,,Менма көңілді болды
Dialogue: 0,1:06:40.28,1:06:42.79,Default,,0,0,0,,Мен сенімен мәңгі бірге болдым...
Dialogue: 0,1:06:43.08,1:06:48.42,Default,,0,0,0,,Мен мұны үнемі жасай алғым келеді.
Dialogue: 0,1:06:50.17,1:06:51.79,Default,,0,0,0,,Дж... Джинтан?
Dialogue: 0,1:06:51.92,1:06:54.92,Default,,0,0,0,,Хахаха
Dialogue: 0,1:06:55.05,1:06:56.34,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,1:06:59.47,1:07:01.43,Default,,0,0,0,,Менма? Менма!
Dialogue: 0,1:07:01.93,1:07:03.93,Default,,0,0,0,,Менма! Эй Джинтан?
Dialogue: 0,1:07:05.47,1:07:06.98,Default,,0,0,0,,Иә Цзиньтан
Dialogue: 0,1:07:07.35,1:07:09.15,Default,,0,0,0,,О, о, бұл жаман.
Dialogue: 0,1:07:09.27,1:07:12.23,Default,,0,0,0,,Сонда да күн ешқашан батпайды.
Dialogue: 0,1:07:12.36,1:07:13.73,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:07:13.94,1:07:18.03,Default,,0,0,0,,Соңында барлық отшашулар жойылды.
Dialogue: 0,1:07:18.15,1:07:20.57,Default,,0,0,0,,Ал, мен тыныш күтуім керек шығар.
Dialogue: 0,1:07:21.03,1:07:22.74,Default,,0,0,0,,Рахмет Цуруко
Dialogue: 0,1:07:22.87,1:07:23.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:25.20,1:07:26.04,Default,,0,0,0,,Бұл
Dialogue: 0,1:07:27.58,1:07:29.42,Default,,0,0,0,,Менма кружкасы?
Dialogue: 0,1:07:30.04,1:07:31.71,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:07:31.83,1:07:33.88,Default,,0,0,0,,Оған мұндай нәрсе ұнайтын сияқты...
Dialogue: 0,1:07:34.00,1:07:36.09,Default,,0,0,0,,Мен оны мүлде байқамадым
Dialogue: 0,1:07:37.92,1:07:39.51,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:07:39.68,1:07:43.14,Default,,0,0,0,,Мен де, Менма қасында болғанда...
Dialogue: 0,1:07:43.51,1:07:45.43,Default,,0,0,0,,Мен бұл туралы ешқашан ойламадым.
Dialogue: 0,1:07:46.81,1:07:48.35,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,1:07:48.81,1:07:50.60,Default,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,1:07:50.73,1:07:52.40,Default,,0,0,0,,Өйткені бұл үлкен мәселе.
Dialogue: 0,1:07:52.52,1:07:54.07,Default,,0,0,0,,Біз күткенше, бәрі—
Dialogue: 0,1:07:54.40,1:07:55.94,Default,,0,0,0,,Жасырынбақ ойнаймыз ба?
Dialogue: 0,1:07:58.44,1:07:59.90,Default,,0,0,0,,Осы аралдағы шайтандар…
Dialogue: 0,1:08:00.95,1:08:02.62,Default,,0,0,0,,Жауап бере алмады
Dialogue: 0,1:08:03.24,1:08:06.83,Default,,0,0,0,,Поппо неге олай айтты?
Dialogue: 0,1:08:07.91,1:08:11.54,Default,,0,0,0,,Түсіндім, бірақ саған ұнамайтынын түсіндім.
Dialogue: 0,1:08:16.55,1:08:17.42,Default,,0,0,0,,Жақсы болуы мүмкін
Dialogue: 0,1:08:17.55,1:08:18.92,Default,,0,0,0,,О, не?
Dialogue: 0,1:08:19.42,1:08:20.67,Default,,0,0,0,,Иә.
Dialogue: 0,1:08:22.80,1:08:23.64,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:24.01,1:08:25.30,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:36.11,1:08:38.44,Default,,0,0,0,,Тас, қағаз, қайшы Пон
Dialogue: 0,1:08:39.32,1:08:40.15,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:08:40.28,1:08:41.78,Default,,0,0,0,,Поппо, менің ойымша, мен әзірге құйып жіберемін.
Dialogue: 0,1:08:42.53,1:08:44.41,Default,,0,0,0,,Содан бері ол өзгерген жоқ.
Dialogue: 0,1:08:44.53,1:08:46.45,Default,,0,0,0,,Оны түсіну өте оңай.
Dialogue: 0,1:08:46.58,1:08:48.33,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:08:50.20,1:08:53.50,Default,,0,0,0,,Немесе... бұл жасырынбақ.
Dialogue: 0,1:08:54.17,1:08:57.21,Default,,0,0,0,,Не... жасырынбақ деген не?
Dialogue: 0,1:08:57.50,1:09:00.67,Default,,0,0,0,,Цзиньтан Мэнма Сіз жасырынбақ ойнайсыз ба?
Dialogue: 0,1:09:00.80,1:09:02.30,Default,,0,0,0,,Ішің ауырған сияқты... әлгі... өзіңді өзің бүлдіріп алған жоқсың ғой?
Dialogue: 0,1:09:03.63,1:09:05.43,Default,,0,0,0,,Сәлем Джинтан! аздап!
Dialogue: 0,1:09:05.55,1:09:07.30,Default,,0,0,0,,Менма!
Dialogue: 0,1:09:07.43,1:09:08.64,Default,,0,0,0,,Әй, біз де
Dialogue: 0,1:09:08.76,1:09:09.89,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,1:09:10.02,1:09:11.18,Default,,0,0,0,,Иә
Dialogue: 0,1:09:12.10,1:09:15.02,Default,,0,0,0,,Иә, жасырынбақ ойнасақ
Dialogue: 0,1:09:15.15,1:09:16.61,Default,,0,0,0,,80…
Dialogue: 0,1:09:16.73,1:09:17.86,Default,,0,0,0,,көрінеді
Dialogue: 0,1:09:17.98,1:09:19.36,Default,,0,0,0,,82…
Dialogue: 0,1:09:19.94,1:09:21.78,Default,,0,0,0,,Мен сонда болдым
Dialogue: 0,1:09:21.90,1:09:24.78,Default,,0,0,0,,Біз ұзақ уақыт көре алмаған Менма
Dialogue: 0,1:09:26.41,1:09:29.83,Default,,0,0,0,,Бірақ жасырынбақ ойнасақ...
Dialogue: 0,1:09:29.95,1:09:30.91,Default,,0,0,0,,көрінеді
Dialogue: 0,1:09:31.04,1:09:33.16,Default,,0,0,0,,91 92…
Dialogue: 0,1:09:33.33,1:09:34.75,Default,,0,0,0,,Өтінемін, осы екеуін қорға
Dialogue: 0,1:09:35.54,1:09:39.42,Default,,0,0,0,,Әрбір супер бейбітшілікті бұзатындарға
Dialogue: 0,1:09:41.46,1:09:42.55,Default,,0,0,0,,Және…
Dialogue: 0,1:09:43.01,1:09:45.01,Default,,0,0,0,,99 100！
Dialogue: 0,1:09:45.13,1:09:46.89,Default,,0,0,0,,Бұл жерге қайта барыңыз
Dialogue: 0,1:09:47.80,1:09:49.51,Default,,0,0,0,,Менма қайтып келе жатқан сияқты
Dialogue: 0,1:09:49.64,1:09:52.68,Default,,0,0,0,,Жетеді ме?
Dialogue: 0,1:10:00.40,1:10:03.74,Default,,0,0,0,,Әлі емес... әлі жоқ.
Dialogue: 0,1:10:07.11,1:10:09.78,Default,,0,0,0,,Әлі де дұрыс...
Dialogue: 0,1:10:09.91,1:10:11.12,Default,,0,0,0,,Мен қоштасуым керек
Dialogue: 0,1:10:11.24,1:10:13.25,Default,,0,0,0,,Менма!
Dialogue: 0,1:10:13.37,1:10:15.50,Default,,0,0,0,,Менма!
Dialogue: 0,1:10:16.92,1:10:19.75,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:10:20.54,1:10:23.59,Default,,0,0,0,,Иә, әлі емес...
Dialogue: 0,1:10:24.47,1:10:27.43,Default,,0,0,0,,Барлығы мені күтіп отырды.
Dialogue: 0,1:10:28.64,1:10:31.10,Default,,0,0,0,,Менма да...
Dialogue: 0,1:10:38.98,1:10:39.94,Default,,0,0,0,,Юкиацу
Dialogue: 0,1:10:40.40,1:10:42.15,Default,,0,0,0,,Менма!
Dialogue: 0,1:10:43.32,1:10:46.45,Default,,0,0,0,,Юкиацу қызға ұқсайды.
Dialogue: 0,1:10:46.90,1:10:49.66,Default,,0,0,0,,Менма Мен әдемі деп ойладым.
Dialogue: 0,1:10:50.41,1:10:56.08,Default,,0,0,0,,Оның үстіне барғанда жүрегің өте әдемі.
Dialogue: 0,1:10:57.08,1:10:58.29,Default,,0,0,0,,Хехе
Dialogue: 0,1:10:58.42,1:11:00.04,Default,,0,0,0,,Уф, оқ-дәрі астында қалып қоюдың өзі бір әлем екен
Dialogue: 0,1:11:03.34,1:11:04.38,Default,,0,0,0,,Анару
Dialogue: 0,1:11:04.51,1:11:05.34,Default,,0,0,0,,Менма!
Dialogue: 0,1:11:05.46,1:11:09.93,Default,,0,0,0,,Анар сенімді, жүрегі жылы адам.
Dialogue: 0,1:11:11.10,1:11:15.72,Default,,0,0,0,,Менменмен бірге болғанымда, мен бұзылдым.
Dialogue: 0,1:11:16.27,1:11:17.35,Default,,0,0,0,,Ой... ой
Dialogue: 0,1:11:22.11,1:11:23.02,Default,,0,0,0,,Цуруко бұл...
Dialogue: 0,1:11:23.40,1:11:24.23,Default,,0,0,0,,Менма!
Dialogue: 0,1:11:24.61,1:11:28.24,Default,,0,0,0,,Менмаға әрқашан мейірімді болатын.
Dialogue: 0,1:11:28.82,1:11:34.41,Default,,0,0,0,,Менмане, егер мен реинкарнациялансам, мен Цуруко сияқты болғым келеді.
Dialogue: 0,1:11:34.91,1:11:36.50,Default,,0,0,0,,Менма!
Dialogue: 0,1:11:38.08,1:11:39.29,Default,,0,0,0,,Поппо
Dialogue: 0,1:11:40.29,1:11:41.21,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:42.33,1:11:46.63,Default,,0,0,0,,Поппо әрқашан бәрін қызықты етеді
Dialogue: 0,1:11:49.01,1:11:54.31,Default,,0,0,0,,Менмане, қатты күлгенім сонша, ішім ауырды.
Dialogue: 0,1:11:55.56,1:11:57.10,Default,,0,0,0,,Я...
Dialogue: 0,1:12:01.94,1:12:06.86,Default,,0,0,0,,Менмане, бәріңізбен бірге болғаным маған өте қызық болды.
Dialogue: 0,1:12:06.98,1:12:07.86,Default,,0,0,0,,Менма
Dialogue: 0,1:12:09.24,1:12:12.07,Default,,0,0,0,,Мен бір нәрсені байқадым.
Dialogue: 0,1:12:13.20,1:12:14.87,Default,,0,0,0,,Менма осында болғанда —
Dialogue: 0,1:12:15.12,1:12:19.50,Default,,0,0,0,,Менің ойымша, бәрі мұңаяды.
Dialogue: 0,1:12:20.87,1:12:23.96,Default,,0,0,0,,Бұрын мен Мейко Хонмаға үнемі еліктейтінмін.
Dialogue: 0,1:12:25.46,1:12:29.42,Default,,0,0,0,,Ши... Қайтыс болған баланың атын осылай жеңіл атама!
Dialogue: 0,1:12:32.47,1:12:35.51,Default,,0,0,0,,Менма пайда болса, менің алдымда болар еді.
Dialogue: 0,1:12:35.80,1:12:38.02,Default,,0,0,0,,Бетперде болсам да, Қарғыс айтсам да
Dialogue: 0,1:12:38.52,1:12:39.39,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,1:12:39.89,1:12:41.73,Default,,0,0,0,,Менің алдымда!
Dialogue: 0,1:12:41.85,1:12:45.77,Default,,0,0,0,,Джинтан ғана емес, менің де алдымнан көрініңізші.
Dialogue: 0,1:12:46.44,1:12:49.44,Default,,0,0,0,,Әпке, сырғып кететін жер бар.
Dialogue: 0,1:12:49.90,1:12:53.86,Default,,0,0,0,,Сіз өлгеніңізді түсінбеуіңіз мүмкін.
Dialogue: 0,1:12:53.99,1:12:55.95,Default,,0,0,0,,Қазір маған үзіліс беріңіз.
Dialogue: 0,1:12:56.58,1:12:59.41,Default,,0,0,0,,Жаныңда жүргенде маған ұнамайтын нәрселер...
Dialogue: 0,1:13:00.20,1:13:02.12,Default,,0,0,0,,Жаман нәрселерді еске түсіру
Dialogue: 0,1:13:03.96,1:13:05.38,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,1:13:06.00,1:13:10.71,Default,,0,0,0,,Менмаға бәрі қайғырады.
Dialogue: 0,1:13:11.05,1:13:13.88,Default,,0,0,0,,Мен мұны енді қаламаймын деп ойладым.
Dialogue: 0,1:13:19.97,1:13:22.85,Default,,0,0,0,,Бірақ... Джинтан
Dialogue: 0,1:13:22.98,1:13:24.02,Default,,0,0,0,,Менма
Dialogue: 0,1:13:25.23,1:13:27.73,Default,,0,0,0,,Джинтан қатты ашуланды.
Dialogue: 0,1:13:28.36,1:13:30.07,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,1:13:32.15,1:13:35.24,Default,,0,0,0,,Сіз әрқашан басқа адамдарға осындай қамқорлық жасайсыз.
Dialogue: 0,1:13:35.36,1:13:36.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:36.32,1:13:38.78,Default,,0,0,0,,Өзіңіз туралы көбірек ойлаңыз!
Dialogue: 0,1:13:38.91,1:13:42.16,Default,,0,0,0,,Мен... Мұндай көзқарас тітіркендіреді!
Dialogue: 0,1:13:42.96,1:13:46.58,Default,,0,0,0,,Мен ренжісем де, күлемін
Dialogue: 0,1:13:46.79,1:13:48.25,Default,,0,0,0,,Мен жыласам, бұл тек адамдар туралы
Dialogue: 0,1:13:48.38,1:13:51.55,Default,,0,0,0,,Мен неге сонша айқайлап жатырмын ...
Dialogue: 0,1:13:51.67,1:13:53.26,Default,,0,0,0,,Цзиньтан…
Dialogue: 0,1:13:53.38,1:13:54.26,Default,,0,0,0,,Мен ЖоЖомен шайқасуға оралдым!
Dialogue: 0,1:13:55.43,1:13:59.81,Default,,0,0,0,,Менма, кешіріңіз, мен сізді көптен бері танымай қалдым.
Dialogue: 0,1:14:00.43,1:14:04.44,Default,,0,0,0,,Цзиньтан Мэнманың өтінішін орындау үшін...
Dialogue: 0,1:14:04.64,1:14:07.31,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,1:14:11.07,1:14:12.61,Default,,0,0,0,,Мұнда жаңа келді!
Dialogue: 0,1:14:12.73,1:14:14.61,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:18.12,1:14:20.41,Default,,0,0,0,,Олай болса, осында кел. Иә!
Dialogue: 0,1:14:21.58,1:14:23.75,Default,,0,0,0,,Ол қолынан келгеннің бәрін жасайды
Dialogue: 0,1:14:25.37,1:14:26.54,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:14:26.92,1:14:29.84,Default,,0,0,0,,Жарайды, Джинтан
Dialogue: 0,1:14:32.50,1:14:33.67,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:37.13,1:14:43.14,Default,,0,0,0,,Менма өзі туралы ойламағанша
Dialogue: 0,1:14:43.56,1:14:47.35,Default,,0,0,0,,Цзиньтан Мэнманы ойлап отырды.
Dialogue: 0,1:14:47.48,1:14:48.48,Default,,0,0,0,,Уау
Dialogue: 0,1:14:49.81,1:14:52.15,Default,,0,0,0,,Әй, қадамыңды байқа!
Dialogue: 0,1:14:52.27,1:14:53.61,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,1:14:54.69,1:14:55.53,Default,,0,0,0,,Уау
Dialogue: 0,1:15:04.16,1:15:05.04,Default,,0,0,0,,Га
Dialogue: 0,1:15:07.33,1:15:08.42,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:15:09.67,1:15:10.79,Default,,0,0,0,,Алайда, құстарда ауа қапшықтары деп аталатын құрылымдар да бар—
Dialogue: 0,1:15:10.92,1:15:13.59,Default,,0,0,0,,Жарықтың бағытын ерікті түрде өзгертуге болмайды.
Dialogue: 0,1:15:13.75,1:15:14.71,Default,,0,0,0,,Рука, сен күнде қылыш айналдыру жаттығуын жасап жүрсің ғой?
Dialogue: 0,1:15:14.84,1:15:16.88,Default,,0,0,0,,Жел ме?
Dialogue: 0,1:15:17.01,1:15:19.68,Default,,0,0,0,,Жел жарықты жылжытады ма?
Dialogue: 0,1:15:24.43,1:15:26.02,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:15:26.77,1:15:29.02,Default,,0,0,0,,Жылтыр жылтыр джинтан
Dialogue: 0,1:15:34.94,1:15:36.61,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:15:39.28,1:15:44.66,Default,,0,0,0,,Өйткені Джинтан Менма үшін барын салуда.
Dialogue: 0,1:15:45.20,1:15:46.25,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:15:47.41,1:15:49.83,Default,,0,0,0,,Сондықтан Менма—
Dialogue: 0,1:15:50.46,1:15:54.63,Default,,0,0,0,,Өтінемін, есіме түсіп жатырмын, айта алмадым.
Dialogue: 0,1:15:56.34,1:15:57.67,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:16:01.51,1:16:04.72,Default,,0,0,0,,Менма, күттіңіз бе?
Dialogue: 0,1:16:09.48,1:16:10.69,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,1:16:10.81,1:16:12.23,Default,,0,0,0,,Хмм.
Dialogue: 0,1:16:15.98,1:16:17.19,Default,,0,0,0,,Тырнақтар қап-қара!
Dialogue: 0,1:16:17.32,1:16:18.69,Default,,0,0,0,,Оны тіс тазалағышпен алуға болады.
Dialogue: 0,1:16:18.90,1:16:19.95,Default,,0,0,0,,О, жарайды.
Dialogue: 0,1:16:20.07,1:16:21.82,Default,,0,0,0,,Қабыл ал!
Dialogue: 0,1:16:23.24,1:16:24.37,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:16:25.03,1:16:28.37,Default,,0,0,0,,Тілегім орындалса, Менма...
Dialogue: 0,1:16:28.50,1:16:29.33,Default,,0,0,0,,Бұл
Dialogue: 0,1:16:29.45,1:16:31.83,Default,,0,0,0,,Кешіріңіз, кешіріңіз, сәл артық.
Dialogue: 0,1:16:33.96,1:16:35.88,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:36.13,1:16:38.42,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,1:16:39.05,1:16:41.38,Default,,0,0,0,,Өйткені Менманың қалауы осы.
Dialogue: 0,1:16:43.26,1:16:44.22,Default,,0,0,0,,Өзің бар
Dialogue: 0,1:16:45.30,1:16:46.56,Default,,0,0,0,,Мен...
Dialogue: 0,1:16:47.18,1:16:48.02,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:48.14,1:16:49.22,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:16:49.77,1:16:51.23,Default,,0,0,0,,Джинтан?
Dialogue: 0,1:16:51.64,1:16:53.35,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,1:16:54.31,1:16:56.48,Default,,0,0,0,,Не болды? Сонша ауыртты ма?
Dialogue: 0,1:16:56.82,1:16:58.61,Default,,0,0,0,,Жоқ... а
Dialogue: 0,1:17:00.15,1:17:04.78,Default,,0,0,0,,Фландрия иті есіме түсті...
Dialogue: 0,1:17:04.91,1:17:05.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:05.87,1:17:08.37,Default,,0,0,0,,Patrasche туралы...
Dialogue: 0,1:17:08.49,1:17:09.54,Default,,0,0,0,,Патраше?
Dialogue: 0,1:17:09.95,1:17:11.29,Default,,0,0,0,,Фландрия
Dialogue: 0,1:17:11.41,1:17:16.00,Default,,0,0,0,,Баяғыда... қайта трансляцияланып жатқан
Dialogue: 0,1:17:16.13,1:17:21.09,Default,,0,0,0,,Менің ойымша, бұл өте өтірік, бірақ...
Dialogue: 0,1:17:21.21,1:17:22.42,Default,,0,0,0,,Цзиньтан…
Dialogue: 0,1:17:22.92,1:17:23.93,Default,,0,0,0,,Джинтан!
Dialogue: 0,1:17:24.05,1:17:28.14,Default,,0,0,0,,Патраше бақытты болғанына сенімдімін.
Dialogue: 0,1:17:28.47,1:17:29.39,Default,,0,0,0,,Иә
Dialogue: 0,1:17:30.81,1:17:35.27,Default,,0,0,0,,Өйткені Нерон маған көп мейірімді болды, солай ма?
Dialogue: 0,1:17:35.40,1:17:36.61,Default,,0,0,0,,Біз дос болдық, солай ма?
Dialogue: 0,1:17:36.73,1:17:38.36,Default,,0,0,0,,Сол себепті?
Dialogue: 0,1:17:38.48,1:17:40.07,Default,,0,0,0,,(Танжиро) Жарайды, бәрі қалыпты. Үйге кет, уайымдама.
Dialogue: 0,1:17:40.19,1:17:45.61,Default,,0,0,0,,(Джинтанның жылағаны)
Dialogue: 0,1:17:45.74,1:17:46.82,Default,,0,0,0,,Ха...
Dialogue: 0,1:17:50.04,1:17:51.24,Default,,0,0,0,,Менма-чан
Dialogue: 0,1:18:04.63,1:18:06.55,Default,,0,0,0,,Менманың өтініші
Dialogue: 0,1:18:07.30,1:18:10.89,Default,,0,0,0,,Цзиньтанның анасының өтініші
Dialogue: 0,1:18:14.10,1:18:19.31,Default,,0,0,0,,Мен жүзеге асырғым келген Менма Цзинтан туралы—
Dialogue: 0,1:18:19.44,1:18:21.27,Default,,0,0,0,,Мен сені жылатқым келді
Dialogue: 0,1:18:24.15,1:18:25.40,Default,,0,0,0,,Себебі—
Dialogue: 0,1:18:26.66,1:18:31.16,Default,,0,0,0,,Сол күні Джинтан менің қолымнан ұстады.
Dialogue: 0,1:18:35.79,1:18:41.92,Default,,0,0,0,,Сол күні Цзиньтан Менмаға уәде берді
Dialogue: 0,1:18:44.30,1:18:46.72,Default,,0,0,0,,Сізде құпия база бар.
Dialogue: 0,1:18:47.01,1:18:47.84,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:48.68,1:18:51.05,Default,,0,0,0,,Super Peace Busters құпия негізі
Dialogue: 0,1:18:51.56,1:18:53.81,Default,,0,0,0,,Барлығы кез келген уақытта қайтып келе алатын орын
Dialogue: 0,1:18:57.10,1:18:58.02,Default,,0,0,0,,Сонымен
Dialogue: 0,1:19:03.07,1:19:08.20,Default,,0,0,0,,Менма Цзинтанға келгеніңізге сенімдімін.
Dialogue: 0,1:19:09.41,1:19:11.66,Default,,0,0,0,,Менма!
Dialogue: 0,1:19:15.75,1:19:17.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:23.67,1:19:26.76,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:19:30.01,1:19:33.01,Default,,0,0,0,,Тағы да...
Dialogue: 0,1:19:35.93,1:19:39.14,Default,,0,0,0,,Тағы да...
Dialogue: 0,1:19:39.77,1:19:44.61,Default,,0,0,0,,(Цзиньтанның ауыр тыныс алуы)
Dialogue: 0,1:19:44.73,1:19:47.36,Default,,0,0,0,,Хахаха
Dialogue: 0,1:19:49.70,1:19:52.53,Default,,0,0,0,,Джинтан! Қалай ойлайсың, Менма?
Dialogue: 0,1:19:53.37,1:19:54.49,Default,,0,0,0,,Бұл аяқ...
Dialogue: 0,1:19:57.83,1:19:58.87,Default,,0,0,0,,Цзиньтан…
Dialogue: 0,1:20:00.29,1:20:03.04,Default,,0,0,0,,Өйткені, Менма қазірдің өзінде осында.
Dialogue: 0,1:20:04.21,1:20:05.09,Default,,0,0,0,,Кук
Dialogue: 0,1:20:07.96,1:20:08.80,Default,,0,0,0,,Ах
Dialogue: 0,1:20:10.38,1:20:11.97,Default,,0,0,0,,Ах, Маеда әлі тірі екені
Dialogue: 0,1:20:15.85,1:20:17.68,Default,,0,0,0,,Бұл... бұл
Dialogue: 0,1:20:17.81,1:20:19.06,Default,,0,0,0,,Күнделік
Dialogue: 0,1:20:19.23,1:20:21.52,Default,,0,0,0,,Бұл кейіпкер Менма
Dialogue: 0,1:20:21.65,1:20:22.48,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,1:20:28.24,1:20:29.65,Default,,0,0,0,,Менма…
Dialogue: 0,1:20:29.82,1:20:40.87,Default,,0,0,0,,♪～
Dialogue: 0,1:20:41.29,1:20:43.88,Default,,0,0,0,,Уау!
Dialogue: 0,1:20:49.63,1:20:53.47,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:21:00.81,1:21:02.89,Default,,0,0,0,,Дәл уақытында...
Dialogue: 0,1:21:04.56,1:21:08.94,Default,,0,0,0,,Бұл жолы дұрыс қоштаса білдім.
Dialogue: 0,1:21:09.57,1:21:10.61,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,1:21:10.74,1:21:12.11,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,1:21:13.28,1:21:15.03,Default,,0,0,0,,Бұл не? Менма!
Dialogue: 0,1:21:15.57,1:21:18.20,Default,,0,0,0,,Бұл жасырынбақ, солай ма? Егер солай болса
Dialogue: 0,1:21:19.20,1:21:22.21,Default,,0,0,0,,Мен сені таппасам, бітпейді!
Dialogue: 0,1:21:24.25,1:21:25.54,Default,,0,0,0,,Цзиньтан...
Dialogue: 0,1:21:25.79,1:21:29.34,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:21:30.21,1:21:33.30,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:21:34.80,1:21:37.64,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:21:38.22,1:21:40.89,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:21:41.43,1:21:44.52,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:21:44.98,1:21:48.06,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:21:48.36,1:21:50.61,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:21:50.73,1:21:53.95,Default,,0,0,0,,Жетеді!
Dialogue: 0,1:21:57.66,1:21:58.95,Default,,0,0,0,,Ерлер… Ағымдағы дауыс
Dialogue: 0,1:22:01.70,1:22:02.54,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:22:03.08,1:22:04.50,Default,,0,0,0,,Ерлер... Ма
Dialogue: 0,1:22:05.21,1:22:07.38,Default,,0,0,0,,Ах... Менма!
Dialogue: 0,1:22:09.25,1:22:11.46,Default,,0,0,0,,Менма шынымен бе?
Dialogue: 0,1:22:12.09,1:22:14.55,Default,,0,0,0,,Менма... Менма!
Dialogue: 0,1:22:14.67,1:22:16.43,Default,,0,0,0,,Көрінетін менма
Dialogue: 0,1:22:16.84,1:22:18.30,Default,,0,0,0,,Менма Менма
Dialogue: 0,1:22:23.06,1:22:23.98,Default,,0,0,0,,Менма
Dialogue: 0,1:22:24.89,1:22:28.15,Default,,0,0,0,,Мұндай кезде сіздің атыңызды айту басқаша.
Dialogue: 0,1:22:28.27,1:22:29.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:30.23,1:22:33.15,Default,,0,0,0,,Менма жасырынбақтан жаман.
Dialogue: 0,1:22:33.78,1:22:36.49,Default,,0,0,0,,Әй, Джинтан, дұрыстап айт.
Dialogue: 0,1:22:37.41,1:22:38.32,Default,,0,0,0,,Аспанда не болып жатыр?
Dialogue: 0,1:22:38.45,1:22:42.12,Default,,0,0,0,,Мұның соңы, солай емес пе?
Dialogue: 0,1:22:44.58,1:22:45.62,Default,,0,0,0,,Га
Dialogue: 0,1:22:48.29,1:22:50.25,Default,,0,0,0,,Мен хатты оқыдым!
Dialogue: 0,1:22:50.38,1:22:53.38,Default,,0,0,0,,Мен де сені жақсы көремін Менма!
Dialogue: 0,1:22:54.38,1:22:56.30,Default,,0,0,0,,Мен де сені жақсы көремін!
Dialogue: 0,1:22:56.84,1:22:58.18,Default,,0,0,0,,Мен Менманы жақсы көремін!
Dialogue: 0,1:22:58.64,1:23:00.26,Default,,0,0,0,,Әрине, мен де оны жақсы көремін!
Dialogue: 0,1:23:04.02,1:23:05.27,Default,,0,0,0,,Қоштасу
Dialogue: 0,1:23:05.81,1:23:08.40,Default,,0,0,0,,Бір тараптың ештеңе айтуы мүмкін емес, солай ма?
Dialogue: 0,1:23:09.02,1:23:10.86,Default,,0,0,0,,На Цзиньтан
Dialogue: 0,1:23:16.53,1:23:19.36,Default,,0,0,0,,Тілегімді орындағаныңыз үшін рахмет.
Dialogue: 0,1:23:19.99,1:23:21.87,Default,,0,0,0,,Мен сені жақсы көремін Менма
Dialogue: 0,1:23:27.71,1:23:28.58,Default,,0,0,0,,Джаббе
Dialogue: 0,1:23:28.71,1:23:29.67,Default,,0,0,0,,Ах
Dialogue: 0,1:23:30.21,1:23:31.46,Default,,0,0,0,,Ах! Қарғыс атсын
Dialogue: 0,1:23:32.71,1:23:33.75,Default,,0,0,0,,Цзиньтанга
Dialogue: 0,1:23:35.46,1:23:36.97,Default,,0,0,0,,Мені тартып тұрған қол
Dialogue: 0,1:23:37.88,1:23:42.30,Default,,0,0,0,,Менманы күткендердің күлкілері
Dialogue: 0,1:23:43.39,1:23:47.18,Default,,0,0,0,,Мен Джинтан Менманы таптым!
Dialogue: 0,1:23:49.06,1:23:51.10,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,1:23:51.56,1:23:55.07,Default,,0,0,0,,Сенің жұмсақтығың үшін.
Dialogue: 0,1:23:55.19,1:23:57.44,Default,,0,0,0,,О... кешіріңіз.
Dialogue: 0,1:24:00.66,1:24:02.82,Default,,0,0,0,,Ит үйі мұны істемейді.
Dialogue: 0,1:24:02.95,1:24:03.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:05.33,1:24:09.08,Default,,0,0,0,,Бұл Нокемон Гайжин туралы сол үй тапсырмасы туралы.
Dialogue: 0,1:24:10.29,1:24:11.96,Default,,0,0,0,,Тіпті ит үйінде жатсаңыз да...
Dialogue: 0,1:24:12.79,1:24:17.21,Default,,0,0,0,,Қайда барсаң да сені біреу міндетті түрде табады.
Dialogue: 0,1:24:19.09,1:24:20.22,Default,,0,0,0,,(Ол Майт) Уг!? (Презент Майк) Эй, эй, не болып жатыр!?
Dialogue: 0,1:24:24.47,1:24:26.47,Default,,0,0,0,,Цзиньтан…
Dialogue: 0,1:24:27.10,1:24:28.27,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:28.68,1:24:30.98,Default,,0,0,0,,Цзинтан Мен Менманы тағы да жылаттым!
Dialogue: 0,1:24:31.23,1:24:32.06,Default,,0,0,0,,Цзиньтан
Dialogue: 0,1:24:32.31,1:24:34.61,Default,,0,0,0,,Сәлем! ?
Dialogue: 0,1:24:34.73,1:24:37.94,Default,,0,0,0,,Мені жылатып жылатты
Dialogue: 0,1:24:38.07,1:24:39.44,Default,,0,0,0,,Поппо
Dialogue: 0,1:24:39.57,1:24:41.28,Default,,0,0,0,,Сен маған опасыздық жасадың!
Dialogue: 0,1:24:41.40,1:24:43.41,Default,,0,0,0,,Джинтан Жақсы емес! Қазірдің өзінде
Dialogue: 0,1:24:49.00,1:24:50.33,Default,,0,0,0,,Цзиньтан…
Dialogue: 0,1:24:51.29,1:24:54.13,Default,,0,0,0,,Менма есімде
Dialogue: 0,1:24:54.46,1:24:59.01,Default,,0,0,0,,Барлық супер бейбітшілікті бұзатындар әрқашан...
Dialogue: 0,1:24:59.13,1:25:02.55,Default,,0,0,0,,Менма туралы білемін деді.
Dialogue: 0,1:25:03.38,1:25:04.34,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:25:05.39,1:25:06.26,Default,,0,0,0,,Менмане!
Dialogue: 0,1:25:06.39,1:25:07.31,Default,,0,0,0,,Ха...
Dialogue: 0,1:25:07.89,1:25:11.98,Default,,0,0,0,,Мен барлығымен көбірек болғым келеді
Dialogue: 0,1:25:13.23,1:25:14.77,Default,,0,0,0,,Мен ойнағым келеді
Dialogue: 0,1:25:15.81,1:25:19.53,Default,,0,0,0,,Сонымен... қайта туыл
Dialogue: 0,1:25:20.11,1:25:24.11,Default,,0,0,0,,Барлығымен бірге... Наруно
Dialogue: 0,1:25:25.07,1:25:26.45,Default,,0,0,0,,Сонымен
Dialogue: 0,1:25:26.87,1:25:29.58,Default,,0,0,0,,Джинтан... Мен жыладым
Dialogue: 0,1:25:30.12,1:25:31.87,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:25:32.91,1:25:34.17,Default,,0,0,0,,Сол себепті!
Dialogue: 0,1:25:36.71,1:25:40.09,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:25:40.88,1:25:45.01,Default,,0,0,0,,Мен Менманы таптым!
Dialogue: 0,1:25:49.06,1:25:51.93,Default,,0,0,0,,Мен табылдым...
Dialogue: 0,1:25:53.35,1:25:56.44,Default,,0,0,0,,Менма күткендей...
Dialogue: 0,1:26:29.85,1:26:34.52,Default,,0,0,0,,мәңгі
Dialogue: 0,1:26:35.48,1:26:36.73,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,1:26:36.85,1:26:38.31,Default,,0,0,0,,～♪
Dialogue: 0,1:26:44.11,1:26:46.61,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:26:46.78,1:26:49.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:26:49.57,1:26:52.16,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:26:52.29,1:26:53.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:55.91,1:26:57.29,Default,,0,0,0,,Иә? Эх...
Dialogue: 0,1:26:57.42,1:26:59.08,Default,,0,0,0,,J… Жетеді!
Dialogue: 0,1:26:59.21,1:27:00.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:00.21,1:27:01.67,Default,,0,0,0,,Эй... тездетіп, сол жерге жина.
Dialogue: 0,1:27:01.79,1:27:03.00,Default,,0,0,0,,Иә? Не... неге сен?
Dialogue: 0,1:27:03.13,1:27:03.96,Default,,0,0,0,,Тағы қайдасың...
Dialogue: 0,1:27:04.09,1:27:06.38,Default,,0,0,0,,Оған уақытыңыз жоқ. Асықшы!
Dialogue: 0,1:27:06.76,1:27:07.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:27:08.55,1:27:11.14,Default,,0,0,0,,Мен олардың әрқайсысын іздеймін!
Dialogue: 0,1:27:12.22,1:27:13.43,Default,,0,0,0,,Осы жолмен!
Dialogue: 0,1:27:13.56,1:27:16.43,Default,,0,0,0,,（）
Dialogue: 0,1:27:16.60,1:27:17.77,Default,,0,0,0,,Я...
Dialogue: 0,1:27:18.60,1:27:19.85,Default,,0,0,0,,Өзі... өзім істеймін.
Dialogue: 0,1:27:20.19,1:27:21.11,Default,,0,0,0,,Иә
Dialogue: 0,1:27:25.44,1:27:26.78,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:26.90,1:27:31.12,Default,,0,0,0,,Білесің бе... Джинтан
Dialogue: 0,1:27:36.45,1:27:37.37,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:39.21,1:27:40.25,Default,,0,0,0,,Джинтан?
Dialogue: 0,1:27:41.46,1:27:42.34,Default,,0,0,0,,Ах
Dialogue: 0,1:27:43.71,1:27:46.67,Default,,0,0,0,,Мен бұл екеніне сенімдімін.
Dialogue: 0,1:27:46.80,1:27:47.72,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:48.93,1:27:50.97,Default,,0,0,0,,Бұл анамның өтініші емес...
Dialogue: 0,1:27:52.05,1:27:55.31,Default,,0,0,0,,Менманың өтініші.
Dialogue: 0,1:27:59.48,1:28:00.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:28:01.69,1:28:02.52,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,1:28:02.65,1:28:03.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:03.61,1:28:04.44,Default,,0,0,0,,Анал...
Dialogue: 0,1:28:04.57,1:28:06.07,Default,,0,0,0,,Не? О... эй
Dialogue: 0,1:28:06.53,1:28:08.53,Default,,0,0,0,,Хмм, ол қайда?
Dialogue: 0,1:28:08.65,1:28:10.28,Default,,0,0,0,,О
Dialogue: 0,1:28:14.83,1:28:16.62,Default,,0,0,0,,Эй... эй
Dialogue: 0,1:28:17.20,1:28:18.33,Default,,0,0,0,,Эй, сен
Dialogue: 0,1:28:18.45,1:28:20.71,Default,,0,0,0,,Жасынбақ ойнағанда қандай батыл қимыл.
Dialogue: 0,1:28:20.83,1:28:23.25,Default,,0,0,0,,О, қараңдаршы!
Dialogue: 0,1:28:23.38,1:28:24.29,Default,,0,0,0,,Иии!
Dialogue: 0,1:28:24.59,1:28:25.42,Default,,0,0,0,,Ашсың ба? Міне, Майкл мен Принс
Dialogue: 0,1:28:25.55,1:28:27.67,Default,,0,0,0,,Джинтан Микке!
Dialogue: 0,1:28:27.80,1:28:30.09,Default,,0,0,0,,Әй
Dialogue: 0,1:28:30.22,1:28:31.76,Default,,0,0,0,,А, сен кінәлісің.
Dialogue: 0,1:28:31.97,1:28:34.93,Default,,0,0,0,,Ей, қарашы, сен келесі жынсың...
Dialogue: 0,1:28:35.05,1:28:36.51,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,1:28:37.47,1:28:38.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:38.47,1:28:39.89,Default,,0,0,0,,Бұл «Иә?» емес.
Dialogue: 0,1:28:40.02,1:28:41.81,Default,,0,0,0,,Екеуміз бір сәт сыртқа шығайық.
Dialogue: 0,1:28:41.94,1:28:43.02,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:28:43.27,1:28:45.52,Default,,0,0,0,,Му, бұл эротикалық! қазірдің өзінде!
Dialogue: 0,1:28:46.44,1:28:48.44,Default,,0,0,0,,Не? E... эротикалық?
Dialogue: 0,1:28:48.57,1:28:49.74,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:28:49.86,1:28:51.40,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:28:51.78,1:28:52.99,Default,,0,0,0,,Соғыс күші жағынан олар сөзсіз сенімді.
Dialogue: 0,1:28:53.45,1:28:57.45,Default,,0,0,0,,Әйелдер ашылғанда қорқатыны рас.
Dialogue: 0,1:29:12.13,1:29:14.34,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,1:29:48.09,1:29:50.00,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:29:50.42,1:29:51.59,Default,,0,0,0,,Менма!
Dialogue: 0,1:29:51.71,1:29:54.55,Default,,0,0,0,,Ол дұрыс келді ме? Жауап берізші, өтінемін!
Dialogue: 0,1:29:54.68,1:29:57.51,Default,,0,0,0,,Көшбасшы.
Dialogue: 0,1:29:58.05,1:29:59.68,Default,,0,0,0,,Олай істеуді доғар.
Dialogue: 0,1:30:01.68,1:30:02.52,Default,,0,0,0,,Мен
Dialogue: 0,1:30:03.73,1:30:06.81,Default,,0,0,0,,Айтайын дегенім мен оны дұрыс жаздым.
Dialogue: 0,1:30:06.94,1:30:07.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:08.36,1:30:11.23,Default,,0,0,0,,Ол Джинтанды ұнататынын айтады.
Dialogue: 0,1:30:12.36,1:30:14.40,Default,,0,0,0,,Ұзақ уақыт үнсіз қалғаным үшін кешіріңіз
Dialogue: 0,1:30:16.32,1:30:19.24,Default,,0,0,0,,Иә, оны орындаңыз.
Dialogue: 0,1:30:21.33,1:30:24.41,Default,,0,0,0,,Мен Джинтанға әлі айта алмаймын.
Dialogue: 0,1:30:25.33,1:30:26.67,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,1:30:27.50,1:30:28.33,Default,,0,0,0,,Иә
Dialogue: 0,1:30:31.17,1:30:32.55,Default,,0,0,0,,Өйткені мен—
Dialogue: 0,1:30:32.96,1:30:36.30,Default,,0,0,0,,Маған Менма ұнайды, маған Цзинтан да ұнайды.
Dialogue: 0,1:30:40.39,1:30:41.76,Default,,0,0,0,,Хмм.
Dialogue: 0,1:30:42.01,1:30:42.89,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,1:30:43.02,1:30:43.85,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:44.68,1:30:47.85,Default,,0,0,0,,Біз әрқашан жақсы дос болдық
Dialogue: 0,1:30:48.86,1:30:51.61,Default,,0,0,0,,Сол жаз да, осы жаз да
Dialogue: 0,1:30:52.36,1:30:55.70,Default,,0,0,0,,Мәңгілік дос болып қала алсақ
Dialogue: 0,1:30:56.82,1:30:58.45,Default,,0,0,0,,Мен бір күні сенімдімін
Dialogue: 0,1:30:58.91,1:31:02.29,Default,,0,0,0,,Мен өз сезімімді білдіре алатын жаз келеді деп ойлаймын.
Dialogue: 0,1:31:05.41,1:31:07.46,Default,,0,0,0,,Мен қашып кетуім мүмкін
Dialogue: 0,1:31:07.58,1:31:08.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:08.67,1:31:09.50,Default,,0,0,0,,Эх!
Dialogue: 0,1:31:09.71,1:31:11.59,Default,,0,0,0,,Эй... Эй, эй
Dialogue: 0,1:31:11.71,1:31:12.55,Default,,0,0,0,,Бұл не, балалар...
Dialogue: 0,1:31:13.09,1:31:14.42,Default,,0,0,0,,Эй, эй!
Dialogue: 0,1:31:14.55,1:31:16.80,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:31:16.92,1:31:19.72,Default,,0,0,0,,Мені қыздардың әңгімесіне қосыңыз.
Dialogue: 0,1:31:20.05,1:31:22.56,Default,,0,0,0,,Эй, біз мұны қайталап жатырмыз.
Dialogue: 0,1:31:24.39,1:31:25.56,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,1:31:25.73,1:31:29.44,Default,,0,0,0,,Енді менің қасымда болмасаң да
Dialogue: 0,1:31:31.02,1:31:33.65,Default,,0,0,0,,Сенің осында екеніңді ойлап...
Dialogue: 0,1:31:34.23,1:31:38.20,Default,,0,0,0,,Әйтеуір, мен көрген пейзаж басқаша көрінеді.
Dialogue: 0,1:31:40.07,1:31:42.58,Default,,0,0,0,,Кішкентай нәрселер маңызды болып көрінеді
Dialogue: 0,1:31:43.91,1:31:46.66,Default,,0,0,0,,Мен бұл ешқашан жоғалмайтын нәрсе сияқты сезінемін.
Dialogue: 0,1:31:48.79,1:31:50.00,Default,,0,0,0,,Жоқ
Dialogue: 0,1:31:50.46,1:31:51.92,Default,,0,0,0,,Ах (4 адам) Иә?
Dialogue: 0,1:31:52.96,1:31:54.25,Default,,0,0,0,,Уау
Dialogue: 0,1:31:54.67,1:31:55.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:55.76,1:31:58.26,Default,,0,0,0,,Уау... жұлдыздар керемет
Dialogue: 0,1:31:58.38,1:32:00.01,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,1:32:00.97,1:32:04.68,Default,,0,0,0,,Бұл жерде жұлдыздардың көп болуы сирек.
Dialogue: 0,1:32:04.85,1:32:06.56,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:32:08.52,1:32:12.61,Default,,0,0,0,,Жоғалтатын ештеңе жоқ
Dialogue: 0,1:32:18.07,1:32:19.24,Default,,0,0,0,,Сәлем Поппо
Dialogue: 0,1:32:19.36,1:32:21.53,Default,,0,0,0,,Бұл Менманың жауабы болуы мүмкін.
Dialogue: 0,1:32:21.66,1:32:24.28,Default,,0,0,0,,О! Шынайы ма?
Dialogue: 0,1:32:24.45,1:32:25.33,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,1:32:25.49,1:32:28.62,Default,,0,0,0,,Оны ұялмай айта аламын.
Dialogue: 0,1:32:28.75,1:32:30.29,Default,,0,0,0,,Көшбасшы ретінде сезінеді.
Dialogue: 0,1:32:30.41,1:32:32.54,Default,,0,0,0,,А... бұл не?
Dialogue: 0,1:32:32.67,1:32:34.25,Default,,0,0,0,,Менің айтайын дегенім, көшбасшы...
Dialogue: 0,1:32:34.38,1:32:35.21,Default,,0,0,0,,Көшбасшы күткендей
Dialogue: 0,1:32:35.34,1:32:37.42,Default,,0,0,0,,Менма!
Dialogue: 0,1:32:38.05,1:32:42.01,Default,,0,0,0,,Жауап Мен оны толығымен қабылдадым!
Dialogue: 0,1:32:42.47,1:32:44.51,Default,,0,0,0,,(Нанами) Қолына тиген жоқсың ба? (Итадори) Иә.
Dialogue: 0,1:32:45.85,1:32:48.64,Default,,0,0,0,,Келесі жылы тағы осылай жиналайық.
Dialogue: 0,1:32:48.77,1:32:51.10,Default,,0,0,0,,О, Юкиацу, жақсы нәрсе айтасың.
Dialogue: 0,1:32:51.23,1:32:53.73,Default,,0,0,0,,Сіз келесі жылы емтихан тапсырасыз, солай ма? Менің уақытым болмауы мүмкін
Dialogue: 0,1:32:53.85,1:32:55.27,Default,,0,0,0,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,1:32:55.40,1:32:57.07,Default,,0,0,0,,Джинтан болсаң, әрқашан бос уақытың болады.
Dialogue: 0,1:32:57.19,1:32:58.03,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:32:58.15,1:33:00.95,Default,,0,0,0,,Менің уақытым жоқ! Тиісті жарнама жасаңыз.
Dialogue: 0,1:33:01.07,1:33:03.91,Default,,0,0,0,,Не? Мен ғана көтерілемін.
Dialogue: 0,1:33:04.03,1:33:05.49,Default,,0,0,0,,(Сіздің күлкіңіз)
Dialogue: 0,1:33:08.29,1:33:11.29,Default,,0,0,0,,О, бұған не болды?
Dialogue: 0,1:33:11.46,1:33:13.00,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:33:15.08,1:33:16.04,Default,,0,0,0,,Буға пісірілген нан?
Dialogue: 0,1:33:16.71,1:33:20.17,Default,,0,0,0,,Мм... Бүгін сенімен бірге сақтадым.
Dialogue: 0,1:33:20.51,1:33:21.42,Default,,0,0,0,,Ал...
Dialogue: 0,1:33:22.47,1:33:23.84,Default,,0,0,0,,Менің әпкемнің...
Dialogue: 0,1:33:23.97,1:33:25.09,Default,,0,0,0,,Келесі жолы
Dialogue: 0,1:33:26.76,1:33:28.14,Default,,0,0,0,,Сол балаларға да –
Dialogue: 0,1:33:28.26,1:33:30.77,Default,,0,0,0,,Оған маған хош иісті зат берсін деп айт.
Dialogue: 0,1:33:32.06,1:33:33.06,Default,,0,0,0,,Иә
Dialogue: 0,1:33:33.56,1:33:34.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:35.06,1:33:35.90,Default,,0,0,0,,Не?
Dialogue: 0,1:33:36.02,1:33:36.90,Default,,0,0,0,,Жоқ, солай.
Dialogue: 0,1:33:37.02,1:33:39.28,Default,,0,0,0,,Фотодағы апа күліп тұр деп ойламайсыз ба?
Dialogue: 0,1:33:39.40,1:33:41.19,Default,,0,0,0,,Сіз күліп тұрсыз, солай емес пе?
Dialogue: 0,1:33:41.32,1:33:42.61,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,1:33:42.74,1:33:45.28,Default,,0,0,0,,Әдеттегіден 20% артық.
Dialogue: 0,1:33:45.61,1:33:47.70,Default,,0,0,0,,Жүр, шомыл.
Dialogue: 0,1:33:48.28,1:33:49.45,Default,,0,0,0,,Иә
Dialogue: 0,1:33:49.58,1:33:55.58,Default,,0,0,0,,♪～
Dialogue: 0,1:38:19.93,1:38:25.94,Default,,0,0,0,,～♪
Dialogue: 0,1:38:27.81,1:38:32.19,Default,,0,0,0,,Қайта туылсаң қандай боласың?
Dialogue: 0,1:38:34.07,1:38:37.91,Default,,0,0,0,,Гүл бол, көбелек бол
Dialogue: 0,1:38:38.57,1:38:42.33,Default,,0,0,0,,Аринко болайық Оймо болайық
Dialogue: 0,1:38:43.95,1:38:46.42,Default,,0,0,0,,Қандай жағдай болса да жақсы.
Dialogue: 0,1:38:47.12,1:38:47.96,Default,,0,0,0,,Өйткені
Dialogue: 0,1:38:52.76,1:38:57.89,Default,,0,0,0,,(Цзиньтанның күлуі)
Dialogue: 0,1:38:58.14,1:39:00.43,Default,,0,0,0,,Бейбітшілікті жеңушілер
Dialogue: 0,1:39:01.14,1:39:06.60,Default,,0,0,0,,Біз әрқашан жақсы дос болдық
Dialogue: 0,1:39:08.10,1:39:14.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory