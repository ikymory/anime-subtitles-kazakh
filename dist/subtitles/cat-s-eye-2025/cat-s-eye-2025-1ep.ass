Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.67,0:00:08.67,Default,,0,0,0,,♪～
Dialogue: 0,0:00:16.97,0:00:19.47,Default,,0,0,0,,Алдыңғы қақпа Солтүстік қақпа жабық
Dialogue: 0,0:00:22.52,0:00:25.10,Default,,0,0,0,,Оңтүстік қақпа да толығымен жабылған.
Dialogue: 0,0:00:25.44,0:00:27.56,Default,,0,0,0,,Құмырсқалар кіретін бос орындар жоқ.
Dialogue: 0,0:00:28.19,0:00:30.57,Default,,0,0,0,,Жарайды, хабарландырудың уақыты жақындап қалды.
Dialogue: 0,0:00:31.07,0:00:32.53,Default,,0,0,0,,Сергек болыңыз
Dialogue: 0,0:00:45.54,0:00:47.75,Default,,0,0,0,,Кел, мысықтың көзі
Dialogue: 0,0:00:48.17,0:00:50.13,Default,,0,0,0,,Мен сені бүгін кешке ұстаймын
Dialogue: 0,0:01:19.03,0:01:20.08,Default,,0,0,0,,Хо…
Dialogue: 0,0:01:20.16,0:01:22.37,Default,,0,0,0,,Сіз орталыққа сәтті қондыңыз.
Dialogue: 0,0:01:22.45,0:01:25.41,Default,,0,0,0,,Хехе, ең жақсы түнгі круиз.
Dialogue: 0,0:01:25.50,0:01:29.13,Default,,0,0,0,,Нақты қойылым жақсы бола ма, жоқ па деп қобалжыдым.
Dialogue: 0,0:01:29.21,0:01:31.67,Default,,0,0,0,,Хехе, бұл өте пайдалы.
Dialogue: 0,0:01:31.75,0:01:35.63,Default,,0,0,0,,～♪
Dialogue: 0,0:01:32.30,0:01:35.63,Default,,0,0,0,,Сүйіспеншілікпен жасалған бұл қуатты планер
Dialogue: 0,0:01:36.63,0:01:40.22,Default,,0,0,0,,Енді саусақ іздері тиісті тұлғадан алынды.
Dialogue: 0,0:01:40.51,0:01:41.64,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:01:41.72,0:01:42.68,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:01:42.76,0:01:44.39,Default,,0,0,0,,Бұл да (Хитоми) Рахмет.
Dialogue: 0,0:01:46.60,0:01:47.60,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:01:50.15,0:01:54.48,Default,,0,0,0,,Hitomi Есік жанындағы сенсорлық панель арқылы жүйеден бас тартуға болады.
Dialogue: 0,0:01:54.57,0:01:55.61,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:02:09.04,0:02:12.04,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,0:02:12.13,0:02:13.38,Default,,0,0,0,,(аутентификация дыбысы)
Dialogue: 0,0:02:13.46,0:02:14.30,Default,,0,0,0,,(дыбыс шығару)
Dialogue: 0,0:02:14.38,0:02:16.80,Default,,0,0,0,,Бұл ішкі қауіпсіздікті де босатады.
Dialogue: 0,0:02:32.81,0:02:35.44,Default,,0,0,0,,Бұл сіз іздеген «Рим әйелі».
Dialogue: 0,0:02:36.53,0:02:38.49,Default,,0,0,0,,Енді осы уақытқа дейін жеттік, енді не болады?
Dialogue: 0,0:02:38.57,0:02:39.99,Default,,0,0,0,,Оны алып қашып кет
Dialogue: 0,0:02:40.07,0:02:42.62,Default,,0,0,0,,Иә, мынаны пайдаланыңыз.
Dialogue: 0,0:02:49.87,0:02:51.12,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:02:51.21,0:02:53.67,Default,,0,0,0,,Орталық көрме залында дабыл қағылды!
Dialogue: 0,0:02:53.75,0:02:54.59,Default,,0,0,0,,Не?
Dialogue: 0,0:02:54.67,0:02:56.55,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:02:56.63,0:02:59.01,Default,,0,0,0,,Мен үшінші қабатта механикалық күзетпен ұсталдым!
Dialogue: 0,0:02:59.34,0:03:02.64,Default,,0,0,0,,Жоқ, бұл картинада орнатылған дабыл.
Dialogue: 0,0:03:02.72,0:03:05.68,Default,,0,0,0,,Ха! Бұл мысықтың көзі! Мен сенің қашып кетуіңе жол бермеймін.
Dialogue: 0,0:03:07.72,0:03:09.14,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:03:10.64,0:03:12.19,Default,,0,0,0,,Идиот! Маған қарама
Dialogue: 0,0:03:12.27,0:03:14.36,Default,,0,0,0,,Гехо! Мен дем ала алмаймын
Dialogue: 0,0:03:14.44,0:03:16.65,Default,,0,0,0,,Бұл төтенше жағдай. Алдыңғы кіреберісті ашыңыз.
Dialogue: 0,0:03:16.73,0:03:17.57,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:20.11,0:03:21.99,Default,,0,0,0,,(Тыныс алу және оны ұстау дыбысы)
Dialogue: 0,0:03:32.33,0:03:33.17,Default,,0,0,0,,Мысықтар!
Dialogue: 0,0:03:36.38,0:03:38.26,Default,,0,0,0,,Күте тұрыңыз! Уау
Dialogue: 0,0:03:39.38,0:03:41.47,Default,,0,0,0,,Мысықтар... Ай
Dialogue: 0,0:03:41.55,0:03:43.09,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:03:50.60,0:03:51.77,Default,,0,0,0,,Сонша...
Dialogue: 0,0:03:51.85,0:03:55.02,Default,,0,0,0,,Менеджер сонша айқайламаса екен.
Dialogue: 0,0:03:55.77,0:03:57.90,Default,,0,0,0,,Осындай кездерде осы дүкенде...
Dialogue: 0,0:03:58.61,0:03:59.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:01.15,0:04:02.74,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:03.36,0:04:04.99,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:06.28,0:04:07.20,Default,,0,0,0,,Ha
Dialogue: 0,0:04:09.29,0:04:10.62,Default,,0,0,0,,«Мысықтың көзі»
Dialogue: 0,0:04:17.38,0:04:19.30,Default,,0,0,0,,Фу~ Тамақ бергеніңізге рахмет
Dialogue: 0,0:04:19.59,0:04:22.42,Default,,0,0,0,,Бұл неаполитан бұрынғыдай дәмді.
Dialogue: 0,0:04:22.51,0:04:24.72,Default,,0,0,0,,Бұл кофе де керемет.
Dialogue: 0,0:04:25.18,0:04:27.64,Default,,0,0,0,,Бірақ дүкен атауы туралы не деуге болады?
Dialogue: 0,0:04:27.93,0:04:29.47,Default,,0,0,0,,Сізге шағымданатын нәрсе бар ма?
Dialogue: 0,0:04:29.77,0:04:31.64,Default,,0,0,0,,Дүрбелең туғызу үшін жолдан шығып кеткен елес ұры...
Dialogue: 0,0:04:31.73,0:04:34.31,Default,,0,0,0,,Олардың аты бірдей болмас еді.
Dialogue: 0,0:04:34.56,0:04:37.19,Default,,0,0,0,,Бұл дүкен бұрын болған.
Dialogue: 0,0:04:37.27,0:04:40.15,Default,,0,0,0,,Неліктен мен оны «Фантом ұрылары» мырзаға беруім керек?
Dialogue: 0,0:04:40.23,0:04:43.11,Default,,0,0,0,,Бұл мен үшін демалыс орны, солай ма?
Dialogue: 0,0:04:43.20,0:04:46.11,Default,,0,0,0,,Менің есіме түсіргім келмейді! Мысықтың көзі туралы
Dialogue: 0,0:04:46.20,0:04:48.58,Default,,0,0,0,,Менің есіме түсіргім келмейтін нәрсе
Dialogue: 0,0:04:48.66,0:04:50.99,Default,,0,0,0,,Тосио-сан, тағы да сағындың ба?
Dialogue: 0,0:04:51.08,0:04:54.33,Default,,0,0,0,,Ух... бұл дұрыс емес, Ай Чан.
Dialogue: 0,0:04:54.41,0:04:55.67,Default,,0,0,0,,Түсінуге оңай
Dialogue: 0,0:04:55.92,0:04:58.88,Default,,0,0,0,,Бұл сүйкімді, Тосио-сан.
Dialogue: 0,0:04:58.96,0:05:01.71,Default,,0,0,0,,Не? Сүйкімді ме? Азасу
Dialogue: 0,0:05:01.80,0:05:03.80,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:05:03.88,0:05:05.55,Default,,0,0,0,,Жай ғана шатасуда
Dialogue: 0,0:05:05.76,0:05:09.10,Default,,0,0,0,,Уау, интернетте сізді біраз сынға алды.
Dialogue: 0,0:05:09.18,0:05:10.18,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:05:10.51,0:05:13.43,Default,,0,0,0,,Айтқысы келгендер айтсын.
Dialogue: 0,0:05:13.52,0:05:14.73,Default,,0,0,0,,Келесі жолы сенімді түрде——
Dialogue: 0,0:05:14.81,0:05:17.27,Default,,0,0,0,,Мен мысықтың көзін аламын.
Dialogue: 0,0:05:17.35,0:05:18.69,Default,,0,0,0,,О, бұл сенімді.
Dialogue: 0,0:05:18.77,0:05:19.94,Default,,0,0,0,,Ах Азасу
Dialogue: 0,0:05:20.02,0:05:21.98,Default,,0,0,0,,Ұялшақ болуды доғар
Dialogue: 0,0:05:22.57,0:05:24.69,Default,,0,0,0,,Мұнымен күресу оңай емес, солай ма?
Dialogue: 0,0:05:24.86,0:05:26.28,Default,,0,0,0,,Шынайы тұлға әлі де...
Dialogue: 0,0:05:26.36,0:05:30.33,Default,,0,0,0,,Негізі мен бірте-бірте Мысықтың құйрығынан ұстап жатырмын.
Dialogue: 0,0:05:30.41,0:05:31.45,Default,,0,0,0,,Құйрық дегеніміз не?
Dialogue: 0,0:05:31.54,0:05:33.79,Default,,0,0,0,,Бұл құпия.
Dialogue: 0,0:05:33.87,0:05:37.75,Default,,0,0,0,,Олай десеңіз, бәрібір ештеңе түсінбейтін шығарсыз, солай ма?
Dialogue: 0,0:05:37.83,0:05:41.21,Default,,0,0,0,,Шынымды айтсам, бұл жерде көп нәрсе жоқ.
Dialogue: 0,0:05:41.29,0:05:42.42,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:05:42.71,0:05:46.68,Default,,0,0,0,,Дегенмен, «Мысықтың көзі» үштік шығар.
Dialogue: 0,0:05:46.76,0:05:48.64,Default,,0,0,0,,Иә, үш адам?
Dialogue: 0,0:05:48.72,0:05:51.35,Default,,0,0,0,,О, мен мұны бір секундқа қарызға аламын.
Dialogue: 0,0:05:51.97,0:05:55.81,Default,,0,0,0,,Бір адам мүшелерге нақты нұсқаулар беретін басқару мұнарасының рөлін атқарады.
Dialogue: 0,0:05:56.18,0:05:57.27,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:57.35,0:05:58.60,Default,,0,0,0,,Басқа адам
Dialogue: 0,0:05:58.69,0:06:01.86,Default,,0,0,0,,Кез келген қауіпсіздікке ене алатын гений хакер
Dialogue: 0,0:06:01.94,0:06:04.07,Default,,0,0,0,,Уау, сен данышпансың.
Dialogue: 0,0:06:04.15,0:06:05.90,Default,,0,0,0,,Және екіншісі
Dialogue: 0,0:06:05.99,0:06:10.53,Default,,0,0,0,,Қылмыскердің керемет атлетикасы және гориллаға ұқсайтын күші бар.
Dialogue: 0,0:06:10.62,0:06:12.28,Default,,0,0,0,,Горилла сияқты.
Dialogue: 0,0:06:12.78,0:06:15.29,Default,,0,0,0,,Бұл мен осы уақытқа дейін қуып келе жатқан нәтиже.
Dialogue: 0,0:06:16.62,0:06:19.12,Default,,0,0,0,,Мынау мен елестеткен мысықтың көзі!
Dialogue: 0,0:06:20.50,0:06:22.21,Default,,0,0,0,,Өте нашар көрінеді.
Dialogue: 0,0:06:22.79,0:06:25.05,Default,,0,0,0,,Оны әдемірек сала алмайсың ба?
Dialogue: 0,0:06:25.13,0:06:28.55,Default,,0,0,0,,Хехе... Тосио-сан, сен бүгін демалыстасың ба?
Dialogue: 0,0:06:28.63,0:06:31.39,Default,,0,0,0,,Иә, түні бойы күзетте болдым.
Dialogue: 0,0:06:31.47,0:06:33.01,Default,,0,0,0,,Осыдан кейін мен жұмыстан босатылдым.
Dialogue: 0,0:06:33.10,0:06:35.85,Default,,0,0,0,,Ондай жағдайда неге Хитомимен кездесуге бармайсың?
Dialogue: 0,0:06:35.93,0:06:37.35,Default,,0,0,0,,О, жақсы ма?
Dialogue: 0,0:06:37.43,0:06:39.77,Default,,0,0,0,,Бірақ бұдан кейін де бізде бизнес болады.
Dialogue: 0,0:06:39.85,0:06:41.90,Default,,0,0,0,,Жүр, Хитоми-ни.
Dialogue: 0,0:06:41.98,0:06:44.23,Default,,0,0,0,,Мен сенің орнында көмектесемін.
Dialogue: 0,0:06:45.78,0:06:48.70,Default,,0,0,0,,Жарайды, онда сөзіңді қабыл ал.
Dialogue: 0,0:06:55.91,0:06:56.75,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:06:57.12,0:07:00.46,Default,,0,0,0,,Көздер әрқашан өте спорттық болды.
Dialogue: 0,0:07:00.83,0:07:02.83,Default,,0,0,0,,Қара, Тосио, сен де қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:07:02.92,0:07:05.96,Default,,0,0,0,,Күшіңізді жинамайынша, сіз мысықтың көзін ала алмайсыз.
Dialogue: 0,0:07:06.05,0:07:07.80,Default,,0,0,0,,Хе, егер солай болса...
Dialogue: 0,0:07:08.76,0:07:11.26,Default,,0,0,0,,Жарайды, бұл маршрут жұмыс істейді!
Dialogue: 0,0:07:12.39,0:07:13.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:13.43,0:07:14.68,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:07:15.43,0:07:17.85,Default,,0,0,0,,Олай болса, еңбегіңіздің сыйы.
Dialogue: 0,0:07:17.93,0:07:18.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:18.93,0:07:20.27,Default,,0,0,0,,Алаңдамаңыз!
Dialogue: 0,0:07:20.35,0:07:22.44,Default,,0,0,0,,Дова да ха (құлаған дыбыс)
Dialogue: 0,0:07:24.44,0:07:27.78,Default,,0,0,0,,Қал... Ертең бұлшық еттерім ауыратын шығар.
Dialogue: 0,0:07:28.07,0:07:29.74,Default,,0,0,0,,Өкінішті сөздер айтпа
Dialogue: 0,0:07:29.82,0:07:31.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:31.53,0:07:32.99,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:07:37.16,0:07:38.66,Default,,0,0,0,,Бұл адам керемет
Dialogue: 0,0:07:38.75,0:07:41.16,Default,,0,0,0,,Аа, жақсы құлап кетпейді.
Dialogue: 0,0:07:41.25,0:07:43.17,Default,,0,0,0,,Бірақ көзді де жасауға болмас па еді?
Dialogue: 0,0:07:43.25,0:07:45.67,Default,,0,0,0,,Мұндай жіппен жүру мүмкін емес.
Dialogue: 0,0:07:45.75,0:07:48.38,Default,,0,0,0,,Егер сізде күшті тепе-теңдік сезімі болмаса
Dialogue: 0,0:07:53.05,0:07:54.01,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:59.06,0:08:00.64,Default,,0,0,0,,Осындай нәрсе туралы не айтасыз?
Dialogue: 0,0:08:01.02,0:08:02.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:02.60,0:08:05.31,Default,,0,0,0,,Иә, тамаша.
Dialogue: 0,0:08:05.40,0:08:06.52,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:08:07.32,0:08:08.61,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:08:08.69,0:08:09.82,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:08:09.90,0:08:11.82,Default,,0,0,0,,Қалай болды? Күні
Dialogue: 0,0:08:11.90,0:08:13.20,Default,,0,0,0,,Жетеді
Dialogue: 0,0:08:13.28,0:08:16.41,Default,,0,0,0,,Иә, онда біз жоспарлағандай әрекет етеміз.
Dialogue: 0,0:08:16.49,0:08:17.58,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:23.37,0:08:25.29,Default,,0,0,0,,Бүгін таңертең мен Мысық көзінің қылмысы туралы хабарлама алдым.
Dialogue: 0,0:08:25.38,0:08:27.50,Default,,0,0,0,,Бұл келгеннен бері шұғыл жағдай.
Dialogue: 0,0:08:27.59,0:08:29.71,Default,,0,0,0,,Сақтанбаңыз, бәрі сақ болыңыз.
Dialogue: 0,0:08:31.34,0:08:33.93,Default,,0,0,0,,Қылмыс туралы хабарлама уақытына дейін 5 минут қалды
Dialogue: 0,0:08:34.38,0:08:38.01,Default,,0,0,0,,Бұл зәулім ғимараттың жоғарғы қабатындағы көрме залы.
Dialogue: 0,0:08:38.10,0:08:40.72,Default,,0,0,0,,Қауіпсіздік жүйесі де тамаша.
Dialogue: 0,0:08:40.81,0:08:42.31,Default,,0,0,0,,Мысықтың көзі қазір қызу тақырып.
Dialogue: 0,0:08:42.39,0:08:45.15,Default,,0,0,0,,Сырттан басып кіру мүмкін емес пе?
Dialogue: 0,0:08:45.23,0:08:46.81,Default,,0,0,0,,Сақтықты төмендетпеңіз
Dialogue: 0,0:08:46.90,0:08:49.82,Default,,0,0,0,,Мысықтың көзін төмен бағаласаң, қиналып қаласың.
Dialogue: 0,0:08:50.69,0:08:52.94,Default,,0,0,0,,Бұл көрме бөлмесіне бір ғана кіру/шығу бар ма?
Dialogue: 0,0:08:53.03,0:08:53.86,Default,,0,0,0,,Иә
Dialogue: 0,0:08:54.24,0:08:58.32,Default,,0,0,0,,Есігіңіз нормадан ауытқуды анықтаған кезде автоматты түрде құлыпталады.
Dialogue: 0,0:08:58.58,0:08:59.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:59.87,0:09:03.29,Default,,0,0,0,,Тіпті егер Мысық көзі шабуылдаса да
Dialogue: 0,0:09:03.37,0:09:08.29,Default,,0,0,0,,Шығуды жауып тастасаңыз, ол дорбадағы тышқанға, сөмкедегі мысыққа айналады.
Dialogue: 0,0:09:09.88,0:09:12.42,Default,,0,0,0,,Мен сенің бүгін қашуыңа жол бермеймін.
Dialogue: 0,0:09:12.51,0:09:16.05,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:09:16.30,0:09:18.55,Default,,0,0,0,,Уау, ғажайып жел
Dialogue: 0,0:09:19.60,0:09:21.31,Default,,0,0,0,,Уақыт таяп қалды
Dialogue: 0,0:09:22.72,0:09:24.68,Default,,0,0,0,,7-ге дейін 10 секунд қалды
Dialogue: 0,0:09:24.77,0:09:28.73,Default,,0,0,0,,９ ８ ７ ６…
Dialogue: 0,0:09:28.81,0:09:33.74,Default,,0,0,0,,５ ４ ３ ２ １…
Dialogue: 0,0:09:33.94,0:09:35.03,Default,,0,0,0,,Нөл!
Dialogue: 0,0:09:35.82,0:09:37.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:39.03,0:09:40.58,Default,,0,0,0,,Ештеңе болмайды ма?
Dialogue: 0,0:09:43.50,0:09:46.54,Default,,0,0,0,,Жабу уақыты. Біз тазалауды бастаймыз.
Dialogue: 0,0:09:46.62,0:09:48.00,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:09:49.25,0:09:51.46,Default,,0,0,0,,Енді оны орындаңыз.
Dialogue: 0,0:09:52.55,0:09:53.55,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:02.60,0:10:03.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.64,0:10:05.60,Default,,0,0,0,,Уау
Dialogue: 0,0:10:06.48,0:10:07.44,Default,,0,0,0,,Уау
Dialogue: 0,0:10:10.36,0:10:11.31,Default,,0,0,0,,(шығару дыбысы)
Dialogue: 0,0:10:14.36,0:10:16.40,Default,,0,0,0,,Ха ха бұл жұмыс істеді
Dialogue: 0,0:10:18.20,0:10:19.99,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:10:20.07,0:10:22.33,Default,,0,0,0,,Жапқышты тез жауып, түтінді кетіріңіз!
Dialogue: 0,0:10:22.41,0:10:23.41,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:10:23.49,0:10:24.41,Default,,0,0,0,,Есікті қалай құлыптайсыз?
Dialogue: 0,0:10:25.79,0:10:26.79,Default,,0,0,0,,Дайын
Dialogue: 0,0:10:26.87,0:10:29.37,Default,,0,0,0,,Ей, бұл не деген жарылыс болды?
Dialogue: 0,0:10:29.79,0:10:30.67,Default,,0,0,0,,Шамасы——
Dialogue: 0,0:10:30.75,0:10:33.67,Default,,0,0,0,,Терезеге сағаттық бомба қойылған сияқты.
Dialogue: 0,0:10:33.75,0:10:35.21,Default,,0,0,0,,Мен бұған сенбеймін...
Dialogue: 0,0:10:36.09,0:10:38.09,Default,,0,0,0,,Шун-сан! Сурет... (Тосио) Иә!
Dialogue: 0,0:10:38.34,0:10:41.68,Default,,0,0,0,,Ой, ақымақ! Мен білмей тұрып...
Dialogue: 0,0:10:42.30,0:10:46.64,Default,,0,0,0,,Қарғыс атсын... Сурет ұрланды, бірақ барлық қашу жолдары жабылды.
Dialogue: 0,0:10:46.72,0:10:48.52,Default,,0,0,0,,Үлкен аға! Бұл не?
Dialogue: 0,0:10:48.60,0:10:49.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:52.19,0:10:54.23,Default,,0,0,0,,Бұл арқанмен серуендеу болды...
Dialogue: 0,0:10:57.07,0:10:59.82,Default,,0,0,0,,Бұл төбеде! Мысықтың көзі шатырда
Dialogue: 0,0:11:01.36,0:11:04.70,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:09.96,0:11:11.42,Default,,0,0,0,,Ах! Мен таптым
Dialogue: 0,0:11:11.67,0:11:14.04,Default,,0,0,0,,Бұл қатты жел жеңді.
Dialogue: 0,0:11:14.13,0:11:16.38,Default,,0,0,0,,Басқа жаққа өту үшін уақыт қажет.
Dialogue: 0,0:11:16.96,0:11:18.30,Default,,0,0,0,,1-қабаттың күзет тобы А!
Dialogue: 0,0:11:18.38,0:11:20.84,Default,,0,0,0,,Барлығы көшенің арғы жағындағы Мицутомо Митомо ғимаратының төбесіне барады.
Dialogue: 0,0:11:20.93,0:11:22.47,Default,,0,0,0,,Мен де бірден барамын.
Dialogue: 0,0:11:25.05,0:11:27.31,Default,,0,0,0,,Мен мұны да алып тастай аламын ба?
Dialogue: 0,0:11:27.68,0:11:31.81,Default,,0,0,0,,Аа, енді оны көргім келмейді, мені тездетіп алып кетші.
Dialogue: 0,0:11:33.15,0:11:35.36,Default,,0,0,0,,Бвах!
Dialogue: 0,0:11:41.74,0:11:43.62,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл жұмыс істеді ме?
Dialogue: 0,0:11:43.70,0:11:44.53,Default,,0,0,0,,Иә
Dialogue: 0,0:11:45.70,0:11:46.78,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:11:47.74,0:11:50.50,Default,,0,0,0,,Махаббат арқылы жасалған ерекше жасушаның арқасында
Dialogue: 0,0:11:51.41,0:11:55.38,Default,,0,0,0,,Тосио да менің арқанмен жүріп, қашып бара жатқанымды мүлде қате түсінді.
Dialogue: 0,0:11:55.46,0:11:57.84,Default,,0,0,0,,Көз күні жұмыс істеді.
Dialogue: 0,0:11:58.13,0:11:59.63,Default,,0,0,0,,Хехехе
Dialogue: 0,0:12:13.94,0:12:14.98,Default,,0,0,0,,Мысықтың көзі ше?
Dialogue: 0,0:12:15.23,0:12:16.27,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:12:17.65,0:12:20.07,Default,,0,0,0,,Не, қуыршақ?
Dialogue: 0,0:12:20.99,0:12:23.57,Default,,0,0,0,,Сонда мысықтың көзі қайда...
Dialogue: 0,0:12:29.49,0:12:31.87,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:12:32.12,0:12:35.63,Default,,0,0,0,,Келесі жолы мен мысықтың көзіне түсемін.
Dialogue: 0,0:12:35.71,0:12:38.63,Default,,0,0,0,,Мен бұл жолды биыл төртінші рет айтып отырмын!
Dialogue: 0,0:12:38.71,0:12:42.22,Default,,0,0,0,,Уцуми Сіз «Будданың бетін үш рет көруге болады» деген сөзді білесіз.
Dialogue: 0,0:12:42.55,0:12:44.18,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:12:50.10,0:12:52.31,Default,,0,0,0,,Қош келдіңіз, әдеттегідей?
Dialogue: 0,0:12:52.81,0:12:56.23,Default,,0,0,0,,Мен полициядан кетуім мүмкін.
Dialogue: 0,0:12:56.31,0:12:57.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:57.27,0:12:58.36,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:12:58.94,0:13:01.32,Default,,0,0,0,,Келесі жолы мен мысықтардың қашып кетуіне рұқсат етемін
Dialogue: 0,0:13:01.40,0:13:03.99,Default,,0,0,0,,Мені басқа бөлімге ауыстыратын сияқты.
Dialogue: 0,0:13:04.53,0:13:07.41,Default,,0,0,0,,Мен детектив болғаныма сүйсінгендіктен полицияға келдім.
Dialogue: 0,0:13:07.49,0:13:09.28,Default,,0,0,0,,Басқа бөлімде болса, мағынасы жоқ.
Dialogue: 0,0:13:10.03,0:13:11.37,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:13:12.79,0:13:16.33,Default,,0,0,0,,Неаполитандық жасауым керек пе? Кіріңіз.
Dialogue: 0,0:13:16.54,0:13:19.46,Default,,0,0,0,,Жоқ, жарайды, мен тағы келемін.
Dialogue: 0,0:13:22.05,0:13:22.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:24.22,0:13:25.63,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:25.72,0:13:27.93,Default,,0,0,0,,Сіз менің детектив болудан бас тартқанымды қалағансыз, солай ма?
Dialogue: 0,0:13:28.18,0:13:30.22,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:13:31.89,0:13:33.85,Default,,0,0,0,,Әй, мынаны қарашы.
Dialogue: 0,0:13:34.10,0:13:36.19,Default,,0,0,0,,Бұл Жапониядағы алғашқы қону.
Dialogue: 0,0:13:36.27,0:13:37.56,Default,,0,0,0,,Үнді сурет көрмесі?
Dialogue: 0,0:13:37.65,0:13:40.61,Default,,0,0,0,,Иә, орталық бөлігі 100 караттан асатын жұлдызды рубин.
Dialogue: 0,0:13:40.69,0:13:42.23,Default,,0,0,0,,Тіпті патшайым Тиа
Dialogue: 0,0:13:44.11,0:13:46.45,Default,,0,0,0,,Әй, әпке, қарашы.
Dialogue: 0,0:13:47.28,0:13:49.45,Default,,0,0,0,,Менде бұл болуы керек.
Dialogue: 0,0:13:50.32,0:13:51.28,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:07.09,0:14:08.80,Default,,0,0,0,,А... Мені тастап кетті.
Dialogue: 0,0:14:09.22,0:14:11.05,Default,,0,0,0,,О, көп рахмет.
Dialogue: 0,0:14:11.60,0:14:13.51,Default,,0,0,0,,Мен үнді сурет көрмесіне келдім.
Dialogue: 0,0:14:13.60,0:14:15.31,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:14:15.39,0:14:18.77,Default,,0,0,0,,Алдыңғы жағында көрме залы бар.
Dialogue: 0,0:14:19.02,0:14:22.52,Default,,0,0,0,,О... негізінен патшайым деңгейі және басқа да құнды зергерлік бұйымдар.
Dialogue: 0,0:14:22.61,0:14:24.23,Default,,0,0,0,,Оң жақтағы бірінші көрме залында
Dialogue: 0,0:14:24.48,0:14:26.40,Default,,0,0,0,,Тарихи құндылығы бар өнер туындылары, т.б.
Dialogue: 0,0:14:26.49,0:14:29.78,Default,,0,0,0,,Ол сол жақтағы екінші көрме залында көрсетілген.
Dialogue: 0,0:14:30.16,0:14:32.33,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:14:34.08,0:14:35.83,Default,,0,0,0,,Өтінемін... уақытыңызды алыңыз.
Dialogue: 0,0:14:52.18,0:14:53.76,Default,,0,0,0,,Қараңызшы, Хитоми-ни.
Dialogue: 0,0:14:53.97,0:14:54.85,Default,,0,0,0,,Не?
Dialogue: 0,0:14:55.47,0:14:58.98,Default,,0,0,0,,Бүгін Тосио-сан таңертеңнен бері осылай болды.
Dialogue: 0,0:15:00.23,0:15:02.48,Default,,0,0,0,,Менің ойымша, уақыт келді.
Dialogue: 0,0:15:08.69,0:15:11.16,Default,,0,0,0,,Ой, хабарландыру келген сияқты.
Dialogue: 0,0:15:14.20,0:15:16.49,Default,,0,0,0,,Мен өзімді жақсы сезінетінімді түсіну оңай
Dialogue: 0,0:15:18.20,0:15:19.08,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:15:20.12,0:15:21.79,Default,,0,0,0,,Қош келдіңіз, тез болдыңыз.
Dialogue: 0,0:15:22.17,0:15:23.84,Default,,0,0,0,,Алдын ала қарау қалай болды?
Dialogue: 0,0:15:24.17,0:15:26.00,Default,,0,0,0,,Бұл жолы ғимарат ішіндегі қауіпсіздік
Dialogue: 0,0:15:26.09,0:15:28.51,Default,,0,0,0,,Жеке күзет компаниясы бастама көтеретін сияқты.
Dialogue: 0,0:15:28.88,0:15:32.34,Default,,0,0,0,,Полиция бұған дейін бірнеше рет Мысықтың көзін өткізіп алған.
Dialogue: 0,0:15:32.43,0:15:34.22,Default,,0,0,0,,Маған сенбейтін сияқтысың.
Dialogue: 0,0:15:34.30,0:15:38.06,Default,,0,0,0,,Ача, Тосио-сан, сен сондай ынтасың.
Dialogue: 0,0:15:38.14,0:15:41.06,Default,,0,0,0,,Әрине, полиция да ынтымақтасатын сияқты.
Dialogue: 0,0:15:41.27,0:15:43.69,Default,,0,0,0,,Тосио-санның кезегі келеді деп ойлаймын.
Dialogue: 0,0:15:43.98,0:15:45.77,Default,,0,0,0,,Сәлем, Ни-сан
Dialogue: 0,0:15:45.86,0:15:46.69,Default,,0,0,0,,Не?
Dialogue: 0,0:15:47.36,0:15:49.44,Default,,0,0,0,,Бұл стратегияға келетін болсақ...
Dialogue: 0,0:15:51.78,0:15:54.62,Default,,0,0,0,,Біз орналастыруды бастағалы жатырмыз.
Dialogue: 0,0:15:54.70,0:15:57.03,Default,,0,0,0,,Queen Tier бар бірінші көрме залында
Dialogue: 0,0:15:57.12,0:15:59.12,Default,,0,0,0,,Жеткілікті қызметкерлерді бөлу
Dialogue: 0,0:15:59.58,0:16:01.21,Default,,0,0,0,,Жеке қауіпсіздікке келетін болсақ...
Dialogue: 0,0:16:01.29,0:16:04.67,Default,,0,0,0,,А-а-а... Кенеттен болғаны үшін кешіріңіз.
Dialogue: 0,0:16:04.75,0:16:07.34,Default,,0,0,0,,Бұл жолы қауіпсіздікті «Dojima Doujima Security» қамтамасыз етеді
Dialogue: 0,0:16:07.42,0:16:09.38,Default,,0,0,0,,Маған жұмысты ұйымдастыру тапсырылды.
Dialogue: 0,0:16:09.46,0:16:10.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:11.09,0:16:14.09,Default,,0,0,0,,Мен Дожимамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:16:14.72,0:16:16.18,Default,,0,0,0,,Персоналды орналастыру және т.б.
Dialogue: 0,0:16:16.26,0:16:19.10,Default,,0,0,0,,Дожима мырзаның нұсқауларын орындай алсаңыз.
Dialogue: 0,0:16:19.56,0:16:21.02,Default,,0,0,0,,Сондықтан мен мұны істеймін
Dialogue: 0,0:16:23.23,0:16:27.27,Default,,0,0,0,,Бұрын Мысық көзінен бірнеше рет жеңілгенім рас.
Dialogue: 0,0:16:27.36,0:16:30.44,Default,,0,0,0,,Сондықтан біздің полицияда тәжірибе бар.
Dialogue: 0,0:16:30.69,0:16:31.86,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:32.90,0:16:34.78,Default,,0,0,0,,Осыншама көп айтқыңыз келсе.
Dialogue: 0,0:16:34.86,0:16:37.78,Default,,0,0,0,,Бірінші көрме бөлмесінің қауіпсіздігін сізге тапсырамын.
Dialogue: 0,0:16:37.87,0:16:39.74,Default,,0,0,0,,Не? Жарайды ма?
Dialogue: 0,0:16:41.66,0:16:44.54,Default,,0,0,0,,Сөзге сену
Dialogue: 0,0:16:45.04,0:16:48.59,Default,,0,0,0,,Рахмет. Мен бірден дайындала бастаймын.
Dialogue: 0,0:16:50.50,0:16:51.71,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:16:51.80,0:16:53.22,Default,,0,0,0,,Бұл сақтандыру
Dialogue: 0,0:16:54.01,0:16:56.26,Default,,0,0,0,,Королева деңгейі ұрланған жағдайда
Dialogue: 0,0:16:56.34,0:16:58.85,Default,,0,0,0,,Жауапкершілік полицияға жүктеледі
Dialogue: 0,0:16:59.89,0:17:01.64,Default,,0,0,0,,(Такеучидің кунг-фу айқайы)
Dialogue: 0,0:17:02.23,0:17:06.02,Default,,0,0,0,,Қайда жүрсең де... Кел, Мысық көз!
Dialogue: 0,0:17:06.56,0:17:07.90,Default,,0,0,0,,Хабарландыру уақыты.
Dialogue: 0,0:17:08.52,0:17:10.15,Default,,0,0,0,,Электр қуатын өшіру?
Dialogue: 0,0:17:10.23,0:17:12.53,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:17:12.61,0:17:15.24,Default,,0,0,0,,Қорқынышты! Уау~ (Тосио) Мені құшақтама, ақымақ.
Dialogue: 0,0:17:15.74,0:17:19.45,Default,,0,0,0,,А, эй... жібер! Не істеп жатырсың, ақымақ! О, жоқ!
Dialogue: 0,0:17:20.95,0:17:22.45,Default,,0,0,0,,Жоқ! Келдің бе?
Dialogue: 0,0:17:22.75,0:17:24.79,Default,,0,0,0,,Ахо! Ват!
Dialogue: 0,0:17:26.37,0:17:28.58,Default,,0,0,0,,Угяаа...
Dialogue: 0,0:17:29.38,0:17:30.55,Default,,0,0,0,,Не болды? Такеучи
Dialogue: 0,0:17:30.63,0:17:32.84,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:17:32.92,0:17:35.80,Default,,0,0,0,,Не? гипноздық газ
Dialogue: 0,0:17:37.39,0:17:38.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:38.34,0:17:39.18,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:17:58.03,0:18:01.66,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:18:01.87,0:18:03.62,Default,,0,0,0,,Бірінші көрме залынан дабыл?
Dialogue: 0,0:18:05.71,0:18:08.33,Default,,0,0,0,,Күтілгендей, Cat's Eye нысанасы - Queen Tear.
Dialogue: 0,0:18:08.42,0:18:10.59,Default,,0,0,0,,Барлығыңыз, бірінші көрме бөлмесіне барыңыз!
Dialogue: 0,0:18:12.84,0:18:14.38,Default,,0,0,0,,Мысықтарды ұстаңыз!
Dialogue: 0,0:18:17.13,0:18:18.30,Default,,0,0,0,,Ой
Dialogue: 0,0:18:19.01,0:18:21.01,Default,,0,0,0,,Иә
Dialogue: 0,0:18:21.47,0:18:23.89,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,0:18:22.72,0:18:26.02,Default,,0,0,0,,(ысырманың жабылу дыбысы)
Dialogue: 0,0:18:39.20,0:18:41.49,Default,,0,0,0,,Міне, мысықтың көзі.
Dialogue: 0,0:18:41.87,0:18:42.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:42.95,0:18:45.75,Default,,0,0,0,,Егер сіз бір қозғалыс қайта-қайта жұмыс істейді деп ойласаңыз
Dialogue: 0,0:18:46.00,0:18:47.58,Default,,0,0,0,,Үлкен қате.
Dialogue: 0,0:18:47.96,0:18:49.25,Default,,0,0,0,,О, уау!
Dialogue: 0,0:18:50.92,0:18:52.50,Default,,0,0,0,,Қапы, қашып кетейін!
Dialogue: 0,0:18:53.59,0:18:55.25,Default,,0,0,0,,Пайдасыз қарсылықты тоқтату.
Dialogue: 0,0:18:55.50,0:18:57.34,Default,,0,0,0,,Ақыры мен мысықтың көзін алдым!
Dialogue: 0,0:18:58.26,0:19:00.18,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:19:00.89,0:19:03.05,Default,,0,0,0,,Бұл көп қиындық.
Dialogue: 0,0:19:03.14,0:19:05.43,Default,,0,0,0,,Сол масканы шешіп, бетіңді көрсет.
Dialogue: 0,0:19:05.51,0:19:06.68,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:07.22,0:19:08.85,Default,,0,0,0,,Аа... (Тосио) А...
Dialogue: 0,0:19:10.60,0:19:12.61,Default,,0,0,0,,Не? Ах... аа...
Dialogue: 0,0:19:12.69,0:19:15.32,Default,,0,0,0,,Нана... Нана... Бұл не?
Dialogue: 0,0:19:15.40,0:19:17.53,Default,,0,0,0,,Не? кеуде?
Dialogue: 0,0:19:17.94,0:19:20.86,Default,,0,0,0,,Жыныстық қатынас! (Тосио) Өте ыстық!
Dialogue: 0,0:19:21.91,0:19:24.28,Default,,0,0,0,,Мысықтың көзі әйел ме?
Dialogue: 0,0:19:25.37,0:19:26.54,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:19:27.24,0:19:28.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:31.62,0:19:32.88,Default,,0,0,0,,Мысықтар…
Dialogue: 0,0:19:34.79,0:19:36.34,Default,,0,0,0,,Бұл тағы да болды
Dialogue: 0,0:19:41.63,0:19:42.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:49.43,0:19:50.60,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:52.40,0:19:54.69,Default,,0,0,0,,Бұл қымбат ханшайым деңгейі
Dialogue: 0,0:19:54.77,0:19:58.19,Default,,0,0,0,,Бізді қорғау үшін денеңізді дайындағаныңыз үшін рахмет.
Dialogue: 0,0:19:58.28,0:20:01.20,Default,,0,0,0,,А, жоқ, мен анық нәрсені жасадым.
Dialogue: 0,0:20:03.95,0:20:05.87,Default,,0,0,0,,Не? Екінші көрме залында...
Dialogue: 0,0:20:06.16,0:20:08.45,Default,,0,0,0,,Үнді әулетінің тәжі жойылып бара жатыр ма?
Dialogue: 0,0:20:08.70,0:20:09.91,Default,,0,0,0,,Не!
Dialogue: 0,0:20:10.91,0:20:12.50,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл жұмыс істеді ме?
Dialogue: 0,0:20:12.58,0:20:14.58,Default,,0,0,0,,Хитоми-нидің арқасында ол тамаша болды.
Dialogue: 0,0:20:14.67,0:20:18.30,Default,,0,0,0,,Мен Үнді патша тәжін алдым.
Dialogue: 0,0:20:18.84,0:20:19.92,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,0:20:20.01,0:20:22.51,Default,,0,0,0,,Бұл қауіпті болды, бірақ жоспар бойынша
Dialogue: 0,0:20:28.31,0:20:29.35,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:20:29.43,0:20:31.89,Default,,0,0,0,,Қош келдіңіз, әдеттегідей жақсы ма?
Dialogue: 0,0:20:31.98,0:20:35.56,Default,,0,0,0,,Әдеттегідей мен бүгін Монблан киемін деп ойлаймын.
Dialogue: 0,0:20:35.65,0:20:38.44,Default,,0,0,0,,Ей, бүгін көңіл-күйің керемет.
Dialogue: 0,0:20:38.52,0:20:39.98,Default,,0,0,0,,Ай Чан, түсіндің бе?
Dialogue: 0,0:20:40.53,0:20:42.28,Default,,0,0,0,,Негізінде әртүрлі нәрселер бар.
Dialogue: 0,0:20:42.36,0:20:45.61,Default,,0,0,0,,Басқа бөлімге ауысу туралы сөз жоқ.
Dialogue: 0,0:20:45.70,0:20:47.99,Default,,0,0,0,,Сонымен, жұмысыңыз жақсы өтті.
Dialogue: 0,0:20:48.08,0:20:49.03,Default,,0,0,0,,О
Dialogue: 0,0:20:49.12,0:20:53.21,Default,,0,0,0,,Сондай-ақ біз мысық көзі туралы маңызды ақпарат алдық.
Dialogue: 0,0:20:53.29,0:20:55.08,Default,,0,0,0,,Материалдық ақпарат дегеніміз не?
Dialogue: 0,0:20:55.17,0:20:56.88,Default,,0,0,0,,Естуге таң қалмаңыз
Dialogue: 0,0:20:57.38,0:21:01.05,Default,,0,0,0,,Тек сіз үшін: Мысық көзі - әйел.
Dialogue: 0,0:21:01.21,0:21:03.76,Default,,0,0,0,,Неге олай ойладың?
Dialogue: 0,0:21:03.97,0:21:06.68,Default,,0,0,0,,Мен сіздің кеудеңізге сәл ғана тиіп қойдым.
Dialogue: 0,0:21:06.76,0:21:08.89,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:21:08.97,0:21:11.81,Default,,0,0,0,,Бірақ бұл өте... муф...
Dialogue: 0,0:21:11.89,0:21:13.60,Default,,0,0,0,,Атсуши! Ах!
Dialogue: 0,0:21:13.68,0:21:15.44,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:21:17.23,0:21:18.69,Default,,0,0,0,,Мен енді білмеймін!
Dialogue: 0,0:21:22.44,0:21:26.28,Default,,0,0,0,,(Махаббаттың көз жасы мен күлкісі)
Dialogue: 0,0:21:26.61,0:21:29.58,Default,,0,0,0,,Қалай болғанда да, мен Хитомиге қуаныштымын
Dialogue: 0,0:21:29.87,0:21:32.12,Default,,0,0,0,,Тосио детектив қызметін жалғастырады
Dialogue: 0,0:21:32.37,0:21:36.25,Default,,0,0,0,,Зергерлік бұйымдарды ұрлап, оны қайтару үшін жолдан шығуға тұрарлық болды.
Dialogue: 0,0:21:36.62,0:21:38.79,Default,,0,0,0,,Мен бұлай тырыспауым керек еді
Dialogue: 0,0:21:39.21,0:21:42.21,Default,,0,0,0,,Мысық көздің омырауына қол тигізгенде қуанатындай жігіт.
Dialogue: 0,0:21:42.55,0:21:45.59,Default,,0,0,0,,Алыс жерде үрленсе жақсы болар еді.
Dialogue: 0,0:21:45.67,0:21:47.68,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:48.01,0:21:51.81,Default,,0,0,0,,Бірақ мен Тосиомен біраз уақыт ұры мен детектив арасында қарым-қатынаста болдым.
Dialogue: 0,0:21:51.89,0:21:53.64,Default,,0,0,0,,Бізде жалғастырудан басқа амал жоқ деп ойлаймын.
Dialogue: 0,0:21:54.10,0:21:55.85,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:21:59.65,0:22:02.57,Default,,0,0,0,,Мақсатымызға жеткенше
Dialogue: 0,0:22:11.41,0:22:13.41,Default,,0,0,0,,♪～
Dialogue: 0,0:23:37.95,0:23:39.96,Default,,0,0,0,,～♪
Dialogue: 0,0:23:41.46,0:23:47.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory