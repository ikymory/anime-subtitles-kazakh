Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.96,0:00:04.30,Default,,0,0,0,,<Толқындардың дыбысымен қоршалып, теңізге ұзақ қарағанымда➡
Dialogue: 0,0:00:04.30,0:00:06.30,Default,,0,0,0,,Сіз уақытты ұмытасыз, солай емес пе?
Dialogue: 0,0:00:06.30,0:00:08.64,Default,,0,0,0,,<Адамның қолы бос болғаны жақсы>
Dialogue: 0,0:00:08.64,0:00:11.31,Default,,0,0,0,,<Бірақ мен тым бос емес болсам да, мен уақытты ұмытамын>
Dialogue: 0,0:00:11.31,0:00:13.31,Default,,0,0,0,,<Хмм...> <Қандай болса да➡
Dialogue: 0,0:00:13.31,0:00:16.31,Default,,0,0,0,,Сіз уақытты ұмытып кетесіз> <Оған көмектесу мүмкін емес>
Dialogue: 0,0:00:16.31,0:00:18.98,Default,,0,0,0,,<Әй~> <Иә, бейқамдық уақыты аяқталды! ＞
Dialogue: 0,0:00:30.96,0:00:35.96,Default,,0,0,0,,<Ай-чан, бүгін ARIA компаниясының құрылған күні>
Dialogue: 0,0:00:35.96,0:00:40.64,Default,,0,0,0,,<Иә, дәл сол күні әжеміз ARIA компаниясын құрды>
Dialogue: 0,0:00:40.64,0:00:43.64,Default,,0,0,0,,<Біз бүгін бизнес үшін жабық боламыз➡
Dialogue: 0,0:00:43.64,0:00:46.64,Default,,0,0,0,,Алисия, президент Ария және үшеуміз➡
Dialogue: 0,0:00:46.64,0:00:50.91,Default,,0,0,0,,Мен біраздан бері күткен қысқа сапарға барамын.＞
Dialogue: 0,0:00:50.91,0:00:53.25,Default,,0,0,0,,♬～
Dialogue: 0,0:00:53.25,0:00:55.25,Default,,0,0,0,,Пуйпуи~
Dialogue: 0,0:00:55.25,0:00:57.25,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:00:57.25,0:00:59.25,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:00:59.25,0:01:19.27,Default,,0,0,0,,♬～
Dialogue: 0,0:01:19.27,0:01:39.29,Default,,0,0,0,,♬～
Dialogue: 0,0:01:39.29,0:01:58.25,Default,,0,0,0,,♬～
Dialogue: 0,0:01:58.25,0:02:00.25,Default,,0,0,0,,♬～
Dialogue: 0,0:02:00.25,0:02:02.62,Default,,0,0,0,,Пуи?
Dialogue: 0,0:02:02.62,0:02:09.93,Default,,0,0,0,,♬～
Dialogue: 0,0:02:09.93,0:02:13.26,Default,,0,0,0,,Ура! Бұл велосипед!
Dialogue: 0,0:02:13.26,0:02:15.60,Default,,0,0,0,,Бұл Нео-Бурано аралы
Dialogue: 0,0:02:15.60,0:02:19.27,Default,,0,0,0,,12 жасқа дейінгі балаларға велосипедпен жүруге рұқсат етіледі.
Dialogue: 0,0:02:19.27,0:02:22.94,Default,,0,0,0,,Мен Акваға келгенде бірінші рет велосипед көрдім.
Dialogue: 0,0:02:22.94,0:02:39.29,Default,,0,0,0,,♬～
Dialogue: 0,0:02:39.29,0:02:43.29,Default,,0,0,0,,Түрлі-түсті үйлер көп.
Dialogue: 0,0:02:44.29,0:02:47.30,Default,,0,0,0,,Бурано аралы, ол Манхомда болған кезде
Dialogue: 0,0:02:47.30,0:02:49.90,Default,,0,0,0,,Дәл қазіргідей балықшылар ауылы еді.
Dialogue: 0,0:02:49.90,0:02:53.57,Default,,0,0,0,,Қараңғы тұманда да балық аулаудан қайтқанда
Dialogue: 0,0:02:53.57,0:02:56.91,Default,,0,0,0,,Балықшының әйелдері өз үйін біледі
Dialogue: 0,0:02:56.91,0:02:59.91,Default,,0,0,0,,Түрлі-түсті боялғаны айтылады.
Dialogue: 0,0:02:59.91,0:03:03.21,Default,,0,0,0,,Оның қалдықтары күні бүгінге дейін сақталған.
Dialogue: 0,0:03:07.58,0:03:12.25,Default,,0,0,0,,Уау! Оның Венецияда Мангом дәуірінде танымал болғаны айтылады.
Dialogue: 0,0:03:12.25,0:03:14.26,Default,,0,0,0,,Бұл венециялық шілтер.
Dialogue: 0,0:03:14.26,0:03:17.59,Default,,0,0,0,,Иә, балық аулау үшін тор керек, солай ма?
Dialogue: 0,0:03:17.59,0:03:20.93,Default,,0,0,0,,Ол сол тор жасау техникасының дамуы нәтижесінде дүниеге келген.
Dialogue: 0,0:03:20.93,0:03:25.27,Default,,0,0,0,,Бұл технология Aqua-ға да берілді.
Dialogue: 0,0:03:25.27,0:03:29.94,Default,,0,0,0,,Сол көйлектегі қалыңдық әдемі болуы керек.
Dialogue: 0,0:03:29.94,0:03:32.61,Default,,0,0,0,,Мен Анна-сенпайға қонаққа барамын
Dialogue: 0,0:03:32.61,0:03:35.94,Default,,0,0,0,,Шілтерлі қалыңдық көйлегі де әдемі болды.
Dialogue: 0,0:03:35.94,0:03:37.95,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:03:37.95,0:03:42.28,Default,,0,0,0,,Ал, Анна-сенпай қандай адам?
Dialogue: 0,0:03:42.28,0:03:46.62,Default,,0,0,0,,Иә, бұл жарқын және керемет Undine болды.
Dialogue: 0,0:03:46.62,0:03:51.89,Default,,0,0,0,,Менде ер адамдардың жанкүйерлері көп болды, мен қазіргіден әлдеқайда бос емес едім.
Dialogue: 0,0:03:51.89,0:03:55.23,Default,,0,0,0,,Ей, сен керемет адамсың.
Dialogue: 0,0:03:55.23,0:03:57.23,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:03:57.23,0:03:59.94,Default,,0,0,0,,Әй, (Президент Ария) Пупупуи~
Dialogue: 0,0:04:03.91,0:04:22.26,Default,,0,0,0,,♬～
Dialogue: 0,0:04:22.26,0:04:25.93,Default,,0,0,0,,Бұл менің үйім, Алисия.
Dialogue: 0,0:04:25.93,0:04:27.93,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:27.93,0:04:30.93,Default,,0,0,0,,Pupupuinyu~
Dialogue: 0,0:04:33.27,0:04:35.94,Default,,0,0,0,,Айқай? (Президент Ария) Пуи?
Dialogue: 0,0:04:35.94,0:04:43.28,Default,,0,0,0,,♬～
Dialogue: 0,0:04:43.28,0:04:46.62,Default,,0,0,0,,Хехе~ Қызық, сен алыстасың ба?
Dialogue: 0,0:04:46.62,0:04:50.89,Default,,0,0,0,,Уәде етілген уақытта ешнәрсе жоқ деп ойлаймын.
Dialogue: 0,0:04:50.89,0:04:53.19,Default,,0,0,0,,О? Хе?
Dialogue: 0,0:04:54.22,0:04:58.53,Default,,0,0,0,,Ах... Хехе Сәлем.
Dialogue: 0,0:05:01.23,0:05:03.90,Default,,0,0,0,,Хахи! Аа, күте тұрыңыз
Dialogue: 0,0:05:03.90,0:05:06.57,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:05:06.57,0:05:08.57,Default,,0,0,0,,Сол қыз...
Dialogue: 0,0:05:09.91,0:05:11.91,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:11.91,0:05:14.91,Default,,0,0,0,,Екі әйел болды, иә?
Dialogue: 0,0:05:14.91,0:05:16.91,Default,,0,0,0,,Хахи хахи ха... хахи
Dialogue: 0,0:05:16.91,0:05:18.91,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:05:18.91,0:05:21.25,Default,,0,0,0,,Сол форма, иә?
Dialogue: 0,0:05:21.25,0:05:24.92,Default,,0,0,0,,Сенпай Хохе? Ах...
Dialogue: 0,0:05:24.92,0:05:29.26,Default,,0,0,0,,Біраз уақыт болды, Алисия, сен...
Dialogue: 0,0:05:29.26,0:05:33.60,Default,,0,0,0,,Иә, танысқаныма қуаныштымын, мен Акари Мизунашимін.
Dialogue: 0,0:05:33.60,0:05:36.93,Default,,0,0,0,,Сәлем Акари-чан, бұл Анна.
Dialogue: 0,0:05:36.93,0:05:39.27,Default,,0,0,0,,Бұл менің ұлым Ахито.
Dialogue: 0,0:05:39.27,0:05:41.27,Default,,0,0,0,,Сәлем Ахито-кун
Dialogue: 0,0:05:41.27,0:05:43.27,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:05:43.27,0:05:46.94,Default,,0,0,0,,О, не? Ахито қызылға айналады~
Dialogue: 0,0:05:46.94,0:05:49.28,Default,,0,0,0,,Қызыл түс жоқ!
Dialogue: 0,0:05:49.28,0:05:52.88,Default,,0,0,0,,Әй, асығыссың ба? Шу шығар, қарт қаңбақ!
Dialogue: 0,0:05:52.88,0:05:55.55,Default,,0,0,0,,Нани?
Dialogue: 0,0:05:55.55,0:05:57.55,Default,,0,0,0,,Урия! Басыңыз, басыңыз, тоқтатыңыз!
Dialogue: 0,0:05:57.55,0:06:00.89,Default,,0,0,0,,Хехе... ау, хэхэ
Dialogue: 0,0:06:00.89,0:06:03.89,Default,,0,0,0,,Чочочочокочо... (Ахито күлді)
Dialogue: 0,0:06:06.90,0:06:08.90,Default,,0,0,0,,Уау...!
Dialogue: 0,0:06:08.90,0:06:12.57,Default,,0,0,0,,Бұл тамаша шілтер кескіндеме. Бұл керемет.
Dialogue: 0,0:06:12.57,0:06:16.91,Default,,0,0,0,,Оны әже жасады. Эй, әже?
Dialogue: 0,0:06:16.91,0:06:21.24,Default,,0,0,0,,Иә, менің әжем осы аралдағы атақты шілтер шебері.
Dialogue: 0,0:06:21.24,0:06:24.25,Default,,0,0,0,,Енді анам да оқытылады.
Dialogue: 0,0:06:24.25,0:06:27.92,Default,,0,0,0,,Мен әлі де жаманмын!
Dialogue: 0,0:06:27.92,0:06:30.92,Default,,0,0,0,,Мен оны тойға сыйлық ретінде алдым.
Dialogue: 0,0:06:30.92,0:06:35.26,Default,,0,0,0,,Өзім жасайтын немесе басқалардан алатын басқа нәрселер.
Dialogue: 0,0:06:35.26,0:06:46.94,Default,,0,0,0,,♬～
Dialogue: 0,0:06:46.94,0:06:50.87,Default,,0,0,0,,Менің аға буыным ARIA компаниясында жұмыс істеген кезде
Dialogue: 0,0:06:50.87,0:06:53.88,Default,,0,0,0,,Менің қазіргі күйеуім осы аралда балықшы.
Dialogue: 0,0:06:53.88,0:06:57.88,Default,,0,0,0,,Анам екеуміз Нео Венецияға саяхатқа бардық.
Dialogue: 0,0:06:57.88,0:07:03.49,Default,,0,0,0,,Сонда аға анасының қамын ойлаған мейірімді балықшыға ғашық болыпты...
Dialogue: 0,0:07:10.89,0:07:15.23,Default,,0,0,0,,《Менің өзімшілдігімді кешіргеніңіз үшін көп рахмет》
Dialogue: 0,0:07:15.23,0:07:18.57,Default,,0,0,0,,《Құттықтаймын Анна》
Dialogue: 0,0:07:18.57,0:07:20.90,Default,,0,0,0,,《Бұл өте қолайлы жағдай》
Dialogue: 0,0:07:20.90,0:07:24.91,Default,,0,0,0,,《Анна еш ойланбастан өз жолымен жүреді деп сенемін➡
Dialogue: 0,0:07:24.91,0:07:27.24,Default,,0,0,0,,Мен қуаныштымын》
Dialogue: 0,0:07:27.24,0:07:29.91,Default,,0,0,0,,《Рахмет, әже》
Dialogue: 0,0:07:29.91,0:07:32.25,Default,,0,0,0,,《Сау болыңыз》
Dialogue: 0,0:07:32.25,0:07:34.25,Default,,0,0,0,,《Рахмет Алисия》
Dialogue: 0,0:07:34.25,0:07:37.92,Default,,0,0,0,,《Өзіңді сақта》 《Иә》
Dialogue: 0,0:07:37.92,0:07:42.59,Default,,0,0,0,,♬～
Dialogue: 0,0:07:42.59,0:07:45.99,Default,,0,0,0,,《Күшік күшік…пуи~》
Dialogue: 0,0:07:48.93,0:07:53.54,Default,,0,0,0,,ARIA компаниясы менің жастық шағым болды
Dialogue: 0,0:07:53.54,0:07:56.20,Default,,0,0,0,,Пуип… Пуипуй
Dialogue: 0,0:07:56.20,0:07:59.87,Default,,0,0,0,,Мочимочи! (Президент Ария) Пуиню Пуиню...
Dialogue: 0,0:07:59.87,0:08:02.54,Default,,0,0,0,,Бұл бақытты неке болды.
Dialogue: 0,0:08:02.54,0:08:04.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:04.55,0:08:06.55,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:08:06.55,0:08:09.88,Default,,0,0,0,,Айқай? Жай әзіл
Dialogue: 0,0:08:09.88,0:08:12.89,Default,,0,0,0,,Бірақ бұл күрес болды.
Dialogue: 0,0:08:12.89,0:08:14.89,Default,,0,0,0,,Аралға тұрмысқа шыққанымен
Dialogue: 0,0:08:14.89,0:08:18.89,Default,,0,0,0,,Өйткені, бұл оған дейін Ундиннің өмірінен мүлде басқаша болды.
Dialogue: 0,0:08:18.89,0:08:23.23,Default,,0,0,0,,Мен ешкімді танымаймын, ал күйеуім үнемі балық аулап жүреді.
Dialogue: 0,0:08:23.23,0:08:26.90,Default,,0,0,0,,Аралдағы адамдар біртүрлі болып қалды.
Dialogue: 0,0:08:26.90,0:08:29.90,Default,,0,0,0,,Маған ашу қиын болды.
Dialogue: 0,0:08:29.90,0:08:32.51,Default,,0,0,0,,Мен жалғыз болдым
Dialogue: 0,0:08:33.91,0:08:37.25,Default,,0,0,0,,А... а...
Dialogue: 0,0:08:37.25,0:08:40.25,Default,,0,0,0,,Бірақ мен жарысты бастағаннан бері
Dialogue: 0,0:08:40.25,0:08:42.25,Default,,0,0,0,,Біртіндеп аралдағы адамдармен араласа бастадым.
Dialogue: 0,0:08:42.25,0:08:44.25,Default,,0,0,0,,Енді аламын
Dialogue: 0,0:08:48.59,0:08:51.53,Default,,0,0,0,,Бір шілтерді тоқу үшін 5 адам жұмысты бөледі.
Dialogue: 0,0:08:51.53,0:08:54.53,Default,,0,0,0,,Кейде бесеуміз бірге жұмыс істейміз бе?
Dialogue: 0,0:08:54.53,0:08:59.20,Default,,0,0,0,,Мұнда және мына жерде шілтер кестені әртүрлі адамдар жасайды.
Dialogue: 0,0:08:59.20,0:09:02.87,Default,,0,0,0,,Кестелерді байланыстыратын көпірдің кестелері.
Dialogue: 0,0:09:02.87,0:09:06.54,Default,,0,0,0,,Маған қалдырғандарына қуаныштымын.
Dialogue: 0,0:09:06.54,0:09:10.21,Default,,0,0,0,,Кесте Анна мен арал халқын байланыстырады.
Dialogue: 0,0:09:10.21,0:09:14.22,Default,,0,0,0,,Көпірге айналды, иә? Бұл дұрыс.
Dialogue: 0,0:09:14.22,0:09:16.89,Default,,0,0,0,,...Бұл жақсы сөз, Акари-чан.
Dialogue: 0,0:09:16.89,0:09:19.22,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:19.22,0:09:21.56,Default,,0,0,0,,Әй, хехе
Dialogue: 0,0:09:21.56,0:09:24.89,Default,,0,0,0,,Әже, жағдайыңыз жақсы деп үміттенемін.
Dialogue: 0,0:09:26.90,0:09:30.50,Default,,0,0,0,,А, Альберто балық аулаудан оралды.
Dialogue: 0,0:09:34.24,0:09:36.24,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:09:36.24,0:09:39.24,Default,,0,0,0,,Әже! Не болды?
Dialogue: 0,0:09:39.24,0:09:42.24,Default,,0,0,0,,Хехехехе Алисия маған қоңырау шалды.
Dialogue: 0,0:09:42.24,0:09:46.58,Default,,0,0,0,,Біраз уақыт болды, Анна. Сіздің жақсы болғаныңызға қуаныштымын.
Dialogue: 0,0:09:46.58,0:09:49.25,Default,,0,0,0,,Мен сені сол жерде кездейсоқ кездестірдім.
Dialogue: 0,0:09:49.25,0:09:52.59,Default,,0,0,0,,Танысқаныма қуаныштымын, әже.
Dialogue: 0,0:09:52.59,0:09:54.92,Default,,0,0,0,,Пупуиню! Пуи пуи…
Dialogue: 0,0:09:54.92,0:09:58.26,Default,,0,0,0,,О, президент Ария, хохохо...
Dialogue: 0,0:09:58.26,0:10:00.93,Default,,0,0,0,,Сәлем Ахито-кун
Dialogue: 0,0:10:00.93,0:10:02.93,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:02.93,0:10:05.27,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Альбертомын.
Dialogue: 0,0:10:05.27,0:10:07.27,Default,,0,0,0,,Бұл Акари Мизунаши.
Dialogue: 0,0:10:07.27,0:10:10.61,Default,,0,0,0,,Қалай болды? О, бұл Бакчи.
Dialogue: 0,0:10:10.61,0:10:13.94,Default,,0,0,0,,Джаан! Мен әсіресе жақсы көрінетіндерін таңдадым.
Dialogue: 0,0:10:13.94,0:10:16.61,Default,,0,0,0,,Уау! Дәмді көрінеді
Dialogue: 0,0:10:16.61,0:10:20.62,Default,,0,0,0,,～
Dialogue: 0,0:10:20.62,0:10:22.62,Default,,0,0,0,,Пуиню~!
Dialogue: 0,0:10:24.95,0:10:26.96,Default,,0,0,0,,Хмм, жақсы иіс
Dialogue: 0,0:10:26.96,0:10:30.29,Default,,0,0,0,,...
Dialogue: 0,0:10:30.29,0:10:32.96,Default,,0,0,0,,Кеттік! (Президент Ария) Пупуиню~
Dialogue: 0,0:10:32.96,0:10:34.96,Default,,0,0,0,,Міне.
Dialogue: 0,0:10:34.96,0:10:37.30,Default,,0,0,0,,Пупуи о!
Dialogue: 0,0:10:37.30,0:10:39.30,Default,,0,0,0,,Пуи
Dialogue: 0,0:10:39.30,0:10:42.64,Default,,0,0,0,,Хахаха...! Сенімен бәрі жақсы ма?
Dialogue: 0,0:10:42.64,0:10:45.64,Default,,0,0,0,,⚟Альберто, бұл тамақ.
Dialogue: 0,0:10:45.64,0:10:47.64,Default,,0,0,0,,Қазір кеттік! (Президент Ария) Пуи
Dialogue: 0,0:10:47.64,0:10:49.64,Default,,0,0,0,,Ау, ауырсын...
Dialogue: 0,0:10:49.64,0:10:52.58,Default,,0,0,0,,Уау! Бұл керемет!
Dialogue: 0,0:10:52.58,0:10:55.92,Default,,0,0,0,,...
Dialogue: 0,0:10:55.92,0:10:58.59,Default,,0,0,0,,Итадакимасу!
Dialogue: 0,0:10:58.59,0:11:00.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.59,0:11:03.29,Default,,0,0,0,,Хмм, дәмді!
Dialogue: 0,0:11:05.26,0:11:09.26,Default,,0,0,0,,～
Dialogue: 0,0:11:09.26,0:11:11.27,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:11:11.27,0:11:14.94,Default,,0,0,0,,...
Dialogue: 0,0:11:14.94,0:11:26.95,Default,,0,0,0,,♬～
Dialogue: 0,0:11:26.95,0:11:28.95,Default,,0,0,0,,Уми!
Dialogue: 0,0:11:31.62,0:11:34.96,Default,,0,0,0,,Уми! Хехе...
Dialogue: 0,0:11:34.96,0:11:37.96,Default,,0,0,0,,Иә, бұл тамаша! Хахаха
Dialogue: 0,0:11:48.24,0:11:50.94,Default,,0,0,0,,（）
Dialogue: 0,0:11:54.91,0:11:58.91,Default,,0,0,0,,...
Dialogue: 0,0:11:58.91,0:12:01.25,Default,,0,0,0,,Мен өте көңілді болдым.
Dialogue: 0,0:12:01.25,0:12:14.93,Default,,0,0,0,,♬～
Dialogue: 0,0:12:14.93,0:12:18.27,Default,,0,0,0,,ＡＲＩＡ
Dialogue: 0,0:12:18.27,0:12:20.94,Default,,0,0,0,,...
Dialogue: 0,0:12:20.94,0:12:25.94,Default,,0,0,0,,ＡＲＩＡ
Dialogue: 0,0:12:25.94,0:12:29.61,Default,,0,0,0,,Мен шынымен бақыттымын.
Dialogue: 0,0:12:29.61,0:12:34.32,Default,,0,0,0,,...
Dialogue: 0,0:12:39.62,0:12:44.56,Default,,0,0,0,,...
Dialogue: 0,0:12:44.56,0:12:47.23,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:47.23,0:12:49.56,Default,,0,0,0,,Ғажайып…
Dialogue: 0,0:12:49.56,0:12:53.23,Default,,0,0,0,,ＡＲＩＡ
Dialogue: 0,0:12:53.23,0:12:56.57,Default,,0,0,0,,...
Dialogue: 0,0:12:56.57,0:12:59.24,Default,,0,0,0,,...
Dialogue: 0,0:12:59.24,0:13:01.58,Default,,0,0,0,,Ол жерде болмады.
Dialogue: 0,0:13:01.58,0:13:13.25,Default,,0,0,0,,♬～
Dialogue: 0,0:13:13.25,0:13:16.59,Default,,0,0,0,,...
Dialogue: 0,0:13:16.59,0:13:18.93,Default,,0,0,0,,Әр күнді толық өткізіңіз
Dialogue: 0,0:13:18.93,0:13:22.53,Default,,0,0,0,,...
Dialogue: 0,0:13:24.60,0:13:27.27,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:27.27,0:13:29.27,Default,,0,0,0,,Pui…
Dialogue: 0,0:13:30.94,0:13:35.61,Default,,0,0,0,,ARIA компаниясын жалғыз мен құрған жоқпын.
Dialogue: 0,0:13:35.61,0:13:38.95,Default,,0,0,0,,Президент Ария маған мұны түсінуге мәжбүр етті.
Dialogue: 0,0:13:38.95,0:13:42.88,Default,,0,0,0,,Жарайды, сен мені құтқардың деп айта аласың.
Dialogue: 0,0:13:42.88,0:13:45.55,Default,,0,0,0,,Президент Ария?
Dialogue: 0,0:13:45.55,0:13:49.26,Default,,0,0,0,,Қарсы болмасаңыз, айта аласыз ба?
Dialogue: 0,0:13:50.56,0:13:54.23,Default,,0,0,0,,Сол кезде мен өзімді жоғалтып ала жаздадым.
Dialogue: 0,0:13:54.23,0:13:56.23,Default,,0,0,0,,А...
Dialogue: 0,0:13:56.23,0:13:58.57,Default,,0,0,0,,Бұл әлі менмін
Dialogue: 0,0:13:58.57,0:14:01.97,Default,,0,0,0,,Мен Химеяда ундина болып жұмыс істеген кезім
Dialogue: 0,0:14:05.57,0:14:08.24,Default,,0,0,0,,《Еңбегіңіз үшін рахмет, Акино-сан》
Dialogue: 0,0:14:08.24,0:14:10.58,Default,,0,0,0,,《Еңбегіңіз үшін рахмет, Акино-сан》
Dialogue: 0,0:14:10.58,0:14:12.58,Default,,0,0,0,,《Еңбегіңіз үшін рахмет》
Dialogue: 0,0:14:12.58,0:14:15.92,Default,,0,0,0,,Ол кезде мені Химеядағы Эйс деп атайтын.
Dialogue: 0,0:14:15.92,0:14:18.92,Default,,0,0,0,,14 жыл өтті.
Dialogue: 0,0:14:18.92,0:14:21.92,Default,,0,0,0,,《Аа~ Акино-сан, бүгін де тамаша》
Dialogue: 0,0:14:21.92,0:14:24.93,Default,,0,0,0,,《Атмосфера өткен сайын өзгереді》
Dialogue: 0,0:14:24.93,0:14:28.93,Default,,0,0,0,,《Кеше тапсырысы бар 6 тұтынушы бар деп естідім》
Dialogue: 0,0:14:28.93,0:14:32.60,Default,,0,0,0,,《Уау... Мен міндетті түрде шаршайтын едім》
Dialogue: 0,0:14:32.60,0:14:35.60,Default,,0,0,0,,《Қартайған сайын қартаясың➡
Dialogue: 0,0:14:35.60,0:14:38.27,Default,,0,0,0,,Барған сайын жарқырап бара жатқандай сезіледі》
Dialogue: 0,0:14:38.27,0:14:41.21,Default,,0,0,0,,《Қанша жұмыс істесем де, мен ешқашан ренжімеймін➡
Dialogue: 0,0:14:41.21,0:14:45.88,Default,,0,0,0,,Ол шынымен де біздің заманымыздың ең ұлы су перісі.》
Dialogue: 0,0:14:45.88,0:14:57.89,Default,,0,0,0,,♬～
Dialogue: 0,0:14:57.89,0:15:01.56,Default,,0,0,0,,《(Қоңырау)》
Dialogue: 0,0:15:01.56,0:15:08.24,Default,,0,0,0,,♬～
Dialogue: 0,0:15:08.24,0:15:10.24,Default,,0,0,0,,《Рахмет》
Dialogue: 0,0:15:10.24,0:15:14.58,Default,,0,0,0,,《Сау бол》 (Әке) 《Ой, қызық болды》
Dialogue: 0,0:15:14.58,0:15:16.58,Default,,0,0,0,,《Сау болыңыз》
Dialogue: 0,0:15:16.58,0:15:27.59,Default,,0,0,0,,♬～
Dialogue: 0,0:15:27.59,0:15:29.59,Default,,0,0,0,,《О? 》
Dialogue: 0,0:15:29.59,0:15:47.88,Default,,0,0,0,,♬～
Dialogue: 0,0:15:47.88,0:15:50.21,Default,,0,0,0,,《Аа...》
Dialogue: 0,0:15:50.21,0:15:53.55,Default,,0,0,0,,《Сәлем мысық》
Dialogue: 0,0:15:53.55,0:15:56.55,Default,,0,0,0,,《Сіз соңғы уақытта осында болдыңыз.》
Dialogue: 0,0:15:56.55,0:15:59.22,Default,,0,0,0,,《Ол қайдан пайда болды? 》
Dialogue: 0,0:15:59.22,0:16:01.89,Default,,0,0,0,,《Сен мұнда күнде не істейсің? 》
Dialogue: 0,0:16:01.89,0:16:03.89,Default,,0,0,0,,《Мүмкін адасып қалған шығарсың? 》
Dialogue: 0,0:16:03.89,0:16:07.23,Default,,0,0,0,,《Үнемі бір орында тұрудан шаршамайсың ба? 》
Dialogue: 0,0:16:07.23,0:16:13.90,Default,,0,0,0,,♬～
Dialogue: 0,0:16:13.90,0:16:15.90,Default,,0,0,0,,《(Годоладан түсу дыбысы)》
Dialogue: 0,0:16:15.90,0:16:35.92,Default,,0,0,0,,♬～
Dialogue: 0,0:16:35.92,0:16:53.21,Default,,0,0,0,,♬～
Dialogue: 0,0:16:53.21,0:16:57.88,Default,,0,0,0,,《Кешіріңіз, егер сіз кенеттен маған сұрақ қойсаңыз, бұл проблема болар еді.》
Dialogue: 0,0:16:57.88,0:17:06.55,Default,,0,0,0,,♬～
Dialogue: 0,0:17:06.55,0:17:10.89,Default,,0,0,0,,Ол кезде, әрине, мен өз жұмысымды ұнататынмын, бірақ
Dialogue: 0,0:17:10.89,0:17:16.56,Default,,0,0,0,,Мен тым бос емеспін және айналамда уақыт өте тез өтеді.
Dialogue: 0,0:17:16.56,0:17:22.24,Default,,0,0,0,,Кейде мен мұны ысырап болғандай сезіндім.
Dialogue: 0,0:17:22.24,0:17:26.91,Default,,0,0,0,,Бұл дүниеде қаншама тамаша дүниелер бар.
Dialogue: 0,0:17:26.91,0:17:33.21,Default,,0,0,0,,Ақырындап, бірінен соң бірін ұқыпты баптай алсам ғой.
Dialogue: 0,0:17:36.92,0:17:39.25,Default,,0,0,0,,《Эй мысық➡
Dialogue: 0,0:17:39.25,0:17:43.26,Default,,0,0,0,,Сіз мұнда үнемі не нәрсеге қарап отырасыз? 》
Dialogue: 0,0:17:48.53,0:17:52.23,Default,,0,0,0,,《Сіз маңызды нәрсе күтіп тұрсыз ба? 》
Dialogue: 0,0:17:59.54,0:18:19.56,Default,,0,0,0,,♬～
Dialogue: 0,0:18:19.56,0:18:39.58,Default,,0,0,0,,♬～
Dialogue: 0,0:18:39.58,0:18:42.85,Default,,0,0,0,,♬～
Dialogue: 0,0:18:42.85,0:18:44.85,Default,,0,0,0,,《Мысық! 》
Dialogue: 0,0:18:46.52,0:18:50.86,Default,,0,0,0,,《Онша уақыттан кейін не күтіп тұрсың? 》
Dialogue: 0,0:18:50.86,0:19:02.54,Default,,0,0,0,,♬～
Dialogue: 0,0:19:02.54,0:19:04.54,Default,,0,0,0,,《Мысық…》
Dialogue: 0,0:19:04.54,0:19:21.22,Default,,0,0,0,,♬～
Dialogue: 0,0:19:21.22,0:19:25.56,Default,,0,0,0,,Мен білмей тұрып, таң болды.
Dialogue: 0,0:19:25.56,0:19:28.56,Default,,0,0,0,,Түні бойы жаңбыр жауып тұрса да
Dialogue: 0,0:19:28.56,0:19:32.27,Default,,0,0,0,,Бұл өте сергітетін болды.
Dialogue: 0,0:19:37.24,0:19:39.57,Default,,0,0,0,,Президент Арияға рахмет
Dialogue: 0,0:19:39.57,0:19:42.98,Default,,0,0,0,,Мен өзімді тым қатты итеріп жатқанымды түсіндім.
Dialogue: 0,0:19:47.92,0:19:53.92,Default,,0,0,0,,Мен ARIA компаниясын президент Ариямен бірге бастадым.
Dialogue: 0,0:19:57.59,0:20:01.26,Default,,0,0,0,,Әдемі көгілдір көздеріңде бейнеленген дүние
Dialogue: 0,0:20:01.26,0:20:04.93,Default,,0,0,0,,Мен оны сенімен көргім келеді деп ойладым.
Dialogue: 0,0:20:04.93,0:20:12.94,Default,,0,0,0,,♬～
Dialogue: 0,0:20:12.94,0:20:15.94,Default,,0,0,0,,《(Аяқ)》
Dialogue: 0,0:20:15.94,0:20:18.95,Default,,0,0,0,,《Пуй... Пуи? 》
Dialogue: 0,0:20:18.95,0:20:37.97,Default,,0,0,0,,♬～
Dialogue: 0,0:20:37.97,0:20:39.90,Default,,0,0,0,,♬～
Dialogue: 0,0:20:39.90,0:20:43.57,Default,,0,0,0,,Барлығы осылай басталды
Dialogue: 0,0:20:43.57,0:21:03.59,Default,,0,0,0,,♬～
Dialogue: 0,0:21:03.59,0:21:19.27,Default,,0,0,0,,♬～
Dialogue: 0,0:21:19.27,0:21:22.98,Default,,0,0,0,,Акари-чан Хахи
Dialogue: 0,0:21:24.95,0:21:30.28,Default,,0,0,0,,Болашақта Акаридің ARIA компаниясы жұмысын бастайды.
Dialogue: 0,0:21:30.28,0:21:32.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:32.29,0:21:45.57,Default,,0,0,0,,♬～
Dialogue: 0,0:21:45.57,0:21:49.57,Default,,0,0,0,,Акари-чанның ARIA компаниясы туралы әлі ешкім білмейді.
Dialogue: 0,0:21:49.57,0:21:52.57,Default,,0,0,0,,Біз асыға күтеміз
Dialogue: 0,0:21:52.57,0:21:54.58,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:21:55.58,0:21:57.91,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:21:57.91,0:22:04.59,Default,,0,0,0,,♬～
Dialogue: 0,0:22:04.59,0:22:06.92,Default,,0,0,0,,Иә, мен бар күшімді саламын!
Dialogue: 0,0:22:06.92,0:22:13.26,Default,,0,0,0,,Әй, (Анна әже) Хехехе...
Dialogue: 0,0:22:13.26,0:22:17.60,Default,,0,0,0,,<Ай-чан, мен ARIA компаниясына қосылдым➡
Dialogue: 0,0:22:17.60,0:22:19.60,Default,,0,0,0,,Мен өте қуаныштымын>
Dialogue: 0,0:22:19.60,0:22:25.01,Default,,0,0,0,,<Себебі мен осындай тамаша адамдармен күнімді өткіземін>
Dialogue: 0,0:22:26.61,0:22:30.61,Default,,0,0,0,,<Мырза. Акари, ARIA компаниясы қандай керемет➡
Dialogue: 0,0:22:30.61,0:22:32.95,Default,,0,0,0,,Әртүрлі адамдардың ойлары мен тілектері➡
Dialogue: 0,0:22:32.95,0:22:35.95,Default,,0,0,0,,Мейірімділіктің қосындысы шығар.＞
Dialogue: 0,0:22:35.95,0:22:39.55,Default,,0,0,0,,<Хехе, мен қатты қызғанамын>
Dialogue: 0,0:22:44.89,0:23:04.91,Default,,0,0,0,,♬～
Dialogue: 0,0:23:04.91,0:23:24.93,Default,,0,0,0,,♬～
Dialogue: 0,0:23:24.93,0:23:44.89,Default,,0,0,0,,♬～
Dialogue: 0,0:23:44.89,0:24:04.91,Default,,0,0,0,,♬～
Dialogue: 0,0:24:04.91,0:24:13.91,Default,,0,0,0,,♬～
Dialogue: 0,0:24:15.95,0:24:18.95,Default,,0,0,0,,<Аа, Акари-сенпай... Бұл үлкен SOS! ＞
Dialogue: 0,0:24:18.95,0:24:20.95,Default,,0,0,0,,<Е, не болды? Алиса>
Dialogue: 0,0:24:20.95,0:24:23.29,Default,,0,0,0,,<Афина-сенпай - SOS>
Dialogue: 0,0:24:23.29,0:24:25.29,Default,,0,0,0,,<Келесі жолы...>
Dialogue: 0,0:24:26.63,0:24:28.96,Default,,0,0,0,,<Қолыңызды беріңізші>
Dialogue: 0,0:24:30.46,0:24:36.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory