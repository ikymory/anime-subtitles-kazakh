Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.30,0:00:12.98,Default,,0,0,0,,<Ай-чан: Нео Венецияда да күз➡
Dialogue: 0,0:00:12.98,0:00:14.98,Default,,0,0,0,,Бітті>
Dialogue: 0,0:00:14.98,0:00:17.98,Default,,0,0,0,,<Жақында қыс келеді>
Dialogue: 0,0:00:17.98,0:00:22.32,Default,,0,0,0,,<Алиса-чан жақында Примаға көтерілді➡
Dialogue: 0,0:00:22.32,0:00:26.32,Default,,0,0,0,,Ең соңғы бірлескен жаттығу Айка-чан➡ болды
Dialogue: 0,0:00:26.32,0:00:29.02,Default,,0,0,0,,Ол стандартқа айналды>
Dialogue: 0,0:00:33.66,0:00:37.67,Default,,0,0,0,,Күн суытып барады, солай емес пе? Айка-чан
Dialogue: 0,0:00:37.67,0:00:41.00,Default,,0,0,0,,Иә? Иә...
Dialogue: 0,0:00:41.00,0:00:44.01,Default,,0,0,0,,Күз аяқталуға жақын.
Dialogue: 0,0:00:45.67,0:00:49.01,Default,,0,0,0,,Эй, Айка-чан, иә?
Dialogue: 0,0:00:49.01,0:00:51.35,Default,,0,0,0,,Екі адаммен бірлескен жаттығу
Dialogue: 0,0:00:51.35,0:00:55.35,Default,,0,0,0,,Бұл маған жаңа кездескен кезді еске түсіреді.
Dialogue: 0,0:01:01.62,0:01:06.30,Default,,0,0,0,,Жалғыз емеспін десем, өтірік айтқан болар едім.
Dialogue: 0,0:01:06.30,0:01:10.30,Default,,0,0,0,,Бірақ бұл өте қуанышты нәрсе.
Dialogue: 0,0:01:10.30,0:01:13.30,Default,,0,0,0,,Біз де ұтыла алмаймыз, солай ма?
Dialogue: 0,0:01:15.30,0:01:20.64,Default,,0,0,0,,Жарайды, Прима болу үшін бірге жұмыс істейік!
Dialogue: 0,0:01:20.64,0:01:24.31,Default,,0,0,0,,Мм... Айка-чан?
Dialogue: 0,0:01:24.31,0:01:27.02,Default,,0,0,0,,Кешіріңіз, Акари
Dialogue: 0,0:01:29.32,0:01:34.66,Default,,0,0,0,,Мен енді сенімен бірге жаттығу жасай алмаймын.
Dialogue: 0,0:01:34.66,0:01:36.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:39.33,0:01:41.33,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:01:41.33,0:01:43.33,Default,,0,0,0,,Е...
Dialogue: 0,0:01:43.33,0:01:45.33,Default,,0,0,0,,Иә!?
Dialogue: 0,0:01:47.67,0:01:50.01,Default,,0,0,0,,Неліктен кешірім сұрайсыз?
Dialogue: 0,0:01:50.01,0:01:52.67,Default,,0,0,0,,Өйткені... аа...
Dialogue: 0,0:01:52.67,0:01:56.68,Default,,0,0,0,,Мен осы күнді армандадым, осы күн үшін аянбай еңбек еттім.
Dialogue: 0,0:01:56.68,0:01:58.68,Default,,0,0,0,,Уау
Dialogue: 0,0:01:58.68,0:02:01.95,Default,,0,0,0,,Примаға көтерілуіңізбен құттықтаймыз, Айка-чан!
Dialogue: 0,0:02:01.95,0:02:04.95,Default,,0,0,0,,Пупуиню~!
Dialogue: 0,0:02:04.95,0:02:10.29,Default,,0,0,0,,Рахмет, мен Акари осылай айтады деп ойладым.
Dialogue: 0,0:02:10.29,0:02:16.00,Default,,0,0,0,,Сонымен қатар, менің сізге айтарым бар.
Dialogue: 0,0:02:16.97,0:02:20.97,Default,,0,0,0,,♬～
Dialogue: 0,0:02:20.97,0:02:22.97,Default,,0,0,0,,Е!
Dialogue: 0,0:02:22.97,0:02:42.99,Default,,0,0,0,,♬～
Dialogue: 0,0:02:42.99,0:03:02.94,Default,,0,0,0,,♬～
Dialogue: 0,0:03:02.94,0:03:22.96,Default,,0,0,0,,♬～
Dialogue: 0,0:03:22.96,0:03:42.98,Default,,0,0,0,,♬～
Dialogue: 0,0:03:42.98,0:04:02.94,Default,,0,0,0,,♬～
Dialogue: 0,0:04:02.94,0:04:08.54,Default,,0,0,0,,♬～
Dialogue: 0,0:04:14.28,0:04:19.62,Default,,0,0,0,,Айка-чан Примаға көтерілді ме? иә
Dialogue: 0,0:04:19.62,0:04:22.62,Default,,0,0,0,,Ой, жарайды, хехехе
Dialogue: 0,0:04:22.62,0:04:25.96,Default,,0,0,0,,Бұл өте жақсы жаңалық, иә.
Dialogue: 0,0:04:25.96,0:04:29.97,Default,,0,0,0,,Оның көше атауы – «Розен патшайымы», раушан гүлдерінің ханшайымы.
Dialogue: 0,0:04:29.97,0:04:33.30,Default,,0,0,0,,Хехе... Сонымен сен соны шештің.
Dialogue: 0,0:04:33.30,0:04:35.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:35.97,0:04:39.64,Default,,0,0,0,,Акира-чан, мен көптен бері уайымдап жүрмін.
Dialogue: 0,0:04:39.64,0:04:43.65,Default,,0,0,0,,Айка-чанның жоғарылау емтиханы қашан өтеді?
Dialogue: 0,0:04:43.65,0:04:47.32,Default,,0,0,0,,Айка-чан жай ғана примаға айналмайды.
Dialogue: 0,0:04:47.32,0:04:51.62,Default,,0,0,0,,Ол Химейяны арқасына көтеріп жүруі керек.
Dialogue: 0,0:04:56.32,0:04:58.99,Default,,0,0,0,,А... Солай ма?
Dialogue: 0,0:04:58.99,0:05:02.60,Default,,0,0,0,,Бірақ Айка-чан жақсы болады.
Dialogue: 0,0:05:04.93,0:05:06.94,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:05:06.94,0:05:10.27,Default,,0,0,0,,Негізі тағы бір жақсы жаңалығым бар.
Dialogue: 0,0:05:10.27,0:05:12.61,Default,,0,0,0,,Келесі жолы Санта-Люсия станциясының жанында
Dialogue: 0,0:05:12.61,0:05:15.28,Default,,0,0,0,,Химея филиалы ашылғалы жатыр.
Dialogue: 0,0:05:15.28,0:05:20.62,Default,,0,0,0,,Айка-чан сол жерде филиал менеджері ретінде барады.
Dialogue: 0,0:05:20.62,0:05:24.95,Default,,0,0,0,,Сондықтан мен қазірден бастап өте бос боламын.
Dialogue: 0,0:05:24.95,0:05:29.29,Default,,0,0,0,,Бірақ не үшін екенін білмеймін, тіпті қуансам да.
Dialogue: 0,0:05:29.29,0:05:32.99,Default,,0,0,0,,Айка-чан қатты жылады...
Dialogue: 0,0:05:37.63,0:05:40.97,Default,,0,0,0,,Акари-чан иә
Dialogue: 0,0:05:40.97,0:05:45.97,Default,,0,0,0,,Ертең Prima жоғарылау емтиханы өтеді.
Dialogue: 0,0:05:47.31,0:05:49.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:56.32,0:05:58.32,Default,,0,0,0,,Иә
Dialogue: 0,0:06:03.93,0:06:06.60,Default,,0,0,0,,Ария президенті Пуиню
Dialogue: 0,0:06:06.60,0:06:09.93,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:06:09.93,0:06:14.27,Default,,0,0,0,,Ах~ мен ұйықтай алмаймын.
Dialogue: 0,0:06:14.27,0:06:16.61,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:16.61,0:06:18.61,Default,,0,0,0,,Пухат Пуиню
Dialogue: 0,0:06:18.61,0:06:21.31,Default,,0,0,0,,Хмм... Пуипу Пуйпуи Пуйпуи
Dialogue: 0,0:06:24.95,0:06:30.62,Default,,0,0,0,,<Ай-чан, ертең Prima бойынша жоғарылату емтиханы>
Dialogue: 0,0:06:30.62,0:06:33.62,Default,,0,0,0,,<Жүрегім қатты соғып, ұйықтай алмаймын➡
Dialogue: 0,0:06:33.62,0:06:37.29,Default,,0,0,0,,Түн болды, бірақ мен біраз жаттығу жасаймын.＞
Dialogue: 0,0:06:37.29,0:06:40.30,Default,,0,0,0,,<Акари-сан, ақыры келді>
Dialogue: 0,0:06:40.30,0:06:43.60,Default,,0,0,0,,<Мен де аздап қобалжыдым>
Dialogue: 0,0:06:47.30,0:06:49.30,Default,,0,0,0,,Pupuipuipui
Dialogue: 0,0:06:49.30,0:06:54.31,Default,,0,0,0,,Ынтымақтастығыңызға рахмет, Президент Ария.
Dialogue: 0,0:06:54.31,0:06:57.98,Default,,0,0,0,,<Сабырлы бол және әдеттегі жаттығуыңды жаса>
Dialogue: 0,0:06:57.98,0:07:00.58,Default,,0,0,0,,Ах! иә? Сол дауыс...
Dialogue: 0,0:07:00.58,0:07:02.92,Default,,0,0,0,,Құлдым! Хахи
Dialogue: 0,0:07:02.92,0:07:04.92,Default,,0,0,0,,Иә? Момико
Dialogue: 0,0:07:04.92,0:07:09.26,Default,,0,0,0,,Әй, бұл қиын! Мен құладым! Құлды!
Dialogue: 0,0:07:09.26,0:07:12.59,Default,,0,0,0,,Ой... Не болды?
Dialogue: 0,0:07:12.59,0:07:15.60,Default,,0,0,0,,Мен орта мектептегі кездесуден үйге келе жатырмын.
Dialogue: 0,0:07:15.60,0:07:17.60,Default,,0,0,0,,Мен білмей тұрып, әмиян болды!
Dialogue: 0,0:07:17.60,0:07:19.60,Default,,0,0,0,,Олар резеңке жіптермен дұрыс жалғанса да.
Dialogue: 0,0:07:19.60,0:07:22.60,Default,,0,0,0,,Бұл құлау! Ававава...
Dialogue: 0,0:07:22.60,0:07:26.27,Default,,0,0,0,,Иә? Осындай уақытта ана не істеп жүр?
Dialogue: 0,0:07:26.27,0:07:30.61,Default,,0,0,0,,А... ертең Prima жоғарылау емтиханы.
Dialogue: 0,0:07:30.61,0:07:33.62,Default,,0,0,0,,Сонымен... не? Мен көремін
Dialogue: 0,0:07:33.62,0:07:39.29,Default,,0,0,0,,Мен де жақында жоғарылау емтиханын тапсырғалы жатырмын, сондықтан Момиконың сезімін түсінемін.
Dialogue: 0,0:07:39.29,0:07:42.96,Default,,0,0,0,,Барымызды бірге жасайық, Акацуки-сан...
Dialogue: 0,0:07:42.96,0:07:45.63,Default,,0,0,0,,Иә! (Вуди) Сәлем Акацуки-кин
Dialogue: 0,0:07:45.63,0:07:49.30,Default,,0,0,0,,Әмиян болды! (Акацуки) Не!? Қай жерде болды?
Dialogue: 0,0:07:49.30,0:07:52.30,Default,,0,0,0,,Дүкендегі дәретханаға құлады.
Dialogue: 0,0:07:52.30,0:07:55.30,Default,,0,0,0,,Құлды ма? (Вуди) Құлап бара жатты.
Dialogue: 0,0:07:55.30,0:07:59.64,Default,,0,0,0,,Мен... Құлмауым керек жерде құлаймын деп ойламадым.
Dialogue: 0,0:07:59.64,0:08:02.91,Default,,0,0,0,,Мен әмиянмен әжетханаға да бара алмаймын. (Вуди) Сабырлан, Акацуки.
Dialogue: 0,0:08:02.91,0:08:05.25,Default,,0,0,0,,Сабыр ет! (Акацуки) Бұл...
Dialogue: 0,0:08:05.25,0:08:08.92,Default,,0,0,0,,Иә? Акари-чан, сен осы уақытта жаттығу жасайсың ба?
Dialogue: 0,0:08:08.92,0:08:11.25,Default,,0,0,0,,А... иә
Dialogue: 0,0:08:11.25,0:08:14.59,Default,,0,0,0,,Емтиханға сәттілік, Момико!
Dialogue: 0,0:08:14.59,0:08:16.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:16.59,0:08:20.30,Default,,0,0,0,,Мен тағы құладым! Ах... ааа ааа...
Dialogue: 0,0:08:29.94,0:08:34.94,Default,,0,0,0,,Ха... Ауа-райы бұзылмайды деп үміттенемін.
Dialogue: 0,0:08:36.28,0:08:39.28,Default,,0,0,0,,Ұйықтауға бар күшіңізді салыңыз
Dialogue: 0,0:08:54.96,0:08:58.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:58.63,0:09:02.57,Default,,0,0,0,,Пуиню ~ Қайырлы таң Алисия-сан
Dialogue: 0,0:09:02.57,0:09:04.57,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:09:06.24,0:09:09.58,Default,,0,0,0,,Жаңбыр жауып тұр, иә.
Dialogue: 0,0:09:09.58,0:09:11.91,Default,,0,0,0,,Пуиню…
Dialogue: 0,0:09:11.91,0:09:17.92,Default,,0,0,0,,Әй, алыстағы аспан жарық. Түстен кейін көтерілетін сияқты.
Dialogue: 0,0:09:18.92,0:09:23.26,Default,,0,0,0,,Жоғарылау емтиханын кейінге қалдырамыз ба? Е...?
Dialogue: 0,0:09:23.26,0:09:25.93,Default,,0,0,0,,Бұл маңызды күн, солай емес пе?
Dialogue: 0,0:09:25.93,0:09:30.60,Default,,0,0,0,,Жақсы күні тағы да тест тапсырайық.
Dialogue: 0,0:09:30.60,0:09:33.27,Default,,0,0,0,,Жарайды, иә?
Dialogue: 0,0:09:33.27,0:09:36.60,Default,,0,0,0,,Мен бұл күнді күттім.
Dialogue: 0,0:09:36.60,0:09:41.28,Default,,0,0,0,,Өйткені бұл Алисия жоғарылау емтиханын тапсыруға шешім қабылдаған күн болатын.
Dialogue: 0,0:09:41.28,0:09:45.95,Default,,0,0,0,,Бүгін мен үшін маңызды күн.
Dialogue: 0,0:09:45.95,0:09:47.95,Default,,0,0,0,,Акари-чан...
Dialogue: 0,0:09:47.95,0:09:52.62,Default,,0,0,0,,Түстен кейін тоқтамаса, менің амалым қалмас еді.
Dialogue: 0,0:09:52.62,0:09:54.62,Default,,0,0,0,,Эххе
Dialogue: 0,0:09:59.29,0:10:04.30,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:10:17.65,0:10:24.65,Default,,0,0,0,,♬～
Dialogue: 0,0:10:24.65,0:10:29.32,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:10:29.32,0:10:31.99,Default,,0,0,0,,Акари-чан...
Dialogue: 0,0:10:31.99,0:10:34.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:34.33,0:10:36.33,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:36.33,0:10:38.33,Default,,0,0,0,,Ах
Dialogue: 0,0:10:39.33,0:10:41.34,Default,,0,0,0,,Пу... Пуи?
Dialogue: 0,0:10:41.34,0:10:43.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:44.34,0:10:47.64,Default,,0,0,0,,Жаңбыр тоқтады
Dialogue: 0,0:10:51.35,0:10:54.65,Default,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,0:10:56.02,0:10:59.95,Default,,0,0,0,,Иә Пуипуй!
Dialogue: 0,0:11:14.97,0:11:18.64,Default,,0,0,0,,Дайындық аяқталды. Рақмет сізге.
Dialogue: 0,0:11:18.64,0:11:20.64,Default,,0,0,0,,Иә
Dialogue: 0,0:11:20.64,0:11:26.98,Default,,0,0,0,,♬～
Dialogue: 0,0:11:26.98,0:11:29.32,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:11:29.32,0:11:32.32,Default,,0,0,0,,Маған қолыңызды беріңізші.
Dialogue: 0,0:11:33.66,0:11:35.66,Default,,0,0,0,,Иә
Dialogue: 0,0:11:35.66,0:11:37.66,Default,,0,0,0,,(гондолаға отыру дыбысы)
Dialogue: 0,0:11:38.66,0:11:42.66,Default,,0,0,0,,О? Бұл... ыстық су бөтелкесі
Dialogue: 0,0:11:42.66,0:11:46.67,Default,,0,0,0,,О, қандай тамаша қызмет (Президент Ария) Пупуй!
Dialogue: 0,0:11:46.67,0:11:50.61,Default,,0,0,0,,Орындықтар мен көрпелер жылы
Dialogue: 0,0:11:50.61,0:11:53.27,Default,,0,0,0,,Пуи Пуи Пуи Пуи Пуи
Dialogue: 0,0:11:53.27,0:11:56.98,Default,,0,0,0,,Иә иә (Президент Ария) Пуинью
Dialogue: 0,0:12:00.62,0:12:02.62,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:12:03.95,0:12:07.26,Default,,0,0,0,,Олай болса кетейік.
Dialogue: 0,0:12:09.96,0:12:24.64,Default,,0,0,0,,♬～
Dialogue: 0,0:12:24.64,0:12:27.98,Default,,0,0,0,,Осы жерден Үлкен каналға дейін
Dialogue: 0,0:12:27.98,0:12:32.31,Default,,0,0,0,,Ұлы қоңырау мұнарасын кез келген жерден көруге болады.
Dialogue: 0,0:12:32.31,0:12:36.65,Default,,0,0,0,,Бұл аллея жаңбырдан кейінгі күндерде ұсынылады.
Dialogue: 0,0:12:36.65,0:12:40.05,Default,,0,0,0,,Жақсы! (Президент Ария) Пуиню~!
Dialogue: 0,0:12:41.32,0:12:44.33,Default,,0,0,0,,Иә? Эй, Акари-чан!
Dialogue: 0,0:12:44.33,0:12:46.10,Default,,0,0,0,,Әй, ау.
Dialogue: 0,0:12:46.10,0:12:49.66,Default,,0,0,0,,Бұл регата спортшысы.
Dialogue: 0,0:12:49.66,0:12:52.27,Default,,0,0,0,,Есіктерді өзі жасайды.
Dialogue: 0,0:12:52.27,0:12:54.60,Default,,0,0,0,,Хахахаха мен көрдім.
Dialogue: 0,0:12:54.60,0:12:57.27,Default,,0,0,0,,Өз жолыңызды кесіңіз
Dialogue: 0,0:12:57.27,0:13:00.27,Default,,0,0,0,,Олай етпесең, өкінесің.
Dialogue: 0,0:13:00.27,0:13:02.28,Default,,0,0,0,,Келесі жылы біз жеңеміз!
Dialogue: 0,0:13:02.28,0:13:04.58,Default,,0,0,0,,Мұнда Он екі Құбыжық Айдың тек Төменгі Айлары ғана жиналған
Dialogue: 0,0:13:05.95,0:13:08.55,Default,,0,0,0,,Годоланың жанынан өту!
Dialogue: 0,0:13:09.62,0:13:11.95,Default,,0,0,0,,Соңында, Үлкен канал
Dialogue: 0,0:13:11.95,0:13:16.96,Default,,0,0,0,,Үлкен канал Нео-Венецияны төңкерілген S пішінінде екіге бөледі.
Dialogue: 0,0:13:17.96,0:13:19.96,Default,,0,0,0,,Суық емессің бе?
Dialogue: 0,0:13:19.96,0:13:22.96,Default,,0,0,0,,Иә (Президент Ария) Pupu~i
Dialogue: 0,0:13:22.96,0:13:27.30,Default,,0,0,0,,Риалто көпірі Үлкен каналды қамтиды.
Dialogue: 0,0:13:27.30,0:13:32.97,Default,,0,0,0,,Бұл судың бетінде жүретін және көпірден тамашалайтын адамдар жүретін жер.
Dialogue: 0,0:13:32.97,0:13:35.58,Default,,0,0,0,,Бұл да кездесу орны.
Dialogue: 0,0:13:36.98,0:13:39.98,Default,,0,0,0,,Эй, мен мұндамын, Акацуки-кин.
Dialogue: 0,0:13:39.98,0:13:42.98,Default,,0,0,0,,Иә? Эй, Вуди
Dialogue: 0,0:13:42.98,0:13:46.32,Default,,0,0,0,,Мен жоспарды орындаймын. (Вуди) Түсіндім.
Dialogue: 0,0:13:46.32,0:13:49.32,Default,,0,0,0,,Сәттілік! (Вуди) Қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:13:50.59,0:13:55.60,Default,,0,0,0,,Фурафуре Момико (Вуди) Фурафуре Акари-чан
Dialogue: 0,0:13:55.60,0:13:58.27,Default,,0,0,0,,Акацуки-сан мен Вуди-сан... (Вуди) Барыңды сал, Акари-чан!
Dialogue: 0,0:13:58.27,0:14:01.94,Default,,0,0,0,,А... Алисия, бар күшіңді сал!
Dialogue: 0,0:14:01.94,0:14:04.27,Default,,0,0,0,,Эй...эй, түс! Сіз құлап жатырсыз!
Dialogue: 0,0:14:04.27,0:14:07.61,Default,,0,0,0,,Әй, ау, һехехе
Dialogue: 0,0:14:07.61,0:14:13.61,Default,,0,0,0,,♬～
Dialogue: 0,0:14:13.61,0:14:19.95,Default,,0,0,0,,♬ Бұл аспан мәңгілікке жалғасады
Dialogue: 0,0:14:19.95,0:14:25.63,Default,,0,0,0,,♬ Сізге қарап тұрған профиль
Dialogue: 0,0:14:25.63,0:14:35.97,Default,,0,0,0,,♬ Ұзын шашы екі жаққа тигенде теңселіп тұр.
Dialogue: 0,0:14:35.97,0:14:43.98,Default,,0,0,0,,♬ Мұңды сөзбен айтып жеткізу мүмкін болмаса да
Dialogue: 0,0:14:43.98,0:14:49.32,Default,,0,0,0,,♬ Сол кезде және қазір
Dialogue: 0,0:14:49.32,0:14:55.26,Default,,0,0,0,,♬ Нұрға толы бұл қалада
Dialogue: 0,0:14:55.26,0:15:01.60,Default,,0,0,0,,♬ Маған ешқашан өзгермейтін сезімдеріңізді беріңіз
Dialogue: 0,0:15:01.60,0:15:07.60,Default,,0,0,0,,♬ Мейірімділікке тап болғанда
Dialogue: 0,0:15:07.60,0:15:13.27,Default,,0,0,0,,♬ Жел кез келген уақытта соғады
Dialogue: 0,0:15:13.27,0:15:19.61,Default,,0,0,0,,♬ Алыста еріп бара жатыр
Dialogue: 0,0:15:19.61,0:15:26.29,Default,,0,0,0,,♬ Көзімді ақырын жұмып алдым.
Dialogue: 0,0:15:26.29,0:15:28.96,Default,,0,0,0,,Годоланың жанынан өту!
Dialogue: 0,0:15:28.96,0:15:30.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.96,0:15:33.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:33.96,0:15:38.97,Default,,0,0,0,,♬～
Dialogue: 0,0:15:38.97,0:15:41.64,Default,,0,0,0,,Ымырт жақындаған сайын
Dialogue: 0,0:15:41.64,0:15:45.97,Default,,0,0,0,,Әулие Марк алаңы және Лагуна деп аталатын ішкі теңіз
Dialogue: 0,0:15:45.97,0:15:49.64,Default,,0,0,0,,Реңк сәт сайын өзгереді.
Dialogue: 0,0:15:49.64,0:15:52.91,Default,,0,0,0,,Жылы түстерге оранғандай
Dialogue: 0,0:15:52.91,0:15:57.22,Default,,0,0,0,,Бұл бізді емдей алатын сияқты емес пе?
Dialogue: 0,0:15:58.92,0:16:05.26,Default,,0,0,0,,Акари-чан, сіз ескек есуді және туристік ақпарат беруді жақсы меңгердіңіз.
Dialogue: 0,0:16:05.26,0:16:09.26,Default,,0,0,0,,Ал мен Акари-чанның тұлғасын шынымен сезінемін.
Dialogue: 0,0:16:09.26,0:16:13.60,Default,,0,0,0,,Бұл өте маңызды.
Dialogue: 0,0:16:13.60,0:16:16.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:19.94,0:16:23.28,Default,,0,0,0,,Олай болса, ары қарай жүрейік.
Dialogue: 0,0:16:23.28,0:16:25.28,Default,,0,0,0,,Иә
Dialogue: 0,0:16:28.28,0:16:31.62,Default,,0,0,0,,Алисия, бұл су жолы...
Dialogue: 0,0:16:31.62,0:16:35.96,Default,,0,0,0,,Иә, бұл әдетте шектеулі аймақ.
Dialogue: 0,0:16:35.96,0:16:41.63,Default,,0,0,0,,Бірақ қазір бізге ол жерге баруға рұқсат берілді.
Dialogue: 0,0:16:41.63,0:16:44.63,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:16:44.63,0:16:49.34,Default,,0,0,0,,Арғы жағында Акари-чанның болашағы күтіп тұр
Dialogue: 0,0:16:51.57,0:16:53.57,Default,,0,0,0,,Иә
Dialogue: 0,0:16:53.57,0:17:01.92,Default,,0,0,0,,♬～
Dialogue: 0,0:17:01.92,0:17:07.92,Default,,0,0,0,,<Ол өте тар... мен өткен кез келген су жолына қарағанда>
Dialogue: 0,0:17:07.92,0:17:11.26,Default,,0,0,0,,<Мен мұндай су жолының болғанына сене алмаймын>
Dialogue: 0,0:17:11.26,0:17:21.60,Default,,0,0,0,,♬～
Dialogue: 0,0:17:21.60,0:17:23.94,Default,,0,0,0,,<Бірақ неге?>
Dialogue: 0,0:17:23.94,0:17:27.28,Default,,0,0,0,,<Бір қызығы, менде уайым жоқ>
Dialogue: 0,0:17:27.28,0:17:32.95,Default,,0,0,0,,♬～
Dialogue: 0,0:17:32.95,0:17:36.62,Default,,0,0,0,,<Мен сезінемін... жақсы>
Dialogue: 0,0:17:36.62,0:17:39.29,Default,,0,0,0,,<О, мен түсінемін>
Dialogue: 0,0:17:39.29,0:17:41.96,Default,,0,0,0,,<Үшеуміз, әрқашан мәңгілік➡
Dialogue: 0,0:17:41.96,0:17:45.63,Default,,0,0,0,,Өйткені біз бірге жаттығып келеміз>
Dialogue: 0,0:17:45.63,0:17:49.03,Default,,0,0,0,,<Ендеше, бәрі жақсы>
Dialogue: 0,0:17:52.57,0:17:55.57,Default,,0,0,0,,<Ескектен саусақ ұшына дейін беріледі➡
Dialogue: 0,0:17:55.57,0:18:00.24,Default,,0,0,0,,Өте терең және тыныш су әуені＞
Dialogue: 0,0:18:00.24,0:18:02.91,Default,,0,0,0,,<Барлығымен бірге өткен қымбат күндер➡
Dialogue: 0,0:18:02.91,0:18:08.25,Default,,0,0,0,,Мені қазір қолдап, алға қарай итермелеу >
Dialogue: 0,0:18:08.25,0:18:16.59,Default,,0,0,0,,♬～
Dialogue: 0,0:18:16.59,0:18:18.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:21.60,0:18:24.60,Default,,0,0,0,,Годоланың жанынан өту!
Dialogue: 0,0:18:24.60,0:18:34.61,Default,,0,0,0,,♬～
Dialogue: 0,0:18:34.61,0:18:38.95,Default,,0,0,0,,Акари-чан, тамаша сапар болды.
Dialogue: 0,0:18:38.95,0:18:41.28,Default,,0,0,0,,Босаңсыған және сабырлы
Dialogue: 0,0:18:41.28,0:18:45.62,Default,,0,0,0,,Гондола суға айналғандай.
Dialogue: 0,0:18:45.62,0:18:47.62,Default,,0,0,0,,Алисия...
Dialogue: 0,0:18:47.62,0:18:50.56,Default,,0,0,0,,Енді, соңғы курс.
Dialogue: 0,0:18:50.56,0:18:55.23,Default,,0,0,0,,Осы жерден қайда бару керектігін Акари-чан шешеді.
Dialogue: 0,0:18:55.23,0:18:58.90,Default,,0,0,0,,Аа... Қандай прима болғың келеді?
Dialogue: 0,0:18:58.90,0:19:02.57,Default,,0,0,0,,Акари-чан шешеді.
Dialogue: 0,0:19:02.57,0:19:06.24,Default,,0,0,0,,Сіз қандай прима болғыңыз келеді...
Dialogue: 0,0:19:06.24,0:19:08.24,Default,,0,0,0,,Иә
Dialogue: 0,0:19:10.91,0:19:22.26,Default,,0,0,0,,♬～
Dialogue: 0,0:19:22.26,0:19:25.59,Default,,0,0,0,,Сәлем, Акари-чан
Dialogue: 0,0:19:25.59,0:19:30.60,Default,,0,0,0,,Заттар қозғала бастағанда біртүрлі болады.
Dialogue: 0,0:19:30.60,0:19:34.27,Default,,0,0,0,,Әркім өз жолымен жүрсе де
Dialogue: 0,0:19:34.27,0:19:36.94,Default,,0,0,0,,Бір-бірінің өзгерістерін шақырғандай
Dialogue: 0,0:19:36.94,0:19:39.94,Default,,0,0,0,,Тізбектер қабаттасады
Dialogue: 0,0:19:39.94,0:19:43.61,Default,,0,0,0,,Басынан бастап сияқты
Dialogue: 0,0:19:43.61,0:19:47.62,Default,,0,0,0,,Тағдыр жазғандай
Dialogue: 0,0:19:47.62,0:19:50.62,Default,,0,0,0,,<Алисия-сан…>
Dialogue: 0,0:19:50.62,0:19:59.63,Default,,0,0,0,,♬～
Dialogue: 0,0:19:59.63,0:20:03.33,Default,,0,0,0,,Алисия, мен оны көріп тұрмын.
Dialogue: 0,0:20:05.63,0:20:08.30,Default,,0,0,0,,Пуи?
Dialogue: 0,0:20:08.30,0:20:10.60,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:12.31,0:20:15.61,Default,,0,0,0,,Бұл менің мақсатым
Dialogue: 0,0:20:18.31,0:20:23.32,Default,,0,0,0,,Менің болғым келетінім әжем сияқты
Dialogue: 0,0:20:23.32,0:20:25.99,Default,,0,0,0,,Алисия сияқты
Dialogue: 0,0:20:25.99,0:20:29.99,Default,,0,0,0,,Прима ARIA компаниясының өзі сияқты
Dialogue: 0,0:20:34.66,0:20:38.07,Default,,0,0,0,,Акари-чан иә
Dialogue: 0,0:20:43.00,0:20:49.68,Default,,0,0,0,,Сіз Aqua-ға келгелі бері менің әлемім мүлде өзгерді.
Dialogue: 0,0:20:49.68,0:20:54.28,Default,,0,0,0,,Қарапайым болған күнделікті өмір, дүниенің көрінісі
Dialogue: 0,0:20:54.28,0:20:58.29,Default,,0,0,0,,Ол әдемі жарқырап тұрды.
Dialogue: 0,0:20:58.29,0:21:04.59,Default,,0,0,0,,Иә, сиқырлы сияқты.
Dialogue: 0,0:21:05.63,0:21:09.63,Default,,0,0,0,,Бұл акваны ақырын құшақтайды
Dialogue: 0,0:21:09.63,0:21:15.34,Default,,0,0,0,,Мәңгілік жалғасатын аспан мен теңіздей
Dialogue: 0,0:21:17.97,0:21:23.31,Default,,0,0,0,,Мен сені кездестіргеніме өте қуаныштымын
Dialogue: 0,0:21:23.31,0:21:28.32,Default,,0,0,0,,Рахмет саған менің Аквамарин
Dialogue: 0,0:21:28.32,0:21:31.32,Default,,0,0,0,,Су…Теңіз
Dialogue: 0,0:21:32.32,0:21:35.32,Default,,0,0,0,,Алыс көк
Dialogue: 0,0:21:35.32,0:21:37.63,Default,,0,0,0,,Пуиню…
Dialogue: 0,0:21:43.00,0:21:45.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:47.33,0:21:52.64,Default,,0,0,0,,Примаға көтерілуіңізбен құттықтаймыз, Акари-чан
Dialogue: 0,0:21:54.94,0:21:58.95,Default,,0,0,0,,Рахмет, Алисия.
Dialogue: 0,0:21:58.95,0:22:01.28,Default,,0,0,0,,Погни!
Dialogue: 0,0:22:01.28,0:22:04.99,Default,,0,0,0,,Президент Ария, мен жасадым!
Dialogue: 0,0:22:06.29,0:22:08.62,Default,,0,0,0,,Погни!
Dialogue: 0,0:22:08.62,0:22:13.29,Default,,0,0,0,,Мен ақыры Прима болдым! Пуипуй!
Dialogue: 0,0:22:13.29,0:22:18.63,Default,,0,0,0,,<Көптен бері...Мен сені әрқашан таңдандырдым>
Dialogue: 0,0:22:18.63,0:22:23.64,Default,,0,0,0,,<Мен бұл планетаға алғаш келген күннен бастап...>
Dialogue: 0,0:22:27.31,0:22:29.98,Default,,0,0,0,,Акари-чан
Dialogue: 0,0:22:29.98,0:22:31.98,Default,,0,0,0,,Иә
Dialogue: 0,0:22:31.98,0:22:36.28,Default,,0,0,0,,Менің сізге айтарым маңызды.
Dialogue: 0,0:22:38.99,0:22:40.99,Default,,0,0,0,,Иә
Dialogue: 0,0:22:44.99,0:23:01.94,Default,,0,0,0,,♬～
Dialogue: 0,0:23:01.94,0:23:05.95,Default,,0,0,0,,♬～
Dialogue: 0,0:23:05.95,0:23:25.97,Default,,0,0,0,,♬～
Dialogue: 0,0:23:25.97,0:23:45.99,Default,,0,0,0,,♬～
Dialogue: 0,0:23:45.99,0:24:05.94,Default,,0,0,0,,♬～
Dialogue: 0,0:24:05.94,0:24:13.95,Default,,0,0,0,,♬～
Dialogue: 0,0:24:15.98,0:24:20.99,Default,,0,0,0,,<Өзгеріс күндер, қымбат уақыт, әрбір болашақ>
Dialogue: 0,0:24:20.99,0:24:23.29,Default,,0,0,0,,<Ал мен жүре бастаймын>
Dialogue: 0,0:24:26.99,0:24:29.00,Default,,0,0,0,,<Енді маған қолыңды бер>
Dialogue: 0,0:24:30.50,0:24:36.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory