Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.30,0:00:04.30,Default,,0,0,0,,<ARIA компаниясына менің пайдасы бар ма? ＞
Dialogue: 0,0:00:04.30,0:00:06.30,Default,,0,0,0,,<Не? не болды? Кенеттен＞
Dialogue: 0,0:00:06.30,0:00:08.30,Default,,0,0,0,,<Әйтеуір, ол Ақари-сенпайға ұқсамайды.>
Dialogue: 0,0:00:08.30,0:00:10.31,Default,,0,0,0,,<Себебі~> <Жақсы емес пе? ＞
Dialogue: 0,0:00:10.31,0:00:12.64,Default,,0,0,0,,<Алисия-сан оған бәрібір емес пе?>
Dialogue: 0,0:00:12.64,0:00:14.64,Default,,0,0,0,,<Бұл пайдалы болмаса да>
Dialogue: 0,0:00:14.64,0:00:16.65,Default,,0,0,0,,<Бұл пайдалы болды деп үміттенемін...> <Бұл жүк болса да➡
Dialogue: 0,0:00:16.65,0:00:18.98,Default,,0,0,0,,Жарайды> <Омони...>
Dialogue: 0,0:00:34.30,0:00:38.00,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:41.97,0:00:45.57,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:00:49.91,0:00:52.58,Default,,0,0,0,,<Ай-чан Нео Венеция➡
Dialogue: 0,0:00:52.58,0:00:56.29,Default,,0,0,0,,Біраз уақыттан бері ауа райы жақсы болды＞
Dialogue: 0,0:00:57.92,0:01:01.92,Default,,0,0,0,,＜Ауа райы жақсы болса, мен өзімді сергек сезінемін＞
Dialogue: 0,0:01:01.92,0:01:05.26,Default,,0,0,0,,<Мен әдеттегідей таңғы жаттығуымды аяқтадым➡
Dialogue: 0,0:01:05.26,0:01:08.26,Default,,0,0,0,,Сіздің жарты күндік жұмысыңыздың басталуы>
Dialogue: 0,0:01:08.26,0:01:11.93,Default,,0,0,0,,♬～
Dialogue: 0,0:01:11.93,0:01:13.94,Default,,0,0,0,,Фуфуфуфу (Президент Ария) Пупупуи
Dialogue: 0,0:01:13.94,0:01:17.61,Default,,0,0,0,,<Жарайды, мен де бүгін бар күшімді саламын! ＞
Dialogue: 0,0:01:17.61,0:01:37.63,Default,,0,0,0,,♬～
Dialogue: 0,0:01:37.63,0:01:57.58,Default,,0,0,0,,♬～
Dialogue: 0,0:01:57.58,0:02:17.60,Default,,0,0,0,,♬～
Dialogue: 0,0:02:17.60,0:02:37.62,Default,,0,0,0,,♬～
Dialogue: 0,0:02:37.62,0:02:57.57,Default,,0,0,0,,♬～
Dialogue: 0,0:02:57.57,0:03:01.98,Default,,0,0,0,,♬～
Dialogue: 0,0:03:03.25,0:03:07.25,Default,,0,0,0,,Ария президенті (Ария президенті) Пуи?
Dialogue: 0,0:03:07.25,0:03:10.25,Default,,0,0,0,,Алисия шынымен бос емес.
Dialogue: 0,0:03:10.25,0:03:14.59,Default,,0,0,0,,Мен айына бір рет қана толық демалыс аламын.
Dialogue: 0,0:03:14.59,0:03:16.59,Default,,0,0,0,,Жаңа
Dialogue: 0,0:03:16.59,0:03:18.99,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:03:29.27,0:03:31.27,Default,,0,0,0,,Пуи~
Dialogue: 0,0:03:31.27,0:03:43.29,Default,,0,0,0,,♬～
Dialogue: 0,0:03:43.29,0:03:46.29,Default,,0,0,0,,Иә? Акари-чан?
Dialogue: 0,0:03:46.29,0:03:48.62,Default,,0,0,0,,А... иә
Dialogue: 0,0:03:48.62,0:03:52.56,Default,,0,0,0,,Не болды? (Президент Ария) Пуи?
Dialogue: 0,0:03:52.56,0:03:55.96,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:03:56.90,0:03:58.90,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:00.90,0:04:03.91,Default,,0,0,0,,Иә? (Президент Ария) Пуи?
Dialogue: 0,0:04:03.91,0:04:07.58,Default,,0,0,0,,Мен Алисияға көбірек көмектескім келеді!
Dialogue: 0,0:04:07.58,0:04:09.58,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:04:09.58,0:04:12.58,Default,,0,0,0,,Маған жеткілікті көмек болды.
Dialogue: 0,0:04:12.58,0:04:16.25,Default,,0,0,0,,Уау... толығырақ!
Dialogue: 0,0:04:16.25,0:04:19.92,Default,,0,0,0,,Мен компанияға көбірек көмектескім келеді.
Dialogue: 0,0:04:19.92,0:04:25.59,Default,,0,0,0,,Бірақ жалғыз адам ретінде менің қолымнан көп нәрсе келмейді...
Dialogue: 0,0:04:25.59,0:04:29.60,Default,,0,0,0,,Акари-чан, ертеңгі бірлескен жаттығу ше?
Dialogue: 0,0:04:29.60,0:04:35.27,Default,,0,0,0,,Хахи... Мен Айка-чанның Акира-санның нұсқаушысы болып сатушы жұмысы бар екенін естідім.
Dialogue: 0,0:04:35.27,0:04:38.94,Default,,0,0,0,,Алисаның мектепте де айналысатын ісі бар.
Dialogue: 0,0:04:38.94,0:04:42.94,Default,,0,0,0,,Ертең демалыс күні, солай ма?
Dialogue: 0,0:04:45.95,0:04:49.28,Default,,0,0,0,,Ал, трагетпен сынап көрейік, солай ма?
Dialogue: 0,0:04:49.28,0:04:52.29,Default,,0,0,0,,Әй, қасірет...
Dialogue: 0,0:04:56.89,0:05:00.90,Default,,0,0,0,,<Ай-чан, мен, Алисияның ұсынысы бойынша➡
Dialogue: 0,0:05:00.90,0:05:04.57,Default,,0,0,0,,Мен жолбарыстың нысанасын сынап көрейін деп шештім>
Dialogue: 0,0:05:04.57,0:05:06.57,Default,,0,0,0,,<Трагет дегеніміз не?➡
Dialogue: 0,0:05:06.57,0:05:09.24,Default,,0,0,0,,Годоланы пайдаланатын паром туралы➡
Dialogue: 0,0:05:09.24,0:05:11.91,Default,,0,0,0,,Үлкен каналда, қаланың басты көшесі➡
Dialogue: 0,0:05:11.91,0:05:14.24,Default,,0,0,0,,Бірнеше аялдамалар бар➡
Dialogue: 0,0:05:14.24,0:05:18.91,Default,,0,0,0,,Тұтынушыны алдыңғы және артқы екі ескекші алып жүреді.＞
Dialogue: 0,0:05:18.91,0:05:22.25,Default,,0,0,0,,<Тек қана ұшқыштық индустриядағы жалғызбастылар➡
Dialogue: 0,0:05:22.25,0:05:26.25,Default,,0,0,0,,Бұл жүк көлігі тұтынушыларды тасымалдай алады＞
Dialogue: 0,0:05:26.25,0:05:28.92,Default,,0,0,0,,<Себебі біз де әртүрлі компаниялардың бойдақтарымен бірігеміз➡
Dialogue: 0,0:05:28.92,0:05:30.93,Default,,0,0,0,,Мұнда Нео Венецияда➡
Dialogue: 0,0:05:30.93,0:05:33.93,Default,,0,0,0,,Тіпті мамандыққа айналды.＞
Dialogue: 0,0:05:33.93,0:05:38.93,Default,,0,0,0,,(нарықты тарту дауысы)
Dialogue: 0,0:05:40.60,0:05:43.61,Default,,0,0,0,,Ал, кездесу орны...
Dialogue: 0,0:05:43.61,0:05:46.27,Default,,0,0,0,,Бойдақтар, жиналыңдар!
Dialogue: 0,0:05:46.27,0:05:48.61,Default,,0,0,0,,Міне, міне. Иә, иә.
Dialogue: 0,0:05:48.61,0:05:51.21,Default,,0,0,0,,Уау~ Мұнда қазірдің өзінде адамдар көп.
Dialogue: 0,0:05:51.21,0:05:53.55,Default,,0,0,0,,Бұл жиналыс, иә...
Dialogue: 0,0:05:53.55,0:05:56.55,Default,,0,0,0,,Хахи! Хахи хахи хахи...
Dialogue: 0,0:05:56.55,0:05:59.89,Default,,0,0,0,,Ал, мен бұл ауданның бөлінуін жариялаймын.
Dialogue: 0,0:05:59.89,0:06:02.22,Default,,0,0,0,,＜Соңында, бұл жолбарыстың нысанасы＞
Dialogue: 0,0:06:02.22,0:06:05.89,Default,,0,0,0,,<Алғаш рет жаңа адамдармен жұмыс істеу➡
Dialogue: 0,0:06:05.89,0:06:08.23,Default,,0,0,0,,Мен қатты толқып тұрмын＞
Dialogue: 0,0:06:08.23,0:06:11.90,Default,,0,0,0,,<Мен әлі күнге дейін жарымжанмын, бірақ бар күшімді саламын.>
Dialogue: 0,0:06:11.90,0:06:14.90,Default,,0,0,0,,Мм... мүмкін...
Dialogue: 0,0:06:14.90,0:06:17.57,Default,,0,0,0,,Ей, мен әлі жартылай тоқпын...
Dialogue: 0,0:06:17.57,0:06:19.57,Default,,0,0,0,,Барлығыңыз ше?
Dialogue: 0,0:06:19.57,0:06:22.24,Default,,0,0,0,,Біз өз орындарымызға көшіп үлгердік.
Dialogue: 0,0:06:22.24,0:06:24.58,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:06:24.58,0:06:28.25,Default,,0,0,0,,Мына паромды төртеуміз басқарамыз.
Dialogue: 0,0:06:28.25,0:06:30.25,Default,,0,0,0,,Бүгін танысқаныма қуаныштымын.
Dialogue: 0,0:06:30.25,0:06:33.59,Default,,0,0,0,,Хахи, бұл ARIA компаниясынан Акари Мизунаши.
Dialogue: 0,0:06:33.59,0:06:36.59,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:06:36.59,0:06:38.59,Default,,0,0,0,,Иә кәмпит добы
Dialogue: 0,0:06:38.59,0:06:40.93,Default,,0,0,0,,Не? Сіз қобалжыған кезде
Dialogue: 0,0:06:40.93,0:06:43.60,Default,,0,0,0,,Қарынға бірдеңе салсаңыз, ол тыныштандырады.
Dialogue: 0,0:06:43.60,0:06:47.27,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:06:47.27,0:06:50.54,Default,,0,0,0,,Мен қызғылт сары планетадан келген Атласпын
Dialogue: 0,0:06:50.54,0:06:52.87,Default,,0,0,0,,Тұр… Тез тұр!
Dialogue: 0,0:06:52.87,0:06:56.88,Default,,0,0,0,,Бұл трагетті бірінші рет көру ме? Ха...хахи
Dialogue: 0,0:06:56.88,0:07:00.88,Default,,0,0,0,,Эй Аюми, кенеттен нақты нәрсені жасау қиын емес пе?
Dialogue: 0,0:07:00.88,0:07:03.22,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,0:07:03.22,0:07:05.22,Default,,0,0,0,,Қарапайым гондолалардан айырмашылығы
Dialogue: 0,0:07:05.22,0:07:07.22,Default,,0,0,0,,Тұтынушы орнынан тұрып жүк көлігіне мінеді.
Dialogue: 0,0:07:07.22,0:07:09.56,Default,,0,0,0,,Жүкі көп адам
Dialogue: 0,0:07:09.56,0:07:12.89,Default,,0,0,0,,Бірегей тепе-теңдік сезімі қажет.
Dialogue: 0,0:07:12.89,0:07:15.23,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:07:15.23,0:07:18.57,Default,,0,0,0,,Күрсін... Мен жақсымын ба?
Dialogue: 0,0:07:18.57,0:07:21.57,Default,,0,0,0,,Жарайды, ол үшін екі адам есуде.
Dialogue: 0,0:07:21.57,0:07:24.24,Default,,0,0,0,,Біз сізге көмектесеміз.
Dialogue: 0,0:07:24.24,0:07:27.91,Default,,0,0,0,,Содан кейін алдымен тәжірибелі үш адам айналады
Dialogue: 0,0:07:27.91,0:07:30.91,Default,,0,0,0,,Жағада қалған бір адам лекция оқып жатқаны туралы не айтасыз?
Dialogue: 0,0:07:30.91,0:07:32.91,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:32.91,0:07:34.92,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:07:34.92,0:07:37.92,Default,,0,0,0,,Учиха Химея тарихы танысқаныма қуаныштымын
Dialogue: 0,0:07:37.92,0:07:39.92,Default,,0,0,0,,Иә! Йоро... аа
Dialogue: 0,0:07:39.92,0:07:42.26,Default,,0,0,0,,Сізге трагедия ұнайды ма?
Dialogue: 0,0:07:42.26,0:07:45.93,Default,,0,0,0,,Не? Иә... хехехе
Dialogue: 0,0:07:45.93,0:07:48.93,Default,,0,0,0,,Маған да ұнайды! Ол жергілікті жермен тығыз байланысты.
Dialogue: 0,0:07:48.93,0:07:51.53,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:07:51.53,0:07:54.20,Default,,0,0,0,,Мм... иә
Dialogue: 0,0:07:54.20,0:07:57.21,Default,,0,0,0,,Бұл қызғылт сары планетадан шыққан Ан.
Dialogue: 0,0:07:57.21,0:08:02.21,Default,,0,0,0,,Менің атым Тори Мизунаши. Бүгінгі қолдауыңыз үшін рахмет.
Dialogue: 0,0:08:02.21,0:08:05.21,Default,,0,0,0,,А... иә?
Dialogue: 0,0:08:06.55,0:08:08.55,Default,,0,0,0,,Иә Жұмыс Жұмыс
Dialogue: 0,0:08:08.55,0:08:10.89,Default,,0,0,0,,Қара, Ән, жасайық, істейік.
Dialogue: 0,0:08:10.89,0:08:14.22,Default,,0,0,0,,Олай болса, Аюми мен Анзу, гондоланы дайындаңдар.
Dialogue: 0,0:08:14.22,0:08:16.22,Default,,0,0,0,,Жарайды (An) Иә
Dialogue: 0,0:08:21.23,0:08:25.90,Default,,0,0,0,,Жақында ашамыз. Сол жаққа сап түзеңіз.
Dialogue: 0,0:08:25.90,0:08:28.90,Default,,0,0,0,,Эй, мен Undine-ді бірінші рет көріп тұрмын.
Dialogue: 0,0:08:28.90,0:08:32.57,Default,,0,0,0,,Танысқаныма қуаныштымын. Сізге көп рахмет.
Dialogue: 0,0:08:32.57,0:08:34.91,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:08:34.91,0:08:36.91,Default,,0,0,0,,Қайырлы таң (Еркек) Қайырлы таң
Dialogue: 0,0:08:36.91,0:08:38.91,Default,,0,0,0,,Басатын жерде абай болыңыз.
Dialogue: 0,0:08:38.91,0:08:41.58,Default,,0,0,0,,Уау~ Мына қызанақтар дәмді көрінеді!
Dialogue: 0,0:08:41.58,0:08:45.25,Default,,0,0,0,,Мен тым көп сатып алдым. Түскі асқа трипе жеймін деп ойлаймын.
Dialogue: 0,0:08:45.25,0:08:48.59,Default,,0,0,0,,Аа, жақсы (ер) Йо Аюми-чан
Dialogue: 0,0:08:48.59,0:08:50.86,Default,,0,0,0,,Қайырлы таң ата
Dialogue: 0,0:08:50.86,0:08:54.20,Default,,0,0,0,,Қайырлы таң, Анзу-чан
Dialogue: 0,0:08:54.20,0:08:57.53,Default,,0,0,0,,Ах... Қайырлы таң.
Dialogue: 0,0:08:57.53,0:09:00.87,Default,,0,0,0,,Әй, не болды? Менде энергия жоқ сияқты
Dialogue: 0,0:09:00.87,0:09:04.21,Default,,0,0,0,,Иә? Олай емес.
Dialogue: 0,0:09:04.21,0:09:07.88,Default,,0,0,0,,Аюми Ан Жарайды, шығу уақыты келді!
Dialogue: 0,0:09:07.88,0:09:11.88,Default,,0,0,0,,Иә, гондола келе жатыр!
Dialogue: 0,0:09:17.55,0:09:21.89,Default,,0,0,0,,Ан, мен қазір өзімді жақсы сезінбеймін.
Dialogue: 0,0:09:21.89,0:09:26.56,Default,,0,0,0,,Мен жақында ғана Prima-ға көтерілу емтиханынан өте алмадым.
Dialogue: 0,0:09:26.56,0:09:29.90,Default,,0,0,0,,Иә? Бұл Примаға көтерілу емтиханы ма?
Dialogue: 0,0:09:29.90,0:09:32.23,Default,,0,0,0,,Иә
Dialogue: 0,0:09:32.23,0:09:37.91,Default,,0,0,0,,Ал, мен оны тапсыру оңай болмайтынын жақсы түсінемін.
Dialogue: 0,0:09:37.91,0:09:40.58,Default,,0,0,0,,Бірақ бұл бала керемет.
Dialogue: 0,0:09:40.58,0:09:43.24,Default,,0,0,0,,Дәл солай мен қайта-қайта күйзелемін.
Dialogue: 0,0:09:43.24,0:09:46.95,Default,,0,0,0,,Мен қайта-қайта тырысамын.
Dialogue: 0,0:09:48.25,0:09:52.92,Default,,0,0,0,,Бұл Prima жоғарылау емтиханы шынымен қиын ба?
Dialogue: 0,0:09:52.92,0:09:56.93,Default,,0,0,0,,Иә, сол компанияның аға қызметкері емтихан алушы болады.
Dialogue: 0,0:09:56.93,0:09:59.93,Default,,0,0,0,,Бойдақ кездегідей емес, жеке айырмашылықтар болса да
Dialogue: 0,0:09:59.93,0:10:02.60,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:10:02.60,0:10:05.93,Default,,0,0,0,,Анзу екеумізді басқаратын аға
Dialogue: 0,0:10:05.93,0:10:08.94,Default,,0,0,0,,Өйткені ол өте қатал адам.
Dialogue: 0,0:10:08.94,0:10:10.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:15.61,0:10:17.95,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:17.95,0:10:20.55,Default,,0,0,0,,Өтінемін (әйел) Рахмет.
Dialogue: 0,0:10:21.62,0:10:24.02,Default,,0,0,0,,Гондола келе жатыр!
Dialogue: 0,0:10:24.95,0:10:27.29,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:10:27.29,0:10:30.29,Default,,0,0,0,,Ол өзін жақсы сезінбейді.
Dialogue: 0,0:10:31.63,0:10:35.30,Default,,0,0,0,,Прима болу қиын сияқты.
Dialogue: 0,0:10:35.30,0:10:38.30,Default,,0,0,0,,Аюми-сан, бұл бір ғана нәрсе емес.
Dialogue: 0,0:10:38.30,0:10:40.97,Default,,0,0,0,,Бұл бір нәрсе~ Иә?
Dialogue: 0,0:10:40.97,0:10:44.97,Default,,0,0,0,,Өйткені мен прима болмаймын, иә!?
Dialogue: 0,0:10:44.97,0:10:47.31,Default,,0,0,0,,Жарайды, біз сияқты.
Dialogue: 0,0:10:47.31,0:10:50.25,Default,,0,0,0,,Кім трагеттерге маманданған ундина болғысы келеді?
Dialogue: 0,0:10:50.25,0:10:52.25,Default,,0,0,0,,Онша көп емес.
Dialogue: 0,0:10:52.25,0:10:54.92,Default,,0,0,0,,Бірдеңе болса, мен прима бола алмаймын.
Dialogue: 0,0:10:54.92,0:10:58.22,Default,,0,0,0,,Мұнда қоныстанған бойдақтар көбірек.
Dialogue: 0,0:11:02.26,0:11:04.93,Default,,0,0,0,,Трагеттоның Прима болуды мақсат еткені рас.
Dialogue: 0,0:11:04.93,0:11:07.93,Default,,0,0,0,,Ол жалғыз жаттығу алаңдарында қолжетімді.
Dialogue: 0,0:11:07.93,0:11:12.60,Default,,0,0,0,,Сонымен қатар, бұл да жақсы ақша табуға болатын жер.
Dialogue: 0,0:11:12.60,0:11:16.27,Default,,0,0,0,,Туристік ақпарат та тамаша жұмыс.
Dialogue: 0,0:11:16.27,0:11:20.61,Default,,0,0,0,,Біз бұл қалаға және осында тұратын адамдардың өміріне араласа аламыз.
Dialogue: 0,0:11:20.61,0:11:23.61,Default,,0,0,0,,Маған бұл жұмыс ұнайды
Dialogue: 0,0:11:28.28,0:11:30.99,Default,,0,0,0,,Гондола келе жатыр!
Dialogue: 0,0:11:34.62,0:11:36.96,Default,,0,0,0,,Ах... (Ан) А...
Dialogue: 0,0:11:36.96,0:11:41.96,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:11:45.97,0:11:48.64,Default,,0,0,0,,Кешіріңіз, иә?
Dialogue: 0,0:11:48.64,0:11:51.57,Default,,0,0,0,,Атмосфера қараңғы, солай емес пе?
Dialogue: 0,0:11:51.57,0:11:54.24,Default,,0,0,0,,Иә, жоқ, солай...
Dialogue: 0,0:11:54.24,0:11:59.91,Default,,0,0,0,,Мен жақында Prima жоғарылау емтиханынан өте алмадым.
Dialogue: 0,0:11:59.91,0:12:04.59,Default,,0,0,0,,Бұл Prima жоғарылау емтиханы
Dialogue: 0,0:12:04.59,0:12:09.26,Default,,0,0,0,,Ал... бұл қиын.
Dialogue: 0,0:12:09.26,0:12:12.26,Default,,0,0,0,,Бірақ мен бас тартқан жоқпын.
Dialogue: 0,0:12:12.26,0:12:15.60,Default,,0,0,0,,Қазіргі уақытта көңілім түсіп, тоқырауға ұшырағаным рас.
Dialogue: 0,0:12:15.60,0:12:19.27,Default,,0,0,0,,Көп тамақтаныңыз, көп ұйықтаңыз, қайта сауығып кетіңіз.
Dialogue: 0,0:12:19.27,0:12:21.94,Default,,0,0,0,,Көп, көп жаттығу.
Dialogue: 0,0:12:21.94,0:12:25.24,Default,,0,0,0,,Мен қайта-қайта тырысамын.
Dialogue: 0,0:12:27.94,0:12:29.94,Default,,0,0,0,,Иә
Dialogue: 0,0:12:29.94,0:12:33.62,Default,,0,0,0,,Акари-сан да прима болуды мақсат етеді, солай ма?
Dialogue: 0,0:12:33.62,0:12:35.95,Default,,0,0,0,,Иә
Dialogue: 0,0:12:35.95,0:12:38.62,Default,,0,0,0,,Бірақ бұл мен үшін әлі жұмыс істемейді
Dialogue: 0,0:12:38.62,0:12:42.62,Default,,0,0,0,,Менің жоғарылау емтиханын тапсыруға мүмкіндігім жоқ.
Dialogue: 0,0:12:42.62,0:12:47.63,Default,,0,0,0,,Сол себепті Алисия да емтихан туралы айтқан жоқ деп ойлаймын.
Dialogue: 0,0:12:48.63,0:12:52.23,Default,,0,0,0,,Емтихан тапсыратын күнім келеді.
Dialogue: 0,0:12:52.23,0:12:55.57,Default,,0,0,0,,Құлап кетсе де.
Dialogue: 0,0:12:55.57,0:12:59.24,Default,,0,0,0,,Ан сияқты мен ешқашан берілмеймін.
Dialogue: 0,0:12:59.24,0:13:02.94,Default,,0,0,0,,Мен өзімді қайта-қайта сынағым келеді.
Dialogue: 0,0:13:07.25,0:13:13.25,Default,,0,0,0,,Әлисия өте мейірімді адам сияқты.
Dialogue: 0,0:13:13.25,0:13:15.92,Default,,0,0,0,,Хахи! Мен де тамсанамын
Dialogue: 0,0:13:17.96,0:13:20.29,Default,,0,0,0,,Жарайды, қазір барамыз ба?
Dialogue: 0,0:13:20.29,0:13:22.30,Default,,0,0,0,,...
Dialogue: 0,0:13:24.97,0:13:28.97,Default,,0,0,0,,Қош келдіңіз, қадамыңызға мұқият болыңыз.
Dialogue: 0,0:13:28.97,0:13:32.64,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:13:32.64,0:13:37.65,Default,,0,0,0,,Жарайды, мен де сенімен біргемін, сондықтан сенімді түрде есіңізде жүріңіз.
Dialogue: 0,0:13:39.31,0:13:42.58,Default,,0,0,0,,Иә, жарайды, кете аласыз.
Dialogue: 0,0:13:42.58,0:13:44.59,Default,,0,0,0,,Иә иә иә
Dialogue: 0,0:13:44.59,0:13:46.99,Default,,0,0,0,,Гондола шығып жатыр.
Dialogue: 0,0:14:00.94,0:14:02.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:02.94,0:14:06.24,Default,,0,0,0,,<Тори Мизунаши Мен келе жатырмын! ＞
Dialogue: 0,0:14:12.61,0:14:16.95,Default,,0,0,0,,♬～
Dialogue: 0,0:14:16.95,0:14:18.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:18.95,0:14:22.29,Default,,0,0,0,,Анау бала... олай етпе.
Dialogue: 0,0:14:22.29,0:14:42.24,Default,,0,0,0,,♬～
Dialogue: 0,0:14:42.24,0:15:02.26,Default,,0,0,0,,♬～
Dialogue: 0,0:15:02.26,0:15:13.27,Default,,0,0,0,,♬～
Dialogue: 0,0:15:13.27,0:15:16.28,Default,,0,0,0,,Әке! (Әке) О хахаха...
Dialogue: 0,0:15:16.28,0:15:36.30,Default,,0,0,0,,♬～
Dialogue: 0,0:15:36.30,0:15:41.57,Default,,0,0,0,,♬～
Dialogue: 0,0:15:41.57,0:15:44.24,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:15:44.24,0:15:46.91,Default,,0,0,0,,Бүгінгі сатылымдар
Dialogue: 0,0:15:46.91,0:15:49.91,Default,,0,0,0,,Сақ болыңыз және кеңсеңіз бар. (Ә) Иә.
Dialogue: 0,0:15:49.91,0:15:52.91,Default,,0,0,0,,Олай болса, гондоланы тазалауымыз керек.
Dialogue: 0,0:15:52.91,0:15:54.92,Default,,0,0,0,,Иә
Dialogue: 0,0:15:54.92,0:16:04.26,Default,,0,0,0,,♬～
Dialogue: 0,0:16:04.26,0:16:06.26,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:16:06.26,0:16:08.26,Default,,0,0,0,,Ах
Dialogue: 0,0:16:09.26,0:16:12.60,Default,,0,0,0,,Барлығы гондолаларды жақсы көреді.
Dialogue: 0,0:16:12.60,0:16:16.27,Default,,0,0,0,,Мен оны бағалайтыныма қуаныштымын.
Dialogue: 0,0:16:16.27,0:16:18.61,Default,,0,0,0,,Бұл Undine болғандықтан.
Dialogue: 0,0:16:18.61,0:16:21.28,Default,,0,0,0,,Гондолаларға қатысты барлығының сезімі бірдей.
Dialogue: 0,0:16:21.28,0:16:24.28,Default,,0,0,0,,Одан да біз бақыттымыз.
Dialogue: 0,0:16:24.28,0:16:26.28,Default,,0,0,0,,Хохе?
Dialogue: 0,0:16:26.28,0:16:30.28,Default,,0,0,0,,Бұл өте жақсы қатар болды, сізде керемет шеберлік бар.
Dialogue: 0,0:16:30.28,0:16:33.29,Default,,0,0,0,,Бүгін бірге ескек есу қызықты болды!
Dialogue: 0,0:16:33.29,0:16:37.96,Default,,0,0,0,,Жоқ, олай емес... Рас, жолбарысты бірінші рет алуым.
Dialogue: 0,0:16:37.96,0:16:40.23,Default,,0,0,0,,Сіз трюктерді аз уақытта үйренесіз.
Dialogue: 0,0:16:40.23,0:16:42.90,Default,,0,0,0,,Тұтынушылар көбейсе де, есу мен тепе-теңдік сақталады
Dialogue: 0,0:16:42.90,0:16:45.23,Default,,0,0,0,,Ол мүлде құламайды.
Dialogue: 0,0:16:45.23,0:16:47.90,Default,,0,0,0,,Сіздің арқаңызда біз үлкен көмекпіз.
Dialogue: 0,0:16:47.90,0:16:50.91,Default,,0,0,0,,Күткендей, оның негізін сол әже қойған.
Dialogue: 0,0:16:50.91,0:16:53.24,Default,,0,0,0,,Сіз ARIA компаниясының қызметкерісіз, солай ма?
Dialogue: 0,0:16:53.24,0:16:55.24,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:55.24,0:16:58.25,Default,,0,0,0,,ARIA компаниясы туралы айтатын болсақ, Алисия
Dialogue: 0,0:16:58.25,0:17:00.25,Default,,0,0,0,,Бұл танымал.
Dialogue: 0,0:17:00.25,0:17:03.92,Default,,0,0,0,,Бұл қалада оның гондоласын көрмеген күн жоқ.
Dialogue: 0,0:17:03.92,0:17:06.59,Default,,0,0,0,,Иә! Менде күнде брондау бар
Dialogue: 0,0:17:06.59,0:17:09.59,Default,,0,0,0,,Жұмысым көп болса да, уақытша болса да трагет ретінде жұмыс істеп жатырмын.
Dialogue: 0,0:17:09.59,0:17:12.93,Default,,0,0,0,,Маған көмектескеніңіз үшін өте ризамын.
Dialogue: 0,0:17:12.93,0:17:16.26,Default,,0,0,0,,А... Мен сенімен тағы жұмыс істегім келеді.
Dialogue: 0,0:17:16.26,0:17:19.60,Default,,0,0,0,,Мүмкін келесі жолы кездессек, сіз прима боласыз.
Dialogue: 0,0:17:19.60,0:17:23.27,Default,,0,0,0,,Сіздің прима атануыңыз уақыт мәселесі.
Dialogue: 0,0:17:23.27,0:17:25.61,Default,,0,0,0,,Біз оған кепілдік береміз хахаха
Dialogue: 0,0:17:25.61,0:17:29.28,Default,,0,0,0,,Бұл жақсы, Прима...
Dialogue: 0,0:17:29.28,0:17:32.28,Default,,0,0,0,,Құттықтаймыз Акари-чан
Dialogue: 0,0:17:32.28,0:17:34.62,Default,,0,0,0,,Жоқ, ол әлі жартысы толы.
Dialogue: 0,0:17:34.62,0:17:37.29,Default,,0,0,0,,Хава хауа... (Ан) Бұл керемет. Ол кепілдікпен келеді.
Dialogue: 0,0:17:37.29,0:17:40.22,Default,,0,0,0,,Тоқта, Ан! Сәлем Анзу
Dialogue: 0,0:17:40.22,0:17:43.22,Default,,0,0,0,,Анзу қазірдің өзінде жеткілікті түрде жұмыс істеп жатыр.
Dialogue: 0,0:17:43.22,0:17:46.23,Default,,0,0,0,,Бұл туралы уайымдама (Ан) Атлас-чан...
Dialogue: 0,0:17:46.23,0:17:49.56,Default,,0,0,0,,Бұл екеуміздің де кінәміз емес.
Dialogue: 0,0:17:49.56,0:17:52.57,Default,,0,0,0,,Емтихан қабылдаушы тым қатал.
Dialogue: 0,0:17:56.90,0:18:00.24,Default,,0,0,0,,А... анау аға...
Dialogue: 0,0:18:00.24,0:18:04.58,Default,,0,0,0,,Ан екеуміз қанша тырыссақ та, олар ешқашан ештеңені мойындамайды.
Dialogue: 0,0:18:04.58,0:18:07.25,Default,,0,0,0,,Сіз әрқашан толықтай бас тартасыз.
Dialogue: 0,0:18:07.25,0:18:09.58,Default,,0,0,0,,Емтихан тапсырушы басқа аға адам болса ше?
Dialogue: 0,0:18:09.58,0:18:11.92,Default,,0,0,0,,Тіпті біз...
Dialogue: 0,0:18:11.92,0:18:14.92,Default,,0,0,0,,Бірақ соңғы кездері бұл туралы ойланып жүрмін.
Dialogue: 0,0:18:14.92,0:18:17.59,Default,,0,0,0,,Жалғыз адам ретінде трагет бойынша мамандануды жалғастыра аласыз.
Dialogue: 0,0:18:17.59,0:18:19.99,Default,,0,0,0,,Менің ойымша, бұл жаман емес.
Dialogue: 0,0:18:20.93,0:18:25.27,Default,,0,0,0,,Мен де Аюми сияқты бұл жұмысты жақсы көремін.
Dialogue: 0,0:18:25.27,0:18:28.60,Default,,0,0,0,,Жоқ, біз және Атлас әр түрлі.
Dialogue: 0,0:18:28.60,0:18:30.61,Default,,0,0,0,,Не? Өйткені Атлас
Dialogue: 0,0:18:30.61,0:18:34.28,Default,,0,0,0,,Сіз шынымен прима болғыңыз келеді және туристерге жол көрсеткіңіз келеді, солай ма?
Dialogue: 0,0:18:34.28,0:18:37.28,Default,,0,0,0,,Бірақ мен алты ай бұрын емтиханды тапсыра алмай қалдым.
Dialogue: 0,0:18:37.28,0:18:39.61,Default,,0,0,0,,Мен оны қабылдауды мүлдем тоқтаттым.
Dialogue: 0,0:18:39.61,0:18:44.32,Default,,0,0,0,,Неге Анға қайта-қайта лайк басып көрмейсің?
Dialogue: 0,0:18:57.90,0:19:02.90,Default,,0,0,0,,Мен Атра-чанның сезімін түсіндім, сәл ғана.
Dialogue: 0,0:19:02.90,0:19:07.24,Default,,0,0,0,,Мен прима емтиханын тапсыра алмаған сайын, өзімді жеңіліске ұшырағандай сезінемін.
Dialogue: 0,0:19:07.24,0:19:10.91,Default,,0,0,0,,Мені одан сайын жоққа шығарып жатқандай сезінемін.
Dialogue: 0,0:19:10.91,0:19:14.25,Default,,0,0,0,,Қиын, азап, мұң
Dialogue: 0,0:19:14.25,0:19:17.25,Default,,0,0,0,,Мен одан сайын қорқамын
Dialogue: 0,0:19:17.25,0:19:22.96,Default,,0,0,0,,Сіз білмей тұрып, ол барған сайын атрофияланып, қатайып барады.
Dialogue: 0,0:19:23.92,0:19:26.59,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:26.59,0:19:28.60,Default,,0,0,0,,Бірақ бұл жақсы емес
Dialogue: 0,0:19:28.60,0:19:33.60,Default,,0,0,0,,Егер сіз қатты қатып қалсаңыз, ағымдағы пішінді өзгерте алмайсыз.
Dialogue: 0,0:19:33.60,0:19:37.27,Default,,0,0,0,,Сіз ештеңені сіңіре алмайсыз.
Dialogue: 0,0:19:37.27,0:19:43.61,Default,,0,0,0,,Басқаларды өзгерте алмасаңыз да, өзіңізді өзгерте аласыз.
Dialogue: 0,0:19:43.61,0:19:49.62,Default,,0,0,0,,Егер мен жетілмегендіктен дәл қазір жеткіліксіз болсам, жай ғана көбірек қосыңыз.
Dialogue: 0,0:19:49.62,0:19:53.95,Default,,0,0,0,,Сондықтан мен шынымен жұмсақ болғым келеді.
Dialogue: 0,0:19:53.95,0:19:58.29,Default,,0,0,0,,Жұмсақ болса, кез келген пішінді қабылдай алады.
Dialogue: 0,0:19:58.29,0:20:03.00,Default,,0,0,0,,Кез келген нәрсені сіңіруге болады.
Dialogue: 0,0:20:03.96,0:20:05.97,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:20:07.64,0:20:11.64,Default,,0,0,0,,Егер мен мұны істесем, мен кез келген нәрсеге айнала алатыныма сенімдімін.
Dialogue: 0,0:20:11.64,0:20:17.34,Default,,0,0,0,,Иә, мен сіз болғыңыз келетін прима бола алатыныңызға сенімдімін.
Dialogue: 0,0:20:19.65,0:20:21.98,Default,,0,0,0,,Бірақ маған кеш екенін айтты...
Dialogue: 0,0:20:21.98,0:20:24.32,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:24.32,0:20:26.65,Default,,0,0,0,,Жақсы болатынына сенімдімін.
Dialogue: 0,0:20:26.65,0:20:29.99,Default,,0,0,0,,Кез келген уақытта, кез келген жерде, кез келген рет
Dialogue: 0,0:20:29.99,0:20:32.33,Default,,0,0,0,,Қиындықпен айналысқыңыз келген кезде
Dialogue: 0,0:20:32.33,0:20:35.00,Default,,0,0,0,,Бос бастау
Dialogue: 0,0:20:35.00,0:20:37.67,Default,,0,0,0,,Өзіңізді аяқтамайынша
Dialogue: 0,0:20:37.67,0:20:40.94,Default,,0,0,0,,Бұл ешқашан кеш емес.
Dialogue: 0,0:20:40.94,0:20:57.62,Default,,0,0,0,,♬～
Dialogue: 0,0:20:57.62,0:20:59.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:59.62,0:21:03.62,Default,,0,0,0,,Ей, мынау жастық шақ!
Dialogue: 0,0:21:04.63,0:21:06.96,Default,,0,0,0,,Иә
Dialogue: 0,0:21:06.96,0:21:10.63,Default,,0,0,0,,Мен тағы да бар күшімді саламын.
Dialogue: 0,0:21:10.63,0:21:13.63,Default,,0,0,0,,Иә, мен де бар күшімді саламын.
Dialogue: 0,0:21:13.63,0:21:16.64,Default,,0,0,0,,Мен де солай істеймін.
Dialogue: 0,0:21:16.64,0:21:20.31,Default,,0,0,0,,Оны да жасайық! Күшік…
Dialogue: 0,0:21:20.31,0:21:24.61,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,0:21:30.32,0:21:32.32,Default,,0,0,0,,Сіз ештеңені ұмытқан жоқсыз, солай ма?
Dialogue: 0,0:21:32.32,0:21:34.66,Default,,0,0,0,,Хахи (Ан) Жарайды.
Dialogue: 0,0:21:34.66,0:21:37.66,Default,,0,0,0,,Олай болса, үйге қайтайық.
Dialogue: 0,0:21:39.93,0:21:44.27,Default,,0,0,0,,<Трагетті жұмыс деп мақтанатын адамдар>
Dialogue: 0,0:21:44.27,0:21:46.60,Default,,0,0,0,,<Оқытудан өтіп жатқан адам>
Dialogue: 0,0:21:46.60,0:21:49.60,Default,,0,0,0,,<Әр адам өз жолын өзі таңдайды➡
Dialogue: 0,0:21:49.60,0:21:52.27,Default,,0,0,0,,Алға ұмтылғандар➡
Dialogue: 0,0:21:52.27,0:21:55.94,Default,,0,0,0,,Бір жерде жарқырап тұрғандай болды＞
Dialogue: 0,0:21:55.94,0:22:00.61,Default,,0,0,0,,<Прима болу жолы өте қиын болуы мүмкін>
Dialogue: 0,0:22:00.61,0:22:05.29,Default,,0,0,0,,<Бірақ мен де алға ұмтыламын.>
Dialogue: 0,0:22:05.29,0:22:09.99,Default,,0,0,0,,＜Қанша алыс болса да, алға жүр＞
Dialogue: 0,0:22:13.96,0:22:17.63,Default,,0,0,0,,Қазір! (Президент Ария) Пунюньюй
Dialogue: 0,0:22:17.63,0:22:21.30,Default,,0,0,0,,Президент Ария Мен үйдемін (Президент Ария) Пуйпуи
Dialogue: 0,0:22:21.30,0:22:24.64,Default,,0,0,0,,О, Акари-чан, қош келдің.
Dialogue: 0,0:22:24.64,0:22:27.98,Default,,0,0,0,,Еңбегіңізге рахмет, Алисия, мен қайтып келдім.
Dialogue: 0,0:22:27.98,0:22:31.98,Default,,0,0,0,,Қалай болды? Ха, қызық болды!
Dialogue: 0,0:22:31.98,0:22:36.65,Default,,0,0,0,,<Мен бір кездері Акари-санның Торагетін мінгім келеді.>
Dialogue: 0,0:22:36.65,0:22:40.59,Default,,0,0,0,,<Ах, бірақ Прима болғаннан кейін Акаридің гондоласына міну➡
Dialogue: 0,0:22:40.59,0:22:43.99,Default,,0,0,0,,асыға күтемін, хехехе>
Dialogue: 0,0:22:44.93,0:23:04.95,Default,,0,0,0,,♬～
Dialogue: 0,0:23:04.95,0:23:20.96,Default,,0,0,0,,♬～
Dialogue: 0,0:23:20.96,0:23:35.64,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.64,0:23:55.60,Default,,0,0,0,,♬～
Dialogue: 0,0:23:55.60,0:24:13.95,Default,,0,0,0,,♬～
Dialogue: 0,0:24:16.65,0:24:19.99,Default,,0,0,0,,<Айка-чан, сен төрт жапырақты беде тауып алдың➡
Dialogue: 0,0:24:19.99,0:24:23.32,Default,,0,0,0,,Осының өзі керемет ғажайып> <Ұят сөздерге тыйым салынады! ＞
Dialogue: 0,0:24:23.32,0:24:25.33,Default,,0,0,0,,<Келесі жолы...>
Dialogue: 0,0:24:26.99,0:24:29.00,Default,,0,0,0,,<Қолыңызды беріңізші>
Dialogue: 0,0:24:30.50,0:24:36.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory