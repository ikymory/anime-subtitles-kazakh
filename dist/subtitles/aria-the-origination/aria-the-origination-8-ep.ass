Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.63,0:00:03.97,Default,,0,0,0,,<Естеліктер маңызды ма? ＞
Dialogue: 0,0:00:03.97,0:00:06.97,Default,,0,0,0,,<Иә, мен әрқайсысын қазына сандығында сақтағым келеді.>
Dialogue: 0,0:00:06.97,0:00:09.64,Default,,0,0,0,,<Басынан бері ұят әңгіме болмайды! > <Е...>
Dialogue: 0,0:00:09.64,0:00:12.31,Default,,0,0,0,,<Бірақ мен жағымсыз нәрселерді ұмытқым келеді.>
Dialogue: 0,0:00:12.31,0:00:14.98,Default,,0,0,0,,<Алиса-чан? > <Афина-сенпайдың...>
Dialogue: 0,0:00:14.98,0:00:16.98,Default,,0,0,0,,<? > <Қазына сандықтың кілті➡
Dialogue: 0,0:00:16.98,0:00:18.98,Default,,0,0,0,,Мен оны енді аша алмаймын＞
Dialogue: 0,0:00:32.33,0:00:35.66,Default,,0,0,0,,<Ай-чан, Нео Венеция бұл күндері➡
Dialogue: 0,0:00:35.66,0:00:39.07,Default,,0,0,0,,Бізде өте жақсы күндер қатары бар>
Dialogue: 0,0:00:40.00,0:00:43.01,Default,,0,0,0,,＜Мен ашық көк аспанға қарағанымда➡
Dialogue: 0,0:00:43.01,0:00:47.34,Default,,0,0,0,,Кейде өзімді теңіз түбіндегі балықтай сезінемін➡
Dialogue: 0,0:00:47.34,0:00:51.65,Default,,0,0,0,,Сіз өзіңізді мұхитқа қарап тұрғандай сезінесіз бе? ＞
Dialogue: 0,0:00:54.28,0:00:59.29,Default,,0,0,0,,♬～
Dialogue: 0,0:00:59.29,0:01:02.29,Default,,0,0,0,,Иә! Ах, Афина...
Dialogue: 0,0:01:02.29,0:01:04.59,Default,,0,0,0,,Пикник?
Dialogue: 0,0:01:05.63,0:01:08.96,Default,,0,0,0,,Иә, мен ертең барамын. Ертең?
Dialogue: 0,0:01:08.96,0:01:11.97,Default,,0,0,0,,Мүмкін сізді Афина шақырған шығар?
Dialogue: 0,0:01:11.97,0:01:14.30,Default,,0,0,0,,Егер бұлай болса...
Dialogue: 0,0:01:14.30,0:01:17.31,Default,,0,0,0,,Мен Афина-сенпайды шақырдым.
Dialogue: 0,0:01:17.31,0:01:20.98,Default,,0,0,0,,Иә? Алисадан? Солай ма?
Dialogue: 0,0:01:20.98,0:01:23.65,Default,,0,0,0,,Бірінші Афина Сенпайдан.
Dialogue: 0,0:01:23.65,0:01:26.32,Default,,0,0,0,,Күн жылынса, пикникке шығайық.
Dialogue: 0,0:01:26.32,0:01:29.32,Default,,0,0,0,,Маған айтты... сонда?
Dialogue: 0,0:01:29.32,0:01:33.66,Default,,0,0,0,,Бірақ көктемде де Афина-сенпай бос емес сияқты.
Dialogue: 0,0:01:33.66,0:01:36.33,Default,,0,0,0,,Бұлай айту қиын.
Dialogue: 0,0:01:36.33,0:01:38.66,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:01:38.66,0:01:41.33,Default,,0,0,0,,Сондықтан менің кіші балам мені шақырды.
Dialogue: 0,0:01:41.33,0:01:43.33,Default,,0,0,0,,Сонымен Афина ше?
Dialogue: 0,0:01:43.33,0:01:45.67,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:01:45.67,0:01:50.61,Default,,0,0,0,,Ертең Афина-сенпайдың біраз уақыттан кейінгі алғашқы мерекесі.
Dialogue: 0,0:01:50.61,0:01:53.28,Default,,0,0,0,,Олай болса бір рет жасаған жақсы.
Dialogue: 0,0:01:53.28,0:01:56.28,Default,,0,0,0,,Пуи... Ню
Dialogue: 0,0:01:56.28,0:01:59.95,Default,,0,0,0,,Пикник көңілді өтеді деп үміттенемін, Алиса.
Dialogue: 0,0:01:59.95,0:02:01.95,Default,,0,0,0,,Иә
Dialogue: 0,0:02:01.95,0:02:21.97,Default,,0,0,0,,♬～
Dialogue: 0,0:02:21.97,0:02:41.99,Default,,0,0,0,,♬～
Dialogue: 0,0:02:41.99,0:03:01.94,Default,,0,0,0,,♬～
Dialogue: 0,0:03:01.94,0:03:21.96,Default,,0,0,0,,♬～
Dialogue: 0,0:03:21.96,0:03:41.98,Default,,0,0,0,,♬～
Dialogue: 0,0:03:41.98,0:03:47.29,Default,,0,0,0,,♬～
Dialogue: 0,0:03:51.93,0:03:55.93,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:03:55.93,0:03:58.23,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:04:01.94,0:04:04.61,Default,,0,0,0,,Мен ертең таңертең кетемін.
Dialogue: 0,0:04:04.61,0:04:08.94,Default,,0,0,0,,Алдымен Үлкен каналды көздеп алайық (Ал, Президент) Жарайды.
Dialogue: 0,0:04:08.94,0:04:11.95,Default,,0,0,0,,Үлкен каналдың осы нүктесінен артқа қарасақ
Dialogue: 0,0:04:11.95,0:04:15.62,Default,,0,0,0,,Таңертеңгілік күн Нео-Венецияға енді ғана жарқырап тұрды.
Dialogue: 0,0:04:15.62,0:04:17.62,Default,,0,0,0,,Бұл өте әдемі көрінеді.
Dialogue: 0,0:04:17.62,0:04:19.62,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:04:20.62,0:04:25.29,Default,,0,0,0,,Одан кейін Мурано аралына барып, бірге түскі ас ішейік.
Dialogue: 0,0:04:25.29,0:04:27.30,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:29.30,0:04:33.30,Default,,0,0,0,,Кеш болды, Афина-сенпай.
Dialogue: 0,0:04:33.30,0:04:37.64,Default,,0,0,0,,Дұрыс, ертеңгі күннің кестесін жасауым керек.
Dialogue: 0,0:04:37.64,0:04:40.64,Default,,0,0,0,,Афина-сенпай бірден түсінсін.
Dialogue: 0,0:04:40.64,0:04:42.98,Default,,0,0,0,,Мама ма... маа
Dialogue: 0,0:04:42.98,0:04:46.65,Default,,0,0,0,,Иә, иә, банандар түскі асқа арналған десерт пен жеңіл тағамдарға арналған.
Dialogue: 0,0:04:46.65,0:04:49.05,Default,,0,0,0,,Екі бөтелке әкелейік.
Dialogue: 0,0:04:50.59,0:04:53.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:54.59,0:04:58.29,Default,,0,0,0,,Күн батқанда салқын болады.
Dialogue: 0,0:05:02.93,0:05:07.94,Default,,0,0,0,,Жарайды, Президент, сәл ерте, бірақ жуынып, жылынайық.
Dialogue: 0,0:05:07.94,0:05:11.27,Default,,0,0,0,,Ал, бұған дейін!
Dialogue: 0,0:05:11.27,0:05:16.61,Default,,0,0,0,,♬～
Dialogue: 0,0:05:16.61,0:05:20.95,Default,,0,0,0,,«Афина... Сенпайға»
Dialogue: 0,0:05:20.95,0:05:22.95,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:23.95,0:05:27.96,Default,,0,0,0,,Ал, кеттік. Ал, Президент.
Dialogue: 0,0:05:27.96,0:05:30.63,Default,,0,0,0,,Иә, кейінірек асханаға барайық.
Dialogue: 0,0:05:30.63,0:05:35.03,Default,,0,0,0,,Мен ертеңгі түскі асқа сэндвичке тапсырыс беруім керек.
Dialogue: 0,0:05:36.30,0:05:39.97,Default,,0,0,0,,Сонымен бірге шай әкелейік.
Dialogue: 0,0:05:39.97,0:05:42.97,Default,,0,0,0,,Шай атауы туралы сұрақ-жауап туралы не айтасыз?
Dialogue: 0,0:05:42.97,0:05:44.97,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:44.97,0:05:49.64,Default,,0,0,0,,Мейрамханадағы әйелден сирек кездесетін шайлар туралы үйретуін өтінемін бе?
Dialogue: 0,0:05:49.64,0:05:52.25,Default,,0,0,0,,Жақсы! Хехе
Dialogue: 0,0:05:52.25,0:06:05.59,Default,,0,0,0,,♬～
Dialogue: 0,0:06:05.59,0:06:07.60,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:07.60,0:06:09.60,Default,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,0:06:09.60,0:06:12.60,Default,,0,0,0,,Сен менімен көп банан бөлістің.
Dialogue: 0,0:06:12.60,0:06:14.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:15.94,0:06:19.94,Default,,0,0,0,,А, Афина-сенпай, қайтып келген сияқтысың.
Dialogue: 0,0:06:21.28,0:06:24.61,Default,,0,0,0,,Афина-сенпай, дұрыстап жаппасаң...
Dialogue: 0,0:06:24.61,0:06:29.62,Default,,0,0,0,,(Афинаның ұйықтауы)
Dialogue: 0,0:06:29.62,0:06:34.62,Default,,0,0,0,,Мен ұйықтап қалдым... Жуынатын бөлмеде бір-бірімізден өткен сияқтымыз.
Dialogue: 0,0:06:35.62,0:06:38.63,Default,,0,0,0,,Афина Сенпай Афина Сенпай
Dialogue: 0,0:06:38.63,0:06:40.63,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:06:40.63,0:06:44.97,Default,,0,0,0,,Фу~ Сіз шаршаған сияқтысыз.
Dialogue: 0,0:06:44.97,0:07:02.58,Default,,0,0,0,,♬～
Dialogue: 0,0:07:02.58,0:07:06.25,Default,,0,0,0,,(Президенттің ұйқысы)
Dialogue: 0,0:07:06.25,0:07:08.26,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:08.26,0:07:10.56,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:07:15.60,0:07:17.60,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:07:17.60,0:07:33.28,Default,,0,0,0,,♬～
Dialogue: 0,0:07:33.28,0:07:36.62,Default,,0,0,0,,<Менің шұғыл жұмысым бар...>
Dialogue: 0,0:07:36.62,0:07:45.96,Default,,0,0,0,,♬～
Dialogue: 0,0:07:45.96,0:07:47.96,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:07:48.96,0:07:50.97,Default,,0,0,0,,Хмм, жақсы.
Dialogue: 0,0:07:55.24,0:07:57.24,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:07:57.24,0:08:03.58,Default,,0,0,0,,♪ (мырылдау)
Dialogue: 0,0:08:03.58,0:08:07.58,Default,,0,0,0,,Ал, президент мырза, біз Мурано аралына келген соң түскі ас ішеміз.
Dialogue: 0,0:08:09.25,0:08:15.59,Default,,0,0,0,,♪ (мырылдау)
Dialogue: 0,0:08:15.59,0:08:18.59,Default,,0,0,0,,Иә! Бұл Мурано аралы
Dialogue: 0,0:08:18.59,0:08:20.60,Default,,0,0,0,,Түскі ас – бутерброд.
Dialogue: 0,0:08:20.60,0:08:23.93,Default,,0,0,0,,Ал, тойдың ба?
Dialogue: 0,0:08:23.93,0:08:27.94,Default,,0,0,0,,Мен қиындыққа тап болдым. Екі адамға түскі ас жеткілікті.
Dialogue: 0,0:08:27.94,0:08:31.61,Default,,0,0,0,,Алиса! Ха ха...
Dialogue: 0,0:08:31.61,0:08:35.31,Default,,0,0,0,,Себебі бұл жұмыс аяқталды...
Dialogue: 0,0:08:36.28,0:08:38.95,Default,,0,0,0,,Қайтадан қош келдіңіз.
Dialogue: 0,0:08:38.95,0:08:41.95,Default,,0,0,0,,О, бүгін кенеттен болды...
Dialogue: 0,0:08:41.95,0:08:43.95,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:08:43.95,0:08:48.29,Default,,0,0,0,,Мм, мен... бұл жеткілікті.
Dialogue: 0,0:08:48.29,0:08:51.89,Default,,0,0,0,,Ум, Алиса-чан, қазір барғың келе ме?
Dialogue: 0,0:08:51.89,0:08:54.90,Default,,0,0,0,,Артық кетпесе жақсы дейсің.
Dialogue: 0,0:08:54.90,0:08:57.20,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:01.90,0:09:05.91,Default,,0,0,0,,Мм... Кешіріңіз.
Dialogue: 0,0:09:05.91,0:09:08.21,Default,,0,0,0,,Неліктен кешірім сұрайсыз?
Dialogue: 0,0:09:11.91,0:09:15.25,Default,,0,0,0,,Ах... Алиса-чан
Dialogue: 0,0:09:15.25,0:09:18.92,Default,,0,0,0,,<Неге мен мұны тағы да айтамын...>
Dialogue: 0,0:09:18.92,0:09:22.52,Default,,0,0,0,,<Афина-сенпай, жаман емес>
Dialogue: 0,0:09:26.59,0:09:28.60,Default,,0,0,0,,Уф
Dialogue: 0,0:09:35.94,0:09:39.54,Default,,0,0,0,,Мм... иә?
Dialogue: 0,0:09:44.28,0:09:46.28,Default,,0,0,0,,Пуйпуи...! Ававава...
Dialogue: 0,0:09:46.28,0:09:48.95,Default,,0,0,0,,Президент Арияның сүйікті кружкасы...
Dialogue: 0,0:09:48.95,0:09:51.62,Default,,0,0,0,,О, менің ☎ (рингтон)
Dialogue: 0,0:09:51.62,0:09:53.62,Default,,0,0,0,,Қатты! Бұл телефон қоңырауы
Dialogue: 0,0:09:53.62,0:09:56.96,Default,,0,0,0,,Акари-чан, мен мұнда жинап берейін, өтінемін.
Dialogue: 0,0:09:56.96,0:09:59.29,Default,,0,0,0,,Иә (Президент Ария) Пуйпуи
Dialogue: 0,0:09:59.29,0:10:01.30,Default,,0,0,0,,Төтенше тоқтау! Жүгір!
Dialogue: 0,0:10:02.63,0:10:04.63,Default,,0,0,0,,Иә, ARIA компаниясы
Dialogue: 0,0:10:04.63,0:10:06.97,Default,,0,0,0,,☎ Де де де де де де… де?
Dialogue: 0,0:10:06.97,0:10:10.27,Default,,0,0,0,,☎ Бұл үлкен SOS! Акари Сенпай
Dialogue: 0,0:10:14.31,0:10:16.64,Default,,0,0,0,,Не болды? Алиса Чан
Dialogue: 0,0:10:16.64,0:10:21.65,Default,,0,0,0,,Біз уайымдадық... себебі телефонда түсініксіз болды.
Dialogue: 0,0:10:21.65,0:10:25.99,Default,,0,0,0,,Қош келдіңіз. Сіз менің досымсыз ба?
Dialogue: 0,0:10:25.99,0:10:28.66,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:28.66,0:10:31.33,Default,,0,0,0,,Сіз де.
Dialogue: 0,0:10:31.33,0:10:34.33,Default,,0,0,0,,Афина-сан, сен біртүрлі жылдамсың.
Dialogue: 0,0:10:34.33,0:10:37.67,Default,,0,0,0,,Енді ойлап қарасам... Ал біз туралы.
Dialogue: 0,0:10:37.67,0:10:41.67,Default,,0,0,0,,Бұл «дос» Пуи Пуи
Dialogue: 0,0:10:41.67,0:10:44.34,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:10:44.34,0:10:48.34,Default,,0,0,0,,Менің есте сақтау қабілетім жоғалып кетті.
Dialogue: 0,0:10:48.34,0:10:50.35,Default,,0,0,0,,《(Бас соққан дыбыс)》
Dialogue: 0,0:10:54.95,0:10:58.25,Default,,0,0,0,,《Жоқ... жақсысың ба? 》
Dialogue: 0,0:10:59.62,0:11:01.62,Default,,0,0,0,,《Афина Сенпай...》
Dialogue: 0,0:11:01.62,0:11:05.29,Default,,0,0,0,,《Афина-сенпай, өтінемін күшті бол》
Dialogue: 0,0:11:05.29,0:11:08.96,Default,,0,0,0,,《Афина Сенпай Афина Сенпай Афина Сенпай Афина Сенпай➡
Dialogue: 0,0:11:08.96,0:11:11.97,Default,,0,0,0,,Афина Сенпа…》《Мм…》
Dialogue: 0,0:11:11.97,0:11:16.30,Default,,0,0,0,,《Жақсы... байқадыңыз》
Dialogue: 0,0:11:16.30,0:11:19.64,Default,,0,0,0,,《Кім? ""сурет? Ум...》
Dialogue: 0,0:11:19.64,0:11:23.65,Default,,0,0,0,,《Қайсысы? 》 《Күте тұрыңыз!?》
Dialogue: 0,0:11:24.65,0:11:26.65,Default,,0,0,0,,...Оның мағынасы осы.
Dialogue: 0,0:11:26.65,0:11:29.05,Default,,0,0,0,,...Оның мағынасы осы.
Dialogue: 0,0:11:30.32,0:11:32.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.99,0:11:36.99,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:11:38.99,0:11:42.60,Default,,0,0,0,,Менде де шай бар. Жоқ, жеткілікті.
Dialogue: 0,0:11:42.60,0:11:47.60,Default,,0,0,0,,Түсіндім, қашан қаласаңыз, маған хабарлаңыз.
Dialogue: 0,0:11:47.60,0:11:51.94,Default,,0,0,0,,Есте сақтау қабілетінен айырылып, тіпті мінезі де өзгерді.
Dialogue: 0,0:11:51.94,0:11:53.94,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:11:53.94,0:11:58.28,Default,,0,0,0,,Мен енді не істерімді білмеймін...
Dialogue: 0,0:11:58.28,0:12:01.28,Default,,0,0,0,,Кешіріңіз! Осындай кенеттен
Dialogue: 0,0:12:01.28,0:12:04.62,Default,,0,0,0,,Жарайды, бұл Афина-чанға арналған.
Dialogue: 0,0:12:04.62,0:12:07.96,Default,,0,0,0,,Сонда дәрігер ше? сурет?
Dialogue: 0,0:12:07.96,0:12:11.63,Default,,0,0,0,,А, түсіндім. Біріншіден, бұл аурухана, солай ма?
Dialogue: 0,0:12:11.63,0:12:13.96,Default,,0,0,0,,Иә! Мүмкін...
Dialogue: 0,0:12:13.96,0:12:17.30,Default,,0,0,0,,Пиипуй~ Фуфуфу Ария президенті
Dialogue: 0,0:12:17.30,0:12:19.63,Default,,0,0,0,,Маған біраз салмақ тастау керек
Dialogue: 0,0:12:19.63,0:12:23.64,Default,,0,0,0,,Сіз бір күні қант диабетімен ауыратын боласыз (Президент Ария) Puppupu⁉
Dialogue: 0,0:12:23.64,0:12:26.64,Default,,0,0,0,,Афина есімі! Ха…
Dialogue: 0,0:12:26.64,0:12:29.64,Default,,0,0,0,,Сіз президент Арияның атын білесіз бе?
Dialogue: 0,0:12:29.64,0:12:33.65,Default,,0,0,0,,Иә, бірдеңе тегіс шықты.
Dialogue: 0,0:12:33.65,0:12:35.98,Default,,0,0,0,,Мүмкін қазір?
Dialogue: 0,0:12:35.98,0:12:37.99,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,0:12:37.99,0:12:40.26,Default,,0,0,0,,Афина-сенпай Иә?
Dialogue: 0,0:12:40.26,0:12:43.26,Default,,0,0,0,,Менің атым кім?
Dialogue: 0,0:12:43.26,0:12:45.26,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:12:45.26,0:12:47.26,Default,,0,0,0,,Бұл адамның аты кім?
Dialogue: 0,0:12:47.26,0:12:50.26,Default,,0,0,0,,Қай жолмен...
Dialogue: 0,0:12:50.26,0:12:52.27,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:52.27,0:12:54.60,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:12:54.60,0:12:57.27,Default,,0,0,0,,Күтілгендей, бұл үлкен, жоқ, жоқ, жоқ.
Dialogue: 0,0:12:57.27,0:13:00.27,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ, жоқ, Алиса, тыныштал!
Dialogue: 0,0:13:00.27,0:13:02.58,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:13:04.61,0:13:08.02,Default,,0,0,0,,Қалай? Афина-чан
Dialogue: 0,0:13:08.95,0:13:11.95,Default,,0,0,0,,Пуи? сурет?
Dialogue: 0,0:13:12.95,0:13:16.62,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:13:16.62,0:13:20.96,Default,,0,0,0,,Не? Алисия-чан (Ария президенті) Пуиню~
Dialogue: 0,0:13:20.96,0:13:25.30,Default,,0,0,0,,Тағы да есіме түсті! Алисия түсінеді.
Dialogue: 0,0:13:25.30,0:13:27.97,Default,,0,0,0,,Қандай сиқыр қолдандың?
Dialogue: 0,0:13:27.97,0:13:30.30,Default,,0,0,0,,Хахи~
Dialogue: 0,0:13:30.30,0:13:33.64,Default,,0,0,0,,О, бұл сиқырлы.
Dialogue: 0,0:13:33.64,0:13:38.98,Default,,0,0,0,,Жарайды, бұл уақытша есте сақтаудың шатасуы шығар.
Dialogue: 0,0:13:38.98,0:13:44.59,Default,,0,0,0,,Әзірге оның бүгінгі жағдайына көз жүгіртіп, сауығып кетуін күтейік.
Dialogue: 0,0:13:44.59,0:13:47.59,Default,,0,0,0,,Бұл нәтиже бермесе, ертең ауруханаға барыңыз.
Dialogue: 0,0:13:47.59,0:13:49.59,Default,,0,0,0,,Сонымен, сіз қалай ойлайсыз?
Dialogue: 0,0:13:49.59,0:13:51.93,Default,,0,0,0,,А, иә, аламын.
Dialogue: 0,0:13:51.93,0:13:54.26,Default,,0,0,0,,Ал, мен жұмысқа барамын.
Dialogue: 0,0:13:54.26,0:13:56.93,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:13:56.93,0:13:59.27,Default,,0,0,0,,Я...
Dialogue: 0,0:13:59.27,0:14:02.60,Default,,0,0,0,,Рахмет, Алисия.
Dialogue: 0,0:14:02.60,0:14:04.61,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:04.61,0:14:07.28,Default,,0,0,0,,Мен бірден жеңілдеп қалдым.
Dialogue: 0,0:14:07.28,0:14:11.95,Default,,0,0,0,,Иә, эй, біз неге таныс жерге бармасқа?
Dialogue: 0,0:14:11.95,0:14:14.28,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:14.28,0:14:16.28,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:16.28,0:14:20.62,Default,,0,0,0,,Афина-сенпай бөлмеде тұрудан тезірек сауығып кетуі мүмкін.
Dialogue: 0,0:14:20.62,0:14:22.96,Default,,0,0,0,,Мен де сенімен бірге шығамын.
Dialogue: 0,0:14:22.96,0:14:25.96,Default,,0,0,0,,Таныс жерге барсаңыз, көп нәрсені есте сақтайсыз.
Dialogue: 0,0:14:25.96,0:14:28.30,Default,,0,0,0,,Пуйпуи а...
Dialogue: 0,0:14:28.30,0:14:32.97,Default,,0,0,0,,Не? Жеңілдегенімде қорқынышты ойлар келеді
Dialogue: 0,0:14:32.97,0:14:35.97,Default,,0,0,0,,Не? Афина қазір
Dialogue: 0,0:14:35.97,0:14:39.31,Default,,0,0,0,,Ол жылдам, қателеспейді.
Dialogue: 0,0:14:39.31,0:14:42.91,Default,,0,0,0,,Менің жадым қалпына келмеуі мүмкін бе? Ұнайды
Dialogue: 0,0:14:42.91,0:14:44.91,Default,,0,0,0,,Жақсы емес, солай ма?
Dialogue: 0,0:14:44.91,0:14:53.25,Default,,0,0,0,,♬～
Dialogue: 0,0:14:53.25,0:14:55.26,Default,,0,0,0,,Сіз қай дүкенге барасыз?
Dialogue: 0,0:14:55.26,0:14:58.26,Default,,0,0,0,,Ыстық шоколадтың көптеген түрлері бар.
Dialogue: 0,0:14:58.26,0:15:00.93,Default,,0,0,0,,Эй, мен оны асыға күтемін.
Dialogue: 0,0:15:00.93,0:15:03.60,Default,,0,0,0,,Сонымен қатар, бұл кәдімгі Афина аға үшін.
Dialogue: 0,0:15:03.60,0:15:05.93,Default,,0,0,0,,Бізде арнайы мәзір бар.
Dialogue: 0,0:15:05.93,0:15:08.24,Default,,0,0,0,,Пуйпуи Пуиню~
Dialogue: 0,0:15:11.27,0:15:13.27,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,0:15:13.27,0:15:16.94,Default,,0,0,0,,Афина, есіңде бірдеңе бар ма?
Dialogue: 0,0:15:16.94,0:15:18.95,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:18.95,0:15:21.62,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:15:21.62,0:15:24.62,Default,,0,0,0,,Қош келдіңіз. Бұл әдеттегідей ме?
Dialogue: 0,0:15:24.62,0:15:29.62,Default,,0,0,0,,Иә! Ал мынау, мынау, мынау, өтінемін.
Dialogue: 0,0:15:30.63,0:15:35.96,Default,,0,0,0,,Уау, бәрі дәмді көрінеді... (Президент Ария) Пуи Пуиню~!
Dialogue: 0,0:15:35.96,0:15:39.63,Default,,0,0,0,,Ммм...
Dialogue: 0,0:15:39.63,0:15:42.90,Default,,0,0,0,,Бұл үлкен жауап. Уау, шынымен бе?
Dialogue: 0,0:15:42.90,0:15:46.91,Default,,0,0,0,,Бұл керемет, рахмет Афина.
Dialogue: 0,0:15:49.24,0:15:51.25,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:15:51.25,0:15:54.58,Default,,0,0,0,,Ал, президент, маған беріңізші. Маған бере аласыз ба?
Dialogue: 0,0:15:54.58,0:15:58.25,Default,,0,0,0,,Афина-сенпай, сіз президентті түсінесіз.
Dialogue: 0,0:15:58.25,0:16:02.26,Default,,0,0,0,,Мені есіңізде ме?
Dialogue: 0,0:16:02.26,0:16:04.26,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:04.26,0:16:06.26,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:16:06.26,0:16:09.96,Default,,0,0,0,,Әділ жеткілікті Асықпа Асықпа
Dialogue: 0,0:16:10.93,0:16:12.93,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:16:13.94,0:16:18.61,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет (Президент Ария) Пупуи Пупупуиню
Dialogue: 0,0:16:18.61,0:16:20.61,Default,,0,0,0,,Енді қайда барамыз?
Dialogue: 0,0:16:20.61,0:16:22.61,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:16:22.61,0:16:25.61,Default,,0,0,0,,Хохе қызғылт сары планетаға оралу?
Dialogue: 0,0:16:28.62,0:16:30.95,Default,,0,0,0,,Серуен аяқталды ма?
Dialogue: 0,0:16:30.95,0:16:34.56,Default,,0,0,0,,Үйге жақынырақ нәрсені есіме түсір.
Dialogue: 0,0:16:35.96,0:16:37.96,Default,,0,0,0,,О, Афина-сан.
Dialogue: 0,0:16:37.96,0:16:42.56,Default,,0,0,0,,Бүгін сенің демалыс күнің, бірақ сыртқа шықпайсың ба?
Dialogue: 0,0:16:42.56,0:16:44.90,Default,,0,0,0,,Достарым да жайбарақат жүр деді... Қазір олар кім?
Dialogue: 0,0:16:44.90,0:16:47.24,Default,,0,0,0,,Мм, Афина-сенпай
Dialogue: 0,0:16:47.24,0:16:49.90,Default,,0,0,0,,Бір уақытта бір нәрсені еске түсірейік
Dialogue: 0,0:16:49.90,0:16:53.91,Default,,0,0,0,,Мұндағы барлық нәрселерден ...
Dialogue: 0,0:16:55.24,0:16:58.58,Default,,0,0,0,,Афина-сенпай, саған қай ескек ұнайды?
Dialogue: 0,0:16:58.58,0:17:02.25,Default,,0,0,0,,Уау, бұл өте қиын сұрақ.
Dialogue: 0,0:17:02.25,0:17:04.25,Default,,0,0,0,,Пуи?
Dialogue: 0,0:17:09.59,0:17:11.93,Default,,0,0,0,,Se... Бұл дұрыс.
Dialogue: 0,0:17:11.93,0:17:15.26,Default,,0,0,0,,Бұл таңқаларлық. Сіз жақсы жазылып жатырсыз.
Dialogue: 0,0:17:15.26,0:17:18.93,Default,,0,0,0,,Рахмет Афина Акари-чан
Dialogue: 0,0:17:18.93,0:17:22.60,Default,,0,0,0,,О, керемет! Менің атымды есіңе түсірдің
Dialogue: 0,0:17:22.60,0:17:24.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.61,0:17:29.61,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:32.95,0:17:35.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:35.28,0:17:39.89,Default,,0,0,0,,А-а-а... а-а, солай! Сіз қалай ойлайсыз?
Dialogue: 0,0:17:39.89,0:17:43.22,Default,,0,0,0,,Менің ойымша, Алисия жақында оралады.
Dialogue: 0,0:17:43.22,0:17:46.23,Default,,0,0,0,,ARIA компаниясына бірге бару туралы не айтасыз?
Dialogue: 0,0:17:46.23,0:17:48.23,Default,,0,0,0,,Пуиню~
Dialogue: 0,0:17:50.57,0:17:54.90,Default,,0,0,0,,Кешіріңіз, Афина-сан, президент Ариядан сұраңыз.
Dialogue: 0,0:17:54.90,0:17:58.91,Default,,0,0,0,,Жарайды, президент Ария, бұл жақсы.
Dialogue: 0,0:17:58.91,0:18:01.51,Default,,0,0,0,,Пуйпуи Пуйпуи
Dialogue: 0,0:18:03.91,0:18:07.58,Default,,0,0,0,,Жақсы ма? Ах
Dialogue: 0,0:18:07.58,0:18:11.29,Default,,0,0,0,,Не болды? Сенімен бәрі жақсы ма? Алиса Чан
Dialogue: 0,0:18:12.59,0:18:17.93,Default,,0,0,0,,Афина-сенпай, сен мені есіңе түсірмейсің...
Dialogue: 0,0:18:17.93,0:18:37.95,Default,,0,0,0,,♬～
Dialogue: 0,0:18:37.95,0:18:41.88,Default,,0,0,0,,♬～
Dialogue: 0,0:18:41.88,0:18:44.22,Default,,0,0,0,,Афина-сенпай?
Dialogue: 0,0:18:44.22,0:18:46.22,Default,,0,0,0,,Пуи
Dialogue: 0,0:18:47.89,0:18:53.49,Default,,0,0,0,,Мен сен үшін қандай болдым?
Dialogue: 0,0:18:55.23,0:18:58.57,Default,,0,0,0,,Ол өте ебедейсіз аға болатын.
Dialogue: 0,0:18:58.57,0:19:02.90,Default,,0,0,0,,Мен көп қиындықпен бір бөлмеде болдым.
Dialogue: 0,0:19:02.90,0:19:05.51,Default,,0,0,0,,Әрқашан қиыншылықта
Dialogue: 0,0:19:07.58,0:19:10.58,Default,,0,0,0,,Сіз оны жек көретін шығарсыз.
Dialogue: 0,0:19:10.58,0:19:12.91,Default,,0,0,0,,Аа, маған ұнамайды...
Dialogue: 0,0:19:12.91,0:19:15.52,Default,,0,0,0,,Сонымен, сізге ұнады ма?
Dialogue: 0,0:19:17.25,0:19:19.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:23.26,0:19:27.60,Default,,0,0,0,,Бірдеңе болса, бұл соңғысы.
Dialogue: 0,0:19:27.60,0:19:30.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:30.60,0:19:32.93,Default,,0,0,0,,Алиса-чан...
Dialogue: 0,0:19:32.93,0:19:36.94,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:36.94,0:19:45.61,Default,,0,0,0,,♬～
Dialogue: 0,0:19:45.61,0:19:48.28,Default,,0,0,0,,Ал, жақсы...
Dialogue: 0,0:19:48.28,0:19:51.29,Default,,0,0,0,,Бұл жеткілікті емес пе? Афина-чан
Dialogue: 0,0:19:51.29,0:19:53.29,Default,,0,0,0,,Алисия!
Dialogue: 0,0:19:55.62,0:19:58.29,Default,,0,0,0,,Дұрыс? Афина-чан
Dialogue: 0,0:19:58.29,0:20:00.29,Default,,0,0,0,,Иә
Dialogue: 0,0:20:01.30,0:20:06.30,Default,,0,0,0,,Кешіріңіз, Алиса, мен өтірік айттым.
Dialogue: 0,0:20:06.30,0:20:08.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:08.64,0:20:12.64,Default,,0,0,0,,Жад жоғалту дегеннің бәрі өтірік.
Dialogue: 0,0:20:12.64,0:20:15.04,Default,,0,0,0,,Не? Эх...
Dialogue: 0,0:20:16.31,0:20:18.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:18.31,0:20:21.02,Default,,0,0,0,,Иә!?
Dialogue: 0,0:20:22.65,0:20:25.32,Default,,0,0,0,,Менің ебедейсіздігім үшін
Dialogue: 0,0:20:25.32,0:20:28.66,Default,,0,0,0,,Сіз әрқашан Алисаға көп қиындық келтіресіз, солай емес пе?
Dialogue: 0,0:20:28.66,0:20:31.33,Default,,0,0,0,,Иә, бүгін таңертең туралы.
Dialogue: 0,0:20:31.33,0:20:35.00,Default,,0,0,0,,Мүмкін сен маған деген махаббатыңды шынымен жоғалтқан шығарсың.
Dialogue: 0,0:20:35.00,0:20:37.67,Default,,0,0,0,,Мен қатты қобалжыдым...
Dialogue: 0,0:20:37.67,0:20:42.27,Default,,0,0,0,,Сондықтан мен Алисаның шынайы сезімін білгім келді.
Dialogue: 0,0:20:42.27,0:20:44.27,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:46.27,0:20:49.28,Default,,0,0,0,,Сол себепті, егер жады жоғалса
Dialogue: 0,0:20:49.28,0:20:52.61,Default,,0,0,0,,Алиса мен туралы не ойлайды?
Dialogue: 0,0:20:52.61,0:20:57.28,Default,,0,0,0,,Мен шындықты естимін деп ойладым... (Президент Ария) Пиипуй~
Dialogue: 0,0:20:57.28,0:21:00.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:01.29,0:21:04.96,Default,,0,0,0,,Афина-сенпай Иә.
Dialogue: 0,0:21:04.96,0:21:07.96,Default,,0,0,0,,Келесі жолы мұндай айналмалы әрекеттерді доғарыңыз.
Dialogue: 0,0:21:07.96,0:21:11.63,Default,,0,0,0,,Менен тікелей сұраңыз Иә
Dialogue: 0,0:21:11.63,0:21:14.97,Default,,0,0,0,,Мен Афина Сенпаймын.
Dialogue: 0,0:21:14.97,0:21:18.31,Default,,0,0,0,,Мен мұндай нәрсені жек көремін!
Dialogue: 0,0:21:18.31,0:21:21.01,Default,,0,0,0,,О, ау.
Dialogue: 0,0:21:23.31,0:21:26.65,Default,,0,0,0,,Егер сіз көп уақытта тиімді бола алсаңыз, оны үнемі жасаңыз.
Dialogue: 0,0:21:26.65,0:21:29.32,Default,,0,0,0,,Бірақ бұл өте шаршатады.
Dialogue: 0,0:21:29.32,0:21:34.32,Default,,0,0,0,,Алисия-сан, мүмкін сен оны басынан байқаған шығарсың?
Dialogue: 0,0:21:34.32,0:21:36.32,Default,,0,0,0,,Уау
Dialogue: 0,0:21:36.32,0:21:40.59,Default,,0,0,0,,Афина-чан, сен кейде ақылға сыймайтын нәрселер жасайсың.
Dialogue: 0,0:21:40.59,0:21:44.60,Default,,0,0,0,,Сіз таң қалдыңыз ба? Иә, мен таң қалдым.
Dialogue: 0,0:21:44.60,0:21:48.60,Default,,0,0,0,,Тіпті үш ұлы су перісінің бірі Афина сияқты біреу,
Dialogue: 0,0:21:48.60,0:21:51.61,Default,,0,0,0,,Мен кейде мазасызданамын.
Dialogue: 0,0:21:51.61,0:21:55.28,Default,,0,0,0,,Хехе... біз де
Dialogue: 0,0:21:55.28,0:21:58.28,Default,,0,0,0,,Бір қыз
Dialogue: 0,0:21:59.28,0:22:03.95,Default,,0,0,0,,Жақындарыңызға қалай қарайсыз?
Dialogue: 0,0:22:03.95,0:22:06.62,Default,,0,0,0,,Кейде мен мазасызданамын.
Dialogue: 0,0:22:06.62,0:22:11.29,Default,,0,0,0,,Әсіресе, бұл сүйкімді кіші бала болса.
Dialogue: 0,0:22:11.29,0:22:13.96,Default,,0,0,0,,Мен бірден үйге барамын, жарайды~
Dialogue: 0,0:22:13.96,0:22:16.63,Default,,0,0,0,,Олай болса, Алисия, мен туралы да.
Dialogue: 0,0:22:16.63,0:22:19.03,Default,,0,0,0,,Сіз алаңдайсыз ба?
Dialogue: 0,0:22:20.30,0:22:22.64,Default,,0,0,0,,Хехе, құпия
Dialogue: 0,0:22:22.64,0:22:25.97,Default,,0,0,0,,Эх~ (Президент Ария) Пу~инюу
Dialogue: 0,0:22:25.97,0:22:29.64,Default,,0,0,0,,<Ай-чан, біреуге ғашық болған кезде➡
Dialogue: 0,0:22:29.64,0:22:34.98,Default,,0,0,0,,Мүмкін маған қаншалықты ұнаса, мен де мазасызданамын.＞
Dialogue: 0,0:22:34.98,0:22:39.65,Default,,0,0,0,,<Акари-сан, әрі қарай не болғаны туралы, Алиса-сан және Афина-сан➡
Dialogue: 0,0:22:39.65,0:22:44.06,Default,,0,0,0,,Екеуміз одан да жақсы дос болатынымызға сенімдімін, хехе>
Dialogue: 0,0:22:44.93,0:23:04.95,Default,,0,0,0,,♬～
Dialogue: 0,0:23:04.95,0:23:20.96,Default,,0,0,0,,♬～
Dialogue: 0,0:23:20.96,0:23:24.63,Default,,0,0,0,,♬～
Dialogue: 0,0:23:24.63,0:23:44.59,Default,,0,0,0,,♬～
Dialogue: 0,0:23:44.59,0:24:04.61,Default,,0,0,0,,♬～
Dialogue: 0,0:24:04.61,0:24:13.95,Default,,0,0,0,,♬～
Dialogue: 0,0:24:16.35,0:24:18.35,Default,,0,0,0,,<Бітіруіңмен құттықтаймын, Алиса>
Dialogue: 0,0:24:18.35,0:24:20.35,Default,,0,0,0,,<Енді мен саған қатты қысамын>
Dialogue: 0,0:24:20.35,0:24:23.02,Default,,0,0,0,,<Оның алдында мен Афина-сенпаймен бірге пикник жасаймын...>
Dialogue: 0,0:24:23.02,0:24:25.03,Default,,0,0,0,,<Келесі жолы...>
Dialogue: 0,0:24:26.69,0:24:29.03,Default,,0,0,0,,<Енді маған қолыңды бер>
Dialogue: 0,0:24:30.53,0:24:36.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory