Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.20,Default,,0,0,0,,Ой...
Dialogue: 0,0:00:11.24,0:00:13.01,Default,,0,0,0,,Джо Джет
Dialogue: 0,0:00:14.38,0:00:18.08,Default,,0,0,0,,Жарайды, мен тірімін, мен ұйқы режиміндемін.
Dialogue: 0,0:00:19.51,0:00:20.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:28.06,0:00:28.79,Default,,0,0,0,,Ах
Dialogue: 0,0:00:30.56,0:00:31.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:32.76,0:00:35.20,Default,,0,0,0,,Сіз байқадыңыз, Джо.
Dialogue: 0,0:00:35.60,0:00:37.13,Default,,0,0,0,,Генрих ше?
Dialogue: 0,0:00:40.70,0:00:42.17,Default,,0,0,0,,Генрих…
Dialogue: 0,0:00:42.60,0:00:44.54,Default,,0,0,0,,Неге ештеңе айтпадың?
Dialogue: 0,0:00:48.18,0:00:50.55,Default,,0,0,0,,Мен оны сол кезде білсем де...
Dialogue: 0,0:00:50.61,0:00:52.15,Default,,0,0,0,,Ештеңе жасау мүмкін емес еді
Dialogue: 0,0:00:53.11,0:00:54.72,Default,,0,0,0,,Менмендік деген осы.
Dialogue: 0,0:00:55.32,0:00:57.35,Default,,0,0,0,,Джет, сен...
Dialogue: 0,0:00:57.45,0:01:00.79,Default,,0,0,0,,Ұжым болып қолдан келгенін жасадық.
Dialogue: 0,0:01:01.72,0:01:03.26,Default,,0,0,0,,Бұл нәтиже
Dialogue: 0,0:01:03.53,0:01:04.43,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:01:04.53,0:01:06.80,Default,,0,0,0,,Енді аузымды аштырма!
Dialogue: 0,0:01:07.73,0:01:08.66,Default,,0,0,0,,Ах (003) Ах
Dialogue: 0,0:01:14.50,0:01:19.67,Default,,0,0,0,,Мырзалар, Генрих өзінің соңғы тапсырмасын орындаған сияқты.
Dialogue: 0,0:01:21.21,0:01:24.25,Default,,0,0,0,,Микро дронмен жабдықталған станция -
Dialogue: 0,0:01:24.35,0:01:26.51,Default,,0,0,0,,Жер орбитасынан шығу
Dialogue: 0,0:01:31.12,0:01:33.25,Default,,0,0,0,,Генрихтің ерік-жігерін босқа жібермеу үшін...
Dialogue: 0,0:01:34.09,0:01:35.19,Default,,0,0,0,,Иванды қайтарыңыз
Dialogue: 0,0:01:36.39,0:01:40.20,Default,,0,0,0,,Ал егер император сіз түсіне алмайтын адам болса...
Dialogue: 0,0:01:40.63,0:01:41.56,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:03:17.46,0:03:20.30,Default,,0,0,0,,Не болды, күйеуім? Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:03:20.40,0:03:21.33,Default,,0,0,0,,Ах
Dialogue: 0,0:03:23.77,0:03:24.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:25.20,0:03:26.53,Default,,0,0,0,,Ұлыбритания
Dialogue: 0,0:03:26.77,0:03:27.64,Default,,0,0,0,,♬~
Dialogue: 0,0:03:29.97,0:03:31.51,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:31.74,0:03:32.91,Default,,0,0,0,,Күзетшіге не болды?
Dialogue: 0,0:03:33.27,0:03:33.98,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:03:35.24,0:03:35.91,Default,,0,0,0,,Оката-
Dialogue: 0,0:03:35.98,0:03:39.61,Default,,0,0,0,,Менің ойымша, сізді бұдан былай қамауда ұстауға ешқандай себеп жоқ.
Dialogue: 0,0:03:40.42,0:03:41.78,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:03:42.48,0:03:43.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:44.25,0:03:46.89,Default,,0,0,0,,Бұл сізге сәл қатал.
Dialogue: 0,0:03:59.67,0:04:02.90,Default,,0,0,0,,Сонда Петір жалғыз Бақытты емес пе еді?
Dialogue: 0,0:04:02.97,0:04:04.41,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:04:04.94,0:04:08.81,Default,,0,0,0,,Ендеше, не істейсің, күйеу? Менімен дельфинге мінгің келе ме?
Dialogue: 0,0:04:09.64,0:04:10.65,Default,,0,0,0,,(Игараши күрсінуі)
Dialogue: 0,0:04:11.48,0:04:14.32,Default,,0,0,0,,Мен өз маршрутымды пайдаланып ақпарат жинауға тырысамын.
Dialogue: 0,0:04:15.48,0:04:17.92,Default,,0,0,0,,Мен мұнымен бітетін сияқты емеспін.
Dialogue: 0,0:04:29.70,0:04:33.74,Default,,0,0,0,,Иван, таң қаларлықтай, сенің бұрынғы жолдастарың осылай істеп жатқан сияқты.
Dialogue: 0,0:04:34.90,0:04:39.31,Default,,0,0,0,,Біз жоспарды бұзып қана қоймай, профессорды да жеңдік.
Dialogue: 0,0:04:40.41,0:04:42.81,Default,,0,0,0,,Мен олар мұны істейді деп ойладым.
Dialogue: 0,0:04:43.71,0:04:45.45,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:04:55.39,0:04:57.89,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:04:58.73,0:05:00.53,Default,,0,0,0,,Бұл сізге байланысты
Dialogue: 0,0:05:01.83,0:05:03.43,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:05:04.43,0:05:06.90,Default,,0,0,0,,Сіз жай ғана дос болғыңыз келеді деп ойламаймын.
Dialogue: 0,0:05:07.54,0:05:12.91,Default,,0,0,0,,Иван, сен мен елестеткендей ақылдысың.
Dialogue: 0,0:05:13.71,0:05:15.01,Default,,0,0,0,,Менімен-
Dialogue: 0,0:05:15.08,0:05:18.78,Default,,0,0,0,,Адамзатты жақсы өмірге жетелейік.
Dialogue: 0,0:05:21.65,0:05:26.32,Default,,0,0,0,,Қандай жағдай болмасын, сіз адамзатты басқару идеясынан бас тартпайсыз.
Dialogue: 0,0:05:27.32,0:05:28.56,Default,,0,0,0,,(Императордың күлкісі)
Dialogue: 0,0:05:30.06,0:05:33.96,Default,,0,0,0,,Сіз күткендей адамзатқа жау болып көрінесіз.
Dialogue: 0,0:05:35.10,0:05:36.93,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:05:37.07,0:05:39.70,Default,,0,0,0,,Нені жоспарлап жатқаныңызды білу үшін...
Dialogue: 0,0:05:40.00,0:05:41.44,Default,,0,0,0,,Мен мұнда келдім
Dialogue: 0,0:05:43.87,0:05:45.94,Default,,0,0,0,,Мен сені дұрыс емес жерден пышақтап алсам да тоқтатамын
Dialogue: 0,0:05:46.61,0:05:48.34,Default,,0,0,0,,Бұл менің рөлім.
Dialogue: 0,0:05:56.68,0:06:00.05,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:04.66,0:06:05.63,Default,,0,0,0,,Ах
Dialogue: 0,0:06:05.73,0:06:07.76,Default,,0,0,0,,Иван табиғаттан тыс күштерді пайдаланады.
Dialogue: 0,0:06:08.06,0:06:08.93,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:06:09.03,0:06:10.03,Default,,0,0,0,,Нью-Йорк (002) Ах...
Dialogue: 0,0:06:10.47,0:06:11.87,Default,,0,0,0,,Біріккен Ұлттар Ұйымының штаб-пәтеріне жақын жерде.
Dialogue: 0,0:06:12.77,0:06:14.64,Default,,0,0,0,,Иван, маған жауап бер.
Dialogue: 0,0:06:15.07,0:06:15.94,Default,,0,0,0,,Иван
Dialogue: 0,0:06:17.37,0:06:19.94,Default,,0,0,0,,Бласстың жоспарын тоқтатқан сияқтысыз.
Dialogue: 0,0:06:20.01,0:06:20.91,Default,,0,0,0,,(Барлығының таңданған дауысы)
Dialogue: 0,0:06:20.98,0:06:22.71,Default,,0,0,0,,Иван, жақсысың ба?
Dialogue: 0,0:06:23.44,0:06:26.38,Default,,0,0,0,,Енді мен императордың алдында тұрмын
Dialogue: 0,0:06:26.61,0:06:27.48,Default,,0,0,0,,Не?
Dialogue: 0,0:06:29.82,0:06:34.86,Default,,0,0,0,,Күткендей, сіз қарапайым күш жағынан менен асып кете аласыз.
Dialogue: 0,0:06:37.99,0:06:39.73,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,0:06:40.13,0:06:43.83,Default,,0,0,0,,Былайша айтқанда, біздің күшіміз плюс пен плюс.
Dialogue: 0,0:06:44.13,0:06:45.13,Default,,0,0,0,,(001 тыныс алуы)
Dialogue: 0,0:06:45.90,0:06:49.84,Default,,0,0,0,,(шығарылатын энергия дыбысы)
Dialogue: 0,0:06:53.01,0:06:54.48,Default,,0,0,0,,Император
Dialogue: 0,0:06:54.88,0:06:57.45,Default,,0,0,0,,Сіз мұны біле тұра істеп жатырсыз.
Dialogue: 0,0:06:57.98,0:07:01.75,Default,,0,0,0,,Бірақ бұлай жалғаса берсе, көп адам қатысады.
Dialogue: 0,0:07:02.52,0:07:04.85,Default,,0,0,0,,Иван, мені сонда шақыр.
Dialogue: 0,0:07:08.96,0:07:12.46,Default,,0,0,0,,Мен сенің көмегіңді қайтадан алуым керек.
Dialogue: 0,0:07:16.00,0:07:16.90,Default,,0,0,0,,Ах
Dialogue: 0,0:07:20.00,0:07:20.97,Default,,0,0,0,,Джо
Dialogue: 0,0:07:30.21,0:07:31.51,Default,,0,0,0,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,0:07:32.85,0:07:35.72,Default,,0,0,0,,Мен бір адамға әдемі көрінуге мүмкіндік бере алмаймын.
Dialogue: 0,0:07:41.02,0:07:43.59,Default,,0,0,0,,Орналасқан жері Фемида аралы, Нью-Йорк.
Dialogue: 0,0:07:43.66,0:07:46.83,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:08:05.55,0:08:06.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:15.62,0:08:16.92,Default,,0,0,0,,Үдеткіш
Dialogue: 0,0:08:17.59,0:08:18.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:19.59,0:08:21.16,Default,,0,0,0,,Бұл Генрихке арналған.
Dialogue: 0,0:08:28.84,0:08:30.74,Default,,0,0,0,,(Императордың күлкісі)
Dialogue: 0,0:08:31.21,0:08:32.91,Default,,0,0,0,,Мен күзетімді түсірдім.
Dialogue: 0,0:08:34.28,0:08:37.51,Default,,0,0,0,,Таяқ жегеніме 3000 жыл болды.
Dialogue: 0,0:08:38.25,0:08:43.89,Default,,0,0,0,,Өйткені, 009 жеделдету адамзатты құтқарудың кілті болуы мүмкін.
Dialogue: 0,0:08:44.99,0:08:47.92,Default,,0,0,0,,(байланыс қоңырауының дыбысы)
Dialogue: 0,0:08:48.02,0:08:48.89,Default,,0,0,0,,Игараши?
Dialogue: 0,0:08:49.99,0:08:52.16,Default,,0,0,0,,Балалар сендер жынды сияқтысыңдар.
Dialogue: 0,0:08:52.86,0:08:55.06,Default,,0,0,0,,Күзетшілерге шұғыл қоңырау келді.
Dialogue: 0,0:08:55.13,0:08:55.53,Default,,0,0,0,,«Құпия қоңырау»
Dialogue: 0,0:08:55.53,0:08:57.70,Default,,0,0,0,,``Құпия телефон қоңырауы'' (Игараши) Нью-Йоркте ақымақтық жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:08:57.70,0:08:57.87,Default,,0,0,0,,«Құпия қоңырау»
Dialogue: 0,0:08:58.30,0:09:00.77,Default,,0,0,0,,Мен де өзімді көрсеткім келмейді.
Dialogue: 0,0:09:01.57,0:09:03.70,Default,,0,0,0,,Мені тоқтату ниетің болса, мен аямаймын.
Dialogue: 0,0:09:04.17,0:09:06.81,Default,,0,0,0,,Мен «мен соны қалаймын» дегім келеді, бірақ...
Dialogue: 0,0:09:07.14,0:09:09.24,Default,,0,0,0,,Сіздің кінәсіз екеніңізді кім дәлелдей алады?
Dialogue: 0,0:09:09.31,0:09:10.78,Default,,0,0,0,,Енді мен ғана қалған сияқтымын
Dialogue: 0,0:09:11.55,0:09:12.78,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:13.92,0:09:16.82,Default,,0,0,0,,Біріккен Ұлттар Ұйымының штаб-пәтерінде бұл оқиғаны есіне алатын біреу бар...
Dialogue: 0,0:09:16.88,0:09:18.02,Default,,0,0,0,,Бір адам ғана емес
Dialogue: 0,0:09:19.22,0:09:21.02,Default,,0,0,0,,Шамасы, Петрден басқа...
Dialogue: 0,0:09:21.09,0:09:23.22,Default,,0,0,0,,Естеліктерді өшіретін Берекесі бар шығар.
Dialogue: 0,0:09:24.13,0:09:25.86,Default,,0,0,0,,«Жадты өшіру»?
Dialogue: 0,0:09:26.86,0:09:28.70,Default,,0,0,0,,Ешқандай сенімділік болмаса да
Dialogue: 0,0:09:28.86,0:09:30.80,Default,,0,0,0,,Мен қазірден бастап сізге қосыламын.
Dialogue: 0,0:09:31.33,0:09:32.97,Default,,0,0,0,,Ах... (003) Өшті.
Dialogue: 0,0:09:33.07,0:09:35.20,Default,,0,0,0,,Сіз не ойлап отырсыз? Ол жігіт...
Dialogue: 0,0:09:36.04,0:09:37.34,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:37.61,0:09:40.64,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:09:40.71,0:09:41.21,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:41.68,0:09:45.21,Default,,0,0,0,,Ол өте жылдам қозғалады.
Dialogue: 0,0:09:45.78,0:09:47.21,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:48.08,0:09:48.95,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:09:51.05,0:09:53.69,Default,,0,0,0,,Неге мені мазалайсың?
Dialogue: 0,0:09:54.86,0:09:57.06,Default,,0,0,0,,Мен тек адамның үстемдігінің алдын алғым келеді.
Dialogue: 0,0:09:58.69,0:09:59.36,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:10:00.19,0:10:01.06,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:10:02.16,0:10:03.93,Default,,0,0,0,,(бағананың құлаған дыбысы)
Dialogue: 0,0:10:04.87,0:10:06.20,Default,,0,0,0,,Уф, аа...
Dialogue: 0,0:10:06.30,0:10:08.90,Default,,0,0,0,,Сізде біраз түсініспеушілік бар сияқты.
Dialogue: 0,0:10:09.84,0:10:12.91,Default,,0,0,0,,Адамзат адам ретінде дамудан бас тартты...
Dialogue: 0,0:10:13.74,0:10:16.24,Default,,0,0,0,,Осылай жүре берсек, өзімізді өзіміз құртып аламыз.
Dialogue: 0,0:10:17.21,0:10:22.18,Default,,0,0,0,,Сондықтан мен сізді жақсы өмірге жетелегім келеді.
Dialogue: 0,0:10:24.22,0:10:26.29,Default,,0,0,0,,Бұл өзін-өзі ақтайтын ойлау.
Dialogue: 0,0:10:27.79,0:10:31.86,Default,,0,0,0,,Адамдардың өз еркіне сай өзгеру мүмкіндігі бар.
Dialogue: 0,0:10:33.03,0:10:34.26,Default,,0,0,0,,Сондықтан мен-
Dialogue: 0,0:10:34.33,0:10:36.36,Default,,0,0,0,,Бір адамның өзі көп адамды асырай алады.
Dialogue: 0,0:10:36.96,0:10:37.83,Default,,0,0,0,,Га
Dialogue: 0,0:10:37.93,0:10:39.67,Default,,0,0,0,,Бұл менің миссиям!
Dialogue: 0,0:10:40.40,0:10:41.34,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:10:41.97,0:10:43.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:43.70,0:10:45.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:45.84,0:10:51.11,Default,,0,0,0,,Бір кезде мен де сен сияқты ақымақ адамдарды құтқаруға тырыстым.
Dialogue: 0,0:10:51.81,0:10:52.35,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:54.32,0:10:57.35,Default,,0,0,0,,Сонда бүкіл адамзатты қалай құтқаруға болады...
Dialogue: 0,0:10:57.69,0:11:00.32,Default,,0,0,0,,Біздің өте алыс екенімізді түсіндім.
Dialogue: 0,0:11:01.19,0:11:05.29,Default,,0,0,0,,Император, сіз енді адамзатты қалай құтқармақсыз?
Dialogue: 0,0:11:08.26,0:11:09.73,Default,,0,0,0,,Қалпына келтіру
Dialogue: 0,0:11:11.03,0:11:12.13,Default,,0,0,0,,Қалпына келтіру керек пе?
Dialogue: 0,0:11:13.13,0:11:14.24,Default,,0,0,0,,Қол жұдырық
Dialogue: 0,0:11:15.67,0:11:16.44,Default,,0,0,0,,Келесі, Наоми Минами ісіне қатысты:
Dialogue: 0,0:11:23.18,0:11:25.35,Default,,0,0,0,,Сонда біз де жойыламыз.
Dialogue: 0,0:11:28.25,0:11:29.95,Default,,0,0,0,,Азаматтық қыз-
Dialogue: 0,0:11:30.05,0:11:32.89,Default,,0,0,0,,Мен сені майдан даласына апара алмаймын.
Dialogue: 0,0:11:33.02,0:11:34.06,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:11:34.46,0:11:36.79,Default,,0,0,0,,Жоқ, бұл менмін...
Dialogue: 0,0:11:37.26,0:11:39.73,Default,,0,0,0,,Сізді ұрыс алаңына шығару...
Dialogue: 0,0:11:40.16,0:11:41.43,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:11:41.86,0:11:44.17,Default,,0,0,0,,Бұл біз, нөлдік нөлдік киборгтар.
Dialogue: 0,0:11:44.23,0:11:45.93,Default,,0,0,0,,Миссия дегеніміз не?
Dialogue: 0,0:11:46.47,0:11:48.94,Default,,0,0,0,,Барлығыңыздың да аман қалғаныңызға көз жеткізіңіз.
Dialogue: 0,0:11:49.37,0:11:50.74,Default,,0,0,0,,Сондай-ақ Генрихке...
Dialogue: 0,0:11:51.31,0:11:53.87,Default,,0,0,0,,А, мен саған айтамын.
Dialogue: 0,0:12:02.45,0:12:03.85,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,0:12:04.02,0:12:05.05,Default,,0,0,0,,Уф
Dialogue: 0,0:12:05.35,0:12:06.32,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:12:06.82,0:12:12.76,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:12:13.13,0:12:14.26,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:12:14.46,0:12:16.06,Default,,0,0,0,,Біріккен Ұлттар Ұйымының қамқоршылары
Dialogue: 0,0:12:16.20,0:12:19.27,Default,,0,0,0,,Шүкір, мен оны үрлей алмаймын.
Dialogue: 0,0:12:19.93,0:12:21.90,Default,,0,0,0,,Әйтеуір, Джоға және басқаларға қосылайық.
Dialogue: 0,0:12:23.77,0:12:27.01,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:12:48.93,0:12:50.03,Default,,0,0,0,,(Мылтық көтеріліп жатқан дыбыс)
Dialogue: 0,0:12:50.36,0:12:51.40,Default,,0,0,0,,Ах
Dialogue: 0,0:13:00.34,0:13:02.24,Default,,0,0,0,,«Қалпына келтіру» нені білдіреді?
Dialogue: 0,0:13:03.24,0:13:04.91,Default,,0,0,0,,Дәл сіз не айтасыз.
Dialogue: 0,0:13:05.88,0:13:08.08,Default,,0,0,0,,Бағдарлама тұрып қалды...
Dialogue: 0,0:13:08.18,0:13:11.89,Default,,0,0,0,,Арнайы өзгертулер негізгі шешімдерді қамтамасыз ете алмайды.
Dialogue: 0,0:13:12.89,0:13:15.02,Default,,0,0,0,,Негізгі дизайннан басынан бастаңыз
Dialogue: 0,0:13:16.09,0:13:17.19,Default,,0,0,0,,Қалай...
Dialogue: 0,0:13:18.09,0:13:21.93,Default,,0,0,0,,Иванның телепатиясы мен менің күш-қуатымды біріктіру...
Dialogue: 0,0:13:22.43,0:13:25.03,Default,,0,0,0,,Адамзаттың пайдасыз естеліктерін өшіру
Dialogue: 0,0:13:26.00,0:13:26.97,Default,,0,0,0,,Уау
Dialogue: 0,0:13:27.30,0:13:29.17,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін!
Dialogue: 0,0:13:32.51,0:13:33.41,Default,,0,0,0,,Уф
Dialogue: 0,0:13:37.88,0:13:38.98,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:39.05,0:13:42.98,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:13:43.22,0:13:44.59,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:13:45.39,0:13:47.25,Default,,0,0,0,,Пуууу даааа
Dialogue: 0,0:13:48.96,0:13:49.49,Default,,0,0,0,,Пуууууу
Dialogue: 0,0:13:49.59,0:13:51.26,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:13:52.06,0:13:53.26,Default,,0,0,0,,Пуууууу
Dialogue: 0,0:13:53.46,0:13:55.36,Default,,0,0,0,,Аа?
Dialogue: 0,0:13:55.43,0:13:56.93,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:13:57.23,0:13:57.97,Default,,0,0,0,,Иә
Dialogue: 0,0:13:59.20,0:13:59.97,Default,,0,0,0,,Ах
Dialogue: 0,0:14:02.17,0:14:04.04,Default,,0,0,0,,Игараши Бұл сен бе?
Dialogue: 0,0:14:04.61,0:14:05.84,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:14:06.24,0:14:09.24,Default,,0,0,0,,Бұл тағы да Сенрио актерының келбеті.
Dialogue: 0,0:14:09.51,0:14:12.28,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:14:15.08,0:14:16.18,Default,,0,0,0,,Зымыран?
Dialogue: 0,0:14:16.32,0:14:17.92,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:14:25.39,0:14:26.96,Default,,0,0,0,,Ah Ah Ah
Dialogue: 0,0:14:27.53,0:14:28.23,Default,,0,0,0,,Не?
Dialogue: 0,0:14:28.50,0:14:30.53,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:14:33.07,0:14:37.34,Default,,0,0,0,,Қожайынымның бұйрығымен мен сені билік етемін.
Dialogue: 0,0:14:37.64,0:14:38.91,Default,,0,0,0,,Петр?
Dialogue: 0,0:14:39.04,0:14:41.31,Default,,0,0,0,,(005 айқайлау)
Dialogue: 0,0:14:41.38,0:14:45.35,Default,,0,0,0,,(005 айқайлау)
Dialogue: 0,0:14:45.98,0:14:47.05,Default,,0,0,0,,Уау
Dialogue: 0,0:14:47.25,0:14:48.25,Default,,0,0,0,,(Тыныс алу жалынының дыбысы)
Dialogue: 0,0:14:48.48,0:14:50.25,Default,,0,0,0,,Ха, Әл жоғалып кетті.
Dialogue: 0,0:14:50.38,0:14:51.59,Default,,0,0,0,,Айя
Dialogue: 0,0:14:51.99,0:14:53.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:53.45,0:14:54.36,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:14:56.02,0:14:57.19,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:57.26,0:14:57.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.03,0:14:59.89,Default,,0,0,0,,Уф
Dialogue: 0,0:15:00.53,0:15:02.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:02.26,0:15:04.20,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:15:04.90,0:15:07.10,Default,,0,0,0,,009 Гравитациялық толқындар.
Dialogue: 0,0:15:07.47,0:15:09.40,Default,,0,0,0,,Сізде қаншалықты қабілет бар?
Dialogue: 0,0:15:09.90,0:15:10.97,Default,,0,0,0,,Бір
Dialogue: 0,0:15:12.57,0:15:14.58,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:19.18,0:15:20.01,Default,,0,0,0,,Уф
Dialogue: 0,0:15:21.98,0:15:23.65,Default,,0,0,0,,Иван
Dialogue: 0,0:15:24.29,0:15:25.22,Default,,0,0,0,,Иван
Dialogue: 0,0:15:26.32,0:15:28.59,Default,,0,0,0,,Мен сені ренжіткім келмейді
Dialogue: 0,0:15:29.59,0:15:30.49,Default,,0,0,0,,Га
Dialogue: 0,0:15:32.43,0:15:33.29,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:33.59,0:15:34.60,Default,,0,0,0,,Иван!
Dialogue: 0,0:15:35.13,0:15:36.36,Default,,0,0,0,,Антифилд
Dialogue: 0,0:15:37.00,0:15:39.27,Default,,0,0,0,,Тыныштауыңызды өтінемін.
Dialogue: 0,0:15:39.47,0:15:41.50,Default,,0,0,0,,Киборг ретінде сіздің күшіңіз...
Dialogue: 0,0:15:41.57,0:15:44.27,Default,,0,0,0,,Мен оны менікі ете алмаймын.
Dialogue: 0,0:15:45.07,0:15:46.01,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:15:46.07,0:15:46.94,Default,,0,0,0,,Уф
Dialogue: 0,0:15:47.61,0:15:48.41,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:50.95,0:15:53.61,Default,,0,0,0,,Неліктен? Неге сен менен жылдамырақ қозғала аласың?
Dialogue: 0,0:15:54.52,0:15:57.45,Default,,0,0,0,,Уф, ол жылдам немесе ештеңе қозғалмайды.
Dialogue: 0,0:15:58.19,0:16:00.09,Default,,0,0,0,,Сіздің үдеткішіңіз...
Dialogue: 0,0:16:00.49,0:16:02.42,Default,,0,0,0,,Ойлау жылдамдығын арттыру арқылы -
Dialogue: 0,0:16:02.62,0:16:05.39,Default,,0,0,0,,Дененің жылдамдығына сәйкес келетін шығар.
Dialogue: 0,0:16:07.19,0:16:07.70,Default,,0,0,0,,Уф
Dialogue: 0,0:16:07.96,0:16:09.43,Default,,0,0,0,,Егер ойлау жылдамдығы...
Dialogue: 0,0:16:09.70,0:16:13.07,Default,,0,0,0,,Мен 3000 жыл өмір сүрдім, мен сенен әлдеқайда жақсымын.
Dialogue: 0,0:16:14.07,0:16:15.07,Default,,0,0,0,,(009-ның мазасыз дауысы)
Dialogue: 0,0:16:16.10,0:16:18.34,Default,,0,0,0,,Көңіл қалдырады
Dialogue: 0,0:16:18.74,0:16:22.34,Default,,0,0,0,,Сілтеме берушінің айтқанына біраз үмітім бар еді...
Dialogue: 0,0:16:27.58,0:16:32.02,Default,,0,0,0,,009 Сізде көбірек күш болуы керек.
Dialogue: 0,0:16:33.49,0:16:35.36,Default,,0,0,0,,Уақыттан асып түсетін күш...
Dialogue: 0,0:16:35.66,0:16:37.59,Default,,0,0,0,,(ағынды дыбыс)
Dialogue: 0,0:16:58.05,0:16:59.78,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:17:03.12,0:17:04.02,Default,,0,0,0,,Уф
Dialogue: 0,0:17:04.35,0:17:05.25,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:17:08.06,0:17:08.62,Default,,0,0,0,,002
Dialogue: 0,0:17:09.52,0:17:11.19,Default,,0,0,0,,002 Не болды?
Dialogue: 0,0:17:11.63,0:17:12.46,Default,,0,0,0,,002！
Dialogue: 0,0:17:12.56,0:17:13.43,Default,,0,0,0,,Га
Dialogue: 0,0:17:13.56,0:17:14.46,Default,,0,0,0,,Ei
Dialogue: 0,0:17:17.36,0:17:19.10,Default,,0,0,0,,Көмегің үшін рахмет 003
Dialogue: 0,0:17:19.30,0:17:19.80,Default,,0,0,0,,Га
Dialogue: 0,0:17:21.10,0:17:21.70,Default,,0,0,0,,Иә
Dialogue: 0,0:17:22.04,0:17:24.37,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:25.54,0:17:28.08,Default,,0,0,0,,(Слақ еткен дыбыс)
Dialogue: 0,0:17:28.54,0:17:29.64,Default,,0,0,0,,Игараши га
Dialogue: 0,0:17:31.41,0:17:32.48,Default,,0,0,0,,Сіз қайда бардыңыз?
Dialogue: 0,0:17:32.78,0:17:33.55,Default,,0,0,0,,Уау
Dialogue: 0,0:17:35.25,0:17:37.22,Default,,0,0,0,,Бұл Ұшатын Джо.
Dialogue: 0,0:17:37.72,0:17:41.12,Default,,0,0,0,,Мен оның сол қоқыспен бірдей болғанын қаламаймын.
Dialogue: 0,0:17:41.46,0:17:44.43,Default,,0,0,0,,Мен Құдай таңдаған жаңа адаммын.
Dialogue: 0,0:17:45.06,0:17:47.73,Default,,0,0,0,,Шығындарыңызды жойыңыз...
Dialogue: 0,0:17:48.26,0:17:51.70,Default,,0,0,0,,Құдайдың елшісі ретінде адамзатқа жол көрсету.
Dialogue: 0,0:17:51.80,0:17:54.70,Default,,0,0,0,,Хмф, бұлай айтқаныңды қаламаймын!
Dialogue: 0,0:17:55.60,0:17:59.41,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:17:59.47,0:18:01.78,Default,,0,0,0,,Игараши ойлағаннан артық тырыспа
Dialogue: 0,0:18:02.38,0:18:04.24,Default,,0,0,0,,Мен Рицугимін!
Dialogue: 0,0:18:05.28,0:18:06.11,Default,,0,0,0,,Хун
Dialogue: 0,0:18:06.35,0:18:09.22,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:18:13.45,0:18:14.66,Default,,0,0,0,,Оны неге алдың?
Dialogue: 0,0:18:15.12,0:18:16.12,Default,,0,0,0,,Ммм.
Dialogue: 0,0:18:17.86,0:18:18.76,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:20.63,0:18:21.33,Default,,0,0,0,,Дәлірек айтсам, дәл біздің астымыздағы теңіз портында…
Dialogue: 0,0:18:21.56,0:18:22.36,Default,,0,0,0,,Ах
Dialogue: 0,0:18:23.70,0:18:25.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:25.73,0:18:26.67,Default,,0,0,0,,Ах
Dialogue: 0,0:18:28.50,0:18:29.67,Default,,0,0,0,,Ммм...
Dialogue: 0,0:18:31.67,0:18:32.37,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:32.67,0:18:33.81,Default,,0,0,0,,(Катаринаның тыныс алуы)
Dialogue: 0,0:18:34.24,0:18:35.11,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:35.78,0:18:39.28,Default,,0,0,0,,Сілтемеші Сізден көңілім қалды.
Dialogue: 0,0:18:40.31,0:18:41.22,Default,,0,0,0,,Катарина
Dialogue: 0,0:18:42.15,0:18:44.65,Default,,0,0,0,,Мен сіздің ойларыңызды жеке көремін.
Dialogue: 0,0:18:45.62,0:18:46.49,Default,,0,0,0,,Ах
Dialogue: 0,0:18:47.19,0:18:50.39,Default,,0,0,0,,Сіздің сілтеме мүмкіндігіңіз де менікі.
Dialogue: 0,0:18:51.19,0:18:52.19,Default,,0,0,0,,Га
Dialogue: 0,0:18:52.56,0:18:53.86,Default,,0,0,0,,Менің қабілетім?
Dialogue: 0,0:18:55.33,0:18:59.50,Default,,0,0,0,,Император, сіз табиғаттан тыс күштерді көшіре аласыз ба?
Dialogue: 0,0:18:59.73,0:19:00.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:00.53,0:19:02.20,Default,,0,0,0,,Иә, Иван.
Dialogue: 0,0:19:02.47,0:19:05.51,Default,,0,0,0,,Сіз түрткен адамның күшін қайталай аласыз.
Dialogue: 0,0:19:06.57,0:19:08.74,Default,,0,0,0,,Мен ол кезді ешқашан ойламаппын...
Dialogue: 0,0:19:12.51,0:19:13.48,Default,,0,0,0,,Ах
Dialogue: 0,0:19:13.58,0:19:17.58,Default,,0,0,0,,Көшірменің арқасында ұрланған адамның қабілеті өзгермейді.
Dialogue: 0,0:19:18.49,0:19:19.59,Default,,0,0,0,,Яғни-
Dialogue: 0,0:19:20.15,0:19:23.16,Default,,0,0,0,,Ұрланғанын білмеген
Dialogue: 0,0:19:24.93,0:19:26.46,Default,,0,0,0,,(Катаринаның тыныс алуы)
Dialogue: 0,0:19:27.19,0:19:28.56,Default,,0,0,0,,Айтпақшы, байланыстырушы
Dialogue: 0,0:19:28.70,0:19:29.70,Default,,0,0,0,,Ах
Dialogue: 0,0:19:30.66,0:19:33.27,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:19:34.33,0:19:35.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:36.80,0:19:38.37,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:38.71,0:19:39.71,Default,,0,0,0,,Не?
Dialogue: 0,0:19:43.41,0:19:44.81,Default,,0,0,0,,Қол жұдырық
Dialogue: 0,0:19:46.71,0:19:47.81,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:19:48.38,0:19:49.92,Default,,0,0,0,,Мен не істеймін?
Dialogue: 0,0:19:53.29,0:19:57.19,Default,,0,0,0,,Сіз киборгтарды жоймайсыз ба?
Dialogue: 0,0:19:58.36,0:20:01.76,Default,,0,0,0,,Иә, Игарашимен бірге Супериор көлінде.
Dialogue: 0,0:20:02.83,0:20:05.37,Default,,0,0,0,,Катаринаға не істедің?
Dialogue: 0,0:20:05.70,0:20:08.34,Default,,0,0,0,,Мен жадты жаңа ғана өшірдім.
Dialogue: 0,0:20:08.44,0:20:09.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:11.37,0:20:14.34,Default,,0,0,0,,Бұл адамдар үшін маңызды нәрсе шығар...
Dialogue: 0,0:20:14.84,0:20:19.48,Default,,0,0,0,,Бәрін өшірсең, енді мұңаймайсың.
Dialogue: 0,0:20:19.58,0:20:21.72,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:20:22.78,0:20:23.92,Default,,0,0,0,,Не...
Dialogue: 0,0:20:24.75,0:20:25.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:26.25,0:20:27.25,Default,,0,0,0,,009
Dialogue: 0,0:20:28.39,0:20:30.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:31.29,0:20:32.43,Default,,0,0,0,,(009 тыныс алуы)
Dialogue: 0,0:20:42.87,0:20:44.34,Default,,0,0,0,,Неге...
Dialogue: 0,0:20:46.91,0:20:47.61,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:20:48.01,0:20:49.98,Default,,0,0,0,,Қылышты танктің әлсіз жақтары бар ма?
Dialogue: 0,0:20:50.61,0:20:52.01,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:20:52.31,0:20:53.25,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:20:53.35,0:20:55.38,Default,,0,0,0,,Хм... қозғалуды тоқтатыңыз.
Dialogue: 0,0:20:55.75,0:20:56.95,Default,,0,0,0,,10 секунд жеткілікті
Dialogue: 0,0:20:57.45,0:20:58.79,Default,,0,0,0,,Уау, иә
Dialogue: 0,0:20:58.92,0:20:59.62,Default,,0,0,0,,Уау
Dialogue: 0,0:20:59.69,0:21:00.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:03.42,0:21:04.96,Default,,0,0,0,,Бұл жігіт 10 секундқа?
Dialogue: 0,0:21:05.03,0:21:06.43,Default,,0,0,0,,Әлі де мүмкін емес пе?
Dialogue: 0,0:21:06.56,0:21:08.76,Default,,0,0,0,,Жоқ, мен істеймін!
Dialogue: 0,0:21:18.87,0:21:19.77,Default,,0,0,0,,Уф
Dialogue: 0,0:21:20.47,0:21:22.81,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:21:22.98,0:21:25.45,Default,,0,0,0,,(Игарашидің қиналған дауысы)
Dialogue: 0,0:21:25.88,0:21:29.42,Default,,0,0,0,,А, қарғыс атсын, басқару элементтерін қарғыс атсын...
Dialogue: 0,0:21:31.35,0:21:34.45,Default,,0,0,0,,Жоқ, Игараши, әлі жоқ.
Dialogue: 0,0:21:34.59,0:21:36.42,Default,,0,0,0,,Әлі берілме!
Dialogue: 0,0:21:39.56,0:21:40.39,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:21:46.77,0:21:47.67,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:21:49.47,0:21:49.97,Default,,0,0,0,,Иә
Dialogue: 0,0:21:50.50,0:21:52.97,Default,,0,0,0,,Сіз оны жалаң қолыңызбен сынайтыныңызға сенімдісіз бе?
Dialogue: 0,0:21:54.61,0:21:55.54,Default,,0,0,0,,Уау
Dialogue: 0,0:21:55.74,0:21:58.41,Default,,0,0,0,,Уф, мен мұны істеуім керек.
Dialogue: 0,0:21:58.85,0:21:59.55,Default,,0,0,0,,Ммм
Dialogue: 0,0:21:59.61,0:22:00.08,Default,,0,0,0,,О
Dialogue: 0,0:22:05.79,0:22:07.49,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:22:07.59,0:22:11.33,Default,,0,0,0,,If you grasp it, there will be no acceleration or shit.
Dialogue: 0,0:22:12.53,0:22:13.56,Default,,0,0,0,,Не?
Dialogue: 0,0:22:18.07,0:22:20.77,Default,,0,0,0,,Ууууууууууу
Dialogue: 0,0:22:21.47,0:22:22.00,Default,,0,0,0,,Аня Форджер
Dialogue: 0,0:22:25.54,0:22:29.94,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:22:30.48,0:22:31.95,Default,,0,0,0,,Барлығы, осы жаққа шығыңдар!
Dialogue: 0,0:22:35.38,0:22:36.05,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:22:38.65,0:22:42.62,Default,,0,0,0,,(механикалық ақау дыбысы)
Dialogue: 0,0:22:42.69,0:22:44.02,Default,,0,0,0,,Ессіздік
Dialogue: 0,0:22:45.69,0:22:48.80,Default,,0,0,0,,Бірақ ол әлі де функционалдығын жоғалтқан жоқ.
Dialogue: 0,0:22:49.63,0:22:51.13,Default,,0,0,0,,(002-нің ыңырсыуы)
Dialogue: 0,0:22:53.73,0:22:54.97,Default,,0,0,0,,Ағын
Dialogue: 0,0:23:00.51,0:23:02.48,Default,,0,0,0,,Жақсы бақылау.
Dialogue: 0,0:23:04.68,0:23:05.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:05.95,0:23:07.15,Default,,0,0,0,,Игараши
Dialogue: 0,0:23:07.61,0:23:09.48,Default,,0,0,0,,Қош бол Петр
Dialogue: 0,0:23:09.55,0:23:12.05,Default,,0,0,0,,(Зымыран ұшыру дыбысы)
Dialogue: 0,0:23:12.79,0:23:13.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:15.86,0:23:20.59,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:23:22.09,0:23:28.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory