Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:40.46,0:01:41.70,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:01:52.54,0:01:55.88,Default,,0,0,0,,Мен мүмкіндігінше оларды ол жерден шығаруға тырысамын.
Dialogue: 0,0:01:56.21,0:01:57.28,Default,,0,0,0,,Әлден сұраңыз
Dialogue: 0,0:01:57.48,0:01:58.41,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:01:58.75,0:02:01.88,Default,,0,0,0,,Сіз осында қалып, Пюнманың қашып кеткенін тамашалайсыз ба?
Dialogue: 0,0:02:02.22,0:02:06.25,Default,,0,0,0,,Қалай болғанда да, қазір Пюнмаға сеніп, онымен араласпа.
Dialogue: 0,0:02:06.72,0:02:07.79,Default,,0,0,0,,(002 күрсінуі)
Dialogue: 0,0:02:12.76,0:02:13.76,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:02:13.83,0:02:15.16,Default,,0,0,0,,Күйеуі
Dialogue: 0,0:02:15.60,0:02:17.47,Default,,0,0,0,,Сіз кәдесый алдыңыз ба?
Dialogue: 0,0:02:17.83,0:02:20.70,Default,,0,0,0,,Жоқ, сіз бірдеңені білетін сияқтысыз...
Dialogue: 0,0:02:20.87,0:02:23.57,Default,,0,0,0,,Бұл мәселеде аузыңызды жабық ұстағаныңыз дұрыс...
Dialogue: 0,0:02:23.67,0:02:25.31,Default,,0,0,0,,Бұл үнсіз келісім сияқты.
Dialogue: 0,0:02:25.41,0:02:27.31,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:02:27.48,0:02:30.61,Default,,0,0,0,,Не керек, сақшылар оны иіскеп алды.
Dialogue: 0,0:02:30.78,0:02:31.81,Default,,0,0,0,,Не?
Dialogue: 0,0:02:32.48,0:02:34.88,Default,,0,0,0,,Сені достарың сатып жіберген жоқ па?
Dialogue: 0,0:02:35.42,0:02:40.66,Default,,0,0,0,,Адамдарды тыңдама, жаман сөз айтпа. Британдықтар өте жанашыр.
Dialogue: 0,0:02:41.52,0:02:42.62,Default,,0,0,0,,Яғни...
Dialogue: 0,0:02:42.82,0:02:47.86,Default,,0,0,0,,Бұл бізді қандай да бір жолмен бақылайтын біреу бар дегенді білдіре ме?
Dialogue: 0,0:02:48.20,0:02:49.23,Default,,0,0,0,,Ах
Dialogue: 0,0:02:49.40,0:02:51.47,Default,,0,0,0,,Міне!
Dialogue: 0,0:02:56.64,0:02:57.54,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:00.48,0:03:02.81,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:03:05.45,0:03:06.92,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:03:08.58,0:03:09.55,Default,,0,0,0,,Джо
Dialogue: 0,0:03:17.69,0:03:21.96,Default,,0,0,0,,Франсуа Менің денеме не болды?
Dialogue: 0,0:03:22.90,0:03:26.70,Default,,0,0,0,,Жарайды Джо, сен де байқадың, солай ма?
Dialogue: 0,0:03:29.60,0:03:30.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:36.61,0:03:37.48,Default,,0,0,0,,Қан?
Dialogue: 0,0:03:39.61,0:03:43.82,Default,,0,0,0,,Түсіндің бе? кәдімгі адамдарға қайта оралдық
Dialogue: 0,0:03:44.32,0:03:45.52,Default,,0,0,0,,Бұлай болмауы керек...
Dialogue: 0,0:03:46.22,0:03:47.96,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:03:48.22,0:03:48.72,Default,,0,0,0,,Ах (009) Ах
Dialogue: 0,0:03:49.39,0:03:52.66,Default,,0,0,0,,Бұл сіздің жауабыңыз.
Dialogue: 0,0:03:53.49,0:03:54.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:54.83,0:03:56.33,Default,,0,0,0,,Иә, Джо.
Dialogue: 0,0:03:56.90,0:04:00.57,Default,,0,0,0,,Бұл біз әрқашан болғанын қалайтынбыз.
Dialogue: 0,0:04:01.27,0:04:03.30,Default,,0,0,0,,Енді сіз соғыспай өмір сүре аласыз.
Dialogue: 0,0:04:04.31,0:04:06.44,Default,,0,0,0,,Бірақ Франсуа...
Dialogue: 0,0:04:08.74,0:04:10.68,Default,,0,0,0,,Жоғалмаңыз
Dialogue: 0,0:04:12.31,0:04:15.58,Default,,0,0,0,,Қазір кім екеніңізден рахат алыңыз
Dialogue: 0,0:04:16.62,0:04:19.72,Default,,0,0,0,,Джо Мен шынымен бақыттымын.
Dialogue: 0,0:04:20.62,0:04:21.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:23.39,0:04:26.73,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:04:27.33,0:04:28.73,Default,,0,0,0,,Жағдайды хабарлау
Dialogue: 0,0:04:28.96,0:04:31.87,Default,,0,0,0,,Біз қозғалатын нысанды таптық және оның артынан жүріп жатырмыз...
Dialogue: 0,0:04:31.93,0:04:33.57,Default,,0,0,0,,Әлі көрінбейді
Dialogue: 0,0:04:34.44,0:04:35.44,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:35.80,0:04:37.87,Default,,0,0,0,,Бұл 008 шығар.
Dialogue: 0,0:04:38.54,0:04:40.04,Default,,0,0,0,,Маған бір рет атыңыз.
Dialogue: 0,0:04:40.61,0:04:41.71,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:42.81,0:04:44.51,Default,,0,0,0,,(Зымыран ұшыру дыбысы)
Dialogue: 0,0:04:45.75,0:04:46.71,Default,,0,0,0,,Ой
Dialogue: 0,0:04:47.58,0:04:50.65,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:04:51.75,0:04:52.95,Default,,0,0,0,,Ұсталған
Dialogue: 0,0:04:53.29,0:04:53.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:54.62,0:04:55.72,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:04:56.56,0:04:58.96,Default,,0,0,0,,Балалар қосылып, оны ұстап алыңдар.
Dialogue: 0,0:04:59.33,0:05:00.36,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:00.80,0:05:02.63,Default,,0,0,0,,(кему дыбысы)
Dialogue: 0,0:05:02.70,0:05:03.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:03.90,0:05:06.60,Default,,0,0,0,,Кешіріңіздер, мен де ұсталған сияқтымын.
Dialogue: 0,0:05:07.57,0:05:09.44,Default,,0,0,0,,Ақыр соңында, бұл алдау болды ма?
Dialogue: 0,0:05:10.31,0:05:11.07,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:05:12.37,0:05:14.88,Default,,0,0,0,,008 нөмірін алғаш көрген орынға жылжытыңыз.
Dialogue: 0,0:05:15.38,0:05:17.41,Default,,0,0,0,,Олар сонда болуы керек.
Dialogue: 0,0:05:17.48,0:05:21.05,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:05:24.42,0:05:26.99,Default,,0,0,0,,Катарина, қалыңыз қалай?
Dialogue: 0,0:05:27.69,0:05:30.36,Default,,0,0,0,,009 орналасқан жері анықталды.
Dialogue: 0,0:05:30.83,0:05:32.43,Default,,0,0,0,,Жақында келеді
Dialogue: 0,0:05:32.69,0:05:34.90,Default,,0,0,0,,Мен олардан сұрағым келетін нәрселер өте көп.
Dialogue: 0,0:05:35.73,0:05:38.10,Default,,0,0,0,,Мүмкіндігінше тірідей түсіріңіз
Dialogue: 0,0:05:38.87,0:05:39.87,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:42.37,0:05:45.81,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:51.61,0:05:52.85,Default,,0,0,0,,Әлі де ауырады ма?
Dialogue: 0,0:05:53.58,0:05:54.58,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:55.12,0:05:58.99,Default,,0,0,0,,Джоның жарақатын осылай емдейтін күннің келетініне сене алар емеспін...
Dialogue: 0,0:05:59.72,0:06:00.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:01.59,0:06:03.69,Default,,0,0,0,,Сізді не уайымдады?
Dialogue: 0,0:06:04.96,0:06:07.43,Default,,0,0,0,,Егер сіз киборг ретінде өз күштеріңізді жоғалтсаңыз...
Dialogue: 0,0:06:08.36,0:06:10.43,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:06:10.80,0:06:11.67,Default,,0,0,0,,Джо
Dialogue: 0,0:06:11.80,0:06:14.97,Default,,0,0,0,,Соғыспаудың жолын іздейсің...
Dialogue: 0,0:06:15.40,0:06:18.37,Default,,0,0,0,,Жауапқа келдіңіз бе?
Dialogue: 0,0:06:18.87,0:06:20.44,Default,,0,0,0,,Бұл жауап па?
Dialogue: 0,0:06:21.14,0:06:23.95,Default,,0,0,0,,Мен адам болғым келді ме?
Dialogue: 0,0:06:25.01,0:06:27.72,Default,,0,0,0,,Сіз қаруыңызды тастадыңыз.
Dialogue: 0,0:06:28.38,0:06:31.92,Default,,0,0,0,,Адамдарда қару болған кезде оны пайдаланғысы келеді.
Dialogue: 0,0:06:32.79,0:06:36.16,Default,,0,0,0,,Сол себепті азап шектің ғой, солай ма?
Dialogue: 0,0:06:37.13,0:06:38.99,Default,,0,0,0,,Ұрысты қалай болдырмау керек -
Dialogue: 0,0:06:39.06,0:06:41.70,Default,,0,0,0,,Менің киборг денемді лақтырып тастаудан басқа амалым жоқ па?
Dialogue: 0,0:06:42.16,0:06:45.40,Default,,0,0,0,,Джо, мына денені қабылдап алайық.
Dialogue: 0,0:06:46.50,0:06:50.94,Default,,0,0,0,,Қару ұстамау – адам құқығы.
Dialogue: 0,0:06:51.17,0:06:54.41,Default,,0,0,0,,Өз ойларыңызды орындаңыз
Dialogue: 0,0:06:55.04,0:06:56.98,Default,,0,0,0,,Иә, Джо (009) Ах.
Dialogue: 0,0:06:57.98,0:07:01.72,Default,,0,0,0,,Біз осылай бақыттырақ болармыз.
Dialogue: 0,0:07:02.08,0:07:03.58,Default,,0,0,0,,(Рей) Уу-хуу! (Эмма) Уау!
Dialogue: 0,0:07:04.19,0:07:05.99,Default,,0,0,0,,А... солай шығар.
Dialogue: 0,0:07:08.46,0:07:10.16,Default,,0,0,0,,Эй Джо, сен мені естисің бе?
Dialogue: 0,0:07:10.66,0:07:12.56,Default,,0,0,0,,Франсуа, жауап бер!
Dialogue: 0,0:07:13.03,0:07:14.43,Default,,0,0,0,,Эй, сен мені естімейсің бе?
Dialogue: 0,0:07:15.46,0:07:17.17,Default,,0,0,0,,Бұл қызық Әл.
Dialogue: 0,0:07:17.73,0:07:18.67,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:19.07,0:07:20.87,Default,,0,0,0,,Джодан және басқалардан жауап жоқ.
Dialogue: 0,0:07:20.94,0:07:21.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:21.84,0:07:22.70,Default,,0,0,0,,Жотаро, бұл сенің кінәң емес.
Dialogue: 0,0:07:23.04,0:07:24.44,Default,,0,0,0,,Бата болуы мүмкін бе?
Dialogue: 0,0:07:24.51,0:07:25.61,Default,,0,0,0,,(Гилмор Люсидің айқайы)
Dialogue: 0,0:07:26.77,0:07:28.08,Default,,0,0,0,,Тереңдік зарядтары
Dialogue: 0,0:07:30.51,0:07:32.81,Default,,0,0,0,,Мақсат - оларды әшкерелеу.
Dialogue: 0,0:07:33.55,0:07:36.12,Default,,0,0,0,,Енді шыдай алмай, бетіне шыққанша мені қорқыта бер.
Dialogue: 0,0:07:40.86,0:07:43.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:07:43.83,0:07:45.23,Default,,0,0,0,,Иван... (Люси) Иә.
Dialogue: 0,0:07:45.86,0:07:50.53,Default,,0,0,0,,008 арқасында олар сіздің нақты орналасқан жеріңізді білмейді.
Dialogue: 0,0:07:50.97,0:07:52.23,Default,,0,0,0,,Оны кездейсоқ тастаңыз -
Dialogue: 0,0:07:52.50,0:07:54.47,Default,,0,0,0,,Мен сенің дыбысыңды күтемін.
Dialogue: 0,0:07:54.57,0:07:56.77,Default,,0,0,0,,Егер бұл орын алса, түбірлерді салыстырыңыз.
Dialogue: 0,0:07:57.64,0:07:59.11,Default,,0,0,0,,002 Не болды?
Dialogue: 0,0:07:59.57,0:08:00.94,Default,,0,0,0,,А, Генрих?
Dialogue: 0,0:08:01.64,0:08:04.21,Default,,0,0,0,,Сақшылар бізге шабуыл жасап жатқан сияқты.
Dialogue: 0,0:08:04.95,0:08:07.25,Default,,0,0,0,,Олар да осында күтіп тұрды.
Dialogue: 0,0:08:08.12,0:08:11.25,Default,,0,0,0,,Не? Уф... Осы қарқынмен тіпті Джо да, басқалары да...
Dialogue: 0,0:08:12.09,0:08:13.82,Default,,0,0,0,,Барлығына не болды?
Dialogue: 0,0:08:13.92,0:08:14.86,Default,,0,0,0,,Уф... (Люси) Ах.
Dialogue: 0,0:08:15.06,0:08:16.16,Default,,0,0,0,,Джеронимо
Dialogue: 0,0:08:16.69,0:08:19.16,Default,,0,0,0,,Сақшылар шабуылға шықты.
Dialogue: 0,0:08:19.53,0:08:22.06,Default,,0,0,0,,Ол да осы бағытта келе жатқан шығар...
Dialogue: 0,0:08:22.16,0:08:24.10,Default,,0,0,0,,Джо да, Франсуа да жауап бермейді.
Dialogue: 0,0:08:24.60,0:08:25.87,Default,,0,0,0,,Дереу кетіңіз.
Dialogue: 0,0:08:26.10,0:08:26.97,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:29.17,0:08:29.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:31.91,0:08:32.84,Default,,0,0,0,,Джеронимо...
Dialogue: 0,0:08:33.61,0:08:34.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:34.71,0:08:37.78,Default,,0,0,0,,Неліктен ол ағыннан ми толқындарының байланысына жауап бермейді?
Dialogue: 0,0:08:38.51,0:08:39.68,Default,,0,0,0,,Иә? (009) А...
Dialogue: 0,0:08:39.75,0:08:40.95,Default,,0,0,0,,Мен сізді ести алмадым.
Dialogue: 0,0:08:41.02,0:08:41.95,Default,,0,0,0,,Не?
Dialogue: 0,0:08:42.72,0:08:45.99,Default,,0,0,0,,Біз күшімізден айырылған сияқтымыз.
Dialogue: 0,0:08:46.95,0:08:47.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:48.52,0:08:50.89,Default,,0,0,0,,Біз енді күресе алмаймыз
Dialogue: 0,0:08:51.23,0:08:53.29,Default,,0,0,0,,Джеронимо, мен түсінемін.
Dialogue: 0,0:08:54.20,0:08:57.57,Default,,0,0,0,,Қару-жарақты лақтырып тастасақ, соғысуға тура келмейді...
Dialogue: 0,0:08:57.97,0:08:59.23,Default,,0,0,0,,(005 тыныс алуы)
Dialogue: 0,0:09:01.77,0:09:04.24,Default,,0,0,0,,Сен бұл екеуіне не істедің?
Dialogue: 0,0:09:04.71,0:09:05.21,Default,,0,0,0,,Джеронимо!
Dialogue: 0,0:09:06.11,0:09:07.17,Default,,0,0,0,,Докунда (009) Уф...
Dialogue: 0,0:09:07.24,0:09:08.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:10.55,0:09:11.91,Default,,0,0,0,,А, Джо?
Dialogue: 0,0:09:15.08,0:09:16.72,Default,,0,0,0,,Джо, жақсысың ба?
Dialogue: 0,0:09:17.05,0:09:17.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:18.59,0:09:21.09,Default,,0,0,0,,Джеронимо, ауырып тұр.
Dialogue: 0,0:09:21.16,0:09:22.29,Default,,0,0,0,,(005-тің таңданған дауысы)
Dialogue: 0,0:09:23.69,0:09:26.99,Default,,0,0,0,,Мен бұл ауруды тіпті ұмытып кеткен едім.
Dialogue: 0,0:09:35.80,0:09:39.04,Default,,0,0,0,,Барлық персонал түсуге дайындалады Бастау операциясы
Dialogue: 0,0:09:40.01,0:09:42.71,Default,,0,0,0,,Оларды тапқан бойда сол жерде атыңыз.
Dialogue: 0,0:09:42.91,0:09:44.01,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:44.85,0:09:48.18,Default,,0,0,0,,Джо Франсуа, оян.
Dialogue: 0,0:09:48.28,0:09:49.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:49.35,0:09:54.16,Default,,0,0,0,,Уайымдамаңыз, олар жақында таңдауын аяқтайды.
Dialogue: 0,0:09:55.72,0:10:01.03,Default,,0,0,0,,Адам сияқты өмір сүресіз бе, әлде киборг болып өмір сүресіз бе?
Dialogue: 0,0:10:01.70,0:10:03.03,Default,,0,0,0,,Ах... (003) Ах...
Dialogue: 0,0:10:05.13,0:10:07.00,Default,,0,0,0,,Таңдаудың қажеті жоқ
Dialogue: 0,0:10:07.97,0:10:10.97,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:11.77,0:10:15.34,Default,,0,0,0,,Денені бізге ұлы рух берді.
Dialogue: 0,0:10:15.94,0:10:18.25,Default,,0,0,0,,Біріншіден біздікі емес
Dialogue: 0,0:10:19.15,0:10:21.22,Default,,0,0,0,,Тіпті өзгертілген денемен-
Dialogue: 0,0:10:21.88,0:10:25.22,Default,,0,0,0,,Сіз өз еркіңізді ешқашан ұмытпайсыз ба?
Dialogue: 0,0:10:30.12,0:10:32.16,Default,,0,0,0,,Біз Тесейдің кемелеріміз.
Dialogue: 0,0:10:33.03,0:10:37.70,Default,,0,0,0,,Тәніңізді қанша өзгертсеңіз де, жаныңызды босатпасаңыз...
Dialogue: 0,0:10:38.27,0:10:40.77,Default,,0,0,0,,Сіздің кім екеніңізде ешқандай айырмашылық жоқ.
Dialogue: 0,0:10:42.00,0:10:43.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:44.17,0:10:45.24,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:10:45.31,0:10:48.41,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:10:48.68,0:10:49.98,Default,,0,0,0,,Уф (003) Ах...
Dialogue: 0,0:10:53.15,0:10:54.18,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:10:55.72,0:10:56.32,Default,,0,0,0,,(005 тыныс алуы)
Dialogue: 0,0:11:06.69,0:11:07.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:13.20,0:11:15.14,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:11:25.78,0:11:27.45,Default,,0,0,0,,(мүшенің батып бара жатқан дыбысы)
Dialogue: 0,0:11:28.98,0:11:32.39,Default,,0,0,0,,Менің су астындағы соғыста сендерге қарағанда тәжірибем көп.
Dialogue: 0,0:11:33.79,0:11:36.06,Default,,0,0,0,,(мүшенің батып бара жатқан дыбысы)
Dialogue: 0,0:11:40.86,0:11:41.93,Default,,0,0,0,,Пухаха
Dialogue: 0,0:11:43.16,0:11:44.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:45.07,0:11:46.93,Default,,0,0,0,,Сіз мені байқадыңыз ба?
Dialogue: 0,0:11:48.04,0:11:49.94,Default,,0,0,0,,Егер бұлай болса, оны атып тастаудан басқа амалым жоқ...
Dialogue: 0,0:11:54.21,0:11:56.04,Default,,0,0,0,,Сақтықты төмендетпеңіз.
Dialogue: 0,0:11:56.84,0:11:58.75,Default,,0,0,0,,008 Не болды?
Dialogue: 0,0:11:59.01,0:12:02.18,Default,,0,0,0,,Кешіріңіздер, балалар, мен сандарды сәйкестендіре алмаймын.
Dialogue: 0,0:12:02.28,0:12:02.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:04.05,0:12:05.35,Default,,0,0,0,,Ал не істеуі керек?
Dialogue: 0,0:12:06.12,0:12:07.96,Default,,0,0,0,,Мен олармен сөйлесемін.
Dialogue: 0,0:12:08.12,0:12:09.29,Default,,0,0,0,,Иә? Аха...
Dialogue: 0,0:12:09.42,0:12:13.39,Default,,0,0,0,,Бұл ешқашан ұшақтың кетіп бара жатқаны туралы әңгіме емес, Аль.
Dialogue: 0,0:12:14.06,0:12:16.06,Default,,0,0,0,,Бұл сізге байланысты.
Dialogue: 0,0:12:16.13,0:12:18.33,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:12:32.18,0:12:37.12,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:12:40.79,0:12:42.42,Default,,0,0,0,,(Ұшақтың қону дыбысы)
Dialogue: 0,0:13:03.51,0:13:07.41,Default,,0,0,0,,Сіз халықаралық терроризмнің алдын алу заңын бұзды деген күдікпен қамауға алындыңыз.
Dialogue: 0,0:13:08.38,0:13:10.12,Default,,0,0,0,,Барлығы дереу тапсырады.
Dialogue: 0,0:13:10.95,0:13:11.85,Default,,0,0,0,,Хун
Dialogue: 0,0:13:12.49,0:13:14.79,Default,,0,0,0,,Өкінішке орай, барлығы сыртта.
Dialogue: 0,0:13:15.32,0:13:17.06,Default,,0,0,0,,Мен үйде жалғызбын.
Dialogue: 0,0:13:17.53,0:13:22.30,Default,,0,0,0,,001 006 Гилмор мен Люси де сонда болуы керек.
Dialogue: 0,0:13:23.36,0:13:25.43,Default,,0,0,0,,Сонда сіз бәрін көре аласыз ба?
Dialogue: 0,0:13:26.13,0:13:29.44,Default,,0,0,0,,Міне. Тыныш бол және мені тыңда.
Dialogue: 0,0:13:30.37,0:13:33.84,Default,,0,0,0,,Мен сізді бір ұяшық еместігіңіз үшін мақтаймын.
Dialogue: 0,0:13:35.04,0:13:37.28,Default,,0,0,0,,Бірақ сіз әлі түсінбеген сияқтысыз.
Dialogue: 0,0:13:37.88,0:13:38.81,Default,,0,0,0,,Не?
Dialogue: 0,0:13:39.55,0:13:41.48,Default,,0,0,0,,Сіздің жауыңыз кім?
Dialogue: 0,0:13:42.18,0:13:44.82,Default,,0,0,0,,Көзіңді аш, көр деймін.
Dialogue: 0,0:13:45.09,0:13:46.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:46.29,0:13:48.89,Default,,0,0,0,,Ойыңызда бірдеңе жоқ па?
Dialogue: 0,0:13:49.09,0:13:50.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:51.06,0:13:54.46,Default,,0,0,0,,Балалар мен сендерді мұқият тыңдауым керек сияқты.
Dialogue: 0,0:13:55.23,0:13:57.53,Default,,0,0,0,,Бірақ мұнда емес, бас кеңседе.
Dialogue: 0,0:13:58.20,0:14:01.57,Default,,0,0,0,,Сені осындай сасық жерге апарғаным үшін кешір.
Dialogue: 0,0:14:02.14,0:14:03.00,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:14:03.37,0:14:04.61,Default,,0,0,0,,Барлығын түсіріңіз.
Dialogue: 0,0:14:06.07,0:14:06.97,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:08.98,0:14:15.12,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:14:15.85,0:14:16.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:20.62,0:14:22.56,Default,,0,0,0,,(Оқ тиген дыбыс)
Dialogue: 0,0:14:23.56,0:14:24.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:26.63,0:14:30.16,Default,,0,0,0,,(Оқ тиген дыбыс)
Dialogue: 0,0:14:30.36,0:14:32.17,Default,,0,0,0,,Сақшылар мұнда не үшін?
Dialogue: 0,0:14:32.37,0:14:33.87,Default,,0,0,0,,Сіз бізді қамауға алмақшысыз ба?
Dialogue: 0,0:14:34.50,0:14:37.91,Default,,0,0,0,,Жоқ, олар бізді өлтірмекші.
Dialogue: 0,0:14:39.21,0:14:39.91,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:40.14,0:14:41.04,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:41.14,0:14:43.58,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:44.08,0:14:45.08,Default,,0,0,0,,Уф
Dialogue: 0,0:14:45.31,0:14:46.21,Default,,0,0,0,,Джеронимо!
Dialogue: 0,0:14:46.51,0:14:48.18,Default,,0,0,0,,Ха, Джеронимо...
Dialogue: 0,0:14:50.12,0:14:51.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:52.62,0:14:54.99,Default,,0,0,0,,Сіз әділдік жауынгерісіз
Dialogue: 0,0:14:56.39,0:14:58.39,Default,,0,0,0,,Мен саған сенемін, Джо.
Dialogue: 0,0:15:02.46,0:15:04.67,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:15:06.00,0:15:07.43,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:08.44,0:15:09.50,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:10.94,0:15:12.17,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:15:12.97,0:15:15.44,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:15:17.18,0:15:18.45,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:15:18.98,0:15:20.21,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:15:21.35,0:15:24.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:26.32,0:15:27.32,Default,,0,0,0,,(009 тыныс алуы)
Dialogue: 0,0:15:27.45,0:15:31.29,Default,,0,0,0,,Қазіргі денеммен бір оқ тисе, өлемін.
Dialogue: 0,0:15:32.26,0:15:33.66,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:15:33.93,0:15:34.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:42.94,0:15:44.04,Default,,0,0,0,,Достар...
Dialogue: 0,0:15:45.54,0:15:47.04,Default,,0,0,0,,Достарды жалғыз қалдыра алмайды
Dialogue: 0,0:15:47.34,0:15:48.61,Default,,0,0,0,,Джо, жоқ.
Dialogue: 0,0:15:49.34,0:15:52.28,Default,,0,0,0,,Бұл сіздің жауабыңыз ба?
Dialogue: 0,0:15:52.55,0:15:53.98,Default,,0,0,0,,Уф (003) Ах...
Dialogue: 0,0:15:54.15,0:15:55.15,Default,,0,0,0,,Джо!
Dialogue: 0,0:15:56.32,0:15:57.25,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:58.55,0:16:00.29,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:16:00.49,0:16:01.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:02.59,0:16:04.96,Default,,0,0,0,,Джеронимо Мен де күресемін
Dialogue: 0,0:16:05.26,0:16:06.13,Default,,0,0,0,,Джо
Dialogue: 0,0:16:06.59,0:16:08.10,Default,,0,0,0,,Уау
Dialogue: 0,0:16:08.63,0:16:10.16,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:10.50,0:16:11.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:13.60,0:16:14.60,Default,,0,0,0,,Ммм
Dialogue: 0,0:16:17.44,0:16:19.57,Default,,0,0,0,,Хмм уау
Dialogue: 0,0:16:20.51,0:16:21.54,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:16:23.11,0:16:24.14,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:16:24.28,0:16:25.28,Default,,0,0,0,,Гррр…
Dialogue: 0,0:16:26.51,0:16:28.48,Default,,0,0,0,,Франсуа Қаш!
Dialogue: 0,0:16:31.35,0:16:32.29,Default,,0,0,0,,Уф
Dialogue: 0,0:16:33.35,0:16:34.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:34.76,0:16:36.36,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:16:37.29,0:16:38.69,Default,,0,0,0,,(003 тыныс алуы)
Dialogue: 0,0:16:44.50,0:16:46.37,Default,,0,0,0,,(Соқтығысқан дыбыс)
Dialogue: 0,0:16:46.43,0:16:47.47,Default,,0,0,0,,Уф
Dialogue: 0,0:16:47.74,0:16:49.50,Default,,0,0,0,,Қарғыс атсын, бұл жайсыздық.
Dialogue: 0,0:16:49.60,0:16:51.27,Default,,0,0,0,,Уф... аааа
Dialogue: 0,0:16:51.57,0:16:53.74,Default,,0,0,0,,Міне, 002
Dialogue: 0,0:16:55.21,0:16:56.74,Default,,0,0,0,,Хмм?
Dialogue: 0,0:17:04.52,0:17:07.05,Default,,0,0,0,,Уууу
Dialogue: 0,0:17:14.70,0:17:15.73,Default,,0,0,0,,Үдеткіш
Dialogue: 0,0:17:26.71,0:17:27.81,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:33.11,0:17:35.12,Default,,0,0,0,,Бұл мен қалаған болашақ па?
Dialogue: 0,0:17:36.32,0:17:37.79,Default,,0,0,0,,Бұл жауап па?
Dialogue: 0,0:17:39.49,0:17:43.69,Default,,0,0,0,,(өткен оқтың дыбысы)
Dialogue: 0,0:17:46.69,0:17:48.83,Default,,0,0,0,,Жоқ, бұлай болмауы керек.
Dialogue: 0,0:17:49.53,0:17:52.50,Default,,0,0,0,,Мен барлығын ұрыстан құтқарғым келді.
Dialogue: 0,0:17:54.74,0:17:56.34,Default,,0,0,0,,Франсуа!
Dialogue: 0,0:18:39.41,0:18:40.55,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:41.52,0:18:42.22,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:18:43.25,0:18:44.12,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:18:44.62,0:18:45.52,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:46.19,0:18:48.19,Default,,0,0,0,,Иә? Ал қазір ше?
Dialogue: 0,0:18:49.32,0:18:50.39,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:18:52.53,0:18:53.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:54.50,0:18:56.46,Default,,0,0,0,,Рахмет Джо
Dialogue: 0,0:18:56.56,0:18:57.53,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:18:58.37,0:19:02.20,Default,,0,0,0,,Енді мен бірінші рет үдеткіш алғым келді.
Dialogue: 0,0:19:03.84,0:19:06.81,Default,,0,0,0,,Бұл сіз берген жауап па?
Dialogue: 0,0:19:07.67,0:19:08.41,Default,,0,0,0,,О
Dialogue: 0,0:19:09.61,0:19:12.78,Default,,0,0,0,,Бізге соғысу керек пе?
Dialogue: 0,0:19:13.81,0:19:14.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:15.38,0:19:16.55,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:19:17.45,0:19:18.55,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:19:18.62,0:19:19.39,Default,,0,0,0,,Уф
Dialogue: 0,0:19:19.85,0:19:21.16,Default,,0,0,0,,Ei
Dialogue: 0,0:19:21.66,0:19:22.52,Default,,0,0,0,,Уф
Dialogue: 0,0:19:23.62,0:19:24.56,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:19:25.43,0:19:26.19,Default,,0,0,0,,Ки-иииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииии
Dialogue: 0,0:19:27.16,0:19:28.66,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:19:36.17,0:19:37.80,Default,,0,0,0,,Сен қайтып келдің, Джо.
Dialogue: 0,0:19:38.81,0:19:39.67,Default,,0,0,0,,О
Dialogue: 0,0:19:40.41,0:19:42.68,Default,,0,0,0,,Мазалағаным үшін кешіріңіз, Джеронимо.
Dialogue: 0,0:19:44.24,0:19:46.45,Default,,0,0,0,,Жауап алдыңыз ба?
Dialogue: 0,0:19:46.55,0:19:47.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:48.42,0:19:49.95,Default,,0,0,0,,Джо Шимамура
Dialogue: 0,0:19:51.95,0:19:53.45,Default,,0,0,0,,Денеңізді өзгерте алсаңыз да...
Dialogue: 0,0:19:54.35,0:19:56.39,Default,,0,0,0,,Біздің жүрегімізді ешкім өзгерте алмайды
Dialogue: 0,0:19:58.83,0:20:00.76,Default,,0,0,0,,Егер бұл сіз үшін маңызды адамды қорғау үшін болса...
Dialogue: 0,0:20:01.36,0:20:03.40,Default,,0,0,0,,Бұл дене, осы күш...
Dialogue: 0,0:20:04.93,0:20:06.53,Default,,0,0,0,,Бұл менің құнды бөлігім.
Dialogue: 0,0:20:09.60,0:20:13.21,Default,,0,0,0,,Ұрыс болмайтын сияқты.
Dialogue: 0,0:20:13.54,0:20:14.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:14.94,0:20:15.81,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:17.68,0:20:21.32,Default,,0,0,0,,Жүрегіңді тыңда 009
Dialogue: 0,0:20:21.78,0:20:22.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:22.75,0:20:23.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:27.59,0:20:28.52,Default,,0,0,0,,Ах
Dialogue: 0,0:20:29.76,0:20:31.26,Default,,0,0,0,,Оның күші...
Dialogue: 0,0:20:32.26,0:20:34.53,Default,,0,0,0,,Жүрегіңде ұйықтап жатқан күдіктерді жарықтандыру
Dialogue: 0,0:20:35.23,0:20:38.30,Default,,0,0,0,,Ол сізге аян көрсетіп, таңдау жасауға бағыттайды.
Dialogue: 0,0:20:39.53,0:20:42.27,Default,,0,0,0,,Тіпті бұл ауырсыну галлюцинация болды ма?
Dialogue: 0,0:20:43.40,0:20:44.34,Default,,0,0,0,,Хмм. Нацу-кун, сен жақсы көрінесің.
Dialogue: 0,0:20:47.74,0:20:48.64,Default,,0,0,0,,Ах
Dialogue: 0,0:20:57.99,0:21:01.92,Default,,0,0,0,,Оның қуаты тек үдеткішпен жабдықталғандықтан ғана емес.
Dialogue: 0,0:21:01.99,0:21:03.42,Default,,0,0,0,,Түсініксіз
Dialogue: 0,0:21:10.00,0:21:11.47,Default,,0,0,0,,Ммм...
Dialogue: 0,0:21:14.64,0:21:16.34,Default,,0,0,0,,Джет Чжанжан көлі
Dialogue: 0,0:21:17.00,0:21:18.64,Default,,0,0,0,,Пюнма кешіріңіз
Dialogue: 0,0:21:18.91,0:21:20.77,Default,,0,0,0,,Себебі Джет келіссөздер жүргізуде нашар...
Dialogue: 0,0:21:20.91,0:21:22.78,Default,,0,0,0,,Бұл жаман болды. Мен келіссөздер жүргізуде нашармын.
Dialogue: 0,0:21:22.88,0:21:24.38,Default,,0,0,0,,Ахх...
Dialogue: 0,0:21:25.05,0:21:26.38,Default,,0,0,0,,Барлығын өзіңізбен бірге алыңыз.
Dialogue: 0,0:21:26.45,0:21:27.35,Default,,0,0,0,,Ах... хмм.
Dialogue: 0,0:21:27.41,0:21:28.85,Default,,0,0,0,,О
Dialogue: 0,0:21:28.92,0:21:32.65,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,0:21:32.92,0:21:34.99,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:21:35.99,0:21:37.39,Default,,0,0,0,,Уа, ау (Люси) Уа, ау...
Dialogue: 0,0:21:37.46,0:21:38.99,Default,,0,0,0,,Уф... Уау (Люси) Уф
Dialogue: 0,0:21:39.73,0:21:41.60,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:21:42.60,0:21:43.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:44.56,0:21:47.87,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:21:48.04,0:21:49.44,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,0:21:49.54,0:21:50.07,Default,,0,0,0,,Құтты болсын?
Dialogue: 0,0:21:50.37,0:21:50.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:51.31,0:21:51.84,Default,,0,0,0,,Не?
Dialogue: 0,0:21:51.94,0:21:52.87,Default,,0,0,0,,Уф (Игараши) Уф
Dialogue: 0,0:21:56.68,0:21:59.71,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:22:00.35,0:22:02.42,Default,,0,0,0,,Осыны шеш, мен саған еремін.
Dialogue: 0,0:22:03.55,0:22:04.48,Default,,0,0,0,,Джо
Dialogue: 0,0:22:04.79,0:22:05.89,Default,,0,0,0,,Не болды? ағын
Dialogue: 0,0:22:06.05,0:22:07.62,Default,,0,0,0,,Иванды ұрлап кетті!
Dialogue: 0,0:22:07.69,0:22:08.56,Default,,0,0,0,,(Барлығының таңданған дауысы)
Dialogue: 0,0:22:08.62,0:22:09.59,Default,,0,0,0,,Не?
Dialogue: 0,0:22:09.69,0:22:11.09,Default,,0,0,0,,Джо, жүре бер.
Dialogue: 0,0:22:11.73,0:22:13.03,Default,,0,0,0,,Дельфин 3-ке асығыңыз
Dialogue: 0,0:22:13.69,0:22:14.56,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:22:15.50,0:22:16.80,Default,,0,0,0,,Үдеткіш
Dialogue: 0,0:22:16.86,0:22:19.63,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:22:24.54,0:22:25.81,Default,,0,0,0,,Енді ойлануға болмайды
Dialogue: 0,0:22:26.71,0:22:28.64,Default,,0,0,0,,Барлығыңыз күтіңіздер.
Dialogue: 0,0:22:30.14,0:22:36.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory