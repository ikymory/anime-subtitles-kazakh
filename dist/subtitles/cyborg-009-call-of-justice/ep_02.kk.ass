Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:38.19,0:01:41.76,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:01:43.47,0:01:45.83,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:02:02.25,0:02:05.42,Default,,0,0,0,,(бұршақтың жауған дыбысы)
Dialogue: 0,0:02:06.39,0:02:09.32,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:02:09.66,0:02:12.13,Default,,0,0,0,,Ой... а
Dialogue: 0,0:02:12.23,0:02:15.16,Default,,0,0,0,,Әй, қалай ойласаң да, бұл табиғи құбылыс емес.
Dialogue: 0,0:02:15.33,0:02:17.57,Default,,0,0,0,,Табиғат құбылысына байланысты мұз бізге... бағытталған.
Dialogue: 0,0:02:17.63,0:02:19.60,Default,,0,0,0,,Жаңбырдың көп жауғаны сонша, мен оған тоймаймын.
Dialogue: 0,0:02:19.67,0:02:20.37,Default,,0,0,0,,Уф... (006) Ахх
Dialogue: 0,0:02:20.67,0:02:21.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:22.40,0:02:24.17,Default,,0,0,0,,Уф... (Франсуа: 003) Уф...
Dialogue: 0,0:02:27.64,0:02:29.34,Default,,0,0,0,,(Мұздың жарылған дыбысы)
Dialogue: 0,0:02:30.51,0:02:32.65,Default,,0,0,0,,Барлығыңыз, ішке асығыңыздар!
Dialogue: 0,0:02:35.18,0:02:35.88,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:40.69,0:02:42.32,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:02:42.42,0:02:44.29,Default,,0,0,0,,Мен оны әкемнен естідім...
Dialogue: 0,0:02:45.49,0:02:47.63,Default,,0,0,0,,Сенің шынымен де мұндай нәрсені жасай алатыныңа сене алмаймын.
Dialogue: 0,0:02:49.36,0:02:50.50,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:02:50.63,0:02:51.90,Default,,0,0,0,,(еденнің түсу дыбысы)
Dialogue: 0,0:02:52.23,0:02:53.23,Default,,0,0,0,,Ха...
Dialogue: 0,0:02:54.47,0:02:57.21,Default,,0,0,0,,Жарайды, уайымдама.
Dialogue: 0,0:03:08.85,0:03:10.32,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:20.40,0:03:21.50,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:03:21.80,0:03:22.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.43,0:03:26.40,Default,,0,0,0,,«Реакция жоқ»
Dialogue: 0,0:03:26.40,0:03:28.24,Default,,0,0,0,,«Реакция жоқ»
Dialogue: 0,0:03:26.40,0:03:28.24,Default,,0,0,0,,Дауылдың әсерінен
Dialogue: 0,0:03:28.24,0:03:28.34,Default,,0,0,0,,«Реакция жоқ»
Dialogue: 0,0:03:28.34,0:03:30.67,Default,,0,0,0,,«Реакция жоқ»
Dialogue: 0,0:03:28.34,0:03:30.67,Default,,0,0,0,,Камера мен сенсор жұмыс істемейді
Dialogue: 0,0:03:30.67,0:03:31.24,Default,,0,0,0,,«Реакция жоқ»
Dialogue: 0,0:03:31.24,0:03:32.44,Default,,0,0,0,,«Реакция жоқ»
Dialogue: 0,0:03:31.24,0:03:32.44,Default,,0,0,0,,Инфрақызыл сәуле де сенімсіз.
Dialogue: 0,0:03:32.44,0:03:32.67,Default,,0,0,0,,Инфрақызыл сәуле де сенімсіз.
Dialogue: 0,0:03:33.78,0:03:36.68,Default,,0,0,0,,Жерге орнатылған қысымға сезімтал сенсорға жауап жоқ.
Dialogue: 0,0:03:37.95,0:03:41.52,Default,,0,0,0,,Бірақ ауа райын жасанды түрде жасап жатқан жау болуы керек.
Dialogue: 0,0:03:42.32,0:03:45.69,Default,,0,0,0,,Қашықтан басқару құралы болса да, оны бір жерде бақылау керек...
Dialogue: 0,0:03:45.85,0:03:47.69,Default,,0,0,0,,Сіз дәл көздей алмайсыз.
Dialogue: 0,0:03:48.26,0:03:50.69,Default,,0,0,0,,Егер солай болса, онда сіздің ойыңызға аспан ғана келеді.
Dialogue: 0,0:03:51.76,0:03:54.66,Default,,0,0,0,,Аспандағы суперклетканың ішінде?
Dialogue: 0,0:03:54.76,0:03:56.00,Default,,0,0,0,,Уа, Алла тағала!
Dialogue: 0,0:03:56.76,0:03:58.60,Default,,0,0,0,,Бұған дейін, мырзалар.
Dialogue: 0,0:04:02.60,0:04:04.31,Default,,0,0,0,,Бұл қажет шығар
Dialogue: 0,0:04:26.73,0:04:27.60,Default,,0,0,0,,Ах
Dialogue: 0,0:04:38.57,0:04:40.98,Default,,0,0,0,,Мен ешқашан жауынгерлік форма киемін деп ойламадым.
Dialogue: 0,0:04:42.04,0:04:42.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:48.55,0:04:50.32,Default,,0,0,0,,(ұшып бара жатқан дыбыс)
Dialogue: 0,0:05:06.30,0:05:07.37,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:05:11.47,0:05:12.37,Default,,0,0,0,,(бұлт арқылы өтетін дыбыс)
Dialogue: 0,0:05:15.38,0:05:16.08,Default,,0,0,0,,Не?
Dialogue: 0,0:05:17.71,0:05:20.35,Default,,0,0,0,,Температура бұлттардың дәл үстінде өте жоғары.
Dialogue: 0,0:05:21.78,0:05:23.35,Default,,0,0,0,,Барлық арналар ашық
Dialogue: 0,0:05:23.55,0:05:24.49,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:24.75,0:05:29.69,Default,,0,0,0,,Алдымен, 005 006 007, жем ретінде әрекет етіңіз.
Dialogue: 0,0:05:29.96,0:05:33.93,Default,,0,0,0,,Мен білсем де нысанаға алынғанды ​​ұнатпаймын.
Dialogue: 0,0:05:34.36,0:05:36.90,Default,,0,0,0,,Біз бәрібір осындай рөлді ойнауымыз керек.
Dialogue: 0,0:05:37.70,0:05:40.40,Default,,0,0,0,,008 003 қорғауды сұрайды
Dialogue: 0,0:05:40.80,0:05:44.71,Default,,0,0,0,,003 жауларды көзімен және құлағымен тікелей жерден іздейді
Dialogue: 0,0:05:45.44,0:05:48.61,Default,,0,0,0,,Дауыл кезіндегі температура мен ауа ағынының минуттық өзгерістерін қадағалаңыз.
Dialogue: 0,0:05:49.41,0:05:51.58,Default,,0,0,0,,002 сол жерден жауларды іздейді
Dialogue: 0,0:05:51.68,0:05:52.65,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:05:53.75,0:05:56.82,Default,,0,0,0,,Мергендік 004 және 009 рөлі.
Dialogue: 0,0:05:57.95,0:06:01.42,Default,,0,0,0,,Менің артымнан олар келе ме?
Dialogue: 0,0:06:01.89,0:06:03.42,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:06.43,0:06:09.46,Default,,0,0,0,,Бұл шығаратын радиотолқындар себеп болуы мүмкін.
Dialogue: 0,0:06:09.60,0:06:11.43,Default,,0,0,0,,Мен де бейқам болдым.
Dialogue: 0,0:06:12.10,0:06:13.74,Default,,0,0,0,,Бүгінгі жалға берілетін көліктер...
Dialogue: 0,0:06:13.84,0:06:16.84,Default,,0,0,0,,Көбінде ұрлықтың алдын алу үшін орналасқан жер туралы ақпарат қызметтері бар.
Dialogue: 0,0:06:17.41,0:06:19.01,Default,,0,0,0,,Басынан бастап, Мисс Дэвенпорт...
Dialogue: 0,0:06:19.07,0:06:21.44,Default,,0,0,0,,Мүмкін ол бұзылған шығар, білмеймін.
Dialogue: 0,0:06:21.71,0:06:24.08,Default,,0,0,0,,Сонымен, әуежайдан осы жерге...
Dialogue: 0,0:06:24.38,0:06:26.71,Default,,0,0,0,,Бұл менің әрекеттерім абайсызда болды дегенді білдіре ме?
Dialogue: 0,0:06:27.05,0:06:29.78,Default,,0,0,0,,Осылай ойлаған дұрыс болар еді.
Dialogue: 0,0:06:30.59,0:06:33.86,Default,,0,0,0,,Бұл нысанды анықтаған кезде ол шабуыл жасады...\NМенің ойымша, бұл
Dialogue: 0,0:06:33.96,0:06:35.56,Default,,0,0,0,,...
Dialogue: 0,0:06:36.12,0:06:36.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:38.59,0:06:42.00,Default,,0,0,0,,Бұл соншалықты ақымақтық, ол сені журналист болу құқығынан айырады.
Dialogue: 0,0:06:43.53,0:06:44.63,Default,,0,0,0,,Жұмыс басталады.
Dialogue: 0,0:06:44.83,0:06:45.53,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:06:45.80,0:06:47.14,Default,,0,0,0,,Ей, кеттік.
Dialogue: 0,0:06:47.44,0:06:48.54,Default,,0,0,0,,Үмітсіз Аль
Dialogue: 0,0:06:48.84,0:06:50.84,Default,,0,0,0,,Уф (007) Ха ха...
Dialogue: 0,0:06:50.94,0:06:51.94,Default,,0,0,0,,Уау (007) Әй...
Dialogue: 0,0:06:52.01,0:06:54.54,Default,,0,0,0,,(бұршақтың дыбысы)
Dialogue: 0,0:06:55.98,0:06:56.94,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:06:58.05,0:07:00.85,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,0:07:02.88,0:07:03.89,Default,,0,0,0,,Уф
Dialogue: 0,0:07:03.99,0:07:04.85,Default,,0,0,0,,(мұздың жарылған дыбысы)
Dialogue: 0,0:07:08.62,0:07:11.09,Default,,0,0,0,,(қатып қалған дыбыс)
Dialogue: 0,0:07:13.16,0:07:17.03,Default,,0,0,0,,002 003 Асығыңыздар!
Dialogue: 0,0:07:18.93,0:07:19.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:20.60,0:07:21.64,Default,,0,0,0,,Мен естідім.
Dialogue: 0,0:07:23.97,0:07:25.04,Default,,0,0,0,,Оны таптым!
Dialogue: 0,0:07:25.64,0:07:26.64,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:07:26.71,0:07:27.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:33.01,0:07:34.75,Default,,0,0,0,,(Зымыран ұшыру дыбысы)
Dialogue: 0,0:07:38.99,0:07:39.92,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:07:43.49,0:07:46.83,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:07:54.54,0:07:55.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:02.24,0:08:03.74,Default,,0,0,0,,Ковбой?
Dialogue: 0,0:08:04.68,0:08:06.95,Default,,0,0,0,,Аспаннан мұз лақтырған ковбой...
Dialogue: 0,0:08:07.05,0:08:09.05,Default,,0,0,0,,Мен Аль туралы ешқашан естіген емеспін.
Dialogue: 0,0:08:09.15,0:08:10.15,Default,,0,0,0,,Әрине
Dialogue: 0,0:08:11.15,0:08:12.15,Default,,0,0,0,,Айя! (005) О...
Dialogue: 0,0:08:19.66,0:08:20.26,Default,,0,0,0,,Бұл… әлі біткен жоқ
Dialogue: 0,0:08:25.27,0:08:26.20,Default,,0,0,0,,Сол адам!
Dialogue: 0,0:08:30.10,0:08:31.91,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:08:33.21,0:08:34.61,Default,,0,0,0,,(006･007 айқайы)
Dialogue: 0,0:08:34.81,0:08:39.21,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:08:40.82,0:08:41.58,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:43.82,0:08:44.72,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:08:48.62,0:08:49.76,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:05.94,0:09:08.84,Default,,0,0,0,,Бұл Арнольд Нокс емес пе?
Dialogue: 0,0:09:09.31,0:09:10.01,Default,,0,0,0,,Иә
Dialogue: 0,0:09:10.75,0:09:12.68,Default,,0,0,0,,Техастағы ең бай адам
Dialogue: 0,0:09:13.15,0:09:15.25,Default,,0,0,0,,Барлығың шабуыл жасамаңдар.
Dialogue: 0,0:09:15.92,0:09:17.02,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:09:18.65,0:09:19.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:25.66,0:09:26.76,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:09:36.20,0:09:39.27,Default,,0,0,0,,Күрсін... Бұл 009-ға көмектесті
Dialogue: 0,0:09:40.71,0:09:41.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:45.21,0:09:48.35,Default,,0,0,0,,Неге түсірмейсіз?
Dialogue: 0,0:09:51.79,0:09:52.29,Default,,0,0,0,,Га
Dialogue: 0,0:09:52.79,0:09:53.99,Default,,0,0,0,,Ах... (008) Уау
Dialogue: 0,0:09:54.99,0:09:56.26,Default,,0,0,0,,(Рей) Уу-хуу! (Эмма) Уау!
Dialogue: 0,0:09:58.26,0:09:59.09,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:09:59.16,0:10:00.60,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:10:02.70,0:10:03.20,Default,,0,0,0,,Ei...
Dialogue: 0,0:10:04.63,0:10:06.03,Default,,0,0,0,,Бұл қажетсіз көмек болды ма?
Dialogue: 0,0:10:06.10,0:10:06.80,Default,,0,0,0,,Әй
Dialogue: 0,0:10:09.97,0:10:10.94,Default,,0,0,0,,Хун
Dialogue: 0,0:10:11.74,0:10:13.81,Default,,0,0,0,,Сіздің арқаңызда көздеріңіз бар ма?
Dialogue: 0,0:10:15.08,0:10:16.08,Default,,0,0,0,,Бұл… әлі біткен жоқ
Dialogue: 0,0:10:17.04,0:10:20.21,Default,,0,0,0,,Маған Люси Дэвенпорт әкелген нәрсені беріңіз.
Dialogue: 0,0:10:20.68,0:10:21.22,Default,,0,0,0,,Әй! ?
Dialogue: 0,0:10:21.72,0:10:22.22,Default,,0,0,0,,Ах
Dialogue: 0,0:10:22.68,0:10:23.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:23.88,0:10:28.39,Default,,0,0,0,,Сонда мен сендерді тірі қалдырмаймын.
Dialogue: 0,0:10:28.89,0:10:30.66,Default,,0,0,0,,Киборгтар
Dialogue: 0,0:10:31.96,0:10:35.10,Default,,0,0,0,,Сіз бізбен не болып жатқанын шынымен білетін сияқтысыз.
Dialogue: 0,0:10:35.70,0:10:39.63,Default,,0,0,0,,Сөйтсе де ол қарапайым адамға ұқсайды...
Dialogue: 0,0:10:39.77,0:10:40.77,Default,,0,0,0,,Ей, жақсы шықты, жақсы шықты. Қорқып қалдың ба?
Dialogue: 0,0:10:41.04,0:10:43.10,Default,,0,0,0,,Оның не қалайтыны қызық.
Dialogue: 0,0:10:44.21,0:10:45.94,Default,,0,0,0,,Бірақ кейін сені Хол Хорсты өлтіргендей өлтіремін.
Dialogue: 0,0:10:49.11,0:10:50.41,Default,,0,0,0,,Сіздің жауабыңыз қандай?
Dialogue: 0,0:10:51.71,0:10:52.41,Default,,0,0,0,,Бас тарт!
Dialogue: 0,0:10:57.12,0:10:58.29,Default,,0,0,0,,Сосын өл.
Dialogue: 0,0:10:58.75,0:11:01.02,Default,,0,0,0,,Доктор Дэвенпорт сияқты
Dialogue: 0,0:11:01.36,0:11:02.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:18.84,0:11:20.11,Default,,0,0,0,,(Мұздың жарылған дыбысы)
Dialogue: 0,0:11:26.01,0:11:28.15,Default,,0,0,0,,Мұндай сиқырлы амалдар енді жұмыс істемейді!
Dialogue: 0,0:11:29.35,0:11:30.79,Default,,0,0,0,,Күрделі
Dialogue: 0,0:11:31.35,0:11:34.36,Default,,0,0,0,,Механикалық қуыршақ!
Dialogue: 0,0:11:34.96,0:11:35.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:36.19,0:11:36.89,Default,,0,0,0,,Не! ?
Dialogue: 0,0:11:37.12,0:11:40.86,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:11:41.26,0:11:42.30,Default,,0,0,0,,үдеткіш!
Dialogue: 0,0:11:42.40,0:11:43.90,Default,,0,0,0,,Уау
Dialogue: 0,0:11:45.93,0:11:46.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:47.90,0:11:49.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:49.94,0:11:52.37,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:54.04,0:11:58.18,Default,,0,0,0,,Қанша үдетсең де, найзағайдың жылдамдығына тең келе алмайсың.
Dialogue: 0,0:11:59.01,0:12:01.28,Default,,0,0,0,,Сіз мұны түсінбейсіз бе?
Dialogue: 0,0:12:02.72,0:12:03.75,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:12:04.92,0:12:06.29,Default,,0,0,0,,Әлі ұрған жоқ
Dialogue: 0,0:12:07.22,0:12:08.32,Default,,0,0,0,,О... дұрыс.
Dialogue: 0,0:12:16.43,0:12:20.07,Default,,0,0,0,,(Ауада қалқып тұрған дыбыс)
Dialogue: 0,0:12:24.31,0:12:27.84,Default,,0,0,0,,Жерде осылай созылған...
Dialogue: 0,0:12:28.08,0:12:31.15,Default,,0,0,0,,Балалар, сендер механикалық қуыршақтарға тамашасыңдар.
Dialogue: 0,0:12:33.45,0:12:35.12,Default,,0,0,0,,Қуыршақ емес
Dialogue: 0,0:12:38.09,0:12:39.79,Default,,0,0,0,,Біз адамбыз!
Dialogue: 0,0:12:43.02,0:12:46.36,Default,,0,0,0,,Жас ханым, бұл кім?
Dialogue: 0,0:12:47.19,0:12:48.30,Default,,0,0,0,,Құтты болсын
Dialogue: 0,0:12:48.53,0:12:49.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:50.76,0:12:51.50,Default,,0,0,0,,Құтты болсын
Dialogue: 0,0:12:52.13,0:12:53.87,Default,,0,0,0,,Берекелі
Dialogue: 0,0:12:54.34,0:12:55.97,Default,,0,0,0,,Әкем маған осылай атады.
Dialogue: 0,0:12:58.44,0:12:59.91,Default,,0,0,0,,Әкемнің айтуы бойынша...
Dialogue: 0,0:13:00.17,0:13:03.38,Default,,0,0,0,,Сонау ықылым заманнан үзіліссіз өмір сүріп келе жатқан жандар.
Dialogue: 0,0:13:04.21,0:13:06.05,Default,,0,0,0,,Өлмейтін тіршілік иесі
Dialogue: 0,0:13:07.11,0:13:09.85,Default,,0,0,0,,Дүние жүзіндегі мифтер мен аңыздарда берілген
Dialogue: 0,0:13:09.98,0:13:13.19,Default,,0,0,0,,Бұл ұзақ өмір сүретін түрдің шынайы тұлғасы.
Dialogue: 0,0:13:14.26,0:13:15.86,Default,,0,0,0,,Дэвенпорт ханым
Dialogue: 0,0:13:16.22,0:13:19.26,Default,,0,0,0,,Демек, өлмейтін жаратылыс болса...
Dialogue: 0,0:13:19.46,0:13:23.00,Default,,0,0,0,,Неліктен осы уақытқа дейін оның бар екенін ешкім білмеді?
Dialogue: 0,0:13:23.36,0:13:24.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:25.87,0:13:29.07,Default,,0,0,0,,Өйткені олар әлемді көлеңкеден басқарды!
Dialogue: 0,0:13:30.40,0:13:32.07,Default,,0,0,0,,Дэвенпорт ханым
Dialogue: 0,0:13:32.47,0:13:34.31,Default,,0,0,0,,Алдымдағы құбыжықпен...
Dialogue: 0,0:13:34.41,0:13:38.15,Default,,0,0,0,,Көлеңкеден әлемді басқаратын Бақыттылар арасында...
Dialogue: 0,0:13:38.25,0:13:40.38,Default,,0,0,0,,Бұл тым көп секіріс емес пе?
Dialogue: 0,0:13:41.42,0:13:42.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:43.08,0:13:45.85,Default,,0,0,0,,Сіз өте қызықты оқиғаны айтып отырсыз.
Dialogue: 0,0:13:45.95,0:13:47.29,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:13:48.12,0:13:50.59,Default,,0,0,0,,Біз дәл қазір ең білгіміз келетін нәрсе...
Dialogue: 0,0:13:50.86,0:13:52.59,Default,,0,0,0,,Бұл оның шығу тегі немесе жеке басы туралы емес...
Dialogue: 0,0:13:53.03,0:13:55.36,Default,,0,0,0,,Бұл оны тоқтатудың бір жолы.
Dialogue: 0,0:13:56.10,0:13:58.20,Default,,0,0,0,,Күміс оқ, қасиетті су, т.б.
Dialogue: 0,0:13:58.40,0:14:01.04,Default,,0,0,0,,Осы уақытта кез келген оккультизм құпталады.
Dialogue: 0,0:14:01.10,0:14:01.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:02.60,0:14:03.60,Default,,0,0,0,,Қазірге дейін мен—
Dialogue: 0,0:14:04.61,0:14:05.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:16.55,0:14:17.48,Default,,0,0,0,,Уау
Dialogue: 0,0:14:19.99,0:14:20.99,Default,,0,0,0,,002！
Dialogue: 0,0:14:21.22,0:14:21.92,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:23.06,0:14:23.62,Default,,0,0,0,,Ха...
Dialogue: 0,0:14:24.46,0:14:26.33,Default,,0,0,0,,Ах, ой... (003) Ах...
Dialogue: 0,0:14:30.03,0:14:31.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:33.20,0:14:34.07,Default,,0,0,0,,Джо!
Dialogue: 0,0:14:35.90,0:14:38.41,Default,,0,0,0,,Мен бүгін ғана кездестірген әйел...
Dialogue: 0,0:14:38.61,0:14:41.48,Default,,0,0,0,,Неліктен оны қорғау үшін көп нәрсеге барасыз?
Dialogue: 0,0:14:41.58,0:14:42.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:45.28,0:14:48.02,Default,,0,0,0,,Сіз адамдарды қиыншылықта жалғыз қалдыра алмайсыз.
Dialogue: 0,0:14:49.05,0:14:51.42,Default,,0,0,0,,Бұл өте қисынсыз.
Dialogue: 0,0:14:52.65,0:14:54.49,Default,,0,0,0,,Логикалық мінез-құлық...
Dialogue: 0,0:14:55.09,0:14:57.09,Default,,0,0,0,,Әрқашан дұрыс емес
Dialogue: 0,0:14:58.06,0:14:59.36,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:14:59.89,0:15:02.56,Default,,0,0,0,,Бұл механикалық ғана емес, сонымен қатар мылқау.
Dialogue: 0,0:15:03.46,0:15:04.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:06.20,0:15:06.93,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:15:07.37,0:15:09.64,Default,,0,0,0,,Әзірше мен сені жерге түсіруім керек.
Dialogue: 0,0:15:10.10,0:15:10.97,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:13.34,0:15:14.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:14.64,0:15:15.51,Default,,0,0,0,,Уау
Dialogue: 0,0:15:17.38,0:15:18.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:22.65,0:15:23.55,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:15:24.29,0:15:24.99,Default,,0,0,0,,Уау
Dialogue: 0,0:15:25.09,0:15:26.15,Default,,0,0,0,,002！
Dialogue: 0,0:15:26.25,0:15:27.09,Default,,0,0,0,,001…
Dialogue: 0,0:15:27.62,0:15:30.12,Default,,0,0,0,,Ол біздің қозғалыстарымызды қалай оқи алады?
Dialogue: 0,0:15:31.09,0:15:33.93,Default,,0,0,0,,Бұл ауа ағынындағы турбуленттілікті сезінуі мүмкін.
Dialogue: 0,0:15:34.53,0:15:36.26,Default,,0,0,0,,Температураның кенет өзгеруі...
Dialogue: 0,0:15:36.36,0:15:40.20,Default,,0,0,0,,Бұл атмосфералық молекулалардың қозғалыс бағыттарын теңестіру арқылы мүмкін болады.
Dialogue: 0,0:15:41.67,0:15:43.44,Default,,0,0,0,,Жанама өнім ретінде-
Dialogue: 0,0:15:43.54,0:15:45.57,Default,,0,0,0,,Қатты желді басқару кезінде
Dialogue: 0,0:15:46.04,0:15:47.51,Default,,0,0,0,,Картоп, бұл емес...
Dialogue: 0,0:15:47.57,0:15:50.18,Default,,0,0,0,,Максвеллдің шайтаны іске қосылмайынша...
Dialogue: 0,0:15:50.28,0:15:52.01,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:15:52.58,0:15:54.58,Default,,0,0,0,,Дұрыс айтасыз, доктор.
Dialogue: 0,0:15:55.52,0:15:59.22,Default,,0,0,0,,Ол айналасындағы барлық атмосфералық молекулалардың қозғалысын түсінеді...
Dialogue: 0,0:15:59.95,0:16:01.46,Default,,0,0,0,,Ол бақылауда.
Dialogue: 0,0:16:02.06,0:16:05.23,Default,,0,0,0,,Біз киборгтар да мұны істей алмаймыз, Аль.
Dialogue: 0,0:16:06.09,0:16:08.56,Default,,0,0,0,,Шынында да, бұл қалай болуы мүмкін?
Dialogue: 0,0:16:08.96,0:16:11.67,Default,,0,0,0,,Менің ойымша, бұл телекинездің бір түрі шығар.
Dialogue: 0,0:16:12.47,0:16:15.14,Default,,0,0,0,,Жау – экстрасенс
Dialogue: 0,0:16:16.47,0:16:19.44,Default,,0,0,0,,001 гипотеза дұрыс болса...
Dialogue: 0,0:16:19.54,0:16:22.64,Default,,0,0,0,,Қарсылас энтропияны азайта ма?
Dialogue: 0,0:16:23.18,0:16:24.35,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:16:25.18,0:16:26.41,Default,,0,0,0,,Бірақ бұл жағдайда —
Dialogue: 0,0:16:26.51,0:16:29.25,Default,,0,0,0,,Энтропия бір жерде өсу керек.
Dialogue: 0,0:16:29.35,0:16:31.15,Default,,0,0,0,,Уф, бұл...
Dialogue: 0,0:16:31.75,0:16:35.49,Default,,0,0,0,,Бұл бұлттардың үстінде мен тапқан өте жоғары температура қабаты ма?
Dialogue: 0,0:16:35.72,0:16:37.56,Default,,0,0,0,,Міне, сөзсіз!
Dialogue: 0,0:16:38.59,0:16:39.59,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:16:40.36,0:16:43.26,Default,,0,0,0,,002 Маған бірдеңеде көмек керек.
Dialogue: 0,0:16:43.50,0:16:44.20,Default,,0,0,0,,Не?
Dialogue: 0,0:16:44.70,0:16:47.74,Default,,0,0,0,,Сіз жасырын не туралы айттыңыз?
Dialogue: 0,0:16:48.47,0:16:50.37,Default,,0,0,0,,Механикалық қуыршақтар
Dialogue: 0,0:16:51.07,0:16:52.74,Default,,0,0,0,,Мен сені қалай тоқтата аламын?
Dialogue: 0,0:16:56.21,0:16:59.51,Default,,0,0,0,,Сіз үлкен шықтыңыз. Сіз өкінесіз.
Dialogue: 0,0:17:02.32,0:17:04.32,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,0:17:05.45,0:17:06.62,Default,,0,0,0,,005！
Dialogue: 0,0:17:07.49,0:17:08.26,Default,,0,0,0,,Ммм
Dialogue: 0,0:17:09.69,0:17:10.46,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:12.69,0:17:14.26,Default,,0,0,0,,(Темір таяқшаның пышақталған дыбысы)
Dialogue: 0,0:17:15.06,0:17:16.80,Default,,0,0,0,,Ол найзағай болуы керек пе?
Dialogue: 0,0:17:20.43,0:17:21.37,Default,,0,0,0,,002！
Dialogue: 0,0:17:21.70,0:17:23.24,Default,,0,0,0,,Менімен қозғалыстарыңызды сәйкестендіріңіз.
Dialogue: 0,0:17:23.74,0:17:24.71,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:17:39.55,0:17:41.66,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:17:42.42,0:17:44.26,Default,,0,0,0,,(Мұздың жарылған дыбысы)
Dialogue: 0,0:17:44.79,0:17:45.56,Default,,0,0,0,,Ммм
Dialogue: 0,0:17:46.53,0:17:47.53,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:47.76,0:17:49.70,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:17:50.06,0:17:52.30,Default,,0,0,0,,Ммм!
Dialogue: 0,0:18:02.84,0:18:05.15,Default,,0,0,0,,(ұшқан таяқтардың дыбысы)
Dialogue: 0,0:18:13.65,0:18:14.52,Default,,0,0,0,,үдеткіш!
Dialogue: 0,0:18:19.76,0:18:22.40,Default,,0,0,0,,(ағынды дыбыс)
Dialogue: 0,0:18:25.33,0:18:28.74,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:18:28.84,0:18:30.17,Default,,0,0,0,,1-мач!
Dialogue: 0,0:18:33.57,0:18:34.71,Default,,0,0,0,,2-мах!
Dialogue: 0,0:18:48.22,0:18:49.36,Default,,0,0,0,,006！
Dialogue: 0,0:18:49.89,0:18:51.23,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:18:51.59,0:18:53.39,Default,,0,0,0,,(Тыныс алу жалынының дыбысы)
Dialogue: 0,0:19:06.64,0:19:10.18,Default,,0,0,0,,(009 және 002 бұрылу дыбысы)
Dialogue: 0,0:19:46.38,0:19:48.22,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:52.75,0:19:56.29,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:20:17.28,0:20:18.88,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:20.35,0:20:23.35,Default,,0,0,0,,Жау энтропиялық теңгерімсіздікті пайдаланып отырды
Dialogue: 0,0:20:23.75,0:20:25.52,Default,,0,0,0,,Бірақ тұйық жүйеде -
Dialogue: 0,0:20:25.62,0:20:29.42,Default,,0,0,0,,Энтропия максимумға жетеді және өзгеруін тоқтатады.
Dialogue: 0,0:20:29.72,0:20:32.66,Default,,0,0,0,,Сонымен 009 және 002-
Dialogue: 0,0:20:32.76,0:20:35.26,Default,,0,0,0,,Атмосфераны соққы толқындарымен жабу -
Dialogue: 0,0:20:35.36,0:20:39.83,Default,,0,0,0,,Сіз жауыңыздың айналасында шағын жабық жүйе құрдыңыз.
Dialogue: 0,0:20:40.37,0:20:44.40,Default,,0,0,0,,Осылайша дауыл аз уақытта басылды.
Dialogue: 0,0:20:47.84,0:20:49.88,Default,,0,0,0,,Ол оңай өлді.
Dialogue: 0,0:20:50.81,0:20:53.68,Default,,0,0,0,,Бұл жігіт шынымен де атақты ма?
Dialogue: 0,0:20:55.42,0:20:58.35,Default,,0,0,0,,Әкем онымен қайтыс болғанға дейін араласқан.
Dialogue: 0,0:20:58.75,0:21:00.35,Default,,0,0,0,,Әкемді кім өлтірді...
Dialogue: 0,0:21:01.46,0:21:02.32,Default,,0,0,0,,Нокс
Dialogue: 0,0:21:02.42,0:21:02.92,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:21:04.29,0:21:06.46,Default,,0,0,0,,Әкемнің айтқаны дұрыс болды.
Dialogue: 0,0:21:08.33,0:21:11.87,Default,,0,0,0,,Адамзат қоғамының кіндігіндегі құтты ұя.
Dialogue: 0,0:21:15.44,0:21:17.40,Default,,0,0,0,,Басқа да көп нәрсе болды...
Dialogue: 0,0:21:17.67,0:21:19.91,Default,,0,0,0,,Ол менің жалға алған көлігіммен бірге өртеніп кетті...
Dialogue: 0,0:21:20.04,0:21:21.44,Default,,0,0,0,,Осының бәрі қалды
Dialogue: 0,0:21:23.34,0:21:24.54,Default,,0,0,0,,Сондай-ақ оны шешу -
Dialogue: 0,0:21:24.65,0:21:26.58,Default,,0,0,0,,Маған көмектесуіңізді қалаймын...
Dialogue: 0,0:21:26.65,0:21:27.91,Default,,0,0,0,,Бір ғана нәрсе
Dialogue: 0,0:21:29.38,0:21:30.55,Default,,0,0,0,,Мен енді мұны істей алмайтын сияқтымын
Dialogue: 0,0:21:30.82,0:21:31.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:37.99,0:21:38.86,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:21:39.79,0:21:40.93,Default,,0,0,0,,Әкем білді...
Dialogue: 0,0:21:40.99,0:21:42.53,Default,,0,0,0,,Батаның бөлігі
Dialogue: 0,0:21:44.43,0:21:45.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:55.04,0:21:57.51,Default,,0,0,0,,Атмосфераны басқару қабілеті бар біреу?
Dialogue: 0,0:21:58.95,0:22:00.88,Default,,0,0,0,,Ол керемет жігіт еді.
Dialogue: 0,0:22:01.58,0:22:04.75,Default,,0,0,0,,Ал мен бұрын ешқашан ұрысқан емеспін.
Dialogue: 0,0:22:05.49,0:22:07.92,Default,,0,0,0,,Сіз шынымен де осындай нәрсемен күресе аласыз ба?
Dialogue: 0,0:22:08.69,0:22:10.96,Default,,0,0,0,,Әлгі қыздың әңгімесі рас болса...
Dialogue: 0,0:22:11.06,0:22:14.73,Default,,0,0,0,,Ондай адамдардың әлі де көп екенін білдіреді.
Dialogue: 0,0:22:14.86,0:22:17.06,Default,,0,0,0,,Егер ол қайтадан шабуыл жасаса...
Dialogue: 0,0:22:19.77,0:22:22.47,Default,,0,0,0,,Джо мен қорқамын
Dialogue: 0,0:22:23.44,0:22:26.87,Default,,0,0,0,,Шайқас күндері қайтадан басталатын сияқты...
Dialogue: 0,0:22:28.37,0:22:34.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory