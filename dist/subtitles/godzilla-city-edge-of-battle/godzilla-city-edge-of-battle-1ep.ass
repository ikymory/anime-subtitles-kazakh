Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.20,0:00:19.95,Default,,0,0,0,,(Солдаттың ауыр тыныс алуы)
Dialogue: 0,0:00:20.04,0:00:23.83,Default,,0,0,0,,Десант толығымен жойылды, ал қалған күштер белгісіз!
Dialogue: 0,0:00:24.79,0:00:27.83,Default,,0,0,0,,Қарғыс атсын... операция сәтті өтті!
Dialogue: 0,0:00:27.91,0:00:31.50,Default,,0,0,0,,Бірақ кенеттен... басқа Годзилла!
Dialogue: 0,0:00:31.79,0:00:32.62,Default,,0,0,0,,(Байланысты ажырату дыбысы)
Dialogue: 0,0:00:32.70,0:00:35.20,Default,,0,0,0,,Содан бастап барлық байланыс үзіледі.
Dialogue: 0,0:00:37.00,0:00:39.08,Default,,0,0,0,,Жиналған ақпаратты талдаудың нәтижесі қандай?
Dialogue: 0,0:00:39.66,0:00:42.00,Default,,0,0,0,,Соңғы бейне жазба көрсетіледі.
Dialogue: 0,0:00:42.83,0:00:44.54,Default,,0,0,0,,На ба... ақымақ.
Dialogue: 0,0:00:44.95,0:00:49.25,Default,,0,0,0,,Есептелген биіктік: шамамен. 300 метр?
Dialogue: 0,0:00:49.45,0:00:50.41,Default,,0,0,0,,Тым үлкен
Dialogue: 0,0:00:50.50,0:00:51.87,Default,,0,0,0,,Қателік бар емес пе?
Dialogue: 0,0:00:52.54,0:00:53.75,Default,,0,0,0,,Дерекқормен салыстыру
Dialogue: 0,0:00:55.45,0:00:57.79,Default,,0,0,0,,Өткен деректермен 98%-дан астам келіседі
Dialogue: 0,0:00:58.00,0:00:58.83,Default,,0,0,0,,На
Dialogue: 0,0:01:00.62,0:01:03.25,Default,,0,0,0,,Бұл Годзилла.
Dialogue: 0,0:01:03.66,0:01:06.45,Default,,0,0,0,,20 000 жыл бойы өсе берді ме?
Dialogue: 0,0:01:06.54,0:01:08.45,Default,,0,0,0,,Ол өлмес пе?
Dialogue: 0,0:01:08.95,0:01:11.08,Default,,0,0,0,,Капитан Морли, біз не істеуіміз керек?
Dialogue: 0,0:01:11.16,0:01:12.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:12.25,0:01:14.25,Default,,0,0,0,,Бұл планетаға қайта оралу мүмкін емес.
Dialogue: 0,0:01:14.33,0:01:16.00,Default,,0,0,0,,Келесі ықтимал көшу сайтына қарай
Dialogue: 0,0:01:16.08,0:01:19.08,Default,,0,0,0,,А, айтпақшы, егер ол мына кемені байқаса...
Dialogue: 0,0:01:19.95,0:01:23.83,Default,,0,0,0,,Контроллер: Егер сол алып Годзилла жылу сәулесін түсірсе ше?
Dialogue: 0,0:01:23.91,0:01:25.41,Default,,0,0,0,,Ол қаншалықты күшті?
Dialogue: 0,0:01:25.58,0:01:27.66,Default,,0,0,0,,Есептелген массадан түрлендіру
Dialogue: 0,0:01:28.91,0:01:32.41,Default,,0,0,0,,Атмосфераны жарып өтіп, кемеге жетеді.
Dialogue: 0,0:01:32.70,0:01:33.66,Default,,0,0,0,,На
Dialogue: 0,0:01:34.50,0:01:37.04,Default,,0,0,0,,Олар бізді байқап, бізге шабуыл жасауы мүмкін.
Dialogue: 0,0:01:37.12,0:01:38.54,Default,,0,0,0,,Менің ойымша, бұл төмен.
Dialogue: 0,0:01:38.62,0:01:41.41,Default,,0,0,0,,Жердің спутниктік орбитасынан мүмкіндігінше тезірек кетіңіз.
Dialogue: 0,0:01:41.50,0:01:43.37,Default,,0,0,0,,Біз Ай орбитасына эвакуациялауымыз керек.
Dialogue: 0,0:01:43.45,0:01:44.79,Default,,0,0,0,,Сіз құтқару қайығын жібере алмайсыз!
Dialogue: 0,0:01:44.87,0:01:46.50,Default,,0,0,0,,Олар әлдеқашан жойылды!
Dialogue: 0,0:01:46.75,0:01:49.50,Default,,0,0,0,,Тірі қалу мүмкіндігі әлі де болуы керек.
Dialogue: 0,0:01:49.58,0:01:50.87,Default,,0,0,0,,Біз, Exif,
Dialogue: 0,0:01:50.95,0:01:53.87,Default,,0,0,0,,Тірі қалғандарды тастап кетуге қарсы
Dialogue: 0,0:01:54.91,0:01:57.12,Default,,0,0,0,,Ұшқышсыз ұшақтарды қолданатын десантшыларды іздеу
Dialogue: 0,0:01:57.20,0:01:58.41,Default,,0,0,0,,Біз мұны көтере алмаймыз!
Dialogue: 0,0:01:58.50,0:02:00.58,Default,,0,0,0,,Бұл капитанның шешімі! Ненің негізінде?
Dialogue: 0,0:02:01.00,0:02:02.41,Default,,0,0,0,,Дегенмен, (Дольд, бастықтың орынбасары) Иә?
Dialogue: 0,0:02:02.50,0:02:06.20,Default,,0,0,0,,48 сағат ішінде тірі қалғандар табылмаса
Dialogue: 0,0:02:07.29,0:02:08.91,Default,,0,0,0,,Жерді тастаңыз
Dialogue: 0,0:02:37.37,0:02:43.37,Default,,0,0,0,,♪~
Dialogue: 0,0:02:58.00,0:03:04.00,Default,,0,0,0,,~♪
Dialogue: 0,0:03:09.41,0:03:11.54,Default,,0,0,0,,А... а?
Dialogue: 0,0:03:13.16,0:03:14.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:16.29,0:03:17.62,Default,,0,0,0,,(сықырлаған ағаш)
Dialogue: 0,0:03:18.91,0:03:20.00,Default,,0,0,0,,(шу)
Dialogue: 0,0:03:22.08,0:03:23.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:30.41,0:03:31.41,Default,,0,0,0,,Ах
Dialogue: 0,0:03:35.08,0:03:36.33,Default,,0,0,0,,Жылжыту...
Dialogue: 0,0:03:36.62,0:03:38.79,Default,,0,0,0,,Ха, мен дем аламын.
Dialogue: 0,0:03:38.87,0:03:40.33,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:03:42.04,0:03:45.16,Default,,0,0,0,,Бұл... адам үйі ме?
Dialogue: 0,0:03:46.33,0:03:47.33,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:03:47.75,0:03:48.58,Default,,0,0,0,,Ах
Dialogue: 0,0:03:54.79,0:03:55.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:56.04,0:03:58.70,Default,,0,0,0,,Радио және позициялау жүйелері пайдасыз ба?
Dialogue: 0,0:04:03.16,0:04:06.91,Default,,0,0,0,,Әлі жұмақ та, тозақ та емес сияқты.
Dialogue: 0,0:04:10.58,0:04:11.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.50,0:04:12.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:13.00,0:04:14.04,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:15.12,0:04:15.95,Default,,0,0,0,,Ах
Dialogue: 0,0:04:18.12,0:04:20.66,Default,,0,0,0,,Адамдардың әлі тірі екені рас па?
Dialogue: 0,0:04:23.45,0:04:25.16,Default,,0,0,0,,Эй, күте тұр, күт!
Dialogue: 0,0:04:25.25,0:04:26.20,Default,,0,0,0,,Эй!
Dialogue: 0,0:04:38.12,0:04:40.79,Default,,0,0,0,,Тұман... түспейді.
Dialogue: 0,0:04:48.91,0:04:49.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:57.12,0:04:58.50,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:05:02.00,0:05:03.66,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:05:04.37,0:05:05.33,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:05:08.45,0:05:10.66,Default,,0,0,0,,Сіз бұл атмосферада жақсысыз ба?
Dialogue: 0,0:05:14.83,0:05:18.04,Default,,0,0,0,,20 000 жыл... Олар бейімделсе, таң қалмас еді.
Dialogue: 0,0:05:21.29,0:05:22.12,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:05:23.37,0:05:25.08,Default,,0,0,0,,Анаға есеп беру керек
Dialogue: 0,0:05:25.33,0:05:26.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:26.62,0:05:29.04,Default,,0,0,0,,Десанттық аппараттың байланыс жабдығы үшін
Dialogue: 0,0:05:32.00,0:05:35.16,Default,,0,0,0,,Қарғыс атқыр, сіз тек шамамен бағытты білесіз.
Dialogue: 0,0:05:54.33,0:05:56.66,Default,,0,0,0,,Метфи не істеді?
Dialogue: 0,0:05:56.95,0:05:59.16,Default,,0,0,0,,Юко Адам
Dialogue: 0,0:05:59.58,0:06:01.12,Default,,0,0,0,,Ha
Dialogue: 0,0:06:05.04,0:06:08.41,Default,,0,0,0,,Мені қусаң, мен сені тастаймын Мені тастасаң, мен сені қуамын...
Dialogue: 0,0:06:16.12,0:06:17.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:20.91,0:06:21.75,Default,,0,0,0,,Ах
Dialogue: 0,0:06:23.20,0:06:24.83,Default,,0,0,0,,Жылу көзінің реакциясы?
Dialogue: 0,0:06:25.37,0:06:26.79,Default,,0,0,0,,Десанттық кеме болуы мүмкін
Dialogue: 0,0:06:27.50,0:06:33.37,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:06:39.91,0:06:41.83,Default,,0,0,0,,А, а... Эй!
Dialogue: 0,0:06:42.16,0:06:43.12,Default,,0,0,0,,Не!
Dialogue: 0,0:06:44.54,0:06:45.50,Default,,0,0,0,,Сіз сөйледіңіз бе?
Dialogue: 0,0:06:45.58,0:06:48.12,Default,,0,0,0,,(Жоғары жиілікті дыбыс)
Dialogue: 0,0:06:48.20,0:06:50.08,Default,,0,0,0,,Ха, бұл қауіпті ме?
Dialogue: 0,0:06:50.62,0:06:51.45,Default,,0,0,0,,Не!
Dialogue: 0,0:06:54.41,0:06:57.16,Default,,0,0,0,,(Сельвамның айқайы)
Dialogue: 0,0:07:00.12,0:07:02.37,Default,,0,0,0,,Ах ха...
Dialogue: 0,0:07:03.79,0:07:05.50,Default,,0,0,0,,Меніңше, осы дүниеде соғыссыз өмір сүре алмайтын адамдар бар.
Dialogue: 0,0:07:05.91,0:07:07.70,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:07:15.75,0:07:17.70,Default,,0,0,0,,Мен Харуомын
Dialogue: 0,0:07:19.29,0:07:20.12,Default,,0,0,0,,Эй
Dialogue: 0,0:07:20.70,0:07:21.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:22.29,0:07:23.83,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:24.33,0:07:28.45,Default,,0,0,0,,Бұл Харуо.
Dialogue: 0,0:07:30.04,0:07:34.25,Default,,0,0,0,,Ha… le… oi
Dialogue: 0,0:07:34.83,0:07:38.00,Default,,0,0,0,,А, дұрыс, Харуо. Сен ше?
Dialogue: 0,0:07:38.08,0:07:40.20,Default,,0,0,0,,(Жоғары жиілікті дыбыс)
Dialogue: 0,0:07:40.29,0:07:41.66,Default,,0,0,0,,Бұл дыбыс
Dialogue: 0,0:07:42.25,0:07:44.12,Default,,0,0,0,,Әй, күте тұрыңыз.
Dialogue: 0,0:07:45.08,0:07:48.08,Default,,0,0,0,,Адамзаттың аман қалғандары бар ма?
Dialogue: 0,0:07:48.75,0:07:49.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:49.87,0:07:51.00,Default,,0,0,0,,Ах
Dialogue: 0,0:07:51.50,0:07:54.45,Default,,0,0,0,,Бұл сержант Юко Тани және тағы 3 адам. Біреу жауап беріңізші!
Dialogue: 0,0:07:54.70,0:07:56.70,Default,,0,0,0,,Юко... Юко!
Dialogue: 0,0:07:56.79,0:07:59.08,Default,,0,0,0,,А, Сенпай? Харуо-сенпай!
Dialogue: 0,0:07:59.16,0:08:01.37,Default,,0,0,0,,Ол әлі тірі. Тағы кім бар?
Dialogue: 0,0:08:01.45,0:08:04.12,Default,,0,0,0,,Бұл Адам және майор Берубе...
Dialogue: 0,0:08:04.41,0:08:05.58,Default,,0,0,0,,Юуко?
Dialogue: 0,0:08:05.91,0:08:07.50,Default,,0,0,0,,Юко! иә!
Dialogue: 0,0:08:08.45,0:08:10.16,Default,,0,0,0,,А, ана жерде!
Dialogue: 0,0:08:10.58,0:08:13.12,Default,,0,0,0,,Мен капитан Сакакимен бір сәт сөйлестім.
Dialogue: 0,0:08:13.20,0:08:14.41,Default,,0,0,0,,Сенпай, сен тірісің!
Dialogue: 0,0:08:14.50,0:08:16.54,Default,,0,0,0,,Кейін эмоцияға берілме, сержант Тани.
Dialogue: 0,0:08:19.79,0:08:22.12,Default,,0,0,0,,Эй, сен оны шынымен көрдің бе?
Dialogue: 0,0:08:22.20,0:08:25.79,Default,,0,0,0,,Бұл рас! Ол маған орман арқылы үлкен күшпен келе жатты.
Dialogue: 0,0:08:25.87,0:08:28.41,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:28.54,0:08:29.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:29.66,0:08:32.29,Default,,0,0,0,,Куу! Уф... Уф! (мылтық дыбысы)
Dialogue: 0,0:08:38.29,0:08:39.62,Default,,0,0,0,,Ha
Dialogue: 0,0:08:39.91,0:08:41.25,Default,,0,0,0,,Ха, бұл не!
Dialogue: 0,0:08:41.79,0:08:43.04,Default,,0,0,0,,Ол сауытты тесіп өтті!
Dialogue: 0,0:08:44.45,0:08:45.45,Default,,0,0,0,,(Оқтардың таусылған дыбысы)
Dialogue: 0,0:08:45.87,0:08:47.00,Default,,0,0,0,,Тағы бір ату
Dialogue: 0,0:08:47.08,0:08:48.33,Default,,0,0,0,,Мен мұндай жерде өлгім келмейді...
Dialogue: 0,0:08:53.37,0:08:54.20,Default,,0,0,0,,Құт
Dialogue: 0,0:08:58.41,0:08:59.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:00.08,0:09:01.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:01.91,0:09:03.16,Default,,0,0,0,,Мен тексеремін.
Dialogue: 0,0:09:10.58,0:09:12.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.37,0:09:16.87,Default,,0,0,0,,Қалай қарасаң да адам ғой, солай ма? Бұл...
Dialogue: 0,0:09:17.91,0:09:20.66,Default,,0,0,0,,Бұл үлгі...
Dialogue: 0,0:09:21.58,0:09:23.25,Default,,0,0,0,,Иә! Уау~
Dialogue: 0,0:09:23.54,0:09:24.37,Default,,0,0,0,,(Оқтардың таусылған дыбысы)
Dialogue: 0,0:09:28.50,0:09:30.33,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:09:30.79,0:09:31.87,Default,,0,0,0,,(шу)
Dialogue: 0,0:09:33.12,0:09:33.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:35.29,0:09:36.87,Default,,0,0,0,,Тоқта! аға!
Dialogue: 0,0:09:37.25,0:09:38.16,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:09:38.37,0:09:40.08,Default,,0,0,0,,Уау! (мылтық дыбысы)
Dialogue: 0,0:09:40.16,0:09:41.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.04,0:09:43.29,Default,,0,0,0,,Уау! (Оқтардың таусылған дыбысы)
Dialogue: 0,0:09:44.12,0:09:45.20,Default,,0,0,0,,Эй
Dialogue: 0,0:09:45.45,0:09:46.79,Default,,0,0,0,,Ух...хаа
Dialogue: 0,0:09:48.25,0:09:49.08,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:09:50.12,0:09:51.87,Default,,0,0,0,,Сенпай, ол жігіттен аулақ жүр!
Dialogue: 0,0:09:52.04,0:09:53.66,Default,,0,0,0,,Күте тұрыңыз, Юко! Тынышталыңыз
Dialogue: 0,0:09:54.04,0:09:55.00,Default,,0,0,0,,Капитан Сакаки!
Dialogue: 0,0:09:55.08,0:09:57.66,Default,,0,0,0,,Бізге жаңа ғана біреу шабуыл жасады!
Dialogue: 0,0:09:57.83,0:09:59.37,Default,,0,0,0,,Не? Бұл рас Харуо
Dialogue: 0,0:09:59.45,0:10:01.91,Default,,0,0,0,,Осы уақытқа дейін біз сол тіршілік иесімен соғыстық.
Dialogue: 0,0:10:02.00,0:10:05.08,Default,,0,0,0,,Ба...ақымақ, бұл бала әрқашан қасымда болады.
Dialogue: 0,0:10:05.20,0:10:08.54,Default,,0,0,0,,Не болса да, әлгі жаратылыс тыйылсын, Адам!
Dialogue: 0,0:10:08.62,0:10:11.62,Default,,0,0,0,,Не? Жоқ... оқ
Dialogue: 0,0:10:13.62,0:10:14.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:18.04,0:10:19.00,Default,,0,0,0,,Не...
Dialogue: 0,0:10:19.08,0:10:22.29,Default,,0,0,0,,Шүкір... Мен толығымен қоршалып қалдым.
Dialogue: 0,0:10:22.83,0:10:25.04,Default,,0,0,0,,Осыншама ұзақ өмір сүрдіңіз бе?
Dialogue: 0,0:10:26.62,0:10:27.83,Default,,0,0,0,,Хааа...
Dialogue: 0,0:10:28.79,0:10:29.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:31.83,0:10:34.12,Default,,0,0,0,,Бұл аймақты ынталандырмаған дұрыс.
Dialogue: 0,0:10:34.20,0:10:37.29,Default,,0,0,0,,Әй, шындығында, бәрі, енді оқ қалмады.
Dialogue: 0,0:10:40.83,0:10:41.66,Default,,0,0,0,,Ах
Dialogue: 0,0:11:11.91,0:11:12.75,Default,,0,0,0,,Ах
Dialogue: 0,0:11:14.16,0:11:15.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.95,0:11:32.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:33.70,0:11:35.50,Default,,0,0,0,,О, хаа...
Dialogue: 0,0:11:42.79,0:11:46.04,Default,,0,0,0,,Жер асты патшалығы...?
Dialogue: 0,0:11:46.12,0:11:48.62,Default,,0,0,0,,Хамф, бұл құмырсқаның ұясы сияқты.
Dialogue: 0,0:11:49.12,0:11:51.66,Default,,0,0,0,,Сіз осында тұруды жалғастырдыңыз ба?
Dialogue: 0,0:11:52.29,0:11:53.66,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:11:58.41,0:11:59.37,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:11:59.45,0:12:01.16,Default,,0,0,0,,Сәлем! аздап!
Dialogue: 0,0:12:01.29,0:12:02.33,Default,,0,0,0,,Қазір 17:59… 47, 48, 49…
Dialogue: 0,0:12:05.58,0:12:07.12,Default,,0,0,0,,Сәлем, сені көргеніме қуаныштымын!
Dialogue: 0,0:12:07.20,0:12:08.04,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:12:08.50,0:12:11.66,Default,,0,0,0,,Балалар, дулығаларыңды сақтасаңдар болады.
Dialogue: 0,0:12:11.79,0:12:14.54,Default,,0,0,0,,Мұндағы атмосфера 20 000 жыл бұрынғы құрамымен бірдей.
Dialogue: 0,0:12:16.79,0:12:18.45,Default,,0,0,0,,Барлығы қауіпсіз болды.
Dialogue: 0,0:12:18.66,0:12:20.50,Default,,0,0,0,,Капитан! Капитан Сакаки!
Dialogue: 0,0:12:20.95,0:12:23.50,Default,,0,0,0,,Капитан! Жақсы~
Dialogue: 0,0:12:24.12,0:12:25.66,Default,,0,0,0,,Берубе, жақсы болдыңыз ба?
Dialogue: 0,0:12:25.75,0:12:28.37,Default,,0,0,0,,Командир Гарг, сіз де амансыз.
Dialogue: 0,0:12:29.66,0:12:31.70,Default,,0,0,0,,Даналар да солардың қолына түсті ме?
Dialogue: 0,0:12:31.79,0:12:35.04,Default,,0,0,0,,Ах, үлкен топтың қоршауында.
Dialogue: 0,0:12:35.20,0:12:36.25,Default,,0,0,0,,Метфис туралы не деуге болады?
Dialogue: 0,0:12:36.33,0:12:38.79,Default,,0,0,0,,Жоқ, өкінішке орай, мұнда...
Dialogue: 0,0:12:39.83,0:12:42.54,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:12:42.87,0:12:44.66,Default,,0,0,0,,Жақсы атмосфера
Dialogue: 0,0:12:46.29,0:12:50.50,Default,,0,0,0,,Бұл балалар орман ауасында да жақсы болды.
Dialogue: 0,0:12:50.58,0:12:53.41,Default,,0,0,0,,Олардың өкпесі сыртқы ауаны көтере алатын сияқты.
Dialogue: 0,0:12:53.50,0:12:55.87,Default,,0,0,0,,Негізі бізге жақын шығар.
Dialogue: 0,0:12:55.95,0:12:58.08,Default,,0,0,0,,Бұл олардың адам екенін білдіреді...
Dialogue: 0,0:12:58.33,0:13:00.50,Default,,0,0,0,,Ұрпақпын дейсің бе?
Dialogue: 0,0:13:00.58,0:13:02.79,Default,,0,0,0,,Бұл ертерек болуы мүмкін.
Dialogue: 0,0:13:02.87,0:13:06.08,Default,,0,0,0,,Бірақ сыртынан қарағанда олар адамға ұқсайды.
Dialogue: 0,0:13:06.16,0:13:09.08,Default,,0,0,0,,Бірақ денемнен ұнтақ тәрізді бірдеңе шығып жатты.
Dialogue: 0,0:13:09.16,0:13:11.83,Default,,0,0,0,,Иә? Бұл масштабты ұнтақ па?
Dialogue: 0,0:13:12.20,0:13:15.58,Default,,0,0,0,,Ол жәндіктерден пайда болуы мүмкін.
Dialogue: 0,0:13:15.66,0:13:16.66,Default,,0,0,0,,Саған бір нәрсе сұрасам бола ма?
Dialogue: 0,0:13:16.75,0:13:20.04,Default,,0,0,0,,Оларды гуманоидтар деп атауға болмайды.
Dialogue: 0,0:13:20.12,0:13:21.25,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:13:21.66,0:13:25.00,Default,,0,0,0,,Олардың ғылыми қабілеті тиісті деңгейге жеткен жоқ.
Dialogue: 0,0:13:25.08,0:13:27.87,Default,,0,0,0,,Олар сенің ұрпағың болса да
Dialogue: 0,0:13:27.95,0:13:29.79,Default,,0,0,0,,Бұл эволюция емес, «азғындау»
Dialogue: 0,0:13:30.16,0:13:31.58,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:13:31.66,0:13:35.62,Default,,0,0,0,,Бізге қазір бұл жерден қалай шығу керек екенін ойлау керек.
Dialogue: 0,0:13:35.70,0:13:37.54,Default,,0,0,0,,Осы нәсілдің бәрін өлтірсем де
Dialogue: 0,0:13:38.75,0:13:42.79,Default,,0,0,0,,Не болса да, олар бізді не істемек?
Dialogue: 0,0:13:42.87,0:13:46.66,Default,,0,0,0,,Хмм... Мені өлтірмек ойың жоқ шығар?
Dialogue: 0,0:13:46.95,0:13:48.54,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:13:48.62,0:13:51.66,Default,,0,0,0,,Олар барлық зардап шеккендерге ем жүргізді.
Dialogue: 0,0:13:51.75,0:13:54.37,Default,,0,0,0,,Мен көремін. Негізі мен де қызбын...
Dialogue: 0,0:13:54.62,0:13:57.20,Default,,0,0,0,,Мүмкін ол құрбандық шалуды жоспарлап отырған шығар.
Dialogue: 0,0:13:57.83,0:13:58.66,Default,,0,0,0,,Қабырғаға қараңыз
Dialogue: 0,0:14:00.33,0:14:01.29,Default,,0,0,0,,Бұл жер қабірге ұқсайды.
Dialogue: 0,0:14:02.08,0:14:04.33,Default,,0,0,0,,Бізде де солай болмай ма?
Dialogue: 0,0:14:04.54,0:14:07.58,Default,,0,0,0,,Мені өлтіретін болсаң, мен сені ауылға апарып әуре болмас едім.
Dialogue: 0,0:14:07.66,0:14:09.04,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:14:10.83,0:14:13.70,Default,,0,0,0,,Сонымен, капитан Сакаки, ​​қазір не істеуді жоспарлайсыз?
Dialogue: 0,0:14:13.87,0:14:15.29,Default,,0,0,0,,Не? (Сарбаздар) Капитан!
Dialogue: 0,0:14:15.50,0:14:17.16,Default,,0,0,0,,Капитан Сакаки капитан!
Dialogue: 0,0:14:17.25,0:14:19.37,Default,,0,0,0,,Сіз әлі командирсіз.
Dialogue: 0,0:14:22.08,0:14:26.50,Default,,0,0,0,,Жүгір, Харуо, жаның қайда апарса да.
Dialogue: 0,0:14:29.25,0:14:32.20,Default,,0,0,0,,Әйтеуір осы жерден қашып, аналық кемеге хабарласыңыз.
Dialogue: 0,0:14:32.29,0:14:34.79,Default,,0,0,0,,Мен ормандағы десантқа ұқсайтын жауап таптым.
Dialogue: 0,0:14:35.33,0:14:38.41,Default,,0,0,0,,Бірақ барлық десанттық кемелер оның шабуылына ұшырады.
Dialogue: 0,0:14:38.50,0:14:41.83,Default,,0,0,0,,Кем дегенде Адамның басқару блогы қалуы керек.
Dialogue: 0,0:14:41.91,0:14:44.08,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,0:14:44.16,0:14:46.50,Default,,0,0,0,,Бірақ ол затпен ұша алмайсың.
Dialogue: 0,0:14:46.83,0:14:48.87,Default,,0,0,0,,Тек аналық кемемен байланыса алу керек
Dialogue: 0,0:14:49.00,0:14:51.70,Default,,0,0,0,,Енді қирандылардан қару-жарақ пен азық-түлік сатып алуымыз керек.
Dialogue: 0,0:14:51.79,0:14:52.66,Default,,0,0,0,,Қару дегеніміз не?
Dialogue: 0,0:14:52.75,0:14:56.33,Default,,0,0,0,,Кез келген жағдайда, капитан Сакаки, ​​сіз онымен әлі де жұмыс істеуді жоспарлап жүрсіз бе?
Dialogue: 0,0:14:57.29,0:14:58.41,Default,,0,0,0,,Ах
Dialogue: 0,0:14:59.29,0:15:00.12,Default,,0,0,0,,Сіз
Dialogue: 0,0:15:08.91,0:15:09.87,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:10.58,0:15:11.83,Default,,0,0,0,,Бұл қандай да бір ырым ба?
Dialogue: 0,0:15:12.20,0:15:14.16,Default,,0,0,0,,Иә, құрбандық, иә?
Dialogue: 0,0:15:14.29,0:15:16.25,Default,,0,0,0,,Маған үзіліс беріңізші...
Dialogue: 0,0:15:23.95,0:15:25.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:25.25,0:15:26.54,Default,,0,0,0,,Беттері ұқсас
Dialogue: 0,0:15:26.62,0:15:28.20,Default,,0,0,0,,Олар егіз бе еді?
Dialogue: 0,0:15:30.12,0:15:33.37,Default,,0,0,0,,(Жоғары жиілікті дыбыс)
Dialogue: 0,0:15:33.70,0:15:36.33,Default,,0,0,0,,Жұмыртқаны мадақтау
Dialogue: 0,0:15:36.45,0:15:39.37,Default,,0,0,0,,Жердің қараңғылығы – адамзаттың қалған бөлігі.
Dialogue: 0,0:15:40.00,0:15:42.29,Default,,0,0,0,,Қараңғылықты нұрландыратын нұр
Dialogue: 0,0:15:42.37,0:15:44.62,Default,,0,0,0,,Ішкі көзге ұсынылады
Dialogue: 0,0:15:45.79,0:15:49.33,Default,,0,0,0,,Бұл психикалық жауаптың бір түрі ме?
Dialogue: 0,0:15:49.62,0:15:52.29,Default,,0,0,0,,Олар адам тілін қалай біледі?
Dialogue: 0,0:15:52.37,0:15:56.04,Default,,0,0,0,,Жоқ, бұл бізге Бильсардоның ана тілі сияқты естіледі.
Dialogue: 0,0:15:56.45,0:16:00.08,Default,,0,0,0,,Оны тілге айналдыратын біздің миымыз шығар.
Dialogue: 0,0:16:01.66,0:16:06.08,Default,,0,0,0,,Жұмыртқа әнін ал, Қарғадан сұра
Dialogue: 0,0:16:07.04,0:16:10.16,Default,,0,0,0,,Құстың баласын тыңдау
Dialogue: 0,0:16:10.45,0:16:13.50,Default,,0,0,0,,Бұл жұмыртқа сұрағы.
Dialogue: 0,0:16:13.83,0:16:17.20,Default,,0,0,0,,Халқымыздың ұжымдық еркін білдіретін ән.
Dialogue: 0,0:16:17.37,0:16:18.58,Default,,0,0,0,,Бала құс?
Dialogue: 0,0:16:18.91,0:16:20.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:20.62,0:16:23.25,Default,,0,0,0,,Олар беріліс күшейткіштері ме?
Dialogue: 0,0:16:23.33,0:16:25.87,Default,,0,0,0,,Сонымен, «фуцуа» нені білдіреді?
Dialogue: 0,0:16:25.95,0:16:27.37,Default,,0,0,0,,Осы жарыстың аты?
Dialogue: 0,0:16:28.00,0:16:32.33,Default,,0,0,0,,Неліктен отты жаңбыр Хутуаның бағын өртеп жіберді?
Dialogue: 0,0:16:32.54,0:16:34.58,Default,,0,0,0,,Қарғалар өлімнің қанаты ма?
Dialogue: 0,0:16:35.08,0:16:35.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:36.08,0:16:37.25,Default,,0,0,0,,Жалын...
Dialogue: 0,0:16:37.58,0:16:38.50,Default,,0,0,0,,Жаңбыр?
Dialogue: 0,0:16:40.83,0:16:41.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:41.95,0:16:44.91,Default,,0,0,0,,А... қону үшін бұл сөзсіз болды.
Dialogue: 0,0:16:45.04,0:16:47.91,Default,,0,0,0,,Сонда құстың баласына азу тістеріңді неге жалаңаштадың?
Dialogue: 0,0:16:49.33,0:16:51.75,Default,,0,0,0,,Қарғалар өлімнің қанаты ма?
Dialogue: 0,0:16:52.62,0:16:54.87,Default,,0,0,0,,Түсінбеушілік үшін кешірім сұраймыз.
Dialogue: 0,0:16:55.00,0:16:56.16,Default,,0,0,0,,Бірақ мен сенің түсінгеніңді қалаймын
Dialogue: 0,0:16:56.91,0:16:59.91,Default,,0,0,0,,Біз Годзилланы жеңу үшін келдік.
Dialogue: 0,0:17:00.33,0:17:02.54,Default,,0,0,0,,Годзилла? Годзилла? Годзилла? Годзилла?
Dialogue: 0,0:17:02.95,0:17:04.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:05.12,0:17:08.70,Default,,0,0,0,,Годзилланың жойылуынан қорқу
Dialogue: 0,0:17:09.41,0:17:11.87,Default,,0,0,0,,Құдайымыздың... жауы
Dialogue: 0,0:17:12.41,0:17:14.91,Default,,0,0,0,,Қарға Годзиллаға қарсы тұрады
Dialogue: 0,0:17:15.00,0:17:17.29,Default,,0,0,0,,Ол қызметшісінің етін жеді.
Dialogue: 0,0:17:17.50,0:17:18.45,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:18.54,0:17:22.20,Default,,0,0,0,,Біз бұл жерге Годзилладан Жерді қайтару үшін келдік.
Dialogue: 0,0:17:22.29,0:17:23.58,Default,,0,0,0,,Қарсы тұру керек пе?
Dialogue: 0,0:17:23.70,0:17:26.50,Default,,0,0,0,,(Бірге жаңғырған ақсақалдардың жоғары жиілікті дыбысы)
Dialogue: 0,0:17:29.08,0:17:32.16,Default,,0,0,0,,Қарғалар өлімнің қанатында емес
Dialogue: 0,0:17:32.54,0:17:34.58,Default,,0,0,0,,Өмірді жырлаған адам
Dialogue: 0,0:17:35.62,0:17:38.50,Default,,0,0,0,,Бірақ бұл тырнақтар Годзиллаға жете алмайды.
Dialogue: 0,0:17:38.83,0:17:39.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:40.25,0:17:42.20,Default,,0,0,0,,«Мен жеңе алмаймын» дейсіз бе?
Dialogue: 0,0:17:42.66,0:17:45.20,Default,,0,0,0,,Тіпті Футуа құдайы Годзилладан жеңіледі
Dialogue: 0,0:17:45.29,0:17:47.66,Default,,0,0,0,,Әзірге жұмыртқа ғана қалды.
Dialogue: 0,0:17:47.83,0:17:52.62,Default,,0,0,0,,Қиындық пен қарсылық көрсеткеннің бәрі жалынға ұшады да, жойылады.
Dialogue: 0,0:17:53.12,0:17:54.20,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:17:55.08,0:17:57.29,Default,,0,0,0,,Біз жеңе аламыз!
Dialogue: 0,0:17:58.04,0:18:01.66,Default,,0,0,0,,Саяхат қарғаның қалауымен аяқталады.
Dialogue: 0,0:18:02.33,0:18:07.00,Default,,0,0,0,,Сонда да Футуа үйлесімділік пен өмір жолын көрсетеді.
Dialogue: 0,0:18:07.41,0:18:08.91,Default,,0,0,0,,Гармония…
Dialogue: 0,0:18:17.66,0:18:18.66,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:18:18.75,0:18:22.41,Default,,0,0,0,,Олардың өмір салты қарабайыр болып көрінгенімен, мәдени деңгейі өте жоғары.
Dialogue: 0,0:18:23.08,0:18:25.87,Default,,0,0,0,,Барлық жерде өрілген, бұл әріптер.
Dialogue: 0,0:18:25.95,0:18:27.29,Default,,0,0,0,,Бірегей үлгі бар
Dialogue: 0,0:18:27.62,0:18:28.91,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:18:29.00,0:18:31.25,Default,,0,0,0,,Hmph Тіпті қарабайыр адамдардың да жазуы бар.
Dialogue: 0,0:18:31.66,0:18:35.41,Default,,0,0,0,,Жоқ, олар өте дамыған нәсіл.
Dialogue: 0,0:18:35.70,0:18:37.50,Default,,0,0,0,,Иә, капитан Сакаки.
Dialogue: 0,0:18:37.58,0:18:40.54,Default,,0,0,0,,Бұл біз жеңген бірінші Годзилла.
Dialogue: 0,0:18:41.08,0:18:44.37,Default,,0,0,0,,Футуа айтқандай, бұл кіші түр болуы мүмкін.
Dialogue: 0,0:18:44.66,0:18:45.75,Default,,0,0,0,,Түршелер? (Мартин) Иә.
Dialogue: 0,0:18:45.83,0:18:49.37,Default,,0,0,0,,Бұл оның жолда кездескен птерозавр тәрізді тіршілік иесіне ұқсас екенін білдіре ме?
Dialogue: 0,0:18:49.45,0:18:50.75,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:18:50.83,0:18:54.20,Default,,0,0,0,,Ормандағы өсімдіктерден жәндіктерге дейінгі барлық тіршілік иелері,
Dialogue: 0,0:18:54.29,0:18:57.33,Default,,0,0,0,,Қандай да бір жолмен Годзиллаға ұқсас сипаттарды көрсетті
Dialogue: 0,0:18:57.66,0:18:58.87,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:18:58.95,0:19:03.62,Default,,0,0,0,,Күшті тірі ағзалардың белгілеріне еліктеу арқылы өмір сүру стратегиялары
Dialogue: 0,0:19:03.70,0:19:05.29,Default,,0,0,0,,Басқаша айтқанда, мимика
Dialogue: 0,0:19:05.37,0:19:08.45,Default,,0,0,0,,Біз қазір одан асып, біртектілікке ұмтылудамыз.
Dialogue: 0,0:19:08.66,0:19:10.20,Default,,0,0,0,,Жердегі тіршілік иелері болуы мүмкін
Dialogue: 0,0:19:10.29,0:19:12.62,Default,,0,0,0,,Барлығы Годзилланың бақылауында болды.
Dialogue: 0,0:19:12.70,0:19:13.54,Default,,0,0,0,,На
Dialogue: 0,0:19:15.62,0:19:18.41,Default,,0,0,0,,Мен... Мен мұны қабылдамаймын.
Dialogue: 0,0:19:20.41,0:19:21.62,Default,,0,0,0,,Капитан Сакаки
Dialogue: 0,0:19:22.41,0:19:26.00,Default,,0,0,0,,Жаңа айтқан сөзіңізге шындап қарайсыз ба?
Dialogue: 0,0:19:27.37,0:19:29.20,Default,,0,0,0,,Егер мен онымен тағы ұрыссам
Dialogue: 0,0:19:31.62,0:19:32.45,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:19:32.54,0:19:34.00,Default,,0,0,0,,Сен кімнің мүлкіне рұқсатсыз кіріп алдың?
Dialogue: 0,0:19:34.66,0:19:37.25,Default,,0,0,0,,Бұған кім кінәлі деп ойлайсыз?
Dialogue: 0,0:19:37.33,0:19:38.29,Default,,0,0,0,,Эй
Dialogue: 0,0:19:38.41,0:19:39.25,Default,,0,0,0,,Және мен саған тағы да қалпыңа келуге мүмкіндік бермеймін!
Dialogue: 0,0:19:39.33,0:19:42.16,Default,,0,0,0,,Сіз бізді айдап салып, осы жерге әкелуіңіз керек!
Dialogue: 0,0:19:42.33,0:19:44.62,Default,,0,0,0,,Біраз күтіңіз, солай айтасыз.
Dialogue: 0,0:19:45.16,0:19:49.66,Default,,0,0,0,,Біз бірінші Годзилланы Харуо стратегиясымен жеңдік, солай ма?
Dialogue: 0,0:19:49.83,0:19:54.20,Default,,0,0,0,,Жеңілісті 20 жыл бұрын білген адам ретінде мен тек ризашылығымды білдіргім келеді.
Dialogue: 0,0:19:55.70,0:19:57.33,Default,,0,0,0,,Рахмет Берубе
Dialogue: 0,0:19:58.83,0:20:00.33,Default,,0,0,0,,Мен де абдырап қалдым.
Dialogue: 0,0:20:00.45,0:20:02.83,Default,,0,0,0,,Бірақ егер сіз оны осында тартсаңыз
Dialogue: 0,0:20:03.00,0:20:05.37,Default,,0,0,0,,Біз мұнда не үшін келдік?
Dialogue: 0,0:20:05.50,0:20:07.66,Default,,0,0,0,,Ха, бұл...
Dialogue: 0,0:20:08.16,0:20:09.66,Default,,0,0,0,,Бірақ капитан
Dialogue: 0,0:20:09.87,0:20:13.16,Default,,0,0,0,,Шынымды айтсам, мен де оны жеңе алмаймын...
Dialogue: 0,0:20:13.41,0:20:15.16,Default,,0,0,0,,Шкаланың шамасының басқа реті бойынша.
Dialogue: 0,0:20:15.45,0:20:19.00,Default,,0,0,0,,Егер бұл жай ғана өлшем мәселесі болса, онда жақсы мүмкіндік бар
Dialogue: 0,0:20:19.12,0:20:21.29,Default,,0,0,0,,Харуоның тактикасы дұрыс болды.
Dialogue: 0,0:20:21.41,0:20:23.08,Default,,0,0,0,,Ол қаншалықты үлкен болса да
Dialogue: 0,0:20:23.16,0:20:27.83,Default,,0,0,0,,Егер сіз әскерлеріңізді толықтырып, қайта топтасаңыз, оларды дәл осылай жеңе аласыз.
Dialogue: 0,0:20:28.95,0:20:33.54,Default,,0,0,0,,Бұл адамзаттың Жерді қайтарып алудың соңғы мүмкіндігі.
Dialogue: 0,0:20:49.62,0:20:52.62,Default,,0,0,0,,Мен шынымен дұрыс айтамын ба?
Dialogue: 0,0:20:54.79,0:20:56.16,Default,,0,0,0,,Метфис…
Dialogue: 0,0:20:58.41,0:21:01.91,Default,,0,0,0,,Құрлық әскерлері арасындағы байланыс үзілгеннен бері 30 сағат өтті.
Dialogue: 0,0:21:02.00,0:21:04.16,Default,,0,0,0,,Тірі қалғандар әлі анықталған жоқ.
Dialogue: 0,0:21:05.54,0:21:08.00,Default,,0,0,0,,Бұл қиын шешім болмайды деп үміттенемін.
Dialogue: 0,0:21:08.45,0:21:11.37,Default,,0,0,0,,Біз кейде жердегі ерекше тербеліс толқындарын байқадық.
Dialogue: 0,0:21:11.95,0:21:14.00,Default,,0,0,0,,Қайта-қайта қозғалатын сияқты
Dialogue: 0,0:21:14.45,0:21:17.16,Default,,0,0,0,,Жер сенікі деп жатырсың...
Dialogue: 0,0:21:17.25,0:21:18.33,Default,,0,0,0,,Годзилла!
Dialogue: 0,0:21:18.54,0:21:20.70,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:20.79,0:21:22.95,Default,,0,0,0,,Әлі тұманда ма?
Dialogue: 0,0:21:23.58,0:21:27.75,Default,,0,0,0,,Костюмнің байланыс функциясы бар аналық кемемен байланысу мүмкін емес.
Dialogue: 0,0:21:28.08,0:21:29.79,Default,,0,0,0,,Десант іздеуден басқа амалымыз әлі жоқ.
Dialogue: 0,0:21:30.95,0:21:33.95,Default,,0,0,0,,Рахмет, өзіміз жақсы боламыз.
Dialogue: 0,0:21:34.16,0:21:37.58,Default,,0,0,0,,Сенпай, біз сөйлесе алмаймыз.
Dialogue: 0,0:21:38.00,0:21:40.79,Default,,0,0,0,,Годзилланы жеңу үшін келгенімізді айта алуыңыз керек еді.
Dialogue: 0,0:21:40.87,0:21:41.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:42.25,0:21:45.58,Default,,0,0,0,,Маған шығуға рұқсат берген, тіпті қаруымды қайтарған ақсақалға.
Dialogue: 0,0:21:45.66,0:21:47.29,Default,,0,0,0,,Сізге шын жүректен рахмет
Dialogue: 0,0:21:48.20,0:21:50.37,Default,,0,0,0,,Жүр, Харуо, кеттік.
Dialogue: 0,0:21:50.87,0:21:52.66,Default,,0,0,0,,Барайық (бәрі) Иә?
Dialogue: 0,0:21:53.50,0:21:55.79,Default,,0,0,0,,біз біргеміз
Dialogue: 0,0:21:56.29,0:21:59.08,Default,,0,0,0,,Біз айтқан сөздер есіңізде ме?
Dialogue: 0,0:21:59.16,0:22:00.66,Default,,0,0,0,,Жетілдірілген интеллект
Dialogue: 0,0:22:00.75,0:22:02.62,Default,,0,0,0,,Бұл мен ойлағаннан да көп болуы мүмкін.
Dialogue: 0,0:22:02.70,0:22:04.12,Default,,0,0,0,,Бірақ неге бірге?
Dialogue: 0,0:22:04.41,0:22:06.41,Default,,0,0,0,,Хмф, бұл бақылау емес пе?
Dialogue: 0,0:22:08.70,0:22:10.83,Default,,0,0,0,,Жарайды, менімен бірге жүр.
Dialogue: 0,0:22:11.00,0:22:14.16,Default,,0,0,0,,(Сельвамның айқайы)
Dialogue: 0,0:22:15.87,0:22:19.20,Default,,0,0,0,,Десанттың түсіру нүктесі осы жерде болуы керек.
Dialogue: 0,0:22:19.66,0:22:21.66,Default,,0,0,0,,Енді...
Dialogue: 0,0:22:22.41,0:22:23.75,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:22:23.83,0:22:26.91,Default,,0,0,0,,Компас және позициялау жүйесі әлі де пайдасыз
Dialogue: 0,0:22:27.50,0:22:29.75,Default,,0,0,0,,Десант тапсақ та
Dialogue: 0,0:22:29.83,0:22:32.33,Default,,0,0,0,,Аналық кеме әлі орбитада ма...
Dialogue: 0,0:22:32.91,0:22:34.00,Default,,0,0,0,,Бәрібір іздеп көрейік
Dialogue: 0,0:22:35.08,0:22:38.50,Default,,0,0,0,,О? Әй, қызық емес пе?
Dialogue: 0,0:22:38.58,0:22:40.91,Default,,0,0,0,,Ал...
Dialogue: 0,0:22:41.00,0:22:43.75,Default,,0,0,0,,Аты жоқ ыңғайсыз.
Dialogue: 0,0:22:44.79,0:22:45.95,Default,,0,0,0,,Майна (Мартин) Әй?
Dialogue: 0,0:22:46.04,0:22:47.41,Default,,0,0,0,,Миана (Мартин) Иә?
Dialogue: 0,0:22:48.08,0:22:50.62,Default,,0,0,0,,Сәлем! Бұл сіздің атыңыз ба?
Dialogue: 0,0:22:50.70,0:22:52.37,Default,,0,0,0,,Менің ойымша, айырмашылық жоқ.
Dialogue: 0,0:22:53.00,0:22:56.54,Default,,0,0,0,,Мүмкін, бірақ мені құтқарған Миана болды.
Dialogue: 0,0:22:56.62,0:22:58.58,Default,,0,0,0,,Бәріміз кездестіргеніміз Майна болатын.
Dialogue: 0,0:22:58.66,0:23:00.20,Default,,0,0,0,,Сіз қайдан білесіз? Харуо
Dialogue: 0,0:23:00.29,0:23:02.25,Default,,0,0,0,,Мұқият қараған дұрыс.
Dialogue: 0,0:23:02.33,0:23:05.70,Default,,0,0,0,,Хмф, бәрі эмоционалды себептерге байланысты, Жердегілер.
Dialogue: 0,0:23:06.12,0:23:10.00,Default,,0,0,0,,Оның үстіне Миана екеуміз кеше бірге болдық.
Dialogue: 0,0:23:10.54,0:23:13.41,Default,,0,0,0,,Хару ой ах
Dialogue: 0,0:23:13.70,0:23:14.66,Default,,0,0,0,,Ha
Dialogue: 0,0:23:15.70,0:23:17.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:23:17.75,0:23:19.75,Default,,0,0,0,,Менің атым «Харуо»
Dialogue: 0,0:23:20.91,0:23:23.91,Default,,0,0,0,,Хмф, сен мені қатты ұнаттың, Харуо.
Dialogue: 0,0:23:24.29,0:23:27.41,Default,,0,0,0,,Керісінше, сіздің тіл деңгейіңіз айтарлықтай жоғары.
Dialogue: 0,0:23:29.00,0:23:30.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:34.79,0:23:36.04,Default,,0,0,0,,Бұл реакция…
Dialogue: 0,0:23:36.66,0:23:38.08,Default,,0,0,0,,Сіз оны тапқан боларсыз!
Dialogue: 0,0:23:38.45,0:23:41.95,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:23:43.00,0:23:44.54,Default,,0,0,0,,Не... мұнда
Dialogue: 0,0:23:51.16,0:23:52.33,Default,,0,0,0,,Ах! Ахх...
Dialogue: 0,0:23:52.70,0:23:54.37,Default,,0,0,0,,Үйден қашқандарды да қоса алғанда.
Dialogue: 0,0:23:55.50,0:23:56.83,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:23:57.00,0:23:57.83,Default,,0,0,0,,Ha
Dialogue: 0,0:23:58.04,0:23:59.20,Default,,0,0,0,,Юуко!
Dialogue: 0,0:23:59.50,0:24:00.33,Default,,0,0,0,,Ха, жоқ!
Dialogue: 0,0:24:04.62,0:24:05.66,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:24:06.37,0:24:07.58,Default,,0,0,0,,Қарғыс атсын... (мылтық ату)
Dialogue: 0,0:24:10.25,0:24:11.33,Default,,0,0,0,,Юко!
Dialogue: 0,0:24:13.45,0:24:14.54,Default,,0,0,0,,Мына жігіттер қыңыр!
Dialogue: 0,0:24:14.83,0:24:16.75,Default,,0,0,0,,Қап, мені атып таста!
Dialogue: 0,0:24:19.08,0:24:19.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:20.87,0:24:21.75,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:22.08,0:24:23.12,Default,,0,0,0,,(жебенің соғу дыбысы)
Dialogue: 0,0:24:25.41,0:24:26.83,Default,,0,0,0,,(жебенің соғу дыбысы)
Dialogue: 0,0:24:29.08,0:24:30.20,Default,,0,0,0,,Хаа…
Dialogue: 0,0:24:31.00,0:24:36.00,Default,,0,0,0,,(Үш адамның тыныс алуы)
Dialogue: 0,0:24:39.45,0:24:40.79,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:24:41.00,0:24:43.16,Default,,0,0,0,,Ха, мен оны уақытында орындағаныма қуаныштымын.
Dialogue: 0,0:24:44.54,0:24:47.20,Default,,0,0,0,,Эй, сен маған сол жебені көрсете аласың ба?
Dialogue: 0,0:24:50.95,0:24:51.91,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:24:52.25,0:24:53.37,Default,,0,0,0,,Улы у?
Dialogue: 0,0:24:53.45,0:24:54.29,Default,,0,0,0,,Ha
Dialogue: 0,0:24:54.45,0:24:58.62,Default,,0,0,0,,(Сельвамның айқайы)
Dialogue: 0,0:25:01.95,0:25:03.62,Default,,0,0,0,,Ұрысқа дайын! Ат!
Dialogue: 0,0:25:07.00,0:25:07.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:08.12,0:25:09.00,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:25:09.29,0:25:10.12,Default,,0,0,0,,Міне!
Dialogue: 0,0:25:15.08,0:25:15.91,Default,,0,0,0,,Тиіп көр!
Dialogue: 0,0:25:16.33,0:25:17.95,Default,,0,0,0,,Қандай әскерлер аман қалды?
Dialogue: 0,0:25:24.54,0:25:25.37,Default,,0,0,0,,Ах
Dialogue: 0,0:25:26.45,0:25:27.91,Default,,0,0,0,,Метфис
Dialogue: 0,0:25:31.66,0:25:32.95,Default,,0,0,0,,Капитан Морли
Dialogue: 0,0:25:33.16,0:25:35.45,Default,,0,0,0,,48 сағатқа жуықтап қалды
Dialogue: 0,0:25:35.54,0:25:36.50,Default,,0,0,0,,О
Dialogue: 0,0:25:37.45,0:25:39.66,Default,,0,0,0,,Десантшылардың тергеуі енді тоқтатылды.
Dialogue: 0,0:25:39.87,0:25:40.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:40.91,0:25:42.87,Default,,0,0,0,,Күн жүйесінен қайтадан шығамыз
Dialogue: 0,0:25:44.75,0:25:46.91,Default,,0,0,0,,Күте тұрыңыз, капитан Мори.
Dialogue: 0,0:25:47.00,0:25:47.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:47.91,0:25:50.20,Default,,0,0,0,,Галбитория оракулға айтты.
Dialogue: 0,0:25:50.83,0:25:54.66,Default,,0,0,0,,«Аспан мен жердің жүрегінен, Бұзылған бұлттармен жабылған».
Dialogue: 0,0:25:54.75,0:25:57.00,Default,,0,0,0,,«Біз қайтадан дауыспен алмасамыз»
Dialogue: 0,0:25:57.50,0:25:58.50,Default,,0,0,0,,Пайғамбарлық?
Dialogue: 0,0:25:58.58,0:26:00.58,Default,,0,0,0,,Сіздің құдіретті Құдайыңыз
Dialogue: 0,0:26:00.66,0:26:04.75,Default,,0,0,0,,Кейде сол гаджет арқылы сізге сөйлейді деген жалған қауесет пе?
Dialogue: 0,0:26:04.95,0:26:08.58,Default,,0,0,0,,Сіз бұл миф деп қателескенсіз бе?
Dialogue: 0,0:26:08.66,0:26:09.50,Default,,0,0,0,,Хун
Dialogue: 0,0:26:09.58,0:26:12.95,Default,,0,0,0,,Олардың болжау қабілеті Гематрон операциясын қолдану болып табылады.
Dialogue: 0,0:26:13.04,0:26:15.58,Default,,0,0,0,,Бұл сіздің Бильсардо көзқарасыңыз болса керек.
Dialogue: 0,0:26:15.75,0:26:19.70,Default,,0,0,0,,Құдайды немесе басқаны тәрбиелеудің қажеті жоқ, бұл ғылыми талдау.
Dialogue: 0,0:26:19.79,0:26:23.95,Default,,0,0,0,,Хмм, аспан мен жердің дауысы алмасып тұр ма, білмеймін.
Dialogue: 0,0:26:24.04,0:26:26.37,Default,,0,0,0,,Бұл десантшылармен байланыса аламыз дегенді білдіре ме?
Dialogue: 0,0:26:26.45,0:26:28.04,Default,,0,0,0,,Жерден сигнал алу
Dialogue: 0,0:26:29.50,0:26:31.25,Default,,0,0,0,,Ха, бұл құтқару сигналы! (Барлығы) О...
Dialogue: 0,0:26:31.37,0:26:32.20,Default,,0,0,0,,Бұл Метфис
Dialogue: 0,0:26:32.91,0:26:37.08,Default,,0,0,0,,Қазіргі уақытта апатты жағдайда қонған десанттың жанында әскерлер жиналуда.
Dialogue: 0,0:26:37.29,0:26:38.50,Default,,0,0,0,,Көмек сұрау
Dialogue: 0,0:26:38.58,0:26:39.50,Default,,0,0,0,,Сол жақтағы адам бәрін егжей-тегжейлі түсіндіреді. Содан кейін оның нұсқауларын орындаңыз
Dialogue: 0,0:26:39.58,0:26:43.79,Default,,0,0,0,,Қазіргі уақытта апатты жағдайда қонған десанттың жанында әскерлер жиналуда.
Dialogue: 0,0:26:43.87,0:26:45.00,Default,,0,0,0,,Көмек сұрау
Dialogue: 0,0:26:50.70,0:26:53.37,Default,,0,0,0,,Қайтқандарды батыр болып қарсы алады.
Dialogue: 0,0:26:53.45,0:26:54.29,Default,,0,0,0,,Иә
Dialogue: 0,0:26:57.20,0:26:58.66,Default,,0,0,0,,Байланысты қалпына келтірудің болжамы қандай?
Dialogue: 0,0:26:58.75,0:27:01.50,Default,,0,0,0,,Шуды кетіру тізбегі қайтадан істен шықты.
Dialogue: 0,0:27:01.58,0:27:03.66,Default,,0,0,0,,Хмм, жалғастырыңыз.
Dialogue: 0,0:27:04.20,0:27:05.04,Default,,0,0,0,,Харуо
Dialogue: 0,0:27:05.37,0:27:08.20,Default,,0,0,0,,Орталық Комитет Күн жүйесінен кетуге ниетті.
Dialogue: 0,0:27:08.50,0:27:10.16,Default,,0,0,0,,Не? Біз не істеуіміз керек?
Dialogue: 0,0:27:10.41,0:27:11.83,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:27:12.29,0:27:14.83,Default,,0,0,0,,Харуо, мен мұны айта аламын ба?
Dialogue: 0,0:27:15.08,0:27:17.45,Default,,0,0,0,,Бербе Гарг Сіз қайда болдыңыз?
Dialogue: 0,0:27:17.54,0:27:21.87,Default,,0,0,0,,Біз тапқан нәрсенің шын екенін тексеріп жатырмыз.
Dialogue: 0,0:27:22.16,0:27:23.08,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:27:23.41,0:27:25.41,Default,,0,0,0,,Харуо, сіз жеңе аласыз.
Dialogue: 0,0:27:25.62,0:27:26.79,Default,,0,0,0,,Не?
Dialogue: 0,0:27:28.08,0:27:29.95,Default,,0,0,0,,Иә? Үйге бармайсың ба?
Dialogue: 0,0:27:30.33,0:27:31.45,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:27:31.54,0:27:33.37,Default,,0,0,0,,Сонда біз не үшінміз?
Dialogue: 0,0:27:33.58,0:27:35.50,Default,,0,0,0,,Бұл әлі әркімнің ниеті емес.
Dialogue: 0,0:27:35.58,0:27:38.45,Default,,0,0,0,,Мен оларды растау үшін жиналуды өтіндім.
Dialogue: 0,0:27:39.70,0:27:41.91,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,0:27:42.37,0:27:47.20,Default,,0,0,0,,Мен Годзилланы тазарту операциясын жоспарладым және десантшы жіберуді талап еттім.
Dialogue: 0,0:27:47.29,0:27:49.54,Default,,0,0,0,,Мен барлығын осында әкелдім.
Dialogue: 0,0:27:50.04,0:27:52.75,Default,,0,0,0,,Жерде, Леландтың қолбасшылығын алады
Dialogue: 0,0:27:52.83,0:27:55.79,Default,,0,0,0,,Нәтижесінде мен көптеген достарымнан айырылдым.
Dialogue: 0,0:27:55.87,0:27:58.29,Default,,0,0,0,,Мен бұл үшін кешірім сұрай алмаймын.
Dialogue: 0,0:27:59.54,0:28:02.62,Default,,0,0,0,,Стратегия бір рет сәтті болып көрінді.
Dialogue: 0,0:28:02.70,0:28:06.75,Default,,0,0,0,,Бірақ өздеріңіз білетіндей, біз қиялымызға келмейтін құбыжықты кездестірдік.
Dialogue: 0,0:28:07.00,0:28:08.95,Default,,0,0,0,,Шайқастан кейін көп ұзамай жеңілді
Dialogue: 0,0:28:09.08,0:28:10.20,Default,,0,0,0,,Мен оны жеңе алмаймын
Dialogue: 0,0:28:10.66,0:28:12.45,Default,,0,0,0,,Кейбір адамдар солай ойлауы мүмкін.
Dialogue: 0,0:28:12.91,0:28:15.50,Default,,0,0,0,,Шынымды айтсам, мен де солардың бірімін.
Dialogue: 0,0:28:15.95,0:28:18.33,Default,,0,0,0,,Бірақ бұл шынымен солай ма?
Dialogue: 0,0:28:18.62,0:28:20.41,Default,,0,0,0,,Ол өлмес пе?
Dialogue: 0,0:28:20.50,0:28:22.25,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:28:23.29,0:28:26.75,Default,,0,0,0,,Адамзат тарихы бірқатар қиындықтарға тап болды.
Dialogue: 0,0:28:26.83,0:28:29.54,Default,,0,0,0,,Адамдардың әр уақытта қолданатын қаруы «даналық» болды.
Dialogue: 0,0:28:30.12,0:28:33.00,Default,,0,0,0,,Біз Годзилланың туыстарын жеңдік.
Dialogue: 0,0:28:33.08,0:28:35.54,Default,,0,0,0,,Бұл адамзаттың жеңісі.
Dialogue: 0,0:28:36.29,0:28:39.62,Default,,0,0,0,,Теориялық тұрғыдан Годзилланы өлтіруге болатыны дәлелденді.
Dialogue: 0,0:28:39.70,0:28:43.41,Default,,0,0,0,,Алайда қазір керек-жарақтар мен сарбаздар тапшы.
Dialogue: 0,0:28:43.50,0:28:45.41,Default,,0,0,0,,Бұл жағдайда мүмкін емес деп ойлаймын.
Dialogue: 0,0:28:45.66,0:28:46.66,Default,,0,0,0,,Гаргу Берубе
Dialogue: 0,0:28:47.70,0:28:50.29,Default,,0,0,0,,Біз ең қуатты құралдарды алдық.
Dialogue: 0,0:28:50.37,0:28:51.20,Default,,0,0,0,,«Нанометалл»
Dialogue: 0,0:28:51.41,0:28:52.79,Default,,0,0,0,,Нанометалл?
Dialogue: 0,0:28:52.87,0:28:54.54,Default,,0,0,0,,Автономды ойлау металл денесі
Dialogue: 0,0:28:54.62,0:28:56.70,Default,,0,0,0,,Бұл Мехагодзиллаға арналған материал болса керек.
Dialogue: 0,0:28:57.04,0:28:59.95,Default,,0,0,0,,Годзилла Мехагодзилла іске қосылмай тұрып шабуыл жасайды.
Dialogue: 0,0:29:00.04,0:29:01.91,Default,,0,0,0,,Бүкіл зертхана жойылды.
Dialogue: 0,0:29:02.00,0:29:03.50,Default,,0,0,0,,Әзірлеу деректері де жоғалады.
Dialogue: 0,0:29:03.58,0:29:06.16,Default,,0,0,0,,Балалар, оны қайтадан нақтылау мүмкін емес пе еді?
Dialogue: 0,0:29:06.37,0:29:08.33,Default,,0,0,0,,Ол аман қалды
Dialogue: 0,0:29:08.41,0:29:10.58,Default,,0,0,0,,Неғұрлым дамыған түрде
Dialogue: 0,0:29:10.66,0:29:12.00,Default,,0,0,0,,Міне.
Dialogue: 0,0:29:13.08,0:29:15.12,Default,,0,0,0,,Бұл кәдімгі жебенің ұшы, солай емес пе?
Dialogue: 0,0:29:15.20,0:29:16.45,Default,,0,0,0,,Бұл нанометалл ба?
Dialogue: 0,0:29:16.54,0:29:17.37,Default,,0,0,0,,Иә.
Dialogue: 0,0:29:18.12,0:29:20.79,Default,,0,0,0,,Жергілікті тұрғындар пайдаланатын жебе ұштары мен пышақтар
Dialogue: 0,0:29:20.87,0:29:23.08,Default,,0,0,0,,Бетінің құрылымы өзгергенімен
Dialogue: 0,0:29:23.16,0:29:24.91,Default,,0,0,0,,Бұл шын мәнінде нанометалл болды.
Dialogue: 0,0:29:25.45,0:29:29.04,Default,,0,0,0,,Олар бұл ерекше металдың қасиеттерін ақылды түрде пайдаланды.
Dialogue: 0,0:29:29.12,0:29:30.25,Default,,0,0,0,,Мен қару жасадым.
Dialogue: 0,0:29:30.75,0:29:33.62,Default,,0,0,0,,Бастапқыда нанометалдар өзін-өзі емдеу үшін қолданылған.
Dialogue: 0,0:29:33.91,0:29:38.04,Default,,0,0,0,,Молекулярлық деңгейде қоршаған заттармен біріктіру және қайталану мүмкіндігі болды.
Dialogue: 0,0:29:38.83,0:29:43.50,Default,,0,0,0,,Бұл өсу қарқыны қалыпты емес, бірақ бұл ұзақ уақыт жалғыз қалуға байланысты болуы мүмкін.
Dialogue: 0,0:29:43.91,0:29:46.45,Default,,0,0,0,,Шектегіште ақау болуы керек.
Dialogue: 0,0:29:46.83,0:29:50.04,Default,,0,0,0,,Қару шеберханасында бірнеше үлкен бөлшектер болды.
Dialogue: 0,0:29:50.33,0:29:52.20,Default,,0,0,0,,Ол бір жерде жиналды.
Dialogue: 0,0:29:52.45,0:29:54.91,Default,,0,0,0,,Фудзи тауының етегіндегі Мехагодзилла зертханасы
Dialogue: 0,0:29:55.00,0:29:57.33,Default,,0,0,0,,Осы бұрынғы Танзавадан алыс емес
Dialogue: 0,0:29:57.41,0:30:00.12,Default,,0,0,0,,Түсіндім! Жер астында бір жерде қоқыс бар
Dialogue: 0,0:30:00.41,0:30:01.62,Default,,0,0,0,,Иә.
Dialogue: 0,0:30:01.95,0:30:04.29,Default,,0,0,0,,Жинайтын жерді анықтасақ
Dialogue: 0,0:30:04.37,0:30:06.75,Default,,0,0,0,,Нанометал жеткілікті болса
Dialogue: 0,0:30:07.16,0:30:08.29,Default,,0,0,0,,Хехе...
Dialogue: 0,0:30:08.37,0:30:09.87,Default,,0,0,0,,Сіз Годзилланы жеңе аласыз!
Dialogue: 0,0:30:10.29,0:30:11.41,Default,,0,0,0,,Сіз оны жеңе аласыз ба?
Dialogue: 0,0:30:11.58,0:30:15.37,Default,,0,0,0,,Мм...олай болса да, аналыққа қайта оралайық.
Dialogue: 0,0:30:15.45,0:30:17.08,Default,,0,0,0,,Кеңес беруге әлі де кеш емес.
Dialogue: 0,0:30:17.33,0:30:22.00,Default,,0,0,0,,Орталық Комитет Жерді тастап, басқа кезбе сапарға аттанатын шығар.
Dialogue: 0,0:30:22.41,0:30:26.33,Default,,0,0,0,,Қайтып келсек, Жерден сұрамай-ақ кетеміз.
Dialogue: 0,0:30:27.83,0:30:31.54,Default,,0,0,0,,Мен кеменің қатал және қорлайтын өміріне қайта оралуым керек пе?
Dialogue: 0,0:30:31.66,0:30:35.00,Default,,0,0,0,,Сіз осында қалып, Жерді қайтарып алу үшін күресті жалғастырасыз ба?
Dialogue: 0,0:30:36.33,0:30:38.04,Default,,0,0,0,,Мәжбүрлеуге арналмаған
Dialogue: 0,0:30:38.16,0:30:40.37,Default,,0,0,0,,Қайтып оралғысы келетіндердің тілектерін құрметтеңіз
Dialogue: 0,0:30:40.45,0:30:42.25,Default,,0,0,0,,Әркім, өзің шеш.
Dialogue: 0,0:30:42.62,0:30:44.04,Default,,0,0,0,,Біз шынымен жеңе аламыз ба?
Dialogue: 0,0:30:44.12,0:30:46.33,Default,,0,0,0,,Мен капитан Сакакидің тактикасымен біреуін жеңе алдым.
Dialogue: 0,0:30:46.41,0:30:47.95,Default,,0,0,0,,Қайтпасаңыз, бұл әскери тәртіпті бұзу болып табылады.
Dialogue: 0,0:30:48.29,0:30:50.75,Default,,0,0,0,,Енді балалар, не істейсіңдер?
Dialogue: 0,0:30:50.83,0:30:53.20,Default,,0,0,0,,Мен қаламын. Мен де. Мен қала беремін!
Dialogue: 0,0:30:53.37,0:30:54.91,Default,,0,0,0,,Мен қаламын!
Dialogue: 0,0:30:55.00,0:30:58.00,Default,,0,0,0,,Хмм... Әрине, бұл Бильсардо.
Dialogue: 0,0:30:58.29,0:31:01.00,Default,,0,0,0,,Енді бірден бас тарту керек
Dialogue: 0,0:31:01.08,0:31:04.70,Default,,0,0,0,,Біріншіден, біз Мехагодзилланың қалдықтарын жинап, оны зерттеуіміз керек.
Dialogue: 0,0:31:04.95,0:31:07.58,Default,,0,0,0,,Годзилламен қайтадан күресу керек пе, жоқ па
Dialogue: 0,0:31:07.83,0:31:10.58,Default,,0,0,0,,Өзгертілген нанометалдың тиімділігін тексергеннен кейін
Dialogue: 0,0:31:10.66,0:31:12.04,Default,,0,0,0,,Бар болғаны төрелік ету
Dialogue: 0,0:31:12.16,0:31:16.00,Default,,0,0,0,,Жай ғана берілсек, өлген адамдар ешқашан ойға келмейді.
Dialogue: 0,0:31:17.45,0:31:19.29,Default,,0,0,0,,Мен қаламын!
Dialogue: 0,0:31:19.37,0:31:22.12,Default,,0,0,0,,Әй, қашып кетсең құтыларсың.
Dialogue: 0,0:31:22.20,0:31:26.25,Default,,0,0,0,,Өмір бойы өкінішпен ұзақ өмір сүре алмаймын.
Dialogue: 0,0:31:26.41,0:31:30.16,Default,,0,0,0,,Мен қаламын. Мен де. Мен де қаламын.
Dialogue: 0,0:31:32.91,0:31:33.83,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:31:43.25,0:31:45.75,Default,,0,0,0,,Дәрігердің қайтып келмегені жақсы болды ма?
Dialogue: 0,0:31:45.91,0:31:48.79,Default,,0,0,0,,Бұл зерттеу материалдарының қазынасы.
Dialogue: 0,0:31:49.12,0:31:49.95,Default,,0,0,0,,Харуо
Dialogue: 0,0:31:50.45,0:31:52.37,Default,,0,0,0,,Нанометалдардың қайда екенін анықтайық.
Dialogue: 0,0:31:52.45,0:31:53.29,Default,,0,0,0,,О
Dialogue: 0,0:31:53.45,0:31:55.33,Default,,0,0,0,,(Жоғары жиілікті дыбыс)
Dialogue: 0,0:31:55.62,0:31:57.54,Default,,0,0,0,,Маған айнала көрсетеді деген рас па?
Dialogue: 0,0:31:57.62,0:31:59.00,Default,,0,0,0,,Сенейік
Dialogue: 0,0:32:08.95,0:32:10.45,Default,,0,0,0,,Хаа
Dialogue: 0,0:32:11.00,0:32:12.33,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:32:13.62,0:32:15.25,Default,,0,0,0,,Бұл жеңіл мүктің колониясы ма?
Dialogue: 0,0:32:17.00,0:32:18.12,Default,,0,0,0,,Капитан Сакаки
Dialogue: 0,0:32:18.20,0:32:19.04,Default,,0,0,0,,Не ол?
Dialogue: 0,0:32:19.20,0:32:20.66,Default,,0,0,0,,Бұл қалыпты өмір туралы.
Dialogue: 0,0:32:21.50,0:32:23.37,Default,,0,0,0,,Денелеріне ұнтақ
Dialogue: 0,0:32:23.95,0:32:25.29,Default,,0,0,0,,Мен мұны қарастырдым.
Dialogue: 0,0:32:25.83,0:32:28.75,Default,,0,0,0,,Футуаның кейбір гендері жәндіктер болса керек.
Dialogue: 0,0:32:29.29,0:32:30.91,Default,,0,0,0,,Ол да мутацияға ұшыраған.
Dialogue: 0,0:32:31.12,0:32:32.00,Default,,0,0,0,,На
Dialogue: 0,0:32:32.50,0:32:35.66,Default,,0,0,0,,Футуа адам генін мұра еткен болса да
Dialogue: 0,0:32:35.75,0:32:37.50,Default,,0,0,0,,Осының өзі мұндай эволюцияны тудырмайды.
Dialogue: 0,0:32:38.20,0:32:40.75,Default,,0,0,0,,Жердегі экожүйе Годзиллаға айналғандай
Dialogue: 0,0:32:41.66,0:32:44.79,Default,,0,0,0,,Менің ойымша, оның қандай да бір құбыжық факторы бар.
Dialogue: 0,0:32:46.29,0:32:47.70,Default,,0,0,0,,Құбыжық...
Dialogue: 0,0:32:47.79,0:32:48.75,Default,,0,0,0,,Хмм
Dialogue: 0,0:33:05.04,0:33:05.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:10.54,0:33:14.33,Default,,0,0,0,,Ефрейтор Марко Джоне және тағы екі адам жаңа ғана оралды.
Dialogue: 0,0:33:14.54,0:33:17.20,Default,,0,0,0,,Мұның бәрі ме? Басқаларына не болды?
Dialogue: 0,0:33:17.37,0:33:19.91,Default,,0,0,0,,(Шинсоның дем алған дыбысы)
Dialogue: 0,0:33:20.50,0:33:22.87,Default,,0,0,0,,Сіз нені айтасыз? Жауап!
Dialogue: 0,0:33:23.20,0:33:25.50,Default,,0,0,0,,Капитан Сакаки тағы да?
Dialogue: 0,0:33:26.66,0:33:28.16,Default,,0,0,0,,Құбыжық факторы…
Dialogue: 0,0:33:28.45,0:33:30.66,Default,,0,0,0,,Ең қиыны неде
Dialogue: 0,0:33:30.87,0:33:33.25,Default,,0,0,0,,Жердегі экожүйенің өзі
Dialogue: 0,0:33:33.37,0:33:34.29,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:33:34.66,0:33:35.79,Default,,0,0,0,,Бұл экожүйе
Dialogue: 0,0:33:35.87,0:33:39.75,Default,,0,0,0,,Сайып келгенде, тек бір адамға қызмет көрсетуге арналған.
Dialogue: 0,0:33:40.00,0:33:43.08,Default,,0,0,0,,Барлық тірі заттар... қызмет етеді.
Dialogue: 0,0:33:43.16,0:33:44.16,Default,,0,0,0,,Годзилла, иә?
Dialogue: 0,0:33:44.87,0:33:46.50,Default,,0,0,0,,Жердің қазіргі экожүйесі
Dialogue: 0,0:33:46.62,0:33:50.29,Default,,0,0,0,,Барлығы сол бір Годзиллаға қызмет ететіндей құрылымдалған.
Dialogue: 0,0:33:50.79,0:33:53.00,Default,,0,0,0,,Жер - барлық заттардың приматы.
Dialogue: 0,0:33:53.08,0:33:56.08,Default,,0,0,0,,Адамнан гөрі сол жігітті таңдады деп ойламаймын.
Dialogue: 0,0:33:56.79,0:33:59.16,Default,,0,0,0,,Жерде Годзилла бар...
Dialogue: 0,0:33:59.62,0:34:02.00,Default,,0,0,0,,Көмірқышқыл газының әсерінен жаһандық жылыну
Dialogue: 0,0:34:02.12,0:34:03.04,Default,,0,0,0,,Ластанумен ластану
Dialogue: 0,0:34:03.25,0:34:06.79,Default,,0,0,0,,Жарыс қарулану кезінде атом және сутегі бомбаларын қайталап сынау
Dialogue: 0,0:34:07.29,0:34:09.37,Default,,0,0,0,,Қоршаған ортаның мұндай бүлінуінің жинақталуы
Dialogue: 0,0:34:09.62,0:34:12.83,Default,,0,0,0,,Бұл құбыжықтардың пайда болуына әкелген қалыптасқан теория.
Dialogue: 0,0:34:13.54,0:34:17.00,Default,,0,0,0,,Өркениет жойылса, табиғи орта баяу қалпына келеді.
Dialogue: 0,0:34:17.25,0:34:19.83,Default,,0,0,0,,Мен бәрі бұрынғы қалпына келеді деп ойладым.
Dialogue: 0,0:34:20.70,0:34:23.79,Default,,0,0,0,,Алайда шындық мүлде керісінше болып көрінеді.
Dialogue: 0,0:34:23.95,0:34:25.08,Default,,0,0,0,,Жер қазірдің өзінде бар
Dialogue: 0,0:34:25.29,0:34:28.37,Default,,0,0,0,,Мен қайтымсыз өзгердім.
Dialogue: 0,0:34:28.83,0:34:30.91,Default,,0,0,0,,Өйткені, Годзилла жеңу керек.
Dialogue: 0,0:34:31.75,0:34:33.66,Default,,0,0,0,,Бұл біздің адамдық жауапкершілігіміз.
Dialogue: 0,0:34:33.75,0:34:35.20,Default,,0,0,0,,(сигнал үні)
Dialogue: 0,0:34:35.66,0:34:37.45,Default,,0,0,0,,Әй, бұл!
Dialogue: 0,0:34:38.20,0:34:39.62,Default,,0,0,0,,Жарайды, абайлайық.
Dialogue: 0,0:34:40.12,0:34:40.95,Default,,0,0,0,,Не болды?
Dialogue: 0,0:34:41.04,0:34:43.79,Default,,0,0,0,,Харуо, мен осы жерден ерекше сигнал таптым.
Dialogue: 0,0:34:43.87,0:34:44.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:45.20,0:34:48.41,Default,,0,0,0,,Мұндай нәрсені тек Мехагодзилла ғана жібере алады.
Dialogue: 0,0:34:48.62,0:34:49.45,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:34:49.54,0:34:52.66,Default,,0,0,0,,Біздің Мехагодзилла тірі!
Dialogue: 0,0:34:52.75,0:34:54.29,Default,,0,0,0,,(Жоғары жиілікті дыбыс)
Dialogue: 0,0:34:54.58,0:34:55.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:55.70,0:34:56.58,Default,,0,0,0,,О
Dialogue: 0,0:34:57.08,0:34:58.41,Default,,0,0,0,,Шығуға ұқсайды
Dialogue: 0,0:35:04.37,0:35:05.95,Default,,0,0,0,,(Сельвамның айқайы)
Dialogue: 0,0:35:06.04,0:35:06.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:09.50,0:35:10.54,Default,,0,0,0,,Сол жігіттер тағы да?
Dialogue: 0,0:35:10.75,0:35:11.66,Default,,0,0,0,,Мен сені атып тастаймын!
Dialogue: 0,0:35:11.75,0:35:12.58,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:35:14.33,0:35:15.16,Default,,0,0,0,,Юуко!
Dialogue: 0,0:35:19.12,0:35:19.95,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:35:25.41,0:35:26.33,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:35:37.83,0:35:39.62,Default,,0,0,0,,Сіз оны көрдіңіз бе? Иә
Dialogue: 0,0:35:39.79,0:35:41.75,Default,,0,0,0,,Бұл эволюцияның қандай түрі?
Dialogue: 0,0:35:43.95,0:35:45.75,Default,,0,0,0,,Міне! Өтінемін келіңіз!
Dialogue: 0,0:35:50.20,0:35:51.62,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:35:53.79,0:35:54.83,Default,,0,0,0,,Өтірікші...
Dialogue: 0,0:35:58.00,0:36:01.58,Default,,0,0,0,,Әй, бұл... қала ма?
Dialogue: 0,0:36:01.70,0:36:04.25,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:36:07.04,0:36:07.95,Default,,0,0,0,,Ha
Dialogue: 0,0:36:10.04,0:36:13.08,Default,,0,0,0,,Мұның бәрі нанометалл.
Dialogue: 0,0:36:13.70,0:36:15.00,Default,,0,0,0,,Жер бетінде қалай?
Dialogue: 0,0:36:15.41,0:36:17.29,Default,,0,0,0,,Осындай үлкен сома!
Dialogue: 0,0:36:18.08,0:36:21.33,Default,,0,0,0,,Көбейту үшін 20 000 жыл қажет болды.
Dialogue: 0,0:36:21.95,0:36:23.79,Default,,0,0,0,,Мехагодзилланың қалдықтарынан
Dialogue: 0,0:36:24.41,0:36:26.12,Default,,0,0,0,,Иә, дәл
Dialogue: 0,0:36:28.20,0:36:30.12,Default,,0,0,0,,«Мехагодзилла қаласы»
Dialogue: 0,0:36:32.45,0:36:34.62,Default,,0,0,0,,Бұл Мехагодзилла...
Dialogue: 0,0:36:35.04,0:36:37.70,Default,,0,0,0,,Сіздің келесі баратын жеріңіз — Сан-Джорджо-Маджоре аралы
Dialogue: 0,0:36:39.58,0:36:42.79,Default,,0,0,0,,Сигнал көзі алда.
Dialogue: 0,0:36:43.62,0:36:45.79,Default,,0,0,0,,Годзилла басқаратын бұл планетада
Dialogue: 0,0:36:45.87,0:36:47.75,Default,,0,0,0,,Мен қожайынымнан айырылсам да,
Dialogue: 0,0:36:47.87,0:36:51.83,Default,,0,0,0,,Біздің Мехагодзилла осы жерде күресті жалғастырды.
Dialogue: 0,0:36:51.91,0:36:52.83,Default,,0,0,0,,Ha
Dialogue: 0,0:36:58.04,0:36:59.08,Default,,0,0,0,,Кеттік, Харуо.
Dialogue: 0,0:36:59.16,0:37:00.08,Default,,0,0,0,,О
Dialogue: 0,0:37:01.16,0:37:02.20,Default,,0,0,0,,(Жоғары жиілікті дыбыс)
Dialogue: 0,0:37:02.33,0:37:03.16,Default,,0,0,0,,Ах
Dialogue: 0,0:37:04.20,0:37:05.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:05.70,0:37:08.79,Default,,0,0,0,,Бұл қалыпты жағдай. Мен егіз бала тумағанын байқадым.
Dialogue: 0,0:37:11.83,0:37:14.79,Default,,0,0,0,,Осы уақытқа дейін рахмет, қазір оралыңыз.
Dialogue: 0,0:37:15.54,0:37:19.54,Default,,0,0,0,,Әлгі алдамшы зат, у.
Dialogue: 0,0:37:19.91,0:37:20.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:21.83,0:37:23.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:37:30.08,0:37:31.58,Default,,0,0,0,,Олар қандай?
Dialogue: 0,0:37:32.37,0:37:34.58,Default,,0,0,0,,У... шамасы.
Dialogue: 0,0:37:35.70,0:37:38.08,Default,,0,0,0,,У...?
Dialogue: 0,0:37:47.00,0:37:49.41,Default,,0,0,0,,Бұл да нанометалға жасалған.
Dialogue: 0,0:37:49.50,0:37:50.33,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:37:50.62,0:37:53.20,Default,,0,0,0,,Сол қала тәрізді құрылымның материалы қандай?
Dialogue: 0,0:37:53.29,0:37:56.66,Default,,0,0,0,,Ол қоректенетін жасушалардан металл элементтермен қамтамасыз етіледі.
Dialogue: 0,0:37:57.41,0:37:59.66,Default,,0,0,0,,Менің ойымша, бәрі жер астында байланысты.
Dialogue: 0,0:38:00.25,0:38:04.25,Default,,0,0,0,,Ол 20 000 жыл бойы импортталады ма?
Dialogue: 0,0:38:04.45,0:38:07.37,Default,,0,0,0,,Бізді де қабылдамайды деп ойлаймын.
Dialogue: 0,0:38:07.58,0:38:08.58,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:38:08.79,0:38:10.33,Default,,0,0,0,,Мына балаларды жұтып қой
Dialogue: 0,0:38:10.79,0:38:13.75,Default,,0,0,0,,Мен Годзилланы жеңу туралы бұйрықтарды орындап жатырмын.
Dialogue: 0,0:38:13.95,0:38:15.95,Default,,0,0,0,,(Жарылу дыбысы)
Dialogue: 0,0:38:16.12,0:38:19.12,Default,,0,0,0,,Нанометалл бетінен газ шығады
Dialogue: 0,0:38:19.45,0:38:21.41,Default,,0,0,0,,Бұл аспанда бұлттарды тудырады
Dialogue: 0,0:38:21.75,0:38:25.62,Default,,0,0,0,,Бұл аймақты жасыратын термооптикалық камуфляждың бір түрі.
Dialogue: 0,0:38:25.87,0:38:29.29,Default,,0,0,0,,Оны да таба алмағанымыз таңқаларлық емес.
Dialogue: 0,0:38:35.00,0:38:36.00,Default,,0,0,0,,Хехе...
Dialogue: 0,0:38:36.29,0:38:38.41,Default,,0,0,0,,Бұл басым емес деп ойлайсыз ба?
Dialogue: 0,0:38:39.04,0:38:40.70,Default,,0,0,0,,Бұл нысан...
Dialogue: 0,0:38:41.54,0:38:44.58,Default,,0,0,0,,Дұрыс, бұл Mechagodzilla өңдеу зауыты!
Dialogue: 0,0:38:44.79,0:38:47.54,Default,,0,0,0,,Дұрыс, бұл оның көшірмесі.
Dialogue: 0,0:38:47.79,0:38:51.75,Default,,0,0,0,,Көбею? Бірақ мұндай масштабта?
Dialogue: 0,0:38:51.95,0:38:54.62,Default,,0,0,0,,Өздігінен ол кездегіден жүздеген есеге дейін өсті.
Dialogue: 0,0:38:54.70,0:38:57.12,Default,,0,0,0,,Пәрмен күткендей жұмыс істеп тұрған сияқты.
Dialogue: 0,0:38:57.33,0:38:58.16,Default,,0,0,0,,Хмм
Dialogue: 0,0:38:59.37,0:39:00.83,Default,,0,0,0,,Сіз дулығаңызды сақтай аласыз.
Dialogue: 0,0:39:01.04,0:39:02.83,Default,,0,0,0,,Қоршаған ортаны күту пәрмені де тірі сияқты.
Dialogue: 0,0:39:03.16,0:39:06.20,Default,,0,0,0,,Қаланың айналасындағы атмосфера бізге бейімделген.
Dialogue: 0,0:39:06.83,0:39:09.83,Default,,0,0,0,,Дегенмен, бұл біртүрлі құрылым.
Dialogue: 0,0:39:10.20,0:39:12.20,Default,,0,0,0,,Бұл Мехагодзилла, иә?
Dialogue: 0,0:39:12.45,0:39:13.70,Default,,0,0,0,,Барлық жерде
Dialogue: 0,0:39:13.79,0:39:16.12,Default,,0,0,0,,Мехагодзилла бөліктерінен құралған
Dialogue: 0,0:39:16.62,0:39:21.20,Default,,0,0,0,,Бұл мен ойлағаннан да көп эволюция, хехехе...
Dialogue: 0,0:39:22.12,0:39:24.54,Default,,0,0,0,,Егер мұның барлығын бөліктер ретінде өзгертуге болатын болса
Dialogue: 0,0:39:25.04,0:39:27.54,Default,,0,0,0,,Мехагодзилланы қайтадан жинау мүмкін емес пе?
Dialogue: 0,0:39:27.95,0:39:29.58,Default,,0,0,0,,Тіпті олай емес.
Dialogue: 0,0:39:29.75,0:39:31.58,Default,,0,0,0,,Тіпті одан да батыл жоспарлар...
Dialogue: 0,0:39:32.08,0:39:35.95,Default,,0,0,0,,Иә, дерек көзі осы ғимараттың ішінде.
Dialogue: 0,0:39:36.16,0:39:38.08,Default,,0,0,0,,Сол кездегі команда кодын пайдалануға болады ма?
Dialogue: 0,0:39:38.29,0:39:39.41,Default,,0,0,0,,Мүмкін болуы керек.
Dialogue: 0,0:39:54.41,0:39:55.79,Default,,0,0,0,,Сіз кіресіз бе?
Dialogue: 0,0:39:55.87,0:39:58.95,Default,,0,0,0,,Қалай болғанда да ішкі тергеу қажет.
Dialogue: 0,0:39:59.87,0:40:00.87,Default,,0,0,0,,Кеттік
Dialogue: 0,0:40:02.58,0:40:06.33,Default,,0,0,0,,Мен құбыжықтың ішіне кіріп бара жатқандай сезінемін.
Dialogue: 0,0:40:13.08,0:40:13.91,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:40:14.50,0:40:15.95,Default,,0,0,0,,Бұл дереккөз
Dialogue: 0,0:40:23.66,0:40:24.50,Default,,0,0,0,,Сенпай?
Dialogue: 0,0:40:25.25,0:40:26.37,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:40:27.29,0:40:28.20,Default,,0,0,0,,Хааа!
Dialogue: 0,0:40:28.62,0:40:30.66,Default,,0,0,0,,Мен бұны ешқашан күтпеген едім...
Dialogue: 0,0:40:31.62,0:40:34.37,Default,,0,0,0,,Нанометалдар адамға шабуыл жасамайды!
Dialogue: 0,0:40:34.54,0:40:35.79,Default,,0,0,0,,Тірі болғанша
Dialogue: 0,0:40:36.33,0:40:40.00,Default,,0,0,0,,Бұл сол кезде қашып құтыла алмағандардың денесімен ассимиляцияланған болуы керек.
Dialogue: 0,0:40:40.50,0:40:42.50,Default,,0,0,0,,Мұның жақсы екеніне сенімдісіз бе?
Dialogue: 0,0:40:47.83,0:40:49.00,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:40:49.75,0:40:50.58,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:41:01.54,0:41:02.45,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:41:03.37,0:41:04.75,Default,,0,0,0,,Бұл дереккөз бе?
Dialogue: 0,0:41:10.95,0:41:13.70,Default,,0,0,0,,Беті нанометаллмен жабылған ба?
Dialogue: 0,0:41:18.12,0:41:20.37,Default,,0,0,0,,Мехагодзилланың қалдықтары...
Dialogue: 0,0:41:20.66,0:41:23.54,Default,,0,0,0,,Жоқ, бұл жай ғана қоқыс емес.
Dialogue: 0,0:41:24.12,0:41:26.95,Default,,0,0,0,,Сигнал әлі басынан келе жатты.
Dialogue: 0,0:41:27.29,0:41:28.83,Default,,0,0,0,,Жасанды интеллект бөлімі
Dialogue: 0,0:41:29.04,0:41:31.00,Default,,0,0,0,,Блоктардың жартысы тірі
Dialogue: 0,0:41:31.25,0:41:32.58,Default,,0,0,0,,Басқаруға болады
Dialogue: 0,0:41:32.66,0:41:33.50,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:41:58.00,0:42:01.37,Default,,0,0,0,,Хехе мен барамын, барамын.
Dialogue: 0,0:42:02.00,0:42:03.16,Default,,0,0,0,,Бұл...
Dialogue: 0,0:42:03.66,0:42:06.41,Default,,0,0,0,,Мехагодзилланың жасанды интеллектіне қол жеткізіңіз
Dialogue: 0,0:42:06.50,0:42:08.79,Default,,0,0,0,,Басқару блогын қалпына келтіру
Dialogue: 0,0:42:09.12,0:42:11.37,Default,,0,0,0,,Оның денесін Годзилла жойды, бірақ
Dialogue: 0,0:42:11.54,0:42:14.70,Default,,0,0,0,,Лақтырылған бас шайқасын тоқтатқан жоқ.
Dialogue: 0,0:42:15.29,0:42:17.33,Default,,0,0,0,,Және осы жерде
Dialogue: 0,0:42:17.50,0:42:19.04,Default,,0,0,0,,Шамамен 20 000 жыл
Dialogue: 0,0:42:19.37,0:42:21.37,Default,,0,0,0,,Нанометалдармен жалғасатын пролиферация
Dialogue: 0,0:42:21.50,0:42:23.79,Default,,0,0,0,,Мен бұл қаланы салдым.
Dialogue: 0,0:42:25.66,0:42:28.41,Default,,0,0,0,,
Dialogue: 0,0:42:32.00,0:42:34.50,Default,,0,0,0,,Неліктен бұл жерде үлкен ойық бар...
Dialogue: 0,0:42:34.79,0:42:37.25,Default,,0,0,0,,Бұл Годзилла өзінің жылу сәулелерімен жасаған тесік.
Dialogue: 0,0:42:37.87,0:42:38.91,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:42:39.04,0:42:43.25,Default,,0,0,0,,Ол 200 метр жер астында жатқан осы құрылыс нысанын түгел өртеп жіберді.
Dialogue: 0,0:42:43.83,0:42:46.70,Default,,0,0,0,,730 жерлесімізбен.
Dialogue: 0,0:42:46.79,0:42:47.75,Default,,0,0,0,,
Dialogue: 0,0:42:48.20,0:42:49.91,Default,,0,0,0,,Қандай жойқын күш!
Dialogue: 0,0:42:50.70,0:42:52.25,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:42:52.54,0:42:55.00,Default,,0,0,0,,Қазір оның бойы шамамен 6 есе жоғары.
Dialogue: 0,0:42:55.08,0:42:57.16,Default,,0,0,0,,Масса оның кубына тең
Dialogue: 0,0:42:57.45,0:43:00.91,Default,,0,0,0,,Егер бір ұяшықтағы электр қуатын өндіру бұрынғымен бірдей болса.
Dialogue: 0,0:43:01.12,0:43:01.95,Default,,0,0,0,,Жылу сәулелерінің қуаты...
Dialogue: 0,0:43:02.04,0:43:03.29,Default,,0,0,0,,Тоқта, Метфис.
Dialogue: 0,0:43:04.58,0:43:07.08,Default,,0,0,0,,Олар кездескісі келеді.
Dialogue: 0,0:43:07.50,0:43:09.16,Default,,0,0,0,,Менің айтқым келгені
Dialogue: 0,0:43:09.37,0:43:12.12,Default,,0,0,0,,Годзиллаға қарсы ескі қару жаңарған кезде
Dialogue: 0,0:43:12.29,0:43:15.20,Default,,0,0,0,,Менің болжауым бойынша, ол қазіргі күйінде пайдалы болмайды.
Dialogue: 0,0:43:15.79,0:43:17.00,Default,,0,0,0,,Годзиллаға қарсы қару?
Dialogue: 0,0:43:17.62,0:43:20.91,Default,,0,0,0,,Мұндай шектеулі стратегия енді қажет емес.
Dialogue: 0,0:43:21.20,0:43:23.91,Default,,0,0,0,,Егер барлық көбейген нанометалдар жұмылдырылса,
Dialogue: 0,0:43:24.16,0:43:27.66,Default,,0,0,0,,Біз үлкен физикалық операцияларды жасай аламыз.
Dialogue: 0,0:43:28.29,0:43:29.33,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:43:29.66,0:43:32.50,Default,,0,0,0,,Жарайды, алдымен қарым-қатынасты қамтамасыз етейік.
Dialogue: 0,0:43:34.12,0:43:36.95,Default,,0,0,0,,Харуо базалық лагерімен байланыс қалпына келтірілді.
Dialogue: 0,0:43:37.08,0:43:37.95,Default,,0,0,0,,Осы жерден
Dialogue: 0,0:43:38.16,0:43:39.79,Default,,0,0,0,,Сіз сондай-ақ аналық кемемен байланыса алуыңыз керек.
Dialogue: 0,0:43:39.91,0:43:42.62,Default,,0,0,0,,Жарайды, біз Футуа ауылын көшіреміз.
Dialogue: 0,0:43:43.37,0:43:44.75,Default,,0,0,0,,Біз осы жерденміз
Dialogue: 0,0:43:44.83,0:43:47.20,Default,,0,0,0,,Бұл қалада барлығын кластерлік бақылауға болады.
Dialogue: 0,0:43:47.54,0:43:49.83,Default,,0,0,0,,Қала құрылымының өзін нығайту
Dialogue: 0,0:43:50.04,0:43:51.95,Default,,0,0,0,,Үлкен тұзақ құрыңыз
Dialogue: 0,0:43:52.58,0:43:54.16,Default,,0,0,0,,Бұл бүкіл қала
Dialogue: 0,0:43:54.25,0:43:57.58,Default,,0,0,0,,Годзилланы өлтіру үшін оны орындау құрылғысына айналдырыңыз
Dialogue: 0,0:43:57.79,0:43:59.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:59.75,0:44:00.79,Default,,0,0,0,,Хехехе
Dialogue: 0,0:44:01.66,0:44:03.33,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:44:04.25,0:44:07.25,Default,,0,0,0,,Годзилла болса да
Dialogue: 0,0:44:08.83,0:44:12.20,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:44:12.83,0:44:14.37,Default,,0,0,0,,Күте тұрыңыз, капитан Сакаки.
Dialogue: 0,0:44:14.50,0:44:16.29,Default,,0,0,0,,Сіз әлі де Годзилламен күресуді жоспарлап жүрсіз бе?
Dialogue: 0,0:44:16.58,0:44:17.87,Default,,0,0,0,,Бұл жолы біз жеңеміз!
Dialogue: 0,0:44:18.41,0:44:20.04,Default,,0,0,0,,Тактика қате болған жоқ.
Dialogue: 0,0:44:20.25,0:44:21.58,Default,,0,0,0,,Мұның бәрі ауқымды мәселе.
Dialogue: 0,0:44:21.79,0:44:24.91,Default,,0,0,0,,Бізде оны жабуға жеткілікті.
Dialogue: 0,0:44:25.12,0:44:26.79,Default,,0,0,0,,А...бірақ
Dialogue: 0,0:44:26.87,0:44:28.00,Default,,0,0,0,,Годзилланың бағынуы
Dialogue: 0,0:44:28.08,0:44:31.33,Default,,0,0,0,,Егер ол қандай да бір жолмен комитеттің саясатына қайшы келсе.
Dialogue: 0,0:44:31.54,0:44:34.95,Default,,0,0,0,,Мен кез келген жазаны қабылдауға дайынмын.
Dialogue: 0,0:44:35.04,0:44:36.12,Default,,0,0,0,,Капитан Сакаки...
Dialogue: 0,0:44:36.20,0:44:37.04,Default,,0,0,0,,(Байланысты ажырату дыбысы)
Dialogue: 0,0:44:37.70,0:44:38.91,Default,,0,0,0,,Хаа… (электронды дыбыс)
Dialogue: 0,0:44:39.58,0:44:41.54,Default,,0,0,0,,Аналық кемеден капитан деректері
Dialogue: 0,0:44:41.66,0:44:44.83,Default,,0,0,0,,Бұл Годзилладан шыққан ерекше тербеліс толқынының траекториясы.
Dialogue: 0,0:44:45.29,0:44:47.33,Default,,0,0,0,,Менің қозғалмағаныма көп болды.
Dialogue: 0,0:44:47.50,0:44:49.33,Default,,0,0,0,,Кейде есіме түскендей оянамын.
Dialogue: 0,0:44:49.45,0:44:51.20,Default,,0,0,0,,Олар аймақты айналып жүрген сияқты.
Dialogue: 0,0:44:51.66,0:44:53.95,Default,,0,0,0,,Ол осы жерде кезіп жүрді.
Dialogue: 0,0:44:54.20,0:44:56.66,Default,,0,0,0,,Мүмкін бұл жерді іздегендіктен шығар.
Dialogue: 0,0:44:57.50,0:45:01.45,Default,,0,0,0,,Годзилла біз біріншісін жеңгеннен кейін бірден пайда болды.
Dialogue: 0,0:45:01.95,0:45:04.45,Default,,0,0,0,,Мына жерде бірдеңе болып жатыр.
Dialogue: 0,0:45:04.54,0:45:06.45,Default,,0,0,0,,Оны да бұлдыр сезеді.
Dialogue: 0,0:45:07.00,0:45:09.33,Default,,0,0,0,,Ол қазір бетперде бұлтының артында жасырылған болса да
Dialogue: 0,0:45:09.54,0:45:11.37,Default,,0,0,0,,Сіз оны қаланы іске қосқан кезде таба аласыз, солай ма?
Dialogue: 0,0:45:11.83,0:45:14.16,Default,,0,0,0,,Ол сізді тапқанша тез әрекет етуден басқа амалыңыз жоқ.
Dialogue: 0,0:45:14.95,0:45:17.33,Default,,0,0,0,,Гарг қаласы уақытында нығайта ма?
Dialogue: 0,0:45:17.70,0:45:18.75,Default,,0,0,0,,Әрине.
Dialogue: 0,0:45:31.08,0:45:33.70,Default,,0,0,0,,Тіпті ішкі дәлдік схемалары сканерленіп жатыр.
Dialogue: 0,0:45:34.16,0:45:37.29,Default,,0,0,0,,Қозғалтқыштың қаңқа құрылысы, сауыттары және ішкі механизмдері
Dialogue: 0,0:45:37.41,0:45:39.12,Default,,0,0,0,,Ұшқыштың сипаттамалары бойынша
Dialogue: 0,0:45:39.20,0:45:41.08,Default,,0,0,0,,Қалағаныңызша теңшеуге болады
Dialogue: 0,0:45:41.50,0:45:43.54,Default,,0,0,0,,Ал жинақталған электр энергиясының мөлшері термоядролық реактормен салыстырылады.
Dialogue: 0,0:45:43.91,0:45:46.91,Default,,0,0,0,,Керемет, бұл сізге үш еседен астам серпін береді.
Dialogue: 0,0:45:47.16,0:45:50.12,Default,,0,0,0,,Бірақ бұл мағынасыз, өйткені ұшқыш оны басқара алмайды.
Dialogue: 0,0:45:50.25,0:45:54.12,Default,,0,0,0,,Барлығы механикаландырылған болса, адам ағзасына түсетін салмақты қарастырудың қажеті жоқ.
Dialogue: 0,0:45:54.62,0:45:55.54,Default,,0,0,0,,Әрине
Dialogue: 0,0:45:55.66,0:45:58.70,Default,,0,0,0,,Бірақ қашықтан басқару пульті арқылы секундтың оннан бірнеше бөлігіне кідіріс жоқ па?
Dialogue: 0,0:45:58.83,0:46:00.37,Default,,0,0,0,,Ол толығымен механикаландырылған.
Dialogue: 0,0:46:00.87,0:46:02.45,Default,,0,0,0,,Бұл туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:46:03.70,0:46:06.16,Default,,0,0,0,,Мен жаңа ғана маған қосылуыңызды сұрадым. Кешіріңіз.
Dialogue: 0,0:46:06.70,0:46:09.04,Default,,0,0,0,,Стратегияның қорытындысын қайта тексеріңіз
Dialogue: 0,0:46:09.91,0:46:13.00,Default,,0,0,0,,Бұл стратегия алдыңғы стратегияны қолдану болып табылады.
Dialogue: 0,0:46:13.58,0:46:16.75,Default,,0,0,0,,Сұрақ стратегияны қайда қолдану керек.
Dialogue: 0,0:46:17.37,0:46:18.54,Default,,0,0,0,,Бұл қала
Dialogue: 0,0:46:20.29,0:46:21.54,Default,,0,0,0,,Сіз оны осында тартасыз ба?
Dialogue: 0,0:46:21.62,0:46:23.62,Default,,0,0,0,,Мұндай құбыжықпен жақын күресу керек пе?
Dialogue: 0,0:46:23.95,0:46:25.91,Default,,0,0,0,,Осы Мехагодзилла қаласының ішінде
Dialogue: 0,0:46:26.04,0:46:28.95,Default,,0,0,0,,Барлық өндірілген энергияны шоғырландыруға болады
Dialogue: 0,0:46:29.12,0:46:31.16,Default,,0,0,0,,Қала бекінгеннен кейін
Dialogue: 0,0:46:31.25,0:46:33.08,Default,,0,0,0,,Термооптикалық камуфляж бұлтын алып тастаңыз
Dialogue: 0,0:46:33.58,0:46:36.50,Default,,0,0,0,,Таудың жанында әзірленуде жылжымалы қаруды орналастыру.
Dialogue: 0,0:46:36.66,0:46:38.29,Default,,0,0,0,,Тұзақ нүктесіне бағыттау
Dialogue: 0,0:46:38.41,0:46:39.58,Default,,0,0,0,,Жылжымалы қару?
Dialogue: 0,0:46:39.79,0:46:41.04,Default,,0,0,0,,Берубе бұл
Dialogue: 0,0:46:41.12,0:46:41.95,Default,,0,0,0,,Га
Dialogue: 0,0:46:42.87,0:46:46.33,Default,,0,0,0,,Бұл нанометалдармен нығайтылған бар қару.
Dialogue: 0,0:46:47.08,0:46:49.87,Default,,0,0,0,,Ал мынау... дайын өнім.
Dialogue: 0,0:46:49.95,0:46:50.79,Default,,0,0,0,,
Dialogue: 0,0:46:51.29,0:46:55.95,Default,,0,0,0,,Қорғаныс күші, шабуыл күші және ұтқырлығы айтарлықтай жақсарды.
Dialogue: 0,0:46:56.04,0:46:57.75,Default,,0,0,0,,Және ұшу мүмкіндігі қосылды.
Dialogue: 0,0:46:58.37,0:47:01.33,Default,,0,0,0,,Біз бұны «Құлғын» деп атадық.
Dialogue: 0,0:47:01.70,0:47:05.20,Default,,0,0,0,,Бұл лашын Годзилланы қанықтыру шабуылымен тежейді.
Dialogue: 0,0:47:05.41,0:47:06.66,Default,,0,0,0,,Тұзақ нүктесіне бағыттау
Dialogue: 0,0:47:07.25,0:47:11.20,Default,,0,0,0,,Жер асты нанометалл тамырында түзу жол пайда болады.
Dialogue: 0,0:47:11.37,0:47:13.58,Default,,0,0,0,,Оны бірден түсіру нүктесіне жеткізіңіз
Dialogue: 0,0:47:14.08,0:47:16.79,Default,,0,0,0,,Жылу сәулелеріне, ламинатталған термиялық құрыш тақталарына және
Dialogue: 0,0:47:16.87,0:47:20.66,Default,,0,0,0,,Нанометалл бөлшектерінің ауада дисперсиясы арқылы жылу энергиясының буферлік аймағын құру
Dialogue: 0,0:47:20.75,0:47:21.83,Default,,0,0,0,,әйтеуір шыдап тұр
Dialogue: 0,0:47:22.54,0:47:24.37,Default,,0,0,0,,Дегенмен, бұл жылдамдық ойыны.
Dialogue: 0,0:47:24.58,0:47:27.75,Default,,0,0,0,,Сұйықталған нанометалмен толтырылған түсіру нүктесі
Dialogue: 0,0:47:27.83,0:47:29.12,Default,,0,0,0,,Бұл оны тоқтатады.
Dialogue: 0,0:47:29.50,0:47:31.91,Default,,0,0,0,,Годзилланың алдына қойылған рельсті мылтықпен
Dialogue: 0,0:47:32.00,0:47:33.45,Default,,0,0,0,,Бір нүктеден ату
Dialogue: 0,0:47:33.70,0:47:35.83,Default,,0,0,0,,Шуды реттеуден кейін бірден
Dialogue: 0,0:47:35.95,0:47:37.87,Default,,0,0,0,,Екі қанаттың арқа қанаттарын жою
Dialogue: 0,0:47:37.95,0:47:39.66,Default,,0,0,0,,Қалқан жоғалып кеткен сәт
Dialogue: 0,0:47:40.25,0:47:41.20,Default,,0,0,0,,Артынан
Dialogue: 0,0:47:41.29,0:47:44.16,Default,,0,0,0,,Мен осы EMP гарпунымен соңғы соққыны беремін.
Dialogue: 0,0:47:44.45,0:47:46.45,Default,,0,0,0,,Бұл кит аулайтын гарпун сияқты.
Dialogue: 0,0:47:46.62,0:47:50.54,Default,,0,0,0,,Гарпуннан шыққан электромагниттік импульс оның ішкі электромагниттік толқындарының бақылаудан шығуына себеп болды.
Dialogue: 0,0:47:50.66,0:47:53.04,Default,,0,0,0,,Оның денесі шамадан тыс жүктемеден ұшып кетті.
Dialogue: 0,0:47:53.62,0:47:57.08,Default,,0,0,0,,Өзің жасаған шұңқыр оның зиратына айналады.
Dialogue: 0,0:47:57.25,0:47:58.58,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:47:59.41,0:48:00.95,Default,,0,0,0,,Нанометаллдың барлық операциялары
Dialogue: 0,0:48:01.04,0:48:03.20,Default,,0,0,0,,Бильсардо жауапты болуы керек.
Dialogue: 0,0:48:03.58,0:48:06.75,Default,,0,0,0,,Бақылау сценарийі Бильсардо тіліне негізделген.
Dialogue: 0,0:48:06.87,0:48:09.54,Default,,0,0,0,,Бұны басқа нәсілдің шешуі тиімсіз.
Dialogue: 0,0:48:09.66,0:48:10.50,Default,,0,0,0,,Әлде…
Dialogue: 0,0:48:10.79,0:48:13.91,Default,,0,0,0,,Бізде нанометалдарға монополия болғаны ұнамайды...
Dialogue: 0,0:48:14.00,0:48:15.41,Default,,0,0,0,,айтқыңыз келе ме?
Dialogue: 0,0:48:15.50,0:48:17.25,Default,,0,0,0,,Шынымен емес, шын мәнінде емес.
Dialogue: 0,0:48:17.66,0:48:20.16,Default,,0,0,0,,Бұл тек сендер үшін тұрақты жұмыс емес пе?
Dialogue: 0,0:48:20.50,0:48:24.33,Default,,0,0,0,,Біз шаршау сияқты физикалық шектеулерге байланысты емеспіз.
Dialogue: 0,0:48:24.79,0:48:26.25,Default,,0,0,0,,Бұл өте абайсызда
Dialogue: 0,0:48:26.45,0:48:28.79,Default,,0,0,0,,Бұл қала ортасының өзі
Dialogue: 0,0:48:28.87,0:48:31.79,Default,,0,0,0,,Ол Бирсалдоға шексіз өміршеңдік береді.
Dialogue: 0,0:48:32.37,0:48:33.70,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:48:34.16,0:48:36.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:48:39.50,0:48:41.04,Default,,0,0,0,,Бұл кенеттен өзгерген сияқты.
Dialogue: 0,0:48:41.50,0:48:42.45,Default,,0,0,0,,Бұл керемет емес пе?
Dialogue: 0,0:48:42.79,0:48:44.41,Default,,0,0,0,,Біздің нанометалымыз
Dialogue: 0,0:48:45.62,0:48:47.66,Default,,0,0,0,,Негізі, менің сізден сұрайын дегенім бар.
Dialogue: 0,0:48:47.75,0:48:48.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:49.29,0:48:52.70,Default,,0,0,0,,Баяғыда бұл жерді Годзилла қиратқанға дейін
Dialogue: 0,0:48:53.25,0:48:55.58,Default,,0,0,0,,Біздің гематронды есептеу кристалы
Dialogue: 0,0:48:55.70,0:48:59.62,Default,,0,0,0,,Сіздің технологияңызды талдау және жөндеу үшін пайдаланған зертхана болды.
Dialogue: 0,0:49:00.00,0:49:03.45,Default,,0,0,0,,Нанометалдардың күшін пайдаланып, оны жаңғыртуға болады ма?
Dialogue: 0,0:49:03.79,0:49:04.70,Default,,0,0,0,,О
Dialogue: 0,0:49:05.50,0:49:06.54,Default,,0,0,0,,Сіз осындай нәрсемен не істер едіңіз?
Dialogue: 0,0:49:07.08,0:49:09.29,Default,,0,0,0,,Мен галбиторияны жөндегім келеді
Dialogue: 0,0:49:10.12,0:49:11.66,Default,,0,0,0,,Ырымдарда қолданылатын ғұрыптық құрал.
Dialogue: 0,0:49:11.83,0:49:12.66,Default,,0,0,0,,Хун
Dialogue: 0,0:49:13.00,0:49:15.33,Default,,0,0,0,,Бұл не керексіз зат?
Dialogue: 0,0:49:15.50,0:49:19.12,Default,,0,0,0,,Біз үшін бұл біздің жүрегіміз үшін маңызды орын.
Dialogue: 0,0:49:19.45,0:49:20.54,Default,,0,0,0,,(Жоғары жиілікті дыбыс)
Dialogue: 0,0:49:20.62,0:49:23.12,Default,,0,0,0,,Жарқыраған аңғардағы жоқтау жыры
Dialogue: 0,0:49:23.33,0:49:26.37,Default,,0,0,0,,Жылан сүйекті кеміреді.
Dialogue: 0,0:49:26.54,0:49:28.70,Default,,0,0,0,,Қарға кешкі аспанға ұшады
Dialogue: 0,0:49:29.54,0:49:31.95,Default,,0,0,0,,Өртенген таудағы жоқтау жыры
Dialogue: 0,0:49:32.41,0:49:35.16,Default,,0,0,0,,Жердің қараңғылығы – адамзаттың қалған бөлігі.
Dialogue: 0,0:49:35.50,0:49:37.29,Default,,0,0,0,,Жұмыртқаны мадақтау
Dialogue: 0,0:49:37.95,0:49:40.58,Default,,0,0,0,,Қарғаларға өмір қанатын беру
Dialogue: 0,0:49:41.62,0:49:43.29,Default,,0,0,0,,Қанаттар сынды
Dialogue: 0,0:49:44.41,0:49:46.20,Default,,0,0,0,,Жұмыртқа ештеңе емес
Dialogue: 0,0:49:46.66,0:49:48.29,Default,,0,0,0,,Сөйлеме
Dialogue: 0,0:49:54.70,0:49:57.00,Default,,0,0,0,,Бұл жерде қорқынышты.
Dialogue: 0,0:49:57.75,0:50:00.08,Default,,0,0,0,,Сіз қалай ойлайсыз? Келесі стратегия
Dialogue: 0,0:50:00.50,0:50:04.20,Default,,0,0,0,,Сіз не ойласаңыз да...
Dialogue: 0,0:50:06.95,0:50:07.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:50:08.66,0:50:11.75,Default,,0,0,0,,Барлығы алдағы операцияға алаңдаулы.
Dialogue: 0,0:50:12.20,0:50:16.00,Default,,0,0,0,,Қызық, Билсард пен Нанометалға сену дұрыс па?
Dialogue: 0,0:50:16.16,0:50:17.50,Default,,0,0,0,,Сіз не туралы ақымақсыз?
Dialogue: 0,0:50:18.00,0:50:20.95,Default,,0,0,0,,Адасып жатқандар да зиялылар.
Dialogue: 0,0:50:21.62,0:50:24.58,Default,,0,0,0,,Бірақ Алланың қақпасына адасқандар
Dialogue: 0,0:50:24.66,0:50:26.54,Default,,0,0,0,,Ол арқылы өту мүмкін емес
Dialogue: 0,0:50:27.41,0:50:28.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:28.62,0:50:31.75,Default,,0,0,0,,Маған осы тыныштандыратын уағызды қайталаңыз.
Dialogue: 0,0:50:31.91,0:50:35.83,Default,,0,0,0,,Тоқтаңыз. Бұл Құдайдың көрінетін уақыты емес.
Dialogue: 0,0:50:36.12,0:50:38.16,Default,,0,0,0,,Ұлы мақсатыңызды ұмытпаңыз
Dialogue: 0,0:50:38.79,0:50:41.12,Default,,0,0,0,,Біз үшін қазір маңыздысы
Dialogue: 0,0:50:41.25,0:50:45.95,Default,,0,0,0,,Зұлымдықты жою үшін барлық ақыл-ойды жинаңыз.
Dialogue: 0,0:50:53.33,0:50:54.62,Default,,0,0,0,,О...
Dialogue: 0,0:50:54.91,0:50:55.75,Default,,0,0,0,,Уау
Dialogue: 0,0:51:04.50,0:51:06.41,Default,,0,0,0,,Бұл мен күткеннен де көп.
Dialogue: 0,0:51:06.54,0:51:09.04,Default,,0,0,0,,Егер сіз қалаға жақын болсаңыз, нанометалды шексіз мөлшерде алуға болады.
Dialogue: 0,0:51:09.12,0:51:11.37,Default,,0,0,0,,Энергиямен жабдықтауды қабылдай алады
Dialogue: 0,0:51:11.95,0:51:15.62,Default,,0,0,0,,Егер сіз осы соммадан 5 км қашықтықта болсаңыз, сіз жеңілмейтінсіз.
Dialogue: 0,0:51:15.83,0:51:16.95,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:51:17.83,0:51:19.54,Default,,0,0,0,,Тез әрі еркін
Dialogue: 0,0:51:20.58,0:51:23.95,Default,,0,0,0,,Бұл Вульт Бильсардоның күші
Dialogue: 0,0:51:26.87,0:51:28.45,Default,,0,0,0,,Жетеді, Юко.
Dialogue: 0,0:51:28.54,0:51:30.54,Default,,0,0,0,,Сержант майор Тани үлкен іс.
Dialogue: 0,0:51:31.16,0:51:34.04,Default,,0,0,0,,Ол мен Вултурдың арасындағы химия керемет.
Dialogue: 0,0:51:34.50,0:51:36.50,Default,,0,0,0,,Бұл бірлік ретінде қолайлы.
Dialogue: 0,0:51:42.91,0:51:44.12,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:51:45.41,0:51:46.41,Default,,0,0,0,,Сабырымен шашып тастар еді.
Dialogue: 0,0:51:46.75,0:51:49.95,Default,,0,0,0,,Сынақ ұшуына қатысты мәселелер жақын арада шешілетін сияқты.
Dialogue: 0,0:51:50.20,0:51:52.37,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:51:52.87,0:51:54.62,Default,,0,0,0,,Бірақ біраз ұйықтаңыз.
Dialogue: 0,0:51:55.54,0:51:59.12,Default,,0,0,0,,Біз бұл жерде ғарыш кемесіне қайта оралғандай болдық.
Dialogue: 0,0:52:00.25,0:52:04.16,Default,,0,0,0,,Машиналардың қоршауында болу бізге ностальгия болып көрінеді.
Dialogue: 0,0:52:04.37,0:52:06.62,Default,,0,0,0,,Бірақ бұл әйтеуір басқаша сияқты.
Dialogue: 0,0:52:06.75,0:52:08.79,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:52:11.33,0:52:13.66,Default,,0,0,0,,Сіз қалай ойлайсыз? Келесі стратегия
Dialogue: 0,0:52:14.16,0:52:15.54,Default,,0,0,0,,Сіздің табысқа жететініңізге сенімдімін
Dialogue: 0,0:52:15.62,0:52:16.87,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:52:17.41,0:52:21.37,Default,,0,0,0,,Барлығын қайтадан тарту дұрыс па?
Dialogue: 0,0:52:21.70,0:52:22.66,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:52:23.29,0:52:26.50,Default,,0,0,0,,Годзиллаға деген құмарлығым жеке кек шығар.
Dialogue: 0,0:52:30.20,0:52:33.66,Default,,0,0,0,,Сенпай менің тілегім еді ғой?
Dialogue: 0,0:52:33.75,0:52:34.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:34.75,0:52:37.41,Default,,0,0,0,,Өйткені бізде жер туралы естелік жоқ
Dialogue: 0,0:52:37.70,0:52:41.08,Default,,0,0,0,,Шынымды айтсам, үлкендердің сағыныш сезімін түсінбедім.
Dialogue: 0,0:52:41.70,0:52:44.41,Default,,0,0,0,,Аталар жер туралы естеліктерін айтады
Dialogue: 0,0:52:44.54,0:52:48.25,Default,,0,0,0,,Бұл ертегідей сезілді және ешқандай шындық жоқ.
Dialogue: 0,0:52:48.58,0:52:50.37,Default,,0,0,0,,Ата... иә?
Dialogue: 0,0:52:56.16,0:52:59.33,Default,,0,0,0,,Кешіріңіз, бірақ атаның кесірінен сенпай...
Dialogue: 0,0:52:59.54,0:53:02.04,Default,,0,0,0,,Жарайды, бұл Юконың кінәсі емес.
Dialogue: 0,0:53:02.41,0:53:04.58,Default,,0,0,0,,Бірақ сол оқиғаның арқасында
Dialogue: 0,0:53:04.66,0:53:07.25,Default,,0,0,0,,Барлығымыз үміт алдық.
Dialogue: 0,0:53:07.33,0:53:08.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:08.83,0:53:10.25,Default,,0,0,0,,Бәрінен бас тарт
Dialogue: 0,0:53:10.33,0:53:12.75,Default,,0,0,0,,Ештеңені сезбей өмір сүруге тырысыңыз
Dialogue: 0,0:53:13.16,0:53:15.66,Default,,0,0,0,,Мен бұл кеңістікте қалыпты нәрсе деп ойладым.
Dialogue: 0,0:53:16.45,0:53:18.12,Default,,0,0,0,,Бірақ менің ағам басқаша болды.
Dialogue: 0,0:53:18.79,0:53:21.08,Default,,0,0,0,,Кешіре алмайтын нәрселерге ашулану дұрыс.
Dialogue: 0,0:53:21.20,0:53:23.20,Default,,0,0,0,,Маған солай айтылғандай сезіндім.
Dialogue: 0,0:53:24.79,0:53:26.29,Default,,0,0,0,,Сонымен, мен
Dialogue: 0,0:53:26.87,0:53:30.00,Default,,0,0,0,,Мен ағам қайда барса да соңынан еремін.
Dialogue: 0,0:53:30.95,0:53:32.50,Default,,0,0,0,,Мен осылай шештім.
Dialogue: 0,0:53:32.75,0:53:34.04,Default,,0,0,0,,Юуко
Dialogue: 0,0:53:36.12,0:53:37.04,Default,,0,0,0,,Уф
Dialogue: 0,0:53:37.62,0:53:38.45,Default,,0,0,0,,Сенпай?
Dialogue: 0,0:53:38.54,0:53:40.29,Default,,0,0,0,,А, ештеңе жоқ.
Dialogue: 0,0:53:40.41,0:53:42.37,Default,,0,0,0,,Менің ойымша, жара толық жазылмаған.
Dialogue: 0,0:53:42.70,0:53:45.16,Default,,0,0,0,,Мен осында болғаннан кейін кейде ауырады.
Dialogue: 0,0:54:07.29,0:54:08.79,Default,,0,0,0,,Капитан Сакаки
Dialogue: 0,0:54:09.58,0:54:12.58,Default,,0,0,0,,Негізі мені бір нәрсе алаңдатады.
Dialogue: 0,0:54:13.29,0:54:15.00,Default,,0,0,0,,Мехагодзилла қаласына келгеннен кейін
Dialogue: 0,0:54:15.12,0:54:17.75,Default,,0,0,0,,Кейбір сарбаздар өздерін нашар сезінеді деп шағымданады.
Dialogue: 0,0:54:18.04,0:54:21.08,Default,,0,0,0,,Мені де осында дәрігерлік қызметке тағайындап жатыр.
Dialogue: 0,0:54:21.37,0:54:22.20,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:54:22.45,0:54:23.45,Default,,0,0,0,,Олардың көпшілігі
Dialogue: 0,0:54:23.54,0:54:26.75,Default,,0,0,0,,Мен Футуа ауылында жарақаттан емделген мүшемін.
Dialogue: 0,0:54:27.25,0:54:28.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:28.16,0:54:31.16,Default,,0,0,0,,Олардың сол қабыршақты секрециясы
Dialogue: 0,0:54:31.25,0:54:33.20,Default,,0,0,0,,Сіз де боялған жоқсыз ба?
Dialogue: 0,0:54:33.91,0:54:35.50,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:54:35.83,0:54:39.62,Default,,0,0,0,,Мүмкін, бұл жерде нанометаллмен жақсы жақындық жоқ шығар.
Dialogue: 0,0:54:40.08,0:54:43.83,Default,,0,0,0,,Мен олардың барлығын Сити ғимаратынан алып шыққанда, бәрі қалпына келді.
Dialogue: 0,0:54:44.54,0:54:46.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:54:46.37,0:54:49.12,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:54:49.91,0:54:52.79,Default,,0,0,0,,Мен... жақсымын.
Dialogue: 0,0:54:58.54,0:55:01.75,Default,,0,0,0,,Бәрі де тағдыр
Dialogue: 0,0:55:02.95,0:55:04.79,Default,,0,0,0,,100 000 жыл бұрын
Dialogue: 0,0:55:05.20,0:55:09.25,Default,,0,0,0,,Менің ана планетамды да құбыжықтар қиратты.
Dialogue: 0,0:55:10.12,0:55:12.70,Default,,0,0,0,,Біз ғарышқа саяхатшы болдық
Dialogue: 0,0:55:14.20,0:55:17.91,Default,,0,0,0,,Дәл сол кезде Exif өз миссиясын түсінді.
Dialogue: 0,0:55:19.33,0:55:20.45,Default,,0,0,0,,Яғни
Dialogue: 0,0:55:20.70,0:55:23.20,Default,,0,0,0,,Дәл осындай сынақтарға ұшыраған басқа нәсілдерге.
Dialogue: 0,0:55:23.54,0:55:27.33,Default,,0,0,0,,Ізгі хабарды таратуға арналған нұсқаулық
Dialogue: 0,0:55:33.70,0:55:34.54,Default,,0,0,0,,Метфис
Dialogue: 0,0:55:35.79,0:55:36.62,Default,,0,0,0,,Бұл...
Dialogue: 0,0:55:37.79,0:55:40.70,Default,,0,0,0,,Кездесуге қатысуға мүдделісіз бе? Харуо
Dialogue: 0,0:55:41.37,0:55:43.66,Default,,0,0,0,,Жоқ, бұл жылдамдықтың өзгеруі.
Dialogue: 0,0:55:43.95,0:55:45.79,Default,,0,0,0,,Бұлай емес сияқты, бірақ
Dialogue: 0,0:55:48.54,0:55:50.00,Default,,0,0,0,,Мен абдырап қалдым.
Dialogue: 0,0:55:51.91,0:55:52.75,Default,,0,0,0,,Ішінде
Dialogue: 0,0:55:56.58,0:55:58.00,Default,,0,0,0,,Гаргтан сұраңыз
Dialogue: 0,0:55:58.16,0:56:01.20,Default,,0,0,0,,Мен мұны өзімнің шеберханам жасадым.
Dialogue: 0,0:56:01.66,0:56:02.79,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:56:04.04,0:56:06.16,Default,,0,0,0,,Бұл сынған қасиетті қазына ғана.
Dialogue: 0,0:56:06.66,0:56:09.04,Default,,0,0,0,,Мен оны Бирсалдоның технологиясы бойынша жөндеумен айналыстым.
Dialogue: 0,0:56:09.87,0:56:12.79,Default,,0,0,0,,Exif өркениетінің мұрасы?
Dialogue: 0,0:56:14.16,0:56:16.95,Default,,0,0,0,,Сіз абдырап қалдым дедіңіз ғой, солай ма? Харуо
Dialogue: 0,0:56:17.62,0:56:21.12,Default,,0,0,0,,Мен келесі операцияның командирі болуым керек пе?
Dialogue: 0,0:56:21.29,0:56:23.20,Default,,0,0,0,,Барлығы Харуоны таңдады
Dialogue: 0,0:56:23.45,0:56:25.45,Default,,0,0,0,,Бұл Бирсалдоның бекінісі.
Dialogue: 0,0:56:25.70,0:56:26.91,Default,,0,0,0,,Соңғы үміт
Dialogue: 0,0:56:27.75,0:56:30.08,Default,,0,0,0,,Бірақ мен үшін нанометалл
Dialogue: 0,0:56:30.16,0:56:32.83,Default,,0,0,0,,Мен өзімді қорқынышты сезінемін
Dialogue: 0,0:56:35.04,0:56:38.41,Default,,0,0,0,,Бұл алдамшы
Dialogue: 0,0:56:38.79,0:56:39.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:42.20,0:56:45.12,Default,,0,0,0,,Алдамшы... нәрсе?
Dialogue: 0,0:56:46.12,0:56:50.12,Default,,0,0,0,,Құбыжықтан еш айырмашылығы жоқ зұлым нәрсе.
Dialogue: 0,0:56:50.75,0:56:54.16,Default,,0,0,0,,Мен де соған табынатын Бильсардо үшін алаңдаймын.
Dialogue: 0,0:56:54.62,0:56:57.16,Default,,0,0,0,,Олардың ойлау тәсілі тым бейорганикалық.
Dialogue: 0,0:56:57.66,0:57:01.12,Default,,0,0,0,,Бірақ оны шынымен интеллект деп атауға бола ма?
Dialogue: 0,0:57:01.41,0:57:03.79,Default,,0,0,0,,Бұл ақылға қонымды емес пе?
Dialogue: 0,0:57:04.04,0:57:05.79,Default,,0,0,0,,Зерделі адам адасады.
Dialogue: 0,0:57:05.91,0:57:08.00,Default,,0,0,0,,ашуланып, мұңаяды
Dialogue: 0,0:57:08.70,0:57:12.70,Default,,0,0,0,,Біздің күресіміз соңына дейін болуы керек.
Dialogue: 0,0:57:13.58,0:57:17.79,Default,,0,0,0,,Бірақ Бильсардо мұндай жанның мәнін елемейді.
Dialogue: 0,0:57:18.54,0:57:22.66,Default,,0,0,0,,Олар әмбебап интеллектпен бірігуге тырыспайды.
Dialogue: 0,0:57:23.16,0:57:26.75,Default,,0,0,0,,Ол құбыжық сияқты бір нәрсеге айналуға тырысатын сияқты.
Dialogue: 0,0:57:26.83,0:57:28.58,Default,,0,0,0,,Құбыжықпен бірдей сапа...
Dialogue: 0,0:57:29.20,0:57:30.95,Default,,0,0,0,,Көптеген жұлдызды өркениеттер
Dialogue: 0,0:57:31.04,0:57:34.08,Default,,0,0,0,,Прогресстің соңында біз құбыжықтар жасадық.
Dialogue: 0,0:57:34.70,0:57:36.62,Default,,0,0,0,,Біз бұл туралы бұрын да айтқан болатынбыз.
Dialogue: 0,0:57:38.20,0:57:40.41,Default,,0,0,0,,Бильсардо да қазір
Dialogue: 0,0:57:41.12,0:57:44.04,Default,,0,0,0,,Біз де сол жолмен жүруге жақын болуымыз мүмкін.
Dialogue: 0,0:57:46.25,0:57:47.12,Default,,0,0,0,,Метфис
Dialogue: 0,0:57:47.79,0:57:51.20,Default,,0,0,0,,Сіздің планетаңызды да құбыжықтар қиратты ма?
Dialogue: 0,0:57:51.87,0:57:52.87,Default,,0,0,0,,Иә.
Dialogue: 0,0:57:54.00,0:57:57.41,Default,,0,0,0,,Өркениетіміздің жойылуына әкелген нәрселер туралы.
Dialogue: 0,0:57:57.54,0:58:00.16,Default,,0,0,0,,Бос сөзге де тыйым салынады.
Dialogue: 0,0:58:00.83,0:58:04.75,Default,,0,0,0,,Сөздің ғана күші бар.
Dialogue: 0,0:58:04.83,0:58:06.45,Default,,0,0,0,,Бұл сәтсіздікті білдіре ме?
Dialogue: 0,0:58:06.95,0:58:09.45,Default,,0,0,0,,Иә, бірақ Харуо
Dialogue: 0,0:58:10.25,0:58:13.75,Default,,0,0,0,,Тек Годзиллаға қарсы тұруға тырысатын сізге ғана
Dialogue: 0,0:58:13.95,0:58:16.58,Default,,0,0,0,,Мүмкін мен олардың орнына айтуым керек.
Dialogue: 0,0:58:17.00,0:58:20.79,Default,,0,0,0,,Біз, Exif, жасырған жойылу аты.
Dialogue: 0,0:58:22.87,0:58:24.20,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:58:24.54,0:58:28.16,Default,,0,0,0,,Ұрыста қорқыныш сізді жұтып қояйын деп жатқанда, мұны есте сақтаңыз.
Dialogue: 0,0:58:28.37,0:58:32.70,Default,,0,0,0,,Бұл ғаламда жойылудың абсолютті күші бар.
Dialogue: 0,0:58:33.08,0:58:37.95,Default,,0,0,0,,Онымен салыстырғанда, Годзилла өте қорқынышты емес...
Dialogue: 0,0:58:38.91,0:58:40.00,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:58:48.95,0:58:51.33,Default,,0,0,0,,Оны жадыңыздың бір бұрышында сақтаңыз
Dialogue: 0,0:58:51.95,0:58:56.00,Default,,0,0,0,,Дегенмен, оны ешқашан көпшілік алдында айтпаңыз.
Dialogue: 0,0:59:03.08,0:59:04.12,Default,,0,0,0,,Юуко
Dialogue: 0,0:59:05.41,0:59:06.29,Default,,0,0,0,,(Жоғары жиілікті дыбыс)
Dialogue: 0,0:59:06.37,0:59:08.50,Default,,0,0,0,,Жарқыраған алқап – жоқтау батпағы
Dialogue: 0,0:59:08.58,0:59:10.50,Default,,0,0,0,,Жылан сізді қараңғылық тереңіне шақырады.
Dialogue: 0,0:59:11.79,0:59:14.08,Default,,0,0,0,,Әнші дауыс батпақ түбіне дейін жетуі керек.
Dialogue: 0,0:59:14.87,0:59:16.75,Default,,0,0,0,,Аспанға қарға
Dialogue: 0,0:59:19.20,0:59:20.16,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:59:20.83,0:59:21.83,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:59:22.95,0:59:25.00,Default,,0,0,0,,Бұрынғы адамдар осындай болған
Dialogue: 0,0:59:25.08,0:59:27.75,Default,,0,0,0,,Қаланың түнгі көрінісін тамашалап, далада серуендеп жүрдіңіз.
Dialogue: 0,0:59:28.00,0:59:30.12,Default,,0,0,0,,О, солай деп ойлаймын.
Dialogue: 0,0:59:30.66,0:59:34.29,Default,,0,0,0,,Жақсы, менің ағам ескі Жер туралы біледі.
Dialogue: 0,0:59:34.54,0:59:36.29,Default,,0,0,0,,Ол әлі бала еді.
Dialogue: 0,0:59:36.54,0:59:37.79,Default,,0,0,0,,Менің есімде көп жоқ
Dialogue: 0,0:59:38.66,0:59:41.00,Default,,0,0,0,,Exif ілімін алдыңыз ба?
Dialogue: 0,0:59:41.20,0:59:43.37,Default,,0,0,0,,Жоқ, бұл жеке кеңес.
Dialogue: 0,0:59:43.83,0:59:45.04,Default,,0,0,0,,Майор Берубе
Dialogue: 0,0:59:45.12,0:59:49.29,Default,,0,0,0,,Дінге сүйенетін адамдардың ақылды жаратылыс ретінде жетілмегендігін айтты.
Dialogue: 0,0:59:50.20,0:59:52.00,Default,,0,0,0,,Билсалдоға ұқсайды.
Dialogue: 0,0:59:52.54,0:59:54.62,Default,,0,0,0,,Сенпай, жақсысың ба?
Dialogue: 0,0:59:54.75,0:59:55.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:55.70,0:59:58.12,Default,,0,0,0,,Ол сәл нашар көрінді.
Dialogue: 0,0:59:58.25,1:00:00.66,Default,,0,0,0,,А, қазір бәрі жақсы.
Dialogue: 0,1:00:02.79,1:00:03.70,Default,,0,0,0,,Юуко
Dialogue: 0,1:00:04.87,1:00:06.41,Default,,0,0,0,,Мен енді жоғалған жоқпын
Dialogue: 0,1:00:06.50,1:00:07.37,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:08.25,1:00:11.95,Default,,0,0,0,,Енді бізге Годзилланы жеңу керек.
Dialogue: 0,1:00:12.29,1:00:16.25,Default,,0,0,0,,Жерді адам қолымызға қайтару үшін
Dialogue: 0,1:00:17.29,1:00:18.87,Default,,0,0,0,,Уәде беремін, Юко.
Dialogue: 0,1:00:19.00,1:00:21.87,Default,,0,0,0,,Жеңіске жетсем, міндетті түрде саған нағыз Жерді көрсетемін.
Dialogue: 0,1:00:22.79,1:00:24.00,Default,,0,0,0,,Аға
Dialogue: 0,1:00:40.70,1:00:42.50,Default,,0,0,0,,Мехагодзилла қаласының ашылуымен
Dialogue: 0,1:00:42.95,1:00:47.00,Default,,0,0,0,,Борттағы Билсардо Жерді тастап кетуге қарсы болды.
Dialogue: 0,1:00:47.12,1:00:50.66,Default,,0,0,0,,Біз Ситимен кездесіп, Годзилламен төбелесуіміз керек.
Dialogue: 0,1:00:50.87,1:00:53.00,Default,,0,0,0,,Сәйкесінше, Exif де
Dialogue: 0,1:00:53.08,1:00:55.12,Default,,0,0,0,,Барлық интеллект бір болуы керек.
Dialogue: 0,1:00:55.25,1:00:57.83,Default,,0,0,0,,Барлығы бірге күресу үшін дәлелді күшейту
Dialogue: 0,1:00:58.54,1:01:02.25,Default,,0,0,0,,Өзіңізді әмбебап интеллектке арнаңыз...
Dialogue: 0,1:01:03.08,1:01:07.04,Default,,0,0,0,,Біз әрқашан бір болуымыз керек
Dialogue: 0,1:01:08.00,1:01:11.62,Default,,0,0,0,,Құдай түсетін уәде етілген күнге дейін
Dialogue: 0,1:01:13.58,1:01:16.04,Default,,0,0,0,,Менің ойымша, ол бақылаудан шығып кетеді деп ойламаймын.
Dialogue: 0,1:01:16.20,1:01:18.58,Default,,0,0,0,,Бекіту бірнеше сағатта аяқталады.
Dialogue: 0,1:01:18.95,1:01:21.50,Default,,0,0,0,,Қазір орынсыз уайымдайтын уақыт емес.
Dialogue: 0,1:01:21.58,1:01:23.20,Default,,0,0,0,,Бірақ егер Годзилла
Dialogue: 0,1:01:23.29,1:01:25.58,Default,,0,0,0,,Осы Мехагодзилла қаласы жеңеді деп есептесек
Dialogue: 0,1:01:25.66,1:01:28.62,Default,,0,0,0,,Бұл шынымен де біздің жеңісіміз бе?
Dialogue: 0,1:01:28.95,1:01:30.04,Default,,0,0,0,,Егер біз Годзилланы жеңсек
Dialogue: 0,1:01:30.12,1:01:32.91,Default,,0,0,0,,Оның орнына бұл нанометалдар жерді жабады.
Dialogue: 0,1:01:33.00,1:01:34.08,Default,,0,0,0,,Эй, дәл солай...
Dialogue: 0,1:01:34.83,1:01:35.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:36.58,1:01:38.70,Default,,0,0,0,,Сіз не істеп жатырсыз? Сол жігіттер
Dialogue: 0,1:01:43.00,1:01:45.91,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:46.58,1:01:47.62,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:53.91,1:01:55.54,Default,,0,0,0,,Содан кейін осында
Dialogue: 0,1:01:55.62,1:01:56.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:56.54,1:01:58.70,Default,,0,0,0,,Менің әлі істейтін істерім бар.
Dialogue: 0,1:01:59.20,1:02:01.12,Default,,0,0,0,,Машиналар мен адамдар бірдей емес
Dialogue: 0,1:02:01.20,1:02:02.20,Default,,0,0,0,,Оны асыра пайдаланбаңыз
Dialogue: 0,1:02:02.33,1:02:03.66,Default,,0,0,0,,Жарайды
Dialogue: 0,1:02:07.37,1:02:08.45,Default,,0,0,0,,Ха!
Dialogue: 0,1:02:09.12,1:02:09.95,Default,,0,0,0,,Ха!
Dialogue: 0,1:02:10.66,1:02:12.33,Default,,0,0,0,,Жер айқайлайды
Dialogue: 0,1:02:12.41,1:02:14.45,Default,,0,0,0,,Өртенген тау оянады
Dialogue: 0,1:02:14.54,1:02:15.95,Default,,0,0,0,,Оның тынысы – дауыл
Dialogue: 0,1:02:16.12,1:02:18.45,Default,,0,0,0,,Оның қаһары – күн күркіреуі
Dialogue: 0,1:02:18.62,1:02:22.91,Default,,0,0,0,,Алыс уақыттан асып, жойылу күшін басқаратын.
Dialogue: 0,1:02:24.04,1:02:25.87,Default,,0,0,0,,Годзилла қозғала бастады
Dialogue: 0,1:02:26.04,1:02:28.70,Default,,0,0,0,,Қаланы аяқтау үшін қанша уақыт қажет?
Dialogue: 0,1:02:28.79,1:02:31.00,Default,,0,0,0,,Кемінде 12 сағат
Dialogue: 0,1:02:31.29,1:02:34.79,Default,,0,0,0,,Әрі қарай қысқарту қауіпсіздікті құрбан етеді.
Dialogue: 0,1:02:35.20,1:02:37.37,Default,,0,0,0,,Ол бізді әлі байқаған жоқ.
Dialogue: 0,1:02:37.50,1:02:39.37,Default,,0,0,0,,Термиялық құрыш тақтайшаларын кейінірек өшіруге болады.
Dialogue: 0,1:02:39.45,1:02:41.91,Default,,0,0,0,,Жалғыз ұстап алу жүйесін 6 сағатта алыңыз.
Dialogue: 0,1:02:42.29,1:02:43.79,Default,,0,0,0,,Әй, байқап көрейік
Dialogue: 0,1:02:44.70,1:02:47.70,Default,,0,0,0,,Жарайды ма? Бұл тек Годзилланы ынталандыру емес пе?
Dialogue: 0,1:02:47.79,1:02:49.83,Default,,0,0,0,,Тек жасырынып жеңе алмайсың.
Dialogue: 0,1:02:49.91,1:02:53.33,Default,,0,0,0,,Ең бастысы - ол байқамай тұрып, қаншалықты дайындалуға болатынын көру.
Dialogue: 0,1:02:53.95,1:02:56.58,Default,,0,0,0,,Термиялық құрыш тақтасы Құрылыс процесін дереу тоқтатыңыз
Dialogue: 0,1:02:58.79,1:03:00.20,Default,,0,0,0,,Генерация желісін ұстап тұру жүйесі
Dialogue: 0,1:03:00.29,1:03:03.41,Default,,0,0,0,,Энергияны бөлу жылдамдығын 25%-ға арттырады
Dialogue: 0,1:03:05.50,1:03:07.20,Default,,0,0,0,,Вултурдың соңғы сынақ ұшуы қандай болды?
Dialogue: 0,1:03:07.29,1:03:09.00,Default,,0,0,0,,Өкінішке орай, бұған орын болмады.
Dialogue: 0,1:03:09.41,1:03:11.70,Default,,0,0,0,,Қазіргі уақытта сізде қанша машина бар?
Dialogue: 0,1:03:11.79,1:03:12.79,Default,,0,0,0,,Барлығы үш ұшақ бар.
Dialogue: 0,1:03:12.87,1:03:13.79,Default,,0,0,0,,Тағы қанша машина жасай аламыз?
Dialogue: 0,1:03:14.25,1:03:17.00,Default,,0,0,0,,Өйткені менде іргетас ретінде қолдануға болатын қуат беретін костюмім жоқ.
Dialogue: 0,1:03:17.12,1:03:18.45,Default,,0,0,0,,Оны бірден жасау мүмкін емес
Dialogue: 0,1:03:19.00,1:03:21.54,Default,,0,0,0,,Бір ұшақтың атыс күші 300 ұшатын ұшақпен бірдей.
Dialogue: 0,1:03:21.62,1:03:24.83,Default,,0,0,0,,Бұл өнімділікпен үш машина жұмысты жақсы орындай алады.
Dialogue: 0,1:03:25.00,1:03:25.95,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,1:03:26.04,1:03:28.08,Default,,0,0,0,,Оның орнына рельсті мылтық батареясы
Dialogue: 0,1:03:28.16,1:03:32.75,Default,,0,0,0,,Қалауыңызша, алдыңғы үш бағытта және әр қанатқа 10 мылтық орналастырыңыз.
Dialogue: 0,1:03:32.91,1:03:35.95,Default,,0,0,0,,Бір мылтықтың қуаты да бұрынғыдан 20 есе артық.
Dialogue: 0,1:03:36.20,1:03:38.75,Default,,0,0,0,,Осыншама қысқа уақыт ішінде үлкен жұмыс атқардыңыз.
Dialogue: 0,1:03:38.87,1:03:40.91,Default,,0,0,0,,Мен сізге көрсеткім келетін тағы бір нәрсе бар.
Dialogue: 0,1:03:41.37,1:03:43.70,Default,,0,0,0,,Соңғы соққы.
Dialogue: 0,1:03:44.37,1:03:47.66,Default,,0,0,0,,EMP Гарпуны аяқталуға жақын
Dialogue: 0,1:03:47.95,1:03:51.87,Default,,0,0,0,,Қалқан жоғалып кеткеннен кейін, оны шашырату үшін пайдаланыңыз.
Dialogue: 0,1:03:52.70,1:03:53.54,Default,,0,0,0,,Иә
Dialogue: 0,1:03:53.91,1:03:55.08,Default,,0,0,0,,Капитан Сакаки!
Dialogue: 0,1:03:55.16,1:03:58.20,Default,,0,0,0,,Нанометалл есінен танып, Билсардты алып жатыр!
Dialogue: 0,1:03:58.33,1:03:59.16,Default,,0,0,0,,Не?
Dialogue: 0,1:03:59.25,1:04:00.45,Default,,0,0,0,,Осы қарқынмен біз де...
Dialogue: 0,1:04:00.54,1:04:02.75,Default,,0,0,0,,Қайда? Гарг, мені дереу құтқар.
Dialogue: 0,1:04:02.83,1:04:04.00,Default,,0,0,0,,Сабыр ет, Харуо.
Dialogue: 0,1:04:04.66,1:04:08.29,Default,,0,0,0,,Бұл қашқын емес, логикалық қорытынды.
Dialogue: 0,1:04:08.50,1:04:10.25,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Гарг
Dialogue: 0,1:04:10.41,1:04:12.58,Default,,0,0,0,,Citi желісімен дәйекті түрде біріктірілді.
Dialogue: 0,1:04:12.66,1:04:16.29,Default,,0,0,0,,Басқару блогын нейрондық процессор ретінде қолдайды
Dialogue: 0,1:04:16.37,1:04:18.12,Default,,0,0,0,,«Біріктіру және қолдау»...
Dialogue: 0,1:04:18.41,1:04:20.08,Default,,0,0,0,,Олар денелерін тастап кетті
Dialogue: 0,1:04:20.16,1:04:22.70,Default,,0,0,0,,Сіз оны Мехагодзилла қаласының өзіне айналды деп айта аласыз.
Dialogue: 0,1:04:23.20,1:04:24.04,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:24.12,1:04:26.45,Default,,0,0,0,,Біз үшін бұл құрмет.
Dialogue: 0,1:04:27.00,1:04:30.95,Default,,0,0,0,,Біз өз азаматтарымызға тиімдірек қызмет ете аламыз.
Dialogue: 0,1:04:31.04,1:04:31.87,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:04:31.95,1:04:34.12,Default,,0,0,0,,Бұған рұқсат етілген деп ойлайсыз ба?
Dialogue: 0,1:04:34.20,1:04:37.33,Default,,0,0,0,,Иә? Годзилланы жеңгіңіз келмей ме?
Dialogue: 0,1:04:38.16,1:04:41.20,Default,,0,0,0,,Шектеулі уақыт және шектеулі ресурстар
Dialogue: 0,1:04:41.29,1:04:43.00,Default,,0,0,0,,Ең тиімсізінен
Dialogue: 0,1:04:43.08,1:04:45.87,Default,,0,0,0,,Табиғи шешім - оларды бір-бірлеп қысқарту.
Dialogue: 0,1:04:46.08,1:04:48.33,Default,,0,0,0,,Дене ең жақсы үлгі емес пе?
Dialogue: 0,1:04:48.62,1:04:49.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:04:51.91,1:04:53.75,Default,,0,0,0,,Метфис те айтты
Dialogue: 0,1:04:54.04,1:04:55.00,Default,,0,0,0,,Балалар
Dialogue: 0,1:04:55.08,1:04:58.16,Default,,0,0,0,,«Құбыжық сияқты бір нәрсеге айналуға тырысу».
Dialogue: 0,1:04:58.33,1:04:59.54,Default,,0,0,0,,Бұл планетада тағы да...
Dialogue: 0,1:04:59.62,1:05:01.50,Default,,0,0,0,,Сіз жаңа Годзилла жасауды жоспарлап отырсыз ба?
Dialogue: 0,1:05:01.83,1:05:04.70,Default,,0,0,0,,Годзилла – жаһандық өркениеттің туындысы.
Dialogue: 0,1:05:04.79,1:05:06.91,Default,,0,0,0,,Барлығыңыз қателік ретінде өкінесіздер.
Dialogue: 0,1:05:07.00,1:05:09.87,Default,,0,0,0,,Мен мұны үлкен ерлік деп бағалаймын.
Dialogue: 0,1:05:09.95,1:05:11.04,Default,,0,0,0,,Бұл...
Dialogue: 0,1:05:11.12,1:05:13.12,Default,,0,0,0,,Егер сіз кінәлі болсаңыз
Dialogue: 0,1:05:13.20,1:05:15.04,Default,,0,0,0,,Міне, біз жасау үшін қиындыққа тап болған Годзилла.
Dialogue: 0,1:05:15.12,1:05:17.25,Default,,0,0,0,,Бұл бақыланбайтын ақымақтық.
Dialogue: 0,1:05:17.37,1:05:18.20,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:05:18.29,1:05:21.00,Default,,0,0,0,,Енді бұл планета кімдікі туралы ойланыңыз.
Dialogue: 0,1:05:21.20,1:05:24.29,Default,,0,0,0,,Қоршаған ортаны билеушіге «Годзилла» атын берсек
Dialogue: 0,1:05:24.37,1:05:26.54,Default,,0,0,0,,Біз, гуманоид нәсіл,
Dialogue: 0,1:05:26.62,1:05:29.08,Default,,0,0,0,,«Годзилла» деп аталу керек
Dialogue: 0,1:05:29.16,1:05:30.50,Default,,0,0,0,,Сіз мұны өз ойыңызда айтып отырсыз ба?
Dialogue: 0,1:05:30.58,1:05:32.95,Default,,0,0,0,,Мехагодзилла қаласымен ассимиляция
Dialogue: 0,1:05:33.04,1:05:36.45,Default,,0,0,0,,Өмірдің келесі кезеңге өтуінің синонимі.
Dialogue: 0,1:05:36.58,1:05:39.16,Default,,0,0,0,,Сезім әсер еткен әлсіз болмыстан
Dialogue: 0,1:05:39.25,1:05:41.83,Default,,0,0,0,,Толық логика әлемінде өмір сүріңіз
Dialogue: 0,1:05:41.91,1:05:45.87,Default,,0,0,0,,Эмоцияларыңызды жоғалтып, толық логикалық әлемге еніңіз.
Dialogue: 0,1:05:45.95,1:05:48.50,Default,,0,0,0,,Біз оны эволюция деп атай аламыз ба?
Dialogue: 0,1:05:49.12,1:05:50.12,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:05:50.20,1:05:51.04,Default,,0,0,0,,Мен де
Dialogue: 0,1:05:51.25,1:05:53.45,Default,,0,0,0,,Аа, сендер де солай ғой.
Dialogue: 0,1:05:53.54,1:05:56.20,Default,,0,0,0,,Бұл Футуа жәндіктерге ұқсас нәрсе ме?
Dialogue: 0,1:05:56.45,1:05:58.75,Default,,0,0,0,,Тіпті адам мен жәндіктерді ажырата алмайсың ба?
Dialogue: 0,1:05:59.20,1:06:03.12,Default,,0,0,0,,Аң қоршаған ортаға құл, ал ақыл қоршаған ортаны билейді.
Dialogue: 0,1:06:03.20,1:06:07.41,Default,,0,0,0,,Ал туа біткен дене де қоршаған ортаның бір бөлігі ғана.
Dialogue: 0,1:06:07.79,1:06:11.04,Default,,0,0,0,,Егер эволюцияны жоққа шығарып, азғындықты қабылдасақ
Dialogue: 0,1:06:11.12,1:06:14.20,Default,,0,0,0,,Сіз сол жәндіктермен бітесіз.
Dialogue: 0,1:06:14.50,1:06:17.20,Default,,0,0,0,,Бұл машинаның бөлігіне айналғаннан жақсы!
Dialogue: 0,1:06:17.50,1:06:19.12,Default,,0,0,0,,Бөлшек деп аталмайды ма?
Dialogue: 0,1:06:19.41,1:06:20.58,Default,,0,0,0,,Сержант майор Тани…
Dialogue: 0,1:06:20.66,1:06:23.16,Default,,0,0,0,,Годзилланы бұдан былай жеңгісі келетін дос!
Dialogue: 0,1:06:24.95,1:06:25.79,Default,,0,0,0,,Капитан
Dialogue: 0,1:06:25.87,1:06:29.41,Default,,0,0,0,,Нанометаллмен біріктірілген жалғыз адамдар - Билсардо еріктілері.
Dialogue: 0,1:06:29.70,1:06:31.20,Default,,0,0,0,,Бірақ солай болды
Dialogue: 0,1:06:31.29,1:06:33.91,Default,,0,0,0,,Бұл бізбен бірге Годзилламен күресу.
Dialogue: 0,1:06:34.33,1:06:37.41,Default,,0,0,0,,Юко, сен мұны қабылдай аласың ба?
Dialogue: 0,1:06:37.50,1:06:39.54,Default,,0,0,0,,Қанағаттанбау себебі неде?
Dialogue: 0,1:06:39.87,1:06:40.87,Default,,0,0,0,,Мен де
Dialogue: 0,1:06:40.95,1:06:44.50,Default,,0,0,0,,Мен Бильсардоның барлық идеяларымен келіспеймін.
Dialogue: 0,1:06:44.66,1:06:45.50,Default,,0,0,0,,Дәл Футуа сияқты
Dialogue: 0,1:06:45.58,1:06:48.33,Default,,0,0,0,,Не ойлайтынын білмейтін адамдармен салыстырғанда.
Dialogue: 0,1:06:48.41,1:06:51.25,Default,,0,0,0,,Бұл әлдеқайда жақсы. Мен тілді дұрыс түсінемін.
Dialogue: 0,1:06:51.75,1:06:54.66,Default,,0,0,0,,Хмм, бірақ...
Dialogue: 0,1:06:54.83,1:06:56.62,Default,,0,0,0,,Бақылау! Дереу жауап беріңіз
Dialogue: 0,1:06:56.70,1:06:57.54,Default,,0,0,0,,Бақылау!
Dialogue: 0,1:06:58.08,1:07:01.20,Default,,0,0,0,,Нанометалл бетінен газдың пайда болуы тоқтады.
Dialogue: 0,1:07:01.45,1:07:03.37,Default,,0,0,0,,Не? (Солдат С) Бұл не...
Dialogue: 0,1:07:04.12,1:07:07.20,Default,,0,0,0,,Ах, газ өндіруге бөлінген энергия.
Dialogue: 0,1:07:07.29,1:07:09.04,Default,,0,0,0,,Олар оны бекініске айналдыруды шешкен сияқты.
Dialogue: 0,1:07:09.12,1:07:10.54,Default,,0,0,0,,«Мен мұны істеген сияқтымын»...
Dialogue: 0,1:07:10.83,1:07:12.50,Default,,0,0,0,,Годзилла сізді байқайды
Dialogue: 0,1:07:12.58,1:07:15.16,Default,,0,0,0,,Қорларды бекіністерге жұмсаған дұрыс
Dialogue: 0,1:07:15.41,1:07:18.00,Default,,0,0,0,,Бұл шешімді Мехагодзилла қаласының өзі қабылдады.
Dialogue: 0,1:07:18.08,1:07:19.83,Default,,0,0,0,,Оны басқаратындар емес пе?
Dialogue: 0,1:07:20.16,1:07:23.08,Default,,0,0,0,,Олар Мехагодзилла қаласына ассимиляцияланды.
Dialogue: 0,1:07:23.41,1:07:25.04,Default,,0,0,0,,Олар қазірдің өзінде
Dialogue: 0,1:07:25.12,1:07:27.87,Default,,0,0,0,,Ол адам шегінен шығатын қабілеттерін көрсетеді.
Dialogue: 0,1:07:27.95,1:07:29.41,Default,,0,0,0,,(Эндевор) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:07:29.50,1:07:30.75,Default,,0,0,0,,Діріл толқынын анықтау!
Dialogue: 0,1:07:30.87,1:07:36.50,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:07:44.45,1:07:50.33,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:07:51.45,1:07:53.33,Default,,0,0,0,,Годзилланың бағыты өзгерді
Dialogue: 0,1:07:53.79,1:07:55.87,Default,,0,0,0,,Жүру жылдамдығы шамамен 60км/сағ
Dialogue: 0,1:07:56.00,1:07:57.50,Default,,0,0,0,,Тура осында
Dialogue: 0,1:07:57.66,1:07:59.75,Default,,0,0,0,,Эй, мына жерді таптың ба?
Dialogue: 0,1:07:59.91,1:08:01.08,Default,,0,0,0,,Бекініс қалай жүріп жатыр?
Dialogue: 0,1:08:01.62,1:08:04.50,Default,,0,0,0,,Гарпунды аяқтау үшін шамамен 30 минут қажет.
Dialogue: 0,1:08:04.58,1:08:07.16,Default,,0,0,0,,Қалаға жету үшін шамамен бір сағат кетеді.
Dialogue: 0,1:08:08.54,1:08:11.45,Default,,0,0,0,,Ұрысқа дайындал! Тездетіп, нығайтыңыз!
Dialogue: 0,1:08:11.91,1:08:18.58,Default,,0,0,0,,Годзилла… Годзилла… Годзилла… Годзилла…
Dialogue: 0,1:08:20.00,1:08:23.62,Default,,0,0,0,,Таулардың дүбірі жарқыраған алқапты күйдіреді
Dialogue: 0,1:08:24.66,1:08:27.16,Default,,0,0,0,,Бірақ құстың баласы қайда?
Dialogue: 0,1:08:28.12,1:08:31.16,Default,,0,0,0,,Сыбырлаған дауыс нұрлы алқапта
Dialogue: 0,1:08:31.75,1:08:33.79,Default,,0,0,0,,Жұмыртқа айтады
Dialogue: 0,1:08:33.87,1:08:35.91,Default,,0,0,0,,Бұл сынақ уақыты
Dialogue: 0,1:08:37.37,1:08:40.33,Default,,0,0,0,,Годзилланың қозғалыс жылдамдығы 30 км/сағ дейін төмендеді
Dialogue: 0,1:08:40.66,1:08:43.83,Default,,0,0,0,,Осы қарқынмен алдымен бізді нығайтқан дұрыс.
Dialogue: 0,1:08:44.83,1:08:46.83,Default,,0,0,0,,Годзилла қозғалуды тоқтатты.
Dialogue: 0,1:08:47.08,1:08:48.25,Default,,0,0,0,,Неліктен тоқтады?
Dialogue: 0,1:08:51.75,1:08:53.20,Default,,0,0,0,,Кеңістіктік потенциалдық өзгерістерді сезіну!
Dialogue: 0,1:08:53.33,1:08:54.16,Default,,0,0,0,,Гарг!
Dialogue: 0,1:08:54.25,1:08:56.70,Default,,0,0,0,,Солтүстік-шығыс секторында жылу энергиясының буферлік аймағын дамыту!
Dialogue: 0,1:08:56.87,1:08:58.20,Default,,0,0,0,,Нанометалл бөлшектерінің дисперсиясының басталуы
Dialogue: 0,1:08:58.33,1:08:59.79,Default,,0,0,0,,Жылу энергиясының буферлік аймағын кеңейту
Dialogue: 0,1:08:59.87,1:09:02.62,Default,,0,0,0,,Әрбір секцияға арналған ламинатталған сауыт Шағылысу бұрышын реттеу Асығыңыз!
Dialogue: 0,1:09:02.83,1:09:04.41,Default,,0,0,0,,Түсінген Шағылу бұрышын реттеу
Dialogue: 0,1:09:04.54,1:09:07.12,Default,,0,0,0,,Нанометалл бөлшектері Кеңістікті толтыру концентрациясы 35%
Dialogue: 0,1:09:07.20,1:09:08.04,Default,,0,0,0,,Толтыру жалғасуда...
Dialogue: 0,1:09:08.12,1:09:09.25,Default,,0,0,0,,(Эндевор) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:09:09.33,1:09:10.45,Default,,0,0,0,,Ғарыштық потенциал тез көтеріледі!
Dialogue: 0,1:09:11.00,1:09:11.95,Default,,0,0,0,,Бұл жылу сәулесі!
Dialogue: 0,1:09:17.58,1:09:20.12,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:09:22.87,1:09:24.16,Default,,0,0,0,,Гү…
Dialogue: 0,1:09:28.58,1:09:29.66,Default,,0,0,0,,Уау
Dialogue: 0,1:09:30.70,1:09:32.00,Default,,0,0,0,,Жылу сәулесі сомманың солтүстік-шығыс бөлігіне жетеді
Dialogue: 0,1:09:32.08,1:09:34.91,Default,,0,0,0,,74% жылу энергиясының буферлік аймағына байланысты диффузиялық
Dialogue: 0,1:09:35.33,1:09:36.41,Default,,0,0,0,,Қалаға келтірілген зиянның көлемі қандай?
Dialogue: 0,1:09:36.50,1:09:39.91,Default,,0,0,0,,Біз тікелей соққыдан аман қалдық, бірақ кейбір аймақтарды бақылаудан айырылдық.
Dialogue: 0,1:09:40.12,1:09:41.00,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,1:09:41.66,1:09:43.66,Default,,0,0,0,,Ұзақ қашықтықтағы шабуылдарға төтеп бере алады
Dialogue: 0,1:09:43.87,1:09:45.50,Default,,0,0,0,,Годзилла қозғалысын жалғастырады
Dialogue: 0,1:09:46.20,1:09:47.12,Default,,0,0,0,,Ha
Dialogue: 0,1:09:47.37,1:09:49.00,Default,,0,0,0,,Бекініс қалай жүріп жатыр?
Dialogue: 0,1:09:49.50,1:09:52.16,Default,,0,0,0,,№1 гарпун батареясы соңғы тексеруден өтті.
Dialogue: 0,1:09:52.25,1:09:53.37,Default,,0,0,0,,Гарпун №2 батареясы
Dialogue: 0,1:09:53.66,1:09:55.87,Default,,0,0,0,,Ағымдағы жылу сәулелері рельс мылтық тірегін ерітті.
Dialogue: 0,1:09:56.20,1:09:58.08,Default,,0,0,0,,Қалпына келтіру үшін тағы 30 минут қажет.
Dialogue: 0,1:09:58.16,1:09:59.25,Default,,0,0,0,,Шұңқырға кептелді
Dialogue: 0,1:09:59.45,1:10:02.29,Default,,0,0,0,,Сіз мұны жалғыз жасай алмайсыз. Қалған екі машинаны жөнелтуден басқа амалымыз жоқ.
Dialogue: 0,1:10:02.37,1:10:04.58,Default,,0,0,0,,Қосалқы машинаның жұмыс жүйесі әлі реттелуде...
Dialogue: 0,1:10:04.83,1:10:06.70,Default,,0,0,0,,Бірінші құрылғының параметрлерін көшіріңіз
Dialogue: 0,1:10:06.79,1:10:07.91,Default,,0,0,0,,Сержант Майор Танидікі?
Dialogue: 0,1:10:08.00,1:10:10.25,Default,,0,0,0,,Сонда интерфейс жер тұрғындарына ғана тән болады...
Dialogue: 0,1:10:10.33,1:10:13.08,Default,,0,0,0,,Егер оның құрдастарының бірі ұшқыш болуға өз еркімен келсе.
Dialogue: 0,1:10:13.16,1:10:14.00,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,1:10:14.25,1:10:16.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:17.75,1:10:20.33,Default,,0,0,0,,Годзилланың екінші толқын шабуылының белгісі жоқ
Dialogue: 0,1:10:20.75,1:10:22.83,Default,,0,0,0,,Қалаға шамамен 20 минутта жетеміз.
Dialogue: 0,1:10:27.50,1:10:28.62,Default,,0,0,0,,Мен екінші ұшаққа мінемін.
Dialogue: 0,1:10:29.25,1:10:30.83,Default,,0,0,0,,Мен мұны қолмен жасаймын.
Dialogue: 0,1:10:30.91,1:10:32.50,Default,,0,0,0,,Үшінші ұшақ менікі.
Dialogue: 0,1:10:33.08,1:10:34.66,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,1:10:34.83,1:10:35.95,Default,,0,0,0,,Командир алдыңғы шепте...
Dialogue: 0,1:10:36.04,1:10:37.91,Default,,0,0,0,,Бұрынғы дау-дамайдан бәрі ренжіп қалды.
Dialogue: 0,1:10:38.12,1:10:39.70,Default,,0,0,0,,Одақтастар арасындағы бірлік маңызды
Dialogue: 0,1:10:40.08,1:10:41.79,Default,,0,0,0,,Жекпе-жекте мен алға шығамын.
Dialogue: 0,1:10:41.91,1:10:42.75,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:10:42.83,1:10:46.16,Default,,0,0,0,,Гарг Годзилланың алдында бір ғана нәрсе істеу керек.
Dialogue: 0,1:10:46.37,1:10:48.58,Default,,0,0,0,,Мен қазір саған сенемін
Dialogue: 0,1:10:49.45,1:10:51.00,Default,,0,0,0,,Мехагодзилланың күші
Dialogue: 0,1:10:51.25,1:10:52.33,Default,,0,0,0,,Харуо…
Dialogue: 0,1:10:53.16,1:10:54.33,Default,,0,0,0,,Кишибе Рохан секілді күші бар біреу!
Dialogue: 0,1:10:58.95,1:11:01.29,Default,,0,0,0,,Гарг Годзилланың жағдайы қандай?
Dialogue: 0,1:11:01.45,1:11:03.33,Default,,0,0,0,,Екінші толқын шабуылы әлі жоқ
Dialogue: 0,1:11:03.66,1:11:06.12,Default,,0,0,0,,Алыстан шабуыл жасаудың пайдасы жоқ екенін түсінсе керек.
Dialogue: 0,1:11:06.83,1:11:09.83,Default,,0,0,0,,Барлық Vulture ұшақтары қону палубасында күту режимінде.
Dialogue: 0,1:11:10.62,1:11:12.20,Default,,0,0,0,,Жарылыс дефлекторын растау
Dialogue: 0,1:11:16.41,1:11:17.29,Default,,0,0,0,,Уф
Dialogue: 0,1:11:18.79,1:11:20.87,Default,,0,0,0,,1 блокты кез келген уақытта жіберуге болады
Dialogue: 0,1:11:21.00,1:11:22.83,Default,,0,0,0,,2-ші ұшақ орналастыруға дайын.
Dialogue: 0,1:11:23.04,1:11:24.41,Default,,0,0,0,,Харуо, бара аласың ба?
Dialogue: 0,1:11:24.75,1:11:27.66,Default,,0,0,0,,А, мен кете аламын. Біріншіден, мен кептеліп қалдым.
Dialogue: 0,1:11:28.29,1:11:30.91,Default,,0,0,0,,Оң қанатына қайта-қайта соққы беру.
Dialogue: 0,1:11:31.08,1:11:32.20,Default,,0,0,0,,Мен сені алаңдатамын.
Dialogue: 0,1:11:32.29,1:11:34.95,Default,,0,0,0,,Жеткілікті биіктікке жеткеннен кейін мен сүңгуір шабуылын жасаймын.
Dialogue: 0,1:11:35.37,1:11:36.33,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:11:37.87,1:11:39.83,Default,,0,0,0,,Барлық Vulture машиналары сұрыпталады!
Dialogue: 0,1:11:54.45,1:11:55.29,Default,,0,0,0,,Кяах!
Dialogue: 0,1:12:03.58,1:12:05.16,Default,,0,0,0,,Мен мұны бірінші рейсімде орындаймын.
Dialogue: 0,1:12:05.50,1:12:07.75,Default,,0,0,0,,Бұл №3 лашын. Жағдай қандай?
Dialogue: 0,1:12:08.41,1:12:12.37,Default,,0,0,0,,Годзилла оңтүстікке, соммаға қарай бет алды. Жоспарланған курсты орындау үшін нұсқаулық қажет.
Dialogue: 0,1:12:12.54,1:12:14.16,Default,,0,0,0,,Мені ұстап тұрғанда басшылық...
Dialogue: 0,1:12:14.54,1:12:17.79,Default,,0,0,0,,Бұрынғы шабуыл біздің қатысуымызды растады.
Dialogue: 0,1:12:17.91,1:12:20.95,Default,,0,0,0,,Гарпунның солтүстік-шығыс жағы, №2 батарея, басқару жүйесінің қатесі.
Dialogue: 0,1:12:21.04,1:12:22.25,Default,,0,0,0,,Бастау мүмкін емес!
Dialogue: 0,1:12:22.87,1:12:25.33,Default,,0,0,0,,Харуо! Екінші батарея уақытында дайын болмайды.
Dialogue: 0,1:12:25.91,1:12:26.75,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:12:27.20,1:12:30.16,Default,,0,0,0,,№2 батарея дереу істен шығады. Тек бір Гарпун қалады.
Dialogue: 0,1:12:30.25,1:12:32.08,Default,,0,0,0,,Жоспарланған операцияны бастаңыз
Dialogue: 0,1:12:32.16,1:12:34.00,Default,,0,0,0,,Рельс қаруының алдыңғы порты толығымен кеңейтілді
Dialogue: 0,1:12:34.08,1:12:34.91,Default,,0,0,0,,Жүгір!
Dialogue: 0,1:12:35.70,1:12:37.45,Default,,0,0,0,,Юко Берубе Мұны естідіңіз бе?
Dialogue: 0,1:12:37.54,1:12:41.20,Default,,0,0,0,,Шығысқа қарай бұрылыңыз және көтеріліңіз, оны тұзаққа түсіріңіз.
Dialogue: 0,1:12:41.79,1:12:42.83,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:12:43.25,1:12:44.16,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:12:48.04,1:12:49.50,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:12:52.16,1:12:54.20,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,1:12:59.91,1:13:00.75,Default,,0,0,0,,Бұл жеткіліксіз бе?
Dialogue: 0,1:13:02.25,1:13:03.45,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,1:13:05.91,1:13:09.83,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:13:11.29,1:13:13.04,Default,,0,0,0,,Қарғыс атқыр, бізді елеме!
Dialogue: 0,1:13:13.20,1:13:14.50,Default,,0,0,0,,Бұл қашықтық жақсы емес пе?
Dialogue: 0,1:13:14.70,1:13:16.41,Default,,0,0,0,,Жақын қашықтықты шектеуге ауысыңыз
Dialogue: 0,1:13:16.66,1:13:17.58,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:13:30.37,1:13:31.20,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:13:31.33,1:13:32.66,Default,,0,0,0,,Жақын қашықтықта да жақсы емес пе?
Dialogue: 0,1:13:34.95,1:13:36.50,Default,,0,0,0,,Бұл келе жатыр! Таратыңыз!
Dialogue: 0,1:13:40.25,1:13:41.87,Default,,0,0,0,,Гү…
Dialogue: 0,1:13:50.00,1:13:52.33,Default,,0,0,0,,Мына жақтан кел!
Dialogue: 0,1:13:53.91,1:13:55.91,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:13:59.54,1:14:01.20,Default,,0,0,0,,Годзилла Бағытты жоспарланған бағытқа өзгерту
Dialogue: 0,1:14:02.37,1:14:03.20,Default,,0,0,0,,Қазіргі жасыңда мәңгі қалу—
Dialogue: 0,1:14:03.50,1:14:05.16,Default,,0,0,0,,Гарпун жақсы ма?
Dialogue: 0,1:14:05.87,1:14:08.16,Default,,0,0,0,,Жақсы! Оны тұзақ нүктесіне бағыттаңыз
Dialogue: 0,1:14:08.70,1:14:09.66,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,1:14:11.95,1:14:13.16,Default,,0,0,0,,Кеңістік потенциалының кенеттен көтерілуі
Dialogue: 0,1:14:13.29,1:14:14.12,Default,,0,0,0,,Ha
Dialogue: 0,1:14:19.29,1:14:21.37,Default,,0,0,0,,Годзилланың жылу сәулелері бірінші ұшақтың жанынан өтті
Dialogue: 0,1:14:21.79,1:14:22.87,Default,,0,0,0,,Жақсысың ба? Юко!
Dialogue: 0,1:14:22.95,1:14:23.79,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:14:26.16,1:14:27.95,Default,,0,0,0,,Жерден бақылау ақпараты
Dialogue: 0,1:14:28.41,1:14:30.66,Default,,0,0,0,,Годзилла жылу сәулелерінің энергиясының есептік мөлшері...
Dialogue: 0,1:14:30.83,1:14:32.87,Default,,0,0,0,,Ах... 3 терават
Dialogue: 0,1:14:32.95,1:14:34.70,Default,,0,0,0,,Есептік мәннен әлдеқайда жоғары
Dialogue: 0,1:14:34.83,1:14:37.62,Default,,0,0,0,,Неліктен мұндай құбыжықты жеңе аламын деп ойлайсың?
Dialogue: 0,1:14:38.50,1:14:41.87,Default,,0,0,0,,Капитан Сакаки Сіз бұта таңдадыңыз деп ойлаймын.
Dialogue: 0,1:14:48.91,1:14:51.20,Default,,0,0,0,,Бағыттау нүктесіне дейін 800 метр тегіс
Dialogue: 0,1:14:52.37,1:14:55.33,Default,,0,0,0,,Trap Барлық бөлімдер Жетек жүйесін тексеру аяқталды
Dialogue: 0,1:14:55.45,1:14:56.58,Default,,0,0,0,,Іске қосуға дайындық ОК
Dialogue: 0,1:14:57.87,1:15:00.37,Default,,0,0,0,,Гарпун батареясы №1 Соңғы тексеру кезінде қате орын алды
Dialogue: 0,1:15:00.50,1:15:01.62,Default,,0,0,0,,Не!
Dialogue: 0,1:15:02.16,1:15:03.70,Default,,0,0,0,,Годзилла қазірдің өзінде тұзаққа түсті.
Dialogue: 0,1:15:04.16,1:15:05.00,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,1:15:05.12,1:15:05.95,Default,,0,0,0,,Харуо
Dialogue: 0,1:15:06.08,1:15:07.25,Default,,0,0,0,,Уақытты сатып алудан басқа амалымыз жоқ.
Dialogue: 0,1:15:09.83,1:15:11.87,Default,,0,0,0,,Аяғыңда от шашу!
Dialogue: 0,1:15:12.70,1:15:16.37,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,1:15:17.83,1:15:18.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:15:25.33,1:15:26.20,Default,,0,0,0,,Тағы да!
Dialogue: 0,1:15:27.87,1:15:29.08,Default,,0,0,0,,Шабуыл позицияңызды өзгертіңіз!
Dialogue: 0,1:15:36.45,1:15:38.08,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:15:38.58,1:15:40.29,Default,,0,0,0,,Годзилла әлі орындалуда
Dialogue: 0,1:15:40.50,1:15:43.79,Default,,0,0,0,,Қарғыс атсын... №1 гарпун батареясымен не болып жатыр!
Dialogue: 0,1:15:43.87,1:15:44.79,Default,,0,0,0,,Бұл әлі біраз уақыт алады.
Dialogue: 0,1:15:46.58,1:15:48.50,Default,,0,0,0,,Енді сізді тоқтату мүмкін емес.
Dialogue: 0,1:15:50.20,1:15:52.50,Default,,0,0,0,,50 метр қалды… 30 метр…
Dialogue: 0,1:15:53.79,1:15:54.70,Default,,0,0,0,,Тұзақ нүктесіне жету
Dialogue: 0,1:15:55.12,1:15:56.20,Default,,0,0,0,,Жаса, Гарг!
Dialogue: 0,1:15:56.41,1:15:58.33,Default,,0,0,0,,Құла!
Dialogue: 0,1:16:00.45,1:16:03.20,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:16:03.33,1:16:04.54,Default,,0,0,0,,А, жарайды!
Dialogue: 0,1:16:04.87,1:16:06.29,Default,,0,0,0,,Жалған құрыш тақтасының құлпы ашылды
Dialogue: 0,1:16:06.66,1:16:08.29,Default,,0,0,0,,Годзилла қақпанға құлады!
Dialogue: 0,1:16:08.37,1:16:09.20,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:16:09.83,1:16:10.95,Default,,0,0,0,,Такси жолы ашық!
Dialogue: 0,1:16:12.08,1:16:13.95,Default,,0,0,0,,Нүктеге жету үшін такси жолын ашыңыз
Dialogue: 0,1:16:14.29,1:16:17.66,Default,,0,0,0,,Garg Жылу энергиясының буферлік аймағын максималды концентрацияға дейін кеңейтіңіз.
Dialogue: 0,1:16:17.75,1:16:18.83,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,1:16:18.91,1:16:20.29,Default,,0,0,0,,Нанометалл бөлшектерінің шашырауы!
Dialogue: 0,1:16:21.04,1:16:24.66,Default,,0,0,0,,Нанометалл бөлшектерінің дисперсиясы Жылу энергиясының буферлік аймағын орналастыру!
Dialogue: 0,1:16:25.29,1:16:28.25,Default,,0,0,0,,Харуо, мен сізден мені басып алу нүктесіне апаруыңызды өтіндім.
Dialogue: 0,1:16:28.33,1:16:30.54,Default,,0,0,0,,О, Юко Берубе, естідің бе?
Dialogue: 0,1:16:30.62,1:16:31.75,Default,,0,0,0,,Мен азғынға айналсам жақсы емес пе?
Dialogue: 0,1:16:31.87,1:16:33.08,Default,,0,0,0,,Тез орындайық
Dialogue: 0,1:16:33.20,1:16:34.50,Default,,0,0,0,,Барлық ұшақтар төмендейді!
Dialogue: 0,1:16:36.58,1:16:37.41,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:16:40.00,1:16:41.29,Default,,0,0,0,,Ғарыштық потенциал тез көтеріледі!
Dialogue: 0,1:16:41.83,1:16:42.66,Default,,0,0,0,,Бұл келе жатыр!
Dialogue: 0,1:16:42.75,1:16:43.58,Default,,0,0,0,,Харуо!
Dialogue: 0,1:16:47.58,1:16:49.83,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:16:51.41,1:16:52.75,Default,,0,0,0,,Сенпай! Харуо!
Dialogue: 0,1:16:54.08,1:16:55.16,Default,,0,0,0,,Келесі орын – оңтүстік-оңтүстік-шығыс!
Dialogue: 0,1:16:55.41,1:16:56.25,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,1:16:57.33,1:16:59.00,Default,,0,0,0,,Сіз маған тағы да көмектестіңіз бе?
Dialogue: 0,1:17:03.08,1:17:06.66,Default,,0,0,0,,Буферлік аймақ Диффузия 92% Тікелей соққы зақымдануы шамалы
Dialogue: 0,1:17:06.75,1:17:09.83,Default,,0,0,0,,Годзилла Такси жолымен басып алу нүктесіне қарай жылыңыз.
Dialogue: 0,1:17:13.83,1:17:16.25,Default,,0,0,0,,Гарпун батареясы 1 Соңғы тексеру аяқталды
Dialogue: 0,1:17:16.58,1:17:17.62,Default,,0,0,0,,Кез келген уақытта атуға болады!
Dialogue: 0,1:17:17.87,1:17:19.04,Default,,0,0,0,,Сіз оны уақытында орындадыңыз ба?
Dialogue: 0,1:17:19.16,1:17:21.29,Default,,0,0,0,,Әрине, егер бұл Фу Билсалдо болса.
Dialogue: 0,1:17:21.54,1:17:22.91,Default,,0,0,0,,Гарпунды хабардар етпеңіз
Dialogue: 0,1:17:23.66,1:17:24.91,Default,,0,0,0,,Біз сізді бақылауды жалғастырамыз!
Dialogue: 0,1:17:25.04,1:17:25.87,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:17:25.95,1:17:26.79,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:17:32.91,1:17:34.50,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,1:17:38.75,1:17:40.29,Default,,0,0,0,,Басқарылатын бомбалауды бастаңыз!
Dialogue: 0,1:17:40.50,1:17:42.79,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,1:17:44.58,1:17:47.87,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:17:48.50,1:17:50.75,Default,,0,0,0,,Годзилла Түсіру нүктесіне қарай жылдамдықты арттырады
Dialogue: 0,1:17:50.95,1:17:53.58,Default,,0,0,0,,Келіңіз, бейітіңізге келіңіз.
Dialogue: 0,1:17:57.16,1:17:59.41,Default,,0,0,0,,Годзилла құйрығымен айналасын жыртып жатыр!
Dialogue: 0,1:17:59.50,1:18:01.33,Default,,0,0,0,,Маған бәрібір! Түсіруді жалғастырыңыз!
Dialogue: 0,1:18:09.12,1:18:10.91,Default,,0,0,0,,Түсіру нүктесіне дейін 900 метр қалды
Dialogue: 0,1:18:11.54,1:18:12.91,Default,,0,0,0,,Мектептен шығарылу үшін қажет найзағайлар: 7 қалды
Dialogue: 0,1:18:13.54,1:18:14.95,Default,,0,0,0,,Ату! Мені атып таста!
Dialogue: 0,1:18:15.04,1:18:20.33,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:18:20.75,1:18:23.20,Default,,0,0,0,,Сіз ұстанасыз. Аспанда күтіңіз.
Dialogue: 0,1:18:24.16,1:18:25.91,Default,,0,0,0,,жетуге 500 метр қалды
Dialogue: 0,1:18:29.12,1:18:30.00,Default,,0,0,0,,Құт
Dialogue: 0,1:18:30.37,1:18:31.20,Default,,0,0,0,,Уф...
Dialogue: 0,1:18:31.50,1:18:32.33,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:18:33.33,1:18:34.83,Default,,0,0,0,,Жақында түсіру нүктесі
Dialogue: 0,1:18:36.29,1:18:38.70,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:18:40.66,1:18:42.37,Default,,0,0,0,,Годзилла түсіру нүктесіне жетті!
Dialogue: 0,1:18:42.50,1:18:44.66,Default,,0,0,0,,Гарг! Такси жолының қалқаны жабылды!
Dialogue: 0,1:18:44.75,1:18:45.87,Default,,0,0,0,,Сұйықтық нанометалл инъекциясы!
Dialogue: 0,1:18:46.54,1:18:50.08,Default,,0,0,0,,Такси жолының қалқасының жабылуы Сұйықтық нанометалл инъекциясы!
Dialogue: 0,1:18:59.04,1:19:02.29,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:19:02.45,1:19:05.75,Default,,0,0,0,,Сұйық нанометалл 30% тиімді толтыру мөлшеріне қалды
Dialogue: 0,1:19:06.25,1:19:07.37,Default,,0,0,0,,10 пайыз…
Dialogue: 0,1:19:08.87,1:19:10.16,Default,,0,0,0,,Емдеу басталады!
Dialogue: 0,1:19:11.75,1:19:14.08,Default,,0,0,0,,Нанометалды шыңдау! 30 секундқа созылуы керек
Dialogue: 0,1:19:14.20,1:19:15.25,Default,,0,0,0,,Түсіруді бастаңыз!
Dialogue: 0,1:19:15.37,1:19:19.00,Default,,0,0,0,,(Қатты атыс дыбысы)
Dialogue: 0,1:19:21.12,1:19:25.45,Default,,0,0,0,,(Годзилланың айқайы)
Dialogue: 0,1:19:25.70,1:19:29.12,Default,,0,0,0,,Годзилла денесінің бетіндегі электромагниттік импульсті реттеу жылдамдығы 90%
Dialogue: 0,1:19:29.62,1:19:32.16,Default,,0,0,0,,Екі қанат мұнарасы Годзилланың арқа қанатына бағытталған синхрондалады!
Dialogue: 0,1:19:32.50,1:19:34.83,Default,,0,0,0,,Екі қанат мұнарасы Арқа қанатына синхрондалған мақсат!
Dialogue: 0,1:19:35.33,1:19:37.25,Default,,0,0,0,,Метаматериалдық қалқанның сыну нүктесі келеді
Dialogue: 0,1:19:37.70,1:19:39.12,Default,,0,0,0,,Сәйкестік көрсеткіші 95%
Dialogue: 0,1:19:39.20,1:19:40.91,Default,,0,0,0,,Шу толқын ұзындығымен резонансты тексеру
Dialogue: 0,1:19:43.29,1:19:44.87,Default,,0,0,0,,5… 4…
Dialogue: 0,1:19:45.29,1:19:48.16,Default,,0,0,0,,3… 2… 1…
Dialogue: 0,1:19:48.25,1:19:49.08,Default,,0,0,0,,Сәйкестендіріңіз!
Dialogue: 0,1:19:49.20,1:19:50.04,Default,,0,0,0,,Өрт!
Dialogue: 0,1:19:54.75,1:19:57.75,Default,,0,0,0,,Нысанаға тигізу. Арқа қанаты сәтті жойылды
Dialogue: 0,1:19:58.08,1:20:00.62,Default,,0,0,0,,Қалқанның шығуы 80%-ға дейін төмендетілді
Dialogue: 0,1:20:01.12,1:20:02.25,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,1:20:02.33,1:20:03.91,Default,,0,0,0,,Шығару одан әрі қысқарды
Dialogue: 0,1:20:04.00,1:20:05.41,Default,,0,0,0,,30 пайыздан аз!
Dialogue: 0,1:20:06.79,1:20:07.62,Default,,0,0,0,,Жақында!
Dialogue: 0,1:20:08.79,1:20:09.79,Default,,0,0,0,,Қалқан жоғалып кетті!
Dialogue: 0,1:20:09.91,1:20:10.75,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:20:10.83,1:20:11.83,Default,,0,0,0,,EMP Гарпуны!
Dialogue: 0,1:20:13.54,1:20:14.66,Default,,0,0,0,,Өрт!
Dialogue: 0,1:20:17.16,1:20:18.75,Default,,0,0,0,,(Соққы дыбысы)
Dialogue: 0,1:20:19.00,1:20:20.16,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:20:20.25,1:20:21.37,Default,,0,0,0,,Оқ атуды тоқтатыңыз!
Dialogue: 0,1:20:21.66,1:20:22.87,Default,,0,0,0,,Жағдайды хабарлау
Dialogue: 0,1:20:22.95,1:20:25.16,Default,,0,0,0,,Гарпун Годзилланың дене бетіне енеді
Dialogue: 0,1:20:25.70,1:20:27.91,Default,,0,0,0,,Электромагниттік импульстік сәулелену Қажетті тереңдікті қамтамасыз етіңіз!
Dialogue: 0,1:20:29.29,1:20:30.12,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,1:20:30.25,1:20:31.08,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:20:31.16,1:20:33.87,Default,,0,0,0,,Енді ішкі электромагниттік толқындар жабайы жүрсін.
Dialogue: 0,1:20:34.16,1:20:35.29,Default,,0,0,0,,Электромагниттік импульстік сәулелену
Dialogue: 0,1:20:38.08,1:20:38.91,Default,,0,0,0,,Толық кауль!
Dialogue: 0,1:20:39.00,1:20:39.83,Default,,0,0,0,,Есіңізде болсын!
Dialogue: 0,1:20:40.20,1:20:41.20,Default,,0,0,0,,Бұл соңы!
Dialogue: 0,1:20:48.16,1:20:49.95,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:20:58.08,1:21:00.54,Default,,0,0,0,,(дауысты азайту)
Dialogue: 0,1:21:01.08,1:21:04.12,Default,,0,0,0,,Мен жасадым! о! Біз мұны ақыры жасадық!
Dialogue: 0,1:21:04.20,1:21:05.29,Default,,0,0,0,,Годзилла Тыныштық!
Dialogue: 0,1:21:05.37,1:21:07.20,Default,,0,0,0,,Ішкі электромагниттік толқындардың қашу күйі
Dialogue: 0,1:21:07.50,1:21:10.37,Default,,0,0,0,,Жүр, үрле, Годзилла!
Dialogue: 0,1:21:28.37,1:21:29.41,Default,,0,0,0,,Әлі жарылыс жоқ па?
Dialogue: 0,1:21:29.62,1:21:32.20,Default,,0,0,0,,Асықпаңыз, бақылау мәліметтерін қалаға жіберіңіз!
Dialogue: 0,1:21:32.62,1:21:33.54,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:35.91,1:21:38.41,Default,,0,0,0,,Годзилланың айналасындағы ауа қысымының таралуы тез өзгереді!
Dialogue: 0,1:21:38.70,1:21:39.54,Default,,0,0,0,,Не?
Dialogue: 0,1:21:39.66,1:21:45.45,Default,,0,0,0,,(Жарылу дыбысы)
Dialogue: 0,1:21:54.12,1:21:55.20,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:21:55.29,1:21:56.75,Default,,0,0,0,,Годзилла жарылып кетпей ме?
Dialogue: 0,1:21:57.29,1:21:59.54,Default,,0,0,0,,Операция сәтті өтті, солай емес пе?
Dialogue: 0,1:21:59.91,1:22:01.45,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,1:22:01.70,1:22:04.91,Default,,0,0,0,,Годзилланың айналасындағы температура көтеріледі.
Dialogue: 0,1:22:05.00,1:22:06.66,Default,,0,0,0,,Әлі де 500 градустан жоғары көтерілуде
Dialogue: 0,1:22:07.50,1:22:08.33,Default,,0,0,0,,600 градус!
Dialogue: 0,1:22:08.91,1:22:10.04,Default,,0,0,0,,Өртене бер!
Dialogue: 0,1:22:10.66,1:22:11.87,Default,,0,0,0,,800 градус…
Dialogue: 0,1:22:13.41,1:22:14.66,Default,,0,0,0,,1000 градусты бұзу!
Dialogue: 0,1:22:14.75,1:22:15.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:22:16.29,1:22:19.25,Default,,0,0,0,,Ішкі электромагниттік толқындар жылуға айнала ма?
Dialogue: 0,1:22:19.83,1:22:21.91,Default,,0,0,0,,Ыстықтан өлемін бе?
Dialogue: 0,1:22:22.58,1:22:23.41,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:22:23.50,1:22:25.70,Default,,0,0,0,,Одан да қорқынышты нәрсе болғалы тұр.
Dialogue: 0,1:22:32.33,1:22:34.79,Default,,0,0,0,,(жоғары дыбыс)
Dialogue: 0,1:22:34.91,1:22:37.00,Default,,0,0,0,,Годзилланың айналасындағы қоршау ериді!
Dialogue: 0,1:22:37.08,1:22:39.54,Default,,0,0,0,,Қоршаған ауаның температурасы 1000 градустан асады!
Dialogue: 0,1:22:39.62,1:22:41.70,Default,,0,0,0,,Қалқан жоқ
Dialogue: 0,1:22:42.25,1:22:44.33,Default,,0,0,0,,Үй ішіндегі температура да көтерілуде!
Dialogue: 0,1:22:45.54,1:22:48.66,Default,,0,0,0,,Иә, бұл дәл осылай болды.
Dialogue: 0,1:22:48.83,1:22:52.16,Default,,0,0,0,,Бұл қалыпты жылудың таралуы емес. Бұл молекулалық бақылаудың бір түрі.
Dialogue: 0,1:22:52.83,1:22:56.00,Default,,0,0,0,,Бұл оның шабуылы, сондықтан қақпақты пайдаланудың қажеті жоқ.
Dialogue: 0,1:22:56.12,1:22:57.29,Default,,0,0,0,,Қайда болсаң да өртеніп өлесің!
Dialogue: 0,1:22:58.25,1:23:01.08,Default,,0,0,0,,Үй ішіндегі температура одан әрі көтеріледі Температура бақылаудан тыс!
Dialogue: 0,1:23:01.37,1:23:03.16,Default,,0,0,0,,Бақылау! не болып жатыр...
Dialogue: 0,1:23:03.41,1:23:05.04,Default,,0,0,0,,Бұл жерде жақсы емес! Эвакуациялайық
Dialogue: 0,1:23:05.12,1:23:06.00,Default,,0,0,0,,Иә
Dialogue: 0,1:23:06.16,1:23:07.20,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,1:23:08.50,1:23:12.66,Default,,0,0,0,,Енді адам болудан келетін жеңілістің бетін қайтаратын кез.
Dialogue: 0,1:23:13.29,1:23:14.12,Default,,0,0,0,,Мырзалар!
Dialogue: 0,1:23:14.25,1:23:15.08,Default,,0,0,0,,Гарг…
Dialogue: 0,1:23:15.16,1:23:17.20,Default,,0,0,0,,Бұдан былай, біз
Dialogue: 0,1:23:17.29,1:23:18.66,Default,,0,0,0,,Ерік пен ақылдың жүзімен
Dialogue: 0,1:23:18.75,1:23:20.16,Default,,0,0,0,,Тағдыр өсиетін кесіп таста (Бирсалдо солдаты Б) Уау
Dialogue: 0,1:23:21.12,1:23:24.29,Default,,0,0,0,,Болат соусы! Оның өзі болаттан жасалған!
Dialogue: 0,1:23:24.66,1:23:25.50,Default,,0,0,0,,Бастаулар елі...
Dialogue: 0,1:23:26.20,1:23:28.91,Default,,0,0,0,,Мен балтамды ормандағы бірінші ағашқа айдаған сәттен бастап
Dialogue: 0,1:23:29.50,1:23:31.33,Default,,0,0,0,,Бұл болашаққа уәде етілген!
Dialogue: 0,1:23:31.41,1:23:32.25,Default,,0,0,0,,Бұл...
Dialogue: 0,1:23:32.33,1:23:36.12,Default,,0,0,0,,Билеуші ​​ретінде кім аман қалады, біз бе әлде ол ма?
Dialogue: 0,1:23:36.83,1:23:39.33,Default,,0,0,0,,Уф... Шайқас басталғалы жатыр.
Dialogue: 0,1:23:40.45,1:23:42.45,Default,,0,0,0,,Бұл әзіл емес. Кешіріңіз.
Dialogue: 0,1:23:43.16,1:23:44.45,Default,,0,0,0,,Барлығы қашады!
Dialogue: 0,1:23:44.58,1:23:46.00,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:46.54,1:23:48.83,Default,,0,0,0,,Өйткені, олар төменгі нәсілдер...
Dialogue: 0,1:23:49.16,1:23:50.70,Default,,0,0,0,,Осы жолмен! Асығыңыз!
Dialogue: 0,1:23:54.66,1:23:55.87,Default,,0,0,0,,Гррр…
Dialogue: 0,1:23:55.95,1:23:57.50,Default,,0,0,0,,Бірақ Хару...
Dialogue: 0,1:23:59.16,1:24:01.41,Default,,0,0,0,,Мен сенемін, тек сен ғана басқасың.
Dialogue: 0,1:24:01.83,1:24:03.12,Default,,0,0,0,,Жауап бер, Гарг!
Dialogue: 0,1:24:03.58,1:24:05.29,Default,,0,0,0,,Қат! Мен не істеуім керек...
Dialogue: 0,1:24:05.37,1:24:07.33,Default,,0,0,0,,Харуо шабуылын жалғастырайық
Dialogue: 0,1:24:08.00,1:24:08.83,Default,,0,0,0,,Бұл жоғары қызба
Dialogue: 0,1:24:09.08,1:24:13.37,Default,,0,0,0,,Бұл оның қуатты шоғырландырудың орнына босатуынан туындаған молекулалық діріл.
Dialogue: 0,1:24:13.45,1:24:17.16,Default,,0,0,0,,Тағы да біз ыстық сәулені түсіру үшін жеткілікті жоғары кернеуді индукциялауымыз керек.
Dialogue: 0,1:24:17.87,1:24:19.20,Default,,0,0,0,,Жарайды, мен сені қоздырамын.
Dialogue: 0,1:24:19.50,1:24:21.25,Default,,0,0,0,,Юко Тыңдаңыз! сізді түсіндім!
Dialogue: 0,1:24:24.33,1:24:26.50,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:24:27.20,1:24:28.04,Default,,0,0,0,,(Эндевор) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:24:28.16,1:24:29.00,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:24:34.33,1:24:36.70,Default,,0,0,0,,Сен… италиялықсың ғой?
Dialogue: 0,1:24:36.79,1:24:39.04,Default,,0,0,0,,Қарғыс атсын... жақындау мүмкін емес.
Dialogue: 0,1:24:39.33,1:24:41.79,Default,,0,0,0,,Барлық ұшақтар осы қашықтықта бұрылуды сақтайды.
Dialogue: 0,1:24:41.87,1:24:42.75,Default,,0,0,0,,Түсіруді бастаңыз!
Dialogue: 0,1:24:42.83,1:24:43.66,Default,,0,0,0,,Құт
Dialogue: 0,1:24:44.16,1:24:45.58,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,1:24:58.00,1:25:00.04,Default,,0,0,0,,Тезірек қаладан кетіңіз.
Dialogue: 0,1:25:00.12,1:25:02.25,Default,,0,0,0,,Бірнеше минуттан кейін күйіп өлесің.
Dialogue: 0,1:25:02.33,1:25:03.37,Default,,0,0,0,,(Байланысты қабылдау дыбысы)
Dialogue: 0,1:25:03.45,1:25:07.16,Default,,0,0,0,,Сыртқы жиектің оңтүстік-шығыс жағына қарай жүгіріңіз. Жартасты жердегі жарықшақты көру керек.
Dialogue: 0,1:25:07.87,1:25:09.33,Default,,0,0,0,,Метфис мырза!
Dialogue: 0,1:25:11.00,1:25:12.20,Default,,0,0,0,,(Эндевор) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:25:12.66,1:25:16.16,Default,,0,0,0,,Уф... Барлық ұшақтар ажыратылып, көтеріледі!
Dialogue: 0,1:25:20.33,1:25:22.50,Default,,0,0,0,,Бұл ыстықпен мен тіпті қашықтықта тұра алмаймын.
Dialogue: 0,1:25:22.75,1:25:25.50,Default,,0,0,0,,Гарпунды оттай алмайсың ба?
Dialogue: 0,1:25:25.75,1:25:27.45,Default,,0,0,0,,Тұғыр еріген.
Dialogue: 0,1:25:29.33,1:25:31.70,Default,,0,0,0,,Бұл Харуо қаласының ұсынысы.
Dialogue: 0,1:25:32.29,1:25:34.95,Default,,0,0,0,,Тропопаузаға көтеріліп, күшті сүңгу.
Dialogue: 0,1:25:35.04,1:25:35.87,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:25:36.00,1:25:39.41,Default,,0,0,0,,Годзилланың дене бетіне ену үшін жеткілікті үдеу алады
Dialogue: 0,1:25:39.58,1:25:41.54,Default,,0,0,0,,Біз гарпун боламыз.
Dialogue: 0,1:25:42.37,1:25:43.95,Default,,0,0,0,,Бұл жанкешті бомба шабуылы ма?
Dialogue: 0,1:25:44.37,1:25:47.50,Default,,0,0,0,,Біздің соңғы формамызда күш мәселесі жоқ.
Dialogue: 0,1:25:47.95,1:25:50.75,Default,,0,0,0,,Сәттілік көрсеткіші 1 емес, 2 ұшақ және 2 емес, 3 ұшақ болған жағдайда жоғары болады.
Dialogue: 0,1:25:50.83,1:25:53.75,Default,,0,0,0,,Бірақ сол жоғары қызбамен мен саған жақындай да алмаймын.
Dialogue: 0,1:25:54.12,1:25:57.79,Default,,0,0,0,,Вультурдың құрылымына байланысты ыстыққа осал жері бір ғана.
Dialogue: 0,1:25:57.87,1:25:59.95,Default,,0,0,0,,Нанометалл алғашқы көмекпен емдесек.
Dialogue: 0,1:26:00.16,1:26:03.16,Default,,0,0,0,,Теориялық тұрғыдан ол 8000 градусқа 10 секундқа шыдайды
Dialogue: 0,1:26:03.25,1:26:04.29,Default,,0,0,0,,Бәрін тек қана жап-жасырып қойдың ба?
Dialogue: 0,1:26:05.20,1:26:08.58,Default,,0,0,0,,Жылуға сезімтал бөлшектер? бұл қайда
Dialogue: 0,1:26:08.66,1:26:09.95,Default,,0,0,0,,Ha
Dialogue: 0,1:26:10.16,1:26:11.00,Default,,0,0,0,,Гарг!
Dialogue: 0,1:26:11.08,1:26:13.29,Default,,0,0,0,,Бұл сенсің, Харуо.
Dialogue: 0,1:26:13.83,1:26:15.41,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:26:18.00,1:26:19.12,Default,,0,0,0,,Ха…
Dialogue: 0,1:26:20.20,1:26:21.04,Default,,0,0,0,,Уф!
Dialogue: 0,1:26:24.12,1:26:24.95,Default,,0,0,0,,Не?
Dialogue: 0,1:26:25.04,1:26:26.08,Default,,0,0,0,,Кяаааааааааа!
Dialogue: 0,1:26:26.37,1:26:27.91,Default,,0,0,0,,Юко! ол аурады! Ауырды...
Dialogue: 0,1:26:28.00,1:26:31.12,Default,,0,0,0,,Нанометалдармен ассимиляцияға түскен өтініш берушілер ғана емес пе еді?
Dialogue: 0,1:26:31.58,1:26:33.00,Default,,0,0,0,,Гарг! Гарг!
Dialogue: 0,1:26:33.45,1:26:35.16,Default,,0,0,0,,Ауырсыну тек басында болады
Dialogue: 0,1:26:35.62,1:26:39.12,Default,,0,0,0,,Жақында өзіңізді жақсы сезінесіз. Демалыңыз және беріліңіз.
Dialogue: 0,1:26:40.41,1:26:42.25,Default,,0,0,0,,Бұл Годзилланы жеңудің жалғыз жолы
Dialogue: 0,1:26:42.83,1:26:46.37,Default,,0,0,0,,Егер сіз бұл мүмкіндікті жіберіп алсаңыз, бұл жолы жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,1:26:46.50,1:26:47.33,Default,,0,0,0,,Бірақ!
Dialogue: 0,1:26:47.41,1:26:50.91,Default,,0,0,0,,Маған бұл ұнамайды... Маған бұл ұнамайды! Мен оны естіген жоқпын!
Dialogue: 0,1:26:51.75,1:26:53.87,Default,,0,0,0,,Жоооу!
Dialogue: 0,1:26:53.95,1:26:55.66,Default,,0,0,0,,Шығуға мәжбүрлемеңіз
Dialogue: 0,1:26:55.79,1:26:56.62,Default,,0,0,0,,Өртеніп өлесің
Dialogue: 0,1:26:57.00,1:26:57.83,Default,,0,0,0,,Уф
Dialogue: 0,1:27:00.62,1:27:02.29,Default,,0,0,0,,Юуко~!
Dialogue: 0,1:27:03.58,1:27:05.00,Default,,0,0,0,,Гррр
Dialogue: 0,1:27:05.12,1:27:06.37,Default,,0,0,0,,Уф...
Dialogue: 0,1:27:13.29,1:27:16.20,Default,,0,0,0,,Балалар сендер бізді алдадыңдар ма?
Dialogue: 0,1:27:16.70,1:27:19.04,Default,,0,0,0,,Харуо, жолдасым
Dialogue: 0,1:27:19.58,1:27:21.58,Default,,0,0,0,,Сіз түсінесіз.
Dialogue: 0,1:27:21.87,1:27:24.33,Default,,0,0,0,,Годзилланы бірге жек көрдің.
Dialogue: 0,1:27:25.70,1:27:28.50,Default,,0,0,0,,Бір рет сіңісіп, біз нағыз доспыз.
Dialogue: 0,1:27:29.33,1:27:32.70,Default,,0,0,0,,Жүр, мен сені жоғарыда күтемін.
Dialogue: 0,1:27:33.91,1:27:35.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:27:35.25,1:27:36.54,Default,,0,0,0,,Тоқта... аа...
Dialogue: 0,1:27:38.87,1:27:40.08,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,1:27:40.70,1:27:41.70,Default,,0,0,0,,Юуко
Dialogue: 0,1:27:42.58,1:27:43.41,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,1:27:43.50,1:27:45.25,Default,,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,1:27:48.20,1:27:49.04,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:27:49.25,1:27:51.95,Default,,0,0,0,,Неліктен сіздің денеңіз нанометалдарды қабылдамайды?
Dialogue: 0,1:27:52.45,1:27:54.37,Default,,0,0,0,,Деректерде мұндай антидене реакциясы жоқ.
Dialogue: 0,1:27:54.83,1:27:58.45,Default,,0,0,0,,Ей, ақымақ... Денеңді не қылдың!
Dialogue: 0,1:27:58.79,1:28:01.00,Default,,0,0,0,,Харуо Жауап, Харуо!
Dialogue: 0,1:28:01.08,1:28:02.16,Default,,0,0,0,,Метфис!
Dialogue: 0,1:28:02.29,1:28:03.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:28:03.20,1:28:05.66,Default,,0,0,0,,Осы уақытқа дейін радиокедергілер салдарынан байланыс мүмкін болмады.
Dialogue: 0,1:28:05.75,1:28:08.83,Default,,0,0,0,,Метфис Сіз нені айтасыз? Метфис!
Dialogue: 0,1:28:08.91,1:28:11.33,Default,,0,0,0,,Мен сіздің айтқаныңызды естідім. Сенімен бәрі жақсы ма?
Dialogue: 0,1:28:11.58,1:28:13.70,Default,,0,0,0,,Мен әлі... бірақ Юко!
Dialogue: 0,1:28:13.79,1:28:14.62,Default,,0,0,0,,тіпті ол өзі де білмейтін Титантарға қатысты бір құпия жатыр дейді.
Dialogue: 0,1:28:15.08,1:28:16.95,Default,,0,0,0,,Эй, сен нені меңзеп тұрсың, Метфис?
Dialogue: 0,1:28:17.41,1:28:20.04,Default,,0,0,0,,Нанометалдардың мінез-құлқы да қашып кетудің алдын алу болып табылады.
Dialogue: 0,1:28:20.12,1:28:21.91,Default,,0,0,0,,Гарг және оның достары орналасқан басқару блогында.
Dialogue: 0,1:28:22.00,1:28:23.37,Default,,0,0,0,,Ұжымдық бақылау керек
Dialogue: 0,1:28:23.45,1:28:25.20,Default,,0,0,0,,Метфи сізді!
Dialogue: 0,1:28:25.29,1:28:27.20,Default,,0,0,0,,Егер сіз сол бөлікті жойсаңыз, бәрі тоқтайды.
Dialogue: 0,1:28:27.29,1:28:29.70,Default,,0,0,0,,Сержант Танидің денесінің ішіндегі эрозия шығар.
Dialogue: 0,1:28:30.16,1:28:32.08,Default,,0,0,0,,Өз рухыңа сенімді бол, Харуо
Dialogue: 0,1:28:32.37,1:28:34.33,Default,,0,0,0,,Дәл қазір Годзилланы жеңу - басты міндет.
Dialogue: 0,1:28:34.87,1:28:35.70,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:28:36.16,1:28:38.37,Default,,0,0,0,,Осы қарқынмен Мехагодзилла қаласы болады
Dialogue: 0,1:28:38.45,1:28:41.00,Default,,0,0,0,,Ол Годзилланы ғана емес, бәрін де жұтады.
Dialogue: 0,1:28:41.25,1:28:42.29,Default,,0,0,0,,Оның таралуы
Dialogue: 0,1:28:42.62,1:28:45.16,Default,,0,0,0,,Біз бүкіл Жерді жалмамайынша тоқтамаймыз!
Dialogue: 0,1:28:45.45,1:28:47.58,Default,,0,0,0,,Біз Годзилланы жеңуге дайынбыз!
Dialogue: 0,1:28:47.70,1:28:48.95,Default,,0,0,0,,Бұл сіз қалаған нәрсе.
Dialogue: 0,1:28:49.04,1:28:51.16,Default,,0,0,0,,Бильсардоның жеңісі болса да.
Dialogue: 0,1:28:51.25,1:28:52.50,Default,,0,0,0,,Бұл Хару үшін жеңіс бола алмайды.
Dialogue: 0,1:28:52.62,1:28:54.37,Default,,0,0,0,,Осы уақыт ішінде маған опасыздық жасайсың ба? Exif!
Dialogue: 0,1:28:54.45,1:28:55.29,Default,,0,0,0,,Жай ғана машина
Dialogue: 0,1:28:55.58,1:28:58.04,Default,,0,0,0,,Годзилланы өлтіру функциясын орындағаннан кейін ғана
Dialogue: 0,1:28:58.12,1:28:59.12,Default,,0,0,0,,Даңқ деген не?
Dialogue: 0,1:28:59.62,1:29:00.62,Default,,0,0,0,,Жеңіс дегеніміз не? Ол нені білдіреді?
Dialogue: 0,1:29:00.70,1:29:02.66,Default,,0,0,0,,Қорқыныш пен қайғыны жеңгеннен кейін нені түсінеміз
Dialogue: 0,1:29:02.75,1:29:03.58,Default,,0,0,0,,Харуо!
Dialogue: 0,1:29:03.66,1:29:05.25,Default,,0,0,0,,Адамның қадір-қасиеті осында жатыр
Dialogue: 0,1:29:05.33,1:29:06.62,Default,,0,0,0,,Тыңдап тұрсың ба? Харуо!
Dialogue: 0,1:29:07.95,1:29:09.66,Default,,0,0,0,,Дененің бетінде пайда болатын электромагниттік толқындар!
Dialogue: 0,1:29:10.08,1:29:11.66,Default,,0,0,0,,Годзилла жақында жұмысын жалғастырады
Dialogue: 0,1:29:13.29,1:29:14.91,Default,,0,0,0,,Қалқан қайтып келеді!
Dialogue: 0,1:29:15.00,1:29:16.29,Default,,0,0,0,,Харуо! Харуо!
Dialogue: 0,1:29:16.37,1:29:17.20,Default,,0,0,0,,Фанатиктерге алданба!
Dialogue: 0,1:29:17.33,1:29:18.16,Default,,0,0,0,,Көзді жоғалтпау
Dialogue: 0,1:29:18.25,1:29:19.08,Default,,0,0,0,,Өз миссияңызды есте сақтаңыз!
Dialogue: 0,1:29:19.16,1:29:21.50,Default,,0,0,0,,Бүгінге дейін сені не итермеледі!
Dialogue: 0,1:29:22.37,1:29:24.33,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,1:29:26.83,1:29:27.66,Default,,0,0,0,,Уф
Dialogue: 0,1:29:28.95,1:29:30.41,Default,,0,0,0,,Не істеуді жоспарлап отырсың, Харуо?
Dialogue: 0,1:29:30.66,1:29:31.50,Default,,0,0,0,,Жауап!
Dialogue: 0,1:29:40.95,1:29:43.50,Default,,0,0,0,,Гарг Нанометалдың эрозиясын тоқтатыңыз!
Dialogue: 0,1:29:44.12,1:29:45.25,Default,,0,0,0,,Қазір!
Dialogue: 0,1:29:46.04,1:29:48.83,Default,,0,0,0,,«Годзилланың алдында бір ғана нәрсе істеу керек»
Dialogue: 0,1:29:48.91,1:29:50.66,Default,,0,0,0,,Мұны сіз айтқансыз.
Dialogue: 0,1:29:50.83,1:29:52.50,Default,,0,0,0,,Біз не істеуіміз керек
Dialogue: 0,1:29:52.58,1:29:54.87,Default,,0,0,0,,Годзилланы «адам ретінде» жеңу
Dialogue: 0,1:29:55.20,1:29:58.16,Default,,0,0,0,,Харуо, сөздеріңдегі қайшылықты неге байқамайсың?
Dialogue: 0,1:29:58.25,1:29:59.08,Default,,0,0,0,,Не?
Dialogue: 0,1:29:59.66,1:30:02.41,Default,,0,0,0,,Бұл не құбыжық? Годзилла дегеніміз не?
Dialogue: 0,1:30:02.66,1:30:05.79,Default,,0,0,0,,Бұл құбыжық, өйткені оны адам қолымен ешқашан жеңе алмайды.
Dialogue: 0,1:30:06.33,1:30:08.79,Default,,0,0,0,,Адам түсінбейтін адамды жеңу
Dialogue: 0,1:30:08.87,1:30:11.54,Default,,0,0,0,,Бұл адам мінез-құлқының шеңберінен шығып кетті!
Dialogue: 0,1:30:12.66,1:30:15.33,Default,,0,0,0,,Мен «Годзилланы жеңемін» деп шешкен сәттен бастап
Dialogue: 0,1:30:15.41,1:30:18.79,Default,,0,0,0,,Сіз адам емес, басқа нәрсе болуға ұмтылдыңыз, Харуо.
Dialogue: 0,1:30:20.58,1:30:21.41,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:30:23.50,1:30:24.33,Default,,0,0,0,,Мен ЖоЖомен шайқасуға оралдым!
Dialogue: 0,1:30:24.66,1:30:26.83,Default,,0,0,0,,Жеңіске жетемін десеңіз, дайын болыңыз.
Dialogue: 0,1:30:26.91,1:30:30.12,Default,,0,0,0,,Адамдардан асып, Годзилладан асып кетудің соңына жеткенде!
Dialogue: 0,1:30:30.87,1:30:31.70,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:31.83,1:30:32.66,Default,,0,0,0,,Харуо!
Dialogue: 0,1:30:35.75,1:30:37.45,Default,,0,0,0,,Тоқта! Харуо!
Dialogue: 0,1:30:38.54,1:30:39.37,Default,,0,0,0,,Құт
Dialogue: 0,1:30:39.50,1:30:41.08,Default,,0,0,0,,(Харуоның тыныс алуы)
Dialogue: 0,1:30:41.16,1:30:42.16,Default,,0,0,0,,Харуо!
Dialogue: 0,1:30:43.95,1:30:45.75,Default,,0,0,0,,Бұл сынақ уақыты, Харуо.
Dialogue: 0,1:30:46.79,1:30:52.83,Default,,0,0,0,,♪~
Dialogue: 0,1:31:05.50,1:31:11.50,Default,,0,0,0,,~♪
Dialogue: 0,1:31:11.83,1:31:14.00,Default,,0,0,0,,Харуо!
Dialogue: 0,1:31:15.79,1:31:16.62,Default,,0,0,0,,Уф...
Dialogue: 0,1:31:21.75,1:31:25.04,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:31:25.66,1:31:27.33,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:31:30.62,1:31:31.91,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:31:45.33,1:31:49.12,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:31:56.37,1:31:58.54,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:32:24.54,1:32:26.08,Default,,0,0,0,,Мехагодзилла қаласы...
Dialogue: 0,1:32:27.58,1:32:28.79,Default,,0,0,0,,раковина
Dialogue: 0,1:32:33.33,1:32:38.16,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:32:57.29,1:32:58.45,Default,,0,0,0,,Юуко!
Dialogue: 0,1:33:01.66,1:33:05.16,Default,,0,0,0,,Юко Юко! Мықты бол, Юуко.
Dialogue: 0,1:33:06.58,1:33:07.50,Default,,0,0,0,,Юуко...
Dialogue: 0,1:33:09.91,1:33:10.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:22.50,1:33:25.91,Default,,0,0,0,,(жылайды)
Dialogue: 0,1:33:28.58,1:33:34.50,Default,,0,0,0,,Шыу!
Dialogue: 0,1:33:40.25,1:33:45.20,Default,,0,0,0,,(Харуоның жылағаны)
Dialogue: 0,1:33:47.16,1:33:53.16,Default,,0,0,0,,♪~
Dialogue: 0,1:37:36.83,1:37:42.83,Default,,0,0,0,,~♪
Dialogue: 0,1:37:45.58,1:37:47.33,Default,,0,0,0,,Юко Юко!
Dialogue: 0,1:37:57.45,1:37:59.58,Default,,0,0,0,,(жылайды)
Dialogue: 0,1:38:00.29,1:38:01.79,Default,,0,0,0,,Шыу!
Dialogue: 0,1:38:04.50,1:38:08.12,Default,,0,0,0,,(Харуоның айқайын өңдеген дауыс)
Dialogue: 0,1:38:08.33,1:38:09.37,Default,,0,0,0,,Харуо
Dialogue: 0,1:38:16.29,1:38:18.20,Default,,0,0,0,,Барлық зерделерді біріктіру
Dialogue: 0,1:38:18.29,1:38:19.50,Default,,0,0,0,,Біз үшін қазір маңыздысы...
Dialogue: 0,1:38:19.58,1:38:20.41,Default,,0,0,0,,100 000 жыл бұрын
Dialogue: 0,1:38:20.50,1:38:22.08,Default,,0,0,0,,Құбыжықтар жойды
Dialogue: 0,1:38:22.16,1:38:23.29,Default,,0,0,0,,Менің анам да жұлдызды...
Dialogue: 0,1:38:23.37,1:38:24.58,Default,,0,0,0,,Зұлымдықты жою
Dialogue: 0,1:38:24.66,1:38:25.75,Default,,0,0,0,,Негізгі мақсатыңызды ұмытпаңыз
Dialogue: 0,1:38:25.83,1:38:28.58,Default,,0,0,0,,Бірақ Алланың қақпасына адасқандар
Dialogue: 0,1:38:28.66,1:38:30.70,Default,,0,0,0,,Ол арқылы өту мүмкін емес
Dialogue: 0,1:38:38.12,1:38:41.66,Default,,0,0,0,,Құбыжықтан еш айырмашылығы жоқ зұлым нәрсе.
Dialogue: 0,1:38:41.75,1:38:44.79,Default,,0,0,0,,Олар әмбебап интеллектпен бірігуге тырыспайды.
Dialogue: 0,1:38:44.87,1:38:48.08,Default,,0,0,0,,Ол құбыжық сияқты табиғаты бір нәрсеге айналуға тырысатын сияқты.
Dialogue: 0,1:38:48.16,1:38:49.54,Default,,0,0,0,,Көптеген жұлдызды өркениеттер
Dialogue: 0,1:38:49.62,1:38:51.79,Default,,0,0,0,,Прогресстің соңында құбыжықтар жасалды.
Dialogue: 0,1:38:51.87,1:38:54.79,Default,,0,0,0,,Ақылды адамдар абдырап, ашулы, мұңаяды.
Dialogue: 0,1:38:54.91,1:38:58.37,Default,,0,0,0,,Біздің күресіміз соңына дейін болуы керек.
Dialogue: 0,1:39:02.04,1:39:03.08,Default,,0,0,0,,Метфис
Dialogue: 0,1:39:03.79,1:39:06.75,Default,,0,0,0,,Сіздің планетаңызды да құбыжықтар қиратты ма?
Dialogue: 0,1:39:07.20,1:39:08.08,Default,,0,0,0,,Иә.
Dialogue: 0,1:39:09.25,1:39:12.70,Default,,0,0,0,,Өркениетіміздің жойылуына әкелген нәрселер туралы.
Dialogue: 0,1:39:12.87,1:39:15.29,Default,,0,0,0,,Бос сөзге де тыйым салынады.
Dialogue: 0,1:39:16.25,1:39:20.00,Default,,0,0,0,,Сөздің ғана күші бар.
Dialogue: 0,1:39:20.08,1:39:21.79,Default,,0,0,0,,Бұл сәтсіздікті білдіре ме?
Dialogue: 0,1:39:22.70,1:39:23.83,Default,,0,0,0,,Бірақ Харуо
Dialogue: 0,1:39:24.62,1:39:28.00,Default,,0,0,0,,Тек Годзиллаға қарсы тұруға тырысатын сізге ғана
Dialogue: 0,1:39:28.29,1:39:30.70,Default,,0,0,0,,Мүмкін мен олардың орнына айтуым керек.
Dialogue: 0,1:39:31.20,1:39:34.58,Default,,0,0,0,,Біз, Exif, жасырған жойылу аты.
Dialogue: 0,1:39:35.29,1:39:36.25,Default,,0,0,0,,Неге мен?
Dialogue: 0,1:39:36.33,1:39:39.83,Default,,0,0,0,,Шайқаста қорқыныш сізді жұтып қояйын деп жатқанда, мұны есте сақтаңыз
Dialogue: 0,1:39:39.95,1:39:43.95,Default,,0,0,0,,Бұл ғаламда жойылудың абсолютті күші бар.
Dialogue: 0,1:39:44.45,1:39:49.00,Default,,0,0,0,,Онымен салыстырғанда, Годзилла өте қорқынышты емес...
Dialogue: 0,1:39:50.16,1:39:51.50,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,1:39:56.12,1:39:57.20,Default,,0,0,0,,«Гидора»
Dialogue: 0,1:39:58.70,1:40:04.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory