Dialogue: 0,0:02:26.12,0:02:36.06,LOGO,,0000,0000,0000,,Бұл субтитр көзін God Subtitles Group (kamigami.org) жасаған, пайдаланушы ұсынған және коммерциялық пайдалануға тыйым салынған.
Dialogue: 0,0:02:26.12,0:02:36.06,,,0000,0000,0000,,: &  :Thomasday :apollius & Syura : : :
Dialogue: 0,0:00:05.54,0:00:07.70,JP2,,0000,0000,0000,,Бүгін де ауа райы жақсы.
Dialogue: 0,0:00:09.19,0:00:11.90,JP2,,0000,0000,0000,,Сәлеметсіз бе, бұл Фудзивара Скайтриден келген Тейка.
Dialogue: 0,0:00:12.58,0:00:15.20,JP2,,0000,0000,0000,,Сіз Чокусен Вакашу туралы білесіз бе?
Dialogue: 0,0:00:16.00,0:00:19.59,JP2,,0000,0000,0000,,Бұл императордың немесе отставкадағы императордың бұйрығымен жасалған вака өлеңдер жинағына қатысты.
Dialogue: 0,0:00:20.76,0:00:25.63,JP2,,0000,0000,0000,,Мен сонымен қатар жаңа Кокин Вакашу мен Жаңа Императорлық Таңдаулы Вакашу құруға қатысып жатырмын.
Dialogue: 0,0:00:26.25,0:00:31.15,JP2,,0000,0000,0000,,Ал бұл империялық антологиялардың бастаушысы Кокин Вакашу болды.
Dialogue: 0,0:00:32.10,0:00:35.27,JP2,,0000,0000,0000,,Сол адам таңдауды жасаған.
Dialogue: 0,0:00:35.85,0:00:38.70,JP2,,0000,0000,0000,,Бұл Ки Токио мұнарасы Цураюки Сенпай.
Dialogue: 0,0:00:40.36,0:00:42.45,JP2,,0000,0000,0000,,Цураюки Сенпай тек әнші емес.
Dialogue: 0,0:00:42.80,0:00:46.05,JP2,,0000,0000,0000,,Мен әйел болып көрініп, Тоса күнделігі деп күнделік жаздым.
Dialogue: 0,0:00:46.92,0:00:48.55,JP2,,0000,0000,0000,,Мұны біз қазір Некама деп атаймыз.
Dialogue: 0,0:00:49.06,0:00:49.88,JP2,,0000,0000,0000,,Геперо
Dialogue: 0,0:00:50.47,0:00:54.02,JP2,,0000,0000,0000,,Бүгін мен өзімнің үлкен күндерім туралы айтқым келеді.
Dialogue: 0,0:00:54.53,0:00:55.45,JP2,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:02:44.39,0:02:45.75,JP2,,0000,0000,0000,,Уджияма?
Dialogue: 0,0:02:46.77,0:02:49.34,JP2,,0000,0000,0000,,Шаршаған жүрек елордада жазылады
Dialogue: 0,0:02:50.41,0:02:51.53,JP2,,0000,0000,0000,,Бірақ алыс
Dialogue: 0,0:02:52.23,0:02:55.32,JP2,,0000,0000,0000,,Неліктен мұндай қолайсыз жерде тұрасың?
Dialogue: 0,0:02:55.44,0:02:56.40,JP2,,0000,0000,0000,,Ято-сама!
Dialogue: 0,0:02:57.96,0:03:00.40,JP2,,0000,0000,0000,,Біраз уақыт болды, Цураюки-кун.
Dialogue: 0,0:03:00.80,0:03:03.37,JP2,,0000,0000,0000,,Ах, Кисен-доно, біраз уақыт болды.
Dialogue: 0,0:03:03.81,0:03:05.74,JP2,,0000,0000,0000,,Таудың тереңінде не болды?
Dialogue: 0,0:03:06.17,0:03:09.24,JP2,,0000,0000,0000,,Негізі мен Кисен-донодан кеңес сұрағым келеді.
Dialogue: 0,0:03:10.74,0:03:12.84,JP2,,0000,0000,0000,,Осындай қарттың пайдасы бар ма деп ойлаймын.
Dialogue: 0,0:03:13.17,0:03:14.24,JP2,,0000,0000,0000,,Әрине.
Dialogue: 0,0:03:14.58,0:03:16.98,JP2,,0000,0000,0000,,Ал, ақырын жүр.
Dialogue: 0,0:03:17.29,0:03:18.28,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:03:18.99,0:03:21.32,JP2,,0000,0000,0000,,Бірақ бұл жақсы жер.
Dialogue: 0,0:03:21.63,0:03:23.05,JP2,,0000,0000,0000,,Бұл алыс және қолайсыз.
Dialogue: 0,0:03:23.46,0:03:27.27,JP2,,0000,0000,0000,,Үйреніп алсаң, қиындық болмайды. Қолайсыздық та қызық.
Dialogue: 0,0:03:27.51,0:03:29.04,JP2,,0000,0000,0000,,Кисенден
Dialogue: 0,0:03:30.04,0:03:31.85,JP2,,0000,0000,0000,,Сіз жылдам жүресіз.
Dialogue: 0,0:03:32.22,0:03:34.34,JP2,,0000,0000,0000,,Неге менімен келе алмайсың?
Dialogue: 0,0:03:35.05,0:03:37.28,JP2,,0000,0000,0000,,Елорда тұрғындары әлсіз.
Dialogue: 0,0:03:39.93,0:03:44.01,JP2,,0000,0000,0000,,Шындығында, мен жақында вака өлеңдер жинағын құрастыру туралы императордың бұйрығын қабылдадым.
Dialogue: 0,0:03:44.51,0:03:50.30,JP2,,0000,0000,0000,,Алғы сөзде мен сіздерді қоса алғанда алты адамды қазіргі заманның көрнекті ақындары ретінде таныстырғым келеді.
Dialogue: 0,0:03:51.87,0:03:53.00,JP2,,0000,0000,0000,,Соджо Хеншо
Dialogue: 0,0:03:53.46,0:03:54.42,JP2,,0000,0000,0000,,Оно Комачи
Dialogue: 0,0:03:55.16,0:03:56.58,JP2,,0000,0000,0000,,Нарихира Аривара
Dialogue: 0,0:03:56.89,0:03:58.11,JP2,,0000,0000,0000,,Отомо Куронуши
Dialogue: 0,0:03:58.73,0:03:59.91,JP2,,0000,0000,0000,,Ясухиде Буня
Dialogue: 0,0:04:00.57,0:04:03.20,JP2,,0000,0000,0000,,Ал сен, Кисенбоши-доно.
Dialogue: 0,0:04:04.40,0:04:06.63,JP2,,0000,0000,0000,,Бірақ неге бұл алты адам?
Dialogue: 0,0:04:07.49,0:04:11.79,JP2,,0000,0000,0000,,Нарихираның үлкен ағасы Юкихира мен Оно Такамура неге кірмеді?
Dialogue: 0,0:04:12.57,0:04:16.00,JP2,,0000,0000,0000,,Егер сіз сол аймақта үлкен адам болсаңыз, абай болғаныңыз жөн.
Dialogue: 0,0:04:16.72,0:04:18.97,JP2,,0000,0000,0000,,Мен өте жоғары дәрежелі емеспін.
Dialogue: 0,0:04:19.61,0:04:22.40,JP2,,0000,0000,0000,,Сонымен мен және Ясухиде төмен дәрежелі
Dialogue: 0,0:04:22.72,0:04:28.48,JP2,,0000,0000,0000,,Жоқ. Негізі мен одан Коретака ханзадамен туысқан бірнеше адамды таңдауды өтіндім.
Dialogue: 0,0:04:28.77,0:04:29.86,JP2,,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,0:04:30.38,0:04:35.27,JP2,,0000,0000,0000,,Қысқасы, мен саяси шайқаста жеңілген Коретака ханзаданың қарғысынан қорқамын.
Dialogue: 0,0:04:35.66,0:04:37.42,JP2,,0000,0000,0000,,Туыстарыңды мақтау арқылы
Dialogue: 0,0:04:37.46,0:04:37.83,JP2,,0000,0000,0000,,Идиот
Dialogue: 0,0:04:39.16,0:04:41.35,JP2,,0000,0000,0000,,Егер мені сол себепті таңдаса, мен бақытты болмас едім.
Dialogue: 0,0:04:42.03,0:04:42.66,JP2,,0000,0000,0000,,Қайтадан таңдаңыз
Dialogue: 0,0:04:43.07,0:04:48.38,JP2,,0000,0000,0000,,Жоқ, мен сені тек ақын ретінде құрметтеп таңдадым.
Dialogue: 0,0:04:49.02,0:04:51.58,JP2,,0000,0000,0000,,Өкінішке орай, сізден басқасының бәрі қайтыс болды.
Dialogue: 0,0:04:51.92,0:04:53.96,JP2,,0000,0000,0000,,Сондықтан мен сені іздеп келдім.
Dialogue: 0,0:04:54.89,0:04:57.76,JP2,,0000,0000,0000,,Кісенден, сол күндердің оқиғасын айтып берші.
Dialogue: 0,0:04:58.28,0:04:59.80,JP2,,0000,0000,0000,,Алғы сөзді дайындау үшін
Dialogue: 0,0:05:02.12,0:05:03.32,JP2,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:05:04.75,0:05:09.77,JP2,,0000,0000,0000,,Сол кезде діни қызметкер Хеншо өзін Риосуке Сосада-сама деп атаған болатын.
Dialogue: 0,0:05:14.39,0:05:15.30,JP2,,0000,0000,0000,,Хякуя жолаушы
Dialogue: 0,0:05:15.82,0:05:17.41,JP2,,0000,0000,0000,,Сіз білмейсіз бе? Лорд Мунесада
Dialogue: 0,0:05:17.82,0:05:22.35,JP2,,0000,0000,0000,,Хякуя Йосими Ононың қызына баруы мүмкін бе?
Dialogue: 0,0:05:22.82,0:05:24.59,JP2,,0000,0000,0000,,Міне, бәріміз бәс тігеміз.
Dialogue: 0,0:05:25.09,0:05:27.52,JP2,,0000,0000,0000,,Эй, тағы да Хякуя ше?
Dialogue: 0,0:05:28.55,0:05:31.08,JP2,,0000,0000,0000,,Оның табысына бәс тігетін адам жоқ па?
Dialogue: 0,0:05:31.48,0:05:33.28,JP2,,0000,0000,0000,,Ирутомоның өзі
Dialogue: 0,0:05:33.98,0:05:35.71,JP2,,0000,0000,0000,,Сен мұны істей аламын деп ойлау
Dialogue: 0,0:05:36.32,0:05:37.40,JP2,,0000,0000,0000,,Сен неше түнге бардың?
Dialogue: 0,0:05:37.59,0:05:38.71,JP2,,0000,0000,0000,,Он күннен кейін тоқтатылды
Dialogue: 0,0:05:38.96,0:05:39.95,JP2,,0000,0000,0000,,Мен бес күндік
Dialogue: 0,0:05:40.55,0:05:41.67,JP2,,0000,0000,0000,,Мен үш күнде зейнетке шықтым
Dialogue: 0,0:05:42.29,0:05:43.53,JP2,,0000,0000,0000,,Балалар сендер орындадыңдар ма?
Dialogue: 0,0:05:43.69,0:05:45.99,JP2,,0000,0000,0000,,Жұмыстан шаршап келе жатырмын.
Dialogue: 0,0:05:46.04,0:05:48.13,JP2,,0000,0000,0000,,Әй, араласпасам, жүрегім жарылады.
Dialogue: 0,0:05:48.18,0:05:51.92,JP2,,0000,0000,0000,,Жалпы айтқанда, егер мені қаласаңыз, Хякуяға баруыңыз керек.
Dialogue: 0,0:05:51.96,0:05:52.95,JP2,,0000,0000,0000,,Немесе бұл сәл қатігездік пе?
Dialogue: 0,0:05:53.45,0:05:57.53,JP2,,0000,0000,0000,,Сіз сатуға құлықсыз деп ойласаңыз да, бұл шын мәнінде адамдарға көрсете алмайтын бет.
Dialogue: 0,0:05:57.53,0:05:58.47,JP2,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:05:59.55,0:06:02.76,JP2,,0000,0000,0000,,Ол теңдесі жоқ сұлу, ол күш салуға тұрарлық.
Dialogue: 0,0:06:06.58,0:06:10.55,JP2,,0000,0000,0000,,Көктемнен кейін, жазда, Ширатенің
Dialogue: 0,0:06:11.49,0:06:14.28,JP2,,0000,0000,0000,,Корохостеф Аспандағы Кагу тауы
Dialogue: 0,0:06:15.61,0:06:18.15,JP2,,0000,0000,0000,,Бұл император Джитоның Йошико әні.
Dialogue: 0,0:06:18.42,0:06:21.03,JP2,,0000,0000,0000,,Иә, аға.
Dialogue: 0,0:06:22.98,0:06:25.48,JP2,,0000,0000,0000,,Көп айтсаң, біз де байқап көрейік.
Dialogue: 0,0:06:26.20,0:06:29.21,JP2,,0000,0000,0000,,Міне осылайша жұртты ренжітіп, адамның қателігіне күлесің.
Dialogue: 0,0:06:29.36,0:06:31.92,JP2,,0000,0000,0000,,Жоқ, мен Хякуяға баратынымды жаңа білдім.
Dialogue: 0,0:06:32.02,0:06:33.86,JP2,,0000,0000,0000,,Жауапкершілікті өз мойнына алыңыз және шақырыңыз
Dialogue: 0,0:06:33.87,0:06:34.89,JP2,,0000,0000,0000,,Жауапкершілік
Dialogue: 0,0:06:35.64,0:06:38.52,JP2,,0000,0000,0000,,100 түнді бастан өткеру мүмкін емес екенін түсінетін шығарсыз.
Dialogue: 0,0:06:38.72,0:06:40.31,JP2,,0000,0000,0000,,Мен осылай дедім
Dialogue: 0,0:06:40.40,0:06:43.64,JP2,,0000,0000,0000,,Бітім-ау, біреуге сынап көрейін деп ақша таба алмаймын.
Dialogue: 0,0:06:43.84,0:06:44.84,JP2,,0000,0000,0000,,Менің ішім кетпейді
Dialogue: 0,0:06:45.06,0:06:47.53,JP2,,0000,0000,0000,,Бірақ бұл ставка аяқталуға жақын.
Dialogue: 0,0:06:47.79,0:06:50.37,JP2,,0000,0000,0000,,Неліктен оны әлі ешкім қолданып көрмеді?
Dialogue: 0,0:06:50.72,0:06:55.27,JP2,,0000,0000,0000,,Жоқ, Йошими-доно өз қызын ішкі сарайға қоюды көздеген сияқты.
Dialogue: 0,0:06:56.34,0:06:58.92,JP2,,0000,0000,0000,,Ішкі сарайға кіруді ойлау
Dialogue: 0,0:06:59.25,0:07:04.88,JP2,,0000,0000,0000,,Егер император Нийнамацури фестивалінде орындалған Госсетсу биіне риза болса, онда оны орындаңыз.
Dialogue: 0,0:07:05.40,0:07:08.81,JP2,,0000,0000,0000,,Йошико императордың әйелі болады
Dialogue: 0,0:07:22.27,0:07:22.95,JP2,,0000,0000,0000,,Йошико-сама
Dialogue: 0,0:07:24.64,0:07:27.26,JP2,,0000,0000,0000,,Түннің бір уағында болу ерекше, ағайын.
Dialogue: 0,0:07:27.88,0:07:29.77,JP2,,0000,0000,0000,,Соңғы кездері күндізгі үзіліс болған жоқ.
Dialogue: 0,0:07:30.72,0:07:32.35,JP2,,0000,0000,0000,,Сен жақсысың деп үміттенемін, Йошико.
Dialogue: 0,0:07:33.06,0:07:34.60,JP2,,0000,0000,0000,,Біз де солай өмір сүріп жатырмыз.
Dialogue: 0,0:07:35.49,0:07:38.94,JP2,,0000,0000,0000,,Сіз бейтаныс адам сияқты әрекет етесіз, жалюзи көтермеңіз.
Dialogue: 0,0:07:39.64,0:07:41.33,JP2,,0000,0000,0000,,Қазір екеуміз де ересекпіз.
Dialogue: 0,0:07:42.52,0:07:44.00,JP2,,0000,0000,0000,,Қанша үлкен аға болсаң да,
Dialogue: 0,0:07:44.37,0:07:47.73,JP2,,0000,0000,0000,,Мырзаға немқұрайлылық таныту ұят болар.
Dialogue: 0,0:07:49.52,0:07:50.20,JP2,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:07:51.04,0:07:52.38,JP2,,0000,0000,0000,,Ересек болу туралы айту
Dialogue: 0,0:07:52.71,0:07:56.00,JP2,,0000,0000,0000,,Сізге бірнеше ер адамдар қызыққан сияқты.
Dialogue: 0,0:07:56.97,0:07:59.83,JP2,,0000,0000,0000,,Көшеде Хякуя туралы өсек тарады.
Dialogue: 0,0:08:00.46,0:08:02.39,JP2,,0000,0000,0000,,Әй, сен осылай айтып тұрсың.
Dialogue: 0,0:08:02.62,0:08:04.27,JP2,,0000,0000,0000,,Себебі сен маған көп ермейсің.
Dialogue: 0,0:08:04.75,0:08:07.12,JP2,,0000,0000,0000,,Ер адамдар: «Жүр, тәкаппар әйел!» — деді.
Dialogue: 0,0:08:07.24,0:08:08.50,JP2,,0000,0000,0000,,Маған өшпенділік бар сияқты.
Dialogue: 0,0:08:09.20,0:08:13.21,JP2,,0000,0000,0000,,Ей, эй, шақыру қабылданбаған кезде қалайша біреуді қорлайсың?
Dialogue: 0,0:08:13.64,0:08:14.83,JP2,,0000,0000,0000,,Бас тартуға болмайды
Dialogue: 0,0:08:15.27,0:08:18.62,JP2,,0000,0000,0000,,Жүз түнге созылады деу артық емес пе?
Dialogue: 0,0:08:19.27,0:08:23.08,JP2,,0000,0000,0000,,Маған мұндай мүмкін емес тапсырма жүктейтін болсаңыз, оны басынан бастап ұнатпайтыныңызды айтуыңыз керек.
Dialogue: 0,0:08:23.83,0:08:25.43,JP2,,0000,0000,0000,,Мені тәкаппар деп атаса, еріксіз.
Dialogue: 0,0:08:26.13,0:08:29.51,JP2,,0000,0000,0000,,Әй, ағаңның да ойы бар екен.
Dialogue: 0,0:08:30.14,0:08:30.96,JP2,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,0:08:31.83,0:08:35.24,JP2,,0000,0000,0000,,Әйел тұрмысқа шыққаннан кейін күту ғана қалады.
Dialogue: 0,0:08:36.09,0:08:38.68,JP2,,0000,0000,0000,,Менімен бірге келмейтін күйеуімді ренжітетін түндер болады.
Dialogue: 0,0:08:39.05,0:08:41.04,JP2,,0000,0000,0000,,Ол жүз түнге созылуы мүмкін
Dialogue: 0,0:08:41.97,0:08:46.52,JP2,,0000,0000,0000,,Басқа адамның шешімін анықтау үшін оның жүрегін анықтауға тырысу табиғи нәрсе.
Dialogue: 0,0:08:47.54,0:08:50.61,JP2,,0000,0000,0000,,Әйел бақыт іздесе тәкаппар ма?
Dialogue: 0,0:08:52.08,0:08:55.30,JP2,,0000,0000,0000,,Түсіндім, сондықтан бақытты болғың келе ме?
Dialogue: 0,0:08:55.94,0:08:57.03,JP2,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:08:57.84,0:09:01.38,JP2,,0000,0000,0000,,Жарайды, алдымен жүрегімді көрсетейін.
Dialogue: 0,0:09:02.69,0:09:07.47,JP2,,0000,0000,0000,,Негізі бұл жолы Хякуяға қатысамын деген қауесет бар.
Dialogue: 0,0:09:08.75,0:09:10.26,JP2,,0000,0000,0000,,Бүгін түн бірінші түн.
Dialogue: 0,0:09:10.60,0:09:13.48,JP2,,0000,0000,0000,,Маған бұл енді ұнамайды. Мен өзімді үлкен аға ретінде де сезінбеймін.
Dialogue: 0,0:09:13.83,0:09:15.60,JP2,,0000,0000,0000,,Досыңның арбауына түстің.
Dialogue: 0,0:09:16.55,0:09:19.29,JP2,,0000,0000,0000,,Саған деген сүйіспеншілігімді мойындамайтыныңа сене алар емеспін.
Dialogue: 0,0:09:19.75,0:09:20.22,JP2,,0000,0000,0000,,Махаббат...
Dialogue: 0,0:09:21.26,0:09:24.44,JP2,,0000,0000,0000,,Мен сені жек көрмей ойладым.
Dialogue: 0,0:09:24.98,0:09:29.54,JP2,,0000,0000,0000,,Біз аға-әпкедей өскендіктен, мен осы уақытқа дейін оның махаббат екенін түсінбедім.
Dialogue: 0,0:09:30.15,0:09:33.38,JP2,,0000,0000,0000,,Неліктен? Неліктен кенеттен мұны істедің?
Dialogue: 0,0:09:34.08,0:09:36.09,JP2,,0000,0000,0000,,Мен сізді компанияға қосылатыныңызды естідім.
Dialogue: 0,0:09:37.00,0:09:41.54,JP2,,0000,0000,0000,,Менің қолым жетпейтін жерлерге баруға келгенде түсінетін бір нәрсе болды.
Dialogue: 0,0:09:42.21,0:09:44.64,JP2,,0000,0000,0000,,Мен сені жақсы көремін Йошико
Dialogue: 0,0:09:45.71,0:09:47.11,JP2,,0000,0000,0000,,Мен оны ешкімге бергім келмейді
Dialogue: 0,0:09:47.71,0:09:49.96,JP2,,0000,0000,0000,,Император болса да
Dialogue: 0,0:09:54.13,0:09:55.78,JP2,,0000,0000,0000,,Өйткені, мектепке бару керек.
Dialogue: 0,0:09:55.82,0:09:56.49,JP2,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:09:56.64,0:09:58.77,JP2,,0000,0000,0000,,Иә, бұл азап.
Dialogue: 0,0:09:58.82,0:09:59.86,JP2,,0000,0000,0000,,Аға
Dialogue: 0,0:10:00.37,0:10:03.56,JP2,,0000,0000,0000,,Мен Йошиконы 100 түн бойы жалғыз қалдырмаймын.
Dialogue: 0,0:10:03.60,0:10:05.42,JP2,,0000,0000,0000,,Мен аузыммен кез келген нәрсені айта аламын.
Dialogue: 0,0:10:05.68,0:10:06.87,JP2,,0000,0000,0000,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:10:07.48,0:10:10.50,JP2,,0000,0000,0000,,Бұл сізге түсіну үшін 100 түндік сапар.
Dialogue: 0,0:10:11.20,0:10:13.10,JP2,,0000,0000,0000,,Бірақ есіңізде болсын
Dialogue: 0,0:10:14.51,0:10:16.19,JP2,,0000,0000,0000,,Мен жеңілгенді жек көремін
Dialogue: 0,0:10:16.91,0:10:18.91,JP2,,0000,0000,0000,,Хякуяға міндетті түрде барыңыз
Dialogue: 0,0:10:19.06,0:10:22.03,JP2,,0000,0000,0000,,Сондықтан сізде де осындай ниет бар деп үміттенемін.
Dialogue: 0,0:10:30.59,0:10:32.85,JP2,,0000,0000,0000,,Екінші түнде бірден жаңбыр жауа бастады.
Dialogue: 0,0:10:34.02,0:10:37.25,JP2,,0000,0000,0000,,Хякуяға барсаңыз, мұндай күндер көп болатын шығар.
Dialogue: 0,0:10:37.33,0:10:38.33,JP2,,0000,0000,0000,,Мұнда Он екі Құбыжық Айдың тек Төменгі Айлары ғана жиналған
Dialogue: 0,0:10:38.65,0:10:41.00,JP2,,0000,0000,0000,,Бар күшіңізді салу өз қолыңызда деп ойлаймын.
Dialogue: 0,0:10:41.60,0:10:43.88,JP2,,0000,0000,0000,,Бұл мүмкін емес болып көрінсе, маған хабарлаңыз, мен атпен барамын.
Dialogue: 0,0:10:44.22,0:10:47.08,JP2,,0000,0000,0000,,Иә, мен мұны қиын кезде істеймін.
Dialogue: 0,0:10:48.85,0:10:51.90,JP2,,0000,0000,0000,,Бауырым, су емес пе? Мынаны беріңізші.
Dialogue: 0,0:10:52.23,0:10:54.98,JP2,,0000,0000,0000,,Жоқ, мен жақсымын, бірақ менің серігім...
Dialogue: 0,0:10:55.18,0:10:57.10,JP2,,0000,0000,0000,,Жарайды, суық тиіп қалсаң, бәлеге қаласың.
Dialogue: 0,0:10:57.40,0:10:58.38,JP2,,0000,0000,0000,,Енді осында кел.
Dialogue: 0,0:10:59.74,0:11:01.83,JP2,,0000,0000,0000,,Сіз мен күткеннен де көп нәрсені жасай аласыз.
Dialogue: 0,0:11:02.38,0:11:05.23,JP2,,0000,0000,0000,,Жаңбырда келдің, әрине.
Dialogue: 0,0:11:06.28,0:11:07.55,JP2,,0000,0000,0000,,Тіпті бұрынғы серіктестермен
Dialogue: 0,0:11:08.63,0:11:12.49,JP2,,0000,0000,0000,,Жоқ.Негізі ол үндемей, үндемеді.
Dialogue: 0,0:11:13.05,0:11:14.62,JP2,,0000,0000,0000,,Егер солай болса, бұл жақсы.
Dialogue: 0,0:11:15.94,0:11:19.63,JP2,,0000,0000,0000,,Біреу мені жақсы көрсе, бұл менің оған қатысым бар дегенді ойлаудың өзі дұрыс па деп ойлаймын.
Dialogue: 0,0:11:19.90,0:11:21.55,JP2,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:11:21.91,0:11:22.70,JP2,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:11:23.13,0:11:28.88,JP2,,0000,0000,0000,,Менің ағам Хякуяға барамын дейді, егер солай болса, менің де айтатын нәрсем бар.
Dialogue: 0,0:11:29.97,0:11:30.68,JP2,,0000,0000,0000,,Консультация
Dialogue: 0,0:11:31.45,0:11:32.77,JP2,,0000,0000,0000,,Білесің бе, егер?
Dialogue: 0,0:11:33.52,0:11:38.28,JP2,,0000,0000,0000,,Егер мен үйленсем, сарайда қызмет етуге рұқсат беруіңізді сұраймын.
Dialogue: 0,0:11:39.50,0:11:42.29,JP2,,0000,0000,0000,,Менің арманым император сарайына бару.
Dialogue: 0,0:11:43.44,0:11:49.31,JP2,,0000,0000,0000,,Ән айтуда, сұлулықта жарысып, асылдармен саудаласып өзімді жетілдірсем деймін.
Dialogue: 0,0:11:51.25,0:11:53.74,JP2,,0000,0000,0000,,Менің ағамның мақтаныш жары болатыныңызға сенімдімін.
Dialogue: 0,0:11:54.52,0:11:56.07,JP2,,0000,0000,0000,,Мен мұны ұсынбаймын.
Dialogue: 0,0:11:57.82,0:12:01.05,JP2,,0000,0000,0000,,Ер адамдар сіздей жақсы адамды жалғыз қалдыруы мүмкін емес.
Dialogue: 0,0:12:01.70,0:12:04.48,JP2,,0000,0000,0000,,Мен императордың қасында түнесем, қиын болмай ма?
Dialogue: 0,0:12:05.18,0:12:08.14,JP2,,0000,0000,0000,,Ән айтуды ұнататын болсаңыз, өз ән кітабыңызды құрастыруға болады.
Dialogue: 0,0:12:08.57,0:12:09.89,JP2,,0000,0000,0000,,Мен сіздермен ынтымақтастықта бар күш-жігерімді аямаймын.
Dialogue: 0,0:12:10.76,0:12:14.92,JP2,,0000,0000,0000,,Менің үйге келгенімді сүйкімді күтетін әйелім болғаныңды қалаймын.
Dialogue: 0,0:12:15.78,0:12:19.98,JP2,,0000,0000,0000,,Бірақ мен үйде отырып, өз әлеміме енгім келмейді.
Dialogue: 0,0:12:20.53,0:12:23.01,JP2,,0000,0000,0000,,Мен әртүрлі адамдармен араласып, өз дағдыларымды шыңдағым келеді.
Dialogue: 0,0:12:24.36,0:12:26.79,JP2,,0000,0000,0000,,Сіз Император сарайы туралы көп армандайсыз, жас ханым.
Dialogue: 0,0:12:27.67,0:12:30.94,JP2,,0000,0000,0000,,Бұл жай ғана ән айтатын дүние емес.
Dialogue: 0,0:12:31.70,0:12:33.21,JP2,,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:12:33.36,0:12:34.64,JP2,,0000,0000,0000,,Жоқ, түсінбеймін.
Dialogue: 0,0:12:35.50,0:12:37.64,JP2,,0000,0000,0000,,Жаздың ұзаққа созылған ыстығы.
Dialogue: 0,0:12:37.95,0:12:40.29,JP2,,0000,0000,0000,,Император сарайы туралы қорқынышты оқиғалар сізді салқын сезінеді ме?
Dialogue: 0,0:12:40.67,0:12:42.82,JP2,,0000,0000,0000,,Салқын сезінгіңіз келсе, жаңбыр жауыңыз
Dialogue: 0,0:12:43.16,0:12:44.41,JP2,,0000,0000,0000,,Мен қазір демаламын.
Dialogue: 0,0:12:44.81,0:12:46.23,JP2,,0000,0000,0000,,Сарайдың сөзін тыңдама
Dialogue: 0,0:12:46.38,0:12:48.08,JP2,,0000,0000,0000,,Мен тыңдамаймын. Қайырлы түн.
Dialogue: 0,0:12:51.72,0:12:54.59,JP2,,0000,0000,0000,,Ол әлі балаша ойшыл.
Dialogue: 0,0:12:57.85,0:13:01.89,JP2,,0000,0000,0000,,Көктем өтіп, жаз келді.
Dialogue: 0,0:13:02.38,0:13:05.15,JP2,,0000,0000,0000,,Корохостеф Аспандағы Кагу тауы
Dialogue: 0,0:13:06.22,0:13:07.64,JP2,,0000,0000,0000,,Бұл император Джитоның әні.
Dialogue: 0,0:13:08.08,0:13:10.25,JP2,,0000,0000,0000,,Иә, маған өте ұнайды.
Dialogue: 0,0:13:11.14,0:13:13.31,JP2,,0000,0000,0000,,Әнді де, оны орындаған адамды да
Dialogue: 0,0:13:14.11,0:13:16.35,JP2,,0000,0000,0000,,Әйел болсаң да император болдың ғой, солай ма?
Dialogue: 0,0:13:17.03,0:13:17.80,JP2,,0000,0000,0000,,Бұл тамаша
Dialogue: 0,0:13:18.65,0:13:20.40,JP2,,0000,0000,0000,,Йошико император болғысы келеді
Dialogue: 0,0:13:20.47,0:13:23.05,JP2,,0000,0000,0000,,Иә, өйткені ол ең ұлы.
Dialogue: 0,0:13:23.86,0:13:26.13,JP2,,0000,0000,0000,,Ағаң ондайларды ойламайды.
Dialogue: 0,0:13:27.57,0:13:32.00,JP2,,0000,0000,0000,,Анаң сенің ағаң Император Канмудың немересі деді.
Dialogue: 0,0:13:32.80,0:13:35.02,JP2,,0000,0000,0000,,Сонда сіз император бола аласыз, солай ма?
Dialogue: 0,0:13:35.53,0:13:39.10,JP2,,0000,0000,0000,,Мен бір бола алмаймын. Менің әкем тіпті ханзада емес.
Dialogue: 0,0:13:39.73,0:13:41.63,JP2,,0000,0000,0000,,Сен императордың баласы емессің бе?
Dialogue: 0,0:13:41.89,0:13:44.69,JP2,,0000,0000,0000,,Иә, Йошико ақырында түсінеді.
Dialogue: 0,0:13:45.49,0:13:46.93,JP2,,0000,0000,0000,,Әйел император бола алмайды
Dialogue: 0,0:13:47.69,0:13:49.14,JP2,,0000,0000,0000,,Мен де үйрене алмай жүрмін
Dialogue: 0,0:13:49.51,0:13:52.14,JP2,,0000,0000,0000,,Ой, қызықсыз.
Dialogue: 0,0:13:53.14,0:13:56.71,JP2,,0000,0000,0000,,Сонда әйел қалай ұлы болады?
Dialogue: 0,0:13:59.05,0:14:03.92,JP2,,0000,0000,0000,,Император бола алмаса, ішкі сарайда гүл жайнауды ойлады ма деп ойлаймын.
Dialogue: 0,0:14:05.42,0:14:07.00,JP2,,0000,0000,0000,,Тоқсан сегіз түннен кейін
Dialogue: 0,0:14:08.41,0:14:09.77,JP2,,0000,0000,0000,,Мен сізді көндіруге тырысайын ба?
Dialogue: 0,0:14:18.41,0:14:20.76,JP2,,0000,0000,0000,,Ойтада күн салқындап барады, солай емес пе?
Dialogue: 0,0:14:20.91,0:14:21.62,JP2,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:14:22.41,0:14:24.30,JP2,,0000,0000,0000,,Менің ойымша, жақында қиын болады.
Dialogue: 0,0:14:24.39,0:14:29.46,JP2,,0000,0000,0000,,Жоқ, Хякуя болсын, Чия болсын, мен сенімен бірге барамын.
Dialogue: 0,0:14:30.08,0:14:31.15,JP2,,0000,0000,0000,,Чия
Dialogue: 0,0:14:32.67,0:14:37.05,JP2,,0000,0000,0000,,Эй Йошико, император сарайы сен ойлағандай оңай жер емес.
Dialogue: 0,0:14:37.31,0:14:38.85,JP2,,0000,0000,0000,,Менің ойымша, бұл оңай емес.
Dialogue: 0,0:14:40.11,0:14:43.79,JP2,,0000,0000,0000,,Әжем императордың мейіріміне бөленіп, әкемді дүниеге әкелді.
Dialogue: 0,0:14:44.26,0:14:47.00,JP2,,0000,0000,0000,,Ол күтуші әйел сияқты және оны айналасындағы ханшайымдар қорлайды.
Dialogue: 0,0:14:47.44,0:14:48.78,JP2,,0000,0000,0000,,Бұл көп күш жұмсаған сияқты.
Dialogue: 0,0:14:49.70,0:14:51.70,JP2,,0000,0000,0000,,Егер сіз кіретін болсаңыз, киіміңізді ауыстырыңыз.
Dialogue: 0,0:14:52.32,0:14:54.14,JP2,,0000,0000,0000,,Киім ауыстырудың күтуші әйелдікінен еш айырмашылығы жоқ.
Dialogue: 0,0:14:54.91,0:14:56.40,JP2,,0000,0000,0000,,Әжемнің екінші туған күні шығар.
Dialogue: 0,0:14:56.89,0:14:58.15,JP2,,0000,0000,0000,,Мені қорқытпа
Dialogue: 0,0:14:58.65,0:14:59.90,JP2,,0000,0000,0000,,Қиындықтардан хабардармын
Dialogue: 0,0:15:00.22,0:15:01.35,JP2,,0000,0000,0000,,Мен шешіп қойдым
Dialogue: 0,0:15:04.90,0:15:08.10,JP2,,0000,0000,0000,,Күз тереңдеп, Нийнамасай жақындап қалды.
Dialogue: 0,0:15:08.98,0:15:14.53,JP2,,0000,0000,0000,,Бірақ мен оның күннен күнге қыңыр болып бара жатқанын сеземін.
Dialogue: 0,0:15:17.44,0:15:18.94,JP2,,0000,0000,0000,,Бүгін көңіл-күйіңіз жақсы ма?
Dialogue: 0,0:15:19.67,0:15:20.34,JP2,,0000,0000,0000,,Маған күзгі жапырақтар керек
Dialogue: 0,0:15:21.27,0:15:23.84,JP2,,0000,0000,0000,,Егер сіз сарайда қызмет етуге келіссеңіз, мен оны қабылдай аламын.
Dialogue: 0,0:15:24.65,0:15:25.70,JP2,,0000,0000,0000,,Мен оны саған бермеймін.
Dialogue: 0,0:15:28.13,0:15:30.29,JP2,,0000,0000,0000,,Бала кезіңізде Йошико
Dialogue: 0,0:15:31.04,0:15:33.32,JP2,,0000,0000,0000,,Сіз император болып, ұлы болғыңыз келетінін айттыңыз.
Dialogue: 0,0:15:34.91,0:15:37.45,JP2,,0000,0000,0000,,Сол күндер жақсы есімде.
Dialogue: 0,0:15:38.14,0:15:39.02,JP2,,0000,0000,0000,,Сізге келетін болсақ.
Dialogue: 0,0:15:41.03,0:15:44.56,JP2,,0000,0000,0000,,Мен де осындай себеппен ішкі сарайға кіргім келеді: ұлы болғым келеді.
Dialogue: 0,0:15:45.17,0:15:48.63,JP2,,0000,0000,0000,,Иә, солай болып шықты.
Dialogue: 0,0:15:49.34,0:15:50.21,JP2,,0000,0000,0000,,Бұл сәл басқаша.
Dialogue: 0,0:15:51.12,0:15:52.47,JP2,,0000,0000,0000,,Мен де үйлену туралы ойладым.
Dialogue: 0,0:15:53.39,0:15:56.28,JP2,,0000,0000,0000,,Ағаңдай біреудің сүйгені сондай.
Dialogue: 0,0:15:56.93,0:15:58.48,JP2,,0000,0000,0000,,Мен оның мені алдайтынына сенімдімін
Dialogue: 0,0:15:58.60,0:16:00.07,JP2,,0000,0000,0000,,Жоқ, сіз қалай шешесіз?
Dialogue: 0,0:16:00.08,0:16:01.48,JP2,,0000,0000,0000,,Мүмкін болса да
Dialogue: 0,0:16:02.68,0:16:04.38,JP2,,0000,0000,0000,,Сонда да мақтанышыңды жоғалтпа
Dialogue: 0,0:16:04.89,0:16:06.55,JP2,,0000,0000,0000,,Үйіңді қорға, балаларыңды өсір
Dialogue: 0,0:16:06.99,0:16:08.34,JP2,,0000,0000,0000,,Өзіңізді мықты ұстаңыз
Dialogue: 0,0:16:08.78,0:16:09.82,JP2,,0000,0000,0000,,Жарқырай алсаң
Dialogue: 0,0:16:10.28,0:16:12.58,JP2,,0000,0000,0000,,Бұл өте тамаша және тамаша.
Dialogue: 0,0:16:13.63,0:16:17.33,JP2,,0000,0000,0000,,Бірақ содан кейін мен ұйықтап жатқан бөлігім тым үлкен сияқты сезінемін.
Dialogue: 0,0:16:18.18,0:16:21.32,JP2,,0000,0000,0000,,Осы уақытқа дейін нені үйрендім Мен өсірдім
Dialogue: 0,0:16:21.77,0:16:24.20,JP2,,0000,0000,0000,,Қызық, оны сынап көруге мүмкіндік жеткілікті ме?
Dialogue: 0,0:16:25.02,0:16:27.79,JP2,,0000,0000,0000,,Көп жерім кеуіп бара жатыр ма деп ойлаймын.
Dialogue: 0,0:16:28.96,0:16:30.94,JP2,,0000,0000,0000,,Мен шыдай алмаймын
Dialogue: 0,0:16:32.36,0:16:36.31,JP2,,0000,0000,0000,,Мен бір рет қана өмір сүремін, бәріне тәуекел етіп, жоғары деңгейде күрескім келеді.
Dialogue: 0,0:16:36.89,0:16:39.97,JP2,,0000,0000,0000,,Алда тек азапты нәрселер күтіп тұрса да
Dialogue: 0,0:16:41.00,0:16:44.71,JP2,,0000,0000,0000,,Ер болсаң мен де сенің арманыңды қолдай алар едім.
Dialogue: 0,0:16:45.48,0:16:46.69,JP2,,0000,0000,0000,,Бірақ сен әйелсің
Dialogue: 0,0:16:47.10,0:16:48.24,JP2,,0000,0000,0000,,Бұл да әдемі
Dialogue: 0,0:16:49.72,0:16:54.93,JP2,,0000,0000,0000,,Сенің ағаң үшін әйелдер – аянышты жаратылыс, оларды қорғау керек.
Dialogue: 0,0:16:55.21,0:16:56.40,JP2,,0000,0000,0000,,Мен оны жоққа шығармаймын
Dialogue: 0,0:16:56.98,0:17:00.10,JP2,,0000,0000,0000,,Қазіргі заманда әйелдер қандай болса да солай.
Dialogue: 0,0:17:00.91,0:17:03.49,JP2,,0000,0000,0000,,Мұны білуге ​​сіз де жас емессіз.
Dialogue: 0,0:17:04.52,0:17:07.07,JP2,,0000,0000,0000,,Неліктен қиын жолды таңдау керек?
Dialogue: 0,0:17:07.81,0:17:10.13,JP2,,0000,0000,0000,,Бақытты болғың келмейді ме?
Dialogue: 0,0:17:10.13,0:17:10.98,JP2,,0000,0000,0000,,Мен болғым келеді
Dialogue: 0,0:17:11.57,0:17:13.53,JP2,,0000,0000,0000,,Бірақ мен оны басқа біреудің маған жасағанын қаламаймын.
Dialogue: 0,0:17:14.19,0:17:16.72,JP2,,0000,0000,0000,,Мен өзім бақытты болғым келеді.
Dialogue: 0,0:17:17.50,0:17:21.18,JP2,,0000,0000,0000,,Мен қорғансыз өмір сүре алмайтын, күтетін әйел болғым келмейді.
Dialogue: 0,0:17:22.05,0:17:26.07,JP2,,0000,0000,0000,,Ағамның мені ғана қалайтынын білген сайын мұңайып кеттім.
Dialogue: 0,0:17:26.45,0:17:28.25,JP2,,0000,0000,0000,,Мұны қалай түсінбейсің?
Dialogue: 0,0:17:31.35,0:17:33.40,JP2,,0000,0000,0000,,Жапонияда біз жаңа ғана ажырасып, ұрысып қалдық.
Dialogue: 0,0:17:33.98,0:17:36.00,JP2,,0000,0000,0000,,Мен оның мұндай қыңыр екенін білмедім.
Dialogue: 0,0:17:37.17,0:17:38.76,JP2,,0000,0000,0000,,Жоқ, көп уақыт өтті.
Dialogue: 0,0:17:39.13,0:17:41.66,JP2,,0000,0000,0000,,Сосада-доно, ханым қоңырау шалып жатыр.
Dialogue: 0,0:17:42.17,0:17:43.60,JP2,,0000,0000,0000,,Аа, мен бірден барамын.
Dialogue: 0,0:17:45.24,0:17:46.94,JP2,,0000,0000,0000,,Егер сіз бәсекеге қабілетті болсаңыз
Dialogue: 0,0:17:47.17,0:17:48.54,JP2,,0000,0000,0000,,Сіз мұны осы жерден де жасай аласыз.
Dialogue: 0,0:17:53.94,0:17:55.59,JP2,,0000,0000,0000,,Жоқ, бәрі осы.
Dialogue: 0,0:17:56.65,0:18:00.88,JP2,,0000,0000,0000,,Жарты жолда жібергенше, қабылданғаны жақсы.
Dialogue: 0,0:18:07.22,0:18:10.72,JP2,,0000,0000,0000,,Құдай-ау, көздегенімдей қатты жаңбыр жауды.
Dialogue: 0,0:18:11.76,0:18:13.32,JP2,,0000,0000,0000,,Бүгін түнде барсаң, жүз түн болады.
Dialogue: 0,0:18:15.26,0:18:17.74,JP2,,0000,0000,0000,,Бұл мәселе бүгін шешілмейді деп ойлаймын.
Dialogue: 0,0:18:20.63,0:18:22.52,JP2,,0000,0000,0000,,Бұл Хякуя.
Dialogue: 0,0:18:22.77,0:18:24.64,JP2,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:18:25.07,0:18:27.07,JP2,,0000,0000,0000,,Менің де сенімен кездескенім жаман болды.
Dialogue: 0,0:18:27.41,0:18:31.62,JP2,,0000,0000,0000,,Немене, күйеуімнің махаббаты қайтарылса, сүйемін.
Dialogue: 0,0:18:34.35,0:18:35.70,JP2,,0000,0000,0000,,Бұл нәтиже береді деп үміттенемін
Dialogue: 0,0:18:41.35,0:18:42.50,JP2,,0000,0000,0000,,Сосададен
Dialogue: 0,0:18:46.24,0:18:47.78,JP2,,0000,0000,0000,,Менің ағам қайтыс болды.
Dialogue: 0,0:18:48.08,0:18:51.80,JP2,,0000,0000,0000,,Өзен суының көтерілуіне байланысты көпір тұрмай қалды, сондықтан мен өтіп бара жатып құлап қалдым деп ойладым.
Dialogue: 0,0:18:52.33,0:18:54.02,JP2,,0000,0000,0000,,Көлік табылды.
Dialogue: 0,0:18:56.90,0:18:59.22,JP2,,0000,0000,0000,,Қайда бара жатырсың, Йошико?
Dialogue: 0,0:18:59.60,0:19:00.88,JP2,,0000,0000,0000,,Мен де іздеп келейін.
Dialogue: 0,0:19:00.97,0:19:01.57,JP2,,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:01.65,0:19:02.37,JP2,,0000,0000,0000,,Шығарылым
Dialogue: 0,0:19:12.77,0:19:14.19,JP2,,0000,0000,0000,,Ақыры бетіңізді көрсеттіңіз.
Dialogue: 0,0:19:14.87,0:19:17.76,JP2,,0000,0000,0000,,Үлкен аға, шын аға
Dialogue: 0,0:19:19.00,0:19:20.57,JP2,,0000,0000,0000,,Мен бұл жаңбыр жаумайды деп ойладым.
Dialogue: 0,0:19:21.02,0:19:22.99,JP2,,0000,0000,0000,,Көпір құлап, машина
Dialogue: 0,0:19:23.40,0:19:25.42,JP2,,0000,0000,0000,,Сізді жай ғана қуып жіберді.
Dialogue: 0,0:19:25.97,0:19:26.96,JP2,,0000,0000,0000,,Мазмұны төмендегідей
Dialogue: 0,0:19:28.81,0:19:32.69,JP2,,0000,0000,0000,,Кешіріңіз, сиыршы бақшада қалтырап жатыр, сіз оған қамқорлық жасай аласыз ба?
Dialogue: 0,0:19:33.01,0:19:34.06,JP2,,0000,0000,0000,,Иә, бірден
Dialogue: 0,0:19:34.36,0:19:36.13,JP2,,0000,0000,0000,,Дұрыс, күтіңіз, ағайын.
Dialogue: 0,0:19:36.44,0:19:37.57,JP2,,0000,0000,0000,,Мен саған ыстық су әкелемін.
Dialogue: 0,0:19:37.77,0:19:40.75,JP2,,0000,0000,0000,,Ой, осындасың.
Dialogue: 0,0:19:43.14,0:19:44.87,JP2,,0000,0000,0000,,Енді сіз 100 түнді аяқтадыңыз.
Dialogue: 0,0:19:45.60,0:19:47.18,JP2,,0000,0000,0000,,Бұл өкінішті болды, Йошико.
Dialogue: 0,0:19:47.68,0:19:48.54,JP2,,0000,0000,0000,,Жақсы
Dialogue: 0,0:19:48.95,0:19:50.53,JP2,,0000,0000,0000,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:19:50.83,0:19:52.64,JP2,,0000,0000,0000,,Себебі мен ақымақтық айттым
Dialogue: 0,0:19:52.89,0:19:54.91,JP2,,0000,0000,0000,,Ағамды осындай сұмдықпен көру
Dialogue: 0,0:19:55.24,0:19:56.58,JP2,,0000,0000,0000,,Жақсы, жақсы.
Dialogue: 0,0:19:57.58,0:19:59.21,JP2,,0000,0000,0000,,Жылама, маған бетіңді көрсет
Dialogue: 0,0:20:02.21,0:20:04.76,JP2,,0000,0000,0000,,Жүзіңді көрсем де, шіркін.
Dialogue: 0,0:20:05.41,0:20:06.25,JP2,,0000,0000,0000,,Ой...
Dialogue: 0,0:20:06.28,0:20:07.00,JP2,,0000,0000,0000,,өтірік өтірік
Dialogue: 0,0:20:07.80,0:20:08.92,JP2,,0000,0000,0000,,Оның жылаған түрі де әдемі.
Dialogue: 0,0:20:15.41,0:20:16.14,JP2,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:20:20.22,0:20:20.64,JP2,,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:20:24.39,0:20:25.66,JP2,,0000,0000,0000,,Мен мұны істей алмаймын.
Dialogue: 0,0:20:26.61,0:20:29.16,JP2,,0000,0000,0000,,Хякуя менің сезімімді жеткізбеді.
Dialogue: 0,0:20:30.44,0:20:31.32,JP2,,0000,0000,0000,,Мен сені жек көремін
Dialogue: 0,0:20:32.81,0:20:34.92,JP2,,0000,0000,0000,,Мен сені сүйемін, мен сені сүйемін.
Dialogue: 0,0:20:35.48,0:20:37.00,JP2,,0000,0000,0000,,Бала кезімнен
Dialogue: 0,0:20:37.31,0:20:38.15,JP2,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:20:40.03,0:20:42.63,JP2,,0000,0000,0000,,Мына Хякуя мен де адасып қалдым.
Dialogue: 0,0:20:43.50,0:20:48.39,JP2,,0000,0000,0000,,Мен ағамның сүйіспеншілігіне бөленіп, бірге жасай алатын болашақ бар ма екен деп білгім келді.
Dialogue: 0,0:20:49.64,0:20:55.21,JP2,,0000,0000,0000,,Бірақ одан да көп мен арманымнан бас тарта алмаймын.
Dialogue: 0,0:20:56.84,0:20:59.73,JP2,,0000,0000,0000,,Осы күнге жету үшін талай қиындықтан өттіңіз.
Dialogue: 0,0:21:00.31,0:21:01.01,JP2,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:21:02.06,0:21:05.60,JP2,,0000,0000,0000,,Сіз бүгін кешке келмегендей кейіп көрсете аласыз ба?
Dialogue: 0,0:21:06.45,0:21:06.82,JP2,,0000,0000,0000,,Міндетті түрде.
Dialogue: 0,0:21:06.88,0:21:07.28,JP2,,0000,0000,0000,,Осы жерден айналып өтейік…
Dialogue: 0,0:21:08.26,0:21:12.03,JP2,,0000,0000,0000,,100 түн өткізсең, менің әйелім болуға уәде бересің.
Dialogue: 0,0:21:25.31,0:21:26.06,JP2,,0000,0000,0000,,Аға
Dialogue: 0,0:21:28.01,0:21:28.88,JP2,,0000,0000,0000,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:21:29.84,0:21:32.35,JP2,,0000,0000,0000,,Бұл менің жоғалтым, Йошико.
Dialogue: 0,0:21:36.52,0:21:38.71,JP2,,0000,0000,0000,,Тоқсан тоғыз түн?
Dialogue: 0,0:21:39.07,0:21:42.06,JP2,,0000,0000,0000,,Неге тағы бір күн көрмедің?
Dialogue: 0,0:21:42.52,0:21:43.59,JP2,,0000,0000,0000,,Мен саған бәс тігемін
Dialogue: 0,0:21:44.15,0:21:47.18,JP2,,0000,0000,0000,,Жаңбырдың қатты жауғаны сонша, далаға шыққанда өліп қала жаздадым.
Dialogue: 0,0:21:47.44,0:21:48.11,JP2,,0000,0000,0000,,Таку
Dialogue: 0,0:21:48.78,0:21:51.92,JP2,,0000,0000,0000,,Дегенмен, Мунесада-сама айтқандай,
Dialogue: 0,0:21:52.30,0:21:55.90,JP2,,0000,0000,0000,,Әдемі, Йошими-дононың қызы
Dialogue: 0,0:21:57.89,0:22:00.71,JP2,,0000,0000,0000,,Бұл менің соңғы рет көруім болуы мүмкін.
Dialogue: 0,0:22:11.79,0:22:17.54,JP2,,0000,0000,0000,,Жел, өтінемін, қатты соғып, қыздың үйге қайтуына жол жабыңыз.
Dialogue: 0,0:22:18.96,0:22:22.21,JP2,,0000,0000,0000,,Мен оны біраз уақытқа көргім келеді.
Dialogue: 0,0:22:25.08,0:22:27.21,JP2,,0000,0000,0000,,Бұдан былай қалай билейсің?
Dialogue: 0,0:22:28.75,0:22:31.73,JP2,,0000,0000,0000,,Бар жақсылықты тілеймін
Dialogue: 0,0:22:34.27,0:22:36.26,JP2,,0000,0000,0000,,Йошико компанияға айырбастаушы болып кірді
Dialogue: 0,0:22:37.80,0:22:41.10,JP2,,0000,0000,0000,,Ол болашақ Оно Комачи
Dialogue: 0,0:24:16.96,0:24:21.41,JP2,,0000,0000,0000,,Күзгі өсімдіктерді үрлегендіктен бақсаң
Dialogue: 0,0:24:22.55,0:24:26.06,JP2,,0000,0000,0000,,Таудың желін дауыл деп елестетіңіз
Dialogue: 0,0:00:05.54,0:00:07.70,CN,,0000,0000,0000,,Қазір Теня ең жақсы ауа-райы
Dialogue: 0,0:00:09.19,0:00:11.90,CN,,0000,0000,0000,,Ояёси Мен Фудзивара, Тенкусори, Тейкамын
Dialogue: 0,0:00:12.58,0:00:15.20,CN,,0000,0000,0000,,Құрметті баршаңыз, бұл империялық таңдалған жапон өлеңдерінің жинағы.
Dialogue: 0,0:00:16.00,0:00:19.59,CN,,0000,0000,0000,,Бұл император мен отставкадағы император құрастырған вака өлеңдер жинағы.
Dialogue: 0,0:00:20.76,0:00:25.63,CN,,0000,0000,0000,,《》《》
Dialogue: 0,0:00:26.25,0:00:31.15,CN,,0000,0000,0000,,Алайда императорлық қолбасшылық таңдаған жапон өлеңдер жинағындағы алғашқы қадам Кокин Вакашудың аяқталуы болып табылады.
Dialogue: 0,0:00:32.10,0:00:35.27,CN,,0000,0000,0000,,Ересек
Dialogue: 0,0:00:35.85,0:00:38.70,CN,,0000,0000,0000,,··
Dialogue: 0,0:00:40.36,0:00:42.45,CN,,0000,0000,0000,,Жапон поэмасының көлденең биіктігі болып табылады
Dialogue: 0,0:00:42.80,0:00:46.05,CN,,0000,0000,0000,,Бұл бүгінгі әдебиет журналында 《Tosa Daily Record》 бірінші рет әйелдің тұмсығы жазылды.
Dialogue: 0,0:00:46.92,0:00:48.55,CN,,0000,0000,0000,,Қазіргі уақытта қолданылуда, бұл қыздың аты.
Dialogue: 0,0:00:49.06,0:00:49.88,CN,,0000,0000,0000,,o(*￣▽￣*)
Dialogue: 0,0:00:50.47,0:00:54.02,CN,,0000,0000,0000,,Мен бұл әңгімені оқығанға дейінгі кезімдегі оқиғалар
Dialogue: 0,0:00:54.53,0:00:55.45,CN,,0000,0000,0000,,Йошихиро~
Dialogue: 0,0:02:44.39,0:02:45.75,CN,,0000,0000,0000,,Уджиямаға жету
Dialogue: 0,0:02:46.77,0:02:49.34,CN,,0000,0000,0000,,Киотода таусылып, Толқынның жүрегі жазылды
Dialogue: 0,0:02:50.41,0:02:51.53,CN,,0000,0000,0000,,Қолайсыз қашықтық
Dialogue: 0,0:02:52.23,0:02:55.32,CN,,0000,0000,0000,,Адамдар тұратын ыңғайсыз ауылдық жерлер
Dialogue: 0,0:02:55.44,0:02:56.40,CN,,0000,0000,0000,,Накама тірі емес.
Dialogue: 0,0:02:57.96,0:03:00.40,CN,,0000,0000,0000,,Йошихиса Фукиюки-кун
Dialogue: 0,0:03:00.80,0:03:03.37,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:03.81,0:03:05.74,CN,,0000,0000,0000,,Сен қайдан келдің?
Dialogue: 0,0:03:06.17,0:03:09.24,CN,,0000,0000,0000,,Мәселе туралы ойлану және оны ересектерге үйрету үшін осында болсаңыз, бұл орын.
Dialogue: 0,0:03:10.74,0:03:12.84,CN,,0000,0000,0000,,Қарт қызметкерлер
Dialogue: 0,0:03:13.17,0:03:14.24,CN,,0000,0000,0000,,Әрине түсінемін.
Dialogue: 0,0:03:14.58,0:03:16.98,CN,,0000,0000,0000,,Есептеу
Dialogue: 0,0:03:17.29,0:03:18.28,CN,,0000,0000,0000,,Осымен
Dialogue: 0,0:03:18.99,0:03:21.32,CN,,0000,0000,0000,,Қалаған аймақ қай жерде?
Dialogue: 0,0:03:21.63,0:03:23.05,CN,,0000,0000,0000,,Сонымен қатар, бұл ыңғайсыз
Dialogue: 0,0:03:23.46,0:03:27.27,CN,,0000,0000,0000,,Бұл ыңғайлы емес немесе оған тұрарлық емес.
Dialogue: 0,0:03:27.51,0:03:29.04,CN,,0000,0000,0000,,Бақытты ересек адам
Dialogue: 0,0:03:30.04,0:03:31.85,CN,,0000,0000,0000,,Бақытты болған жақсы.
Dialogue: 0,0:03:32.22,0:03:34.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:35.05,0:03:37.28,CN,,0000,0000,0000,,Киотоның кішкентай шындығы өлді.\N9-бөлім
Dialogue: 0,0:03:39.93,0:03:44.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:44.51,0:03:50.30,CN,,0000,0000,0000,,Алғы сөзде, еліміздегі 6-шы заманауи ақындар тізімінде.
Dialogue: 0,0:03:51.87,0:03:53.00,CN,,0000,0000,0000,,Соджо Хеншо
Dialogue: 0,0:03:53.46,0:03:54.42,CN,,0000,0000,0000,,Оно Комачи
Dialogue: 0,0:03:55.16,0:03:56.58,CN,,0000,0000,0000,,Аривара Джахеи
Dialogue: 0,0:03:56.89,0:03:58.11,CN,,0000,0000,0000,,Отомо Курошу
Dialogue: 0,0:03:58.73,0:03:59.91,CN,,0000,0000,0000,,Ясухиде Буня
Dialogue: 0,0:04:00.57,0:04:03.20,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:04.40,0:04:06.63,CN,,0000,0000,0000,,Егер сіз осында болсаңыз, онда алты адам бар.
Dialogue: 0,0:04:07.49,0:04:11.79,CN,,0000,0000,0000,,Чохеидің үлкен ағасы Юкихира Онодан кейін қалаға қанша адам кіруді таңдады?
Dialogue: 0,0:04:12.57,0:04:16.00,CN,,0000,0000,0000,,Осыны ойлап қарасақ, бұл жоғары дәрежелі ұлы тұлға.
Dialogue: 0,0:04:16.72,0:04:18.97,CN,,0000,0000,0000,,Мен төмен дәрежедегі адаммын...
Dialogue: 0,0:04:19.61,0:04:22.40,CN,,0000,0000,0000,,Үкімет ортасында таланты жоқ болғандықтан, Ясухиде қарт.
Dialogue: 0,0:04:22.72,0:04:28.48,CN,,0000,0000,0000,,Императорлық соттың бізге патша текті адам дәрежесін таңдауды бұйырғаны дұрыс емес.
Dialogue: 0,0:04:28.77,0:04:29.86,CN,,0000,0000,0000,,Бұл әңгіме
Dialogue: 0,0:04:30.38,0:04:35.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:35.66,0:04:37.42,CN,,0000,0000,0000,,Осыған байланысты лауазымды басқарған адам жойылды
Dialogue: 0,0:04:37.46,0:04:37.83,CN,,0000,0000,0000,,Аракара
Dialogue: 0,0:04:39.16,0:04:41.35,CN,,0000,0000,0000,,Таңдау себебі
Dialogue: 0,0:04:42.03,0:04:42.66,CN,,0000,0000,0000,,Менің таңдауым
Dialogue: 0,0:04:43.07,0:04:48.38,CN,,0000,0000,0000,,Қатыспау мақсатындағы вака өлеңдері.
Dialogue: 0,0:04:49.02,0:04:51.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:51.92,0:04:53.96,CN,,0000,0000,0000,,Бұл арнайы сапар
Dialogue: 0,0:04:54.89,0:04:57.76,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:58.28,0:04:59.80,CN,,0000,0000,0000,,Кітапқа алғысөз
Dialogue: 0,0:05:02.12,0:05:03.32,CN,,0000,0000,0000,,Ақиқат – өлім заңы
Dialogue: 0,0:05:04.75,0:05:09.77,CN,,0000,0000,0000,,Діни қызметкер әулиеліктен өткенде, монахтарға айқайлады...
Dialogue: 0,0:05:10.49,0:05:13.45,&,,0000,0000,0000,,Со Йокичико
Dialogue: 0,0:05:10.49,0:05:13.45,,,0000,0000,0000,,Соджо Хеншо
Dialogue: 0,0:05:14.39,0:05:15.30,CN,,0000,0000,0000,,Түннің түсуі 100 күн
Dialogue: 0,0:05:15.82,0:05:17.41,CN,,0000,0000,0000,,Сіз не істеріңізді білмейсіз.
Dialogue: 0,0:05:17.82,0:05:22.35,CN,,0000,0000,0000,,Мүмкін болса, жоқ болса, 100 күн мен түн болады.
Dialogue: 0,0:05:22.82,0:05:24.59,CN,,0000,0000,0000,,Елордадағы пәтер иесі
Dialogue: 0,0:05:25.09,0:05:27.52,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:28.55,0:05:31.08,CN,,0000,0000,0000,,Қайтыс болған адаммен кім табысты?
Dialogue: 0,0:05:31.48,0:05:33.28,CN,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:05:33.98,0:05:35.71,CN,,0000,0000,0000,,Мен өзімшіл болғандықтан, мен өте тартымдымын.
Dialogue: 0,0:05:36.32,0:05:37.40,CN,,0000,0000,0000,,Аспаннан кеттің
Dialogue: 0,0:05:37.59,0:05:38.71,CN,,0000,0000,0000,,Мен он аспанды тастап, онда тұрмадым.
Dialogue: 0,0:05:38.96,0:05:39.95,CN,,0000,0000,0000,,Мен бес аспанмын.
Dialogue: 0,0:05:40.55,0:05:41.67,CN,,0000,0000,0000,,Гасан Теншу Тайтайдо Корё
Dialogue: 0,0:05:42.29,0:05:43.53,CN,,0000,0000,0000,,Сіз сот процесін аяқтадыңыз.
Dialogue: 0,0:05:43.69,0:05:45.99,CN,,0000,0000,0000,,Саяси іс-шараға барар алдында шаршау
Dialogue: 0,0:05:46.04,0:05:48.13,CN,,0000,0000,0000,,Суық адам кездессе, жүрек жабылады.
Dialogue: 0,0:05:48.18,0:05:51.92,CN,,0000,0000,0000,,Әңгімелесу: ``Менің әңгімем туралы не ойлайсыз? Түнде 100 күн.''
Dialogue: 0,0:05:51.96,0:05:52.95,CN,,0000,0000,0000,,Менмендік туралы айту
Dialogue: 0,0:05:53.45,0:05:57.53,CN,,0000,0000,0000,,Бұл Киётаканың соңғы жұмысы.
Dialogue: 0,0:05:57.53,0:05:58.47,CN,,0000,0000,0000,,Жауапсыздық
Dialogue: 0,0:05:59.55,0:06:02.76,CN,,0000,0000,0000,,Ерінбей еңбек ету арқылы сіз әлемдегі ең жақсы адам бола аласыз.
Dialogue: 0,0:06:06.58,0:06:10.55,CN,,0000,0000,0000,,Жаздың басы өтті
Dialogue: 0,0:06:11.49,0:06:14.28,CN,,0000,0000,0000,,Ақ халатты кім?
Dialogue: 0,0:06:15.61,0:06:18.15,CN,,0000,0000,0000,,Бұл императордың жапон поэмасы Йошико
Dialogue: 0,0:06:18.42,0:06:21.03,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:22.98,0:06:25.48,CN,,0000,0000,0000,,Жас ақиқат осындай. Не сынап көру керек?
Dialogue: 0,0:06:26.20,0:06:29.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:29.36,0:06:31.92,CN,,0000,0000,0000,,Мен емес, жүз күн түнгі саяхат
Dialogue: 0,0:06:32.02,0:06:33.86,CN,,0000,0000,0000,,Жеңіліс және сынақ
Dialogue: 0,0:06:33.87,0:06:34.89,CN,,0000,0000,0000,,Мен не төлеуім керек...
Dialogue: 0,0:06:35.64,0:06:38.52,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:38.72,0:06:40.31,CN,,0000,0000,0000,,Мынаны айт...
Dialogue: 0,0:06:40.40,0:06:43.64,CN,,0000,0000,0000,,Партиядан шығуы мүмкін және сенімсіз адам
Dialogue: 0,0:06:43.84,0:06:44.84,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:45.06,0:06:47.53,CN,,0000,0000,0000,,Біраз уақыт өтті
Dialogue: 0,0:06:47.79,0:06:50.37,CN,,0000,0000,0000,,Егер сізде басқарылатын сынақ болса
Dialogue: 0,0:06:50.72,0:06:55.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:56.34,0:06:58.92,CN,,0000,0000,0000,,Сарай? Бюджетте сарай?
Dialogue: 0,0:06:59.25,0:07:04.88,CN,,0000,0000,0000,,Жаңа жыл мерекесінде орындалған бес бұрышты би.
Dialogue: 0,0:07:05.40,0:07:08.81,CN,,0000,0000,0000,,Йошико Канаме, императордың жұбайы
Dialogue: 0,0:07:22.27,0:07:22.95,CN,,0000,0000,0000,,Йошико Коджи
Dialogue: 0,0:07:24.64,0:07:27.26,CN,,0000,0000,0000,,Бұл кеште болған оқиға.
Dialogue: 0,0:07:27.88,0:07:29.77,CN,,0000,0000,0000,,Мен соңғы кездері бос емеспін.
Dialogue: 0,0:07:30.72,0:07:32.35,CN,,0000,0000,0000,,Денесі жақсы Йошико
Dialogue: 0,0:07:33.06,0:07:34.60,CN,,0000,0000,0000,,Барлық тыныштық пен сәттілік
Dialogue: 0,0:07:35.49,0:07:38.94,CN,,0000,0000,0000,,Шындық бұл шындыққа ұқсамайды.
Dialogue: 0,0:07:39.64,0:07:41.33,CN,,0000,0000,0000,,Кәмелеттік жасқа толдың
Dialogue: 0,0:07:42.52,0:07:44.00,CN,,0000,0000,0000,,Жедел жеткізу - Geege
Dialogue: 0,0:07:44.37,0:07:47.73,CN,,0000,0000,0000,,Орыннан шыққан соң бамбук парағын аштым.
Dialogue: 0,0:07:49.52,0:07:50.20,CN,,0000,0000,0000,,Тортты да жей алмай ма?
Dialogue: 0,0:07:51.04,0:07:52.38,CN,,0000,0000,0000,,Ұзақ мерзімді ересек
Dialogue: 0,0:07:52.71,0:07:56.00,CN,,0000,0000,0000,,Қалада арман қуып жүрген ер адамдар көп.
Dialogue: 0,0:07:56.97,0:07:59.83,CN,,0000,0000,0000,,100 күн мен түн
Dialogue: 0,0:08:00.46,0:08:02.39,CN,,0000,0000,0000,,Бұл оқиға болды.
Dialogue: 0,0:08:02.62,0:08:04.27,CN,,0000,0000,0000,,Өйткені сен өте суықсың
Dialogue: 0,0:08:04.75,0:08:07.12,CN,,0000,0000,0000,,Мияконоджода ер адамдарда өшпенділік болмайды
Dialogue: 0,0:08:07.24,0:08:08.50,CN,,0000,0000,0000,,Сіз тәкаппар әйелсіз.
Dialogue: 0,0:08:09.20,0:08:13.21,CN,,0000,0000,0000,,Күлкілі екені рас.
Dialogue: 0,0:08:13.64,0:08:14.83,CN,,0000,0000,0000,,Бас тарту немесе басқаларға араласу
Dialogue: 0,0:08:15.27,0:08:18.62,CN,,0000,0000,0000,,Түн 100 күн болғаны ғана.\N15-бөлім
Dialogue: 0,0:08:19.27,0:08:23.08,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:23.83,0:08:25.43,CN,,0000,0000,0000,,Басқалар сені менмен, сезімдерің бар дейді.
Dialogue: 0,0:08:26.13,0:08:29.51,CN,,0000,0000,0000,,Бұл ақымақ ойлау тәсілі.
Dialogue: 0,0:08:30.14,0:08:30.96,CN,,0000,0000,0000,,Ақымақ
Dialogue: 0,0:08:31.83,0:08:35.24,CN,,0000,0000,0000,,Әйел тұрмысқа шыққаннан кейін тәуелсіз және тәуелсіз болады.
Dialogue: 0,0:08:36.09,0:08:38.68,CN,,0000,0000,0000,,Кектік орын сияқты ұзақ күткен күйеу
Dialogue: 0,0:08:39.05,0:08:41.04,CN,,0000,0000,0000,,Бұл түннің түні немесе түннің 1000 түні
Dialogue: 0,0:08:41.97,0:08:46.52,CN,,0000,0000,0000,,Табиғи түрде ойлануды қажет ететін өзін-өзі орындау және бақыт сәті.
Dialogue: 0,0:08:47.54,0:08:50.61,CN,,0000,0000,0000,,Әйел қуып бақытқа ұмтылу тәкаппар.
Dialogue: 0,0:08:52.08,0:08:55.30,CN,,0000,0000,0000,,Бұл сіздің бақытқа ұмтылуыңыздың бастауы.
Dialogue: 0,0:08:55.94,0:08:57.03,CN,,0000,0000,0000,,Дұрыс және бұрыс
Dialogue: 0,0:08:57.84,0:09:01.38,CN,,0000,0000,0000,,Мен өз ниетімді түсінемін.
Dialogue: 0,0:09:02.69,0:09:07.47,CN,,0000,0000,0000,,Келесі жүз күн мен түнді келесі генерал естіді.
Dialogue: 0,0:09:08.75,0:09:10.26,CN,,0000,0000,0000,,Бұл бірінші түн
Dialogue: 0,0:09:10.60,0:09:13.48,CN,,0000,0000,0000,,Міндетті емес
Dialogue: 0,0:09:13.83,0:09:15.60,CN,,0000,0000,0000,,Бұл досты арандату әрекеті.
Dialogue: 0,0:09:16.55,0:09:19.29,CN,,0000,0000,0000,,Менің сүйіспеншілігім мен ниетімді қабылдамау
Dialogue: 0,0:09:19.75,0:09:20.22,CN,,0000,0000,0000,,Махаббат...
Dialogue: 0,0:09:21.26,0:09:24.44,CN,,0000,0000,0000,,Мен саған ғашықпын
Dialogue: 0,0:09:24.98,0:09:29.54,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:30.15,0:09:33.38,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:34.08,0:09:36.09,CN,,0000,0000,0000,,Егер сіз оны оқығыңыз келсе, оны енгізіңіз.
Dialogue: 0,0:09:37.00,0:09:41.54,CN,,0000,0000,0000,,Мен кенеттен кеткенімді түсіндім.
Dialogue: 0,0:09:42.21,0:09:44.64,CN,,0000,0000,0000,,Йошико
Dialogue: 0,0:09:45.71,0:09:47.11,CN,,0000,0000,0000,,Менің ойларымды басқаруға қанша адам жауапты?
Dialogue: 0,0:09:47.71,0:09:49.96,CN,,0000,0000,0000,,Император Газузе
Dialogue: 0,0:09:54.13,0:09:55.78,CN,,0000,0000,0000,,Токиоға әр түнде келу керек пе?
Dialogue: 0,0:09:55.82,0:09:56.49,CN,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:09:56.64,0:09:58.77,CN,,0000,0000,0000,,Шынайы карта
Dialogue: 0,0:09:58.82,0:09:59.86,CN,,0000,0000,0000,,Гор
Dialogue: 0,0:10:00.37,0:10:03.56,CN,,0000,0000,0000,,Мен сенімен кездескім келмейді.
Dialogue: 0,0:10:03.60,0:10:05.42,CN,,0000,0000,0000,,Сөйлеуге болмайды
Dialogue: 0,0:10:05.68,0:10:06.87,CN,,0000,0000,0000,,Сәттілік.
Dialogue: 0,0:10:07.48,0:10:10.50,CN,,0000,0000,0000,,Сіз мұнда 100 күн мен түн болдыңыз, мен сіздің ойыңызды білемін.
Dialogue: 0,0:10:11.20,0:10:13.10,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:10:14.51,0:10:16.19,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:10:16.91,0:10:18.91,CN,,0000,0000,0000,,100 түн бұрын белгілі бір жиналыс өтті.
Dialogue: 0,0:10:19.06,0:10:22.03,CN,,0000,0000,0000,,Осыған байланысты сіз жақсы психологияға дайын болуыңыз керек.
Dialogue: 0,0:10:30.59,0:10:32.85,CN,,0000,0000,0000,,Екінші түнде жаңбыр жауа бастады.
Dialogue: 0,0:10:34.02,0:10:37.25,CN,,0000,0000,0000,,100 күн түнгі хикаялар
Dialogue: 0,0:10:37.33,0:10:38.33,CN,,0000,0000,0000,,Ересектерге арналған қосымша
Dialogue: 0,0:10:38.65,0:10:41.00,CN,,0000,0000,0000,,Қажетті май сіздікі.
Dialogue: 0,0:10:41.60,0:10:43.88,CN,,0000,0000,0000,,Жұмыстан шығатын уақытым келгенде.
Dialogue: 0,0:10:44.22,0:10:47.08,CN,,0000,0000,0000,,Ересектердің көңілсіздігі, ергежейлі қанағатшылдығы
Dialogue: 0,0:10:48.85,0:10:51.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:52.23,0:10:54.98,CN,,0000,0000,0000,,Маған көлікті пайдаланудың қажеті жоқ.
Dialogue: 0,0:10:55.18,0:10:57.10,CN,,0000,0000,0000,,Матаны бояу керек.
Dialogue: 0,0:10:57.40,0:10:58.38,CN,,0000,0000,0000,,Тегін жеткізу
Dialogue: 0,0:10:59.74,0:11:01.83,CN,,0000,0000,0000,,Орта ғасырдағы метафоралық құштарлық
Dialogue: 0,0:11:02.38,0:11:05.23,CN,,0000,0000,0000,,Толассыз жауған жаңбырдың себебі де осы.
Dialogue: 0,0:11:06.28,0:11:07.55,CN,,0000,0000,0000,,Алдымен бізге келуіңіз керек.
Dialogue: 0,0:11:08.63,0:11:12.49,CN,,0000,0000,0000,,Мен басқа сөздер туралы ештеңе айтқан жоқпын.
Dialogue: 0,0:11:13.05,0:11:14.62,CN,,0000,0000,0000,,Бұл Нанайоши
Dialogue: 0,0:11:15.94,0:11:19.63,CN,,0000,0000,0000,,Менің үмітім зор.
Dialogue: 0,0:11:19.90,0:11:21.55,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:21.91,0:11:22.70,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:23.13,0:11:28.88,CN,,0000,0000,0000,,Бұл 100 күндік түнгі саяхат.
Dialogue: 0,0:11:29.97,0:11:30.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:31.45,0:11:32.77,CN,,0000,0000,0000,,Оны тек бір адам оқи алады.
Dialogue: 0,0:11:33.52,0:11:38.28,CN,,0000,0000,0000,,Менің үйленгенім туралы айту керек.
Dialogue: 0,0:11:39.50,0:11:42.29,CN,,0000,0000,0000,,Наото Иримия - менің арманым
Dialogue: 0,0:11:43.44,0:11:49.31,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:51.25,0:11:53.74,CN,,0000,0000,0000,,Менің әйеліммен және балаларыммен белгілі бір қарым-қатынасым бар.
Dialogue: 0,0:11:54.52,0:11:56.07,CN,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:11:57.82,0:12:01.05,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:01.70,0:12:04.48,CN,,0000,0000,0000,,Жастар оңды-солды болмау керек.
Dialogue: 0,0:12:05.18,0:12:08.14,CN,,0000,0000,0000,,Кейбір тұлғалардың өлеңдер жинағы
Dialogue: 0,0:12:08.57,0:12:09.89,CN,,0000,0000,0000,,Менің сізге көмектесуге мүмкіндігім жоқ.
Dialogue: 0,0:12:10.76,0:12:14.92,CN,,0000,0000,0000,,Сіз жақсы әйелі, балалары бар тыныш күйеусіз деп үміттенемін.
Dialogue: 0,0:12:15.78,0:12:19.98,CN,,0000,0000,0000,,Дегенмен, мен өмірімнің ортасында шағын әлем ауылымын.
Dialogue: 0,0:12:20.53,0:12:23.01,CN,,0000,0000,0000,,Менің ойым және өз дағдыларым
Dialogue: 0,0:12:24.36,0:12:26.79,CN,,0000,0000,0000,,Сарайда кездескенше
Dialogue: 0,0:12:27.67,0:12:30.94,CN,,0000,0000,0000,,Нари тілі қол жетімді емес, бірақ бұл Гинваканың жергілікті тілі.
Dialogue: 0,0:12:31.70,0:12:33.21,CN,,0000,0000,0000,,Мен әрине жолды білемін
Dialogue: 0,0:12:33.36,0:12:34.64,CN,,0000,0000,0000,,Сіз белгісіз жол емессіз
Dialogue: 0,0:12:35.50,0:12:37.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:37.95,0:12:40.29,CN,,0000,0000,0000,,Келгеннен кейін ғибадатханаға барудың қажеті жоқ
Dialogue: 0,0:12:40.67,0:12:42.82,CN,,0000,0000,0000,,Ойландыратын және сергітетін әңгіме: Өзін-өзі жою
Dialogue: 0,0:12:43.16,0:12:44.41,CN,,0000,0000,0000,,Маған демалу керек.
Dialogue: 0,0:12:44.81,0:12:46.23,CN,,0000,0000,0000,,Сарай тыңдап болған соң
Dialogue: 0,0:12:46.38,0:12:48.08,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:51.72,0:12:54.59,CN,,0000,0000,0000,,Ол жалғыз балалы қыз.
Dialogue: 0,0:12:57.85,0:13:01.89,CN,,0000,0000,0000,,Ерте көктемгі жапырақтар
Dialogue: 0,0:13:02.38,0:13:05.15,CN,,0000,0000,0000,,Ақ халатты кім?
Dialogue: 0,0:13:06.22,0:13:07.64,CN,,0000,0000,0000,,Бұл императордың жапонша өлеңі
Dialogue: 0,0:13:08.08,0:13:10.25,CN,,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,0:13:11.14,0:13:13.31,CN,,0000,0000,0000,,Туған күніңмен Вака (туған күніңмен де белгілі)
Dialogue: 0,0:13:14.11,0:13:16.35,CN,,0000,0000,0000,,Меймей - әйел.
Dialogue: 0,0:13:17.03,0:13:17.80,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:13:18.65,0:13:20.40,CN,,0000,0000,0000,,Император Йошико Соду
Dialogue: 0,0:13:20.47,0:13:23.05,CN,,0000,0000,0000,,Бұл ең зиянды адам Император Инай.
Dialogue: 0,0:13:23.86,0:13:26.13,CN,,0000,0000,0000,,Бұл ұсақ-түйек мәселе.
Dialogue: 0,0:13:27.57,0:13:32.00,CN,,0000,0000,0000,,Ол император Цунамудың ұлы.
Dialogue: 0,0:13:32.80,0:13:35.02,CN,,0000,0000,0000,,Сондықтан император болуы мүмкін
Dialogue: 0,0:13:35.53,0:13:39.10,CN,,0000,0000,0000,,Менің әкем менің әкем болғаны дұрыс емес.
Dialogue: 0,0:13:39.73,0:13:41.63,CN,,0000,0000,0000,,Императордың балалары
Dialogue: 0,0:13:41.89,0:13:44.69,CN,,0000,0000,0000,,Йошико қашан келді?
Dialogue: 0,0:13:45.49,0:13:46.93,CN,,0000,0000,0000,,Әйел император Фурё
Dialogue: 0,0:13:47.69,0:13:49.14,CN,,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:13:49.51,0:13:52.14,CN,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:13:53.14,0:13:56.71,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:59.05,0:14:03.92,CN,,0000,0000,0000,,Өлгеннен кейін сарайда болған императордың оқиғасы
Dialogue: 0,0:14:05.42,0:14:07.00,CN,,0000,0000,0000,,98 түн
Dialogue: 0,0:14:08.41,0:14:09.77,CN,,0000,0000,0000,,Киімді сынап көргеннен кейін
Dialogue: 0,0:14:18.41,0:14:20.76,CN,,0000,0000,0000,,Аспан салқын
Dialogue: 0,0:14:20.91,0:14:21.62,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:14:22.41,0:14:24.30,CN,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:14:24.39,0:14:29.46,CN,,0000,0000,0000,,Сәтсіздік мәселесі Жүз түн мың түн Ергежейлі қалаға бекініп, үлкенге.
Dialogue: 0,0:14:30.08,0:14:31.15,CN,,0000,0000,0000,,Мың түн...
Dialogue: 0,0:14:32.67,0:14:37.05,CN,,0000,0000,0000,,Йошико императорлық сарайы, фантастикалық Мацуха
Dialogue: 0,0:14:37.31,0:14:38.85,CN,,0000,0000,0000,,Менің оны көргім келмейді
Dialogue: 0,0:14:40.11,0:14:43.79,CN,,0000,0000,0000,,Әжем менің әкемнен туған.
Dialogue: 0,0:14:44.26,0:14:47.00,CN,,0000,0000,0000,,Төменгі деңгейдегі әйел шенеунікті жұмыстан шығару
Dialogue: 0,0:14:47.44,0:14:48.78,CN,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:14:49.70,0:14:51.70,CN,,0000,0000,0000,,Менімен бұл туралы сөйлескіңіз келсе, киіміңізді ауыстырыңыз.
Dialogue: 0,0:14:52.32,0:14:54.14,CN,,0000,0000,0000,,Киімді және әйел шенеунікті ешбір айырмашылықсыз ауыстыру
Dialogue: 0,0:14:54.91,0:14:56.40,CN,,0000,0000,0000,,Сіз әжесіз.
Dialogue: 0,0:14:56.89,0:14:58.15,CN,,0000,0000,0000,,Гогаяның өлімі
Dialogue: 0,0:14:58.65,0:14:59.90,CN,,0000,0000,0000,,Аритака-куга-га-кушу
Dialogue: 0,0:15:00.22,0:15:01.35,CN,,0000,0000,0000,,Өздігінен қабылданған шешім
Dialogue: 0,0:15:04.90,0:15:08.10,CN,,0000,0000,0000,,Күздің ақыры, жаңа фестиваль аяқталуға жақын.
Dialogue: 0,0:15:08.98,0:15:14.53,CN,,0000,0000,0000,,Алайда, ұлғайған сайын қаланы көру қиын.
Dialogue: 0,0:15:17.44,0:15:18.94,CN,,0000,0000,0000,,Қазір Теняның жүрегі жоқ.
Dialogue: 0,0:15:19.67,0:15:20.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:21.27,0:15:23.84,CN,,0000,0000,0000,,Төмендегі әңгімені оқыңыз.
Dialogue: 0,0:15:24.65,0:15:25.70,CN,,0000,0000,0000,,Қолжетімсіз
Dialogue: 0,0:15:28.13,0:15:30.29,CN,,0000,0000,0000,,Йошико сіздің қысқа мерзімді әңгімеңіз
Dialogue: 0,0:15:31.04,0:15:33.32,CN,,0000,0000,0000,,Император Сейко – ұлы тұлға.
Dialogue: 0,0:15:34.91,0:15:37.45,CN,,0000,0000,0000,,Баяғыда не болды?
Dialogue: 0,0:15:38.14,0:15:39.02,CN,,0000,0000,0000,,Өйткені сіз бұл туралы айтып отырсыз
Dialogue: 0,0:15:41.03,0:15:44.56,CN,,0000,0000,0000,,Мұның себептері қандай?
Dialogue: 0,0:15:45.17,0:15:48.63,CN,,0000,0000,0000,,Нәтижесінде, міне, растау
Dialogue: 0,0:15:49.34,0:15:50.21,CN,,0000,0000,0000,,Бұл сәл басқаша.
Dialogue: 0,0:15:51.12,0:15:52.47,CN,,0000,0000,0000,,Менің де үйленгім келеді
Dialogue: 0,0:15:53.39,0:15:56.28,CN,,0000,0000,0000,,Дұрыс себеп мынадай.
Dialogue: 0,0:15:56.93,0:15:58.48,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:58.60,0:16:00.07,CN,,0000,0000,0000,,Менің оқиғам: Бітірдің
Dialogue: 0,0:16:00.08,0:16:01.48,CN,,0000,0000,0000,,Жұмыс есеп жиналысының сыртқы түрі
Dialogue: 0,0:16:02.68,0:16:04.38,CN,,0000,0000,0000,,Менмендік
Dialogue: 0,0:16:04.89,0:16:06.55,CN,,0000,0000,0000,,Икуко Коя
Dialogue: 0,0:16:06.99,0:16:08.34,CN,,0000,0000,0000,,Өзіндік күш пайда болады
Dialogue: 0,0:16:08.78,0:16:09.82,CN,,0000,0000,0000,,Жарқырау
Dialogue: 0,0:16:10.28,0:16:12.58,CN,,0000,0000,0000,,Бұл рейс өте талантты әйел.
Dialogue: 0,0:16:13.63,0:16:17.33,CN,,0000,0000,0000,,Алайда мен мұнда келгеннен бері мені әлдебір таланттар қауымдастығы өлтірді.
Dialogue: 0,0:16:18.18,0:16:21.32,CN,,0000,0000,0000,,Абсолютті озық дағдылар мен білімді меңгеру
Dialogue: 0,0:16:21.77,0:16:24.20,CN,,0000,0000,0000,,Сондай-ақ, мен оны тастап кетуге мүмкіндік бар ма, жоқ па
Dialogue: 0,0:16:25.02,0:16:27.79,CN,,0000,0000,0000,,Менің әр түрлі қабілеттерім келіп-кетсе, жарық ағыны сөнеді.
Dialogue: 0,0:16:28.96,0:16:30.94,CN,,0000,0000,0000,,Мен осылай айтамын, заңсыз қалай.
Dialogue: 0,0:16:32.36,0:16:36.31,CN,,0000,0000,0000,,Менің тек негізгі өмірім бар.
Dialogue: 0,0:16:36.89,0:16:39.97,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:41.00,0:16:44.71,CN,,0000,0000,0000,,Сіз ер адамның әңгімесісіз.
Dialogue: 0,0:16:45.48,0:16:46.69,CN,,0000,0000,0000,,Алайда бұл әйел.
Dialogue: 0,0:16:47.10,0:16:48.24,CN,,0000,0000,0000,,Дегенмен ол әдемі адам\N40-бөлім
Dialogue: 0,0:16:49.72,0:16:54.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:55.21,0:16:56.40,CN,,0000,0000,0000,,Мен жоққа шығармаймын
Dialogue: 0,0:16:56.98,0:17:00.10,CN,,0000,0000,0000,,Қазіргі уақытта әйелдер осылай жұмыс істейді.
Dialogue: 0,0:17:00.91,0:17:03.49,CN,,0000,0000,0000,,Қаланы көрмей көре алмайсың.
Dialogue: 0,0:17:04.52,0:17:07.07,CN,,0000,0000,0000,,Бір мақаланы таңдағың келмесе, тікенді жол.
Dialogue: 0,0:17:07.81,0:17:10.13,CN,,0000,0000,0000,,Бақытқа ұмтылмау керек.
Dialogue: 0,0:17:10.13,0:17:10.98,CN,,0000,0000,0000,,Мен бақытты болатыныма сенімдімін
Dialogue: 0,0:17:11.57,0:17:13.53,CN,,0000,0000,0000,,Дегенмен, бұл жеке адамның садақасы емес.
Dialogue: 0,0:17:14.19,0:17:16.72,CN,,0000,0000,0000,,Мен өз мүмкіндігім мен бақытыма ұмтылғым келеді.
Dialogue: 0,0:17:17.50,0:17:21.18,CN,,0000,0000,0000,,Маған жалғыз болу керек емес, жалғыз болу керек емес.
Dialogue: 0,0:17:22.05,0:17:26.07,CN,,0000,0000,0000,,Мен бір нәрсені білген сайын, мен табысқа жетемін деп үміттенемін және менің жүрегім күшті.
Dialogue: 0,0:17:26.45,0:17:28.25,CN,,0000,0000,0000,,Мен оны пайдаланғым келмейді.
Dialogue: 0,0:17:31.35,0:17:33.40,CN,,0000,0000,0000,,Өткен түнгі жұмыс өте сәтті болды.
Dialogue: 0,0:17:33.98,0:17:36.00,CN,,0000,0000,0000,,Ой толғаныс бұрынғыдай күшті
Dialogue: 0,0:17:37.17,0:17:38.76,CN,,0000,0000,0000,,Қалаға тура бармау
Dialogue: 0,0:17:39.13,0:17:41.66,CN,,0000,0000,0000,,Діни ересек Діни ересек
Dialogue: 0,0:17:42.17,0:17:43.60,CN,,0000,0000,0000,,Жақсы
Dialogue: 0,0:17:45.24,0:17:46.94,CN,,0000,0000,0000,,НАСА табысы туралы әңгімелер
Dialogue: 0,0:17:47.17,0:17:48.54,CN,,0000,0000,0000,,Ғибадатханадағы Чуя Нох әлі тірі.
Dialogue: 0,0:17:53.94,0:17:55.59,CN,,0000,0000,0000,,Өткенде ғана емес…
Dialogue: 0,0:17:56.65,0:18:00.88,CN,,0000,0000,0000,,Ғибадатхананың кіреберісі ғибадатхананың ортасында екені анық емес.
Dialogue: 0,0:18:07.22,0:18:10.72,CN,,0000,0000,0000,,Бұл үлкен жаңбырдың шынайы бейнесі.
Dialogue: 0,0:18:11.76,0:18:13.32,CN,,0000,0000,0000,,Бұл алғашқы жүз түн.
Dialogue: 0,0:18:15.26,0:18:17.74,CN,,0000,0000,0000,,Мен бүгін түнде не істей алатынымды көре алмаймын.
Dialogue: 0,0:18:20.63,0:18:22.52,CN,,0000,0000,0000,,Алғашқы жүз түннің соңы
Dialogue: 0,0:18:22.77,0:18:24.64,CN,,0000,0000,0000,,Өмірімнің соңына келдім
Dialogue: 0,0:18:25.07,0:18:27.07,CN,,0000,0000,0000,,Сізбен тікелей байланыс туралы қандай шындық бар?
Dialogue: 0,0:18:27.41,0:18:31.62,CN,,0000,0000,0000,,Менің ең үлкен тілегім - ересек адам сияқты сүю қабілетіне ие болу.
Dialogue: 0,0:18:34.35,0:18:35.70,CN,,0000,0000,0000,,Жақсы нәтижемен кездесу
Dialogue: 0,0:18:41.35,0:18:42.50,CN,,0000,0000,0000,,Заңды тұлға
Dialogue: 0,0:18:46.24,0:18:47.78,CN,,0000,0000,0000,,Гор кетіп қалды
Dialogue: 0,0:18:48.08,0:18:51.80,CN,,0000,0000,0000,,Өзендегі су деңгейінің кенет көтерілуіне байланысты көпірдің су астында қалғаны расталды.
Dialogue: 0,0:18:52.33,0:18:54.02,CN,,0000,0000,0000,,Өгіз көлігі үрейленіп келді, бірақ...
Dialogue: 0,0:18:56.90,0:18:59.22,CN,,0000,0000,0000,,Йошико сіңлісі Юури
Dialogue: 0,0:18:59.60,0:19:00.88,CN,,0000,0000,0000,,Мен де кеттім
Dialogue: 0,0:19:00.97,0:19:01.57,CN,,0000,0000,0000,,3-бөлім: Түрмедегі бандиттермен кездесу
Dialogue: 0,0:19:01.65,0:19:02.37,CN,,0000,0000,0000,,Өзін-өзі босату
Dialogue: 0,0:19:12.77,0:19:14.19,CN,,0000,0000,0000,,Мен оны көріп тұрмын.
Dialogue: 0,0:19:14.87,0:19:17.76,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:19.00,0:19:20.57,CN,,0000,0000,0000,,Жол келгеннен бері қатты жаңбыр жауған жоқ.
Dialogue: 0,0:19:21.02,0:19:22.99,CN,,0000,0000,0000,,Көпір жабық, өгіз көлігі дұрыс емес...
Dialogue: 0,0:19:23.40,0:19:25.42,CN,,0000,0000,0000,,1000 данадан кейін қашып құтылдым.
Dialogue: 0,0:19:25.97,0:19:26.96,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:28.81,0:19:32.69,CN,,0000,0000,0000,,Жағымсыз ниет Көлік жүргізушісі ауруханада, бірден жұмысқа орналастым, т.б.
Dialogue: 0,0:19:33.01,0:19:34.06,CN,,0000,0000,0000,,Жақсы
Dialogue: 0,0:19:34.36,0:19:36.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:36.44,0:19:37.57,CN,,0000,0000,0000,,Мен сендерге ыстық су дайындап қойдым.
Dialogue: 0,0:19:37.77,0:19:40.75,CN,,0000,0000,0000,,және т.б.
Dialogue: 0,0:19:43.14,0:19:44.87,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:45.60,0:19:47.18,CN,,0000,0000,0000,,Шынайы мағынасы Йошико
Dialogue: 0,0:19:47.68,0:19:48.54,CN,,0000,0000,0000,,Аняның үйіне қош келдіңіз
Dialogue: 0,0:19:48.95,0:19:50.53,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:50.83,0:19:52.64,CN,,0000,0000,0000,,Жарақат туралы айтқанда
Dialogue: 0,0:19:52.89,0:19:54.91,CN,,0000,0000,0000,,Әскерге кірген кездегі қауіпті жағдай
Dialogue: 0,0:19:55.24,0:19:56.58,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:19:57.58,0:19:59.21,CN,,0000,0000,0000,,Жылаудың қажеті жоқ.
Dialogue: 0,0:20:02.21,0:20:04.76,CN,,0000,0000,0000,,Қай жерде екеніңізді көру оңай.
Dialogue: 0,0:20:05.41,0:20:06.25,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:20:06.28,0:20:07.00,CN,,0000,0000,0000,,Лол ойнаңыз
Dialogue: 0,0:20:07.80,0:20:08.92,CN,,0000,0000,0000,,Көз жасымен сұлусың
Dialogue: 0,0:20:15.41,0:20:16.14,CN,,0000,0000,0000,,Кешір мені.
Dialogue: 0,0:20:20.22,0:20:20.64,CN,,0000,0000,0000,,Өткен
Dialogue: 0,0:20:24.39,0:20:25.66,CN,,0000,0000,0000,,Әлі де табыс жоқ па?
Dialogue: 0,0:20:26.61,0:20:29.16,CN,,0000,0000,0000,,Бұл жүз түн.
Dialogue: 0,0:20:30.44,0:20:31.32,CN,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:20:32.81,0:20:34.92,CN,,0000,0000,0000,,Қуанышты қуаныш
Dialogue: 0,0:20:35.48,0:20:37.00,CN,,0000,0000,0000,,Уақыты келгенде, Мен бақытты боламын
Dialogue: 0,0:20:37.31,0:20:38.15,CN,,0000,0000,0000,,Натаюя…
Dialogue: 0,0:20:40.03,0:20:42.63,CN,,0000,0000,0000,,100 түн
Dialogue: 0,0:20:43.50,0:20:48.39,CN,,0000,0000,0000,,Сіздің болашағыңыз туралы не ойлайсыз?
Dialogue: 0,0:20:49.64,0:20:55.21,CN,,0000,0000,0000,,Алайда мен өзімшіл арманмын.
Dialogue: 0,0:20:56.84,0:20:59.73,CN,,0000,0000,0000,,Бұл махаббатым үшін өкінемін.
Dialogue: 0,0:21:00.31,0:21:01.01,CN,,0000,0000,0000,,Кешір мені.
Dialogue: 0,0:21:02.06,0:21:05.60,CN,,0000,0000,0000,,Мен осы кеште жұмыс істеп жатырмын.
Dialogue: 0,0:21:06.45,0:21:06.82,CN,,0000,0000,0000,,3-бөлім: Түрмедегі бандиттермен кездесу
Dialogue: 0,0:21:06.88,0:21:07.28,CN,,0000,0000,0000,,Керіскерлер тобы
Dialogue: 0,0:21:08.26,0:21:12.03,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:25.31,0:21:26.06,CN,,0000,0000,0000,,Гор
Dialogue: 0,0:21:28.01,0:21:28.88,CN,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:21:29.84,0:21:32.35,CN,,0000,0000,0000,,Бұл Йошико
Dialogue: 0,0:21:36.52,0:21:38.71,CN,,0000,0000,0000,,Тоқсан тоғыз түн
Dialogue: 0,0:21:39.07,0:21:42.06,CN,,0000,0000,0000,,Сіз оны келесі күннің соңына дейін ұстай алмайсыз.
Dialogue: 0,0:21:42.52,0:21:43.59,CN,,0000,0000,0000,,Менің мүмкіндігім бар.
Dialogue: 0,0:21:44.15,0:21:47.18,CN,,0000,0000,0000,,Жаңбыр астында кету туралы айтуға болады, бірақ оған кепілдік берілмейді.
Dialogue: 0,0:21:47.44,0:21:48.11,CN,,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:21:48.78,0:21:51.92,CN,,0000,0000,0000,,Шиннё сектасының қателіктері
Dialogue: 0,0:21:52.30,0:21:55.90,CN,,0000,0000,0000,,Шынында да әдемі ересектер сияқты сұлулық
Dialogue: 0,0:21:57.89,0:22:00.71,CN,,0000,0000,0000,,Бұл негізінен көз біткеннен кейінгі бірінші генералдың сұлулығы.
Dialogue: 0,0:22:02.34,0:22:12.31,&,,0000,0000,0000,,Цудзимай қызы Мияя
Dialogue: 0,0:22:04.26,0:22:12.31,&,,0000,0000,0000,,...
Dialogue: 0,0:22:05.17,0:22:12.31,&,,0000,0000,0000,,Алайда желді жол кесілген.
Dialogue: 0,0:22:06.92,0:22:12.31,&,,0000,0000,0000,,Өлмейтін пішін әрқашан адамдар арасында болады
Dialogue: 0,0:22:11.79,0:22:17.54,CN,,0000,0000,0000,,Шарасыз жел соққан пері жолы
Dialogue: 0,0:22:18.96,0:22:22.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:25.08,0:22:27.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:28.75,0:22:31.73,CN,,0000,0000,0000,,Бақыт мерекесі
Dialogue: 0,0:22:34.27,0:22:36.26,CN,,0000,0000,0000,,Йошико жұмыста киім ауыстырып жатыр
Dialogue: 0,0:22:37.80,0:22:41.10,CN,,0000,0000,0000,,Оно но Комачи қайтып келеді
Dialogue: 0,0:24:14.93,0:24:30.03,&,,0000,0000,0000,,Казухэй Ясухиде
Dialogue: 0,0:24:14.93,0:24:30.03,,,0000,0000,0000,,Ясухиде Буня
Dialogue: 0,0:24:16.96,0:24:21.41,CN,,0000,0000,0000,,Тау желінің күзгі шөптері
Dialogue: 0,0:24:22.55,0:24:26.06,CN,,0000,0000,0000,,Орманда жел мен жаңбыр жоғалады
Dialogue: 0,0:24:31.53,0:24:37.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory