Dialogue: 0,0:00:04.02,0:00:05.24,JP2,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:00:05.69,0:00:08.74,JP2,,0000,0000,0000,,Бұл Хэйан полициясының арнайы тергеу бөлімінің қызметкері Теии Фудзивара.
Dialogue: 0,0:00:08.92,0:00:10.46,JP2,,0000,0000,0000,,Бұл менің серіктесім.
Dialogue: 0,0:00:11.30,0:00:12.87,JP2,,0000,0000,0000,,Бұл сот сараптамасы үшін Йорицуна.
Dialogue: 0,0:00:13.57,0:00:16.20,JP2,,0000,0000,0000,,Тейка мырза, мынаны қарап шығуыңызды өтінемін?
Dialogue: 0,0:00:20.75,0:00:23.03,JP2,,0000,0000,0000,,Бұл адам, Юкинари Фудзивара,
Dialogue: 0,0:00:23.16,0:00:25.99,JP2,,0000,0000,0000,,Бала кезінен күлмеген дейді.
Dialogue: 0,0:00:26.41,0:00:28.73,JP2,,0000,0000,0000,,Йорицуна-кун, бұл рас па?
Dialogue: 0,0:00:29.05,0:00:31.21,JP2,,0000,0000,0000,,Дәлелдер әлі де жеткіліксіз болғанымен
Dialogue: 0,0:00:31.81,0:00:34.39,JP2,,0000,0000,0000,,Жарайды, зерттеп көрейік.
Dialogue: 0,0:02:17.19,0:02:22.21,JP2,,0000,0000,0000,,Әкем Йошитака Фудзивара жастай қайтыс болғанда мен үш жаста едім.
Dialogue: 0,0:02:23.13,0:02:26.39,JP2,,0000,0000,0000,,Жақсы мінезді, тамаша ақын болған деседі.
Dialogue: 0,0:02:27.43,0:02:28.80,JP2,,0000,0000,0000,,Айналадағылардан да үміт күтті.
Dialogue: 0,0:02:29.05,0:02:31.68,JP2,,0000,0000,0000,,Ән айтуды үйренуге басқаларға қарағанда көбірек тырыстым.
Dialogue: 0,0:02:32.50,0:02:36.82,JP2,,0000,0000,0000,,Жарайды, мен мұны өте жақсы білемін, бірақ бұл туралы.
Dialogue: 0,0:02:37.37,0:02:41.05,JP2,,0000,0000,0000,,Менің әкемдей емес, ән айту қабілетім жоқ еді.
Dialogue: 0,0:02:48.01,0:02:49.53,JP2,,0000,0000,0000,,Қайырлы таң Юкинари-кун
Dialogue: 0,0:02:50.99,0:02:53.10,JP2,,0000,0000,0000,,Қайырлы таң, Сайнобу мырза
Dialogue: 0,0:02:53.58,0:02:55.24,JP2,,0000,0000,0000,,Сіз әрқашан ертесіз.
Dialogue: 0,0:02:55.84,0:02:57.75,JP2,,0000,0000,0000,,Жұмысқа тез үйренгім келді.
Dialogue: 0,0:02:58.20,0:02:59.42,JP2,,0000,0000,0000,,Сіз байыптысыз.
Dialogue: 0,0:03:00.14,0:03:03.24,JP2,,0000,0000,0000,,Шынымен, ортадағы храмдағы сарайға бірге барайық.
Dialogue: 0,0:03:03.49,0:03:04.44,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:03:04.66,0:03:08.22,JP2,,0000,0000,0000,,Әй, Цишин мырза, қайырлы таң.
Dialogue: 0,0:03:08.22,0:03:09.16,JP2,,0000,0000,0000,,Иә, қайырлы таң
Dialogue: 0,0:03:09.26,0:03:12.14,JP2,,0000,0000,0000,,О, Юкинари-сама да бүгін бізбен бірге.
Dialogue: 0,0:03:13.98,0:03:17.49,JP2,,0000,0000,0000,,Юкинари-кун, сіз сәл мейірімдірек болуыңыз керек.
Dialogue: 0,0:03:18.90,0:03:21.02,JP2,,0000,0000,0000,,Жұмысқа байланысты ішкі сарайға жиі келіп-кетемін.
Dialogue: 0,0:03:21.41,0:03:23.85,JP2,,0000,0000,0000,,Әйелдермен жақсы араласпасаңыз, олар қиын болуы мүмкін.
Dialogue: 0,0:03:26.31,0:03:30.29,JP2,,0000,0000,0000,,Мен әкемнен ерте айырылдым, талай қиындықтан соң ақыры осы дәрежеге жеттім.
Dialogue: 0,0:03:30.78,0:03:33.14,JP2,,0000,0000,0000,,Ақылсыз нәрсе үшін өз беделіңді түсіру қызықсыз болар еді.
Dialogue: 0,0:03:34.21,0:03:36.60,JP2,,0000,0000,0000,,Бүгін мен сендерді жақсы әйелмен таныстырамын.
Dialogue: 0,0:03:37.49,0:03:38.96,JP2,,0000,0000,0000,,Бұл Уметсубодағы Сей Шонагон.
Dialogue: 0,0:03:39.90,0:03:42.17,JP2,,0000,0000,0000,,Мотосуке Киёхараның қызы.
Dialogue: 0,0:03:42.91,0:03:45.52,JP2,,0000,0000,0000,,А, мен Садако-самаға үлкен сенім артамын.
Dialogue: 0,0:03:45.87,0:03:48.28,JP2,,0000,0000,0000,,Ол ақылды әйел, сондықтан сеніммен нәрселерді сұрауға болады.
Dialogue: 0,0:03:49.20,0:03:53.48,JP2,,0000,0000,0000,,Оның үстіне, бұл әйелдің хоббиі достарын мақтау.
Dialogue: 0,0:03:54.37,0:03:56.31,JP2,,0000,0000,0000,,Дос болудың зияны жоқ
Dialogue: 0,0:04:00.58,0:04:01.93,JP2,,0000,0000,0000,,Шонагонға хабарласыңыз.
Dialogue: 0,0:04:03.29,0:04:06.32,JP2,,0000,0000,0000,,Ол атақты ақын Мотосукенің қызы ма?
Dialogue: 0,0:04:07.64,0:04:10.20,JP2,,0000,0000,0000,,Біреу маған ән жазып көрсе, қиын болар еді.
Dialogue: 0,0:04:10.38,0:04:11.42,JP2,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:04:12.64,0:04:14.50,JP2,,0000,0000,0000,,Маған таңертең ерте қоңырау шалыңыз.
Dialogue: 0,0:04:14.80,0:04:17.83,JP2,,0000,0000,0000,,Кешіріңіз, мен сізбен кездескім келетін адам бар.
Dialogue: 0,0:04:18.45,0:04:22.13,JP2,,0000,0000,0000,,Бұл Юкинари Фудзивара, Курадоның жаңадан тағайындалған басшысы.
Dialogue: 0,0:04:23.70,0:04:27.55,JP2,,0000,0000,0000,,Әй, вокзал толқуға толы болды.
Dialogue: 0,0:04:27.90,0:04:30.88,JP2,,0000,0000,0000,,Сіз тек мені таныстырған кезде мен өзімді жайсыз сезінемін.
Dialogue: 0,0:04:31.20,0:04:32.74,JP2,,0000,0000,0000,,Халықтық кезең келді.
Dialogue: 0,0:04:33.09,0:04:36.08,JP2,,0000,0000,0000,,Мен талғамы да, мінез-құлқы да жоқ дөрекі адаммын.
Dialogue: 0,0:04:36.22,0:04:37.59,JP2,,0000,0000,0000,,Біз сіздің үміттеріңізді ақтай алмаймыз.
Dialogue: 0,0:04:38.14,0:04:39.28,JP2,,0000,0000,0000,,Өзіңізді кішірейтіңіз
Dialogue: 0,0:04:39.65,0:04:43.36,JP2,,0000,0000,0000,,Лорд Кентокудың отбасында көптеген көрнекті адамдар болған.
Dialogue: 0,0:04:43.61,0:04:45.79,JP2,,0000,0000,0000,,Сіздің ән айту қабілетіңіз бар ма?
Dialogue: 0,0:04:46.41,0:04:49.02,JP2,,0000,0000,0000,,Жоқ.Шынымды айтсам, мен ән айтудан жақсы емеспін.
Dialogue: 0,0:04:49.30,0:04:51.21,JP2,,0000,0000,0000,,Бейшара жанама махаббат та көріксіз.
Dialogue: 0,0:04:51.78,0:04:52.78,JP2,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:04:53.85,0:04:58.10,JP2,,0000,0000,0000,,Қараңдаршы, менің отбасымда ақын болу құрметі арғы атамнан бастау алған.
Dialogue: 0,0:04:58.34,0:05:01.03,JP2,,0000,0000,0000,,Ата-анасы жақсы болса, балаға қиналады, солай ма?
Dialogue: 0,0:05:01.20,0:05:04.36,JP2,,0000,0000,0000,,Әкемнің атақ-даңқы үшін осында отырмын деп ойлаймын.
Dialogue: 0,0:05:04.66,0:05:07.22,JP2,,0000,0000,0000,,Осыны айтып, ата-анамның көмегімен
Dialogue: 0,0:05:07.32,0:05:09.90,JP2,,0000,0000,0000,,Ақымақтың өзіндікі сияқты әрекет ету ұят емес пе?
Dialogue: 0,0:05:11.12,0:05:11.89,JP2,,0000,0000,0000,,Мен келісемін.
Dialogue: 0,0:05:12.86,0:05:15.97,JP2,,0000,0000,0000,,Әнімді нашар айтып, ата-анамның атына кір келтіргім келмейді.
Dialogue: 0,0:05:17.31,0:05:18.33,JP2,,0000,0000,0000,,Ах~ Ол тірі!
Dialogue: 0,0:05:19.30,0:05:20.89,JP2,,0000,0000,0000,,Сәлем Юкинари-сама
Dialogue: 0,0:05:21.33,0:05:23.57,JP2,,0000,0000,0000,,Мүмкін дос болып қалармыз
Dialogue: 0,0:05:24.32,0:05:26.80,JP2,,0000,0000,0000,,Ән айтқанды жек көремін, өтірік болмаса
Dialogue: 0,0:05:28.96,0:05:30.70,JP2,,0000,0000,0000,,Мен шынымен ән айтуда жақсы емеспін.
Dialogue: 0,0:05:31.90,0:05:34.04,JP2,,0000,0000,0000,,Бұл менің Сей Шонагонмен кездесуім болды.
Dialogue: 0,0:05:39.95,0:05:42.04,JP2,,0000,0000,0000,,Шонагонмен жақсы араласатын сияқтысың.
Dialogue: 0,0:05:42.36,0:05:43.58,JP2,,0000,0000,0000,,Жақсы, жақсы.
Dialogue: 0,0:05:44.23,0:05:45.79,JP2,,0000,0000,0000,,Әйелдер шағымданды.
Dialogue: 0,0:05:46.93,0:05:49.99,JP2,,0000,0000,0000,,Сіз тек оның араша болуын сұрайсыз.
Dialogue: 0,0:05:50.74,0:05:51.58,JP2,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:05:51.78,0:05:53.50,JP2,,0000,0000,0000,,Эй, бұл Санеката-доно.
Dialogue: 0,0:05:54.39,0:05:56.08,JP2,,0000,0000,0000,,Сіз Санеката Фудзивара мырзасыз ба?
Dialogue: 0,0:05:56.40,0:05:58.64,JP2,,0000,0000,0000,,А, ол көркем адам болса керек.
Dialogue: 0,0:05:59.51,0:06:00.85,JP2,,0000,0000,0000,,Шонагонның бұрынғы жігіті.
Dialogue: 0,0:06:02.89,0:06:05.75,JP2,,0000,0000,0000,,Бұрын шие гүлдерін тамашалап отырып, жаңбырға түсіп қалғанмын.
Dialogue: 0,0:06:06.22,0:06:09.70,JP2,,0000,0000,0000,,Барлығы қашып бара жатқанда, жаңбыр астында жалғыз қалдым.
Dialogue: 0,0:06:11.17,0:06:14.82,JP2,,0000,0000,0000,,Сакургари Аме ва Фурикину Дәл солай
Dialogue: 0,0:06:15.22,0:06:17.98,JP2,,0000,0000,0000,,Нурутомо гүлдің көлеңкесіне тығылады
Dialogue: 0,0:06:19.42,0:06:22.90,JP2,,0000,0000,0000,,Жаңбырда суланайын десем, шие гүлінің түбіне суланғаным артық.
Dialogue: 0,0:06:23.40,0:06:25.41,JP2,,0000,0000,0000,,Иә, мен ескі әнді ызылдадым
Dialogue: 0,0:06:28.09,0:06:30.13,JP2,,0000,0000,0000,,Бұл демонстрация керемет болды.
Dialogue: 0,0:06:30.58,0:06:31.45,JP2,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:06:32.96,0:06:37.07,JP2,,0000,0000,0000,,Мен үшін бұл ойдан шығарылған және өте дәмсіз болып көрінеді.
Dialogue: 0,0:06:37.41,0:06:39.80,JP2,,0000,0000,0000,,Жоқ, ол мұны істегенде керемет көрінеді.
Dialogue: 0,0:06:40.42,0:06:42.71,JP2,,0000,0000,0000,,Жаңбырдан пана да таппай, суланып кеттім.
Dialogue: 0,0:06:43.03,0:06:44.89,JP2,,0000,0000,0000,,Санеката-сама - ақымақ.
Dialogue: 0,0:06:45.27,0:06:48.00,JP2,,0000,0000,0000,,Әй, эй, сен сондай сұм адамсың.
Dialogue: 0,0:06:48.27,0:06:50.11,JP2,,0000,0000,0000,,Мен жай ғана фактілерді айтып отырмын.
Dialogue: 0,0:06:51.48,0:06:55.88,JP2,,0000,0000,0000,,Көремін, Юкинари-кун біршама алға жылжыды.
Dialogue: 0,0:06:56.18,0:06:57.64,JP2,,0000,0000,0000,,Мен сені ренжіттім бе?
Dialogue: 0,0:06:57.82,0:07:00.18,JP2,,0000,0000,0000,,Жоқ, маған қатты әсер етті.
Dialogue: 0,0:07:00.70,0:07:01.67,JP2,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:07:02.47,0:07:04.80,JP2,,0000,0000,0000,,Мен Конин-самаға хабар тапсырдым.
Dialogue: 0,0:07:05.05,0:07:07.24,JP2,,0000,0000,0000,,Ішімізді тыңдайық. Кіріңіз.
Dialogue: 0,0:07:07.46,0:07:08.06,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:07:12.98,0:07:14.20,JP2,,0000,0000,0000,,я Юкинари
Dialogue: 0,0:07:14.55,0:07:19.22,JP2,,0000,0000,0000,,Мен жаңа ғана сен ақымақ деп айтқан Санекатамен сені сөйлестім.
Dialogue: 0,0:07:20.68,0:07:23.14,JP2,,0000,0000,0000,,Императрица Сатояшикиге келуімді өтінді.
Dialogue: 0,0:07:23.57,0:07:26.43,JP2,,0000,0000,0000,,Ал, отыр, сөйлесейік.
Dialogue: 0,0:07:26.57,0:07:28.54,JP2,,0000,0000,0000,,Жоқ, менің басқа істерім бар.
Dialogue: 0,0:07:28.81,0:07:31.37,JP2,,0000,0000,0000,,Көп уақыт болмайды, жарай ма?
Dialogue: 0,0:07:31.60,0:07:32.66,JP2,,0000,0000,0000,,Ресми тағайындау
Dialogue: 0,0:07:33.46,0:07:35.00,JP2,,0000,0000,0000,,Бұл тым көп еркелік.
Dialogue: 0,0:07:35.42,0:07:38.23,JP2,,0000,0000,0000,,Мұндай арандатушылықты ол да, мен де қабылдамас едік.
Dialogue: 0,0:07:38.50,0:07:39.72,JP2,,0000,0000,0000,,Бұл ұят
Dialogue: 0,0:07:39.90,0:07:42.23,JP2,,0000,0000,0000,,Кетер алдында ойын-сауық болар деп ойладым.
Dialogue: 0,0:07:42.75,0:07:44.05,JP2,,0000,0000,0000,,Сіз кетесіз бе?
Dialogue: 0,0:07:44.52,0:07:46.28,JP2,,0000,0000,0000,,Мен жақында Муцуға барамын.
Dialogue: 0,0:07:46.76,0:07:47.73,JP2,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:07:49.14,0:07:52.62,JP2,,0000,0000,0000,,Конин жай ғана бұзақы адам, бірақ жүрегінде ол жақсы жігіт.
Dialogue: 0,0:07:53.29,0:07:54.49,JP2,,0000,0000,0000,,Маған мейірімді болыңыз
Dialogue: 0,0:07:56.77,0:08:01.62,JP2,,0000,0000,0000,,Ол ересек адам. Қорлыққа мән бермейді, жүріс-тұрысы да сымбатты.
Dialogue: 0,0:07:56.75,0:07:58.39,JP2-,,0000,0000,0000,,Кешіріңіз, әпкем...
Dialogue: 0,0:08:03.36,0:08:05.52,JP2,,0000,0000,0000,,Бұл Шонагонның бұрынғы ғашығы
Dialogue: 0,0:08:10.52,0:08:14.89,JP2,,0000,0000,0000,,Кешіріңіз, мен сізді менің соңымнан келе жатыр деп ойламадым...
Dialogue: 0,0:08:24.01,0:08:25.58,JP2,,0000,0000,0000,,Ю Юкинари
Dialogue: 0,0:08:27.32,0:08:30.05,JP2,,0000,0000,0000,,Бұл туралы уайымдамаңыз.
Dialogue: 0,0:08:35.35,0:08:36.96,JP2,,0000,0000,0000,,Әлгі жігіт көңілді екен
Dialogue: 0,0:08:38.80,0:08:41.71,JP2,,0000,0000,0000,,Сіз ашуланбау үшін керемет жұмыс жасадыңыз.
Dialogue: 0,0:08:42.26,0:08:44.24,JP2,,0000,0000,0000,,Бұл туралы ұмытыңыз.
Dialogue: 0,0:08:44.47,0:08:48.59,JP2,,0000,0000,0000,,Бұл мүмкін емес. Сарай қазір бұл туралы қауесетке толы.
Dialogue: 0,0:08:48.99,0:08:53.91,JP2,,0000,0000,0000,,Әкем бірде аттан құлап, тәжінен айырылып қалды.
Dialogue: 0,0:08:54.11,0:08:55.58,JP2,,0000,0000,0000,,Бірақ мүлде үрейленбеңіз
Dialogue: 0,0:08:55.83,0:08:59.53,JP2,,0000,0000,0000,,Ол: «Мен тақырмын, сондықтан тәжімнің түсуі қалыпты жағдай» деді.
Dialogue: 0,0:08:59.80,0:09:01.19,JP2,,0000,0000,0000,,Мен таз емеспін
Dialogue: 0,0:09:01.44,0:09:04.23,JP2,,0000,0000,0000,,Қалай болғанда да, қысылғанда өзіңді осылай ұстайсың.
Dialogue: 0,0:09:04.40,0:09:06.02,JP2,,0000,0000,0000,,Адамның шынайы құндылығы сыналады
Dialogue: 0,0:09:06.59,0:09:09.99,JP2,,0000,0000,0000,,Бұл сіздің ер адам ретінде өткеніңізді білдіреді.
Dialogue: 0,0:09:10.54,0:09:12.03,JP2,,0000,0000,0000,,Олай болса, маған сыйлық беріңіз.
Dialogue: 0,0:09:13.35,0:09:15.91,JP2,,0000,0000,0000,,Сол желдеткішті алып тастап, бетіңізді көрсетіңіз.
Dialogue: 0,0:09:16.11,0:09:18.32,JP2,,0000,0000,0000,,Нені сонша ақымақ айтып тұрсың?
Dialogue: 0,0:09:18.32,0:09:19.96,JP2,,0000,0000,0000,,Бұл жұмыс істемейтініне сенімдімін
Dialogue: 0,0:09:20.43,0:09:21.38,JP2,,0000,0000,0000,,Жай әзіл.
Dialogue: 0,0:09:22.07,0:09:25.18,JP2,,0000,0000,0000,,Сіз әзіл айтып тұрсыз.
Dialogue: 0,0:09:25.75,0:09:28.76,JP2,,0000,0000,0000,,Шонагон әрқашан белгілі бір сызық сызды.
Dialogue: 0,0:09:30.70,0:09:32.86,JP2,,0000,0000,0000,,Көп ұзамай жыл аяқталды
Dialogue: 0,0:09:33.21,0:09:34.35,JP2,,0000,0000,0000,,Оқиға болды
Dialogue: 0,0:09:37.06,0:09:40.86,JP2,,0000,0000,0000,,Садако Чугудың ағасы абайсызда Рим папасына жебені атып алды.
Dialogue: 0,0:09:41.51,0:09:42.80,JP2,,0000,0000,0000,,Ол үшін жауапкершілікті алу
Dialogue: 0,0:09:45.86,0:09:48.79,JP2,,0000,0000,0000,,Тейко ханым әлі императордың ұлына жүкті.
Dialogue: 0,0:09:50.06,0:09:51.80,JP2,,0000,0000,0000,,Ол сарайдан шығып кетті.
Dialogue: 0,0:09:54.66,0:09:57.36,JP2,,0000,0000,0000,,Тіпті Накагуанпаку отбасы да мұндай күшпен мақтанатын.
Dialogue: 0,0:09:57.41,0:10:00.22,JP2,,0000,0000,0000,,Мичитака-самасыз тұрақты құлдырау болады.
Dialogue: 0,0:10:00.40,0:10:05.29,JP2,,0000,0000,0000,,Мичинага-сама Садако-самадан бас тартып, өз қызын патшайым еткісі келетін сияқты.
Dialogue: 0,0:10:06.41,0:10:09.54,JP2,,0000,0000,0000,,Сей Шонагон ақыры өз ауылына оралды.
Dialogue: 0,0:10:09.67,0:10:12.38,JP2,,0000,0000,0000,,Күтілгендей, бұл бұдан былай Мичинага-сама болады.
Dialogue: 0,0:10:20.60,0:10:21.47,JP2,,0000,0000,0000,,Құрметті Наоко
Dialogue: 0,0:10:22.07,0:10:22.72,JP2,,0000,0000,0000,,Не?
Dialogue: 0,0:10:23.06,0:10:26.02,JP2,,0000,0000,0000,,Юкинари Фудзивара мырза сізге көмектеседі.
Dialogue: 0,0:10:26.57,0:10:27.99,JP2,,0000,0000,0000,,Юкинари-сама?
Dialogue: 0,0:10:28.95,0:10:30.55,JP2,,0000,0000,0000,,Осындай уақытта?
Dialogue: 0,0:10:30.84,0:10:32.04,JP2,,0000,0000,0000,,Кел мені көр
Dialogue: 0,0:10:32.61,0:10:34.47,JP2,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:10:35.39,0:10:37.55,JP2,,0000,0000,0000,,Қалай болғанда да, бұл өте өзекті мәселе.
Dialogue: 0,0:10:39.39,0:10:41.38,JP2,,0000,0000,0000,,Түннің осы сағатында не болып жатыр?
Dialogue: 0,0:10:41.95,0:10:42.95,JP2,,0000,0000,0000,,Іскерлік қарым-қатынас
Dialogue: 0,0:10:44.26,0:10:46.10,JP2,,0000,0000,0000,,Мынаны Чугу-самаға беріңізші.
Dialogue: 0,0:10:46.80,0:10:50.95,JP2,,0000,0000,0000,,Мен олардың ауылға осы үшін келеді деп ойламаппын.
Dialogue: 0,0:10:52.44,0:10:54.55,JP2,,0000,0000,0000,,Басқа әйелден сұрауға болады.
Dialogue: 0,0:10:54.55,0:10:56.05,JP2,,0000,0000,0000,,Басқалардан сұрайын деген ойым жоқ
Dialogue: 0,0:10:59.33,0:11:04.05,JP2,,0000,0000,0000,,Сей Шонагон-доно, сенсіз менің жұмысыма қауіп төнеді.
Dialogue: 0,0:11:08.03,0:11:12.62,JP2,,0000,0000,0000,,Келесі жылы Садако мен Сей Шонагон патша сарайына оралды.
Dialogue: 0,0:11:19.04,0:11:23.66,JP2,,0000,0000,0000,,Ол Курадоның басшысы болған кезде, ол Йошитаканың ұлы болған.
Dialogue: 0,0:11:23.66,0:11:26.42,JP2,,0000,0000,0000,,Юкинари мырза үлкен үміт күтсе де.
Dialogue: 0,0:11:26.91,0:11:29.55,JP2,,0000,0000,0000,,Юкинари мырзамен тіл табысу өте қиын адам.
Dialogue: 0,0:11:29.55,0:11:31.39,JP2,,0000,0000,0000,,Маған біраз қызық емес.
Dialogue: 0,0:11:31.64,0:11:33.05,JP2,,0000,0000,0000,,Енді осы жер
Dialogue: 0,0:11:35.02,0:11:36.63,JP2,,0000,0000,0000,,Шонагон туралы не ойлайсың?
Dialogue: 0,0:11:39.64,0:11:43.59,JP2,,0000,0000,0000,,Ол, әрине, түзу және дос емес.
Dialogue: 0,0:11:43.59,0:11:45.59,JP2,,0000,0000,0000,,Жұмыста сауатты
Dialogue: 0,0:11:45.68,0:11:48.61,JP2-,,0000,0000,0000,,Жақсы аралассаңыз, қызық болуы мүмкін.
Dialogue: 0,0:11:46.77,0:11:48.64,JP2,,0000,0000,0000,,Комплимент табылмады
Dialogue: 0,0:11:49.06,0:11:53.24,JP2,,0000,0000,0000,,Екеуі жақсы араласса да, Юкинари-сама тек Шонагон ғана жақсылық сұрайды.
Dialogue: 0,0:11:53.43,0:11:55.47,JP2,,0000,0000,0000,,Шонагон сізді алаңдатады ма?
Dialogue: 0,0:11:55.97,0:11:57.16,JP2,,0000,0000,0000,,О, түсіндім.
Dialogue: 0,0:11:57.56,0:12:00.17,JP2,,0000,0000,0000,,Бұл тек Пак Нен Инге қатысты.
Dialogue: 0,0:12:00.47,0:12:03.90,JP2,,0000,0000,0000,,Пак Нен Ин қаншалықты көп болса да, джентльмен - джентльмен.
Dialogue: 0,0:12:04.77,0:12:08.77,JP2,,0000,0000,0000,,Жарайды, Шонагон мақтаса, жақсы жақтары бар шығар.
Dialogue: 0,0:12:11.53,0:12:12.47,JP2,,0000,0000,0000,,Керемет жұмыс!
Dialogue: 0,0:12:13.04,0:12:15.78,JP2,,0000,0000,0000,,Садако-саманың бет-бейнесін сақтап қалуды жақсы орындаған сияқтысыз.
Dialogue: 0,0:12:16.40,0:12:19.53,JP2,,0000,0000,0000,,Құрметті Юкинари, кемпір, мен мұны шын жүректен айтқым келеді.
Dialogue: 0,0:12:19.85,0:12:22.89,JP2,,0000,0000,0000,,Менен басқа әйелдермен жақсы араласуға тырысыңыз.
Dialogue: 0,0:12:22.91,0:12:23.73,JP2,,0000,0000,0000,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:12:24.28,0:12:25.45,JP2,,0000,0000,0000,,Мен оны жек көремін
Dialogue: 0,0:12:25.87,0:12:28.38,JP2,,0000,0000,0000,,Кең, таяз болу менің табиғатыма сай емес.
Dialogue: 0,0:12:29.50,0:12:31.16,JP2,,0000,0000,0000,,Барлығымен кездейсоқ араласудан гөрі
Dialogue: 0,0:12:31.63,0:12:35.11,JP2,,0000,0000,0000,,Ең болмағанда бір шынайы достық орнатқан өмір сүруге тұрарлық.
Dialogue: 0,0:12:37.10,0:12:39.19,JP2,,0000,0000,0000,,Сенің сезіміңді түсінемін.
Dialogue: 0,0:12:39.71,0:12:41.78,JP2,,0000,0000,0000,,Бірақ сіз менің қоғамдық және жеке өмірімді ажыратуыңыз керек.
Dialogue: 0,0:12:43.34,0:12:45.18,JP2,,0000,0000,0000,,Қыңырлығыңызды реттеңіз
Dialogue: 0,0:12:45.65,0:12:47.62,JP2,,0000,0000,0000,,Қайта алмайтын нәрсе – ақыл
Dialogue: 0,0:12:48.91,0:12:50.90,JP2,,0000,0000,0000,,Адам табиғатын өзгертуге болмайды
Dialogue: 0,0:12:51.52,0:12:52.91,JP2,,0000,0000,0000,,Қыңырлық табиғи нәрсе
Dialogue: 0,0:12:53.58,0:12:56.89,JP2,,0000,0000,0000,,Онда қателесуден қорықпа.
Dialogue: 0,0:12:57.28,0:13:02.13,JP2,,0000,0000,0000,,Қателессең түзет деген ілімді елемейсің бе?
Dialogue: 0,0:13:04.17,0:13:04.91,JP2,,0000,0000,0000,,Модель! Модель! Менің не болып жатқанын түсіндірші!
Dialogue: 0,0:13:06.31,0:13:07.35,JP2,,0000,0000,0000,,Бетіңізді көрсетсеңіз
Dialogue: 0,0:13:07.90,0:13:08.44,JP2,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:13:08.94,0:13:10.93,JP2,,0000,0000,0000,,Тұлғаңызды өзгертуге өзіңізді мәжбүрлесеңіз
Dialogue: 0,0:13:11.40,0:13:13.07,JP2,,0000,0000,0000,,Шынайылық көрсетіңіз
Dialogue: 0,0:13:13.74,0:13:15.58,JP2,,0000,0000,0000,,Бетпе-бет кеңес берсең
Dialogue: 0,0:13:15.88,0:13:16.75,JP2,,0000,0000,0000,,Мен де ойлаймын.
Dialogue: 0,0:13:17.96,0:13:19.68,JP2,,0000,0000,0000,,Тез қара
Dialogue: 0,0:13:20.37,0:13:21.94,JP2,,0000,0000,0000,,Жетеді.
Dialogue: 0,0:13:22.26,0:13:25.94,JP2,,0000,0000,0000,,Егер басқа адам осындай болса, менің шынайылығымды көрсетудің қажеті жоқ.
Dialogue: 0,0:13:26.21,0:13:27.08,JP2,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:13:27.53,0:13:29.15,JP2,,0000,0000,0000,,Менің де адалдығым бекер.
Dialogue: 0,0:13:30.39,0:13:33.67,JP2,,0000,0000,0000,,Енді мен ренжітпей тұрып үйге барайын ба?
Dialogue: 0,0:13:33.79,0:13:35.24,JP2,,0000,0000,0000,,Ой, менің бір шаруам бар еді.
Dialogue: 0,0:13:36.40,0:13:38.99,JP2,,0000,0000,0000,,Бүгін түнгі ауысым бар, кешігіп қалсам жаман болар еді.
Dialogue: 0,0:13:39.46,0:13:43.46,JP2,,0000,0000,0000,,Мен сені ұятсыз отыр екен деп ойладым.
Dialogue: 0,0:13:43.64,0:13:46.15,JP2,,0000,0000,0000,,Мен қандай да бір себептермен үйге тез бара жатырмын.
Dialogue: 0,0:13:46.50,0:13:48.11,JP2,,0000,0000,0000,,Әдептілік
Dialogue: 0,0:13:54.70,0:13:57.43,JP2,,0000,0000,0000,,Өйткені ол маған ешқашан бұлай ашпайды.
Dialogue: 0,0:13:57.65,0:14:01.01,JP2,,0000,0000,0000,,Мен жеткілікті қашықтықты жинай алмасам ше?
Dialogue: 0,0:14:02.08,0:14:03.30,JP2,,0000,0000,0000,,Ақымақ болма
Dialogue: 0,0:14:03.30,0:14:06.45,JP2,,0000,0000,0000,,Тезірек кел, бос емессің.
Dialogue: 0,0:14:07.12,0:14:09.54,JP2,,0000,0000,0000,,Иә, кездескенше.
Dialogue: 0,0:14:14.80,0:14:17.09,JP2,,0000,0000,0000,,Сіз де таң қаларлықтай түкке тұрғысызсыз.
Dialogue: 0,0:14:17.74,0:14:19.92,JP2,,0000,0000,0000,,Бір мырзаны тежеу ​​мүмкін емес деген нені білдіреді?
Dialogue: 0,0:14:20.20,0:14:23.80,JP2,,0000,0000,0000,,Таңертең сені мазақ етуді асыға күттім.
Dialogue: 0,0:14:24.32,0:14:27.95,JP2,,0000,0000,0000,,Садако-сама, Юкинари-сама және мен жай ғана доспыз.
Dialogue: 0,0:14:28.08,0:14:28.97,JP2,,0000,0000,0000,,Дегенмен, бұл біреуі шын мәнінде өте сүйкімді.
Dialogue: 0,0:14:29.62,0:14:33.69,JP2,,0000,0000,0000,,Ер достар бұл күндері вокзалға асығады және сонда қалады.
Dialogue: 0,0:14:34.27,0:14:36.35,JP2,,0000,0000,0000,,Иә, солай сияқты.
Dialogue: 0,0:14:36.63,0:14:39.58,JP2,,0000,0000,0000,,Егер біз жақын болсақ, біз бірге болуымыз керек.
Dialogue: 0,0:14:40.06,0:14:41.60,JP2,,0000,0000,0000,,Менің ойымша, бұл сізге сәйкес келеді.
Dialogue: 0,0:14:41.77,0:14:43.56,JP2,,0000,0000,0000,,Ол менен алты жас кіші.
Dialogue: 0,0:14:43.66,0:14:47.76,JP2,,0000,0000,0000,,Мәселе мынада, кемпір жас ханзадаларды ұстап алады және олардың бәрі майлы болғандықтан оларды мазақ етеді.
Dialogue: 0,0:14:48.26,0:14:49.45,JP2,,0000,0000,0000,,Әй, бәрі керісінше.
Dialogue: 0,0:14:49.90,0:14:53.63,JP2,,0000,0000,0000,,Ол қанша жаста болса да, күйеуі сүйкімді әйелімен мақтанады.
Dialogue: 0,0:14:54.02,0:14:57.01,JP2,,0000,0000,0000,,Махаббаттың гүлін ашатын тек еңбек емес.
Dialogue: 0,0:14:57.21,0:14:59.37,JP2,,0000,0000,0000,,Сен мені бірден қоздырдың
Dialogue: 0,0:14:59.69,0:15:02.13,JP2,,0000,0000,0000,,Жоқ, мен саған қызықсыз қарап тұрмын.
Dialogue: 0,0:15:02.47,0:15:06.10,JP2,,0000,0000,0000,,О, өтінемін, сүйкімді емес, мені тастама.
Dialogue: 0,0:15:06.40,0:15:07.92,JP2,,0000,0000,0000,,Күлкілі нәрсе
Dialogue: 0,0:15:08.84,0:15:13.78,JP2,,0000,0000,0000,,Менен қашан бас тартасың деп уайымдайтын менмін.
Dialogue: 0,0:15:16.07,0:15:18.28,JP2,,0000,0000,0000,,Бұл мүлдем мүмкін емес.
Dialogue: 0,0:15:21.09,0:15:22.56,JP2,,0000,0000,0000,,Мичитака-сама кеткеннен кейін
Dialogue: 0,0:15:23.18,0:15:28.30,JP2,,0000,0000,0000,,Садако ханым ішкі сарайда тек императордың қолдауымен қалқан ретінде соғысуда.
Dialogue: 0,0:15:29.54,0:15:31.83,JP2,,0000,0000,0000,,Отбасы тағдырын иығымен көтеру
Dialogue: 0,0:15:32.13,0:15:35.18,JP2,,0000,0000,0000,,Көңілді кейіп танытқаныңды көру мұң.
Dialogue: 0,0:15:38.96,0:15:43.43,JP2,,0000,0000,0000,,Енді бір әйелдің дауы Садако-саманың атына да кір келтіруі мүмкін.
Dialogue: 0,0:15:44.06,0:15:45.52,JP2,,0000,0000,0000,,Абайсызда ғашық бола алмайсың
Dialogue: 0,0:15:46.22,0:15:49.25,JP2,,0000,0000,0000,,Ал сырттай өзгеріссіз қалатындар бар.
Dialogue: 0,0:15:49.50,0:15:50.97,JP2,,0000,0000,0000,,Мен сені енді одақтас деп айта алмаймын.
Dialogue: 0,0:15:51.88,0:15:54.72,JP2,,0000,0000,0000,,Юкинари-сама жау ма, әлде одақтас па?
Dialogue: 0,0:15:55.41,0:15:55.96,JP2,,0000,0000,0000,,Жау
Dialogue: 0,0:15:57.60,0:15:58.74,JP2,,0000,0000,0000,,Сіз қазір түнгі ауысымдасыз ба?
Dialogue: 0,0:16:00.51,0:16:01.45,JP2,,0000,0000,0000,,Сайнобу-сама
Dialogue: 0,0:16:04.91,0:16:07.64,JP2,,0000,0000,0000,,Жастық кітабы Шонагон бұл туралы жазған
Dialogue: 0,0:16:08.04,0:16:10.43,JP2,,0000,0000,0000,,Ах, келесі жолы Шонагонмен кездесемін.
Dialogue: 0,0:16:10.58,0:16:12.19,JP2,,0000,0000,0000,,Қалғанын көрсетейін.
Dialogue: 0,0:16:12.66,0:16:14.70,JP2,,0000,0000,0000,,Император сарайындағы әртүрлі нәрселер туралы жазбаша жазба.
Dialogue: 0,0:16:15.27,0:16:17.29,JP2,,0000,0000,0000,,Мен басты кейіпкермін.
Dialogue: 0,0:16:18.13,0:16:20.84,JP2,,0000,0000,0000,,Мына жерде мені жақсы мақтап жатырсың.
Dialogue: 0,0:16:22.63,0:16:25.59,JP2,,0000,0000,0000,,Сайнобу мырза соңғы кездері ол жаққа келмеген сияқты.
Dialogue: 0,0:16:25.79,0:16:28.62,JP2,,0000,0000,0000,,Ааа, менің жұмыс орным өзгерді, сенімен кездесуге мүмкіндік жоқ.
Dialogue: 0,0:16:29.07,0:16:32.40,JP2,,0000,0000,0000,,Мүмкіндігіміз болмағандықтан алыстап кеттік деу аздап ұят.
Dialogue: 0,0:16:32.57,0:16:34.73,JP2,,0000,0000,0000,,Енжар Шонагон осылай деді ме?
Dialogue: 0,0:16:35.11,0:16:37.00,JP2,,0000,0000,0000,,Жоқ, мен солай ойладым.
Dialogue: 0,0:16:37.72,0:16:39.26,JP2,,0000,0000,0000,,Олай болса, бұл үлкен мәселе.
Dialogue: 0,0:16:40.75,0:16:44.45,JP2,,0000,0000,0000,,Эй, Юкинари-кун, ол екеуміздің арамызда жақсы болғаны рас.
Dialogue: 0,0:16:44.77,0:16:46.56,JP2,,0000,0000,0000,,Бұл мүдделер қақтығысының себебі.
Dialogue: 0,0:16:47.71,0:16:49.32,JP2,,0000,0000,0000,,Ол да мұны біледі.
Dialogue: 0,0:16:50.42,0:16:52.68,JP2,,0000,0000,0000,,Жастық кітабына да солай.
Dialogue: 0,0:16:54.14,0:16:55.78,JP2,,0000,0000,0000,,Көркем ашық хат
Dialogue: 0,0:16:56.03,0:16:58.17,JP2,,0000,0000,0000,,Әйелдер тең дәрежеде жарысады
Dialogue: 0,0:16:58.92,0:17:02.59,JP2,,0000,0000,0000,,Онда біз Чугуды мадақтайтын пешкалар ғанамыз.
Dialogue: 0,0:17:04.41,0:17:07.71,JP2,,0000,0000,0000,,Ал мақтау мен үшін шығын бола алмайды.
Dialogue: 0,0:17:08.46,0:17:09.65,JP2,,0000,0000,0000,,Осы уақытқа дейін қарым-қатынас болды.
Dialogue: 0,0:17:11.07,0:17:13.08,JP2,,0000,0000,0000,,Мен саған сол затпен дос бол дедім.
Dialogue: 0,0:17:13.46,0:17:15.99,JP2,,0000,0000,0000,,Егер сіз иығыңызға қажетінен артық салмақ салсаңыз, мен қатты әсер етпеймін.
Dialogue: 0,0:17:17.78,0:17:19.42,JP2,,0000,0000,0000,,Өйткені бұл ойлау жүйесі.
Dialogue: 0,0:17:19.74,0:17:21.88,JP2,,0000,0000,0000,,Менің ойымша, осы уақытқа дейін бізде бірдей қарым-қатынас болуы мүмкін еді.
Dialogue: 0,0:17:22.11,0:17:24.27,JP2,,0000,0000,0000,,Хаха, сен айтасың.
Dialogue: 0,0:17:25.19,0:17:26.50,JP2,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:17:27.13,0:17:29.56,JP2,,0000,0000,0000,,Оны сізге ашуға көндіруге тырысыңыз.
Dialogue: 0,0:17:30.08,0:17:33.86,JP2,,0000,0000,0000,,Егер сіз байсалды және адал болсаңыз, мүмкін сіз оны орындай аласыз.
Dialogue: 0,0:17:36.25,0:17:39.45,JP2,,0000,0000,0000,,Бұл Сей Шонагон-сама мен Юкинари-самадан алынған мәтін.
Dialogue: 0,0:17:39.90,0:17:40.72,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:17:42.93,0:17:44.65,JP2,,0000,0000,0000,,Ара Гочо мәтіні
Dialogue: 0,0:17:45.19,0:17:48.43,JP2,,0000,0000,0000,,Өкінішке орай, бізде мұндай сексуалдық нәрселерге ешқандай қатысы жоқ.
Dialogue: 0,0:17:48.80,0:17:51.31,JP2,,0000,0000,0000,,Ендеше, қарсы жақтың өзі солай.
Dialogue: 0,0:17:54.22,0:17:56.18,JP2,,0000,0000,0000,,Мен бүгін таңертең өте нашар сезінемін.
Dialogue: 0,0:17:56.88,0:17:59.21,JP2,,0000,0000,0000,,Мен түні бойы ескі күндерді айтуды жоспарладым.
Dialogue: 0,0:17:59.73,0:18:01.37,JP2,,0000,0000,0000,,Бірінші тауық шақырды
Dialogue: 0,0:18:02.59,0:18:05.85,JP2,,0000,0000,0000,,Үйге түн жарымында келсем де, біртүрлі сылтау айтатынмын.
Dialogue: 0,0:18:08.43,0:18:10.50,JP2,,0000,0000,0000,,Омардың мұндай түрі де мүмкін.
Dialogue: 0,0:18:10.67,0:18:13.98,JP2,,0000,0000,0000,,Егер сол қыңырлығыңызды түзете алсаңыз, танымал болатыныңызға сенімдімін.
Dialogue: 0,0:18:15.34,0:18:18.15,JP2,,0000,0000,0000,,Түнде әтештің шақырғанын естімеппін.
Dialogue: 0,0:18:19.15,0:18:22.25,JP2,,0000,0000,0000,,Қытайдың алыс жерлерінде осындай тауықтар болған.
Dialogue: 0,0:18:22.97,0:18:28.62,JP2,,0000,0000,0000,,Ци батыры Мэңцзяньгун таңға дейін ашылмайтын бақылау бекетін ашқысы келді.
Dialogue: 0,0:18:28.89,0:18:31.80,JP2,,0000,0000,0000,,Тауықтың дыбысына еліктеп, тосқауылшыны алдады дейді.
Dialogue: 0,0:18:32.67,0:18:36.37,JP2,,0000,0000,0000,,Сені шақырған әтеш жалған шығар.
Dialogue: 0,0:18:40.20,0:18:45.29,JP2,,0000,0000,0000,,Қарасам, Мэнжу тауықтың дыбысына еліктеп ашқан жері Хакотани асуы екен.
Dialogue: 0,0:18:46.11,0:18:49.32,JP2,,0000,0000,0000,,Менде дәл осылай ашқым келетін бағалы қағаз болса.
Dialogue: 0,0:18:50.26,0:18:54.24,JP2,,0000,0000,0000,,Сен екеумізді бөліп тұрған махаббат кедергісі осы емес пе?
Dialogue: 0,0:18:54.99,0:18:57.20,JP2,,0000,0000,0000,,Ағын біртүрлі болып қалды.
Dialogue: 0,0:18:57.60,0:19:00.48,JP2,,0000,0000,0000,,Мен сені бұлай әзіл айтатын адам деп ойламаппын.
Dialogue: 0,0:19:01.07,0:19:03.81,JP2,,0000,0000,0000,,Қызық, ол сізді шындап баурап алмақшы ма?
Dialogue: 0,0:19:04.90,0:19:06.97,JP2,,0000,0000,0000,,Жай ғана бірге болыңыз.
Dialogue: 0,0:19:08.33,0:19:10.35,JP2,,0000,0000,0000,,Біреу сізді арандатқан болуы керек.
Dialogue: 0,0:19:12.76,0:19:14.37,JP2,,0000,0000,0000,,Орта ғибадатханасы бар әйел ретінде
Dialogue: 0,0:19:14.69,0:19:18.92,JP2,,0000,0000,0000,,Ұялмаңыз, романтикалық шақыруларға әнмен жауап беріңіз
Dialogue: 0,0:19:29.18,0:19:32.64,JP2,,0000,0000,0000,,Өтірігің махаббатқа апарар қақпа емес.
Dialogue: 0,0:19:33.16,0:19:35.80,JP2,,0000,0000,0000,,Өкінішке орай, мен өте қорғанамын.
Dialogue: 0,0:19:37.31,0:19:39.57,JP2,,0000,0000,0000,,Бұл сүйкімді болмаса да
Dialogue: 0,0:19:39.75,0:19:42.98,JP2,,0000,0000,0000,,Осы сияқты тапқыр ән қызық болар еді.
Dialogue: 0,0:19:45.04,0:19:49.42,JP2,,0000,0000,0000,,Ойланып қарасам, Юкинари-самаға бірінші рет ән жолдап отырмын.
Dialogue: 0,0:19:50.04,0:19:51.88,JP2,,0000,0000,0000,,Бір-бірімізге ән айтудан аулақ болдық.
Dialogue: 0,0:19:52.70,0:19:54.98,JP2,,0000,0000,0000,,Мен кенеттен ұялып қалдым.
Dialogue: 0,0:19:55.36,0:19:57.22,JP2,,0000,0000,0000,,Юкинари мырзаның жауабы
Dialogue: 0,0:19:57.29,0:19:58.89,JP2,,0000,0000,0000,,Е, бұл ерте.
Dialogue: 0,0:20:09.10,0:20:10.19,JP2,,0000,0000,0000,,Күшті қорғаныс
Dialogue: 0,0:20:10.72,0:20:14.47,JP2,,0000,0000,0000,,Сенің бәрі көңілді екеніңді айтады, өйткені сен бәріне ашықсың.
Dialogue: 0,0:20:16.66,0:20:20.58,JP2,,0000,0000,0000,,Бұл не? Мен бұған енді жақсы емеспін немесе жақсы емеспін.
Dialogue: 0,0:20:21.95,0:20:24.71,JP2,,0000,0000,0000,,Тым дөрекі және дөрекі
Dialogue: 0,0:20:27.82,0:20:30.05,JP2,,0000,0000,0000,,Бұл мен саған жіберуге аттанған әнім еді.
Dialogue: 0,0:20:30.18,0:20:31.94,JP2,,0000,0000,0000,,Жауап алмағаным үшін кешіріңіз.
Dialogue: 0,0:20:32.49,0:20:34.35,JP2,,0000,0000,0000,,Бұл өкінішке орай.
Dialogue: 0,0:20:34.53,0:20:35.79,JP2,,0000,0000,0000,,Мен сені менсінбеймін.
Dialogue: 0,0:20:36.39,0:20:37.86,JP2,,0000,0000,0000,,Бұл жай ғана әзіл
Dialogue: 0,0:20:38.08,0:20:41.16,JP2,,0000,0000,0000,,Қалжыңдайтын жақсы және жаман нәрселер бар.
Dialogue: 0,0:20:42.13,0:20:42.65,JP2,,0000,0000,0000,,Хаха… бұл қызық екен.
Dialogue: 0,0:20:42.90,0:20:46.33,JP2,,0000,0000,0000,,Менің Зошиім неге ол сенде?
Dialogue: 0,0:20:46.70,0:20:48.20,JP2,,0000,0000,0000,,Сайнобу мырза әкелді.
Dialogue: 0,0:20:48.99,0:20:50.66,JP2,,0000,0000,0000,,Барлығы оны оқып шыққан сияқты.
Dialogue: 0,0:20:51.10,0:20:54.04,JP2,,0000,0000,0000,,Маған ұнамайды, бәрі.
Dialogue: 0,0:20:54.66,0:20:55.60,JP2,,0000,0000,0000,,Бұл жақсы қабылданды.
Dialogue: 0,0:20:56.10,0:20:57.81,JP2,,0000,0000,0000,,Мақтаудың зияны жоқ сияқты.
Dialogue: 0,0:21:00.20,0:21:01.82,JP2,,0000,0000,0000,,Мені қате түсінбеңіз.
Dialogue: 0,0:21:02.69,0:21:07.41,JP2,,0000,0000,0000,,Саған жақын болғаным өзімшілдіктен емес.
Dialogue: 0,0:21:08.30,0:21:11.29,JP2,,0000,0000,0000,,Біздің ұстанымдарымыз мүлдем басқаша.
Dialogue: 0,0:21:11.71,0:21:14.94,JP2,,0000,0000,0000,,Мен сол алшақтықты жеңіп, дос болатындай сезіндім.
Dialogue: 0,0:21:15.56,0:21:17.60,JP2,,0000,0000,0000,,Жоқ, мен қаладым.
Dialogue: 0,0:21:19.29,0:21:21.10,JP2,,0000,0000,0000,,Бірақ менің ойымша, сіз олай ойламайсыз.
Dialogue: 0,0:21:22.20,0:21:26.57,JP2,,0000,0000,0000,,Құстардың дыбысын түні бойы өлшеуге болады дейді ме?
Dialogue: 0,0:21:27.69,0:21:29.88,JP2,,0000,0000,0000,,Сіздің ұстанымыңыз басқаша екенін білсеңіз
Dialogue: 0,0:21:30.52,0:21:32.64,JP2,,0000,0000,0000,,Маған бұлай байланбағаны жақсы.
Dialogue: 0,0:21:32.71,0:21:36.81,JP2,,0000,0000,0000,,Жағдайға байланысты бұрынғы достығыңызды өзгертесіз бе?
Dialogue: 0,0:21:38.85,0:21:40.49,JP2,,0000,0000,0000,,Позициядағы айырмашылықтардан тыс
Dialogue: 0,0:21:40.76,0:21:45.71,JP2,,0000,0000,0000,,Ойлану және сену қиын.
Dialogue: 0,0:21:46.78,0:21:47.67,JP2,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:21:48.24,0:21:49.31,JP2,,0000,0000,0000,,Әлі де I
Dialogue: 0,0:21:50.26,0:21:52.99,JP2,,0000,0000,0000,,Сенетін және ұстанатын нәрсесіз өмір
Dialogue: 0,0:21:53.46,0:21:55.05,JP2,,0000,0000,0000,,Менің ойымша, бұл өлі сияқты жақсы.
Dialogue: 0,0:21:56.77,0:21:58.76,JP2,,0000,0000,0000,,Наоконы еске түсіріңіз
Dialogue: 0,0:21:59.60,0:22:03.13,JP2,,0000,0000,0000,,Сенетін нәрсесіз өмір өліммен тең.
Dialogue: 0,0:22:04.18,0:22:07.43,JP2,,0000,0000,0000,,Бұл кісінің сөзі мені үнемі баурап алады
Dialogue: 0,0:22:08.10,0:22:11.33,JP2,,0000,0000,0000,,Менің ойымша, бұл менің жастығым және адалдығым үшін.
Dialogue: 0,0:22:13.17,0:22:16.78,JP2,,0000,0000,0000,,Олай десеңіз, мен де дайындалуым керек.
Dialogue: 0,0:22:18.39,0:22:20.01,JP2,,0000,0000,0000,,Махаббат мәселесіне қарамастан
Dialogue: 0,0:22:20.45,0:22:23.66,JP2,,0000,0000,0000,,Жүрегіме тосқауыл болса, кез келген уақытта ашамын.
Dialogue: 0,0:22:26.52,0:22:29.43,JP2,,0000,0000,0000,,Енді қақпаның ашылғанының дәлелі ретінде бетіңізді көрсетіңіз.
Dialogue: 0,0:22:29.68,0:22:32.19,JP2,,0000,0000,0000,,Бұл басқа әңгіме.
Dialogue: 0,0:22:32.56,0:22:33.38,JP2,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:22:33.85,0:22:36.68,JP2,,0000,0000,0000,,Өйткені бұл енді ұят емес.
Dialogue: 0,0:22:36.68,0:22:38.05,JP2,,0000,0000,0000,,Жарайды, шіркін, солай емес пе?
Dialogue: 0,0:22:38.72,0:22:40.11,JP2,,0000,0000,0000,,Бұл жағдайда оны ешқашан көрсетпеңіз
Dialogue: 0,0:22:40.19,0:22:41.98,JP2,,0000,0000,0000,,Біз үзіліс жасаймыз.
Dialogue: 0,0:24:17.47,0:24:21.97,JP2,,0000,0000,0000,,Сарқыраманың дыбысы ұзақ сақталады, бірақ
Dialogue: 0,0:24:22.49,0:24:26.07,JP2,,0000,0000,0000,,Менің атымды ағып жатқанда есті
Dialogue: 0,0:00:04.02,0:00:05.24,CN,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:00:05.69,0:00:08.74,CN,,0000,0000,0000,,Фудзивара Садаи Хэйан полиция бөлімінің арнайы тергеушісі болған.
Dialogue: 0,0:00:08.92,0:00:10.46,CN,,0000,0000,0000,,Бұл позиция алыс орналасқан жер.
Dialogue: 0,0:00:11.30,0:00:12.87,CN,,0000,0000,0000,,Білім беру желісі
Dialogue: 0,0:00:13.57,0:00:16.20,CN,,0000,0000,0000,,Тейка мырзаның шолуы
Dialogue: 0,0:00:20.75,0:00:23.03,CN,,0000,0000,0000,,Басқа айқайлар Юкинари Фудзивара
Dialogue: 0,0:00:23.16,0:00:25.99,CN,,0000,0000,0000,,Мен оны бұрын ешқашан көрген емеспін.
Dialogue: 0,0:00:26.41,0:00:28.73,CN,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:00:29.05,0:00:31.21,CN,,0000,0000,0000,,Дереу жоғалтуды растау
Dialogue: 0,0:00:31.81,0:00:34.39,CN,,0000,0000,0000,,Бұл анық екені анық.
Dialogue: 0,0:02:17.19,0:02:22.21,CN,,0000,0000,0000,,Отбасының әкесі Фудзивара но Такаконың қайтыс болған уақыты.
Dialogue: 0,0:02:23.13,0:02:26.39,CN,,0000,0000,0000,,Токутака Мочишигенің басқа аудармалары Бұл тамаша ақын.
Dialogue: 0,0:02:27.43,0:02:28.80,CN,,0000,0000,0000,,Чжоуэн халықтық орта мектебі
Dialogue: 0,0:02:29.05,0:02:31.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:32.50,0:02:36.82,CN,,0000,0000,0000,,Есепке кірмейтіні рас, бірақ түрлері бар...
Dialogue: 0,0:02:37.37,0:02:41.05,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:48.01,0:02:49.53,CN,,0000,0000,0000,,Ерте Юкинари
Dialogue: 0,0:02:50.99,0:02:53.10,CN,,0000,0000,0000,,Йошихиде Хаяками
Dialogue: 0,0:02:53.58,0:02:55.24,CN,,0000,0000,0000,,Жақында осындасыз
Dialogue: 0,0:02:55.84,0:02:57.75,CN,,0000,0000,0000,,Мен саясатты тез және жан-жақты түсінемін.
Dialogue: 0,0:02:58.20,0:02:59.42,CN,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:03:00.14,0:03:03.24,CN,,0000,0000,0000,,Басқа жарықтың саяси істері келді.
Dialogue: 0,0:03:03.49,0:03:04.44,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:04.66,0:03:08.22,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:08.22,0:03:09.16,CN,,0000,0000,0000,,Хаяками Йошихиро
Dialogue: 0,0:03:09.26,0:03:12.14,CN,,0000,0000,0000,,Иә? Контен Гёнари Дайя Йоджо Ичиду
Dialogue: 0,0:03:13.98,0:03:17.49,CN,,0000,0000,0000,,Юкинари-кун, оны тақтаға қоюдың қажеті жоқ.
Dialogue: 0,0:03:18.90,0:03:21.02,CN,,0000,0000,0000,,Сіздің ресми кездесуіңіз келесі сапарыңызда шешілді.
Dialogue: 0,0:03:21.41,0:03:23.85,CN,,0000,0000,0000,,Бағынбайтын әйел шенеуніктердің бірлестігінің атауы
Dialogue: 0,0:03:26.31,0:03:30.29,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:30.78,0:03:33.14,CN,,0000,0000,0000,,Бұның себебі, оны тыңдаудың қажеті жоқ.
Dialogue: 0,0:03:34.21,0:03:36.60,CN,,0000,0000,0000,,Бүгінгі ресми әйел шенеунік
Dialogue: 0,0:03:37.49,0:03:38.96,CN,,0000,0000,0000,,Гүл ғибадатханасының таза және шағын хабары
Dialogue: 0,0:03:39.90,0:03:42.17,CN,,0000,0000,0000,,Коре Киёхара Мотосуке Ересек адамның мың алтыны
Dialogue: 0,0:03:42.91,0:03:45.52,CN,,0000,0000,0000,,Ересектердің сенімдері
Dialogue: 0,0:03:45.87,0:03:48.28,CN,,0000,0000,0000,,Төтенше жағдайда еркін жүретін ақылды қыз.
Dialogue: 0,0:03:49.20,0:03:53.48,CN,,0000,0000,0000,,Дегенмен досыңызға назар аударыңыз.
Dialogue: 0,0:03:54.37,0:03:56.31,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:00.58,0:04:01.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:03.29,0:04:06.32,CN,,0000,0000,0000,,Атақты ақын
Dialogue: 0,0:04:07.64,0:04:10.20,CN,,0000,0000,0000,,Өлеңнің сөзін оқып беріңізші.
Dialogue: 0,0:04:10.38,0:04:11.42,CN,,0000,0000,0000,,Сізде не бар?
Dialogue: 0,0:04:12.64,0:04:14.50,CN,,0000,0000,0000,,Сол кезде мен жылай бастадым.
Dialogue: 0,0:04:14.80,0:04:17.83,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:18.45,0:04:22.13,CN,,0000,0000,0000,,Жаңадан тағайындалған Куринто Юкинари Фудзивара
Dialogue: 0,0:04:23.70,0:04:27.55,CN,,0000,0000,0000,,Миязатодағы әйел шенеунік қаладағы ересек адамды жаза алды, бірақ ол келгісі келмеді.
Dialogue: 0,0:04:27.90,0:04:30.88,CN,,0000,0000,0000,,Үлкендер ғана өз қамын жейді, Кішкентай қыздар жеңілуден қорқады
Dialogue: 0,0:04:31.20,0:04:32.74,CN,,0000,0000,0000,,Шабдалы гүлің келді
Dialogue: 0,0:04:33.09,0:04:36.08,CN,,0000,0000,0000,,Белгісіз адамдардың жағымсыз сөздері
Dialogue: 0,0:04:36.22,0:04:37.59,CN,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:38.14,0:04:39.28,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:39.65,0:04:43.36,CN,,0000,0000,0000,,Йошиде отбасының көптеген көрнекті таланттары
Dialogue: 0,0:04:43.61,0:04:45.79,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:46.41,0:04:49.02,CN,,0000,0000,0000,,Мен емес
Dialogue: 0,0:04:49.30,0:04:51.21,CN,,0000,0000,0000,,Оқудағы жалқаулық
Dialogue: 0,0:04:51.78,0:04:52.78,CN,,0000,0000,0000,,Өзімшіл
Dialogue: 0,0:04:53.85,0:04:58.10,CN,,0000,0000,0000,,Менің арғы атам Найчидің ардақты ақын болғанын көрдің.
Dialogue: 0,0:04:58.34,0:05:01.03,CN,,0000,0000,0000,,Әкесі қайтыс болып, баласы одан әрі ауыртпалық көрді.
Dialogue: 0,0:05:01.20,0:05:04.36,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:04.66,0:05:07.22,CN,,0000,0000,0000,,Қарыз әкенің беделі
Dialogue: 0,0:05:07.32,0:05:09.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:11.12,0:05:11.89,CN,,0000,0000,0000,,Мен келісемін
Dialogue: 0,0:05:12.86,0:05:15.97,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:17.31,0:05:18.33,CN,,0000,0000,0000,,Дәл осы жерде
Dialogue: 0,0:05:19.30,0:05:20.89,CN,,0000,0000,0000,,Ересек Юкинари
Dialogue: 0,0:05:21.33,0:05:23.57,CN,,0000,0000,0000,,Достығымыз жақсы.
Dialogue: 0,0:05:24.32,0:05:26.80,CN,,0000,0000,0000,,Жапон поэзиясы
Dialogue: 0,0:05:28.96,0:05:30.70,CN,,0000,0000,0000,,Менің шынайы болмысымның ұзақ өлеңі
Dialogue: 0,0:05:31.90,0:05:34.04,CN,,0000,0000,0000,,Бұл менің хабарыммен бірінші кездесу.
Dialogue: 0,0:05:35.64,0:05:38.65,&,,0000,0000,0000,,Шоджин йогёсей
Dialogue: 0,0:05:35.64,0:05:38.65,,,0000,0000,0000,,Цин Шао Цинян
Dialogue: 0,0:05:39.95,0:05:42.04,CN,,0000,0000,0000,,Сізге ұқсайды, қысқа сөздер, жақсы сөздер
Dialogue: 0,0:05:42.36,0:05:43.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:44.23,0:05:45.79,CN,,0000,0000,0000,,Басқалар
Dialogue: 0,0:05:46.93,0:05:49.99,CN,,0000,0000,0000,,Айтқан кезде айтыңыз
Dialogue: 0,0:05:50.74,0:05:51.58,CN,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:05:51.78,0:05:53.50,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:54.39,0:05:56.08,CN,,0000,0000,0000,,Фудзивара бойынша тәжірибеші
Dialogue: 0,0:05:56.40,0:05:58.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:59.51,0:06:00.85,CN,,0000,0000,0000,,Аз сөздердің бұрынғы еркек досы
Dialogue: 0,0:06:02.89,0:06:05.75,CN,,0000,0000,0000,,Гүл базарына барар жолда қатты жаңбыр жауды
Dialogue: 0,0:06:06.22,0:06:09.70,CN,,0000,0000,0000,,Үй иесінің жаңбырдан қашуға асыққан кезі.Тадаари және басқалары жаңбыр кезінде станцияда жалғыз қалады.
Dialogue: 0,0:06:11.17,0:06:14.82,CN,,0000,0000,0000,,Жаңбырлы маусымнан гүл бағы кетеді
Dialogue: 0,0:06:15.22,0:06:17.98,CN,,0000,0000,0000,,Руоянтама тауы Ниндегі гүлдер астында дымқыл шомылу
Dialogue: 0,0:06:19.42,0:06:22.90,CN,,0000,0000,0000,,Сейге қарсы қала жаңбыр мен ылғалдылыққа толы.
Dialogue: 0,0:06:23.40,0:06:25.41,CN,,0000,0000,0000,,Басқа жерлерде қолданылған басқа өлеңдер
Dialogue: 0,0:06:28.09,0:06:30.13,CN,,0000,0000,0000,,Бұл нақты көрініс
Dialogue: 0,0:06:30.58,0:06:31.45,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:06:32.96,0:06:37.07,CN,,0000,0000,0000,,Мен құладым, оқиғаның желін көрдім.
Dialogue: 0,0:06:37.41,0:06:39.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:40.42,0:06:42.71,CN,,0000,0000,0000,,Жаңбырдан қалмау
Dialogue: 0,0:06:43.03,0:06:44.89,CN,,0000,0000,0000,,Нақты ересек адам басқа адам.
Dialogue: 0,0:06:45.27,0:06:48.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:48.27,0:06:50.11,CN,,0000,0000,0000,,Мен жаңа ғана нақты сынақты растадым.
Dialogue: 0,0:06:51.48,0:06:55.88,CN,,0000,0000,0000,,Бұл ерекше ұстаным.
Dialogue: 0,0:06:56.18,0:06:57.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:57.82,0:07:00.18,CN,,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,0:07:00.70,0:07:01.67,CN,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:07:02.47,0:07:04.80,CN,,0000,0000,0000,,Мемлекеттік қызметкердің ауызша хабарламасы
Dialogue: 0,0:07:05.05,0:07:07.24,CN,,0000,0000,0000,,Келесі әңгіме
Dialogue: 0,0:07:07.46,0:07:08.06,CN,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:12.98,0:07:14.20,CN,,0000,0000,0000,,Юкинари Гоку
Dialogue: 0,0:07:14.55,0:07:19.22,CN,,0000,0000,0000,,Сіз алған есімнің ересектерге арналған нұсқасы туралы не ойлайсыз?
Dialogue: 0,0:07:20.68,0:07:23.14,CN,,0000,0000,0000,,Орта сарайдағы Төтенше істер министрі
Dialogue: 0,0:07:23.57,0:07:26.43,CN,,0000,0000,0000,,Бұл бірінші рет отыру.
Dialogue: 0,0:07:26.57,0:07:28.54,CN,,0000,0000,0000,,Басқа жағдайларға байланысты рұқсат етілмеген
Dialogue: 0,0:07:28.81,0:07:31.37,CN,,0000,0000,0000,,Көптен бері кездеспеу
Dialogue: 0,0:07:31.60,0:07:32.66,CN,,0000,0000,0000,,Ресми кездесу
Dialogue: 0,0:07:33.46,0:07:35.00,CN,,0000,0000,0000,,Сіздің жұмысыңыз туралы кейбір мәліметтер бар.
Dialogue: 0,0:07:35.42,0:07:38.23,CN,,0000,0000,0000,,Мен үшін халықтан бөлек болу қиындығын қабылдау оңай емес
Dialogue: 0,0:07:38.50,0:07:39.72,CN,,0000,0000,0000,,Нада Макото ұмытылған
Dialogue: 0,0:07:39.90,0:07:42.23,CN,,0000,0000,0000,,Бұл жоспар сізге ең қолайлы.
Dialogue: 0,0:07:42.75,0:07:44.05,CN,,0000,0000,0000,,Қанша уақыт?
Dialogue: 0,0:07:44.52,0:07:46.28,CN,,0000,0000,0000,,Мен мектептің алдына бардым.
Dialogue: 0,0:07:46.76,0:07:47.73,CN,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:07:49.14,0:07:52.62,CN,,0000,0000,0000,,Ресми атақ жай ғана қуанышты ойын. Түпнұсқа табиғаты жақсы.
Dialogue: 0,0:07:53.29,0:07:54.49,CN,,0000,0000,0000,,Сізге сәттілік
Dialogue: 0,0:07:56.77,0:08:01.62,CN,,0000,0000,0000,,Ақиқат – кемелдік, Өмірімнің ортасынан жоқтың мәні.
Dialogue: 0,0:07:56.75,0:07:58.39,,,0000,0000,0000,,Мен отставкаға кететінімді бірінші болып жарияладым.
Dialogue: 0,0:08:03.36,0:08:05.52,CN,,0000,0000,0000,,Бұл менің бұрынғы еркек досым.
Dialogue: 0,0:08:10.52,0:08:14.89,CN,,0000,0000,0000,,Жағымсыз ниет
Dialogue: 0,0:08:18.76,0:08:22.81,,,0000,0000,0000,,...
Dialogue: 0,0:08:24.01,0:08:25.58,CN,,0000,0000,0000,,Юкинари сызығы
Dialogue: 0,0:08:27.32,0:08:30.05,CN,,0000,0000,0000,,Қажетсіз сәлемдесу
Dialogue: 0,0:08:35.35,0:08:36.96,CN,,0000,0000,0000,,Накая Хошиюки
Dialogue: 0,0:08:38.80,0:08:41.71,CN,,0000,0000,0000,,Сен ашулы емессің.
Dialogue: 0,0:08:42.26,0:08:44.24,CN,,0000,0000,0000,,Мен бұл оқиғаны ұмытып кеттім.
Dialogue: 0,0:08:44.47,0:08:48.59,CN,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:08:48.99,0:08:53.91,CN,,0000,0000,0000,,Үйдің әкесі алғаш рет жылқыны көруге келгенде төмен түсіп, қалпақпен ойнады.
Dialogue: 0,0:08:54.11,0:08:55.58,CN,,0000,0000,0000,,Дегенмен, басқа адамдар дүрбелеңде.
Dialogue: 0,0:08:55.83,0:08:59.53,CN,,0000,0000,0000,,Өзін-өзі мазақтауға қарсы: «Мен жек көретін адаммын, сондықтан, әрине, қалпақ киюім керек».
Dialogue: 0,0:08:59.80,0:09:01.19,CN,,0000,0000,0000,,Мен мұнда енді жоқпын.
Dialogue: 0,0:09:01.44,0:09:04.23,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:04.40,0:09:06.02,CN,,0000,0000,0000,,Талантты ойлайтын адамның орны
Dialogue: 0,0:09:06.59,0:09:09.99,CN,,0000,0000,0000,,Білікті адам екенің де рас.
Dialogue: 0,0:09:10.54,0:09:12.03,CN,,0000,0000,0000,,Мұнда көрсетілгендей, мен сізді шақырамын
Dialogue: 0,0:09:13.35,0:09:15.91,CN,,0000,0000,0000,,Жиналмалы желдеткішті ашыңыз.
Dialogue: 0,0:09:16.11,0:09:18.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:18.32,0:09:19.96,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:20.43,0:09:21.38,CN,,0000,0000,0000,,Ойын
Dialogue: 0,0:09:22.07,0:09:25.18,CN,,0000,0000,0000,,Әртүрлі қолдануға арналған ақиқат және әртүрлі өрнектер lol
Dialogue: 0,0:09:25.75,0:09:28.76,CN,,0000,0000,0000,,Шағын байланыс желісі орнатылды.
Dialogue: 0,0:09:30.70,0:09:32.86,CN,,0000,0000,0000,,Жаңа жылдан кейін
Dialogue: 0,0:09:33.21,0:09:34.35,CN,,0000,0000,0000,,Оқиға болған кезде
Dialogue: 0,0:09:37.06,0:09:40.86,CN,,0000,0000,0000,,Садако Накамияның ересек ағасы, ғибадатхана императоры
Dialogue: 0,0:09:41.51,0:09:42.80,CN,,0000,0000,0000,,Жауапкершілікті қабылдау
Dialogue: 0,0:09:45.86,0:09:48.79,CN,,0000,0000,0000,,Киім киген бала жүкті болған кезде
Dialogue: 0,0:09:50.06,0:09:51.80,CN,,0000,0000,0000,,Император сарайынан шығу
Dialogue: 0,0:09:54.66,0:09:57.36,CN,,0000,0000,0000,,Бір кездегі Чжунгуан Бай отбасы
Dialogue: 0,0:09:54.66,0:09:57.36,,,0000,0000,0000,,Накаканпаку отбасы: Хэйан дәуірінен бері Мичитака Фудзивараның ата-баба тегі
Dialogue: 0,0:09:57.41,0:10:00.22,CN,,0000,0000,0000,,Такаши Зайдо қайтыс болғаннан кейін
Dialogue: 0,0:10:00.40,0:10:05.29,CN,,0000,0000,0000,,Өзін ойлайтын әйел, Императрица мен Императрица
Dialogue: 0,0:10:06.41,0:10:09.54,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:09.67,0:10:12.38,CN,,0000,0000,0000,,Дүниенің ақыры келгені анық.
Dialogue: 0,0:10:20.60,0:10:21.47,CN,,0000,0000,0000,,Ересек бала
Dialogue: 0,0:10:22.07,0:10:22.72,CN,,0000,0000,0000,,Не?
Dialogue: 0,0:10:23.06,0:10:26.02,CN,,0000,0000,0000,,Юкинари Фудзивараның ересектерге сапары
Dialogue: 0,0:10:26.57,0:10:27.99,CN,,0000,0000,0000,,Юкинари Дайтоня
Dialogue: 0,0:10:28.95,0:10:30.55,CN,,0000,0000,0000,,Осыдан кейін
Dialogue: 0,0:10:30.84,0:10:32.04,CN,,0000,0000,0000,,Маған келе жатыр
Dialogue: 0,0:10:32.61,0:10:34.47,CN,,0000,0000,0000,,мүмкін емес мүмкін емес
Dialogue: 0,0:10:35.39,0:10:37.55,CN,,0000,0000,0000,,Төтенше жағдай болуы керек.
Dialogue: 0,0:10:39.39,0:10:41.38,CN,,0000,0000,0000,,Елордаға барғанда
Dialogue: 0,0:10:41.95,0:10:42.95,CN,,0000,0000,0000,,Операциялық мәселелер
Dialogue: 0,0:10:44.26,0:10:46.10,CN,,0000,0000,0000,,Орта мектептегі ересек адаммен байланыс орнатыңыз
Dialogue: 0,0:10:46.80,0:10:50.95,CN,,0000,0000,0000,,Бұл ұзақ жол.
Dialogue: 0,0:10:52.44,0:10:54.55,CN,,0000,0000,0000,,Exchange және басқа қызметші әйелдер жұмысқа орналаса алмайды.
Dialogue: 0,0:10:54.55,0:10:56.05,CN,,0000,0000,0000,,Мен басқалармен байланысты емеспін
Dialogue: 0,0:10:59.33,0:11:04.05,CN,,0000,0000,0000,,Жап-жас болсаң, менің кабинетіме келесің, мен саған осында боламын.
Dialogue: 0,0:11:08.03,0:11:12.62,CN,,0000,0000,0000,,2 курс Садако, Отоназу, Киёши, Шонин, Джугаэйшинчу
Dialogue: 0,0:11:19.04,0:11:23.66,CN,,0000,0000,0000,,Үйге мұғалімнің бірінші келуі, Юйю – үлкен перзент
Dialogue: 0,0:11:23.66,0:11:26.42,CN,,0000,0000,0000,,Үй иесі Томоюки ересектерден үлкен үміт күтеді, бірақ...
Dialogue: 0,0:11:26.91,0:11:29.55,CN,,0000,0000,0000,,Юкинари ересек шындық - бұл
Dialogue: 0,0:11:29.55,0:11:31.39,CN,,0000,0000,0000,,Бұл тамаша!
Dialogue: 0,0:11:31.64,0:11:33.05,CN,,0000,0000,0000,,Бұл ағымдағы кездесудің сипаттамасы.
Dialogue: 0,0:11:35.02,0:11:36.63,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:39.64,0:11:43.59,CN,,0000,0000,0000,,Сөзсіз күшті немесе жақсы және мейірімді емес басқа адамдар.
Dialogue: 0,0:11:43.59,0:11:45.59,CN,,0000,0000,0000,,Дегенмен, нақты жұмыс тұрғысынан бұл іс жүзінде практикалық.
Dialogue: 0,0:11:45.68,0:11:48.61,,,0000,0000,0000,,Көптеген алмасулар да қызықты.
Dialogue: 0,0:11:46.77,0:11:48.64,CN,,0000,0000,0000,,Басқа жаңылыстыратын түсініктемелер
Dialogue: 0,0:11:49.06,0:11:53.24,CN,,0000,0000,0000,,Айтуға да, жасауға да көп, айтылар сөздердің саны аз.
Dialogue: 0,0:11:53.43,0:11:55.47,CN,,0000,0000,0000,,Мен сені сүйемін деп емес.
Dialogue: 0,0:11:55.97,0:11:57.16,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:57.56,0:12:00.17,CN,,0000,0000,0000,,Адам дарындылығы мен жоғалтуының әртүрлі аспектілері туралы ойлар
Dialogue: 0,0:12:00.47,0:12:03.90,CN,,0000,0000,0000,,Еркек болған соң біртүрлі сезім.
Dialogue: 0,0:12:04.77,0:12:08.77,CN,,0000,0000,0000,,Бұлай айту мүмкін емес деп ойлаймын.
Dialogue: 0,0:12:11.53,0:12:12.47,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:13.04,0:12:15.78,CN,,0000,0000,0000,,Қазіргі бала мен ересек адамның қатысуымен
Dialogue: 0,0:12:16.40,0:12:19.53,CN,,0000,0000,0000,,Ересек адам
Dialogue: 0,0:12:19.85,0:12:22.89,CN,,0000,0000,0000,,Күтуші ханымның басқа түріне үміттену
Dialogue: 0,0:12:22.91,0:12:23.73,CN,,0000,0000,0000,,Міндетті емес
Dialogue: 0,0:12:24.28,0:12:25.45,CN,,0000,0000,0000,,…
Dialogue: 0,0:12:25.87,0:12:28.38,CN,,0000,0000,0000,,Өзіндік көзқарас
Dialogue: 0,0:12:29.50,0:12:31.16,CN,,0000,0000,0000,,Хикиконың достары
Dialogue: 0,0:12:31.63,0:12:35.11,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:37.10,0:12:39.19,CN,,0000,0000,0000,,Сезіміңді түсінемін.
Dialogue: 0,0:12:39.71,0:12:41.78,CN,,0000,0000,0000,,Дегенмен, қоғамдық және жеке істер арасында белгілі бір айырмашылық бар.
Dialogue: 0,0:12:43.34,0:12:45.18,CN,,0000,0000,0000,,Қайта тексеру немесе өлім тақтасын ұстау күйі
Dialogue: 0,0:12:45.65,0:12:47.62,CN,,0000,0000,0000,,«Токоро Юкакусумидегі тәртіпсіздік»
Dialogue: 0,0:12:45.65,0:12:47.62,,,0000,0000,0000,,：《》
Dialogue: 0,0:12:48.91,0:12:50.90,CN,,0000,0000,0000,,Тіршілік табиғатындағы өзгерістер
Dialogue: 0,0:12:51.52,0:12:52.91,CN,,0000,0000,0000,,Өлім тақтасының беріктігі табиғи
Dialogue: 0,0:12:53.58,0:12:56.89,CN,,0000,0000,0000,,「」
Dialogue: 0,0:12:53.58,0:12:56.89,,,0000,0000,0000,,Ескерту: Шығу орны
Dialogue: 0,0:12:57.28,0:13:02.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:04.17,0:13:04.91,CN,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:13:06.31,0:13:07.35,CN,,0000,0000,0000,,Мен сені қалай көремін?
Dialogue: 0,0:13:07.90,0:13:08.44,CN,,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:13:08.94,0:13:10.93,CN,,0000,0000,0000,,Вакайу тұрақты йога Кай Кай Сейко
Dialogue: 0,0:13:11.40,0:13:13.07,CN,,0000,0000,0000,,Сіз маған қалай қарайсыз?
Dialogue: 0,0:13:13.74,0:13:15.58,CN,,0000,0000,0000,,Сіздің тілектеріңіздің нәтижесінде
Dialogue: 0,0:13:15.88,0:13:16.75,CN,,0000,0000,0000,,Біздің оқуымыз
Dialogue: 0,0:13:17.96,0:13:19.68,CN,,0000,0000,0000,,Жақында
Dialogue: 0,0:13:20.37,0:13:21.94,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:22.26,0:13:25.94,CN,,0000,0000,0000,,Мен көргенде осыны айтқым келді.
Dialogue: 0,0:13:26.21,0:13:27.08,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:13:27.53,0:13:29.15,CN,,0000,0000,0000,,Менің сөзім түкке тұрғысыз.
Dialogue: 0,0:13:30.39,0:13:33.67,CN,,0000,0000,0000,,Менің жоқ екенімді білу жақсы, сондықтан ұнағаныңызға қуаныштымын.
Dialogue: 0,0:13:33.79,0:13:35.24,CN,,0000,0000,0000,,Иә? Жедел мәселе
Dialogue: 0,0:13:36.40,0:13:38.99,CN,,0000,0000,0000,,Көп уақыттың ортасында жүргеніме көп болды.
Dialogue: 0,0:13:39.46,0:13:43.46,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:13:43.64,0:13:46.15,CN,,0000,0000,0000,,Күтпеген жағдайларға байланысты
Dialogue: 0,0:13:46.50,0:13:48.11,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:13:54.70,0:13:57.43,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:57.65,0:14:01.01,CN,,0000,0000,0000,,Арамыздағы қашықтық қанша?
Dialogue: 0,0:14:02.08,0:14:03.30,CN,,0000,0000,0000,,Қажетсіз әңгіме
Dialogue: 0,0:14:03.30,0:14:06.45,CN,,0000,0000,0000,,Жақсы жағың болмаса, бос емессің.
Dialogue: 0,0:14:07.12,0:14:09.54,CN,,0000,0000,0000,,Бұл Нашу Кайдайдың қайталауы.
Dialogue: 0,0:14:14.80,0:14:17.09,CN,,0000,0000,0000,,Ой толғаныс келді.
Dialogue: 0,0:14:17.74,0:14:19.92,CN,,0000,0000,0000,,Мен жастардан үлкен үміт күтемін, т.б.
Dialogue: 0,0:14:20.20,0:14:23.80,CN,,0000,0000,0000,,Мені ерте көріп күліңіз.
Dialogue: 0,0:14:24.32,0:14:27.95,CN,,0000,0000,0000,,Тейко ересек Юкинари Ересек менің досым.
Dialogue: 0,0:14:28.08,0:14:28.97,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:29.62,0:14:33.69,CN,,0000,0000,0000,,Заманауи еркек досы тікелей қалаға келіп, Накакуда отырады.
Dialogue: 0,0:14:34.27,0:14:36.35,CN,,0000,0000,0000,,Өлі кескін 3-ке тең
Dialogue: 0,0:14:36.63,0:14:39.58,CN,,0000,0000,0000,,Өзін ұнатпайтын ғашық туралы әңгіме.
Dialogue: 0,0:14:40.06,0:14:41.60,CN,,0000,0000,0000,,Сізде жалпы тәртіп бар екенін көріп тұрмын.
Dialogue: 0,0:14:41.77,0:14:43.56,CN,,0000,0000,0000,,Гадай және т.б.
Dialogue: 0,0:14:43.66,0:14:47.76,CN,,0000,0000,0000,,Бір үлкен қыз бен жас жігіт бір жылдың ішінде көпіршіктерге түскендіктен, ол Хирохиромен кездесті, ол оны өте жақсы меңгерген.
Dialogue: 0,0:14:48.26,0:14:49.45,CN,,0000,0000,0000,,Мен не көріп тұрмын?
Dialogue: 0,0:14:49.90,0:14:53.63,CN,,0000,0000,0000,,Қанша жаста болсаңыз да, әйеліңіз бен балаларыңыз күшті, тәкаппар.
Dialogue: 0,0:14:54.02,0:14:57.01,CN,,0000,0000,0000,,Махаббат гүлі туралы не ойлайсың?
Dialogue: 0,0:14:57.21,0:14:59.37,CN,,0000,0000,0000,,Махаббатымды ояту
Dialogue: 0,0:14:59.69,0:15:02.13,CN,,0000,0000,0000,,Шындық, сіз оны көре аласыз.
Dialogue: 0,0:15:02.47,0:15:06.10,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:06.40,0:15:07.92,CN,,0000,0000,0000,,Бұл не деді?
Dialogue: 0,0:15:08.84,0:15:13.78,CN,,0000,0000,0000,,Менің талантым қандай?
Dialogue: 0,0:15:16.07,0:15:18.28,CN,,0000,0000,0000,,Бұлай істеу мүмкін емес.
Dialogue: 0,0:15:21.09,0:15:22.56,CN,,0000,0000,0000,,Мичитака қайтыс болғаннан кейін
Dialogue: 0,0:15:23.18,0:15:28.30,CN,,0000,0000,0000,,Император өмірге келген кезде Садако тек кәмелетке толған еді.
Dialogue: 0,0:15:29.54,0:15:31.83,CN,,0000,0000,0000,,Бірегей иық орналасуы және отбасылық өмір
Dialogue: 0,0:15:32.13,0:15:35.18,CN,,0000,0000,0000,,Ескі күшке күлуге болады
Dialogue: 0,0:15:38.96,0:15:43.43,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:44.06,0:15:45.52,CN,,0000,0000,0000,,Махаббатты жақсы көрмей тұра алмаймын
Dialogue: 0,0:15:46.22,0:15:49.25,CN,,0000,0000,0000,,Сырттай өткен тарихы бар адам.
Dialogue: 0,0:15:49.50,0:15:50.97,CN,,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,0:15:51.88,0:15:54.72,CN,,0000,0000,0000,,Жастар сұрақ қояды, Үлкендер дос.
Dialogue: 0,0:15:55.41,0:15:55.96,CN,,0000,0000,0000,,Мынау жау
Dialogue: 0,0:15:57.60,0:15:58.74,CN,,0000,0000,0000,,Қазіргі уақытта түнді қалдыру қажет
Dialogue: 0,0:16:00.51,0:16:01.45,CN,,0000,0000,0000,,Кишин ересек
Dialogue: 0,0:16:04.91,0:16:07.64,CN,,0000,0000,0000,,Жастық кітабы туралы не деуге болады?
Dialogue: 0,0:16:08.04,0:16:10.43,CN,,0000,0000,0000,,Келесі көріністі жоғалтты
Dialogue: 0,0:16:10.58,0:16:12.19,CN,,0000,0000,0000,,Жазбаны оқығаннан кейін мен оны көрдім.
Dialogue: 0,0:16:12.66,0:16:14.70,CN,,0000,0000,0000,,Ауылдың әртүрлі жағдайлары
Dialogue: 0,0:16:15.27,0:16:17.29,CN,,0000,0000,0000,,Басты кейіпкерлер қандай?
Dialogue: 0,0:16:18.13,0:16:20.84,CN,,0000,0000,0000,,Сен маған қамқорсың.
Dialogue: 0,0:16:22.63,0:16:25.59,CN,,0000,0000,0000,,Соңғы уақытта мен көп ақша жоғалттым.
Dialogue: 0,0:16:25.79,0:16:28.62,CN,,0000,0000,0000,,Бұл көру мүмкіндігі.
Dialogue: 0,0:16:29.07,0:16:32.40,CN,,0000,0000,0000,,Бетті көру қиын болғандықтан, ақшаны қайтаруға болады.
Dialogue: 0,0:16:32.57,0:16:34.73,CN,,0000,0000,0000,,Мейірімсіз бе? Аз айтылған сөздер
Dialogue: 0,0:16:35.11,0:16:37.00,CN,,0000,0000,0000,,Менің жеке көзқарасым емес
Dialogue: 0,0:16:37.72,0:16:39.26,CN,,0000,0000,0000,,Оны қолданбаңыз.
Dialogue: 0,0:16:40.75,0:16:44.45,CN,,0000,0000,0000,,Менімен келісетініңізге сенімдімін.
Dialogue: 0,0:16:44.77,0:16:46.56,CN,,0000,0000,0000,,Алайда бұл қалада оған тиімді болғандықтан.
Dialogue: 0,0:16:47.71,0:16:49.32,CN,,0000,0000,0000,,Яня Фукачи туралы бір ой
Dialogue: 0,0:16:50.42,0:16:52.68,CN,,0000,0000,0000,,Негізгі жастық кітабы Чууя мынандай
Dialogue: 0,0:16:54.14,0:16:55.78,CN,,0000,0000,0000,,Нёга генералы Шунбидің дворян балалары
Dialogue: 0,0:16:56.03,0:16:58.17,CN,,0000,0000,0000,,Басқалармен тең қатынастағы лауазымды әйел
Dialogue: 0,0:16:58.92,0:17:02.59,CN,,0000,0000,0000,,Мен орта мектепте шахмат ойнаймын.
Dialogue: 0,0:17:04.41,0:17:07.71,CN,,0000,0000,0000,,Оны алудың пайдасы да сөзсіз.
Dialogue: 0,0:17:08.46,0:17:09.65,CN,,0000,0000,0000,,Дегенмен, бұл
Dialogue: 0,0:17:11.07,0:17:13.08,CN,,0000,0000,0000,,Менің не айтқым келеді?
Dialogue: 0,0:17:13.46,0:17:15.99,CN,,0000,0000,0000,,Дегенмен, қорғаныс деңгейі бірдей
Dialogue: 0,0:17:17.78,0:17:19.42,CN,,0000,0000,0000,,Дұрыс немесе бұрыс себеп дегеніміз не?
Dialogue: 0,0:17:19.74,0:17:21.88,CN,,0000,0000,0000,,Егер сіз дарынды адам болсаңыз, бұл жерде жүруді доғарыңыз.
Dialogue: 0,0:17:22.11,0:17:24.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:25.19,0:17:26.50,CN,,0000,0000,0000,,Сізге бір сынақты орындау керек
Dialogue: 0,0:17:27.13,0:17:29.56,CN,,0000,0000,0000,,Мақсатқа жету
Dialogue: 0,0:17:30.08,0:17:33.86,CN,,0000,0000,0000,,Сезіміңіздің сәтті табысы.
Dialogue: 0,0:17:36.25,0:17:39.45,CN,,0000,0000,0000,,Сейшо кото конто юкинари ересек кото рио
Dialogue: 0,0:17:39.90,0:17:40.72,CN,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:17:42.93,0:17:44.65,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:42.93,0:17:44.65,,,0000,0000,0000,,Таңнан кейінгі жазбалар: Ерлер мен әйелдердің бір-бірімен кездесетін екінші аспаны, ер мен әйелдің махаббаты. Толық түсініктеме 2-ші эпизод PDF
Dialogue: 0,0:17:45.19,0:17:48.43,CN,,0000,0000,0000,,Кешіріңіз, мен не істерімді білмеймін
Dialogue: 0,0:17:48.80,0:17:51.31,CN,,0000,0000,0000,,Ағашта бір адам да бар.
Dialogue: 0,0:17:54.22,0:17:56.18,CN,,0000,0000,0000,,Бүгін таңертең мен сені көрдім.
Dialogue: 0,0:17:56.88,0:17:59.21,CN,,0000,0000,0000,,Хонсо якё коджи
Dialogue: 0,0:17:59.73,0:18:01.37,CN,,0000,0000,0000,,Музыканы қайда жіберу керек
Dialogue: 0,0:18:02.59,0:18:05.85,CN,,0000,0000,0000,,Таңертең мен кешке кеткеніме көп болды.
Dialogue: 0,0:18:08.43,0:18:10.50,CN,,0000,0000,0000,,Басқа партиялар түрлі ойындарды ашады
Dialogue: 0,0:18:10.67,0:18:13.98,CN,,0000,0000,0000,,Бекітілген жиналыстың сипаттамаларын өзгерту қажет.
Dialogue: 0,0:18:15.34,0:18:18.15,CN,,0000,0000,0000,,Түннің соңы
Dialogue: 0,0:18:19.15,0:18:22.25,CN,,0000,0000,0000,,Бұл алыстағы ұлы Тан әулетінің жері ғана.
Dialogue: 0,0:18:22.97,0:18:28.62,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:28.89,0:18:31.80,CN,,0000,0000,0000,,Академиялық мектеп оқушылары
Dialogue: 0,0:18:32.67,0:18:36.37,CN,,0000,0000,0000,,Бұл жай ғана адамның дауысы.
Dialogue: 0,0:18:40.20,0:18:45.29,CN,,0000,0000,0000,,Түпнұсқа осы жерден шыққан.
Dialogue: 0,0:18:46.11,0:18:49.32,CN,,0000,0000,0000,,Мен ұқсас әдісті жасау үшін пайдаланған белгілі бір жол картасы туралы әңгіме.
Dialogue: 0,0:18:50.26,0:18:54.24,CN,,0000,0000,0000,,Ойланып қарасаңыз, оның өзара махаббат хикаясы болуының алдын алуға болады.
Dialogue: 0,0:18:54.99,0:18:57.20,CN,,0000,0000,0000,,Көрменің жақсы бейнесі.
Dialogue: 0,0:18:57.60,0:19:00.48,CN,,0000,0000,0000,,Мен басқа адамдармен кездесуге қызықпаймын.
Dialogue: 0,0:19:01.07,0:19:03.81,CN,,0000,0000,0000,,Мофей, басқалары болмыстың шынайы ұмтылысы.
Dialogue: 0,0:19:04.90,0:19:06.97,CN,,0000,0000,0000,,Ғашық жақсы жұмыс істемейді
Dialogue: 0,0:19:08.33,0:19:10.35,CN,,0000,0000,0000,,Аффирмация – белгілі бір адамның итермелеуі
Dialogue: 0,0:19:12.76,0:19:14.37,CN,,0000,0000,0000,,Қызметшіге қызмет ететін сот әйелі
Dialogue: 0,0:19:14.69,0:19:18.92,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:21.13,0:19:36.44,&,,0000,0000,0000,,Гошин Танби Осакакан
Dialogue: 0,0:19:22.51,0:19:36.44,&,,0000,0000,0000,,Mind Ruing Mei Ruiwa
Dialogue: 0,0:19:23.76,0:19:36.44,&,,0000,0000,0000,,Түнгі дыбыс
Dialogue: 0,0:19:25.30,0:19:36.44,&,,0000,0000,0000,,Өзін-өзі құрбан ету
Dialogue: 0,0:19:29.18,0:19:32.64,CN,,0000,0000,0000,,Бұл махаббат хикаясының аты.
Dialogue: 0,0:19:33.16,0:19:35.80,CN,,0000,0000,0000,,Менің бақытсыздығым – қорғаным.
Dialogue: 0,0:19:37.31,0:19:39.57,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:39.75,0:19:42.98,CN,,0000,0000,0000,,Дегенмен жапон поэзиясының талантты және қызықты түрлері көп.
Dialogue: 0,0:19:45.04,0:19:49.42,CN,,0000,0000,0000,,Кіріспе Бұл менің ересектерге арналған алғашқы өлеңім.
Dialogue: 0,0:19:50.04,0:19:51.88,CN,,0000,0000,0000,,Бір-бірімізден тікелей қашуға мүмкіндік беретін өлең.
Dialogue: 0,0:19:52.70,0:19:54.98,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:55.36,0:19:57.22,CN,,0000,0000,0000,,Ересектердің хат алмасуы
Dialogue: 0,0:19:57.29,0:19:58.89,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:00.17,0:20:08.85,&,,0000,0000,0000,,Вакатон Осакакан
Dialogue: 0,0:20:01.67,0:20:08.85,&,,0000,0000,0000,,Адамның тіл алмасуы
Dialogue: 0,0:20:02.80,0:20:08.85,&,,0000,0000,0000,,Дауыс жоқ
Dialogue: 0,0:20:04.51,0:20:08.85,&,,0000,0000,0000,,Әрқашан қонақтарды күту
Dialogue: 0,0:20:09.10,0:20:10.19,CN,,0000,0000,0000,,Қорғаныс қорғанысы
Dialogue: 0,0:20:10.72,0:20:14.47,CN,,0000,0000,0000,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,0:20:16.66,0:20:20.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:21.95,0:20:24.71,CN,,0000,0000,0000,,Тайрайшыта арсыздығы
Dialogue: 0,0:20:27.82,0:20:30.05,CN,,0000,0000,0000,,Ерлікті жігерлендіріп, бір өлеңді аяқтаймын.
Dialogue: 0,0:20:30.18,0:20:31.94,CN,,0000,0000,0000,,Сенімнен айырылғаныма өкінемін.
Dialogue: 0,0:20:32.49,0:20:34.35,CN,,0000,0000,0000,,Мен қандаймын?
Dialogue: 0,0:20:34.53,0:20:35.79,CN,,0000,0000,0000,,Мен оны көрмеймін.
Dialogue: 0,0:20:36.39,0:20:37.86,CN,,0000,0000,0000,,Ойынды ашып күліңіз.
Dialogue: 0,0:20:38.08,0:20:41.16,CN,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:20:42.13,0:20:42.65,CN,,0000,0000,0000,,Бұл бөлім
Dialogue: 0,0:20:42.90,0:20:46.33,CN,,0000,0000,0000,,Менің кітабым
Dialogue: 0,0:20:42.90,0:20:46.33,,,0000,0000,0000,,Зоши: Жапондық әдебиет стилі
Dialogue: 0,0:20:46.70,0:20:48.20,CN,,0000,0000,0000,,Үлкендермен қарым-қатынас
Dialogue: 0,0:20:48.99,0:20:50.66,CN,,0000,0000,0000,,Жақсы образдар мен адамдар арасындағы өзара орындау
Dialogue: 0,0:20:51.10,0:20:54.04,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:54.66,0:20:55.60,CN,,0000,0000,0000,,Қабылдау
Dialogue: 0,0:20:56.10,0:20:57.81,CN,,0000,0000,0000,,Мұның мәні неде?
Dialogue: 0,0:21:00.20,0:21:01.82,CN,,0000,0000,0000,,Қалаған кездесу
Dialogue: 0,0:21:02.69,0:21:07.41,CN,,0000,0000,0000,,Менің сізбен ерекше байланысым үшін қандай жоспарларыңыз бар?
Dialogue: 0,0:21:08.30,0:21:11.29,CN,,0000,0000,0000,,Мен қайда сөйлей аламын?
Dialogue: 0,0:21:11.71,0:21:14.94,CN,,0000,0000,0000,,Дегенмен, мен оны көріп тұрмын және сіз жақын дос болу үшін кедергіден өте аласыз.
Dialogue: 0,0:21:15.56,0:21:17.60,CN,,0000,0000,0000,,Мен ойлағандай емес.
Dialogue: 0,0:21:19.29,0:21:21.10,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:21:22.20,0:21:26.57,CN,,0000,0000,0000,,Менің жүрегім махаббатқа толы
Dialogue: 0,0:21:27.69,0:21:29.88,CN,,0000,0000,0000,,Қолданыстағы білім мен біздің мекеме арасындағы қайшылық
Dialogue: 0,0:21:30.52,0:21:32.64,CN,,0000,0000,0000,,Бұған назар аударудың қажеті жоқ.
Dialogue: 0,0:21:32.71,0:21:36.81,CN,,0000,0000,0000,,Бірлестігіңіздің негізгі сезімдері әртүрлі.
Dialogue: 0,0:21:38.85,0:21:40.49,CN,,0000,0000,0000,,Кроссовер орны
Dialogue: 0,0:21:40.76,0:21:45.71,CN,,0000,0000,0000,,Нобуюки Цукамори осында
Dialogue: 0,0:21:46.78,0:21:47.67,CN,,0000,0000,0000,,Бұл 3
Dialogue: 0,0:21:48.24,0:21:49.31,CN,,0000,0000,0000,,Жедел жеткізу осында.
Dialogue: 0,0:21:50.26,0:21:52.99,CN,,0000,0000,0000,,Өмірімде жас өлгеніме өкінемін.
Dialogue: 0,0:21:53.46,0:21:55.05,CN,,0000,0000,0000,,Ыңғайлылық және өлімсіздік
Dialogue: 0,0:21:56.77,0:21:58.76,CN,,0000,0000,0000,,Ақпаратты жазу
Dialogue: 0,0:21:59.60,0:22:03.13,CN,,0000,0000,0000,,Өлімге де, өлімге де қарамай, тастап кетпейтін сенімдегі өмір.
Dialogue: 0,0:22:04.18,0:22:07.43,CN,,0000,0000,0000,,Бұл адамның өз ойымен сөйлесу қабілеті
Dialogue: 0,0:22:08.10,0:22:11.33,CN,,0000,0000,0000,,…
Dialogue: 0,0:22:13.17,0:22:16.78,CN,,0000,0000,0000,,Бұрын мен өзімнің қызметшіммін дедің.
Dialogue: 0,0:22:18.39,0:22:20.01,CN,,0000,0000,0000,,Махаббат махаббат кітабы
Dialogue: 0,0:22:20.45,0:22:23.66,CN,,0000,0000,0000,,Менің жүрегімнің картасы генерал - ойнауға ұзақ жол.
Dialogue: 0,0:22:26.52,0:22:29.43,CN,,0000,0000,0000,,Ашылатын қақпаның ашылуына назар аударыңыз.
Dialogue: 0,0:22:29.68,0:22:32.19,CN,,0000,0000,0000,,Бір эпизод
Dialogue: 0,0:22:32.56,0:22:33.38,CN,,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:22:33.85,0:22:36.68,CN,,0000,0000,0000,,себебі
Dialogue: 0,0:22:36.68,0:22:38.05,CN,,0000,0000,0000,,Мені көруге келгенде, сіз әрқашан боссыз.
Dialogue: 0,0:22:38.72,0:22:40.11,CN,,0000,0000,0000,,Мен саған қараймын
Dialogue: 0,0:22:40.19,0:22:41.98,CN,,0000,0000,0000,,Мен сенімен танысқым келеді! !
Dialogue: 0,0:24:17.47,0:24:21.97,CN,,0000,0000,0000,,Бұрынғы заманда заманның үні бүгін ағылды.
Dialogue: 0,0:24:22.49,0:24:26.07,CN,,0000,0000,0000,,Ұшатын сарқырама
Dialogue: 0,0:24:27.57,0:24:33.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory