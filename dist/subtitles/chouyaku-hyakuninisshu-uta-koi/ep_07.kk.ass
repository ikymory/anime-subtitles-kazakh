Dialogue: 0,0:02:29.04,0:02:38.97,LOGO,,0000,0000,0000,,Бұл субтитр көзін God Subtitles Group (kamigami.org) жасаған, пайдаланушы ұсынған және коммерциялық пайдалануға тыйым салынған.
Dialogue: 0,0:02:29.04,0:02:38.97,,,0000,0000,0000,,: &  :Thomasday :apollius & Syura : : :
Dialogue: 0,0:00:09.00,0:00:12.49,JP,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз. Бұл Тейка Фудзивара.
Dialogue: 0,0:00:13.01,0:00:15.01,JP,,0000,0000,0000,,Қазіргі уақытта салынып жатыр
Dialogue: 0,0:00:15.44,0:00:18.33,JP,,0000,0000,0000,,Сәлеметсіз бе, бұл Йорицуна Уцуномия.
Dialogue: 0,0:00:18.51,0:00:21.67,JP,,0000,0000,0000,,Хякунин Исшу мен Йорицунаның өтініші бойынша таңдадым.
Dialogue: 0,0:00:22.09,0:00:26.27,JP,,0000,0000,0000,,Шын мәнінде, әндердің шамамен үштен бірін Фудзивара руы оқыды.
Dialogue: 0,0:00:26.87,0:00:28.61,JP,,0000,0000,0000,,Осылайша мен де Фудзивара мырзамын.
Dialogue: 0,0:00:28.95,0:00:31.57,JP,,0000,0000,0000,,Негізі Йорицуна-кун да Фудзивараның жолдасы.
Dialogue: 0,0:00:31.79,0:00:32.62,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:00:33.00,0:00:36.31,JP,,0000,0000,0000,,Фудзивараның қатынасы сол кезде императорлық сотта жоғары болды.
Dialogue: 0,0:00:36.40,0:00:37.49,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:00:37.86,0:00:41.87,JP,,0000,0000,0000,,Мен сені Фудзивара-кун десем, бәрі бірден айналады.
Dialogue: 0,0:00:42.50,0:00:43.87,JP,,0000,0000,0000,,Бұл аздап қорқынышты.
Dialogue: 0,0:00:44.33,0:00:49.57,JP,,0000,0000,0000,,Бүгін мен Фудзивараның екі мұрагері арасындағы махаббат туралы сөйлесемін.
Dialogue: 0,0:00:50.26,0:00:53.62,JP,,0000,0000,0000,,Екеуі немере ағайынды және өте жақын еді.
Dialogue: 0,0:00:53.87,0:00:54.89,JP,,0000,0000,0000,,Тейка-кун
Dialogue: 0,0:00:56.23,0:00:57.66,JP,,0000,0000,0000,,Бұл жаман емес.
Dialogue: 0,0:02:43.10,0:02:47.31,JP,,0000,0000,0000,,Йошитака Фудзивара регент және мемлекеттік министрдің отбасында дүниеге келген.
Dialogue: 0,0:02:48.38,0:02:49.48,JP,,0000,0000,0000,,Құрметті Йошитака
Dialogue: 0,0:02:50.68,0:02:51.88,JP,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:02:52.25,0:02:53.79,JP,,0000,0000,0000,,Бүгін таңертең күн жылы.
Dialogue: 0,0:02:54.16,0:02:57.81,JP,,0000,0000,0000,,Иә, күніңіз тыныш болсын деп үміттенемін.
Dialogue: 0,0:02:58.32,0:03:02.29,JP,,0000,0000,0000,,Имандылыққа жаны құмар, келбетіне батасын берген.
Dialogue: 0,0:03:02.66,0:03:07.30,JP,,0000,0000,0000,,Император сарайындағы әйелдер арасында жақсы беделге ие болды және болашағы зор болды.
Dialogue: 0,0:03:08.94,0:03:11.46,JP,,0000,0000,0000,,Оның күйеу жігіті болған
Dialogue: 0,0:03:20.70,0:03:21.78,JP,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:03:39.09,0:03:40.57,JP,,0000,0000,0000,,Мен мәтінді жеткізуге келдім.
Dialogue: 0,0:03:47.41,0:03:49.59,JP,,0000,0000,0000,,Мен Йошитака мырзадан хат алдым.
Dialogue: 0,0:03:50.52,0:03:52.35,JP,,0000,0000,0000,,Иә, бар.
Dialogue: 0,0:04:14.15,0:04:15.26,JP,,0000,0000,0000,,(Отокоцудың дауысы)
Dialogue: 0,0:04:15.26,0:04:16.56,JP,,0000,0000,0000,,Бұл тамаша.
Dialogue: 0,0:04:17.52,0:04:18.29,JP,,0000,0000,0000,,Мичитака-сама
Dialogue: 0,0:04:18.78,0:04:22.11,JP,,0000,0000,0000,,Ол тіпті жәндіктерді де өлтіре алмайтын сияқты, бірақ иілуді де жақсы біледі.
Dialogue: 0,0:04:23.27,0:04:25.70,JP,,0000,0000,0000,,Сіз нені жақсы білмейсіз? Йошитака
Dialogue: 0,0:04:26.41,0:04:28.68,JP,,0000,0000,0000,,Саған бірдеңе керек пе, Мичитака?
Dialogue: 0,0:04:29.31,0:04:31.11,JP,,0000,0000,0000,,Әкешім
Dialogue: 0,0:04:31.99,0:04:33.12,JP,,0000,0000,0000,,Кани-доно?
Dialogue: 0,0:04:34.84,0:04:36.55,JP,,0000,0000,0000,,Бұл самурайдың рухы ма?
Dialogue: 0,0:04:37.00,0:04:40.28,JP,,0000,0000,0000,,Ах, Сакё қаласының шетіндегі бұзылған храмда.
Dialogue: 0,0:04:40.68,0:04:42.67,JP,,0000,0000,0000,,Түнде түнде шығады.
Dialogue: 0,0:04:43.00,0:04:45.02,JP,,0000,0000,0000,,Сіз қорқасыз ба? Сіз қорқасыз ба?
Dialogue: 0,0:04:45.59,0:04:49.13,JP,,0000,0000,0000,,Неліктен ол бұл дүниеде тұзаққа түсті?
Dialogue: 0,0:04:51.08,0:04:53.32,JP,,0000,0000,0000,,Бұл тағы бір аянышты оқиға.
Dialogue: 0,0:04:54.32,0:04:57.08,JP,,0000,0000,0000,,Самурайлар патша сарайында қызмет ететін күзетшілер болды.
Dialogue: 0,0:04:57.53,0:05:00.44,JP,,0000,0000,0000,,Бәле-жаламды жоқтап, Бандоға түстім.
Dialogue: 0,0:05:00.82,0:05:05.58,JP,,0000,0000,0000,,Алайда Кионың бір өкініші бар: ол әйелді қалдырды.
Dialogue: 0,0:05:06.46,0:05:09.91,JP,,0000,0000,0000,,Мен сені бір күні алып кетейін деп жүргенімде,
Dialogue: 0,0:05:11.34,0:05:14.60,JP,,0000,0000,0000,,Әйелдің өзін тастап кеткені соншалық, өз-өзіне қол жұмсады.
Dialogue: 0,0:05:15.31,0:05:19.19,JP,,0000,0000,0000,,Самурай қатты өкінген сияқты.
Dialogue: 0,0:05:20.50,0:05:23.79,JP,,0000,0000,0000,,Осы өкініштің кесірінен ол әлі Буддалыққа жете алмаған сияқты.
Dialogue: 0,0:05:24.33,0:05:29.47,JP,,0000,0000,0000,,Еңбегіңіз үшін рахмет. Бүгін кешке мен сіздерге еске алу кешін ұсынамын.
Dialogue: 0,0:05:27.83,0:05:29.33,JP-,,0000,0000,0000,,Демек, бұл менмін
Dialogue: 0,0:05:29.96,0:05:33.07,JP,,0000,0000,0000,,Йошитака күткендей, мен қатты әсер алдым.
Dialogue: 0,0:05:33.47,0:05:35.30,JP,,0000,0000,0000,,Мичитака, сенің де баруың керек.
Dialogue: 0,0:05:35.30,0:05:36.24,JP,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:05:36.39,0:05:39.91,JP,,0000,0000,0000,,Йошитакадан үлгі алып, буддизмге ұмтыл.
Dialogue: 0,0:05:40.49,0:05:42.19,JP,,0000,0000,0000,,Мұны өз жігеріңді сынау деп ойлап, кет.
Dialogue: 0,0:05:44.68,0:05:49.03,JP,,0000,0000,0000,,Мен өткен күні қарауылдан өте жақсы әйел таптым.
Dialogue: 0,0:05:49.91,0:05:51.89,JP,,0000,0000,0000,,Мен бұлай болмайды деп ойладым.
Dialogue: 0,0:05:52.42,0:05:53.34,JP,,0000,0000,0000,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:05:54.12,0:05:55.17,JP,,0000,0000,0000,,Сіз ше?
Dialogue: 0,0:05:55.50,0:05:59.03,JP,,0000,0000,0000,,Сонда Ясукоу-доно қызының жағдайы жақсы ма?
Dialogue: 0,0:05:59.51,0:06:01.98,JP,,0000,0000,0000,,Иә, біз мәтіндермен алмасып жатырмыз.
Dialogue: 0,0:06:02.52,0:06:05.65,JP,,0000,0000,0000,,көремін. Сіз қалай ойлайсыз? Әдемі әйел?
Dialogue: 0,0:06:06.49,0:06:09.59,JP,,0000,0000,0000,,Мен жаңа ғана артқы жағын көрдім, сондықтан сіздің бетіңізді көре алмаймын.
Dialogue: 0,0:06:10.18,0:06:11.71,JP,,0000,0000,0000,,Қылқалам керемет.
Dialogue: 0,0:06:12.52,0:06:14.46,JP,,0000,0000,0000,,Сонымен қатар сізде мысық бар.
Dialogue: 0,0:06:14.76,0:06:18.15,JP,,0000,0000,0000,,Тоқта, күте тұр, күте тұр, бәлкім, әлі дұрыстап кездеспеген шығармыз?
Dialogue: 0,0:06:18.51,0:06:18.98,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:06:19.84,0:06:23.23,JP,,0000,0000,0000,,Неліктен? Соңғы рет сөйлескенімізге біраз болды.
Dialogue: 0,0:06:23.35,0:06:25.85,JP,,0000,0000,0000,,Мен күзгі босатуды күтемін деп ойладым.
Dialogue: 0,0:06:26.22,0:06:30.41,JP,,0000,0000,0000,,Қарсы жақтың дәрежесі көтерілгені абыройлы болар еді.
Dialogue: 0,0:06:30.44,0:06:33.43,JP,,0000,0000,0000,,Міне, міне, байсалды Пак Ын Ин
Dialogue: 0,0:06:34.07,0:06:37.56,JP,,0000,0000,0000,,Егер сіз тек мәңгілік сөйлемдермен алмассаңыз, басқа адам өзін жайсыз сезінуі мүмкін.
Dialogue: 0,0:06:38.03,0:06:41.45,JP,,0000,0000,0000,,Сіз менімен некеге тұруды қаламайсыз ба?
Dialogue: 0,0:06:42.72,0:06:45.63,JP,,0000,0000,0000,,Жарайды, мен өз сезімімді жазбаша жеткіздім.
Dialogue: 0,0:06:45.68,0:06:50.00,JP,,0000,0000,0000,,Сөйлемде сөздерді қайталаудың орнына өз іс-әрекетін көрсету қажет болатын кездер болады.
Dialogue: 0,0:06:50.24,0:06:52.24,JP,,0000,0000,0000,,Ей, аздап күштірек болған дұрыс.
Dialogue: 0,0:06:53.05,0:06:56.01,JP,,0000,0000,0000,,Әйелдер ерлердің мұндай күшіне таң қалды.
Dialogue: 0,0:06:56.58,0:06:59.55,JP,,0000,0000,0000,,Бұл ер адамдарға ыңғайлы ойлау тәсілі.
Dialogue: 0,0:06:59.91,0:07:04.16,JP,,0000,0000,0000,,Ол пәк; ол дөрекі мінезді ұнатпайды.
Dialogue: 0,0:07:04.60,0:07:07.26,JP,,0000,0000,0000,,Жоқ, мен осындай әулие сүзгіні қоямын.
Dialogue: 0,0:07:07.56,0:07:09.63,JP,,0000,0000,0000,,Сіз мені итермелеп жатырсыз, мені көруге барыңыз.
Dialogue: 0,0:07:09.84,0:07:11.29,JP,,0000,0000,0000,,Мичитаканы тыныштандырыңыз
Dialogue: 0,0:07:11.62,0:07:13.62,JP,,0000,0000,0000,,Неге сонша асығасың?
Dialogue: 0,0:07:13.92,0:07:16.49,JP,,0000,0000,0000,,О, бұл сенсің.
Dialogue: 0,0:07:17.29,0:07:18.75,JP,,0000,0000,0000,,Бұл туралы айтпай-ақ қояйық.
Dialogue: 0,0:07:20.12,0:07:23.41,JP,,0000,0000,0000,,Қорқынышты, батылдық сынағы, мүмкін емес.
Dialogue: 0,0:07:24.02,0:07:25.50,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:07:30.21,0:07:31.29,JP,,0000,0000,0000,,Сіз шынымен барасыз ба?
Dialogue: 0,0:07:32.24,0:07:35.52,JP,,0000,0000,0000,,Мен ағамның айтқанына толық сенбедім.
Dialogue: 0,0:07:36.16,0:07:38.81,JP,,0000,0000,0000,,Егер біреу шынымен қиналып жатса
Dialogue: 0,0:07:38.82,0:07:39.94,JP,,0000,0000,0000,,Мен оны лақтыра алмаймын.
Dialogue: 0,0:07:40.20,0:07:42.31,JP,,0000,0000,0000,,Мен қамауға алынсам не істеуім керек?
Dialogue: 0,0:07:42.80,0:07:44.87,JP,,0000,0000,0000,,Егер бұл орын алса, онда бәрі жақсы.
Dialogue: 0,0:07:45.47,0:07:49.01,JP,,0000,0000,0000,,Қазір не істей алатыныңызды елемеу дұрыс емес.
Dialogue: 0,0:07:50.36,0:07:51.75,JP,,0000,0000,0000,,Мен Мичитака Сасамын
Dialogue: 0,0:07:53.38,0:07:58.49,JP,,0000,0000,0000,,Мен өз өмірімді әр күнімді бағалаймын және оны еш өкінбей жасаймын.
Dialogue: 0,0:07:58.75,0:08:01.55,JP,,0000,0000,0000,,Сондықтан мен өлсем де бәрібір.
Dialogue: 0,0:08:02.35,0:08:05.67,JP,,0000,0000,0000,,Мен көремін. Өкінішке орай, менде өкініштен басқа ештеңе жоқ.
Dialogue: 0,0:08:20.02,0:08:23.17,JP,,0000,0000,0000,,Ол апатты жағдайда. Келесі жолы келіп күтім жасауым керек пе?
Dialogue: 0,0:08:23.37,0:08:24.80,JP,,0000,0000,0000,,А, күндіз.
Dialogue: 0,0:08:26.35,0:08:28.79,JP,,0000,0000,0000,,Қараңдаршы, мұнда ешкім жоқ, енді үйге қайтайық.
Dialogue: 0,0:08:29.81,0:08:31.31,JP,,0000,0000,0000,,Тағы біраз күтіңіз
Dialogue: 0,0:08:35.48,0:08:37.22,JP,,0000,0000,0000,,шықты аааааааааааааааааааааааааа
Dialogue: 0,0:08:39.18,0:08:40.58,JP,,0000,0000,0000,,Йошитаканы қашу
Dialogue: 0,0:08:40.58,0:08:41.32,JP,,0000,0000,0000,,Мичитака
Dialogue: 0,0:08:45.56,0:08:49.30,JP,,0000,0000,0000,,Бодхисаттваның терең праджнапарамита уақыттарына саяхаты
Dialogue: 0,0:08:50.11,0:08:51.28,JP-,,0000,0000,0000,,өледі өледі
Dialogue: 0,0:08:49.32,0:08:53.00,JP,,0000,0000,0000,,Теруми Гогаку Миназора Дәрежелер Барлық бақытсыздықтар Шарико
Dialogue: 0,0:08:51.60,0:08:53.57,JP-,,0000,0000,0000,,Қылыш ұстаған жігіт өлтіріледі
Dialogue: 0,0:08:53.26,0:08:57.75,JP,,0000,0000,0000,,...
Dialogue: 0,0:09:17.08,0:09:17.63,JP,,0000,0000,0000,,Кім?
Dialogue: 0,0:09:18.90,0:09:20.95,JP,,0000,0000,0000,,Үзіліс үшін кешірім сұраймын.
Dialogue: 0,0:09:22.09,0:09:23.99,JP,,0000,0000,0000,,Йошитака Фудзивара келді.
Dialogue: 0,0:09:27.61,0:09:30.63,JP,,0000,0000,0000,,Сенің бүгін кешке келетініңді естімедім.
Dialogue: 0,0:09:31.32,0:09:32.42,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:09:33.26,0:09:35.42,JP,,0000,0000,0000,,Шегінуге болмайтын жағдайлар бар.
Dialogue: 0,0:09:36.38,0:09:38.16,JP,,0000,0000,0000,,Жағдайлар дегеніміз не?
Dialogue: 0,0:09:38.73,0:09:42.84,JP,,0000,0000,0000,,Негізі мен аз уақыт бұрын өліп қала жаздадым.
Dialogue: 0,0:09:47.73,0:09:48.58,JP,,0000,0000,0000,,Жалықтырғыш
Dialogue: 0,0:09:50.17,0:09:52.12,JP,,0000,0000,0000,,«Бергілеу».
Dialogue: 0,0:09:52.29,0:09:54.91,JP,,0000,0000,0000,,Сіз өңіңізді мүлде өзгерткен жоқсыз.
Dialogue: 0,0:09:54.92,0:09:55.91,JP,,0000,0000,0000,,Әке
Dialogue: 0,0:09:56.35,0:09:58.81,JP,,0000,0000,0000,,Ағай, сіз нені айтып тұрсыз?
Dialogue: 0,0:09:59.20,0:10:01.97,JP,,0000,0000,0000,,Мен таза жиенімді қорқытқым келді.
Dialogue: 0,0:10:02.23,0:10:04.02,JP,,0000,0000,0000,,Бұл тек батылдықты сынау.
Dialogue: 0,0:10:06.85,0:10:10.56,JP,,0000,0000,0000,,Бұл фарс болды, бірақ мен шынымен өлемін деп ойладым.
Dialogue: 0,0:10:11.71,0:10:13.96,JP,,0000,0000,0000,,Бұл апат болды.
Dialogue: 0,0:10:14.47,0:10:15.36,JP,,0000,0000,0000,,Мүлдем.
Dialogue: 0,0:10:16.14,0:10:19.67,JP,,0000,0000,0000,,Олай болса, мұнда не үшін келдің?
Dialogue: 0,0:10:20.57,0:10:25.45,JP,,0000,0000,0000,,Өлемін деп ойласам, Сені есіме аламын
Dialogue: 0,0:10:27.92,0:10:31.90,JP,,0000,0000,0000,,Сенімен кездескенше өлгім келмесе екен.
Dialogue: 0,0:10:32.78,0:10:35.06,JP,,0000,0000,0000,,Мен бұл дүниеде өкініш қалдырғым келмейді.
Dialogue: 0,0:10:35.94,0:10:38.16,JP,,0000,0000,0000,,Сондықтан мен бүгін кешке келдім.
Dialogue: 0,0:10:39.93,0:10:43.36,JP,,0000,0000,0000,,Енді біз осылай кездесе аламыз,
Dialogue: 0,0:10:44.03,0:10:45.75,JP,,0000,0000,0000,,Сізде өкініш бар ма?
Dialogue: 0,0:10:50.57,0:10:54.55,JP,,0000,0000,0000,,Жоқ, енді мен сені кездестірдім
Dialogue: 0,0:10:55.68,0:10:58.36,JP,,0000,0000,0000,,Мен сені жақынырақ көргім келеді
Dialogue: 0,0:11:05.90,0:11:06.54,JP,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:11:07.65,0:11:08.86,JP,,0000,0000,0000,,Ұзақ өмір сүріңіз
Dialogue: 0,0:11:11.36,0:11:14.14,JP,,0000,0000,0000,,Мен сенімен бірге болғым келеді
Dialogue: 0,0:11:20.73,0:11:23.97,JP,,0000,0000,0000,,Мен білгеннен гөрі сараңырақ сияқтымын.
Dialogue: 0,0:11:25.46,0:11:28.58,JP,,0000,0000,0000,,Біз сізді күттік, Йошитака мырза.
Dialogue: 0,0:11:29.23,0:11:30.75,JP,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:11:31.63,0:11:33.97,JP,,0000,0000,0000,,Бұл жай ғана сөйлемдер.
Dialogue: 0,0:11:34.39,0:11:36.57,JP,,0000,0000,0000,,Мен сіздің келгеніңіздің белгісін көрмеймін.
Dialogue: 0,0:11:37.44,0:11:39.28,JP,,0000,0000,0000,,Мен қатты қобалжыдым.
Dialogue: 0,0:11:41.41,0:11:46.09,JP,,0000,0000,0000,,Кешіріңіз, Мичитака әйелдердің жүрегін жақсы түсінетін сияқты.
Dialogue: 0,0:11:46.74,0:11:48.01,JP,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:50.95,0:11:52.38,JP,,0000,0000,0000,,Түн ұзақ
Dialogue: 0,0:11:53.56,0:11:55.85,JP,,0000,0000,0000,,Ақырын сөйлесейік.
Dialogue: 0,0:11:57.81,0:12:01.11,JP,,0000,0000,0000,,Йошитака...сама...
Dialogue: 0,0:12:12.84,0:12:16.82,JP,,0000,0000,0000,,Мен сені кезіктіргенше кез келген уақытта өлемін деп ойладым.
Dialogue: 0,0:12:17.78,0:12:23.59,JP,,0000,0000,0000,,Енді мен сені кездестіргеннен кейін, Мен сенімен мәңгі бірге болғым келеді.
Dialogue: 0,0:12:26.17,0:12:31.73,JP,,0000,0000,0000,,Осы үш жылдан кейін Йошитака 21 жасында қайтыс болды.
Dialogue: 0,0:12:33.07,0:12:38.62,JP,,0000,0000,0000,,Ол сүйіктісімен аз ғана уақытын өткізгенде қандай сезімде болды?
Dialogue: 0,0:12:44.25,0:12:45.76,JP,,0000,0000,0000,,Сіз әдемі көрінесіз.
Dialogue: 0,0:12:46.03,0:12:48.91,JP,,0000,0000,0000,,Мынау жабылған ауыз маған ұқсамай ма?
Dialogue: 0,0:12:49.22,0:12:50.97,JP,,0000,0000,0000,,Бұл Йошитака-саманың баласы.
Dialogue: 0,0:12:52.67,0:12:56.67,JP,,0000,0000,0000,,Мичитака-сама тез арада заңды әйел алса, жақсы болар еді.
Dialogue: 0,0:12:57.15,0:12:59.87,JP,,0000,0000,0000,,Күндердің бірінде мен бір ерекше әйелді алып, саған көрсетемін.
Dialogue: 0,0:13:00.49,0:13:01.38,JP,,0000,0000,0000,,Балам
Dialogue: 0,0:13:08.93,0:13:10.23,JP,,0000,0000,0000,,Әйелдер қызықсыз
Dialogue: 0,0:13:11.41,0:13:15.04,JP,,0000,0000,0000,,Көп әйел алу асыл ерлердің әдеті.
Dialogue: 0,0:13:15.79,0:13:21.02,JP,,0000,0000,0000,,Әйелдің идеалды бейнесі - оның іс-әрекетін кінәламай, үнсіз қызмет ету.
Dialogue: 0,0:13:23.45,0:13:25.86,JP,,0000,0000,0000,,Бірақ мұндай әйел бар ма?
Dialogue: 0,0:13:29.31,0:13:31.74,JP,,0000,0000,0000,,Жақсы, Самурай Такаучи.
Dialogue: 0,0:13:32.32,0:13:35.13,JP,,0000,0000,0000,,Мен Мичитака-самаға тең келер емеспін.
Dialogue: 0,0:13:35.44,0:13:38.19,JP,,0000,0000,0000,,Жоқ, маңыздысы тепе-теңдік емес, махаббат.
Dialogue: 0,0:13:38.76,0:13:39.38,JP,,0000,0000,0000,,Ағаш қоршауға барып, оны ұстап, бір-бірімізден ажырайық.
Dialogue: 0,0:13:41.49,0:13:43.99,JP,,0000,0000,0000,,Бұл кісі де түптеп келгенде текті әулеттің мұрагері.
Dialogue: 0,0:13:44.56,0:13:47.00,JP,,0000,0000,0000,,Секи тауы ойнап, лақтырылады.
Dialogue: 0,0:13:44.96,0:13:48.11,JP-,,0000,0000,0000,,Жоқ, неге сонша қыңырсың?
Dialogue: 0,0:13:48.77,0:13:53.15,JP,,0000,0000,0000,,Құрметті Мичитака, неке мәселесін мұқият қарастырыңыз.
Dialogue: 0,0:13:54.98,0:13:57.38,JP,,0000,0000,0000,,Сіздің мәртебеңізге сай әйеліңіз болмаса
Dialogue: 0,0:13:57.62,0:14:00.23,JP,,0000,0000,0000,,Бұл кейінірек кейбір қолайсыздықтар тудырады.
Dialogue: 0,0:14:03.19,0:14:08.58,JP,,0000,0000,0000,,Менің ойымша, отбасылық тегі үшін емес, сүйіспеншілік үшін үйленудің мәні бар.
Dialogue: 0,0:14:08.96,0:14:12.39,JP,,0000,0000,0000,,Ондай сөздерді жеңіл айтпа.
Dialogue: 0,0:14:12.84,0:14:16.19,JP,,0000,0000,0000,,Мен сияқты адамның әйелі болғаннан не пайда?
Dialogue: 0,0:14:16.20,0:14:18.09,JP,,0000,0000,0000,,Менің болашақ болжамдарымды тыңдайсың ба?
Dialogue: 0,0:14:19.35,0:14:21.69,JP,,0000,0000,0000,,Мен оны толығымен елестете аламын.
Dialogue: 0,0:14:22.82,0:14:24.94,JP,,0000,0000,0000,,Мен саған үйленемін, көп балалы боламын.
Dialogue: 0,0:14:25.38,0:14:28.63,JP,,0000,0000,0000,,Ол сүйкімді, өйткені ол өзіне ұнаған әйелмен бірге болған бала.
Dialogue: 0,0:14:29.32,0:14:32.43,JP,,0000,0000,0000,,Балам екеуің үшін аянбай еңбек етемін.
Dialogue: 0,0:14:32.81,0:14:36.90,JP,,0000,0000,0000,,Осы ұрпақтың, немерелерімнің ұрпағы өркендеуіне аянбай еңбек етемін.
Dialogue: 0,0:14:37.58,0:14:41.63,JP,,0000,0000,0000,,Сенімен менің өмірім махаббатқа, үмітке, қуанышқа толы.
Dialogue: 0,0:14:42.28,0:14:43.44,JP,,0000,0000,0000,,Мен сені алғаш көргенде
Dialogue: 0,0:14:44.08,0:14:47.38,JP,,0000,0000,0000,,Болашақ туралы сол көзқарас кенет менің санама тарады.
Dialogue: 0,0:14:48.28,0:14:51.39,JP,,0000,0000,0000,,Мен сенен басқа ешкімді заңды әйелім деп санай алмаймын.
Dialogue: 0,0:14:52.19,0:14:53.92,JP,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:14:54.85,0:14:55.35,JP,,0000,0000,0000,,Менімен бірге
Dialogue: 0,0:14:57.65,0:14:58.16,JP,,0000,0000,0000,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:14:58.46,0:15:02.45,JP,,0000,0000,0000,,Әй, чатыңызды үзгенім үшін кешіріңіз.
Dialogue: 0,0:15:03.02,0:15:05.80,JP,,0000,0000,0000,,Тезірек жұмысқа оралғаныңыз жөн, Мичитака.
Dialogue: 0,0:15:06.17,0:15:07.02,JP,,0000,0000,0000,,Құрметті Йошитака
Dialogue: 0,0:15:07.16,0:15:09.35,JP,,0000,0000,0000,,Не істеп жатырсың, біреудің махаббат сапарына кедергі жасама?
Dialogue: 0,0:15:09.58,0:15:11.26,JP,,0000,0000,0000,,Жоқ, генерал-лейтенант ашулы.
Dialogue: 0,0:15:11.41,0:15:11.88,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:15:12.41,0:15:14.43,JP,,0000,0000,0000,,Маған жібергеніңіз қайтып келмейді
Dialogue: 0,0:15:15.55,0:15:16.72,JP,,0000,0000,0000,,Кешіріңіз, Самурай Такаучи
Dialogue: 0,0:15:17.16,0:15:19.31,JP,,0000,0000,0000,,Ұят, бірақ әңгіме басқа жолы жалғасады.
Dialogue: 0,0:15:19.55,0:15:20.38,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:15:20.99,0:15:22.33,JP,,0000,0000,0000,,Келесі жолы маған жақсы жауап беріңіз
Dialogue: 0,0:15:22.76,0:15:24.69,JP,,0000,0000,0000,,Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:15:26.06,0:15:27.63,JP,,0000,0000,0000,,Оны би тобына ұсынайық.
Dialogue: 0,0:15:27.75,0:15:28.87,JP,,0000,0000,0000,,Бірден түзетейін
Dialogue: 0,0:15:29.26,0:15:31.87,JP,,0000,0000,0000,,Мен сенің жұмыста екеніңді түсінбедім.
Dialogue: 0,0:15:32.29,0:15:33.34,JP,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:15:34.03,0:15:38.85,JP,,0000,0000,0000,,Жоқ. Бір нәрсемен айналысу тым көп болуы мүмкін.
Dialogue: 0,0:15:39.47,0:15:42.83,JP,,0000,0000,0000,,Сол себепті тұрмысқа шыққан соң барымды саламын деген рас деп ойлаймын.
Dialogue: 0,0:15:43.52,0:15:45.20,JP,,0000,0000,0000,,Мен де сізден көмек сұраймын.
Dialogue: 0,0:15:46.01,0:15:47.09,JP,,0000,0000,0000,,Қорқу керек нәрселер
Dialogue: 0,0:15:47.88,0:15:50.89,JP,,0000,0000,0000,,Маған үйленсең сені жігерлендіретіндей жағдай жоқ.
Dialogue: 0,0:15:52.25,0:15:53.63,JP,,0000,0000,0000,,Неліктен олай ойлайсың?
Dialogue: 0,0:15:54.30,0:15:56.12,JP,,0000,0000,0000,,Менің баратын адамдарым көп.
Dialogue: 0,0:15:56.99,0:15:59.46,JP,,0000,0000,0000,,Мен заттар санына кірмеймін.
Dialogue: 0,0:16:00.65,0:16:03.65,JP,,0000,0000,0000,,Ол қауесет сияқты қамқор емес.
Dialogue: 0,0:16:04.40,0:16:07.23,JP,,0000,0000,0000,,Бұл қазір рас болса да, мен болашақта не болатынын білмеймін.
Dialogue: 0,0:16:08.85,0:16:09.65,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:16:10.56,0:16:15.24,JP,,0000,0000,0000,,Сарайға қызмет етсең, адамның бүге-шігесіне дейін көрінеді дейсің бе?
Dialogue: 0,0:16:16.08,0:16:20.72,JP,,0000,0000,0000,,Рас, егер заңды әйел болғың келсе, Мичитаканы тоқтату керек.
Dialogue: 0,0:16:21.20,0:16:23.33,JP,,0000,0000,0000,,Жоқ, үлкен қателік.
Dialogue: 0,0:16:23.65,0:16:26.49,JP,,0000,0000,0000,,Менің естуімше, үйлену туралы ұсыныс та бар.
Dialogue: 0,0:16:27.60,0:16:31.39,JP,,0000,0000,0000,,Ағасы ұлының болашағы үшін одан да азырақ тиімдірек болатын үйлену туралы дұға етті.
Dialogue: 0,0:16:32.05,0:16:34.15,JP,,0000,0000,0000,,Солардың бірі шешілетін сияқты.
Dialogue: 0,0:16:35.83,0:16:37.37,JP,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:16:38.35,0:16:41.38,JP,,0000,0000,0000,,Мырзаның берекесі әйеліне байланысты.
Dialogue: 0,0:16:42.13,0:16:43.66,JP,,0000,0000,0000,,Сіз өте түсініктісіз.
Dialogue: 0,0:16:44.35,0:16:46.92,JP,,0000,0000,0000,,Сізді әйелдердің айнасы деуге болады.
Dialogue: 0,0:16:47.83,0:16:52.04,JP,,0000,0000,0000,,Жоқ, мен әйелдің айнасы емеспін.
Dialogue: 0,0:16:54.55,0:16:57.74,JP,,0000,0000,0000,,Еркектің алдауына алаңдамайтын әйел жоқ.
Dialogue: 0,0:16:58.68,0:17:03.38,JP,,0000,0000,0000,,Бәрі сабырлы кейіп танытып, келешекке алаңдайтынына сенімдімін.
Dialogue: 0,0:17:04.04,0:17:04.62,JP,,0000,0000,0000,,Мен де
Dialogue: 0,0:17:05.57,0:17:10.80,JP,,0000,0000,0000,,Мен осы уақытқа дейін мүлде бас тарттым, өйткені мұндай жағымсыз сезімдер мені азаптайды.
Dialogue: 0,0:17:13.10,0:17:18.21,JP,,0000,0000,0000,,Неліктен мен кенеттен ол адамға соншалықты тартылдым?
Dialogue: 0,0:17:20.01,0:17:20.68,JP,,0000,0000,0000,,Самурай Такаучи
Dialogue: 0,0:17:21.79,0:17:23.96,JP,,0000,0000,0000,,О, сенің ояу болғаның жақсы болды.
Dialogue: 0,0:17:24.83,0:17:28.10,JP,,0000,0000,0000,,Түнде сарайға барсаң, қараңғы, қорқынышты.
Dialogue: 0,0:17:28.10,0:17:29.19,JP,,0000,0000,0000,,Затыңызды алыңыз.
Dialogue: 0,0:17:29.73,0:17:31.68,JP,,0000,0000,0000,,Не? Мен бұған тоймаймын.
Dialogue: 0,0:17:32.39,0:17:35.32,JP,,0000,0000,0000,,Құлағыңның құлағына жетпесін.
Dialogue: 0,0:17:36.39,0:17:37.93,JP,,0000,0000,0000,,Неке мәмілесі аяқталды, солай ма?
Dialogue: 0,0:17:38.91,0:17:40.35,JP,,0000,0000,0000,,Бұл туралы қайда айттыңыз?
Dialogue: 0,0:17:40.98,0:17:42.09,JP,,0000,0000,0000,,Желдегі өсек
Dialogue: 0,0:17:43.46,0:17:46.63,JP,,0000,0000,0000,,Мен үйленбей тұрып көңіл көтергіңіз келетінін түсіндім.
Dialogue: 0,0:17:47.03,0:17:50.01,JP,,0000,0000,0000,,Ойнап жатқандардың сезімін ескермеңіз.
Dialogue: 0,0:17:50.78,0:17:55.54,JP,,0000,0000,0000,,Күні бойы неше әйелге дәл осылай айтты?
Dialogue: 0,0:17:56.46,0:17:59.43,JP,,0000,0000,0000,,Менің жағдайым төмен деп, адамдар маған онша қарамайтын сияқты.
Dialogue: 0,0:17:59.93,0:18:02.33,JP,,0000,0000,0000,,Менде де мақтаныш деген бар.
Dialogue: 0,0:18:09.01,0:18:10.00,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:11.13,0:18:12.21,JP,,0000,0000,0000,,Сөздер өтті
Dialogue: 0,0:18:13.51,0:18:15.51,JP,,0000,0000,0000,,Менің жүрегім шіркін деп ойладың.
Dialogue: 0,0:18:16.24,0:18:18.64,JP,,0000,0000,0000,,Мені жалғыз қалдырыңызшы.
Dialogue: 0,0:18:18.64,0:18:20.30,JP,,0000,0000,0000,,Мен үйлену туралы ұсыныстардан бас тарттым.
Dialogue: 0,0:18:21.26,0:18:22.55,JP,,0000,0000,0000,,Қайдан естігеніңізді білмеймін.
Dialogue: 0,0:18:22.80,0:18:25.74,JP,,0000,0000,0000,,Маған бұлай айтасың деп күтпедім.
Dialogue: 0,0:18:26.54,0:18:27.13,JP,,0000,0000,0000,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:18:27.64,0:18:28.17,JP,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:18:28.78,0:18:31.62,JP,,0000,0000,0000,,Маған әйелдер ұнайды, сондықтан сенің күдіктенуің ғажап емес.
Dialogue: 0,0:18:32.43,0:18:33.96,JP,,0000,0000,0000,,Айтпаған нәрсені айтпа
Dialogue: 0,0:18:35.40,0:18:37.70,JP,,0000,0000,0000,,Мен сені заңды әйелім етуді қатты ойлап жүрмін.
Dialogue: 0,0:18:38.30,0:18:41.16,JP,,0000,0000,0000,,Алайда, ата-анасы шешкен лайықты неке туралы сөз болғанда,
Dialogue: 0,0:18:41.53,0:18:44.47,JP,,0000,0000,0000,,Мен оны заңды әйелім етуім керек.
Dialogue: 0,0:18:45.19,0:18:47.89,JP,,0000,0000,0000,,Сонда сіз позицияңызды жоғалтасыз.
Dialogue: 0,0:18:48.65,0:18:49.81,JP,,0000,0000,0000,,Сондықтан мен бас тарттым.
Dialogue: 0,0:18:50.98,0:18:53.40,JP,,0000,0000,0000,,Мен ғашық болған әйелдің көлеңкелі адам болғанын қаламаймын.
Dialogue: 0,0:18:56.19,0:18:58.03,JP,,0000,0000,0000,,Сондықтан бұл жақсы.
Dialogue: 0,0:18:59.20,0:19:02.77,JP,,0000,0000,0000,,Егер мені тастап кетсең, мен сенен сұраймын, Самурай Такаучи.
Dialogue: 0,0:19:03.98,0:19:04.51,JP,,0000,0000,0000,,Такако
Dialogue: 0,0:19:06.04,0:19:07.82,JP,,0000,0000,0000,,Менің атым Такако
Dialogue: 0,0:19:09.28,0:19:12.56,JP,,0000,0000,0000,,Мені осылай атағаныңыз үшін рахмет, Мичитака-сама.
Dialogue: 0,0:19:14.68,0:19:15.17,JP,,0000,0000,0000,,Такако
Dialogue: 0,0:19:16.90,0:19:19.70,JP,,0000,0000,0000,,Бұл жақсы. Сен маған тұрмысқа шығасың.
Dialogue: 0,0:19:20.33,0:19:22.08,JP,,0000,0000,0000,,Егер ант берсең
Dialogue: 0,0:19:22.37,0:19:23.86,JP,,0000,0000,0000,,О, мен кез келген нәрсеге ант етемін.
Dialogue: 0,0:19:24.33,0:19:26.44,JP,,0000,0000,0000,,Өмірімнің соңына дейін мен ең жақсымын.
Dialogue: 0,0:19:26.67,0:19:27.13,JP,,0000,0000,0000,,О
Dialogue: 0,0:19:27.45,0:19:31.60,JP,,0000,0000,0000,,Ұмытпа, сен өмір бойы менікісің.
Dialogue: 0,0:19:32.17,0:19:32.96,JP,,0000,0000,0000,,Өте жақсы
Dialogue: 0,0:19:33.67,0:19:37.16,JP,,0000,0000,0000,,Мен сенің мөлдір жүзіңнің ар жағындағы құмарлықты жақсы көремін.
Dialogue: 0,0:19:38.02,0:19:38.86,JP,,0000,0000,0000,,Мен сені сүйемін Такако
Dialogue: 0,0:19:39.77,0:19:41.06,JP,,0000,0000,0000,,Сізді өмір бойы бақытты етіңіз
Dialogue: 0,0:19:44.74,0:19:45.57,JP,,0000,0000,0000,,Самурай Такаучи
Dialogue: 0,0:19:46.84,0:19:49.01,JP,,0000,0000,0000,,Мичитакада бәрі жақсы болған сияқты.
Dialogue: 0,0:19:49.43,0:19:50.09,JP,,0000,0000,0000,,Тодороки мен Бакуго!
Dialogue: 0,0:19:50.64,0:19:53.16,JP,,0000,0000,0000,,Иә, сізге рахмет.
Dialogue: 0,0:19:54.02,0:19:56.48,JP,,0000,0000,0000,,Мен не істедім?
Dialogue: 0,0:19:57.18,0:20:00.99,JP,,0000,0000,0000,,Неке туралы ұсыныс бұзылғанын білесіз бе?
Dialogue: 0,0:20:02.04,0:20:03.55,JP,,0000,0000,0000,,Күткендей, жақсы таптың.
Dialogue: 0,0:20:04.30,0:20:06.79,JP,,0000,0000,0000,,Ақылды болсаң, қалай адал болуға болады.
Dialogue: 0,0:20:07.10,0:20:10.28,JP,,0000,0000,0000,,Солай болса да, сіз дөрекі көріндіңіз.
Dialogue: 0,0:20:10.83,0:20:16.32,JP,,0000,0000,0000,,Жарайды, мен досымның шынайылығына күмәнданудың қажеті жоқ деп ойладым.
Dialogue: 0,0:20:16.87,0:20:18.01,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:20:19.01,0:20:21.10,JP,,0000,0000,0000,,Ол да бір ойлы адам.
Dialogue: 0,0:20:21.99,0:20:26.42,JP,,0000,0000,0000,,Махаббат туралы көптеген қауесеттер өмір бойы бағалайтын адамды табу туралы.
Dialogue: 0,0:20:27.01,0:20:29.75,JP,,0000,0000,0000,,Ақыры мен сені таптым.
Dialogue: 0,0:20:30.47,0:20:32.14,JP,,0000,0000,0000,,Бұл сізді бақытты ететініне сенімдімін.
Dialogue: 0,0:20:32.73,0:20:35.12,JP,,0000,0000,0000,,Иә, түсіндім.
Dialogue: 0,0:20:36.00,0:20:39.66,JP,,0000,0000,0000,,Бәрінен бұрын екеуіңе мәңгілік бақыт тілеймін.
Dialogue: 0,0:20:41.51,0:20:44.57,JP,,0000,0000,0000,,Үйге қайту деген нені білдіреді?
Dialogue: 0,0:20:45.14,0:20:47.28,JP,,0000,0000,0000,,Мен сені үйіңе қарсы алуға дайындалдым.
Dialogue: 0,0:20:47.80,0:20:49.02,JP,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:20:49.57,0:20:53.85,JP,,0000,0000,0000,,Ата-ананың екеуі де риза болғанша, сені күйеу баладай қарайды.
Dialogue: 0,0:20:54.44,0:20:57.35,JP,,0000,0000,0000,,Ғұлама әке, қорқамын, икемім жоқ.
Dialogue: 0,0:20:58.64,0:20:59.46,JP,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:21:00.24,0:21:03.52,JP,,0000,0000,0000,,Жарайды, балалы болған соң, ресми түрде үйге әкелейік.
Dialogue: 0,0:21:03.90,0:21:06.81,JP,,0000,0000,0000,,Бұл сирек және дана шешім.
Dialogue: 0,0:21:07.30,0:21:07.80,JP,,0000,0000,0000,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:21:08.79,0:21:10.82,JP,,0000,0000,0000,,Егер бұлай болса, мен ешкімге шағымданбаймын.
Dialogue: 0,0:21:11.60,0:21:13.46,JP,,0000,0000,0000,,Сіз менің адамым боласыз.
Dialogue: 0,0:21:14.97,0:21:17.55,JP,,0000,0000,0000,,Мен қазір осылай бақытты болсам да
Dialogue: 0,0:21:18.18,0:21:19.72,JP,,0000,0000,0000,,Мен әлі де алаңдаймын
Dialogue: 0,0:21:20.98,0:21:23.59,JP,,0000,0000,0000,,Адам сыртқы әлемде өседі
Dialogue: 0,0:21:24.36,0:21:27.14,JP,,0000,0000,0000,,Жүрегің сол қалпында қалатынына кепілдік жоқ.
Dialogue: 0,0:21:28.05,0:21:30.00,JP,,0000,0000,0000,,Сондықтан мен ойлаймын
Dialogue: 0,0:21:42.39,0:21:44.87,JP,,0000,0000,0000,,Өмір бойы сен ғана деп ант етесің
Dialogue: 0,0:21:45.46,0:21:47.01,JP,,0000,0000,0000,,Адамдардың жүрегі өзгереді
Dialogue: 0,0:21:48.11,0:21:50.08,JP,,0000,0000,0000,,Сондықтан мен бүгін өлгім келеді
Dialogue: 0,0:21:51.14,0:21:53.26,JP,,0000,0000,0000,,Ең жақсы көретін
Dialogue: 0,0:21:57.78,0:22:00.61,JP,,0000,0000,0000,,Кейінірек Такако Мичитаканың баласын дүниеге әкелді.
Dialogue: 0,0:22:01.11,0:22:03.75,JP,,0000,0000,0000,,Мичитака қауіпсіз және Такаконы өзінің заңды әйелі етіп алады.
Dialogue: 0,0:22:06.67,0:22:08.21,JP,,0000,0000,0000,,Таманокоси қызы
Dialogue: 0,0:22:11.11,0:22:12.21,JP,,0000,0000,0000,,Канпакуды тағайындау
Dialogue: 0,0:22:14.54,0:22:16.71,JP,,0000,0000,0000,,Мацу-кун, ән айтуды үйренейік.
Dialogue: 0,0:22:17.06,0:22:18.39,JP,,0000,0000,0000,,Немеренің сүйіспеншілігі
Dialogue: 0,0:22:18.55,0:22:20.03,JP,,0000,0000,0000,,Қызметші цикада жақсырақ
Dialogue: 0,0:22:20.87,0:22:22.18,JP,,0000,0000,0000,,Өте жеккөрушілік
Dialogue: 0,0:22:24.67,0:22:26.05,JP,,0000,0000,0000,,Мичитаканы ұзақ уақыт көрмедім
Dialogue: 0,0:22:26.46,0:22:27.78,JP,,0000,0000,0000,,О, Йошитака
Dialogue: 0,0:22:28.13,0:22:29.52,JP,,0000,0000,0000,,Толық өмір сүрді
Dialogue: 0,0:22:30.04,0:22:33.09,JP,,0000,0000,0000,,Иә, бірақ менде өкініштен басқа ештеңе жоқ.
Dialogue: 0,0:22:33.40,0:22:35.92,JP,,0000,0000,0000,,Дәлірек айтсақ, мен қазір елеспін.
Dialogue: 0,0:22:36.54,0:22:38.54,JP,,0000,0000,0000,,Мен қорқамын, қорқамын
Dialogue: 0,0:22:38.89,0:22:40.17,JP,,0000,0000,0000,,Ештеңе өзгерген жоқ.
Dialogue: 0,0:24:14.00,0:24:17.26,JP,,0000,0000,0000,,Какутодани Эяхай Ибукино
Dialogue: 0,0:24:17.68,0:24:23.44,JP,,0000,0000,0000,,Жанып тұрған ой
Dialogue: 0,0:00:09.00,0:00:12.49,CN,,0000,0000,0000,,Мен Фудзивара Тейкамын.
Dialogue: 0,0:00:13.01,0:00:15.01,CN,,0000,0000,0000,,Чонджадағы өрт бомбасының құрылысы жүріп жатыр
Dialogue: 0,0:00:15.44,0:00:18.33,CN,,0000,0000,0000,,Ояёси Мен Уцуномия желісімін
Dialogue: 0,0:00:18.51,0:00:21.67,CN,,0000,0000,0000,,Өз қаражатыма құрастырған жүз өлең.\N26-бөлім
Dialogue: 0,0:00:22.09,0:00:26.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:26.87,0:00:28.61,CN,,0000,0000,0000,,Көріп отырғаныңыздай, мен Фудзивара руынанмын.
Dialogue: 0,0:00:28.95,0:00:31.57,CN,,0000,0000,0000,,Іс жүзінде сіз Фудзивара руынансыз.
Dialogue: 0,0:00:31.79,0:00:32.62,CN,,0000,0000,0000,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:00:33.00,0:00:36.31,CN,,0000,0000,0000,,Фамилия - Фудзивара және ол кезде ғибадатханада көптеген адамдар болды.
Dialogue: 0,0:00:36.40,0:00:37.49,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:37.86,0:00:41.87,CN,,0000,0000,0000,,Фудзивара-кунға айқайлаңыз.
Dialogue: 0,0:00:42.50,0:00:43.87,CN,,0000,0000,0000,,Белгілі бір нүктенің болуы мүмкін.
Dialogue: 0,0:00:44.33,0:00:49.57,CN,,0000,0000,0000,,Фудзивара приходтары мен қазіргі шәкірттер арасындағы махаббат хикаясы.
Dialogue: 0,0:00:50.26,0:00:53.62,CN,,0000,0000,0000,,Екі ағайынды Коредо бір-бірімен тығыз байланысты.
Dialogue: 0,0:00:53.87,0:00:54.89,CN,,0000,0000,0000,,Тейка-кун
Dialogue: 0,0:00:56.23,0:00:57.66,CN,,0000,0000,0000,,үлкен маңызды біртүрлі
Dialogue: 0,0:02:43.10,0:02:47.31,CN,,0000,0000,0000,,Фудзивара но Йошитака Икуюшо Дайжодайджиннің отбасы
Dialogue: 0,0:02:48.38,0:02:49.48,CN,,0000,0000,0000,,Ересек адамға тегін
Dialogue: 0,0:02:50.68,0:02:51.88,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:02:52.25,0:02:53.79,CN,,0000,0000,0000,,Қазір ерте
Dialogue: 0,0:02:54.16,0:02:57.81,CN,,0000,0000,0000,,Баршаңызды құттықтаймын.
Dialogue: 0,0:02:58.32,0:03:02.29,CN,,0000,0000,0000,,Діни терең, бірінші курс вице-біліктілігі және т.б.
Dialogue: 0,0:03:02.66,0:03:07.30,CN,,0000,0000,0000,,Ғибадатханадағы әйелдің оқиғасы өте жақсы. Жарқын болашақ алда.
Dialogue: 0,0:03:08.94,0:03:11.46,CN,,0000,0000,0000,,Басқалар
Dialogue: 0,0:03:11.96,0:03:14.46,&,,0000,0000,0000,,Такайоген Ясумитсу әйелі
Dialogue: 0,0:03:11.96,0:03:14.46,,,0000,0000,0000,,Йошитака Фудзивара
Dialogue: 0,0:03:20.70,0:03:21.78,CN,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:03:39.09,0:03:40.57,CN,,0000,0000,0000,,Аришин келді
Dialogue: 0,0:03:47.41,0:03:49.59,CN,,0000,0000,0000,,Филиалдық хабарлама жіберілді.
Dialogue: 0,0:03:50.52,0:03:52.35,CN,,0000,0000,0000,,Бұл шығарылым.
Dialogue: 0,0:04:14.15,0:04:15.26,CN,,0000,0000,0000,,және интернатта тұратын оқушылар мен күндізгі бөлімде оқитындар арасында шиеленіс бар.
Dialogue: 0,0:04:15.26,0:04:16.56,CN,,0000,0000,0000,,Нағыз технология рухқа толы
Dialogue: 0,0:04:17.52,0:04:18.29,CN,,0000,0000,0000,,Ересек Мичитака
Dialogue: 0,0:04:18.78,0:04:22.11,CN,,0000,0000,0000,,Садақтың ұзындығы астанаға еш зиянсыз жетуге жеткілікті.
Dialogue: 0,0:04:23.27,0:04:25.70,CN,,0000,0000,0000,,Қалағаныңызша ұзақ бола аласыз.
Dialogue: 0,0:04:26.41,0:04:28.68,CN,,0000,0000,0000,,Сізде Мичитака әңгімесі бар
Dialogue: 0,0:04:29.31,0:04:31.11,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:31.99,0:04:33.12,CN,,0000,0000,0000,,Кэни ересек адам
Dialogue: 0,0:04:34.84,0:04:36.55,CN,,0000,0000,0000,,Самурай рухы
Dialogue: 0,0:04:37.00,0:04:40.28,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:40.68,0:04:42.67,CN,,0000,0000,0000,,Әр түнде астана аяқталады
Dialogue: 0,0:04:43.00,0:04:45.02,CN,,0000,0000,0000,,Бұл қорқыныш.
Dialogue: 0,0:04:45.59,0:04:49.13,CN,,0000,0000,0000,,Түрмеде тұратын ересектерге түрмеде тұруға тыйым салынады.
Dialogue: 0,0:04:51.08,0:04:53.32,CN,,0000,0000,0000,,Бұл одан да қайғылы оқиға.
Dialogue: 0,0:04:54.32,0:04:57.08,CN,,0000,0000,0000,,Самурай — Наказатода самурай.
Dialogue: 0,0:04:57.53,0:05:00.44,CN,,0000,0000,0000,,Жеке бақытсыздыққа байланысты
Dialogue: 0,0:05:00.82,0:05:05.58,CN,,0000,0000,0000,,Алайда қалада тұратын ғашық тұрақты күш емес
Dialogue: 0,0:05:06.46,0:05:09.91,CN,,0000,0000,0000,,Басқа ойдың болған уақыты
Dialogue: 0,0:05:11.34,0:05:14.60,CN,,0000,0000,0000,,Әйел зардап шекпеді, бірақ ол өз-өзіне қол жұмсады.
Dialogue: 0,0:05:15.31,0:05:19.19,CN,,0000,0000,0000,,Самурай Тадано өкініш Мохи аяқталды
Dialogue: 0,0:05:20.50,0:05:23.79,CN,,0000,0000,0000,,Өйткені жүрек өкінішке толы, ал енді Будда заңнан азат.
Dialogue: 0,0:05:24.33,0:05:29.47,CN,,0000,0000,0000,,Рас, жарайды, мен бүгін кешке рейсімнің алдында кетемін.
Dialogue: 0,0:05:27.83,0:05:29.33,,,0000,0000,0000,,Нагажуконо сөзі
Dialogue: 0,0:05:29.96,0:05:33.07,CN,,0000,0000,0000,,Сіз перзенттік болғыңыз келмейді.
Dialogue: 0,0:05:33.47,0:05:35.30,CN,,0000,0000,0000,,Мичитака Юйя кетіп қалады
Dialogue: 0,0:05:35.30,0:05:36.24,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:36.39,0:05:39.91,CN,,0000,0000,0000,,Білімділігің, имандылығың бар.
Dialogue: 0,0:05:40.49,0:05:42.19,CN,,0000,0000,0000,,Міндет - қайталап көру.
Dialogue: 0,0:05:44.68,0:05:49.03,CN,,0000,0000,0000,,Мен жақында отандық самурай кеңсесіне келіп, өте әдемі әйелді таптым.
Dialogue: 0,0:05:49.91,0:05:51.89,CN,,0000,0000,0000,,Іздеген қолды толық ұстаңыз
Dialogue: 0,0:05:52.42,0:05:53.34,CN,,0000,0000,0000,,Аралдағы шағын ауылда тұратын бір священник сәбиді асырап алды.
Dialogue: 0,0:05:54.12,0:05:55.17,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:55.50,0:05:59.03,CN,,0000,0000,0000,,Ересек әйелдің киім үлгісі
Dialogue: 0,0:05:59.51,0:06:01.98,CN,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:02.52,0:06:05.65,CN,,0000,0000,0000,,Мынау әдемі.
Dialogue: 0,0:06:06.49,0:06:09.59,CN,,0000,0000,0000,,Жаңа ғана Шираничи Чосоның фонын көрдім
Dialogue: 0,0:06:10.18,0:06:11.71,CN,,0000,0000,0000,,Қолайсыздық
Dialogue: 0,0:06:12.52,0:06:14.46,CN,,0000,0000,0000,,Көтеріп бара жатқан мысық
Dialogue: 0,0:06:14.76,0:06:18.15,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:18.51,0:06:18.98,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:06:19.84,0:06:23.23,CN,,0000,0000,0000,,Ерте үйленгіңіз келсе, өтінемін
Dialogue: 0,0:06:23.35,0:06:25.85,CN,,0000,0000,0000,,Мен келдім, күзгі аспанға келдім.
Dialogue: 0,0:06:23.35,0:06:25.85,,,0000,0000,0000,,Ескерту: Алып тастау: Ресми тағайындау рәсімі
Dialogue: 0,0:06:26.22,0:06:30.41,CN,,0000,0000,0000,,Егер сіз алмастырушы болсаңыз, өз позицияңызды қалдырыңыз.
Dialogue: 0,0:06:30.44,0:06:33.43,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:34.07,0:06:37.56,CN,,0000,0000,0000,,Өткен кітаптың оқиғасы
Dialogue: 0,0:06:38.03,0:06:41.45,CN,,0000,0000,0000,,«Басқалар жақсы және бақытты емес» санаты
Dialogue: 0,0:06:42.72,0:06:45.63,CN,,0000,0000,0000,,Мен өз ойымды жаза аламын ба?
Dialogue: 0,0:06:45.68,0:06:50.00,CN,,0000,0000,0000,,Сіз өз ойыңызды өзгерте алмайсыз.
Dialogue: 0,0:06:50.24,0:06:52.24,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:53.05,0:06:56.01,CN,,0000,0000,0000,,Ерлердің алдында әйелдер қауымдастығы шатасады.
Dialogue: 0,0:06:56.58,0:06:59.55,CN,,0000,0000,0000,,Бұл тек адамның өз ойы.
Dialogue: 0,0:06:59.91,0:07:04.16,CN,,0000,0000,0000,,Өзін зорлық-зомбылық көрсететін жолы жоқ адам.
Dialogue: 0,0:07:04.60,0:07:07.26,CN,,0000,0000,0000,,Өнерлі болғандықтан, нағыз әйелсің.
Dialogue: 0,0:07:07.56,0:07:09.63,CN,,0000,0000,0000,,Дана сабырлы, сабырлы.
Dialogue: 0,0:07:09.84,0:07:11.29,CN,,0000,0000,0000,,Мичитака салқындату нүктесі
Dialogue: 0,0:07:11.62,0:07:13.62,CN,,0000,0000,0000,,Сіз кенеттен келген кезде
Dialogue: 0,0:07:13.92,0:07:16.49,CN,,0000,0000,0000,,Себебі…
Dialogue: 0,0:07:17.29,0:07:18.75,CN,,0000,0000,0000,,Атылмаған сұрақтар…
Dialogue: 0,0:07:20.12,0:07:23.41,CN,,0000,0000,0000,,Өлмекші болдым, бар күшімді салдым, Толық теріс қылық жасадым.
Dialogue: 0,0:07:24.02,0:07:25.50,CN,,0000,0000,0000,,Дұрыс. Дұрыс.
Dialogue: 0,0:07:30.21,0:07:31.29,CN,,0000,0000,0000,,Шынымен кету керек
Dialogue: 0,0:07:32.24,0:07:35.52,CN,,0000,0000,0000,,Мен бұған толық сенімді емеспін.
Dialogue: 0,0:07:36.16,0:07:38.81,CN,,0000,0000,0000,,Дегенмен, шынайы тіршілік иелері осылайша азап шегеді.
Dialogue: 0,0:07:38.82,0:07:39.94,CN,,0000,0000,0000,,Жеңге қарай алмайды
Dialogue: 0,0:07:40.20,0:07:42.31,CN,,0000,0000,0000,,Өлтіру керек.
Dialogue: 0,0:07:42.80,0:07:44.87,CN,,0000,0000,0000,,Теню Мейко
Dialogue: 0,0:07:45.47,0:07:49.01,CN,,0000,0000,0000,,Бар жеке қабілеттер мен сарқылмас күш-жігер
Dialogue: 0,0:07:50.36,0:07:51.75,CN,,0000,0000,0000,,Мичитака мен...
Dialogue: 0,0:07:53.38,0:07:58.49,CN,,0000,0000,0000,,Күн сайын айқын және сирек өкініш
Dialogue: 0,0:07:58.75,0:08:01.55,CN,,0000,0000,0000,,Сондықтан өлім кез келген уақытта болуы мүмкін.
Dialogue: 0,0:08:02.35,0:08:05.67,CN,,0000,0000,0000,,Бұл менің бейшара өмірім.
Dialogue: 0,0:08:20.02,0:08:23.17,CN,,0000,0000,0000,,Ақиқат келесі жөндеу бірінші болып табылады.
Dialogue: 0,0:08:23.37,0:08:24.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:26.35,0:08:28.79,CN,,0000,0000,0000,,Қалаға қара, өлген адам
Dialogue: 0,0:08:29.81,0:08:31.31,CN,,0000,0000,0000,,Бөлек шұғыл екінші жиналыс
Dialogue: 0,0:08:35.48,0:08:37.22,CN,,0000,0000,0000,,Жын-перілер
Dialogue: 0,0:08:39.18,0:08:40.58,CN,,0000,0000,0000,,Ләззат алу, ләззат алу, қашу
Dialogue: 0,0:08:40.58,0:08:41.32,CN,,0000,0000,0000,,Мичитака
Dialogue: 0,0:08:45.56,0:08:49.30,CN,,0000,0000,0000,,Бодхисаттваны еркін көруге болатын кезде
Dialogue: 0,0:08:50.11,0:08:51.28,,,0000,0000,0000,,Өлімнің соңы Өлімнің соңы
Dialogue: 0,0:08:49.32,0:08:53.00,CN,,0000,0000,0000,,Жарықтың бәрі бос, барлық қиыншылықтар мен бақытсыздықтар.
Dialogue: 0,0:08:51.60,0:08:53.57,,,0000,0000,0000,,Өлім үшін қажет
Dialogue: 0,0:08:53.26,0:08:57.75,CN,,0000,0000,0000,,Аспан аспаннан бөлек Түсі аспаннан Түсі аспан түсі түсі басқа
Dialogue: 0,0:09:17.08,0:09:17.63,CN,,0000,0000,0000,,Сәжде күйі
Dialogue: 0,0:09:18.90,0:09:20.95,CN,,0000,0000,0000,,Ұрыстың соңы
Dialogue: 0,0:09:22.09,0:09:23.99,CN,,0000,0000,0000,,Фудзивара Йошитаканың Жапонияға бұрынғы сапары
Dialogue: 0,0:09:27.61,0:09:30.63,CN,,0000,0000,0000,,Бүгін түнде қанша ересек адам келеді?
Dialogue: 0,0:09:31.32,0:09:32.42,CN,,0000,0000,0000,,Тәжірибедегі бар болу
Dialogue: 0,0:09:33.26,0:09:35.42,CN,,0000,0000,0000,,Рио Косейдің ісі маңызды.
Dialogue: 0,0:09:36.38,0:09:38.16,CN,,0000,0000,0000,,Не?
Dialogue: 0,0:09:38.73,0:09:42.84,CN,,0000,0000,0000,,Бұл шындық… Мен айырмашылықты жоғалттым.
Dialogue: 0,0:09:47.73,0:09:48.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:50.17,0:09:52.12,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:52.29,0:09:54.91,CN,,0000,0000,0000,,Сіз астананың түсін өзгерткіңіз келмейді
Dialogue: 0,0:09:54.92,0:09:55.91,CN,,0000,0000,0000,,әке
Dialogue: 0,0:09:56.35,0:09:58.81,CN,,0000,0000,0000,,Ағай
Dialogue: 0,0:09:59.20,0:10:01.97,CN,,0000,0000,0000,,Жиенге қарасам, жас жігіт деп ойлаймын.
Dialogue: 0,0:10:02.23,0:10:04.02,CN,,0000,0000,0000,,Бұл бірінші әрекет.
Dialogue: 0,0:10:06.85,0:10:10.56,CN,,0000,0000,0000,,Жағдай үшін кешірім сұраймын.
Dialogue: 0,0:10:11.71,0:10:13.96,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:14.47,0:10:15.36,CN,,0000,0000,0000,,Әңгіменің мәні неде?
Dialogue: 0,0:10:16.14,0:10:19.67,CN,,0000,0000,0000,,Бұдан кейін не болды?
Dialogue: 0,0:10:20.57,0:10:25.45,CN,,0000,0000,0000,,Қуанып, өлімге зәру кезім – есіме түскен кез.
Dialogue: 0,0:10:27.92,0:10:31.90,CN,,0000,0000,0000,,Өлім алдында сені көргенде намазхандық киім киюдің қажеті жоқ.
Dialogue: 0,0:10:32.78,0:10:35.06,CN,,0000,0000,0000,,Мен не істерімді білмеймін
Dialogue: 0,0:10:35.94,0:10:38.16,CN,,0000,0000,0000,,Неліктен бүгінгі кешке ерекше сапар?
Dialogue: 0,0:10:39.93,0:10:43.36,CN,,0000,0000,0000,,Мен сізді бұрыннан көргенмін.
Dialogue: 0,0:10:44.03,0:10:45.75,CN,,0000,0000,0000,,Қайтыс болған үлкенді аяймын.
Dialogue: 0,0:10:50.57,0:10:54.55,CN,,0000,0000,0000,,Бұдан кейін көрінбейді
Dialogue: 0,0:10:55.68,0:10:58.36,CN,,0000,0000,0000,,Менің есіме аз ғана қашықтық түседі
Dialogue: 0,0:11:05.90,0:11:06.54,CN,,0000,0000,0000,,Бірақ біз бір жерден бірдеңе тауып қалармыз.
Dialogue: 0,0:11:07.65,0:11:08.86,CN,,0000,0000,0000,,Ойлар мәңгілік...
Dialogue: 0,0:11:11.36,0:11:14.14,CN,,0000,0000,0000,,Сен осындасың
Dialogue: 0,0:11:20.73,0:11:23.97,CN,,0000,0000,0000,,Өзімді елестете отырып, өзіме қарау
Dialogue: 0,0:11:25.46,0:11:28.58,CN,,0000,0000,0000,,Біз ұзақ уақыт бірге тұрдық.
Dialogue: 0,0:11:29.23,0:11:30.75,CN,,0000,0000,0000,,Мен оны ұзақ оқыдым.
Dialogue: 0,0:11:31.63,0:11:33.97,CN,,0000,0000,0000,,Бұл Интайчиден бері жазылған жалғыз кітап.
Dialogue: 0,0:11:34.39,0:11:36.57,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:37.44,0:11:39.28,CN,,0000,0000,0000,,Эгоисттік алаңдаушылық
Dialogue: 0,0:11:41.41,0:11:46.09,CN,,0000,0000,0000,,Шындық – қате жоспар. Мен Мичитака қателескенін түсінемін.
Dialogue: 0,0:11:46.74,0:11:48.01,CN,,0000,0000,0000,,Бұл не деді?
Dialogue: 0,0:11:50.95,0:11:52.38,CN,,0000,0000,0000,,Ұзақ түн комиксі
Dialogue: 0,0:11:53.56,0:11:55.85,CN,,0000,0000,0000,,Мен тәкаппар, менменмін.
Dialogue: 0,0:11:57.81,0:12:01.11,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:03.74,0:12:13.58,&,,0000,0000,0000,,Бұл өмір тек Италия
Dialogue: 0,0:12:05.70,0:12:13.58,&,,0000,0000,0000,,100 өлім және жетіспеушілік
Dialogue: 0,0:12:06.74,0:12:13.58,&,,0000,0000,0000,,Йогунмен кездескеннен кейін
Dialogue: 0,0:12:08.58,0:12:13.58,&,,0000,0000,0000,,...
Dialogue: 0,0:12:12.84,0:12:16.82,CN,,0000,0000,0000,,Сіз өзіңіздің қазіргі жағдайыңызға жеткенде, сіз оны өлімсіз тікелей көре аласыз.
Dialogue: 0,0:12:17.78,0:12:23.59,CN,,0000,0000,0000,,Тікелей жетіп, сені көремін, Саған сиынамын, мен саған дұға етемін.
Dialogue: 0,0:12:26.17,0:12:31.73,CN,,0000,0000,0000,,21
Dialogue: 0,0:12:33.07,0:12:38.62,CN,,0000,0000,0000,,Өзін жақсы көретін адамдарды қорғайтын адамдар қандай сезімде болады?
Dialogue: 0,0:12:44.25,0:12:45.76,CN,,0000,0000,0000,,Жұмыртқаның ұзындығы ұзын емес.
Dialogue: 0,0:12:46.03,0:12:48.91,CN,,0000,0000,0000,,Шыны керек, тұмсық бір өрнекпен ойылған.
Dialogue: 0,0:12:49.22,0:12:50.97,CN,,0000,0000,0000,,Сіз үлкен бала бола аласыз.
Dialogue: 0,0:12:52.67,0:12:56.67,CN,,0000,0000,0000,,Мичитаканың ересек өмірі де ерте аяқталды.
Dialogue: 0,0:12:57.15,0:12:59.87,CN,,0000,0000,0000,,Одан кейін мен өте әйелдік әйелмін.
Dialogue: 0,0:13:00.49,0:13:01.38,CN,,0000,0000,0000,,Бұл кішкентай жын.
Dialogue: 0,0:13:03.47,0:13:05.97,&,,0000,0000,0000,,Такаучи Самурай Йомичитака
Dialogue: 0,0:13:03.47,0:13:05.97,,,0000,0000,0000,,Сол ана
Dialogue: 0,0:13:08.93,0:13:10.23,CN,,0000,0000,0000,,Әйелдің шынайы мәні
Dialogue: 0,0:13:11.41,0:13:15.04,CN,,0000,0000,0000,,Көп әйел алу – тайпадағы еркектердің жынысы
Dialogue: 0,0:13:15.79,0:13:21.02,CN,,0000,0000,0000,,Бірақ бұл әлемдегі идеалды әйел, қайтпас және төзімді гүл жүрегі және қара костюмді самурай т.б.
Dialogue: 0,0:13:23.45,0:13:25.86,CN,,0000,0000,0000,,Дегенмен, бұл шын және мейірімді.
Dialogue: 0,0:13:29.31,0:13:31.74,CN,,0000,0000,0000,,Менің оқиғам: Самурай Такаучи
Dialogue: 0,0:13:32.32,0:13:35.13,CN,,0000,0000,0000,,Мичитака Вакафуджо Ересек тәрізді
Dialogue: 0,0:13:35.44,0:13:38.19,CN,,0000,0000,0000,,Маңызды емес, маңызды емес.
Dialogue: 0,0:13:38.76,0:13:39.38,CN,,0000,0000,0000,,Мен не істеймін?
Dialogue: 0,0:13:41.49,0:13:43.99,CN,,0000,0000,0000,,Бұл адам өз нәсіліңіздің ханзадасы.
Dialogue: 0,0:13:44.56,0:13:47.00,CN,,0000,0000,0000,,Ең жиі қолданылатыны - басқалармен ойнау.
Dialogue: 0,0:13:44.96,0:13:48.11,,,0000,0000,0000,,Қылмыс жасау
Dialogue: 0,0:13:48.77,0:13:53.15,CN,,0000,0000,0000,,Ересек Мичитака: Неке мәселелерін мұқият қарастыру
Dialogue: 0,0:13:54.98,0:13:57.38,CN,,0000,0000,0000,,Үйленген әйелге тұрмысқа шыққанда
Dialogue: 0,0:13:57.62,0:14:00.23,CN,,0000,0000,0000,,Той өткізудің түрлі қолайсыздықтары
Dialogue: 0,0:14:03.19,0:14:08.58,CN,,0000,0000,0000,,Еркін махаббаттан ләззат ала алатыныңызды білу маңыздырақ
Dialogue: 0,0:14:08.96,0:14:12.39,CN,,0000,0000,0000,,Бұл мөлшерлемені оқудың қажеті жоқ
Dialogue: 0,0:14:12.84,0:14:16.19,CN,,0000,0000,0000,,Қайта оқу аяқталды
Dialogue: 0,0:14:16.20,0:14:18.09,CN,,0000,0000,0000,,Болашағым туралы ойлау
Dialogue: 0,0:14:19.35,0:14:21.69,CN,,0000,0000,0000,,Мен оны тамаша елестете аламын.
Dialogue: 0,0:14:22.82,0:14:24.94,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:25.38,0:14:28.63,CN,,0000,0000,0000,,Өйткені бұл әйел өмірінің астындағы балаға деген өзара махаббат.
Dialogue: 0,0:14:29.32,0:14:32.43,CN,,0000,0000,0000,,Мен сені кездестірдім, балам менің балам болды.
Dialogue: 0,0:14:32.81,0:14:36.90,CN,,0000,0000,0000,,Отбасының үздіксіз күш-жігеріне жанұяның адалдығы
Dialogue: 0,0:14:37.58,0:14:41.63,CN,,0000,0000,0000,,Мен сізге тек қана толыққанды өмір, махаббат пен қуаныш тілеймін.
Dialogue: 0,0:14:42.28,0:14:43.44,CN,,0000,0000,0000,,Бірінші қарау уақыты
Dialogue: 0,0:14:44.08,0:14:47.38,CN,,0000,0000,0000,,Бұл жердің болашақ көрінісі қазір теңіздің ортасында.
Dialogue: 0,0:14:48.28,0:14:51.39,CN,,0000,0000,0000,,Менің заңды әйелім некеден шығарылды.
Dialogue: 0,0:14:52.19,0:14:53.92,CN,,0000,0000,0000,,Осы өтінішке байланысты
Dialogue: 0,0:14:54.85,0:14:55.35,CN,,0000,0000,0000,,Мен тізерлеймін...
Dialogue: 0,0:14:57.65,0:14:58.16,CN,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:14:58.46,0:15:02.45,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:03.02,0:15:05.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:06.17,0:15:07.02,CN,,0000,0000,0000,,Ересек адамға тегін
Dialogue: 0,0:15:07.16,0:15:09.35,CN,,0000,0000,0000,,Сіздің отбасыңыздың махаббаты телефонда болғанда
Dialogue: 0,0:15:09.58,0:15:11.26,CN,,0000,0000,0000,,Алайда генерал-лейтенант ашулы.
Dialogue: 0,0:15:11.41,0:15:11.88,CN,,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:15:12.41,0:15:14.43,CN,,0000,0000,0000,,Соның нәтижесінде жарты аспан астана дүниеден өтті.
Dialogue: 0,0:15:15.55,0:15:16.72,CN,,0000,0000,0000,,Қолайсыз ниет Самурай Такаучи
Dialogue: 0,0:15:17.16,0:15:19.31,CN,,0000,0000,0000,,Мен сенімді емеспін, бірақ келесі жолы қайталап көремін.
Dialogue: 0,0:15:19.55,0:15:20.38,CN,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:15:20.99,0:15:22.33,CN,,0000,0000,0000,,Кейбір талаптардан төмен
Dialogue: 0,0:15:22.76,0:15:24.69,CN,,0000,0000,0000,,Біздің жеке жаңалықтарымыз
Dialogue: 0,0:15:26.06,0:15:27.63,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:27.75,0:15:28.87,CN,,0000,0000,0000,,Мен жаттығуға келдім.
Dialogue: 0,0:15:29.26,0:15:31.87,CN,,0000,0000,0000,,Ақылдымын, қоғам қайраткерімін.
Dialogue: 0,0:15:32.29,0:15:33.34,CN,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:15:34.03,0:15:38.85,CN,,0000,0000,0000,,Мұны істеу басқаларға оңай.\N22-бөлім
Dialogue: 0,0:15:39.47,0:15:42.83,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:43.52,0:15:45.20,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:15:46.01,0:15:47.09,CN,,0000,0000,0000,,Кішкентай қыздардың сәтсіздікке ұшырауынан қорқу
Dialogue: 0,0:15:47.88,0:15:50.89,CN,,0000,0000,0000,,Басқа динамика
Dialogue: 0,0:15:52.25,0:15:53.63,CN,,0000,0000,0000,,Кездесу туралы ойлар
Dialogue: 0,0:15:54.30,0:15:56.12,CN,,0000,0000,0000,,Басқалар
Dialogue: 0,0:15:56.99,0:15:59.46,CN,,0000,0000,0000,,Бірақ көңілім толмайды.
Dialogue: 0,0:16:00.65,0:16:03.65,CN,,0000,0000,0000,,Тыңдау кезінде басқа кескіндерді естуге болады
Dialogue: 0,0:16:04.40,0:16:07.23,CN,,0000,0000,0000,,Болашақта дереу жеткізу мүмкіндігі бар.
Dialogue: 0,0:16:08.85,0:16:09.65,CN,,0000,0000,0000,,Оларды таба аламыз ба, Мелони?
Dialogue: 0,0:16:10.56,0:16:15.24,CN,,0000,0000,0000,,Мен ғибадатханадағы самурай қызметін көргім келеді.
Dialogue: 0,0:16:16.08,0:16:20.72,CN,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:16:21.20,0:16:23.33,CN,,0000,0000,0000,,Үлкен сөздер маңызды.
Dialogue: 0,0:16:23.65,0:16:26.49,CN,,0000,0000,0000,,Басқа жақсы бейне жоқ.
Dialogue: 0,0:16:27.60,0:16:31.39,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:32.05,0:16:34.15,CN,,0000,0000,0000,,Тапсырыс орындалды.
Dialogue: 0,0:16:35.83,0:16:37.37,CN,,0000,0000,0000,,Бұл ең жақсы және ең нашар\N38-бөлім
Dialogue: 0,0:16:38.35,0:16:41.38,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:42.13,0:16:43.66,CN,,0000,0000,0000,,Ақиқат – терең шындық.
Dialogue: 0,0:16:44.35,0:16:46.92,CN,,0000,0000,0000,,Шынайы махаббат - әйелдер үшін стандарт
Dialogue: 0,0:16:47.83,0:16:52.04,CN,,0000,0000,0000,,Мен емес
Dialogue: 0,0:16:54.55,0:16:57.74,CN,,0000,0000,0000,,Әйелдерді де, ерлерді де қызықтыратын гүлдер жоқ.
Dialogue: 0,0:16:58.68,0:17:03.38,CN,,0000,0000,0000,,Иесі сабырлы кейіп танытып, келешекке алаңдаулы.
Dialogue: 0,0:17:04.04,0:17:04.62,CN,,0000,0000,0000,,I қосады
Dialogue: 0,0:17:05.57,0:17:10.80,CN,,0000,0000,0000,,Мен адал болу үшін күш салудан бас тартамын.
Dialogue: 0,0:17:13.10,0:17:18.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:20.01,0:17:20.68,CN,,0000,0000,0000,,Самурай Такаучи
Dialogue: 0,0:17:21.79,0:17:23.96,CN,,0000,0000,0000,,Сіз ұйықтап қалдыңыз
Dialogue: 0,0:17:24.83,0:17:28.10,CN,,0000,0000,0000,,Түнде ғибадатханада бәрі қара және қараңғы.
Dialogue: 0,0:17:28.10,0:17:29.19,CN,,0000,0000,0000,,Ересектерге арналған аударма
Dialogue: 0,0:17:29.73,0:17:31.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:32.39,0:17:35.32,CN,,0000,0000,0000,,Жастар гүлмен ойнауды қалай білуге болады?
Dialogue: 0,0:17:36.39,0:17:37.93,CN,,0000,0000,0000,,Ұсыныс аяқталды.
Dialogue: 0,0:17:38.91,0:17:40.35,CN,,0000,0000,0000,,Сіз
Dialogue: 0,0:17:40.98,0:17:42.09,CN,,0000,0000,0000,,Жел
Dialogue: 0,0:17:43.46,0:17:46.63,CN,,0000,0000,0000,,Мен мұнда болғаныма қуаныштымын, бірақ мен онымен ойнауым керек сияқты.
Dialogue: 0,0:17:47.03,0:17:50.01,CN,,0000,0000,0000,,Төзуге болатын немесе болмайтын адам сезімдері
Dialogue: 0,0:17:50.78,0:17:55.54,CN,,0000,0000,0000,,Әңгіменің Хакутен нұсқасы біршама әйелдік.
Dialogue: 0,0:17:56.46,0:17:59.43,CN,,0000,0000,0000,,Мен өзімді алдадым, ақшамды жоғалттым.
Dialogue: 0,0:17:59.93,0:18:02.33,CN,,0000,0000,0000,,Мен де құрметке лайықпын.
Dialogue: 0,0:18:09.01,0:18:10.00,CN,,0000,0000,0000,,Кешір мені.
Dialogue: 0,0:18:11.13,0:18:12.21,CN,,0000,0000,0000,,Мен есінен танып қалдым
Dialogue: 0,0:18:13.51,0:18:15.51,CN,,0000,0000,0000,,Мен үнемі кеуде қуысының тарылуын сезінемін.
Dialogue: 0,0:18:16.24,0:18:18.64,CN,,0000,0000,0000,,Қайта барудың қажеті жоқ
Dialogue: 0,0:18:18.64,0:18:20.30,CN,,0000,0000,0000,,Күйеуім қызметке ерте тұрудан бас тартты.
Dialogue: 0,0:18:21.26,0:18:22.55,CN,,0000,0000,0000,,Мен сіз айтып отырған жолды білмеймін.
Dialogue: 0,0:18:22.80,0:18:25.74,CN,,0000,0000,0000,,Дегенмен өз ойыма келгенде 2011 жылғы ескі оқиғалар ескерілді.
Dialogue: 0,0:18:26.54,0:18:27.13,CN,,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:18:27.64,0:18:28.17,CN,,0000,0000,0000,,Менің сөздерім
Dialogue: 0,0:18:28.78,0:18:31.62,CN,,0000,0000,0000,,Менің сенен күдіктенетінім заңды.
Dialogue: 0,0:18:32.43,0:18:33.96,CN,,0000,0000,0000,,Алайда мен өз жүрегімді айтпаймын.
Dialogue: 0,0:18:35.40,0:18:37.70,CN,,0000,0000,0000,,Мен сенің нағыз әйеліңмін.
Dialogue: 0,0:18:38.30,0:18:41.16,CN,,0000,0000,0000,,Алайда, ата-анамның айтуы бойынша, жолдасым екеуміз бірдейміз.
Dialogue: 0,0:18:41.53,0:18:44.47,CN,,0000,0000,0000,,Менің заңды әйелім
Dialogue: 0,0:18:45.19,0:18:47.89,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:48.65,0:18:49.81,CN,,0000,0000,0000,,Сондықтан мен бас тарттым
Dialogue: 0,0:18:50.98,0:18:53.40,CN,,0000,0000,0000,,Мен сүйген әйелді көрмеймін.
Dialogue: 0,0:18:56.19,0:18:58.03,CN,,0000,0000,0000,,Жақсы жауап, жақсы жауап
Dialogue: 0,0:18:59.20,0:19:02.77,CN,,0000,0000,0000,,Самурай Такаучи қайта тыңдау керек
Dialogue: 0,0:19:03.98,0:19:04.51,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:06.04,0:19:07.82,CN,,0000,0000,0000,,Мен айқайлаймын
Dialogue: 0,0:19:09.28,0:19:12.56,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:14.68,0:19:15.17,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:16.90,0:19:19.70,CN,,0000,0000,0000,,Сұраққа жауап бергенде, маған хабарлаңыз.
Dialogue: 0,0:19:20.33,0:19:22.08,CN,,0000,0000,0000,,Сізге қалай ұнайды?
Dialogue: 0,0:19:22.37,0:19:23.86,CN,,0000,0000,0000,,Әрине, сіздің антыңыз қандай?
Dialogue: 0,0:19:24.33,0:19:26.44,CN,,0000,0000,0000,,Менің өмірімдегі ең маңызды адам
Dialogue: 0,0:19:26.67,0:19:27.13,CN,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:19:27.45,0:19:31.60,CN,,0000,0000,0000,,Қажетсіз ұмыту.
Dialogue: 0,0:19:32.17,0:19:32.96,CN,,0000,0000,0000,,Пайда іздемеу
Dialogue: 0,0:19:33.67,0:19:37.16,CN,,0000,0000,0000,,Тыныштығыңды, Жүзіңнің астындағы құштарлықты көргеніме қуаныштымын
Dialogue: 0,0:19:38.02,0:19:38.86,CN,,0000,0000,0000,,Мен сені жақсы көремін.
Dialogue: 0,0:19:39.77,0:19:41.06,CN,,0000,0000,0000,,Мәңгілік бақытты боласың деп сенемін
Dialogue: 0,0:19:44.74,0:19:45.57,CN,,0000,0000,0000,,Самурай Такаучи
Dialogue: 0,0:19:46.84,0:19:49.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:49.43,0:19:50.09,CN,,0000,0000,0000,,Кьюки
Dialogue: 0,0:19:50.64,0:19:53.16,CN,,0000,0000,0000,,Бата көп
Dialogue: 0,0:19:54.02,0:19:56.48,CN,,0000,0000,0000,,Мен сізге көмектесуге келдім.
Dialogue: 0,0:19:57.18,0:20:00.99,CN,,0000,0000,0000,,Күйеуімнің әңгімесі
Dialogue: 0,0:20:02.04,0:20:03.55,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:20:04.30,0:20:06.79,CN,,0000,0000,0000,,Мен бұл туралы жай ғана ойлап отырмын, бірақ бұл сәл ақылға қонымды.
Dialogue: 0,0:20:07.10,0:20:10.28,CN,,0000,0000,0000,,Мұнда көрсетілгендей дереу жеткізу
Dialogue: 0,0:20:10.83,0:20:16.32,CN,,0000,0000,0000,,Менің досымның ең шынайы күдігі бар дегені дұрыс емес.
Dialogue: 0,0:20:16.87,0:20:18.01,CN,,0000,0000,0000,,Тәжірибедегі бар болу
Dialogue: 0,0:20:19.01,0:20:21.10,CN,,0000,0000,0000,,Ол да мейірімді, ерекше жақсы адам.
Dialogue: 0,0:20:21.99,0:20:26.42,CN,,0000,0000,0000,,Кішкене махаббат махаббаты естіледі, бірақ оның себебі - осында тұратын басқа адам әлемді мәңгілікке қорғайды.
Dialogue: 0,0:20:27.01,0:20:29.75,CN,,0000,0000,0000,,Осыдан кейін
Dialogue: 0,0:20:30.47,0:20:32.14,CN,,0000,0000,0000,,Бақыт
Dialogue: 0,0:20:32.73,0:20:35.12,CN,,0000,0000,0000,,Бұл анық
Dialogue: 0,0:20:36.00,0:20:39.66,CN,,0000,0000,0000,,Ең жақсысын және ең жаманын құттықтаймыз.
Dialogue: 0,0:20:41.51,0:20:44.57,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:45.14,0:20:47.28,CN,,0000,0000,0000,,Егер сіз бізге қосылуға дайын болсаңыз, бізге хабарласыңыз.
Dialogue: 0,0:20:47.80,0:20:49.02,CN,,0000,0000,0000,,Накафуджио
Dialogue: 0,0:20:49.57,0:20:53.85,CN,,0000,0000,0000,,Екі ата-ананың келісіміне дейін
Dialogue: 0,0:20:49.57,0:20:53.85,,,0000,0000,0000,,Ескертпе: Хэйан дәуірінде бұл «қосалқы неке», әйелі мен балалары бірге тұратын неке және заңды әйелі және тұрақты үйде тұратын әйелі бар заңды әйел.
Dialogue: 0,0:20:54.44,0:20:57.35,CN,,0000,0000,0000,,Қарт ғұлама – қорқынышты адам.
Dialogue: 0,0:20:58.64,0:20:59.46,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:00.24,0:21:03.52,CN,,0000,0000,0000,,Нана, т.б., мен сізге қайтадан үйленуге ресми түрде қош келдіңіз.
Dialogue: 0,0:21:03.90,0:21:06.81,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:07.30,0:21:07.80,CN,,0000,0000,0000,,Буггарати те ақшаға қатты мұқтаж болар
Dialogue: 0,0:21:08.79,0:21:10.82,CN,,0000,0000,0000,,Марқұмға кек бар
Dialogue: 0,0:21:11.60,0:21:13.46,CN,,0000,0000,0000,,Сіз ең маңызды адамсыз
Dialogue: 0,0:21:14.97,0:21:17.55,CN,,0000,0000,0000,,Дереу жеткізу енді осы бақыт сияқты
Dialogue: 0,0:21:18.18,0:21:19.72,CN,,0000,0000,0000,,Мен мазасызданамын
Dialogue: 0,0:21:20.98,0:21:23.59,CN,,0000,0000,0000,,Ер адам сыртқы жағынан жетілген болуы керек.
Dialogue: 0,0:21:24.36,0:21:27.14,CN,,0000,0000,0000,,Егер сізде заңды кепілдік болмаса, сіз ешқашан ойыңызды өзгертпейсіз.
Dialogue: 0,0:21:28.05,0:21:30.00,CN,,0000,0000,0000,,Сондықтан мен ойланып отырмын
Dialogue: 0,0:21:33.56,0:21:44.32,&,,0000,0000,0000,,Кимигото Сомори Эйфубо
Dialogue: 0,0:21:35.27,0:21:44.32,&,,0000,0000,0000,,...
Dialogue: 0,0:21:36.23,0:21:44.32,&,,0000,0000,0000,,Бүгінгі таңғы сурет
Dialogue: 0,0:21:38.02,0:21:44.32,&,,0000,0000,0000,,Бұл өмірде қандай мәселе бар?
Dialogue: 0,0:21:42.39,0:21:44.87,CN,,0000,0000,0000,,Толық ант, қасымда бір бала ғана.
Dialogue: 0,0:21:45.46,0:21:47.01,CN,,0000,0000,0000,,Каджиншин Йи Чан
Dialogue: 0,0:21:48.11,0:21:50.08,CN,,0000,0000,0000,,Сондықтан менің өмірім – өмірімнің соңы.
Dialogue: 0,0:21:51.14,0:21:53.26,CN,,0000,0000,0000,,Қайда мәңгі ғашық боласыз
Dialogue: 0,0:00:00.00,0:00:00.00,CN,,0000,0000,0000,,Болашақта Мичитака
Dialogue: 0,0:21:57.78,0:22:00.61,CN,,0000,0000,0000,,Мичитаканың туылғаннан кейінгі баласы
Dialogue: 0,0:22:01.11,0:22:03.75,CN,,0000,0000,0000,,Такая Мичидің заңды әйелі
Dialogue: 0,0:22:06.67,0:22:08.21,CN,,0000,0000,0000,,Император отбасына үйленген
Dialogue: 0,0:22:11.11,0:22:12.21,CN,,0000,0000,0000,,Лауазымды тағайындау
Dialogue: 0,0:22:14.54,0:22:16.71,CN,,0000,0000,0000,,Мацу-кунның мектепке келуі вака әні
Dialogue: 0,0:22:14.54,0:22:16.71,,,0000,0000,0000,,Ескерту: Мацу-кун: Мичимаса Фудзивараның сүт атауы
Dialogue: 0,0:22:17.06,0:22:18.39,CN,,0000,0000,0000,,Суға батқан махаббат бала
Dialogue: 0,0:22:18.55,0:22:20.03,CN,,0000,0000,0000,,Гасара Кишо
Dialogue: 0,0:22:20.87,0:22:22.18,CN,,0000,0000,0000,,Өте тәуелді махаббат
Dialogue: 0,0:22:24.67,0:22:26.05,CN,,0000,0000,0000,,Мичитака Йошихиса
Dialogue: 0,0:22:26.46,0:22:27.78,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:28.13,0:22:29.52,CN,,0000,0000,0000,,Жұмысты бастау
Dialogue: 0,0:22:30.04,0:22:33.09,CN,,0000,0000,0000,,Мен көп қиындық көргеніме өкінемін.
Dialogue: 0,0:22:33.40,0:22:35.92,CN,,0000,0000,0000,,Әңгімелесу Мен қазір осындамын.
Dialogue: 0,0:22:36.54,0:22:38.54,CN,,0000,0000,0000,,Маған ұнайды. Бұны ұнатамын.
Dialogue: 0,0:22:38.89,0:22:40.17,CN,,0000,0000,0000,,Ақиқат – сәтсіздіктің бір нүктесі
Dialogue: 0,0:24:14.00,0:24:17.26,CN,,0000,0000,0000,,Ибуки Ай Куса Мо Муари
Dialogue: 0,0:24:17.68,0:24:23.44,CN,,0000,0000,0000,,Ибукиноның жанып жатқан жүрегі және осы жағдай
Dialogue: 0,0:24:24.94,0:24:30.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory