Dialogue: 0,0:02:46.01,0:02:55.95,LOGO,,0000,0000,0000,,Бұл субтитр көзін God Subtitles Group (kamigami.org) жасаған, пайдаланушы ұсынған және коммерциялық пайдалануға тыйым салынған.
Dialogue: 0,0:02:46.01,0:02:55.95,,,0000,0000,0000,,: &  :Syura :apollius & Syura : : :
Dialogue: 0,0:00:04.83,0:00:07.55,JP2,,0000,0000,0000,,Сәлеметсіз бе, бұл Тейка Фудзивара серуендеп жатыр.
Dialogue: 0,0:00:08.22,0:00:09.73,JP2,,0000,0000,0000,,Бұл жер Огура тауы деп аталады.
Dialogue: 0,0:00:09.77,0:00:12.20,JP2,,0000,0000,0000,,Бұл жерде мен тұратын тау үйі орналасқан.
Dialogue: 0,0:00:12.49,0:00:13.79,JP2,,0000,0000,0000,,Тейка-кун
Dialogue: 0,0:00:15.18,0:00:16.94,JP2,,0000,0000,0000,,Мені артта қалдырма
Dialogue: 0,0:00:17.63,0:00:19.34,JP2,,0000,0000,0000,,Ол Йорицуна Уцуномия
Dialogue: 0,0:00:19.88,0:00:22.71,JP2,,0000,0000,0000,,Менің бір туысым жақын маңдағы тау үйінде тұрады.
Dialogue: 0,0:00:23.66,0:00:28.07,JP2,,0000,0000,0000,,Шындығында, Хякунин Исшу тау үйінің жылжымалы есіктерін безендіру үшін жасалған.
Dialogue: 0,0:00:28.38,0:00:28.61,JP2,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:00:31.37,0:00:34.94,JP2,,0000,0000,0000,,Өлең жазылған түрлі-түсті қағаздарды жапсыру сән болады деп ойладым.
Dialogue: 0,0:00:35.54,0:00:37.35,JP2,,0000,0000,0000,,Бір адамға жүз өлең
Dialogue: 0,0:00:38.14,0:00:39.39,JP2,,0000,0000,0000,,Мен мұны сұрадым.
Dialogue: 0,0:00:39.92,0:00:42.36,JP2,,0000,0000,0000,,Мен таңдадым
Dialogue: 0,0:00:42.77,0:00:46.16,JP2,,0000,0000,0000,,Қалай болғанда да, мен Тейка-кунның жақсы болғанына қуаныштымын.
Dialogue: 0,0:00:47.53,0:00:52.27,JP2,,0000,0000,0000,,Қараңызшы, мен кеше таңдаған жапон өлеңдерінің жаңа империялық антологиясы өте ұнамсыз болды және ол опасыздық болып шықты.
Dialogue: 0,0:00:52.76,0:00:54.27,JP2,,0000,0000,0000,,Мен мұнда қала алмаймын
Dialogue: 0,0:00:56.01,0:00:57.78,JP2,,0000,0000,0000,,Бұл менің кінәм емес
Dialogue: 0,0:00:58.51,0:01:02.56,JP2,,0000,0000,0000,,Өйткені ұлы адамдар бір нәрсемен ойнап, «бұл жақсы емес», «бұл жақсы емес» дейді.
Dialogue: 0,0:01:03.48,0:01:04.32,JP2,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:01:04.78,0:01:08.48,JP2,,0000,0000,0000,,Сондықтан мен сіз ішкі шеңберге арналған антологиядан қалағаныңызды таңдай аласыз деп ойладым.
Dialogue: 0,0:01:10.72,0:01:11.78,JP2,,0000,0000,0000,,Йорицуна-кун
Dialogue: 0,0:01:14.79,0:01:15.40,JP2,,0000,0000,0000,,Мен сенің үмітіңді артамын
Dialogue: 0,0:02:57.48,0:02:59.10,JP2,,0000,0000,0000,,Сәлем, мен қайтадан Тейкамын.
Dialogue: 0,0:02:59.69,0:03:03.48,JP2,,0000,0000,0000,,Кенет, Хякунин Исшу ақындарын еске алғанда,
Dialogue: 0,0:03:03.66,0:03:05.18,JP2,,0000,0000,0000,,Кім ойға келеді?
Dialogue: 0,0:03:06.20,0:03:09.02,JP2,,0000,0000,0000,,Басқа кітаптарға ән жазған атақты адамдардан
Dialogue: 0,0:03:09.21,0:03:11.01,JP2,,0000,0000,0000,,Тіпті білетіндер ғана білетіндер.
Dialogue: 0,0:03:11.53,0:03:14.35,JP2,,0000,0000,0000,,Хякунин Исшудың түрлі ақындары бар.
Dialogue: 0,0:03:15.32,0:03:17.47,JP2,,0000,0000,0000,,Олардың ішінде Йосеи-ин храмы
Dialogue: 0,0:03:18.01,0:03:22.37,JP2,,0000,0000,0000,,Оның аты Садааки, соңғы рет пайда болған Такаконың ұлы.
Dialogue: 0,0:03:22.93,0:03:26.67,JP2,,0000,0000,0000,,Хякунин Исшуде түсірілген оның бір әні ғана қалды.
Dialogue: 0,0:03:27.56,0:03:28.67,JP2,,0000,0000,0000,,Мен таңдадым
Dialogue: 0,0:03:30.74,0:03:33.18,JP2,,0000,0000,0000,,Садааки небәрі тоғыз жасында император болды.
Dialogue: 0,0:03:33.48,0:03:37.32,JP2,,0000,0000,0000,,Ол он жеті жасында тақтан бас тартып, Йосей-ин болды.
Dialogue: 0,0:03:37.76,0:03:39.74,JP2,,0000,0000,0000,,Оның билігі кезінде кім қызмет етті
Dialogue: 0,0:03:40.08,0:03:43.48,JP2,,0000,0000,0000,,Такакомен бірге қашып кеткен Аривара Нарихира
Dialogue: 0,0:03:44.89,0:03:49.21,JP2,,0000,0000,0000,,Оның үстіне Садааки өте қатыгез адам болған сияқты.
Dialogue: 0,0:03:51.46,0:03:53.55,JP2,,0000,0000,0000,,Император, тоқтаңыз.
Dialogue: 0,0:03:56.89,0:03:57.19,JP2,,0000,0000,0000,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:03:59.52,0:04:00.26,JP2,,0000,0000,0000,,Не болды?
Dialogue: 0,0:04:00.84,0:04:01.51,JP2,,0000,0000,0000,,Сарай
Dialogue: 0,0:04:01.68,0:04:02.67,JP2,,0000,0000,0000,,Сәлем Суико
Dialogue: 0,0:04:04.10,0:04:06.10,JP2,,0000,0000,0000,,Сіз қалай ойлайсыз? Жақсы ат екен.
Dialogue: 0,0:04:07.13,0:04:09.54,JP2,,0000,0000,0000,,Оның аздап қызбалығы бар, бірақ бәрібір.
Dialogue: 0,0:04:16.04,0:04:17.78,JP2,,0000,0000,0000,,Қош келдіңіз, Садааки-сама
Dialogue: 0,0:04:18.52,0:04:20.24,JP2,,0000,0000,0000,,Менімен тәттілер алғыңыз келе ме?
Dialogue: 0,0:04:22.19,0:04:24.51,JP2,,0000,0000,0000,,Сіз жүгіруден шаршаған болуыңыз керек.
Dialogue: 0,0:04:25.99,0:04:28.75,JP2,,0000,0000,0000,,Бұл жігіт мені үнемі мазақ етеді.
Dialogue: 0,0:04:29.92,0:04:31.81,JP2,,0000,0000,0000,,Алғаш кездескенде де солай болды.
Dialogue: 0,0:04:40.93,0:04:41.71,JP2,,0000,0000,0000,,Бір минут күтіңіз
Dialogue: 0,0:04:52.48,0:04:54.53,JP2,,0000,0000,0000,,Қалайсың, ханшайым?
Dialogue: 0,0:04:55.19,0:04:56.37,JP2,,0000,0000,0000,,Ах, генерал-лейтенант.
Dialogue: 0,0:04:57.02,0:04:58.24,JP2,,0000,0000,0000,,Уайымдамаңыз.
Dialogue: 0,0:05:06.10,0:05:07.29,JP2,,0000,0000,0000,,Иә, мырза.
Dialogue: 0,0:05:08.51,0:05:09.47,JP2,,0000,0000,0000,,Ол бекітілген.
Dialogue: 0,0:05:11.50,0:05:12.68,JP2,,0000,0000,0000,,Рахмет
Dialogue: 0,0:05:25.61,0:05:30.59,JP2,,0000,0000,0000,,Мырза, мен сізге ғимарат ішінде кемари ойнамау керектігін айттым.
Dialogue: 0,0:05:31.03,0:05:31.40,JP2,,0000,0000,0000,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:05:31.96,0:05:32.14,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:05:32.79,0:05:34.49,JP2,,0000,0000,0000,,Бұрынғы жалқау әйел
Dialogue: 0,0:05:35.10,0:05:37.47,JP2,,0000,0000,0000,,Әй, Рейко Минамото ханым.
Dialogue: 0,0:05:38.62,0:05:43.50,JP2,,0000,0000,0000,,Ол кейде Император сарайына үлкен әпкесі Император сарайының ойыншысы ретінде келеді.
Dialogue: 0,0:05:45.93,0:05:47.81,JP2,,0000,0000,0000,,Ол өте сүйкімді болуы керек.
Dialogue: 0,0:05:48.12,0:05:49.74,JP2,,0000,0000,0000,,Оның несі керемет?
Dialogue: 0,0:05:50.15,0:05:51.31,JP2,,0000,0000,0000,,Шіркін, өте ұсқынсыз
Dialogue: 0,0:05:52.86,0:05:54.25,JP2,,0000,0000,0000,,Бұл арнайы резеңке оқ.
Dialogue: 0,0:05:55.33,0:05:56.20,JP2,,0000,0000,0000,,Екінші бомба!
Dialogue: 0,0:05:57.97,0:06:01.29,JP2,,0000,0000,0000,,Садааки, сен де менімен ойнағың келе ме?
Dialogue: 0,0:06:04.67,0:06:05.39,JP2,,0000,0000,0000,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:06:14.16,0:06:16.26,JP2,,0000,0000,0000,,Сәлеметсіз бе, Садааки мырза
Dialogue: 0,0:06:17.53,0:06:18.30,JP2,,0000,0000,0000,,Онда барыңыз
Dialogue: 0,0:06:26.41,0:06:27.00,JP2,,0000,0000,0000,,...
Dialogue: 0,0:06:35.89,0:06:38.74,JP2,,0000,0000,0000,,Әлгі жігіт жиіркенішті.
Dialogue: 0,0:06:38.82,0:06:40.13,JP2,,0000,0000,0000,,Мен сені қандай да бір жолмен жазалағым келеді
Dialogue: 0,0:06:40.98,0:06:43.67,JP2,,0000,0000,0000,,Олай болса, әндерді оқып көрейік.
Dialogue: 0,0:06:44.44,0:06:46.63,JP2,,0000,0000,0000,,Ха, бұл неге ән?
Dialogue: 0,0:06:46.85,0:06:49.46,JP2,,0000,0000,0000,,Мен оны жазалау туралы айтып отырмын.
Dialogue: 0,0:06:50.33,0:06:51.92,JP2,,0000,0000,0000,,Огами: Әндер...
Dialogue: 0,0:06:51.92,0:06:55.34,JP2,,0000,0000,0000,,Мен ән айтқанды жек көремін. Апыр-ай.
Dialogue: 0,0:06:55.75,0:06:59.03,JP2,,0000,0000,0000,,Әй, бүгін кетеміз бе?
Dialogue: 0,0:06:59.41,0:07:00.95,JP2,,0000,0000,0000,,Ал... күтіңіз, саяхат туралы әңгіме
Dialogue: 0,0:07:01.17,0:07:03.08,JP2,,0000,0000,0000,,Сапарыңыз туралы айтқыңыз келсе, оны тыңдай аласыз.
Dialogue: 0,0:07:05.60,0:07:08.08,JP2,,0000,0000,0000,,Енді шығыс елге түскенде болған оқиғаға тоқталайық.
Dialogue: 0,0:07:10.11,0:07:12.06,JP2,,0000,0000,0000,,Содан Цукуба тауына келдік.
Dialogue: 0,0:07:12.65,0:07:17.69,JP2,,0000,0000,0000,,Екі шыңы бар тау, батыс жағы Нантай тауы, шығыс жағы Ньотай тауы деп аталады.
Dialogue: 0,0:07:17.98,0:07:21.18,JP2,,0000,0000,0000,,Иә, бұл керемет. Осылай ма?
Dialogue: 0,0:07:21.35,0:07:24.36,JP2,,0000,0000,0000,,Жоқ, оның пішіні тау сияқты дұрысырақ.
Dialogue: 0,0:07:24.85,0:07:26.29,JP2,,0000,0000,0000,,Не, бұл қызықсыз.
Dialogue: 0,0:07:26.63,0:07:28.32,JP2,,0000,0000,0000,,Жоқ, бұл қызық.
Dialogue: 0,0:07:28.93,0:07:31.90,JP2,,0000,0000,0000,,Бұл тауда көптен бері тамаша мерекелер болып тұрады.
Dialogue: 0,0:07:32.35,0:07:33.09,JP2,,0000,0000,0000,,Фестиваль
Dialogue: 0,0:07:34.29,0:07:37.14,JP2,,0000,0000,0000,,Утагакиге көп адам жиналды.
Dialogue: 0,0:07:37.47,0:07:39.92,JP2,,0000,0000,0000,,Би билеу, ән айту, өзін еркін ұстау
Dialogue: 0,0:07:41.59,0:07:45.24,JP2,,0000,0000,0000,,Барлығын ұмытып, махаббатты еркін іздеу
Dialogue: 0,0:07:45.46,0:07:47.87,JP2,,0000,0000,0000,,Тау құдайы тек сол күніңді кешіреді.
Dialogue: 0,0:07:50.37,0:07:53.63,JP2,,0000,0000,0000,,Екі шыңнан ерлер мен әйелдердің өзендері ағып жатыр.
Dialogue: 0,0:07:54.02,0:07:56.21,JP2,,0000,0000,0000,,Ақырында ол басқа өзендерге қосылды.
Dialogue: 0,0:07:56.61,0:07:58.71,JP2,,0000,0000,0000,,Тасқынға айналып, теңізге құяды.
Dialogue: 0,0:07:59.34,0:08:02.37,JP2,,0000,0000,0000,,Цукуба тауында туылған әлсіз махаббат сияқты.
Dialogue: 0,0:08:02.88,0:08:05.19,JP2,,0000,0000,0000,,Ол ақырында қатты махаббатқа айналатын сияқты
Dialogue: 0,0:08:07.22,0:08:10.64,JP2,,0000,0000,0000,,Бәрін махаббат пен романтикаға апармайсың ба.
Dialogue: 0,0:08:10.75,0:08:12.22,JP2,,0000,0000,0000,,Бұл мүлдем қызық емес.
Dialogue: 0,0:08:13.86,0:08:15.61,JP2,,0000,0000,0000,,Оны қазір көре аласыз.
Dialogue: 0,0:08:15.91,0:08:18.37,JP2,,0000,0000,0000,,Бұл не? Мұны айтудың жиіркенішті тәсілі.
Dialogue: 0,0:08:37.01,0:08:37.73,JP2,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:08:38.43,0:08:40.99,JP2,,0000,0000,0000,,Қандай тітіркендіргіш бақалар шоғыры!
Dialogue: 0,0:08:41.43,0:08:43.07,JP2,,0000,0000,0000,,Сіз ұйықтай алмайсыз, солай ма?
Dialogue: 0,0:08:45.61,0:08:46.22,JP2,,0000,0000,0000,,Титанның алдында сарбаздар бірінен соң бірі құлады.
Dialogue: 0,0:08:48.51,0:08:48.85,JP2,,0000,0000,0000,,Эй
Dialogue: 0,0:08:51.65,0:08:53.05,JP2,,0000,0000,0000,,Қайырлы кеш, Садааки-сама
Dialogue: 0,0:08:53.57,0:08:55.55,JP2,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:08:56.45,0:08:58.77,JP2,,0000,0000,0000,,Мен Имамия ханыммен сөйлестім.
Dialogue: 0,0:08:59.46,0:09:02.31,JP2,,0000,0000,0000,,Кеш батты, сондықтан мен одан түнеуін өтіндім.
Dialogue: 0,0:09:03.75,0:09:06.19,JP2,,0000,0000,0000,,Сіз император сарайында қызмет ететін ханым болып көрінесіз бе?
Dialogue: 0,0:09:08.51,0:09:08.97,JP2,,0000,0000,0000,,Жоқ
Dialogue: 0,0:09:09.75,0:09:12.36,JP2,,0000,0000,0000,,Жалғыз отыру өте кеш
Dialogue: 0,0:09:12.71,0:09:14.92,JP2,,0000,0000,0000,,Сізді құбыжық алып жеп қояды
Dialogue: 0,0:09:17.66,0:09:21.49,JP2,,0000,0000,0000,,Бұл не? Сіз реакцияға баяусыз.
Dialogue: 0,0:09:22.35,0:09:25.73,JP2,,0000,0000,0000,,Сендей дүлей адам болса, патша сарайының мәртебесі төмендейді.
Dialogue: 0,0:09:26.18,0:09:27.83,JP2,,0000,0000,0000,,Таңертең үйге тез кел.\NСіз
Dialogue: 0,0:09:28.62,0:09:28.99,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:09:29.62,0:09:31.17,JP2,,0000,0000,0000,,-де не істеп жатырсыз?
Dialogue: 0,0:09:33.28,0:09:36.08,JP2,,0000,0000,0000,,Түнде жалғыз сен мұнда не істеп жүрсің?
Dialogue: 0,0:09:39.01,0:09:42.81,JP2,,0000,0000,0000,,Бақаның даусы тынышталды, сондықтан мен оны жақын жерде тыңдадым.
Dialogue: 0,0:09:46.40,0:09:47.83,JP2,,0000,0000,0000,,Бұл жай ғана тітіркендіргіш емес пе?
Dialogue: 0,0:09:48.61,0:09:49.56,JP2,,0000,0000,0000,,Сіз шулысыз ба?
Dialogue: 0,0:09:50.87,0:09:53.68,JP2,,0000,0000,0000,,Ум, бірақ мені кешіріңіз.
Dialogue: 0,0:09:55.86,0:09:58.18,JP2,,0000,0000,0000,,Өйткені бақалар адамдарға қарағанда қысқа өмір сүреді.
Dialogue: 0,0:09:58.88,0:10:01.13,JP2,,0000,0000,0000,,Мен қазір қолымнан келгенше ән айтып жатырмын.
Dialogue: 0,0:10:02.30,0:10:05.01,JP2,,0000,0000,0000,,Жаз келсе, Цикадалардың үнін жақсы көремін.
Dialogue: 0,0:10:06.35,0:10:10.32,JP2,,0000,0000,0000,,Осыншама кішкентай тірліктің қалай сыналғанын ойласаң
Dialogue: 0,0:10:12.19,0:10:15.28,JP2,,0000,0000,0000,,Мен өте жақсы болмасам да, мен бар күшімді саламын деп ойлаймын.
Dialogue: 0,0:10:24.03,0:10:26.06,JP2,,0000,0000,0000,,Қайырлы түн, Садааки-сама.
Dialogue: 0,0:10:31.46,0:10:33.01,JP2,,0000,0000,0000,,Бақалардан қалай құтылуға болады?
Dialogue: 0,0:10:33.22,0:10:34.17,JP2,,0000,0000,0000,,Иә, маған жауап беріңіз.
Dialogue: 0,0:10:36.71,0:10:40.04,JP2,,0000,0000,0000,,Ендеше, жыланды неге шақпасқа?
Dialogue: 0,0:10:40.56,0:10:40.83,JP2,,0000,0000,0000,,Жылан
Dialogue: 0,0:10:41.22,0:10:43.64,JP2,,0000,0000,0000,,Иә, өйткені жыландар бақаларды жейді.
Dialogue: 0,0:10:44.18,0:10:45.93,JP2,,0000,0000,0000,,Қолың болмаса қалай тамақ ішесің?
Dialogue: 0,0:10:46.40,0:10:47.84,JP2,,0000,0000,0000,,Мен оны толығымен жұтып аламын.
Dialogue: 0,0:10:48.16,0:10:48.74,JP2,,0000,0000,0000,,Жұту
Dialogue: 0,0:10:49.51,0:10:53.76,JP2,,0000,0000,0000,,Иә, онда жыланның іші ісіп, қызық болады.
Dialogue: 0,0:10:54.53,0:10:56.59,JP2,,0000,0000,0000,,Мен түсіндім, бұл көңілді естіледі.
Dialogue: 0,0:10:57.36,0:10:58.58,JP2,,0000,0000,0000,,Рахмет, генерал-лейтенант.
Dialogue: 0,0:10:59.68,0:11:01.40,JP2,,0000,0000,0000,,Мен көмектескеніме қуаныштымын.
Dialogue: 0,0:11:06.19,0:11:06.59,JP2,,0000,0000,0000,,Не?
Dialogue: 0,0:11:06.69,0:11:07.09,JP2,,0000,0000,0000,,Не болды?
Dialogue: 0,0:11:07.49,0:11:09.77,JP2,,0000,0000,0000,,Жыланға…
Dialogue: 0,0:11:09.77,0:11:11.25,JP2,,0000,0000,0000,,Ой, бұл не?
Dialogue: 0,0:11:11.35,0:11:12.82,JP2,,0000,0000,0000,,Осыншама көп қайдан келді?
Dialogue: 0,0:11:13.48,0:11:15.78,JP2,,0000,0000,0000,,Мені тез шығарып жіберіңізші.
Dialogue: 0,0:11:15.78,0:11:16.98,JP2,,0000,0000,0000,,Біреуді қуып шыққанда не істейсің?
Dialogue: 0,0:11:17.41,0:11:19.15,JP2,,0000,0000,0000,,Тормен немесе басқалармен ұсталған жоқ па?
Dialogue: 0,0:11:20.71,0:11:22.33,JP2,,0000,0000,0000,,Жоқ, жоқ, келме.
Dialogue: 0,0:11:23.62,0:11:25.29,JP2,,0000,0000,0000,,Неге қашып бара жатырсың?
Dialogue: 0,0:11:25.53,0:11:27.32,JP2,,0000,0000,0000,,Қашпа, маған көмектес
Dialogue: 0,0:11:28.08,0:11:32.21,JP2,,0000,0000,0000,,Қараңдаршы, тынбай еңбек етіп жүрген достарыңды ана жерде, бірде жеп жатыр.
Dialogue: 0,0:11:32.89,0:11:34.81,JP2,,0000,0000,0000,,Мен енді ән айта алмаймын деп жылап отырмын
Dialogue: 0,0:11:35.03,0:11:36.95,JP2,,0000,0000,0000,,Мен саған көмектесемін, жүр.
Dialogue: 0,0:11:37.34,0:11:39.30,JP2,,0000,0000,0000,,Мен ештеңеге шебер емеспін, бірақ мен бар күшімді саламын.
Dialogue: 0,0:11:39.55,0:11:42.67,JP2,,0000,0000,0000,,Егер сіз оны білмесеңіз, неге сіз аздап күйзеліске түспейсіз?
Dialogue: 0,0:11:43.33,0:11:46.11,JP2,,0000,0000,0000,,Эй, солай істе, сені жек көреді.
Dialogue: 0,0:11:47.00,0:11:49.89,JP2,,0000,0000,0000,,Сондықтан, бұл жігіттің не ойлайтыны маған бәрібір.
Dialogue: 0,0:11:49.91,0:11:55.65,JP2,,0000,0000,0000,,Жек көру Мен Садааки-саманы жек көремін.
Dialogue: 0,0:11:57.30,0:11:58.84,JP2,,0000,0000,0000,,Эй, көрдің бе?
Dialogue: 0,0:12:00.24,0:12:03.99,JP2,,0000,0000,0000,,Мен де сені жек көремін.
Dialogue: 0,0:12:05.13,0:12:08.33,JP2,,0000,0000,0000,,Қараңдаршы шіркін шіркін шіркін супер шіркін
Dialogue: 0,0:12:12.47,0:12:17.21,JP2,,0000,0000,0000,,Егер мұндай еркелік жасайтын болсаңыз, маған айтпауыңыз керек еді.
Dialogue: 0,0:12:17.48,0:12:19.54,JP2,,0000,0000,0000,,Шулы Мен оны жазаладым.
Dialogue: 0,0:12:20.20,0:12:22.81,JP2,,0000,0000,0000,,Сыра қайнатушылардың өздерін тазалауы да қиын.
Dialogue: 0,0:12:23.37,0:12:24.21,JP2,,0000,0000,0000,,Маңызды ма?
Dialogue: 0,0:12:25.00,0:12:28.23,JP2,,0000,0000,0000,,Олар мені бәрібір қиын деп санайды.
Dialogue: 0,0:12:30.22,0:12:32.36,JP2,,0000,0000,0000,,Ешкім олай ойламайды.
Dialogue: 0,0:12:32.51,0:12:35.82,JP2,,0000,0000,0000,,Өтірік айтпа, мен де соны білемін.
Dialogue: 0,0:12:36.47,0:12:38.37,JP2,,0000,0000,0000,,Кез келген адам император бола алар еді, солай ма?
Dialogue: 0,0:12:38.95,0:12:42.21,JP2,,0000,0000,0000,,Үлкендер не істегісі келеді, сондықтан олар мені бала ретінде орнатты.
Dialogue: 0,0:12:43.34,0:12:45.17,JP2,,0000,0000,0000,,Сонда мен қалағанымды істеймін.
Dialogue: 0,0:12:46.10,0:12:49.44,JP2,,0000,0000,0000,,Мені бала деп ойлап, мазақ ететіндердің есіне салайын.
Dialogue: 0,0:12:50.22,0:12:52.55,JP2,,0000,0000,0000,,Дұрыс, генерал-лейтенант, келесі жолы маған қылышты үйретіңіз.
Dialogue: 0,0:12:52.96,0:12:54.18,JP2,,0000,0000,0000,,Бұл қызықты көрінеді.
Dialogue: 0,0:12:55.10,0:12:57.68,JP2,,0000,0000,0000,,Олай болса, бұдан былай біз саяхат туралы айтпаймыз.
Dialogue: 0,0:12:58.20,0:12:59.59,JP2,,0000,0000,0000,,Ән өнерін үйренейік
Dialogue: 0,0:13:01.56,0:13:06.29,JP2,,0000,0000,0000,,Генерал-лейтенант, сен ақымақсың ба? Бұл ән емес, қылыш. Есту қабілетіңіз жоғалып кетті ме?
Dialogue: 0,0:13:06.92,0:13:07.85,JP2,,0000,0000,0000,,Жоқ мырза
Dialogue: 0,0:13:08.45,0:13:11.88,JP2,,0000,0000,0000,,Әндер тек сен сияқты жындарға керек.
Dialogue: 0,0:13:12.28,0:13:14.04,JP2,,0000,0000,0000,,Мен зұлым жын емеспін
Dialogue: 0,0:13:14.24,0:13:14.92,JP2,,0000,0000,0000,,Әндер жалықтырады
Dialogue: 0,0:13:15.78,0:13:17.24,JP2,,0000,0000,0000,,Күте тұрыңыз.
Dialogue: 0,0:13:18.11,0:13:20.57,JP2,,0000,0000,0000,,Мен де мәңгілікке ақша жұмсай алмаймын.
Dialogue: 0,0:13:22.14,0:13:23.39,JP2,,0000,0000,0000,,Генерал-лейтенант, сіз отставкаға кетесіз бе?
Dialogue: 0,0:13:23.87,0:13:29.08,JP2,,0000,0000,0000,,Жоқ, бастығым жұмыстан кетуімді бұйырмайынша, ақша жұмсауды жалғастырғым келеді.
Dialogue: 0,0:13:29.20,0:13:30.66,JP2,,0000,0000,0000,,Мен олай айтпаймын
Dialogue: 0,0:13:31.35,0:13:36.37,JP2,,0000,0000,0000,,Бірақ сіз кәмелеттік жасқа дейін аман қаласыз ба?
Dialogue: 0,0:13:37.15,0:13:40.91,JP2,,0000,0000,0000,,Сондықтан қолымнан келгенше саған бірдеңе қалдырғым келеді.
Dialogue: 0,0:13:42.22,0:13:43.79,JP2,,0000,0000,0000,,Отырыңыз.
Dialogue: 0,0:13:48.27,0:13:49.36,JP2,,0000,0000,0000,,Ән жақсы.
Dialogue: 0,0:13:50.46,0:13:53.90,JP2,,0000,0000,0000,,Мен өз сезімімді жасырмай айта аламын.
Dialogue: 0,0:13:55.38,0:13:57.41,JP2,,0000,0000,0000,,Өйткені шығудың жолы бар.
Dialogue: 0,0:13:58.08,0:13:58.66,JP2,,0000,0000,0000,,Қашу жолы
Dialogue: 0,0:13:59.08,0:13:59.32,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:14:00.86,0:14:05.47,JP2,,0000,0000,0000,,Мысалы, сіз аузыңызға ұятсыз сөздер айтып, әйелді өзіне баурап алғыңыз келді делік.
Dialogue: 0,0:14:06.31,0:14:09.20,JP2,,0000,0000,0000,,Мені тастап кетсе, ұялып, мұңаямын.
Dialogue: 0,0:14:09.30,0:14:10.93,JP2,,0000,0000,0000,,Артында ештеңе қалдырмаған үлкен соққы.
Dialogue: 0,0:14:11.57,0:14:13.21,JP2,,0000,0000,0000,,Бірақ бұл ән болса
Dialogue: 0,0:14:13.58,0:14:16.12,JP2,,0000,0000,0000,,Егер сіз жай ғана махаббат туралы ән жазған болсаңыз, сіз ақтауға болады.
Dialogue: 0,0:14:16.65,0:14:18.66,JP2,,0000,0000,0000,,Бұл салмақ тастауға тырысу ғана емес.
Dialogue: 0,0:14:19.04,0:14:21.58,JP2,,0000,0000,0000,,Шығарма жақсы болса, ұрпаққа қалуы мүмкін.
Dialogue: 0,0:14:22.09,0:14:22.80,JP2,,0000,0000,0000,,Бұл жақсы келісім
Dialogue: 0,0:14:23.42,0:14:24.71,JP2,,0000,0000,0000,,Оның үстіне бұл арзан.
Dialogue: 0,0:14:25.89,0:14:27.62,JP2,,0000,0000,0000,,Ән айту қызықсыз.
Dialogue: 0,0:14:27.98,0:14:28.83,JP2,,0000,0000,0000,,Мен оны естіп, жоғалтып алдым.
Dialogue: 0,0:14:29.53,0:14:31.13,JP2,,0000,0000,0000,,Жарайды, себебі бұл тривиальды.
Dialogue: 0,0:14:32.79,0:14:37.70,JP2,,0000,0000,0000,,Бұл өте ұсақ-түйек болғандықтан, мен әдетте айта алмайтын нәрселерді шын айта аламын.
Dialogue: 0,0:14:38.78,0:14:41.56,JP2,,0000,0000,0000,,Өлеңді айтса, байлаулы кетеді.
Dialogue: 0,0:14:41.81,0:14:43.95,JP2,,0000,0000,0000,,Адал болу үшін
Dialogue: 0,0:14:45.30,0:14:47.68,JP2,,0000,0000,0000,,Сіз қалай ойлайсыз? Бұл аспанның зұлым рухтары үшін өте қолайлы.
Dialogue: 0,0:14:48.37,0:14:50.35,JP2,,0000,0000,0000,,Сондықтан мен зұлым жын емеспін
Dialogue: 0,0:14:53.19,0:14:55.10,JP2,,0000,0000,0000,,Бір жылдан аз уақыт өткен соң
Dialogue: 0,0:14:55.81,0:14:58.51,JP2,,0000,0000,0000,,Нарихира енді бұл дүниенің адамы емес.
Dialogue: 0,0:15:05.35,0:15:08.32,JP2,,0000,0000,0000,,Ана Ана
Dialogue: 0,0:15:10.50,0:15:11.43,JP2,,0000,0000,0000,,Не болды?
Dialogue: 0,0:15:12.83,0:15:15.91,JP2,,0000,0000,0000,,Жоқ, кенет менің есіме өткендегі бірдеңе түсті.
Dialogue: 0,0:15:17.58,0:15:21.97,JP2,,0000,0000,0000,,Саған не болды? Сіз сондай қайғылы көрінесіз.
Dialogue: 0,0:15:23.22,0:15:27.87,JP2,,0000,0000,0000,,Генерал-лейтенант Нарихира қайтыс болды.
Dialogue: 0,0:15:31.42,0:15:34.85,JP2,,0000,0000,0000,,Иә, жалғыздық болады.
Dialogue: 0,0:15:36.58,0:15:39.69,JP2,,0000,0000,0000,,Ол маған ұнады.
Dialogue: 0,0:15:41.73,0:15:46.40,JP2,,0000,0000,0000,,Маған шын көңіл бөлген және менің кім екенімді көрген адам.
Dialogue: 0,0:15:47.06,0:15:50.50,JP2,,0000,0000,0000,,Анамнан басқа Нарихира жалғыз еді.
Dialogue: 0,0:15:51.53,0:15:54.90,JP2,,0000,0000,0000,,Мен айналамдағы адамдармен келіспеушілік таныта бастадым.
Dialogue: 0,0:15:57.61,0:15:59.24,JP2,,0000,0000,0000,,Тоқтаңыз.
Dialogue: 0,0:15:59.64,0:16:01.10,JP2,,0000,0000,0000,,Шулы. Ауызыңды жап.
Dialogue: 0,0:16:02.00,0:16:07.12,JP2,,0000,0000,0000,,Ал анамның үлкен ағасы, Дажо министрі Мотоцуне Фудзивара шешім қабылдайды.
Dialogue: 0,0:16:08.73,0:16:11.59,JP2,,0000,0000,0000,,17 жасымда мені тақтан тайдырды.
Dialogue: 0,0:16:12.31,0:16:14.20,JP2,,0000,0000,0000,,Император князі Токиясу император болды
Dialogue: 0,0:16:15.36,0:16:20.82,JP2,,0000,0000,0000,,Оның ұлы Минамото но Садами, әрі қарай қол астындағы мәртебесіне дейін төмендеп, тақ мұрагері болды және оның орнына келді.
Dialogue: 0,0:16:21.85,0:16:23.83,JP2,,0000,0000,0000,,Министрлік пен менің арамызда келіспеушілік туындамас үшін.
Dialogue: 0,0:16:24.42,0:16:27.88,JP2,,0000,0000,0000,,Менің айналамдағы адамдар маған Тейшоның қарындасын үйлендірмек болды.
Dialogue: 0,0:16:29.28,0:16:33.02,JP2,,0000,0000,0000,,Тейшоның сіңлісі, бұл Суико болатын.
Dialogue: 0,0:16:34.36,0:16:37.45,JP2,,0000,0000,0000,,Бейшара Суйко, ағасы үшін, елі үшін.
Dialogue: 0,0:16:38.01,0:16:40.37,JP2,,0000,0000,0000,,Сіз жек көретін адамға өзіңізді ұсынуыңыз керек
Dialogue: 0,0:16:42.11,0:16:43.76,JP2,,0000,0000,0000,,Қандай байғұс әйел.
Dialogue: 0,0:16:44.06,0:16:47.18,JP2,,0000,0000,0000,,Өзіңіз жек көретін адамға тұрмысқа шығу қандай сезімде болады?
Dialogue: 0,0:16:47.65,0:16:48.91,JP2,,0000,0000,0000,,Қызықсыз бақа әйел
Dialogue: 0,0:16:52.37,0:16:54.01,JP2,,0000,0000,0000,,Есте сақтағаныңызға рахмет.
Dialogue: 0,0:16:55.90,0:16:58.07,JP2,,0000,0000,0000,,Мен жалықтыру үшін бар күшімді саламын.
Dialogue: 0,0:16:59.18,0:17:01.40,JP2,,0000,0000,0000,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:17:03.52,0:17:06.03,JP2,,0000,0000,0000,,Ол әлі тек жиіркенішті сөздерді айтатын әйел.
Dialogue: 0,0:17:10.66,0:17:13.67,JP2,,0000,0000,0000,,Құрметті Садааки, ай өте әдемі.
Dialogue: 0,0:17:15.61,0:17:17.46,JP2,,0000,0000,0000,,Бүгін бізге келгеніңіз үшін рахмет.
Dialogue: 0,0:17:18.28,0:17:21.92,JP2,,0000,0000,0000,,Мен бармасам шуылдайтындар бар деп келдім.
Dialogue: 0,0:17:22.21,0:17:23.00,JP2,,0000,0000,0000,,Мен ұйықтаймын
Dialogue: 0,0:17:23.59,0:17:24.75,JP2,,0000,0000,0000,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:17:25.43,0:17:28.68,JP2,,0000,0000,0000,,Төсегіңді жинап алайық, сонда бірден ұйықтайсың.
Dialogue: 0,0:17:32.32,0:17:34.74,JP2,,0000,0000,0000,,Рейко, сен тіпті мені ғашық ете аласың.
Dialogue: 0,0:17:36.55,0:17:37.89,JP2,,0000,0000,0000,,Әлде бар ма?
Dialogue: 0,0:17:38.80,0:17:41.50,JP2,,0000,0000,0000,,Үнемі күліп жүреді, еш уайымы жоқ сияқты.
Dialogue: 0,0:17:42.02,0:17:44.30,JP2,,0000,0000,0000,,Қызық, менің арызымды кім тыңдап жатыр?
Dialogue: 0,0:17:46.16,0:17:47.30,JP2,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:17:47.85,0:17:49.42,JP2,,0000,0000,0000,,Мен уайымдағандықтан істеп жатырмын.
Dialogue: 0,0:17:50.55,0:17:55.04,JP2,,0000,0000,0000,,Мен сияқты бейбақпен өміріңді аяқтау аянышты болар еді.
Dialogue: 0,0:17:55.97,0:17:58.46,JP2,,0000,0000,0000,,Мен саған тиіспеймін деп ренжіген шығарсың.
Dialogue: 0,0:17:59.24,0:18:02.18,JP2,,0000,0000,0000,,Басқа жерде деміңді ал, маған бәрібір.
Dialogue: 0,0:18:03.61,0:18:07.62,JP2,,0000,0000,0000,,Сіз мен туралы тек жаман қауесет естіген шығарсыз.
Dialogue: 0,0:18:08.93,0:18:10.70,JP2,,0000,0000,0000,,Егер ол ыңғайсыз болып қалса, кесіңіз
Dialogue: 0,0:18:11.50,0:18:14.90,JP2,,0000,0000,0000,,Жас императорды қуып жіберу түк емес болар еді.
Dialogue: 0,0:18:15.66,0:18:18.55,JP2,,0000,0000,0000,,Нағыз мені ешкім көргісі келмейді
Dialogue: 0,0:18:19.38,0:18:21.31,JP2,,0000,0000,0000,,Сен де, Рейко.
Dialogue: 0,0:18:24.74,0:18:27.76,JP2,,0000,0000,0000,,Мен бұл істі жалғастыра аламын деп ешқашан ойламадым.
Dialogue: 0,0:18:29.10,0:18:32.93,JP2,,0000,0000,0000,,Мұның мәні неде? Мен сенің болашағыңды ойлап, сені ойлап жүрмін.
Dialogue: 0,0:18:33.56,0:18:35.86,JP2,,0000,0000,0000,,Мен сені сүйгендіктен үйленбедім.
Dialogue: 0,0:18:36.75,0:18:38.75,JP2,,0000,0000,0000,,Сен де солайсың, солай ма? Біз ортақпыз.
Dialogue: 0,0:18:39.17,0:18:41.85,JP2,,0000,0000,0000,,Барлығы істеп жатыр, сіз де өзіңізге ұнайтын нәрсені жасай аласыз.
Dialogue: 0,0:18:43.58,0:18:47.63,JP2,,0000,0000,0000,,Менің ойымша, мұны басқалардың бәрі істеп жатқандықтан, маған рұқсат беру мүмкін емес.
Dialogue: 0,0:18:49.60,0:18:52.30,JP2,,0000,0000,0000,,Бірақ сіз әйел сияқты махаббатты сынап көргіңіз келеді, солай ма?
Dialogue: 0,0:18:53.00,0:18:53.30,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:18:55.63,0:18:56.15,JP2,,0000,0000,0000,,Сіздермен бірге
Dialogue: 0,0:18:59.30,0:19:00.95,JP2,,0000,0000,0000,,Сіз мені жек көресіз, солай ма?
Dialogue: 0,0:19:01.49,0:19:03.01,JP2,,0000,0000,0000,,Иә, маған ұнамайды.
Dialogue: 0,0:19:04.11,0:19:06.67,JP2,,0000,0000,0000,,Әйтсе де, осылайша қарындас болдым.
Dialogue: 0,0:19:07.10,0:19:09.12,JP2,,0000,0000,0000,,Мен саған ғашық боламын
Dialogue: 0,0:19:10.34,0:19:12.18,JP2,,0000,0000,0000,,Себебі мен қалаусыз некеге тұруға мәжбүр болдым
Dialogue: 0,0:19:12.55,0:19:15.35,JP2,,0000,0000,0000,,Алдау – шындыққа бет бұру.
Dialogue: 0,0:19:16.93,0:19:18.99,JP2,,0000,0000,0000,,Алдыңда жарыңнан қашудың орнына
Dialogue: 0,0:19:19.83,0:19:22.52,JP2,,0000,0000,0000,,Мен ол адамды ұнатқым келеді.
Dialogue: 0,0:19:24.22,0:19:25.59,JP2,,0000,0000,0000,,Бұрын не болды?
Dialogue: 0,0:19:26.04,0:19:28.41,JP2,,0000,0000,0000,,Садааки-саманың адамдарды сынайтын сөздері
Dialogue: 0,0:19:28.78,0:19:29.52,JP2,,0000,0000,0000,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:19:30.94,0:19:34.06,JP2,,0000,0000,0000,,Саған неліктен жала жауып, күдік туғызып жатқанын түсінемін.
Dialogue: 0,0:19:34.42,0:19:36.12,JP2,,0000,0000,0000,,Әңгімелесуден аулақ болыңыз.
Dialogue: 0,0:19:36.36,0:19:36.93,JP2,,0000,0000,0000,,Ижике…
Dialogue: 0,0:19:38.16,0:19:39.80,JP2,,0000,0000,0000,,Мұқият тыңда, Садааки-сама.
Dialogue: 0,0:19:40.71,0:19:42.74,JP2,,0000,0000,0000,,Мен саған ешқашан опасыздық жасамаймын
Dialogue: 0,0:19:44.25,0:19:47.48,JP2,,0000,0000,0000,,Осыны есте сақтаңыз.
Dialogue: 0,0:19:54.38,0:19:57.52,JP2,,0000,0000,0000,,Сау болыңыз және қайта келіңіз.
Dialogue: 0,0:20:07.66,0:20:10.71,JP2,,0000,0000,0000,,Мен әдетте дауыстап айта алмайтын нәрселерді шын айта аламын.
Dialogue: 0,0:20:11.41,0:20:14.32,JP2,,0000,0000,0000,,Өлеңді айтса, байлаулы кетеді.
Dialogue: 0,0:20:14.74,0:20:16.66,JP2,,0000,0000,0000,,Сіз еркін және адал бола аласыз
Dialogue: 0,0:20:19.70,0:20:22.08,JP2,,0000,0000,0000,,Сия тасты алып, сөйлем құра
Dialogue: 0,0:20:34.16,0:20:38.42,JP2,,0000,0000,0000,,Тіпті бар немесе жоқ ойлар қазірдің өзінде жинақталып, үйіліп жатыр.
Dialogue: 0,0:20:39.21,0:20:42.32,JP2,,0000,0000,0000,,Мен сені қатты жақсы көремін
Dialogue: 0,0:20:44.11,0:20:44.69,JP2,,0000,0000,0000,,Сарай
Dialogue: 0,0:20:47.71,0:20:49.70,JP2,,0000,0000,0000,,Сіз қалай айттыңыз, мырза?
Dialogue: 0,0:20:50.19,0:20:53.21,JP2,,0000,0000,0000,,Сіз тағы да күдікті бірдеңе айттыңыз ба?
Dialogue: 0,0:20:53.60,0:20:57.60,JP2,,0000,0000,0000,,Жоқ. Ерекше шынайы сөздеріңіз үшін рахмет.
Dialogue: 0,0:20:58.90,0:21:00.09,JP2,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:21:06.03,0:21:08.87,JP2,,0000,0000,0000,,Сіз кімсіз, сенімдісіз бе?
Dialogue: 0,0:21:09.72,0:21:12.30,JP2,,0000,0000,0000,,Бүгін таңғы тамаша ән үшін рахмет.
Dialogue: 0,0:21:13.62,0:21:14.80,JP2,,0000,0000,0000,,Мен өте қуаныштымын.
Dialogue: 0,0:21:15.86,0:21:18.29,JP2,,0000,0000,0000,,А...бұл әлеуметтік қимыл.
Dialogue: 0,0:21:18.59,0:21:19.73,JP2,,0000,0000,0000,,Мұқият қабылдама Шіркін
Dialogue: 0,0:21:19.94,0:21:24.24,JP2,,0000,0000,0000,,Бұл өтірік. Мен Садааки-саманың сезімін түсінемін.
Dialogue: 0,0:21:24.24,0:21:26.14,JP2,,0000,0000,0000,,Мен түсінбеймін. Түсінесіз бе?
Dialogue: 0,0:21:26.68,0:21:30.51,JP2,,0000,0000,0000,,Иә, енді бір-бірімізді ақырын түсінейік.
Dialogue: 0,0:21:39.78,0:21:43.36,JP2,,0000,0000,0000,,Йосейиннің император тағынан төмендеуі туралы
Dialogue: 0,0:21:43.66,0:21:46.97,JP2,,0000,0000,0000,,«Үшінші ұрпақтың жылнамасы» деп аталатын құжатта егжей-тегжейлі сипатталған.
Dialogue: 0,0:21:47.39,0:21:52.61,JP2,,0000,0000,0000,,Осыны негізге ала отырып, көптеген тарихи кітаптар Йосеинді тиран ретінде жазады.
Dialogue: 0,0:21:54.86,0:21:57.94,JP2,,0000,0000,0000,,Екінші жағынан, ол орындаған «Цукуба-мин жоқ» әні болды
Dialogue: 0,0:21:58.46,0:22:03.39,JP2,,0000,0000,0000,,Ол маған өзінің ғашығына деген сезімін жасырмай айтып береді.
Dialogue: 0,0:22:05.89,0:22:07.51,JP2,,0000,0000,0000,,Тиран Йосейин
Dialogue: 0,0:22:08.31,0:22:09.60,JP2,,0000,0000,0000,,Ақын Йосейин
Dialogue: 0,0:22:10.72,0:22:13.15,JP2,,0000,0000,0000,,Нағыз Йосейин қайсысы?
Dialogue: 0,0:22:13.75,0:22:16.17,JP2,,0000,0000,0000,,Өкінішке орай, мен шындықты білмеймін, бірақ
Dialogue: 0,0:22:16.77,0:22:20.27,JP2,,0000,0000,0000,,Рейкоға өзінің шынайы сезімін жеткізуге тырыспаса
Dialogue: 0,0:22:20.71,0:22:22.72,JP2,,0000,0000,0000,,Біз ештеңе білмедік
Dialogue: 0,0:22:23.75,0:22:26.51,JP2,,0000,0000,0000,,Жалғыз махаббат жыры қалды
Dialogue: 0,0:22:26.93,0:22:29.03,JP2,,0000,0000,0000,,Уақыт бойынша берілетін хабарлама
Dialogue: 0,0:22:29.72,0:22:32.97,JP2,,0000,0000,0000,,Мүмкін сіздің сүйіктіңізге жіберген электрондық пошта
Dialogue: 0,0:22:33.30,0:22:35.68,JP2,,0000,0000,0000,,Ол болашақта алыс адамдарға жетуі мүмкін
Dialogue: 0,0:22:36.57,0:22:38.24,JP2,,0000,0000,0000,,Сіз айналдырған махаббат жыры
Dialogue: 0,0:22:38.59,0:22:40.68,JP2,,0000,0000,0000,,Ол қандай хабар береді деп ойлаймын.
Dialogue: 0,0:24:17.17,0:24:22.89,JP2,,0000,0000,0000,,Аспан желі бұлттардың жолын соғады
Dialogue: 0,0:24:24.29,0:24:28.25,JP2,,0000,0000,0000,,Бикештің бір сәтке көрінуі
Dialogue: 0,0:00:04.83,0:00:07.55,CN,,0000,0000,0000,,Жердің шебері Фудзивара Садаие
Dialogue: 0,0:00:08.22,0:00:09.73,CN,,0000,0000,0000,,Бұл атақты тау
Dialogue: 0,0:00:09.77,0:00:12.20,CN,,0000,0000,0000,,Бұл менің таудағы ауылда тұратын жер.
Dialogue: 0,0:00:12.49,0:00:13.79,CN,,0000,0000,0000,,Тейка
Dialogue: 0,0:00:15.18,0:00:16.94,CN,,0000,0000,0000,,Менің астымда бөлек
Dialogue: 0,0:00:17.63,0:00:19.34,CN,,0000,0000,0000,,Басқа айқайлар
Dialogue: 0,0:00:19.88,0:00:22.71,CN,,0000,0000,0000,,Бұл менің туысым, мен тұратын тау ауылы.
Dialogue: 0,0:00:23.66,0:00:28.07,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:28.38,0:00:28.61,CN,,0000,0000,0000,,Буггарати те ақшаға қатты мұқтаж болар
Dialogue: 0,0:00:31.37,0:00:34.94,CN,,0000,0000,0000,,Мен оны көру үшін келдім.
Dialogue: 0,0:00:35.54,0:00:37.35,CN,,0000,0000,0000,,Бір адамға жүз өлең.
Dialogue: 0,0:00:38.14,0:00:39.39,CN,,0000,0000,0000,,Мен ұсынған құрылыс
Dialogue: 0,0:00:39.92,0:00:42.36,CN,,0000,0000,0000,,Шешім қабылданғаннан кейін
Dialogue: 0,0:00:42.77,0:00:46.16,CN,,0000,0000,0000,,Жаңа туындының дүниеге келгені рас.
Dialogue: 0,0:00:47.53,0:00:52.27,CN,,0000,0000,0000,,Алдын ала құрастырылған «Жапон поэзиясының жаңа императорлық таңдауының» стиліндегі айырмашылық.
Dialogue: 0,0:00:52.76,0:00:54.27,CN,,0000,0000,0000,,Мен оған қарамаймын.
Dialogue: 0,0:00:56.01,0:00:57.78,CN,,0000,0000,0000,,Сондай-ақ, бұл менің орным емес.
Dialogue: 0,0:00:58.51,0:01:02.56,CN,,0000,0000,0000,,Миякокай жоғарғы беті адам саусақ қолын кескіндеме аяғы
Dialogue: 0,0:01:03.48,0:01:04.32,CN,,0000,0000,0000,,Бастықты құлатып, осылайша оның зор... есірткі табысын өз пайдасына иелену үшін..........
Dialogue: 0,0:01:04.78,0:01:08.48,CN,,0000,0000,0000,,Сондықтан жеке қасиеттер туралы эсселерді жинауға болады, келіңіздер.
Dialogue: 0,0:01:10.72,0:01:11.78,CN,,0000,0000,0000,,Алым хат
Dialogue: 0,0:01:14.79,0:01:15.40,CN,,0000,0000,0000,,Отбасындағы ең бақытты адам
Dialogue: 0,0:02:57.48,0:02:59.10,CN,,0000,0000,0000,,Екінші Эго интервенция 2 бөлім Фудзивара Садаи
Dialogue: 0,0:02:59.69,0:03:03.48,CN,,0000,0000,0000,,Жарылыс Исшу Хякунин Исшу ақын
Dialogue: 0,0:03:03.66,0:03:05.18,CN,,0000,0000,0000,,Сіздің есіңізде кім қалды?
Dialogue: 0,0:03:06.20,0:03:09.02,CN,,0000,0000,0000,,Рюфудің әйгілі жапон өлеңдер жинағы.
Dialogue: 0,0:03:09.21,0:03:11.01,CN,,0000,0000,0000,,Білікті, білімді, дана офицер.
Dialogue: 0,0:03:11.53,0:03:14.35,CN,,0000,0000,0000,,Әр түрлі ақындардың 100 өлеңі
Dialogue: 0,0:03:15.32,0:03:17.47,CN,,0000,0000,0000,,1 бөлім
Dialogue: 0,0:03:18.01,0:03:22.37,CN,,0000,0000,0000,,Басқаша айтқанда, жинақта кездесетін баланың аты әйгілі.
Dialogue: 0,0:03:22.93,0:03:26.67,CN,,0000,0000,0000,,Басқа вака өлеңдері.
Dialogue: 0,0:03:27.56,0:03:28.67,CN,,0000,0000,0000,,Бұл менің таңдауым.
Dialogue: 0,0:03:30.74,0:03:33.18,CN,,0000,0000,0000,,2015 жылы Чэнду императорының беделі
Dialogue: 0,0:03:33.48,0:03:37.32,CN,,0000,0000,0000,,17 жаста тақтан ерте бас тарту
Dialogue: 0,0:03:37.76,0:03:39.74,CN,,0000,0000,0000,,Биліктің басқа кезеңдері
Dialogue: 0,0:03:40.08,0:03:43.48,CN,,0000,0000,0000,,Қызметшінің қызметі — қызметшінің, қызметшінің және Такаконың жеке қызметшісінің қызметі.
Dialogue: 0,0:03:44.89,0:03:49.21,CN,,0000,0000,0000,,Алайда, ысырапшыл адам үшін бұл ұстаным жеткіліксіз.
Dialogue: 0,0:03:51.46,0:03:53.55,CN,,0000,0000,0000,,1. Императорлық мәртебелі отставкадағы император
Dialogue: 0,0:03:56.89,0:03:57.19,CN,,0000,0000,0000,,Ашу
Dialogue: 0,0:03:59.52,0:04:00.26,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:04:00.84,0:04:01.51,CN,,0000,0000,0000,,Миссис
Dialogue: 0,0:04:01.68,0:04:02.67,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:04.10,0:04:06.10,CN,,0000,0000,0000,,Сізге қалай ұнайды?
Dialogue: 0,0:04:07.13,0:04:09.54,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:16.04,0:04:17.78,CN,,0000,0000,0000,,Таңқаларлық ересек адам
Dialogue: 0,0:04:18.52,0:04:20.24,CN,,0000,0000,0000,,Өзіңізге қамқорлық жасаңыз
Dialogue: 0,0:04:22.19,0:04:24.51,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:25.99,0:04:28.75,CN,,0000,0000,0000,,Бұл әңгіменің бірінші бөлімі.
Dialogue: 0,0:04:29.92,0:04:31.81,CN,,0000,0000,0000,,Алғашқы өзара кездесу де осылай болады.
Dialogue: 0,0:04:32.79,0:04:36.83,&,,0000,0000,0000,,...
Dialogue: 0,0:04:32.79,0:04:36.83,,,0000,0000,0000,,Йосеи-ин
Dialogue: 0,0:04:40.93,0:04:41.71,CN,,0000,0000,0000,,Тоқта
Dialogue: 0,0:04:52.48,0:04:54.53,CN,,0000,0000,0000,,Ішкі ханзада не болып жатыр?
Dialogue: 0,0:04:55.19,0:04:56.37,CN,,0000,0000,0000,,Ересек генерал-лейтенант
Dialogue: 0,0:04:57.02,0:04:58.24,CN,,0000,0000,0000,,Төлемсіз
Dialogue: 0,0:05:06.10,0:05:07.29,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:08.51,0:05:09.47,CN,,0000,0000,0000,,Достық аяқталды
Dialogue: 0,0:05:11.50,0:05:12.68,CN,,0000,0000,0000,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:05:25.61,0:05:30.59,CN,,0000,0000,0000,,Мәртебелі нөкерлері біраз бақылауға алынды. Қасиетті жерде тұрудың қажеті жоқ.
Dialogue: 0,0:05:31.03,0:05:31.40,CN,,0000,0000,0000,,Бірақ енді мен не істей аламын?
Dialogue: 0,0:05:31.96,0:05:32.14,CN,,0000,0000,0000,,Қамшы?
Dialogue: 0,0:05:32.79,0:05:34.49,CN,,0000,0000,0000,,Басқа адамның күлкілі суреті
Dialogue: 0,0:05:35.10,0:05:37.47,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:38.62,0:05:43.50,CN,,0000,0000,0000,,Мәртебелі император әпкесі қасиетті орынға бару кезінде
Dialogue: 0,0:05:45.93,0:05:47.81,CN,,0000,0000,0000,,Бұл сен жақсы көретін бала
Dialogue: 0,0:05:48.12,0:05:49.74,CN,,0000,0000,0000,,…
Dialogue: 0,0:05:50.15,0:05:51.31,CN,,0000,0000,0000,,Сегіз құбыжық
Dialogue: 0,0:05:52.86,0:05:54.25,CN,,0000,0000,0000,,Зайнадан кейін
Dialogue: 0,0:05:55.33,0:05:56.20,CN,,0000,0000,0000,,Шынайы кімдігі: барлаушы
Dialogue: 0,0:05:57.97,0:06:01.29,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:04.67,0:06:05.39,CN,,0000,0000,0000,,Ешқандай талант қажет емес
Dialogue: 0,0:06:14.16,0:06:16.26,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:17.53,0:06:18.30,CN,,0000,0000,0000,,Жүгіру
Dialogue: 0,0:06:26.41,0:06:27.00,CN,,0000,0000,0000,,Мәртебелі…
Dialogue: 0,0:06:35.89,0:06:38.74,CN,,0000,0000,0000,,Бұл менің өлімім болды
Dialogue: 0,0:06:38.82,0:06:40.13,CN,,0000,0000,0000,,Синсо Сейджу
Dialogue: 0,0:06:40.98,0:06:43.67,CN,,0000,0000,0000,,Мәртебелі Нана жапон поэзиясын оқуға келеді
Dialogue: 0,0:06:44.44,0:06:46.63,CN,,0000,0000,0000,,Бұл жапон поэзиясы.
Dialogue: 0,0:06:46.85,0:06:49.46,CN,,0000,0000,0000,,Менің айтатыным - қажетті түзету
Dialogue: 0,0:06:50.33,0:06:51.92,CN,,0000,0000,0000,,Мәртебелі Вака...
Dialogue: 0,0:06:51.92,0:06:55.34,CN,,0000,0000,0000,,Жапон өлеңі
Dialogue: 0,0:06:55.75,0:06:59.03,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:59.41,0:07:00.95,CN,,0000,0000,0000,,және т.б. Көрікті жерлерге саяхат…
Dialogue: 0,0:07:01.17,0:07:03.08,CN,,0000,0000,0000,,Саяхатта естіген әңгімем.
Dialogue: 0,0:07:05.60,0:07:08.08,CN,,0000,0000,0000,,Дүние жүзінің шығыс бөлігіндегі әңгімелер
Dialogue: 0,0:07:10.11,0:07:12.06,CN,,0000,0000,0000,,Сол кезде қарсылықтың қолайлығы Цукуба тауы.
Dialogue: 0,0:07:12.65,0:07:17.69,CN,,0000,0000,0000,,Бұл таудың екі шыңы бар, батыс жағында Нантай тауы, шығыс жағында Ньотай тауы.
Dialogue: 0,0:07:17.98,0:07:21.18,CN,,0000,0000,0000,,Суретті көрген жақсы.
Dialogue: 0,0:07:21.35,0:07:24.36,CN,,0000,0000,0000,,Жоқ... Сырты тау шыңындай.
Dialogue: 0,0:07:24.85,0:07:26.29,CN,,0000,0000,0000,,Ысырапшылдық сезімі
Dialogue: 0,0:07:26.63,0:07:28.32,CN,,0000,0000,0000,,Қызық емес
Dialogue: 0,0:07:28.93,0:07:31.90,CN,,0000,0000,0000,,Қазіргі уақытта тауда, тарихы бар фестиваль
Dialogue: 0,0:07:32.35,0:07:33.09,CN,,0000,0000,0000,,Фестиваль?
Dialogue: 0,0:07:34.29,0:07:37.14,CN,,0000,0000,0000,,Шедевр Вака фестивалі
Dialogue: 0,0:07:37.47,0:07:39.92,CN,,0000,0000,0000,,Гинка Кибу Фудзюцу Бин
Dialogue: 0,0:07:41.59,0:07:45.24,CN,,0000,0000,0000,,Юина Ичитен Ямагами Юшиндайя
Dialogue: 0,0:07:45.46,0:07:47.87,CN,,0000,0000,0000,,Азат жер мен махаббат туралы барлық естеліктер
Dialogue: 0,0:07:50.37,0:07:53.63,CN,,0000,0000,0000,,Таудан жоғары ағыстағы аталық және аналық өзендер.
Dialogue: 0,0:07:54.02,0:07:56.21,CN,,0000,0000,0000,,Өзеннің басқа ағынының соңғы қорытындысы
Dialogue: 0,0:07:56.61,0:07:58.71,CN,,0000,0000,0000,,Ағынды өзендерден тұратын мұхит
Dialogue: 0,0:07:59.34,0:08:02.37,CN,,0000,0000,0000,,Сол жерде Цукуба таудың таяз сезімі
Dialogue: 0,0:08:02.88,0:08:05.19,CN,,0000,0000,0000,,Жалпы қарқынды махаббаттың соңғы кезеңі
Dialogue: 0,0:08:07.22,0:08:10.64,CN,,0000,0000,0000,,Махаббатың біткен кезде
Dialogue: 0,0:08:10.75,0:08:12.22,CN,,0000,0000,0000,,Жоғалуға бір нүктелік ниет
Dialogue: 0,0:08:13.86,0:08:15.61,CN,,0000,0000,0000,,Мәртебелі қабілеті анық
Dialogue: 0,0:08:15.91,0:08:18.37,CN,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:37.01,0:08:37.73,CN,,0000,0000,0000,,Бастықты құлатып, осылайша оның зор есірткі табысын өз пайдасына иелену үшін
Dialogue: 0,0:08:38.43,0:08:40.99,CN,,0000,0000,0000,,Шынайы арман
Dialogue: 0,0:08:41.43,0:08:43.07,CN,,0000,0000,0000,,Менің ұйқым кетті.
Dialogue: 0,0:08:45.61,0:08:46.22,CN,,0000,0000,0000,,Нагату – бұл…
Dialogue: 0,0:08:48.51,0:08:48.85,CN,,0000,0000,0000,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,0:08:51.65,0:08:53.05,CN,,0000,0000,0000,,Қайырлы кеш қайырлы үлкендер
Dialogue: 0,0:08:53.57,0:08:55.55,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:56.45,0:08:58.77,CN,,0000,0000,0000,,Мен Сіздің Король Мәртебелімін.
Dialogue: 0,0:08:59.46,0:09:02.31,CN,,0000,0000,0000,,Аспан түстес күн сәулесі, Мәртебелі поштасы осында.
Dialogue: 0,0:09:03.75,0:09:06.19,CN,,0000,0000,0000,,Сіз шынымен де корольдік отбасының самурайы және ханшайымысыз.
Dialogue: 0,0:09:08.51,0:09:08.97,CN,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:09:09.75,0:09:12.36,CN,,0000,0000,0000,,Түнде осы жерде бір адам отырады.
Dialogue: 0,0:09:12.71,0:09:14.92,CN,,0000,0000,0000,,Құбыжық сізді кездестіргенде
Dialogue: 0,0:09:17.66,0:09:21.49,CN,,0000,0000,0000,,Кітаптың кітабы ақиқат.
Dialogue: 0,0:09:22.35,0:09:25.73,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:26.18,0:09:27.83,CN,,0000,0000,0000,,Мейтен ерте
Dialogue: 0,0:09:28.62,0:09:28.99,CN,,0000,0000,0000,,Иә...
Dialogue: 0,0:09:29.62,0:09:31.17,CN,,0000,0000,0000,,Біраз уақыттан кейін
Dialogue: 0,0:09:33.28,0:09:36.08,CN,,0000,0000,0000,,Түннің көп бөлігі
Dialogue: 0,0:09:39.01,0:09:42.81,CN,,0000,0000,0000,,Бақаның дауысы адамның жүрегіне ұқсайды.
Dialogue: 0,0:09:46.40,0:09:47.83,CN,,0000,0000,0000,,Мен жақсы өлдім.
Dialogue: 0,0:09:48.61,0:09:49.56,CN,,0000,0000,0000,,Ұсақ-түйек
Dialogue: 0,0:09:50.87,0:09:53.68,CN,,0000,0000,0000,,Дегенмен бастапқы ақпаратты оқып шығыңыз.
Dialogue: 0,0:09:55.86,0:09:58.18,CN,,0000,0000,0000,,Көк бақаның өмірі қысқа және қысқа
Dialogue: 0,0:09:58.88,0:10:01.13,CN,,0000,0000,0000,,Үлкен күшпен ән айту
Dialogue: 0,0:10:02.30,0:10:05.01,CN,,0000,0000,0000,,Жазғы аспан келді, Цикада әртүрлілікті тамашалайды.
Dialogue: 0,0:10:06.35,0:10:10.32,CN,,0000,0000,0000,,Бір ой шағын өмірге жетелейді;
Dialogue: 0,0:10:12.19,0:10:15.28,CN,,0000,0000,0000,,Осы ақымақ өзімдегідей;
Dialogue: 0,0:10:24.03,0:10:26.06,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:31.46,0:10:33.01,CN,,0000,0000,0000,,Көк бақалардан қалай құтылуға болады?
Dialogue: 0,0:10:33.22,0:10:34.17,CN,,0000,0000,0000,,Жоғалу
Dialogue: 0,0:10:36.71,0:10:40.04,CN,,0000,0000,0000,,Бұл компания...
Dialogue: 0,0:10:40.56,0:10:40.83,CN,,0000,0000,0000,,Жылан?
Dialogue: 0,0:10:41.22,0:10:43.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:44.18,0:10:45.93,CN,,0000,0000,0000,,Қолыңызбен тамақ ішпеңіз
Dialogue: 0,0:10:46.40,0:10:47.84,CN,,0000,0000,0000,,Бір жұтып ал да, кет
Dialogue: 0,0:10:48.16,0:10:48.74,CN,,0000,0000,0000,,Тістеп ал!
Dialogue: 0,0:10:49.51,0:10:53.76,CN,,0000,0000,0000,,Күн батқаннан кейін жылан тәрізді дене әлемге қосылып, әлем күлкіге толы.
Dialogue: 0,0:10:54.53,0:10:56.59,CN,,0000,0000,0000,,Бұл түпнұсқаның шығу тегі.
Dialogue: 0,0:10:57.36,0:10:58.58,CN,,0000,0000,0000,,Генерал-лейтенант
Dialogue: 0,0:10:59.68,0:11:01.40,CN,,0000,0000,0000,,Мәртебелі дүниеден өтті
Dialogue: 0,0:11:06.19,0:11:06.59,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:11:06.69,0:11:07.09,CN,,0000,0000,0000,,Кейде оны ес-түссіз етіп ұрып, полиция тоқтатса да…
Dialogue: 0,0:11:07.49,0:11:09.77,CN,,0000,0000,0000,,Бар… бар… жылан бар!!!
Dialogue: 0,0:11:09.77,0:11:11.25,CN,,0000,0000,0000,,Міне.
Dialogue: 0,0:11:11.35,0:11:12.82,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:13.48,0:11:15.78,CN,,0000,0000,0000,,Келуші
Dialogue: 0,0:11:15.78,0:11:16.98,CN,,0000,0000,0000,,Талаптар
Dialogue: 0,0:11:17.41,0:11:19.15,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:20.71,0:11:22.33,CN,,0000,0000,0000,,Міндетті емес Міндетті емес
Dialogue: 0,0:11:23.62,0:11:25.29,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:25.53,0:11:27.32,CN,,0000,0000,0000,,Ләззаттан құтқару
Dialogue: 0,0:11:28.08,0:11:32.21,CN,,0000,0000,0000,,Досыңыздың мінез-құлқын жақсырақ жасауға тырысыңыз.
Dialogue: 0,0:11:32.89,0:11:34.81,CN,,0000,0000,0000,,Елордада тұрып ән айтып, жылай алмайсың
Dialogue: 0,0:11:35.03,0:11:36.95,CN,,0000,0000,0000,,Кел, өз өміріңді сақта.
Dialogue: 0,0:11:37.34,0:11:39.30,CN,,0000,0000,0000,,Жылама, бірақ ақымақтықтан аулақ болуға тырыс.
Dialogue: 0,0:11:39.55,0:11:42.67,CN,,0000,0000,0000,,Бар даналық пен өзіндік интеллект
Dialogue: 0,0:11:43.33,0:11:46.11,CN,,0000,0000,0000,,Мәртебелі, осы жерден тоқтаңыз.
Dialogue: 0,0:11:47.00,0:11:49.89,CN,,0000,0000,0000,,Өмірімнің қуанышы...
Dialogue: 0,0:11:49.91,0:11:55.65,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:57.30,0:11:58.84,CN,,0000,0000,0000,,Менің не айтып тұрғанымды қараңыз
Dialogue: 0,0:12:00.24,0:12:03.99,CN,,0000,0000,0000,,Мен де ең жақсымын.
Dialogue: 0,0:12:05.13,0:12:08.33,CN,,0000,0000,0000,,Өмір сынағы Ушихачи Кай Ушихачи Кай Ушихачи Кай Өте жақсы Ушихачи Кай
Dialogue: 0,0:12:12.47,0:12:17.21,CN,,0000,0000,0000,,Пьесаның түпнұсқасы бастапқыда жарияланбаған.
Dialogue: 0,0:12:17.48,0:12:19.54,CN,,0000,0000,0000,,Мен ойланып, өз ойымды реттеп отырмын.
Dialogue: 0,0:12:20.20,0:12:22.81,CN,,0000,0000,0000,,Бақтағы адамдар да қатты қиналады.
Dialogue: 0,0:12:23.37,0:12:24.21,CN,,0000,0000,0000,,Не істеу керек
Dialogue: 0,0:12:25.00,0:12:28.23,CN,,0000,0000,0000,,Заңсыз мүліктің иесі менің меншігімде.
Dialogue: 0,0:12:30.22,0:12:32.36,CN,,0000,0000,0000,,Тұрғынсыз қоғам туралы ойлар
Dialogue: 0,0:12:32.51,0:12:35.82,CN,,0000,0000,0000,,Тағы бір мәселе, мен оны көре аламын.
Dialogue: 0,0:12:36.47,0:12:38.37,CN,,0000,0000,0000,,Император кім?
Dialogue: 0,0:12:38.95,0:12:42.21,CN,,0000,0000,0000,,Кішкентай үлкеннің кінәсі, үкімет билікті басқарады.
Dialogue: 0,0:12:43.34,0:12:45.17,CN,,0000,0000,0000,,Нагаяның қызықты тұстары
Dialogue: 0,0:12:46.10,0:12:49.44,CN,,0000,0000,0000,,Мен баламның үйін аша аламын.
Dialogue: 0,0:12:50.22,0:12:52.55,CN,,0000,0000,0000,,Генерал-лейтенант
Dialogue: 0,0:12:52.96,0:12:54.18,CN,,0000,0000,0000,,Орындау туралы қасақана шешім
Dialogue: 0,0:12:55.10,0:12:57.68,CN,,0000,0000,0000,,Нагатодан кейінгі саяхатты көру
Dialogue: 0,0:12:58.20,0:12:59.59,CN,,0000,0000,0000,,Реформаланған вака туралы не айтасыз?
Dialogue: 0,0:13:01.56,0:13:06.29,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:06.92,0:13:07.85,CN,,0000,0000,0000,,Мәртебелі
Dialogue: 0,0:13:08.45,0:13:11.88,CN,,0000,0000,0000,,Мектеп бағытынан бөлек өлең.
Dialogue: 0,0:13:12.28,0:13:14.04,CN,,0000,0000,0000,,Мен жеткілікті ақылды емеспін.
Dialogue: 0,0:13:14.24,0:13:14.92,CN,,0000,0000,0000,,Вака Мукай қайтыс болды
Dialogue: 0,0:13:15.78,0:13:17.24,CN,,0000,0000,0000,,Мәртебелі сапар
Dialogue: 0,0:13:18.11,0:13:20.57,CN,,0000,0000,0000,,Уағыздар және заңсыз самурай қызметі
Dialogue: 0,0:13:22.14,0:13:23.39,CN,,0000,0000,0000,,генерал-лейтенант
Dialogue: 0,0:13:23.87,0:13:29.08,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:29.20,0:13:30.66,CN,,0000,0000,0000,,Мен не айтарымды білмеймін
Dialogue: 0,0:13:31.35,0:13:36.37,CN,,0000,0000,0000,,Дегенмен, ересек болу мүмкін емес...
Dialogue: 0,0:13:37.15,0:13:40.91,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:42.22,0:13:43.79,CN,,0000,0000,0000,,Келіңіз
Dialogue: 0,0:13:48.27,0:13:49.36,CN,,0000,0000,0000,,Вака Батыс Еуропаға қарағанда жақсырақ
Dialogue: 0,0:13:50.46,0:13:53.90,CN,,0000,0000,0000,,Бар немесе болмауы мүмкін өзін-өзі сезіну
Dialogue: 0,0:13:55.38,0:13:57.41,CN,,0000,0000,0000,,Себеп және кері жол
Dialogue: 0,0:13:58.08,0:13:58.66,CN,,0000,0000,0000,,Артқы бағыт?
Dialogue: 0,0:13:59.08,0:13:59.32,CN,,0000,0000,0000,,Дұрыс және бұрыс
Dialogue: 0,0:14:00.86,0:14:05.47,CN,,0000,0000,0000,,Тура сөйлейтін әйелге арналған сөз тіркесі.
Dialogue: 0,0:13:59.65,0:14:05.78,,,0000,0000,0000,,Ескерту: Je t'aime: Құқықтық тіл, мен сіздің ниетіңізді жақсы көремін.
Dialogue: 0,0:14:06.31,0:14:09.20,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:09.30,0:14:10.93,CN,,0000,0000,0000,,Шыны жүректің дәл астында
Dialogue: 0,0:14:11.57,0:14:13.21,CN,,0000,0000,0000,,Дегенмен бұл жапон поэмасы.
Dialogue: 0,0:14:13.58,0:14:16.12,CN,,0000,0000,0000,,Әннің аудармасын оқуға болады.
Dialogue: 0,0:14:16.65,0:14:18.66,CN,,0000,0000,0000,,Бұл өлім.
Dialogue: 0,0:14:19.04,0:14:21.58,CN,,0000,0000,0000,,Фотоға ұқсас әңгіме
Dialogue: 0,0:14:22.09,0:14:22.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:23.42,0:14:24.71,CN,,0000,0000,0000,,Сұлулық туралы ойлау
Dialogue: 0,0:14:25.89,0:14:27.62,CN,,0000,0000,0000,,Вака естімей ақиқат
Dialogue: 0,0:14:27.98,0:14:28.83,CN,,0000,0000,0000,,Бай Ванрио
Dialogue: 0,0:14:29.53,0:14:31.13,CN,,0000,0000,0000,,Бұл таланттың жоқтығынан.
Dialogue: 0,0:14:32.79,0:14:37.70,CN,,0000,0000,0000,,Дарындылықты негізсіз көрсету және эмоцияны көрсету
Dialogue: 0,0:14:38.78,0:14:41.56,CN,,0000,0000,0000,,Адамды байлау кезінде босатуға болатын уақыт қашан?
Dialogue: 0,0:14:41.81,0:14:43.95,CN,,0000,0000,0000,,Сөз бостандығы
Dialogue: 0,0:14:45.30,0:14:47.68,CN,,0000,0000,0000,,Ең қолайлы баламалы әңгіме туралы не айтасыз?
Dialogue: 0,0:14:48.37,0:14:50.35,CN,,0000,0000,0000,,Мен жеткілікті ақылды емеспін.
Dialogue: 0,0:14:53.19,0:14:55.10,CN,,0000,0000,0000,,Алайда арада бір жыл өтті.
Dialogue: 0,0:14:55.81,0:14:58.51,CN,,0000,0000,0000,,Бұл дүниеден бизнес босату
Dialogue: 0,0:15:05.35,0:15:08.32,CN,,0000,0000,0000,,анасының анасы анасының әкесі
Dialogue: 0,0:15:10.50,0:15:11.43,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:12.83,0:15:15.91,CN,,0000,0000,0000,,Өлім – өткенді кенеттен еске түсіру ғана.
Dialogue: 0,0:15:17.58,0:15:21.97,CN,,0000,0000,0000,,Бұл қандай трагедия?
Dialogue: 0,0:15:23.22,0:15:27.87,CN,,0000,0000,0000,,Генерал-лейтенант және басқалар... Оккупацияның аяқталуы...
Dialogue: 0,0:15:31.42,0:15:34.85,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:36.58,0:15:39.69,CN,,0000,0000,0000,,Бұл басқаша...
Dialogue: 0,0:15:41.73,0:15:46.40,CN,,0000,0000,0000,,Шыншылдық – ойым, Ішкі дүниемді дүниелік адам ретінде көремін.
Dialogue: 0,0:15:47.06,0:15:50.50,CN,,0000,0000,0000,,Анасының анасынан шеттету
Dialogue: 0,0:15:51.53,0:15:54.90,CN,,0000,0000,0000,,Вава Шуэннің барлық Эцурай Эцу ісі кірмейді
Dialogue: 0,0:15:57.61,0:15:59.24,CN,,0000,0000,0000,,Мәртебелі
Dialogue: 0,0:15:59.64,0:16:01.10,CN,,0000,0000,0000,,Жабық тұмсық
Dialogue: 0,0:16:02.00,0:16:07.12,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:08.73,0:16:11.59,CN,,0000,0000,0000,,17 жасымда мен тақтан бас тартуға мәжбүр болдым.
Dialogue: 0,0:16:12.31,0:16:14.20,CN,,0000,0000,0000,,Император Сейю
Dialogue: 0,0:16:15.36,0:16:20.82,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:21.85,0:16:23.83,CN,,0000,0000,0000,,Жапония мен Эвакуация министрлігі арасындағы қақтығыс Лицензия
Dialogue: 0,0:16:24.42,0:16:27.88,CN,,0000,0000,0000,,Басқа офицерлердің жеңгесі
Dialogue: 0,0:16:29.28,0:16:33.02,CN,,0000,0000,0000,,Өзін-өзі ойлайтын сіңлісі.
Dialogue: 0,0:16:34.36,0:16:37.45,CN,,0000,0000,0000,,иілгіш мата
Dialogue: 0,0:16:38.01,0:16:40.37,CN,,0000,0000,0000,,Енбегi жоқ, ерiксiз, өзiн-өзi таң қалдырған адам
Dialogue: 0,0:16:42.11,0:16:43.76,CN,,0000,0000,0000,,Шындық – трагедиялық әйел.
Dialogue: 0,0:16:44.06,0:16:47.18,CN,,0000,0000,0000,,Қысымға ұшыраған адамның қазіргі көңіл-күйі қандай?
Dialogue: 0,0:16:47.65,0:16:48.91,CN,,0000,0000,0000,,Көк бақа әйел
Dialogue: 0,0:16:52.37,0:16:54.01,CN,,0000,0000,0000,,Ақпаратты жазу
Dialogue: 0,0:16:55.90,0:16:58.07,CN,,0000,0000,0000,,Менің күш-жігеріме көңілім толмайды.
Dialogue: 0,0:16:59.18,0:17:01.40,CN,,0000,0000,0000,,Алды-артқа жүру
Dialogue: 0,0:17:03.52,0:17:06.03,CN,,0000,0000,0000,,Бұл жай ғана әңгіме.
Dialogue: 0,0:17:10.66,0:17:13.67,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:15.61,0:17:17.46,CN,,0000,0000,0000,,Сізді қазір көргеніме қуаныштымын.
Dialogue: 0,0:17:18.28,0:17:21.92,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:22.21,0:17:23.00,CN,,0000,0000,0000,,Мен ұйықтап қалдым
Dialogue: 0,0:17:23.59,0:17:24.75,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:25.43,0:17:28.68,CN,,0000,0000,0000,,Менің кездесуге дайындық
Dialogue: 0,0:17:32.32,0:17:34.74,CN,,0000,0000,0000,,Сіздің махаббат хикаяңыз
Dialogue: 0,0:17:36.55,0:17:37.89,CN,,0000,0000,0000,,Сұрақтарыңыз болса, бізге хабарласыңыз.
Dialogue: 0,0:17:38.80,0:17:41.50,CN,,0000,0000,0000,,Қараңдаршы, қызық екен.
Dialogue: 0,0:17:42.02,0:17:44.30,CN,,0000,0000,0000,,Мен сіздермен өз ойымды бөлісуім керек.
Dialogue: 0,0:17:46.16,0:17:47.30,CN,,0000,0000,0000,,Сіздің ниетіңіз қандай?
Dialogue: 0,0:17:47.85,0:17:49.42,CN,,0000,0000,0000,,Мен сіздің сезімдеріңізге жауаптымын.
Dialogue: 0,0:17:50.55,0:17:55.04,CN,,0000,0000,0000,,Мен қатыгез адаммын.
Dialogue: 0,0:17:55.97,0:17:58.46,CN,,0000,0000,0000,,Өлсем сенімен кездесуге тілегім жетпейді.
Dialogue: 0,0:17:59.24,0:18:02.18,CN,,0000,0000,0000,,Шетелде жүргендер маған бәрібір.
Dialogue: 0,0:18:03.61,0:18:07.62,CN,,0000,0000,0000,,Менің түсінгеніме қарама-қайшы, ол да дұрыс емес.
Dialogue: 0,0:18:08.93,0:18:10.70,CN,,0000,0000,0000,,Әкімшілік шектеулер
Dialogue: 0,0:18:11.50,0:18:14.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:15.66,0:18:18.55,CN,,0000,0000,0000,,Мен біреуді есіме түсіргенде, шынайы өзін түсінемін
Dialogue: 0,0:18:19.38,0:18:21.31,CN,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:24.74,0:18:27.76,CN,,0000,0000,0000,,Мен арманыма адал емеспін.
Dialogue: 0,0:18:29.10,0:18:32.93,CN,,0000,0000,0000,,Сіздің болашақ өміріңіз туралы не ойлайсыз?
Dialogue: 0,0:18:33.56,0:18:35.86,CN,,0000,0000,0000,,Мен мұны істей алмаймын, өйткені мен сен үшін қуаныштымын.
Dialogue: 0,0:18:36.75,0:18:38.75,CN,,0000,0000,0000,,Сол ауруға өкініш білдіреміз.
Dialogue: 0,0:18:39.17,0:18:41.85,CN,,0000,0000,0000,,Егер мұны қаламасаңыз, мұны істеуден тартынбаңыз.
Dialogue: 0,0:18:43.58,0:18:47.63,CN,,0000,0000,0000,,Бұл басқа адамның капиталымен бірдей.
Dialogue: 0,0:18:49.60,0:18:52.30,CN,,0000,0000,0000,,Әйтсе де, алғашқы махаббат идеясына ләззат алатын да әйел.
Dialogue: 0,0:18:53.00,0:18:53.30,CN,,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:18:55.63,0:18:56.15,CN,,0000,0000,0000,,Йоен
Dialogue: 0,0:18:59.30,0:19:00.95,CN,,0000,0000,0000,,Сен маған қамқор болуың керек.
Dialogue: 0,0:19:01.49,0:19:03.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:04.11,0:19:06.67,CN,,0000,0000,0000,,Дегенмен, бұл қазірдің өзінде.
Dialogue: 0,0:19:07.10,0:19:09.12,CN,,0000,0000,0000,,Менде тек қуаныш пен қуанышқа ұмтылу қабілетім бар.
Dialogue: 0,0:19:10.34,0:19:12.18,CN,,0000,0000,0000,,Бір себепке байланысты неке, серіктеске опасыздық
Dialogue: 0,0:19:12.55,0:19:15.35,CN,,0000,0000,0000,,Бұл қашудың нақты әрекеті.
Dialogue: 0,0:19:16.93,0:19:18.99,CN,,0000,0000,0000,,Бұл бірден құтылу.
Dialogue: 0,0:19:19.83,0:19:22.52,CN,,0000,0000,0000,,Еңбек етуге ынталы адам
Dialogue: 0,0:19:24.22,0:19:25.59,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:26.04,0:19:28.41,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:28.78,0:19:29.52,CN,,0000,0000,0000,,Жүрегімді ашқым келмейді
Dialogue: 0,0:19:30.94,0:19:34.06,CN,,0000,0000,0000,,Жарақат алды деген күдік
Dialogue: 0,0:19:34.42,0:19:36.12,CN,,0000,0000,0000,,Дегенмен, процесті қайталаудың қажеті жоқ.
Dialogue: 0,0:19:36.36,0:19:36.93,CN,,0000,0000,0000,,Бөлек…
Dialogue: 0,0:19:38.16,0:19:39.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:40.71,0:19:42.74,CN,,0000,0000,0000,,Ғафуайдың сатқындығы
Dialogue: 0,0:19:44.25,0:19:47.48,CN,,0000,0000,0000,,Шарттар мен шарттар
Dialogue: 0,0:19:54.38,0:19:57.52,CN,,0000,0000,0000,,Көшедегі ұялшақтық Қайта бару қажет
Dialogue: 0,0:20:07.66,0:20:10.71,CN,,0000,0000,0000,,Эмоцияны білдіру
Dialogue: 0,0:20:11.41,0:20:14.32,CN,,0000,0000,0000,,Адамдарды құлдықта босатып алуға болатын уақыт қашан?
Dialogue: 0,0:20:14.74,0:20:16.66,CN,,0000,0000,0000,,Еркіндікке ие болу
Dialogue: 0,0:20:19.70,0:20:22.08,CN,,0000,0000,0000,,Автор жазған кітаптың көшірмесі
Dialogue: 0,0:20:24.36,0:20:34.08,&,,0000,0000,0000,,Цукуба шыңындағы су
Dialogue: 0,0:20:25.99,0:20:34.08,&,,0000,0000,0000,,...
Dialogue: 0,0:20:26.82,0:20:34.08,&,,0000,0000,0000,,Жанашыр мәліметтер
Dialogue: 0,0:20:28.66,0:20:34.08,&,,0000,0000,0000,,Махаббат
Dialogue: 0,0:20:34.16,0:20:38.42,CN,,0000,0000,0000,,Ұзақ өмірден басқа ештеңеге ұқсамайтын махаббат
Dialogue: 0,0:20:39.21,0:20:42.32,CN,,0000,0000,0000,,Қазіргі мен, сен тартатын махаббатты көр.
Dialogue: 0,0:20:44.11,0:20:44.69,CN,,0000,0000,0000,,Миссис
Dialogue: 0,0:20:47.71,0:20:49.70,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:50.19,0:20:53.21,CN,,0000,0000,0000,,Жоғары мәртебелі мырза да маған дөрекі тіл туралы айтты.
Dialogue: 0,0:20:53.60,0:20:57.60,CN,,0000,0000,0000,,Басқа жерлерді көруге рұқсат етілмейді
Dialogue: 0,0:20:58.90,0:21:00.09,CN,,0000,0000,0000,,Кейбір тосынсыйлар
Dialogue: 0,0:21:06.03,0:21:08.87,CN,,0000,0000,0000,,Оны жеуге болады.
Dialogue: 0,0:21:09.72,0:21:12.30,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:13.62,0:21:14.80,CN,,0000,0000,0000,,Мен арнадым
Dialogue: 0,0:21:15.86,0:21:18.29,CN,,0000,0000,0000,,На…Насу – бетпе-бет сөйлесу
Dialogue: 0,0:21:18.59,0:21:19.73,CN,,0000,0000,0000,,Сегіз құбыжықтың тағы бір нағыз аңы
Dialogue: 0,0:21:19.94,0:21:24.24,CN,,0000,0000,0000,,Менің сезімім анық екені маған түсінікті.
Dialogue: 0,0:21:24.24,0:21:26.14,CN,,0000,0000,0000,,Өнерлі екенің көрініп тұр, өнерлі екенің көрініп тұр.
Dialogue: 0,0:21:26.68,0:21:30.51,CN,,0000,0000,0000,,Иә, менің тәкаппар екенімді түсініңіз.
Dialogue: 0,0:21:39.78,0:21:43.36,CN,,0000,0000,0000,,Юкан Янсейин тақтан бас тартуға мәжбүр болды және тақтан бас тартуға мәжбүр болды.
Dialogue: 0,0:21:43.66,0:21:46.97,CN,,0000,0000,0000,,«Үш ұрпақ» кітабындағы мәліметтер
Dialogue: 0,0:21:47.39,0:21:52.61,CN,,0000,0000,0000,,Бұдан былай Янсей-иннің тарихындағы тиран бейнесі
Dialogue: 0,0:21:54.86,0:21:57.94,CN,,0000,0000,0000,,Екінші жағынан, Джинреннің «Цукуба кеніші» поэмасы.
Dialogue: 0,0:21:58.46,0:22:03.39,CN,,0000,0000,0000,,Жүректегі шынайы сезімдер
Dialogue: 0,0:22:05.89,0:22:07.51,CN,,0000,0000,0000,,Жеке тиранның Энсей-ин
Dialogue: 0,0:22:08.31,0:22:09.60,CN,,0000,0000,0000,,Қайын жұртының Еңсейі-ін
Dialogue: 0,0:22:10.72,0:22:13.15,CN,,0000,0000,0000,,Түпкілікті талант шынайы, т.б.
Dialogue: 0,0:22:13.75,0:22:16.17,CN,,0000,0000,0000,,Мен енді не істерімді білмеймін.
Dialogue: 0,0:22:16.77,0:22:20.27,CN,,0000,0000,0000,,Жастар мен басқалардың қалай қайтыс болғаны туралы әңгіме
Dialogue: 0,0:22:20.71,0:22:22.72,CN,,0000,0000,0000,,Әзірге мен қайда екенімді білмеймін.
Dialogue: 0,0:22:23.75,0:22:26.51,CN,,0000,0000,0000,,Қалған дүниедегі жалғыз махаббат жыры
Dialogue: 0,0:22:26.93,0:22:29.03,CN,,0000,0000,0000,,Бұл уақыт бойынша ақпараттың бір қадамы.
Dialogue: 0,0:22:29.72,0:22:32.97,CN,,0000,0000,0000,,Сіздің сүйіктіңізден хабарлама
Dialogue: 0,0:22:33.30,0:22:35.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:36.57,0:22:38.24,CN,,0000,0000,0000,,Ханымдар мен мырзалар, махаббат пен махаббат әні
Dialogue: 0,0:22:38.59,0:22:40.68,CN,,0000,0000,0000,,Мұнда сізде қандай ақпарат бар?
Dialogue: 0,0:24:14.97,0:24:29.98,&,,0000,0000,0000,,Со Йокичико
Dialogue: 0,0:24:14.97,0:24:29.98,,,0000,0000,0000,,Соджо Хеншо
Dialogue: 0,0:24:17.17,0:24:22.89,CN,,0000,0000,0000,,Биші қыз Мияя
Dialogue: 0,0:24:24.29,0:24:28.25,CN,,0000,0000,0000,,...
