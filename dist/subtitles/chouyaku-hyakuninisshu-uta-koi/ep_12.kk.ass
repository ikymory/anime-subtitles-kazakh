Dialogue: 0,0:00:01.31,0:00:02.13,JP2,,0000,0000,0000,,Блять
Dialogue: 0,0:00:02.36,0:00:04.20,JP2,,0000,0000,0000,,Супер аудармашы Йорицуна
Dialogue: 0,0:00:07.00,0:00:09.19,JP2,,0000,0000,0000,,Асшаян бөтен Иссей пайда болды.
Dialogue: 0,0:00:09.44,0:00:12.20,JP2,,0000,0000,0000,,Бұл Йорицуна жердің тыныштығын қорғайды.
Dialogue: 0,0:00:12.52,0:00:15.16,JP2,,0000,0000,0000,,Огура соққысы
Dialogue: 0,0:00:15.95,0:00:17.37,JP2,,0000,0000,0000,,Зақымдалған тікенді омар
Dialogue: 0,0:00:18.26,0:00:19.60,JP2,,0000,0000,0000,,Әділдік орнайды
Dialogue: 0,0:00:20.23,0:00:22.31,JP2,,0000,0000,0000,,Бәріне сәлем, бұл Тейка.
Dialogue: 0,0:00:22.84,0:00:24.38,JP2,,0000,0000,0000,,Бұл Йорицуна Уцуномия.
Dialogue: 0,0:00:24.85,0:00:26.61,JP2,,0000,0000,0000,,Ми префектурасындағы Исэ храмы
Dialogue: 0,0:00:26.84,0:00:32.85,JP2,,0000,0000,0000,,Осы Исе ғибадатханасында император әулетінің үйленбеген қыздарының ішінен сайланған Сайку деген ханзада болған.
Dialogue: 0,0:00:34.67,0:00:36.68,JP2,,0000,0000,0000,,Сайгу өз міндеттерін аяқтағаннан кейін де,
Dialogue: 0,0:00:36.83,0:00:41.28,JP2,,0000,0000,0000,,Не өміріңіздің соңына дейін бойдақ болыңыз немесе императордың император сарайына қосылыңыз.
Dialogue: 0,0:00:41.70,0:00:44.71,JP2,,0000,0000,0000,,Ол қол астындағыларға ешқашан үйленбеген.
Dialogue: 0,0:02:27.38,0:02:32.15,JP2,,0000,0000,0000,,Орта Канпаку атанған Мичитака атам әлі тірі болғанда.
Dialogue: 0,0:02:32.62,0:02:35.11,JP2,,0000,0000,0000,,Апай Чугу сарайына отбасы жиналды.
Dialogue: 0,0:02:36.10,0:02:39.56,JP2,,0000,0000,0000,,Атам мені тізеге отырғызып, әзілдеседі.
Dialogue: 0,0:02:40.35,0:02:42.47,JP2,,0000,0000,0000,,Құнсыз біреуді сынағанда
Dialogue: 0,0:02:42.86,0:02:45.05,JP2,,0000,0000,0000,,Атам өте бақытты көрінді.
Dialogue: 0,0:02:46.47,0:02:48.88,JP2,,0000,0000,0000,,Жалюзиден қарап тұрған әйел
Dialogue: 0,0:02:49.55,0:02:51.76,JP2,,0000,0000,0000,,Ол кісінің аты кім еді?
Dialogue: 0,0:02:52.33,0:02:56.58,JP2,,0000,0000,0000,,Иә, мен Сей Шонагонның тәтемнің сүйіктісі болғанына сенімдімін.
Dialogue: 0,0:02:57.98,0:03:00.34,JP2,,0000,0000,0000,,Көп ұзамай император Ичиджо қайтыс болды.
Dialogue: 0,0:03:00.86,0:03:04.49,JP2,,0000,0000,0000,,Бұл Томодоно Шониннің қатысуымен өткен үлкен банкет болды.
Dialogue: 0,0:03:05.48,0:03:08.69,JP2,,0000,0000,0000,,Атасы мен әжесі, әкесі және оның ағалары
Dialogue: 0,0:03:09.21,0:03:11.72,JP2,,0000,0000,0000,,Баршаның қуанған күні
Dialogue: 0,0:03:12.54,0:03:15.57,JP2,,0000,0000,0000,,Накаканпаку отбасының гүлденуі туралы естеліктер
Dialogue: 0,0:03:15.99,0:03:16.89,JP2,,0000,0000,0000,,Ум...
Dialogue: 0,0:03:19.00,0:03:21.21,JP2,,0000,0000,0000,,Мен дүкенімді тезірек жапқым келеді.
Dialogue: 0,0:03:27.90,0:03:30.09,JP2,,0000,0000,0000,,Мен мағынасыз түс көрдім
Dialogue: 0,0:03:30.39,0:03:34.21,JP2,,0000,0000,0000,,Мен ертең Сайку мырзаны түсіруім керек. Тез үйге бар.
Dialogue: 0,0:03:34.41,0:03:35.53,JP2,,0000,0000,0000,,Сен сонда
Dialogue: 0,0:03:37.17,0:03:39.63,JP2,,0000,0000,0000,,Тоқтаңыз! Өте жаман көрінеді...
Dialogue: 0,0:03:39.63,0:03:40.68,JP2,,0000,0000,0000,,Көп ұрыс болып жатқан сияқты.
Dialogue: 0,0:03:41.17,0:03:44.33,JP2,,0000,0000,0000,,Мен сені бүгін кешке күзетші етіп тағайындаймын.
Dialogue: 0,0:03:45.87,0:03:48.18,JP2,,0000,0000,0000,,Нарисанеу-сама, қайтатын кез келді.
Dialogue: 0,0:03:48.18,0:03:49.00,JP2,,0000,0000,0000,,Жоқ, генерал-лейтенант.
Dialogue: 0,0:03:49.47,0:03:52.01,JP2,,0000,0000,0000,,Сыйлықты сағынып қалсаңыз, оның қай кезде болатынын білмейсіз.
Dialogue: 0,0:03:52.33,0:03:55.64,JP2,,0000,0000,0000,,Император сарайы шын мәнінде менің ұлым, Император ханшайымы.
Dialogue: 0,0:03:55.99,0:03:56.73,JP2,,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:03:58.57,0:04:00.83,JP2,,0000,0000,0000,,Мен тез және жасырын шықтым.
Dialogue: 0,0:04:00.96,0:04:02.37,JP2,,0000,0000,0000,,Егер табылса, проблема болар еді
Dialogue: 0,0:04:02.82,0:04:05.80,JP2,,0000,0000,0000,,Күте тұрыңыз. Сайку-сама түнде қыдырып жүреді.
Dialogue: 0,0:04:05.80,0:04:10.38,JP2,,0000,0000,0000,,Саған не болды, жүзің сондай жауыз болса да, кінәлауға қорқасың ба?
Dialogue: 0,0:04:10.72,0:04:11.74,JP2,,0000,0000,0000,,Жаман адам дегеніміз не?
Dialogue: 0,0:04:12.31,0:04:13.74,JP2,,0000,0000,0000,,Сәлем, өтінемін
Dialogue: 0,0:04:14.03,0:04:16.96,JP2,,0000,0000,0000,,Мен ешқашан астанаға орала алмайтын шығармын.
Dialogue: 0,0:04:17.36,0:04:20.72,JP2,,0000,0000,0000,,Туып өскен жерімді еске алғым келеді.
Dialogue: 0,0:04:25.59,0:04:28.37,JP2,,0000,0000,0000,,Сарайдан айырылсаң, мен оны қабылдамаймын.
Dialogue: 0,0:04:29.04,0:04:32.30,JP2,,0000,0000,0000,,Егер ренжітетін болса, онда мен арқамнан отырмын.
Dialogue: 0,0:04:33.34,0:04:35.03,JP2,,0000,0000,0000,,Қараңдар, біз келдік.
Dialogue: 0,0:04:35.63,0:04:37.49,JP2,,0000,0000,0000,,Осы жерден іші мен артын анық көруге болады.
Dialogue: 0,0:04:39.50,0:04:41.87,JP2,,0000,0000,0000,,Императордың оң қолы – Сейрёден.
Dialogue: 0,0:04:42.16,0:04:46.34,JP2,,0000,0000,0000,,Ортадан солға қарай Сеоньяоден, ананың резиденциясы.
Dialogue: 0,0:04:49.22,0:04:52.43,JP2,,0000,0000,0000,,Мен Исэге түскім келмейді.
Dialogue: 0,0:04:53.50,0:04:55.21,JP2,,0000,0000,0000,,Мен Киотодан кеткім келмейді
Dialogue: 0,0:04:56.03,0:04:58.17,JP2,,0000,0000,0000,,Мен әкеммен қоштасуды жек көремін.
Dialogue: 0,0:04:58.17,0:05:00.41,JP2,,0000,0000,0000,,Бұл сізге қиын жұмыс, ханзада.
Dialogue: 0,0:05:01.33,0:05:05.97,JP2,,0000,0000,0000,,Жарайды, өйткені менің күтушім Чуджо Найши қайда барсаң да сенімен бірге жүреді.
Dialogue: 0,0:05:06.35,0:05:08.21,JP2,,0000,0000,0000,,Бұл туралы не істеуім керек?
Dialogue: 0,0:05:08.44,0:05:10.82,JP2,,0000,0000,0000,,Ал, әзірге.
Dialogue: 0,0:05:12.96,0:05:14.97,JP2,,0000,0000,0000,,Не істеу керек
Dialogue: 0,0:05:15.94,0:05:18.55,JP2,,0000,0000,0000,,Осындай кезде, менің ойымша, бірге жылау жақсы.
Dialogue: 0,0:05:18.65,0:05:22.15,JP2,,0000,0000,0000,,Тыныштық, сарайдың жүрегіндегі сыздайды түсінесің бе?
Dialogue: 0,0:05:22.60,0:05:24.49,JP2,,0000,0000,0000,,Иә, бұл да дұрыс.
Dialogue: 0,0:05:24.76,0:05:28.07,JP2,,0000,0000,0000,,Міне, келдіңіз.
Dialogue: 0,0:05:29.76,0:05:31.57,JP2,,0000,0000,0000,,Гүлдер Киото гүлдері
Dialogue: 0,0:05:31.77,0:05:34.18,JP2,,0000,0000,0000,,Қалағаныңызша алыңыз
Dialogue: 0,0:05:34.53,0:05:38.14,JP2,,0000,0000,0000,,Ал кептірілген ет, Киотодан келген ет, жолда жей бер.
Dialogue: 0,0:05:38.14,0:05:39.53,JP2,,0000,0000,0000,,Жоқ, тамақ ішіңіз.
Dialogue: 0,0:05:39.53,0:05:42.44,JP2,,0000,0000,0000,,Не қалды? Жер Киото топырағы
Dialogue: 0,0:05:46.16,0:05:47.21,JP2,,0000,0000,0000,,Рахмет
Dialogue: 0,0:05:47.21,0:05:49.79,JP2,,0000,0000,0000,,Сырт келбетіңізге қарамастан өте мейірімдісіз.
Dialogue: 0,0:05:50.61,0:05:51.53,JP2,,0000,0000,0000,,Маған ұнайды
Dialogue: 0,0:05:52.45,0:05:54.42,JP2,,0000,0000,0000,,Бұл құрмет.
Dialogue: 0,0:05:55.48,0:05:57.40,JP2,,0000,0000,0000,,Сіздің атыңыз кім?
Dialogue: 0,0:05:57.82,0:05:59.44,JP2,,0000,0000,0000,,Бұл Мичимаса Фудзивара.
Dialogue: 0,0:05:59.66,0:06:02.67,JP2,,0000,0000,0000,,Мичига Мичига, мен ұмытпаймын.
Dialogue: 0,0:06:04.61,0:06:08.68,JP2,,0000,0000,0000,,Эй, Мичига, егер мен Киотоға оралсам.
Dialogue: 0,0:06:09.23,0:06:13.16,JP2,,0000,0000,0000,,Мені қазіргідей көтеріп, осында әкелесің бе?
Dialogue: 0,0:06:14.10,0:06:19.54,JP2,,0000,0000,0000,,Иә, сарай қаласа, мен сені қуана-қуана ертіп аламын.
Dialogue: 0,0:06:21.16,0:06:23.59,JP2,,0000,0000,0000,,Мен бақыттымын. Мен сенімдімін.
Dialogue: 0,0:06:28.99,0:06:33.34,JP2,,0000,0000,0000,,Үш жылдан кейін императордың әкесі тақтан бас тартты.
Dialogue: 0,0:06:34.60,0:06:38.95,JP2,,0000,0000,0000,,Жаңа император таққа отырған кезде мен Курадоның басшысы болып тағайындалдым.
Dialogue: 0,0:06:39.58,0:06:41.32,JP2,,0000,0000,0000,,Бірнеше күннен кейін жұмыстан шығарылды
Dialogue: 0,0:06:42.56,0:06:47.60,JP2,,0000,0000,0000,,Бір кездері күшті Накагуанпаку отбасынан қазір бас тартылуда.
Dialogue: 0,0:06:48.03,0:06:48.80,JP2-,,0000,0000,0000,,Міне, келдік
Dialogue: 0,0:06:51.78,0:06:55.33,JP2,,0000,0000,0000,,Бұл сарайдың Киотоға қайтып бара жатқан шеруі болды.
Dialogue: 0,0:06:57.42,0:06:59.51,JP2,,0000,0000,0000,,Мен сарайға хат жолдадым
Dialogue: 0,0:07:00.50,0:07:02.79,JP2,,0000,0000,0000,,Мен Киотоға қайтып келгеніме қуаныштымын.
Dialogue: 0,0:07:04.11,0:07:10.25,JP2,,0000,0000,0000,,Мен жай ғана сәлем айтқым келді, бірақ жауап аламын деп ойламадым.
Dialogue: 0,0:07:19.37,0:07:21.58,JP2,,0000,0000,0000,,Біраз уақыт болды, Мичига
Dialogue: 0,0:07:22.42,0:07:23.89,JP2,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:07:24.51,0:07:25.33,JP2,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:07:26.97,0:07:29.58,JP2,,0000,0000,0000,,Мен сенімен әрқашан кездескім келген
Dialogue: 0,0:07:30.30,0:07:32.09,JP2,,0000,0000,0000,,Бұл құрмет.
Dialogue: 0,0:07:33.29,0:07:38.58,JP2,,0000,0000,0000,,Ол кезде мен сарайға ғашық боламын деп ойламаппын.
Dialogue: 0,0:07:43.38,0:07:45.74,JP2,,0000,0000,0000,,Мичига танысқаныма қуаныштымын
Dialogue: 0,0:07:46.16,0:07:49.52,JP2,,0000,0000,0000,,Бүгінгі кешке қашу туралы сөйлесейік.
Dialogue: 0,0:07:50.63,0:07:52.10,JP2,,0000,0000,0000,,Іс қараусыз қалдырылды
Dialogue: 0,0:07:52.62,0:07:55.75,JP2,,0000,0000,0000,,Сіз уәдеңізді бұзуды жоспарлап отырсыз ба? ! мен
Dialogue: 0,0:07:56.52,0:08:00.30,JP2,,0000,0000,0000,,Сіз мені шығарып саламын дедіңіз.
Dialogue: 0,0:08:00.82,0:08:03.71,JP2,,0000,0000,0000,,Мен қашып кеткім келмеді.
Dialogue: 0,0:08:05.20,0:08:08.06,JP2,,0000,0000,0000,,Мұқият ойланыңыз.
Dialogue: 0,0:08:08.80,0:08:11.96,JP2,,0000,0000,0000,,Император князі мен оның вассалының арасындағы некеге рұқсат етілмейді.
Dialogue: 0,0:08:13.75,0:08:16.58,JP2,,0000,0000,0000,,Бірақ егер сіз қашып кеткен жерде өзіңізді қоршауды шешсеңіз,
Dialogue: 0,0:08:16.90,0:08:18.84,JP2,,0000,0000,0000,,Оны айналамдағылардың бәріне мойындауым керек.
Dialogue: 0,0:08:20.38,0:08:24.39,JP2,,0000,0000,0000,,Бұл да сен үшін жаман жаңалық деп ойламаймын.
Dialogue: 0,0:08:26.32,0:08:28.04,JP2,,0000,0000,0000,,Өзім айтсам да.
Dialogue: 0,0:08:28.59,0:08:33.01,JP2,,0000,0000,0000,,Менің әкем Санджоин мені қатты жақсы көреді.
Dialogue: 0,0:08:33.63,0:08:38.06,JP2,,0000,0000,0000,,Иә, көзіңізге салсаңыз да ауыртпайтындай жақсы көрейік.
Dialogue: 0,0:08:38.55,0:08:40.22,JP2,,0000,0000,0000,,Осы мүмкіндікті пайдаланыңыз.
Dialogue: 0,0:08:41.36,0:08:44.14,JP2,,0000,0000,0000,,Әкем біздің қарым-қатынасымызды қазіргідей білсе ше?
Dialogue: 0,0:08:44.59,0:08:47.30,JP2,,0000,0000,0000,,Әкеңнің қаһарына ұшырайсың.
Dialogue: 0,0:08:47.75,0:08:49.66,JP2,,0000,0000,0000,,Тұрмысқа шыққан соң басқа әңгіме.
Dialogue: 0,0:08:51.33,0:08:54.56,JP2,,0000,0000,0000,,Сүйікті қызыңыздың күйеуінің орны лайықты болсын.
Dialogue: 0,0:08:54.83,0:08:56.27,JP2,,0000,0000,0000,,Оны әкем шешеді.
Dialogue: 0,0:08:57.54,0:08:59.18,JP2,,0000,0000,0000,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:09:00.05,0:09:00.65,JP2,,0000,0000,0000,,Мақсатқа жету біртүрлі бос сезім екен, иә?
Dialogue: 0,0:09:01.12,0:09:06.09,JP2,,0000,0000,0000,,Мен сізге жоғарылату үшін келген сияқты емеспін бе?
Dialogue: 0,0:09:07.91,0:09:09.50,JP2,,0000,0000,0000,,Мичимасаның уақыты келді
Dialogue: 0,0:09:09.74,0:09:12.78,JP2,,0000,0000,0000,,Уайымдама, мен сенің махаббатыңа ешқашан күмән келтірмеймін
Dialogue: 0,0:09:12.78,0:09:15.98,JP2,,0000,0000,0000,,Мұны сіз емес, айналаңыздағы адамдар айтады.
Dialogue: 0,0:09:17.67,0:09:20.56,JP2,,0000,0000,0000,,Сізге де, маған да осындай менсінбеу керек.
Dialogue: 0,0:09:20.95,0:09:23.69,JP2,,0000,0000,0000,,Мен Накагуанпаку отбасының атын жамандай алмаймын.
Dialogue: 0,0:09:25.73,0:09:28.48,JP2,,0000,0000,0000,,Бірақ содан кейін
Dialogue: 0,0:09:30.10,0:09:34.30,JP2,,0000,0000,0000,,Сен екеуміз қалай бірге бола аламыз?
Dialogue: 0,0:09:35.27,0:09:38.97,JP2,,0000,0000,0000,,Сондықтан мұндай асықпаңыз және күтіңіз.
Dialogue: 0,0:09:40.59,0:09:42.01,JP2,,0000,0000,0000,,Мен керемет боламын
Dialogue: 0,0:09:42.83,0:09:45.76,JP2,,0000,0000,0000,,Мен сені міндетті түрде сарайдан ашық алып кетемін.
Dialogue: 0,0:09:46.88,0:09:47.92,JP2,,0000,0000,0000,,Мен уәде беремін
Dialogue: 0,0:09:55.05,0:09:56.00,JP2,,0000,0000,0000,,Иә.
Dialogue: 0,0:09:59.53,0:10:02.73,JP2,,0000,0000,0000,,Кешіріңіз, мен тым шыдамсыз болдым.
Dialogue: 0,0:10:03.28,0:10:03.75,JP2,,0000,0000,0000,,Сарай
Dialogue: 0,0:10:04.30,0:10:06.39,JP2,,0000,0000,0000,,Мен сені Мичигаға арнаймын
Dialogue: 0,0:10:06.98,0:10:09.34,JP2,,0000,0000,0000,,Мені міндетті түрде шығарып салыңыз.
Dialogue: 0,0:10:12.87,0:10:16.06,JP2,,0000,0000,0000,,Бірақ жоғарылатудың қандай қатысы бар?
Dialogue: 0,0:10:16.85,0:10:21.57,JP2,,0000,0000,0000,,Әкем өзінің саяси қарсыласы Мичинагадан жеңілгеннен бері біз құлдырап кеттік.
Dialogue: 0,0:10:22.74,0:10:24.78,JP2,,0000,0000,0000,,Жақсырақ, Мичинага.
Dialogue: 0,0:10:25.90,0:10:31.94,JP2,,0000,0000,0000,,Жоқ, мен олар сияқты басқаларды тұзаққа түсіру немесе пайдалану үшін ешқашан ештеңе жасамас едім.
Dialogue: 0,0:10:33.85,0:10:36.63,JP2,,0000,0000,0000,,Шындық болу үшін бар күшімді салудан басқа амалым жоқ.
Dialogue: 0,0:10:37.53,0:10:38.57,JP2,,0000,0000,0000,,Догаден
Dialogue: 0,0:10:39.67,0:10:40.57,JP2,,0000,0000,0000,,Генерал-лейтенант
Dialogue: 0,0:10:42.30,0:10:45.38,JP2,,0000,0000,0000,,Мен сен туралы Санджойннан білдім.
Dialogue: 0,0:10:48.47,0:10:50.38,JP2,,0000,0000,0000,,Үй қатты ашулы.
Dialogue: 0,0:10:50.68,0:10:55.90,JP2,,0000,0000,0000,,Айналасындағылардың ешбір шапағатын тыңдамай, қатаң бақылауда өмір сүрді.
Dialogue: 0,0:10:55.90,0:10:59.48,JP2,,0000,0000,0000,,Мені де жол көрсету қылмысым үшін ғибадатханадан қуып шықтым.
Dialogue: 0,0:10:59.80,0:11:02.71,JP2,,0000,0000,0000,,Біздің қарым-қатынасымызға енді делдалдық жасау мүмкін емес.
Dialogue: 0,0:11:08.82,0:11:12.72,JP2,,0000,0000,0000,,Сен екеуміз қалай бірге бола аламыз?
Dialogue: 0,0:11:16.53,0:11:18.41,JP2,,0000,0000,0000,,Сарай білген.
Dialogue: 0,0:11:19.43,0:11:23.24,JP2,,0000,0000,0000,,Бізді заңды түрде біріктіру мүмкін емес.
Dialogue: 0,0:11:25.80,0:11:27.09,JP2,,0000,0000,0000,,Мен сені ұрлап кетуім керек еді.
Dialogue: 0,0:11:27.51,0:11:29.50,JP2,,0000,0000,0000,,Өзіңіздің қызықсыз ниеттеріңізбен айналыспаңыз
Dialogue: 0,0:11:29.97,0:11:31.59,JP2,,0000,0000,0000,,Мен оны алып шығуым керек еді.
Dialogue: 0,0:11:33.40,0:11:35.96,JP2,,0000,0000,0000,,Бәріне қазірдің өзінде кеш.
Dialogue: 0,0:11:42.00,0:11:44.19,JP2,,0000,0000,0000,,Ағашқа осылай байласаң
Dialogue: 0,0:11:44.71,0:11:48.12,JP2,,0000,0000,0000,,Кім байқап, хабарлама жібереді?
Dialogue: 0,0:11:59.67,0:12:04.15,JP2,,0000,0000,0000,,Енді мен сені көре алмаған соң, бас тартамын деймін.
Dialogue: 0,0:12:04.92,0:12:07.70,JP2,,0000,0000,0000,,Мен сізге тікелей айтқым келеді
Dialogue: 0,0:12:25.32,0:12:26.37,JP2,,0000,0000,0000,,Бала
Dialogue: 0,0:12:27.41,0:12:28.16,JP2,,0000,0000,0000,,Әке
Dialogue: 0,0:12:29.10,0:12:31.26,JP2,,0000,0000,0000,,Бақшада бірге айға қарайық
Dialogue: 0,0:12:32.70,0:12:33.30,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:12:38.15,0:12:40.01,JP2,,0000,0000,0000,,Бүгінгі түнде ай туралы не айтасыз?
Dialogue: 0,0:12:42.05,0:12:45.95,JP2,,0000,0000,0000,,Ол кедергі келтіретін бұлтсыз әдемі жарқырайды.
Dialogue: 0,0:12:46.37,0:12:47.49,JP2,,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:12:48.78,0:12:51.89,JP2,,0000,0000,0000,,Соңғы кездері көзім бұлттанып, көрмей қалдым.
Dialogue: 0,0:12:52.44,0:12:53.98,JP2,,0000,0000,0000,,Жарықты көруге болады
Dialogue: 0,0:12:54.80,0:12:57.51,JP2,,0000,0000,0000,,Ол үлкенірек көрінеді, себебі бұлыңғыр көрінеді
Dialogue: 0,0:12:58.10,0:13:01.11,JP2,,0000,0000,0000,,Бұл өзінше әдемі.
Dialogue: 0,0:13:03.52,0:13:08.12,JP2,,0000,0000,0000,,Мен де, неге екені белгісіз, бүгін түнде ай үлкенірек болып көрінеді.
Dialogue: 0,0:13:09.39,0:13:10.83,JP2,,0000,0000,0000,,Көз жасынан ба?
Dialogue: 0,0:13:12.30,0:13:17.29,JP2,,0000,0000,0000,,Балам, сен мені қатты жек көретін шығарсың.
Dialogue: 0,0:13:18.16,0:13:20.97,JP2,,0000,0000,0000,,Бірақ мен басқа ештеңе істей алмадым.
Dialogue: 0,0:13:21.67,0:13:24.92,JP2,,0000,0000,0000,,Менің ата-анам мен Сайғу болып қызмет еткен сен.
Dialogue: 0,0:13:25.44,0:13:31.06,JP2,,0000,0000,0000,,Мен оны орта буын Канпаку отбасынан шыққан, жағдайы төмен, болашағы қауіпті адамға бере алмаймын.
Dialogue: 0,0:13:31.71,0:13:34.24,JP2,,0000,0000,0000,,Сізге жақсы ештеңе жоқ
Dialogue: 0,0:13:34.24,0:13:37.08,JP2,,0000,0000,0000,,Енді бұл туралы айтпа, әке.
Dialogue: 0,0:13:38.69,0:13:41.35,JP2,,0000,0000,0000,,Мен ештеңе білмедім
Dialogue: 0,0:13:43.71,0:13:48.41,JP2,,0000,0000,0000,,Сол күні атам да, әжем де шынымен бақытты көрінді.
Dialogue: 0,0:13:50.60,0:13:53.73,JP2,,0000,0000,0000,,Ах, тағы бір шексіз естелік
Dialogue: 0,0:13:54.90,0:13:58.50,JP2,,0000,0000,0000,,Кешір, балам, бұл қара әңгімеге айналды.
Dialogue: 0,0:13:59.00,0:14:00.29,JP2,,0000,0000,0000,,Жоқ, бәрі жақсы.
Dialogue: 0,0:14:01.08,0:14:04.64,JP2,,0000,0000,0000,,Мен сенің мұңлы, қорқынышты жүзіңді жақсы көремін.
Dialogue: 0,0:14:05.31,0:14:06.83,JP2,,0000,0000,0000,,Сіздің дәміңіз нашар.
Dialogue: 0,0:14:07.07,0:14:08.37,JP2,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:14:08.81,0:14:12.84,JP2,,0000,0000,0000,,Мен, сіздің қара әңгімеңізді естігенде жігерленемін.
Dialogue: 0,0:14:13.29,0:14:14.16,JP2,,0000,0000,0000,,Мотивация
Dialogue: 0,0:14:15.55,0:14:17.34,JP2,,0000,0000,0000,,Екінші жағынан, мен мұғаліммін деп айтқым келеді.
Dialogue: 0,0:14:17.59,0:14:18.81,JP2,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:14:19.92,0:14:21.49,JP2,,0000,0000,0000,,Мен бәрібір мотивация сезінемін.
Dialogue: 0,0:14:25.47,0:14:26.78,JP2,,0000,0000,0000,,Мен әйтеуір
Dialogue: 0,0:14:27.48,0:14:31.53,JP2,,0000,0000,0000,,Мен Мичиганың қараңғы өміріне нұр шашатын адаммын деп ойладым.
Dialogue: 0,0:14:32.82,0:14:39.11,JP2,,0000,0000,0000,,Ал Мичига мені бақытқа жетелейтін жалғыз джентльмен.
Dialogue: 0,0:14:40.08,0:14:42.74,JP2,,0000,0000,0000,,Бұл күндері мен әлі де сондай бейкүнә ойладым.
Dialogue: 0,0:14:47.81,0:14:51.39,JP2,,0000,0000,0000,,Бұл оның әкесі император Санджоның таққа отыруымен байланысты болды.
Dialogue: 0,0:14:52.19,0:14:56.53,JP2,,0000,0000,0000,,Мен Сайғу болып сайланып, астанадан кетер алдындағы түн еді.
Dialogue: 0,0:14:57.65,0:14:59.69,JP2,,0000,0000,0000,,Менің балам олай істей алмайды.
Dialogue: 0,0:14:59.99,0:15:04.98,JP2,,0000,0000,0000,,Осындай қараңғы түнде бірдеңе бола қалса, мен сені жалғыз қорғай алмас едім.
Dialogue: 0,0:15:05.71,0:15:07.30,JP2,,0000,0000,0000,,Сіз қазірдің өзінде алаңдаушысыз.
Dialogue: 0,0:15:07.64,0:15:09.78,JP2,,0000,0000,0000,,Олай болса, менің күзетшім болуы керек сияқты.
Dialogue: 0,0:15:14.38,0:15:15.57,JP2,,0000,0000,0000,,Сен сонда
Dialogue: 0,0:15:18.18,0:15:20.74,JP2,,0000,0000,0000,,Тоқтаңыз. Бұндай нәрсені көру өте сұмдық.
Dialogue: 0,0:15:20.74,0:15:21.99,JP2,,0000,0000,0000,,Көп ұрыс-керіс сияқты
Dialogue: 0,0:15:22.41,0:15:25.59,JP2,,0000,0000,0000,,Мен сені бүгін кешке күзетші етіп тағайындаймын.
Dialogue: 0,0:15:30.16,0:15:33.05,JP2,,0000,0000,0000,,Егер сарайды тастасаң, мен оны қабылдамаймын.
Dialogue: 0,0:15:33.05,0:15:36.28,JP2,,0000,0000,0000,,...
Dialogue: 0,0:15:37.44,0:15:39.28,JP2,,0000,0000,0000,,Міне, келдік.
Dialogue: 0,0:15:39.56,0:15:41.55,JP2,,0000,0000,0000,,Осы жерден іші мен артын анық көруге болады.
Dialogue: 0,0:15:43.04,0:15:45.62,JP2,,0000,0000,0000,,Сейриоден, мұнда оң қол императордікі
Dialogue: 0,0:15:46.07,0:15:50.32,JP2,,0000,0000,0000,,Ортадан солға қарай Сеоняоден, ананың резиденциясы.
Dialogue: 0,0:15:52.95,0:15:56.36,JP2,,0000,0000,0000,,Мен Исэге түскім келмейді.
Dialogue: 0,0:15:57.55,0:15:59.19,JP2,,0000,0000,0000,,Мен Киотодан кеткім келмейді
Dialogue: 0,0:15:59.84,0:16:02.10,JP2,,0000,0000,0000,,Мен әкеммен қоштасуды жек көремін.
Dialogue: 0,0:16:06.30,0:16:07.49,JP2,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:16:09.38,0:16:10.72,JP2,,0000,0000,0000,,Гүлдер Киото гүлдері
Dialogue: 0,0:16:11.10,0:16:13.46,JP2,,0000,0000,0000,,Қалағаныңызша алыңыз.
Dialogue: 0,0:16:13.61,0:16:17.11,JP2-,,0000,0000,0000,,Ал кептірілген ет, Киото еті, жолда жей беріңіз.
Dialogue: 0,0:16:17.11,0:16:18.55,JP2-,,0000,0000,0000,,Жоқ, тамақ ішіңіз.
Dialogue: 0,0:16:15.35,0:16:17.93,JP2,,0000,0000,0000,,Осы сәтте мен сенімді болдым.
Dialogue: 0,0:16:18.95,0:16:21.56,JP2,,0000,0000,0000,,Не қалды? Киотодағы топырақ
Dialogue: 0,0:16:25.21,0:16:26.16,JP2,,0000,0000,0000,,Рахмет
Dialogue: 0,0:16:26.16,0:16:28.74,JP2,,0000,0000,0000,,Сырт келбетіңізге қарамастан сондай мейірімдісіз.
Dialogue: 0,0:16:29.79,0:16:30.73,JP2-,,0000,0000,0000,,Маған ұнайды
Dialogue: 0,0:16:31.38,0:16:33.29,JP2-,,0000,0000,0000,,Бұл құрмет.
Dialogue: 0,0:16:29.74,0:16:32.89,JP2,,0000,0000,0000,,Бұл адам менің тағдырым
Dialogue: 0,0:16:34.39,0:16:36.37,JP2,,0000,0000,0000,,Сіздің атыңыз кім?
Dialogue: 0,0:16:36.82,0:16:38.46,JP2,,0000,0000,0000,,Бұл Мичимаса Фудзивара.
Dialogue: 0,0:16:38.71,0:16:41.74,JP2,,0000,0000,0000,,Мичига Мичига, мен оны ұмытпаймын.
Dialogue: 0,0:16:43.41,0:16:47.38,JP2,,0000,0000,0000,,Эй, Мичига, егер мен Киотоға қайта оралсам.
Dialogue: 0,0:16:48.01,0:16:52.06,JP2,,0000,0000,0000,,Мені қазіргідей көтеріп, осында әкелесің бе?
Dialogue: 0,0:16:52.93,0:16:58.42,JP2,,0000,0000,0000,,Иә, сарай қаласа, қуана еріп барамын.
Dialogue: 0,0:17:00.95,0:17:03.27,JP2,,0000,0000,0000,,Императордың қызы ретіндегі қолайсыз жағдай
Dialogue: 0,0:17:04.06,0:17:05.73,JP2,,0000,0000,0000,,Император сарайындағы тар өмір
Dialogue: 0,0:17:07.02,0:17:09.93,JP2,,0000,0000,0000,,Мені мұндай азаптан кім құтқарады?
Dialogue: 0,0:17:10.37,0:17:11.67,JP2,,0000,0000,0000,,Бұл Мичига
Dialogue: 0,0:17:13.01,0:17:15.32,JP2,,0000,0000,0000,,Әңгімедегі ханзада сияқты
Dialogue: 0,0:17:15.79,0:17:18.70,JP2,,0000,0000,0000,,Мені ұстап алып, ұрлап әкеткен мырза
Dialogue: 0,0:17:23.82,0:17:28.52,JP2,,0000,0000,0000,,Сайғу болған уақытымда бір күнді ұмытқан емеспін.
Dialogue: 0,0:17:30.06,0:17:31.40,JP2,,0000,0000,0000,,Ал үш жылдан кейін
Dialogue: 0,0:17:32.72,0:17:37.12,JP2,,0000,0000,0000,,Әкемнің тақтан бас тартуымен мен өз міндеттерімді аяқтап, Иседен кеттім.
Dialogue: 0,0:17:38.58,0:17:42.19,JP2,,0000,0000,0000,,Киотоға оралғаннан кейін көп ұзамай мен Мичигадан хат алдым.
Dialogue: 0,0:17:43.43,0:17:45.10,JP2,,0000,0000,0000,,Ол мені есіне алды.
Dialogue: 0,0:17:45.92,0:17:48.20,JP2,,0000,0000,0000,,Өйткені, Мичига – тағдырдың тұлғасы.
Dialogue: 0,0:17:50.27,0:17:53.25,JP2,,0000,0000,0000,,Көптен күткен тілегім орындалатын болды.
Dialogue: 0,0:17:54.14,0:17:59.83,JP2,,0000,0000,0000,,Бірақ Мичига мені ұрлаған жоқ.
Dialogue: 0,0:18:03.64,0:18:06.59,JP2,,0000,0000,0000,,Бұл жолы менің ұлым кінәлі болды.
Dialogue: 0,0:18:07.49,0:18:09.35,JP2,,0000,0000,0000,,Әкемнің ұстанымын ескермей
Dialogue: 0,0:18:09.80,0:18:12.04,JP2,,0000,0000,0000,,Қарастырылып отырған бала ақымақ болды.
Dialogue: 0,0:18:16.49,0:18:19.00,JP2,,0000,0000,0000,,Иә, мен ақымақ болдым.
Dialogue: 0,0:18:20.19,0:18:24.86,JP2,,0000,0000,0000,,Мен әкемнің жүзін ер адам ретінде байқамадым.
Dialogue: 0,0:18:26.28,0:18:29.71,JP2,,0000,0000,0000,,Өзім түсінбей, бала кездегі армандарымды өзіме күштеп салдым.
Dialogue: 0,0:18:31.47,0:18:33.34,JP2,,0000,0000,0000,,Осы мүмкіндікті пайдаланыңыз.
Dialogue: 0,0:18:34.46,0:18:37.24,JP2,,0000,0000,0000,,Әкем біздің қарым-қатынасымызды қазіргідей білсе ше?
Dialogue: 0,0:18:37.51,0:18:40.20,JP2,,0000,0000,0000,,Әкеңнің қаһарына ұшырайсың.
Dialogue: 0,0:18:40.82,0:18:42.71,JP2,,0000,0000,0000,,Тұрмысқа шыққан соң басқа әңгіме.
Dialogue: 0,0:18:44.20,0:18:45.49,JP2,,0000,0000,0000,,Сүйікті қызыңыздың күйеуінің орны лайықты болсын.
Dialogue: 0,0:18:45.91,0:18:49.32,JP2,,0000,0000,0000,,Оны әкем шешеді.
Dialogue: 0,0:18:50.64,0:18:52.25,JP2,,0000,0000,0000,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:18:53.02,0:18:53.59,JP2,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:18:54.21,0:18:59.19,JP2,,0000,0000,0000,,Мен сізге жоғарылату үшін келген сияқты емеспін бе?
Dialogue: 0,0:19:00.80,0:19:02.39,JP2,,0000,0000,0000,,Мичимасаның уақыты келді
Dialogue: 0,0:19:02.76,0:19:05.67,JP2,,0000,0000,0000,,Уайымдама, мен сенің махаббатыңа ешқашан күмән келтірмеймін
Dialogue: 0,0:19:05.67,0:19:08.83,JP2,,0000,0000,0000,,Мұны сіз емес, айналаңыздағы адамдар айтады.
Dialogue: 0,0:19:10.00,0:19:12.95,JP2-,,0000,0000,0000,,Сізге де, маған да осындай менсінбеу керек.
Dialogue: 0,0:19:13.40,0:19:16.34,JP2-,,0000,0000,0000,,Мен Накагуанпаку отбасының атын жамандай алмаймын.
Dialogue: 0,0:19:12.68,0:19:18.72,JP2,,0000,0000,0000,,Мен үшін сүйіспеншіліктен гөрі отбасының сыртқы түрі маңыздырақ дегенді қалай түсінесің?
Dialogue: 0,0:19:20.66,0:19:23.52,JP2,,0000,0000,0000,,Бірақ содан кейін
Dialogue: 0,0:19:25.28,0:19:29.36,JP2,,0000,0000,0000,,Сен екеуміз қалай бірге бола аламыз?
Dialogue: 0,0:19:30.38,0:19:34.25,JP2,,0000,0000,0000,,Сондықтан мұндай асықпаңыз және күтіңіз.
Dialogue: 0,0:19:35.82,0:19:37.16,JP2,,0000,0000,0000,,Мен керемет боламын
Dialogue: 0,0:19:38.01,0:19:40.99,JP2,,0000,0000,0000,,Мен сені міндетті түрде сарайдан ашық алып кетемін.
Dialogue: 0,0:19:41.64,0:19:43.30,JP2,,0000,0000,0000,,Бұл адам не туралы айтып отыр?
Dialogue: 0,0:19:44.20,0:19:45.81,JP2,,0000,0000,0000,,Сайгу болып қызмет еткен менімен
Dialogue: 0,0:19:46.36,0:19:50.83,JP2,,0000,0000,0000,,Вассал ретінде сіздің некеңізді ресми түрде тануға болмайды.
Dialogue: 0,0:19:52.85,0:19:56.97,JP2,,0000,0000,0000,,Қашып кетуден басқа амал жоқ екенін білсең де.
Dialogue: 0,0:19:58.31,0:20:00.97,JP2,,0000,0000,0000,,Мұндай адам...осындай адам
Dialogue: 0,0:20:05.67,0:20:08.98,JP2,,0000,0000,0000,,Мен неге императордың қызы болып тудым?
Dialogue: 0,0:20:09.85,0:20:14.20,JP2,,0000,0000,0000,,Әлеуметтік мәртебедегі бұл алшақтықты жүрекпен кесіп өту мүмкін емес.
Dialogue: 0,0:20:16.01,0:20:18.57,JP2,,0000,0000,0000,,Біз ешқашан бірікпейміз
Dialogue: 0,0:20:19.76,0:20:21.60,JP2,,0000,0000,0000,,Мен бұл адамды қатты жақсы көремін
Dialogue: 0,0:20:26.25,0:20:30.75,JP2,,0000,0000,0000,,Махаббатымыздың орындалмауы әкемнің арқасы емес.
Dialogue: 0,0:20:31.92,0:20:34.70,JP2,,0000,0000,0000,,Мичига менің ұсынысыма жауап бермеген кезде
Dialogue: 0,0:20:35.50,0:20:37.43,JP2,,0000,0000,0000,,Ғашықтан жеңілдім
Dialogue: 0,0:20:38.98,0:20:42.68,JP2,,0000,0000,0000,,Балам мен монах болуды ойлап жүрмін.
Dialogue: 0,0:20:43.95,0:20:46.28,JP2,,0000,0000,0000,,Мен сияқты түкке тұрғысыз адам
Dialogue: 0,0:20:46.78,0:20:50.58,JP2,,0000,0000,0000,,Өйткені бұл дүниеде ұзақ өмір сүрудің мәні жоқ деп ойлаймын.
Dialogue: 0,0:20:51.25,0:20:55.45,JP2,,0000,0000,0000,,Қызының махаббатын көтере алмайтын аянышты адам.
Dialogue: 0,0:20:56.35,0:21:01.22,JP2,,0000,0000,0000,,Бұдан былай Буддаға жабысып, бұл дүниенің күнәларын жойайық.
Dialogue: 0,0:21:01.99,0:21:05.05,JP2,,0000,0000,0000,,Бірақ мен дүниені осылай тастап кетсем де,
Dialogue: 0,0:21:05.37,0:21:09.10,JP2,,0000,0000,0000,,Егер мен ұзақ өмір сүрсем, оны есімде сақтайтын шығармын.
Dialogue: 0,0:21:19.81,0:21:24.61,JP2,,0000,0000,0000,,Менің енді өмір сүруге ерік-жігерім жоқ, бірақ ұзақ өмір сүрсем ше?
Dialogue: 0,0:21:24.93,0:21:27.02,JP2,,0000,0000,0000,,Мен сені міндетті түрде сағынатын боламын
Dialogue: 0,0:21:27.52,0:21:29.65,JP2,,0000,0000,0000,,Бүгінгі түндегі әдемі ай
Dialogue: 0,0:21:31.77,0:21:36.71,JP2,,0000,0000,0000,,Бұл әкем тақтан түскенде оқыған ефемерлік жыр еді.
Dialogue: 0,0:21:38.70,0:21:40.76,JP2,,0000,0000,0000,,Мен де шашымды төгіп, монах боламын.
Dialogue: 0,0:21:42.53,0:21:47.30,JP2,,0000,0000,0000,,Әңгіме – ақыр соңында әңгіме. Мені ұрлайтын ешкім жоқ.
Dialogue: 0,0:21:48.99,0:21:52.94,JP2,,0000,0000,0000,,Біреу пайда болса да, Мичигадан басқа ешкім болмас еді.
Dialogue: 0,0:21:55.43,0:21:59.53,JP2,,0000,0000,0000,,Олай болса, жүрегімде сол кісі туралы естеліктермен монах боламын.
Dialogue: 0,0:22:01.27,0:22:04.42,JP2,,0000,0000,0000,,Бірақ егер сіз әлі ұзақ өмір сүрсеңіз
Dialogue: 0,0:22:05.29,0:22:08.67,JP2,,0000,0000,0000,,Әкең айтқандай, есіңде қалатынына сенімдімін.
Dialogue: 0,0:22:10.46,0:22:12.43,JP2,,0000,0000,0000,,Мен сені кездестірген түннің айы
Dialogue: 0,0:22:14.44,0:22:16.80,JP2,,0000,0000,0000,,Біздің бас қосқан түнде жарқыраған ай
Dialogue: 0,0:22:18.52,0:22:21.37,JP2,,0000,0000,0000,,Ай ғана білетін құпия кездесу
Dialogue: 0,0:22:23.01,0:22:24.48,JP2,,0000,0000,0000,,Күн сәулесінің дәл астында
Dialogue: 0,0:22:25.40,0:22:28.48,JP2,,0000,0000,0000,,Екеуміз бетпе-бет кездеспеген сенімен болған махаббатым
Dialogue: 0,0:22:31.61,0:22:36.91,JP2,,0000,0000,0000,,Мичига Мичига Егер келесі өмірде қайта кездессек
Dialogue: 0,0:22:37.26,0:22:42.18,JP2,,0000,0000,0000,,Сол кезде мені ұрлап кетіңізші.
Dialogue: 0,0:24:17.19,0:24:22.69,JP2,,0000,0000,0000,,Мацухонура күн батқанда
Dialogue: 0,0:24:22.94,0:24:27.36,JP2,,0000,0000,0000,,Грильде пісіргенде, Мошионың еті қайнап жатыр.
Dialogue: 0,0:00:01.31,0:00:02.13,CN,,0000,0000,0000,,Темір
Dialogue: 0,0:00:02.36,0:00:04.20,CN,,0000,0000,0000,,Super Script Player Network
Dialogue: 0,0:00:07.00,0:00:09.19,CN,,0000,0000,0000,,Бөтен Икуридің пайда болуы
Dialogue: 0,0:00:09.44,0:00:12.20,CN,,0000,0000,0000,,Жаһандық бейбітшілік
Dialogue: 0,0:00:12.52,0:00:15.16,CN,,0000,0000,0000,,Шағын жеткізу!
Dialogue: 0,0:00:15.95,0:00:17.37,CN,,0000,0000,0000,,Жоғалған және жеңілген
Dialogue: 0,0:00:18.26,0:00:19.60,CN,,0000,0000,0000,,Дұрыс және сөзсіз жеңіс
Dialogue: 0,0:00:20.23,0:00:22.31,CN,,0000,0000,0000,,Мен шебермін
Dialogue: 0,0:00:22.84,0:00:24.38,CN,,0000,0000,0000,,Мен Utsunomiya Netмін
Dialogue: 0,0:00:24.85,0:00:26.61,CN,,0000,0000,0000,,Санчунг қаласындағы Ику храмы
Dialogue: 0,0:00:26.84,0:00:32.85,CN,,0000,0000,0000,,Осы ғибадатханада тұратын император отбасының үйленбеген әйел мүшесі және ғибадатхананың таңдаулы әйел ханшайымы.
Dialogue: 0,0:00:34.67,0:00:36.68,CN,,0000,0000,0000,,Тапсырманы орындағаннан кейін
Dialogue: 0,0:00:36.83,0:00:41.28,CN,,0000,0000,0000,,Канаме – жалғыздықтың соңы Канаме – императрица сарайы
Dialogue: 0,0:00:41.70,0:00:44.71,CN,,0000,0000,0000,,Қайтыс болған вассалдардың және балаларының қатысуымен некеге тұру мысалдары
Dialogue: 0,0:02:27.38,0:02:32.15,CN,,0000,0000,0000,,Бұл атақ атасы Мичитаканың өміріндегі жағдайлар
Dialogue: 0,0:02:32.62,0:02:35.11,CN,,0000,0000,0000,,Отбасының қайын енесі, Накамия ауылы.
Dialogue: 0,0:02:36.10,0:02:39.56,CN,,0000,0000,0000,,Атам басқаның тізесіне отырдым депті.
Dialogue: 0,0:02:40.35,0:02:42.47,CN,,0000,0000,0000,,Жұмыстың басқа шарттары
Dialogue: 0,0:02:42.86,0:02:45.05,CN,,0000,0000,0000,,Атамды бағып-қағып бақыттымын
Dialogue: 0,0:02:46.47,0:02:48.88,CN,,0000,0000,0000,,Кету кезіндегі күтуші ханым
Dialogue: 0,0:02:49.55,0:02:51.76,CN,,0000,0000,0000,,Айқайлап аты келеді
Dialogue: 0,0:02:52.33,0:02:56.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:57.98,0:03:00.34,CN,,0000,0000,0000,,Император Ичиджоның келуі
Dialogue: 0,0:03:00.86,0:03:04.49,CN,,0000,0000,0000,,Өте жеке дос және үлкен банкет
Dialogue: 0,0:03:05.48,0:03:08.69,CN,,0000,0000,0000,,Атам, әжем, әкем, ағам және ағам.
Dialogue: 0,0:03:09.21,0:03:11.72,CN,,0000,0000,0000,,Белгілі бір уақытта жалғыз адам, белгілі бір уақытта ашық ой
Dialogue: 0,0:03:12.54,0:03:15.57,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:15.99,0:03:16.89,CN,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:03:19.00,0:03:21.21,CN,,0000,0000,0000,,Шағын дүкен қажет
Dialogue: 0,0:03:22.22,0:03:25.22,&,,0000,0000,0000,,Мичига Йотоко
Dialogue: 0,0:03:22.22,0:03:25.22,,,0000,0000,0000,,Мичимаса Сакё Даю
Dialogue: 0,0:03:27.90,0:03:30.09,CN,,0000,0000,0000,,Шындық – Хуан Ляоның арманы
Dialogue: 0,0:03:30.39,0:03:34.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:34.41,0:03:35.53,CN,,0000,0000,0000,,Нацунай
Dialogue: 0,0:03:37.17,0:03:39.63,CN,,0000,0000,0000,,Біреуге қараудың тағы бір жолы жақсы немесе тартымды емес...
Dialogue: 0,0:03:39.63,0:03:40.68,CN,,0000,0000,0000,,Жауға шабуыл жасағанда
Dialogue: 0,0:03:41.17,0:03:44.33,CN,,0000,0000,0000,,Мен сені тағайындадым және бүгін түнде сені қорғауға келдім.
Dialogue: 0,0:03:45.87,0:03:48.18,CN,,0000,0000,0000,,Ханшайым мен ересек адамның теріс қылықтары
Dialogue: 0,0:03:48.18,0:03:49.00,CN,,0000,0000,0000,,Тәртіпсіздік генерал-лейтенант
Dialogue: 0,0:03:49.47,0:03:52.01,CN,,0000,0000,0000,,Мен өзімнің талантыма қазіргі уақытта қол жеткізгенімді білу маңызды.
Dialogue: 0,0:03:52.33,0:03:55.64,CN,,0000,0000,0000,,Ересек ханшайым? Менің ұлымның ұлы екенім рас па?
Dialogue: 0,0:03:55.99,0:03:56.73,CN,,0000,0000,0000,,Дұрыс және бұрыс
Dialogue: 0,0:03:58.57,0:04:00.83,CN,,0000,0000,0000,,Мен шешім қабылдай алдым.
Dialogue: 0,0:04:00.96,0:04:02.37,CN,,0000,0000,0000,,Бұл әңгіменің оқиғасы.
Dialogue: 0,0:04:02.82,0:04:05.80,CN,,0000,0000,0000,,Бірінші сынып, түнде, ханшайымды қарсы алды...
Dialogue: 0,0:04:05.80,0:04:10.38,CN,,0000,0000,0000,,Ұзақ қолданушыға қараңызшы.
Dialogue: 0,0:04:10.72,0:04:11.74,CN,,0000,0000,0000,,Кейто…
Dialogue: 0,0:04:12.31,0:04:13.74,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:14.03,0:04:16.96,CN,,0000,0000,0000,,Мен Киотоны қайтадан аяқтай алмадым.
Dialogue: 0,0:04:17.36,0:04:20.72,CN,,0000,0000,0000,,Мен көптен бері туған жерім бар қолайлы жерді көремін.
Dialogue: 0,0:04:25.59,0:04:28.37,CN,,0000,0000,0000,,Сіз кішкентай болуыңыз мүмкін және бөлек ханшайымға келдіңіз.
Dialogue: 0,0:04:29.04,0:04:32.30,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:33.34,0:04:35.03,CN,,0000,0000,0000,,Сіз аяқтадыңыз
Dialogue: 0,0:04:35.63,0:04:37.49,CN,,0000,0000,0000,,Оучи-риге қайда баруға болады?
Dialogue: 0,0:04:39.50,0:04:41.87,CN,,0000,0000,0000,,Оң қол – Мәртебелі Резиденциясы Сейрёден.
Dialogue: 0,0:04:42.16,0:04:46.34,CN,,0000,0000,0000,,Бұл Ана патшайымның тұратын жері.
Dialogue: 0,0:04:49.22,0:04:52.43,CN,,0000,0000,0000,,Менде ешбір естелік жоқ
Dialogue: 0,0:04:53.50,0:04:55.21,CN,,0000,0000,0000,,Фусо бөлу Киото
Dialogue: 0,0:04:56.03,0:04:58.17,CN,,0000,0000,0000,,Жауапсыз әке
Dialogue: 0,0:04:58.17,0:05:00.41,CN,,0000,0000,0000,,Ересек ханшайым Эйта Карей
Dialogue: 0,0:05:01.33,0:05:05.97,CN,,0000,0000,0000,,Ван Чушо Най Самурай қауымдастығынан бас тарту Ичидоши Самурай Хоен сол және оң
Dialogue: 0,0:05:06.35,0:05:08.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:08.44,0:05:10.82,CN,,0000,0000,0000,,Нанао Тоюки...
Dialogue: 0,0:05:10.74,0:05:12.70,&,,0000,0000,0000,,Бақыт
Dialogue: 0,0:05:12.96,0:05:14.97,CN,,0000,0000,0000,,Адасқан! ! !
Dialogue: 0,0:05:15.94,0:05:18.55,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:18.65,0:05:22.15,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:22.60,0:05:24.49,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:24.76,0:05:28.07,CN,,0000,0000,0000,,…
Dialogue: 0,0:05:29.76,0:05:31.57,CN,,0000,0000,0000,,Фукка Киотоның Фуккасы
Dialogue: 0,0:05:31.77,0:05:34.18,CN,,0000,0000,0000,,Біраз қуанып, көк шөп
Dialogue: 0,0:05:34.53,0:05:38.14,CN,,0000,0000,0000,,Көшеде киотолық еттің кекештенуі
Dialogue: 0,0:05:38.14,0:05:39.53,CN,,0000,0000,0000,,Көшеде тамақ жегім келмейді.
Dialogue: 0,0:05:39.53,0:05:42.44,CN,,0000,0000,0000,,Бұл Киото балшығы.
Dialogue: 0,0:05:46.16,0:05:47.21,CN,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:05:47.21,0:05:49.79,CN,,0000,0000,0000,,Сіз жылы және жұмсақсыз.
Dialogue: 0,0:05:50.61,0:05:51.53,CN,,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,0:05:52.45,0:05:54.42,CN,,0000,0000,0000,,Бұл халықтың саяхаты
Dialogue: 0,0:05:55.48,0:05:57.40,CN,,0000,0000,0000,,Сіздің фамилияңыз
Dialogue: 0,0:05:57.82,0:05:59.44,CN,,0000,0000,0000,,Мичимаса Фудзивара
Dialogue: 0,0:05:59.66,0:06:02.67,CN,,0000,0000,0000,,Мичига Мичига мен кездесуімді екінші рет ұмытып отырмын.
Dialogue: 0,0:06:04.61,0:06:08.68,CN,,0000,0000,0000,,Мен Киотоға келдім.
Dialogue: 0,0:06:09.23,0:06:13.16,CN,,0000,0000,0000,,Сіздің мүсініңіз қазір көкте
Dialogue: 0,0:06:14.10,0:06:19.54,CN,,0000,0000,0000,,Жақсы, бұл ханшайымның қиялы туралы әңгіме.
Dialogue: 0,0:06:21.16,0:06:23.59,CN,,0000,0000,0000,,Шынайы ашықтық
Dialogue: 0,0:06:28.99,0:06:33.34,CN,,0000,0000,0000,,Зайнадан кейін, император тақтан түскеннен кейін 3 жыл өткен соң
Dialogue: 0,0:06:34.60,0:06:38.95,CN,,0000,0000,0000,,Жаңа император таққа отырған кезде тағайындалған адам тағайындалды.
Dialogue: 0,0:06:39.58,0:06:41.32,CN,,0000,0000,0000,,Алайда, жеткізу ақысы алынып тасталса
Dialogue: 0,0:06:42.56,0:06:47.60,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:48.03,0:06:48.80,,,0000,0000,0000,,Келесі жолы
Dialogue: 0,0:06:51.78,0:06:55.33,CN,,0000,0000,0000,,Нази ханшайымның ересектерді қалпына келтіру жүйесі
Dialogue: 0,0:06:57.42,0:06:59.51,CN,,0000,0000,0000,,Мен жіберген хат
Dialogue: 0,0:07:00.50,0:07:02.79,CN,,0000,0000,0000,,Киоканың Киотоға келуі
Dialogue: 0,0:07:04.11,0:07:10.25,CN,,0000,0000,0000,,Түпнұсқа мәтін бір ғана сөз тіркесі.
Dialogue: 0,0:07:19.37,0:07:21.58,CN,,0000,0000,0000,,Мичимаса Йошихиса
Dialogue: 0,0:07:22.42,0:07:23.89,CN,,0000,0000,0000,,Сіз оны санай аласыз.
Dialogue: 0,0:07:24.51,0:07:25.33,CN,,0000,0000,0000,,Келесі...
Dialogue: 0,0:07:26.97,0:07:29.58,CN,,0000,0000,0000,,Мен туралы не ойлайсың?
Dialogue: 0,0:07:30.30,0:07:32.09,CN,,0000,0000,0000,,Бұл ел халқының сапары.
Dialogue: 0,0:07:33.29,0:07:38.58,CN,,0000,0000,0000,,Осы кезде ойымның бәрі орындалмай, ғашық болып кездестік.
Dialogue: 0,0:07:43.38,0:07:45.74,CN,,0000,0000,0000,,Сіз Мичигадан келдіңіз
Dialogue: 0,0:07:46.16,0:07:49.52,CN,,0000,0000,0000,,Бүгін кешке мен не істейтінімді айта бастадым.
Dialogue: 0,0:07:50.63,0:07:52.10,CN,,0000,0000,0000,,Қайдасың, Жороно? Апачай?
Dialogue: 0,0:07:52.62,0:07:55.75,CN,,0000,0000,0000,,Сіз қате жібердіңіз бе? Сен айтпайсың...
Dialogue: 0,0:07:56.52,0:08:00.30,CN,,0000,0000,0000,,Мен кеткенде не істеуім керек?
Dialogue: 0,0:08:00.82,0:08:03.71,CN,,0000,0000,0000,,Бұлай етудің қажеті жоқ.
Dialogue: 0,0:08:05.20,0:08:08.06,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:08:08.80,0:08:11.96,CN,,0000,0000,0000,,Патша – қабілетсіз әйел және қызметші.
Dialogue: 0,0:08:13.75,0:08:16.58,CN,,0000,0000,0000,,Дегенмен, өлгеннен кейін өлтірілмейтіні менің кінәм.
Dialogue: 0,0:08:16.90,0:08:18.84,CN,,0000,0000,0000,,Мен сұхбатты жаңа ғана алдым.
Dialogue: 0,0:08:20.38,0:08:24.39,CN,,0000,0000,0000,,Алайда мұнда келудің қажеті жоқ.
Dialogue: 0,0:08:26.32,0:08:28.04,CN,,0000,0000,0000,,Мен бұл туралы естімедім.
Dialogue: 0,0:08:28.59,0:08:33.01,CN,,0000,0000,0000,,Алайда әкем Санджоин ауырды.
Dialogue: 0,0:08:33.63,0:08:38.06,CN,,0000,0000,0000,,Көп уақыттың ортасында жүргеніме көп болды.
Dialogue: 0,0:08:38.55,0:08:40.22,CN,,0000,0000,0000,,Сондықтан мен мұны сізге ыңғайлы болу үшін пайдаланғым келеді.
Dialogue: 0,0:08:41.36,0:08:44.14,CN,,0000,0000,0000,,Енді біз өзіміздің ұрпақтарымыз бен ұрпақтарымыз туралы әңгіме.
Dialogue: 0,0:08:44.59,0:08:47.30,CN,,0000,0000,0000,,Ата-ана мен ата-ана ашуланады.
Dialogue: 0,0:08:47.75,0:08:49.66,CN,,0000,0000,0000,,Біздің некеге тұруымыз мүмкін бе?
Dialogue: 0,0:08:51.33,0:08:54.56,CN,,0000,0000,0000,,Егер сіз әйелдің күйеуін жақсы көрсеңіз, сіз белгілі бір мәртебе аласыз.
Dialogue: 0,0:08:54.83,0:08:56.27,CN,,0000,0000,0000,,Әке мен шеше арасындағы делдал
Dialogue: 0,0:08:57.54,0:08:59.18,CN,,0000,0000,0000,,Гафусоунашо
Dialogue: 0,0:09:00.05,0:09:00.65,CN,,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:09:01.12,0:09:06.09,CN,,0000,0000,0000,,Мен біреудің келе жатқанын көргенде, мен оны көрмедім.
Dialogue: 0,0:09:07.91,0:09:09.50,CN,,0000,0000,0000,,Гном майы - жолдың ақиқаты ~
Dialogue: 0,0:09:09.74,0:09:12.78,CN,,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,0:09:12.78,0:09:15.98,CN,,0000,0000,0000,,Мен бұл туралы айтқым келмейді.
Dialogue: 0,0:09:17.67,0:09:20.56,CN,,0000,0000,0000,,Ережелерді сақтасаңыз, сіз…
Dialogue: 0,0:09:20.95,0:09:23.69,CN,,0000,0000,0000,,Ақ әулеттің беделі орнықты, мен оны ала алмаймын.
Dialogue: 0,0:09:25.73,0:09:28.48,CN,,0000,0000,0000,,Алайда, нәтижесінде риясыз.
Dialogue: 0,0:09:30.10,0:09:34.30,CN,,0000,0000,0000,,Мен дарынды адаммын.
Dialogue: 0,0:09:35.27,0:09:38.97,CN,,0000,0000,0000,,Мен, мен мұндамын, мен асығыспын т.б.
Dialogue: 0,0:09:40.59,0:09:42.01,CN,,0000,0000,0000,,Мәртебелі
Dialogue: 0,0:09:42.83,0:09:45.76,CN,,0000,0000,0000,,Белгілі бір кездесуге келгенде, нұр мен оңды жерге қамқорлық жасалады.
Dialogue: 0,0:09:46.88,0:09:47.92,CN,,0000,0000,0000,,Бір сөз бекітілген
Dialogue: 0,0:09:55.05,0:09:56.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:59.53,0:10:02.73,CN,,0000,0000,0000,,Жағымсыз ниет
Dialogue: 0,0:10:03.28,0:10:03.75,CN,,0000,0000,0000,,Ересек ханшайым
Dialogue: 0,0:10:04.30,0:10:06.39,CN,,0000,0000,0000,,Мен сені қолдаймын, Мичига
Dialogue: 0,0:10:06.98,0:10:09.34,CN,,0000,0000,0000,,Некеге қойылатын белгілі талаптар
Dialogue: 0,0:10:12.87,0:10:16.06,CN,,0000,0000,0000,,Алайда, егер сіз дарынды адам болсаңыз,
Dialogue: 0,0:10:16.85,0:10:21.57,CN,,0000,0000,0000,,Әкем үкімет пен губернатордан айырылғандықтан, менің отбасым да құлады.
Dialogue: 0,0:10:22.74,0:10:24.78,CN,,0000,0000,0000,,Құлап қалмаңыз...
Dialogue: 0,0:10:25.90,0:10:31.94,CN,,0000,0000,0000,,Басқа адамдарды пайдалана алмау
Dialogue: 0,0:10:33.85,0:10:36.63,CN,,0000,0000,0000,,Мен Тадано Ко Миоджо Даичимін, Күшті жеңу және т.б.
Dialogue: 0,0:10:37.53,0:10:38.57,CN,,0000,0000,0000,,Ересек Мичига
Dialogue: 0,0:10:39.67,0:10:40.57,CN,,0000,0000,0000,,Генерал-лейтенант
Dialogue: 0,0:10:42.30,0:10:45.38,CN,,0000,0000,0000,,Санджо-ин храмы туралы мәліметтер және сіз үйренген жол
Dialogue: 0,0:10:48.47,0:10:50.38,CN,,0000,0000,0000,,Басқа керемет найзағайлар
Dialogue: 0,0:10:50.68,0:10:55.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:55.90,0:10:59.48,CN,,0000,0000,0000,,Мен де осындай қылмысқа ұшырадым және жазадан босатылдым.
Dialogue: 0,0:10:59.80,0:11:02.71,CN,,0000,0000,0000,,Қазіргі уақытта заң талаптары жоқ.
Dialogue: 0,0:11:08.82,0:11:12.72,CN,,0000,0000,0000,,Мен дарынды адаммын.
Dialogue: 0,0:11:16.53,0:11:18.41,CN,,0000,0000,0000,,Айқын
Dialogue: 0,0:11:19.43,0:11:23.24,CN,,0000,0000,0000,,Біздің болашағымыз жарқын болуы мүмкін емес.
Dialogue: 0,0:11:25.80,0:11:27.09,CN,,0000,0000,0000,,Сәтті жүгіру керек.
Dialogue: 0,0:11:27.51,0:11:29.50,CN,,0000,0000,0000,,Мазалаудың қажеті жоқ
Dialogue: 0,0:11:29.97,0:11:31.59,CN,,0000,0000,0000,,Осы уақытта қашу керек.
Dialogue: 0,0:11:33.40,0:11:35.96,CN,,0000,0000,0000,,Капиталдың барлық ережелері
Dialogue: 0,0:11:42.00,0:11:44.19,CN,,0000,0000,0000,,Қай жерде жұмыс істеу керек
Dialogue: 0,0:11:44.71,0:11:48.12,CN,,0000,0000,0000,,Бұл туралы кім білуі керек?
Dialogue: 0,0:11:49.66,0:11:58.86,&,,0000,0000,0000,,Мұның бәрі өлім
Dialogue: 0,0:11:51.56,0:11:58.86,&,,0000,0000,0000,,...
Dialogue: 0,0:11:52.64,0:11:58.86,&,,0000,0000,0000,,...
Dialogue: 0,0:11:54.60,0:11:58.86,&,,0000,0000,0000,,Көрмейді немесе көрмейді
Dialogue: 0,0:11:59.67,0:12:04.15,CN,,0000,0000,0000,,Мен сені қазір көрмеймін.
Dialogue: 0,0:12:04.92,0:12:07.70,CN,,0000,0000,0000,,Менің шыққан күнім
Dialogue: 0,0:12:25.32,0:12:26.37,CN,,0000,0000,0000,,Бала
Dialogue: 0,0:12:27.41,0:12:28.16,CN,,0000,0000,0000,,Әке, ата-ана, ересек
Dialogue: 0,0:12:29.10,0:12:31.26,CN,,0000,0000,0000,,Ауруханаға алғаш бару
Dialogue: 0,0:12:32.70,0:12:33.30,CN,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:12:38.15,0:12:40.01,CN,,0000,0000,0000,,Бүгінгі кеште айдың түсі қандай?
Dialogue: 0,0:12:42.05,0:12:45.95,CN,,0000,0000,0000,,Әдемі, әдемі төрт сәуле
Dialogue: 0,0:12:46.37,0:12:47.49,CN,,0000,0000,0000,,Сіз мұны да жасай аласыз.
Dialogue: 0,0:12:48.78,0:12:51.89,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:52.44,0:12:53.98,CN,,0000,0000,0000,,Жарық сәулесі жарық сезіміне жетуге қабілетті.
Dialogue: 0,0:12:54.80,0:12:57.51,CN,,0000,0000,0000,,Модельді қоюды көру
Dialogue: 0,0:12:58.10,0:13:01.11,CN,,0000,0000,0000,,Тауарды дереу жеткізу
Dialogue: 0,0:13:03.52,0:13:08.12,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:09.39,0:13:10.83,CN,,0000,0000,0000,,Жылауға болмайды.
Dialogue: 0,0:13:12.30,0:13:17.29,CN,,0000,0000,0000,,Балам, сенің маған деген кекің бар.
Dialogue: 0,0:13:18.16,0:13:20.97,CN,,0000,0000,0000,,Алайда, ол пайда әкелмейді.
Dialogue: 0,0:13:21.67,0:13:24.92,CN,,0000,0000,0000,,Сіз ел патшасысыз, бірақ ол үлкен табыс сарайы.
Dialogue: 0,0:13:25.44,0:13:31.06,CN,,0000,0000,0000,,Мен өзімді-өзім ұстай алмаймын, денемді тастап кете алмаймын, мен орта жастағы адаммын, болашағым жарқын.
Dialogue: 0,0:13:31.71,0:13:34.24,CN,,0000,0000,0000,,Бұл әдемі әңгіме.
Dialogue: 0,0:13:34.24,0:13:37.08,CN,,0000,0000,0000,,Әкесі, әкесі, үлкені, істі қайта жіберудің қажеті жоқ.
Dialogue: 0,0:13:38.69,0:13:41.35,CN,,0000,0000,0000,,Бұл балалық
Dialogue: 0,0:13:43.71,0:13:48.41,CN,,0000,0000,0000,,Натен, атасы мен әжесінің дамуы
Dialogue: 0,0:13:50.60,0:13:53.73,CN,,0000,0000,0000,,Бұл менің миссиямды бастамас бұрын болды.
Dialogue: 0,0:13:54.90,0:13:58.50,CN,,0000,0000,0000,,Маған не болды?
Dialogue: 0,0:13:59.00,0:14:00.29,CN,,0000,0000,0000,,ренжіді
Dialogue: 0,0:14:01.08,0:14:04.64,CN,,0000,0000,0000,,Мен сенімен бірге болғаныма қуаныштымын.
Dialogue: 0,0:14:05.31,0:14:06.83,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:14:07.07,0:14:08.37,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:08.81,0:14:12.84,CN,,0000,0000,0000,,Кішкене ренжігенді естігенде, мен нәтижеге риза болдым.
Dialogue: 0,0:14:13.29,0:14:14.16,CN,,0000,0000,0000,,Қауіпті ме?
Dialogue: 0,0:14:15.55,0:14:17.34,CN,,0000,0000,0000,,Оқу материалдары толық.
Dialogue: 0,0:14:17.59,0:14:18.81,CN,,0000,0000,0000,,Бұл да дұрыс емес.
Dialogue: 0,0:14:19.92,0:14:21.49,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:25.47,0:14:26.78,CN,,0000,0000,0000,,Мен тікелей көремін
Dialogue: 0,0:14:27.48,0:14:31.53,CN,,0000,0000,0000,,Жарық болған адамның қараңғы өмірі – өзі
Dialogue: 0,0:14:32.82,0:14:39.11,CN,,0000,0000,0000,,Мен бақытты әйелмін.
Dialogue: 0,0:14:40.08,0:14:42.74,CN,,0000,0000,0000,,Ол кезде мен әлі пәк, тазамын.
Dialogue: 0,0:14:43.61,0:14:46.61,&,,0000,0000,0000,,Қалқымалы әлемнің айы
Dialogue: 0,0:14:43.61,0:14:46.61,,,0000,0000,0000,,Санджейн
Dialogue: 0,0:14:47.81,0:14:51.39,CN,,0000,0000,0000,,Назаренің әкесі император Санджо таққа отырған кезде.
Dialogue: 0,0:14:52.19,0:14:56.53,CN,,0000,0000,0000,,Таңдалған сарайда Киотодан кететін түні
Dialogue: 0,0:14:57.65,0:14:59.69,CN,,0000,0000,0000,,Баланың үлкендердің теріс қылықтары
Dialogue: 0,0:14:59.99,0:15:04.98,CN,,0000,0000,0000,,Түннің бір уағында, бірақ бар болса, мен кепілдік бере алмаймын.
Dialogue: 0,0:15:05.71,0:15:07.30,CN,,0000,0000,0000,,Сіз мені жақсы көре аласыз.
Dialogue: 0,0:15:07.64,0:15:09.78,CN,,0000,0000,0000,,Қауіпсіздік қызметіне кіргеннен кейін
Dialogue: 0,0:15:14.38,0:15:15.57,CN,,0000,0000,0000,,Нацунай
Dialogue: 0,0:15:18.18,0:15:20.74,CN,,0000,0000,0000,,Оған қараудың тағы бір жолы - біреуге тартылу...
Dialogue: 0,0:15:20.74,0:15:21.99,CN,,0000,0000,0000,,Шабуылдан келтірілген залал
Dialogue: 0,0:15:22.41,0:15:25.59,CN,,0000,0000,0000,,Мен сені тағайындадым және бүгін түнде сені қорғауға келдім.
Dialogue: 0,0:15:30.16,0:15:33.05,CN,,0000,0000,0000,,Кішкентай болсаң да, ханшайым келді.
Dialogue: 0,0:15:33.05,0:15:36.28,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:37.44,0:15:39.28,CN,,0000,0000,0000,,Сіз аяқтадыңыз
Dialogue: 0,0:15:39.56,0:15:41.55,CN,,0000,0000,0000,,Оучи-риге қайда баруға болады?
Dialogue: 0,0:15:43.04,0:15:45.62,CN,,0000,0000,0000,,Оң қол – Мәртебелі резиденциясы Сейрёден.
Dialogue: 0,0:15:46.07,0:15:50.32,CN,,0000,0000,0000,,Бұл Ана патшайымның тұратын жері.
Dialogue: 0,0:15:52.95,0:15:56.36,CN,,0000,0000,0000,,Менің естеліктерім жоқ
Dialogue: 0,0:15:57.55,0:15:59.19,CN,,0000,0000,0000,,Фузудың бөлінуі Киото
Dialogue: 0,0:15:59.84,0:16:02.10,CN,,0000,0000,0000,,Әкеден күтпеген жерден ажырасу
Dialogue: 0,0:16:06.30,0:16:07.49,CN,,0000,0000,0000,,Түсіріңіз
Dialogue: 0,0:16:09.38,0:16:10.72,CN,,0000,0000,0000,,Фукка Киотоның Фуккасы
Dialogue: 0,0:16:11.10,0:16:13.46,CN,,0000,0000,0000,,Біраз қуанып, көк шөп
Dialogue: 0,0:16:13.61,0:16:17.11,,,0000,0000,0000,,Көшеде киотолық еттің кекештенуі
Dialogue: 0,0:16:17.11,0:16:18.55,,,0000,0000,0000,,Көшеде тамақ жегім келмейді.
Dialogue: 0,0:16:15.35,0:16:17.93,CN,,0000,0000,0000,,Бұл маған ақыл айтқан кез.
Dialogue: 0,0:16:18.95,0:16:21.56,CN,,0000,0000,0000,,Балшық – Киотоның лайы.
Dialogue: 0,0:16:25.21,0:16:26.16,CN,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:16:26.16,0:16:28.74,CN,,0000,0000,0000,,Бойың ұзарғанда жылысың, жұмсақсың.
Dialogue: 0,0:16:29.79,0:16:30.73,,,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,0:16:31.38,0:16:33.29,,,0000,0000,0000,,Бұл саяхат
Dialogue: 0,0:16:29.74,0:16:32.89,CN,,0000,0000,0000,,Басқа біреу менің өмірім
Dialogue: 0,0:16:34.39,0:16:36.37,CN,,0000,0000,0000,,Сіздің фамилияңыз
Dialogue: 0,0:16:36.82,0:16:38.46,CN,,0000,0000,0000,,Мичимаса Фудзивара
Dialogue: 0,0:16:38.71,0:16:41.74,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:43.41,0:16:47.38,CN,,0000,0000,0000,,Мен Киотоға келдім.
Dialogue: 0,0:16:48.01,0:16:52.06,CN,,0000,0000,0000,,Сіздің мүсініңіз қазір көкте
Dialogue: 0,0:16:52.93,0:16:58.42,CN,,0000,0000,0000,,Жақсы, бұл ханшайымның қиялы туралы әңгіме.
Dialogue: 0,0:17:00.95,0:17:03.27,CN,,0000,0000,0000,,Императордың әйелі, заңсыз және өзімшіл.
Dialogue: 0,0:17:04.06,0:17:05.73,CN,,0000,0000,0000,,Миядзакидегі шектеулі өмір
Dialogue: 0,0:17:07.02,0:17:09.93,CN,,0000,0000,0000,,Мені түрмеден құтқарған кезде
Dialogue: 0,0:17:10.37,0:17:11.67,CN,,0000,0000,0000,,Масару Мичи
Dialogue: 0,0:17:13.01,0:17:15.32,CN,,0000,0000,0000,,Тағы бір образ – әңгімеде пайда болған ханзада.
Dialogue: 0,0:17:15.79,0:17:18.70,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:23.82,0:17:28.52,CN,,0000,0000,0000,,Ғибадатханада күнде жұмыс, өткен күннен естелік, т.б.
Dialogue: 0,0:17:30.06,0:17:31.40,CN,,0000,0000,0000,,Үш жылдан кейін
Dialogue: 0,0:17:32.72,0:17:37.12,CN,,0000,0000,0000,,Әке мен әкеден бас тарту
Dialogue: 0,0:17:38.58,0:17:42.19,CN,,0000,0000,0000,,Кайкё Фуку ыңғайлылығы Даояның жазбаларына келді
Dialogue: 0,0:17:43.43,0:17:45.10,CN,,0000,0000,0000,,Басқалар мені жазып алады
Dialogue: 0,0:17:45.92,0:17:48.20,CN,,0000,0000,0000,,Басқа адамдар маған сәйкес келеді.
Dialogue: 0,0:17:50.27,0:17:53.25,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:54.14,0:17:59.83,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:03.64,0:18:06.59,CN,,0000,0000,0000,,Бұл менің ұстанымым
Dialogue: 0,0:18:07.49,0:18:09.35,CN,,0000,0000,0000,,Әкенің орнын санаудан қалды
Dialogue: 0,0:18:09.80,0:18:12.04,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:16.49,0:18:19.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:20.19,0:18:24.86,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:26.28,0:18:29.71,CN,,0000,0000,0000,,Тек аспан ең шынайы жер, балалық арман күшті.
Dialogue: 0,0:18:31.47,0:18:33.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:34.46,0:18:37.24,CN,,0000,0000,0000,,Біздің ұрпақтарымыз бен ата-бабаларымыздың ұрпақтары қалай білім алғаны туралы әңгіме
Dialogue: 0,0:18:37.51,0:18:40.20,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:40.82,0:18:42.71,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:44.20,0:18:45.49,CN,,0000,0000,0000,,Егер сіз әйелдің күйеуін жақсы көрсеңіз, сіз белгілі бір мәртебе аласыз.
Dialogue: 0,0:18:45.91,0:18:49.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:50.64,0:18:52.25,CN,,0000,0000,0000,,Гафусоунашо
Dialogue: 0,0:18:53.02,0:18:53.59,CN,,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:18:54.21,0:18:59.19,CN,,0000,0000,0000,,Мен біреудің келе жатқанын көргенде, мен оларға әдейі жақындадым.
Dialogue: 0,0:19:00.80,0:19:02.39,CN,,0000,0000,0000,,~
Dialogue: 0,0:19:02.76,0:19:05.67,CN,,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,0:19:05.67,0:19:08.83,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:10.00,0:19:12.95,,,0000,0000,0000,,Ережелерді сақтасаңыз, сіз…
Dialogue: 0,0:19:13.40,0:19:16.34,,,0000,0000,0000,,...
Dialogue: 0,0:19:12.68,0:19:18.72,CN,,0000,0000,0000,,Бұл менің ниетім, маған деген махаббатым, отбасымның таланты одан да маңызды
Dialogue: 0,0:19:20.66,0:19:23.52,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:25.28,0:19:29.36,CN,,0000,0000,0000,,Мен дарынды адаммын.
Dialogue: 0,0:19:30.38,0:19:34.25,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:35.82,0:19:37.16,CN,,0000,0000,0000,,Мәртебелі
Dialogue: 0,0:19:38.01,0:19:40.99,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:41.64,0:19:43.30,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:44.20,0:19:45.81,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:46.36,0:19:50.83,CN,,0000,0000,0000,,Жарық, оңды жер, жеке қызметші, баламен неке құруға болады.
Dialogue: 0,0:19:52.85,0:19:56.97,CN,,0000,0000,0000,,Оны түсінуге болатыны анық.
Dialogue: 0,0:19:58.31,0:20:00.97,CN,,0000,0000,0000,,Басқалар...
Dialogue: 0,0:20:05.67,0:20:08.98,CN,,0000,0000,0000,,Мен дүниеге келгенде императордың әйелі болдым.
Dialogue: 0,0:20:09.85,0:20:14.20,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:16.01,0:20:18.57,CN,,0000,0000,0000,,Мен сені бұрын ешқашан кездестірген емеспін.
Dialogue: 0,0:20:19.76,0:20:21.60,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:26.25,0:20:30.75,CN,,0000,0000,0000,,Махаббатым кетті, Әкемнің жауапкершілігі менің жауапкершілігім.
Dialogue: 0,0:20:31.92,0:20:34.70,CN,,0000,0000,0000,,Менің презентациям кезінде
Dialogue: 0,0:20:35.50,0:20:37.43,CN,,0000,0000,0000,,Менің махаббатым сәтсіз болды.
Dialogue: 0,0:20:38.98,0:20:42.68,CN,,0000,0000,0000,,Балам, мен математикпін.
Dialogue: 0,0:20:43.95,0:20:46.28,CN,,0000,0000,0000,,Бейнелерді қолданбайтын адам
Dialogue: 0,0:20:46.78,0:20:50.58,CN,,0000,0000,0000,,Еңбек табысының қайта тірілуі және өлім.
Dialogue: 0,0:20:51.25,0:20:55.45,CN,,0000,0000,0000,,Құқық қорғаусыз әйелге ғашықпын.
Dialogue: 0,0:20:56.35,0:21:01.22,CN,,0000,0000,0000,,Бұдан былай менімен бірге көгілдір жарық көне Будда, өткен өзін-өзі айыптау.
Dialogue: 0,0:21:01.99,0:21:05.05,CN,,0000,0000,0000,,Дегенмен, дереу төлем алынбайды.
Dialogue: 0,0:21:05.37,0:21:09.10,CN,,0000,0000,0000,,Бақытсыз ұзақ өмір туралы әңгіме.
Dialogue: 0,0:21:11.58,0:21:20.75,&,,0000,0000,0000,,...
Dialogue: 0,0:21:12.79,0:21:20.75,&,,0000,0000,0000,,Дегенмен, ескі Будда жасыл жарықпен бірге жүрді
Dialogue: 0,0:21:14.12,0:21:20.75,&,,0000,0000,0000,,Жас және ұзақ мас
Dialogue: 0,0:21:15.75,0:21:20.75,&,,0000,0000,0000,,Бүгінгі түнгі ай ағыны
Dialogue: 0,0:21:19.81,0:21:24.61,CN,,0000,0000,0000,,Жарқын және жарқын өмір, тез және шаршаған, жас және бақытсыз, ұзақ өмір.
Dialogue: 0,0:21:24.93,0:21:27.02,CN,,0000,0000,0000,,Менің сізбен кездескім келмейді.
Dialogue: 0,0:21:27.52,0:21:29.65,CN,,0000,0000,0000,,Бұл кештен бері көп уақыт өтті
Dialogue: 0,0:21:31.77,0:21:36.71,CN,,0000,0000,0000,,Бұл әкем тақтан тайған кезде өлеңмен жазылған өлең.
Dialogue: 0,0:21:38.70,0:21:40.76,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:42.53,0:21:47.30,CN,,0000,0000,0000,,Әңгіме – әңгіменің соңы.
Dialogue: 0,0:21:48.99,0:21:52.94,CN,,0000,0000,0000,,Жұмыспен қамтуға қол жеткізілді.
Dialogue: 0,0:21:55.43,0:21:59.53,CN,,0000,0000,0000,,Әдеттегідей менің басымнан өткен оқиға, басқа естеліктер маған берілді.
Dialogue: 0,0:22:01.27,0:22:04.42,CN,,0000,0000,0000,,Дегенмен жас шынайы адам ұзақ өмір сүре алады.
Dialogue: 0,0:22:05.29,0:22:08.67,CN,,0000,0000,0000,,Әкесінің аты-жөні жиналыс хаттамасы.
Dialogue: 0,0:22:10.46,0:22:12.43,CN,,0000,0000,0000,,Кездесу түніндегі жарық ай
Dialogue: 0,0:22:14.44,0:22:16.80,CN,,0000,0000,0000,,Ауыр кездесу түніндегі жарық ай
Dialogue: 0,0:22:18.52,0:22:21.37,CN,,0000,0000,0000,,Тадаюки Рио Сайчидоның елес кездесуі
Dialogue: 0,0:22:23.01,0:22:24.48,CN,,0000,0000,0000,,Өзімшіл махаббат
Dialogue: 0,0:22:25.40,0:22:28.48,CN,,0000,0000,0000,,Никкода шомылғаннан кейін
Dialogue: 0,0:22:31.61,0:22:36.91,CN,,0000,0000,0000,,Мичига Мичига Вакараи тікелей эфирін қайта қарау
Dialogue: 0,0:22:37.26,0:22:42.18,CN,,0000,0000,0000,,Кейбір шарттар мен шарттар
Dialogue: 0,0:24:17.19,0:24:22.69,CN,,0000,0000,0000,,Кешкі күн, толқын тыныш, сұлу адамның көлеңкесі
Dialogue: 0,0:24:22.94,0:24:27.36,CN,,0000,0000,0000,,Теңіздің жанған жүрегі
Dialogue: 0,0:24:28.86,0:24:34.86,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory