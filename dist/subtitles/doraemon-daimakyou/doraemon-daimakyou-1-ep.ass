Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.13,0:00:17.14,Default,,0,0,0,,♪〜
Dialogue: 0,0:01:18.82,0:01:23.83,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:52.90,0:01:56.90,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:02:03.58,0:02:06.33,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:02:07.58,0:02:09.54,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:02:24.89,0:02:28.02,Default,,0,0,0,,Ертеде жер сыры мен сырына толы болған.
Dialogue: 0,0:02:34.07,0:02:36.57,Default,,0,0,0,,Шексіз джунгли
Dialogue: 0,0:02:36.99,0:02:40.95,Default,,0,0,0,,Қараңғы тереңдікте жабайы аңдар мен улы жыландар тістерін жалаңаштады.
Dialogue: 0,0:02:41.07,0:02:42.91,Default,,0,0,0,,Адамдарды алыс ұстау
Dialogue: 0,0:02:43.74,0:02:47.54,Default,,0,0,0,,Бұлттардың үстінде мұнартқан алып ақ тау
Dialogue: 0,0:02:47.66,0:02:49.83,Default,,0,0,0,,Мұзда қатқан өлім әлемі
Dialogue: 0,0:02:50.79,0:02:52.79,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:02:53.08,0:02:56.05,Default,,0,0,0,,Джунглилер мен шөлдер, полярлық аймақтар мен биік таулар
Dialogue: 0,0:02:56.17,0:03:00.38,Default,,0,0,0,,Жердің әр бұрышы, тіпті терең теңіз түбі де зерттелді.
Dialogue: 0,0:03:00.51,0:03:02.64,Default,,0,0,0,,Адамдар бармайтын жер жоқ!
Dialogue: 0,0:03:02.97,0:03:04.30,Default,,0,0,0,,Сондай-ақ шәкіртақымен оқитын оқушылардың үстемдік етуші мінез-құлқы бар,
Dialogue: 0,0:03:04.43,0:03:07.47,Default,,0,0,0,,Бізге жұмбақ немесе жұмбақ үзіндісі де қалмады.
Dialogue: 0,0:03:07.93,0:03:10.56,Default,,0,0,0,,Дұрыс! Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:03:10.69,0:03:13.02,Default,,0,0,0,,Маған ренжісең, қиын болар еді...
Dialogue: 0,0:03:13.15,0:03:15.15,Default,,0,0,0,,Мен мұны сізбен талқылағым келеді.
Dialogue: 0,0:03:15.27,0:03:16.69,Default,,0,0,0,,Мына кең жерде
Dialogue: 0,0:03:16.82,0:03:20.03,Default,,0,0,0,,Бір жерде әлі де жындық немесе зерттелмеген аймақтар қалса...
Dialogue: 0,0:03:20.15,0:03:22.91,Default,,0,0,0,,Дұрыс, мен мұғалімнен сұрадым.
Dialogue: 0,0:03:23.03,0:03:25.12,Default,,0,0,0,,Менің ойымша, Африка болашағы зор.
Dialogue: 0,0:03:25.83,0:03:27.08,Default,,0,0,0,,Африка?
Dialogue: 0,0:03:27.66,0:03:31.71,Default,,0,0,0,,Түсіндім! Бұрын ол тіпті қараңғы материк деп аталды.
Dialogue: 0,0:03:31.87,0:03:34.13,Default,,0,0,0,,Дұрыс, егер сіз Дораэмон құралдарын пайдалансаңыз.
Dialogue: 0,0:03:34.25,0:03:37.05,Default,,0,0,0,,Жындар патшалығын тауып, оған бару оңай емес пе?
Dialogue: 0,0:03:37.34,0:03:39.01,Default,,0,0,0,,Сәлем! Өтінемін, маған жақсылық жасаңыз
Dialogue: 0,0:03:39.26,0:03:41.47,Default,,0,0,0,,Бүгіннен бастап көктемгі демалыс!
Dialogue: 0,0:03:41.59,0:03:46.39,Default,,0,0,0,,Мен үлкен барлау сапарына баруды шештім!
Dialogue: 0,0:03:46.51,0:03:49.18,Default,,0,0,0,,Дораэмон қанша көп болса да, бұл мүмкін емес деп ойлаймын...
Dialogue: 0,0:03:49.31,0:03:51.14,Default,,0,0,0,,Сол үшін сұрадың!
Dialogue: 0,0:03:51.27,0:03:52.94,Default,,0,0,0,,Ой, түсіндім...
Dialogue: 0,0:03:53.02,0:03:54.15,Default,,0,0,0,,Мен мұны сізге қалдырамын!
Dialogue: 0,0:03:54.27,0:03:56.98,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:04:02.70,0:04:05.78,Default,,0,0,0,,Иә? Егер мұндай нәрселер ерікті түрде шешілсе, бұл мәселе болар еді.
Dialogue: 0,0:04:05.87,0:04:07.99,Default,,0,0,0,,Мен шешкен жоқпын.
Dialogue: 0,0:04:08.12,0:04:10.79,Default,,0,0,0,,Бірақ егер сіз Дораэмон болсаңыз, сіз бәрін жасай аласыз...
Dialogue: 0,0:04:10.91,0:04:12.71,Default,,0,0,0,,Жер енді әр бұрышта жабылған
Dialogue: 0,0:04:12.83,0:04:15.54,Default,,0,0,0,,Бұл мүмкін емес, өйткені мен барлық зерттеулерімді аяқтадым.
Dialogue: 0,0:04:15.67,0:04:17.34,Default,,0,0,0,,Мені бұлай жерге түсірме.
Dialogue: 0,0:04:17.46,0:04:19.42,Default,,0,0,0,,Эй, оны ізде.
Dialogue: 0,0:04:19.55,0:04:21.34,Default,,0,0,0,,Сіз өте табандысыз!
Dialogue: 0,0:04:21.46,0:04:26.14,Default,,0,0,0,,А... эй, біз Дораемон екеуміз жақын емеспіз бе?
Dialogue: 0,0:04:26.26,0:04:28.18,Default,,0,0,0,,Ах! Тамма Тамма!
Dialogue: 0,0:04:28.64,0:04:29.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:29.85,0:04:31.93,Default,,0,0,0,,Өткен жылы мен дораяки сатып алмақ болғанымда.
Dialogue: 0,0:04:32.06,0:04:33.64,Default,,0,0,0,,Бұл мен жоғалтқан 100 иен.
Dialogue: 0,0:04:33.77,0:04:35.40,Default,,0,0,0,,Мен баяғыда берілдім.
Dialogue: 0,0:04:35.52,0:04:36.48,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:04:36.60,0:04:39.36,Default,,0,0,0,,Жан-жақты ізденсең, жын-шайтан әлемінде де берілме
Dialogue: 0,0:04:39.48,0:04:41.40,Default,,0,0,0,,Бір жерде қалған болуы мүмкін.
Dialogue: 0,0:04:41.53,0:04:43.53,Default,,0,0,0,,Сәлем? Дораемон
Dialogue: 0,0:04:43.65,0:04:45.66,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:45.95,0:04:47.95,Default,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,0:04:48.24,0:04:50.79,Default,,0,0,0,,Жеке спутник!
Dialogue: 0,0:04:51.37,0:04:53.29,Default,,0,0,0,,Осы жерсерікті ұшырсақ
Dialogue: 0,0:04:53.41,0:04:56.29,Default,,0,0,0,,Олар сізге жерді айналып жүрген кездегі суреттерді жіберіп жатыр.
Dialogue: 0,0:04:56.42,0:04:59.59,Default,,0,0,0,,Иә іске қосудан 4 секунд бұрын
Dialogue: 0,0:04:59.71,0:05:04.84,Default,,0,0,0,,3 2 1 0 Өрт!
Dialogue: 0,0:05:06.18,0:05:07.43,Default,,0,0,0,,Уау (Нобита)
Dialogue: 0,0:05:21.61,0:05:26.86,Default,,0,0,0,,Эрм, ендік 1 градус 7 минут 15 секунд оңтүстік, бойлық 30 градус шығыс
Dialogue: 0,0:05:26.99,0:05:31.74,Default,,0,0,0,,Түсірілім Африканың үстінде 10 000 метр биіктікте басталады
Dialogue: 0,0:05:31.87,0:05:33.54,Default,,0,0,0,,А, мен жіберіп қойғанмын.
Dialogue: 0,0:05:33.66,0:05:37.67,Default,,0,0,0,,Қайсысы... ұқсас көрініс көпке дейін жалғасады
Dialogue: 0,0:05:38.46,0:05:39.75,Default,,0,0,0,,Ах, Конго өзені.
Dialogue: 0,0:05:39.88,0:05:43.59,Default,,0,0,0,,Жалпы ұзындығы 4640 км болатын ұзын өзен.
Dialogue: 0,0:05:43.80,0:05:46.55,Default,,0,0,0,,Фотосуреттерді қарасаңыз да, қанша күн кететінін білмейсіз.
Dialogue: 0,0:05:46.80,0:05:49.26,Default,,0,0,0,,Уайымдама, мен жалғыз істеймін.
Dialogue: 0,0:05:49.39,0:05:52.35,Default,,0,0,0,,Ешкім білмейтін сиқырлы жерді іздеу қызық емес пе?
Dialogue: 0,0:05:52.72,0:05:54.89,Default,,0,0,0,,Жарайды, тездетейік.
Dialogue: 0,0:05:55.02,0:05:56.02,Default,,0,0,0,,Иә
Dialogue: 0,0:05:56.52,0:05:57.77,Default,,0,0,0,,Мен мақсат алғым келеді
Dialogue: 0,0:05:57.89,0:06:01.23,Default,,0,0,0,,Ашылмаған көлдер, көне қирандылар, т.б.
Dialogue: 0,0:06:01.36,0:06:02.65,Default,,0,0,0,,Нобита (Нобита) Иә!
Dialogue: 0,0:06:02.77,0:06:03.98,Default,,0,0,0,,Мен саған тапсырма беремін.
Dialogue: 0,0:06:04.11,0:06:05.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:05.49,0:06:08.40,Default,,0,0,0,,Хм, мен бірдеңе істеуге тырысқанда, бұл бірден болады.
Dialogue: 0,0:06:17.37,0:06:18.62,Default,,0,0,0,,Ах
Dialogue: 0,0:06:21.33,0:06:24.00,Default,,0,0,0,,Бұл лас ит. Бұл қаңғыбас ит пе?
Dialogue: 0,0:06:27.34,0:06:30.34,Default,,0,0,0,,Маған қанша қарасаң да, үйде ит ұстай алмаймын.
Dialogue: 0,0:06:33.60,0:06:34.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:35.39,0:06:38.94,Default,,0,0,0,,Ааа... у... хмм!
Dialogue: 0,0:06:48.40,0:06:50.53,Default,,0,0,0,,Иә Қолдар Қолдар
Dialogue: 0,0:06:51.24,0:06:54.24,Default,,0,0,0,,Сонымен, иек иек, қара, иек иек.
Dialogue: 0,0:06:54.37,0:06:56.29,Default,,0,0,0,,Қарашы, енді иек иегін де жасай алмайсың.
Dialogue: 0,0:06:56.41,0:06:57.91,Default,,0,0,0,,Міне осылай, иек иек иек иек
Dialogue: 0,0:06:58.66,0:07:02.13,Default,,0,0,0,,Ей, сен сүймейтін итсің.
Dialogue: 0,0:07:02.21,0:07:03.67,Default,,0,0,0,,Міне, кеттік.
Dialogue: 0,0:07:05.34,0:07:07.71,Default,,0,0,0,,Кір, бірақ мұқият қарасаңыз
Dialogue: 0,0:07:07.84,0:07:09.67,Default,,0,0,0,,Қандай тапқыр ит.
Dialogue: 0,0:07:10.59,0:07:12.51,Default,,0,0,0,,Артымнан ерсең де жақсы емес.
Dialogue: 0,0:07:12.64,0:07:16.31,Default,,0,0,0,,Қайырымды адамнан оны алуын сұраңыз. Тамаша!
Dialogue: 0,0:07:20.44,0:07:21.39,Default,,0,0,0,,Ах
Dialogue: 0,0:07:22.48,0:07:26.02,Default,,0,0,0,,А, мінеки! Уәде басқа емес пе?
Dialogue: 0,0:07:26.15,0:07:27.15,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:07:27.61,0:07:30.57,Default,,0,0,0,,Негізі менің де итім болғанын қалаймын.
Dialogue: 0,0:07:30.70,0:07:33.20,Default,,0,0,0,,Менің анам міндетті түрде қарсы.
Dialogue: 0,0:07:33.28,0:07:34.53,Default,,0,0,0,,Түсініңіз, солай ма?
Dialogue: 0,0:07:34.62,0:07:36.28,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:07:37.08,0:07:40.16,Default,,0,0,0,,А, жарайды, жарайды, сен жақсы тыңдаушысың.
Dialogue: 0,0:07:43.50,0:07:45.54,Default,,0,0,0,,Дәл қазір, уау, мен біраз жинадым.
Dialogue: 0,0:07:45.67,0:07:47.25,Default,,0,0,0,,Себебі мен қарап отыра алмаймын.
Dialogue: 0,0:07:47.38,0:07:49.34,Default,,0,0,0,,Біз сым беруді біраз уақытқа тоқтаттық.
Dialogue: 0,0:07:49.46,0:07:52.68,Default,,0,0,0,,Эй, Африкада неше фотосурет көріп тұрсың?
Dialogue: 0,0:07:52.80,0:07:54.05,Default,,0,0,0,,Сондықтан мен саған айттым!
Dialogue: 0,0:07:54.18,0:07:56.80,Default,,0,0,0,,Конго өзенінің өзі 7,05 миллион шаршы шақырымды құрайды
Dialogue: 0,0:07:57.18,0:08:00.06,Default,,0,0,0,,Бір фотосурет шамамен 3 шаршы километрді алады.
Dialogue: 0,0:08:00.18,0:08:02.69,Default,,0,0,0,,Шамамен айтқанда... 2,35 миллион дана.
Dialogue: 0,0:08:03.06,0:08:06.23,Default,,0,0,0,,200… 30… 50 000… дана?
Dialogue: 0,0:08:07.11,0:08:08.86,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:08:08.98,0:08:10.03,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:08:12.70,0:08:13.82,Default,,0,0,0,,Сіз...
Dialogue: 0,0:08:13.95,0:08:14.99,Default,,0,0,0,,Не болды? бұл ит
Dialogue: 0,0:08:16.03,0:08:18.33,Default,,0,0,0,,Мен көп айтсам да, жақсы емес.
Dialogue: 0,0:08:18.45,0:08:20.08,Default,,0,0,0,,Анам мені тапса...
Dialogue: 0,0:08:20.20,0:08:21.08,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:08:21.20,0:08:22.75,Default,,0,0,0,,Ноби-чан! (Нобита/Дораемон) Уау!
Dialogue: 0,0:08:22.87,0:08:25.50,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек? Шкаф шкафы
Dialogue: 0,0:08:25.67,0:08:27.42,Default,,0,0,0,,Дауысыңызды көтермеңіз
Dialogue: 0,0:08:27.96,0:08:29.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:31.71,0:08:34.30,Default,,0,0,0,,Кешіріңіз, мен сізге рұқсатсыз ердім.
Dialogue: 0,0:08:34.43,0:08:35.59,Default,,0,0,0,,Мен сені бірден қуып жіберемін.
Dialogue: 0,0:08:35.89,0:08:38.01,Default,,0,0,0,,Түсінбейтін нәрселерді айтпа
Dialogue: 0,0:08:38.14,0:08:40.01,Default,,0,0,0,,Әй, айтпақшы, менің сөмкемді білмейсің бе?
Dialogue: 0,0:08:40.22,0:08:43.48,Default,,0,0,0,,Не? Мен анамның сөмкесін білмеймін.
Dialogue: 0,0:08:43.68,0:08:46.19,Default,,0,0,0,,Мен оны банктен үйге келе жатқанда тастадым.
Dialogue: 0,0:08:46.31,0:08:48.27,Default,,0,0,0,,Оның ішінде есеп кітапшасы мен мөрі болды.
Dialogue: 0,0:08:48.52,0:08:50.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:50.69,0:08:54.03,Default,,0,0,0,,Әй, білесің бе, мен мұнда құладым.
Dialogue: 0,0:08:54.11,0:08:57.87,Default,,0,0,0,,Иә... Міне, осы жерде, мм...
Dialogue: 0,0:08:58.24,0:09:00.91,Default,,0,0,0,,О? О, мінекей!
Dialogue: 0,0:09:01.04,0:09:05.12,Default,,0,0,0,,Жарайсыңдар рахмет рахмет
Dialogue: 0,0:09:05.25,0:09:07.29,Default,,0,0,0,,Өтінемін, бұл туралы әкеңе айтпа.
Dialogue: 0,0:09:07.42,0:09:10.80,Default,,0,0,0,,Жарайды, мама, оның орнына мені тыңда.
Dialogue: 0,0:09:10.92,0:09:13.17,Default,,0,0,0,,Бұл ит бейшара қаңғыбас ит.
Dialogue: 0,0:09:13.30,0:09:15.55,Default,,0,0,0,,Сіз оны үйде қалдыра аласыз, солай ма? Эй, эй?
Dialogue: 0,0:09:15.93,0:09:18.05,Default,,0,0,0,,Хмм, менің таңдауым жоқ. Жақсы.
Dialogue: 0,0:09:18.26,0:09:20.30,Default,,0,0,0,,Ия, иә, иә! Жақсы Жақсы
Dialogue: 0,0:09:20.43,0:09:21.64,Default,,0,0,0,,Ия, иә
Dialogue: 0,0:09:21.76,0:09:23.56,Default,,0,0,0,,Бұл жақсы. (Нобита) Ой, бұл арман шығар.
Dialogue: 0,0:09:23.68,0:09:25.94,Default,,0,0,0,,Сіз итті ашық ұстай аласыз ба?
Dialogue: 0,0:09:27.10,0:09:28.65,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:29.40,0:09:32.44,Default,,0,0,0,,Қабырғаға орнатылған ит үйі!
Dialogue: 0,0:09:32.57,0:09:34.69,Default,,0,0,0,,Бұл сенің үйің.
Dialogue: 0,0:09:36.15,0:09:37.07,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:09:37.74,0:09:41.28,Default,,0,0,0,,Мен үнемі аш болдым, сондықтан мен оны Пеко деп атадым.
Dialogue: 0,0:09:41.41,0:09:43.41,Default,,0,0,0,,Дегенмен, ол өте лас.
Dialogue: 0,0:09:43.54,0:09:45.50,Default,,0,0,0,,Иә, мен оны жуамын.
Dialogue: 0,0:09:46.46,0:09:49.38,Default,,0,0,0,,Скраб...
Dialogue: 0,0:09:50.13,0:09:51.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:51.54,0:09:52.63,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:09:56.63,0:09:58.13,Default,,0,0,0,,Анашым! Қазір сондай әдемі
Dialogue: 0,0:09:58.26,0:10:00.34,Default,,0,0,0,,Мен үйдемін (Нобита) Ах, үйге қош келдіңіз.
Dialogue: 0,0:10:00.47,0:10:02.47,Default,,0,0,0,,Мен бүгіннен бастап бұл итті үйде ұстаймын.
Dialogue: 0,0:10:02.72,0:10:04.97,Default,,0,0,0,,Анам мені жақсы кешірді.
Dialogue: 0,0:10:05.77,0:10:07.77,Default,,0,0,0,,Жарайды, бейшара қаңғыбас ит.
Dialogue: 0,0:10:07.89,0:10:09.40,Default,,0,0,0,,Оны назардан тыс қалдыруға болмайды, солай ма?
Dialogue: 0,0:10:09.48,0:10:11.77,Default,,0,0,0,,Жақсы, мен түсінемін, егер сіз онымен жақсы болсаңыз.
Dialogue: 0,0:10:11.90,0:10:15.99,Default,,0,0,0,,Уфуфу Оның үстіне Нобита мен оның достарының қуанышы түкке тұрғысыз.
Dialogue: 0,0:10:16.07,0:10:18.53,Default,,0,0,0,,Уфуфу... (Нобита) Хэхуфу өте сүйкімді~
Dialogue: 0,0:10:33.13,0:10:38.38,Default,,0,0,0,,Тереңде ертеде гүлденген күн мен ай қаласы жатыр.
Dialogue: 0,0:10:38.47,0:10:40.30,Default,,0,0,0,,Жолда қандай қиындықтар болса да
Dialogue: 0,0:10:40.43,0:10:44.31,Default,,0,0,0,,Біз, Нобита экспедициясы, аман қалу үшін бірге жұмыс істейміз.
Dialogue: 0,0:10:44.43,0:10:45.31,Default,,0,0,0,,Оу!
Dialogue: 0,0:10:49.14,0:10:51.69,Default,,0,0,0,,Бұл терең, терең джунгли. Бұл қорқынышты.
Dialogue: 0,0:10:51.81,0:10:54.36,Default,,0,0,0,,Біз таңғажайып құбыжықтарды көретін сияқтымыз.
Dialogue: 0,0:10:54.73,0:10:57.90,Default,,0,0,0,,Эй, маған айтшы, кез келген нәрсемен шықсын.
Dialogue: 0,0:11:00.70,0:11:01.61,Default,,0,0,0,,Не, не?
Dialogue: 0,0:11:01.74,0:11:02.74,Default,,0,0,0,,Уау... бұл қорқынышты
Dialogue: 0,0:11:04.12,0:11:07.20,Default,,0,0,0,,(Алып жануардың ырылдауы)
Dialogue: 0,0:11:08.66,0:11:11.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:11.33,0:11:12.71,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:11:13.17,0:11:14.67,Default,,0,0,0,,Анашым! (Сунео) Анашым!
Dialogue: 0,0:11:15.00,0:11:16.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:20.67,0:11:25.18,Default,,0,0,0,,Ммм... Ах!
Dialogue: 0,0:11:27.06,0:11:30.60,Default,,0,0,0,,Барлығыңызға Африка жеріне қош келдіңіздер.
Dialogue: 0,0:11:30.73,0:11:32.19,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:11:32.31,0:11:34.61,Default,,0,0,0,,Бұл роботқа ұқсайды.
Dialogue: 0,0:11:42.03,0:11:45.12,Default,,0,0,0,,Бұл ойын-сауық саябағы емес пе?
Dialogue: 0,0:11:50.41,0:11:55.08,Default,,0,0,0,,Зерттелмеген атмосфераға толы Толқынға толы Ең алдымен қауіпсіздік
Dialogue: 0,0:11:55.21,0:11:57.71,Default,,0,0,0,,Баладан қартқа дейін қызық
Dialogue: 0,0:11:57.84,0:12:02.59,Default,,0,0,0,,Africaland шытырман оқиғалы ойын-сауық саябағы осында
Dialogue: 0,0:12:06.64,0:12:08.64,Default,,0,0,0,,Эй, Нобита, бұл жын патшалығы ма?
Dialogue: 0,0:12:08.89,0:12:12.10,Default,,0,0,0,,Әй, эй, сәл күте тұршы, мен қай жерде қателестім?
Dialogue: 0,0:12:12.39,0:12:15.27,Default,,0,0,0,,Сен ренжіттің, бізді алдадың.
Dialogue: 0,0:12:15.40,0:12:17.65,Default,,0,0,0,,Бұл жомарт рахмет... Тоқта, мынау!
Dialogue: 0,0:12:17.77,0:12:18.82,Default,,0,0,0,,Мен сені алдамадым.
Dialogue: 0,0:12:18.94,0:12:19.94,Default,,0,0,0,,Мен сені алдамаған болсам
Dialogue: 0,0:12:20.07,0:12:24.03,Default,,0,0,0,,Ауырады, ауырады, ауырады, ауырады ...
Dialogue: 0,0:12:24.53,0:12:27.53,Default,,0,0,0,,Аа... Бұл не арман?
Dialogue: 0,0:12:28.37,0:12:29.29,Default,,0,0,0,,Ахх...
Dialogue: 0,0:12:30.70,0:12:32.46,Default,,0,0,0,,Мен оны таба аламын ба?
Dialogue: 0,0:12:43.88,0:12:46.51,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:12:52.02,0:12:53.60,Default,,0,0,0,,Жүр, таңғы ас ішейік.
Dialogue: 0,0:12:53.73,0:12:56.40,Default,,0,0,0,,Иә! Хехехе
Dialogue: 0,0:12:56.52,0:12:58.31,Default,,0,0,0,,Күріш күріш
Dialogue: 0,0:13:01.82,0:13:03.53,Default,,0,0,0,,Пеко, асхана осылай.
Dialogue: 0,0:13:06.78,0:13:07.78,Default,,0,0,0,,О...
Dialogue: 0,0:13:07.91,0:13:09.66,Default,,0,0,0,,Әй, мынау әдепті ит екен.
Dialogue: 0,0:13:09.78,0:13:13.08,Default,,0,0,0,,Қарашы, Нобита-кун да жуынуы керек. Ұялмайсың ба?
Dialogue: 0,0:13:16.46,0:13:19.92,Default,,0,0,0,,Мен қиындыққа тап болдым. Көктемгі демалыс, мен күнде үйді аралап жүрмін.
Dialogue: 0,0:13:20.04,0:13:22.09,Default,,0,0,0,,Оқудан басқа амалың жоқ.
Dialogue: 0,0:13:22.42,0:13:23.46,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:23.59,0:13:26.55,Default,,0,0,0,,Неге таза тамақ ішпейсің, Пекодан үлгі алмайсың?
Dialogue: 0,0:13:26.68,0:13:27.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.89,0:13:32.43,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:35.81,0:13:38.44,Default,,0,0,0,,Хм, фотода саванна көріне бастаған сияқты.
Dialogue: 0,0:13:38.56,0:13:40.15,Default,,0,0,0,,Саванна дегеніміз не?
Dialogue: 0,0:13:40.27,0:13:43.86,Default,,0,0,0,,Бұл жайлаулы аймақ. Бұл Кения мен Шығыс Африкада жиі кездеседі.
Dialogue: 0,0:13:43.98,0:13:45.28,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:45.57,0:13:47.32,Default,,0,0,0,,Ей, аң бар ғой, солай ма?
Dialogue: 0,0:13:47.45,0:13:48.78,Default,,0,0,0,,Ол жақында суретте пайда болады.
Dialogue: 0,0:13:48.91,0:13:50.78,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:13:51.49,0:13:53.24,Default,,0,0,0,,Бұршақ тәрізді бұл не?
Dialogue: 0,0:13:53.58,0:13:55.79,Default,,0,0,0,,Жарайды, оны созайық.
Dialogue: 0,0:13:57.12,0:13:59.83,Default,,0,0,0,,Не? Бұл піл. Бұл пілдер үйірі.
Dialogue: 0,0:13:59.96,0:14:02.25,Default,,0,0,0,,Хмм, жираф.
Dialogue: 0,0:14:02.34,0:14:04.26,Default,,0,0,0,,Хэхе... Зебра
Dialogue: 0,0:14:04.76,0:14:06.51,Default,,0,0,0,,А, мен білемін, бұл арыстан.
Dialogue: 0,0:14:06.92,0:14:08.30,Default,,0,0,0,,Мен қазірдің өзінде қанша көрдім деп ойлаймын.
Dialogue: 0,0:14:08.43,0:14:10.47,Default,,0,0,0,,Менің ойымша, бұл үштен бір бөлігі ғана.
Dialogue: 0,0:14:10.59,0:14:12.47,Default,,0,0,0,,Сабырлықпен іздеу керек.
Dialogue: 0,0:14:13.01,0:14:15.27,Default,,0,0,0,,Иә, мен Пеконы серуендетуім керек.
Dialogue: 0,0:14:15.39,0:14:17.94,Default,,0,0,0,,Иә, дұрыс, жүр Пеко (Пеконың айқайы)
Dialogue: 0,0:14:18.06,0:14:20.65,Default,,0,0,0,,Не? Бөлмеңіздегі фотоларды қарап жатырсыз ба?
Dialogue: 0,0:14:20.77,0:14:22.44,Default,,0,0,0,,Олай деме, кеттік.
Dialogue: 0,0:14:22.73,0:14:25.40,Default,,0,0,0,,Мен суретке түсуді ұнататын итті ешқашан көрген емеспін.
Dialogue: 0,0:14:30.99,0:14:32.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:37.75,0:14:42.25,Default,,0,0,0,,(Тофу сатылымындағы керней дыбысы)
Dialogue: 0,0:14:43.92,0:14:45.25,Default,,0,0,0,,А, кеш болды.
Dialogue: 0,0:14:45.71,0:14:48.30,Default,,0,0,0,,Мені тағы да фотозерттеу мазалап жүр.
Dialogue: 0,0:14:50.05,0:14:51.80,Default,,0,0,0,,Иә? о? сурет?
Dialogue: 0,0:14:51.93,0:14:54.10,Default,,0,0,0,,Уау! (Нобита) Ах!
Dialogue: 0,0:14:54.22,0:14:56.39,Default,,0,0,0,,Мен сымды жіберуді тоқтатуым керек еді.
Dialogue: 0,0:14:56.52,0:14:57.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.27,0:15:01.31,Default,,0,0,0,,Не, Пеко ойын ойнап тұрды ма?
Dialogue: 0,0:15:03.65,0:15:04.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:05.23,0:15:06.90,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:07.53,0:15:10.40,Default,,0,0,0,,Суреттегі мына ақ нәрсе не?
Dialogue: 0,0:15:10.53,0:15:12.36,Default,,0,0,0,,Хмм, үлкейтейік.
Dialogue: 0,0:15:12.49,0:15:13.32,Default,,0,0,0,,Иә
Dialogue: 0,0:15:23.29,0:15:24.17,Default,,0,0,0,,Бұл жартас па?
Dialogue: 0,0:15:24.29,0:15:27.05,Default,,0,0,0,,Жоқ, бұл сөзсіз жасанды.
Dialogue: 0,0:15:27.17,0:15:28.21,Default,,0,0,0,,Жарайды, күте тұрыңыз.
Dialogue: 0,0:15:28.55,0:15:32.26,Default,,0,0,0,,Алты жақты камера!
Dialogue: 0,0:15:32.38,0:15:33.43,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:15:36.26,0:15:39.56,Default,,0,0,0,,Мм... (2 адам) Иә? Ах!
Dialogue: 0,0:15:40.89,0:15:42.02,Default,,0,0,0,,Бұл тас мүсін.
Dialogue: 0,0:15:42.14,0:15:44.44,Default,,0,0,0,,Оның үстіне осындай шалғай ауданда
Dialogue: 0,0:15:44.56,0:15:45.56,Default,,0,0,0,,Декисугиге көрсетейік
Dialogue: 0,0:15:45.69,0:15:47.69,Default,,0,0,0,,Ол білімді, иә.
Dialogue: 0,0:15:49.86,0:15:52.11,Default,,0,0,0,,Аа... мұндайды бірінші рет көріп тұрмын.
Dialogue: 0,0:15:52.66,0:15:53.82,Default,,0,0,0,,Африканың қай бөлігі?
Dialogue: 0,0:15:53.95,0:15:57.45,Default,,0,0,0,,Конго ойпатының тереңдігі Заир, Шығыс Африка
Dialogue: 0,0:15:57.58,0:15:59.62,Default,,0,0,0,,Джунгли бүкіл жол бойына таралатын аймақ
Dialogue: 0,0:16:01.04,0:16:03.58,Default,,0,0,0,,Ауыр темекі шегетін орман
Dialogue: 0,0:16:04.42,0:16:05.88,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:16:06.00,0:16:08.05,Default,,0,0,0,,«Темекіқұмарлар орманы» дегенді білдіреді.
Dialogue: 0,0:16:08.75,0:16:11.47,Default,,0,0,0,,NASA Look, Ұлттық аэронавтика және ғарыш басқармасы
Dialogue: 0,0:16:11.59,0:16:12.51,Default,,0,0,0,,Мен оны осылай атадым.
Dialogue: 0,0:16:13.59,0:16:15.72,Default,,0,0,0,,Конго джунглиінің бөлігі
Dialogue: 0,0:16:15.84,0:16:19.52,Default,,0,0,0,,Әрқашан бұлтты, сондықтан спутниктік фотосуреттер түсіре алмайсыз.
Dialogue: 0,0:16:20.31,0:16:21.43,Default,,0,0,0,,Сондықтан бұл тозақ жер
Dialogue: 0,0:16:21.56,0:16:23.69,Default,,0,0,0,,Оны енді табу мүмкін емес дейді.
Dialogue: 0,0:16:24.06,0:16:27.90,Default,,0,0,0,,Менің жер серігім бұлттармен жабылған жоқ.
Dialogue: 0,0:16:28.07,0:16:31.36,Default,,0,0,0,,Дұрыс, ақыры жындар патшалығын таптық.
Dialogue: 0,0:16:31.65,0:16:33.36,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:16:33.49,0:16:35.24,Default,,0,0,0,,Ия, иә, иә, тозақ!
Dialogue: 0,0:16:35.36,0:16:36.87,Default,,0,0,0,,Банзай Банзай
Dialogue: 0,0:16:37.53,0:16:40.49,Default,,0,0,0,,Ой, ой, ой, ой!
Dialogue: 0,0:16:49.84,0:16:52.80,Default,,0,0,0,,(Пеко қабығы)
Dialogue: 0,0:16:53.05,0:16:56.64,Default,,0,0,0,,Хмм, мен бірден барамын, мені асықпа.
Dialogue: 0,0:16:58.89,0:17:00.22,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:17:00.35,0:17:02.77,Default,,0,0,0,,Нобита, сен оқуың керек.
Dialogue: 0,0:17:03.77,0:17:05.19,Default,,0,0,0,,Не? сол қалпақ
Dialogue: 0,0:17:05.31,0:17:07.10,Default,,0,0,0,,Барлау үшін көңіл-күйге түсу керек.
Dialogue: 0,0:17:07.23,0:17:08.27,Default,,0,0,0,,Мен түсіндім, хехе, солай ма?
Dialogue: 0,0:17:08.40,0:17:10.27,Default,,0,0,0,,Иә (Пеконың үруі)
Dialogue: 0,0:17:12.53,0:17:14.40,Default,,0,0,0,,Экспедиция тобының ретке келтіру нөмірі!
Dialogue: 0,0:17:14.74,0:17:15.65,Default,,0,0,0,,1 (Нобита) 2
Dialogue: 0,0:17:15.78,0:17:16.78,Default,,0,0,0,,３ ４
Dialogue: 0,0:17:16.91,0:17:19.62,Default,,0,0,0,,5 Иә? Ах...
Dialogue: 0,0:17:20.37,0:17:21.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:21.95,0:17:24.08,Default,,0,0,0,,5… 5? Сіз төртеусіз бе?
Dialogue: 0,0:17:24.20,0:17:25.66,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:17:25.79,0:17:28.38,Default,,0,0,0,,Мен біреудің 5 дегеніне сенімдімін.
Dialogue: 0,0:17:28.50,0:17:29.79,Default,,0,0,0,,Мен мұнда алғаш ретмін, бірақ күтпеген жерден тарлық сезімі мүлде жоқ қой, иә?
Dialogue: 0,0:17:30.25,0:17:33.05,Default,,0,0,0,,Ах, Джан, өзіңді ұмытып бара жатырсың.
Dialogue: 0,0:17:33.17,0:17:35.76,Default,,0,0,0,,А, мен түсіндім. Мені қоссаңыз 5 адам болады.
Dialogue: 0,0:17:35.97,0:17:38.59,Default,,0,0,0,,Дұрыс, Джиан осылай деді.
Dialogue: 0,0:17:40.60,0:17:44.27,Default,,0,0,0,,Баратын жеріңізге кенеттен барлық жерде есікпен жету қызықсыз.
Dialogue: 0,0:17:44.39,0:17:46.69,Default,,0,0,0,,Нысанадан 100 км жүрейік
Dialogue: 0,0:17:46.89,0:17:48.98,Default,,0,0,0,,Иә, дұрыс, аяқпен жүрейік.
Dialogue: 0,0:17:49.10,0:17:50.65,Default,,0,0,0,,Таксоптерді қолданбаңыз
Dialogue: 0,0:17:51.15,0:17:53.98,Default,,0,0,0,,Әйтпесе, оны барлау деп атамас еді.
Dialogue: 0,0:17:54.11,0:17:56.20,Default,,0,0,0,,Әй, бәрі, уайымдама.
Dialogue: 0,0:17:56.32,0:17:59.03,Default,,0,0,0,,Ей, бұл ең қауіпті деген адам...
Dialogue: 0,0:18:05.58,0:18:06.83,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:15.13,0:18:19.76,Default,,0,0,0,,Ешкім аяқ баспаған ұлы жындар әлемі.
Dialogue: 0,0:18:20.14,0:18:22.72,Default,,0,0,0,,Бұл... хмм, бұл Африка...
Dialogue: 0,0:18:23.39,0:18:24.68,Default,,0,0,0,,Ал оны алдымен адам алған, иә?
Dialogue: 0,0:18:31.36,0:18:33.73,Default,,0,0,0,,Қош бол, өркениетті қоғам
Dialogue: 0,0:18:33.86,0:18:36.03,Default,,0,0,0,,Қаламен қоштасу
Dialogue: 0,0:18:58.17,0:19:00.55,Default,,0,0,0,,Нобита Иә, Шизука-чан
Dialogue: 0,0:19:00.68,0:19:02.47,Default,,0,0,0,,Дова~ (Сунео) Бұл~
Dialogue: 0,0:19:02.59,0:19:04.18,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:19:08.35,0:19:10.31,Default,,0,0,0,,Уау, бұл керемет...
Dialogue: 0,0:19:10.44,0:19:15.98,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:19:16.44,0:19:19.19,Default,,0,0,0,,Африканың осы континентінің орталығында дерлік.
Dialogue: 0,0:19:19.32,0:19:22.87,Default,,0,0,0,,Заир Республикасы бар, оның ауданы Жапониядан алты жарым есе үлкен.
Dialogue: 0,0:19:23.24,0:19:25.28,Default,,0,0,0,,Оңтүстік Конго ойпатының бұрышы
Dialogue: 0,0:19:25.41,0:19:29.41,Default,,0,0,0,,Бұл «Темекіқұмарлар орманы» атты жұмбақ аймақ
Dialogue: 0,0:19:29.54,0:19:33.83,Default,,0,0,0,,Ежелден бері сейілмеген тұман теңізінің түбінде.
Dialogue: 0,0:19:34.17,0:19:36.63,Default,,0,0,0,,Жұмбақ алып мүсін бар.
Dialogue: 0,0:19:39.13,0:19:42.76,Default,,0,0,0,,Соншалықты үлкен нәрсені кім салды деп ойлаймын...
Dialogue: 0,0:19:42.89,0:19:45.47,Default,,0,0,0,,Менің ойымша, сен ол жерге жұмбақ шешуге барасың.
Dialogue: 0,0:19:45.60,0:19:46.76,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:19:46.85,0:19:48.72,Default,,0,0,0,,солтүстікке тура 100 км
Dialogue: 0,0:19:48.85,0:19:51.56,Default,,0,0,0,,Бізді жұмбақ алып піл күтіп тұр.
Dialogue: 0,0:19:51.69,0:19:54.69,Default,,0,0,0,,Әй, ол жерде қазына бар шығар?
Dialogue: 0,0:19:54.77,0:19:58.03,Default,,0,0,0,,Бізде қызықты шытырман оқиға болғанша маңызды емес
Dialogue: 0,0:19:58.15,0:19:58.98,Default,,0,0,0,,Қарсылық жоқ
Dialogue: 0,0:19:59.07,0:20:00.36,Default,,0,0,0,,Дәл Шидзука-чан айтқандай!
Dialogue: 0,0:20:00.49,0:20:03.53,Default,,0,0,0,,Сунео, қазынаны болмашы дүниелер деп санама.
Dialogue: 0,0:20:03.66,0:20:07.16,Default,,0,0,0,,Біздің мақсатымыз - қызықты шытырман оқиға.
Dialogue: 0,0:20:07.28,0:20:10.16,Default,,0,0,0,,Бұдан былай сансыз қауіптерге қарсы күресуге тура келеді.
Dialogue: 0,0:20:10.29,0:20:12.08,Default,,0,0,0,,Арыстан Қолтырауын Барыс
Dialogue: 0,0:20:12.21,0:20:14.37,Default,,0,0,0,,Горилла жолбарыс ақ аю (Сунео) Иә?
Dialogue: 0,0:20:14.50,0:20:16.79,Default,,0,0,0,,Африкада жолбарыстар мен ақ аюлар бар ма?
Dialogue: 0,0:20:16.92,0:20:18.88,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:20:19.34,0:20:21.76,Default,,0,0,0,,Әй, сирек гүл.
Dialogue: 0,0:20:22.22,0:20:24.38,Default,,0,0,0,,Ах, окапи.
Dialogue: 0,0:20:24.55,0:20:26.76,Default,,0,0,0,,Уау Вервет маймыл
Dialogue: 0,0:20:26.85,0:20:29.77,Default,,0,0,0,,Аа, папуа мүйізі бар.
Dialogue: 0,0:20:29.89,0:20:31.43,Default,,0,0,0,,А, бұл қызық.
Dialogue: 0,0:20:31.56,0:20:34.90,Default,,0,0,0,,Осылай жүрсең, қанша күн жүрсең де жалықпайсың.
Dialogue: 0,0:20:36.15,0:20:38.02,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:38.11,0:20:41.32,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:41.44,0:20:43.86,Default,,0,0,0,,Мен жалықтым! Сіз әлі 10 км жүрдіңіз бе?
Dialogue: 0,0:20:43.99,0:20:46.03,Default,,0,0,0,,Сіз әлі 3 шақырымнан астам жол жүрмедіңіз бе?
Dialogue: 0,0:20:46.16,0:20:47.62,Default,,0,0,0,,Ал, онда... тарт...
Dialogue: 0,0:20:47.74,0:20:49.99,Default,,0,0,0,,97км қалды!? Жоқ...
Dialogue: 0,0:20:50.33,0:20:54.25,Default,,0,0,0,,Джунглиде қанша жүрсең де, тек ағаштар ғана бар, бірақ...
Dialogue: 0,0:20:54.33,0:20:56.96,Default,,0,0,0,,Бірақ жабайы аңдар жоқ, солай ма?
Dialogue: 0,0:20:57.08,0:20:59.71,Default,,0,0,0,,Мен толғанбаймын, қобалжымаймын, қобалжымаймын.
Dialogue: 0,0:21:00.21,0:21:02.63,Default,,0,0,0,,Балалар, тым көп шағымдандыңдар!
Dialogue: 0,0:21:02.76,0:21:05.18,Default,,0,0,0,,Пекоға қарашы, ол қатты толқып тұр.
Dialogue: 0,0:21:05.47,0:21:06.30,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:21:06.43,0:21:08.85,Default,,0,0,0,,Кішкене үйрен! Барайық!
Dialogue: 0,0:21:08.97,0:21:09.89,Default,,0,0,0,,О... (Сунео) Иә.
Dialogue: 0,0:21:10.10,0:21:12.64,Default,,0,0,0,,Ах! Мен маңызды нәрсені ұмытып кеттім
Dialogue: 0,0:21:12.72,0:21:14.06,Default,,0,0,0,,Ә!? (Нобита) Сәлем Дораемон
Dialogue: 0,0:21:14.18,0:21:15.02,Default,,0,0,0,,Кез келген жерде есікке жауап беріңіз!
Dialogue: 0,0:21:15.14,0:21:16.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:16.23,0:21:19.19,Default,,0,0,0,,Мен үстелімнің үстіне жаман нәрсе қалдырдым.
Dialogue: 0,0:21:19.31,0:21:20.44,Default,,0,0,0,,А, мен оны біразға дейін жасырамын.
Dialogue: 0,0:21:20.52,0:21:23.07,Default,,0,0,0,,Не! Бұл менің барлау көңіл-күйімді бұзады!
Dialogue: 0,0:21:23.19,0:21:24.32,Default,,0,0,0,,Енді жалықпаңыз
Dialogue: 0,0:21:24.61,0:21:25.86,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:21:25.99,0:21:27.91,Default,,0,0,0,,Жаман болды Жаман болды!
Dialogue: 0,0:21:32.58,0:21:35.66,Default,,0,0,0,,Ха-ха... Уф
Dialogue: 0,0:21:38.96,0:21:41.17,Default,,0,0,0,,♬~
Dialogue: 0,0:21:45.05,0:21:46.30,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:21:46.43,0:21:48.39,Default,,0,0,0,,А... Біраз Африкаға барайық.
Dialogue: 0,0:21:48.64,0:21:51.56,Default,,0,0,0,,Мен кешкі асқа дейін үйде боламын (Нобита) Иә.
Dialogue: 0,0:21:52.18,0:21:53.85,Default,,0,0,0,,Африка?
Dialogue: 0,0:21:56.23,0:21:58.94,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:21:59.06,0:22:00.81,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:22:01.27,0:22:03.44,Default,,0,0,0,,Енді көңілімізді көтеріп, жолға шығайық.
Dialogue: 0,0:22:03.57,0:22:04.90,Default,,0,0,0,,Кеух... (Сунео) Хмф...
Dialogue: 0,0:22:10.28,0:22:11.66,Default,,0,0,0,,А... а?
Dialogue: 0,0:22:14.79,0:22:17.50,Default,,0,0,0,,Эй, Нобита, не болды?
Dialogue: 0,0:22:17.62,0:22:19.58,Default,,0,0,0,,А, не? Уфуфу...
Dialogue: 0,0:22:20.33,0:22:22.46,Default,,0,0,0,,Содан бері ұстанып келемін.
Dialogue: 0,0:22:22.59,0:22:26.26,Default,,0,0,0,,Мен де бірдеңе істеуім керек сияқты болдым.
Dialogue: 0,0:22:26.80,0:22:30.18,Default,,0,0,0,,Ах... Эй, өтінемін... Қай жерде болсаңыз да есікті жауып беріңізші.
Dialogue: 0,0:22:30.30,0:22:31.72,Default,,0,0,0,,Иә, Шизука-чан да?
Dialogue: 0,0:22:31.80,0:22:34.60,Default,,0,0,0,,Бір минут күте тұрыңыз, мүмкін есікті пайдалануды тоқтату керек.
Dialogue: 0,0:22:34.72,0:22:35.56,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,0:22:35.64,0:22:37.39,Default,,0,0,0,,Өйткені мен...
Dialogue: 0,0:22:37.52,0:22:39.35,Default,,0,0,0,,Шизука-чан да зейін қояды...
Dialogue: 0,0:22:39.48,0:22:40.85,Default,,0,0,0,,Ах~
Dialogue: 0,0:22:42.77,0:22:43.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:44.61,0:22:47.44,Default,,0,0,0,,〜
Dialogue: 0,0:22:47.57,0:22:50.36,Default,,0,0,0,,Мен экспедицияның зәр шығаруға оралғанын естіген емеспін!
Dialogue: 0,0:22:50.49,0:22:53.49,Default,,0,0,0,,Жындар патшалығының көңіл-күйі және бәрі жойылды!
Dialogue: 0,0:22:53.62,0:22:55.29,Default,,0,0,0,,А, осы қарқынмен, алда не болады?
Dialogue: 0,0:22:55.41,0:22:57.87,Default,,0,0,0,,Жер бетінде не болады! Уф!
Dialogue: 0,0:22:58.46,0:23:00.29,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:23:00.75,0:23:02.21,Default,,0,0,0,,Сәлем Таке-кун
Dialogue: 0,0:23:02.33,0:23:04.50,Default,,0,0,0,,Не! Дораэмон бәрібір
Dialogue: 0,0:23:04.63,0:23:07.26,Default,,0,0,0,,Сіз бұл тітіркендіргіш есікті тез тазалай аласыз ба?
Dialogue: 0,0:23:08.26,0:23:11.64,Default,,0,0,0,,Барлығына! Енді барлаудың ортасында үйіне қайтуға тырысқан адам
Dialogue: 0,0:23:11.76,0:23:13.22,Default,,0,0,0,,Мен сені жұдырықтаймын!
Dialogue: 0,0:23:13.51,0:23:15.18,Default,,0,0,0,,Себеп қандай болса да.
Dialogue: 0,0:23:15.35,0:23:17.18,Default,,0,0,0,,Ым... Таке-кун, мен солай дедім...
Dialogue: 0,0:23:17.31,0:23:18.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:19.18,0:23:21.98,Default,,0,0,0,,Хмм... Не? Менің анам?
Dialogue: 0,0:23:22.10,0:23:24.69,Default,,0,0,0,,Сіз ашуланып, бірден келуімді өтіндіңіз бе?
Dialogue: 0,0:23:24.82,0:23:30.11,Default,,0,0,0,,Эх... аа... Ум, Дораемон, кез келген жерде есікті аш...
Dialogue: 0,0:23:30.20,0:23:32.70,Default,,0,0,0,,Анамды көруге қайтатын экспедиция ше?
Dialogue: 0,0:23:32.82,0:23:33.74,Default,,0,0,0,,Мен мұны бұрын ешқашан көрген емеспін!
Dialogue: 0,0:23:33.82,0:23:35.78,Default,,0,0,0,,Сонша шуламаңыз! иә!
Dialogue: 0,0:23:39.00,0:23:41.96,Default,,0,0,0,,А, кеш болды...
Dialogue: 0,0:23:42.08,0:23:44.33,Default,,0,0,0,,Эй, мен күте алмаймын... (Нобита/Сунео) Ах!
Dialogue: 0,0:23:44.42,0:23:45.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:49.92,0:23:52.43,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:23:52.51,0:23:54.43,Default,,0,0,0,,Әйтеуір, әлдеқашан біреу.
Dialogue: 0,0:23:54.55,0:23:56.10,Default,,0,0,0,,Толқып тұрған жалғыз Пеко.
Dialogue: 0,0:23:57.76,0:23:58.85,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:23:59.10,0:24:00.73,Default,,0,0,0,,Әй, жақында түскі ас ішеміз бе?
Dialogue: 0,0:24:00.85,0:24:01.81,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:24:02.10,0:24:03.48,Default,,0,0,0,,Мен түскі асымды әкелген жоқпын.
Dialogue: 0,0:24:03.60,0:24:05.98,Default,,0,0,0,,Ал, маған қалдырыңыз.
Dialogue: 0,0:24:06.44,0:24:08.32,Default,,0,0,0,,Жеткізу телефоны!
Dialogue: 0,0:24:08.61,0:24:10.40,Default,,0,0,0,,I Француз мейрамханасы краб палауы
Dialogue: 0,0:24:10.53,0:24:11.40,Default,,0,0,0,,Карри және күріш!
Dialogue: 0,0:24:11.53,0:24:15.07,Default,,0,0,0,,Тоқта, бұл сіздің барлау көңіл-күйіңізді бұзады!
Dialogue: 0,0:24:15.70,0:24:17.83,Default,,0,0,0,,Бұл рас, онда...
Dialogue: 0,0:24:18.37,0:24:20.50,Default,,0,0,0,,Өсімдіктерді өзгерту сығындысы!
Dialogue: 0,0:24:20.95,0:24:22.29,Default,,0,0,0,,Енді не жегің келетінін айт.
Dialogue: 0,0:24:22.41,0:24:24.12,Default,,0,0,0,,Карри күріш (Сунео) Шаян палауы
Dialogue: 0,0:24:24.25,0:24:25.50,Default,,0,0,0,,Рамен мен гиоза қосылған үлкен тостаған
Dialogue: 0,0:24:25.63,0:24:26.50,Default,,0,0,0,,Құймақ
Dialogue: 0,0:24:26.88,0:24:30.09,Default,,0,0,0,,Міне, бұл карри мен күріш ампуласы.
Dialogue: 0,0:24:34.38,0:24:36.18,Default,,0,0,0,,Бұл ағаш жақсы.
Dialogue: 0,0:24:37.55,0:24:39.93,Default,,0,0,0,,Өсіп, ісінеді♪
Dialogue: 0,0:24:40.06,0:24:43.44,Default,,0,0,0,,Гүлдер гүлдеп, жемістер өседі♪
Dialogue: 0,0:24:51.90,0:24:53.32,Default,,0,0,0,,Неліктен бұл карри мен күріш?
Dialogue: 0,0:24:53.45,0:24:54.53,Default,,0,0,0,,Оны кесіңіз
Dialogue: 0,0:24:54.65,0:24:57.82,Default,,0,0,0,,Иә? Әй, бұл рас, иісі жақсы
Dialogue: 0,0:24:57.91,0:24:59.58,Default,,0,0,0,,Бұл құймақ жемісі
Dialogue: 0,0:24:59.70,0:25:01.16,Default,,0,0,0,,Бұл краб палауы
Dialogue: 0,0:25:01.29,0:25:03.16,Default,,0,0,0,,Бұл раменнің үлкен порциясы.
Dialogue: 0,0:25:03.29,0:25:05.29,Default,,0,0,0,,Бұл дораяки және ит тағамы
Dialogue: 0,0:25:05.62,0:25:07.25,Default,,0,0,0,,Уау, бұл дәмді көрінеді Уау, бұл ыңғайлы
Dialogue: 0,0:25:07.50,0:25:10.46,Default,,0,0,0,,Мүмкін болса, әдемі көрініс бар жерде тамақтанайық.
Dialogue: 0,0:25:10.92,0:25:13.09,Default,,0,0,0,,Маған бұл ағаш ұнайды.
Dialogue: 0,0:25:14.22,0:25:16.34,Default,,0,0,0,,Жедел лифт!
Dialogue: 0,0:25:22.43,0:25:24.14,Default,,0,0,0,,Бұл жерден керемет көрініс.
Dialogue: 0,0:25:24.48,0:25:27.10,Default,,0,0,0,,Осының үстіне асхана салайық.
Dialogue: 0,0:25:27.23,0:25:31.61,Default,,0,0,0,,Um зауытты өзгерту инъекциясы
Dialogue: 0,0:25:31.73,0:25:32.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:40.83,0:25:43.04,Default,,0,0,0,,(лифт жұмысының дыбысы)
Dialogue: 0,0:25:46.67,0:25:47.62,Default,,0,0,0,,О, мен қорқамын.
Dialogue: 0,0:25:47.75,0:25:49.79,Default,,0,0,0,,Амансың ба? сақ болыңыз
Dialogue: 0,0:25:50.96,0:25:53.09,Default,,0,0,0,,Ммм, бұл дәмді.
Dialogue: 0,0:25:55.05,0:25:56.63,Default,,0,0,0,,Әй, дәмді болды Эй Пеко
Dialogue: 0,0:25:56.76,0:25:58.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:58.76,0:25:59.80,Default,,0,0,0,,Ахх (Пеконың үруі)
Dialogue: 0,0:26:00.14,0:26:01.01,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:26:01.14,0:26:04.02,Default,,0,0,0,,Солтүстікте ақ түтін сияқты бірдеңе бар...
Dialogue: 0,0:26:05.23,0:26:06.89,Default,,0,0,0,,Мүмкін бұл...
Dialogue: 0,0:26:07.02,0:26:08.94,Default,,0,0,0,,Ауыр темекі шегетін орман
Dialogue: 0,0:26:09.35,0:26:10.23,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:26:10.36,0:26:11.90,Default,,0,0,0,,Бұл шынымен де болды.
Dialogue: 0,0:26:12.40,0:26:15.03,Default,,0,0,0,,Жаяу жүрсең, бір күні жетесің
Dialogue: 0,0:26:15.15,0:26:19.49,Default,,0,0,0,,Кейбір жабайы аңдар көрінсе, бұл барлау сияқты болар еді.
Dialogue: 0,0:26:19.95,0:26:23.74,Default,,0,0,0,,Доремон аңды жасай алмайды ма? Бұл одан да қызықты болады деп үміттенемін
Dialogue: 0,0:26:23.87,0:26:27.46,Default,,0,0,0,,Қаласаңыз, аласыз, бірақ... Хм...
Dialogue: 0,0:26:27.54,0:26:30.08,Default,,0,0,0,,Аңнан аулақ болу үшін жадағай!
Dialogue: 0,0:26:31.79,0:26:33.04,Default,,0,0,0,,Жадағайдан түскен жарық
Dialogue: 0,0:26:33.17,0:26:35.96,Default,,0,0,0,,Жабайы аңдарды қызықтыру үшін оларды оңай қоздырыңыз
Dialogue: 0,0:26:38.80,0:26:40.93,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:26:41.09,0:26:43.39,Default,,0,0,0,,Иә? Не? Не? (Нобита) Бұл не және қайда?
Dialogue: 0,0:26:43.47,0:26:45.77,Default,,0,0,0,,Иә? Ой, ой!?
Dialogue: 0,0:26:46.18,0:26:47.77,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:26:47.85,0:26:49.73,Default,,0,0,0,,Бұл барыс! Ахххх...
Dialogue: 0,0:26:49.81,0:26:51.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:51.52,0:26:53.02,Default,,0,0,0,,Қорқынышты! (Нобита) қорқынышты қорқынышты қорқынышты
Dialogue: 0,0:26:53.15,0:26:56.03,Default,,0,0,0,,Жоқ, көмектесіңізші! О, жоқ...
Dialogue: 0,0:26:56.11,0:26:57.99,Default,,0,0,0,,Мен бір нәрсені тез істеуім керек Мен бірдеңе істеуім керек
Dialogue: 0,0:26:58.07,0:27:02.37,Default,,0,0,0,,Иә? Ана, аа, ой, ой, ой...
Dialogue: 0,0:27:02.45,0:27:07.08,Default,,0,0,0,,Момотаро таңбаланған тары тұшпара! Міне бітті
Dialogue: 0,0:27:10.08,0:27:12.83,Default,,0,0,0,,Мама... Менің енді қолымнан келмейді...
Dialogue: 0,0:27:12.96,0:27:13.96,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:27:14.34,0:27:15.88,Default,,0,0,0,,Уфуфу... Жақсы.
Dialogue: 0,0:27:16.00,0:27:17.38,Default,,0,0,0,,Қарызға алынған мысыққа ұқсайды
Dialogue: 0,0:27:17.51,0:27:18.42,Default,,0,0,0,,Стейннен алған жарақаттарым әлі толық жазылмағандықтан—
Dialogue: 0,0:27:18.67,0:27:20.38,Default,,0,0,0,,Қажетсіз істермен айналысу
Dialogue: 0,0:27:20.76,0:27:23.43,Default,,0,0,0,,Мен сені жеңемін деп ойладым.
Dialogue: 0,0:27:23.51,0:27:25.35,Default,,0,0,0,,(Сунео) қайтадан күшті.
Dialogue: 0,0:27:26.14,0:27:28.77,Default,,0,0,0,,Рас, бөрене таяқшаны осылай жасайсың.
Dialogue: 0,0:27:28.89,0:27:31.14,Default,,0,0,0,,Оны шайқаңыз... Қайда баруым керек?
Dialogue: 0,0:27:31.44,0:27:32.73,Default,,0,0,0,,Уау! Біраз...
Dialogue: 0,0:27:32.81,0:27:35.52,Default,,0,0,0,,Анашым, көмектесіңізші! Кя!
Dialogue: 0,0:27:35.77,0:27:37.19,Default,,0,0,0,,Сен «Телефон ауқымын» айтып тұрсың ба? Иә
Dialogue: 0,0:27:37.90,0:27:41.36,Default,,0,0,0,,Уау! Маған көмектес, анашым...
Dialogue: 0,0:27:41.70,0:27:44.07,Default,,0,0,0,,Кішкентай жарық!
Dialogue: 0,0:27:44.37,0:27:46.99,Default,,0,0,0,,А, мен мұны істеуге рұқсат етемін!
Dialogue: 0,0:27:48.54,0:27:51.71,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:27:53.96,0:27:57.13,Default,,0,0,0,,Хехе, кішкентай болып қалды.
Dialogue: 0,0:27:57.25,0:27:58.67,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,0:27:59.05,0:28:00.97,Default,,0,0,0,,Сіз қажетсіз нәрселермен айналысып жатырсыз!
Dialogue: 0,0:28:01.09,0:28:02.34,Default,,0,0,0,,Әй?
Dialogue: 0,0:28:03.84,0:28:05.55,Default,,0,0,0,,Сай! (Нобита) Бұл Сай! Бұл Сай! Бұл Сай!
Dialogue: 0,0:28:05.68,0:28:07.06,Default,,0,0,0,,Енді жоқ! Уау, мұнда кел!
Dialogue: 0,0:28:07.97,0:28:09.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:09.89,0:28:11.73,Default,,0,0,0,,Неге тек мен?
Dialogue: 0,0:28:12.14,0:28:14.15,Default,,0,0,0,,Уау, маған көмектес!
Dialogue: 0,0:28:14.98,0:28:16.86,Default,,0,0,0,,Шок мылтығы!
Dialogue: 0,0:28:17.07,0:28:19.03,Default,,0,0,0,,Маған осымен ұйықтауға рұқсат етіңіз
Dialogue: 0,0:28:19.15,0:28:20.82,Default,,0,0,0,,Эй, бұл жолы маған рұқсат етіңіз.
Dialogue: 0,0:28:20.90,0:28:24.78,Default,,0,0,0,,Біраз көмек! Мм... күте тұрыңыз... аа!
Dialogue: 0,0:28:26.49,0:28:27.53,Default,,0,0,0,,Ах, а, у...
Dialogue: 0,0:28:28.62,0:28:30.54,Default,,0,0,0,,Иә! Керемет жұмыс!
Dialogue: 0,0:28:31.87,0:28:33.46,Default,,0,0,0,,Бұл қандай зат?
Dialogue: 0,0:28:33.54,0:28:36.33,Default,,0,0,0,,Бұл тамаша. О? Таке-кун ше?
Dialogue: 0,0:28:36.46,0:28:37.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:38.25,0:28:41.88,Default,,0,0,0,,Неге, неге, тек мен? Анашым!
Dialogue: 0,0:28:42.01,0:28:44.18,Default,,0,0,0,,Супер қолғаптар!
Dialogue: 0,0:28:44.30,0:28:45.47,Default,,0,0,0,,Шизука-чан, сен оны көргің келе ме?
Dialogue: 0,0:28:45.59,0:28:47.10,Default,,0,0,0,,Мен мұны істей аламын ба?
Dialogue: 0,0:28:47.22,0:28:48.68,Default,,0,0,0,,Жарайды, жүр!
Dialogue: 0,0:28:48.81,0:28:49.72,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:28:50.77,0:28:52.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:28:52.64,0:28:53.69,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:28:53.77,0:28:55.48,Default,,0,0,0,,О, бұл!
Dialogue: 0,0:28:55.56,0:28:58.15,Default,,0,0,0,,Иә, иә! (Нобита) Шизука-чан, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:28:58.27,0:28:59.32,Default,,0,0,0,,Міне, ұрыңыз!
Dialogue: 0,0:28:59.40,0:29:01.40,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 0,0:29:02.90,0:29:04.49,Default,,0,0,0,,Хаа!
Dialogue: 0,0:29:05.11,0:29:06.70,Default,,0,0,0,,Шизука-чан! (Сунео) Тарзан әйел!
Dialogue: 0,0:29:07.28,0:29:08.58,Default,,0,0,0,,Гори-чан, кешіріңіз.
Dialogue: 0,0:29:08.70,0:29:11.87,Default,,0,0,0,,Жарайды, мен 3 сағаттан кейін тұрамын.
Dialogue: 0,0:29:12.00,0:29:14.37,Default,,0,0,0,,Иә? Джан, қайда бардың?
Dialogue: 0,0:29:14.50,0:29:17.21,Default,,0,0,0,,Джа~н! Такеру!
Dialogue: 0,0:29:17.33,0:29:18.96,Default,,0,0,0,,Джа~н! (Сунео) Ол қайда?
Dialogue: 0,0:29:19.04,0:29:22.59,Default,,0,0,0,,(Пеко қабығы)
Dialogue: 0,0:29:25.38,0:29:28.18,Default,,0,0,0,,Түс, енді бәрі жақсы.
Dialogue: 0,0:29:28.30,0:29:31.31,Default,,0,0,0,,Біз аңды жеңдік.
Dialogue: 0,0:29:33.10,0:29:35.06,Default,,0,0,0,,Ертең жалғастырайық.
Dialogue: 0,0:29:35.19,0:29:37.77,Default,,0,0,0,,Мен бірінші рет осылай қобалжыдым.
Dialogue: 0,0:29:37.90,0:29:40.94,Default,,0,0,0,,А, бұл қызық болды. Бұл барлау.
Dialogue: 0,0:29:41.07,0:29:42.36,Default,,0,0,0,,Бұл Африка
Dialogue: 0,0:29:43.15,0:29:45.03,Default,,0,0,0,,Уау, қандай барлау!
Dialogue: 0,0:29:45.15,0:29:47.32,Default,,0,0,0,,Африка дегеніміз не! Мүмкін емес!
Dialogue: 0,0:29:47.74,0:29:49.74,Default,,0,0,0,,Енді зерттеймін деп кейіп көрсетуге болмайды!
Dialogue: 0,0:29:49.87,0:29:50.91,Default,,0,0,0,,Бірақ Джан...
Dialogue: 0,0:29:51.03,0:29:53.29,Default,,0,0,0,,Алып мүсіннің сыры...
Dialogue: 0,0:29:53.58,0:29:55.33,Default,,0,0,0,,Бұл қандай тас құдай?
Dialogue: 0,0:29:55.46,0:29:59.21,Default,,0,0,0,,Егер сіз тағы бір рет барлау немесе жын-шайтандық аумақты еске алсаңыз, мен сіздің бетіңізге жұдырықтаймын!
Dialogue: 0,0:29:59.46,0:30:00.96,Default,,0,0,0,,Хмм, қазірдің өзінде!
Dialogue: 0,0:30:04.88,0:30:06.38,Default,,0,0,0,,Бұл өзімшілдік...
Dialogue: 0,0:30:06.51,0:30:09.05,Default,,0,0,0,,Ал, жоқ, мен бүгін өте көңілді болдым.
Dialogue: 0,0:30:09.18,0:30:10.14,Default,,0,0,0,,Міне саған – қоштасу сүйісі.
Dialogue: 0,0:30:26.61,0:30:30.45,Default,,0,0,0,,Джан, оян, Джан.
Dialogue: 0,0:30:31.03,0:30:35.54,Default,,0,0,0,,Иә? Ой, сен кімсің? Түн ортасында...
Dialogue: 0,0:30:35.66,0:30:38.79,Default,,0,0,0,,Уау!Ах...
Dialogue: 0,0:30:42.67,0:30:44.75,Default,,0,0,0,,Кио алып Құдай мүсіні...
Dialogue: 0,0:30:45.34,0:30:48.47,Default,,0,0,0,,Бірде мен жындар әлемін зерттеуді ойладым.
Dialogue: 0,0:30:48.59,0:30:52.68,Default,,0,0,0,,Сіз әлі оңай бас тартатын адамсыз ба?
Dialogue: 0,0:30:53.10,0:30:55.31,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:30:55.43,0:30:57.10,Default,,0,0,0,,Бұл ешқашан жалықтырмайды
Dialogue: 0,0:30:57.23,0:30:59.39,Default,,0,0,0,,Барғанның зияны жоқ.
Dialogue: 0,0:30:59.52,0:31:02.69,Default,,0,0,0,,Тұғырымның астында қазына тығылды
Dialogue: 0,0:31:03.19,0:31:04.65,Default,,0,0,0,,Қазына…
Dialogue: 0,0:31:04.98,0:31:07.61,Default,,0,0,0,,Ол жерге жету үшін картаны беріңіз
Dialogue: 0,0:31:07.69,0:31:11.32,Default,,0,0,0,,Бар, батыл бала
Dialogue: 0,0:31:11.45,0:31:15.03,Default,,0,0,0,,Қазынаны қолыңа ұста
Dialogue: 0,0:31:17.58,0:31:19.96,Default,,0,0,0,,Немесе Құдай...
Dialogue: 0,0:31:20.25,0:31:24.92,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:31:25.38,0:31:27.38,Default,,0,0,0,,Барлығы, мынаны қараңдар.
Dialogue: 0,0:31:27.84,0:31:28.88,Default,,0,0,0,,Бұл қазына картасы.
Dialogue: 0,0:31:29.01,0:31:31.05,Default,,0,0,0,,Менің үйімде жұмбақ алып мүсін пайда болды.
Dialogue: 0,0:31:31.18,0:31:32.26,Default,,0,0,0,,Ол маған бұны берді.
Dialogue: 0,0:31:32.39,0:31:35.64,Default,,0,0,0,,Бұл барлауды кез келген жағдайда сәтті ету.
Dialogue: 0,0:31:35.72,0:31:37.89,Default,,0,0,0,,Құдайдан келген хабар деп ойлаймын.
Dialogue: 0,0:31:38.10,0:31:40.64,Default,,0,0,0,,Мен зерттеуді тоқтатамын дегендіктен...
Dialogue: 0,0:31:40.77,0:31:43.15,Default,,0,0,0,,Мен фортепианодан сабақ алуым керек...
Dialogue: 0,0:31:43.27,0:31:44.52,Default,,0,0,0,,Мен мектепке баруым керек.
Dialogue: 0,0:31:44.65,0:31:45.82,Default,,0,0,0,,Жалғанға ұқсайды
Dialogue: 0,0:31:45.94,0:31:47.11,Default,,0,0,0,,Қандай тітіркендіргіш! (4 адам) Уау...
Dialogue: 0,0:31:47.57,0:31:50.24,Default,,0,0,0,,Балалар, менің айтқаныма қарсы шығасыңдар ма?
Dialogue: 0,0:31:50.36,0:31:52.32,Default,,0,0,0,,Бірде мен зерттеуді ойладым...
Dialogue: 0,0:31:52.45,0:31:53.74,Default,,0,0,0,,Әлі де ер адам!
Dialogue: 0,0:31:53.87,0:31:55.49,Default,,0,0,0,,Әйел! О, менің...
Dialogue: 0,0:31:55.62,0:31:56.62,Default,,0,0,0,,Бірақ мен түсінемін.
Dialogue: 0,0:31:56.74,0:31:57.99,Default,,0,0,0,,Мен барамын, барамын
Dialogue: 0,0:31:58.16,0:32:00.29,Default,,0,0,0,,Біз де сені жек көрмейміз...
Dialogue: 0,0:32:00.41,0:32:02.71,Default,,0,0,0,,Мен бұл картаны қоямын.
Dialogue: 0,0:32:03.21,0:32:05.21,Default,,0,0,0,,Кеше болған жерімізден бастайық.
Dialogue: 0,0:32:05.34,0:32:07.92,Default,,0,0,0,,Иә (Пеконың үруі)
Dialogue: 0,0:32:09.30,0:32:10.55,Default,,0,0,0,,Бұған дейін, Дораемон
Dialogue: 0,0:32:10.67,0:32:12.88,Default,,0,0,0,,Кішкентай жарықпен Momotaro бренді Kibidango
Dialogue: 0,0:32:13.01,0:32:16.64,Default,,0,0,0,,Takecopter, Shock Gun және Super қолғаптарды шығарыңыз.
Dialogue: 0,0:32:16.76,0:32:18.22,Default,,0,0,0,,Ум...
Dialogue: 0,0:32:18.64,0:32:21.31,Default,,0,0,0,,Сонда бұл... Жарайды.
Dialogue: 0,0:32:21.89,0:32:24.31,Default,,0,0,0,,Осы заттардың барлығы осында сақталуы керек.
Dialogue: 0,0:32:24.40,0:32:26.36,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:32:26.48,0:32:28.57,Default,,0,0,0,,Маған қауіп төнсе не істеуім керек?
Dialogue: 0,0:32:29.03,0:32:31.69,Default,,0,0,0,,Шулы! Мұндай нәрсеге сену ақымақтық
Dialogue: 0,0:32:31.82,0:32:34.49,Default,,0,0,0,,Осы білек пен батылдықпен мен қауіпті жеңемін.
Dialogue: 0,0:32:34.82,0:32:36.03,Default,,0,0,0,,Мм... жақсысың ба?
Dialogue: 0,0:32:36.16,0:32:37.45,Default,,0,0,0,,Ей, еркек болсаң да.
Dialogue: 0,0:32:37.70,0:32:40.37,Default,,0,0,0,,Мен әлі бітірген жоқпын. Сенің артыңнан келемін.
Dialogue: 0,0:32:40.45,0:32:42.87,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:32:48.50,0:32:49.34,Default,,0,0,0,,Иә!?
Dialogue: 0,0:32:49.42,0:32:52.34,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:32:52.42,0:32:54.76,Default,,0,0,0,,Не? Сол барабан дыбысы
Dialogue: 0,0:32:54.88,0:32:57.35,Default,,0,0,0,,Осындай жерде байырғы ауыл бар ма?
Dialogue: 0,0:32:57.64,0:33:00.26,Default,,0,0,0,,Эй, менің ойымша, бізді нысанаға алып жатыр.
Dialogue: 0,0:33:00.39,0:33:02.35,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:33:02.48,0:33:04.31,Default,,0,0,0,,Ха... барабандар тоқтады.
Dialogue: 0,0:33:04.39,0:33:06.27,Default,,0,0,0,,(Пеко қабығы)
Dialogue: 0,0:33:06.35,0:33:09.61,Default,,0,0,0,,Дегенмен, Ол Майт—
Dialogue: 0,0:33:12.49,0:33:13.53,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:33:13.61,0:33:17.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:17.70,0:33:19.45,Default,,0,0,0,,А, бұл өзен.
Dialogue: 0,0:33:20.49,0:33:21.91,Default,,0,0,0,,Карта бойынша
Dialogue: 0,0:33:22.12,0:33:26.71,Default,,0,0,0,,Осы өзенге шықсақ, бізді алып мүсін мен қазына күтіп тұр.
Dialogue: 0,0:33:26.83,0:33:27.88,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:34:28.56,0:34:30.10,Default,,0,0,0,,Осы жерде, иә.
Dialogue: 0,0:34:30.23,0:34:31.77,Default,,0,0,0,,А... аа!
Dialogue: 0,0:34:32.27,0:34:33.57,Default,,0,0,0,,Не болды? не? не?
Dialogue: 0,0:34:33.65,0:34:35.03,Default,,0,0,0,,Әй, бұл не?!
Dialogue: 0,0:34:35.40,0:34:36.57,Default,,0,0,0,,Уаааааа!
Dialogue: 0,0:34:36.69,0:34:38.61,Default,,0,0,0,,Ах... уау
Dialogue: 0,0:34:45.24,0:34:48.37,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:34:48.46,0:34:49.67,Default,,0,0,0,,Қия қорқынышты!
Dialogue: 0,0:34:49.79,0:34:51.83,Default,,0,0,0,,Жарайды, бұл сондай үлкен кеме.
Dialogue: 0,0:34:52.04,0:34:54.75,Default,,0,0,0,,Дұрыс, қараңдар!
Dialogue: 0,0:34:55.17,0:34:58.05,Default,,0,0,0,,(Нобита мен оның достары қуанады)
Dialogue: 0,0:34:58.26,0:35:00.01,Default,,0,0,0,,А, Каджи?
Dialogue: 0,0:35:00.09,0:35:01.97,Default,,0,0,0,,А, жоқ! Апыр-ай!
Dialogue: 0,0:35:06.77,0:35:08.35,Default,,0,0,0,,Уау, кеменің түбі зақымданған.
Dialogue: 0,0:35:08.43,0:35:10.85,Default,,0,0,0,,（）〜
Dialogue: 0,0:35:12.94,0:35:14.57,Default,,0,0,0,,Бұл! Бұл жігіт!
Dialogue: 0,0:35:16.11,0:35:17.94,Default,,0,0,0,,О, маған көмектес! (Нобита) Тез, тез
Dialogue: 0,0:35:18.19,0:35:19.40,Default,,0,0,0,,(Пеконың қорқытқан айқайы)
Dialogue: 0,0:35:19.74,0:35:21.36,Default,,0,0,0,,Ия! (Сунео) Джан!
Dialogue: 0,0:35:21.45,0:35:22.78,Default,,0,0,0,,Хмм ха! (Нобита) Қара
Dialogue: 0,0:35:22.87,0:35:25.37,Default,,0,0,0,,...
Dialogue: 0,0:35:25.49,0:35:26.70,Default,,0,0,0,,Мен оны тастап кеттім!
Dialogue: 0,0:35:26.83,0:35:30.08,Default,,0,0,0,,Кішкентай жарық! Takecopter! Супер қолғаптар!
Dialogue: 0,0:35:30.21,0:35:32.54,Default,,0,0,0,,...
Dialogue: 0,0:35:32.92,0:35:34.84,Default,,0,0,0,,...
Dialogue: 0,0:35:34.96,0:35:36.63,Default,,0,0,0,,Дұрыс, дұрыс (Нобита) Иә, дұрыс...
Dialogue: 0,0:35:36.75,0:35:39.84,Default,,0,0,0,,… …
Dialogue: 0,0:35:39.92,0:35:43.76,Default,,0,0,0,,Барлық жерде есіктер! О құдайым-ай!
Dialogue: 0,0:35:43.85,0:35:45.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:45.81,0:35:47.06,Default,,0,0,0,,（）…
Dialogue: 0,0:35:47.18,0:35:48.14,Default,,0,0,0,,Сізді жеп қояды!
Dialogue: 0,0:35:48.22,0:35:49.85,Default,,0,0,0,,Егер ол жұмыс істемесе, міне!
Dialogue: 0,0:35:50.02,0:35:51.23,Default,,0,0,0,,Уау (Нобита) Дораемон!
Dialogue: 0,0:35:52.85,0:35:54.65,Default,,0,0,0,,Бұл қалай болды?
Dialogue: 0,0:35:54.77,0:35:56.40,Default,,0,0,0,,Бұл біздің соңымыз.
Dialogue: 0,0:35:58.99,0:36:00.82,Default,,0,0,0,,Әй, мен одан сайын батып бара жатырмын...
Dialogue: 0,0:36:00.95,0:36:01.61,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:36:02.20,0:36:03.32,Default,,0,0,0,,(Пеконың ырылдауы)
Dialogue: 0,0:36:04.91,0:36:05.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:07.45,0:36:09.16,Default,,0,0,0,,Қаш, Пеко! қауіпті!
Dialogue: 0,0:36:10.12,0:36:11.50,Default,,0,0,0,,(Пеко қабығы)
Dialogue: 0,0:36:15.17,0:36:16.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:16.59,0:36:18.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:26.72,0:36:30.73,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:36:47.49,0:36:51.08,Default,,0,0,0,,...
Dialogue: 0,0:36:51.20,0:36:53.62,Default,,0,0,0,,Міне, осындай үлкен қарсы алу кеші.
Dialogue: 0,0:36:53.75,0:36:56.63,Default,,0,0,0,,...
Dialogue: 0,0:36:56.79,0:36:59.67,Default,,0,0,0,,Малка Бали Либани Такос Даморка
Dialogue: 0,0:36:59.75,0:37:00.92,Default,,0,0,0,,Дабо... Даворка? (Джан Шизука) Иә?
Dialogue: 0,0:37:01.05,0:37:02.30,Default,,0,0,0,,Хехе... Не айтып тұрсың?
Dialogue: 0,0:37:02.42,0:37:03.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:03.76,0:37:06.76,Default,,0,0,0,,Жоқ, мен коннякусыз сөйлесе алмаймын.
Dialogue: 0,0:37:06.89,0:37:08.22,Default,,0,0,0,,Бірақ мен таң қалдым ба...
Dialogue: 0,0:37:08.35,0:37:09.39,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:37:09.47,0:37:10.60,Default,,0,0,0,,Келіңізші, өтінемін.
Dialogue: 0,0:37:10.72,0:37:12.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:13.02,0:37:13.85,Default,,0,0,0,,Яғни.
Dialogue: 0,0:37:13.98,0:37:16.35,Default,,0,0,0,,“”
Dialogue: 0,0:37:16.52,0:37:19.44,Default,,0,0,0,,“”
Dialogue: 0,0:37:19.77,0:37:22.24,Default,,0,0,0,,Не, қарсы алу кеші емес пе еді?
Dialogue: 0,0:37:22.36,0:37:23.19,Default,,0,0,0,,О
Dialogue: 0,0:37:23.32,0:37:24.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:24.24,0:37:27.16,Default,,0,0,0,,О
Dialogue: 0,0:37:27.24,0:37:29.62,Default,,0,0,0,,Элида садақ ит
Dialogue: 0,0:37:29.74,0:37:32.16,Default,,0,0,0,,Элида садақ ит
Dialogue: 0,0:37:32.29,0:37:34.41,Default,,0,0,0,,А, бұл не!? (Нобита) спутниктік сурет...
Dialogue: 0,0:37:34.54,0:37:35.75,Default,,0,0,0,,Түсімде пайда болды...
Dialogue: 0,0:37:40.96,0:37:42.96,Default,,0,0,0,,Дәл осы адамдар сияқты
Dialogue: 0,0:37:43.09,0:37:45.38,Default,,0,0,0,,Мен нағыз садақ итті көрдім.
Dialogue: 0,0:37:45.51,0:37:48.09,Default,,0,0,0,,Алып мүсіннің осында екеніне сенімдімін.
Dialogue: 0,0:37:48.22,0:37:49.18,Default,,0,0,0,,Тыңдаймыз (Нобита) Иә.
Dialogue: 0,0:37:51.68,0:37:55.77,Default,,0,0,0,,Бованко құдайымен кездесу Үш өмір бар.
Dialogue: 0,0:37:55.85,0:37:59.40,Default,,0,0,0,,Тему сарқырамасынан өткен соң арыстандар елі саваннаға жетесіз.
Dialogue: 0,0:37:59.61,0:38:01.86,Default,,0,0,0,,7 рет 7 рет 7 Арыстан бар
Dialogue: 0,0:38:02.48,0:38:04.69,Default,,0,0,0,,Мұнда бір өмірден айырылыңыз
Dialogue: 0,0:38:04.82,0:38:08.82,Default,,0,0,0,,Саваннадан кейін, Одрондро аңғары, тік жартас.
Dialogue: 0,0:38:09.07,0:38:11.16,Default,,0,0,0,,Түсуге болмайды Жоғары көтерілуге болмайды
Dialogue: 0,0:38:11.28,0:38:13.66,Default,,0,0,0,,Алқап түбі, Өлілер елі
Dialogue: 0,0:38:13.79,0:38:18.83,Default,,0,0,0,,Күдікті нұр, күдікті дауыс, тағы да жан шығыны
Dialogue: 0,0:38:18.96,0:38:20.92,Default,,0,0,0,,Біз алқапты кесіп өтсек те
Dialogue: 0,0:38:21.04,0:38:24.76,Default,,0,0,0,,Мәңгілік тұманға оранған Құдай Патшалығының арғы жағында.
Dialogue: 0,0:38:24.88,0:38:26.92,Default,,0,0,0,,Кірсең, тірі оралмайсың.
Dialogue: 0,0:38:27.26,0:38:29.09,Default,,0,0,0,,Үшінші өміріңізден айырылыңыз
Dialogue: 0,0:38:29.30,0:38:31.18,Default,,0,0,0,,Бұл қорқынышты болды ма?
Dialogue: 0,0:38:31.30,0:38:33.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:33.47,0:38:34.72,Default,,0,0,0,,Үйге қайтайық? (Нобита) Иә, иә...
Dialogue: 0,0:38:34.85,0:38:37.02,Default,,0,0,0,,Не? Не? Сіз жалқаусыз.
Dialogue: 0,0:38:37.27,0:38:39.31,Default,,0,0,0,,Мен ырымдардан қорықпаймын
Dialogue: 0,0:38:39.44,0:38:41.77,Default,,0,0,0,,Бұл сен іздеген ұлы жын.
Dialogue: 0,0:38:41.90,0:38:45.40,Default,,0,0,0,,«Міндетті түрде Бованко Құдайымен кездесіп, қазына алыңыз».
Dialogue: 0,0:38:45.53,0:38:46.36,Default,,0,0,0,,Оларға солай айт.
Dialogue: 0,0:38:46.49,0:38:48.11,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,0:38:53.83,0:38:55.54,Default,,0,0,0,,Роуз Эркилема!
Dialogue: 0,0:38:55.62,0:38:57.66,Default,,0,0,0,,Раушан! Роза! Роза! Роза...
Dialogue: 0,0:38:58.04,0:38:59.25,Default,,0,0,0,,Не, не?
Dialogue: 0,0:38:59.37,0:39:00.33,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,0:39:00.42,0:39:02.79,Default,,0,0,0,,«Құдайдан қорықпайтындарды осы ауылға орналастырыңдар».
Dialogue: 0,0:39:02.92,0:39:05.09,Default,,0,0,0,,«Құдайдың қаһары осы ауылға түседі»
Dialogue: 0,0:39:05.21,0:39:07.09,Default,,0,0,0,,«Тез шық, әйтпесе»
Dialogue: 0,0:39:07.21,0:39:10.89,Default,,0,0,0,,Уау! Жүгіріп кету!
Dialogue: 0,0:39:10.97,0:39:12.76,Default,,0,0,0,,(қуып шыққан дауыс)
Dialogue: 0,0:39:24.52,0:39:26.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:34.45,0:39:37.75,Default,,0,0,0,,(барлығы тыныссыз)
Dialogue: 0,0:39:37.87,0:39:41.87,Default,,0,0,0,,Мен құтқарылдым деп ойладым, бірақ қорқынышты нәрсе болды...
Dialogue: 0,0:39:42.04,0:39:45.34,Default,,0,0,0,,Әйтеуір, бүгін түнде осы жерде демалайық.
Dialogue: 0,0:39:45.67,0:39:48.71,Default,,0,0,0,,Кемпинг қалпағы!
Dialogue: 0,0:39:52.51,0:39:55.97,Default,,0,0,0,,Әрқайсысында кереует пен дәретхана бар бес шағын бөлме бар.
Dialogue: 0,0:39:56.10,0:39:57.43,Default,,0,0,0,,Жуынатын бөлме жоқ, солай ма?
Dialogue: 0,0:39:57.56,0:39:59.68,Default,,0,0,0,,Менің қарным ашты. Рамен кеспесін жасайық.
Dialogue: 0,0:40:00.27,0:40:02.77,Default,,0,0,0,,Жоқ, түнде далаға шығу қауіпті.
Dialogue: 0,0:40:02.90,0:40:05.94,Default,,0,0,0,,Мен үйде болсам ғой, жылы сорпа мен бифштекс
Dialogue: 0,0:40:06.02,0:40:08.07,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:40:08.15,0:40:10.24,Default,,0,0,0,,Мама, уайымдап тұрсыз ба?
Dialogue: 0,0:40:10.32,0:40:12.20,Default,,0,0,0,,Қызық, біздің жағдайымыз не болады?
Dialogue: 0,0:40:12.32,0:40:15.32,Default,,0,0,0,,Келіңіздер, мен барлық пайдалы құралдарды қалдырдым.
Dialogue: 0,0:40:15.45,0:40:18.24,Default,,0,0,0,,Неліктен мұндай абайсыз сапарға бардың?
Dialogue: 0,0:40:18.37,0:40:19.95,Default,,0,0,0,,Анашым, кешіріңіз.
Dialogue: 0,0:40:20.25,0:40:22.75,Default,,0,0,0,,Ой! Менің кінәм бар ма?
Dialogue: 0,0:40:22.83,0:40:25.25,Default,,0,0,0,,Иә, оны ешкім айтқан жоқ...
Dialogue: 0,0:40:25.96,0:40:28.21,Default,,0,0,0,,Айтпасаң да бетінде анық жазылған.
Dialogue: 0,0:40:28.34,0:40:29.71,Default,,0,0,0,,Бұл сіздің кінәңіз
Dialogue: 0,0:40:30.01,0:40:31.97,Default,,0,0,0,,Бұл экспедицияны жоспарлаған мен болдым.
Dialogue: 0,0:40:32.38,0:40:33.93,Default,,0,0,0,,Құрал-саймандарды қалдырған мен едім.
Dialogue: 0,0:40:34.43,0:40:36.64,Default,,0,0,0,,Кемені қиратқан да, ауылдан қуылған да
Dialogue: 0,0:40:36.76,0:40:39.35,Default,,0,0,0,,Қараңызшы, бұл менің кінәм.
Dialogue: 0,0:40:39.52,0:40:43.35,Default,,0,0,0,,Хе, мені бәрібір жек көреді.
Dialogue: 0,0:40:43.60,0:40:46.36,Default,,0,0,0,,Сол көзқарас, адамның истериясы.
Dialogue: 0,0:40:46.48,0:40:48.07,Default,,0,0,0,,Оны жайына қалдыр, жатайық.
Dialogue: 0,0:40:48.19,0:40:52.03,Default,,0,0,0,,Жақсылап демалып, ертеңгі жолға дайындалайық.
Dialogue: 0,0:40:53.99,0:40:56.12,Default,,0,0,0,,Пеко, бірге ұйықтайық.
Dialogue: 0,0:40:56.87,0:40:58.62,Default,,0,0,0,,Иә? Қайда кетті?
Dialogue: 0,0:41:01.00,0:41:03.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:04.54,0:41:07.13,Default,,0,0,0,,Ах... Пеко
Dialogue: 0,0:41:07.75,0:41:11.38,Default,,0,0,0,,(Пеконың айқайы)
Dialogue: 0,0:41:11.51,0:41:13.55,Default,,0,0,0,,Уф... Пеко...
Dialogue: 0,0:41:14.18,0:41:16.89,Default,,0,0,0,,Пеко, мен не істеуім керек?
Dialogue: 0,0:41:17.01,0:41:19.05,Default,,0,0,0,,Уау...
Dialogue: 0,0:41:19.64,0:41:23.27,Default,,0,0,0,,(Джианның айқайы)
Dialogue: 0,0:41:33.15,0:41:33.99,Default,,0,0,0,,Жер
Dialogue: 0,0:41:34.11,0:41:35.45,Default,,0,0,0,,Иә, жарайды, жарайды.
Dialogue: 0,0:41:35.57,0:41:37.16,Default,,0,0,0,,Иә, иә, иә, мен қорқамын.
Dialogue: 0,0:41:37.28,0:41:41.54,Default,,0,0,0,,Сау бол, Шизука-чан, солай ұста.
Dialogue: 0,0:42:08.69,0:42:09.56,Default,,0,0,0,,(айқай)
Dialogue: 0,0:42:16.86,0:42:20.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:20.99,0:42:23.70,Default,,0,0,0,,Мұнда бір жанды жоғалтыңыз (Нобита) Жүр!
Dialogue: 0,0:42:24.20,0:42:27.37,Default,,0,0,0,,Кеттік, алға ұмтылудан басқа амалымыз жоқ.
Dialogue: 0,0:42:35.51,0:42:37.84,Default,,0,0,0,,(Пеконың ауыр тыныс алуы)
Dialogue: 0,0:42:38.34,0:42:41.80,Default,,0,0,0,,Пеко, сен өз бетімен бара алмайсың.
Dialogue: 0,0:42:41.93,0:42:44.52,Default,,0,0,0,,Сіз алға жылжу кезінде өз бағытыңызды үнемі тексеріп отыруыңыз керек.
Dialogue: 0,0:42:44.64,0:42:45.60,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:42:46.23,0:42:48.44,Default,,0,0,0,,Сіз білетін сияқтысыз
Dialogue: 0,0:42:48.56,0:42:50.06,Default,,0,0,0,,Қандай бөтен ит.
Dialogue: 0,0:42:50.48,0:42:52.31,Default,,0,0,0,,Ей, арыстандар жоқ емес пе?
Dialogue: 0,0:42:52.44,0:42:54.02,Default,,0,0,0,,Өйткені ол өте кең.
Dialogue: 0,0:42:54.40,0:42:57.32,Default,,0,0,0,,Сіз байқамай өтіп кетуіңіз мүмкін.
Dialogue: 0,0:42:57.44,0:42:58.99,Default,,0,0,0,,Бұл тәтті.
Dialogue: 0,0:42:59.11,0:43:01.74,Default,,0,0,0,,Арыстандар кездейсоқ шабуыл жасамайды.
Dialogue: 0,0:43:01.87,0:43:03.87,Default,,0,0,0,,Сізге топ болып секіру
Dialogue: 0,0:43:03.99,0:43:05.87,Default,,0,0,0,,Жел жақтан тыныш жақындау
Dialogue: 0,0:43:05.95,0:43:08.37,Default,,0,0,0,,Қуғындау рөлі Тұтқындау рөлі А?
Dialogue: 0,0:43:08.75,0:43:11.83,Default,,0,0,0,,Бірде біз өз орындарында болдық... Вау-у!
Dialogue: 0,0:43:11.92,0:43:13.92,Default,,0,0,0,,Бұл келе жатыр! Бұл қорқынышты! Ах...
Dialogue: 0,0:43:14.04,0:43:16.46,Default,,0,0,0,,Анау бұтада және ана жақтағы шөпте
Dialogue: 0,0:43:16.59,0:43:17.92,Default,,0,0,0,,Арыстан болуы керек
Dialogue: 0,0:43:18.05,0:43:19.38,Default,,0,0,0,,Мені қорқытпа, Сунео.
Dialogue: 0,0:43:19.97,0:43:23.26,Default,,0,0,0,,Сол жартастың басына шықсаңыз, бірдеңені көруіңіз мүмкін.
Dialogue: 0,0:43:25.39,0:43:28.18,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:43:29.27,0:43:31.98,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,0:43:35.36,0:43:38.82,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:43:39.07,0:43:40.53,Default,,0,0,0,,Енді жоқ, енді жоқ... (Сунео) Анашым!
Dialogue: 0,0:43:40.61,0:43:43.45,Default,,0,0,0,,Баршаңыз мықты болыңыздар! Берілмей күресіңіз
Dialogue: 0,0:43:44.28,0:43:46.04,Default,,0,0,0,,Соғыссақ та қаруымыз жоқ.
Dialogue: 0,0:43:46.16,0:43:48.50,Default,,0,0,0,,Арыстандар тобымен қалай күресуге болады!
Dialogue: 0,0:43:48.58,0:43:50.75,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:43:51.00,0:43:52.54,Default,,0,0,0,,Маған жақындама!
Dialogue: 0,0:43:52.67,0:43:53.71,Default,,0,0,0,,Тынш-шыным! (Нобита) Кет!
Dialogue: 0,0:43:54.00,0:43:55.38,Default,,0,0,0,,(Пеконың ырылдауы)
Dialogue: 0,0:43:56.25,0:43:57.38,Default,,0,0,0,,Пеко, қайда бара жатырсың?
Dialogue: 0,0:43:57.50,0:43:58.59,Default,,0,0,0,,Ол... (Нобита) Джан!
Dialogue: 0,0:43:59.17,0:44:01.09,Default,,0,0,0,,Жоқ! Алыс болыңыз!
Dialogue: 0,0:44:01.38,0:44:03.55,Default,,0,0,0,,Ах... аа! (Нобита) Ах!
Dialogue: 0,0:44:03.64,0:44:05.64,Default,,0,0,0,,Ахх (Сунео) Ача~
Dialogue: 0,0:44:06.47,0:44:10.93,Default,,0,0,0,,Уау
Dialogue: 0,0:44:11.31,0:44:12.73,Default,,0,0,0,,(Арыстанның қоқан-лоққысы)
Dialogue: 0,0:44:12.98,0:44:14.36,Default,,0,0,0,,Уау
Dialogue: 0,0:44:14.44,0:44:16.77,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:44:17.19,0:44:18.28,Default,,0,0,0,,Әй, ол бұзылды!
Dialogue: 0,0:44:20.19,0:44:22.70,Default,,0,0,0,,Иә
Dialogue: 0,0:44:25.95,0:44:28.91,Default,,0,0,0,,О
Dialogue: 0,0:44:29.29,0:44:30.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:30.91,0:44:32.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:33.71,0:44:37.88,Default,,0,0,0,,Ой
Dialogue: 0,0:44:39.63,0:44:41.42,Default,,0,0,0,,О
Dialogue: 0,0:44:48.39,0:44:49.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:49.93,0:44:53.48,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:44:53.60,0:44:55.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:55.60,0:44:58.19,Default,,0,0,0,,Патшалыққа жол ашық
Dialogue: 0,0:44:58.32,0:45:00.61,Default,,0,0,0,,Алға, балалар.
Dialogue: 0,0:45:00.73,0:45:02.03,Default,,0,0,0,,Патшалық?
Dialogue: 0,0:45:02.15,0:45:04.57,Default,,0,0,0,,Бұдан тыс патшалық бар ма?
Dialogue: 0,0:45:04.70,0:45:07.62,Default,,0,0,0,,Бұл қандай мемлекет? Қандай жарыс? Халық саны қандай?
Dialogue: 0,0:45:07.74,0:45:09.99,Default,,0,0,0,,Әлі алыс па? (Сунео) Қандай да бір қазына бар ма?
Dialogue: 0,0:45:16.38,0:45:17.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:17.58,0:45:19.09,Default,,0,0,0,,Иә? Пеко жоқ.
Dialogue: 0,0:45:19.21,0:45:20.42,Default,,0,0,0,,Бұл дұрыс. Бұл қайда?
Dialogue: 0,0:45:20.63,0:45:25.22,Default,,0,0,0,,Пекоэ, жүр Пекое, сен қайдасың? Қайда бардың?
Dialogue: 0,0:45:25.34,0:45:27.51,Default,,0,0,0,,Міне болды (Пеко үреді)
Dialogue: 0,0:45:27.64,0:45:29.47,Default,,0,0,0,,Пеко! (Пеко үреді)
Dialogue: 0,0:45:29.60,0:45:30.64,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:45:30.72,0:45:33.39,Default,,0,0,0,,Сен қайда болдың?
Dialogue: 0,0:45:36.35,0:45:37.81,Default,,0,0,0,,А... не болды?
Dialogue: 0,0:45:37.94,0:45:40.69,Default,,0,0,0,,Пеко дәу мүсінге ұқсайды.
Dialogue: 0,0:45:40.82,0:45:42.07,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:45:42.40,0:45:43.99,Default,,0,0,0,,Қызық, байланыс бар ма?
Dialogue: 0,0:45:44.11,0:45:47.03,Default,,0,0,0,,Бұлай болуы мүмкін емес. Бұл кездейсоқтық. Бұл кездейсоқтық.
Dialogue: 0,0:45:47.61,0:45:50.49,Default,,0,0,0,,Бізге тағы бір арыстан шабуыл жасамас бұрын асығайық.
Dialogue: 0,0:45:50.99,0:45:53.95,Default,,0,0,0,,Хмф, маған оның қандай патшалық екені маңызды емес, мен ол жерге тезірек жеткім келеді.
Dialogue: 0,0:45:57.96,0:46:02.25,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:46:13.47,0:46:16.02,Default,,0,0,0,,Жоқ, мен Құдайға сенбеймін.
Dialogue: 0,0:46:16.44,0:46:19.48,Default,,0,0,0,,Сонда бізге ертерек көмектескен бұл не болды?
Dialogue: 0,0:46:19.65,0:46:21.82,Default,,0,0,0,,Бұл... 3D кескін болуы керек.
Dialogue: 0,0:46:21.94,0:46:24.15,Default,,0,0,0,,Лазер сәулесімен ауада жоба
Dialogue: 0,0:46:24.28,0:46:26.20,Default,,0,0,0,,Бұл голограмма сияқты нәрсе болуы керек.
Dialogue: 0,0:46:26.49,0:46:28.53,Default,,0,0,0,,Африканың осы шалғай бөлігіндегі голограмма?
Dialogue: 0,0:46:28.66,0:46:30.12,Default,,0,0,0,,Сонда бұл сәуле ше?
Dialogue: 0,0:46:30.24,0:46:31.83,Default,,0,0,0,,Сіз мұны тіпті білмейсіз!
Dialogue: 0,0:46:31.95,0:46:34.45,Default,,0,0,0,,Енді жоқ... Эй, эй, Шизука-чан, сен қалай ойлайсың?
Dialogue: 0,0:46:35.20,0:46:37.66,Default,,0,0,0,,Runlalan Мен не ойлап отырмын...
Dialogue: 0,0:46:38.08,0:46:39.12,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:46:39.25,0:46:42.00,Default,,0,0,0,,Бұл патшалықта монша бар дегенді білдіре ме?
Dialogue: 0,0:46:42.13,0:46:43.13,Default,,0,0,0,,О, менің...
Dialogue: 0,0:46:43.96,0:46:46.97,Default,,0,0,0,,А, у... Мен Джанкунның пікірін тыңдағым келеді.
Dialogue: 0,0:46:47.09,0:46:48.51,Default,,0,0,0,,Көптен бері үнсіз жүрген сияқтысың...
Dialogue: 0,0:46:48.63,0:46:51.26,Default,,0,0,0,,Иә? Уа, ау? Хмм...
Dialogue: 0,0:46:52.47,0:46:53.68,Default,,0,0,0,,Біртүрлі жігіт
Dialogue: 0,0:46:53.81,0:46:55.56,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:46:55.68,0:46:57.48,Default,,0,0,0,,Мен қатты ашуландым
Dialogue: 0,0:46:57.89,0:47:00.52,Default,,0,0,0,,Таке-кун, адам ретінде мүлде өзгердің.
Dialogue: 0,0:47:00.65,0:47:02.86,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:47:02.98,0:47:06.03,Default,,0,0,0,,Ух... аааа
Dialogue: 0,0:47:06.65,0:47:09.40,Default,,0,0,0,,Ммммммм (4 адам) А...
Dialogue: 0,0:47:09.70,0:47:13.03,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:47:13.41,0:47:15.08,Default,,0,0,0,,Ой! (Нобита және басқалар) Ах...
Dialogue: 0,0:47:15.16,0:47:20.17,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:47:20.87,0:47:22.21,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:47:22.33,0:47:25.05,Default,,0,0,0,,Бұл жиіркенішті дыбыс. (Сунео) Иә...
Dialogue: 0,0:47:25.17,0:47:27.26,Default,,0,0,0,,Біздің көздегеніміз осы.
Dialogue: 0,0:47:27.38,0:47:30.84,Default,,0,0,0,,Ол Одрондоло аңғарынан келе жатқан сияқты.
Dialogue: 0,0:47:39.14,0:47:40.52,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:47:41.94,0:47:43.86,Default,,0,0,0,,Суық...
Dialogue: 0,0:47:45.23,0:47:47.23,Default,,0,0,0,,Бұл киімде суық болуы керек.
Dialogue: 0,0:47:47.36,0:47:49.78,Default,,0,0,0,,Абайлаңыз, аяғыңыз тайып кетеді... А!
Dialogue: 0,0:47:49.90,0:47:52.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:52.41,0:47:55.70,Default,,0,0,0,,Болды... Көрдіңіз бе, мұндай нәрсе болмайды.
Dialogue: 0,0:47:56.37,0:47:58.66,Default,,0,0,0,,Ендеше... пойыз арқанына ұқсаңыз!
Dialogue: 0,0:47:58.91,0:48:02.71,Default,,0,0,0,,Бұл керемет емес. Бұл балабақша емес. Біз пойыздарда ойнаймыз.
Dialogue: 0,0:48:02.83,0:48:05.63,Default,,0,0,0,,Мен сені Залемен ауыстырамын. Сабырлы болыңыз.
Dialogue: 0,0:48:06.13,0:48:08.09,Default,,0,0,0,,Менде жақсы құралдар жоқ.
Dialogue: 0,0:48:08.21,0:48:09.46,Default,,0,0,0,,Жаман көрінсе де
Dialogue: 0,0:48:09.59,0:48:12.51,Default,,0,0,0,,Бұл нағыз пойыз сияқты жылдам.
Dialogue: 0,0:48:12.63,0:48:13.97,Default,,0,0,0,,Кету барысы!
Dialogue: 0,0:48:14.09,0:48:15.30,Default,,0,0,0,,жылдам
Dialogue: 0,0:48:15.39,0:48:17.01,Default,,0,0,0,,Бұл таңқаларлық. Апыр-ай!
Dialogue: 0,0:48:17.10,0:48:21.98,Default,,0,0,0,,Уау! Ааа аа...
Dialogue: 0,0:48:33.20,0:48:36.37,Default,,0,0,0,,Аспанды тұман басып тұр (Сунео), яғни мұнда...
Dialogue: 0,0:48:36.78,0:48:38.58,Default,,0,0,0,,Ауыр темекі шегетін орман
Dialogue: 0,0:48:38.70,0:48:41.33,Default,,0,0,0,,Банзай (Нобита) Иә! Алақай!
Dialogue: 0,0:48:41.50,0:48:43.79,Default,,0,0,0,,Бұл алқаптың ар жағында патшалық бар.
Dialogue: 0,0:48:43.92,0:48:45.83,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:48:46.08,0:48:47.59,Default,,0,0,0,,Бақытты болуға әлі ерте емес пе?
Dialogue: 0,0:48:47.71,0:48:49.13,Default,,0,0,0,,Иә? (Сунео) А...
Dialogue: 0,0:48:49.25,0:48:50.80,Default,,0,0,0,,Мен бұл жардан қалай түсемін?
Dialogue: 0,0:48:52.38,0:48:54.97,Default,,0,0,0,,Күдікті жарық Күдікті дауыс
Dialogue: 0,0:48:55.09,0:48:58.22,Default,,0,0,0,,Түсіп үлгерсең де, алқаптың түбі өлі рухтар елі.
Dialogue: 0,0:48:58.68,0:49:02.18,Default,,0,0,0,,Бізде импровизацияланған лифттен басқа амал жоқ.
Dialogue: 0,0:49:03.10,0:49:06.48,Default,,0,0,0,,Енді төмен түсуден басқа амалымыз жоқ, сонда кім бірінші?
Dialogue: 0,0:49:06.61,0:49:08.15,Default,,0,0,0,,Хмм... ех... (Сунео) Жоқ, у... Мен...
Dialogue: 0,0:49:08.36,0:49:10.03,Default,,0,0,0,,Сунео-кун, бірінші бар.
Dialogue: 0,0:49:10.15,0:49:11.90,Default,,0,0,0,,Нобита-кун бірінші барыңыз.
Dialogue: 0,0:49:12.03,0:49:13.61,Default,,0,0,0,,Өтінемін, бұлай ұстанба.
Dialogue: 0,0:49:13.74,0:49:15.28,Default,,0,0,0,,Уайымдама, Джан.
Dialogue: 0,0:49:15.41,0:49:16.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:16.66,0:49:18.83,Default,,0,0,0,,Хмм... қой!
Dialogue: 0,0:49:18.95,0:49:20.37,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:49:22.62,0:49:23.91,Default,,0,0,0,,Джиан күткендей
Dialogue: 0,0:49:24.04,0:49:26.42,Default,,0,0,0,,Сізде батылдық бар (Нобита) Иә.
Dialogue: 0,0:49:27.96,0:49:29.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:31.30,0:49:32.63,Default,,0,0,0,,Ахх!
Dialogue: 0,0:49:32.71,0:49:37.18,Default,,0,0,0,,Гаар! А... аа!
Dialogue: 0,0:49:37.26,0:49:39.18,Default,,0,0,0,,Джааан! Такеру!
Dialogue: 0,0:49:39.30,0:49:40.76,Default,,0,0,0,,(Джианның күш айқайы)
Dialogue: 0,0:49:41.06,0:49:43.93,Default,,0,0,0,,Бұл өте нәзік тау жынысы. Мен көтеріле алмаймын!
Dialogue: 0,0:49:44.27,0:49:45.23,Default,,0,0,0,,Тез бірдеңе істе, Дораемон
Dialogue: 0,0:49:45.35,0:49:47.06,Default,,0,0,0,,Сен құлайсың! (Нобита) Тезірек!
Dialogue: 0,0:49:47.19,0:49:50.15,Default,,0,0,0,,Бірдеңе істеуге тырыссаң да, бәрі сені тастап кетті.
Dialogue: 0,0:49:50.36,0:49:53.61,Default,,0,0,0,,Иә? Күте тұрыңыз, мүмкін бұл жұмыс істейді.
Dialogue: 0,0:49:53.74,0:49:55.28,Default,,0,0,0,,Гравитациялық бояу!
Dialogue: 0,0:49:55.40,0:49:58.70,Default,,0,0,0,,Бұны боясаңыз, түбі төмен қарай бұрылып, ғимараттардың қабырғалары мен төбелерімен жүруге болады.
Dialogue: 0,0:49:58.82,0:50:00.95,Default,,0,0,0,,Жақсы түсініктеме, асығыңыздар!
Dialogue: 0,0:50:01.08,0:50:03.75,Default,,0,0,0,,Сессия сессиясы Гудшо
Dialogue: 0,0:50:04.00,0:50:06.46,Default,,0,0,0,,Сессия сессиясы Сессия...
Dialogue: 0,0:50:06.62,0:50:09.42,Default,,0,0,0,,Бояу жолынан адасып кетсең, дұрыс емес жерде боласың.
Dialogue: 0,0:50:09.54,0:50:11.34,Default,,0,0,0,,Бұл шамамен 500 метр.
Dialogue: 0,0:50:11.46,0:50:13.46,Default,,0,0,0,,Токио мұнарасынан биік пе?
Dialogue: 0,0:50:16.88,0:50:19.55,Default,,0,0,0,,Бояуым таусылғанда, түбіне жеттім.
Dialogue: 0,0:50:20.55,0:50:22.47,Default,,0,0,0,,Расында да, бұл өлілер елі.
Dialogue: 0,0:50:22.60,0:50:23.68,Default,,0,0,0,,Қараңғы жер екен.
Dialogue: 0,0:50:23.81,0:50:25.02,Default,,0,0,0,,Тез сол жақтағы жартасқа шығайық.
Dialogue: 0,0:50:25.27,0:50:27.35,Default,,0,0,0,,Жердің тереңдігіндей сезіледі.
Dialogue: 0,0:50:27.48,0:50:29.56,Default,,0,0,0,,Көңіл-күй ақыры сиқырлы
Dialogue: 0,0:50:29.69,0:50:30.98,Default,,0,0,0,,Уау! Кя!
Dialogue: 0,0:50:31.06,0:50:32.44,Default,,0,0,0,,Не, не!
Dialogue: 0,0:50:32.52,0:50:33.98,Default,,0,0,0,,Әй, жарық! Ах!
Dialogue: 0,0:50:39.16,0:50:43.66,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:50:43.79,0:50:46.79,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ аулақ болған дұрыс сияқты.
Dialogue: 0,0:50:46.91,0:50:48.25,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:50:48.33,0:50:52.34,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:50:53.25,0:50:55.17,Default,,0,0,0,,Тастар ыңылдап жатыр
Dialogue: 0,0:50:55.30,0:50:58.18,Default,,0,0,0,,Бұл өлілердің дауысы. Өлгендер шақырып жатыр.
Dialogue: 0,0:50:58.26,0:50:59.63,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:50:59.76,0:51:04.14,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:51:04.85,0:51:05.81,Default,,0,0,0,,Чикусо!
Dialogue: 0,0:51:06.27,0:51:10.23,Default,,0,0,0,,Эй, иә, өршіл!
Dialogue: 0,0:51:11.27,0:51:15.32,Default,,0,0,0,,Шаңға айналдым. Джан күшті.
Dialogue: 0,0:51:15.44,0:51:17.44,Default,,0,0,0,,Мен көпшіліктің бір бөлігін басып алдым.
Dialogue: 0,0:51:18.28,0:51:19.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:19.99,0:51:21.11,Default,,0,0,0,,Уау...
Dialogue: 0,0:51:21.24,0:51:25.12,Default,,0,0,0,,Бұл шымтезек тәрізді кішкентай жәндік, оған люминесцентті бактериялар жабысады.
Dialogue: 0,0:51:25.33,0:51:27.58,Default,,0,0,0,,Не? Түрді білгеннен кейін бұл оңай.
Dialogue: 0,0:51:27.70,0:51:30.83,Default,,0,0,0,,Мен ойлағандай, елес деген жоқ.
Dialogue: 0,0:51:31.42,0:51:32.83,Default,,0,0,0,,Өлгендердің дауысы да солай.
Dialogue: 0,0:51:32.96,0:51:35.71,Default,,0,0,0,,Ғылыми түсініктеме бар екеніне сенімдімін. Хмм.
Dialogue: 0,0:51:35.84,0:51:38.92,Default,,0,0,0,,Ащы, ащы, ащы! Ыстық ыстық!
Dialogue: 0,0:51:39.05,0:51:40.22,Default,,0,0,0,,Мм, бірақ мен түсіндім.
Dialogue: 0,0:51:40.34,0:51:42.01,Default,,0,0,0,,Бұл аймақ жанартаулық аймақ.
Dialogue: 0,0:51:42.14,0:51:44.10,Default,,0,0,0,,Сонымен кейде жер астынан бу шығады.
Dialogue: 0,0:51:44.72,0:51:47.56,Default,,0,0,0,,Бұл тесіктерге толы жартастың резонанс тудырып, дыбыс шығаруына әкеледі.
Dialogue: 0,0:51:47.68,0:51:49.56,Default,,0,0,0,,Басқаша айтқанда, бұл флейта сияқты принцип.
Dialogue: 0,0:51:49.64,0:51:51.27,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:51:51.35,0:51:53.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:55.69,0:51:58.57,Default,,0,0,0,,Жарайсың, мен күткен барлықтарыңыздан күткендей.
Dialogue: 0,0:51:59.07,0:52:00.57,Default,,0,0,0,,Пеко сөйледі!
Dialogue: 0,0:52:02.03,0:52:04.66,Default,,0,0,0,,А, мен сені қорқытқым келмеді.
Dialogue: 0,0:52:04.78,0:52:08.54,Default,,0,0,0,,Мен саған ертерек айтып, сенен көмек сұрауым керек еді.
Dialogue: 0,0:52:08.62,0:52:12.08,Default,,0,0,0,,Адамдарға айтсам да, адамдар маған сенбейтін шығар деп ойладым.
Dialogue: 0,0:52:12.21,0:52:15.63,Default,,0,0,0,,Мен сені өз көзіңмен көруің үшін әкелдім.
Dialogue: 0,0:52:15.75,0:52:16.75,Default,,0,0,0,,Иә...
Dialogue: 0,0:52:16.88,0:52:19.21,Default,,0,0,0,,Пеко, сен кімсің?
Dialogue: 0,0:52:19.51,0:52:22.43,Default,,0,0,0,,Бұл князь Кунтак, 108-ші Бованконың ұлы.
Dialogue: 0,0:52:22.55,0:52:24.93,Default,,0,0,0,,Ханзада!? Бованконың баласы!?
Dialogue: 0,0:52:26.47,0:52:28.39,Default,,0,0,0,,Мен белгілі бір себептермен Жапонияға бардым.
Dialogue: 0,0:52:28.52,0:52:30.89,Default,,0,0,0,,Барлығына рахмет, мен үйге қайттым.
Dialogue: 0,0:52:31.23,0:52:33.10,Default,,0,0,0,,Сонда әлгі алып мүсін...
Dialogue: 0,0:52:33.27,0:52:36.61,Default,,0,0,0,,Бұл патшалықтың негізін салған король Бауванко I мүсіні.
Dialogue: 0,0:52:37.07,0:52:39.65,Default,,0,0,0,,Осы асыл таспен бейнеленген
Dialogue: 0,0:52:40.40,0:52:43.11,Default,,0,0,0,,Бұл голограмма сияқты, бірақ сәл басқаша.
Dialogue: 0,0:52:43.24,0:52:46.24,Default,,0,0,0,,Бұл асыл тастың ішінде үлкен мүсіннің әрбір қозғалысы жазылған.
Dialogue: 0,0:52:46.37,0:52:48.83,Default,,0,0,0,,Ол жазылған және суретке сәйкес жылжытуға болады.
Dialogue: 0,0:52:49.45,0:52:53.42,Default,,0,0,0,,Сондай-ақ ауада жоғары кернеулі электр энергиясын өндіруге болады.
Dialogue: 0,0:52:56.71,0:53:00.01,Default,,0,0,0,,А... бұл пайдалы құрал.
Dialogue: 0,0:53:06.80,0:53:08.85,Default,,0,0,0,,Бұл патшалыққа апаратын жол.
Dialogue: 0,0:53:17.98,0:53:20.82,Default,,0,0,0,,Енді бұл жер асты канализациясының кіреберісі.
Dialogue: 0,0:53:20.90,0:53:22.74,Default,,0,0,0,,Иә, сіз жер астына барасыз ба?
Dialogue: 0,0:53:22.86,0:53:24.11,Default,,0,0,0,,Жарайды ма деп ойлаймын...
Dialogue: 0,0:53:24.24,0:53:25.86,Default,,0,0,0,,Ух... аа...
Dialogue: 0,0:53:30.41,0:53:33.83,Default,,0,0,0,,Бұл жер асты суы патшалық көлінен ағып жатыр.
Dialogue: 0,0:53:33.96,0:53:38.42,Default,,0,0,0,,Конго өзенінің тармағына құятын жер асты суының венасын да құрайды.
Dialogue: 0,0:53:39.29,0:53:42.71,Default,,0,0,0,,Мені осы өзен ағып, теңізге кетті.
Dialogue: 0,0:53:42.84,0:53:47.18,Default,,0,0,0,,Патшалық орнағаннан бері далаға шыққан бірінші адаммын.
Dialogue: 0,0:53:48.68,0:53:51.85,Default,,0,0,0,,Бірақ мен бұл иттер патшалығы екеніне сене алмаймын.
Dialogue: 0,0:53:51.97,0:53:53.14,Default,,0,0,0,,Бұл өте біртүрлі.
Dialogue: 0,0:53:53.22,0:53:54.98,Default,,0,0,0,,Бұл өзара.
Dialogue: 0,0:53:55.10,0:53:59.11,Default,,0,0,0,,Мен адам әлемін өз көзіммен көрмейінше сене алмадым.
Dialogue: 0,0:54:00.27,0:54:03.74,Default,,0,0,0,,Жүздеген мың немесе миллиондаған жылдар бұрын болуы мүмкін
Dialogue: 0,0:54:03.86,0:54:07.32,Default,,0,0,0,,Жер қыртысының қозғалысына байланысты Конго ойпатының бір бөлігі құлады.
Dialogue: 0,0:54:07.49,0:54:11.03,Default,,0,0,0,,Сырт дүниемен байланысы үзілген терең аңғармен қоршалған
Dialogue: 0,0:54:12.04,0:54:15.12,Default,,0,0,0,,Содан бастап бұл жабық дүниенің жаратылысы
Dialogue: 0,0:54:15.25,0:54:19.46,Default,,0,0,0,,Ол сыртқы дүниеден мүлде басқа эволюциялық жолды ұстанған сияқты.
Dialogue: 0,0:54:19.58,0:54:23.59,Default,,0,0,0,,Сыртқы әлемде маймылдардың ата-бабалары дамып, адамдар дүниеге келді.
Dialogue: 0,0:54:23.71,0:54:26.97,Default,,0,0,0,,Иттердің ата-бабалары біздің әлемде дамыды.
Dialogue: 0,0:54:27.05,0:54:29.47,Default,,0,0,0,,Ммм
Dialogue: 0,0:54:32.93,0:54:35.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:36.06,0:54:37.14,Default,,0,0,0,,Бұл тұйыққа тіреледі.
Dialogue: 0,0:54:37.27,0:54:38.69,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:54:38.81,0:54:41.52,Default,,0,0,0,,Жолбасшы сабырлы болса қиын болар еді.
Dialogue: 0,0:54:41.65,0:54:45.15,Default,,0,0,0,,Мен ағынмен ғана жүріп, алып кеттім.
Dialogue: 0,0:54:45.28,0:54:47.45,Default,,0,0,0,,Иә, жақсы құралдар бар, солай ма?
Dialogue: 0,0:54:47.57,0:54:49.82,Default,,0,0,0,,Мен оған толықтай сенемін...
Dialogue: 0,0:54:50.20,0:54:52.58,Default,,0,0,0,,Эй, мен тағы да құралдарға сүйенемін.
Dialogue: 0,0:54:52.70,0:54:54.04,Default,,0,0,0,,Мұндай кезде жақсы.
Dialogue: 0,0:54:54.24,0:54:56.62,Default,,0,0,0,,Қайық артқа!
Dialogue: 0,0:54:56.71,0:55:00.17,Default,,0,0,0,,Сарқырамаға өрмелеп бара жатқан сазандай ағысқа қарсы жүр.
Dialogue: 0,0:55:00.29,0:55:02.04,Default,,0,0,0,,Ұшу барысы!
Dialogue: 0,0:55:04.46,0:55:07.63,Default,,0,0,0,,Көрдіңіз бе, ағын неғұрлым тік болса, соғұрлым тезірек артады.
Dialogue: 0,0:55:07.76,0:55:09.01,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:55:09.13,0:55:11.97,Default,,0,0,0,,Ханзада, бақытты емессің бе? Мен біраз уақыттан кейін бірінші рет қайтамын
Dialogue: 0,0:55:12.10,0:55:14.35,Default,,0,0,0,,Мен бақытты болсам, әрине, бақыттымын, бірақ...
Dialogue: 0,0:55:14.89,0:55:17.81,Default,,0,0,0,,Патшалықты қорқынышты жау күтіп тұр.
Dialogue: 0,0:55:18.48,0:55:19.31,Default,,0,0,0,,Жау?
Dialogue: 0,0:55:19.44,0:55:21.81,Default,,0,0,0,,Әр әлемде жаман адамдар бар.
Dialogue: 0,0:55:28.15,0:55:29.78,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:55:30.20,0:55:32.03,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:55:38.16,0:55:39.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:39.54,0:55:40.75,Default,,0,0,0,,Бұл...
Dialogue: 0,0:55:40.87,0:55:41.83,Default,,0,0,0,,Бұл сіздің патшалығыңыз ба?
Dialogue: 0,0:56:14.74,0:56:16.24,Default,,0,0,0,,(Жануарлардың көршісі)
Dialogue: 0,0:56:16.37,0:56:17.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:16.37,0:56:17.41,Default,,0,0,0,,(тұяқ дыбысы)
Dialogue: 0,0:56:17.41,0:56:18.08,Default,,0,0,0,,(тұяқ дыбысы)
Dialogue: 0,0:56:18.08,0:56:18.33,Default,,0,0,0,,(тұяқ дыбысы)
Dialogue: 0,0:56:18.08,0:56:18.33,Default,,0,0,0,,Жатыңыз (барлығыңыз) Ха...
Dialogue: 0,0:56:18.33,0:56:20.12,Default,,0,0,0,,Жатыңыз (барлығыңыз) Ха...
Dialogue: 0,0:56:25.71,0:56:26.96,Default,,0,0,0,,Сіз неден қорқасыз?
Dialogue: 0,0:56:27.92,0:56:31.22,Default,,0,0,0,,Бұл елді қазір Дабурандар басқарады.
Dialogue: 0,0:56:31.34,0:56:32.55,Default,,0,0,0,,Қаһарлы жау
Dialogue: 0,0:56:32.68,0:56:35.97,Default,,0,0,0,,Сіз ешқашан тым сақ бола алмайсыз
Dialogue: 0,0:56:36.10,0:56:38.47,Default,,0,0,0,,Дублендер дегеніміз не?
Dialogue: 0,0:56:39.02,0:56:41.64,Default,,0,0,0,,Менен тақты тартып алған зұлым министр.
Dialogue: 0,0:56:43.77,0:56:45.02,Default,,0,0,0,,Қазір қайда бара жатырсың?
Dialogue: 0,0:56:45.15,0:56:46.40,Default,,0,0,0,,Бұл Бурстың үйі.
Dialogue: 0,0:56:46.56,0:56:48.27,Default,,0,0,0,,Бұл біздің жасырынатын жерімізге өте ыңғайлы болар еді.
Dialogue: 0,0:56:48.40,0:56:50.61,Default,,0,0,0,,Brusus дегеніміз не? Әкемнің гвардия капитаны
Dialogue: 0,0:56:50.74,0:56:54.20,Default,,0,0,0,,Ол осы елдегі ең мықты, ең сенімді адам болды.
Dialogue: 0,0:56:54.32,0:56:56.32,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,0:56:56.70,0:56:58.87,Default,,0,0,0,,Мен құлаған адам (бәрі) О...
Dialogue: 0,0:57:04.58,0:57:06.63,Default,,0,0,0,,Мен қорқатындай.
Dialogue: 0,0:57:06.75,0:57:09.96,Default,,0,0,0,,Дабурандр тұтқынға алды, ол қазір қайда?
Dialogue: 0,0:57:10.09,0:57:11.80,Default,,0,0,0,,Тағы кімге сенуге болады?
Dialogue: 0,0:57:12.34,0:57:14.84,Default,,0,0,0,,Барлығы ұсталды, солай ма?
Dialogue: 0,0:57:14.97,0:57:17.14,Default,,0,0,0,,Дубландер – зерделі адам.
Dialogue: 0,0:57:17.39,0:57:18.64,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:57:18.76,0:57:20.56,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:57:20.68,0:57:22.89,Default,,0,0,0,,Мен шомылғым келеді.
Dialogue: 0,0:57:23.02,0:57:26.40,Default,,0,0,0,,Жоқ, жоқ, жоқ па?
Dialogue: 0,0:57:26.69,0:57:30.90,Default,,0,0,0,,Уау, жоқ, жоқ, жоқ! (Солдат) Мына жігіт күте ме?
Dialogue: 0,0:57:32.69,0:57:34.61,Default,,0,0,0,,Ой, мені жібер!
Dialogue: 0,0:57:34.74,0:57:36.74,Default,,0,0,0,,Бұл жігіттің қашып кетуіне жол беруім керек пе?
Dialogue: 0,0:57:36.87,0:57:38.74,Default,,0,0,0,,О, эй!
Dialogue: 0,0:57:39.20,0:57:40.37,Default,,0,0,0,,Тей
Dialogue: 0,0:57:41.08,0:57:42.83,Default,,0,0,0,,Сіз өзіңіздің серіктесіңізге солай істейсіз бе?
Dialogue: 0,0:57:42.95,0:57:44.16,Default,,0,0,0,,Ха ха ха!
Dialogue: 0,0:57:44.25,0:57:45.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:57:45.62,0:57:46.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:57:47.50,0:57:48.75,Default,,0,0,0,,Уау! Сәлем!
Dialogue: 0,0:57:50.30,0:57:52.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:57:52.63,0:57:53.84,Default,,0,0,0,,Ai…
Dialogue: 0,0:57:59.43,0:58:01.76,Default,,0,0,0,,Иә? Бұл ханзада! (2-солдат) Эй...
Dialogue: 0,0:58:02.06,0:58:03.89,Default,,0,0,0,,Көмектесіңіз! (2-солдат) Жүгір!
Dialogue: 0,0:58:06.06,0:58:07.94,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:58:08.86,0:58:12.69,Default,,0,0,0,,Мен солдаттың түскі асын ертерек жедім, сондықтан бара алмадым.
Dialogue: 0,0:58:12.82,0:58:15.40,Default,,0,0,0,,Бірақ менің қарным ашқаны сонша, өлемін деп ойладым.
Dialogue: 0,0:58:15.78,0:58:18.74,Default,,0,0,0,,Мм, әкең мен анаң ше?
Dialogue: 0,0:58:18.87,0:58:21.37,Default,,0,0,0,,Ауылдың көпшілігін де алып кетті.
Dialogue: 0,0:58:21.95,0:58:24.79,Default,,0,0,0,,Ол жаңа қару жасамақшы.
Dialogue: 0,0:58:24.91,0:58:27.08,Default,,0,0,0,,Өрт сөндіру машиналары, ұшатын кемелер және т.б.
Dialogue: 0,0:58:27.33,0:58:29.71,Default,,0,0,0,,Не! Дубландерден келген...
Dialogue: 0,0:58:29.83,0:58:32.55,Default,,0,0,0,,Ол өзінің қорқынышты жоспарын іске асыра бастады.
Dialogue: 0,0:58:33.17,0:58:35.38,Default,,0,0,0,,Не? Сол қорқынышты жоспар
Dialogue: 0,0:58:35.51,0:58:36.42,Default,,0,0,0,,Әлемді жаулап алу
Dialogue: 0,0:58:37.01,0:58:40.80,Default,,0,0,0,,...
Dialogue: 0,0:58:40.93,0:58:43.52,Default,,0,0,0,,...
Dialogue: 0,0:59:16.51,0:59:19.01,Default,,0,0,0,,...
Dialogue: 0,0:59:19.13,0:59:22.47,Default,,0,0,0,,Осы арқылы сіз сыртқы әлемде ешбір жаудан қорықпайсыз.
Dialogue: 0,0:59:22.68,0:59:23.85,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:59:23.97,0:59:26.85,Default,,0,0,0,,...
Dialogue: 0,0:59:26.98,0:59:30.44,Default,,0,0,0,,...
Dialogue: 0,0:59:30.56,0:59:34.44,Default,,0,0,0,,...
Dialogue: 0,0:59:34.98,0:59:37.03,Default,,0,0,0,,Не? Ханзада?
Dialogue: 0,0:59:37.15,0:59:40.41,Default,,0,0,0,,Жоқ, бұл дұрыс болуы мүмкін емес. Ол міндетті түрде өлді.
Dialogue: 0,0:59:40.57,0:59:42.82,Default,,0,0,0,,Бірақ мен сіздің жүзіңізді анық көрдім.
Dialogue: 0,0:59:42.95,0:59:44.83,Default,,0,0,0,,Ол міндетті түрде ханзада болған.
Dialogue: 0,0:59:44.95,0:59:47.54,Default,,0,0,0,,５
Dialogue: 0,0:59:47.66,0:59:51.33,Default,,0,0,0,,…  １
Dialogue: 0,0:59:51.54,0:59:53.67,Default,,0,0,0,,Хмм, мен оны лақтыра алмаймын.
Dialogue: 0,0:59:53.79,0:59:56.34,Default,,0,0,0,,Кез келген күдікті адамды ұстаңыз.
Dialogue: 0,0:59:56.55,0:59:59.67,Default,,0,0,0,,Нағыз ханзада болса, қылыш шебері.
Dialogue: 0,0:59:59.80,1:00:02.76,Default,,0,0,0,,Капитан Саберді жіберген дұрыс болар еді.
Dialogue: 0,1:00:02.89,1:00:03.80,Default,,0,0,0,,Хмм
Dialogue: 0,1:00:20.49,1:00:24.03,Default,,0,0,0,,Шу болып жатыр. Үйді тастап кету дұрыс болды.
Dialogue: 0,1:00:36.25,1:00:39.80,Default,,0,0,0,,Сол алып мүсінді 5000 жыл бұрын король Бауванко I жасаған.
Dialogue: 0,1:00:39.92,1:00:42.84,Default,,0,0,0,,Осы патшалықтың қамқоршы құдайы ретінде салынған.
Dialogue: 0,1:00:43.13,1:00:46.05,Default,,0,0,0,,Шындығында, от тұтанатын машиналар мен ұшатын кемелер
Dialogue: 0,1:00:46.18,1:00:50.10,Default,,0,0,0,,Ол бұрыннан ойлап табылған, бірақ дана Бауванко И
Dialogue: 0,1:00:50.22,1:00:54.56,Default,,0,0,0,,Қарудың шексіз дамуы дүниенің жойылуына әкеледі деп есептелді.
Dialogue: 0,1:00:54.69,1:00:57.19,Default,,0,0,0,,Маған зерттеу жүргізуге тыйым салынды.
Dialogue: 0,1:00:57.32,1:01:03.36,Default,,0,0,0,,Биік таулар мен терең аңғарлармен қоршалған, Төменнен көтерілген тұманға оранған.
Dialogue: 0,1:01:03.49,1:01:07.58,Default,,0,0,0,,Сырттан келген жаудан қауіп төндірмей, бейбіт түрде өркендеді.
Dialogue: 0,1:01:07.70,1:01:09.74,Default,,0,0,0,,Алайда әкемнің ұрпағы келгенде,
Dialogue: 0,1:01:09.87,1:01:12.87,Default,,0,0,0,,Министр Даврандардың амбициялары болды.
Dialogue: 0,1:01:13.00,1:01:16.17,Default,,0,0,0,,Доктор Кос көне қаруларды жасырын түрде зерттесін.
Dialogue: 0,1:01:16.29,1:01:20.00,Default,,0,0,0,,Ол сыртқы дүниені өз территориясына айналдыруды жоспарлады.
Dialogue: 0,1:01:20.13,1:01:23.30,Default,,0,0,0,,Мұны білген әкем Даврандарға ұрысып қалды.
Dialogue: 0,1:01:23.88,1:01:27.80,Default,,0,0,0,,Бірақ ол тек осы үшін ғана бас тартатындай емес еді.
Dialogue: 0,1:01:28.26,1:01:31.72,Default,,0,0,0,,Әкемді өлтіріп, мені табытқа қамады.
Dialogue: 0,1:01:31.85,1:01:35.40,Default,,0,0,0,,２
Dialogue: 0,1:01:35.65,1:01:38.15,Default,,0,0,0,,Зиратқа барар жолда Көл жағасында
Dialogue: 0,1:01:38.27,1:01:41.15,Default,,0,0,0,,Мен табытпен бірге вагоннан құладым.
Dialogue: 0,1:01:41.23,1:01:44.15,Default,,0,0,0,,Дәл осылай мен сол жер асты суының ағынына ілініп қалдым.
Dialogue: 0,1:01:44.28,1:01:47.07,Default,,0,0,0,,Олар Конго өзенінің сағасына жетті.
Dialogue: 0,1:01:47.20,1:01:51.08,Default,,0,0,0,,Мен адасқан кезде мені теңізші алып кетті.
Dialogue: 0,1:01:51.20,1:01:53.12,Default,,0,0,0,,Жапон кемесінде теңізші болған.
Dialogue: 0,1:01:53.25,1:01:57.17,Default,,0,0,0,,Мен жапон тілін Жапонияға саяхатта үйрендім.
Dialogue: 0,1:01:57.42,1:01:59.67,Default,,0,0,0,,Адам әлемін алғаш рет көру...
Dialogue: 0,1:01:59.79,1:02:01.46,Default,,0,0,0,,Адамзат қоғамында И
Dialogue: 0,1:02:01.55,1:02:04.26,Default,,0,0,0,,Ит сияқты әрекет ету қауіпсіз деп санайды
Dialogue: 0,1:02:04.38,1:02:06.68,Default,,0,0,0,,Мен үйге қайту мүмкіндігін жасырын күттім.
Dialogue: 0,1:02:06.80,1:02:09.35,Default,,0,0,0,,Содан мен Нобита мен оның достарын кездестірдім.
Dialogue: 0,1:02:09.47,1:02:11.43,Default,,0,0,0,,Хмм, солай ма?
Dialogue: 0,1:02:11.56,1:02:13.39,Default,,0,0,0,,Қандай драмалық тағдыр.
Dialogue: 0,1:02:13.52,1:02:15.35,Default,,0,0,0,,Қалай болғанда да, бұл Да Ландер?
Dialogue: 0,1:02:15.48,1:02:16.56,Default,,0,0,0,,Хидена, мүлде емес...
Dialogue: 0,1:02:16.69,1:02:18.56,Default,,0,0,0,,Қалай болғанда да, Бурсус мырза.
Dialogue: 0,1:02:18.69,1:02:19.61,Default,,0,0,0,,Іздеп көрейік (Нобита) Иә.
Dialogue: 0,1:02:27.07,1:02:28.24,Default,,0,0,0,,Оған күмән жоқ сияқты.
Dialogue: 0,1:02:28.36,1:02:31.28,Default,,0,0,0,,Ол қамалдың жер астындағы балауыз бұйымдарының ең терең жерінде жасырылған дейді.
Dialogue: 0,1:02:31.41,1:02:33.08,Default,,0,0,0,,Жарайды, сәттілік.
Dialogue: 0,1:02:34.62,1:02:35.75,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,1:02:38.46,1:02:41.63,Default,,0,0,0,,Құрсаудан өтіңіз!
Dialogue: 0,1:02:44.01,1:02:45.51,Default,,0,0,0,,Ммм.
Dialogue: 0,1:03:02.69,1:03:03.86,Default,,0,0,0,,Брюс
Dialogue: 0,1:03:03.98,1:03:05.94,Default,,0,0,0,,Брюс! О?
Dialogue: 0,1:03:07.95,1:03:09.53,Default,,0,0,0,,Бұл менмін, Брюс.
Dialogue: 0,1:03:10.66,1:03:12.49,Default,,0,0,0,,Сол дауыс, иіс
Dialogue: 0,1:03:15.41,1:03:16.45,Default,,0,0,0,,Құрметті Құт-береке Құдайының шын мәнінде Нора ұстайтын сиқыршы екеніне сену қиын.
Dialogue: 0,1:03:16.75,1:03:19.00,Default,,0,0,0,,Ханзада! Тыныш
Dialogue: 0,1:03:22.25,1:03:23.54,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,1:03:23.67,1:03:25.55,Default,,0,0,0,,Әй, жоқкойшо
Dialogue: 0,1:03:25.67,1:03:26.84,Default,,0,0,0,,Әй, Брюс!
Dialogue: 0,1:03:26.96,1:03:30.30,Default,,0,0,0,,Бұл жай ғана арман ба? Ханзада, қош келдіңіз және аман болыңыз ...
Dialogue: 0,1:03:30.64,1:03:33.39,Default,,0,0,0,,Бұл туралы кейінірек айтамын. Асықшы! Асықшы!
Dialogue: 0,1:03:33.55,1:03:34.97,Default,,0,0,0,,Құрсау арқылы қара.
Dialogue: 0,1:03:35.68,1:03:38.39,Default,,0,0,0,,Ах, уау!
Dialogue: 0,1:03:38.52,1:03:41.65,Default,,0,0,0,,Ааа! (Солдат) Сіз кімсіз? Күте тұрыңыз!
Dialogue: 0,1:03:41.77,1:03:44.61,Default,,0,0,0,,Хмф! (Солдат) Уау!
Dialogue: 0,1:03:45.07,1:03:46.11,Default,,0,0,0,,Иә? Не?
Dialogue: 0,1:03:46.61,1:03:48.61,Default,,0,0,0,,Әй, қаш! Асығыңыз, асығыңыз!
Dialogue: 0,1:03:48.86,1:03:50.57,Default,,0,0,0,,Да, иә!
Dialogue: 0,1:03:50.70,1:03:52.03,Default,,0,0,0,,(Амон) Нагачика? (Хайд) Ах, Амон-сан.
Dialogue: 0,1:03:52.91,1:03:55.79,Default,,0,0,0,,(Сарбаздардың ыңырануы)
Dialogue: 0,1:03:55.87,1:03:58.75,Default,,0,0,0,,Қашу! (Сарбаздар) Маған қашып кетпеңіздер!
Dialogue: 0,1:03:58.87,1:04:01.46,Default,,0,0,0,,Балауызды сындыру! Қашу!
Dialogue: 0,1:04:06.96,1:04:08.67,Default,,0,0,0,,Ханшайым!
Dialogue: 0,1:04:09.72,1:04:12.43,Default,,0,0,0,,Ха ха ха... қауесеттер рас еді.
Dialogue: 0,1:04:12.55,1:04:14.14,Default,,0,0,0,,Ханзада үйіне оралды.
Dialogue: 0,1:04:14.35,1:04:15.64,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,1:04:15.76,1:04:17.31,Default,,0,0,0,,Мен сендім.
Dialogue: 0,1:04:17.43,1:04:21.85,Default,,0,0,0,,Оның қайтыс болғаны өтірік.
Dialogue: 0,1:04:21.94,1:04:24.48,Default,,0,0,0,,Ханзада, мен сізбен жақын арада кездескім келеді...
Dialogue: 0,1:04:24.61,1:04:27.15,Default,,0,0,0,,Алданба, ханшайым.
Dialogue: 0,1:04:27.28,1:04:28.65,Default,,0,0,0,,Не? (Дабуранда) Ханзада
Dialogue: 0,1:04:28.78,1:04:32.61,Default,,0,0,0,,Бұл сенің атыңа ұқсайтын алаяқ. Жақында тұтқынға түсесің.
Dialogue: 0,1:04:32.82,1:04:34.66,Default,,0,0,0,,Ах... (Да Ландер) Олар жиіркенішті.
Dialogue: 0,1:04:34.78,1:04:36.58,Default,,0,0,0,,Мен саған бірден өлім жазасын беремін!
Dialogue: 0,1:04:36.66,1:04:39.50,Default,,0,0,0,,Тыңдаңыз, оның бұл қаладан кеткеніне ешқандай дәлел жоқ.
Dialogue: 0,1:04:39.62,1:04:41.54,Default,,0,0,0,,Ол әрқашан бір жерде жасырылады.
Dialogue: 0,1:04:41.83,1:04:44.42,Default,,0,0,0,,Әрбір үйді мұқият іздеңіз.
Dialogue: 0,1:04:44.54,1:04:46.96,Default,,0,0,0,,Шатырды және еден астын назардан тыс қалдырмаңыз!
Dialogue: 0,1:04:47.17,1:04:49.17,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:04:49.26,1:04:52.76,Default,,0,0,0,,Бұл! Ммм!
Dialogue: 0,1:04:52.88,1:04:54.26,Default,,0,0,0,,Сіз сонда болдыңыз ба?
Dialogue: 0,1:04:55.01,1:04:58.06,Default,,0,0,0,,Жалған ханзада, 4 маймыл және 1 енот ит.
Dialogue: 0,1:04:58.18,1:05:00.43,Default,,0,0,0,,Оны тапқан адамға сыйлық беріледі.
Dialogue: 0,1:05:00.56,1:05:03.19,Default,,0,0,0,,Жасырсаң өлім жазасына кесіледі.
Dialogue: 0,1:05:03.27,1:05:07.27,Default,,0,0,0,,(иттердің сыбдыры)
Dialogue: 0,1:05:10.40,1:05:12.70,Default,,0,0,0,,Мен енот емеспін Ит деген не?
Dialogue: 0,1:05:12.82,1:05:15.03,Default,,0,0,0,,Айқайласаң табасың, өйткені...
Dialogue: 0,1:05:15.49,1:05:19.08,Default,,0,0,0,,Мәртебелі Бованко І-нің пайғамбарлығы үшін рахмет.
Dialogue: 0,1:05:19.20,1:05:21.50,Default,,0,0,0,,Біз мұны орындағалы жатырмыз.
Dialogue: 0,1:05:21.58,1:05:23.54,Default,,0,0,0,,Пайғамбарлық? Бұл не? Яғни
Dialogue: 0,1:05:23.66,1:05:26.04,Default,,0,0,0,,Бұл Ұлы мәртебелі Біріншіден қалған сөздер.
Dialogue: 0,1:05:26.58,1:05:30.42,Default,,0,0,0,,5000 жылдан кейін патшалық дүрбелеңге түсіп, ауыр дағдарыс орын алды.
Dialogue: 0,1:05:30.55,1:05:32.51,Default,,0,0,0,,Сол кезде 10 шетелдік
Dialogue: 0,1:05:32.63,1:05:36.01,Default,,0,0,0,,Алып құдайдың жүрегін елжіретіп, ел сақтасаң
Dialogue: 0,1:05:36.34,1:05:39.93,Default,,0,0,0,,Әй, 10 шетелдік деп бізді айтасың ба?
Dialogue: 0,1:05:40.06,1:05:41.97,Default,,0,0,0,,Өйткені бес адам ғана, солай ма?
Dialogue: 0,1:05:42.35,1:05:44.81,Default,,0,0,0,,Қалған 5 адам қайдан келеді?
Dialogue: 0,1:05:44.94,1:05:47.27,Default,,0,0,0,,Біраз күтуім керек пе?
Dialogue: 0,1:05:47.40,1:05:49.69,Default,,0,0,0,,Келіңіздер... Оған менің шамасым жоқ.
Dialogue: 0,1:05:49.82,1:05:51.48,Default,,0,0,0,,Тез арада әрекет ету керек
Dialogue: 0,1:05:51.61,1:05:55.45,Default,,0,0,0,,Брюс Алып құдайдың жүрегін елжірететін не?
Dialogue: 0,1:05:55.57,1:05:56.91,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:05:57.03,1:05:59.37,Default,,0,0,0,,Бірақ, ол тас мүсін қуыс.
Dialogue: 0,1:05:59.49,1:06:01.37,Default,,0,0,0,,Ішке кіруге болады деп естідім.
Dialogue: 0,1:06:01.49,1:06:04.21,Default,,0,0,0,,Егер сіз ол жерге барсаңыз, сіз бір анықтама таба аласыз.
Dialogue: 0,1:06:04.33,1:06:05.58,Default,,0,0,0,,(Чиппоның айқайы)
Dialogue: 0,1:06:06.00,1:06:08.04,Default,,0,0,0,,Мен аштықтан өлетін сияқтымын.
Dialogue: 0,1:06:08.17,1:06:10.00,Default,,0,0,0,,Әй, енді ойлап қарасам, біз де...
Dialogue: 0,1:06:10.13,1:06:13.38,Default,,0,0,0,,Иә, мен көптен бері тамақтанбадым. Мен құлап қалмағаным таң қалдырады.
Dialogue: 0,1:06:13.46,1:06:15.55,Default,,0,0,0,,Уау... уау...
Dialogue: 0,1:06:15.97,1:06:20.18,Default,,0,0,0,,Дұрыс, мен оны пайдаланып көремін...
Dialogue: 0,1:06:20.30,1:06:22.01,Default,,0,0,0,,Алдын ала уәде беру машинасы
Dialogue: 0,1:06:22.47,1:06:25.85,Default,,0,0,0,,Егер мұны кейінірек жасауға уәде берсеңіз,
Dialogue: 0,1:06:25.98,1:06:29.77,Default,,0,0,0,,Нәтижесін алдын ала болжауға болады... Жарайды, байқап көріңіз.
Dialogue: 0,1:06:29.90,1:06:33.19,Default,,0,0,0,,Уәде беремін, ертең міндетті түрде кешкі ас ішемін.
Dialogue: 0,1:06:33.32,1:06:36.82,Default,,0,0,0,,Дәл қазір қарныңызды толтырыңыз.
Dialogue: 0,1:06:39.41,1:06:42.16,Default,,0,0,0,,О, өте жақсы иіс.
Dialogue: 0,1:06:42.28,1:06:45.08,Default,,0,0,0,,Аузыңыздағы дәмді дәм...
Dialogue: 0,1:06:48.54,1:06:50.79,Default,,0,0,0,,Менің ішім бірте-бірте ісіп барады.
Dialogue: 0,1:06:51.17,1:06:52.38,Default,,0,0,0,,Бұл біртүрлі
Dialogue: 0,1:06:52.50,1:06:53.84,Default,,0,0,0,,Бұл пайдалы құрал
Dialogue: 0,1:06:53.96,1:06:56.30,Default,,0,0,0,,Бір айға жететін тамағым бар.
Dialogue: 0,1:06:56.38,1:06:59.26,Default,,0,0,0,,Уф... Тойғаным сонша, енді тамақ іше алмаймын
Dialogue: 0,1:06:59.34,1:07:01.80,Default,,0,0,0,,Ухухуху Барлығының көңілінен шықты ма?
Dialogue: 0,1:07:01.93,1:07:03.01,Default,,0,0,0,,Оның орнына ертең
Dialogue: 0,1:07:03.14,1:07:05.77,Default,,0,0,0,,Бүгін мен де кешкі ас ішуім керек.
Dialogue: 0,1:07:06.06,1:07:08.98,Default,,0,0,0,,Олай болса, түнде алып мүсінге кірейік.
Dialogue: 0,1:07:09.10,1:07:10.69,Default,,0,0,0,,Оған дейін бір ұйықтап алайық.
Dialogue: 0,1:07:17.90,1:07:21.49,Default,,0,0,0,,Менде бір нәрсе бар. Спиана ханшайымы қауіпсіз бе?
Dialogue: 0,1:07:21.62,1:07:23.53,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,1:07:23.66,1:07:26.04,Default,,0,0,0,,Сіздің жағдайыңыз жақсы және әлі де король сарайындағы бөлмеде тұрып жатырсыз деп үміттенемін.
Dialogue: 0,1:07:26.16,1:07:27.58,Default,,0,0,0,,Жақсы
Dialogue: 0,1:07:28.54,1:07:30.29,Default,,0,0,0,,Мен сені жақын арада көргім келеді
Dialogue: 0,1:07:30.96,1:07:33.34,Default,,0,0,0,,Эй, сен маған мына машинаны бере аласың ба?
Dialogue: 0,1:07:33.46,1:07:34.46,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:07:34.59,1:07:36.46,Default,,0,0,0,,Иә, сәл күте тұрыңыз...
Dialogue: 0,1:07:38.17,1:07:41.30,Default,,0,0,0,,Мен ертең міндетті түрде шомыламын...
Dialogue: 0,1:07:45.35,1:07:48.02,Default,,0,0,0,,Уху-ахха…
Dialogue: 0,1:07:49.69,1:07:54.15,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,1:07:54.48,1:07:58.19,Default,,0,0,0,,Не айтып тұрсың! Осыншама әскерді жұмылдырып жатқанда
Dialogue: 0,1:07:58.32,1:08:00.70,Default,,0,0,0,,Бір түйінді түсіне алмау деген нені білдіреді?
Dialogue: 0,1:08:00.82,1:08:03.62,Default,,0,0,0,,Бар күшімді салдым, бірақ көкке көтерілдім бе, жерге баттым ба?
Dialogue: 0,1:08:03.78,1:08:08.29,Default,,0,0,0,,Аузыңды жап! Ол құбыжық емес, әзілдейтін уақыт емес.
Dialogue: 0,1:08:08.62,1:08:10.41,Default,,0,0,0,,Өтінемін, тыныш отырыңыз.
Dialogue: 0,1:08:10.50,1:08:11.83,Default,,0,0,0,,Сіз әлі де жасай алатын қадамдар бар.
Dialogue: 0,1:08:11.96,1:08:14.34,Default,,0,0,0,,Егер олар қозғалса, түнде болады.
Dialogue: 0,1:08:14.46,1:08:18.76,Default,,0,0,0,,Қараңғылық жамылған олар алып мүсінді көздеп отырған шығар.
Dialogue: 0,1:08:18.84,1:08:21.68,Default,,0,0,0,,Үлкен мүсін? Бұл нені білдіреді?
Dialogue: 0,1:08:21.97,1:08:24.39,Default,,0,0,0,,Көне аңыз бар.
Dialogue: 0,1:08:24.51,1:08:29.64,Default,,0,0,0,,Ел іші аласапыран кезде 10 келімсек алып құдайдың жүрегіне тиіп, елді аман алып қалды.
Dialogue: 0,1:08:29.89,1:08:31.31,Default,,0,0,0,,Сонымен олар
Dialogue: 0,1:08:31.44,1:08:34.61,Default,,0,0,0,,Менің ойымша, бұл шетелдік болуы мүмкін...
Dialogue: 0,1:08:34.69,1:08:38.73,Default,,0,0,0,,Хмм...
Dialogue: 0,1:09:02.42,1:09:03.80,Default,,0,0,0,,Жақында біз сонда боламыз.
Dialogue: 0,1:09:03.93,1:09:05.22,Default,,0,0,0,,Бұл тез болды.
Dialogue: 0,1:09:05.34,1:09:07.68,Default,,0,0,0,,Таппаймын деп қобалжыдым.
Dialogue: 0,1:09:07.81,1:09:09.89,Default,,0,0,0,,Шынында да, солдаттар көп болды.
Dialogue: 0,1:09:10.02,1:09:11.98,Default,,0,0,0,,Қызық, қайда кетті?
Dialogue: 0,1:09:12.52,1:09:14.23,Default,,0,0,0,,Уайымдама...
Dialogue: 0,1:09:47.80,1:09:48.93,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:09:51.72,1:09:53.02,Default,,0,0,0,,О, жоқ!
Dialogue: 0,1:09:53.10,1:09:53.93,Default,,0,0,0,,Иә? (Нобита) А?
Dialogue: 0,1:09:54.06,1:09:54.98,Default,,0,0,0,,Не? иә?
Dialogue: 0,1:09:55.06,1:09:56.44,Default,,0,0,0,,Не? О?
Dialogue: 0,1:09:56.52,1:09:59.02,Default,,0,0,0,,Күте тұрыңыз!тоқта!
Dialogue: 0,1:10:04.45,1:10:06.24,Default,,0,0,0,,Қақпанға түсіп қалды
Dialogue: 0,1:10:06.36,1:10:09.33,Default,,0,0,0,,Бұл көңілсіз. Алып мүсінге де жеттік.
Dialogue: 0,1:10:10.83,1:10:13.54,Default,,0,0,0,,Маған қалдырыңыз, князьдер.
Dialogue: 0,1:10:13.66,1:10:16.33,Default,,0,0,0,,Қандай жағдай болмасын, алып мүсінді көздейсің деп сенемін!
Dialogue: 0,1:10:16.46,1:10:17.29,Default,,0,0,0,,Брюс!
Dialogue: 0,1:10:17.58,1:10:19.54,Default,,0,0,0,,Келіңіздер! Мен сенің қарсыласыңмын
Dialogue: 0,1:10:19.67,1:10:22.42,Default,,0,0,0,,Хаааааай! (Сарбаздар) Ооо...
Dialogue: 0,1:10:22.50,1:10:26.05,Default,,0,0,0,,Хааааааа!
Dialogue: 0,1:10:26.76,1:10:28.09,Default,,0,0,0,,Ханзада! тез!
Dialogue: 0,1:10:28.22,1:10:31.39,Default,,0,0,0,,Олай болса, өтінемін, Брюс! Сәлем!
Dialogue: 0,1:10:33.02,1:10:36.52,Default,,0,0,0,,Алып мүсінге жеткенше жол ашылатыны сөзсіз.
Dialogue: 0,1:10:36.64,1:10:38.23,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін.
Dialogue: 0,1:10:38.35,1:10:40.31,Default,,0,0,0,,Оған дейін аман бол, Брюс!
Dialogue: 0,1:10:46.95,1:10:48.82,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,1:10:53.29,1:10:58.62,Default,,0,0,0,,(Қашып кеткендердің дауыстары)
Dialogue: 0,1:11:17.27,1:11:18.81,Default,,0,0,0,,Әй, уау!
Dialogue: 0,1:11:22.06,1:11:23.32,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:28.86,1:11:32.74,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,1:11:36.12,1:11:37.66,Default,,0,0,0,,Жалған ханзада және оның бандасы
Dialogue: 0,1:11:37.79,1:11:40.54,Default,,0,0,0,,Осы уақытқа дейін орман қоршауда.
Dialogue: 0,1:11:40.83,1:11:44.42,Default,,0,0,0,,Берілмей, тыныш шықсаң, мынау болады!
Dialogue: 0,1:11:53.97,1:11:56.31,Default,,0,0,0,,Жалған ханзада және оның бандасы
Dialogue: 0,1:11:56.39,1:11:57.60,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,1:11:57.73,1:12:01.60,Default,,0,0,0,,Қой, тыныш шық!
Dialogue: 0,1:12:05.32,1:12:07.44,Default,,0,0,0,,Ұрыс болған сияқты.
Dialogue: 0,1:12:07.57,1:12:11.11,Default,,0,0,0,,Бұл менің басымнан өтті, мен қалай кешірім сұрарымды білмеймін.
Dialogue: 0,1:12:11.78,1:12:15.12,Default,,0,0,0,,Біз басқа шетелдіктерді тарта алмаймыз.
Dialogue: 0,1:12:15.45,1:12:17.91,Default,,0,0,0,,Осы орман арқылы оңтүстікке барсаңыз, көлге келесіз.
Dialogue: 0,1:12:18.04,1:12:20.58,Default,,0,0,0,,Ал жерасты канализациясы арқылы қашыңыз.
Dialogue: 0,1:12:20.71,1:12:22.83,Default,,0,0,0,,Осы арада мен жауды тартамын.
Dialogue: 0,1:12:22.96,1:12:24.59,Default,,0,0,0,,Барлық көмектеріңіз үшін рахмет.
Dialogue: 0,1:12:24.88,1:12:27.55,Default,,0,0,0,,Чиппо, әкелеріңмен жақын арада кездесесің деп үміттенемін.
Dialogue: 0,1:12:27.88,1:12:29.51,Default,,0,0,0,,Ханзада…
Dialogue: 0,1:12:29.80,1:12:32.38,Default,,0,0,0,,Қош бол! Ах...
Dialogue: 0,1:12:34.72,1:12:36.68,Default,,0,0,0,,Ханзада!
Dialogue: 0,1:12:38.81,1:12:40.35,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:48.36,1:12:50.69,Default,,0,0,0,,Пекоға ғана жетпейді, мен де барамын.
Dialogue: 0,1:12:50.82,1:12:52.36,Default,,0,0,0,,Балалар, тезірек көлге бет алыңдар!
Dialogue: 0,1:12:52.49,1:12:53.53,Default,,0,0,0,,Тоқта, Джан!
Dialogue: 0,1:12:53.66,1:12:55.32,Default,,0,0,0,,Өлетін сияқты.
Dialogue: 0,1:12:55.41,1:12:59.45,Default,,0,0,0,,Шу, тез бармасаң, орман өртіне күйіп өлесің.
Dialogue: 0,1:12:59.83,1:13:01.29,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:13:01.54,1:13:03.75,Default,,0,0,0,,Жоқ, Джан, қайтып кел!
Dialogue: 0,1:13:03.87,1:13:05.25,Default,,0,0,0,,Иә? мен бардым
Dialogue: 0,1:13:06.13,1:13:10.76,Default,,0,0,0,,Такеши-кун өзінше жауапкершілікті сезінді.
Dialogue: 0,1:13:10.88,1:13:13.22,Default,,0,0,0,,Ендеше, мұны еркек сияқты істе...
Dialogue: 0,1:13:15.34,1:13:20.35,Default,,0,0,0,,♪〜
Dialogue: 0,1:13:56.01,1:13:57.97,Default,,0,0,0,,(ұшатын дыбыс)
Dialogue: 0,1:14:45.23,1:14:50.23,Default,,0,0,0,,〜♪
Dialogue: 0,1:15:02.49,1:15:03.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:07.08,1:15:09.67,Default,,0,0,0,,Күткендей ол өзін жалған ханзада деп атайды.
Dialogue: 0,1:15:09.79,1:15:11.29,Default,,0,0,0,,Жоғары қарауға батылдық
Dialogue: 0,1:15:17.59,1:15:20.14,Default,,0,0,0,,Тұғырға жақындағанда, мүмкіндігінше жылдам жүгір
Dialogue: 0,1:15:20.26,1:15:22.22,Default,,0,0,0,,Ішке бір адамды да кіргізе алсақ, жақсы боламыз.
Dialogue: 0,1:15:22.30,1:15:23.10,Default,,0,0,0,,Иә
Dialogue: 0,1:15:23.18,1:15:25.31,Default,,0,0,0,,Пайғамбарлықта тағы 5 шетелдік бар
Dialogue: 0,1:15:25.43,1:15:26.68,Default,,0,0,0,,Ақырында сен келмеді.
Dialogue: 0,1:15:26.85,1:15:29.90,Default,,0,0,0,,Ей, мұндай ырымға пайғамбарлық ретінде сенуге бола ма?
Dialogue: 0,1:15:30.52,1:15:32.81,Default,,0,0,0,,Жоқ, яғни, ол қайда…
Dialogue: 0,1:15:33.77,1:15:35.86,Default,,0,0,0,,Мен уәде беремін, сондықтан...
Dialogue: 0,1:15:44.33,1:15:45.29,Default,,0,0,0,,Хехе...
Dialogue: 0,1:15:56.38,1:15:57.67,Default,,0,0,0,,Сіз ұсталғыңыз келе ме?
Dialogue: 0,1:15:57.80,1:16:00.51,Default,,0,0,0,,Бұл өте қиын. Олардың барлығын осында өлтіріңіз.
Dialogue: 0,1:16:00.63,1:16:02.01,Default,,0,0,0,,Хаха!
Dialogue: 0,1:16:03.68,1:16:05.97,Default,,0,0,0,,Қабыл ал! (Сарбаздар) О!
Dialogue: 0,1:16:06.27,1:16:07.47,Default,,0,0,0,,Кеттік! Иә
Dialogue: 0,1:16:07.60,1:16:10.44,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,1:16:10.77,1:16:12.90,Default,,0,0,0,,Кішкентай бәйбішелер, мен сендерге осы жерден өтуге рұқсат бермеймін.
Dialogue: 0,1:16:12.98,1:16:14.86,Default,,0,0,0,,Уау...
Dialogue: 0,1:16:15.19,1:16:17.32,Default,,0,0,0,,Міне, келдік! (Сунео) Иә? Не?
Dialogue: 0,1:16:17.69,1:16:19.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:19.36,1:16:20.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:20.57,1:16:21.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:21.78,1:16:24.16,Default,,0,0,0,,А, не? Не?
Dialogue: 0,1:16:26.91,1:16:28.25,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:28.45,1:16:29.79,Default,,0,0,0,,Хмм?
Dialogue: 0,1:16:41.76,1:16:43.64,Default,,0,0,0,,Иә? Бұл нені білдіреді?
Dialogue: 0,1:16:43.84,1:16:46.10,Default,,0,0,0,,K Бұл қорқынышты. Ю Бұл елес пе?
Dialogue: 0,1:16:46.35,1:16:48.22,Default,,0,0,0,,Құдайға шүкір, мен оны уақытында жасадым.
Dialogue: 0,1:16:48.31,1:16:49.52,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,1:16:49.64,1:16:52.23,Default,,0,0,0,,Біз болашақтан уақыт машинасында келдік.
Dialogue: 0,1:16:52.35,1:16:53.81,Default,,0,0,0,,Мен өзімді жеңіл сезінемін.
Dialogue: 0,1:16:53.90,1:16:55.73,Default,,0,0,0,,Ju Ju 10 шетелдіктер...
Dialogue: 0,1:16:55.81,1:16:57.19,Default,,0,0,0,,Сондай ақымақ...
Dialogue: 0,1:16:57.36,1:17:00.44,Default,,0,0,0,,Сюрпризді артта қалдырып, алып мүсінге бет алыңыз!
Dialogue: 0,1:17:00.57,1:17:01.49,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,1:17:01.61,1:17:03.66,Default,,0,0,0,,Жарайды, өйткені мен құралдарды әкелдім.
Dialogue: 0,1:17:03.78,1:17:05.16,Default,,0,0,0,,Сарбаздар қабылдады
Dialogue: 0,1:17:05.24,1:17:07.62,Default,,0,0,0,,Оны алып мүсінге асығыңыз!
Dialogue: 0,1:17:08.12,1:17:10.54,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:11.04,1:17:12.25,Default,,0,0,0,,Міне!
Dialogue: 0,1:17:12.37,1:17:15.00,Default,,0,0,0,,Мен мұның болғанына сене алар емеспін...
Dialogue: 0,1:17:15.13,1:17:18.21,Default,,0,0,0,,Алып мүсінді қорлаған қорқынышты адамдарды кешір!
Dialogue: 0,1:17:18.34,1:17:20.88,Default,,0,0,0,,Уайымдама, біз сені бірден тұтқынға аламыз.
Dialogue: 0,1:17:21.21,1:17:22.05,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,1:17:29.85,1:17:31.89,Default,,0,0,0,,Жоқ, ол ашылмайды.
Dialogue: 0,1:17:31.98,1:17:34.35,Default,,0,0,0,,Оны тек ханзада кулонымен жарқыратыңыз.
Dialogue: 0,1:17:34.65,1:17:37.11,Default,,0,0,0,,Ей, сен мені жақсы білесің.
Dialogue: 0,1:17:43.99,1:17:45.70,Default,,0,0,0,,Міне!
Dialogue: 0,1:17:45.78,1:17:47.66,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:48.20,1:17:49.37,Default,,0,0,0,,Бұл карта сәл ақымақтай көрінбей ме?
Dialogue: 0,1:17:51.20,1:17:52.29,Default,,0,0,0,,(Сарбаздар қашып кетті)
Dialogue: 0,1:17:52.41,1:17:54.08,Default,,0,0,0,,Гао!
Dialogue: 0,1:17:54.16,1:17:57.25,Default,,0,0,0,,Ммм, дәмді!
Dialogue: 0,1:17:57.88,1:18:00.17,Default,,0,0,0,,Хмм!
Dialogue: 0,1:18:03.42,1:18:05.72,Default,,0,0,0,,Алпауыт мүсіннен бөтендерді қағып ал.
Dialogue: 0,1:18:05.84,1:18:08.51,Default,,0,0,0,,О! Эй!
Dialogue: 0,1:18:08.85,1:18:11.47,Default,,0,0,0,,Кеттік! Бум!
Dialogue: 0,1:18:11.89,1:18:13.64,Default,,0,0,0,,<Алғашқы қадамды жасау>
Dialogue: 0,1:18:13.98,1:18:17.15,Default,,0,0,0,,Уау аааа
Dialogue: 0,1:18:17.60,1:18:19.90,Default,,0,0,0,,Йотто (Солдат) Уф.
Dialogue: 0,1:18:20.02,1:18:20.98,Default,,0,0,0,,Хехе...
Dialogue: 0,1:18:21.07,1:18:22.28,Default,,0,0,0,,Хмм!
Dialogue: 0,1:18:26.03,1:18:28.32,Default,,0,0,0,,Күте тұрыңыз! Кішкентай бәйбішелер!
Dialogue: 0,1:18:31.70,1:18:35.16,Default,,0,0,0,,Құдайдың жүрегі сонау жоғарыдағы кішкентай бөлмеде.
Dialogue: 0,1:18:35.29,1:18:36.79,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,1:18:36.92,1:18:38.46,Default,,0,0,0,,Нені мен білмеймін
Dialogue: 0,1:18:38.75,1:18:41.25,Default,,0,0,0,,Кейінірек түсінесіз. Барайық!
Dialogue: 0,1:18:42.09,1:18:44.09,Default,,0,0,0,,Күте тұрыңыз! (Сарбаздар) Уау...
Dialogue: 0,1:18:44.80,1:18:47.51,Default,,0,0,0,,Аххх (Нобита) Уфу Уфуфу...
Dialogue: 0,1:18:47.59,1:18:49.39,Default,,0,0,0,,Бұл! (Солдат) Уау!
Dialogue: 0,1:18:49.51,1:18:50.47,Default,,0,0,0,,Доқан
Dialogue: 0,1:18:50.68,1:18:53.39,Default,,0,0,0,,Иә, сен балаға не істейсің?
Dialogue: 0,1:18:53.52,1:18:55.60,Default,,0,0,0,,Танктерді шақырыңыз Ұшатын кемелерді шақырыңыз!
Dialogue: 0,1:18:55.60,1:18:56.44,Default,,0,0,0,,Танктерді шақырыңыз Ұшатын кемелерді шақырыңыз!
Dialogue: 0,1:18:55.60,1:18:56.44,Default,,0,0,0,,Ха!
Dialogue: 0,1:18:56.81,1:18:59.73,Default,,0,0,0,,(Нобитаның ентігуі)
Dialogue: 0,1:18:59.86,1:19:01.11,Default,,0,0,0,,А, жақсысың ба?
Dialogue: 0,1:19:01.23,1:19:02.90,Default,,0,0,0,,Уайымдама, уайымдама, асығыңыз!
Dialogue: 0,1:19:03.78,1:19:05.82,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,1:19:05.94,1:19:08.53,Default,,0,0,0,,Жоқ, жоқ, бұл қазына бөлмесі.
Dialogue: 0,1:19:09.07,1:19:10.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:10.24,1:19:12.99,Default,,0,0,0,,Не? Мұндай нәрсенің пайдасы жоқ.
Dialogue: 0,1:19:13.58,1:19:16.91,Default,,0,0,0,,(Сабельдің ентігуі)
Dialogue: 0,1:19:23.38,1:19:24.30,Default,,0,0,0,,Ах
Dialogue: 0,1:19:24.42,1:19:25.51,Default,,0,0,0,,Барлық кемелерге айтыңыз
Dialogue: 0,1:19:25.63,1:19:28.30,Default,,0,0,0,,Алаңда біртүрлі жағдай болды. Дереу асығыңыз!
Dialogue: 0,1:19:28.38,1:19:30.80,Default,,0,0,0,,Мен қалжыңдамаймын... Ха... Ха...
Dialogue: 0,1:19:30.93,1:19:34.56,Default,,0,0,0,,Токио мұнарасымен жүгіріп бара жатқандай... иә...
Dialogue: 0,1:19:34.68,1:19:36.14,Default,,0,0,0,,Ха... ха... Ах!
Dialogue: 0,1:19:37.43,1:19:39.44,Default,,0,0,0,,Дораемон! Келді, келді, келді!
Dialogue: 0,1:19:39.77,1:19:41.61,Default,,0,0,0,,Ах! Болды
Dialogue: 0,1:19:48.74,1:19:50.57,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:19:51.03,1:19:52.78,Default,,0,0,0,,Қауіпті Нобита-кун!
Dialogue: 0,1:19:52.91,1:19:54.49,Default,,0,0,0,,Сабер Мен сенің қарсыласыңмын!
Dialogue: 0,1:19:54.70,1:19:57.37,Default,,0,0,0,,Мынау мынау, мынау ханзада
Dialogue: 0,1:19:57.79,1:20:00.21,Default,,0,0,0,,Сізбен келісім жасау - бұл мәртебе.
Dialogue: 0,1:20:00.33,1:20:02.08,Default,,0,0,0,,Әй, ханзадаға қылыш бер
Dialogue: 0,1:20:03.29,1:20:05.71,Default,,0,0,0,,Дадада, жақсысың ба? Иә
Dialogue: 0,1:20:07.84,1:20:08.92,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:20:09.05,1:20:11.72,Default,,0,0,0,,Тахт тайт (Сабиль) уһә
Dialogue: 0,1:20:12.09,1:20:14.18,Default,,0,0,0,,Уф...
Dialogue: 0,1:20:14.26,1:20:17.02,Default,,0,0,0,,Нобита-кун, асығыңыз! (Нобита) Иә
Dialogue: 0,1:20:17.14,1:20:19.64,Default,,0,0,0,,Уф, бұл!
Dialogue: 0,1:20:20.35,1:20:22.48,Default,,0,0,0,,Уф...
Dialogue: 0,1:20:23.98,1:20:25.61,Default,,0,0,0,,Балалар сендер басқа экипаждың соңынан жүріңдер.
Dialogue: 0,1:20:25.73,1:20:26.57,Default,,0,0,0,,Ха!
Dialogue: 0,1:20:26.78,1:20:29.53,Default,,0,0,0,,Барлығы, маған көмектесіңдер! Хахаха... Дораемон!
Dialogue: 0,1:20:29.61,1:20:32.45,Default,,0,0,0,,Жарайды, мен сақтайтын құралдармен...
Dialogue: 0,1:20:32.99,1:20:36.33,Default,,0,0,0,,Атақты қылыш Денкомару! Тах!
Dialogue: 0,1:20:36.45,1:20:39.45,Default,,0,0,0,,Иә! (Нобита) Уау... иә?
Dialogue: 0,1:20:39.58,1:20:43.63,Default,,0,0,0,,А, бұл... оның радары бар және қарсыластың шабуылдарынан автоматты түрде жалтарады.
Dialogue: 0,1:20:43.75,1:20:45.17,Default,,0,0,0,,Найзағайдай саңылауға тиеді дейді...
Dialogue: 0,1:20:45.29,1:20:47.75,Default,,0,0,0,,Да! (Нобита) Уау!
Dialogue: 0,1:20:48.00,1:20:49.51,Default,,0,0,0,,О, бос емес
Dialogue: 0,1:20:49.59,1:20:51.13,Default,,0,0,0,,Әлі де ашылмаған ба? тез!
Dialogue: 0,1:20:51.26,1:20:52.38,Default,,0,0,0,,Тот басқан!
Dialogue: 0,1:20:54.34,1:20:56.05,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:21:03.23,1:21:05.77,Default,,0,0,0,,Жоқ, құралдарды оларға жақындамайынша пайдалана алмайсыз.
Dialogue: 0,1:21:10.03,1:21:14.20,Default,,0,0,0,,Мына алып мүсіннің жүрегін қозғау – бұл мүсінді жылжыту.
Dialogue: 0,1:21:14.28,1:21:18.16,Default,,0,0,0,,Жарайды, оны маған қалдырыңыз. Міне келді...
Dialogue: 0,1:21:18.24,1:21:23.54,Default,,0,0,0,,Уф... (Болашақ Дораемон) Бұл сағат тілімен!
Dialogue: 0,1:21:23.92,1:21:25.79,Default,,0,0,0,,тайыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыыы
Dialogue: 0,1:21:25.92,1:21:27.04,Default,,0,0,0,,Міне! Ах...
Dialogue: 0,1:21:28.34,1:21:30.01,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,1:21:30.09,1:21:31.63,Default,,0,0,0,,Қозғалу қауіпті
Dialogue: 0,1:21:31.84,1:21:34.63,Default,,0,0,0,,Ух... уау (солдаттар) Ах!
Dialogue: 0,1:21:34.72,1:21:38.18,Default,,0,0,0,,Дааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,1:21:38.31,1:21:40.43,Default,,0,0,0,,Бұл! Уау
Dialogue: 0,1:21:40.52,1:21:41.85,Default,,0,0,0,,Хехе, аяқта!
Dialogue: 0,1:21:41.93,1:21:44.31,Default,,0,0,0,,(барлық күш айқайлары)
Dialogue: 0,1:21:44.39,1:21:45.77,Default,,0,0,0,,Уф...
Dialogue: 0,1:21:49.52,1:21:50.69,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:21:53.99,1:21:57.12,Default,,0,0,0,,Жарайды, алып мүсінге қуат берілді.
Dialogue: 0,1:22:00.16,1:22:01.87,Default,,0,0,0,,Хэхе... аа... ой
Dialogue: 0,1:22:02.08,1:22:03.58,Default,,0,0,0,,Ха...
Dialogue: 0,1:22:03.87,1:22:05.37,Default,,0,0,0,,Ах (Сабель) О!
Dialogue: 0,1:22:06.79,1:22:10.21,Default,,0,0,0,,Уа, ау, ау!
Dialogue: 0,1:22:10.71,1:22:14.55,Default,,0,0,0,,Уау!
Dialogue: 0,1:22:17.26,1:22:19.39,Default,,0,0,0,,Уау!
Dialogue: 0,1:22:19.72,1:22:21.31,Default,,0,0,0,,Әй, ханзада қауіп төніп тұр.
Dialogue: 0,1:22:32.94,1:22:35.82,Default,,0,0,0,,Барлығы сыртқа қарайды.
Dialogue: 0,1:22:36.53,1:22:38.03,Default,,0,0,0,,Ия, қозғала бастады.
Dialogue: 0,1:22:38.28,1:22:41.99,Default,,0,0,0,,Ах... Уау.
Dialogue: 0,1:22:44.04,1:22:45.41,Default,,0,0,0,,А, ол қозғалды.
Dialogue: 0,1:22:53.00,1:22:55.51,Default,,0,0,0,,(Алып мүсіннің гүрілі)
Dialogue: 0,1:23:04.77,1:23:06.60,Default,,0,0,0,,Ааах…
Dialogue: 0,1:23:08.40,1:23:12.19,Default,,0,0,0,,А, қаш!
Dialogue: 0,1:23:12.65,1:23:14.73,Default,,0,0,0,,А... а...
Dialogue: 0,1:23:16.95,1:23:19.61,Default,,0,0,0,,Мен тас мүсіннің қозғалғанына сенбеймін...
Dialogue: 0,1:23:19.74,1:23:22.58,Default,,0,0,0,,Бұл сол бәйбішелердің ісі. Ат! Ат!
Dialogue: 0,1:23:24.54,1:23:27.54,Default,,0,0,0,,(Алып мүсіннің гүрілі)
Dialogue: 0,1:23:36.34,1:23:40.34,Default,,0,0,0,,Әке, зұлымдықты жазалау үшін алып құдайдың күшін пайдалан.
Dialogue: 0,1:23:40.68,1:23:41.93,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:43.05,1:23:44.43,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:47.93,1:23:49.77,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,1:24:05.99,1:24:08.08,Default,,0,0,0,,Уау...
Dialogue: 0,1:24:08.16,1:24:10.04,Default,,0,0,0,,Өмірлік маңызды нүкте – көз. Көзге мақсат қойыңыз!
Dialogue: 0,1:24:17.01,1:24:18.76,Default,,0,0,0,,Уау!
Dialogue: 0,1:24:20.88,1:24:22.47,Default,,0,0,0,,Уау, маған көмектес!
Dialogue: 0,1:24:22.59,1:24:24.14,Default,,0,0,0,,Анашым! (Болашақ Дораэмон) Мен қайтамын!
Dialogue: 0,1:24:27.43,1:24:30.02,Default,,0,0,0,,Қазір қара, мен сені бөлшектеймін! Жаса!
Dialogue: 0,1:24:30.10,1:24:32.02,Default,,0,0,0,,Ооо
Dialogue: 0,1:24:39.61,1:24:41.86,Default,,0,0,0,,Қарашы, сен жүректі тесіп жатырсың!
Dialogue: 0,1:24:49.37,1:24:50.96,Default,,0,0,0,,(Алып мүсіннің гүрілі)
Dialogue: 0,1:24:51.50,1:24:52.92,Default,,0,0,0,,Алып Құдай, ашулан!
Dialogue: 0,1:24:55.00,1:24:57.34,Default,,0,0,0,,Әй, итеріп жібер, итер!
Dialogue: 0,1:24:57.42,1:24:59.30,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:24:59.55,1:25:02.38,Default,,0,0,0,,Алып құдай, ашулан!
Dialogue: 0,1:25:05.51,1:25:09.31,Default,,0,0,0,,(Алып мүсіннің гүрілі)
Dialogue: 0,1:25:09.39,1:25:10.48,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:18.48,1:25:20.44,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:27.20,1:25:28.95,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,1:25:39.42,1:25:40.88,Default,,0,0,0,,Ха... ха...
Dialogue: 0,1:25:41.01,1:25:43.34,Default,,0,0,0,,...
Dialogue: 0,1:25:43.47,1:25:44.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:46.22,1:25:50.31,Default,,0,0,0,,Қараңдаршы, шайқаста алып құдайдың да, ханзаданың да арқасында жеңіске жетті.
Dialogue: 0,1:25:50.39,1:25:53.18,Default,,0,0,0,,Брюс Аман-есен болғаныңызға қуаныштымын!
Dialogue: 0,1:25:54.39,1:25:55.56,Default,,0,0,0,,Ханзада!
Dialogue: 0,1:25:55.94,1:25:59.48,Default,,0,0,0,,Тоқта, мен Дабурандрды біраз уақыттан бері көрмедім.
Dialogue: 0,1:25:59.61,1:26:01.23,Default,,0,0,0,,Жоғалтып алдым, абайсызда болдым.
Dialogue: 0,1:26:01.36,1:26:03.07,Default,,0,0,0,,Ханшайым тезірек патша сарайына баруы керек!
Dialogue: 0,1:26:03.19,1:26:04.03,Default,,0,0,0,,Иә!?
Dialogue: 0,1:26:07.82,1:26:10.08,Default,,0,0,0,,(Алып мүсіннің гүрілі)
Dialogue: 0,1:26:23.38,1:26:25.97,Default,,0,0,0,,Хаха хаха (Спиана/қызметші) Жарайды!
Dialogue: 0,1:26:26.34,1:26:28.26,Default,,0,0,0,,А, міне, осымен бітті
Dialogue: 0,1:26:28.39,1:26:30.72,Default,,0,0,0,,Мен саған патшалықты беремін, бірақ...
Dialogue: 0,1:26:31.43,1:26:32.39,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:32.52,1:26:35.27,Default,,0,0,0,,Ханшайым, сен менікісің.
Dialogue: 0,1:26:35.39,1:26:35.98,Default,,0,0,0,,Жоқ, жіберіңізші!
Dialogue: 0,1:26:35.98,1:26:37.73,Default,,0,0,0,,Жоқ, мені жібер!
Dialogue: 0,1:26:35.98,1:26:37.73,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:26:42.48,1:26:45.20,Default,,0,0,0,,Егер қазір Жосукэнің қайда екенін білсем ғой—
Dialogue: 0,1:26:46.11,1:26:48.99,Default,,0,0,0,,Бірақ ол бәрін жоғалтты
Dialogue: 0,1:26:49.07,1:26:51.24,Default,,0,0,0,,Тат (Дубландер) Гьяа!
Dialogue: 0,1:26:54.29,1:26:56.66,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,1:26:57.54,1:26:58.63,Default,,0,0,0,,...
Dialogue: 0,1:26:59.08,1:27:00.59,Default,,0,0,0,,Спиана ханшайымы!
Dialogue: 0,1:27:01.00,1:27:01.84,Default,,0,0,0,,…
Dialogue: 0,1:27:01.96,1:27:05.30,Default,,0,0,0,,(Дораэмонның қуанышы)
Dialogue: 0,1:27:11.85,1:27:13.60,Default,,0,0,0,,Олай болса уәдеңде тұр.
Dialogue: 0,1:27:13.72,1:27:17.14,Default,,0,0,0,,Иә, мен Жапонияға қайтып келгенде оны міндетті түрде қорғаймын.
Dialogue: 0,1:27:17.27,1:27:20.15,Default,,0,0,0,,Артында қалдырған құралдарды алып, уақыт машинасына мініңіз
Dialogue: 0,1:27:20.27,1:27:23.48,Default,,0,0,0,,Ол бізге қиын кезде көмектесу үшін қайтып келеді.
Dialogue: 0,1:27:23.61,1:27:24.44,Default,,0,0,0,,Олай болса, Дораемон
Dialogue: 0,1:27:24.57,1:27:27.36,Default,,0,0,0,,Жарайды, кез келген жерде жаңа есік
Dialogue: 0,1:27:30.78,1:27:32.95,Default,,0,0,0,,Олай болса, қалғанын саған қалдырамын.
Dialogue: 0,1:27:33.08,1:27:33.95,Default,,0,0,0,,Қош бол
Dialogue: 0,1:27:34.08,1:27:35.66,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:27:35.79,1:27:39.87,Default,,0,0,0,,Қош бол, рахмет!
Dialogue: 0,1:27:41.29,1:27:43.50,Default,,0,0,0,,Мен алдын ала уәде беретін машинаға уәде бердім.
Dialogue: 0,1:27:43.63,1:27:44.92,Default,,0,0,0,,Аман-есен оралсаңыз
Dialogue: 0,1:27:45.05,1:27:47.55,Default,,0,0,0,,Мен оның уақытты кері қайтарып, маған көмекке келетініне сенімдімін.
Dialogue: 0,1:27:47.63,1:27:50.80,Default,,0,0,0,,Қарасам, 10 шетелдіктің жұмбағы ашылды, бірақ...
Dialogue: 0,1:27:50.93,1:27:53.51,Default,,0,0,0,,Бұл өте күрделі оқиға!
Dialogue: 0,1:27:53.60,1:27:57.60,Default,,0,0,0,,(иттер қолдайды)
Dialogue: 0,1:28:01.31,1:28:03.69,Default,,0,0,0,,Банзай Банзай
Dialogue: 0,1:28:23.21,1:28:25.92,Default,,0,0,0,,Біз сені ешқашан ұмытпаймыз!
Dialogue: 0,1:28:26.30,1:28:27.21,Default,,0,0,0,,Ол айналып өткеннен кейін әлсіз жақтарымнан шағын соққылар береді.
Dialogue: 0,1:28:27.34,1:28:29.88,Default,,0,0,0,,Жақсы патша болыңыз, сау болыңыз!
Dialogue: 0,1:28:30.01,1:28:31.97,Default,,0,0,0,,Сәттілік (Сунео) Сау болыңыз
Dialogue: 0,1:28:32.09,1:28:34.64,Default,,0,0,0,,Жапонияға қайта келіңіз!
Dialogue: 0,1:28:35.14,1:28:36.51,Default,,0,0,0,,Чип! Чип, чип, чип, чип!
Dialogue: 0,1:28:36.64,1:28:37.89,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:28:38.10,1:28:39.98,Default,,0,0,0,,кездескенше Пеко
Dialogue: 0,1:28:40.10,1:28:42.19,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Пеко
Dialogue: 0,1:28:45.98,1:28:47.28,Default,,0,0,0,,Бұл тамаша шытырман оқиға болды.
Dialogue: 0,1:28:47.40,1:28:49.24,Default,,0,0,0,,Бұл тамаша көктемгі демалыс болды.
Dialogue: 0,1:28:49.74,1:28:53.57,Default,,0,0,0,,Бірақ бұл соңы емес. Мен уәдемді орындауым керек.
Dialogue: 0,1:28:53.70,1:28:55.20,Default,,0,0,0,,А, тағы да болды...
Dialogue: 0,1:28:55.33,1:28:58.08,Default,,0,0,0,,Көңіліңді көтер, өзіңді құтқар.
Dialogue: 0,1:28:58.20,1:28:59.16,Default,,0,0,0,,Сіз шағымданасыз ба?
Dialogue: 0,1:28:59.50,1:29:01.04,Default,,0,0,0,,Иә, дереу барайық.
Dialogue: 0,1:29:01.16,1:29:02.37,Default,,0,0,0,,Иә, кеттік!
Dialogue: 0,1:29:02.87,1:29:04.33,Default,,0,0,0,,Құралдармен...
Dialogue: 0,1:29:05.59,1:29:07.13,Default,,0,0,0,,Менің бөлмемдегі уақыт машинасында
Dialogue: 0,1:29:07.25,1:29:08.80,Default,,0,0,0,,Африканың иттер патшалығына
Dialogue: 0,1:29:08.88,1:29:10.76,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:29:10.84,1:29:16.10,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,1:29:30.82,1:29:35.82,Default,,0,0,0,,♪〜
Dialogue: 0,1:31:24.81,1:31:29.81,Default,,0,0,0,,〜♪
Dialogue: 0,1:31:31.31,1:31:37.31,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory