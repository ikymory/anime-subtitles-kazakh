Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.75,0:00:09.92,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:11.97,0:00:14.22,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:16.18,0:00:17.51,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:00:17.68,0:00:19.64,Default,,0,0,0,,(Тау қасқырының үруі)
Dialogue: 0,0:00:22.89,0:00:24.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:27.40,0:00:28.52,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,0:00:31.07,0:00:32.44,Default,,0,0,0,,Хаа… Хаа…
Dialogue: 0,0:00:43.96,0:00:46.79,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:48.46,0:00:53.63,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:58.14,0:00:59.85,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:59.97,0:01:02.14,Default,,0,0,0,,Жалғыз кейіп танытпаңыз! Гакья!
Dialogue: 0,0:01:02.27,0:01:05.10,Default,,0,0,0,,Егер сен тоқтамасаң, мен сені өлтіремін!
Dialogue: 0,0:01:05.23,0:01:07.40,Default,,0,0,0,,<Тұрғындардағы өмір...>
Dialogue: 0,0:01:07.85,0:01:10.65,Default,,0,0,0,,＜Ата-анаң қандай болған?＞
Dialogue: 0,0:01:11.32,0:01:16.15,Default,,0,0,0,,<Күн сайын аштықты сезінбей тұра алмадым...>
Dialogue: 0,0:01:16.28,0:01:20.16,Default,,0,0,0,,<Күндік нанын табу үшін өмірімді қададым>
Dialogue: 0,0:01:20.28,0:01:22.20,Default,,0,0,0,,<Мені мазақ еткім келмейді>
Dialogue: 0,0:01:22.33,0:01:24.41,Default,,0,0,0,,<Мен көбірек дәмді тамақ жегім келеді>
Dialogue: 0,0:01:24.54,0:01:27.25,Default,,0,0,0,,<Мен күштірек болғым келеді>
Dialogue: 0,0:01:27.37,0:01:30.17,Default,,0,0,0,,<Толығырақ...>
Dialogue: 0,0:01:31.67,0:01:34.46,Default,,0,0,0,,<Жүгіру, жүгіру>
Dialogue: 0,0:01:34.63,0:01:35.76,Default,,0,0,0,,<Жүгір! ＞
Dialogue: 0,0:01:38.30,0:01:41.01,Default,,0,0,0,,<Кейде кенеттен>
Dialogue: 0,0:01:41.14,0:01:44.85,Default,,0,0,0,,<Мен енді аш емес екенімді түсіндім>
Dialogue: 0,0:01:45.02,0:01:46.94,Default,,0,0,0,,(тауық айқайы)
Dialogue: 0,0:01:47.06,0:01:47.94,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:01:48.60,0:01:51.94,Default,,0,0,0,,Бүгін де бос жұмыс істегіңіз келе ме?
Dialogue: 0,0:02:01.12,0:02:02.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:02.28,0:02:06.00,Default,,0,0,0,,Көңіл-күйің жақсы болуы керек, Хажиме-бо.
Dialogue: 0,0:02:06.12,0:02:07.54,Default,,0,0,0,,О, қайырлы таң, әже.
Dialogue: 0,0:02:07.66,0:02:10.50,Default,,0,0,0,,Жақсы нәрсе болды ма?
Dialogue: 0,0:02:10.75,0:02:13.09,Default,,0,0,0,,Ерекше ештеңе жоқ.
Dialogue: 0,0:02:13.25,0:02:15.55,Default,,0,0,0,,Айтпақшы, тізеңіз қалай?
Dialogue: 0,0:02:15.67,0:02:18.59,Default,,0,0,0,,Маған әкелген емдік шөптеріңізге рахмет.
Dialogue: 0,0:02:18.80,0:02:20.93,Default,,0,0,0,,Қараңдар! Мынау сияқты!
Dialogue: 0,0:02:21.05,0:02:23.26,Default,,0,0,0,,Хмф! Жеңілдік! Хмф! Жеңілдік! О, шектен шықпа...
Dialogue: 0,0:02:24.14,0:02:26.89,Default,,0,0,0,,Рахмет, Хажиме-бо?
Dialogue: 0,0:02:27.02,0:02:29.98,Default,,0,0,0,,Ондай ештеңе жоқ ауылға келгеніңізге рахмет.
Dialogue: 0,0:02:30.52,0:02:32.98,Default,,0,0,0,,үшінңызға рахмет.
Dialogue: 0,0:02:34.19,0:02:36.86,Default,,0,0,0,,Егер сіз авантюристтен сұрағыңыз келетін жұмыс болса да,
Dialogue: 0,0:02:36.99,0:02:40.49,Default,,0,0,0,,Шалғай, қатыгез адамдар көп.
Dialogue: 0,0:02:40.61,0:02:42.37,Default,,0,0,0,,Бұл маған шынымен көмектеседі
Dialogue: 0,0:02:43.03,0:02:44.62,Default,,0,0,0,,жақсы болар еді
Dialogue: 0,0:02:44.74,0:02:47.75,Default,,0,0,0,,Ауылда қалсаң, мен сені жақсы көремін.
Dialogue: 0,0:02:47.87,0:02:49.71,Default,,0,0,0,,Марианна туралы не деуге болады?
Dialogue: 0,0:02:49.83,0:02:51.38,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:02:58.63,0:02:59.97,Default,,0,0,0,,Оян, қария!
Dialogue: 0,0:03:00.09,0:03:01.30,Default,,0,0,0,,Хунга!
Dialogue: 0,0:03:01.43,0:03:03.85,Default,,0,0,0,,О! Бұл Хажимэбо!
Dialogue: 0,0:03:03.97,0:03:05.64,Default,,0,0,0,,Мен оны баяу қабылдағаным біртүрлі болды.
Dialogue: 0,0:03:05.76,0:03:07.43,Default,,0,0,0,,Ет алу үшін зынданға кірейік.
Dialogue: 0,0:03:07.56,0:03:10.98,Default,,0,0,0,,А, онда осы жерге қол қойыңыз.
Dialogue: 0,0:03:11.10,0:03:12.52,Default,,0,0,0,,О
Dialogue: 0,0:03:12.90,0:03:16.48,Default,,0,0,0,,Түсіндім... Оның құрамында жаңа піскен ет бар ма?
Dialogue: 0,0:03:16.61,0:03:18.94,Default,,0,0,0,,Бүгін ішуге барамыз ба?
Dialogue: 0,0:03:19.07,0:03:21.53,Default,,0,0,0,,Әжеге ашуланбауға тырысыңыз.
Dialogue: 0,0:03:21.66,0:03:24.28,Default,,0,0,0,,О, абай бол.
Dialogue: 0,0:03:25.74,0:03:26.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:28.91,0:03:30.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:33.33,0:03:35.59,Default,,0,0,0,,<Есік неге ашық болды? ＞
Dialogue: 0,0:03:35.71,0:03:38.17,Default,,0,0,0,,<Жалғыз белгі менің атым болды...>
Dialogue: 0,0:03:41.68,0:03:43.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:43.43,0:03:45.05,Default,,0,0,0,,Ей, сен баласың!
Dialogue: 0,0:03:45.18,0:03:46.81,Default,,0,0,0,,Өлген жоқсың деп үміттенемін! Ой!
Dialogue: 0,0:03:47.06,0:03:49.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:49.18,0:03:51.69,Default,,0,0,0,,О, сен мені құтқардың!
Dialogue: 0,0:03:51.81,0:03:53.31,Default,,0,0,0,,Сіз алаңсызсыз ба?
Dialogue: 0,0:03:53.44,0:03:57.32,Default,,0,0,0,,Хофу... Ол сұмдық жау еді...
Dialogue: 0,0:03:57.44,0:03:59.19,Default,,0,0,0,,Бұл ең әлсіз құбыжық...
Dialogue: 0,0:03:59.32,0:04:00.19,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:00.32,0:04:03.16,Default,,0,0,0,,Менің ағам - құтқарушы!
Dialogue: 0,0:04:03.28,0:04:04.70,Default,,0,0,0,,Атыңызды сұрасам болады ма?
Dialogue: 0,0:04:04.82,0:04:07.74,Default,,0,0,0,,Лилуи Лилуй деп аталады!
Dialogue: 0,0:04:08.79,0:04:10.54,Default,,0,0,0,,Шиноном Хаджиме...
Dialogue: 0,0:04:10.66,0:04:13.08,Default,,0,0,0,,О, сенің фамилияң бар!
Dialogue: 0,0:04:13.25,0:04:14.92,Default,,0,0,0,,Ол әйгілі авантюрист.
Dialogue: 0,0:04:15.04,0:04:17.38,Default,,0,0,0,,Бубо! Ахх неге...
Dialogue: 0,0:04:17.50,0:04:19.21,Default,,0,0,0,,Әрине, қарғыс атқыр бала!
Dialogue: 0,0:04:19.34,0:04:21.92,Default,,0,0,0,,Әкімшіні елемеңіз және зынданға кіріңіз!
Dialogue: 0,0:04:22.05,0:04:25.43,Default,,0,0,0,,Өйткені ол өте ыңғайлы ұйықтап жатыр еді, ата.
Dialogue: 0,0:04:25.55,0:04:27.60,Default,,0,0,0,,Мені оятыңыз, болды!
Dialogue: 0,0:04:27.72,0:04:31.68,Default,,0,0,0,,Жалпы айтқанда, бала неге жалғыз кірді? Менің ата-анама не болды? Ал менің ата-анам ше?
Dialogue: 0,0:04:31.81,0:04:33.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:34.52,0:04:35.81,Default,,0,0,0,,Ол тасталды.
Dialogue: 0,0:04:35.94,0:04:36.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:37.77,0:04:40.86,Default,,0,0,0,,Лилли жалғыз тұрады...
Dialogue: 0,0:04:44.32,0:04:47.70,Default,,0,0,0,,Сен ауылдан емессің ғой?
Dialogue: 0,0:04:47.82,0:04:50.62,Default,,0,0,0,,Ол саудагердің жүгіне тығылып келді.
Dialogue: 0,0:04:51.29,0:04:56.54,Default,,0,0,0,,<Цк, ауылдың тұрғыны болмасаң, ауылдың балалар үйін пайдалана алмайсың...>
Dialogue: 0,0:04:56.67,0:04:59.63,Default,,0,0,0,,<Ең жақсы болса, мені ауылдан қуып жібереді де, қараңғылықтарға жібереді...>
Dialogue: 0,0:04:59.75,0:05:02.63,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:05.43,0:05:07.64,Default,,0,0,0,,Бұл қарапайым әңгіме ме?
Dialogue: 0,0:05:07.93,0:05:08.89,Default,,0,0,0,,Ах
Dialogue: 0,0:05:09.01,0:05:11.56,Default,,0,0,0,,Қайда бара жатырсың? Хаджиме!
Dialogue: 0,0:05:11.68,0:05:13.02,Default,,0,0,0,,Жұмыстан босату?
Dialogue: 0,0:05:13.14,0:05:14.48,Default,,0,0,0,,Мен ет алайын деп жатырмын.
Dialogue: 0,0:05:14.56,0:05:15.69,Default,,0,0,0,,Ет!?
Dialogue: 0,0:05:15.81,0:05:17.27,Default,,0,0,0,,Менің артымнан ермеңіз
Dialogue: 0,0:05:17.40,0:05:19.77,Default,,0,0,0,,Сізге ештеңе жоқ.
Dialogue: 0,0:05:19.90,0:05:22.11,Default,,0,0,0,,Мен білемін! (асқазан айқайлайды)
Dialogue: 0,0:05:22.23,0:05:25.45,Default,,0,0,0,,Ри... Рилуи аяудың қажеті жоқ!
Dialogue: 0,0:05:25.57,0:05:27.16,Default,,0,0,0,,Хи хи
Dialogue: 0,0:05:28.70,0:05:31.54,Default,,0,0,0,,Бірақ зынданда жалғыз қалу қауіпті!
Dialogue: 0,0:05:31.66,0:05:33.79,Default,,0,0,0,,Лиллиді бізге қосуға рұқсат етеміз бе?
Dialogue: 0,0:05:33.91,0:05:36.87,Default,,0,0,0,,Ең әлсіз құбыжықтардан аз ғана адам жеңіледі.
Dialogue: 0,0:05:37.75,0:05:41.55,Default,,0,0,0,,А... бұл сәл сәтсіздікке ұшырады!
Dialogue: 0,0:05:41.67,0:05:44.30,Default,,0,0,0,,Лилли пайдалы болады, Хаджиме!
Dialogue: 0,0:05:44.42,0:05:45.80,Default,,0,0,0,,А... А?
Dialogue: 0,0:05:46.22,0:05:47.55,Default,,0,0,0,,Буруру~!
Dialogue: 0,0:05:47.68,0:05:49.26,Default,,0,0,0,,О, итата
Dialogue: 0,0:05:49.39,0:05:50.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:52.76,0:05:54.68,Default,,0,0,0,,Гяаааа! Үлкен!
Dialogue: 0,0:05:54.81,0:05:56.56,Default,,0,0,0,,Даусыңыз қаттырақ
Dialogue: 0,0:05:56.69,0:05:58.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:58.48,0:05:59.56,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:06:02.69,0:06:03.94,Default,,0,0,0,,Ах~
Dialogue: 0,0:06:04.07,0:06:06.95,Default,,0,0,0,,Бұл үлкен мәселе емес, жақсырақ.
Dialogue: 0,0:06:07.07,0:06:09.32,Default,,0,0,0,,Жарайды, сонда қал.
Dialogue: 0,0:06:09.45,0:06:10.20,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:06:20.21,0:06:22.84,Default,,0,0,0,,(Гогоның өлтірушісі)
Dialogue: 0,0:06:23.04,0:06:24.80,Default,,0,0,0,,Hiii~
Dialogue: 0,0:06:30.26,0:06:32.68,Default,,0,0,0,,Мен сәл таң қалып, сәтсіздікке ұшырадым.
Dialogue: 0,0:06:32.80,0:06:34.10,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:34.51,0:06:37.23,Default,,0,0,0,,＜Сенің мінезің өте қатал...＞
Dialogue: 0,0:06:37.35,0:06:38.35,Default,,0,0,0,,Буги, иә?
Dialogue: 0,0:06:39.31,0:06:41.40,Default,,0,0,0,,Ол әлі тірі ме?
Dialogue: 0,0:06:41.65,0:06:46.28,Default,,0,0,0,,Иә? Әй, қанын ағызбасаң, еттің дәмі бұзылады.
Dialogue: 0,0:06:46.40,0:06:47.90,Default,,0,0,0,,Жүрегің соғып тұрса жақсы
Dialogue: 0,0:06:48.07,0:06:50.07,Default,,0,0,0,,Қан әдемі шығады! (шаншу дыбысы)
Dialogue: 0,0:06:50.20,0:06:51.74,Default,,0,0,0,,Таңдаулы!
Dialogue: 0,0:06:51.99,0:06:53.20,Default,,0,0,0,,(Марлей әскерлері)
Dialogue: 0,0:06:53.33,0:06:54.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:56.29,0:06:58.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:58.87,0:07:02.00,Default,,0,0,0,,Уау! Өтінішіңізді орындағаныңызбен құттықтаймыз!
Dialogue: 0,0:07:02.21,0:07:04.38,Default,,0,0,0,,Мен баға алғым келеді, Олив-чан.
Dialogue: 0,0:07:04.50,0:07:06.00,Default,,0,0,0,,«Біз "екінші Кира" бағыты бойынша тергеу жүргізіп жатырмыз» және олардың ынтымақтастығын сұраймыз.
Dialogue: 0,0:07:06.13,0:07:08.76,Default,,0,0,0,,Шинономе-санның еті иіссіз атаққа ие...
Dialogue: 0,0:07:11.80,0:07:14.76,Default,,0,0,0,,Мен қиындыққа тап болдым. Гильдиядағы адамдарды сатып алу және сату ...
Dialogue: 0,0:07:14.89,0:07:17.27,Default,,0,0,0,,А... жоқ, бұл...
Dialogue: 0,0:07:18.52,0:07:20.77,Default,,0,0,0,,Сен ауылдан келген жетімсің бе?
Dialogue: 0,0:07:21.14,0:07:24.73,Default,,0,0,0,,Ондай жағдайда ауыл шіркеуінің балалар үйін пайдалана алмайсың.
Dialogue: 0,0:07:24.86,0:07:27.03,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:27.15,0:07:31.03,Default,,0,0,0,,Маған тамақты ысырап етуге орын жоқ.
Dialogue: 0,0:07:31.57,0:07:32.53,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:07:32.95,0:07:35.37,Default,,0,0,0,,Ал, мен біраз серуендеймін.
Dialogue: 0,0:07:35.49,0:07:37.20,Default,,0,0,0,,Бағалау процесі баяу болды.
Dialogue: 0,0:07:37.33,0:07:38.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.70,0:07:40.54,Default,,0,0,0,,(Кёко) Қыз ба? (Юки) Ұл ба?
Dialogue: 0,0:07:41.58,0:07:45.09,Default,,0,0,0,,Шөпті алып тастамасаң, дәмді көкөністерді өсіре алмайсың.
Dialogue: 0,0:07:45.21,0:07:47.55,Default,,0,0,0,,Көкөніс емес, ет жеңіз! Ет!
Dialogue: 0,0:07:47.67,0:07:49.05,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:49.51,0:07:51.22,Default,,0,0,0,,Ах Чивасу
Dialogue: 0,0:07:51.34,0:07:54.84,Default,,0,0,0,,Мен осы ауылда жақында жұмыс істеп жүрген шытырман адаммын.
Dialogue: 0,0:07:54.97,0:07:59.56,Default,,0,0,0,,Әй, қауесет авантюрист. Бір жақсы адам келді деп естідім.
Dialogue: 0,0:07:59.68,0:08:02.06,Default,,0,0,0,,Аа, кешіріңіз...
Dialogue: 0,0:08:02.27,0:08:06.56,Default,,0,0,0,,Сонымен, авантюрист мырза... сіз намаз оқып жатырсыз ба?
Dialogue: 0,0:08:06.69,0:08:10.69,Default,,0,0,0,,Жоқ, бұл... мен серуендедім...
Dialogue: 0,0:08:10.82,0:08:11.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:12.11,0:08:13.11,Default,,0,0,0,,А...
Dialogue: 0,0:08:13.24,0:08:17.37,Default,,0,0,0,,Аа, мен ойладым... өмір қиын ғой, солай емес пе?
Dialogue: 0,0:08:17.49,0:08:18.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:18.70,0:08:20.83,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:08:20.95,0:08:25.29,Default,,0,0,0,,Біз мұны қайырымдылық пен ауылдағы барлық адамдардың мейірімділігі арқылы жасай аламыз.
Dialogue: 0,0:08:25.42,0:08:28.42,Default,,0,0,0,,Мүлдем оңай деп айта алмаймын.
Dialogue: 0,0:08:28.55,0:08:31.09,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:08:32.72,0:08:35.59,Default,,0,0,0,,Мысалы...
Dialogue: 0,0:08:35.72,0:08:39.81,Default,,0,0,0,,Сіз ай сайын осы шіркеуге біраз ет беріп тұрасыз делік...
Dialogue: 0,0:08:41.47,0:08:45.81,Default,,0,0,0,,Сіз осындай өлшемдегі басқа баланы асырай аласыз ба?
Dialogue: 0,0:08:45.94,0:08:48.36,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:48.48,0:08:52.36,Default,,0,0,0,,Маусымдық киімдер, көрпе-төсек, төсек, күнделікті қажетті заттар
Dialogue: 0,0:08:52.49,0:08:54.57,Default,,0,0,0,,Ыдыс-аяқ пен орындықтағы күнделікті тамақтану
Dialogue: 0,0:08:55.20,0:08:57.82,Default,,0,0,0,,Оқу кезінде жарақат алған немесе ауырған жағдайда емдеу...
Dialogue: 0,0:08:58.32,0:09:00.08,Default,,0,0,0,,Сізге тек ет керек
Dialogue: 0,0:09:00.24,0:09:02.58,Default,,0,0,0,,Мен қасқырдың күшігі емеспін...
Dialogue: 0,0:09:02.70,0:09:05.62,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:06.00,0:09:07.38,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:09:07.50,0:09:09.42,Default,,0,0,0,,Бұл сіздің балаңыз ма?
Dialogue: 0,0:09:09.54,0:09:10.96,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:11.09,0:09:12.13,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:09:12.30,0:09:14.38,Default,,0,0,0,,Сонымен, сіз біреуді танисыз ба?
Dialogue: 0,0:09:14.51,0:09:15.43,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:15.55,0:09:17.01,Default,,0,0,0,,Ауылда кім бар?
Dialogue: 0,0:09:17.14,0:09:18.22,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:20.10,0:09:23.22,Default,,0,0,0,,Бұл мен бүгін кездейсоқ кездестірген ауылдың сыртындағы қыз...
Dialogue: 0,0:09:23.35,0:09:24.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:25.02,0:09:26.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:26.35,0:09:30.32,Default,,0,0,0,,Сіздің басқаларға деген зор сүйіспеншілігіңіз өте керемет.
Dialogue: 0,0:09:30.44,0:09:33.11,Default,,0,0,0,,Иә, бұл өте керемет, бірақ...
Dialogue: 0,0:09:33.78,0:09:38.57,Default,,0,0,0,,Біздің қолымызда Құдайдікі емес шектеулер бар.
Dialogue: 0,0:09:40.33,0:09:43.20,Default,,0,0,0,,<Жақсы, солай деп ойлаймын.>
Dialogue: 0,0:09:43.33,0:09:46.66,Default,,0,0,0,,<«Мен көмектескім келеді» деп көмектессе, ешкім қиналмас еді...>
Dialogue: 0,0:09:48.54,0:09:50.92,Default,,0,0,0,,<Әр адам аман қалуға тырысады...>
Dialogue: 0,0:09:51.42,0:09:55.92,Default,,0,0,0,,<Сондықтан сіз не істесеңіз де, сіз ұстай алатын алақандар саны шектеулі...>
Dialogue: 0,0:09:57.05,0:09:59.30,Default,,0,0,0,,<үшін...>
Dialogue: 0,0:10:01.47,0:10:03.64,Default,,0,0,0,,Шинономе-сан! о!
Dialogue: 0,0:10:03.77,0:10:05.89,Default,,0,0,0,,Олив-чан!
Dialogue: 0,0:10:06.02,0:10:08.56,Default,,0,0,0,,Лилли-чан мұнда емес пе?
Dialogue: 0,0:10:08.69,0:10:10.19,Default,,0,0,0,,Жоқ, ол келмейді.
Dialogue: 0,0:10:10.48,0:10:13.07,Default,,0,0,0,,Иә... Қайда кеткені қызық...
Dialogue: 0,0:10:13.19,0:10:14.44,Default,,0,0,0,,Олар кетті ме?!
Dialogue: 0,0:10:14.57,0:10:17.61,Default,,0,0,0,,Мен жай ғана орындыққа отырып, үнсіз әрекет еттім.
Dialogue: 0,0:10:17.74,0:10:20.32,Default,,0,0,0,,Маған шұғыл өтініш түскенде, оны білмей тұрып...
Dialogue: 0,0:10:20.49,0:10:21.78,Default,,0,0,0,,Шұғыл сұрау?
Dialogue: 0,0:10:21.91,0:10:25.70,Default,,0,0,0,,Иә, Мартиннің егістігінде қоқыстың үлкен бөлігі болды.
Dialogue: 0,0:10:26.04,0:10:28.83,Default,,0,0,0,,Артқы тауда құбыжық бар сияқты!
Dialogue: 0,0:10:29.17,0:10:30.21,Default,,0,0,0,,Не!
Dialogue: 0,0:10:30.54,0:10:33.71,Default,,0,0,0,,Лилли жалғыз тұрады.
Dialogue: 0,0:10:35.05,0:10:38.13,Default,,0,0,0,,Әйтеуір... анау ақымақ!
Dialogue: 0,0:10:38.26,0:10:39.34,Default,,0,0,0,,Шинономе-сан!
Dialogue: 0,0:10:40.59,0:10:42.01,Default,,0,0,0,,<Қатты! ＞
Dialogue: 0,0:10:48.14,0:10:50.44,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:10:53.15,0:10:54.40,Default,,0,0,0,,<Күн батып барады! ＞
Dialogue: 0,0:10:54.52,0:10:56.32,Default,,0,0,0,,<Қараңғы түскенде оны іздей алмайсың! ＞
Dialogue: 0,0:10:56.44,0:10:58.32,Default,,0,0,0,,<Неге бір орында тұрмайсың! ＞
Dialogue: 0,0:10:58.74,0:10:59.90,Default,,0,0,0,,<Жоқ…>
Dialogue: 0,0:11:00.07,0:11:01.91,Default,,0,0,0,,<Ал, мен түсіндім...>
Dialogue: 0,0:11:02.45,0:11:04.99,Default,,0,0,0,,<Тыныш қалсаң, аштан өлесің>
Dialogue: 0,0:11:05.12,0:11:07.62,Default,,0,0,0,,<Менің өмірімді қатерге тігуден басқа амалым жоқ! ＞
Dialogue: 0,0:11:09.87,0:11:11.92,Default,,0,0,0,,Міне болды! Қарсылас тау қасқыры ма?
Dialogue: 0,0:11:12.04,0:11:13.21,Default,,0,0,0,,Сәлем, балақай!
Dialogue: 0,0:11:13.33,0:11:15.09,Default,,0,0,0,,Бұл келе жатыр!
Dialogue: 0,0:11:15.21,0:11:16.71,Default,,0,0,0,,Қаш, ақымақ!
Dialogue: 0,0:11:16.84,0:11:17.96,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:24.76,0:11:26.47,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:26.60,0:11:29.48,Default,,0,0,0,,Бұл тәртіп дұрыс емес.
Dialogue: 0,0:11:29.60,0:11:30.56,Default,,0,0,0,,Ақымақ ит! (соққы дыбысы)
Dialogue: 0,0:11:30.69,0:11:32.44,Default,,0,0,0,,Hiii...
Dialogue: 0,0:11:35.23,0:11:36.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:37.07,0:11:38.86,Default,,0,0,0,,Не ойлап тұрсың, ақымақ?
Dialogue: 0,0:11:38.99,0:11:41.49,Default,,0,0,0,,Ең әлсіз құбыжықтардан да жеңілетін әдетіңіз бар!
Dialogue: 0,0:11:42.03,0:11:44.70,Default,,0,0,0,,Ух... өйткені
Dialogue: 0,0:11:44.82,0:11:46.20,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:11:46.37,0:11:47.79,Default,,0,0,0,,(Асқазанның ырылдауы)
Dialogue: 0,0:11:47.91,0:11:51.25,Default,,0,0,0,,Менің қарным ашты!
Dialogue: 0,0:11:52.12,0:11:57.55,Default,,0,0,0,,(Лилуидің айқайы)
Dialogue: 0,0:12:03.68,0:12:07.06,Default,,0,0,0,,< Қарғыс атсын! Қат! Қат! ＞
Dialogue: 0,0:12:07.68,0:12:09.52,Default,,0,0,0,,<Неге бұлай! ＞
Dialogue: 0,0:12:09.68,0:12:11.18,Default,,0,0,0,,<Ең сорақысы! ＞
Dialogue: 0,0:12:13.52,0:12:15.77,Default,,0,0,0,,О, бұл өте қатты!
Dialogue: 0,0:12:16.61,0:12:19.57,Default,,0,0,0,,Маған қосылғың келсе, жылама!
Dialogue: 0,0:12:19.69,0:12:20.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.82,0:12:23.36,Default,,0,0,0,,Қараңыз! Мен сізге оны қалай бөлшектеу керектігін көрсетемін!
Dialogue: 0,0:12:23.49,0:12:25.28,Default,,0,0,0,,Мұнда кел, маған көмектес!
Dialogue: 0,0:12:25.41,0:12:27.28,Default,,0,0,0,,Е... а...
Dialogue: 0,0:12:27.53,0:12:30.50,Default,,0,0,0,,Тез бұзып, ауылға тарат!
Dialogue: 0,0:12:30.62,0:12:32.66,Default,,0,0,0,,«Бұдан былай саған қамқор боламын»!
Dialogue: 0,0:12:37.96,0:12:41.21,Default,,0,0,0,,Хажиме! Менен бас тартпа!
Dialogue: 0,0:12:42.05,0:12:45.39,Default,,0,0,0,,Не дегіңіз келеді…
Dialogue: 0,0:12:45.64,0:12:47.14,Default,,0,0,0,,Өтінемін, рұқсат етші.
Dialogue: 0,0:12:47.26,0:12:49.51,Default,,0,0,0,,Бейтаныс адамды жұмысқа алу...
Dialogue: 0,0:12:52.06,0:12:54.44,Default,,0,0,0,,<Ақжарқын, тәтті жігіт>
Dialogue: 0,0:12:55.06,0:12:57.65,Default,,0,0,0,,<Мұндай бағалау өмір мен өлім мәселесі...>
Dialogue: 0,0:12:57.77,0:12:59.86,Default,,0,0,0,,<Индульгенция осында аяқталады>
Dialogue: 0,0:12:59.98,0:13:02.53,Default,,0,0,0,,<Енді доспыз, қатал...>
Dialogue: 0,0:13:02.65,0:13:03.65,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:13:03.82,0:13:05.15,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:13:05.28,0:13:06.61,Default,,0,0,0,,Корра Лилли!
Dialogue: 0,0:13:06.74,0:13:09.58,Default,,0,0,0,,Сіз ең жақсы тау қасқырсыз!
Dialogue: 0,0:13:09.70,0:13:12.91,Default,,0,0,0,,О, Хажиме! Тау қасқырлары жақсы!
Dialogue: 0,0:13:13.04,0:13:15.50,Default,,0,0,0,,Натали, менде де сыра бар!
Dialogue: 0,0:13:15.62,0:13:17.21,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:13:17.33,0:13:21.96,Default,,0,0,0,,<Ал, ішіп-жеп, ұйықтағаннан кейін қиын нәрселер туралы ойлан.>
Dialogue: 0,0:13:22.71,0:13:24.97,Default,,0,0,0,,<Осылай ойладым...>
Dialogue: 0,0:13:25.43,0:13:29.05,Default,,0,0,0,,Хехе... Үлкен... Гуфуфу...
Dialogue: 0,0:13:29.18,0:13:30.22,Default,,0,0,0,,Нһ!
Dialogue: 0,0:13:30.39,0:13:31.68,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:13:32.60,0:13:35.18,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:13:35.35,0:13:36.69,Default,,0,0,0,,Хаджиме
Dialogue: 0,0:13:36.81,0:13:38.48,Default,,0,0,0,,Хажиме~
Dialogue: 0,0:13:38.73,0:13:40.19,Default,,0,0,0,,Хмм... а?
Dialogue: 0,0:13:41.98,0:13:44.53,Default,,0,0,0,,Ол үлкейді.
Dialogue: 0,0:13:45.61,0:13:47.16,Default,,0,0,0,,Не!? Апыр-ай!
Dialogue: 0,0:13:47.28,0:13:48.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:48.49,0:13:50.99,Default,,0,0,0,,Иә? Мен оралдым
Dialogue: 0,0:13:51.12,0:13:53.75,Default,,0,0,0,,А, сен...
Dialogue: 0,0:13:53.87,0:13:57.00,Default,,0,0,0,,Ежелгі түрлер!? Мен оны бірінші рет көрдім!
Dialogue: 0,0:13:57.12,0:13:59.00,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:13:59.13,0:14:01.67,Default,,0,0,0,,Сен қандай нәсілсің?
Dialogue: 0,0:14:01.79,0:14:03.76,Default,,0,0,0,,Оның кеудесі үлкен болатын.
Dialogue: 0,0:14:03.88,0:14:04.76,Default,,0,0,0,,Е...
Dialogue: 0,0:14:05.17,0:14:07.13,Default,,0,0,0,,Менің кеуделерім үлкен!
Dialogue: 0,0:14:08.01,0:14:12.35,Default,,0,0,0,,Натали-чан да үлкен көрінеді, бірақ ол да жеңілген жоқ!
Dialogue: 0,0:14:12.47,0:14:14.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:15.02,0:14:19.19,Default,,0,0,0,,<Hmph, сіз жақсы әрекет етесіз~>
Dialogue: 0,0:14:19.69,0:14:22.40,Default,,0,0,0,,Соған қарамастан, сіз жақсы тамақтанасыз.
Dialogue: 0,0:14:22.52,0:14:23.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.44,0:14:27.65,Default,,0,0,0,,Авантюрист стилі: «Еңбек еткің келмесе, аштан өл», иә?
Dialogue: 0,0:14:28.99,0:14:31.99,Default,,0,0,0,,Жарайды, өйткені мен бүгін көп жұмыс істеймін!
Dialogue: 0,0:14:32.12,0:14:34.04,Default,,0,0,0,,Бұл сенімділік қайдан пайда болды...
Dialogue: 0,0:14:34.66,0:14:36.25,Default,,0,0,0,,Бұл көне түр ме...
Dialogue: 0,0:14:36.41,0:14:38.54,Default,,0,0,0,,Баяндауыңыз үшін рахмет.
Dialogue: 0,0:14:38.66,0:14:41.04,Default,,0,0,0,,қандай сипаттамалар бар?
Dialogue: 0,0:14:41.17,0:14:42.54,Default,,0,0,0,,Оның кеудесі үлкен болды.
Dialogue: 0,0:14:42.67,0:14:46.34,Default,,0,0,0,,Бұл оның ересек денеге айналғанын білдіре ме?
Dialogue: 0,0:14:46.46,0:14:47.59,Default,,0,0,0,,Чи…
Dialogue: 0,0:14:47.72,0:14:50.05,Default,,0,0,0,,Қызық! Олай қарама!
Dialogue: 0,0:14:50.18,0:14:51.30,Default,,0,0,0,,Ах Лилли
Dialogue: 0,0:14:51.47,0:14:54.10,Default,,0,0,0,,Ойланып қарашы, сен есейгенде не істедің?
Dialogue: 0,0:14:54.22,0:14:56.68,Default,,0,0,0,,Сіз өскіңіз келді ме?
Dialogue: 0,0:14:56.81,0:14:59.23,Default,,0,0,0,,Ет жегің келді ме?
Dialogue: 0,0:14:59.35,0:15:00.31,Default,,0,0,0,,Сіз көп жедіңіз!
Dialogue: 0,0:15:00.44,0:15:03.02,Default,,0,0,0,,Бұл маңызды емес сияқты.
Dialogue: 0,0:15:03.23,0:15:04.90,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,0:15:05.02,0:15:08.11,Default,,0,0,0,,Жарайды, мен оны осы жерден қарастырамын.
Dialogue: 0,0:15:08.24,0:15:10.03,Default,,0,0,0,,О, танысқаныма қуаныштымын.
Dialogue: 0,0:15:10.15,0:15:11.28,Default,,0,0,0,,(жөтел жөтел)\NМен бұл
Dialogue: 0,0:15:11.41,0:15:14.53,Default,,0,0,0,,Енді бүгін не істейсің?
Dialogue: 0,0:15:14.66,0:15:17.62,Default,,0,0,0,,Ауылдың айналасындағы дала гүлдерін жинау туралы не айтасыз?
Dialogue: 0,0:15:17.75,0:15:20.96,Default,,0,0,0,,Бағасы қолайлы және ауыл тұрғындары өте риза, сондықтан міндетті түрде көріңіз!
Dialogue: 0,0:15:21.21,0:15:24.04,Default,,0,0,0,,Жоқ, бұл жұмыс та маңызды.
Dialogue: 0,0:15:24.17,0:15:26.55,Default,,0,0,0,,Біріншіден, мен бұл жігітті төбелесуге дағдыландыруым керек.
Dialogue: 0,0:15:26.67,0:15:29.47,Default,,0,0,0,,Бұл да рас.
Dialogue: 0,0:15:29.59,0:15:33.26,Default,,0,0,0,,Егер солай болса, бұл шлам материалдарын жеткізу болар ма еді?
Dialogue: 0,0:15:33.39,0:15:37.27,Default,,0,0,0,,Мен оны алхимияда қолданамын, сондықтан мен оны үнемі сатып аламын.
Dialogue: 0,0:15:37.39,0:15:40.18,Default,,0,0,0,,Бұл сенің бүгінгі жұмысың.
Dialogue: 0,0:15:40.31,0:15:43.77,Default,,0,0,0,,Күрсін... Әй! Маған қалдырыңыз!
Dialogue: 0,0:15:44.23,0:15:49.61,Default,,0,0,0,,Хэхе! Бүгінгі түннің лала семсері қанішер.
Dialogue: 0,0:15:49.78,0:15:51.28,Default,,0,0,0,,Әлі таң
Dialogue: 0,0:15:53.36,0:15:54.99,Default,,0,0,0,,Сау бол, Хаджиме
Dialogue: 0,0:15:55.12,0:15:58.41,Default,,0,0,0,,Кеше бір құбыжық Лиллиді жемек болды.
Dialogue: 0,0:15:58.54,0:16:00.87,Default,,0,0,0,,Міне бүгін сенің жауың.
Dialogue: 0,0:16:01.54,0:16:02.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:02.67,0:16:04.38,Default,,0,0,0,,сіздің жауыңыз
Dialogue: 0,0:16:04.50,0:16:08.75,Default,,0,0,0,,Кенеттен мен қарсыласпен шешуші шайқасқа әлі ерте сияқты сезінемін.
Dialogue: 0,0:16:09.42,0:16:13.72,Default,,0,0,0,,Сен менің қарсыласымсың, ол керемет, иә...
Dialogue: 0,0:16:13.84,0:16:16.64,Default,,0,0,0,,Егер сіз оны жеңе алмасаңыз, сіз тым авантюристсіз.
Dialogue: 0,0:16:16.80,0:16:20.64,Default,,0,0,0,,Ах! Жарайды! Мен Лиллиді толығымен жеңе аламын!
Dialogue: 0,0:16:20.77,0:16:22.77,Default,,0,0,0,,Иә, алдымен...
Dialogue: 0,0:16:22.89,0:16:24.98,Default,,0,0,0,,Сіз қорқынышты емессіз!
Dialogue: 0,0:16:25.10,0:16:26.40,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:16:26.52,0:16:27.23,Default,,0,0,0,,О!
Dialogue: 0,0:16:32.70,0:16:34.16,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:16:37.28,0:16:38.62,Default,,0,0,0,,Білесің бе, Лилли...
Dialogue: 0,0:16:38.74,0:16:41.58,Default,,0,0,0,,Ри Лилуи Мен аздап абайсызда болдым.
Dialogue: 0,0:16:41.70,0:16:43.62,Default,,0,0,0,,О, сен білесің.
Dialogue: 0,0:16:43.75,0:16:44.79,Default,,0,0,0,,Ең алдымен... Теря~!
Dialogue: 0,0:16:44.96,0:16:46.42,Default,,0,0,0,,Адамдарды тыңда!
Dialogue: 0,0:16:48.79,0:16:50.67,Default,,0,0,0,,Хия~
Dialogue: 0,0:16:50.76,0:16:52.72,Default,,0,0,0,,Иә
Dialogue: 0,0:16:55.09,0:16:56.43,Default,,0,0,0,,<О~о~>
Dialogue: 0,0:16:56.93,0:17:00.93,Default,,0,0,0,,<Басқалардың айтқанын тыңдамаймын, бірақ бар күшімді саламын...>
Dialogue: 0,0:17:01.06,0:17:03.43,Default,,0,0,0,,<Бірақ ол қатал бала>
Dialogue: 0,0:17:03.98,0:17:08.19,Default,,0,0,0,,<Ата-анам тастап кеткеніне қарамастан, мен күліп, жақсы тамақтанамын>
Dialogue: 0,0:17:08.31,0:17:09.23,Default,,0,0,0,,Уау
Dialogue: 0,0:17:09.36,0:17:12.19,Default,,0,0,0,,<Мүмкін, бұл шытырман оқиғалыларға таңқаларлықтай қолайлы шығар...>
Dialogue: 0,0:17:16.61,0:17:19.95,Default,,0,0,0,,Мен тағы да сәтсіздікке ұшырадым...
Dialogue: 0,0:17:20.20,0:17:21.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:21.45,0:17:23.83,Default,,0,0,0,,Жарайды, түскі ас ішейік.
Dialogue: 0,0:17:23.96,0:17:26.33,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:26.46,0:17:27.58,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:31.00,0:17:34.34,Default,,0,0,0,,О, қандай тамаша көрініс.
Dialogue: 0,0:17:34.51,0:17:37.43,Default,,0,0,0,,Босаңсып жатқандай сезіне ме?
Dialogue: 0,0:17:37.55,0:17:41.97,Default,,0,0,0,,Мен декорацияға қызықпадым, бірақ тамаша.
Dialogue: 0,0:17:43.06,0:17:45.23,Default,,0,0,0,,Қараңдаршы, жарты жарым.
Dialogue: 0,0:17:45.73,0:17:48.44,Default,,0,0,0,,Наталидің арнайы сағыз наны
Dialogue: 0,0:17:49.73,0:17:51.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.40,0:17:54.99,Default,,0,0,0,,Ки Лилли бүгін түскі асқа жарайды.
Dialogue: 0,0:17:55.11,0:17:56.61,Default,,0,0,0,,ше? Неліктен?
Dialogue: 0,0:17:56.74,0:18:00.32,Default,,0,0,0,,Лилли мен бүгін жұмыс істей алмадым...
Dialogue: 0,0:18:00.45,0:18:03.33,Default,,0,0,0,,Сондықтан Хажиме бәрін жейді.
Dialogue: 0,0:18:08.92,0:18:10.75,Default,,0,0,0,,<Түсіндім! Бұл жігіт...＞
Dialogue: 0,0:18:10.96,0:18:13.55,Default,,0,0,0,,<Сіз көп нәрсені істей аламын деп ойладыңыз ба?>
Dialogue: 0,0:18:13.67,0:18:18.01,Default,,0,0,0,,<Бірақ мен ойлағандай істей алмадым, тамақ алуға қорықтым! ＞
Dialogue: 0,0:18:18.18,0:18:22.81,Default,,0,0,0,,<Мен аздап істей аламын деп ойладым, сондықтан мен көп тамақ жей алдым.>
Dialogue: 0,0:18:22.93,0:18:24.77,Default,,0,0,0,,<Күліп үлгердім>
Dialogue: 0,0:18:24.89,0:18:28.77,Default,,0,0,0,,<Бірақ мен күткеннен де пайдасыз болдым> Мен таңғы асты тым көп жедім.
Dialogue: 0,0:18:29.69,0:18:32.02,Default,,0,0,0,,<Оны қайтадан лақтыруы мүмкін>
Dialogue: 0,0:18:32.61,0:18:36.03,Default,,0,0,0,,<Бұл жігіт дәл қазір шағымдануға тырысуда>
Dialogue: 0,0:18:36.28,0:18:39.53,Default,,0,0,0,,<"Өтінемін, лақтырмаңыз"! ＞
Dialogue: 0,0:18:44.04,0:18:46.91,Default,,0,0,0,,<Е! Мұндай жағдайда не істеуім керек? ＞
Dialogue: 0,0:18:47.04,0:18:50.54,Default,,0,0,0,,<Менің өмірім негізінен тамақ ішу, ұйықтау және күресу болды! ＞
Dialogue: 0,0:18:55.13,0:18:59.09,Default,,0,0,0,,<Егер мен мұны істей алсам, мен қазір алаяқтықпен өмір сүретін едім...>
Dialogue: 0,0:18:59.22,0:19:00.47,Default,,0,0,0,,Тек тамақтаныңыз!
Dialogue: 0,0:19:00.59,0:19:02.55,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:03.64,0:19:06.81,Default,,0,0,0,,<Дұрыс... Аузыңа күштеп салуым керек пе? ＞
Dialogue: 0,0:19:13.81,0:19:15.11,Default,,0,0,0,,<Сен білесің бе>
Dialogue: 0,0:19:15.23,0:19:18.07,Default,,0,0,0,,<Мен бұл жігіттің ата-анасы емеспін...>
Dialogue: 0,0:19:21.20,0:19:22.95,Default,,0,0,0,,Бұл авантюрист стилі.
Dialogue: 0,0:19:23.07,0:19:26.99,Default,,0,0,0,,«Еңбек етпесең, аштан өл». Түскі асты өткізіп жіберу дұрыс па?
Dialogue: 0,0:19:27.12,0:19:28.79,Default,,0,0,0,,Иә! (асқазан айқайлайды)
Dialogue: 0,0:19:28.91,0:19:31.42,Default,,0,0,0,,О, қазір басқаша!
Dialogue: 0,0:19:31.54,0:19:34.09,Default,,0,0,0,,О! Ал, енді зынданға оралайық.
Dialogue: 0,0:19:34.21,0:19:36.46,Default,,0,0,0,,О? Хаджименің түскі асы ше?
Dialogue: 0,0:19:37.42,0:19:39.22,Default,,0,0,0,,Бұл достың стилі...
Dialogue: 0,0:19:39.34,0:19:40.59,Default,,0,0,0,,(Асқазанның айқайлауы)
Dialogue: 0,0:19:41.34,0:19:44.72,Default,,0,0,0,,Сіз бір ғана досыңызды қанағаттандыра аласыз ба?
Dialogue: 0,0:19:44.85,0:19:46.06,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:46.18,0:19:47.22,Default,,0,0,0,,Лилли! Аа!?
Dialogue: 0,0:19:47.43,0:19:50.23,Default,,0,0,0,,Егер бұл орын алса, шламды тез жеңіңіз.
Dialogue: 0,0:19:50.35,0:19:52.23,Default,,0,0,0,,Екіге кешкі ас ішейік!
Dialogue: 0,0:19:52.35,0:19:53.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:55.52,0:19:56.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:58.90,0:20:01.61,Default,,0,0,0,,Тыңда, ең алдымен жақсылап қара.
Dialogue: 0,0:20:01.74,0:20:04.45,Default,,0,0,0,,Мен сенімен ұрысқан кездегіден басқа нәрсе бар, солай ма?
Dialogue: 0,0:20:04.57,0:20:05.66,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:20:06.49,0:20:07.83,Default,,0,0,0,,Ммм
Dialogue: 0,0:20:08.33,0:20:11.50,Default,,0,0,0,,Ах! Көздер денеге батып кетті!
Dialogue: 0,0:20:11.62,0:20:14.75,Default,,0,0,0,,Дұрыс. Сіз шламның әлсіздігін білесіз бе?
Dialogue: 0,0:20:14.88,0:20:15.75,Default,,0,0,0,,Фут!?
Dialogue: 0,0:20:15.88,0:20:18.50,Default,,0,0,0,,Көздер, көздер! Сіздің аяқтарыңыз қайда?
Dialogue: 0,0:20:18.92,0:20:23.80,Default,,0,0,0,,Бірақ Лилли шабуыл жасауға тырысқанда, ол бірден жаншып қалады.
Dialogue: 0,0:20:23.93,0:20:26.35,Default,,0,0,0,,Лилуи шламының көзі бар...
Dialogue: 0,0:20:26.47,0:20:28.89,Default,,0,0,0,,Сол кезде мен дыбысты естідім! (құлаған тастардың дыбысы)
Dialogue: 0,0:20:29.14,0:20:31.60,Default,,0,0,0,,Содан кейін, үнсіз жақындаңыз...
Dialogue: 0,0:20:31.98,0:20:33.10,Default,,0,0,0,,Өлтір!
Dialogue: 0,0:20:33.23,0:20:34.44,Default,,0,0,0,,♬~
Dialogue: 0,0:20:37.57,0:20:40.15,Default,,0,0,0,,А, мен жасадым...
Dialogue: 0,0:20:40.82,0:20:43.78,Default,,0,0,0,,Мен оны жеңе алдым!
Dialogue: 0,0:20:45.78,0:20:49.37,Default,,0,0,0,,Хэхехе~ Лилуи де солай жасайды!
Dialogue: 0,0:20:51.12,0:20:53.66,Default,,0,0,0,,Уф... Мен өзімді біртүрлі сезініп тұрмын.
Dialogue: 0,0:20:56.54,0:20:58.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:58.29,0:21:02.42,Default,,0,0,0,,Натали жасаған нан өте дәмді, Хажиме!
Dialogue: 0,0:21:02.55,0:21:04.18,Default,,0,0,0,,Иә
Dialogue: 0,0:21:06.93,0:21:10.18,Default,,0,0,0,,<Сіз маған сендіңіз бе?>
Dialogue: 0,0:21:10.31,0:21:14.10,Default,,0,0,0,,Кешіріңіз! Мен әлі көне түрлерді зерттеуді аяқтаған жоқпын!
Dialogue: 0,0:21:14.27,0:21:15.85,Default,,0,0,0,,О, сирек
Dialogue: 0,0:21:15.98,0:21:18.90,Default,,0,0,0,,Ауыл бастығы түскі асқа шақырды...
Dialogue: 0,0:21:19.02,0:21:20.86,Default,,0,0,0,,А, онда мен оған көмектесе алмаймын.
Dialogue: 0,0:21:20.98,0:21:23.44,Default,,0,0,0,,Лилли шламды жеңе алды!
Dialogue: 0,0:21:23.57,0:21:25.70,Default,,0,0,0,,Ах! Құттықтаймыз!
Dialogue: 0,0:21:25.82,0:21:26.61,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:28.74,0:21:30.83,Default,,0,0,0,,Біз жақсы доспыз~
Dialogue: 0,0:21:30.95,0:21:34.41,Default,,0,0,0,,Даа! Мен ұмыттым! Лилиді босат!
Dialogue: 0,0:21:34.54,0:21:36.67,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:21:36.79,0:21:40.46,Default,,0,0,0,,Хехехе, олар ата-ана мен балаға ұқсайды.
Dialogue: 0,0:21:47.80,0:21:50.22,Default,,0,0,0,,О? Бұл ма?
Dialogue: 0,0:21:51.22,0:21:56.60,Default,,0,0,0,,<Кеш түн, бала көтере алатындай жылдам өсу...>
Dialogue: 0,0:21:56.73,0:21:58.23,Default,,0,0,0,,<Succubus>
Dialogue: 0,0:21:59.02,0:22:02.86,Default,,0,0,0,,<Жақсысың ба, Шинономе-сан?>
Dialogue: 0,0:22:02.98,0:22:05.07,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:05.40,0:22:08.36,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.45,0:23:34.41,Default,,0,0,0,,～♪
