Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.04,0:00:05.42,Default,,0,0,0,,О? Бұл ма?
Dialogue: 0,0:00:06.38,0:00:11.80,Default,,0,0,0,,<Кеш түн, бала көтере алатындай жылдам өсу...>
Dialogue: 0,0:00:11.92,0:00:13.43,Default,,0,0,0,,<Succubus>
Dialogue: 0,0:00:13.97,0:00:15.59,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:15.80,0:00:17.60,Default,,0,0,0,,Хажиме
Dialogue: 0,0:00:24.14,0:00:26.73,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:00:27.23,0:00:30.61,Default,,0,0,0,,Хаджиме Оның иісі жақсы~
Dialogue: 0,0:00:31.11,0:00:34.61,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:00:34.74,0:00:37.24,Default,,0,0,0,,(тауық айқайлау)
Dialogue: 0,0:00:37.37,0:00:39.91,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:00:40.04,0:00:42.37,Default,,0,0,0,,Қайырлы таң! (есік жабылған дыбыс)
Dialogue: 0,0:00:44.54,0:00:47.50,Default,,0,0,0,,Иә? Не істеп жатырсың, Шинономе-сан?
Dialogue: 0,0:00:47.63,0:00:50.38,Default,,0,0,0,,Жоқ, мен біртүрлі түс көрдім...
Dialogue: 0,0:00:50.63,0:00:54.42,Default,,0,0,0,,<Мені үлкен тау қасқыры иіскеді>
Dialogue: 0,0:00:54.84,0:00:56.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:56.55,0:00:57.80,Default,,0,0,0,,Иә
Dialogue: 0,0:00:57.93,0:01:00.56,Default,,0,0,0,,Сіз сұраған Лилли-чанның нәсіліне қатысты.
Dialogue: 0,0:01:00.72,0:01:01.93,Default,,0,0,0,,О!
Dialogue: 0,0:01:02.06,0:01:04.94,Default,,0,0,0,,Суккубус шығар
Dialogue: 0,0:01:05.06,0:01:06.73,Default,,0,0,0,,Суккубус?
Dialogue: 0,0:01:06.85,0:01:09.06,Default,,0,0,0,,Лилли Суккубус?
Dialogue: 0,0:01:09.19,0:01:11.44,Default,,0,0,0,,Сакубас дегеніміз не?
Dialogue: 0,0:01:11.57,0:01:13.40,Default,,0,0,0,,Бұл көне түр.
Dialogue: 0,0:01:13.90,0:01:15.11,Default,,0,0,0,,Бұл дүниеде
Dialogue: 0,0:01:15.24,0:01:18.24,Default,,0,0,0,,Адамдық құбыжық Эльф
Dialogue: 0,0:01:18.37,0:01:21.41,Default,,0,0,0,,Гномдардың төрт нәсілі бар.
Dialogue: 0,0:01:21.54,0:01:24.08,Default,,0,0,0,,Бұл нәсілдің кез келгенінен өте сирек
Dialogue: 0,0:01:24.45,0:01:28.71,Default,,0,0,0,,<Вампирлер, қасқырлар, Медуза, су перілері және т.б.>
Dialogue: 0,0:01:28.83,0:01:32.71,Default,,0,0,0,,<Ежелгі нәсілдерге тән қасиеттермен туатын адамдар бар...>
Dialogue: 0,0:01:32.84,0:01:35.97,Default,,0,0,0,,Мұндай адамдарды біз ежелгі түр деп атаймыз.
Dialogue: 0,0:01:38.59,0:01:40.93,Default,,0,0,0,,Бұл сирек кездесетін түр.
Dialogue: 0,0:01:41.05,0:01:42.68,Default,,0,0,0,,О... ой!
Dialogue: 0,0:01:42.81,0:01:45.48,Default,,0,0,0,,Шүкір, мына жігіт суккубус.
Dialogue: 0,0:01:45.60,0:01:47.85,Default,,0,0,0,,Мен сенімді емеспін...
Dialogue: 0,0:01:47.98,0:01:52.23,Default,,0,0,0,,Суккубустың өзінен растауын сұраған дұрыс.
Dialogue: 0,0:01:52.40,0:01:53.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:54.07,0:01:58.11,Default,,0,0,0,,А... Мен бір адамды білемін, бірақ ол.
Dialogue: 0,0:01:58.24,0:02:01.49,Default,,0,0,0,,Не істерімді білмеймін...
Dialogue: 0,0:02:05.37,0:02:07.37,Default,,0,0,0,,А? Не?
Dialogue: 0,0:02:07.50,0:02:09.67,Default,,0,0,0,,Бухихихи...
Dialogue: 0,0:02:09.92,0:02:15.38,Default,,0,0,0,,Ауылда апамдай сұлу әйел болады деп ойламаппын.
Dialogue: 0,0:02:15.71,0:02:18.13,Default,,0,0,0,,Бухихихи қанша?
Dialogue: 0,0:02:18.26,0:02:19.26,Default,,0,0,0,,Ей!
Dialogue: 0,0:02:23.22,0:02:25.93,Default,,0,0,0,,Вероника!
Dialogue: 0,0:02:26.35,0:02:29.31,Default,,0,0,0,,♪～
Dialogue: 0,0:03:52.39,0:03:55.36,Default,,0,0,0,,～♪
Dialogue: 0,0:03:56.48,0:03:59.40,Default,,0,0,0,,Бухихихи қанша?
Dialogue: 0,0:04:00.07,0:04:01.90,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:04:02.07,0:04:03.03,Default,,0,0,0,,Не!?
Dialogue: 0,0:04:03.16,0:04:07.95,Default,,0,0,0,,Бұл мыс тиын емес пе? Уақытымның жарты сағатын да сатып ала алмаймын.
Dialogue: 0,0:04:08.08,0:04:08.95,Default,,0,0,0,,Гү!
Dialogue: 0,0:04:09.58,0:04:12.50,Default,,0,0,0,,Ей, тым ренжіме!
Dialogue: 0,0:04:12.62,0:04:13.96,Default,,0,0,0,,Менің көргенім...
Dialogue: 0,0:04:14.08,0:04:18.71,Default,,0,0,0,,Сен саяхатшысың, сен бұл ауылдан емессің, солай ма?
Dialogue: 0,0:04:18.84,0:04:20.80,Default,,0,0,0,,Сонда сіз не айтасыз?
Dialogue: 0,0:04:20.92,0:04:22.01,Default,,0,0,0,,О! иә?
Dialogue: 0,0:04:22.17,0:04:23.34,Default,,0,0,0,,…ол үстем болатынына сенді.
Dialogue: 0,0:04:23.55,0:04:24.63,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:04:24.76,0:04:27.35,Default,,0,0,0,,Grrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr!
Dialogue: 0,0:04:27.55,0:04:31.81,Default,,0,0,0,,Бұл ауылда мен сияқты кәсіппен айналысатындар бар.
Dialogue: 0,0:04:31.93,0:04:35.73,Default,,0,0,0,,Оны басқа біреу алып кете алмайды ма?
Dialogue: 0,0:04:35.85,0:04:39.32,Default,,0,0,0,,Менің ойымша, сіз гильдияда осындай түсініктеме алуыңыз керек еді, солай ма?
Dialogue: 0,0:04:39.40,0:04:41.49,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:04:41.61,0:04:45.99,Default,,0,0,0,,Қызық, сенің есте сақтау қабілетің қаншалықты нашар, Құбыжық?
Dialogue: 0,0:04:46.36,0:04:48.99,Default,,0,0,0,,Осы сапарда мен сіз сияқты адамдарға бір нәрсені түсіндіремін (соққы дыбысы)
Dialogue: 0,0:04:49.12,0:04:51.16,Default,,0,0,0,,Бұл неше рет болды деп ойлайсың?
Dialogue: 0,0:04:51.29,0:04:55.00,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:04:58.13,0:04:59.13,Default,,0,0,0,,Төраға!
Dialogue: 0,0:04:59.25,0:05:00.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:00.67,0:05:03.30,Default,,0,0,0,,Сен қайтып келдің, Хаджиме.
Dialogue: 0,0:05:03.42,0:05:10.01,Default,,0,0,0,,А... А, біраз болды, Вероника.
Dialogue: 0,0:05:11.47,0:05:14.06,Default,,0,0,0,,Аа~ Хат жазған осы ма?
Dialogue: 0,0:05:14.18,0:05:15.52,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:15.94,0:05:18.23,Default,,0,0,0,,Бауырым, сен не істеп жатырсың?
Dialogue: 0,0:05:18.36,0:05:19.23,Default,,0,0,0,,Орындық!
Dialogue: 0,0:05:19.36,0:05:20.52,Default,,0,0,0,,Қарама!
Dialogue: 0,0:05:20.65,0:05:23.65,Default,,0,0,0,,Ой, қызық, орындық неге сөйлейді?
Dialogue: 0,0:05:23.78,0:05:27.03,Default,,0,0,0,,Ха! өте өкінішті!
Dialogue: 0,0:05:27.16,0:05:28.62,Default,,0,0,0,,Бұл Лилуй-чан ба?
Dialogue: 0,0:05:28.78,0:05:30.95,Default,,0,0,0,,Маған қол ұшын бере аласыз ба?
Dialogue: 0,0:05:31.08,0:05:32.29,Default,,0,0,0,,Қол?
Dialogue: 0,0:05:32.45,0:05:33.95,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:34.66,0:05:35.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:38.67,0:05:40.92,Default,,0,0,0,,Ой, уау!
Dialogue: 0,0:05:41.04,0:05:43.34,Default,,0,0,0,,Лилли-чан әдемі қызға айналды!
Dialogue: 0,0:05:43.46,0:05:45.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:45.26,0:05:49.09,Default,,0,0,0,,Сіз менімен келістіңіз, сондықтан бұл сөзсіз суккубус.
Dialogue: 0,0:05:49.26,0:05:50.26,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:05:52.31,0:05:54.18,Default,,0,0,0,,Бұл керемет, әпке!
Dialogue: 0,0:05:54.31,0:05:58.65,Default,,0,0,0,,Ол Лилуиді үлкейтіп жатыр, ол күшті және ол керемет!
Dialogue: 0,0:05:58.77,0:06:00.69,Default,,0,0,0,,Ухуху рахмет
Dialogue: 0,0:06:00.81,0:06:04.94,Default,,0,0,0,,Лилли де суккубус, демек ол үлкен әпкесі сияқты күшті бола ма?
Dialogue: 0,0:06:05.07,0:06:06.95,Default,,0,0,0,,Мен сияқты жаттығу жасасаң
Dialogue: 0,0:06:07.07,0:06:09.95,Default,,0,0,0,,Керемет! Неге жаттығып жатырсың?
Dialogue: 0,0:06:10.07,0:06:14.95,Default,,0,0,0,,Уф... Маған ер адамның қиналғандағы түрі ұнайды.
Dialogue: 0,0:06:15.79,0:06:20.58,Default,,0,0,0,,<Аа... сен әлі садистсің! ＞
Dialogue: 0,0:06:20.71,0:06:22.38,Default,,0,0,0,,Натали, тамақ беріледі.
Dialogue: 0,0:06:22.50,0:06:23.46,Default,,0,0,0,,Иә
Dialogue: 0,0:06:23.59,0:06:25.59,Default,,0,0,0,,Аа, не...
Dialogue: 0,0:06:25.76,0:06:28.01,Default,,0,0,0,,Кешіріңіз, сіздің жолыңыздан шығып кеткеніңіз үшін.
Dialogue: 0,0:06:28.13,0:06:32.47,Default,,0,0,0,,Иә? Жарайды ма? Мен де уайымдадым
Dialogue: 0,0:06:32.60,0:06:35.85,Default,,0,0,0,,Мен түсіндім, бірақ ол тегін болуы мүмкін емес, солай ма?
Dialogue: 0,0:06:35.97,0:06:37.18,Default,,0,0,0,,Нарық бағасы қанша...
Dialogue: 0,0:06:37.31,0:06:38.98,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:06:39.10,0:06:40.10,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:40.23,0:06:41.40,Default,,0,0,0,,бірнеше ондаған күн ғана созылғанымен, біз бір толқында болдық—
Dialogue: 0,0:06:43.61,0:06:46.69,Default,,0,0,0,,А... Түсіндім! адал бол
Dialogue: 0,0:06:48.24,0:06:49.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:49.90,0:06:54.45,Default,,0,0,0,,Пуха, сенің мінезің нашар, сондықтан саған қарыз болғым келмейді.
Dialogue: 0,0:06:54.58,0:06:58.04,Default,,0,0,0,,Кейін маған не болатынын білмеймін.
Dialogue: 0,0:06:58.16,0:06:58.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:59.04,0:07:02.29,Default,,0,0,0,,Өтінемін, ақшамен шешуге рұқсат етіңіз.
Dialogue: 0,0:07:02.42,0:07:06.59,Default,,0,0,0,,Ух... хехехе Кейде мен мұны тек жақсы ниетпен жасаймын...
Dialogue: 0,0:07:06.71,0:07:08.80,Default,,0,0,0,,Вахахаха! Бұл жақсы!
Dialogue: 0,0:07:08.92,0:07:10.88,Default,,0,0,0,,Әзірше, осы жерден тамақтанайық!
Dialogue: 0,0:07:11.01,0:07:13.05,Default,,0,0,0,,Натали, екі сыра!
Dialogue: 0,0:07:13.18,0:07:14.30,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:07:14.43,0:07:17.64,Default,,0,0,0,,Хажиме! Сыра дәмді ме?
Dialogue: 0,0:07:17.77,0:07:20.14,Default,,0,0,0,,Иә? Бала болу тым жақсы!
Dialogue: 0,0:07:20.27,0:07:23.19,Default,,0,0,0,,Ал, мен оны ішкім келеді!
Dialogue: 0,0:07:23.31,0:07:24.44,Default,,0,0,0,,Ет жеу.
Dialogue: 0,0:07:24.56,0:07:27.23,Default,,0,0,0,,Ммм! Шулы
Dialogue: 0,0:07:27.36,0:07:29.15,Default,,0,0,0,,Фуфу
Dialogue: 0,0:07:29.28,0:07:31.66,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:07:38.70,0:07:39.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:40.04,0:07:42.83,Default,,0,0,0,,Хмм…
Dialogue: 0,0:07:43.12,0:07:46.34,Default,,0,0,0,,Бұл кім ерте?
Dialogue: 0,0:07:50.72,0:07:53.34,Default,,0,0,0,,Қайырлы таң Лилли Чан
Dialogue: 0,0:07:53.47,0:07:56.85,Default,,0,0,0,,О? Қайырлы таң.
Dialogue: 0,0:07:56.97,0:07:58.64,Default,,0,0,0,,Хехе...
Dialogue: 0,0:07:58.77,0:08:00.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:00.98,0:08:06.23,Default,,0,0,0,,Иә, иә, у, у, у...
Dialogue: 0,0:08:06.36,0:08:07.86,Default,,0,0,0,,Мен оны Юбеден де көрдім.
Dialogue: 0,0:08:07.98,0:08:11.61,Default,,0,0,0,,Менің досым күткендей, бұл...
Dialogue: 0,0:08:11.74,0:08:14.86,Default,,0,0,0,,Иә? Неліктен таң ерте...
Dialogue: 0,0:08:15.45,0:08:17.74,Default,,0,0,0,,Сәлем Хаджиме! (Лилуи/Хаджиме) Иә?
Dialogue: 0,0:08:18.24,0:08:21.25,Default,,0,0,0,,Лилуй-чан, оны маған бере аласың ба?
Dialogue: 0,0:08:28.13,0:08:28.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:29.00,0:08:31.92,Default,,0,0,0,,Жоқ, соңғы кездері дүкендегі қыздар бірінен соң бірі зейнеткерлікке шығып жатыр.
Dialogue: 0,0:08:32.09,0:08:34.22,Default,,0,0,0,,Мен жаңа қыз іздедім!
Dialogue: 0,0:08:34.38,0:08:38.26,Default,,0,0,0,,Мұнда талантты адам бар! Pitch Pichi!
Dialogue: 0,0:08:38.39,0:08:40.52,Default,,0,0,0,,Жоқ... дарынды адам...
Dialogue: 0,0:08:40.64,0:08:43.18,Default,,0,0,0,,Иә? Сіз мен сияқты суккубуссыз ба!?
Dialogue: 0,0:08:43.31,0:08:45.27,Default,,0,0,0,,Ол сөзсіз талантты!
Dialogue: 0,0:08:45.40,0:08:47.36,Default,,0,0,0,,Сұлулық талант па?
Dialogue: 0,0:08:47.48,0:08:48.90,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:08:49.11,0:08:51.65,Default,,0,0,0,,Ха... Хаджиме...
Dialogue: 0,0:08:54.74,0:08:57.41,Default,,0,0,0,,Вероника Кешіріңіз, бірақ...
Dialogue: 0,0:08:57.53,0:09:01.45,Default,,0,0,0,,Екеуміздің жақсы араласқанымыз өте жаман.
Dialogue: 0,0:09:01.58,0:09:03.79,Default,,0,0,0,,Біз шынымен тіл табыспаймыз!!
Dialogue: 0,0:09:04.04,0:09:05.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:05.54,0:09:08.54,Default,,0,0,0,,А, жоқ... бұл басқа...
Dialogue: 0,0:09:08.67,0:09:10.42,Default,,0,0,0,,<Hehe>
Dialogue: 0,0:09:10.55,0:09:13.01,Default,,0,0,0,,Жақсы, олар достық сияқты көрінді, бірақ...?
Dialogue: 0,0:09:13.17,0:09:15.80,Default,,0,0,0,,Бір-бірімізге қамқорлық жасайтын сияқтымыз.
Dialogue: 0,0:09:15.93,0:09:18.14,Default,,0,0,0,,Иә? Бұл әзіл емес!
Dialogue: 0,0:09:18.85,0:09:19.80,Default,,0,0,0,,Ах
Dialogue: 0,0:09:19.97,0:09:21.18,Default,,0,0,0,,А, жоқ, бұл дұрыс емес...
Dialogue: 0,0:09:21.31,0:09:23.56,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:09:23.68,0:09:25.64,Default,,0,0,0,,Мен өзіммен бірге Лилли-чанды алып кетсем
Dialogue: 0,0:09:25.77,0:09:28.31,Default,,0,0,0,,Хаджиме жалғыз авантюрист болады.
Dialogue: 0,0:09:28.44,0:09:30.98,Default,,0,0,0,,Жалғыздық сезініп, жыламайсың ба?
Dialogue: 0,0:09:32.19,0:09:34.40,Default,,0,0,0,,Барка! Жылама!
Dialogue: 0,0:09:34.53,0:09:38.07,Default,,0,0,0,,Жұмыс тиімділігі артады және онсыз тегіс болады!
Dialogue: 0,0:09:41.24,0:09:42.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:45.58,0:09:47.96,Default,,0,0,0,,Ах... эй...
Dialogue: 0,0:09:48.08,0:09:49.33,Default,,0,0,0,,Лилли…
Dialogue: 0,0:09:52.09,0:09:54.88,Default,,0,0,0,,Пупу Бұл өте қарапайым, Хаджиме.
Dialogue: 0,0:09:55.01,0:09:56.22,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:09:56.34,0:09:57.76,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:57.88,0:10:01.05,Default,,0,0,0,,Қарашы, менің мінезім нашар.
Dialogue: 0,0:10:01.18,0:10:02.01,Default,,0,0,0,,Tsk!
Dialogue: 0,0:10:02.14,0:10:06.98,Default,,0,0,0,,Мен қызды қалайтыным рас! Уухуху~
Dialogue: 0,0:10:07.10,0:10:10.23,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:10:10.65,0:10:13.82,Default,,0,0,0,,Жарайды, бүгін біз жеңіл тастарды жинаймыз.
Dialogue: 0,0:10:13.98,0:10:15.99,Default,,0,0,0,,Dungeon қалпына келтіру жақында келеді!
Dialogue: 0,0:10:16.11,0:10:19.36,Default,,0,0,0,,Біз терең сүңгіп бара жатқанда адаспа, Лилли!
Dialogue: 0,0:10:26.04,0:10:29.92,Default,,0,0,0,,Ах... хахаха! Бұл не, Лилли? Қалыңыз қалай?
Dialogue: 0,0:10:30.04,0:10:32.67,Default,,0,0,0,,Лилли Себебі бұл пайдасыз...
Dialogue: 0,0:10:32.79,0:10:34.50,Default,,0,0,0,,А, жоқ... бұл...
Dialogue: 0,0:10:34.63,0:10:36.88,Default,,0,0,0,,Сұмдық айтатын адам.
Dialogue: 0,0:10:37.01,0:10:39.18,Default,,0,0,0,,Tsk! (Вероника) Кухихи!
Dialogue: 0,0:10:39.30,0:10:40.80,Default,,0,0,0,,Жарайды, Лилли-чан.
Dialogue: 0,0:10:40.93,0:10:43.60,Default,,0,0,0,,Лилли-чан бекер емес, солай ма?
Dialogue: 0,0:10:44.43,0:10:45.89,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:10:46.02,0:10:47.85,Default,,0,0,0,,Сізді қорлап жатқан сияқты.
Dialogue: 0,0:10:47.98,0:10:48.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:49.14,0:10:52.36,Default,,0,0,0,,Мен қызғанамын! Маған сырын айтшы!
Dialogue: 0,0:10:52.48,0:10:53.90,Default,,0,0,0,,Шулы!
Dialogue: 0,0:10:56.03,0:11:00.07,Default,,0,0,0,,Дұрыс. Дүкен ашу қиын болды.
Dialogue: 0,0:11:00.20,0:11:01.91,Default,,0,0,0,,Сонымен, әпкең...
Dialogue: 0,0:11:02.07,0:11:03.66,Default,,0,0,0,,<Вероника...>
Dialogue: 0,0:11:03.78,0:11:06.12,Default,,0,0,0,,<Сіз Лиллиді шындап шақыруды жоспарлап отырсыз ба? ＞
Dialogue: 0,0:11:06.24,0:11:09.66,Default,,0,0,0,,<Жоқ, сіз Лиллимен қалағаныңызды жасай аласыз...>
Dialogue: 0,0:11:09.87,0:11:11.88,Default,,0,0,0,,<Оның маған қатысы жоқ...>
Dialogue: 0,0:11:13.33,0:11:14.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:15.04,0:11:16.55,Default,,0,0,0,,Ол еденге баспаңыз!!
Dialogue: 0,0:11:16.75,0:11:18.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:18.76,0:11:20.30,Default,,0,0,0,,Қарсылау тұзағы!?
Dialogue: 0,0:11:20.43,0:11:21.93,Default,,0,0,0,,Сонымен... Уау!
Dialogue: 0,0:11:22.09,0:11:24.43,Default,,0,0,0,,Ой, мүмкін емес...
Dialogue: 0,0:11:26.89,0:11:30.73,Default,,0,0,0,,Ши... Шүкір!
Dialogue: 0,0:11:30.85,0:11:33.02,Default,,0,0,0,,О...
Dialogue: 0,0:11:39.11,0:11:40.61,Default,,0,0,0,,Уф!Қарғыс атқыр...
Dialogue: 0,0:11:40.74,0:11:43.20,Default,,0,0,0,,Жоқ! Енді реакция жасамаңыз!
Dialogue: 0,0:11:43.32,0:11:44.62,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:45.12,0:11:48.20,Default,,0,0,0,,<Зынданда мазасыздансам, не істеуім керек? ＞
Dialogue: 0,0:11:48.33,0:11:49.87,Default,,0,0,0,,<Тыныштал! Ең алдымен...＞
Dialogue: 0,0:11:50.00,0:11:52.79,Default,,0,0,0,,Бұл зынданда әлі құбыжықтар қалды ма?
Dialogue: 0,0:11:55.17,0:11:56.04,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,0:11:57.17,0:11:59.67,Default,,0,0,0,,Бұл зындан жер астында 12 қабаттан тұрады.
Dialogue: 0,0:11:59.80,0:12:02.55,Default,,0,0,0,,Мен төменгі қабаттағы құбыжықтарды жоя алмадым.
Dialogue: 0,0:12:02.84,0:12:05.05,Default,,0,0,0,,Екеуі төменгі қабатқа жіберілсе
Dialogue: 0,0:12:05.18,0:12:07.81,Default,,0,0,0,,Тіпті Вероникада қауіпті құбыжықтар әлі де қалды.
Dialogue: 0,0:12:07.93,0:12:08.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:09.14,0:12:11.98,Default,,0,0,0,,Енді төменгі қабатқа көшейік.
Dialogue: 0,0:12:12.10,0:12:13.27,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:12:13.39,0:12:17.94,Default,,0,0,0,,<Иә, егер олар жоғарғы қабатқа жіберілсе, ешқандай проблема болмас еді.>
Dialogue: 0,0:12:18.27,0:12:21.95,Default,,0,0,0,,Цк... Мен мұндай шешімді бірден қабылдай алмайтыныма сене алар емеспін.
Dialogue: 0,0:12:22.61,0:12:25.99,Default,,0,0,0,,＜Кішкентай досым болған кезде мен жынды боламын...＞
Dialogue: 0,0:12:27.16,0:12:30.25,Default,,0,0,0,,Кешіріңіз, сіз сәл асыққан сияқтысыз.
Dialogue: 0,0:12:30.37,0:12:31.41,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:12:31.54,0:12:33.71,Default,,0,0,0,,Айтпақшы, сіздің атыңыз...
Dialogue: 0,0:12:33.87,0:12:35.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:35.50,0:12:37.46,Default,,0,0,0,,Мені «шошқа» деп атаңыз!
Dialogue: 0,0:12:39.55,0:12:42.34,Default,,0,0,0,,Көрдім, рахмет, шошқа.
Dialogue: 0,0:12:42.47,0:12:44.97,Default,,0,0,0,,А... иә!
Dialogue: 0,0:12:45.09,0:12:47.97,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:48.10,0:12:51.22,Default,,0,0,0,,<Лилуи... Сен де авантюристсің! ＞
Dialogue: 0,0:12:51.35,0:12:54.14,Default,,0,0,0,,＜Тірі қалу үшін қолдан келгеннің бәрін жасаңыз! ＞
Dialogue: 0,0:12:54.27,0:12:56.48,Default,,0,0,0,,Реми мұнда әрдайым мен үшін терезені ашады, білесің бе.
Dialogue: 0,0:12:56.60,0:12:58.44,Default,,0,0,0,,Лилли араласты.
Dialogue: 0,0:12:58.56,0:13:01.44,Default,,0,0,0,,Әпкеңе қауіп төніп тұр, артта қал.
Dialogue: 0,0:13:01.57,0:13:03.61,Default,,0,0,0,,О, рахмет
Dialogue: 0,0:13:03.74,0:13:07.37,Default,,0,0,0,,Бірақ Лилли, мен ешқашан мұндай жерге келген емеспін.
Dialogue: 0,0:13:07.49,0:13:08.87,Default,,0,0,0,,Муфу
Dialogue: 0,0:13:08.99,0:13:11.04,Default,,0,0,0,,Ах! (Лилуидің үрейлі дауысы)
Dialogue: 0,0:13:11.91,0:13:14.62,Default,,0,0,0,,Кешіріңіз, бұл ештеңе болған жоқ.
Dialogue: 0,0:13:15.54,0:13:18.08,Default,,0,0,0,,А... Түсіндім...
Dialogue: 0,0:13:18.21,0:13:21.38,Default,,0,0,0,,Жарайды, Лилли сияқты, үйренбеген болсаң қорқынышты!
Dialogue: 0,0:13:21.50,0:13:23.30,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:13:24.51,0:13:26.47,Default,,0,0,0,,Буфуфу
Dialogue: 0,0:13:26.59,0:13:28.47,Default,,0,0,0,,<tto, жоқ, жоқ, жоқ! ＞
Dialogue: 0,0:13:28.59,0:13:31.31,Default,,0,0,0,,<Зынданда шатассаң, өлесің! ＞
Dialogue: 0,0:13:31.43,0:13:34.73,Default,,0,0,0,,Кешіріңіз, мен қате түсіндім.
Dialogue: 0,0:13:34.85,0:13:38.31,Default,,0,0,0,,де! Сіз қорқасыз, әпке!
Dialogue: 0,0:13:38.44,0:13:40.65,Default,,0,0,0,,Лилуй-чан қорқынышты емес пе?
Dialogue: 0,0:13:40.82,0:13:42.90,Default,,0,0,0,,Мүлде жоқ!
Dialogue: 0,0:13:43.03,0:13:46.95,Default,,0,0,0,,Ри Лилуи авантюрист, сондықтан ол мүлдем қорқынышты емес.
Dialogue: 0,0:13:47.07,0:13:49.12,Default,,0,0,0,,Иә, бұл күшті.
Dialogue: 0,0:13:49.24,0:13:52.41,Default,,0,0,0,,Қорқыныш денені де, ойды да мұздатады!
Dialogue: 0,0:13:52.54,0:13:53.87,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:13:54.00,0:13:57.96,Default,,0,0,0,,<Бұл Хаджименің ілімі ме? Сіз өте қамқоршысыз, солай емес пе?
Dialogue: 0,0:13:58.08,0:14:01.92,Default,,0,0,0,,Сондықтан авантюристер қорқынышқа шыдап, сабырлы шешім қабылдауы керек.
Dialogue: 0,0:14:03.21,0:14:04.67,Default,,0,0,0,,Бірлесіп әрекет етіп жатыр ма?
Dialogue: 0,0:14:10.05,0:14:11.18,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:14:12.06,0:14:12.89,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:15.35,0:14:17.73,Default,,0,0,0,,Га~!
Dialogue: 0,0:14:18.39,0:14:19.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:19.85,0:14:22.19,Default,,0,0,0,,Күшті - әдемі!
Dialogue: 0,0:14:22.27,0:14:25.28,Default,,0,0,0,,Үлкен апа, сіз кереметсіз!
Dialogue: 0,0:14:25.40,0:14:29.53,Default,,0,0,0,,Бұл Вероника-сан жай ғана әдемі әйел емес.
Dialogue: 0,0:14:29.70,0:14:31.45,Default,,0,0,0,,О!
Dialogue: 0,0:14:32.66,0:14:35.62,Default,,0,0,0,,Лилуй-чан, сен қатып қалған жоқсың ба?
Dialogue: 0,0:14:35.79,0:14:37.91,Default,,0,0,0,,Ол қатып қалған жоқ!
Dialogue: 0,0:14:38.08,0:14:39.96,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:14:40.08,0:14:42.54,Default,,0,0,0,,Му~ Бұл рас! Мен қорықпаймын!
Dialogue: 0,0:14:42.75,0:14:44.84,Default,,0,0,0,,Эй, Лилли-чан, сенің дауысың қатты...
Dialogue: 0,0:14:44.96,0:14:47.01,Default,,0,0,0,,Мұны тіпті Лилли жасай алады!
Dialogue: 0,0:14:47.13,0:14:48.84,Default,,0,0,0,,Сәлем! (Вероника) Лилли-чан!
Dialogue: 0,0:14:48.97,0:14:51.34,Default,,0,0,0,,<Ол кетті! Бұл тым әзіл болды! ＞
Dialogue: 0,0:14:51.51,0:14:54.14,Default,,0,0,0,,<Аа... Мен адам мен орынды таңдауым керек>
Dialogue: 0,0:14:54.31,0:14:56.27,Default,,0,0,0,,<Бұл менің жаман әдетім>
Dialogue: 0,0:14:56.81,0:14:57.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.39,0:14:59.98,Default,,0,0,0,,Құдай-ай!! Бұл да…
Dialogue: 0,0:15:00.10,0:15:01.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:02.06,0:15:03.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:03.94,0:15:07.61,Default,,0,0,0,,Лилуй-чан, сен шуылдасаң, тағы да құбыжықтар келеді.
Dialogue: 0,0:15:07.74,0:15:10.24,Default,,0,0,0,,Уф~ Өйткені бұл қорқынышты~
Dialogue: 0,0:15:12.16,0:15:14.49,Default,,0,0,0,,Лилли-чан авантюрист, солай ма?
Dialogue: 0,0:15:14.62,0:15:16.91,Default,,0,0,0,,Хмм... авантюрист...
Dialogue: 0,0:15:25.38,0:15:27.51,Default,,0,0,0,,Шығу жолы қандай?
Dialogue: 0,0:15:27.67,0:15:29.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:32.55,0:15:33.80,Default,,0,0,0,,Ол сол жақта!
Dialogue: 0,0:15:36.43,0:15:37.89,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:38.02,0:15:39.93,Default,,0,0,0,,Неліктен сол жақта?
Dialogue: 0,0:15:40.06,0:15:41.98,Default,,0,0,0,,Хмм... бұл...
Dialogue: 0,0:15:42.35,0:15:46.57,Default,,0,0,0,,Бұл Лилуидің авантюрист ретіндегі түйсігі!
Dialogue: 0,0:15:46.73,0:15:49.49,Default,,0,0,0,,Ри Рилуи-чанның...
Dialogue: 0,0:15:49.65,0:15:52.07,Default,,0,0,0,,Интуиция авантюрист ретінде...
Dialogue: 0,0:15:52.20,0:15:54.41,Default,,0,0,0,,Му? Сізде шағымданатын нәрсе бар ма?
Dialogue: 0,0:15:54.57,0:15:56.78,Default,,0,0,0,,Ах... ахахха...
Dialogue: 0,0:15:56.91,0:16:01.00,Default,,0,0,0,,Мен қарап тұрмын! Алда шығу болуы керек!
Dialogue: 0,0:16:10.17,0:16:11.59,Default,,0,0,0,,Қайта…
Dialogue: 0,0:16:11.76,0:16:15.51,Default,,0,0,0,,Лилуидің авантюристінің интуициясы Сенетін ештеңе жоқ!
Dialogue: 0,0:16:15.64,0:16:18.56,Default,,0,0,0,,Қазына сандығы да ашылды!
Dialogue: 0,0:16:20.77,0:16:21.93,Default,,0,0,0,,<Ух...>
Dialogue: 0,0:16:22.06,0:16:24.85,Default,,0,0,0,,<Қазір қайғыратын уақыт емес! ＞
Dialogue: 0,0:16:24.98,0:16:27.82,Default,,0,0,0,,<Себебі Лилли - авантюрист! ＞
Dialogue: 0,0:16:29.65,0:16:33.40,Default,,0,0,0,,Үлкен апа қазынаға тығылып жатыр...
Dialogue: 0,0:16:33.53,0:16:35.99,Default,,0,0,0,,Лилли не істейді?
Dialogue: 0,0:16:36.66,0:16:38.20,Default,,0,0,0,,Лилли...
Dialogue: 0,0:16:38.37,0:16:40.20,Default,,0,0,0,,Жауды тарту... Соқ!!
Dialogue: 0,0:16:40.33,0:16:42.16,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:42.29,0:16:44.42,Default,,0,0,0,,Екеуміз бірге тығылуымыз керек емес пе?
Dialogue: 0,0:16:44.54,0:16:46.38,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:16:46.50,0:16:48.63,Default,,0,0,0,,Жауларды тарту үшін не істейсің?
Dialogue: 0,0:16:48.75,0:16:52.97,Default,,0,0,0,,Авантюрист тек өзін құрбан ету дұрыс па?
Dialogue: 0,0:16:53.09,0:16:54.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:55.84,0:16:57.68,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:16:57.85,0:16:59.89,Default,,0,0,0,,Асығыңыз! Мен жасырамын!
Dialogue: 0,0:17:00.01,0:17:01.97,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:03.85,0:17:04.94,Default,,0,0,0,,Әй, қылыш!
Dialogue: 0,0:17:05.06,0:17:07.48,Default,,0,0,0,,Жарайды, тез кір!
Dialogue: 0,0:17:09.61,0:17:16.45,Default,,0,0,0,,(Құбыжық қадамдары)
Dialogue: 0,0:17:20.70,0:17:23.08,Default,,0,0,0,,Гау? Гау…
Dialogue: 0,0:17:23.41,0:17:27.08,Default,,0,0,0,,Ухуху, сен онша ақылды емес сияқтысың.
Dialogue: 0,0:17:28.21,0:17:31.13,Default,,0,0,0,,Өте жақсы көрінеді, Лилли-чан.
Dialogue: 0,0:17:36.55,0:17:40.47,Default,,0,0,0,,Неліктен Лилуй-чан авантюрист болғысы келеді?
Dialogue: 0,0:17:40.60,0:17:43.31,Default,,0,0,0,,Шынымды айтсам, бұл жарамайды деп ойлаймын.
Dialogue: 0,0:17:47.10,0:17:49.52,Default,,0,0,0,,Лилли әлі кішкентай
Dialogue: 0,0:17:49.65,0:17:52.65,Default,,0,0,0,,Мен не үшін жарамды екенімді білмеймін.
Dialogue: 0,0:17:53.07,0:17:54.65,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:54.78,0:17:57.74,Default,,0,0,0,,Бірақ Лилли Чан менімен бір нәсілден.
Dialogue: 0,0:17:57.86,0:18:02.37,Default,,0,0,0,,Мен сияқты жұмыс жасасаңыз, қауіпсіз түрде көбірек ақша табуға болады деп ойлаймын.
Dialogue: 0,0:18:02.49,0:18:04.91,Default,,0,0,0,,Сұлулық – талант
Dialogue: 0,0:18:05.96,0:18:08.17,Default,,0,0,0,,Дарындылық…
Dialogue: 0,0:18:08.33,0:18:12.13,Default,,0,0,0,,Жұмыс тиімділігі артады және онсыз тегіс болады!
Dialogue: 0,0:18:14.30,0:18:16.72,Default,,0,0,0,,<Қажыменің мазасын алған адам>
Dialogue: 0,0:18:16.84,0:18:21.43,Default,,0,0,0,,<Мүмкін, бұл Лиллидің авантюрист болуға қабілеті болмағандықтан шығар...>
Dialogue: 0,0:18:21.55,0:18:25.47,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:18:26.64,0:18:29.35,Default,,0,0,0,,Tsk! Циклоп баласы?
Dialogue: 0,0:18:30.15,0:18:31.61,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:18:31.73,0:18:32.98,Default,,0,0,0,,Қап…
Dialogue: 0,0:18:37.19,0:18:39.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:42.07,0:18:46.62,Default,,0,0,0,,Сіздің уақытыңыз емес!
Dialogue: 0,0:18:51.92,0:18:54.63,Default,,0,0,0,,Бірақ олар қайда...
Dialogue: 0,0:18:54.84,0:18:55.88,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:59.59,0:19:02.64,Default,,0,0,0,,Бұл Лилуйдің қылышы емес пе?
Dialogue: 0,0:19:03.05,0:19:05.14,Default,,0,0,0,,Төбелестің бе, ақымақ?
Dialogue: 0,0:19:07.60,0:19:10.02,Default,,0,0,0,,<Зынданда құбыжықпен кездесу...>
Dialogue: 0,0:19:10.77,0:19:13.40,Default,,0,0,0,,<Соғыс және өл>
Dialogue: 0,0:19:13.56,0:19:15.61,Default,,0,0,0,,<Әркім істейді...>
Dialogue: 0,0:19:15.73,0:19:19.74,Default,,0,0,0,,<Лилли де солай>
Dialogue: 0,0:19:20.49,0:19:21.95,Default,,0,0,0,,<Осылай болды...>
Dialogue: 0,0:19:23.78,0:19:28.04,Default,,0,0,0,,Бұл авантюристерде жиі болады.
Dialogue: 0,0:19:29.29,0:19:32.46,Default,,0,0,0,,Жиі...
Dialogue: 0,0:19:32.79,0:19:35.50,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:19:38.59,0:19:42.26,Default,,0,0,0,,Оны қазір түсініңіз! Бұл соншалықты көңілсіз!
Dialogue: 0,0:19:43.68,0:19:45.22,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:19:45.39,0:19:47.43,Default,,0,0,0,,Хажы…
Dialogue: 0,0:19:50.64,0:19:55.52,Default,,0,0,0,,Лилли мүлде жыламайды...
Dialogue: 0,0:19:55.65,0:19:58.73,Default,,0,0,0,,Өйткені Лилли - авантюрист!
Dialogue: 0,0:20:01.49,0:20:02.95,Default,,0,0,0,,Әй
Dialogue: 0,0:20:03.07,0:20:06.12,Default,,0,0,0,,Хажиме Мен кен жинаймын!
Dialogue: 0,0:20:06.24,0:20:08.95,Default,,0,0,0,,Әй, мен үзіліс жасамасам болады ма?
Dialogue: 0,0:20:09.12,0:20:10.91,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:11.08,0:20:13.33,Default,,0,0,0,,О, онда менімен бірге жүр!
Dialogue: 0,0:20:13.50,0:20:15.25,Default,,0,0,0,,О! Міне бітті!
Dialogue: 0,0:20:26.18,0:20:29.06,Default,,0,0,0,,Аа, қазір ойлап қарасам
Dialogue: 0,0:20:29.18,0:20:32.48,Default,,0,0,0,,...
Dialogue: 0,0:20:35.23,0:20:37.11,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:20:40.99,0:20:43.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:44.11,0:20:46.37,Default,,0,0,0,,Не? Оны жегің келмей ме?
Dialogue: 0,0:20:47.12,0:20:50.04,Default,,0,0,0,,Ал, Хаджиме...
Dialogue: 0,0:20:50.20,0:20:53.33,Default,,0,0,0,,Лиллиде авантюрист болу таланты жоқ.
Dialogue: 0,0:20:53.46,0:20:56.08,Default,,0,0,0,,Мүмкін бұл ыңғайсыздық шығар
Dialogue: 0,0:20:56.54,0:20:57.71,Default,,0,0,0,,Лилли...
Dialogue: 0,0:20:57.84,0:21:00.30,Default,,0,0,0,,Бұл өте тітіркендіргіш!
Dialogue: 0,0:21:03.67,0:21:07.89,Default,,0,0,0,,Сенің талантың – көңілді және ақымақ күлу.
Dialogue: 0,0:21:08.01,0:21:09.10,Default,,0,0,0,,Бұлп…
Dialogue: 0,0:21:09.22,0:21:10.68,Default,,0,0,0,,Хаджиме...
Dialogue: 0,0:21:10.81,0:21:12.81,Default,,0,0,0,,Тез тамақтанып алайық.
Dialogue: 0,0:21:15.48,0:21:19.36,Default,,0,0,0,,Ай... ай! Ақымақ болып көріну сұмдық!
Dialogue: 0,0:21:19.48,0:21:21.36,Default,,0,0,0,,Бұл ақылды емес.
Dialogue: 0,0:21:21.48,0:21:24.70,Default,,0,0,0,,Сізде тіпті авантюрист сияқты талант болуы мүмкін!
Dialogue: 0,0:21:24.82,0:21:26.95,Default,,0,0,0,,Бұл дұрыс емес. Күн суып барады, солай емес пе?
Dialogue: 0,0:21:27.07,0:21:29.62,Default,,0,0,0,,Иә! Itadadakimasu!
Dialogue: 0,0:21:29.74,0:21:31.74,Default,,0,0,0,,Сізді тастап кетті ме?
Dialogue: 0,0:21:31.91,0:21:33.20,Default,,0,0,0,,<Бірақ...>
Dialogue: 0,0:21:33.37,0:21:38.33,Default,,0,0,0,,<Саккубустың таланты - көңілді және ақымақ күлу...>
Dialogue: 0,0:21:39.67,0:21:42.84,Default,,0,0,0,,Хехехе, мен өттім ғой.
Dialogue: 0,0:21:43.01,0:21:45.55,Default,,0,0,0,,Иә? Сіз өттіңіз дегеніңіз не?
Dialogue: 0,0:21:45.76,0:21:50.10,Default,,0,0,0,,Егер мен өз нәсілімнен біреуге еліктеймін десем,
Dialogue: 0,0:21:50.97,0:21:55.14,Default,,0,0,0,,Мен шірітетін нәрселерге қарғыс айтуды ойладым.
Dialogue: 0,0:21:57.02,0:21:59.02,Default,,0,0,0,,Тоқта, Вероника!
Dialogue: 0,0:21:59.15,0:22:00.52,Default,,0,0,0,,Олай жасасаң, соғыс болады!
Dialogue: 0,0:22:00.65,0:22:02.07,Default,,0,0,0,,Неге соғысқа барамыз!? (Вероника күледі)
Dialogue: 0,0:22:02.23,0:22:03.90,Default,,0,0,0,,Лилли де күреседі!
Dialogue: 0,0:22:05.44,0:22:08.41,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.28,0:23:34.24,Default,,0,0,0,,～♪
