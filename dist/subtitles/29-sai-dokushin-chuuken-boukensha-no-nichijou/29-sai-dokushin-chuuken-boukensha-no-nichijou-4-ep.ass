Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:02.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:03.04,0:00:04.96,Default,,0,0,0,,Сіз деңгейге көтерілдіңіз!
Dialogue: 0,0:00:05.08,0:00:06.92,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:00:07.04,0:00:10.34,Default,,0,0,0,,Хэхе! Біз бірге күшті болдық!
Dialogue: 0,0:00:10.46,0:00:11.72,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:11.84,0:00:14.68,Default,,0,0,0,,Бұл жағдайда, егер екеуіңіз де жарнамалық сұрауды орындасаңыз.
Dialogue: 0,0:00:14.80,0:00:17.18,Default,,0,0,0,,Сіз қола дәрежелі авантюрист бола аласыз.
Dialogue: 0,0:00:17.30,0:00:19.18,Default,,0,0,0,,Мұны қалай жасауға болады?
Dialogue: 0,0:00:19.35,0:00:21.18,Default,,0,0,0,,Авантюрист дәрежесі.
Dialogue: 0,0:00:21.31,0:00:23.02,Default,,0,0,0,,Шинономе-сан, иә?
Dialogue: 0,0:00:23.14,0:00:26.36,Default,,0,0,0,,Науқанды сұрағыңыз келе ме?
Dialogue: 0,0:00:26.48,0:00:28.69,Default,,0,0,0,,Мына зынданды тазалаңыз!
Dialogue: 0,0:00:28.94,0:00:32.11,Default,,0,0,0,,Бұл жойылуға шешім қабылданған зындан.
Dialogue: 0,0:00:32.24,0:00:34.45,Default,,0,0,0,,Соңғы тергеу қажет
Dialogue: 0,0:00:34.61,0:00:39.58,Default,,0,0,0,,Науқанға өтінішті бірге толтырсақ, бәрі шешіледі!
Dialogue: 0,0:00:39.70,0:00:41.25,Default,,0,0,0,,Сіз соншалықты мұқиятсыз ...
Dialogue: 0,0:00:41.37,0:00:42.62,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:00:42.75,0:00:45.29,Default,,0,0,0,,«Зынданданы жоюшы» да ұйымдастырылды.
Dialogue: 0,0:00:45.42,0:00:47.71,Default,,0,0,0,,Барғың келсе, ертең
Dialogue: 0,0:00:47.83,0:00:49.13,Default,,0,0,0,,Зынданда өлімі?
Dialogue: 0,0:00:49.25,0:00:52.05,Default,,0,0,0,,Бұл қауіпті есімді жігіт...
Dialogue: 0,0:00:52.17,0:00:53.59,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:00:54.17,0:00:56.97,Default,,0,0,0,,<Бұлшық етті циклоп сияқты ма? ＞
Dialogue: 0,0:01:03.35,0:01:05.48,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:01:05.64,0:01:07.73,Default,,0,0,0,,Ававуа
Dialogue: 0,0:01:07.85,0:01:10.48,Default,,0,0,0,,Сіз сияқты ежелгі түр.
Dialogue: 0,0:01:10.61,0:01:13.99,Default,,0,0,0,,Қажетсіз зындандарды жойыңыз. Бұл гильдияны басқаратын жігіт.
Dialogue: 0,0:01:14.11,0:01:16.66,Default,,0,0,0,,О! Күшті!
Dialogue: 0,0:01:16.78,0:01:19.28,Default,,0,0,0,,Демек, Лилуй ежелгі түр болған!
Dialogue: 0,0:01:19.41,0:01:21.33,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:01:21.49,0:01:23.12,Default,,0,0,0,,Гуну! иә?
Dialogue: 0,0:01:23.83,0:01:25.87,Default,,0,0,0,,Тыныш болыңыз...
Dialogue: 0,0:01:26.37,0:01:29.63,Default,,0,0,0,,Лиллиде ұйықтайтын Айдаһар күші!
Dialogue: 0,0:01:29.75,0:01:32.17,Default,,0,0,0,,Жоқ... Бұл не, Лилли?
Dialogue: 0,0:01:32.30,0:01:34.38,Default,,0,0,0,,Өте керемет емес пе! Гах~ Гах~
Dialogue: 0,0:01:34.72,0:01:39.64,Default,,0,0,0,,<Лилуи... аздап күшейген авантюристерге әсер ететін ауру...>
Dialogue: 0,0:01:43.10,0:01:44.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:44.47,0:01:47.73,Default,,0,0,0,,Менің дұшпаным жауды кесіп өтеді...
Dialogue: 0,0:01:48.27,0:01:51.94,Default,,0,0,0,,<Гуну... Ұйықта! Менің өткенім! ＞
Dialogue: 0,0:01:52.07,0:01:55.90,Default,,0,0,0,,Не! Қарт адам да!? Мен де солай жасағым келеді!
Dialogue: 0,0:01:56.03,0:01:59.16,Default,,0,0,0,,Менің күшім бақылаудан шығып барады!
Dialogue: 0,0:01:59.32,0:02:01.95,Default,,0,0,0,,Аха…
Dialogue: 0,0:02:12.34,0:02:15.30,Default,,0,0,0,,♪～
Dialogue: 0,0:03:38.59,0:03:41.55,Default,,0,0,0,,～♪
Dialogue: 0,0:04:00.44,0:04:02.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:02.24,0:04:04.70,Default,,0,0,0,,Уау! Бұл не?
Dialogue: 0,0:04:04.82,0:04:06.95,Default,,0,0,0,,Бұл жалпақ типтегі зындан.
Dialogue: 0,0:04:07.08,0:04:09.20,Default,,0,0,0,,Бұл тыныштандырады!
Dialogue: 0,0:04:09.33,0:04:10.70,Default,,0,0,0,,Босаңсуға болмайды!
Dialogue: 0,0:04:43.32,0:04:47.20,Default,,0,0,0,,Оны жеңіп, қола дәрежелі авантюрист бол!
Dialogue: 0,0:04:47.32,0:04:49.24,Default,,0,0,0,,Кеттік! Қанекей мынаны істейік!
Dialogue: 0,0:04:49.37,0:04:51.24,Default,,0,0,0,,Хаа!!
Dialogue: 0,0:04:53.83,0:04:55.62,Default,,0,0,0,,Қарғыс атсын! Апыр-ай!
Dialogue: 0,0:04:55.75,0:04:56.88,Default,,0,0,0,,Аня-чан!
Dialogue: 0,0:04:57.63,0:04:59.09,Default,,0,0,0,,Һм! Ұф!
Dialogue: 0,0:04:59.21,0:05:00.92,Default,,0,0,0,,Қарғыс атсын... бұл...
Dialogue: 0,0:05:01.05,0:05:02.13,Default,,0,0,0,,Лилли!
Dialogue: 0,0:05:02.30,0:05:03.88,Default,,0,0,0,,Гунуну~!
Dialogue: 0,0:05:05.01,0:05:07.30,Default,,0,0,0,,Бұл жеткілікті!
Dialogue: 0,0:05:14.35,0:05:16.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:20.98,0:05:24.15,Default,,0,0,0,,Қазір! Мен сені өлтіремін! Оу!
Dialogue: 0,0:05:24.32,0:05:28.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:30.37,0:05:32.54,Default,,0,0,0,,Ми… Ми…
Dialogue: 0,0:05:33.12,0:05:34.12,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:38.29,0:05:39.54,Default,,0,0,0,,Ахаха
Dialogue: 0,0:05:39.67,0:05:42.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:44.88,0:05:47.72,Default,,0,0,0,,Бірінші зындан таза Өмет-сан
Dialogue: 0,0:05:48.51,0:05:50.22,Default,,0,0,0,,Эххе
Dialogue: 0,0:05:50.68,0:05:53.01,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:05:56.06,0:05:59.15,Default,,0,0,0,,Енді біз де қола дәрежесіндегі авантюристпіз.
Dialogue: 0,0:05:59.27,0:06:02.15,Default,,0,0,0,,Сіз айдаһарларды өлтіру сияқты нәрселерді жасай аласыз.
Dialogue: 0,0:06:02.27,0:06:04.86,Default,,0,0,0,,Ахаха! Бұл рас, солай емес пе?
Dialogue: 0,0:06:04.99,0:06:05.99,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:12.58,0:06:14.70,Default,,0,0,0,,Сіз келген сияқтысыз.
Dialogue: 0,0:06:14.83,0:06:16.37,Default,,0,0,0,,Ха... Хаджиме!?
Dialogue: 0,0:06:16.62,0:06:20.00,Default,,0,0,0,,Қош келдіңіз! Бұл дұрыс болды!
Dialogue: 0,0:06:20.13,0:06:21.88,Default,,0,0,0,,О? иә?
Dialogue: 0,0:06:22.63,0:06:24.88,Default,,0,0,0,,Сіз не істеп жатырсыз? Балалар сендер
Dialogue: 0,0:06:25.01,0:06:26.38,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:06:26.55,0:06:27.59,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:27.72,0:06:29.38,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:29.51,0:06:31.93,Default,,0,0,0,,Хехе... Менде бәрі жақсы.
Dialogue: 0,0:06:32.05,0:06:34.89,Default,,0,0,0,,Го-чан - ақылды және мейірімді жылан.
Dialogue: 0,0:06:40.10,0:06:42.94,Default,,0,0,0,,Бұл соншалықты үлкен және қорқынышты болса да ...
Dialogue: 0,0:06:43.06,0:06:46.69,Default,,0,0,0,,Сіз ерекшесіз бе? Dungeon Destroyer
Dialogue: 0,0:06:46.82,0:06:47.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:48.07,0:06:49.70,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:06:49.82,0:06:50.91,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:06:52.20,0:06:53.41,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:06:53.99,0:06:57.41,Default,,0,0,0,,Бұл Dungeon Destroyer фильміндегі Секихиме.
Dialogue: 0,0:06:57.54,0:06:58.91,Default,,0,0,0,,… өтіңіз.
Dialogue: 0,0:06:59.04,0:07:00.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:00.54,0:07:03.67,Default,,0,0,0,,Не?!
Dialogue: 0,0:07:04.25,0:07:06.63,Default,,0,0,0,,Уау! Ахаха!
Dialogue: 0,0:07:08.55,0:07:10.84,Default,,0,0,0,,Көп шулама, Лилли!
Dialogue: 0,0:07:10.97,0:07:14.18,Default,,0,0,0,,Әй, бұл не жылан...
Dialogue: 0,0:07:14.35,0:07:18.35,Default,,0,0,0,,Бұл жай жылан емес, көздің орнын басатын құрал.
Dialogue: 0,0:07:18.48,0:07:19.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.06,0:07:22.23,Default,,0,0,0,,Түсуім керек пе?
Dialogue: 0,0:07:22.35,0:07:24.31,Default,,0,0,0,,Жоқ, бәрібір.
Dialogue: 0,0:07:24.52,0:07:27.53,Default,,0,0,0,,О, рахмет!
Dialogue: 0,0:07:27.65,0:07:29.95,Default,,0,0,0,,Го-чан! Кеттік!
Dialogue: 0,0:07:30.07,0:07:32.07,Default,,0,0,0,,<Медузаның Секихимесі...>
Dialogue: 0,0:07:32.28,0:07:34.37,Default,,0,0,0,,<Сол көздерде көрінетін қатысу>
Dialogue: 0,0:07:34.49,0:07:38.62,Default,,0,0,0,,<үшінн тасқа айналдыра алатын ежелгі түр>
Dialogue: 0,0:07:42.08,0:07:43.54,Default,,0,0,0,,<Не! Сіз ұйықтадыңыз ба!?>
Dialogue: 0,0:07:43.67,0:07:45.84,Default,,0,0,0,,Уау Хаджиме Хажиме!
Dialogue: 0,0:07:45.96,0:07:48.59,Default,,0,0,0,,Аспанда үлкен нәрсе ұшып барады!
Dialogue: 0,0:07:49.34,0:07:51.59,Default,,0,0,0,,Әй, бұл қоныс аударатын кит.
Dialogue: 0,0:07:51.72,0:07:54.68,Default,,0,0,0,,Қаңғыбас кит? Бұл дәмді!?
Dialogue: 0,0:07:54.80,0:07:56.22,Default,,0,0,0,,Өте дәмді!
Dialogue: 0,0:07:56.35,0:07:59.89,Default,,0,0,0,,Мен де Лиллиді жегім келеді! Хаджиме әрқашан айлакер!
Dialogue: 0,0:08:00.02,0:08:02.23,Default,,0,0,0,,А, келесі жолы мен сені тамақтандырамын.
Dialogue: 0,0:08:02.35,0:08:04.10,Default,,0,0,0,,<Көшіп жүрген кит>
Dialogue: 0,0:08:04.60,0:08:09.11,Default,,0,0,0,,<Дәмі аздап тәуелді екені рас, бірақ дәмді болды.>
Dialogue: 0,0:08:09.61,0:08:13.61,Default,,0,0,0,,<Оның пішіні мен түсі қандай?>
Dialogue: 0,0:08:14.41,0:08:17.12,Default,,0,0,0,,<Білмеймін, бірақ...>
Dialogue: 0,0:08:23.75,0:08:26.17,Default,,0,0,0,,Бұл бағыт дұрыс па?
Dialogue: 0,0:08:26.29,0:08:30.42,Default,,0,0,0,,Аа, мен сіздің артыңызда тұрмын, маған қарай бұрылмаңызшы.
Dialogue: 0,0:08:30.55,0:08:31.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:31.55,0:08:32.42,Default,,0,0,0,,Иә
Dialogue: 0,0:08:50.90,0:08:52.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:56.78,0:08:58.91,Default,,0,0,0,,<Мен білдім, бірақ...>
Dialogue: 0,0:08:59.24,0:09:02.41,Default,,0,0,0,,<Күшті деңгей емес...>
Dialogue: 0,0:09:05.96,0:09:08.63,Default,,0,0,0,,Құдай-ай!! Бұл да…
Dialogue: 0,0:09:08.75,0:09:11.21,Default,,0,0,0,,Tto! Зынданда құлап қалады!
Dialogue: 0,0:09:11.34,0:09:12.59,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:09:28.10,0:09:30.32,Default,,0,0,0,,Мен жай ғана аспанға қарап тұрмын
Dialogue: 0,0:09:30.44,0:09:33.07,Default,,0,0,0,,Жарайды, тек аспан ғана көрінеді.
Dialogue: 0,0:09:33.32,0:09:36.40,Default,,0,0,0,,Әпкең жалғыз қалған сияқты.
Dialogue: 0,0:09:36.53,0:09:37.99,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:09:38.78,0:09:41.99,Default,,0,0,0,,<Ежелгі түрдің күші... һә>
Dialogue: 0,0:09:42.12,0:09:45.96,Default,,0,0,0,,<Баяғыда өсек-аяңнан естіген Медуза оқиғасы...>
Dialogue: 0,0:09:46.08,0:09:48.00,Default,,0,0,0,,<Гильдияда бар ежелгі түрлер>
Dialogue: 0,0:09:48.12,0:09:51.09,Default,,0,0,0,,<Зындандаларды жоюшы ретінде әртүрлі>
Dialogue: 0,0:09:51.25,0:09:52.75,Default,,0,0,0,,<Мен естідім>
Dialogue: 0,0:09:52.92,0:09:55.67,Default,,0,0,0,,<"Ол күн көремін деп уайымдамауы керек. Ол жақсы жігіт.">
Dialogue: 0,0:09:55.80,0:09:58.59,Default,,0,0,0,,<Осылай ойладым...>
Dialogue: 0,0:09:58.76,0:10:00.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:02.81,0:10:06.10,Default,,0,0,0,,Уф... онда ұйықтайтын кез келді.
Dialogue: 0,0:10:06.23,0:10:08.65,Default,,0,0,0,,Түсінікті...
Dialogue: 0,0:10:10.98,0:10:15.11,Default,,0,0,0,,Хаджиме... Хаджиме... Хаджиме!
Dialogue: 0,0:10:15.24,0:10:19.53,Default,,0,0,0,,Ах! Лилли!? Не болды...
Dialogue: 0,0:10:19.66,0:10:21.62,Default,,0,0,0,,Уау! Бұл азайып бара жатыр!
Dialogue: 0,0:10:21.74,0:10:23.95,Default,,0,0,0,,Әй, бұл Хаджиме еді ғой!
Dialogue: 0,0:10:24.16,0:10:25.70,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:10:25.83,0:10:27.21,Default,,0,0,0,,Аха-ха-ха-ха-ха!
Dialogue: 0,0:10:27.37,0:10:28.96,Default,,0,0,0,,Ха~!!
Dialogue: 0,0:10:29.29,0:10:31.75,Default,,0,0,0,,Көзіңді ашсаң да тасқа айналма!
Dialogue: 0,0:10:32.21,0:10:33.50,Default,,0,0,0,,Шөпті бұлғайды!
Dialogue: 0,0:10:33.71,0:10:35.30,Default,,0,0,0,,Сүйкімді құс емес!
Dialogue: 0,0:10:35.84,0:10:37.51,Default,,0,0,0,,Әлем…
Dialogue: 0,0:10:37.63,0:10:43.01,Default,,0,0,0,,Бұл өте жұмсақ! Дегенмен бұл өте түрлі-түсті!
Dialogue: 0,0:10:44.01,0:10:47.52,Default,,0,0,0,,Біртүрлі нәрсе болып жатқаны рас.
Dialogue: 0,0:10:47.64,0:10:49.02,Default,,0,0,0,,Иә
Dialogue: 0,0:10:49.14,0:10:53.77,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:10:54.98,0:10:58.24,Default,,0,0,0,,Бұл өте қызық! Бұл өте қызық!
Dialogue: 0,0:10:58.36,0:11:00.32,Default,,0,0,0,,Оған үйреніп қалған...
Dialogue: 0,0:11:00.78,0:11:04.37,Default,,0,0,0,,<Мм... Медузаның көзі ашық>
Dialogue: 0,0:11:04.49,0:11:07.29,Default,,0,0,0,,<Қалай ойласаңыз да, бұл шынайы дүние емес...>
Dialogue: 0,0:11:07.41,0:11:08.66,Default,,0,0,0,,Ах! иә?
Dialogue: 0,0:11:08.83,0:11:12.17,Default,,0,0,0,,Не? не? Шлам деген осы ма?
Dialogue: 0,0:11:12.29,0:11:15.67,Default,,0,0,0,,Менің естігенім дірілдеп тұрғаны осы ма?
Dialogue: 0,0:11:18.01,0:11:19.47,Default,,0,0,0,,Иә! Тартыңыз, әпке! Шлам - бұл
Dialogue: 0,0:11:19.59,0:11:21.43,Default,,0,0,0,,Пурупуру! Үндемесең...
Dialogue: 0,0:11:21.55,0:11:22.68,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:11:26.26,0:11:28.31,Default,,0,0,0,,Пуха!
Dialogue: 0,0:11:28.43,0:11:31.14,Default,,0,0,0,,Уф~ мен күтемін!
Dialogue: 0,0:11:31.27,0:11:33.73,Default,,0,0,0,,Рахмет, мен баланың кім екенін білмеймін.
Dialogue: 0,0:11:33.86,0:11:35.32,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:11:35.44,0:11:37.32,Default,,0,0,0,,Әлем бұл...
Dialogue: 0,0:11:37.44,0:11:39.86,Default,,0,0,0,,Бұл өте қызық болды!
Dialogue: 0,0:11:40.19,0:11:42.86,Default,,0,0,0,,Мен мұны осы уақытқа дейін білмедім.
Dialogue: 0,0:11:42.99,0:11:46.20,Default,,0,0,0,,Сәлем! Келесі сол жерде.
Dialogue: 0,0:11:46.33,0:11:48.83,Default,,0,0,0,,Иә! Хехехе
Dialogue: 0,0:11:48.95,0:11:50.33,Default,,0,0,0,,Әй
Dialogue: 0,0:12:09.43,0:12:10.43,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:10.56,0:12:12.44,Default,,0,0,0,,Бұл үлкен шалшық!
Dialogue: 0,0:12:12.60,0:12:13.48,Default,,0,0,0,,Теңіз, солай ма?
Dialogue: 0,0:12:13.60,0:12:15.40,Default,,0,0,0,,Теңіз? Солай ма?
Dialogue: 0,0:12:15.90,0:12:18.27,Default,,0,0,0,,Әйтеуір, мынау... Мен естідім өсек!
Dialogue: 0,0:12:18.40,0:12:22.74,Default,,0,0,0,,Үлкен әпке! Лилли осында үлкен тасбақаны кездестірді!
Dialogue: 0,0:12:22.86,0:12:23.74,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:12:23.82,0:12:25.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:26.12,0:12:27.41,Default,,0,0,0,,Уф, суық қой!
Dialogue: 0,0:12:29.49,0:12:31.58,Default,,0,0,0,,(Көшіп жүрген кит дыбыстары)
Dialogue: 0,0:12:31.70,0:12:32.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:32.87,0:12:33.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:34.00,0:12:35.88,Default,,0,0,0,,Міне, түсте көрген кит!
Dialogue: 0,0:12:36.00,0:12:37.13,Default,,0,0,0,,А, аа!
Dialogue: 0,0:12:37.63,0:12:38.80,Default,,0,0,0,,Иә!?
Dialogue: 0,0:12:43.05,0:12:44.09,Default,,0,0,0,,«Ка…»
Dialogue: 0,0:12:44.59,0:12:47.14,Default,,0,0,0,,Сезімге батып кеттім!
Dialogue: 0,0:12:47.26,0:12:51.43,Default,,0,0,0,,Бұл өте керемет! Мен таң қалдым!
Dialogue: 0,0:12:51.56,0:12:53.23,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:12:55.40,0:13:00.19,Default,,0,0,0,,<Лилли бұл жерді білетініне сенімдімін...>
Dialogue: 0,0:13:00.32,0:13:03.28,Default,,0,0,0,,<Бұл менің арманым емес пе...>
Dialogue: 0,0:13:03.40,0:13:04.15,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:13:05.57,0:13:09.24,Default,,0,0,0,,Ах... Лилли! Қолыңыздағы өрнек...
Dialogue: 0,0:13:09.37,0:13:13.12,Default,,0,0,0,,О? а! Суретте біртүрлі нәрсе бар!
Dialogue: 0,0:13:13.25,0:13:16.79,Default,,0,0,0,,Бұл ерекше дағдыны меңгерген кезде пайда болатын үлгі!
Dialogue: 0,0:13:16.92,0:13:21.50,Default,,0,0,0,,<Вероника да оң жақ кеудесінде бар, солай ма? Жүрек пішініндегі >
Dialogue: 0,0:13:22.21,0:13:23.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:24.17,0:13:29.05,Default,,0,0,0,,<Арман... Шебер... Ежелгі түр...>
Dialogue: 0,0:13:29.47,0:13:30.85,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:13:30.97,0:13:32.35,Default,,0,0,0,,Армандағы жын!?
Dialogue: 0,0:13:32.47,0:13:33.39,Default,,0,0,0,,Мама?
Dialogue: 0,0:13:33.52,0:13:35.60,Default,,0,0,0,,Бұл суккубустың басқа атауы!
Dialogue: 0,0:13:35.73,0:13:36.85,Default,,0,0,0,,Олив-чаннан
Dialogue: 0,0:13:36.98,0:13:40.65,Default,,0,0,0,,Арман әлемін құра білген суккубустың да болғанын естідім!
Dialogue: 0,0:13:42.11,0:13:44.15,Default,,0,0,0,,Олай болса
Dialogue: 0,0:13:44.28,0:13:48.36,Default,,0,0,0,,Бұл тамаша түсті саған Лилли көрсетті, солай ма?
Dialogue: 0,0:13:51.20,0:13:52.87,Default,,0,0,0,,Керемет шытырман оқиғаны армандау
Dialogue: 0,0:13:53.83,0:13:56.50,Default,,0,0,0,,Лилли-чанға рахмет
Dialogue: 0,0:13:56.71,0:14:01.00,Default,,0,0,0,,<Лилуидің ежелгі түр ретіндегі күші...>
Dialogue: 0,0:14:01.13,0:14:05.55,Default,,0,0,0,,О! Жарайсыз, әпке!
Dialogue: 0,0:14:06.05,0:14:08.26,Default,,0,0,0,,О? Қайтып кетті ме?
Dialogue: 0,0:14:08.38,0:14:10.26,Default,,0,0,0,,Аха!!
Dialogue: 0,0:14:10.39,0:14:12.56,Default,,0,0,0,,Мен супер типпін.
Dialogue: 0,0:14:12.68,0:14:14.27,Default,,0,0,0,,ше? мм...
Dialogue: 0,0:14:14.52,0:14:16.64,Default,,0,0,0,,Маған қосылыңыз!
Dialogue: 0,0:14:18.14,0:14:19.90,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:14:26.53,0:14:29.78,Default,,0,0,0,,<Бұл дүниеде махаббат деген бар сияқты>
Dialogue: 0,0:14:29.91,0:14:30.66,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:14:31.91,0:14:32.87,Default,,0,0,0,,Хажиме-сан
Dialogue: 0,0:14:32.99,0:14:33.91,Default,,0,0,0,,Ах
Dialogue: 0,0:14:34.20,0:14:36.70,Default,,0,0,0,,Қашан қайтасыз?
Dialogue: 0,0:14:36.83,0:14:37.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:37.83,0:14:38.66,Default,,0,0,0,,Сен оны білесің бе, Аводөл? (Аводөл) Ах… өте
Dialogue: 0,0:14:41.13,0:14:43.42,Default,,0,0,0,,Ах... кешке қарай...?
Dialogue: 0,0:14:43.63,0:14:45.80,Default,,0,0,0,,Мен сені күтемін.
Dialogue: 0,0:14:47.22,0:14:51.43,Default,,0,0,0,,А, онда...
Dialogue: 0,0:14:57.48,0:14:59.19,Default,,0,0,0,,(шламды кесу дыбысы)
Dialogue: 0,0:15:01.85,0:15:03.52,Default,,0,0,0,,<Ол осында...>
Dialogue: 0,0:15:03.65,0:15:05.82,Default,,0,0,0,,<Бұрын танымал болғаныммен>
Dialogue: 0,0:15:05.98,0:15:07.74,Default,,0,0,0,,<Оны қалай айта аламын...>
Dialogue: 0,0:15:07.86,0:15:10.61,Default,,0,0,0,,<Мен бұл іс басқаша сияқты...>
Dialogue: 0,0:15:10.74,0:15:13.41,Default,,0,0,0,,<Бізге қосылыңыз! ＞
Dialogue: 0,0:15:13.53,0:15:15.45,Default,,0,0,0,,Сәлем Хаджиме!
Dialogue: 0,0:15:15.79,0:15:18.08,Default,,0,0,0,,Көрініс
Dialogue: 0,0:15:18.20,0:15:19.21,Default,,0,0,0,,Бірдеңе...
Dialogue: 0,0:15:19.41,0:15:22.71,Default,,0,0,0,,<Бүгін тіпті Лилли де қорқады...>
Dialogue: 0,0:15:22.83,0:15:25.25,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:15:25.38,0:15:29.47,Default,,0,0,0,,Егер сізде сұрақтар болса, менімен сөйлесіңіз, солай емес пе?
Dialogue: 0,0:15:29.59,0:15:30.51,Default,,0,0,0,,О...
Dialogue: 0,0:15:30.63,0:15:31.97,Default,,0,0,0,,Хажиме!
Dialogue: 0,0:15:32.09,0:15:32.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:33.05,0:15:35.85,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз? Әпкең туралы!
Dialogue: 0,0:15:35.97,0:15:37.22,Default,,0,0,0,,Әпке?
Dialogue: 0,0:15:39.39,0:15:40.77,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:15:40.89,0:15:45.57,Default,,0,0,0,,Мысалы, сіз есейіп, маған ғашық болдыңыз делік, солай ма?
Dialogue: 0,0:15:45.69,0:15:46.48,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:15:46.61,0:15:49.65,Default,,0,0,0,,Ұнату дегенді білдіреді
Dialogue: 0,0:15:49.78,0:15:52.49,Default,,0,0,0,,Бұл бөксеге тегін қол тигізу дұрыс дегенді білдіре ме?
Dialogue: 0,0:15:57.37,0:16:01.00,Default,,0,0,0,,<Мені жәндіктің көзімен көрдім>
Dialogue: 0,0:16:01.46,0:16:04.38,Default,,0,0,0,,Бұл көп шлам.
Dialogue: 0,0:16:04.63,0:16:06.00,Default,,0,0,0,,Аа, енді ойлап қарасам
Dialogue: 0,0:16:06.17,0:16:10.17,Default,,0,0,0,,Секихиме-сан әлі қонақ үйде тұрған сияқты ма?
Dialogue: 0,0:16:10.30,0:16:14.14,Default,,0,0,0,,А... маған бірдеңе мойындады (Зәйтүн) Иә!?
Dialogue: 0,0:16:14.72,0:16:16.89,Default,,0,0,0,,Мойындау!?
Dialogue: 0,0:16:19.14,0:16:20.68,Default,,0,0,0,,Таудан түскеннен кейін, қолым түсіп кететіндей болғанша қылыш шабуды жаттықтырамын
Dialogue: 0,0:16:20.81,0:16:25.10,Default,,0,0,0,,Міне... сондықтан мен бүгін күні бойы уайымдадым...
Dialogue: 0,0:16:27.02,0:16:28.77,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:29.15,0:16:33.53,Default,,0,0,0,,Хехе, Шинономе мырза әдемі жігіт.
Dialogue: 0,0:16:33.65,0:16:38.37,Default,,0,0,0,,Қандай жағдай болмасын, оны ашуландырып, тасқа айналдырудан сақ болыңыз.
Dialogue: 0,0:16:38.49,0:16:42.33,Default,,0,0,0,,<Бұл қиын... Махаббат>
Dialogue: 0,0:16:43.58,0:16:44.75,Default,,0,0,0,,Хажиме-сан
Dialogue: 0,0:16:46.50,0:16:48.92,Default,,0,0,0,,Бүгінгі еңбектеріңізге рахмет.
Dialogue: 0,0:16:49.38,0:16:51.42,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:16:51.55,0:16:53.09,Default,,0,0,0,,Mu…
Dialogue: 0,0:16:57.43,0:17:00.22,Default,,0,0,0,,Даа! Кешіріңіз! Шыныаяқ орнында болды!
Dialogue: 0,0:17:00.35,0:17:01.43,Default,,0,0,0,,О...
Dialogue: 0,0:17:01.72,0:17:03.68,Default,,0,0,0,,Мен ақынның өлеңін естідім.
Dialogue: 0,0:17:03.85,0:17:06.69,Default,,0,0,0,,Мен алкогольді ішіп көргім келді...
Dialogue: 0,0:17:08.06,0:17:09.48,Default,,0,0,0,,Бұл көңілді ме?
Dialogue: 0,0:17:09.61,0:17:13.11,Default,,0,0,0,,Иә! Негізі дауысы маған қатты ұнады!
Dialogue: 0,0:17:13.69,0:17:15.82,Default,,0,0,0,,Бүгін мен Наталимен сөйлестім.
Dialogue: 0,0:17:15.95,0:17:19.87,Default,,0,0,0,,Маған Хаджиме-санның әдеттегі мінез-құлқын естуді сұрады, хехе.
Dialogue: 0,0:17:20.95,0:17:24.62,Default,,0,0,0,,Бұл менің алғашқы махаббатым, сондықтан мен толқудамын деп ойлаймын.
Dialogue: 0,0:17:26.79,0:17:31.09,Default,,0,0,0,,Иә, иә, кешіріңіз, бірақ мен мұны қарызға аламын деп ойлаймын.
Dialogue: 0,0:17:31.21,0:17:33.38,Default,,0,0,0,,Бұл не, Вероника?
Dialogue: 0,0:17:33.51,0:17:35.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:36.13,0:17:39.43,Default,,0,0,0,,Мен сенің мені мойындағаныңды естідім бе?
Dialogue: 0,0:17:39.55,0:17:41.10,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:17:41.31,0:17:43.39,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:17:43.52,0:17:46.23,Default,,0,0,0,,Не істейтініңді айтсаң да...
Dialogue: 0,0:17:46.35,0:17:47.35,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:47.48,0:17:50.94,Default,,0,0,0,,Неліктен мұндай әрекетке барар едің...
Dialogue: 0,0:17:51.07,0:17:53.36,Default,,0,0,0,,Сен екеуміз бала кезден доспыз
Dialogue: 0,0:17:53.48,0:17:56.24,Default,,0,0,0,,Танысқанымызға көп уақыт болды.
Dialogue: 0,0:17:56.61,0:17:58.86,Default,,0,0,0,,Өйткені мен әдемі суккубуспын
Dialogue: 0,0:17:58.99,0:18:02.24,Default,,0,0,0,,Маған көп ер адамдар ғашық болды.
Dialogue: 0,0:18:03.58,0:18:07.50,Default,,0,0,0,,Бірақ... жалғыз сен маған ғашық емессің!
Dialogue: 0,0:18:08.12,0:18:09.96,Default,,0,0,0,,Вероника...
Dialogue: 0,0:18:10.25,0:18:14.71,Default,,0,0,0,,Ғашық бол! Бірінші мен! Осыдан кейін мен сені бірден сиқырлаймын!
Dialogue: 0,0:18:14.84,0:18:15.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:15.67,0:18:19.84,Default,,0,0,0,,Менің мақтанышым ренжіді! Мен ұрысқаннан кейін менімен бірге шығуға болады!
Dialogue: 0,0:18:19.97,0:18:21.47,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:21.60,0:18:23.14,Default,,0,0,0,,Хаджиме!
Dialogue: 0,0:18:24.02,0:18:26.14,Default,,0,0,0,,Лилли…
Dialogue: 0,0:18:26.93,0:18:28.35,Default,,0,0,0,,Хажиме...
Dialogue: 0,0:18:30.06,0:18:33.82,Default,,0,0,0,,Лилли авантюрист болады!
Dialogue: 0,0:18:33.94,0:18:38.20,Default,,0,0,0,,Мен әлі баламын, бірақ мен күштірек және әдемі боламын.
Dialogue: 0,0:18:38.32,0:18:40.66,Default,,0,0,0,,Тіпті кеудеңіз де үлкейеді!
Dialogue: 0,0:18:40.78,0:18:44.79,Default,,0,0,0,,Демек, Хажиме...
Dialogue: 0,0:18:52.21,0:18:54.05,Default,,0,0,0,,Лилли-чан...
Dialogue: 0,0:18:56.76,0:18:57.97,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:18:58.13,0:18:59.22,Default,,0,0,0,,Гааах!
Dialogue: 0,0:19:02.01,0:19:04.89,Default,,0,0,0,,Әлі емес...
Dialogue: 0,0:19:05.01,0:19:10.44,Default,,0,0,0,,Мен осы кішкентай баламен күндерімді шытырман оқиғалармен өткізгім келеді...
Dialogue: 0,0:19:13.94,0:19:16.78,Default,,0,0,0,,(аяқ дыбысына жақындау)
Dialogue: 0,0:19:16.98,0:19:18.90,Default,,0,0,0,,Бір сәт, Секихиме.
Dialogue: 0,0:19:19.03,0:19:19.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:21.70,0:19:23.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:35.96,0:19:39.84,Default,,0,0,0,,Қомай ауылы... Мен түнгі дыбыстарды естимін.
Dialogue: 0,0:19:39.97,0:19:41.38,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:41.51,0:19:44.85,Default,,0,0,0,,Өлеңдегі кездесу сияқты.
Dialogue: 0,0:19:44.97,0:19:47.85,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:48.22,0:19:50.77,Default,,0,0,0,,Бұл күн емес.
Dialogue: 0,0:19:58.11,0:20:00.36,Default,,0,0,0,,Мазасыздық тудырды ма?
Dialogue: 0,0:20:00.49,0:20:04.37,Default,,0,0,0,,Жоқ, бұл жайсыздық емес...
Dialogue: 0,0:20:04.78,0:20:07.91,Default,,0,0,0,,Бірақ менің танысуға ниетім жоқ.
Dialogue: 0,0:20:08.04,0:20:10.62,Default,,0,0,0,,Мен мұны шынымен түсінбеймін.
Dialogue: 0,0:20:12.62,0:20:15.38,Default,,0,0,0,,Сонымен... Кешіріңіз.
Dialogue: 0,0:20:15.50,0:20:18.55,Default,,0,0,0,,(Үкі айқайлайды)
Dialogue: 0,0:20:25.76,0:20:26.97,Default,,0,0,0,,(Секихиманың айқайы)
Dialogue: 0,0:20:27.10,0:20:28.14,Default,,0,0,0,,Иә!?
Dialogue: 0,0:20:28.51,0:20:31.31,Default,,0,0,0,,Бұл мен ойлағаннан да қиын!
Dialogue: 0,0:20:31.43,0:20:32.31,Default,,0,0,0,,Аа, мм...
Dialogue: 0,0:20:32.39,0:20:36.06,Default,,0,0,0,,Қатты! Бұл өте өкінішті болса да!
Dialogue: 0,0:20:36.23,0:20:39.11,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:20:39.28,0:20:40.69,Default,,0,0,0,,Тамақ ішсең, өзіңді жақсы сезінесің...
Dialogue: 0,0:20:40.94,0:20:42.86,Default,,0,0,0,,Менің тамағымнан өте ме?!
Dialogue: 0,0:20:43.11,0:20:45.28,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:20:45.45,0:20:47.16,Default,,0,0,0,,Бұл трагедия! (жердің шуылдауы)
Dialogue: 0,0:20:47.28,0:20:48.53,Default,,0,0,0,,Не!
Dialogue: 0,0:20:48.62,0:20:51.33,Default,,0,0,0,,(Секихиманың айқайы)
Dialogue: 0,0:20:51.45,0:20:52.79,Default,,0,0,0,,Сабыр ет, Секихиме!
Dialogue: 0,0:20:52.91,0:20:54.79,Default,,0,0,0,,Менің қабілеттерім бақылаудан шығып барады!
Dialogue: 0,0:20:55.00,0:20:56.67,Default,,0,0,0,,Өте көп!
Dialogue: 0,0:20:56.79,0:20:59.92,Default,,0,0,0,,Мен қазірдің өзінде қайғылымын!
Dialogue: 0,0:21:01.55,0:21:04.05,Default,,0,0,0,,< Қарғыс атсын! Осылай қала берсе жаман! ＞
Dialogue: 0,0:21:05.93,0:21:08.10,Default,,0,0,0,,Түсіндім! Бірге отырайық!
Dialogue: 0,0:21:08.26,0:21:09.47,Default,,0,0,0,,Иә!?
Dialogue: 0,0:21:14.98,0:21:17.19,Default,,0,0,0,,Танысу дегенді білдіреді ғой!?
Dialogue: 0,0:21:17.31,0:21:20.27,Default,,0,0,0,,Менің кеудеме немесе бөкселерімді тегін түртіңіз.
Dialogue: 0,0:21:20.44,0:21:23.82,Default,,0,0,0,,Ересектердің шытырман оқиғалары үшін ақы төлеудің қажеті жоқ!
Dialogue: 0,0:21:26.28,0:21:27.82,Default,,0,0,0,,P…
Dialogue: 0,0:21:28.03,0:21:32.33,Default,,0,0,0,,А, у... иә...
Dialogue: 0,0:21:34.41,0:21:36.58,Default,,0,0,0,,Бұл үшін кешіріңіз
Dialogue: 0,0:21:36.71,0:21:38.88,Default,,0,0,0,,Тыныш!!
Dialogue: 0,0:21:39.50,0:21:41.55,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:21:41.75,0:21:44.76,Default,,0,0,0,,Күткендей, тым нәзік...
Dialogue: 0,0:21:44.88,0:21:47.30,Default,,0,0,0,,Сіз кереметсіз! Хаджиме!
Dialogue: 0,0:21:47.43,0:21:51.06,Default,,0,0,0,,Ах ха ха ха ха! Хахахаха
Dialogue: 0,0:21:52.31,0:21:54.31,Default,,0,0,0,,Уайымдама, Хаджиме.
Dialogue: 0,0:21:54.48,0:21:58.90,Default,,0,0,0,,Лилли Хаджимеге өмірінің соңына дейін қамқорлық жасайды.
Dialogue: 0,0:22:00.31,0:22:02.27,Default,,0,0,0,,Бұл өте қиын...
Dialogue: 0,0:22:03.82,0:22:04.90,Default,,0,0,0,,Махаббат
Dialogue: 0,0:22:05.44,0:22:08.49,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.24,0:23:34.20,Default,,0,0,0,,～♪
