Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.79,0:00:07.59,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:00:08.17,0:00:09.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:00:10.59,0:00:12.55,Default,,0,0,0,,Хмм? Сенадан
Dialogue: 0,0:00:12.67,0:00:14.18,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:14.84,0:00:16.51,Default,,0,0,0,,«Кобато-чанның туған күні фестивалі»
Dialogue: 0,0:00:17.01,0:00:19.01,Default,,0,0,0,,«Кобато-чанның туған күніне сыйлық сатып алу үшін-»
Dialogue: 0,0:00:19.14,0:00:20.72,Default,,0,0,0,,«Жексенбі, мен сенімен мәңгі бірге боламын».
Dialogue: 0,0:00:20.85,0:00:22.39,Default,,0,0,0,,Ура! иә?
Dialogue: 0,0:00:22.52,0:00:23.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:23.52,0:00:26.31,Default,,0,0,0,,Жексенбі... Жарайды, менде ешқандай жоспар жоқ.
Dialogue: 0,0:00:27.15,0:00:29.65,Default,,0,0,0,,«Жарайды жексенбі 13:00»
Dialogue: 0,0:00:29.77,0:00:32.74,Default,,0,0,0,,«Toya Station платформасының күту залында»
Dialogue: 0,0:00:32.86,0:00:34.70,Default,,0,0,0,,О
Dialogue: 0,0:00:36.16,0:00:37.53,Default,,0,0,0,,〝Аан〞
Dialogue: 0,0:00:37.82,0:00:41.16,Default,,0,0,0,,«Мен үнсіз көтерілген телефон бағанасында эрозды сезінемін».
Dialogue: 0,0:00:41.29,0:00:43.87,Default,,0,0,0,,«Әзірше мен байланып қалғым келеді, мен айналамдағы жорғалап алғым келеді».
Dialogue: 0,0:00:44.00,0:00:45.04,Default,,0,0,0,,«Бірақ егер сіз бұл туралы ойласаңыз ...»
Dialogue: 0,0:00:45.17,0:00:47.71,Default,,0,0,0,,«Арт жақтан шабуыл жасау жақсы болуы мүмкін».
Dialogue: 0,0:00:48.46,0:00:51.63,Default,,0,0,0,,Хаа… «Тыныш»
Dialogue: 0,0:00:51.76,0:00:53.38,Default,,0,0,0,,«Бұл тік оқу».
Dialogue: 0,0:00:53.51,0:00:54.67,Default,,0,0,0,,Тік оқу?
Dialogue: 0,0:00:55.43,0:01:00.51,Default,,0,0,0,,«Ертең кездесуге барайық»
Dialogue: 0,0:01:01.43,0:01:02.47,Default,,0,0,0,,«Маған ұнамайды»
Dialogue: 0,0:01:02.60,0:01:03.81,Default,,0,0,0,,«Өтінемін»
Dialogue: 0,0:01:03.93,0:01:06.81,Default,,0,0,0,,«Мен Кобато-санға сыйлық таңдауға көмектесуіңді қалаймын».
Dialogue: 0,0:01:06.94,0:01:09.11,Default,,0,0,0,,Олай болса, адал жаз.
Dialogue: 0,0:01:09.23,0:01:10.40,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:01:10.90,0:01:14.07,Default,,0,0,0,,«Котака Хасегава мырзаға хат»
Dialogue: 0,0:01:14.40,0:01:16.70,Default,,0,0,0,,〝Құрметті Котака Хасегава мырза〞
Dialogue: 0,0:01:17.41,0:01:19.95,Default,,0,0,0,,``Құрметті аға, сіз күздің сергітетін маусымында келдіңіз.''
Dialogue: 0,0:01:20.33,0:01:24.08,Default,,0,0,0,,〝Денсаулығыңыздың жақсарып келе жатқанына өте қуаныштымыз.〞
Dialogue: 0,0:01:24.87,0:01:27.17,Default,,0,0,0,,``Мен сізге кенеттен келген хатты жібергенім үшін кешірім сұраймын.''
Dialogue: 0,0:01:27.33,0:01:28.42,Default,,0,0,0,,``Мені кешіріңіз.''
Dialogue: 0,0:01:29.25,0:01:31.88,Default,,0,0,0,,〝Қолайсыздық үшін кешірім сұраймыз, бірақ〞
Dialogue: 0,0:01:32.38,0:01:34.30,Default,,0,0,0,,``Бұл жолы мен сенен сұрауым керек...''
Dialogue: 0,0:01:34.46,0:01:36.55,Default,,0,0,0,,``Сұраным бар.''
Dialogue: 0,0:01:36.72,0:01:38.84,Default,,0,0,0,,``Мен қолыма қаламды осылай алдым.''
Dialogue: 0,0:01:39.30,0:01:41.22,Default,,0,0,0,,``Олай болса, соншалықты дөрекі...''
Dialogue: 0,0:01:41.39,0:01:44.02,Default,,0,0,0,,〝Бірден негізгі тақырыпқа көшейік〞
Dialogue: 0,0:01:44.85,0:01:48.56,Default,,0,0,0,,``Әпкеме қандай жақсы сыйлық бар?''
Dialogue: 0,0:01:49.27,0:01:51.61,Default,,0,0,0,,``Соңында мен сізге денсаулық тілеймін...''
Dialogue: 0,0:01:51.77,0:01:53.40,Default,,0,0,0,,...Бұл ұзақ кіріспе.
Dialogue: 0,0:01:53.53,0:01:54.73,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:01:54.98,0:01:56.95,Default,,0,0,0,,«Сенің бірдеңе істеуіңе қарсы емеспін».
Dialogue: 0,0:01:57.11,0:01:59.16,Default,,0,0,0,,``Әпкеңіздің туған күніне сыйлық таңдаңыз''
Dialogue: 0,0:01:59.32,0:02:00.74,Default,,0,0,0,,«Мен сенің маған көмектескеніңді қалаймын» (Кодака) Сіз де...
Dialogue: 0,0:02:00.91,0:02:02.37,Default,,0,0,0,,``Туған күнге дейін уақытым жоқ''
Dialogue: 0,0:02:02.53,0:02:03.91,Default,,0,0,0,,``Мүмкіндігінше, ертең жақсы болар еді.''
Dialogue: 0,0:02:04.04,0:02:05.29,Default,,0,0,0,,``Бұл сөзсіз сенсің...''
Dialogue: 0,0:02:05.41,0:02:07.21,Default,,0,0,0,,Бұл қажетсіз ұзақ...
Dialogue: 0,0:02:08.46,0:02:11.04,Default,,0,0,0,,…«Бөлек» сөздер өте көп.
Dialogue: 0,0:02:12.54,0:02:13.80,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:14.59,0:02:16.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:18.84,0:02:19.72,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:22.26,0:02:24.10,Default,,0,0,0,,Кім (4 адам) Иә?
Dialogue: 0,0:02:24.22,0:02:25.72,Default,,0,0,0,,3-платформада Эйяға бара жатқан пойыз бар...
Dialogue: 0,0:02:25.85,0:02:27.64,Default,,0,0,0,,үшін осында.
Dialogue: 0,0:02:27.77,0:02:29.94,Default,,0,0,0,,Жарайды, расында, кеттік.
Dialogue: 0,0:02:30.73,0:02:31.90,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:32.06,0:02:38.74,Default,,0,0,0,,♪～
Dialogue: 0,0:03:54.56,0:04:01.61,Default,,0,0,0,,～♪
Dialogue: 0,0:04:06.45,0:04:08.45,Default,,0,0,0,,Түнгі аспан, мұнда да отыр.
Dialogue: 0,0:04:08.62,0:04:10.45,Default,,0,0,0,,редактор ретінде,
Dialogue: 0,0:04:10.58,0:04:12.79,Default,,0,0,0,,Ет неліктен мұнда?
Dialogue: 0,0:04:12.91,0:04:15.88,Default,,0,0,0,,Әй, қарағым, саған айтуды ұмытып кетіппін.
Dialogue: 0,0:04:16.21,0:04:18.96,Default,,0,0,0,,үшін Кобатоның туған күніне сыйлық сатып алмақшы...
Dialogue: 0,0:04:19.09,0:04:20.84,Default,,0,0,0,,Адам санын көбейту дұрыс емес пе?
Dialogue: 0,0:04:21.63,0:04:24.13,Default,,0,0,0,,Көбейсе қарсы емеспін, бірақ мағынасы жоқ.
Dialogue: 0,0:04:24.34,0:04:25.39,Default,,0,0,0,,Әсіресе сіз-
Dialogue: 0,0:04:25.51,0:04:27.43,Default,,0,0,0,,Ол бұл туралы ештеңе ойламайтын сияқты.
Dialogue: 0,0:04:27.89,0:04:29.10,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:04:29.22,0:04:30.56,Default,,0,0,0,,Бұл ештеңе емес, ақымақ.
Dialogue: 0,0:04:30.68,0:04:34.02,Default,,0,0,0,,Мен бәрібір осылай болады деп ойладым.
Dialogue: 0,0:04:34.14,0:04:36.65,Default,,0,0,0,,Бастысы – бас тарту, әркім.
Dialogue: 0,0:04:36.77,0:04:39.19,Default,,0,0,0,,Мен қанағаттандым, Рика-доно.
Dialogue: 0,0:04:39.86,0:04:43.07,Default,,0,0,0,,Бұл күңгірттік шынымен рас па?
Dialogue: 0,0:04:43.19,0:04:46.45,Default,,0,0,0,,Әлде солай болғанын қалағандықтан болды ма?
Dialogue: 0,0:04:47.28,0:04:48.16,Default,,0,0,0,,Ғылым…
Dialogue: 0,0:04:48.28,0:04:49.74,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:04:49.87,0:04:52.37,Default,,0,0,0,,Мен бұл әдеттегідей қызықты болды деп ойладым.
Dialogue: 0,0:04:52.50,0:04:53.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:53.87,0:04:56.62,Default,,0,0,0,,Менің ойымша, ол бүгін де формасында ақ халат киген.
Dialogue: 0,0:04:56.75,0:04:58.21,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:04:58.33,0:04:59.54,Default,,0,0,0,,Сіз бұл күндері
Dialogue: 0,0:04:59.67,0:05:02.34,Default,,0,0,0,,Шашым сәнді болса да, киімге мән бермеймін...
Dialogue: 0,0:05:02.46,0:05:03.88,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 0,0:05:04.30,0:05:05.68,Default,,0,0,0,,Бүгін де мен бейқам торға салдым.
Dialogue: 0,0:05:05.80,0:05:08.01,Default,,0,0,0,,Оны жұмсақ және үш өлшемді етіп көрсетеді.
Dialogue: 0,0:05:08.14,0:05:10.43,Default,,0,0,0,,Сонымен... мұны байқаған боларсыз ба?
Dialogue: 0,0:05:10.89,0:05:12.43,Default,,0,0,0,,Мен мұны істеймін, Сенпай.
Dialogue: 0,0:05:12.93,0:05:17.10,Default,,0,0,0,,Бірақ мен ғылымда киімге назар аударудың қажеті жоқ сияқты.
Dialogue: 0,0:05:17.48,0:05:20.82,Default,,0,0,0,,Тіпті ғылым соншалықты тырысқанда, тіпті киім ауыстыру да назардан тыс қалды.
Dialogue: 0,0:05:21.44,0:05:23.32,Default,,0,0,0,,Ғылым да сүйкімді көрінеді.
Dialogue: 0,0:05:23.44,0:05:25.95,Default,,0,0,0,,Менің ойымша, сүйкімді киімдер де сізге жарасады.
Dialogue: 0,0:05:26.07,0:05:27.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:28.74,0:05:31.78,Default,,0,0,0,,Иә? Мүмкін мен оны тағы да қатты айттым ба?
Dialogue: 0,0:05:31.91,0:05:33.83,Default,,0,0,0,,Менің қолымнан келетіні осы
Dialogue: 0,0:05:34.66,0:05:37.46,Default,,0,0,0,,Ах, Токи Токи Сена-сенпай (Сена) Не?
Dialogue: 0,0:05:37.58,0:05:40.63,Default,,0,0,0,,Мен осы мүмкіндікті пайдаланып, сіздің киімдеріңізді көргім келеді.
Dialogue: 0,0:05:40.75,0:05:43.09,Default,,0,0,0,,Сізде ұсынылған дүкендер бар ма?
Dialogue: 0,0:05:43.21,0:05:45.05,Default,,0,0,0,,А... менің ұсынысым?
Dialogue: 0,0:05:45.17,0:05:47.59,Default,,0,0,0,,Иә, Сена-сенпай, сәнді.
Dialogue: 0,0:05:47.72,0:05:49.64,Default,,0,0,0,,Мұны анықтама ретінде пайдаланыңыз.
Dialogue: 0,0:05:49.76,0:05:51.80,Default,,0,0,0,,Ал, мен...
Dialogue: 0,0:05:51.93,0:05:54.02,Default,,0,0,0,,Өйткені мен мәңгілікке бармаймын.
Dialogue: 0,0:05:54.18,0:05:57.73,Default,,0,0,0,,Әдетте... Мен үйімнің жанындағы қымбат бренд дүкеніне барамын.
Dialogue: 0,0:05:58.19,0:06:01.11,Default,,0,0,0,,Айналаңызда таулар мен күріш алқаптары ғана бар емес пе?
Dialogue: 0,0:06:01.23,0:06:02.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:02.48,0:06:03.86,Default,,0,0,0,,Сена-сенпай...
Dialogue: 0,0:06:03.98,0:06:05.69,Default,,0,0,0,,Сенаның әпкесі...
Dialogue: 0,0:06:07.24,0:06:09.53,Default,,0,0,0,,Кешіріңіз, өтірік айттым.
Dialogue: 0,0:06:09.82,0:06:11.91,Default,,0,0,0,,Киімді әрқашан Стеллаға қалдырыңыз.
Dialogue: 0,0:06:12.03,0:06:13.87,Default,,0,0,0,,Мен шашымды және макияжымды жасадым.
Dialogue: 0,0:06:13.99,0:06:15.70,Default,,0,0,0,,Ху (Сена) Сен кімсің?
Dialogue: 0,0:06:15.83,0:06:17.00,Default,,0,0,0,,Мені бір нәрсе мазалайды.
Dialogue: 0,0:06:17.12,0:06:20.08,Default,,0,0,0,,Әйелдік қуат бар болғаны 5, қоқыс.
Dialogue: 0,0:06:20.21,0:06:21.46,Default,,0,0,0,,Скаутер
Dialogue: 0,0:06:21.58,0:06:24.17,Default,,0,0,0,,Айтпақшы, Йозора-сенпай қайсысы?
Dialogue: 0,0:06:24.30,0:06:25.76,Default,,0,0,0,,Интернет арқылы сатып алу
Dialogue: 0,0:06:25.96,0:06:29.01,Default,,0,0,0,,Журналдар мен интернет-сауда сайттарындағы модельдер не киген.
Dialogue: 0,0:06:29.13,0:06:30.59,Default,,0,0,0,,Толық жиынтықты сатып алу
Dialogue: 0,0:06:31.01,0:06:32.72,Default,,0,0,0,,Сән журналы Өзіңіз сияқты киінсеңіз де -
Dialogue: 0,0:06:32.85,0:06:35.14,Default,,0,0,0,,Саған қалай қарайтынына мен қызғанамын.
Dialogue: 0,0:06:35.26,0:06:37.48,Default,,0,0,0,,Ол бүгін де сүйкімді
Dialogue: 0,0:06:37.60,0:06:39.52,Default,,0,0,0,,Өте сүйкімді...?
Dialogue: 0,0:06:39.64,0:06:43.31,Default,,0,0,0,,Иә, бұл қыз және өте эротикалық және сүйкімді.
Dialogue: 0,0:06:43.44,0:06:47.69,Default,,0,0,0,,Иә? (Түнгі аспан) Қыз...Эротикалық сүйкімді?
Dialogue: 0,0:06:49.99,0:06:51.11,Default,,0,0,0,,Не? (Кодака) О...
Dialogue: 0,0:06:52.16,0:06:53.41,Default,,0,0,0,,Уа... ой
Dialogue: 0,0:06:53.53,0:06:55.37,Default,,0,0,0,,Ақымақ, себебі бұл журнал...
Dialogue: 0,0:06:55.49,0:06:57.37,Default,,0,0,0,,Ол Boyish Dressing Techniques заңда көрсетілген.
Dialogue: 0,0:06:57.50,0:06:59.75,Default,,0,0,0,,Куфу… Куфуфу (Ғылым) Йозора-сенпай…
Dialogue: 0,0:06:59.87,0:07:03.79,Default,,0,0,0,,Йозора: Білесің бе... Балалық келбеті?
Dialogue: 0,0:07:03.92,0:07:07.17,Default,,0,0,0,,Бұл міндетті түрде ер адамға ұқсамайды.
Dialogue: 0,0:07:07.30,0:07:08.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:08.26,0:07:11.09,Default,,0,0,0,,Тек қыздардың сүйкімділігін көрсету үшін.
Dialogue: 0,0:07:11.22,0:07:14.22,Default,,0,0,0,,Бұл бейтарап атмосфераны қосу әдісі.
Dialogue: 0,0:07:14.35,0:07:17.14,Default,,0,0,0,,Егер сіз қалыпты өмір сүрсеңіз, оны байқайтын шығарсыз.
Dialogue: 0,0:07:17.81,0:07:22.02,Default,,0,0,0,,Жамбастары мен қарындары ашық күйде жүретін ер адамдар көп емес.
Dialogue: 0,0:07:22.48,0:07:26.94,Default,,0,0,0,,Өйткені... Мен басқа жігіттердің қандай болатынына ешқашан мән берген емеспін.
Dialogue: 0,0:07:27.07,0:07:29.24,Default,,0,0,0,,Иә? (Түнгі аспан) Ал... бұл ештеңе емес.
Dialogue: 0,0:07:29.57,0:07:31.11,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:07:31.74,0:07:35.37,Default,,0,0,0,,Ой! Түсіндім.
Dialogue: 0,0:07:37.08,0:07:39.37,Default,,0,0,0,,Мен басқа дүкенге барамын.
Dialogue: 0,0:07:39.50,0:07:40.87,Default,,0,0,0,,Кішкентай сұңқардың соңынан ерме
Dialogue: 0,0:07:41.00,0:07:43.67,Default,,0,0,0,,Жарайды, бірақ сен жақсысың ба? тобыр
Dialogue: 0,0:07:43.83,0:07:45.17,Default,,0,0,0,,Ғылым да сенімен бірге болады.
Dialogue: 0,0:07:45.29,0:07:47.38,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:07:48.42,0:07:50.38,Default,,0,0,0,,Юкимура менің орнымда-
Dialogue: 0,0:07:50.51,0:07:52.68,Default,,0,0,0,,Сіз Йозора мен Рикамен бірге жүре аласыз ба?
Dialogue: 0,0:07:52.84,0:07:55.76,Default,,0,0,0,,Көпшілік арасында құлап қалмас үшін маған қамқорлық жасаңыз.
Dialogue: 0,0:07:55.89,0:07:58.85,Default,,0,0,0,,Иә, маған қалдырыңызшы, ағайын.
Dialogue: 0,0:07:58.97,0:08:00.98,Default,,0,0,0,,Олай болса кеттік.
Dialogue: 0,0:08:01.10,0:08:02.73,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:04.77,0:08:05.69,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:08:06.77,0:08:09.94,Default,,0,0,0,,Олай болса, айналамызды бірге тамашалайық.
Dialogue: 0,0:08:10.07,0:08:12.40,Default,,0,0,0,,А... иә
Dialogue: 0,0:08:17.16,0:08:18.45,Default,,0,0,0,,Сәлем Котака
Dialogue: 0,0:08:18.66,0:08:19.99,Default,,0,0,0,,Кобато-чанға не сыйлауым керек?
Dialogue: 0,0:08:20.12,0:08:22.04,Default,,0,0,0,,Менің қолайлылығым арта ма?
Dialogue: 0,0:08:22.21,0:08:24.17,Default,,0,0,0,,Өйткені, «Куронеку» тауарлары?
Dialogue: 0,0:08:24.29,0:08:27.84,Default,,0,0,0,,А, ол қалаған нәрсесінің көпшілігіне ие болды.
Dialogue: 0,0:08:27.96,0:08:31.38,Default,,0,0,0,,Айтпақшы, тым қымбат нәрсені сатып алмаңыз.
Dialogue: 0,0:08:31.76,0:08:32.84,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:33.01,0:08:36.14,Default,,0,0,0,,Сіз таңқаларлықтай жақсы қамқоршысыз, солай емес пе?
Dialogue: 0,0:08:36.47,0:08:38.01,Default,,0,0,0,,Сонымен не қалайсыз?
Dialogue: 0,0:08:38.14,0:08:41.47,Default,,0,0,0,,Мысалы, сіз алуға қуанышты болатын нәрсе.
Dialogue: 0,0:08:41.60,0:08:43.39,Default,,0,0,0,,Әрине, Кобато-чан!
Dialogue: 0,0:08:43.52,0:08:45.02,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:08:46.23,0:08:49.52,Default,,0,0,0,,А, мінекей. Кобато 100% қуанатын нәрсе.
Dialogue: 0,0:08:49.65,0:08:50.82,Default,,0,0,0,,Не?
Dialogue: 0,0:08:51.03,0:08:52.15,Default,,0,0,0,,Ет (Сена) Е!
Dialogue: 0,0:08:52.28,0:08:54.40,Default,,0,0,0,,Бұл сіз емес, ингредиенттердің еті.
Dialogue: 0,0:08:54.53,0:08:56.99,Default,,0,0,0,,А... Мен білемін. Бұл туралы.
Dialogue: 0,0:08:57.11,0:08:59.49,Default,,0,0,0,,Өйткені Кобато барлық ет тағамдарын жақсы көреді...
Dialogue: 0,0:08:59.62,0:09:01.41,Default,,0,0,0,,Ет жесең, міндетті түрде қуанасың.
Dialogue: 0,0:09:01.54,0:09:05.33,Default,,0,0,0,,Бірақ туған күнге сыйлық ретінде шикі тағам ше?
Dialogue: 0,0:09:05.46,0:09:08.79,Default,,0,0,0,,Жоқ... Сена ақыл үйретеді деп күтпедім.
Dialogue: 0,0:09:08.92,0:09:10.09,Default,,0,0,0,,О? (Сена) Жарайды
Dialogue: 0,0:09:10.21,0:09:12.34,Default,,0,0,0,,Заттың бұл түрі соңғы шара болып табылады.
Dialogue: 0,0:09:12.51,0:09:13.97,Default,,0,0,0,,Тағы бірнеше нәрсені қараңыз... (Кодака) О, күте тұрыңыз...
Dialogue: 0,0:09:14.09,0:09:15.47,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:09:15.88,0:09:18.72,Default,,0,0,0,,Не? (Кодака) Бұл... бұл
Dialogue: 0,0:09:18.84,0:09:19.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:20.97,0:09:23.43,Default,,0,0,0,,Мен саған не үшін дүкенге бардым?
Dialogue: 0,0:09:23.56,0:09:25.31,Default,,0,0,0,,Менімен бір сағат араласасың.
Dialogue: 0,0:09:25.43,0:09:26.94,Default,,0,0,0,,Қалыпты Бұл керісінше емес пе?
Dialogue: 0,0:09:27.06,0:09:28.10,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:09:28.23,0:09:31.15,Default,,0,0,0,,...Қуырғыш табаға қараудың несі қызық?
Dialogue: 0,0:09:31.27,0:09:33.40,Default,,0,0,0,,Ой, әдепкі қуырғыш таба...
Dialogue: 0,0:09:33.53,0:09:34.94,Default,,0,0,0,,Оны басқалармен араластырмаңыз.
Dialogue: 0,0:09:35.53,0:09:37.03,Default,,0,0,0,,Толығырақ түсіндірейін.
Dialogue: 0,0:09:37.15,0:09:38.11,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:09:40.49,0:09:43.45,Default,,0,0,0,,Хаа... Сен шынымен де бірдеңесің.
Dialogue: 0,0:09:43.62,0:09:44.95,Default,,0,0,0,,Бұл басқаша, солай емес пе?
Dialogue: 0,0:09:45.08,0:09:47.71,Default,,0,0,0,,Тамақ пісіргенді ұнатсаңыз да, жарайды.
Dialogue: 0,0:09:47.83,0:09:50.50,Default,,0,0,0,,Бұл ғана емес, ақымақ.
Dialogue: 0,0:09:51.00,0:09:53.92,Default,,0,0,0,,...Бірақ Йозора мен басқалары көптен бері дүкен аралап жүр.
Dialogue: 0,0:09:54.05,0:09:56.47,Default,,0,0,0,,Қыздар ұзақ уақыт дүкен аралайды.
Dialogue: 0,0:09:57.30,0:09:58.80,Default,,0,0,0,,... гал ойынында айтылды
Dialogue: 0,0:09:58.93,0:10:00.76,Default,,0,0,0,,Ойыннан алынған білім?
Dialogue: 0,0:10:02.76,0:10:06.39,Default,,0,0,0,,Сен, түнгі аспан, ғылым, Юкимура...
Dialogue: 0,0:10:06.52,0:10:07.69,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:07.81,0:10:09.40,Default,,0,0,0,,Хмм, сіз нені айтып тұрсыз?
Dialogue: 0,0:10:09.56,0:10:10.65,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:11.40,0:10:13.82,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:10:14.15,0:10:15.86,Default,,0,0,0,,Толық түсінгенім жоқ, бірақ—
Dialogue: 0,0:10:15.99,0:10:19.61,Default,,0,0,0,,Сонда сіз қызды қаламайсыз ба?
Dialogue: 0,0:10:19.82,0:10:22.37,Default,,0,0,0,,Мен мұны қаламаймын деп ойлаймын.
Dialogue: 0,0:10:22.49,0:10:24.37,Default,,0,0,0,,Бұл түсініксіз.
Dialogue: 0,0:10:24.49,0:10:27.62,Default,,0,0,0,,Менің ең жақын мақсатым – дос болу.
Dialogue: 0,0:10:27.75,0:10:31.83,Default,,0,0,0,,Біріншіден, мен бірде-бір досы жоқ қызықсыз жігітпін.
Dialogue: 0,0:10:31.96,0:10:33.38,Default,,0,0,0,,Сіздің қызыңыз болуы мүмкін емес.
Dialogue: 0,0:10:33.88,0:10:36.13,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:10:36.26,0:10:39.88,Default,,0,0,0,,Иә? (Сена) Ой, не болып жатыр екен.
Dialogue: 0,0:10:40.80,0:10:42.01,Default,,0,0,0,,Толық түсінгенім жоқ, бірақ—
Dialogue: 0,0:10:42.14,0:10:45.14,Default,,0,0,0,,Бұл бұрыннан қандай? (Сена) Хмм...
Dialogue: 0,0:10:45.77,0:10:47.68,Default,,0,0,0,,Иә, Сена (Сена) Иә?
Dialogue: 0,0:10:47.81,0:10:52.44,Default,,0,0,0,,Сонда... ше, Йозора екеуміз бұрын дос болдық па?
Dialogue: 0,0:10:52.56,0:10:54.52,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:54.86,0:10:56.19,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:56.32,0:10:57.90,Default,,0,0,0,,Мен естігенде...
Dialogue: 0,0:10:58.03,0:11:00.15,Default,,0,0,0,,Мен сәл шыдамсыз болдым.
Dialogue: 0,0:11:00.28,0:11:03.32,Default,,0,0,0,,Ойлап қарасам, маған бәрібір.
Dialogue: 0,0:11:03.49,0:11:05.12,Default,,0,0,0,,Кімге бәрібір?
Dialogue: 0,0:11:05.41,0:11:06.83,Default,,0,0,0,,Өйткені ол өткен шақ, солай ма?
Dialogue: 0,0:11:07.62,0:11:09.54,Default,,0,0,0,,Маңыздысы қазір.
Dialogue: 0,0:11:10.29,0:11:12.17,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:11:12.71,0:11:15.21,Default,,0,0,0,,Ал, түнгі аспан нені білдіреді?
Dialogue: 0,0:11:15.34,0:11:16.67,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:11:16.80,0:11:18.84,Default,,0,0,0,,Не? (Сена) бөлек
Dialogue: 0,0:11:19.30,0:11:22.30,Default,,0,0,0,,Менің жеңіліп қалғым келмейді, бар болғаны.
Dialogue: 0,0:11:22.43,0:11:23.59,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:11:25.14,0:11:26.35,Default,,0,0,0,,Сондай-ақ, Kodaka.
Dialogue: 0,0:11:26.81,0:11:29.77,Default,,0,0,0,,Бұл маңызды, сондықтан оны мұқият есте сақтаңыз.
Dialogue: 0,0:11:30.35,0:11:31.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.35,0:11:34.65,Default,,0,0,0,,Маған ұнайтын адам...
Dialogue: 0,0:11:34.77,0:11:36.48,Default,,0,0,0,,Бұл жалықтырмайды.
Dialogue: 0,0:11:36.98,0:11:37.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.99,0:11:43.57,Default,,0,0,0,,Не... қалай ойлайсың? Kodaka Senpai
Dialogue: 0,0:11:43.70,0:11:46.83,Default,,0,0,0,,Мен оны дүкен қызметкері ұсынғандай сатып алдым.
Dialogue: 0,0:11:46.95,0:11:48.66,Default,,0,0,0,,Жоқ, бұл не?
Dialogue: 0,0:11:48.79,0:11:51.71,Default,,0,0,0,,Сенің де қолыңнан келетін сияқты.
Dialogue: 0,0:11:51.83,0:11:54.92,Default,,0,0,0,,Мен мұны мақтау ретінде қабылдаймын.
Dialogue: 0,0:11:55.08,0:11:57.09,Default,,0,0,0,,Эхехе (Юкимура) Үлкен аға...
Dialogue: 0,0:11:57.21,0:11:59.13,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:11:59.26,0:12:01.72,Default,,0,0,0,,Йозораның әпкесінен мұра
Dialogue: 0,0:12:01.84,0:12:04.34,Default,,0,0,0,,Юкимура, сен істейсің!
Dialogue: 0,0:12:04.64,0:12:07.05,Default,,0,0,0,,А-а... саған жарасады.
Dialogue: 0,0:12:07.18,0:12:09.52,Default,,0,0,0,,Рахмет, аға.
Dialogue: 0,0:12:09.97,0:12:11.14,Default,,0,0,0,,...мен...
Dialogue: 0,0:12:11.27,0:12:12.31,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:12:14.27,0:12:16.90,Default,,0,0,0,,Сен уже... Әй, бұл рас.
Dialogue: 0,0:12:17.02,0:12:18.23,Default,,0,0,0,,Бұл сен емессің.
Dialogue: 0,0:12:18.36,0:12:19.78,Default,,0,0,0,,Шулы ет
Dialogue: 0,0:12:19.90,0:12:21.90,Default,,0,0,0,,Өзіңізді жайсыз сезініп, шу шығармаңыз
Dialogue: 0,0:12:22.11,0:12:22.99,Default,,0,0,0,,Джерси…
Dialogue: 0,0:12:23.11,0:12:25.57,Default,,0,0,0,,Мен оны спорт тауарлары бөлімінен таптым.
Dialogue: 0,0:12:25.70,0:12:26.57,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:12:27.32,0:12:30.45,Default,,0,0,0,,...Бірақ бұл қала маған жарамайды.
Dialogue: 0,0:12:30.79,0:12:33.79,Default,,0,0,0,,Жергілікті дүкендерден сыйлықтар табыңыз
Dialogue: 0,0:12:33.91,0:12:35.50,Default,,0,0,0,,Иә? (Ғылым) Кешіріңіз.
Dialogue: 0,0:12:35.62,0:12:37.33,Default,,0,0,0,,Мен де ғылымға қайта оралғым келеді.
Dialogue: 0,0:12:37.46,0:12:39.38,Default,,0,0,0,,Иә? (Кодака) Кешіріңіз Сена
Dialogue: 0,0:12:39.50,0:12:41.80,Default,,0,0,0,,Менің жүгім де ауыр, мен жүргім келмейді.
Dialogue: 0,0:12:41.92,0:12:44.63,Default,,0,0,0,,Эй... Эй (Юкимура) Мен сені ертіп барамын, аға.
Dialogue: 0,0:12:44.76,0:12:46.72,Default,,0,0,0,,...сіз барсыз
Dialogue: 0,0:12:46.84,0:12:49.18,Default,,0,0,0,,Неге сонша көңілің қалды!
Dialogue: 0,0:12:56.27,0:12:59.11,Default,,0,0,0,,Иә, тамаша, мен күткендей.
Dialogue: 0,0:12:59.44,0:13:01.07,Default,,0,0,0,,Хмм, бәрібір.
Dialogue: 0,0:13:01.19,0:13:03.19,Default,,0,0,0,,Кобато-чанның туған күні болса да...
Dialogue: 0,0:13:03.32,0:13:04.70,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:13:04.86,0:13:07.07,Default,,0,0,0,,Біз үшін әдеттегі туған күн кеші деген жоқ.
Dialogue: 0,0:13:07.20,0:13:08.66,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:13:08.95,0:13:09.99,Default,,0,0,0,,Мынадай.
Dialogue: 0,0:13:10.16,0:13:11.45,Default,,0,0,0,,Айтпақшы, ағайын.
Dialogue: 0,0:13:11.58,0:13:15.04,Default,,0,0,0,,Туған күн кешіне не істеуім керек?
Dialogue: 0,0:13:15.16,0:13:19.04,Default,,0,0,0,,Хмм, біз саған сыйлықтар беріп, торт жейміз, солай ма?
Dialogue: 0,0:13:19.17,0:13:20.96,Default,,0,0,0,,Тағы не істеуім керек?
Dialogue: 0,0:13:21.09,0:13:23.80,Default,,0,0,0,,Мүмкін бәріміз ойын ойнауымыз керек пе?
Dialogue: 0,0:13:24.05,0:13:25.72,Default,,0,0,0,,Ойындар, т.б. Ет галь ойындары мен...
Dialogue: 0,0:13:25.84,0:13:28.09,Default,,0,0,0,,Бұл тек ғылыми компьютерлік ойын.
Dialogue: 0,0:13:28.22,0:13:29.97,Default,,0,0,0,,Бірдеңе... (Кодака) Эй, эй.
Dialogue: 0,0:13:30.10,0:13:32.68,Default,,0,0,0,,...Шынымен қобалжыдыңыз ба?
Dialogue: 0,0:13:33.60,0:13:36.31,Default,,0,0,0,,Ғылыми кабинетте де аналогтық ойындар жоқ.
Dialogue: 0,0:13:36.44,0:13:38.77,Default,,0,0,0,,Олай болса, мен жақын жердегі ойыншықтар дүкенінен сатып алайын.
Dialogue: 0,0:13:38.90,0:13:40.15,Default,,0,0,0,,Twister т.б.
Dialogue: 0,0:13:40.27,0:13:41.94,Default,,0,0,0,,Неліктен Twister?
Dialogue: 0,0:13:42.11,0:13:44.11,Default,,0,0,0,,(Кобатоның электрондық пошта қоңырау үні)
Dialogue: 0,0:13:44.36,0:13:47.91,Default,,0,0,0,,Егер сіз соншалықты алыс болмасаңыз, тезірек кіріңіз.
Dialogue: 0,0:13:49.99,0:13:50.91,Default,,0,0,0,,Уау
Dialogue: 0,0:13:51.03,0:13:53.54,Default,,0,0,0,,Туған күнің құтты болсын Кобато-чан
Dialogue: 0,0:13:53.66,0:13:56.16,Default,,0,0,0,,Ууу
Dialogue: 0,0:13:56.66,0:13:58.87,Default,,0,0,0,,Мен оны бәрібір ойнауға тырыстым.
Dialogue: 0,0:13:59.17,0:14:00.96,Default,,0,0,0,,Сосын (Кобато) Эй!
Dialogue: 0,0:14:02.04,0:14:03.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:03.50,0:14:05.88,Default,,0,0,0,,Саса, Кобато-чан, осында отырыңдар.
Dialogue: 0,0:14:06.01,0:14:07.84,Default,,0,0,0,,Сено торты
Dialogue: 0,0:14:07.97,0:14:10.05,Default,,0,0,0,,Джажаан (Кобато) Уау
Dialogue: 0,0:14:11.30,0:14:14.64,Default,,0,0,0,,Сіз қалай ойлайсыз? Ол саған ұнады ма? Кобато-чан
Dialogue: 0,0:14:14.77,0:14:15.89,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:16.02,0:14:18.69,Default,,0,0,0,,Сіз шынымен де қажет емес нәрселерді әр уақытта жасайсыз.
Dialogue: 0,0:14:18.81,0:14:21.40,Default,,0,0,0,,Не? Ең әдемі торт емес
Dialogue: 0,0:14:25.15,0:14:26.28,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:14:26.40,0:14:28.03,Default,,0,0,0,,Уау
Dialogue: 0,0:14:28.53,0:14:32.24,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:32.37,0:14:35.66,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:36.16,0:14:38.66,Default,,0,0,0,,♪ Туған күніңмен жаным
Dialogue: 0,0:14:38.79,0:14:40.67,Default,,0,0,0,,♪ Кобато-чан (Котака)♪ Кобато-чан
Dialogue: 0,0:14:40.79,0:14:43.04,Default,,0,0,0,,Жоқ, тек осында сәйкестендіріңіз.
Dialogue: 0,0:14:43.17,0:14:47.59,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:47.72,0:14:50.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:50.22,0:14:53.05,Default,,0,0,0,,Қараңыз, Кобато шамы (Кобато) Га.
Dialogue: 0,0:14:54.01,0:14:54.97,Default,,0,0,0,,Иә
Dialogue: 0,0:14:56.31,0:14:58.81,Default,,0,0,0,,Иә
Dialogue: 0,0:14:59.06,0:15:02.40,Default,,0,0,0,,(5 адам қолдайды)
Dialogue: 0,0:15:04.73,0:15:06.40,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:15:06.53,0:15:07.78,Default,,0,0,0,,Ой, қолым тайып кетті.
Dialogue: 0,0:15:07.90,0:15:10.49,Default,,0,0,0,,Қарашы, сенпай, а.
Dialogue: 0,0:15:12.24,0:15:14.62,Default,,0,0,0,,Уау (түнгі аспан) Ух... иә
Dialogue: 0,0:15:15.20,0:15:17.12,Default,,0,0,0,,Оның иісі жақсы.
Dialogue: 0,0:15:17.24,0:15:19.37,Default,,0,0,0,,Ой (Юкимура) Бұл есепшот.
Dialogue: 0,0:15:21.83,0:15:23.63,Default,,0,0,0,,Хехе…
Dialogue: 0,0:15:25.34,0:15:28.63,Default,,0,0,0,,Уф... (Кодака) Бұл не? Бұл ет пе?
Dialogue: 0,0:15:28.76,0:15:31.76,Default,,0,0,0,,Шулы екен, сен де жегің келеді деп ойладым.
Dialogue: 0,0:15:31.88,0:15:34.30,Default,,0,0,0,,Ет... бұл тым өзін-өзі кемсітеді.
Dialogue: 0,0:15:34.43,0:15:37.68,Default,,0,0,0,,Керемет, Кобато, бүгін кешке сукияки ішеміз.
Dialogue: 0,0:15:37.81,0:15:40.73,Default,,0,0,0,,Уфуфу Мен деп ойлап, дәмді тамақтан.
Dialogue: 0,0:15:40.85,0:15:41.73,Default,,0,0,0,,№
Dialogue: 0,0:15:43.10,0:15:46.94,Default,,0,0,0,,Уфуфу Сукияки Ихихихи
Dialogue: 0,0:15:47.36,0:15:48.86,Default,,0,0,0,,Көңіл-күйіңіз жақсы.
Dialogue: 0,0:15:48.98,0:15:51.61,Default,,0,0,0,,Кук кук кук бүгін жақсы күн
Dialogue: 0,0:15:51.74,0:15:54.37,Default,,0,0,0,,(Кобатоның күлкісі)
Dialogue: 0,0:15:55.03,0:15:57.37,Default,,0,0,0,,Ал, мен сукиякиге ингредиенттерді сатып алып, үйге қайтайын.
Dialogue: 0,0:15:57.49,0:15:58.83,Default,,0,0,0,,Алдымен үйге бару керек.
Dialogue: 0,0:15:58.95,0:16:01.87,Default,,0,0,0,,Тез қайт, уәзірім.
Dialogue: 0,0:16:07.09,0:16:07.96,Default,,0,0,0,,Эй (Кейт Такаяма) Иә?
Dialogue: 0,0:16:08.09,0:16:10.38,Default,,0,0,0,,Әй, аға, мұнда неге келдің?
Dialogue: 0,0:16:10.51,0:16:12.59,Default,,0,0,0,,Менің алдымда не айтып тұрсың?
Dialogue: 0,0:16:12.72,0:16:13.93,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:14.51,0:16:17.85,Default,,0,0,0,,Мен жай ғана ішке үңілмек болдым.
Dialogue: 0,0:16:17.97,0:16:20.06,Default,,0,0,0,,Жоқ? Онии-чан (Кодака) Жақсы емес.
Dialogue: 0,0:16:20.18,0:16:21.77,Default,,0,0,0,,…Ол неге ішінде?
Dialogue: 0,0:16:22.10,0:16:24.98,Default,,0,0,0,,Ухахаха, үлкен аға қайтып келді.
Dialogue: 0,0:16:25.48,0:16:27.44,Default,,0,0,0,,О, Мария, сен осындасың ба?
Dialogue: 0,0:16:27.65,0:16:29.36,Default,,0,0,0,,Оны сізге Кейт жіберді ме?
Dialogue: 0,0:16:29.48,0:16:33.20,Default,,0,0,0,,Иә, әлгі қарт тек осындай кезде ғана пайдалы.
Dialogue: 0,0:16:33.32,0:16:35.20,Default,,0,0,0,,...Неге әлі осындасың, кемпір?
Dialogue: 0,0:16:35.32,0:16:37.53,Default,,0,0,0,,Мен сені ағамның үйіне апармас бұрын...
Dialogue: 0,0:16:37.66,0:16:39.54,Default,,0,0,0,,Мен апама мәңгілік ризамын.
Dialogue: 0,0:16:39.66,0:16:40.62,Default,,0,0,0,,Сіз... айтпадыңыз ба?
Dialogue: 0,0:16:40.74,0:16:44.08,Default,,0,0,0,,Бірақ сіз не істедіңіз? Анау... анау...
Dialogue: 0,0:16:44.21,0:16:45.58,Default,,0,0,0,,Шулы, қарғыс атқыр кәрі қаңбақ
Dialogue: 0,0:16:47.04,0:16:49.38,Default,,0,0,0,,Сен шынымен де дәрменсіз бала екенсің.
Dialogue: 0,0:16:49.50,0:16:52.59,Default,,0,0,0,,Кішкентай әпкем үшін уайымдасам да, оның көзіне қарадым.
Dialogue: 0,0:16:52.84,0:16:55.47,Default,,0,0,0,,Осында болғандықтан, сукияки жеу керек.
Dialogue: 0,0:16:55.59,0:16:56.84,Default,,0,0,0,,Әй, Сукияки?
Dialogue: 0,0:16:56.97,0:16:58.35,Default,,0,0,0,,Жарайды ма? (Кодака) О...о
Dialogue: 0,0:16:59.26,0:17:00.60,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:17:01.52,0:17:05.23,Default,,0,0,0,,Менің әдемі күнім тезек боп кетті.
Dialogue: 0,0:17:05.35,0:17:08.94,Default,,0,0,0,,Сіз менің ағамның нағыз әпкесі Кобатосыз ба?
Dialogue: 0,0:17:09.06,0:17:10.48,Default,,0,0,0,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:17:10.73,0:17:14.11,Default,,0,0,0,,Менің Мариям ағамды осылай атайды.
Dialogue: 0,0:17:14.36,0:17:15.24,Default,,0,0,0,,Егер Марияның ағасы...
Dialogue: 0,0:17:15.36,0:17:18.95,Default,,0,0,0,,Марияның әпкесі және ағамнан кіші болған мен үшін де...
Dialogue: 0,0:17:19.07,0:17:20.83,Default,,0,0,0,,Демек, ол менің ағам.
Dialogue: 0,0:17:20.95,0:17:23.00,Default,,0,0,0,,Фунгия!
Dialogue: 0,0:17:23.12,0:17:24.79,Default,,0,0,0,,Анчан
Dialogue: 0,0:17:24.91,0:17:26.50,Default,,0,0,0,,Ан-чан қазірдің өзінде...
Dialogue: 0,0:17:26.62,0:17:30.38,Default,,0,0,0,,Неліктен тек қарындастарды тез жасайсың? Сен сондай ақымақсың!
Dialogue: 0,0:17:30.50,0:17:31.67,Default,,0,0,0,,О... сабыр етіңіз.
Dialogue: 0,0:17:31.80,0:17:34.09,Default,,0,0,0,,Олар мені өздері қалағандай шақырып жатыр.
Dialogue: 0,0:17:34.21,0:17:35.09,Default,,0,0,0,,Мм!
Dialogue: 0,0:17:35.59,0:17:38.64,Default,,0,0,0,,Айтпақшы, Мария кенеттен менің үйіме неге келді?
Dialogue: 0,0:17:38.76,0:17:40.22,Default,,0,0,0,,Менің Кобато-чанға қатысым бар.
Dialogue: 0,0:17:40.72,0:17:43.81,Default,,0,0,0,,―
Dialogue: 0,0:17:43.93,0:17:46.98,Default,,0,0,0,,Түннің ұлы патшасы менімен не шаруаң бар?
Dialogue: 0,0:17:47.10,0:17:49.44,Default,,0,0,0,,Иә? Кобато-чан, не болды?
Dialogue: 0,0:17:49.56,0:17:51.32,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:17:51.61,0:17:54.07,Default,,0,0,0,,А... Қараңдаршы, Мария.
Dialogue: 0,0:17:54.19,0:17:56.70,Default,,0,0,0,,Кобато-чанға тез сыйлық беріңіз.
Dialogue: 0,0:17:56.82,0:17:58.41,Default,,0,0,0,,Уф... Гугу (Кодака/Кобато) Сыйлық па?
Dialogue: 0,0:17:58.53,0:18:01.66,Default,,0,0,0,,Эй, сен неге олай айтып тұрсың? Сен сұмдық қартсың!
Dialogue: 0,0:18:01.83,0:18:02.95,Default,,0,0,0,,Жақсы, маңызды емес.
Dialogue: 0,0:18:03.49,0:18:04.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:04.91,0:18:05.95,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:06.37,0:18:09.58,Default,,0,0,0,,Мен саған сыйлық беремін, сондықтан риза бол.
Dialogue: 0,0:18:10.92,0:18:13.00,Default,,0,0,0,,Себебі сіздің туған күніңіз маңызды...
Dialogue: 0,0:18:13.13,0:18:15.55,Default,,0,0,0,,Мен тезек вампирімін, бірақ мен оны саған беремін.
Dialogue: 0,0:18:15.76,0:18:17.22,Default,,0,0,0,,Ух... Хмф.
Dialogue: 0,0:18:17.34,0:18:18.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:21.01,0:18:21.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:21.97,0:18:24.60,Default,,0,0,0,,Өйткені сен зұлым жансың.
Dialogue: 0,0:18:24.72,0:18:28.19,Default,,0,0,0,,Оны киіп, киелі күшпен өміріңді түзеп, жақсы қыз бол.
Dialogue: 0,0:18:28.31,0:18:31.11,Default,,0,0,0,,Куккукку, сен ақымақ әулие
Dialogue: 0,0:18:31.23,0:18:33.36,Default,,0,0,0,,Мен қасиетті күшті түсіне алмаймын.
Dialogue: 0,0:18:33.48,0:18:37.28,Default,,0,0,0,,Не? Тәубеге келші, вампир.
Dialogue: 0,0:18:37.65,0:18:39.03,Default,,0,0,0,,Не десең де, кие берме.
Dialogue: 0,0:18:39.15,0:18:41.20,Default,,0,0,0,,Ауырды, ақымақ.
Dialogue: 0,0:18:41.32,0:18:43.83,Default,,0,0,0,,Қараңдар, мен сукияки жеймін.
Dialogue: 0,0:18:43.95,0:18:46.66,Default,,0,0,0,,Сукияки? Мен сукиякиді білемін.
Dialogue: 0,0:18:46.79,0:18:49.33,Default,,0,0,0,,Бұл дәмді көрінеді. Алақай.
Dialogue: 0,0:18:49.46,0:18:52.21,Default,,0,0,0,,Мен саған ыдыстарды сөндіруге көмектесемін. Ухаха.
Dialogue: 0,0:18:52.33,0:18:55.42,Default,,0,0,0,,Кобато, сыйлық үшін рахмет.
Dialogue: 0,0:18:56.05,0:19:00.47,Default,,0,0,0,,Ах, аа... рахмет... рахмет
Dialogue: 0,0:19:00.59,0:19:02.64,Default,,0,0,0,,Иә? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:19:02.76,0:19:05.18,Default,,0,0,0,,Жоқ... бұл ештеңе емес, ақымақ.
Dialogue: 0,0:19:05.31,0:19:07.93,Default,,0,0,0,,Қандай тез вампир!
Dialogue: 0,0:19:08.06,0:19:10.94,Default,,0,0,0,,(Кобато мен Мария бір-бірімен таласып жатыр)
Dialogue: 0,0:19:12.35,0:19:13.90,Default,,0,0,0,,Жарайсың, аға.
Dialogue: 0,0:19:14.02,0:19:18.07,Default,,0,0,0,,Салмағы 2 кг болса да 2 кесек ет жедім.
Dialogue: 0,0:19:18.19,0:19:20.90,Default,,0,0,0,,Хахаха, балалар жақсы тамақтандыңдар.
Dialogue: 0,0:19:21.03,0:19:21.91,Default,,0,0,0,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:19:22.57,0:19:25.99,Default,,0,0,0,,Әй, тойған соң ұйқым қаша бастады.
Dialogue: 0,0:19:26.29,0:19:28.75,Default,,0,0,0,,Бауырым, бүгін түнеуге бола ма?
Dialogue: 0,0:19:28.87,0:19:30.08,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:19:30.21,0:19:33.38,Default,,0,0,0,,Шынымен бе? Хаха рахмет... бұлп
Dialogue: 0,0:19:34.29,0:19:36.34,Default,,0,0,0,,Сіз шынымен 15 жастасыз ба?
Dialogue: 0,0:19:36.46,0:19:38.38,Default,,0,0,0,,Мен өткен күні 16-ға толдым.
Dialogue: 0,0:19:38.51,0:19:41.84,Default,,0,0,0,,Айтпақшы, Мария мұны маған сол кезде берген болатын.
Dialogue: 0,0:19:42.05,0:19:44.09,Default,,0,0,0,,Иә, зымыран?... Ах.
Dialogue: 0,0:19:44.72,0:19:45.60,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:46.05,0:19:48.02,Default,,0,0,0,,Мария маған берген цикада қабығы
Dialogue: 0,0:19:48.14,0:19:50.10,Default,,0,0,0,,Мен досымнан оны өңдеуді сұрадым.
Dialogue: 0,0:19:51.23,0:19:53.52,Default,,0,0,0,,Олар сол жерде сәйкес келсе де.
Dialogue: 0,0:19:57.48,0:19:59.32,Default,,0,0,0,,Саған да қиын болуы керек.
Dialogue: 0,0:19:59.44,0:20:01.28,Default,,0,0,0,,Оған көмектесу мүмкін емес, себебі ол менің үлкен әпкем.
Dialogue: 0,0:20:03.20,0:20:04.45,Default,,0,0,0,,Мария Иә?
Dialogue: 0,0:20:04.57,0:20:06.45,Default,,0,0,0,,Мен бүгін кешке ағаммен бірге боламын.
Dialogue: 0,0:20:07.08,0:20:08.70,Default,,0,0,0,,Енді мен шомыламын.
Dialogue: 0,0:20:08.83,0:20:11.37,Default,,0,0,0,,Ағаңмен бірге кір, ақымақ.
Dialogue: 0,0:20:11.50,0:20:14.71,Default,,0,0,0,,Рахмет, мен сенің денеңді жуайын.
Dialogue: 0,0:20:14.83,0:20:17.21,Default,,0,0,0,,Эй, мен саған кейінірек киім дайындаймын.
Dialogue: 0,0:20:19.09,0:20:22.34,Default,,0,0,0,,Жібер мені, қарғыс атқыр кемпір, үндеме.
Dialogue: 0,0:20:23.55,0:20:26.01,Default,,0,0,0,,Айтпақшы, Кобато қайда кетті?
Dialogue: 0,0:20:27.76,0:20:31.60,Default,,0,0,0,,(Кобатоның айқайы)
Dialogue: 0,0:20:33.64,0:20:34.85,Default,,0,0,0,,Кобато?
Dialogue: 0,0:20:38.77,0:20:42.24,Default,,0,0,0,,Кяхахаха... Онии-чанның жынысы
Dialogue: 0,0:20:42.36,0:20:44.74,Default,,0,0,0,,Уау... Кешіріңіз!
Dialogue: 0,0:20:45.28,0:20:48.37,Default,,0,0,0,,Хаа... хаа... ха
Dialogue: 0,0:20:48.66,0:20:51.16,Default,,0,0,0,,Сенің сылтауың бар ма, Чимми?
Dialogue: 0,0:20:51.70,0:20:53.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:53.16,0:20:54.46,Default,,0,0,0,,Жарайды, мен сені кешіремін.
Dialogue: 0,0:20:54.58,0:20:55.96,Default,,0,0,0,,Не? Жарайды ма?
Dialogue: 0,0:20:56.88,0:20:58.79,Default,,0,0,0,,Сен әдейі қараған жоқсың ғой?
Dialogue: 0,0:20:58.92,0:21:00.75,Default,,0,0,0,,А... бұл анық, солай емес пе?
Dialogue: 0,0:21:00.88,0:21:03.59,Default,,0,0,0,,Олай болса, ағаңды кінәлаудың қажеті жоқ.
Dialogue: 0,0:21:04.17,0:21:07.51,Default,,0,0,0,,Маған сенің сылтау айтпағаның да ұнайды.
Dialogue: 0,0:21:07.64,0:21:11.10,Default,,0,0,0,,А... бір жамандық жасағаным рас.
Dialogue: 0,0:21:11.22,0:21:14.02,Default,,0,0,0,,Сіздің ағаңыз өте жақсы адам.
Dialogue: 0,0:21:14.14,0:21:16.48,Default,,0,0,0,,Тэнма-санға неге ұнайтынын түсіндім.
Dialogue: 0,0:21:16.60,0:21:18.61,Default,,0,0,0,,Төрағамен жақсы қарым-қатынастасыз ба?
Dialogue: 0,0:21:19.02,0:21:21.44,Default,,0,0,0,,Тенма-сан екеуміз балық аулап доспыз.
Dialogue: 0,0:21:21.57,0:21:23.90,Default,,0,0,0,,Маған әсіресе тәтті балық аулау ұнайды.
Dialogue: 0,0:21:24.03,0:21:26.03,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:21:26.57,0:21:29.20,Default,,0,0,0,,Келесі жолы ағайын, бірге барайық.
Dialogue: 0,0:21:29.32,0:21:31.66,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:21:37.83,0:21:39.84,Default,,0,0,0,,Көріскенше, аға.
Dialogue: 0,0:21:39.96,0:21:41.67,Default,,0,0,0,,Әй, мектепке оралу.
Dialogue: 0,0:21:42.17,0:21:43.21,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:21:43.34,0:21:46.55,Default,,0,0,0,,Ағам шын ағам болса ғой.
Dialogue: 0,0:21:46.68,0:21:48.68,Default,,0,0,0,,Әлде... (Кодака) Иә?
Dialogue: 0,0:21:48.80,0:21:51.81,Default,,0,0,0,,Немесе басқа да қатынастар.
Dialogue: 0,0:21:51.93,0:21:54.56,Default,,0,0,0,,Мен үшін бұл аздап жақсы деп ойлаймын.
Dialogue: 0,0:21:54.68,0:21:57.48,Default,,0,0,0,,Сена-сан осында болғандықтан, оған көмектесу мүмкін емес деп ойлаймын.
Dialogue: 0,0:21:57.60,0:21:59.56,Default,,0,0,0,,Не? Аа, солай
Dialogue: 0,0:21:59.69,0:22:00.65,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:22:03.82,0:22:06.65,Default,,0,0,0,,Мен Кейттің сөздерінің мағынасын білемін.
Dialogue: 0,0:22:06.78,0:22:09.07,Default,,0,0,0,,Одан көп уақыт өткен жоқ.
Dialogue: 0,0:22:12.53,0:22:19.12,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.45,0:23:40.29,Default,,0,0,0,,～♪
Dialogue: 0,0:23:41.67,0:23:44.67,Default,,0,0,0,,А, жедім, жедім, енді үйге барып ұйықтайық.
Dialogue: 0,0:23:44.79,0:23:47.00,Default,,0,0,0,,Кола! Тиісті түрде хабарлаңыз, хаг.
Dialogue: 0,0:23:47.13,0:23:48.88,Default,,0,0,0,,О? Мен көмектесе алмаймын
Dialogue: 0,0:23:49.01,0:23:51.30,Default,,0,0,0,,Келесі жолы «Менің бала күнгі досым хаос жағдайында»
Dialogue: 0,0:23:51.51,0:23:54.64,Default,,0,0,0,,Бала кезден дос болу үшін ағаңыз ересек адам болуы керек.
Dialogue: 0,0:23:54.76,0:23:56.68,Default,,0,0,0,,Мен де бала кезден дос болғым келеді.
Dialogue: 0,0:23:56.81,0:23:58.93,Default,,0,0,0,,Сіз әлі белсенді және жассыз, солай ма?
Dialogue: 0,0:23:59.06,0:24:00.06,Default,,0,0,0,,тағы 5 жыл...
Dialogue: 0,0:24:00.18,0:24:02.73,Default,,0,0,0,,Бұл Кобато-чан сіздің бала кезден досыңыз деген сөз емес пе?
Dialogue: 0,0:24:02.98,0:24:05.86,Default,,0,0,0,,Мен нәжіс вампирінің менің бала күнгі досым болғанын қаламаймын.
Dialogue: 0,0:24:05.98,0:24:08.94,Default,,0,0,0,,Ол енді менің жауым болып қала береді.
Dialogue: 0,0:24:09.07,0:24:10.32,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:24:11.82,0:24:17.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
