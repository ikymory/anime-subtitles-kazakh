Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.66,0:00:03.67,Default,,0,0,0,,Жоғары мәртебелі, біз дайынбыз!
Dialogue: 0,0:00:03.67,0:00:06.50,Default,,0,0,0,,Мельфиера денесін тұрақтандыру үшін қатты ұстады.
Dialogue: 0,0:00:06.50,0:00:09.00,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:00:09.00,0:00:11.51,Default,,0,0,0,,Қашықтық шамамен 400 форна!
Dialogue: 0,0:00:11.51,0:00:14.01,Default,,0,0,0,,Дайынсың ба? иә!
Dialogue: 0,0:00:17.14,0:00:19.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:19.14,0:00:21.14,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:00:22.31,0:00:24.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:28.15,0:00:30.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:31.32,0:00:34.16,Default,,0,0,0,,<Бұл... Соқтығыс~! ＞
Dialogue: 0,0:00:36.32,0:00:38.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:38.33,0:00:41.54,Default,,0,0,0,,<Егер бұлай жалғаса берсе, мен айқайлаймын>
Dialogue: 0,0:00:41.54,0:00:44.33,Default,,0,0,0,,<Басқа нәрсе туралы ойлан>
Dialogue: 0,0:00:44.33,0:00:46.71,Default,,0,0,0,,<Иә! Бұл дұрыс! ＞
Dialogue: 0,0:00:48.04,0:00:51.34,Default,,0,0,0,,<Сол Бергенион атты жын-құс жыртқыш сияқты.>
Dialogue: 0,0:00:51.34,0:00:54.18,Default,,0,0,0,,<Қызық, бұл дәмді сорпа сорпасын жасайды ма? ＞
Dialogue: 0,0:00:54.18,0:00:56.18,Default,,0,0,0,,<Мені де еттің қаттылығы алаңдатады>
Dialogue: 0,0:00:56.18,0:01:01.35,Default,,0,0,0,,<Шөптермен толтырылған немесе кастрюльде буға пісірілген қуырылған тауық еті де жақсы болуы мүмкін>
Dialogue: 0,0:01:01.35,0:01:04.56,Default,,0,0,0,,<Бөлшектерге кесіп, қуырыңыз>
Dialogue: 0,0:01:04.56,0:01:07.35,Default,,0,0,0,,<Тұзбен қуырылғанда дәмді көрінеді>
Dialogue: 0,0:01:07.35,0:01:09.36,Default,,0,0,0,,(Бергенионның айқайы)
Dialogue: 0,0:01:10.36,0:01:12.36,Default,,0,0,0,,(Бергенион жылайды)
Dialogue: 0,0:01:12.36,0:01:16.36,Default,,0,0,0,,<Олардың да біз туралы ойлайтынына сенімдімін>
Dialogue: 0,0:01:16.36,0:01:19.07,Default,,0,0,0,,<Маған бұл ұнамайды! ＞
Dialogue: 0,0:01:19.07,0:01:21.08,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:52.67,0:02:55.84,Default,,0,0,0,,Мырза, олар менің артымнан әлі жүр.
Dialogue: 0,0:02:58.01,0:03:00.18,Default,,0,0,0,,Қарғыс атсын... бұл табанды
Dialogue: 0,0:03:00.18,0:03:02.68,Default,,0,0,0,,Зефф Мен екілендім... Ах!
Dialogue: 0,0:03:04.68,0:03:08.02,Default,,0,0,0,,Жоқ, жоқ, шабуылға жол бер!
Dialogue: 0,0:03:08.02,0:03:10.69,Default,,0,0,0,,Олардан құтыл! сізді түсіндім!
Dialogue: 0,0:03:11.85,0:03:13.86,Default,,0,0,0,,(Бергенион жылайды)
Dialogue: 0,0:03:15.69,0:03:19.19,Default,,0,0,0,,Мулан, қолдау алыңыз! иә!
Dialogue: 0,0:03:19.19,0:03:21.32,Default,,0,0,0,,Кешіріңіз, бірақ мен тездетемін.
Dialogue: 0,0:03:21.32,0:03:24.87,Default,,0,0,0,,... Иә, мен туралы болса да бәрібір.
Dialogue: 0,0:03:27.04,0:03:31.04,Default,,0,0,0,,<Ах, герцогтың сиқырлы күші кеңейді>
Dialogue: 0,0:03:33.04,0:03:35.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:35.71,0:03:39.34,Default,,0,0,0,,<Жел салқын, ауырады>
Dialogue: 0,0:03:39.34,0:03:44.51,Default,,0,0,0,,<Жылдамдауға басымдық беру үшін суық ауаны бөгейтін сиқыр бұзылды.>
Dialogue: 0,0:03:44.51,0:03:46.51,Default,,0,0,0,,(Бергеньон жылайды)
Dialogue: 0,0:03:48.06,0:03:52.52,Default,,0,0,0,,Тақсыр, бұл жылдамдық пен қашықтықта дәлдік...
Dialogue: 0,0:03:52.52,0:03:54.73,Default,,0,0,0,,Бұл мен дұрыс тапқан сан.
Dialogue: 0,0:03:54.73,0:03:56.90,Default,,0,0,0,,Солай болса да, олар
Dialogue: 0,0:03:56.90,0:04:00.07,Default,,0,0,0,,Неге сонша табанды түрде артымнан келе жатырсың?
Dialogue: 0,0:04:00.07,0:04:02.07,Default,,0,0,0,,Бұл жігіттер біртүрлі екен!
Dialogue: 0,0:04:02.07,0:04:06.08,Default,,0,0,0,,Мырза, жақын жердегі қамалға түсіп, оларға шабуыл жасайық.
Dialogue: 0,0:04:06.08,0:04:09.75,Default,,0,0,0,,Фортта түсініксіз, сондықтан баратын болсаңыз, қорғаныс шебіне өтіңіз.
Dialogue: 0,0:04:09.75,0:04:13.92,Default,,0,0,0,,<Сіздің маған жол бермеу ниетіңіздің себебі мен осында болуым мүмкін.>
Dialogue: 0,0:04:13.92,0:04:18.92,Default,,0,0,0,,<Шынында, герцог қашып қана қоймай, шабуылға шығуы керек.>
Dialogue: 0,0:04:18.92,0:04:23.38,Default,,0,0,0,,<Бірақ айдаһарда мен және менің жүгім бар...>
Dialogue: 0,0:04:23.38,0:04:27.26,Default,,0,0,0,,<Пайдалы болудан алыс, бұл сөзбе-сөз жүк! ＞
Dialogue: 0,0:04:27.26,0:04:29.26,Default,,0,0,0,,<Иә! ＞
Dialogue: 0,0:04:29.26,0:04:33.77,Default,,0,0,0,,<Сөмкеде мөр бар, егер сіз оны күштеп ашсаңыз, жарылып кетеді.>
Dialogue: 0,0:04:33.77,0:04:36.77,Default,,0,0,0,,<Егер сіз оны Бергенионға түсірсеңіз, ол алдамшы болады...>
Dialogue: 0,0:04:38.57,0:04:43.28,Default,,0,0,0,,Герцог, менің жүктерімді оларға лақтырайық!
Dialogue: 0,0:04:43.28,0:04:45.78,Default,,0,0,0,,Жоқ... бұл жақсы емес.
Dialogue: 0,0:04:45.78,0:04:47.95,Default,,0,0,0,,Сөмкеге жағылған... Та!
Dialogue: 0,0:04:47.95,0:04:51.12,Default,,0,0,0,,Сөйлеме Мелфи Егер үйренбесең, тіліңді тістейсің.
Dialogue: 0,0:04:51.12,0:04:53.79,Default,,0,0,0,,қапқа қолданылады
Dialogue: 0,0:04:53.79,0:04:57.13,Default,,0,0,0,,Мөрмен шабуыл
Dialogue: 0,0:04:57.13,0:05:00.80,Default,,0,0,0,,Бұл мөр ме? Жоқ, бірақ...
Dialogue: 0,0:05:00.80,0:05:02.97,Default,,0,0,0,,Егер жоқ болса, осында
Dialogue: 0,0:05:02.97,0:05:06.43,Default,,0,0,0,,Менің көңілімді қалдырыңыз
Dialogue: 0,0:05:06.43,0:05:09.30,Default,,0,0,0,,Бұл мүмкін емес! Сонда мен сені қорғай алмаймын
Dialogue: 0,0:05:09.30,0:05:11.60,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:13.31,0:05:16.98,Default,,0,0,0,,Қорғаныс шебіне шықсаңыз, рыцарьлар күтіп тұрады.
Dialogue: 0,0:05:18.31,0:05:21.44,Default,,0,0,0,,Сәл ұстаңыз.
Dialogue: 0,0:05:23.15,0:05:27.99,Default,,0,0,0,,＜Осындай кезде де сен мені жұбату үшін мейіріммен күлесің...＞
Dialogue: 0,0:05:27.99,0:05:30.62,Default,,0,0,0,,<Тіпті сиқырлы күштің де шегі бар>
Dialogue: 0,0:05:30.62,0:05:34.16,Default,,0,0,0,,<Мен де көмектескім келеді>
Dialogue: 0,0:05:35.46,0:05:37.83,Default,,0,0,0,,<Ойлан, Мельфиера>
Dialogue: 0,0:05:37.83,0:05:39.84,Default,,0,0,0,,<Ағымдағы жағдайдан шығу шаралары>
Dialogue: 0,0:05:43.34,0:05:48.47,Default,,0,0,0,,<Нысана қозғалатындықтан, сиқырлы шеңбер сызылған қағазды жапсыру қиын.>
Dialogue: 0,0:05:48.47,0:05:51.47,Default,,0,0,0,,<Мен шабуылдау сиқыры туралы көп білмеймін>
Dialogue: 0,0:05:51.47,0:05:54.18,Default,,0,0,0,,<басқа нәрсе...>
Dialogue: 0,0:05:54.18,0:05:56.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:57.19,0:06:02.02,Default,,0,0,0,,<Бұлтты кристал! Өйткені, бұл сиқырлы қуатты сорудың жалғыз жолы...>
Dialogue: 0,0:06:02.02,0:06:07.20,Default,,0,0,0,,<Ішінде бірдеңе бар! Көк... Ханастың қаны мен сиқыры! ＞
Dialogue: 0,0:06:07.20,0:06:11.20,Default,,0,0,0,,<Менің ақымақ! Осымен мен тіпті ештеңе шеге алмаймын >
Dialogue: 0,0:06:12.49,0:06:16.50,Default,,0,0,0,,《Қалай пайдаланғаныңызға байланысты ол елді жойып жіберетін қаруға айналуы мүмкін》
Dialogue: 0,0:06:16.50,0:06:20.38,Default,,0,0,0,,<Оны лақтырғанда көп күш болмайды.>
Dialogue: 0,0:06:20.38,0:06:22.67,Default,,0,0,0,,<Ал жаулар көп>
Dialogue: 0,0:06:22.67,0:06:26.05,Default,,0,0,0,,<Осы ғана жеткіліксіз...>
Dialogue: 0,0:06:26.05,0:06:30.05,Default,,0,0,0,,<Олай болса, герцогтың маған көрсеткен от сиқыры ше? ＞
Dialogue: 0,0:06:30.72,0:06:35.02,Default,,0,0,0,,<Мұны пайдалансаңыз, өзіңіздің сиқырлы күшіңізді сақтай аласыз>
Dialogue: 0,0:06:35.02,0:06:37.39,Default,,0,0,0,,<Жарайды>
Dialogue: 0,0:06:37.39,0:06:39.39,Default,,0,0,0,,< Міне! ＞
Dialogue: 0,0:06:39.39,0:06:41.90,Default,,0,0,0,,Тс!
Dialogue: 0,0:06:41.90,0:06:45.40,Default,,0,0,0,,Мырза, олардың бас тартуға ниеті жоқ сияқты.
Dialogue: 0,0:06:45.40,0:06:47.74,Default,,0,0,0,,Ахахаха! Қандай қызық.
Dialogue: 0,0:06:47.74,0:06:49.91,Default,,0,0,0,,<Өрт пен жалын? ＞
Dialogue: 0,0:06:49.91,0:06:53.74,Default,,0,0,0,,<Өрт емес, лаулаған от сияқты ма? Қатты ыстық па? ＞
Dialogue: 0,0:06:53.74,0:06:56.75,Default,,0,0,0,,<Бірдеңе жарылып кететін сияқты>
Dialogue: 0,0:06:56.75,0:07:00.92,Default,,0,0,0,,<Жарайды, ойыңызға келген кез келген ежелгі сиқырды салыңыз.>
Dialogue: 0,0:07:00.92,0:07:03.75,Default,,0,0,0,,<Оны қалай болса да сиқырлы шеңберге айналдыр>
Dialogue: 0,0:07:03.75,0:07:07.92,Default,,0,0,0,,<Герцогтың атын жазсаңыз болғаны... Ах...>
Dialogue: 0,0:07:07.92,0:07:10.05,Default,,0,0,0,,<Герцогтың аты...>
Dialogue: 0,0:07:10.05,0:07:12.59,Default,,0,0,0,,<Аристид Аристид...>
Dialogue: 0,0:07:12.59,0:07:14.60,Default,,0,0,0,,<Ах, осындай уақытта! ＞
Dialogue: 0,0:07:14.60,0:07:18.93,Default,,0,0,0,,<Ең бастысы, сіздің ресми атыңыз көрсетілмейді! Идиот! ＞
Dialogue: 0,0:07:19.94,0:07:23.94,Default,,0,0,0,,Герцог, атыңызды айтыңызшы! Жоқ... аты?
Dialogue: 0,0:07:23.94,0:07:26.23,Default,,0,0,0,,Аристидтің қасында!
Dialogue: 0,0:07:26.23,0:07:31.45,Default,,0,0,0,,Аристид Роджер де Гэлбрейт, бірақ неге мұндай уақытта?
Dialogue: 0,0:07:31.45,0:07:34.95,Default,,0,0,0,,Егер сіз сиқырды қолдансаңыз, бұл Аристид Роджер ме?
Dialogue: 0,0:07:34.95,0:07:37.62,Default,,0,0,0,,Дұрыс, бірақ Мелфи?
Dialogue: 0,0:07:37.62,0:07:42.25,Default,,0,0,0,,<Егер сіз құюшының атын енгізсеңіз, сиқыр тұрақтырақ және дәлірек болады.>
Dialogue: 0,0:07:42.25,0:07:45.46,Default,,0,0,0,,<Отарды жою үшін...>
Dialogue: 0,0:07:45.46,0:07:47.46,Default,,0,0,0,,Жарайды, дайын!
Dialogue: 0,0:07:47.46,0:07:50.80,Default,,0,0,0,,Мен қан алғым келеді, бірақ бір жалау жеткілікті.
Dialogue: 0,0:07:50.80,0:07:55.10,Default,,0,0,0,,Енді, герцог, мына жерді жалай беріңіз. Кәне!
Dialogue: 0,0:07:56.47,0:08:00.10,Default,,0,0,0,,Бұл Ханастың сиқыры ма? иә
Dialogue: 0,0:08:00.10,0:08:03.10,Default,,0,0,0,,Ал мен ойыма келген барлық сиқырларды салдым.
Dialogue: 0,0:08:03.10,0:08:05.81,Default,,0,0,0,,Оны іске қосу үшін лақтырыңыз!
Dialogue: 0,0:08:06.98,0:08:11.82,Default,,0,0,0,,Поо... Ахахахахаха!
Dialogue: 0,0:08:11.82,0:08:14.66,Default,,0,0,0,,Жалындаған жалын Жалындаған жалын
Dialogue: 0,0:08:14.66,0:08:17.12,Default,,0,0,0,,Жарқыл, лаулаған от, күйдіргіш ыстық
Dialogue: 0,0:08:17.12,0:08:20.29,Default,,0,0,0,,Дауыл, жарылыс, атқылау?
Dialogue: 0,0:08:20.29,0:08:24.50,Default,,0,0,0,,Хехе... Не дейсің тағы...
Dialogue: 0,0:08:25.50,0:08:27.67,Default,,0,0,0,,Мұнда күт
Dialogue: 0,0:08:31.01,0:08:33.01,Default,,0,0,0,,Бұл... Герцог!
Dialogue: 0,0:08:33.01,0:08:36.30,Default,,0,0,0,,Алақаныңызды кесіп алсаңыз, қару ұстай алмайсыз.
Dialogue: 0,0:08:36.30,0:08:39.51,Default,,0,0,0,,Уайымдамаңыз, бұл жай ғана жұқа қабат.
Dialogue: 0,0:08:39.51,0:08:41.85,Default,,0,0,0,,Егер сіз оны қолдансаңыз, мен риза болар едім.
Dialogue: 0,0:08:48.32,0:08:50.69,Default,,0,0,0,,Сіз бұл туралы жаңа ғана ойладыңыз ба?
Dialogue: 0,0:08:52.69,0:08:55.32,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:56.32,0:08:58.87,Default,,0,0,0,,Герцог
Dialogue: 0,0:08:58.87,0:09:02.70,Default,,0,0,0,,Маған кейінірек қамқорлық жасауға рұқсат етіңіз.
Dialogue: 0,0:09:02.70,0:09:04.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:04.87,0:09:08.34,Default,,0,0,0,,Жарайды, мен оны бірден тазалаймын.
Dialogue: 0,0:09:09.71,0:09:12.05,Default,,0,0,0,,Мен жауапты боламын!
Dialogue: 0,0:09:12.05,0:09:15.88,Default,,0,0,0,,Саяхат бағыты аспанда!
Dialogue: 0,0:09:15.88,0:09:20.56,Default,,0,0,0,,Эмбри көш басында, Зефф сол жақта, Эрик оң жақта.
Dialogue: 0,0:09:20.56,0:09:25.35,Default,,0,0,0,,Сигнал бойынша жылдамдаңыз және көтеріліңіз! (Эмбри Зефф Эрик) Түсінікті!
Dialogue: 0,0:09:25.35,0:09:29.36,Default,,0,0,0,,Мулан, күте тұр. Мен саған қосыламын. Ха!
Dialogue: 0,0:09:32.36,0:09:35.20,Default,,0,0,0,,(Бергенион жылайды)
Dialogue: 0,0:09:35.20,0:09:38.20,Default,,0,0,0,,Мені күткеніңізге рахмет, Мәртебелі, Мюран!
Dialogue: 0,0:09:38.20,0:09:40.58,Default,,0,0,0,,Сіз алданып қаласыз.
Dialogue: 0,0:09:40.58,0:09:45.37,Default,,0,0,0,,Жеделдетуді жалғастырыңыз және олар арқылы түбіне дейін жүгіріңіз.
Dialogue: 0,0:09:45.37,0:09:47.58,Default,,0,0,0,,Әрине, мен бұған дайынмын!
Dialogue: 0,0:09:47.58,0:09:51.92,Default,,0,0,0,,Мен сонда өлсем не істеуім керек? Мен аман қалып, одан өтемін.
Dialogue: 0,0:09:51.92,0:09:53.92,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:53.92,0:09:57.22,Default,,0,0,0,,Мұны сіз топты мазалаған кезде пайдаланыңыз.
Dialogue: 0,0:09:57.22,0:10:00.93,Default,,0,0,0,,А... енді мен сол құсты қуырайын.
Dialogue: 0,0:10:00.93,0:10:03.60,Default,,0,0,0,,Жарып өткеннен кейін, табыннан мүмкіндігінше алыс болыңыз.
Dialogue: 0,0:10:03.60,0:10:06.23,Default,,0,0,0,,Бірден көтеріліңіз Иә!
Dialogue: 0,0:10:06.23,0:10:09.40,Default,,0,0,0,,үшін көтеріл! Тек тездетіңіз!
Dialogue: 0,0:10:09.40,0:10:11.77,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:10:11.77,0:10:13.78,Default,,0,0,0,,(Бергенион жылайды)
Dialogue: 0,0:10:13.78,0:10:16.11,Default,,0,0,0,,Жүр, Мюран! Ха!
Dialogue: 0,0:10:19.95,0:10:22.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:22.62,0:10:26.12,Default,,0,0,0,,Енді қарсы шабуылға шығу уақыты келді.
Dialogue: 0,0:10:26.12,0:10:29.12,Default,,0,0,0,,Ең дұрысы, біз айдаһар айдаһарларымызды сарқып тастадық.
Dialogue: 0,0:10:29.12,0:10:33.13,Default,,0,0,0,,Менің сүйікті күйеуімді қорқыттың!
Dialogue: 0,0:10:34.13,0:10:37.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:37.97,0:10:39.97,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:39.97,0:10:42.26,Default,,0,0,0,,Бұл құс тәрізді атмосфера!
Dialogue: 0,0:10:44.97,0:10:48.44,Default,,0,0,0,,А, жеп қой... иә.
Dialogue: 0,0:10:48.44,0:10:51.27,Default,,0,0,0,,Көзіңді жұм Мелфи, иә?
Dialogue: 0,0:10:51.27,0:10:53.98,Default,,0,0,0,,(Бергенион жылайды)
Dialogue: 0,0:10:53.98,0:10:57.44,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:10:57.44,0:10:59.45,Default,,0,0,0,,Қосымша…
Dialogue: 0,0:10:59.45,0:11:02.16,Default,,0,0,0,,Әлі алыс, иә?
Dialogue: 0,0:11:03.66,0:11:07.66,Default,,0,0,0,,Бұдан былай сиқырлы шеңберге салғанның бәрі жұмыс істейді.
Dialogue: 0,0:11:07.66,0:11:12.17,Default,,0,0,0,,А... бұл өтірік, солай ма? Өтінемін, өтірік екенін айтыңызшы
Dialogue: 0,0:11:12.17,0:11:16.00,Default,,0,0,0,,Хаха, менің күйеуім күткендей, иә?
Dialogue: 0,0:11:16.00,0:11:19.67,Default,,0,0,0,,Қуаныңыз, Гэлбрейт жақсы болады.
Dialogue: 0,0:11:19.67,0:11:22.47,Default,,0,0,0,,Уау... мен жай ғана...
Dialogue: 0,0:11:22.47,0:11:28.18,Default,,0,0,0,,Хаха Әдетте мұндай жағдайда сиқырлы шеңбер құра алмас едіңіз.
Dialogue: 0,0:11:28.18,0:11:30.19,Default,,0,0,0,,Ах... Мелфи
Dialogue: 0,0:11:30.19,0:11:33.02,Default,,0,0,0,,Бұл сен екеуміздің арамыздағы құпия.
Dialogue: 0,0:11:34.19,0:11:36.32,Default,,0,0,0,,Хахаха
Dialogue: 0,0:11:39.19,0:11:41.70,Default,,0,0,0,,Кел, кел!
Dialogue: 0,0:11:46.49,0:11:48.70,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:11:52.04,0:11:54.71,Default,,0,0,0,,Жоқ, бұл тым көп.
Dialogue: 0,0:11:54.71,0:11:57.71,Default,,0,0,0,,Ха ха жарылып кетті
Dialogue: 0,0:11:59.34,0:12:03.05,Default,,0,0,0,,Жоғары мәртебелі, сіз мұны өте керемет жасадыңыз.
Dialogue: 0,0:12:03.05,0:12:05.35,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:12:05.35,0:12:08.35,Default,,0,0,0,,Муллан мырза! Жарайсың
Dialogue: 0,0:12:08.35,0:12:10.52,Default,,0,0,0,,Иә, бұл жақын қоңырау болды.
Dialogue: 0,0:12:10.52,0:12:13.35,Default,,0,0,0,,Айтпақшы, сол жарылыс туралы... Уф.
Dialogue: 0,0:12:14.90,0:12:17.23,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:12:18.36,0:12:20.74,Default,,0,0,0,,<Бергенион>
Dialogue: 0,0:12:20.74,0:12:24.53,Default,,0,0,0,,<Қызу тым жоғары, сондықтан ол толығымен жанып кетуі мүмкін.>
Dialogue: 0,0:12:30.25,0:12:32.91,Default,,0,0,0,,Әй... Маңызды емес пе? Мелфи
Dialogue: 0,0:12:32.91,0:12:34.92,Default,,0,0,0,,Бұл... Жарайды.
Dialogue: 0,0:12:34.92,0:12:37.75,Default,,0,0,0,,Мм, одан да көп, герцог.
Dialogue: 0,0:12:37.75,0:12:40.76,Default,,0,0,0,,Мен сенбейтін нәрсе жасадым...
Dialogue: 0,0:12:40.76,0:12:45.09,Default,,0,0,0,,Сіз не айтасыз? Сіздің тез ойлануыңыздың арқасында мен құтқарылдым.
Dialogue: 0,0:12:46.26,0:12:49.26,Default,,0,0,0,,<Олай болады деп ойламаппын...>
Dialogue: 0,0:12:50.56,0:12:55.94,Default,,0,0,0,,<Осы уақытқа дейін мен тек құбыжықтардан ләззат алуға шоғырландым>
Dialogue: 0,0:12:55.94,0:12:58.11,Default,,0,0,0,,<Бұл жанама өнім>
Dialogue: 0,0:12:58.11,0:13:01.40,Default,,0,0,0,,<Мен ешқашан таза сиқырлы күшке мән бермегенмін>
Dialogue: 0,0:13:05.11,0:13:09.78,Default,,0,0,0,,<Бұл, әрине, елді жоюға қабілетті қару>
Dialogue: 0,0:13:09.78,0:13:12.79,Default,,0,0,0,,<Оны енді қалай түсінесің>
Dialogue: 0,0:13:13.96,0:13:16.79,Default,,0,0,0,,Герцог, иә?
Dialogue: 0,0:13:16.79,0:13:21.59,Default,,0,0,0,,Менің зерттеулерім тыйым салынған аймақта ма?
Dialogue: 0,0:13:24.13,0:13:26.97,Default,,0,0,0,,Бұл жерде ешкімге ештеңе деуге жол бермеңіз
Dialogue: 0,0:13:26.97,0:13:30.81,Default,,0,0,0,,Тек өзіңіздің зерттеуіңізбен көп жұмыс істеу керек.
Dialogue: 0,0:13:30.81,0:13:34.81,Default,,0,0,0,,Бірақ... ештеңе жай ғана қару ретінде қолданылмайды.
Dialogue: 0,0:13:34.81,0:13:37.44,Default,,0,0,0,,Бұлтты кристалда сақталған сиқырлы күш
Dialogue: 0,0:13:37.44,0:13:42.15,Default,,0,0,0,,Оны пешке отын ретінде бұрын ғана пайдаланыңыз.
Dialogue: 0,0:13:43.15,0:13:46.61,Default,,0,0,0,,Мен ештеңеге алаңдамаймын.
Dialogue: 0,0:13:46.61,0:13:51.83,Default,,0,0,0,,Жарайды. Егер сіз оны сол кездегідей күнделікті өмірде қолдансаңыз, ыңғайлы болуы мүмкін.
Dialogue: 0,0:13:51.83,0:13:54.33,Default,,0,0,0,,Алдымен оны Гэлбрейтпен сынап көруім керек пе?
Dialogue: 0,0:13:54.33,0:13:57.00,Default,,0,0,0,,Күнделікті өмір үшін? О
Dialogue: 0,0:13:58.00,0:14:02.46,Default,,0,0,0,,Пештегі өрт бастапқыда тұтану тастары мен сиқырды қажет етеді.
Dialogue: 0,0:14:02.46,0:14:04.84,Default,,0,0,0,,Ауыстыру мүмкін болуы мүмкін
Dialogue: 0,0:14:04.84,0:14:09.18,Default,,0,0,0,,Қыстың ұзақ, қараңғы түндерінде бізге жарық керек.
Dialogue: 0,0:14:09.18,0:14:11.35,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:14:11.35,0:14:14.47,Default,,0,0,0,,Мен оны асырап аламын деп айтқан жоқпын.
Dialogue: 0,0:14:14.47,0:14:20.19,Default,,0,0,0,,Егер біз сиқырлы күшті бөліп, оны кішкене бөліктерге пайдалансақ, бұл аумақ тұрғындарының өмірін жеңілдете ме?
Dialogue: 0,0:14:20.19,0:14:23.02,Default,,0,0,0,,Әрине, сізге ұнайтынына сенімдімін.
Dialogue: 0,0:14:23.02,0:14:25.65,Default,,0,0,0,,Не?
Dialogue: 0,0:14:25.65,0:14:29.86,Default,,0,0,0,,<Дұрыс, оны қару ретінде пайдаланудың қажеті жоқ>
Dialogue: 0,0:14:29.86,0:14:35.37,Default,,0,0,0,,<Оны тек адамдардың өмірін байыту және оларды бақытты ету үшін пайдаланыңыз>
Dialogue: 0,0:14:35.37,0:14:41.38,Default,,0,0,0,,<Маршалл Рейдінде менің зерттеулерім ешкімді қызықтырмады>
Dialogue: 0,0:14:41.38,0:14:47.38,Default,,0,0,0,,<Менде жиналған сиқырлы күшті жоюдан немесе оны табиғи түрде босатудан басқа амалым қалмады.>
Dialogue: 0,0:14:47.38,0:14:50.51,Default,,0,0,0,,<Ақыр соңында, құбыжықтарды жеген дұрыс, оларды пайдаланған дұрыс.>
Dialogue: 0,0:14:50.51,0:14:53.51,Default,,0,0,0,,<Бұл жақсы нәрселерге толы ресурс болды! ＞
Dialogue: 0,0:14:53.51,0:14:56.22,Default,,0,0,0,,Герцог, иә?
Dialogue: 0,0:14:56.22,0:15:00.23,Default,,0,0,0,,<Бұл адам менің хоббиім мен зерттеуімді жоққа шығарудан алыс>
Dialogue: 0,0:15:00.23,0:15:03.40,Default,,0,0,0,,<Осылайша Ол сізге жаңа жол көрсетеді>
Dialogue: 0,0:15:04.69,0:15:07.24,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:07.24,0:15:09.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:11.24,0:15:16.54,Default,,0,0,0,,Сіз не айтасыз? Сіздердің арқаларыңызда ешкім зардап шекпей, шабуылдан құтылдық.
Dialogue: 0,0:15:16.54,0:15:20.08,Default,,0,0,0,,Рахмет, Мелфи... Жоқ.
Dialogue: 0,0:15:20.08,0:15:23.54,Default,,0,0,0,,Сиқыр құюшының күшіне байланысты.
Dialogue: 0,0:15:23.54,0:15:28.92,Default,,0,0,0,,Бұл бұрмаланған сиқырлы шеңберді іске қоса алған Герцогтың күші болды...
Dialogue: 0,0:15:28.92,0:15:33.55,Default,,0,0,0,,Хахахаха Демек бұл екі адамның бірге жұмыс жасауының нәтижесі.
Dialogue: 0,0:15:33.55,0:15:36.56,Default,,0,0,0,,Менің жұбайым жақсы жұмыс істейді.
Dialogue: 0,0:15:36.56,0:15:41.10,Default,,0,0,0,,Мен оны келесі жолы қолдансам, кішірек нәрсені саламын.
Dialogue: 0,0:15:41.10,0:15:43.94,Default,,0,0,0,,О, бұл жақсы идея.
Dialogue: 0,0:15:43.94,0:15:48.74,Default,,0,0,0,,Онда сіз екеуміз құбыжықтарды аулауға бара аламыз!
Dialogue: 0,0:15:48.74,0:15:52.95,Default,,0,0,0,,《Сен екеуміз құбыжықтарды аулауға бара аламыз! 》
Dialogue: 0,0:15:52.95,0:15:57.12,Default,,0,0,0,,《Сенімен құбыжықтарды аулау үшін...》
Dialogue: 0,0:15:57.12,0:15:59.95,Default,,0,0,0,,《Сізбен...》
Dialogue: 0,0:16:03.79,0:16:06.25,Default,,0,0,0,,<Мен де! ＞
Dialogue: 0,0:16:08.09,0:16:11.63,Default,,0,0,0,,Мен... мен... сенімен аңға шыға аламын ба?
Dialogue: 0,0:16:11.63,0:16:13.64,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:13.64,0:16:17.64,Default,,0,0,0,,Орманда Гумбинер аралары ұяларын үлкейтіп жатқан шығар.
Dialogue: 0,0:16:17.64,0:16:21.27,Default,,0,0,0,,Сакерт жемісі көп ұзамай мезгілінде болады.
Dialogue: 0,0:16:21.27,0:16:24.10,Default,,0,0,0,,Бұл түрлердің барлығы Эльзениер орманының эндемигі, солай ма?
Dialogue: 0,0:16:24.10,0:16:27.48,Default,,0,0,0,,Құлақ арасы – бас бармақтай шаққанда шақпайтын сиқырлы жәндік.
Dialogue: 0,0:16:27.48,0:16:29.48,Default,,0,0,0,,Гүлдер мен жемістерден шырын жинау
Dialogue: 0,0:16:29.48,0:16:31.99,Default,,0,0,0,,Күзде оның ұясына хош иісті иіс шығады.
Dialogue: 0,0:16:31.99,0:16:33.99,Default,,0,0,0,,Мен оны кітаптан оқыдым!
Dialogue: 0,0:16:35.49,0:16:37.99,Default,,0,0,0,,Денсаулығымның қалпына келгенін көру өте жақсы.
Dialogue: 0,0:16:37.99,0:16:40.83,Default,,0,0,0,,Жоғары мәртебелі! Иә?
Dialogue: 0,0:16:40.83,0:16:44.83,Default,,0,0,0,,Бұрынғы жарылыс ~ болды! Сіз амансыз деп үміттенемін!
Dialogue: 0,0:16:44.83,0:16:47.00,Default,,0,0,0,,<Аа, болмайды...>
Dialogue: 0,0:16:54.30,0:16:57.14,Default,,0,0,0,,<Бұл...>
Dialogue: 0,0:16:57.14,0:17:00.01,Default,,0,0,0,,<Жалын қыраны! ＞
Dialogue: 0,0:17:00.01,0:17:02.14,Default,,0,0,0,,<Қандай әдемі! ＞
Dialogue: 0,0:17:02.14,0:17:06.15,Default,,0,0,0,,Сіз келдіңіз бе? Хаос, әлі ерте!
Dialogue: 0,0:17:06.15,0:17:09.32,Default,,0,0,0,,Мельфи екеуміз онымен айналыстық.
Dialogue: 0,0:17:09.32,0:17:12.03,Default,,0,0,0,,ше? Мельфиера-самамен бе?
Dialogue: 0,0:17:12.03,0:17:15.03,Default,,0,0,0,,А, бұл жарылыс сенің әрекетің болды ғой!?
Dialogue: 0,0:17:15.03,0:17:17.03,Default,,0,0,0,,Мелфиера ханым осында.
Dialogue: 0,0:17:17.03,0:17:22.16,Default,,0,0,0,,Неліктен мұндай абайсыз, шайтандық және аяусыз сиқырды қолдандың!
Dialogue: 0,0:17:22.16,0:17:26.17,Default,,0,0,0,,Бұл қызықты емес пе? Аа!?
Dialogue: 0,0:17:26.17,0:17:31.55,Default,,0,0,0,,<Ең абайсыз, шайтандық және аяусыз сиқырды кім салған>
Dialogue: 0,0:17:31.55,0:17:33.72,Default,,0,0,0,,<Бұл менмін>
Dialogue: 0,0:17:33.72,0:17:37.89,Default,,0,0,0,,Бұл Бергениондар тобы үшін әдеттен тыс болып көрінді.
Dialogue: 0,0:17:37.89,0:17:41.89,Default,,0,0,0,,Алайда Мельфиера-сама рыцарь емес.
Dialogue: 0,0:17:41.89,0:17:45.89,Default,,0,0,0,,Акселерация сиқыры сіздің денеңізге қатты әсер еткен болуы керек.
Dialogue: 0,0:17:45.89,0:17:48.73,Default,,0,0,0,,Шынымен де ешбір түзетусіз... Хм...
Dialogue: 0,0:17:48.73,0:17:54.07,Default,,0,0,0,,Аа, жоқ, мен саған бәрі жақсы дедім, сондықтан ол әлі де рас!
Dialogue: 0,0:17:55.07,0:17:59.07,Default,,0,0,0,,Мм, кешіріңіз, Хаос мырза, бірақ шын мәнінде бұл мен едім...
Dialogue: 0,0:17:59.07,0:18:01.74,Default,,0,0,0,,Немесе... әдемі! иә?
Dialogue: 0,0:18:01.74,0:18:06.58,Default,,0,0,0,,Бұл ұлы мәртебелі әйелі ме? Уау, бірдеңе жұмсақ.
Dialogue: 0,0:18:06.58,0:18:09.92,Default,,0,0,0,,Сіз істеп жатырсыз, Мәртебелі, мен қызғанамын~
Dialogue: 0,0:18:09.92,0:18:11.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:11.92,0:18:15.09,Default,,0,0,0,,＜Сұлу болу ұят＞
Dialogue: 0,0:18:15.09,0:18:18.76,Default,,0,0,0,,<Егер сіз оғаш болсаңыз, сізді осылай атайды.>
Dialogue: 0,0:18:18.76,0:18:22.60,Default,,0,0,0,,Балалар, қарамаңдар! Мелфи азаяды! (Рыцарлар) Иә!
Dialogue: 0,0:18:22.60,0:18:25.23,Default,,0,0,0,,Көрінетіндей жақсы! Ол азаймайды!
Dialogue: 0,0:18:25.23,0:18:29.23,Default,,0,0,0,,Маған көбірек көрсетіңізші! Мен үйде тыныш отырдым.
Dialogue: 0,0:18:29.23,0:18:32.40,Default,,0,0,0,,Иә, иә! О, өте шулы!
Dialogue: 0,0:18:32.40,0:18:37.11,Default,,0,0,0,,Иә, түсіндім! Қырағы топты артта қалдырып, қайтыңыз!
Dialogue: 0,0:18:41.78,0:18:45.41,Default,,0,0,0,,Герцог, сен осы жерде тұрасың ба?
Dialogue: 0,0:18:45.41,0:18:49.25,Default,,0,0,0,,Әй, орталықта көріп тұрғандарың менің ұям.
Dialogue: 0,0:18:49.25,0:18:51.79,Default,,0,0,0,,Үй ме, әлде қора ма?
Dialogue: 0,0:18:51.79,0:18:55.26,Default,,0,0,0,,Мәселе мынада, оның қажетсіз кеңдігі.
Dialogue: 0,0:18:55.26,0:18:57.63,Default,,0,0,0,,Өзіңізге ұнайтын кез келген бөлмені пайдаланыңыз
Dialogue: 0,0:18:57.63,0:19:00.64,Default,,0,0,0,,Бұл цитадель емес пе?
Dialogue: 0,0:19:00.64,0:19:04.14,Default,,0,0,0,,Бір елдің патша сарайы десе, түсінікті болар еді.
Dialogue: 0,0:19:04.14,0:19:06.14,Default,,0,0,0,,Сіз күткендей, Мелфи.
Dialogue: 0,0:19:06.14,0:19:09.44,Default,,0,0,0,,Баяғыда, көп ұрпақ бұрын, Герцог Гэлбрейт
Dialogue: 0,0:19:09.44,0:19:12.15,Default,,0,0,0,,Құбыжықтармен күресу үшін не салынған
Dialogue: 0,0:19:12.15,0:19:15.82,Default,,0,0,0,,Жылдар өте қала бүгінгідей болды.
Dialogue: 0,0:19:15.82,0:19:19.28,Default,,0,0,0,,Бұл біздің негізгі базамыз, Мидрег.
Dialogue: 0,0:19:19.28,0:19:21.82,Default,,0,0,0,,бекіністі қала деп те аталады.
Dialogue: 0,0:19:21.82,0:19:23.99,Default,,0,0,0,,Ортаңғы аяқ...
Dialogue: 0,0:19:25.29,0:19:27.66,Default,,0,0,0,,Бекіністі қала деген нені білдіреді?
Dialogue: 0,0:19:27.66,0:19:32.17,Default,,0,0,0,,Бұл жерге Эльзениер Ұлы орманынан құбыжықтар келе ме?
Dialogue: 0,0:19:32.17,0:19:34.29,Default,,0,0,0,,Ах, кейде
Dialogue: 0,0:19:35.67,0:19:41.47,Default,,0,0,0,,Шөптерде үй салатын құбыжықтар және сауда жолдарында жүретін арбаларды нысанаға алатын құбыжықтар бар.
Dialogue: 0,0:19:41.47,0:19:46.18,Default,,0,0,0,,Енді маған күнде қауіп төніп тұрғандай емес.
Dialogue: 0,0:19:46.18,0:19:48.18,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:19:48.18,0:19:50.85,Default,,0,0,0,,Оның құрылымы өте күшті.
Dialogue: 0,0:19:55.19,0:19:59.69,Default,,0,0,0,,<Маршалл рейдінде мұндай керемет қамал қабырғалары болған жоқ.>
Dialogue: 0,0:20:03.49,0:20:06.87,Default,,0,0,0,,Негізі мен қорғаныс сызығын сызғанша.
Dialogue: 0,0:20:06.87,0:20:11.04,Default,,0,0,0,,Үлкен Эльсенье орманы сәл жақынырақ болды.
Dialogue: 0,0:20:11.04,0:20:14.50,Default,,0,0,0,,Не? Өйткені кезекті герцогтар бұл жерді өздерінің базасы ретінде пайдаланды.
Dialogue: 0,0:20:14.50,0:20:17.05,Default,,0,0,0,,Адамдар табиғи түрде жинала бастады.
Dialogue: 0,0:20:17.05,0:20:22.72,Default,,0,0,0,,Бұл қаланы құбыжықтардың шабуылынан қорыққан адамдар қалпына келтірді.
Dialogue: 0,0:20:23.89,0:20:28.22,Default,,0,0,0,,Сонымен қатар, 17 жыл бұрын апаттан аман қалған адамдар.
Dialogue: 0,0:20:28.22,0:20:30.35,Default,,0,0,0,,Маған осында тұруға рұқсат етіңіз.
Dialogue: 0,0:20:33.06,0:20:35.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:35.06,0:20:37.73,Default,,0,0,0,,<Бұл сиқырдың белгісі ме? ＞
Dialogue: 0,0:20:37.73,0:20:41.24,Default,,0,0,0,,<Жер де кей жерде күйіп қалған>
Dialogue: 0,0:20:41.24,0:20:44.74,Default,,0,0,0,,<Герцог өз сиқырымен шекараны кеңейтетініне сенімдімін>
Dialogue: 0,0:20:44.74,0:20:47.53,Default,,0,0,0,,<Сіз қала тұрғындарын қорғадыңыз.>
Dialogue: 0,0:20:47.53,0:20:51.54,Default,,0,0,0,,Иә? Қазір онша емес дер едім.
Dialogue: 0,0:20:51.54,0:20:53.54,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:20:53.54,0:20:55.54,Default,,0,0,0,,Жоғары мәртебелі!
Dialogue: 0,0:20:55.54,0:20:58.92,Default,,0,0,0,,Құрметті Мелфиера, ұзақ жолдағы қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:20:58.92,0:21:03.09,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын. Иә, бәрі сіздің арқаңызда.
Dialogue: 0,0:21:03.09,0:21:05.55,Default,,0,0,0,,Эхехе...хехехе...
Dialogue: 0,0:21:05.55,0:21:07.55,Default,,0,0,0,,Біз қонуға барамыз.
Dialogue: 0,0:21:07.55,0:21:11.77,Default,,0,0,0,,Мулан! Батыстағы әскери қақпаны ашыңыз! Түсінді
Dialogue: 0,0:21:17.56,0:21:21.28,Default,,0,0,0,,Ал, мәртебелі мырза, мен сізді бас резиденцияда күтемін.
Dialogue: 0,0:21:21.28,0:21:25.57,Default,,0,0,0,,Аа, мен Мельфидің жүгісін саған қалдырамын. Күшті.
Dialogue: 0,0:21:31.79,0:21:35.42,Default,,0,0,0,,Дәл қазір аспанда сиқырлы тосқауыл тұр.
Dialogue: 0,0:21:35.42,0:21:37.42,Default,,0,0,0,,Төменгі қақпа арқылы кіріңіз.
Dialogue: 0,0:21:37.42,0:21:40.42,Default,,0,0,0,,Сиқырлы тосқауыл... а
Dialogue: 0,0:21:40.42,0:21:45.30,Default,,0,0,0,,Ол сиқырлы қуатты көп тұтынса да және оны әрқашан қолдану мүмкін емес.
Dialogue: 0,0:21:45.30,0:21:49.14,Default,,0,0,0,,Бергенионның ісі түскен сияқты.
Dialogue: 0,0:21:49.14,0:21:52.14,Default,,0,0,0,,Оның тағы да шабуыл жасау мүмкіндігі бар ма?
Dialogue: 0,0:21:52.14,0:21:56.98,Default,,0,0,0,,Мен бұл туралы білмеймін, бірақ бүгін сақ болған дұрыс.
Dialogue: 0,0:21:56.98,0:21:59.44,Default,,0,0,0,,Міне, келдік, Мелфи.
Dialogue: 0,0:22:13.83,0:22:15.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:28.63,0:22:30.85,Default,,0,0,0,,<Осында>
Dialogue: 0,0:22:32.18,0:22:35.18,Default,,0,0,0,,<Герцог қорғайтын қала>
Dialogue: 0,0:22:35.18,0:22:37.19,Default,,0,0,0,,<Мидрейг>
Dialogue: 0,0:22:40.86,0:22:58.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:59.87,0:23:05.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
