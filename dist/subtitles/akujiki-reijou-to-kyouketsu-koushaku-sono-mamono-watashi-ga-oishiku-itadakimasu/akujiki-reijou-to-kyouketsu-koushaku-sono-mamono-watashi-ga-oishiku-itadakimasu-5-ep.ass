Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.67,0:00:05.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:05.67,0:00:08.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:11.51,0:00:15.51,Default,,0,0,0,,Сіз жалғызсыз ба? сәл ғана
Dialogue: 0,0:00:15.51,0:00:19.52,Default,,0,0,0,,Бірақ мен болашақ өміріммен айналысамын.
Dialogue: 0,0:00:19.52,0:00:23.14,Default,,0,0,0,,Сіз бұрынғыдай өзіңіз бола аласыз.
Dialogue: 0,0:00:23.14,0:00:29.02,Default,,0,0,0,,Герцог Гэлбрейттің бірінші міндеті - күйеуін құрметтеу және емдеу.
Dialogue: 0,0:00:29.02,0:00:33.86,Default,,0,0,0,,Negirai Heal... Мен мұны істей аламын ба?
Dialogue: 0,0:00:33.86,0:00:35.87,Default,,0,0,0,,Хахаха
Dialogue: 0,0:00:35.87,0:00:39.87,Default,,0,0,0,,Ештеңе етпейді, мен әлі емделдім.
Dialogue: 0,0:00:39.87,0:00:42.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:42.54,0:00:46.71,Default,,0,0,0,,Сондай-ақ, сізден құбыжықтар туралы есту қызық.
Dialogue: 0,0:00:46.71,0:00:49.71,Default,,0,0,0,,Гэлбрейтте сіз өзіңізді қалағаныңызша зерттеуге арнай аласыз.
Dialogue: 0,0:00:49.71,0:00:51.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:51.71,0:00:54.18,Default,,0,0,0,,Мен құбыжықтарды аулаймын.
Dialogue: 0,0:00:54.18,0:00:59.05,Default,,0,0,0,,Роя Мудраның етін жегендер басқа рыцарьларға хабар таратады.
Dialogue: 0,0:00:59.05,0:01:03.06,Default,,0,0,0,,Ах! Барлығы менің оны басқа құбыжықтармен сынап көргенімді қалайды.
Dialogue: 0,0:01:03.06,0:01:05.06,Default,,0,0,0,,Мен тағатсыздана күтіп отырмын.
Dialogue: 0,0:01:06.19,0:01:09.19,Default,,0,0,0,,Мен оны асыға күтемін! Менің ойымша, солай
Dialogue: 0,0:01:10.90,0:01:15.07,Default,,0,0,0,,<Герцог шын мәнінде қамқор адам.>
Dialogue: 0,0:01:19.07,0:01:21.08,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:50.83,0:02:55.84,Default,,0,0,0,,Уау, герцог, әлем қызылға боялған!
Dialogue: 0,0:02:55.84,0:02:59.68,Default,,0,0,0,,Әдемі екен, шаштың түсі сияқты.
Dialogue: 0,0:02:59.68,0:03:03.47,Default,,0,0,0,,Мен... менің шашым онша әдемі емес.
Dialogue: 0,0:03:03.47,0:03:05.47,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:03:05.47,0:03:12.19,Default,,0,0,0,,Сіз сиқырлы шеңберді іске қосқанда шашыңыз осылай жарқырап тұрды.
Dialogue: 0,0:03:12.19,0:03:15.48,Default,,0,0,0,,Мен жай ғана таң қалдым.
Dialogue: 0,0:03:15.48,0:03:18.19,Default,,0,0,0,,Өте әдемі, иә!?
Dialogue: 0,0:03:18.19,0:03:22.20,Default,,0,0,0,,<Мен шашымды ұстауға қарсы емеспін, бірақ бұл ұят.>
Dialogue: 0,0:03:23.20,0:03:27.87,Default,,0,0,0,,<Осындай ұялшақ болу дұрыс па? Мен＞
Dialogue: 0,0:03:33.04,0:03:35.34,Default,,0,0,0,,Жақсы, сүйкімді.
Dialogue: 0,0:03:35.34,0:03:39.05,Default,,0,0,0,,Бұл бір-бірінің орналасқан жерін растау үшін.
Dialogue: 0,0:03:39.05,0:03:45.05,Default,,0,0,0,,<Төменнен жоғары қарасаңыз, бұл жарық та жұлдыздай жарқырай ма? ＞
Dialogue: 0,0:03:45.05,0:03:51.52,Default,,0,0,0,,<Мүмкін бұл жарықты көрген адамдар оны ағып жатқан жұлдыз деп қателесуі мүмкін>
Dialogue: 0,0:03:51.52,0:03:53.52,Default,,0,0,0,,<Айдаһардың атқан жұлдызы>
Dialogue: 0,0:03:53.52,0:03:57.23,Default,,0,0,0,,<Иә, армандау қандай жақсы>
Dialogue: 0,0:04:04.07,0:04:06.91,Default,,0,0,0,,Сіз қайда тұруды жоспарлап отырсыз? Бұл қала ма?
Dialogue: 0,0:04:06.91,0:04:11.25,Default,,0,0,0,,Иә? Бұл Авенир, патша территориясындағы порт қаласы.
Dialogue: 0,0:04:11.25,0:04:14.54,Default,,0,0,0,,Біздің көздегеніміз шекарадағы Риттеруд бекінісі.
Dialogue: 0,0:04:14.54,0:04:18.25,Default,,0,0,0,,Бұл қамал ма? Ой, уайымдама
Dialogue: 0,0:04:18.25,0:04:21.38,Default,,0,0,0,,Мен қаладан баспана тауып беремін, сонда түнейсің...
Dialogue: 0,0:04:21.38,0:04:24.39,Default,,0,0,0,,Сіздің аумақта орман немесе өзен бар ма?
Dialogue: 0,0:04:24.39,0:04:27.93,Default,,0,0,0,,Ертең кешкі асқа немесе таңғы асқа ашық аспан астына пісіру болады ма?
Dialogue: 0,0:04:27.93,0:04:29.93,Default,,0,0,0,,А, ә, ә?
Dialogue: 0,0:04:29.93,0:04:35.27,Default,,0,0,0,,Риттеруд өзен жағасында, бірақ қамалда қалуды жек көрмейсің бе?
Dialogue: 0,0:04:35.27,0:04:38.11,Default,,0,0,0,,Мен қатты толқып тұрмын!
Dialogue: 0,0:04:38.11,0:04:43.11,Default,,0,0,0,,Бұл аз уақытты алады және айдаһарларға тамақ алу оңайырақ.
Dialogue: 0,0:04:43.11,0:04:45.41,Default,,0,0,0,,Хмм, бұл рас...
Dialogue: 0,0:04:45.41,0:04:48.95,Default,,0,0,0,,Бұл сізге ұйықтайтын орын береді.
Dialogue: 0,0:04:48.95,0:04:52.96,Default,,0,0,0,,Сізде бар жалғыз тағам - портативті рацион. Қалада жақсырақсың...
Dialogue: 0,0:04:52.96,0:04:57.13,Default,,0,0,0,,Мен туралы болса жақсы, бірақ...
Dialogue: 0,0:04:58.13,0:05:03.13,Default,,0,0,0,,Осы маусымда жын балықтары да уылдырық шашу маусымына байланысты семіреді.
Dialogue: 0,0:05:03.13,0:05:08.14,Default,,0,0,0,,Сонымен қатар, егер сіз орманға барсаңыз, сиқырлы ағаш жемісі сияқты заттарды ала алмайсыз ба?
Dialogue: 0,0:05:08.14,0:05:12.60,Default,,0,0,0,,Егер мен материалдардан немесе суретті кітаптардан ғана көрген құбыжықтың түрі болса.
Dialogue: 0,0:05:12.60,0:05:14.81,Default,,0,0,0,,Мен оны шынымен қолданғым келеді!
Dialogue: 0,0:05:14.81,0:05:17.98,Default,,0,0,0,,Поо... Ахахахаха!
Dialogue: 0,0:05:17.98,0:05:20.32,Default,,0,0,0,,Түсіндім, бұл жын балық!
Dialogue: 0,0:05:20.32,0:05:24.32,Default,,0,0,0,,Жылдың осы уақытында Xanas болуы керек. Xanas!
Dialogue: 0,0:05:24.32,0:05:27.32,Default,,0,0,0,,Xanas - Marshall Raid-те кездеспейтін түрі.
Dialogue: 0,0:05:27.32,0:05:30.45,Default,,0,0,0,,Егер мен оны ұстап алсам, мен оны жегім келеді!
Dialogue: 0,0:05:30.45,0:05:34.46,Default,,0,0,0,,Бірақ біз тұзақ құрып, оны алуымыз керек.
Dialogue: 0,0:05:34.46,0:05:37.46,Default,,0,0,0,,А... Түсіндім.
Dialogue: 0,0:05:37.46,0:05:40.17,Default,,0,0,0,,Тұзақтар уақытты алады.
Dialogue: 0,0:05:40.17,0:05:43.34,Default,,0,0,0,,Аа... бұлай күйзелме.
Dialogue: 0,0:05:43.34,0:05:46.34,Default,,0,0,0,,Жылдың осы мезгілінде бір түн қажет болуы мүмкін.
Dialogue: 0,0:05:46.34,0:05:50.18,Default,,0,0,0,,Бүгін түнде тұзақ құрып, ертең таңертең оны көруге барыңыз.
Dialogue: 0,0:05:50.18,0:05:54.02,Default,,0,0,0,,Сіз...сіз бе? Ой...
Dialogue: 0,0:05:54.02,0:05:56.19,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:05:59.86,0:06:02.19,Default,,0,0,0,,Нашар дайындалған тасымалданатын рациондардан
Dialogue: 0,0:06:02.19,0:06:07.03,Default,,0,0,0,,Жаңа піскен, жаңа дайындалған, ыстық тамақ жақсырақ.
Dialogue: 0,0:06:07.03,0:06:10.49,Default,,0,0,0,,Мен ертеңгі таңғы асты асыға күтемін. Иә.
Dialogue: 0,0:06:15.87,0:06:19.88,Default,,0,0,0,,<Герцог осындай кезде де мейірімді>
Dialogue: 0,0:06:19.88,0:06:25.17,Default,,0,0,0,,<Сіз мен үшін өзіңізді мәжбүрлейтін шығарсыз деп алаңдаймын.>
Dialogue: 0,0:06:25.17,0:06:28.18,Default,,0,0,0,,<Енді ойлап қарасам, Хаос мырза бұрын...>
Dialogue: 0,0:06:28.18,0:06:31.01,Default,,0,0,0,,《Мельфиера, менің рыцарларым》
Dialogue: 0,0:06:31.01,0:06:35.02,Default,,0,0,0,,《Мен қорқынышты құбыжықтың етін ғана жедім.》
Dialogue: 0,0:06:35.02,0:06:37.18,Default,,0,0,0,,Мм... герцог...
Dialogue: 0,0:06:37.18,0:06:40.40,Default,,0,0,0,,Сізді өлтірген жын жеп көрді ме?
Dialogue: 0,0:06:40.40,0:06:45.03,Default,,0,0,0,,Уф... Мен мұны аспаздық деп атауға болатынын білмеймін.
Dialogue: 0,0:06:45.03,0:06:48.03,Default,,0,0,0,,Өте... өте?
Dialogue: 0,0:06:48.03,0:06:52.20,Default,,0,0,0,,Бұл қатты және иіс болды.
Dialogue: 0,0:06:52.20,0:06:56.75,Default,,0,0,0,,Ұзақ бағынышты кезімде аштыққа шыдай алмай, жедім.
Dialogue: 0,0:06:56.75,0:07:00.04,Default,,0,0,0,,Ішім ауырып қала ма деп қорқып жақсы пісірдім.
Dialogue: 0,0:07:00.04,0:07:03.75,Default,,0,0,0,,Соңында бәрі ренжіді.
Dialogue: 0,0:07:03.75,0:07:07.21,Default,,0,0,0,,<Осылайша сен сиқырыңды сарқпай жеп қойдың>
Dialogue: 0,0:07:07.21,0:07:10.05,Default,,0,0,0,,Бұл қандай құбыжық екенін сұрасам бола ма?
Dialogue: 0,0:07:10.05,0:07:13.22,Default,,0,0,0,,Ең қиыны Белвер болды.
Dialogue: 0,0:07:13.22,0:07:15.93,Default,,0,0,0,,《(Белвердің айқайы)》
Dialogue: 0,0:07:15.93,0:07:21.23,Default,,0,0,0,,Олардың бәрі жағымсыз иіс шығарды, бірақ ең жаманы Скримвуд болды.
Dialogue: 0,0:07:22.94,0:07:26.44,Default,,0,0,0,,Тамақтанбаған адам Гаргант болды.
Dialogue: 0,0:07:26.44,0:07:30.24,Default,,0,0,0,,Бұл ешқашан тамақ бола алмайды!
Dialogue: 0,0:07:31.24,0:07:35.08,Default,,0,0,0,,Жалындаған жалын мен тасқа оранған құбыжық сияқты.
Dialogue: 0,0:07:35.08,0:07:37.45,Default,,0,0,0,,Мазмұны лай болды, бірақ
Dialogue: 0,0:07:37.45,0:07:42.08,Default,,0,0,0,,Мен мұның барлығын аштыққа шыдамағаным үшін шынымен ішіп қойдым ба?
Dialogue: 0,0:07:42.08,0:07:44.25,Default,,0,0,0,,Мүлдем есімде жоқ
Dialogue: 0,0:07:46.96,0:07:48.96,Default,,0,0,0,,Біз жақындап қалдық
Dialogue: 0,0:07:48.96,0:07:51.63,Default,,0,0,0,,Айдаһарды тастаңыз Ах иә
Dialogue: 0,0:07:51.63,0:07:55.64,Default,,0,0,0,,Мельфиера Мен бекініске түскенше мені ұстаңыз.
Dialogue: 0,0:07:55.64,0:07:58.27,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:07:58.27,0:08:00.48,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:13.82,0:08:16.99,Default,,0,0,0,,Бұл... иә
Dialogue: 0,0:08:16.99,0:08:19.29,Default,,0,0,0,,Бұрынғы қалпында тұрған дұрыс па?
Dialogue: 0,0:08:19.29,0:08:23.12,Default,,0,0,0,,Айтпақшы... Жоғары мәртебелі қонағы да бізбен бірге.
Dialogue: 0,0:08:23.12,0:08:25.13,Default,,0,0,0,,Жоғары мәртебелі қонақ?
Dialogue: 0,0:08:25.13,0:08:27.67,Default,,0,0,0,,Қалай қарасаң да, әйел!
Dialogue: 0,0:08:27.67,0:08:31.51,Default,,0,0,0,,Мен қамалдың бүкіл батыс жағын жалға аламын, сондықтан сіздердің назарларыңызды сұраймын.
Dialogue: 0,0:08:31.51,0:08:35.68,Default,,0,0,0,,Бұл туралы ештеңе жоқ.
Dialogue: 0,0:08:35.68,0:08:38.85,Default,,0,0,0,,<Маған сәнді ештеңе керек емес...>
Dialogue: 0,0:08:38.85,0:08:42.31,Default,,0,0,0,,＜Мен сізді қандай да бір себептермен уайымдатқан сияқтымын＞
Dialogue: 0,0:08:42.31,0:08:46.69,Default,,0,0,0,,Мельфиера Алдымен керекті жүкті шешіп алайық.
Dialogue: 0,0:08:46.69,0:08:49.15,Default,,0,0,0,,А... Түсіндім.
Dialogue: 0,0:08:55.03,0:08:57.53,Default,,0,0,0,,Мелфиера Иә?
Dialogue: 0,0:08:57.53,0:09:00.16,Default,,0,0,0,,Ақыр соңында, қазір қалаға барайық.
Dialogue: 0,0:09:00.16,0:09:02.16,Default,,0,0,0,,Бұл туралы ойлаудың қажеті жоқ
Dialogue: 0,0:09:02.16,0:09:06.54,Default,,0,0,0,,Мен әйелді осылай қамалда ұйықтатпақ болдым. Маған бірдеңе дұрыс болмады.
Dialogue: 0,0:09:06.54,0:09:09.04,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:09:09.04,0:09:13.34,Default,,0,0,0,,Бұл бекіністің атмосферасы біршама зерттеу ғимаратына ұқсайды.
Dialogue: 0,0:09:13.34,0:09:17.18,Default,,0,0,0,,Еденде ұйықтап қалу қалыпты жағдай!
Dialogue: 0,0:09:17.18,0:09:19.89,Default,,0,0,0,,Бұл қалыпты жағдай емес пе...
Dialogue: 0,0:09:19.89,0:09:25.89,Default,,0,0,0,,Герцог осында болғандықтан, қорқатын ештеңе жоқ!
Dialogue: 0,0:09:25.89,0:09:30.19,Default,,0,0,0,,Ха! Хм... Иә?
Dialogue: 0,0:09:30.19,0:09:32.19,Default,,0,0,0,,(есік ашылады)
Dialogue: 0,0:09:32.19,0:09:35.57,Default,,0,0,0,,Бүгін түнде бұл сіздің бөлмеңіз.
Dialogue: 0,0:09:35.57,0:09:39.07,Default,,0,0,0,,Сіз шаршаған болуыңыз керек. Біраз демалу керек.
Dialogue: 0,0:09:39.07,0:09:44.20,Default,,0,0,0,,Жоқ, герцогтың сиқырының арқасында ұшу ыңғайлы болды.
Dialogue: 0,0:09:46.21,0:09:48.21,Default,,0,0,0,,<Бұл! ＞
Dialogue: 0,0:09:48.21,0:09:51.09,Default,,0,0,0,,Не болды? Мельфиера
Dialogue: 0,0:09:51.09,0:09:55.76,Default,,0,0,0,,Бұл... Герцог, бұл қиын! Бұл иіс...
Dialogue: 0,0:10:00.76,0:10:03.22,Default,,0,0,0,,Бұл иіс күткендей... (Мюран Зефф) Иә?
Dialogue: 0,0:10:03.22,0:10:05.60,Default,,0,0,0,,Бұл астық ботқасы ма?
Dialogue: 0,0:10:05.60,0:10:07.60,Default,,0,0,0,,Леди Мелфиера?
Dialogue: 0,0:10:07.60,0:10:10.40,Default,,0,0,0,,Бұл... Ондай жерге кіруге болмайды.
Dialogue: 0,0:10:10.40,0:10:12.77,Default,,0,0,0,,Герцогтың рұқсаты алынды.
Dialogue: 0,0:10:12.77,0:10:16.78,Default,,0,0,0,,Оның үстіне мына жарма ботқасы ғана қарныңызды аштыратын шығар, солай ма?
Dialogue: 0,0:10:16.78,0:10:19.24,Default,,0,0,0,,А... иә...
Dialogue: 0,0:10:20.41,0:10:22.62,Default,,0,0,0,,А... сонда
Dialogue: 0,0:10:22.62,0:10:25.12,Default,,0,0,0,,Неліктен осындай нәрсені қосуға тырыспайсыз?
Dialogue: 0,0:10:26.25,0:10:30.42,Default,,0,0,0,,Роя мудра! Бұл тұздалған ет!
Dialogue: 0,0:10:30.42,0:10:33.13,Default,,0,0,0,,Сіз сенімдісіз бе? Мелфиера ханым
Dialogue: 0,0:10:33.13,0:10:36.42,Default,,0,0,0,,Әрине! Мені Мелфи деп атаңыз.
Dialogue: 0,0:10:36.42,0:10:40.97,Default,,0,0,0,,Бір минут күтіңіз. Бұл... алтын ет пе?
Dialogue: 0,0:10:40.97,0:10:45.64,Default,,0,0,0,,Бұл бетті жасама, Зефф, бұл жас ханым...
Dialogue: 0,0:10:45.64,0:10:47.98,Default,,0,0,0,,Бұл Мелфи-саманың ерекше сыйы!
Dialogue: 0,0:10:47.98,0:10:51.81,Default,,0,0,0,,Зефф мырза бұл дәм тату кешіне келмеді.
Dialogue: 0,0:10:51.81,0:10:53.82,Default,,0,0,0,,Күрсін... жақсы...
Dialogue: 0,0:10:53.82,0:10:57.15,Default,,0,0,0,,Менің атым Хаос көмекшісі, ал сен менің атымсың. Сенімен бәрі жақсы ма?
Dialogue: 0,0:10:57.15,0:10:59.45,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:10:59.45,0:11:04.16,Default,,0,0,0,,Енді мен оны сенің сынап көруің үшін кесіп беремін, Зефф.
Dialogue: 0,0:11:10.67,0:11:13.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.46,0:11:17.46,Default,,0,0,0,,А... менің сиқырлы күшім мүлде жойылды.
Dialogue: 0,0:11:17.46,0:11:21.84,Default,,0,0,0,,Тамақтану қауіпсіз...
Dialogue: 0,0:11:23.85,0:11:27.02,Default,,0,0,0,,Құрметті Мелфи, мен де алғым келеді!
Dialogue: 0,0:11:27.02,0:11:30.31,Default,,0,0,0,,Енді дәм татып көрейік, Муллан мырза.
Dialogue: 0,0:11:30.31,0:11:34.02,Default,,0,0,0,,Ой... Әй, сен оны шынымен жейсің бе?
Dialogue: 0,0:11:34.02,0:11:39.32,Default,,0,0,0,,Бұл анық. Егер сіз оны жемей, өзіңіз сияқты жек көрсеңіз, өміріңізді босқа өткізесіз.
Dialogue: 0,0:11:41.70,0:11:44.70,Default,,0,0,0,,Муллан мырзаның сыбағасы да өртенді. Апыр-ай.
Dialogue: 0,0:11:44.70,0:11:47.49,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:11:47.49,0:11:52.21,Default,,0,0,0,,Әй, тұздың мөлшері дәмді болды, бірақ жаңа піскен ет дәмді болды.
Dialogue: 0,0:11:52.21,0:11:55.71,Default,,0,0,0,,Бұл қарттың да сіз тастағыңыз келмейтін дәмі бар.
Dialogue: 0,0:11:55.71,0:11:57.71,Default,,0,0,0,,Бұл ең жақсысы, Мелфи!
Dialogue: 0,0:11:57.71,0:12:02.22,Default,,0,0,0,,Иә, бұл жақсы, Мулан.
Dialogue: 0,0:12:02.22,0:12:04.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:07.22,0:12:12.06,Default,,0,0,0,,Маған да тістеп беруге рұқсат ете аласыз ба? Мелфи
Dialogue: 0,0:12:12.06,0:12:14.73,Default,,0,0,0,,Немесе... Жоғары мәртебелі!
Dialogue: 0,0:12:14.73,0:12:19.53,Default,,0,0,0,,Герцог үшін де бір нәрсе бар, сондықтан мұңаймаңыз.
Dialogue: 0,0:12:19.53,0:12:22.36,Default,,0,0,0,,Түшкіру деген болмайды.
Dialogue: 0,0:12:22.36,0:12:25.53,Default,,0,0,0,,Жоқ! Эй!
Dialogue: 0,0:12:26.74,0:12:29.54,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:12:29.54,0:12:32.91,Default,,0,0,0,,Ыстықта дәмді болады, бірақ... хмм...
Dialogue: 0,0:12:32.91,0:12:36.25,Default,,0,0,0,,<Хмм, оны қалай жеуге болады? ＞
Dialogue: 0,0:12:36.25,0:12:39.75,Default,,0,0,0,,<Аа, дұрыс, иә>
Dialogue: 0,0:12:39.75,0:12:45.39,Default,,0,0,0,,<Маршалл Рейдтегі 3 жасар ұлыңыз тамақ ішпей, таңдай жей бастағанда>
Dialogue: 0,0:12:45.39,0:12:47.55,Default,,0,0,0,,<Иә, мен сенімдімін...>
Dialogue: 0,0:12:48.56,0:12:51.27,Default,,0,0,0,,Иә, аа!
Dialogue: 0,0:12:52.93,0:12:54.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:56.56,0:13:01.40,Default,,0,0,0,,<Енді ойлап қарасам, күтуші де назарымды аудару үшін менің атымды атаған сияқты.>
Dialogue: 0,0:13:01.40,0:13:04.40,Default,,0,0,0,,Лорд Герцог... солай емес пе?
Dialogue: 0,0:13:04.40,0:13:08.28,Default,,0,0,0,,Мм, Аристид мырза, ха!
Dialogue: 0,0:13:08.28,0:13:11.12,Default,,0,0,0,,<О, енді! ＞
Dialogue: 0,0:13:11.12,0:13:13.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:14.29,0:13:17.79,Default,,0,0,0,,<Иә! Мен күтуші сияқты жақсы болдым! ＞
Dialogue: 0,0:13:17.79,0:13:19.79,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:21.30,0:13:23.42,Default,,0,0,0,,Тәтті уфуфу
Dialogue: 0,0:13:23.42,0:13:25.97,Default,,0,0,0,,Майдың тәтті дәмі бар.
Dialogue: 0,0:13:25.97,0:13:29.14,Default,,0,0,0,,Сізге ұнады ма? О
Dialogue: 0,0:13:29.14,0:13:31.97,Default,,0,0,0,,<(Мюран Зефф) Қанағаттанғаныңызға қуаныштымын>
Dialogue: 0,0:13:35.98,0:13:39.31,Default,,0,0,0,,Иә! Сіз қалай ойлайсыз? дәмі
Dialogue: 0,0:13:40.32,0:13:42.82,Default,,0,0,0,,Бұл дәмді болды...
Dialogue: 0,0:13:42.82,0:13:47.99,Default,,0,0,0,,Жақсы! Енді астықты илейміз.
Dialogue: 0,0:13:47.99,0:13:52.62,Default,,0,0,0,,Муллан мырза, Зефф мырза, осы етті кішкене бөліктерге кесіп жібере аласыз ба?
Dialogue: 0,0:13:52.62,0:13:56.33,Default,,0,0,0,,Иә! Содан кейін көкөністерді тураңыз.
Dialogue: 0,0:13:56.33,0:13:58.33,Default,,0,0,0,,Иә Иә (Аристид айқайлайды)
Dialogue: 0,0:13:59.33,0:14:03.17,Default,,0,0,0,,Бұл не? Дәмді! Бұл не ет?
Dialogue: 0,0:14:03.17,0:14:05.34,Default,,0,0,0,,Мен бұл Роя мудра деп естідім!
Dialogue: 0,0:14:05.34,0:14:07.84,Default,,0,0,0,,Әй, алтын шаш!
Dialogue: 0,0:14:15.18,0:14:19.48,Default,,0,0,0,,Сізге ұнағанына қуаныштымын. Бұл дұрыс.
Dialogue: 0,0:14:19.48,0:14:23.65,Default,,0,0,0,,Әрине, ет хош иісті болды, ал хош иісі шынымен де ерекше болды.
Dialogue: 0,0:14:23.65,0:14:26.19,Default,,0,0,0,,Сіз ерекше нәрсе жасадыңыз ба?
Dialogue: 0,0:14:26.19,0:14:29.49,Default,,0,0,0,,Жоқ Етті кесектерге кескеннен кейін
Dialogue: 0,0:14:29.49,0:14:31.87,Default,,0,0,0,,Бұл жай ғана аздап қуырылған.
Dialogue: 0,0:14:35.37,0:14:39.04,Default,,0,0,0,,Жүр, қара, Мелфи.
Dialogue: 0,0:14:39.04,0:14:42.50,Default,,0,0,0,,Мм... Мен өзім жеймін.
Dialogue: 0,0:14:42.50,0:14:46.88,Default,,0,0,0,,Герцог келіп тұздалған ет жесе жақсы емес пе?
Dialogue: 0,0:14:46.88,0:14:49.68,Default,,0,0,0,,Жоқ, мен сені тамақтандырамын.
Dialogue: 0,0:14:49.68,0:14:53.51,Default,,0,0,0,,Уф... Менің қолымнан келмейтін сияқты.
Dialogue: 0,0:14:59.23,0:15:02.90,Default,,0,0,0,,Бұл дәмді! Қалғаны өзіңізге байланысты...
Dialogue: 0,0:15:02.90,0:15:05.40,Default,,0,0,0,,Қараңызшы, келесі.
Dialogue: 0,0:15:05.40,0:15:07.69,Default,,0,0,0,,<Сәлем~>
Dialogue: 0,0:15:11.07,0:15:14.53,Default,,0,0,0,,Мелфи Не? Герцог
Dialogue: 0,0:15:14.53,0:15:17.70,Default,,0,0,0,,А... бұл туралы.
Dialogue: 0,0:15:17.70,0:15:20.92,Default,,0,0,0,,Сіз маған қалыпты түрде қоңырау шала аласыз ба?
Dialogue: 0,0:15:20.92,0:15:22.92,Default,,0,0,0,,Қалыпты?
Dialogue: 0,0:15:24.54,0:15:26.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:29.26,0:15:33.43,Default,,0,0,0,,А… Аристид мырза
Dialogue: 0,0:15:33.43,0:15:35.56,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:15:37.93,0:15:43.56,Default,,0,0,0,,Хаостың пікірінше, күйеу жігіттердің бір-бірін атымен немесе лақап атымен атайтыны дұрыс сияқты.
Dialogue: 0,0:15:43.56,0:15:48.44,Default,,0,0,0,,Ойланып қарашы, сенің әкең мен шешең де бірін-бірі өз аттарымен атаған.
Dialogue: 0,0:15:48.44,0:15:52.28,Default,,0,0,0,,<Бірақ мен әрқашан герцог болдым.>
Dialogue: 0,0:15:52.28,0:15:56.58,Default,,0,0,0,,<Кенеттен сізді өз атыңызбен шақыру аздап ұят болды>
Dialogue: 0,0:15:56.58,0:16:00.12,Default,,0,0,0,,<Жоқ, қазір үйреніп кету керек.>
Dialogue: 0,0:16:00.12,0:16:02.12,Default,,0,0,0,,Сонымен… онда
Dialogue: 0,0:16:04.46,0:16:06.75,Default,,0,0,0,,Құрметті Аристид
Dialogue: 0,0:16:06.75,0:16:08.76,Default,,0,0,0,,Не? Мелфи
Dialogue: 0,0:16:08.76,0:16:11.13,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:16:11.13,0:16:14.76,Default,,0,0,0,,Мен сізге дұрыс қоңырау шалу үшін тағы біраз жаттығамын.
Dialogue: 0,0:16:14.76,0:16:17.76,Default,,0,0,0,,Хаха, кез келген лақап ат жақсы.
Dialogue: 0,0:16:17.76,0:16:20.48,Default,,0,0,0,,Ах... Бұл лақап ат па?
Dialogue: 0,0:16:20.48,0:16:24.31,Default,,0,0,0,,<Себебі герцогтың аты Аристид Роджер>
Dialogue: 0,0:16:24.31,0:16:26.31,Default,,0,0,0,,<Күтілгендей...>
Dialogue: 0,0:16:26.31,0:16:29.32,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:16:29.82,0:16:33.28,Default,,0,0,0,,Роджер мырза... Ах...
Dialogue: 0,0:16:35.12,0:16:38.66,Default,,0,0,0,,Герцог, сенің көздерің алтын... а
Dialogue: 0,0:16:38.66,0:16:41.66,Default,,0,0,0,,Сіз ауырып жатырсыз ба? біреу!
Dialogue: 0,0:16:41.66,0:16:43.67,Default,,0,0,0,,А... не болды?
Dialogue: 0,0:16:43.67,0:16:45.67,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:16:45.67,0:16:48.84,Default,,0,0,0,,Мен сиқырымды басқара алмай қалғаныма көп уақыт болды.
Dialogue: 0,0:16:50.13,0:16:54.51,Default,,0,0,0,,<Ол менің құбыжық тағамым үшін бе? ＞
Dialogue: 0,0:16:54.51,0:16:57.14,Default,,0,0,0,,Жарайды, Мельфиера-сама.
Dialogue: 0,0:16:57.14,0:16:59.68,Default,,0,0,0,,Муллан мырза, мен...
Dialogue: 0,0:16:59.68,0:17:01.68,Default,,0,0,0,,Мәртебелі күшті сиқырлы күшке ие.
Dialogue: 0,0:17:01.68,0:17:05.15,Default,,0,0,0,,Ұсталатын сома да қарапайым адамдікінен салыстыруға келмейтіндей көп.
Dialogue: 0,0:17:05.15,0:17:08.69,Default,,0,0,0,,Егер сіз оны аздап жіберсеңіз, тез арада жақсы сезінесіз.
Dialogue: 0,0:17:08.69,0:17:11.69,Default,,0,0,0,,Бәрі жақсы, уайымдама.
Dialogue: 0,0:17:11.69,0:17:14.03,Default,,0,0,0,,Бірақ... дұрыс.
Dialogue: 0,0:17:14.03,0:17:16.87,Default,,0,0,0,,Ертеңге Ханасты алуға барайын ба?
Dialogue: 0,0:17:17.87,0:17:20.54,Default,,0,0,0,,Олай болса біз сізге еріп барамыз.
Dialogue: 0,0:17:23.04,0:17:25.71,Default,,0,0,0,,<Герцог>
Dialogue: 0,0:17:25.71,0:17:27.71,Default,,0,0,0,,<Қалыпты адамдардан артық>
Dialogue: 0,0:17:27.71,0:17:31.71,Default,,0,0,0,,<Сізде сиқырлы күшті босатуды талап ететін конституция бар.>
Dialogue: 0,0:17:33.55,0:17:37.72,Default,,0,0,0,,<Құбыжықтар ғана емес, адамдарда да сиқырлы күш бар>
Dialogue: 0,0:17:37.72,0:17:43.73,Default,,0,0,0,,<Құбыжықтар сиқырлы күш жинағанда, олар сиқырлы у шығарып, есінен танып қалады.>
Dialogue: 0,0:17:44.73,0:17:47.56,Default,,0,0,0,,<Сонда адамдар ше? ＞
Dialogue: 0,0:17:51.57,0:17:54.19,Default,,0,0,0,,<Жоқ>
Dialogue: 0,0:17:54.19,0:17:56.57,Default,,0,0,0,,<Жоқ...>
Dialogue: 0,0:17:56.57,0:18:00.07,Default,,0,0,0,,<Герцог сенің анаң сияқты...>
Dialogue: 0,0:18:06.08,0:18:08.21,Default,,0,0,0,,Герцог...
Dialogue: 0,0:18:10.59,0:18:13.38,Default,,0,0,0,,《Ана... Ана...》
Dialogue: 0,0:18:13.38,0:18:16.22,Default,,0,0,0,,《(Элиза) Жылама, Мелфи》
Dialogue: 0,0:18:16.22,0:18:18.59,Default,,0,0,0,,《Адамдар құбыжықтардан ерекшеленеді》
Dialogue: 0,0:18:18.59,0:18:22.76,Default,,0,0,0,,《Оның денесі әлсіз және нәзік》
Dialogue: 0,0:18:22.76,0:18:26.94,Default,,0,0,0,,《Аа...》 《(Элиза) Мен күшті сиқырлы күшпен тудым》
Dialogue: 0,0:18:26.94,0:18:30.77,Default,,0,0,0,,《Мана жиі осылай бақылаудан шығып кетеді》
Dialogue: 0,0:18:30.77,0:18:33.40,Default,,0,0,0,,《Қашып кететін сиқыр? 》
Dialogue: 0,0:18:33.40,0:18:36.95,Default,,0,0,0,,《Егер денеде сиқырлы күш тым көп жиналса, дене қызуы көтеріледі》
Dialogue: 0,0:18:36.95,0:18:40.78,Default,,0,0,0,,《Кейде мен қозғала алмаймын.》
Dialogue: 0,0:18:40.78,0:18:43.95,Default,,0,0,0,,《Анашым, шаршадыңыз ба? 》
Dialogue: 0,0:18:43.95,0:18:45.95,Default,,0,0,0,,《(Элис) Жарайды》
Dialogue: 0,0:18:49.79,0:18:54.42,Default,,0,0,0,,《Анаңа көмектесе алмаймын ба? 》
Dialogue: 0,0:18:54.42,0:18:57.97,Default,,0,0,0,,《(Элиза) Сен өте мейірімдісің, Мелфи》
Dialogue: 0,0:18:57.97,0:18:59.97,Default,,0,0,0,,《Жарайды》
Dialogue: 0,0:19:02.97,0:19:05.27,Default,,0,0,0,,《(Элис) Жақында сауығып кетесің.》
Dialogue: 0,0:19:07.27,0:19:09.64,Default,,0,0,0,,《Бейшара》
Dialogue: 0,0:19:09.64,0:19:12.81,Default,,0,0,0,,《Ол құбыжықтарды жегендіктен уланып өлді》
Dialogue: 0,0:19:12.81,0:19:14.98,Default,,0,0,0,,《Қорқынышты》
Dialogue: 0,0:19:14.98,0:19:17.44,Default,,0,0,0,,《＜Жоқ＞》
Dialogue: 0,0:19:17.44,0:19:19.65,Default,,0,0,0,,《＜Жоқ＞》
Dialogue: 0,0:19:20.66,0:19:23.45,Default,,0,0,0,,《＜Олай емес＞》
Dialogue: 0,0:19:23.45,0:19:25.66,Default,,0,0,0,,《＜Бұлай болуы мүмкін емес＞》
Dialogue: 0,0:19:26.83,0:19:30.00,Default,,0,0,0,,<Ананың сиқырлы шеңбері толық болмады>
Dialogue: 0,0:19:30.00,0:19:34.46,Default,,0,0,0,,<Сіңген құбыжықтың сиқырлы күші анаңның денесінде жинақталған>
Dialogue: 0,0:19:34.46,0:19:37.17,Default,,0,0,0,,<Оны ыдыратып, жынның уына айналдыруға болмайды>
Dialogue: 0,0:19:38.17,0:19:41.68,Default,,0,0,0,,《<Ананың сиқыры сондай әдемі еді>》
Dialogue: 0,0:19:41.68,0:19:45.01,Default,,0,0,0,,《＜Шаш жалын сияқты қызарып кетті＞》
Dialogue: 0,0:19:45.01,0:19:48.31,Default,,0,0,0,,《<Оның көздері жарқыраған зердей болды>》
Dialogue: 0,0:19:48.31,0:19:52.19,Default,,0,0,0,,《＜Әдемі болды, ертегі рухындай＞》
Dialogue: 0,0:19:52.19,0:19:55.86,Default,,0,0,0,,《＜Мен оны көргенді ұнатамын＞》
Dialogue: 0,0:19:55.86,0:20:00.19,Default,,0,0,0,,《＜Сиқырлы күш жабайы жүгіреді... Міне, осы＞》
Dialogue: 0,0:20:00.19,0:20:05.03,Default,,0,0,0,,《＜Құбыжықтардан әлсіз адам денесі жиналған жын уына төтеп бере алмайды＞》
Dialogue: 0,0:20:05.03,0:20:08.20,Default,,0,0,0,,《＜Жындылыққа айналмас бұрын дене тірі қалмайды және өледі＞》
Dialogue: 0,0:20:08.20,0:20:11.33,Default,,0,0,0,,《Уау! Каа~! 》
Dialogue: 0,0:20:11.33,0:20:17.05,Default,,0,0,0,,<Мен ол кезде бала едім, анама көмектесе алмайтынмын>
Dialogue: 0,0:20:17.05,0:20:19.88,Default,,0,0,0,,<Бірақ қазір...>
Dialogue: 0,0:20:19.88,0:20:23.51,Default,,0,0,0,,<Герцог, мен бар күшімді саламын>
Dialogue: 0,0:20:23.51,0:20:27.35,Default,,0,0,0,,<Зерттеуді міндетті түрде аяқтаңыз>
Dialogue: 0,0:20:27.35,0:20:30.35,Default,,0,0,0,,<Сондықтан...>
Dialogue: 0,0:20:30.35,0:20:32.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:32.35,0:20:35.23,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:20:36.23,0:20:38.90,Default,,0,0,0,,Таң? Бұл...
Dialogue: 0,0:20:38.90,0:20:42.53,Default,,0,0,0,,Герцогтың плащы? неге?
Dialogue: 0,0:20:42.53,0:20:45.91,Default,,0,0,0,,Кеше мен Герцогтың жағдайына алаңдадым.
Dialogue: 0,0:20:45.91,0:20:48.24,Default,,0,0,0,,Бөлмені аралап,...
Dialogue: 0,0:20:48.24,0:20:50.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:50.24,0:20:52.25,Default,,0,0,0,,<Еденде ұйықтап қалды>
Dialogue: 0,0:20:52.25,0:20:55.25,Default,,0,0,0,,<Оны герцог көрді>
Dialogue: 0,0:20:55.25,0:20:57.92,Default,,0,0,0,,＜Яғни...＞
Dialogue: 0,0:20:57.92,0:21:00.25,Default,,0,0,0,,Ұят!
Dialogue: 0,0:21:00.25,0:21:02.76,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:21:02.76,0:21:05.09,Default,,0,0,0,,Бұл... Герцог!
Dialogue: 0,0:21:05.09,0:21:07.93,Default,,0,0,0,,Мелфи Сіз әлі ояусыз ба?
Dialogue: 0,0:21:07.93,0:21:11.10,Default,,0,0,0,,Герцог, көңіл-күйіңіз қалай?
Dialogue: 0,0:21:11.10,0:21:13.56,Default,,0,0,0,,Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:21:13.56,0:21:16.77,Default,,0,0,0,,Мен айтпағаным үшін таң қалған шығарсың.
Dialogue: 0,0:21:16.77,0:21:20.57,Default,,0,0,0,,Ендеше, сиқырлы күшіңіз солғын емес пе?
Dialogue: 0,0:21:20.57,0:21:22.57,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:24.40,0:21:27.28,Default,,0,0,0,,Менде бәрі жақсы, Мелфи.
Dialogue: 0,0:21:27.28,0:21:29.28,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:21:29.28,0:21:33.79,Default,,0,0,0,,Рас болса да безгегің жоқ емес пе?
Dialogue: 0,0:21:35.12,0:21:39.29,Default,,0,0,0,,<Қандай қашықтық! Мен сондай қуаныштымын! ＞
Dialogue: 0,0:21:39.29,0:21:41.30,Default,,0,0,0,,<Ах, қызба>
Dialogue: 0,0:21:41.30,0:21:44.59,Default,,0,0,0,,Суық, мұз сияқты.
Dialogue: 0,0:21:44.59,0:21:46.59,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:21:46.59,0:21:49.80,Default,,0,0,0,,Міне, мен өзен суын көп алып шықтым.
Dialogue: 0,0:21:49.80,0:21:51.81,Default,,0,0,0,,Өзен суы?
Dialogue: 0,0:21:51.81,0:21:54.60,Default,,0,0,0,,<Енді ойлап қарасам, мен Ханасты алып кетейін>
Dialogue: 0,0:21:54.60,0:21:56.81,Default,,0,0,0,,<Осы күздің салқын түнінде>
Dialogue: 0,0:21:56.81,0:21:59.81,Default,,0,0,0,,<Біріншіден, бұл менің өзімшілдігім>
Dialogue: 0,0:21:59.81,0:22:02.44,Default,,0,0,0,,Бол... Басқа мағынада дұрыс па?
Dialogue: 0,0:22:02.44,0:22:05.61,Default,,0,0,0,,Осылай салқын тисе, суық тиіп қаласың.
Dialogue: 0,0:22:05.61,0:22:10.32,Default,,0,0,0,,Сені осылай көрудің өзі мені жылытуға жеткілікті.
Dialogue: 0,0:22:10.32,0:22:12.33,Default,,0,0,0,,<Олай емес! ＞
Dialogue: 0,0:22:12.33,0:22:16.46,Default,,0,0,0,,Дұрыс, плащ! Плащ үшін рахмет!
Dialogue: 0,0:22:16.46,0:22:18.62,Default,,0,0,0,,және бүгінге осы жетсін
Dialogue: 0,0:22:19.63,0:22:22.84,Default,,0,0,0,,Мен сіздің көзілдірігіңізге қолайлы нәрсе таптым.
Dialogue: 0,0:22:22.84,0:22:25.17,Default,,0,0,0,,Қазір барып, тексергіңіз келе ме?
Dialogue: 0,0:22:25.17,0:22:27.63,Default,,0,0,0,,Ханасқа қарағанда герцог көбірек
Dialogue: 0,0:22:27.63,0:22:31.35,Default,,0,0,0,,Бұл сізді жылытады және оны тексеру үшін сыртқа шығуға болады, солай ма?
Dialogue: 0,0:22:31.35,0:22:33.35,Default,,0,0,0,,<Тағы да...>
Dialogue: 0,0:22:33.35,0:22:37.02,Default,,0,0,0,,<Бүгінгі герцог бұзылған жезөкше ме деп ойлаймын>
Dialogue: 0,0:22:37.02,0:22:39.19,Default,,0,0,0,,Хаха...
Dialogue: 0,0:22:41.19,0:22:53.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:55.37,0:23:01.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
