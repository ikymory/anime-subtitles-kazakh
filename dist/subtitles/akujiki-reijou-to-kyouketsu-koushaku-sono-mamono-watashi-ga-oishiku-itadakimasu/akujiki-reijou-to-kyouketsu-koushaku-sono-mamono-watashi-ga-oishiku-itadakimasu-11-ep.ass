Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:05.00,Default,,0,0,0,,<Не деген тәтті иіс! ＞
Dialogue: 0,0:00:05.00,0:00:08.13,Default,,0,0,0,,<Бұл Скримвуд жемісі! ＞
Dialogue: 0,0:00:08.13,0:00:11.01,Default,,0,0,0,,Ханшайым, әлі бітірдіңіз бе?
Dialogue: 0,0:00:11.01,0:00:15.14,Default,,0,0,0,,Иә, жемістегі мазмұн сорылып алынды.
Dialogue: 0,0:00:15.14,0:00:19.85,Default,,0,0,0,,Бірақ жемістің сиқырлы күшінің көп бөлігі оның тұқымында жатыр.
Dialogue: 0,0:00:19.85,0:00:21.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:22.85,0:00:26.02,Default,,0,0,0,,Сонымен, тұқымда қалған сиқырлы күш сыртқа шығар алдында.
Dialogue: 0,0:00:26.02,0:00:29.32,Default,,0,0,0,,Жеміс бөлігін кесіп алу керек.
Dialogue: 0,0:00:29.32,0:00:34.53,Default,,0,0,0,,Енді осы сиқырлы қуатты өлшейтін құрал арқылы жеміс целлюлозасының сиқырлы күшін өлшейік.
Dialogue: 0,0:00:34.53,0:00:36.53,Default,,0,0,0,,О~
Dialogue: 0,0:00:43.71,0:00:47.04,Default,,0,0,0,,Ханшайым, мен істеймін!
Dialogue: 0,0:00:47.04,0:00:50.05,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:00:50.05,0:00:52.05,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:23.81,0:02:26.43,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:02:26.43,0:02:28.64,Default,,0,0,0,,Хмм, аа...
Dialogue: 0,0:02:28.64,0:02:30.65,Default,,0,0,0,,Хмм, уау!
Dialogue: 0,0:02:30.65,0:02:33.98,Default,,0,0,0,,Лилиан Мұндай жағдайларда бұл пышақтың ұшы емес.
Dialogue: 0,0:02:33.98,0:02:36.28,Default,,0,0,0,,Пышақ негізін қолданған дұрыс
Dialogue: 0,0:02:36.28,0:02:38.99,Default,,0,0,0,,Маған қарызға беріңізші.
Dialogue: 0,0:02:38.99,0:02:42.28,Default,,0,0,0,,Қылыш пен аспаздық пышақтардың мақсаты әртүрлі.
Dialogue: 0,0:02:42.28,0:02:46.29,Default,,0,0,0,,Кемпинг кезінде тамақты өзіңіз пісіруіңіз керек.
Dialogue: 0,0:02:47.29,0:02:51.46,Default,,0,0,0,,Егер сіз экспедицияға шыққыңыз келсе, дұрыс пісіруді ұмытпаңыз.
Dialogue: 0,0:02:51.46,0:02:54.84,Default,,0,0,0,,Иә, капитан, рахмет!
Dialogue: 0,0:03:00.84,0:03:03.85,Default,,0,0,0,,Ханшайым, осы жеткілікті ме?
Dialogue: 0,0:03:03.85,0:03:07.85,Default,,0,0,0,,Лилианға рахмет, жеткілікті.
Dialogue: 0,0:03:07.85,0:03:11.02,Default,,0,0,0,,Сонымен... жақсы орындадың ба?
Dialogue: 0,0:03:11.02,0:03:14.32,Default,,0,0,0,,Иә, өте! Лилианға рахмет
Dialogue: 0,0:03:14.32,0:03:16.32,Default,,0,0,0,,Эххе
Dialogue: 0,0:03:18.19,0:03:22.49,Default,,0,0,0,,<Қандай қалың тері, бәрібір>
Dialogue: 0,0:03:22.49,0:03:25.70,Default,,0,0,0,,<Оны да сурет кітабына қосу керек>
Dialogue: 0,0:03:25.70,0:03:30.71,Default,,0,0,0,,Ол құрылғымен сиқырды қалай өлшейсіз?
Dialogue: 0,0:03:30.71,0:03:36.21,Default,,0,0,0,,Бұл пышақталған затта қалған сиқырлы күштің мөлшерін өлшейтін сиқырлы құрылғы.
Dialogue: 0,0:03:36.21,0:03:39.88,Default,,0,0,0,,Бұл иненің ішінде кішкентай тесік бар.
Dialogue: 0,0:03:39.88,0:03:43.89,Default,,0,0,0,,Өлшеу құрылғысының ішіндегі сиқырлы шеңбер енді іске қосылды.
Dialogue: 0,0:03:43.89,0:03:46.06,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:03:46.06,0:03:50.35,Default,,0,0,0,,Ханшайым оның қалай жұмыс істейтіні туралы ойлады ма?
Dialogue: 0,0:03:50.35,0:03:53.06,Default,,0,0,0,,Иә, менің мақсатым
Dialogue: 0,0:03:53.06,0:03:56.90,Default,,0,0,0,,Біз әркімнің жан тыныштығымен құбыжықтарды жей алуын қалаймыз.
Dialogue: 0,0:03:56.90,0:04:01.36,Default,,0,0,0,,Мұны қалай жасау керектігін мен ғана білетін болсам да, мағынасы жоқ.
Dialogue: 0,0:04:01.36,0:04:05.07,Default,,0,0,0,,Болашақта дайындықты әркім оңай орындай алады.
Dialogue: 0,0:04:05.07,0:04:09.24,Default,,0,0,0,,Біз бұл құрылғыларды танымал етуге тырысамыз.
Dialogue: 0,0:04:11.91,0:04:16.92,Default,,0,0,0,,Бұл әдіс қауіпсіз, өйткені сиқырлы күштің көлемін көзбен көруге болады.
Dialogue: 0,0:04:16.92,0:04:21.09,Default,,0,0,0,,Бұл ханшайым біршама жарқырап тұрған сияқты...
Dialogue: 0,0:04:23.76,0:04:25.76,Default,,0,0,0,,Қызыл…
Dialogue: 0,0:04:25.76,0:04:28.76,Default,,0,0,0,,Сізде әлі де қалдық сиқырлы күш бар сияқты.
Dialogue: 0,0:04:28.76,0:04:32.77,Default,,0,0,0,,Ендеше, тұқымдарды алып тастау керек.
Dialogue: 0,0:04:42.40,0:04:44.95,Default,,0,0,0,,<Ni... Иісі бар...>
Dialogue: 0,0:04:44.95,0:04:49.58,Default,,0,0,0,,<Ах...> <(Натали Лилиан) Өте тәтті! ＞
Dialogue: 0,0:04:52.29,0:04:55.79,Default,,0,0,0,,Біз оны жеген кездегіден мүлде басқаша.
Dialogue: 0,0:04:55.79,0:05:00.30,Default,,0,0,0,,Иә, түсі осыған қарағанда сары-жасыл болды, солай ма?
Dialogue: 0,0:05:00.30,0:05:03.09,Default,,0,0,0,,Иісі де ерекше.
Dialogue: 0,0:05:03.09,0:05:06.80,Default,,0,0,0,,Сізді басқа мазалаған мәселелер болды ма?
Dialogue: 0,0:05:06.80,0:05:12.10,Default,,0,0,0,,Ешқандай улану, сал, елестеу болмағандықтан, мен оны шыдап, жедім.
Dialogue: 0,0:05:12.10,0:05:15.64,Default,,0,0,0,,Белгілі бір дәрежеде оны тазартылған сумен басқаруға болады.
Dialogue: 0,0:05:15.64,0:05:17.94,Default,,0,0,0,,Бірақ оның иісі өте жағымсыз
Dialogue: 0,0:05:17.94,0:05:21.48,Default,,0,0,0,,Шынымды айтсам, дәмі есімде жоқ.
Dialogue: 0,0:05:21.48,0:05:23.82,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:05:25.82,0:05:30.66,Default,,0,0,0,,Қызыл түс олардың әлі піспегенін білдірсе керек.
Dialogue: 0,0:05:36.33,0:05:39.13,Default,,0,0,0,,Жарайды, жауап жоқ.
Dialogue: 0,0:05:39.13,0:05:42.84,Default,,0,0,0,,Енді оны жесең де ауырмайсың.
Dialogue: 0,0:05:42.84,0:05:45.34,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:05:45.34,0:05:47.97,Default,,0,0,0,,Енді удың дәмін татып көрейік.
Dialogue: 0,0:05:49.14,0:05:52.51,Default,,0,0,0,,Мен алдымен тамақты жеп көрейін.
Dialogue: 0,0:05:52.51,0:05:54.68,Default,,0,0,0,,Бәрің кейін келесіңдер...
Dialogue: 0,0:05:54.68,0:05:57.35,Default,,0,0,0,,Жоқ... жоқ! Мен улы дәмі бар адаммын!
Dialogue: 0,0:05:57.35,0:06:01.52,Default,,0,0,0,,Ханшайым құлап қалса, Мәртебелі алдынан шыға алмайды!
Dialogue: 0,0:06:01.52,0:06:03.53,Default,,0,0,0,,Капитан, сіз алдап жатырсыз!
Dialogue: 0,0:06:03.53,0:06:06.53,Default,,0,0,0,,Мен оны жегім келеді дегендіктен, дәмін татамын!
Dialogue: 0,0:06:06.53,0:06:11.37,Default,,0,0,0,,Жоқ, Лиллиан, сен рыцарь болсаң да, әлі ересек емессің.
Dialogue: 0,0:06:11.37,0:06:13.37,Default,,0,0,0,,Мен мұндағы ең үлкенімін!
Dialogue: 0,0:06:13.37,0:06:17.16,Default,,0,0,0,,Капитанның баласы бар, солай ма? Мен осындамын
Dialogue: 0,0:06:17.16,0:06:19.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:19.37,0:06:22.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:22.00,0:06:25.88,Default,,0,0,0,,Бұл не? Бұл өте жақсы!
Dialogue: 0,0:06:25.88,0:06:28.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:29.89,0:06:33.56,Default,,0,0,0,,Ал, оны да алайық.
Dialogue: 0,0:06:36.56,0:06:39.02,Default,,0,0,0,,<Целлюлоза өте жұмсақ>
Dialogue: 0,0:06:39.02,0:06:41.40,Default,,0,0,0,,<Бұл сәл жабысқақ, солай емес пе?>
Dialogue: 0,0:06:41.40,0:06:44.02,Default,,0,0,0,,<Түс әдемі қызғылт сары>
Dialogue: 0,0:06:44.02,0:06:46.90,Default,,0,0,0,,<Аздап мөлдір және балғын>
Dialogue: 0,0:06:48.74,0:06:51.03,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:51.03,0:06:55.74,Default,,0,0,0,,<Бақыттың дәмі қандай бай! ＞
Dialogue: 0,0:06:56.75,0:07:01.92,Default,,0,0,0,,<Мен Муллан мырзаның бұл балшырындардан, жоғары сапалы жемістерден де дәмдірек екенін айтқанда не айтқысы келгенін енді түсіндім.>
Dialogue: 0,0:07:01.92,0:07:04.04,Default,,0,0,0,,<Шикі шырынды жегенде>
Dialogue: 0,0:07:04.04,0:07:08.42,Default,,0,0,0,,＜Тіпті тәттінің ішінде жемістен шығатын ерекше ащы бар, бірақ...＞
Dialogue: 0,0:07:08.42,0:07:12.76,Default,,0,0,0,,<Скримвуд жемісінің ащысы мүлде жоқ! ＞
Dialogue: 0,0:07:12.76,0:07:16.43,Default,,0,0,0,,<Бұл таза тәтті және оны жұтқаннан кейін оны қайтадан жегің келеді>
Dialogue: 0,0:07:16.43,0:07:18.77,Default,,0,0,0,,<Дәмі солай! ＞
Dialogue: 0,0:07:18.77,0:07:21.23,Default,,0,0,0,,Ммм...
Dialogue: 0,0:07:21.23,0:07:23.94,Default,,0,0,0,,Сонымен... сіз жақсысыз ба?
Dialogue: 0,0:07:23.94,0:07:26.61,Default,,0,0,0,,Бұл өте тәтті.
Dialogue: 0,0:07:26.61,0:07:29.24,Default,,0,0,0,,Капитан мен вице-капитан, келіңіздер!
Dialogue: 0,0:07:29.24,0:07:33.07,Default,,0,0,0,,Мен... Жарайды, тамақ ішейік.
Dialogue: 0,0:07:36.45,0:07:39.25,Default,,0,0,0,,Ах, жоқ, мәселе сол емес! Мен бұған дейін ешқашан жеп көрмеппін…
Dialogue: 0,0:07:41.46,0:07:43.46,Default,,0,0,0,,О, өте дәмді болды!
Dialogue: 0,0:07:43.46,0:07:46.63,Default,,0,0,0,,Сізге көп рахмет, ханшайым.
Dialogue: 0,0:07:46.63,0:07:48.63,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:07:48.63,0:07:51.80,Default,,0,0,0,,Бірақ мұның бәрі Лилианның арқасында.
Dialogue: 0,0:07:51.80,0:07:53.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:53.80,0:07:58.81,Default,,0,0,0,,Мен мұндай дәмді шайтан ағашының жемісін бірінші рет жеп отырмын.
Dialogue: 0,0:07:58.81,0:08:02.10,Default,,0,0,0,,Егер Лилиан Мулланның бос сөзінің есінде болмаса.
Dialogue: 0,0:08:02.10,0:08:04.65,Default,,0,0,0,,Мен тамақтануды тоқтатқан шығармын.
Dialogue: 0,0:08:04.65,0:08:07.65,Default,,0,0,0,,Сондықтан рахмет
Dialogue: 0,0:08:07.65,0:08:09.99,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:08:09.99,0:08:13.66,Default,,0,0,0,,Ал, енді мен оны герцогқа беруім керек!
Dialogue: 0,0:08:13.66,0:08:15.66,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:08:15.66,0:08:19.66,Default,,0,0,0,,Бұл өте дәмді, сізге ұнайтынына сенімдімін.
Dialogue: 0,0:08:19.66,0:08:22.50,Default,,0,0,0,,Эхехе ханшайым бақытты көрінеді
Dialogue: 0,0:08:22.50,0:08:24.67,Default,,0,0,0,,Иә, мен бақыттымын.
Dialogue: 0,0:08:24.67,0:08:28.84,Default,,0,0,0,,Герцогқа да осы бақыттың дәмін татқым келеді.
Dialogue: 0,0:08:29.84,0:08:35.01,Default,,0,0,0,,<Герцог та бұл жеміске ренжіді>
Dialogue: 0,0:08:36.01,0:08:39.68,Default,,0,0,0,,<Мен сол нашар жадты қайта жазғым келеді>
Dialogue: 0,0:08:42.02,0:08:44.02,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:44.02,0:08:46.02,Default,,0,0,0,,Ханшайым, бұл не?
Dialogue: 0,0:08:46.02,0:08:49.69,Default,,0,0,0,,Осылайша, кесілген ұшын ауаға тигізбеу арқылы,
Dialogue: 0,0:08:49.69,0:08:54.53,Default,,0,0,0,,Жаңа күйде сақтауға болады Oh~
Dialogue: 0,0:08:54.53,0:08:57.32,Default,,0,0,0,,Сонымен қатар, мен ертерек сиқырлы күш алдым.
Dialogue: 0,0:08:57.32,0:09:01.33,Default,,0,0,0,,Жемістің үстіне бұлтты кристалды қою арқылы да суытуға болады.
Dialogue: 0,0:09:01.33,0:09:03.71,Default,,0,0,0,,Түсінемін, бұл керемет!
Dialogue: 0,0:09:03.71,0:09:06.17,Default,,0,0,0,,Ханшайым... Иә?
Dialogue: 0,0:09:06.17,0:09:10.55,Default,,0,0,0,,Біз өте өкінеміз! иә?
Dialogue: 0,0:09:10.55,0:09:15.18,Default,,0,0,0,,Шынымды айтсам, ханшайымға сенбедім.
Dialogue: 0,0:09:15.18,0:09:20.56,Default,,0,0,0,,Мен өзімді алдын ала ойлағандықтан, мен адалдығыма міндетті қожайынға өте құрметсіздік таныттым...
Dialogue: 0,0:09:20.56,0:09:25.35,Default,,0,0,0,,Мен де ханшайымды мұндай салмақты деп ойламаппын.
Dialogue: 0,0:09:25.35,0:09:27.73,Default,,0,0,0,,Меніңше, бұл матч…
Dialogue: 0,0:09:27.73,0:09:31.07,Default,,0,0,0,,Екеуіңде кешірім сұраудың қажеті жоқ.
Dialogue: 0,0:09:31.07,0:09:35.90,Default,,0,0,0,,Сіз мені әрең танығандықтан, бұлай ойлауыңыз табиғи нәрсе.
Dialogue: 0,0:09:36.91,0:09:41.58,Default,,0,0,0,,Бірақ... мен әлі білмеймін.
Dialogue: 0,0:09:41.58,0:09:43.75,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:09:43.75,0:09:47.08,Default,,0,0,0,,Сіз жаман нәрсе ойлап жатқан шығарсыз.
Dialogue: 0,0:09:47.08,0:09:51.21,Default,,0,0,0,,Иә? Жаман деген не?
Dialogue: 0,0:09:51.21,0:09:55.22,Default,,0,0,0,,《Сәлем! 》 Жарайды... Терезелерді толығымен ашып, айналайын!
Dialogue: 0,0:09:55.22,0:09:58.09,Default,,0,0,0,,Бұл баланың еркелігі ме?
Dialogue: 0,0:09:58.09,0:10:01.60,Default,,0,0,0,,Жаса... айдаһар саңырауқұлағын бақшаға шашып жібер!
Dialogue: 0,0:10:01.60,0:10:04.22,Default,,0,0,0,,《Сәлем! 》
Dialogue: 0,0:10:04.22,0:10:06.39,Default,,0,0,0,,Оны тыңайтқыш ретінде пайдалануға болады ма?
Dialogue: 0,0:10:06.39,0:10:08.40,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:08.40,0:10:11.11,Default,,0,0,0,,Ах! Өзіңізге дәмді құбыжықтар алыңыз!
Dialogue: 0,0:10:11.11,0:10:14.61,Default,,0,0,0,,Ханшайым, бұл сұмдық! Күшік…
Dialogue: 0,0:10:14.61,0:10:18.24,Default,,0,0,0,,Ол айдаһарды өз бетімен жеуі мүмкін.
Dialogue: 0,0:10:18.24,0:10:23.41,Default,,0,0,0,,А... Мен Герцогты бірден жек көре бастадым.
Dialogue: 0,0:10:23.41,0:10:25.95,Default,,0,0,0,,Маршалл рейдіне оралыңыз!
Dialogue: 0,0:10:25.95,0:10:27.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:27.96,0:10:30.79,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:30.79,0:10:33.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:33.13,0:10:36.63,Default,,0,0,0,,Мельфи енді мені жек көре бастайды.
Dialogue: 0,0:10:36.63,0:10:39.43,Default,,0,0,0,,Маршалл рейдіне оралу
Dialogue: 0,0:10:39.43,0:10:42.43,Default,,0,0,0,,<Міне... міне... Герцог!?>
Dialogue: 0,0:10:46.98,0:10:50.15,Default,,0,0,0,,Мельфи мені бұдан былай жек көреді.
Dialogue: 0,0:10:50.15,0:10:52.65,Default,,0,0,0,,Маршалл рейдіне оралу
Dialogue: 0,0:10:52.65,0:10:57.65,Default,,0,0,0,,<Міне...міне...Герцог-сама, артымда неге жүрсің!?>
Dialogue: 0,0:10:57.65,0:11:00.82,Default,,0,0,0,,Бұл қайғылы және жалғыздық.
Dialogue: 0,0:11:00.82,0:11:05.29,Default,,0,0,0,,Мен сені ұнатпау үшін бірдеңе жасадым ба?
Dialogue: 0,0:11:05.29,0:11:09.66,Default,,0,0,0,,Әй, міне... мынау сол астарлы әңгіме.
Dialogue: 0,0:11:09.66,0:11:11.67,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:11.67,0:11:15.00,Default,,0,0,0,,Мен герцогты жек көрмеймін!
Dialogue: 0,0:11:15.00,0:11:18.84,Default,,0,0,0,,Ештеңе емес, жек көрушілікке үйреніп қалдым.
Dialogue: 0,0:11:18.84,0:11:21.68,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:11:21.68,0:11:27.18,Default,,0,0,0,,Құрметті Аристид, мен олай емеспін.
Dialogue: 0,0:11:27.18,0:11:30.85,Default,,0,0,0,,<Мен не істеуім керек? Мен өзімді жараладым>
Dialogue: 0,0:11:30.85,0:11:34.86,Default,,0,0,0,,Мәртебелі мырза, мен ханшайымды арандатқанмын!
Dialogue: 0,0:11:34.86,0:11:39.49,Default,,0,0,0,,Мен ханшайымның нені жаман деп санайтынын айтқым келеді...
Dialogue: 0,0:11:39.49,0:11:43.49,Default,,0,0,0,,Ханшайым Мәртебенің қасында тұруға лайық па?
Dialogue: 0,0:11:43.49,0:11:45.70,Default,,0,0,0,,Ол маған біліп келуімді айтты.
Dialogue: 0,0:11:45.70,0:11:49.70,Default,,0,0,0,,Көздері тұман болған біз едік.
Dialogue: 0,0:11:49.70,0:11:54.04,Default,,0,0,0,,<Натали, бұлай ашудың қажеті жоқ>
Dialogue: 0,0:11:54.04,0:11:59.21,Default,,0,0,0,,Ханшайым өзінің Мәртебелі Скримвудтан ләззат алғанын қалайды.
Dialogue: 0,0:11:59.21,0:12:02.05,Default,,0,0,0,,Мен саған бақыт дәмін татқым келеді
Dialogue: 0,0:12:02.05,0:12:04.72,Default,,0,0,0,,Лиллиан, бұл туралы сөйлесейік!
Dialogue: 0,0:12:04.72,0:12:08.22,Default,,0,0,0,,<Ух... бұл рас болса да>
Dialogue: 0,0:12:08.22,0:12:13.06,Default,,0,0,0,,<Біреу маған қайталап айтса, мен бұл туралы бірдеңе істеуге ұялатын боламын.>
Dialogue: 0,0:12:14.23,0:12:17.07,Default,,0,0,0,,Солай ма? Мелфи
Dialogue: 0,0:12:17.07,0:12:19.23,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:12:19.23,0:12:23.91,Default,,0,0,0,,Ханшайым, маған бұрынғы бақытты жүзіңді көрсетші!
Dialogue: 0,0:12:23.91,0:12:27.24,Default,,0,0,0,,Мәртебелі Мәртебелі Ханшайым, Мәртебелі Мәртебелі туралы сөз болғанда,
Dialogue: 0,0:12:27.24,0:12:30.08,Default,,0,0,0,,Бұл сізге шынымен жақсы күлкі сыйлайды!
Dialogue: 0,0:12:30.08,0:12:33.37,Default,,0,0,0,,Шынымен бе? Лилиан
Dialogue: 0,0:12:33.37,0:12:37.92,Default,,0,0,0,,Бұл рас! Көздері жарқырап, ғашық қыздай...
Dialogue: 0,0:12:37.92,0:12:40.55,Default,,0,0,0,,Міне, болды!
Dialogue: 0,0:12:40.55,0:12:43.38,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:43.38,0:12:46.09,Default,,0,0,0,,Хехехе... Ах!
Dialogue: 0,0:12:46.09,0:12:49.10,Default,,0,0,0,,<Мен жеңілдім! Сол тентек жүз! ＞
Dialogue: 0,0:12:49.10,0:12:53.94,Default,,0,0,0,,<Ешқандай түсініспеушілік жоқ. Мен сізді біраз уақыттан бері тыңдадым! ＞
Dialogue: 0,0:12:55.77,0:12:58.57,Default,,0,0,0,,А... Мен сені ұстадым, Мелфи.
Dialogue: 0,0:12:58.57,0:13:00.94,Default,,0,0,0,,Хана... Шығару...
Dialogue: 0,0:13:02.40,0:13:05.95,Default,,0,0,0,,Бұл жаман болды, мен сені аздап мазақтадым.
Dialogue: 0,0:13:05.95,0:13:08.95,Default,,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,0:13:08.95,0:13:11.95,Default,,0,0,0,,Мен сендердің толқығандарыңды естідім.
Dialogue: 0,0:13:11.95,0:13:14.79,Default,,0,0,0,,Себебі мен өзімді аздап жалғыз сезіндім.
Dialogue: 0,0:13:17.29,0:13:19.79,Default,,0,0,0,,Кешіріңіз, Аристид мырза.
Dialogue: 0,0:13:19.79,0:13:23.80,Default,,0,0,0,,Әзіл болса да, айтпауым керек еді.
Dialogue: 0,0:13:23.80,0:13:26.59,Default,,0,0,0,,Әй, білсем де, сенен
Dialogue: 0,0:13:26.59,0:13:30.31,Default,,0,0,0,,Ки... Саған ұнамайды деп айту жүрекке зиян.
Dialogue: 0,0:13:30.31,0:13:33.98,Default,,0,0,0,,Ертегіні рұқсатсыз тыңдағаным да менің кінәм болды.
Dialogue: 0,0:13:33.98,0:13:39.15,Default,,0,0,0,,Дұрыс. Қайдан кірдің?
Dialogue: 0,0:13:39.15,0:13:41.32,Default,,0,0,0,,Сол жерде.
Dialogue: 0,0:13:43.61,0:13:49.16,Default,,0,0,0,,Маған айтпадың ба? Менің құйрығым мен осы жердің арасы ішкі есік арқылы жалғасады.
Dialogue: 0,0:13:49.16,0:13:53.62,Default,,0,0,0,,Мені қате түсінбеңіз, мен оны әдетте құлыптаулы ұстаймын.
Dialogue: 0,0:13:53.62,0:13:57.62,Default,,0,0,0,,Бірақ бұл жігіт енді ғана оянды.
Dialogue: 0,0:13:57.62,0:13:59.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:59.63,0:14:01.63,Default,,0,0,0,,Сізде кәдесый бар дедіңіз ғой, солай ма?
Dialogue: 0,0:14:01.63,0:14:05.34,Default,,0,0,0,,Бұл Скримвуд жемісі...
Dialogue: 0,0:14:05.34,0:14:07.34,Default,,0,0,0,,Екіншісі.
Dialogue: 0,0:14:07.34,0:14:10.35,Default,,0,0,0,,Мен сізді таң қалдырамын деп ойладым.
Dialogue: 0,0:14:10.35,0:14:13.18,Default,,0,0,0,,Бұл Гэлбрейттің қамқоршы құдайы.
Dialogue: 0,0:14:13.18,0:14:16.18,Default,,0,0,0,,Бұл Тенрудың баласы.
Dialogue: 0,0:14:16.18,0:14:18.19,Default,,0,0,0,,(Тенру баласы жылайды)
Dialogue: 0,0:14:23.36,0:14:27.65,Default,,0,0,0,,＜Ка... Өте сүйкімді~! ＞
Dialogue: 0,0:14:27.65,0:14:29.66,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:14:29.66,0:14:33.37,Default,,0,0,0,,<Үлпілдек аспан қасқыр күшігі және әдемі герцог>
Dialogue: 0,0:14:33.37,0:14:36.37,Default,,0,0,0,,<Не айтайын, бұл алдау! ＞
Dialogue: 0,0:14:39.37,0:14:41.88,Default,,0,0,0,,Бұл балаға не болды?
Dialogue: 0,0:14:41.88,0:14:47.22,Default,,0,0,0,,Оған орманда ессіз Бергенион шабуыл жасап жатыр еді, мен оны уақытша қорғадым.
Dialogue: 0,0:14:47.22,0:14:50.05,Default,,0,0,0,,Ата-анасынан айырылған сияқты.
Dialogue: 0,0:14:50.05,0:14:53.05,Default,,0,0,0,,Қазірдің өзінде мені рыцарьлар іздеп жатыр.
Dialogue: 0,0:14:54.06,0:14:58.06,Default,,0,0,0,,<Герцог оны уақытша қорғауымды өтінді>
Dialogue: 0,0:14:58.06,0:15:01.40,Default,,0,0,0,,<Бұл бала бір күні үлкен орманға жіберіледі, солай ма?>
Dialogue: 0,0:15:01.40,0:15:04.90,Default,,0,0,0,,<Мен ата-анамды сол уақытқа дейін табамын деп үміттенемін>
Dialogue: 0,0:15:04.90,0:15:08.53,Default,,0,0,0,,Неліктен Тенру Галбрейттің қамқоршы құдайы болып табылады?
Dialogue: 0,0:15:08.53,0:15:10.53,Default,,0,0,0,,Бірінші герцог
Dialogue: 0,0:15:10.53,0:15:15.41,Default,,0,0,0,,Ол бұл жерді бір Тенромен билеген деген аңыз бар.
Dialogue: 0,0:15:15.41,0:15:20.42,Default,,0,0,0,,бастап Тенру Гэлбрейт отбасының символына айналды.
Dialogue: 0,0:15:21.42,0:15:24.09,Default,,0,0,0,,Бұл бала не жейді?
Dialogue: 0,0:15:24.09,0:15:27.92,Default,,0,0,0,,Әзірге ешкі сүті мен сиыр етін көрдім.
Dialogue: 0,0:15:27.92,0:15:30.43,Default,,0,0,0,,Мен етті көп жеген жоқпын.
Dialogue: 0,0:15:30.43,0:15:34.10,Default,,0,0,0,,Мен Тенруды бұрын-соңды өсірмедім.
Dialogue: 0,0:15:34.10,0:15:37.43,Default,,0,0,0,,Мен дұрыс жауаптың қандай екенін білмеймін.
Dialogue: 0,0:15:37.43,0:15:42.27,Default,,0,0,0,,Егер солай болса, неге оған құбыжық етін бермеске?
Dialogue: 0,0:15:42.27,0:15:47.57,Default,,0,0,0,,Менің ойымша, егер ол жабайы жерде өссе, бұл мағынасы бар.
Dialogue: 0,0:15:47.57,0:15:50.95,Default,,0,0,0,,Жарайды, айдаһарды тамақтандырып көрейік.
Dialogue: 0,0:15:50.95,0:15:53.28,Default,,0,0,0,,Бланш, дайындықты сұраңыз.
Dialogue: 0,0:15:53.28,0:15:57.45,Default,,0,0,0,,Түсінді. Кеттік, Лилиан!
Dialogue: 0,0:15:57.45,0:16:02.12,Default,,0,0,0,,Иә~ Мен оны тағы да көргім келді~
Dialogue: 0,0:16:07.96,0:16:10.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:10.13,0:16:12.59,Default,,0,0,0,,Мен ақыры тынышталдым.
Dialogue: 0,0:16:16.14,0:16:19.47,Default,,0,0,0,,А... анау герцог.
Dialogue: 0,0:16:19.47,0:16:22.60,Default,,0,0,0,,Бұл қол тигізгенде жақсырақ.
Dialogue: 0,0:16:22.60,0:16:26.15,Default,,0,0,0,,Иә? Бірақ мен мұны қалаймын
Dialogue: 0,0:16:26.15,0:16:29.48,Default,,0,0,0,,Шашыңа қол тигізгенде мен өзімді тыныштандырамын
Dialogue: 0,0:16:29.48,0:16:31.99,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:31.99,0:16:34.78,Default,,0,0,0,,<Герцогиня Гэлбрейттің міндеттері>
Dialogue: 0,0:16:34.78,0:16:38.33,Default,,0,0,0,,<Герцогты емдеу>
Dialogue: 0,0:16:38.33,0:16:42.62,Default,,0,0,0,,<Бірақ бәрібір...ұят...>
Dialogue: 0,0:16:44.12,0:16:47.67,Default,,0,0,0,,Герцог, қарныңыз ашты ма?
Dialogue: 0,0:16:47.67,0:16:49.84,Default,,0,0,0,,О...
Dialogue: 0,0:16:53.13,0:16:55.68,Default,,0,0,0,,Міне
Dialogue: 0,0:16:55.68,0:16:59.01,Default,,0,0,0,,Менде Скримвуд жемісі туралы жақсы естеліктер жоқ.
Dialogue: 0,0:16:59.01,0:17:01.02,Default,,0,0,0,,Бұл перспективалы иіс.
Dialogue: 0,0:17:01.02,0:17:04.52,Default,,0,0,0,,Хехе, таң қалатыныңызға сенімдімін.
Dialogue: 0,0:17:08.52,0:17:10.69,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:10.69,0:17:14.32,Default,,0,0,0,,Дәмді! Дәмі шаршаған денеме сіңіп кетті
Dialogue: 0,0:17:14.32,0:17:16.87,Default,,0,0,0,,Мұнымен қалағаныңызша жеуге болады!
Dialogue: 0,0:17:18.16,0:17:20.87,Default,,0,0,0,,(Тенру баласы жылайды)
Dialogue: 0,0:17:20.87,0:17:23.71,Default,,0,0,0,,Қара, Мелфи, барасың.
Dialogue: 0,0:17:23.71,0:17:26.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:26.17,0:17:29.54,Default,,0,0,0,,Ахаха, бақытты тәттім!
Dialogue: 0,0:17:29.54,0:17:31.88,Default,,0,0,0,,О
Dialogue: 0,0:17:34.34,0:17:36.72,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:17:36.72,0:17:38.72,Default,,0,0,0,,(Тенру баласы жылайды)
Dialogue: 0,0:17:40.56,0:17:44.18,Default,,0,0,0,,Немесе… (Лиллиан Мельфиера) Өте сүйкімді!
Dialogue: 0,0:17:46.35,0:17:49.90,Default,,0,0,0,,Бұл баланың ересек болуына қанша уақыт қажет?
Dialogue: 0,0:17:49.90,0:17:52.19,Default,,0,0,0,,Бір жылдан кейін тәуелсіз болу
Dialogue: 0,0:17:52.19,0:17:55.74,Default,,0,0,0,,Оның ересек болуы үшін тағы төрт жыл қажет.
Dialogue: 0,0:17:55.74,0:17:59.20,Default,,0,0,0,,Бұл елтаңба біздің мақтанышымыз.
Dialogue: 0,0:17:59.20,0:18:03.91,Default,,0,0,0,,Ханшайым ересек Тенроны көрді ме?
Dialogue: 0,0:18:03.91,0:18:07.37,Default,,0,0,0,,Жоқ, мен бұл туралы тек суретті кітаптардан ғана білемін.
Dialogue: 0,0:18:07.37,0:18:11.75,Default,,0,0,0,,Бұл өте құдайға ұқсайтынына сенімдімін.
Dialogue: 0,0:18:11.75,0:18:14.38,Default,,0,0,0,,Иә, солай!
Dialogue: 0,0:18:14.38,0:18:18.38,Default,,0,0,0,,Қараңызшы, оның бәрін бірден жесеңіз, қайта құсып кетесіз.
Dialogue: 0,0:18:18.38,0:18:22.76,Default,,0,0,0,,Баяу тамақтаныңыз Иә, баяу тамақтаныңыз.
Dialogue: 0,0:18:24.60,0:18:26.77,Default,,0,0,0,,(Тенру баласы жылайды)
Dialogue: 0,0:18:26.77,0:18:29.60,Default,,0,0,0,,Бұл жолы бәрін жедің.
Dialogue: 0,0:18:31.77,0:18:33.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:33.78,0:18:35.78,Default,,0,0,0,,(Тенру баласы жылайды)
Dialogue: 0,0:18:35.78,0:18:39.41,Default,,0,0,0,,Ах, Лиллиан, маған лақтыра алатын шүберек әкел!
Dialogue: 0,0:18:39.41,0:18:42.78,Default,,0,0,0,,Иә!? Мен өзімді бұзатын шығармын деп ойлаймын. Асықшы!
Dialogue: 0,0:18:42.78,0:18:45.12,Default,,0,0,0,,Не!
Dialogue: 0,0:18:47.41,0:18:53.13,Default,,0,0,0,,Аға, анамды таппасам, қиналамын.
Dialogue: 0,0:18:53.13,0:18:55.96,Default,,0,0,0,,Сіз оны қанша уақытқа дейін қорғайсыз?
Dialogue: 0,0:18:55.96,0:19:00.97,Default,,0,0,0,,Мен оны қоректенетін болған соң қайтадан жабайы табиғатқа жіберуді жоспарлап едім.
Dialogue: 0,0:19:00.97,0:19:05.81,Default,,0,0,0,,Оған бұлай қарау қиын болар еді.
Dialogue: 0,0:19:05.81,0:19:10.44,Default,,0,0,0,,Бірінші герцог Тенроны қолға түсіре алды, солай ма?
Dialogue: 0,0:19:10.44,0:19:12.81,Default,,0,0,0,,Бұл жай ғана аңыз
Dialogue: 0,0:19:12.81,0:19:17.99,Default,,0,0,0,,<Бірақ бұлай болса, Тенруды өсіруге болады.>
Dialogue: 0,0:19:17.99,0:19:21.45,Default,,0,0,0,,＜Себебі мен сіз сияқты балаларды жеуге маманданамын＞
Dialogue: 0,0:19:21.45,0:19:24.99,Default,,0,0,0,,<Мен оны қалай өсіру керектігін білмеймін>
Dialogue: 0,0:19:26.16,0:19:28.16,Default,,0,0,0,,(Тенру баласы жылайды)
Dialogue: 0,0:19:28.16,0:19:31.17,Default,,0,0,0,,Ой... Әй, не болды? (Тенру баласы үреді)
Dialogue: 0,0:19:31.17,0:19:35.17,Default,,0,0,0,,Аха, мені сағындың, капитан.
Dialogue: 0,0:19:35.17,0:19:39.01,Default,,0,0,0,,Балабақшада жүргенде рыцарь болғың келді.
Dialogue: 0,0:19:39.01,0:19:43.47,Default,,0,0,0,,Бланштың соңынан еріп жүргенімде солай болды.
Dialogue: 0,0:19:43.47,0:19:46.85,Default,,0,0,0,,Немесе... Жоғары мәртебелі! Басқаша ма?
Dialogue: 0,0:19:46.85,0:19:51.02,Default,,0,0,0,,Оның соңынан еріп жүргені емес...
Dialogue: 0,0:19:51.02,0:19:53.02,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:53.02,0:19:56.86,Default,,0,0,0,,<Лиллиан қашан рыцарь болуды мақсат етті?>
Dialogue: 0,0:19:56.86,0:20:02.32,Default,,0,0,0,,<Осындай жаста танылу үшін көп күш жұмсаған боларсың.>
Dialogue: 0,0:20:02.32,0:20:08.70,Default,,0,0,0,,Түсіндім, сен жарты жылдан бері Ле-Сабль шеберханасында қылыш жасап жүрсің.
Dialogue: 0,0:20:08.70,0:20:13.04,Default,,0,0,0,,Егер Бланш рұқсат берсе, мен сені қысқа экспедицияға апарамын.
Dialogue: 0,0:20:13.04,0:20:15.04,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:20:15.04,0:20:18.21,Default,,0,0,0,,Сол Ле Сабль...
Dialogue: 0,0:20:18.21,0:20:22.22,Default,,0,0,0,,Бұл герцогтың қылышын жасаған ұста тұрған шеберхана ма?
Dialogue: 0,0:20:22.22,0:20:25.72,Default,,0,0,0,,А, Ле Сабель Бланштың күйеуі.
Dialogue: 0,0:20:25.72,0:20:28.72,Default,,0,0,0,,Галео – бас ұста шеберханасы.
Dialogue: 0,0:20:30.35,0:20:33.35,Default,,0,0,0,,Әй... сіз сөйлеген жоқсыз ба?
Dialogue: 0,0:20:33.35,0:20:35.36,Default,,0,0,0,,А... иә
Dialogue: 0,0:20:35.36,0:20:38.73,Default,,0,0,0,,Ханшайым қатты қызығатын сияқты.
Dialogue: 0,0:20:38.73,0:20:42.74,Default,,0,0,0,,Мен оны өз шарттарыммен таныстыруым дұрыс па?
Dialogue: 0,0:20:42.74,0:20:45.24,Default,,0,0,0,,Бұл да рас.
Dialogue: 0,0:20:45.24,0:20:49.08,Default,,0,0,0,,ше? Мельфиера сіздің көзқарасыңыз бойынша
Dialogue: 0,0:20:49.08,0:20:52.25,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:20:52.25,0:20:56.54,Default,,0,0,0,,Ханшайым пышақтарды өте мұқият ұстайды.
Dialogue: 0,0:20:56.54,0:20:59.38,Default,,0,0,0,,Оны да меңгерген.
Dialogue: 0,0:20:59.38,0:21:03.38,Default,,0,0,0,,Галео мұны мақұлдайтынына сенімдімін...
Dialogue: 0,0:21:05.55,0:21:10.39,Default,,0,0,0,,Менің күйеуім қыңыр адам деп ойлаймын.
Dialogue: 0,0:21:10.39,0:21:12.39,Default,,0,0,0,,<Мен көремін>
Dialogue: 0,0:21:12.39,0:21:17.40,Default,,0,0,0,,<Галео-сан өз дағдыларын тек өзі мақұлдаған адамдарда қолданады.>
Dialogue: 0,0:21:17.40,0:21:22.40,Default,,0,0,0,,Мен онымен сөйлесейін десем де, ол менің онымен жеке кездескенімді қалайтын сияқты.
Dialogue: 0,0:21:22.40,0:21:25.11,Default,,0,0,0,,Мүмкін, одан құтылу мүмкін емес.
Dialogue: 0,0:21:25.11,0:21:29.12,Default,,0,0,0,,Олай болса, мен оларды жиналысқа қатыстыруым керек пе?
Dialogue: 0,0:21:29.12,0:21:31.95,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:32.95,0:21:35.58,Default,,0,0,0,,<Менің дағдыларымды қалай тануға болады>
Dialogue: 0,0:21:35.58,0:21:39.13,Default,,0,0,0,,<Сіздің құбыжықты соттап жатқаныңызды шынымен көргенімді қалайсыз ба? ＞
Dialogue: 0,0:21:39.13,0:21:41.59,Default,,0,0,0,,Ханшайым Иә
Dialogue: 0,0:21:41.59,0:21:45.80,Default,,0,0,0,,Менің күйеуім Галео қиын және өте жаман.
Dialogue: 0,0:21:45.80,0:21:49.14,Default,,0,0,0,,Біз кездескенде дөрекі болуыңыз мүмкін.
Dialogue: 0,0:21:49.14,0:21:51.43,Default,,0,0,0,,Жоқ, солай…
Dialogue: 0,0:21:51.43,0:21:53.98,Default,,0,0,0,,Не істеу керек? Мелфи
Dialogue: 0,0:21:55.98,0:21:58.31,Default,,0,0,0,,Әрине көремін!
Dialogue: 0,0:22:02.98,0:22:06.15,Default,,0,0,0,,Уайымдама, ханшайым.
Dialogue: 0,0:22:06.15,0:22:09.32,Default,,0,0,0,,Бұл қандай әдемі?
Dialogue: 0,0:22:09.32,0:22:11.99,Default,,0,0,0,,Бұл сізге өте жарасады.
Dialogue: 0,0:22:11.99,0:22:14.33,Default,,0,0,0,,<Соңында ашылды>
Dialogue: 0,0:22:14.33,0:22:20.46,Default,,0,0,0,,<Мені Гэлбрейт герцогинясы болуға лайық деп тану керек.>
Dialogue: 0,0:22:20.46,0:22:25.01,Default,,0,0,0,,Жарайды, әрқашан қандай ханшайым болсаң, солай бол.
Dialogue: 0,0:22:27.34,0:22:29.34,Default,,0,0,0,,<Иә.>
Dialogue: 0,0:22:29.34,0:22:32.64,Default,,0,0,0,,<Мен нашар жейтін адаммын>
Dialogue: 0,0:22:32.64,0:22:36.02,Default,,0,0,0,,<Мен қазір сенің айтқаныңнан қорықпаймын>
Dialogue: 0,0:22:37.35,0:22:39.85,Default,,0,0,0,,<Кеттік, Мельфиера! ＞
Dialogue: 0,0:22:41.02,0:22:58.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:59.87,0:23:05.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
