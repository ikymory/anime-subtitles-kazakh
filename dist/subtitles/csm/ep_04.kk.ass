Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(торғай жылайды)
Dialogue: 0,0:00:09.09,0:00:10.42,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:00:11.42,0:00:13.01,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:00:13.76,0:00:17.18,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:00:20.56,0:00:21.68,Default,,0,0,0,,(Аю жылауы)
Dialogue: 0,0:00:25.02,0:00:28.94,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:00:31.07,0:00:32.70,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:40.75,0:00:43.79,Default,,0,0,0,,Хехехе... хехехе...
Dialogue: 0,0:00:44.58,0:00:46.29,Default,,0,0,0,,(Ньяконың айқайы)
Dialogue: 0,0:00:47.38,0:00:50.55,Default,,0,0,0,,Егер сіз мысықтың өлтірілгенін қаламасаңыз
Dialogue: 0,0:00:50.63,0:00:53.55,Default,,0,0,0,,Маған адам әкел
Dialogue: 0,0:00:54.22,0:00:58.05,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:58.72,0:01:00.81,Default,,0,0,0,,Өмір де бірдей жеңіл
Dialogue: 0,0:01:01.72,0:01:03.06,Default,,0,0,0,,Тек мысық
Dialogue: 0,0:01:04.02,0:01:05.73,Default,,0,0,0,,Онда неге жүгіру керек?
Dialogue: 0,0:01:05.81,0:01:07.31,Default,,0,0,0,,Неліктен адамдарды іздеу керек?
Dialogue: 0,0:01:09.90,0:01:10.86,Default,,0,0,0,,Ха...
Dialogue: 0,0:01:10.94,0:01:12.82,Default,,0,0,0,,Ньякоға көмектесу үшін бе?
Dialogue: 0,0:01:12.90,0:01:14.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:14.40,0:01:16.57,Default,,0,0,0,,Ахх...
Dialogue: 0,0:01:17.53,0:01:20.16,Default,,0,0,0,,Бұл ақымақ себеп
Dialogue: 0,0:01:20.24,0:01:23.70,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:01:24.58,0:01:26.54,Default,,0,0,0,,Мен қанды жақсы көремін
Dialogue: 0,0:01:26.62,0:01:30.84,Default,,0,0,0,,Дәмі, иісі және өлім сезімі
Dialogue: 0,0:01:31.67,0:01:36.18,Default,,0,0,0,,Сонымен... Сондықтан мен жақында ғана білдім.
Dialogue: 0,0:01:37.43,0:01:42.64,Default,,0,0,0,,Қан жылы және жақсы сезінеді
Dialogue: 0,0:01:44.93,0:01:47.10,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:01:47.19,0:01:49.36,Default,,0,0,0,,(Ньяконың айқайы)
Dialogue: 0,0:02:04.79,0:02:06.87,Default,,0,0,0,,Бүркітті неге құтқардың?
Dialogue: 0,0:02:07.46,0:02:10.21,Default,,0,0,0,,Мен Юнвуды өлтірмек болдым
Dialogue: 0,0:02:11.42,0:02:13.13,Default,,0,0,0,,(Дэнджидің тыныс алу дыбысы)
Dialogue: 0,0:02:14.09,0:02:15.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:17.09,0:02:17.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:22.43,0:02:24.89,Default,,0,0,0,,Бұл ақымақ себеп.
Dialogue: 0,0:02:27.98,0:02:30.90,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:02:33.73,0:02:36.40,Default,,0,0,0,,Сізді алдағаным үшін кешіріңіз.
Dialogue: 0,0:02:36.49,0:02:38.90,Default,,0,0,0,,Өйткені Няко құтқарылды.
Dialogue: 0,0:02:39.66,0:02:41.70,Default,,0,0,0,,Мен сенің кеудеңді илеймін.
Dialogue: 0,0:02:42.24,0:02:43.12,Default,,0,0,0,,А...
Dialogue: 0,0:02:46.45,0:02:47.87,Default,,0,0,0,,А...
Dialogue: 0,0:02:51.29,0:02:57.30,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:02:57.38,0:02:59.80,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:02:59.88,0:03:01.80,Default,,0,0,0,,Жүр!
Dialogue: 0,0:03:01.89,0:03:03.55,Default,,0,0,0,,Келіңіздер~ Уф... (Қуат) Ха...
Dialogue: 0,0:03:03.64,0:03:09.39,Default,,0,0,0,,(Денжи) Уф... мен бардым... Ууууу...
Dialogue: 0,0:03:10.56,0:03:11.40,Default,,0,0,0,,Га
Dialogue: 0,0:03:18.44,0:03:19.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:22.11,0:03:27.12,Default,,0,0,0,,♪～
Dialogue: 0,0:04:43.74,0:04:48.74,Default,,0,0,0,,～♪
Dialogue: 0,0:04:52.54,0:04:56.96,Default,,0,0,0,,(Сүлгі шайтанның жеп жатқан дыбысы)
Dialogue: 0,0:04:57.04,0:04:58.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:59.04,0:05:01.63,Default,,0,0,0,,(Сілік шайтан) Ммм (Жол шайтанының жұтқан дыбысы)
Dialogue: 0,0:05:01.71,0:05:03.01,Default,,0,0,0,,Сізге көшу керек пе?
Dialogue: 0,0:05:03.51,0:05:07.97,Default,,0,0,0,,Мен саусақтарымды қозғалта алмаймын. Ньяконы алып қашып кет.
Dialogue: 0,0:05:08.68,0:05:09.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:10.56,0:05:11.39,Default,,0,0,0,,Уф
Dialogue: 0,0:05:12.60,0:05:13.64,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:15.48,0:05:16.94,Default,,0,0,0,,(Араның тоқтаған дыбысы)
Dialogue: 0,0:05:17.73,0:05:20.27,Default,,0,0,0,,Иә, мен араны шығара алмаймын.
Dialogue: 0,0:05:20.36,0:05:21.78,Default,,0,0,0,,Ха...
Dialogue: 0,0:05:21.86,0:05:24.19,Default,,0,0,0,,Қаныңыз жетпейді ме?
Dialogue: 0,0:05:26.07,0:05:26.95,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:27.03,0:05:30.70,Default,,0,0,0,,Ақыры таптым
Dialogue: 0,0:05:30.78,0:05:34.33,Default,,0,0,0,,Сіз емес пе?Мен жараны өлтірдім
Dialogue: 0,0:05:34.41,0:05:37.21,Default,,0,0,0,,Ол менің адамым еді!
Dialogue: 0,0:05:37.29,0:05:38.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:39.42,0:05:44.09,Default,,0,0,0,,Әй, мұқият қарасаң, сүйкімді жүзді көресің.
Dialogue: 0,0:05:44.17,0:05:47.72,Default,,0,0,0,,Сізде маған ұнайтын бет бар, сондықтан қашып кетуіңізге рұқсат етемін.
Dialogue: 0,0:05:48.84,0:05:50.22,Default,,0,0,0,,Арттағылар ше?
Dialogue: 0,0:05:50.30,0:05:52.97,Default,,0,0,0,,Нфф...
Dialogue: 0,0:05:53.60,0:05:54.98,Default,,0,0,0,,өлтіру
Dialogue: 0,0:05:59.73,0:06:00.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:00.65,0:06:02.82,Default,,0,0,0,,Сосын өл.
Dialogue: 0,0:06:03.57,0:06:05.82,Default,,0,0,0,,Уф ха ха...
Dialogue: 0,0:06:07.15,0:06:08.57,Default,,0,0,0,,(Hill Devil) Nuuu (Денджи) Uu
Dialogue: 0,0:06:08.66,0:06:10.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:10.66,0:06:12.58,Default,,0,0,0,,(Хилл Демон) Уф... (Денжи) Уф...
Dialogue: 0,0:06:14.37,0:06:15.58,Default,,0,0,0,,Уф
Dialogue: 0,0:06:15.66,0:06:17.25,Default,,0,0,0,,Фуууууук
Dialogue: 0,0:06:18.79,0:06:19.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:20.71,0:06:21.84,Default,,0,0,0,,Хаха...
Dialogue: 0,0:06:21.92,0:06:23.96,Default,,0,0,0,,(Hill Devil) Хмм... (Денжи) Гхх...
Dialogue: 0,0:06:25.92,0:06:27.26,Default,,0,0,0,,(Денжи) Ах (Хилл Демон) Ха!
Dialogue: 0,0:06:27.34,0:06:28.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:29.43,0:06:31.35,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:06:31.43,0:06:33.81,Default,,0,0,0,,(Hill Devil) Nuuah (Денджи) Ugh
Dialogue: 0,0:06:34.93,0:06:36.06,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:06:36.14,0:06:38.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:38.14,0:06:40.10,Default,,0,0,0,,Тек кеудемді еркелету үшін...
Dialogue: 0,0:06:40.19,0:06:41.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:41.65,0:06:44.07,Default,,0,0,0,,Сіз осылай күресе аласыз ба?
Dialogue: 0,0:06:44.15,0:06:45.57,Default,,0,0,0,,А... уф
Dialogue: 0,0:06:45.65,0:06:47.82,Default,,0,0,0,,Ха-ха… хэ-хэ…
Dialogue: 0,0:06:48.40,0:06:49.74,Default,,0,0,0,,О, жоқ!(Сілік шайтан) Хаха
Dialogue: 0,0:06:49.82,0:06:53.03,Default,,0,0,0,,Ах, у, а...
Dialogue: 0,0:06:54.70,0:06:56.75,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:06:56.83,0:06:59.58,Default,,0,0,0,,Гах... ха...
Dialogue: 0,0:06:59.67,0:07:01.25,Default,,0,0,0,,Бұл өтірік емес пе!?
Dialogue: 0,0:07:01.33,0:07:05.25,Default,,0,0,0,,Мына күшік жарғанатты өлтірді ме?
Dialogue: 0,0:07:05.34,0:07:07.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:07.84,0:07:09.76,Default,,0,0,0,,Жарқанаттар менімен бірге
Dialogue: 0,0:07:09.84,0:07:13.01,Default,,0,0,0,,Мен барлық адамдарды жеуді армандадым.
Dialogue: 0,0:07:13.64,0:07:17.02,Default,,0,0,0,,Абайсыз, бірақ асыл және тамаша арман
Dialogue: 0,0:07:17.10,0:07:20.77,Default,,0,0,0,,Ол күшіктің өлшеміне дейін талқандалған.
Dialogue: 0,0:07:20.85,0:07:24.15,Default,,0,0,0,,Оны өлтіру ысырап болар еді, бірақ
Dialogue: 0,0:07:24.82,0:07:26.28,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:07:26.94,0:07:30.53,Default,,0,0,0,,(Денжи) Хмм... Кеудеңді уқалағанша өлсем бе?
Dialogue: 0,0:07:30.61,0:07:32.41,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:07:32.49,0:07:36.08,Default,,0,0,0,,Оны арсыз қалаулары бар біреу өлтірді.
Dialogue: 0,0:07:36.16,0:07:38.79,Default,,0,0,0,,Бейшара жарқанат
Dialogue: 0,0:07:38.87,0:07:40.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:40.12,0:07:42.21,Default,,0,0,0,,Бұл ақымақ себеп.
Dialogue: 0,0:07:42.29,0:07:43.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:43.79,0:07:46.13,Default,,0,0,0,,Сізден басқаның бәрі байсалды.
Dialogue: 0,0:07:47.59,0:07:48.42,Default,,0,0,0,,Nu
Dialogue: 0,0:07:48.51,0:07:49.42,Default,,0,0,0,,Нуууу
Dialogue: 0,0:07:49.51,0:07:51.38,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:07:51.47,0:07:52.01,Default,,0,0,0,,Ооооооооооо...
Dialogue: 0,0:07:52.01,0:07:53.93,Default,,0,0,0,,Ооооооооооооооо... (Сілік жын) Уряаааааааааааааааааааааааа
Dialogue: 0,0:07:53.93,0:07:55.26,Default,,0,0,0,,Ооооооооооо...
Dialogue: 0,0:07:55.35,0:07:56.22,Default,,0,0,0,,Охххх...
Dialogue: 0,0:07:56.22,0:07:57.60,Default,,0,0,0,,Охххх... (шнурдың тартылған дыбысы)
Dialogue: 0,0:07:57.60,0:07:58.43,Default,,0,0,0,,Охххх...
Dialogue: 0,0:07:58.52,0:08:01.27,Default,,0,0,0,,Уа!(Хилл Демон) Гяаааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:08:01.35,0:08:04.06,Default,,0,0,0,,Ууууууууууууууууууу...
Dialogue: 0,0:08:04.15,0:08:08.32,Default,,0,0,0,,(Денжи) Ха ха ха ха...
Dialogue: 0,0:08:08.40,0:08:13.32,Default,,0,0,0,,Бәрің де менің істеп жатқаныма менсінбей қарайсыңдар...
Dialogue: 0,0:08:13.41,0:08:18.08,Default,,0,0,0,,КекМен бұзауды және отбасымды қорғағым келеді. Мен мысықты құтқарғым келеді.
Dialogue: 0,0:08:18.16,0:08:20.08,Default,,0,0,0,,Ахдано Кодано
Dialogue: 0,0:08:20.16,0:08:23.21,Default,,0,0,0,,Әр адамның үлкен армандары бар деп үміттенемін!
Dialogue: 0,0:08:23.29,0:08:26.08,Default,,0,0,0,,Олай болса, арман шайқасын көрейік! Арман шайқасы!
Dialogue: 0,0:08:26.17,0:08:28.96,Default,,0,0,0,,Мен сені өлтіргім келеді.
Dialogue: 0,0:08:29.05,0:08:32.59,Default,,0,0,0,,Теменің арманы кеудесін уқалаудан басқа ештеңе емес!
Dialogue: 0,0:08:32.67,0:08:34.51,Default,,0,0,0,,Ол үрген кезде сүйкімді
Dialogue: 0,0:08:34.59,0:08:36.89,Default,,0,0,0,,Күшіктей үреді, үреді, уф, уф, уф!
Dialogue: 0,0:08:36.97,0:08:40.22,Default,,0,0,0,,Жарайды, мен жеймін!
Dialogue: 0,0:08:40.31,0:08:46.15,Default,,0,0,0,,(Денжи) Ухаха... Бұл тамаша.Армандағы шайқаста жеңіске жетуіңізге тілектеспін!
Dialogue: 0,0:08:46.23,0:08:48.73,Default,,0,0,0,,Нуфуфуфу
Dialogue: 0,0:08:48.82,0:08:51.61,Default,,0,0,0,,Уф... (Денжи) Уф... Уф
Dialogue: 0,0:08:51.69,0:08:53.28,Default,,0,0,0,,(Сілік шайтан) Нуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:08:53.99,0:08:54.82,Default,,0,0,0,,А...
Dialogue: 0,0:08:54.91,0:08:57.78,Default,,0,0,0,,Хмф… Хмф…
Dialogue: 0,0:08:57.87,0:09:00.91,Default,,0,0,0,,Уф ха ха ха ха...
Dialogue: 0,0:09:00.99,0:09:03.08,Default,,0,0,0,,Арх...
Dialogue: 0,0:09:03.16,0:09:05.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:06.21,0:09:07.33,Default,,0,0,0,,Уау
Dialogue: 0,0:09:08.00,0:09:12.17,Default,,0,0,0,,(Денджи) Уф!(Сілік жын) Гяаааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:12.26,0:09:14.05,Default,,0,0,0,,Уф, уф (Денжи) Уф, уф
Dialogue: 0,0:09:14.13,0:09:15.88,Default,,0,0,0,,(Хилл Демон) Уф (Денжи) Уф...
