Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.17,0:00:06.67,Default,,0,0,0,,Ячио-чан
Dialogue: 0,0:00:07.96,0:00:09.71,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,0:00:11.01,0:00:14.97,Default,,0,0,0,,♪～
Dialogue: 0,0:00:55.89,0:01:00.89,Default,,0,0,0,,～♪
Dialogue: 0,0:01:02.85,0:01:05.31,Default,,0,0,0,,Бұл Понстин мырза.
Dialogue: 0,0:01:05.39,0:01:07.23,Default,,0,0,0,,Танысқаныма қуаныштымын, Ячио-сан
Dialogue: 0,0:01:07.31,0:01:10.15,Default,,0,0,0,,Мен әрқашан Понко-саннан естідім.
Dialogue: 0,0:01:10.23,0:01:11.69,Default,,0,0,0,,Понстин…
Dialogue: 0,0:01:12.28,0:01:14.99,Default,,0,0,0,,Біз үйленеміз бе?
Dialogue: 0,0:01:15.07,0:01:16.11,Default,,0,0,0,,Неке?
Dialogue: 0,0:01:16.20,0:01:17.11,Default,,0,0,0,,Иә
Dialogue: 0,0:01:17.20,0:01:19.45,Default,,0,0,0,,Мен Понконы міндетті түрде қуантамын.
Dialogue: 0,0:01:22.24,0:01:23.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:23.58,0:01:26.00,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:01:29.63,0:01:32.00,Default,,0,0,0,,Понстин!
Dialogue: 0,0:01:32.09,0:01:34.13,Default,,0,0,0,,Ах, аа... ха ха...
Dialogue: 0,0:01:34.22,0:01:36.01,Default,,0,0,0,,Ячио-чан, неге?
Dialogue: 0,0:01:36.88,0:01:39.14,Default,,0,0,0,,Мен Бунбуку-санды соққаннан бері.
Dialogue: 0,0:01:39.22,0:01:42.01,Default,,0,0,0,,Ракон тәрізді бөтен планета енді жұдырықтай алатын сияқты.
Dialogue: 0,0:01:42.10,0:01:45.60,Default,,0,0,0,,Сіздің жастық шағыңыз, бүлікшіл кезіңіз өткен күн емес пе?
Dialogue: 0,0:01:45.68,0:01:47.06,Default,,0,0,0,,Понко оны саған бермейді.
Dialogue: 0,0:01:47.85,0:01:49.73,Default,,0,0,0,,Понко - Gingarou қызметкері.
Dialogue: 0,0:01:49.81,0:01:51.61,Default,,0,0,0,,Менің қымбатты досым
Dialogue: 0,0:01:51.69,0:01:53.65,Default,,0,0,0,,Менеджер өкілі ретінде маған үндемеңіз.
Dialogue: 0,0:01:53.73,0:01:55.82,Default,,0,0,0,,Понконы отставкаға жібергіңіз келе ме?
Dialogue: 0,0:01:55.90,0:01:56.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:58.16,0:02:00.41,Default,,0,0,0,,Мен сені не үшін ұрғанымды енді түсіндім.
Dialogue: 0,0:02:00.49,0:02:01.49,Default,,0,0,0,,Міне
Dialogue: 0,0:02:01.58,0:02:04.58,Default,,0,0,0,,Мен бұл туралы ойланбай тұрып, мен бір қадам жасадым.
Dialogue: 0,0:02:04.66,0:02:06.12,Default,,0,0,0,,Иә
Dialogue: 0,0:02:06.21,0:02:08.29,Default,,0,0,0,,Жарайды, Ячио-чан.
Dialogue: 0,0:02:08.37,0:02:10.04,Default,,0,0,0,,Мен қонақүйден шықпаймын.
Dialogue: 0,0:02:11.09,0:02:12.29,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:02:12.38,0:02:13.92,Default,,0,0,0,,Әрине
Dialogue: 0,0:02:17.63,0:02:19.89,Default,,0,0,0,,Понко-сан Понстин-сан
Dialogue: 0,0:02:19.97,0:02:22.60,Default,,0,0,0,,Үйленуіңізбен құттықтаймыз.
Dialogue: 0,0:02:22.68,0:02:25.93,Default,,0,0,0,,Е, аа... рахмет
Dialogue: 0,0:02:28.06,0:02:30.23,Default,,0,0,0,,Понстин дәрігер ме?
Dialogue: 0,0:02:30.31,0:02:33.23,Default,,0,0,0,,Мен бастапқыда қонақүйдің қонағы болдым.
Dialogue: 0,0:02:33.32,0:02:37.40,Default,,0,0,0,,Мен әжем ауырып қалғалы бері қараймын.
Dialogue: 0,0:02:37.49,0:02:39.28,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:02:39.36,0:02:40.74,Default,,0,0,0,,Сіздің отбасыңыз ше?
Dialogue: 0,0:02:40.82,0:02:42.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:42.74,0:02:44.24,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:44.33,0:02:47.25,Default,,0,0,0,,Қанша рет келсең де, жақсы емес нәрсені істей алмайсың!
Dialogue: 0,0:02:47.33,0:02:50.37,Default,,0,0,0,,Мен саған қымбат қателігімді бермеймін!
Dialogue: 0,0:02:50.46,0:02:52.13,Default,,0,0,0,,Сабыр ет, Мами.
Dialogue: 0,0:02:52.21,0:02:55.13,Default,,0,0,0,,Кешіріңіз, Понстин мырза, бүгін үшін...
Dialogue: 0,0:02:55.21,0:02:56.30,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:02:57.17,0:02:58.42,Default,,0,0,0,,Сен!
Dialogue: 0,0:02:58.51,0:03:01.43,Default,,0,0,0,,Әке! Ахх...
Dialogue: 0,0:03:01.51,0:03:04.31,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:04.39,0:03:06.68,Default,,0,0,0,,Жарайды, Бунбуку-сан.
Dialogue: 0,0:03:07.27,0:03:09.60,Default,,0,0,0,,Понко-сан Джингаруды тастамайды.
Dialogue: 0,0:03:09.69,0:03:12.69,Default,,0,0,0,,Егер апам төлдеу кезеңін өткізіп алса, мен не істеуім керек?
Dialogue: 0,0:03:12.77,0:03:15.07,Default,,0,0,0,,Е, жоқ, әкемнен басқа...
Dialogue: 0,0:03:15.15,0:03:19.15,Default,,0,0,0,,(Мамидың жылағаны)
Dialogue: 0,0:03:19.24,0:03:21.20,Default,,0,0,0,,Мен де, шынымен...
Dialogue: 0,0:03:21.78,0:03:25.58,Default,,0,0,0,,Помпокопон…
Dialogue: 0,0:03:26.83,0:03:29.50,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:03:30.25,0:03:32.21,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:03:32.29,0:03:33.50,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:03:33.58,0:03:35.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:38.30,0:03:39.84,Default,,0,0,0,,Ячио-чан
Dialogue: 0,0:03:39.92,0:03:42.26,Default,,0,0,0,,Менің сізге бір өтінішім бар, тыңдай аласыз ба?
Dialogue: 0,0:03:42.34,0:03:44.30,Default,,0,0,0,,Енді соққылар жоқ
Dialogue: 0,0:03:44.39,0:03:46.81,Default,,0,0,0,,Мен соққы туралы айтып отырған жоқпын.
Dialogue: 0,0:03:46.89,0:03:49.60,Default,,0,0,0,,Мм... Понко және басқалар.
Dialogue: 0,0:03:49.68,0:03:53.06,Default,,0,0,0,,Мен Галактика мұнарасында Жер тойын өткізгім келеді.
Dialogue: 0,0:03:53.15,0:03:55.27,Default,,0,0,0,,Жұлдызды тойымызда
Dialogue: 0,0:03:55.36,0:03:57.19,Default,,0,0,0,,Өйткені жалғыз нұсқа - қалдықтарды айырбастау.
Dialogue: 0,0:03:59.32,0:04:00.57,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:00.65,0:04:01.82,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:01.90,0:04:03.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:05.16,0:04:06.66,Default,,0,0,0,,Әже
Dialogue: 0,0:04:06.74,0:04:10.33,Default,,0,0,0,,Әкем мен анам Понстинге үйленетінімді айтты.
Dialogue: 0,0:04:10.41,0:04:12.16,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:04:12.25,0:04:15.04,Default,,0,0,0,,Мен сені кешіруім керек еді.
Dialogue: 0,0:04:15.13,0:04:18.46,Default,,0,0,0,,Әкесі мен шешесі отау құрған кезде әже болды.
Dialogue: 0,0:04:18.55,0:04:20.09,Default,,0,0,0,,Бұл қандай болды?
Dialogue: 0,0:04:20.17,0:04:21.92,Default,,0,0,0,,Кенет Мәми келді
Dialogue: 0,0:04:22.01,0:04:25.47,Default,,0,0,0,,Себебі сен Бунбукуға үйленбекші.
Dialogue: 0,0:04:25.55,0:04:26.85,Default,,0,0,0,,Мен сені ұрдым.
Dialogue: 0,0:04:26.93,0:04:28.35,Default,,0,0,0,,Сенің анаң?
Dialogue: 0,0:04:28.43,0:04:29.85,Default,,0,0,0,,Жоқ, Бунбуку.
Dialogue: 0,0:04:29.93,0:04:32.77,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:04:32.85,0:04:36.40,Default,,0,0,0,,Әйтеуір, Понко үйленеді...
Dialogue: 0,0:04:37.19,0:04:41.86,Default,,0,0,0,,Жақында ит бала едің.
Dialogue: 0,0:04:41.94,0:04:44.61,Default,,0,0,0,,Хехе, не болды! (Понко жылайды)
Dialogue: 0,0:04:44.70,0:04:46.87,Default,,0,0,0,,Қайтарыңыз~ (Дануки сәби) Эй, эй
Dialogue: 0,0:04:46.95,0:04:48.62,Default,,0,0,0,,(Мужинаның ізі)
Dialogue: 0,0:04:52.00,0:04:54.96,Default,,0,0,0,,Тенказу болғың келмесе, жапырағыңнан қалма!
Dialogue: 0,0:04:55.04,0:04:57.08,Default,,0,0,0,,Мойынды жуып, қайтып кел (балалар жылап жатыр)
Dialogue: 0,0:04:59.67,0:05:01.51,Default,,0,0,0,,О, сүйкімді
Dialogue: 0,0:05:01.59,0:05:04.97,Default,,0,0,0,,Сүйікті Дануки Бұл сүйікті Дануки.
Dialogue: 0,0:05:05.05,0:05:07.59,Default,,0,0,0,,Оны сізге әжеңіз жасап берді ме?
Dialogue: 0,0:05:08.22,0:05:09.51,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:05:09.60,0:05:12.39,Default,,0,0,0,,(Понконың айқайы)
Dialogue: 0,0:05:12.47,0:05:15.10,Default,,0,0,0,,Мен құладым деп жыламаймын.
Dialogue: 0,0:05:16.44,0:05:20.82,Default,,0,0,0,,Понко Мұңайсаң, бірге тойлайық.
Dialogue: 0,0:05:20.90,0:05:21.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:21.86,0:05:24.53,Default,,0,0,0,,♪ тете
Dialogue: 0,0:05:25.20,0:05:28.41,Default,,0,0,0,,♪ Кеңейту
Dialogue: 0,0:05:28.49,0:05:33.41,Default,,0,0,0,,♪ Барабан
Dialogue: 0,0:05:33.50,0:05:35.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:35.33,0:05:38.67,Default,,0,0,0,,♪ Кімге
Dialogue: 0,0:05:38.75,0:05:42.09,Default,,0,0,0,,♪ жету
Dialogue: 0,0:05:42.17,0:05:43.01,Default,,0,0,0,,♪ Бұл үн
Dialogue: 0,0:05:43.01,0:05:44.67,Default,,0,0,0,,♪ Бұл тон
Dialogue: 0,0:05:43.01,0:05:44.67,Default,,0,0,0,,Понконың қалыңдық киімі
Dialogue: 0,0:05:44.67,0:05:45.72,Default,,0,0,0,,♪ Бұл тон
Dialogue: 0,0:05:45.72,0:05:47.51,Default,,0,0,0,,♪ Бұл үн
Dialogue: 0,0:05:45.72,0:05:47.51,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:05:48.09,0:05:49.51,Default,,0,0,0,,Иә
Dialogue: 0,0:05:50.35,0:05:52.14,Default,,0,0,0,,Сіз қандай түрді қалайсыз?
Dialogue: 0,0:05:52.22,0:05:54.39,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:05:56.19,0:05:58.48,Default,,0,0,0,,Бұл майлықты бүктеудің үлгісі.
Dialogue: 0,0:05:58.56,0:06:02.73,Default,,0,0,0,,Дельтаның шаршы секторы
Dialogue: 0,0:06:02.82,0:06:06.86,Default,,0,0,0,,Тәж пішіні Әріп пішіні Орам пішіні Қоян пішіні
Dialogue: 0,0:06:06.95,0:06:10.49,Default,,0,0,0,,Раушан лента жұлдызды кеме сиқыршысының қалпағы
Dialogue: 0,0:06:11.08,0:06:14.12,Default,,0,0,0,,Қай жаққа... (Понко) Маған бәрібір!
Dialogue: 0,0:06:14.20,0:06:15.62,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:06:16.21,0:06:17.96,Default,,0,0,0,,Мұның бәрі дәм татуға арналған.
Dialogue: 0,0:06:18.04,0:06:20.21,Default,,0,0,0,,Сіз қандай курсқа барғыңыз келеді?
Dialogue: 0,0:06:20.75,0:06:22.04,Default,,0,0,0,,Ол әйтеуір бас тарта ма еді?
Dialogue: 0,0:06:27.22,0:06:28.43,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:28.51,0:06:31.93,Default,,0,0,0,,Бұл Просионе ханым.
Dialogue: 0,0:06:32.01,0:06:34.60,Default,,0,0,0,,Бүгін мен тапсырыс беруші ретінде келдім.
Dialogue: 0,0:06:34.68,0:06:35.93,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:06:36.02,0:06:37.94,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:06:39.23,0:06:40.44,Default,,0,0,0,,Мужина мырза
Dialogue: 0,0:06:40.52,0:06:43.19,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет тұруға келдім.
Dialogue: 0,0:06:43.27,0:06:44.98,Default,,0,0,0,,Денсаулығыңыз қалай?
Dialogue: 0,0:06:45.07,0:06:48.07,Default,,0,0,0,,Сізге рахмет, мен өзімді әлдеқайда жақсы сезінемін.
Dialogue: 0,0:06:48.15,0:06:50.91,Default,,0,0,0,,Мен үйде төсекте қалатын едім.
Dialogue: 0,0:06:50.99,0:06:53.08,Default,,0,0,0,,Мен күткендей жалықтым.
Dialogue: 0,0:06:53.16,0:06:55.54,Default,,0,0,0,,Маған қарқынды өзгерту керек.
Dialogue: 0,0:06:55.62,0:06:56.95,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:06:57.04,0:07:02.71,Default,,0,0,0,,Сонымен қатар, мен Понконың жұмыс істеп жатқанын ешқашан көрмедім.
Dialogue: 0,0:07:02.79,0:07:04.34,Default,,0,0,0,,Иә
Dialogue: 0,0:07:04.42,0:07:07.76,Default,,0,0,0,,Енді орналастыру процедураларын аяқтайық.
Dialogue: 0,0:07:07.84,0:07:10.34,Default,,0,0,0,,Gingarou қонақ үйіне қош келдіңіз
Dialogue: 0,0:07:24.98,0:07:27.03,Default,,0,0,0,,Жақсы бол
Dialogue: 0,0:07:32.07,0:07:32.91,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:32.99,0:07:34.49,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:07:34.58,0:07:37.49,Default,,0,0,0,,Міне, бізде ол бар.
Dialogue: 0,0:07:37.58,0:07:40.54,Default,,0,0,0,,Сізді мәжбүрлегенім үшін кешіріңіз.
Dialogue: 0,0:07:40.62,0:07:42.37,Default,,0,0,0,,Біз оны дереу дайындаймыз.
Dialogue: 0,0:07:45.59,0:07:49.01,Default,,0,0,0,,Ячио-санға көп рахмет
Dialogue: 0,0:07:49.09,0:07:51.84,Default,,0,0,0,,Понконы барлығы тойлайды.
Dialogue: 0,0:07:51.93,0:07:54.01,Default,,0,0,0,,Мен бәрінен де бақыттымын.
Dialogue: 0,0:07:54.09,0:07:57.68,Default,,0,0,0,,Қонақ үй иесі ретінде табиғи болатын нәрсені жасау.
Dialogue: 0,0:07:57.76,0:07:58.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:58.97,0:08:00.35,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:00.43,0:08:03.19,Default,,0,0,0,,Понко үшін бұл табиғи емес.
Dialogue: 0,0:08:03.27,0:08:04.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:04.61,0:08:08.98,Default,,0,0,0,,Бізді туған планетамыздан қуып жібердік, солай емес пе?
Dialogue: 0,0:08:09.07,0:08:14.41,Default,,0,0,0,,Ол кезде мен қалыпты деп ойлағанның бәрін тастауға тура келді.
Dialogue: 0,0:08:14.49,0:08:15.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:18.37,0:08:20.58,Default,,0,0,0,,Егер бұл қонақүй болмаса
Dialogue: 0,0:08:20.66,0:08:25.75,Default,,0,0,0,,Біз оған шыдай беруіміз керек еді.
Dialogue: 0,0:08:28.17,0:08:32.34,Default,,0,0,0,,Шынымды айтсам, рахметімді қалай айтуым керек?
Dialogue: 0,0:08:34.38,0:08:38.18,Default,,0,0,0,,Біз де Понко-санды құттықтағанымызға қуаныштымыз.
Dialogue: 0,0:08:38.26,0:08:39.85,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:08:41.85,0:08:45.35,Default,,0,0,0,,Сіз тексергеннен кейін камераңызды тазалаймын.
Dialogue: 0,0:08:45.98,0:08:47.36,Default,,0,0,0,,Жазылған оптикалық жады
Dialogue: 0,0:08:47.44,0:08:49.82,Default,,0,0,0,,Осы жерге қойыңыз
Dialogue: 0,0:08:49.90,0:08:53.20,Default,,0,0,0,,Үйлену тойына дейін сіздің қамқорлығыңызға жауапты боламыз.
Dialogue: 0,0:08:53.28,0:08:54.95,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:55.61,0:08:58.16,Default,,0,0,0,,Уақытыңызды бөліп, демалыңыз.
Dialogue: 0,0:09:01.54,0:09:05.21,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:09:08.38,0:09:09.80,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:12.97,0:09:15.55,Default,,0,0,0,,Оны дереу ауруханаға жеткіземіз.
Dialogue: 0,0:09:15.63,0:09:17.80,Default,,0,0,0,,Жіберсем, бірден қайтамын.
Dialogue: 0,0:09:17.89,0:09:21.18,Default,,0,0,0,,Толығымен ескі Дануки сияқты емделді
Dialogue: 0,0:09:21.27,0:09:24.18,Default,,0,0,0,,Жарайды. Сақ болыңыз.
Dialogue: 0,0:09:26.35,0:09:30.69,Default,,0,0,0,,Ячио-сан, Понко туралы айтып берші.
Dialogue: 0,0:09:32.69,0:09:34.70,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:09:42.83,0:09:44.20,Default,,0,0,0,,Иә
Dialogue: 0,0:10:04.77,0:10:06.77,Default,,0,0,0,,Жақсы көрінеді.
Dialogue: 0,0:10:06.85,0:10:08.44,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:10:08.52,0:10:10.02,Default,,0,0,0,,Спутниктік деректерді қарау
Dialogue: 0,0:10:10.11,0:10:11.86,Default,,0,0,0,,Салтанатты күн шуақты.
Dialogue: 0,0:10:11.94,0:10:13.94,Default,,0,0,0,,Бұл тойлауға тамаша орын.
Dialogue: 0,0:10:14.03,0:10:15.44,Default,,0,0,0,,Мен өзімді жеңіл сезіндім.
Dialogue: 0,0:10:15.53,0:10:17.57,Default,,0,0,0,,(Фугуридің ауыр тыныс алуы)
Dialogue: 0,0:10:17.65,0:10:18.70,Default,,0,0,0,,Ячио-чан!
Dialogue: 0,0:10:18.78,0:10:20.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:23.79,0:10:30.21,Default,,0,0,0,,(Понконың айқайы)
Dialogue: 0,0:10:31.29,0:10:33.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:33.30,0:10:37.22,Default,,0,0,0,,(Понконың айқайы)
Dialogue: 0,0:10:41.51,0:10:43.22,Default,,0,0,0,,(конвертті ашу дыбысы)
Dialogue: 0,0:10:45.81,0:10:46.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.56,0:10:55.98,Default,,0,0,0,,Бас тарту керек екеніне сенімдісіз бе?
Dialogue: 0,0:10:56.99,0:10:59.99,Default,,0,0,0,,Алдымен мен әжемді шығарып салғым келеді.
Dialogue: 0,0:11:00.07,0:11:02.32,Default,,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,0:11:03.91,0:11:06.83,Default,,0,0,0,,Егер екеуің де солай айтсаңдар
Dialogue: 0,0:11:07.62,0:11:08.83,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:11:19.42,0:11:21.09,Default,,0,0,0,,Қонақ үй деп аталатын жер
Dialogue: 0,0:11:21.76,0:11:28.31,Default,,0,0,0,,Бұл сонымен қатар тұтынушылар жақындарымен ерекше уақыт өткізетін орын.
Dialogue: 0,0:11:28.39,0:11:30.10,Default,,0,0,0,,Арнайы…
Dialogue: 0,0:11:30.19,0:11:33.69,Default,,0,0,0,,Уақыт әрқашан өтеді.
Dialogue: 0,0:11:33.77,0:11:36.78,Default,,0,0,0,,Тек ерекше нәрсеге айналса
Dialogue: 0,0:11:36.86,0:11:41.61,Default,,0,0,0,,Сіз оны естелік ретінде жүрегіңізде сақтай алатын шығарсыз.
Dialogue: 0,0:11:42.41,0:11:46.83,Default,,0,0,0,,Менің ойымша, бұл қонақүй мұны істей алады.
Dialogue: 0,0:12:06.22,0:12:09.14,Default,,0,0,0,,Екеуіңе той жасағым келеді.
Dialogue: 0,0:12:09.22,0:12:10.64,Default,,0,0,0,,А... аа...
Dialogue: 0,0:12:11.23,0:12:14.86,Default,,0,0,0,,Понко-сан мен Понстин-санның уақыты басталады.
Dialogue: 0,0:12:14.94,0:12:17.86,Default,,0,0,0,,Мухина-санның жинаған уақыты
Dialogue: 0,0:12:17.94,0:12:19.90,Default,,0,0,0,,Біз оның ерекше болғанын қалаймыз.
Dialogue: 0,0:12:20.49,0:12:21.99,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:22.07,0:12:24.61,Default,,0,0,0,,Понко және басқалардың кетуімен
Dialogue: 0,0:12:24.70,0:12:26.49,Default,,0,0,0,,Мухинаның кетуі
Dialogue: 0,0:12:26.58,0:12:28.49,Default,,0,0,0,,Бірге тойлайық
Dialogue: 0,0:12:28.58,0:12:29.41,Default,,0,0,0,,А...
Dialogue: 0,0:12:29.49,0:12:32.41,Default,,0,0,0,,Мужина мырза да соны қалайды.
Dialogue: 0,0:12:32.50,0:12:34.17,Default,,0,0,0,,Әже?
Dialogue: 0,0:12:34.92,0:12:37.79,Default,,0,0,0,,Осыған қатысты хабарларды да қабылдаймыз.
Dialogue: 0,0:12:37.88,0:12:39.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:40.09,0:12:42.72,Default,,0,0,0,,Менің ойымша, бұл әдеттегі Мухина жоспары.
Dialogue: 0,0:12:42.80,0:12:45.01,Default,,0,0,0,,Әрқашан, кез келген уақытта
Dialogue: 0,0:12:47.30,0:12:50.06,Default,,0,0,0,,Ол қызыққұмар адам болған.
Dialogue: 0,0:12:51.31,0:12:52.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:53.81,0:12:58.06,Default,,0,0,0,,Понко Мұңайсаң, бірге тойлайық.
Dialogue: 0,0:13:04.24,0:13:05.07,Default,,0,0,0,,Иә
Dialogue: 0,0:13:06.07,0:13:09.12,Default,,0,0,0,,Ячио-чан, мен сенен бір жақсылық сұрасам болады ма?
Dialogue: 0,0:13:09.20,0:13:11.08,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:13:12.25,0:13:17.58,Default,,0,0,0,,Біздің қонақ үй сізге ең жақсы үйлену тойын қамтамасыз ету үшін бар күшімізді салады.
Dialogue: 0,0:13:19.79,0:13:21.09,Default,,0,0,0,,Айтпақшы, Понко-сан
Dialogue: 0,0:13:21.17,0:13:24.22,Default,,0,0,0,,Менің денем рәсіммен жазыла ма?
Dialogue: 0,0:13:35.06,0:13:36.27,Default,,0,0,0,,Иә
Dialogue: 0,0:13:37.23,0:13:39.19,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:13:39.27,0:13:40.65,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:13:40.73,0:13:43.65,Default,,0,0,0,,Бүгін келгендеріңізге рахмет.
Dialogue: 0,0:13:44.49,0:13:47.36,Default,,0,0,0,,Туыстар және басқа да байланысты тараптар
Dialogue: 0,0:13:47.45,0:13:51.83,Default,,0,0,0,,Қатысқаны үшін барлығына алғысымызды білдіреміз.
Dialogue: 0,0:13:54.75,0:13:58.71,Default,,0,0,0,,Күткеніңізге рахмет. Барлығы дайын сияқты.
Dialogue: 0,0:13:58.79,0:14:03.34,Default,,0,0,0,,Мені көрсеңдер, қошеметпен қарсы алыңдар.
Dialogue: 0,0:14:03.42,0:14:04.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:04.55,0:14:08.64,Default,,0,0,0,,Қалыңдық пен қалыңдықтың және қалыңдықтың әжесінің кіреберісі.
Dialogue: 0,0:14:08.72,0:14:15.14,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:14:15.23,0:14:22.15,Default,,0,0,0,,(Сутра оқу)
Dialogue: 0,0:14:30.74,0:14:32.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:34.20,0:14:35.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:44.17,0:14:45.46,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:14:45.55,0:14:48.93,Default,,0,0,0,,Күйеу Понштейн қалыңдық Понко
Dialogue: 0,0:14:49.01,0:14:51.80,Default,,0,0,0,,Келіннің әжесі Мужина
Dialogue: 0,0:14:51.89,0:14:55.14,Default,,0,0,0,,Үйлену тойы мен жаназаны өткіземіз.
Dialogue: 0,0:14:55.22,0:14:59.56,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:00.44,0:15:06.15,Default,,0,0,0,,Бүгінгі үйлену тойы мен жерлеу рәсіміне қатысқаныңыз үшін рахмет.
Dialogue: 0,0:15:06.23,0:15:08.07,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:08.15,0:15:09.74,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:12.12,0:15:13.74,Default,,0,0,0,,Шын мәнінде...
Dialogue: 0,0:15:15.24,0:15:19.46,Default,,0,0,0,,Мен әжемнің тірі болғанын қаладым.
Dialogue: 0,0:15:19.54,0:15:21.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:26.00,0:15:29.59,Default,,0,0,0,,Барлығы қалай? Мен әжемін
Dialogue: 0,0:15:29.67,0:15:30.93,Default,,0,0,0,,Не!
Dialogue: 0,0:15:33.89,0:15:35.89,Default,,0,0,0,,Сізді таң қалдырғаны үшін кешіріңіз.
Dialogue: 0,0:15:36.47,0:15:40.39,Default,,0,0,0,,Сондай-ақ, кенеттен өлгеніме қатты өкінемін.
Dialogue: 0,0:15:41.06,0:15:43.77,Default,,0,0,0,,Мен не айтып тұрмын?
Dialogue: 0,0:15:43.86,0:15:46.82,Default,,0,0,0,,Бүгін бәріміз үлкен мерекені тойлайық.
Dialogue: 0,0:15:46.90,0:15:50.86,Default,,0,0,0,,Қуанышты кездері де, қайғылы кездері де
Dialogue: 0,0:15:50.95,0:15:53.07,Default,,0,0,0,,Бірге тойлайық
Dialogue: 0,0:15:53.16,0:15:54.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:59.41,0:16:00.66,Default,,0,0,0,,Иә
Dialogue: 0,0:16:00.75,0:16:01.83,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:01.92,0:16:03.21,Default,,0,0,0,,Иә
Dialogue: 0,0:16:03.29,0:16:07.17,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:08.05,0:16:10.67,Default,,0,0,0,,Одан әрі бас аза айтушының сәлемдесу.
Dialogue: 0,0:16:11.68,0:16:15.14,Default,,0,0,0,,Ал, бүгін...
Dialogue: 0,0:16:15.22,0:16:17.51,Default,,0,0,0,,(Көз жасын ұстаған дауыс)
Dialogue: 0,0:16:19.27,0:16:22.31,Default,,0,0,0,,Ах~ Мен өз сезімдерімнен адасып қалдым
Dialogue: 0,0:16:22.39,0:16:26.48,Default,,0,0,0,,Ааа... Бүгін...
Dialogue: 0,0:16:29.23,0:16:30.78,Default,,0,0,0,,Иә
Dialogue: 0,0:16:30.86,0:16:34.99,Default,,0,0,0,,Бұл күйеу жігіт пен қалыңдықтың бірінші рет бірге жұмыс істеуі.
Dialogue: 0,0:16:35.07,0:16:37.24,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:37.33,0:16:39.79,Default,,0,0,0,,Сәлеметсіз бе! және тост
Dialogue: 0,0:16:39.87,0:16:42.25,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:48.29,0:16:53.51,Default,,0,0,0,,Үйлену үшін маңызды үш қап туралы айтқым келеді.
Dialogue: 0,0:16:53.59,0:16:55.05,Default,,0,0,0,,Біріншісі - Квинта...
Dialogue: 0,0:16:55.14,0:16:56.72,Default,,0,0,0,,Той құтты болсын!
Dialogue: 0,0:16:56.80,0:16:59.60,Default,,0,0,0,,Және RIP! Хаха
Dialogue: 0,0:16:59.68,0:17:03.69,Default,,0,0,0,,Келесі - дос өкілінің сиқыры.
Dialogue: 0,0:17:15.57,0:17:17.24,Default,,0,0,0,,Иә (Понко) Әже!
Dialogue: 0,0:17:17.32,0:17:22.79,Default,,0,0,0,,(қатысқандардың шуы)
Dialogue: 0,0:17:22.87,0:17:24.54,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:17:28.63,0:17:30.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:30.67,0:17:33.72,Default,,0,0,0,,О... уау
Dialogue: 0,0:17:38.39,0:17:40.68,Default,,0,0,0,,Пон Поко ломбарды!
Dialogue: 0,0:17:40.76,0:17:44.52,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:17:44.60,0:17:47.35,Default,,0,0,0,,Пон Поко ломбарды!
Dialogue: 0,0:17:49.98,0:17:51.32,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:52.82,0:17:55.20,Default,,0,0,0,,Түс өзгерту кезінде барлығы
Dialogue: 0,0:17:55.28,0:17:58.11,Default,,0,0,0,,Профильдік фильмді тамашалаңыз
Dialogue: 0,0:17:59.74,0:18:05.04,Default,,0,0,0,,(бейне музыка)
Dialogue: 0,0:18:18.13,0:18:19.30,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:18:28.14,0:18:30.06,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:31.98,0:18:33.02,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:18:33.11,0:18:35.69,Default,,0,0,0,,Иә, бұл өте қызық.
Dialogue: 0,0:18:35.78,0:18:37.95,Default,,0,0,0,,Әже ше?
Dialogue: 0,0:18:40.62,0:18:42.58,Default,,0,0,0,,Мен көңілді жүрмін
Dialogue: 0,0:18:43.41,0:18:44.83,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:18:44.91,0:18:49.71,Default,,0,0,0,,Күйеу мен қалыңдық Қалыңдық пен әже Жаңа киім
Dialogue: 0,0:18:49.79,0:18:52.29,Default,,0,0,0,,Шам арқылы кіру.
Dialogue: 0,0:18:57.05,0:18:59.97,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:00.05,0:19:01.72,Default,,0,0,0,,Хаха
Dialogue: 0,0:19:07.43,0:19:08.73,Default,,0,0,0,,Иә
Dialogue: 0,0:19:11.56,0:19:14.48,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:17.07,0:19:19.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:24.28,0:19:27.45,Default,,0,0,0,,Келіннің әжесінің тағы бір сөзі.
Dialogue: 0,0:19:27.54,0:19:30.25,Default,,0,0,0,,Біз қалыңдық пен күйеу жігітке арналған хабарламаларды сақтаймыз.
Dialogue: 0,0:19:31.37,0:19:32.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:33.59,0:19:35.84,Default,,0,0,0,,Понко Понстин
Dialogue: 0,0:19:35.92,0:19:40.68,Default,,0,0,0,,Үйленуіңізбен құттықтаймыз.
Dialogue: 0,0:19:42.26,0:19:46.68,Default,,0,0,0,,Бүгінгі көрермендерге үлкен рахмет.
Dialogue: 0,0:19:47.27,0:19:50.77,Default,,0,0,0,,Мен өз сөзімді осылай жеткізе аламын.
Dialogue: 0,0:19:50.85,0:19:53.44,Default,,0,0,0,,Барлығы Ячио-санға рахмет
Dialogue: 0,0:19:54.19,0:19:57.53,Default,,0,0,0,,Барлығымен бірге
Dialogue: 0,0:19:57.61,0:20:01.45,Default,,0,0,0,,Понко мен Понстинді құттықтауыңызды өтіндім.
Dialogue: 0,0:20:03.28,0:20:05.62,Default,,0,0,0,,Мен бұл планетаға келгенде
Dialogue: 0,0:20:05.70,0:20:09.50,Default,,0,0,0,,Мен шынымен тыныш өмір сүре аламын ба деп уайымдадым.
Dialogue: 0,0:20:09.58,0:20:12.42,Default,,0,0,0,,Күн сайын Galaxy Tower-те барлығымен бірге
Dialogue: 0,0:20:12.50,0:20:16.46,Default,,0,0,0,,Көңілді, жанды, тамаша болды.
Dialogue: 0,0:20:17.05,0:20:21.17,Default,,0,0,0,,Мен өте өте өте өте қаттымын
Dialogue: 0,0:20:21.26,0:20:22.97,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:20:24.01,0:20:28.97,Default,,0,0,0,,Понко Менің сүйкімді немерем Дануки
Dialogue: 0,0:20:29.06,0:20:31.14,Default,,0,0,0,,Біз осылай сөйлесіп жатқанда
Dialogue: 0,0:20:31.23,0:20:34.48,Default,,0,0,0,,Көп естеліктер ойыма оралады
Dialogue: 0,0:20:35.23,0:20:36.73,Default,,0,0,0,,Әже...
Dialogue: 0,0:20:37.36,0:20:40.99,Default,,0,0,0,,Понко, мұны ұмытпа.
Dialogue: 0,0:20:41.74,0:20:45.53,Default,,0,0,0,,Күнделікті шаш күтімін жасау керек
Dialogue: 0,0:20:45.62,0:20:47.12,Default,,0,0,0,,Қанша ұйықтасаң да
Dialogue: 0,0:20:47.20,0:20:49.20,Default,,0,0,0,,Ұйықтар алдында басыңдағы жапырақтар
Dialogue: 0,0:20:49.29,0:20:51.62,Default,,0,0,0,,Күтім
Dialogue: 0,0:20:52.66,0:20:53.96,Default,,0,0,0,,Және
Dialogue: 0,0:20:54.04,0:20:58.46,Default,,0,0,0,,Әжеден бақытты болу
Dialogue: 0,0:21:00.05,0:21:03.13,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:21:05.97,0:21:08.39,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:09.06,0:21:10.81,Default,,0,0,0,,Соңында
Dialogue: 0,0:21:10.89,0:21:15.69,Default,,0,0,0,,Туған жерімнің жұлдызына жеткен бұл әнді жіберемін.
Dialogue: 0,0:21:16.65,0:21:19.15,Default,,0,0,0,,♪ Өтете
Dialogue: 0,0:21:19.94,0:21:23.15,Default,,0,0,0,,♪ Кеңейту
Dialogue: 0,0:21:23.24,0:21:28.37,Default,,0,0,0,,♪ Барабан
Dialogue: 0,0:21:29.87,0:21:33.41,Default,,0,0,0,,♪ Кімге
Dialogue: 0,0:21:33.50,0:21:36.83,Default,,0,0,0,,♪ жету
Dialogue: 0,0:21:36.92,0:21:42.34,Default,,0,0,0,,♪ Бұл тон
Dialogue: 0,0:21:43.38,0:21:47.01,Default,,0,0,0,,♪ Бір понпоко
Dialogue: 0,0:21:47.09,0:21:50.05,Default,,0,0,0,,♪ Пон Поко екі
Dialogue: 0,0:21:50.89,0:21:56.06,Default,,0,0,0,,♪ Тастар мен шөптерді итеріңіз
Dialogue: 0,0:21:57.23,0:22:00.52,Default,,0,0,0,,♪ Понпоко үш
Dialogue: 0,0:22:00.61,0:22:04.28,Default,,0,0,0,,♪ Пон Поко төрт
Dialogue: 0,0:22:04.36,0:22:08.99,Default,,0,0,0,,♪ Жаңбыр мен желге ұшырамаңыз
Dialogue: 0,0:22:09.07,0:22:12.58,Default,,0,0,0,,♪ Понпон
Dialogue: 0,0:22:14.08,0:22:17.33,Default,,0,0,0,,♪ Такуку
Dialogue: 0,0:22:17.42,0:22:20.75,Default,,0,0,0,,♪ Жарық
Dialogue: 0,0:22:20.84,0:22:25.59,Default,,0,0,0,,♪ Барабан
Dialogue: 0,0:22:27.63,0:22:30.89,Default,,0,0,0,,♪ Қазір
Dialogue: 0,0:22:30.97,0:22:34.31,Default,,0,0,0,,♪ Tooi
Dialogue: 0,0:22:34.39,0:22:35.22,Default,,0,0,0,,♪ Сол аспанға
Dialogue: 0,0:22:35.22,0:22:36.85,Default,,0,0,0,,♪ Сол аспанға
Dialogue: 0,0:22:35.22,0:22:36.85,Default,,0,0,0,,Ячио-чан
Dialogue: 0,0:22:36.85,0:22:37.56,Default,,0,0,0,,♪ Сол аспанға
Dialogue: 0,0:22:37.56,0:22:40.19,Default,,0,0,0,,♪ Сол аспанға
Dialogue: 0,0:22:37.56,0:22:40.19,Default,,0,0,0,,Мен мұны істегеніме қуаныштымын
Dialogue: 0,0:22:41.90,0:22:42.86,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:22:48.03,0:22:50.87,Default,,0,0,0,,Құттықтаймын, Понко-сан
Dialogue: 0,0:22:55.83,0:22:57.83,Default,,0,0,0,,(іштің діріл дыбысы)
