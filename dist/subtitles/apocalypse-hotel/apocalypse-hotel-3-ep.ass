Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.79,0:00:02.79,Default,,0,0,0,,Енді әрбір жауапты адамнан.
Dialogue: 0,0:00:02.87,0:00:06.00,Default,,0,0,0,,(Тазалау роботтарының дауыстары)
Dialogue: 0,0:00:06.09,0:00:07.38,Default,,0,0,0,,Иә
Dialogue: 0,0:00:07.46,0:00:10.26,Default,,0,0,0,,Соңғы рет 100 жылда бірінші рет тұтынушыға ие болдық
Dialogue: 0,0:00:10.34,0:00:12.13,Default,,0,0,0,,50 жылға жуықтап қалды
Dialogue: 0,0:00:12.22,0:00:14.64,Default,,0,0,0,,(Көкөніс өсіруге жауапты роботтың дауысы)
Dialogue: 0,0:00:14.72,0:00:15.89,Default,,0,0,0,,Иә
Dialogue: 0,0:00:15.97,0:00:18.56,Default,,0,0,0,,Біз бір рет 100 жыл күттік.
Dialogue: 0,0:00:18.64,0:00:20.64,Default,,0,0,0,,Тағы 50 жыл күтейік
Dialogue: 0,0:00:21.23,0:00:22.56,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:00:22.64,0:00:24.52,Default,,0,0,0,,(роботтардың дауысы)
Dialogue: 0,0:00:24.60,0:00:28.98,Default,,0,0,0,,Бүгін де тұтынушыларымызды күлімдеп қарсы алайық.
Dialogue: 0,0:00:29.07,0:00:33.90,Default,,0,0,0,,Біздің сүйікті тұтынушыларымызға, шын жүректен күн және ең жақсы күлкі
Dialogue: 0,0:00:37.70,0:00:38.99,Default,,0,0,0,,Сәлем Ячиё!
Dialogue: 0,0:00:40.08,0:00:40.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:41.00,0:00:42.87,Default,,0,0,0,,Бас тарту жаман.
Dialogue: 0,0:00:42.96,0:00:45.75,Default,,0,0,0,,Магма ыстық бұлақтың алдынан шығады.
Dialogue: 0,0:00:45.83,0:00:46.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:46.75,0:00:50.21,Default,,0,0,0,,Қоршаған ортаны тексеру роботы да бақылауды жалғастыруда.
Dialogue: 0,0:00:50.30,0:00:51.67,Default,,0,0,0,,Біз ортақпыз.
Dialogue: 0,0:00:52.26,0:00:53.51,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:00:53.59,0:00:56.93,Default,,0,0,0,,Сен де, мен де жанбайтын ақымақпыз.
Dialogue: 0,0:00:57.01,0:01:00.68,Default,,0,0,0,,Қанша талпынсаң да, күткендер үйіне қайтпайды.
Dialogue: 0,0:01:04.27,0:01:06.19,Default,,0,0,0,,Не... не?
Dialogue: 0,0:01:11.98,0:01:16.99,Default,,0,0,0,,♪～
Dialogue: 0,0:02:36.94,0:02:41.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:44.54,0:02:46.66,Default,,0,0,0,,Адамзат қайта оралды емес пе?
Dialogue: 0,0:02:46.75,0:02:49.08,Default,,0,0,0,,Осылай жүру ыңғайлы ма?
Dialogue: 0,0:02:50.33,0:02:51.50,Default,,0,0,0,,Ах
Dialogue: 0,0:02:53.34,0:02:55.80,Default,,0,0,0,,Ол адамға өте ұқсайды.
Dialogue: 0,0:02:55.88,0:02:56.80,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:03:00.80,0:03:03.55,Default,,0,0,0,,Қара, қара, мынау... Қара, мынау...
Dialogue: 0,0:03:03.64,0:03:05.97,Default,,0,0,0,,Фигуралар ұқсас екені рас, бірақ...
Dialogue: 0,0:03:07.89,0:03:10.48,Default,,0,0,0,,Біз Жер тұрғындарымыз
Dialogue: 0,0:03:10.56,0:03:12.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:12.61,0:03:15.52,Default,,0,0,0,,Біз сіздің оралуыңызды күтеміз.
Dialogue: 0,0:03:15.61,0:03:17.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:19.24,0:03:20.78,Default,,0,0,0,,иә... хе хе
Dialogue: 0,0:03:21.95,0:03:23.74,Default,,0,0,0,,Хмф... (Понко) Хмф!
Dialogue: 0,0:03:26.16,0:03:28.79,Default,,0,0,0,,...
Dialogue: 0,0:03:28.87,0:03:31.21,Default,,0,0,0,,Көріп тұрғаныңыздай, мен жердікпін.
Dialogue: 0,0:03:31.29,0:03:33.71,Default,,0,0,0,,Біріншіден, бұл әйел менің әйелім.
Dialogue: 0,0:03:33.79,0:03:36.42,Default,,0,0,0,,Мен Мәмимін, мен жердегімін.
Dialogue: 0,0:03:36.50,0:03:38.84,Default,,0,0,0,,Кішкентай ұрғашы қыз
Dialogue: 0,0:03:38.92,0:03:40.88,Default,,0,0,0,,Мен Понкомын, жердегімін.
Dialogue: 0,0:03:42.34,0:03:44.64,Default,,0,0,0,,Кішкентай ер - ұл
Dialogue: 0,0:03:44.72,0:03:47.14,Default,,0,0,0,,Мен Фугуримін. Мен тануки бөтен адаммын.
Dialogue: 0,0:03:48.47,0:03:49.64,Default,,0,0,0,,Фугури
Dialogue: 0,0:03:49.73,0:03:51.69,Default,,0,0,0,,Сен жер адаммын дейсің ғой, солай ма?
Dialogue: 0,0:03:51.77,0:03:55.31,Default,,0,0,0,,Ал өтірік айтсаң, мен отын төгіп, от жағамын...
Dialogue: 0,0:03:55.40,0:03:58.07,Default,,0,0,0,,Енді жақсы, мен қазір от жақпаймын.
Dialogue: 0,0:03:58.15,0:03:59.65,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:03:59.74,0:04:01.57,Default,,0,0,0,,Маған дұрыс айтпасаң
Dialogue: 0,0:04:01.65,0:04:03.95,Default,,0,0,0,,Мен сені дұрыс оқыттым.
Dialogue: 0,0:04:04.03,0:04:05.78,Default,,0,0,0,,Өйткені сіз әрқашан Фугуриді қорқытасыз
Dialogue: 0,0:04:05.87,0:04:07.45,Default,,0,0,0,,Қарындасыңның көзіне қара, Фугури
Dialogue: 0,0:04:07.53,0:04:10.45,Default,,0,0,0,,Айтпасам далада өлемін. Мен өмір сүремін.
Dialogue: 0,0:04:10.54,0:04:12.50,Default,,0,0,0,,Мен өлемін.
Dialogue: 0,0:04:12.58,0:04:13.87,Default,,0,0,0,,Содан кейін айтыңыз.
Dialogue: 0,0:04:13.96,0:04:16.54,Default,,0,0,0,,････
Dialogue: 0,0:04:17.96,0:04:18.92,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:04:19.00,0:04:21.30,Default,,0,0,0,,(сыбырлаған дауыс)
Dialogue: 0,0:04:23.72,0:04:26.18,Default,,0,0,0,,Мен Фугуримін. Мен жердікпін.
Dialogue: 0,0:04:26.26,0:04:28.76,Default,,0,0,0,,Мен адасқан адам болғым келмейді. Мен өмір сүргім келеді.
Dialogue: 0,0:04:30.14,0:04:32.39,Default,,0,0,0,,Жоқ, сіз құйрық өсірдіңіз.
Dialogue: 0,0:04:32.48,0:04:33.64,Default,,0,0,0,,Ах
Dialogue: 0,0:04:34.98,0:04:37.15,Default,,0,0,0,,Менің ағам – жерлік.
Dialogue: 0,0:04:38.48,0:04:41.32,Default,,0,0,0,,Мұқият қарасаң, басыңа жапырақ кептеліп тұр...
Dialogue: 0,0:04:41.40,0:04:42.70,Default,,0,0,0,,Мен жердікпін!
Dialogue: 0,0:04:42.78,0:04:45.03,Default,,0,0,0,,Бұл балалар... (Понко/Фугури) Ах.
Dialogue: 0,0:04:46.12,0:04:48.74,Default,,0,0,0,,Менің әжем
Dialogue: 0,0:04:48.83,0:04:51.29,Default,,0,0,0,,Менің атым Муджина.
Dialogue: 0,0:04:51.37,0:04:55.00,Default,,0,0,0,,Біз, Просиондар отбасы
Dialogue: 0,0:04:55.08,0:04:58.42,Default,,0,0,0,,Көріп отырғаныңыздай, барлығы...
Dialogue: 0,0:04:58.50,0:05:01.38,Default,,0,0,0,,Мен жердегімін.
Dialogue: 0,0:05:01.46,0:05:02.59,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:02.67,0:05:04.76,Default,,0,0,0,,Әженің қысымы
Dialogue: 0,0:05:04.84,0:05:06.59,Default,,0,0,0,,Бұл үлкен отбасы.
Dialogue: 0,0:05:06.68,0:05:07.80,Default,,0,0,0,,Егер сіз тұратын жер
Dialogue: 0,0:05:07.89,0:05:09.81,Default,,0,0,0,,Егер сіз әлі шешпеген болсаңыз
Dialogue: 0,0:05:09.89,0:05:13.14,Default,,0,0,0,,Біздің қонақ үйге келіңіз.
Dialogue: 0,0:05:13.23,0:05:15.35,Default,,0,0,0,,Бұл қонақ үй ме?
Dialogue: 0,0:05:15.44,0:05:16.90,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:05:16.98,0:05:19.15,Default,,0,0,0,,Ғарыш кемесі қатты зақымдалған.
Dialogue: 0,0:05:19.23,0:05:22.03,Default,,0,0,0,,Мен не істерімді ойлап отыр едім.
Dialogue: 0,0:05:22.11,0:05:24.90,Default,,0,0,0,,Біз сіздің бөлмеңізді дереу дайындаймыз.
Dialogue: 0,0:05:26.16,0:05:27.74,Default,,0,0,0,,Дұрыс тексерген дұрыс
Dialogue: 0,0:05:27.82,0:05:29.66,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:05:30.37,0:05:32.79,Default,,0,0,0,,Шынында да, бұл рас.
Dialogue: 0,0:05:32.87,0:05:35.16,Default,,0,0,0,,(Бумбуку мен оның достарының үрейлі дауыстары)
Dialogue: 0,0:05:35.25,0:05:36.54,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:05:36.62,0:05:37.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:37.88,0:05:40.04,Default,,0,0,0,,Сізде тұруға ақша бар ма?
Dialogue: 0,0:05:40.13,0:05:43.05,Default,,0,0,0,,Иә, өйткені мен жердегімін.
Dialogue: 0,0:05:43.13,0:05:45.17,Default,,0,0,0,,Жарайды, осылайша менімен бірге жүріңіз.
Dialogue: 0,0:05:47.18,0:05:49.18,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:05:52.64,0:05:54.93,Default,,0,0,0,,Бұл біздің қонақ үй.
Dialogue: 0,0:05:55.02,0:05:58.19,Default,,0,0,0,,Бұл өте тамаша.
Dialogue: 0,0:05:58.27,0:06:01.69,Default,,0,0,0,,Шынымен... Соншалықты шалғай жер болса да.
Dialogue: 0,0:06:01.77,0:06:04.11,Default,,0,0,0,,Мен тесікті жақсы көремін.
Dialogue: 0,0:06:04.19,0:06:06.24,Default,,0,0,0,,Қай жерде болсаңыз да өмір сүру үшін бар күшіңізді салыңыз
Dialogue: 0,0:06:06.32,0:06:07.61,Default,,0,0,0,,Хахан
Dialogue: 0,0:06:07.70,0:06:10.41,Default,,0,0,0,,Эй, кішкентай қыз, мен сенбеймін...
Dialogue: 0,0:06:10.49,0:06:15.08,Default,,0,0,0,,Иә, адамзат... және топтық тұтынушы.
Dialogue: 0,0:06:15.16,0:06:19.46,Default,,0,0,0,,Маған қалдырыңыз, мен сізге есік ашудың ең жақсы жолын көрсетемін.
Dialogue: 0,0:06:25.05,0:06:27.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:27.84,0:06:29.51,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:31.10,0:06:34.18,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:06:34.26,0:06:37.02,Default,,0,0,0,,Gingarou қонақ үйіне қош келдіңіз
Dialogue: 0,0:06:37.10,0:06:41.02,Default,,0,0,0,,Менің атым Ячио, мен қонақүйде жұмыс істеймін.
Dialogue: 0,0:06:41.11,0:06:43.19,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:06:43.27,0:06:45.15,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:06:45.73,0:06:47.32,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:06:47.40,0:06:51.03,Default,,0,0,0,,Осы тұру тізімін толтырыңыз.
Dialogue: 0,0:06:51.12,0:06:52.03,Default,,0,0,0,,О, ау
Dialogue: 0,0:06:52.12,0:06:55.29,Default,,0,0,0,,Сіз бізді осылай сынап жатырсыз ба?
Dialogue: 0,0:06:55.37,0:06:57.16,Default,,0,0,0,,Байқау деген нені білдіреді?
Dialogue: 0,0:06:57.25,0:06:59.92,Default,,0,0,0,,Мен әріптерді дұрыс орындадым.
Dialogue: 0,0:07:00.00,0:07:01.79,Default,,0,0,0,,Осындай нәрсе болуы мүмкін бе деп ойлаймын.
Dialogue: 0,0:07:02.50,0:07:03.79,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:07:03.88,0:07:05.80,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:07:06.88,0:07:08.30,Default,,0,0,0,,(роботтардың дауыстары)
Dialogue: 0,0:07:08.38,0:07:11.30,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:07:11.39,0:07:12.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:12.89,0:07:14.39,Default,,0,0,0,,Бұл жақсы емес, солай ма?
Dialogue: 0,0:07:14.47,0:07:16.27,Default,,0,0,0,,Ол жұмысын тоқтатты
Dialogue: 0,0:07:16.35,0:07:17.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:17.64,0:07:19.06,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:21.15,0:07:23.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:23.65,0:07:24.77,Default,,0,0,0,,жазды
Dialogue: 0,0:07:24.86,0:07:26.57,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:32.41,0:07:35.41,Default,,0,0,0,,Енді мен саған бөлме алып беремін.
Dialogue: 0,0:07:35.49,0:07:37.83,Default,,0,0,0,,Сіз қанша күн боласыз?
Dialogue: 0,0:07:37.91,0:07:40.33,Default,,0,0,0,,Әзірге шамамен 300 күн.
Dialogue: 0,0:07:40.41,0:07:42.88,Default,,0,0,0,,Бұл ұзақ мерзімді болу жоспары Иә.
Dialogue: 0,0:07:42.96,0:07:46.71,Default,,0,0,0,,Бұл жағдайда алдын ала депозит талап етіледі.
Dialogue: 0,0:07:46.80,0:07:47.63,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:47.71,0:07:50.72,Default,,0,0,0,,300 күн тұрсаңыз, алғашқы 30 күн...
Dialogue: 0,0:07:50.80,0:07:51.72,Default,,0,0,0,,7 күннен кейін
Dialogue: 0,0:07:51.80,0:07:52.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:52.80,0:07:53.72,Default,,0,0,0,,7 күннен кейін
Dialogue: 0,0:07:55.10,0:07:56.72,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:07:56.81,0:08:00.06,Default,,0,0,0,,Егер сіз отбасы болсаңыз, екі қарапайым бөлмеңіз бар ма?
Dialogue: 0,0:08:00.14,0:08:02.27,Default,,0,0,0,,немесе сәл қымбатырақ
Dialogue: 0,0:08:02.35,0:08:05.11,Default,,0,0,0,,Бізде үлкен люкс бөлмелері де бар.
Dialogue: 0,0:08:05.19,0:08:06.61,Default,,0,0,0,,Үлкенірек жағында
Dialogue: 0,0:08:07.19,0:08:09.44,Default,,0,0,0,,Себебі желі ажыратылған
Dialogue: 0,0:08:09.53,0:08:11.90,Default,,0,0,0,,Төлемді тек қолма-қол ақшамен жасауға болады.
Dialogue: 0,0:08:11.99,0:08:13.41,Default,,0,0,0,,(Есік ашылған дыбыс) (Recovery Girl) Қарым-қатынас дағдылары
Dialogue: 0,0:08:13.49,0:08:16.41,Default,,0,0,0,,Жақсы, мен Жерлікпін.
Dialogue: 0,0:08:16.49,0:08:19.91,Default,,0,0,0,,Біз сіздің багажыңызды бөлмеңізге апарамыз.
Dialogue: 0,0:08:20.00,0:08:21.29,Default,,0,0,0,,(Porter Robo дауысы)
Dialogue: 0,0:08:22.37,0:08:24.79,Default,,0,0,0,,Понко Фугури кеттік
Dialogue: 0,0:08:24.88,0:08:26.21,Default,,0,0,0,,Йойшо Йойшо
Dialogue: 0,0:08:26.29,0:08:27.29,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:08:27.38,0:08:31.92,Default,,0,0,0,,Enerf!
Dialogue: 0,0:08:32.01,0:08:33.34,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:08:33.43,0:08:34.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:36.47,0:08:38.39,Default,,0,0,0,,(Трансформация дыбысы шығарылады)
Dialogue: 0,0:08:42.02,0:08:43.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:44.44,0:08:45.81,Default,,0,0,0,,Адамгершілік емес
Dialogue: 0,0:08:45.90,0:08:47.81,Default,,0,0,0,,Сондықтан мен айттым.
Dialogue: 0,0:08:49.78,0:08:51.94,Default,,0,0,0,,Сіз бөтен раконсыз ба?
Dialogue: 0,0:08:52.03,0:08:55.70,Default,,0,0,0,,Менің ойымша, бұл планета тіліндегі ең жақын өрнек.
Dialogue: 0,0:08:56.66,0:08:58.24,Default,,0,0,0,,Оны тек қазанға салмаңыз
Dialogue: 0,0:08:58.33,0:09:00.24,Default,,0,0,0,,Мен оны жемеймін.
Dialogue: 0,0:09:00.33,0:09:03.25,Default,,0,0,0,,Сонымен... сіз бір жерге бара жатырсыз ба?
Dialogue: 0,0:09:03.33,0:09:07.33,Default,,0,0,0,,Жоқ Әу бастан біздің баратын жеріміз Жер болды.
Dialogue: 0,0:09:07.42,0:09:10.21,Default,,0,0,0,,Климаты менің туған жеріме ұқсас болды, сондықтан
Dialogue: 0,0:09:10.30,0:09:13.63,Default,,0,0,0,,Понко мен басқаларының қайтатын үйлері жоқ.
Dialogue: 0,0:09:13.72,0:09:15.88,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:17.01,0:09:20.35,Default,,0,0,0,,Біздің планетада шымтезек соғысы жүріп жатыр.
Dialogue: 0,0:09:21.01,0:09:24.35,Default,,0,0,0,,Менің қашудан басқа амалым қалмады.
Dialogue: 0,0:09:24.43,0:09:27.52,Default,,0,0,0,,Эвакуацияланатын жер іздеп қаңғып жүргенде
Dialogue: 0,0:09:27.60,0:09:29.52,Default,,0,0,0,,Жердің бар екенін білу
Dialogue: 0,0:09:29.61,0:09:32.61,Default,,0,0,0,,Мен бұл планетада демалуға болатын уақытты өткізе аламын деп ойлаймын
Dialogue: 0,0:09:32.69,0:09:35.49,Default,,0,0,0,,Бірақ ғарыш кемесі бұзылады.
Dialogue: 0,0:09:35.57,0:09:37.61,Default,,0,0,0,,Балалар сендер де осындасыңдар.
Dialogue: 0,0:09:38.95,0:09:42.24,Default,,0,0,0,,Егер бұл орын алса, аман қалу үшін мұны істеуден басқа амалыңыз жоқ.
Dialogue: 0,0:09:42.33,0:09:45.25,Default,,0,0,0,,Біз енді жердікпіз.
Dialogue: 0,0:09:45.33,0:09:48.25,Default,,0,0,0,,Сонымен мен адаммын деп өтірік айттым.
Dialogue: 0,0:09:48.33,0:09:51.25,Default,,0,0,0,,Өтірік айтқаным үшін кешірім сұраймын.
Dialogue: 0,0:09:51.34,0:09:53.76,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:09:53.84,0:09:55.47,Default,,0,0,0,,Біз бұл балаларды қалаймыз
Dialogue: 0,0:09:55.55,0:10:00.14,Default,,0,0,0,,Мен оның кемеде емес, еркін өскенін қаладым.
Dialogue: 0,0:10:00.22,0:10:01.97,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:02.06,0:10:03.85,Default,,0,0,0,,Ғарыш кемесі жөнделгенше
Dialogue: 0,0:10:03.93,0:10:07.02,Default,,0,0,0,,Маған осында қалуға рұқсат бере аласыз ба?
Dialogue: 0,0:10:10.31,0:10:12.27,Default,,0,0,0,,Біздің қонақ үй 50 жыл болды.
Dialogue: 0,0:10:12.36,0:10:16.19,Default,,0,0,0,,Шетелдіктер де бір түнде қалуы мүмкін.
Dialogue: 0,0:10:16.28,0:10:18.16,Default,,0,0,0,,Сенімді болыңыз.
Dialogue: 0,0:10:18.24,0:10:19.41,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:10:19.49,0:10:21.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:21.20,0:10:22.78,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:22.87,0:10:26.12,Default,,0,0,0,,Бірақ сіз Жер тілінде жақсы сөйлейсіз.
Dialogue: 0,0:10:26.20,0:10:28.46,Default,,0,0,0,,Білімің көп сияқты.
Dialogue: 0,0:10:28.54,0:10:31.71,Default,,0,0,0,,Себебі мен жердегі кемеде оқыдым.
Dialogue: 0,0:10:31.79,0:10:33.67,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:10:33.75,0:10:34.71,Default,,0,0,0,,Иә
Dialogue: 0,0:10:34.80,0:10:36.84,Default,,0,0,0,,Мұнда келмес бұрын
Dialogue: 0,0:10:39.26,0:10:40.09,Default,,0,0,0,,Ах
Dialogue: 0,0:10:42.68,0:10:44.93,Default,,0,0,0,,Қашан қайтамын деп айттыңыз?
Dialogue: 0,0:10:45.02,0:10:45.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:45.93,0:10:49.98,Default,,0,0,0,,Біз олардың қайтып келуін күттік.
Dialogue: 0,0:10:58.70,0:11:02.07,Default,,0,0,0,,Ей, біз бұл туралы сөйлескен жоқпыз.
Dialogue: 0,0:11:02.16,0:11:03.45,Default,,0,0,0,,Бұл уақыт әлі жоқ
Dialogue: 0,0:11:03.53,0:11:05.74,Default,,0,0,0,,Жердің тілін түсінбеген заманда
Dialogue: 0,0:11:06.33,0:11:08.96,Default,,0,0,0,,Олармен қоштасқаннан кейін де оқуды жалғастырыңыз.
Dialogue: 0,0:11:09.04,0:11:12.50,Default,,0,0,0,,Мен ақыры осыншама көп сөйлей алдым.
Dialogue: 0,0:11:12.58,0:11:14.63,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:17.67,0:11:21.39,Default,,0,0,0,,Бірақ мен бұл оқиғаны естігенде қуандым.
Dialogue: 0,0:11:21.47,0:11:23.39,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:11:23.47,0:11:25.39,Default,,0,0,0,,А... а...
Dialogue: 0,0:11:26.56,0:11:30.89,Default,,0,0,0,,55,278 агенттік басқару күні
Dialogue: 0,0:11:30.98,0:11:34.40,Default,,0,0,0,,Бүгін 15:27
Dialogue: 0,0:11:34.48,0:11:36.90,Default,,0,0,0,,Жерден тыс тұтынушылардан
Dialogue: 0,0:11:36.98,0:11:40.24,Default,,0,0,0,,Адамның тірі екендігі туралы ақпарат алу
Dialogue: 0,0:11:44.70,0:11:48.41,Default,,0,0,0,,Біз сіздің оралуыңызды күтеміз.
Dialogue: 0,0:11:59.38,0:12:00.84,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:12:00.92,0:12:02.72,Default,,0,0,0,,(аквариумға секіру дыбысы)
Dialogue: 0,0:12:02.80,0:12:04.76,Default,,0,0,0,,Өзгеріс (ұшатын робот дауысы)
Dialogue: 0,0:12:04.85,0:12:06.05,Default,,0,0,0,,(аквариумға секіру дыбысы)
Dialogue: 0,0:12:07.10,0:12:09.81,Default,,0,0,0,,Әй, қара!
Dialogue: 0,0:12:09.89,0:12:11.31,Default,,0,0,0,,Пончака!
Dialogue: 0,0:12:13.15,0:12:14.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:14.19,0:12:15.81,Default,,0,0,0,,Пончака Пончака
Dialogue: 0,0:12:17.15,0:12:18.28,Default,,0,0,0,,Пон!
Dialogue: 0,0:12:20.90,0:12:21.74,Default,,0,0,0,,Чака!
Dialogue: 0,0:12:22.99,0:12:24.41,Default,,0,0,0,,Пончака!
Dialogue: 0,0:12:24.49,0:12:26.16,Default,,0,0,0,,(аквариумға секіру дыбысы)
Dialogue: 0,0:12:28.24,0:12:30.41,Default,,0,0,0,,Тұтынушы болса да қанша.
Dialogue: 0,0:12:30.50,0:12:33.46,Default,,0,0,0,,Осылай айтпасаң жақсы емес.
Dialogue: 0,0:12:38.04,0:12:39.46,Default,,0,0,0,,Пончака!
Dialogue: 0,0:12:43.93,0:12:46.01,Default,,0,0,0,,Понко-сама Фугури-сама
Dialogue: 0,0:12:46.09,0:12:47.97,Default,,0,0,0,,О Ячио-чан
Dialogue: 0,0:12:48.05,0:12:50.52,Default,,0,0,0,,Қараңдар, қараңдар, үлкен аулау, үлкен аулау!
Dialogue: 0,0:12:51.39,0:12:52.52,Default,,0,0,0,,Сіздің отбасыңыз туралы не айтасыз?
Dialogue: 0,0:12:52.60,0:12:55.52,Default,,0,0,0,,Әркім өз бөлмесінде тұрады, әсіресе күндіз.
Dialogue: 0,0:12:56.19,0:12:58.23,Default,,0,0,0,,Енот жат планеталықтар қорқақ
Dialogue: 0,0:12:58.32,0:13:01.28,Default,,0,0,0,,Бұл басқаша, өйткені Понко және басқалары ғарышта өсті.
Dialogue: 0,0:13:01.36,0:13:03.03,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:03.11,0:13:05.57,Default,,0,0,0,,Бұл сіздің кеңістігіңіз.
Dialogue: 0,0:13:05.66,0:13:07.66,Default,,0,0,0,,Бұлай ойнаудан аулақ болыңыз.
Dialogue: 0,0:13:07.74,0:13:10.66,Default,,0,0,0,,Не, шомылуға болмайды?
Dialogue: 0,0:13:10.74,0:13:11.70,Default,,0,0,0,,Иә
Dialogue: 0,0:13:11.79,0:13:14.37,Default,,0,0,0,,Бұл резервуардағы балықты жеуге болмайды.
Dialogue: 0,0:13:14.46,0:13:15.29,Default,,0,0,0,,Иии!
Dialogue: 0,0:13:17.88,0:13:20.05,Default,,0,0,0,,Иә, иә, иә...
Dialogue: 0,0:13:21.88,0:13:24.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:24.09,0:13:26.05,Default,,0,0,0,,Мен адасқандарды ұнатпаймын
Dialogue: 0,0:13:28.89,0:13:32.56,Default,,0,0,0,,Өзіңізді жақсы ұстасаңыз, осында қалуыңызға болады.
Dialogue: 0,0:13:32.64,0:13:34.39,Default,,0,0,0,,Сонымен бірге ойнағыларың келе ме?
Dialogue: 0,0:13:34.48,0:13:36.02,Default,,0,0,0,,Ойнау мүмкін емес
Dialogue: 0,0:13:36.10,0:13:37.69,Default,,0,0,0,,Мен жұмыстамын.
Dialogue: 0,0:13:37.77,0:13:39.19,Default,,0,0,0,,Сіздің жұмысыңыз қандай?
Dialogue: 0,0:13:39.77,0:13:42.69,Default,,0,0,0,,Мен осы қонақүйде көп нәрсені істеп жатырмын.
Dialogue: 0,0:13:42.78,0:13:44.36,Default,,0,0,0,,Әртүрлі заттар
Dialogue: 0,0:13:44.44,0:13:46.32,Default,,0,0,0,,Оны осылай созып, салбыратып қой.
Dialogue: 0,0:13:49.32,0:13:51.83,Default,,0,0,0,,Ячио-чан, бұл қандай жұмыс?
Dialogue: 0,0:13:52.49,0:13:54.87,Default,,0,0,0,,Біз сізді күтеміз
Dialogue: 0,0:13:54.96,0:13:57.71,Default,,0,0,0,,Хмм, қызық па?
Dialogue: 0,0:13:57.79,0:14:00.59,Default,,0,0,0,,Иә, бұл өте пайдалы.
Dialogue: 0,0:14:00.67,0:14:02.34,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:03.05,0:14:06.26,Default,,0,0,0,,Ыстық бұлақ шықса, қонақүйдің ерекшелігіне айналады.
Dialogue: 0,0:14:06.34,0:14:08.55,Default,,0,0,0,,Көрініс те тамаша.
Dialogue: 0,0:14:08.64,0:14:10.01,Default,,0,0,0,,Бұл өте жақсы жұлдыз болса да
Dialogue: 0,0:14:10.10,0:14:12.60,Default,,0,0,0,,Неліктен барлығы кетіп қалды?
Dialogue: 0,0:14:12.68,0:14:14.47,Default,,0,0,0,,Жануарлар болса да
Dialogue: 0,0:14:15.27,0:14:17.52,Default,,0,0,0,,Тек приматтарды жұқтырады -
Dialogue: 0,0:14:17.60,0:14:21.40,Default,,0,0,0,,Өте тез мутацияға ұшырайтын вирус тарады.
Dialogue: 0,0:14:21.48,0:14:22.98,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:27.07,0:14:29.49,Default,,0,0,0,,Мен оны қолданбасам да ауыстыруым керек пе?
Dialogue: 0,0:14:29.57,0:14:31.03,Default,,0,0,0,,Иә
Dialogue: 0,0:14:31.12,0:14:33.54,Default,,0,0,0,,Осы қонақүйде демалатын барлық қонақтарға:
Dialogue: 0,0:14:33.62,0:14:36.83,Default,,0,0,0,,Бөлмелерді ең жақсы жағдайда қамтамасыз ету
Dialogue: 0,0:14:36.91,0:14:38.54,Default,,0,0,0,,Бұл біздің жұмысымыз
Dialogue: 0,0:14:38.62,0:14:41.04,Default,,0,0,0,,Жердегілер қайтып келгенше?
Dialogue: 0,0:14:41.13,0:14:43.80,Default,,0,0,0,,Мен қайтып келгеннен бері солай болды.
Dialogue: 0,0:14:44.92,0:14:47.67,Default,,0,0,0,,Понко мен басқалары жер тұрғындары болса жақсы болар ма еді?
Dialogue: 0,0:14:48.51,0:14:53.47,Default,,0,0,0,,Жоқ, енот иттері де қонақүйдің маңызды қонақтары болып табылады.
Dialogue: 0,0:14:53.56,0:14:55.43,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:14:55.52,0:14:57.18,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:02.77,0:15:04.69,Default,,0,0,0,,(ұшатын роботтың дауысы)
Dialogue: 0,0:15:04.77,0:15:06.69,Default,,0,0,0,,Не, дәлізде?
Dialogue: 0,0:15:13.16,0:15:16.45,Default,,0,0,0,,Бұл... тезек
Dialogue: 0,0:15:27.88,0:15:28.72,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:15:33.39,0:15:34.85,Default,,0,0,0,,Уа!
Dialogue: 0,0:15:35.43,0:15:38.43,Default,,0,0,0,,Ах, Ячиё-чан, өтінемін, алға.
Dialogue: 0,0:15:38.52,0:15:40.06,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:42.06,0:15:43.44,Default,,0,0,0,,Бұлыңғыр...
Dialogue: 0,0:15:43.52,0:15:45.57,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:15:46.07,0:15:48.74,Default,,0,0,0,,О, бұл сұмдық.
Dialogue: 0,0:15:48.82,0:15:50.20,Default,,0,0,0,,Боқта?
Dialogue: 0,0:15:50.28,0:15:52.36,Default,,0,0,0,,Біздің әрекет ауқымымыз
Dialogue: 0,0:15:52.45,0:15:55.87,Default,,0,0,0,,Оны басқа адамдарға көрсету керек, солай ма?
Dialogue: 0,0:15:55.95,0:15:59.79,Default,,0,0,0,,Шеңбер соғысы басталса, мәселе болар еді.
Dialogue: 0,0:15:59.87,0:16:01.41,Default,,0,0,0,,Қақтығыс болмайды.
Dialogue: 0,0:16:01.50,0:16:04.42,Default,,0,0,0,,Біздің қонақүйде қазір кім тұрады?
Dialogue: 0,0:16:04.50,0:16:05.79,Default,,0,0,0,,Тек тұтынушылар үшін
Dialogue: 0,0:16:05.88,0:16:07.17,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:16:07.25,0:16:09.42,Default,,0,0,0,,Басқа ешкім жоқ па?
Dialogue: 0,0:16:09.51,0:16:10.42,Default,,0,0,0,,Иә
Dialogue: 0,0:16:10.51,0:16:11.68,Default,,0,0,0,,Я...
Dialogue: 0,0:16:14.55,0:16:18.60,Default,,0,0,0,,Маған ертерек айтсаң, мен уақытымды босқа өткізбес едім.
Dialogue: 0,0:16:19.31,0:16:22.23,Default,,0,0,0,,Басқа тұтынушылар болса да мұны жасамаңыз.
Dialogue: 0,0:16:22.31,0:16:24.73,Default,,0,0,0,,Не, сен мұны істемейсің бе?
Dialogue: 0,0:16:24.81,0:16:26.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:26.23,0:16:28.82,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:28.90,0:16:31.74,Default,,0,0,0,,Барлығын жоққа шығармау
Dialogue: 0,0:16:31.82,0:16:36.70,Default,,0,0,0,,Осыдан 50 жыл бұрын бізге басқа планеталық қонақ келгенде,
Dialogue: 0,0:16:36.78,0:16:39.91,Default,,0,0,0,,Әр планетаның өзіндік мәдениеті мен әдет-ғұрыптары бар екенін білдім.
Dialogue: 0,0:16:39.99,0:16:42.16,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:42.25,0:16:44.12,Default,,0,0,0,,Қазір қиын, бірақ
Dialogue: 0,0:16:44.21,0:16:46.38,Default,,0,0,0,,Болашақта мен су қоймасына тығылып отырамын деп үміттенемін.
Dialogue: 0,0:16:46.46,0:16:48.17,Default,,0,0,0,,Мен есте сақтағым келеді
Dialogue: 0,0:16:48.71,0:16:51.26,Default,,0,0,0,,Хоу... хоухо
Dialogue: 0,0:16:51.34,0:16:52.17,Default,,0,0,0,,Полковник!
Dialogue: 0,0:16:52.72,0:16:54.30,Default,,0,0,0,,(сыбырлаған дауыс)
Dialogue: 0,0:16:54.38,0:16:56.85,Default,,0,0,0,,Келіңіздер, тұтынушыларыңызға жақын болыңыз
Dialogue: 0,0:16:56.93,0:16:59.56,Default,,0,0,0,,Менің ойымша, бұл тамаша идея.
Dialogue: 0,0:17:00.35,0:17:02.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:04.39,0:17:06.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:06.27,0:17:08.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:08.27,0:17:10.94,Default,,0,0,0,,Хмф хмф... Тұтынушы қиындыққа тап болды.
Dialogue: 0,0:17:11.03,0:17:14.45,Default,,0,0,0,,Біз қараңғы жерлерді ұнатпаймыз.
Dialogue: 0,0:17:14.53,0:17:15.86,Default,,0,0,0,,Бұл әдет.
Dialogue: 0,0:17:18.95,0:17:19.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:20.08,0:17:23.16,Default,,0,0,0,,Түн және қауіпті, сондықтан дәлізде жүгірмеңіз.
Dialogue: 0,0:17:23.25,0:17:25.33,Default,,0,0,0,,Біздің әдеттеріміз
Dialogue: 0,0:17:25.42,0:17:27.67,Default,,0,0,0,,Онда ешкім жоқ, солай ма?
Dialogue: 0,0:17:28.42,0:17:31.63,Default,,0,0,0,,Тікелей даладан тамақтанбаңыз.
Dialogue: 0,0:17:31.71,0:17:34.51,Default,,0,0,0,,Бұл біздің әдетіміз.
Dialogue: 0,0:17:35.55,0:17:37.05,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:17:37.14,0:17:38.97,Default,,0,0,0,,Қоршаған ортаның нашарлауына байланысты
Dialogue: 0,0:17:39.05,0:17:40.43,Default,,0,0,0,,Біз онымен айналысамыз ба?
Dialogue: 0,0:17:40.51,0:17:41.68,Default,,0,0,0,,№
Dialogue: 0,0:17:41.77,0:17:43.18,Default,,0,0,0,,(Оцу роботының тазалаушы дауысы)
Dialogue: 0,0:17:43.27,0:17:45.06,Default,,0,0,0,,А...
Dialogue: 0,0:17:51.40,0:17:53.94,Default,,0,0,0,,Эй, эй, эй...
Dialogue: 0,0:17:55.28,0:17:56.40,Default,,0,0,0,,Уа!
Dialogue: 0,0:17:56.49,0:17:58.95,Default,,0,0,0,,Дондоко Дондон Бұл мереке ме?
Dialogue: 0,0:18:00.58,0:18:01.99,Default,,0,0,0,,Ах Ячио-чан
Dialogue: 0,0:18:06.58,0:18:09.29,Default,,0,0,0,,Қош келдіңіз, Ячио-сан.
Dialogue: 0,0:18:09.38,0:18:12.67,Default,,0,0,0,,Жатқан жеріңіз жайлы болсын деп үміттенемін.
Dialogue: 0,0:18:12.75,0:18:14.26,Default,,0,0,0,,Бұл қандай тесік?
Dialogue: 0,0:18:14.34,0:18:17.30,Default,,0,0,0,,Өйткені басқа ешкім болған жоқ
Dialogue: 0,0:18:17.38,0:18:19.84,Default,,0,0,0,,Мен тұратын жерімді сәл үлкейтуге тырыстым.
Dialogue: 0,0:18:19.93,0:18:23.77,Default,,0,0,0,,Егер бұл рас болса, мен шынымен өсімдікті қалаймын, солай ма?
Dialogue: 0,0:18:23.85,0:18:28.06,Default,,0,0,0,,Мүмкін келесі жолы Ячиодан бөлмеге қызмет көрсетуді сұрайтын шығармын.
Dialogue: 0,0:18:28.14,0:18:31.06,Default,,0,0,0,,Ячио-чанмен де жұмыс істеу оңай.
Dialogue: 0,0:18:32.82,0:18:34.69,Default,,0,0,0,,Бұл бөлмедегі кір...
Dialogue: 0,0:18:34.78,0:18:37.11,Default,,0,0,0,,Оның кір болғаны сұмдық.
Dialogue: 0,0:18:37.20,0:18:40.91,Default,,0,0,0,,Біздің планетада әдетте осылай көрінеді.
Dialogue: 0,0:18:40.99,0:18:43.79,Default,,0,0,0,,Мен дәлізде нәжісті тыйдым.
Dialogue: 0,0:18:43.87,0:18:45.62,Default,,0,0,0,,Оның орнына айтасыз ба?
Dialogue: 0,0:18:45.70,0:18:49.87,Default,,0,0,0,,Біз өзімізді иіскемейінше тыныштала алмаймыз.
Dialogue: 0,0:18:49.96,0:18:53.63,Default,,0,0,0,,Енді парақтарды өзгертудің қажеті жоқ.
Dialogue: 0,0:18:55.34,0:18:56.84,Default,,0,0,0,,Хаетори Робо мырза!
Dialogue: 0,0:18:56.92,0:18:58.76,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:18:58.84,0:19:02.30,Default,,0,0,0,,Мен бөлмемді жинауға мәжбүр болдым.
Dialogue: 0,0:19:02.39,0:19:04.76,Default,,0,0,0,,Ячио мырза біздің әдетімізде.
Dialogue: 0,0:19:04.85,0:19:07.35,Default,,0,0,0,,Сіз маған жақын бола алатыныңызды айттыңыз.
Dialogue: 0,0:19:07.43,0:19:10.77,Default,,0,0,0,,Бұл роботқа келгенде, мен қиыншылыққа ұшырадым.
Dialogue: 0,0:19:10.85,0:19:12.11,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:19:12.19,0:19:13.61,Default,,0,0,0,,Охохохо
Dialogue: 0,0:19:13.69,0:19:16.65,Default,,0,0,0,,Егер бұл роботты жөндеу мүмкін болмаса, мен оны ойыншық ретінде пайдалана аламын ба?
Dialogue: 0,0:19:16.73,0:19:19.65,Default,,0,0,0,,Ахх!
Dialogue: 0,0:19:19.74,0:19:21.16,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:21.24,0:19:22.66,Default,,0,0,0,,Уф! Уау...
Dialogue: 0,0:19:22.74,0:19:23.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:25.45,0:19:26.62,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,0:19:28.54,0:19:30.96,Default,,0,0,0,,(Барлығы дүрбелең)
Dialogue: 0,0:19:31.04,0:19:33.21,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:19:33.29,0:19:34.75,Default,,0,0,0,,Қосымша миссия
Dialogue: 0,0:19:34.84,0:19:37.21,Default,,0,0,0,,Тұтынушыға қолыңызды көтеріңіз Қол жеткізілді
Dialogue: 0,0:19:37.30,0:19:40.09,Default,,0,0,0,,«Отшашу» жаңа мүмкіндігі қосылды
Dialogue: 0,0:19:41.55,0:19:42.84,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:19:42.93,0:19:44.22,Default,,0,0,0,,Менің басым жанып тұр
Dialogue: 0,0:19:44.30,0:19:46.72,Default,,0,0,0,,Шулы, отырыңыз!
Dialogue: 0,0:19:46.81,0:19:47.72,Default,,0,0,0,,Иә
Dialogue: 0,0:19:49.68,0:19:51.10,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:19:51.19,0:19:53.61,Default,,0,0,0,,Додододо... Не айтып тұрсыз?
Dialogue: 0,0:19:53.69,0:19:55.36,Default,,0,0,0,,Бұл тұтынушы.
Dialogue: 0,0:19:55.44,0:19:56.69,Default,,0,0,0,,Егер сіз тұтынушы болсаңыз
Dialogue: 0,0:19:56.77,0:19:59.82,Default,,0,0,0,,Бұл жай ғана кез келген нәрсені кешіреміз деген сөз емес!
Dialogue: 0,0:19:59.90,0:20:02.49,Default,,0,0,0,,Мен бұл қонақүйді қорғауым керек.
Dialogue: 0,0:20:02.57,0:20:05.49,Default,,0,0,0,,Тұтынушы болса да, мен сені ұрамын!
Dialogue: 0,0:20:05.58,0:20:07.12,Default,,0,0,0,,Біздің сүйікті тұтынушыларымызға
Dialogue: 0,0:20:07.87,0:20:09.25,Default,,0,0,0,,Жүректі күн
Dialogue: 0,0:20:10.12,0:20:12.25,Default,,0,0,0,,Сіздің ең жақсы күлкіңіз
Dialogue: 0,0:20:12.83,0:20:15.88,Default,,0,0,0,,Gingarou қонақ үйіне қош келдіңіз
Dialogue: 0,0:20:18.84,0:20:21.26,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:20:21.34,0:20:27.35,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:35.02,0:20:37.32,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Мен сені ауыстырамын.
Dialogue: 0,0:20:37.40,0:20:38.48,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:20:38.57,0:20:39.65,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:20:39.73,0:20:41.90,Default,,0,0,0,,Өз баламды ешқашан қателеспес едім.
Dialogue: 0,0:20:46.20,0:20:48.66,Default,,0,0,0,,Құрметті Понко, сіз не істеп жатырсыз?
Dialogue: 0,0:20:48.74,0:20:52.29,Default,,0,0,0,,Қайырлы таң, мен жинап жатырмын.
Dialogue: 0,0:20:52.37,0:20:56.04,Default,,0,0,0,,Мен мұны түсіндім, неге?
Dialogue: 0,0:20:56.13,0:20:59.09,Default,,0,0,0,,Понко, мен сізге қонақүйде көмектескім келеді.
Dialogue: 0,0:20:59.17,0:21:01.80,Default,,0,0,0,,Себебі мен көп қиындық тудырдым
Dialogue: 0,0:21:02.38,0:21:04.30,Default,,0,0,0,,Маған осында жұмыс істеуге рұқсат етіңіз
Dialogue: 0,0:21:04.38,0:21:05.80,Default,,0,0,0,,Маған ақша керек емес
Dialogue: 0,0:21:07.22,0:21:08.55,Default,,0,0,0,,Сіздің отбасыңыз туралы не айтасыз?
Dialogue: 0,0:21:08.64,0:21:11.93,Default,,0,0,0,,Барлығы да өз бөлмелерін жинап жатыр.
Dialogue: 0,0:21:12.02,0:21:15.19,Default,,0,0,0,,Бұл біздің жұмысымыз.
Dialogue: 0,0:21:15.27,0:21:17.56,Default,,0,0,0,,Оның үстіне Понко-сама бала.
Dialogue: 0,0:21:17.65,0:21:20.69,Default,,0,0,0,,Жер бетінде жұмыс істей алатын жас бар.
Dialogue: 0,0:21:21.32,0:21:23.74,Default,,0,0,0,,Мен қанша жаста жұмыс істей аламын?
Dialogue: 0,0:21:26.70,0:21:30.33,Default,,0,0,0,,Қонақ үй ережелеріне сәйкес ең төменгі жас - 15 жас.
Dialogue: 0,0:21:33.08,0:21:34.54,Default,,0,0,0,,Менің жасым 54-те
Dialogue: 0,0:21:35.12,0:21:36.33,Default,,0,0,0,,Мен жұмыс істей аламын.
Dialogue: 0,0:21:36.42,0:21:37.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:39.54,0:21:42.55,Default,,0,0,0,,Бүгіннен бастап мен осында жұмыс істеймін.
Dialogue: 0,0:21:42.63,0:21:43.59,Default,,0,0,0,,Бұл Понко.
Dialogue: 0,0:21:43.67,0:21:46.09,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:21:46.18,0:21:48.34,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:21:48.93,0:21:49.76,Default,,0,0,0,,Ha
Dialogue: 0,0:21:49.85,0:21:53.64,Default,,0,0,0,,Жүректі Galaxy Tower ең жақсы күлкіге ие
Dialogue: 0,0:21:53.73,0:21:54.98,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:21:55.06,0:21:56.69,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:58.06,0:22:03.07,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.07,0:22:47.95,Default,,0,0,0,,～♪
Dialogue: 0,0:22:48.53,0:22:49.95,Default,,0,0,0,,(фильм аудиосы)
Dialogue: 0,0:22:50.03,0:22:51.95,Default,,0,0,0,,Ахаха о...
Dialogue: 0,0:22:53.45,0:22:59.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
