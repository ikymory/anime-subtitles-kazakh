Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.91,0:00:04.54,Default,,0,0,0,,Бәріміз тамақтанайық!
Dialogue: 0,0:00:04.63,0:00:06.04,Default,,0,0,0,,Тамақ ішіңіз және жеңіз
Dialogue: 0,0:00:10.01,0:00:10.84,Default,,0,0,0,,(Балапандар жылайды)
Dialogue: 0,0:00:15.68,0:00:17.47,Default,,0,0,0,,Үлкенірек болыңыз
Dialogue: 0,0:00:17.56,0:00:19.14,Default,,0,0,0,,Понко-сан
Dialogue: 0,0:00:19.22,0:00:20.89,Default,,0,0,0,,Ах Ячио-чан
Dialogue: 0,0:00:21.48,0:00:24.65,Default,,0,0,0,,Понко-санның бүгінгі жұмыс уақыты аяқталды.
Dialogue: 0,0:00:24.73,0:00:26.06,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:00:26.15,0:00:28.36,Default,,0,0,0,,Не? Бұл уақыт әлдеқашан ба?
Dialogue: 0,0:00:28.44,0:00:31.94,Default,,0,0,0,,Әй, қане, құсты да кедейге тамақтандырайық.
Dialogue: 0,0:00:32.53,0:00:34.11,Default,,0,0,0,,Оның аты бар ма?
Dialogue: 0,0:00:34.20,0:00:37.07,Default,,0,0,0,,Иә, «Момо», солай ма?
Dialogue: 0,0:00:37.16,0:00:38.95,Default,,0,0,0,,«Цукунэ» «Бонджири»
Dialogue: 0,0:00:40.08,0:00:41.95,Default,,0,0,0,,Бұл бала кедей құс.
Dialogue: 0,0:00:45.33,0:00:49.38,Default,,0,0,0,,Біз оны бәрібір жейтін болсақ, неге оған атау бермеске?
Dialogue: 0,0:00:50.05,0:00:55.05,Default,,0,0,0,,♪～
Dialogue: 0,0:02:14.92,0:02:19.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:28.77,0:02:30.94,Default,,0,0,0,,Сізге тағам ұнады ма?
Dialogue: 0,0:02:31.02,0:02:33.07,Default,,0,0,0,,Тағы да...
Dialogue: 0,0:02:33.90,0:02:36.40,Default,,0,0,0,,Тағам Сізге ұнамады ма?
Dialogue: 0,0:02:36.49,0:02:39.41,Default,,0,0,0,,Ах... Фугури, өзімшіл болма.
Dialogue: 0,0:02:39.49,0:02:42.53,Default,,0,0,0,,Бұл әрқашан өте дәмді.
Dialogue: 0,0:02:42.62,0:02:44.45,Default,,0,0,0,,Менің балам менің балам болса.
Dialogue: 0,0:02:44.54,0:02:46.75,Default,,0,0,0,,Кешіріңіз, шынымен.
Dialogue: 0,0:02:46.83,0:02:48.16,Default,,0,0,0,,А... жарайды ма?
Dialogue: 0,0:02:48.25,0:02:49.75,Default,,0,0,0,,Ячио-сан және т.б
Dialogue: 0,0:02:49.83,0:02:52.25,Default,,0,0,0,,Өйткені біз бұрын дәмді деп айтқанбыз.
Dialogue: 0,0:02:52.33,0:02:54.75,Default,,0,0,0,,Осылай қайта-қайта
Dialogue: 0,0:02:54.84,0:02:58.67,Default,,0,0,0,,Ұялмай бір тамақты береді.
Dialogue: 0,0:02:58.76,0:03:02.55,Default,,0,0,0,,Әдетте ұзақ мерзімді қонақтарға мұны жасамайсыз.
Dialogue: 0,0:03:02.64,0:03:04.43,Default,,0,0,0,,Қонақ үй сапасына күмән тудыратын заттар
Dialogue: 0,0:03:04.43,0:03:05.76,Default,,0,0,0,,Қонақ үй сапасына күмән тудыратын заттар
Dialogue: 0,0:03:04.43,0:03:05.76,Default,,0,0,0,,Ах Мами Мами
Dialogue: 0,0:03:05.85,0:03:08.23,Default,,0,0,0,,Ячио-сан біз үшін
Dialogue: 0,0:03:08.31,0:03:11.31,Default,,0,0,0,,Сіз мені ұятқа қалдыруға батылыңыз бар.
Dialogue: 0,0:03:11.40,0:03:13.44,Default,,0,0,0,,Жай мазохистік қонақ үй
Dialogue: 0,0:03:13.52,0:03:15.36,Default,,0,0,0,,Қонақ үй...
Dialogue: 0,0:03:15.44,0:03:17.23,Default,,0,0,0,,М
Dialogue: 0,0:03:17.32,0:03:19.40,Default,,0,0,0,,Бұл менмін! Мен жай айттым!
Dialogue: 0,0:03:19.49,0:03:20.61,Default,,0,0,0,,Мені ұрғың келсе,
Dialogue: 0,0:03:20.70,0:03:22.16,Default,,0,0,0,,Әкем
Dialogue: 0,0:03:22.24,0:03:26.12,Default,,0,0,0,,Ячио-чан, бұл өте маңызды нәрсе болмаса, мен сені жұдырықтай алмаймын.
Dialogue: 0,0:03:26.74,0:03:27.91,Default,,0,0,0,,Қараңызшы, Фугури
Dialogue: 0,0:03:28.00,0:03:29.75,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:29.83,0:03:32.79,Default,,0,0,0,,Аспазшы маған оны жасау үшін қиындық көрді.
Dialogue: 0,0:03:32.88,0:03:34.59,Default,,0,0,0,,Дұрыс, Фугури.
Dialogue: 0,0:03:34.67,0:03:37.38,Default,,0,0,0,,Бұл дүниеде қаласа да жей алмайтын адамдар бар.
Dialogue: 0,0:03:37.46,0:03:39.67,Default,,0,0,0,,Тіпті адасқан Данукилер де бар.
Dialogue: 0,0:03:39.76,0:03:41.76,Default,,0,0,0,,Уун (Понко) Фугури
Dialogue: 0,0:03:41.84,0:03:42.51,Default,,0,0,0,,Әже осында
Dialogue: 0,0:03:42.51,0:03:42.97,Default,,0,0,0,,Әже осында
Dialogue: 0,0:03:42.51,0:03:42.97,Default,,0,0,0,,Бұл жаңа мәзір ме?
Dialogue: 0,0:03:42.97,0:03:43.05,Default,,0,0,0,,Бұл жаңа мәзір ме?
Dialogue: 0,0:03:43.05,0:03:44.64,Default,,0,0,0,,Бұл жаңа мәзір ме?
Dialogue: 0,0:03:43.05,0:03:44.64,Default,,0,0,0,,Мен оны жеуім керек пе?
Dialogue: 0,0:03:44.72,0:03:46.76,Default,,0,0,0,,Анашым, қан қысымым көтеріліп жатыр.
Dialogue: 0,0:03:47.35,0:03:51.02,Default,,0,0,0,,Мәселе дәмде емес, біз ұсына алатын мәзірдің түрі.
Dialogue: 0,0:03:51.10,0:03:52.48,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:03:52.56,0:03:54.19,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:54.27,0:03:55.98,Default,,0,0,0,,Мәзірді көбейтсек те
Dialogue: 0,0:03:56.07,0:03:58.69,Default,,0,0,0,,Бізде олардың ешқайсысына ингредиенттер немесе дәмдеуіштер жеткіліксіз.
Dialogue: 0,0:03:58.78,0:04:00.24,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:04:00.32,0:04:02.03,Default,,0,0,0,,Берілмеңіз
Dialogue: 0,0:04:02.11,0:04:04.16,Default,,0,0,0,,Біз толығымен қанағаттануымыз керек.
Dialogue: 0,0:04:04.24,0:04:05.95,Default,,0,0,0,,Қонақ үйдің тұтастығына қатысты
Dialogue: 0,0:04:06.03,0:04:07.41,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:04:07.49,0:04:09.37,Default,,0,0,0,,Енді шарттарды кеңейтіңіз
Dialogue: 0,0:04:09.45,0:04:12.58,Default,,0,0,0,,Сонымен қатар әлемнің түкпір-түкпірінен келген жергілікті тағамдарды қарастырайық.
Dialogue: 0,0:04:16.00,0:04:19.17,Default,,0,0,0,,Енді әр жауапты адамнан есеп беріңіз.
Dialogue: 0,0:04:19.25,0:04:21.67,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:04:24.18,0:04:28.43,Default,,0,0,0,,Техникалық қызмет көрсету роботтарында ерекше проблемалар жоқ сияқты.
Dialogue: 0,0:04:28.51,0:04:31.93,Default,,0,0,0,,Көкөністерді өсіруге жауапты робот мырза және тағам дайындауға жауапты робот мырза.
Dialogue: 0,0:04:32.02,0:04:33.27,Default,,0,0,0,,Мейрамхана мәзірі маңызды
Dialogue: 0,0:04:33.35,0:04:34.35,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:04:34.44,0:04:36.06,Default,,0,0,0,,Бұл.
Dialogue: 0,0:04:36.15,0:04:38.82,Default,,0,0,0,,Бүгін мен қабылдау бөлмесін Хаетори Робо мырзаға тапсырамын.
Dialogue: 0,0:04:39.44,0:04:42.86,Default,,0,0,0,,Мен Понко-санмен бірге ингредиенттерді іздеуге барамын.
Dialogue: 0,0:04:42.95,0:04:45.20,Default,,0,0,0,,Не, менімен шығасың ба?
Dialogue: 0,0:04:45.28,0:04:46.41,Default,,0,0,0,,Иә
Dialogue: 0,0:04:46.49,0:04:48.03,Default,,0,0,0,,Жазатайым оқиғаға дайындық
Dialogue: 0,0:04:48.12,0:04:50.74,Default,,0,0,0,,Көшеге шыққанда екі адамдық ұяшық қажет.
Dialogue: 0,0:04:50.83,0:04:53.08,Default,,0,0,0,,Понко екеуміз оңай қозғаламыз.
Dialogue: 0,0:04:53.71,0:04:54.96,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:04:55.04,0:04:56.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:56.17,0:04:57.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:04.55,0:05:06.43,Default,,0,0,0,,Бүгін Загинді көреміз бе?
Dialogue: 0,0:05:06.51,0:05:07.68,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:05:07.76,0:05:10.81,Default,,0,0,0,,Бүгін көп балық аулау үшін осыны қолданайық.
Dialogue: 0,0:05:11.72,0:05:13.31,Default,,0,0,0,,Ақыр соңында, бұл қара-су
Dialogue: 0,0:05:13.39,0:05:15.52,Default,,0,0,0,,Күріште болса, Ших-су
Dialogue: 0,0:05:15.60,0:05:16.44,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:16.52,0:05:20.11,Default,,0,0,0,,Оны қармақ деп атайды және балық аулау үшін қолданылады.
Dialogue: 0,0:05:20.19,0:05:23.11,Default,,0,0,0,,Понколар оны алдыңғы табандарымен ұстап алды.
Dialogue: 0,0:05:23.19,0:05:24.82,Default,,0,0,0,,Мынадай нәрсе бар.
Dialogue: 0,0:05:24.90,0:05:27.91,Default,,0,0,0,,Сондай-ақ, мен сізге мұны да беремін.
Dialogue: 0,0:05:27.99,0:05:31.08,Default,,0,0,0,,Алыста жүрсеңіз де сөйлесе аласыз.
Dialogue: 0,0:05:31.16,0:05:32.54,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:34.20,0:05:36.04,Default,,0,0,0,,Данза Блоу ата
Dialogue: 0,0:05:36.12,0:05:38.13,Default,,0,0,0,,Бұл қызық па?
Dialogue: 0,0:05:38.21,0:05:42.30,Default,,0,0,0,,Понко мен басқаларды үнемі бақылап отырғаныңыз үшін рахмет.
Dialogue: 0,0:05:42.96,0:05:45.13,Default,,0,0,0,,Ол соншалықты алысқа апармайды.
Dialogue: 0,0:05:45.22,0:05:47.18,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:50.76,0:05:53.72,Default,,0,0,0,,Ячио-чанның көзінің астында таңғажайып қара шеңберлер бар
Dialogue: 0,0:05:53.81,0:05:55.31,Default,,0,0,0,,Адасқан данукиге ұқсайды
Dialogue: 0,0:05:55.39,0:05:58.69,Default,,0,0,0,,Кеше зарядтау уақыты әдеттегіден қысқа болды, сондықтан
Dialogue: 0,0:05:58.77,0:06:01.11,Default,,0,0,0,,Дегенмен, ол бизнес операцияларына кедергі келтірмейді.
Dialogue: 0,0:06:01.19,0:06:02.98,Default,,0,0,0,,Сонда мен үйге бара алмасам ше?
Dialogue: 0,0:06:03.07,0:06:05.03,Default,,0,0,0,,Понко сені арқаңда көтеріп жүреді.
Dialogue: 0,0:06:28.13,0:06:29.51,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:30.09,0:06:32.14,Default,,0,0,0,,Шөлді аймақ соншалықты...
Dialogue: 0,0:06:32.22,0:06:34.01,Default,,0,0,0,,Карта ақпаратын жаңарту
Dialogue: 0,0:06:34.10,0:06:35.72,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:06:35.81,0:06:38.48,Default,,0,0,0,,Мен жеңіл тағамдар әкелсем ғой.
Dialogue: 0,0:06:38.56,0:06:41.15,Default,,0,0,0,,Жұмыс кезінде жеңіл тағамдар әкелуге тыйым салынады.
Dialogue: 0,0:06:41.23,0:06:43.69,Default,,0,0,0,,Мен Понкоға түскі ас дайындап қойдым.
Dialogue: 0,0:06:43.77,0:06:45.15,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:06:45.23,0:06:48.15,Default,,0,0,0,,(түйе айқайы)
Dialogue: 0,0:06:48.74,0:06:50.70,Default,,0,0,0,,шықты! Бұл не?
Dialogue: 0,0:06:50.78,0:06:52.16,Default,,0,0,0,,Бұл түйе.
Dialogue: 0,0:06:52.24,0:06:54.41,Default,,0,0,0,,Түйе көңілді~
Dialogue: 0,0:06:55.16,0:06:56.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:04.63,0:07:06.30,Default,,0,0,0,,Сіз ашулы болдыңыз.
Dialogue: 0,0:07:06.38,0:07:07.63,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:07:07.71,0:07:08.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:08.63,0:07:11.22,Default,,0,0,0,,Понко мен басқалары баратын орман ма?
Dialogue: 0,0:07:11.30,0:07:12.14,Default,,0,0,0,,Иә
Dialogue: 0,0:07:12.22,0:07:16.01,Default,,0,0,0,,Қонақ үй жанында жоқ ингредиенттерді алуыңыз мүмкін.
Dialogue: 0,0:07:18.85,0:07:22.94,Default,,0,0,0,,Әрине, кейбір ауытқулар бар.
Dialogue: 0,0:07:23.02,0:07:25.57,Default,,0,0,0,,Ештеңе емес, солай ма?
Dialogue: 0,0:07:35.66,0:07:37.58,Default,,0,0,0,,Ячио-чан Ячио-чан
Dialogue: 0,0:07:37.66,0:07:39.96,Default,,0,0,0,,Бұны жем ретінде қолданайық.
Dialogue: 0,0:07:42.29,0:07:44.59,Default,,0,0,0,,Бұл сізден сыйлық.
Dialogue: 0,0:07:44.67,0:07:45.71,Default,,0,0,0,,А...
Dialogue: 0,0:07:50.26,0:07:51.51,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:07:53.72,0:07:55.43,Default,,0,0,0,,Бұл 3 секунд ішінде, сондықтан уайымдамаңыз!
Dialogue: 0,0:07:55.51,0:07:56.93,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:13.41,0:08:14.62,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:25.58,0:08:28.13,Default,,0,0,0,,Ячио-чан, сен көп балық ауладың.
Dialogue: 0,0:08:28.21,0:08:31.26,Default,,0,0,0,,Понко-сан, сен бірінші рет болса да жақсысың.
Dialogue: 0,0:08:31.34,0:08:34.01,Default,,0,0,0,,Өйткені аңшылық – тіршіліктің негізі.
Dialogue: 0,0:08:34.09,0:08:36.72,Default,,0,0,0,,Понкомен бірге келгенім жақсы болды.
Dialogue: 0,0:08:36.80,0:08:38.18,Default,,0,0,0,,Осы қарқынмен басқа нәрселер де бар.
Dialogue: 0,0:08:38.26,0:08:40.77,Default,,0,0,0,,Сіз әртүрлі ингредиенттерді ала аласыз.
Dialogue: 0,0:08:40.85,0:08:41.77,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:08:43.23,0:08:45.40,Default,,0,0,0,,Сізде дәмді мәзір бар деп үміттенемін.
Dialogue: 0,0:08:45.48,0:08:46.36,Default,,0,0,0,,Иә
Dialogue: 0,0:08:46.44,0:08:49.65,Default,,0,0,0,,Мен барлығына ұнайтын нәрсені жасағым келеді.
Dialogue: 0,0:08:50.36,0:08:52.57,Default,,0,0,0,,Менің ішім толып кетті.
Dialogue: 0,0:08:52.65,0:08:55.78,Default,,0,0,0,,Басқа ингредиенттерді табайық!
Dialogue: 0,0:09:01.75,0:09:04.71,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:09:05.67,0:09:08.59,Default,,0,0,0,,(түйе айқайы)
Dialogue: 0,0:09:11.17,0:09:12.38,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:09:12.46,0:09:13.84,Default,,0,0,0,,Бұл түйенің өркеші.
Dialogue: 0,0:09:14.84,0:09:16.59,Default,,0,0,0,,Маған оны шығаруға рұқсат етіңіз, жарай ма?
Dialogue: 0,0:09:17.30,0:09:18.85,Default,,0,0,0,,Сено…
Dialogue: 0,0:09:21.52,0:09:22.35,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:09:21.52,0:09:22.35,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:22.35,0:09:24.85,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:26.19,0:09:29.69,Default,,0,0,0,,Ячиё-чан, менің жабайылығым қашып кет деп сыбырлайды.
Dialogue: 0,0:09:29.77,0:09:31.07,Default,,0,0,0,,Қайғырма.
Dialogue: 0,0:09:31.15,0:09:33.15,Default,,0,0,0,,Егер мен қандай да бір жануар болсам
Dialogue: 0,0:09:33.24,0:09:35.70,Default,,0,0,0,,...
Dialogue: 0,0:09:39.07,0:09:41.45,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:09:42.12,0:09:43.54,Default,,0,0,0,,Ах, бұл Дазе Чан.
Dialogue: 0,0:09:46.87,0:09:48.92,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:09:49.00,0:09:50.92,Default,,0,0,0,,Ах, Понко-сан
Dialogue: 0,0:09:51.00,0:09:53.67,Default,,0,0,0,,Жүгір! Жүгір!
Dialogue: 0,0:09:59.93,0:10:01.72,Default,,0,0,0,,Букьяро!
Dialogue: 0,0:10:07.44,0:10:09.23,Default,,0,0,0,,Бұл өлім бе?
Dialogue: 0,0:10:09.31,0:10:11.77,Default,,0,0,0,,Мынау не деген ақымақ үлкен мақұлық?
Dialogue: 0,0:10:15.65,0:10:19.28,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:10:19.78,0:10:22.08,Default,,0,0,0,,Мұрағаттарды іздеу
Dialogue: 0,0:10:22.83,0:10:25.20,Default,,0,0,0,,Жердегі тірі заттарға қолданылмайды
Dialogue: 0,0:10:27.25,0:10:29.21,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:10:32.67,0:10:35.59,Default,,0,0,0,,Бұл жерде ең төзімді болып көрінеді.
Dialogue: 0,0:10:35.67,0:10:37.42,Default,,0,0,0,,Сол ғимаратқа жүгір!
Dialogue: 0,0:10:45.72,0:10:47.35,Default,,0,0,0,,Амансың ба? Понко-сан
Dialogue: 0,0:10:47.43,0:10:49.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:50.19,0:10:51.94,Default,,0,0,0,,Сен кеттің бе? Сіз оны еккенсіз бе?
Dialogue: 0,0:10:52.02,0:10:53.69,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:53.77,0:10:56.23,Default,,0,0,0,,Жағдай қауіпті болып қала береді.
Dialogue: 0,0:10:56.32,0:10:57.86,Default,,0,0,0,,Тұтану!
Dialogue: 0,0:11:01.07,0:11:04.49,Default,,0,0,0,,Сенің өлімің менің қолымда.
Dialogue: 0,0:11:05.24,0:11:08.12,Default,,0,0,0,,Облитерациялық сәулені жеңіз!
Dialogue: 0,0:11:11.67,0:11:13.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:13.09,0:11:15.25,Default,,0,0,0,,Анамның шие бәлішінен қиын
Dialogue: 0,0:11:15.34,0:11:20.26,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:26.10,0:11:29.02,Default,,0,0,0,,Бұл жігіт шынымен аш сияқты.
Dialogue: 0,0:11:29.10,0:11:31.52,Default,,0,0,0,,Нудель де қарны ашты.
Dialogue: 0,0:11:31.60,0:11:32.73,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:11:32.81,0:11:34.27,Default,,0,0,0,,Нудель? (Понко) Иә
Dialogue: 0,0:11:34.36,0:11:38.03,Default,,0,0,0,,Қалай қарасаңыз да, бұл Нудер Мелисса Сколопендра.
Dialogue: 0,0:11:38.11,0:11:40.20,Default,,0,0,0,,Ол Жерде де болды.
Dialogue: 0,0:11:40.28,0:11:42.36,Default,,0,0,0,,Понко-сан, сен білесің.
Dialogue: 0,0:11:42.45,0:11:44.66,Default,,0,0,0,,Мен тек атын ғана білемін.
Dialogue: 0,0:11:44.74,0:11:47.49,Default,,0,0,0,,Нудель тұқымдастары әдетте жойылады.
Dialogue: 0,0:11:47.58,0:11:49.29,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:54.25,0:11:55.29,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:11:55.38,0:11:56.75,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:56.84,0:11:59.84,Default,,0,0,0,,Нудель, сен бізді бүкіл ғимаратты жейсің.
Dialogue: 0,0:11:59.92,0:12:01.84,Default,,0,0,0,,Өтірік! Сіз қандай да бір жолмен қашып кете алмайсыз ба?
Dialogue: 0,0:12:01.93,0:12:03.80,Default,,0,0,0,,Мен бүгін құтқарылсам да
Dialogue: 0,0:12:03.89,0:12:08.52,Default,,0,0,0,,Оны жалғыз қалдырсақ, ол ақыр соңында жаһандық ортаға әсер етеді.
Dialogue: 0,0:12:11.18,0:12:14.60,Default,,0,0,0,,Егер бұл орын алса, адамдар қайтып орала алмайды.
Dialogue: 0,0:12:15.36,0:12:18.19,Default,,0,0,0,,Қандай жағдай болмасын осы жерден тоқтауымыз керек.
Dialogue: 0,0:12:20.28,0:12:23.07,Default,,0,0,0,,Өйткені аңшылық – тіршіліктің негізі.
Dialogue: 0,0:12:27.83,0:12:29.08,Default,,0,0,0,,Балық аулауға барайық
Dialogue: 0,0:12:29.16,0:12:30.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:30.45,0:12:31.87,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:12:31.96,0:12:34.08,Default,,0,0,0,,Қармақ бар
Dialogue: 0,0:12:47.97,0:12:50.39,Default,,0,0,0,,Бұл жұмыс істемейтін сияқты.
Dialogue: 0,0:12:50.47,0:12:53.39,Default,,0,0,0,,Менің батареямды қосыңыз
Dialogue: 0,0:12:53.48,0:12:54.81,Default,,0,0,0,,(Қосылу дыбысы)
Dialogue: 0,0:12:58.77,0:13:01.44,Default,,0,0,0,,(Ячиодан ерекше шу естілді)
Dialogue: 0,0:13:01.53,0:13:03.24,Default,,0,0,0,,Әй, бұл керемет естіледі.
Dialogue: 0,0:13:03.32,0:13:05.91,Default,,0,0,0,,Ячио-чан, мен кешеден бері мәзірді ойлап жүрмін.
Dialogue: 0,0:13:05.99,0:13:07.57,Default,,0,0,0,,Ұйқым аз болса да
Dialogue: 0,0:13:08.99,0:13:10.16,Default,,0,0,0,,Батарея бітсе
Dialogue: 0,0:13:10.24,0:13:11.58,Default,,0,0,0,,Мен үйге бара алмаймын
Dialogue: 0,0:13:11.66,0:13:13.83,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:13:13.91,0:13:15.17,Default,,0,0,0,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,0:13:15.25,0:13:16.88,Default,,0,0,0,,Үйге міндетті түрде бірге барайық.
Dialogue: 0,0:13:16.96,0:13:18.00,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:18.08,0:13:19.71,Default,,0,0,0,,Ол маған мотоцикл мен соққан көлік туралы уайымдама, тек қайта кел деп айтты.
Dialogue: 0,0:13:19.79,0:13:22.34,Default,,0,0,0,,Олар бір-бірімен кездескеннен кейін 4 секунд ішінде қосылды.
Dialogue: 0,0:13:23.17,0:13:25.38,Default,,0,0,0,,(қуат беру дыбысы)
Dialogue: 0,0:13:25.47,0:13:28.14,Default,,0,0,0,,(кранның қозғалу дыбысы)
Dialogue: 0,0:13:28.22,0:13:30.39,Default,,0,0,0,,Балық аулауды бастайық
Dialogue: 0,0:13:39.73,0:13:41.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:41.23,0:13:43.40,Default,,0,0,0,,Балық аулауға арналған жем қажет болуы мүмкін
Dialogue: 0,0:13:45.49,0:13:47.91,Default,,0,0,0,,Понко-сан, сен сенімдісің бе?
Dialogue: 0,0:13:47.99,0:13:49.91,Default,,0,0,0,,Бұл ысырап, бірақ мен оған көмектесе алмаймын!
Dialogue: 0,0:14:00.50,0:14:01.67,Default,,0,0,0,,Анықталды
Dialogue: 0,0:14:01.75,0:14:03.17,Default,,0,0,0,,Шариғатты ғана қалдырмаңыз!
Dialogue: 0,0:14:03.76,0:14:05.80,Default,,0,0,0,,Егер бұл орын алса, бұл сіздің соңғы шараңыз.
Dialogue: 0,0:14:05.88,0:14:06.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:06.80,0:14:08.30,Default,,0,0,0,,Жемге айналдым
Dialogue: 0,0:14:08.39,0:14:10.97,Default,,0,0,0,,Мен бұл ілмекпен арбаны ұстау үшін қолданамын.
Dialogue: 0,0:14:11.05,0:14:13.52,Default,,0,0,0,,Бұл ақылсыз! Ештеңе!
Dialogue: 0,0:14:13.60,0:14:14.56,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:14.64,0:14:15.64,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:15.73,0:14:17.94,Default,,0,0,0,,Понкодан кранды басқаруды сұраңыз...
Dialogue: 0,0:14:18.02,0:14:19.15,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:14:19.23,0:14:20.36,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:14:20.44,0:14:22.07,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:14:22.15,0:14:23.73,Default,,0,0,0,,Сақтау режиміне кіріңіз
Dialogue: 0,0:14:24.86,0:14:26.24,Default,,0,0,0,,А...
Dialogue: 0,0:14:26.32,0:14:28.15,Default,,0,0,0,,Жемге айналдым
Dialogue: 0,0:14:28.24,0:14:30.74,Default,,0,0,0,,Мен бұл ілгекті азғынды ұстау үшін қолданамын.
Dialogue: 0,0:14:30.82,0:14:32.74,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:14:32.83,0:14:35.37,Default,,0,0,0,,Бүгін мұны істеу мүмкін емес.
Dialogue: 0,0:14:35.45,0:14:36.83,Default,,0,0,0,,Бұл мүмкін болмаса да, оны істеуден басқа амалың жоқ...
Dialogue: 0,0:14:36.91,0:14:39.08,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:14:39.17,0:14:40.88,Default,,0,0,0,,Біздің қолымыздан ештеңе келмейді... (электронды дыбыс)
Dialogue: 0,0:14:42.38,0:14:44.88,Default,,0,0,0,,Мен қайтадан сақтап қойдым.
Dialogue: 0,0:14:50.34,0:14:51.64,Default,,0,0,0,,Понко барады
Dialogue: 0,0:14:51.72,0:14:52.97,Default,,0,0,0,,Э?
Dialogue: 0,0:14:53.05,0:14:56.06,Default,,0,0,0,,Бұл сен сияқты қорқып қалған енот үшін тым қауіпті!
Dialogue: 0,0:14:56.14,0:14:57.10,Default,,0,0,0,,Жемге айналдым
Dialogue: 0,0:14:57.18,0:14:59.56,Default,,0,0,0,,Мен бұл ілмекпен арбаны ұстау үшін қолданамын.
Dialogue: 0,0:15:01.06,0:15:02.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.40,0:15:08.03,Default,,0,0,0,,Понко Мен барлығымен қонақүйге қайтқым келеді.
Dialogue: 0,0:15:08.11,0:15:11.57,Default,,0,0,0,,Сондықтан Понко тірі жемге айналады!
Dialogue: 0,0:15:17.79,0:15:20.33,Default,,0,0,0,,Тірі жем беріңізші
Dialogue: 0,0:15:20.42,0:15:21.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:25.21,0:15:26.25,Default,,0,0,0,,Понко-сан
Dialogue: 0,0:15:27.84,0:15:30.63,Default,,0,0,0,,Аман-есен оралуыңызды сұраймыз.
Dialogue: 0,0:15:30.72,0:15:31.64,Default,,0,0,0,,Иә
Dialogue: 0,0:15:31.72,0:15:36.18,Default,,0,0,0,,Жерден тыс тіршілік формаларының әсерінен өндірістік жарақаттар туралы шағымдар қабылданбайды.
Dialogue: 0,0:15:38.52,0:15:39.56,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:44.52,0:15:45.90,Default,,0,0,0,,Олай болса, Понко-сан.
Dialogue: 0,0:15:45.98,0:15:49.32,Default,,0,0,0,,«Сегіз тұзақ» операциясының сұлбасын тағы да түсіндіруге рұқсат етіңіздер.
Dialogue: 0,0:15:49.40,0:15:52.70,Default,,0,0,0,,Алдымен Понко-сан айналып тұрған Нудельді тартып алды.
Dialogue: 0,0:15:52.78,0:15:55.33,Default,,0,0,0,,Оларды балық аулау ілгегі шегінде тартыңыз.
Dialogue: 0,0:15:55.41,0:15:57.66,Default,,0,0,0,,Осыдан кейін мен тырнамен балық аулаймын!
Dialogue: 0,0:15:58.45,0:16:00.00,Default,,0,0,0,,Бұл қарапайым стратегия, бірақ
Dialogue: 0,0:16:00.08,0:16:03.00,Default,,0,0,0,,Ақыл-ой күші және операцияларды сенімді орындау мүмкіндігі
Dialogue: 0,0:16:03.08,0:16:05.09,Default,,0,0,0,,Сот шешімі қажет
Dialogue: 0,0:16:06.09,0:16:08.00,Default,,0,0,0,,Бір қатеге жол берілмейді
Dialogue: 0,0:16:08.09,0:16:10.05,Default,,0,0,0,,Аман-есен оралуыңызды өтінемін.
Dialogue: 0,0:16:10.13,0:16:11.13,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:11.22,0:16:12.30,Default,,0,0,0,,Иә
Dialogue: 0,0:16:12.38,0:16:15.10,Default,,0,0,0,,Енді санауды бастайық.
Dialogue: 0,0:16:15.18,0:16:19.93,Default,,0,0,0,,５ ４ ３ ２ １
Dialogue: 0,0:16:20.02,0:16:22.19,Default,,0,0,0,,Балық аулаймыз!
Dialogue: 0,0:16:31.53,0:16:34.24,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:34.32,0:16:35.53,Default,,0,0,0,,Цу...
Dialogue: 0,0:16:50.46,0:16:52.01,Default,,0,0,0,,Ячио-чан қазір!
Dialogue: 0,0:16:57.43,0:16:58.89,Default,,0,0,0,,Ячио-чан?
Dialogue: 0,0:16:59.85,0:17:01.64,Default,,0,0,0,,Негакари?
Dialogue: 0,0:17:01.73,0:17:03.64,Default,,0,0,0,,Ячио қайтадан!
Dialogue: 0,0:17:03.73,0:17:04.77,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:17:04.85,0:17:06.15,Default,,0,0,0,,Төлеңіз
Dialogue: 0,0:17:06.23,0:17:07.40,Default,,0,0,0,,Гаш…
Dialogue: 0,0:17:07.48,0:17:08.86,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:17:08.94,0:17:12.11,Default,,0,0,0,,Пя! Аа, аа, аа...
Dialogue: 0,0:17:15.20,0:17:17.45,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:17:17.53,0:17:18.37,Default,,0,0,0,,Уау
Dialogue: 0,0:17:19.53,0:17:20.37,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:17:20.95,0:17:22.25,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:17:34.05,0:17:39.01,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:17:39.10,0:17:40.85,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:17:40.93,0:17:43.02,Default,,0,0,0,,Ақыр аяғында жеңіл тамақ керек.
Dialogue: 0,0:17:43.10,0:17:44.02,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:17:58.11,0:18:00.03,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:14.09,0:18:15.05,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:17.13,0:18:18.30,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:18:18.38,0:18:20.05,Default,,0,0,0,,Қалғанын саған қалдырамын.
Dialogue: 0,0:18:30.77,0:18:32.73,Default,,0,0,0,,Ку… (шаншу дыбысы)
Dialogue: 0,0:18:32.82,0:18:34.73,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:18:37.57,0:18:38.99,Default,,0,0,0,,Эй, жақсысың ба!
Dialogue: 0,0:18:40.74,0:18:43.28,Default,,0,0,0,,Егер тірі болсаңыз, жауап беріңіз!
Dialogue: 0,0:18:53.09,0:18:55.26,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:59.55,0:19:00.51,Default,,0,0,0,,Тамақ жеуге болмайды
Dialogue: 0,0:19:00.59,0:19:02.01,Default,,0,0,0,,(Йошимура) Коузен туралы сыбыстар кең тарала бастады—
Dialogue: 0,0:19:02.10,0:19:03.05,Default,,0,0,0,,Тамақ жеуге болмайды
Dialogue: 0,0:19:03.14,0:19:04.81,Default,,0,0,0,,(Йошимура) Коузен туралы сыбыстар кең тарала бастады—
Dialogue: 0,0:19:04.89,0:19:07.14,Default,,0,0,0,,Жеуге болмайды (қозғалтқыштың іске қосылған дыбысы)
Dialogue: 0,0:19:07.98,0:19:09.39,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:19:09.48,0:19:10.73,Default,,0,0,0,,(Йошимура) Коузен туралы сыбыстар кең тарала бастады—
Dialogue: 0,0:19:16.32,0:19:17.74,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:19:21.99,0:19:23.99,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:19:33.46,0:19:34.88,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:19:42.51,0:19:44.60,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:19:54.15,0:19:57.11,Default,,0,0,0,,Понко мырза, сіз ауырып қалдыңыз ба?
Dialogue: 0,0:19:57.65,0:20:00.03,Default,,0,0,0,,Иә, мен тірімін...
Dialogue: 0,0:20:00.11,0:20:01.28,Default,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:20:01.36,0:20:04.03,Default,,0,0,0,,Күткендей, бұл Понко айтқандай болды.
Dialogue: 0,0:20:04.12,0:20:06.53,Default,,0,0,0,,Қосымша батарея өмірімді сақтап қалды.
Dialogue: 0,0:20:06.62,0:20:08.20,Default,,0,0,0,,Келесі жолы жеңіл тағамдар ше?
Dialogue: 0,0:20:08.29,0:20:10.58,Default,,0,0,0,,Бортта 500 киловаттқа дейін тасымалдауға болады.
Dialogue: 0,0:20:11.92,0:20:13.42,Default,,0,0,0,,Понко-сан
Dialogue: 0,0:20:13.50,0:20:15.67,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:20:15.75,0:20:17.84,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:20:23.26,0:20:24.97,Default,,0,0,0,,Бұл жігітті не істейміз?
Dialogue: 0,0:20:25.05,0:20:26.68,Default,,0,0,0,,Оны өртеу үшін тым үлкен.
Dialogue: 0,0:20:26.76,0:20:28.68,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:20:29.56,0:20:30.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:32.52,0:20:33.94,Default,,0,0,0,,(Йошимура) Коузен туралы сыбыстар кең тарала бастады—
Dialogue: 0,0:20:36.27,0:20:39.40,Default,,0,0,0,,Сіздің атыңыз - Нделунрун.
Dialogue: 0,0:20:41.65,0:20:44.20,Default,,0,0,0,,Уау~ Бұл не?
Dialogue: 0,0:20:44.28,0:20:45.91,Default,,0,0,0,,Бұрын көрмеген тағам
Dialogue: 0,0:20:45.99,0:20:48.70,Default,,0,0,0,,Жаңа мәзір шынымен тәбетті емес.
Dialogue: 0,0:20:48.79,0:20:51.00,Default,,0,0,0,,Бұл әдеттегіден әлдеқайда сәнді.
Dialogue: 0,0:20:51.08,0:20:53.04,Default,,0,0,0,,Бұл мен жегенге дейін.
Dialogue: 0,0:20:53.12,0:20:54.83,Default,,0,0,0,,Мен оның дәмді екенін білемін.
Dialogue: 0,0:20:54.92,0:20:56.83,Default,,0,0,0,,Бұл қандай тағам?
Dialogue: 0,0:20:56.92,0:20:59.30,Default,,0,0,0,,Міне, Загинде.
Dialogue: 0,0:20:59.96,0:21:04.55,Default,,0,0,0,,Алдымдағы өмірге ризашылықпен, құрметпен
Dialogue: 0,0:21:04.63,0:21:06.55,Default,,0,0,0,,Алдыңғы аяқтарыңызды осылай қозғалтыңыз
Dialogue: 0,0:21:06.64,0:21:11.31,Default,,0,0,0,,«Итадакимасу» немесе «Гохисосама» деңіз
Dialogue: 0,0:21:11.39,0:21:12.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:12.81,0:21:14.69,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:21:16.65,0:21:17.94,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:21:18.02,0:21:20.48,Default,,0,0,0,,Сіз ұзақ өмір сүре аласыз
Dialogue: 0,0:21:20.57,0:21:21.78,Default,,0,0,0,,Майу~
Dialogue: 0,0:21:21.86,0:21:23.70,Default,,0,0,0,,Бірдеңе оны шешіп тастағым келеді.
Dialogue: 0,0:21:23.78,0:21:26.41,Default,,0,0,0,,Қиялдан тыс дәм
Dialogue: 0,0:21:26.49,0:21:28.95,Default,,0,0,0,,Бұл галактикадағы ең жақсысы шығар...
Dialogue: 0,0:21:29.03,0:21:30.45,Default,,0,0,0,,Әлемдегі ең жақсысы!
Dialogue: 0,0:21:30.54,0:21:32.58,Default,,0,0,0,,Бұл майлы және тамаша.
Dialogue: 0,0:21:32.66,0:21:34.00,Default,,0,0,0,,Осымен мен тұтас шәйнекті жей аламын!
Dialogue: 0,0:21:34.00,0:21:35.46,Default,,0,0,0,,Осымен мен бір шәйнекті тұтас жей аламын!
Dialogue: 0,0:21:34.00,0:21:35.46,Default,,0,0,0,,Бұл субтитрлер JOJO's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles Group бірлесіп дайындады
Dialogue: 0,0:21:35.54,0:21:37.50,Default,,0,0,0,,(Крекер дыбысы)
Dialogue: 0,0:21:37.58,0:21:38.71,Default,,0,0,0,,Қосымша миссия
Dialogue: 0,0:21:38.79,0:21:41.96,Default,,0,0,0,,Құрттармен гамбургер жасауға қол жеткізді.
Dialogue: 0,0:21:42.05,0:21:44.76,Default,,0,0,0,,«Әдемі дауыс» жаңа мүмкіндігі қосылды
Dialogue: 0,0:21:44.84,0:21:48.18,Default,,0,0,0,,Қанағаттанғаныңызға қуаныштымын.
Dialogue: 0,0:21:48.26,0:21:50.72,Default,,0,0,0,,Ас үшін рахмет!
Dialogue: 0,0:21:56.94,0:21:59.11,Default,,0,0,0,,Бәріміз тамақтанайық
Dialogue: 0,0:22:06.95,0:22:08.91,Default,,0,0,0,,Үлкенірек болыңыз
Dialogue: 0,0:22:09.95,0:22:14.95,Default,,0,0,0,,♪～
Dialogue: 0,0:22:54.95,0:22:59.87,Default,,0,0,0,,～♪
