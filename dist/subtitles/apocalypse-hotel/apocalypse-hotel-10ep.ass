Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.46,0:00:10.92,Default,,0,0,0,,Сіз анаға ұқсадыңыз ба?
Dialogue: 0,0:00:11.01,0:00:12.68,Default,,0,0,0,,Иә, жақсы болды.
Dialogue: 0,0:00:12.76,0:00:15.55,Default,,0,0,0,,Тамако-чан керемет
Dialogue: 0,0:00:15.64,0:00:17.43,Default,,0,0,0,,Ол данышпан иті.
Dialogue: 0,0:00:17.51,0:00:18.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:18.76,0:00:21.18,Default,,0,0,0,,(Тамаконың толқыған дауысы)
Dialogue: 0,0:00:22.18,0:00:25.94,Default,,0,0,0,,Әжем де қуанатынына сенімдімін.
Dialogue: 0,0:00:30.03,0:00:35.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:54.94,0:01:59.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:04.54,0:02:06.71,Default,,0,0,0,,Осы қызметті де пайдаланыңыз...
Dialogue: 0,0:02:13.42,0:02:15.42,Default,,0,0,0,,Біздің сүйікті тұтынушыларымызға
Dialogue: 0,0:02:15.51,0:02:18.34,Default,,0,0,0,,Жүректі күн және ең жақсы күлкі
Dialogue: 0,0:02:18.43,0:02:21.39,Default,,0,0,0,,Gingarou қонақ үйіне қош келдіңіз
Dialogue: 0,0:02:21.47,0:02:24.85,Default,,0,0,0,,Уууу, бүгін көңілді ме?
Dialogue: 0,0:02:24.93,0:02:25.85,Default,,0,0,0,,Иә
Dialogue: 0,0:02:25.93,0:02:26.85,Default,,0,0,0,,Хаха
Dialogue: 0,0:02:26.93,0:02:29.31,Default,,0,0,0,,Бұл тамаша болар еді.
Dialogue: 0,0:02:29.40,0:02:31.27,Default,,0,0,0,,Сіз брондадыңыз ба?
Dialogue: 0,0:02:31.36,0:02:33.61,Default,,0,0,0,,Жоқ, менде жоқ.
Dialogue: 0,0:02:33.69,0:02:35.36,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:02:35.44,0:02:37.24,Default,,0,0,0,,Сіз түнде қалғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:02:37.32,0:02:40.28,Default,,0,0,0,,Иә, мен бір түн қалғым келеді.
Dialogue: 0,0:02:40.36,0:02:43.45,Default,,0,0,0,,Мен үлкен төсегі бар бөлме болса, бақытты болар едім.
Dialogue: 0,0:02:43.53,0:02:45.74,Default,,0,0,0,,Біз сізге екі орынды бөлме бере аламыз.
Dialogue: 0,0:02:45.83,0:02:47.50,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:02:48.16,0:02:50.25,Default,,0,0,0,,Осы жерде толтырыңыз
Dialogue: 0,0:02:51.58,0:02:53.00,Default,,0,0,0,,(Кёко) Үйге бара жатып, кемінде пиджагыңды шешіп алсаңшы!
Dialogue: 0,0:02:53.09,0:02:56.51,Default,,0,0,0,,Иә, тағы екі өтінішім бар.
Dialogue: 0,0:02:57.13,0:02:59.01,Default,,0,0,0,,Иә секреция (ысырма дыбысы)
Dialogue: 0,0:02:59.09,0:03:00.26,Default,,0,0,0,,Ашимо Ашимо
Dialogue: 0,0:03:00.34,0:03:02.01,Default,,0,0,0,,Мені әдемі суретке түсіріңіз
Dialogue: 0,0:03:02.80,0:03:04.01,Default,,0,0,0,,Фотосуреттер жеткілікті.
Dialogue: 0,0:03:04.10,0:03:05.64,Default,,0,0,0,,үшін өте жақсы.
Dialogue: 0,0:03:05.72,0:03:07.47,Default,,0,0,0,,Мен ұялшақпын.
Dialogue: 0,0:03:07.56,0:03:10.77,Default,,0,0,0,,Тамақтың өз бөлмеме жеткізілгенін қалаймын.
Dialogue: 0,0:03:11.44,0:03:14.15,Default,,0,0,0,,Чул-Чулчул-сама
Dialogue: 0,0:03:14.23,0:03:15.65,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:03:15.73,0:03:18.40,Default,,0,0,0,,Тамақ сіздің бөлмеңізде беріледі.
Dialogue: 0,0:03:18.49,0:03:19.82,Default,,0,0,0,,Иә
Dialogue: 0,0:03:19.90,0:03:22.74,Default,,0,0,0,,Сондай-ақ, менің түнеп жатқаным
Dialogue: 0,0:03:22.82,0:03:25.58,Default,,0,0,0,,Біреу сұраса да
Dialogue: 0,0:03:25.66,0:03:27.41,Default,,0,0,0,,Оны құпия сақтай аласыз ба?
Dialogue: 0,0:03:29.41,0:03:31.92,Default,,0,0,0,,Тұтынушының құпиялылығына қатысты
Dialogue: 0,0:03:32.00,0:03:33.96,Default,,0,0,0,,Мен басқа ештеңе айтпаймын.
Dialogue: 0,0:03:34.04,0:03:35.59,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:03:35.67,0:03:38.42,Default,,0,0,0,,Бұл сіздің бөлме кілті.
Dialogue: 0,0:03:39.05,0:03:39.92,Default,,0,0,0,,(Портер Робо дауысы)
Dialogue: 0,0:03:40.51,0:03:42.93,Default,,0,0,0,,Әй, мен өз жүгімді өзім көтеремін.
Dialogue: 0,0:03:43.01,0:03:44.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:45.64,0:03:47.93,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:03:52.19,0:03:54.81,Default,,0,0,0,,Мына қазан... жақсы
Dialogue: 0,0:03:54.90,0:03:58.73,Default,,0,0,0,,Бірақ күшті сезімге толы осындай нәрсе,
Dialogue: 0,0:03:58.82,0:04:01.82,Default,,0,0,0,,Сіз өзіңізге ұнамайтын нәрселерді тартасыз, солай емес пе?
Dialogue: 0,0:04:03.11,0:04:04.32,Default,,0,0,0,,Уау
Dialogue: 0,0:04:04.41,0:04:05.95,Default,,0,0,0,,(Портер Робо дауысы)
Dialogue: 0,0:04:10.29,0:04:12.33,Default,,0,0,0,,Тұтынушы... Ах.
Dialogue: 0,0:04:12.41,0:04:14.58,Default,,0,0,0,,Мен саған түскі ас әкелдім.
Dialogue: 0,0:04:14.67,0:04:16.59,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:04:16.67,0:04:19.21,Default,,0,0,0,,Сонда оны сол жерге қоюға болады ма?
Dialogue: 0,0:04:21.30,0:04:23.72,Default,,0,0,0,,Сіз оны алып жүрдіңіз бе?
Dialogue: 0,0:04:23.80,0:04:27.47,Default,,0,0,0,,Иә, Тамако, мен толық емес басшы лауазымына үміткермін.
Dialogue: 0,0:04:27.55,0:04:30.43,Default,,0,0,0,,Түсіндім, рахмет.
Dialogue: 0,0:04:30.52,0:04:33.27,Default,,0,0,0,,Үлкен балаларға кәмпит беру керек.
Dialogue: 0,0:04:33.94,0:04:34.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:36.65,0:04:37.48,Default,,0,0,0,,Иә
Dialogue: 0,0:04:37.56,0:04:40.69,Default,,0,0,0,,Рахмет, ағай!
Dialogue: 0,0:04:40.78,0:04:41.99,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:04:42.07,0:04:43.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:43.40,0:04:45.45,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:45.53,0:04:47.57,Default,,0,0,0,,Тапсырыс беруші, ағай емес
Dialogue: 0,0:04:47.66,0:04:49.91,Default,,0,0,0,,саған бір нәрсені түсіндіргім келеді.
Dialogue: 0,0:04:49.99,0:04:51.25,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:04:59.67,0:05:02.05,Default,,0,0,0,,Ол бұрмаланады...
Dialogue: 0,0:05:02.13,0:05:05.09,Default,,0,0,0,,үшін бұрмаланады
Dialogue: 0,0:05:05.18,0:05:06.09,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:05:11.18,0:05:14.94,Default,,0,0,0,,Тұтынушының шығу уақыты өтті.
Dialogue: 0,0:05:16.48,0:05:19.82,Default,,0,0,0,,Тұтынушы? Мен оны ашамын
Dialogue: 0,0:05:21.40,0:05:23.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:23.57,0:05:25.15,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:05:25.24,0:05:26.82,Default,,0,0,0,,Бұл ненің иісі...
Dialogue: 0,0:05:29.70,0:05:31.33,Default,,0,0,0,,17-ші эпизод: Бэбифейс
Dialogue: 0,0:05:35.66,0:05:37.96,Default,,0,0,0,,Кофе ме?
Dialogue: 0,0:05:39.71,0:05:41.30,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:43.26,0:05:45.22,Default,,0,0,0,,(роботтардың дауыстары)
Dialogue: 0,0:05:45.30,0:05:46.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:47.01,0:05:49.97,Default,,0,0,0,,Е, бұл нені білдіреді?
Dialogue: 0,0:05:50.85,0:05:53.10,Default,,0,0,0,,Мен қауіпсіздік камерасын тексердім
Dialogue: 0,0:05:53.18,0:05:55.93,Default,,0,0,0,,Бұл бөлмеге соңғы кірген адам Понко болды.
Dialogue: 0,0:05:56.02,0:05:59.10,Default,,0,0,0,,Жоқ, жоқ! Понко, мен сені өлтірген жоқпын.
Dialogue: 0,0:05:59.19,0:06:00.61,Default,,0,0,0,,Өлген
Dialogue: 0,0:06:00.69,0:06:02.69,Default,,0,0,0,,Өлі иісі керемет
Dialogue: 0,0:06:02.78,0:06:05.86,Default,,0,0,0,,Мама, қарашы, өлді.
Dialogue: 0,0:06:05.94,0:06:07.49,Default,,0,0,0,,Тамако, сол жаққа бар!
Dialogue: 0,0:06:08.16,0:06:10.74,Default,,0,0,0,,Сонда оны қалай өлтірдің?
Dialogue: 0,0:06:10.82,0:06:13.37,Default,,0,0,0,,Бұл Понко емес.
Dialogue: 0,0:06:13.45,0:06:17.58,Default,,0,0,0,,Мен оны аздап қорқынышты тұтынушы деп ойладым.
Dialogue: 0,0:06:17.66,0:06:19.92,Default,,0,0,0,,Бірақ мен сені сол себепті өлтірмеймін.
Dialogue: 0,0:06:22.59,0:06:24.38,Default,,0,0,0,,Тыныс алу және жүрек соғу жиілігі
Dialogue: 0,0:06:24.46,0:06:27.93,Default,,0,0,0,,Мен Понконың мәлімдемесінің растығын растауға тырыстым.
Dialogue: 0,0:06:28.01,0:06:29.43,Default,,0,0,0,,Широға ұқсайды
Dialogue: 0,0:06:31.39,0:06:32.93,Default,,0,0,0,,Пу...
Dialogue: 0,0:06:33.01,0:06:35.31,Default,,0,0,0,,Ол сөзсіз күдікті болды.
Dialogue: 0,0:06:35.39,0:06:37.68,Default,,0,0,0,,Бірақ бұл Понко-сан болмаса.
Dialogue: 0,0:06:38.44,0:06:40.40,Default,,0,0,0,,Қылмыскер терезе арқылы кірді.
Dialogue: 0,0:06:40.48,0:06:43.40,Default,,0,0,0,,Сізді кез келген жолмен өлтіргеннен кейін
Dialogue: 0,0:06:43.48,0:06:46.69,Default,,0,0,0,,Ол қайтадан терезеден қашып кетті.
Dialogue: 0,0:06:46.78,0:06:51.12,Default,,0,0,0,,Дегенмен қонақ үйдің сыртқы қабырғасында жануарларды анықтау сенсоры бар.
Dialogue: 0,0:06:52.07,0:06:54.12,Default,,0,0,0,,Тірі заттар үшін мүмкін емес
Dialogue: 0,0:06:54.20,0:06:55.37,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:06:55.45,0:06:56.45,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:06:56.54,0:06:59.37,Default,,0,0,0,,Кінәлі қызметкер роботтар арасында ма?
Dialogue: 0,0:06:59.46,0:07:01.00,Default,,0,0,0,,Сіз кінәлісіз!
Dialogue: 0,0:07:01.08,0:07:02.29,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:07:02.38,0:07:02.84,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:07:02.84,0:07:05.50,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:07:02.84,0:07:05.50,Default,,0,0,0,,Аспаз, өтірік айтасыз, солай емес пе?
Dialogue: 0,0:07:05.50,0:07:06.92,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:07:07.01,0:07:08.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:08.17,0:07:10.55,Default,,0,0,0,,Қара сәбізді қосып, қара бұқтырамыз.
Dialogue: 0,0:07:10.63,0:07:12.68,Default,,0,0,0,,Ақ бұқтырылған тағам ретінде қызмет ете ме?
Dialogue: 0,0:07:14.22,0:07:15.93,Default,,0,0,0,,Бұл сөзсіз қара.
Dialogue: 0,0:07:16.01,0:07:19.39,Default,,0,0,0,,Алайда тағамның піскенін көрсететін белгілер жоқ.
Dialogue: 0,0:07:19.48,0:07:20.56,Default,,0,0,0,,Бұл Широ.
Dialogue: 0,0:07:20.64,0:07:22.31,Default,,0,0,0,,Сонда сен кінәлісің!
Dialogue: 0,0:07:22.40,0:07:23.31,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:07:23.40,0:07:25.61,Default,,0,0,0,,Ұшатын құс, мүмкін емес...
Dialogue: 0,0:07:25.69,0:07:27.23,Default,,0,0,0,,(Ұшатын робот дауысы)
Dialogue: 0,0:07:27.32,0:07:28.94,Default,,0,0,0,,Масаның қашып кетуіне жол бердіңіз бе?
Dialogue: 0,0:07:29.03,0:07:30.95,Default,,0,0,0,,(масалардың ызылдағаны)
Dialogue: 0,0:07:33.03,0:07:34.62,Default,,0,0,0,,Бұл Чикаека.
Dialogue: 0,0:07:34.70,0:07:37.12,Default,,0,0,0,,Қан сормайтын сияқты.
Dialogue: 0,0:07:37.20,0:07:38.20,Default,,0,0,0,,Бұл Широ.
Dialogue: 0,0:07:38.29,0:07:42.17,Default,,0,0,0,,Ол денемен терезеден өтуге болмайды.
Dialogue: 0,0:07:42.25,0:07:44.96,Default,,0,0,0,,А, Понко да терезені ашты.
Dialogue: 0,0:07:45.04,0:07:47.46,Default,,0,0,0,,А... Мен лабиринттемін.
Dialogue: 0,0:07:48.42,0:07:50.97,Default,,0,0,0,,Кісі өлтіру орын алған қонақ үй
Dialogue: 0,0:07:51.05,0:07:54.47,Default,,0,0,0,,Тұтынушылардың санын азайтады дейді.
Dialogue: 0,0:08:04.48,0:08:05.73,Default,,0,0,0,,Оны жасырыңыз
Dialogue: 0,0:08:05.81,0:08:07.48,Default,,0,0,0,,Иә~ (роботтардың дауыстары)
Dialogue: 0,0:08:08.07,0:08:09.57,Default,,0,0,0,,Жаңа тұтынушы
Dialogue: 0,0:08:09.65,0:08:10.74,Default,,0,0,0,,Сіз оны көре аласыз.
Dialogue: 0,0:08:12.32,0:08:13.82,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:08:17.83,0:08:18.99,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:08:19.70,0:08:22.66,Default,,0,0,0,,Біздің сүйікті тұтынушыларымызға, шын жүректен күн және ең жақсы күлкі
Dialogue: 0,0:08:22.75,0:08:24.50,Default,,0,0,0,,Gingarou қонақ үйіне қош келдіңіз
Dialogue: 0,0:08:24.58,0:08:27.00,Default,,0,0,0,,Мен ертең таңға дейін қалғым келеді.
Dialogue: 0,0:08:27.09,0:08:28.50,Default,,0,0,0,,Өмірге қайта оралыңыз!
Dialogue: 0,0:08:28.59,0:08:30.71,Default,,0,0,0,,Жоқ, ол өлді.
Dialogue: 0,0:08:30.80,0:08:32.47,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:08:32.55,0:08:34.51,Default,,0,0,0,,Мен ертеңгі ауысым туралы айтып отырмын.
Dialogue: 0,0:08:34.59,0:08:35.80,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:08:35.89,0:08:38.64,Default,,0,0,0,,Ғарыштағы ұзақ сапардан шаршадым.
Dialogue: 0,0:08:38.72,0:08:40.89,Default,,0,0,0,,Екі кісілік бөлме сұраңыз.
Dialogue: 0,0:08:40.97,0:08:43.23,Default,,0,0,0,,Біз өте өкінеміз.
Dialogue: 0,0:08:43.31,0:08:46.15,Default,,0,0,0,,Қазіргі уақытта тек бір кісілік бөлмелер бар.
Dialogue: 0,0:08:46.23,0:08:49.02,Default,,0,0,0,,Double Ол жаңа ғана қолжетімді болды.
Dialogue: 0,0:08:49.11,0:08:50.86,Default,,0,0,0,,Егер ол бос болса, онда барыңыз.
Dialogue: 0,0:08:51.82,0:08:54.99,Default,,0,0,0,,Иә Тамаконың ұсынысы Апат қасиеті
Dialogue: 0,0:08:55.07,0:08:56.32,Default,,0,0,0,,Жазатайым мүлік?
Dialogue: 0,0:08:56.41,0:08:57.41,Default,,0,0,0,,Егер бұл бір бөлмелі болса
Dialogue: 0,0:08:57.49,0:08:58.74,Default,,0,0,0,,Біз сізге бірден жол көрсете аламыз.
Dialogue: 0,0:08:59.33,0:09:01.50,Default,,0,0,0,,Жоқ, бұл екі есе.
Dialogue: 0,0:09:05.08,0:09:07.50,Default,,0,0,0,,Енді осы жерге қол қойыңыз
Dialogue: 0,0:09:07.58,0:09:09.25,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:09:09.34,0:09:15.51,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:09:16.30,0:09:20.39,Default,,0,0,0,,Әй, балалар мына жігітті танисыңдар ма?
Dialogue: 0,0:09:20.47,0:09:22.02,Default,,0,0,0,,Ағай
Dialogue: 0,0:09:22.10,0:09:23.68,Default,,0,0,0,,Сіз тұтынушысыз.
Dialogue: 0,0:09:23.77,0:09:25.10,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:09:25.19,0:09:27.15,Default,,0,0,0,,Бір-біріне ұқсаса да, ұқсамайды, шіркін.
Dialogue: 0,0:09:27.23,0:09:29.44,Default,,0,0,0,,Мен... Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:09:29.52,0:09:34.11,Default,,0,0,0,,Бұл адам, Чоро Чоро Чоро, әлем тарихындағы ең нашар адам.
Dialogue: 0,0:09:34.19,0:09:37.70,Default,,0,0,0,,Сериялық бомбалаушы психотеррорист жігіт
Dialogue: 0,0:09:38.28,0:09:41.66,Default,,0,0,0,,Сериялық бомбалаушы Сіз психотеррористсіз бе?
Dialogue: 0,0:09:41.74,0:09:42.95,Default,,0,0,0,,О
Dialogue: 0,0:09:43.04,0:09:47.92,Default,,0,0,0,,Оның кесірінен көптеген планеталарда көптеген адамдар өлді.
Dialogue: 0,0:09:48.00,0:09:50.13,Default,,0,0,0,,Егер бірдеңе білсеңіз, айтыңыз.
Dialogue: 0,0:09:50.21,0:09:52.38,Default,,0,0,0,,Ағаң да бомбалаушы жігіт пе?
Dialogue: 0,0:09:52.46,0:09:55.63,Default,,0,0,0,,Жоқ, мен осындаймын.
Dialogue: 0,0:09:57.47,0:09:59.68,Default,,0,0,0,,Ғарыштық детектив
Dialogue: 0,0:09:59.76,0:10:02.81,Default,,0,0,0,,Ойлап қарасам, ауылдың кез келген түрін түсінесің ғой, солай ма?
Dialogue: 0,0:10:03.60,0:10:05.77,Default,,0,0,0,,Нұр = Нұр Нюр-сама
Dialogue: 0,0:10:05.85,0:10:07.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:07.52,0:10:11.48,Default,,0,0,0,,Мен Чоро Чоро-сама деген адамды білмеймін.
Dialogue: 0,0:10:11.57,0:10:14.44,Default,,0,0,0,,Бөлмеңізді жинап болған соң, мен сізге қоңырау шаламын.
Dialogue: 0,0:10:14.53,0:10:15.94,Default,,0,0,0,,Сол диванда...
Dialogue: 0,0:10:16.03,0:10:18.49,Default,,0,0,0,,Жоқ, тазалаудың ортасында болғаны маңызды емес.
Dialogue: 0,0:10:18.57,0:10:20.70,Default,,0,0,0,,Тұтынушы қиындыққа тап болды
Dialogue: 0,0:10:20.78,0:10:23.41,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:10:24.29,0:10:27.21,Default,,0,0,0,,Бұл қазірдің өзінде өлімнің қыңыр иісі.
Dialogue: 0,0:10:27.29,0:10:30.46,Default,,0,0,0,,Мен оны жүздеген жарық жылдар бойы аңдып келемін.
Dialogue: 0,0:10:30.54,0:10:33.38,Default,,0,0,0,,Қайта-қайта мүмкіндіктер болды.
Dialogue: 0,0:10:33.46,0:10:36.80,Default,,0,0,0,,Бірақ ол әрқашан қамауға алу алдында қашып кетеді.
Dialogue: 0,0:10:36.88,0:10:38.22,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:10:41.97,0:10:44.89,Default,,0,0,0,,А, Тамако-сан, аяқ киімің шешіліп жатыр.
Dialogue: 0,0:10:44.97,0:10:46.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:47.27,0:10:49.69,Default,,0,0,0,,Тамако Менде аяқ киім бауы жоқ.
Dialogue: 0,0:10:49.77,0:10:51.27,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:10:51.36,0:10:53.32,Default,,0,0,0,,(Понконың гуілдеуі)
Dialogue: 0,0:10:53.40,0:10:55.28,Default,,0,0,0,,Иә, қолтықтарыңызды көтеріңіз.
Dialogue: 0,0:10:55.36,0:10:59.03,Default,,0,0,0,,Өлі иісті тазартайық~
Dialogue: 0,0:10:59.11,0:11:02.78,Default,,0,0,0,,Сәттілік неге оның жағында екенін білмеймін.
Dialogue: 0,0:11:03.41,0:11:07.83,Default,,0,0,0,,Бірақ мен жолға шыққан сайын оның мені адастыратынына сенімдімін.
Dialogue: 0,0:11:07.91,0:11:11.38,Default,,0,0,0,,Ынтымақтастық жасап, жасырынған адам пайда болады.
Dialogue: 0,0:11:11.46,0:11:12.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:12.96,0:11:14.75,Default,,0,0,0,,Енді менің аяқ киімімнің бауы
Dialogue: 0,0:11:14.84,0:11:17.05,Default,,0,0,0,,Жоқ, сізде де аяқ киім бауы жоқ.
Dialogue: 0,0:11:17.13,0:11:18.59,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:11:20.18,0:11:21.18,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:11:21.26,0:11:24.93,Default,,0,0,0,,Бірақ ол жалғыз бақытсыздыққа ұшырайды.
Dialogue: 0,0:11:25.01,0:11:27.47,Default,,0,0,0,,Онымен байланысты барлық адамдар
Dialogue: 0,0:11:27.56,0:11:30.73,Default,,0,0,0,,Оның соңы әрқашан қайғылы аяқталады, иә?
Dialogue: 0,0:11:30.81,0:11:33.23,Default,,0,0,0,,Енді аяқ киіміңіздің бауы
Dialogue: 0,0:11:37.94,0:11:39.24,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:11:41.49,0:11:43.32,Default,,0,0,0,,Иә
Dialogue: 0,0:11:43.41,0:11:45.78,Default,,0,0,0,,Жоқ... мынау... мына бөлмеде?
Dialogue: 0,0:11:47.49,0:11:49.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:58.92,0:12:00.30,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:12:00.38,0:12:01.93,Default,,0,0,0,,Маған бірдеңе дұрыс емес
Dialogue: 0,0:12:02.01,0:12:06.14,Default,,0,0,0,,Егер сізді алаңдататын болса, басқа бөлмеге ауысыңыз.
Dialogue: 0,0:12:06.22,0:12:08.56,Default,,0,0,0,,Жоқ, оның иісі жақсы.
Dialogue: 0,0:12:11.56,0:12:13.23,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:14.48,0:12:15.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:17.02,0:12:18.23,Default,,0,0,0,,О, бұл ана.
Dialogue: 0,0:12:18.32,0:12:19.48,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:12:19.57,0:12:21.99,Default,,0,0,0,,Ағай, сіз егіз болдыңыз ба?
Dialogue: 0,0:12:22.07,0:12:23.91,Default,,0,0,0,,Мен жалғыз баламын
Dialogue: 0,0:12:23.99,0:12:25.57,Default,,0,0,0,,Өйткені дәл солай.
Dialogue: 0,0:12:25.66,0:12:27.24,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:32.83,0:12:36.00,Default,,0,0,0,,Тұтынушы Түстен кейінгі шайдың уақыты келді.
Dialogue: 0,0:12:36.08,0:12:38.25,Default,,0,0,0,,Мен мұны сұраған жоқпын. Бұл тергеуге кедергі келтіреді.
Dialogue: 0,0:12:38.34,0:12:39.88,Default,,0,0,0,,Қызмет
Dialogue: 0,0:12:39.96,0:12:41.76,Default,,0,0,0,,Көмірсулар энергия береді
Dialogue: 0,0:12:41.84,0:12:43.26,Default,,0,0,0,,Бұл тергеу үшін пайдалы болады деп ойлаймыз.
Dialogue: 0,0:12:43.34,0:12:45.76,Default,,0,0,0,,Оны пайдалануыңызға болады...
Dialogue: 0,0:12:45.84,0:12:47.72,Default,,0,0,0,,Чу Чу…
Dialogue: 0,0:12:47.80,0:12:49.76,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:12:49.85,0:12:52.14,Default,,0,0,0,,Дәмі орташа.
Dialogue: 0,0:12:52.98,0:12:56.27,Default,,0,0,0,,Бірақ бұл торт табасы жақсы жұмыс істейді.
Dialogue: 0,0:12:56.98,0:13:00.86,Default,,0,0,0,,Бұл қазіргі құмырашы Яма Фугрипонның туындысы.
Dialogue: 0,0:13:01.69,0:13:05.36,Default,,0,0,0,,Мен өзімнің білгірлігіме аздап сенімдімін.
Dialogue: 0,0:13:05.45,0:13:07.62,Default,,0,0,0,,Бір қарағанда айта аласыз
Dialogue: 0,0:13:08.20,0:13:10.12,Default,,0,0,0,,Заттардың Йошиашиясы
Dialogue: 0,0:13:10.20,0:13:13.12,Default,,0,0,0,,Өтірік немесе құпия жоқ.
Dialogue: 0,0:13:13.71,0:13:15.12,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:13:20.38,0:13:22.13,Default,,0,0,0,,(ыдыстың сынған дыбысы)
Dialogue: 0,0:13:25.01,0:13:26.13,Default,,0,0,0,,Уф... (Ыдыс сынған дыбыс)
Dialogue: 0,0:13:26.89,0:13:28.97,Default,,0,0,0,,(ыдыстың сынған дыбысы)
Dialogue: 0,0:13:29.60,0:13:32.02,Default,,0,0,0,,(ыдыстың сынған дыбысы)
Dialogue: 0,0:13:32.10,0:13:35.14,Default,,0,0,0,,(ыдыстың сынған дыбысы)
Dialogue: 0,0:13:35.23,0:13:38.06,Default,,0,0,0,,(Тамаконың гуілдеуі)
Dialogue: 0,0:13:38.15,0:13:39.15,Default,,0,0,0,,Әке
Dialogue: 0,0:13:39.23,0:13:41.32,Default,,0,0,0,,Сіз маған дұрыс көмектесіп жатырсыз ба?
Dialogue: 0,0:13:41.40,0:13:44.61,Default,,0,0,0,,Иә! Мен осындай үлкен жүкті алып жүрдім.
Dialogue: 0,0:13:44.69,0:13:46.91,Default,,0,0,0,,Өте жақсы ма, мама?
Dialogue: 0,0:13:46.99,0:13:48.66,Default,,0,0,0,,Ана...
Dialogue: 0,0:13:48.74,0:13:51.03,Default,,0,0,0,,Мен мұны сұраған жоқпын. Бұл тергеуге кедергі келтіреді.
Dialogue: 0,0:13:51.12,0:13:52.33,Default,,0,0,0,,Қызмет
Dialogue: 0,0:13:52.41,0:13:53.41,Default,,0,0,0,,Гяаа (Тамако) Уау
Dialogue: 0,0:13:53.50,0:13:55.91,Default,,0,0,0,,Анашым, сіз не істеп жатырсыз?
Dialogue: 0,0:13:56.00,0:13:59.17,Default,,0,0,0,,Мен тұтынушыға монша беремін.
Dialogue: 0,0:13:59.25,0:14:02.17,Default,,0,0,0,,Кәмпит ағасымен шомылу
Dialogue: 0,0:14:02.25,0:14:04.76,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:14:05.55,0:14:06.68,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:06.76,0:14:09.89,Default,,0,0,0,,Иә? Кәмпит аға?
Dialogue: 0,0:14:09.97,0:14:11.01,Default,,0,0,0,,Иә
Dialogue: 0,0:14:12.39,0:14:13.93,Default,,0,0,0,,Мынадай бет
Dialogue: 0,0:14:16.23,0:14:18.19,Default,,0,0,0,,Бұл адам қайда?
Dialogue: 0,0:14:22.19,0:14:23.19,Default,,0,0,0,,Понко-сан
Dialogue: 0,0:14:23.28,0:14:24.99,Default,,0,0,0,,Ах Ячио-чан
Dialogue: 0,0:14:25.07,0:14:26.90,Default,,0,0,0,,Әзірше бір жерге тығып қояйық.
Dialogue: 0,0:14:26.99,0:14:27.82,Default,,0,0,0,,Иә
Dialogue: 0,0:14:36.58,0:14:38.04,Default,,0,0,0,,(Ұшатын роботтың дауысы: байланыс)
Dialogue: 0,0:14:38.12,0:14:39.83,Default,,0,0,0,,Мен осында келе жатырмын (Понко) Иә?
Dialogue: 0,0:14:50.34,0:14:51.60,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:52.18,0:14:53.31,Default,,0,0,0,,Бардың ба?
Dialogue: 0,0:14:53.39,0:14:54.39,Default,,0,0,0,,Иә
Dialogue: 0,0:14:54.47,0:14:56.73,Default,,0,0,0,,Бірақ сіз бір нәрсені сезіп тұрғаныңызға сенімдімін.
Dialogue: 0,0:14:57.31,0:15:00.06,Default,,0,0,0,,Сіз оны ешқашан таба алмайтын жерге жасыруыңыз керек.
Dialogue: 0,0:15:00.15,0:15:02.15,Default,,0,0,0,,(Оцу роботының тазалаушы дауысы)
Dialogue: 0,0:15:02.23,0:15:04.90,Default,,0,0,0,,Жақсы жасырынатын жер бар сияқты.
Dialogue: 0,0:15:09.74,0:15:11.07,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:15:11.16,0:15:12.16,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:12.24,0:15:13.66,Default,,0,0,0,,Келесі (Тазалау роботы Otsu дауысы)
Dialogue: 0,0:15:17.75,0:15:19.37,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:15:19.46,0:15:22.83,Default,,0,0,0,,Иә, санитарлық мәселелер бар.
Dialogue: 0,0:15:22.92,0:15:24.17,Default,,0,0,0,,Келесі (Тазалау роботы Otsu дауысы)
Dialogue: 0,0:15:25.46,0:15:27.51,Default,,0,0,0,,Мен сіздің бетіңізді тани алмаймын.
Dialogue: 0,0:15:27.59,0:15:29.59,Default,,0,0,0,,Келесі (Тазалау роботы Otsu дауысы)
Dialogue: 0,0:15:32.80,0:15:34.60,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:15:35.18,0:15:37.60,Default,,0,0,0,,Басқа амал жоқ еді.
Dialogue: 0,0:15:38.64,0:15:40.10,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:15:40.19,0:15:46.11,Default,,0,0,0,,(Шетелдіктердің үрейлі дауыстары)
Dialogue: 0,0:15:50.70,0:15:52.86,Default,,0,0,0,,Кя~ Қорқынышты!
Dialogue: 0,0:15:53.74,0:15:55.58,Default,,0,0,0,,Аа.
Dialogue: 0,0:15:55.66,0:15:57.74,Default,,0,0,0,,Мәселе емес шығар
Dialogue: 0,0:15:57.83,0:15:59.75,Default,,0,0,0,,Дұрыс? (Тазалау роботы Отсу дауысы)
Dialogue: 0,0:16:01.67,0:16:02.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:03.54,0:16:06.75,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:16:08.38,0:16:09.46,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:09.55,0:16:12.43,Default,,0,0,0,,Бұл планетада оны кино деп атайды.
Dialogue: 0,0:16:12.51,0:16:14.72,Default,,0,0,0,,Адамдарға Жердің этикасын түсінуге көмектесу
Dialogue: 0,0:16:14.80,0:16:17.18,Default,,0,0,0,,Сіз оған қарап отырсыз.
Dialogue: 0,0:16:17.26,0:16:19.02,Default,,0,0,0,,Бұл қызықсыз
Dialogue: 0,0:16:19.10,0:16:20.81,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:25.86,0:16:27.44,Default,,0,0,0,,Сәлем аға
Dialogue: 0,0:16:27.52,0:16:29.03,Default,,0,0,0,,Сізді не мазалайды?
Dialogue: 0,0:16:29.11,0:16:31.03,Default,,0,0,0,,Маған кәмпит беріңізші!
Dialogue: 0,0:16:31.11,0:16:33.36,Default,,0,0,0,,Өйткені сенде кәмпит бар
Dialogue: 0,0:16:33.45,0:16:35.78,Default,,0,0,0,,Сізде бар, солай ма?
Dialogue: 0,0:16:35.87,0:16:37.03,Default,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,0:16:37.12,0:16:39.62,Default,,0,0,0,,Бұл анамның сөмкесінде, сондықтан фильм аяқталғаннан кейін.
Dialogue: 0,0:16:39.70,0:16:40.54,Default,,0,0,0,,Бұл~
Dialogue: 0,0:16:45.63,0:16:47.25,Default,,0,0,0,,Сіз күткендей, детектив.
Dialogue: 0,0:16:48.88,0:16:50.42,Default,,0,0,0,,Бірақ қазірдің өзінде кеш
Dialogue: 0,0:16:51.01,0:16:53.93,Default,,0,0,0,,Менің қолым лас.
Dialogue: 0,0:16:54.01,0:16:56.85,Default,,0,0,0,,Әлі де кеш емес, күнәларыңды өте
Dialogue: 0,0:16:56.93,0:16:58.97,Default,,0,0,0,,Тек оны сүртіңіз.
Dialogue: 0,0:16:59.51,0:17:01.47,Default,,0,0,0,,Бұл не? (Бөтен планеталық) аяқтары?
Dialogue: 0,0:17:02.56,0:17:05.48,Default,,0,0,0,,(Оцу роботының тазалау дауысы)
Dialogue: 0,0:17:05.56,0:17:09.48,Default,,0,0,0,,(Шығаштардың шуы)
Dialogue: 0,0:17:09.57,0:17:12.36,Default,,0,0,0,,(Тамаконың толқыған дауысы)
Dialogue: 0,0:17:12.44,0:17:15.36,Default,,0,0,0,,Уа, уау (күшті бөтен) Ах... Хм...
Dialogue: 0,0:17:19.95,0:17:23.62,Default,,0,0,0,,Неге оны жууға болмайды?
Dialogue: 0,0:17:27.71,0:17:30.63,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:30.71,0:17:34.34,Default,,0,0,0,,Фильмдер жақсы нәрсе.
Dialogue: 0,0:17:35.97,0:17:37.51,Default,,0,0,0,,Я...
Dialogue: 0,0:17:37.59,0:17:39.39,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:17:39.47,0:17:42.39,Default,,0,0,0,,(Бөтеннің шуы)
Dialogue: 0,0:17:43.18,0:17:44.43,Default,,0,0,0,,Жібер!
Dialogue: 0,0:17:44.52,0:17:45.56,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:17:45.64,0:17:48.48,Default,,0,0,0,,Олай жасасаңыз, қонақ үйдің сапасы нашарлайды.
Dialogue: 0,0:17:48.56,0:17:50.02,Default,,0,0,0,,Білмейінше, жақсы.
Dialogue: 0,0:17:50.11,0:17:51.65,Default,,0,0,0,,Маған оны лақтырып жіберуге рұқсат етіңіз!
Dialogue: 0,0:17:51.73,0:17:56.40,Default,,0,0,0,,Мәселе бұл емес!
Dialogue: 0,0:18:00.03,0:18:02.74,Default,,0,0,0,,Бүгін жанғыш материалдар күні емес.
Dialogue: 0,0:18:02.83,0:18:03.66,Default,,0,0,0,,Я...
Dialogue: 0,0:18:04.41,0:18:06.62,Default,,0,0,0,,Понко шаршады
Dialogue: 0,0:18:06.71,0:18:08.29,Default,,0,0,0,,Өзіңізді тапсырыңыз
Dialogue: 0,0:18:08.37,0:18:11.29,Default,,0,0,0,,Мен өзімді тапсырып, таза болғым келеді.
Dialogue: 0,0:18:11.38,0:18:13.30,Default,,0,0,0,,Мен енді қаша алмаймын...
Dialogue: 0,0:18:16.01,0:18:17.05,Default,,0,0,0,,А...
Dialogue: 0,0:18:17.13,0:18:19.47,Default,,0,0,0,,Қашуға болатын нәрседен қашу жақсы емес.
Dialogue: 0,0:18:19.55,0:18:22.10,Default,,0,0,0,,Соңына дейін қашайық
Dialogue: 0,0:18:22.18,0:18:23.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:24.56,0:18:28.02,Default,,0,0,0,,Понко, мен енді қашпаймын деп шештім.
Dialogue: 0,0:18:28.10,0:18:30.65,Default,,0,0,0,,Мен тағы да қашудан қашып бара жаттым.
Dialogue: 0,0:18:30.73,0:18:31.90,Default,,0,0,0,,Иә
Dialogue: 0,0:18:34.98,0:18:36.74,Default,,0,0,0,,Қазір қаш, бірақ сен жеңесің
Dialogue: 0,0:18:36.82,0:18:39.11,Default,,0,0,0,,Жоқ, мен қашамын, бірақ тықылдаған тау
Dialogue: 0,0:18:39.20,0:18:40.99,Default,,0,0,0,,Понко жеңгісі келеді
Dialogue: 0,0:18:41.07,0:18:42.49,Default,,0,0,0,,Жеңіске жетейік
Dialogue: 0,0:18:44.29,0:18:46.04,Default,,0,0,0,,Сәлем Ячио-чан
Dialogue: 0,0:18:46.12,0:18:50.00,Default,,0,0,0,,Мен жеңбесем, бұл қаншалықты жаман болады?
Dialogue: 0,0:18:50.08,0:18:54.63,Default,,0,0,0,,Жапон заңы бойынша мәйітті тастап кету үш жылға дейін бас бостандығынан айырылады.
Dialogue: 0,0:18:54.71,0:18:57.63,Default,,0,0,0,,3 жыл… 3 жыл?
Dialogue: 0,0:18:57.72,0:19:01.01,Default,,0,0,0,,Ячио-чанмен кездескеніңізге қанша жыл болды?
Dialogue: 0,0:19:01.09,0:19:04.97,Default,,0,0,0,,527 жыл, 75 күн 6 сағат.
Dialogue: 0,0:19:05.06,0:19:08.69,Default,,0,0,0,,Осылай ойласаңыз, 3 жыл ұзақ уақыт сияқты.
Dialogue: 0,0:19:08.77,0:19:09.98,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:19:10.85,0:19:14.48,Default,,0,0,0,,Бұдан былай мәңгі бірге болайық.
Dialogue: 0,0:19:14.57,0:19:15.86,Default,,0,0,0,,Ячио-чан
Dialogue: 0,0:19:17.19,0:19:18.99,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:19:19.07,0:19:21.99,Default,,0,0,0,,Кілт...
Dialogue: 0,0:19:23.66,0:19:24.49,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:26.08,0:19:28.54,Default,,0,0,0,,Әй, бұл не деген қол!
Dialogue: 0,0:19:28.62,0:19:30.50,Default,,0,0,0,,Күте тұрыңыз! (Бөлінген бөтен) Кя~!
Dialogue: 0,0:19:30.58,0:19:32.63,Default,,0,0,0,,Бұл кісі өлтіру ісі!
Dialogue: 0,0:19:32.71,0:19:34.88,Default,,0,0,0,,Жоқ, мен ойламадым. Мен ойламадым.
Dialogue: 0,0:19:37.76,0:19:41.38,Default,,0,0,0,,Ммм!
Dialogue: 0,0:19:41.47,0:19:45.14,Default,,0,0,0,,(Понконың үрейлі дауысы)
Dialogue: 0,0:19:47.60,0:19:48.56,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:19:49.18,0:19:50.81,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:19:52.15,0:19:54.73,Default,,0,0,0,,Менің ойымша, сіз оны жасырып қалдыңыз.
Dialogue: 0,0:19:54.81,0:19:57.03,Default,,0,0,0,,Әңгіме көтерілді.
Dialogue: 0,0:19:57.11,0:19:59.03,Default,,0,0,0,,Эй... сен ештеңе жасырмайсың.
Dialogue: 0,0:19:59.11,0:20:00.61,Default,,0,0,0,,Сәлем Ячио-чан
Dialogue: 0,0:20:08.04,0:20:09.04,Default,,0,0,0,,Ол қайда!
Dialogue: 0,0:20:09.12,0:20:10.41,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:20:10.50,0:20:12.42,Default,,0,0,0,,(Көрермен) Сонымен, Мидория соңғы сегіздіктен шығып қалды ғой?
Dialogue: 0,0:20:12.50,0:20:15.29,Default,,0,0,0,,Мен Понконың сатушы күйеуімін!
Dialogue: 0,0:20:15.38,0:20:17.63,Default,,0,0,0,,Маған көмектесуге келдің бе? Понстин
Dialogue: 0,0:20:17.71,0:20:21.38,Default,,0,0,0,,Жарайды, қайталап көрейік.
Dialogue: 0,0:20:21.47,0:20:22.51,Default,,0,0,0,,Қый!
Dialogue: 0,0:20:22.59,0:20:23.89,Default,,0,0,0,,Бұл тек Шигараки Томира басқаратын Зұлымдар Альянсы ғана емес.
Dialogue: 0,0:20:24.59,0:20:28.60,Default,,0,0,0,,Оның қаншалықты қорқынышты екенін түсінбейсің.
Dialogue: 0,0:20:28.68,0:20:30.85,Default,,0,0,0,,Ол кішкентай кәмпит
Dialogue: 0,0:20:30.93,0:20:35.52,Default,,0,0,0,,Бүкіл планетаны жоюға жеткілікті бомбалар қойыңыз.
Dialogue: 0,0:20:36.44,0:20:37.94,Default,,0,0,0,,А...
Dialogue: 0,0:20:38.02,0:20:39.98,Default,,0,0,0,,Қозғалмаңыз! (Понко) Бірақ...
Dialogue: 0,0:20:40.07,0:20:44.78,Default,,0,0,0,,Балалар... сендер...
Dialogue: 0,0:20:44.86,0:20:49.29,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:49.37,0:20:52.04,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:20:58.63,0:21:00.38,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:00.96,0:21:03.76,Default,,0,0,0,,Ғарыштық детективтің интуициясы
Dialogue: 0,0:21:04.68,0:21:06.76,Default,,0,0,0,,Мен қателік жібердім...
Dialogue: 0,0:21:07.64,0:21:09.31,Default,,0,0,0,,Қалай болғанда да, осылай жалғастыра алмаймыз.
Dialogue: 0,0:21:12.39,0:21:15.06,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:21:15.14,0:21:17.73,Default,,0,0,0,,Мен жасадым мен жасадым...
Dialogue: 0,0:21:17.81,0:21:21.32,Default,,0,0,0,,Бас жарақаты өлімнің тікелей себебі болып табылмайды.
Dialogue: 0,0:21:21.40,0:21:22.24,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:21:22.32,0:21:24.07,Default,,0,0,0,,Ячио-чан, не істеуіміз керек?
Dialogue: 0,0:21:25.28,0:21:26.82,Default,,0,0,0,,Оны жасырыңыз
Dialogue: 0,0:21:40.00,0:21:41.46,Default,,0,0,0,,Әже
Dialogue: 0,0:21:42.21,0:21:45.01,Default,,0,0,0,,Ең жақсы ыдыс жасалды.
Dialogue: 0,0:22:09.95,0:22:14.95,Default,,0,0,0,,♪～
Dialogue: 0,0:22:54.95,0:22:59.87,Default,,0,0,0,,～♪
