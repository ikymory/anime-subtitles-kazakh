Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.93,0:00:25.35,Default,,0,0,0,,Бұл өте қызықты қауесет.
Dialogue: 0,0:00:25.69,0:00:28.40,Default,,0,0,0,,Бұл бейбіт заманда төңкеріс пе?
Dialogue: 0,0:00:28.86,0:00:29.69,Default,,0,0,0,,Иә
Dialogue: 0,0:00:30.11,0:00:32.90,Default,,0,0,0,,Сонымен, сіз әр филиалды аралап жүрсіз бе?
Dialogue: 0,0:00:34.20,0:00:36.91,Default,,0,0,0,,АССА-ның пайда болу себебі - себеп.
Dialogue: 0,0:00:37.32,0:00:40.16,Default,,0,0,0,,Сондықтан әрқашан өсек-аяң жүреді
Dialogue: 0,0:00:40.74,0:00:42.37,Default,,0,0,0,,Жай қауесет пе?
Dialogue: 0,0:00:42.75,0:00:44.83,Default,,0,0,0,,5-хатшы жиналысында талқылайық
Dialogue: 0,0:00:48.75,0:00:49.75,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:51.92,0:00:54.22,Default,,0,0,0,,Қазір бұл ел тыныш.
Dialogue: 0,0:00:55.84,0:00:58.72,Default,,0,0,0,,АССА – бейбітшілік символы
Dialogue: 0,0:01:05.52,0:01:11.52,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:28.89,0:02:34.90,Default,,0,0,0,,~♪
Dialogue: 0,0:02:38.15,0:02:39.90,Default,,0,0,0,,Бүгін Ниши Уордқа барасыз ба?
Dialogue: 0,0:02:40.16,0:02:41.57,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:02:41.82,0:02:44.20,Default,,0,0,0,,Мугимакиден қызанақ нан сатып алыңыз.
Dialogue: 0,0:02:44.33,0:02:45.62,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:02:46.54,0:02:48.91,Default,,0,0,0,,Қазірдің өзінде... Мен көп ішіп жатырмын, білесіз бе?
Dialogue: 0,0:02:49.87,0:02:51.08,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:52.21,0:02:54.46,Default,,0,0,0,,Иә, нұсқаулыққа назар аударыңыз!
Dialogue: 0,0:02:55.21,0:02:58.42,Default,,0,0,0,,Барлығына! Сіз ACCA туралы білесіз бе?
Dialogue: 0,0:02:59.01,0:03:02.26,Default,,0,0,0,,Сіз мұны қоғамтану сабағында оқып жатырсыз, солай емес пе, Акка-кун?
Dialogue: 0,0:03:02.55,0:03:04.68,Default,,0,0,0,,Не? Ой
Dialogue: 0,0:03:04.80,0:03:08.60,Default,,0,0,0,,АССА 99 жыл бұрын дүниеге келген!
Dialogue: 0,0:03:09.02,0:03:10.98,Default,,0,0,0,,Тағы 100 жыл бұрын
Dialogue: 0,0:03:11.35,0:03:14.56,Default,,0,0,0,,Бұл мемлекет 13 мемлекетке бөлінді.
Dialogue: 0,0:03:14.98,0:03:18.74,Default,,0,0,0,,Оларды бір елге біріктірген қазіргі патша болды ма?
Dialogue: 0,0:03:19.36,0:03:20.78,Default,,0,0,0,,Арғы ата!
Dialogue: 0,0:03:21.53,0:03:22.36,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:03:22.49,0:03:23.95,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:03:24.12,0:03:28.66,Default,,0,0,0,,Бірақ уақыт өтіп, қазіргі патшаның әкесінің уақыты келді.
Dialogue: 0,0:03:28.87,0:03:32.08,Default,,0,0,0,,Бір қызығы, Дорвар округінен басқа 12 аудан біріккен.
Dialogue: 0,0:03:32.21,0:03:34.25,Default,,0,0,0,,Біз төңкеріс жасадық!
Dialogue: 0,0:03:35.29,0:03:36.13,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:03:37.42,0:03:40.05,Default,,0,0,0,,Патшаның әкесі бейбітшілікті жақсы көретін.
Dialogue: 0,0:03:40.17,0:03:42.93,Default,,0,0,0,,Жергілікті өкілдермен пікірталас өткізу.
Dialogue: 0,0:03:43.09,0:03:45.47,Default,,0,0,0,,12 округке жергілікті автономия беру арқылы
Dialogue: 0,0:03:45.60,0:03:48.56,Default,,0,0,0,,Біз төңкерісті тоқтата алдық!
Dialogue: 0,0:03:49.18,0:03:51.81,Default,,0,0,0,,Сол кезде «астананы көшіру» туралы шешім қабылданды.
Dialogue: 0,0:03:51.94,0:03:53.60,Default,,0,0,0,,«Орталық парламентті құру»
Dialogue: 0,0:03:53.73,0:03:58.23,Default,,0,0,0,,және «саясатқа тәуелсіз жеке ұйым құру»
Dialogue: 0,0:03:58.65,0:04:02.24,Default,,0,0,0,,Бұл ұйым ACCA, солай ма?
Dialogue: 0,0:04:02.53,0:04:04.24,Default,,0,0,0,,ACCA атауының шығу тегі
Dialogue: 0,0:04:04.36,0:04:07.62,Default,,0,0,0,,Қалыптасқан жылы жойылған бейбітшілік символы...
Dialogue: 0,0:04:08.03,0:04:09.24,Default,,0,0,0,,Құстың аты Ка!
Dialogue: 0,0:04:09.95,0:04:10.87,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:04:11.00,0:04:11.91,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:04:12.04,0:04:13.87,Default,,0,0,0,,Бейбітшілік символы «Аққа»
Dialogue: 0,0:04:14.00,0:04:17.29,Default,,0,0,0,,Халық тыныштығын қорғайтын АССА!
Dialogue: 0,0:04:19.00,0:04:21.92,Default,,0,0,0,,Келесі жылы менің балам да қатысады.
Dialogue: 0,0:04:22.34,0:04:24.09,Default,,0,0,0,,Сіз сонша жастасыз ба?
Dialogue: 0,0:04:24.30,0:04:25.26,Default,,0,0,0,,Ах
Dialogue: 0,0:04:35.52,0:04:37.02,Default,,0,0,0,,
Dialogue: 0,0:04:37.15,0:04:39.07,Default,,0,0,0,,Өрт қай жерде?
Dialogue: 0,0:04:39.27,0:04:40.78,Default,,0,0,0,,Тіпті Кита Уордта
Dialogue: 0,0:04:41.99,0:04:43.24,Default,,0,0,0,,Солтүстік?
Dialogue: 0,0:04:45.53,0:04:47.03,Default,,0,0,0,,Менің ауданымда емес
Dialogue: 0,0:04:47.66,0:04:50.95,Default,,0,0,0,,Оны кінәлі етіп көрсету қиын.
Dialogue: 0,0:04:52.70,0:04:54.54,Default,,0,0,0,,Мәселе жоқ Соңы
Dialogue: 0,0:04:55.25,0:04:57.00,Default,,0,0,0,,Бұл асығыс болды.
Dialogue: 0,0:04:57.13,0:04:58.88,Default,,0,0,0,,Өйткені мұндағы филиал тамаша.
Dialogue: 0,0:04:59.00,0:05:03.30,Default,,0,0,0,,
Dialogue: 0,0:05:03.92,0:05:05.17,Default,,0,0,0,,Тағы өрт пе?
Dialogue: 0,0:05:05.34,0:05:07.80,Default,,0,0,0,,Өрт емес, тонау сияқты.
Dialogue: 0,0:05:07.97,0:05:09.97,Default,,0,0,0,,Темекі дүкеніне шабуыл жасалды.
Dialogue: 0,0:05:10.43,0:05:13.81,Default,,0,0,0,,Мм, темекі ұрылар көп.
Dialogue: 0,0:05:14.02,0:05:16.89,Default,,0,0,0,,Бұл жоғары салық салынатын ультра-люкс заты.
Dialogue: 0,0:05:17.35,0:05:20.44,Default,,0,0,0,,Басқарушының орынбасары сияқты бәріне бірдей жете бермейді.
Dialogue: 0,0:05:20.57,0:05:21.94,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:05:22.07,0:05:24.49,Default,,0,0,0,,Айтпақшы, оттықты таптыңыз ба?
Dialogue: 0,0:05:24.94,0:05:25.90,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:26.90,0:05:29.24,Default,,0,0,0,,Мүмкін табылды
Dialogue: 0,0:05:30.83,0:05:33.58,Default,,0,0,0,,Қылмыскерлердің бірі 8-ші блок арқылы солтүстікке қашып барады.
Dialogue: 0,0:05:33.95,0:05:35.50,Default,,0,0,0,,Басқа адам белгісіз
Dialogue: 0,0:05:36.79,0:05:38.04,Default,,0,0,0,,Жаңа жігітті білмейсің бе?
Dialogue: 0,0:05:38.17,0:05:39.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:39.13,0:05:41.59,Default,,0,0,0,,Ол қайтадан жалғыз әрекет етеді!
Dialogue: 0,0:05:42.17,0:05:45.97,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:46.09,0:05:46.97,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:05:49.59,0:05:50.76,Default,,0,0,0,,Бала...
Dialogue: 0,0:05:51.35,0:05:52.31,Default,,0,0,0,,Тс!
Dialogue: 0,0:05:52.76,0:05:55.14,Default,,0,0,0,,Сынақтар балалар үшін қиындық тудырады.
Dialogue: 0,0:05:56.77,0:05:58.64,Default,,0,0,0,,Ұрлағаныңды тастап кет.
Dialogue: 0,0:05:59.69,0:06:01.02,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:06:01.15,0:06:04.40,Default,,0,0,0,,Иә... Уау!
Dialogue: 0,0:06:16.37,0:06:18.83,Default,,0,0,0,,«Көшеде тұрып темекі шегуге болмайды».
Dialogue: 0,0:06:20.00,0:06:21.58,Default,,0,0,0,,Сіз оны темекі шегуге үйренгенсіз.
Dialogue: 0,0:06:23.46,0:06:24.30,Default,,0,0,0,,Теміржол бюросының қызметкері
Dialogue: 0,0:06:25.00,0:06:28.80,Default,,0,0,0,,Агенттікке қосылғаннан кейін үш ай ішінде қамауға алынғандардың ең көп саны бар болашағы зор жаңа ойыншы.
Dialogue: 0,0:06:29.93,0:06:33.35,Default,,0,0,0,,Алайда, тәркіленген заттарды жымқыру және қайта сату 4 рет
Dialogue: 0,0:06:33.72,0:06:36.43,Default,,0,0,0,,Сахна артындағы адамдармен араласты
Dialogue: 0,0:06:37.77,0:06:41.40,Default,,0,0,0,,Ол менің оттығымды пайдаланып жаман нәрсе жоспарлап жатқан сияқты.
Dialogue: 0,0:06:41.56,0:06:42.40,Default,,0,0,0,,Айтпақшы...
Dialogue: 0,0:06:43.19,0:06:46.32,Default,,0,0,0,,ACCA штаб-пәтерінде қабылдау емтиханы туралы жазба бар
Dialogue: 0,0:06:47.19,0:06:49.49,Default,,0,0,0,,Ішкі істер органдарының тергеу бөлімі анықтады ма?
Dialogue: 0,0:06:49.90,0:06:51.99,Default,,0,0,0,,Келіңіздер ме? Сіз қалай ойлайсыз?
Dialogue: 0,0:06:53.28,0:06:55.37,Default,,0,0,0,,Арнайы маршрут бар.
Dialogue: 0,0:06:56.20,0:06:58.20,Default,,0,0,0,,Дәл солай, сіз...
Dialogue: 0,0:06:59.46,0:07:00.87,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:07:01.46,0:07:04.34,Default,,0,0,0,,Кейде талмай еңбек етсең де қалағаныңа жете алмайсың.
Dialogue: 0,0:07:04.79,0:07:06.34,Default,,0,0,0,,Қандай аянышты!
Dialogue: 0,0:07:07.26,0:07:09.47,Default,,0,0,0,,Менің күш-жігерім жеткіліксіз болған сияқты!
Dialogue: 0,0:07:09.59,0:07:12.47,Default,,0,0,0,,Дүниеде ақшамен, байланыспен өмір сүретін адамдар мені мазалады!
Dialogue: 0,0:07:13.64,0:07:15.43,Default,,0,0,0,,Сол себепті мен дәрежемді төмендеттім.
Dialogue: 0,0:07:15.56,0:07:18.56,Default,,0,0,0,,Мен қосылғым келмеген филиалға барудан басқа амалым қалмады.
Dialogue: 0,0:07:20.27,0:07:22.27,Default,,0,0,0,,Сіз түсінбейсіз, солай ма?
Dialogue: 0,0:07:23.65,0:07:26.19,Default,,0,0,0,,Бұл ысырап... қымбат болса да
Dialogue: 0,0:07:26.32,0:07:27.48,Default,,0,0,0,,Ертегіні тыңдаңыз!
Dialogue: 0,0:07:28.69,0:07:29.99,Default,,0,0,0,,Сұрасаң да түсінбейсің.
Dialogue: 0,0:07:30.82,0:07:33.16,Default,,0,0,0,,Өйткені менің ақшам да, байланысым да жоқ.
Dialogue: 0,0:07:33.82,0:07:35.74,Default,,0,0,0,,Осындай жерде тұру...
Dialogue: 0,0:07:36.24,0:07:37.87,Default,,0,0,0,,Жай ғана менеджер
Dialogue: 0,0:07:39.50,0:07:42.46,Default,,0,0,0,,Сенің неліктен араласып тұрғаныңды түсінгеннен кейін мен өзімді жеңілдеп қалдым.
Dialogue: 0,0:07:42.79,0:07:46.17,Default,,0,0,0,,Сіз байларды ұнатпайтындықтан, енді маған бәрібір.
Dialogue: 0,0:07:47.00,0:07:50.01,Default,,0,0,0,,Тағы бір нәрсе айтқыңыз келеді ме? жоқ па?
Dialogue: 0,0:07:52.26,0:07:54.80,Default,,0,0,0,,Олай болса, шамды қайтара аласыз ба?
Dialogue: 0,0:07:57.18,0:08:00.06,Default,,0,0,0,,Ішкі істер тергеу бөлімі әлі байқаған жоқ деп ойлаймын.
Dialogue: 0,0:08:00.35,0:08:02.10,Default,,0,0,0,,Бұдан былай сақ болыңыз.
Dialogue: 0,0:08:03.31,0:08:04.65,Default,,0,0,0,,Сіз өз пайдаңызды сатқыңыз келе ме?
Dialogue: 0,0:08:05.77,0:08:07.36,Default,,0,0,0,,Мен инспекция бөліміненмін.
Dialogue: 0,0:08:07.73,0:08:11.15,Default,,0,0,0,,Инспекция бөлімінің жұмысы жергілікті жердегі штаб қызметкерлерін бақылау болып табылады.
Dialogue: 0,0:08:11.94,0:08:14.32,Default,,0,0,0,,Филиал қызметкерлерінің жүріс-тұрысына қатысты
Dialogue: 0,0:08:15.66,0:08:16.99,Default,,0,0,0,,Юрисдикциядан тыс
Dialogue: 0,0:08:20.75,0:08:21.79,Default,,0,0,0,,Ал...
Dialogue: 0,0:08:22.91,0:08:24.29,Default,,0,0,0,,2 см қызанақ...
Dialogue: 0,0:08:24.42,0:08:25.46,Default,,0,0,0,,Әдеттегі
Dialogue: 0,0:08:27.59,0:08:30.55,Default,,0,0,0,,Сіз осы жерде тұрдыңыз ба? Отус
Dialogue: 0,0:08:31.42,0:08:33.72,Default,,0,0,0,,Жоқ, әпкем сұрады.
Dialogue: 0,0:08:33.84,0:08:35.80,Default,,0,0,0,,Тексеру біткен соң тоқтадым.
Dialogue: 0,0:08:35.97,0:08:38.35,Default,,0,0,0,,Жарайды, әрі қарай қайда?
Dialogue: 0,0:08:38.47,0:08:39.85,Default,,0,0,0,,Джумок ауданы
Dialogue: 0,0:08:40.56,0:08:42.93,Default,,0,0,0,,Ондағы нанның әсері зор.
Dialogue: 0,0:08:43.14,0:08:45.56,Default,,0,0,0,,Бассвуд деп аталатын фастфуд мейрамханасына бару керек.
Dialogue: 0,0:08:46.15,0:08:47.73,Default,,0,0,0,,Қазір танымал болған сияқты.
Dialogue: 0,0:08:49.02,0:08:51.03,Default,,0,0,0,,Енді не болады, бастық?
Dialogue: 0,0:08:51.78,0:08:54.11,Default,,0,0,0,,Мен сізді тексеріп жатыр деп естідім.
Dialogue: 0,0:08:54.53,0:08:55.91,Default,,0,0,0,,Не болып жатыр? Неге Бугаттидің қолы мұнша суық?
Dialogue: 0,0:08:56.61,0:08:58.53,Default,,0,0,0,,5 Директордың хабарламасы
Dialogue: 0,0:09:00.58,0:09:02.95,Default,,0,0,0,,Дәл қазір бақытты көрінбедің бе?
Dialogue: 0,0:09:04.16,0:09:05.54,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:09:07.46,0:09:10.50,Default,,0,0,0,,Іссапарыңызға сәттілік тілейміз.
Dialogue: 0,0:09:16.47,0:09:18.59,Default,,0,0,0,,Бұл Оқаппа-кун қалай болды?
Dialogue: 0,0:09:24.43,0:09:25.43,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:26.31,0:09:30.40,Default,,0,0,0,,Бейбітшілік белгісі болса да, ұшып барады.
Dialogue: 0,0:09:30.82,0:09:31.94,Default,,0,0,0,,Тағы бір нәрсе ала аламын ба?
Dialogue: 0,0:09:32.07,0:09:32.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:33.03,0:09:35.19,Default,,0,0,0,,Соңғы кездері мені бақылап жүргендей сезінемін.
Dialogue: 0,0:09:36.20,0:09:38.86,Default,,0,0,0,,Тексеру бөлімі орындалады ма?
Dialogue: 0,0:09:42.37,0:09:44.58,Default,,0,0,0,,Жарайды, қарастырайық.
Dialogue: 0,0:09:45.83,0:09:47.42,Default,,0,0,0,,Жаңа ойыншы күткендей!
Dialogue: 0,0:09:48.54,0:09:51.54,Default,,0,0,0,,Сіз бұл пәтерді өртеп жіберуді жоспарладыңыз ба?
Dialogue: 0,0:09:51.75,0:09:55.17,Default,,0,0,0,,Менің ойымша, ол баяғы от жағушы.
Dialogue: 0,0:09:55.63,0:09:57.93,Default,,0,0,0,,Отусқа қарызға ақша бермедің бе?
Dialogue: 0,0:09:58.76,0:09:59.59,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:59.84,0:10:02.47,Default,,0,0,0,,Бұл сіздің әпкеңіз екеніне сенімдісіз бе? отус
Dialogue: 0,0:10:02.60,0:10:03.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:08.06,0:10:09.35,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:10:09.56,0:10:11.48,Default,,0,0,0,,Жүр, кеттік!
Dialogue: 0,0:10:11.98,0:10:12.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:15.99,0:10:16.82,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:10:17.40,0:10:18.61,Default,,0,0,0,,Нино!
Dialogue: 0,0:10:18.90,0:10:19.99,Default,,0,0,0,,Шоколад жексенбісі
Dialogue: 0,0:10:21.24,0:10:23.66,Default,,0,0,0,,Сіз өткен күні ағаңызбен бірге ішкенсіз, солай ма?
Dialogue: 0,0:10:23.78,0:10:27.08,Default,,0,0,0,,Бұл соншалықты күшті емес, сондықтан оны қалыпты түрде қабылдаңыз.
Dialogue: 0,0:10:27.20,0:10:30.21,Default,,0,0,0,,Түсінді. Сен не істеп жатырсың?
Dialogue: 0,0:10:31.33,0:10:33.34,Default,,0,0,0,,Басқару төлемдерінің бөлінуі
Dialogue: 0,0:10:33.46,0:10:35.55,Default,,0,0,0,,Хехе, мен саған кез келген уақытта тұрмысқа шыға аламын.
Dialogue: 0,0:10:35.67,0:10:37.30,Default,,0,0,0,,Күйеу алуға ниеттену
Dialogue: 0,0:10:37.42,0:10:38.26,Default,,0,0,0,,Хо
Dialogue: 0,0:10:38.84,0:10:41.01,Default,,0,0,0,,Тіпті ағаңыз ACCA-дан шығып кетсе де
Dialogue: 0,0:10:41.14,0:10:43.97,Default,,0,0,0,,Басқарушы жұмысын жалғыз орындау мүмкін емес.
Dialogue: 0,0:10:45.51,0:10:47.27,Default,,0,0,0,,Ол тастамайды.
Dialogue: 0,0:10:47.52,0:10:48.60,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:10:51.65,0:10:54.77,Default,,0,0,0,,Үлкен аға, мен инспекция бөліміндегі жұмысымды ұнатпаймын.
Dialogue: 0,0:10:54.90,0:10:56.65,Default,,0,0,0,,Неліктен тастамайсыз?
Dialogue: 0,0:10:56.82,0:10:59.24,Default,,0,0,0,,Тіпті әкімші де өте тұрақты, солай ма?
Dialogue: 0,0:10:59.78,0:11:02.57,Default,,0,0,0,,Сонымен қатар, ACCA-ның айлық жалақысы төмен.
Dialogue: 0,0:11:02.70,0:11:04.99,Default,,0,0,0,,Сіз бұл туралы айтпайсыз ба? Бауырыммен
Dialogue: 0,0:11:05.12,0:11:06.41,Default,,0,0,0,,Мен мұны ешқашан істеген емеспін.
Dialogue: 0,0:11:06.54,0:11:07.79,Default,,0,0,0,,Келесі жолы көріңіз бе?
Dialogue: 0,0:11:08.16,0:11:09.00,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:09.87,0:11:11.25,Default,,0,0,0,,Жұмыс қалай?
Dialogue: 0,0:11:11.37,0:11:14.09,Default,,0,0,0,,Мен бос емеспін, өйткені мен жақсы материал алдым.
Dialogue: 0,0:11:14.21,0:11:16.63,Default,,0,0,0,,Маған біраз уақыт ұшуым керек.
Dialogue: 0,0:11:16.75,0:11:19.38,Default,,0,0,0,,Ол бұрынғы детектив репортер.
Dialogue: 0,0:11:19.76,0:11:21.51,Default,,0,0,0,,Штаттан тыс тілші ақша таба ала ма?
Dialogue: 0,0:11:21.76,0:11:22.76,Default,,0,0,0,,Хаха
Dialogue: 0,0:11:23.76,0:11:25.14,Default,,0,0,0,,Мұның бәрі ақшаға байланысты.
Dialogue: 0,0:11:26.22,0:11:27.26,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:11:28.39,0:11:30.27,Default,,0,0,0,,Біз үшеуміз бірге тамақтансақ қалай болады?
Dialogue: 0,0:11:30.39,0:11:31.23,Default,,0,0,0,,Үйде пісіру?
Dialogue: 0,0:11:31.35,0:11:32.19,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:32.94,0:11:33.77,Default,,0,0,0,,Ойлан
Dialogue: 0,0:11:35.36,0:11:38.07,Default,,0,0,0,,Екеуің тынышталған соң кешкі ас ішейік.
Dialogue: 0,0:11:38.19,0:11:39.19,Default,,0,0,0,,Үйде тамақ дайындау
Dialogue: 0,0:11:40.19,0:11:41.53,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасай аламын
Dialogue: 0,0:11:43.45,0:11:47.28,Default,,0,0,0,,Әдеттегідей, мемлекеттік төңкеріс қауесет болып қала береді.
Dialogue: 0,0:11:47.41,0:11:48.37,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:11:48.49,0:11:51.46,Default,,0,0,0,,Мені директор Маувтың әрекет еткені алаңдатады.
Dialogue: 0,0:11:51.66,0:11:52.58,Default,,0,0,0,,Біз бәріміз құтқарылар едік
Dialogue: 0,0:11:53.00,0:11:54.50,Default,,0,0,0,,Оны ұнататын біреу
Dialogue: 0,0:11:54.63,0:11:57.80,Default,,0,0,0,,Жалаң өсек-аяңның жетегінде кетуді елестету қиын.
Dialogue: 0,0:11:58.21,0:12:00.05,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:12:00.30,0:12:01.84,Default,,0,0,0,,хатшы Гросслер
Dialogue: 0,0:12:02.09,0:12:05.89,Default,,0,0,0,,Бұл қауесетті алдын ала білдіңіз бе?
Dialogue: 0,0:12:06.47,0:12:09.72,Default,,0,0,0,,Сондай-ақ, сіз өз пікіріңізді Инспекторлық бөлімнің жалғасы ретінде өзгерттіңіз.
Dialogue: 0,0:12:09.85,0:12:11.93,Default,,0,0,0,,Бұл қауесет қатысты
Dialogue: 0,0:12:13.52,0:12:14.90,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:12:15.60,0:12:18.40,Default,,0,0,0,,Бұл мемлекеттік төңкеріс қауесет емес шығар.
Dialogue: 0,0:12:19.61,0:12:23.74,Default,,0,0,0,,Мен қауесетке қарағанда сенімді ақпарат алдым.
Dialogue: 0,0:12:24.03,0:12:27.28,Default,,0,0,0,,Инспекция бөлімі директорының орынбасары Джин Ортас
Dialogue: 0,0:12:27.66,0:12:30.45,Default,,0,0,0,,Ол осы төңкеріс жоспарына қатысы бар.
Dialogue: 0,0:12:30.58,0:12:32.75,Default,,0,0,0,,Сіз бұл темекіні шегесіз бе?
Dialogue: 0,0:12:32.96,0:12:34.42,Default,,0,0,0,,Кейбіреулеріңіз
Dialogue: 0,0:12:34.54,0:12:36.96,Default,,0,0,0,,Мазалаған адам жоқ па?
Dialogue: 0,0:12:38.00,0:12:41.92,Default,,0,0,0,,Директор Маув тергеуді тоқтатуға бұйрық берді.
Dialogue: 0,0:12:43.22,0:12:46.43,Default,,0,0,0,,Бұл мәселені біздің бес комиссар ғана шешеді.
Dialogue: 0,0:12:47.55,0:12:50.85,Default,,0,0,0,,Отус Инспекция бөліміне миссиямен ауылға барады.
Dialogue: 0,0:12:50.97,0:12:53.89,Default,,0,0,0,,Сіз төңкеріс жасайтын топтармен байланыстасыз ба?
Dialogue: 0,0:12:54.89,0:12:56.44,Default,,0,0,0,,Мүмкін болмаса да
Dialogue: 0,0:12:56.56,0:12:59.77,Default,,0,0,0,,Ол ауыстыру туралы бірнеше өтініш жібергенін айтты.
Dialogue: 0,0:13:00.11,0:13:00.94,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:01.32,0:13:05.82,Default,,0,0,0,,Бұл адамның шынымен ауыстыру туралы өтініш бергені туралы жазба жоқ.
Dialogue: 0,0:13:09.53,0:13:11.37,Default,,0,0,0,,Көру сызығын жоғалту
Dialogue: 0,0:13:11.95,0:13:13.41,Default,,0,0,0,,Нино күткендей
Dialogue: 0,0:13:13.95,0:13:15.54,Default,,0,0,0,,Инспекция бөлімінің қызмет ету мерзімін ұзарту
Dialogue: 0,0:13:15.66,0:13:17.58,Default,,0,0,0,,Мен оны бақылауға алдым.
Dialogue: 0,0:13:17.71,0:13:19.84,Default,,0,0,0,,Ол мен ойлағаннан да айлакер.
Dialogue: 0,0:13:20.67,0:13:24.09,Default,,0,0,0,,Бізде бақылаушы күзетші болуы керек.
Dialogue: 0,0:13:25.22,0:13:29.55,Default,,0,0,0,,Ішкі істер тергеу бөлімінің жасырын қызметкері болу үшін мінсіз адам болды.
Dialogue: 0,0:13:30.22,0:13:32.81,Default,,0,0,0,,Құпия офицерлер тікелей 5-ші директорға есеп береді.
Dialogue: 0,0:13:33.06,0:13:37.44,Default,,0,0,0,,Ішкі істер органдарының тергеу бөлімшесінің өзінде де аты-жөнін жасырған бұл адамдардың шынайы бет-бейнесін білетін ешкім жоқ.
Dialogue: 0,0:13:37.73,0:13:40.31,Default,,0,0,0,,Вокзалда бізден басқа ешкім жоқ.
Dialogue: 0,0:13:40.77,0:13:43.15,Default,,0,0,0,,Әрине, Отус та солай.
Dialogue: 0,0:13:44.24,0:13:45.24,Default,,0,0,0,,
Dialogue: 0,0:13:46.11,0:13:46.95,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:13:47.11,0:13:48.99,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:13:53.58,0:13:55.12,Default,,0,0,0,,Осы «Қарғадан»
Dialogue: 0,0:13:55.58,0:13:58.75,Default,,0,0,0,,Жан Отустың жетекшісі болып тағайындалды.
Dialogue: 0,0:14:02.50,0:14:04.92,Default,,0,0,0,,Бөлме 406-бөлме.
Dialogue: 0,0:14:05.59,0:14:08.09,Default,,0,0,0,,Таңғы асты сағат нешеде ішуім керек?
Dialogue: 0,0:14:08.59,0:14:11.05,Default,,0,0,0,,Жақсы, тамақ ішу үшін залға түс.
Dialogue: 0,0:14:11.64,0:14:13.10,Default,,0,0,0,,Біз оны сізге әкелеміз.
Dialogue: 0,0:14:14.10,0:14:15.98,Default,,0,0,0,,Содан кейін сағат 8-де
Dialogue: 0,0:14:18.44,0:14:19.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:21.44,0:14:22.27,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:24.78,0:14:27.07,Default,,0,0,0,,Бөлме мен брондаған бөлмеден бөлек.
Dialogue: 0,0:14:27.74,0:14:30.16,Default,,0,0,0,,Бізге солай істеу керектігі айтылған.
Dialogue: 0,0:14:40.58,0:14:41.79,Default,,0,0,0,,Басшының орынбасары!
Dialogue: 0,0:14:42.33,0:14:43.71,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:43.84,0:14:44.84,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:46.76,0:14:48.55,Default,,0,0,0,,Бүгін мен мұнда тексердім...
Dialogue: 0,0:14:48.67,0:14:50.47,Default,,0,0,0,,Міне...
Dialogue: 0,0:14:50.59,0:14:54.35,Default,,0,0,0,,Отус, Jumoke-ге қош келдіңіз.
Dialogue: 0,0:14:54.85,0:14:55.81,Default,,0,0,0,,Филиал менеджері
Dialogue: 0,0:14:55.93,0:14:58.18,Default,,0,0,0,,Қонақ үй Назар аударғаныңызға рахмет.
Dialogue: 0,0:14:59.02,0:14:59.85,Default,,0,0,0,,Иә
Dialogue: 0,0:15:00.48,0:15:03.73,Default,,0,0,0,,Егер сізде қандай да бір мәселе болса, кез келген уақытта маған хабарлаңыз.
Dialogue: 0,0:15:09.03,0:15:12.95,Default,,0,0,0,,Шын мәнінде, негізгі жүйе бүгін таңертеңнен бері істен шықты.
Dialogue: 0,0:15:13.62,0:15:16.16,Default,,0,0,0,,Бізде қазір қалпына келтіру жұмыстары жүріп жатыр.
Dialogue: 0,0:15:16.29,0:15:18.62,Default,,0,0,0,,Бұл өте ескі.
Dialogue: 0,0:15:18.87,0:15:20.71,Default,,0,0,0,,Мен кешке бірдеңе істеймін.
Dialogue: 0,0:15:21.67,0:15:24.38,Default,,0,0,0,,Жарайды, мен барлығына түскі асын сатып аламын.
Dialogue: 0,0:15:25.00,0:15:26.17,Default,,0,0,0,,Бас ағашы бар
Dialogue: 0,0:15:26.75,0:15:27.80,Default,,0,0,0,,Эх!
Dialogue: 0,0:15:29.76,0:15:31.05,Default,,0,0,0,,Бұл ауданда дақылдардың мөлшері
Dialogue: 0,0:15:31.47,0:15:33.84,Default,,0,0,0,,қалыптыдан 2,5 есе көп!
Dialogue: 0,0:15:34.18,0:15:36.93,Default,,0,0,0,,Сондықтан барлық тағамдар мега өлшемді!
Dialogue: 0,0:15:37.18,0:15:38.60,Default,,0,0,0,,Дегенмен, бас ағашының басқалардан ерекшелігі сол
Dialogue: 0,0:15:38.72,0:15:41.06,Default,,0,0,0,,Бұл өте жақсы!
Dialogue: 0,0:15:42.02,0:15:43.31,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:43.65,0:15:47.48,Default,,0,0,0,,Соңғы алты айда барлығының көлемі жақсарды.
Dialogue: 0,0:15:48.07,0:15:51.95,Default,,0,0,0,,Жас ұрпақтың орташа бойы қайтадан өскен сияқты.
Dialogue: 0,0:15:52.07,0:15:54.37,Default,,0,0,0,,2 метр 22 сантиметр
Dialogue: 0,0:15:54.87,0:15:56.20,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:15:57.87,0:15:59.41,Default,,0,0,0,,Торт алғыңыз келе ме?
Dialogue: 0,0:15:59.79,0:16:00.62,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:01.54,0:16:03.37,Default,,0,0,0,,Сонымен бәрі...
Dialogue: 0,0:16:06.71,0:16:07.54,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:16:09.84,0:16:11.13,Default,,0,0,0,,Бұл тым үлкен
Dialogue: 0,0:16:12.88,0:16:14.01,Default,,0,0,0,,Нино
Dialogue: 0,0:16:14.84,0:16:15.84,Default,,0,0,0,,Сұхбат
Dialogue: 0,0:16:15.97,0:16:16.80,Default,,0,0,0,,Иә
Dialogue: 0,0:16:16.93,0:16:20.93,Default,,0,0,0,,Мен мұнда жергілікті жігіттің ұсынысынан кейін келдім, сен осындасың.
Dialogue: 0,0:16:23.14,0:16:26.65,Default,,0,0,0,,Сол көзқарас... Содан бері оны мүлдем сезбедім.
Dialogue: 0,0:16:26.77,0:16:27.77,Default,,0,0,0,,(Нацуки Субару) Ол қыз неге мұнда? Әлі күндізгі уақыт қой.
Dialogue: 0,0:16:28.73,0:16:30.40,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:16:30.73,0:16:34.49,Default,,0,0,0,,Ол бейбақ еді, сонда әлгі Оқаппа-күнге қатысы жоқ па?
Dialogue: 0,0:16:34.78,0:16:36.82,Default,,0,0,0,,Аа~ түсіндім.
Dialogue: 0,0:16:36.95,0:16:39.16,Default,,0,0,0,,Мүмкін қазір жақсы шығар.
Dialogue: 0,0:16:39.91,0:16:41.04,Default,,0,0,0,,Әрқашан жаман
Dialogue: 0,0:16:41.70,0:16:43.21,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:16:43.96,0:16:44.83,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:16:45.25,0:16:47.25,Default,,0,0,0,,Бір жерде кешкі ас ішуге қалай болады?
Dialogue: 0,0:16:47.84,0:16:48.67,Default,,0,0,0,,Мен сізге хабарласамын.
Dialogue: 0,0:16:49.09,0:16:50.88,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:16:53.84,0:16:56.18,Default,,0,0,0,,Мен сізбен жаңа ғана хабарластым.
Dialogue: 0,0:16:56.30,0:16:59.56,Default,,0,0,0,,Күтілгендей, бүгінге дейін қалпына келу мүмкін емес сияқты.
Dialogue: 0,0:16:59.72,0:17:00.56,Default,,0,0,0,,Иә
Dialogue: 0,0:17:01.35,0:17:03.68,Default,,0,0,0,,Ал, бүгін басқа жерге барайық.
Dialogue: 0,0:17:04.18,0:17:05.60,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:11.28,0:17:13.07,Default,,0,0,0,,Сіз қалай ойлайсыз? Қалпына келтіру болып табылады
Dialogue: 0,0:17:15.11,0:17:17.86,Default,,0,0,0,,Соңында қалпына келтіру мүмкін болмады.
Dialogue: 0,0:17:18.03,0:17:19.91,Default,,0,0,0,,Түсіндім, басқа амалым жоқ.
Dialogue: 0,0:17:20.03,0:17:21.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:21.70,0:17:23.41,Default,,0,0,0,,Автомат тірі ме?
Dialogue: 0,0:17:23.58,0:17:24.46,Default,,0,0,0,,Иә
Dialogue: 0,0:17:24.66,0:17:27.58,Default,,0,0,0,,Дегенмен, менде резервтік көшірме болмайтын күндер бар.
Dialogue: 0,0:17:27.71,0:17:31.34,Default,,0,0,0,,Енді сол енгізу жұмысын да орындауым керек.
Dialogue: 0,0:17:32.25,0:17:33.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:33.96,0:17:35.01,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:17:36.26,0:17:39.60,Default,,0,0,0,,Кешіріңіз, мен сізді мектептен үйге қайтар жолда кездесіп қалдым.
Dialogue: 0,0:17:40.30,0:17:43.06,Default,,0,0,0,,Қол астындағылар маған беруімді өтінді.
Dialogue: 0,0:17:43.18,0:17:45.10,Default,,0,0,0,,Дүкеннің қай жерде екенін білмеймін.
Dialogue: 0,0:17:45.52,0:17:47.94,Default,,0,0,0,,Жаңғақ торттарына келетін болсақ, бұл.
Dialogue: 0,0:17:48.06,0:17:49.98,Default,,0,0,0,,Мен де қызық болдым.
Dialogue: 0,0:17:51.52,0:17:53.86,Default,,0,0,0,,Иә, иә, дәмді!
Dialogue: 0,0:17:54.07,0:17:55.94,Default,,0,0,0,,Довар ауданы әйгілі.
Dialogue: 0,0:17:56.07,0:17:59.49,Default,,0,0,0,,Торттың бұл түрі қарапайым және нәзік дәмге ие.
Dialogue: 0,0:18:00.24,0:18:02.16,Default,,0,0,0,,Сізге патша ұнай ма?
Dialogue: 0,0:18:02.28,0:18:04.33,Default,,0,0,0,,Эй, мен сонда бардым!
Dialogue: 0,0:18:04.45,0:18:07.08,Default,,0,0,0,,Мен де ол жерде ешқашан болған емеспін.
Dialogue: 0,0:18:08.12,0:18:11.63,Default,,0,0,0,,Джин мен сені аяймын.
Dialogue: 0,0:18:12.04,0:18:14.17,Default,,0,0,0,,Жарты жылда барлық филиалдарды аралау мүмкін емес.
Dialogue: 0,0:18:14.88,0:18:18.18,Default,,0,0,0,,Негізі мен кейбір нәрселерді өз қолыма алғым келеді.
Dialogue: 0,0:18:19.01,0:18:23.51,Default,,0,0,0,,Мен ұшақтарды, пойыздарды және басқа көліктерді ұнатпаймын.
Dialogue: 0,0:18:23.89,0:18:25.14,Default,,0,0,0,,Мас
Dialogue: 0,0:18:25.85,0:18:29.27,Default,,0,0,0,,Мүлде жоқ! Менің ағам да айналаны жақсы көреді.
Dialogue: 0,0:18:29.39,0:18:30.35,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:30.94,0:18:33.32,Default,,0,0,0,,Қат! Сен не туралы айтып тұрсың?
Dialogue: 0,0:18:33.44,0:18:35.53,Default,,0,0,0,,Мен сенімен шай ішкім келеді.
Dialogue: 0,0:18:36.36,0:18:37.74,Default,,0,0,0,,Күткендей, сүйкімді...
Dialogue: 0,0:18:37.86,0:18:39.40,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:39.61,0:18:40.57,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:41.57,0:18:43.83,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:18:43.95,0:18:47.54,Default,,0,0,0,,Менеджердің орынбасарына рахмет, біз жоспарланған уақыттан ерте бітіретін сияқтымыз!
Dialogue: 0,0:18:49.16,0:18:51.50,Default,,0,0,0,,Тағы бір дем, барымызды салайық.
Dialogue: 0,0:18:51.67,0:18:52.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:54.67,0:18:55.50,Default,,0,0,0,,Нашар
Dialogue: 0,0:18:55.63,0:18:58.38,Default,,0,0,0,,Хмм... Ақаулық па?
Dialogue: 0,0:18:58.51,0:18:59.42,Default,,0,0,0,,О
Dialogue: 0,0:19:00.63,0:19:01.64,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:19:03.43,0:19:04.72,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:05.43,0:19:06.68,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:19:06.93,0:19:08.06,Default,,0,0,0,,Аяқтауға жақын
Dialogue: 0,0:19:08.64,0:19:09.56,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:19:09.69,0:19:12.15,Default,,0,0,0,,Жұмысыңызды ауыстырып, жұмысыма көмектесесіз бе?
Dialogue: 0,0:19:12.48,0:19:14.82,Default,,0,0,0,,Мен барлық жерде ұшып кетсем екен...
Dialogue: 0,0:19:15.27,0:19:17.53,Default,,0,0,0,,Ал сен жалғызсың, солай ма?
Dialogue: 0,0:19:18.82,0:19:21.99,Default,,0,0,0,,Мм... сенің менен басқа достарың бар ма?
Dialogue: 0,0:19:22.70,0:19:25.41,Default,,0,0,0,,Менің араласуға уақытым жоқ.
Dialogue: 0,0:19:25.66,0:19:28.04,Default,,0,0,0,,Мен бос уақытымда велосипедпен жүргім келеді.
Dialogue: 0,0:19:28.16,0:19:29.29,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:19:29.87,0:19:30.96,Default,,0,0,0,,Сізбен бірге ішемін, солай ма?
Dialogue: 0,0:19:32.04,0:19:34.25,Default,,0,0,0,,Ол ешқашан өзгермейді.
Dialogue: 0,0:19:35.42,0:19:37.92,Default,,0,0,0,,15 жылға жуық уақыт болды ма?
Dialogue: 0,0:19:38.05,0:19:38.88,Default,,0,0,0,,О
Dialogue: 0,0:19:39.38,0:19:42.22,Default,,0,0,0,,Сізде жақындауға қиын нәрселер бар.
Dialogue: 0,0:19:42.68,0:19:43.72,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:19:43.84,0:19:47.14,Default,,0,0,0,,Орта мектепте алғаш танысқаннан бері солай болды.
Dialogue: 0,0:19:48.35,0:19:50.10,Default,,0,0,0,,Айналадан қалықтау
Dialogue: 0,0:19:51.19,0:19:53.90,Default,,0,0,0,,Олай десеңіз, сіз де жақсы болдыңыз.
Dialogue: 0,0:19:54.02,0:19:55.73,Default,,0,0,0,,Адамдарды алыс ұстаңыз
Dialogue: 0,0:19:58.65,0:20:02.82,Default,,0,0,0,,Екеуміз бір жағынан ұқсас едік, сондықтан тіл табысып кеттік.
Dialogue: 0,0:20:04.87,0:20:08.54,Default,,0,0,0,,Ал сен де солайсың, Джин.
Dialogue: 0,0:20:08.87,0:20:10.20,Default,,0,0,0,,ACCA-ға қосылу
Dialogue: 0,0:20:10.33,0:20:14.46,Default,,0,0,0,,Мен ол аздап ресми болады деп ойладым, бірақ мүлде емес.
Dialogue: 0,0:20:14.71,0:20:17.50,Default,,0,0,0,,Тексеру бөліміндегі адамдар жақсы.
Dialogue: 0,0:20:17.63,0:20:20.46,Default,,0,0,0,,Мен инспекция бөлімінің жұмысын жек көремін.
Dialogue: 0,0:20:20.67,0:20:22.51,Default,,0,0,0,,Ах, жарамсыз.
Dialogue: 0,0:20:23.09,0:20:25.22,Default,,0,0,0,,Бірақ сіз бас тартпайсыз
Dialogue: 0,0:20:25.51,0:20:27.68,Default,,0,0,0,,Шығармауымның себебі бар.
Dialogue: 0,0:20:27.97,0:20:28.93,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:20:29.72,0:20:30.68,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:20:31.77,0:20:33.73,Default,,0,0,0,,Мен түсінуге мүмкіндік жоқ.
Dialogue: 0,0:20:34.52,0:20:39.07,Default,,0,0,0,,Мен шағымдансам да тастамаймын, сондықтан бірдеңе болады деп ойлайсың. Әдетте.
Dialogue: 0,0:20:39.44,0:20:41.74,Default,,0,0,0,,Хмм, мен тастасам да...
Dialogue: 0,0:20:43.07,0:20:44.74,Default,,0,0,0,,Сол темекіні бірінші рет көру
Dialogue: 0,0:20:45.32,0:20:49.66,Default,,0,0,0,,Аа, мен де бірінші рет көріп тұрмын.
Dialogue: 0,0:20:51.83,0:20:53.08,Default,,0,0,0,,Сіз шарап ішесіз бе?
Dialogue: 0,0:20:54.33,0:20:57.00,Default,,0,0,0,,Кәдесыйлар Сіз оларды әлі де біреуге сатып аласыз ба?
Dialogue: 0,0:20:57.13,0:20:58.96,Default,,0,0,0,,Мен сізге бұрын айтқанмын!
Dialogue: 0,0:20:59.34,0:21:01.17,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:21:02.26,0:21:03.55,Default,,0,0,0,,Жан Отус
Dialogue: 0,0:21:03.67,0:21:06.01,Default,,0,0,0,,Мен Джумоке ауданынан темекі алдым.
Dialogue: 0,0:21:06.80,0:21:10.10,Default,,0,0,0,,Сондай-ақ, мені бақылап отыру уақытты босқа кетіреді.
Dialogue: 0,0:21:10.64,0:21:14.64,Default,,0,0,0,,Тағы да меннен артық тамашалайтын адам жоқ.
Dialogue: 0,0:21:16.02,0:21:19.23,Default,,0,0,0,,Сен маған сенеді деп ойладым.
Dialogue: 0,0:21:21.44,0:21:24.78,Default,,0,0,0,,Шешім қабылдауға көп уақыт қажет болды.
Dialogue: 0,0:21:25.32,0:21:26.57,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:21:27.49,0:21:29.49,Default,,0,0,0,,Сіз Жан Отустың досысыз.
Dialogue: 0,0:21:30.33,0:21:31.45,Default,,0,0,0,,Қарға
Dialogue: 0,0:21:31.70,0:21:33.62,Default,,0,0,0,,Қол астындағылардың қадағалауы
Dialogue: 0,0:21:33.75,0:21:36.00,Default,,0,0,0,,Джин Отус ашқан
Dialogue: 0,0:21:37.04,0:21:39.58,Default,,0,0,0,,Мен мұндай нәрсені істемес едім.
Dialogue: 0,0:21:40.09,0:21:41.71,Default,,0,0,0,,Сыбыс шындыққа айналды
Dialogue: 0,0:21:41.84,0:21:44.88,Default,,0,0,0,,Көп ұзамай басқа бастықтар біледі.
Dialogue: 0,0:21:46.47,0:21:48.26,Default,,0,0,0,,Мен сізге қайта хабарласамын.
Dialogue: 0,0:21:50.39,0:21:53.93,Default,,0,0,0,,Ол менің көзімді ешқашан байқамады.
Dialogue: 0,0:21:55.73,0:21:58.02,Default,,0,0,0,,30 жыл ешқашан бір рет емес
Dialogue: 0,0:21:59.77,0:22:00.61,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:22:01.27,0:22:03.11,Default,,0,0,0,,Джумоке ауданындағы картоп чипсы мен нан!
Dialogue: 0,0:22:03.69,0:22:04.61,Default,,0,0,0,,Бұл үлкен!
Dialogue: 0,0:22:04.74,0:22:06.36,Default,,0,0,0,,Келесі қайда?
Dialogue: 0,0:22:06.95,0:22:09.82,Default,,0,0,0,,2 аптадан кейін тәттілер бөлімі
Dialogue: 0,0:22:09.95,0:22:11.83,Default,,0,0,0,,Сіз баяулатуға болады.
Dialogue: 0,0:22:12.66,0:22:16.00,Default,,0,0,0,,Ендеше мен сені бүгін кешке сонда көремін.
Dialogue: 0,0:22:16.71,0:22:18.08,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:18.83,0:22:21.04,Default,,0,0,0,,Қайта кездескенше, Отус.
Dialogue: 0,0:22:22.25,0:22:23.92,Default,,0,0,0,,Сіз ше, бастық?
Dialogue: 0,0:22:24.17,0:22:27.22,Default,,0,0,0,,Иә? Бұл Джумок ауданындағы нан ба?
Dialogue: 0,0:22:27.80,0:22:29.97,Default,,0,0,0,,Мен тым көп сатып алдым.
Dialogue: 0,0:22:30.80,0:22:34.14,Default,,0,0,0,,Оны қабылдаңыз. Рақмет сізге.
Dialogue: 0,0:22:36.18,0:22:37.35,Default,,0,0,0,,Отус мырза
Dialogue: 0,0:22:38.85,0:22:41.94,Default,,0,0,0,,Осы демалыс күндері түнде боссыз ба?
Dialogue: 0,0:22:46.44,0:22:52.45,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:24:09.28,0:24:15.28,Default,,0,0,0,,~♪
Dialogue: 0,0:24:17.08,0:24:19.83,Default,,0,0,0,,Келесі жолы «ACCA 13-ші палаталық инспекция бөлімі»
Dialogue: 0,0:24:19.95,0:24:22.79,Default,,0,0,0,,«Қамал үстінде ілулі тұрған қауесеттердің түтіні»
Dialogue: 0,0:24:22.96,0:24:23.83,Default,,0,0,0,,Хаа…
Dialogue: 0,0:24:23.96,0:24:26.92,Default,,0,0,0,,Ген әлі ештеңе байқамаған сияқты.
Dialogue: 0,0:24:27.17,0:24:30.63,Default,,0,0,0,,Жарайды... не болса да, менен қашып құтыла алмайсың.
Dialogue: 0,0:24:32.13,0:24:38.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory