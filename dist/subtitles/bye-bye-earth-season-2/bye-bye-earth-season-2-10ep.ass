Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.10,0:00:06.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:08.10,0:00:10.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:12.11,0:00:14.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:15.11,0:00:18.11,Default,,0,0,0,,Аа... Аа (сыбдырлаған дыбыс)
Dialogue: 0,0:00:21.12,0:00:25.12,Default,,0,0,0,,(Қоңыраудың ұйқысы)
Dialogue: 0,0:00:25.12,0:00:27.12,Default,,0,0,0,,Иә
Dialogue: 0,0:00:45.14,0:00:47.14,Default,,0,0,0,,Ах
Dialogue: 0,0:00:48.14,0:00:50.15,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:00:50.15,0:00:54.15,Default,,0,0,0,,Себебі сұралды ма?
Dialogue: 0,0:00:54.15,0:00:57.15,Default,,0,0,0,,Көгілдір... Ах
Dialogue: 0,0:01:00.16,0:01:18.11,Default,,0,0,0,,♬～
Dialogue: 0,0:01:18.11,0:01:22.11,Default,,0,0,0,,♬～
Dialogue: 0,0:01:22.11,0:01:42.13,Default,,0,0,0,,♬～
Dialogue: 0,0:01:42.13,0:02:02.08,Default,,0,0,0,,♬～
Dialogue: 0,0:02:02.08,0:02:22.10,Default,,0,0,0,,♬～
Dialogue: 0,0:02:22.10,0:02:31.11,Default,,0,0,0,,♬～
Dialogue: 0,0:02:31.11,0:02:34.12,Default,,0,0,0,,Менің есімім есіңізде ме?
Dialogue: 0,0:02:34.12,0:02:38.12,Default,,0,0,0,,Н... Ғафтың аузынан естідім.
Dialogue: 0,0:02:38.12,0:02:43.13,Default,,0,0,0,,көремін. Бұл қылышты кім жалғады?
Dialogue: 0,0:02:43.13,0:02:46.13,Default,,0,0,0,,Бұлт семсерді алған кезде➡
Dialogue: 0,0:02:46.13,0:02:49.13,Default,,0,0,0,,Ол сол адамды байланыстыруды сеніп тапсырғанын айтты.
Dialogue: 0,0:02:49.13,0:02:53.14,Default,,0,0,0,,Бірден сауығып кетсе де, қылышқа салынған ниеттің пішіні болар➡
Dialogue: 0,0:02:53.14,0:02:56.14,Default,,0,0,0,,Менің ойымша, бұл басқа қылыштардан түбегейлі ерекшеленеді ...
Dialogue: 0,0:02:56.14,0:02:58.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:59.14,0:03:01.08,Default,,0,0,0,,Жарайсың Белл
Dialogue: 0,0:03:01.08,0:03:03.08,Default,,0,0,0,,Ах...!
Dialogue: 0,0:03:03.08,0:03:07.08,Default,,0,0,0,,Сіз Құдайды және халықты керемет түрде дәріптедіңіз.
Dialogue: 0,0:03:07.08,0:03:12.09,Default,,0,0,0,,Өзіңіздің шығу тегіңіз туралы саяхатыңыздың кілтін сұрау ғана қалды.
Dialogue: 0,0:03:12.09,0:03:16.09,Default,,0,0,0,,Білмеймін, «Дуаж» маған нені білдіреді?
Dialogue: 0,0:03:16.09,0:03:21.10,Default,,0,0,0,,Маған үйретсең, ұмытып кетіппін.
Dialogue: 0,0:03:21.10,0:03:23.10,Default,,0,0,0,,Тыңда, Белл.
Dialogue: 0,0:03:23.10,0:03:26.10,Default,,0,0,0,,Гүл ашса, бүршік жоғалады
Dialogue: 0,0:03:26.10,0:03:30.11,Default,,0,0,0,,Жемістер піскен кезде гүлдер де жойылады.
Dialogue: 0,0:03:30.11,0:03:34.11,Default,,0,0,0,,Бірақ гүлсіз жеміс өспейді.
Dialogue: 0,0:03:34.11,0:03:39.11,Default,,0,0,0,,Сондықтан гүлдер әрқашан гүлдейді, бүршіктер де қажет.
Dialogue: 0,0:03:39.11,0:03:44.12,Default,,0,0,0,,Бәрі де қайталап жүретін жол.
Dialogue: 0,0:03:44.12,0:03:49.12,Default,,0,0,0,,Өмірдің аяқталуы айға ұқсас іс-әрекеттердің шексіз ілгерілеуін білдіреді.
Dialogue: 0,0:03:49.12,0:03:52.13,Default,,0,0,0,,Мәңгілік сағынышты аңдығандай
Dialogue: 0,0:03:52.13,0:03:57.13,Default,,0,0,0,,Қылышыңдағы белгі осыны білдіреді.
Dialogue: 0,0:03:57.13,0:04:00.14,Default,,0,0,0,,Сіз мұны бұрыннан білесіз
Dialogue: 0,0:04:00.14,0:04:06.14,Default,,0,0,0,,Менің қамытымнан әлдеқашан құтылдың, ұстаз.
Dialogue: 0,0:04:09.08,0:04:12.08,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:04:12.08,0:04:14.08,Default,,0,0,0,,Сен елессің
Dialogue: 0,0:04:14.08,0:04:18.09,Default,,0,0,0,,Мен сені баяғыда өлтірдім.
Dialogue: 0,0:04:18.09,0:04:20.09,Default,,0,0,0,,Бірақ, бірақ...
Dialogue: 0,0:04:20.09,0:04:22.09,Default,,0,0,0,,Осылай кездессек те➡
Dialogue: 0,0:04:22.09,0:04:25.09,Default,,0,0,0,,Менің ойымша, бұл жаман емес.
Dialogue: 0,0:04:25.09,0:04:27.10,Default,,0,0,0,,Бірде мүлде ұмытып кетіппін➡
Dialogue: 0,0:04:27.10,0:04:32.10,Default,,0,0,0,,Мен бірінші рет кездескенім жақсы болар деп ойладым.
Dialogue: 0,0:04:32.10,0:04:34.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:35.10,0:04:37.11,Default,,0,0,0,,)
Dialogue: 0,0:04:37.11,0:04:39.11,Default,,0,0,0,,Га
Dialogue: 0,0:04:39.11,0:04:43.11,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,0:04:45.11,0:04:47.12,Default,,0,0,0,,Сен менің үмітімсің
Dialogue: 0,0:04:47.12,0:04:52.12,Default,,0,0,0,,Міндеті жалғыздық болған мен үшін шын үміт қандай➡
Dialogue: 0,0:04:52.12,0:04:55.12,Default,,0,0,0,,Тіпті өз болмысымның жұмбақ ортасында➡
Dialogue: 0,0:04:55.12,0:04:58.13,Default,,0,0,0,,Бұл жалғыз емес екеніңізді білу туралы.
Dialogue: 0,0:04:58.13,0:05:00.13,Default,,0,0,0,,Уф…
Dialogue: 0,0:05:00.13,0:05:04.07,Default,,0,0,0,,Бір күні сіз саяхатшы да, Аштық Альянсының мүшесі де болмайсыз➡
Dialogue: 0,0:05:04.07,0:05:07.07,Default,,0,0,0,,Сондай-ақ, бұл екеуі де➡ сияқты
Dialogue: 0,0:05:07.07,0:05:12.07,Default,,0,0,0,,Осы дүниеде өз өміріңіз үшін күресетін адам болуды мақсат етіңіз.
Dialogue: 0,0:05:12.07,0:05:15.08,Default,,0,0,0,,Бұл менің тілегім
Dialogue: 0,0:05:16.08,0:05:19.08,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:27.09,0:05:30.09,Default,,0,0,0,,Сапарыңызда тағы кездесейік➡
Dialogue: 0,0:05:30.09,0:05:32.09,Default,,0,0,0,,Оны асыға күтейік
Dialogue: 0,0:05:36.10,0:05:40.10,Default,,0,0,0,,Қош бол, Сиан
Dialogue: 0,0:05:42.10,0:05:45.11,Default,,0,0,0,,(Өлім құсының сайрауы)
Dialogue: 0,0:05:45.11,0:05:48.11,Default,,0,0,0,,Ол адам әлі сапарға шықты ма?
Dialogue: 0,0:05:48.11,0:05:51.11,Default,,0,0,0,,Иә, қазір сенің кезегің, Белл.
Dialogue: 0,0:05:51.11,0:05:54.12,Default,,0,0,0,,Рахмет, бірақ бұған дейін➡
Dialogue: 0,0:05:54.12,0:05:58.12,Default,,0,0,0,,Мен бір нәрсеге назар аударуым керек.
Dialogue: 0,0:05:58.12,0:06:00.12,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:00.12,0:06:02.06,Default,,0,0,0,,Бұл Сэнди Коллинз.
Dialogue: 0,0:06:02.06,0:06:04.06,Default,,0,0,0,,Адонистің ағалары туралы
Dialogue: 0,0:06:04.06,0:06:06.06,Default,,0,0,0,,Қайтыс болған ата-анамның орнына➡
Dialogue: 0,0:06:06.06,0:06:10.07,Default,,0,0,0,,Мен арыстанның құрсағындағы бас діни қызметкерді ұстаймын.
Dialogue: 0,0:06:13.07,0:06:16.07,Default,,0,0,0,,Қашу мен сезімталдықтың қазына қылышы
Dialogue: 0,0:06:16.07,0:06:19.07,Default,,0,0,0,,Біз мұнда не көреміз?
Dialogue: 0,0:06:19.07,0:06:23.08,Default,,0,0,0,,Мұны қылышты қайта тірілтетін емтихан сиқыры деп атауға болады➡
Dialogue: 0,0:06:23.08,0:06:25.08,Default,,0,0,0,,Жұмбақ сиқыр
Dialogue: 0,0:06:25.08,0:06:28.08,Default,,0,0,0,,Не? Егер сіз мұны жасасаңыз ...
Dialogue: 0,0:06:29.08,0:06:32.09,Default,,0,0,0,,Тыныш жүрекпен қараңыздар.
Dialogue: 0,0:06:32.09,0:06:37.09,Default,,0,0,0,,Бұл біз Коллинз қорғайтын тағы бір құдай құпиясы.
Dialogue: 0,0:06:37.09,0:06:39.09,Default,,0,0,0,,Басқа Құдай?
Dialogue: 0,0:06:39.09,0:06:41.10,Default,,0,0,0,,Гиннес, сіз не жоспарлап отырсыз?
Dialogue: 0,0:06:41.10,0:06:44.10,Default,,0,0,0,,Мен де анық білмеймін.
Dialogue: 0,0:06:44.10,0:06:46.10,Default,,0,0,0,,Сіз тағы да...
Dialogue: 0,0:06:46.10,0:06:48.10,Default,,0,0,0,,бастайық
Dialogue: 0,0:06:48.10,0:06:51.11,Default,,0,0,0,,Міне, мен саған көрсеткім келді, Белл.
Dialogue: 0,0:06:51.11,0:06:53.11,Default,,0,0,0,,А...
Dialogue: 0,0:06:58.11,0:07:11.06,Default,,0,0,0,,♬～
Dialogue: 0,0:07:11.06,0:07:13.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.06,0:07:16.06,Default,,0,0,0,,Біз жұмбақты осы жерде және қазір аштық.
Dialogue: 0,0:07:16.06,0:07:19.07,Default,,0,0,0,,(Өлім құсының сайрауы)
Dialogue: 0,0:07:19.07,0:07:38.09,Default,,0,0,0,,♬～
Dialogue: 0,0:07:38.09,0:07:41.09,Default,,0,0,0,,Соңында 300-ден астам оқ аттым
Dialogue: 0,0:07:41.09,0:07:43.09,Default,,0,0,0,,Не бар➡
Dialogue: 0,0:07:43.09,0:07:45.09,Default,,0,0,0,,Бар нәрсенің аты
Dialogue: 0,0:07:45.09,0:07:48.10,Default,,0,0,0,,Бұл атаудың механикалық құдайы бар➡
Dialogue: 0,0:07:48.10,0:07:52.10,Default,,0,0,0,,Біздің өмір сүруіміздің себебі туралы ойымызды қамтиды.
Dialogue: 0,0:07:52.10,0:07:56.10,Default,,0,0,0,,Тән болмай, тек ақыл бар➡
Dialogue: 0,0:07:56.10,0:08:00.11,Default,,0,0,0,,Дегенмен, халықты билеуші құдай болу үшін➡
Dialogue: 0,0:08:00.11,0:08:03.04,Default,,0,0,0,,Адам болып өсу➡
Dialogue: 0,0:08:03.04,0:08:06.05,Default,,0,0,0,,Менің өзім тыйым салудан басқа амалым қалмады➡
Dialogue: 0,0:08:06.05,0:08:09.05,Default,,0,0,0,,Құдайдың механикалық ойлары
Dialogue: 0,0:08:09.05,0:08:12.05,Default,,0,0,0,,《Машина құдайы үшін өлім жоқ》
Dialogue: 0,0:08:12.05,0:08:14.06,Default,,0,0,0,,《Тіршілік бітеді➡
Dialogue: 0,0:08:14.06,0:08:17.06,Default,,0,0,0,,Әу бастан ешқашан болмаған сияқты➡
Dialogue: 0,0:08:17.06,0:08:19.06,Default,,0,0,0,,Жоғалып кетуден басқа амал жоқ》
Dialogue: 0,0:08:19.06,0:08:23.06,Default,,0,0,0,,Шындықты іздеуде бөтеннің денесіне ие болу➡
Dialogue: 0,0:08:23.06,0:08:26.07,Default,,0,0,0,,Құдайдың жын-шайтан қалауы➡
Dialogue: 0,0:08:26.07,0:08:29.07,Default,,0,0,0,,Ақыры қарға гүлге айналды.
Dialogue: 0,0:08:29.07,0:08:33.07,Default,,0,0,0,,Қарға гүлі марқұмның жүрегін өлім туралы хабар ретінде жеткізеді➡
Dialogue: 0,0:08:33.07,0:08:37.08,Default,,0,0,0,,Ол алғашында құдайлар ағашынан туғандықтан ба?
Dialogue: 0,0:08:37.08,0:08:39.08,Default,,0,0,0,,Құдайда бір рет➡
Dialogue: 0,0:08:39.08,0:08:43.08,Default,,0,0,0,,Болмыстың себебі туралы ойлар өзіне-өзі қарама-қайшылық тудырғанда➡
Dialogue: 0,0:08:43.08,0:08:46.09,Default,,0,0,0,,Сол сезім қорды бөліскендей құтылады➡
Dialogue: 0,0:08:46.09,0:08:49.09,Default,,0,0,0,,Осы катакомбаны құрады
Dialogue: 0,0:08:49.09,0:08:52.09,Default,,0,0,0,,Міне, Құдай өз халқына өліммен күресуге мүмкіндік береді➡
Dialogue: 0,0:08:52.09,0:08:55.10,Default,,0,0,0,,дүниеге келген
Dialogue: 0,0:08:55.10,0:08:59.10,Default,,0,0,0,,Бірақ құлып құдайы жаңадан келе жатқан адамның еркін жоққа шығарды➡
Dialogue: 0,0:08:59.10,0:09:04.04,Default,,0,0,0,,Осыдан кейін ол өшпенділікпен Катакомбаға бірнеше рет шабуыл жасады.
Dialogue: 0,0:09:04.04,0:09:08.04,Default,,0,0,0,,Бұл ағаш одан қашу сезіміне толы➡
Dialogue: 0,0:09:08.04,0:09:12.05,Default,,0,0,0,,Мен де өз болмысыма деген сезімталдыққа батып кеттім.
Dialogue: 0,0:09:12.05,0:09:15.05,Default,,0,0,0,,Сіз бұл ағашпен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:09:15.05,0:09:17.05,Default,,0,0,0,,Кесу
Dialogue: 0,0:09:17.05,0:09:21.06,Default,,0,0,0,,Кесуден кейін семсерді өсіру үшін діңді тұқым алаңы ретінде пайдаланыңыз➡
Dialogue: 0,0:09:21.06,0:09:25.06,Default,,0,0,0,,Бұл заклинанияны екі дайын қылышқа бөліңіз.
Dialogue: 0,0:09:25.06,0:09:27.06,Default,,0,0,0,,Тамыры қарға көшетіне айналады➡
Dialogue: 0,0:09:27.06,0:09:29.06,Default,,0,0,0,,Қалғаны қуырылған және тазартылған➡
Dialogue: 0,0:09:29.06,0:09:31.07,Default,,0,0,0,,Сынаушының күлі бол
Dialogue: 0,0:09:31.07,0:09:33.07,Default,,0,0,0,,Қазына қылыш қайта сынғанда➡
Dialogue: 0,0:09:33.07,0:09:35.07,Default,,0,0,0,,Жандану
Dialogue: 0,0:09:35.07,0:09:38.07,Default,,0,0,0,,Бұл катакомбалардың құпия заңы➡
Dialogue: 0,0:09:38.07,0:09:42.08,Default,,0,0,0,,Бұл Құдай болудың тағы бір жолы.
Dialogue: 0,0:09:42.08,0:09:44.08,Default,,0,0,0,,Ловерак Белл-доно, ах.
Dialogue: 0,0:09:44.08,0:09:48.08,Default,,0,0,0,,Мына ағашты кесуіңізді өтінемін.
Dialogue: 0,0:09:48.08,0:09:50.09,Default,,0,0,0,,Маған? (Қылышшылардың күбірі)
Dialogue: 0,0:09:50.09,0:09:56.09,Default,,0,0,0,,Қамал құдайының құмарлығын сол қылышпен босатқан саған.
Dialogue: 0,0:09:56.09,0:09:59.09,Default,,0,0,0,,Осы ағашта қылышымды сынауға рұқсат етсеңіз➡
Dialogue: 0,0:09:59.09,0:10:01.10,Default,,0,0,0,,Қуанышпен
Dialogue: 0,0:10:01.10,0:10:04.10,Default,,0,0,0,,Қара қоңырауды жақсы көр! (Қылыш шебері) Жабайы сұлу!
Dialogue: 0,0:10:04.10,0:10:07.10,Default,,0,0,0,,Бұл қылыш тіпті құдайларды да кесіп тастайды!
Dialogue: 0,0:10:07.10,0:10:11.11,Default,,0,0,0,,Әлемді тесіңіз
Dialogue: 0,0:10:11.11,0:10:13.11,Default,,0,0,0,,《Сіз сыйлық аласыз》
Dialogue: 0,0:10:16.11,0:10:18.11,Default,,0,0,0,,Хааах!
Dialogue: 0,0:10:18.11,0:10:20.12,Default,,0,0,0,,Таа!
Dialogue: 0,0:10:24.12,0:10:26.12,Default,,0,0,0,,О...
Dialogue: 0,0:10:31.13,0:10:34.13,Default,,0,0,0,,《Кесу...》
Dialogue: 0,0:10:40.13,0:10:44.14,Default,,0,0,0,,Саяхаттың кілті - тәртіп орталығы➡
Dialogue: 0,0:10:44.14,0:10:46.14,Default,,0,0,0,,Ол тек ағынды қара көлеңкеде болады
Dialogue: 0,0:10:46.14,0:10:50.14,Default,,0,0,0,,Қара уақыт, қара бағыт, мінекей!
Dialogue: 0,0:10:50.14,0:10:53.15,Default,,0,0,0,,Сіз оны алуыңыз керек!
Dialogue: 0,0:10:53.15,0:10:55.15,Default,,0,0,0,,Біздің шайқаста➡
Dialogue: 0,0:10:55.15,0:10:58.15,Default,,0,0,0,,Кілттер өте маңызды болады
Dialogue: 0,0:10:58.15,0:11:02.09,Default,,0,0,0,,Бұдан былай катакомбаларды қорғаймыз➡
Dialogue: 0,0:11:02.09,0:11:04.09,Default,,0,0,0,,Жоғарғы иттер мен бағыныштыларды бағындыру үшін шайқаста➡
Dialogue: 0,0:11:04.09,0:11:06.09,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:11:06.09,0:11:09.10,Default,,0,0,0,,Мен әлемдегі өзгерістердің бастамашысымын➡
Dialogue: 0,0:11:09.10,0:11:12.10,Default,,0,0,0,,Сенің семсеріңнен басқа ешкім ашпаған болуы➡
Dialogue: 0,0:11:12.10,0:11:14.10,Default,,0,0,0,,Мен үлкен үміт күтемін.
Dialogue: 0,0:11:14.10,0:11:16.10,Default,,0,0,0,,Бұл үшін рахмет.
Dialogue: 0,0:11:16.10,0:11:21.11,Default,,0,0,0,,Сіз әрқашан жойылу ішінде жасайсыз.
Dialogue: 0,0:11:21.11,0:11:26.11,Default,,0,0,0,,Сенің семсерің жолдың кілтіне не әкеледі деп ойлаймын.
Dialogue: 0,0:11:26.11,0:11:30.12,Default,,0,0,0,,Сенің сөзің менің үмітім Гиннес
Dialogue: 0,0:11:30.12,0:11:33.12,Default,,0,0,0,,Менің семсерім жойылуда➡
Dialogue: 0,0:11:33.12,0:11:36.12,Default,,0,0,0,,Бір нәрсені жасау мүмкіндігі бар➡
Dialogue: 0,0:11:36.12,0:11:39.13,Default,,0,0,0,,Маған батылдық береді
Dialogue: 0,0:11:39.13,0:11:43.13,Default,,0,0,0,,Біз сені жалғыз қалдырмаймыз, уәде береміз
Dialogue: 0,0:11:43.13,0:11:47.14,Default,,0,0,0,,Мен сынау үшін қылыш ұстаймын
Dialogue: 0,0:11:47.14,0:11:50.14,Default,,0,0,0,,Кез келген уақытта, кез келген жерде
Dialogue: 0,0:11:50.14,0:11:53.14,Default,,0,0,0,,⚟Қоңырау! ⚟Махаббат қара = қоңырау!
Dialogue: 0,0:11:53.14,0:11:55.14,Default,,0,0,0,,⚟Шығыңыз!
Dialogue: 0,0:11:55.14,0:11:58.15,Default,,0,0,0,,Барлығы, бұл жігіт...
Dialogue: 0,0:11:58.15,0:12:01.08,Default,,0,0,0,,Мен саяхатқа шығу керек деп ойладым.
Dialogue: 0,0:12:01.08,0:12:03.08,Default,,0,0,0,,Бізде бар нәрседен➡
Dialogue: 0,0:12:03.08,0:12:07.09,Default,,0,0,0,,Бірінші жүлде: Мен Беллге ұнайтынын таңдадым.
Dialogue: 0,0:12:07.09,0:12:10.09,Default,,0,0,0,,Сіз қалай ойлайсыз? Жарайды ма?
Dialogue: 0,0:12:10.09,0:12:12.09,Default,,0,0,0,,Я, мен саған мынаны беремін.
Dialogue: 0,0:12:12.09,0:12:17.10,Default,,0,0,0,,Беннетт: Мүмкін сіз оны орындаған шығарсыз?
Dialogue: 0,0:12:17.10,0:12:19.10,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:12:19.10,0:12:21.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:21.10,0:12:23.10,Default,,0,0,0,,Қош келдіңіз, Белл
Dialogue: 0,0:12:23.10,0:12:25.11,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:25.11,0:12:27.11,Default,,0,0,0,,Фуфу
Dialogue: 0,0:12:27.11,0:12:29.11,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:30.11,0:12:33.11,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:12:33.11,0:12:37.12,Default,,0,0,0,,Енді соңғы тармаққа тоқталайық.
Dialogue: 0,0:12:37.12,0:12:39.12,Default,,0,0,0,,Бұл, Белл-доно.
Dialogue: 0,0:12:39.12,0:12:41.12,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:41.12,0:12:43.12,Default,,0,0,0,,Біздің жұмбақ киім
Dialogue: 0,0:12:43.12,0:12:47.13,Default,,0,0,0,,Бұл Адонис киюі керек еді. Ах...
Dialogue: 0,0:12:47.13,0:12:52.13,Default,,0,0,0,,Менің ойымша, бұл саяхат үшін жаман идея емес.
Dialogue: 0,0:12:53.13,0:12:58.14,Default,,0,0,0,,《Мен бұл елде тұрдым》
Dialogue: 0,0:12:58.14,0:13:00.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:03.08,0:13:06.08,Default,,0,0,0,,Мен кілтті таба алмадым
Dialogue: 0,0:13:06.08,0:13:08.08,Default,,0,0,0,,Бұл сізге мүмкін бе?
Dialogue: 0,0:13:08.08,0:13:12.09,Default,,0,0,0,,Менің ойымша, біз тырысамыз.
Dialogue: 0,0:13:12.09,0:13:15.09,Default,,0,0,0,,Белл, кілтті білмеймін➡
Dialogue: 0,0:13:15.09,0:13:18.09,Default,,0,0,0,,Басқа таңдау бар сияқты.
Dialogue: 0,0:13:18.09,0:13:20.09,Default,,0,0,0,,Бұл мөр.
Dialogue: 0,0:13:20.09,0:13:22.10,Default,,0,0,0,,Сіздің қылыш достарыңыз➡
Dialogue: 0,0:13:22.10,0:13:24.10,Default,,0,0,0,,Елді тыныштандыру үшін күрестің белгісі ретінде➡
Dialogue: 0,0:13:24.10,0:13:29.10,Default,,0,0,0,,Сондай-ақ тапсырыстан құтылу жолы ретінде кілтті іздеу.
Dialogue: 0,0:13:29.10,0:13:31.11,Default,,0,0,0,,Егер кілтті жою мүмкін болмаса➡
Dialogue: 0,0:13:31.11,0:13:34.11,Default,,0,0,0,,Оны осылай мәңгілікке жабуға болады➡
Dialogue: 0,0:13:34.11,0:13:37.11,Default,,0,0,0,,Бұл менің ережем.
Dialogue: 0,0:13:37.11,0:13:40.11,Default,,0,0,0,,Я, мен үшін әрқашан бір жол бар
Dialogue: 0,0:13:40.11,0:13:43.12,Default,,0,0,0,,Егер бірдеңеде жасырын ниет болса➡
Dialogue: 0,0:13:43.12,0:13:46.12,Default,,0,0,0,,Мен оны босатамын
Dialogue: 0,0:13:46.12,0:13:50.12,Default,,0,0,0,,Қара уақыт Қара бағыты
Dialogue: 0,0:13:50.12,0:13:53.13,Default,,0,0,0,,Сенің семсерің жұмбақты шеше ме?
Dialogue: 0,0:13:53.13,0:13:56.13,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:13:56.13,0:14:12.08,Default,,0,0,0,,♬～
Dialogue: 0,0:14:12.08,0:14:14.08,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:14:21.09,0:14:24.09,Default,,0,0,0,,Бұл... жолдың кілті ме?
Dialogue: 0,0:14:24.09,0:14:27.10,Default,,0,0,0,,Бұл Аштық Одағының көлеңкесі сияқты.
Dialogue: 0,0:14:27.10,0:14:31.10,Default,,0,0,0,,Саяхаттың және Аштық Альянсының аштығының кілті екеніне сенімдімін➡
Dialogue: 0,0:14:31.10,0:14:34.10,Default,,0,0,0,,Мен осы илаһи ағаштың көлеңкесінен тудым.
Dialogue: 0,0:14:34.10,0:14:36.10,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:14:41.11,0:14:43.11,Default,,0,0,0,,《сыналуда》
Dialogue: 0,0:14:43.11,0:14:47.12,Default,,0,0,0,,《Көшпенділер мен аштық одақтарының шығу тегі бір ме?》
Dialogue: 0,0:14:47.12,0:14:50.12,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:14:50.12,0:14:52.12,Default,,0,0,0,,А... уф
Dialogue: 0,0:14:52.12,0:14:54.12,Default,,0,0,0,,Дааа!
Dialogue: 0,0:14:57.13,0:15:00.13,Default,,0,0,0,,《Жаңа нені кестің? 》
Dialogue: 0,0:15:01.06,0:15:04.07,Default,,0,0,0,,Қатысу
Dialogue: 0,0:15:09.07,0:15:11.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:18.08,0:15:23.08,Default,,0,0,0,,♪（『Ｌａ Ｃａｍｐａｎｅｌｌａ』）
Dialogue: 0,0:15:23.08,0:15:25.09,Default,,0,0,0,,♪～
Dialogue: 0,0:15:25.09,0:15:27.09,Default,,0,0,0,,Ән айту...
Dialogue: 0,0:15:27.09,0:15:37.10,Default,,0,0,0,,♪～
Dialogue: 0,0:15:37.10,0:15:40.10,Default,,0,0,0,,《Сағыныш…》
Dialogue: 0,0:15:40.10,0:16:00.12,Default,,0,0,0,,♪～
Dialogue: 0,0:16:00.12,0:16:04.06,Default,,0,0,0,,♪～
Dialogue: 0,0:16:04.06,0:16:09.06,Default,,0,0,0,,《Мен тірі тұрмын》
Dialogue: 0,0:16:09.06,0:16:16.07,Default,,0,0,0,,♪～
Dialogue: 0,0:16:16.07,0:16:18.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:18.07,0:16:22.08,Default,,0,0,0,,Қалай! Саяхаттың кілті біздің көлеңкемізде
Dialogue: 0,0:16:22.08,0:16:25.08,Default,,0,0,0,,Көшпеліліктің жаңа түрі
Dialogue: 0,0:16:25.08,0:16:30.08,Default,,0,0,0,,Жол кілтінің әуенін өз көлеңкесінде естігендер➡
Dialogue: 0,0:16:30.08,0:16:33.09,Default,,0,0,0,,Жаңа көшпенді бол
Dialogue: 0,0:16:34.09,0:16:37.09,Default,,0,0,0,,Мен оны кесіп алдым (сүю дыбысы)
Dialogue: 0,0:16:37.09,0:16:41.10,Default,,0,0,0,,《Гиннестің жігіті, сен мұны тыңдап тұрсың ба?》
Dialogue: 0,0:16:41.10,0:16:46.10,Default,,0,0,0,,《Енді Ғафф екеуіңнің арасындағы кикілжіңнің себебі жойылды》
Dialogue: 0,0:16:46.10,0:16:50.10,Default,,0,0,0,,《Кілт сенің көлеңкеңде! 》
Dialogue: 0,0:16:50.10,0:16:52.11,Default,,0,0,0,,Дәл осы сәт сияқты➡
Dialogue: 0,0:16:52.11,0:16:57.11,Default,,0,0,0,,Елдің бәрі айдалаға бет алған көшпендіге айналғандай.
Dialogue: 0,0:16:57.11,0:17:00.11,Default,,0,0,0,,Сынақ сәтті аяқталды.
Dialogue: 0,0:17:00.11,0:17:02.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:02.05,0:17:07.05,Default,,0,0,0,,Мен сені патша ретінде және жай қылышшы ретінде шығарып саламын.
Dialogue: 0,0:17:07.05,0:17:10.06,Default,,0,0,0,,Күндердің күнінде тағы да осы елдің сахнасына шығасың➡
Dialogue: 0,0:17:10.06,0:17:13.06,Default,,0,0,0,,Қылыш музыкасы ойналатын уақытқа дейін
Dialogue: 0,0:17:13.06,0:17:16.06,Default,,0,0,0,,Қоштасу қоңырауы
Dialogue: 0,0:17:16.06,0:17:18.07,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:17:18.07,0:17:21.07,Default,,0,0,0,,Қош бол
Dialogue: 0,0:17:24.07,0:17:26.07,Default,,0,0,0,,Сіз бізге➡
Dialogue: 0,0:17:26.07,0:17:30.08,Default,,0,0,0,,Сен маған сыйлық ретінде осы көбелек бақшасын көрсеттің.
Dialogue: 0,0:17:30.08,0:17:33.08,Default,,0,0,0,,Мен жаңа ғана қылышты сермедім
Dialogue: 0,0:17:33.08,0:17:37.08,Default,,0,0,0,,Керісінше, сен өміріңді қатерге тігіп ән айтып, Құдайдан сұрадың➡
Dialogue: 0,0:17:37.08,0:17:40.09,Default,,0,0,0,,Менің ойымша, бұл жауап.
Dialogue: 0,0:17:40.09,0:17:43.09,Default,,0,0,0,,Мына көбелекке қарап➡
Dialogue: 0,0:17:43.09,0:17:46.09,Default,,0,0,0,,Мен өзімнің қалай өзгергенімді көріп тұрғандай сезінемін.
Dialogue: 0,0:17:46.09,0:17:50.10,Default,,0,0,0,,Мен кім екенімді білемін деп ойлаған кезде➡
Dialogue: 0,0:17:50.10,0:17:53.10,Default,,0,0,0,,Тағы бір жауап алыс.
Dialogue: 0,0:17:53.10,0:17:56.10,Default,,0,0,0,,Ха... шынымен шексіз
Dialogue: 0,0:17:56.10,0:18:01.04,Default,,0,0,0,,Дүние үшін осылай күресесің бе?
Dialogue: 0,0:18:01.04,0:18:03.04,Default,,0,0,0,,Осы дүниенің барлық адамдарына➡
Dialogue: 0,0:18:03.04,0:18:09.05,Default,,0,0,0,,Өзіміздің кім екенімізге куә болу.
Dialogue: 0,0:18:09.05,0:18:12.05,Default,,0,0,0,,Дүниені иығыммен көтергім келмейді
Dialogue: 0,0:18:12.05,0:18:15.06,Default,,0,0,0,,Мен жай ғана адам болғым келеді
Dialogue: 0,0:18:15.06,0:18:20.06,Default,,0,0,0,,Дүниеде мен басқалармен араласатын адам болғым келеді.
Dialogue: 0,0:18:20.06,0:18:24.07,Default,,0,0,0,,Менің атым Белл, басқа ештеңе жоқ.
Dialogue: 0,0:18:24.07,0:18:28.07,Default,,0,0,0,,Сонда да қылышты әлемге бұлғап сұрағым келеді
Dialogue: 0,0:18:28.07,0:18:31.07,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:18:31.07,0:18:35.08,Default,,0,0,0,,Еркіндігім, Сағынышымның бастауы
Dialogue: 0,0:18:35.08,0:18:38.08,Default,,0,0,0,,Мен кіммін?➡
Dialogue: 0,0:18:38.08,0:18:41.08,Default,,0,0,0,,Егер сіз кішкене болса да құндылықты сезіне алсаңыз➡
Dialogue: 0,0:18:41.08,0:18:43.08,Default,,0,0,0,,Мен бұған жақсымын.
Dialogue: 0,0:18:43.08,0:18:46.09,Default,,0,0,0,,өте жақсы
Dialogue: 0,0:18:46.09,0:18:49.09,Default,,0,0,0,,Белл шешім қабылдады
Dialogue: 0,0:18:49.09,0:18:51.09,Default,,0,0,0,,Мен бақсы болғым келеді.
Dialogue: 0,0:18:51.09,0:18:53.09,Default,,0,0,0,,Ведьма?
Dialogue: 0,0:18:53.09,0:18:56.10,Default,,0,0,0,,Өйткені мен соңғы жынмын➡
Dialogue: 0,0:18:56.10,0:18:59.10,Default,,0,0,0,,Құдайдың махаббаты туралы ән айттым.
Dialogue: 0,0:18:59.10,0:19:04.04,Default,,0,0,0,,Бұдан былай мен әулие қыздың орнына бақсы болып ән айтамын.
Dialogue: 0,0:19:04.04,0:19:06.04,Default,,0,0,0,,Бір күні адамдар➡
Dialogue: 0,0:19:06.04,0:19:10.04,Default,,0,0,0,,Сіз «Маған сиқырдың қажеті жоқ» деп шырқағанға дейін
Dialogue: 0,0:19:12.05,0:19:14.05,Default,,0,0,0,,Иә
Dialogue: 0,0:19:14.05,0:19:18.05,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:19:18.05,0:19:22.06,Default,,0,0,0,,Бұл тамаша, Шерри, мен оны тыңдағым келеді.
Dialogue: 0,0:19:22.06,0:19:26.06,Default,,0,0,0,,Иә, Белл, шынымен...
Dialogue: 0,0:19:26.06,0:19:29.06,Default,,0,0,0,,Ха, Шерри?
Dialogue: 0,0:19:29.06,0:19:35.07,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:19:35.07,0:19:38.07,Default,,0,0,0,,Мен жыламауды шештім
Dialogue: 0,0:19:38.07,0:19:43.08,Default,,0,0,0,,Себебі мен сіздің бетіңізді анық көре алмаймын...
Dialogue: 0,0:19:49.08,0:19:52.09,Default,,0,0,0,,Сіз... барасыз ба?
Dialogue: 0,0:19:52.09,0:19:55.09,Default,,0,0,0,,А, көшпенді болу үшін
Dialogue: 0,0:19:55.09,0:19:59.09,Default,,0,0,0,,Осы жерге оралуыңызды өтінемін.
Dialogue: 0,0:19:59.09,0:20:01.10,Default,,0,0,0,,Мен осы елдемін
Dialogue: 0,0:20:01.10,0:20:05.10,Default,,0,0,0,,Тағы да менің әнім...
Dialogue: 0,0:20:05.10,0:20:10.10,Default,,0,0,0,,Бір күні қайтып келемін, әніңді тыңдауға келемін
Dialogue: 0,0:20:10.10,0:20:14.11,Default,,0,0,0,,Бір-біріміздің саяхатымыз туралы әңгімелей аламыз.
Dialogue: 0,0:20:14.11,0:20:18.11,Default,,0,0,0,,Қош бол Қоңырау
Dialogue: 0,0:20:18.11,0:20:21.12,Default,,0,0,0,,Қош бол Шерри
Dialogue: 0,0:20:40.13,0:20:44.14,Default,,0,0,0,,Оның себебі неде?
Dialogue: 0,0:20:44.14,0:20:47.14,Default,,0,0,0,,(жіптер дыбысы)
Dialogue: 0,0:20:47.14,0:21:05.09,Default,,0,0,0,,♬～
Dialogue: 0,0:21:05.09,0:21:07.09,Default,,0,0,0,,Мен бұл қақпадан кеткім келеді
Dialogue: 0,0:21:07.09,0:21:09.10,Default,,0,0,0,,Оны маған аша аласыз ба?
Dialogue: 0,0:21:09.10,0:21:11.10,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:21:11.10,0:21:15.10,Default,,0,0,0,,Сізде шынымен де осы жерден өтуге себеп бар ма?
Dialogue: 0,0:21:15.10,0:21:17.10,Default,,0,0,0,,Барлығы жақсы
Dialogue: 0,0:21:17.10,0:21:19.11,Default,,0,0,0,,Жақсы жүз
Dialogue: 0,0:21:19.11,0:21:21.11,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:21:21.11,0:21:23.11,Default,,0,0,0,,Фу
Dialogue: 0,0:21:24.11,0:21:27.11,Default,,0,0,0,,Ах
Dialogue: 0,0:21:27.11,0:21:30.12,Default,,0,0,0,,О, сәлем Китти
Dialogue: 0,0:21:30.12,0:21:32.12,Default,,0,0,0,,Менімен келесің бе?
Dialogue: 0,0:21:34.12,0:21:36.12,Default,,0,0,0,,Иә
Dialogue: 0,0:21:37.12,0:21:40.13,Default,,0,0,0,,Сәттілік...
Dialogue: 0,0:21:40.13,0:21:43.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:47.13,0:21:50.14,Default,,0,0,0,,Қош бол Кити
Dialogue: 0,0:21:50.14,0:21:53.14,Default,,0,0,0,,Қақпаны аш!
Dialogue: 0,0:21:53.14,0:21:56.14,Default,,0,0,0,,♬～
Dialogue: 0,0:21:56.14,0:22:16.10,Default,,0,0,0,,♬～
Dialogue: 0,0:22:16.10,0:22:28.11,Default,,0,0,0,,♬～
Dialogue: 0,0:22:28.11,0:22:36.12,Default,,0,0,0,,♬～
Dialogue: 0,0:22:36.12,0:22:38.12,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:22:38.12,0:22:41.12,Default,,0,0,0,,Шекара аймағы хаха
Dialogue: 0,0:22:41.12,0:22:44.12,Default,,0,0,0,,Басқа елмен құдайлық тосқауыл бір-біріне тию арқылы жасалады➡
Dialogue: 0,0:22:44.12,0:22:47.13,Default,,0,0,0,,Шекарадағы әлем
Dialogue: 0,0:22:47.13,0:22:50.13,Default,,0,0,0,,Тоқта (Сирен) Барма~
Dialogue: 0,0:22:50.13,0:22:52.13,Default,,0,0,0,,Тіпті кері қайтпа. Бұл жігіт...
Dialogue: 0,0:22:52.13,0:22:55.14,Default,,0,0,0,,Кірмеңіз...
Dialogue: 0,0:22:55.14,0:22:59.14,Default,,0,0,0,,Кедергі қысымынан жеңілгендердің ойларының көлеңкесі➡
Dialogue: 0,0:22:59.14,0:23:02.08,Default,,0,0,0,,Шекарадан тыс сапарға шығатындар үшін➡
Dialogue: 0,0:23:02.08,0:23:04.08,Default,,0,0,0,,Барлығын ішуге тырысу
Dialogue: 0,0:23:04.08,0:23:08.08,Default,,0,0,0,,Қызық хаха!
Dialogue: 0,0:23:09.08,0:23:11.09,Default,,0,0,0,,Хааах!
Dialogue: 0,0:23:11.09,0:23:13.09,Default,,0,0,0,,Жоғалып кетіңдер, елестер.
Dialogue: 0,0:23:13.09,0:23:16.09,Default,,0,0,0,,Мен сені жұтып алғым келеді➡
Dialogue: 0,0:23:16.09,0:23:20.09,Default,,0,0,0,,Мұнда болу үшін тым тірі!
Dialogue: 0,0:23:20.09,0:23:31.11,Default,,0,0,0,,♬～
Dialogue: 0,0:23:31.11,0:23:34.11,Default,,0,0,0,,(сағат тасының шырылдаған дыбысы)
Dialogue: 0,0:23:35.61,0:23:41.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory