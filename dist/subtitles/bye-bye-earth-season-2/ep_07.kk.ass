Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.17,0:00:09.14,Default,,0,0,0,,Ах
Dialogue: 0,0:00:15.18,0:00:17.18,Default,,0,0,0,,Шектеу бар ма?
Dialogue: 0,0:00:17.18,0:00:19.18,Default,,0,0,0,,Азу сені шақырды➡
Dialogue: 0,0:00:19.18,0:00:23.19,Default,,0,0,0,,Мен сені өз иегіме тартып көрейін
Dialogue: 0,0:00:23.19,0:00:25.15,Default,,0,0,0,,Тыныш ұйықта
Dialogue: 0,0:00:27.19,0:00:30.19,Default,,0,0,0,,А... кеттік.
Dialogue: 0,0:00:30.19,0:00:33.20,Default,,0,0,0,,Құдайдың жүрегі жақында келеді
Dialogue: 0,0:00:33.20,0:00:51.21,Default,,0,0,0,,♬～
Dialogue: 0,0:00:51.21,0:00:55.22,Default,,0,0,0,,♬～
Dialogue: 0,0:00:55.22,0:01:15.17,Default,,0,0,0,,♬～
Dialogue: 0,0:01:15.17,0:01:35.19,Default,,0,0,0,,♬～
Dialogue: 0,0:01:35.19,0:01:55.21,Default,,0,0,0,,♬～
Dialogue: 0,0:01:55.21,0:02:04.19,Default,,0,0,0,,♬～
Dialogue: 0,0:02:05.15,0:02:11.16,Default,,0,0,0,,Бұл құдайдың отты қаны ма?
Dialogue: 0,0:02:11.16,0:02:13.16,Default,,0,0,0,,Ескі құдайлар дәуірінде➡
Dialogue: 0,0:02:13.16,0:02:19.17,Default,,0,0,0,,Құдайдың құдіреті әлемге осы жерден жеткізілді.
Dialogue: 0,0:02:19.17,0:02:24.17,Default,,0,0,0,,Бұл Құдайдың қатысуын бірінші рет сезіну сияқты.
Dialogue: 0,0:02:24.17,0:02:26.17,Default,,0,0,0,,Хун
Dialogue: 0,0:02:26.17,0:02:29.18,Default,,0,0,0,,Сіз басқаратын көлеңкелі топтың көзі➡
Dialogue: 0,0:02:29.18,0:02:31.18,Default,,0,0,0,,Міне, сіз осы жерден келдіңіз.
Dialogue: 0,0:02:31.18,0:02:33.18,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:33.18,0:02:38.19,Default,,0,0,0,,Бірде Құдайда, енді мәңгілік қуғында➡
Dialogue: 0,0:02:38.19,0:02:40.19,Default,,0,0,0,,Жоюға ерік беру
Dialogue: 0,0:02:40.19,0:02:46.19,Default,,0,0,0,,Мен Құдайдың қасіретін және жойылып кетудің адам төзгісіз қорқынышын сезінемін.
Dialogue: 0,0:02:46.19,0:02:49.20,Default,,0,0,0,,Және тілек
Dialogue: 0,0:02:49.20,0:02:51.20,Default,,0,0,0,,Неге...
Dialogue: 0,0:02:51.20,0:02:55.20,Default,,0,0,0,,Құдай тіпті өз өлімін де ашты дейсіз бе?
Dialogue: 0,0:02:55.20,0:03:00.21,Default,,0,0,0,,Мұнда адамдарға Құдайдың сүйіспеншілігі жоқ.
Dialogue: 0,0:03:00.21,0:03:04.15,Default,,0,0,0,,Бірақ жойылу көлеңкесі сыртқа қуылды➡
Dialogue: 0,0:03:04.15,0:03:07.15,Default,,0,0,0,,Біз Аштық Альянсына айналғандай➡
Dialogue: 0,0:03:07.15,0:03:10.15,Default,,0,0,0,,Құдайдың сүйіспеншілігі белгілі бір формада болады➡
Dialogue: 0,0:03:10.15,0:03:12.15,Default,,0,0,0,,Сырттай көрініп тұрған жоқ па?
Dialogue: 0,0:03:12.15,0:03:15.16,Default,,0,0,0,,Белл де, басқалар да соны қалайды➡
Dialogue: 0,0:03:15.16,0:03:18.13,Default,,0,0,0,,Менің ойымша, бұл маған сеніп тапсырылған.
Dialogue: 0,0:03:19.16,0:03:22.16,Default,,0,0,0,,Қоңырау келе жатыр
Dialogue: 0,0:03:22.16,0:03:26.17,Default,,0,0,0,,Аштық альянсы абсолютті күйреуде➡
Dialogue: 0,0:03:26.17,0:03:29.17,Default,,0,0,0,,Жаңа өмір салтын ашатын болмыс.
Dialogue: 0,0:03:29.17,0:03:32.17,Default,,0,0,0,,Құдайды да пішінінен танисың➡
Dialogue: 0,0:03:32.17,0:03:34.18,Default,,0,0,0,,Сіз мені босатқыңыз келе ме?
Dialogue: 0,0:03:34.18,0:03:37.18,Default,,0,0,0,,Сондықтан мен мұндамын➡
Dialogue: 0,0:03:37.18,0:03:40.18,Default,,0,0,0,,Көлеңкесі бар адам ретінде қош келдіңіз➡
Dialogue: 0,0:03:40.18,0:03:46.15,Default,,0,0,0,,Ал олар тек жою үшін ән айтсын.
Dialogue: 0,0:03:47.19,0:03:50.16,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:03:54.20,0:03:56.20,Default,,0,0,0,,Ｎｏｗｈｅｒｅ…
Dialogue: 0,0:03:56.20,0:03:58.20,Default,,0,0,0,,Ах
Dialogue: 0,0:03:58.20,0:04:05.14,Default,,0,0,0,,Ｎｏｗｈｅｒｅ… Ｎｏｗｈｅｒｅ…
Dialogue: 0,0:04:05.14,0:04:08.14,Default,,0,0,0,,♪ (ән айту)
Dialogue: 0,0:04:08.14,0:04:13.15,Default,,0,0,0,,(Көлеңке шеберлерінің ыңырануы)
Dialogue: 0,0:04:13.15,0:04:17.15,Default,,0,0,0,,♪～
Dialogue: 0,0:04:17.15,0:04:19.15,Default,,0,0,0,,Жақсы…
Dialogue: 0,0:04:19.15,0:04:22.16,Default,,0,0,0,,Хмм... тіпті көлеңкелер де жанып тұр ма?
Dialogue: 0,0:04:22.16,0:04:25.16,Default,,0,0,0,,Хахаха, мойындайық!
Dialogue: 0,0:04:25.16,0:04:29.16,Default,,0,0,0,,Сіз шынымен Құдайдың перзентісіз.
Dialogue: 0,0:04:29.16,0:04:33.17,Default,,0,0,0,,Дәл осы себепті аштық альянсы сіздің азуларыңызды іздейді!
Dialogue: 0,0:04:33.17,0:04:39.17,Default,,0,0,0,,Қасқыр, киелі жеріңді тастап, айдалаға орал.
Dialogue: 0,0:04:39.17,0:04:41.18,Default,,0,0,0,,Бұл сіздің сөздеріңіз емес
Dialogue: 0,0:04:41.18,0:04:43.18,Default,,0,0,0,,Құдай айтады!
Dialogue: 0,0:04:43.18,0:04:45.18,Default,,0,0,0,,(Көлеңке шеберлерінің ыңырануы)
Dialogue: 0,0:04:45.18,0:04:47.18,Default,,0,0,0,,Ах
Dialogue: 0,0:04:47.18,0:04:51.19,Default,,0,0,0,,Неліктен Құдай аштық альянсымен қылыш ойнаудан қорқады?
Dialogue: 0,0:04:51.19,0:04:55.19,Default,,0,0,0,,Бұл жауап! (Көлеңке шеберлері еңіреп)
Dialogue: 0,0:04:55.19,0:04:57.16,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:04:59.19,0:05:04.17,Default,,0,0,0,,Аштық альянсының қараңғылығы бәрін бірдей жейді!
Dialogue: 0,0:05:05.13,0:05:08.14,Default,,0,0,0,,Ренжіме, Құдайдың баласы!
Dialogue: 0,0:05:08.14,0:05:10.14,Default,,0,0,0,,Кух... Қарсылықтарыңыз болса➡
Dialogue: 0,0:05:10.14,0:05:14.14,Default,,0,0,0,,Осы қылышпен мен сіздің денеңізге жоқтау таңбасын қашап жазамын!
Dialogue: 0,0:05:14.14,0:05:17.11,Default,,0,0,0,,Баака Адонис па?
Dialogue: 0,0:05:21.15,0:05:24.12,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:05:32.16,0:05:35.16,Default,,0,0,0,,Қоңырау! Сәлем Шерри
Dialogue: 0,0:05:35.16,0:05:37.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:37.17,0:05:39.17,Default,,0,0,0,,Иә
Dialogue: 0,0:05:39.17,0:05:41.17,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:05:41.17,0:05:44.17,Default,,0,0,0,,Ақылдың қызы, сені күттім.
Dialogue: 0,0:05:44.17,0:05:47.18,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:05:47.18,0:05:52.18,Default,,0,0,0,,Сіз аштық одағының қараңғылығы да жей алмайтын жарықсыз.
Dialogue: 0,0:05:52.18,0:05:57.19,Default,,0,0,0,,Тағы да, тіпті Құдайдың нұры да қараңғылықты өшіре алмайды.
Dialogue: 0,0:05:57.19,0:06:03.12,Default,,0,0,0,,Сізді ішу арқылы Аштық Альянсы шынымен де абсолютті қараңғылыққа айналады.
Dialogue: 0,0:06:03.12,0:06:05.13,Default,,0,0,0,,Сылтаулар көп.
Dialogue: 0,0:06:05.13,0:06:08.13,Default,,0,0,0,,Менімен істегіңіз келсе, айтыңыз.
Dialogue: 0,0:06:08.13,0:06:11.13,Default,,0,0,0,,О, бұл пішінсіз.
Dialogue: 0,0:06:11.13,0:06:14.10,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:06:16.14,0:06:19.14,Default,,0,0,0,,Сіз! Өлгісі келмейтін ұзын құлақтар
Dialogue: 0,0:06:19.14,0:06:21.14,Default,,0,0,0,,Иә
Dialogue: 0,0:06:21.14,0:06:24.15,Default,,0,0,0,,Китти, тезірек шерри алып кел, иә.
Dialogue: 0,0:06:24.15,0:06:26.15,Default,,0,0,0,,Хмм, сіздің әніңіз➡
Dialogue: 0,0:06:26.15,0:06:28.15,Default,,0,0,0,,Бұл сіз ойлағаннан да шешуші!
Dialogue: 0,0:06:28.15,0:06:30.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:30.15,0:06:35.16,Default,,0,0,0,,Сенің өлеңің Құдайдың нені ашқанын ашады!
Dialogue: 0,0:06:35.16,0:06:37.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:37.16,0:06:42.16,Default,,0,0,0,,Эй Шелли, сен менің бөлмемде бір рет ән айттың.
Dialogue: 0,0:06:42.16,0:06:45.17,Default,,0,0,0,,Тағы да ән айтасың ба?
Dialogue: 0,0:06:45.17,0:06:49.17,Default,,0,0,0,,Иә, Белл!
Dialogue: 0,0:06:49.17,0:06:51.17,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:06:51.17,0:06:55.18,Default,,0,0,0,,Әдеттегідей сіз әйелдерге қалай қарау керектігін білмейсіз.
Dialogue: 0,0:06:55.18,0:06:58.18,Default,,0,0,0,,Цк... Алдымен сені жеңуім керек пе?
Dialogue: 0,0:06:58.18,0:07:00.18,Default,,0,0,0,,Парасатты қыз! Хааа!
Dialogue: 0,0:07:00.18,0:07:02.12,Default,,0,0,0,,Мен Ловерак Беллмін!
Dialogue: 0,0:07:02.12,0:07:04.12,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:07:04.12,0:07:06.12,Default,,0,0,0,,Иә! Ннн! Тааааа!
Dialogue: 0,0:07:06.12,0:07:09.12,Default,,0,0,0,,Қарғыс атсын... Хмф! Ха!
Dialogue: 0,0:07:09.12,0:07:12.09,Default,,0,0,0,,Жақсы! Нан хааа! Хмм...
Dialogue: 0,0:07:15.13,0:07:19.10,Default,,0,0,0,,Ммм!
Dialogue: 0,0:07:23.14,0:07:25.14,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:25.14,0:07:27.11,Default,,0,0,0,,Ах
Dialogue: 0,0:07:28.14,0:07:31.15,Default,,0,0,0,,Хаха, мен сенің жүзіңді көрдім.
Dialogue: 0,0:07:31.15,0:07:33.15,Default,,0,0,0,,Сіз жақсы көрінесіз, солай емес пе?
Dialogue: 0,0:07:33.15,0:07:36.15,Default,,0,0,0,,Әрқашан өкініштің балқыған қазаны
Dialogue: 0,0:07:36.15,0:07:39.15,Default,,0,0,0,,Мен сені жойылудың кілті деп санаймын
Dialogue: 0,0:07:39.15,0:07:44.16,Default,,0,0,0,,Қойшы, сенен көңілім қалды.
Dialogue: 0,0:07:44.16,0:07:47.16,Default,,0,0,0,,Аа, дұрыс, Барса.
Dialogue: 0,0:07:47.16,0:07:49.16,Default,,0,0,0,,Иә? Сіз шынымен түсінесіз бе?
Dialogue: 0,0:07:49.16,0:07:54.17,Default,,0,0,0,,Маған қоңырау шалыңыз, мен сізді кесіп тастаймын.
Dialogue: 0,0:07:54.17,0:07:59.17,Default,,0,0,0,,Фасадты жеңдің деп сенемін, ақылды қыз.
Dialogue: 0,0:07:59.17,0:08:04.11,Default,,0,0,0,,Ешқайда... Ешқайда... Иә?
Dialogue: 0,0:08:04.11,0:08:08.12,Default,,0,0,0,,Не? Сіздің достарыңыз көп, солай емес пе?
Dialogue: 0,0:08:08.12,0:08:11.12,Default,,0,0,0,,Жабу! Себепке батқан менмін!
Dialogue: 0,0:08:11.12,0:08:16.12,Default,,0,0,0,,Уайымдама, ол сені құртпайды.
Dialogue: 0,0:08:16.12,0:08:20.13,Default,,0,0,0,,Бірақ сіз әлі жеткілікті түрде сыналған жоқсыз.
Dialogue: 0,0:08:20.13,0:08:23.13,Default,,0,0,0,,Сіз нені айтып тұрсыз, Драмбю?
Dialogue: 0,0:08:23.13,0:08:25.13,Default,,0,0,0,,Хехе... (аяқ дыбысы)
Dialogue: 0,0:08:25.13,0:08:27.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:32.14,0:08:36.14,Default,,0,0,0,,Ех… Ах…
Dialogue: 0,0:08:36.14,0:08:40.15,Default,,0,0,0,,Не? Сен кімсің?
Dialogue: 0,0:08:40.15,0:08:42.12,Default,,0,0,0,,(Презентациялық микрофон) Финалдық турнир, бірінші раунд, 1-ші жекпе-жек
Dialogue: 0,0:08:44.15,0:08:46.15,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:46.15,0:08:49.12,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:08:52.16,0:08:56.13,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:08:57.17,0:09:03.14,Default,,0,0,0,,Бұл менің мұғалім ретіндегі соңғы рөлім.
Dialogue: 0,0:09:04.11,0:09:07.11,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:07.11,0:09:12.11,Default,,0,0,0,,Неліктен мен емес басқа біреуге бұлай айтасың?
Dialogue: 0,0:09:12.11,0:09:18.12,Default,,0,0,0,,Маған берген сөздерің, тек мен үшін!
Dialogue: 0,0:09:18.12,0:09:21.12,Default,,0,0,0,,Не? Уф боқ
Dialogue: 0,0:09:21.12,0:09:23.12,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:09:23.12,0:09:27.13,Default,,0,0,0,,Яаааа! Қылыш нұсқауы? Адониске?
Dialogue: 0,0:09:27.13,0:09:30.13,Default,,0,0,0,,Неге... а
Dialogue: 0,0:09:30.13,0:09:32.13,Default,,0,0,0,,Сен неменесің...
Dialogue: 0,0:09:32.13,0:09:34.14,Default,,0,0,0,,Ha
Dialogue: 0,0:09:34.14,0:09:37.14,Default,,0,0,0,,Сіз Лундинг...
Dialogue: 0,0:09:37.14,0:09:40.14,Default,,0,0,0,,Болашақ жақын арада пайда болады
Dialogue: 0,0:09:40.14,0:09:44.15,Default,,0,0,0,,Сіз және сіздің қара балаңызға
Dialogue: 0,0:09:44.15,0:09:47.15,Default,,0,0,0,,Иә! Біраз күтіңіз
Dialogue: 0,0:09:47.15,0:09:49.15,Default,,0,0,0,,Парасатты қыз
Dialogue: 0,0:09:49.15,0:09:52.15,Default,,0,0,0,,Бұл жігіт кім...
Dialogue: 0,0:09:52.15,0:09:56.12,Default,,0,0,0,,Қалай ойлайсыңдар, адамдар қандай?
Dialogue: 0,0:10:00.16,0:10:02.16,Default,,0,0,0,,Белл жақсы ма?
Dialogue: 0,0:10:02.16,0:10:05.17,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:10:05.17,0:10:08.17,Default,,0,0,0,,Дегенмен, бұл шайқастың кілті➡
Dialogue: 0,0:10:08.17,0:10:11.17,Default,,0,0,0,,Бұл сенсің, Шерри.
Dialogue: 0,0:10:11.17,0:10:14.14,Default,,0,0,0,,Не, мен?
Dialogue: 0,0:10:16.18,0:10:20.18,Default,,0,0,0,,Біз қылышымызды ешқашан тастамаймыз!
Dialogue: 0,0:10:20.18,0:10:24.19,Default,,0,0,0,,Біз шынымен бас тартуымыз керек нәрсе - Құдайға ие болуға тырысу!
Dialogue: 0,0:10:24.19,0:10:26.19,Default,,0,0,0,,Дирижер Гиннесс
Dialogue: 0,0:10:26.19,0:10:30.19,Default,,0,0,0,,Менің ғана емес, Құдайдың сөзіне де мойынсұнбайсың ба?
Dialogue: 0,0:10:30.19,0:10:34.20,Default,,0,0,0,,Тәңір – аңыз дәуірінен бері жалғасып келе жатқан алғашқы сиқыр.
Dialogue: 0,0:10:34.20,0:10:37.20,Default,,0,0,0,,Бірақ халық Құдайды біледі➡
Dialogue: 0,0:10:37.20,0:10:41.20,Default,,0,0,0,,Мен оны станоктың берілістерінің арасынан тауып алып, сүйсіндім.
Dialogue: 0,0:10:41.20,0:10:44.21,Default,,0,0,0,,Механикалық құдай!
Dialogue: 0,0:10:44.21,0:10:47.21,Default,,0,0,0,,Құдайды тісті тіс дегенді қалай түсінесіңдер?
Dialogue: 0,0:10:47.21,0:10:50.21,Default,,0,0,0,,Біздің актерлер құрамын белгілеп, барлығының өмірін үйлестіріңіз➡
Dialogue: 0,0:10:50.21,0:10:53.21,Default,,0,0,0,,Ең жоғарғы болмыс емес пе?
Dialogue: 0,0:10:53.21,0:10:56.22,Default,,0,0,0,,Құдайды жібер, енді бізге уақыт келді➡
Dialogue: 0,0:10:56.22,0:11:00.22,Default,,0,0,0,,Тәртіпті өз қолымызбен жасауымыз керек!
Dialogue: 0,0:11:00.22,0:11:03.16,Default,,0,0,0,,Әйтпесе біз мәңгі боламыз➡
Dialogue: 0,0:11:03.16,0:11:07.16,Default,,0,0,0,,Менің өмірімді механикалық ойыншық ретінде жалғастырудан басқа амалым жоқ!
Dialogue: 0,0:11:07.16,0:11:12.17,Default,,0,0,0,,Неліктен Адонис үмітін үзді және абсолютті жойылуды қалайды➡
Dialogue: 0,0:11:12.17,0:11:14.17,Default,,0,0,0,,Сіз әлі білмейсіз бе?
Dialogue: 0,0:11:14.17,0:11:17.17,Default,,0,0,0,,Аштық альянсынан үйреніп, қирауды ішіңіз!
Dialogue: 0,0:11:17.17,0:11:21.18,Default,,0,0,0,,Катакомба! Катакомбалар бейтараптық символы ретінде➡
Dialogue: 0,0:11:21.18,0:11:23.18,Default,,0,0,0,,Саяхат кілтін тойлау!
Dialogue: 0,0:11:23.18,0:11:27.18,Default,,0,0,0,,Балалар, сендер Катакомбаның қызметшісі болуды жоспарлап отырсыңдар!
Dialogue: 0,0:11:27.18,0:11:31.19,Default,,0,0,0,,Катакомбалар адамдардың жаңа жолын көрсетеді➡
Dialogue: 0,0:11:31.19,0:11:33.19,Default,,0,0,0,,Бір үміт!
Dialogue: 0,0:11:33.19,0:11:35.19,Default,,0,0,0,,Топ ит немесе ауддог жоқ➡
Dialogue: 0,0:11:35.19,0:11:38.19,Default,,0,0,0,,Бір күні сырты да, іші де болмайды!
Dialogue: 0,0:11:38.19,0:11:40.19,Default,,0,0,0,,...
Dialogue: 0,0:11:40.19,0:11:44.20,Default,,0,0,0,,Менің бұл сөздерді осы жүзбен қысқартудан басқа амалым жоқ!
Dialogue: 0,0:11:44.20,0:11:46.20,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:11:46.20,0:11:48.20,Default,,0,0,0,,Бұл тартыстың жеңімпазы – сол➡
Dialogue: 0,0:11:48.20,0:11:51.21,Default,,0,0,0,,Халықтың болашақ бағдарын көрсететін тұлға бол.
Dialogue: 0,0:11:51.21,0:11:54.21,Default,,0,0,0,,Соған сенген Белл төбелесіп жатыр.
Dialogue: 0,0:11:54.21,0:11:58.21,Default,,0,0,0,,Құдайдың жүрек соғысын қозғаған адам ретінде➡
Dialogue: 0,0:11:58.21,0:12:00.22,Default,,0,0,0,,Мен сол жерге баруым керек.
Dialogue: 0,0:12:00.22,0:12:02.15,Default,,0,0,0,,Иә
Dialogue: 0,0:12:02.15,0:12:07.16,Default,,0,0,0,,Бұл қақтығысты одан сайын күшейту керек пе, әлде оны толығымен жою керек пе➡
Dialogue: 0,0:12:07.16,0:12:10.16,Default,,0,0,0,,Барлығы сізге байланысты.
Dialogue: 0,0:12:10.16,0:12:15.16,Default,,0,0,0,,Түсіндім, бұл менің рөлім.
Dialogue: 0,0:12:15.16,0:12:18.17,Default,,0,0,0,,Бірақ менің қолымнан келетіні ән айту ғана
Dialogue: 0,0:12:18.17,0:12:20.17,Default,,0,0,0,,Иә
Dialogue: 0,0:12:20.17,0:12:22.17,Default,,0,0,0,,Белл семсерін бір-ақ сермеп тұрғандай
Dialogue: 0,0:12:22.17,0:12:24.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:26.17,0:12:29.18,Default,,0,0,0,,Мен сонда тұрамын.
Dialogue: 0,0:12:29.18,0:12:31.18,Default,,0,0,0,,Растау
Dialogue: 0,0:12:31.18,0:12:34.15,Default,,0,0,0,,Барлығы сынақ
Dialogue: 0,0:12:35.18,0:12:37.19,Default,,0,0,0,,О...
Dialogue: 0,0:12:39.19,0:12:41.19,Default,,0,0,0,,Шерри! Неге мұнда...
Dialogue: 0,0:12:41.19,0:12:44.19,Default,,0,0,0,,Шерри ханшайым! Ханшайым!
Dialogue: 0,0:12:44.19,0:12:48.20,Default,,0,0,0,,Шерри қайта қош келдіңіз! Ха…
Dialogue: 0,0:12:48.20,0:12:50.20,Default,,0,0,0,,《Қандай ұлылық》
Dialogue: 0,0:12:50.20,0:12:56.20,Default,,0,0,0,,《Ол құдайдың қысымынан шығып не ұттым?》
Dialogue: 0,0:12:56.20,0:12:59.21,Default,,0,0,0,,Тәңірлік ғибадатхана қызы ретінде мен сізге осы жерде айтып отырмын.
Dialogue: 0,0:12:59.21,0:13:03.14,Default,,0,0,0,,Енді бейбіт өлімнің тыныш орнында➡
Dialogue: 0,0:13:03.14,0:13:06.15,Default,,0,0,0,,Құдайдың тыныштығына қауіп төндіргісі келетіндер бар.
Dialogue: 0,0:13:06.15,0:13:09.15,Default,,0,0,0,,Бұл дауды діни қызметкер шеше ме?
Dialogue: 0,0:13:09.15,0:13:14.16,Default,,0,0,0,,Бірақ бұл Құдайдың сөздері емес; олар Шеллидің өз сөздері.
Dialogue: 0,0:13:14.16,0:13:18.16,Default,,0,0,0,,Ол кісі халыққа бейтарап жол көрсетеді➡
Dialogue: 0,0:13:18.16,0:13:21.16,Default,,0,0,0,,Адамдарға Құдайдан бас тартуға көмектеседі
Dialogue: 0,0:13:21.16,0:13:23.16,Default,,0,0,0,,Хунн
Dialogue: 0,0:13:23.16,0:13:26.17,Default,,0,0,0,,Адамның наным-сеніміне қарамастан шығу тегі неден тұрады➡
Dialogue: 0,0:13:26.17,0:13:30.17,Default,,0,0,0,,Тіпті Құдайды құртқысы келетіндер➡
Dialogue: 0,0:13:30.17,0:13:33.17,Default,,0,0,0,,Бата мен қорғаудан басқа ештеңе жоқ.
Dialogue: 0,0:13:33.17,0:13:36.18,Default,,0,0,0,,Бұл сіздің айтып отырғаныңыз емес пе? О
Dialogue: 0,0:13:36.18,0:13:38.18,Default,,0,0,0,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,0:13:38.18,0:13:43.18,Default,,0,0,0,,Алланы мадақтаушының аты – сарайдағы есімі➡
Dialogue: 0,0:13:43.18,0:13:47.19,Default,,0,0,0,,Мэри Шелли, жетекші әнші
Dialogue: 0,0:13:47.19,0:13:50.19,Default,,0,0,0,,Бұл менмін (бәрі) Ах...
Dialogue: 0,0:13:50.19,0:13:53.19,Default,,0,0,0,,Құдай Сөзіне мойынсұнған, мені кесіп таста.
Dialogue: 0,0:13:53.19,0:13:58.20,Default,,0,0,0,,Мұндағы кез келген адам мені өлтіруі мүмкін.
Dialogue: 0,0:13:58.20,0:14:00.20,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:14:00.20,0:14:02.14,Default,,0,0,0,,Неге, Шерри!
Dialogue: 0,0:14:02.14,0:14:05.14,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,0:14:05.14,0:14:08.14,Default,,0,0,0,,Бірақ бұл болашақта көрсетіледі.
Dialogue: 0,0:14:08.14,0:14:11.15,Default,,0,0,0,,Дұрыс. Сіз қандайсыз?
Dialogue: 0,0:14:11.15,0:14:13.15,Default,,0,0,0,,Китти бәрі
Dialogue: 0,0:14:13.15,0:14:16.15,Default,,0,0,0,,Осы диваны басқаратын және ұстап алған адам
Dialogue: 0,0:14:16.15,0:14:19.15,Default,,0,0,0,,Онда бұрын-соңды болмаған масштабта есептеу➡
Dialogue: 0,0:14:19.15,0:14:22.16,Default,,0,0,0,,Көру үшін жайыңыз
Dialogue: 0,0:14:22.16,0:14:24.16,Default,,0,0,0,,Құдайдың қанына мөр қой➡
Dialogue: 0,0:14:24.16,0:14:29.16,Default,,0,0,0,,Өлімге әкелетін күлді мәңгілікке жойыңыз
Dialogue: 0,0:14:29.16,0:14:31.17,Default,,0,0,0,,А... ау, менің (Шерри) ха.
Dialogue: 0,0:14:31.17,0:14:34.17,Default,,0,0,0,,Жақында кездескенше.
Dialogue: 0,0:14:34.17,0:14:36.17,Default,,0,0,0,,Сіз осы жолмен бара жатырсыз.
Dialogue: 0,0:14:36.17,0:14:39.17,Default,,0,0,0,,Өліммен сыналған сол➡
Dialogue: 0,0:14:39.17,0:14:42.18,Default,,0,0,0,,Оны сынақ ретінде қарастырыңыз.
Dialogue: 0,0:14:42.18,0:14:46.18,Default,,0,0,0,,Мен өз жеңісіме сенемін
Dialogue: 0,0:14:46.18,0:14:48.18,Default,,0,0,0,,Қарғыс атсын... (Шерри) Қазір болса ше➡
Dialogue: 0,0:14:48.18,0:14:51.19,Default,,0,0,0,,Менің әрекеттерімнің себебін ешкім білмесе де➡
Dialogue: 0,0:14:51.19,0:14:54.19,Default,,0,0,0,,Дәлелдеу ақыр соңында өседі.
Dialogue: 0,0:14:54.19,0:14:57.19,Default,,0,0,0,,Шерри Бұл дұрыс емес!
Dialogue: 0,0:14:57.19,0:15:00.19,Default,,0,0,0,,Сонда бұл шайтанның жеңісі емес пе?
Dialogue: 0,0:15:00.19,0:15:03.13,Default,,0,0,0,,Иә, мен соңғы Нидхогпын.
Dialogue: 0,0:15:03.13,0:15:08.14,Default,,0,0,0,,Жындық қуанышқа құдайдың даңқы мен ән айтамын!
Dialogue: 0,0:15:08.14,0:15:11.14,Default,,0,0,0,,Ха! Уф...
Dialogue: 0,0:15:11.14,0:15:13.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:13.14,0:15:15.14,Default,,0,0,0,,Кук
Dialogue: 0,0:15:15.14,0:15:18.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:18.15,0:15:21.15,Default,,0,0,0,,Бұл Құдайдың жүрегі ме?
Dialogue: 0,0:15:21.15,0:15:25.15,Default,,0,0,0,,Сіз Құдайдың дірілін сезінесіз бе?
Dialogue: 0,0:15:25.15,0:15:30.16,Default,,0,0,0,,Себеп іздеп, көтерген себебім осы.
Dialogue: 0,0:15:30.16,0:15:33.16,Default,,0,0,0,,Саған сенімсіздікпен қарауымның себебі де бар.
Dialogue: 0,0:15:33.16,0:15:36.16,Default,,0,0,0,,А... Қоңырау
Dialogue: 0,0:15:36.16,0:15:39.17,Default,,0,0,0,,Құдайдың қысымында емес пе?
Dialogue: 0,0:15:39.17,0:15:43.17,Default,,0,0,0,,Ой, сен құладың, Сиан!
Dialogue: 0,0:15:43.17,0:15:46.17,Default,,0,0,0,,Белл деген кім?
Dialogue: 0,0:15:46.17,0:15:51.18,Default,,0,0,0,,Мен аштық альянсының қараңғылығына оранып, ақыры осында келдім.
Dialogue: 0,0:15:51.18,0:15:54.18,Default,,0,0,0,,Бірақ Белл тек Белл➡ ретінде бар
Dialogue: 0,0:15:54.18,0:15:56.18,Default,,0,0,0,,Осы киелі жерде
Dialogue: 0,0:15:56.18,0:15:59.19,Default,,0,0,0,,Ол қандай шындық, бала?
Dialogue: 0,0:15:59.19,0:16:02.12,Default,,0,0,0,,Хаа, дауыстап жауап бер.
Dialogue: 0,0:16:02.12,0:16:04.13,Default,,0,0,0,,Deus Ex Machina ➡ туылған
Dialogue: 0,0:16:04.13,0:16:08.13,Default,,0,0,0,,Дүниеде зұлымдықтан құтылатын бір ғана адам бар!
Dialogue: 0,0:16:08.13,0:16:10.13,Default,,0,0,0,,Сол құдайларды алып келді➡
Dialogue: 0,0:16:10.13,0:16:13.13,Default,,0,0,0,,Ежелгі Құдайдан басқа ешкім жоқ!
Dialogue: 0,0:16:13.13,0:16:16.14,Default,,0,0,0,,Жарайсың.
Dialogue: 0,0:16:16.14,0:16:19.14,Default,,0,0,0,,Ал біз, жұмақ тұрғындары,➡
Dialogue: 0,0:16:19.14,0:16:22.14,Default,,0,0,0,,Механикалық құдайлар жасаған
Dialogue: 0,0:16:22.14,0:16:25.15,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:16:25.15,0:16:28.12,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:16:30.15,0:16:33.15,Default,,0,0,0,,Бар, ақылды қыз
Dialogue: 0,0:16:33.15,0:16:37.16,Default,,0,0,0,,Барып, болашақты басқар
Dialogue: 0,0:16:37.16,0:16:40.16,Default,,0,0,0,,Оны жалама! Хмм
Dialogue: 0,0:16:40.16,0:16:43.16,Default,,0,0,0,,Менің жауым болма, Адонис!
Dialogue: 0,0:16:43.16,0:16:45.17,Default,,0,0,0,,Бұл шынымен де біз... боламыз ба?
Dialogue: 0,0:16:45.17,0:16:49.17,Default,,0,0,0,,Сен шынайы Құдайдың ұрпағы Беллді жеңе аласың ба?
Dialogue: 0,0:16:49.17,0:16:53.17,Default,,0,0,0,,Тағдырымызға күмән келтіретін сенсің.
Dialogue: 0,0:16:53.17,0:16:56.18,Default,,0,0,0,,Мен сені өлтіру үшін үйреткенімнің бәрін пайдаланамын.
Dialogue: 0,0:16:56.18,0:16:59.18,Default,,0,0,0,,Ал мен Беллді жеңемін!
Dialogue: 0,0:16:59.18,0:17:03.12,Default,,0,0,0,,Құдай мен бұл елді скептицизмнің жүзі қалай жарып жіберді➡
Dialogue: 0,0:17:03.12,0:17:05.12,Default,,0,0,0,,Мен саған көрсетемін!
Dialogue: 0,0:17:05.12,0:17:07.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:15.13,0:17:19.10,Default,,0,0,0,,Бұл тамаша... иә.
Dialogue: 0,0:17:22.14,0:17:24.14,Default,,0,0,0,,Ах
Dialogue: 0,0:17:24.14,0:17:26.14,Default,,0,0,0,,Уф…
Dialogue: 0,0:17:26.14,0:17:29.14,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:17:29.14,0:17:33.11,Default,,0,0,0,,Сіз Беллесіз бе?
Dialogue: 0,0:17:35.15,0:17:37.15,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:17:37.15,0:17:41.16,Default,,0,0,0,,Мен сізді танымаймын
Dialogue: 0,0:17:41.16,0:17:43.16,Default,,0,0,0,,Иә
Dialogue: 0,0:17:43.16,0:17:46.16,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:17:46.16,0:17:48.16,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:17:48.16,0:17:51.17,Default,,0,0,0,,Көптен айтқан тілегіңді көрсет
Dialogue: 0,0:17:51.17,0:17:55.14,Default,,0,0,0,,Менің... үмітім
Dialogue: 0,0:17:56.17,0:18:02.11,Default,,0,0,0,,Ұлы жұмбақтың соңында тас жұмыртқаны көрдім.
Dialogue: 0,0:18:02.11,0:18:06.11,Default,,0,0,0,,Онда сен жас балаша ұйықтайсың...
Dialogue: 0,0:18:06.11,0:18:09.08,Default,,0,0,0,,Бұл дүниенің себептері…
Dialogue: 0,0:18:18.13,0:18:23.13,Default,,0,0,0,,Мен сені бір жұппен қалдырдым... және күттім.
Dialogue: 0,0:18:23.13,0:18:29.14,Default,,0,0,0,,Драмбуи жасаған қылыштың жетегінде жүргенде
Dialogue: 0,0:18:29.14,0:18:33.14,Default,,0,0,0,,Ұзақ, ұзақ уақыт
Dialogue: 0,0:18:33.14,0:18:35.14,Default,,0,0,0,,Саяхатшы…
Dialogue: 0,0:18:35.14,0:18:39.15,Default,,0,0,0,,Біздің болмысымыздың жұмбақ ортасында➡
Dialogue: 0,0:18:39.15,0:18:43.15,Default,,0,0,0,,Жалғыз емес екеніңізді дәлелдеу
Dialogue: 0,0:18:43.15,0:18:46.15,Default,,0,0,0,,Нағыз үміт
Dialogue: 0,0:18:46.15,0:18:50.16,Default,,0,0,0,,Сіз менің ішімде өліп қалдыңыз, солай емес пе?
Dialogue: 0,0:18:50.16,0:18:56.16,Default,,0,0,0,,Мен жүрген жолдан енді ыңғайсыздық тудырмайды.
Dialogue: 0,0:18:56.16,0:19:02.14,Default,,0,0,0,,Өйткені мен... бос боламын.
Dialogue: 0,0:19:04.11,0:19:07.07,Default,,0,0,0,,Қарғыс атсын... неге...
Dialogue: 0,0:19:09.11,0:19:12.11,Default,,0,0,0,,Мен күттім, ха
Dialogue: 0,0:19:12.11,0:19:15.12,Default,,0,0,0,,Тек болашаққа құмар болыңыз➡
Dialogue: 0,0:19:15.12,0:19:19.12,Default,,0,0,0,,Мен бүгін мен өткен күннен үмітсіз болдым.
Dialogue: 0,0:19:19.12,0:19:22.12,Default,,0,0,0,,Қазір мұнда тек қараңғылық бар
Dialogue: 0,0:19:22.12,0:19:26.09,Default,,0,0,0,,Қараңғыда тек мәңгілік тыныштық бар
Dialogue: 0,0:19:28.13,0:19:31.13,Default,,0,0,0,,Жақсы, мен саған беремін.
Dialogue: 0,0:19:31.13,0:19:35.14,Default,,0,0,0,,Мен оны саған беремін! Хмм!
Dialogue: 0,0:19:35.14,0:19:38.14,Default,,0,0,0,,Ха... Адонис!
Dialogue: 0,0:19:38.14,0:19:42.14,Default,,0,0,0,,Ннн, мен саған ғашық болдым.
Dialogue: 0,0:19:42.14,0:19:48.15,Default,,0,0,0,,Мен сенімен осылай байланысу үшін ол кісіні өз қолыммен кесіп тастадым.
Dialogue: 0,0:19:48.15,0:19:51.15,Default,,0,0,0,,Сен мені қаламадың.
Dialogue: 0,0:19:51.15,0:19:53.15,Default,,0,0,0,,Мен жай ғана өзім болғым келді!
Dialogue: 0,0:19:53.15,0:19:56.16,Default,,0,0,0,,Ол кісі де сен болғысы келді!
Dialogue: 0,0:19:56.16,0:19:59.13,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:01.16,0:20:04.17,Default,,0,0,0,,Оны кесуге бола ма? қоңырау
Dialogue: 0,0:20:04.17,0:20:09.17,Default,,0,0,0,,Мен сені өлтіремін, сондықтан осы уақытқа дейін келдім.
Dialogue: 0,0:20:09.17,0:20:12.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:13.17,0:20:15.18,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:15.18,0:20:18.18,Default,,0,0,0,,Сіз әлі де пышақтың кейпінде қалыпсыз ба?
Dialogue: 0,0:20:18.18,0:20:20.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:20.18,0:20:24.19,Default,,0,0,0,,Пышақ сынып қалады деп қорықпай мені кесіп аламын деп ойлама!
Dialogue: 0,0:20:24.19,0:20:26.19,Default,,0,0,0,,Оны қалдырыңыз!
Dialogue: 0,0:20:26.19,0:20:28.19,Default,,0,0,0,,Ооо!
Dialogue: 0,0:20:28.19,0:20:31.19,Default,,0,0,0,,Сіз үнемі сылтау айтасыз.
Dialogue: 0,0:20:31.19,0:20:34.20,Default,,0,0,0,,Нағыз сенімен қашан кездесермін деп ойлаймын➡
Dialogue: 0,0:20:34.20,0:20:37.20,Default,,0,0,0,,Мен сол ғанамын...
Dialogue: 0,0:20:37.20,0:20:40.20,Default,,0,0,0,,Мені қаладың ба?
Dialogue: 0,0:20:40.20,0:20:43.20,Default,,0,0,0,,Мен кіммін? шулы!
Dialogue: 0,0:20:43.20,0:20:47.21,Default,,0,0,0,,Сенің қалағаның Сиан еді, әлгі адам!
Dialogue: 0,0:20:47.21,0:20:50.21,Default,,0,0,0,,Тыныш! Хааа
Dialogue: 0,0:20:50.21,0:20:53.21,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:20:53.21,0:20:56.22,Default,,0,0,0,,Сіз мені естисіз бе? Құдайдың жүрек соғысы
Dialogue: 0,0:20:56.22,0:20:58.22,Default,,0,0,0,,Құдай да бұл шайқаста мақтанады
Dialogue: 0,0:20:58.22,0:21:01.16,Default,,0,0,0,,Бұл қылыш жекпе-жектің жалғыз көрермені – Құдай!
Dialogue: 0,0:21:01.16,0:21:07.16,Default,,0,0,0,,Қоңырау! Енді менің барлық күмәнімді сізден сұрайтын кез келді!
Dialogue: 0,0:21:07.16,0:21:09.16,Default,,0,0,0,,Coo... Coo...
Dialogue: 0,0:21:09.16,0:21:12.17,Default,,0,0,0,,Nnnnn 《Мен оны ұшырып жібергім келеді》
Dialogue: 0,0:21:12.17,0:21:17.14,Default,,0,0,0,,《Бұл зорлық-зомбылықты жеңетін күш! 》
Dialogue: 0,0:21:18.17,0:21:20.17,Default,,0,0,0,,《Жоқ》
Dialogue: 0,0:21:20.17,0:21:24.18,Default,,0,0,0,,《Мен қылышты не үшін ұстап тұрмын? 》
Dialogue: 0,0:21:24.18,0:21:28.18,Default,,0,0,0,,《Сен маған не үйреттің? 》
Dialogue: 0,0:21:28.18,0:21:30.15,Default,,0,0,0,,Тоқта
Dialogue: 0,0:21:31.19,0:21:33.19,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:33.19,0:21:37.19,Default,,0,0,0,,Отан туралы ойлар Утопияны аңсау
Dialogue: 0,0:21:37.19,0:21:43.20,Default,,0,0,0,,Мен тұрған жерді де, өзімді де сүйе алмаудың азабы
Dialogue: 0,0:21:43.20,0:21:46.17,Default,,0,0,0,,Мұнда емес, бір жерде
Dialogue: 0,0:21:47.20,0:21:50.20,Default,,0,0,0,,Әлемді тесіп өту
Dialogue: 0,0:21:50.20,0:21:53.17,Default,,0,0,0,,Әлемді тесіп өт!
Dialogue: 0,0:22:00.21,0:22:20.17,Default,,0,0,0,,♬～
Dialogue: 0,0:22:20.17,0:22:40.19,Default,,0,0,0,,♬～
Dialogue: 0,0:22:40.19,0:22:47.19,Default,,0,0,0,,♬～
Dialogue: 0,0:22:47.19,0:23:00.21,Default,,0,0,0,,♬～
Dialogue: 0,0:23:00.21,0:23:10.15,Default,,0,0,0,,♬～
Dialogue: 0,0:23:10.15,0:23:22.16,Default,,0,0,0,,♬～
Dialogue: 0,0:23:22.16,0:23:29.17,Default,,0,0,0,,♬～
Dialogue: 0,0:23:29.17,0:23:31.17,Default,,0,0,0,,Менің ерекше емлесі...
Dialogue: 0,0:23:31.17,0:23:33.17,Default,,0,0,0,,Бір ғана жеке болмыс
Dialogue: 0,0:23:33.17,0:23:36.18,Default,,0,0,0,,Күнә менің қолымда! бұл сіздің сахнаңыз
Dialogue: 0,0:23:36.18,0:23:39.15,Default,,0,0,0,,Иә, сапарға шыққандай.
Dialogue: 0,0:23:40.65,0:23:46.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory