Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:36.16,0:00:38.17,Default,,0,0,0,,Ha
Dialogue: 0,0:00:38.17,0:00:41.17,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:00:41.17,0:00:46.17,Default,,0,0,0,,Монтаждаушы бір рет жеткізілген уақыт.
Dialogue: 0,0:00:46.17,0:00:51.18,Default,,0,0,0,,Бұл ескі құдайлардың жұмағы
Dialogue: 0,0:00:51.18,0:00:53.18,Default,,0,0,0,,Ах
Dialogue: 0,0:00:53.18,0:00:55.18,Default,,0,0,0,,Бұл ай.
Dialogue: 0,0:00:55.18,0:00:58.19,Default,,0,0,0,,Ай - дүниенің аты
Dialogue: 0,0:00:58.19,0:01:02.19,Default,,0,0,0,,Өзгеріс атауы Өлу мен қайта туылу синонимі
Dialogue: 0,0:01:02.19,0:01:05.19,Default,,0,0,0,,Ай…
Dialogue: 0,0:01:05.19,0:01:07.20,Default,,0,0,0,,Га
Dialogue: 0,0:01:07.20,0:01:16.20,Default,,0,0,0,,♬～
Dialogue: 0,0:01:16.20,0:01:21.21,Default,,0,0,0,,♬～
Dialogue: 0,0:01:21.21,0:01:23.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:23.21,0:01:26.18,Default,,0,0,0,,Ах...!
Dialogue: 0,0:01:27.22,0:01:30.19,Default,,0,0,0,,Бұл құдайлардың ымырт мезгілі.
Dialogue: 0,0:01:31.22,0:01:37.19,Default,,0,0,0,,Кету, жойылудан құтылу
Dialogue: 0,0:01:38.16,0:01:42.16,Default,,0,0,0,,Сол күні құдайдың ымырт қараңғысы келді➡
Dialogue: 0,0:01:42.16,0:01:47.17,Default,,0,0,0,,Қасиетті жұлдыздан барлық құдайлар ұшып кеткенде...
Dialogue: 0,0:01:47.17,0:01:51.14,Default,,0,0,0,,Бір нәрсе... тасталған ба?
Dialogue: 0,0:01:53.18,0:01:57.15,Default,,0,0,0,,А, мен! ? Ахх
Dialogue: 0,0:01:59.18,0:02:02.18,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:02:02.18,0:02:09.19,Default,,0,0,0,,♬～
Dialogue: 0,0:02:09.19,0:02:14.20,Default,,0,0,0,,♬～
Dialogue: 0,0:02:14.20,0:02:17.20,Default,,0,0,0,,♬～
Dialogue: 0,0:02:17.20,0:02:20.17,Default,,0,0,0,,)
Dialogue: 0,0:02:23.21,0:02:37.15,Default,,0,0,0,,♬～
Dialogue: 0,0:02:37.15,0:02:40.16,Default,,0,0,0,,)
Dialogue: 0,0:02:40.16,0:02:42.16,Default,,0,0,0,,()
Dialogue: 0,0:02:42.16,0:02:45.16,Default,,0,0,0,,Құдай бізді тастап кетті➡
Dialogue: 0,0:02:45.16,0:02:48.16,Default,,0,0,0,,Бағдарламаның үзілуіне байланысты➡
Dialogue: 0,0:02:48.16,0:02:53.17,Default,,0,0,0,,Ауырып қалтырап, Мәңгі ұйықтайын деп қалдым
Dialogue: 0,0:02:53.17,0:02:56.17,Default,,0,0,0,,Сонда сіз пайда болдыңыз
Dialogue: 0,0:02:56.17,0:02:58.17,Default,,0,0,0,,()
Dialogue: 0,0:02:58.17,0:03:02.18,Default,,0,0,0,,《Бұл ойын орны》
Dialogue: 0,0:03:02.18,0:03:05.18,Default,,0,0,0,,《Бәрі осында болуы керек》
Dialogue: 0,0:03:05.18,0:03:08.15,Default,,0,0,0,,《Олар осында ойнауы керек》
Dialogue: 0,0:03:10.19,0:03:12.15,Default,,0,0,0,,)
Dialogue: 0,0:03:13.19,0:03:16.19,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:16.19,0:03:18.16,Default,,0,0,0,,)
Dialogue: 0,0:03:19.19,0:03:22.20,Default,,0,0,0,,)
Dialogue: 0,0:03:22.20,0:03:24.20,Default,,0,0,0,,)
Dialogue: 0,0:03:24.20,0:03:28.20,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:03:28.20,0:03:32.17,Default,,0,0,0,,((Қош келдіңіз! Қош келдіңіз!)
Dialogue: 0,0:03:33.21,0:03:36.14,Default,,0,0,0,,((Бұл құдайдың ләззат алуға арналған ойын-сауық саябағы))
Dialogue: 0,0:03:36.14,0:03:40.15,Default,,0,0,0,,((Біз құдайлардың ләззатының тұмарымыз))
Dialogue: 0,0:03:40.15,0:03:44.12,Default,,0,0,0,,((Кел ойнайық!)) (Қуыршақ)((Бірге ойнайық!))
Dialogue: 0,0:03:47.16,0:03:50.16,Default,,0,0,0,,Қуандық
Dialogue: 0,0:03:50.16,0:03:53.16,Default,,0,0,0,,Сіз бар болғанша➡
Dialogue: 0,0:03:53.16,0:03:58.13,Default,,0,0,0,,Бізде мәңгі болу үшін себеп болуы мүмкін
Dialogue: 0,0:04:03.17,0:04:08.18,Default,,0,0,0,,(қылыш ойнайтын дыбыс)
Dialogue: 0,0:04:08.18,0:04:11.15,Default,,0,0,0,,)
Dialogue: 0,0:04:12.18,0:04:14.18,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:14.18,0:04:17.19,Default,,0,0,0,,)
Dialogue: 0,0:04:17.19,0:04:19.19,Default,,0,0,0,,()
Dialogue: 0,0:04:19.19,0:04:23.19,Default,,0,0,0,,)
Dialogue: 0,0:04:23.19,0:04:27.20,Default,,0,0,0,,)
Dialogue: 0,0:04:27.20,0:04:31.17,Default,,0,0,0,,)
Dialogue: 0,0:04:32.20,0:04:35.20,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:35.20,0:04:39.14,Default,,0,0,0,,)
Dialogue: 0,0:04:39.14,0:04:41.14,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:41.14,0:04:45.15,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:45.15,0:04:48.15,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:48.15,0:04:52.15,Default,,0,0,0,,((Бірақ бәрі содан басталды))
Dialogue: 0,0:04:52.15,0:04:54.16,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:54.16,0:04:59.16,Default,,0,0,0,,((Себебі мен бір сөз айттым...))
Dialogue: 0,0:04:59.16,0:05:01.16,Default,,0,0,0,,(фортепианода ойнау дыбысы)
Dialogue: 0,0:05:01.16,0:05:04.13,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:05:10.17,0:05:13.18,Default,,0,0,0,,)
Dialogue: 0,0:05:13.18,0:05:16.18,Default,,0,0,0,,)
Dialogue: 0,0:05:16.18,0:05:18.18,Default,,0,0,0,,)
Dialogue: 0,0:05:18.18,0:05:21.15,Default,,0,0,0,,)
Dialogue: 0,0:05:22.18,0:05:26.19,Default,,0,0,0,,Сен мәңгілік емес едің
Dialogue: 0,0:05:26.19,0:05:29.19,Default,,0,0,0,,Ол ақырлы болды Сондықтан...
Dialogue: 0,0:05:29.19,0:05:31.19,Default,,0,0,0,,((Бағдарламаны кесіңіз➡
Dialogue: 0,0:05:31.19,0:05:35.20,Default,,0,0,0,,Тірі қалғандар расталғаннан кейін кейінге қалдырылды))
Dialogue: 0,0:05:35.20,0:05:39.13,Default,,0,0,0,,((Өмірді ұзартатын және дене бітімін күшейтетін ем➡
Dialogue: 0,0:05:39.13,0:05:43.14,Default,,0,0,0,,Ұзақ мерзімді криоұйқыға төтеп беру үшін...))
Dialogue: 0,0:05:43.14,0:05:49.14,Default,,0,0,0,,((Барлық ойын-сауық саябағы аман қалғандардың тілектері расталғанша жабылады➡)
Dialogue: 0,0:05:49.14,0:05:53.15,Default,,0,0,0,,Өшіру бағдарламасын белгісіз уақытқа кейінге қалдыру))
Dialogue: 0,0:05:53.15,0:05:57.15,Default,,0,0,0,,((Бұдан былай барлық тақырыптық паркті басқару ұйымдары➡
Dialogue: 0,0:05:57.15,0:05:59.15,Default,,0,0,0,,Органикалық өсімдіктерді қолдану➡
Dialogue: 0,0:05:59.15,0:06:04.16,Default,,0,0,0,,Техникалық қызмет көрсету жүйесін шексіз орнату))
Dialogue: 0,0:06:04.16,0:06:07.16,Default,,0,0,0,,)
Dialogue: 0,0:06:07.16,0:06:10.17,Default,,0,0,0,,((Өмірдің бар екенін босатыңыз➡
Dialogue: 0,0:06:10.17,0:06:14.14,Default,,0,0,0,,Эволюциялық ортаны құру үшін қолданылады))
Dialogue: 0,0:06:15.17,0:06:17.17,Default,,0,0,0,,Осылайша, біз➡
Dialogue: 0,0:06:17.17,0:06:20.18,Default,,0,0,0,,Жасалған ақаулық бағдарламаларына қарсы➡
Dialogue: 0,0:06:20.18,0:06:23.14,Default,,0,0,0,,Бұл әрқашан күрес болды.
Dialogue: 0,0:06:24.18,0:06:27.18,Default,,0,0,0,,Және ұзақ уақыттан кейін➡
Dialogue: 0,0:06:27.18,0:06:30.19,Default,,0,0,0,,Біз жеңдік
Dialogue: 0,0:06:30.19,0:06:35.19,Default,,0,0,0,,Бұл әлемді құдайдың жаратылысы ретінде басқар➡
Dialogue: 0,0:06:35.19,0:06:39.13,Default,,0,0,0,,Халық жеке тұлға болып өсті.
Dialogue: 0,0:06:39.13,0:06:42.13,Default,,0,0,0,,Бірақ мұндай жағдайда➡
Dialogue: 0,0:06:42.13,0:06:45.10,Default,,0,0,0,,Сіз қайтадан ояндыңыз
Dialogue: 0,0:06:46.13,0:06:48.14,Default,,0,0,0,,Біз сенің жаныңдамыз➡
Dialogue: 0,0:06:48.14,0:06:51.14,Default,,0,0,0,,Оның бұзылу қаупі болды.
Dialogue: 0,0:06:51.14,0:06:53.14,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:06:53.14,0:06:56.14,Default,,0,0,0,,Балалар, не айтып тұрғаныңызды мүлдем түсінбеймін.
Dialogue: 0,0:06:56.14,0:06:58.15,Default,,0,0,0,,Өлсем де, тірісем де біреу кінәлі ме?
Dialogue: 0,0:06:58.15,0:07:00.15,Default,,0,0,0,,Сіз бұл менің кінәм деп айтасыз ба?
Dialogue: 0,0:07:00.15,0:07:04.15,Default,,0,0,0,,Өткен күн өткен.
Dialogue: 0,0:07:04.15,0:07:08.16,Default,,0,0,0,,Біз жеке болмысымызды дамытуға ұмтылдық.
Dialogue: 0,0:07:08.16,0:07:11.16,Default,,0,0,0,,Дегенмен, әлі де...
Dialogue: 0,0:07:11.16,0:07:13.16,Default,,0,0,0,,Дүниенің тұрғындарының тұлғалары болады➡
Dialogue: 0,0:07:13.16,0:07:17.17,Default,,0,0,0,,Жетістікке жете бастағанда ояндың!
Dialogue: 0,0:07:17.17,0:07:19.17,Default,,0,0,0,,Сендер, ежелгі құдайлардың ұрпақтары,
Dialogue: 0,0:07:19.17,0:07:21.17,Default,,0,0,0,,Сіз бұл дүниенің бастапқы себебісіз.
Dialogue: 0,0:07:21.17,0:07:25.17,Default,,0,0,0,,Тәңірдің іңірін мына дүниеге әкелуші сенсің.
Dialogue: 0,0:07:25.17,0:07:29.18,Default,,0,0,0,,Тағдырыңнан кек алғың келе ме?
Dialogue: 0,0:07:29.18,0:07:31.18,Default,,0,0,0,,Балалар, сіздердің сөздеріңізде біртүрлі нәрсе бар!
Dialogue: 0,0:07:31.18,0:07:35.18,Default,,0,0,0,,Уф, мен керек болсам, айтшы.
Dialogue: 0,0:07:35.18,0:07:37.12,Default,,0,0,0,,Мен сенің жауың болсам, семсер алмас!
Dialogue: 0,0:07:37.12,0:07:42.12,Default,,0,0,0,,Екеуі де рас, ақылды қыз.
Dialogue: 0,0:07:42.12,0:07:44.13,Default,,0,0,0,,Бұрынғы құдайлар енді ➡ емес
Dialogue: 0,0:07:44.13,0:07:47.13,Default,,0,0,0,,Бұл дүниеде ешкім жоқ
Dialogue: 0,0:07:47.13,0:07:50.13,Default,,0,0,0,,Сіз мәңгі жалғызсыз
Dialogue: 0,0:07:50.13,0:07:53.13,Default,,0,0,0,,Бұл үмітсіздік сізді басып алған кезде➡
Dialogue: 0,0:07:53.13,0:07:56.14,Default,,0,0,0,,Біз сені мәңгілікке қалдырамыз➡
Dialogue: 0,0:07:56.14,0:07:59.14,Default,,0,0,0,,Біз де мәңгі өмір сүреміз!
Dialogue: 0,0:07:59.14,0:08:02.14,Default,,0,0,0,,Мына қараңғы ғаламда!
Dialogue: 0,0:08:02.14,0:08:05.11,Default,,0,0,0,,Уу Уу!
Dialogue: 0,0:08:06.15,0:08:12.15,Default,,0,0,0,,Барка Менің шығу тегім сонда емес.
Dialogue: 0,0:08:12.15,0:08:14.16,Default,,0,0,0,,Мен мұны сен үшін жасаймын.
Dialogue: 0,0:08:14.16,0:08:18.16,Default,,0,0,0,,Бәрін мен сені бөліп тастадым➡
Dialogue: 0,0:08:18.16,0:08:21.13,Default,,0,0,0,,Оны өз тағдырыңа өзгерт!
Dialogue: 0,0:08:27.17,0:08:31.17,Default,,0,0,0,,Ловерак-Белл, бұл менің атым.
Dialogue: 0,0:08:31.17,0:08:35.14,Default,,0,0,0,,Жүр, менің атымды ата!
Dialogue: 0,0:08:37.11,0:08:40.12,Default,,0,0,0,,《Бұл... Құдайдың аштығы ма? 》
Dialogue: 0,0:08:40.12,0:08:43.12,Default,,0,0,0,,《Неге қарныңыз ашты...》
Dialogue: 0,0:08:43.12,0:08:45.12,Default,,0,0,0,,Цк
Dialogue: 0,0:08:45.12,0:08:48.12,Default,,0,0,0,,Тіршілік себебіне байланысты аштық
Dialogue: 0,0:08:48.12,0:08:50.13,Default,,0,0,0,,Парасатты қыз
Dialogue: 0,0:08:50.13,0:08:54.13,Default,,0,0,0,,Физикалық дене болмай-ақ адам болуды мақсат ету➡
Dialogue: 0,0:08:54.13,0:08:57.13,Default,,0,0,0,,Ал жыртылғанның аштығы➡
Dialogue: 0,0:08:57.13,0:08:59.13,Default,,0,0,0,,Сіз көтере аласыз ба?
Dialogue: 0,0:08:59.13,0:09:03.14,Default,,0,0,0,,Аштықты тоқтатқанымды қалайсың ба?
Dialogue: 0,0:09:03.14,0:09:05.14,Default,,0,0,0,,Өлтіремін...
Dialogue: 0,0:09:05.14,0:09:08.14,Default,,0,0,0,,Біз үшін болмыс ретінде өлім жоқ.
Dialogue: 0,0:09:08.14,0:09:12.15,Default,,0,0,0,,Бірақ үзіліс бағдарламасы іске қосылады ма?
Dialogue: 0,0:09:12.15,0:09:14.15,Default,,0,0,0,,Ол жойылады ма...
Dialogue: 0,0:09:14.15,0:09:17.15,Default,,0,0,0,,Сіз оны іске қосасыз.
Dialogue: 0,0:09:17.15,0:09:19.15,Default,,0,0,0,,Әй! Тек сен➡
Dialogue: 0,0:09:19.15,0:09:22.16,Default,,0,0,0,,Бұл дүниеде мүмкін
Dialogue: 0,0:09:22.16,0:09:25.16,Default,,0,0,0,,Сіз шынымен кеткенде➡
Dialogue: 0,0:09:25.16,0:09:29.16,Default,,0,0,0,,Енді бізге керек емес, біз де құс торына қайтамыз.
Dialogue: 0,0:09:29.16,0:09:32.17,Default,,0,0,0,,Мәңгілік тыныш теңізде...
Dialogue: 0,0:09:32.17,0:09:37.11,Default,,0,0,0,,Қарғыс атқыр... Сіз маған айтқан боларсыз.
Dialogue: 0,0:09:37.11,0:09:39.07,Default,,0,0,0,,Адонис!
Dialogue: 0,0:09:41.11,0:09:44.11,Default,,0,0,0,,Телефон айқайы➡
Dialogue: 0,0:09:44.11,0:09:46.11,Default,,0,0,0,,Себебін айту
Dialogue: 0,0:09:46.11,0:09:51.09,Default,,0,0,0,,Оның жойылуын бізден сұрайсың ба?
Dialogue: 0,0:09:53.12,0:09:57.13,Default,,0,0,0,,Бұл адам осы ай әлемінен➡
Dialogue: 0,0:09:57.13,0:10:00.13,Default,,0,0,0,,Планеталық иммигранттарды қуған кезде➡
Dialogue: 0,0:10:00.13,0:10:03.13,Default,,0,0,0,,Тоқтатылған бағдарламаны қайта іске қосу
Dialogue: 0,0:10:03.13,0:10:06.13,Default,,0,0,0,,Бұл жағдайда негізгі сөз – бұл адамның санасында...
Dialogue: 0,0:10:06.13,0:10:08.14,Default,,0,0,0,,О...!
Dialogue: 0,0:10:08.14,0:10:10.14,Default,,0,0,0,,Өлсең де, өлмесең де➡
Dialogue: 0,0:10:10.14,0:10:14.11,Default,,0,0,0,,Мен мұны осы қылышпен сынап көремін!
Dialogue: 0,0:10:15.14,0:10:18.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:18.15,0:10:21.12,Default,,0,0,0,,Ааа... ха!
Dialogue: 0,0:10:22.15,0:10:24.12,Default,,0,0,0,,Әй, қарт кісі, жақсысың ба? Ауырған жоқсың ба?
Dialogue: 0,0:10:26.15,0:10:28.12,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:36.16,0:10:38.17,Default,,0,0,0,,Бұл дүние бастапқыда➡ болды
Dialogue: 0,0:10:38.17,0:10:42.17,Default,,0,0,0,,Бұл құдайлар ойын ойнайтын жұмақ еді.
Dialogue: 0,0:10:42.17,0:10:47.18,Default,,0,0,0,,Біз ол жерде ойнауға болатын ойыншық қуыршақтар едік.
Dialogue: 0,0:10:47.18,0:10:54.18,Default,,0,0,0,,Менің адам болып жолымды бастау себебім ойыннан.
Dialogue: 0,0:10:54.18,0:10:58.19,Default,,0,0,0,,Ал біз құдайлармен ойнаған жаратылыстармыз➡
Dialogue: 0,0:10:58.19,0:11:01.19,Default,,0,0,0,,Ойнайтын болмысқа айналды
Dialogue: 0,0:11:01.19,0:11:04.19,Default,,0,0,0,,Бұл жеке болмыстың бастауы болды.
Dialogue: 0,0:11:04.19,0:11:07.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:10.20,0:11:13.20,Default,,0,0,0,,А... қара уақыт?
Dialogue: 0,0:11:13.20,0:11:16.17,Default,,0,0,0,,Бұл сенің көзіңнің түсі сияқты.
Dialogue: 0,0:11:17.21,0:11:19.21,Default,,0,0,0,,Адонис…
Dialogue: 0,0:11:19.21,0:11:22.21,Default,,0,0,0,,Қоңырау
Dialogue: 0,0:11:22.21,0:11:26.21,Default,,0,0,0,,Уф, сен несің...
Dialogue: 0,0:11:26.21,0:11:31.22,Default,,0,0,0,,Мынау... ақымақ! Уф...
Dialogue: 0,0:11:31.22,0:11:34.22,Default,,0,0,0,,Жетер, Белл (жылайды)
Dialogue: 0,0:11:34.22,0:11:37.19,Default,,0,0,0,,Жылы.
Dialogue: 0,0:11:39.16,0:11:42.16,Default,,0,0,0,,А... кеме?
Dialogue: 0,0:11:42.16,0:11:45.17,Default,,0,0,0,,Мүмкін аңызға айналған құдайлардың мекені➡
Dialogue: 0,0:11:45.17,0:11:49.17,Default,,0,0,0,,Менің ойымша, механикалық құдай дәл қазір оны елестетіп отыр.
Dialogue: 0,0:11:49.17,0:11:53.17,Default,,0,0,0,,Менің ішім қатты ауырады
Dialogue: 0,0:11:53.17,0:11:56.18,Default,,0,0,0,,Тас жұмыртқа пайда болғаннан бері
Dialogue: 0,0:11:56.18,0:12:01.15,Default,,0,0,0,,Бұл кемеде көп адам болуы мүмкін емес.
Dialogue: 0,0:12:02.18,0:12:08.19,Default,,0,0,0,,Белл, сен Құдайдың нағыз ұрпағысың.
Dialogue: 0,0:12:08.19,0:12:10.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:10.19,0:12:12.19,Default,,0,0,0,,Шынайы Құдай бар➡
Dialogue: 0,0:12:12.19,0:12:15.20,Default,,0,0,0,,Біз кім едік?
Dialogue: 0,0:12:15.20,0:12:17.20,Default,,0,0,0,,Мен мұны түсінбедім.
Dialogue: 0,0:12:17.20,0:12:20.20,Default,,0,0,0,,Бұл мен жақсы дәлел емеспін бе?
Dialogue: 0,0:12:20.20,0:12:22.20,Default,,0,0,0,,Қоңырау…
Dialogue: 0,0:12:22.20,0:12:25.21,Default,,0,0,0,,Менің баратын жерім жоқ...
Dialogue: 0,0:12:25.21,0:12:27.21,Default,,0,0,0,,Қайту үшін үй және отбасы➡
Dialogue: 0,0:12:27.21,0:12:30.21,Default,,0,0,0,,Бір нәсілдің адамдары жоқ.
Dialogue: 0,0:12:30.21,0:12:33.21,Default,,0,0,0,,Бұл не? Бұл тастанды бала емес пе?
Dialogue: 0,0:12:33.21,0:12:40.15,Default,,0,0,0,,Бұл менің іздеп жүрген себебімді білесіз бе?
Dialogue: 0,0:12:40.15,0:12:44.16,Default,,0,0,0,,Сағыныш... Туған жерді ойлау
Dialogue: 0,0:12:44.16,0:12:47.13,Default,,0,0,0,,Утопияны аңсау
Dialogue: 0,0:12:48.16,0:12:52.17,Default,,0,0,0,,Әлде... Мен өзімді де, тұрған жерімді де сүйе алмаймын ➡
Dialogue: 0,0:12:52.17,0:12:55.17,Default,,0,0,0,,Жүректің ауыруы...
Dialogue: 0,0:12:55.17,0:13:01.18,Default,,0,0,0,,Сіз өзіңіздің шыққан тегіңіз туралы білу үшін саяхатқа барасыз ба?
Dialogue: 0,0:13:01.18,0:13:04.18,Default,,0,0,0,,Сіздің ауырсынуыңыз қайдан пайда болады?
Dialogue: 0,0:13:04.18,0:13:07.18,Default,,0,0,0,,Өз қылышыммен сынап көру
Dialogue: 0,0:13:07.18,0:13:10.18,Default,,0,0,0,,Иә... иә.
Dialogue: 0,0:13:10.18,0:13:13.19,Default,,0,0,0,,Мен... а
Dialogue: 0,0:13:13.19,0:13:16.19,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:13:16.19,0:13:20.19,Default,,0,0,0,,Сіз мені кесіп тастадыңыз ба?
Dialogue: 0,0:13:20.19,0:13:24.20,Default,,0,0,0,,Белле, сен мені Құдайдан ажыраттың.
Dialogue: 0,0:13:24.20,0:13:27.20,Default,,0,0,0,,Құдай өліп, қайта туды➡
Dialogue: 0,0:13:27.20,0:13:32.21,Default,,0,0,0,,Маған қараңғылыққа қайтатын жол ашылды. Ах...
Dialogue: 0,0:13:32.21,0:13:37.15,Default,,0,0,0,,Енді меннен қалаған сөздеріңді айта аласыңдар
Dialogue: 0,0:13:37.15,0:13:43.15,Default,,0,0,0,,Мені сапарға алып баруыңды қалаймын.
Dialogue: 0,0:13:43.15,0:13:46.15,Default,,0,0,0,,Адонис
Dialogue: 0,0:13:46.15,0:13:49.16,Default,,0,0,0,,Бірақ сіз жалғыз барасыз.
Dialogue: 0,0:13:49.16,0:13:55.16,Default,,0,0,0,,Мен де барлық құдайлардың аштығын жеймін.
Dialogue: 0,0:13:55.16,0:13:59.17,Default,,0,0,0,,Хе, өлетін болсаң, осыны айтып өл.
Dialogue: 0,0:13:59.17,0:14:03.17,Default,,0,0,0,,Ах, ақымақ...
Dialogue: 0,0:14:03.17,0:14:05.17,Default,,0,0,0,,Мен сені сүйемін Нопперабу
Dialogue: 0,0:14:05.17,0:14:09.18,Default,,0,0,0,,Баркер... Адонис
Dialogue: 0,0:14:09.18,0:14:13.18,Default,,0,0,0,,Ол әрқашан бір жақты.
Dialogue: 0,0:14:13.18,0:14:15.18,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:14:15.18,0:14:19.19,Default,,0,0,0,,Мен кешірім сұрамаймын.
Dialogue: 0,0:14:19.19,0:14:24.19,Default,,0,0,0,,Иә, бұл рұқсат етілген бе? Бұл жігіт ракуин.
Dialogue: 0,0:14:24.19,0:14:29.20,Default,,0,0,0,,Мені ойлап, сол қараңғылықта айнып жүре бер.
Dialogue: 0,0:14:29.20,0:14:49.15,Default,,0,0,0,,♬～
Dialogue: 0,0:14:49.15,0:14:51.15,Default,,0,0,0,,♬～
Dialogue: 0,0:14:51.15,0:14:53.12,Default,,0,0,0,,Я...
Dialogue: 0,0:14:55.16,0:14:59.13,Default,,0,0,0,,Сау бол Адонис
Dialogue: 0,0:15:07.17,0:15:09.14,Default,,0,0,0,,Ах
Dialogue: 0,0:15:11.17,0:15:13.17,Default,,0,0,0,,Жақсысың ба, Белл!
Dialogue: 0,0:15:13.17,0:15:16.18,Default,,0,0,0,,Менде бәрі жақсы Кити
Dialogue: 0,0:15:16.18,0:15:19.15,Default,,0,0,0,,Мен сені қазір ол жерден алып кетемін.
Dialogue: 0,0:15:21.18,0:15:23.15,Default,,0,0,0,,Ааааа!
Dialogue: 0,0:15:26.19,0:15:28.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:29.19,0:15:32.16,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:34.20,0:15:37.13,Default,,0,0,0,,Бұл шынымен де бір сәттік оқиға болды.
Dialogue: 0,0:15:37.13,0:15:41.14,Default,,0,0,0,,Осы елдің барлық жеріне өлімші күл жаусын➡
Dialogue: 0,0:15:41.14,0:15:44.14,Default,,0,0,0,,Құдайдың жүрегі жараланды.
Dialogue: 0,0:15:44.14,0:15:48.14,Default,,0,0,0,,Бұған әншінің құдай қорғауы және➡ кедергі болды
Dialogue: 0,0:15:48.14,0:15:51.15,Default,,0,0,0,,Қылышың болсын
Dialogue: 0,0:15:51.15,0:15:55.12,Default,,0,0,0,,Сенің семсерің мені ішімнен кесіп тастады.
Dialogue: 0,0:15:59.15,0:16:02.16,Default,,0,0,0,,Барлығы осылай мөрленді
Dialogue: 0,0:16:02.16,0:16:06.16,Default,,0,0,0,,Бұл елде өлімге әкелетін күл жоқ➡
Dialogue: 0,0:16:06.16,0:16:09.16,Default,,0,0,0,,Deus Ex Machina жоқ
Dialogue: 0,0:16:09.16,0:16:12.17,Default,,0,0,0,,Сіз де керемет емессіз бе?
Dialogue: 0,0:16:12.17,0:16:15.17,Default,,0,0,0,,Бір күннен кейін ол қалыпты жағдайға оралады.
Dialogue: 0,0:16:15.17,0:16:18.17,Default,,0,0,0,,Өсу де, өлім де алыс емес
Dialogue: 0,0:16:18.17,0:16:20.17,Default,,0,0,0,,Саяхаттың қарғысына байланысты
Dialogue: 0,0:16:20.17,0:16:22.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:25.18,0:16:28.18,Default,,0,0,0,,Адонис осылай деді.
Dialogue: 0,0:16:28.18,0:16:30.18,Default,,0,0,0,,Сіз жалғыз баруыңыз керек.
Dialogue: 0,0:16:30.18,0:16:33.19,Default,,0,0,0,,Иә, Белл.
Dialogue: 0,0:16:33.19,0:16:35.19,Default,,0,0,0,,Мен саяхатқа шығамын
Dialogue: 0,0:16:35.19,0:16:38.13,Default,,0,0,0,,Дүниедегі барлық құдайлардан сұрағым келеді.
Dialogue: 0,0:16:38.13,0:16:40.13,Default,,0,0,0,,Менің шығу тегім
Dialogue: 0,0:16:40.13,0:16:46.13,Default,,0,0,0,,Ал мен өзімді осы қылышпен сынап көремін.
Dialogue: 0,0:16:46.13,0:16:50.14,Default,,0,0,0,,А, алға.
Dialogue: 0,0:16:50.14,0:16:53.14,Default,,0,0,0,,Біз тағы кездесеміз бе?
Dialogue: 0,0:16:53.14,0:16:58.15,Default,,0,0,0,,Тағдырыңды жолдың соңында іздегенше
Dialogue: 0,0:16:58.15,0:17:01.15,Default,,0,0,0,,Сәлем онда.
Dialogue: 0,0:17:01.15,0:17:03.12,Default,,0,0,0,,Ах
Dialogue: 0,0:17:04.15,0:17:06.12,Default,,0,0,0,,Ах
Dialogue: 0,0:17:07.15,0:17:11.13,Default,,0,0,0,,Қош бол Кити
Dialogue: 0,0:17:13.16,0:17:15.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:15.16,0:17:19.17,Default,,0,0,0,,(Көлеңкелі діни қызметкерлердің ыңырануы)
Dialogue: 0,0:17:19.17,0:17:21.17,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:17:21.17,0:17:24.17,Default,,0,0,0,,Ой, мен шынында да шын атымды айтып жібердім бе?
Dialogue: 0,0:17:24.17,0:17:35.18,Default,,0,0,0,,♬～
Dialogue: 0,0:17:35.18,0:17:37.15,Default,,0,0,0,,Уау
Dialogue: 0,0:17:39.12,0:17:41.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:41.12,0:17:43.09,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:48.13,0:17:50.10,Default,,0,0,0,,Капыпа
Dialogue: 0,0:17:54.14,0:17:57.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:57.14,0:17:59.14,Default,,0,0,0,,Қасиетті күл?
Dialogue: 0,0:17:59.14,0:18:03.14,Default,,0,0,0,,Гиннес Не болды?
Dialogue: 0,0:18:03.14,0:18:05.15,Default,,0,0,0,,Білмеймін, бірақ қасиетті күл➡
Dialogue: 0,0:18:05.15,0:18:08.15,Default,,0,0,0,,Бір нәрсені құрбан ету арқылы пайда болады.
Dialogue: 0,0:18:08.15,0:18:12.15,Default,,0,0,0,,Бұл киелі күл қандай егістік...
Dialogue: 0,0:18:12.15,0:18:14.12,Default,,0,0,0,,Ах
Dialogue: 0,0:18:16.16,0:18:18.16,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:18:18.16,0:18:22.13,Default,,0,0,0,,Құдайдың мәйіті
Dialogue: 0,0:18:25.17,0:18:28.17,Default,,0,0,0,,Құдай?
Dialogue: 0,0:18:28.17,0:18:32.14,Default,,0,0,0,,Иә... себебін сұрадың.
Dialogue: 0,0:18:35.18,0:18:38.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:39.11,0:18:42.12,Default,,0,0,0,,Сиан, айтшы
Dialogue: 0,0:18:42.12,0:18:46.12,Default,,0,0,0,,Бұл... қандай жеңіліс?
Dialogue: 0,0:18:46.12,0:18:50.12,Default,,0,0,0,,Иә? Бұл жерде біреу бар хаха
Dialogue: 0,0:18:50.12,0:18:53.13,Default,,0,0,0,,Не? Мұнда ешкім жоқ.
Dialogue: 0,0:18:53.13,0:18:58.10,Default,,0,0,0,,Бұл қорқынышты, иә? Бұл...
Dialogue: 0,0:19:01.14,0:19:06.14,Default,,0,0,0,,Неткен қылыш, Естіген құстай мекен-жайы жоқ.
Dialogue: 0,0:19:06.14,0:19:11.15,Default,,0,0,0,,Бұл біртүрлі. Осылай қылышты қалай жасады деп ойлаймын.
Dialogue: 0,0:19:11.15,0:19:15.15,Default,,0,0,0,,⚟Сол қылышты жалғау үшін не істеу керек деп ойлайсың?
Dialogue: 0,0:19:15.15,0:19:19.15,Default,,0,0,0,,Хмм, бұл жігітті қосу үшін сізге көп көмек қажет емес.
Dialogue: 0,0:19:19.15,0:19:24.16,Default,,0,0,0,,Менің ойымша, егер сіз оны бастапқы қалпына келтірсеңіз, ол тез арада қайта тіріледі.
Dialogue: 0,0:19:24.16,0:19:28.16,Default,,0,0,0,,Бұл қылыштың түрі. Ах... иә.
Dialogue: 0,0:19:28.16,0:19:31.17,Default,,0,0,0,,Тұман бұлт! (2 адам) Иә?
Dialogue: 0,0:19:31.17,0:19:33.17,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:19:33.17,0:19:35.17,Default,,0,0,0,,Катакомба мен қамал байланысты.
Dialogue: 0,0:19:35.17,0:19:37.10,Default,,0,0,0,,Не?
Dialogue: 0,0:19:37.10,0:19:39.11,Default,,0,0,0,,Гиннес ше?
Dialogue: 0,0:19:39.11,0:19:41.11,Default,,0,0,0,,А... жарайды, көп нәрсе болды.
Dialogue: 0,0:19:41.11,0:19:44.11,Default,,0,0,0,,Әй, біреу құлап қалды.
Dialogue: 0,0:19:44.11,0:19:48.08,Default,,0,0,0,,А, аа...!
Dialogue: 0,0:19:49.12,0:19:52.12,Default,,0,0,0,,Сіз мен жақтасыз ба?
Dialogue: 0,0:19:52.12,0:19:55.12,Default,,0,0,0,,Мен білетін адам
Dialogue: 0,0:19:55.12,0:19:58.13,Default,,0,0,0,,Маған қылышты үйретті
Dialogue: 0,0:19:58.13,0:20:00.13,Default,,0,0,0,,Ах
Dialogue: 0,0:20:00.13,0:20:03.10,Default,,0,0,0,,Бұл өте жаман. Асықшы!
Dialogue: 0,0:20:08.14,0:20:10.14,Default,,0,0,0,,Кеттік
Dialogue: 0,0:20:10.14,0:20:14.11,Default,,0,0,0,,Иә... Адонис
Dialogue: 0,0:20:20.15,0:20:22.15,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:20:22.15,0:20:25.15,Default,,0,0,0,,Қоңырау! Беннетт Гиннес!
Dialogue: 0,0:20:25.15,0:20:28.16,Default,,0,0,0,,Белл, бұл нені білдіреді?
Dialogue: 0,0:20:28.16,0:20:30.16,Default,,0,0,0,,Құдайды өлтірдің бе?
Dialogue: 0,0:20:30.16,0:20:32.16,Default,,0,0,0,,Мынаны естігім келеді! Ах
Dialogue: 0,0:20:32.16,0:20:34.16,Default,,0,0,0,,Эй, тұман, шамасы➡
Dialogue: 0,0:20:34.16,0:20:37.16,Default,,0,0,0,,Менің ойымша, бұл жағдай мен оқығандай болды дегенді білдіреді.
Dialogue: 0,0:20:37.16,0:20:40.17,Default,,0,0,0,,Иә, сондықтан осы уақытқа дейін келдіңіз, солай ма?
Dialogue: 0,0:20:40.17,0:20:43.17,Default,,0,0,0,,Рахмет, мен сені жақсы көремін.
Dialogue: 0,0:20:43.17,0:20:46.17,Default,,0,0,0,,Уф! Ух... хехе
Dialogue: 0,0:20:46.17,0:20:50.18,Default,,0,0,0,,Гиннес мырза, мен сіздің тобыңызды қарсы алуға келдім.
Dialogue: 0,0:20:50.18,0:20:52.18,Default,,0,0,0,,Бұрын-соңды болмаған өзгеріс уақыты➡
Dialogue: 0,0:20:52.18,0:20:56.18,Default,,0,0,0,,Катакомбаларға бата болу
Dialogue: 0,0:20:56.18,0:21:00.19,Default,,0,0,0,,Мен қуана араласып, рөлге ие боламын.
Dialogue: 0,0:21:00.19,0:21:04.19,Default,,0,0,0,,Осыны оқыдың ба? Бұл дұрыс
Dialogue: 0,0:21:04.19,0:21:06.19,Default,,0,0,0,,Белле, менімен бірге келгеніңді қалаймын.
Dialogue: 0,0:21:06.19,0:21:08.20,Default,,0,0,0,,Менің саған көрсететін бір нәрсем бар.
Dialogue: 0,0:21:08.20,0:21:11.20,Default,,0,0,0,,Сол катакомба қылышында жасырылған құпия
Dialogue: 0,0:21:11.20,0:21:13.20,Default,,0,0,0,,Иә
Dialogue: 0,0:21:13.20,0:21:16.20,Default,,0,0,0,,Белл Гафф
Dialogue: 0,0:21:16.20,0:21:19.21,Default,,0,0,0,,Сіз патшасыз ба? Иә.
Dialogue: 0,0:21:19.21,0:21:24.21,Default,,0,0,0,,Олай болса мен сен үшін саяхатыңның кілтін ойнаймын.
Dialogue: 0,0:21:24.21,0:21:26.21,Default,,0,0,0,,О
Dialogue: 0,0:21:26.21,0:21:28.22,Default,,0,0,0,,Қоңырау
Dialogue: 0,0:21:28.22,0:21:31.22,Default,,0,0,0,,Бұл Шерридің жақсы әні болды
Dialogue: 0,0:21:31.22,0:21:35.22,Default,,0,0,0,,Иә, мен сенің қылышыңның ақырғанын естідім.
Dialogue: 0,0:21:35.22,0:21:39.16,Default,,0,0,0,,Мен сездім, қорқынышты болды.
Dialogue: 0,0:21:39.16,0:21:43.16,Default,,0,0,0,,Рахмет. Біраз уақыттан кейін сені көруге келемін.
Dialogue: 0,0:21:43.16,0:21:45.13,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:46.17,0:21:49.17,Default,,0,0,0,,Бұдан былай біз жаңа аймаққа көшеміз!
Dialogue: 0,0:21:49.17,0:21:54.18,Default,,0,0,0,,(қолдаушылардың қошеметі)
Dialogue: 0,0:21:54.18,0:21:56.18,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:56.18,0:21:58.18,Default,,0,0,0,,Күте тұрыңыз, Белл, иә?
Dialogue: 0,0:21:58.18,0:22:03.18,Default,,0,0,0,,Бұл елдің құдайы не болды? Ол өлді ме? Ол жойылды ма?
Dialogue: 0,0:22:03.18,0:22:05.19,Default,,0,0,0,,Сіз оны кесіп тастадыңыз ба?
Dialogue: 0,0:22:05.19,0:22:09.19,Default,,0,0,0,,А, мен анық өлтірілдім, бірақ мен өлген жоқпын.
Dialogue: 0,0:22:09.19,0:22:11.19,Default,,0,0,0,,Өлдім деп ойласаң, өлгенсің
Dialogue: 0,0:22:11.19,0:22:15.20,Default,,0,0,0,,Өлі емеспін деп ойласаң, сонда тірі боласың.
Dialogue: 0,0:22:15.20,0:22:17.20,Default,,0,0,0,,Барлық жерде
Dialogue: 0,0:22:17.20,0:22:21.20,Default,,0,0,0,,Мына көбелекке қараңдаршы. Ол нені білдіреді?
Dialogue: 0,0:22:21.20,0:22:26.21,Default,,0,0,0,,Балауыз болып, әлсірейді, Құрғағанда ғана қайта туады.
Dialogue: 0,0:22:26.21,0:22:28.18,Default,,0,0,0,,Бұл ай!
Dialogue: 0,0:22:35.22,0:22:55.17,Default,,0,0,0,,♬～
Dialogue: 0,0:22:55.17,0:23:15.19,Default,,0,0,0,,♬～
Dialogue: 0,0:23:15.19,0:23:18.19,Default,,0,0,0,,♬～
Dialogue: 0,0:23:18.19,0:23:36.14,Default,,0,0,0,,♬～
Dialogue: 0,0:23:36.14,0:23:43.15,Default,,0,0,0,,♬～
Dialogue: 0,0:23:43.15,0:23:57.16,Default,,0,0,0,,♬～
Dialogue: 0,0:23:57.16,0:24:04.14,Default,,0,0,0,,♬～
Dialogue: 0,0:24:05.17,0:24:07.17,Default,,0,0,0,,Міне, мен сізге көрсеткім келді.
Dialogue: 0,0:24:07.17,0:24:09.18,Default,,0,0,0,,Сенің семсерің жұмбақты шеше ме?
Dialogue: 0,0:24:09.18,0:24:11.18,Default,,0,0,0,,Мен осында тірі тұрмын
Dialogue: 0,0:24:11.18,0:24:14.15,Default,,0,0,0,,Мәңгілік сағынышты аңдығандай
Dialogue: 0,0:24:15.65,0:24:21.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory