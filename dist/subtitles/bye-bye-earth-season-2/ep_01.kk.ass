Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.13,0:00:08.14,Default,,0,0,0,,Мен... тамырымды білгім келеді!
Dialogue: 0,0:00:08.14,0:00:11.14,Default,,0,0,0,,《Осы тастардың бірінен жас мен пайда болды》
Dialogue: 0,0:00:11.14,0:00:14.14,Default,,0,0,0,,《Мен енді ештеңе қия алмайтыныма сенбеймін...》
Dialogue: 0,0:00:14.14,0:00:16.14,Default,,0,0,0,,Іздегеніңді таптың ба?
Dialogue: 0,0:00:16.14,0:00:19.15,Default,,0,0,0,,Мен ішімде әйелдің ұйықтап жатқанын сеземін.
Dialogue: 0,0:00:19.15,0:00:21.15,Default,,0,0,0,,Сен өлесің бе? Сіз өлесіз бе?
Dialogue: 0,0:00:21.15,0:00:23.15,Default,,0,0,0,,Бұл менің қарғысым
Dialogue: 0,0:00:23.15,0:00:25.15,Default,,0,0,0,,Менімен саяхатыңыздың есігін ашыңыз
Dialogue: 0,0:00:25.15,0:00:27.16,Default,,0,0,0,,Мен сенің әкеңнің қылышын ұстаймын.
Dialogue: 0,0:00:27.16,0:00:29.16,Default,,0,0,0,,Қоңырауға көмектесіңіз!
Dialogue: 0,0:00:29.16,0:00:31.16,Default,,0,0,0,,《Құдай ағашы семсершіні жеп жатыр》
Dialogue: 0,0:00:31.16,0:00:33.16,Default,,0,0,0,,Жоқ, әлі жоқ...
Dialogue: 0,0:00:33.16,0:00:35.16,Default,,0,0,0,,Мен бұлай болатынын білдім.
Dialogue: 0,0:00:35.16,0:00:37.17,Default,,0,0,0,,Біз әлі ғашық болған жоқпыз.
Dialogue: 0,0:00:37.17,0:00:40.17,Default,,0,0,0,,Менен басқа сені әйел ретінде көретін адам бар ма?
Dialogue: 0,0:00:40.17,0:00:43.17,Default,,0,0,0,,Бізге ақылға күмәнмен қарайтын адам керек.
Dialogue: 0,0:00:43.17,0:00:46.14,Default,,0,0,0,,Парасатты қыз – Құдайдың...
Dialogue: 0,0:00:48.18,0:00:53.15,Default,,0,0,0,,(Аштық альянсының ыңырануы)
Dialogue: 0,0:00:57.19,0:01:02.19,Default,,0,0,0,,Аға, сен маған қарағанда әлдеқайда көп директорсың.
Dialogue: 0,0:01:02.19,0:01:06.13,Default,,0,0,0,,Өйткені менің қарғысымның пішіні оны солай етеді.
Dialogue: 0,0:01:06.13,0:01:11.13,Default,,0,0,0,,Себебі мені де себебін білуге жіберген...
Dialogue: 0,0:01:11.13,0:01:18.14,Default,,0,0,0,,Скептицизмге жауап ретінде ақыл-ой шынымен үміт бола ала ма?
Dialogue: 0,0:01:18.14,0:01:20.14,Default,,0,0,0,,Дүниедегі себепке қарамастан➡
Dialogue: 0,0:01:20.14,0:01:23.15,Default,,0,0,0,,Құсты торға қайта салуға болмайды
Dialogue: 0,0:01:23.15,0:01:25.15,Default,,0,0,0,,Оның сағынышы➡
Dialogue: 0,0:01:25.15,0:01:29.15,Default,,0,0,0,,Бұл дүние жаншылғанша
Dialogue: 0,0:01:29.15,0:01:32.15,Default,,0,0,0,,Онин, сен қауіптісің.
Dialogue: 0,0:01:32.15,0:01:36.16,Default,,0,0,0,,Өз үмітің үшін көп нәрсені құрбан ет➡
Dialogue: 0,0:01:36.16,0:01:39.16,Default,,0,0,0,,Мен тіпті үмітті өлтіруді құптаймын.
Dialogue: 0,0:01:39.16,0:01:43.17,Default,,0,0,0,,Өлуің керек еді
Dialogue: 0,0:01:43.17,0:01:48.17,Default,,0,0,0,,Ақылдың қызы мені кесіп тастағанда өлуім керек еді.
Dialogue: 0,0:01:48.17,0:01:52.17,Default,,0,0,0,,Басқа айтар сөзім жоқ.
Dialogue: 0,0:01:52.17,0:01:54.18,Default,,0,0,0,,Келесі жолы кездесеміз➡
Dialogue: 0,0:01:54.18,0:01:56.18,Default,,0,0,0,,Сынаушының күлін қабылдау және қабылдау
Dialogue: 0,0:01:56.18,0:01:58.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:04.19,0:02:06.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:12.13,0:02:15.13,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:02:15.13,0:02:18.13,Default,,0,0,0,,《Бұл қай жер?》
Dialogue: 0,0:02:18.13,0:02:21.14,Default,,0,0,0,,⚟ Хмм…
Dialogue: 0,0:02:26.14,0:02:28.11,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:02:34.15,0:02:38.15,Default,,0,0,0,,《Мен мұнда не үшін келдім? 》
Dialogue: 0,0:02:38.15,0:02:40.12,Default,,0,0,0,,)
Dialogue: 0,0:02:41.16,0:02:44.16,Default,,0,0,0,,)
Dialogue: 0,0:02:44.16,0:02:47.13,Default,,0,0,0,,Кесу мүмкін емес
Dialogue: 0,0:02:50.17,0:02:52.17,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:02:52.17,0:02:54.17,Default,,0,0,0,,Бұл Беннетт, Белл.
Dialogue: 0,0:02:54.17,0:02:56.17,Default,,0,0,0,,Мен саған қонаққа келдім.
Dialogue: 0,0:02:56.17,0:02:58.17,Default,,0,0,0,,⚟Қалайсыз ба, мені кіргізе аласыз ба?
Dialogue: 0,0:02:58.17,0:03:00.18,Default,,0,0,0,,)
Dialogue: 0,0:03:00.18,0:03:02.14,Default,,0,0,0,,Мен оны кесіп аламын
Dialogue: 0,0:03:04.18,0:03:06.15,Default,,0,0,0,,Қоңырау?
Dialogue: 0,0:03:07.12,0:03:09.12,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:09.12,0:03:12.12,Default,,0,0,0,,Уф... 《Тоқта, Бенедиктин》
Dialogue: 0,0:03:12.12,0:03:14.12,Default,,0,0,0,,《Неге бізге мұндай дәрежеге бару керек?》
Dialogue: 0,0:03:14.12,0:03:18.13,Default,,0,0,0,,《Бұл су тайпасының тағдыры, Беннет》
Dialogue: 0,0:03:18.13,0:03:20.13,Default,,0,0,0,,)
Dialogue: 0,0:03:20.13,0:03:23.13,Default,,0,0,0,,)
Dialogue: 0,0:03:23.13,0:03:27.14,Default,,0,0,0,,((Су перісінде физикалық жарақат және эмоционалды тыртықтар ➡
Dialogue: 0,0:03:27.14,0:03:31.14,Default,,0,0,0,,Сіз ерлер мен әйелдердің қарым-қатынасы туралы ойланып көрдіңіз бе? ))
Dialogue: 0,0:03:31.14,0:03:34.14,Default,,0,0,0,,《Жарық... Тіпті қасиетті күл де оны емдей алмайды》
Dialogue: 0,0:03:34.14,0:03:36.14,Default,,0,0,0,,《Сізге бәрібір ме?》
Dialogue: 0,0:03:36.14,0:03:38.15,Default,,0,0,0,,《Мен неге күшті болдым?》
Dialogue: 0,0:03:38.15,0:03:40.15,Default,,0,0,0,,《Осы себепті》
Dialogue: 0,0:03:40.15,0:03:45.15,Default,,0,0,0,,《Осы сәт болмаса, бұл күш... мағынасыз! 》
Dialogue: 0,0:03:45.15,0:03:47.12,Default,,0,0,0,,⚟Қоңырау!
Dialogue: 0,0:03:49.16,0:03:51.16,Default,,0,0,0,,Хмм... кім?
Dialogue: 0,0:03:51.16,0:03:55.16,Default,,0,0,0,,⚟Бұл менмін, тез ашыңызшы.
Dialogue: 0,0:03:55.16,0:03:59.13,Default,,0,0,0,,⚟Мен сені көру үшін жол бойы келдім.
Dialogue: 0,0:04:00.17,0:04:03.17,Default,,0,0,0,,Хехе Бенедиктин!
Dialogue: 0,0:04:03.17,0:04:05.17,Default,,0,0,0,,Сенің көздерің...
Dialogue: 0,0:04:05.17,0:04:08.11,Default,,0,0,0,,Керемет көрініс
Dialogue: 0,0:04:08.11,0:04:11.11,Default,,0,0,0,,Сен неге...
Dialogue: 0,0:04:11.11,0:04:14.12,Default,,0,0,0,,Мынау қандай сұмдық бөлме?
Dialogue: 0,0:04:14.12,0:04:17.12,Default,,0,0,0,,Науқастарды зиярат ету сондықтан...
Dialogue: 0,0:04:17.12,0:04:19.12,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:04:19.12,0:04:22.12,Default,,0,0,0,,Мен сені өлді деп ойладым
Dialogue: 0,0:04:22.12,0:04:24.13,Default,,0,0,0,,Менің шашым да, бәрі де бейберекет.
Dialogue: 0,0:04:24.13,0:04:27.13,Default,,0,0,0,,Сонда сіз оны біреуге көрсеткіңіз келе ме?
Dialogue: 0,0:04:27.13,0:04:32.13,Default,,0,0,0,,Сіз, ер адам, келгенде, мен болдым...
Dialogue: 0,0:04:32.13,0:04:35.10,Default,,0,0,0,,Себебі мен қарызымды өтеген жоқпын.
Dialogue: 0,0:04:36.14,0:04:38.14,Default,,0,0,0,,Сіз Гордонды кесіп тастадыңыз➡
Dialogue: 0,0:04:38.14,0:04:43.15,Default,,0,0,0,,Жүрегімнің қарғысынан босатқаным үшін
Dialogue: 0,0:04:43.15,0:04:45.15,Default,,0,0,0,,Өзіңізге дұрыс күтім жасаңыз
Dialogue: 0,0:04:45.15,0:04:48.12,Default,,0,0,0,,Өйткені шашың жібек жіп сияқты.
Dialogue: 0,0:04:51.15,0:04:54.16,Default,,0,0,0,,Міне, сіздің сүйікті Meissen шайы.
Dialogue: 0,0:04:54.16,0:04:57.13,Default,,0,0,0,,Демитас шайы қазір маусымда.
Dialogue: 0,0:05:01.16,0:05:04.17,Default,,0,0,0,,Саған ешнәрсе жоқ
Dialogue: 0,0:05:04.17,0:05:07.10,Default,,0,0,0,,Мен оның қиналғанын түсіне алмадым.
Dialogue: 0,0:05:07.10,0:05:12.11,Default,,0,0,0,,Сонда да мені түсінуге тырысамын➡
Dialogue: 0,0:05:12.11,0:05:15.11,Default,,0,0,0,,Мен оны өзіммен толтыруға тырыстым.
Dialogue: 0,0:05:15.11,0:05:17.11,Default,,0,0,0,,Бұл онымен бірдей емес.
Dialogue: 0,0:05:17.11,0:05:20.08,Default,,0,0,0,,Әлгі жігіт әлдеқайда нашар.
Dialogue: 0,0:05:21.12,0:05:24.12,Default,,0,0,0,,Маған күшті Адонис ұнайды
Dialogue: 0,0:05:24.12,0:05:28.12,Default,,0,0,0,,Әлсіз Адонисті көру мені мазасыздандырады.
Dialogue: 0,0:05:28.12,0:05:32.13,Default,,0,0,0,,Әлсіз Адонис маған көмектеспейді.
Dialogue: 0,0:05:32.13,0:05:34.13,Default,,0,0,0,,Оның әлсіздігін түсінгеннен кейін➡
Dialogue: 0,0:05:34.13,0:05:38.13,Default,,0,0,0,,Мен мықты Адонистен айырылатыныма сенімдімін.
Dialogue: 0,0:05:38.13,0:05:42.14,Default,,0,0,0,,Сондықтан маған ұнамады. Түсінгім келмеді.
Dialogue: 0,0:05:42.14,0:05:45.14,Default,,0,0,0,,Мен бұған жол бергенше, сені өлтіргенім артық.
Dialogue: 0,0:05:45.14,0:05:48.14,Default,,0,0,0,,Сонда сіз сондай күшті Адонис➡ боласыз
Dialogue: 0,0:05:48.14,0:05:51.15,Default,,0,0,0,,Сіз не күттіңіз?
Dialogue: 0,0:05:51.15,0:05:53.15,Default,,0,0,0,,Сондай қорқақ, қорқақ адамға.
Dialogue: 0,0:05:53.15,0:05:55.15,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:05:55.15,0:05:59.15,Default,,0,0,0,,Мен сені әлсіз болсаң да жақсы көремін, иә?
Dialogue: 0,0:05:59.15,0:06:02.16,Default,,0,0,0,,Шын жүректен мен жай ғана қарап шығуым керек сияқты.
Dialogue: 0,0:06:02.16,0:06:04.16,Default,,0,0,0,,Бұл сергітеді.
Dialogue: 0,0:06:04.16,0:06:06.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:06.09,0:06:08.10,Default,,0,0,0,,Неге жиіркенішті адамға ұнайды➡
Dialogue: 0,0:06:08.10,0:06:11.10,Default,,0,0,0,,Менімен әрқашан кездескіңіз келетінін білемін.
Dialogue: 0,0:06:11.10,0:06:15.10,Default,,0,0,0,,Мен сенің қасыңда болсам, мен жақсы әйел бола алатынымды сезінемін.
Dialogue: 0,0:06:15.10,0:06:18.11,Default,,0,0,0,,Әй, мұнымен не айтқың келеді?
Dialogue: 0,0:06:18.11,0:06:22.11,Default,,0,0,0,,Сіз мені әйел етесіз
Dialogue: 0,0:06:22.11,0:06:27.12,Default,,0,0,0,,Нәсілден үлкен түбірлерде➡
Dialogue: 0,0:06:27.12,0:06:29.12,Default,,0,0,0,,Маған қара
Dialogue: 0,0:06:29.12,0:06:31.12,Default,,0,0,0,,Сен әдемісің.
Dialogue: 0,0:06:31.12,0:06:34.12,Default,,0,0,0,,ше? сен боссың
Dialogue: 0,0:06:34.12,0:06:36.12,Default,,0,0,0,,Ол әрбір нәсілде бар➡
Dialogue: 0,0:06:36.12,0:06:39.13,Default,,0,0,0,,Сұлулық пен ұсқынсыздық стандарттарына кедергісіз бола білу
Dialogue: 0,0:06:39.13,0:06:43.13,Default,,0,0,0,,Мен өзімді өте жеңіл және еркін сезінемін.
Dialogue: 0,0:06:43.13,0:06:46.13,Default,,0,0,0,,Күш пен әлсіздік, сұлулық пен ұсқынсыздық➡
Dialogue: 0,0:06:46.13,0:06:49.14,Default,,0,0,0,,Барлығы сіздің ішіңізде
Dialogue: 0,0:06:49.14,0:06:52.14,Default,,0,0,0,,Барлығы оған қол тигізу үшін өледі.
Dialogue: 0,0:06:52.14,0:06:54.14,Default,,0,0,0,,Сондықтан мен сізге гүл тілеймін➡
Dialogue: 0,0:06:54.14,0:06:58.15,Default,,0,0,0,,Менің не ойлағанымды білмегендей, өзі гүлдеп тұр.
Dialogue: 0,0:06:58.15,0:07:00.15,Default,,0,0,0,,Ең болмағанда мұңайып, қурап қалған жер➡
Dialogue: 0,0:07:00.15,0:07:03.15,Default,,0,0,0,,Мен қарап шығуым керек.
Dialogue: 0,0:07:03.15,0:07:08.09,Default,,0,0,0,,Егер сіз осылай айтсам, мен не істеуім керек...
Dialogue: 0,0:07:08.09,0:07:12.09,Default,,0,0,0,,Мен Адонистен менімен бірге саяхатқа шығуын өтіндім.
Dialogue: 0,0:07:12.09,0:07:15.10,Default,,0,0,0,,Себебі мен жалғыз болдым
Dialogue: 0,0:07:15.10,0:07:20.10,Default,,0,0,0,,Мен ол жерден қашып кеткім келді, сондықтан мен оны құрбандыққа шалуға тырыстым.
Dialogue: 0,0:07:20.10,0:07:23.10,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:07:23.10,0:07:26.11,Default,,0,0,0,,Мен сені өзіммен бірге саяхатқа апарсам➡
Dialogue: 0,0:07:26.11,0:07:31.11,Default,,0,0,0,,Мен оны басқарып, өлтіретініме сенімдімін.
Dialogue: 0,0:07:31.11,0:07:33.11,Default,,0,0,0,,Ол көмек сұрады.
Dialogue: 0,0:07:33.11,0:07:35.12,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:07:35.12,0:07:37.12,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:07:37.12,0:07:39.12,Default,,0,0,0,,Бәріне сен кінәлі дейсің бе?
Dialogue: 0,0:07:39.12,0:07:41.12,Default,,0,0,0,,Ақымаққа ұқсайды
Dialogue: 0,0:07:41.12,0:07:44.13,Default,,0,0,0,,Сіз мұны бұрын өзіңіз айттыңыз.
Dialogue: 0,0:07:44.13,0:07:46.13,Default,,0,0,0,,Нағыз себеп
Dialogue: 0,0:07:46.13,0:07:48.13,Default,,0,0,0,,Нақты себебі? Иә
Dialogue: 0,0:07:48.13,0:07:53.13,Default,,0,0,0,,Неліктен онымен бірге саяхатқа барғың келді?
Dialogue: 0,0:07:53.13,0:07:55.10,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:57.14,0:08:03.14,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:08:03.14,0:08:06.08,Default,,0,0,0,,Мен жалғызбын, иә
Dialogue: 0,0:08:06.08,0:08:10.09,Default,,0,0,0,,Жалғыздығым сонша, мен өлетін сияқтымын!
Dialogue: 0,0:08:10.09,0:08:14.09,Default,,0,0,0,,Қорқынышты, қиын, жалғызбын
Dialogue: 0,0:08:14.09,0:08:17.09,Default,,0,0,0,,Саған ешкім көмектеспейді.
Dialogue: 0,0:08:17.09,0:08:22.10,Default,,0,0,0,,Тым болмаса бір адам мені қолдаса жақсы емес пе?
Dialogue: 0,0:08:22.10,0:08:25.10,Default,,0,0,0,,Мені құтқарғаныңыз жақсы емес пе?
Dialogue: 0,0:08:25.10,0:08:29.10,Default,,0,0,0,,Мен неге жалғызбын?
Dialogue: 0,0:08:29.10,0:08:35.11,Default,,0,0,0,,Неге, қанша уақыт өтсе де, мен... бұл...
Dialogue: 0,0:08:35.11,0:08:40.12,Default,,0,0,0,,Мен бұл сағыныш туралы ештеңе істей алмаймын.
Dialogue: 0,0:08:40.12,0:08:45.12,Default,,0,0,0,,Бір күні, бір жерде, біреу маған соны үйретті.
Dialogue: 0,0:08:45.12,0:08:48.12,Default,,0,0,0,,Туған жерімді ойлау...
Dialogue: 0,0:08:48.12,0:08:50.13,Default,,0,0,0,,Утопияны аңсау...
Dialogue: 0,0:08:50.13,0:08:53.13,Default,,0,0,0,,Мен тұрған жерді де, өзімді де сүйе алмаймын...
Dialogue: 0,0:08:53.13,0:08:56.10,Default,,0,0,0,,Мәңгілік адасу
Dialogue: 0,0:08:59.13,0:09:01.14,Default,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:09:01.14,0:09:05.14,Default,,0,0,0,,Жолдың есігі ашылмаған...
Dialogue: 0,0:09:05.14,0:09:10.08,Default,,0,0,0,,Соны ашсаңыз, өзіңізді одан бетер жалғыз сезінесіз.
Dialogue: 0,0:09:10.08,0:09:14.08,Default,,0,0,0,,Неліктен мен өзім туралы білуге тырысамын➡
Dialogue: 0,0:09:14.08,0:09:18.09,Default,,0,0,0,,Мен жалғыз қалуым керек сияқты.
Dialogue: 0,0:09:18.09,0:09:20.09,Default,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:09:20.09,0:09:22.09,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:22.09,0:09:26.09,Default,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:09:26.09,0:09:29.06,Default,,0,0,0,,Мен... қарағым.
Dialogue: 0,0:09:30.10,0:09:33.10,Default,,0,0,0,,Мен... жаман емеспін бе?
Dialogue: 0,0:09:33.10,0:09:35.10,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:35.10,0:09:38.11,Default,,0,0,0,,Қане, дұрыстап айт.
Dialogue: 0,0:09:38.11,0:09:41.11,Default,,0,0,0,,Мен қазір жұмыс істеп жатырмын ғой, білесің бе. Мен бос емеспін
Dialogue: 0,0:09:41.11,0:09:44.11,Default,,0,0,0,,Бұл менің кінәм емес! Мен де...
Dialogue: 0,0:09:44.11,0:09:47.12,Default,,0,0,0,,Иә, иә, иә!
Dialogue: 0,0:09:47.12,0:09:51.12,Default,,0,0,0,,Ал сен қайда бара жатырсың?
Dialogue: 0,0:09:51.12,0:09:57.13,Default,,0,0,0,,Мен өзімнің шынайы шығу тегімді іздеймін... Иә.
Dialogue: 0,0:09:57.13,0:10:00.13,Default,,0,0,0,,Осы сағынышпен күресу үшін...
Dialogue: 0,0:10:00.13,0:10:04.13,Default,,0,0,0,,Иә, сіз саяхатқа барасыз.
Dialogue: 0,0:10:04.13,0:10:08.14,Default,,0,0,0,,Бір ғана тақырыбы бар жалғыз адам болыңыз.
Dialogue: 0,0:10:08.14,0:10:10.14,Default,,0,0,0,,Ицумида-сан ба?
Dialogue: 0,0:10:10.14,0:10:14.14,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:10:14.14,0:10:18.11,Default,,0,0,0,,Өйткені бұл өмір сүрудің жалғыз жолы
Dialogue: 0,0:10:19.15,0:10:22.15,Default,,0,0,0,,Мен саяхатқа барамын Иә.
Dialogue: 0,0:10:22.15,0:10:27.16,Default,,0,0,0,,Мен... саяхатшы боламын.
Dialogue: 0,0:10:27.16,0:10:30.16,Default,,0,0,0,,Бар, Белл.
Dialogue: 0,0:10:30.16,0:10:33.16,Default,,0,0,0,,Осында қалып, аман қалудан басқа амалымыз жоқ➡
Dialogue: 0,0:10:33.16,0:10:35.16,Default,,0,0,0,,Мен ештеңе істей алмаймын➡
Dialogue: 0,0:10:35.16,0:10:37.17,Default,,0,0,0,,Саяхатыңыздың соңында не болады➡
Dialogue: 0,0:10:37.17,0:10:39.17,Default,,0,0,0,,Біз де сенеміз➡
Dialogue: 0,0:10:39.17,0:10:41.17,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:10:41.17,0:10:44.17,Default,,0,0,0,,Біз бір күні сөйлесеміз
Dialogue: 0,0:10:44.17,0:10:47.14,Default,,0,0,0,,Бірге саяхаттаңыз
Dialogue: 0,0:11:04.19,0:11:07.13,Default,,0,0,0,,А... иә?
Dialogue: 0,0:11:07.13,0:11:09.13,Default,,0,0,0,,Ендеше бастайық
Dialogue: 0,0:11:09.13,0:11:13.10,Default,,0,0,0,,Бізде енді көп уақыт жоқ сияқты.
Dialogue: 0,0:11:17.14,0:11:19.11,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:11:30.15,0:11:35.16,Default,,0,0,0,,♪ (ән айту)
Dialogue: 0,0:11:35.16,0:11:37.16,Default,,0,0,0,,♪～
Dialogue: 0,0:11:37.16,0:11:39.16,Default,,0,0,0,,Су перілері➡
Dialogue: 0,0:11:39.16,0:11:44.17,Default,,0,0,0,,Бұл өзен-көлдерді тазарту үшін айтылатын ән.
Dialogue: 0,0:11:44.17,0:11:47.17,Default,,0,0,0,,Осы нақты материкпен салыстыру➡
Dialogue: 0,0:11:47.17,0:11:51.17,Default,,0,0,0,,Ұлы Рух мұхиты
Dialogue: 0,0:11:51.17,0:11:56.14,Default,,0,0,0,,Одан шыққан таза тамшы – су перісі.
Dialogue: 0,0:11:58.18,0:12:00.18,Default,,0,0,0,,Басқаның санасында паразит болуы керек➡
Dialogue: 0,0:12:00.18,0:12:03.18,Default,,0,0,0,,Жүректері қалыптаспаған су перілері➡
Dialogue: 0,0:12:03.18,0:12:07.12,Default,,0,0,0,,Мен ешқашан құтыла алмайтын тағдырды арқалап жүрмін.
Dialogue: 0,0:12:07.12,0:12:11.13,Default,,0,0,0,,Олардың барлығы да өз тұлғаларымен паразиттік болған➡
Dialogue: 0,0:12:11.13,0:12:15.13,Default,,0,0,0,,Жүрегіңнің ластығын ал
Dialogue: 0,0:12:15.13,0:12:24.14,Default,,0,0,0,,♪～
Dialogue: 0,0:12:24.14,0:12:26.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:26.14,0:12:31.15,Default,,0,0,0,,♪～
Dialogue: 0,0:12:31.15,0:12:37.15,Default,,0,0,0,,Кір мен таза қан, азап пен қуаныш...
Dialogue: 0,0:12:37.15,0:12:42.16,Default,,0,0,0,,Сіздің жоғалтатын ештеңеңіз жоқ
Dialogue: 0,0:12:42.16,0:12:47.16,Default,,0,0,0,,Тек сол тоқыраулардан құтылу үшін
Dialogue: 0,0:12:47.16,0:12:52.13,Default,,0,0,0,,Мұны сізбен бірге мен ғана білемін...
Dialogue: 0,0:12:53.17,0:12:55.17,Default,,0,0,0,,Олар ақырында➡ болады
Dialogue: 0,0:12:55.17,0:12:58.17,Default,,0,0,0,,Мұхиттың тереңдігіне оралу
Dialogue: 0,0:12:58.17,0:13:02.14,Default,,0,0,0,,Алынған кірді тазарту кезінде
Dialogue: 0,0:13:05.18,0:13:10.15,Default,,0,0,0,,Мен де тереңге барамын.
Dialogue: 0,0:13:11.12,0:13:16.09,Default,,0,0,0,,Бір-біріміздің саяхатымыз туралы сөйлесетін кез болады...
Dialogue: 0,0:13:20.13,0:13:24.13,Default,,0,0,0,,Қош бол Қоңырау
Dialogue: 0,0:13:24.13,0:13:27.10,Default,,0,0,0,,Қош бол Бенедиктин
Dialogue: 0,0:13:35.14,0:13:37.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:39.15,0:13:42.15,Default,,0,0,0,,Хмм... Қоңырау?
Dialogue: 0,0:13:42.15,0:13:45.12,Default,,0,0,0,,Иә, Беннетт.
Dialogue: 0,0:13:47.16,0:13:49.16,Default,,0,0,0,,Сіздің жараңыз жақсы ма?
Dialogue: 0,0:13:49.16,0:13:51.16,Default,,0,0,0,,Сізге рахмет.
Dialogue: 0,0:13:51.16,0:13:54.16,Default,,0,0,0,,Мен басқа сені құрбан еттім.
Dialogue: 0,0:13:54.16,0:13:57.17,Default,,0,0,0,,Қандай жағдай болмасын, мен сені жақсы сезінемін
Dialogue: 0,0:13:57.17,0:14:02.17,Default,,0,0,0,,Саған көмектесе алатынымды білу мені бақытты етеді.
Dialogue: 0,0:14:02.17,0:14:07.11,Default,,0,0,0,,А... бұл оның кетуі үшін төлейтін баға.
Dialogue: 0,0:14:07.11,0:14:09.11,Default,,0,0,0,,Су перілерінің құлағы бар
Dialogue: 0,0:14:09.11,0:14:12.11,Default,,0,0,0,,Бұрынғыдан онша айырмашылығы жоқ.
Dialogue: 0,0:14:12.11,0:14:14.12,Default,,0,0,0,,Иә
Dialogue: 0,0:14:14.12,0:14:17.12,Default,,0,0,0,,Мен ризамын
Dialogue: 0,0:14:17.12,0:14:19.12,Default,,0,0,0,,Менің ойымша, бұл жаман емес.
Dialogue: 0,0:14:19.12,0:14:22.12,Default,,0,0,0,,Бұлай айтатыныңызға сенімді болдым.
Dialogue: 0,0:14:22.12,0:14:25.13,Default,,0,0,0,,Иә, мен де➡
Dialogue: 0,0:14:25.13,0:14:27.13,Default,,0,0,0,,Себебі мен саған ризамын
Dialogue: 0,0:14:27.13,0:14:30.13,Default,,0,0,0,,Жыламаймын деп шештім, ау
Dialogue: 0,0:14:30.13,0:14:33.13,Default,,0,0,0,,Кешірмеймін деп шештім.
Dialogue: 0,0:14:33.13,0:14:37.14,Default,,0,0,0,,Менің ойымша, бұл жақсы, Белл.
Dialogue: 0,0:14:37.14,0:14:39.14,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:39.14,0:14:41.11,Default,,0,0,0,,Иә
Dialogue: 0,0:14:44.15,0:14:46.15,Default,,0,0,0,,Ах... Сәлем Гиннес
Dialogue: 0,0:14:46.15,0:14:49.15,Default,,0,0,0,,Сәлемдесу Қоңырау Қайырлы таң
Dialogue: 0,0:14:49.15,0:14:52.15,Default,,0,0,0,,Уу, мен әлі байсалды емеспін.
Dialogue: 0,0:14:52.15,0:14:56.16,Default,,0,0,0,,Эй, сен не үшін бара жатқаныңды білесің бе?
Dialogue: 0,0:14:56.16,0:14:59.16,Default,,0,0,0,,Жаназаға дейін бас иемін.
Dialogue: 0,0:14:59.16,0:15:04.17,Default,,0,0,0,,Ах... Гиннеске де өлім құсы туралы хабар келді.
Dialogue: 0,0:15:04.17,0:15:06.10,Default,,0,0,0,,О
Dialogue: 0,0:15:06.10,0:15:11.07,Default,,0,0,0,,Джимбек... Мен сағынған адамымнан айырылдым.
Dialogue: 0,0:15:17.11,0:15:19.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:27.12,0:15:29.12,Default,,0,0,0,,Тұман! Хмм...
Dialogue: 0,0:15:29.12,0:15:31.13,Default,,0,0,0,,Естімеген.
Dialogue: 0,0:15:31.13,0:15:35.13,Default,,0,0,0,,Топ ит Андердогты жерлеуге келеді.
Dialogue: 0,0:15:35.13,0:15:40.13,Default,,0,0,0,,Мен сол атақты дирижерге қарыздармын.
Dialogue: 0,0:15:40.13,0:15:50.14,Default,,0,0,0,,♬～
Dialogue: 0,0:15:50.14,0:15:52.15,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:52.15,0:15:54.15,Default,,0,0,0,,Жара туралы не деуге болады? Ах...
Dialogue: 0,0:15:54.15,0:15:58.15,Default,,0,0,0,,Бұл жеткілікті ме? Жарайды, сен маған ұсқынсыз нәрсе көрсеттің.
Dialogue: 0,0:15:58.15,0:16:01.16,Default,,0,0,0,,Мұндағы 10-нан астам адамның қылыштары сынған.
Dialogue: 0,0:16:01.16,0:16:03.16,Default,,0,0,0,,Бұл құбыжық.
Dialogue: 0,0:16:03.16,0:16:06.09,Default,,0,0,0,,А, мен мұны жаман мағынада айтып тұрған жоқпын.
Dialogue: 0,0:16:06.09,0:16:09.10,Default,,0,0,0,,Өйткені бұл шынымен де керемет деп ойлаймын.
Dialogue: 0,0:16:09.10,0:16:13.10,Default,,0,0,0,,Катакомбалардағы төбелес кезінде де салқын көріндіңіз.
Dialogue: 0,0:16:13.10,0:16:16.10,Default,,0,0,0,,Әй, сол кезде➡
Dialogue: 0,0:16:16.10,0:16:20.11,Default,,0,0,0,,Мен Тицианды өлтіргенде бітті деп ойладым.
Dialogue: 0,0:16:20.11,0:16:25.11,Default,,0,0,0,,Сен күресе бергенде, мен надан болып қалдым.
Dialogue: 0,0:16:25.11,0:16:29.12,Default,,0,0,0,,Білсең, соғысар ма едің?
Dialogue: 0,0:16:29.12,0:16:35.12,Default,,0,0,0,,А... Мен дұрыс пен бұрыстың екі жағында емеспін.
Dialogue: 0,0:16:35.12,0:16:38.13,Default,,0,0,0,,Нені кесуге болады, нені кесуге болмайды?➡
Dialogue: 0,0:16:38.13,0:16:41.13,Default,,0,0,0,,Сіз оны шынымен кесіп алмайынша білмейсіз
Dialogue: 0,0:16:41.13,0:16:46.13,Default,,0,0,0,,Сондықтан ол шынымен де өлтіруге лайық адамды өлтіру үшін күреседі.
Dialogue: 0,0:16:46.13,0:16:48.14,Default,,0,0,0,,Бұл саяхаттаудың қарғысы.
Dialogue: 0,0:16:48.14,0:16:51.14,Default,,0,0,0,,Сіз білесіз бе? Мен Гиннестен естідім.
Dialogue: 0,0:16:51.14,0:16:54.14,Default,,0,0,0,,Хмм, а... өйткені➡
Dialogue: 0,0:16:54.14,0:16:57.14,Default,,0,0,0,,Ол Зимбек мырзаны көруге келді.
Dialogue: 0,0:16:57.14,0:17:01.15,Default,,0,0,0,,Сіз бұл адамсыз ба, Адонис?
Dialogue: 0,0:17:01.15,0:17:03.15,Default,,0,0,0,,А... неге менімен бірге емессің?
Dialogue: 0,0:17:03.15,0:17:06.09,Default,,0,0,0,,Мен сізді тіпті бірге саяхатқа баруға уәде бергеніңізді естідім.
Dialogue: 0,0:17:06.09,0:17:09.09,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:17:09.09,0:17:11.09,Default,,0,0,0,,«Оның аман-есен жетуін қамтамасыз етші.»
Dialogue: 0,0:17:11.09,0:17:13.09,Default,,0,0,0,,Ха... Маған шабуыл жасалды.
Dialogue: 0,0:17:13.09,0:17:15.10,Default,,0,0,0,,Сіз…
Dialogue: 0,0:17:15.10,0:17:18.10,Default,,0,0,0,,Жарайды, көп нәрсе болды, бірақ бәрі жақсы болмады.
Dialogue: 0,0:17:18.10,0:17:22.10,Default,,0,0,0,,Ха... Бірақ ол жоқ.
Dialogue: 0,0:17:22.10,0:17:26.11,Default,,0,0,0,,Қайта кездесіп, сөйлессек екен, бірақ қайдасың...
Dialogue: 0,0:17:26.11,0:17:29.11,Default,,0,0,0,,Мұндай менсінбейтін адамды ұмыт.
Dialogue: 0,0:17:29.11,0:17:31.11,Default,,0,0,0,,Мені кесіп тастайтыныңызға сенімді едім➡
Dialogue: 0,0:17:31.11,0:17:34.12,Default,,0,0,0,,Бұл жасырын. Мүмкін.
Dialogue: 0,0:17:34.12,0:17:37.12,Default,,0,0,0,,Мен де оны тапқан бойда оны кесіп тастауды жоспарладым.
Dialogue: 0,0:17:37.12,0:17:39.09,Default,,0,0,0,,Хаха…
Dialogue: 0,0:17:46.13,0:17:48.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:49.13,0:17:51.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:53.13,0:17:56.10,Default,,0,0,0,,Ол кездегі обсерваторияға ұқсайды.
Dialogue: 0,0:18:02.14,0:18:04.15,Default,,0,0,0,,Катакомба... Иә.
Dialogue: 0,0:18:04.15,0:18:08.08,Default,,0,0,0,,Бұл Коллинздер деп аталатын отбасы сарайларының бірі.
Dialogue: 0,0:18:08.08,0:18:12.09,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,0:18:12.09,0:18:14.06,Default,,0,0,0,,Гиннес?
Dialogue: 0,0:18:19.09,0:18:24.07,Default,,0,0,0,,(Өлім құсының сайрауы)
Dialogue: 0,0:18:31.11,0:18:34.08,Default,,0,0,0,,Тендо зиратындай...
Dialogue: 0,0:18:36.11,0:18:39.08,Default,,0,0,0,,Қоңырау а... а
Dialogue: 0,0:18:48.12,0:18:51.13,Default,,0,0,0,,Менің атым полковник Коллинз.
Dialogue: 0,0:18:51.13,0:18:54.13,Default,,0,0,0,,Мен осы жерлеу рәсімінің қызметкерімін.
Dialogue: 0,0:18:54.13,0:18:57.13,Default,,0,0,0,,Коллинз катакомбаны білдіреді...
Dialogue: 0,0:18:57.13,0:18:59.13,Default,,0,0,0,,Иә
Dialogue: 0,0:18:59.13,0:19:03.14,Default,,0,0,0,,Алтын өгіз ғибадатханасын қорғайтын бас діни қызметкер ретінде мен сізді қарсы аламын.
Dialogue: 0,0:19:03.14,0:19:05.14,Default,,0,0,0,,Торус?
Dialogue: 0,0:19:05.14,0:19:10.08,Default,,0,0,0,,Катакомбаның төрт тұрақты белгісінің бірі, біз қазір тұрған жерді осылай атаймыз.
Dialogue: 0,0:19:10.08,0:19:15.08,Default,,0,0,0,,Сен қорғаған арыстанның жатыры да солардың бірі.
Dialogue: 0,0:19:15.08,0:19:17.08,Default,,0,0,0,,Лорд Ловерак Белл
Dialogue: 0,0:19:17.08,0:19:20.09,Default,,0,0,0,,Сол шайқасқа қатысты, Коллинз атынан➡
Dialogue: 0,0:19:20.09,0:19:22.09,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:19:22.09,0:19:24.09,Default,,0,0,0,,Жарайды, біз де➡
Dialogue: 0,0:19:24.09,0:19:27.09,Default,,0,0,0,,Мен аман қалу үшін күрестім...
Dialogue: 0,0:19:27.09,0:19:30.10,Default,,0,0,0,,Ал сол кезде, ең жоғарғы ит ретінде...
Dialogue: 0,0:19:30.10,0:19:32.10,Default,,0,0,0,,Жоқ, дұрыс айтасыз➡
Dialogue: 0,0:19:32.10,0:19:37.10,Default,,0,0,0,,Жекпе-жек топ ит пен ауддог арасындағы айырмашылықтан асып түсті.
Dialogue: 0,0:19:37.10,0:19:40.11,Default,,0,0,0,,Біздің идеалды болмысымызда
Dialogue: 0,0:19:40.11,0:19:43.11,Default,,0,0,0,,Танысқаныма қуаныштымын, Карнелл-Коллинз.
Dialogue: 0,0:19:43.11,0:19:47.11,Default,,0,0,0,,Сіз Гиннессіз бе? Иә.
Dialogue: 0,0:19:47.11,0:19:51.12,Default,,0,0,0,,Мен Джимбектің көзі тірісінде көп нәрсені естідім.
Dialogue: 0,0:19:51.12,0:19:55.12,Default,,0,0,0,,Алдыңғы шайқаста катакомбаларды өртеп жіберген адам ретінде➡
Dialogue: 0,0:19:55.12,0:19:58.13,Default,,0,0,0,,Мен сенімен бір рет кездескім келді.
Dialogue: 0,0:19:58.13,0:20:01.13,Default,,0,0,0,,Бұлай айту мүмкін емес.
Dialogue: 0,0:20:01.13,0:20:03.13,Default,,0,0,0,,Мұны біз де мойындаймыз
Dialogue: 0,0:20:03.13,0:20:08.14,Default,,0,0,0,,Біз алғыс айтуымыз керек және ешқашан жек көрмеуіміз керек.
Dialogue: 0,0:20:08.14,0:20:10.14,Default,,0,0,0,,Айтпақшы, Джинбак-доно➡ арқылы
Dialogue: 0,0:20:10.14,0:20:14.14,Default,,0,0,0,,Мен сіздің отбасыңыз туралы бірнеше рет өсек естідім.
Dialogue: 0,0:20:14.14,0:20:16.14,Default,,0,0,0,,Ол келді
Dialogue: 0,0:20:16.14,0:20:20.11,Default,,0,0,0,,Маған оқу өте қызықты болды.
Dialogue: 0,0:20:21.15,0:20:24.12,Default,,0,0,0,,Олай болса барлығың дайындалыңдар.
Dialogue: 0,0:20:25.15,0:20:27.12,Default,,0,0,0,,Импульс
Dialogue: 0,0:20:28.16,0:20:33.13,Default,,0,0,0,,Енді жерлеу рәсімі өтеді.
Dialogue: 0,0:20:37.16,0:20:40.13,Default,,0,0,0,,《Ол шынымен өлді》
Dialogue: 0,0:21:21.14,0:21:24.15,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:21:24.15,0:21:28.15,Default,,0,0,0,,Бұл ирониялық, солай емес пе?
Dialogue: 0,0:21:28.15,0:21:31.15,Default,,0,0,0,,Біздің аман қалуымыз үшін➡
Dialogue: 0,0:21:31.15,0:21:34.16,Default,,0,0,0,,Мен Катакомба бағын өртеп жібердім.
Dialogue: 0,0:21:34.16,0:21:38.16,Default,,0,0,0,,Осы жерде жерленген екенсің➡
Dialogue: 0,0:21:38.16,0:21:43.16,Default,,0,0,0,,Күнәң кешіріледі дейсің бе?
Dialogue: 0,0:21:43.16,0:21:47.17,Default,,0,0,0,,Джинбак-доно, мен жаңа сценарий жазғым келеді➡
Dialogue: 0,0:21:47.17,0:21:50.17,Default,,0,0,0,,Мен саған тағы келдім.
Dialogue: 0,0:21:50.17,0:21:54.18,Default,,0,0,0,,Жаңа адамдардың болашақ жағдайы...
Dialogue: 0,0:21:54.18,0:21:59.15,Default,,0,0,0,,Қылыш еліндегі жұмақ ауысуы
Dialogue: 0,0:22:04.19,0:22:24.14,Default,,0,0,0,,♬～
Dialogue: 0,0:22:24.14,0:22:37.15,Default,,0,0,0,,♬～
