Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.50,0:00:09.51,Default,,0,0,0,,Осы қылышта мен бәрін сұраймын
Dialogue: 0,0:00:09.51,0:00:12.51,Default,,0,0,0,,Басты рөлді шешуге ерік-жігер!
Dialogue: 0,0:00:12.51,0:00:16.51,Default,,0,0,0,,Патша мен еркектің арасында шешім қабылдай алатын адам бар ма?
Dialogue: 0,0:00:21.52,0:00:25.52,Default,,0,0,0,,Патша мен оның семсері осымен шешілді.
Dialogue: 0,0:00:25.52,0:00:29.53,Default,,0,0,0,,Мен де осы Құдай ағашында тұрамын.
Dialogue: 0,0:00:29.53,0:00:32.53,Default,,0,0,0,,Қарт патша өлді!
Dialogue: 0,0:00:38.53,0:00:42.54,Default,,0,0,0,,Мен патшамын!
Dialogue: 0,0:00:42.54,0:00:44.54,Default,,0,0,0,,(Қылышшылардың дауысы)
Dialogue: 0,0:00:44.54,0:00:48.54,Default,,0,0,0,,《Бұл тәртіп, Белл. Тапсырыс әрекет етуде.》
Dialogue: 0,0:00:48.54,0:00:50.55,Default,,0,0,0,,《Барлық адамдар
Dialogue: 0,0:00:50.55,0:00:54.55,Default,,0,0,0,,Құдай берген рөлді ойнау деген сөз.
Dialogue: 0,0:00:54.55,0:00:56.55,Default,,0,0,0,,《Мен патшаның рөлін ойнаймын.
Dialogue: 0,0:00:56.55,0:00:59.56,Default,,0,0,0,,Бар болмысымызбен өнер көрсетейік.
Dialogue: 0,0:00:59.56,0:01:02.56,Default,,0,0,0,,《Белл, сен үшін Құдайдың рөлі
Dialogue: 0,0:01:02.56,0:01:05.56,Default,,0,0,0,,Бұл шешім қабылданды.
Dialogue: 0,0:01:06.56,0:01:08.56,Default,,0,0,0,,《Сені кесіп тастауға рұқсат етпе》
Dialogue: 0,0:01:08.56,0:01:10.57,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:12.57,0:01:15.57,Default,,0,0,0,,Құдалық бақсы ретінде сөзді жеткізу
Dialogue: 0,0:01:15.57,0:01:17.57,Default,,0,0,0,,《Құдай сөзі!?》
Dialogue: 0,0:01:17.57,0:01:22.58,Default,,0,0,0,,Оны жаңа патшаның жарлығы ретінде табыңыз.
Dialogue: 0,0:01:22.58,0:01:24.58,Default,,0,0,0,,Саяхаттың кілті
Dialogue: 0,0:01:24.58,0:01:29.59,Default,,0,0,0,,《Ха, Шерри, сен бұл илаһи хабарды естімедің бе? 》
Dialogue: 0,0:01:29.59,0:01:32.59,Default,,0,0,0,,Оны жойыңыз 《Ха》
Dialogue: 0,0:01:32.59,0:01:37.59,Default,,0,0,0,,Кілт - қара уақыт пен қара бағыт.
Dialogue: 0,0:01:37.59,0:01:40.60,Default,,0,0,0,,Оны кім таба алады
Dialogue: 0,0:01:40.60,0:01:44.60,Default,,0,0,0,,Тақты аға ғана ұстай алады.
Dialogue: 0,0:01:44.60,0:01:48.60,Default,,0,0,0,,Саяхаттың кілтін жойыңыз
Dialogue: 0,0:01:49.61,0:02:07.62,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:07.62,0:02:11.63,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:11.63,0:02:31.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:31.65,0:02:51.67,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:51.67,0:03:11.69,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:11.69,0:03:18.69,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:19.70,0:03:22.70,Default,,0,0,0,,Боу?
Dialogue: 0,0:03:22.70,0:03:26.70,Default,,0,0,0,,Боу?
Dialogue: 0,0:03:26.70,0:03:28.70,Default,,0,0,0,,(Есік ашылу дыбысы)
Dialogue: 0,0:03:30.71,0:03:32.71,Default,,0,0,0,,жиі
Dialogue: 0,0:03:32.71,0:03:34.71,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:03:34.71,0:03:36.71,Default,,0,0,0,,Адонис…
Dialogue: 0,0:03:36.71,0:03:40.72,Default,,0,0,0,,Мен қылыштың қалдықтарын ұстаймын және жібермеймін.
Dialogue: 0,0:03:40.72,0:03:43.72,Default,,0,0,0,,Бұл көрініс бәрін айтады.
Dialogue: 0,0:03:43.72,0:03:46.72,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:03:46.72,0:03:48.72,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:03:48.72,0:03:50.73,Default,,0,0,0,,Уф…
Dialogue: 0,0:03:50.73,0:03:52.73,Default,,0,0,0,,Маған тиіспе!
Dialogue: 0,0:03:52.73,0:03:55.73,Default,,0,0,0,,Мен де, Лундинг те әлі өлген жоқпын!
Dialogue: 0,0:03:55.73,0:03:58.73,Default,,0,0,0,,Ақырында толығымен ыдырайтын болады
Dialogue: 0,0:04:00.74,0:04:03.74,Default,,0,0,0,,Күйбең тірліктен қуатты босат
Dialogue: 0,0:04:03.74,0:04:05.74,Default,,0,0,0,,(дыбыс қою)
Dialogue: 0,0:04:05.74,0:04:09.75,Default,,0,0,0,,Ха, қасиетті күл? ...жоқ
Dialogue: 0,0:04:09.75,0:04:11.75,Default,,0,0,0,,Қылыштарды қосу үшін...
Dialogue: 0,0:04:11.75,0:04:13.75,Default,,0,0,0,,Сынақшының күлі
Dialogue: 0,0:04:13.75,0:04:16.75,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:04:16.75,0:04:21.76,Default,,0,0,0,,Неге еліктейсің, Адонис? Осындай нәрсені әкеліңіз!
Dialogue: 0,0:04:21.76,0:04:24.76,Default,,0,0,0,,Мына ақымақ...
Dialogue: 0,0:04:24.76,0:04:27.76,Default,,0,0,0,,Сізді күтуде
Dialogue: 0,0:04:31.77,0:04:33.77,Default,,0,0,0,,жиі
Dialogue: 0,0:04:33.77,0:04:37.77,Default,,0,0,0,,Сіз оны әлі тапмадыңыз ба? (Дін қызметкері) Кешіріңіз.
Dialogue: 0,0:04:37.77,0:04:39.78,Default,,0,0,0,,Қылыш тобына жауаптылардан басқа кез келген адам
Dialogue: 0,0:04:39.78,0:04:42.78,Default,,0,0,0,,Осы миссияға барлық діни қызметкерлерді тағайындаңыз.
Dialogue: 0,0:04:42.78,0:04:44.78,Default,,0,0,0,,Га
Dialogue: 0,0:04:44.78,0:04:47.78,Default,,0,0,0,,《Қара уақыт, қара бағыт》
Dialogue: 0,0:04:47.78,0:04:52.79,Default,,0,0,0,,《Сенбеймін, қамалда тұратын біздер оны таба алмай жатырмыз...》
Dialogue: 0,0:04:52.79,0:04:57.79,Default,,0,0,0,,《Бірақ оны тапқаннан кейін не болады? Мен жолдың кілтін сындырамын ба? 》
Dialogue: 0,0:04:57.79,0:04:59.80,Default,,0,0,0,,《Не үшін...》
Dialogue: 0,0:04:59.80,0:05:01.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.80,0:05:03.80,Default,,0,0,0,,Адонис Сіз қазір қозғала аласыз ба?
Dialogue: 0,0:05:03.80,0:05:05.80,Default,,0,0,0,,Әлі бес минут қалды.
Dialogue: 0,0:05:05.80,0:05:08.80,Default,,0,0,0,,Мен Белл туралы бәрін саған қалдырдым.
Dialogue: 0,0:05:08.80,0:05:10.81,Default,,0,0,0,,Бұл қиын рөл болса керек...
Dialogue: 0,0:05:10.81,0:05:12.81,Default,,0,0,0,,Сәлем Гафф
Dialogue: 0,0:05:12.81,0:05:15.81,Default,,0,0,0,,Катакомб қылышын патшаның жерлеуіне әкеле аласыз ба?
Dialogue: 0,0:05:15.81,0:05:17.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:17.81,0:05:20.82,Default,,0,0,0,,Мен оның орнына інім патшаны қабылдай аламын.
Dialogue: 0,0:05:20.82,0:05:23.82,Default,,0,0,0,,Мырза, сіз қылышты қайтаруды жоспарлап отырсыз ба?
Dialogue: 0,0:05:23.82,0:05:26.82,Default,,0,0,0,,Осы уақытқа дейін ұрланған барлық қылыштар
Dialogue: 0,0:05:26.82,0:05:31.83,Default,,0,0,0,,Болуы мүмкін, мен бұл елге осылай дедім.
Dialogue: 0,0:05:31.83,0:05:34.83,Default,,0,0,0,,Бұл сіздің соңғы күмәніңізді сұрауға мүмкіндік береді.
Dialogue: 0,0:05:34.83,0:05:37.83,Default,,0,0,0,,Мен мұндай нәрсені кешіре аламын деп ойлайсыз ба?
Dialogue: 0,0:05:37.83,0:05:40.84,Default,,0,0,0,,Мен сіздің скептицизміңізді қабылдаймын.
Dialogue: 0,0:05:40.84,0:05:43.84,Default,,0,0,0,,Тәртіптің күңгірт жағын түсініңіз.
Dialogue: 0,0:05:43.84,0:05:48.84,Default,,0,0,0,,Сіз сенімді боласыз және жарқыраған бөліктің даңқына бөлене аласыз.
Dialogue: 0,0:06:00.86,0:06:02.86,Default,,0,0,0,,Сіз бұзылмайтынсыз ба?
Dialogue: 0,0:06:02.86,0:06:04.86,Default,,0,0,0,,Ах
Dialogue: 0,0:06:08.36,0:06:13.37,Default,,0,0,0,,Шерри ханшайым, күн сайын сауығу туралы ән айтудан шаршағаныңызға сенімдімін.
Dialogue: 0,0:06:13.37,0:06:17.37,Default,,0,0,0,,Неліктен Беллмен соғыстың?
Dialogue: 0,0:06:17.37,0:06:21.38,Default,,0,0,0,,Егер біреу Беллді түрмеге отырғызу керек болса
Dialogue: 0,0:06:21.38,0:06:23.38,Default,,0,0,0,,Мұны істейтін менмін.
Dialogue: 0,0:06:23.38,0:06:26.38,Default,,0,0,0,,Неліктен Белл екеуің төбелесулерің керек?
Dialogue: 0,0:06:26.38,0:06:28.38,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,0:06:28.38,0:06:31.39,Default,,0,0,0,,Хахаха хахахаха
Dialogue: 0,0:06:31.39,0:06:33.39,Default,,0,0,0,,Сен маған ұқсайсың
Dialogue: 0,0:06:33.39,0:06:35.39,Default,,0,0,0,,Алдамаңыз! Хахахахахаха...!
Dialogue: 0,0:06:35.39,0:06:38.39,Default,,0,0,0,,Сіз Беллдің сезімі туралы ойладыңыз ба?
Dialogue: 0,0:06:38.39,0:06:41.40,Default,,0,0,0,,Ахахаха хахаха
Dialogue: 0,0:06:41.40,0:06:43.40,Default,,0,0,0,,Мен тоқтай алмаймын!
Dialogue: 0,0:06:43.40,0:06:45.40,Default,,0,0,0,,Неге күлесің? Уууу...
Dialogue: 0,0:06:45.40,0:06:49.40,Default,,0,0,0,,Өкініштісі, мен осындаймын.
Dialogue: 0,0:06:49.40,0:06:55.41,Default,,0,0,0,,Сіз... Беллмен күрескеніңізге өкінесіз бе?
Dialogue: 0,0:06:55.41,0:06:59.41,Default,,0,0,0,,Өкініп, жыла алсам, бәрібір өзімді жақсы сезінемін.
Dialogue: 0,0:06:59.41,0:07:01.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:01.42,0:07:05.42,Default,,0,0,0,,Сіз тек Құдайға деген күмәніңізді маған көрсетіп жатырсыз.
Dialogue: 0,0:07:05.42,0:07:07.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:07.42,0:07:12.43,Default,,0,0,0,,Мен сен маған берген илаһи хабар бойынша Беллге қарсы күрестім.
Dialogue: 0,0:07:12.43,0:07:16.43,Default,,0,0,0,,Аузыңды жап! Мен бұл туралы енді айтқым келмейді.
Dialogue: 0,0:07:16.43,0:07:19.43,Default,,0,0,0,,А...
Dialogue: 0,0:07:19.43,0:07:23.44,Default,,0,0,0,,...
Dialogue: 0,0:07:23.44,0:07:25.44,Default,,0,0,0,,...
Dialogue: 0,0:07:25.44,0:07:27.44,Default,,0,0,0,,...
Dialogue: 0,0:07:27.44,0:07:30.45,Default,,0,0,0,,...
Dialogue: 0,0:07:30.45,0:07:32.45,Default,,0,0,0,,Не!
Dialogue: 0,0:07:32.45,0:07:34.45,Default,,0,0,0,,...
Dialogue: 0,0:07:34.45,0:07:36.45,Default,,0,0,0,,Жібер!
