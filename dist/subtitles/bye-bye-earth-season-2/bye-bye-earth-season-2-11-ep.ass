Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,Мен... тамырымды білгім келеді!
Dialogue: 0,0:00:03.00,0:00:06.00,Default,,0,0,0,,《Осы тастардың бірінен жас мен пайда болды》
Dialogue: 0,0:00:06.00,0:00:09.00,Default,,0,0,0,,《Мен енді ештеңе қия алмайтыныма сенбеймін...》
Dialogue: 0,0:00:09.00,0:00:11.01,Default,,0,0,0,,Іздегеніңді таптың ба?
Dialogue: 0,0:00:11.01,0:00:14.01,Default,,0,0,0,,Мен ішімде әйелдің ұйықтап жатқанын сеземін.
Dialogue: 0,0:00:14.01,0:00:16.01,Default,,0,0,0,,Сен өлесің бе? Сіз өлесіз бе?
Dialogue: 0,0:00:16.51,0:00:18.51,Default,,0,0,0,,Бұл менің қарғысым
Dialogue: 0,0:00:18.51,0:00:20.52,Default,,0,0,0,,Менімен саяхатыңыздың есігін ашыңыз
Dialogue: 0,0:00:20.52,0:00:22.52,Default,,0,0,0,,Мен сенің әкеңнің қылышын ұстаймын.
Dialogue: 0,0:00:22.52,0:00:24.52,Default,,0,0,0,,Қоңырауға көмектесіңіз!
Dialogue: 0,0:00:24.52,0:00:26.52,Default,,0,0,0,,《Құдай ағашы семсершіні жеп жатыр》
Dialogue: 0,0:00:27.02,0:00:29.02,Default,,0,0,0,,Жоқ, әлі жоқ...
Dialogue: 0,0:00:29.02,0:00:31.03,Default,,0,0,0,,Мен бұлай болатынын білдім.
Dialogue: 0,0:00:31.03,0:00:33.03,Default,,0,0,0,,Біз әлі ғашық болған жоқпыз.
Dialogue: 0,0:00:33.03,0:00:36.03,Default,,0,0,0,,Менен басқа сені әйел ретінде көретін адам бар ма?
Dialogue: 0,0:00:36.03,0:00:39.03,Default,,0,0,0,,Бізге ақылға күмәнмен қарайтын адам керек.
Dialogue: 0,0:00:39.03,0:00:42.04,Default,,0,0,0,,Парасатты қыз – Құдайдың...
Dialogue: 0,0:00:44.04,0:00:49.04,Default,,0,0,0,,(Аштық альянсының ыңырануы)
Dialogue: 0,0:00:53.05,0:00:58.05,Default,,0,0,0,,Аға, сен маған қарағанда әлдеқайда көп директорсың.
Dialogue: 0,0:00:58.05,0:01:02.06,Default,,0,0,0,,Өйткені менің қарғысымның пішіні оны солай етеді.
Dialogue: 0,0:01:02.06,0:01:07.06,Default,,0,0,0,,Себебі мені де себебін білуге жіберген...
Dialogue: 0,0:01:07.06,0:01:14.07,Default,,0,0,0,,Скептицизмге жауап ретінде ақыл-ой шынымен үміт бола ала ма?
Dialogue: 0,0:01:14.07,0:01:16.07,Default,,0,0,0,,Дүниедегі барлық себептер бойынша
Dialogue: 0,0:01:16.07,0:01:19.07,Default,,0,0,0,,Құсты торға қайта салуға болмайды
Dialogue: 0,0:01:19.07,0:01:21.08,Default,,0,0,0,,Оның сағынышы
Dialogue: 0,0:01:21.08,0:01:25.08,Default,,0,0,0,,Бұл дүние жаншылғанша
Dialogue: 0,0:01:25.08,0:01:28.08,Default,,0,0,0,,Онин, сен қауіптісің.
Dialogue: 0,0:01:28.08,0:01:32.09,Default,,0,0,0,,Өз үміті үшін көп нәрсені құрбан ету
Dialogue: 0,0:01:32.09,0:01:35.09,Default,,0,0,0,,Мен тіпті үмітті өлтіруді құптаймын.
Dialogue: 0,0:01:35.09,0:01:39.09,Default,,0,0,0,,Өлуің керек еді
Dialogue: 0,0:01:39.09,0:01:44.10,Default,,0,0,0,,Ақылдың қызы мені кесіп тастағанда өлуім керек еді.
Dialogue: 0,0:01:44.10,0:01:48.10,Default,,0,0,0,,Басқа айтар сөзім жоқ.
Dialogue: 0,0:01:48.10,0:01:50.11,Default,,0,0,0,,Келесі жолы кездесеміз
Dialogue: 0,0:01:50.11,0:01:52.11,Default,,0,0,0,,Сынаушының күлін қабылдау және қабылдау
Dialogue: 0,0:01:52.11,0:01:54.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:00.12,0:02:02.12,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:08.12,0:02:11.13,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:02:11.13,0:02:14.13,Default,,0,0,0,,《Бұл қай жер?》
Dialogue: 0,0:02:14.13,0:02:17.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:17.13,0:02:20.14,Default,,0,0,0,,(ﾉｯｸ)
Dialogue: 0,0:02:22.14,0:02:24.14,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:02:30.15,0:02:34.15,Default,,0,0,0,,《Мен мұнда не үшін келдім? 》
Dialogue: 0,0:02:34.15,0:02:36.15,Default,,0,0,0,,)
Dialogue: 0,0:02:37.15,0:02:40.16,Default,,0,0,0,,)
Dialogue: 0,0:02:40.16,0:02:43.16,Default,,0,0,0,,Кесу мүмкін емес
Dialogue: 0,0:02:46.16,0:02:48.16,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:02:48.16,0:02:50.17,Default,,0,0,0,,Бұл Беннетт, Белл.
Dialogue: 0,0:02:50.17,0:02:52.17,Default,,0,0,0,,Мен саған қонаққа келдім.
Dialogue: 0,0:02:52.17,0:02:54.17,Default,,0,0,0,,Қаласаңыз, маған кіруге рұқсат бере аласыз ба?
Dialogue: 0,0:02:54.17,0:02:56.17,Default,,0,0,0,,)
Dialogue: 0,0:02:56.17,0:02:58.17,Default,,0,0,0,,Мен оны кесіп аламын
Dialogue: 0,0:03:00.18,0:03:02.18,Default,,0,0,0,,Қоңырау?
Dialogue: 0,0:03:03.18,0:03:05.18,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:05.18,0:03:08.18,Default,,0,0,0,,Уф... 《Тоқта, Бенедиктин》
Dialogue: 0,0:03:08.18,0:03:10.19,Default,,0,0,0,,《Неге бізге мұндай дәрежеге бару керек?》
Dialogue: 0,0:03:10.19,0:03:14.19,Default,,0,0,0,,《Бұл су тайпасының тағдыры, Беннет》
Dialogue: 0,0:03:14.19,0:03:16.19,Default,,0,0,0,,)
Dialogue: 0,0:03:16.19,0:03:19.19,Default,,0,0,0,,((Сосын ол өледі))
Dialogue: 0,0:03:19.19,0:03:23.20,Default,,0,0,0,,((Су перісі, физикалық жарақат және эмоционалды тыртықтар
Dialogue: 0,0:03:23.20,0:03:27.20,Default,,0,0,0,,Сіз ерлер мен әйелдердің қарым-қатынасы туралы ойланып көрдіңіз бе? ))
Dialogue: 0,0:03:27.20,0:03:30.21,Default,,0,0,0,,《Жарық... Тіпті қасиетті күл де оны емдей алмайды》
Dialogue: 0,0:03:30.21,0:03:32.21,Default,,0,0,0,,《Сізге бәрібір ме?》
Dialogue: 0,0:03:32.21,0:03:34.21,Default,,0,0,0,,《Мен неге күшті болдым?》
Dialogue: 0,0:03:34.21,0:03:36.21,Default,,0,0,0,,《Осы себепті》
Dialogue: 0,0:03:36.21,0:03:41.22,Default,,0,0,0,,《Осы сәт болмаса, бұл күш... мағынасыз! 》
Dialogue: 0,0:03:41.22,0:03:43.22,Default,,0,0,0,,Қоңырау!
Dialogue: 0,0:03:45.22,0:03:47.22,Default,,0,0,0,,Хмм... кім?
Dialogue: 0,0:03:47.22,0:03:51.23,Default,,0,0,0,,Бұл менмін, тез ашыңызшы.
Dialogue: 0,0:03:51.23,0:03:55.23,Default,,0,0,0,,Мен сені көру үшін жол бойы келдім.
Dialogue: 0,0:03:56.23,0:03:59.23,Default,,0,0,0,,Хехе Бенедиктин!
Dialogue: 0,0:03:59.23,0:04:01.24,Default,,0,0,0,,Сенің көздерің...
Dialogue: 0,0:04:01.24,0:04:04.24,Default,,0,0,0,,Керемет көрініс
Dialogue: 0,0:04:04.24,0:04:07.24,Default,,0,0,0,,Сен неге...
Dialogue: 0,0:04:07.24,0:04:10.25,Default,,0,0,0,,Мынау қандай сұмдық бөлме?
Dialogue: 0,0:04:10.25,0:04:13.25,Default,,0,0,0,,Науқастарды зиярат ету сондықтан...
Dialogue: 0,0:04:13.25,0:04:15.25,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:04:15.25,0:04:18.25,Default,,0,0,0,,Мен сені өлді деп ойладым
Dialogue: 0,0:04:18.25,0:04:20.26,Default,,0,0,0,,Менің шашым да, бәрі де бейберекет.
Dialogue: 0,0:04:20.26,0:04:23.26,Default,,0,0,0,,Сонда сіз оны біреуге көрсеткіңіз келе ме?
Dialogue: 0,0:04:23.26,0:04:28.26,Default,,0,0,0,,Сіз, ер адам, келгенде, мен болдым...
Dialogue: 0,0:04:28.26,0:04:31.27,Default,,0,0,0,,Себебі мен қарызымды өтеген жоқпын.
Dialogue: 0,0:04:32.27,0:04:34.27,Default,,0,0,0,,Сіз Гордонды кесіп тастадыңыз
Dialogue: 0,0:04:34.27,0:04:39.27,Default,,0,0,0,,Жүрегімнің қарғысынан босатқаным үшін
Dialogue: 0,0:04:39.27,0:04:41.28,Default,,0,0,0,,Өзіңізге дұрыс күтім жасаңыз
Dialogue: 0,0:04:41.28,0:04:44.28,Default,,0,0,0,,Өйткені шашың жібек жіп сияқты.
Dialogue: 0,0:04:47.28,0:04:50.29,Default,,0,0,0,,Міне, сіздің сүйікті Meissen шайы.
Dialogue: 0,0:04:50.29,0:04:53.29,Default,,0,0,0,,Демитас шайы қазір маусымда.
Dialogue: 0,0:04:56.79,0:04:59.80,Default,,0,0,0,,Саған ешнәрсе жоқ
Dialogue: 0,0:04:59.80,0:05:02.80,Default,,0,0,0,,Мен оның қиналғанын түсіне алмадым.
Dialogue: 0,0:05:02.80,0:05:07.80,Default,,0,0,0,,Сонда да мені түсінуге тырысамын
Dialogue: 0,0:05:07.80,0:05:10.81,Default,,0,0,0,,Мен оны өзіммен толтыруға тырыстым.
Dialogue: 0,0:05:10.81,0:05:12.81,Default,,0,0,0,,Бұл онымен бірдей емес.
Dialogue: 0,0:05:12.81,0:05:15.81,Default,,0,0,0,,Әлгі жігіт әлдеқайда нашар.
Dialogue: 0,0:05:16.81,0:05:19.82,Default,,0,0,0,,Маған күшті Адонис ұнайды
Dialogue: 0,0:05:19.82,0:05:23.82,Default,,0,0,0,,Әлсіз Адонисті көру мені мазасыздандырады.
Dialogue: 0,0:05:23.82,0:05:27.82,Default,,0,0,0,,Әлсіз Адонис маған көмектеспейді.
Dialogue: 0,0:05:27.82,0:05:29.83,Default,,0,0,0,,Оның әлсіздігін түсінгеннен кейін
Dialogue: 0,0:05:29.83,0:05:33.83,Default,,0,0,0,,Мен мықты Адонистен айырылатыныма сенімдімін.
Dialogue: 0,0:05:33.83,0:05:37.83,Default,,0,0,0,,Сондықтан маған ұнамады. Түсінгім келмеді.
Dialogue: 0,0:05:37.83,0:05:40.84,Default,,0,0,0,,Мен бұған жол бергенше, сені өлтіргенім артық.
Dialogue: 0,0:05:40.84,0:05:43.84,Default,,0,0,0,,Сонда сен сол күшті Адонис боласың.
Dialogue: 0,0:05:43.84,0:05:46.84,Default,,0,0,0,,Сіз не күттіңіз?
Dialogue: 0,0:05:46.84,0:05:48.84,Default,,0,0,0,,Сондай қорқақ, қорқақ адамға.
Dialogue: 0,0:05:48.84,0:05:50.85,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:05:50.85,0:05:54.85,Default,,0,0,0,,Мен сені әлсіз болсаң да жақсы көремін, иә?
Dialogue: 0,0:05:54.85,0:05:57.85,Default,,0,0,0,,Шын жүректен мен жай ғана қарап шығуым керек сияқты.
Dialogue: 0,0:05:57.85,0:05:59.86,Default,,0,0,0,,Бұл сергітеді.
Dialogue: 0,0:05:59.86,0:06:01.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:01.86,0:06:03.86,Default,,0,0,0,,Неліктен жиіркенішті адамға ұнайды?
Dialogue: 0,0:06:03.86,0:06:06.86,Default,,0,0,0,,Менімен әрқашан кездескіңіз келетінін білемін.
Dialogue: 0,0:06:06.86,0:06:10.87,Default,,0,0,0,,Мен сенің қасыңда болсам, мен жақсы әйел бола алатынымды сезінемін.
Dialogue: 0,0:06:10.87,0:06:13.87,Default,,0,0,0,,Әй, мұнымен не айтқың келеді?
Dialogue: 0,0:06:13.87,0:06:17.87,Default,,0,0,0,,Сіз мені әйел етесіз
Dialogue: 0,0:06:17.87,0:06:22.88,Default,,0,0,0,,Нәсілден үлкен нәрсенің түбінде.
Dialogue: 0,0:06:22.88,0:06:24.88,Default,,0,0,0,,Маған қара
Dialogue: 0,0:06:24.88,0:06:26.88,Default,,0,0,0,,Сен әдемісің.
Dialogue: 0,0:06:26.88,0:06:29.89,Default,,0,0,0,,ше? (Бенедиктин) Сіз боссыз.
Dialogue: 0,0:06:29.89,0:06:31.89,Default,,0,0,0,,Әрбір нәсілде бар.
Dialogue: 0,0:06:31.89,0:06:34.89,Default,,0,0,0,,Сұлулық пен ұсқынсыздық стандарттарына кедергісіз бола білу
Dialogue: 0,0:06:34.89,0:06:38.89,Default,,0,0,0,,Мен өзімді өте жеңіл және еркін сезінемін.
Dialogue: 0,0:06:38.89,0:06:41.90,Default,,0,0,0,,Күш пен әлсіздік, сұлулық пен ұсқынсыздық
Dialogue: 0,0:06:41.90,0:06:44.90,Default,,0,0,0,,Барлығы сіздің ішіңізде
Dialogue: 0,0:06:44.90,0:06:47.90,Default,,0,0,0,,Барлығы оған қол тигізу үшін өледі.
Dialogue: 0,0:06:47.90,0:06:49.91,Default,,0,0,0,,Сонда да сен гүлсің.
Dialogue: 0,0:06:49.91,0:06:53.91,Default,,0,0,0,,Менің не ойлағанымды білмегендей, өзі гүлдеп тұр.
Dialogue: 0,0:06:53.91,0:06:55.91,Default,,0,0,0,,Ең болмағанда көңілсіз, қураған жерге қарашы.
Dialogue: 0,0:06:55.91,0:06:58.91,Default,,0,0,0,,Мен қарап шығуым керек.
Dialogue: 0,0:06:58.91,0:07:03.92,Default,,0,0,0,,Егер сіз осылай айтсам, мен не істеуім керек...
Dialogue: 0,0:07:03.92,0:07:07.92,Default,,0,0,0,,Мен Адонистен менімен бірге саяхатқа шығуын өтіндім.
Dialogue: 0,0:07:07.92,0:07:10.93,Default,,0,0,0,,Себебі мен жалғыз болдым
Dialogue: 0,0:07:10.93,0:07:15.93,Default,,0,0,0,,Мен ол жерден қашып кеткім келді, сондықтан мен оны құрбандыққа шалуға тырыстым.
Dialogue: 0,0:07:15.93,0:07:18.93,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:07:18.93,0:07:21.94,Default,,0,0,0,,Мен сені өзіммен бірге саяхатқа апарсам
Dialogue: 0,0:07:21.94,0:07:26.94,Default,,0,0,0,,Мен оны басқарып, өлтіретініме сенімдімін.
Dialogue: 0,0:07:26.94,0:07:28.94,Default,,0,0,0,,Ол көмек сұрады.
Dialogue: 0,0:07:28.94,0:07:30.95,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:07:30.95,0:07:32.95,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:07:32.95,0:07:34.95,Default,,0,0,0,,Бәріне сен кінәлі дейсің бе?
Dialogue: 0,0:07:34.95,0:07:36.95,Default,,0,0,0,,Ақымаққа ұқсайды
Dialogue: 0,0:07:36.95,0:07:39.96,Default,,0,0,0,,Сіз мұны бұрын өзіңіз айттыңыз.
Dialogue: 0,0:07:39.96,0:07:41.96,Default,,0,0,0,,Нағыз себеп
Dialogue: 0,0:07:41.96,0:07:43.96,Default,,0,0,0,,Нақты себебі? (Бенедикт) Иә.
Dialogue: 0,0:07:43.96,0:07:48.96,Default,,0,0,0,,Неліктен онымен бірге саяхатқа барғың келді?
Dialogue: 0,0:07:48.96,0:07:50.97,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:52.97,0:07:58.97,Default,,0,0,0,,(жылау)
Dialogue: 0,0:07:58.97,0:08:01.98,Default,,0,0,0,,Мен жалғызбын, иә
Dialogue: 0,0:08:01.98,0:08:05.98,Default,,0,0,0,,Жалғыздығым сонша, мен өлетін сияқтымын!
Dialogue: 0,0:08:05.98,0:08:09.99,Default,,0,0,0,,Қорқынышты, қиын, жалғызбын
Dialogue: 0,0:08:09.99,0:08:12.99,Default,,0,0,0,,Саған ешкім көмектеспейді.
Dialogue: 0,0:08:12.99,0:08:17.99,Default,,0,0,0,,Тым болмаса бір адам мені қолдаса жақсы емес пе?
Dialogue: 0,0:08:17.99,0:08:21.00,Default,,0,0,0,,Мені құтқарғаныңыз жақсы емес пе?
Dialogue: 0,0:08:21.00,0:08:25.00,Default,,0,0,0,,Мен неге жалғызбын?
Dialogue: 0,0:08:25.00,0:08:31.01,Default,,0,0,0,,Неге, қанша уақыт өтсе де, мен... бұл...
Dialogue: 0,0:08:31.01,0:08:36.01,Default,,0,0,0,,Мен бұл сағыныш туралы ештеңе істей алмаймын.
Dialogue: 0,0:08:36.01,0:08:41.02,Default,,0,0,0,,Бір күні, бір жерде, біреу маған соны үйретті.
Dialogue: 0,0:08:41.02,0:08:44.02,Default,,0,0,0,,Туған жерімді ойлау...
Dialogue: 0,0:08:44.02,0:08:46.02,Default,,0,0,0,,Утопияны аңсау...
Dialogue: 0,0:08:46.02,0:08:49.02,Default,,0,0,0,,Мен тұрған жерді де, өзімді де сүйе алмаймын...
Dialogue: 0,0:08:49.02,0:08:52.03,Default,,0,0,0,,Мәңгілік адасу
Dialogue: 0,0:08:55.03,0:08:57.03,Default,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:08:57.03,0:09:01.04,Default,,0,0,0,,Жолдың есігі ашылмаған...
Dialogue: 0,0:09:01.04,0:09:06.04,Default,,0,0,0,,Соны ашсаңыз, өзіңізді одан бетер жалғыз сезінесіз.
Dialogue: 0,0:09:06.04,0:09:10.05,Default,,0,0,0,,Неліктен мен өзімді білуге тырысамын
Dialogue: 0,0:09:10.05,0:09:14.05,Default,,0,0,0,,Мен жалғыз қалуым керек сияқты.
Dialogue: 0,0:09:14.05,0:09:16.05,Default,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:09:16.05,0:09:18.05,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:18.05,0:09:22.06,Default,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:09:22.06,0:09:25.06,Default,,0,0,0,,Мен... (Бенедиктин) Қараңызшы.
Dialogue: 0,0:09:26.06,0:09:29.06,Default,,0,0,0,,Мен... жаман емеспін бе?
Dialogue: 0,0:09:29.06,0:09:31.07,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:31.07,0:09:34.07,Default,,0,0,0,,Қане, дұрыстап айт.
Dialogue: 0,0:09:34.07,0:09:37.07,Default,,0,0,0,,Мен қазір жұмыс істеп жатырмын ғой, білесің бе. Мен бос емеспін
Dialogue: 0,0:09:37.07,0:09:40.08,Default,,0,0,0,,Бұл менің кінәм емес! Мен де...
Dialogue: 0,0:09:40.08,0:09:43.08,Default,,0,0,0,,Иә, иә, иә!
Dialogue: 0,0:09:43.08,0:09:47.08,Default,,0,0,0,,Ал сен қайда бара жатырсың?
Dialogue: 0,0:09:47.08,0:09:53.09,Default,,0,0,0,,Мен өзімнің шынайы шығу тегімді іздеп жүрмін... (Бенедикт) Иә.
Dialogue: 0,0:09:53.09,0:09:56.09,Default,,0,0,0,,Осы сағынышпен күресу үшін...
Dialogue: 0,0:09:56.09,0:10:00.10,Default,,0,0,0,,Иә, сіз саяхатқа барасыз.
Dialogue: 0,0:10:00.10,0:10:04.10,Default,,0,0,0,,Бір ғана тақырыбы бар жалғыз адам болыңыз.
Dialogue: 0,0:10:04.10,0:10:06.10,Default,,0,0,0,,Ицумида-сан ба?
Dialogue: 0,0:10:06.10,0:10:10.11,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:10:10.11,0:10:14.11,Default,,0,0,0,,Өйткені бұл өмір сүрудің жалғыз жолы
Dialogue: 0,0:10:15.11,0:10:18.11,Default,,0,0,0,,Мен саяхатқа барамын Иә.
Dialogue: 0,0:10:18.11,0:10:23.12,Default,,0,0,0,,Мен... саяхатшы боламын.
Dialogue: 0,0:10:23.12,0:10:26.12,Default,,0,0,0,,Бар, Белл.
Dialogue: 0,0:10:26.12,0:10:29.12,Default,,0,0,0,,Біздің қолымыздан келетіні – осында қалып, аман қалу.
Dialogue: 0,0:10:29.12,0:10:31.13,Default,,0,0,0,,Амал жоқ болса да
Dialogue: 0,0:10:31.13,0:10:33.13,Default,,0,0,0,,Сіздің саяхатыңыздың соңында не болады
Dialogue: 0,0:10:33.13,0:10:35.13,Default,,0,0,0,,Біз де сенеміз
Dialogue: 0,0:10:35.13,0:10:37.13,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:10:37.13,0:10:40.14,Default,,0,0,0,,Біз бір күні сөйлесеміз
Dialogue: 0,0:10:40.14,0:10:43.14,Default,,0,0,0,,Бірге саяхаттаңыз
Dialogue: 0,0:11:00.16,0:11:03.16,Default,,0,0,0,,А... иә?
Dialogue: 0,0:11:03.16,0:11:05.16,Default,,0,0,0,,Ендеше бастайық
Dialogue: 0,0:11:05.16,0:11:09.16,Default,,0,0,0,,Бізде енді көп уақыт жоқ сияқты.
Dialogue: 0,0:11:13.17,0:11:15.17,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:11:26.18,0:11:31.19,Default,,0,0,0,,♪(ән айту)
Dialogue: 0,0:11:31.19,0:11:33.19,Default,,0,0,0,,♪～
Dialogue: 0,0:11:33.19,0:11:35.19,Default,,0,0,0,,Су перілері
Dialogue: 0,0:11:35.19,0:11:40.20,Default,,0,0,0,,Бұл өзен-көлдерді тазарту үшін айтылатын ән.
Dialogue: 0,0:11:40.20,0:11:43.20,Default,,0,0,0,,Осы нақты материкпен салыстыру
Dialogue: 0,0:11:43.20,0:11:47.20,Default,,0,0,0,,Ұлы Рух мұхиты
Dialogue: 0,0:11:47.20,0:11:52.21,Default,,0,0,0,,Одан шыққан таза тамшы – су перісі.
Dialogue: 0,0:11:54.21,0:11:56.21,Default,,0,0,0,,Басқаның санасында паразиттік болуы керек
Dialogue: 0,0:11:56.21,0:11:59.21,Default,,0,0,0,,Жүректері қалыптаспаған су перілері
Dialogue: 0,0:11:59.21,0:12:03.22,Default,,0,0,0,,Мен ешқашан құтыла алмайтын тағдырды арқалап жүрмін.
Dialogue: 0,0:12:03.22,0:12:07.22,Default,,0,0,0,,Олардың барлығы жеке тұлғаларымен паразиттік болды.
Dialogue: 0,0:12:07.22,0:12:11.23,Default,,0,0,0,,Жүрегіңнің ластығын ал
Dialogue: 0,0:12:11.23,0:12:20.24,Default,,0,0,0,,♪～
Dialogue: 0,0:12:20.24,0:12:22.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:22.24,0:12:27.24,Default,,0,0,0,,♪～
Dialogue: 0,0:12:27.24,0:12:33.25,Default,,0,0,0,,Кір мен таза қан, азап пен қуаныш...
Dialogue: 0,0:12:33.25,0:12:38.25,Default,,0,0,0,,Сіздің жоғалтатын ештеңеңіз жоқ
Dialogue: 0,0:12:38.25,0:12:43.26,Default,,0,0,0,,Тек сол тоқыраулардан құтылу үшін
Dialogue: 0,0:12:43.26,0:12:48.26,Default,,0,0,0,,Мұны сізбен бірге мен ғана білемін...
Dialogue: 0,0:12:48.76,0:12:50.77,Default,,0,0,0,,Олар ақырында
Dialogue: 0,0:12:50.77,0:12:53.77,Default,,0,0,0,,Мұхиттың тереңдігіне оралу
Dialogue: 0,0:12:53.77,0:12:57.77,Default,,0,0,0,,Алынған кірді тазарту кезінде
Dialogue: 0,0:13:00.78,0:13:05.78,Default,,0,0,0,,Мен де тереңге барамын.
Dialogue: 0,0:13:06.78,0:13:11.79,Default,,0,0,0,,Бір-біріміздің саяхатымыз туралы сөйлесетін кез болады...
Dialogue: 0,0:13:15.79,0:13:19.79,Default,,0,0,0,,Қош бол Қоңырау
Dialogue: 0,0:13:19.79,0:13:22.80,Default,,0,0,0,,Қош бол Бенедиктин
Dialogue: 0,0:13:30.81,0:13:32.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:34.81,0:13:37.81,Default,,0,0,0,,Хмм... Қоңырау?
Dialogue: 0,0:13:37.81,0:13:40.82,Default,,0,0,0,,Иә, Беннетт.
Dialogue: 0,0:13:42.82,0:13:44.82,Default,,0,0,0,,Сіздің жараңыз жақсы ма?
Dialogue: 0,0:13:44.82,0:13:46.82,Default,,0,0,0,,Сізге рахмет.
Dialogue: 0,0:13:46.82,0:13:49.82,Default,,0,0,0,,Мен басқа сені құрбан еттім.
Dialogue: 0,0:13:49.82,0:13:52.83,Default,,0,0,0,,Қандай жағдай болмасын, мен сені жақсы сезінемін
Dialogue: 0,0:13:52.83,0:13:57.83,Default,,0,0,0,,Саған көмектесе алатынымды білу мені бақытты етеді.
Dialogue: 0,0:13:57.83,0:14:02.84,Default,,0,0,0,,А... бұл оның кеткен бағасы.
Dialogue: 0,0:14:02.84,0:14:04.84,Default,,0,0,0,,Су перілерінің құлағы бар
Dialogue: 0,0:14:04.84,0:14:07.84,Default,,0,0,0,,Бұрынғыдан онша айырмашылығы жоқ.
Dialogue: 0,0:14:07.84,0:14:09.84,Default,,0,0,0,,Иә
Dialogue: 0,0:14:09.84,0:14:12.85,Default,,0,0,0,,Мен ризамын
Dialogue: 0,0:14:12.85,0:14:14.85,Default,,0,0,0,,Менің ойымша, бұл жаман емес.
Dialogue: 0,0:14:14.85,0:14:17.85,Default,,0,0,0,,Мен сенің осылай айтатыныңа сенімді болдым.
Dialogue: 0,0:14:17.85,0:14:20.86,Default,,0,0,0,,Иә, мен де
Dialogue: 0,0:14:20.86,0:14:22.86,Default,,0,0,0,,Себебі мен саған ризамын
Dialogue: 0,0:14:22.86,0:14:25.86,Default,,0,0,0,,Жыламаймын деп шештім ау
Dialogue: 0,0:14:25.86,0:14:28.86,Default,,0,0,0,,Кешірмеймін деп шештім.
Dialogue: 0,0:14:28.86,0:14:32.87,Default,,0,0,0,,Менің ойымша, бұл жақсы, Белл.
Dialogue: 0,0:14:32.87,0:14:34.87,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:34.87,0:14:36.87,Default,,0,0,0,,Иә
Dialogue: 0,0:14:39.87,0:14:41.88,Default,,0,0,0,,Ах... Сәлем Гиннес
Dialogue: 0,0:14:41.88,0:14:44.88,Default,,0,0,0,,Сәлемдесу Қоңырау Қайырлы таң
Dialogue: 0,0:14:44.88,0:14:47.88,Default,,0,0,0,,Уау, мен әлі ес жиған жоқпын.
Dialogue: 0,0:14:47.88,0:14:51.89,Default,,0,0,0,,Эй, сен не үшін бара жатқаныңды білесің бе?
Dialogue: 0,0:14:51.89,0:14:54.89,Default,,0,0,0,,Жерлеу рәсіміне дейін бас иемін.
Dialogue: 0,0:14:54.89,0:14:59.89,Default,,0,0,0,,Ах... Гиннеске де өлім құсы туралы хабар келді.
Dialogue: 0,0:14:59.89,0:15:01.90,Default,,0,0,0,,О
Dialogue: 0,0:15:01.90,0:15:06.90,Default,,0,0,0,,Джимбек... Мен сағынған адамымнан айырылдым.
Dialogue: 0,0:15:12.91,0:15:14.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:22.92,0:15:24.92,Default,,0,0,0,,Тұман! (Тұман) Хмм...
Dialogue: 0,0:15:24.92,0:15:26.92,Default,,0,0,0,,Естімеген.
Dialogue: 0,0:15:26.92,0:15:30.93,Default,,0,0,0,,Топ ит Андердогты жерлеуге келеді.
Dialogue: 0,0:15:30.93,0:15:35.93,Default,,0,0,0,,Мен сол атақты дирижерге қарыздармын.
Dialogue: 0,0:15:35.93,0:15:45.94,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:45.94,0:15:47.94,Default,,0,0,0,,Олардың біреуі дәл осы жерде есінен танып қалды.
Dialogue: 0,0:15:47.94,0:15:49.94,Default,,0,0,0,,Жара туралы не деуге болады? Ах...
Dialogue: 0,0:15:49.94,0:15:53.95,Default,,0,0,0,,Бұл жеткілікті ме? Жарайды, сен маған ұсқынсыз нәрсе көрсеттің.
Dialogue: 0,0:15:53.95,0:15:56.95,Default,,0,0,0,,Мұндағы 10-нан астам адамның қылыштары сынған.
Dialogue: 0,0:15:56.95,0:15:58.95,Default,,0,0,0,,Бұл құбыжық.
Dialogue: 0,0:15:58.95,0:16:01.96,Default,,0,0,0,,А, мен мұны жаман мағынада айтып тұрған жоқпын.
Dialogue: 0,0:16:01.96,0:16:04.96,Default,,0,0,0,,Өйткені бұл шынымен де керемет деп ойлаймын.
Dialogue: 0,0:16:04.96,0:16:08.96,Default,,0,0,0,,Катакомбалардағы төбелес кезінде де салқын көріндіңіз.
Dialogue: 0,0:16:08.96,0:16:11.97,Default,,0,0,0,,Әй, сол кезде
Dialogue: 0,0:16:11.97,0:16:15.97,Default,,0,0,0,,Мен Тицианды өлтіргенде бітті деп ойладым.
Dialogue: 0,0:16:15.97,0:16:20.98,Default,,0,0,0,,Сен күресе бергенде, мен надан болып қалдым.
Dialogue: 0,0:16:20.98,0:16:24.98,Default,,0,0,0,,Білсең, соғысар ма едің?
Dialogue: 0,0:16:24.98,0:16:30.99,Default,,0,0,0,,А... Мен дұрыс пен бұрыстың екі жағында емеспін.
Dialogue: 0,0:16:30.99,0:16:33.99,Default,,0,0,0,,Нені кесуге болады және нені кесуге болмайды?
Dialogue: 0,0:16:33.99,0:16:36.99,Default,,0,0,0,,Сіз оны шынымен кесіп алмайынша білмейсіз
Dialogue: 0,0:16:36.99,0:16:42.00,Default,,0,0,0,,Сондықтан ол шынымен де өлтіруге лайық адамды өлтіру үшін күреседі.
Dialogue: 0,0:16:42.00,0:16:44.00,Default,,0,0,0,,Бұл саяхаттау қарғысы.
Dialogue: 0,0:16:44.00,0:16:47.00,Default,,0,0,0,,Сіз білесіз бе? Мен Гиннестен естідім.
Dialogue: 0,0:16:47.00,0:16:50.00,Default,,0,0,0,,Хмм, а... өйткені
Dialogue: 0,0:16:50.00,0:16:53.01,Default,,0,0,0,,Ол Зимбек мырзаны көруге келді.
Dialogue: 0,0:16:53.01,0:16:57.01,Default,,0,0,0,,Сіз бұл адамсыз ба, Адонис?
Dialogue: 0,0:16:57.01,0:16:59.01,Default,,0,0,0,,А... неге менімен бірге емессің?
Dialogue: 0,0:16:59.01,0:17:02.02,Default,,0,0,0,,Мен сізді тіпті бірге саяхатқа баруға уәде бергеніңізді естідім.
Dialogue: 0,0:17:02.02,0:17:05.02,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:17:05.02,0:17:07.02,Default,,0,0,0,,«Оның аман-есен жетуін қамтамасыз етші.»
Dialogue: 0,0:17:07.02,0:17:09.02,Default,,0,0,0,,Ха... Маған шабуыл жасалды.
Dialogue: 0,0:17:09.02,0:17:11.03,Default,,0,0,0,,Сіз…
Dialogue: 0,0:17:11.03,0:17:14.03,Default,,0,0,0,,Жарайды, көп нәрсе болды, бірақ нәтиже болмады.
Dialogue: 0,0:17:14.03,0:17:18.03,Default,,0,0,0,,Ха... Бірақ ол жоқ.
Dialogue: 0,0:17:18.03,0:17:22.04,Default,,0,0,0,,Қайта кездесіп, сөйлесер болсақ та, қайдасың...
Dialogue: 0,0:17:22.04,0:17:25.04,Default,,0,0,0,,Мұндай менсінбейтін адамды ұмыт.
Dialogue: 0,0:17:25.04,0:17:27.04,Default,,0,0,0,,Мені кесіп тастайтын шығарсың деп ойладым.
Dialogue: 0,0:17:27.04,0:17:30.04,Default,,0,0,0,,Бұл жасырын. Мүмкін.
Dialogue: 0,0:17:30.04,0:17:33.05,Default,,0,0,0,,Мен де оны тапқан бойда оны кесіп тастауды жоспарладым.
Dialogue: 0,0:17:33.05,0:17:35.05,Default,,0,0,0,,Хаха…
Dialogue: 0,0:17:42.06,0:17:44.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:45.06,0:17:47.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:49.06,0:17:52.07,Default,,0,0,0,,Ол кездегі обсерваторияға ұқсайды.
Dialogue: 0,0:17:58.07,0:18:00.07,Default,,0,0,0,,Катакомба... (Джин) Иә.
Dialogue: 0,0:18:00.07,0:18:04.08,Default,,0,0,0,,Бұл Коллинздер деп аталатын отбасы сарайларының бірі.
Dialogue: 0,0:18:04.08,0:18:08.08,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,0:18:08.08,0:18:10.08,Default,,0,0,0,,Гиннес?
Dialogue: 0,0:18:15.09,0:18:20.09,Default,,0,0,0,,(Өлім құсының сайрауы)
Dialogue: 0,0:18:26.60,0:18:29.60,Default,,0,0,0,,Тендо зиратындай...
Dialogue: 0,0:18:31.61,0:18:34.61,Default,,0,0,0,,Қоңырау а... а
Dialogue: 0,0:18:43.62,0:18:46.62,Default,,0,0,0,,Менің атым полковник Коллинз.
Dialogue: 0,0:18:46.62,0:18:49.62,Default,,0,0,0,,Мен осы жерлеу рәсімінің қызметкерімін.
Dialogue: 0,0:18:49.62,0:18:52.63,Default,,0,0,0,,Коллинз катакомбаны білдіреді...
Dialogue: 0,0:18:52.63,0:18:54.63,Default,,0,0,0,,Иә
Dialogue: 0,0:18:54.63,0:18:58.63,Default,,0,0,0,,Алтын өгіз ғибадатханасын қорғайтын бас діни қызметкер ретінде мен сізді қарсы аламын.
Dialogue: 0,0:18:58.63,0:19:00.64,Default,,0,0,0,,Торус?
Dialogue: 0,0:19:00.64,0:19:05.64,Default,,0,0,0,,Бұл катакомбаның төрт тұрақты белгісінің бірі.
Dialogue: 0,0:19:05.64,0:19:10.65,Default,,0,0,0,,Сен қорғаған арыстанның құрсағында соның бірі.
Dialogue: 0,0:19:10.65,0:19:12.65,Default,,0,0,0,,Ловерак Белл-доно
Dialogue: 0,0:19:12.65,0:19:15.65,Default,,0,0,0,,Сол шайқасқа қатысты, Коллинз атынан.
Dialogue: 0,0:19:15.65,0:19:17.65,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:19:17.65,0:19:19.65,Default,,0,0,0,,Жарайды, біз де солай.
Dialogue: 0,0:19:19.65,0:19:22.66,Default,,0,0,0,,Мен аман қалу үшін күрестім...
Dialogue: 0,0:19:22.66,0:19:25.66,Default,,0,0,0,,Ал сол кезде, ең жоғарғы ит ретінде...
Dialogue: 0,0:19:25.66,0:19:27.66,Default,,0,0,0,,Жоқ, сіз шынымен солайсыз
Dialogue: 0,0:19:27.66,0:19:32.67,Default,,0,0,0,,Бұл шайқас топ ит пен бейтарап ит арасындағы айырмашылықтан асып түсті.
Dialogue: 0,0:19:32.67,0:19:35.67,Default,,0,0,0,,Біздің идеалды болмысымызда
Dialogue: 0,0:19:35.67,0:19:38.67,Default,,0,0,0,,Танысқаныма қуаныштымын, Карнелл-Коллинз.
Dialogue: 0,0:19:38.67,0:19:42.68,Default,,0,0,0,,Сіз Гиннессіз бе? (Гиннес) Иә
Dialogue: 0,0:19:42.68,0:19:46.68,Default,,0,0,0,,Мен Джимбектің көзі тірісінде көп нәрсені естідім.
Dialogue: 0,0:19:46.68,0:19:50.69,Default,,0,0,0,,Алдыңғы шайқаста катакомбаларды өртеп жіберген адам ретінде.
Dialogue: 0,0:19:50.69,0:19:53.69,Default,,0,0,0,,Мен сенімен бір рет кездескім келді.
Dialogue: 0,0:19:53.69,0:19:56.69,Default,,0,0,0,,Бұлай айту мүмкін емес.
Dialogue: 0,0:19:56.69,0:19:58.69,Default,,0,0,0,,Мұны біз де мойындаймыз
Dialogue: 0,0:19:58.69,0:20:03.70,Default,,0,0,0,,Біз алғыс айтуымыз керек және ешқашан жек көрмеуіміз керек.
Dialogue: 0,0:20:03.70,0:20:05.70,Default,,0,0,0,,Айтпақшы, Джинбак-доно арқылы
Dialogue: 0,0:20:05.70,0:20:09.70,Default,,0,0,0,,Мен сіздің отбасыңыз туралы бірнеше рет өсек естідім.
Dialogue: 0,0:20:09.70,0:20:11.71,Default,,0,0,0,,Ол келді
Dialogue: 0,0:20:11.71,0:20:15.71,Default,,0,0,0,,Маған оқу өте қызықты болды.
Dialogue: 0,0:20:16.71,0:20:19.71,Default,,0,0,0,,Олай болса барлығың дайындалыңдар.
Dialogue: 0,0:20:20.72,0:20:22.72,Default,,0,0,0,,Импульс
Dialogue: 0,0:20:23.72,0:20:28.72,Default,,0,0,0,,Енді жерлеу рәсімі өтеді.
Dialogue: 0,0:20:32.73,0:20:35.73,Default,,0,0,0,,《Ол шынымен өлді》
Dialogue: 0,0:21:16.77,0:21:19.77,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:21:19.77,0:21:23.78,Default,,0,0,0,,Бұл ирониялық, солай емес пе?
Dialogue: 0,0:21:23.78,0:21:26.78,Default,,0,0,0,,Біздің аман қалуымыз үшін
Dialogue: 0,0:21:26.78,0:21:29.78,Default,,0,0,0,,Мен Катакомба бағын өртеп жібердім.
Dialogue: 0,0:21:29.78,0:21:33.79,Default,,0,0,0,,Енді осында жерленгенсің,
Dialogue: 0,0:21:33.79,0:21:38.79,Default,,0,0,0,,Күнәң кешіріледі дейсің бе?
Dialogue: 0,0:21:38.79,0:21:42.80,Default,,0,0,0,,Джинбак мырза, мен жаңа сценарий жазамын.
Dialogue: 0,0:21:42.80,0:21:45.80,Default,,0,0,0,,Мен саған тағы келдім.
Dialogue: 0,0:21:45.80,0:21:49.80,Default,,0,0,0,,Жаңа адамдардың болашақ жағдайы...
Dialogue: 0,0:21:49.80,0:21:54.81,Default,,0,0,0,,Қылыштардың еліндегі жұмақ ауысуы
Dialogue: 0,0:22:00.31,0:22:19.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:19.33,0:22:32.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:32.35,0:22:37.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:37.35,0:22:52.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:52.37,0:22:57.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:57.37,0:23:02.38,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:02.38,0:23:10.38,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:10.38,0:23:30.40,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:30.40,0:23:32.41,Default,,0,0,0,,Қарға гүлі дегеніміз не?
Dialogue: 0,0:23:32.41,0:23:34.41,Default,,0,0,0,,Өйткені бұл Мастер Джимбектің еркі болатын.
Dialogue: 0,0:23:34.41,0:23:36.41,Default,,0,0,0,,Мені сол петицияға қосыңыз.
Dialogue: 0,0:23:36.41,0:23:39.41,Default,,0,0,0,,Соңғы сөздеріңді айтайын
Dialogue: 0,0:23:40.91,0:23:46.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory