Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.54,0:00:05.55,Default,,0,0,0,,《Мен күштің ұшып кеткенін қалаймын》
Dialogue: 0,0:00:05.55,0:00:10.52,Default,,0,0,0,,《Бұл зорлық-зомбылықты жеңетін күш! 》
Dialogue: 0,0:00:11.55,0:00:13.55,Default,,0,0,0,,《Жоқ》
Dialogue: 0,0:00:13.55,0:00:17.56,Default,,0,0,0,,《Мен қылышты не үшін ұстап тұрмын? 》
Dialogue: 0,0:00:17.56,0:00:21.53,Default,,0,0,0,,Сіз... маған не үйреттіңіз?
Dialogue: 0,0:00:24.56,0:00:26.57,Default,,0,0,0,,((Мен теңізге қайта барғым келеді...)) ((Мен іздеп жүргенім➡)
Dialogue: 0,0:00:26.57,0:00:28.57,Default,,0,0,0,,Сіз оны таптыңыз ба? )) ((Жүрегімде, кенеттен➡
Dialogue: 0,0:00:28.57,0:00:30.57,Default,,0,0,0,,Аянның бір көрінісіне сену))
Dialogue: 0,0:00:30.57,0:00:33.57,Default,,0,0,0,,《Менде қазір не бар? 》
Dialogue: 0,0:00:33.57,0:00:36.58,Default,,0,0,0,,《Сен бұл қолдармен не істедің? 》
Dialogue: 0,0:00:36.58,0:00:38.58,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:00:38.58,0:00:42.58,Default,,0,0,0,,《Менің ерекше мөрім қандай...? 》
Dialogue: 0,0:00:42.58,0:00:44.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:47.59,0:00:49.59,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:00:49.59,0:00:55.60,Default,,0,0,0,,Қылышым сынса да, тегім өзгерсе де➡
Dialogue: 0,0:00:55.60,0:01:00.60,Default,,0,0,0,,Өзгерісімнің тағдырын өзім шешем.
Dialogue: 0,0:01:00.60,0:01:05.57,Default,,0,0,0,,Мука Югоға саяхатқа бару
Dialogue: 0,0:01:09.54,0:01:11.55,Default,,0,0,0,,О!
Dialogue: 0,0:01:11.55,0:01:13.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:21.56,0:01:23.56,Default,,0,0,0,,Иә
Dialogue: 0,0:01:23.56,0:01:26.56,Default,,0,0,0,,Мен өзімді сынап көремін
Dialogue: 0,0:01:26.56,0:01:29.56,Default,,0,0,0,,Өзіңнің шыққан тегін білу
Dialogue: 0,0:01:29.56,0:01:32.53,Default,,0,0,0,,Сондықтан мен қылышымды сермеп тұрмын
Dialogue: 0,0:01:33.57,0:01:35.57,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:35.57,0:01:40.57,Default,,0,0,0,,Мен де сені осы қылышпен сынаймын.
Dialogue: 0,0:01:40.57,0:01:42.58,Default,,0,0,0,,Иә, Белл.
Dialogue: 0,0:01:42.58,0:01:47.55,Default,,0,0,0,,Қарғыс пен батаңның себебі осы.
Dialogue: 0,0:01:49.58,0:01:51.59,Default,,0,0,0,,Сіз мені кесіп тастай аласыз ба?
Dialogue: 0,0:01:51.59,0:01:54.59,Default,,0,0,0,,Бір ғана жеке болмыс
Dialogue: 0,0:01:54.59,0:01:56.56,Default,,0,0,0,,Қарғыс атсын... Ха!
Dialogue: 0,0:01:57.59,0:01:59.59,Default,,0,0,0,,Мен ол жігітке ештеңе істей алмаймын
Dialogue: 0,0:01:59.59,0:02:02.56,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:02:03.53,0:02:06.50,Default,,0,0,0,,Әлемді тесіп өт!
Dialogue: 0,0:02:07.53,0:02:09.54,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:09.54,0:02:13.54,Default,,0,0,0,,Сол кезде мен әлемге қашаламын!
Dialogue: 0,0:02:13.54,0:02:15.54,Default,,0,0,0,,Егер мен шынымен... Уау!
Dialogue: 0,0:02:15.54,0:02:17.54,Default,,0,0,0,,Гүлдену!
Dialogue: 0,0:02:17.54,0:04:06.52,Default,,0,0,0,,♬～
Dialogue: 0,0:04:06.52,0:04:08.52,Default,,0,0,0,,Катакомбалар үшін бұл үлкен мәселе ме?
Dialogue: 0,0:04:08.52,0:04:10.52,Default,,0,0,0,,Катакомбалар мен сарайлар➡
Dialogue: 0,0:04:10.52,0:04:13.53,Default,,0,0,0,,Бізді кенет жер асты өткелі қосты.
Dialogue: 0,0:04:13.53,0:04:15.53,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:04:15.53,0:04:17.53,Default,,0,0,0,,Бас діни қызметкер Ядро ➡ дейді
Dialogue: 0,0:04:17.53,0:04:20.53,Default,,0,0,0,,Оны тек Коллинз➡ ұрпақтан-ұрпаққа жеткізген
Dialogue: 0,0:04:20.53,0:04:24.54,Default,,0,0,0,,Катакомбалар жұмбақтарымен тығыз байланысты
Dialogue: 0,0:04:24.54,0:04:26.54,Default,,0,0,0,,Құлыпта бірдеңе болып жатыр ма?
Dialogue: 0,0:04:26.54,0:04:28.54,Default,,0,0,0,,Гиннес?
Dialogue: 0,0:04:28.54,0:04:32.55,Default,,0,0,0,,Негізі бізді таң қалдырғаны➡ болды
Dialogue: 0,0:04:32.55,0:04:34.55,Default,,0,0,0,,Бұл Гиннестен басқа ешкім туралы емес.
Dialogue: 0,0:04:34.55,0:04:36.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:36.55,0:04:40.55,Default,,0,0,0,,Бұрын Гиннес-доно ядроға ➡ есеп берген
Dialogue: 0,0:04:40.55,0:04:44.56,Default,,0,0,0,,Бұл анық болжанған болатын.
Dialogue: 0,0:04:44.56,0:04:47.56,Default,,0,0,0,,Полковник Гиннес және оның тобы➡
Dialogue: 0,0:04:47.56,0:04:52.57,Default,,0,0,0,,Біз сізді Катакомбтың маңызды мүшесі ретінде қарсы алуды шештік.
Dialogue: 0,0:04:52.57,0:04:59.57,Default,,0,0,0,,Ол... ақыры бізді сценарийіне түсірді.
Dialogue: 0,0:04:59.57,0:05:02.51,Default,,0,0,0,,Біздің отбасы алдыңғы қатарда➡
Dialogue: 0,0:05:02.51,0:05:05.51,Default,,0,0,0,,Сол жер асты жолын анықтайық.
Dialogue: 0,0:05:05.51,0:05:07.51,Default,,0,0,0,,Мен бұған шыдай алмаймын
Dialogue: 0,0:05:07.51,0:05:10.52,Default,,0,0,0,,Жарайды, бәрібір Гиннеске барамыз➡
Dialogue: 0,0:05:10.52,0:05:12.52,Default,,0,0,0,,Мен баруым керек екенін білдім.
Dialogue: 0,0:05:12.52,0:05:14.52,Default,,0,0,0,,Әсіресе тұман.
Dialogue: 0,0:05:14.52,0:05:16.52,Default,,0,0,0,,Уф... ақымақ! хун
Dialogue: 0,0:05:16.52,0:05:18.53,Default,,0,0,0,,Тез арада кетуге дайындалыңыз!
Dialogue: 0,0:05:18.53,0:05:20.53,Default,,0,0,0,,Мен катакомбалар арқылы қамалға барамын.
Dialogue: 0,0:05:20.53,0:05:22.53,Default,,0,0,0,,О!
Dialogue: 0,0:05:22.53,0:05:24.53,Default,,0,0,0,,Ｎｏｗｈｅｒｅ…
Dialogue: 0,0:05:24.53,0:05:28.54,Default,,0,0,0,,Ха... Аштық альянсы!
Dialogue: 0,0:05:28.54,0:05:31.54,Default,,0,0,0,,Ｎｏｗｈｅｒｅ…
Dialogue: 0,0:05:31.54,0:05:34.54,Default,,0,0,0,,Цк... Қозғалма, Беннет.
Dialogue: 0,0:05:34.54,0:05:37.54,Default,,0,0,0,,Ал... Бірақ жағдай осылай жалғаса берсе...
Dialogue: 0,0:05:37.54,0:05:39.55,Default,,0,0,0,,Бұл сынақ
Dialogue: 0,0:05:39.55,0:05:41.55,Default,,0,0,0,,Мен бас қылышшымын➡
Dialogue: 0,0:05:41.55,0:05:44.55,Default,,0,0,0,,Мен халық ретінде мақтанышқа сенемін.
Dialogue: 0,0:05:44.55,0:05:48.52,Default,,0,0,0,,Барлық халықтардың патшасы болуға ұмтылу
Dialogue: 0,0:05:49.56,0:05:52.56,Default,,0,0,0,,Алдамшыны жеңу
Dialogue: 0,0:05:52.56,0:05:56.56,Default,,0,0,0,,《Осындай нәрсеге бағынамын ба?》
Dialogue: 0,0:05:56.56,0:05:59.57,Default,,0,0,0,,《Өздерін жын деп атайтындарды кесіп таста》
Dialogue: 0,0:05:59.57,0:06:02.50,Default,,0,0,0,,《Басқа жол жоқ.》
Dialogue: 0,0:06:02.50,0:06:08.51,Default,,0,0,0,,《Мен көптеген достарымды осы бұйрыққа құрбан еттім, бірақ қазір...》
Dialogue: 0,0:06:08.51,0:06:10.51,Default,,0,0,0,,(Әйел турист 1) Санта-Киара шіркеуіне қалай жетуге болады?
Dialogue: 0,0:06:10.51,0:06:15.52,Default,,0,0,0,,Құдай діни қызметкерлерді де басқарып, Шерри ханшайымға қол қояды ма?
Dialogue: 0,0:06:15.52,0:06:17.52,Default,,0,0,0,,《Мен білмеймін...》
Dialogue: 0,0:06:17.52,0:06:21.52,Default,,0,0,0,,《Менің бұл семсерім қайдан шыққан?》
Dialogue: 0,0:06:21.52,0:06:24.52,Default,,0,0,0,,)
Dialogue: 0,0:06:24.52,0:06:26.53,Default,,0,0,0,,Ха ((менің қылышымда➡
Dialogue: 0,0:06:26.53,0:06:29.53,Default,,0,0,0,,Тиісті мәртебе беріңіз))
Dialogue: 0,0:06:29.53,0:06:31.53,Default,,0,0,0,,《Мен оны бір жерден естідім...》
Dialogue: 0,0:06:31.53,0:06:36.50,Default,,0,0,0,,《Бір күні, бір жерде, мен дәл осы сөздерді естідім! 》
Dialogue: 0,0:06:41.54,0:06:44.54,Default,,0,0,0,,Күнә менің қолымда!
Dialogue: 0,0:06:44.54,0:06:46.51,Default,,0,0,0,,Гааа (Дін қызметкері) Уау!
Dialogue: 0,0:06:48.55,0:06:51.55,Default,,0,0,0,,Ақыры есіме түсті
Dialogue: 0,0:06:51.55,0:06:54.55,Default,,0,0,0,,Осы қылышты қолыма алған кезде.
Dialogue: 0,0:06:54.55,0:07:00.56,Default,,0,0,0,,Сол мұңды қылыш жазушы маған айтып берді.
Dialogue: 0,0:07:00.56,0:07:03.50,Default,,0,0,0,,((ішкі әділеттілігіңізбен➡
Dialogue: 0,0:07:03.50,0:07:08.47,Default,,0,0,0,,Осы қылышқа лайықты орын берілсін))
Dialogue: 0,0:07:09.50,0:07:11.47,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:14.51,0:07:18.51,Default,,0,0,0,,Қылышым, маған жол көрсетесің бе?
Dialogue: 0,0:07:18.51,0:07:22.52,Default,,0,0,0,,Менен Құдайға құл болу идеясынан бас тартуымды сұрайсыз ба?
Dialogue: 0,0:07:22.52,0:07:26.52,Default,,0,0,0,,Артықшылыққа ұмтылып, жалғыз қалған кезім➡
Dialogue: 0,0:07:26.52,0:07:30.52,Default,,0,0,0,,Оны өзім кесіп алғанымды қалайсың ба?
Dialogue: 0,0:07:30.52,0:07:33.49,Default,,0,0,0,,Сіз патшасыз
Dialogue: 0,0:07:36.53,0:07:40.53,Default,,0,0,0,,Патша, мені қорғаңызшы.
Dialogue: 0,0:07:40.53,0:07:46.54,Default,,0,0,0,,Таң атқан аспанда түн бойы көтеріліп бара жатқандай➡
Dialogue: 0,0:07:46.54,0:07:49.51,Default,,0,0,0,,Қасиетті жұлдыздай
Dialogue: 0,0:07:54.55,0:07:59.55,Default,,0,0,0,,Мен патшаның соңғы сынағынан өттім.
Dialogue: 0,0:07:59.55,0:08:01.49,Default,,0,0,0,,Құдай өлді!
Dialogue: 0,0:08:01.49,0:08:04.49,Default,,0,0,0,,Құдайдың еркі менің қолымда!
Dialogue: 0,0:08:04.49,0:08:08.50,Default,,0,0,0,,Енді Алланың қалауы жойылды, шын мәнінде елдің белгісі кім?➡
Dialogue: 0,0:08:08.50,0:08:11.50,Default,,0,0,0,,Құдай ағашының болаттан жасалған➡
Dialogue: 0,0:08:11.50,0:08:15.50,Default,,0,0,0,,Бұл патшалықтың қылышы Эмокуру ғана!
Dialogue: 0,0:08:15.50,0:08:17.50,Default,,0,0,0,,Қылышқа бұйрық бер!
Dialogue: 0,0:08:17.50,0:08:21.51,Default,,0,0,0,,Тәңірі ханшайым халқының әніне кедергі келтірмек болғандар➡
Dialogue: 0,0:08:21.51,0:08:24.48,Default,,0,0,0,,Олардың бәрін өлтіріңіз!
Dialogue: 0,0:08:27.51,0:08:29.52,Default,,0,0,0,,(Діни қызметкерлердің айқайы)
Dialogue: 0,0:08:29.52,0:08:32.52,Default,,0,0,0,,Кеттік! Қанекей мынаны істейік!
Dialogue: 0,0:08:32.52,0:08:35.52,Default,,0,0,0,,Біз мұны істей аламыз! Қанекей мынаны істейік!
Dialogue: 0,0:08:35.52,0:08:40.53,Default,,0,0,0,,Бас қылышшы! Сіз де біз сияқтысыз...
Dialogue: 0,0:08:40.53,0:08:43.53,Default,,0,0,0,,Елдің жаңа нышаны – осы патшалықтың қылышы.
Dialogue: 0,0:08:43.53,0:08:45.53,Default,,0,0,0,,Әрине сіздің саяхатыңыздың кілті➡
Dialogue: 0,0:08:45.53,0:08:49.54,Default,,0,0,0,,Катакомбтың әні: Бұл идеал емес.
Dialogue: 0,0:08:49.54,0:08:52.54,Default,,0,0,0,,Саяхаттың кілтін ақыры мен бұзады.
Dialogue: 0,0:08:52.54,0:08:56.54,Default,,0,0,0,,Я... Кілт қолымызда➡
Dialogue: 0,0:08:56.54,0:09:01.48,Default,,0,0,0,,Кеңғақудың қамалға ұқсамайтын түрі мен халық жолына ұқсайтыны айтылады.
Dialogue: 0,0:09:01.48,0:09:03.48,Default,,0,0,0,,Қалалар мен сарайлар әрқашан ➡ болады
Dialogue: 0,0:09:03.48,0:09:07.49,Default,,0,0,0,,Ол Кенгаку үшін эталон және адамдар болуы керек сияқты өмір сүре береді.
Dialogue: 0,0:09:07.49,0:09:10.49,Default,,0,0,0,,Сен сол жерде халықтың патшасы боласың ба?
Dialogue: 0,0:09:10.49,0:09:12.49,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:09:12.49,0:09:16.50,Default,,0,0,0,,Бірінші қадам - ​​бірге күресіп, оларды жеңу.
Dialogue: 0,0:09:16.50,0:09:18.50,Default,,0,0,0,,Қарсылық бар ма?
Dialogue: 0,0:09:18.50,0:09:21.50,Default,,0,0,0,,Сіздің қалауыңыз бойынша, бауырым.
Dialogue: 0,0:09:21.50,0:09:23.50,Default,,0,0,0,,Осы уақытқа дейін жау болдық.
Dialogue: 0,0:09:23.50,0:09:27.51,Default,,0,0,0,,Сіз сыртқы келбетіңіз үшін тым радикалсыз, Беннетт.
Dialogue: 0,0:09:27.51,0:09:29.51,Default,,0,0,0,,Біз Гафф-дономен мәселені шешуіміз керек!
Dialogue: 0,0:09:29.51,0:09:33.51,Default,,0,0,0,,Жау – қараңғылар мен құдайдың аруақтары!
Dialogue: 0,0:09:33.51,0:09:35.52,Default,,0,0,0,,О!
Dialogue: 0,0:09:35.52,0:09:37.52,Default,,0,0,0,,Жақсы! (Діни қызметкерлер) Уау!
Dialogue: 0,0:09:37.52,0:09:39.52,Default,,0,0,0,,Ха! (Дін қызметкері) Хмф!
Dialogue: 0,0:09:39.52,0:09:42.52,Default,,0,0,0,,Ура! (Ай көзді тайпа) Дея!
Dialogue: 0,0:09:42.52,0:09:45.53,Default,,0,0,0,,Бұл шынымен де Құдайдың жаназасы!
Dialogue: 0,0:09:45.53,0:09:48.53,Default,,0,0,0,,Тегін білетіндерге ғана кешіріледі➡
Dialogue: 0,0:09:48.53,0:09:51.50,Default,,0,0,0,,Реквием айт!
Dialogue: 0,0:09:59.54,0:10:02.54,Default,,0,0,0,,Қош келдіңіз Шерри ханшайым
Dialogue: 0,0:10:02.54,0:10:05.51,Default,,0,0,0,,Барлығы сахнаға қойылған.
Dialogue: 0,0:10:06.55,0:10:08.55,Default,,0,0,0,,Бұл менің шын тілегім
Dialogue: 0,0:10:08.55,0:10:12.52,Default,,0,0,0,,Барлығы өзіңізге байланысты
Dialogue: 0,0:10:20.56,0:10:22.56,Default,,0,0,0,,Сіз қазір кетесіз бе?
Dialogue: 0,0:10:22.56,0:10:26.57,Default,,0,0,0,,Аштық альянсы қайта пайда болды деген нені білдіреді?
Dialogue: 0,0:10:26.57,0:10:31.57,Default,,0,0,0,,Әлгі жас қасқырдың қауіпті іс жасағалы тұрғанының дәлелі.
Dialogue: 0,0:10:31.57,0:10:36.58,Default,,0,0,0,,Сонда менің әндерімді ешкім тыңдамайды?
Dialogue: 0,0:10:36.58,0:10:39.58,Default,,0,0,0,,Өз әнімді бірінші рет айтып отырмын.
Dialogue: 0,0:10:39.58,0:10:42.58,Default,,0,0,0,,Бұл сарайдың барлығы сіздің аудиторияңыз.
Dialogue: 0,0:10:42.58,0:10:46.59,Default,,0,0,0,,Белл және біз мұны сіздің әніңіздің арқасында ғана жасай аламыз➡
Dialogue: 0,0:10:46.59,0:10:50.56,Default,,0,0,0,,Тегіңді жоғалтпай дүниеден өтесің.
Dialogue: 0,0:10:51.59,0:10:55.60,Default,,0,0,0,,Жүріңіз, Шерри ханшайым, бұл сіздің сахнаңыз.
Dialogue: 0,0:10:55.60,0:10:58.57,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:11:03.54,0:11:08.54,Default,,0,0,0,,Құрметті Саяхатшы Ұзынқұлақ тайпасы, маған тағы бір нәрсе айтқым келеді.
Dialogue: 0,0:11:08.54,0:11:13.55,Default,,0,0,0,,Менің әнімді білесің бе?
Dialogue: 0,0:11:13.55,0:11:16.55,Default,,0,0,0,,Тек ән айт
Dialogue: 0,0:11:16.55,0:11:20.52,Default,,0,0,0,,Саяхатқа шыққандай
Dialogue: 0,0:11:24.56,0:11:29.53,Default,,0,0,0,,Иә, сапарға шыққандай.
Dialogue: 0,0:11:40.57,0:11:42.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:42.58,0:11:46.58,Default,,0,0,0,,Гаха! Ах...
Dialogue: 0,0:11:46.58,0:11:50.58,Default,,0,0,0,,《Сен нені кестің? 》
Dialogue: 0,0:11:50.58,0:11:52.59,Default,,0,0,0,,Ах
Dialogue: 0,0:11:52.59,0:11:56.59,Default,,0,0,0,,Дүрілдеген қылыш қалыпты жағдайға оралады...
Dialogue: 0,0:11:56.59,0:11:58.59,Default,,0,0,0,,Ах
Dialogue: 0,0:11:58.59,0:12:02.53,Default,,0,0,0,,Хэхе... хахаха
Dialogue: 0,0:12:02.53,0:12:09.54,Default,,0,0,0,,Бұл қылыштың маған зиян тигізуі мүмкін емес.
Dialogue: 0,0:12:09.54,0:12:13.54,Default,,0,0,0,,Өлуін жалғастыратын болат
Dialogue: 0,0:12:13.54,0:12:16.54,Default,,0,0,0,,Қанша сынса да➡
Dialogue: 0,0:12:16.54,0:12:21.55,Default,,0,0,0,,Өлуді жалғастыру және қайта тірілу
Dialogue: 0,0:12:21.55,0:12:23.55,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:12:23.55,0:12:26.55,Default,,0,0,0,,Жаңғыру өте баяу
Dialogue: 0,0:12:26.55,0:12:32.56,Default,,0,0,0,,Өйткені сенің жүзің бұл қылышты басқа нәрсеге айналдырды.
Dialogue: 0,0:12:32.56,0:12:35.56,Default,,0,0,0,,Сөйлеме, өлесің, ха...
Dialogue: 0,0:12:35.56,0:12:38.56,Default,,0,0,0,,Мен өлетін болсам, бұл бос сөзден өлгенім артық.
Dialogue: 0,0:12:38.56,0:12:40.57,Default,,0,0,0,,Осыны айт және өл
Dialogue: 0,0:12:40.57,0:12:44.54,Default,,0,0,0,,Күткендей мен саған ғашық болдым. Кешіріңіз.
Dialogue: 0,0:12:45.57,0:12:48.54,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,0:12:49.58,0:12:51.58,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:12:51.58,0:12:54.58,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:12:54.58,0:12:56.55,Default,,0,0,0,,Ах
Dialogue: 0,0:12:58.58,0:13:00.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:00.59,0:13:02.52,Default,,0,0,0,,Шірімейді
Dialogue: 0,0:13:02.52,0:13:05.53,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:13:05.53,0:13:09.53,Default,,0,0,0,,Дүние әрқашан кеш болғанша күтеді➡
Dialogue: 0,0:13:09.53,0:13:11.53,Default,,0,0,0,,Татуласу үшін маған хабарласыңыз.
Dialogue: 0,0:13:11.53,0:13:13.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:15.54,0:13:17.54,Default,,0,0,0,,Сіз мені әлі өлтірген жоқсыз!
Dialogue: 0,0:13:17.54,0:13:20.54,Default,,0,0,0,,Уау... Иә?
Dialogue: 0,0:13:20.54,0:13:22.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:22.54,0:13:24.54,Default,,0,0,0,,(Құдайдың жүрек соғысы)
Dialogue: 0,0:13:24.54,0:13:28.55,Default,,0,0,0,,(жылау)
Dialogue: 0,0:13:28.55,0:13:30.55,Default,,0,0,0,,Уф…
Dialogue: 0,0:13:30.55,0:13:33.55,Default,,0,0,0,,Қоңырау, оянатын кез келді.
Dialogue: 0,0:13:33.55,0:13:38.56,Default,,0,0,0,,Құдай енді өзінің әпкесі Шеллидің әнін де тыңдамайды.
Dialogue: 0,0:13:38.56,0:13:42.56,Default,,0,0,0,,Тіпті ағасы Ғаффтың қылышына да сезімтал емес.
Dialogue: 0,0:13:42.56,0:13:47.53,Default,,0,0,0,,Әрине, мен сенің қарындасыңның патшасы болуым керек, тіпті сен ырылдасаң да.
Dialogue: 0,0:13:48.57,0:13:52.57,Default,,0,0,0,,Менің көлеңкемнен кел, Ашаршылық Одағының азуы.
Dialogue: 0,0:13:52.57,0:13:58.58,Default,,0,0,0,,Енді механикалық құдайға сұрақ қоятын кез келді!
Dialogue: 0,0:13:58.58,0:14:00.58,Default,,0,0,0,,Ｎｏｗｈｅｒｅ…
Dialogue: 0,0:14:00.58,0:14:02.52,Default,,0,0,0,,Қарғыс атсын... қара.
Dialogue: 0,0:14:02.52,0:14:08.52,Default,,0,0,0,,Механикалық құдай не үшін туды және ол не үшін аш болды?
Dialogue: 0,0:14:08.52,0:14:13.53,Default,,0,0,0,,Кіші патша ретінде менің жоқтауым оның аштығын көрсетеді!
Dialogue: 0,0:14:13.53,0:14:23.54,Default,,0,0,0,,♬～
Dialogue: 0,0:14:23.54,0:14:26.54,Default,,0,0,0,,Бұлар... сынаушының күлі! ?
Dialogue: 0,0:14:26.54,0:14:31.51,Default,,0,0,0,,(Көлеңке шеберлерінің ыңырануы)
Dialogue: 0,0:14:37.55,0:14:39.55,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:14:39.55,0:14:42.56,Default,,0,0,0,,Енді соны ашып, табынатын кез!
Dialogue: 0,0:14:42.56,0:14:45.56,Default,,0,0,0,,Құдайдың бұл ізінен не құтылуға болады➡
Dialogue: 0,0:14:45.56,0:14:47.56,Default,,0,0,0,,Құдайдың аштығы
Dialogue: 0,0:14:47.56,0:14:51.56,Default,,0,0,0,,Аштық альянсының туған жері!
Dialogue: 0,0:14:51.56,0:14:53.53,Default,,0,0,0,,Адонис!
Dialogue: 0,0:14:55.57,0:14:57.57,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:57.57,0:14:59.57,Default,,0,0,0,,Ха! Китти!
Dialogue: 0,0:14:59.57,0:15:02.54,Default,,0,0,0,,Қандай күш!
Dialogue: 0,0:15:04.51,0:15:07.48,Default,,0,0,0,,Ха... не?
Dialogue: 0,0:15:09.52,0:15:11.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:11.52,0:15:14.49,Default,,0,0,0,,Бұл... Құдай ма?
Dialogue: 0,0:15:15.52,0:15:18.52,Default,,0,0,0,,Деміңді ұста, а
Dialogue: 0,0:15:18.52,0:15:20.53,Default,,0,0,0,,Жүздеген және мыңдаған жылдардан кейін➡
Dialogue: 0,0:15:20.53,0:15:25.53,Default,,0,0,0,,Сақталған ақпарат Жадының тигельінен➡
Dialogue: 0,0:15:25.53,0:15:30.54,Default,,0,0,0,,Құдай аштық енді қалыптаса бастады
Dialogue: 0,0:15:30.54,0:15:32.54,Default,,0,0,0,,Ha
Dialogue: 0,0:15:32.54,0:15:36.51,Default,,0,0,0,,Менің... келбетім?
Dialogue: 0,0:15:37.54,0:15:42.55,Default,,0,0,0,,Құдай мен үшін аш болды ма?
Dialogue: 0,0:15:42.55,0:15:44.55,Default,,0,0,0,,Әлі жоқ, Белл! Ах...
Dialogue: 0,0:15:44.55,0:15:47.55,Default,,0,0,0,,Сіз де аралассаңыз, ештеңе істемейді.
Dialogue: 0,0:15:47.55,0:15:49.56,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:15:49.56,0:15:54.53,Default,,0,0,0,,Мен шақырған басқа құстың әні шырқалғанша.
Dialogue: 0,0:15:56.56,0:15:58.56,Default,,0,0,0,,Ha
Dialogue: 0,0:15:58.56,0:16:09.51,Default,,0,0,0,,♬～
Dialogue: 0,0:16:09.51,0:16:11.48,Default,,0,0,0,,Адонис?
Dialogue: 0,0:16:12.51,0:16:15.51,Default,,0,0,0,,А...
Dialogue: 0,0:16:15.51,0:16:18.52,Default,,0,0,0,,Парасатты қыз...
Dialogue: 0,0:16:18.52,0:16:24.52,Default,,0,0,0,,Мен сенің ішіңде еріп барамын
Dialogue: 0,0:16:24.52,0:16:28.53,Default,,0,0,0,,Сен шынымен мен болғың келе ме?
Dialogue: 0,0:16:28.53,0:16:30.50,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:16:32.53,0:16:35.53,Default,,0,0,0,,♪ (ән айту)
Dialogue: 0,0:16:35.53,0:16:38.54,Default,,0,0,0,,Ха (Адонис/бұл) иә?
Dialogue: 0,0:16:38.54,0:16:40.54,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:40.54,0:16:43.54,Default,,0,0,0,,♪ (Шерридің ән салған дауысы)
Dialogue: 0,0:16:43.54,0:16:45.54,Default,,0,0,0,,Бұл ән.
Dialogue: 0,0:16:45.54,0:16:59.56,Default,,0,0,0,,♪～
Dialogue: 0,0:16:59.56,0:17:01.49,Default,,0,0,0,,Шерри…
Dialogue: 0,0:17:01.49,0:17:12.51,Default,,0,0,0,,♪～
Dialogue: 0,0:17:12.51,0:17:14.47,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:17:15.51,0:17:17.51,Default,,0,0,0,,Көк әулиелік!
Dialogue: 0,0:17:17.51,0:17:19.51,Default,,0,0,0,,Тіпті мына жігіттер ме?
Dialogue: 0,0:17:19.51,0:17:32.53,Default,,0,0,0,,♪～
Dialogue: 0,0:17:32.53,0:17:34.53,Default,,0,0,0,,Хаа!
Dialogue: 0,0:17:34.53,0:17:38.53,Default,,0,0,0,,Еш қағыспа, арғы жақтан нағыз құдайдың әні естіледі.
Dialogue: 0,0:17:38.53,0:17:41.53,Default,,0,0,0,,Біздің қорғаныш әнімізді тыңдаңдар!
Dialogue: 0,0:17:41.53,0:17:45.54,Default,,0,0,0,,Біз қорғайтын нәрсе бізді де қорғайды!
Dialogue: 0,0:17:45.54,0:17:49.54,Default,,0,0,0,,Жүр! Қылыш мақтаныш әнін шырқасын!
Dialogue: 0,0:17:49.54,0:17:51.54,Default,,0,0,0,,Діни қызметкерлер де, қылышшылар да➡
Dialogue: 0,0:17:51.54,0:17:54.55,Default,,0,0,0,,Барлығы Құдай Сөзінсіз күресуде!
Dialogue: 0,0:17:54.55,0:17:59.55,Default,,0,0,0,,Әркім өз заңын іздеуде өз билігін пайдаланады!
Dialogue: 0,0:17:59.55,0:18:05.49,Default,,0,0,0,,Бұл елді жаңа бағытқа апаратын қылыштаудың бұрын-соңды болмаған түрі!
Dialogue: 0,0:18:05.49,0:18:15.50,Default,,0,0,0,,♪～
Dialogue: 0,0:18:15.50,0:18:18.50,Default,,0,0,0,,Ханшайым әні орындалады
Dialogue: 0,0:18:18.50,0:18:22.51,Default,,0,0,0,,♪～
Dialogue: 0,0:18:22.51,0:18:26.51,Default,,0,0,0,,(Ай көзді тайпа) сарайы... ән айтып жатыр ма?
Dialogue: 0,0:18:26.51,0:18:28.51,Default,,0,0,0,,♪～
Dialogue: 0,0:18:28.51,0:18:30.52,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:18:30.52,0:18:33.52,Default,,0,0,0,,Иә? Бұлт! Сіздің аяқтарыңыз ...
Dialogue: 0,0:18:33.52,0:18:35.52,Default,,0,0,0,,Ауырсыну басылды!
Dialogue: 0,0:18:35.52,0:18:39.53,Default,,0,0,0,,Енді менің қылышымды мазақ ететін ешкім жоқ!
Dialogue: 0,0:18:39.53,0:18:42.53,Default,,0,0,0,,Менің қылышымда Құдайдың қалауы бар!
Dialogue: 0,0:18:42.53,0:18:46.53,Default,,0,0,0,,Кел, ән айт! Біздің жаңа шайқас!
Dialogue: 0,0:18:46.53,0:18:49.54,Default,,0,0,0,,Бұл біздің бастапқы нүктеміз болсын!
Dialogue: 0,0:18:49.54,0:18:52.54,Default,,0,0,0,,Сәлем Сиан
Dialogue: 0,0:18:52.54,0:18:56.54,Default,,0,0,0,,Мен өте қатыгез ән естимін
Dialogue: 0,0:18:56.54,0:18:59.55,Default,,0,0,0,,Қуаныш үшін
Dialogue: 0,0:18:59.55,0:19:02.48,Default,,0,0,0,,Өлген және механикаландырылған адамдар➡
Dialogue: 0,0:19:02.48,0:19:06.49,Default,,0,0,0,,Мен саған жүгірейін деп жатырмын, Сол аштықтың көзі.
Dialogue: 0,0:19:06.49,0:19:10.49,Default,,0,0,0,,Бұл Құдайдың аштығы
Dialogue: 0,0:19:10.49,0:19:15.49,Default,,0,0,0,,Сайып келгенде, діни қызметкер мен Аштық альянсының тамыры бір, солай емес пе?
Dialogue: 0,0:19:15.49,0:19:21.47,Default,,0,0,0,,Менің мұндағы мақсатым сенен қылышымды сынау!
Dialogue: 0,0:19:22.50,0:19:38.52,Default,,0,0,0,,♪～
Dialogue: 0,0:19:38.52,0:19:40.52,Default,,0,0,0,,《…》
Dialogue: 0,0:19:40.52,0:19:47.53,Default,,0,0,0,,《Құдай жадының өзегінде тұрған жазылған дене》
Dialogue: 0,0:19:47.53,0:19:53.53,Default,,0,0,0,,《Дүниенің басында Құдайдың бар болу себебін осылай жаратты》
Dialogue: 0,0:19:53.53,0:19:56.54,Default,,0,0,0,,Жақсы... Жоқ!
Dialogue: 0,0:19:56.54,0:20:00.54,Default,,0,0,0,,Мен өлмеймін.
Dialogue: 0,0:20:00.54,0:20:07.55,Default,,0,0,0,,Оған дейін бұл дүниеден құдайдың құдіреті сөнеді!
Dialogue: 0,0:20:07.55,0:20:11.55,Default,,0,0,0,,♪～
Dialogue: 0,0:20:11.55,0:20:13.55,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:20:13.55,0:20:16.56,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:20:16.56,0:20:21.56,Default,,0,0,0,,Құдайдың ақыл-ойы өзінің себебін жадтан іздейді➡
Dialogue: 0,0:20:21.56,0:20:25.56,Default,,0,0,0,,Ол сол формада пайда болды.
Dialogue: 0,0:20:25.56,0:20:27.57,Default,,0,0,0,,Бұл жігіт кім...
Dialogue: 0,0:20:27.57,0:20:30.57,Default,,0,0,0,,Қызық, менің бет-әлпетіме еліктеу оңай ма?
Dialogue: 0,0:20:30.57,0:20:32.57,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:20:32.57,0:20:35.57,Default,,0,0,0,,Өйткені сен жалғызсың➡
Dialogue: 0,0:20:35.57,0:20:39.58,Default,,0,0,0,,Өйткені бұл дүниеде барлардың бастауы.
Dialogue: 0,0:20:39.58,0:20:41.58,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:20:41.58,0:20:47.59,Default,,0,0,0,,Біздің ұйым көптеген ұрпақтар бойына буындық өзгерістерге ұшырады➡
Dialogue: 0,0:20:47.59,0:20:51.59,Default,,0,0,0,,Бірінші орында себеп-салдар қыз
Dialogue: 0,0:20:51.59,0:20:56.60,Default,,0,0,0,,Дүниені парасатты қыз тескенде➡
Dialogue: 0,0:20:56.60,0:21:00.60,Default,,0,0,0,,Біз өз болмысымызды жоғалтамыз
Dialogue: 0,0:21:00.60,0:21:05.54,Default,,0,0,0,,Менің шыққан жерімді білу сені өлтіре ме?
Dialogue: 0,0:21:05.54,0:21:09.54,Default,,0,0,0,,Иә, себебі мен салдарын айтып берейін.
Dialogue: 0,0:21:09.54,0:21:14.55,Default,,0,0,0,,Өйткені біз сол мақсаттың тетігіміз.
Dialogue: 0,0:21:14.55,0:21:19.55,Default,,0,0,0,,Біз тұрған кеңістікке қадам бас.
Dialogue: 0,0:21:19.55,0:21:21.55,Default,,0,0,0,,Парасатты қыз
Dialogue: 0,0:21:21.55,0:21:23.56,Default,,0,0,0,,Мен оны… есептей алмаймын.
Dialogue: 0,0:21:23.56,0:21:25.56,Default,,0,0,0,,Мен сені сол балшық қайыққа мінгіземін.
Dialogue: 0,0:21:25.56,0:21:28.56,Default,,0,0,0,,Қандай жоспар құрсаңыз да➡
Dialogue: 0,0:21:28.56,0:21:31.53,Default,,0,0,0,,Бұл қылыш бәрін сынап көреді!
Dialogue: 0,0:21:32.57,0:21:38.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:40.57,0:21:42.54,Default,,0,0,0,,Ах
Dialogue: 0,0:21:45.28,0:21:46.58,Default,,0,0,0,,Ha
Dialogue: 0,0:21:46.58,0:21:48.58,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:21:48.58,0:21:54.55,Default,,0,0,0,,Бұл ескі құдайлардың жұмағы
Dialogue: 0,0:22:00.59,0:23:30.55,Default,,0,0,0,,♬～
Dialogue: 0,0:23:30.55,0:23:32.55,Default,,0,0,0,,Мен жалғыз ойнағанды ұнатпаймын!
Dialogue: 0,0:23:32.55,0:23:35.55,Default,,0,0,0,,Қарым-қатынасыңызды өзгертіңіз! Оның жойылуын бізден сұрайсың ба?
Dialogue: 0,0:23:35.55,0:23:39.53,Default,,0,0,0,,Енді меннен қалаған сөздерді айта аласыз
Dialogue: 0,0:23:41.03,0:23:47.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory