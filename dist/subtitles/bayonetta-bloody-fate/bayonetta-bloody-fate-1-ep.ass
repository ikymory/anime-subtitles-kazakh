Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.50,0:00:05.05,JPN,NTP,0,0,0,,Бұрын Еуропаның шалғай ауданы
Dialogue: 0,0:00:05.20,0:00:06.45,JPN,NTP,0,0,0,,Вигридке
Dialogue: 0,0:00:06.90,0:00:10.05,JPN,NTP,0,0,0,,«Тарихты бақылаушылар» деген адамдар болған.
Dialogue: 0,0:00:11.40,0:00:14.35,JPN,NTP,0,0,0,,«Умбра ведьмасының» қараңғы қызметшісімен
Dialogue: 0,0:00:14.70,0:00:17.85,JPN,NTP,0,0,0,,Лумен данышпан, Жарық хабаршысы.
Dialogue: 0,0:00:18.85,0:00:20.50,JPN,NTP,0,0,0,,Бақсылар шайтанмен байланысады
Dialogue: 0,0:00:20.80,0:00:22.90,JPN,NTP,0,0,0,,Даналар періштелермен сөйлесті
Dialogue: 0,0:00:23.35,0:00:25.50,JPN,NTP,0,0,0,,Бір-бірімен тепе-теңдікте
Dialogue: 0,0:00:25.80,0:00:28.95,JPN,NTP,0,0,0,,Дүние жүзін бақылау миссиясында болды
Dialogue: 0,0:00:29.90,0:00:32.50,JPN,NTP,0,0,0,,Бірақ кенеттен тепе-теңдік бұзылады.
Dialogue: 0,0:00:33.30,0:00:37.80,JPN,NTP,0,0,0,,Ақылды адам мен бақсы әйел тәртіпті бұзып, бақсыға шығады.
Dialogue: 0,0:00:38.10,0:00:41.15,JPN,NTP,0,0,0,,Тыйым салынған бала туудың басы болды
Dialogue: 0,0:00:42.40,0:00:46.15,JPN,NTP,0,0,0,,Әйел түрмеге қамалды, ер адамның отбасы қуылды, бірақ
Dialogue: 0,0:00:46.55,0:00:49.00,JPN,NTP,0,0,0,,Іс мұнымен бітпеді.
Dialogue: 0,0:00:50.45,0:00:54.30,JPN,NTP,0,0,0,,Жарық пен қараңғылық тоғысқанда ең сорақы келеді
Dialogue: 0,0:00:55.60,0:01:00.00,JPN,NTP,0,0,0,,Ескі аңыз кейін шындыққа айналды.
Dialogue: 0,0:01:01.50,0:01:04.00,JPN,NTP,0,0,0,,Дүниенің жаратылу күшін басқарады
Dialogue: 0,0:01:04.15,0:01:06.10,JPN,NTP,0,0,0,,Оң көз және сол көз
Dialogue: 0,0:01:08.10,0:01:10.95,JPN,NTP,0,0,0,,Бақсы отбасы асырап алған тыйым салынған бала
Dialogue: 0,0:01:11.40,0:01:13.75,JPN,NTP,0,0,0,,Сол көздің күші бар
Dialogue: 0,0:01:15.20,0:01:17.00,JPN,NTP,0,0,0,,Екі көз тураланғанда
Dialogue: 0,0:01:17.35,0:01:19.80,JPN,NTP,0,0,0,,Юбелей құдайы пайда болады
Dialogue: 0,0:01:20.25,0:01:22.35,JPN,NTP,0,0,0,,Жаңа әлем құрылды
Dialogue: 0,0:01:23.35,0:01:27.20,JPN,NTP,0,0,0,,Бұл аспанның және көктің қалауы болды.
Dialogue: 0,0:01:28.45,0:01:32.10,JPN,NTP,0,0,0,,Данышпан көкте, бақсы қайшылықта болды.
Dialogue: 0,0:01:33.70,0:01:38.30,JPN,NTP,0,0,0,,Сосын Сол көз үшін шайқас басталды.
Dialogue: 0,0:01:40.00,0:01:44.10,JPN,NTP,0,0,0,,Шайқас періштелер мен жындардың қатысуымен үлкен соғысқа айналды.
Dialogue: 0,0:01:44.65,0:01:47.45,JPN,NTP,0,0,0,,Дүние құрдымға кетті.
Dialogue: 0,0:01:50.25,0:01:52.15,JPN,NTP,0,0,0,,Даналар да, бақсылар да өлді.
Dialogue: 0,0:01:52.25,0:01:53.80,JPN,NTP,0,0,0,,Соғыс аяқталды
Dialogue: 0,0:01:54.55,0:01:58.65,JPN,NTP,0,0,0,,Олардың тіршілігі ұмытылды
Dialogue: 0,0:01:59.95,0:02:02.40,JPN,NTP,0,0,0,,Бақсы болып өскен тыйым бала
Dialogue: 0,0:02:02.85,0:02:06.45,JPN,NTP,0,0,0,,Біреу мөр басып, жоғалып кетті
Dialogue: 0,0:02:08.60,0:02:10.65,JPN,NTP,0,0,0,,500 жылдан кейін
Dialogue: 0,0:02:12.20,0:02:16.15,JPN,NTP,0,0,0,,Періштелерді аңдыған бақсы тіріледі.
Dialogue: 0,0:03:09.85,0:03:11.15,JPN,NTP,0,0,0,,Флер де Сири
Dialogue: 0,0:03:29.50,0:03:31.85,JPN,NTP,0,0,0,,Менен мұңды қалаға өтті
Dialogue: 0,0:03:29.50,0:03:34.50,Note,NTP,0,0,0,,Бұл шығу тегі Тәңірлік комедияның үшінші әні
Dialogue: 0,0:03:32.30,0:03:34.55,JPN,NTP,0,0,0,,Мені мәңгілік қайғыға апарды
Dialogue: 0,0:03:35.15,0:03:37.80,JPN,NTP,0,0,0,,Менің қасымнан өтіп, жойылған адамдарға
Dialogue: 0,0:03:38.15,0:03:41.25,JPN,NTP,0,0,0,,Осы жерге кірген кез келген үмітті үзейік.
Dialogue: 0,0:03:41.90,0:03:44.25,JPN,NTP,0,0,0,,Менен мұңлы қалаға өтті
Dialogue: 0,0:03:44.65,0:03:46.95,JPN,NTP,0,0,0,,Мені мәңгілік қайғыға апарды
Dialogue: 0,0:03:47.65,0:03:50.00,JPN,NTP,0,0,0,,Менің қасымнан өтіп, құрдымға кеткен жұртқа
Dialogue: 0,0:03:50.95,0:03:54.45,JPN,NTP,0,0,0,,Осы жерге кірген кез келген үмітті үзейік.
Dialogue: 0,0:04:04.05,0:04:04.80,JPN,NTP,0,0,0,,Не?
Dialogue: 0,0:05:39.25,0:05:41.95,JPN,NTP,0,0,0,,Бүгін мен оның шынайы болмысын ашамын.
Dialogue: 0,0:05:57.15,0:05:59.75,JPN,NTP,0,0,0,,Сіз өзіңіздің костюміңізді қалай жасайсыз?
Dialogue: 0,0:06:00.35,0:06:01.65,JPN,NTP,0,0,0,,Сабырсыз
Dialogue: 0,0:06:30.70,0:06:32.40,JPN,NTP,0,0,0,,Ол мазасыз.
Dialogue: 0,0:06:32.70,0:06:35.00,JPN,NTP,0,0,0,,Мен сенің қарсыласың емеспін.
Dialogue: 0,0:06:38.65,0:06:40.85,JPN,NTP,0,0,0,,Бұл тамаша қойылым болды, Роден.
Dialogue: 0,0:06:41.65,0:06:43.65,JPN,NTP,0,0,0,,Әрине, Байонетта
Dialogue: 0,0:06:44.25,0:06:47.70,JPN,NTP,0,0,0,,Айтпақшы, менің рыцарь аяқталды.
Dialogue: 0,0:06:48.30,0:06:51.65,JPN,NTP,0,0,0,,Аа, сізге ұнайды деп үміттенемін.
Dialogue: 0,0:07:03.95,0:07:05.35,JPN,NTP,0,0,0,,Эльфин Найт
Dialogue: 0,0:07:06.50,0:07:08.55,JPN,NTP,0,0,0,,Рыцарь атына лайық мылтық.
Dialogue: 0,0:07:22.85,0:07:24.70,JPN,NTP,0,0,0,,Қызық енді басталады
Dialogue: 0,0:07:59.85,0:08:02.05,JPN,NTP,0,0,0,,А, не болып жатыр?
Dialogue: 0,0:08:28.95,0:08:30.30,JPN,NTP,0,0,0,,Әдемі
Dialogue: 0,0:08:45.30,0:08:46.60,JPN,NTP,0,0,0,,Менің көлігім
Dialogue: 0,0:08:50.50,0:08:52.90,JPN,NTP,0,0,0,,Менде әлі несие қалды
Dialogue: 0,0:09:14.60,0:09:15.65,JPN,NTP,0,0,0,,Иә!
Dialogue: 0,0:09:20.55,0:09:24.60,JPN,NTP,0,0,0,,Мен Сол көзге негіз боламын.
Dialogue: 0,0:09:25.35,0:09:29.45,JPN,NTP,0,0,0,,Осы жерде сізде бар қараңғылық күшін тоқтатыңыз.
Dialogue: 0,0:09:30.25,0:09:31.75,JPN,NTP,0,0,0,,Мен мұның не екенін білмеймін.
Dialogue: 0,0:09:44.60,0:09:47.20,JPN,NTP,0,0,0,,Өлімнің екінші келуі жақындайды
Dialogue: 0,0:09:48.10,0:09:49.90,JPN,NTP,0,0,0,,Бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:09:56.10,0:09:58.35,JPN,NTP,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:27.05,0:10:30.65,JPN,NTP,0,0,0,,Тозақтағы досым аш болсын деп жалынады.
Dialogue: 0,0:10:30.65,0:10:31.65,JPN,NTP,0,0,0,,Тыңдамаңыз
Dialogue: 0,0:10:33.10,0:10:34.90,JPN,NTP,0,0,0,,Сен сияқты олжа болса
Dialogue: 0,0:10:35.15,0:10:37.75,JPN,NTP,0,0,0,,Менің ойымша, ол қыз біраз уақыт тынышталады.
Dialogue: 0,0:10:38.65,0:10:40.70,JPN,NTP,0,0,0,,CARR MMA BOWE COOW
Dialogue: 0,0:10:50.80,0:10:54.05,JPN,NTP,0,0,0,,Тамақтың уақыты келді, тәттім.
Dialogue: 0,0:11:00.40,0:11:01.75,JPN,NTP,0,0,0,,Мен бұл туралы айтуды ұмытып кетіппін
Dialogue: 0,0:11:02.00,0:11:04.90,JPN,NTP,0,0,0,,Саған аң аулауымның тағы бір себебі
Dialogue: 0,0:11:06.50,0:11:10.25,JPN,NTP,0,0,0,,Ауырсынып бұрмаланған жүзге қараудың өзі бір ғанибет.
Dialogue: 0,0:11:11.40,0:11:14.55,JPN,NTP,0,0,0,,Дүниені қандай етіп жасау
Dialogue: 0,0:11:15.25,0:11:18.10,JPN,NTP,0,0,0,,Міне, мен көргім келген жүз.
Dialogue: 0,0:11:18.80,0:11:20.55,JPN,NTP,0,0,0,,Енді мен кетейін.
Dialogue: 0,0:11:20.85,0:11:24.85,JPN,NTP,0,0,0,,Бас құдай Юбелейге даңқ
Dialogue: 0,0:11:44.55,0:11:45.95,JPN,NTP,0,0,0,,Сіз мұны керемет түрде жасадыңыз.
Dialogue: 0,0:11:50.10,0:11:52.55,JPN,NTP,0,0,0,,Найт жақсы жұмыс істеген болар еді
Dialogue: 0,0:11:57.10,0:11:58.30,JPN,NTP,0,0,0,,жеткілікті.
Dialogue: 0,0:11:59.80,0:12:02.65,JPN,NTP,0,0,0,,Мен бұл балаға біраз уақыт қараймын.
Dialogue: 0,0:12:04.70,0:12:06.65,JPN,NTP,0,0,0,,Дүкенді ашатын кез келді.
Dialogue: 0,0:12:09.05,0:12:10.05,JPN,NTP,0,0,0,,Мен күтемін.
Dialogue: 0,0:12:11.25,0:12:12.55,JPN,NTP,0,0,0,,Егер сізге ұнаса.
Dialogue: 0,0:12:14.75,0:12:16.70,JPN,NTP,0,0,0,,«Жұмбақ тағдыр»
Dialogue: 0,0:12:17.10,0:12:18.70,JPN,NTP,0,0,0,,Зәйтүндерді ретімен сақта
Dialogue: 0,0:12:32.75,0:12:35.60,JPN,NTP,0,0,0,,Мен бұл егеуқұйрық деп ойладым, бірақ Чешир емес.
Dialogue: 0,0:12:36.45,0:12:37.70,JPN,NTP,0,0,0,,Менің атым Лука
Dialogue: 0,0:12:38.15,0:12:39.55,JPN,NTP,0,0,0,,Мұқият есте сақтаңыз
Dialogue: 0,0:12:40.80,0:12:41.60,JPN,NTP,0,0,0,,Бұл не?
Dialogue: 0,0:12:43.45,0:12:46.35,JPN,NTP,0,0,0,,Әйелдердің соңынан еретін еркектерді ұнатпаймын.
Dialogue: 0,0:12:47.00,0:12:48.35,JPN,NTP,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:12:48.65,0:12:49.80,JPN,NTP,0,0,0,,Менің жүзім жақсы
Dialogue: 0,0:12:50.35,0:12:52.70,JPN,NTP,0,0,0,,Клэр, Ториши, Сильвия және Ами
Dialogue: 0,0:12:52.70,0:12:54.40,JPN,NTP,0,0,0,,Сен мен үшін ессізсің
Dialogue: 0,0:12:55.85,0:12:59.15,JPN,NTP,0,0,0,,Иә, сенің достарыңның көптігі мені таң қалдырды.
Dialogue: 0,0:12:59.15,0:13:02.25,JPN,NTP,0,0,0,,Бірақ буксирлеу және жасырын түсіру туралы не деуге болады?
Dialogue: 0,0:13:03.05,0:13:04.25,JPN,NTP,0,0,0,,Жаман қыз.
Dialogue: 0,0:13:06.35,0:13:07.45,JPN,NTP,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:07.85,0:13:09.15,JPN,NTP,0,0,0,,Сауда құралдары
Dialogue: 0,0:13:10.00,0:13:12.90,JPN,NTP,0,0,0,,Әй, сен менің көлігімді де бүлдіріп алдың.
Dialogue: 0,0:13:13.30,0:13:14.15,JPN,NTP,0,0,0,,Бұл сіз болуыңыз керек.
Dialogue: 0,0:13:14.90,0:13:16.70,JPN,NTP,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:13:19.05,0:13:23.15,JPN,NTP,0,0,0,,Әлі есіңізде жоқ па?
Dialogue: 0,0:13:26.10,0:13:30.10,JPN,NTP,0,0,0,,20 жыл бұрын болған оқиғаны ешқашан ұмытпаймын
Dialogue: 0,0:13:31.30,0:13:32.90,JPN,NTP,0,0,0,,Флер Де Сири
Dialogue: 0,0:13:33.20,0:13:36.20,JPN,NTP,0,0,0,,Мен бұл иісті ешқашан ұмытпаймын
Dialogue: 0,0:13:39.00,0:13:41.15,JPN,NTP,0,0,0,,Әкемді өлтірген күн сияқты
Dialogue: 0,0:13:41.75,0:13:44.45,JPN,NTP,0,0,0,,Бұл сені алғаш көргенде иіскеген иіс.
Dialogue: 0,0:14:02.55,0:14:03.50,JPN,NTP,0,0,0,,Әке.
Dialogue: 0,0:14:05.45,0:14:06.25,JPN,NTP,0,0,0,,Әке.
Dialogue: 0,0:14:07.45,0:14:08.95,JPN,NTP,0,0,0,,Журналист ретінде
Dialogue: 0,0:14:11.05,0:14:13.45,JPN,NTP,0,0,0,,Мен сіздің шынайы болмысыңызды міндетті түрде ашамын.
Dialogue: 0,0:14:14.85,0:14:16.30,JPN,NTP,0,0,0,,Менің қалтырауым бар
Dialogue: 0,0:14:15.90,0:14:16.75,JPN,NTP,0,0,0,,Шатаспаңыз
Dialogue: 0,0:14:17.35,0:14:18.75,JPN,NTP,0,0,0,,Сіз жоғалып кетсеңіз де
Dialogue: 0,0:14:18.85,0:14:20.75,JPN,NTP,0,0,0,,Мен иісі арқылы айта аламын
Dialogue: 0,0:14:21.20,0:14:24.40,JPN,NTP,0,0,0,,Әйгілі «Fleur De Cirey» парфюмериясы
Dialogue: 0,0:14:24.75,0:14:28.50,JPN,NTP,0,0,0,,Розмариннің тәтті иісі ерекше хош иісті.
Dialogue: 0,0:14:28.75,0:14:30.25,JPN,NTP,0,0,0,,Бұл сізге сәйкес келмейді.
Dialogue: 0,0:14:31.15,0:14:34.70,JPN,NTP,0,0,0,,Парфюмерияны зерттей алмаған сияқтысың, Чешир.
Dialogue: 0,0:14:34.70,0:14:35.50,JPN,NTP,0,0,0,,Лұқа
Dialogue: 0,0:14:36.05,0:14:39.55,JPN,NTP,0,0,0,,«Флер де Сирей» құрамында розмарин жоқ.
Dialogue: 0,0:14:40.15,0:14:42.20,JPN,NTP,0,0,0,,Бұл тұмарлы иіс.
Dialogue: 0,0:14:42.35,0:14:44.20,JPN,NTP,0,0,0,,Ведьманың амулет хош иісі
Dialogue: 0,0:14:44.35,0:14:45.90,JPN,NTP,0,0,0,,Бұл күлкілі әзіл
Dialogue: 0,0:14:47.25,0:14:48.75,JPN,NTP,0,0,0,,Сіз дүбірді естідіңіз бе?
Dialogue: 0,0:14:49.25,0:14:50.65,JPN,NTP,0,0,0,,Кездескенше, Чешир
Dialogue: 0,0:14:51.90,0:14:53.15,JPN,NTP,0,0,0,,Күте тұрыңыз, Байонетта
Dialogue: 0,0:14:55.35,0:14:56.65,JPN,NTP,0,0,0,,Иә!
Dialogue: 0,0:14:59.70,0:15:01.80,JPN,NTP,0,0,0,,Оянатын уақыт таяп қалды
Dialogue: 0,0:15:46.05,0:15:47.25,JPN,NTP,0,0,0,,Жақсы қыз.
Dialogue: 0,0:15:48.70,0:15:52.15,JPN,NTP,0,0,0,,Осы жерде қалсаң, саған жын аңдар шабуыл жасайды.
Dialogue: 0,0:16:06.70,0:16:10.15,JPN,NTP,0,0,0,,Мен қазір лагунаизмнің қасиетті жері Вигридтемін.
Dialogue: 0,0:16:10.15,0:16:11.75,JPN,NTP,0,0,0,,Изабель мұнарасының алдында
Dialogue: 0,0:16:12.50,0:16:13.75,JPN,NTP,0,0,0,,500 жылда бір рет
Dialogue: 0,0:16:13.96,0:16:15.32,JPN,NTP,0,0,0,,Лагунаизмнің басты құдайы
Dialogue: 0,0:16:15.32,0:16:17.96,JPN,NTP,0,0,0,,Биыл Юбелей түседі дейді.
Dialogue: 0,0:16:18.60,0:16:20.56,JPN,NTP,0,0,0,,Дүние жүзінің әртүрлі бөліктерінде діндарлар
Dialogue: 0,0:16:20.56,0:16:22.96,JPN,NTP,0,0,0,,Пасха мейрамы қызу жүріп жатыр
Dialogue: 0,0:16:23.80,0:16:24.96,JPN,NTP,0,0,0,,Бірақ екінші жағынан
Dialogue: 0,0:16:25.20,0:16:26.80,JPN,NTP,0,0,0,,Құдайдың қайта тірілуі үшін оқылады
Dialogue: 0,0:16:26.96,0:16:29.24,JPN,NTP,0,0,0,,Өз-өзіне қол жұмсайтын діндарлар санының шегі жоқ.
Dialogue: 0,0:16:30.00,0:16:32.28,JPN,NTP,0,0,0,,Кеше де Лагуна дінінің бас діни қызметкері
Dialogue: 0,0:16:32.44,0:16:36.00,JPN,NTP,0,0,0,,20-ға жуық сенушімен жаппай өз-өзіне қол жұмсау оқиғасы болды.
Dialogue: 0,0:16:36.44,0:16:39.16,JPN,NTP,0,0,0,,Кейінірек мәйіт сақталған собор болды
Dialogue: 0,0:16:39.44,0:16:41.80,JPN,NTP,0,0,0,,Біреумен жартылай жойылған
Dialogue: 0,0:16:42.48,0:16:44.72,JPN,NTP,0,0,0,,Осы жағдайға жауап ретінде дүние жүзіндегі елдер
Dialogue: 0,0:16:44.72,0:16:46.56,JPN,NTP,0,0,0,,Қалыпты емес жағдай туралы мәлімдеме шығарылды.
Dialogue: 0,0:16:46.84,0:16:49.88,JPN,NTP,0,0,0,,Лагуна сенушілерінен сабырлы жауап сұрау
Dialogue: 0,0:16:51.00,0:16:53.32,JPN,NTP,0,0,0,,Бұл діни қаланы тиімді бақылайды.
Dialogue: 0,0:16:53.32,0:16:55.00,JPN,NTP,0,0,0,,Изабель тобының жетекшісі
Dialogue: 0,0:16:55.36,0:16:59.36,JPN,NTP,0,0,0,,Алғаш рет халықтың алдына шығуы туралы
Dialogue: 0,0:16:58.76,0:17:00.96,JPN,NTP,0,0,0,,Адамзат әлемі дүр сілкінді.
Dialogue: 0,0:17:01.64,0:17:02.80,JPN,NTP,0,0,0,,Күлкілі
Dialogue: 0,0:17:03.04,0:17:06.96,JPN,NTP,0,0,0,,Түсінбейтін құдайдың қайта тірілуі үшін өмірімді құрбан етер едім.
Dialogue: 0,0:17:07.36,0:17:10.00,JPN,NTP,0,0,0,,Олар сондай тітіркендіргіш адамдар.
Dialogue: 0,0:17:10.00,0:17:12.00,JPN,NTP,0,0,0,,Бұл менің ісім деп ойлаймын.
Dialogue: 0,0:17:13.12,0:17:16.96,JPN,NTP,0,0,0,,Жерлеуге қамқорлық жасағаным үшін маған жомарт сыйлық бересіз бе?
Dialogue: 0,0:17:17.40,0:17:19.88,JPN,NTP,0,0,0,,Өзіңді де әлсіз адаммын деп ойламайсың ба?
Dialogue: 0,0:17:20.08,0:17:22.36,JPN,NTP,0,0,0,,Мен әрқашан жақсы адаммын
Dialogue: 0,0:17:22.36,0:17:24.36,JPN,NTP,0,0,0,,Ақшаны алсам ғой
Dialogue: 0,0:17:24.72,0:17:26.16,JPN,NTP,0,0,0,,Парасатты адамдар
Dialogue: 0,0:17:26.16,0:17:28.12,JPN,NTP,0,0,0,,Қорқынышты ашулы табынушы
Dialogue: 0,0:17:28.12,0:17:30.84,JPN,NTP,0,0,0,,Қатысқыңыз келмесе ше?
Dialogue: 0,0:17:31.12,0:17:32.56,JPN,NTP,0,0,0,,Мен не істеп жатырмын
Dialogue: 0,0:17:32.56,0:17:35.04,JPN,NTP,0,0,0,,Бұл қайырымдылық жобасы сияқты.
Dialogue: 0,0:17:36.68,0:17:40.00,JPN,NTP,0,0,0,,Бұл жағдайда ақшаны шіркеуге садақа беріңіз.
Dialogue: 0,0:17:40.76,0:17:44.40,JPN,NTP,0,0,0,,Менің сыйлығымды алғыңыз келе ме?
Dialogue: 0,0:17:44.48,0:17:46.04,JPN,NTP,0,0,0,,Көтерілген жеріміз – құлайтын жеріміз.
Dialogue: 0,0:17:46.16,0:17:48.48,JPN,NTP,0,0,0,,Менің ойымша, сіз періште болу қызық болды.
Dialogue: 0,0:17:48.48,0:17:50.64,JPN,NTP,0,0,0,,Қандай сезімде болды?
Dialogue: 0,0:17:50.84,0:17:52.96,JPN,NTP,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,0:17:54.44,0:17:56.08,JPN,NTP,0,0,0,,Күте тұрыңыз, асықпаңыз.
Dialogue: 0,0:17:56.36,0:17:57.20,JPN,NTP,0,0,0,,Не
Dialogue: 0,0:17:57.76,0:17:58.64,JPN,NTP,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:17:59.12,0:18:00.80,JPN,NTP,0,0,0,,Негізінен собор сізге тиесілі.
Dialogue: 0,0:18:00.80,0:18:03.00,JPN,NTP,0,0,0,,Бұның бәрі жыртылғанына менің кінәм.
Dialogue: 0,0:18:03.24,0:18:05.16,JPN,NTP,0,0,0,,Сізге рахмет, сыйақы тез.
Dialogue: 0,0:18:05.44,0:18:07.28,JPN,NTP,0,0,0,,Кішкене ысырапшыл болсын
Dialogue: 0,0:18:07.96,0:18:09.68,JPN,NTP,0,0,0,,Мұны естігенім үшін кешіріңіз.
Dialogue: 0,0:18:10.40,0:18:13.04,JPN,NTP,0,0,0,,Мазасыз жерлеуге айырбасқа ақпарат
Dialogue: 0,0:18:13.36,0:18:14.28,JPN,NTP,0,0,0,,Мен ғой, мен…-сан ба?
Dialogue: 0,0:18:14.76,0:18:16.24,JPN,NTP,0,0,0,,Мен білемін.
Dialogue: 0,0:18:16.52,0:18:18.20,JPN,NTP,0,0,0,,Тіпті есте сақтау қабілеті де жоқ
Dialogue: 0,0:18:18.20,0:18:20.40,JPN,NTP,0,0,0,,Мен өз есімімді де есіме түсіре алмаймын
Dialogue: 0,0:18:20.40,0:18:22.08,JPN,NTP,0,0,0,,Сіздің көзқарасыңыз сондай үлкен.
Dialogue: 0,0:18:22.40,0:18:23.64,JPN,NTP,0,0,0,,Аты бар
Dialogue: 0,0:18:24.04,0:18:25.28,JPN,NTP,0,0,0,,Байонетта
Dialogue: 0,0:18:25.36,0:18:28.24,JPN,NTP,0,0,0,,Сіз де сол жерге киген шығарсыз.
Dialogue: 0,0:18:28.88,0:18:32.56,JPN,NTP,0,0,0,,20 жыл бұрын көл түбіндегі табыттан оянсам да.
Dialogue: 0,0:18:32.80,0:18:34.64,JPN,NTP,0,0,0,,Менің бақсы болғанымнан басқа
Dialogue: 0,0:18:34.64,0:18:36.20,JPN,NTP,0,0,0,,Менің есімде ештеңе жоқ
Dialogue: 0,0:18:36.20,0:18:37.80,JPN,NTP,0,0,0,,Жұмбақтарға толы әйел
Dialogue: 0,0:18:38.16,0:18:42.04,JPN,NTP,0,0,0,,Періштелерді өлтіріп, құбыжықтарға құрбандық шалу жақсы, бірақ
Dialogue: 0,0:18:42.20,0:18:43.60,JPN,NTP,0,0,0,,Тек оны кесіп тастаңыз.
Dialogue: 0,0:18:43.60,0:18:45.52,JPN,NTP,0,0,0,,Не тиімдірек болуы мүмкін?
Dialogue: 0,0:18:45.52,0:18:48.44,JPN,NTP,0,0,0,,Көп сөйлейтін адам ұзақ өмір сүрмейді.
Dialogue: 0,0:18:51.00,0:18:51.68,JPN,NTP,0,0,0,,Ол
Dialogue: 0,0:18:52.04,0:18:53.40,JPN,NTP,0,0,0,,Isabelle Group көшбасшысы
Dialogue: 0,0:18:53.40,0:18:55.80,JPN,NTP,0,0,0,,Ақыры мистер Балдер пайда болады.
Dialogue: 0,0:18:56.52,0:18:57.56,JPN,NTP,0,0,0,,Мұнда Вигридте
Dialogue: 0,0:18:57.68,0:18:58.92,JPN,NTP,0,0,0,,Isabel Group жасаған
Dialogue: 0,0:18:58.92,0:19:01.68,JPN,NTP,0,0,0,,Экономика орасан зор байлыққа негізделген десек те,
Dialogue: 0,0:19:01.68,0:19:02.76,JPN,NTP,0,0,0,,Артық сөз жоқ
Dialogue: 0,0:19:03.04,0:19:04.60,JPN,NTP,0,0,0,,Сенушілердің ғибадаттарын тарту
Dialogue: 0,0:19:04.60,0:19:06.28,JPN,NTP,0,0,0,,Балдер мырзаның жауабына байланысты.
Dialogue: 0,0:19:06.48,0:19:07.92,JPN,NTP,0,0,0,,Бұл суицид оқиғаларының сериясы...
Dialogue: 0,0:19:07.24,0:19:09.12,JPN,NTP,0,0,0,,О, мына жігіт, мына жігіт.
Dialogue: 0,0:19:09.28,0:19:10.60,JPN,NTP,0,0,0,,Бұл сыйлық ретінде
Dialogue: 0,0:19:10.60,0:19:12.76,JPN,NTP,0,0,0,,Байонеттаға нені үйреткіңіз келді?
Dialogue: 0,0:19:13.24,0:19:16.08,JPN,NTP,0,0,0,,Бұл адам Лагуна дінінің жетекшісі.
Dialogue: 0,0:19:16.40,0:19:17.68,JPN,NTP,0,0,0,,Бір рет болса да жеткілікті
Dialogue: 0,0:19:17.68,0:19:20.20,JPN,NTP,0,0,0,,Көпшілік алдына шықпаған сияқты.
Dialogue: 0,0:19:20.20,0:19:24.00,JPN,NTP,0,0,0,,500 жылдан кейін алғаш рет Пасха мерекесінде пайда болады деп айтылады.
Dialogue: 0,0:19:24.40,0:19:26.88,JPN,NTP,0,0,0,,Алдыңғы Пасхадан бері деген қауесет бар
Dialogue: 0,0:19:26.88,0:19:28.92,JPN,NTP,0,0,0,,Тірі ме, жоқ па?
Dialogue: 0,0:19:29.04,0:19:31.44,JPN,NTP,0,0,0,,Егер бұл рас болса, сіз жай адам емессіз.
Dialogue: 0,0:19:31.84,0:19:33.88,JPN,NTP,0,0,0,,Изабель тобының алдында тұрған нәрсе
Dialogue: 0,0:19:33.88,0:19:36.80,JPN,NTP,0,0,0,,Жақсы ескі діни қала үшін қолайлы емес
Dialogue: 0,0:19:36.80,0:19:38.80,JPN,NTP,0,0,0,,Ең озық технология
Dialogue: 0,0:19:39.24,0:19:42.24,JPN,NTP,0,0,0,,Тіпті мүміндер оны құдайдың қирауы деп айтады.
Dialogue: 0,0:19:42.76,0:19:44.88,JPN,NTP,0,0,0,,Бір дереккөз бойынша
Dialogue: 0,0:19:44.88,0:19:48.24,JPN,NTP,0,0,0,,Балдер - ежелгі және жойылып кеткен аңызға айналған отбасы.
Dialogue: 0,0:19:48.24,0:19:51.12,JPN,NTP,0,0,0,,«Данышпанның ұрпағы» дейді.
Dialogue: 0,0:19:51.48,0:19:53.04,JPN,NTP,0,0,0,,Кез келген ертегі
Dialogue: 0,0:19:53.04,0:19:55.92,JPN,NTP,0,0,0,,Бақсыға қарама-қарсы бейнеленген жарық хабаршысы
Dialogue: 0,0:19:55.92,0:19:58.80,JPN,NTP,0,0,0,,Дана адам қазіргі заманда пайда болды.
Dialogue: 0,0:19:59.84,0:20:02.80,JPN,NTP,0,0,0,,Сіз қалай ойлайсыз? Бұл біршама ақпарат.
Dialogue: 0,0:20:10.70,0:20:13.56,JPN,NTP,0,0,0,,Күтемін, қызым.
Dialogue: 0,0:20:17.92,0:20:20.40,JPN,NTP,0,0,0,,Сыйақы жеткілікті болған сияқты.
Dialogue: 0,0:20:23.28,0:20:24.52,JPN,NTP,0,0,0,,Үйге қайтайық
Dialogue: 0,0:20:24.68,0:20:27.80,JPN,NTP,0,0,0,,Сіздің ұлдарыңыз туған күніңізді тойлап жатқанын естідім.
Dialogue: 0,0:20:28.72,0:20:31.20,JPN,NTP,0,0,0,,Бүгін тағы да алкоголь үшін төлем жасамауды жоспарлап отырсыз ба?
Dialogue: 0,0:20:31.20,0:20:31.84,JPN,NTP,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:20:31.84,0:20:34.64,JPN,NTP,0,0,0,,Бұл сіздің туған күніңізге сыйлық.
Dialogue: 0,0:20:34.64,0:20:36.00,JPN,NTP,0,0,0,,(5-сынып оқушысы 5) Сүтсіз. (4-сынып оқушысы 4) Жырт.
Dialogue: 0,0:20:36.84,0:20:39.84,JPN,NTP,0,0,0,,Жұмыс сұрауын алған кезде бізбен байланысыңыз
Dialogue: 0,0:20:40.96,0:20:43.44,JPN,NTP,0,0,0,,Жоспарсыз бақташының шошқасы Яруга
Dialogue: 0,0:20:44.52,0:20:45.84,JPN,NTP,0,0,0,,Бізге тез сүңгуді үйретіңізші.
Dialogue: 0,0:20:56.48,0:20:59.60,JPN,NTP,0,0,0,,Оянғанда сенде болған нәрсе.
Dialogue: 0,0:21:00.20,0:21:00.80,JPN,NTP,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:21:01.76,0:21:04.56,JPN,NTP,0,0,0,,Одан ештеңе есіңе түспеді ме?
Dialogue: 0,0:21:05.28,0:21:06.00,JPN,NTP,0,0,0,,Иә.
Dialogue: 0,0:21:07.24,0:21:08.32,JPN,NTP,0,0,0,,Бірақ қазір
Dialogue: 0,0:21:08.68,0:21:11.16,JPN,NTP,0,0,0,,Балдер есімді адам
Dialogue: 0,0:21:11.16,0:21:12.84,JPN,NTP,0,0,0,,Өте қызықты.
Dialogue: 0,0:21:13.56,0:21:17.72,JPN,NTP,0,0,0,,Ол адам менің жоғалған естеліктеріммен байланысты.
Dialogue: 0,0:21:18.48,0:21:19.88,JPN,NTP,0,0,0,,Мағынасыздық
Dialogue: 0,0:21:20.40,0:21:22.00,JPN,NTP,0,0,0,,Энцо туралы мәлімет?
Dialogue: 0,0:21:25.28,0:21:26.76,JPN,NTP,0,0,0,,Өзін әйел сияқты сезіну
Dialogue: 0,0:21:28.56,0:21:30.60,JPN,NTP,0,0,0,,Сіз Вигридке барасыз ба?
Dialogue: 0,0:21:30.96,0:21:31.44,JPN,NTP,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:21:40.56,0:21:42.68,JPN,NTP,0,0,0,,Өзіңізге ұнайтын нәрсені алыңыз.
Dialogue: 0,0:22:02.84,0:22:05.24,JPN,NTP,0,0,0,,500 жыл күту
Dialogue: 0,0:22:05.24,0:22:07.36,JPN,NTP,0,0,0,,Уақыт келді
Dialogue: 0,0:22:07.64,0:22:10.28,JPN,NTP,0,0,0,,Ол бала да бір күні осында келеді.
Dialogue: 0,0:22:11.32,0:22:15.16,JPN,NTP,0,0,0,,500 жыл бұрынғы нәрсені қайталаймыз ба?
Dialogue: 0,0:22:15.40,0:22:16.36,JPN,NTP,0,0,0,,Әлде…
Dialogue: 0,0:22:16.72,0:22:19.96,JPN,NTP,0,0,0,,Ол бала үшін бір ғана жол бар.
Dialogue: 0,0:22:19.96,0:22:21.20,JPN,NTP,0,0,0,,Ойласам, ол бәріне белгілі нәрсе ғой.
Dialogue: 0,0:22:21.28,0:22:26.44,JPN,NTP,0,0,0,,Өйткені мен үш дүниенің қағидасын түсінемін және бәрін көремін.
Dialogue: 0,0:22:26.72,0:22:27.64,JPN,NTP,0,0,0,,Иә
Dialogue: 0,0:22:28.00,0:22:29.64,JPN,NTP,0,0,0,,Әрі қарай не істейді
Dialogue: 0,0:22:29.84,0:22:34.00,JPN,NTP,0,0,0,,Бұл жоғарғы дүниеде сызу сызбаларын қайта құру үшін жасалған игі іс.
Dialogue: 0,0:22:34.00,0:22:35.88,JPN,NTP,0,0,0,,Жарық көз деп нені атауға болады
Dialogue: 0,0:22:35.88,0:22:38.16,JPN,NTP,0,0,0,,Тәртіптен гөрі хаосты таңдау
Dialogue: 0,0:22:38.16,0:22:41.48,JPN,NTP,0,0,0,,Жоқ. Қазір хаостың уақыты.
Dialogue: 0,0:22:41.56,0:22:44.56,JPN,NTP,0,0,0,,Қызыммен бірге әлемнің көзіне айналамыз.
Dialogue: 0,0:22:44.80,0:22:47.60,JPN,NTP,0,0,0,,Үш дүние толығымен бір болмайынша
Dialogue: 0,0:22:47.72,0:22:50.56,JPN,NTP,0,0,0,,Шынайы тәртіп Шынайы құтқару жоқ
Dialogue: 0,0:22:51.56,0:22:53.28,JPN,NTP,0,0,0,,Жындының логикасы осындай.
Dialogue: 0,0:22:54.00,0:22:56.84,JPN,NTP,0,0,0,,Мен оны сіз сияқты түсіне алмаймын.
Dialogue: 0,0:22:57.28,0:23:00.16,JPN,NTP,0,0,0,,Мені тастап кете алмағаныңыз өкінішті.
Dialogue: 0,0:23:01.04,0:23:04.72,JPN,NTP,0,0,0,,Періштелер өте жақсы жұмыс істейді
Dialogue: 0,0:23:05.92,0:23:09.00,JPN,NTP,0,0,0,,Жанна, сен де.
Dialogue: 0,0:23:11.96,0:23:14.16,JPN,NTP,0,0,0,,Мен 500 жыл күттім.
Dialogue: 0,0:23:14.44,0:23:18.56,JPN,NTP,0,0,0,,Ол қызды қайта көруді асыға күтетін шығарсыз.
Dialogue: 0,0:23:19.24,0:23:23.64,JPN,NTP,0,0,0,,Барлығы басты құдай Юбелейді көрсету үшін
Dialogue: 0,0:23:26.88,0:23:30.40,JPN,NTP,0,0,0,,Жаңа дүниенің құрылатын уақыты жақын
Dialogue: 0,0:23:44.80,0:23:46.62,JPN,NTP,0,0,0,,Жад қауіпсіз болды ма?
Dialogue: 0,0:23:48.80,0:23:52.22,JPN,NTP,0,0,0,,Осы жолы оның шынайы болмысын қайта түсіре алмадың ба?
Dialogue: 0,0:23:54.35,0:23:57.42,JPN,NTP,0,0,0,,Келесіде қайда шығуды жоспарлайсыз? Байонетта
Dialogue: 0,0:24:05.15,0:24:08.31,JPN,NTP,0,0,0,,Лагунаизм Данышпандардың ұрпақтары
Dialogue: 0,0:24:14.08,0:24:17.02,JPN,NTP,0,0,0,,Менің әкем 500 жыл бұрын қайтыс болды.
Dialogue: 0,0:24:17.02,0:24:19.02,JPN,NTP,0,0,0,,Данышпан мен бақсының жұмбағын қуу
Dialogue: 0,0:24:19.82,0:24:21.82,JPN,NTP,0,0,0,,Сиқыршы Байонетта өлтірді
Dialogue: 0,0:24:45.28,0:24:50.00,JPN,NTP,0,0,0,,Оян, қызым.
Dialogue: 0,0:24:55.37,0:24:56.40,JPN,NTP,0,0,0,,Әке
Dialogue: 0,0:24:57.60,0:25:00.00,JPN,NTP,0,0,0,,Иә, келіңіз.
Dialogue: 0,0:25:50.80,0:25:52.88,JPN,NTP,0,0,0,,Кешіріңіз, бірақ қайсысы?
Dialogue: 0,0:26:13.15,0:26:16.04,JPN,NTP,0,0,0,,Сізде мен сияқты сиқыр бар, солай ма?
Dialogue: 0,0:26:16.48,0:26:19.28,JPN,NTP,0,0,0,,Мен сенен тағы сұрайын, сен кімсің?
Dialogue: 0,0:26:21.28,0:26:25.06,JPN,NTP,0,0,0,,Ұзақ ұйқыдан кейін санаң тұншығып қалған сияқты.
Dialogue: 0,0:26:25.86,0:26:28.57,JPN,NTP,0,0,0,,Мен сенімен кездесіп жүрмін бе деп ойлаймын.
Dialogue: 0,0:26:29.15,0:26:31.51,JPN,NTP,0,0,0,,Сіз мені танитын сияқтысыз.
Dialogue: 0,0:26:31.95,0:26:34.66,JPN,NTP,0,0,0,,Мүмкін мен сенен артық білетін шығармын.
Dialogue: 0,0:26:35.42,0:26:37.24,JPN,NTP,0,0,0,,Мен барған сайын алаңдай бастадым.
Dialogue: 0,0:26:37.60,0:26:40.71,JPN,NTP,0,0,0,,Мені жеңе алсаң, мен саған үйретемін.
Dialogue: 0,0:26:51.37,0:26:52.75,JPN,NTP,0,0,0,,Қызық осы жерден басталады
Dialogue: 0,0:27:12.84,0:27:15.02,JPN,NTP,0,0,0,,Біраз уақыт өтті, бұл сезім
Dialogue: 0,0:27:15.37,0:27:17.64,JPN,NTP,0,0,0,,Сіз қалай ойлайсыз? Есіңде ештеңе жоқ па?
Dialogue: 0,0:27:18.44,0:27:19.68,JPN,NTP,0,0,0,,Бұл жақсы.
Dialogue: 0,0:27:20.13,0:27:21.51,JPN,NTP,0,0,0,,Егер мен сені ұрсам
Dialogue: 0,0:27:21.51,0:27:23.68,JPN,NTP,0,0,0,,Мен есте сақтай алатындай сезінемін.
Dialogue: 0,0:27:24.13,0:27:25.37,JPN,NTP,0,0,0,,Ол көңілсіз.
Dialogue: 0,0:28:10.71,0:28:14.22,JPN,NTP,0,0,0,,Әй, сенің күшің осы деңгейде ме?
Dialogue: 0,0:28:14.71,0:28:15.86,JPN,NTP,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:28:16.17,0:28:18.53,JPN,NTP,0,0,0,,Бірлесіп жұмыс жасасақ түсінетін шығармыз.
Dialogue: 0,0:28:19.77,0:28:22.97,JPN,NTP,0,0,0,,Сол ойыншықпен тағы не істеуге болады?
Dialogue: 0,0:28:23.51,0:28:26.57,JPN,NTP,0,0,0,,Менің ойымша, сіз әлі қызықсыз.
Dialogue: 0,0:28:30.40,0:28:31.06,JPN,NTP,0,0,0,,ақымақ
Dialogue: 0,0:28:32.75,0:28:34.57,JPN,NTP,0,0,0,,Бұл мағынасы жоқ.
Dialogue: 0,0:29:20.35,0:29:21.33,JPN,NTP,0,0,0,,Сәлем әке
Dialogue: 0,0:29:21.51,0:29:23.15,JPN,NTP,0,0,0,,Анам осында
Dialogue: 0,0:29:23.42,0:29:26.13,JPN,NTP,0,0,0,,Әй, жақсы қыз болсаң.
Dialogue: 0,0:29:26.35,0:29:29.33,JPN,NTP,0,0,0,,Жақында анам келіп алып кетеді.
Dialogue: 0,0:29:29.73,0:29:31.42,JPN,NTP,0,0,0,,Сереза ​​жақсы қыз.
Dialogue: 0,0:29:32.00,0:29:34.62,JPN,NTP,0,0,0,,Олай болса анаңды өзің күте аласың.
Dialogue: 0,0:29:35.02,0:29:35.95,JPN,NTP,0,0,0,,Әрине
Dialogue: 0,0:29:47.60,0:29:49.68,JPN,NTP,0,0,0,,Чешир Жақсы емес пе?
Dialogue: 0,0:29:51.68,0:29:54.62,JPN,NTP,0,0,0,,Мама, мені тез алып кетіңізші.
Dialogue: 0,0:30:22.71,0:30:24.97,JPN,NTP,0,0,0,,Қызық, бұл бар осындай жерде болды ма?
Dialogue: 0,0:30:25.86,0:30:27.24,JPN,NTP,0,0,0,,Уақытша дүкеннің ашылуы
Dialogue: 0,0:30:28.22,0:30:30.17,JPN,NTP,0,0,0,,Маған не айтарыңыз бар?
Dialogue: 0,0:30:30.17,0:30:31.55,JPN,NTP,0,0,0,,Мен солай деп ойладым
Dialogue: 0,0:30:32.31,0:30:34.13,JPN,NTP,0,0,0,,Мұны естіген рыцарь шошып кетеді.
Dialogue: 0,0:30:34.40,0:30:36.13,JPN,NTP,0,0,0,,Сіз де солай ойлайсыз.
Dialogue: 0,0:30:36.97,0:30:39.68,JPN,NTP,0,0,0,,Мұны қалай пайдалануға болады?
Dialogue: 0,0:30:40.13,0:30:42.93,JPN,NTP,0,0,0,,Мен жаңа ғана мінезі нашар әйелмен атыс болдым.
Dialogue: 0,0:30:45.37,0:30:47.24,JPN,NTP,0,0,0,,Сіз өзіңізге оқ аттыңыз ба?
Dialogue: 0,0:30:47.82,0:30:48.31,JPN,NTP,0,0,0,,Иә
Dialogue: 0,0:30:50.13,0:30:51.37,JPN,NTP,0,0,0,,Жөндеу
Dialogue: 0,0:30:51.91,0:30:54.35,JPN,NTP,0,0,0,,Келесі жолы қатаңдатыңыз.
Dialogue: 0,0:30:57.46,0:30:58.93,JPN,NTP,0,0,0,,Ішуге барғыңыз келе ме?
Dialogue: 0,0:30:59.77,0:31:00.93,JPN,NTP,0,0,0,,Асығыңыз!
Dialogue: 0,0:31:01.73,0:31:05.28,JPN,NTP,0,0,0,,Мен өзімді қанағаттандыратын түнді асыға күтемін.
Dialogue: 0,0:31:23.60,0:31:28.08,JPN,NTP,0,0,0,,Анам Анам қайда
Dialogue: 0,0:31:40.48,0:31:42.97,JPN,NTP,0,0,0,,Шамасы мені айналып өтуге мәжбүр еткен адам
Dialogue: 0,0:31:42.97,0:31:44.62,JPN,NTP,0,0,0,,Роденнен де көп нәрсе бар сияқты.
Dialogue: 0,0:31:45.73,0:31:47.68,JPN,NTP,0,0,0,,Енді бұл қай жер?
Dialogue: 0,0:31:48.31,0:31:51.06,JPN,NTP,0,0,0,,Бұл той өтетін орын емес.
Dialogue: 0,0:31:52.31,0:31:55.46,JPN,NTP,0,0,0,,Мумия Ана
Dialogue: 0,0:32:00.48,0:32:01.42,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:32:03.02,0:32:04.88,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:32:05.46,0:32:07.42,JPN,NTP,0,0,0,,Мумия Ана
Dialogue: 0,0:32:11.11,0:32:12.22,JPN,NTP,0,0,0,,Елес
Dialogue: 0,0:32:13.02,0:32:14.53,JPN,NTP,0,0,0,,Періштелерді көре аласыз ба?
Dialogue: 0,0:32:21.60,0:32:22.00,JPN,NTP,0,0,0,,Жоқ
Dialogue: 0,0:32:23.46,0:32:26.22,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:32:28.22,0:32:29.64,JPN,NTP,0,0,0,,Бұл қиындық тудырады.
Dialogue: 0,0:32:50.71,0:32:52.31,JPN,NTP,0,0,0,,Менімен ойнағың келе ме?
Dialogue: 0,0:32:52.71,0:32:54.44,JPN,NTP,0,0,0,,Мен сенімен бірден айналысамын.
Dialogue: 0,0:33:15.95,0:33:17.06,JPN,NTP,0,0,0,,Чешир
Dialogue: 0,0:33:17.42,0:33:18.57,JPN,NTP,0,0,0,,Чешир
Dialogue: 0,0:33:18.84,0:33:19.68,JPN,NTP,0,0,0,,Чешир
Dialogue: 0,0:33:31.46,0:33:32.48,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:33:33.20,0:33:34.88,JPN,NTP,0,0,0,,Жылауды тоқтатыңыз
Dialogue: 0,0:33:35.73,0:33:38.31,JPN,NTP,0,0,0,,Мен жылауық балалар мен тарақандарды жек көремін.
Dialogue: 0,0:33:39.20,0:33:41.86,JPN,NTP,0,0,0,,Ал мен сенің анаң емеспін.
Dialogue: 0,0:33:42.57,0:33:44.80,JPN,NTP,0,0,0,,Иә, анашым
Dialogue: 0,0:33:48.75,0:33:50.22,JPN,NTP,0,0,0,,Чибисуке, жасырыншы.
Dialogue: 0,0:33:50.97,0:33:53.46,JPN,NTP,0,0,0,,Менімен мұны істегісі келетін періште бар.
Dialogue: 0,0:33:54.53,0:33:56.80,JPN,NTP,0,0,0,,Ол балаға зиянын тигізетін сияқты.
Dialogue: 0,0:33:56.80,0:33:58.31,JPN,NTP,0,0,0,,Бұлай істеуге ниетіңіз жоқ сияқты.
Dialogue: 0,0:33:59.46,0:34:01.73,JPN,NTP,0,0,0,,Осы жерге дейін келіңіз.
Dialogue: 0,0:34:02.04,0:34:04.17,JPN,NTP,0,0,0,,Мақсаты не деп ойлаймын
Dialogue: 0,0:34:04.97,0:34:07.20,JPN,NTP,0,0,0,,Әй, жарайды, солай ма?
Dialogue: 0,0:34:07.64,0:34:10.93,JPN,NTP,0,0,0,,Бұл менің бас құдайымның қайта тірілуінің негізі болады.
Dialogue: 0,0:34:11.46,0:34:13.37,JPN,NTP,0,0,0,,Жүр, билейік
Dialogue: 0,0:34:20.80,0:34:22.17,JPN,NTP,0,0,0,,Бұл көңілді болатын сияқты
Dialogue: 0,0:34:40.88,0:34:42.66,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:34:52.66,0:34:54.97,JPN,NTP,0,0,0,,Менімен осылай жасағың келе ме?
Dialogue: 0,0:34:55.46,0:34:57.91,JPN,NTP,0,0,0,,Мен оны орындауға бар күшімді саламын
Dialogue: 0,0:34:59.42,0:35:00.53,JPN,NTP,0,0,0,,Жаман бала
Dialogue: 0,0:35:00.93,0:35:04.88,JPN,NTP,0,0,0,,Саған қатал жаза керек емес пе?
Dialogue: 0,0:35:17.37,0:35:18.75,JPN,NTP,0,0,0,,Қош келдіңіз
Dialogue: 0,0:35:19.28,0:35:21.51,JPN,NTP,0,0,0,,Мен сізге ыңғайлы көтерілуге рұқсат етемін.
Dialogue: 0,0:35:24.00,0:35:27.28,JPN,NTP,0,0,0,,Бас құдай Юбелейге даңқ
Dialogue: 0,0:35:50.80,0:35:53.82,JPN,NTP,0,0,0,,Мумия Ана
Dialogue: 0,0:35:56.13,0:35:58.13,JPN,NTP,0,0,0,,Кішкентай баланың аты кім?
Dialogue: 0,0:35:58.57,0:35:59.77,JPN,NTP,0,0,0,,Сереза.
Dialogue: 0,0:36:00.08,0:36:02.08,JPN,NTP,0,0,0,,Ұмытып кетіппін, мама
Dialogue: 0,0:36:02.62,0:36:05.28,JPN,NTP,0,0,0,,Енді есімде жоқ шығар.
Dialogue: 0,0:36:06.17,0:36:08.22,JPN,NTP,0,0,0,,Неліктен мұндай қорқынышты жер?
Dialogue: 0,0:36:08.66,0:36:11.60,JPN,NTP,0,0,0,,Әке, мама сізді алып кетуге келеді.
Dialogue: 0,0:36:11.60,0:36:13.15,JPN,NTP,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:36:13.82,0:36:15.64,JPN,NTP,0,0,0,,Сізді жалғыз қалдыру
Dialogue: 0,0:36:16.04,0:36:19.06,JPN,NTP,0,0,0,,Сен жалғыз емессің, Чеширмен біргесің.
Dialogue: 0,0:36:19.24,0:36:21.06,JPN,NTP,0,0,0,,Қорқып жылап жатсам да
Dialogue: 0,0:36:21.46,0:36:23.68,JPN,NTP,0,0,0,,Мама, үйге қайтайық.
Dialogue: 0,0:36:24.04,0:36:25.82,JPN,NTP,0,0,0,,Мені қайта-қайта айтуға мәжбүрлеме
Dialogue: 0,0:36:26.26,0:36:28.22,JPN,NTP,0,0,0,,Мен сенің анаң емеспін
Dialogue: 0,0:36:28.71,0:36:30.97,JPN,NTP,0,0,0,,Жақында әкем келіп, мені алып кетеді.
Dialogue: 0,0:36:31.33,0:36:34.08,JPN,NTP,0,0,0,,Маған анаммен бірге болған ұнайды.
Dialogue: 0,0:36:36.66,0:36:38.00,JPN,NTP,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:36:47.24,0:36:48.04,JPN,NTP,0,0,0,,Келіңіздер
Dialogue: 0,0:36:50.04,0:36:51.33,JPN,NTP,0,0,0,,Иә, анашым
Dialogue: 0,0:36:57.55,0:36:59.37,JPN,NTP,0,0,0,,Не деген сұмдық бала.
Dialogue: 0,0:37:24.66,0:37:26.13,JPN,NTP,0,0,0,,Не болды, мама?
Dialogue: 0,0:37:26.40,0:37:28.13,JPN,NTP,0,0,0,,Чибисуке Бұл
Dialogue: 0,0:37:28.62,0:37:31.82,JPN,NTP,0,0,0,,Мамам туған күніме сыйлаған шығар.
Dialogue: 0,0:37:36.53,0:37:38.00,JPN,NTP,0,0,0,,Қайта құлама.
Dialogue: 0,0:37:38.22,0:37:38.75,JPN,NTP,0,0,0,,Иә
Dialogue: 0,0:37:42.57,0:37:44.08,JPN,NTP,0,0,0,,Мықтап ұстаңыз
Dialogue: 0,0:37:44.08,0:37:45.15,JPN,NTP,0,0,0,,Иә, анашым
Dialogue: 0,0:37:45.60,0:37:47.02,JPN,NTP,0,0,0,,Мумияға тыйым салынған
Dialogue: 0,0:37:47.02,0:37:48.26,JPN,NTP,0,0,0,,Иә, анашым
Dialogue: 0,0:38:24.71,0:38:27.91,JPN,NTP,0,0,0,,Мен мамаммен шомылғаныма біраз болды, сондықтан қызық.
Dialogue: 0,0:38:28.48,0:38:29.51,JPN,NTP,0,0,0,,Мүлдем
Dialogue: 0,0:38:29.95,0:38:32.71,JPN,NTP,0,0,0,,Чибисуке мені кіргізуімді өтініп жатса да.
Dialogue: 0,0:38:40.53,0:38:42.97,JPN,NTP,0,0,0,,Мен әрқашан анамның қасында емеспін.
Dialogue: 0,0:38:43.33,0:38:44.26,JPN,NTP,0,0,0,,Сіз білесіз
Dialogue: 0,0:38:44.71,0:38:47.68,JPN,NTP,0,0,0,,Мен бөлмемде жалғыз болдым.
Dialogue: 0,0:38:48.40,0:38:50.66,JPN,NTP,0,0,0,,Анам да жылауық сәбилерді жек көреді.
Dialogue: 0,0:38:50.80,0:38:52.35,JPN,NTP,0,0,0,,Мен жылауық емеспін
Dialogue: 0,0:38:53.37,0:38:56.48,JPN,NTP,0,0,0,,Мама, неге мені көруге келмейсіз?
Dialogue: 0,0:38:57.02,0:38:58.93,JPN,NTP,0,0,0,,Неге мені жалғыз қалдырасың?
Dialogue: 0,0:38:59.46,0:39:01.15,JPN,NTP,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:39:01.64,0:39:03.95,JPN,NTP,0,0,0,,Мен сенің анаң емеспін
Dialogue: 0,0:39:04.88,0:39:06.17,JPN,NTP,0,0,0,,Анамның ақымақ
Dialogue: 0,0:39:10.88,0:39:12.71,JPN,NTP,0,0,0,,Мен ұзақ уақыт жалғыз болдым
Dialogue: 0,0:39:14.44,0:39:15.33,JPN,NTP,0,0,0,,Достар
Dialogue: 0,0:39:16.08,0:39:16.84,JPN,NTP,0,0,0,,Чешир
Dialogue: 0,0:39:30.62,0:39:31.51,JPN,NTP,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:39:31.51,0:39:33.51,JPN,NTP,0,0,0,,Қарға ұқсайды, мама.
Dialogue: 0,0:39:34.84,0:39:35.95,JPN,NTP,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:39:43.82,0:39:46.31,JPN,NTP,0,0,0,,Бөлме қызметіне тапсырыс бергенім есімде жоқ.
Dialogue: 0,0:39:47.24,0:39:49.82,JPN,NTP,0,0,0,,Есеп беру әдісін таңдамасаңыз, сізді сотқа тартасыз.
Dialogue: 0,0:39:51.28,0:39:54.17,JPN,NTP,0,0,0,,Сіз сиқыршымен күресудің кез келген әдісін таңдай аласыз ба?
Dialogue: 0,0:39:54.71,0:39:55.15,JPN,NTP,0,0,0,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:39:57.33,0:39:59.64,JPN,NTP,0,0,0,,Мама, бұл аға кім?
Dialogue: 0,0:40:00.00,0:40:01.68,JPN,NTP,0,0,0,,Чешир №
Dialogue: 0,0:40:01.91,0:40:05.42,JPN,NTP,0,0,0,,Әйелдердің суретін жасырын түсіретін бұзық.
Dialogue: 0,0:40:06.00,0:40:07.11,JPN,NTP,0,0,0,,Оған не болды?
Dialogue: 0,0:40:07.24,0:40:08.22,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:40:08.62,0:40:10.75,JPN,NTP,0,0,0,,О, сіздің балаларыңыз болды ма?
Dialogue: 0,0:40:11.28,0:40:12.75,JPN,NTP,0,0,0,,Бұл жаман әзіл.
Dialogue: 0,0:40:13.91,0:40:17.20,JPN,NTP,0,0,0,,Жарайды, мен отбасын құруға қызығамын.
Dialogue: 0,0:40:19.55,0:40:21.64,JPN,NTP,0,0,0,,Мені осындай нәрсе қызықтырады.
Dialogue: 0,0:40:23.20,0:40:25.46,JPN,NTP,0,0,0,,Қызығушылық
Dialogue: 0,0:40:26.26,0:40:30.00,JPN,NTP,0,0,0,,Кио Кёу Ми
Dialogue: 0,0:40:30.44,0:40:31.42,JPN,NTP,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:40:31.42,0:40:33.11,JPN,NTP,0,0,0,,А құлады.
Dialogue: 0,0:40:34.08,0:40:36.13,JPN,NTP,0,0,0,,Нағашы қайтыс болды.
Dialogue: 0,0:40:36.26,0:40:38.80,JPN,NTP,0,0,0,,Бұл сізді алып кетуге елес келмеді дегенді білдіре ме?
Dialogue: 0,0:40:38.80,0:40:39.86,JPN,NTP,0,0,0,,Сіз тірісіз.
Dialogue: 0,0:40:40.17,0:40:41.42,JPN,NTP,0,0,0,,Екі қолда да даңқ; жеңіс – біздің әніміз
Dialogue: 0,0:40:44.84,0:40:47.51,JPN,NTP,0,0,0,,Шүкір, мен кәрі емеспін.
Dialogue: 0,0:41:17.33,0:41:19.02,JPN,NTP,0,0,0,,Сіз әлі ұйықтап қалдыңыз ба?
Dialogue: 0,0:41:19.46,0:41:20.44,JPN,NTP,0,0,0,,Сіз табандысыз.
Dialogue: 0,0:41:21.33,0:41:23.11,JPN,NTP,0,0,0,,Тіпті осындай ойыншық орнатыңыз
Dialogue: 0,0:41:23.37,0:41:25.46,JPN,NTP,0,0,0,,Чешир, сен қашанға дейін тұрасың?
Dialogue: 0,0:41:26.13,0:41:26.88,JPN,NTP,0,0,0,,Лұқа
Dialogue: 0,0:41:33.24,0:41:34.31,JPN,NTP,0,0,0,,Байонетта
Dialogue: 0,0:41:34.71,0:41:37.20,JPN,NTP,0,0,0,,Бұл қалада не болады?
Dialogue: 0,0:41:37.82,0:41:38.93,JPN,NTP,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,0:41:39.20,0:41:40.75,JPN,NTP,0,0,0,,Онда неге мұндасың?
Dialogue: 0,0:41:41.82,0:41:43.46,JPN,NTP,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:41:45.20,0:41:48.57,JPN,NTP,0,0,0,,Әкемді өлтірсем де бәрібір.
Dialogue: 0,0:41:49.20,0:41:51.60,JPN,NTP,0,0,0,,Мен бұл болжамды естуден шаршадым.
Dialogue: 0,0:41:52.13,0:41:53.60,JPN,NTP,0,0,0,,Сіз қайтадан ақымақ болуды жоспарлап отырсыз ба?
Dialogue: 0,0:41:54.57,0:41:56.22,JPN,NTP,0,0,0,,Менің әкем журналист болған.
Dialogue: 0,0:41:56.62,0:41:59.46,JPN,NTP,0,0,0,,Бақсы мен данышпан тұқымының жұмбағын шешу
Dialogue: 0,0:41:59.73,0:42:01.68,JPN,NTP,0,0,0,,Бүкіл өмірін арнады
Dialogue: 0,0:42:03.91,0:42:06.75,JPN,NTP,0,0,0,,Мен ол бақсы өлтіреді деп ешқашан ойламадым.
Dialogue: 0,0:42:06.75,0:42:08.44,JPN,NTP,0,0,0,,Сіз бұл туралы армандадыңыз ба?
Dialogue: 0,0:42:10.53,0:42:12.40,JPN,NTP,0,0,0,,Өзіңіздің шынайы болмысыңызды ашу арқылы
Dialogue: 0,0:42:12.66,0:42:15.28,JPN,NTP,0,0,0,,Әкем аңсаған жұмбақтың шешілуі мүмкін.
Dialogue: 0,0:42:16.00,0:42:17.95,JPN,NTP,0,0,0,,Әкем қалдырған жеке жазба бойынша.
Dialogue: 0,0:42:18.26,0:42:19.77,JPN,NTP,0,0,0,,500 жыл бұрын осы жерде
Dialogue: 0,0:42:20.44,0:42:23.91,JPN,NTP,0,0,0,,Даналар мен бақсылардың руы кенеттен жоғалып кетеді.
Dialogue: 0,0:42:24.44,0:42:26.40,JPN,NTP,0,0,0,,Олардың дәстүрі де тоқтады.
Dialogue: 0,0:42:27.55,0:42:31.28,JPN,NTP,0,0,0,,Бірақ осыдан 20 жыл бұрын Байонетта сиқыры қайта тірілді.
Dialogue: 0,0:42:31.82,0:42:34.80,JPN,NTP,0,0,0,,Данышпандардың ұрпақтары қолдаған Балдердің пайда болуы
Dialogue: 0,0:42:35.82,0:42:38.84,JPN,NTP,0,0,0,,Мен оның осы Пасха мерекесіне қатысы бар деп ойлаймын.
Dialogue: 0,0:42:40.17,0:42:41.60,JPN,NTP,0,0,0,,Сіз Балдерді көретін шығарсыз.
Dialogue: 0,0:42:42.40,0:42:44.35,JPN,NTP,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:42:45.33,0:42:47.28,JPN,NTP,0,0,0,,Естеліктеріңіз қайта оралғанда
Dialogue: 0,0:42:48.08,0:42:50.13,JPN,NTP,0,0,0,,Мен әкемді не үшін өлтіргенімді де білемін.
Dialogue: 0,0:42:50.40,0:42:52.75,JPN,NTP,0,0,0,,Сонда не болды?
Dialogue: 0,0:42:53.91,0:42:56.80,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:42:57.91,0:42:59.24,JPN,NTP,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:42:58.80,0:42:59.82,JPN,NTP,0,0,0,,Кішкентай көмек
Dialogue: 0,0:43:00.66,0:43:02.26,JPN,NTP,0,0,0,,Мен бала күтумен айналысамын.
Dialogue: 0,0:43:00.75,0:43:02.13,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:43:02.53,0:43:04.57,JPN,NTP,0,0,0,,Мен саған өзімді күштеп алғым келеді
Dialogue: 0,0:43:04.31,0:43:05.95,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:43:05.11,0:43:06.75,JPN,NTP,0,0,0,,А, бұл да жақсы болуы мүмкін.
Dialogue: 0,0:43:07.02,0:43:08.53,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:43:10.71,0:43:12.66,JPN,NTP,0,0,0,,Мама, қайда болдың?
Dialogue: 0,0:43:12.97,0:43:14.31,JPN,NTP,0,0,0,,Мен жалғыз болдым
Dialogue: 0,0:43:14.31,0:43:16.04,JPN,NTP,0,0,0,,Егер сіз тағы бір секунд жыласаңыз
Dialogue: 0,0:43:16.48,0:43:17.68,JPN,NTP,0,0,0,,Мен сенімен ұйықтамаймын.
Dialogue: 0,0:43:17.95,0:43:21.28,JPN,NTP,0,0,0,,Иә, біз әрқашан бірге боламыз, мама.
Dialogue: 0,0:43:51.42,0:43:52.57,JPN,NTP,0,0,0,,Не болды, қыз?
Dialogue: 0,0:43:52.97,0:43:56.97,JPN,NTP,0,0,0,,Мен жылауық баламын
Dialogue: 0,0:43:57.42,0:44:00.57,JPN,NTP,0,0,0,,Ананың кеткені сондықтан
Dialogue: 0,0:44:00.84,0:44:02.80,JPN,NTP,0,0,0,,Байонетта жоғалып кетті
Dialogue: 0,0:44:03.02,0:44:03.64,JPN,NTP,0,0,0,,Мүмкін емес
Dialogue: 0,0:44:04.57,0:44:07.33,JPN,NTP,0,0,0,,Маған өзіңізді қатты мәжбүрледіңіз бе?
Dialogue: 0,0:44:08.57,0:44:11.91,JPN,NTP,0,0,0,,Жарайды, ағаммен анамды тауып алайық.
Dialogue: 0,0:44:12.08,0:44:14.35,JPN,NTP,0,0,0,,Иә аға
Dialogue: 0,0:44:15.86,0:44:19.20,JPN,NTP,0,0,0,,Ханым, мен сенің ағаңмын.
Dialogue: 0,0:44:19.20,0:44:20.53,JPN,NTP,0,0,0,,Иә аға
Dialogue: 0,0:44:20.75,0:44:24.22,JPN,NTP,0,0,0,,А, тезірек барайық.
Dialogue: 0,0:44:27.11,0:44:32.88,JPN,NTP,0,0,0,,Дүниені басқаратын екі көз қазірдің өзінде тураланған
Dialogue: 0,0:44:32.88,0:44:35.24,JPN,NTP,0,0,0,,Басты құдай қайта тірілуге жақын болғандықтан
Dialogue: 0,0:44:35.37,0:44:39.02,JPN,NTP,0,0,0,,Періштелер әдеттегіден гөрі шулайды
Dialogue: 0,0:44:40.44,0:44:44.22,JPN,NTP,0,0,0,,Сол көзді ояту үшін сен құрбансың.
Dialogue: 0,0:44:44.48,0:44:47.46,JPN,NTP,0,0,0,,Біздің ниетіміз бір
Dialogue: 0,0:44:47.91,0:44:52.22,JPN,NTP,0,0,0,,Бірақ бәрі менің тілегіме жету үшін
Dialogue: 0,0:44:52.62,0:44:57.42,JPN,NTP,0,0,0,,Иә, жаңа әлем құру үшін
Dialogue: 0,0:45:22.31,0:45:24.26,JPN,NTP,0,0,0,,Бұл өте жақсы көлік.
Dialogue: 0,0:45:24.62,0:45:26.80,JPN,NTP,0,0,0,,Оны ысырап ету босқа.
Dialogue: 0,0:45:36.62,0:45:37.02,JPN,NTP,0,0,0,,Иә
Dialogue: 0,0:45:37.82,0:45:38.35,JPN,NTP,0,0,0,,Не?
Dialogue: 0,0:45:39.68,0:45:41.37,JPN,NTP,0,0,0,,Бір нәрсе жақындап қалды
Dialogue: 0,0:45:44.13,0:45:45.33,JPN,NTP,0,0,0,,Сіз бірдеңе көріп тұрсыз ба?
Dialogue: 0,0:45:46.00,0:45:46.66,JPN,NTP,0,0,0,,Жоқ
Dialogue: 0,0:46:28.62,0:46:29.64,JPN,NTP,0,0,0,,Мазасыз жігіт
Dialogue: 0,0:46:33.95,0:46:35.86,JPN,NTP,0,0,0,,Сіз мұны керемет түрде жасадыңыз.
Dialogue: 0,0:46:37.91,0:46:41.24,JPN,NTP,0,0,0,,Ханым, мамамның жүріп өткен жолын түсіну оңай.
Dialogue: 0,0:46:41.51,0:46:42.00,JPN,NTP,0,0,0,,Иә
Dialogue: 0,0:46:48.31,0:46:50.17,JPN,NTP,0,0,0,,TELOC VOVIM
Dialogue: 0,0:46:57.11,0:46:59.06,JPN,NTP,0,0,0,,Сізге ұнады деп үміттенемін.
Dialogue: 0,0:46:59.55,0:47:02.00,JPN,NTP,0,0,0,,Мен сені келесі жолы қуантамын.
Dialogue: 0,0:47:17.64,0:47:20.97,JPN,NTP,0,0,0,,Келесі жолы мені жақсырақ көлікпен кездесуге апарыңыз.
Dialogue: 0,0:47:32.04,0:47:33.46,JPN,NTP,0,0,0,,Бірінен соң бірі
Dialogue: 0,0:47:34.00,0:47:35.46,JPN,NTP,0,0,0,,Менің денемде ол жоқ.
Dialogue: 0,0:47:36.93,0:47:41.60,JPN,NTP,0,0,0,,Менің жаным бас құдай Юбелеймен бірге.
Dialogue: 0,0:47:42.80,0:47:46.26,JPN,NTP,0,0,0,,Ағай, мен анама әлі жете алмай жүрмін.
Dialogue: 0,0:47:46.57,0:47:48.75,JPN,NTP,0,0,0,,Бұл дерлік қалды. Мен шыдай алмаймын.
Dialogue: 0,0:47:49.28,0:47:49.77,JPN,NTP,0,0,0,,Иә
Dialogue: 0,0:47:50.40,0:47:52.35,JPN,NTP,0,0,0,,Егер сіз әуежайға алда барсаңыз
Dialogue: 0,0:47:52.35,0:47:54.66,JPN,NTP,0,0,0,,Біз Изабель мұнарасы орналасқан аралға жақындадық.
Dialogue: 0,0:47:55.46,0:47:56.88,JPN,NTP,0,0,0,,Мен сені міндетті түрде кездесуге рұқсат етемін.
Dialogue: 0,0:47:57.68,0:47:58.88,JPN,NTP,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:47:59.73,0:48:00.26,JPN,NTP,0,0,0,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:48:01.46,0:48:04.53,JPN,NTP,0,0,0,,Бірақ әуежай күлкілі.
Dialogue: 0,0:48:04.53,0:48:06.66,JPN,NTP,0,0,0,,Бұл болмағанда.
Dialogue: 0,0:48:07.60,0:48:08.93,JPN,NTP,0,0,0,,Қараңызшы, бұл шығу.
Dialogue: 0,0:48:15.86,0:48:17.82,JPN,NTP,0,0,0,,Бұл не?
Dialogue: 0,0:48:18.35,0:48:21.33,JPN,NTP,0,0,0,,Егер бұл Байонеттаның әрекеті болса да, тым жарқыраған болар еді.
Dialogue: 0,0:48:22.35,0:48:26.62,JPN,NTP,0,0,0,,Бұзылған елес мумия
Dialogue: 0,0:48:36.26,0:48:38.17,JPN,NTP,0,0,0,,Эвакуациялық эвакуация
Dialogue: 0,0:48:49.15,0:48:51.28,JPN,NTP,0,0,0,,AFFA CHAJA
Dialogue: 0,0:49:06.80,0:49:08.04,JPN,NTP,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:49:08.26,0:49:11.11,JPN,NTP,0,0,0,,Аңшы періштелерде күш өседі
Dialogue: 0,0:49:12.13,0:49:14.13,JPN,NTP,0,0,0,,Менің денем енді шыдай алмайды
Dialogue: 0,0:49:32.97,0:49:34.53,JPN,NTP,0,0,0,,Бұл сізге өте жарасады.
Dialogue: 0,0:49:52.66,0:49:53.91,JPN,NTP,0,0,0,,Байонеттаның бұзақысы
Dialogue: 0,0:49:54.13,0:49:57.51,JPN,NTP,0,0,0,,Ұшатын ұшақ таппасақ, біз де қиындыққа тап боламыз.
Dialogue: 0,0:50:00.40,0:50:02.48,JPN,NTP,0,0,0,,Ханым, сіз мұнымен құтыла аласыз.
Dialogue: 0,0:50:02.84,0:50:03.60,JPN,NTP,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:50:04.36,0:50:05.23,JPN,NTP,0,0,0,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:50:05.23,0:50:05.96,JPN,NTP,0,0,0,,Оны түсіріңіз
Dialogue: 0,0:50:06.10,0:50:07.56,JPN,NTP,0,0,0,,Ол күйіп кетеді.
Dialogue: 0,0:50:09.63,0:50:10.80,JPN,NTP,0,0,0,,Анам сонда болды ма?
Dialogue: 0,0:50:11.00,0:50:11.86,JPN,NTP,0,0,0,,Елес
Dialogue: 0,0:50:13.76,0:50:14.70,JPN,NTP,0,0,0,,Елес
Dialogue: 0,0:50:15.20,0:50:16.40,JPN,NTP,0,0,0,,Елес келе жатыр
Dialogue: 0,0:50:18.40,0:50:21.36,JPN,NTP,0,0,0,,Сіз не туралы айтып отырсыз? Мен ештеңе көре алмаймын.
Dialogue: 0,0:50:23.80,0:50:25.50,JPN,NTP,0,0,0,,Розмари хош иісі
Dialogue: 0,0:50:25.83,0:50:26.56,JPN,NTP,0,0,0,,Ағай
Dialogue: 0,0:50:30.03,0:50:30.76,JPN,NTP,0,0,0,,Мисс
Dialogue: 0,0:50:31.23,0:50:33.46,JPN,NTP,0,0,0,,Кешіріңіз, бірақ сіздің ағаңыз шынымен жақсы көреді.
Dialogue: 0,0:50:33.46,0:50:35.03,JPN,NTP,0,0,0,,Бұдан бұрын
Dialogue: 0,0:50:35.30,0:50:36.50,JPN,NTP,0,0,0,,Жарайды, бұл.
Dialogue: 0,0:50:38.23,0:50:39.63,JPN,NTP,0,0,0,,Мен түсінемін.
Dialogue: 0,0:50:46.93,0:50:48.13,JPN,NTP,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:50:48.26,0:50:49.30,JPN,NTP,0,0,0,,Періште болмайды
Dialogue: 0,0:50:54.00,0:50:56.56,JPN,NTP,0,0,0,,Ханым, бұл шындық па?
Dialogue: 0,0:51:00.83,0:51:03.53,JPN,NTP,0,0,0,,Ей, сен шынымен періштесің бе?
Dialogue: 0,0:51:04.10,0:51:06.13,JPN,NTP,0,0,0,,Маған қарағандар мына құбыжық сияқты
Dialogue: 0,0:51:23.76,0:51:26.66,JPN,NTP,0,0,0,,Мені осы уақытқа дейін аңдып жүргеніңізге сене алар емеспін.
Dialogue: 0,0:51:31.13,0:51:32.46,JPN,NTP,0,0,0,,Не болды?
Dialogue: 0,0:51:32.83,0:51:34.03,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:51:45.56,0:51:47.26,JPN,NTP,0,0,0,,Бұл да періште ме?
Dialogue: 0,0:51:48.50,0:51:49.83,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:51:49.83,0:51:51.30,JPN,NTP,0,0,0,,Мама жақсы.
Dialogue: 0,0:52:11.86,0:52:12.63,JPN,NTP,0,0,0,,Мисс
Dialogue: 0,0:52:13.23,0:52:16.06,JPN,NTP,0,0,0,,Сенің анаң сол елестермен күресіп жатыр ма?
Dialogue: 0,0:52:16.36,0:52:17.83,JPN,NTP,0,0,0,,Мама - бақсы
Dialogue: 0,0:52:17.96,0:52:19.93,JPN,NTP,0,0,0,,Ол бәрін қорғайтын күшті адам.
Dialogue: 0,0:52:20.00,0:52:22.40,JPN,NTP,0,0,0,,Бақсы барлығын қорғайды
Dialogue: 0,0:52:22.70,0:52:24.26,JPN,NTP,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:52:25.93,0:52:29.13,JPN,NTP,0,0,0,,Мен де анамды қорғайтын күшті сиқыршы боламын.
Dialogue: 0,0:52:53.10,0:52:56.23,JPN,NTP,0,0,0,,Енді мен қызық, әдемі гүлдер гүлдейді ме?
Dialogue: 0,0:53:17.30,0:53:18.26,JPN,NTP,0,0,0,,Мен мұны істедім
Dialogue: 0,0:53:18.66,0:53:20.93,JPN,NTP,0,0,0,,Мумия елесті өлтірді
Dialogue: 0,0:53:21.73,0:53:23.26,JPN,NTP,0,0,0,,Ханым, мен оны қайтарамын.
Dialogue: 0,0:53:26.70,0:53:29.23,JPN,NTP,0,0,0,,Сен сол көзілдіріктерге сиқыр салдың ба?
Dialogue: 0,0:53:29.66,0:53:30.36,JPN,NTP,0,0,0,,Иә.
Dialogue: 0,0:53:30.80,0:53:33.06,JPN,NTP,0,0,0,,Көзілдіріксіз де елестерді көруге болады
Dialogue: 0,0:53:41.33,0:53:42.00,JPN,NTP,0,0,0,,Періште
Dialogue: 0,0:53:43.20,0:53:45.86,JPN,NTP,0,0,0,,Бірақ бұл иіс әрқашан одан.
Dialogue: 0,0:53:52.83,0:53:53.83,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,0:53:57.30,0:54:00.56,JPN,NTP,0,0,0,,Чибисуке Мен жылаймын деп ойламаппын.
Dialogue: 0,0:54:00.56,0:54:01.63,JPN,NTP,0,0,0,,Менде жоқ.
Dialogue: 0,0:54:02.00,0:54:03.30,JPN,NTP,0,0,0,,Жақсы
Dialogue: 0,0:54:04.03,0:54:08.00,JPN,NTP,0,0,0,,Мен сенің үндемей, бала күтуіңді қаладым.
Dialogue: 0,0:54:08.93,0:54:09.73,JPN,NTP,0,0,0,,Лұқа
Dialogue: 0,0:54:11.00,0:54:13.03,JPN,NTP,0,0,0,,Қанша рет айтуым керек саған, түсінерсің ғой?
Dialogue: 0,0:54:13.40,0:54:15.03,JPN,NTP,0,0,0,,Мен Лука емеспін
Dialogue: 0,0:54:16.13,0:54:17.03,JPN,NTP,0,0,0,,Чешир
Dialogue: 0,0:54:17.40,0:54:19.83,JPN,NTP,0,0,0,,Тек мені мазақ етуді доғар.
Dialogue: 0,0:54:21.56,0:54:22.96,JPN,NTP,0,0,0,,Бұл қыз Чешир.
Dialogue: 0,0:54:31.26,0:54:33.93,JPN,NTP,0,0,0,,Сіз мені Изабель мұнарасына апара аласыз ба?
Dialogue: 0,0:54:34.53,0:54:35.16,JPN,NTP,0,0,0,,Чешир
Dialogue: 0,0:54:39.00,0:54:40.43,JPN,NTP,0,0,0,,Сәттілік.
Dialogue: 0,0:54:40.80,0:54:43.30,JPN,NTP,0,0,0,,Бұл тікұшақ жаңа ғана Исабель мұнарасына бара жатыр.
Dialogue: 0,0:54:43.96,0:54:46.73,JPN,NTP,0,0,0,,Мен сені соңына дейін көремін.
Dialogue: 0,0:54:50.50,0:54:52.26,JPN,NTP,0,0,0,,Умбра сиқыршысы
Dialogue: 0,0:54:53.56,0:54:56.13,JPN,NTP,0,0,0,,Лумендік данышпан айтқандай
Dialogue: 0,0:54:56.93,0:54:59.63,JPN,NTP,0,0,0,,Бұл, әрине, үлкен күш.
Dialogue: 0,0:55:01.43,0:55:02.96,JPN,NTP,0,0,0,,Ұзақ уақыт бойы
Dialogue: 0,0:55:03.53,0:55:09.56,JPN,NTP,0,0,0,,Бұл дүниені бақылайтын жарық пен қараңғылықтың екі көзі.
Dialogue: 0,0:55:10.86,0:55:13.56,JPN,NTP,0,0,0,,Жаңа дүние жасайтын уақыт келді
Dialogue: 0,0:55:14.80,0:55:19.73,JPN,NTP,0,0,0,,Юбелейдің батасы Умбра сиқыршысына болсын
Dialogue: 0,0:55:27.60,0:55:28.70,JPN,NTP,0,0,0,,Жоқ, жай кездейсоқтық.
Dialogue: 0,0:55:32.33,0:55:36.26,JPN,NTP,0,0,0,,Келгеніңе рахмет, қызым.
Dialogue: 0,0:55:37.00,0:55:39.36,JPN,NTP,0,0,0,,Бұл ақырғы сынақ.
Dialogue: 0,0:55:40.10,0:55:45.43,JPN,NTP,0,0,0,,Сізді жоғалған естеліктеріңізге арналған бағдар күтеді.
Dialogue: 0,0:55:46.63,0:55:52.06,JPN,NTP,0,0,0,,Оған бәрін тастау керек.
Dialogue: 0,0:56:12.33,0:56:13.00,JPN,NTP,0,0,0,,Ұсыныс
Dialogue: 0,0:56:18.73,0:56:19.86,JPN,NTP,0,0,0,,Логикаға сүйенсек, ол өлі.
Dialogue: 0,0:56:25.63,0:56:27.66,JPN,NTP,0,0,0,,Не, құтқарылдыңыз ба?
Dialogue: 0,0:56:28.56,0:56:29.40,JPN,NTP,0,0,0,,Байонетта
Dialogue: 0,0:56:43.10,0:56:46.06,JPN,NTP,0,0,0,,Кешігіп қалдың, күтуден шаршадым.
Dialogue: 0,0:56:47.20,0:56:50.80,JPN,NTP,0,0,0,,Бұл жолы аздап көңілді болады деп үміттенемін.
Dialogue: 0,0:56:52.40,0:56:53.60,JPN,NTP,0,0,0,,Сіз бірден көресіз
Dialogue: 0,0:56:54.63,0:56:57.43,JPN,NTP,0,0,0,,Енді сіз білетін барлық нәрсе
Dialogue: 0,0:56:58.16,0:56:59.63,JPN,NTP,0,0,0,,Мен сені балық аулауға шығарамын.
Dialogue: 0,0:57:01.63,0:57:02.53,JPN,NTP,0,0,0,,Байқап көріңіз
Dialogue: 0,0:57:03.13,0:57:04.53,JPN,NTP,0,0,0,,Мүмкін болса
Dialogue: 0,0:57:20.36,0:57:22.53,JPN,NTP,0,0,0,,Мұндай қарумен бір-бірімізбен соғысуға қалай батылы барамыз?
Dialogue: 0,0:57:36.36,0:57:38.63,JPN,NTP,0,0,0,,Қорқыныш әлі сейілмеген сияқты.
Dialogue: 0,0:57:39.13,0:57:39.86,JPN,NTP,0,0,0,,Қорқыныш
Dialogue: 0,0:57:41.20,0:57:43.26,JPN,NTP,0,0,0,,Есте сақтау арқылы ашылды
Dialogue: 0,0:57:43.60,0:57:47.30,JPN,NTP,0,0,0,,Өз тағдырынан инстинктивті түрде қорқады
Dialogue: 0,0:57:49.63,0:57:51.93,JPN,NTP,0,0,0,,Жарық пен қараңғылық тоғысқанда
Dialogue: 0,0:57:52.46,0:57:54.03,JPN,NTP,0,0,0,,Апат келеді
Dialogue: 0,0:57:55.10,0:57:56.73,JPN,NTP,0,0,0,,Бұл ескі аңыз.
Dialogue: 0,0:57:57.30,0:58:01.56,JPN,NTP,0,0,0,,Оба шын мәнінде бақсылар мен данышпандарды жойды.
Dialogue: 0,0:58:01.86,0:58:04.26,JPN,NTP,0,0,0,,Себеп-салдар әлі жалғасуда
Dialogue: 0,0:58:05.10,0:58:08.56,JPN,NTP,0,0,0,,Тыйым салынған перзент болып туылған саған центр.
Dialogue: 0,0:58:09.76,0:58:10.70,JPN,NTP,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:58:11.26,0:58:14.70,JPN,NTP,0,0,0,,Әлемнің көзі деп атаған жаратушының құдіреті
Dialogue: 0,0:58:15.70,0:58:18.43,JPN,NTP,0,0,0,,Екінші жартысы сізде тұрады.
Dialogue: 0,0:58:18.90,0:58:20.40,JPN,NTP,0,0,0,,Сол көздің күші
Dialogue: 0,0:58:26.23,0:58:28.13,JPN,NTP,0,0,0,,Цк, мазасыз.
Dialogue: 0,0:58:36.60,0:58:37.53,JPN,NTP,0,0,0,,Бұл
Dialogue: 0,0:58:37.93,0:58:40.00,JPN,NTP,0,0,0,,Шыдай алмадым, Сол көз
Dialogue: 0,0:58:42.36,0:58:43.86,JPN,NTP,0,0,0,,Сиқыршы Жанна
Dialogue: 0,0:58:44.50,0:58:48.40,JPN,NTP,0,0,0,,Бас құдай Юбелейдің келуіне ешнәрсенің кедергі жасауына жол бермеймін.
Dialogue: 0,0:58:49.10,0:58:53.00,JPN,NTP,0,0,0,,Періштенің тәкаппар бақсыға бұйыруы.
Dialogue: 0,0:58:54.46,0:58:55.20,JPN,NTP,0,0,0,,Оны жоғалтыңыз.
Dialogue: 0,0:58:58.86,0:59:00.43,JPN,NTP,0,0,0,,Ақымақтар
Dialogue: 0,0:59:01.53,0:59:05.43,JPN,NTP,0,0,0,,Сол көз Мен бас құдаймен бірге күтемін.
Dialogue: 0,0:59:20.10,0:59:22.76,JPN,NTP,0,0,0,,Сіз шынымен көңілді жерде жүрген сияқтысыз.
Dialogue: 0,0:59:23.56,0:59:26.13,JPN,NTP,0,0,0,,Бұл сіздің дүкеніңізге қарағанда қызық емес.
Dialogue: 0,0:59:31.13,0:59:32.86,JPN,NTP,0,0,0,,Мені қайта-қайта айтуға мәжбүрлеме
Dialogue: 0,0:59:33.50,0:59:35.56,JPN,NTP,0,0,0,,Мен сізбен айналысып жатқан адам емеспін.
Dialogue: 0,0:59:45.43,0:59:46.96,JPN,NTP,0,0,0,,Сізді күткенім үшін кешіріңіз, Байонетта
Dialogue: 0,0:59:47.53,0:59:48.93,JPN,NTP,0,0,0,,Мылтық бітті.
Dialogue: 0,0:59:51.40,0:59:54.16,JPN,NTP,0,0,0,,Менің ойымша, сіз бұл жолы мені қанағаттандыратын шығарсыз.
Dialogue: 0,0:59:54.86,0:59:56.20,JPN,NTP,0,0,0,,Көп
Dialogue: 0,1:00:05.20,1:00:06.83,JPN,NTP,0,0,0,,Скарборо жәрмеңкесі
Dialogue: 0,1:00:07.36,1:00:09.23,JPN,NTP,0,0,0,,Сіздің жаңа рыцарь.
Dialogue: 0,1:00:09.60,1:00:11.56,JPN,NTP,0,0,0,,Мен қатты қайта тудым.
Dialogue: 0,1:00:26.36,1:00:27.86,JPN,NTP,0,0,0,,Мен дүкенде күтемін.
Dialogue: 0,1:00:29.33,1:00:31.66,JPN,NTP,0,0,0,,Жалығуды сағынғанда
Dialogue: 0,1:00:32.66,1:00:36.06,JPN,NTP,0,0,0,,Ақырында біз дұрыс тіл табыса алатын сияқтымыз.
Dialogue: 0,1:00:37.03,1:00:39.56,JPN,NTP,0,0,0,,Иә, мен саған қамқор боламын.
Dialogue: 0,1:00:40.70,1:00:41.63,JPN,NTP,0,0,0,,Ей, бағасын алты долларға түсір. Алты доллар.
Dialogue: 0,1:00:42.00,1:00:43.83,JPN,NTP,0,0,0,,Менен жеңілсең
Dialogue: 0,1:00:44.06,1:00:46.70,JPN,NTP,0,0,0,,Сен бірге жүрген қыз да жоғалып кетеді.
Dialogue: 0,1:01:04.80,1:01:06.53,JPN,NTP,0,0,0,,Жарайды, солай.
Dialogue: 0,1:01:07.33,1:01:08.43,JPN,NTP,0,0,0,,Бұл сезім
Dialogue: 0,1:01:12.86,1:01:15.60,JPN,NTP,0,0,0,,Жанна Бақсы заңы бойынша
Dialogue: 0,1:01:15.76,1:01:18.80,JPN,NTP,0,0,0,,Қазір ең күшті жауынгердің біліктілігіне сұрақ қою
Dialogue: 0,1:01:20.06,1:01:21.86,JPN,NTP,0,0,0,,Кумите бойынша қарсыласыңызды таңдаңыз
Dialogue: 0,1:01:23.26,1:01:24.76,JPN,NTP,0,0,0,,Сол көлеңкелі адаммен
Dialogue: 0,1:01:26.56,1:01:27.76,JPN,NTP,0,0,0,,Бұл болмайды
Dialogue: 0,1:01:28.30,1:01:30.63,JPN,NTP,0,0,0,,Қаны арам қарғыс атқан адам
Dialogue: 0,1:01:30.63,1:01:33.00,JPN,NTP,0,0,0,,Бізге қиылысуға рұқсат етілмейді.
Dialogue: 0,1:01:38.10,1:01:41.30,JPN,NTP,0,0,0,,Мен бір кездері осы жерде болдым
Dialogue: 0,1:01:43.93,1:01:45.00,JPN,NTP,0,0,0,,Соңында
Dialogue: 0,1:01:45.26,1:01:46.66,JPN,NTP,0,0,0,,Есте сақта
Dialogue: 0,1:01:53.60,1:01:56.30,JPN,NTP,0,0,0,,Сіз өз естеліктеріңізден қорқасыз ба?
Dialogue: 0,1:02:25.00,1:02:26.86,JPN,NTP,0,0,0,,Естеліктер қайта оралғанда
Dialogue: 0,1:02:27.10,1:02:29.13,JPN,NTP,0,0,0,,Оның күш алып келе жатқанын көріп тұрсың ба?
Dialogue: 0,1:02:29.83,1:02:33.60,JPN,NTP,0,0,0,,Сол көзді қорғау бақсылар ретінде біздің міндетіміз.
Dialogue: 0,1:02:34.16,1:02:37.06,JPN,NTP,0,0,0,,Тыйым салынған бала болса да
Dialogue: 0,1:02:38.16,1:02:39.43,JPN,NTP,0,0,0,,Біз сиқыршылар
Dialogue: 0,1:03:33.50,1:03:35.43,JPN,NTP,0,0,0,,Мама Мама
Dialogue: 0,1:03:44.36,1:03:46.56,JPN,NTP,0,0,0,,Ведьма әулетінің сол көзі
Dialogue: 0,1:03:47.00,1:03:49.10,JPN,NTP,0,0,0,,Енді бұл өз қолымызда
Dialogue: 0,1:03:50.30,1:03:51.63,JPN,NTP,0,0,0,,Сол көз
Dialogue: 0,1:03:52.60,1:03:57.46,JPN,NTP,0,0,0,,Ендеше бас құдай Юбелейге бірге барайық.
Dialogue: 0,1:04:00.63,1:04:03.00,JPN,NTP,0,0,0,,Отбасының қазынасы Сол көз
Dialogue: 0,1:04:03.96,1:04:05.30,JPN,NTP,0,0,0,,Оны ешкімге бермеңіз
Dialogue: 0,1:04:24.83,1:04:27.96,JPN,NTP,0,0,0,,Жанна сен мені жараттың
Dialogue: 0,1:04:39.10,1:04:42.06,JPN,NTP,0,0,0,,Анаң қайтыс болғаннан кейін күресуге ерік-жігеріңнен айырылдың.
Dialogue: 0,1:04:42.70,1:04:46.43,JPN,NTP,0,0,0,,Сол көзді қорғау үшін мұны істеуден басқа амалым қалмады.
Dialogue: 0,1:04:48.83,1:04:51.40,JPN,NTP,0,0,0,,Бала кезімде жазықсыз едім.
Dialogue: 0,1:04:52.76,1:04:53.53,JPN,NTP,0,0,0,,Иә.
Dialogue: 0,1:04:56.40,1:05:00.13,JPN,NTP,0,0,0,,Мен үшін жалғыз сенсің
Dialogue: 0,1:05:02.86,1:05:05.56,JPN,NTP,0,0,0,,Мүмкін сол қызықсыз тұлып шығар.
Dialogue: 0,1:05:08.66,1:05:09.53,JPN,NTP,0,0,0,,Жанна
Dialogue: 0,1:05:11.03,1:05:12.73,JPN,NTP,0,0,0,,Бес жүз жыл бұрынғы сол күн
Dialogue: 0,1:05:13.36,1:05:15.13,JPN,NTP,0,0,0,,Неліктен мені серіктес етіп таңдадың?
Dialogue: 0,1:05:16.13,1:05:18.20,JPN,NTP,0,0,0,,Менен бәрі қашатын
Dialogue: 0,1:05:19.56,1:05:22.53,JPN,NTP,0,0,0,,Ең күшті сиқыршы болу
Dialogue: 0,1:05:22.80,1:05:25.46,JPN,NTP,0,0,0,,Күштілермен күресіп, жеңіске жету
Dialogue: 0,1:05:25.83,1:05:26.60,JPN,NTP,0,0,0,,Осымен
Dialogue: 0,1:05:28.60,1:05:31.73,JPN,NTP,0,0,0,,Дана Балдерден ешқашан құтыла алмайсың
Dialogue: 0,1:05:32.63,1:05:34.86,JPN,NTP,0,0,0,,500 жыл бұрынғы қоныс
Dialogue: 0,1:05:35.53,1:05:37.80,JPN,NTP,0,0,0,,Бұл сенің тағдырың
Dialogue: 0,1:05:39.13,1:05:41.03,JPN,NTP,0,0,0,,Күресіңіз және жеңіңіз
Dialogue: 0,1:05:41.36,1:05:43.20,JPN,NTP,0,0,0,,Жаңа жолды ашыңыз
Dialogue: 0,1:05:44.03,1:05:46.16,JPN,NTP,0,0,0,,Мен сізге сенімдімін
Dialogue: 0,1:05:53.86,1:05:54.50,JPN,NTP,0,0,0,,Жанна
Dialogue: 0,1:06:06.30,1:06:06.86,JPN,NTP,0,0,0,,Жанна
Dialogue: 0,1:06:10.10,1:06:11.03,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,1:06:13.36,1:06:15.00,JPN,NTP,0,0,0,,Біз бұған оңай жеттік.
Dialogue: 0,1:06:15.53,1:06:17.46,JPN,NTP,0,0,0,,Шамасы мен де қонақпын.
Dialogue: 0,1:06:19.83,1:06:20.60,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,1:06:22.20,1:06:22.83,JPN,NTP,0,0,0,,Чибисуке
Dialogue: 0,1:06:23.53,1:06:25.56,JPN,NTP,0,0,0,,Сіздің байлығыңыз қандай?
Dialogue: 0,1:06:26.60,1:06:27.13,JPN,NTP,0,0,0,,Чешир
Dialogue: 0,1:06:28.03,1:06:28.63,JPN,NTP,0,0,0,,Иә.
Dialogue: 0,1:06:29.00,1:06:30.43,JPN,NTP,0,0,0,,Чешир - дос
Dialogue: 0,1:06:32.43,1:06:34.00,JPN,NTP,0,0,0,,Бұл қазына
Dialogue: 0,1:06:38.26,1:06:42.23,JPN,NTP,0,0,0,,Қазына, оны ешқашан жіберме
Dialogue: 0,1:06:43.03,1:06:44.40,JPN,NTP,0,0,0,,Не болса да
Dialogue: 0,1:06:45.83,1:06:46.30,JPN,NTP,0,0,0,,Иә
Dialogue: 0,1:06:46.86,1:06:48.66,JPN,NTP,0,0,0,,Мен, мен енді жыламаймын
Dialogue: 0,1:06:49.00,1:06:51.86,JPN,NTP,0,0,0,,Мама сияқты болса да қашпа
Dialogue: 0,1:06:51.86,1:06:53.03,JPN,NTP,0,0,0,,Мықты адам бол
Dialogue: 0,1:06:53.56,1:06:54.70,JPN,NTP,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,1:07:02.20,1:07:04.36,JPN,NTP,0,0,0,,Сен жалғыз бармайсың деп ойлаймын.
Dialogue: 0,1:07:05.83,1:07:07.86,JPN,NTP,0,0,0,,Келме десем де, келерсің.
Dialogue: 0,1:07:08.13,1:07:09.23,JPN,NTP,0,0,0,,Менің ойымша, бұл келе жатыр.
Dialogue: 0,1:07:24.53,1:07:26.60,JPN,NTP,0,0,0,,Ол сені ішке шақырып жатқан сияқты.
Dialogue: 0,1:07:27.40,1:07:28.83,JPN,NTP,0,0,0,,Жомарт
Dialogue: 0,1:07:29.66,1:07:32.00,JPN,NTP,0,0,0,,Құрметті қызым
Dialogue: 0,1:07:33.00,1:07:36.63,JPN,NTP,0,0,0,,Әлемнің көзі Оларды ашатын кез келді
Dialogue: 0,1:07:37.20,1:07:38.03,JPN,NTP,0,0,0,,Бұл әке.
Dialogue: 0,1:07:38.23,1:07:39.46,JPN,NTP,0,0,0,,Әкемнің дауысы
Dialogue: 0,1:07:40.06,1:07:40.83,JPN,NTP,0,0,0,,Күте тұрыңыз
Dialogue: 0,1:07:41.63,1:07:42.70,JPN,NTP,0,0,0,,Әке де
Dialogue: 0,1:07:43.10,1:07:44.03,JPN,NTP,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,1:07:44.73,1:07:45.50,JPN,NTP,0,0,0,,Чибисуке
Dialogue: 0,1:07:54.46,1:07:55.30,JPN,NTP,0,0,0,,Анашым
Dialogue: 0,1:07:55.63,1:07:57.63,JPN,NTP,0,0,0,,Әкем анам да келді.
Dialogue: 0,1:08:00.16,1:08:02.60,JPN,NTP,0,0,0,,Менің отбасымның бас қосқанына көп уақыт болды.
Dialogue: 0,1:08:03.53,1:08:05.46,JPN,NTP,0,0,0,,Мен оны көптен күттім.
Dialogue: 0,1:08:07.43,1:08:08.80,JPN,NTP,0,0,0,,Сол адам
Dialogue: 0,1:08:11.30,1:08:13.93,JPN,NTP,0,0,0,,Анаңызбен саяхаттағаныңыз қызықты болды ма?
Dialogue: 0,1:08:13.93,1:08:14.50,JPN,NTP,0,0,0,,Иә
Dialogue: 0,1:08:15.03,1:08:17.20,JPN,NTP,0,0,0,,Мама өте күшті
Dialogue: 0,1:08:17.83,1:08:18.80,JPN,NTP,0,0,0,,Мен көремін.
Dialogue: 0,1:08:19.16,1:08:21.33,JPN,NTP,0,0,0,,Мен елестерден қорықтым.
Dialogue: 0,1:08:21.53,1:08:23.73,JPN,NTP,0,0,0,,Бірақ мамам жыламады
Dialogue: 0,1:08:24.36,1:08:26.26,JPN,NTP,0,0,0,,Сен күшейдің, Сереза.
Dialogue: 0,1:08:26.53,1:08:26.93,JPN,NTP,0,0,0,,Иә
Dialogue: 0,1:08:28.73,1:08:31.63,JPN,NTP,0,0,0,,Мен бүгін өз бөлмемде демаламын.
Dialogue: 0,1:08:31.80,1:08:36.36,JPN,NTP,0,0,0,,Мен әлі де айтқым келетін нәрселер көп.
Dialogue: 0,1:08:39.03,1:08:41.96,JPN,NTP,0,0,0,,Ертең қайта тыңдаңыз.
Dialogue: 0,1:08:42.40,1:08:44.50,JPN,NTP,0,0,0,,Иә, түсінемін.
Dialogue: 0,1:08:45.00,1:08:46.13,JPN,NTP,0,0,0,,Жақсы бала
Dialogue: 0,1:08:49.50,1:08:51.16,JPN,NTP,0,0,0,,Тәтті армандар
Dialogue: 0,1:08:51.66,1:08:53.80,JPN,NTP,0,0,0,,Иә, қайырлы түн.
Dialogue: 0,1:08:59.80,1:09:02.93,JPN,NTP,0,0,0,,Мама, жарайды.
Dialogue: 0,1:09:03.50,1:09:05.20,JPN,NTP,0,0,0,,Қайта жалғыз қалсам да жыламаймын
Dialogue: 0,1:09:07.13,1:09:08.23,JPN,NTP,0,0,0,,Ақылды адам
Dialogue: 0,1:09:09.10,1:09:10.50,JPN,NTP,0,0,0,,Қайырлы түн мама
Dialogue: 0,1:09:17.03,1:09:19.60,JPN,NTP,0,0,0,,Мені бұрынғыдан қалай алып келдің?
Dialogue: 0,1:09:20.06,1:09:21.63,JPN,NTP,0,0,0,,Өткенде
Dialogue: 0,1:09:23.83,1:09:26.03,JPN,NTP,0,0,0,,Юбелей көрінісінің әсерінен
Dialogue: 0,1:09:26.03,1:09:29.16,JPN,NTP,0,0,0,,Бұрмаланған кеңістік-уақыттың есігін ашты
Dialogue: 0,1:09:29.53,1:09:32.26,JPN,NTP,0,0,0,,Жас кезіңде саған пәк көзбен
Dialogue: 0,1:09:32.26,1:09:35.66,JPN,NTP,0,0,0,,Себебі мен саған мына ақымақ дүниені көрсеткім келді.
Dialogue: 0,1:09:36.46,1:09:37.56,JPN,NTP,0,0,0,,Сәлем онда.
Dialogue: 0,1:09:38.06,1:09:39.26,JPN,NTP,0,0,0,,Бұл адам?
Dialogue: 0,1:09:39.50,1:09:42.16,JPN,NTP,0,0,0,,Соңғы аман қалған Люмен данышпаны
Dialogue: 0,1:09:42.76,1:09:44.16,JPN,NTP,0,0,0,,Әр нәрсенің себебі
Dialogue: 0,1:09:44.56,1:09:47.06,JPN,NTP,0,0,0,,Және Чибисуке
Dialogue: 0,1:09:48.16,1:09:50.20,JPN,NTP,0,0,0,,Жоқ, әкем.
Dialogue: 0,1:09:52.43,1:09:56.03,JPN,NTP,0,0,0,,Осы сәтті бес жүз жыл күттім.
Dialogue: 0,1:09:57.40,1:10:00.66,JPN,NTP,0,0,0,,Бейберекет дүниені тазарту
Dialogue: 0,1:10:01.13,1:10:03.80,JPN,NTP,0,0,0,,Аспан әлемі Жындар әлемі Адам әлемі
Dialogue: 0,1:10:04.13,1:10:06.26,JPN,NTP,0,0,0,,Юбелейдің қайта тірілуіне байланысты
Dialogue: 0,1:10:06.43,1:10:10.10,JPN,NTP,0,0,0,,Үш дүние де ештеңеге айналып, қайта туады.
Dialogue: 0,1:10:10.53,1:10:11.53,JPN,NTP,0,0,0,,Сереза.
Dialogue: 0,1:10:11.76,1:10:16.33,JPN,NTP,0,0,0,,Сен екеуміз жаңа әлемнің құдайы боламыз.
Dialogue: 0,1:10:19.10,1:10:22.10,JPN,NTP,0,0,0,,Изабель тобының әлемдік көшбасшысы күткендей.
Dialogue: 0,1:10:22.80,1:10:25.90,JPN,NTP,0,0,0,,Үлкен фурошикиді жайып салу өте әдемі.
Dialogue: 0,1:10:26.50,1:10:30.00,JPN,NTP,0,0,0,,Бірақ бұл өте қызықты мақала болуы мүмкін емес.
Dialogue: 0,1:10:30.06,1:10:32.23,JPN,NTP,0,0,0,,Бұл сен едің, Лука.
Dialogue: 0,1:10:32.63,1:10:35.36,JPN,NTP,0,0,0,,Мен сенің есейгеніңді бақылап жүрдім.
Dialogue: 0,1:10:35.73,1:10:39.50,JPN,NTP,0,0,0,,Әкем сияқты тамаша журналист болды.
Dialogue: 0,1:10:39.76,1:10:41.30,JPN,NTP,0,0,0,,Сіз өз әкеңізді білесіз бе?
Dialogue: 0,1:10:41.93,1:10:45.53,JPN,NTP,0,0,0,,Сіз менің жоспарларымды мұқият зерттедіңіз.
Dialogue: 0,1:10:46.06,1:10:47.16,JPN,NTP,0,0,0,,Серезаның орналасқан жері
Dialogue: 0,1:10:47.16,1:10:49.63,JPN,NTP,0,0,0,,Түсінгеніңізге қуаныштымын.
Dialogue: 0,1:10:49.93,1:10:53.16,JPN,NTP,0,0,0,,Бірақ мен тым ынталы болдым.
Dialogue: 0,1:10:55.13,1:10:55.76,JPN,NTP,0,0,0,,Не?
Dialogue: 0,1:10:57.56,1:10:59.13,JPN,NTP,0,0,0,,Розмари хош иісі
Dialogue: 0,1:10:59.96,1:11:02.36,JPN,NTP,0,0,0,,Мен мұның сол кезден екеніне сене алар емеспін.
Dialogue: 0,1:11:15.66,1:11:18.16,JPN,NTP,0,0,0,,Түсіндім, сені
Dialogue: 0,1:11:18.86,1:11:20.40,JPN,NTP,0,0,0,,Періште менің әкемді көрді
Dialogue: 0,1:11:20.40,1:11:24.13,JPN,NTP,0,0,0,,Көңіл айтуыма рұқсат етіңіз.
Dialogue: 0,1:11:26.40,1:11:29.90,JPN,NTP,0,0,0,,Байонетта Мені осы уақытқа дейін кешіріңіз.
Dialogue: 0,1:11:31.50,1:11:32.76,JPN,NTP,0,0,0,,Маған бәрібір.
Dialogue: 0,1:11:34.90,1:11:37.33,JPN,NTP,0,0,0,,Тіпті менімен араласқан қыз да
Dialogue: 0,1:11:37.90,1:11:40.46,JPN,NTP,0,0,0,,Мен енді жыламаймын деп шештім.
Dialogue: 0,1:11:40.93,1:11:44.90,JPN,NTP,0,0,0,,Мен де ашуланып, бәрін реттеуім керек.
Dialogue: 0,1:11:46.36,1:11:47.76,JPN,NTP,0,0,0,,Егер сіз журналист болсаңыз
Dialogue: 0,1:11:47.76,1:11:51.73,JPN,NTP,0,0,0,,Мұндай өрескел тәсілді қолдануға болмайды.
Dialogue: 0,1:11:55.60,1:11:56.16,JPN,NTP,0,0,0,,Лұқа
Dialogue: 0,1:12:02.36,1:12:05.60,JPN,NTP,0,0,0,,Сереза ​​Саяхат осында аяқталады.
Dialogue: 0,1:12:07.00,1:12:08.13,JPN,NTP,0,0,0,,Мен білмеймін.
Dialogue: 0,1:12:08.96,1:12:11.80,JPN,NTP,0,0,0,,Мені жас кезімде алып келем деп неге қиналдың?
Dialogue: 0,1:12:12.30,1:12:15.40,JPN,NTP,0,0,0,,Мен сізді осында шақыратындай бірдеңе жасадым ба?
Dialogue: 0,1:12:17.16,1:12:21.20,JPN,NTP,0,0,0,,Сіз барлық естеліктеріңізді жоғалттыңыз.
Dialogue: 0,1:12:21.40,1:12:23.93,JPN,NTP,0,0,0,,Көзді сол көз ретінде қалай ашуға болады
Dialogue: 0,1:12:24.20,1:12:26.63,JPN,NTP,0,0,0,,Күш пен жинақталған тәжірибе
Dialogue: 0,1:12:26.63,1:12:29.90,JPN,NTP,0,0,0,,Ал махаббатты қайтару керек
Dialogue: 0,1:12:31.40,1:12:34.43,JPN,NTP,0,0,0,,Дүниені құртуға тырысқаннан кейін
Dialogue: 0,1:12:34.96,1:12:38.46,JPN,NTP,0,0,0,,Анамды өлтірген сол бір ауыз махаббатты айтады
Dialogue: 0,1:12:39.03,1:12:41.96,JPN,NTP,0,0,0,,Розаны өлтірген мен емес едім.
Dialogue: 0,1:12:42.46,1:12:45.10,JPN,NTP,0,0,0,,Дүниенің бұрмалануы бізді бөліп жатыр
Dialogue: 0,1:12:45.30,1:12:49.93,JPN,NTP,0,0,0,,Бас құдайдың қайта тірілуіне шыдамаған періштелер оны өлтірді.
Dialogue: 0,1:12:50.60,1:12:53.76,JPN,NTP,0,0,0,,Періштелер сенімен соғысуға дайын.
Dialogue: 0,1:12:53.83,1:12:57.26,JPN,NTP,0,0,0,,Сиқырлы күшті арттыру үшін құрбандыққа шалынды.
Dialogue: 0,1:12:57.56,1:12:59.46,JPN,NTP,0,0,0,,Аяқтау – Жанна
Dialogue: 0,1:13:00.46,1:13:03.56,JPN,NTP,0,0,0,,Сиқырлы күшіңізді барынша арттырыңыз
Dialogue: 0,1:13:03.56,1:13:05.56,JPN,NTP,0,0,0,,Сіздің өзегіңізді не құрайды
Dialogue: 0,1:13:05.76,1:13:08.96,JPN,NTP,0,0,0,,, яғни жадты қалпына келтіру
Dialogue: 0,1:13:09.46,1:13:12.70,JPN,NTP,0,0,0,,Ол өте жақсы жұмыс жасады
Dialogue: 0,1:13:17.56,1:13:18.56,JPN,NTP,0,0,0,,Жынды
Dialogue: 0,1:13:19.83,1:13:21.20,JPN,NTP,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,1:13:21.73,1:13:23.93,JPN,NTP,0,0,0,,Мен жынды емеспін
Dialogue: 0,1:13:24.33,1:13:26.36,JPN,NTP,0,0,0,,Бұл әлем
Dialogue: 0,1:13:28.90,1:13:31.26,JPN,NTP,0,0,0,,Сіз мені атып тастай аласыз ба?
Dialogue: 0,1:13:33.46,1:13:34.66,JPN,NTP,0,0,0,,Мен сені атып алмасам да
Dialogue: 0,1:13:36.00,1:13:38.43,JPN,NTP,0,0,0,,Мен, әкем,
Dialogue: 0,1:13:38.66,1:13:40.10,JPN,NTP,0,0,0,,Сіз
Dialogue: 0,1:13:42.36,1:13:44.53,JPN,NTP,0,0,0,,Менің сүйікті қызым
Dialogue: 0,1:13:46.40,1:13:47.66,JPN,NTP,0,0,0,,Сереза.
Dialogue: 0,1:13:56.63,1:14:02.06,JPN,NTP,0,0,0,,Бұл жаңа тәртіп пен әлемнің бастамасы.
Dialogue: 0,1:14:44.50,1:14:47.90,JPN,NTP,0,0,0,,Бас құдайдың қайта тірілуі ауыр ма?
Dialogue: 0,1:15:00.20,1:15:01.90,JPN,NTP,0,0,0,,Юбелей
Dialogue: 0,1:15:03.30,1:15:06.16,JPN,NTP,0,0,0,,Бізбен бірге болыңыз
Dialogue: 0,1:15:15.20,1:15:18.93,JPN,NTP,0,0,0,,Мен Юбелеймен бір боламын.
Dialogue: 0,1:15:40.96,1:15:44.06,JPN,NTP,0,0,0,,Уақыт келді
Dialogue: 0,1:15:45.36,1:15:50.26,JPN,NTP,0,0,0,,Біз жаңа дүниенің жаратылу құдайы боламыз
Dialogue: 0,1:16:06.90,1:16:08.56,JPN,NTP,0,0,0,,Мен мұны Юбелей деп ешқашан ойламадым
Dialogue: 0,1:16:09.36,1:16:10.50,JPN,NTP,0,0,0,,Байонетта
Dialogue: 0,1:16:19.10,1:16:20.43,JPN,NTP,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,1:16:21.43,1:16:22.23,JPN,NTP,0,0,0,,Менің қызым
Dialogue: 0,1:16:22.56,1:16:26.56,JPN,NTP,0,0,0,,Бұл жаңа дүниенің басы
Dialogue: 0,1:16:30.80,1:16:31.80,JPN,NTP,0,0,0,,Сереза
Dialogue: 0,1:16:33.23,1:16:33.90,JPN,NTP,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,1:16:35.83,1:16:38.86,JPN,NTP,0,0,0,,Өтінемін, мені құтқарыңыз
Dialogue: 0,1:16:40.20,1:16:44.23,JPN,NTP,0,0,0,,Жындылық құрсауында қалған жан
Dialogue: 0,1:16:45.66,1:16:47.00,JPN,NTP,0,0,0,,Сол адам
Dialogue: 0,1:16:53.03,1:16:55.46,JPN,NTP,0,0,0,,Дұрыс, анашым.
Dialogue: 0,1:16:56.53,1:16:58.66,JPN,NTP,0,0,0,,Мен ол кезде не істей алмадым
Dialogue: 0,1:16:59.90,1:17:00.83,JPN,NTP,0,0,0,,Қазір уақыт
Dialogue: 0,1:17:13.80,1:17:17.13,JPN,NTP,0,0,0,,Жанна тірі болды ма?
Dialogue: 0,1:17:17.66,1:17:19.83,JPN,NTP,0,0,0,,Жарық пен қараңғылық тоғысқанда
Dialogue: 0,1:17:20.16,1:17:21.73,JPN,NTP,0,0,0,,Апат келеді
Dialogue: 0,1:17:22.43,1:17:25.16,JPN,NTP,0,0,0,,Түсіндім, бұл басқа
Dialogue: 0,1:17:25.70,1:17:27.90,JPN,NTP,0,0,0,,Жоқ, бұл шын мағынасы ма?
Dialogue: 0,1:17:28.10,1:17:34.66,JPN,NTP,0,0,0,,Сіз тым кеш қалдыңыз. Сіз бұл жаңа әлемде пайдасызсыз.
Dialogue: 0,1:17:35.00,1:17:36.23,JPN,NTP,0,0,0,,Менің ойымша, солай
Dialogue: 0,1:17:43.96,1:17:46.56,JPN,NTP,0,0,0,,Ведьма кланының қазынасы сізге қайтарылады.
Dialogue: 0,1:17:48.33,1:17:50.26,JPN,NTP,0,0,0,,AGRAM ORS
Dialogue: 0,1:17:58.70,1:17:59.50,JPN,NTP,0,0,0,,Жанна
Dialogue: 0,1:18:00.20,1:18:01.83,JPN,NTP,0,0,0,,Иә, оян.
Dialogue: 0,1:18:02.70,1:18:05.56,JPN,NTP,0,0,0,,500 жыл бұрынғы мәселені шешу үшін өз қолдарыңызды қолданыңыз.
Dialogue: 0,1:18:07.93,1:18:10.33,JPN,NTP,0,0,0,,Кешіктірме, Сереза
Dialogue: 0,1:18:21.60,1:18:24.40,JPN,NTP,0,0,0,,Ол өте қамқор адам.
Dialogue: 0,1:18:25.03,1:18:26.63,JPN,NTP,0,0,0,,Ол өлген жоқ па?
Dialogue: 0,1:18:44.76,1:18:46.13,JPN,NTP,0,0,0,,ақымақ
Dialogue: 0,1:18:47.06,1:18:53.83,JPN,NTP,0,0,0,,Не, не, не, не?
Dialogue: 0,1:19:01.70,1:19:03.66,JPN,NTP,0,0,0,,CARR MMA BOWE COW
Dialogue: 0,1:19:18.73,1:19:20.26,JPN,NTP,0,0,0,,Орташа үй жануары болуы мүмкін емес.
Dialogue: 0,1:19:20.73,1:19:21.70,JPN,NTP,0,0,0,,Солай көрінеді.
Dialogue: 0,1:19:22.73,1:19:26.23,JPN,NTP,0,0,0,,Менің сүйікті қызым, Сереза.
Dialogue: 0,1:19:26.53,1:19:28.70,JPN,NTP,0,0,0,,Сіз әкеңізге қарсы шығасыз ба?
Dialogue: 0,1:19:29.40,1:19:37.10,JPN,NTP,0,0,0,,Мен бұған ешқашан жол бермеймін.
Dialogue: 0,1:19:40.63,1:19:42.23,JPN,NTP,0,0,0,,Бұл Құдайдың құдіреті
Dialogue: 0,1:19:43.00,1:19:45.76,JPN,NTP,0,0,0,,Сереза Мен өз үлесімді орындаймын.
Dialogue: 0,1:19:46.10,1:19:46.93,JPN,NTP,0,0,0,,Әрине
Dialogue: 0,1:19:47.56,1:19:49.53,JPN,NTP,0,0,0,,Бірақ екеуміз ғана.
Dialogue: 0,1:19:51.70,1:19:53.26,JPN,NTP,0,0,0,,Мен қалдырған нәрсе бар ма?
Dialogue: 0,1:19:57.26,1:19:58.43,JPN,NTP,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,1:19:59.30,1:20:03.56,JPN,NTP,0,0,0,,TELOCVOVIM AGRAM
Dialogue: 0,1:20:04.56,1:20:09.26,JPN,NTP,0,0,0,,AGRAM ORS AVAVAGO
Dialogue: 0,1:20:20.10,1:20:21.70,JPN,NTP,0,0,0,,Жындар әлемінің патшайымы Шива
Dialogue: 0,1:20:22.10,1:20:23.93,JPN,NTP,0,0,0,,Оған тамаша сәйкестік.
Dialogue: 0,1:20:26.90,1:20:28.10,JPN,NTP,0,0,0,,Енді кеттік.
Dialogue: 0,1:20:28.40,1:20:28.83,JPN,NTP,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:21:20.43,1:21:23.33,JPN,NTP,0,0,0,,Дүниені солай ету
Dialogue: 0,1:21:24.06,1:21:25.70,JPN,NTP,0,0,0,,Әлі уақыт бар
Dialogue: 0,1:21:26.06,1:21:27.70,JPN,NTP,0,0,0,,Серезаны оят
Dialogue: 0,1:21:28.73,1:21:29.73,JPN,NTP,0,0,0,,Ақымақ емес
Dialogue: 0,1:21:30.43,1:21:32.10,JPN,NTP,0,0,0,,Сіз әлі де солай айтасыз ба?
Dialogue: 0,1:21:33.00,1:21:35.33,JPN,NTP,0,0,0,,Анам сені құтқармақ болды
Dialogue: 0,1:21:36.73,1:21:38.30,JPN,NTP,0,0,0,,Не айту керек
Dialogue: 0,1:21:39.00,1:21:44.30,JPN,NTP,0,0,0,,Жаңа дүниені құру ғана бәрін құтқарады.
Dialogue: 0,1:21:44.93,1:21:46.53,JPN,NTP,0,0,0,,Қандай қызықсыз ерік.
Dialogue: 0,1:21:47.40,1:21:50.20,JPN,NTP,0,0,0,,Әлемді өзіңіз қалағандай етіп жасаңыз
Dialogue: 0,1:21:50.80,1:21:52.13,JPN,NTP,0,0,0,,Не қызық?
Dialogue: 0,1:21:52.76,1:21:55.40,JPN,NTP,0,0,0,,Мені қазіргі бейберекеттік алаңдатады.
Dialogue: 0,1:21:57.13,1:21:58.40,JPN,NTP,0,0,0,,MICMA
Dialogue: 0,1:22:09.10,1:22:11.30,JPN,NTP,0,0,0,,Сәтсіздік
Dialogue: 0,1:22:13.86,1:22:15.20,JPN,NTP,0,0,0,,Кім шатастырып жатыр?
Dialogue: 0,1:22:15.93,1:22:16.70,JPN,NTP,0,0,0,,Бұл сенсің
Dialogue: 0,1:22:34.23,1:22:35.26,JPN,NTP,0,0,0,,Мен оны ұстадым.
Dialogue: 0,1:22:36.16,1:22:38.03,JPN,NTP,0,0,0,,Жарайды, аяқтаймыз.
Dialogue: 0,1:22:50.36,1:22:52.60,JPN,NTP,0,0,0,,Мен саған барлық сиқырлы күшімді беремін.
Dialogue: 0,1:23:01.76,1:23:06.50,JPN,NTP,0,0,0,,Енді анаңның ойын қабыл ал.
Dialogue: 0,1:23:08.93,1:23:09.93,JPN,NTP,0,0,0,,Менің қызым
Dialogue: 0,1:23:10.60,1:23:13.23,JPN,NTP,0,0,0,,Осы ақымақ дүниенің кесірінен
Dialogue: 0,1:23:13.70,1:23:16.26,JPN,NTP,0,0,0,,Роза екеуміз екі жаққа айырылдық
Dialogue: 0,1:23:16.46,1:23:20.43,JPN,NTP,0,0,0,,Дүние қалай болуы керек болса, сол күйге оралуы керек.
Dialogue: 0,1:23:21.03,1:23:22.43,JPN,NTP,0,0,0,,...
Dialogue: 0,1:23:23.53,1:23:25.16,JPN,NTP,0,0,0,,Орындалмайтын тілек
Dialogue: 0,1:23:26.56,1:23:27.83,JPN,NTP,0,0,0,,Мама күтіп тұр.
Dialogue: 0,1:23:31.53,1:23:33.63,JPN,NTP,0,0,0,,Қош бол әке
Dialogue: 0,1:23:48.73,1:23:51.03,JPN,NTP,0,0,0,,Мен сені сүйемін, Балдер
Dialogue: 0,1:23:53.86,1:23:55.13,JPN,NTP,0,0,0,,Роза
Dialogue: 0,1:24:00.83,1:24:03.53,JPN,NTP,0,0,0,,Қош бол, соңғы дана.
Dialogue: 0,1:24:13.93,1:24:15.26,JPN,NTP,0,0,0,,Роза
Dialogue: 0,1:24:53.20,1:24:54.43,JPN,NTP,0,0,0,,Байонетта
Dialogue: 0,1:25:06.96,1:25:10.23,JPN,NTP,0,0,0,,Байонеттаның жоғалып кеткеніне бір жыл болды ма?
Dialogue: 0,1:25:10.56,1:25:12.30,JPN,NTP,0,0,0,,Қаншама адам бар
Dialogue: 0,1:25:12.30,1:25:15.33,JPN,NTP,0,0,0,,Келе жатқан көп жаназаның жұмысын істей алмаймын.
Dialogue: 0,1:25:17.43,1:25:19.06,JPN,NTP,0,0,0,,Бизнес өсті.
Dialogue: 0,1:25:19.70,1:25:21.06,JPN,NTP,0,0,0,,О, Родан.
Dialogue: 0,1:25:21.33,1:25:24.03,JPN,NTP,0,0,0,,Әйтеуір, әлгі жігіттің иісі кетіп қалды ғой?
Dialogue: 0,1:25:24.76,1:25:25.70,JPN,NTP,0,0,0,,Мен ойлағандай
Dialogue: 0,1:25:26.70,1:25:30.23,JPN,NTP,0,0,0,,Мен қаруды қалайтын адамдарға сатамын.
Dialogue: 0,1:25:30.93,1:25:31.96,JPN,NTP,0,0,0,,Осымен
Dialogue: 0,1:25:32.83,1:25:34.10,JPN,NTP,0,0,0,,Солай ма?
Dialogue: 0,1:25:45.53,1:25:48.43,JPN,NTP,0,0,0,,Әке, сізді күткенім үшін кешіріңіз.
Dialogue: 0,1:25:49.66,1:25:53.06,JPN,NTP,0,0,0,,Мен оны басып шығарғанмен
Dialogue: 0,1:25:53.33,1:25:54.96,JPN,NTP,0,0,0,,Бұл жақсы сатылмайды.
Dialogue: 0,1:25:59.86,1:26:02.73,JPN,NTP,0,0,0,,Ол қайда кетті?
Dialogue: 0,1:26:06.93,1:26:09.83,JPN,NTP,0,0,0,,Байонетта тағы кездескенше
Dialogue: 0,1:26:20.30,1:26:21.90,JPN,NTP,0,0,0,,Ешқашан оқымайтын балалар
Dialogue: 0,1:26:22.23,1:26:23.90,JPN,NTP,0,0,0,,Маған тезірек үйге бару керек.
Dialogue: 0,1:26:23.93,1:26:25.70,JPN,NTP,0,0,0,,Шіркеу — үйілген мәйіт
Dialogue: 0,1:26:26.06,1:26:28.10,JPN,NTP,0,0,0,,Сіз әпке емессіз.
Dialogue: 0,1:26:28.63,1:26:31.03,JPN,NTP,0,0,0,,О, таң қаларлықтай жаман емес.
Dialogue: 0,1:26:31.60,1:26:33.40,JPN,NTP,0,0,0,,Сіз де ше?
Dialogue: 0,1:26:33.70,1:26:36.76,JPN,NTP,0,0,0,,Жоғары мектеп мұғалімдері бұрынғысынша жақсы
Dialogue: 0,1:26:37.83,1:26:38.96,JPN,NTP,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,1:26:40.70,1:26:44.43,JPN,NTP,0,0,0,,Тәртіпсіз балаларды жазалауым керек.
Dialogue: 0,1:26:54.40,1:26:56.26,JPN,NTP,0,0,0,,Мен сені көкке көтеруге рұқсат етемін
Dialogue: 0,1:26:58.26,1:27:03.70,JPN,NTP,0,0,0,fx,Айдың жарығымен
Dialogue: 0,1:27:04.90,1:27:10.50,JPN,NTP,0,0,0,fx,Жалғыз жүру
Dialogue: 0,1:27:11.43,1:27:17.83,JPN,NTP,0,0,0,fx,Осы теңіздің терең түбі
Dialogue: 0,1:27:18.00,1:27:24.06,JPN,NTP,0,0,0,fx,Дүние бар
Dialogue: 0,1:27:24.93,1:27:30.66,JPN,NTP,0,0,0,fx,Тіпті айналма жол
Dialogue: 0,1:27:31.40,1:27:37.26,JPN,NTP,0,0,0,fx,Мен сені жақсы көремін
