Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.10,0:00:11.11,Default,,0,0,0,,（）
Dialogue: 0,0:00:11.11,0:00:13.18,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:13.18,0:00:15.14,Default,,0,0,0,,⚟ (аяқ дыбысы)
Dialogue: 0,0:00:15.14,0:00:17.15,Default,,0,0,0,,О, мен ұйықтап жатырмын.
Dialogue: 0,0:00:20.08,0:00:22.08,Default,,0,0,0,,(Миямура) Ә? Онда, бәлкім, бұл Иура-кунге қайтаруды ұмытып қалған дискім шығар…
Dialogue: 0,0:00:22.08,0:00:32.09,Default,,0,0,0,,♬～
Dialogue: 0,0:00:33.10,0:00:43.07,Default,,0,0,0,,♬～
Dialogue: 0,0:02:16.20,0:02:18.10,Default,,0,0,0,,⚞(Вудзи) Ах... мен ояумын.
Dialogue: 0,0:02:18.10,0:02:31.08,Default,,0,0,0,,♬～
Dialogue: 0,0:02:31.08,0:02:33.08,Default,,0,0,0,,Бұл менің егіз ағам Теру.
Dialogue: 0,0:02:35.12,0:02:37.12,Default,,0,0,0,,Сіз көзіңізді айналдырасыз ба?
Dialogue: 0,0:02:37.12,0:02:39.09,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:02:40.12,0:02:44.09,Default,,0,0,0,,Эй, бұл өте жеңіл. Тыныш.
Dialogue: 0,0:02:44.09,0:02:46.09,Default,,0,0,0,,Ол әрқашан жақсы қыз.
Dialogue: 0,0:02:46.09,0:02:49.10,Default,,0,0,0,,Бұл жігіт сондай үлпілдек. Дұрыс па?
Dialogue: 0,0:02:49.10,0:02:52.10,Default,,0,0,0,,Сіз шомылып көрдіңіз бе? Сонда бар.
Dialogue: 0,0:02:52.10,0:02:54.10,Default,,0,0,0,,Сіз тегістеліп кетпедіңіз бе?
Dialogue: 0,0:02:54.10,0:02:56.10,Default,,0,0,0,,Бұлай емес еді...
Dialogue: 0,0:02:59.07,0:03:01.08,Default,,0,0,0,,Сіз шатасасыз ба?
Dialogue: 0,0:03:02.11,0:03:04.11,Default,,0,0,0,,Тістемеңіз...
Dialogue: 0,0:03:04.11,0:03:07.12,Default,,0,0,0,,(картонның ашылу дыбысы)
Dialogue: 0,0:03:07.12,0:03:11.09,Default,,0,0,0,,...
Dialogue: 0,0:03:11.09,0:03:13.12,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:03:13.12,0:03:16.09,Default,,0,0,0,,々
Dialogue: 0,0:03:16.09,0:03:20.10,Default,,0,0,0,,...
Dialogue: 0,0:03:20.10,0:03:24.10,Default,,0,0,0,,...
Dialogue: 0,0:03:24.10,0:03:26.10,Default,,0,0,0,,Жоқ, бұл жай ғана хобби.
Dialogue: 0,0:03:26.10,0:03:28.10,Default,,0,0,0,,Хмм….
Dialogue: 0,0:03:28.10,0:03:32.07,Default,,0,0,0,,...
Dialogue: 0,0:03:32.07,0:03:34.08,Default,,0,0,0,,...
Dialogue: 0,0:03:34.08,0:03:37.08,Default,,0,0,0,,… ２
Dialogue: 0,0:03:37.08,0:03:39.08,Default,,0,0,0,,Үй кілтін артта қалдырыңыз.
Dialogue: 0,0:03:39.08,0:03:42.08,Default,,0,0,0,,...
Dialogue: 0,0:03:44.09,0:03:46.15,Default,,0,0,0,,Хмм….
Dialogue: 0,0:03:46.15,0:03:49.16,Default,,0,0,0,,⚟(есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:03:57.07,0:03:59.07,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:03:59.07,0:04:03.07,Default,,0,0,0,,Иә? Бұл қауіпті, сол жаққа барыңыз.
Dialogue: 0,0:04:05.07,0:04:07.08,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:04:08.08,0:04:11.08,Default,,0,0,0,,...
Dialogue: 0,0:04:16.08,0:04:19.09,Default,,0,0,0,,Қорғасын Мен оны таба алмаймын...
Dialogue: 0,0:04:20.06,0:04:22.06,Default,,0,0,0,,О, таптың ба...?
Dialogue: 0,0:04:25.06,0:04:28.06,Default,,0,0,0,,...
Dialogue: 0,0:04:30.07,0:04:33.07,Default,,0,0,0,,Ха ха ха...!
Dialogue: 0,0:04:33.07,0:04:36.07,Default,,0,0,0,,...
Dialogue: 0,0:04:37.07,0:04:39.07,Default,,0,0,0,,Эй, не болды?
Dialogue: 0,0:04:39.07,0:04:44.15,Default,,0,0,0,,...
Dialogue: 0,0:04:44.15,0:04:46.08,Default,,0,0,0,,...
Dialogue: 0,0:04:46.08,0:04:49.08,Default,,0,0,0,,Енді...→
Dialogue: 0,0:04:49.08,0:04:52.05,Default,,0,0,0,,Бұл қандай ит?
Dialogue: 0,0:04:57.09,0:05:01.10,Default,,0,0,0,,…
Dialogue: 0,0:05:01.10,0:05:03.17,Default,,0,0,0,,Ах... жақсы...
Dialogue: 0,0:05:03.17,0:05:07.07,Default,,0,0,0,,～
Dialogue: 0,0:05:07.07,0:05:10.11,Default,,0,0,0,,Мен осы уақытқа дейін келдім.
Dialogue: 0,0:05:10.11,0:05:12.11,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:12.11,0:05:14.18,Default,,0,0,0,,Жақсы...→
Dialogue: 0,0:05:14.18,0:05:17.11,Default,,0,0,0,,Сіз бұл баланың...сіз бе?
Dialogue: 0,0:05:17.11,0:05:20.12,Default,,0,0,0,,Ах. Бұл менің әпкемнің иті.
Dialogue: 0,0:05:20.12,0:05:25.12,Default,,0,0,0,,Гибрид емес пе? Ол оны көтеріп алғанын айтты.
Dialogue: 0,0:05:25.12,0:05:29.09,Default,,0,0,0,,Хмм! Бір нәрсеге ұқсайды.
Dialogue: 0,0:05:29.09,0:05:34.10,Default,,0,0,0,,Мұғалім болсаң... Түсінбейсің бе?
Dialogue: 0,0:05:37.10,0:05:39.10,Default,,0,0,0,,Хмм….
Dialogue: 0,0:05:40.10,0:05:43.10,Default,,0,0,0,,Ит..., дәлірек айтсақ →
Dialogue: 0,0:05:43.10,0:05:45.11,Default,,0,0,0,,Тану...!
Dialogue: 0,0:05:54.12,0:05:58.12,Default,,0,0,0,,...Бұл ит. Мен оны білемін!
Dialogue: 0,0:05:58.12,0:06:00.12,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:01.09,0:06:03.09,Default,,0,0,0,,(Электрлі бұрғы жұмысының дыбысы)
Dialogue: 0,0:06:03.09,0:06:08.10,Default,,0,0,0,,Мен серуенге шыққанда ветеринарлық аурухананың дәрігері ме? Мен сені кездестірдім.
Dialogue: 0,0:06:08.10,0:06:11.10,Default,,0,0,0,,Ой, мен сізді жақсы түсінемін, ұстаз.
Dialogue: 0,0:06:11.10,0:06:13.10,Default,,0,0,0,,Бұл туралы маған бейтаныс әйел айтты.
Dialogue: 0,0:06:13.10,0:06:16.07,Default,,0,0,0,,Бұл мұғалім жақсы адам.
Dialogue: 0,0:06:19.07,0:06:22.11,Default,,0,0,0,,Айтпақшы, сіз бұл иттің қандай тұқым екенін білесіз бе?
Dialogue: 0,0:06:22.11,0:06:26.08,Default,,0,0,0,,Не? Мен білмеймін, өйткені мен оны алдым ...
Dialogue: 0,0:06:34.09,0:06:37.09,Default,,0,0,0,,Гибрид емес пе? Бұл дұрыс!
Dialogue: 0,0:06:41.10,0:06:45.10,Default,,0,0,0,,Жарайды, дайын. Мен оны қайда қоюым керек?
Dialogue: 0,0:06:45.10,0:06:48.07,Default,,0,0,0,,Оны сол қабырғаға қойыңыз. қабырға.
Dialogue: 0,0:06:50.07,0:06:52.07,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:06:53.07,0:06:57.08,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:06:57.08,0:06:59.08,Default,,0,0,0,,Сіз мінгіңіз келе ме?
Dialogue: 0,0:07:06.05,0:07:08.06,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:07:08.06,0:07:10.13,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:07:10.13,0:07:18.10,Default,,0,0,0,,♬～
Dialogue: 0,0:07:18.10,0:07:20.07,Default,,0,0,0,,Кора.
Dialogue: 0,0:07:21.07,0:07:23.07,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:07:23.07,0:07:26.07,Default,,0,0,0,,Эй, міне.
Dialogue: 0,0:07:27.08,0:07:30.08,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:07:30.08,0:07:34.08,Default,,0,0,0,,Аурухана мәселесіне байланысты екеуміз де үйде болмайтын кезіміз болды →
Dialogue: 0,0:07:34.08,0:07:37.09,Default,,0,0,0,,Өйткені мен кенеттен өзімді бос сезінемін →
Dialogue: 0,0:07:37.09,0:07:40.09,Default,,0,0,0,,Мен оны ата-анамның үйіне немесе қонақүйге қалдыруды ойладым→
Dialogue: 0,0:07:40.09,0:07:42.06,Default,,0,0,0,,Теру кенеттен сөйледі.
Dialogue: 0,0:07:42.06,0:07:44.09,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:07:44.09,0:07:46.06,Default,,0,0,0,,Дұрыс рахмет.
Dialogue: 0,0:07:47.06,0:07:49.13,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:07:49.13,0:07:51.13,Default,,0,0,0,,№ ⚟ (аяқ дыбысы)
Dialogue: 0,0:07:53.07,0:07:55.07,Default,,0,0,0,,Қайын ата!
Dialogue: 0,0:07:56.10,0:07:59.07,Default,,0,0,0,,Рахмет. (Тацуо) Иә.
Dialogue: 0,0:08:00.08,0:08:03.14,Default,,0,0,0,,Дұрыс рахмет.
Dialogue: 0,0:08:03.14,0:08:05.08,Default,,0,0,0,,Рахмет. Хехе….
Dialogue: 0,0:08:05.08,0:08:09.08,Default,,0,0,0,,Олай болса, мүмкін емес болып көрінсе, маған дереу хабарласыңыз.
Dialogue: 0,0:08:09.08,0:08:11.09,Default,,0,0,0,,Бұл көтеріліп жатқан жоқ па? Вако-чан.
Dialogue: 0,0:08:11.09,0:08:14.09,Default,,0,0,0,,Осыншама көп адаммен айналыспағаным дұрыс болар деп ойладым.
Dialogue: 0,0:08:14.09,0:08:16.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:16.06,0:08:18.16,Default,,0,0,0,,Қайын ата.
Dialogue: 0,0:08:18.16,0:08:21.10,Default,,0,0,0,,Үйге бара жатқанда дәріханаға тоқтай аламын ба? кешіріңіз.
Dialogue: 0,0:08:21.10,0:08:24.10,Default,,0,0,0,,Ой... Әрине.
Dialogue: 0,0:08:24.10,0:08:27.10,Default,,0,0,0,,Рахмет. (Тацуо) Бұл өте ақымақтық.
Dialogue: 0,0:08:28.10,0:08:32.11,Default,,0,0,0,,Танысқаныма қуаныштымын. Күтпеген жерден ол көбірек қорқытатын болды.
Dialogue: 0,0:08:45.12,0:08:47.09,Default,,0,0,0,,Жақсы араласыңыз.
Dialogue: 0,0:08:47.09,0:08:54.10,Default,,0,0,0,,♬～
Dialogue: 0,0:08:54.10,0:08:57.10,Default,,0,0,0,,Мен... қош келдіңіздер ме?
Dialogue: 0,0:09:19.09,0:09:23.09,Default,,0,0,0,,Мен бейтаныс жер болғандықтан қобалжыдым.
Dialogue: 0,0:09:23.09,0:09:26.09,Default,,0,0,0,,Оны біраз уақытқа жалғыз қалдырайық.
Dialogue: 0,0:09:26.09,0:09:28.06,Default,,0,0,0,,Фалько…
Dialogue: 0,0:09:32.10,0:09:34.17,Default,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:09:34.17,0:09:47.18,Default,,0,0,0,,♬～
Dialogue: 0,0:09:50.12,0:09:52.09,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:09:55.09,0:09:58.06,Default,,0,0,0,,Апельсинді ұнатпайтын сияқтысыз.
Dialogue: 0,0:09:58.06,0:10:09.07,Default,,0,0,0,,♬～
Dialogue: 0,0:10:16.08,0:10:31.09,Default,,0,0,0,,♬～
Dialogue: 0,0:10:31.09,0:10:35.06,Default,,0,0,0,,Рахмет. Менімен жақсы араласқаныңыз үшін рахмет.
Dialogue: 0,0:10:37.10,0:10:40.07,Default,,0,0,0,,Өйткені ол баланың өз қарқыны бар...→
Dialogue: 0,0:10:40.07,0:10:43.07,Default,,0,0,0,,Ақырындап дос болу керек.
Dialogue: 0,0:10:43.07,0:10:45.07,Default,,0,0,0,,Сондай-ақ →
Dialogue: 0,0:10:45.07,0:10:48.08,Default,,0,0,0,,Flip мағынасыз, өйткені мысықтар оқи алмайды.
Dialogue: 0,0:10:51.08,0:10:55.05,Default,,0,0,0,,Сізде арнайы дайындық бар екеніне сенімдімін.
Dialogue: 0,0:10:57.09,0:10:59.09,Default,,0,0,0,,Көңілсіз күйге түсудің қажеті жоқ.
Dialogue: 0,0:10:59.09,0:11:05.09,Default,,0,0,0,,Бірге кездесіп, сөйлесіп, ойнасақ та дос бола алмайтын кездер болады.
Dialogue: 0,0:11:06.06,0:11:08.06,Default,,0,0,0,,Күрделі.
Dialogue: 0,0:11:10.10,0:11:12.07,Default,,0,0,0,,(Кёко) Үйге бара жатып, кемінде пиджагыңды шешіп алсаңшы!
Dialogue: 0,0:11:15.17,0:11:18.07,Default,,0,0,0,,(Кёко) Үйге бара жатып, кемінде пиджагыңды шешіп алсаңшы!
Dialogue: 0,0:11:18.07,0:11:28.05,Default,,0,0,0,,♬～
Dialogue: 0,0:11:35.09,0:11:38.09,Default,,0,0,0,,Менімен... дейсіз бе?
Dialogue: 0,0:11:41.10,0:11:43.10,Default,,0,0,0,,(Қара мысықтың айқайы)
Dialogue: 0,0:11:51.11,0:11:55.08,Default,,0,0,0,,Жоқ... қанша тырыссаңыз да, бұл тым көп күш.
Dialogue: 0,0:11:56.11,0:11:59.08,Default,,0,0,0,,Жай ғана үйреніңіз.
Dialogue: 0,0:12:14.10,0:12:16.10,Default,,0,0,0,,(шу)
Dialogue: 0,0:12:16.10,0:12:18.07,Default,,0,0,0,,О, сен жеңдің бе?
Dialogue: 0,0:12:37.12,0:12:39.09,Default,,0,0,0,,(ырылдаған дыбыс)
Dialogue: 0,0:12:54.10,0:13:13.05,Default,,0,0,0,,♬～
Dialogue: 0,0:13:13.05,0:13:15.06,Default,,0,0,0,,Хмм...!
Dialogue: 0,0:13:19.09,0:13:23.06,Default,,0,0,0,,Келіңіздер. Тамақ ішейік.
Dialogue: 0,0:13:24.10,0:13:27.07,Default,,0,0,0,,Иә, бұл. Бұл сынақ.
Dialogue: 0,0:13:28.07,0:13:30.07,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:33.07,0:13:35.08,Default,,0,0,0,,Күтіңіз, күтіңіз. Олай емес.
Dialogue: 0,0:13:35.08,0:13:38.08,Default,,0,0,0,,Жоқ. иә.
Dialogue: 0,0:13:46.09,0:13:48.06,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:13:53.06,0:14:10.18,Default,,0,0,0,,♬～
Dialogue: 0,0:14:10.18,0:14:12.08,Default,,0,0,0,,(Қара мысықтың айқайы)
Dialogue: 0,0:14:12.08,0:14:24.06,Default,,0,0,0,,♬～
Dialogue: 0,0:14:24.06,0:14:28.06,Default,,0,0,0,,Жақсы. Дос болайық.
Dialogue: 0,0:14:36.07,0:14:39.07,Default,,0,0,0,,А... міне, бұл.
Dialogue: 0,0:14:45.08,0:14:47.08,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:14:47.08,0:14:50.05,Default,,0,0,0,,Сәлем Вако-чан. Сізді мазалағаным үшін кешіріңіз.
Dialogue: 0,0:14:50.05,0:14:52.05,Default,,0,0,0,,Уақытыңызды бөлгеніңізге рахмет.
Dialogue: 0,0:14:52.05,0:14:58.06,Default,,0,0,0,,Бүгін жақсысың ба? Сізді осындай маңызды уақытта мазалағаным үшін кешіріңіз.
Dialogue: 0,0:14:58.06,0:15:02.03,Default,,0,0,0,,Нанно Нанно. Қазірдің өзінде тұрақты кезең.
Dialogue: 0,0:15:03.06,0:15:06.07,Default,,0,0,0,,Бұл жүзім сұрау бойынша.
Dialogue: 0,0:15:06.07,0:15:09.04,Default,,0,0,0,,Бізде Маскат бар! Рақмет сізге!
Dialogue: 0,0:15:09.04,0:15:11.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:11.04,0:15:13.04,Default,,0,0,0,,Ер.
Dialogue: 0,0:15:13.04,0:15:15.08,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:15:15.08,0:15:17.04,Default,,0,0,0,,Жол Сіз бірден түсіндіңіз бе? Иә.
Dialogue: 0,0:15:17.04,0:15:20.05,Default,,0,0,0,,Бұл! ? Мен жүзімді ұнатпаймын →
Dialogue: 0,0:15:20.05,0:15:22.05,Default,,0,0,0,,Білмедің бе?
Dialogue: 0,0:15:23.05,0:15:27.05,Default,,0,0,0,,Сізге емес. Мен оны сұрадым.
Dialogue: 0,0:15:36.06,0:15:38.07,Default,,0,0,0,,О.
Dialogue: 0,0:15:40.03,0:15:42.04,Default,,0,0,0,,Жастық алынды.
Dialogue: 0,0:15:42.04,0:15:44.04,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:15:44.04,0:15:46.04,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:15:46.04,0:15:49.04,Default,,0,0,0,,Сіздің есіңізде қалған сияқты.
Dialogue: 0,0:15:51.05,0:15:53.05,Default,,0,0,0,,Сіз оны өзіңізбен бірге алып келдіңіз бе?
Dialogue: 0,0:15:53.05,0:15:55.05,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:55.05,0:15:57.05,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:15:58.05,0:16:00.05,Default,,0,0,0,,Сіз ұйықтадыңыз ба?
Dialogue: 0,0:16:00.05,0:16:02.06,Default,,0,0,0,,Сонымен... өте сүйкімді!
Dialogue: 0,0:16:02.06,0:16:04.03,Default,,0,0,0,,Қалай кіру қиын!
Dialogue: 0,0:16:06.06,0:16:08.03,Default,,0,0,0,,Бұл менің ағамның үйі.
Dialogue: 0,0:16:14.04,0:16:16.04,Default,,0,0,0,,Бұл есіңізде ме?
Dialogue: 0,0:16:16.04,0:16:18.07,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:16:18.07,0:16:20.04,Default,,0,0,0,,Мен жұмысқа қайта барамын.
Dialogue: 0,0:16:20.04,0:16:22.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:23.08,0:16:26.08,Default,,0,0,0,,О. Біз дос болып кетпедік пе?
Dialogue: 0,0:16:26.08,0:16:29.08,Default,,0,0,0,,Мүмкін, оны көргенде істеу қиын шығар?
Dialogue: 0,0:16:29.08,0:16:33.09,Default,,0,0,0,,Аа, дұрыс. Хехе….
Dialogue: 0,0:16:34.06,0:16:37.06,Default,,0,0,0,,Енді ойлап қарасам, бүгін... Мен солай жасайтын болдым!
Dialogue: 0,0:16:41.06,0:16:45.07,Default,,0,0,0,,Верандада жасаймыз ба? Біраз суық болса да.
Dialogue: 0,0:16:45.07,0:16:52.07,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:16:52.07,0:16:54.08,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:54.08,0:16:56.08,Default,,0,0,0,,Джек-о-фонар, иә?
Dialogue: 0,0:16:57.08,0:17:01.15,Default,,0,0,0,,Мен оны бірінші рет жасап тұрмын. О, дұрыс.
Dialogue: 0,0:17:01.15,0:17:06.15,Default,,0,0,0,,Біздің бала кезімізде заттар онша үлкен емес еді.
Dialogue: 0,0:17:06.15,0:17:10.12,Default,,0,0,0,,Дұрыс. Вако-чан көп тамақ жасады ма?
Dialogue: 0,0:17:13.06,0:17:15.03,Default,,0,0,0,,Бірінші рет! Барымызды салайық.
Dialogue: 0,0:17:16.06,0:17:19.07,Default,,0,0,0,,Мен оны қалай жасау керектігін қарастырдым →
Dialogue: 0,0:17:19.07,0:17:24.04,Default,,0,0,0,,Негізі, ішін ойып алып, онымен не ұнаса, соны істе... Бұл солай.
Dialogue: 0,0:17:24.04,0:17:26.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:26.04,0:17:30.04,Default,,0,0,0,,Дәстүрлі өрнектер сияқты ережелер бар ма деп ойлаймын.
Dialogue: 0,0:17:30.04,0:17:32.05,Default,,0,0,0,,Дәстүр….
Dialogue: 0,0:17:32.05,0:17:35.08,Default,,0,0,0,,Бұл менің бірінші рет және дұрыс орындағым келді.
Dialogue: 0,0:17:35.08,0:17:38.05,Default,,0,0,0,,Мүмкін, бірақ...
Dialogue: 0,0:17:38.05,0:17:41.02,Default,,0,0,0,,Мен бастаушымын, сондықтан қалағаныңды істе. Эй.
Dialogue: 0,0:17:42.06,0:17:44.06,Default,,0,0,0,,…Түсінікті.
Dialogue: 0,0:17:44.06,0:17:48.06,Default,,0,0,0,,Алдымен төбесін кесіп ал... Әй, мен істеймін.
Dialogue: 0,0:17:48.06,0:17:50.06,Default,,0,0,0,,Фалько…
Dialogue: 0,0:17:50.06,0:18:02.04,Default,,0,0,0,,♬～
Dialogue: 0,0:18:02.04,0:18:04.05,Default,,0,0,0,,Бұл... Ол еленбейді.
Dialogue: 0,0:18:04.05,0:18:06.05,Default,,0,0,0,,Өйткені бұл мысық.
Dialogue: 0,0:18:06.05,0:18:10.08,Default,,0,0,0,,Соғысқаннан жақсырақ. Тақсыр.
Dialogue: 0,0:18:10.08,0:18:12.05,Default,,0,0,0,,Қараңдаршы!
Dialogue: 0,0:18:13.05,0:18:16.06,Default,,0,0,0,,Мен ойыншық қорапшамды қазып бастадым! сурет….
Dialogue: 0,0:18:16.06,0:18:20.06,Default,,0,0,0,,Сіз ойнайтын нәрсе іздеп жүрсіз бе?
Dialogue: 0,0:18:20.06,0:18:22.06,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:18:22.06,0:18:25.03,Default,,0,0,0,,Жоқ, жоқ! Не істеуім керек?
Dialogue: 0,0:18:26.03,0:18:29.04,Default,,0,0,0,,Ой, бірдеңе әкел...
Dialogue: 0,0:18:30.04,0:18:33.04,Default,,0,0,0,,Забутон...? Ұйқың келе ме...?
Dialogue: 0,0:18:36.04,0:18:38.05,Default,,0,0,0,,О?
Dialogue: 0,0:18:40.05,0:18:42.05,Default,,0,0,0,,О...
Dialogue: 0,0:18:42.05,0:18:44.09,Default,,0,0,0,,Жастық алынды.
Dialogue: 0,0:18:44.09,0:18:46.05,Default,,0,0,0,,Ол қатып қалды.
Dialogue: 0,0:18:47.05,0:18:49.02,Default,,0,0,0,,Мен саған қарап тұрмын.
Dialogue: 0,0:18:53.16,0:18:56.13,Default,,0,0,0,,Жаңа жастық әкелейін бе?
Dialogue: 0,0:18:58.07,0:19:00.13,Default,,0,0,0,,…Жоқ.
Dialogue: 0,0:19:00.13,0:19:02.07,Default,,0,0,0,,(ойыншық қорапшасын сипау дыбысы)
Dialogue: 0,0:19:02.07,0:19:12.05,Default,,0,0,0,,♬～
Dialogue: 0,0:19:12.05,0:19:15.08,Default,,0,0,0,,Мені жалғыз қалдыруға болмайды.
Dialogue: 0,0:19:15.08,0:19:18.05,Default,,0,0,0,,Біз оюды жасаймыз ба?
Dialogue: 0,0:19:18.05,0:19:26.06,Default,,0,0,0,,♬～
Dialogue: 0,0:19:26.06,0:19:28.13,Default,,0,0,0,,Бұл қызық….
Dialogue: 0,0:19:28.13,0:19:30.06,Default,,0,0,0,,Бұл қызық!
Dialogue: 0,0:19:30.06,0:19:34.07,Default,,0,0,0,,Осындай егжей-тегжейлі үлгіні қалай жасауға болады?
Dialogue: 0,0:19:34.07,0:19:36.07,Default,,0,0,0,,Жақсы...→
Dialogue: 0,0:19:36.07,0:19:40.14,Default,,0,0,0,,Бұл теріні тазарту үшін қолданылатын пышақ, сондықтан оны аршуға болады!
Dialogue: 0,0:19:40.14,0:19:42.08,Default,,0,0,0,,Қорқынышты. Хехе….
Dialogue: 0,0:19:42.08,0:19:49.08,Default,,0,0,0,,♬～
Dialogue: 0,0:19:49.08,0:19:52.05,Default,,0,0,0,,Асқабақтың иісі ғажап.
Dialogue: 0,0:19:52.05,0:19:54.09,Default,,0,0,0,,Мен оны жеуге бола ма?
Dialogue: 0,0:19:54.09,0:19:56.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:56.09,0:20:00.13,Default,,0,0,0,,Әшекейлеуге арналған асқабақтың бұл түрі аса дәмді емес сияқты.
Dialogue: 0,0:20:00.13,0:20:03.06,Default,,0,0,0,,Сізге осындай заттарды жасаған ұнай ма?
Dialogue: 0,0:20:03.06,0:20:07.07,Default,,0,0,0,,Хмм...Шын мәнінде олай болмауы мүмкін.
Dialogue: 0,0:20:07.07,0:20:12.07,Default,,0,0,0,,Қолыңызды қимылдатқанда көңіліңіз ауып қаласыз, солай емес пе?
Dialogue: 0,0:20:16.08,0:20:19.08,Default,,0,0,0,,Сіз әлі де заттар туралы ойлайсыз ба?
Dialogue: 0,0:20:19.08,0:20:24.09,Default,,0,0,0,,Жарайды... Мен тек сау болып туылғанымды қалаймын →
Dialogue: 0,0:20:24.09,0:20:26.05,Default,,0,0,0,,Менің айтар сөзім жоқ...
Dialogue: 0,0:20:30.06,0:20:34.06,Default,,0,0,0,,Мен жұмысқа қайта орала аламын ба деп ойлаймын... немесе бірдеңе.
Dialogue: 0,0:20:34.06,0:20:38.03,Default,,0,0,0,,Көп нәрсе өзгереді, солай ма? мүмкін.
Dialogue: 0,0:20:41.07,0:20:43.04,Default,,0,0,0,,Мазасыздық... дұрыс па?
Dialogue: 0,0:20:45.04,0:20:47.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:47.04,0:21:02.06,Default,,0,0,0,,♬～
Dialogue: 0,0:21:02.06,0:21:04.02,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:21:07.06,0:21:09.06,Default,,0,0,0,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:21:09.06,0:21:11.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:13.07,0:21:16.07,Default,,0,0,0,,Күткендей, мен оны жеңе алмаймын.
Dialogue: 0,0:21:16.07,0:21:18.04,Default,,0,0,0,,Екеуі де сүйкімді!
Dialogue: 0,0:21:19.07,0:21:21.04,Default,,0,0,0,,Шай ішетін уақыт келді.
Dialogue: 0,0:21:21.04,0:21:23.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:23.04,0:21:28.05,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:21:30.05,0:21:34.05,Default,,0,0,0,,♬～
