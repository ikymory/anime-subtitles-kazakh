Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.46,0:00:04.67,Default,,0,0,0,,А...
Dialogue: 0,0:00:05.92,0:00:08.29,Default,,0,0,0,,Аа, жақсы... күте тұрыңыз.
Dialogue: 0,0:00:08.38,0:00:09.50,Default,,0,0,0,,Лилиелдің...
Dialogue: 0,0:00:09.59,0:00:11.59,Default,,0,0,0,,Мен Лилиелдің операторымын.
Dialogue: 0,0:00:12.17,0:00:16.30,Default,,0,0,0,,Өзіңіздің әңгімеңіз туралы қысқаша айтып бере аласыз ба?
Dialogue: 0,0:00:18.97,0:00:19.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:20.02,0:00:25.02,Default,,0,0,0,,♪～
Dialogue: 0,0:01:44.27,0:01:49.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:55.03,0:01:56.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:58.15,0:02:00.37,Default,,0,0,0,,Қаласаңыз, менде аламын.
Dialogue: 0,0:02:00.45,0:02:02.91,Default,,0,0,0,,Бұл арада жақсы адам
Dialogue: 0,0:02:09.04,0:02:10.88,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:02:15.92,0:02:17.72,Default,,0,0,0,,Уф! Эй!
Dialogue: 0,0:02:17.80,0:02:19.88,Default,,0,0,0,,Мен саған не үшін керекпін?
Dialogue: 0,0:02:19.97,0:02:21.22,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:02:21.30,0:02:24.14,Default,,0,0,0,,Сізбен таныс емес адам кенеттен сөйлесе бастаса, қорқынышты болар еді.
Dialogue: 0,0:02:24.22,0:02:26.85,Default,,0,0,0,,Мен де бейтаныс адамдармен сөйлесе алмаймын.
Dialogue: 0,0:02:26.93,0:02:28.94,Default,,0,0,0,,Енді мен батылдығымды жинаймын...
Dialogue: 0,0:02:29.02,0:02:29.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.94,0:02:33.57,Default,,0,0,0,,Сөйлеуге батылдық керек жалғыз мен емес.
Dialogue: 0,0:02:33.65,0:02:37.40,Default,,0,0,0,,Менің Ноноа-саннан сұрайтыным бар.
Dialogue: 0,0:02:37.49,0:02:40.95,Default,,0,0,0,,Мен барлық косплейерлер менің достарым екеніне сенгім келеді.
Dialogue: 0,0:02:41.03,0:02:43.78,Default,,0,0,0,,Ри... Лилиэль туралы не ойлайсың?
Dialogue: 0,0:02:43.87,0:02:44.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:44.78,0:02:48.62,Default,,0,0,0,,Мен оны жақсы көремін, оны жақсы көремін! Мен дос болғым келеді
Dialogue: 0,0:02:49.21,0:02:50.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:52.33,0:02:54.88,Default,,0,0,0,,Ум...
Dialogue: 0,0:02:54.96,0:02:59.22,Default,,0,0,0,,Сіз шынымен... жек көресіз бе?
Dialogue: 0,0:02:59.30,0:03:00.13,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:03:00.22,0:03:02.18,Default,,0,0,0,,Рейтинг шыққан кезде
Dialogue: 0,0:03:02.26,0:03:05.89,Default,,0,0,0,,Мен көңілім қалды.
Dialogue: 0,0:03:05.97,0:03:07.97,Default,,0,0,0,,Менің Лилиелім бірінші орында.
Dialogue: 0,0:03:08.06,0:03:09.31,Default,,0,0,0,,Жеңгенім үшін кешірім сұраймын!
Dialogue: 0,0:03:09.39,0:03:11.64,Default,,0,0,0,,Лилиэль-чан сүйкімдірек
Dialogue: 0,0:03:12.40,0:03:14.31,Default,,0,0,0,,Косплей жарыс емес
Dialogue: 0,0:03:14.40,0:03:16.44,Default,,0,0,0,,Маған рейтинг маңызды емес.
Dialogue: 0,0:03:16.52,0:03:18.74,Default,,0,0,0,,Лилиэль косплейді ұнатса.
Dialogue: 0,0:03:18.82,0:03:21.07,Default,,0,0,0,,Мен мұны жақсы деп ойлағым келеді.
Dialogue: 0,0:03:21.15,0:03:23.82,Default,,0,0,0,,Бірақ мен бұл сезімнен әлі де шатасамын
Dialogue: 0,0:03:23.91,0:03:25.41,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:03:25.49,0:03:27.66,Default,,0,0,0,,Сіз де солай болдыңыз ба?
Dialogue: 0,0:03:27.74,0:03:29.66,Default,,0,0,0,,4-орын көңілді қалдырады
Dialogue: 0,0:03:29.75,0:03:32.58,Default,,0,0,0,,Егер сіз Лилиелді қарсылас деп ойласаңыз ше?
Dialogue: 0,0:03:32.67,0:03:34.46,Default,,0,0,0,,Егер сіз жек көретін болсаңыз немесе ұнатпасаңыз
Dialogue: 0,0:03:34.54,0:03:36.46,Default,,0,0,0,,Маған өз сезімдеріңізді айтқым келеді.
Dialogue: 0,0:03:37.09,0:03:39.88,Default,,0,0,0,,Менің не ойлайтынымды білетін шығарсың деп ойладым.
Dialogue: 0,0:03:40.51,0:03:42.18,Default,,0,0,0,,Ол байсалды адам.
Dialogue: 0,0:03:42.76,0:03:45.18,Default,,0,0,0,,Бірақ не істеуім керек... Мұның бәрі түсінбеушілік
Dialogue: 0,0:03:45.26,0:03:47.26,Default,,0,0,0,,Оны жек көру дұрыс.
Dialogue: 0,0:03:47.35,0:03:50.56,Default,,0,0,0,,Отаку болғандықтан, өзіме ұнайтын нәрсе туралы айтудан бас тартпаймын.
Dialogue: 0,0:03:51.56,0:03:53.02,Default,,0,0,0,,Жокқа шығармау...
Dialogue: 0,0:03:53.10,0:03:56.23,Default,,0,0,0,,Косплей арқылы басқалардан жақсы болуды мақсат ету
Dialogue: 0,0:03:56.31,0:03:58.36,Default,,0,0,0,,Ұрысатындар болса, жарайды деп ойлаймын.
Dialogue: 0,0:03:58.44,0:04:03.36,Default,,0,0,0,,Нәтижесінде, мен Лилиельді жек көрсем де, оған реніш білдірмеймін.
Dialogue: 0,0:04:03.95,0:04:07.12,Default,,0,0,0,,Мен жай ғана түсінгім келеді.
Dialogue: 0,0:04:07.20,0:04:10.79,Default,,0,0,0,,Түсінгіңіз келе ме? Мен не ойлап отырмын?
Dialogue: 0,0:04:11.50,0:04:15.25,Default,,0,0,0,,Байыпты, бірақ... біртүрлі адам
Dialogue: 0,0:04:17.34,0:04:18.63,Default,,0,0,0,,Мен өзімді жайсыз сезінбеймін.
Dialogue: 0,0:04:19.50,0:04:22.30,Default,,0,0,0,,Ол мені дұрыс тыңдайтын сияқты...
Dialogue: 0,0:04:22.38,0:04:25.55,Default,,0,0,0,,Бірақ кешіріңіз.
Dialogue: 0,0:04:26.22,0:04:29.26,Default,,0,0,0,,Мен дыбыс шығара алмаймын.
Dialogue: 0,0:04:29.35,0:04:30.60,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:30.68,0:04:34.31,Default,,0,0,0,,А... сөйлей алмасаң, күтемін.
Dialogue: 0,0:04:34.39,0:04:35.23,Default,,0,0,0,,Күте тұрыңыз ба?
Dialogue: 0,0:04:35.31,0:04:37.52,Default,,0,0,0,,Ешқандай ыңғайсыздық тудырмайды деп үміттенемін.
Dialogue: 0,0:04:38.27,0:04:40.44,Default,,0,0,0,,Ол солай қарайды.
Dialogue: 0,0:05:08.97,0:05:12.43,Default,,0,0,0,,5 минут? 10 минут өтті ме?
Dialogue: 0,0:05:12.52,0:05:14.98,Default,,0,0,0,,Бұл адам шынымен күтіп отыр.
Dialogue: 0,0:05:17.69,0:05:19.94,Default,,0,0,0,,Менің тынысым тынышталды.
Dialogue: 0,0:05:23.23,0:05:24.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:25.74,0:05:28.16,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:05:28.24,0:05:29.37,Default,,0,0,0,,Ум...
Dialogue: 0,0:05:29.99,0:05:31.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:38.75,0:05:42.96,Default,,0,0,0,,Осы уақыт ішінде... Рахмет
Dialogue: 0,0:05:43.05,0:05:44.38,Default,,0,0,0,,Е...
Dialogue: 0,0:05:46.42,0:05:48.38,Default,,0,0,0,,Мен дауыстаймын...
Dialogue: 0,0:05:49.93,0:05:52.93,Default,,0,0,0,,Ах! Қазір емес!
Dialogue: 0,0:05:53.01,0:05:55.22,Default,,0,0,0,,Мен тағы бір қызық нәрсе айттым...
Dialogue: 0,0:05:55.31,0:05:58.35,Default,,0,0,0,,Жоқ, қош келдіңіз.
Dialogue: 0,0:05:59.23,0:06:02.15,Default,,0,0,0,,Ағымдағы әңгіме...
Dialogue: 0,0:06:04.40,0:06:05.44,Default,,0,0,0,,Ах
Dialogue: 0,0:06:07.49,0:06:09.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:09.95,0:06:10.62,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:06:10.62,0:06:12.16,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:06:10.62,0:06:12.16,Default,,0,0,0,,Төмен қара!
Dialogue: 0,0:06:12.16,0:06:12.24,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:06:12.24,0:06:13.08,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:06:12.24,0:06:13.08,Default,,0,0,0,,Күлімсіре!
Dialogue: 0,0:06:13.08,0:06:14.29,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:06:16.87,0:06:18.46,Default,,0,0,0,,Мен күткендей...
Dialogue: 0,0:06:18.54,0:06:21.38,Default,,0,0,0,,Ноноа-чан сені жек көре ме?
Dialogue: 0,0:06:21.46,0:06:23.21,Default,,0,0,0,,Иә! Сонда...
Dialogue: 0,0:06:23.29,0:06:26.17,Default,,0,0,0,,Олай болса, мұнда Ноноа-чанның жанкүйерлері болса...
Dialogue: 0,0:06:26.26,0:06:28.22,Default,,0,0,0,,Сіз мені шынымен жек көресіз, солай ма?
Dialogue: 0,0:06:28.30,0:06:31.39,Default,,0,0,0,,Біріншіден, сіз Лилиелдегі Deresta іс-шарасына келдіңіз.
Dialogue: 0,0:06:31.47,0:06:32.97,Default,,0,0,0,,Ауа Сіз оны оқи алмайсыз ба?
Dialogue: 0,0:06:33.05,0:06:36.77,Default,,0,0,0,,Мен осылай ойлағанымда, барлығы осылай көре бастады.
Dialogue: 0,0:06:40.60,0:06:41.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:43.98,0:06:46.94,Default,,0,0,0,,Кешіріңіз, мен қысқа үзіліс жасаймын.
Dialogue: 0,0:06:50.49,0:06:52.62,Default,,0,0,0,,Кешіріңіз, сэр.
Dialogue: 0,0:06:52.70,0:06:56.29,Default,,0,0,0,,Амансың ба? Сіз мүлде шоғырланбайсыз, солай ма?
Dialogue: 0,0:06:56.37,0:06:58.79,Default,,0,0,0,,Лили Лу!
Dialogue: 0,0:06:58.87,0:07:00.00,Default,,0,0,0,,Мистер 753♡…
Dialogue: 0,0:07:00.08,0:07:01.54,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:01.62,0:07:03.63,Default,,0,0,0,,Сіз мүлде көңіл көтеріп жүрген сияқтысыз!
Dialogue: 0,0:07:04.29,0:07:06.92,Default,,0,0,0,,Мүмкін мен өзіме тым көп қысым жасаған шығармын?
Dialogue: 0,0:07:07.00,0:07:09.80,Default,,0,0,0,,Жоқ, мүлде емес. Бұл 753♡ кінәлі емес...
Dialogue: 0,0:07:09.88,0:07:11.72,Default,,0,0,0,,Біраз уақыт алыңыз.
Dialogue: 0,0:07:16.76,0:07:18.64,Default,,0,0,0,,Сізге қамқорлық.
Dialogue: 0,0:07:18.72,0:07:21.52,Default,,0,0,0,,Сол қыз... Ноноа сені жек көре ме?
Dialogue: 0,0:07:21.60,0:07:22.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:22.60,0:07:25.06,Default,,0,0,0,,Не, сен осыған алаңдайсың ба?
Dialogue: 0,0:07:25.15,0:07:26.57,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:07:26.65,0:07:29.28,Default,,0,0,0,,Мені жек көретін адам болса да
Dialogue: 0,0:07:29.36,0:07:31.15,Default,,0,0,0,,Мен... маған қарама
Dialogue: 0,0:07:31.24,0:07:32.99,Default,,0,0,0,,Мен оны жек көрмеймін.
Dialogue: 0,0:07:35.07,0:07:36.45,Default,,0,0,0,,Білесің бе, Лилиэль?
Dialogue: 0,0:07:36.53,0:07:40.41,Default,,0,0,0,,Мен мұны жақында байқадым, сондықтан мен менменмін деп айта алмаймын.
Dialogue: 0,0:07:40.50,0:07:44.29,Default,,0,0,0,,Мен барлық косплейлерді жақсы көремін
Dialogue: 0,0:07:44.38,0:07:45.88,Default,,0,0,0,,Бірақ сол себепті
Dialogue: 0,0:07:45.96,0:07:49.51,Default,,0,0,0,,Мені бәрі жақсы көрмесе, жақсы деп ойлаймын.
Dialogue: 0,0:07:49.59,0:07:52.09,Default,,0,0,0,,Басқалар мен туралы не ойлайтыны маған байланысты.
Dialogue: 0,0:07:52.72,0:07:55.47,Default,,0,0,0,,Ұнату немесе жақсы ойлану
Dialogue: 0,0:07:55.55,0:07:57.81,Default,,0,0,0,,Оны манипуляциялаудың пайдасы жоқ
Dialogue: 0,0:07:57.89,0:08:01.68,Default,,0,0,0,,Психикалық күштермен жартасты жүзу мүмкін емес сияқты.
Dialogue: 0,0:08:01.77,0:08:05.56,Default,,0,0,0,,Басқа адамдардың жүрегі сіз басқара алатын нәрсе емес.
Dialogue: 0,0:08:06.11,0:08:09.73,Default,,0,0,0,,Бұл сізді жек көретін болса, оны қабылдаудан басқа амалыңыз жоқ дегенді білдіре ме?
Dialogue: 0,0:08:09.82,0:08:11.15,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:11.24,0:08:14.57,Default,,0,0,0,,Сізді жек көреді ме, жоқ па деп ойлаудың қажеті жоқ.
Dialogue: 0,0:08:15.16,0:08:17.53,Default,,0,0,0,,Басқа адамның сіз туралы не ойлайтыны маңызды емес.
Dialogue: 0,0:08:18.33,0:08:20.50,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:20.58,0:08:22.08,Default,,0,0,0,,үшін осы
Dialogue: 0,0:08:22.16,0:08:23.83,Default,,0,0,0,,Бұл бәрін өзгертеді.
Dialogue: 0,0:08:25.96,0:08:29.05,Default,,0,0,0,,Ол бала туралы не ойлайсың? Лилиел
Dialogue: 0,0:08:29.92,0:08:33.05,Default,,0,0,0,,Егер сізге ұнамаса, өзіңізді қарым-қатынасқа мәжбүрлемеңіз, оны елемеңіз.
Dialogue: 0,0:08:33.13,0:08:36.55,Default,,0,0,0,,Менің жүрегім – еркіндігім
Dialogue: 0,0:08:38.72,0:08:39.93,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:42.18,0:08:44.14,Default,,0,0,0,,Мен дос болғым келеді
Dialogue: 0,0:08:44.23,0:08:45.77,Default,,0,0,0,,Өйткені косплейерлер
Dialogue: 0,0:08:45.85,0:08:48.98,Default,,0,0,0,,Бәріміз бірдей ұнататын дос емеспіз бе?
Dialogue: 0,0:08:49.07,0:08:52.19,Default,,0,0,0,,Хмм... Мен де солай ойлаймын.
Dialogue: 0,0:08:52.28,0:08:53.74,Default,,0,0,0,,Содан кейін барыңыз.
Dialogue: 0,0:08:53.82,0:08:54.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:54.74,0:08:57.70,Default,,0,0,0,,Маған басқа адам не ойлап отыр екен
Dialogue: 0,0:08:57.78,0:09:01.24,Default,,0,0,0,,Осыны айтсаң, бәрі өзгеретін шығар, солай ма?
Dialogue: 0,0:09:01.33,0:09:04.08,Default,,0,0,0,,Иә, рахмет!
Dialogue: 0,0:09:12.21,0:09:13.59,Default,,0,0,0,,Мен айта аламын ...
Dialogue: 0,0:09:14.22,0:09:16.47,Default,,0,0,0,,Алғаш рет менің сезімім...
Dialogue: 0,0:09:18.01,0:09:19.26,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:20.35,0:09:22.27,Default,,0,0,0,,Мен ол қызға айтуым керек...
Dialogue: 0,0:09:22.97,0:09:24.73,Default,,0,0,0,,Мені қазір жек көретіні анық.
Dialogue: 0,0:09:24.81,0:09:28.40,Default,,0,0,0,,Сүйген адамыңды дұрыс түсінбей қалу тым ауыр
Dialogue: 0,0:09:28.48,0:09:31.69,Default,,0,0,0,,Мен енді достарыма артық сөз айтпаймын
Dialogue: 0,0:09:31.77,0:09:35.82,Default,,0,0,0,,Бір ғана сөз, ең болмаса менің сезімім...
Dialogue: 0,0:09:36.86,0:09:38.36,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:09:39.20,0:09:41.12,Default,,0,0,0,,Мен Лилиел-чанға айтуым керек!
Dialogue: 0,0:09:42.37,0:09:43.58,Default,,0,0,0,,Ноноа-чан
Dialogue: 0,0:09:45.16,0:09:46.29,Default,,0,0,0,,Лилиэль-чан...
Dialogue: 0,0:09:47.00,0:09:48.25,Default,,0,0,0,,Жек көрсе жақсы
Dialogue: 0,0:09:48.87,0:09:50.46,Default,,0,0,0,,Менің сезімдерім...
Dialogue: 0,0:09:51.17,0:09:52.80,Default,,0,0,0,,Мен сізге айтуым керек!
Dialogue: 0,0:09:52.88,0:09:54.26,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:09:54.34,0:09:56.84,Default,,0,0,0,,Окумура, сен қайда болдың?
Dialogue: 0,0:09:56.92,0:09:57.97,Default,,0,0,0,,Лилита ше?
Dialogue: 0,0:09:58.05,0:10:01.30,Default,,0,0,0,,Ол Ноноаны іздеп барар еді.
Dialogue: 0,0:10:03.60,0:10:05.64,Default,,0,0,0,,Оның жаман адам емес екеніне сенімдімін.
Dialogue: 0,0:10:05.73,0:10:08.10,Default,,0,0,0,,Бәлкім, жай ғана ебедейсіз
Dialogue: 0,0:10:08.19,0:10:09.90,Default,,0,0,0,,Сонымен Лилиса...
Dialogue: 0,0:10:11.19,0:10:12.61,Default,,0,0,0,,Ноноа-чан!
Dialogue: 0,0:10:12.69,0:10:15.40,Default,,0,0,0,,Ал... суретке түсе аламын ба?
Dialogue: 0,0:10:15.48,0:10:16.44,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:10:19.28,0:10:20.11,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:10:20.20,0:10:22.41,Default,,0,0,0,,Кешіріңіз, мен қазір асығып тұрмын.
Dialogue: 0,0:10:22.49,0:10:24.99,Default,,0,0,0,,Да... Менің ойымша, бұл жақсы емес пе?
Dialogue: 0,0:10:25.08,0:10:28.79,Default,,0,0,0,,Жоқ, Ноноа-чан кейіпкер ретінде жаратылған және сөйлемейді.
Dialogue: 0,0:10:28.87,0:10:30.67,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:10:30.75,0:10:32.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:32.38,0:10:35.63,Default,,0,0,0,,Бұл көздер толыққанды адамға ұқсамайды!
Dialogue: 0,0:10:35.71,0:10:37.88,Default,,0,0,0,,Нағыз курьер!
Dialogue: 0,0:10:37.97,0:10:40.55,Default,,0,0,0,,Салқын емес, бірақ қорқынышты...
Dialogue: 0,0:10:40.63,0:10:41.47,Default,,0,0,0,,Сіз...
Dialogue: 0,0:10:41.55,0:10:44.35,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:10:44.43,0:10:46.68,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:10:46.77,0:10:48.85,Default,,0,0,0,,Ноноа-чан түсірілімі басталды!
Dialogue: 0,0:10:48.93,0:10:49.98,Default,,0,0,0,,Шынайы ма? Тезірек барайық!
Dialogue: 0,0:10:50.06,0:10:50.90,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:50.98,0:10:52.40,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:52.48,0:10:54.36,Default,,0,0,0,,Бұл неше минутты алады?
Dialogue: 0,0:10:54.44,0:10:56.61,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:59.95,0:11:01.41,Default,,0,0,0,,Осыдан кейін сағат 1-ден бастап
Dialogue: 0,0:11:01.49,0:11:03.78,Default,,0,0,0,,Тас-қағаз-қайшы бойынша сыйлық турнирі өтеді!
Dialogue: 0,0:11:03.87,0:11:07.12,Default,,0,0,0,,Сәйкесінше, фотостенд 12:30-ға дейін жұмыс істейді.
Dialogue: 0,0:11:07.12,0:11:07.91,Default,,0,0,0,,Сәйкесінше, фотостенд 12:30-ға дейін жұмыс істейді.
Dialogue: 0,0:11:07.12,0:11:07.91,Default,,0,0,0,,Қысқа... 30 минут қалды ма?
Dialogue: 0,0:11:07.91,0:11:08.00,Default,,0,0,0,,Қысқа... 30 минут қалды ма?
Dialogue: 0,0:11:08.00,0:11:10.08,Default,,0,0,0,,Қысқа... 30 минут қалды ма?
Dialogue: 0,0:11:08.00,0:11:10.08,Default,,0,0,0,,Назар аударыңыз!
Dialogue: 0,0:11:10.16,0:11:11.79,Default,,0,0,0,,Бұл косплейге негізделген оқиға емес.
Dialogue: 0,0:11:11.87,0:11:13.50,Default,,0,0,0,,Менің басқа амалым жоқ...
Dialogue: 0,0:11:13.58,0:11:16.21,Default,,0,0,0,,А, қарашы, Лилиел-чан мұнда!
Dialogue: 0,0:11:16.30,0:11:17.96,Default,,0,0,0,,Тасбақа ағайдың блогынан көрдім!
Dialogue: 0,0:11:18.05,0:11:19.55,Default,,0,0,0,,Мен сені қатты жақсы көремін!
Dialogue: 0,0:11:19.63,0:11:22.05,Default,,0,0,0,,Не? Ах... рахмет!
Dialogue: 0,0:11:22.97,0:11:25.89,Default,,0,0,0,,Менің жанкүйерлерім... Мен өте қуаныштымын!
Dialogue: 0,0:11:25.97,0:11:29.85,Default,,0,0,0,,Ах! Бірақ қазір мен Ноноа-чанды іздеуім керек...
Dialogue: 0,0:11:30.89,0:11:33.15,Default,,0,0,0,,Мм... соңында суретке түсе аламын ба?
Dialogue: 0,0:11:33.23,0:11:34.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:34.15,0:11:36.73,Default,,0,0,0,,Лилиел-чан келе жатыр деп естідік.
Dialogue: 0,0:11:36.82,0:11:38.53,Default,,0,0,0,,Мен іздеп жүрмін...
Dialogue: 0,0:11:38.61,0:11:40.28,Default,,0,0,0,,Бар болғаны 30 минут қалды, солай ма?
Dialogue: 0,0:11:40.36,0:11:43.86,Default,,0,0,0,,Мен... Мен бұған бас тарта алмаймын...
Dialogue: 0,0:11:43.95,0:11:47.16,Default,,0,0,0,,Бірақ мен қазір түсіре бастасам...
Dialogue: 0,0:11:47.24,0:11:50.29,Default,,0,0,0,,Ноноа-чанмен...
Dialogue: 0,0:11:55.33,0:11:56.59,Default,,0,0,0,,Лилиел!
Dialogue: 0,0:11:57.21,0:11:58.42,Default,,0,0,0,,Мистер 753♡?
Dialogue: 0,0:11:58.50,0:12:00.30,Default,,0,0,0,,- Иә? -Бұл шын ба?
Dialogue: 0,0:12:00.38,0:12:02.80,Default,,0,0,0,,Кешіріңіз, сіз қазір түсіріп жатырсыз ба?
Dialogue: 0,0:12:02.88,0:12:04.34,Default,,0,0,0,,А, жоқ, әлі жоқ...
Dialogue: 0,0:12:04.43,0:12:07.43,Default,,0,0,0,,Дұрыс, бұл екеуі туыс!
Dialogue: 0,0:12:07.51,0:12:09.31,Default,,0,0,0,,Екі атылды!
Dialogue: 0,0:12:09.39,0:12:13.27,Default,,0,0,0,,Кешіріңіз, бірақ бізде тұтынушылар тым көп...
Dialogue: 0,0:12:13.35,0:12:15.15,Default,,0,0,0,,Мен бұл аймақты пайдалана аламын ба?
Dialogue: 0,0:12:15.23,0:12:17.27,Default,,0,0,0,,А... иә, әрине!
Dialogue: 0,0:12:17.36,0:12:20.28,Default,,0,0,0,,Әңгімеңізді үзгенім үшін кешіріңіз...
Dialogue: 0,0:12:20.36,0:12:23.15,Default,,0,0,0,,Не? Жоқ, жоқ, солай...
Dialogue: 0,0:12:23.24,0:12:25.36,Default,,0,0,0,,753♡-чан менімен сөйлесті...
Dialogue: 0,0:12:25.45,0:12:28.74,Default,,0,0,0,,Қаласаңыз, алдыңғы қатарға отырыңыз.
Dialogue: 0,0:12:30.45,0:12:32.04,Default,,0,0,0,,Аспандағы төрт патша...
Dialogue: 0,0:12:32.12,0:12:33.58,Default,,0,0,0,,Алдыңғы қатарда?
Dialogue: 0,0:12:33.66,0:12:34.50,Default,,0,0,0,,Буф!
Dialogue: 0,0:12:34.58,0:12:36.46,Default,,0,0,0,,Мистер 753♡…
Dialogue: 0,0:12:37.33,0:12:38.17,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:12:38.84,0:12:39.38,Default,,0,0,0,,Хмм... Кешіріңіз!
Dialogue: 0,0:12:39.38,0:12:40.59,Default,,0,0,0,,Хмм... Кешіріңіз!
Dialogue: 0,0:12:39.38,0:12:40.59,Default,,0,0,0,,Иә? Ал Лилиел ше?
Dialogue: 0,0:12:40.59,0:12:41.13,Default,,0,0,0,,Иә? Ал Лилиел ше?
Dialogue: 0,0:12:41.21,0:12:43.63,Default,,0,0,0,,Ой... 753♡-чанды суретке түсіремін
Dialogue: 0,0:12:43.72,0:12:44.84,Default,,0,0,0,,А, сен!
Dialogue: 0,0:12:48.18,0:12:50.89,Default,,0,0,0,,Неліктен әрқашан осылай болады?
Dialogue: 0,0:12:50.97,0:12:54.10,Default,,0,0,0,,Мен саған өз сезімімді айта алғым келеді...
Dialogue: 0,0:12:54.19,0:12:55.94,Default,,0,0,0,,Ноа-чан, жүр.
Dialogue: 0,0:12:59.15,0:13:01.19,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:13:01.28,0:13:03.24,Default,,0,0,0,,Жағдайды бақылауға алдық, бірақ
Dialogue: 0,0:13:03.32,0:13:04.74,Default,,0,0,0,,Ноноа-чан!
Dialogue: 0,0:13:05.45,0:13:07.78,Default,,0,0,0,,-Бұл Лилиэль -5-ші және 4-ші орын?
Dialogue: 0,0:13:07.87,0:13:08.91,Default,,0,0,0,,Лилиэль-чан...
Dialogue: 0,0:13:08.99,0:13:10.70,Default,,0,0,0,,Мазалағаным үшін кешіріңіз!
Dialogue: 0,0:13:10.78,0:13:11.74,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:10.78,0:13:11.74,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:16.79,0:13:18.67,Default,,0,0,0,,Бірге суретке түскіңіз келе ме?
Dialogue: 0,0:13:18.75,0:13:19.88,Default,,0,0,0,,А...
Dialogue: 0,0:13:19.96,0:13:23.84,Default,,0,0,0,,О! Бұл екі адам? Бұл ең жақсы
Dialogue: 0,0:13:23.92,0:13:25.93,Default,,0,0,0,,Бірақ Ноноа-чан бас тартты.
Dialogue: 0,0:13:25.93,0:13:26.51,Default,,0,0,0,,Бірақ Ноноа-чан бас тартты.
Dialogue: 0,0:13:25.93,0:13:26.51,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:26.51,0:13:26.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:26.59,0:13:27.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:26.59,0:13:27.43,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:13:28.05,0:13:30.51,Default,,0,0,0,,Мен Лилиэль-чанға жақынмын...
Dialogue: 0,0:13:31.01,0:13:32.14,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:13:33.18,0:13:34.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:34.73,0:13:36.23,Default,,0,0,0,,Жауап беру…
Dialogue: 0,0:13:36.31,0:13:38.27,Default,,0,0,0,,Мен бұл жолы жауап беруім керек!
Dialogue: 0,0:13:38.35,0:13:39.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:39.98,0:13:42.82,Default,,0,0,0,,Ал... Мен ертерек сөйлесе алдым.
Dialogue: 0,0:13:42.90,0:13:45.07,Default,,0,0,0,,Жай ғана «иә» деп айтыңыз
Dialogue: 0,0:13:45.65,0:13:47.78,Default,,0,0,0,,Бар болғаны бас изеу керек
Dialogue: 0,0:13:48.36,0:13:50.49,Default,,0,0,0,,Маған ұнайтын адам көз ілмеді
Dialogue: 0,0:13:51.12,0:13:52.70,Default,,0,0,0,,Мен қобалжыдым...
Dialogue: 0,0:13:53.83,0:13:55.87,Default,,0,0,0,,Сізді жек көресіз бе?
Dialogue: 0,0:13:55.96,0:13:57.41,Default,,0,0,0,,Мазасыздық болды ма?
Dialogue: 0,0:13:58.33,0:14:01.96,Default,,0,0,0,,Бұл мен үшін біртүрлі. Мен бір рет бас тарттым ...
Dialogue: 0,0:14:03.46,0:14:05.34,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:14:06.09,0:14:07.26,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:09.26,0:14:10.26,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:14:15.06,0:14:17.64,Default,,0,0,0,,Олар сізді қазір жек көруі мүмкін, бірақ
Dialogue: 0,0:14:17.73,0:14:20.31,Default,,0,0,0,,Мен барлық косплейерлер менің достарым деп есептеймін.
Dialogue: 0,0:14:20.40,0:14:23.77,Default,,0,0,0,,Мен бір-бірімізді сөзсіз түсінетін достар екенімізге сенгім келеді.
Dialogue: 0,0:14:23.86,0:14:26.07,Default,,0,0,0,,Мен туралы не ойласаң да
Dialogue: 0,0:14:27.03,0:14:29.74,Default,,0,0,0,,Мен сенімен косплей ойнағым келеді.
Dialogue: 0,0:14:31.16,0:14:32.70,Default,,0,0,0,,Періште…
Dialogue: 0,0:14:42.21,0:14:43.59,Default,,0,0,0,,О...
Dialogue: 0,0:14:44.25,0:14:48.26,Default,,0,0,0,,Сахнаға Лилиел періште түсті!
Dialogue: 0,0:14:48.34,0:14:50.84,Default,,0,0,0,,Ах, Лилиэль...
Dialogue: 0,0:14:50.93,0:14:53.30,Default,,0,0,0,,Бұл нағыз Лилиэль!
Dialogue: 0,0:14:54.26,0:14:56.77,Default,,0,0,0,,А... сонда мен ше?
Dialogue: 0,0:14:57.47,0:15:00.44,Default,,0,0,0,,Мен Лилиелдің қасындамын...
Dialogue: 0,0:15:02.06,0:15:02.90,Default,,0,0,0,,Су…
Dialogue: 0,0:15:09.82,0:15:12.24,Default,,0,0,0,,Мұздың мөлдір ұшқыны
Dialogue: 0,0:15:12.32,0:15:14.95,Default,,0,0,0,,Кобальт көк 7-ші Золушка
Dialogue: 0,0:15:16.49,0:15:17.33,Default,,0,0,0,,Курьер
Dialogue: 0,0:15:19.87,0:15:21.79,Default,,0,0,0,,Мен сөйледім...
Dialogue: 0,0:15:27.46,0:15:28.71,Default,,0,0,0,,Ноноа-чан...
Dialogue: 0,0:15:31.59,0:15:32.97,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:15:33.05,0:15:33.59,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:15:33.59,0:15:35.47,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:15:33.59,0:15:35.47,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:15:35.47,0:15:35.55,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:15:35.55,0:15:38.22,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:15:35.55,0:15:38.22,Default,,0,0,0,,Дәл қазір екеуінің ең көп талқыланатын комбинациясы...
Dialogue: 0,0:15:38.31,0:15:40.85,Default,,0,0,0,,Мен оны бұл оқиғада көремін деп ойламадым...
Dialogue: 0,0:15:40.94,0:15:42.48,Default,,0,0,0,,Келгеніңізге қуаныштымын~
Dialogue: 0,0:15:43.23,0:15:45.94,Default,,0,0,0,,Енді екінші тікелей эфирдегі позаны орындайық.
Dialogue: 0,0:15:46.02,0:15:49.03,Default,,0,0,0,,Курияның алғашқы көріністері...
Dialogue: 0,0:15:49.11,0:15:51.40,Default,,0,0,0,,Маған да сол жер қатты ұнайды!
Dialogue: 0,0:15:51.49,0:15:54.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:54.20,0:15:55.82,Default,,0,0,0,,Лилиса…
Dialogue: 0,0:15:55.91,0:15:58.74,Default,,0,0,0,,Біраз уақыт бұрын мен Ноноа мені жек көретін шығар деп ойладым.
Dialogue: 0,0:15:58.83,0:16:00.50,Default,,0,0,0,,Мен жай ғана ашуландым.
Dialogue: 0,0:16:00.58,0:16:03.08,Default,,0,0,0,,Өсіп келе жатқан жігіт.
Dialogue: 0,0:16:04.79,0:16:06.84,Default,,0,0,0,,Жарайды, мен оны суретке түсіремін, сосын маған жүктеріңді беріңдер.
Dialogue: 0,0:16:06.92,0:16:09.42,Default,,0,0,0,,Фотограф пен қамқоршы қарама-қарсы емес пе?
Dialogue: 0,0:16:09.51,0:16:11.26,Default,,0,0,0,,10 минут та емес.
Dialogue: 0,0:16:11.34,0:16:13.13,Default,,0,0,0,,Мен де барамын.
Dialogue: 0,0:16:13.22,0:16:14.34,Default,,0,0,0,,Келесі…
Dialogue: 0,0:16:16.43,0:16:18.26,Default,,0,0,0,,Менің орталық әнім...
Dialogue: 0,0:16:18.35,0:16:20.56,Default,,0,0,0,,Бұл "Angels UP!!!" тобының курткасы!
Dialogue: 0,0:16:21.52,0:16:22.56,Default,,0,0,0,,Дауыссыз да
Dialogue: 0,0:16:23.23,0:16:26.02,Default,,0,0,0,,Жұмысым арқылы... Мен косплей арқылы сөйлесе аламын
Dialogue: 0,0:16:27.36,0:16:29.27,Default,,0,0,0,,Рахмет, Лилиэл-чан
Dialogue: 0,0:16:29.36,0:16:32.78,Default,,0,0,0,,Мен ең жақын дос тапқандай болдым, мен...
Dialogue: 0,0:16:33.36,0:16:34.99,Default,,0,0,0,,Сөйлегенде сәл салғырт естілуім мүмкін—
Dialogue: 0,0:16:35.57,0:16:37.45,Default,,0,0,0,,Төмен қара!
Dialogue: 0,0:16:39.03,0:16:40.16,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:16:39.03,0:16:40.16,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:40.16,0:16:43.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:44.37,0:16:46.13,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:16:46.75,0:16:49.34,Default,,0,0,0,,Бұл мүмкін емес деп айтқаным үшін кешіріңіз.
Dialogue: 0,0:16:49.42,0:16:52.46,Default,,0,0,0,,Мен Ноноа-чанмен суретке түскім келді...
Dialogue: 0,0:16:52.55,0:16:53.97,Default,,0,0,0,,(Гогогого…)
Dialogue: 0,0:16:54.05,0:16:54.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:55.63,0:16:57.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:58.97,0:17:02.56,Default,,0,0,0,,Кешіріңіз, мен...
Dialogue: 0,0:17:05.73,0:17:07.60,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:10.15,0:17:15.11,Default,,0,0,0,,Лилита, бізге байланыс ақпаратын алмасу керек пе?
Dialogue: 0,0:17:16.82,0:17:18.53,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,0:17:18.62,0:17:22.75,Default,,0,0,0,,Мен ең батыл әрекет жасадым.
Dialogue: 0,0:17:23.37,0:17:26.25,Default,,0,0,0,,Мен Ноноа-чанның сезімін өзгерте алмаймын.
Dialogue: 0,0:17:26.33,0:17:28.96,Default,,0,0,0,,Мен жай ғана өз сезімімді білдірдім
Dialogue: 0,0:17:29.04,0:17:32.63,Default,,0,0,0,,Менің ойымша, сіз біреуді оны қабылдауға мәжбүрлей алмайсыз.
Dialogue: 0,0:17:35.22,0:17:37.84,Default,,0,0,0,,Мен мойындадым деп ойладым.
Dialogue: 0,0:17:37.93,0:17:40.76,Default,,0,0,0,,Ең бастысы Ноноа-чанның сезімі.
Dialogue: 0,0:17:41.39,0:17:42.72,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:47.69,0:17:49.19,Default,,0,0,0,,айтқан жоқпын ба?
Dialogue: 0,0:17:49.90,0:17:52.78,Default,,0,0,0,,Лилиэль-чанның достары көп.
Dialogue: 0,0:17:52.86,0:17:54.40,Default,,0,0,0,,Бұл мен болуым міндетті емес
Dialogue: 0,0:17:55.32,0:17:57.86,Default,,0,0,0,,Өмірде бір рет болатын жақсы түс көрдім.
Dialogue: 0,0:17:57.95,0:18:00.62,Default,,0,0,0,,Бұл жақсы. Сонымен...
Dialogue: 0,0:18:02.87,0:18:04.58,Default,,0,0,0,,Кем дегенде, Куними оны есінде сақтамады.
Dialogue: 0,0:18:05.25,0:18:08.21,Default,,0,0,0,,Алғашқы дос болған жоқсың ба?
Dialogue: 0,0:18:08.29,0:18:11.04,Default,,0,0,0,,Иә, бұл соңы...
Dialogue: 0,0:18:11.13,0:18:14.30,Default,,0,0,0,,Бұл жеткіліксіз деп ойлаймын!
Dialogue: 0,0:18:15.21,0:18:17.51,Default,,0,0,0,,Мен достаса алмаймын
Dialogue: 0,0:18:17.59,0:18:19.51,Default,,0,0,0,,Мәңгі жалғыз қалғаным жақсы.
Dialogue: 0,0:18:20.14,0:18:21.14,Default,,0,0,0,,Кім?
Dialogue: 0,0:18:21.93,0:18:24.10,Default,,0,0,0,,Лилиэль-чан жақсы қыз.
Dialogue: 0,0:18:24.18,0:18:27.10,Default,,0,0,0,,Сен де маған жақсылық жасадың.
Dialogue: 0,0:18:27.18,0:18:29.77,Default,,0,0,0,,Менің досым бола алмайсың.
Dialogue: 0,0:18:29.85,0:18:32.48,Default,,0,0,0,,Бұл дауыс... мен бе?
Dialogue: 0,0:18:32.56,0:18:35.11,Default,,0,0,0,,Маған мейірімді болғаныңыз үшін
Dialogue: 0,0:18:35.19,0:18:38.20,Default,,0,0,0,,Алып-соғып, әрі қарай жүрсең, әбігер болады.
Dialogue: 0,0:18:38.28,0:18:39.49,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:18:39.49,0:18:40.11,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:18:39.49,0:18:40.11,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:18:40.11,0:18:40.20,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:18:40.20,0:18:41.03,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:18:40.20,0:18:41.03,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:18:41.11,0:18:42.66,Default,,0,0,0,,Шулы, үндемеңіз
Dialogue: 0,0:18:42.74,0:18:44.24,Default,,0,0,0,,Бұл барудың ең оңай жолы.
Dialogue: 0,0:18:44.33,0:18:45.87,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:18:45.95,0:18:48.91,Default,,0,0,0,,Сөйлесуге тырысқан сайын ауырады.
Dialogue: 0,0:18:49.00,0:18:51.58,Default,,0,0,0,,Адамдармен неғұрлым көп араласуға тырыссаңыз, соғұрлым көп зардап шегесіз.
Dialogue: 0,0:18:51.67,0:18:52.50,Default,,0,0,0,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:18:52.58,0:18:54.80,Default,,0,0,0,,Тоқта! Неге олай дейсің?
Dialogue: 0,0:18:54.88,0:18:58.26,Default,,0,0,0,,Өйткені мен сөйлеспегенді жөн көремін.
Dialogue: 0,0:18:59.34,0:19:00.30,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:01.55,0:19:06.14,Default,,0,0,0,,Көрдім... бұл дауысты мен жасаған.
Dialogue: 0,0:19:06.22,0:19:10.02,Default,,0,0,0,,Көптен бері илеп, илеген наным-сенім.
Dialogue: 0,0:19:10.10,0:19:11.60,Default,,0,0,0,,Мен әрқашан жалғыз болдым
Dialogue: 0,0:19:11.69,0:19:15.02,Default,,0,0,0,,Өйткені, мен...
Dialogue: 0,0:19:15.77,0:19:17.44,Default,,0,0,0,,Достар...
Dialogue: 0,0:19:18.28,0:19:21.07,Default,,0,0,0,,Мен ешқашан дос бола алмаймын
Dialogue: 0,0:19:21.16,0:19:22.70,Default,,0,0,0,,Мен өмір бойы жалғыз боламын
Dialogue: 0,0:19:22.78,0:19:25.78,Default,,0,0,0,,Менмін деп айтуды доғар.
Dialogue: 0,0:19:26.66,0:19:27.79,Default,,0,0,0,,Мен Ноноамын
Dialogue: 0,0:19:27.87,0:19:29.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:29.75,0:19:31.54,Default,,0,0,0,,Күні кешеге дейін мен болған сенсің!
Dialogue: 0,0:19:31.62,0:19:32.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:32.96,0:19:35.38,Default,,0,0,0,,Мен әрқашан бірдей емеспін
Dialogue: 0,0:19:36.17,0:19:37.88,Default,,0,0,0,,Өйткені мен дыбыс шығара алатынмын
Dialogue: 0,0:19:38.59,0:19:40.38,Default,,0,0,0,,Мен өз сезімімді жеткізе алдым
Dialogue: 0,0:19:41.22,0:19:43.39,Default,,0,0,0,,Мен өзіме ұнайтын адаммен тіл табыса алдым
Dialogue: 0,0:19:46.05,0:19:47.39,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:19:48.35,0:19:50.89,Default,,0,0,0,,Мен курьер болдым
Dialogue: 0,0:19:50.98,0:19:52.81,Default,,0,0,0,,Бұл жай ғана жасанды ойын.
Dialogue: 0,0:19:52.90,0:19:54.27,Default,,0,0,0,,Әлі де!
Dialogue: 0,0:19:55.15,0:19:57.73,Default,,0,0,0,,Мен өзімнен басқа біреу бола аламын
Dialogue: 0,0:19:57.82,0:20:02.57,Default,,0,0,0,,Ондай жағдайда мен кешегі адамнан басқаша мен бола алуым керек.
Dialogue: 0,0:20:09.33,0:20:10.79,Default,,0,0,0,,Мен өзгерте аламын
Dialogue: 0,0:20:10.87,0:20:14.17,Default,,0,0,0,,Мен өзгерте аламын!
Dialogue: 0,0:20:16.88,0:20:17.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:21.55,0:20:22.88,Default,,0,0,0,,Ноноа-чан...
Dialogue: 0,0:20:30.47,0:20:31.31,Default,,0,0,0,,Және…
Dialogue: 0,0:20:31.93,0:20:34.81,Default,,0,0,0,,Менің досым болшы...
Dialogue: 0,0:20:39.32,0:20:40.98,Default,,0,0,0,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:20:42.03,0:20:44.66,Default,,0,0,0,,Иә! Әрине!
Dialogue: 0,0:20:44.74,0:20:47.32,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:20:47.41,0:20:48.87,Default,,0,0,0,,Мен өзгерте аламын
Dialogue: 0,0:20:49.87,0:20:50.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:50.79,0:20:51.87,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:51.87,0:20:52.70,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:51.87,0:20:52.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:52.79,0:20:54.92,Default,,0,0,0,,Жылама, Ноноа-чан!
Dialogue: 0,0:20:52.79,0:20:54.92,Default,,0,0,0,,Маған сол кезде айтсаң сенер ме едің?
Dialogue: 0,0:20:54.92,0:20:56.67,Default,,0,0,0,,Маған сол кезде айтсаң сенер ме едің?
Dialogue: 0,0:20:57.83,0:21:03.30,Default,,0,0,0,,Менің ең бірінші досым мен қатты жақсы көретін періште болды.
Dialogue: 0,0:21:04.59,0:21:06.22,Default,,0,0,0,,Жарайсың, Микари-чан!
Dialogue: 0,0:21:06.22,0:21:06.97,Default,,0,0,0,,Жарайсың, Микари-чан!
Dialogue: 0,0:21:06.22,0:21:06.97,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:21:06.97,0:21:07.05,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:21:07.05,0:21:07.55,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:21:07.05,0:21:07.55,Default,,0,0,0,,Бір сәт бүйірге бұрылайық.
Dialogue: 0,0:21:07.55,0:21:08.60,Default,,0,0,0,,Бір сәт жан-жаққа бұрылайық.
Dialogue: 0,0:21:09.68,0:21:11.81,Default,,0,0,0,,Мен бүгін сенімдімін, ағалар.
Dialogue: 0,0:21:09.68,0:21:11.81,Default,,0,0,0,,Дұрыс, солай сезіледі.
Dialogue: 0,0:21:11.89,0:21:14.56,Default,,0,0,0,,Сіз қандай да бір іс-шараға бара жатқаныңызды айттыңыз.
Dialogue: 0,0:21:11.89,0:21:14.56,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:21:14.64,0:21:17.27,Default,,0,0,0,,Бұлай жалғаса берсе, ол одан сайын нашарлайды...
Dialogue: 0,0:21:17.35,0:21:19.90,Default,,0,0,0,,Ах! Маған сол салмақты жүз ұнайды
Dialogue: 0,0:21:20.73,0:21:21.61,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:22.53,0:21:23.03,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:21:23.03,0:21:24.11,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:21:23.03,0:21:24.11,Default,,0,0,0,,Стратегия - танымал модель болу және үлкендеріңізді таң қалдыру.
Dialogue: 0,0:21:24.11,0:21:25.07,Default,,0,0,0,,Менің стратегиям - танымал модель болу және үлкендерімді таң қалдыру.
Dialogue: 0,0:21:25.07,0:21:25.57,Default,,0,0,0,,Стратегия - танымал модель болу және үлкендеріңізді таң қалдыру.
Dialogue: 0,0:21:25.07,0:21:25.57,Default,,0,0,0,,Маған қарап бере аласыз ба?
Dialogue: 0,0:21:25.57,0:21:25.65,Default,,0,0,0,,Маған қарап бере аласыз ба?
Dialogue: 0,0:21:25.65,0:21:26.41,Default,,0,0,0,,Маған қарап бере аласыз ба?
Dialogue: 0,0:21:25.65,0:21:26.41,Default,,0,0,0,,Сәтсіздіктен де артық
Dialogue: 0,0:21:26.41,0:21:27.45,Default,,0,0,0,,Сәтсіздіктен де көп
Dialogue: 0,0:21:27.53,0:21:31.70,Default,,0,0,0,,Әсерлері анық, сондықтан косплей стратегиясына ауысудан басқа амалымыз жоқ.
Dialogue: 0,0:21:32.45,0:21:34.41,Default,,0,0,0,,Иә, жақсы болды.
Dialogue: 0,0:21:34.50,0:21:36.12,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:21:36.21,0:21:37.79,Default,,0,0,0,,Сонымен, сұхбат алған дұрыс па?
Dialogue: 0,0:21:37.87,0:21:39.08,Default,,0,0,0,,Иә
Dialogue: 0,0:21:39.67,0:21:40.67,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:40.75,0:21:44.01,Default,,0,0,0,,Кенеттен президентпен тікелей сөйлесу мүмкін емес.
Dialogue: 0,0:21:44.09,0:21:46.59,Default,,0,0,0,,Кеңсенің стратегиялық бейнесі бар.
Dialogue: 0,0:21:46.68,0:21:48.59,Default,,0,0,0,,Косплей...
Dialogue: 0,0:21:50.05,0:21:53.02,Default,,0,0,0,,Микари-чан бұрын ұялшақ болатын.
Dialogue: 0,0:21:53.10,0:21:54.64,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:21:54.73,0:21:57.35,Default,,0,0,0,,Бірақ егер сіз мұны істеуге шешім қабылдасаңыз, бар күшіңізді саласыз ба?
Dialogue: 0,0:21:57.44,0:21:58.56,Default,,0,0,0,,Тұлғасы бар...
Dialogue: 0,0:21:59.23,0:22:00.48,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:22:00.56,0:22:03.36,Default,,0,0,0,,Сіз демалыс күндеріңізде не істейсіз?
Dialogue: 0,0:22:03.44,0:22:05.49,Default,,0,0,0,,Сіз стратегиялық болуыңыз керек!
Dialogue: 0,0:22:06.03,0:22:07.32,Default,,0,0,0,,- (Микари) косплей! -(Менеджер) Әй!
Dialogue: 0,0:22:07.40,0:22:09.82,Default,,0,0,0,,Косплей? Ха~
Dialogue: 0,0:22:09.91,0:22:12.28,Default,,0,0,0,,Менің хоббиім косплей.
Dialogue: 0,0:22:12.37,0:22:14.20,Default,,0,0,0,,Бұдан былай, тіпті SNS-де
Dialogue: 0,0:22:14.29,0:22:17.00,Default,,0,0,0,,Мен косплей суретін жүктеп салуды ойлап жүрмін!
Dialogue: 0,0:22:17.08,0:22:19.29,Default,,0,0,0,,Күте тұрыңыз... Мен тыңдамадым!
Dialogue: 0,0:22:19.37,0:22:20.71,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:22:22.75,0:22:25.92,Default,,0,0,0,,Мені күт, Сенпай!
