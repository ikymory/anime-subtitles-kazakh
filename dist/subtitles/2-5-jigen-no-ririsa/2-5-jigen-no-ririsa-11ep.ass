Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.50,0:00:04.83,Default,,0,0,0,,Косплей құдайы...
Dialogue: 0,0:00:05.63,0:00:07.17,Default,,0,0,0,,Өз күшімен
Dialogue: 0,0:00:09.13,0:00:10.30,Default,,0,0,0,,Айнал!
Dialogue: 0,0:00:12.84,0:00:14.34,Default,,0,0,0,,Мен жеңіле алмаймын
Dialogue: 0,0:00:15.59,0:00:18.35,Default,,0,0,0,,Өйткені есіме түсті
Dialogue: 0,0:00:18.43,0:00:20.81,Default,,0,0,0,,Кай-сама сен маған қарап тұрсың ба?
Dialogue: 0,0:00:20.89,0:00:23.27,Default,,0,0,0,,Мен сондай сүйкімді болып кеттім
Dialogue: 0,0:00:24.35,0:00:27.23,Default,,0,0,0,,Барлығы маған қарайды!
Dialogue: 0,0:00:27.90,0:00:29.65,Default,,0,0,0,,Бұл не нәрсе...
Dialogue: 0,0:00:29.73,0:00:31.32,Default,,0,0,0,,Шамасы, Лилиэль-доно
Dialogue: 0,0:00:31.40,0:00:33.95,Default,,0,0,0,,Сіз 753♡-дононы өртеп жіберген сияқтысыз.
Dialogue: 0,0:00:34.74,0:00:37.95,Default,,0,0,0,,Әрине, адамдар саны көбейіп бара жатқан сияқты...
Dialogue: 0,0:00:38.03,0:00:40.16,Default,,0,0,0,,Сонымен... Бірақ Лилиэль де жеңілген жоқ!
Dialogue: 0,0:00:40.87,0:00:44.12,Default,,0,0,0,,Баяу болса да жәшіктердің саны біртіндеп көбейіп келеді!
Dialogue: 0,0:00:48.04,0:00:52.01,Default,,0,0,0,,♪～
Dialogue: 0,0:02:10.00,0:02:15.38,Default,,0,0,0,,～♪
Dialogue: 0,0:02:27.43,0:02:29.52,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:02:29.60,0:02:30.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:30.77,0:02:31.77,Default,,0,0,0,,Лорд Окумура да...
Dialogue: 0,0:02:31.86,0:02:35.82,Default,,0,0,0,,Жоқ, тіпті Лорд Лилиел де байқамайтын сияқты.
Dialogue: 0,0:02:36.40,0:02:39.86,Default,,0,0,0,,Кейіпкердің танымалдылығы Кейіпкердің танымалдылығы Экспозиция
Dialogue: 0,0:02:39.95,0:02:41.87,Default,,0,0,0,,Осындай факторлардан басқа
Dialogue: 0,0:02:41.95,0:02:45.37,Default,,0,0,0,,Қоршауға болатын технология бар екені рас.
Dialogue: 0,0:02:45.45,0:02:47.29,Default,,0,0,0,,Бұл табиғи нәрсе
Dialogue: 0,0:02:47.95,0:02:51.21,Default,,0,0,0,,Егер адам саны азаймаса, ол тек көбейеді.
Dialogue: 0,0:02:51.29,0:02:53.75,Default,,0,0,0,,Жарайды... дұрыс.
Dialogue: 0,0:02:53.84,0:02:57.84,Default,,0,0,0,,Басқаша айтқанда, ең бастысы - басынан бастап сол жерде болған адамдарды жібермеу.
Dialogue: 0,0:02:57.92,0:03:00.93,Default,,0,0,0,,Сіз әлі де суретке түсіп жатырсыз ба? Ол басынан бері бар
Dialogue: 0,0:03:01.01,0:03:03.47,Default,,0,0,0,,Иә! Аа~ Өйткені, әйтеуір
Dialogue: 0,0:03:03.55,0:03:05.85,Default,,0,0,0,,Бұл баланың шегі жоқ.
Dialogue: 0,0:03:05.93,0:03:07.18,Default,,0,0,0,,Дөңгелектеп көрсеңіз...
Dialogue: 0,0:03:07.27,0:03:09.64,Default,,0,0,0,,Қараңдаршы! Тағы бір жаңа поза, бұл да сүйкімді~
Dialogue: 0,0:03:09.64,0:03:10.56,Default,,0,0,0,,Қараңдаршы! Тағы бір жаңа поза, бұл да сүйкімді~
Dialogue: 0,0:03:09.64,0:03:10.56,Default,,0,0,0,,Жылдам, бізді Диоға апар.
Dialogue: 0,0:03:10.64,0:03:11.44,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:11.44,0:03:11.94,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:11.44,0:03:11.94,Default,,0,0,0,,Лилиэль-дононың ерекше белгілері
Dialogue: 0,0:03:11.94,0:03:13.48,Default,,0,0,0,,Лилиэль-дононың ерекше белгілері
Dialogue: 0,0:03:13.56,0:03:16.27,Default,,0,0,0,,Позалар мен өрнектердің алуан түрлілігі
Dialogue: 0,0:03:16.36,0:03:17.15,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:17.15,0:03:17.98,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:17.15,0:03:17.98,Default,,0,0,0,,Поза қалыпты.
Dialogue: 0,0:03:18.07,0:03:20.24,Default,,0,0,0,,Мен көп нәрсені ойлай алмаймын.
Dialogue: 0,0:03:20.32,0:03:21.03,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:21.03,0:03:21.53,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:21.03,0:03:21.53,Default,,0,0,0,,Көптеген жаңадан бастағандар үшін 5-тен 10-ға дейінгі позалар шек болып табылады.
Dialogue: 0,0:03:21.53,0:03:25.70,Default,,0,0,0,,Көптеген жаңадан бастағандар үшін 5-тен 10-ға дейінгі позалар шек болып табылады.
Dialogue: 0,0:03:25.78,0:03:28.04,Default,,0,0,0,,Бірақ Лилиэль-доно...
Dialogue: 0,0:03:28.12,0:03:31.21,Default,,0,0,0,,А... Менің уақытым мүлдем жетпейді.
Dialogue: 0,0:03:31.29,0:03:34.13,Default,,0,0,0,,Иә, сол көрініс, сол поза...
Dialogue: 0,0:03:34.21,0:03:35.29,Default,,0,0,0,,тарылту керек
Dialogue: 0,0:03:35.84,0:03:37.80,Default,,0,0,0,,Мен әлі де сурет саламын
Dialogue: 0,0:03:37.88,0:03:40.01,Default,,0,0,0,,1000 қалды!
Dialogue: 0,0:03:40.59,0:03:42.26,Default,,0,0,0,,Бұл әйгілі мұқаба өнері!
Dialogue: 0,0:03:42.34,0:03:44.47,Default,,0,0,0,,Лилиэль-доно, бастапқы көрініс
Dialogue: 0,0:03:44.55,0:03:46.93,Default,,0,0,0,,Мен адалдықпен ойнайтын косплейермін
Dialogue: 0,0:03:47.01,0:03:48.26,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:03:48.35,0:03:51.18,Default,,0,0,0,,Бір мағынада позалар туралы ойлаудың қажеті жоқ.
Dialogue: 0,0:03:51.27,0:03:53.35,Default,,0,0,0,,Негізгі оқиға да, қосалқы оқиға да ұзаққа созылған манга.
Dialogue: 0,0:03:53.44,0:03:55.73,Default,,0,0,0,,Көптеген суреттер мен әйгілі көріністер бар.
Dialogue: 0,0:03:55.81,0:03:58.19,Default,,0,0,0,,Мұның бәрі Лилитаның басында.
Dialogue: 0,0:03:59.11,0:04:02.11,Default,,0,0,0,,Түпнұсқа осы позадан басталады.
Dialogue: 0,0:04:02.20,0:04:04.03,Default,,0,0,0,,Мен оны барлығының көргенін қалаймын!
Dialogue: 0,0:04:04.11,0:04:05.74,Default,,0,0,0,,О, бұл керемет!
Dialogue: 0,0:04:05.82,0:04:09.83,Default,,0,0,0,,Аспандағы Төрт патшаға қатты толқығаным сонша, байқамай қалдым! Сондай сүйкімді...
Dialogue: 0,0:04:09.91,0:04:11.79,Default,,0,0,0,,Бұл қашан болды...
Dialogue: 0,0:04:12.79,0:04:14.54,Default,,0,0,0,,Лилиэль-доно...
Dialogue: 0,0:04:14.62,0:04:18.29,Default,,0,0,0,,Сіз фотографтарды қызықтыра алатын данышпансыз.
Dialogue: 0,0:04:18.80,0:04:21.51,Default,,0,0,0,,Суретке түсіруге қарсы ма?
Dialogue: 0,0:04:21.59,0:04:22.72,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:23.80,0:04:25.97,Default,,0,0,0,,Жақсы! Сосын мен де
Dialogue: 0,0:04:26.05,0:04:29.35,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:29.43,0:04:31.72,Default,,0,0,0,,Көптеген адамдар
Dialogue: 0,0:04:31.81,0:04:33.77,Default,,0,0,0,,Ол мені көруге келеді.
Dialogue: 0,0:04:34.60,0:04:36.23,Default,,0,0,0,,Мен қобалжыдым...
Dialogue: 0,0:04:36.31,0:04:38.73,Default,,0,0,0,,Жарқыл көп және бұл аздап қорқынышты
Dialogue: 0,0:04:40.02,0:04:41.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:42.32,0:04:43.19,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:04:44.53,0:04:46.49,Default,,0,0,0,,Маған ұнағаны...
Dialogue: 0,0:04:47.28,0:04:48.70,Default,,0,0,0,,Өткізілген уақыт
Dialogue: 0,0:04:51.79,0:04:53.96,Default,,0,0,0,,Бұл қате болған жоқ!
Dialogue: 0,0:04:56.87,0:04:59.17,Default,,0,0,0,,Рахмет 753♡
Dialogue: 0,0:05:00.09,0:05:02.76,Default,,0,0,0,,Менен сұрағаныңыз үшін мен оны түсіндім.
Dialogue: 0,0:05:03.34,0:05:04.97,Default,,0,0,0,,Сізге Лилиэль ұнай ма?
Dialogue: 0,0:05:05.05,0:05:07.51,Default,,0,0,0,,Косплей - бұл мақсатқа жету құралы, солай емес пе?
Dialogue: 0,0:05:08.43,0:05:10.56,Default,,0,0,0,,Енді мен былай жауап берер едім
Dialogue: 0,0:05:10.64,0:05:14.14,Default,,0,0,0,,Косплей мен үшін құрал болуы мүмкін
Dialogue: 0,0:05:14.23,0:05:16.81,Default,,0,0,0,,Бұл таза махаббат болмауы мүмкін
Dialogue: 0,0:05:17.60,0:05:19.98,Default,,0,0,0,,Бірақ бұл жақсы.
Dialogue: 0,0:05:20.73,0:05:23.74,Default,,0,0,0,,Косплей маған тентек киімдерді ұнататындықтан ғана.
Dialogue: 0,0:05:23.82,0:05:25.82,Default,,0,0,0,,Отаку болған маған
Dialogue: 0,0:05:25.90,0:05:29.07,Default,,0,0,0,,Ұнағанымды жасырып, жасырын өмір сүрген маған.
Dialogue: 0,0:05:29.16,0:05:31.28,Default,,0,0,0,,Ол маған баспана берді.
Dialogue: 0,0:05:31.95,0:05:35.54,Default,,0,0,0,,Ол маған сол күйінде қалуға батылдық берді.
Dialogue: 0,0:05:36.33,0:05:41.04,Default,,0,0,0,,Косплей - бұл өзімнен басқа біреуге айналу.
Dialogue: 0,0:05:42.09,0:05:46.88,Default,,0,0,0,,Бұл маған мен болуға мүмкіндік беретін сиқырлы сауыт пен қару.
Dialogue: 0,0:05:47.51,0:05:50.47,Default,,0,0,0,,Меніңше, аналогия сәл отаку-иш болды.
Dialogue: 0,0:05:51.18,0:05:55.43,Default,,0,0,0,,Бұл менің жауабым, 753 мырза♡
Dialogue: 0,0:05:56.56,0:05:58.06,Default,,0,0,0,,Жаңадан келген, тек құмар
Dialogue: 0,0:05:58.14,0:06:00.06,Default,,0,0,0,,Қанша көп болса, сонша бар.
Dialogue: 0,0:06:00.15,0:06:02.48,Default,,0,0,0,,Мен сені төмен бағаладым, Лилиэль.
Dialogue: 0,0:06:03.36,0:06:05.40,Default,,0,0,0,,Сіз шынайысыз
Dialogue: 0,0:06:06.11,0:06:09.28,Default,,0,0,0,,Бірақ бір қызығы, мені қуып кете ме деп қорықпаймын.
Dialogue: 0,0:06:09.36,0:06:11.87,Default,,0,0,0,,Алғашқы сезімдер есіме түскендіктен болар.
Dialogue: 0,0:06:12.78,0:06:15.45,Default,,0,0,0,,Жоқ, мен өзімді бірінші рет осылай жайлы сезініп отырмын.
Dialogue: 0,0:06:17.04,0:06:19.08,Default,,0,0,0,,Қандай жұмбақ косплейер.
Dialogue: 0,0:06:22.34,0:06:24.71,Default,,0,0,0,,Маураның қасында болған қызық болды.
Dialogue: 0,0:06:24.80,0:06:26.34,Default,,0,0,0,,Ыстық болды
Dialogue: 0,0:06:26.42,0:06:27.72,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:29.01,0:06:32.18,Default,,0,0,0,,Жаныңда жақсы сезіледі, Лилиэль.
Dialogue: 0,0:06:32.68,0:06:34.60,Default,,0,0,0,,Біз бір-бірімізбен біргеміз, сондықтан біз бірге жарқыра аламыз.
Dialogue: 0,0:06:35.93,0:06:38.43,Default,,0,0,0,,Ондай бәсекелестер бар.
Dialogue: 0,0:06:38.52,0:06:41.98,Default,,0,0,0,,Иә? Енді мен ол қызды қарсыласым деймін...
Dialogue: 0,0:06:42.56,0:06:44.77,Default,,0,0,0,,А... жақсы, жарайды.
Dialogue: 0,0:06:46.98,0:06:47.82,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:06:47.90,0:06:49.90,Default,,0,0,0,,Жақында болатын нәрсе
Dialogue: 0,0:06:47.90,0:06:49.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:49.90,0:06:51.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:51.61,0:06:53.12,Default,,0,0,0,,Аспандағы төрт патшаның екеуі бар ма?
Dialogue: 0,0:06:53.20,0:06:54.99,Default,,0,0,0,,Жоқ, Маюра-сама қайтып кетті.
Dialogue: 0,0:06:55.08,0:06:57.20,Default,,0,0,0,,Иә! 753♡ жанындағы мына қорап ше?
Dialogue: 0,0:06:57.29,0:06:58.70,Default,,0,0,0,,Мен танымайтын бала екен.
Dialogue: 0,0:06:58.79,0:07:00.50,Default,,0,0,0,,Керемет жаңадан келген адам пайда болды!
Dialogue: 0,0:07:00.58,0:07:01.75,Default,,0,0,0,,Ол қандай бала? Не болып жатыр?
Dialogue: 0,0:07:01.83,0:07:03.54,Default,,0,0,0,,Жоқ, білмеймін, бірақ бәрібір...
Dialogue: 0,0:07:05.96,0:07:08.01,Default,,0,0,0,,Лилиэль өте сүйкімді!
Dialogue: 0,0:07:08.09,0:07:12.09,Default,,0,0,0,,(Тасбақалар қуанады)
Dialogue: 0,0:07:18.39,0:07:19.23,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:23.27,0:07:25.06,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:25.15,0:07:30.15,Default,,0,0,0,,(Тасбақалар қуанады)
Dialogue: 0,0:07:31.15,0:07:33.07,Default,,0,0,0,,Бұл таңқаларлық емес пе? Аға
Dialogue: 0,0:07:33.16,0:07:35.78,Default,,0,0,0,,Комикет болмаса да, бұл толқу
Dialogue: 0,0:07:35.87,0:07:38.08,Default,,0,0,0,,Сізге, менің жұмыс берушім, суретке түсу керек пе?
Dialogue: 0,0:07:38.16,0:07:40.54,Default,,0,0,0,,Өтетін жерді суретке түсіру де менің жұмысымның бір бөлігі.
Dialogue: 0,0:07:41.37,0:07:42.87,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:07:42.96,0:07:44.58,Default,,0,0,0,,Адамдардың санына қарамастан
Dialogue: 0,0:07:44.67,0:07:47.46,Default,,0,0,0,,753♡ Екі Маюра-сама дұрыс жарысып жатқанда
Dialogue: 0,0:07:47.55,0:07:50.09,Default,,0,0,0,,Фотографтың ынта-ықыласы өзгермеген сияқты...
Dialogue: 0,0:07:50.17,0:07:51.88,Default,,0,0,0,,Мен Лилиелді шуылдатамын!
Dialogue: 0,0:07:51.97,0:07:53.18,Default,,0,0,0,,Мен оны шуылдатамын!
Dialogue: 0,0:07:54.26,0:07:57.64,Default,,0,0,0,,Лилиэль келесі төрт Аспан Патшасына үміткер.
Dialogue: 0,0:08:00.77,0:08:03.23,Default,,0,0,0,,Мен бұл уақыттың мәңгілік жалғасуын қалаймын.
Dialogue: 0,0:08:05.06,0:08:05.94,Default,,0,0,0,,Бұл Миками растағанының белгісі
Dialogue: 0,0:08:07.11,0:08:09.23,Default,,0,0,0,,Мен кәсіпқой боламын.
Dialogue: 0,0:08:10.53,0:08:12.65,Default,,0,0,0,,Бұл тамаша оқиға болды
Dialogue: 0,0:08:12.74,0:08:16.74,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:22.75,0:08:24.54,Default,,0,0,0,,-７５３♡！ -７５３♡！
Dialogue: 0,0:08:24.62,0:08:25.88,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:08:30.59,0:08:32.13,Default,,0,0,0,,-(753♡) Кешіріңіз... -(Тыйым) 753♡
Dialogue: 0,0:08:32.22,0:08:33.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.22,0:08:34.59,Default,,0,0,0,,753♡ жаңа ғана айтты
Dialogue: 0,0:08:34.68,0:08:37.51,Default,,0,0,0,,Сіз кәсіпқой ретінде дисквалификацияланғаныңызды айттыңыз.
Dialogue: 0,0:08:38.05,0:08:38.97,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:39.06,0:08:43.48,Default,,0,0,0,,Мен сіздермен жұмыс істегім келіп, визиткамды бердім.
Dialogue: 0,0:08:43.56,0:08:45.39,Default,,0,0,0,,Бұл қазір сенсің
Dialogue: 0,0:08:46.15,0:08:47.44,Default,,0,0,0,,753♡
Dialogue: 0,0:08:52.74,0:08:53.86,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:54.70,0:08:56.49,Default,,0,0,0,,Жұмысқа оралу
Dialogue: 0,0:08:57.03,0:09:00.58,Default,,0,0,0,,Жоқ, бұл жақсы жұмыс болды.
Dialogue: 0,0:09:02.58,0:09:04.46,Default,,0,0,0,,Косплей ағыны 55
Dialogue: 0,0:09:04.54,0:09:05.92,Default,,0,0,0,,Жиналыс жақын арада жабылады
Dialogue: 0,0:09:06.54,0:09:08.46,Default,,0,0,0,,Бүгінгі күн үшін рахмет!
Dialogue: 0,0:09:08.54,0:09:10.38,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:09:13.09,0:09:14.34,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:09:14.42,0:09:16.68,Default,,0,0,0,,Сонымен... онда бұл мен үшін~
Dialogue: 0,0:09:16.76,0:09:18.89,Default,,0,0,0,,Иә! Күте тұрыңыз, Лилиэл-чан
Dialogue: 0,0:09:18.97,0:09:20.43,Default,,0,0,0,,Бүгінгі фотоны жіберейін бе?
Dialogue: 0,0:09:20.51,0:09:22.18,Default,,0,0,0,,Визиттік карталар, SNS және т.б.
Dialogue: 0,0:09:22.27,0:09:24.23,Default,,0,0,0,,Менің көзім ісіп, макияжым түсіп жатыр.
Dialogue: 0,0:09:24.31,0:09:26.94,Default,,0,0,0,,Сөйлессең, шынайы болмысың шығып, Лилиел болмайсың!
Dialogue: 0,0:09:27.02,0:09:30.06,Default,,0,0,0,,Ссу... Кешіріңіз!
Dialogue: 0,0:09:30.15,0:09:32.23,Default,,0,0,0,,Ақпарат жоқ па?
Dialogue: 0,0:09:30.15,0:09:32.23,Default,,0,0,0,,Ештеңе айтпай тағы кетіп қалдың, аға.
Dialogue: 0,0:09:32.23,0:09:32.32,Default,,0,0,0,,Ештеңе айтпай тағы кетіп қалдың, аға.
Dialogue: 0,0:09:32.32,0:09:33.61,Default,,0,0,0,,Ештеңе айтпай тағы кетіп қалдың, аға.
Dialogue: 0,0:09:32.32,0:09:33.61,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:09:33.61,0:09:33.69,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:09:33.69,0:09:34.65,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:09:33.69,0:09:34.65,Default,,0,0,0,,Золушка?
Dialogue: 0,0:09:34.65,0:09:35.70,Default,,0,0,0,,Золушка?
Dialogue: 0,0:09:35.78,0:09:37.03,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:09:37.11,0:09:41.41,Default,,0,0,0,,Золушкадан айырмашылығы сенің кім екенің маңызды емес.
Dialogue: 0,0:09:41.49,0:09:46.33,Default,,0,0,0,,Әлгі бала шыны тәпішкенің орнына тек жақсы фотосуреттерді қалдырады.
Dialogue: 0,0:09:46.41,0:09:48.71,Default,,0,0,0,,Үлкен аға керемет, солай емес пе?
Dialogue: 0,0:09:48.79,0:09:50.25,Default,,0,0,0,,Әдеттегідей, солай емес пе?
Dialogue: 0,0:09:53.88,0:09:54.71,Default,,0,0,0,,Ах
Dialogue: 0,0:09:54.80,0:09:57.05,Default,,0,0,0,,Уа... Жақсы жұмыс!
Dialogue: 0,0:09:57.13,0:09:58.93,Default,,0,0,0,,- Сенпай! -(Окумура) Мен керемет фотосуреттер түсіре алдым...
Dialogue: 0,0:09:59.01,0:10:00.34,Default,,0,0,0,,Уг! Ууг!
Dialogue: 0,0:10:00.43,0:10:04.10,Default,,0,0,0,,Ри… Лилия…
Dialogue: 0,0:10:04.18,0:10:06.31,Default,,0,0,0,,Иә! кешіріңіз
Dialogue: 0,0:10:06.39,0:10:08.02,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:10:08.10,0:10:10.44,Default,,0,0,0,,Бірақ бәрі жақсы аяқталды.
Dialogue: 0,0:10:10.52,0:10:13.44,Default,,0,0,0,,Ағамның түрін көргенде, көңілім жеңілдеп қалды.
Dialogue: 0,0:10:14.03,0:10:15.94,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:10:16.99,0:10:20.28,Default,,0,0,0,,Кешіріңіз, у...
Dialogue: 0,0:10:20.36,0:10:21.82,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:23.08,0:10:24.62,Default,,0,0,0,,(Лилитаның айқайы)
Dialogue: 0,0:10:24.70,0:10:27.25,Default,,0,0,0,,Қанша қиын болса да, жарайды.
Dialogue: 0,0:10:27.83,0:10:28.66,Default,,0,0,0,,(иықта қолдың дыбысы)
Dialogue: 0,0:10:28.75,0:10:29.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:29.67,0:10:31.42,Default,,0,0,0,,Кез келген манга
Dialogue: 0,0:10:31.50,0:10:34.80,Default,,0,0,0,,Басты кейіпкер – ең қиын жағдайдан шыққан адам.
Dialogue: 0,0:10:34.88,0:10:38.88,Default,,0,0,0,,Сөз жоқ, бүгін сенің әңгімең болды.
Dialogue: 0,0:10:40.47,0:10:42.76,Default,,0,0,0,,Керемет болды, Лилита
Dialogue: 0,0:10:43.60,0:10:45.31,Default,,0,0,0,,Сенпай…
Dialogue: 0,0:10:46.39,0:10:47.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:47.81,0:10:51.81,Default,,0,0,0,,(Лилитаның айқайы)
Dialogue: 0,0:10:52.56,0:10:53.06,Default,,0,0,0,,Эдвайзердің жұмысы осы жерде аяқталады.
Dialogue: 0,0:10:53.06,0:10:55.07,Default,,0,0,0,,Эдвайзердің жұмысы осы жерде аяқталады.
Dialogue: 0,0:10:53.06,0:10:55.07,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:10:55.07,0:10:55.94,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:10:56.03,0:10:58.57,Default,,0,0,0,,Косплей ойнағаныма біраз болды.
Dialogue: 0,0:11:04.03,0:11:04.87,Default,,0,0,0,,Мұндай нәрсе жоқ…!
Dialogue: 0,0:11:04.95,0:11:07.20,Default,,0,0,0,,Ах... Эли
Dialogue: 0,0:11:07.95,0:11:09.16,Default,,0,0,0,,Сіз... келдіңіз бе?
Dialogue: 0,0:11:09.25,0:11:10.54,Default,,0,0,0,,Мұндай нәрсе жоқ…!
Dialogue: 0,0:11:11.62,0:11:14.54,Default,,0,0,0,,Гухоаа!
Dialogue: 0,0:11:16.59,0:11:17.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:17.92,0:11:22.09,Default,,0,0,0,,Рефлексті төмен қарауыл әдеті өзгерген жоқ.
Dialogue: 0,0:11:22.18,0:11:24.72,Default,,0,0,0,,Ортаңғы сызықша тым көп алдау емес пе?
Dialogue: 0,0:11:24.80,0:11:27.43,Default,,0,0,0,,Ештеңе айтпай неге келмей қалдың, ақымақ!
Dialogue: 0,0:11:27.52,0:11:30.18,Default,,0,0,0,,Шығаратын болсаң, неге айтпадың!
Dialogue: 0,0:11:30.27,0:11:32.90,Default,,0,0,0,,Келетін болсаң, неге айтпадың!
Dialogue: 0,0:11:32.98,0:11:34.48,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:11:34.56,0:11:36.61,Default,,0,0,0,,Мен не айтарымды білмеймін.
Dialogue: 0,0:11:36.69,0:11:37.86,Default,,0,0,0,,Идиот!
Dialogue: 0,0:11:37.94,0:11:41.11,Default,,0,0,0,,Бәрін бірден лақтырып тастаудың қажеті жоқ, ақымақ!
Dialogue: 0,0:11:41.20,0:11:44.41,Default,,0,0,0,,«Ақымақ» көп емес пе? Мен телефонмен сөйлескен кезде сен мейірімді едің.
Dialogue: 0,0:11:46.16,0:11:48.58,Default,,0,0,0,,Косплейді тастасаңыз да, біз бәрібір доспыз, солай ма?
Dialogue: 0,0:11:49.29,0:11:50.87,Default,,0,0,0,,Косплейді тастасам да.
Dialogue: 0,0:11:50.96,0:11:53.58,Default,,0,0,0,,Косплей сізге берген нәрсе ешқашан жоғалмайды!
Dialogue: 0,0:11:54.42,0:11:57.21,Default,,0,0,0,,Тәжірибе, сүйкімділік және жақын достар
Dialogue: 0,0:11:57.71,0:12:00.13,Default,,0,0,0,,Мен Растаротте емеспін
Dialogue: 0,0:12:00.21,0:12:02.55,Default,,0,0,0,,Мен сені сүйемін Майури!
Dialogue: 0,0:12:03.72,0:12:07.01,Default,,0,0,0,,Косплей сенің бәрің болған шығар, бірақ
Dialogue: 0,0:12:07.85,0:12:10.85,Default,,0,0,0,,Қолыңдағыны тастама!
Dialogue: 0,0:12:12.02,0:12:13.27,Default,,0,0,0,,Эли…
Dialogue: 0,0:12:13.35,0:12:15.44,Default,,0,0,0,,Кешіріңіз... Кешіріңіз
Dialogue: 0,0:12:15.94,0:12:17.94,Default,,0,0,0,,Кешірім сұрама...
Dialogue: 0,0:12:18.02,0:12:19.90,Default,,0,0,0,,Сонымен... рахмет?
Dialogue: 0,0:12:19.98,0:12:20.99,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:21.57,0:12:23.74,Default,,0,0,0,,Ештеңе айтудың қажеті жоқ
Dialogue: 0,0:12:26.20,0:12:27.37,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:12:28.33,0:12:29.45,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:12:31.16,0:12:32.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:34.92,0:12:36.25,Default,,0,0,0,,Ал... дәл қазір...
Dialogue: 0,0:12:36.33,0:12:39.30,Default,,0,0,0,,Уау! Мен оны жақыннан көргеніме қуаныштымын!
Dialogue: 0,0:12:39.38,0:12:41.59,Default,,0,0,0,,Икора-чан Керемет қайталану мүмкіндігі! Гявайи!
Dialogue: 0,0:12:42.17,0:12:43.47,Default,,0,0,0,,Ой, мынау кесте ме?
Dialogue: 0,0:12:43.47,0:12:44.55,Default,,0,0,0,,Ой, мынау кесте ме?
Dialogue: 0,0:12:43.47,0:12:44.55,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:12:44.63,0:12:47.64,Default,,0,0,0,,Жақыннан қарасаң өте сүйкімді!
Dialogue: 0,0:12:44.63,0:12:47.64,Default,,0,0,0,,Бұл мен бұрын Юзаваяда көрмеген мата, оның ішінде аздап жылтырлығы бар.
Dialogue: 0,0:12:47.64,0:12:47.72,Default,,0,0,0,,Бұл мен бұрын Юзаваяда көрмеген мата, оның ішінде аздап жылтырлығы бар.
Dialogue: 0,0:12:47.72,0:12:49.01,Default,,0,0,0,,Бұл мен Юзаваяда бұрын-соңды көрмеген мата, оның ішінде кішкене жылтырлығы бар.
Dialogue: 0,0:12:47.72,0:12:49.01,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:49.10,0:12:51.47,Default,,0,0,0,,Неліктен Chaos пішінін таңдадыңыз?
Dialogue: 0,0:12:51.56,0:12:53.06,Default,,0,0,0,,Маған да ұнайды!
Dialogue: 0,0:12:53.14,0:12:53.98,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:54.06,0:12:56.60,Default,,0,0,0,,Күшті болғым келгендіктен, өзімді қараңғылыққа жақындағандай сезіндім.
Dialogue: 0,0:12:56.69,0:12:59.02,Default,,0,0,0,,Мен мұны шынымен қауіпті деп ойлап, қобалжыдым.
Dialogue: 0,0:12:59.11,0:13:01.82,Default,,0,0,0,,Сенің осылай қайта оралғаныңа қатты әсер еттім!
Dialogue: 0,0:13:01.90,0:13:03.28,Default,,0,0,0,,Мен толық түсінемін~
Dialogue: 0,0:13:03.36,0:13:05.65,Default,,0,0,0,,Апта сайын бұл өте қауіпті болды, мен қобалжыдым.
Dialogue: 0,0:13:05.74,0:13:07.36,Default,,0,0,0,,Сонымен қатар, сіз күшті болып ораласыз.
Dialogue: 0,0:13:07.45,0:13:09.74,Default,,0,0,0,,Бұл одан да әсерлі.
Dialogue: 0,0:13:07.45,0:13:09.74,Default,,0,0,0,,Қарғыс атсын, келісемін!
Dialogue: 0,0:13:09.83,0:13:11.33,Default,,0,0,0,,Мен түсіндім~
Dialogue: 0,0:13:09.83,0:13:11.33,Default,,0,0,0,,Сіз дәл қазір өте жеккөрінішті көріндіңіз
Dialogue: 0,0:13:11.33,0:13:12.16,Default,,0,0,0,,Сіз дәл қазір өте жеккөрінішті көріндіңіз
Dialogue: 0,0:13:12.24,0:13:13.16,Default,,0,0,0,,Бірақ бізде басқа амал жоқ.
Dialogue: 0,0:13:13.25,0:13:14.58,Default,,0,0,0,,Қандай отаку!
Dialogue: 0,0:13:14.66,0:13:16.25,Default,,0,0,0,,Ха, жақсы.
Dialogue: 0,0:13:16.33,0:13:18.58,Default,,0,0,0,,Мен де Икора-чанды суретке түсіргім келді.
Dialogue: 0,0:13:18.67,0:13:21.59,Default,,0,0,0,,Мен де Лилиелді суретке түсіргім келді!
Dialogue: 0,0:13:21.67,0:13:22.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.92,0:13:24.01,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:13:24.09,0:13:27.22,Default,,0,0,0,,Бұл жақсы ма? Мен сізге фото жіберемін, сондықтан байланыс ақпаратыңызды айтыңыз.
Dialogue: 0,0:13:27.30,0:13:29.68,Default,,0,0,0,,бұл... Иә! Ах, мен сондай бақыттымын!
Dialogue: 0,0:13:29.76,0:13:32.68,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:13:32.77,0:13:34.73,Default,,0,0,0,,Мен барлық косплейлерді жақсы көремін
Dialogue: 0,0:13:34.81,0:13:36.56,Default,,0,0,0,,Біз бәріміз доспыз.
Dialogue: 0,0:13:36.64,0:13:38.44,Default,,0,0,0,,Мен бұл қызбен жақсы араласамын деп ойлаймын.
Dialogue: 0,0:13:38.52,0:13:39.40,Default,,0,0,0,,Эй
Dialogue: 0,0:13:39.48,0:13:41.98,Default,,0,0,0,,Лилиел! Кіре берісте кездесе аламыз ба?
Dialogue: 0,0:13:42.07,0:13:43.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:43.61,0:13:46.03,Default,,0,0,0,,Кешіріңіз, мен бірден киімімді ауыстырамын.
Dialogue: 0,0:13:46.11,0:13:47.82,Default,,0,0,0,,Какака…
Dialogue: 0,0:13:47.91,0:13:50.41,Default,,0,0,0,,Аа... сәлем
Dialogue: 0,0:13:50.49,0:13:55.00,Default,,0,0,0,,Ол... сіздің операторыңыз ба?
Dialogue: 0,0:13:55.08,0:13:55.91,Default,,0,0,0,,Иә
Dialogue: 0,0:13:57.00,0:13:58.37,Default,,0,0,0,,А...?
Dialogue: 0,0:13:58.46,0:14:01.67,Default,,0,0,0,,Бұл дұрыс емес! Сіз әлі жетілмегенсіз 753♡!
Dialogue: 0,0:14:01.75,0:14:04.30,Default,,0,0,0,,Қазір! мен! Не айту керек!
Dialogue: 0,0:14:05.13,0:14:07.13,Default,,0,0,0,,Сізді косплей қызықтырмай ма?
Dialogue: 0,0:14:07.22,0:14:08.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:08.13,0:14:10.09,Default,,0,0,0,,Сіз қабаттардың санын көбейте аласыз!
Dialogue: 0,0:14:10.18,0:14:12.18,Default,,0,0,0,,Неліктен Кай-сама мен Фую-чан бірге Досупури жасамайды?
Dialogue: 0,0:14:12.18,0:14:13.01,Default,,0,0,0,,Неліктен Кай-сама мен Фую-чан бірге Досупури жасамайды?
Dialogue: 0,0:14:12.18,0:14:13.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:13.10,0:14:16.64,Default,,0,0,0,,Сондықтан... Байланыс ақпаратын ауыстырыңыз...
Dialogue: 0,0:14:16.73,0:14:18.48,Default,,0,0,0,,А... неге айырбастамасқа?
Dialogue: 0,0:14:19.10,0:14:20.73,Default,,0,0,0,,Не? Иә... иә
Dialogue: 0,0:14:20.81,0:14:22.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:23.65,0:14:26.49,Default,,0,0,0,,Ыстық болды, солай емес пе? Сізде ішетін нәрсе бар ма?
Dialogue: 0,0:14:26.57,0:14:28.15,Default,,0,0,0,,Иә, мен әкелдім.
Dialogue: 0,0:14:30.61,0:14:31.95,Default,,0,0,0,,Мен су бөтелкесімін.
Dialogue: 0,0:14:32.03,0:14:33.37,Default,,0,0,0,,Хоуа~
Dialogue: 0,0:14:33.45,0:14:37.58,Default,,0,0,0,,Жарайды, бірақ Лилиэльдің қоршауы керемет болды.
Dialogue: 0,0:14:37.66,0:14:39.67,Default,,0,0,0,,Сенің атақты болатыныңа сенімдімін
Dialogue: 0,0:14:39.75,0:14:40.79,Default,,0,0,0,,Өзіңізді қалай сезіндіңіз?
Dialogue: 0,0:14:40.87,0:14:41.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:41.79,0:14:44.55,Default,,0,0,0,,Бұл өте қызық болды!
Dialogue: 0,0:14:44.63,0:14:47.21,Default,,0,0,0,,Мәңгілік қалыңызда қалыңыз.
Dialogue: 0,0:14:47.30,0:14:48.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.97,0:14:51.80,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:51.89,0:14:53.18,Default,,0,0,0,,Не? Өтірік...
Dialogue: 0,0:14:54.72,0:14:55.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:57.98,0:14:59.60,Default,,0,0,0,,Мистер 753♡…
Dialogue: 0,0:15:03.15,0:15:07.78,Default,,0,0,0,,Жұмыс кестесіне байланысты күту залын пайдалануға болатын уақытым өтті.
Dialogue: 0,0:15:07.86,0:15:12.11,Default,,0,0,0,,Кешіріңіз, мен басқалар сияқты киім ауыстыратын бөлмені пайдалана аламын ба?
Dialogue: 0,0:15:12.78,0:15:16.58,Default,,0,0,0,,Менің таңдауым жоқ. Кешігіп келгеніме мен кінәлімін.
Dialogue: 0,0:15:16.66,0:15:18.66,Default,,0,0,0,,(сыбырлаған дауыс)
Dialogue: 0,0:15:23.25,0:15:26.84,Default,,0,0,0,,Маған барлығы ұнайды, бірақ
Dialogue: 0,0:15:27.76,0:15:28.80,Default,,0,0,0,,Әркім әртүрлі
Dialogue: 0,0:15:37.43,0:15:39.48,Default,,0,0,0,,Киіміңді тез ауыстырып, шық...
Dialogue: 0,0:15:41.10,0:15:41.94,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:42.02,0:15:43.31,Default,,0,0,0,,Гррр…
Dialogue: 0,0:15:43.40,0:15:47.90,Default,,0,0,0,,Маған костюм берілгендіктен, қолым найзағайда...
Dialogue: 0,0:15:48.53,0:15:50.11,Default,,0,0,0,,Сайтоға қоңырау шалуым керек пе?
Dialogue: 0,0:15:50.19,0:15:53.78,Default,,0,0,0,,Бірақ бұл жерде мен өзімді көрсету үшін біреуден киімімді шешуін сұраймын...
Dialogue: 0,0:15:54.87,0:15:56.37,Default,,0,0,0,,Дүрбелеңге түспеңіз
Dialogue: 0,0:15:56.45,0:15:59.66,Default,,0,0,0,,Барлығының күлетініне сенімдімін...
Dialogue: 0,0:16:00.54,0:16:03.75,Default,,0,0,0,,(мысқылдап күлу)
Dialogue: 0,0:16:03.83,0:16:05.08,Default,,0,0,0,,Ум...
Dialogue: 0,0:16:05.17,0:16:06.17,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:10.01,0:16:11.26,Default,,0,0,0,,Мен сізге көмектесе аламын ба?
Dialogue: 0,0:16:11.34,0:16:13.09,Default,,0,0,0,,Қандай керемет киім!
Dialogue: 0,0:16:13.18,0:16:15.84,Default,,0,0,0,,753♡-ден ести алатын бақытым бар!
Dialogue: 0,0:16:15.93,0:16:18.68,Default,,0,0,0,,Шынымен де бүгін әдемі едің.
Dialogue: 0,0:16:19.52,0:16:21.89,Default,,0,0,0,,Икора өте сүйкімді болды!
Dialogue: 0,0:16:21.98,0:16:23.10,Default,,0,0,0,,Осы айдағы «Косметика»
Dialogue: 0,0:16:23.19,0:16:24.40,Default,,0,0,0,,Бұл 753♡ болды, солай ма?
Dialogue: 0,0:16:24.48,0:16:25.90,Default,,0,0,0,,Мұқаба 753♡ болды
Dialogue: 0,0:16:25.98,0:16:27.27,Default,,0,0,0,,Мен оны тез сатып алдым!
Dialogue: 0,0:16:27.36,0:16:28.48,Default,,0,0,0,,Мен де сатып алдым!
Dialogue: 0,0:16:28.57,0:16:30.07,Default,,0,0,0,,- (Косплейер) Мен де! -(Косплейер) Мен де!
Dialogue: 0,0:16:30.15,0:16:31.49,Default,,0,0,0,,Мен қатты қолдаймын!
Dialogue: 0,0:16:32.86,0:16:36.45,Default,,0,0,0,,Мені бәрі жек көреді деп ойладым.
Dialogue: 0,0:16:37.66,0:16:39.70,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:16:39.79,0:16:41.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.25,0:16:44.37,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:16:45.58,0:16:49.67,Default,,0,0,0,,Экранның артындағы пішінсіз сөздерді қабылдаймын...
Dialogue: 0,0:16:49.75,0:16:52.67,Default,,0,0,0,,3D форматында сізде жағымсыз нәрсе болды ма?
Dialogue: 0,0:16:52.76,0:16:54.59,Default,,0,0,0,,Бұл ешқашан болмағанымен...
Dialogue: 0,0:16:54.68,0:16:57.30,Default,,0,0,0,,Барлығы әрқашан мейірімді болды...
Dialogue: 0,0:16:57.39,0:16:58.89,Default,,0,0,0,,Не? 753♡чан?
Dialogue: 0,0:17:00.18,0:17:02.35,Default,,0,0,0,,Мен өтірікшімін
Dialogue: 0,0:17:02.43,0:17:04.73,Default,,0,0,0,,Мен барлық косплейлерді бірдей жақсы көремін.
Dialogue: 0,0:17:04.81,0:17:05.94,Default,,0,0,0,,Мен мұны көптен бері айтып жүрмін
Dialogue: 0,0:17:06.94,0:17:10.69,Default,,0,0,0,,Өзіңді сүйген жалғыз сен емес едің.
Dialogue: 0,0:17:11.40,0:17:15.15,Default,,0,0,0,,Сондықтан мен өзімді жақсы көрмедім
Dialogue: 0,0:17:15.24,0:17:17.57,Default,,0,0,0,,Барлығы жау сияқты көрінді...
Dialogue: 0,0:17:19.70,0:17:21.62,Default,,0,0,0,,Сол жақтағы кішкентайлардың бірі қателесіп қолы тисе, қауіпті болар еді ғой, иә?
Dialogue: 0,0:17:21.70,0:17:24.16,Default,,0,0,0,,Кешіріңіз 753♡…
Dialogue: 0,0:17:24.25,0:17:27.08,Default,,0,0,0,,Кешіріңіз, жұмыс біткен соң жеңілдеп қалдым.
Dialogue: 0,0:17:27.17,0:17:29.33,Default,,0,0,0,,Жарайды, кешіріңіз, кешіріңіз
Dialogue: 0,0:17:29.42,0:17:30.67,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:17:30.75,0:17:32.34,Default,,0,0,0,,Шынымен бе? Сенімен бәрі жақсы ма?
Dialogue: 0,0:17:32.42,0:17:34.67,Default,,0,0,0,,Менің ойымша, кәсіпқой болудың қысымы қиын.
Dialogue: 0,0:17:34.76,0:17:35.88,Default,,0,0,0,,Мен түсіндім~
Dialogue: 0,0:17:35.97,0:17:37.47,Default,,0,0,0,,Сіз кәсіби емессіз.
Dialogue: 0,0:17:37.55,0:17:39.34,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:17:40.22,0:17:44.39,Default,,0,0,0,,Мен барлық косплейлерді жақсы көремін
Dialogue: 0,0:17:46.35,0:17:47.94,Default,,0,0,0,,Лилиел
Dialogue: 0,0:17:48.02,0:17:48.85,Default,,0,0,0,,753♡!
Dialogue: 0,0:17:51.23,0:17:54.23,Default,,0,0,0,,Жазғы комикстер Міндетті түрде келіңіз
Dialogue: 0,0:17:54.90,0:17:59.16,Default,,0,0,0,,Мен әрқашан жұмыста ең танымал кейіпкермен бірге жүремін.
Dialogue: 0,0:18:00.78,0:18:03.62,Default,,0,0,0,,Иә! Мен Лилильмен барамын
Dialogue: 0,0:18:03.70,0:18:05.29,Default,,0,0,0,,Солай етіңіз.
Dialogue: 0,0:18:05.37,0:18:08.00,Default,,0,0,0,,Барлығы сені суретке түсіремін дейді.
Dialogue: 0,0:18:08.08,0:18:09.54,Default,,0,0,0,,Бұрынғы фото...
Dialogue: 0,0:18:09.63,0:18:10.71,Default,,0,0,0,,50 000 рицу?
Dialogue: 0,0:18:10.79,0:18:12.42,Default,,0,0,0,,Иә? Кешіріңіз, бұл жақсы болмады ма?
Dialogue: 0,0:18:12.50,0:18:15.88,Default,,0,0,0,,Бірақ жоғарыда сіздің көптеген суреттеріңіз бар.
Dialogue: 0,0:18:15.96,0:18:16.80,Default,,0,0,0,,Уау! иә!
Dialogue: 0,0:18:16.80,0:18:19.38,Default,,0,0,0,,Уау! иә! Мұндай көлемдегі қорапта мұндай нәрсенің болуы табиғи емес.
Dialogue: 0,0:18:20.22,0:18:22.81,Default,,0,0,0,,Бәрібір ерте ме, кеш пе атақты боласың.
Dialogue: 0,0:18:22.89,0:18:23.89,Default,,0,0,0,,А...
Dialogue: 0,0:18:24.47,0:18:27.52,Default,,0,0,0,,Бұл қысым бәріміздің басымыздан өтетін нәрсе.
Dialogue: 0,0:18:27.60,0:18:29.14,Default,,0,0,0,,Неліктен көңіл көтеруге болмайды?
Dialogue: 0,0:18:30.27,0:18:31.73,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:18:32.52,0:18:35.32,Default,,0,0,0,,Бір күні сен бүгінгі күлкіңді ұмытсаң
Dialogue: 0,0:18:35.98,0:18:38.65,Default,,0,0,0,,Келесі жолы еске саламын.
Dialogue: 0,0:18:51.58,0:18:52.33,Default,,0,0,0,,(Лилитаның ұйқысы)
Dialogue: 0,0:18:52.33,0:18:54.42,Default,,0,0,0,,(Лилитаның ұйқысы)
Dialogue: 0,0:18:52.33,0:18:54.42,Default,,0,0,0,,Шаршаған шығарсың...
Dialogue: 0,0:18:54.50,0:18:56.26,Default,,0,0,0,,Мен қорапты суретке түсіре алдым.
Dialogue: 0,0:18:56.34,0:18:59.09,Default,,0,0,0,,Мен Сенсей және 753♡ сияқты керемет адамдарды көрдім.
Dialogue: 0,0:18:59.17,0:19:01.22,Default,,0,0,0,,Бұл жақсы тәжірибе болды... Ах.
Dialogue: 0,0:19:03.26,0:19:04.68,Default,,0,0,0,,Аха…
Dialogue: 0,0:19:04.76,0:19:08.73,Default,,0,0,0,,А, адамдар бізді сүйкімді жұп деп ойлайды.
Dialogue: 0,0:19:08.81,0:19:11.10,Default,,0,0,0,,Лилиэль болса, мен шошып кетер едім.
Dialogue: 0,0:19:11.19,0:19:13.15,Default,,0,0,0,,Лилита жақсы.
Dialogue: 0,0:19:19.11,0:19:20.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:20.99,0:19:25.41,Default,,0,0,0,,А... қазір қайдасың? Мен сапарды сағындым...
Dialogue: 0,0:19:25.49,0:19:26.54,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:19:26.62,0:19:27.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:27.95,0:19:30.96,Default,,0,0,0,,Мен бақылап отырамын, сондықтан сіз ұзағырақ ұйықтай аласыз.
Dialogue: 0,0:19:31.04,0:19:31.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:35.67,0:19:37.71,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:19:39.17,0:19:40.63,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:19:40.72,0:19:45.39,Default,,0,0,0,,Менің ағам қасымда болса, мен өзімді қауіпсіз сезінемін...
Dialogue: 0,0:19:46.43,0:19:48.72,Default,,0,0,0,,Уа, мұнда күн жылы.
Dialogue: 0,0:19:48.81,0:19:50.14,Default,,0,0,0,,Иә
Dialogue: 0,0:19:51.19,0:19:53.56,Default,,0,0,0,,Иә? Олар емес пе?
Dialogue: 0,0:19:53.65,0:19:55.90,Default,,0,0,0,,-Ух... Иә? -аға
Dialogue: 0,0:19:56.73,0:20:00.28,Default,,0,0,0,,Өйткені, мен ағамды жақсы көремін.
Dialogue: 0,0:20:00.36,0:20:03.74,Default,,0,0,0,,Менің қасымда бола бересің бе?
Dialogue: 0,0:20:03.82,0:20:06.16,Default,,0,0,0,,Кококококо... Міне, солай!
Dialogue: 0,0:20:06.78,0:20:09.54,Default,,0,0,0,,Кококококо... Мойындау!
Dialogue: 0,0:20:09.62,0:20:12.16,Default,,0,0,0,,О... Окумура! Окумура!
Dialogue: 0,0:20:12.79,0:20:16.71,Default,,0,0,0,,А... А, мен уәде беремін.
Dialogue: 0,0:20:18.55,0:20:19.96,Default,,0,0,0,,Иә? мұғалім?
Dialogue: 0,0:20:20.76,0:20:23.43,Default,,0,0,0,,Ах! А~ жоқ...
Dialogue: 0,0:20:23.51,0:20:26.51,Default,,0,0,0,,Кешіріңіз... Сұрайын деген жоқпын...
Dialogue: 0,0:20:26.60,0:20:28.31,Default,,0,0,0,,Сендер-ай, шіркін!
Dialogue: 0,0:20:28.39,0:20:31.10,Default,,0,0,0,,Балалар, сендер сондай жақын қарым-қатынаста болдыңдар.
Dialogue: 0,0:20:31.18,0:20:34.19,Default,,0,0,0,,Иә! Лилиэль бүгін барын салды.
Dialogue: 0,0:20:34.27,0:20:36.61,Default,,0,0,0,,Косплей арқылы Лилиельге деген сүйіспеншілігімді білдіру
Dialogue: 0,0:20:36.69,0:20:39.32,Default,,0,0,0,,Отаку ретінде мен сізді басқаларға жеткізе алғаныңыз үшін құрметтеймін!
Dialogue: 0,0:20:40.11,0:20:43.32,Default,,0,0,0,,Мұның бәрі сенпайымның қасымда болғанының арқасы!
Dialogue: 0,0:20:43.40,0:20:45.99,Default,,0,0,0,,Менде үлкен сынып бар болғандықтан, мен косплейде қолымнан келгеннің бәрін жасай аламын.
Dialogue: 0,0:20:46.07,0:20:47.95,Default,,0,0,0,,Хмм?
Dialogue: 0,0:20:48.91,0:20:49.95,Default,,0,0,0,,- біз! -(Окумура) Біз!
Dialogue: 0,0:20:50.04,0:20:51.91,Default,,0,0,0,,Олар ең жақсы комбинация!
Dialogue: 0,0:20:52.00,0:20:56.42,Default,,0,0,0,,А... а~ мына жерде бірдеңе дұрыс емес~
Dialogue: 0,0:20:56.50,0:20:59.25,Default,,0,0,0,,Қабат және фотограф ретінде.
Dialogue: 0,0:20:59.34,0:21:01.92,Default,,0,0,0,,Жоқ, бірақ сізде қашықтықты сезінесіз...
Dialogue: 0,0:21:02.01,0:21:04.93,Default,,0,0,0,,Қараңызшы, бұл Лилиэль жақсы көрінеді, солай ма?
Dialogue: 0,0:21:05.01,0:21:07.59,Default,,0,0,0,,Уау, мен өте қуаныштымын! Ағадан күткендей!
Dialogue: 0,0:21:07.68,0:21:10.51,Default,,0,0,0,,Иә, сіз кездесіп жатқан жоқсыз ба? Бұл
Dialogue: 0,0:21:11.89,0:21:13.73,Default,,0,0,0,,Қазіргі балалар...
Dialogue: 0,0:21:15.52,0:21:18.23,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:21:21.27,0:21:23.19,Default,,0,0,0,,Ху~ Коплей...
Dialogue: 0,0:21:23.28,0:21:25.90,Default,,0,0,0,,Қоғамдық теріс пікір болуы мүмкін болса да,
Dialogue: 0,0:21:25.99,0:21:28.20,Default,,0,0,0,,Олар өз жұмыстарына үлкен жауапкершілікпен қарайды.
Dialogue: 0,0:21:28.82,0:21:31.58,Default,,0,0,0,,Менің көзқарасым бойынша, клуб бөлмесі өте қажет.
Dialogue: 0,0:21:31.66,0:21:34.58,Default,,0,0,0,,Мен сізді кеңесшіңіз ретінде қадағалаймын, сондықтан...
Dialogue: 0,0:21:34.66,0:21:35.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:35.87,0:21:39.29,Default,,0,0,0,,Жарайды, мен өз шартым бойынша шешім қабылдай алмаймын.
Dialogue: 0,0:21:39.96,0:21:43.30,Default,,0,0,0,,Белсенділік мазмұны клуб әрекеті ретінде сәйкес келетініне қатысты.
Dialogue: 0,0:21:43.38,0:21:46.30,Default,,0,0,0,,Мұны тамаша студенттік кеңестің төрағасына қалдырайық.
Dialogue: 0,0:21:46.38,0:21:48.05,Default,,0,0,0,,Түсінемін...
Dialogue: 0,0:21:48.14,0:21:50.26,Default,,0,0,0,,Мені көбірек алаңдататын нәрсе
Dialogue: 0,0:21:50.35,0:21:53.72,Default,,0,0,0,,Мен мұны басқа студенттерге айта аламын ба?
Dialogue: 0,0:21:55.85,0:21:56.27,Default,,0,0,0,,Әй, қара!
Dialogue: 0,0:21:56.27,0:21:57.35,Default,,0,0,0,,Әй, қара!
Dialogue: 0,0:21:56.27,0:21:57.35,Default,,0,0,0,,Ханю мырза туралы не ойлайсыз?
Dialogue: 0,0:21:57.35,0:21:57.44,Default,,0,0,0,,Ханю мырза туралы не ойлайсыз?
Dialogue: 0,0:21:57.44,0:21:58.40,Default,,0,0,0,,Доктор Ханью туралы не ойлайсыз?
Dialogue: 0,0:21:57.44,0:21:58.40,Default,,0,0,0,,Шынымен, үлкен кеуделер!
Dialogue: 0,0:21:58.40,0:21:58.48,Default,,0,0,0,,Шынымен, үлкен кеуделер!
Dialogue: 0,0:21:58.48,0:21:59.40,Default,,0,0,0,,Шынымен, үлкен кеуделер!
Dialogue: 0,0:21:58.48,0:21:59.40,Default,,0,0,0,,Бұл бала өзінің жеке басын жасырады, солай ма?
Dialogue: 0,0:21:59.40,0:21:59.48,Default,,0,0,0,,Бұл бала өзінің жеке басын жасырады, солай ма?
Dialogue: 0,0:21:59.48,0:22:01.02,Default,,0,0,0,,Бұл бала өзінің жеке басын жасырады, солай ма?
Dialogue: 0,0:21:59.48,0:22:01.02,Default,,0,0,0,,Мен шалбарды көріп тұрмын~
Dialogue: 0,0:22:01.11,0:22:03.28,Default,,0,0,0,,Бұл туралы әдеттегідей ойласаңыз, көп қиындық тудырмай ма?
Dialogue: 0,0:22:03.28,0:22:04.61,Default,,0,0,0,,Бұл туралы әдеттегідей ойлайтын болсақ, бұл көп қиындық тудырмай ма?
Dialogue: 0,0:22:03.28,0:22:04.61,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:22:07.28,0:22:10.87,Default,,0,0,0,,Мен клуб бөлмесін тексеру нәтижелері бүгін шығады деп естідім...
Dialogue: 0,0:22:10.95,0:22:12.53,Default,,0,0,0,,Лилита!
Dialogue: 0,0:22:12.62,0:22:13.74,Default,,0,0,0,,Микари-чан!
Dialogue: 0,0:22:13.83,0:22:14.91,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:22:15.00,0:22:15.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:15.95,0:22:19.46,Default,,0,0,0,,Біз үлкен қиындыққа тап болдық! Тақтаға қараңдар!
Dialogue: 0,0:22:19.54,0:22:20.63,Default,,0,0,0,,Е...
Dialogue: 0,0:22:21.25,0:22:24.96,Default,,0,0,0,,А... неге?
Dialogue: 0,0:22:26.05,0:22:30.84,Default,,0,0,0,,♪～
Dialogue: 0,0:23:50.09,0:23:55.35,Default,,0,0,0,,～♪
