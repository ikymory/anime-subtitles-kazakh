Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.23,0:01:31.10,Default,,0,0,0,,Сен
Dialogue: 0,0:01:34.62,0:01:37.79,Default,,0,0,0,,«Қыздың анау аппақ денесі
Dialogue: 0,0:01:37.79,0:01:40.76,Default,,0,0,0,,Оның астындағы жұмсақ бұтаның алдында
Dialogue: 0,0:01:40.76,0:01:42.96,Default,,0,0,0,,Мен тізерлеп отырдым».
Dialogue: 0,0:01:45.23,0:01:50.17,Default,,0,0,0,,«Бетімді көмсем, мұрныма көк шөптің иісі келеді.
Dialogue: 0,0:01:50.17,0:01:52.61,Default,,0,0,0,,Мен бұтаға кірдім
Dialogue: 0,0:01:52.61,0:01:55.28,Default,,0,0,0,,Одан ағып жатқан тәтті шырындар
Dialogue: 0,0:01:55.28,0:01:57.28,Default,,0,0,0,,Мен мұның бәрін іштім».
Dialogue: 0,0:02:00.18,0:02:02.18,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:02:02.18,0:02:04.19,Default,,0,0,0,,<Біз әдебиет үйірмеміз>
Dialogue: 0,0:02:04.19,0:02:06.55,Default,,0,0,0,,Тым тікелей сипаттама.
Dialogue: 0,0:02:06.55,0:02:09.09,Default,,0,0,0,,Мичибата сенсидің соңғы стилі қандай?
Dialogue: 0,0:02:09.09,0:02:11.16,Default,,0,0,0,,Менің ойымша, сіз әдебиет пен порнографияны шатастырып жатырсыз.
Dialogue: 0,0:02:11.16,0:02:13.19,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:02:13.19,0:02:16.66,Default,,0,0,0,,Біз есейген сайын жастық пен сексуалдылықты іздеу барысында,
Dialogue: 0,0:02:16.66,0:02:19.67,Default,,0,0,0,,Мені қызықтырады.
Dialogue: 0,0:02:19.67,0:02:22.70,Default,,0,0,0,,<Әдебиет үйірмесінде барлығы бір шығарма оқиды.
Dialogue: 0,0:02:22.70,0:02:25.44,Default,,0,0,0,,Кітап клубы атымен әңгімелесу
Dialogue: 0,0:02:25.44,0:02:27.44,Default,,0,0,0,,Бұл негізгі әрекет＞
Dialogue: 0,0:02:29.01,0:02:31.58,Default,,0,0,0,,Әзірше шәй ішкіңіз келе ме?
Dialogue: 0,0:02:31.58,0:02:35.02,Default,,0,0,0,,Бүгін мен таңқурай жедім. Хмм!
Dialogue: 0,0:02:35.02,0:02:38.82,Default,,0,0,0,,Тәтті және жағымды иіс! (Гонго) Тәтті сорпа
Dialogue: 0,0:02:40.12,0:02:42.96,Default,,0,0,0,,…  ()
Dialogue: 0,0:02:42.96,0:02:46.33,Default,,0,0,0,,Мм. Не? Бұл шулы
Dialogue: 0,0:02:46.33,0:02:49.30,Default,,0,0,0,,Сол караоке жәшігін қолданып көрсеңіз де, олар білмейді.
Dialogue: 0,0:02:49.30,0:02:52.30,Default,,0,0,0,,Шынайы ма? көріңіз? Жоқ. Сіз ақымақ емессіз бе?
Dialogue: 0,0:02:52.30,0:02:57.07,Default,,0,0,0,,()
Dialogue: 0,0:02:57.07,0:02:59.07,Default,,0,0,0,,Мектепте ұятсыз
Dialogue: 0,0:02:59.07,0:03:03.08,Default,,0,0,0,,Мектепте эротикалық әдебиеттерді дауыстап оқыған дұрыс деп ойлаймын.
Dialogue: 0,0:03:03.08,0:03:05.25,Default,,0,0,0,,Ал бұл басқа әңгіме!
Dialogue: 0,0:03:05.25,0:03:07.45,Default,,0,0,0,,өнерге жоғарылатылған
Dialogue: 0,0:03:07.45,0:03:11.12,Default,,0,0,0,,Егер бұл әдеби өрнек ретінде жыныстық қатынас болса, мен оны қабылдаймын.
Dialogue: 0,0:03:11.12,0:03:14.62,Default,,0,0,0,,Нағыз сексуалдылық материалистік және таяз...
Dialogue: 0,0:03:14.62,0:03:17.16,Default,,0,0,0,,Бұл шынымен лас!
Dialogue: 0,0:03:17.16,0:03:19.19,Default,,0,0,0,,Осындай сұмдықтың жамбасынан
Dialogue: 0,0:03:19.19,0:03:22.83,Default,,0,0,0,,Тәтті шырыннан бір тамшы шықпайды.
Dialogue: 0,0:03:22.83,0:03:25.83,Default,,0,0,0,,Олай болса, қандай шырын шығады?
Dialogue: 0,0:03:25.83,0:03:28.60,Default,,0,0,0,,Иә? Бұл... Ах.
Dialogue: 0,0:03:28.60,0:03:31.30,Default,,0,0,0,,Уф...｡ Ах...
Dialogue: 0,0:03:33.41,0:03:36.24,Default,,0,0,0,,Хмм…｡ Кімге…
Dialogue: 0,0:03:36.24,0:03:38.65,Default,,0,0,0,,Хехе, бұл шошқа сорпасы.
Dialogue: 0,0:03:38.65,0:03:42.08,Default,,0,0,0,,Біраз дәмді көрінді. Иә иә.
Dialogue: 0,0:03:42.08,0:03:45.09,Default,,0,0,0,,Бірақ сексуалдық бейнелер тым қарқынды.
Dialogue: 0,0:03:45.09,0:03:47.42,Default,,0,0,0,,Бұл аздап өрескел болады. (Момоко) Иә.
Dialogue: 0,0:03:47.42,0:03:51.43,Default,,0,0,0,,Эротикалық көріністері бар таза әдебиеттер өте көп...
Dialogue: 0,0:03:51.43,0:03:55.00,Default,,0,0,0,,Парфюмерия? Сугавара мырзаның иісі жақсы
Dialogue: 0,0:03:55.00,0:03:59.57,Default,,0,0,0,,Ерекше ештеңе жоқ. Мүмкін шампунь ауыстырғандықтан шығар.
Dialogue: 0,0:03:59.57,0:04:01.64,Default,,0,0,0,,Эй, бұл Нина Сугавара, солай ма?
Dialogue: 0,0:04:01.64,0:04:04.04,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:04:04.04,0:04:08.21,Default,,0,0,0,,Шынымен де, Сугавара мырза неліктен әдебиет үйірмесіне қосылды?
Dialogue: 0,0:04:08.21,0:04:11.48,Default,,0,0,0,,Менің сыныбымдағы ұлдар бұл туралы өсек айтып жүрді.
Dialogue: 0,0:04:11.48,0:04:15.35,Default,,0,0,0,,Тіпті жер сыпыратын кран. Қандай кенеттен...
Dialogue: 0,0:04:15.35,0:04:18.39,Default,,0,0,0,,Мінезі бойынша бұл қызық болуы мүмкін.
Dialogue: 0,0:04:18.39,0:04:21.36,Default,,0,0,0,,Сонезаки-сенпай көп нәрсеге тым таза.
Dialogue: 0,0:04:21.36,0:04:23.99,Default,,0,0,0,,Дәл солай. «Мұндай нәрсе»...
Dialogue: 0,0:04:23.99,0:04:26.89,Default,,0,0,0,,Мен... түсіндім.
Dialogue: 0,0:04:26.89,0:04:29.63,Default,,0,0,0,,Баки! (Момоко) Хонго-сенпай
Dialogue: 0,0:04:29.63,0:04:32.50,Default,,0,0,0,,Ол қазірдің өзінде жұмбақ жазушының аурасын беріп жатыр.
Dialogue: 0,0:04:32.50,0:04:35.50,Default,,0,0,0,,Әй, мен оны кешегі күні баспаға апардым.
Dialogue: 0,0:04:35.50,0:04:39.97,Default,,0,0,0,,Керемет! Мен ерекше емеспін
Dialogue: 0,0:04:39.97,0:04:42.94,Default,,0,0,0,,Тым кішкентай болу да қасиет, мен сенімдімін.
Dialogue: 0,0:04:42.94,0:04:45.61,Default,,0,0,0,,｡ (･)
Dialogue: 0,0:04:45.61,0:04:48.25,Default,,0,0,0,,Эй Изуми-кун, сен не оқып тұрсың?
Dialogue: 0,0:04:48.25,0:04:52.39,Default,,0,0,0,,Е, бұл кесте. (Такеяма) Е, Изуми-кун, сен темір тұлпарсың ба?
Dialogue: 0,0:04:52.39,0:04:55.09,Default,,0,0,0,,Бұл күлкілі! (Момоко) Сен де бүгін танымалсың.
Dialogue: 0,0:04:56.62,0:05:00.09,Default,,0,0,0,,Ах. Хаха.
Dialogue: 0,0:05:00.09,0:05:02.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:02.10,0:05:04.20,Default,,0,0,0,,Иә! Кеттік...Мучин!
Dialogue: 0,0:05:04.20,0:05:06.90,Default,,0,0,0,,Иә! Эй, эй... Эй, Васа~!
Dialogue: 0,0:05:15.08,0:05:18.61,Default,,0,0,0,,Қатты, менің бала кездегі досым сондай жаман, салқын.
Dialogue: 0,0:05:18.61,0:05:20.61,Default,,0,0,0,,Иә! (Момоко) Қыздардың мангасы болса
Dialogue: 0,0:05:20.61,0:05:23.25,Default,,0,0,0,,Екеуі кездесе бастағанша күте алмады.
Dialogue: 0,0:05:23.25,0:05:26.12,Default,,0,0,0,,Тоқта. Мүлдем жоқ.
Dialogue: 0,0:05:26.12,0:05:28.56,Default,,0,0,0,,Егер сіз қателесіп, осындай жағдай орын алса
Dialogue: 0,0:05:28.56,0:05:31.56,Default,,0,0,0,,Біз тағы да зұлмат заманға оралдық.
Dialogue: 0,0:05:31.56,0:05:34.16,Default,,0,0,0,,А... түсіндім. Иә...
Dialogue: 0,0:05:37.13,0:05:40.63,Default,,0,0,0,,≪Изуми, бұрын олай емес еді≫
Dialogue: 0,0:05:43.14,0:05:46.64,Default,,0,0,0,,≪Кішкентай және өте спорттық емес.
Dialogue: 0,0:05:46.64,0:05:49.51,Default,,0,0,0,,Релаксация...≫
Dialogue: 0,0:05:49.51,0:05:51.51,Default,,0,0,0,,≪Себебі үйлер бір-біріне көрші болатын
Dialogue: 0,0:05:51.51,0:05:54.55,Default,,0,0,0,,Ол мен үшін сүйкімді інім сияқты≫
Dialogue: 0,0:05:54.55,0:05:58.39,Default,,0,0,0,,Сен
Dialogue: 0,0:05:58.39,0:06:02.76,Default,,0,0,0,,≪Сосын мен кіші мектеп табалдырығын аттағанда, бойым өсті...≫
Dialogue: 0,0:06:02.76,0:06:08.46,Default,,0,0,0,,Сен
Dialogue: 0,0:06:08.46,0:06:10.83,Default,,0,0,0,,Хэхе [ (Студент қыз) А?
Dialogue: 0,0:06:10.83,0:06:12.93,Default,,0,0,0,,Бұл Изумидің бала күнгі досы ма?
Dialogue: 0,0:06:12.93,0:06:15.74,Default,,0,0,0,,Қарапайым бала болсаң да, түсінбестік жоқ па?
Dialogue: 0,0:06:15.74,0:06:18.47,Default,,0,0,0,,Мен не болып жатқанын білгенде тітіркенемін.
Dialogue: 0,0:06:18.47,0:06:20.47,Default,,0,0,0,,Анау қарапайым қыз, Өмірлік бақыт
Dialogue: 0,0:06:20.47,0:06:23.04,Default,,0,0,0,,Сіз оны пайдаландыңыз, солай емес пе? (Студент қыз) Мен айта аламын~
Dialogue: 0,0:06:23.04,0:06:26.68,Default,,0,0,0,,Пуу~ (Оқушы қыз) Күлкі...
Dialogue: 0,0:06:26.68,0:06:29.58,Default,,0,0,0,,Сіз білесіз бе? Жаман сөз айтатын балалар
Dialogue: 0,0:06:29.58,0:06:32.65,Default,,0,0,0,,Бұл рас, "Пуу~кусукусу" сияқты.
Dialogue: 0,0:06:32.65,0:06:35.59,Default,,0,0,0,,“Пуууууу~кусукусу”. (Момоко) Иә, иә.
Dialogue: 0,0:06:35.59,0:06:37.93,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз
Dialogue: 0,0:06:37.93,0:06:41.46,Default,,0,0,0,,Мен қазір көңілді жүрмін. (Момоко) Иә?
Dialogue: 0,0:06:41.46,0:06:44.83,Default,,0,0,0,,Маған сыпыруға болмайды дегенді ұнатпаймын.
Dialogue: 0,0:06:44.83,0:06:46.93,Default,,0,0,0,,Бірақ аз ғана.
Dialogue: 0,0:06:46.93,0:06:50.37,Default,,0,0,0,,Әдебиет үйірмесіндегілердің бәрі біртүрлі, бірақ қызықты.
Dialogue: 0,0:06:50.37,0:06:53.37,Default,,0,0,0,,Мо-чин де маған мейірімді. Ах...
Dialogue: 0,0:06:53.37,0:06:55.88,Default,,0,0,0,,Әдеттегідей рахмет, Мучин
Dialogue: 0,0:06:55.88,0:06:57.91,Default,,0,0,0,,Уф… Ууу…
Dialogue: 0,0:06:57.91,0:07:00.68,Default,,0,0,0,,Сізге көп рахмет, Казуза.
Dialogue: 0,0:07:00.68,0:07:05.09,Default,,0,0,0,,Менімен дос болғаныңыз үшін рахмет.Мучин
Dialogue: 0,0:07:05.09,0:07:07.72,Default,,0,0,0,,Менің досым!
Dialogue: 0,0:07:07.72,0:07:12.02,Default,,0,0,0,,Тырылдау...(пернетақта жұмысының дыбысы)
Dialogue: 0,0:07:14.13,0:07:16.13,Default,,0,0,0,,Уф~
Dialogue: 0,0:07:16.13,0:07:19.93,Default,,0,0,0,,Жыныстық қатынасты білмей, әдебиет туралы айтуға болмайды.
Dialogue: 0,0:07:22.07,0:07:24.84,Default,,0,0,0,,«Кене» белгісі
Dialogue: 0,0:07:24.84,0:07:27.14,Default,,0,0,0,,«Мистер Мило, сіз сондасыз ба?»
Dialogue: 0,0:07:31.45,0:07:33.45,Default,,0,0,0,,Понг (хабарландыру дыбысы) Хмм
Dialogue: 0,0:07:36.95,0:07:39.85,Default,,0,0,0,,«Ей, мен шыдай алмаймын».
Dialogue: 0,0:07:39.85,0:07:42.86,Default,,0,0,0,,Пон Катаката…
Dialogue: 0,0:07:42.86,0:07:46.19,Default,,0,0,0,,«Иә, толып жатыр.
Dialogue: 0,0:07:46.19,0:07:50.20,Default,,0,0,0,,Тезірек шошқа сорпасын беріңізші»…｡ Уа
Dialogue: 0,0:07:50.20,0:07:53.80,Default,,0,0,0,,Керемет Sonezaki логотиптері
Dialogue: 0,0:07:53.80,0:07:57.00,Default,,0,0,0,,«Тәтті шырынды ішіңіз».
Dialogue: 0,0:08:01.18,0:08:04.78,Default,,0,0,0,,≪Әдебиет үйірмесі ыңғайлы және көңілді≫
Dialogue: 0,0:08:04.78,0:08:08.12,Default,,0,0,0,,≪Алайда, әдебиет үйірмесіне қатысушылардың бәрі оқитын кітаптар
Dialogue: 0,0:08:08.12,0:08:10.92,Default,,0,0,0,,Мен бұрын оқыған кітаптардан айырмашылығы
Dialogue: 0,0:08:10.92,0:08:15.02,Default,,0,0,0,,Бірден ересектер әлемі, бірден секс иісі≫
Dialogue: 0,0:08:16.82,0:08:19.36,Default,,0,0,0,,«Жыртылған қауын»?
Dialogue: 0,0:08:19.36,0:08:24.56,Default,,0,0,0,,Сен
Dialogue: 0,0:08:30.14,0:08:32.14,Default,,0,0,0,,Не!
Dialogue: 0,0:08:35.81,0:08:40.51,Default,,0,0,0,,～ ～
Dialogue: 0,0:08:40.51,0:08:43.52,Default,,0,0,0,,Жағымды иіс! Әй, бұл жақында орындалады
Dialogue: 0,0:08:43.52,0:08:45.52,Default,,0,0,0,,Шынымен бе? Хаха мен жасадым
Dialogue: 0,0:08:45.52,0:08:48.69,Default,,0,0,0,,Сен
Dialogue: 0,0:08:48.69,0:08:52.33,Default,,0,0,0,,Мүмкін шошқа сорпасы? иә? Мен кенчинмін.
Dialogue: 0,0:08:52.33,0:08:56.93,Default,,0,0,0,,А, жоқ. Мен Кенчинді жақсы көремін.
Dialogue: 0,0:08:58.33,0:09:01.03,Default,,0,0,0,,Қызық, шалғам піскен бе?
Dialogue: 0,0:09:01.03,0:09:05.37,Default,,0,0,0,,≪Менің анам табиғи немесе балаша...≫ дейді
Dialogue: 0,0:09:05.37,0:09:08.01,Default,,0,0,0,,Ол пәк қыз емес.
Dialogue: 0,0:09:08.01,0:09:11.01,Default,,0,0,0,,А, мұны кейін Изуми-кунға әкел.
Dialogue: 0,0:09:11.01,0:09:13.71,Default,,0,0,0,,Не? Субұрқақта? Изуми-кун ана
Dialogue: 0,0:09:13.71,0:09:16.08,Default,,0,0,0,,Әжем арқасын ауыртып алған сияқты.
Dialogue: 0,0:09:16.08,0:09:19.48,Default,,0,0,0,,Ол Наганодағы ата-анасының үйіне бір аптаға қайтады.
Dialogue: 0,0:09:21.09,0:09:23.09,Default,,0,0,0,,…｡ …()
Dialogue: 0,0:09:23.09,0:09:25.09,Default,,0,0,0,,(ﾄﾞｱ)
Dialogue: 0,0:09:25.09,0:09:27.13,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:09:27.13,0:09:29.13,Default,,0,0,0,,Йо... Йо
Dialogue: 0,0:09:31.43,0:09:35.34,Default,,0,0,0,,Пуха~! Кенчин апай сондай жақсы
Dialogue: 0,0:09:35.34,0:09:39.77,Default,,0,0,0,,Мен мұздатылған удон кеспесін де алып келдім, сондықтан оларды салқындатып, қосып аламын.
Dialogue: 0,0:09:39.77,0:09:43.17,Default,,0,0,0,,Оның бәрін ішпеңіз. Түсінді.
Dialogue: 0,0:09:44.81,0:09:46.88,Default,,0,0,0,,≪Изуми Күлімдеген жүз
Dialogue: 0,0:09:46.88,0:09:49.88,Default,,0,0,0,,Ол мүлде өзгерген жоқ≫
Dialogue: 0,0:09:49.88,0:09:53.18,Default,,0,0,0,,≪Мен үлкейіп келемін. Мен үлкейіп барамын...≫
Dialogue: 0,0:09:54.72,0:09:58.13,Default,,0,0,0,,Хаха! Хахаха!
Dialogue: 0,0:09:58.13,0:10:01.13,Default,,0,0,0,,Хаха! Шынымен бе?
Dialogue: 0,0:10:01.13,0:10:03.83,Default,,0,0,0,,Анашым, қарашы, қарашы! Ха!
Dialogue: 0,0:10:03.83,0:10:06.70,Default,,0,0,0,,Топ түйін!
Dialogue: 0,0:10:06.70,0:10:09.40,Default,,0,0,0,,Міне Изуми! Казузаның басында
Dialogue: 0,0:10:09.40,0:10:11.70,Default,,0,0,0,,Ондай нәрсе салмайсың ба?
Dialogue: 0,0:10:13.81,0:10:17.14,Default,,0,0,0,,Сәлем. Ха! Сонымен... болды
Dialogue: 0,0:10:17.14,0:10:20.58,Default,,0,0,0,,Өскенін білмеймін! иә? «Сосынша»?
Dialogue: 0,0:10:20.58,0:10:22.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.19,0:10:27.19,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:10:30.86,0:10:33.56,Default,,0,0,0,,Рахмет. Иә.
Dialogue: 0,0:10:35.86,0:10:37.90,Default,,0,0,0,,Осымен
Dialogue: 0,0:10:37.90,0:10:40.90,Default,,0,0,0,,Көпшілік алдында сөйлемеген дұрыс па?
Dialogue: 0,0:10:42.40,0:10:46.50,Default,,0,0,0,,Мен білмеймін. Бұл уақыт пен жағдайға байланысты.
Dialogue: 0,0:10:48.41,0:10:52.11,Default,,0,0,0,,Мен көремін. Түсіндім. Сонда кездескенше.
Dialogue: 0,0:11:00.39,0:11:02.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:03.79,0:11:05.79,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:11:13.60,0:11:16.37,Default,,0,0,0,,≪Жақында И
Dialogue: 0,0:11:16.37,0:11:20.37,Default,,0,0,0,,Мен өз жынысымнан тайып тұрғандай сезінемін≫
Dialogue: 0,0:11:20.37,0:11:24.38,Default,,0,0,0,,Васа: Түскі үзілісте клуб бөлмесінде кездесейік.
Dialogue: 0,0:11:24.38,0:11:27.31,Default,,0,0,0,,Е, сирек
Dialogue: 0,0:11:27.31,0:11:31.32,Default,,0,0,0,,Иә! Мектеп біткенше осы бақыттан ләззат алыңыз
Dialogue: 0,0:11:31.32,0:11:34.25,Default,,0,0,0,,Мен мұның бәрін өзіме сақтау керек пе деп ойладым.
Dialogue: 0,0:11:34.25,0:11:37.25,Default,,0,0,0,,Біз сізді осында қарсы алуға қуаныштымыз.
Dialogue: 0,0:11:38.69,0:11:41.46,Default,,0,0,0,,Түсіндім! Санномару Соруко Сенсейдікі
Dialogue: 0,0:11:41.46,0:11:44.50,Default,,0,0,0,,Жаңа өнімдер туралы соңғы ақпарат! (4 адам) Уау!
Dialogue: 0,0:11:44.50,0:11:48.30,Default,,0,0,0,,Өйткені, Соруко-сенсейін қыздар үшін ерекше адам.
Dialogue: 0,0:11:48.30,0:11:51.77,Default,,0,0,0,,«Моеми-чан» сериясын ұйықтамай оқыдым!
Dialogue: 0,0:11:51.77,0:11:55.61,Default,,0,0,0,,Бұл жолғы тақырып – өлім аузында тұрған басты кейіпкер.
Dialogue: 0,0:11:55.61,0:11:57.61,Default,,0,0,0,,Шелек тізімін жүргізіңіз
Dialogue: 0,0:11:57.61,0:12:00.55,Default,,0,0,0,,А, өлмес бұрын бірдеңе жасағың келеді ме?
Dialogue: 0,0:12:00.55,0:12:02.92,Default,,0,0,0,,Соруко-сенсэй, бұл жолы қатты.
Dialogue: 0,0:12:02.92,0:12:04.95,Default,,0,0,0,,Соруконы мазақ етпе.
Dialogue: 0,0:12:04.95,0:12:07.02,Default,,0,0,0,,Өйткені, қатты денелер маңызды.
Dialogue: 0,0:12:07.02,0:12:11.26,Default,,0,0,0,,Өлмес бұрын не істеп, артыма қалдырамын?
Dialogue: 0,0:12:11.26,0:12:13.93,Default,,0,0,0,,Бұл, әрине, ескірген тақырып, бірақ
Dialogue: 0,0:12:13.93,0:12:18.00,Default,,0,0,0,,Бұл соншалықты қиын және жоғары центрге бағытталған.
Dialogue: 0,0:12:18.00,0:12:22.44,Default,,0,0,0,,Өлмес бұрын мен не істегім келеді?
Dialogue: 0,0:12:22.44,0:12:24.44,Default,,0,0,0,,Мен ешқашан істей алмайтын нәрсені жасағым келеді!
Dialogue: 0,0:12:24.44,0:12:27.77,Default,,0,0,0,,Ақыр соңында, біз не үшін дүниеге келгенімізді түсінуіміз керек.
Dialogue: 0,0:12:27.77,0:12:29.78,Default,,0,0,0,,Білгіңіз келеді, солай ма?
Dialogue: 0,0:12:29.78,0:12:32.28,Default,,0,0,0,,Бұл тым тұжырымдамалық емес пе?
Dialogue: 0,0:12:32.28,0:12:35.28,Default,,0,0,0,,Жыныс. А~ секс?
Dialogue: 0,0:12:36.85,0:12:39.62,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:12:39.62,0:12:41.96,Default,,0,0,0,,Дыбыс... (қағаздың түсу дыбысы)
Dialogue: 0,0:12:41.96,0:12:43.96,Default,,0,0,0,,Жыныс
Dialogue: 0,0:12:43.96,0:12:47.29,Default,,0,0,0,,Кешіріңіз, естуім нашар болуы мүмкін.
Dialogue: 0,0:12:47.29,0:12:49.30,Default,,0,0,0,,Тағы да. Бұл секс.
Dialogue: 0,0:12:49.30,0:12:51.36,Default,,0,0,0,,Иә! Секс дегеніміз не?
Dialogue: 0,0:12:51.46,0:12:53.90,Default,,0,0,0,,Бұл мүлдем белгісіз аумақ.
Dialogue: 0,0:12:53.90,0:12:57.07,Default,,0,0,0,,Бұл туралы көптеген ұлы авторлар айтатын сала.
Dialogue: 0,0:12:57.07,0:12:59.24,Default,,0,0,0,,Оған қол тигізбей-ақ өлуге болады.
Dialogue: 0,0:12:59.24,0:13:01.24,Default,,0,0,0,,Бір сәт. (Гонго) Ах...
Dialogue: 0,0:13:01.24,0:13:04.98,Default,,0,0,0,,А... аа... сен! Әдебиетті порнографиямен шатастырмаңыз.
Dialogue: 0,0:13:04.98,0:13:07.98,Default,,0,0,0,,Сіз соншалықты көп айтпадыңыз ба? Эрос - бұл ұғым!
Dialogue: 0,0:13:07.98,0:13:12.05,Default,,0,0,0,,Бұл жай ғана белгі... Иә. Менің іздеп жүргенім
Dialogue: 0,0:13:12.05,0:13:15.52,Default,,0,0,0,,Бұл ұғым емес, енгізу және шығару. (Сонезаки) Кіру және шығару!
Dialogue: 0,0:13:15.52,0:13:18.32,Default,,0,0,0,,Өлім алдында не істегім келеді
Dialogue: 0,0:13:18.32,0:13:20.33,Default,,0,0,0,,Бұл өте уақтылы болды.
Dialogue: 0,0:13:20.33,0:13:22.83,Default,,0,0,0,,Мен бұл туралы дұрыстап ойланғым келді.
Dialogue: 0,0:13:25.50,0:13:27.93,Default,,0,0,0,,Мен жақында
Dialogue: 0,0:13:27.93,0:13:29.94,Default,,0,0,0,,Өйткені мен өлейін деп жатырмын. Гача
Dialogue: 0,0:13:29.94,0:13:32.01,Default,,0,0,0,,Иә! (Момоко) Не... нені айтып тұрсың?
Dialogue: 0,0:13:32.01,0:13:34.51,Default,,0,0,0,,Олай болса, кешіріңіз. Жарылыс (есік дыбысы)
Dialogue: 0,0:13:36.34,0:13:38.34,Default,,0,0,0,,...
Dialogue: 0,0:13:38.34,0:13:42.95,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:13:42.95,0:13:45.49,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:13:45.49,0:13:48.19,Default,,0,0,0,,Бұл жазылмайтын ауру ма?
Dialogue: 0,0:13:49.56,0:13:54.36,Default,,0,0,0,,Wasa Уақыт ұғымы бар ма? иә?
Dialogue: 0,0:13:54.36,0:13:58.06,Default,,0,0,0,,Жердің туғаннан бергі тарихы бір жылға дейін қысқарса.
Dialogue: 0,0:13:58.06,0:14:01.97,Default,,0,0,0,,Адамдардың дүниеге келгеніне небәрі 11 минут болды.
Dialogue: 0,0:14:01.97,0:14:04.97,Default,,0,0,0,,А... аа... иә. Содан кейін
Dialogue: 0,0:14:04.97,0:14:08.71,Default,,0,0,0,,Жалғыз өмір сүретін болсам, ертең өлмес едім.
Dialogue: 0,0:14:08.71,0:14:12.51,Default,,0,0,0,,Қазірдің өзінде Будда деңгейінде. Иә, мен оны түсінемін.
Dialogue: 0,0:14:14.78,0:14:17.18,Default,,0,0,0,,Сонда кездескенше. Ах...
Dialogue: 0,0:14:17.18,0:14:20.19,Default,,0,0,0,,Сабақтан кейін кездескенше.
Dialogue: 0,0:14:20.19,0:14:24.09,Default,,0,0,0,,<мырза. Сугавараның шын ниеті әлі де жұмбақ еді...>
Dialogue: 0,0:14:24.09,0:14:26.09,Default,,0,0,0,,Бұл жерде бір жұмбақ бар!
Dialogue: 0,0:14:26.09,0:14:29.53,Default,,0,0,0,,Бұл гипер сұлулық! (Хонго) Тынышталыңыз.
Dialogue: 0,0:14:29.53,0:14:31.87,Default,,0,0,0,,Мен сені мүлде сынамаймын.
Dialogue: 0,0:14:31.87,0:14:35.94,Default,,0,0,0,,< Қалай болғанда да, Сугавара мырзаның «секс» сөзі
Dialogue: 0,0:14:35.94,0:14:39.01,Default,,0,0,0,,Бұл бізді қалай да еліктірді.＞
Dialogue: 0,0:14:44.58,0:14:46.65,Default,,0,0,0,,Бұл не? Бұл не? Бұл не?
Dialogue: 0,0:14:46.65,0:14:49.22,Default,,0,0,0,,Сонымен, Готоның заттары танымал.
Dialogue: 0,0:14:49.22,0:14:51.22,Default,,0,0,0,,Иә? Шынайы ма? (Кояма) Сен мұны істедің бе?
Dialogue: 0,0:14:51.22,0:14:54.09,Default,,0,0,0,,Жоқ, Готомен бірдеңе. (Кояма) Жақсы.
Dialogue: 0,0:14:54.09,0:14:56.92,Default,,0,0,0,,Тек ұшын салуға рұқсат етіңіз. (Джужо) Ақымақ болма.
Dialogue: 0,0:14:56.92,0:14:58.93,Default,,0,0,0,,Хахаха. Bang!
Dialogue: 0,0:14:58.93,0:15:01.53,Default,,0,0,0,,Ей, лас жыныстық аң!
Dialogue: 0,0:15:04.50,0:15:06.50,Default,,0,0,0,,Ах... (Джужо) Эй, болды.
Dialogue: 0,0:15:06.50,0:15:10.17,Default,,0,0,0,,Сіз мұны бізге айтып тұрсыз ба? (Сонезаки) О, жоқ...
Dialogue: 0,0:15:10.17,0:15:13.34,Default,,0,0,0,,Хмм... Жоқ, ол басқаша емес.
Dialogue: 0,0:15:13.34,0:15:16.18,Default,,0,0,0,,Балалар сендер мектепке не үшін келесіңдер?
Dialogue: 0,0:15:16.18,0:15:19.01,Default,,0,0,0,,Жұптасатын айғыр іздеп жүрсіз бе? (Джужо) Иә?
Dialogue: 0,0:15:19.01,0:15:21.65,Default,,0,0,0,,Сіз не істеп жатырсыз? Тағы айт!
Dialogue: 0,0:15:21.65,0:15:24.65,Default,,0,0,0,,Оны жайына қалдырыңыз. Ол жай ғана танымал емес, ұсқынсыз тәртіп бұзушы.
Dialogue: 0,0:15:24.65,0:15:28.15,Default,,0,0,0,,Сонезаки. (Каяма) Хехе, сен тым жылдам допсың.
Dialogue: 0,0:15:28.15,0:15:31.16,Default,,0,0,0,,Ой... мен сенімен сөйлесе алмаймын.
Dialogue: 0,0:15:31.16,0:15:33.16,Default,,0,0,0,,Жоқ, жоқ, әрине.
Dialogue: 0,0:15:33.16,0:15:38.16,Default,,0,0,0,,Ах~ мен ақыры үндемедім. (Фуджимото) Мазасыз, шіркін.
Dialogue: 0,0:15:38.16,0:15:41.17,Default,,0,0,0,,Бұл тітіркендіргіш. (Оқушы қыз) Тоқта, балам.
Dialogue: 0,0:15:41.17,0:15:45.17,Default,,0,0,0,,Мен көрдім бе? Сонезаки мырза соншалықты ұсқынсыз ба?
Dialogue: 0,0:15:45.17,0:15:47.37,Default,,0,0,0,,Менің ойымша, бұл өте сүйкімді.
Dialogue: 0,0:15:48.98,0:15:53.41,Default,,0,0,0,,Ол ұзын және сымбатты, сондықтан ол модельге ұқсайды деп ойлаймын?
Dialogue: 0,0:15:53.41,0:15:55.42,Default,,0,0,0,,Эй, сен не айтып тұрсың? Амаги
Dialogue: 0,0:15:55.42,0:15:59.09,Default,,0,0,0,,Сіз сараң адамсыз ба? (Ер оқушы) Бұл қандай модель?
Dialogue: 0,0:15:59.09,0:16:01.59,Default,,0,0,0,,Банг! Балалар сендер шулысыңдар! Мұғалім...
Dialogue: 0,0:16:01.59,0:16:05.53,Default,,0,0,0,,А-а, өз бетімен оқу. Қалай болғанда да, тыныш болыңыз!
Dialogue: 0,0:16:05.53,0:16:08.53,Default,,0,0,0,,Иә
Dialogue: 0,0:16:08.53,0:16:12.23,Default,,0,0,0,,Сен нені мазақ етіп тұрсың?
Dialogue: 0,0:16:12.23,0:16:18.24,Default,,0,0,0,,ｷｰﾝ ｺｰﾝ ｶｰﾝ ｺｰﾝ(ﾁｬｲﾑ)
Dialogue: 0,0:16:18.24,0:16:21.74,Default,,0,0,0,,Сонезаки-сенпай мен Ниина келмейді.
Dialogue: 0,0:16:21.74,0:16:24.08,Default,,0,0,0,,Сенпай, сен әлі ашулысың ба?
Dialogue: 0,0:16:24.08,0:16:26.25,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:16:26.25,0:16:29.08,Default,,0,0,0,,Бүгін «Жүгір, Мелос» па? (2 адам) Иә?
Dialogue: 0,0:16:29.08,0:16:31.28,Default,,0,0,0,,«Жүгіру»…. «Мерос»…
Dialogue: 0,0:16:32.99,0:16:35.86,Default,,0,0,0,,Не болды? (Момоко/Васа) Жоқ, ештеңе.
Dialogue: 0,0:16:35.86,0:16:39.36,Default,,0,0,0,,Олай болса, жиналу жақсы идея болмаған соң, бүгін ажырасқанымыз дұрыс па?
Dialogue: 0,0:16:39.36,0:16:42.40,Default,,0,0,0,,А, иә. (Гонго) Жақсы жұмыс~
Dialogue: 0,0:16:42.40,0:16:45.70,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:16:45.70,0:16:48.74,Default,,0,0,0,,Гача Бэнг
Dialogue: 0,0:16:48.74,0:16:52.24,Default,,0,0,0,,Ах...｡ Уф~
Dialogue: 0,0:16:52.24,0:16:54.87,Default,,0,0,0,,«Жүгір, Эрос» деп ойладым!
Dialogue: 0,0:16:54.87,0:16:57.31,Default,,0,0,0,,Дұрыс. Жақында
Dialogue: 0,0:16:57.31,0:16:59.85,Default,,0,0,0,,Әрбір сөз сексуалдық естіледі
Dialogue: 0,0:16:59.85,0:17:02.25,Default,,0,0,0,,Жақсы. Мен эротикаға бейім жалғыз адаммын.
Dialogue: 0,0:17:02.25,0:17:06.29,Default,,0,0,0,,Мен өзімді жынданып кетті деп ойладым. (2 адам) Достар!
Dialogue: 0,0:17:06.29,0:17:10.02,Default,,0,0,0,,Өйткені, тек кітап оқысаң, біртүрлі боласың.
Dialogue: 0,0:17:10.02,0:17:12.96,Default,,0,0,0,,Мүмкін сіз денеңізді сәл көбірек жылжытуыңыз керек
Dialogue: 0,0:17:12.96,0:17:16.60,Default,,0,0,0,,Иә, мен сенімдімін. О, мен ваннаға барамын.
Dialogue: 0,0:17:16.60,0:17:19.37,Default,,0,0,0,,Мен осында күтемін. (Момоко) Иә.
Dialogue: 0,0:17:19.37,0:17:21.40,Default,,0,0,0,,Эрос жүгіру арқылы дүниелік қалауларынан құтылады.
Dialogue: 0,0:17:21.40,0:17:24.04,Default,,0,0,0,,Мен ақыры босатылдым. Ал енді мен...
Dialogue: 0,0:17:24.04,0:17:26.21,Default,,0,0,0,,Хаха! (Асада) Изуми-кун күлкілі!
Dialogue: 0,0:17:26.21,0:17:28.61,Default,,0,0,0,,Таза немесе тың қуат тым жоғары.
Dialogue: 0,0:17:28.61,0:17:31.98,Default,,0,0,0,,Оның мұндай түрімен сүйген қызы болмағаны шынымен керемет.
Dialogue: 0,0:17:31.98,0:17:34.58,Default,,0,0,0,,Асада Бару керек. иә!
Dialogue: 0,0:17:34.58,0:17:39.12,Default,,0,0,0,,Менің қыздығымды алма, ақымақ. Сен не туралы айтып тұрсың?
Dialogue: 0,0:17:39.12,0:17:41.69,Default,,0,0,0,,Хехе, бірақ бұл мүмкін.
Dialogue: 0,0:17:41.69,0:17:44.16,Default,,0,0,0,,()  ｡ ()
Dialogue: 0,0:17:44.16,0:17:46.16,Default,,0,0,0,,()
Dialogue: 0,0:17:46.16,0:17:50.16,Default,,0,0,0,,Мен көремін. Изуми танымал.
Dialogue: 0,0:17:50.16,0:17:55.46,Default,,0,0,0,,Бұзықтық жасағың келсе, қолыңнан келеді.
Dialogue: 0,0:17:57.17,0:17:59.17,Default,,0,0,0,,≪Жоқ, жоқ, жоқ, жоқ! ≫
Dialogue: 0,0:17:59.17,0:18:01.87,Default,,0,0,0,,≪Себебі Изуми сәбізді де жей алмайды.
Dialogue: 0,0:18:01.87,0:18:05.88,Default,,0,0,0,,Сіз оқыған кітаптардың өзі секс туралы әңгімелер емес, кестелер≫
Dialogue: 0,0:18:05.88,0:18:08.35,Default,,0,0,0,,()～ ～
Dialogue: 0,0:18:08.35,0:18:10.85,Default,,0,0,0,,Ах! Иә!
Dialogue: 0,0:18:10.85,0:18:14.45,Default,,0,0,0,,Мұны Изуми-кунға апарыңыз.
Dialogue: 0,0:18:14.45,0:18:17.56,Default,,0,0,0,,Қуырылған қияр, кинпира және гамбургер стейктері.
Dialogue: 0,0:18:17.56,0:18:19.86,Default,,0,0,0,,Иә! (Анашым) Ой, енді ойласам...
Dialogue: 0,0:18:19.86,0:18:22.83,Default,,0,0,0,,Я... Жыртылған қауын!
Dialogue: 0,0:18:22.83,0:18:25.40,Default,,0,0,0,,Пинг-понг (домофон)
Dialogue: 0,0:18:25.40,0:18:27.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:28.80,0:18:30.80,Default,,0,0,0,,Пинг-понг
Dialogue: 0,0:18:38.54,0:18:40.54,Default,,0,0,0,,Онда емес пе?
Dialogue: 0,0:18:42.45,0:18:45.08,Default,,0,0,0,,～(TRAIN-TRAIN)
Dialogue: 0,0:18:45.08,0:18:48.92,Default,,0,0,0,,～
Dialogue: 0,0:18:48.92,0:18:50.92,Default,,0,0,0,,Ах
Dialogue: 0,0:18:50.92,0:19:10.91,Default,,0,0,0,,～
Dialogue: 0,0:19:10.91,0:19:12.91,Default,,0,0,0,,Фонтан?
Dialogue: 0,0:19:12.91,0:19:17.28,Default,,0,0,0,,～
Dialogue: 0,0:19:17.28,0:19:19.29,Default,,0,0,0,,Сен
Dialogue: 0,0:19:19.29,0:19:21.32,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:19:21.32,0:19:26.39,Default,,0,0,0,,Сен
Dialogue: 0,0:19:26.39,0:19:30.30,Default,,0,0,0,,Ха! (Әйел) Ха... ха...
Dialogue: 0,0:19:30.30,0:19:37.40,Default,,0,0,0,,Сен
Dialogue: 0,0:19:37.40,0:19:41.37,Default,,0,0,0,,А... Мм...
Dialogue: 0,0:19:41.37,0:19:45.81,Default,,0,0,0,,Күрсін... Күрсін... Күрсін...
Dialogue: 0,0:19:45.81,0:19:48.82,Default,,0,0,0,,Иә. (Әйел) Аа... аа...
Dialogue: 0,0:19:48.82,0:19:51.98,Default,,0,0,0,,Міне, бүгін де ыстық.
Dialogue: 0,0:19:51.98,0:19:54.15,Default,,0,0,0,,≪Бұрқақ бұл...≫
Dialogue: 0,0:19:54.15,0:19:56.62,Default,,0,0,0,,А, сен маған тағы тамақ әкелдің.
Dialogue: 0,0:19:56.62,0:19:59.03,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:19:59.03,0:20:01.03,Default,,0,0,0,,≪Не...≫
Dialogue: 0,0:20:01.03,0:20:03.03,Default,,0,0,0,,күрсіну…｡ Ката
Dialogue: 0,0:20:04.46,0:20:07.20,Default,,0,0,0,,Осымен
Dialogue: 0,0:20:07.20,0:20:10.74,Default,,0,0,0,,Сіз мұны менімен жасай аласыз ба?
Dialogue: 0,0:20:10.74,0:20:13.24,Default,,0,0,0,,Гаттат
Dialogue: 0,0:20:13.24,0:20:17.24,Default,,0,0,0,,Уау! Ах! Мен... Эй...
Dialogue: 0,0:20:17.24,0:20:20.61,Default,,0,0,0,,Ах! Хахаха...
Dialogue: 0,0:20:20.61,0:20:23.52,Default,,0,0,0,,<<Мен білетін бұлақ бұл емес>>
Dialogue: 0,0:20:23.52,0:20:25.59,Default,,0,0,0,,≪Мен білетін бұлақ...≫
Dialogue: 0,0:20:25.59,0:20:27.65,Default,,0,0,0,,♬~
Dialogue: 0,0:20:27.65,0:20:30.89,Default,,0,0,0,,≪Se… Жыныс дегеніміз
Dialogue: 0,0:20:30.89,0:20:34.59,Default,,0,0,0,,А... мынаны істе...≫
Dialogue: 0,0:20:34.59,0:20:36.60,Default,,0,0,0,,Ахх...
Dialogue: 0,0:20:36.60,0:20:40.60,Default,,0,0,0,,Ахххх
Dialogue: 0,0:20:40.60,0:20:43.90,Default,,0,0,0,,Хаа ха ха...｡ Уф...
Dialogue: 0,0:20:46.21,0:20:48.21,Default,,0,0,0,,Ха! Хмм...
Dialogue: 0,0:20:50.08,0:20:52.11,Default,,0,0,0,,Сәлем! Ха!
Dialogue: 0,0:20:52.11,0:20:55.41,Default,,0,0,0,,Иә! А... аа~!
Dialogue: 0,0:20:55.41,0:20:58.99,Default,,0,0,0,,Сәлем! Жоқ...
Dialogue: 0,0:20:58.99,0:21:02.99,Default,,0,0,0,,Сен
Dialogue: 0,0:21:02.99,0:21:05.99,Default,,0,0,0,,≪Бұл дүние секспен тым жабылған...≫
Dialogue: 0,0:21:05.99,0:21:08.79,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:08.79,0:21:12.29,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:21:14.30,0:21:17.47,Default,,0,0,0,,Бұл мүмкін емес~ Бұл мүмкін емес
Dialogue: 0,0:21:17.47,0:21:21.07,Default,,0,0,0,,Өйткені мұндай нәрсе ешқашан сыймайды.
Dialogue: 0,0:21:24.18,0:21:26.18,Default,,0,0,0,,♬~
Dialogue: 0,0:21:29.88,0:21:31.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:34.22,0:21:37.02,Default,,0,0,0,,А, мен кірдім.
Dialogue: 0,0:21:41.26,0:21:44.03,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:21:44.03,0:21:48.70,Default,,0,0,0,,Жоқ~｡ Енді жоқ
Dialogue: 0,0:21:48.70,0:21:53.70,Default,,0,0,0,,Мен жынысына қарай иландырғым келмейді.
Dialogue: 0,0:21:55.78,0:23:07.81,Default,,0,0,0,,Сен
Dialogue: 0,0:23:09.38,0:23:24.79,Default,,0,0,0,,Сен
Dialogue: 0,0:23:25.49,0:23:27.49,Default,,0,0,0,,Менің белім қышиды!
Dialogue: 0,0:23:31.50,0:23:34.26,Default,,0,0,0,,Қорқынышты ЖЫНЫСТЫҚ тұзақ. (Изуми) Не істеп жатырсың?
Dialogue: 0,0:23:34.26,0:23:36.27,Default,,0,0,0,,Эсуйбацу. (Джужо) Сонезаки-сан
Dialogue: 0,0:23:36.27,0:23:39.24,Default,,0,0,0,,Қыздық пердең сынған, солай емес пе? (Момоко) Мен мұндай васаны бірінші рет көрдім.
Dialogue: 0,0:23:39.24,0:23:41.34,Default,,0,0,0,,Сіз оны ұмыта аласыз ба? (Сонезаки) Аңдар
Dialogue: 0,0:23:41.34,0:23:43.61,Default,,0,0,0,,Мен қудалауға көнбеймін
Dialogue: 0,0:23:43.61,0:23:45.94,Default,,0,0,0,,Мен мәңгі күттім!
Dialogue: 0,0:23:45.94,0:23:49.05,Default,,0,0,0,,Мен... (Изуми) Иә, түсіндім.
Dialogue: 0,0:23:49.05,0:23:51.35,Default,,0,0,0,,Васаның кім болғанын қалайсыз?
Dialogue: 0,0:23:51.35,0:23:53.85,Default,,0,0,0,,Менің жамбам... менің жамбам қышиды!
Dialogue: 0,0:23:55.35,0:24:01.35,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
