Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:04.00,Default,,0,0,0,,- Шынымен! Бұл жағдайдың осылайша өзгеруі таңқаларлық емес пе?
Dialogue: 0,0:00:09.00,0:00:10.00,Default,,0,0,0,,Керемет, мен.
Dialogue: 0,0:00:10.00,0:00:11.00,Default,,0,0,0,,- Иә?
Dialogue: 0,0:00:11.00,0:00:12.00,Default,,0,0,0,,- Ах...
Dialogue: 0,0:00:12.00,0:00:15.00,Default,,0,0,0,,- Иә, Саки-сан өте жақсы!
Dialogue: 0,0:00:15.00,0:00:18.00,Default,,0,0,0,,- Медаль алған кезде сұлу қыз немесе манга сияқты!
Dialogue: 0,0:00:18.00,0:00:21.00,Default,,0,0,0,,- Қараңыз! Бұл Эрикаға ұқсайды!
Dialogue: 0,0:00:21.00,0:00:22.00,Default,,0,0,0,,- Эрика?
Dialogue: 0,0:00:22.00,0:00:23.00,Default,,0,0,0,,- Бірақ, әрине
Dialogue: 0,0:00:23.00,0:00:25.00,Default,,0,0,0,,- Біреу айтты емес пе?
Dialogue: 0,0:00:25.00,0:00:26.00,Default,,0,0,0,,- Эрика?
Dialogue: 0,0:00:26.00,0:00:27.00,Default,,0,0,0,,- Эрика?
Dialogue: 0,0:00:27.00,0:00:28.00,Default,,0,0,0,,- Эрика?
Dialogue: 0,0:00:28.00,0:00:30.00,Default,,0,0,0,,- Біреу айтты емес пе?
Dialogue: 0,0:00:30.00,0:00:31.00,Default,,0,0,0,,- О, мен түсіндім.
Dialogue: 0,0:00:31.00,0:00:34.00,Default,,0,0,0,,- Амаки Сакидің Эрикаға ұқсайтынын айтты.
Dialogue: 0,0:00:34.00,0:00:36.00,Default,,0,0,0,,- Ой, түсіндім.
Dialogue: 0,0:00:36.00,0:00:38.00,Default,,0,0,0,,- Жоқ, Саки-сан, саған Амаки ұнай ма?
Dialogue: 0,0:00:38.00,0:00:39.00,Default,,0,0,0,,- Жоқ, Саки-сан, саған Амаки ұнай ма?
Dialogue: 0,0:00:39.00,0:00:40.00,Default,,0,0,0,,- Жоқ, Саки-сан, саған Амаки ұнай ма?
Dialogue: 0,0:00:40.00,0:00:42.00,Default,,0,0,0,,- Мені қате түсінбеңіз!
Dialogue: 0,0:00:42.00,0:00:45.00,Default,,0,0,0,,- Мұндай жеңілтек жігітке ғашық болу мүмкін емес!
Dialogue: 0,0:00:45.00,0:00:48.00,Default,,0,0,0,,- Мен өзімді ұнатқандықтан ғана түрімді өзгерттім!
Dialogue: 0,0:00:54.00,0:00:55.00,Default,,0,0,0,,- Әрине!
Dialogue: 0,0:00:55.00,0:00:58.00,Default,,0,0,0,,- Мен әрқашан тек иттер мен жауды алып жүретіндерге ұнайтынмын!
Dialogue: 0,0:00:58.00,0:01:00.00,Default,,0,0,0,,- Бұл не?
Dialogue: 0,0:01:00.00,0:01:02.00,Default,,0,0,0,,- Одан гөрі мен ғана болдым!
Dialogue: 0,0:01:02.00,0:01:04.00,Default,,0,0,0,,- Шырынды фанфан!
Dialogue: 0,0:01:04.00,0:01:05.00,Default,,0,0,0,,- Әй, сен қашан қоңырау шалдың?
Dialogue: 0,0:01:05.00,0:01:07.00,Default,,0,0,0,,- Ой! Жүзім, жүзім!
Dialogue: 0,0:01:07.00,0:01:09.00,Default,,0,0,0,,- Бұл жағымсыз дәм.
Dialogue: 0,0:01:09.00,0:01:10.00,Default,,0,0,0,,- Не?
Dialogue: 0,0:01:26.00,0:01:29.00,Default,,0,0,0,,- Неліктен бәрі мұны білгісі келеді?
Dialogue: 0,0:01:29.00,0:01:33.00,Default,,0,0,0,,- Мұның тартымдылығы неде?
Dialogue: 0,0:01:33.00,0:01:36.00,Default,,0,0,0,,- Мүмкін сіз мұны да білетін шығарсыз?
Dialogue: 0,0:01:36.00,0:01:40.00,Default,,0,0,0,,- Бұны білмесем, сені танымас па едім?
Dialogue: 0,0:01:40.00,0:01:42.00,Default,,0,0,0,,- Солай ма...
Dialogue: 0,0:01:42.00,0:01:45.00,Default,,0,0,0,,- Жоқ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Dialogue: 0,0:01:45.00,0:01:51.00,Default,,0,0,0,,Келесі бет қызықсыз 15 бет болды.
Dialogue: 0,0:01:51.00,0:01:56.00,Default,,0,0,0,,Тынысым тарылып, батып кеттім.
Dialogue: 0,0:01:56.00,0:02:01.00,Default,,0,0,0,,Мен енді өле алмаймын деген сезімге
Dialogue: 0,0:02:01.00,0:02:06.00,Default,,0,0,0,,Бүгін де мені негізсіз ұрып-соқты.
Dialogue: 0,0:02:06.00,0:02:12.00,Default,,0,0,0,,Мен оның Кей Аои екенін білгім келмеді
Dialogue: 0,0:02:12.00,0:02:17.00,Default,,0,0,0,,Бұл азаптың шынайы сипаты қандай?
Dialogue: 0,0:02:18.00,0:02:23.00,Default,,0,0,0,,Бірақ ауырса да оқуды тоқтатпаймын.
Dialogue: 0,0:02:23.00,0:02:29.00,Default,,0,0,0,,Әдемі бола алмайтын сіз туралы білуге арналған бет
Dialogue: 0,0:02:29.00,0:02:34.00,Default,,0,0,0,,Қаңырап қалған қыздар, Қыздарға қарсы
Dialogue: 0,0:02:34.00,0:02:41.00,Default,,0,0,0,,Ауырсын біл, Көмекші керек емес
Dialogue: 0,0:02:42.00,0:02:47.00,Default,,0,0,0,,Бұл не? Бұл шынымен не?
Dialogue: 0,0:02:47.00,0:02:50.00,Default,,0,0,0,,Сізге айту үшін сыртқы түріңізді өзгертудің қажеті жоқ
Dialogue: 0,0:02:50.00,0:02:53.00,Default,,0,0,0,,Түріңді өзгертсең де сынға ұшырайсың.
Dialogue: 0,0:03:01.00,0:03:03.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:03.00,0:03:05.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:05.00,0:03:08.00,Default,,0,0,0,,Жарайды, менің ойымша, бұл түсінбеушілік.
Dialogue: 0,0:03:08.00,0:03:13.00,Default,,0,0,0,,Менің ойымша, олар енді олай істемейді, бәрі де.
Dialogue: 0,0:03:15.00,0:03:22.00,Default,,0,0,0,,Түсініспеушілік орын алғандықтан, көңілім сәл қалды.
Dialogue: 0,0:03:22.00,0:03:27.00,Default,,0,0,0,,Шынымды айтсам, маған Соезаки-сан ұнай бастады.
Dialogue: 0,0:03:27.00,0:03:31.00,Default,,0,0,0,,Эй, есепті 50 рет жібер
Dialogue: 0,0:03:31.00,0:03:32.00,Default,,0,0,0,,Есеп беру?
Dialogue: 0,0:03:32.00,0:03:36.00,Default,,0,0,0,,Менің сыртқы түрімнің өзгеруі сізді таң қалдырды деп ойлаймын.
Dialogue: 0,0:03:36.00,0:03:37.00,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:03:37.00,0:03:39.00,Default,,0,0,0,,Егер болса жаз
Dialogue: 0,0:03:39.00,0:03:43.00,Default,,0,0,0,,Мен туралы қайда және қай жерде айтасың?
Dialogue: 0,0:03:43.00,0:03:45.00,Default,,0,0,0,,Жүр, кеттік
Dialogue: 0,0:03:45.00,0:03:47.00,Default,,0,0,0,,Жүр, кеттік
Dialogue: 0,0:03:47.00,0:03:49.00,Default,,0,0,0,,Жүр, кеттік
Dialogue: 0,0:03:49.00,0:03:51.00,Default,,0,0,0,,Жүр, кеттік
Dialogue: 0,0:03:51.00,0:03:53.00,Default,,0,0,0,,Жүр, кеттік
Dialogue: 0,0:03:53.00,0:03:54.00,Default,,0,0,0,,Жазыңыз
Dialogue: 0,0:03:54.00,0:03:58.00,Default,,0,0,0,,Маған қашан, қай жерде ғашық болдың?
Dialogue: 0,0:03:58.00,0:03:59.00,Default,,0,0,0,,50 рет
Dialogue: 0,0:03:59.00,0:04:01.00,Default,,0,0,0,,Мм, бәрібір 50 рет.
Dialogue: 0,0:04:01.00,0:04:06.00,Default,,0,0,0,,Мен оны жазбасам саған ғашық болар едім деп мойындамаймын.
Dialogue: 0,0:04:08.00,0:04:11.00,Default,,0,0,0,,Сіз мақұлдамаймын дейсіз бе?
Dialogue: 0,0:04:14.00,0:04:19.00,Default,,0,0,0,,Соезаки-сенпай, сен таңғажайып өзгеріс жасадың, Каззу-сан.
Dialogue: 0,0:04:19.00,0:04:20.00,Default,,0,0,0,,Кадзу мырза?
Dialogue: 0,0:04:20.00,0:04:21.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:04:21.00,0:04:25.00,Default,,0,0,0,,Әй, менің бір ісім бар.
Dialogue: 0,0:04:25.00,0:04:27.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:27.00,0:04:31.00,Default,,0,0,0,,Аа, мүмкін Изуми-кунға бірдеңе болатын шығар?
Dialogue: 0,0:04:31.00,0:04:34.00,Default,,0,0,0,,Бір нәрсе, I
Dialogue: 0,0:04:34.00,0:04:41.00,Default,,0,0,0,,Әрине, мен Кадзу-санға бұлай істеу туралы мүлде ойлаған емеспін.
Dialogue: 0,0:04:43.00,0:04:47.00,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:04:47.00,0:04:48.00,Default,,0,0,0,,Кадзу мырза?
Dialogue: 0,0:04:48.00,0:04:52.00,Default,,0,0,0,,Кешіріңіз, мен бірінші үйге барамын, кейін кездескенше.
Dialogue: 0,0:04:53.00,0:04:55.00,Default,,0,0,0,,Мен жаман нәрсе айттым ба?
Dialogue: 0,0:04:55.00,0:05:01.00,Default,,0,0,0,,Жарайды, ғашықтықпен ауыратындар оңайлықпен тынышталмайды.
Dialogue: 0,0:05:01.00,0:05:02.00,Default,,0,0,0,,Махаббат?
Dialogue: 0,0:05:06.00,0:05:10.00,Default,,0,0,0,,Сугавара мырза ғашық болды ма?
Dialogue: 0,0:05:11.00,0:05:16.00,Default,,0,0,0,,Мен ешқашан еркекке ғашық болған емеспін.
Dialogue: 0,0:05:16.00,0:05:27.00,Default,,0,0,0,,Сол себепті Кадзу-сан Изуми-кун өзіне ұнайтын адам үшін уайымдаса да, ол кеңес беру керек болса да, оған кеңес бере алмайды деп ойлайды.
Dialogue: 0,0:05:28.00,0:05:30.00,Default,,0,0,0,,Мен аздап көңілім қалды.
Dialogue: 0,0:05:32.00,0:05:34.00,Default,,0,0,0,,Мен сәттілік клубының жұмыс істеп жатқанына қуаныштымын.
Dialogue: 0,0:05:34.00,0:05:35.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:05:35.00,0:05:40.00,Default,,0,0,0,,Түрлі кітаптарға қол тигізсеңіз, түрлі сезімге ұшырайсыз.
Dialogue: 0,0:05:40.00,0:05:45.00,Default,,0,0,0,,Менің ойымша, бұл сіздің жеке сезіміңіз немесе егіннің сезімі болмаса да.
Dialogue: 0,0:05:45.00,0:05:48.00,Default,,0,0,0,,Дегенмен, Кадзу-санның күші Каримононың сезімімен шектеледі.
Dialogue: 0,0:05:48.00,0:05:52.00,Default,,0,0,0,,Сіздің Кадзу-санға көмектесуге деген ниетіңіз шынайы, солай емес пе?
Dialogue: 0,0:05:53.00,0:05:54.00,Default,,0,0,0,,Иә
Dialogue: 0,0:05:55.00,0:05:58.00,Default,,0,0,0,,Олай болса, қалғандары орынды болса, қарсы емеспін.
Dialogue: 0,0:05:59.00,0:06:01.00,Default,,0,0,0,,Нағыз маңызды сезімдерден басқа
Dialogue: 0,0:06:04.00,0:06:08.00,Default,,0,0,0,,Сугавара мырза әдемі.
Dialogue: 0,0:06:08.00,0:06:16.00,Default,,0,0,0,,Аа, шынымды айтсам, алғашында мен Сугавара мырзаны соншалықты сүйкімді деп ойладым, сондықтан оны қағып алу қиынға соғады.
Dialogue: 0,0:06:17.00,0:06:25.00,Default,,0,0,0,,Бірақ менің ол туралы алған әсерім өзгерді, ол әдемі, бірақ безендірілмеген, ол өз қарқынымен жұмыс істеуге қызық, мен оны жақынырақ білгім келеді.
Dialogue: 0,0:06:26.00,0:06:30.00,Default,,0,0,0,,Ол менің өмірімде кездестірген ең жақсы досым.
Dialogue: 0,0:06:31.00,0:06:32.00,Default,,0,0,0,,Момоко-чан мен Кадзу-сан
Dialogue: 0,0:06:35.00,0:06:37.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:37.00,0:06:38.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:39.00,0:06:40.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:47.00,0:06:49.00,Default,,0,0,0,,Оқушының үйге кететін уақыты болып қалды.
Dialogue: 0,0:06:50.00,0:06:53.00,Default,,0,0,0,,Мен Милоны, күшті баланы зерттедім.
Dialogue: 0,0:06:54.00,0:07:01.00,Default,,0,0,0,,Бұл сусын, ұнтақ, оның жарнамасы, менде де болды, шамасы.
Dialogue: 0,0:07:01.00,0:07:15.00,Default,,0,0,0,,Жарайды, мен күшті бала емеспін, сондықтан бала кезімде денем әлсіреп, ауруханаға жиі түсетінмін. Сол уақыт ішінде мен тек кітап оқып, өзімді қазіргіден де күшті деп елестететінмін.
Dialogue: 0,0:07:16.00,0:07:20.00,Default,,0,0,0,,немесе сол сияқты, бірақ олардың көпшілігі ересектердің қиялдары.
Dialogue: 0,0:07:21.00,0:07:22.00,Default,,0,0,0,,Жарайды, мен оны жоққа шығармаймын.
Dialogue: 0,0:07:23.00,0:07:29.00,Default,,0,0,0,,Жыныстық құштарлығы жоғары мұндай адасушы балаға орта мектепте мұғалім болу үлкен мәселе.
Dialogue: 0,0:07:29.00,0:07:34.00,Default,,0,0,0,,Ештеңе емес, жоғары сыныптағы қыздарға шатыр қозғалмайды, лас.
Dialogue: 0,0:07:35.00,0:07:37.00,Default,,0,0,0,,Жоғары сыныптағы қыздардың көпшілігінің терісі кедір-бұдыр болады.
Dialogue: 0,0:07:38.00,0:07:42.00,Default,,0,0,0,,Көгілдір жеміс жақсы естіледі, бірақ оның екіқабатты еті қатты көрінеді.
Dialogue: 0,0:07:43.00,0:07:48.00,Default,,0,0,0,,Ашылуы тым айқын және әдебиетте орын жоқ.
Dialogue: 0,0:07:49.00,0:07:52.00,Default,,0,0,0,,Бұл жаңа немесе тартымды болса, бұл жай ғана.
Dialogue: 0,0:07:52.00,0:07:58.00,Default,,0,0,0,,Егер сіз жоғары сыныптағы қыздарды соншалықты жек көретін болсаңыз, чат арқылы танысқан менімен кездескіңіз келеді дегенді қалай түсінесіз?
Dialogue: 0,0:07:59.00,0:08:01.00,Default,,0,0,0,,Адамдар мен адамдардың өрнектерінде ашылу сезімі жоқ.
Dialogue: 0,0:08:02.00,0:08:05.00,Default,,0,0,0,,Ол жыныстық қатынаста орта жастағы адам сияқты әрекет етеді, мен күткенім осы болды.
Dialogue: 0,0:08:06.00,0:08:11.00,Default,,0,0,0,,Бірақ бұл басқаша көрінеді, мен адамдардың шынайы болмысы туралы шынымен қызықтымын.
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,Менің жыныстық қатынасым нашар деп айтасыз ба?
Dialogue: 0,0:08:23.00,0:08:26.00,Default,,0,0,0,,Бұл әрекет күтілуде ме?
Dialogue: 0,0:08:27.00,0:08:31.00,Default,,0,0,0,,Жоқ, бұл күтпеген жағдай...
Dialogue: 0,0:08:41.00,0:08:44.00,Default,,0,0,0,,Не? Не? Не?
Dialogue: 0,0:08:44.00,0:08:46.00,Default,,0,0,0,,Не?
Dialogue: 0,0:08:47.00,0:08:53.00,Default,,0,0,0,,Тығыз... көп нәрсе бар... тығыз...
Dialogue: 0,0:09:01.00,0:09:03.00,Default,,0,0,0,,Аа, мен сені қазір шақырамын.
Dialogue: 0,0:09:04.00,0:09:05.00,Default,,0,0,0,,Қош бол
Dialogue: 0,0:09:05.00,0:09:06.00,Default,,0,0,0,,Қош бол
Dialogue: 0,0:09:14.00,0:09:18.00,Default,,0,0,0,,Маған балалардың қойылымдары әсер ететіні сөзсіз.
Dialogue: 0,0:09:19.00,0:09:21.00,Default,,0,0,0,,Олар ешқашан таза тіршілік иелері емес
Dialogue: 0,0:09:22.00,0:09:25.00,Default,,0,0,0,,Қақтығыстар, азаптар және жоспар құру
Dialogue: 0,0:09:26.00,0:09:31.00,Default,,0,0,0,,Бірақ олар иеленетін қараңғылықтың өзі таза реңкке ие.
Dialogue: 0,0:09:32.00,0:09:36.00,Default,,0,0,0,,Қара аязды шыны тәрізді мөлдір түс
Dialogue: 0,0:09:38.00,0:09:39.00,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:09:39.00,0:09:41.00,Default,,0,0,0,,Бүгінгі күннің бәрі осы. сынақ үшін
Dialogue: 0,0:09:44.00,0:09:47.00,Default,,0,0,0,,Эй, Судо-сан, осыдан кейін караокеге барғың келе ме?
Dialogue: 0,0:09:48.00,0:09:49.00,Default,,0,0,0,,Не, караоке?
Dialogue: 0,0:09:49.00,0:09:51.00,Default,,0,0,0,,Мен Судо мырзамен ойнағым келді.
Dialogue: 0,0:09:52.00,0:09:53.00,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:09:53.00,0:09:56.00,Default,,0,0,0,,Сугимото! Судо мырза караокеге барады!
Dialogue: 0,0:09:57.00,0:09:58.00,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:09:58.00,0:09:59.00,Default,,0,0,0,,Бұл сіздің сыйыңыз.
Dialogue: 0,0:09:59.00,0:10:01.00,Default,,0,0,0,,Сусын, премиум, барлық сипаттамалар
Dialogue: 0,0:10:01.00,0:10:02.00,Default,,0,0,0,,Сугимото да мұның бәрін жасамақшы.
Dialogue: 0,0:10:02.00,0:10:03.00,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:10:03.00,0:10:05.00,Default,,0,0,0,,Сугимото! Судо мырза караокеге барады!
Dialogue: 0,0:10:06.00,0:10:07.00,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:10:07.00,0:10:08.00,Default,,0,0,0,,Бұл сіздің сыйыңыз.
Dialogue: 0,0:10:08.00,0:10:09.00,Default,,0,0,0,,Мұның бәрі Сугимотоға тиесілі.
Dialogue: 0,0:10:13.00,0:10:16.00,Default,,0,0,0,,Мен Изуми менімен жыныстық қатынасқа түскісі келмейді деп ойлаймын.
Dialogue: 0,0:10:17.00,0:10:20.00,Default,,0,0,0,,Нашида-сан және басқалары бұл туралы ойланбағандарын айтты.
Dialogue: 0,0:10:21.00,0:10:24.00,Default,,0,0,0,,Бұл мені ұнатпайды дегенді білдіре ме?
Dialogue: 0,0:10:25.00,0:10:29.00,Default,,0,0,0,,Күте тұрыңыз, мен Изуми маған тентек көздерімен қарағанын қалаймын.
Dialogue: 0,0:10:31.00,0:10:33.00,Default,,0,0,0,,Енді ойланбайды, ойланбайды!
Dialogue: 0,0:10:34.00,0:10:36.00,Default,,0,0,0,,Оқыңыз! Оқып оқы!
Dialogue: 0,0:10:38.00,0:10:41.00,Default,,0,0,0,,Осыдан кейін неге өлгім келеді?
Dialogue: 0,0:10:42.00,0:10:45.00,Default,,0,0,0,,Мен түсіне алмаған сезімдер
Dialogue: 0,0:10:46.00,0:10:48.00,Default,,0,0,0,,Кітаптар атау береді
Dialogue: 0,0:10:49.00,0:10:51.00,Default,,0,0,0,,Кітаптарда аталған эмоциялар
Dialogue: 0,0:10:52.00,0:10:54.00,Default,,0,0,0,,Мен оны қайтадан өзіме қабылдағанда
Dialogue: 0,0:10:55.00,0:10:57.00,Default,,0,0,0,,Жаңа эмоциялар туады
Dialogue: 0,0:10:58.00,0:11:02.00,Default,,0,0,0,,Бұл өзіңізді тереңірек қазудың қуанышы.
Dialogue: 0,0:11:03.00,0:11:06.00,Default,,0,0,0,,Өзіңізге тереңірек үңіліңіз…
Dialogue: 0,0:11:08.00,0:11:11.00,Default,,0,0,0,,Иә, кітаптар тек қашу үшін ғана емес.
Dialogue: 0,0:11:12.00,0:11:17.00,Default,,0,0,0,,Мен түсінбейтін көмескі сезімдерге ат қою
Dialogue: 0,0:11:18.00,0:11:19.00,Default,,0,0,0,,Жаса!
Dialogue: 0,0:11:19.00,0:11:20.00,Default,,0,0,0,,Жаса!
Dialogue: 0,0:11:20.00,0:11:21.00,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:11:21.00,0:11:22.00,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:11:22.00,0:11:23.00,Default,,0,0,0,,Өлеңді неге қостың?
Dialogue: 0,0:11:23.00,0:11:24.00,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:11:24.00,0:11:25.00,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:11:25.00,0:11:27.00,Default,,0,0,0,,Әй, иә, бұл ән!
Dialogue: 0,0:11:28.00,0:11:31.00,Default,,0,0,0,,Сен тоқта, Миякояма тоқтады.
Dialogue: 0,0:11:32.00,0:11:33.00,Default,,0,0,0,,Біз сыртқа шығамыз ба?
Dialogue: 0,0:11:33.00,0:11:34.00,Default,,0,0,0,,О
Dialogue: 0,0:11:36.00,0:11:38.00,Default,,0,0,0,,Кешіріңіз, мен сізбен кездесе бастадым.
Dialogue: 0,0:11:39.00,0:11:41.00,Default,,0,0,0,,Қарсы болмасаңыз, басқа...
Dialogue: 0,0:11:41.00,0:11:44.00,Default,,0,0,0,,Мм, мен ондай нәрсеге жақсы емеспін.
Dialogue: 0,0:11:46.00,0:11:49.00,Default,,0,0,0,,Дұрыс, мен қате түсінген шығармын.
Dialogue: 0,0:11:50.00,0:11:51.00,Default,,0,0,0,,Бұл балалар жаман адамдар...
Dialogue: 0,0:11:51.00,0:11:53.00,Default,,0,0,0,,Менің жамандығым бұл емес.
Dialogue: 0,0:11:54.00,0:11:57.00,Default,,0,0,0,,Иә, әрине, бұл да солай.
Dialogue: 0,0:11:58.00,0:12:01.00,Default,,0,0,0,,Маған бәрі күдіктенеді.
Dialogue: 0,0:12:01.00,0:12:03.00,Default,,0,0,0,,Қате түсінсем кешіріңіз.
Dialogue: 0,0:12:04.00,0:12:09.00,Default,,0,0,0,,Бірақ мені ерлер мен әйелдерге қатысты нәрселер қызықтырады.
Dialogue: 0,0:12:09.00,0:12:11.00,Default,,0,0,0,,Мұндай нәрселер күтілсе де
Dialogue: 0,0:12:12.00,0:12:15.00,Default,,0,0,0,,Сәлем! Мен бұл туралы ойламаймын!
Dialogue: 0,0:12:15.00,0:12:17.00,Default,,0,0,0,,Бұл түсінбеушілік болды ғой!
Dialogue: 0,0:12:18.00,0:12:22.00,Default,,0,0,0,,Егер оны толығымен жоққа шығарса, басқаша болар еді.
Dialogue: 0,0:12:23.00,0:12:25.00,Default,,0,0,0,,Мені есіңе түсірмейсің бе?
Dialogue: 0,0:12:26.00,0:12:29.00,Default,,0,0,0,,Бала кезімде мен мектепті көп ауыстырдым.
Dialogue: 0,0:12:29.00,0:12:33.00,Default,,0,0,0,,Жаңа мектебімде достар таба аламын ба?
Dialogue: 0,0:12:33.00,0:12:35.00,Default,,0,0,0,,Мені соғып кете ме деп уайымдаған кезде
Dialogue: 0,0:12:36.00,0:12:38.00,Default,,0,0,0,,Судо мырза бір сыныпта оқитын.
Dialogue: 0,0:12:40.00,0:12:44.00,Default,,0,0,0,,Судо мырзаның достары көп болмады.
Dialogue: 0,0:12:44.00,0:12:47.00,Default,,0,0,0,,Бірақ мен өзімді жалғыз қалғанда жақсы сезінемін.
Dialogue: 0,0:12:48.00,0:12:53.00,Default,,0,0,0,,Төменгі сынып оқушысы сияқты, бірақ көзін жайып кітап оқып отыр.
Dialogue: 0,0:12:53.00,0:12:57.00,Default,,0,0,0,,Мен оны жетілген және салқын деп ойладым.
Dialogue: 0,0:13:00.00,0:13:02.00,Default,,0,0,0,,Мектептерді қайтадан ауыстырдым.
Dialogue: 0,0:13:03.00,0:13:07.00,Default,,0,0,0,,Кейде мен Судо-санды есіме түсіріп, әртүрлі нәрселерді ойладым.
Dialogue: 0,0:13:08.00,0:13:11.00,Default,,0,0,0,,Судо-сан сияқты мен де өзімдікі болғым келеді.
Dialogue: 0,0:13:12.00,0:13:13.00,Default,,0,0,0,,Сугимото-кун…
Dialogue: 0,0:13:14.00,0:13:16.00,Default,,0,0,0,,Дос болғым келетіні рас
Dialogue: 0,0:13:16.00,0:13:19.00,Default,,0,0,0,,Бірақ бұл ерлер мен әйелдер туралы емес.
Dialogue: 0,0:13:19.00,0:13:21.00,Default,,0,0,0,,LINE алмаспаңыз
Dialogue: 0,0:13:27.00,0:13:28.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:29.00,0:13:30.00,Default,,0,0,0,,Қаш
Dialogue: 0,0:13:34.00,0:13:38.00,Default,,0,0,0,,Бұл шын ба, нәпсі?
Dialogue: 0,0:13:40.00,0:13:47.00,Default,,0,0,0,,Сол кезде сіз өзіңіздің ішкі жамбасыңыздың қаншалықты сезімтал екенін түсінесіз.
Dialogue: 0,0:13:47.00,0:13:50.00,Default,,0,0,0,,Тоқта, адамдар бір арқан ба?
Dialogue: 0,0:13:51.00,0:13:54.00,Default,,0,0,0,,Әй, бұрын адам басқаша деп айтпадың ба?
Dialogue: 0,0:13:54.00,0:13:56.00,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:13:56.00,0:14:00.00,Default,,0,0,0,,Әйтеуір, бұрын телефон соғып, оқуды тастап кеткен жерімнен бастайық...
Dialogue: 0,0:14:04.00,0:14:07.00,Default,,0,0,0,,Бұл не тосын сый?
Dialogue: 0,0:14:07.00,0:14:10.00,Default,,0,0,0,,Өйткені, әйтеуір, бәрі тамаша.
Dialogue: 0,0:14:10.00,0:14:14.00,Default,,0,0,0,,Есіңде қалған сыныптасың қыздың мангасындай.
Dialogue: 0,0:14:14.00,0:14:19.00,Default,,0,0,0,,Жарайды, иә, қарап тұрғаныңызға қуаныштымын.
Dialogue: 0,0:14:19.00,0:14:21.00,Default,,0,0,0,,Бұл адам әдемі көрінеді.
Dialogue: 0,0:14:22.00,0:14:23.00,Default,,0,0,0,,Иә
Dialogue: 0,0:14:27.00,0:14:29.00,Default,,0,0,0,,Мен де Казуза сияқтымын.
Dialogue: 0,0:14:29.00,0:14:33.00,Default,,0,0,0,,Егер біреумен бірге болу керек болса
Dialogue: 0,0:14:33.00,0:14:35.00,Default,,0,0,0,,Өзіңізге ұнайтын адамның болғаны жақсы.
Dialogue: 0,0:14:35.00,0:14:37.00,Default,,0,0,0,,Ал, бұл...
Dialogue: 0,0:14:37.00,0:14:42.00,Default,,0,0,0,,Мен Сугимото-кунға ғашық боламын ба?
Dialogue: 0,0:14:42.00,0:14:46.00,Default,,0,0,0,,Сонда мұны істегіңіз келетін шығар?
Dialogue: 0,0:14:47.00,0:14:49.00,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:14:50.00,0:14:52.00,Default,,0,0,0,,Мен білмеймін, шынымен.
Dialogue: 0,0:14:53.00,0:14:55.00,Default,,0,0,0,,Әй, енді.
Dialogue: 0,0:14:56.00,0:14:58.00,Default,,0,0,0,,Сол кезде ағам айтты
Dialogue: 0,0:14:58.00,0:15:00.00,Default,,0,0,0,,Сугавара мырза да айтты
Dialogue: 0,0:15:00.00,0:15:01.00,Default,,0,0,0,,Иә
Dialogue: 0,0:15:04.00,0:15:08.00,Default,,0,0,0,,Ақыр соңында, сіз оны жазбайтын шығарсыз, солай ма?
Dialogue: 0,0:15:08.00,0:15:10.00,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:10.00,0:15:13.00,Default,,0,0,0,,Эй, сен менімен тамақтанғың келе ме?
Dialogue: 0,0:15:15.00,0:15:16.00,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:15:17.00,0:15:21.00,Default,,0,0,0,,Әй, бұл басқаларға көрсетуге ұялатын бенто шығар?
Dialogue: 0,0:15:21.00,0:15:25.00,Default,,0,0,0,,Уайымдама, қарашы, мен таңертең тым бос емес едім, котлет жеп қойдым...
Dialogue: 0,0:15:27.00,0:15:29.00,Default,,0,0,0,,Сатылған
Dialogue: 0,0:15:29.00,0:15:32.00,Default,,0,0,0,,Не, сен Осонесакиге жақындамақшысың ба?
Dialogue: 0,0:15:32.00,0:15:35.00,Default,,0,0,0,,Сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:15:35.00,0:15:38.00,Default,,0,0,0,,Түскі асыңызды алып келуіңіз ерекше емес пе?
Dialogue: 0,0:15:38.00,0:15:43.00,Default,,0,0,0,,Мен сол әтірдің иісімен тамақтансам, мен ештеңенің дәмін тата алмаймын.
Dialogue: 0,0:15:47.00,0:15:50.00,Default,,0,0,0,,Оны ашық көру сирек.
Dialogue: 0,0:15:56.00,0:15:57.00,Default,,0,0,0,,Осонесаки-сан
Dialogue: 0,0:16:06.00,0:16:08.00,Default,,0,0,0,,А, күте тұрыңыз, не?
Dialogue: 0,0:16:09.00,0:16:10.00,Default,,0,0,0,,Мен жаздым!
Dialogue: 0,0:16:26.00,0:16:29.00,Default,,0,0,0,,Осонесаки есеп беруімді сұрады.
Dialogue: 0,0:16:29.00,0:16:31.00,Default,,0,0,0,,Және 50 дана
Dialogue: 0,0:16:31.00,0:16:34.00,Default,,0,0,0,,Шынымды айтсам, мен жоғалып кеттім.
Dialogue: 0,0:16:34.00,0:16:37.00,Default,,0,0,0,,Ойланып отырып, шомылуға бел будым.
Dialogue: 0,0:16:37.00,0:16:41.00,Default,,0,0,0,,А, бұл еркектерге тән композиция.
Dialogue: 0,0:16:41.00,0:16:45.00,Default,,0,0,0,,Жазу қиын болған кезде әріптерді маңызды емес нәрселермен толтырамын.
Dialogue: 0,0:16:45.00,0:16:48.00,Default,,0,0,0,,Оның үстіне оның танымалдылықты көздегені де салқын дейді.
Dialogue: 0,0:16:48.00,0:16:51.00,Default,,0,0,0,,Әйтеуір, солай деп жазғанын көрдім.
Dialogue: 0,0:16:51.00,0:16:53.00,Default,,0,0,0,,Әлі де тақырып бар.
Dialogue: 0,0:16:53.00,0:16:56.00,Default,,0,0,0,,Жарайды, бұл жай ғана бірдеңе деп жазылғанын көрдім.
Dialogue: 0,0:16:56.00,0:16:58.00,Default,,0,0,0,,Мен әлі көп жазған жоқпын.
Dialogue: 0,0:16:58.00,0:17:01.00,Default,,0,0,0,,Осонесаки сүйкімді
Dialogue: 0,0:17:01.00,0:17:06.00,Default,,0,0,0,,Ол байсалды және қатал сияқты көрінеді, бірақ кейбір тұстары да бар.
Dialogue: 0,0:17:06.00,0:17:11.00,Default,,0,0,0,,Алайда оның сыртқы түрі туралы айтқанды ұнатпайтын сияқты.
Dialogue: 0,0:17:11.00,0:17:15.00,Default,,0,0,0,,Олай емес сияқты, сен солай айттың, ақымақ.
Dialogue: 0,0:17:15.00,0:17:18.00,Default,,0,0,0,,Егер адамға ұнамаса ше?
Dialogue: 0,0:17:18.00,0:17:23.00,Default,,0,0,0,,Күннің соңында Осонесаки сүйкімді.
Dialogue: 0,0:17:23.00,0:17:28.00,Default,,0,0,0,,Осы жерде мен Осонесаки-санға деген сезімімді білдіргім келеді.
Dialogue: 0,0:17:36.00,0:17:39.00,Default,,0,0,0,,Аа, мен анау-мынаудан бас тарттым.
Dialogue: 0,0:17:39.00,0:17:42.00,Default,,0,0,0,,Бұл жігіттің маған деген сезімі осы.
Dialogue: 0,0:17:42.00,0:17:47.00,Default,,0,0,0,,Осылай мен беттерді таптым, содан кейін мен Гесталмен құладым.
Dialogue: 0,0:17:47.00,0:17:50.00,Default,,0,0,0,,А, сен мұнда жасарып бара жатырсың ғой?
Dialogue: 0,0:17:50.00,0:17:53.00,Default,,0,0,0,,Бұл жерде сүйкімді болып барады.
Dialogue: 0,0:18:02.00,0:18:04.00,Default,,0,0,0,,Ол сүйкімді емес, ол сыпайы
Dialogue: 0,0:18:04.00,0:18:07.00,Default,,0,0,0,,Үлпілдек, тым батыл болма.
Dialogue: 0,0:18:07.00,0:18:09.00,Default,,0,0,0,,Құдайлар
Dialogue: 0,0:18:16.00,0:18:19.00,Default,,0,0,0,,Бұл не деген адам?
Dialogue: 0,0:18:19.00,0:18:24.00,Default,,0,0,0,,Маған лақтырылған реніш сөздер
Dialogue: 0,0:18:24.00,0:18:30.00,Default,,0,0,0,,Сүйкімділікті жаңбыр ақырындап шайып бара жатқандай.
Dialogue: 0,0:18:33.00,0:18:35.00,Default,,0,0,0,,Сонесакидің сүйкімділігі
Dialogue: 0,0:18:37.00,0:18:59.00,Default,,0,0,0,,Киз
Dialogue: 0,0:18:59.00,0:19:01.00,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:19:01.00,0:19:03.00,Default,,0,0,0,,Бұл банан шоколады емес, бұл шоколадты банан
Dialogue: 0,0:19:03.00,0:19:05.00,Default,,0,0,0,,Жоқ, екеуі де жақсы.
Dialogue: 0,0:19:05.00,0:19:07.00,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:19:07.00,0:19:09.00,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:19:09.00,0:19:11.00,Default,,0,0,0,,Мен оны басамын
Dialogue: 0,0:19:11.00,0:19:13.00,Default,,0,0,0,,Ах
Dialogue: 0,0:19:13.00,0:19:15.00,Default,,0,0,0,,Кешіріңіз, мен байқамадым.
Dialogue: 0,0:19:15.00,0:19:17.00,Default,,0,0,0,,Жоқ, ол лас
Dialogue: 0,0:19:17.00,0:19:19.00,Default,,0,0,0,,Жауап берейін
Dialogue: 0,0:19:19.00,0:19:21.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:21.00,0:19:23.00,Default,,0,0,0,,450 иен
Dialogue: 0,0:19:23.00,0:19:25.00,Default,,0,0,0,,Жазбалар мұны істей алмайды.
Dialogue: 0,0:19:25.00,0:19:27.00,Default,,0,0,0,,Ах
Dialogue: 0,0:19:27.00,0:19:29.00,Default,,0,0,0,,Мен әмияныңды алып келейін.
Dialogue: 0,0:19:31.00,0:19:33.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:33.00,0:19:35.00,Default,,0,0,0,,Норимото неге кешірім сұрайды?
Dialogue: 0,0:19:35.00,0:19:37.00,Default,,0,0,0,,Өйткені
Dialogue: 0,0:19:37.00,0:19:39.00,Default,,0,0,0,,Бұл шынымен де біртүрлі.
Dialogue: 0,0:19:39.00,0:19:41.00,Default,,0,0,0,,Сугавара-санға да солай.
Dialogue: 0,0:19:41.00,0:19:43.00,Default,,0,0,0,,Әрқашан тым сабырлы
Dialogue: 0,0:19:47.00,0:19:49.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:19:49.00,0:19:51.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:19:51.00,0:19:53.00,Default,,0,0,0,,Мүмкін мен жайбарақат ойланбай жүрген шығармын.
Dialogue: 0,0:19:53.00,0:19:55.00,Default,,0,0,0,,Мені тыңдағандарыңды қалаймын.
Dialogue: 0,0:19:57.00,0:19:59.00,Default,,0,0,0,,Сугавара мырза жоқ.
Dialogue: 0,0:19:59.00,0:20:01.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:07.00,0:20:09.00,Default,,0,0,0,,Бұл синхрондау дегеніміз не?
Dialogue: 0,0:20:09.00,0:20:11.00,Default,,0,0,0,,Кейбір тосынсыйлар бар.
Dialogue: 0,0:20:11.00,0:20:13.00,Default,,0,0,0,,Жоғары сынып оқушысы
Dialogue: 0,0:20:13.00,0:20:15.00,Default,,0,0,0,,Мен күткен вектордан басқа бағытта
Dialogue: 0,0:20:15.00,0:20:17.00,Default,,0,0,0,,Мен ақымақпын
Dialogue: 0,0:20:17.00,0:20:19.00,Default,,0,0,0,,Шынымен де ақымақ және ақымақ
Dialogue: 0,0:20:19.00,0:20:21.00,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:20:21.00,0:20:23.00,Default,,0,0,0,,Шынында да ақымақ және ақымақ
Dialogue: 0,0:20:23.00,0:20:25.00,Default,,0,0,0,,Бұл дөрекі.
Dialogue: 0,0:20:25.00,0:20:27.00,Default,,0,0,0,,"Бета" деп айтқаным үшін кешіріңіз
Dialogue: 0,0:20:27.00,0:20:29.00,Default,,0,0,0,,Түбірде бар ма деп ойлаймын
Dialogue: 0,0:20:29.00,0:20:31.00,Default,,0,0,0,,Мен сізге ерейін деп едім.
Dialogue: 0,0:20:31.00,0:20:33.00,Default,,0,0,0,,Мен шынымды айтайын.
Dialogue: 0,0:20:33.00,0:20:35.00,Default,,0,0,0,,Алғаш рет ыстық болу деген нені білдіреді?
Dialogue: 0,0:20:35.00,0:20:37.00,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:20:39.00,0:20:41.00,Default,,0,0,0,,Енді сіз ренжідіңіз.
Dialogue: 0,0:20:41.00,0:20:43.00,Default,,0,0,0,,Өйткені бұл кенеттен болды
Dialogue: 0,0:20:43.00,0:20:45.00,Default,,0,0,0,,Менің сөзім ақсақ болғаны қиын емес пе?
Dialogue: 0,0:20:47.00,0:20:49.00,Default,,0,0,0,,Қазіргісі қатты емес еді, сондықтан
Dialogue: 0,0:20:49.00,0:20:51.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:57.00,0:20:59.00,Default,,0,0,0,,Протектор мырза
Dialogue: 0,0:20:59.00,0:21:01.00,Default,,0,0,0,,Майло мырза, өтінемін.
Dialogue: 0,0:21:01.00,0:21:03.00,Default,,0,0,0,,Маған
Dialogue: 0,0:21:03.00,0:21:05.00,Default,,0,0,0,,Маған шындықты айтып беріңізші
Dialogue: 0,0:21:07.00,0:21:09.00,Default,,0,0,0,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:21:09.00,0:21:11.00,Default,,0,0,0,,Бұзық адамдар бар кітаптардың дене күші бар
Dialogue: 0,0:21:11.00,0:21:13.00,Default,,0,0,0,,Сіз оны ала аласыз.
Dialogue: 0,0:21:13.00,0:21:15.00,Default,,0,0,0,,Алып кеткен
Dialogue: 0,0:21:15.00,0:21:17.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:17.00,0:21:19.00,Default,,0,0,0,,Осы түсініксіз атқа ат қойыңыз
Dialogue: 0,0:21:19.00,0:21:21.00,Default,,0,0,0,,Мен оны кигім келді.
Dialogue: 0,0:21:21.00,0:21:23.00,Default,,0,0,0,,Мен бұл туралы көбірек ойлаған сайын, мен секс пен махаббат туралы көбірек ойлаймын.
Dialogue: 0,0:21:23.00,0:21:25.00,Default,,0,0,0,,Бөлінбейтін болу
Dialogue: 0,0:21:25.00,0:21:27.00,Default,,0,0,0,,Мен өзімді сезінемін
Dialogue: 0,0:21:39.00,0:21:41.00,Default,,0,0,0,,Өлім алдында не істегім келеді
Dialogue: 0,0:21:41.00,0:21:43.00,Default,,0,0,0,,Жыныс
Dialogue: 0,0:21:47.00,0:21:49.00,Default,,0,0,0,,Кадзу-сан не болды?
Dialogue: 0,0:22:11.00,0:22:13.00,Default,,0,0,0,,Жақсы қыз бол және барынша тырыс, жарай ма?
Dialogue: 0,0:22:13.00,0:22:15.00,Default,,0,0,0,,Үйрет бізге.
Dialogue: 0,0:22:15.00,0:22:17.00,Default,,0,0,0,,Ересектер
Dialogue: 0,0:22:17.00,0:22:19.00,Default,,0,0,0,,Мен ащы заттарды жақсы көремін
Dialogue: 0,0:22:19.00,0:22:21.00,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:22:21.00,0:22:23.00,Default,,0,0,0,,Аах! Күртеме—дәлел!
Dialogue: 0,0:22:23.00,0:22:25.00,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:22:25.00,0:22:27.00,Default,,0,0,0,,Мен сенімді емеспін
Dialogue: 0,0:22:27.00,0:22:29.00,Default,,0,0,0,,10 жылдан кейін өзіңізге арналған бейне
Dialogue: 0,0:22:29.00,0:22:31.00,Default,,0,0,0,,Мен суретке түсіріп көрдім.
Dialogue: 0,0:22:31.00,0:22:33.00,Default,,0,0,0,,Бірден жойылды
Dialogue: 0,0:22:33.00,0:22:35.00,Default,,0,0,0,,Бар болғаны бір апта - мен істей алатын ең жақсысы
Dialogue: 0,0:22:35.00,0:22:37.00,Default,,0,0,0,,Күнтізбе
Dialogue: 0,0:22:37.00,0:22:39.00,Default,,0,0,0,,Оны толтырып, көңіл көтеріңіз
Dialogue: 0,0:22:39.00,0:22:41.00,Default,,0,0,0,,Терең себеп
Dialogue: 0,0:22:41.00,0:22:43.00,Default,,0,0,0,,Ғашық
Dialogue: 0,0:22:43.00,0:22:45.00,Default,,0,0,0,,Ересек адам сияқты әрекет ету
Dialogue: 0,0:22:45.00,0:22:47.00,Default,,0,0,0,,Золушка
Dialogue: 0,0:22:47.00,0:22:49.00,Default,,0,0,0,,Жақында «Сакура Саку» орындалды деген хабар келеді.
Dialogue: 0,0:22:49.00,0:22:51.00,Default,,0,0,0,,тар
Dialogue: 0,0:22:51.00,0:22:53.00,Default,,0,0,0,,шыны тәпішке
Dialogue: 0,0:22:53.00,0:22:55.00,Default,,0,0,0,,шешінді
Dialogue: 0,0:22:55.00,0:22:57.00,Default,,0,0,0,,Арқаңызды созуды тоқтатыңыз
Dialogue: 0,0:22:57.00,0:22:59.00,Default,,0,0,0,,Жақын жерде
Dialogue: 0,0:22:59.00,0:23:01.00,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:23:01.00,0:23:03.00,Default,,0,0,0,,Табылды
Dialogue: 0,0:23:03.00,0:23:05.00,Default,,0,0,0,,Арқаңызды созуды тоқтатыңыз
Dialogue: 0,0:23:05.00,0:23:07.00,Default,,0,0,0,,Демалу
Dialogue: 0,0:23:07.00,0:23:09.00,Default,,0,0,0,,(♪ «Діез минор, Op. 8 № 12 этюді»)
Dialogue: 0,0:23:11.00,0:23:13.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:23:13.00,0:23:15.00,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:23:15.00,0:23:17.00,Default,,0,0,0,,Мен қазір
Dialogue: 0,0:23:19.00,0:23:21.00,Default,,0,0,0,,Ахтто
Dialogue: 0,0:23:21.00,0:23:23.00,Default,,0,0,0,,Армандағы арман
Dialogue: 0,0:23:23.00,0:23:25.00,Default,,0,0,0,,Қадірлеу
Dialogue: 0,0:23:27.00,0:23:29.00,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:23:29.00,0:23:31.00,Default,,0,0,0,,Мен енді білемін
Dialogue: 0,0:23:33.00,0:23:35.00,Default,,0,0,0,,Мен сені қатты қалаймын
Dialogue: 0,0:23:35.00,0:23:37.00,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:23:37.00,0:23:39.00,Default,,0,0,0,,Сіз мені қаламайсыз
Dialogue: 0,0:23:39.00,0:23:41.00,Default,,0,0,0,,Сіз мұны жоғары сынып оқушыларымен жасай аласыз.
Dialogue: 0,0:23:41.00,0:23:43.00,Default,,0,0,0,,Қыздарға беретін нәрсе.
Dialogue: 0,0:23:43.00,0:23:45.00,Default,,0,0,0,,Мен туралы не ойлайсың?
Dialogue: 0,0:23:45.00,0:23:47.00,Default,,0,0,0,,Өйткені мен тек қателіктер туралы ойлаймын
Dialogue: 0,0:23:47.00,0:23:49.00,Default,,0,0,0,,Ол бәрін бір-бірімен байланыстырады.
Dialogue: 0,0:23:49.00,0:23:51.00,Default,,0,0,0,,Газ да қиналып жатыр.
Dialogue: 0,0:23:51.00,0:23:53.00,Default,,0,0,0,,Мен ұсыныс жасай аламын ба?
Dialogue: 0,0:23:53.00,0:23:55.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:23:55.00,0:23:57.00,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:24:03.00,0:24:05.00,Default,,0,0,0,,Қарағаныңызға рахмет
Dialogue: 0,0:24:33.00,0:24:35.00,Default,,0,0,0,,Қарағаныңызға рахмет
Dialogue: 0,0:24:36.50,0:24:42.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
