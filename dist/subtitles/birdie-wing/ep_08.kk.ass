Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.30,0:00:06.30,Default,,0,0,0,,《(Галерея қошеметі)》
Dialogue: 0,0:00:06.30,0:00:09.30,Default,,0,0,0,,《Уау! 》
Dialogue: 0,0:00:09.30,0:00:16.98,Default,,0,0,0,,♬～
Dialogue: 0,0:00:16.98,0:00:18.98,Default,,0,0,0,,《Мені ештеңе таң қалдырмайды》
Dialogue: 0,0:00:18.98,0:00:21.98,Default,,0,0,0,,《Мен мұндай болатынын білдім》
Dialogue: 0,0:00:23.65,0:00:25.65,Default,,0,0,0,,《Тез ақшаны қалау➡
Dialogue: 0,0:00:25.65,0:00:28.06,Default,,0,0,0,,Күн сәулесі түскен жерді тастап кеткен сенсің.
Dialogue: 0,0:00:28.99,0:00:32.59,Default,,0,0,0,,《Жасырын ойында ұтылып, сыйлығын алған сен болдың.》
Dialogue: 0,0:00:33.66,0:00:38.00,Default,,0,0,0,,《Сенде мен шыңдаған талант бар➡
Dialogue: 0,0:00:38.00,0:00:41.00,Default,,0,0,0,,Өз қолымен езілген》
Dialogue: 0,0:00:41.00,0:00:45.01,Default,,0,0,0,,《Мен саған жұмсаған уақытымды қайтарғаныңды қалаймын.》
Dialogue: 0,0:00:46.01,0:00:48.68,Default,,0,0,0,,《Роза, менде сенімен бар болғаны осы》
Dialogue: 0,0:00:48.68,0:00:52.68,Default,,0,0,0,,《Бақытқа орай, менің көз алдымда басқа адамдар бар.》
Dialogue: 0,0:00:52.68,0:00:56.02,Default,,0,0,0,,《Мен өзімді сол адамды тәрбиелеуге арнаймын》
Dialogue: 0,0:00:56.02,0:00:58.69,Default,,0,0,0,,《Бұл кім? Бұл 》
Dialogue: 0,0:00:58.69,0:01:01.62,Default,,0,0,0,,《Білудің қажеті жоқ》
Dialogue: 0,0:01:01.62,0:01:05.63,Default,,0,0,0,,《Шынымен сен ақымақ әйелсің》
Dialogue: 0,0:01:07.96,0:01:12.97,Default,,0,0,0,,《(Розаның жылағаны)》
Dialogue: 0,0:01:17.97,0:01:19.98,Default,,0,0,0,,(Розаның айқайы)
Dialogue: 0,0:01:21.98,0:01:23.98,Default,,0,0,0,,(Хауа ананың ентігу дыбысы)
Dialogue: 0,0:01:26.98,0:01:29.99,Default,,0,0,0,,Анау... сол қол...
Dialogue: 0,0:01:29.99,0:01:33.32,Default,,0,0,0,,Протездік қол? Протездік қолмен гольф ойнайсыз ба?
Dialogue: 0,0:01:33.32,0:01:36.63,Default,,0,0,0,,А... Мен онша таң қалған жоқпын.
Dialogue: 0,0:01:37.66,0:01:41.33,Default,,0,0,0,,Бұл жер астында өмір сүру үшін төлейтін баға.
Dialogue: 0,0:01:41.33,0:01:45.00,Default,,0,0,0,,Енді жалғастырайық.
Dialogue: 0,0:01:45.00,0:01:48.60,Default,,0,0,0,,Мен әлі ештеңе жоғалтқан жоқпын.
Dialogue: 0,0:01:52.34,0:02:12.29,Default,,0,0,0,,♬～
Dialogue: 0,0:02:12.29,0:02:32.31,Default,,0,0,0,,♬～
Dialogue: 0,0:02:32.31,0:02:52.33,Default,,0,0,0,,♬～
Dialogue: 0,0:02:52.33,0:03:12.29,Default,,0,0,0,,♬～
Dialogue: 0,0:03:12.29,0:03:20.96,Default,,0,0,0,,♬～
Dialogue: 0,0:03:32.94,0:03:36.61,Default,,0,0,0,,Бас тарту! Бас тарту! Розаның қолы солай болып қалды➡
Dialogue: 0,0:03:36.61,0:03:38.95,Default,,0,0,0,,Мен күресті жалғастыра алмаймын.
Dialogue: 0,0:03:38.95,0:03:41.28,Default,,0,0,0,,Бұл басқаша айтады.
Dialogue: 0,0:03:41.28,0:03:43.62,Default,,0,0,0,,Біз шешілмейінше күресуді тоқтатпаймыз➡\NЕреже
Dialogue: 0,0:03:43.62,0:03:45.95,Default,,0,0,0,,болуы керек емес пе?
Dialogue: 0,0:03:45.95,0:03:47.96,Default,,0,0,0,,Сонымен... онда➡
Dialogue: 0,0:03:47.96,0:03:50.23,Default,,0,0,0,,Роуздың протездік қолы жөнделгенше матч тоқтатылды...
Dialogue: 0,0:03:50.23,0:03:52.23,Default,,0,0,0,,Бұл кеңес беру мүмкін емес.
Dialogue: 0,0:03:52.23,0:03:55.23,Default,,0,0,0,,Сәйкестік жалғасуда
Dialogue: 0,0:03:55.23,0:03:57.90,Default,,0,0,0,,Эй... Ханым, жақсысың ба?
Dialogue: 0,0:03:57.90,0:04:00.90,Default,,0,0,0,,Үндетпе, протез қолым сынған ғой.
Dialogue: 0,0:04:00.90,0:04:02.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:02.90,0:04:04.91,Default,,0,0,0,,Сенің сонша жылдам ұшқан себебің➡
Dialogue: 0,0:04:04.91,0:04:06.91,Default,,0,0,0,,Мен түсіндім.\NҚайырлы таң,
Dialogue: 0,0:04:06.91,0:04:09.91,Default,,0,0,0,,Мен білегіме салмақ түсіретін үздіксіз толық кадрларды жасай алдым➡
Dialogue: 0,0:04:09.91,0:04:13.58,Default,,0,0,0,,Өйткені протездік қол соққыны сіңіре алды.
Dialogue: 0,0:04:13.58,0:04:15.58,Default,,0,0,0,,Бұл үлкен қулық ➡
Dialogue: 0,0:04:15.58,0:04:18.92,Default,,0,0,0,,Әлгі протездік қол ауыртпалыққа шыдай алмай, сынып қалды.
Dialogue: 0,0:04:18.92,0:04:21.26,Default,,0,0,0,,Сіз үшін бәрі аяқталды.
Dialogue: 0,0:04:21.26,0:04:23.93,Default,,0,0,0,,Еваны бір қолмен жеңуге мүмкіндік жоқ... әлі.
Dialogue: 0,0:04:23.93,0:04:25.93,Default,,0,0,0,,Көздер әлі өлген жоқ
Dialogue: 0,0:04:25.93,0:04:27.93,Default,,0,0,0,,Менің де жүрегім жаралы емес.
Dialogue: 0,0:04:27.93,0:04:29.93,Default,,0,0,0,,Иә
Dialogue: 0,0:04:29.93,0:04:32.93,Default,,0,0,0,,Жалыным әлсіреген жоқ.
Dialogue: 0,0:04:32.93,0:04:36.27,Default,,0,0,0,,Содан кейін тек оқ атуды жалғастырыңыз
Dialogue: 0,0:04:36.27,0:04:38.61,Default,,0,0,0,,Сіз құлағанша
Dialogue: 0,0:04:38.61,0:04:43.61,Default,,0,0,0,,Оған дейін мен оны өртеп жіберемін.
Dialogue: 0,0:04:49.62,0:04:52.22,Default,,0,0,0,,Ол жігіттер үздіксіз құрылыспен айналысады.
Dialogue: 0,0:04:52.22,0:04:54.89,Default,,0,0,0,,Демалыңыз! Шын айтасың ба?
Dialogue: 0,0:04:54.89,0:04:56.89,Default,,0,0,0,,Әпке, осылайша➡
Dialogue: 0,0:04:56.89,0:04:59.90,Default,,0,0,0,,Бұл учаскедегі құрылыс жұмыстары түнде басталады.
Dialogue: 0,0:04:59.90,0:05:01.90,Default,,0,0,0,,Оған дейін мен бір жерге қашуым керек.
Dialogue: 0,0:05:03.23,0:05:05.23,Default,,0,0,0,,Роза мырза айтты, солай ма?
Dialogue: 0,0:05:05.23,0:05:08.24,Default,,0,0,0,,«Хауа қайтып келгенше осында күтіңіз».
Dialogue: 0,0:05:08.24,0:05:10.91,Default,,0,0,0,,Бірақ мен сізбен мүлдем хабарласа алмаймын➡
Dialogue: 0,0:05:10.91,0:05:12.91,Default,,0,0,0,,Егер Хауа қайтып келмесе...
Dialogue: 0,0:05:12.91,0:05:16.24,Default,,0,0,0,,Мен қайтамын, маған сеніңіз.
Dialogue: 0,0:05:16.24,0:05:18.25,Default,,0,0,0,,Хауа...
Dialogue: 0,0:05:19.92,0:05:24.25,Default,,0,0,0,,Қарсыласыңыз мүгедек болғандықтан ғана бұрыштарды кесуге тырыспаңыз.
Dialogue: 0,0:05:24.25,0:05:26.25,Default,,0,0,0,,Жоқ немесе мүмкін емес
Dialogue: 0,0:05:26.25,0:05:30.26,Default,,0,0,0,,Өйткені мен жарақат алудың ең қорқыныштысы екенін білемін.
Dialogue: 0,0:05:31.26,0:05:34.93,Default,,0,0,0,,<Бар күшіммен оқпен жеңілетініме сене алмаймын>
Dialogue: 0,0:05:34.93,0:05:38.93,Default,,0,0,0,,《Бақытқа орай, менің көз алдымда басқа адамдар бар.》
Dialogue: 0,0:05:38.93,0:05:42.27,Default,,0,0,0,,《Мен өзімді сол адамды тәрбиелеуге арнаймын》
Dialogue: 0,0:05:42.27,0:05:44.27,Default,,0,0,0,,<Ева>
Dialogue: 0,0:05:44.27,0:05:49.28,Default,,0,0,0,,♬～
Dialogue: 0,0:05:49.28,0:05:51.21,Default,,0,0,0,,《Сіз бе?》
Dialogue: 0,0:05:51.21,0:05:53.22,Default,,0,0,0,,《Кім?》
Dialogue: 0,0:05:53.22,0:05:55.88,Default,,0,0,0,,《Мені танымайтын ақымақ болуың керек》
Dialogue: 0,0:05:55.88,0:05:57.89,Default,,0,0,0,,《Егер сіз бәс тігуге арналған гольф ойнағыңыз келсе➡
Dialogue: 0,0:05:57.89,0:06:00.19,Default,,0,0,0,,Маған бірнеше сөз айтыңыз.
Dialogue: 0,0:06:01.22,0:06:03.56,Default,,0,0,0,,《Қорғау ақшасын жинауға келдің бе? 》
Dialogue: 0,0:06:03.56,0:06:05.56,Default,,0,0,0,,《Оны басып көріңіз》
Dialogue: 0,0:06:06.90,0:06:09.50,Default,,0,0,0,,《Жүргізушімен бірге барыңыз》
Dialogue: 0,0:06:12.23,0:06:16.24,Default,,0,0,0,,《Тікелей Blue Bullet соққысы! 》
Dialogue: 0,0:06:16.24,0:06:25.58,Default,,0,0,0,,♬～
Dialogue: 0,0:06:25.58,0:06:27.58,Default,,0,0,0,,《Мен соқтым ба? 》
Dialogue: 0,0:06:27.58,0:06:31.25,Default,,0,0,0,,《Бұл туралы》 《Не? 》
Dialogue: 0,0:06:31.25,0:06:33.26,Default,,0,0,0,,《Оны менің астыма қойыңыз》
Dialogue: 0,0:06:33.26,0:06:36.93,Default,,0,0,0,,《Онда мен үлкенірек сомамен бәс тігу матчын орнатамын》
Dialogue: 0,0:06:36.93,0:06:38.93,Default,,0,0,0,,《Мафияның қол астында жұмыс істеме》
Dialogue: 0,0:06:38.93,0:06:40.93,Default,,0,0,0,,《«Мен барсам, бұл соңы»➡
Dialogue: 0,0:06:40.93,0:06:43.27,Default,,0,0,0,,Себебі әпкемнің аузында қышқыл дәм бар》
Dialogue: 0,0:06:43.27,0:06:47.57,Default,,0,0,0,,《Жарайды, не қаласаң, соны істе》
Dialogue: 0,0:06:51.21,0:06:53.88,Default,,0,0,0,,<Менен қашық болған сен едің➡
Dialogue: 0,0:06:53.88,0:06:56.88,Default,,0,0,0,,Кенет кабинетке келді＞
Dialogue: 0,0:06:56.88,0:07:01.48,Default,,0,0,0,,<Сол жапондық Аои мен Амавашимен күресу>
Dialogue: 0,0:07:02.55,0:07:05.22,Default,,0,0,0,,《Бұл сахнаның артында өмір сүретін заңсыз тіршілік》
Dialogue: 0,0:07:05.22,0:07:07.22,Default,,0,0,0,,《Ол күн сәулесінің астында жүреді➡
Dialogue: 0,0:07:07.22,0:07:09.22,Default,,0,0,0,,Гакчитачи жоқ Катаги➡
Dialogue: 0,0:07:09.22,0:07:11.56,Default,,0,0,0,,Сонымен қатар, ол өте атақты》
Dialogue: 0,0:07:11.56,0:07:13.90,Default,,0,0,0,,《Бір сәтке де кездескеніміз керемет...》
Dialogue: 0,0:07:13.90,0:07:16.56,Default,,0,0,0,,《Мен мұндай жазбаны есту үшін келген жоқпын.》
Dialogue: 0,0:07:16.56,0:07:19.57,Default,,0,0,0,,《Сіз шынымен осы жапондармен соғысқыңыз келе ме? 》
Dialogue: 0,0:07:19.57,0:07:21.90,Default,,0,0,0,,《Неге? 》
Dialogue: 0,0:07:21.90,0:07:25.24,Default,,0,0,0,,《Себебі мұны істеу мағынасы бар》
Dialogue: 0,0:07:25.24,0:07:27.24,Default,,0,0,0,,<Мен сенімдімін>
Dialogue: 0,0:07:27.24,0:07:29.95,Default,,0,0,0,,<Сіз жер бетіндегі әлемге барасыз>
Dialogue: 0,0:07:30.91,0:07:34.25,Default,,0,0,0,,<Сен маған қарағанда басқа жолмен келе жатырсың>
Dialogue: 0,0:07:34.25,0:07:36.92,Default,,0,0,0,,<Олай болса жақсы>
Dialogue: 0,0:07:36.92,0:07:41.26,Default,,0,0,0,,<Мен тіпті сенің мына сұмдық қаладан кетуіңді де дайындадым>
Dialogue: 0,0:07:41.26,0:07:43.26,Default,,0,0,0,,<Бірақ...>
Dialogue: 0,0:07:43.26,0:07:47.26,Default,,0,0,0,,<Мен сенің қабілетіңді әлі де танымаймын>
Dialogue: 0,0:07:47.26,0:07:52.20,Default,,0,0,0,,<Жер бетіндегі әлемде аман қалу үшін сансыз нәрселер жетіспейді.>
Dialogue: 0,0:07:52.20,0:07:56.54,Default,,0,0,0,,<Сондықтан, сен менен асып түсетініңді көрсет>
Dialogue: 0,0:07:56.54,0:07:59.87,Default,,0,0,0,,<Менің жалыным әлі сөнген жоқ>
Dialogue: 0,0:07:59.87,0:08:02.54,Default,,0,0,0,,<Кел, өртенсін>
Dialogue: 0,0:08:02.54,0:08:07.88,Default,,0,0,0,,<Қызыл Роуз Барретт! ＞
Dialogue: 0,0:08:07.88,0:08:19.89,Default,,0,0,0,,♬～
Dialogue: 0,0:08:19.89,0:08:24.23,Default,,0,0,0,,Сіз бір қолыңызбен соншалықты алыс ұша аласыз...
Dialogue: 0,0:08:24.23,0:08:28.57,Default,,0,0,0,,Айттым ғой, менің жоғалтатын ештеңем жоқ.
Dialogue: 0,0:08:28.57,0:08:31.91,Default,,0,0,0,,түйреуішке 140 ярд қалды
Dialogue: 0,0:08:31.91,0:08:36.21,Default,,0,0,0,,Бұл мен үшін ең жақсы қашықтық.
Dialogue: 0,0:08:37.25,0:08:40.58,Default,,0,0,0,,Негізі жарақат алу қорқынышты.
Dialogue: 0,0:08:40.58,0:08:43.25,Default,,0,0,0,,Допты соққыға тигендегідей кесіңіз➡
Dialogue: 0,0:08:43.25,0:08:45.25,Default,,0,0,0,,Сіз оны 3 ағашпен ұра аласыз ба?
Dialogue: 0,0:08:45.25,0:08:47.92,Default,,0,0,0,,Мен допты тек жүргізушімен соққанмын.
Dialogue: 0,0:08:47.92,0:08:53.19,Default,,0,0,0,,Содан кейін тікелей орманның сол жағын көздеңіз.
Dialogue: 0,0:08:53.19,0:08:55.20,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:55.20,0:08:59.20,Default,,0,0,0,,<Барлығы Лили апа>
Dialogue: 0,0:09:00.20,0:09:02.20,Default,,0,0,0,,<Кішкене күтіңіз>
Dialogue: 0,0:09:03.20,0:09:07.54,Default,,0,0,0,,<Тікелей көк оқ тиді! ＞
Dialogue: 0,0:09:07.54,0:09:19.89,Default,,0,0,0,,♬～
Dialogue: 0,0:09:19.89,0:09:22.56,Default,,0,0,0,,<Себебі мен міндетті түрде жеңіспен ораламын>
Dialogue: 0,0:09:22.56,0:09:25.23,Default,,0,0,0,,117 ярд қалды ма?
Dialogue: 0,0:09:25.23,0:09:28.23,Default,,0,0,0,,Бұл саңылау сызбаға айналса да➡
Dialogue: 0,0:09:28.23,0:09:30.23,Default,,0,0,0,,Біздің артықшылығымыз абсолютті.
Dialogue: 0,0:09:30.23,0:09:32.23,Default,,0,0,0,,Жеңіс мызғымас
Dialogue: 0,0:09:32.23,0:09:34.24,Default,,0,0,0,,Мерекеге дайындық
Dialogue: 0,0:09:34.24,0:09:36.57,Default,,0,0,0,,<140 ярд қалды>
Dialogue: 0,0:09:36.57,0:09:39.57,Default,,0,0,0,,<Әдейі алыстап кеттің, Роза>
Dialogue: 0,0:09:39.57,0:09:43.28,Default,,0,0,0,,<Ең жақсы қашықтыққа реттеу үшін>
Dialogue: 0,0:09:44.58,0:09:47.92,Default,,0,0,0,,Апа, өтінемін, мен сізге сенемін.
Dialogue: 0,0:09:47.92,0:09:50.25,Default,,0,0,0,,Анри, мұқият қара.
Dialogue: 0,0:09:50.25,0:09:53.92,Default,,0,0,0,,Бұл менің соңғы түсіргенім шығар.
Dialogue: 0,0:09:53.92,0:09:55.92,Default,,0,0,0,,Әпке...
Dialogue: 0,0:09:55.92,0:09:58.93,Default,,0,0,0,,А... бұл сенің жеңдің деген сөз.
Dialogue: 0,0:10:00.60,0:10:02.60,Default,,0,0,0,,<Оң қолымнан айырылған соң...>
Dialogue: 0,0:10:02.60,0:10:06.27,Default,,0,0,0,,<Жоқ, Хауа, мен сені кездестіргеннен бері➡
Dialogue: 0,0:10:06.27,0:10:08.27,Default,,0,0,0,,Бұл туралы көп ойланыңыз＞
Dialogue: 0,0:10:08.27,0:10:13.27,Default,,0,0,0,,<Егер мен жер бетіндегі әлемге кетсем, маған не болар еді?>
Dialogue: 0,0:10:13.27,0:10:15.28,Default,,0,0,0,,<Сұрамаңыз>
Dialogue: 0,0:10:15.28,0:10:18.61,Default,,0,0,0,,<Бірақ енді сіз растай аласыз>
Dialogue: 0,0:10:18.61,0:10:21.95,Default,,0,0,0,,<Мен жер бетіндегі әлемге барамын. Егер мен сені жеңсем➡
Dialogue: 0,0:10:21.95,0:10:25.25,Default,,0,0,0,,Мен осы уақытқа дейін өміріме өкіне аламын＞
Dialogue: 0,0:10:26.96,0:10:32.63,Default,,0,0,0,,<Бұл Роуз Ареонның... жоқ, менің гольф өмірім➡
Dialogue: 0,0:10:32.63,0:10:34.63,Default,,0,0,0,,Соңғы түсірілім＞
Dialogue: 0,0:10:34.63,0:10:39.63,Default,,0,0,0,,<Қызыл Роуз Барретт! ＞
Dialogue: 0,0:10:42.64,0:10:45.64,Default,,0,0,0,,Осы соңғы минутта мен тамаша соққы жасадым...
Dialogue: 0,0:10:45.64,0:10:47.64,Default,,0,0,0,,Мен қатыстым.
Dialogue: 0,0:10:47.64,0:10:49.64,Default,,0,0,0,,Істікке
Dialogue: 0,0:10:51.58,0:10:53.98,Default,,0,0,0,,Жүр! Бар!
Dialogue: 0,0:10:56.25,0:10:59.25,Default,,0,0,0,,Тек қалыңыз!
Dialogue: 0,0:10:59.25,0:11:01.92,Default,,0,0,0,,Ах... Үлкен аға... Ақымақ.
Dialogue: 0,0:11:01.92,0:11:04.53,Default,,0,0,0,,Өте ақымақ!
Dialogue: 0,0:11:06.59,0:11:09.93,Default,,0,0,0,,Оны салыңыз! Ішке кір!
Dialogue: 0,0:11:09.93,0:11:12.60,Default,,0,0,0,,Оны салыңыз!
Dialogue: 0,0:11:12.60,0:11:19.27,Default,,0,0,0,,♬～
Dialogue: 0,0:11:19.27,0:11:21.94,Default,,0,0,0,,Қандай ұят!
Dialogue: 0,0:11:21.94,0:11:25.95,Default,,0,0,0,,Алайда, керісінше, сізге қысым болды.
Dialogue: 0,0:11:25.95,0:11:31.95,Default,,0,0,0,,Иә, менің тарапымнан бір қате атылып, жеңіс екінші жаққа ауды.
Dialogue: 0,0:11:33.29,0:11:35.62,Default,,0,0,0,,Бұл саңылау ұтыс болып табылады.
Dialogue: 0,0:11:35.62,0:11:37.63,Default,,0,0,0,,Жасыл жерге міндетті түрде көз жеткізіңіз...
Dialogue: 0,0:11:37.63,0:11:39.96,Default,,0,0,0,,PW Оны шығарыңыз, иә?
Dialogue: 0,0:11:39.96,0:11:42.63,Default,,0,0,0,,Бұл сізді жасыл алаңға апармайды.
Dialogue: 0,0:11:42.63,0:11:45.63,Default,,0,0,0,,Мен оны бар күшіммен тербеткім келеді
Dialogue: 0,0:11:45.63,0:11:49.04,Default,,0,0,0,,Бұл соңғы ату болады
Dialogue: 0,0:11:50.91,0:11:52.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:52.91,0:11:55.51,Default,,0,0,0,,Жарайды, мен саған қалдырамын.
Dialogue: 0,0:12:00.25,0:12:02.58,Default,,0,0,0,,《Маркерді жүктеңіз➡
Dialogue: 0,0:12:02.58,0:12:04.92,Default,,0,0,0,,Балғаны көтеріңіз➡
Dialogue: 0,0:12:04.92,0:12:07.59,Default,,0,0,0,,Мақсат➡
Dialogue: 0,0:12:07.59,0:12:09.92,Default,,0,0,0,,Триггерді➡ тартыңыз
Dialogue: 0,0:12:09.92,0:12:11.93,Default,,0,0,0,,Бөшкеден босату》
Dialogue: 0,0:12:11.93,0:12:16.23,Default,,0,0,0,,<Аспанның қызыл оғы! ＞
Dialogue: 0,0:12:21.27,0:12:25.27,Default,,0,0,0,,Әпке, жақсы емес, жақында келеді!
Dialogue: 0,0:12:25.27,0:12:28.28,Default,,0,0,0,,Амал жоқ, кеттік, Лили.
Dialogue: 0,0:12:28.28,0:12:30.28,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:12:44.96,0:12:46.96,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым!
Dialogue: 0,0:12:49.90,0:12:52.90,Default,,0,0,0,,Хауа осы уақытқа дейін қайда болды?
Dialogue: 0,0:12:52.90,0:12:56.24,Default,,0,0,0,,Толығырақ кейінірек! Атпен жүру, бұл кішкентай, бірақ
Dialogue: 0,0:12:56.24,0:12:58.54,Default,,0,0,0,,Қосымша бір сөз
Dialogue: 0,0:13:01.24,0:13:03.24,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:13:03.24,0:13:06.25,Default,,0,0,0,,Әзірше мен тапсырыс берген қонақүйге барамын.
Dialogue: 0,0:13:06.25,0:13:10.59,Default,,0,0,0,,Сонда? Содан бастап бұл әркімнің өз қалауы бойынша.
Dialogue: 0,0:13:10.59,0:13:13.92,Default,,0,0,0,,Сіз кез келген нәрсені жасай аласыз және кез келген нәрсеге айнала аласыз.
Dialogue: 0,0:13:13.92,0:13:16.92,Default,,0,0,0,,Хауа? не? бұл үлкен ақша
Dialogue: 0,0:13:16.92,0:13:19.59,Default,,0,0,0,,Уау (Эмили) Ақша көп!
Dialogue: 0,0:13:19.59,0:13:23.60,Default,,0,0,0,,Өмірдегі толық өзгерістер
Dialogue: 0,0:13:23.60,0:13:26.93,Default,,0,0,0,,Бұл бостандыққа қашу!
Dialogue: 0,0:13:26.93,0:13:30.24,Default,,0,0,0,,(Барлығы қолдайды)
Dialogue: 0,0:13:33.98,0:13:36.98,Default,,0,0,0,,Ол келді ме? жеке куәлік
Dialogue: 0,0:13:36.98,0:13:39.31,Default,,0,0,0,,Барлығыңызға жеткілікті.
Dialogue: 0,0:13:39.31,0:13:41.58,Default,,0,0,0,,Аты сәл өзгереді➡
Dialogue: 0,0:13:41.58,0:13:44.29,Default,,0,0,0,,Менің фоным таза және мінсіз.
Dialogue: 0,0:13:45.25,0:13:47.26,Default,,0,0,0,,Егер сізде бұл бар болса➡
Dialogue: 0,0:13:47.26,0:13:50.26,Default,,0,0,0,,Балаларыңызды мектепке жібере аласыз➡
Dialogue: 0,0:13:50.26,0:13:52.93,Default,,0,0,0,,Әрине жұмыс істеуге болады.
Dialogue: 0,0:13:52.93,0:13:56.60,Default,,0,0,0,,Салық төлеу керек болса да
Dialogue: 0,0:13:56.60,0:13:59.93,Default,,0,0,0,,Жеке куәлігіңізді қалай дайындадыңыз?
Dialogue: 0,0:13:59.93,0:14:01.94,Default,,0,0,0,,☎(Випера) Жыланның жолы – жылан
Dialogue: 0,0:14:01.94,0:14:04.94,Default,,0,0,0,,Жылан әйел күткендей ☎ Жылан!
Dialogue: 0,0:14:04.94,0:14:08.28,Default,,0,0,0,,Бұл қанша тұрады? ☎ Ол үшін уайымдамаңыз
Dialogue: 0,0:14:08.28,0:14:10.95,Default,,0,0,0,,☎ Бұл менің сыйлығым.
Dialogue: 0,0:14:10.95,0:14:12.95,Default,,0,0,0,,Ум...
Dialogue: 0,0:14:15.95,0:14:17.95,Default,,0,0,0,,📱 Рахмет
Dialogue: 0,0:14:17.95,0:14:21.29,Default,,0,0,0,,Сізге алғыс айтуым керек.
Dialogue: 0,0:14:21.29,0:14:23.29,Default,,0,0,0,,Кездескенше (дыбыс кесу)
Dialogue: 0,0:14:24.96,0:14:27.30,Default,,0,0,0,,Мен құмар гольф ойынынан шығып жатырмын.
Dialogue: 0,0:14:27.30,0:14:30.30,Default,,0,0,0,,Маған өмірден көбірек ләззат алу керек.
Dialogue: 0,0:14:30.30,0:14:32.30,Default,,0,0,0,,Иә
Dialogue: 0,0:14:35.64,0:14:40.58,Default,,0,0,0,,(Балалардың толқуы)
Dialogue: 0,0:14:40.58,0:14:45.25,Default,,0,0,0,,Уау... міне! Секіруге болмайды!
Dialogue: 0,0:14:45.25,0:14:47.25,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:14:47.25,0:14:49.25,Default,,0,0,0,,Сонымен, құрылыс мерзімі ...
Dialogue: 0,0:14:49.25,0:14:51.59,Default,,0,0,0,,Мен көремін. Мен түссіндім.
Dialogue: 0,0:14:51.59,0:14:53.92,Default,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:14:53.92,0:14:57.93,Default,,0,0,0,,Дүкеннің іші бір апта ішінде аяқталады.
Dialogue: 0,0:14:57.93,0:15:00.93,Default,,0,0,0,,Бұл Эмили мен оның достарын мектепке ауыстыру тәртібі➡
Dialogue: 0,0:15:00.93,0:15:02.93,Default,,0,0,0,,Мен өтініш бердім.
Dialogue: 0,0:15:04.27,0:15:07.27,Default,,0,0,0,,Дүкенді әпкем екеуміз басқарамыз.
Dialogue: 0,0:15:07.27,0:15:10.27,Default,,0,0,0,,Эмили мен оның достары мектепте оқиды.
Dialogue: 0,0:15:11.27,0:15:14.28,Default,,0,0,0,,Енді Хауа не істейді?
Dialogue: 0,0:15:14.28,0:15:16.28,Default,,0,0,0,,Бұл гольф, солай ма?
Dialogue: 0,0:15:16.28,0:15:18.28,Default,,0,0,0,,Гольф ойнамау➡
Dialogue: 0,0:15:18.28,0:15:22.28,Default,,0,0,0,,Тек гольф ойнаңыз, нағыз джентльмен спорты.
Dialogue: 0,0:15:23.62,0:15:27.29,Default,,0,0,0,,Дұрыс, Хауа тек гольф ойнайды.
Dialogue: 0,0:15:27.29,0:15:29.96,Default,,0,0,0,,...Ол Хауа қайда?
Dialogue: 0,0:15:29.96,0:15:32.63,Default,,0,0,0,,Маған жаңа ғана қабылдау бөлмесінен қоңырау келді➡
Dialogue: 0,0:15:32.63,0:15:35.33,Default,,0,0,0,,Сіз біреумен кездесіп жатқан сияқтысыз
Dialogue: 0,0:15:40.23,0:15:42.57,Default,,0,0,0,,мақсаты қандай?
Dialogue: 0,0:15:42.57,0:15:44.57,Default,,0,0,0,,Неге...
Dialogue: 0,0:15:44.57,0:15:48.58,Default,,0,0,0,,Неге... мұнда неге келдің?
Dialogue: 0,0:15:49.58,0:15:53.58,Default,,0,0,0,,Әпкем маған осылай қарап тұрды.
Dialogue: 0,0:15:56.25,0:16:01.26,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:16:01.26,0:16:04.93,Default,,0,0,0,,Сіз сондай тәкаппар және тітіркендіргішсіз➡
Dialogue: 0,0:16:04.93,0:16:08.53,Default,,0,0,0,,Ол менің апамды жеңген ең жаман бейбақ.
Dialogue: 0,0:16:09.60,0:16:11.60,Default,,0,0,0,,Бірақ➡
Dialogue: 0,0:16:11.60,0:16:14.60,Default,,0,0,0,,Мен қиналып тұрмын, сондықтан мен сізге бір нәрсені айтайын.
Dialogue: 0,0:16:15.60,0:16:19.61,Default,,0,0,0,,Өткен күні бәс тігу матчында жеңіліп қалған Кэтрин кемпір ашулы➡
Dialogue: 0,0:16:19.61,0:16:22.28,Default,,0,0,0,,Мен әпкеме өлтіруші жібердім.
Dialogue: 0,0:16:22.28,0:16:24.28,Default,,0,0,0,,Раушанға?
Dialogue: 0,0:16:24.28,0:16:26.28,Default,,0,0,0,,Сізге де.
Dialogue: 0,0:16:27.62,0:16:30.62,Default,,0,0,0,,Мафиямен араласу деген осы.
Dialogue: 0,0:16:30.62,0:16:33.96,Default,,0,0,0,,Өлгің келмесе, бұл қаладан кет.
Dialogue: 0,0:16:33.96,0:16:36.29,Default,,0,0,0,,Мен де қаладан кетемін
Dialogue: 0,0:16:36.29,0:16:38.29,Default,,0,0,0,,Тез болғаным үшін кешірім сұраймын.
Dialogue: 0,0:16:39.29,0:16:41.23,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:16:41.23,0:16:44.57,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін, тіпті көргім де келмейді!
Dialogue: 0,0:16:44.57,0:16:49.57,Default,,0,0,0,,Қалағаныңызша өмір сүріңіз, қалағаныңызша өліңіз!
Dialogue: 0,0:16:51.57,0:16:53.57,Default,,0,0,0,,Иә, аламын.
Dialogue: 0,0:16:54.91,0:16:57.91,Default,,0,0,0,,Қалағаныңызша өмір сүріңіз, қалағаныңызша өліңіз.
Dialogue: 0,0:16:57.91,0:17:03.92,Default,,0,0,0,,♬～
Dialogue: 0,0:17:03.92,0:17:06.59,Default,,0,0,0,,А... Мемлекеттік кеңседе қандай тәртіптер бар?
Dialogue: 0,0:17:06.59,0:17:09.26,Default,,0,0,0,,Неліктен бұл ұзаққа созылады?
Dialogue: 0,0:17:09.26,0:17:11.26,Default,,0,0,0,,Біртүрлі атау
Dialogue: 0,0:17:12.26,0:17:15.26,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,0:17:15.26,0:17:17.27,Default,,0,0,0,,Хауа!
Dialogue: 0,0:17:17.27,0:17:19.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:23.94,0:17:25.94,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,0:17:25.94,0:17:30.28,Default,,0,0,0,,Роуз мырза маған хабарласып, мән-жайды сұрады.
Dialogue: 0,0:17:30.28,0:17:32.28,Default,,0,0,0,,Мынаны алыңыз
Dialogue: 0,0:17:32.28,0:17:36.28,Default,,0,0,0,,Мен ақша, киім сияқты қажетті заттарды жинадым.
Dialogue: 0,0:17:36.28,0:17:38.29,Default,,0,0,0,,Кешіріңіз Хауа
Dialogue: 0,0:17:38.29,0:17:40.89,Default,,0,0,0,,Біз үшін қауіпті нәрсе жасаңыз...
Dialogue: 0,0:17:40.89,0:17:44.89,Default,,0,0,0,,Мен мұны өз қарсаңымда жасадым!
Dialogue: 0,0:17:44.89,0:17:47.90,Default,,0,0,0,,Біз Катаги болып, дұрыс өмір сүреміз!
Dialogue: 0,0:17:47.90,0:17:50.23,Default,,0,0,0,,Балаларды маған қалдырыңыз
Dialogue: 0,0:17:50.23,0:17:52.53,Default,,0,0,0,,Иә, мен сұрадым.
Dialogue: 0,0:17:53.57,0:17:57.57,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,0:17:59.57,0:18:03.58,Default,,0,0,0,,Сіз Жапонияға барасыз, солай ма? Сол жапондықтармен танысу үшін
Dialogue: 0,0:18:03.58,0:18:05.58,Default,,0,0,0,,Гольф ойнау үшін...
Dialogue: 0,0:18:07.58,0:18:10.99,Default,,0,0,0,,Біз тағы кездесеміз, солай ма? Мен күтетін боламын!
Dialogue: 0,0:18:12.59,0:18:15.26,Default,,0,0,0,,Рахмет саған Хауа!
Dialogue: 0,0:18:15.26,0:18:18.96,Default,,0,0,0,,Сіз міндетті түрде бақытты боласыз!
Dialogue: 0,0:18:21.93,0:18:27.54,Default,,0,0,0,,Ева... өзінің сүйікті гольф ойынын ойнайды!
Dialogue: 0,0:18:37.28,0:18:48.56,Default,,0,0,0,,♬～
Dialogue: 0,0:18:48.56,0:18:50.56,Default,,0,0,0,,《Атың кім? 》
Dialogue: 0,0:18:50.56,0:18:52.56,Default,,0,0,0,,《Эвангелин》
Dialogue: 0,0:18:52.56,0:18:54.56,Default,,0,0,0,,《Тегің кім? 》
Dialogue: 0,0:18:57.23,0:18:59.57,Default,,0,0,0,,《Түсінбедім》
Dialogue: 0,0:18:59.57,0:19:01.57,Default,,0,0,0,,《Депозит расталды》
Dialogue: 0,0:19:01.57,0:19:04.24,Default,,0,0,0,,《Үйге апаратын дәмді нәрсе сатып алайық.》
Dialogue: 0,0:19:04.24,0:19:06.91,Default,,0,0,0,,《Сіз де тәтті алғыңыз келе ме? жақсы? 》
Dialogue: 0,0:19:06.91,0:19:08.91,Default,,0,0,0,,《Арнайы》
Dialogue: 0,0:19:08.91,0:19:11.25,Default,,0,0,0,,《«Сувенир»? Не? 》
Dialogue: 0,0:19:11.25,0:19:13.25,Default,,0,0,0,,《Тәттілер? 》 《Ойыншықтар? 》
Dialogue: 0,0:19:13.25,0:19:18.25,Default,,0,0,0,,《Екеуі де》 《(Балалардың қуаныш дауыстары)》
Dialogue: 0,0:19:18.25,0:19:38.27,Default,,0,0,0,,♬～
Dialogue: 0,0:19:38.27,0:19:58.29,Default,,0,0,0,,♬～
Dialogue: 0,0:19:58.29,0:20:06.30,Default,,0,0,0,,♬～
Dialogue: 0,0:20:14.98,0:20:16.98,Default,,0,0,0,,Сол бейбақ...
Dialogue: 0,0:20:20.98,0:20:22.98,Default,,0,0,0,,《Оңға сәл ығысқан》
Dialogue: 0,0:20:22.98,0:20:24.99,Default,,0,0,0,,《Өшірулі》
Dialogue: 0,0:20:45.94,0:20:47.94,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:47.94,0:20:51.25,Default,,0,0,0,,Ол мені тура мағынада қуып жіберді.
Dialogue: 0,0:20:58.95,0:21:01.29,Default,,0,0,0,,Сені ойламаған жерден шақырғанның несі айып?
Dialogue: 0,0:21:01.29,0:21:03.96,Default,,0,0,0,,Мен де, сен де... (Раушан) Айтшы.
Dialogue: 0,0:21:03.96,0:21:06.63,Default,,0,0,0,,Менің Хауа анадан қандай айырмашылығым бар?
Dialogue: 0,0:21:06.63,0:21:09.03,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:21:10.97,0:21:12.97,Default,,0,0,0,,Ерік
Dialogue: 0,0:21:12.97,0:21:18.97,Default,,0,0,0,,Өз талантыңызға сүйеніп, өзіңізден әлсіздерді жеңіңіз➡
Dialogue: 0,0:21:18.97,0:21:21.98,Default,,0,0,0,,Аздап ақша тауып бақытты болғандармен➡
Dialogue: 0,0:21:21.98,0:21:27.28,Default,,0,0,0,,Өзінен күштілермен күресуге үнемі аш болатындар.
Dialogue: 0,0:21:28.32,0:21:30.32,Default,,0,0,0,,Ол соңғысы болды.
Dialogue: 0,0:21:30.32,0:21:32.99,Default,,0,0,0,,Бұл жалғыз айырмашылық.
Dialogue: 0,0:21:32.99,0:21:37.32,Default,,0,0,0,,Неліктен сен Хауаны тастап кеттің?
Dialogue: 0,0:21:37.32,0:21:41.60,Default,,0,0,0,,Себебі мен оны толығымен жетілдіре алмайтынымды түсіндім.
Dialogue: 0,0:21:41.60,0:21:46.30,Default,,0,0,0,,Ішінде ұйықтап жатқан нәрсе оянбаса
Dialogue: 0,0:21:47.27,0:21:49.27,Default,,0,0,0,,«Ұйқыдағы заттар»…
Dialogue: 0,0:21:49.27,0:21:52.61,Default,,0,0,0,,Аа, оянбағанша➡
Dialogue: 0,0:21:52.61,0:21:55.28,Default,,0,0,0,,Ол әлі де қорқынышты гольф ойыншысы.
Dialogue: 0,0:21:55.28,0:21:58.28,Default,,0,0,0,,Мен оянсам ше?
Dialogue: 0,0:21:58.28,0:22:01.62,Default,,0,0,0,,Гольф әлеміне жаңбыр жауады.
Dialogue: 0,0:22:01.62,0:22:04.02,Default,,0,0,0,,Оқ жаңбыры
Dialogue: 0,0:22:05.29,0:22:08.99,Default,,0,0,0,,Түсіндім, өкінбейсің.
Dialogue: 0,0:22:09.96,0:22:15.30,Default,,0,0,0,,Nafres Airlines 224 рейсі жақын арада ұшады.
Dialogue: 0,0:22:15.30,0:22:17.63,Default,,0,0,0,,《Бір күні шынайы әлемде➡
Dialogue: 0,0:22:17.63,0:22:22.97,Default,,0,0,0,,Арнайы квота ретінде емес, турнирдің ресми қатысушысы ретінде...》
Dialogue: 0,0:22:22.97,0:22:25.27,Default,,0,0,0,,<Иә, мен істеймін>
Dialogue: 0,0:22:26.31,0:22:30.31,Default,,0,0,0,,《Менің көңілім үшін...》
Dialogue: 0,0:22:30.31,0:22:32.31,Default,,0,0,0,,<Сізбен бірге...>
Dialogue: 0,0:22:35.32,0:22:37.32,Default,,0,0,0,,<Гольф ойнау...>
Dialogue: 0,0:22:38.32,0:22:40.25,Default,,0,0,0,,Маған қайта қоңырау шалма
Dialogue: 0,0:22:40.25,0:22:42.92,Default,,0,0,0,,Менің сіздей бос уақытым жоқ.
Dialogue: 0,0:22:42.92,0:22:52.27,Default,,0,0,0,,♬～
Dialogue: 0,0:22:52.27,0:22:54.94,Default,,0,0,0,,Мен сізге енді қоңырау шала алмаймын.
Dialogue: 0,0:22:54.94,0:23:08.95,Default,,0,0,0,,♬～
Dialogue: 0,0:23:08.95,0:23:13.95,Default,,0,0,0,,《(Галереядағы қошемет пен шапалақ)》
Dialogue: 0,0:23:13.95,0:23:23.30,Default,,0,0,0,,♬～
Dialogue: 0,0:23:23.30,0:23:25.30,Default,,0,0,0,,Еваға барыңыз
Dialogue: 0,0:23:26.30,0:23:28.30,Default,,0,0,0,,Күн шуақты жерге...
Dialogue: 0,0:23:28.30,0:23:30.30,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:23:31.31,0:23:34.61,Default,,0,0,0,,<Мен бұрылған әлемге>
Dialogue: 0,0:23:39.91,0:23:42.58,Default,,0,0,0,,Не? Бұл тегін бе? өтірік
Dialogue: 0,0:23:42.58,0:23:45.59,Default,,0,0,0,,Олай болса көбірек әкел, бар болғаны.
Dialogue: 0,0:23:45.59,0:23:47.59,Default,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:23:50.59,0:23:52.93,Default,,0,0,0,,<Райоу академиясы гольф клубының Ичинасу Саотоме>
Dialogue: 0,0:23:52.93,0:23:54.93,Default,,0,0,0,,<Мен 3-ші эпизодта қысқаша пайда болдым және келесі эпизодтың басты кейіпкері боламын>
Dialogue: 0,0:23:54.93,0:23:56.93,Default,,0,0,0,,<Эй, сен Аоидың кім екенін білмейсің бе? > <Мен білмеймін>
Dialogue: 0,0:23:56.93,0:23:58.93,Default,,0,0,0,,<Келесі жолы да Берди Берди>
Dialogue: 0,0:24:00.43,0:24:06.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory