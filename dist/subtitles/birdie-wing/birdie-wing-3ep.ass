Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.96,0:00:20.98,Default,,0,0,0,,♬～
Dialogue: 0,0:00:20.98,0:00:22.99,Default,,0,0,0,,Бұл бала ма? раушан
Dialogue: 0,0:00:22.99,0:00:25.32,Default,,0,0,0,,Тіпті мектепке бармасам да➡
Dialogue: 0,0:00:25.32,0:00:28.99,Default,,0,0,0,,Мен U15 чемпионатына қатысқым келеді➡
Dialogue: 0,0:00:28.99,0:00:31.59,Default,,0,0,0,,Түс сияқты нәрселерді айтатын қыз
Dialogue: 0,0:00:34.00,0:00:38.00,Default,,0,0,0,,Мадамның компаниясы чемпионаттың бас демеушісі.
Dialogue: 0,0:00:38.00,0:00:42.60,Default,,0,0,0,,Мен оны арнайы шақыру ұяшығымен бұрап қоюға болады ма деп ойладым.
Dialogue: 0,0:00:43.67,0:00:46.01,Default,,0,0,0,,Әрине мүмкін.
Dialogue: 0,0:00:46.01,0:00:49.34,Default,,0,0,0,,Бірақ марапат оған тұрарлық➡
Dialogue: 0,0:00:49.34,0:00:51.35,Default,,0,0,0,,Менде бар ма?
Dialogue: 0,0:00:52.35,0:00:55.65,Default,,0,0,0,,Мен саған бұл денені беремін, онымен қалағаныңды істе.
Dialogue: 0,0:00:57.35,0:01:01.96,Default,,0,0,0,,Өкінішке орай, мені тек жас жігіттер қызықтырады.
Dialogue: 0,0:01:01.96,0:01:05.29,Default,,0,0,0,,Мені құрметпен шығарып салуыңызды өтінемін (қара түсте).
Dialogue: 0,0:01:05.29,0:01:09.00,Default,,0,0,0,,«Мен істі өз мойныма аламын» десем ше?
Dialogue: 0,0:01:12.30,0:01:14.64,Default,,0,0,0,,Чемпионатқа қатысу туралы сұрау
Dialogue: 0,0:01:14.64,0:01:16.64,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:01:18.64,0:01:21.64,Default,,0,0,0,,Үтік қызып тұрғанда соғамын.
Dialogue: 0,0:01:21.64,0:01:23.98,Default,,0,0,0,,Сүйектер әуеде ұшып жүр
Dialogue: 0,0:01:23.98,0:01:25.98,Default,,0,0,0,,Сіз қайтып орала алмайсыз.
Dialogue: 0,0:01:25.98,0:01:29.28,Default,,0,0,0,,Рахмет, ханым.
Dialogue: 0,0:01:32.99,0:01:34.99,Default,,0,0,0,,Эй, «мысал материя» дегеніміз не?
Dialogue: 0,0:01:34.99,0:01:37.99,Default,,0,0,0,,Дәл қазір білудің қажеті жоқ.
Dialogue: 0,0:01:37.99,0:01:40.66,Default,,0,0,0,,Көптен күткен тілегім болғанына қуаныштымын.
Dialogue: 0,0:01:40.66,0:01:44.67,Default,,0,0,0,,Мен сізге дүкенімдегі киімдер мен клубтарды арнайы қарызға беремін.
Dialogue: 0,0:01:46.67,0:01:50.34,Default,,0,0,0,,Чемпионат, келіңіздер!
Dialogue: 0,0:01:50.34,0:01:52.34,Default,,0,0,0,,<Айтпасаң да...>
Dialogue: 0,0:01:55.01,0:01:58.35,Default,,0,0,0,,<Тікелей көк оқ тиді! ＞
Dialogue: 0,0:01:58.35,0:02:05.62,Default,,0,0,0,,♬～
Dialogue: 0,0:02:05.62,0:02:08.02,Default,,0,0,0,,Не? Сол траектория
Dialogue: 0,0:02:08.96,0:02:10.96,Default,,0,0,0,,Бұл кім? Сол қыз
Dialogue: 0,0:02:11.96,0:02:13.96,Default,,0,0,0,,<Табылды>
Dialogue: 0,0:02:16.63,0:02:18.63,Default,,0,0,0,,<Сонымен сіз уәдеңізде тұрдыңыз>
Dialogue: 0,0:02:18.63,0:02:21.04,Default,,0,0,0,,<Иә, және...>
Dialogue: 0,0:02:22.30,0:02:24.61,Default,,0,0,0,,<Бұл жолы біз мәселені шешеміз>
Dialogue: 0,0:02:27.31,0:02:47.33,Default,,0,0,0,,♬～
Dialogue: 0,0:02:47.33,0:03:07.28,Default,,0,0,0,,♬～
Dialogue: 0,0:03:07.28,0:03:27.30,Default,,0,0,0,,♬～
Dialogue: 0,0:03:27.30,0:03:47.32,Default,,0,0,0,,♬～
Dialogue: 0,0:03:47.32,0:03:56.00,Default,,0,0,0,,♬～
Dialogue: 0,0:04:11.98,0:04:13.98,Default,,0,0,0,,Сіз не істеп жатырсыз? Аой
Dialogue: 0,0:04:13.98,0:04:16.28,Default,,0,0,0,,Сіздің кезегіңіз соңғы топта... Ах.
Dialogue: 0,0:04:18.32,0:04:20.32,Default,,0,0,0,,<Ах... ол кісі...>
Dialogue: 0,0:04:22.99,0:04:24.99,Default,,0,0,0,,<Осыған дейін...>
Dialogue: 0,0:04:26.33,0:04:28.66,Default,,0,0,0,,<Чемпионатқа не үшін қатыстыңыз? ＞
Dialogue: 0,0:04:28.66,0:04:30.67,Default,,0,0,0,,<Ол кеше болған жоқ>
Dialogue: 0,0:04:31.67,0:04:33.67,Default,,0,0,0,,＜「Ｅｖｅ Ａｌｅｏｎ」＞
Dialogue: 0,0:04:33.67,0:04:37.01,Default,,0,0,0,,<Арнайы шақырылған ойыншылар тек соңғы күні>
Dialogue: 0,0:04:37.01,0:04:39.01,Default,,0,0,0,,＜…Жоқ…＞
Dialogue: 0,0:04:40.68,0:04:44.35,Default,,0,0,0,,《Менімен тағы да гольф ойнайсың ба?》
Dialogue: 0,0:04:44.35,0:04:47.68,Default,,0,0,0,,《Бір саңылау емес, бір айналым》
Dialogue: 0,0:04:47.68,0:04:51.69,Default,,0,0,0,,《Мен сенімен бар күшіммен гольф ойнағым келеді》
Dialogue: 0,0:04:52.62,0:04:54.62,Default,,0,0,0,,<Сондықтан да...>
Dialogue: 0,0:04:54.62,0:04:57.29,Default,,0,0,0,,18 саңылаудан жарыс
Dialogue: 0,0:04:57.29,0:04:59.29,Default,,0,0,0,,Неше үйірме бар?
Dialogue: 0,0:04:59.29,0:05:01.30,Default,,0,0,0,,Мен мұның бәрін қолданамын
Dialogue: 0,0:05:01.30,0:05:04.00,Default,,0,0,0,,Түсіндім, қабылдаймын.
Dialogue: 0,0:05:07.64,0:05:10.31,Default,,0,0,0,,Аой Ол кісі... Амане
Dialogue: 0,0:05:10.31,0:05:12.97,Default,,0,0,0,,Мен курсқа шыққаннан бері әрбір 3 тесік➡
Dialogue: 0,0:05:12.97,0:05:15.98,Default,,0,0,0,,Оның ұпайын айтыңызшы?
Dialogue: 0,0:05:15.98,0:05:18.98,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:05:18.98,0:05:20.98,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:20.98,0:05:23.32,Default,,0,0,0,,Шынымды айтсам, ол кісімен жүре алмайтыным өкінішті.
Dialogue: 0,0:05:23.32,0:05:26.02,Default,,0,0,0,,Бірақ мен қазір...
Dialogue: 0,0:05:27.66,0:05:30.06,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:05:42.00,0:05:44.01,Default,,0,0,0,,Әпке
Dialogue: 0,0:05:44.01,0:05:46.01,Default,,0,0,0,,Бұл қандай гольф ойыны? ➡
Dialogue: 0,0:05:46.01,0:05:48.34,Default,,0,0,0,,Неліктен оны көруге келу керек?
Dialogue: 0,0:05:48.34,0:05:50.28,Default,,0,0,0,,Үніңді жап, артымнан ер
Dialogue: 0,0:05:50.28,0:05:53.28,Default,,0,0,0,,Сіз қызықты нәрселерді көре аласыз. «Қызықты нәрселер» бұл...
Dialogue: 0,0:05:53.28,0:05:55.28,Default,,0,0,0,,Сол жерде, иә?
Dialogue: 0,0:05:57.29,0:05:59.29,Default,,0,0,0,,Әй, анау жігіт...!
Dialogue: 0,0:05:59.29,0:06:01.62,Default,,0,0,0,,Сіз нені айтасыз, апа?
Dialogue: 0,0:06:01.62,0:06:03.96,Default,,0,0,0,,Катаги матчына Хауаның ақымақ неге келді...
Dialogue: 0,0:06:03.96,0:06:06.63,Default,,0,0,0,,Бұл жарнама. «Жарнама»?
Dialogue: 0,0:06:06.63,0:06:08.63,Default,,0,0,0,,Сондықтан➡
Dialogue: 0,0:06:08.63,0:06:11.63,Default,,0,0,0,,Мұқият қабылдамасаң, қиналып қаласың.
Dialogue: 0,0:06:12.63,0:06:14.97,Default,,0,0,0,,Әй, сен жақсы жүріп жатқан сияқтысың.
Dialogue: 0,0:06:14.97,0:06:16.97,Default,,0,0,0,,және ➡
Dialogue: 0,0:06:16.97,0:06:21.31,Default,,0,0,0,,Бар болғаны екі тесікте сіз жаудың жүрегін дәл атуға болады.
Dialogue: 0,0:06:21.31,0:06:25.31,Default,,0,0,0,,Әпке, Хауаның ақымақ шынымен гольфте жақсы ма?
Dialogue: 0,0:06:25.31,0:06:28.32,Default,,0,0,0,,Бұл өте нашар, иә?
Dialogue: 0,0:06:28.32,0:06:30.32,Default,,0,0,0,,Бірақ күшті
Dialogue: 0,0:06:30.32,0:06:33.02,Default,,0,0,0,,Оның гольфі өте қарапайым.
Dialogue: 0,0:06:35.99,0:06:38.99,Default,,0,0,0,,Қыңырлықпен допты түйреуішке жақындату
Dialogue: 0,0:06:38.99,0:06:41.00,Default,,0,0,0,,тіпті бүргелері де болуы мүмкін.
Dialogue: 0,0:06:41.00,0:06:43.33,Default,,0,0,0,,Әрбір ату - құмар ойын
Dialogue: 0,0:06:43.33,0:06:45.67,Default,,0,0,0,,Кез келген тәуекелге баруға дайын
Dialogue: 0,0:06:45.67,0:06:49.67,Default,,0,0,0,,Мен және Хауа сияқты астыртын гольф ойыншыларының арасындағы матчтар➡
Dialogue: 0,0:06:49.67,0:06:52.94,Default,,0,0,0,,Негізгі жеке матч ойыны
Dialogue: 0,0:06:52.94,0:06:55.94,Default,,0,0,0,,Қарсыласыңыздың ақыл-ойын талқандаңыз
Dialogue: 0,0:06:55.94,0:06:58.95,Default,,0,0,0,,Сол стиль менің бойымда сіңіп қалған.
Dialogue: 0,0:06:59.95,0:07:02.28,Default,,0,0,0,,Кейбір адамдар гольфті спорт деп ойлайды➡
Dialogue: 0,0:07:02.28,0:07:05.29,Default,,0,0,0,,Саған осылай ойнау көрсетілсе не болар еді?
Dialogue: 0,0:07:05.29,0:07:07.29,Default,,0,0,0,,Ынталы ойыншылар➡
Dialogue: 0,0:07:07.29,0:07:10.63,Default,,0,0,0,,Ол Хауа анадан үлгі алып, қиындыққа батыл кіріседі.
Dialogue: 0,0:07:10.63,0:07:12.63,Default,,0,0,0,,Бірақ➡
Dialogue: 0,0:07:12.63,0:07:15.63,Default,,0,0,0,,Құмар ойындарының сәттілігі Хауадан өзгеше.
Dialogue: 0,0:07:15.63,0:07:20.64,Default,,0,0,0,,Үнемі құмар ойнайтындар және анда-санда ғана құмар ойнайтындар➡
Dialogue: 0,0:07:20.64,0:07:23.64,Default,,0,0,0,,Бұл тәжірибе нүктелерінің әртүрлі болғандықтан.
Dialogue: 0,0:07:23.64,0:07:28.64,Default,,0,0,0,,Ал тәуекел жауапкершілікке айналады, ол тез жинақталады.
Dialogue: 0,0:07:28.64,0:07:30.65,Default,,0,0,0,,Сабырлы ойыншы➡
Dialogue: 0,0:07:30.65,0:07:33.65,Default,,0,0,0,,Мен өз стилімде гольф ойнаймын.
Dialogue: 0,0:07:37.65,0:07:42.32,Default,,0,0,0,,Бірақ әрбір саңылаумен Хауамен ұпай артады.
Dialogue: 0,0:07:42.32,0:07:45.66,Default,,0,0,0,,Осы қарқынмен жеңе алмасақ, сабырлылықтан айырыламыз➡
Dialogue: 0,0:07:45.66,0:07:48.66,Default,,0,0,0,,Нәтижені асыра орындау➡
Dialogue: 0,0:07:48.66,0:07:51.07,Default,,0,0,0,,Гольф ойынын жоғалту
Dialogue: 0,0:07:52.27,0:07:56.60,Default,,0,0,0,,Адамның ақыл-ойы бір рет күйреді, оны қалпына келтіру оңай емес.
Dialogue: 0,0:07:56.60,0:07:58.94,Default,,0,0,0,,15 тесік қалды
Dialogue: 0,0:07:58.94,0:08:02.61,Default,,0,0,0,,Сол бәйбішелер тозақты көре береді.
Dialogue: 0,0:08:02.61,0:08:05.28,Default,,0,0,0,,E... тым қатал
Dialogue: 0,0:08:05.28,0:08:09.58,Default,,0,0,0,,Хауа үшін гольф – қарсыласын жеңу тәсілі.
Dialogue: 0,0:08:10.62,0:08:14.62,Default,,0,0,0,,Барлық қарсыластарыңызды кемпірқосақ түсті оқтармен өлтіріңіз.
Dialogue: 0,0:08:14.62,0:08:17.03,Default,,0,0,0,,Жай жойғыш
Dialogue: 0,0:08:17.96,0:08:19.96,Default,,0,0,0,,Яғни➡
Dialogue: 0,0:08:19.96,0:08:22.30,Default,,0,0,0,,Бұл кемпірқосақ оқының кеші.
Dialogue: 0,0:08:22.30,0:08:24.30,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:24.30,0:08:27.30,Default,,0,0,0,,Апа, сен сонша сатып алдың ба, ақымақ?
Dialogue: 0,0:08:27.30,0:08:29.30,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:08:29.30,0:08:33.01,Default,,0,0,0,,Әлгі жігіттен ақшаның иісі бар.
Dialogue: 0,0:08:42.65,0:08:44.65,Default,,0,0,0,,<Қарғыс ат... бұл мен...>
Dialogue: 0,0:08:44.65,0:08:48.66,Default,,0,0,0,,<Хелен Роберт, Нафрестің жасөспірімдер чемпионы➡
Dialogue: 0,0:08:48.66,0:08:52.36,Default,,0,0,0,,Соңғы күнге бара жатқан көшбасшыдан 7 соққы артта қалғаныма сене алар емеспін.
Dialogue: 0,0:08:53.26,0:08:57.27,Default,,0,0,0,,<Бәрі сол әйелдің кесірінен>
Dialogue: 0,0:08:57.27,0:09:00.27,Default,,0,0,0,,<Себебі ол әйел менің гольф ойынымды бұзып жатыр>
Dialogue: 0,0:09:01.94,0:09:04.61,Default,,0,0,0,,<Егер мен ол әйелді кездестірмесем...>
Dialogue: 0,0:09:04.61,0:09:07.94,Default,,0,0,0,,Ал... тек соңғы күні арнайы шақырылған ойыншылар➡
Dialogue: 0,0:09:07.94,0:09:11.95,Default,,0,0,0,,Бүркіт 3-ші 4-параграфта, барлығы 3-тен төмен.
Dialogue: 0,0:09:11.95,0:09:13.95,Default,,0,0,0,,Өтірік (ойыншы) Шынымен бе?
Dialogue: 0,0:09:13.95,0:09:16.55,Default,,0,0,0,,<S... 3 астында? ＞
Dialogue: 0,0:09:17.95,0:09:19.95,Default,,0,0,0,,<Нақты кім? ＞
Dialogue: 0,0:09:22.62,0:09:24.63,Default,,0,0,0,,<Ах...>
Dialogue: 0,0:09:25.63,0:09:28.63,Default,,0,0,0,,<Сол әйел~! ＞
Dialogue: 0,0:09:29.63,0:09:32.97,Default,,0,0,0,,<3 астында 3 тесік үшін, ғажайып>
Dialogue: 0,0:09:32.97,0:09:35.57,Default,,0,0,0,,<Мен бірінші күннен бастап ұпай жинап келемін>
Dialogue: 0,0:09:36.64,0:09:38.97,Default,,0,0,0,,<Жоқ, мен бұдан былай күте алмаймын>
Dialogue: 0,0:09:38.97,0:09:41.31,Default,,0,0,0,,<Мен курсқа тезірек барғым келеді>
Dialogue: 0,0:09:41.31,0:09:46.01,Default,,0,0,0,,<Сол адаммен бір атмосферада ойнау...>
Dialogue: 0,0:09:51.32,0:09:53.32,Default,,0,0,0,,Егер Хауа
Dialogue: 0,0:09:53.32,0:09:56.66,Default,,0,0,0,,Кешеден бері қайда қыдырдың?
Dialogue: 0,0:09:56.66,0:09:59.33,Default,,0,0,0,,Мен әдетте жаттығу жасайтын саябақта да емеспін.
Dialogue: 0,0:09:59.33,0:10:03.67,Default,,0,0,0,,Көп уайымдама, енді бала емессің.
Dialogue: 0,0:10:03.67,0:10:07.00,Default,,0,0,0,,Бірақ бұл бала бұзақы➡
Dialogue: 0,0:10:07.00,0:10:10.00,Default,,0,0,0,,Менің ойымша, ол бірдеңе жасайды.
Dialogue: 0,0:10:10.00,0:10:12.01,Default,,0,0,0,,Жігітіңізбен кездесуге баратыныңызға сенімдімін.
Dialogue: 0,0:10:12.01,0:10:14.01,Default,,0,0,0,,Лили, сені тастап кетті.
Dialogue: 0,0:10:14.01,0:10:18.01,Default,,0,0,0,,Бейшара Шарлотта Эмили
Dialogue: 0,0:10:18.01,0:10:20.68,Default,,0,0,0,,Гах! Уайымдамаңыздар, тентектер!
Dialogue: 0,0:10:20.68,0:10:22.68,Default,,0,0,0,,(Лилидің ырылдауы)
Dialogue: 0,0:10:22.68,0:10:25.05,Default,,0,0,0,,Ұсталды! (Эмили мен Шарлоттаның толқыған дауыстары)
Dialogue: 0,0:10:25.05,0:10:28.36,Default,,0,0,0,,⚟Хауа ана бар ма? «Менмін» деп қайда айтасыз?
Dialogue: 0,0:10:28.36,0:10:30.36,Default,,0,0,0,,Мұнда
Dialogue: 0,0:10:31.69,0:10:34.36,Default,,0,0,0,,Иә! ? Бұл не? Бұл нені білдіреді?
Dialogue: 0,0:10:34.36,0:10:36.36,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:10:36.36,0:10:40.03,Default,,0,0,0,,«U15 әлем чемпионаты»…
Dialogue: 0,0:10:40.03,0:10:43.64,Default,,0,0,0,,Әлемдік ойында Хауа?
Dialogue: 0,0:10:50.98,0:10:53.31,Default,,0,0,0,,<Бұл жай ғана оны фарвейге қайтарады>
Dialogue: 0,0:10:53.31,0:10:55.32,Default,,0,0,0,,<Богей кепілді>
Dialogue: 0,0:10:55.32,0:10:57.62,Default,,0,0,0,,＜Себебі мен жай ғана абайсызда гольф ойнаймын＞
Dialogue: 0,0:11:02.32,0:11:04.33,Default,,0,0,0,,<Сол қыз...> (Ойыншы) <Жоқ...>
Dialogue: 0,0:11:11.33,0:11:19.34,Default,,0,0,0,,♬～
Dialogue: 0,0:11:19.34,0:11:21.34,Default,,0,0,0,,<Мен сені мінгіздім> (Ойыншы) <Болды! ＞
Dialogue: 0,0:11:26.01,0:11:28.02,Default,,0,0,0,,<Жылжыды! ? ＞ (Ойыншы) ＜Мүмкін емес➡
Dialogue: 0,0:11:28.02,0:11:31.62,Default,,0,0,0,,Жасыл түстің ең жоғары нүктесін дәлдікпен көздеңіз...? ＞
Dialogue: 0,0:11:33.69,0:11:36.09,Default,,0,0,0,,Әй, менің добым қайда?
Dialogue: 0,0:11:37.69,0:11:40.03,Default,,0,0,0,,Нені қамтымайды?
Dialogue: 0,0:11:40.03,0:11:42.03,Default,,0,0,0,,<Бұл жігіт...! ＞
Dialogue: 0,0:11:46.03,0:11:49.04,Default,,0,0,0,,<Бүгін де танысқаныма қуаныштымын, Паккун> Иә?
Dialogue: 0,0:11:53.31,0:11:55.98,Default,,0,0,0,,<4 астында No5 аяқтағаннан кейін>
Dialogue: 0,0:11:55.98,0:11:59.31,Default,,0,0,0,,<Егер бұл баланың ынтасын арттырса➡
Dialogue: 0,0:11:59.31,0:12:01.32,Default,,0,0,0,,Бұл арзан＞
Dialogue: 0,0:12:02.32,0:12:04.65,Default,,0,0,0,,<Көшбасшыдан 4 штрих айырмашылығы>
Dialogue: 0,0:12:04.65,0:12:07.32,Default,,0,0,0,,<Гольф ойнаймыз>
Dialogue: 0,0:12:07.32,0:12:09.32,Default,,0,0,0,,<Ұш, Паккун! ＞
Dialogue: 0,0:12:17.30,0:12:19.30,Default,,0,0,0,,Керемет кадр! Харука
Dialogue: 0,0:12:19.30,0:12:21.64,Default,,0,0,0,,Қашықтық тағы да ұзарып кетпеді ме?
Dialogue: 0,0:12:21.64,0:12:25.04,Default,,0,0,0,,Рахмет, Сенпай, иә?
Dialogue: 0,0:12:26.31,0:12:29.98,Default,,0,0,0,,Ичина, сен жаттығу жасамайсың ба? иә?
Dialogue: 0,0:12:29.98,0:12:33.31,Default,,0,0,0,,Жаңа мүшелермен амандасып жатқанда солай айтпадың ба?
Dialogue: 0,0:12:33.31,0:12:36.99,Default,,0,0,0,,«Мен ойыншы емес, кәдди болуды мақсат етемін».
Dialogue: 0,0:12:36.99,0:12:41.59,Default,,0,0,0,,Ал мұндай биіктікте спортшы болу мүмкін емес.
Dialogue: 0,0:12:41.59,0:12:43.93,Default,,0,0,0,,Онда неге мұндасың?
Dialogue: 0,0:12:43.93,0:12:45.93,Default,,0,0,0,,Жақсы ойыншылармен топтасу керек➡
Dialogue: 0,0:12:45.93,0:12:48.26,Default,,0,0,0,,Сондықтан кәдди болу өте пайдалы емес.
Dialogue: 0,0:12:48.26,0:12:50.93,Default,,0,0,0,,Сіз бірдеңе іздеп жүрсіз бе?
Dialogue: 0,0:12:50.93,0:12:54.27,Default,,0,0,0,,Мен Тенваши-санмен➡ қосылсам тамаша болар еді
Dialogue: 0,0:12:54.27,0:12:57.94,Default,,0,0,0,,Оның Синдзо мырза атты жеке кассасы бар.
Dialogue: 0,0:12:57.94,0:12:59.94,Default,,0,0,0,,Олай болса менің көмекшім бол.
Dialogue: 0,0:12:59.94,0:13:01.94,Default,,0,0,0,,Иә, Харуканыкі ме?
Dialogue: 0,0:13:01.94,0:13:05.95,Default,,0,0,0,,Мен мақтанбаймын, бірақ мен орта мектепте республика бойынша 3-ші болдым.
Dialogue: 0,0:13:05.95,0:13:09.28,Default,,0,0,0,,Ол «Данышпан Тенваши Аоидың ең үлкен қарсыласы» деп айтылды➡
Dialogue: 0,0:13:09.28,0:13:12.62,Default,,0,0,0,,Осы Харука Мисононың серіктес болғанына көңіліңіз толмай ма?
Dialogue: 0,0:13:12.62,0:13:14.62,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:13:15.96,0:13:19.63,Default,,0,0,0,,⚟(Үлкен дыбыс) Мизухара-сенпай, жақсы кадр!
Dialogue: 0,0:13:19.63,0:13:21.63,Default,,0,0,0,,...тек оны елемеңіз.
Dialogue: 0,0:13:21.63,0:13:23.63,Default,,0,0,0,,Кадди унун➡ алдында
Dialogue: 0,0:13:23.63,0:13:26.30,Default,,0,0,0,,Тұрақты адам болмайынша, сөйлесудің қажеті жоқ.
Dialogue: 0,0:13:26.30,0:13:28.30,Default,,0,0,0,,Уф…
Dialogue: 0,0:13:28.30,0:13:32.31,Default,,0,0,0,,Баршаңызға, Тенваши матчының интернет трансляциясы басталды.
Dialogue: 0,0:13:35.98,0:13:38.65,Default,,0,0,0,,Харукаға да қараған дұрыс емес пе?
Dialogue: 0,0:13:38.65,0:13:41.58,Default,,0,0,0,,Ичина ше? Бармайсың ба?
Dialogue: 0,0:13:41.58,0:13:44.99,Default,,0,0,0,,Мен нәтижесін білетін матчты көргім келмейді.
Dialogue: 0,0:13:45.92,0:13:47.92,Default,,0,0,0,,Ағымдағы U15➡
Dialogue: 0,0:13:47.92,0:13:51.53,Default,,0,0,0,,Амаваши-санға қауіп төндіретін гольф ойыншылары жоқ.
Dialogue: 0,0:13:52.93,0:13:56.23,Default,,0,0,0,,<Сараңдықтың жасыл оғы! ＞
Dialogue: 0,0:14:04.27,0:14:07.98,Default,,0,0,0,,<4 құс, 1 бүркіт, 1 бөтен>
Dialogue: 0,0:14:10.61,0:14:15.02,Default,,0,0,0,,Out және жалпы саны 5-тен төмен, бұл өте жақсы.
Dialogue: 0,0:14:16.28,0:14:19.62,Default,,0,0,0,,Мен көрдім, (Роза) ханым, еңбектеріңізге рахмет.
Dialogue: 0,0:14:19.62,0:14:22.96,Default,,0,0,0,,Сондықтан бізді шақырдыңыз.
Dialogue: 0,0:14:22.96,0:14:25.26,Default,,0,0,0,,Сонда қалай болды?
Dialogue: 0,0:14:26.96,0:14:28.96,Default,,0,0,0,,⚟(Раушан) Ева иә?
Dialogue: 0,0:14:30.63,0:14:33.03,Default,,0,0,0,,Артқа кірер алдында тамақтаныңыз 9
Dialogue: 0,0:14:35.64,0:14:38.97,Default,,0,0,0,,<“No5 аяқтағаннан кейін 2 төмен”? ＞
Dialogue: 0,0:14:38.97,0:14:41.98,Default,,0,0,0,,<Сенің гольфың ондай емес.>
Dialogue: 0,0:14:43.24,0:14:47.25,Default,,0,0,0,,<Олар бұрыштарды кесіп жатқан сияқты емес пе?>
Dialogue: 0,0:14:47.25,0:14:52.25,Default,,0,0,0,,♬～
Dialogue: 0,0:14:52.25,0:14:54.26,Default,,0,0,0,,<Мен екі атуды жіберіп алдым>
Dialogue: 0,0:14:54.26,0:14:57.26,Default,,0,0,0,,<Кешеден желдің ағымы өзгерді>
Dialogue: 0,0:14:57.26,0:15:00.26,Default,,0,0,0,,<Бұл қауесет «Наклестің теңіз самалы»>
Dialogue: 0,0:15:00.26,0:15:05.60,Default,,0,0,0,,♬～
Dialogue: 0,0:15:05.60,0:15:07.60,Default,,0,0,0,,<5 астында>
Dialogue: 0,0:15:10.27,0:15:12.57,Default,,0,0,0,,<Мен сенімен бірге барғым келді>
Dialogue: 0,0:15:14.28,0:15:16.28,Default,,0,0,0,,<Бірге>
Dialogue: 0,0:15:17.61,0:15:20.62,Default,,0,0,0,,<Иә, жақсы, Аой>
Dialogue: 0,0:15:21.62,0:15:23.62,Default,,0,0,0,,<Шыдамсыз және мұңсыз...>
Dialogue: 0,0:15:24.62,0:15:27.96,Default,,0,0,0,,Ах, аа... хаха
Dialogue: 0,0:15:27.96,0:15:30.96,Default,,0,0,0,,<Тек гольф ойнау...>
Dialogue: 0,0:15:30.96,0:15:34.63,Default,,0,0,0,,Бүркіт…
Dialogue: 0,0:15:34.63,0:15:37.03,Default,,0,0,0,,Шынымен ғажап
Dialogue: 0,0:15:40.90,0:15:45.57,Default,,0,0,0,,<Ол қыз міндетті түрде жетеді... жоқ, мені басып озады.>
Dialogue: 0,0:15:45.57,0:15:47.58,Default,,0,0,0,,<Онда не істеу керек? ＞
Dialogue: 0,0:15:47.58,0:15:50.24,Default,,0,0,0,,<Бір ғана жауап бар>
Dialogue: 0,0:15:50.24,0:15:52.25,Default,,0,0,0,,<Оқ күшін арттыру>
Dialogue: 0,0:15:52.25,0:15:54.25,Default,,0,0,0,,<Алға! ＞
Dialogue: 0,0:15:54.25,0:15:57.59,Default,,0,0,0,,<Көк оқ бар күшімен! ＞
Dialogue: 0,0:15:57.59,0:16:02.59,Default,,0,0,0,,♬～
Dialogue: 0,0:16:02.59,0:16:04.59,Default,,0,0,0,,<Ив Ареон>
Dialogue: 0,0:16:04.59,0:16:06.59,Default,,0,0,0,,<Ол таң қаларлықтай жақсы жұмыс істеп тұрса да➡
Dialogue: 0,0:16:06.59,0:16:09.26,Default,,0,0,0,,Сіз ешқашан Аоиды жеңе алмайсыз＞
Dialogue: 0,0:16:09.26,0:16:11.60,Default,,0,0,0,,＜Себебі➡
Dialogue: 0,0:16:11.60,0:16:15.60,Default,,0,0,0,,Сіз өміріңізде тілім немесе ілмек соққан емессіз.
Dialogue: 0,0:16:15.60,0:16:18.61,Default,,0,0,0,,<Тек тура соғуы мүмкін>
Dialogue: 0,0:16:20.61,0:16:25.31,Default,,0,0,0,,<Онда 14 саны, бүркітті көздеуге болмайды>
Dialogue: 0,0:16:28.62,0:16:31.62,Default,,0,0,0,,<Себебі сіз Aoi сияқты соққы жасай алмайсыз>
Dialogue: 0,0:16:31.62,0:16:33.62,Default,,0,0,0,,<Бүркітті ұрлауға болмайды>
Dialogue: 0,0:16:36.62,0:16:39.63,Default,,0,0,0,,<Кеше күндегідей шабуыл әдісі>
Dialogue: 0,0:16:39.63,0:16:45.03,Default,,0,0,0,,♬～
Dialogue: 0,0:16:45.90,0:16:48.57,Default,,0,0,0,,<Бірдей, бірақ бірдей емес>
Dialogue: 0,0:16:48.57,0:16:50.57,Default,,0,0,0,,<Жақсы... мүмкін емес...>
Dialogue: 0,0:16:50.57,0:16:52.91,Default,,0,0,0,,<Жол әлдеқашан жасалған>
Dialogue: 0,0:16:52.91,0:16:55.91,Default,,0,0,0,,<Көк оқ бар күшімен! ＞
Dialogue: 0,0:17:01.58,0:17:03.58,Default,,0,0,0,,<Соңғы рет болған жерге бару>
Dialogue: 0,0:17:06.25,0:17:08.26,Default,,0,0,0,,<Нақты көрсет! ? ＞
Dialogue: 0,0:17:09.26,0:17:11.26,Default,,0,0,0,,<Кедергіні өзі алып тастады>
Dialogue: 0,0:17:13.93,0:17:15.93,Default,,0,0,0,,<Бұл гүл жолы! ＞
Dialogue: 0,0:17:17.60,0:17:20.00,Default,,0,0,0,,<Мәжбүрлеп жасалған қыран мүмкіндік>
Dialogue: 0,0:17:20.94,0:17:23.54,Default,,0,0,0,,<Не... бұл қандай гольф?>
Dialogue: 0,0:17:26.94,0:17:30.65,Default,,0,0,0,,<Аспанның қызыл оғы! ＞
Dialogue: 0,0:17:32.28,0:17:34.28,Default,,0,0,0,,<Барлығын оқпен ату>
Dialogue: 0,0:17:34.28,0:17:44.89,Default,,0,0,0,,♬～
Dialogue: 0,0:17:44.89,0:17:47.56,Default,,0,0,0,,<Бұл менікі...>
Dialogue: 0,0:17:47.56,0:17:49.56,Default,,0,0,0,,<Менің гольфім>
Dialogue: 0,0:17:52.57,0:17:54.57,Default,,0,0,0,,(Раушанның ысқырығы)
Dialogue: 0,0:17:54.57,0:17:57.57,Default,,0,0,0,,<Мен үлкен түсінбеушілік жасадым>
Dialogue: 0,0:17:57.57,0:18:00.91,Default,,0,0,0,,<Аой, мына әйел жау>
Dialogue: 0,0:18:00.91,0:18:02.91,Default,,0,0,0,,<Қатты жау! ＞
Dialogue: 0,0:18:06.58,0:18:10.25,Default,,0,0,0,,<Білемін, қуып жетемін>
Dialogue: 0,0:18:10.25,0:18:12.25,Default,,0,0,0,,<Итер! ＞
Dialogue: 0,0:18:12.25,0:18:20.60,Default,,0,0,0,,♬～
Dialogue: 0,0:18:20.60,0:18:22.60,Default,,0,0,0,,<Гольф...>
Dialogue: 0,0:18:24.27,0:18:26.57,Default,,0,0,0,,<Шынымен, гольф...>
Dialogue: 0,0:18:27.60,0:18:30.30,Default,,0,0,0,,Кел, кел, кел!
Dialogue: 0,0:18:33.27,0:18:35.28,Default,,0,0,0,,Бүркіт!
Dialogue: 0,0:18:35.28,0:18:37.28,Default,,0,0,0,,Енді жалпы саны 16-дан төмен
Dialogue: 0,0:18:37.28,0:18:40.88,Default,,0,0,0,,2-орыннан 10 соққы (Клуб мүшесі) Аои күткендей
Dialogue: 0,0:18:40.88,0:18:43.55,Default,,0,0,0,,Бір жылдың ішінде ол Рау гольф клубының ойыншысы болды.
Dialogue: 0,0:18:43.55,0:18:46.22,Default,,0,0,0,,Жеңімпаз белгілі. (Клуб мүшесі) Иә, иә.
Dialogue: 0,0:18:46.22,0:18:49.92,Default,,0,0,0,,Тенваши Сіз жеңіліп жатырсыз (Кинуэ) Иә.
Dialogue: 0,0:18:50.89,0:18:52.89,Default,,0,0,0,,Тенваши жеңіліп жатыр
Dialogue: 0,0:18:53.89,0:18:56.56,Default,,0,0,0,,Егер бұл тек соңғы күннің ұпайы болса, бұл бір соққы айырмашылығы.
Dialogue: 0,0:18:56.56,0:18:59.57,Default,,0,0,0,,Ив Ареон есімді осы ойыншыға
Dialogue: 0,0:18:59.57,0:19:02.57,Default,,0,0,0,,Каэде Бұл кең.
Dialogue: 0,0:19:02.57,0:19:05.97,Default,,0,0,0,,Дүние шынымен де үлкен
Dialogue: 0,0:19:10.58,0:19:12.98,Default,,0,0,0,,Хауа туралы не деуге болады? Әпке, ана жақта!
Dialogue: 0,0:19:24.93,0:19:26.93,Default,,0,0,0,,⚟Қауа! иә?
Dialogue: 0,0:19:27.93,0:19:30.93,Default,,0,0,0,,Лилия, неге?
Dialogue: 0,0:19:30.93,0:19:35.27,Default,,0,0,0,,Мен Хауаның гольф ойнап жатқанын интернетте көрдім, және
Dialogue: 0,0:19:35.27,0:19:38.61,Default,,0,0,0,,Амансың ба? Жарайды
Dialogue: 0,0:19:38.61,0:19:41.61,Default,,0,0,0,,Ұпайларды кейінірек жіберемін.
Dialogue: 0,0:19:50.62,0:19:52.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:52.62,0:19:56.29,Default,,0,0,0,,Жарайсың Роза
Dialogue: 0,0:19:56.29,0:19:58.29,Default,,0,0,0,,Иә, мен шаршадым.
Dialogue: 0,0:20:01.30,0:20:04.60,Default,,0,0,0,,Шынымды айтсам, кез келген сіріңкеден де шаршадым.
Dialogue: 0,0:20:05.97,0:20:08.97,Default,,0,0,0,,Жапондықтар 17 санын енді ғана енгізді.
Dialogue: 0,0:20:09.97,0:20:13.31,Default,,0,0,0,,Егер ұпай тек бүгінгі күн үшін болса, қазір ол 9-дан төмен.
Dialogue: 0,0:20:13.31,0:20:15.98,Default,,0,0,0,,Мен сені бір соққымен қуып келемін.
Dialogue: 0,0:20:15.98,0:20:17.98,Default,,0,0,0,,Мен қуып жетемін
Dialogue: 0,0:20:18.98,0:20:22.58,Default,,0,0,0,,Мен сол қыздың орнында болсам, міндетті түрде қуып жететін едім.
Dialogue: 0,0:20:24.32,0:20:28.02,Default,,0,0,0,,Себебі бізде бұған себеп бар.
Dialogue: 0,0:20:30.32,0:20:33.99,Default,,0,0,0,,Сіз қуып жеттіңіз.
Dialogue: 0,0:20:33.99,0:20:37.60,Default,,0,0,0,,Бар болғаны бір жыл болса да, Райо гольф клубын арқасына көтеріп жүрген ол.
Dialogue: 0,0:20:39.33,0:20:42.04,Default,,0,0,0,,Осыны көп жасамасаң, мен қиналамын.
Dialogue: 0,0:20:43.27,0:20:45.61,Default,,0,0,0,,<Жеңімпаз расталды>
Dialogue: 0,0:20:45.61,0:20:48.61,Default,,0,0,0,,<Ив Ареонмен шайқас➡
Dialogue: 0,0:20:48.61,0:20:50.61,Default,,0,0,0,,Келесі кадр арқылы анықталады＞
Dialogue: 0,0:20:50.61,0:20:57.62,Default,,0,0,0,,♬～
Dialogue: 0,0:20:57.62,0:20:59.62,Default,,0,0,0,,Маған бәрібір айтыңызшы.
Dialogue: 0,0:20:59.62,0:21:03.29,Default,,0,0,0,,Сен мұнда не үшін келдің? Неге қатысасыз?
Dialogue: 0,0:21:03.29,0:21:06.63,Default,,0,0,0,,Уәде бермедің бе? «Уәде»?
Dialogue: 0,0:21:06.63,0:21:08.63,Default,,0,0,0,,Мына жаққа қара.
Dialogue: 0,0:21:08.63,0:21:10.97,Default,,0,0,0,,Сол жапондықтар...
Dialogue: 0,0:21:10.97,0:21:13.63,Default,,0,0,0,,Сіз білесіз бе? Лили иә?
Dialogue: 0,0:21:13.63,0:21:15.97,Default,,0,0,0,,А, иә, сәл күте тұрыңыз...
Dialogue: 0,0:21:15.97,0:21:18.97,Default,,0,0,0,,Біраз бұрын Хауамен жарысқан қыз...
Dialogue: 0,0:21:20.31,0:21:22.31,Default,,0,0,0,,<Ева>
Dialogue: 0,0:21:22.31,0:21:24.31,Default,,0,0,0,,<Маллоу>
Dialogue: 0,0:21:27.98,0:21:29.98,Default,,0,0,0,,<Себебі мен соқтым>
Dialogue: 0,0:21:30.99,0:21:32.99,Default,,0,0,0,,<Соқпау>
Dialogue: 0,0:21:32.99,0:21:38.33,Default,,0,0,0,,♬～
Dialogue: 0,0:21:38.33,0:21:40.33,Default,,0,0,0,,<Мен сенімен бара алмадым, бірақ...>
Dialogue: 0,0:21:41.26,0:21:43.26,Default,,0,0,0,,<Бір күні...>
Dialogue: 0,0:21:45.93,0:21:47.94,Default,,0,0,0,,<Бірге...>
Dialogue: 0,0:21:50.27,0:21:52.57,Default,,0,0,0,,<Хауа көңілді болды>
Dialogue: 0,0:21:53.61,0:21:55.61,Default,,0,0,0,,<Мен де>
Dialogue: 0,0:21:56.94,0:21:58.95,Default,,0,0,0,,<Бұл соңғы кадр>
Dialogue: 0,0:21:59.95,0:22:02.55,Default,,0,0,0,,<Мұны салсаңыз, Аой жеңеді>
Dialogue: 0,0:22:05.95,0:22:08.96,Default,,0,0,0,,<Бұл туралы не деуге болады? ＞
Dialogue: 0,0:22:19.97,0:22:39.92,Default,,0,0,0,,♬～
Dialogue: 0,0:22:39.92,0:22:59.94,Default,,0,0,0,,♬～
Dialogue: 0,0:22:59.94,0:23:19.96,Default,,0,0,0,,♬～
Dialogue: 0,0:23:19.96,0:23:39.91,Default,,0,0,0,,♬～
Dialogue: 0,0:23:39.91,0:23:49.52,Default,,0,0,0,,♬～
Dialogue: 0,0:23:50.59,0:23:52.59,Default,,0,0,0,,<Бұл Лилия, Хауаның кәддисы>
Dialogue: 0,0:23:52.59,0:23:55.93,Default,,0,0,0,,＜Егер мен Еваға барсам, мен Випер атты талантты гольф ойыншысымен жарысатын сияқтымын.＞
Dialogue: 0,0:23:55.93,0:23:58.93,Default,,0,0,0,,<Не? Мен кескімді қаламаймын ба? > <(айқай)>
Dialogue: 0,0:24:00.43,0:24:06.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory