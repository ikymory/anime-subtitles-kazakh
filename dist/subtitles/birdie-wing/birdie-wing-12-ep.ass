Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.97,0:00:14.31,Default,,0,0,0,,Гольф ойыны бойынша қыздар арасындағы Жапонияның барлық чемпионаты
Dialogue: 0,0:00:14.31,0:00:16.31,Default,,0,0,0,,Осы жылы жаңадан ұйымдастырылған турнирлер
Dialogue: 0,0:00:16.31,0:00:19.01,Default,,0,0,0,,Athena гольф брендінің демеушісі
Dialogue: 0,0:00:19.98,0:00:21.98,Default,,0,0,0,,Басқаша айтқанда➡
Dialogue: 0,0:00:21.98,0:00:24.65,Default,,0,0,0,,Аои Тэнваши, қазір мектеп оқушысы➡
Dialogue: 0,0:00:24.65,0:00:28.32,Default,,0,0,0,,Афинаның тиянақты маркетинг стратегиясы
Dialogue: 0,0:00:28.32,0:00:32.10,Default,,0,0,0,,15 жасқа дейінгі әлем чемпионатына қатысу осы мақсат үшін баспалдақ болды.
Dialogue: 0,0:00:32.10,0:00:35.60,Default,,0,0,0,,Менің ойымша (Кэде) хун
Dialogue: 0,0:00:37.67,0:00:43.01,Default,,0,0,0,,Бұрынғы ақшалай сыйлықтың ханшайымы болған ана мен Америка Құрама Штаттарында екінші орында тұрған әкеден туған➡
Dialogue: 0,0:00:43.01,0:00:45.34,Default,,0,0,0,,Шынайы элита
Dialogue: 0,0:00:45.34,0:00:48.68,Default,,0,0,0,,Мен тіпті қызыма турнир өткізгеніме де сене алар емеспін➡
Dialogue: 0,0:00:48.68,0:00:50.68,Default,,0,0,0,,Үлкен ақымақ ата-ана
Dialogue: 0,0:00:51.68,0:00:54.38,Default,,0,0,0,,Менің мақсатым – туристтердің ең жас маманы болу.
Dialogue: 0,0:00:55.68,0:00:59.35,Default,,0,0,0,,Осылай жасасын, әйтпесе біз оларды жаншып аламыз.
Dialogue: 0,0:00:59.35,0:01:02.62,Default,,0,0,0,,Каэде мен одан үлкен үміт күтемін.
Dialogue: 0,0:01:02.62,0:01:04.63,Default,,0,0,0,,«Күту»?
Dialogue: 0,0:01:04.63,0:01:09.33,Default,,0,0,0,,Амаваши-сан бізге қарсы келсін.
Dialogue: 0,0:01:10.30,0:01:12.97,Default,,0,0,0,,Капитан, басталатын уақыт та қалды.
Dialogue: 0,0:01:12.97,0:01:15.64,Default,,0,0,0,,Кеттік
Dialogue: 0,0:01:15.64,0:01:17.64,Default,,0,0,0,,Мергансер
Dialogue: 0,0:01:20.31,0:01:24.61,Default,,0,0,0,,<Мықтылар лайықты қарсыластармен күресу арқылы күшейеді>
Dialogue: 0,0:01:25.65,0:01:29.99,Default,,0,0,0,,<Тенваши-сан, мені жетілдіргеніңді қалаймын>
Dialogue: 0,0:01:29.99,0:01:31.99,Default,,0,0,0,,<Мен оны асыға күтемін>
Dialogue: 0,0:01:33.32,0:01:53.34,Default,,0,0,0,,♬～
Dialogue: 0,0:01:53.34,0:02:13.30,Default,,0,0,0,,♬～
Dialogue: 0,0:02:13.30,0:02:33.32,Default,,0,0,0,,♬～
Dialogue: 0,0:02:33.32,0:02:53.34,Default,,0,0,0,,♬～
Dialogue: 0,0:02:53.34,0:03:01.94,Default,,0,0,0,,♬～
Dialogue: 0,0:03:14.29,0:03:16.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:16.29,0:03:20.30,Default,,0,0,0,,<А, сәлем, Ичина Саотоме>
Dialogue: 0,0:03:21.30,0:03:23.30,Default,,0,0,0,,<Мектеп жазғы демалыста➡
Dialogue: 0,0:03:23.30,0:03:27.60,Default,,0,0,0,,Жұптық Чемпионат Яманаши Алдын ала ойындары жақындап қалды!
Dialogue: 0,0:03:28.64,0:03:33.64,Default,,0,0,0,,<Алдын ала турда әрбір қатысушы бір раунд ойнайды➡
Dialogue: 0,0:03:33.64,0:03:38.31,Default,,0,0,0,,Ең көп ұпай жинаған жұп префектура өкілі ретінде таңдалады.
Dialogue: 0,0:03:38.31,0:03:41.98,Default,,0,0,0,,<Біз, Райоу гольф клубы, біртұтас...>
Dialogue: 0,0:03:41.98,0:03:44.32,Default,,0,0,0,,О, қараңдаршы!
Dialogue: 0,0:03:44.32,0:03:48.99,Default,,0,0,0,,Қауіпсіздік бойынша жеңістер енді 158 жеңіс және 74 жеңіліс.
Dialogue: 0,0:03:48.99,0:03:51.59,Default,,0,0,0,,<Бірдей...> (Хауа) Шулы
Dialogue: 0,0:03:51.59,0:03:54.60,Default,,0,0,0,,Гольфте есеп бәрі <Бірге...>
Dialogue: 0,0:03:54.60,0:03:57.60,Default,,0,0,0,,Өкінішті жеңіліс~ Бір сәт үндеме
Dialogue: 0,0:03:57.60,0:03:59.94,Default,,0,0,0,,Өкінішті жоғалту
Dialogue: 0,0:03:59.94,0:04:03.27,Default,,0,0,0,,Жалаң қолмен жасайсың ба? Эй, мұны жалаң қолмен жасағың келе ме? Ахаха
Dialogue: 0,0:04:03.27,0:04:05.61,Default,,0,0,0,,<Біріккен жоқпыз>
Dialogue: 0,0:04:05.61,0:04:08.28,Default,,0,0,0,,<Осылайша, мен де...>
Dialogue: 0,0:04:08.28,0:04:11.95,Default,,0,0,0,,Бұл кесу сызығы екі шыныаяққа сәйкес келеді.
Dialogue: 0,0:04:11.95,0:04:14.28,Default,,0,0,0,,Бірлі-жарым (Жаңбыр естіледі) А...
Dialogue: 0,0:04:14.28,0:04:16.28,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:04:16.28,0:04:19.29,Default,,0,0,0,,Тәжірибе залынан алынған барлық мәліметтер жазылады.
Dialogue: 0,0:04:19.29,0:04:21.62,Default,,0,0,0,,Екі шыныаяқ жеткілікті.
Dialogue: 0,0:04:21.62,0:04:23.63,Default,,0,0,0,,Шөп тірі
Dialogue: 0,0:04:23.63,0:04:27.30,Default,,0,0,0,,Соңғы ақпаратты сол жерде алыңыз➡
Dialogue: 0,0:04:27.30,0:04:29.63,Default,,0,0,0,,Теория – оңтайлы шешімді табу.
Dialogue: 0,0:04:29.63,0:04:33.34,Default,,0,0,0,,Ұлы адамдар мұны түсінбейді!
Dialogue: 0,0:04:34.30,0:04:36.97,Default,,0,0,0,,Бұрын бір жерден естіген сөздерді айтпаңыз.
Dialogue: 0,0:04:36.97,0:04:41.31,Default,,0,0,0,,(Ичина мен Аманенің даусы)
Dialogue: 0,0:04:41.31,0:04:43.31,Default,,0,0,0,,Сіз сенімдісіз бе? режиссер
Dialogue: 0,0:04:43.31,0:04:45.65,Default,,0,0,0,,Аа, мен қалағанымды жасайын.
Dialogue: 0,0:04:45.65,0:04:50.92,Default,,0,0,0,,Дегенмен, жұптар арасындағы командалық жұмыс жұптық чемпионаттар үшін өте маңызды.
Dialogue: 0,0:04:50.92,0:04:52.92,Default,,0,0,0,,«Топтық жұмыс»?
Dialogue: 0,0:04:52.92,0:04:55.26,Default,,0,0,0,,Маған бұл керек емес.
Dialogue: 0,0:04:55.26,0:04:57.59,Default,,0,0,0,,Жарыс
Dialogue: 0,0:04:57.59,0:05:01.60,Default,,0,0,0,,Бәсекелестік сізді күштірек етеді
Dialogue: 0,0:05:07.94,0:05:10.61,Default,,0,0,0,,＜…Мен мұны істеп жатқанда➡
Dialogue: 0,0:05:10.61,0:05:13.28,Default,,0,0,0,,Алдын ала өтетін күн келді>
Dialogue: 0,0:05:13.28,0:05:19.28,Default,,0,0,0,,２２７ ２２８ ２２９ ２３０
Dialogue: 0,0:05:22.62,0:05:25.02,Default,,0,0,0,,<Оң жақтағы бункерден сақ болыңыз>
Dialogue: 0,0:05:26.96,0:05:28.96,Default,,0,0,0,,<Дөрекі - терең>
Dialogue: 0,0:05:28.96,0:05:31.29,Default,,0,0,0,,<Егер сіз оны салсаңыз, ол богей болатынына кепілдік>
Dialogue: 0,0:05:31.29,0:05:37.63,Default,,0,0,0,,♬～
Dialogue: 0,0:05:37.63,0:05:42.64,Default,,0,0,0,,Көрнекі растау ескірген, бірақ бұл жақсы нәрсе.
Dialogue: 0,0:05:58.59,0:06:01.59,Default,,0,0,0,,Мен мұндамын, Тэнваши Аои.
Dialogue: 0,0:06:01.59,0:06:08.60,Default,,0,0,0,,Бір жылдан кейін бірден тұрақты? 15 жасқа дейінгі әйелдер чемпионатының жеңімпазы күткендей
Dialogue: 0,0:06:08.60,0:06:10.93,Default,,0,0,0,,Сіз орта мектепте жеңілмейтін болдыңыз, солай ма?
Dialogue: 0,0:06:10.93,0:06:13.94,Default,,0,0,0,,Сүйкімді, бірақ құрметті
Dialogue: 0,0:06:15.94,0:06:18.27,Default,,0,0,0,,Афинаның ең жаңа клубын қараңыз.
Dialogue: 0,0:06:18.27,0:06:22.28,Default,,0,0,0,,Tenwashi Бұл Aoi үшін бапталған Aoi үлгісі сияқты.
Dialogue: 0,0:06:22.28,0:06:25.28,Default,,0,0,0,,Бұл өте қымбат, мен оны сатып ала алмаймын.
Dialogue: 0,0:06:25.28,0:06:27.28,Default,,0,0,0,,Әй, жұп кім?
Dialogue: 0,0:06:27.28,0:06:30.95,Default,,0,0,0,,Бұл менеджер Цзингуджи мырза болуы керек. (Ойыншы) Ах...
Dialogue: 0,0:06:30.95,0:06:33.29,Default,,0,0,0,,Жаңадан шыққан батыр Mt. Lady –
Dialogue: 0,0:06:33.29,0:06:35.29,Default,,0,0,0,,Біраздан соң—
Dialogue: 0,0:06:35.29,0:06:40.30,Default,,0,0,0,,<Бірақ... Шетелдік> (ойыншы) <Рю... Халықаралық студент спортшы? ＞
Dialogue: 0,0:06:40.30,0:06:43.63,Default,,0,0,0,,Не? Менің бетімде бірдеңе бар ма?
Dialogue: 0,0:06:43.63,0:06:45.63,Default,,0,0,0,,Қарама
Dialogue: 0,0:06:45.63,0:06:48.64,Default,,0,0,0,,Жапон халқы әрқашан осындай.
Dialogue: 0,0:06:48.64,0:06:51.57,Default,,0,0,0,,Бұл... Қорқынышты (Ойыншы) Ол өте әдемі.
Dialogue: 0,0:06:51.57,0:06:55.58,Default,,0,0,0,,Бірақ бұл қиын көрінеді. (Ойыншы) Керемет~ Табиғи аққұба.
Dialogue: 0,0:06:55.58,0:06:57.58,Default,,0,0,0,,Бала қай мектепте оқиды?
Dialogue: 0,0:07:03.59,0:07:06.59,Default,,0,0,0,,(Ойыншылар айқайлайды)
Dialogue: 0,0:07:06.59,0:07:08.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:11.59,0:07:14.26,Default,,0,0,0,,Қайырлы таң Хауа
Dialogue: 0,0:07:14.26,0:07:16.60,Default,,0,0,0,,<…бұл жұп па? ＞
Dialogue: 0,0:07:16.60,0:07:18.60,Default,,0,0,0,,Сен неге киім кимейсің? (Ойыншы) Райудың мұндай қызы болды ма?
Dialogue: 0,0:07:18.60,0:07:21.27,Default,,0,0,0,,Ах... (Ойыншы) Шетелден телефон соққанына сенімдімін.
Dialogue: 0,0:07:21.27,0:07:23.61,Default,,0,0,0,,Қалыпты Сіз сонша жерге барасыз ба? не?
Dialogue: 0,0:07:23.61,0:07:25.61,Default,,0,0,0,,<Қорқынышты>
Dialogue: 0,0:07:26.61,0:07:28.61,Default,,0,0,0,,Бұлай қобалжымаңыз
Dialogue: 0,0:07:28.61,0:07:31.28,Default,,0,0,0,,Барлығыңызбен танысқаныма қуаныштымын.
Dialogue: 0,0:07:31.28,0:07:34.95,Default,,0,0,0,,Бұл Райоу қыздар академиясынан Тенваши мен Эвангелин.
Dialogue: 0,0:07:34.95,0:07:37.62,Default,,0,0,0,,Орта мектепті бітіргеннен кейінгі бірінші турнир➡
Dialogue: 0,0:07:37.62,0:07:39.95,Default,,0,0,0,,Мен түсінбейтін нәрселер бар деп ойлаймын➡
Dialogue: 0,0:07:39.95,0:07:42.26,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:07:43.29,0:07:46.59,Default,,0,0,0,,Мен гольфтен толық ләззат алғым келеді.
Dialogue: 0,0:07:47.96,0:07:50.57,Default,,0,0,0,,<Бұл өте сүйкімді, мені ренжітеді>
Dialogue: 0,0:07:50.57,0:07:53.90,Default,,0,0,0,,Неге басыңды иіп тұрсың? Сен ақымақсың ба?
Dialogue: 0,0:07:53.90,0:07:56.91,Default,,0,0,0,,<Ол сондай әдемі, мен ренжіп қаламын>
Dialogue: 0,0:07:56.91,0:07:59.91,Default,,0,0,0,,Мен жеңсем, гамбургер жеуге болатынның бәрін жей аламын.
Dialogue: 0,0:07:59.91,0:08:04.91,Default,,0,0,0,,Уәдеңді ұмытпа. Сәттілік, Хауа.
Dialogue: 0,0:08:04.91,0:08:08.58,Default,,0,0,0,,<Мен... мен құмар ойнаймын>
Dialogue: 0,0:08:08.58,0:08:10.92,Default,,0,0,0,,Хауа Аои
Dialogue: 0,0:08:10.92,0:08:13.25,Default,,0,0,0,,Соңғы курс деректері
Dialogue: 0,0:08:13.25,0:08:16.59,Default,,0,0,0,,Әр саңылау үшін үш түрі жасалған.
Dialogue: 0,0:08:16.59,0:08:18.59,Default,,0,0,0,,Мұқият оқып шығыңыз
Dialogue: 0,0:08:18.59,0:08:20.60,Default,,0,0,0,,Рахмет Амане
Dialogue: 0,0:08:20.60,0:08:23.93,Default,,0,0,0,,Бұл турнирде «каддисіз» ережесі бар➡
Dialogue: 0,0:08:23.93,0:08:26.60,Default,,0,0,0,,Мен Саотоме мөрі бар құпия естелік беремін.
Dialogue: 0,0:08:26.60,0:08:29.27,Default,,0,0,0,,Иә иә дегенді тексеру керек
Dialogue: 0,0:08:29.27,0:08:31.61,Default,,0,0,0,,Райудың кәдди сыныбы пайда болды
Dialogue: 0,0:08:31.61,0:08:35.61,Default,,0,0,0,,Каддилерге арналған бөлім бар, жалғыз гольф клубы - Райу.
Dialogue: 0,0:08:35.61,0:08:38.01,Default,,0,0,0,,Істер тым әртүрлі
Dialogue: 0,0:08:38.95,0:08:41.95,Default,,0,0,0,,<Ғұн, күшті болса да, бар болғаны бір жыл.>
Dialogue: 0,0:08:41.95,0:08:45.55,Default,,0,0,0,,<Мен саған орта мектептегі гольф ойынының деңгейін көрсетемін>
Dialogue: 0,0:08:51.23,0:08:54.23,Default,,0,0,0,,<Жүр, ұш, Пак-кун! ＞
Dialogue: 0,0:08:54.23,0:09:01.24,Default,,0,0,0,,♬～
Dialogue: 0,0:09:01.24,0:09:05.24,Default,,0,0,0,,Құпия (жаңбыр дыбысы) Болжалды 230 ярд
Dialogue: 0,0:09:06.24,0:09:08.24,Default,,0,0,0,,<Сіз 2 үлгіні таңдадыңыз>
Dialogue: 0,0:09:09.24,0:09:13.58,Default,,0,0,0,,<230 иә... Сыбыс бойынша, бұл өте жақсы болады.>
Dialogue: 0,0:09:13.58,0:09:18.59,Default,,0,0,0,,♬～
Dialogue: 0,0:09:18.59,0:09:21.26,Default,,0,0,0,,<Мен саған көрсетемін, данышпан>
Dialogue: 0,0:09:21.26,0:09:23.96,Default,,0,0,0,,<Яманашидің ең жақсы парақшасы...>
Dialogue: 0,0:09:26.93,0:09:28.93,Default,,0,0,0,,<Менің қабілетім! ＞
Dialogue: 0,0:09:28.93,0:09:34.27,Default,,0,0,0,,♬～
Dialogue: 0,0:09:34.27,0:09:36.60,Default,,0,0,0,,Мен оны өткізіп жіберемін, Сато мырза➡
Dialogue: 0,0:09:36.60,0:09:39.61,Default,,0,0,0,,Өткен жылғы префектуралық турнирде 4-ші орын алған талантты ойыншы
Dialogue: 0,0:09:39.61,0:09:44.01,Default,,0,0,0,,3 жыл болды, менің физикалық жағдайым тағы да жақсарды.
Dialogue: 0,0:09:48.62,0:09:51.95,Default,,0,0,0,,Ол Амавашидің добын оңай кесіп өтті.
Dialogue: 0,0:09:51.95,0:09:54.26,Default,,0,0,0,,Бұл 250 ярдқа жуық жерде.
Dialogue: 0,0:09:55.62,0:09:57.63,Default,,0,0,0,,<Қалай? Гений>
Dialogue: 0,0:09:59.63,0:10:02.30,Default,,0,0,0,,<Мені жарқыратып мақтап жатыр! ? ＞
Dialogue: 0,0:10:02.30,0:10:04.30,Default,,0,0,0,,Иә, иә, кет.
Dialogue: 0,0:10:04.30,0:10:07.97,Default,,0,0,0,,Сіз білесіз бе? Сіздің үстіңізде біреу бар
Dialogue: 0,0:10:07.97,0:10:10.97,Default,,0,0,0,,Жоқ... (Байқау комиссиясының мүшесі) Жеке сөйлеуден аулақ болыңыз.
Dialogue: 0,0:10:10.97,0:10:12.97,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:10:14.98,0:10:18.58,Default,,0,0,0,,<Гамбургерге қауіп төніп тұр, сондықтан мен шындап барамын.>
Dialogue: 0,0:10:19.98,0:10:23.32,Default,,0,0,0,,<Тікелей көк оқ тиді! ＞
Dialogue: 0,0:10:23.32,0:10:29.66,Default,,0,0,0,,♬～
Dialogue: 0,0:10:29.66,0:10:34.00,Default,,0,0,0,,Өте құпия! (Жаңбыр дыбысы) 260-тан астам...
Dialogue: 0,0:10:34.00,0:10:39.30,Default,,0,0,0,,<Ну... Бар күшіммен атып жіберген титімім мүлт кетті...>
Dialogue: 0,0:10:40.34,0:10:42.34,Default,,0,0,0,,<Бұл әйел...>
Dialogue: 0,0:10:45.01,0:10:47.34,Default,,0,0,0,,Бан
Dialogue: 0,0:10:47.34,0:10:50.04,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:10:51.28,0:10:53.28,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:10:53.28,0:10:55.58,Default,,0,0,0,,<1 адам оқудан шықты>
Dialogue: 0,0:10:56.62,0:10:59.02,Default,,0,0,0,,<Жоқ, 5 адамсыз>
Dialogue: 0,0:10:59.95,0:11:01.96,Default,,0,0,0,,Егер Хауа тым көп жасаса
Dialogue: 0,0:11:01.96,0:11:03.96,Default,,0,0,0,,Мен енді гольф ойнамаймын.
Dialogue: 0,0:11:03.96,0:11:05.96,Default,,0,0,0,,Мен де сені атып тастаймын.
Dialogue: 0,0:11:05.96,0:11:07.96,Default,,0,0,0,,Баррия!
Dialogue: 0,0:11:08.96,0:11:11.30,Default,,0,0,0,,Қорқамын, ол қайтып келмейді.
Dialogue: 0,0:11:11.30,0:11:13.64,Default,,0,0,0,,Директор
Dialogue: 0,0:11:13.64,0:11:17.31,Default,,0,0,0,,Алдын ала турға өтпесем дұрыс па?
Dialogue: 0,0:11:17.31,0:11:19.31,Default,,0,0,0,,Бұл қажет емес.
Dialogue: 0,0:11:19.31,0:11:22.31,Default,,0,0,0,,Бұл жерде сүрінсең, болды.
Dialogue: 0,0:11:23.31,0:11:27.02,Default,,0,0,0,,Жарайды, мен сендерге мотивациялық материалдарды бердім.
Dialogue: 0,0:11:29.65,0:11:33.66,Default,,0,0,0,,《Кеше күні өткен Кочи префектурасының іріктеу кезеңінің нәтижелері...》
Dialogue: 0,0:11:33.66,0:11:40.66,Default,,0,0,0,,♬～
Dialogue: 0,0:11:40.66,0:11:43.67,Default,,0,0,0,,《Нада Минами спорттық қыздарының Мизухо Химекава➡
Dialogue: 0,0:11:43.67,0:11:47.07,Default,,0,0,0,,Ол бірінші раундтан 10-нан төмен өткен сияқты.
Dialogue: 0,0:11:48.00,0:11:49.94,Default,,0,0,0,,《Балалар жеңе аласыңдар ма? 》
Dialogue: 0,0:11:49.94,0:11:53.27,Default,,0,0,0,,《Орта мектепте бірінші орын》
Dialogue: 0,0:11:53.27,0:11:58.28,Default,,0,0,0,,♬～
Dialogue: 0,0:11:58.28,0:12:01.28,Default,,0,0,0,,Хехе, 11-ге бірінші қадам.
Dialogue: 0,0:12:01.28,0:12:03.95,Default,,0,0,0,,Мен 12-ге жетуді мақсат етіп жатырмын?
Dialogue: 0,0:12:03.95,0:12:06.96,Default,,0,0,0,,Олай болса 13 14 құрайды
Dialogue: 0,0:12:06.96,0:12:09.62,Default,,0,0,0,,１５ １６
Dialogue: 0,0:12:09.62,0:12:11.96,Default,,0,0,0,,１７ １８
Dialogue: 0,0:12:13.93,0:12:33.95,Default,,0,0,0,,♬～
Dialogue: 0,0:12:33.95,0:12:48.56,Default,,0,0,0,,♬～
Dialogue: 0,0:12:48.56,0:12:50.57,Default,,0,0,0,,Жартысынан кейін➡
Dialogue: 0,0:12:50.57,0:12:54.24,Default,,0,0,0,,Хауа ананың 4 құсы, 1 бүркіті және 1 бағанасы болды.
Dialogue: 0,0:12:54.24,0:12:56.24,Default,,0,0,0,,Қазіргі уақытта 5 астында
Dialogue: 0,0:12:56.24,0:13:00.58,Default,,0,0,0,,Аой да 5 асты, 5 құс бар, боги жоқ.
Dialogue: 0,0:13:00.58,0:13:03.91,Default,,0,0,0,,Бұл жұмыс істейді (Жаңбыр дыбысы) Иә.
Dialogue: 0,0:13:03.91,0:13:06.25,Default,,0,0,0,,Хехе… Ой!
Dialogue: 0,0:13:06.25,0:13:08.25,Default,,0,0,0,,Хун
Dialogue: 0,0:13:08.25,0:13:13.92,Default,,0,0,0,,♬～
Dialogue: 0,0:13:13.92,0:13:15.92,Default,,0,0,0,,<11-ге дейін...>
Dialogue: 0,0:13:17.59,0:13:19.59,Default,,0,0,0,,<6 сол жақ асты>
Dialogue: 0,0:13:25.27,0:13:27.57,Default,,0,0,0,,Шизуока нәтижелері шықты.
Dialogue: 0,0:13:28.60,0:13:30.94,Default,,0,0,0,,Өкіл ретінде Құран таңдалғанын естідім.
Dialogue: 0,0:13:30.94,0:13:32.94,Default,,0,0,0,,Құран…
Dialogue: 0,0:13:32.94,0:13:37.61,Default,,0,0,0,,Каоруко Иидзима мен Куха Исэ Шиба жұбы?
Dialogue: 0,0:13:37.61,0:13:39.61,Default,,0,0,0,,Үлкен мәселе емес
Dialogue: 0,0:13:39.61,0:13:44.22,Default,,0,0,0,,Иидзима, әрине, қорқынышты, бірақ екінші курс студенті Исэ Шиба оны ұстап тұр.
Dialogue: 0,0:13:44.22,0:13:46.22,Default,,0,0,0,,Жау емес
Dialogue: 0,0:13:46.22,0:13:49.56,Default,,0,0,0,,Сайтама ше? Мен Сайтама Хигашиге шешім қабылдадым.
Dialogue: 0,0:13:49.56,0:13:51.56,Default,,0,0,0,,Күтілгендей, бұл жерде.
Dialogue: 0,0:13:51.56,0:13:54.23,Default,,0,0,0,,⚟ (мүше) Кешіріңіз.
Dialogue: 0,0:13:54.23,0:13:57.90,Default,,0,0,0,,Яманаши префектурасының іріктеу кезеңі аяқталды.
Dialogue: 0,0:13:57.90,0:14:00.57,Default,,0,0,0,,Жеңімпаз - Раиу академиясы.
Dialogue: 0,0:14:00.57,0:14:03.91,Default,,0,0,0,,Мен мұны білемін. Сіздің ұпайыңыз қандай?
Dialogue: 0,0:14:03.91,0:14:06.91,Default,,0,0,0,,То... Барлығы... (Каэде) «Барлығы»?
Dialogue: 0,0:14:06.91,0:14:12.25,Default,,0,0,0,,Кімге... Барлығы 22 төмен. (Кейде) «22»?
Dialogue: 0,0:14:12.25,0:14:14.58,Default,,0,0,0,,Бөлім дегеніміз не?
Dialogue: 0,0:14:14.58,0:14:16.58,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:14:16.58,0:14:18.59,Default,,0,0,0,,Тенваши 11 жастан төмен
Dialogue: 0,0:14:18.59,0:14:21.26,Default,,0,0,0,,Сондай-ақ Эвангелин Ф. Кимишимамен жұптастырылған
Dialogue: 0,0:14:21.26,0:14:23.62,Default,,0,0,0,,Сондай-ақ 11 астында
Dialogue: 0,0:14:23.62,0:14:27.93,Default,,0,0,0,,«Эвангелин Ф. Кимишима» Кім? Мен бұл туралы ешқашан естіген емеспін
Dialogue: 0,0:14:27.93,0:14:30.23,Default,,0,0,0,,Жасырылған оқ па екен деп ойлаймын.
Dialogue: 0,0:14:31.27,0:14:33.27,Default,,0,0,0,,Каэде (Кэде) иә?
Dialogue: 0,0:14:33.27,0:14:37.97,Default,,0,0,0,,Бізді нысанаға алып жатыр.
Dialogue: 0,0:14:39.87,0:14:42.88,Default,,0,0,0,,Мен жеңдім. Бұл галстук, солай ма?
Dialogue: 0,0:14:42.88,0:14:46.21,Default,,0,0,0,,Олай болса, мен боғаусыз жүрдім.
Dialogue: 0,0:14:46.21,0:14:49.55,Default,,0,0,0,,Хауа екі рет богей жасады Иә, бұл ұят.
Dialogue: 0,0:14:49.55,0:14:52.89,Default,,0,0,0,,Бүркітті екі рет алған Аой нөлге тең.
Dialogue: 0,0:14:52.89,0:14:56.49,Default,,0,0,0,,Мен құсты үш рет өткізіп алсам да.
Dialogue: 0,0:14:58.23,0:15:02.56,Default,,0,0,0,,Пар пут жасай алмайтын адамға айтқым келмейді.
Dialogue: 0,0:15:02.56,0:15:04.57,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:15:04.57,0:15:06.57,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:15:06.57,0:15:09.57,Default,,0,0,0,,Иә, иә, жеңісіңіз құтты болсын! Эй
Dialogue: 0,0:15:09.57,0:15:11.91,Default,,0,0,0,,Иә, құттықтаймын
Dialogue: 0,0:15:11.91,0:15:14.24,Default,,0,0,0,,Ах~ Құттықтаймыз хахаха...
Dialogue: 0,0:15:14.24,0:15:16.91,Default,,0,0,0,,Хун
Dialogue: 0,0:15:16.91,0:15:18.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:18.91,0:15:23.92,Default,,0,0,0,,Мен көп еңбек еткен Аойдың бейнесі күйреп барады.
Dialogue: 0,0:15:26.25,0:15:28.92,Default,,0,0,0,,Ах, режиссер Саотоме.
Dialogue: 0,0:15:28.92,0:15:30.93,Default,,0,0,0,,Мен алдын ала турда жеңіске жеттім.
Dialogue: 0,0:15:30.93,0:15:35.26,Default,,0,0,0,,Сіздің ұпайыңыз қандай? 📱Жасым 22-де, бұл үлкен жетістік.
Dialogue: 0,0:15:35.26,0:15:39.87,Default,,0,0,0,,Баяндауыңыз үшін рахмет. Қайтып келгенде абай болыңыз.
Dialogue: 0,0:15:39.87,0:15:41.87,Default,,0,0,0,,Иә
Dialogue: 0,0:15:41.87,0:15:45.54,Default,,0,0,0,,Осыншама көп жасамасаң, қиналып қаламын.
Dialogue: 0,0:15:45.54,0:15:48.54,Default,,0,0,0,,Күтпеген жерден соғыс жариялау
Dialogue: 0,0:15:48.54,0:15:52.95,Default,,0,0,0,,Ол неғұрлым жарқыраған болса, соғұрлым тиімді болады.
Dialogue: 0,0:15:53.88,0:15:55.88,Default,,0,0,0,,Хахахаха...!
Dialogue: 0,0:15:55.88,0:15:59.89,Default,,0,0,0,,22 астында Аой шуақты күн
Dialogue: 0,0:15:59.89,0:16:03.22,Default,,0,0,0,,Евангелин есімді қыз да жақсы өнер көрсетті.
Dialogue: 0,0:16:03.22,0:16:06.23,Default,,0,0,0,,Kokutsugi Бұл мақала болады.
Dialogue: 0,0:16:06.23,0:16:08.53,Default,,0,0,0,,Газет компаниясына да айтыңыз.
Dialogue: 0,0:16:10.23,0:16:12.90,Default,,0,0,0,,Рахмет саған Рейя-сан
Dialogue: 0,0:16:12.90,0:16:15.50,Default,,0,0,0,,Маған ең жақсы серіктес әкелгеніңіз үшін.
Dialogue: 0,0:16:17.24,0:16:19.54,Default,,0,0,0,,Аойды саған сеніп тапсырғаныма қуаныштымын.
Dialogue: 0,0:16:23.58,0:16:25.88,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:25.88,0:16:27.92,Default,,0,0,0,,<Сәлем, Ичинасу>
Dialogue: 0,0:16:27.92,0:16:29.92,Default,,0,0,0,,<Жоғары ұпаймен➡
Dialogue: 0,0:16:29.92,0:16:33.25,Default,,0,0,0,,Амаваши-сан мен Ева-сан префектуралық турнирден өтті➡
Dialogue: 0,0:16:33.25,0:16:36.59,Default,,0,0,0,,Келесі күннен бастап әдеттегідей жаттығыңыз...＞
Dialogue: 0,0:16:36.59,0:16:38.59,Default,,0,0,0,,Бұл жолы мен жеңдім
Dialogue: 0,0:16:38.59,0:16:41.86,Default,,0,0,0,,Хауа ананың қырандары көп, бірақ богайлары көп емес.
Dialogue: 0,0:16:41.86,0:16:44.53,Default,,0,0,0,,Демек, бұл бір кесе.
Dialogue: 0,0:16:44.53,0:16:48.90,Default,,0,0,0,,Деректер оның бір жарым екенін дәлелдейді. Бұл деректер ескі.
Dialogue: 0,0:16:48.90,0:16:52.31,Default,,0,0,0,,<Көзді ашып-жұмғанша екі апта өтті>
Dialogue: 0,0:16:55.88,0:16:57.88,Default,,0,0,0,,📱 (рингтон)
Dialogue: 0,0:16:57.88,0:16:59.88,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:16:59.88,0:17:03.22,Default,,0,0,0,,📱 Мен Хауа апа! ?
Dialogue: 0,0:17:03.22,0:17:05.89,Default,,0,0,0,,📱Біраз уақыт өтті.Жапон орта мектебі қалай?
Dialogue: 0,0:17:05.89,0:17:07.89,Default,,0,0,0,,Қалыпты
Dialogue: 0,0:17:07.89,0:17:10.22,Default,,0,0,0,,Сіз гольф ойнайсыз ба? 📱 Иә
Dialogue: 0,0:17:10.22,0:17:12.89,Default,,0,0,0,,📱 Келесі жолы Жапонияда өтетін турнирге қатысамын.
Dialogue: 0,0:17:12.89,0:17:15.90,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:17:17.57,0:17:19.90,Default,,0,0,0,,Маған қарызға бер! Хауа! Ах
Dialogue: 0,0:17:19.90,0:17:23.24,Default,,0,0,0,,Лили, мен жіберген Гунпланы алдың ба?
Dialogue: 0,0:17:23.24,0:17:26.91,Default,,0,0,0,,Әй, келді. Ол келді, бірақ...
Dialogue: 0,0:17:26.91,0:17:30.91,Default,,0,0,0,,Неге шайтан! ? Бұл тым маньяк болар еді!
Dialogue: 0,0:17:30.91,0:17:32.91,Default,,0,0,0,,Тағы да көп болды! ?
Dialogue: 0,0:17:32.91,0:17:36.25,Default,,0,0,0,,Соқ, Барбатос, Жалғыз мүйізді!
Dialogue: 0,0:17:36.25,0:17:39.59,Default,,0,0,0,,Жоқ, мен шынымен түсінбеймін, сондықтан дүкен қызметкерінен маған біреуін таңдауын өтіндім.
Dialogue: 0,0:17:39.59,0:17:42.19,Default,,0,0,0,,📱Бұл жолы «MG» деп жазылған қорапқа салыңыз.
Dialogue: 0,0:17:42.19,0:17:46.53,Default,,0,0,0,,📱 MG, MG... Аа, кешіріңіз, мен қазір кетуім керек.
Dialogue: 0,0:17:46.53,0:17:49.20,Default,,0,0,0,,Мен трубканы қоямын (кесу дыбысы)
Dialogue: 0,0:17:49.20,0:17:52.87,Default,,0,0,0,,А... мен дұрыс түсіндім бе? Хехе...
Dialogue: 0,0:17:52.87,0:17:57.20,Default,,0,0,0,,Сіз қандай майды сатасыз? Ева, автобус келді.
Dialogue: 0,0:17:57.20,0:17:59.91,Default,,0,0,0,,Барлығы осында, мен білемін.
Dialogue: 0,0:18:00.88,0:18:04.21,Default,,0,0,0,,Неге енді формаңызды кимейсіз?
Dialogue: 0,0:18:04.21,0:18:06.55,Default,,0,0,0,,Директор сізді жазалайды.
Dialogue: 0,0:18:06.55,0:18:08.55,Default,,0,0,0,,Сіз төбелеске барасыз, солай ма?
Dialogue: 0,0:18:08.55,0:18:10.89,Default,,0,0,0,,Бұл менің жауынгерлік киімім
Dialogue: 0,0:18:10.89,0:18:14.56,Default,,0,0,0,,Не? Бұл тамаша
Dialogue: 0,0:18:14.56,0:18:16.89,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:18:21.56,0:18:25.57,Default,,0,0,0,,Не? Неге осындай форма кимейсің?
Dialogue: 0,0:18:25.57,0:18:30.24,Default,,0,0,0,,Райоу академиясының атына дақ түсірдің... (Амуро) Жарайды.
Dialogue: 0,0:18:30.24,0:18:33.24,Default,,0,0,0,,Бұл турнир сонымен қатар Хауа ананың ашылуы ретінде қызмет етеді.
Dialogue: 0,0:18:33.24,0:18:35.24,Default,,0,0,0,,Жарқыраңыз
Dialogue: 0,0:18:35.24,0:18:37.58,Default,,0,0,0,,Эй, сөйлесуге болады.
Dialogue: 0,0:18:37.58,0:18:40.85,Default,,0,0,0,,Мен ондай адамды жек көрмеймін.
Dialogue: 0,0:18:40.85,0:18:42.85,Default,,0,0,0,,Мен оны саған бермеймін.
Dialogue: 0,0:18:42.85,0:18:45.52,Default,,0,0,0,,Мен қарттармен танысуға қызықпаймын.
Dialogue: 0,0:18:45.52,0:18:47.86,Default,,0,0,0,,Олай болса, тезірек барайық.
Dialogue: 0,0:18:47.86,0:18:50.16,Default,,0,0,0,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:18:52.19,0:18:55.86,Default,,0,0,0,,Жұптық чемпионатта допты кезекпен соғасыз, солай ма?
Dialogue: 0,0:18:55.86,0:18:58.87,Default,,0,0,0,,Иә, егер Хауа тротуарды ұрса➡
Dialogue: 0,0:18:58.87,0:19:02.20,Default,,0,0,0,,Екінші ату – мен Үшінші ату – Хауа
Dialogue: 0,0:19:02.20,0:19:04.54,Default,,0,0,0,,Сіз осылай ойнайсыз
Dialogue: 0,0:19:04.54,0:19:06.54,Default,,0,0,0,,Сіз білесіз деп ойлаймын, бірақ➡
Dialogue: 0,0:19:06.54,0:19:10.21,Default,,0,0,0,,Чемпионат – турнирлік матч.
Dialogue: 0,0:19:10.21,0:19:12.21,Default,,0,0,0,,Не? сурет! ?
Dialogue: 0,0:19:12.21,0:19:14.52,Default,,0,0,0,,Ма... «Сәйкестік ойыны» дегеніміз...
Dialogue: 0,0:19:16.55,0:19:18.55,Default,,0,0,0,,Қарсыластар ➡
Dialogue: 0,0:19:18.55,0:19:21.96,Default,,0,0,0,,Жеңімпаз немесе жеңілген әр тесіктің ұпайы бойынша анықталатын ойын.
Dialogue: 0,0:19:23.22,0:19:25.89,Default,,0,0,0,,Айырмашылық қанша соққы болса да, жеңіс 1 жоғары.
Dialogue: 0,0:19:25.89,0:19:28.23,Default,,0,0,0,,Бұл 1 ұпай.
Dialogue: 0,0:19:28.23,0:19:32.23,Default,,0,0,0,,Соңында ең көп саңылаулары бар жеңеді.
Dialogue: 0,0:19:33.23,0:19:36.57,Default,,0,0,0,,Мысалы, егер Хауа мен оның достары барлық тесіктерді жеңіп алса➡
Dialogue: 0,0:19:36.57,0:19:39.91,Default,,0,0,0,,10-шы тесіктің соңында қарсыласыңыз жеңе алмайды ➡
Dialogue: 0,0:19:39.91,0:19:42.24,Default,,0,0,0,,Ойын осымен аяқталады.
Dialogue: 0,0:19:42.24,0:19:44.91,Default,,0,0,0,,Ааа, жарысқа ұқсайды, маған ұнады.
Dialogue: 0,0:19:44.91,0:19:47.25,Default,,0,0,0,,Иә, мен де оны асыға күтемін.
Dialogue: 0,0:19:47.25,0:19:50.25,Default,,0,0,0,,Мен мықты адамдармен көп гольф ойнағым келеді...
Dialogue: 0,0:19:51.59,0:19:54.59,Default,,0,0,0,,Иә, иә, дұрыс.
Dialogue: 0,0:19:56.59,0:20:00.26,Default,,0,0,0,,Ах! Мен сені тағы мазақ еттім! Бұлай етпеңіз~
Dialogue: 0,0:20:00.26,0:20:02.26,Default,,0,0,0,,Сіз істеп жатырсыз!
Dialogue: 0,0:20:02.26,0:20:04.27,Default,,0,0,0,,Мо!
Dialogue: 0,0:20:04.27,0:20:24.29,Default,,0,0,0,,♬～
Dialogue: 0,0:20:24.29,0:20:44.24,Default,,0,0,0,,♬～
Dialogue: 0,0:20:44.24,0:21:04.26,Default,,0,0,0,,♬～
Dialogue: 0,0:21:04.26,0:21:23.61,Default,,0,0,0,,♬～
Dialogue: 0,0:21:23.61,0:21:25.61,Default,,0,0,0,,♬～
Dialogue: 0,0:21:25.61,0:21:27.62,Default,,0,0,0,,Міне, Раю.
Dialogue: 0,0:21:27.62,0:21:31.29,Default,,0,0,0,,Параметрден төмен 22 ұпай жинады, барлық іріктеу раундтарының жоғарғы жағында...
Dialogue: 0,0:21:31.29,0:21:34.62,Default,,0,0,0,,Данышпан Аои Тенвашимен таныстыру.
Dialogue: 0,0:21:34.62,0:21:38.03,Default,,0,0,0,,Seed School мақтанышпен басшы болып жұмыс істей ме?
Dialogue: 0,0:21:42.90,0:21:44.90,Default,,0,0,0,,Тенваши Аои
Dialogue: 0,0:21:44.90,0:21:46.90,Default,,0,0,0,,Мен ойлағаннан да кішірек.
Dialogue: 0,0:21:51.57,0:21:56.24,Default,,0,0,0,,Бұл қыз - Эвангелин Ф. Кимишима
Dialogue: 0,0:21:56.24,0:22:08.56,Default,,0,0,0,,♬～
Dialogue: 0,0:22:10.93,0:22:12.93,Default,,0,0,0,,⚟(Тоғыз жапырақ) Хауа иә?
Dialogue: 0,0:22:14.26,0:22:17.26,Default,,0,0,0,,Біз тағы кездестік. Ол кім?
Dialogue: 0,0:22:18.60,0:22:23.27,Default,,0,0,0,,Куха Исэ Шиба! Шизуока Құранның келесі эйс!
Dialogue: 0,0:22:23.27,0:22:25.27,Default,,0,0,0,,Кет (Куха) Күт...
Dialogue: 0,0:22:26.27,0:22:29.61,Default,,0,0,0,,Сәлем (Каоруко) Қайырлы күн Ева-сан
Dialogue: 0,0:22:29.61,0:22:32.28,Default,,0,0,0,,Мен бір-бірімізбен жарысатын күнді асыға күтемін.
Dialogue: 0,0:22:32.28,0:22:34.28,Default,,0,0,0,,Иә
Dialogue: 0,0:22:34.28,0:22:37.99,Default,,0,0,0,,Эй, Мизухо Химекава сонда ма?
Dialogue: 0,0:22:40.55,0:22:43.56,Default,,0,0,0,,Мен... Хауа мырза? (Жаңбырдың дауысы) Құдай-ау...!
Dialogue: 0,0:22:43.56,0:22:45.89,Default,,0,0,0,,Директор (Амуро) Жақсы
Dialogue: 0,0:22:45.89,0:22:48.20,Default,,0,0,0,,Мизухо Химекава деген кім? ?
Dialogue: 0,0:22:49.23,0:22:51.90,Default,,0,0,0,,Эй, сен жоқсың! ?
Dialogue: 0,0:22:51.90,0:22:53.90,Default,,0,0,0,,Сәлем, 1 жыл!
Dialogue: 0,0:22:53.90,0:22:56.57,Default,,0,0,0,,Қалай сөйлесу керек... Каэде
Dialogue: 0,0:22:56.57,0:23:08.92,Default,,0,0,0,,♬～
Dialogue: 0,0:23:08.92,0:23:11.25,Default,,0,0,0,,Мен Мидзухо Химекавамын
Dialogue: 0,0:23:11.25,0:23:13.59,Default,,0,0,0,,Эй, сен
Dialogue: 0,0:23:13.59,0:23:16.92,Default,,0,0,0,,«Керемет» «Ғажайып» Құлағымнан естідім.
Dialogue: 0,0:23:16.92,0:23:18.93,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:23:19.93,0:23:21.93,Default,,0,0,0,,Бұл, әрине, күшті көрінеді
Dialogue: 0,0:23:21.93,0:23:24.27,Default,,0,0,0,,Бұл көп келеді
Dialogue: 0,0:23:24.27,0:23:26.27,Default,,0,0,0,,Жеңіліс үшін марапаттау
Dialogue: 0,0:23:27.27,0:23:29.27,Default,,0,0,0,,Сіз мені жеңе аламын деп ойлайсыз ба?
Dialogue: 0,0:23:29.27,0:23:32.97,Default,,0,0,0,,Иә, мен сені өлтіремін. Мен сені гольфпен өлтіремін.
Dialogue: 0,0:23:34.94,0:23:36.94,Default,,0,0,0,,Мен сені ол арқылы атып тастаймын.
Dialogue: 0,0:23:36.94,0:23:41.25,Default,,0,0,0,,Менің кемпірқосақ түсті оқпен!
Dialogue: 0,0:23:44.22,0:23:46.22,Default,,0,0,0,,Мен сені кездестірген кездегідей
Dialogue: 0,0:23:46.22,0:23:48.52,Default,,0,0,0,,Хауа болса, селт етпеймін
Dialogue: 0,0:23:50.22,0:23:52.89,Default,,0,0,0,,<Мырза. Саотоме, қонақүйде, мен, ойыншы және Хауа➡
Dialogue: 0,0:23:52.89,0:23:54.90,Default,,0,0,0,,Менің ойымша, біз бір бөлмеде болғанымыз жақсы болар еді.> <Жарайды...бұл➡
Dialogue: 0,0:23:54.90,0:23:56.90,Default,,0,0,0,,Оны Хауа шешеді.> <Бір бөлме...>
Dialogue: 0,0:23:56.90,0:23:58.90,Default,,0,0,0,,<Келесі жолы да, Берди Берди! ＞ ＜Бір бөлме…＞
Dialogue: 0,0:24:00.40,0:24:06.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory