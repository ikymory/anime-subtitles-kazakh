Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.96,0:00:12.98,Default,,0,0,0,,♬～
Dialogue: 0,0:00:12.98,0:00:14.98,Default,,0,0,0,,<Аа... мен саған қарсылас болмаймын>
Dialogue: 0,0:00:17.31,0:00:20.98,Default,,0,0,0,,<Сато өткен жылғы Канто турнирінде екінші орын алған.>
Dialogue: 0,0:00:20.98,0:00:24.65,Default,,0,0,0,,<Бұл Сера Амаваши мен Казухико Хотаканың қаны➡
Dialogue: 0,0:00:24.65,0:00:29.36,Default,,0,0,0,,Бұл гольф әлемінің элитасы Аои Тенвашидің қабілеті ме?
Dialogue: 0,0:00:31.99,0:00:36.00,Default,,0,0,0,,Алдыңғы сол жақтан жел. Егер бұлай болса, ешқандай нәтиже болмайды.
Dialogue: 0,0:00:36.00,0:00:38.00,Default,,0,0,0,,Егер бұл түйреуіш орны ➡ болса
Dialogue: 0,0:00:38.00,0:00:41.67,Default,,0,0,0,,Жолдан оңға қарай 220 ярдты көздеңіз...
Dialogue: 0,0:00:41.67,0:00:45.01,Default,,0,0,0,,Жаңбырдың дыбысы, осымен өмір сүруге рұқсат етіңіз
Dialogue: 0,0:00:45.01,0:00:48.68,Default,,0,0,0,,48 дюйм? Жоқ, Аой
Dialogue: 0,0:00:48.68,0:00:52.01,Default,,0,0,0,,Сіз әлі өсу сатысындасыз. Оны негізгі ➡ ету үшін
Dialogue: 0,0:00:52.01,0:00:55.02,Default,,0,0,0,,Дене шынықтырудан кейін де кеш емес
Dialogue: 0,0:00:55.02,0:00:58.02,Default,,0,0,0,,Соққым келеді (Жаңбыр дыбысы) Бүгінгі жаттығу матчы ➡
Dialogue: 0,0:00:58.02,0:01:01.29,Default,,0,0,0,,Бұл турнир алдындағы түзету екенін ұмытпаңыз.
Dialogue: 0,0:01:01.29,0:01:04.29,Default,,0,0,0,,Мен мектепке қайтып барсам, мені Хауамен шайқас күтіп тұр.
Dialogue: 0,0:01:04.29,0:01:06.63,Default,,0,0,0,,Сізге бұл нәресте керек болады.
Dialogue: 0,0:01:06.63,0:01:10.63,Default,,0,0,0,,Сіздің ойыңызша, қайсысы маңыздырақ, турнир ме, әлде сол қызбен жарыс па?
Dialogue: 0,0:01:10.63,0:01:13.30,Default,,0,0,0,,Әрине екеуі де.
Dialogue: 0,0:01:13.30,0:01:16.97,Default,,0,0,0,,Шынымен, сен мені тыңдамайсың.
Dialogue: 0,0:01:16.97,0:01:18.97,Default,,0,0,0,,Маған анам айтты
Dialogue: 0,0:01:18.97,0:01:23.58,Default,,0,0,0,,«Гольф ойыншылары өзімшіл болған кезде күштірек болады».
Dialogue: 0,0:01:25.28,0:01:26.98,Default,,0,0,0,,<Кеттік, Паккун>
Dialogue: 0,0:01:26.98,0:01:28.98,Default,,0,0,0,,<Қайтсем, Хауамен бірге боламын...>
Dialogue: 0,0:01:31.32,0:01:33.32,Default,,0,0,0,,<Гольф ойнай алады>
Dialogue: 0,0:01:33.32,0:01:35.66,Default,,0,0,0,,<Хауамен...> ⚟ (қол шапалақтау)
Dialogue: 0,0:01:35.66,0:01:37.66,Default,,0,0,0,,Иә? (қол шапалақтау)
Dialogue: 0,0:01:38.99,0:01:41.30,Default,,0,0,0,,Жақсы кадр, Аой.
Dialogue: 0,0:01:42.33,0:01:44.33,Default,,0,0,0,,Ата! ?
Dialogue: 0,0:01:45.33,0:02:05.29,Default,,0,0,0,,♬～
Dialogue: 0,0:02:05.29,0:02:25.31,Default,,0,0,0,,♬～
Dialogue: 0,0:02:25.31,0:02:45.33,Default,,0,0,0,,♬～
Dialogue: 0,0:02:45.33,0:03:05.28,Default,,0,0,0,,♬～
Dialogue: 0,0:03:05.28,0:03:13.96,Default,,0,0,0,,♬～
Dialogue: 0,0:03:28.30,0:03:31.97,Default,,0,0,0,,Барлығы 12-мен аяқталды?
Dialogue: 0,0:03:31.97,0:03:34.98,Default,,0,0,0,,Құспен аяқтағаныңыз жақсы болды.
Dialogue: 0,0:03:34.98,0:03:37.98,Default,,0,0,0,,Тұрақты шақыру қатынасы
Dialogue: 0,0:03:37.98,0:03:41.98,Default,,0,0,0,,Сіздің ойнау мәнеріңіз дәл анаңыздікіне ұқсайды.
Dialogue: 0,0:03:41.98,0:03:44.32,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:03:44.32,0:03:47.66,Default,,0,0,0,,...Неге ашуланасың?
Dialogue: 0,0:03:47.66,0:03:49.66,Default,,0,0,0,,Мен ерекше ашуланбаймын.
Dialogue: 0,0:03:51.26,0:03:54.60,Default,,0,0,0,,Сіз ашулысыз ба? (Жаңбырдың дыбысы) Ахаха...
Dialogue: 0,0:03:54.60,0:03:57.27,Default,,0,0,0,,Сіз ол қызбен әрқашан бәсекелесе аласыз, солай ма?
Dialogue: 0,0:03:57.27,0:03:59.27,Default,,0,0,0,,Ісінбе, ғұн
Dialogue: 0,0:04:00.60,0:04:02.60,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:03.94,0:04:05.94,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:09.61,0:04:14.62,Default,,0,0,0,,Ата, бұл торт менің Хоккайдодағы сүйікті торт...
Dialogue: 0,0:04:14.62,0:04:18.29,Default,,0,0,0,,Ху... арнайы тапсырыс берілген.
Dialogue: 0,0:04:18.29,0:04:20.62,Default,,0,0,0,,Еш ойланбастан тамақтаныңыз
Dialogue: 0,0:04:20.62,0:04:22.96,Default,,0,0,0,,Иә, itadakimasu
Dialogue: 0,0:04:22.96,0:04:29.30,Default,,0,0,0,,♬～
Dialogue: 0,0:04:29.30,0:04:34.30,Default,,0,0,0,,Ммм, дәмді көріп тұрмын. Хаха.
Dialogue: 0,0:04:34.30,0:04:36.30,Default,,0,0,0,,Көбірек тамақтаныңыз Иә
Dialogue: 0,0:04:38.97,0:04:42.28,Default,,0,0,0,,<Бала, жай ғана бала>
Dialogue: 0,0:04:48.32,0:04:51.92,Default,,0,0,0,,Өте жақсы Жақсы Жақсы (Тенваши) Мен өсек естідім➡
Dialogue: 0,0:04:51.92,0:04:56.26,Default,,0,0,0,,Мен менеджер Кинуэ Цзингужидің жарақат алғанын естідім.
Dialogue: 0,0:04:56.26,0:05:00.93,Default,,0,0,0,,Сол жақ шынтағымдағы иық сүйегінің медиальды эпикондилиті күшейген сияқты.
Dialogue: 0,0:05:00.93,0:05:03.60,Default,,0,0,0,,Гольф ойыншысының шынтағы?
Dialogue: 0,0:05:03.60,0:05:06.94,Default,,0,0,0,,Жұптық чемпионатқа қатысу мүмкін емес пе?
Dialogue: 0,0:05:06.94,0:05:10.94,Default,,0,0,0,,Мүмкін (Тенваши) бұл чемпионат➡
Dialogue: 0,0:05:10.94,0:05:15.94,Default,,0,0,0,,Сера Аоиды насихаттау үшін әдейі жаңа турнир ұйымдастырды.
Dialogue: 0,0:05:16.95,0:05:19.95,Default,,0,0,0,,Біз ешбір жағдайда ұтыла алмаймыз.
Dialogue: 0,0:05:19.95,0:05:22.62,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:05:22.62,0:05:26.29,Default,,0,0,0,,Мен директор Амуро-куннан сұрасам да, ол менен қашып кетті.
Dialogue: 0,0:05:26.29,0:05:28.96,Default,,0,0,0,,Мен сені осында шақырдым.
Dialogue: 0,0:05:28.96,0:05:31.29,Default,,0,0,0,,Ашық тыңдаңыз
Dialogue: 0,0:05:31.29,0:05:34.96,Default,,0,0,0,,Клубта Аоимен жұптасатын ойыншылар бар ма?
Dialogue: 0,0:05:34.96,0:05:37.63,Default,,0,0,0,,Сөзсіз жеңе алатын ойыншы
Dialogue: 0,0:05:37.63,0:05:41.64,Default,,0,0,0,,Менің ойымша, бір ғана адам бар (Тенваши).
Dialogue: 0,0:05:41.64,0:05:46.98,Default,,0,0,0,,Өткір пышақтай өткір гольф ойнайтын әйел.
Dialogue: 0,0:05:46.98,0:05:48.98,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:05:48.98,0:05:51.58,Default,,0,0,0,,Хауа... жоқ
Dialogue: 0,0:05:52.58,0:05:54.98,Default,,0,0,0,,Евангелин Ф. Кимишима
Dialogue: 0,0:06:01.92,0:06:04.93,Default,,0,0,0,,Топтық тәжірибеге қатысудың қажеті жоқ.
Dialogue: 0,0:06:05.93,0:06:07.93,Default,,0,0,0,,Ева-кунға қазір технологияны қалай пайдалануды білмеймін десем де➡
Dialogue: 0,0:06:07.93,0:06:09.93,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:06:09.93,0:06:12.93,Default,,0,0,0,,Жапон тілі курсына үйренгеніңізді қалаймын.
Dialogue: 0,0:06:12.93,0:06:18.27,Default,,0,0,0,,Жапон желі Шөп Кедір-бұдыр тереңдігі Жасыл жағдай
Dialogue: 0,0:06:18.27,0:06:20.58,Default,,0,0,0,,Сіздің денеңіздің бәрін есте сақтауға мүмкіндік беріңіз
Dialogue: 0,0:06:21.61,0:06:23.61,Default,,0,0,0,,Бұл да
Dialogue: 0,0:06:23.61,0:06:26.62,Default,,0,0,0,,Осы клубты тиімді пайдалана алуларыңызды қалаймын.
Dialogue: 0,0:06:26.62,0:06:31.29,Default,,0,0,0,,Бұл Athena клубының ең жоғары үлгідегі үлгісі емес пе?
Dialogue: 0,0:06:31.29,0:06:33.29,Default,,0,0,0,,Жүргізуші бетіндегі E титан
Dialogue: 0,0:06:33.29,0:06:35.29,Default,,0,0,0,,Біліктегі жаңа буын көміртекті «алқа».
Dialogue: 0,0:06:35.29,0:06:38.63,Default,,0,0,0,,Темір гибридті вольфрам.
Dialogue: 0,0:06:38.63,0:06:41.63,Default,,0,0,0,,Бұл таңқаларлық па? Бұл таңқаларлық және қымбат!
Dialogue: 0,0:06:41.63,0:06:45.30,Default,,0,0,0,,Айтпақшы, Тенвашиде де пайдаланушы үлгісінің бірдей түрі бар.
Dialogue: 0,0:06:45.30,0:06:48.64,Default,,0,0,0,,Бұл Чар үшін ерекше үлгі сияқты.
Dialogue: 0,0:06:48.64,0:06:51.24,Default,,0,0,0,,Aoi сияқты...
Dialogue: 0,0:06:51.24,0:06:54.24,Default,,0,0,0,,Афина гольф алаңы 3 күн бойы өтті
Dialogue: 0,0:06:54.24,0:06:56.58,Default,,0,0,0,,Қалағаныңызша айналаңыз.
Dialogue: 0,0:06:56.58,0:07:00.25,Default,,0,0,0,,«Афина гольф алаңы» директоры Бұл...
Dialogue: 0,0:07:00.25,0:07:03.25,Default,,0,0,0,,Саотоме-кун, Ева-кунға еріңіз.
Dialogue: 0,0:07:03.25,0:07:05.55,Default,,0,0,0,,бұл... Иә, түсіндім.
Dialogue: 0,0:07:06.92,0:07:08.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:08.92,0:07:12.26,Default,,0,0,0,,Жүр, кеттік, директор Цзингуджи.
Dialogue: 0,0:07:12.26,0:07:15.60,Default,,0,0,0,,Аа... Мына қолың жарай ма?
Dialogue: 0,0:07:15.60,0:07:18.27,Default,,0,0,0,,Жарайды, мін.
Dialogue: 0,0:07:18.27,0:07:20.27,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:07:21.60,0:07:23.61,Default,,0,0,0,,《Директор Амуро》
Dialogue: 0,0:07:23.61,0:07:26.94,Default,,0,0,0,,《Сізбен бірге жүруге рұқсат етіңіз》
Dialogue: 0,0:07:26.94,0:07:29.28,Default,,0,0,0,,《Сіз Хауамен жұдырықтасуды жоспарлап отырсыз ба? 》
Dialogue: 0,0:07:29.28,0:07:31.98,Default,,0,0,0,,《Оның гольф ойыны әлі белгісіз》
Dialogue: 0,0:07:32.95,0:07:35.28,Default,,0,0,0,,《Мен де... Жоқ➡
Dialogue: 0,0:07:35.28,0:07:38.29,Default,,0,0,0,,Менің ойымша, менің қолымнан келетін нәрселер бар.
Dialogue: 0,0:07:39.29,0:07:41.96,Default,,0,0,0,,《Иә, түсіндім》
Dialogue: 0,0:07:41.96,0:07:44.29,Default,,0,0,0,,《Сол дөрекі тасты жылтыратыңыз》
Dialogue: 0,0:07:44.29,0:07:46.29,Default,,0,0,0,,《Алайда…》
Dialogue: 0,0:07:46.29,0:07:52.90,Default,,0,0,0,,♬～
Dialogue: 0,0:07:52.90,0:07:56.24,Default,,0,0,0,,Ха~ Шындық басқа, солай емес пе?
Dialogue: 0,0:07:56.24,0:07:58.94,Default,,0,0,0,,Ах~ Сурисури Сурисури
Dialogue: 0,0:08:02.91,0:08:05.25,Default,,0,0,0,,Эх! ?
Dialogue: 0,0:08:05.25,0:08:08.92,Default,,0,0,0,,Хауа, келмедің бе? (Әйел студент) Менің сынып жетекшім➡
Dialogue: 0,0:08:08.92,0:08:11.59,Default,,0,0,0,,Ол: «Мен бүгіннен бастап үш күнге ресми демалыстамын», - деді.
Dialogue: 0,0:08:11.59,0:08:13.59,Default,,0,0,0,,Саотоме-сан да менімен бірге.
Dialogue: 0,0:08:13.59,0:08:15.59,Default,,0,0,0,,А... (Студент қыздар) Иә?
Dialogue: 0,0:08:15.59,0:08:21.30,Default,,0,0,0,,Бір-бірімізден өте алатынымыздың шегі бар!
Dialogue: 0,0:08:22.93,0:08:26.94,Default,,0,0,0,,5-ші тесік 175 ярд пар 3.
Dialogue: 0,0:08:28.60,0:08:32.27,Default,,0,0,0,,Егер бұл Хауаның күші болса, сізге жету үшін 5 саны жеткілікті.
Dialogue: 0,0:08:32.27,0:08:34.98,Default,,0,0,0,,Жасылдың сол жағындағы бункерден сақ болыңыз.
Dialogue: 0,0:08:39.61,0:08:44.95,Default,,0,0,0,,＜Физикалық жағынан мінсіз және күшті өзегі бар＞
Dialogue: 0,0:08:44.95,0:08:46.96,Default,,0,0,0,,<Одан шығарылады...>
Dialogue: 0,0:08:49.62,0:08:51.63,Default,,0,0,0,,<Бұл өткір траектория>
Dialogue: 0,0:08:57.90,0:09:00.24,Default,,0,0,0,,Жарайсың, Ева-сан
Dialogue: 0,0:09:00.24,0:09:02.57,Default,,0,0,0,,Үйірмеге әлі үйренген жоқпын.
Dialogue: 0,0:09:02.57,0:09:05.24,Default,,0,0,0,,5 шұңқыр, 2 құс
Dialogue: 0,0:09:05.24,0:09:08.94,Default,,0,0,0,,Бірінші раунд жақсы өтті (Ичина Ева) Иә?
Dialogue: 0,0:09:10.91,0:09:12.91,Default,,0,0,0,,У... Бастық?
Dialogue: 0,0:09:16.92,0:09:20.26,Default,,0,0,0,,Уау... не? Бұл қорлау ма?
Dialogue: 0,0:09:20.26,0:09:22.26,Default,,0,0,0,,Мен естідім.
Dialogue: 0,0:09:22.26,0:09:24.93,Default,,0,0,0,,Сіз Құраннан Каоруко Иидзимамен кездестіңіз, солай ма?
Dialogue: 0,0:09:24.93,0:09:28.60,Default,,0,0,0,,Бұл? Иидзимамен күрескіңіз келсе➡
Dialogue: 0,0:09:28.60,0:09:32.27,Default,,0,0,0,,Маған осыншама көз алмасын көрсетпесең, қиын болар еді.
Dialogue: 0,0:09:32.27,0:09:34.27,Default,,0,0,0,,Тест дегеніміз не?
Dialogue: 0,0:09:34.27,0:09:36.60,Default,,0,0,0,,Қалағаныңызша алыңыз.
Dialogue: 0,0:09:36.60,0:09:39.61,Default,,0,0,0,,Құм сынасы бұл... Иә.
Dialogue: 0,0:09:40.61,0:09:43.61,Default,,0,0,0,,Менің оқтарым 7 түске өзгереді
Dialogue: 0,0:09:43.61,0:09:46.95,Default,,0,0,0,,А... аузыңмен айтпа, жарай ма?
Dialogue: 0,0:09:46.95,0:09:54.96,Default,,0,0,0,,♬～
Dialogue: 0,0:09:54.96,0:09:56.96,Default,,0,0,0,,Хауа мырза, бұл тым қымбат.
Dialogue: 0,0:09:56.96,0:09:59.63,Default,,0,0,0,,Дұрыс... «Оң жаққа қой» деме.
Dialogue: 0,0:09:59.63,0:10:02.63,Default,,0,0,0,,Егер бұл менің кассам болса... Иә?
Dialogue: 0,0:10:02.63,0:10:07.34,Default,,0,0,0,,Егер сіз сонда болсаңыз, сіз жеңер ме едіңіз? Егер сіз оны шығара алсаңыз, солай ма?
Dialogue: 0,0:10:08.64,0:10:13.04,Default,,0,0,0,,Мен төбелесті сатылған кезде сатып аламын, сондықтан оны арзан ұстаңыз.
Dialogue: 0,0:10:14.31,0:10:17.31,Default,,0,0,0,,<Бұл менің сары оқым>
Dialogue: 0,0:10:17.31,0:10:21.62,Default,,0,0,0,,<Сары оқтан қашыңыз! ＞
Dialogue: 0,0:10:25.99,0:10:27.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:29.66,0:10:31.66,Default,,0,0,0,,Ах (Kinue) жақсы шықты
Dialogue: 0,0:10:31.66,0:10:35.66,Default,,0,0,0,,Бірақ бұл жылдамдық пен бұрышта ол жасыл түсті.
Dialogue: 0,0:10:38.33,0:10:40.34,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:10:40.34,0:10:42.34,Default,,0,0,0,,Бұл…
Dialogue: 0,0:10:44.67,0:10:48.34,Default,,0,0,0,,<Сары оқтан қашыңыз! ＞
Dialogue: 0,0:10:48.34,0:11:00.62,Default,,0,0,0,,♬～
Dialogue: 0,0:11:00.62,0:11:04.29,Default,,0,0,0,,Сіз тым саналысыз... білмей тұрып
Dialogue: 0,0:11:04.29,0:11:06.29,Default,,0,0,0,,Нөл белгісі
Dialogue: 0,0:11:06.29,0:11:10.63,Default,,0,0,0,,Осылай болса, Тенваши оңай қалпына келеді.
Dialogue: 0,0:11:10.63,0:11:12.63,Default,,0,0,0,,Әрине...
Dialogue: 0,0:11:13.97,0:11:15.97,Default,,0,0,0,,Мен де
Dialogue: 0,0:11:15.97,0:11:18.64,Default,,0,0,0,,<Құм шашырауы жоқ дерлік>
Dialogue: 0,0:11:18.64,0:11:21.34,Default,,0,0,0,,<Қандай жұмсақ және нәзік жанасу>
Dialogue: 0,0:11:24.31,0:11:26.65,Default,,0,0,0,,Бетапынсу
Dialogue: 0,0:11:26.65,0:11:30.65,Default,,0,0,0,,Мизухо Химекава оған тостағанды кіргізер еді.
Dialogue: 0,0:11:30.65,0:11:32.65,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:11:32.65,0:11:37.66,Default,,0,0,0,,Мизухо Химекава, Нада-нан спортшы қыздарының абсолютті эйсі
Dialogue: 0,0:11:37.66,0:11:43.36,Default,,0,0,0,,Өткен жылы бүкіл Жапония әйелдерінің әуесқой чемпионатында жеңіске жеткен ең күшті орта мектеп гольфшысы
Dialogue: 0,0:11:44.33,0:11:46.67,Default,,0,0,0,,Сіз қарсы алуға тырысып жатқан қабырға ➡
Dialogue: 0,0:11:46.67,0:11:48.67,Default,,0,0,0,,Өте қымбат
Dialogue: 0,0:11:48.67,0:11:51.94,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз оның үстінен секіре аласыз ба?
Dialogue: 0,0:11:51.94,0:11:54.54,Default,,0,0,0,,«Үстінен секіру»? Сен қалжыңдап тұрсың ба?
Dialogue: 0,0:11:57.28,0:12:02.28,Default,,0,0,0,,<Сары оқтан қашыңыз! ＞
Dialogue: 0,0:12:02.28,0:12:12.63,Default,,0,0,0,,♬～
Dialogue: 0,0:12:12.63,0:12:14.63,Default,,0,0,0,,Ех! ? Уф...!
Dialogue: 0,0:12:14.63,0:12:22.64,Default,,0,0,0,,♬～
Dialogue: 0,0:12:22.64,0:12:25.04,Default,,0,0,0,,... енгізілген.
Dialogue: 0,0:12:26.31,0:12:28.31,Default,,0,0,0,,Мен қабырғаны тесіп өтемін.
Dialogue: 0,0:12:29.31,0:12:31.98,Default,,0,0,0,,Менің оқыммен
Dialogue: 0,0:12:33.98,0:12:53.94,Default,,0,0,0,,♬～
Dialogue: 0,0:12:53.94,0:13:13.96,Default,,0,0,0,,♬～
Dialogue: 0,0:13:13.96,0:13:33.98,Default,,0,0,0,,♬～
Dialogue: 0,0:13:33.98,0:13:37.31,Default,,0,0,0,,♬～
Dialogue: 0,0:13:37.31,0:13:39.31,Default,,0,0,0,,А... Хм! ?
Dialogue: 0,0:13:41.25,0:13:43.92,Default,,0,0,0,,Ахахахаха…
Dialogue: 0,0:13:43.92,0:14:03.94,Default,,0,0,0,,♬～
Dialogue: 0,0:14:03.94,0:14:23.29,Default,,0,0,0,,♬～
Dialogue: 0,0:14:23.29,0:14:26.29,Default,,0,0,0,,А... сен садистсің, солай ма?
Dialogue: 0,0:14:26.29,0:14:28.30,Default,,0,0,0,,Бұл жиі айтылады
Dialogue: 0,0:14:28.30,0:14:32.30,Default,,0,0,0,,Енді оны аяқтау үшін менімен бір саңылаулы сіріңке ойнаңыз.
Dialogue: 0,0:14:32.30,0:14:34.97,Default,,0,0,0,,Мен сені күлдіремін
Dialogue: 0,0:14:34.97,0:14:38.64,Default,,0,0,0,,Мен саған дәл айтқаныңды қайтарамын.
Dialogue: 0,0:14:39.91,0:14:41.91,Default,,0,0,0,,Түсіру ➡
Dialogue: 0,0:14:41.91,0:14:45.51,Default,,0,0,0,,Өз күшіңізді допқа сойыл арқылы қалай беруге болады
Dialogue: 0,0:14:52.59,0:14:56.99,Default,,0,0,0,,Мен сол тербеліс жылдамдығымен 220-дан асып кеттім.
Dialogue: 0,0:14:59.59,0:15:01.93,Default,,0,0,0,,Күшпен қайтадан ұрдың ба?
Dialogue: 0,0:15:01.93,0:15:03.93,Default,,0,0,0,,Иә, мен оны ұрамын.
Dialogue: 0,0:15:05.60,0:15:09.27,Default,,0,0,0,,Оққа барынша көп мылтық салу керек➡
Dialogue: 0,0:15:09.27,0:15:11.61,Default,,0,0,0,,Оқ ➡
Dialogue: 0,0:15:11.61,0:15:13.61,Default,,0,0,0,,Ол ұшпайды!
Dialogue: 0,0:15:17.95,0:15:19.95,Default,,0,0,0,,Көбірек, көбірек!
Dialogue: 0,0:15:21.95,0:15:24.25,Default,,0,0,0,,Қабырғаны жарып өт!
Dialogue: 0,0:15:27.29,0:15:29.96,Default,,0,0,0,,Сіз қалай ойлайсыз? Осындай кадрмен➡
Dialogue: 0,0:15:29.96,0:15:32.63,Default,,0,0,0,,Менің ойым бұзылады деп ойлайсың ба?
Dialogue: 0,0:15:32.63,0:15:34.63,Default,,0,0,0,,Ахсо
Dialogue: 0,0:15:36.96,0:15:39.63,Default,,0,0,0,,Екінші ату арқылы көздейтін ұпайлар
Dialogue: 0,0:15:39.63,0:15:42.34,Default,,0,0,0,,Жасыл түстің оң жағынан диагональ бойынша қадам бар.
Dialogue: 0,0:15:43.24,0:15:46.91,Default,,0,0,0,,Жасыл түстің артқы сол жағын көздеңіз
Dialogue: 0,0:15:46.91,0:15:55.58,Default,,0,0,0,,♬～
Dialogue: 0,0:15:55.58,0:15:58.92,Default,,0,0,0,,Бұл құстың ықтималдығын күрт арттырады.
Dialogue: 0,0:15:58.92,0:16:00.92,Default,,0,0,0,,Маған мұндай гольф ұнамайды.
Dialogue: 0,0:16:00.92,0:16:03.93,Default,,0,0,0,,Мен үшін сіз мүмкіндікті жіберіп алдыңыз.
Dialogue: 0,0:16:03.93,0:16:06.23,Default,,0,0,0,,Бүркіт мүмкіндігі
Dialogue: 0,0:16:09.26,0:16:11.57,Default,,0,0,0,,<Тостағанды көздеуді жалғастыр>
Dialogue: 0,0:16:12.60,0:16:16.00,Default,,0,0,0,,<Мен гольф ойнадым>
Dialogue: 0,0:16:17.94,0:16:21.61,Default,,0,0,0,,Хауа, екі деңгейлі жасылдың басын көзде.
Dialogue: 0,0:16:21.61,0:16:24.01,Default,,0,0,0,,Оны сол жерге лақтырайық.
Dialogue: 0,0:16:24.95,0:16:29.28,Default,,0,0,0,,Енді түсіндің, түсіну оңай.
Dialogue: 0,0:16:29.28,0:16:31.62,Default,,0,0,0,,<Иә, жақсы>
Dialogue: 0,0:16:31.62,0:16:33.62,Default,,0,0,0,,<Осы үш күн➡
Dialogue: 0,0:16:33.62,0:16:36.62,Default,,0,0,0,,Мен саған гольф үйрету үшін келген жоқпын.
Dialogue: 0,0:16:37.63,0:16:39.63,Default,,0,0,0,,＜Мен оны көргім келді＞
Dialogue: 0,0:16:39.63,0:16:42.33,Default,,0,0,0,,<Сіздің шешіміңіз бен нұрыңыз>
Dialogue: 0,0:16:48.24,0:16:50.24,Default,,0,0,0,,<Мен арамшөппін>
Dialogue: 0,0:16:50.24,0:16:54.58,Default,,0,0,0,,<Қанша тырыссаң да, сен ешқашан данышпан бола алмайсың.>
Dialogue: 0,0:16:54.58,0:16:57.58,Default,,0,0,0,,<Мен ол кісінің үмітін ақтағым келді...>
Dialogue: 0,0:16:57.58,0:17:02.92,Default,,0,0,0,,♬～
Dialogue: 0,0:17:02.92,0:17:05.25,Default,,0,0,0,,《(Кинюдің ауырған дауысы)》
Dialogue: 0,0:17:05.25,0:17:10.26,Default,,0,0,0,,<Өзімді қатты итерудің нәтижесінде сол жақ шынтағым сынып қалды>
Dialogue: 0,0:17:10.26,0:17:14.93,Default,,0,0,0,,<Сол кісі берген шамды сөндірдім>
Dialogue: 0,0:17:14.93,0:17:18.93,Default,,0,0,0,,《(Жылау)》
Dialogue: 0,0:17:19.93,0:17:22.27,Default,,0,0,0,,<Сондықтан маған көрсеткеніңізді қалаймын>
Dialogue: 0,0:17:22.27,0:17:24.57,Default,,0,0,0,,<Сен және Тэнваши-сан басқасың>
Dialogue: 0,0:17:25.61,0:17:29.94,Default,,0,0,0,,<Жарықпен туылған таңдаулылар>
Dialogue: 0,0:17:29.94,0:17:32.55,Default,,0,0,0,,<Ешқашан майыспайтын күшті ерік-жігермен...>
Dialogue: 0,0:17:34.62,0:17:37.02,Default,,0,0,0,,<Оны жаншып, әрі қарай жүресің>
Dialogue: 0,0:17:39.29,0:17:41.22,Default,,0,0,0,,<Мені арамшөп шақырды>
Dialogue: 0,0:17:41.22,0:17:48.23,Default,,0,0,0,,♬～
Dialogue: 0,0:17:48.23,0:17:51.90,Default,,0,0,0,,《Жарайды, мына дөрекі тасты жылтырат.》
Dialogue: 0,0:17:51.90,0:17:54.90,Default,,0,0,0,,《Бірақ абай болма》
Dialogue: 0,0:17:54.90,0:17:56.90,Default,,0,0,0,,《Жоқ мен аламын》
Dialogue: 0,0:17:56.90,0:17:59.57,Default,,0,0,0,,《Сіз гольфті тастауды жоспарлап отырсыз ба? 》
Dialogue: 0,0:17:59.57,0:18:01.58,Default,,0,0,0,,《Директор》
Dialogue: 0,0:18:01.58,0:18:04.58,Default,,0,0,0,,《Мені, қарапайым адамды осы дәрежеге жеткізгеніңізге рахмет➡
Dialogue: 0,0:18:04.58,0:18:06.58,Default,,0,0,0,,Сізге көп рахмет》
Dialogue: 0,0:18:07.92,0:18:11.52,Default,,0,0,0,,《Директордың арқасында мен осы уақытқа дейін ұша алдым》
Dialogue: 0,0:18:13.92,0:18:17.93,Default,,0,0,0,,``Сол жақ шынтағымды емдесем де, оның қайтып келу мүмкіндігі бар''➡
Dialogue: 0,0:18:17.93,0:18:19.93,Default,,0,0,0,,Дәрігер маған айтты》
Dialogue: 0,0:18:19.93,0:18:23.23,Default,,0,0,0,,《Мен енді жоғары ұша алмаймын》
Dialogue: 0,0:18:25.93,0:18:28.27,Default,,0,0,0,,《Орындалмаған тілегім➡
Dialogue: 0,0:18:28.27,0:18:31.27,Default,,0,0,0,,Мен оны көктегі қыран мен Хауа анаға тапсырамын》
Dialogue: 0,0:18:34.28,0:18:36.28,Default,,0,0,0,,《Түсінікті》
Dialogue: 0,0:18:36.28,0:18:39.88,Default,,0,0,0,,《Алайда мен оның гольф клубының капитаны қызметін жалғастырғанын қалаймын》
Dialogue: 0,0:18:39.88,0:18:41.88,Default,,0,0,0,,《Егер сен менің қасымда болмасаң, мен қиналамын》
Dialogue: 0,0:18:42.88,0:18:46.19,Default,,0,0,0,,《Иә… Иә》
Dialogue: 0,0:18:50.89,0:18:54.56,Default,,0,0,0,,Казухико Мен адам емеспін.
Dialogue: 0,0:18:54.56,0:18:58.97,Default,,0,0,0,,Сол қыздың жеңгенін қалағандықтан, мен оны тым көп нәрсеге мәжбүрледім.
Dialogue: 0,0:19:00.23,0:19:02.94,Default,,0,0,0,,Сонда да мен сол баланың жеңіске жеткенін қалаймын.
Dialogue: 0,0:19:03.90,0:19:05.91,Default,,0,0,0,,Сол себепті мен...
Dialogue: 0,0:19:07.58,0:19:10.91,Default,,0,0,0,,Иә, сіз шештіңіз бе?
Dialogue: 0,0:19:10.91,0:19:14.25,Default,,0,0,0,,📱(Амуро) Иә, кешіккенім үшін кешіріңіз.
Dialogue: 0,0:19:14.25,0:19:17.59,Default,,0,0,0,,Цзингжи-кун жақсы гольф ойыншысы болды.
Dialogue: 0,0:19:17.59,0:19:21.26,Default,,0,0,0,,📱 Барлығы менің жауапкершілігімде
Dialogue: 0,0:19:21.26,0:19:25.26,Default,,0,0,0,,Чемпионат өтінемін 📱 Иә.
Dialogue: 0,0:19:25.26,0:19:27.26,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:19:30.93,0:19:32.93,Default,,0,0,0,,Барлығың жиналыңдар.
Dialogue: 0,0:19:32.93,0:19:37.94,Default,,0,0,0,,Келесі айда гольф ойынынан жұптық ойыннан орта мектеп оқушыларының Жапония чемпионаты өтеді
Dialogue: 0,0:19:37.94,0:19:40.61,Default,,0,0,0,,Қатысушы жұптарды хабарлау
Dialogue: 0,0:19:40.61,0:19:45.61,Default,,0,0,0,,Біріншіден, бірінші курс 1 курс Аои Тэнваши Иә!
Dialogue: 0,0:19:45.61,0:19:47.95,Default,,0,0,0,,Қадағалау! (Амуро) Айта берейін➡
Dialogue: 0,0:19:47.95,0:19:51.62,Default,,0,0,0,,Мен Тенвашиді оның гольф ойыншысы ретіндегі қабілетіне қарай таңдадым.
Dialogue: 0,0:19:51.62,0:19:54.96,Default,,0,0,0,,Оның отбасылық ортасы ескерілмеді.
Dialogue: 0,0:19:54.96,0:19:58.96,Default,,0,0,0,,Не? (Харука) Жоқ, бұл ештеңе емес...
Dialogue: 0,0:19:58.96,0:20:00.96,Default,,0,0,0,,Екінші адам... ⚟ (есіктің ашылған дыбысы)
Dialogue: 0,0:20:00.96,0:20:03.26,Default,,0,0,0,,Кешіктіргеніміз үшін кешіріңіз
Dialogue: 0,0:20:05.30,0:20:08.94,Default,,0,0,0,,Екінші адам - Эвангелин Ф.Кишима.
Dialogue: 0,0:20:08.94,0:20:12.64,Default,,0,0,0,,Уф... өтірік! ?
Dialogue: 0,0:20:12.64,0:20:14.64,Default,,0,0,0,,Не?
Dialogue: 0,0:20:14.64,0:20:18.31,Default,,0,0,0,,Чемпионатқа сізді таңдап алдыңыз, ана... Шын айтасыз ба?
Dialogue: 0,0:20:18.31,0:20:21.98,Default,,0,0,0,,Сен істедің, Хауа! сурет? Ах... аа...
Dialogue: 0,0:20:21.98,0:20:23.98,Default,,0,0,0,,Енді күресуге болады.
Dialogue: 0,0:20:23.98,0:20:28.59,Default,,0,0,0,,Құранның Каоруко Иидзима және Нада Минами Мизухо Химекавамен
Dialogue: 0,0:20:29.66,0:20:31.99,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:20:31.99,0:20:34.66,Default,,0,0,0,,Танысқаныма қуаныштымын Ева Дегенмен➡
Dialogue: 0,0:20:34.66,0:20:38.33,Default,,0,0,0,,Клубқа жақында ғана қосылған Эвангелинді жұмысқа алу➡
Dialogue: 0,0:20:38.33,0:20:40.60,Default,,0,0,0,,Кейбіреулерде күмән болуы мүмкін.
Dialogue: 0,0:20:40.60,0:20:42.60,Default,,0,0,0,,Көктегі Бүркіт Хауа
Dialogue: 0,0:20:42.60,0:20:45.27,Default,,0,0,0,,Жаттығу залына барып, бір тесігі бар матчты өткізіңіз.
Dialogue: 0,0:20:45.27,0:20:48.94,Default,,0,0,0,,Басқа клуб мүшелеріне лайық ойын ойнаңыз Иә.
Dialogue: 0,0:20:48.94,0:20:51.55,Default,,0,0,0,,Қабілетіңізді көрсетіңіз Ах
Dialogue: 0,0:20:55.28,0:20:59.29,Default,,0,0,0,,Көп уақыт өтті, бірақ біз ақыры бәсекеге түсе аламыз.
Dialogue: 0,0:20:59.29,0:21:01.62,Default,,0,0,0,,Егер бұл Хауа болса, сіз кенеттен жоғалып кетесіз.
Dialogue: 0,0:21:01.62,0:21:04.33,Default,,0,0,0,,Олар да кетті, солай ма?
Dialogue: 0,0:21:05.96,0:21:09.96,Default,,0,0,0,,(Хауа мен Аойдың күлкісі)
Dialogue: 0,0:21:09.96,0:21:12.30,Default,,0,0,0,,Жарайды, бастайық.
Dialogue: 0,0:21:12.30,0:21:14.30,Default,,0,0,0,,Honor не істейді?
Dialogue: 0,0:21:14.30,0:21:16.60,Default,,0,0,0,,Бір уақытта ұрайық, бұл айдаһар.
Dialogue: 0,0:21:18.97,0:21:21.98,Default,,0,0,0,,Иә? Мұнда 48 дюйм деген не?
Dialogue: 0,0:21:21.98,0:21:24.28,Default,,0,0,0,,Сіз байсалдысыз, Хауа.
Dialogue: 0,0:21:27.31,0:21:29.65,Default,,0,0,0,,<Кеттік, Паккун>
Dialogue: 0,0:21:29.65,0:21:31.65,Default,,0,0,0,,<Тікелей соққы...>
Dialogue: 0,0:21:32.65,0:21:36.66,Default,,0,0,0,,<Көк оқ! ＞
Dialogue: 0,0:21:36.66,0:21:38.66,Default,,0,0,0,,(клуб мүшелерінің таңғаларлық дыбыстары)
Dialogue: 0,0:21:38.66,0:21:58.61,Default,,0,0,0,,♬～
Dialogue: 0,0:21:58.61,0:22:18.63,Default,,0,0,0,,♬～
Dialogue: 0,0:22:18.63,0:22:38.65,Default,,0,0,0,,♬～
Dialogue: 0,0:22:38.65,0:22:58.61,Default,,0,0,0,,♬～
Dialogue: 0,0:22:58.61,0:23:17.59,Default,,0,0,0,,♬～
Dialogue: 0,0:23:18.63,0:23:20.96,Default,,0,0,0,,Хауа керемет құс болған.
Dialogue: 0,0:23:20.96,0:23:23.30,Default,,0,0,0,,Құс - құс.
Dialogue: 0,0:23:23.30,0:23:26.30,Default,,0,0,0,,Шайқаста жеңілдім деп маған шабуыл жасама.
Dialogue: 0,0:23:26.30,0:23:29.97,Default,,0,0,0,,Ах... Ойынның кенеттен болғаны сонша, мен жылынуым керек еді...
Dialogue: 0,0:23:29.97,0:23:34.31,Default,,0,0,0,,48 дюйм жылап жатыр ма? Ммм...
Dialogue: 0,0:23:34.31,0:23:37.31,Default,,0,0,0,,Мен түйреуіштерге жақын жерде жақсырақмын.
Dialogue: 0,0:23:37.31,0:23:40.25,Default,,0,0,0,,Олай емес, жұппен мынандай...
Dialogue: 0,0:23:40.25,0:23:42.25,Default,,0,0,0,,Жақсылық жасай аламыз ба деп ойлаймын. Егер Хауа солай етсе, ол мені жек көре ме?
Dialogue: 0,0:23:42.25,0:23:45.25,Default,,0,0,0,,Маған ұнамайды да, жек көрмейді де, бұл не!
Dialogue: 0,0:23:45.25,0:23:47.92,Default,,0,0,0,,А, иә, иә, сен неге сонша дөрекісің?
Dialogue: 0,0:23:47.92,0:23:49.92,Default,,0,0,0,,Сәлем, Хауа!
Dialogue: 0,0:23:49.92,0:23:52.93,Default,,0,0,0,,<Мырза. Саотоме, Аои мен Хауа қосылса жарай ма деп ойлаймын>
Dialogue: 0,0:23:52.93,0:23:54.93,Default,,0,0,0,,<Аманаши-сан, Ева-сан агрессивті...➡
Dialogue: 0,0:23:54.93,0:23:56.93,Default,,0,0,0,,...Олар басқа мектептермен төбелесіп жатыр! ＞
Dialogue: 0,0:23:56.93,0:23:58.93,Default,,0,0,0,,<Келесі жолы да Берди Берди> <Ах! ＞
Dialogue: 0,0:24:00.43,0:24:06.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory