Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.96,0:00:07.64,Default,,0,0,0,,♬～
Dialogue: 0,0:00:07.64,0:00:09.64,Default,,0,0,0,,Бриз
Dialogue: 0,0:00:09.64,0:00:16.31,Default,,0,0,0,,♬～
Dialogue: 0,0:00:16.31,0:00:18.31,Default,,0,0,0,,Төменгі кесінді сызығы
Dialogue: 0,0:00:20.32,0:00:22.32,Default,,0,0,0,,Сіз қайда мақсат қоясыз?
Dialogue: 0,0:00:23.32,0:00:25.99,Default,,0,0,0,,2 кесе қалды
Dialogue: 0,0:00:25.99,0:00:27.99,Default,,0,0,0,,《Aoi —➡
Dialogue: 0,0:00:27.99,0:00:30.66,Default,,0,0,0,,Мен екі дарынмен тудым.
Dialogue: 0,0:00:30.66,0:00:34.66,Default,,0,0,0,,《Бір менің қаным көктегі қыран》
Dialogue: 0,0:00:35.66,0:00:39.67,Default,,0,0,0,,《Басқасы менің күйеуім Казухико Хотаканың қаны》
Dialogue: 0,0:00:42.00,0:00:44.01,Default,,0,0,0,,《Осы екі сыйлықпен➡
Dialogue: 0,0:00:44.01,0:00:47.01,Default,,0,0,0,,Сол бала жоғарыға жүгіріп келеді.
Dialogue: 0,0:00:51.35,0:00:55.02,Default,,0,0,0,,《Амане-сан, сен бақытты адамсың》
Dialogue: 0,0:00:55.02,0:00:57.35,Default,,0,0,0,,《Тенваши Аоидың кереметі...》
Dialogue: 0,0:00:57.35,0:00:59.35,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:00:59.35,0:01:01.62,Default,,0,0,0,,《Себебі сіз оны ең жақын жерден көре аласыз》
Dialogue: 0,0:01:01.62,0:01:21.64,Default,,0,0,0,,♬～
Dialogue: 0,0:01:21.64,0:01:41.66,Default,,0,0,0,,♬～
Dialogue: 0,0:01:41.66,0:02:01.62,Default,,0,0,0,,♬～
Dialogue: 0,0:02:01.62,0:02:21.64,Default,,0,0,0,,♬～
Dialogue: 0,0:02:21.64,0:02:31.98,Default,,0,0,0,,♬～
Dialogue: 0,0:02:45.63,0:02:47.63,Default,,0,0,0,,Құстар бірінші курстан басталады
Dialogue: 0,0:02:48.63,0:02:51.23,Default,,0,0,0,,Нафреске тән желге жақсы төтеп бере алады.
Dialogue: 0,0:02:51.23,0:02:54.90,Default,,0,0,0,,Осы жылдамдықпен...
Dialogue: 0,0:02:54.90,0:02:58.91,Default,,0,0,0,,Не? Сіз қазірдің өзінде ұшпасыз ба? Ол емес
Dialogue: 0,0:02:58.91,0:03:01.24,Default,,0,0,0,,Әйтеуір ойыққа кіре алмаймын.
Dialogue: 0,0:03:01.24,0:03:05.25,Default,,0,0,0,,Қазіргі уақытта әлем бойынша дарынды жасөспірімдердің көпшілігі 16 жастан асқан.
Dialogue: 0,0:03:05.25,0:03:07.25,Default,,0,0,0,,Тенваши Аои үшін➡
Dialogue: 0,0:03:07.25,0:03:09.92,Default,,0,0,0,,15 жасқа дейінгі әлем чемпионатына көңіліңіз толмай ма?
Dialogue: 0,0:03:09.92,0:03:11.92,Default,,0,0,0,,Бұл ... бұл ...
Dialogue: 0,0:03:14.59,0:03:16.59,Default,,0,0,0,,Ол кептеліп қалды.
Dialogue: 0,0:03:16.59,0:03:18.59,Default,,0,0,0,,Не істеу керек? Кішкене үзіліс...
Dialogue: 0,0:03:25.60,0:03:32.94,Default,,0,0,0,,♬～
Dialogue: 0,0:03:32.94,0:03:37.61,Default,,0,0,0,,<Кәсіби қашықтық 240 ярдтан жоғары>
Dialogue: 0,0:03:37.61,0:03:39.95,Default,,0,0,0,,<Кім? Турнирге қатысатын ойыншылар? ＞
Dialogue: 0,0:03:39.95,0:03:41.95,Default,,0,0,0,,<Жоқ, жоқ>
Dialogue: 0,0:03:41.95,0:03:45.62,Default,,0,0,0,,Мен мұндай ойыншыны назардан тыс қалдырмас едім...
Dialogue: 0,0:03:45.62,0:03:47.62,Default,,0,0,0,,Ол...
Dialogue: 0,0:03:47.62,0:03:49.62,Default,,0,0,0,,<Роберт Хелен>
Dialogue: 0,0:03:49.62,0:03:52.89,Default,,0,0,0,,<Нафлесс жасөспірімдер чемпионы>
Dialogue: 0,0:03:52.89,0:03:54.90,Default,,0,0,0,,<Ортада ойнауды неге қойдым...>
Dialogue: 0,0:03:54.90,0:03:56.90,Default,,0,0,0,,Бұл қыз Элейннің тәжірибелік серіктесі ме?
Dialogue: 0,0:03:56.90,0:03:58.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:58.90,0:04:03.24,Default,,0,0,0,,<Бұл көрініс гольф ойыншыларына өте қолайлы...>
Dialogue: 0,0:04:03.24,0:04:05.24,Default,,0,0,0,,Жаңбыр дыбысы иә?
Dialogue: 0,0:04:05.24,0:04:07.24,Default,,0,0,0,,Ол керемет
Dialogue: 0,0:04:07.24,0:04:10.25,Default,,0,0,0,,Aoi? Сіз оны көрдіңіз, солай ма? Сол футболка атылды
Dialogue: 0,0:04:10.25,0:04:14.25,Default,,0,0,0,,Соққы сәтінде доп көк түске боялғандай болды.
Dialogue: 0,0:04:14.25,0:04:16.95,Default,,0,0,0,,Осылай оқ ататындар бар екеніне сене алар емеспін.
Dialogue: 0,0:04:17.92,0:04:20.92,Default,,0,0,0,,Не? А, күте тұрыңыз, Аой?
Dialogue: 0,0:04:20.92,0:04:23.26,Default,,0,0,0,,Иә? Сізге ұнаса➡
Dialogue: 0,0:04:23.26,0:04:25.26,Default,,0,0,0,,Менімен бірге барғың келе ме?
Dialogue: 0,0:04:25.26,0:04:27.26,Default,,0,0,0,,Кім?
Dialogue: 0,0:04:27.26,0:04:29.93,Default,,0,0,0,,Менің атым Аои Амаваши.
Dialogue: 0,0:04:29.93,0:04:33.27,Default,,0,0,0,,Мен мұны істеуге қарсы емеспін, бірақ мен қанша жұмсауым керек?
Dialogue: 0,0:04:33.27,0:04:35.60,Default,,0,0,0,,Ақша тігуге болмайды
Dialogue: 0,0:04:35.60,0:04:39.61,Default,,0,0,0,,Біз қасиетті гольф ойынына кір келтіретін ештеңе істей алмаймыз.
Dialogue: 0,0:04:40.94,0:04:43.95,Default,,0,0,0,,О, онда... орнына➡
Dialogue: 0,0:04:43.95,0:04:47.62,Default,,0,0,0,,Енді мен саған ұнатамын.
Dialogue: 0,0:04:47.62,0:04:51.22,Default,,0,0,0,,<Турнир алдында ол жүргізушіні қалай қолдануға батылы бардың...>
Dialogue: 0,0:04:51.22,0:04:53.89,Default,,0,0,0,,<Аа, енді жоқ>
Dialogue: 0,0:04:53.89,0:04:56.89,Default,,0,0,0,,<Егер бұл орын алса, ол бала тоқтамайды>
Dialogue: 0,0:04:56.89,0:05:10.57,Default,,0,0,0,,♬～
Dialogue: 0,0:05:10.57,0:05:12.97,Default,,0,0,0,,Уфуфу ＜Енді не істейміз? ＞
Dialogue: 0,0:05:13.91,0:05:15.91,Default,,0,0,0,,<Егер мен сенің орнында болсам, міндетті түрде...>
Dialogue: 0,0:05:16.91,0:05:18.91,Default,,0,0,0,,<Жоқ, мүлде>
Dialogue: 0,0:05:22.58,0:05:25.25,Default,,0,0,0,,Әрине, мен жарысуға дайынмын.
Dialogue: 0,0:05:25.25,0:05:28.26,Default,,0,0,0,,...Бірақ ережелер ше?
Dialogue: 0,0:05:28.26,0:05:31.93,Default,,0,0,0,,№18-ге дейін штрих ойнауды жалғастырғыңыз келе ме?
Dialogue: 0,0:05:31.93,0:05:34.93,Default,,0,0,0,,Жарайды, бар күшімізді салайық.
Dialogue: 0,0:05:34.93,0:05:36.93,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:05:36.93,0:05:39.60,Default,,0,0,0,,Бұл біздің жаттығу кестемізді бұзады.
Dialogue: 0,0:05:39.60,0:05:43.61,Default,,0,0,0,,Бір-біріңіздің қабілетіңізді сынағыңыз келсе, бір тесік жеткілікті болады.
Dialogue: 0,0:05:43.61,0:05:46.94,Default,,0,0,0,,Иә? (Жаңбыр дыбысы) Мен бас директорға есеп беремін.
Dialogue: 0,0:05:46.94,0:05:50.21,Default,,0,0,0,,Умм... Бір саңылау дұрыс па?
Dialogue: 0,0:05:50.21,0:05:52.55,Default,,0,0,0,,Маған бәрібір, бірақ
Dialogue: 0,0:05:52.55,0:05:55.88,Default,,0,0,0,,Амане Бұл курстағы ең қиын тесік қандай?
Dialogue: 0,0:05:55.88,0:05:57.89,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:05:58.89,0:06:00.89,Default,,0,0,0,,Бұл 14-ші тесік.
Dialogue: 0,0:06:03.89,0:06:07.90,Default,,0,0,0,,<14-ші тесік пар 5 490 ярд>
Dialogue: 0,0:06:08.90,0:06:11.23,Default,,0,0,0,,<Үлкен «итке» айналатын курста➡
Dialogue: 0,0:06:11.23,0:06:13.90,Default,,0,0,0,,Арасында биік ағаштар өсіп тұр➡
Dialogue: 0,0:06:13.90,0:06:17.57,Default,,0,0,0,,Арғы беттегі фарвейге төте жолды алу мүмкін емес.
Dialogue: 0,0:06:17.57,0:06:19.57,Default,,0,0,0,,<Сонымен қатар «ku» таңбасының жоғарғы жағынан➡
Dialogue: 0,0:06:19.57,0:06:22.91,Default,,0,0,0,,Радиалды түрде таралған тік төмен еңістер➡
Dialogue: 0,0:06:22.91,0:06:25.91,Default,,0,0,0,,Бұдан басқа үш үлкен бункер> бар
Dialogue: 0,0:06:25.91,0:06:28.25,Default,,0,0,0,,<Негізгі шабуыл әдісі➡
Dialogue: 0,0:06:28.25,0:06:30.59,Default,,0,0,0,,Фарвейдің тік еңісін ескере отырып➡
Dialogue: 0,0:06:30.59,0:06:32.59,Default,,0,0,0,,Егер сіз оны екі бункердің алдына тастасаңыз➡
Dialogue: 0,0:06:32.59,0:06:34.92,Default,,0,0,0,,Жасылға гүл жолы ашылады>
Dialogue: 0,0:06:34.92,0:06:38.93,Default,,0,0,0,,<Алайда, шыныаяққа дейін әлі де 270 ярд бар➡
Dialogue: 0,0:06:38.93,0:06:41.26,Default,,0,0,0,,2-ні көздеу қиын>
Dialogue: 0,0:06:41.26,0:06:43.27,Default,,0,0,0,,<Жолда бункерден аулақ болғаныңызша➡
Dialogue: 0,0:06:43.27,0:06:45.27,Default,,0,0,0,,Құсты көздеуге болады, бірақ➡
Dialogue: 0,0:06:45.27,0:06:47.60,Default,,0,0,0,,Бүркітті көздеу…＞
Dialogue: 0,0:06:47.60,0:06:49.87,Default,,0,0,0,,<Мен түсіндім, солай ма? Aoi> Қайсысы бірінші соғады?
Dialogue: 0,0:06:49.87,0:06:51.87,Default,,0,0,0,,Алдымен барыңыз.
Dialogue: 0,0:06:51.87,0:06:53.88,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:06:57.55,0:06:59.55,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:01.22,0:07:04.22,Default,,0,0,0,,<Жарлық? ＞
Dialogue: 0,0:07:04.22,0:07:07.89,Default,,0,0,0,,<Орманда саңылау бар ма? Жоқ＞
Dialogue: 0,0:07:07.89,0:07:11.23,Default,,0,0,0,,<Қанша ұқсатсам да, мұндай маршрут болған жоқ>
Dialogue: 0,0:07:11.23,0:07:13.23,Default,,0,0,0,,＜Басқаша айтқанда➡
Dialogue: 0,0:07:13.23,0:07:16.23,Default,,0,0,0,,Мен жай ғана «жеңіске жетуді қалаймын» деген сезімімді аштым➡
Dialogue: 0,0:07:16.23,0:07:18.23,Default,,0,0,0,,Өте абайсызда шабуыл＞
Dialogue: 0,0:07:20.24,0:07:25.91,Default,,0,0,0,,<Сол жалған бетті оқтарыммен бұрмалаймын>
Dialogue: 0,0:07:25.91,0:07:31.58,Default,,0,0,0,,Көк оқтың тікелей соққысы!
Dialogue: 0,0:07:31.58,0:07:39.25,Default,,0,0,0,,♬～
Dialogue: 0,0:07:39.25,0:07:41.92,Default,,0,0,0,,<Әлі емес>
Dialogue: 0,0:07:41.92,0:07:43.93,Default,,0,0,0,,<Әрі қарай итеріңіз! ＞
Dialogue: 0,0:07:43.93,0:07:49.23,Default,,0,0,0,,♬～
Dialogue: 0,0:07:56.87,0:07:59.87,Default,,0,0,0,,<Есептелген ұшу қашықтығы 210 ярд>
Dialogue: 0,0:08:01.21,0:08:03.55,Default,,0,0,0,,<150 ярд бекітуге қалды>
Dialogue: 0,0:08:03.55,0:08:06.55,Default,,0,0,0,,＜Түз мағынасында күшпен түсірілді＞
Dialogue: 0,0:08:06.55,0:08:09.22,Default,,0,0,0,,<Гольф ойыны қандай күшті>
Dialogue: 0,0:08:09.22,0:08:11.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.55,0:08:14.22,Default,,0,0,0,,Керемет кадр. Мен таң қалдым.
Dialogue: 0,0:08:14.22,0:08:16.56,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:08:16.56,0:08:18.56,Default,,0,0,0,,Себебі мен бақыттымын
Dialogue: 0,0:08:18.56,0:08:20.56,Default,,0,0,0,,Мен шынымен жеңіле алмаймын.
Dialogue: 0,0:08:22.56,0:08:24.90,Default,,0,0,0,,<Жеңіске ұмтыласыз ба? ＞
Dialogue: 0,0:08:24.90,0:08:27.57,Default,,0,0,0,,<Онда маған гольфыңды көрсет> (Жаңбыр естіледі) 48 дюйм ➡
Dialogue: 0,0:08:27.57,0:08:30.91,Default,,0,0,0,,Мен сізге оны енді пайдалануға рұқсат етпеймін. Түпнұсқа бұрауышты пайдаланыңыз.
Dialogue: 0,0:08:30.91,0:08:32.91,Default,,0,0,0,,Мүмкін сіз, мырза, сөгіс естігенді ұнататын сол қиын мінезді жандардың бірісіз бе?
Dialogue: 0,0:08:32.91,0:08:34.91,Default,,0,0,0,,<Драйверді ауыстырдыңыз ба? ＞
Dialogue: 0,0:08:39.58,0:08:42.58,Default,,0,0,0,,<Мен қатты толқып тұрмын>
Dialogue: 0,0:08:42.58,0:08:45.29,Default,,0,0,0,,<Соңғы рет қашан қатты қуандыңыз? ＞
Dialogue: 0,0:08:49.59,0:08:51.53,Default,,0,0,0,,<Мүмкін➡
Dialogue: 0,0:08:51.53,0:08:54.23,Default,,0,0,0,,Мүмкін әкеммен ойнаған кезден бері>
Dialogue: 0,0:08:56.20,0:08:58.20,Default,,0,0,0,,<Қайтадан ойлау>
Dialogue: 0,0:08:58.20,0:09:01.90,Default,,0,0,0,,<Гольф әрине қызық! ＞
Dialogue: 0,0:09:06.21,0:09:08.88,Default,,0,0,0,,Не? Мен оны әдеттегідей ұрдым.
Dialogue: 0,0:09:08.88,0:09:10.88,Default,,0,0,0,,Жоқ. Бұл... Иә?
Dialogue: 0,0:09:13.21,0:09:16.55,Default,,0,0,0,,Бұл траектория - кесінділік түсірілім!
Dialogue: 0,0:09:16.55,0:09:26.90,Default,,0,0,0,,♬～
Dialogue: 0,0:09:26.90,0:09:29.50,Default,,0,0,0,,《Аойдың екі сыйы бар》
Dialogue: 0,0:09:32.90,0:09:36.91,Default,,0,0,0,,《Бір менің қаным көктегі қыран》
Dialogue: 0,0:09:36.91,0:09:40.51,Default,,0,0,0,,《Басқасы менің күйеуім Хотаканың қаны》
Dialogue: 0,0:09:42.24,0:09:44.58,Default,,0,0,0,,《Осы екі сыйлықпен➡
Dialogue: 0,0:09:44.58,0:09:48.28,Default,,0,0,0,,Сол бала жоғарыға жүгіріп барады.
Dialogue: 0,0:09:50.92,0:09:52.92,Default,,0,0,0,,<Бас директор жоқ>
Dialogue: 0,0:09:52.92,0:09:56.26,Default,,0,0,0,,<Оның үшінші сыйлығы бар>
Dialogue: 0,0:09:56.26,0:10:00.93,Default,,0,0,0,,<Қысымсыз гольф ойынынан таза ләззат алу>
Dialogue: 0,0:10:00.93,0:10:04.93,Default,,0,0,0,,<Қарсыласыңыздың жүрегін жазықсыз күлімсіреу>
Dialogue: 0,0:10:06.60,0:10:09.94,Default,,0,0,0,,<“Жазықсыз тиран”> Уху
Dialogue: 0,0:10:13.64,0:10:15.64,Default,,0,0,0,,<Ол жігіттің добы қанша жерге ұшты? ＞
Dialogue: 0,0:10:15.64,0:10:17.65,Default,,0,0,0,,<Қаншалықты...>
Dialogue: 0,0:10:21.98,0:10:23.99,Default,,0,0,0,,Хауа сонда!
Dialogue: 0,0:10:27.32,0:10:31.66,Default,,0,0,0,,<Ол жерге 140 та қалған жоқ>
Dialogue: 0,0:10:31.66,0:10:34.66,Default,,0,0,0,,Неліктен доп сонша алыс?
Dialogue: 0,0:10:35.66,0:10:38.00,Default,,0,0,0,,<Мен оны сол жаққа қарай айналдырдым>
Dialogue: 0,0:10:38.00,0:10:41.60,Default,,0,0,0,,<Осындай кішкентай жерді белгіле...>
Dialogue: 0,0:10:41.60,0:10:45.94,Default,,0,0,0,,Бұл курстың дизайнері шынымен де дөрекі.
Dialogue: 0,0:10:45.94,0:10:48.61,Default,,0,0,0,,14-ші шұңқырда бір ғана тығылған болатын➡
Dialogue: 0,0:10:48.61,0:10:50.61,Default,,0,0,0,,Бүркіттің мүмкіндігі
Dialogue: 0,0:10:50.61,0:10:53.62,Default,,0,0,0,,Сен оны жақсы байқадың, Аой Уфу.
Dialogue: 0,0:10:53.62,0:10:56.95,Default,,0,0,0,,Турнирде жеңіске жету үшін➡
Dialogue: 0,0:10:56.95,0:10:59.25,Default,,0,0,0,,Мен мұны көп істеуім керек.
Dialogue: 0,0:11:01.62,0:11:03.63,Default,,0,0,0,,Қашықтықты өлшеудің қажеті жоқ, солай ма?
Dialogue: 0,0:11:03.63,0:11:06.96,Default,,0,0,0,,Бұл сіздің екінші атуыңыз, мен білемін.
Dialogue: 0,0:11:06.96,0:11:22.64,Default,,0,0,0,,♬～
Dialogue: 0,0:11:22.64,0:11:24.65,Default,,0,0,0,,Неге менің артымнан келе жатырсың?
Dialogue: 0,0:11:26.65,0:11:29.65,Default,,0,0,0,,Мен оны көргім келеді, жарай ма?
Dialogue: 0,0:11:29.65,0:11:31.65,Default,,0,0,0,,Маған ұнаса ше?
Dialogue: 0,0:11:32.99,0:11:36.66,Default,,0,0,0,,⚟ Рахмет! (Жаңбырдың дауысы күрсінеді)
Dialogue: 0,0:11:36.66,0:11:39.06,Default,,0,0,0,,<Бұл кінәсіздік...>
Dialogue: 0,0:11:45.27,0:11:48.27,Default,,0,0,0,,Бұл позициядан жасыл түсті көре алмайсыз.
Dialogue: 0,0:11:48.27,0:11:50.27,Default,,0,0,0,,Не істеу керек? кеш
Dialogue: 0,0:11:50.27,0:11:55.28,Default,,0,0,0,,Оң жақтағы ағаштарды... үнсіз кесіп өтер едім.
Dialogue: 0,0:11:55.28,0:11:57.28,Default,,0,0,0,,Кешіріңіз, мен жай ғана...
Dialogue: 0,0:11:59.95,0:12:01.95,Default,,0,0,0,,<Түсіру>
Dialogue: 0,0:12:01.95,0:12:06.29,Default,,0,0,0,,<Осы оқпен сенің жүрегің>
Dialogue: 0,0:12:06.29,0:12:10.99,Default,,0,0,0,,<Аспанның қызыл оғы! ＞
Dialogue: 0,0:12:15.96,0:12:17.97,Default,,0,0,0,,<Шығу>
Dialogue: 0,0:12:21.30,0:12:23.30,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:24.31,0:12:27.64,Default,,0,0,0,,Оң жаққа сәл көбірек болса жақсы болар еді...
Dialogue: 0,0:12:27.64,0:12:29.64,Default,,0,0,0,,Е...
Dialogue: 0,0:12:29.64,0:12:35.98,Default,,0,0,0,,♬～
Dialogue: 0,0:12:35.98,0:12:37.99,Default,,0,0,0,,<Жойылған>
Dialogue: 0,0:12:37.99,0:12:40.92,Default,,0,0,0,,<Мен жасылды ұстай алмадым>
Dialogue: 0,0:12:40.92,0:12:42.92,Default,,0,0,0,,<Неге? ＞
Dialogue: 0,0:12:42.92,0:12:48.93,Default,,0,0,0,,Сіз қалай ойлайсыз? Аойдың күлкісімен жаншылғанына қалай қарайсың?
Dialogue: 0,0:12:48.93,0:12:52.27,Default,,0,0,0,,<Ух... сіз бұл жерден атып өттіңіз бе? ＞
Dialogue: 0,0:12:52.27,0:12:58.27,Default,,0,0,0,,<Мен бұл баланың гольф ойнағанын көргеннен бері...>
Dialogue: 0,0:13:03.95,0:13:05.95,Default,,0,0,0,,<Жоқ. 9…>
Dialogue: 0,0:13:05.95,0:13:08.28,Default,,0,0,0,,Неліктен 9 саны әлі көп болса?
Dialogue: 0,0:13:08.28,0:13:11.59,Default,,0,0,0,,Бұл ойын, сондықтан ешқандай кемістік болмауы керек.
Dialogue: 0,0:13:12.95,0:13:15.62,Default,,0,0,0,,<Бұл… бұл жігіт…>
Dialogue: 0,0:13:15.62,0:13:17.63,Default,,0,0,0,,<Мен айттым ғой, солай ма? ＞
Dialogue: 0,0:13:17.63,0:13:21.03,Default,,0,0,0,,<Мына қыз күліп сені жымиды>
Dialogue: 0,0:13:21.96,0:13:24.63,Default,,0,0,0,,<Гольф ойынынан шынайы ләззат алуға қатынас>
Dialogue: 0,0:13:24.63,0:13:28.97,Default,,0,0,0,,<Ол баланың күлкісіне ешқандай дұшпандық немесе қысым жете алмайды>
Dialogue: 0,0:13:28.97,0:13:32.64,Default,,0,0,0,,<Оның үш сыйы бар...>
Dialogue: 0,0:13:32.64,0:13:37.98,Default,,0,0,0,,♬～
Dialogue: 0,0:13:37.98,0:13:40.58,Default,,0,0,0,,<Аои Аоидың мәні>
Dialogue: 0,0:13:40.58,0:13:44.29,Default,,0,0,0,,Өйткені, бұл 9 саны...
Dialogue: 0,0:13:47.59,0:13:49.59,Default,,0,0,0,,Сәл жетіспейтін сияқты.
Dialogue: 0,0:13:49.59,0:13:53.26,Default,,0,0,0,,<Хмф... Қазір оның жүрегі мүлде жараланған...>
Dialogue: 0,0:13:53.26,0:13:56.26,Default,,0,0,0,,А... (Жаңбырдың дыбысы естіледі) <Мен күлдім! ? ＞
Dialogue: 0,0:13:56.26,0:13:58.27,Default,,0,0,0,,Бұл шынымен таңқаларлық.
Dialogue: 0,0:13:58.27,0:14:00.94,Default,,0,0,0,,Мен сіздей дарынды гольф ойыншысын бірінші рет көріп тұрмын.
Dialogue: 0,0:14:00.94,0:14:02.94,Default,,0,0,0,,Мен де
Dialogue: 0,0:14:02.94,0:14:06.94,Default,,0,0,0,,Мен мұндай ерекше және агрессивті гольфты ешқашан көрген емеспін.
Dialogue: 0,0:14:06.94,0:14:09.28,Default,,0,0,0,,Мен оны бірінші рет көрсем де...
Dialogue: 0,0:14:09.28,0:14:12.28,Default,,0,0,0,,Бірақ ол да әйтеуір сағыныш сезімін тудырады.
Dialogue: 0,0:14:12.28,0:14:15.28,Default,,0,0,0,,Есіміңді кім деп айттың?
Dialogue: 0,0:14:15.28,0:14:19.29,Default,,0,0,0,,Аои... Менің атым Аои Амаваши. Сен ше?
Dialogue: 0,0:14:19.29,0:14:23.62,Default,,0,0,0,,Хауа Менің фамилиям жоқ, бұл жай Хауа.
Dialogue: 0,0:14:23.62,0:14:25.63,Default,,0,0,0,,«Хауа»…
Dialogue: 0,0:14:25.63,0:14:29.63,Default,,0,0,0,,Сіз бұл бүркітті міндетті түрде жасайсыз.
Dialogue: 0,0:14:31.63,0:14:34.97,Default,,0,0,0,,<Басқаша айтқанда, менің жеңу мүмкіндігім жойылды.>
Dialogue: 0,0:14:34.97,0:14:37.97,Default,,0,0,0,,<Бірақ мен әлі жеңілген жоқпын>
Dialogue: 0,0:14:41.58,0:14:43.58,Default,,0,0,0,,<Мен жоғалтқан сияқты емеспін>
Dialogue: 0,0:14:43.58,0:14:46.98,Default,,0,0,0,,<Шынымен, мен қатты қысылып қалдым, неге? ＞
Dialogue: 0,0:14:48.25,0:14:51.55,Default,,0,0,0,,<Мен бұрын-соңды сезінбеген қатты толқыдым>
Dialogue: 0,0:14:53.92,0:14:57.93,Default,,0,0,0,,Путтер? Сіз оны осы бұрыштан қалай жасайсыз?
Dialogue: 0,0:14:59.26,0:15:01.26,Default,,0,0,0,,Қызықты
Dialogue: 0,0:15:01.26,0:15:05.27,Default,,0,0,0,,Мен ол жігіттің гольфінен көзімді ала алмаймын.
Dialogue: 0,0:15:06.60,0:15:08.60,Default,,0,0,0,,<Оны алып тастау туралы ойламаңыз>
Dialogue: 0,0:15:08.60,0:15:10.94,Default,,0,0,0,,<Нысаған олжаны жеңу>
Dialogue: 0,0:15:10.94,0:15:12.94,Default,,0,0,0,,<Қалағаныңды ал>
Dialogue: 0,0:15:12.94,0:15:15.28,Default,,0,0,0,,<Бұл менің гольфім>
Dialogue: 0,0:15:15.28,0:15:17.28,Default,,0,0,0,,<Менің өмір жолым>
Dialogue: 0,0:15:18.61,0:15:22.28,Default,,0,0,0,,<Сараңдықтың жасыл оғы! ＞
Dialogue: 0,0:15:22.28,0:15:27.29,Default,,0,0,0,,♬～
Dialogue: 0,0:15:27.29,0:15:29.29,Default,,0,0,0,,Қабылданбаған соққы
Dialogue: 0,0:15:29.29,0:15:31.29,Default,,0,0,0,,<Жоқ, жоқ>
Dialogue: 0,0:15:31.29,0:15:33.29,Default,,0,0,0,,<Бұл түзу>
Dialogue: 0,0:15:35.63,0:15:37.63,Default,,0,0,0,,<Ең қысқа уақытта кубокты мақсат ет>
Dialogue: 0,0:15:37.63,0:15:39.63,Default,,0,0,0,,<Фрэнк және бычий гольф>
Dialogue: 0,0:15:39.63,0:15:41.64,Default,,0,0,0,,<Сонымен...>
Dialogue: 0,0:15:43.24,0:15:45.24,Default,,0,0,0,,<Мен сенен бұлай көзімді ала алмаймын>
Dialogue: 0,0:15:47.58,0:15:50.58,Default,,0,0,0,,Тым күшті... Болмаймын.
Dialogue: 0,0:15:50.58,0:15:53.58,Default,,0,0,0,,Не? Ол адамның селк ете алмайтынына еш себеп жоқ...
Dialogue: 0,0:15:53.58,0:16:06.26,Default,,0,0,0,,♬～
Dialogue: 0,0:16:06.26,0:16:09.56,Default,,0,0,0,,<Бірақ мен қанағаттанамын>
Dialogue: 0,0:16:12.60,0:16:19.61,Default,,0,0,0,,<Себебі мен гольф менің өмірімде болған ең қызық деп ойладым>
Dialogue: 0,0:16:23.28,0:16:25.28,Default,,0,0,0,,Жүр, кел, кел.
Dialogue: 0,0:16:25.28,0:16:30.62,Default,,0,0,0,,Егер сіз шыныаяқты бір оқпен алсаңыз, онда сіз 1000 Юре аласыз.
Dialogue: 0,0:16:30.62,0:16:34.29,Default,,0,0,0,,Бұл бір уақытта 100 иен. Келіңіз, жасаңыз, жасаңыз.
Dialogue: 0,0:16:34.29,0:16:37.29,Default,,0,0,0,,Бір рет Иә Әр жолы
Dialogue: 0,0:16:45.57,0:16:47.57,Default,,0,0,0,,Әй, қандай ұят.
Dialogue: 0,0:16:47.57,0:16:51.57,Default,,0,0,0,,Тағы бір рет, бар күшіңізді салыңыз.
Dialogue: 0,0:16:51.57,0:16:55.91,Default,,0,0,0,,<Уфуфу... Сен ақымақсың. Сен ақымақсың. Сіз өте ақымақсыз.>
Dialogue: 0,0:16:55.91,0:16:59.91,Default,,0,0,0,,<Мұндай дәмді әңгімелер әлемде өзгермейді.>
Dialogue: 0,0:17:01.25,0:17:03.25,Default,,0,0,0,,<Қандай айла?>
Dialogue: 0,0:17:04.25,0:17:06.55,Default,,0,0,0,,<Оның ішінде магнит бар ма?>
Dialogue: 0,0:17:09.26,0:17:12.59,Default,,0,0,0,,Қарғыс атсын, бұл ұят.
Dialogue: 0,0:17:12.59,0:17:14.93,Default,,0,0,0,,Қайталап көріңіз.
Dialogue: 0,0:17:14.93,0:17:18.60,Default,,0,0,0,,<Барса Барса> Иә?
Dialogue: 0,0:17:18.60,0:17:22.60,Default,,0,0,0,,Иә, бір адам, шақыру... Сонымен...
Dialogue: 0,0:17:24.94,0:17:26.94,Default,,0,0,0,,Әй... Әй, не істеп жатырсың...
Dialogue: 0,0:17:26.94,0:17:28.94,Default,,0,0,0,,(ренжіген дауыс)
Dialogue: 0,0:17:28.94,0:17:30.95,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:17:32.95,0:17:34.95,Default,,0,0,0,,(ерлер қолдайды)
Dialogue: 0,0:17:34.95,0:17:38.95,Default,,0,0,0,,1000 Yure Бір саладағы адамдарға қатысуға тыйым салынады!
Dialogue: 0,0:17:38.95,0:17:42.56,Default,,0,0,0,,Мен үшін не істеп жатырсың? Сен ақымақсың ба? иә! ?
Dialogue: 0,0:17:42.56,0:17:46.23,Default,,0,0,0,,1000 Yure You...
Dialogue: 0,0:17:46.23,0:17:49.23,Default,,0,0,0,,Ақша төлеудің қажеті жоқ, тек бастықпен кездесуге рұқсат етіңіз.
Dialogue: 0,0:17:50.23,0:17:52.23,Default,,0,0,0,,Роуз Ареонға
Dialogue: 0,0:17:56.57,0:17:58.57,Default,,0,0,0,,Ева
Dialogue: 0,0:17:58.57,0:18:00.58,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:18:00.58,0:18:02.58,Default,,0,0,0,,Жапониядан келген жас гольф ойыншысы➡
Dialogue: 0,0:18:02.58,0:18:04.58,Default,,0,0,0,,Көтенпан саған шабуыл жасады ма?
Dialogue: 0,0:18:04.58,0:18:06.58,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:18:06.58,0:18:08.58,Default,,0,0,0,,Ақпарат – күш
Dialogue: 0,0:18:08.58,0:18:12.92,Default,,0,0,0,,Акциялар, саясат, тіпті SNS-тегі «жақсы» адамдардың саны➡
Dialogue: 0,0:18:12.92,0:18:14.92,Default,,0,0,0,,Барлығы ақпаратқа байланысты
Dialogue: 0,0:18:15.92,0:18:20.26,Default,,0,0,0,,«Бүгін U15 әйелдер арасындағы әлем чемпионаты басталды»
Dialogue: 0,0:18:20.26,0:18:25.27,Default,,0,0,0,,«Бірінші күні бірінші орынға шыққан адам Жапония құрамасының ойыншысы Аои Амаваши болды».
Dialogue: 0,0:18:25.27,0:18:27.60,Default,,0,0,0,,«Ұлттық құраманың басқа ойыншылары➡
Dialogue: 0,0:18:27.60,0:18:31.27,Default,,0,0,0,,Нафреске тән желден зардап шегіп, ұпайды жақсарта алмау➡
Dialogue: 0,0:18:31.27,0:18:33.27,Default,,0,0,0,,5 құс, 1 бүркіт»…
Dialogue: 0,0:18:33.27,0:18:35.94,Default,,0,0,0,,Көк майлақ
Dialogue: 0,0:18:35.94,0:18:37.95,Default,,0,0,0,,20 жыл бұрын➡
Dialogue: 0,0:18:37.95,0:18:42.22,Default,,0,0,0,,Дүниежүзілік турда белсенді болған кәсіпқой әйел Сейла Амвасимен➡
Dialogue: 0,0:18:42.22,0:18:47.22,Default,,0,0,0,,Оның жалғыз қызы Казухико Ходакамен, кәсіпқой, құбыжық деп аталды.
Dialogue: 0,0:18:47.22,0:18:53.23,Default,,0,0,0,,Мен кішкентай кезімнен дарынды гольф бойынша білім алып өстім. Шынайы заттардың арасындағы шынайы нәрсе.
Dialogue: 0,0:18:54.23,0:18:56.90,Default,,0,0,0,,Айтпақшы, бұл клуб Athena бренді➡
Dialogue: 0,0:18:56.90,0:19:00.90,Default,,0,0,0,,Оны бас директоры Сейра Амаваси болып табылатын компания жасаған.
Dialogue: 0,0:19:01.90,0:19:04.57,Default,,0,0,0,,Гольф туралы көп білмесеңіз де➡
Dialogue: 0,0:19:04.57,0:19:07.27,Default,,0,0,0,,Сіз бұл логотипті бұрын көрген шығарсыз, солай ма?
Dialogue: 0,0:19:08.24,0:19:11.25,Default,,0,0,0,,Сіз қалай ойлайсыз? 1000 еуро туралы ақпарат алдыңыз ба?
Dialogue: 0,0:19:11.25,0:19:13.25,Default,,0,0,0,,жеткіліксіз
Dialogue: 0,0:19:14.25,0:19:16.25,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,0:19:16.25,0:19:19.25,Default,,0,0,0,,Бұл сахнаның артында өмір сүретін заңсыз тіршілік.
Dialogue: 0,0:19:19.25,0:19:23.26,Default,,0,0,0,,Онда мен күн сәулесінде дұрыс, күшті жүремін➡
Dialogue: 0,0:19:23.26,0:19:25.59,Default,,0,0,0,,Оның үстіне ол өте атақты.
Dialogue: 0,0:19:25.59,0:19:27.93,Default,,0,0,0,,Бір сәтке де кездескеніміз бір ғажап...
Dialogue: 0,0:19:27.93,0:19:30.53,Default,,0,0,0,,Мен мұндай хабарды естуге келген жоқпын.
Dialogue: 0,0:19:31.93,0:19:34.27,Default,,0,0,0,,Сіз шынымен осы жапондармен күрескіңіз келе ме?
Dialogue: 0,0:19:34.27,0:19:36.27,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:38.61,0:19:40.61,Default,,0,0,0,,《жоғалту, жоғалту》
Dialogue: 0,0:19:40.61,0:19:43.01,Default,,0,0,0,,《Қайнау немесе пісіру, қалағаныңызша》
Dialogue: 0,0:19:45.28,0:19:49.95,Default,,0,0,0,,《Онда менің бір ғана өтінішім бар.》 《Не? 》
Dialogue: 0,0:19:49.95,0:19:54.29,Default,,0,0,0,,《Менімен тағы да гольф ойнайсың ба?》
Dialogue: 0,0:19:54.29,0:19:56.96,Default,,0,0,0,,《Бір саңылау емес, бір айналым》
Dialogue: 0,0:19:56.96,0:20:01.63,Default,,0,0,0,,《Мен сенімен бар күшіммен гольф ойнағым келеді》
Dialogue: 0,0:20:01.63,0:20:03.63,Default,,0,0,0,,《Бұл...》
Dialogue: 0,0:20:03.63,0:20:06.33,Default,,0,0,0,,《Бұл уәде》
Dialogue: 0,0:20:09.30,0:20:11.31,Default,,0,0,0,,《Мені қорғашы》
Dialogue: 0,0:20:12.97,0:20:14.98,Default,,0,0,0,,«Неге»...
Dialogue: 0,0:20:14.98,0:20:17.98,Default,,0,0,0,,Өйткені мұны істеу мағынасы бар.
Dialogue: 0,0:20:17.98,0:20:20.98,Default,,0,0,0,,Сіз өзіңіз ойлағандай ақымақ емессіз.
Dialogue: 0,0:20:20.98,0:20:23.65,Default,,0,0,0,,Сен маған не үшін келдің?
Dialogue: 0,0:20:23.65,0:20:26.65,Default,,0,0,0,,Сіз менің меценатымның билігін бергенімді қалайсыз, солай ма?
Dialogue: 0,0:20:26.65,0:20:32.33,Default,,0,0,0,,15 жасқа дейінгі әйелдер арасындағы әлем чемпионатының бас демеушісі ретінде қосылды
Dialogue: 0,0:20:32.33,0:20:34.33,Default,,0,0,0,,«Кэтриннің» күші
Dialogue: 0,0:20:35.33,0:20:39.00,Default,,0,0,0,,Әрине, қолыңнан келмейтін нәрсе жоқ...
Dialogue: 0,0:20:39.00,0:20:41.60,Default,,0,0,0,,Бұл қарыз қымбат.
Dialogue: 0,0:20:41.60,0:20:43.60,Default,,0,0,0,,Мен әрқашан дайынмын...
Dialogue: 0,0:20:44.94,0:20:46.94,Default,,0,0,0,,Сол күннен бастап мұнда...
Dialogue: 0,0:20:46.94,0:20:50.28,Default,,0,0,0,,Бұл жерде ауырады, ауырады, мен оған көмектесе алмаймын
Dialogue: 0,0:20:50.28,0:20:53.28,Default,,0,0,0,,Жалғыз қалдырсам, жарылып кете жаздады.
Dialogue: 0,0:20:54.62,0:20:58.32,Default,,0,0,0,,Оқ әлдеқашан жүктелді ме? Иә.
Dialogue: 0,0:20:59.95,0:21:03.29,Default,,0,0,0,,Тек триггерді тартыңыз
Dialogue: 0,0:21:03.29,0:21:23.31,Default,,0,0,0,,♬～
Dialogue: 0,0:21:23.31,0:21:43.26,Default,,0,0,0,,♬～
Dialogue: 0,0:21:43.26,0:22:03.28,Default,,0,0,0,,♬～
Dialogue: 0,0:22:03.28,0:22:23.30,Default,,0,0,0,,♬～
Dialogue: 0,0:22:23.30,0:22:32.98,Default,,0,0,0,,♬～
Dialogue: 0,0:22:32.98,0:22:37.32,Default,,0,0,0,,"U15 әйелдер арасындағы әлем чемпионатының финалдық күні"
Dialogue: 0,0:22:37.32,0:22:40.92,Default,,0,0,0,,«Турнир көшбасшысы Аои Амаваши➡
Dialogue: 0,0:22:40.92,0:22:43.26,Default,,0,0,0,,Соңғы топтан бастаңыз».
Dialogue: 0,0:22:43.26,0:22:46.26,Default,,0,0,0,,Жақында 6-топ басталады.
Dialogue: 0,0:22:46.26,0:22:48.26,Default,,0,0,0,,Аои - 9-шы
Dialogue: 0,0:22:48.26,0:22:51.93,Default,,0,0,0,,Қазір дайындықты бастайық. Иә, дұрыс.
Dialogue: 0,0:22:51.93,0:22:54.60,Default,,0,0,0,,<Ешқандай қажетсіз қысым жоқ>
Dialogue: 0,0:22:54.60,0:22:56.94,Default,,0,0,0,,<2-орынның айырмашылығы 7-ден төмен>
Dialogue: 0,0:22:56.94,0:23:00.94,Default,,0,0,0,,<Aoi жеңіске жету жолында>
Dialogue: 0,0:23:03.94,0:23:05.95,Default,,0,0,0,,Не болды? Аой
Dialogue: 0,0:23:06.95,0:23:08.95,Default,,0,0,0,,Аой! ?
Dialogue: 0,0:23:08.95,0:23:14.96,Default,,0,0,0,,♬～
Dialogue: 0,0:23:14.96,0:23:17.63,Default,,0,0,0,,<Бұл адам екеніне күмән жоқ>
Dialogue: 0,0:23:17.63,0:23:20.63,Default,,0,0,0,,《Бір саңылау емес, бір айналым》
Dialogue: 0,0:23:20.63,0:23:24.63,Default,,0,0,0,,《Мен сенімен бар күшіммен гольф ойнағым келеді》
Dialogue: 0,0:23:27.30,0:23:29.30,Default,,0,0,0,,<Ол уәдесінде тұрды>
Dialogue: 0,0:23:31.64,0:23:35.34,Default,,0,0,0,,<Мен оның гольфін қайтадан көремін>
Dialogue: 0,0:23:37.31,0:23:39.31,Default,,0,0,0,,<Сол көк...>
Dialogue: 0,0:23:39.31,0:23:45.92,Default,,0,0,0,,♬～
Dialogue: 0,0:23:45.92,0:23:47.92,Default,,0,0,0,,<Көк оқ>
Dialogue: 0,0:23:50.92,0:23:52.93,Default,,0,0,0,,<Аои Тэнваши ақырында Хауамен матч болады>
Dialogue: 0,0:23:52.93,0:23:54.93,Default,,0,0,0,,<Егер тессеңіз➡
Dialogue: 0,0:23:54.93,0:23:56.93,Default,,0,0,0,,Бірге тамақ ішіп, қыздар ваннада сөйлеседі＞
Dialogue: 0,0:23:56.93,0:23:58.93,Default,,0,0,0,,<Бұл құстың әрекетін шешу керек>
Dialogue: 0,0:24:00.43,0:24:06.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory