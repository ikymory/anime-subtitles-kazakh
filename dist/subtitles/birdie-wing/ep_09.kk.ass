Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.63,0:00:07.64,Default,,0,0,0,,📱 (Дабыл)
Dialogue: 0,0:00:19.65,0:00:23.32,Default,,0,0,0,,📱 (Дабыл)
Dialogue: 0,0:00:23.32,0:00:25.99,Default,,0,0,0,,Уф Айтата... Уф!
Dialogue: 0,0:00:25.99,0:00:28.99,Default,,0,0,0,,📱 (Дабыл) Уау!
Dialogue: 0,0:00:28.99,0:00:30.99,Default,,0,0,0,,Ал... бұл жаман!
Dialogue: 0,0:00:30.99,0:00:36.33,Default,,0,0,0,,♬～
Dialogue: 0,0:00:36.33,0:00:38.33,Default,,0,0,0,,<Менің атым Ичина Саотоме>
Dialogue: 0,0:00:38.33,0:00:43.34,Default,,0,0,0,,<Райоу жеке қыздар академиясының бірінші курс студенті, гольф клубының мүшесі>
Dialogue: 0,0:00:43.34,0:00:47.68,Default,,0,0,0,,<Менің болашақтағы арманым - бірінші дәрежелі кәсіби кэдди болу>
Dialogue: 0,0:00:47.68,0:00:50.35,Default,,0,0,0,,<Сіз білесіз бе? Үздік кәсіби кәдди➡
Dialogue: 0,0:00:50.35,0:00:52.35,Default,,0,0,0,,Сіз көп ақша таба аласыз＞
Dialogue: 0,0:00:53.35,0:00:58.02,Default,,0,0,0,,<Бірінші дәрежелі кәдди нашар туристке қарағанда көбірек ақшалай сыйлық алады➡
Dialogue: 0,0:00:58.02,0:01:00.62,Default,,0,0,0,,Көп ақша табатын кездер болады...＞
Dialogue: 0,0:01:01.62,0:01:05.29,Default,,0,0,0,,<Сондықтан мен бірінші дәрежелі кәсіби кәдди болғым келеді➡
Dialogue: 0,0:01:05.29,0:01:09.97,Default,,0,0,0,,Беделді Raiou Gakuen гольф клубында...＞
Dialogue: 0,0:01:09.97,0:01:13.30,Default,,0,0,0,,А... мен кеттім.
Dialogue: 0,0:01:13.30,0:01:15.64,Default,,0,0,0,,Бұл... мен бесінші рет кешігіп жатырмын.
Dialogue: 0,0:01:15.64,0:01:18.64,Default,,0,0,0,,Мені үлкендер ұрысады.
Dialogue: 0,0:01:18.64,0:01:20.64,Default,,0,0,0,,⚟ Иә?
Dialogue: 0,0:01:20.64,0:01:22.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:23.65,0:01:27.98,Default,,0,0,0,,Саотоме-сан, не болды? Автобус кетіп қалды.
Dialogue: 0,0:01:27.98,0:01:32.32,Default,,0,0,0,,Аа, Синджо мырза Ахаха... Сәлеметсіз бе.
Dialogue: 0,0:01:32.32,0:01:34.66,Default,,0,0,0,,Ичина-чан, тағы да кешіктің бе?
Dialogue: 0,0:01:34.66,0:01:37.66,Default,,0,0,0,,Жақында директор Амуро мені жазалауы мүмкін.
Dialogue: 0,0:01:37.66,0:01:41.33,Default,,0,0,0,,Уф... Мен Гупанды жек көремін.
Dialogue: 0,0:01:41.33,0:01:44.33,Default,,0,0,0,,А, одан да Тенваши-сан.
Dialogue: 0,0:01:44.33,0:01:47.67,Default,,0,0,0,,Бұл өткен күнгі жаттығу матчы туралы.
Dialogue: 0,0:01:47.67,0:01:49.67,Default,,0,0,0,,6-шы тесіктің екінші атысы ➡
Dialogue: 0,0:01:49.67,0:01:53.08,Default,,0,0,0,,8 үтіктің орнына 7 үтік қолданған дұрыс болар еді.
Dialogue: 0,0:01:55.34,0:01:57.35,Default,,0,0,0,,Иә
Dialogue: 0,0:01:57.35,0:02:00.95,Default,,0,0,0,,Менің курстық стратегиямда ақау бар деп ойлайсыз ба?
Dialogue: 0,0:02:00.95,0:02:04.62,Default,,0,0,0,,Жоқ, сол күні қатты жел соқты➡
Dialogue: 0,0:02:04.62,0:02:07.96,Default,,0,0,0,,7 саны жақсы ма деп ойлаймын...
Dialogue: 0,0:02:07.96,0:02:10.63,Default,,0,0,0,,Рахмет, мен оны анықтамалық ретінде пайдаланамын.
Dialogue: 0,0:02:10.63,0:02:14.63,Default,,0,0,0,,Қарсы болмасаң, сенімен бірге мінсем бола ма?
Dialogue: 0,0:02:14.63,0:02:17.63,Default,,0,0,0,,Аой қазір көлікте кездесуге барамыз.
Dialogue: 0,0:02:17.63,0:02:19.97,Default,,0,0,0,,Саотоме-сан, кешіріңіз.
Dialogue: 0,0:02:19.97,0:02:22.64,Default,,0,0,0,,Жоқ, өтінемін, өтінемін.
Dialogue: 0,0:02:22.64,0:02:24.64,Default,,0,0,0,,Кешігіп келгеніме мен кінәлімін.
Dialogue: 0,0:02:24.64,0:02:28.31,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:02:28.31,0:02:30.31,Default,,0,0,0,,Мені шығаруыңызды өтінемін. (Жүргізуші) Иә.
Dialogue: 0,0:02:34.32,0:02:36.32,Default,,0,0,0,,А, мен қобалжыдым.
Dialogue: 0,0:02:36.32,0:02:40.62,Default,,0,0,0,,Тенваши мырза күткендей, сіз супер буржуазиясыз.
Dialogue: 0,0:02:41.99,0:02:43.99,Default,,0,0,0,,Жоқ екеніне сенімдісіз бе?
Dialogue: 0,0:02:43.99,0:02:49.00,Default,,0,0,0,,Аой Кездесуді бастайық. Иә, түсінемін.
Dialogue: 0,0:02:50.33,0:03:10.29,Default,,0,0,0,,♬～
Dialogue: 0,0:03:10.29,0:03:30.31,Default,,0,0,0,,♬～
Dialogue: 0,0:03:30.31,0:03:50.33,Default,,0,0,0,,♬～
Dialogue: 0,0:03:50.33,0:04:10.28,Default,,0,0,0,,♬～
Dialogue: 0,0:04:10.28,0:04:18.95,Default,,0,0,0,,♬～
Dialogue: 0,0:04:33.64,0:04:38.31,Default,,0,0,0,,Мен бәрібір кешіккенім үшін жаза ретінде клуб бөлмесін тазалауға мәжбүр боламын➡
Dialogue: 0,0:04:38.31,0:04:40.31,Default,,0,0,0,,Мен мұны қазір жасаймын.
Dialogue: 0,0:04:40.31,0:04:45.98,Default,,0,0,0,,Бірақ менің ойымша, сол 6-шы тесіктің екінші түсірілімі шын мәнінде 7-ші тесік.
Dialogue: 0,0:04:45.98,0:04:49.65,Default,,0,0,0,,Егер ол 7 саны болса, ол сөзсіз берік болар еді.
Dialogue: 0,0:04:49.65,0:04:52.92,Default,,0,0,0,,Мен де солай ойлаймын...
Dialogue: 0,0:04:52.92,0:04:56.26,Default,,0,0,0,,Ал, 6-шы шұңқырдағы жасыл түстің артқы жағы төмен қарай ➡
Dialogue: 0,0:04:56.26,0:04:59.93,Default,,0,0,0,,Дегенмен 8 санымен қауіпсіз жүруге болады.
Dialogue: 0,0:04:59.93,0:05:02.26,Default,,0,0,0,,Өйткені гольфте агрессивті болуың керек.➡
Dialogue: 0,0:05:02.26,0:05:04.27,Default,,0,0,0,,Ең бастысы - шабуылдарыңыздың дәлдігін жақсарту➡
Dialogue: 0,0:05:04.27,0:05:06.60,Default,,0,0,0,,Гольф ойыншысы болудың нағыз қызығы, дәлірек айтсақ мәні...
Dialogue: 0,0:05:06.60,0:05:08.60,Default,,0,0,0,,...
Dialogue: 0,0:05:08.60,0:05:12.94,Default,,0,0,0,,Бұл не... Харука (Харука) «Алу» дегенді қалай түсінесіңдер?
Dialogue: 0,0:05:12.94,0:05:14.94,Default,,0,0,0,,Не... Неге Харука мұнда?
Dialogue: 0,0:05:14.94,0:05:16.95,Default,,0,0,0,,Сіз кешіктіңіз бе?
Dialogue: 0,0:05:16.95,0:05:20.28,Default,,0,0,0,,Кешігіп қалған сенсің, Салмақты менмін.
Dialogue: 0,0:05:20.28,0:05:22.28,Default,,0,0,0,,Бірінші жыл үлкендерге қамқорлық жасау болды➡
Dialogue: 0,0:05:22.28,0:05:24.95,Default,,0,0,0,,Маған тек анда-санда сойылмен серуендеуге рұқсат бар.
Dialogue: 0,0:05:24.95,0:05:26.96,Default,,0,0,0,,Курсқа барудың қажеті жоқ.
Dialogue: 0,0:05:26.96,0:05:29.62,Default,,0,0,0,,Күткендей мен бір кездері орта мектепте оқып жүргенде елде 3-ші орын алдым➡
Dialogue: 0,0:05:29.62,0:05:31.63,Default,,0,0,0,,Харука Мизоно
Dialogue: 0,0:05:31.63,0:05:33.63,Default,,0,0,0,,Қандай ерлік.
Dialogue: 0,0:05:33.63,0:05:37.97,Default,,0,0,0,,Аа, үйірме жұмыстарын өткізіп жіберсеңіз, тазалауға көмектесуіңізді өтінемін бе?
Dialogue: 0,0:05:37.97,0:05:40.30,Default,,0,0,0,,Ву (Харука) Ичина
Dialogue: 0,0:05:40.30,0:05:42.30,Default,,0,0,0,,Менің көмекшім бол
Dialogue: 0,0:05:42.30,0:05:44.31,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:05:44.31,0:05:47.98,Default,,0,0,0,,Сенің желіңді оқитын қуат Мен жолдарды оқитын қуат алғым келеді
Dialogue: 0,0:05:47.98,0:05:49.98,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:05:51.25,0:05:54.55,Default,,0,0,0,,Тенваши Мен Аоиды жеңгім келеді. Бұл мүмкін емес.
Dialogue: 0,0:05:55.58,0:05:57.59,Default,,0,0,0,,Егер Ичина ынтымақтаса➡
Dialogue: 0,0:05:57.59,0:06:00.92,Default,,0,0,0,,Бұл жолы Тэнваши Аои... сондықтан бұл мүмкін емес.
Dialogue: 0,0:06:00.92,0:06:03.59,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:06:03.59,0:06:05.93,Default,,0,0,0,,Қашықтық дәлдігі➡
Dialogue: 0,0:06:05.93,0:06:09.26,Default,,0,0,0,,Тенваши барлық жағынан Харукадан жақсы.
Dialogue: 0,0:06:09.26,0:06:11.93,Default,,0,0,0,,Тіпті егер мен кастинг➡
Dialogue: 0,0:06:11.93,0:06:14.94,Default,,0,0,0,,Қазіргі Харука Тенваши-санды жеңе алмайды.
Dialogue: 0,0:06:26.28,0:06:29.95,Default,,0,0,0,,А... бұл қауіпті...
Dialogue: 0,0:06:29.95,0:06:31.95,Default,,0,0,0,,Бұл кім? ?
Dialogue: 0,0:06:34.96,0:06:36.96,Default,,0,0,0,,Біз бункерден өттік (Харука) иә?
Dialogue: 0,0:06:36.96,0:06:39.29,Default,,0,0,0,,...Бұл 240 шықты деген сөз.
Dialogue: 0,0:06:39.29,0:06:42.96,Default,,0,0,0,,Және бұл төмен, өткір траектория... (Харука) Иә?
Dialogue: 0,0:06:42.96,0:06:44.97,Default,,0,0,0,,<Мен бұрын ешқашан көрген емеспін>
Dialogue: 0,0:06:44.97,0:06:47.64,Default,,0,0,0,,<Бұл оның гольф клубынан емес екенін білдіреді>
Dialogue: 0,0:06:47.64,0:06:50.64,Default,,0,0,0,,<Ол оқ атты кім...>
Dialogue: 0,0:06:51.57,0:06:53.58,Default,,0,0,0,,Ах! ?
Dialogue: 0,0:06:53.58,0:07:01.58,Default,,0,0,0,,♬～
Dialogue: 0,0:07:01.58,0:07:03.92,Default,,0,0,0,,<P... Пацукин! ? ＞
Dialogue: 0,0:07:03.92,0:07:06.25,Default,,0,0,0,,Ａｒｅ ｙｏｕ ｆｒｏｍ ｈｅｒｅ？
Dialogue: 0,0:07:06.25,0:07:08.26,Default,,0,0,0,,Не? Ах... мм...
Dialogue: 0,0:07:08.26,0:07:10.59,Default,,0,0,0,,Ｉ ａｓｋｅｄ ｉｆ ｙｏｕ’ｒｅ ｆｒｏｍ ｈｅｒｅ
Dialogue: 0,0:07:10.59,0:07:13.26,Default,,0,0,0,,Ｄｏ ｙｏｕ ｕｎｄｅｒｓｔａｎｄ ｗｈａｔ Ｉ’ｍ ｓａｙｉｎｇ？
Dialogue: 0,0:07:13.26,0:07:16.97,Default,,0,0,0,,Мм, мен әлі ағылшын тілін оқып жатырмын...
Dialogue: 0,0:07:18.60,0:07:20.94,Default,,0,0,0,,Сіз осы жерденсіз бе?
Dialogue: 0,0:07:20.94,0:07:23.61,Default,,0,0,0,,Жапон тілінде сөйлей аласыз ба?
Dialogue: 0,0:07:23.61,0:07:25.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:25.61,0:07:29.61,Default,,0,0,0,,Сіз сөйлеп тұрсыз. Неліктен? сурет?
Dialogue: 0,0:07:29.61,0:07:31.61,Default,,0,0,0,,Сізге қауіп төніп тұр!
Dialogue: 0,0:07:31.61,0:07:35.62,Default,,0,0,0,,Сіз біздің бункерде екенімізді білдіңіз! ? Иә
Dialogue: 0,0:07:35.62,0:07:38.95,Default,,0,0,0,,Ол жаққа бару өте қиын, сондықтан мен сізге түсіндіргім келді.
Dialogue: 0,0:07:38.95,0:07:41.62,Default,,0,0,0,,Ех! ? (Харука) Тым ессіз
Dialogue: 0,0:07:41.62,0:07:44.63,Default,,0,0,0,,Керісінше... тағы бір рет басыңыз!
Dialogue: 0,0:07:44.63,0:07:47.63,Default,,0,0,0,,Не? Ичина, сен не айтып тұрсың?
Dialogue: 0,0:07:47.63,0:07:50.23,Default,,0,0,0,,Тее түсірілімі Мен оны көргім келеді!
Dialogue: 0,0:07:50.23,0:07:52.90,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:07:52.90,0:07:55.90,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:07:59.57,0:08:02.58,Default,,0,0,0,,Бүгін барлық клуб мүшелері курста болуы керек.
Dialogue: 0,0:08:06.58,0:08:10.59,Default,,0,0,0,,Тек соқты, солай ма? Иә, мен үлкен өтініш жасаймын.
Dialogue: 0,0:08:10.59,0:08:14.92,Default,,0,0,0,,<Мен неге бұл баланың айтқанын тыңдап тұрмын? ＞
Dialogue: 0,0:08:14.92,0:08:18.59,Default,,0,0,0,,<Ах, түсіндім, атмосфера ұқсас>
Dialogue: 0,0:08:18.59,0:08:20.93,Default,,0,0,0,,<Лилияға>
Dialogue: 0,0:08:20.93,0:08:25.93,Default,,0,0,0,,<Осынша көргің келсе, көрсетемін! ＞
Dialogue: 0,0:08:25.93,0:08:32.27,Default,,0,0,0,,♬～
Dialogue: 0,0:08:32.27,0:08:36.28,Default,,0,0,0,,<Тамаша> (Харука) <Не...? Бұл түсірілім>
Dialogue: 0,0:08:36.28,0:08:41.95,Default,,0,0,0,,♬～
Dialogue: 0,0:08:41.95,0:08:43.95,Default,,0,0,0,,Бұл траектория...
Dialogue: 0,0:08:43.95,0:08:47.62,Default,,0,0,0,,Бұл жақсы ма? Керемет, ғажап, таңқаларлық!
Dialogue: 0,0:08:47.62,0:08:50.23,Default,,0,0,0,,Қашықтықты туристпен салыстыруға болады.
Dialogue: 0,0:08:50.23,0:08:53.56,Default,,0,0,0,,Физикалық керемет, уау, көлденең іш бұлшықеттері керемет
Dialogue: 0,0:08:53.56,0:08:56.90,Default,,0,0,0,,Иық асты және бөксе бұлшықеттері де өте жұмсақ.
Dialogue: 0,0:08:56.90,0:08:58.90,Default,,0,0,0,,Толық...
Dialogue: 0,0:08:58.90,0:09:01.24,Default,,0,0,0,,Тек гольф ойнауға арналған➡
Dialogue: 0,0:09:01.24,0:09:03.24,Default,,0,0,0,,Бұл идеалды дене.
Dialogue: 0,0:09:03.24,0:09:05.57,Default,,0,0,0,,Бұл қайтымсыз... а
Dialogue: 0,0:09:05.57,0:09:09.58,Default,,0,0,0,,... Кет! Мен оған қол тигізгім келеді! Мен оған қол тигізгім келеді!
Dialogue: 0,0:09:09.58,0:09:11.91,Default,,0,0,0,,Сіз жезөкшесіз бе? Ах~ Ах~ Ах~...
Dialogue: 0,0:09:11.91,0:09:14.92,Default,,0,0,0,,Айтпақшы, сен кімсің?
Dialogue: 0,0:09:14.92,0:09:17.25,Default,,0,0,0,,Бөтен адам болсаңыз, мектепке рұқсатсыз кіру...
Dialogue: 0,0:09:17.25,0:09:19.25,Default,,0,0,0,,Мен Аои Амавашиді көруге келдім.
Dialogue: 0,0:09:19.25,0:09:22.59,Default,,0,0,0,,Не? Тэнваши-санға?
Dialogue: 0,0:09:22.59,0:09:24.59,Default,,0,0,0,,Мен оны интернеттен қарадым.
Dialogue: 0,0:09:24.59,0:09:26.93,Default,,0,0,0,,Аои Амаваши осында ма?
Dialogue: 0,0:09:26.93,0:09:30.93,Default,,0,0,0,,Ал... Мен Амавашидің осы мектептің оқушысы екеніне сенімдімін.
Dialogue: 0,0:09:30.93,0:09:33.94,Default,,0,0,0,,Амаваши-санның қандай ісі бар?
Dialogue: 0,0:09:33.94,0:09:38.61,Default,,0,0,0,,Уәдемді орындауға, ойынды жалғастыруға келдім.
Dialogue: 0,0:09:38.61,0:09:40.61,Default,,0,0,0,,«Ойынның жалғасы»?
Dialogue: 0,0:09:40.61,0:09:43.61,Default,,0,0,0,,Аои қайда орналасқан? ⚟(Kinue) Балалар
Dialogue: 0,0:09:43.61,0:09:45.61,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:09:45.61,0:09:47.95,Default,,0,0,0,,Джи... Цзингуджи храмының директоры
Dialogue: 0,0:09:47.95,0:09:49.95,Default,,0,0,0,,Жоқ... жоқ, бұл...
Dialogue: 0,0:09:49.95,0:09:51.95,Default,,0,0,0,,Бұл адам кенеттен допқа соқты➡
Dialogue: 0,0:09:51.95,0:09:53.96,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:53.96,0:09:58.96,Default,,0,0,0,,Ио... Мен шынымен түсінбеймін, бірақ ол Тэнваши-санды көруге келген сияқты.
Dialogue: 0,0:09:58.96,0:10:01.26,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:10:02.30,0:10:05.63,Default,,0,0,0,,«Эвангелин Ф. Кимишима»
Dialogue: 0,0:10:05.63,0:10:07.64,Default,,0,0,0,,Хауа жақсы.
Dialogue: 0,0:10:09.30,0:10:12.64,Default,,0,0,0,,Қандай себеп болса да, менің Райоу қыздар академиясы➡
Dialogue: 0,0:10:12.64,0:10:15.98,Default,,0,0,0,,Мектеп қызметкерлерінен басқа ешкімге кіруге тыйым салынады.
Dialogue: 0,0:10:15.98,0:10:17.98,Default,,0,0,0,,Қазір кетіңіз.
Dialogue: 0,0:10:17.98,0:10:20.32,Default,,0,0,0,,Аойды кездестірсем, шығамын.
Dialogue: 0,0:10:20.32,0:10:23.32,Default,,0,0,0,,Жапон тілін түсінбейсіз бе?
Dialogue: 0,0:10:23.32,0:10:26.99,Default,,0,0,0,,Егер мені күштеп шығарғың келсе, жақсы.
Dialogue: 0,0:10:26.99,0:10:29.32,Default,,0,0,0,,Мен мұндай нәрсені жек көрмеймін.
Dialogue: 0,0:10:29.32,0:10:34.00,Default,,0,0,0,,Директор Цзингуджиге не айтып тұрсыз? Зорлық-зомбылық жаман
Dialogue: 0,0:10:34.00,0:10:36.00,Default,,0,0,0,,Я...
Dialogue: 0,0:10:36.00,0:10:38.33,Default,,0,0,0,,Тенваши-санмен шынымен кездескіңіз келе ме?
Dialogue: 0,0:10:38.33,0:10:41.00,Default,,0,0,0,,Себебі мен уәде бердім (Kinue)➡
Dialogue: 0,0:10:41.00,0:10:44.01,Default,,0,0,0,,Бір тесік үшін Мисононы сәйкестендіріңіз. (Харука) Иә?
Dialogue: 0,0:10:44.01,0:10:47.01,Default,,0,0,0,,Мен жеңсем, Тенвашимен кездесуге рұқсат етемін.
Dialogue: 0,0:10:47.01,0:10:50.28,Default,,0,0,0,,Мен мұндай нәрсені жақсы көремін.
Dialogue: 0,0:10:50.28,0:10:53.95,Default,,0,0,0,,Джи... Директор Цзингуджи, неге мен?
Dialogue: 0,0:10:53.95,0:10:56.62,Default,,0,0,0,,Мизоно: Егер біз бұл матчты жеңсек➡
Dialogue: 0,0:10:56.62,0:11:00.62,Default,,0,0,0,,Менеджердің рұқсатымен мен сізді тұрақты мүшелікке көтеремін.
Dialogue: 0,0:11:00.62,0:11:03.96,Default,,0,0,0,,Егер сіз доп алғанды немесе ағаның сөмкесін алып жүргенді ұнатпасаңыз ➡
Dialogue: 0,0:11:03.96,0:11:05.96,Default,,0,0,0,,Өз қабілетіңізді көрсетіңіз
Dialogue: 0,0:11:05.96,0:11:09.63,Default,,0,0,0,,Егер сіз шынымен жеңіске жетсеңіз, сіз тұрақты бола аласыз, солай ма?
Dialogue: 0,0:11:09.63,0:11:12.63,Default,,0,0,0,,Сіз мені өтірік айтты деп ойладыңыз ба?
Dialogue: 0,0:11:12.63,0:11:16.00,Default,,0,0,0,,А... Мен істеймін! Мен саған жеңісті көрсетемін
Dialogue: 0,0:11:16.00,0:11:19.31,Default,,0,0,0,,Сенімді менеджер
Dialogue: 0,0:11:19.31,0:11:23.31,Default,,0,0,0,,Харука бұл жаттығу залына үйреніп қалған, бірақ бұл Хауаның бірінші рет келуі.
Dialogue: 0,0:11:23.31,0:11:26.98,Default,,0,0,0,,Ендеше мен Хауаның кәдісі болып қызмет ете аламын ба?
Dialogue: 0,0:11:26.98,0:11:30.32,Default,,0,0,0,,Сіз қалай ойлайсыз? (Харука) Бұл маңызды емес.
Dialogue: 0,0:11:30.32,0:11:31.99,Default,,0,0,0,,орнына➡
Dialogue: 0,0:11:31.99,0:11:35.99,Default,,0,0,0,,Егер мен жеңсем, Ичина бұдан былай менің эксклюзивті кастим болады.
Dialogue: 0,0:11:35.99,0:11:37.99,Default,,0,0,0,,Не? (Харука) Жарайсың ба?
Dialogue: 0,0:11:37.99,0:11:41.66,Default,,0,0,0,,Мен... түсіндім. Жақсы.
Dialogue: 0,0:11:41.66,0:11:44.33,Default,,0,0,0,,Ева-сан, егер бұлай болса, міндетті түрде жеңейік.
Dialogue: 0,0:11:44.33,0:11:46.33,Default,,0,0,0,,Жеңіске бірге ұмтылайық
Dialogue: 0,0:11:46.33,0:11:48.67,Default,,0,0,0,,Маған касса керек емес.
Dialogue: 0,0:11:48.67,0:11:52.61,Default,,0,0,0,,Ал... Мен уәде беріп қойғанмын.
Dialogue: 0,0:11:52.61,0:11:55.28,Default,,0,0,0,,Маған маңызды емес
Dialogue: 0,0:11:55.28,0:11:58.28,Default,,0,0,0,,Не? Сол сияқты...
Dialogue: 0,0:12:02.95,0:12:04.95,Default,,0,0,0,,Найшо
Dialogue: 0,0:12:05.95,0:12:08.56,Default,,0,0,0,,Найшо
Dialogue: 0,0:12:11.29,0:12:14.96,Default,,0,0,0,,Кішкентай қателік осы жерде, Аой.
Dialogue: 0,0:12:14.96,0:12:17.30,Default,,0,0,0,,Дұрыс Иә
Dialogue: 0,0:12:17.30,0:12:20.64,Default,,0,0,0,,Кешіріңіз, Амане, мен мұны дұрыс орындаймын.
Dialogue: 0,0:12:20.64,0:12:22.97,Default,,0,0,0,,<Мотивация төмендейді>
Dialogue: 0,0:12:22.97,0:12:25.97,Default,,0,0,0,,<Сол баланың бар болуы мүмкін...>
Dialogue: 0,0:12:42.96,0:12:44.96,Default,,0,0,0,,1 тесігі бар матчты бастайық
Dialogue: 0,0:12:44.96,0:12:48.26,Default,,0,0,0,,Абырой - бұл Мизоно (Харука) Иә
Dialogue: 0,0:12:49.63,0:12:52.30,Default,,0,0,0,,<Білмеймін, бұл флайер ме, әлде бір нәрсе ме➡
Dialogue: 0,0:12:52.30,0:12:55.90,Default,,0,0,0,,Гольф – жалпы күшке сүйенетін ойын>
Dialogue: 0,0:12:55.90,0:12:59.21,Default,,0,0,0,,<Не керек, бұл менің туған жерім>
Dialogue: 0,0:13:01.58,0:13:05.25,Default,,0,0,0,,<Жеңілудің ең кішкентай элементі жоқ! ＞
Dialogue: 0,0:13:05.25,0:13:11.92,Default,,0,0,0,,♬～
Dialogue: 0,0:13:11.92,0:13:14.92,Default,,0,0,0,,<Дон Пиша> <Ұшу қашықтығы 200-ден аз>
Dialogue: 0,0:13:14.92,0:13:17.59,Default,,0,0,0,,<Доптың орны ең жақсыға жақын>
Dialogue: 0,0:13:17.59,0:13:19.59,Default,,0,0,0,,<Екінші - 3-сан>
Dialogue: 0,0:13:19.59,0:13:22.93,Default,,0,0,0,,<Ойын жасылға қаншалықты жақындай алатындығыңызды көрсетеді>
Dialogue: 0,0:13:22.93,0:13:25.60,Default,,0,0,0,,<Ева бұрынғы түсірілімге қараса да➡
Dialogue: 0,0:13:25.60,0:13:27.60,Default,,0,0,0,,240 шығарылды＞
Dialogue: 0,0:13:27.60,0:13:31.61,Default,,0,0,0,,<Олай болса, оңтайлы жағдай...>
Dialogue: 0,0:13:31.61,0:13:34.61,Default,,0,0,0,,Оның мекенжайы бар! ?
Dialogue: 0,0:13:34.61,0:13:39.61,Default,,0,0,0,,<Тікелей көк оқ тиді! ＞
Dialogue: 0,0:13:39.61,0:13:46.95,Default,,0,0,0,,♬～
Dialogue: 0,0:13:46.95,0:13:51.29,Default,,0,0,0,,Сіз қалай ойлайсыз? Сізде шағымданатын нәрсе бар ма? Жоқ, бұл тамаша.
Dialogue: 0,0:13:51.29,0:13:57.57,Default,,0,0,0,,Оның мінсіздігі сонша, мен өз болмысымның мәніне алаңдаймын.
Dialogue: 0,0:13:57.57,0:13:59.57,Default,,0,0,0,,Бір нәрсе үшін кешіріңіз.
Dialogue: 0,0:13:59.57,0:14:02.90,Default,,0,0,0,,<Бару...Гольф қашықтыққа қатысты емес>
Dialogue: 0,0:14:02.90,0:14:04.91,Default,,0,0,0,,<Дәлдік>
Dialogue: 0,0:14:04.91,0:14:08.24,Default,,0,0,0,,<Шынымен солай ма? ＞
Dialogue: 0,0:14:08.24,0:14:11.58,Default,,0,0,0,,<Ти-ату қашықтығы неғұрлым ұзақ болса➡
Dialogue: 0,0:14:11.58,0:14:14.28,Default,,0,0,0,,Екінші атудың сенімділігі артады>
Dialogue: 0,0:14:15.25,0:14:18.25,Default,,0,0,0,,<Иә, гольф үшін қашықтық өте маңызды>
Dialogue: 0,0:14:22.92,0:14:24.93,Default,,0,0,0,,Цк
Dialogue: 0,0:14:24.93,0:14:27.53,Default,,0,0,0,,<Бұл екінші кадр көруге болатын нәрсе>
Dialogue: 0,0:14:29.26,0:14:31.27,Default,,0,0,0,,Эй
Dialogue: 0,0:14:31.27,0:14:35.60,Default,,0,0,0,,6 санымен басыңыз, бұл сенімді хит болады.
Dialogue: 0,0:14:35.60,0:14:41.28,Default,,0,0,0,,Егер сіз менің ойыншым болғыңыз келсе, менің гольф ойнайтынымды білуіңіз керек.
Dialogue: 0,0:14:41.28,0:14:45.61,Default,,0,0,0,,Еваның гольфі... Иә.
Dialogue: 0,0:14:45.61,0:14:48.62,Default,,0,0,0,,Менің гольфім – кемпірқосақ түсті оқ
Dialogue: 0,0:14:48.62,0:14:55.02,Default,,0,0,0,,Мынау мен атқан қызыл оқ!
Dialogue: 0,0:14:58.56,0:15:02.23,Default,,0,0,0,,<Бұл кадр...> (Харука) <Бұл не? Бұл бұрыш>
Dialogue: 0,0:15:02.23,0:15:05.23,Default,,0,0,0,,<Допты аспанға жоғары ұшыру...>
Dialogue: 0,0:15:05.23,0:15:09.90,Default,,0,0,0,,<Тікелей жоғарыдан түйреуішке бағыттаңыз>
Dialogue: 0,0:15:09.90,0:15:14.21,Default,,0,0,0,,<Бұл аспанның қызыл оғы! ＞
Dialogue: 0,0:15:17.58,0:15:20.58,Default,,0,0,0,,Әй, бұл қыран дерлік! Бұл керемет!
Dialogue: 0,0:15:20.58,0:15:22.58,Default,,0,0,0,,Керемет емес
Dialogue: 0,0:15:22.58,0:15:26.92,Default,,0,0,0,,Осындай кезде «Кешіріңіз» деп айтыңыз.
Dialogue: 0,0:15:26.92,0:15:30.93,Default,,0,0,0,,Әлі жоқ. Менде әлі де путч қалды.
Dialogue: 0,0:15:33.93,0:15:36.93,Default,,0,0,0,,Жақсы жұмыс, мен шаршаған жоқпын.
Dialogue: 0,0:15:36.93,0:15:39.23,Default,,0,0,0,,Дайындықты тексеру
Dialogue: 0,0:15:41.94,0:15:43.94,Default,,0,0,0,,<Қамтылу керек>
Dialogue: 0,0:15:43.94,0:15:46.61,Default,,0,0,0,,<Мен мұнда көп рет жаттығамын>
Dialogue: 0,0:15:46.61,0:15:49.28,Default,,0,0,0,,<Жоғары кесіңіз және іліңіз>
Dialogue: 0,0:15:49.28,0:15:52.95,Default,,0,0,0,,<Жарайды, мен мұны дұрыс істей аламын>
Dialogue: 0,0:15:52.95,0:15:54.88,Default,,0,0,0,,<Патетикалық>
Dialogue: 0,0:15:54.88,0:15:57.89,Default,,0,0,0,,＜Жай ғана екі кадр көрсетіліп жатыр➡
Dialogue: 0,0:15:57.89,0:15:59.89,Default,,0,0,0,,Жүрегіңізді алаңдату＞
Dialogue: 0,0:16:01.22,0:16:05.89,Default,,0,0,0,,<Екі кесе... жоқ, бір кесе қалды>
Dialogue: 0,0:16:05.89,0:16:09.56,Default,,0,0,0,,<Мм, тағы біраз...>
Dialogue: 0,0:16:09.56,0:16:12.97,Default,,0,0,0,,<Аа... сызық бұлыңғыр, мен оны көрмеймін>
Dialogue: 0,0:16:17.24,0:16:19.91,Default,,0,0,0,,Бір жарым қалды (Харука) Иә?
Dialogue: 0,0:16:19.91,0:16:23.21,Default,,0,0,0,,Егер бұл Харука болса, оны 60% күшпен соғуға болады.
Dialogue: 0,0:16:24.58,0:16:27.25,Default,,0,0,0,,Ичина... Өтірік емес.
Dialogue: 0,0:16:27.25,0:16:29.92,Default,,0,0,0,,Қалғаны гольф ойыншысының шеберлігіне байланысты.
Dialogue: 0,0:16:29.92,0:16:36.92,Default,,0,0,0,,♬～
Dialogue: 0,0:16:36.92,0:16:39.59,Default,,0,0,0,,Сен мейірімдісің, бұл дұрыс емес.
Dialogue: 0,0:16:39.59,0:16:43.26,Default,,0,0,0,,Мен Хауаның оны аз да болса көргенін қаладым.
Dialogue: 0,0:16:43.26,0:16:45.57,Default,,0,0,0,,Менің күш-қуатым...
Dialogue: 0,0:16:46.93,0:16:48.94,Default,,0,0,0,,Сызықты оқу қуаты
Dialogue: 0,0:16:49.94,0:16:52.27,Default,,0,0,0,,<Бір жарым кесе қалды>
Dialogue: 0,0:16:52.27,0:16:54.28,Default,,0,0,0,,<60% қуатпен>
Dialogue: 0,0:16:54.28,0:17:05.22,Default,,0,0,0,,♬～
Dialogue: 0,0:17:05.22,0:17:07.22,Default,,0,0,0,,А, ол өшірілді.
Dialogue: 0,0:17:07.22,0:17:09.89,Default,,0,0,0,,Мен аяқтай алмағаныма Харука кінәлі!
Dialogue: 0,0:17:09.89,0:17:11.89,Default,,0,0,0,,Сіз оны дұрыс оқыдыңыз.
Dialogue: 0,0:17:11.89,0:17:13.90,Default,,0,0,0,,Жақсы, екеуі де жақсы.
Dialogue: 0,0:17:17.57,0:17:20.90,Default,,0,0,0,,Мен жеңдім. Мен Аоймен кездесе аламын ба?
Dialogue: 0,0:17:20.90,0:17:23.57,Default,,0,0,0,,Әрине, мен уәдемді орындаймын.
Dialogue: 0,0:17:23.57,0:17:26.27,Default,,0,0,0,,Ол жақында оралады.
Dialogue: 0,0:17:29.58,0:17:31.58,Default,,0,0,0,,Хауа!
Dialogue: 0,0:17:32.91,0:17:34.92,Default,,0,0,0,,Хауа!
Dialogue: 0,0:17:36.58,0:17:39.29,Default,,0,0,0,,Хауа!
Dialogue: 0,0:17:40.25,0:17:43.26,Default,,0,0,0,,Хауа! Аой
Dialogue: 0,0:17:43.26,0:17:50.26,Default,,0,0,0,,♬～
Dialogue: 0,0:17:50.26,0:17:52.27,Default,,0,0,0,,Болады!
Dialogue: 0,0:17:52.27,0:17:56.54,Default,,0,0,0,,Неліктен одан аулақ болу керек? Жоқ, әйтеуір...
Dialogue: 0,0:17:56.54,0:17:59.54,Default,,0,0,0,,Жапонияға қашан келдіңіз? бүгін
Dialogue: 0,0:17:59.54,0:18:04.55,Default,,0,0,0,,Мен ойынға мүлде кірген жоқпын, мен уәдем қайтадан бұзылды деп ойладым.
Dialogue: 0,0:18:04.55,0:18:09.22,Default,,0,0,0,,Ал... Бұл үшін кешірім сұраймын. Көп нәрсе болды...
Dialogue: 0,0:18:09.22,0:18:12.22,Default,,0,0,0,,Менің қолымнан келмейді, мен сені кешіремін.
Dialogue: 0,0:18:12.22,0:18:14.22,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:14.22,0:18:17.89,Default,,0,0,0,,Эй, сен қайда тұрасың? Әлі шешкен жоқ
Dialogue: 0,0:18:17.89,0:18:21.90,Default,,0,0,0,,Онда мен сені өз бөлмемде қалдырамын. Жоқ, жақсы.
Dialogue: 0,0:18:21.90,0:18:25.23,Default,,0,0,0,,Сен мені жек көресің бе? ұнатпайды да, ұнатпайды да
Dialogue: 0,0:18:25.23,0:18:27.23,Default,,0,0,0,,О, бұл қорқынышты! Тенваши дегеніміз не?
Dialogue: 0,0:18:27.23,0:18:29.24,Default,,0,0,0,,Бұл кейіпкер болды ма?
Dialogue: 0,0:18:29.24,0:18:31.91,Default,,0,0,0,,(сөйлеу)
Dialogue: 0,0:18:31.91,0:18:34.91,Default,,0,0,0,,Мен Жапонияға келемін деп ойламадым...
Dialogue: 0,0:18:34.91,0:18:38.91,Default,,0,0,0,,Бұл оның (Kinue) директоры
Dialogue: 0,0:18:38.91,0:18:42.92,Default,,0,0,0,,Нафлесте өткен 15 жасқа дейінгі әйелдер арасындағы әлем чемпионатында➡
Dialogue: 0,0:18:42.92,0:18:45.59,Default,,0,0,0,,Соңғы күні ғана қатысты...
Dialogue: 0,0:18:45.59,0:18:49.26,Default,,0,0,0,,Оның есімі... Ив Ареон, меніңше?
Dialogue: 0,0:18:49.26,0:18:51.59,Default,,0,0,0,,Қандай да бір себептермен қазір➡
Dialogue: 0,0:18:51.59,0:18:55.53,Default,,0,0,0,,Оның есімі "Эвангелин Ф. Кимишима" сияқты.
Dialogue: 0,0:18:55.53,0:18:59.20,Default,,0,0,0,,Сіз оның қаншалықты жақсы екенін білгіңіз келді, сондықтан оны жарысқа шығардыңыз, солай ма?
Dialogue: 0,0:18:59.20,0:19:01.20,Default,,0,0,0,,Иә (Amuro) және ➡
Dialogue: 0,0:19:01.20,0:19:06.87,Default,,0,0,0,,Мен бірінші курста оқитын Харука Мизононың мұрнының көпірін сындырдым...әлде солай ма?
Dialogue: 0,0:19:06.87,0:19:09.21,Default,,0,0,0,,Өсуге әлі ерте
Dialogue: 0,0:19:09.21,0:19:11.91,Default,,0,0,0,,Аурухана қалай болды?
Dialogue: 0,0:19:13.21,0:19:17.22,Default,,0,0,0,,Маған толық жазылу үшін екі ай керек деді.
Dialogue: 0,0:19:17.22,0:19:19.22,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:19:20.22,0:19:23.89,Default,,0,0,0,,Эй, эй Хауа, менің бөлмеме кел.
Dialogue: 0,0:19:23.89,0:19:25.89,Default,,0,0,0,,Әй... Әй, не болды?
Dialogue: 0,0:19:25.89,0:19:28.90,Default,,0,0,0,,Бүгінгі жаттығу аяқталды, сондықтан ертең жасайық.
Dialogue: 0,0:19:28.90,0:19:31.90,Default,,0,0,0,,Мен өзімшілдік жасасам, жаңбырдың дауысы мені тағы да ашуландырады.
Dialogue: 0,0:19:31.90,0:19:34.90,Default,,0,0,0,,Әй... Әй... Жарайды, жарайды.
Dialogue: 0,0:19:34.90,0:19:36.90,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:19:36.90,0:19:39.91,Default,,0,0,0,,Бұл кім? Әлгі аққұба қыз
Dialogue: 0,0:19:39.91,0:19:42.91,Default,,0,0,0,,Ол Тенвашидің танысы сияқты...
Dialogue: 0,0:19:42.91,0:19:44.91,Default,,0,0,0,,Синджо мырза (Жаңбыр дыбысы) Иә?
Dialogue: 0,0:19:44.91,0:19:48.92,Default,,0,0,0,,Мм... Хауа деген кім?
Dialogue: 0,0:19:48.92,0:19:52.59,Default,,0,0,0,,Мен түсінбейтін нәрселер бар.
Dialogue: 0,0:19:52.59,0:19:54.59,Default,,0,0,0,,...мәселесі?
Dialogue: 0,0:19:54.59,0:19:58.59,Default,,0,0,0,,<Мен Хауамен осылай таныстым>
Dialogue: 0,0:19:58.59,0:20:01.93,Default,,0,0,0,,<Мен шын мағынада кәсіби маман боламын➡
Dialogue: 0,0:20:01.93,0:20:03.93,Default,,0,0,0,,Бұл басталатын күн болды＞
Dialogue: 0,0:20:03.93,0:20:11.61,Default,,0,0,0,,♬～
Dialogue: 0,0:20:11.61,0:20:14.28,Default,,0,0,0,,<Мен не істеп жатырмын?>
Dialogue: 0,0:20:14.28,0:20:17.28,Default,,0,0,0,,⚟ Эй, Хауа, а?
Dialogue: 0,0:20:17.28,0:20:19.95,Default,,0,0,0,,⚟ Хауа Жапонияда қанша уақыт қалады?
Dialogue: 0,0:20:19.95,0:20:23.62,Default,,0,0,0,,⚟ Мен тегін жеке саяхат туралы шешім қабылдаған жоқпын ба?
Dialogue: 0,0:20:23.62,0:20:27.62,Default,,0,0,0,,⚟ Жоқ, мен қандай да бір себептермен Наклеске қайта алмаймын.
Dialogue: 0,0:20:28.96,0:20:32.29,Default,,0,0,0,,⚟ Сіз нені айтасыз? Себебін айта алмаймын
Dialogue: 0,0:20:32.29,0:20:35.60,Default,,0,0,0,,⚟ Сіздің отбасыңыз ше? Онда емес
Dialogue: 0,0:20:36.63,0:20:39.63,Default,,0,0,0,,⚟ Мен түсінемін. Бұл дұрыс.
Dialogue: 0,0:20:40.63,0:20:45.31,Default,,0,0,0,,<Әпке, Лили мен басқалары жақсы ма? ＞
Dialogue: 0,0:20:45.31,0:21:02.59,Default,,0,0,0,,♬～
Dialogue: 0,0:21:03.59,0:21:05.59,Default,,0,0,0,,Сәлем Хауа
Dialogue: 0,0:21:05.59,0:21:10.26,Default,,0,0,0,,Баратын жерің болмаса, менде бір ой бар.
Dialogue: 0,0:21:10.26,0:21:12.27,Default,,0,0,0,,Бұл одан да көп ойын! Апыр-ай!
Dialogue: 0,0:21:12.27,0:21:14.94,Default,,0,0,0,,Эй... бірдеңе киіп ал!
Dialogue: 0,0:21:14.94,0:21:16.94,Default,,0,0,0,,Қазір жасайық!
Dialogue: 0,0:21:16.94,0:21:20.61,Default,,0,0,0,,Сонымен... сіз Жапонияға не үшін келді деп ойлайсыз?
Dialogue: 0,0:21:20.61,0:21:23.28,Default,,0,0,0,,Сондықтан бірдеңе киіңіз!
Dialogue: 0,0:21:23.28,0:21:25.61,Default,,0,0,0,,⚟ Мен көп нәрсені көремін! (Жаңбырдың дыбысы) Әй...
Dialogue: 0,0:21:25.61,0:21:29.95,Default,,0,0,0,,Жағдай барған сайын қиындап барады ⚟ (Хауа мен Аойдың алды-артына)
Dialogue: 0,0:21:29.95,0:21:49.97,Default,,0,0,0,,♬～
Dialogue: 0,0:21:49.97,0:22:09.92,Default,,0,0,0,,♬～
Dialogue: 0,0:22:09.92,0:22:29.94,Default,,0,0,0,,♬～
Dialogue: 0,0:22:29.94,0:22:49.96,Default,,0,0,0,,♬～
Dialogue: 0,0:22:49.96,0:22:59.27,Default,,0,0,0,,♬～
Dialogue: 0,0:23:04.25,0:23:07.58,Default,,0,0,0,,Мен келе жатырмын (Шарлотта Джессика)
Dialogue: 0,0:23:07.58,0:23:10.92,Default,,0,0,0,,Әй, жақсы оқы, ақымақтар.
Dialogue: 0,0:23:10.92,0:23:12.92,Default,,0,0,0,,Иә
Dialogue: 0,0:23:12.92,0:23:15.92,Default,,0,0,0,,Бүгін не істейміз? (балалар сөйлейді)
Dialogue: 0,0:23:15.92,0:23:19.59,Default,,0,0,0,,...Таңертеңнен бері қатты шу болды.
Dialogue: 0,0:23:19.59,0:23:21.60,Default,,0,0,0,,Мен мектепке барғанды ​​ұнатамын.
Dialogue: 0,0:23:21.60,0:23:25.60,Default,,0,0,0,,Уф... Менен сұрасаң да барғым келмейді.
Dialogue: 0,0:23:26.93,0:23:28.94,Default,,0,0,0,,Сәлем, әпке
Dialogue: 0,0:23:28.94,0:23:31.61,Default,,0,0,0,,Хауа Жапонияға дұрыс келді ме?
Dialogue: 0,0:23:31.61,0:23:34.61,Default,,0,0,0,,Жарайды, мен енді бала емеспін.
Dialogue: 0,0:23:35.61,0:23:39.01,Default,,0,0,0,,Хауа, сен бұл күндері не істеп жүрсің?
Dialogue: 0,0:23:40.95,0:23:45.29,Default,,0,0,0,,Бұл кенеттен болды, бірақ мен сізді жаңа ауысқан студентпен таныстырғым келеді.
Dialogue: 0,0:23:45.29,0:23:48.29,Default,,0,0,0,,Өзімді таныстыра аласыз ба?
Dialogue: 0,0:23:48.29,0:23:50.62,Default,,0,0,0,,А, м...
Dialogue: 0,0:23:50.62,0:23:54.30,Default,,0,0,0,,«Эвангелин Ф. Кимишима»
Dialogue: 0,0:23:54.30,0:23:56.23,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:23:56.23,0:23:59.57,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:23:59.57,0:24:05.27,Default,,0,0,0,,<Не істеп жатырсың? Мен…＞
Dialogue: 0,0:24:05.27,0:24:08.58,Default,,0,0,0,,<Кешіріңіз, Хауа, мен жарысқым келеді, бірақ менде көп нәрсе болып жатыр...>
Dialogue: 0,0:24:08.58,0:24:11.25,Default,,0,0,0,,<Мырза. Тенваши, басты кейіпкер - Ичина Саотоме...>
Dialogue: 0,0:24:11.25,0:24:13.91,Default,,0,0,0,,<Келесі жолы да Берди Берди> <Халық шешімі Зерифу! ＞
Dialogue: 0,0:24:15.41,0:24:21.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory