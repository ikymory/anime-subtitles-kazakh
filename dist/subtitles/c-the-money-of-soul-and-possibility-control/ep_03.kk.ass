Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.55,0:00:04.55,Default,,0,0,0,,＜Қала қанша уақыттан бері бар→
Dialogue: 0,0:00:04.55,0:00:06.56,Default,,0,0,0,,Бұл анық емес>
Dialogue: 0,0:00:06.56,0:00:09.56,Default,,0,0,0,,<Шығыс Еуропа аймағының фольклорында→
Dialogue: 0,0:00:09.56,0:00:12.56,Default,,0,0,0,,Шайтанмен ойнаған ақшаны әкелген адаммен→
Dialogue: 0,0:00:12.56,0:00:17.57,Default,,0,0,0,,Ауыл бұзылған жағдай бар>
Dialogue: 0,0:00:17.57,0:00:20.57,Default,,0,0,0,,<Егер бұл сол қалаға қатысты болса→
Dialogue: 0,0:00:20.57,0:00:25.57,Default,,0,0,0,,Бұл ұқсас жердің орта ғасырларда болғанын білдіреді>
Dialogue: 0,0:00:25.57,0:00:28.58,Default,,0,0,0,,<Бірақ бұл тек аналогия>
Dialogue: 0,0:00:28.58,0:00:30.58,Default,,0,0,0,,Қаржы ауданы.
Dialogue: 0,0:00:30.58,0:00:32.58,Default,,0,0,0,,Бақытымызға орай, осы жаманның атыс құралдары баяу
Dialogue: 0,0:00:37.59,0:00:40.59,Default,,0,0,0,,Сато мырза, әлі келісім болған жоқ па?
Dialogue: 0,0:00:40.59,0:00:42.59,Default,,0,0,0,,Бүгін бізде көретін нәрсе бар.
Dialogue: 0,0:00:42.59,0:00:45.59,Default,,0,0,0,,Құмар ойындарды тоқтату керек.
Dialogue: 0,0:00:45.59,0:00:47.60,Default,,0,0,0,,Менде жағымсыз оқиға болды.
Dialogue: 0,0:00:47.60,0:00:49.60,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:00:51.60,0:00:54.60,Default,,0,0,0,,Көруге болатын көрініс.
Dialogue: 0,0:00:54.60,0:00:56.54,Default,,0,0,0,,Мәміледен гөрі→
Dialogue: 0,0:00:56.54,0:01:02.54,Default,,0,0,0,,Құмар ойнап күйіп қалатындар аз емес.
Dialogue: 0,0:01:05.55,0:01:08.55,Default,,0,0,0,,<Мен бұл қақпадан 51-ші рет өтуім>
Dialogue: 0,0:01:08.55,0:01:13.56,Default,,0,0,0,,<Мен онда мәмілелер үшін 11 рет бардым>
Dialogue: 0,0:01:13.56,0:01:17.56,Default,,0,0,0,,<Мен әлі де жаңадан келген адаммын>
Dialogue: 0,0:01:20.56,0:01:30.56,Default,,0,0,0,,Сен
Dialogue: 0,0:02:57.52,0:03:01.52,Default,,0,0,0,,<Қаржы ауданының көлемі елдің экономикалық жағдайына пропорционалды>
Dialogue: 0,0:03:01.52,0:03:05.52,Default,,0,0,0,,<Бүкіл әлемде бар қаржылық аудандардың ішінде→
Dialogue: 0,0:03:05.52,0:03:08.52,Default,,0,0,0,,Қиыр Шығыс қаржы округі кең
Dialogue: 0,0:03:16.54,0:03:18.54,Default,,0,0,0,,Джордж.
Dialogue: 0,0:03:23.54,0:03:27.55,Default,,0,0,0,,Мәміле Алға қарай қараңыз.
Dialogue: 0,0:03:27.55,0:03:41.56,Default,,0,0,0,,Сен
Dialogue: 0,0:03:41.56,0:03:45.56,Default,,0,0,0,,<Бұл қала әртүрлі адамдарға толы>
Dialogue: 0,0:03:48.57,0:03:52.57,Default,,0,0,0,,<Басқалардың арасында бұл қаланы іс жүзінде басқаратын адам>
Dialogue: 0,0:03:52.57,0:03:56.57,Default,,0,0,0,,<Ал ол қолға үйретпек болған жас жігіт>
Dialogue: 0,0:03:58.51,0:04:02.51,Default,,0,0,0,,Иә? Мен тым ерте келдім бе?
Dialogue: 0,0:04:02.51,0:04:05.52,Default,,0,0,0,,<Оның екінші мәмілесінің тағдыры→
Dialogue: 0,0:04:05.52,0:04:07.52,Default,,0,0,0,,Бұл қаланың соңы болады＞
Dialogue: 0,0:04:07.52,0:04:10.52,Default,,0,0,0,,<Бұл менің түйсігім болды>
Dialogue: 0,0:04:23.54,0:04:25.60,Default,,0,0,0,,《Шайқастан қашу》
Dialogue: 0,0:04:25.60,0:04:28.54,Default,,0,0,0,,《Сен де ата-анаңнан қашқың келетін сияқты》→
Dialogue: 0,0:04:28.54,0:04:30.54,Default,,0,0,0,,《Өз әлеуетіңізге қараңыз》→
Dialogue: 0,0:04:30.54,0:04:33.54,Default,,0,0,0,,《Мен сол қалада күтемін》
Dialogue: 0,0:04:38.55,0:04:41.55,Default,,0,0,0,,《Мен сен сияқты болғым келмейді》
Dialogue: 0,0:04:41.55,0:04:43.55,Default,,0,0,0,,《Бұл жаман ба?》
Dialogue: 0,0:04:48.56,0:04:50.56,Default,,0,0,0,,<Мен жататын ұйым →
Dialogue: 0,0:04:50.56,0:04:55.58,Default,,0,0,0,,Ол қаржылық ауданның шындығын түсінуге құмар болды>
Dialogue: 0,0:04:55.58,0:04:57.50,Default,,0,0,0,,<Қаржы ауданының мақсаты қандай? ＞
Dialogue: 0,0:04:57.50,0:05:02.51,Default,,0,0,0,,<Мидас ақшасының нақты қоғамға әсері қандай? ＞
Dialogue: 0,0:05:02.51,0:05:06.51,Default,,0,0,0,,<Мен қаржы ауданы туралы жалпы білім алдым>
Dialogue: 0,0:05:06.51,0:05:10.52,Default,,0,0,0,,<Ақпарат негізінен қаржы ауданына және одан тысқарыға түседі→
Dialogue: 0,0:05:10.52,0:05:12.52,Default,,0,0,0,,Бұл инсайдерден>
Dialogue: 0,0:05:12.52,0:05:16.52,Default,,0,0,0,,Мектеп? Иә?
Dialogue: 0,0:05:16.52,0:05:21.52,Default,,0,0,0,,<Бірақ мен ешқашан өзегіне жете алмадым>
Dialogue: 0,0:05:24.53,0:05:26.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:33.54,0:05:36.54,Default,,0,0,0,,《Бұл үлкен... Иә? 》
Dialogue: 0,0:05:36.54,0:05:41.54,Default,,0,0,0,,Иә? Тайяки дегеніміз не?
Dialogue: 0,0:05:44.55,0:05:47.55,Default,,0,0,0,,<Әлем елдеріндегі қаржы орталығы болып табылатын жерлер→
Dialogue: 0,0:05:47.55,0:05:50.56,Default,,0,0,0,,Қаржылық аудан міндетті түрде пайда болады>
Dialogue: 0,0:05:50.56,0:05:55.53,Default,,0,0,0,,<Ұйымның тергеушілері әртүрлі орындарға жіберілді>
Dialogue: 0,0:05:55.53,0:05:58.40,Default,,0,0,0,,<Мен Токиоға ауыстырылады>
Dialogue: 0,0:05:58.40,0:06:01.40,Default,,0,0,0,,＜Қаржы аймағына жиі келетін адам→
Dialogue: 0,0:06:01.40,0:06:03.40,Default,,0,0,0,,Нұсқаулық болды>
Dialogue: 0,0:06:03.40,0:06:08.41,Default,,0,0,0,,<Ұйым әсіресе Соичиро Микуниге назар аударды.>
Dialogue: 0,0:06:08.41,0:06:11.41,Default,,0,0,0,,<Оның негізгі жұмысы қол жетпес>
Dialogue: 0,0:06:11.41,0:06:13.41,Default,,0,0,0,,<Нақтырақ айтсақ, атаулар тым көп→
Dialogue: 0,0:06:13.41,0:06:16.41,Default,,0,0,0,,Нақты жағдайды жасыру>
Dialogue: 0,0:06:19.42,0:06:21.42,Default,,0,0,0,,Аа...
Dialogue: 0,0:06:21.42,0:06:23.42,Default,,0,0,0,,(сирена дыбысы)
Dialogue: 0,0:06:23.42,0:06:26.43,Default,,0,0,0,,＜Олардың ішінде ең сипаттаушы тақырып→ болып табылады
Dialogue: 0,0:06:26.43,0:06:31.43,Default,,0,0,0,,Қаржы министрлігіне қарасты инвестициялық институттың кеңесші қызметкері.
Dialogue: 0,0:06:31.43,0:06:35.43,Default,,0,0,0,,<Алайда, шындық мемлекеттік министрліктер мен қаржы институттары→
Dialogue: 0,0:06:35.43,0:06:41.44,Default,,0,0,0,,Ірі корпорацияларға жасырын түрде әсер ете алатын жас құбыжық>
Dialogue: 0,0:06:41.44,0:06:44.44,Default,,0,0,0,,＜Алайда бұл жер асты әлемінде өмір сүретін адам туралы→
Dialogue: 0,0:06:44.44,0:06:47.45,Default,,0,0,0,,Бұл жай ғана көпшілікке арналған бет＞
Dialogue: 0,0:06:47.45,0:06:49.45,Default,,0,0,0,,<Оның есімі тыйым деп саналады→
Dialogue: 0,0:06:49.45,0:06:53.45,Default,,0,0,0,,БАҚ-та сирек көрсетіледі＞
Dialogue: 0,0:06:53.45,0:06:57.49,Default,,0,0,0,,<Оның бұл дүниенің көпшілігі білмейтін жасырын жүзі...>
Dialogue: 0,0:06:57.49,0:07:02.49,Default,,0,0,0,,＜Қаржылық ауданда өзара көмек тобын құрыңыз және Мидас ақшасын әдейі пайдаланыңыз →
Dialogue: 0,0:07:02.49,0:07:06.50,Default,,0,0,0,,Ол осы дүниеге жобалағалы отырған адамның шынайы бет-бейнесі →
Dialogue: 0,0:07:06.50,0:07:08.50,Default,,0,0,0,,Міне, мен іздеп жүрмін>
Dialogue: 0,0:07:17.51,0:07:19.51,Default,,0,0,0,,Көпке тоқтап қалған сияқтысыз→
Dialogue: 0,0:07:19.51,0:07:21.51,Default,,0,0,0,,Ха! Сол 100 йендік тиынды таста! Ора!
Dialogue: 0,0:07:21.51,0:07:24.52,Default,,0,0,0,,Иә? Жаңа біреу? Ал Азума-кун ше?
Dialogue: 0,0:07:24.52,0:07:28.52,Default,,0,0,0,,ше? Бұл жер әрқашан менің юрисдикциямда.
Dialogue: 0,0:07:28.52,0:07:32.52,Default,,0,0,0,,Менің бөлімімде Азума есімді ешкім жоқ.
Dialogue: 0,0:07:32.52,0:07:34.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:38.53,0:07:42.53,Default,,0,0,0,,<Ол қалаға бару біліктілігі маған не үшін берілді?>
Dialogue: 0,0:07:44.54,0:07:47.54,Default,,0,0,0,,《》→
Dialogue: 0,0:07:47.54,0:07:49.54,Default,,0,0,0,,《Сәлеметсіз бе? 》→
Dialogue: 0,0:07:49.54,0:07:52.54,Default,,0,0,0,,《Не? Трансфер! ? 》
Dialogue: 0,0:07:55.53,0:07:57.48,Default,,0,0,0,,《Бұл не...》
Dialogue: 0,0:07:57.48,0:08:00.49,Default,,0,0,0,,<Жеңді бергенім есімде жоқ.>
Dialogue: 0,0:08:07.49,0:08:09.49,Default,,0,0,0,,《Қайырлы кеш》 《Сәлеметсіз бе! 》
Dialogue: 0,0:08:09.49,0:08:13.50,Default,,0,0,0,,＜Мен ұйымға бірінші рет мүше болып отырмын→
Dialogue: 0,0:08:13.50,0:08:17.50,Default,,0,0,0,,Мен қаржы ауданына қадам басуды шештім>
Dialogue: 0,0:08:17.50,0:08:19.50,Default,,0,0,0,,《Муфф》
Dialogue: 0,0:08:25.51,0:08:27.51,Default,,0,0,0,,Ах.
Dialogue: 0,0:08:27.51,0:08:29.51,Default,,0,0,0,,А... Аа.
Dialogue: 0,0:08:32.52,0:08:35.52,Default,,0,0,0,,Мен мектепті бітіргеннен бері емес. →
Dialogue: 0,0:08:35.52,0:08:39.52,Default,,0,0,0,,Сіз дұрыс өмір сүре аласыз ба? Иә. Мен мұны қалай да істеп жатырмын.
Dialogue: 0,0:08:39.52,0:08:41.53,Default,,0,0,0,,жақсы болар еді. →
Dialogue: 0,0:08:41.53,0:08:45.53,Default,,0,0,0,,Бұл кенеттен болғаны сонша, мен таң қалдым.
Dialogue: 0,0:08:45.53,0:08:48.53,Default,,0,0,0,,Кешіріңіз. Жоқ, мен ғана...
Dialogue: 0,0:08:48.53,0:08:51.54,Default,,0,0,0,,Киоко апайдан сұрайын дегенім көп.
Dialogue: 0,0:08:51.54,0:08:55.47,Default,,0,0,0,,Не? Ал сіздің ағаңыз бен әпкеңіз ше?
Dialogue: 0,0:08:55.47,0:08:59.48,Default,,0,0,0,,Ах... Уф.
Dialogue: 0,0:08:59.48,0:09:02.48,Default,,0,0,0,,Өйткені мен оны дұрыс тыңдамадым.
Dialogue: 0,0:09:02.48,0:09:07.49,Default,,0,0,0,,Екеуі де жақсы адамдар еді. Мен Кимимароны аядым.
Dialogue: 0,0:09:07.49,0:09:10.49,Default,,0,0,0,,Жұбатуды тоқтатыңыз. Өйткені ол рас.
Dialogue: 0,0:09:10.49,0:09:14.49,Default,,0,0,0,,Ағаңыз бен әпкеңіз туралы тек жаман нәрселерді ойламаңыз.
Dialogue: 0,0:09:16.50,0:09:20.50,Default,,0,0,0,,Бірақ... ол жоғалып кетер алдында жақсы болған сияқты.
Dialogue: 0,0:09:20.50,0:09:22.50,Default,,0,0,0,,Акциялар немесе басқа нәрсе?
Dialogue: 0,0:09:22.50,0:09:24.50,Default,,0,0,0,,Сіз ақша таптыңыз ба?
Dialogue: 0,0:09:24.50,0:09:28.51,Default,,0,0,0,,Жақсы есімде жоқ... Жазба жоқ сияқты.
Dialogue: 0,0:09:28.51,0:09:32.51,Default,,0,0,0,,Кешіріңіз. Менің ағамның бар болғаны осы.
Dialogue: 0,0:09:32.51,0:09:34.51,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:09:34.51,0:09:36.52,Default,,0,0,0,,Олай болса, жұмыс біткен соң жинап ал.
Dialogue: 0,0:09:36.52,0:09:38.52,Default,,0,0,0,,Түсіндім, рахмет.
Dialogue: 0,0:09:45.52,0:09:47.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:53.53,0:09:56.53,Default,,0,0,0,,Ах... Бұл не?
Dialogue: 0,0:09:59.47,0:10:02.47,Default,,0,0,0,,Мидас... болмайды!
Dialogue: 0,0:10:02.47,0:10:05.48,Default,,0,0,0,,Не болып жатыр, әке?
Dialogue: 0,0:10:05.48,0:10:07.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:16.49,0:10:18.49,Default,,0,0,0,,Масакаки~?
Dialogue: 0,0:10:21.49,0:10:23.49,Default,,0,0,0,,Сізге қалай қоңырау шалсам болады!
Dialogue: 0,0:10:30.50,0:10:32.50,Default,,0,0,0,,Сізден басқа тыңдай алатын ешкім жоқ →
Dialogue: 0,0:10:32.50,0:10:35.51,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:10:35.51,0:10:37.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:37.51,0:10:39.51,Default,,0,0,0,,Мәміле болмаса да, қалаға келуге болады →
Dialogue: 0,0:10:39.51,0:10:41.51,Default,,0,0,0,,Оны өзіңіз іздеңіз.
Dialogue: 0,0:10:41.51,0:10:44.52,Default,,0,0,0,,Түсіндім... Қазір барамын.
Dialogue: 0,0:10:44.52,0:10:46.52,Default,,0,0,0,,Бұл үлкен серпін.
Dialogue: 0,0:10:46.52,0:10:48.52,Default,,0,0,0,,Шу!
Dialogue: 0,0:10:54.53,0:10:56.53,Default,,0,0,0,,<Аптасына бір рет мәміле>
Dialogue: 0,0:10:56.53,0:11:00.54,Default,,0,0,0,,<Мені сәрсенбіде жиі шақырады>
Dialogue: 0,0:11:00.54,0:11:03.54,Default,,0,0,0,,<Қарсыласыңыздың атын да атай аласыз, бірақ...>
Dialogue: 0,0:11:03.54,0:11:06.54,Default,,0,0,0,,Әйел... Бұл сирек.
Dialogue: 0,0:11:06.54,0:11:08.55,Default,,0,0,0,,Менің хоббиім жоқ!
Dialogue: 0,0:11:08.55,0:11:11.55,Default,,0,0,0,,<Мен мұны ешқашан істеген емеспін>
Dialogue: 0,0:11:11.55,0:11:14.55,Default,,0,0,0,,<Актив инстинктпен кірісті қорғайды>
Dialogue: 0,0:11:14.55,0:11:16.55,Default,,0,0,0,,「ＯＰＥＮ ＤＥＡＬ」！
Dialogue: 0,0:11:16.55,0:11:20.56,Default,,0,0,0,,Желім! «Меццо мұздату»
Dialogue: 0,0:11:20.56,0:11:25.56,Default,,0,0,0,,<Ал егер Entre бұйырмаса, ол шабуыл жасай алмайды>
Dialogue: 0,0:11:25.56,0:11:28.57,Default,,0,0,0,,<Шабуыл техникасы фляцион деп аталады→
Dialogue: 0,0:11:28.57,0:11:31.57,Default,,0,0,0,,Үш деңгейге жіктеледі: макро, мезо және микро>
Dialogue: 0,0:11:31.57,0:11:33.57,Default,,0,0,0,,「ＥＢＯ」
Dialogue: 0,0:11:33.57,0:11:35.57,Default,,0,0,0,,<Қарапайым тілмен айтқанда, бұл үлкен, орташа және кішкентай.>
Dialogue: 0,0:11:35.57,0:11:37.57,Default,,0,0,0,,Тағы да сәлем!
Dialogue: 0,0:11:37.57,0:11:39.81,Default,,0,0,0,,… （）
Dialogue: 0,0:11:39.81,0:11:41.58,Default,,0,0,0,,...
Dialogue: 0,0:11:41.58,0:11:45.58,Default,,0,0,0,,<Микро: 100 000 немесе одан көп Mezzo: 1 000 000 немесе одан көп →
Dialogue: 0,0:11:45.58,0:11:49.59,Default,,0,0,0,,Макроның құны 10 миллион иенден асады>
Dialogue: 0,0:11:49.59,0:11:53.52,Default,,0,0,0,,<Мен ешқашан макрофляцияны қолданбадым>
Dialogue: 0,0:11:53.52,0:11:56.53,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:11:56.53,0:11:59.53,Default,,0,0,0,,Онда! О, менің!
Dialogue: 0,0:11:59.53,0:12:04.53,Default,,0,0,0,,<Егер сіз мәмілеге байланысты банкротқа ұшырасаңыз, сіз қаржылық ауданнан шығарыласыз>
Dialogue: 0,0:12:04.53,0:12:07.54,Default,,0,0,0,,Әйелді жалау. →
Dialogue: 0,0:12:07.54,0:12:09.54,Default,,0,0,0,,...
Dialogue: 0,0:12:11.54,0:12:15.55,Default,,0,0,0,,＜Мен әрқашан аз ұтамын ба, әлде аз ұтамын ба→
Dialogue: 0,0:12:15.55,0:12:17.55,Default,,0,0,0,,Екі жаққа да кетсін деп соғыстық.＞
Dialogue: 0,0:12:17.55,0:12:21.55,Default,,0,0,0,,<Қарсыласыңызды таңдамау себебі оны реттеу оңайырақ.>
Dialogue: 0,0:12:21.55,0:12:23.55,Default,,0,0,0,,「ＣＬＯＳＩＮＧ」
Dialogue: 0,0:12:25.56,0:12:29.56,Default,,0,0,0,,Цк. Мен тағы да фотоны сағындым ба?
Dialogue: 0,0:12:29.56,0:12:31.56,Default,,0,0,0,,<Мен де сол жігіт сияқтымын→
Dialogue: 0,0:12:31.56,0:12:35.57,Default,,0,0,0,,Біздің активтеріміздің күші бізге көп көмектесті＞
Dialogue: 0,0:12:35.57,0:12:39.57,Default,,0,0,0,,Енді... біз мұны түсінбейміз.
Dialogue: 0,0:12:39.57,0:12:41.57,Default,,0,0,0,,Сенің әкең осында келді, солай ма?
Dialogue: 0,0:12:41.57,0:12:44.57,Default,,0,0,0,,Мүмкін мені осында шақыруыңыздың бір қатысы бар шығар!
Dialogue: 0,0:12:44.57,0:12:47.58,Default,,0,0,0,,Бұл толық сәйкестік.
Dialogue: 0,0:12:47.58,0:12:49.58,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:49.58,0:12:51.60,Default,,0,0,0,,Сіз де батылсыз.
Dialogue: 0,0:12:51.60,0:12:54.52,Default,,0,0,0,,Осы қалаға келген бойда Масакакиге қиындық тудырамын деп ойлау.
Dialogue: 0,0:12:54.52,0:12:57.52,Default,,0,0,0,,Бұл Микуни-сама.
Dialogue: 0,0:12:57.52,0:12:59.52,Default,,0,0,0,,Бүгінгі бизнесіңіз қандай?
Dialogue: 0,0:12:59.52,0:13:01.52,Default,,0,0,0,,- (Суичиро) Өте жаман, Масакаки. →
Dialogue: 0,0:13:01.52,0:13:05.20,Default,,0,0,0,,Бүгін сен емес, менің оған қатысым бар.
Dialogue: 0,0:13:05.20,0:13:06.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:06.86,0:13:09.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:09.53,0:13:11.53,Default,,0,0,0,,Хмм?
Dialogue: 0,0:13:13.54,0:13:15.54,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:13:15.54,0:13:17.54,Default,,0,0,0,,Ал, менің артымнан жүр.
Dialogue: 0,0:13:17.54,0:13:21.54,Default,,0,0,0,,Йога? А, есімде.
Dialogue: 0,0:13:21.54,0:13:23.55,Default,,0,0,0,,Шынымен! ? Толық айтып беріңізші.
Dialogue: 0,0:13:23.55,0:13:25.55,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:13:25.55,0:13:29.55,Default,,0,0,0,,Йога-сан дегенді қалай түсінесіңдер?
Dialogue: 0,0:13:29.55,0:13:31.55,Default,,0,0,0,,Менің ұлым. (Такетазаки) О. →
Dialogue: 0,0:13:31.55,0:13:35.56,Default,,0,0,0,,Иә, сіз. Хехе.
Dialogue: 0,0:13:35.56,0:13:37.56,Default,,0,0,0,,Бұл тағы да...
Dialogue: 0,0:13:37.56,0:13:39.56,Default,,0,0,0,,Әкеңе не болғанын білмейсің бе?
Dialogue: 0,0:13:39.56,0:13:41.56,Default,,0,0,0,,Тыңдашы, сен не істейсің?
Dialogue: 0,0:13:41.56,0:13:43.57,Default,,0,0,0,,Мен білгім келеді. Міне бітті.
Dialogue: 0,0:13:43.57,0:13:45.57,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:45.57,0:13:49.57,Default,,0,0,0,,О? Ха…. сурет?
Dialogue: 0,0:13:57.51,0:14:01.52,Default,,0,0,0,,Бұл күшті кіріспе болды. Мен Дильге құмар болдым.
Dialogue: 0,0:14:01.52,0:14:04.52,Default,,0,0,0,,Менің ойымша, ол көп ақша тапты. →
Dialogue: 0,0:14:04.52,0:14:07.52,Default,,0,0,0,,Бірақ мен көп нәрсені жоғалтып, банкротқа ұшырадым.
Dialogue: 0,0:14:07.52,0:14:11.53,Default,,0,0,0,,Сонымен? Бұл қалада банкротқа ұшырау → дегенді білдіреді
Dialogue: 0,0:14:11.53,0:14:14.53,Default,,0,0,0,,Бұл сіздің болашағыңызды пайдаланғаныңызды білдіреді. →
Dialogue: 0,0:14:14.53,0:14:17.53,Default,,0,0,0,,Отбасының алдында бетін көрсете алмай, жұмысқа орналаса алмау→
Dialogue: 0,0:14:17.53,0:14:22.54,Default,,0,0,0,,Ол саябақта турникпен асылып өлді. →
Dialogue: 0,0:14:22.54,0:14:26.54,Default,,0,0,0,,Мәйітті мемлекеттік органдар кәдеге жаратты, өйткені жеке басы белгісіз.
Dialogue: 0,0:14:26.54,0:14:28.55,Default,,0,0,0,,Мен сізге жұбаныш бергім келмейді.
Dialogue: 0,0:14:28.55,0:14:34.55,Default,,0,0,0,,Сенің әкең қайтыс болды. Бұл соңғы нәтиже туралы білетінім.
Dialogue: 0,0:14:34.55,0:14:37.55,Default,,0,0,0,,Басқа сұрағыңыз келетін нәрсе бар ма?
Dialogue: 0,0:14:40.56,0:14:42.56,Default,,0,0,0,,Ол қандай адам болды?
Dialogue: 0,0:14:42.56,0:14:44.56,Default,,0,0,0,,Мен бұрын-соңды →
Dialogue: 0,0:14:44.56,0:14:46.56,Default,,0,0,0,,Мен оның мінезі туралы көп білмеймін. →
Dialogue: 0,0:14:46.56,0:14:50.57,Default,,0,0,0,,Әйтеуір, сен ақшаға құмар болдың. →
Dialogue: 0,0:14:50.57,0:14:55.51,Default,,0,0,0,,Ол мүмкіндігінше көп ақша табуды ғана ойлағандай болды. →
Dialogue: 0,0:14:55.51,0:14:59.51,Default,,0,0,0,,Сараң - сенің әкең.
Dialogue: 0,0:14:59.51,0:15:03.51,Default,,0,0,0,,- (Такетазаки) Бірақ сен Йога-санның ұлысың. →
Dialogue: 0,0:15:03.51,0:15:09.52,Default,,0,0,0,,Менің бақытымды ата-анамнан алған шығармын. Менің әкем сияқты →
Dialogue: 0,0:15:09.52,0:15:12.52,Default,,0,0,0,,Аяқ астынан сыпырылмауға тырысыңыз. →
Dialogue: 0,0:15:12.52,0:15:17.53,Default,,0,0,0,,Мен осы қалада өмір сүруді шынайы әлемнен гөрі басымдылық ретінде қойдым.
Dialogue: 0,0:15:17.53,0:15:20.53,Default,,0,0,0,,Бұл аман қалудың кілті.
Dialogue: 0,0:15:20.53,0:15:22.53,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:15:22.53,0:15:25.54,Default,,0,0,0,,Бұл менің сүйікті ісім.
Dialogue: 0,0:15:25.54,0:15:29.54,Default,,0,0,0,,Бұл бүкіл қаланы көруге болатын жер.
Dialogue: 0,0:15:31.54,0:15:33.54,Default,,0,0,0,,Сіз мәмілені жалғастыруға мүдделісіз бе?
Dialogue: 0,0:15:33.54,0:15:35.55,Default,,0,0,0,,Мен олай сезінбеймін.
Dialogue: 0,0:15:35.55,0:15:37.55,Default,,0,0,0,,Түсіндім, солай ма?
Dialogue: 0,0:15:37.55,0:15:41.55,Default,,0,0,0,,Әкең сені тастап кетпеді, себебі бизнесі сәтсіз болды.
Dialogue: 0,0:15:41.55,0:15:44.55,Default,,0,0,0,,Осы жағдайға түспегенімде өлмес едім.
Dialogue: 0,0:15:44.55,0:15:47.56,Default,,0,0,0,,Ол қалыпты өмір сүре алуы керек еді.
Dialogue: 0,0:15:47.56,0:15:50.56,Default,,0,0,0,,Оны лақтырумен бірдей. Мен және анам.
Dialogue: 0,0:15:53.50,0:15:56.50,Default,,0,0,0,,Әкең не үшін ақша тапты деп ойлаймын.
Dialogue: 0,0:15:56.50,0:15:58.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:58.50,0:16:00.50,Default,,0,0,0,,Мақсаты – ақша табу. →
Dialogue: 0,0:16:00.50,0:16:03.51,Default,,0,0,0,,Әкем өз мүддесін ойлаған. →
Dialogue: 0,0:16:03.51,0:16:07.51,Default,,0,0,0,,Мен ақша үшін ақша жасадым.
Dialogue: 0,0:16:07.51,0:16:10.51,Default,,0,0,0,,Менің әкем сияқты.
Dialogue: 0,0:16:10.51,0:16:13.52,Default,,0,0,0,,Бала кезімде→
Dialogue: 0,0:16:13.52,0:16:16.52,Default,,0,0,0,,Бір кездері біздің компанияда бизнес дағдарысы болды. →
Dialogue: 0,0:16:16.52,0:16:21.52,Default,,0,0,0,,Менің әпкем жазылмайтын ауыр дертке шалдыққан. Біраз ақшамен жөнделу керек еді. →
Dialogue: 0,0:16:21.52,0:16:25.53,Default,,0,0,0,,Бірақ әкем компанияға ақша құйды. →
Dialogue: 0,0:16:25.53,0:16:28.53,Default,,0,0,0,,Нәтиже Компания өсті.
Dialogue: 0,0:16:33.54,0:16:38.54,Default,,0,0,0,,Осы қалада тапқан ақшамды ең бірінші не істедім деп ойлайсың?
Dialogue: 0,0:16:38.54,0:16:40.54,Default,,0,0,0,,Бұл әкемнің компаниясын басып алу.
Dialogue: 0,0:16:40.54,0:16:45.55,Default,,0,0,0,,Бұл сәтті болды. Мен одан бәрін тартып алдым.
Dialogue: 0,0:16:45.55,0:16:49.55,Default,,0,0,0,,Әкем тірі болса, мен де солай істер едім.
Dialogue: 0,0:16:49.55,0:16:52.49,Default,,0,0,0,,Аа... Сіз оны түсінбесеңіз де →
Dialogue: 0,0:16:52.49,0:16:54.49,Default,,0,0,0,,Ата-ананың ықпалы айтарлықтай үлкен.
Dialogue: 0,0:16:54.49,0:16:57.49,Default,,0,0,0,,Сіздердің арқаларыңызда мен осындай адамға айналдым.
Dialogue: 0,0:16:57.49,0:17:01.50,Default,,0,0,0,,Бірақ сізде өте адал мінез бар.
Dialogue: 0,0:17:01.50,0:17:06.50,Default,,0,0,0,,Әкем туралы естелік жоқ, бәрі анам мен апамның арқасы.
Dialogue: 0,0:17:06.50,0:17:09.51,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:09.51,0:17:12.51,Default,,0,0,0,,Мынаны қараңыз. Онда тек сандар жазылған.
Dialogue: 0,0:17:12.51,0:17:16.51,Default,,0,0,0,,Еш жерде анам немесе мен туралы ештеңе жазылмаған!
Dialogue: 0,0:17:16.51,0:17:18.51,Default,,0,0,0,,Ол шынымен сараң.
Dialogue: 0,0:17:18.51,0:17:21.52,Default,,0,0,0,,Сондай әке... Отбасым үшін... Шамасы.
Dialogue: 0,0:17:21.52,0:17:23.52,Default,,0,0,0,,Аа...
Dialogue: 0,0:17:23.52,0:17:26.52,Default,,0,0,0,,Ол отбасына ақша тауып жүрген жоқ па?
Dialogue: 0,0:17:29.53,0:17:31.53,Default,,0,0,0,,《Ха! 》
Dialogue: 0,0:17:35.53,0:17:39.54,Default,,0,0,0,,Сіз «қалыпты жақсырақ», «тұрақтылық жақсы» деп айта бересіз. →
Dialogue: 0,0:17:39.54,0:17:43.54,Default,,0,0,0,,Бұл тек өзіңіз үшін ақша табу туралы. →
Dialogue: 0,0:17:43.54,0:17:47.54,Default,,0,0,0,,Таразы басқа болса да, әкемнен онша айырмашылығы жоқ.
Dialogue: 0,0:17:47.54,0:17:52.54,Default,,0,0,0,,Ол сен менсінбеген әкеңнен төмен.
Dialogue: 0,0:17:54.48,0:17:57.49,Default,,0,0,0,,Ақша өзіңіз туралы емес, оны бір нәрсеге пайдалансаңыз ғана →
Dialogue: 0,0:17:57.49,0:18:00.49,Default,,0,0,0,,Менің ойымша, бұл қымбат. →
Dialogue: 0,0:18:00.49,0:18:03.49,Default,,0,0,0,,Сізде жоқ па? Бір нәрсе.
Dialogue: 0,0:18:05.50,0:18:10.50,Default,,0,0,0,,Егер ол жоқ болса, оны іздеңіз. Бірақ ол табылса да →
Dialogue: 0,0:18:10.50,0:18:13.50,Default,,0,0,0,,Сол уақытта жұмсайтын ақша болмаса, ол басталмайды.
Dialogue: 0,0:18:13.50,0:18:19.51,Default,,0,0,0,,Мәмілені жалғастыру. Ақша табыңыз. Оны бір нәрсе үшін пайдаланыңыз.
Dialogue: 0,0:18:19.51,0:18:21.51,Default,,0,0,0,,Ақшаны жұмсасаң, ол біреуді байытады.
Dialogue: 0,0:18:21.51,0:18:25.52,Default,,0,0,0,,Заттарды жинасаң, сен ғана бақытты боласың.
Dialogue: 0,0:18:25.52,0:18:28.52,Default,,0,0,0,,Кішкентай бақыт сізді бақытты етсе де→
Dialogue: 0,0:18:28.52,0:18:31.52,Default,,0,0,0,,Айналаңа үлкен бақыт тарата алмайсың.
Dialogue: 0,0:18:31.52,0:18:33.52,Default,,0,0,0,,Мен әкемнен асып түстім.
Dialogue: 0,0:18:33.52,0:18:37.53,Default,,0,0,0,,Және олар осы ел үшін мәмілелерден тапқан ақшаны пайдаланады.
Dialogue: 0,0:18:37.53,0:18:39.53,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:18:42.53,0:18:44.53,Default,,0,0,0,,Келесі келісімге дейін әлі уақыт бар.
Dialogue: 0,0:18:44.53,0:18:49.53,Default,,0,0,0,,Ойлау. Q. (Q) А...
Dialogue: 0,0:18:58.48,0:19:01.48,Default,,0,0,0,,Кимимаро~. Келме.
Dialogue: 0,0:19:01.48,0:19:03.49,Default,,0,0,0,,Неліктен? Қайтып келу.
Dialogue: 0,0:19:03.49,0:19:06.49,Default,,0,0,0,,Сәлем! Бұл не?
Dialogue: 0,0:19:14.50,0:19:19.50,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:24.51,0:19:30.51,Default,,0,0,0,,Мен оны гильдияға шақырмағаныңызға таң қалдым.
Dialogue: 0,0:19:30.51,0:19:32.51,Default,,0,0,0,,Аа...
Dialogue: 0,0:19:34.52,0:19:37.52,Default,,0,0,0,,<Мен осы қалада болып жатқан оқиғалардан хабардармын→
Dialogue: 0,0:19:37.52,0:19:40.52,Default,,0,0,0,,Ұйымға пункт бойынша есеп беру>
Dialogue: 0,0:19:40.52,0:19:42.53,Default,,0,0,0,,<Ұйымнан нұсқау жоқ>
Dialogue: 0,0:19:42.53,0:19:45.53,Default,,0,0,0,,＜Жай ғана хабарлаңыз＞
Dialogue: 0,0:19:47.53,0:19:51.53,Default,,0,0,0,,<Штабқа оралған соң сұрадым>
Dialogue: 0,0:20:26.50,0:20:28.50,Default,,0,0,0,,<Әлем бұрмаланып, сынған→
Dialogue: 0,0:20:28.50,0:20:31.51,Default,,0,0,0,,Мұны растай отырып, ол кеңейеді>
Dialogue: 0,0:20:31.51,0:20:35.51,Default,,0,0,0,,<Мүмкін бұл мен сияқты адам көтере алмайтын мәселе емес шығар.>
Dialogue: 0,0:20:35.51,0:20:37.51,Default,,0,0,0,,<Сонда да, менің ойымша>
Dialogue: 0,0:20:37.51,0:20:41.52,Default,,0,0,0,,＜Бірдеңе дұрыс емес. Егер бірдеңе дұрыс болмаса>
Dialogue: 0,0:20:41.52,0:20:45.52,Default,,0,0,0,,<Мынау қара, сұм алтын ештеңеге жарай ма?>
Dialogue: 0,0:20:45.52,0:20:48.52,Default,,0,0,0,,<Бұл сізге көмектесетін нәрсе ме?>
Dialogue: 0,0:20:48.52,0:20:51.53,Default,,0,0,0,,<Болашақты кепілге қою→
Dialogue: 0,0:20:51.53,0:20:53.53,Default,,0,0,0,,Қандай жағдай туғызады...＞
Dialogue: 0,0:20:53.53,0:20:57.53,Default,,0,0,0,,<Ал мен не істеуім керек?>
Dialogue: 0,0:21:02.54,0:21:06.54,Default,,0,0,0,,Бұл жерде. Мен сізге көрсетейін.
Dialogue: 0,0:21:06.54,0:21:10.55,Default,,0,0,0,,<Мен сенің болашағыңды бақылаймын>
Dialogue: 0,0:21:10.55,0:21:15.55,Default,,0,0,0,,<Маған жау боласың ба, одақтас боласың ба, өзіңе байланысты.>
Dialogue: 0,0:21:15.55,0:21:17.55,Default,,0,0,0,,Кимимаро. Кимимаро.
Dialogue: 0,0:21:17.55,0:21:20.56,Default,,0,0,0,,（）
Dialogue: 0,0:21:20.56,0:21:22.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:22.56,0:21:25.56,Default,,0,0,0,,Қашаннан бері? Йога.
Dialogue: 0,0:21:25.56,0:21:35.56,Default,,0,0,0,,Сен
Dialogue: 0,0:21:37.06,0:21:43.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory