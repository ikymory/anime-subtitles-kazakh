Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:20.78,0:01:22.99,Default,,0,0,0,,Бұл өте ескі спутник.
Dialogue: 0,0:01:23.12,0:01:26.33,Default,,0,0,0,,Ғарыш шекарасына жеткенше гравитациялық өрісте қалай ұсталғаны таңқаларлық.
Dialogue: 0,0:01:26.46,0:01:27.87,Default,,0,0,0,,Сонда бұл үлкен саяхат?
Dialogue: 0,0:01:28.00,0:01:30.88,Default,,0,0,0,,Хайнц Спутниктің жағдайы қандай?
Dialogue: 0,0:01:31.00,0:01:33.42,Default,,0,0,0,,Жалғыз назар аударарлық нәрсе - магнитофон.
Dialogue: 0,0:01:33.55,0:01:35.38,Default,,0,0,0,,Бүкіл жерсерікті қалпына келтіресіз бе?
Dialogue: 0,0:01:35.51,0:01:37.18,Default,,0,0,0,,Жүк орны жеткіліксіз
Dialogue: 0,0:01:37.30,0:01:37.97,Default,,0,0,0,,Жою
Dialogue: 0,0:01:38.09,0:01:38.97,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:01:39.09,0:01:40.22,Default,,0,0,0,,Шығу
Dialogue: 0,0:01:44.22,0:01:50.23,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:19.63,0:02:21.85,Default,,0,0,0,,Мұнда Корона Мұнда Корона
Dialogue: 0,0:02:21.97,0:02:24.14,Default,,0,0,0,,103 станция мені естисіз бе?
Dialogue: 0,0:02:24.26,0:02:27.64,Default,,0,0,0,,Бұл 103 Корона станциясы, өтінемін.
Dialogue: 0,0:02:27.77,0:02:29.06,Default,,0,0,0,,Қорытынды жоспарлы жұмыс
Dialogue: 0,0:02:29.48,0:02:34.57,Default,,0,0,0,,PZ302 маршрутын айналып өту кезіндегі кедергілерді жою аяқталды.
Dialogue: 0,0:02:34.69,0:02:37.57,Default,,0,0,0,,Енді 103-станцияға оралыңыз
Dialogue: 0,0:02:37.69,0:02:40.28,Default,,0,0,0,,103 бекет Түсінді
Dialogue: 0,0:02:40.82,0:02:44.41,Default,,0,0,0,,Мазалағаным үшін кешіріңіз, N бағытын ұстаныңыз.
Dialogue: 0,0:02:44.53,0:02:47.91,Default,,0,0,0,,N бағыты туралы не деуге болады? Бұл басқа аймақ.
Dialogue: 0,0:02:48.04,0:02:52.04,Default,,0,0,0,,Пайдалы қазбаларды өндіру үшін қолданылатын астероидтар N жолына ағып жатыр.
Dialogue: 0,0:02:48.04,0:02:52.04,Default,,0,0,0,,〜♪
Dialogue: 0,0:02:52.04,0:02:52.17,Default,,0,0,0,,〜♪
Dialogue: 0,0:02:52.17,0:02:52.63,Default,,0,0,0,,〜♪
Dialogue: 0,0:02:52.17,0:02:52.63,Default,,0,0,0,,Өкінішке орай, бұл аймақты қалпына келтіру кемесі
Dialogue: 0,0:02:52.63,0:02:55.04,Default,,0,0,0,,Өкінішке орай, сол аумақты қамтитын қалпына келтіру кемесі
Dialogue: 0,0:02:55.17,0:02:56.96,Default,,0,0,0,,Қиындық туғызбаңыз
Dialogue: 0,0:02:57.09,0:03:00.26,Default,,0,0,0,,Ең жақын коронавирус – сіздің үйіңіз.
Dialogue: 0,0:03:00.38,0:03:03.14,Default,,0,0,0,,Бір ғана өтінемін, Иванов.
Dialogue: 0,0:03:03.26,0:03:05.64,Default,,0,0,0,,Жоқ, бұл жай ғана тілек.
Dialogue: 0,0:03:06.68,0:03:09.48,Default,,0,0,0,,Біз де, коронавирус та таусылды.
Dialogue: 0,0:03:09.60,0:03:13.19,Default,,0,0,0,,Иванов жастан асқан ақы да өсетінін айтады.
Dialogue: 0,0:03:13.31,0:03:15.19,Default,,0,0,0,,Ой, кешіріңіз, тағы бірдеңе айтыңызшы.
Dialogue: 0,0:03:15.90,0:03:17.48,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:03:17.61,0:03:19.86,Default,,0,0,0,,Олай болса үйге бара жатқанда абай болыңыз.
Dialogue: 0,0:03:19.99,0:03:22.16,Default,,0,0,0,,Кездесу орны кейінірек жарияланады.
Dialogue: 0,0:03:22.28,0:03:23.57,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:24.49,0:03:27.58,Default,,0,0,0,,А, жоғарыдағы жігіттер...
Dialogue: 0,0:03:27.95,0:03:30.33,Default,,0,0,0,,Бізді пайдаланып жатырмыз деп ойламаңыз.
Dialogue: 0,0:03:32.12,0:03:34.75,Default,,0,0,0,,Сіз өтіп бара жатқан барлық жаман жұмыс
Dialogue: 0,0:03:35.75,0:03:39.34,Default,,0,0,0,,Қоқыс жинаушы болып жұмыс істеу онша қиын емес.
Dialogue: 0,0:03:40.47,0:03:41.59,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:03:41.72,0:03:45.22,Default,,0,0,0,,Ертеде қоқыс тауы қазына тауы болған.
Dialogue: 0,0:03:45.47,0:03:47.64,Default,,0,0,0,,Егер апатқа ұшыраған кемелердің бірі жарылып кетсе
Dialogue: 0,0:03:47.76,0:03:49.77,Default,,0,0,0,,Калифорнияда үй салынады, солай ма?
Dialogue: 0,0:03:49.85,0:03:50.18,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:50.18,0:03:51.64,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:50.18,0:03:51.64,Default,,0,0,0,,Осыны айтып,
Dialogue: 0,0:03:51.77,0:03:55.27,Default,,0,0,0,,Бұл күндері апатқа ұшыраған кемелерге табынуға болмайды.
Dialogue: 0,0:03:55.52,0:03:56.94,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:03:57.07,0:04:00.82,Default,,0,0,0,,Хайнц, Аошимаға кеме апаты туралы айтып берші.
Dialogue: 0,0:04:00.94,0:04:02.36,Default,,0,0,0,,Циндао
Dialogue: 0,0:04:03.03,0:04:06.41,Default,,0,0,0,,Жұмсақ болсаң, қарашы, біз бармыз.
Dialogue: 0,0:04:08.79,0:04:11.41,Default,,0,0,0,,Уф... бұл сондай сағыныш
Dialogue: 0,0:04:12.29,0:04:15.04,Default,,0,0,0,,Сесиль, мен жақында үйде боламын.
Dialogue: 0,0:04:15.17,0:04:17.00,Default,,0,0,0,,Жақсы қыз болып, мені күт.
Dialogue: 0,0:04:17.34,0:04:19.00,Default,,0,0,0,,Хехехе Сесил
Dialogue: 0,0:04:19.13,0:04:19.84,Default,,0,0,0,,А... күте тұрыңыз.
Dialogue: 0,0:04:19.96,0:04:21.46,Default,,0,0,0,,Ойланып қарасам, Кэтрин де сонда ма?
Dialogue: 0,0:04:21.59,0:04:24.22,Default,,0,0,0,,Мен сізге не істей аламын?
Dialogue: 0,0:04:24.34,0:04:26.18,Default,,0,0,0,,Бірақ бір ғана жауап бар.
Dialogue: 0,0:04:28.01,0:04:31.14,Default,,0,0,0,,Уф, бұл дыбыс шықпайды.
Dialogue: 0,0:04:31.27,0:04:34.44,Default,,0,0,0,,Хехехехехехехе...
Dialogue: 0,0:04:34.56,0:04:37.94,Default,,0,0,0,,Жұмыс орындарының бәрі даланың ортасында болуы ғажап емес.
Dialogue: 0,0:04:38.23,0:04:41.11,Default,,0,0,0,,Бұл сәл шыдамдылық.
Dialogue: 0,0:04:41.23,0:04:44.82,Default,,0,0,0,,Бірақ мен сондай нәрсеге іліккен әйелді аяймын.
Dialogue: 0,0:04:44.95,0:04:46.16,Default,,0,0,0,,Хехе, қате жоқ.
Dialogue: 0,0:04:46.57,0:04:49.74,Default,,0,0,0,,Хайнц, сен екеуміздің де қыз болғанымызға сенімдімін.
Dialogue: 0,0:04:49.87,0:04:52.66,Default,,0,0,0,,Бірақ ол әлі 10 жаста ма?
Dialogue: 0,0:04:53.91,0:04:55.54,Default,,0,0,0,,Ха, өтінемін.
Dialogue: 0,0:04:55.67,0:04:57.63,Default,,0,0,0,,Мен ондай балаға қызықпаймын.
Dialogue: 0,0:04:59.96,0:05:01.46,Default,,0,0,0,,Жұмыс аяқталды
Dialogue: 0,0:05:02.84,0:05:05.76,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:05:05.97,0:05:06.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:07.39,0:05:08.85,Default,,0,0,0,,Апаттық сигнал?
Dialogue: 0,0:05:09.76,0:05:11.72,Default,,0,0,0,,Көк Қайнар көзі?
Dialogue: 0,0:05:16.44,0:05:18.06,Default,,0,0,0,,Не?
Dialogue: 0,0:05:35.83,0:05:40.21,Default,,0,0,0,,Эй, эй, Аошима, сен не қалжыңдап тұрсың?
Dialogue: 0,0:05:40.33,0:05:41.96,Default,,0,0,0,,Баттерфляй ханым?
Dialogue: 0,0:05:42.09,0:05:44.30,Default,,0,0,0,,Бұл шынымен SOS па?
Dialogue: 0,0:05:45.42,0:05:48.26,Default,,0,0,0,,А... бұл апаттық арна.
Dialogue: 0,0:05:48.68,0:05:51.47,Default,,0,0,0,,Ей, эй... Мен ауыр жұмыс істеуге мәжбүр болдым.
Dialogue: 0,0:05:51.60,0:05:54.06,Default,,0,0,0,,Сонымен қатар, сіз басқаларға көмектесетін еріктісіз бе?
Dialogue: 0,0:05:54.18,0:05:56.77,Default,,0,0,0,,Мүмкін сіз құтқарушыларға хабарласуыңыз керек.
Dialogue: 0,0:05:56.89,0:05:59.02,Default,,0,0,0,,Ақымақ, тым болмаса халықаралық навигацияны үйрен.
Dialogue: 0,0:05:59.19,0:06:02.07,Default,,0,0,0,,Мен енді ешқашан кемеге отыра алмаймын.
Dialogue: 0,0:06:02.19,0:06:04.03,Default,,0,0,0,,Аошима Түсінесің бе?
Dialogue: 0,0:06:04.23,0:06:08.99,Default,,0,0,0,,Мм... RZ30... 05?
Dialogue: 0,0:06:09.11,0:06:09.82,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:09.95,0:06:11.32,Default,,0,0,0,,Қара, ештеңе айтпа.
Dialogue: 0,0:06:11.45,0:06:15.08,Default,,0,0,0,,Саргассо дегеніміз не?
Dialogue: 0,0:06:15.24,0:06:18.25,Default,,0,0,0,,Хмм... ғарыштық зират.
Dialogue: 0,0:06:18.50,0:06:21.75,Default,,0,0,0,,Хехе, тек қарттар ғана шақырылады емес пе?
Dialogue: 0,0:06:22.00,0:06:25.42,Default,,0,0,0,,Бірақ магнетизм тым күшті болған кезде...
Dialogue: 0,0:06:26.26,0:06:27.26,Default,,0,0,0,,Ах
Dialogue: 0,0:06:27.38,0:06:30.43,Default,,0,0,0,,Менің нашар компьютерімде магнитке қарсы жабын жоқ.
Dialogue: 0,0:06:30.80,0:06:33.18,Default,,0,0,0,,Қараңызшы, бұл жалаңаш емес пе?
Dialogue: 0,0:06:33.35,0:06:35.93,Default,,0,0,0,,Хе, ақымақтар суық тигізбейді.
Dialogue: 0,0:06:36.06,0:06:39.19,Default,,0,0,0,,Хмм... Әйтеуір, екі есе қиындыққа тап болғаныңды қаламаймын.
Dialogue: 0,0:06:39.31,0:06:40.69,Default,,0,0,0,,Сәлем, бастық
Dialogue: 0,0:06:42.31,0:06:43.94,Default,,0,0,0,,Курсты өзгерту
Dialogue: 0,0:07:17.39,0:07:18.98,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:07:19.10,0:07:21.89,Default,,0,0,0,,Калифорнияда 100 үй салынатын сияқты.
Dialogue: 0,0:07:22.02,0:07:24.02,Default,,0,0,0,,Мен оны үйге апарсам болды.
Dialogue: 0,0:07:28.57,0:07:30.99,Default,,0,0,0,,Босс магниттілігі артты
Dialogue: 0,0:07:31.11,0:07:33.11,Default,,0,0,0,,Міне келді
Dialogue: 0,0:07:33.24,0:07:35.70,Default,,0,0,0,,Апаттық компьютерге ауысу
Dialogue: 0,0:07:38.24,0:07:40.66,Default,,0,0,0,,Бұлттарға бір нәрсе барады.
Dialogue: 0,0:07:40.79,0:07:42.46,Default,,0,0,0,,Сәлем Хайнц
Dialogue: 0,0:07:44.29,0:07:48.05,Default,,0,0,0,,Циндао: Дерек көзін әлі анықтай алмайсыз ба?
Dialogue: 0,0:07:48.71,0:07:50.38,Default,,0,0,0,,Е... а...
Dialogue: 0,0:07:50.63,0:07:52.18,Default,,0,0,0,,Бастыққа қарау
Dialogue: 0,0:07:53.26,0:07:55.93,Default,,0,0,0,,Иә? Не? Бұл... бұл...
Dialogue: 0,0:08:19.91,0:08:23.16,Default,,0,0,0,,Ол үлкен, астероид сияқты.
Dialogue: 0,0:08:23.29,0:08:25.33,Default,,0,0,0,,Қоқыс жинағынан жасалған.
Dialogue: 0,0:08:25.50,0:08:27.25,Default,,0,0,0,,Циндао Біз оны басып аламыз ба?
Dialogue: 0,0:08:27.38,0:08:30.71,Default,,0,0,0,,Жарайды, кейде шу болады.
Dialogue: 0,0:08:34.01,0:08:37.05,Default,,0,0,0,,Осындай жерде шынымен аман қалғандар бар ма?
Dialogue: 0,0:08:37.64,0:08:39.56,Default,,0,0,0,,Мен оған кірейін деп жатырмын. Маған жол көрсетіңізші.
Dialogue: 0,0:08:39.68,0:08:41.06,Default,,0,0,0,,Егер біз костюм киіп, көшеге шықсақ, біз батырмыз
Dialogue: 0,0:08:41.18,0:08:43.18,Default,,0,0,0,,Ол центроидтық гравитация жасайды...
Dialogue: 0,0:08:43.31,0:08:45.52,Default,,0,0,0,,Адамдар бар дегенді білдіреді.
Dialogue: 0,0:08:46.48,0:08:48.98,Default,,0,0,0,,Қарақшы емес деп үміттеніңіз.
Dialogue: 0,0:09:06.00,0:09:08.08,Default,,0,0,0,,Көк Бұл бұл (Циндао) Иә.
Dialogue: 0,0:09:18.18,0:09:19.93,Default,,0,0,0,,Бұл кіреберіс пе?
Dialogue: 0,0:09:20.05,0:09:22.64,Default,,0,0,0,,кенет мені жалғыз қалдырғаныңды қаламаймын.
Dialogue: 0,0:09:22.77,0:09:24.68,Default,,0,0,0,,Содан кейін қағыңыз.
Dialogue: 0,0:09:55.84,0:09:59.14,Default,,0,0,0,,Жарайды, Хайнц, басып кірудің дәлелін жаз.
Dialogue: 0,0:09:59.26,0:10:00.34,Default,,0,0,0,,Маған жеке куәлігіңізді көрсетіңіз
Dialogue: 0,0:10:06.85,0:10:08.69,Default,,0,0,0,,Жарайды, бастаңыз.
Dialogue: 0,0:10:08.81,0:10:12.86,Default,,0,0,0,,Мен, Хайнц Бекнер, Мигель Костреламен
Dialogue: 0,0:10:12.98,0:10:16.57,Default,,0,0,0,,RZ3005 Апат сигналының сұрауы бойынша
Dialogue: 0,0:10:16.69,0:10:20.36,Default,,0,0,0,,Тиісті кемеге еніп, құтқару жұмыстарын жүргізу
Dialogue: 0,0:10:20.78,0:10:24.12,Default,,0,0,0,,12 қазан 2092 ж
Dialogue: 0,0:10:28.33,0:10:32.34,Default,,0,0,0,,12 қазан 2092 ж
Dialogue: 0,0:10:32.79,0:10:34.63,Default,,0,0,0,,Жарайды, түсінікті.
Dialogue: 0,0:10:34.96,0:10:36.71,Default,,0,0,0,,Бұл да жақсы.
Dialogue: 0,0:10:53.69,0:10:57.74,Default,,0,0,0,,Бірақ, бұл өте ескі жабдық.
Dialogue: 0,0:10:57.86,0:11:01.45,Default,,0,0,0,,Соның арқасында біз басып аламыз.
Dialogue: 0,0:11:07.79,0:11:09.91,Default,,0,0,0,,(Шығатын ауаның дыбысы)
Dialogue: 0,0:11:10.67,0:11:12.08,Default,,0,0,0,,Оттегі?
Dialogue: 0,0:11:12.75,0:11:17.05,Default,,0,0,0,,Ауа таза сияқты, мен радиацияға алаңдамаймын.
Dialogue: 0,0:11:18.05,0:11:19.09,Default,,0,0,0,,Магнитизм туралы не айтуға болады?
Dialogue: 0,0:11:19.42,0:11:22.72,Default,,0,0,0,,Қазір тұрақты, бірақ... не болатынын білмеймін.
Dialogue: 0,0:11:22.84,0:11:24.10,Default,,0,0,0,,3 сағаттан кейін оралу
Dialogue: 0,0:11:24.35,0:11:25.18,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:25.30,0:11:27.22,Default,,0,0,0,,Оны еркін айтуыңызды өтінемін.
Dialogue: 0,0:11:28.43,0:11:30.60,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:30.73,0:11:32.19,Default,,0,0,0,,Мигель, жақсысың ба?
Dialogue: 0,0:11:32.31,0:11:33.94,Default,,0,0,0,,А, а, а...
Dialogue: 0,0:11:34.73,0:11:36.23,Default,,0,0,0,,Балаларға арналған тағам.
Dialogue: 0,0:11:36.36,0:11:39.03,Default,,0,0,0,,Хаа... Мен сені жер қойнауына апарайын ба?
Dialogue: 0,0:11:47.95,0:11:48.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:49.91,0:11:52.08,Default,,0,0,0,,Ах... тартылыс күші келеді.
Dialogue: 0,0:11:52.46,0:11:55.67,Default,,0,0,0,,Уау... аа...
Dialogue: 0,0:11:55.79,0:11:57.34,Default,,0,0,0,,Қан тамшылары
Dialogue: 0,0:11:57.46,0:11:59.51,Default,,0,0,0,,Менде кальций жетіспейді.
Dialogue: 0,0:11:59.63,0:12:00.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:02.59,0:12:03.55,Default,,0,0,0,,Тезірек жүр, Мигель.
Dialogue: 0,0:12:04.14,0:12:05.68,Default,,0,0,0,,Сен оған көп қиындық көрсеттің ғой, иә?
Dialogue: 0,0:12:06.55,0:12:08.43,Default,,0,0,0,,Уф... Каха...
Dialogue: 0,0:12:10.22,0:12:11.43,Default,,0,0,0,,Қара, тегі бірдей. Сен іздедің ғой, иә?
Dialogue: 0,0:12:11.56,0:12:12.94,Default,,0,0,0,,Тұра алмайды
Dialogue: 0,0:12:13.48,0:12:14.90,Default,,0,0,0,,Маған бәрібір, бас тарт.
Dialogue: 0,0:12:21.78,0:12:23.32,Default,,0,0,0,,(лифт тоқтаған дыбыс)
Dialogue: 0,0:12:24.82,0:12:26.99,Default,,0,0,0,,Жындар немесе жыландар бола ма?
Dialogue: 0,0:12:27.12,0:12:29.24,Default,,0,0,0,,Сіз кіргеннен кейін түсінесіз.
Dialogue: 0,0:12:35.54,0:12:37.29,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:47.80,0:12:49.64,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:12:49.76,0:12:51.35,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:12:51.47,0:12:52.93,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:12:58.31,0:12:59.57,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:00.82,0:13:01.98,Default,,0,0,0,,Мені көріп тұрсың ба, қария?
Dialogue: 0,0:13:02.32,0:13:04.78,Default,,0,0,0,,О, неткен арман!
Dialogue: 0,0:13:04.90,0:13:07.82,Default,,0,0,0,,Хехе, бұл қорқынышты түс.
Dialogue: 0,0:13:16.25,0:13:19.38,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:13:29.64,0:13:30.72,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:45.36,0:13:47.03,Default,,0,0,0,,Біртүрлі тыныш.
Dialogue: 0,0:13:47.15,0:13:49.28,Default,,0,0,0,,Циндао SOS әлі де қолжетімді ме?
Dialogue: 0,0:13:49.41,0:13:51.37,Default,,0,0,0,,Не болды саған? Біраз қақтығысқыш болып тұрсың ғой?
Dialogue: 0,0:13:51.66,0:13:54.66,Default,,0,0,0,,Бірақ бұрынғыдан сәл әлсіздеу сияқты...
Dialogue: 0,0:13:54.79,0:13:55.62,Default,,0,0,0,,Магнетизмге байланысты ма?
Dialogue: 0,0:13:55.75,0:13:56.96,Default,,0,0,0,,Жоқ, бірақ мен олай ойламаймын...
Dialogue: 0,0:13:58.42,0:14:00.79,Default,,0,0,0,,Мигель, қарашы.
Dialogue: 0,0:14:00.92,0:14:01.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:04.71,0:14:05.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:06.47,0:14:08.43,Default,,0,0,0,,Сен жақсы әйел емессің бе?
Dialogue: 0,0:14:08.55,0:14:09.64,Default,,0,0,0,,Мырза?
Dialogue: 0,0:14:09.76,0:14:11.39,Default,,0,0,0,,жақсы болар еді.
Dialogue: 0,0:14:12.18,0:14:16.14,Default,,0,0,0,,Мигель, Ибарра ханшайымға көмектесетін батыл адам...
Dialogue: 0,0:14:16.27,0:14:18.19,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:14:18.64,0:14:19.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:22.31,0:14:23.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:23.73,0:14:25.19,Default,,0,0,0,,Адамдар... Эй, Мигель.
Dialogue: 0,0:14:25.32,0:14:26.90,Default,,0,0,0,,Адамдар! Бір әйел болды
Dialogue: 0,0:14:27.03,0:14:28.15,Default,,0,0,0,,Не?
Dialogue: 0,0:14:34.20,0:14:35.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:46.88,0:14:48.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:55.01,0:14:58.68,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:14:58.81,0:14:59.69,Default,,0,0,0,,Бұл
Dialogue: 0,0:15:00.44,0:15:02.02,Default,,0,0,0,,Әй, сен не істеп жатырсың?
Dialogue: 0,0:15:02.15,0:15:03.56,Default,,0,0,0,,Голограмма шынымен де сирек кездеседі ме?
Dialogue: 0,0:15:03.69,0:15:04.40,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:04.52,0:15:06.23,Default,,0,0,0,,...және? Әйел болды ма?
Dialogue: 0,0:15:06.36,0:15:09.32,Default,,0,0,0,,Не? Жоқ, бұл...
Dialogue: 0,0:15:10.03,0:15:12.07,Default,,0,0,0,,Желмен жоғалып кетті
Dialogue: 0,0:15:12.20,0:15:12.99,Default,,0,0,0,,Хахаха
Dialogue: 0,0:15:13.12,0:15:15.87,Default,,0,0,0,,Себебі мен сабын көпіршігіне ұқсайтын әйелдерді үнемі қуып келемін.
Dialogue: 0,0:15:15.99,0:15:17.41,Default,,0,0,0,,Шулы
Dialogue: 0,0:15:17.54,0:15:18.33,Default,,0,0,0,,Иә
Dialogue: 0,0:15:18.45,0:15:20.21,Default,,0,0,0,,Үйге келгенше ойнама.
Dialogue: 0,0:15:20.33,0:15:21.29,Default,,0,0,0,,Хайнц! артында
Dialogue: 0,0:15:21.46,0:15:22.29,Default,,0,0,0,,А...
Dialogue: 0,0:15:25.17,0:15:28.88,Default,,0,0,0,,Ас дайын, ханым.
Dialogue: 0,0:15:29.67,0:15:33.59,Default,,0,0,0,,Ас дайын, ханым.
Dialogue: 0,0:15:35.60,0:15:36.64,Default,,0,0,0,,Не?
Dialogue: 0,0:15:38.31,0:15:39.98,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:48.19,0:15:49.99,Default,,0,0,0,,Сіздің әйеліңіз...
Dialogue: 0,0:15:53.07,0:15:55.57,Default,,0,0,0,,Уууу, дәмді көрінеді
Dialogue: 0,0:15:57.41,0:15:58.91,Default,,0,0,0,,Сіз Аошиманы көре аласыз ба?
Dialogue: 0,0:15:59.04,0:16:01.21,Default,,0,0,0,,Кора Мигель, сен не ойлап тұрсың?
Dialogue: 0,0:16:01.33,0:16:03.62,Default,,0,0,0,,Ей, эй, эй, пайда, пайда.
Dialogue: 0,0:16:03.75,0:16:04.92,Default,,0,0,0,,Сәлем, Хайнц.
Dialogue: 0,0:16:05.42,0:16:09.13,Default,,0,0,0,,Аа, мен мұндай жерде нағыз шараптың дәмін тататыныма сене алар емеспін.
Dialogue: 0,0:16:09.67,0:16:12.76,Default,,0,0,0,,Бірақ бір қызық, бір порция деген не?
Dialogue: 0,0:16:13.51,0:16:15.30,Default,,0,0,0,,Сіздің әйеліңіз жалғыз тұрады.
Dialogue: 0,0:16:15.30,0:16:15.72,Default,,0,0,0,,Сіздің әйеліңіз жалғыз тұрады.
Dialogue: 0,0:16:15.30,0:16:15.72,Default,,0,0,0,,(ашу дыбысы)
Dialogue: 0,0:16:15.72,0:16:15.84,Default,,0,0,0,,(Ашық дыбыс)
Dialogue: 0,0:16:15.84,0:16:16.10,Default,,0,0,0,,(ашу дыбысы)
Dialogue: 0,0:16:15.84,0:16:16.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:16.10,0:16:16.76,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:16.89,0:16:18.43,Default,,0,0,0,,Хехехе
Dialogue: 0,0:16:19.64,0:16:21.60,Default,,0,0,0,,Сіз қалай ойлайсыз? Хайнц да
Dialogue: 0,0:16:21.73,0:16:23.35,Default,,0,0,0,,Мен сенің ішіңді сындырамын
Dialogue: 0,0:16:27.06,0:16:28.69,Default,,0,0,0,,Бұл да дәуірден.
Dialogue: 0,0:16:28.82,0:16:29.44,Default,,0,0,0,,（）
Dialogue: 0,0:16:29.57,0:16:31.11,Default,,0,0,0,,Хмм, жақсы иіс
Dialogue: 0,0:16:31.78,0:16:33.28,Default,,0,0,0,,Кора Мигель, сабыр ет.
Dialogue: 0,0:16:33.40,0:16:34.74,Default,,0,0,0,,Өлсем де, білмеймін
Dialogue: 0,0:16:34.95,0:16:37.07,Default,,0,0,0,,Әрқайсысы тітіркендіргіш
Dialogue: 0,0:16:38.41,0:16:41.70,Default,,0,0,0,,(Су дыбысы)
Dialogue: 0,0:16:41.83,0:16:44.08,Default,,0,0,0,,Әйеліңізге сәлем
Dialogue: 0,0:16:47.08,0:16:50.13,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:16:50.25,0:16:51.76,Default,,0,0,0,,Сора, мен айтпаймын.
Dialogue: 0,0:16:51.88,0:16:52.88,Default,,0,0,0,,Өлмесең де, ұят
Dialogue: 0,0:16:52.88,0:16:54.38,Default,,0,0,0,,Өлмесең де, ұят
Dialogue: 0,0:16:52.88,0:16:54.38,Default,,0,0,0,,Қат! Буха…
Dialogue: 0,0:16:54.38,0:16:54.72,Default,,0,0,0,,Қат! Буха…
Dialogue: 0,0:16:54.84,0:16:56.30,Default,,0,0,0,,Бұл да дұрыс па?
Dialogue: 0,0:16:56.43,0:16:58.68,Default,,0,0,0,,Бұл дәл осылай көрінеді ме?
Dialogue: 0,0:17:01.89,0:17:03.48,Default,,0,0,0,,Қария, болмайды...
Dialogue: 0,0:17:03.73,0:17:05.73,Default,,0,0,0,,Бұлардың барлығын қағып алуға болады...
Dialogue: 0,0:17:05.85,0:17:08.31,Default,,0,0,0,,Жарайды, әрі қарай жүріңіз.
Dialogue: 0,0:17:09.86,0:17:13.03,Default,,0,0,0,,SOS шамамен 70 метр қашықтықтан жіберілуде.
Dialogue: 0,0:17:13.15,0:17:14.24,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:17:14.53,0:17:17.32,Default,,0,0,0,,Сондай-ақ, бұл жай қасбет деп ойламаймын.
Dialogue: 0,0:17:20.70,0:17:21.49,Default,,0,0,0,,(музыкалық қораптың үні)
Dialogue: 0,0:17:21.66,0:17:22.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:24.54,0:17:26.17,Default,,0,0,0,,Не болды? Хайнц
Dialogue: 0,0:17:30.00,0:17:36.80,Default,,0,0,0,,(музыкалық қораптың үні)
Dialogue: 0,0:17:47.10,0:17:47.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:50.31,0:17:51.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:52.48,0:17:54.57,Default,,0,0,0,,А, сен бұздың.
Dialogue: 0,0:17:55.15,0:17:56.40,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:56.53,0:17:58.78,Default,,0,0,0,,Бұл тұрарлық шығар.
Dialogue: 0,0:18:04.24,0:18:04.95,Default,,0,0,0,,（）
Dialogue: 0,0:18:05.08,0:18:06.79,Default,,0,0,0,,Ах, жақсы иіс
Dialogue: 0,0:18:06.91,0:18:09.12,Default,,0,0,0,,Бұл сіздің әйеліңіздің макияж бөлмесі ме?
Dialogue: 0,0:18:09.25,0:18:11.63,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:18:11.75,0:18:14.63,Default,,0,0,0,,Ааа, тыртық емес пе?
Dialogue: 0,0:18:14.76,0:18:15.80,Default,,0,0,0,,Аа...
Dialogue: 0,0:18:16.13,0:18:17.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:17.93,0:18:18.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:18.80,0:18:20.18,Default,,0,0,0,,Циндао Сіз оны көре аласыз ба?
Dialogue: 0,0:18:20.64,0:18:23.22,Default,,0,0,0,,Ах, портреттегі әйел.
Dialogue: 0,0:18:28.48,0:18:29.69,Default,,0,0,0,,Токиода бұлардың әрқайсысы 3 миллиард немесе 4 миллиард тұрар еді.
Dialogue: 0,0:18:30.23,0:18:33.07,Default,,0,0,0,,Ке, мұндай адамға тым жақсы.
Dialogue: 0,0:18:33.61,0:18:35.36,Default,,0,0,0,,Бұл әйел актриса ма?
Dialogue: 0,0:18:35.48,0:18:36.94,Default,,0,0,0,,Сәлем Хайнц
Dialogue: 0,0:18:37.07,0:18:37.69,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:37.82,0:18:41.20,Default,,0,0,0,,(Голографиялық ән айту)
Dialogue: 0,0:18:41.32,0:18:44.24,Default,,0,0,0,,Голограф… Бұл әйел ме?
Dialogue: 0,0:18:44.91,0:18:46.87,Default,,0,0,0,,Ах, осы олжаның иесі.
Dialogue: 0,0:18:48.00,0:18:50.46,Default,,0,0,0,,Керісінше, бұл сарайдың иесі сияқты.
Dialogue: 0,0:18:50.58,0:18:52.58,Default,,0,0,0,,Тірі болсам ғой
Dialogue: 0,0:18:53.25,0:18:55.63,Default,,0,0,0,,«Ева Фридель мәңгі ән айтады»
Dialogue: 0,0:18:55.75,0:18:59.09,Default,,0,0,0,,«2031 жылғы 3 шілде»…
Dialogue: 0,0:18:59.76,0:19:02.39,Default,,0,0,0,,Аошима, маған осы әйел туралы деректерді жіберіңізші.
Dialogue: 0,0:19:05.39,0:19:07.56,Default,,0,0,0,,«Итальяндық опера фестивалі үздік солист сыйлығы»
Dialogue: 0,0:19:07.93,0:19:09.43,Default,,0,0,0,,«Вена музыка фестивалінің бас жүлдесі»
Dialogue: 0,0:19:09.56,0:19:11.60,Default,,0,0,0,,«Токио халықаралық опера фестивалінің алтын жүлдесі»
Dialogue: 0,0:19:11.73,0:19:14.02,Default,,0,0,0,,Сонда сіздің әйеліңіз опера әншісі ме?
Dialogue: 0,0:19:15.77,0:19:20.65,Default,,0,0,0,,Жалғыз тұрып, бұрынғы даңқыңа бөленгенсің бе?
Dialogue: 0,0:19:24.87,0:19:25.91,Default,,0,0,0,,Таңқаларлық емес
Dialogue: 0,0:19:26.41,0:19:28.58,Default,,0,0,0,,Бұл керемет мөлшердегі костюмдер.
Dialogue: 0,0:19:30.08,0:19:32.62,Default,,0,0,0,,Бұл тек айқын.
Dialogue: 0,0:19:32.75,0:19:35.21,Default,,0,0,0,,Сонымен, SOS дегеніміз не?
Dialogue: 0,0:19:35.34,0:19:37.21,Default,,0,0,0,,Мен жалғыз болдым, білесің.
Dialogue: 0,0:19:37.34,0:19:38.67,Default,,0,0,0,,Ол қиын әйел.
Dialogue: 0,0:19:40.88,0:19:43.68,Default,,0,0,0,,Бүгінгі «Тоска» керемет, Ева.
Dialogue: 0,0:19:43.97,0:19:48.14,Default,,0,0,0,,Әсіресе сол дуэт, басқа ешкімді елестете алмаймын.
Dialogue: 0,0:19:50.43,0:19:51.69,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:19:52.81,0:19:55.77,Default,,0,0,0,,(Еваның күлкісі)
Dialogue: 0,0:19:55.90,0:20:00.15,Default,,0,0,0,,Әрине, өйткені басқа адам Карло.
Dialogue: 0,0:20:01.45,0:20:02.15,Default,,0,0,0,,Эй
Dialogue: 0,0:20:02.53,0:20:03.49,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:04.03,0:20:07.12,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:16.42,0:20:17.17,Default,,0,0,0,,Ханым...
Dialogue: 0,0:20:18.55,0:20:20.30,Default,,0,0,0,,Циндао Сіз оны дәл қазір көрдіңіз бе?
Dialogue: 0,0:20:20.42,0:20:22.26,Default,,0,0,0,,А? Не?
Dialogue: 0,0:20:22.38,0:20:24.47,Default,,0,0,0,,Әй, эй, әуре болма.
Dialogue: 0,0:20:24.59,0:20:26.35,Default,,0,0,0,,Мен мұнда сенімдімін...
Dialogue: 0,0:20:31.52,0:20:32.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:33.19,0:20:34.31,Default,,0,0,0,,Голограмма емес
Dialogue: 0,0:20:34.90,0:20:37.52,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:20:38.11,0:20:40.03,Default,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,0:20:40.28,0:20:42.99,Default,,0,0,0,,Гүл... Жоқ, ол сол адам.
Dialogue: 0,0:20:43.11,0:20:44.61,Default,,0,0,0,,Оның әйелі болды.
Dialogue: 0,0:20:44.74,0:20:46.03,Default,,0,0,0,,Не болды, Циндао?
Dialogue: 0,0:20:46.16,0:20:48.41,Default,,0,0,0,,Мен мұнда ештеңе көре алмадым.
Dialogue: 0,0:20:48.53,0:20:49.53,Default,,0,0,0,,Мен елес көрдім...
Dialogue: 0,0:20:49.66,0:20:50.49,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:20:50.62,0:20:52.79,Default,,0,0,0,,Бәрің мені көтеріп барасың ба?
Dialogue: 0,0:20:54.00,0:20:55.92,Default,,0,0,0,,«Менің сүйікті Еваға, сіздің Карлоңызға»
Dialogue: 0,0:20:56.04,0:20:58.09,Default,,0,0,0,,«15 маусым 2005 жыл»
Dialogue: 0,0:20:58.21,0:20:59.29,Default,,0,0,0,,Ева?
Dialogue: 0,0:20:59.42,0:21:02.55,Default,,0,0,0,,Мигель, сіз бір ғасыр бұрын адаммен кездестім дейсіз бе?
Dialogue: 0,0:21:03.26,0:21:06.84,Default,,0,0,0,,Жақсы, суық ұйқыны да қарастыруға болады.
Dialogue: 0,0:21:06.97,0:21:07.72,Default,,0,0,0,,Басқаларды басыңыз
Dialogue: 0,0:21:07.84,0:21:08.80,Default,,0,0,0,,Ол сонда болды.
Dialogue: 0,0:21:08.93,0:21:12.52,Default,,0,0,0,,Ал, елестің SOS жіберуі мүмкін емес.
Dialogue: 0,0:21:12.64,0:21:14.35,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:23.32,0:21:26.36,Default,,0,0,0,,Жарайды, Мигель, уақыт жоқ. Екіге бөлейік.
Dialogue: 0,0:21:26.78,0:21:27.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:27.82,0:21:29.95,Default,,0,0,0,,Сіз елестерден қорқасыз...
Dialogue: 0,0:21:30.08,0:21:32.12,Default,,0,0,0,,Е... у... шулы
Dialogue: 0,0:21:32.54,0:21:33.70,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:21:33.83,0:21:35.91,Default,,0,0,0,,Адамдарды мазақ ету
Dialogue: 0,0:21:51.81,0:21:52.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:54.31,0:21:55.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:07.95,0:22:09.87,Default,,0,0,0,,Циндао SOS?
Dialogue: 0,0:22:10.78,0:22:12.83,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:22:10.78,0:22:12.83,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:12.83,0:22:14.24,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:14.70,0:22:17.75,Default,,0,0,0,,Жоқ... жұмыс істеп тұр.
Dialogue: 0,0:22:17.87,0:22:18.96,Default,,0,0,0,,Ол қозғалады ма?
Dialogue: 0,0:22:19.08,0:22:20.33,Default,,0,0,0,,Сонымен, сен амансың ба?
Dialogue: 0,0:22:20.46,0:22:22.04,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:22:22.92,0:22:25.09,Default,,0,0,0,,Хехе, мен келуім керек.
Dialogue: 0,0:22:25.21,0:22:27.42,Default,,0,0,0,,Келдің бе, келмесең де бәрібір.
Dialogue: 0,0:22:28.09,0:22:29.51,Default,,0,0,0,,(су тамшылары құлаған дыбыс)
Dialogue: 0,0:22:29.63,0:22:30.47,Default,,0,0,0,,Не?
Dialogue: 0,0:22:31.26,0:22:32.97,Default,,0,0,0,,Мені қорқытпа
Dialogue: 0,0:22:34.06,0:22:37.23,Default,,0,0,0,,Бұл кім? Әйелді жылататын адам
Dialogue: 0,0:22:38.27,0:22:40.10,Default,,0,0,0,,Әй, мұнда да.
Dialogue: 0,0:22:40.23,0:22:42.02,Default,,0,0,0,,Шапшаң құрылыс.
Dialogue: 0,0:22:42.15,0:22:43.82,Default,,0,0,0,,Ақшаңыз таусылды ма?
Dialogue: 0,0:22:43.94,0:22:45.03,Default,,0,0,0,,Уау
Dialogue: 0,0:22:46.23,0:22:48.36,Default,,0,0,0,,Жоқ, мен олай ойламаймын...
Dialogue: 0,0:22:48.99,0:22:50.16,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:22:50.28,0:22:53.37,Default,,0,0,0,,Ева ханым ақсүйектің қызы сияқты.
Dialogue: 0,0:22:53.91,0:22:55.83,Default,,0,0,0,,Дворянның қызы...
Dialogue: 0,0:22:58.96,0:23:01.42,Default,,0,0,0,,Бұл біртүрлі талғампаз үй.
Dialogue: 0,0:23:01.54,0:23:02.88,Default,,0,0,0,,Жас кезінен
Dialogue: 0,0:23:03.00,0:23:05.63,Default,,0,0,0,,Данышпан сопрано әнші ретінде көпшіліктің назарында
Dialogue: 0,0:23:05.75,0:23:08.76,Default,,0,0,0,,Оны тіпті «ғасыр дивасы» деп те атаған сияқты.
Dialogue: 0,0:23:09.67,0:23:11.97,Default,,0,0,0,,...Сол уақытта Карло Рамбалди есімді адам...
Dialogue: 0,0:23:12.09,0:23:14.72,Default,,0,0,0,,Мен жұлдызды тенор әншіге ғашық болдым...
Dialogue: 0,0:23:14.85,0:23:16.39,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:23:16.52,0:23:17.89,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:23:18.02,0:23:20.64,Default,,0,0,0,,Себебі Карло менің қасымда.
Dialogue: 0,0:23:20.77,0:23:23.48,Default,,0,0,0,,Онда бұл әйел неге мұнда?
Dialogue: 0,0:23:24.31,0:23:26.44,Default,,0,0,0,,Тіпті осындай фейк жасау
Dialogue: 0,0:23:26.57,0:23:29.03,Default,,0,0,0,,Бірақ бұл соншалықты ұзақ емес сияқты.
Dialogue: 0,0:23:29.15,0:23:31.82,Default,,0,0,0,,Оның дауысы бұзылған сияқты.
Dialogue: 0,0:23:33.41,0:23:36.95,Default,,0,0,0,,Сонда да ол Карло үшін сахнаға шықты
Dialogue: 0,0:23:39.75,0:23:42.21,Default,,0,0,0,,Оның сезімін ешкім түсінбеді
Dialogue: 0,0:23:42.67,0:23:46.38,Default,,0,0,0,,Жоқ, сіз оның орнына сын айттыңыз.
Dialogue: 0,0:23:48.67,0:23:51.22,Default,,0,0,0,,Бағамды өзім шешем.
Dialogue: 0,0:23:51.72,0:23:55.76,Default,,0,0,0,,Басқаша айтқанда, әлем енді оның айналасында айналмайды.
Dialogue: 0,0:23:55.89,0:23:57.06,Default,,0,0,0,,...ал Карло ше?
Dialogue: 0,0:23:57.18,0:24:00.14,Default,,0,0,0,,Жоқ, олай емес. Үйлену...
Dialogue: 0,0:24:00.27,0:24:01.35,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:24:01.48,0:24:02.31,Default,,0,0,0,,Пинг-понг
Dialogue: 0,0:24:02.44,0:24:04.02,Default,,0,0,0,,Бұл да өлтірілді.
Dialogue: 0,0:24:04.15,0:24:05.56,Default,,0,0,0,,Өлтірілді ме? кімге?
Dialogue: 0,0:24:06.11,0:24:09.53,Default,,0,0,0,,Бұл Еваның ынталы жанкүйерінің әрекеті делінеді.
Dialogue: 0,0:24:09.65,0:24:12.15,Default,,0,0,0,,Кінәлінің аты аталмады.
Dialogue: 0,0:24:12.28,0:24:14.57,Default,,0,0,0,,Содан бері ол жұртшылықтың көзінен ғайып болды...
Dialogue: 0,0:24:15.16,0:24:18.03,Default,,0,0,0,,Сонымен, сіз осындай жерде естеліктерге қанық болдыңыз ба?
Dialogue: 0,0:24:18.16,0:24:19.66,Default,,0,0,0,,Бұл сізді жылатпайды ма?
Dialogue: 0,0:24:23.17,0:24:26.13,Default,,0,0,0,,Уф, маған ұнайтын шығар
Dialogue: 0,0:24:33.38,0:24:34.18,Default,,0,0,0,,Не болды?
Dialogue: 0,0:24:34.30,0:24:36.60,Default,,0,0,0,,Магнитизм қайтадан күшейді.
Dialogue: 0,0:24:38.39,0:24:40.56,Default,,0,0,0,,Сіз мұны естідіңіз бе? Оны қазірдің өзінде дөңгелектеңіз
Dialogue: 0,0:24:40.97,0:24:42.73,Default,,0,0,0,,Құтқару жұмыстары тоқтатылды
Dialogue: 0,0:24:42.85,0:24:44.06,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:24:46.15,0:24:48.57,Default,,0,0,0,,Мигель Эй, сен мені естідің бе?
Dialogue: 0,0:24:48.69,0:24:49.57,Default,,0,0,0,,Қайта оралыңыз
Dialogue: 0,0:24:50.94,0:24:52.74,Default,,0,0,0,,Мен орынды қате таптым ба?
Dialogue: 0,0:24:53.07,0:24:55.11,Default,,0,0,0,,Темір сынықтарына толы, солай емес пе?
Dialogue: 0,0:24:59.03,0:25:02.29,Default,,0,0,0,,Мұндай жерде шынымен әйел бар ма?
Dialogue: 0,0:25:05.25,0:25:07.71,Default,,0,0,0,,Оо-а-а-а-а
Dialogue: 0,0:25:09.17,0:25:10.00,Default,,0,0,0,,Уау
Dialogue: 0,0:25:10.13,0:25:11.09,Default,,0,0,0,,Не болды, Мигель?
Dialogue: 0,0:25:11.21,0:25:13.63,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:25:14.67,0:25:16.30,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:25:22.22,0:25:27.98,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:25:28.10,0:25:29.31,Default,,0,0,0,,Дереккөз?
Dialogue: 0,0:25:29.44,0:25:30.94,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:25:31.57,0:25:37.57,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:25:41.16,0:25:43.29,Default,,0,0,0,,Иә? Бір жерде...
Dialogue: 0,0:25:43.66,0:25:49.96,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:25:50.09,0:25:50.92,Default,,0,0,0,,Сол ән...
Dialogue: 0,0:25:51.04,0:25:53.51,Default,,0,0,0,,Мигель, бұл ненің дыбысы?
Dialogue: 0,0:25:55.30,0:25:56.30,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:25:56.42,0:25:58.51,Default,,0,0,0,,Бұл ән бәрібір, SOS.
Dialogue: 0,0:25:59.18,0:26:05.18,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:26:08.60,0:26:13.73,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:26:27.37,0:26:28.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:41.30,0:26:43.10,Default,,0,0,0,,Мен сені жақсы көремін Карло
Dialogue: 0,0:26:43.22,0:26:44.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:45.39,0:26:48.94,Default,,0,0,0,,Мигель, не болды? Мигель
Dialogue: 0,0:26:52.11,0:26:54.27,Default,,0,0,0,,Эй, Мигель, не болды?
Dialogue: 0,0:26:54.40,0:26:56.03,Default,,0,0,0,,Мен жаңа ғана әйел дауысын естідім.
Dialogue: 0,0:26:56.15,0:26:57.99,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,0:26:58.11,0:26:59.70,Default,,0,0,0,,Сәлем Мигель!
Dialogue: 0,0:27:03.58,0:27:04.87,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:27:04.87,0:27:06.12,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:27:04.87,0:27:06.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:06.12,0:27:10.58,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:27:20.97,0:27:22.89,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:27:23.89,0:27:25.01,Default,,0,0,0,,Ха…
Dialogue: 0,0:27:25.97,0:27:27.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:30.10,0:27:31.31,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:27:32.48,0:27:34.77,Default,,0,0,0,,Эй, сен...
Dialogue: 0,0:27:38.49,0:27:39.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:40.82,0:27:42.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:50.21,0:27:51.62,Default,,0,0,0,,(Эмилидің күлкісі)
Dialogue: 0,0:27:51.75,0:27:54.08,Default,,0,0,0,,Сіз біршама өстіңіз, Эмили.
Dialogue: 0,0:27:54.21,0:27:57.55,Default,,0,0,0,,Әке, мен де солай айта беремін.
Dialogue: 0,0:27:59.13,0:28:01.22,Default,,0,0,0,,Эй, мен оны осы жерден аша аламын ба?
Dialogue: 0,0:28:01.34,0:28:04.43,Default,,0,0,0,,Эхехехе-Бұл не?
Dialogue: 0,0:28:05.85,0:28:06.51,Default,,0,0,0,,Ах
Dialogue: 0,0:28:07.01,0:28:10.39,Default,,0,0,0,,Уау, бұл таңғажайып ғарыштық костюм.
Dialogue: 0,0:28:11.52,0:28:14.15,Default,,0,0,0,,Эмили, мен мұны қалаймын.
Dialogue: 0,0:28:14.52,0:28:16.31,Default,,0,0,0,,Қараңызшы, әке, бұл тамаша.
Dialogue: 0,0:28:16.44,0:28:18.53,Default,,0,0,0,,Эмили ғарышқа да бара ала ма?
Dialogue: 0,0:28:18.65,0:28:20.11,Default,,0,0,0,,О, мен кете аламын.
Dialogue: 0,0:28:20.24,0:28:20.94,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:28:21.49,0:28:22.82,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,0:28:23.41,0:28:24.07,Default,,0,0,0,,Хехе
Dialogue: 0,0:28:24.20,0:28:25.53,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:28:25.66,0:28:27.53,Default,,0,0,0,,Хахахаха хехехе
Dialogue: 0,0:28:28.45,0:28:30.16,Default,,0,0,0,,Мен сізді жақсы көремін әке
Dialogue: 0,0:28:30.70,0:28:31.25,Default,,0,0,0,,Шак
Dialogue: 0,0:28:31.37,0:28:34.83,Default,,0,0,0,,(Гайнц Эмилидің күлкісі)
Dialogue: 0,0:28:34.96,0:28:36.84,Default,,0,0,0,,Аа, дұрыс, әке.
Dialogue: 0,0:28:36.96,0:28:39.30,Default,,0,0,0,,Зымыран айналуды тоқтатты.
Dialogue: 0,0:28:39.42,0:28:40.34,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:28:40.46,0:28:43.05,Default,,0,0,0,,Зымыранға келсек, әкенің кезегі.
Dialogue: 0,0:28:44.38,0:28:45.55,Default,,0,0,0,,Хехехе
Dialogue: 0,0:28:45.68,0:28:47.26,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,0:28:47.60,0:28:49.72,Default,,0,0,0,,Әкем мені алып кетемін деді.
Dialogue: 0,0:28:49.85,0:28:53.85,Default,,0,0,0,,Хэхе, Эмили, сен тамақтанып болған соң сөйлесейік.
Dialogue: 0,0:28:53.98,0:28:56.31,Default,,0,0,0,,Өйткені... Ухухуху
Dialogue: 0,0:28:58.73,0:29:01.07,Default,,0,0,0,,Бұл одан да маңыздырақ, солай емес пе?
Dialogue: 0,0:29:01.19,0:29:02.32,Default,,0,0,0,,Ол ластанып қалады.
Dialogue: 0,0:29:02.53,0:29:05.03,Default,,0,0,0,,Себебі мен сені сонда апаруым керек.
Dialogue: 0,0:29:05.16,0:29:06.07,Default,,0,0,0,,Сәлем әке
Dialogue: 0,0:29:06.87,0:29:08.20,Default,,0,0,0,,Иә...
Dialogue: 0,0:29:08.78,0:29:11.70,Default,,0,0,0,,Эмили, сен әкеңді ұятқа қалдыра алмайсың.
Dialogue: 0,0:29:12.25,0:29:13.71,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:29:13.83,0:29:14.91,Default,,0,0,0,,Бірақ
Dialogue: 0,0:29:15.04,0:29:19.00,Default,,0,0,0,,Эмили, мен әкеммен көбірек уақыт өткізгім келеді.
Dialogue: 0,0:29:20.04,0:29:22.09,Default,,0,0,0,,Бұл рас, Эмили.
Dialogue: 0,0:29:22.21,0:29:24.76,Default,,0,0,0,,Мен сенің үнемі үйде болғаныңды қалаймын.
Dialogue: 0,0:29:25.18,0:29:26.51,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:29:32.81,0:29:34.10,Default,,0,0,0,,Әй, анашым, маған варенье алып келші.
Dialogue: 0,0:29:34.23,0:29:37.19,Default,,0,0,0,,Ах~ Эмили, тек қияр қалдыр.
Dialogue: 0,0:29:37.31,0:29:38.65,Default,,0,0,0,,Өйткені мен қиярды жек көремін.
Dialogue: 0,0:29:38.77,0:29:41.40,Default,,0,0,0,,Таңдап алатын бала ғарышқа бара алмайды.
Dialogue: 0,0:29:41.52,0:29:42.78,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:29:42.90,0:29:43.78,Default,,0,0,0,,Ах
Dialogue: 0,0:29:43.90,0:29:45.90,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:29:46.28,0:29:47.41,Default,,0,0,0,,Ха…
Dialogue: 0,0:29:47.74,0:29:49.16,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:29:50.74,0:29:52.66,Default,,0,0,0,,Ешқайда кетпеңіз
Dialogue: 0,0:29:53.95,0:29:55.04,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:29:56.25,0:29:57.71,Default,,0,0,0,,Уф уау
Dialogue: 0,0:29:57.83,0:29:59.88,Default,,0,0,0,,Хе... Уау...
Dialogue: 0,0:30:02.84,0:30:05.22,Default,,0,0,0,,Сіз мені тыңдай аласыз ба, Хайнц, маған жауап беріңізші?
Dialogue: 0,0:30:05.67,0:30:06.63,Default,,0,0,0,,Эй!
Dialogue: 0,0:30:07.30,0:30:10.93,Default,,0,0,0,,Не? Не болды? Не болып жатыр?
Dialogue: 0,0:30:14.10,0:30:14.89,Default,,0,0,0,,Эмили...
Dialogue: 0,0:30:15.35,0:30:17.89,Default,,0,0,0,,Хайнц, сен мені естисің бе?
Dialogue: 0,0:30:18.52,0:30:20.56,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:30:20.69,0:30:21.94,Default,,0,0,0,,Не болды?
Dialogue: 0,0:30:22.07,0:30:24.36,Default,,0,0,0,,30 минут бойы жауап болмады.
Dialogue: 0,0:30:26.82,0:30:28.86,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:30:29.16,0:30:31.07,Default,,0,0,0,,Ал мына қуыршақтар қандай?
Dialogue: 0,0:30:32.08,0:30:33.33,Default,,0,0,0,,А... Мен де білмеймін.
Dialogue: 0,0:30:35.45,0:30:37.83,Default,,0,0,0,,Білмеймін, бірақ тепкіге дайындал.
Dialogue: 0,0:30:44.00,0:30:46.26,Default,,0,0,0,,Ха... Қарғыс атсын.
Dialogue: 0,0:30:46.38,0:30:48.30,Default,,0,0,0,,Мигель жақсы ма?
Dialogue: 0,0:30:48.68,0:30:51.09,Default,,0,0,0,,Бұл сызық.
Dialogue: 0,0:30:51.34,0:30:53.05,Default,,0,0,0,,Магнитизм керемет.
Dialogue: 0,0:30:53.64,0:30:55.39,Default,,0,0,0,,Жарайды, тезірек аяқтайық.
Dialogue: 0,0:30:55.97,0:30:57.89,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:30:58.10,0:31:00.48,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:31:00.60,0:31:02.65,Default,,0,0,0,,Магнитизм мөлшері нормадан тыс.
Dialogue: 0,0:31:05.82,0:31:08.36,Default,,0,0,0,,Балалар сендер не істедіңдер?
Dialogue: 0,0:31:09.36,0:31:11.57,Default,,0,0,0,,Ой... Бастық, бұл жаман.
Dialogue: 0,0:31:21.21,0:31:22.83,Default,,0,0,0,,Не болды, Ева?
Dialogue: 0,0:31:22.96,0:31:25.42,Default,,0,0,0,,Карло бір жерге бара жатқан сияқты...
Dialogue: 0,0:31:25.59,0:31:27.88,Default,,0,0,0,,Иә, боқ, не айтып тұрсың?
Dialogue: 0,0:31:28.01,0:31:29.84,Default,,0,0,0,,Мигель біраз уақыттан бері осылай болды.
Dialogue: 0,0:31:29.97,0:31:31.30,Default,,0,0,0,,Ева сонда болды ма?
Dialogue: 0,0:31:31.43,0:31:32.59,Default,,0,0,0,,Хайнц!
Dialogue: 0,0:31:33.47,0:31:35.39,Default,,0,0,0,,Ух... періштелер бар.
Dialogue: 0,0:31:35.51,0:31:38.22,Default,,0,0,0,,Мен мәңгі жаныңда боламын, Ева.
Dialogue: 0,0:31:38.35,0:31:39.06,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:31:39.06,0:31:39.64,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:31:39.06,0:31:39.64,Default,,0,0,0,,Уау...
Dialogue: 0,0:31:39.64,0:31:40.94,Default,,0,0,0,,Уау...
Dialogue: 0,0:31:41.69,0:31:43.06,Default,,0,0,0,,О
Dialogue: 0,0:31:43.52,0:31:45.19,Default,,0,0,0,,Біз мәңгі бірге боламыз
Dialogue: 0,0:31:45.52,0:31:48.03,Default,,0,0,0,,Қарғыс атсын, анау жұмсақ бейбақ.
Dialogue: 0,0:31:48.15,0:31:48.94,Default,,0,0,0,,Уау
Dialogue: 0,0:31:49.07,0:31:51.15,Default,,0,0,0,,Мен қуаныштымын, Карло.
Dialogue: 0,0:31:51.28,0:31:54.87,Default,,0,0,0,,Ева, менің өмірім сенікі
Dialogue: 0,0:31:55.74,0:31:56.83,Default,,0,0,0,,Дааааа
Dialogue: 0,0:31:57.24,0:31:58.95,Default,,0,0,0,,Әлгі бейбақ!
Dialogue: 0,0:32:01.08,0:32:02.50,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:32:02.79,0:32:04.75,Default,,0,0,0,,Мен қуаныштымын, Карло.
Dialogue: 0,0:32:04.92,0:32:08.13,Default,,0,0,0,,Осы арқылы мен қайсысының SOS екенін айта алмаймын.
Dialogue: 0,0:32:11.80,0:32:13.01,Default,,0,0,0,,Мигель
Dialogue: 0,0:32:16.22,0:32:17.31,Default,,0,0,0,,Мигель қайда?
Dialogue: 0,0:32:24.73,0:32:26.11,Default,,0,0,0,,Мигель…
Dialogue: 0,0:32:26.23,0:32:28.27,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:32:28.40,0:32:29.86,Default,,0,0,0,,Кел, кел, Ева.
Dialogue: 0,0:32:29.98,0:32:30.99,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:32:31.24,0:32:33.49,Default,,0,0,0,,Осы раушан гүлдей бергенше
Dialogue: 0,0:32:33.70,0:32:35.99,Default,,0,0,0,,Мигель! Шіркін, мен мүлдем ашуландым
Dialogue: 0,0:32:38.33,0:32:40.83,Default,,0,0,0,,Мигель, қайт, Мигель.
Dialogue: 0,0:32:42.16,0:32:43.33,Default,,0,0,0,,Уау
Dialogue: 0,0:32:43.75,0:32:44.58,Default,,0,0,0,,Мигель!
Dialogue: 0,0:32:44.71,0:32:45.29,Default,,0,0,0,,Не болды?
Dialogue: 0,0:32:45.71,0:32:46.96,Default,,0,0,0,,Хайнц, жауап бер.
Dialogue: 0,0:32:47.42,0:32:49.21,Default,,0,0,0,,Хайнц, сен мені естисің бе?
Dialogue: 0,0:32:50.00,0:32:51.88,Default,,0,0,0,,Бастық Мынаны қараңыз
Dialogue: 0,0:32:56.64,0:32:57.47,Default,,0,0,0,,О...
Dialogue: 0,0:32:58.14,0:33:00.22,Default,,0,0,0,,Бұршақ жейді
Dialogue: 0,0:33:00.97,0:33:02.93,Default,,0,0,0,,Ол керемет дәмхана.
Dialogue: 0,0:33:03.06,0:33:03.98,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:33:05.60,0:33:06.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:08.11,0:33:09.77,Default,,0,0,0,,Не болды, не болды?
Dialogue: 0,0:33:09.90,0:33:10.98,Default,,0,0,0,,Flotsam...
Dialogue: 0,0:33:11.11,0:33:13.03,Default,,0,0,0,,Жоқ, Корона да бір нәрсе...
Dialogue: 0,0:33:13.44,0:33:15.20,Default,,0,0,0,,Мен оған тартылдым.
Dialogue: 0,0:33:15.86,0:33:17.74,Default,,0,0,0,,Қарғыс атсын... Хайнц!
Dialogue: 0,0:33:17.87,0:33:19.83,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,0:33:20.08,0:33:21.41,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:33:24.79,0:33:25.96,Default,,0,0,0,,Мигель!
Dialogue: 0,0:33:26.08,0:33:27.63,Default,,0,0,0,,Уау
Dialogue: 0,0:33:29.63,0:33:31.05,Default,,0,0,0,,Мигель, барма.
Dialogue: 0,0:33:31.17,0:33:32.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:32.71,0:33:34.09,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:33:36.93,0:33:39.05,Default,,0,0,0,,Қарғыс атсын, тоқтат!
Dialogue: 0,0:33:44.48,0:33:46.39,Default,,0,0,0,,Мигель Бұл нақты емес.
Dialogue: 0,0:33:46.52,0:33:48.98,Default,,0,0,0,,Уау, уф… уф…
Dialogue: 0,0:33:52.40,0:33:54.28,Default,,0,0,0,,Түсінбейсің бе, Мигель?
Dialogue: 0,0:33:54.40,0:33:56.15,Default,,0,0,0,,Бұл оның естелігі
Dialogue: 0,0:33:56.49,0:34:03.16,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:34:09.33,0:34:10.59,Default,,0,0,0,,Мигель
Dialogue: 0,0:34:12.25,0:34:13.63,Default,,0,0,0,,Мигель!
Dialogue: 0,0:34:19.89,0:34:21.89,Default,,0,0,0,,Неге мені мазалайсың?
Dialogue: 0,0:34:28.64,0:34:29.27,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:34:29.48,0:34:30.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:33.48,0:34:36.19,Default,,0,0,0,,Карло мәңгі өмір сүреді
Dialogue: 0,0:34:36.32,0:34:39.11,Default,,0,0,0,,Менің естеліктерімде
Dialogue: 0,0:34:39.41,0:34:40.53,Default,,0,0,0,,Не?
Dialogue: 0,0:34:40.66,0:34:43.28,Default,,0,0,0,,Түсіну керек.
Dialogue: 0,0:34:44.12,0:34:46.83,Default,,0,0,0,,А... мұндай алдау ма?
Dialogue: 0,0:34:46.95,0:34:49.04,Default,,0,0,0,,Неліктен шындықты қабылдамайсың?
Dialogue: 0,0:34:50.12,0:34:51.42,Default,,0,0,0,,Карло қайтыс болды
Dialogue: 0,0:34:52.29,0:34:54.80,Default,,0,0,0,,Хэхехехехе...
Dialogue: 0,0:34:54.92,0:34:57.17,Default,,0,0,0,,Ахахха...
Dialogue: 0,0:34:59.51,0:35:03.35,Default,,0,0,0,,Мен Карлоны мәңгілікке жараттым.
Dialogue: 0,0:35:04.10,0:35:05.14,Default,,0,0,0,,Сіз?
Dialogue: 0,0:35:05.26,0:35:09.73,Default,,0,0,0,,Егер бұл менің естеліктерімде болса, ол адам өз ойын өзгертпейді.
Dialogue: 0,0:35:11.27,0:35:12.40,Default,,0,0,0,,Сіз...
Dialogue: 0,0:35:13.31,0:35:14.40,Default,,0,0,0,,Сен оны өлтірдің бе?
Dialogue: 0,0:35:15.11,0:35:17.49,Default,,0,0,0,,Фуфуфуфуфухуху…
Dialogue: 0,0:35:18.53,0:35:21.28,Default,,0,0,0,,Бірақ шындық қаншалықты?
Dialogue: 0,0:35:21.57,0:35:22.28,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:35:22.78,0:35:24.37,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:35:25.37,0:35:26.87,Default,,0,0,0,,Мен саған көрсетемін
Dialogue: 0,0:35:27.25,0:35:29.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:35:30.71,0:35:34.00,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:35:37.71,0:35:39.63,Default,,0,0,0,,Гррр...
Dialogue: 0,0:35:39.76,0:35:40.38,Default,,0,0,0,,Ах
Dialogue: 0,0:35:48.52,0:35:49.73,Default,,0,0,0,,Бұл...
Dialogue: 0,0:35:50.31,0:35:52.44,Default,,0,0,0,,(Адам) Мен айтып алмай тұра алмаймын, Әке
Dialogue: 0,0:35:53.27,0:35:55.65,Default,,0,0,0,,Енді Эмили бізбен бірге жүре алады, солай ма?
Dialogue: 0,0:35:55.82,0:35:57.11,Default,,0,0,0,,Жоқ, Эмили.
Dialogue: 0,0:35:57.23,0:35:58.44,Default,,0,0,0,,Өткенге… электрондық хат па?
Dialogue: 0,0:36:01.36,0:36:03.07,Default,,0,0,0,,А... келме.
Dialogue: 0,0:36:04.66,0:36:07.95,Default,,0,0,0,,Уау, әке!
Dialogue: 0,0:36:08.45,0:36:10.62,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:36:10.87,0:36:12.42,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:36:12.54,0:36:14.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:36:21.38,0:36:22.88,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:36:57.84,0:36:58.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:37:00.96,0:37:02.97,Default,,0,0,0,,Әке, қош келдіңіз
Dialogue: 0,0:37:05.43,0:37:08.80,Default,,0,0,0,,Эй, сен Эмилиге кәдесый сатып алдың ба?
Dialogue: 0,0:37:08.93,0:37:12.98,Default,,0,0,0,,Эй Эмили, мен әрқашан жақсы қыз болдым және сені күттім.
Dialogue: 0,0:37:15.14,0:37:16.73,Default,,0,0,0,,Эмили
Dialogue: 0,0:37:18.86,0:37:20.19,Default,,0,0,0,,Жақсы
Dialogue: 0,0:37:20.94,0:37:22.78,Default,,0,0,0,,Ол тірі болды.
Dialogue: 0,0:37:23.69,0:37:26.11,Default,,0,0,0,,Әке, ауырып тұр
Dialogue: 0,0:37:27.78,0:37:29.91,Default,,0,0,0,,Ах... Кешіріңіз, Эмили.
Dialogue: 0,0:37:31.29,0:37:33.91,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:37:37.50,0:37:38.63,Default,,0,0,0,,Әй, әке, тезірек.
Dialogue: 0,0:37:38.75,0:37:40.46,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:37:40.63,0:37:42.96,Default,,0,0,0,,Тез үйге кел.
Dialogue: 0,0:37:43.09,0:37:44.42,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:37:44.55,0:37:47.01,Default,,0,0,0,,Уфуфуфу эй кола кола
Dialogue: 0,0:37:48.30,0:37:50.64,Default,,0,0,0,,Әке, біз әрқашан бірге боламыз, солай ма?
Dialogue: 0,0:37:50.76,0:37:51.76,Default,,0,0,0,,Хехехе
Dialogue: 0,0:37:52.10,0:37:56.52,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:38:17.67,0:38:21.54,Default,,0,0,0,,Ха... а... а...
Dialogue: 0,0:38:26.05,0:38:27.30,Default,,0,0,0,,Эмили
Dialogue: 0,0:38:30.34,0:38:31.93,Default,,0,0,0,,Эмили!
Dialogue: 0,0:38:32.76,0:38:34.02,Default,,0,0,0,,Эмили
Dialogue: 0,0:38:36.10,0:38:37.60,Default,,0,0,0,,Эмили
Dialogue: 0,0:38:41.27,0:38:42.73,Default,,0,0,0,,Эмили
Dialogue: 0,0:38:45.78,0:38:48.07,Default,,0,0,0,,Егер Эмили болса, мен осында болар едім.
Dialogue: 0,0:38:49.28,0:38:50.87,Default,,0,0,0,,Эмили...
Dialogue: 0,0:38:54.79,0:38:56.37,Default,,0,0,0,,Эмили...
Dialogue: 0,0:39:02.79,0:39:06.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:06.42,0:39:07.80,Default,,0,0,0,,Эмили...
Dialogue: 0,0:39:14.51,0:39:15.97,Default,,0,0,0,,Естеліктер бұл...
Dialogue: 0,0:39:16.77,0:39:20.81,Default,,0,0,0,,Естеліктер қашатын жер емес
Dialogue: 0,0:39:42.04,0:39:42.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:44.25,0:39:46.67,Default,,0,0,0,,Циндао анализатор зеңбірегін атқылай аласыз ба?
Dialogue: 0,0:39:47.17,0:39:47.88,Default,,0,0,0,,Е...
Dialogue: 0,0:39:48.01,0:39:50.17,Default,,0,0,0,,Жақсы, бұл әрқашан жақсы.
Dialogue: 0,0:39:50.47,0:39:52.64,Default,,0,0,0,,Ішінде әлі екі адам бар...
Dialogue: 0,0:39:53.26,0:39:55.64,Default,,0,0,0,,Осы қарқынмен біз бәрібір жойыламыз.
Dialogue: 0,0:39:55.85,0:39:58.56,Default,,0,0,0,,Аошиманы орталық ауа тығынына соғыңыз.
Dialogue: 0,0:39:58.68,0:40:00.98,Default,,0,0,0,,Экранда координаттарды көрсету
Dialogue: 0,0:40:01.89,0:40:06.57,Default,,0,0,0,,♪〜
Dialogue: 0,0:40:06.69,0:40:07.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:40:22.04,0:40:23.83,Default,,0,0,0,,Компьютер…
Dialogue: 0,0:40:25.04,0:40:26.54,Default,,0,0,0,,Жынды болу
Dialogue: 0,0:40:38.51,0:40:39.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:50.94,0:40:53.03,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:40:55.03,0:40:57.78,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:41:04.67,0:41:05.67,Default,,0,0,0,,Чикишо
Dialogue: 0,0:41:05.79,0:41:08.38,Default,,0,0,0,,Өлсең де қоқыс жәшігінде боласың ғой.
Dialogue: 0,0:41:11.59,0:41:14.09,Default,,0,0,0,,Хе... сенің қалағаның осы емес пе?
Dialogue: 0,0:41:14.55,0:41:16.22,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:41:16.34,0:41:16.93,Default,,0,0,0,,Уау
Dialogue: 0,0:41:19.56,0:41:22.43,Default,,0,0,0,,Ух... Хайнц, мені кешірші.
Dialogue: 0,0:41:35.70,0:41:37.03,Default,,0,0,0,,Уау
Dialogue: 0,0:41:37.66,0:41:38.66,Default,,0,0,0,,Гррр…
Dialogue: 0,0:41:49.67,0:41:52.59,Default,,0,0,0,,Ууууууууууууууууууууууууу...
Dialogue: 0,0:41:55.67,0:41:57.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:01.06,0:42:04.52,Default,,0,0,0,,Шүкір, мына жігіттер де... Уау.
Dialogue: 0,0:42:09.48,0:42:11.65,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:42:12.82,0:42:16.65,Default,,0,0,0,,Уау Уау Уау...
Dialogue: 0,0:42:34.42,0:42:40.43,Default,,0,0,0,,〜♪
Dialogue: 0,0:42:40.59,0:42:47.60,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:43:00.95,0:43:02.32,Default,,0,0,0,,Қайырлы таң Ева
Dialogue: 0,0:43:02.45,0:43:04.62,Default,,0,0,0,,Қайырлы таң Карло
Dialogue: 0,0:43:04.74,0:43:06.83,Default,,0,0,0,,Бүгін одан да әдемі.
Dialogue: 0,0:43:08.12,0:43:10.62,Default,,0,0,0,,Раушан гүлдері? Немесе...
Dialogue: 0,0:43:10.75,0:43:13.46,Default,,0,0,0,,Әрине сен, Ева.
Dialogue: 0,0:43:14.34,0:43:16.59,Default,,0,0,0,,Биыл да әдемі гүлдеді.
Dialogue: 0,0:43:18.42,0:43:22.60,Default,,0,0,0,,Бұл балалар қазір шыңында.
Dialogue: 0,0:43:23.51,0:43:24.39,Default,,0,0,0,,Мен раушан гүлін көргенде
Dialogue: 0,0:43:25.39,0:43:27.35,Default,,0,0,0,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:43:27.47,0:43:30.69,Default,,0,0,0,,Ал, сіз бірдеңені ұмытып жатырсыз ба?
Dialogue: 0,0:43:32.02,0:43:35.82,Default,,0,0,0,,Мен әрқашан сені ойлаймын
Dialogue: 0,0:44:30.29,0:44:31.79,Default,,0,0,0,,Аа...
Dialogue: 0,0:44:42.42,0:44:48.43,Default,,0,0,0,,(теледидар бағдарламасының тақырыптық әні)
Dialogue: 0,0:45:00.19,0:45:01.57,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:45:01.65,0:45:02.32,Default,,0,0,0,,Кеше түнде Яманаши префектурасында қар жауды.
Dialogue: 0,0:45:02.32,0:45:03.90,Default,,0,0,0,,Кеше түнде Яманаши префектурасында қар жауды.
Dialogue: 0,0:45:02.32,0:45:03.90,Default,,0,0,0,,Танака мырза Нобуо Танака мырза
Dialogue: 0,0:45:03.90,0:45:04.03,Default,,0,0,0,,Танака мырза Нобуо Танака мырза
Dialogue: 0,0:45:04.03,0:45:04.28,Default,,0,0,0,,Танака мырза Нобуо Танака мырза
Dialogue: 0,0:45:04.03,0:45:04.28,Default,,0,0,0,,Толық көтерілу
Dialogue: 0,0:45:04.28,0:45:04.41,Default,,0,0,0,,Толық көтерілу
Dialogue: 0,0:45:04.41,0:45:05.20,Default,,0,0,0,,Толық көтерілу
Dialogue: 0,0:45:04.41,0:45:05.20,Default,,0,0,0,,(Баланың жылауы)
Dialogue: 0,0:45:05.32,0:45:07.07,Default,,0,0,0,,Фукуда мырза, қараңызшы, бұл жер бос.
Dialogue: 0,0:45:05.32,0:45:07.07,Default,,0,0,0,,Бүгін таңертең әдемі ашық күн.
Dialogue: 0,0:45:07.53,0:45:10.12,Default,,0,0,0,,Неге, әже, сіз де бүгін келесіз бе?
Dialogue: 0,0:45:10.24,0:45:14.08,Default,,0,0,0,,(Күту залындағы шу)
Dialogue: 0,0:45:16.50,0:45:19.17,Default,,0,0,0,,Биылғы суық өте қатты.
Dialogue: 0,0:45:19.29,0:45:21.46,Default,,0,0,0,,Ах… Уф…
Dialogue: 0,0:45:21.96,0:45:24.84,Default,,0,0,0,,Асқынулардан сақ болу керек.
Dialogue: 0,0:45:25.34,0:45:28.05,Default,,0,0,0,,Менің ойымша, инъекция сізді жақсы сезінеді.
Dialogue: 0,0:45:28.18,0:45:31.64,Default,,0,0,0,,Әйтеуір бір апталық дәрі беремін.
Dialogue: 0,0:45:31.77,0:45:33.27,Default,,0,0,0,,Иә... Иә...
Dialogue: 0,0:45:33.39,0:45:35.69,Default,,0,0,0,,Келесі адам, Кавасаки мырза
Dialogue: 0,0:45:35.69,0:45:35.94,Default,,0,0,0,,Келесі адам, Кавасаки мырза
Dialogue: 0,0:45:35.69,0:45:35.94,Default,,0,0,0,,Иә
Dialogue: 0,0:45:35.94,0:45:36.06,Default,,0,0,0,,Иә
Dialogue: 0,0:45:36.06,0:45:36.65,Default,,0,0,0,,Иә
Dialogue: 0,0:45:36.06,0:45:36.65,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:45:36.65,0:45:37.69,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:45:37.81,0:45:39.52,Default,,0,0,0,,Иә, абайлаңыз
Dialogue: 0,0:45:39.65,0:45:40.44,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:45:41.02,0:45:42.03,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:45:42.15,0:45:43.65,Default,,0,0,0,,О, не болды?
Dialogue: 0,0:45:43.78,0:45:46.36,Default,,0,0,0,,Міне, мен суық тиіп қалдым.
Dialogue: 0,0:45:47.28,0:45:48.87,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:46:03.26,0:46:04.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:46:04.67,0:46:07.34,Default,,0,0,0,,Бұл шынымен тиімді ме?
Dialogue: 0,0:46:08.09,0:46:14.10,Default,,0,0,0,,♪〜
Dialogue: 0,0:46:58.23,0:47:01.10,Default,,0,0,0,,О, Танака-сан, жақсысың ба?
Dialogue: 0,0:47:01.23,0:47:03.27,Default,,0,0,0,,А, менде әлі де қызу бар.
Dialogue: 0,0:47:03.40,0:47:05.11,Default,,0,0,0,,Жалғыз ұйықтасам да
Dialogue: 0,0:47:05.23,0:47:08.11,Default,,0,0,0,,Маған қарайтын қыз жоқ сияқты.
Dialogue: 0,0:47:08.24,0:47:09.57,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:47:18.21,0:47:23.17,Default,,0,0,0,,〜♪
Dialogue: 0,0:47:23.17,0:47:24.21,Default,,0,0,0,,〜♪
Dialogue: 0,0:47:27.51,0:47:28.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:29.93,0:47:30.97,Default,,0,0,0,,(Мұрынды шұқылау дыбысы)
Dialogue: 0,0:47:31.09,0:47:34.47,Default,,0,0,0,,Nobuo Бактерияға қарсы дабыл өшейін деп жатыр.
Dialogue: 0,0:47:34.60,0:47:37.85,Default,,0,0,0,,Мен ауруханада укол алдым.
Dialogue: 0,0:47:37.98,0:47:38.77,Default,,0,0,0,,Иә.
Dialogue: 0,0:47:38.89,0:47:41.81,Default,,0,0,0,,Әр компания ұсынатын суыққа қарсы дәрілерді бақылап отырсақ ше?
Dialogue: 0,0:47:41.94,0:47:43.65,Default,,0,0,0,,Егер сауығып кетсеңіз, бір оқпен екі құсты өлтіруге болады.
Dialogue: 0,0:47:43.77,0:47:45.23,Default,,0,0,0,,Олай болса, сіз мұны істеп қойғансыз.
Dialogue: 0,0:47:47.15,0:47:50.45,Default,,0,0,0,,Келесі жолы біз беретін қызуды басатын дәріні қолданып көріңіз.
Dialogue: 0,0:47:50.57,0:47:52.74,Default,,0,0,0,,Директордың орнында реактивтер болды.
Dialogue: 0,0:47:52.86,0:47:55.03,Default,,0,0,0,,Ол коммерциялық мақсатта сұйылтылмағандықтан тиімді емес пе?
Dialogue: 0,0:47:55.16,0:47:58.91,Default,,0,0,0,,А, бұл қызыл қораптағы көк капсула.
Dialogue: 0,0:47:59.04,0:48:00.71,Default,,0,0,0,,Екі ішсең, бір оқтайсың.
Dialogue: 0,0:48:02.54,0:48:03.50,Default,,0,0,0,,(Мұрынды шұқылау дыбысы)
Dialogue: 0,0:48:08.26,0:48:12.30,Default,,0,0,0,,Анықтама бөлмесіндегі Окамура мырзаның сыртқы сызығы бар.
Dialogue: 0,0:48:12.43,0:48:16.31,Default,,0,0,0,,Жақын телефондағы 3 нөмірін алыңыз.
Dialogue: 0,0:48:21.10,0:48:24.81,Default,,0,0,0,,Кешіріңіз, директор, бұл құжат...
Dialogue: 0,0:48:24.94,0:48:25.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:27.27,0:48:29.48,Default,,0,0,0,,Не, сен жоқсың ба?
Dialogue: 0,0:48:31.78,0:48:33.53,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:48:40.45,0:48:41.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:43.54,0:48:47.59,Default,,0,0,0,,Көк қапшықтағы қызыл капсула?
Dialogue: 0,0:48:48.42,0:48:50.05,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:48:53.93,0:48:56.80,Default,,0,0,0,,Көк жағдайда...
Dialogue: 0,0:48:58.47,0:49:00.68,Default,,0,0,0,,Қызыл капсула...
Dialogue: 0,0:49:11.94,0:49:14.11,Default,,0,0,0,,Мен оны бір дәнге дейін сақтауым керек пе?
Dialogue: 0,0:49:16.37,0:49:19.24,Default,,0,0,0,,Усо~ Керемет, Мики
Dialogue: 0,0:49:19.58,0:49:20.58,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:49:20.70,0:49:22.54,Default,,0,0,0,,Мен мұны істеу уақыты келгенде жасаймын.
Dialogue: 0,0:49:22.66,0:49:24.50,Default,,0,0,0,,Әй, жақсы.
Dialogue: 0,0:49:24.62,0:49:26.63,Default,,0,0,0,,Сакико да келуі керек еді.
Dialogue: 0,0:49:26.75,0:49:28.63,Default,,0,0,0,,Бұл ең жақсы болды
Dialogue: 0,0:49:28.75,0:49:29.75,Default,,0,0,0,,А...
Dialogue: 0,0:49:31.42,0:49:32.76,Default,,0,0,0,,О? (Мики) Иә?
Dialogue: 0,0:49:32.88,0:49:33.84,Default,,0,0,0,,Бұл иіс туралы бірдеңе
Dialogue: 0,0:49:33.97,0:49:36.05,Default,,0,0,0,,（）
Dialogue: 0,0:49:36.18,0:49:37.47,Default,,0,0,0,,Аа, шынымен.
Dialogue: 0,0:49:37.59,0:49:39.64,Default,,0,0,0,,Бірдеңе жеп жатыр ма деп ойлаймын.
Dialogue: 0,0:49:39.76,0:49:41.06,Default,,0,0,0,,Қандай қатыгез қимыл…
Dialogue: 0,0:49:41.18,0:49:43.14,Default,,0,0,0,,Бір нәрсенің иісі жақсы.
Dialogue: 0,0:49:43.60,0:49:46.19,Default,,0,0,0,,Иә, парфюмерия сияқты...
Dialogue: 0,0:49:46.31,0:49:46.94,Default,,0,0,0,,（）
Dialogue: 0,0:49:48.27,0:49:50.36,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:49:50.73,0:49:51.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:51.82,0:49:54.15,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:49:54.44,0:49:58.57,Default,,0,0,0,,Жоқ... бұл кім? Біреу қызыл капсулаға қолын тигізді.
Dialogue: 0,0:49:58.70,0:50:00.74,Default,,0,0,0,,Менің бөлмеме кім келді?
Dialogue: 0,0:50:00.87,0:50:01.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:02.58,0:50:04.71,Default,,0,0,0,,Нобуо жаңа ғана айтты...
Dialogue: 0,0:50:04.83,0:50:08.17,Default,,0,0,0,,Нобуо Танака сізге жаңа дәрінің үлгісін берді...
Dialogue: 0,0:50:08.29,0:50:09.38,Default,,0,0,0,,Не!
Dialogue: 0,0:50:09.67,0:50:10.29,Default,,0,0,0,,Уау
Dialogue: 0,0:50:10.46,0:50:12.21,Default,,0,0,0,,Мм... Танака қайда?
Dialogue: 0,0:50:13.00,0:50:14.97,Default,,0,0,0,,Мен біраз бұрын сонда болдым.
Dialogue: 0,0:50:15.09,0:50:16.76,Default,,0,0,0,,Сонда сен қайда бардың?
Dialogue: 0,0:50:17.13,0:50:19.72,Default,,0,0,0,,Жарайды... Меніңше, сен үйге кетіп қалдың.
Dialogue: 0,0:50:19.93,0:50:22.72,Default,,0,0,0,,Ка... Какака... қайтып келдім дейсіз бе?
Dialogue: 0,0:50:22.85,0:50:23.97,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,0:50:24.10,0:50:25.81,Default,,0,0,0,,Неге үйге бардың, ақымақ?
Dialogue: 0,0:50:25.93,0:50:27.81,Default,,0,0,0,,Бұл сіздің жауапкершілігіңіз. Біз не істеуіміз керек?
Dialogue: 0,0:50:27.94,0:50:31.31,Default,,0,0,0,,Директор: Танака-кун, бірдеңе дұрыс емес.
Dialogue: 0,0:50:31.44,0:50:33.19,Default,,0,0,0,,Біраз жатайын деп қабылдау бөлмесіне бардым...
Dialogue: 0,0:50:33.57,0:50:34.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:34.57,0:50:35.78,Default,,0,0,0,,Оны неге жұмсағанымды мүлде есіме түсіре алмаймын
Dialogue: 0,0:50:35.90,0:50:36.78,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:50:36.90,0:50:38.24,Default,,0,0,0,,Уф (Әріптес А/Б) А...
Dialogue: 0,0:50:38.36,0:50:41.20,Default,,0,0,0,,Бұл жаңа антипиретикте не болды?
Dialogue: 0,0:50:41.49,0:50:43.03,Default,,0,0,0,,Уф (Омаэда) Қызуды басатын?
Dialogue: 0,0:50:43.16,0:50:44.54,Default,,0,0,0,,Мұны кім айтты?
Dialogue: 0,0:50:44.83,0:50:46.25,Default,,0,0,0,,Не? Сонда...
Dialogue: 0,0:50:46.54,0:50:47.33,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:50:47.46,0:50:48.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:48.75,0:50:50.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:50.63,0:50:51.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:51.42,0:50:52.75,Default,,0,0,0,,（）
Dialogue: 0,0:50:52.88,0:50:54.30,Default,,0,0,0,,Бұл ненің иісі?
Dialogue: 0,0:50:54.42,0:50:55.13,Default,,0,0,0,,（）
Dialogue: 0,0:50:55.55,0:51:00.14,Default,,0,0,0,,（）
Dialogue: 0,0:51:00.34,0:51:01.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:01.14,0:51:02.64,Default,,0,0,0,,（）
Dialogue: 0,0:51:29.83,0:51:33.54,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:51:36.51,0:51:39.97,Default,,0,0,0,,Уф... уау~
Dialogue: 0,0:51:40.88,0:51:42.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:43.01,0:51:44.39,Default,,0,0,0,,Хаа…
Dialogue: 0,0:51:44.76,0:51:46.06,Default,,0,0,0,,Хмм.
Dialogue: 0,0:51:47.31,0:51:49.81,Default,,0,0,0,,Не, таң?
Dialogue: 0,0:51:49.94,0:51:51.90,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:51:52.90,0:51:56.86,Default,,0,0,0,,Барлығының жұмысқа келетін уақыты емес пе?
Dialogue: 0,0:51:56.98,0:51:59.15,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:52:00.24,0:52:02.95,Default,,0,0,0,,Біреу мені оятты...
Dialogue: 0,0:52:04.03,0:52:05.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:20.80,0:52:22.09,Default,,0,0,0,,Саки-чан
Dialogue: 0,0:52:22.22,0:52:23.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:26.43,0:52:28.47,Default,,0,0,0,,Ах... Саки-чан
Dialogue: 0,0:52:28.97,0:52:31.18,Default,,0,0,0,,Бұл... біреу
Dialogue: 0,0:52:31.31,0:52:34.65,Default,,0,0,0,,Біреу... біреу келсін.
Dialogue: 0,0:53:03.59,0:53:05.89,Default,,0,0,0,,Бес метрге дейін жақындауым керек
Dialogue: 0,0:53:06.64,0:53:08.51,Default,,0,0,0,,Кю… Жедел жәрдем
Dialogue: 0,0:53:09.35,0:53:10.64,Default,,0,0,0,,Мен жедел жәрдем шақыруым керек.
Dialogue: 0,0:53:16.06,0:53:19.15,Default,,0,0,0,,Бұл... қандай да бір апат болуы мүмкін бе?
Dialogue: 0,0:53:19.44,0:53:23.53,Default,,0,0,0,,Бактерияға қарсы дабыл беру керек.
Dialogue: 0,0:53:26.91,0:53:28.78,Default,,0,0,0,,Әлі де кешегідей...
Dialogue: 0,0:53:29.41,0:53:31.49,Default,,0,0,0,,О, сәлем, жедел жәрдем.
Dialogue: 0,0:53:31.62,0:53:33.71,Default,,0,0,0,,Тезірек жедел жәрдемді жіберіңіз.
Dialogue: 0,0:53:40.25,0:53:43.34,Default,,0,0,0,,Шо... Директор?
Dialogue: 0,0:53:44.55,0:53:46.09,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:53:50.85,0:53:52.81,Default,,0,0,0,,Директор...
Dialogue: 0,0:53:54.94,0:53:56.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:56.77,0:53:58.73,Default,,0,0,0,,Бактерияға қарсы дабыл өшірулі ме?
Dialogue: 0,0:53:59.36,0:54:00.94,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:54:01.07,0:54:02.90,Default,,0,0,0,,Директор оны жойды ма?
Dialogue: 0,0:54:14.62,0:54:14.96,Default,,0,0,0,,Уау
Dialogue: 0,0:54:14.96,0:54:16.04,Default,,0,0,0,,Уау
Dialogue: 0,0:54:14.96,0:54:16.04,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:54:16.04,0:54:17.67,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:54:18.00,0:54:18.79,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:54:19.38,0:54:21.29,Default,,0,0,0,,Жаңа ғана апат болды.
Dialogue: 0,0:54:21.75,0:54:24.80,Default,,0,0,0,,Сабырлы болыңыз және нұсқауларды орындаңыз
Dialogue: 0,0:54:25.01,0:54:26.30,Default,,0,0,0,,Жаңа ғана апат болды.
Dialogue: 0,0:54:26.42,0:54:29.05,Default,,0,0,0,,Иә? Апат? Күткендей...
Dialogue: 0,0:54:29.18,0:54:30.47,Default,,0,0,0,,Мен оны тауып, өлтіремін!
Dialogue: 0,0:54:31.10,0:54:34.72,Default,,0,0,0,,Осы жолды басты басымдылыққа айналдырыңыз. Иә, бұл сіздің басты міндетіңіз.
Dialogue: 0,0:54:35.27,0:54:36.48,Default,,0,0,0,,Не болды, Омаэда-кун?
Dialogue: 0,0:54:36.60,0:54:37.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:37.48,0:54:38.44,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:54:38.56,0:54:40.52,Default,,0,0,0,,А... а... жоқ, у...
Dialogue: 0,0:54:40.65,0:54:43.15,Default,,0,0,0,,Сіз ше, Омаэда? Директор Омаэда-кун қайда?
Dialogue: 0,0:54:43.27,0:54:45.24,Default,,0,0,0,,Аа, директор болсаң, міне.
Dialogue: 0,0:54:51.32,0:54:53.49,Default,,0,0,0,,Не болды, не болды?
Dialogue: 0,0:54:53.62,0:54:55.50,Default,,0,0,0,,Омаэда-кун неге құлады?
Dialogue: 0,0:54:55.62,0:54:57.83,Default,,0,0,0,,Мен түсінбеймін. Бұл тек директор емес.
Dialogue: 0,0:54:57.96,0:54:59.00,Default,,0,0,0,,Қалғандары да...
Dialogue: 0,0:54:59.12,0:55:00.00,Default,,0,0,0,,Не!
Dialogue: 0,0:55:00.13,0:55:01.84,Default,,0,0,0,,Эй, басқа мониторларды да көрсет.
Dialogue: 0,0:55:02.67,0:55:03.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:03.46,0:55:06.63,Default,,0,0,0,,Қандай да бір апат болды ма деп ойлаймын...
Dialogue: 0,0:55:06.84,0:55:07.55,Default,,0,0,0,,Сен…
Dialogue: 0,0:55:07.88,0:55:11.09,Default,,0,0,0,,Танака... Мен 3-ші даму кеңсесінен Нобуо Танакамын.
Dialogue: 0,0:55:11.22,0:55:14.18,Default,,0,0,0,,Қашан? Апат сағат неше минутта болды?
Dialogue: 0,0:55:14.31,0:55:16.56,Default,,0,0,0,,Міне, мен бүгін таңертең ояндым...
Dialogue: 0,0:55:16.68,0:55:17.48,Default,,0,0,0,,Не?
Dialogue: 0,0:55:17.60,0:55:19.10,Default,,0,0,0,,Енді дабыл соғылды емес пе?
Dialogue: 0,0:55:19.23,0:55:21.56,Default,,0,0,0,,Бұл... директор электр қуатын өшірді.
Dialogue: 0,0:55:21.69,0:55:22.77,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:55:22.90,0:55:24.90,Default,,0,0,0,,Сіз түсінбейсіз. Омаеданы оят.
Dialogue: 0,0:55:25.03,0:55:28.40,Default,,0,0,0,,Бұл саналы емес, басқалар да емес.
Dialogue: 0,0:55:28.74,0:55:30.45,Default,,0,0,0,,Қарғыс атсын... О, құдай... (Нобуо) Сонымен...
Dialogue: 0,0:55:30.57,0:55:33.58,Default,,0,0,0,,Жедел жәрдем шақырдым, әлі келген жоқ.
Dialogue: 0,0:55:33.91,0:55:36.04,Default,,0,0,0,,Не? Сіз жедел жәрдем шақырдыңыз ба?
Dialogue: 0,0:55:36.16,0:55:38.00,Default,,0,0,0,,Иә, полиция да.
Dialogue: 0,0:55:38.12,0:55:39.08,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:55:39.21,0:55:40.58,Default,,0,0,0,,Бір минут күтіңіз...
Dialogue: 0,0:55:40.71,0:55:44.67,Default,,0,0,0,,бұл... Иә, түсінемін...
Dialogue: 0,0:55:45.30,0:55:48.01,Default,,0,0,0,,Жоқ... түсіндім.
Dialogue: 0,0:55:48.51,0:55:49.59,Default,,0,0,0,,Хаа…
Dialogue: 0,0:55:50.63,0:55:52.89,Default,,0,0,0,,Бұл Танака-кун болды (Нобуо) А, иә.
Dialogue: 0,0:55:54.10,0:55:55.85,Default,,0,0,0,,Мұқият тыңдаңыз.
Dialogue: 0,0:55:56.14,0:55:59.77,Default,,0,0,0,,Мен сізден белгілі бір дәрілер мен құжаттарды тауып беруіңізді сұраймын.
Dialogue: 0,0:56:00.02,0:56:03.90,Default,,0,0,0,,Сіз оны Токиодағы штаб-пәтерге өзіңіз әкелуіңіз керек.
Dialogue: 0,0:56:04.02,0:56:07.86,Default,,0,0,0,,Мен Кёити Нирасакимін, Жаңа есірткіні әзірлеу бюросының директоры.
Dialogue: 0,0:56:07.98,0:56:10.78,Default,,0,0,0,,Менен басқа ешкімге ешқашан берме.
Dialogue: 0,0:56:11.07,0:56:12.57,Default,,0,0,0,,Дәл қазір не?
Dialogue: 0,0:56:12.70,0:56:13.66,Default,,0,0,0,,Иә.
Dialogue: 0,0:56:13.78,0:56:16.20,Default,,0,0,0,,Жолда кім сұраса да
Dialogue: 0,0:56:16.33,0:56:18.45,Default,,0,0,0,,Біздің компанияның мүшесімін деп айтпаңыз.
Dialogue: 0,0:56:18.58,0:56:20.54,Default,,0,0,0,,А... Не айтып тұрсың?
Dialogue: 0,0:56:20.83,0:56:24.25,Default,,0,0,0,,Бұл апат... жоқ, оның апат екені әлі анықталған жоқ.
Dialogue: 0,0:56:24.38,0:56:27.75,Default,,0,0,0,,Біздің компания үкіметтің сұрауы бойынша жасырын түрде зерттеген дәріге қатысты.
Dialogue: 0,0:56:27.92,0:56:30.30,Default,,0,0,0,,Себебі қатысу мүмкіндігі бар
Dialogue: 0,0:56:31.63,0:56:33.22,Default,,0,0,0,,Мемлекеттің сұрауы?
Dialogue: 0,0:56:33.34,0:56:34.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:56:34.80,0:56:39.52,Default,,0,0,0,,Сондықтан, біз тек компанияның пікіріне сүйене отырып, ақпаратты жария ете алмаймыз.
Dialogue: 0,0:56:40.18,0:56:42.77,Default,,0,0,0,,Танака мырза, менің уақытым жоқ.
Dialogue: 0,0:56:43.60,0:56:47.15,Default,,0,0,0,,Әйтеуір, полиция келгенше ол жерден кет.
Dialogue: 0,0:56:47.27,0:56:52.03,Default,,0,0,0,,Бұл құжат кодының нөмірі және менеджерлер тізімі.
Dialogue: 0,0:56:52.15,0:56:55.45,Default,,0,0,0,,Ал бұл препараттың үлгісі.
Dialogue: 0,0:56:58.99,0:57:00.50,Default,,0,0,0,,Бұл…
Dialogue: 0,0:57:01.29,0:57:03.54,Default,,0,0,0,,Бұл қызуды басатын дәрі емес пе?
Dialogue: 0,0:57:03.67,0:57:05.88,Default,,0,0,0,,Мен іштім
Dialogue: 0,0:57:18.14,0:57:20.56,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:57:28.82,0:57:29.44,Default,,0,0,0,,Уау
Dialogue: 0,0:57:29.77,0:57:32.32,Default,,0,0,0,,Ааааааааа...
Dialogue: 0,0:57:33.53,0:57:35.91,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:57:36.20,0:57:37.78,Default,,0,0,0,,тармақ…
Dialogue: 0,0:57:38.45,0:57:39.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:41.74,0:57:42.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:57.34,0:57:59.93,Default,,0,0,0,,Бұл не? Бұл...
Dialogue: 0,0:58:00.05,0:58:03.22,Default,,0,0,0,,Шие мен күнбағыс бірге гүлдейді!
Dialogue: 0,0:58:12.40,0:58:13.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:21.91,0:58:25.83,Default,,0,0,0,,Сәлем! Эй, не болды?
Dialogue: 0,0:58:32.42,0:58:33.88,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:59:06.66,0:59:08.33,Default,,0,0,0,,Рұқсат болмайынша ештеңе жарияламаңыз.
Dialogue: 0,0:59:08.46,0:59:09.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:59:09.42,0:59:10.33,Default,,0,0,0,,Сондай-ақ сұраулар үшін
Dialogue: 0,0:59:47.33,0:59:48.58,Default,,0,0,0,,Шығыс армиясы
Dialogue: 0,0:59:48.71,0:59:51.42,Default,,0,0,0,,Эвакуация және құтқару тікұшағына дайындық жұмыстары аяқталды ма?
Dialogue: 0,0:59:51.54,0:59:55.17,Default,,0,0,0,,Ацуги толып қалды. Йокотадағы АҚШ әскери базасына барыңыз.
Dialogue: 0,0:59:56.30,0:59:59.72,Default,,0,0,0,,Ниигата! Жауап беріңіз, Ниигата базасы
Dialogue: 0,1:00:02.01,1:00:06.01,Default,,0,0,0,,(мүшелерге нұсқау беру)
Dialogue: 0,1:00:11.14,1:00:15.77,Default,,0,0,0,,Мен аға басқарушы директор Камата мырзаны және Nishihashi Pharmaceutical компаниясының даму жөніндегі директоры Нирасаки мырзаны әкелдім.
Dialogue: 0,1:00:16.77,1:00:19.49,Default,,0,0,0,,Олай болса, мән-жайды айтайын.
Dialogue: 0,1:00:19.94,1:00:22.57,Default,,0,0,0,,Бұл Чуо экспресс жолы Сасаго туннелі.
Dialogue: 0,1:00:22.70,1:00:24.91,Default,,0,0,0,,Қазіргі уақытта Кофу бассейніне кіретін шығыс жолақ
Dialogue: 0,1:00:25.03,1:00:26.58,Default,,0,0,0,,Барлық жолдар көлік қозғалысы үшін жабық.
Dialogue: 0,1:00:26.70,1:00:29.00,Default,,0,0,0,,Жол апатын өңдеуге байланысты кептелістерге байланысты жоғары жолақ та жабылған.
Dialogue: 0,1:00:29.12,1:00:31.79,Default,,0,0,0,,Көріп отырғаныңыздай, ол толығымен тоқтады.
Dialogue: 0,1:00:31.91,1:00:35.34,Default,,0,0,0,,Кацунума аймағынан эвакуацияланғандар саны өсуде,
Dialogue: 0,1:00:35.46,1:00:39.55,Default,,0,0,0,,Кофу бассейнінің орталығынан байланыс үзілген.
Dialogue: 0,1:00:40.55,1:00:43.47,Default,,0,0,0,,Осылайша мен противогаз киіп жүрсем де,
Dialogue: 0,1:00:43.59,1:00:45.85,Default,,0,0,0,,Бұл иістің алдын алудың жолы жоқ.
Dialogue: 0,1:00:45.97,1:00:48.51,Default,,0,0,0,,Бассейнде не болып жатыр?
Dialogue: 0,1:00:48.64,1:00:51.56,Default,,0,0,0,,Ал бұл нақты қандай иіс?
Dialogue: 0,1:01:01.24,1:01:03.32,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,1:01:03.45,1:01:06.57,Default,,0,0,0,,Елдің барлығы қарап отыр деп үміттенемін.
Dialogue: 0,1:01:06.70,1:01:10.95,Default,,0,0,0,,Гүлдер! Кофу бассейні гүлденіп, сізді тұншықтырды.
Dialogue: 0,1:01:11.58,1:01:13.87,Default,,0,0,0,,Бассейндегі барлық өсімдіктер сияқты
Dialogue: 0,1:01:14.00,1:01:15.83,Default,,0,0,0,,Гүл жайнап тұрған сияқты.
Dialogue: 0,1:01:15.96,1:01:18.96,Default,,0,0,0,,Бірақ мен мүлде қозғалған ештеңе көрмеймін.
Dialogue: 0,1:01:27.55,1:01:30.06,Default,,0,0,0,,Қандай көрініс!
Dialogue: 0,1:01:30.43,1:01:32.48,Default,,0,0,0,,Шынымен гүлденген тозақ
Dialogue: 0,1:01:32.60,1:01:33.73,Default,,0,0,0,,Бұл жағдайда құрбан болғандардың санын есептеу мүмкін емес.
Dialogue: 0,1:01:33.73,1:01:35.48,Default,,0,0,0,,Бұл жағдайда құрбан болғандардың санын есептеу мүмкін емес.
Dialogue: 0,1:01:33.73,1:01:35.48,Default,,0,0,0,,Не? Ах!
Dialogue: 0,1:01:35.60,1:01:36.98,Default,,0,0,0,,Адамдар бар! (Тілші Б) Әй!
Dialogue: 0,1:01:43.82,1:01:46.11,Default,,0,0,0,,Мен аман қалдым. Мен сене алар емеспін.
Dialogue: 0,1:01:46.66,1:01:47.70,Default,,0,0,0,,Құтқарайық
Dialogue: 0,1:01:47.82,1:01:52.25,Default,,0,0,0,,Ах... полицейлер 300 метрден төмен түсу қауіпті дейді.
Dialogue: 0,1:01:52.37,1:01:55.12,Default,,0,0,0,,Адам өмірі бірінші орында. Жаңалықтар бюросының марапаты.
Dialogue: 0,1:01:56.04,1:01:58.04,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:02:04.47,1:02:08.72,Default,,0,0,0,,Барлығыңыз, өмірді сақтап қалу үшін жасалған бұл шараны қараңыздар.
Dialogue: 0,1:02:13.27,1:02:15.44,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:02:16.14,1:02:19.36,Default,,0,0,0,,Уа, ау, ау...
Dialogue: 0,1:02:19.48,1:02:22.07,Default,,0,0,0,,Бұл... иіс...
Dialogue: 0,1:02:22.61,1:02:25.70,Default,,0,0,0,,Гвааааа...
Dialogue: 0,1:02:30.53,1:02:32.99,Default,,0,0,0,,Әй, әрекетіңді жина, эй.
Dialogue: 0,1:02:33.12,1:02:35.20,Default,,0,0,0,,Уф... (Нобуо) Ах.
Dialogue: 0,1:02:35.46,1:02:37.83,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:02:40.21,1:02:43.38,Default,,0,0,0,,Ах... маған көмектесіңізші.
Dialogue: 0,1:02:44.09,1:02:47.97,Default,,0,0,0,,Мен мұндай препараттарды зерттеу туралы есептерді естіген жоқпын.
Dialogue: 0,1:02:48.22,1:02:51.60,Default,,0,0,0,,бастапқыда бітімгершілік операцияларға арналған.
Dialogue: 0,1:02:51.72,1:02:55.77,Default,,0,0,0,,Министр менімен оны бактерияға қарсы қару ретінде қолдану туралы сөйлесті.
Dialogue: 0,1:02:55.89,1:02:59.73,Default,,0,0,0,,Біз компаниямызда өте құпия зерттеу тобын құрдық...
Dialogue: 0,1:03:00.10,1:03:03.15,Default,,0,0,0,,Сіз қаруды әзірлеуге тапсырыс бердіңіз дейсіз бе?
Dialogue: 0,1:03:03.27,1:03:06.03,Default,,0,0,0,,Жоқ... бұл қарсы шара үшін.
Dialogue: 0,1:03:06.15,1:03:08.91,Default,,0,0,0,,Дегенмен, командаға жауапты адам, Оммаеда,
Dialogue: 0,1:03:09.03,1:03:11.03,Default,,0,0,0,,Кездейсоқ синтезделген заттарға
Dialogue: 0,1:03:11.16,1:03:13.62,Default,,0,0,0,,Мен оның үлкен күшке ие екенін білдім.
Dialogue: 0,1:03:13.74,1:03:15.66,Default,,0,0,0,,Қуат? Қанша?
Dialogue: 0,1:03:15.79,1:03:17.00,Default,,0,0,0,,Ух... м-м, дәл қазір.
Dialogue: 0,1:03:17.12,1:03:21.21,Default,,0,0,0,,Зертхана компьютерінде қалған мәліметтерді талдау.
Dialogue: 0,1:03:21.33,1:03:26.09,Default,,0,0,0,,Біз білген бойда сізбен хабарласамыз.
Dialogue: 0,1:03:26.84,1:03:28.26,Default,,0,0,0,,Арнайы жасақтарға не болды?
Dialogue: 0,1:03:28.38,1:03:30.22,Default,,0,0,0,,Оқиға орнына түскеніңізге қанша уақыт болды?
Dialogue: 0,1:03:30.43,1:03:34.72,Default,,0,0,0,,Соңғы уақытқа дейін зертхана ішінде деректер жиналып жатқаны туралы хабарлама болды.
Dialogue: 0,1:03:34.85,1:03:36.56,Default,,0,0,0,,Ол енгізілген...
Dialogue: 0,1:03:36.68,1:03:38.39,Default,,0,0,0,,«ga» нені білдіреді?
Dialogue: 0,1:03:38.77,1:03:41.40,Default,,0,0,0,,Әртүрлі орындарға түсірілген сенсорлардың деректері бойынша.
Dialogue: 0,1:03:41.52,1:03:44.69,Default,,0,0,0,,Апат орталығы қозғалып бара жатқан сияқты.
Dialogue: 0,1:03:44.82,1:03:45.90,Default,,0,0,0,,Не?
Dialogue: 0,1:03:46.23,1:03:48.11,Default,,0,0,0,,Апат нәтижесінде пайда болған газ белдеуі
Dialogue: 0,1:03:48.24,1:03:51.16,Default,,0,0,0,,Желдің әсерінен қозғалып жатқан шығар деп ойлаймын.
Dialogue: 0,1:04:05.17,1:04:07.30,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,1:04:13.64,1:04:17.64,Default,,0,0,0,,Біз мүмкіндігінше тезірек себебін анықтап, бейтараптандырғышты әзірлеуіміз керек.
Dialogue: 0,1:04:17.77,1:04:19.85,Default,,0,0,0,,Дәл қазір ғылыми-зерттеу институтындағы адамдар
Dialogue: 0,1:04:19.98,1:04:22.94,Default,,0,0,0,,Мен бірнеше үлгілермен Токиоға бара жатырмын...
Dialogue: 0,1:04:23.06,1:04:25.82,Default,,0,0,0,,Жақында келеді деп ойлаймын.
Dialogue: 0,1:04:26.44,1:04:27.73,Default,,0,0,0,,Сізде үлгілер бар ма?
Dialogue: 0,1:04:27.86,1:04:29.19,Default,,0,0,0,,А... иә
Dialogue: 0,1:04:29.32,1:04:33.16,Default,,0,0,0,,Жазатайым оқиға туралы хабарлаған жас зерттеушіде болуы керек.
Dialogue: 0,1:04:33.28,1:04:34.91,Default,,0,0,0,,Не... Сіз нені айтып тұрсыз?
Dialogue: 0,1:04:34.91,1:04:36.03,Default,,0,0,0,,Не... Сіз нені айтып тұрсыз?
Dialogue: 0,1:04:34.91,1:04:36.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:37.37,1:04:38.66,Default,,0,0,0,,Жоқ, әзірге.
Dialogue: 0,1:04:38.79,1:04:42.67,Default,,0,0,0,,Мен құпия құжаттар мен үлгілерді бөгде адамдардан оқшауланған түрде сақтағым келеді.
Dialogue: 0,1:04:43.17,1:04:45.33,Default,,0,0,0,,Оқиға орнында тірі қалғандар бар ма?
Dialogue: 0,1:04:45.59,1:04:46.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:47.75,1:04:48.84,Default,,0,0,0,,Ха…
Dialogue: 0,1:04:49.67,1:04:50.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:51.72,1:04:53.93,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:59.93,1:05:01.73,Default,,0,0,0,,Иіс күшейе түсуде
Dialogue: 0,1:05:01.85,1:05:03.39,Default,,0,0,0,,Бұл жабдық тасымалданбайды
Dialogue: 0,1:05:03.52,1:05:06.02,Default,,0,0,0,,Эвакуацияның аяқталғанын анықтаңыз және осы жерден кетіңіз.
Dialogue: 0,1:05:06.15,1:05:07.73,Default,,0,0,0,,Қайтып оралған бойда оны құлыптаңыз.
Dialogue: 0,1:05:07.86,1:05:08.73,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:05:08.86,1:05:10.23,Default,,0,0,0,,Капитан, бұл.
Dialogue: 0,1:05:10.36,1:05:11.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:15.74,1:05:18.12,Default,,0,0,0,,Не... не?
Dialogue: 0,1:05:24.33,1:05:25.50,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:25.79,1:05:28.88,Default,,0,0,0,,Жақсы! Соңғы эвакуацияланған адамды құтқарыңыз.
Dialogue: 0,1:05:29.00,1:05:29.84,Default,,0,0,0,,Ха!
Dialogue: 0,1:05:29.96,1:05:31.13,Default,,0,0,0,,Мен эвакуацияланамын.
Dialogue: 0,1:05:31.26,1:05:33.34,Default,,0,0,0,,Затыңызды тез жинаңыз.
Dialogue: 0,1:05:33.47,1:05:35.97,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,1:05:36.09,1:05:38.22,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:05:39.76,1:05:42.02,Default,,0,0,0,,(Мүшелердің ыңырануы)
Dialogue: 0,1:05:42.31,1:05:45.19,Default,,0,0,0,,А... неге?
Dialogue: 0,1:05:47.52,1:05:48.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:51.65,1:05:53.53,Default,,0,0,0,,Ух... уау аааа
Dialogue: 0,1:05:53.65,1:05:57.07,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:05:58.41,1:06:00.08,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:04.25,1:06:07.29,Default,,0,0,0,,Ха... міне...
Dialogue: 0,1:06:07.46,1:06:09.59,Default,,0,0,0,,Бұл иістің көзі.
Dialogue: 0,1:06:10.80,1:06:13.38,Default,,0,0,0,,Эвакуациялаңыз! Барлық қызметкерлер эвакуацияланды
Dialogue: 0,1:06:13.92,1:06:15.88,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,1:06:16.01,1:06:18.14,Default,,0,0,0,,Мына тұман... о эй
Dialogue: 0,1:06:18.26,1:06:20.26,Default,,0,0,0,,Жоқ, бұл жарамайды. Қаш! Жылдам!
Dialogue: 0,1:06:22.39,1:06:24.39,Default,,0,0,0,,Эй, эй
Dialogue: 0,1:06:34.90,1:06:35.82,Default,,0,0,0,,Эвакуация
Dialogue: 0,1:06:35.95,1:06:37.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:38.82,1:06:42.37,Default,,0,0,0,,Эй... күте тұрыңыз.
Dialogue: 0,1:06:51.71,1:06:53.46,Default,,0,0,0,,(Соқтығыс және жарылыс дыбыстары)
Dialogue: 0,1:06:53.59,1:06:55.09,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:06:56.09,1:06:57.38,Default,,0,0,0,,Тездетіңіз
Dialogue: 0,1:07:07.44,1:07:14.44,Default,,0,0,0,,(Нобуоның ауыр тыныс алуы)
Dialogue: 0,1:07:23.08,1:07:25.54,Default,,0,0,0,,А... бұл не?
Dialogue: 0,1:07:25.66,1:07:29.29,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,1:07:31.21,1:07:34.55,Default,,0,0,0,,Ата, асығыңыз, Ан-чан бәлеге қалды.
Dialogue: 0,1:07:34.67,1:07:37.42,Default,,0,0,0,,Нобуоға не болды?
Dialogue: 0,1:07:37.55,1:07:38.80,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:07:39.51,1:07:41.39,Default,,0,0,0,,Кофу қаласынан байланыс үзілді.
Dialogue: 0,1:07:41.64,1:07:42.18,Default,,0,0,0,,Әже
Dialogue: 0,1:07:42.18,1:07:42.76,Default,,0,0,0,,Әже
Dialogue: 0,1:07:42.18,1:07:42.76,Default,,0,0,0,,10 сағаттай болды.
Dialogue: 0,1:07:42.76,1:07:43.43,Default,,0,0,0,,10 сағаттай болды.
Dialogue: 0,1:07:43.43,1:07:44.39,Default,,0,0,0,,10 сағаттай болды.
Dialogue: 0,1:07:43.43,1:07:44.39,Default,,0,0,0,,Мен атамды алып келдім.
Dialogue: 0,1:07:44.39,1:07:44.51,Default,,0,0,0,,Мен атамды алып келдім.
Dialogue: 0,1:07:44.51,1:07:44.76,Default,,0,0,0,,Мен атамды алып келдім.
Dialogue: 0,1:07:44.51,1:07:44.76,Default,,0,0,0,,Жалғыз аман қалған адам туралы.
Dialogue: 0,1:07:44.76,1:07:44.89,Default,,0,0,0,,Жалғыз аман қалған адам туралы.
Dialogue: 0,1:07:44.89,1:07:46.27,Default,,0,0,0,,Жалғыз аман қалған адам туралы.
Dialogue: 0,1:07:44.89,1:07:46.27,Default,,0,0,0,,А... не болды?
Dialogue: 0,1:07:46.27,1:07:46.39,Default,,0,0,0,,А... не болды?
Dialogue: 0,1:07:46.39,1:07:46.68,Default,,0,0,0,,А... не болды?
Dialogue: 0,1:07:46.39,1:07:46.68,Default,,0,0,0,,Сәйкестендіру расталды
Dialogue: 0,1:07:46.68,1:07:46.81,Default,,0,0,0,,Сәйкестендіру расталды
Dialogue: 0,1:07:46.81,1:07:48.31,Default,,0,0,0,,Сәйкестендіру расталды
Dialogue: 0,1:07:46.81,1:07:48.31,Default,,0,0,0,,О, әке, бұл керемет болды.
Dialogue: 0,1:07:48.31,1:07:48.43,Default,,0,0,0,,О, әке, бұл керемет болды.
Dialogue: 0,1:07:48.43,1:07:49.31,Default,,0,0,0,,О, әке, бұл керемет болды.
Dialogue: 0,1:07:48.43,1:07:49.31,Default,,0,0,0,,Енді бейнені қайта қараңыз.
Dialogue: 0,1:07:49.31,1:07:49.44,Default,,0,0,0,,Енді бейнені қайта қараңыз.
Dialogue: 0,1:07:49.44,1:07:50.81,Default,,0,0,0,,Енді бейнені қайта қараңыз.
Dialogue: 0,1:07:49.44,1:07:50.81,Default,,0,0,0,,Нобуо - Нобуо...
Dialogue: 0,1:07:50.81,1:07:52.02,Default,,0,0,0,,Нобуо - Нобуо...
Dialogue: 0,1:07:52.94,1:07:53.56,Default,,0,0,0,,Тас...
Dialogue: 0,1:07:53.69,1:07:55.32,Default,,0,0,0,,Бұл адам Nishihashi Pharmaceutical компаниясында жұмыс істейді.
Dialogue: 0,1:07:55.57,1:07:56.82,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:55.57,1:07:56.82,Default,,0,0,0,,Нобуо Танака, 23 жаста деп есептеледі
Dialogue: 0,1:07:56.82,1:07:56.94,Default,,0,0,0,,Нобуо Танака, 23 жаста деп есептеледі
Dialogue: 0,1:07:56.94,1:07:58.32,Default,,0,0,0,,Нобуо Танака, 23 жаста деп есептеледі
Dialogue: 0,1:07:56.94,1:07:58.32,Default,,0,0,0,,Нобуо, сен не істедің?
Dialogue: 0,1:07:58.32,1:07:58.44,Default,,0,0,0,,Нобуо, сен не істедің?
Dialogue: 0,1:07:58.44,1:08:00.45,Default,,0,0,0,,Нобуо, сен не істедің?
Dialogue: 0,1:07:58.44,1:08:00.45,Default,,0,0,0,,Сонымен қатар, Танака мырзаның жұмыс орны...
Dialogue: 0,1:08:01.24,1:08:03.95,Default,,0,0,0,,Ластанған аймақ Сасаго туннелі арқылы өтті.
Dialogue: 0,1:08:04.53,1:08:08.08,Default,,0,0,0,,Менің ойымша, апаттың себебі осы адам деп болжауға болады.
Dialogue: 0,1:08:08.37,1:08:09.91,Default,,0,0,0,,Оны растайтын есеп бар.
Dialogue: 0,1:08:10.04,1:08:12.67,Default,,0,0,0,,Сасаго туннелінде эвакуацияны басқарған әскерлерден.
Dialogue: 0,1:08:12.79,1:08:14.09,Default,,0,0,0,,Ол жіберілді
Dialogue: 0,1:08:14.38,1:08:16.05,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:16.17,1:08:18.09,Default,,0,0,0,,Хаа…
Dialogue: 0,1:08:18.42,1:08:22.80,Default,,0,0,0,,Иә, компьютерлік талдау нәтижелері мен далада жиналған мәліметтер арасында.
Dialogue: 0,1:08:22.93,1:08:25.68,Default,,0,0,0,,айтарлықтай айырмашылықтар болғандықтан,
Dialogue: 0,1:08:25.81,1:08:29.23,Default,,0,0,0,,Басқа заттармен күрделі синтез деп аталады ма?
Dialogue: 0,1:08:29.35,1:08:34.27,Default,,0,0,0,,Оның денесінде қандай да бір сыра қайнату орын алған деп күдіктенеміз.
Dialogue: 0,1:08:34.40,1:08:37.78,Default,,0,0,0,,Әрине, ол үлгіні ішкен деп есептесек.
Dialogue: 0,1:08:37.90,1:08:40.28,Default,,0,0,0,,Оны аздап анық түсіндіре аласыз ба?
Dialogue: 0,1:08:40.40,1:08:42.36,Default,,0,0,0,,А, иә… Иә, иә…
Dialogue: 0,1:08:42.95,1:08:45.37,Default,,0,0,0,,Ол тірі дене ретінде...
Dialogue: 0,1:08:45.49,1:08:47.91,Default,,0,0,0,,Нобуо Танака денесінің өзі
Dialogue: 0,1:08:48.04,1:08:50.66,Default,,0,0,0,,Бұл иіс шығаратын зауыт екені анық.
Dialogue: 0,1:08:50.79,1:08:54.50,Default,,0,0,0,,Эмоционалды көтерілулер және құлдыраулар Жаттығу мөлшері зат алмасу мөлшеріне пропорционалды
Dialogue: 0,1:08:54.63,1:08:59.21,Default,,0,0,0,,Терлеумен бірге иіс шығатын сияқты.
Dialogue: 0,1:08:59.34,1:09:01.26,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,1:09:01.38,1:09:03.34,Default,,0,0,0,,Иә... Сонымен... Әйтеуір.
Dialogue: 0,1:09:03.47,1:09:05.18,Default,,0,0,0,,Оның эмоционалды күйзелістерін басу
Dialogue: 0,1:09:05.30,1:09:09.18,Default,,0,0,0,,Сонымен бірге зат алмасуды басу шараларын...
Dialogue: 0,1:09:09.31,1:09:10.39,Default,,0,0,0,,Егер ол жылдамдықты арттырса, тіпті модель ұшақ болса да—
Dialogue: 0,1:09:11.35,1:09:14.60,Default,,0,0,0,,Бұл оны өлтіруден басқа амалымыз жоқ дегенді білдіреді.
Dialogue: 0,1:09:15.06,1:09:16.94,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,1:09:17.48,1:09:20.57,Default,,0,0,0,,Зерттеуді Жапония да қаржыландырады.
Dialogue: 0,1:09:20.69,1:09:24.49,Default,,0,0,0,,Үлгілерді тірідей алу керек.
Dialogue: 0,1:09:24.91,1:09:25.99,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:09:26.12,1:09:28.03,Default,,0,0,0,,Бұл бірінші кезекте сіз бастаған зерттеу.
Dialogue: 0,1:09:28.16,1:09:29.70,Default,,0,0,0,,Кім жауапты?
Dialogue: 0,1:09:31.41,1:09:33.71,Default,,0,0,0,,Адамдардың өмірі мен мүлкін сақтау
Dialogue: 0,1:09:33.83,1:09:37.08,Default,,0,0,0,,Бұған басымдық беру – біздің кезек күттірмейтін міндетіміз
Dialogue: 0,1:09:42.84,1:09:49.85,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:10:03.11,1:10:04.70,Default,,0,0,0,,Қарап жібере аласыз ба?
Dialogue: 0,1:10:04.82,1:10:07.28,Default,,0,0,0,,Бұл ұзақ иіс бұлты
Dialogue: 0,1:10:07.41,1:10:09.33,Default,,0,0,0,,Бұл қорқынышты иіс.
Dialogue: 0,1:10:09.45,1:10:11.20,Default,,0,0,0,,Бұл биіктік те біздің шегіміз.
Dialogue: 0,1:10:11.33,1:10:15.00,Default,,0,0,0,,Көзілдірікті таққанның өзінде мен бір минуттан артық көзімді аша алмаймын.
Dialogue: 0,1:10:15.41,1:10:17.46,Default,,0,0,0,,Бұлт енді шығысқа қарай жылжиды.
Dialogue: 0,1:10:17.58,1:10:20.63,Default,,0,0,0,,Келешекте залал кеңейеді деген алаңдаушылық бар.
Dialogue: 0,1:10:26.47,1:10:30.01,Default,,0,0,0,,Жоқ~!
Dialogue: 0,1:10:31.43,1:10:34.23,Default,,0,0,0,,Нобуо, сен мені естисің бе?
Dialogue: 0,1:10:34.35,1:10:35.77,Default,,0,0,0,,Нобуо
Dialogue: 0,1:10:35.89,1:10:36.98,Default,,0,0,0,,Бахчан
Dialogue: 0,1:10:37.52,1:10:40.40,Default,,0,0,0,,Токиоға бармаңыз.
Dialogue: 0,1:10:40.52,1:10:42.44,Default,,0,0,0,,Тауға оралу
Dialogue: 0,1:10:42.57,1:10:46.20,Default,,0,0,0,,Мен мұны шынымен түсінбеймін, бірақ бәрі оны мазалаған сияқты.
Dialogue: 0,1:10:46.32,1:10:49.32,Default,,0,0,0,,Жарайды, Нобуо, Токиоға барма.
Dialogue: 0,1:10:49.32,1:10:51.16,Default,,0,0,0,,Жарайды, Нобуо, Токиоға барма.
Dialogue: 0,1:10:49.32,1:10:51.16,Default,,0,0,0,,Неліктен Баччан...
Dialogue: 0,1:10:52.37,1:10:55.50,Default,,0,0,0,,Асығыңыз! Мұны нысан газбен жабылмай тұрып орындаңыз.
Dialogue: 0,1:10:57.87,1:10:59.54,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:11:02.96,1:11:04.38,Default,,0,0,0,,Не? ток
Dialogue: 0,1:11:04.51,1:11:05.92,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:11:06.05,1:11:08.38,Default,,0,0,0,,Немеремді өлтірейін деп жатырсың ба... Ааа!
Dialogue: 0,1:11:08.51,1:11:09.89,Default,,0,0,0,,Корра, жібер.
Dialogue: 0,1:11:10.09,1:11:12.14,Default,,0,0,0,,Не болды? Тез түсіріңіз
Dialogue: 0,1:11:12.26,1:11:13.10,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:11:13.22,1:11:15.14,Default,,0,0,0,,Уф...газ...көз жас...
Dialogue: 0,1:11:15.43,1:11:17.69,Default,,0,0,0,,Бұл биіктікте біз өз шегімізге жеттік.
Dialogue: 0,1:11:17.81,1:11:19.40,Default,,0,0,0,,Көтерілу (Капитан В) Чикусо!
Dialogue: 0,1:11:20.19,1:11:22.02,Default,,0,0,0,,Ах... Баччан
Dialogue: 0,1:11:25.28,1:11:27.15,Default,,0,0,0,,Баччан!
Dialogue: 0,1:11:29.41,1:11:31.24,Default,,0,0,0,,Бакан!
Dialogue: 0,1:11:35.24,1:11:38.29,Default,,0,0,0,,Уау ааа уф
Dialogue: 0,1:11:39.71,1:11:42.04,Default,,0,0,0,,Не... не?
Dialogue: 0,1:11:47.21,1:11:48.22,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:11:53.93,1:11:55.81,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:11:56.93,1:11:59.73,Default,,0,0,0,,Шайқасқа дайын шабуыл күшінен шақыру.
Dialogue: 0,1:11:59.89,1:12:01.52,Default,,0,0,0,,Арнайы полк жақын арада нысанаға тап болады
Dialogue: 0,1:12:01.65,1:12:02.73,Default,,0,0,0,,Радио кедергі бар
Dialogue: 0,1:12:14.45,1:12:17.33,Default,,0,0,0,,Мақсат! Алдыңғы сол көпірдің жанында
Dialogue: 0,1:12:17.79,1:12:21.37,Default,,0,0,0,,Оқиға орнын жеңгеннен кейін бірден толық жылдамдықпен кетіңіз.
Dialogue: 0,1:12:22.88,1:12:24.21,Default,,0,0,0,,Тексеру мақсатынан шықты
Dialogue: 0,1:12:24.34,1:12:26.42,Default,,0,0,0,,Жарайды, соққыға дайындалыңыз.
Dialogue: 0,1:12:26.92,1:12:28.76,Default,,0,0,0,,Мен түтін экранынан нысананы көре алмаймын
Dialogue: 0,1:12:28.88,1:12:30.59,Default,,0,0,0,,Маған бәрібір, сол жерде түсіріңіз.
Dialogue: 0,1:12:31.88,1:12:32.89,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,1:12:37.39,1:12:39.02,Default,,0,0,0,,Ақымақ! қайда мақсат етіп отырсың
Dialogue: 0,1:12:39.14,1:12:41.10,Default,,0,0,0,,Көздеу құрылғысы тыңдамайды
Dialogue: 0,1:12:41.44,1:12:42.77,Default,,0,0,0,,Не?
Dialogue: 0,1:12:43.56,1:12:44.98,Default,,0,0,0,,Ах... (Капитан С) Не болды?
Dialogue: 0,1:12:45.11,1:12:46.73,Default,,0,0,0,,Қозғалтқыш... аа...
Dialogue: 0,1:12:51.03,1:12:53.20,Default,,0,0,0,,Ақымақ, неге тоқтадың?
Dialogue: 0,1:12:53.32,1:12:54.95,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:13:02.66,1:13:03.62,Default,,0,0,0,,Танк корпусына не болды?
Dialogue: 0,1:13:03.75,1:13:05.79,Default,,0,0,0,,Мақсат әлі қозғалуда
Dialogue: 0,1:13:05.92,1:13:07.80,Default,,0,0,0,,Неліктен мен оны тоқтата алмаймын?
Dialogue: 0,1:13:32.32,1:13:34.66,Default,,0,0,0,,Күн Риппелін тікелей оның ішіне жіберуім керек!
Dialogue: 0,1:13:35.28,1:13:36.37,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:13:36.78,1:13:38.12,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:13:40.24,1:13:42.66,Default,,0,0,0,,Уенохараның жанынан өтіп бара жатырмын
Dialogue: 0,1:13:42.79,1:13:43.79,Default,,0,0,0,,Біреу жауап беріңізші!
Dialogue: 0,1:13:44.04,1:13:45.54,Default,,0,0,0,,1-арнайы жұмыс тобы Жауап жоқ
Dialogue: 0,1:13:45.67,1:13:46.79,Default,,0,0,0,,Атсуги базасына қол жеткізу мүмкін емес
Dialogue: 0,1:13:47.33,1:13:48.00,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:13:48.13,1:13:51.55,Default,,0,0,0,,Сасық газ қарудың интегралды схемаларын бұзатын сияқты.
Dialogue: 0,1:13:54.13,1:13:56.64,Default,,0,0,0,,Премьер-министрге хабарласыңыз, бұл шұғыл.
Dialogue: 0,1:13:56.89,1:13:58.51,Default,,0,0,0,,Токиодағы эвакуация туралы бұйрық
Dialogue: 0,1:13:58.64,1:14:00.01,Default,,0,0,0,,Мақсат әлі тірі
Dialogue: 0,1:14:00.14,1:14:02.81,Default,,0,0,0,,Шығысқа қарай 60 км/сағ
Dialogue: 0,1:14:37.18,1:14:38.30,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:40.01,1:14:40.68,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:14:45.56,1:14:46.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:47.23,1:14:49.10,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,1:14:49.65,1:14:52.02,Default,,0,0,0,,Ұшу қабылдау бөлмесі өте көп.
Dialogue: 0,1:14:52.11,1:14:52.44,Default,,0,0,0,,(Ұл баланың жылауы)
Dialogue: 0,1:14:52.44,1:14:53.19,Default,,0,0,0,,(Ұл баланың жылауы)
Dialogue: 0,1:14:52.44,1:14:53.19,Default,,0,0,0,,Қауіпті
Dialogue: 0,1:14:53.19,1:14:53.32,Default,,0,0,0,,(Ұл баланың жылауы)
Dialogue: 0,1:14:53.32,1:14:56.15,Default,,0,0,0,,(Ұл баланың жылауы)
Dialogue: 0,1:14:53.32,1:14:56.15,Default,,0,0,0,,Қызметкерлердің нұсқауларын орындаңыз
Dialogue: 0,1:14:56.15,1:14:57.03,Default,,0,0,0,,(Ұл баланың жылауы)
Dialogue: 0,1:15:00.53,1:15:02.16,Default,,0,0,0,,Хаа…
Dialogue: 0,1:15:10.42,1:15:14.84,Default,,0,0,0,,Премьер-министр екі сағаттан кейін бүкіл әлемге рельефтік хабар тарататын сияқты.
Dialogue: 0,1:15:15.30,1:15:18.97,Default,,0,0,0,,Осыған сәйкес БҰҰ бітімгершілік күштері жіберілді.
Dialogue: 0,1:15:19.09,1:15:21.51,Default,,0,0,0,,Токио от теңізі болады
Dialogue: 0,1:15:21.97,1:15:24.85,Default,,0,0,0,,Жауапкершілік енді жоқ...
Dialogue: 0,1:15:25.68,1:15:27.64,Default,,0,0,0,,Балалар сендер де тез қашыңдар.
Dialogue: 0,1:15:27.77,1:15:29.94,Default,,0,0,0,,Сіздің де отбасыңыз бар деп ойлаймын.
Dialogue: 0,1:15:31.36,1:15:33.98,Default,,0,0,0,,Мм... Сіз қалай ойлайсыз, бастық мырза?
Dialogue: 0,1:15:34.27,1:15:35.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:36.15,1:15:39.45,Default,,0,0,0,,Хахаха Мәртебелі мырзамен келдіңіз бе...
Dialogue: 0,1:15:44.66,1:15:46.54,Default,,0,0,0,,〈Дайындық аяқталды! 〉
Dialogue: 0,1:15:46.66,1:15:48.21,Default,,0,0,0,,〈Жарайды, жіберейік〉
Dialogue: 0,1:15:48.83,1:15:50.46,Default,,0,0,0,,Көзге арналған мұздатқыш
Dialogue: 0,1:15:53.75,1:15:55.63,Default,,0,0,0,,Ки... сендер балалар!
Dialogue: 0,1:15:58.09,1:15:59.22,Default,,0,0,0,,Менің заттарыма тиіспеңіз
Dialogue: 0,1:15:59.34,1:16:01.13,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,1:16:19.40,1:16:21.70,Default,,0,0,0,,NASA-ның жаңа скафандры?
Dialogue: 0,1:16:21.99,1:16:24.12,Default,,0,0,0,,Иә, ол әлі прототип сатысында.
Dialogue: 0,1:16:24.24,1:16:26.83,Default,,0,0,0,,Кез келген сыртқы электромагниттік толқын әсер етпейді
Dialogue: 0,1:16:26.95,1:16:29.20,Default,,0,0,0,,Құрыштың беріктігі керемет.
Dialogue: 0,1:16:29.66,1:16:32.75,Default,,0,0,0,,Миномет снаряды сенің діріліңді түсірмейді.
Dialogue: 0,1:16:32.87,1:16:36.09,Default,,0,0,0,,Сіз... Сіз мені тірідей ұстауды жоспарлап отырсыз ғой, солай ма?
Dialogue: 0,1:16:36.67,1:16:39.63,Default,,0,0,0,,Жапон премьер-министрі бас тартты.
Dialogue: 0,1:16:39.76,1:16:41.63,Default,,0,0,0,,Шағымданатын ештеңе жоқ, солай ма?
Dialogue: 0,1:16:41.76,1:16:44.34,Default,,0,0,0,,Уф... шіркін!
Dialogue: 0,1:16:44.55,1:16:47.64,Default,,0,0,0,,Күзетшілерге айт, өлсеңдер де, Такао тауына жол бермеңдер.
Dialogue: 0,1:16:47.76,1:16:48.35,Default,,0,0,0,,Ха!
Dialogue: 0,1:17:05.99,1:17:09.58,Default,,0,0,0,,Сіз мені іздеп жүрген шығарсыз.
Dialogue: 0,1:17:09.83,1:17:10.58,Default,,0,0,0,,Ах
Dialogue: 0,1:17:14.54,1:17:16.00,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:18.88,1:17:19.84,Default,,0,0,0,,Хаа…
Dialogue: 0,1:17:21.51,1:17:25.14,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,1:17:25.93,1:17:30.47,Default,,0,0,0,,Бірақ мен неге сонша ашпын?
Dialogue: 0,1:17:35.40,1:17:36.44,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:17:44.45,1:17:47.41,Default,,0,0,0,,Жарайды, сәттілік. Құрылғыны толық жылдамдыққа қосыңыз.
Dialogue: 0,1:18:06.39,1:18:08.97,Default,,0,0,0,,Жақсы, айналдыр.
Dialogue: 0,1:18:09.10,1:18:10.14,Default,,0,0,0,,Оны мұздатып, Саппородағы қар фестивалінде көрсетіңіз.
Dialogue: 0,1:18:10.14,1:18:13.27,Default,,0,0,0,,Оны мұзға айналдырып, Саппородағы қар фестивалінде көрсетіңіз.
Dialogue: 0,1:18:10.14,1:18:13.27,Default,,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,1:18:13.27,1:18:13.52,Default,,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,1:18:13.52,1:18:14.14,Default,,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,1:18:13.52,1:18:14.14,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:16.02,1:18:17.85,Default,,0,0,0,,Оның квиркі өте күшті, бірақ—
Dialogue: 0,1:18:19.19,1:18:20.57,Default,,0,0,0,,Не, не?
Dialogue: 0,1:18:21.40,1:18:22.82,Default,,0,0,0,,Мен тыңдамаймын.
Dialogue: 0,1:18:40.54,1:18:43.05,Default,,0,0,0,,Не? Балалар, мұнда не үшін келдіңдер?
Dialogue: 0,1:18:44.34,1:18:46.43,Default,,0,0,0,,Рұқсатсыз маған еліктеуіңізге жол бермеймін.
Dialogue: 0,1:18:46.55,1:18:48.18,Default,,0,0,0,,Бұл бұйрық.
Dialogue: 0,1:18:49.22,1:18:50.30,Default,,0,0,0,,Эй
Dialogue: 0,1:18:51.22,1:18:53.97,Default,,0,0,0,,Капитан! Концентрация жоғарылайды, бұл қауіпті.
Dialogue: 0,1:18:54.39,1:18:55.73,Default,,0,0,0,,Не!
Dialogue: 0,1:18:56.64,1:18:58.10,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:18:58.23,1:19:01.06,Default,,0,0,0,,Сұйық азотқа не болды? Сіз әлі осындасыз ба?
Dialogue: 0,1:19:01.69,1:19:04.23,Default,,0,0,0,,Ах... ой...
Dialogue: 0,1:19:07.32,1:19:08.61,Default,,0,0,0,,Тоқта
Dialogue: 0,1:19:08.74,1:19:10.74,Default,,0,0,0,,Мен сізді бұдан былай арандата алмаймын.
Dialogue: 0,1:19:10.87,1:19:12.45,Default,,0,0,0,,Ол толқып тұр.
Dialogue: 0,1:19:12.58,1:19:15.58,Default,,0,0,0,,Иіс бұлтының ішінде тіпті электр разряды басталды.
Dialogue: 0,1:19:15.70,1:19:17.71,Default,,0,0,0,,Азот ыдысының келуін күтіңіз
Dialogue: 0,1:19:17.83,1:19:18.87,Default,,0,0,0,,Эй!
Dialogue: 0,1:19:22.38,1:19:24.71,Default,,0,0,0,,Жарайды, барғың келсе бар.
Dialogue: 0,1:19:24.84,1:19:26.63,Default,,0,0,0,,Өлгенде суды аламын.
Dialogue: 0,1:19:39.90,1:19:40.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:41.90,1:19:44.90,Default,,0,0,0,,Иә, бұл әлі блокталмаған.
Dialogue: 0,1:19:45.03,1:19:46.78,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,1:20:47.21,1:20:54.22,Default,,0,0,0,,Увааааааааааааааааааааааааааааааа
Dialogue: 0,1:21:21.50,1:21:24.21,Default,,0,0,0,,Эвакуациялаңыз! Барлық қызметкерлер эвакуацияланды.
Dialogue: 0,1:21:41.35,1:21:44.02,Default,,0,0,0,,Байланыстың үзілгеніне 30 минут болды.
Dialogue: 0,1:21:44.14,1:21:45.73,Default,,0,0,0,,Сіз бірдеңе естідіңіз бе?
Dialogue: 0,1:21:49.65,1:21:52.57,Default,,0,0,0,,Ах... сандар...
Dialogue: 0,1:21:52.82,1:21:54.28,Default,,0,0,0,,Сандар азайып келеді
Dialogue: 0,1:21:54.40,1:21:55.11,Default,,0,0,0,,Не!
Dialogue: 0,1:21:55.24,1:21:56.87,Default,,0,0,0,,Бұл рас па? Нирасаки мырза
Dialogue: 0,1:21:56.99,1:21:58.16,Default,,0,0,0,,Онда мен сізді арттан сәл итермелеуге тура келеді —
Dialogue: 0,1:21:58.28,1:21:59.83,Default,,0,0,0,,Мұндағы белгі ең жоғары мән болып табылады.
Dialogue: 0,1:21:59.95,1:22:02.04,Default,,0,0,0,,Қараңызшы, осылай
Dialogue: 0,1:22:04.62,1:22:06.17,Default,,0,0,0,,Байланыс қалпына келтірілді
Dialogue: 0,1:22:06.29,1:22:07.92,Default,,0,0,0,,Сондай-ақ тікұшақтың түсірілімдерін қамтиды.
Dialogue: 0,1:22:08.08,1:22:09.38,Default,,0,0,0,,Монитордағы дисплей
Dialogue: 0,1:22:11.34,1:22:11.92,Default,,0,0,0,,О...
Dialogue: 0,1:22:16.80,1:22:19.47,Default,,0,0,0,,О? О...
Dialogue: 0,1:22:21.26,1:22:22.18,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:22:22.31,1:22:25.69,Default,,0,0,0,,(рельеф дауысы)
Dialogue: 0,1:22:31.90,1:22:34.57,Default,,0,0,0,,Жарайды, Амеко да қауіпсіз.
Dialogue: 0,1:22:34.69,1:22:36.82,Default,,0,0,0,,Біз сасық жігітті ұстаймыз.
Dialogue: 0,1:22:36.95,1:22:37.95,Default,,0,0,0,,Га
Dialogue: 0,1:22:53.13,1:22:55.72,Default,,0,0,0,,Иә, мен уақытында үлгердім.
Dialogue: 0,1:22:55.84,1:22:57.97,Default,,0,0,0,,Біз Жапонияны қорғай алдық
Dialogue: 0,1:22:58.51,1:23:02.93,Default,,0,0,0,,О, түсіндім. Мәртебелі Ұшаққа отырмады.
Dialogue: 0,1:23:03.06,1:23:06.23,Default,,0,0,0,,Сол батыл мінез-құлық босқа кетпесін.
Dialogue: 0,1:23:06.35,1:23:09.52,Default,,0,0,0,,Біз мәселені шеше алғанымызға қуаныштымыз.
Dialogue: 0,1:23:09.65,1:23:10.40,Default,,0,0,0,,Иә
Dialogue: 0,1:23:13.23,1:23:14.86,Default,,0,0,0,,Ғарыштық костюм...
Dialogue: 0,1:23:15.15,1:23:17.57,Default,,0,0,0,,Американдық арнайы күштердің мүшелері оралды.
Dialogue: 0,1:23:24.33,1:23:26.58,Default,,0,0,0,,Ооо...
Dialogue: 0,1:23:26.71,1:23:33.59,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:23:45.22,1:23:46.93,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:51.81,1:23:53.69,Default,,0,0,0,,Бұл… бұл… бұл…
Dialogue: 0,1:23:54.15,1:23:56.03,Default,,0,0,0,,Хаха... Сәлем.
Dialogue: 0,1:23:57.65,1:23:58.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:03.16,1:24:06.33,Default,,0,0,0,,Ах~ Ах~ Ах~
Dialogue: 0,1:24:06.45,1:24:08.79,Default,,0,0,0,,Сәлеметсіз бе, директор Нирасаки.
Dialogue: 0,1:24:09.04,1:24:11.04,Default,,0,0,0,,Ах! (Нобуо) Жарайды...
Dialogue: 0,1:24:11.37,1:24:13.00,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,1:24:13.13,1:24:15.75,Default,,0,0,0,,Мен сізді жердің қай жеріне апарып жатыр деп ойладым.
Dialogue: 0,1:24:15.88,1:24:18.92,Default,,0,0,0,,Мен шынымен не болатынын ойладым.
Dialogue: 0,1:24:19.30,1:24:21.80,Default,,0,0,0,,Аа, күте тұрыңыз, мен қазір кетемін.
Dialogue: 0,1:24:24.89,1:24:25.31,Default,,0,0,0,,Ахх...
Dialogue: 0,1:24:25.31,1:24:27.39,Default,,0,0,0,,Ахх...
Dialogue: 0,1:24:25.31,1:24:27.39,Default,,0,0,0,,♪〜
Dialogue: 0,1:24:27.39,1:24:29.77,Default,,0,0,0,,♪〜
Dialogue: 0,1:24:29.85,1:24:36.57,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:24:36.69,1:24:38.15,Default,,0,0,0,,Иіс...
Dialogue: 0,1:24:47.24,1:24:53.25,Default,,0,0,0,,〜♪
Dialogue: 0,1:24:57.88,1:25:04.89,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,1:25:05.01,1:25:12.02,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,1:25:16.11,1:25:19.82,Default,,0,0,0,,Оян, сабаққа кешігесің.
Dialogue: 0,1:25:28.91,1:25:31.58,Default,,0,0,0,,Хуайи
Dialogue: 0,1:25:33.67,1:25:36.63,Default,,0,0,0,,Не болды? Сіз әлі ұйықтап жатырсыз ба?
Dialogue: 0,1:25:36.75,1:25:39.21,Default,,0,0,0,,Енді жоқ... сен мені тыңдамайсың.
Dialogue: 0,1:25:39.34,1:25:40.63,Default,,0,0,0,,Шынымен
Dialogue: 0,1:25:40.76,1:25:44.43,Default,,0,0,0,,Маған кешкі асқа 30 минут қалғанда тұру керектігін айтады.
Dialogue: 0,1:25:46.97,1:25:47.93,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,1:25:48.05,1:25:54.06,Default,,0,0,0,,♪〜
Dialogue: 0,1:26:03.82,1:26:09.83,Default,,0,0,0,,〜♪
Dialogue: 0,1:26:09.95,1:26:11.87,Default,,0,0,0,,Асығыңыз
Dialogue: 0,1:26:13.37,1:26:17.50,Default,,0,0,0,,Иә
Dialogue: 0,1:26:17.63,1:26:19.34,Default,,0,0,0,,Көру
Dialogue: 0,1:26:22.05,1:26:25.80,Default,,0,0,0,,１ ２… １ ２… １ ２…
Dialogue: 0,1:26:25.93,1:26:27.84,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:26:28.64,1:26:32.14,Default,,0,0,0,,Неліктен бұл бала оятар сағатын ертерек қояды?
Dialogue: 0,1:26:32.27,1:26:35.23,Default,,0,0,0,,Менің ойымша, барлығы дүйсенбі, сәрсенбі және жұма күндері таңғы жаттығуға қатысады.
Dialogue: 0,1:26:35.35,1:26:38.98,Default,,0,0,0,,Қанша ерікті қатысса да, мұғалімдер де қатысады.
Dialogue: 0,1:26:39.11,1:26:41.19,Default,,0,0,0,,Бұл бағалауға да әсер етеді.
Dialogue: 0,1:26:41.57,1:26:45.82,Default,,0,0,0,,Маған келесі тоқсанда міндетті түрде шәкіртақы алуым керек.
Dialogue: 0,1:26:45.95,1:26:47.66,Default,,0,0,0,,Оқу ақысы өсуде
Dialogue: 0,1:26:47.78,1:26:50.53,Default,,0,0,0,,Әкемнің жалақысы көтерілмейді.
Dialogue: 0,1:26:55.08,1:26:58.75,Default,,0,0,0,,Анашым, анашым, маған Music Met сатып алыңыз.
Dialogue: 0,1:26:58.88,1:27:00.29,Default,,0,0,0,,Музыка Met
Dialogue: 0,1:27:00.42,1:27:02.67,Default,,0,0,0,,Өткен күні ата-аналар жиналысында тыйым салынды.
Dialogue: 0,1:27:02.80,1:27:04.42,Default,,0,0,0,,Өйткені бұл қауіпті.
Dialogue: 0,1:27:04.55,1:27:07.05,Default,,0,0,0,,Өйткені барлығы бірдей киеді.
Dialogue: 0,1:27:07.18,1:27:09.26,Default,,0,0,0,,Тіпті менің қасымда отырған бала да
Dialogue: 0,1:27:09.39,1:27:12.68,Default,,0,0,0,,Ата-анаңды тыңдамасаң, бағаң көтерілмейді.
Dialogue: 0,1:27:12.81,1:27:15.73,Default,,0,0,0,,Таңертеңгілік практикаға қатыса алмайды және стипендиат бола алмайды
Dialogue: 0,1:27:15.85,1:27:19.02,Default,,0,0,0,,Тек өзіңіз қалаған нәрсені сатып алсаңыз, оған көмектесу мүмкін емес.
Dialogue: 0,1:27:19.15,1:27:20.86,Default,,0,0,0,,Сәлем әке
Dialogue: 0,1:27:20.98,1:27:23.61,Default,,0,0,0,,Иә? Бұл дұрыс
Dialogue: 0,1:27:23.73,1:27:26.36,Default,,0,0,0,,Бүгінгі жел батыстан соғады Желдің күші 5
Dialogue: 0,1:27:26.49,1:27:27.32,Default,,0,0,0,,Түстен кейін...
Dialogue: 0,1:27:27.40,1:27:29.61,Default,,0,0,0,,Жақсы, орындалды, иә.
Dialogue: 0,1:27:30.49,1:27:31.45,Default,,0,0,0,,Иә
Dialogue: 0,1:27:31.99,1:27:33.08,Default,,0,0,0,,Хмм...
Dialogue: 0,1:27:33.20,1:27:34.95,Default,,0,0,0,,Осы айдың ұраны...
Dialogue: 0,1:27:35.16,1:27:35.75,Default,,0,0,0,,Атып ал, ат, бар күшіңмен, Қала үшін.
Dialogue: 0,1:27:35.75,1:27:38.67,Default,,0,0,0,,Ат, ат, бар күшіңмен, Қала үшін.
Dialogue: 0,1:27:35.75,1:27:38.67,Default,,0,0,0,,Асықпасаң, №7 пойыз кетеді, әке.
Dialogue: 0,1:27:38.79,1:27:39.25,Default,,0,0,0,,Оқ, ат, бар күшіңмен, Қала үшін.
Dialogue: 0,1:27:39.25,1:27:40.46,Default,,0,0,0,,Оқ, ат, бар күшіңмен, қала үшін.
Dialogue: 0,1:27:39.25,1:27:40.46,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:27:40.46,1:27:40.58,Default,,0,0,0,,Ату, ат, бар күшіңмен, қала үшін.
Dialogue: 0,1:27:40.58,1:27:42.79,Default,,0,0,0,,Атқан, ат, бар күшіңмен, Қала үшін.
Dialogue: 0,1:27:40.58,1:27:42.79,Default,,0,0,0,,Тез, тез, тез, тез!
Dialogue: 0,1:27:42.79,1:27:44.46,Default,,0,0,0,,Тез, тез, тез, тез!
Dialogue: 0,1:27:48.68,1:27:50.68,Default,,0,0,0,,Онда мен сені атып тастаймын.
Dialogue: 0,1:27:54.18,1:27:56.52,Default,,0,0,0,,Мен сені атып тастаймын.
Dialogue: 0,1:28:14.62,1:28:19.16,Default,,0,0,0,,17-ші батареяға бара жатқан пойыз 1-платформаға келеді.
Dialogue: 0,1:28:19.29,1:28:25.00,Default,,0,0,0,,Шығыс 17-ші станция Шығыс 17-ші станция
Dialogue: 0,1:29:09.88,1:29:16.01,Default,,0,0,0,,17-ші батареяның алдында 17-ші батареяның алдында
Dialogue: 0,1:29:40.75,1:29:44.92,Default,,0,0,0,,Оқ, ат, бар күшіңмен, қала үшін.
Dialogue: 0,1:29:45.04,1:29:49.42,Default,,0,0,0,,Оқ, ат, бар күшіңмен, қала үшін.
Dialogue: 0,1:29:50.96,1:29:53.76,Default,,0,0,0,,Сонымен №8 батареяның қызмет ету мерзімін жақсарту жөніндегі комитет
Dialogue: 0,1:29:53.88,1:29:56.93,Default,,0,0,0,,Сіз кездесуге бардым дейсіз бе, сонда не болып жатыр?
Dialogue: 0,1:29:57.05,1:29:59.01,Default,,0,0,0,,Әлеуметтік қамсыздандыру бөліміндегі үлкен жігіттермен араласу
Dialogue: 0,1:29:59.14,1:29:59.43,Default,,0,0,0,,Олар соғыста жесірлерге жақындау үшін азықтық азық-түлікті жем ретінде пайдаланған дейді.
Dialogue: 0,1:29:59.43,1:30:02.85,Default,,0,0,0,,Соғыстағы жесірлерге жақындау үшін жем ретінде пайдаланған дейді.
Dialogue: 0,1:29:59.43,1:30:02.85,Default,,0,0,0,,Шақыру басталардан 5 минут бұрын. Барлық мүшелер жинал.
Dialogue: 0,1:30:02.85,1:30:02.98,Default,,0,0,0,,Шақыру басталардан 5 минут бұрын. Барлық мүшелер жинал.
Dialogue: 0,1:30:02.98,1:30:03.27,Default,,0,0,0,,Қоңырау басталғанға дейін 5 минут бұрын. Барлық мүшелер жинал.
Dialogue: 0,1:30:02.98,1:30:03.27,Default,,0,0,0,,Анау әйел де ішімдік сататын дүкенде кассада жұмыс істейді.
Dialogue: 0,1:30:03.27,1:30:03.39,Default,,0,0,0,,Анау әйел де ішімдік сататын дүкенде кассада жұмыс істейді.
Dialogue: 0,1:30:03.39,1:30:05.48,Default,,0,0,0,,Мына әйел де ішімдік сататын дүкенде кассада жұмыс істейді.
Dialogue: 0,1:30:03.39,1:30:05.48,Default,,0,0,0,,Ережені сақтамағанның жеңісі жоқ.
Dialogue: 0,1:30:05.48,1:30:05.60,Default,,0,0,0,,Ережені сақтамағанның жеңісі жоқ.
Dialogue: 0,1:30:05.60,1:30:06.44,Default,,0,0,0,,Ережені сақтамағанның жеңісі жоқ.
Dialogue: 0,1:30:05.60,1:30:06.44,Default,,0,0,0,,Ол үш консервіге ұйықтағанын айтты.
Dialogue: 0,1:30:06.44,1:30:06.56,Default,,0,0,0,,Ол үш консервіге ұйықтағанын айтты.
Dialogue: 0,1:30:06.56,1:30:08.36,Default,,0,0,0,,Ол үш консервіге ұйықтағанын айтты.
Dialogue: 0,1:30:06.56,1:30:08.36,Default,,0,0,0,,Күн сайын талпыныс пен оқу
Dialogue: 0,1:30:08.69,1:30:12.49,Default,,0,0,0,,Оқ, ат, бар күшіңмен, қала үшін.
Dialogue: 0,1:30:18.32,1:30:19.37,Default,,0,0,0,,Жоғарыдағыдай
Dialogue: 0,1:30:19.49,1:30:23.45,Default,,0,0,0,,Тригонометриялық функцияларды қолдану синус косинусының тангенсі
Dialogue: 0,1:30:23.58,1:30:26.50,Default,,0,0,0,,Географиялық нысананың координаттары Түсіру сипаттамалары
Dialogue: 0,1:30:26.62,1:30:28.96,Default,,0,0,0,,Есептеу мүмкін болғанымен
Dialogue: 0,1:30:29.09,1:30:31.88,Default,,0,0,0,,Дәлдікті одан әрі жақсарту
Dialogue: 0,1:30:32.00,1:30:35.76,Default,,0,0,0,,Қателерді тудыратын сыртқы факторларды да ескеру қажет.
Dialogue: 0,1:30:35.88,1:30:40.85,Default,,0,0,0,,Бұл ең алдымен траекторияға әсер ететін жел бағыты мен жел жылдамдығы сияқты ауа райы жағдайлары.
Dialogue: 0,1:30:40.97,1:30:44.52,Default,,0,0,0,,немесе зарядтың жану шарттарын анықтаңыз—
Dialogue: 0,1:30:44.64,1:30:47.02,Default,,0,0,0,,Температура мен ылғалдылық та маңызды, бірақ
Dialogue: 0,1:30:47.15,1:30:50.52,Default,,0,0,0,,Мен мұны жаратылыстану сабақтарына қалдырамын...
Dialogue: 0,1:31:26.89,1:31:29.90,Default,,0,0,0,,Императорлық штабтың 9:20-дағы хабарламасы.
Dialogue: 0,1:31:30.02,1:31:35.48,Default,,0,0,0,,Шабуылдың нысаналы деректері Подшипник 2:15 Іске қосу бұрышы 42 градус
Dialogue: 0,1:31:36.90,1:31:39.95,Default,,0,0,0,,Барлық мүшелер сапқа тұрды, шақыру аяқталды
Dialogue: 0,1:31:40.07,1:31:43.58,Default,,0,0,0,,Қабықты жүктеу жұмысы басталады!
Dialogue: 0,1:31:50.04,1:31:53.25,Default,,0,0,0,,1 кезең 2 кезең Тасымалдау
Dialogue: 0,1:31:57.67,1:31:59.05,Default,,0,0,0,,Кранды түсіріңіз
Dialogue: 0,1:31:59.18,1:32:01.55,Default,,0,0,0,,Кранды түсіріңіз
Dialogue: 0,1:32:03.05,1:32:05.47,Default,,0,0,0,,Кранды түсіру
Dialogue: 0,1:32:21.41,1:32:22.74,Default,,0,0,0,,Ілгекті орнату аяқталды
Dialogue: 0,1:32:22.87,1:32:24.45,Default,,0,0,0,,Жарайды, жабыңыз!
Dialogue: 0,1:32:25.95,1:32:27.37,Default,,0,0,0,,Ораманы бастаңыз
Dialogue: 0,1:32:27.50,1:32:30.00,Default,,0,0,0,,Ораманы бастаңыз
