Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.18,0:00:36.35,Default,,0,0,0,,Бәріміз ән айтайық. Би билейік.
Dialogue: 0,0:00:36.35,0:00:39.85,Default,,0,0,0,,Пұттар да. Көйлектер де. Үлкен жиын
Dialogue: 0,0:00:39.85,0:00:44.35,Default,,0,0,0,,『Икацуон шеруі! ” басталады
Dialogue: 0,0:00:46.34,0:00:49.21,Default,,0,0,0,,...
Dialogue: 0,0:00:49.21,0:00:52.18,Default,,0,0,0,,Жұлдыздар гармония академиясының 2 курс орта мектебінің студенті
Dialogue: 0,0:00:52.18,0:00:56.72,Default,,0,0,0,,Менің арманым – бір күні өзім құрастырған премиум көйлекті кию.
Dialogue: 0,0:00:56.72,0:00:59.69,Default,,0,0,0,,Үлкен әпкемнің маған берген жарқыраған қабағы мені қозғады.
Dialogue: 0,0:00:59.69,0:01:02.86,Default,,0,0,0,,Мен танымайтын көптеген пұттармен дос болдым.
Dialogue: 0,0:01:02.86,0:01:06.31,Default,,0,0,0,,Мен шынымен де твимін. Бақытты.
Dialogue: 0,0:01:06.31,0:01:09.86,Default,,0,0,0,,Оның үстіне апамның тәжірибесінің әсерінен
Dialogue: 0,0:01:09.86,0:01:12.18,Default,,0,0,0,,Әртүрлі мектептер мен Икатсу әлемі байланысты
Dialogue: 0,0:01:12.18,0:01:14.20,Default,,0,0,0,,Біз бір болып кеткен сияқтымыз
Dialogue: 0,0:01:14.20,0:01:17.87,Default,,0,0,0,,Бірақ неге бұлай істеп жатырсың?
Dialogue: 0,0:01:17.87,0:01:20.24,Default,,0,0,0,,Айкацу инженерінің қарындасын іздеу кезінде
Dialogue: 0,0:01:20.24,0:01:23.24,Default,,0,0,0,,Бүгін де қолымыздан келгенді жасайық＞
Dialogue: 0,0:01:25.21,0:01:27.18,Default,,0,0,0,,Камералар айналып жатыр!
Dialogue: 0,0:01:27.18,0:01:32.85,Default,,0,0,0,,５ ４ ３ ２
Dialogue: 0,0:01:32.85,0:01:35.86,Default,,0,0,0,,Ciao! Мен Раки Химейшимін, тілшімін.
Dialogue: 0,0:01:35.86,0:01:38.52,Default,,0,0,0,,Бүгін Dream Park Land-де
Dialogue: 0,0:01:38.52,0:01:41.88,Default,,0,0,0,,Өте қызықты оқиға болып жатыр.
Dialogue: 0,0:01:41.88,0:01:44.58,Default,,0,0,0,,Бірден кеттік!
Dialogue: 0,0:01:46.93,0:01:49.85,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:01:49.85,0:01:51.87,Default,,0,0,0,,Loveyu~
Dialogue: 0,0:01:51.87,0:01:55.49,Default,,0,0,0,,Бұл пудингі бар Арисугава қыз~
Dialogue: 0,0:01:55.49,0:01:57.51,Default,,0,0,0,,Бұл Шион Камия.
Dialogue: 0,0:01:57.51,0:01:59.50,Default,,0,0,0,,Менің атым Сакура Китаодзи.
Dialogue: 0,0:01:59.50,0:02:02.52,Default,,0,0,0,,Бұл Flow Dreamer-тен Ако Саотоме.
Dialogue: 0,0:02:02.52,0:02:06.34,Default,,0,0,0,,Сол сияқты, Ханазоно Кирара йо Киран
Dialogue: 0,0:02:06.34,0:02:08.34,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:02:08.34,0:02:10.84,Default,,0,0,0,,Иә, оқиға
Dialogue: 0,0:02:10.84,0:02:15.51,Default,,0,0,0,,Іс-шараны танымал «Powa Powa Purin» және «Fuwa Fuwa Dreamer» бөлімшелері өткізеді.
Dialogue: 0,0:02:15.51,0:02:18.51,Default,,0,0,0,,Бұл жанкүйерлерді бағалау күні туралы!
Dialogue: 0,0:02:21.18,0:02:25.84,Default,,0,0,0,,Бүгін бәріңіздің уақытыңыз қызықты өтті деп үміттенемін.
Dialogue: 0,0:02:25.84,0:02:28.67,Default,,0,0,0,,Біз әртүрлі жоспарлар дайындадық.
Dialogue: 0,0:02:28.67,0:02:33.76,Default,,0,0,0,,Сондықтан әркім толқу керек!
Dialogue: 0,0:02:33.76,0:02:35.68,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:02:35.68,0:02:38.18,Default,,0,0,0,,Поваттофуватто. Жанкүйерлерге алғыс айту күні
Dialogue: 0,0:02:38.18,0:02:40.18,Default,,0,0,0,,ｽﾀｰﾄ！
Dialogue: 0,0:05:26.52,0:05:30.17,Default,,0,0,0,,Жанкүйерлерді бағалау күні Бұл өте жақсы оқиға.
Dialogue: 0,0:05:30.17,0:05:32.63,Default,,0,0,0,,Дұрыс па? Иә!
Dialogue: 0,0:05:32.63,0:05:35.18,Default,,0,0,0,,Бірақ неге бәрің біргесіңдер?
Dialogue: 0,0:05:35.18,0:05:40.83,Default,,0,0,0,,Себебі, мен бір күні Powa Dreamin бағдарламасындағы ән шоуына қатыстым.
Dialogue: 0,0:05:40.83,0:05:43.85,Default,,0,0,0,,Пова Dreamin? иә
Dialogue: 0,0:05:43.85,0:05:49.51,Default,,0,0,0,,Акотан, Кираратан және Отоме - ынтымақтастық бірлігі!
Dialogue: 0,0:05:49.51,0:05:52.51,Default,,0,0,0,,Кирара және басқалары шынымен жақсы достарға айналды.
Dialogue: 0,0:05:52.51,0:05:56.85,Default,,0,0,0,,Келесі жолы бір іс-шараны үлпілдеп, үлпілдек етіп жасайық.
Dialogue: 0,0:05:56.85,0:05:58.83,Default,,0,0,0,,Онда!
Dialogue: 0,0:05:58.83,0:06:02.86,Default,,0,0,0,,Біз ойын-сауық саябағын жалға беруді және жанкүйерлердің алғыс кешін өткізуді шештік.
Dialogue: 0,0:06:02.86,0:06:04.87,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:06:04.87,0:06:06.86,Default,,0,0,0,,Сахнада ғана емес, барлық жанкүйерлермен
Dialogue: 0,0:06:06.86,0:06:09.88,Default,,0,0,0,,Тікелей әрекеттесу үшін көп мүмкіндіктер жоқ.
Dialogue: 0,0:06:09.88,0:06:13.18,Default,,0,0,0,,Әй, бүгін менің барлық сүйікті жанкүйерлеріме.
Dialogue: 0,0:06:13.18,0:06:17.20,Default,,0,0,0,,Біз сізге үлкен махаббатты жеткіземіз.
Dialogue: 0,0:06:17.20,0:06:19.59,Default,,0,0,0,,Менің сүйікті жанкүйерім...
Dialogue: 0,0:06:19.59,0:06:21.62,Default,,0,0,0,,《Енді ойлап қарасам, мен
Dialogue: 0,0:06:21.62,0:06:24.86,Default,,0,0,0,,Мен өз жанкүйерлерімді ойламадым деп ойлаймын.
Dialogue: 0,0:06:24.86,0:06:27.21,Default,,0,0,0,,Бірақ бір мәселе бар.
Dialogue: 0,0:06:27.21,0:06:30.27,Default,,0,0,0,,Барлық жанкүйерлер ұнайды деп үміттенемін.
Dialogue: 0,0:06:30.27,0:06:34.52,Default,,0,0,0,,Лотереядан кейін небәрі 200 адам шақырылды.
Dialogue: 0,0:06:34.52,0:06:38.69,Default,,0,0,0,,Әй, жоқ желдеткіш не болады?
Dialogue: 0,0:06:38.69,0:06:43.58,Default,,0,0,0,,Барлығына қатысты не істеуім керек? (шапалақ дыбысы)
Dialogue: 0,0:06:43.58,0:06:45.87,Default,,0,0,0,,Сонымен
Dialogue: 0,0:06:45.87,0:06:49.52,Default,,0,0,0,,Бүгін келе алмағандар үшін Алғыс айту күні қандай болды.
Dialogue: 0,0:06:49.52,0:06:52.54,Default,,0,0,0,,Мен оны I-Tube арқылы трансляциялауды шештім.
Dialogue: 0,0:06:52.54,0:06:55.94,Default,,0,0,0,,Сондықтан мені тілші ретінде шақырды.
Dialogue: 0,0:06:55.94,0:06:57.86,Default,,0,0,0,,Бақытты, мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:06:57.86,0:07:00.51,Default,,0,0,0,,Кешіріңіз. (Nok)
Dialogue: 0,0:07:00.51,0:07:03.20,Default,,0,0,0,,Қайырлы таң. Қайырлы таң.
Dialogue: 0,0:07:03.20,0:07:07.20,Default,,0,0,0,,Раки-чан. Барлығы, неге?
Dialogue: 0,0:07:07.20,0:07:09.61,Default,,0,0,0,,Ал, біз
Dialogue: 0,0:07:09.61,0:07:13.21,Default,,0,0,0,,Бүгін мен сізді қызметкер ретінде қолдайтын боламын.
Dialogue: 0,0:07:13.21,0:07:16.86,Default,,0,0,0,,Дұрыс. Мен толқуды тоқтата алмаймын!
Dialogue: 0,0:07:16.86,0:07:19.53,Default,,0,0,0,,Келіңіздер! Уақыт таяп қалды
Dialogue: 0,0:07:19.53,0:07:22.20,Default,,0,0,0,,Бақытты, хабарлаңыз!
Dialogue: 0,0:07:22.20,0:07:24.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:24.19,0:07:26.21,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:07:26.21,0:07:28.21,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:07:28.21,0:07:31.51,Default,,0,0,0,,Повапури мұнда попкорн жасап жатыр.
Dialogue: 0,0:07:35.53,0:07:37.52,Default,,0,0,0,,Барлығы маған қарайды
Dialogue: 0,0:07:37.52,0:07:41.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:41.19,0:07:43.19,Default,,0,0,0,,Енді орындалды!
Dialogue: 0,0:07:43.19,0:07:46.59,Default,,0,0,0,,Повапури арнайы поп-конус
Dialogue: 0,0:07:46.59,0:07:49.61,Default,,0,0,0,,Келіңіздер, өтінемін.
Dialogue: 0,0:07:49.61,0:07:51.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:51.53,0:07:53.52,Default,,0,0,0,,ｱﾂｱﾂ｡ ｻｸｻｸ
Dialogue: 0,0:07:53.52,0:07:55.53,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:07:55.53,0:07:58.19,Default,,0,0,0,,Менде де болады.
Dialogue: 0,0:07:58.19,0:08:02.19,Default,,0,0,0,,Үлпілдек және қытырлақ! дәмді!
Dialogue: 0,0:08:02.19,0:08:05.19,Default,,0,0,0,,Бұл дәмді дәмнің сыры неде?
Dialogue: 0,0:08:05.19,0:08:07.86,Default,,0,0,0,,Өйткені, бұл құпия рецепт.
Dialogue: 0,0:08:07.86,0:08:11.25,Default,,0,0,0,,Себебі қыз попкорн жарнамасында болды.
Dialogue: 0,0:08:11.25,0:08:13.52,Default,,0,0,0,,Маған арнайы рецепт берілді.
Dialogue: 0,0:08:13.52,0:08:18.17,Default,,0,0,0,,Рецепт сияқты, Шион-саманың стоицизмі де негізгі мәселе болып табылады.
Dialogue: 0,0:08:18.17,0:08:24.18,Default,,0,0,0,,Шион-сама попкорн жасау үшін жүгері фермасына көшті.
Dialogue: 0,0:08:24.18,0:08:28.17,Default,,0,0,0,,Мен жүгерінің сезімін білуден бастадым.
Dialogue: 0,0:08:28.17,0:08:30.22,Default,,0,0,0,,Бұл Сакуратан
Dialogue: 0,0:08:30.22,0:08:32.20,Default,,0,0,0,,Мен көптеген дәмдерді зерттедім.
Dialogue: 0,0:08:32.20,0:08:34.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:34.26,0:08:37.19,Default,,0,0,0,,Соя сүтінің соя дәмі. Матча шоколадының дәмі
Dialogue: 0,0:08:37.19,0:08:40.85,Default,,0,0,0,,Ал күріштің дәмі! Омуриче дәмі!?
Dialogue: 0,0:08:40.85,0:08:43.50,Default,,0,0,0,,Бұл қыздың сүйікті тағамы.
Dialogue: 0,0:08:43.50,0:08:46.82,Default,,0,0,0,,Бұл таңқаларлық дәмді. Пекопекорин
Dialogue: 0,0:08:46.82,0:08:48.89,Default,,0,0,0,,Кешкі ас ішейік пе? О…
Dialogue: 0,0:08:48.89,0:08:53.16,Default,,0,0,0,,Оның дәмді болуының сыры - Пова Пури арасындағы тығыз қарым-қатынаста.
Dialogue: 0,0:08:53.16,0:08:55.18,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:08:55.18,0:08:57.85,Default,,0,0,0,,А-а... қолыңды қыссам болады ма?
Dialogue: 0,0:08:57.85,0:08:59.83,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:08:59.83,0:09:01.83,Default,,0,0,0,,Мен сені әрқашан қолдаймын
Dialogue: 0,0:09:01.83,0:09:05.40,Default,,0,0,0,,Рахмет, Махаббат!
Dialogue: 0,0:09:05.40,0:09:09.69,Default,,0,0,0,,Шион-сан, мынаған қол қоюыңа болады ма?
Dialogue: 0,0:09:09.69,0:09:12.53,Default,,0,0,0,,«Сенгоку ниндзя шиыршығы» ессіз!
Dialogue: 0,0:09:12.53,0:09:15.58,Default,,0,0,0,,Бұлай айтқанда, бұл сіздің күш-жігеріңізге тұрарлық.
Dialogue: 0,0:09:15.58,0:09:18.18,Default,,0,0,0,,Сакура-чанмен кездескеніме қатты қуандым!
Dialogue: 0,0:09:18.18,0:09:21.78,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын! Мен де ұмытпаймын
Dialogue: 0,0:09:24.51,0:09:34.18,Default,,0,0,0,,Әй, жанкүйерлердің арқасында кумирлер жарқырайды.
Dialogue: 0,0:09:34.18,0:09:38.57,Default,,0,0,0,,Сондықтан мен сіздермен өткізген құнды уақытымды бағалаймын.
Dialogue: 0,0:09:38.57,0:09:40.84,Default,,0,0,0,,Сіз ешқашан ұмыта алмайсыз
Dialogue: 0,0:09:40.84,0:09:44.18,Default,,0,0,0,,Уау
Dialogue: 0,0:09:44.18,0:09:46.85,Default,,0,0,0,,Тың қатты толқыды.
Dialogue: 0,0:09:46.85,0:09:50.27,Default,,0,0,0,,Бірақ мен бүгін мұңая алмаймын.
Dialogue: 0,0:09:50.27,0:09:53.84,Default,,0,0,0,,Біз көбірек сүйіспеншілікті жеткіземіз.
Dialogue: 0,0:09:53.84,0:09:56.87,Default,,0,0,0,,Бұл Китаодзи Сакура да жанып тұр!
Dialogue: 0,0:09:56.87,0:10:00.51,Default,,0,0,0,,Алғысымызды сахнада білдірейік
Dialogue: 0,0:10:00.51,0:10:05.16,Default,,0,0,0,,Сакура-тан Шион-тан кеттік!
Dialogue: 0,0:10:05.16,0:10:11.57,Default,,0,0,0,,Үлпілдек пудинг Сәттілік пудинг!
Dialogue: 0,0:10:11.57,0:10:15.02,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:10:15.02,0:10:32.37,Default,,0,0,0,,～
Dialogue: 0,0:10:32.37,0:10:36.86,Default,,0,0,0,,«Аспаннан келген үлпілдек»
Dialogue: 0,0:10:36.86,0:10:41.20,Default,,0,0,0,,«Қауырсын тәрізді періштенің жоғалған заты».
Dialogue: 0,0:10:41.20,0:10:47.14,Default,,0,0,0,,«Қос пальто киіп, қалада жүгіру».
Dialogue: 0,0:10:47.14,0:10:49.71,Default,,0,0,0,,«Мен саған асығуым керек».
Dialogue: 0,0:10:49.71,0:10:53.76,Default,,0,0,0,,«Ауа райы болжамы қар жауады».
Dialogue: 0,0:10:53.76,0:10:58.53,Default,,0,0,0,,«Бүгін мен оны көре алатын сияқтымын».
Dialogue: 0,0:10:58.53,0:11:03.04,Default,,0,0,0,,«Біз кездескеннен кейінгі бірінші қыс»
Dialogue: 0,0:11:03.04,0:11:07.38,Default,,0,0,0,,«Менің ақ тынысым шаттандырады».
Dialogue: 0,0:11:07.38,0:11:09.75,Default,,0,0,0,,«Қол қалтада»
Dialogue: 0,0:11:09.75,0:11:11.80,Default,,0,0,0,,«Жәй ғана оны шығарып алыңыз.»
Dialogue: 0,0:11:11.80,0:11:19.91,Default,,0,0,0,,«Оны қатты ұстаңыз және «Мен сені сүйемін!» деп айт. телепатия».
Dialogue: 0,0:11:19.91,0:11:24.86,Default,,0,0,0,,«Мен сенімен салқын желде серуендегім келеді».
Dialogue: 0,0:11:24.86,0:11:29.28,Default,,0,0,0,,«Қыс әндерін айту»
Dialogue: 0,0:11:29.28,0:11:33.19,Default,,0,0,0,,«Жаңбыр қарға айналғанда»
Dialogue: 0,0:11:33.19,0:11:37.69,Default,,0,0,0,,"Алғашқы қардың мерейтойында сүйісейік! Неткен нәрсе!"
Dialogue: 0,0:11:37.69,0:11:42.34,Default,,0,0,0,,«Аспаннан келген үлпілдек»
Dialogue: 0,0:11:42.34,0:11:46.87,Default,,0,0,0,,«Қауырсындай нәзік ақ»
Dialogue: 0,0:11:46.87,0:11:55.77,Default,,0,0,0,,«Жылдың ең әдемі күні екеумізді де қоршап алады».
Dialogue: 0,0:12:00.18,0:12:02.16,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:12:02.16,0:12:05.17,Default,,0,0,0,,Повапури - ең жақсы! шынымен ұнайды!
Dialogue: 0,0:12:05.17,0:12:07.57,Default,,0,0,0,,Үшеуі де сүйкімді!
Dialogue: 0,0:12:07.57,0:12:11.17,Default,,0,0,0,,Әні де, көйлегі де тамаша! тамаша!
Dialogue: 0,0:12:11.17,0:12:16.21,Default,,0,0,0,,Поватто Фуватто жанкүйерлерін бағалау күні өте қызықты!
Dialogue: 0,0:12:16.21,0:12:20.21,Default,,0,0,0,,Енді, «Ағынды арманшыға» барайық!
Dialogue: 0,0:14:02.25,0:14:04.69,Default,,0,0,0,,Осы үлпілдек алаңда
Dialogue: 0,0:14:04.69,0:14:06.84,Default,,0,0,0,,Fluffy Dreamer фанатының балалары
Dialogue: 0,0:14:06.84,0:14:09.51,Default,,0,0,0,,Уақытыңызды жақсы өткізіп жатқан сияқтысыз
Dialogue: 0,0:14:09.51,0:14:13.18,Default,,0,0,0,,Бірден кеттік!
Dialogue: 0,0:14:13.18,0:14:16.18,Default,,0,0,0,,Жұмсақ және жылы.
Dialogue: 0,0:14:16.18,0:14:19.18,Default,,0,0,0,,Ей, Қой Шаротан да сүйкімді.
Dialogue: 0,0:14:19.18,0:14:22.17,Default,,0,0,0,,Аконян мысық та өте сүйкімді!
Dialogue: 0,0:14:22.17,0:14:24.84,Default,,0,0,0,,Мысықтың... Аконян?
Dialogue: 0,0:14:24.84,0:14:27.84,Default,,0,0,0,,О, менің, менің, менің, Аконян...
Dialogue: 0,0:14:27.84,0:14:31.83,Default,,0,0,0,,Мен мысық емеспін. Солай ма?
Dialogue: 0,0:14:31.83,0:14:34.52,Default,,0,0,0,,Хэхехехехе~
Dialogue: 0,0:14:34.52,0:14:36.50,Default,,0,0,0,,ﾆｬﾆｬﾆｬ！
Dialogue: 0,0:14:36.50,0:14:38.49,Default,,0,0,0,,Хоре хоре! Нянян!
Dialogue: 0,0:14:38.49,0:14:40.52,Default,,0,0,0,,Ура! Жоқ!
Dialogue: 0,0:14:40.52,0:14:42.51,Default,,0,0,0,,Мен мұны істегім келеді! мен де!
Dialogue: 0,0:14:42.51,0:14:44.68,Default,,0,0,0,,Қараңдар, қараңдар! Не!?
Dialogue: 0,0:14:44.68,0:14:48.16,Default,,0,0,0,,ｱﾊﾊ…｡ ﾆｬｰｯ！
Dialogue: 0,0:14:48.16,0:14:50.83,Default,,0,0,0,,Тынш! Ақымақ болуды доғар!
Dialogue: 0,0:14:50.83,0:14:53.50,Default,,0,0,0,,Ашуланба!
Dialogue: 0,0:14:53.50,0:14:56.51,Default,,0,0,0,,Әй, мен бұл туралы біраздан бері ойлап жүрмін.
Dialogue: 0,0:14:56.51,0:14:59.51,Default,,0,0,0,,Екеуіңіздің қарым-қатынастарыңыз нашар ма? (2 адам) Иә?
Dialogue: 0,0:14:59.51,0:15:02.18,Default,,0,0,0,,Теледидардан жиі ұрысатынымыз үшін...
Dialogue: 0,0:15:02.18,0:15:04.85,Default,,0,0,0,,Арамыз жақсы емес пе деп ойлаймын...
Dialogue: 0,0:15:04.85,0:15:08.18,Default,,0,0,0,,Дұрыс. Мен білмедім.
Dialogue: 0,0:15:08.18,0:15:12.24,Default,,0,0,0,,Бұл дұрыс емес. Біз жақсы доспыз, солай ма? Ако-чан
Dialogue: 0,0:15:12.24,0:15:14.29,Default,,0,0,0,,Әй, бұл тым жақын!
Dialogue: 0,0:15:14.29,0:15:17.51,Default,,0,0,0,,Қараңдаршы! Екеуміздің қарым-қатынасымыз жақсы емес
Dialogue: 0,0:15:17.51,0:15:20.51,Default,,0,0,0,,Шок...｡ Бұл дұрыс емес.
Dialogue: 0,0:15:20.51,0:15:24.52,Default,,0,0,0,,Қазір біз жақсы немесе жаман қарым-қатынаста емеспіз.
Dialogue: 0,0:15:24.52,0:15:27.19,Default,,0,0,0,,Оны шірік жалғау деп атайды.
Dialogue: 0,0:15:27.19,0:15:30.17,Default,,0,0,0,,Шірік шеті? Басқаша айтқанда...
Dialogue: 0,0:15:30.17,0:15:32.99,Default,,0,0,0,,Басқаша айтқанда, біз жақсы қарым-қатынаста емеспіз!
Dialogue: 0,0:15:32.99,0:15:35.01,Default,,0,0,0,,Сонда сіз жақсы доссыз ба?
Dialogue: 0,0:15:35.01,0:15:38.50,Default,,0,0,0,,Бұл сізге Кирара ұнайтынын білдіре ме? Аа!?
Dialogue: 0,0:15:38.50,0:15:40.68,Default,,0,0,0,,ｼﾞｰｯ
Dialogue: 0,0:15:40.68,0:15:44.00,Default,,0,0,0,,А... әйтеуір... бұл...
Dialogue: 0,0:15:44.00,0:15:46.05,Default,,0,0,0,,Мен тек қағаз ғана лақтырамын.
Dialogue: 0,0:15:46.05,0:15:48.84,Default,,0,0,0,,Маған ұнамайды, керісінше...
Dialogue: 0,0:15:48.84,0:15:52.83,Default,,0,0,0,,Мүмкін маған ұнайтын шығар!
Dialogue: 0,0:15:52.83,0:15:54.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:54.85,0:15:58.78,Default,,0,0,0,,Акочан! Сондықтан тым жақын
Dialogue: 0,0:15:58.78,0:16:02.28,Default,,0,0,0,,Жүр, тікелей эфирге дайындалайық. Жақсы.
Dialogue: 0,0:16:05.17,0:16:07.49,Default,,0,0,0,,Жанкүйердің күлкісі – асыл қазына.
Dialogue: 0,0:16:07.49,0:16:10.83,Default,,0,0,0,,Иә! Барлығына көбірек күлкі сыйлайық!
Dialogue: 0,0:16:10.83,0:16:14.18,Default,,0,0,0,,Ако Саотоме жарқырайды
Dialogue: 0,0:16:14.18,0:16:17.50,Default,,0,0,0,,Жақсы, үлпілдек түс көрейік!
Dialogue: 0,0:16:17.50,0:16:21.19,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:16:21.19,0:16:44.51,Default,,0,0,0,,～
Dialogue: 0,0:16:44.51,0:16:50.54,Default,,0,0,0,,«Ой, тәтті және тәтті ыстық сүт».
Dialogue: 0,0:16:50.54,0:16:55.69,Default,,0,0,0,,«Суығанша айт».
Dialogue: 0,0:16:55.69,0:17:02.49,Default,,0,0,0,,«Тәтті армандар көремін деп үміттенемін».
Dialogue: 0,0:17:04.83,0:17:11.26,Default,,0,0,0,,«Әй, тербелген, тербелген шифон перде».
Dialogue: 0,0:17:11.26,0:17:16.01,Default,,0,0,0,,«Түнгі жел сыбырлады».
Dialogue: 0,0:17:16.01,0:17:25.17,Default,,0,0,0,,«Біз сізді құпия планетарийге шақырамыз».
Dialogue: 0,0:17:25.17,0:17:30.34,Default,,0,0,0,,«Бала қуыршақтарға арналған макарон түсі»
Dialogue: 0,0:17:30.34,0:17:35.55,Default,,0,0,0,,«Таспалармен шашыраңқы»
Dialogue: 0,0:17:35.55,0:17:40.70,Default,,0,0,0,,«Мақта кәмпитінің үлпілдек денесі»
Dialogue: 0,0:17:40.70,0:17:46.00,Default,,0,0,0,,«Мені қатты ұстаңыз».
Dialogue: 0,0:17:48.71,0:17:53.52,Default,,0,0,0,,«Онегай көңілді, қой көңілді»
Dialogue: 0,0:17:53.52,0:17:58.94,Default,,0,0,0,,«Мен түсімде де ойнағым келеді».
Dialogue: 0,0:17:58.94,0:18:03.21,Default,,0,0,0,,«Біз әрқашан дос боламыз, солай ма?»
Dialogue: 0,0:18:03.21,0:18:09.21,Default,,0,0,0,,«Бүгін, ертең және мәңгі».
Dialogue: 0,0:18:09.21,0:18:16.86,Default,,0,0,0,,«Мен ересек болсам да»
Dialogue: 0,0:18:16.86,0:18:21.86,Default,,0,0,0,,«Бірге қайырлы түн».
Dialogue: 0,0:18:27.02,0:18:30.20,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:18:30.20,0:18:32.85,Default,,0,0,0,,Flowy Dreamer-тің өте сүйкімді сахнасы
Dialogue: 0,0:18:32.85,0:18:34.87,Default,,0,0,0,,жеткізілді
Dialogue: 0,0:18:34.87,0:18:37.86,Default,,0,0,0,,Екеуің шынымен жақын екенсіңдер деп қызғанамын.
Dialogue: 0,0:18:37.86,0:18:39.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:43.85,0:18:46.54,Default,,0,0,0,,Бұл не? Бұл қорқынышты
Dialogue: 0,0:18:46.54,0:18:49.19,Default,,0,0,0,,Саябақта барлық электр жарығы өшіп қалған сияқты.
Dialogue: 0,0:18:49.19,0:18:51.17,Default,,0,0,0,,Оның себебі неде?
Dialogue: 0,0:18:51.17,0:18:53.19,Default,,0,0,0,,Міне
Dialogue: 0,0:18:53.19,0:18:56.19,Default,,0,0,0,,Dream Park Land-ті Коко басып алды.
Dialogue: 0,0:18:56.19,0:18:58.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:58.20,0:19:01.03,Default,,0,0,0,,Неге мұндай сұмдық жасайсың!
Dialogue: 0,0:19:01.03,0:19:04.90,Default,,0,0,0,,Ешқандай себеп жоқ! Барлығыңыз, шығыңыздар!
Dialogue: 0,0:19:04.90,0:19:06.96,Default,,0,0,0,,ｲｰｯ！ ｷｬｱｯ！
Dialogue: 0,0:19:06.96,0:19:11.18,Default,,0,0,0,,Хехехе... Мен бұл жерден тез кететін шығармын.
Dialogue: 0,0:19:11.18,0:19:14.18,Default,,0,0,0,,Егер сіз кетпесеңіз...
Dialogue: 0,0:19:14.18,0:19:17.22,Default,,0,0,0,,Жаса! Алақай!
Dialogue: 0,0:19:17.22,0:19:19.20,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:19:19.20,0:19:21.20,Default,,0,0,0,,Не!? Ол кім?
Dialogue: 0,0:19:25.26,0:19:27.86,Default,,0,0,0,,Қайсысы қоқыс екенін айтып бере аласыз ба?
Dialogue: 0,0:19:27.86,0:19:31.86,Default,,0,0,0,,ﾒｶﾞﾐ･ﾊﾟﾙﾌｪ！
Dialogue: 0,0:19:31.86,0:19:35.93,Default,,0,0,0,,ﾒｶﾞﾐ･ﾏﾃﾘｱﾙ！
Dialogue: 0,0:19:35.93,0:19:38.93,Default,,0,0,0,,ﾒｶﾞﾐ･ﾒﾛﾃﾞｨｰ！
Dialogue: 0,0:19:40.87,0:19:43.27,Default,,0,0,0,,Уау!!
Dialogue: 0,0:19:45.38,0:19:47.53,Default,,0,0,0,,Барлығының күлкісін қорғау үшін!
Dialogue: 0,0:19:47.53,0:19:49.88,Default,,0,0,0,,Ерліктің әуенін ойнап, айт!
Dialogue: 0,0:19:49.88,0:19:54.19,Default,,0,0,0,,Махаббат пен бейбітшіліктің жаршылары, біз кумир тобымыз!
Dialogue: 0,0:19:54.19,0:19:58.19,Default,,0,0,0,,ｻﾝﾒｶﾞﾐ！
Dialogue: 0,0:19:58.19,0:20:01.19,Default,,0,0,0,,Айне-чан, Мио-чан және Юмэ-чан!?
Dialogue: 0,0:20:01.19,0:20:03.20,Default,,0,0,0,,Бұл батыр болды ма?
Dialogue: 0,0:20:03.20,0:20:07.18,Default,,0,0,0,,Санмегами немесе Санмакамэ екенін білмеймін, бірақ жасайық!
Dialogue: 0,0:20:07.18,0:20:09.55,Default,,0,0,0,,ｲｰｯ！
Dialogue: 0,0:20:09.55,0:20:11.55,Default,,0,0,0,,ﾚｲﾝﾎﾞｰﾌﾞﾚｰﾄﾞ！
Dialogue: 0,0:20:15.52,0:20:17.82,Default,,0,0,0,,Ха! Алақай!
Dialogue: 0,0:20:21.18,0:20:23.57,Default,,0,0,0,,ﾏﾃﾘｱﾙｳｨｯﾌﾟ！
Dialogue: 0,0:20:23.57,0:20:28.84,Default,,0,0,0,,Ха! Ха! Ха!
Dialogue: 0,0:20:28.84,0:20:31.86,Default,,0,0,0,,ﾒﾛﾃﾞｨｰｼｭｰﾀｰ！ ｲｯ！
Dialogue: 0,0:20:31.86,0:20:34.23,Default,,0,0,0,,ﾔｯ！ ﾔｰｯ！
Dialogue: 0,0:20:34.23,0:20:36.86,Default,,0,0,0,,Күшті және керемет!
Dialogue: 0,0:20:36.86,0:20:39.53,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:20:39.53,0:20:44.54,Default,,0,0,0,,Марин-оне-санмен бірге Санмегамиге қолдау көрсетейік!
Dialogue: 0,0:20:44.54,0:20:46.96,Default,,0,0,0,,(қолдау)
Dialogue: 0,0:20:46.96,0:20:48.86,Default,,0,0,0,,Сәлем! Алақай!
Dialogue: 0,0:20:48.86,0:20:51.51,Default,,0,0,0,,ﾒｰｯ！ ｼｬｰｯ！
Dialogue: 0,0:20:51.51,0:20:53.53,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:53.53,0:20:56.90,Default,,0,0,0,,Бұл... Соңы жоқ!
Dialogue: 0,0:20:56.90,0:20:59.20,Default,,0,0,0,,Иә! Бұл өлімге әкелетін кезең!
Dialogue: 0,0:20:59.20,0:21:01.87,Default,,0,0,0,,Бұл Санмегами-тан кезеңі~
Dialogue: 0,0:21:01.87,0:21:07.53,Default,,0,0,0,,Кәне, бәріміз бір-бірімізге қолдау көрсетейік! Рақмет сізге! Рақмет сізге!
Dialogue: 0,0:21:07.53,0:21:16.52,Default,,0,0,0,,ｻﾝﾒｶﾞﾐ！ ｻﾝﾒｶﾞﾐ！ ｻﾝﾒｶﾞﾐ！ ｻﾝﾒｶﾞﾐ！
Dialogue: 0,0:21:16.52,0:21:19.19,Default,,0,0,0,,ﾀﾞﾝｼﾝ ｼﾝｷﾞﾝ ｼｬｲﾆﾝｸﾞ！
Dialogue: 0,0:21:19.19,0:21:21.56,Default,,0,0,0,,Жалғастырыңыз!
Dialogue: 0,0:21:21.56,0:21:24.61,Default,,0,0,0,,Ритм және Исм Мегамис сәулесі!
Dialogue: 0,0:21:24.61,0:21:27.61,Default,,0,0,0,,ｽﾃｰｼﾞ ｶﾓﾝ！
Dialogue: 0,0:21:32.23,0:21:37.23,Default,,0,0,0,,«Идол тобы Санмегами»
Dialogue: 0,0:21:39.22,0:21:41.82,Default,,0,0,0,,｢ﾚｯﾂ ﾀﾞﾝｽ！｣
Dialogue: 0,0:21:45.55,0:21:47.55,Default,,0,0,0,,｢ﾚｯﾂ ｼﾝｸﾞ！｣
Dialogue: 0,0:21:53.19,0:21:59.63,Default,,0,0,0,,«Үміт үні денеңде ағып жатыр» (1, 2, 3, ЖЕТ!)»
Dialogue: 0,0:21:59.63,0:22:05.52,Default,,0,0,0,,«Өмірдің байланысты ырғағымен жүр! Жүгір! Жіберу! Музыка! »
Dialogue: 0,0:22:05.52,0:22:08.52,Default,,0,0,0,,«Аюлы және бычий, бәрі қамтылған».
Dialogue: 0,0:22:08.52,0:22:11.51,Default,,0,0,0,,«Менде бірдеңе өзгеретін сияқты (1, 2, 3, ЖЕТ!)»
Dialogue: 0,0:22:11.51,0:22:18.18,Default,,0,0,0,,«Осы жерден Кисекиге емес, Кизунаға сенуге батылдық табасың».
Dialogue: 0,0:22:18.18,0:22:23.18,Default,,0,0,0,,«Төмен қарама, маған күлімсіреуіңді көрсеткеніңді қалаймын».
Dialogue: 0,0:22:23.18,0:22:30.53,Default,,0,0,0,,«Кәне, көңіл көтер! Қараңдар! Қараңдар! Орныңыздан тұрыңыз».
Dialogue: 0,0:22:30.53,0:22:33.51,Default,,0,0,0,,«Дыбыс күшті! Барлығының одақтасы!!»
Dialogue: 0,0:22:33.51,0:22:36.53,Default,,0,0,0,,«Қарғыс атсын! Биш! (Биш!) Баши! (Баш!) Зарядтау! »
Dialogue: 0,0:22:36.53,0:22:39.52,Default,,0,0,0,,«Бұл жүрек соғуы бар крессендо! »
Dialogue: 0,0:22:39.52,0:22:41.55,Default,,0,0,0,,«Та! (Таа!) Кімге! (Тым!)»
Dialogue: 0,0:22:41.55,0:22:43.61,Default,,0,0,0,,«Кеттік! "" бірге! »
Dialogue: 0,0:22:43.61,0:22:48.86,Default,,0,0,0,,«Мен жеңілмеймін, мен күштімін (иә). Мен күштімін (иә).
Dialogue: 0,0:22:48.86,0:22:54.55,Default,,0,0,0,,«Тіке үйлесім, зұлымдықты өзгерт (иә) және жең! жең! Әділдіктің мәні»
Dialogue: 0,0:22:54.55,0:23:03.89,Default,,0,0,0,,«Армандарды қорғау миссиясы (1, 2, 3, GO!)»
Dialogue: 0,0:23:03.89,0:23:08.29,Default,,0,0,0,,«Идол тобы Санмегами»
Dialogue: 0,0:23:11.22,0:23:13.52,Default,,0,0,0,,｢ﾚｯﾂ ﾀﾞﾝｽ！｣
Dialogue: 0,0:23:17.21,0:23:19.21,Default,,0,0,0,,｢ﾚｯﾂ ｼﾝｸﾞ！｣
Dialogue: 0,0:23:27.03,0:23:29.03,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:23:29.03,0:23:31.02,Default,,0,0,0,,Бүгінге бәрі осы!
Dialogue: 0,0:23:31.02,0:23:33.02,Default,,0,0,0,,Шегіну!! Яй!
Dialogue: 0,0:23:33.02,0:23:35.54,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:23:35.54,0:23:39.51,Default,,0,0,0,,Жақсы! Коко мен енді жамандық жасамаймын!
Dialogue: 0,0:23:39.51,0:23:42.21,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:23:45.35,0:23:47.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:47.34,0:23:49.70,Default,,0,0,0,,​​Барлығыңызға рахмет!
Dialogue: 0,0:23:49.70,0:23:53.49,Default,,0,0,0,,Барлығының қолдауының арқасында тыныштық орнады.
Dialogue: 0,0:23:53.49,0:23:59.50,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:23:59.50,0:24:01.52,Default,,0,0,0,,ﾋｰﾛｰｼｮｰ！
Dialogue: 0,0:24:01.52,0:24:03.50,Default,,0,0,0,,Үлкен жетістік!
Dialogue: 0,0:24:03.50,0:24:06.19,Default,,0,0,0,,нені білдіреді?
Dialogue: 0,0:24:06.19,0:24:09.17,Default,,0,0,0,,Бұрынғы көрсеткен қойылымымыз балалардың көңілінен шығу болатын.
Dialogue: 0,0:24:09.17,0:24:11.18,Default,,0,0,0,,Барлығымен бірге жоспарланған болатын.
Dialogue: 0,0:24:11.18,0:24:14.50,Default,,0,0,0,,Сценарийді Сакура-чан жазған
Dialogue: 0,0:24:14.50,0:24:17.85,Default,,0,0,0,,Шион Чан әрекет жасайды...
Dialogue: 0,0:24:17.85,0:24:21.19,Default,,0,0,0,,Ако-чан мен Кирара-чан басқарды
Dialogue: 0,0:24:21.19,0:24:24.51,Default,,0,0,0,,Отоме-чан шоуды жүргізді, солай ма?
Dialogue: 0,0:24:24.51,0:24:27.58,Default,,0,0,0,,Мен оны мүлде байқамадым!
Dialogue: 0,0:24:27.58,0:24:30.50,Default,,0,0,0,,Мен Лакидің шынайы есеп беруін қаладым.
Dialogue: 0,0:24:30.50,0:24:32.50,Default,,0,0,0,,Мен мұны құпия ұстадым.
Dialogue: 0,0:24:32.50,0:24:36.52,Default,,0,0,0,,Кешіріңіз, Пеко Пекорин. А, жоқ...
Dialogue: 0,0:24:36.52,0:24:39.94,Default,,0,0,0,,Бірақ бұл жанкүйерлерге ұнаған сияқты.
Dialogue: 0,0:24:39.94,0:24:41.84,Default,,0,0,0,,Жақсы. иә!
Dialogue: 0,0:24:41.84,0:24:44.51,Default,,0,0,0,,《Бәрі жанкүйерлер үшін》
Dialogue: 0,0:24:44.51,0:24:46.51,Default,,0,0,0,,Эй!! Сіздер қалайсыздар? Енді бәрі жақсы!!
Dialogue: 0,0:24:46.51,0:24:50.52,Default,,0,0,0,,Бүгін күні бойы жанкүйерлеріңізбен араласқаныңызды көрдім.
Dialogue: 0,0:24:50.52,0:24:54.17,Default,,0,0,0,,Мен бір нәрсе білдім!
Dialogue: 0,0:24:54.17,0:24:58.52,Default,,0,0,0,,Жанкүйерлер - айдолдар үшін ең жақсы нәрсе...
Dialogue: 0,0:24:58.52,0:25:01.58,Default,,0,0,0,,Бұл Loveyu!
Dialogue: 0,0:25:01.58,0:25:05.01,Default,,0,0,0,,Иә! Бұл сүйіспеншілікке толы тіршілік!
Dialogue: 0,0:25:05.01,0:25:07.52,Default,,0,0,0,,Міне, осы уақытқа дейін жеттік.
Dialogue: 0,0:25:07.52,0:25:11.50,Default,,0,0,0,,Барлығымен ойнағың келе ме? Ұнады, ұнайды!
Dialogue: 0,0:25:11.50,0:25:13.51,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:25:13.51,0:25:16.52,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:25:16.52,0:25:19.58,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:25:19.58,0:25:21.61,Default,,0,0,0,,Мен оны айналдырамын. Апыр-ай!
Dialogue: 0,0:25:21.61,0:25:23.52,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:25:23.52,0:25:27.17,Default,,0,0,0,,Жақсы! Бәріміз кеттік~
Dialogue: 0,0:25:27.17,0:25:29.84,Default,,0,0,0,,Асығыңыз, асығыңыз. Мен күтемін!
Dialogue: 0,0:25:29.84,0:25:31.84,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:25:31.84,0:25:34.24,Default,,0,0,0,,Сүйікті~!
Dialogue: 0,0:28:10.93,0:28:12.83,Default,,0,0,0,,Кирара да батыр болғысы келді!
Dialogue: 0,0:28:12.83,0:28:15.19,Default,,0,0,0,,Бұл Сакура да көмектеседі!
Dialogue: 0,0:28:15.19,0:28:17.17,Default,,0,0,0,,Мен мұны Кираранмен жасаймын!
Dialogue: 0,0:28:17.17,0:28:20.17,Default,,0,0,0,,Айтпақшы, біз немен күресеміз?
Dialogue: 0,0:28:21.67,0:28:27.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
