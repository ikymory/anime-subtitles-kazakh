Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.64,0:00:35.65,Default,,0,0,0,,Бәріміз ән айтайық...
Dialogue: 0,0:00:35.65,0:00:37.62,Default,,0,0,0,,Би билейік. Кумирлер де...
Dialogue: 0,0:00:37.62,0:00:40.04,Default,,0,0,0,,Көйлектер де... Үлкен жиын!
Dialogue: 0,0:00:40.04,0:00:45.63,Default,,0,0,0,,『Икацуон шеруі! «Ол басталады! Ой
Dialogue: 0,0:00:45.63,0:00:48.82,Default,,0,0,0,,＜ Чао! Мен Раки Химейши
Dialogue: 0,0:00:48.82,0:00:51.70,Default,,0,0,0,,Жұлдыздар гармония академиясының 2 курс орта мектебінің студенті
Dialogue: 0,0:00:51.70,0:00:54.64,Default,,0,0,0,,Үлкен әпкемнің маған берген жарқыраған қабағы мені қозғады.
Dialogue: 0,0:00:54.64,0:00:57.29,Default,,0,0,0,,Әртүрлі мектептер мен Икатсу әлемі байланысты
Dialogue: 0,0:00:57.29,0:01:00.15,Default,,0,0,0,,Біз бір болдық
Dialogue: 0,0:01:00.15,0:01:02.66,Default,,0,0,0,,Балық ойнап жүргенде бұл менің арманым еді.
Dialogue: 0,0:01:02.66,0:01:05.95,Default,,0,0,0,,Мен өз премиум мекенжайымды жасай алдым.
Dialogue: 0,0:01:05.95,0:01:09.49,Default,,0,0,0,,Мен шынымен де твимін. Бақытты
Dialogue: 0,0:01:09.49,0:01:14.16,Default,,0,0,0,,Бірақ сенің әпкең неге бұлай істеп жүр?
Dialogue: 0,0:01:14.16,0:01:16.65,Default,,0,0,0,,Айкацу инженерінің қарындасын іздеу кезінде
Dialogue: 0,0:01:16.65,0:01:19.95,Default,,0,0,0,,Бүгін де барымызды салайық＞
Dialogue: 0,0:01:28.97,0:01:31.99,Default,,0,0,0,,Керемет тұтынушылар. Күткендей бұл соңғы күн.
Dialogue: 0,0:01:31.99,0:01:36.48,Default,,0,0,0,,Хмм, ауа райы жақсы. Күннің ашық болғанына қуаныштымын.
Dialogue: 0,0:01:36.48,0:01:41.95,Default,,0,0,0,,Лаки-чан. Иә. Мен твиттершімін. Бақытты
Dialogue: 0,0:01:41.95,0:01:45.16,Default,,0,0,0,,Жылдың осы мезгілінде өте ыстық.
Dialogue: 0,0:01:45.16,0:01:47.56,Default,,0,0,0,,Бірінші күні жұлдызды жарық академиясы
Dialogue: 0,0:01:47.56,0:01:50.48,Default,,0,0,0,,Төрт жұлдызды академиясының екінші күні де керемет болды.
Dialogue: 0,0:01:50.48,0:01:53.47,Default,,0,0,0,,Бұл туралы барлық жерде айтылып жатыр.
Dialogue: 0,0:01:53.47,0:01:56.49,Default,,0,0,0,,Жұлдыз жарығы академиясы мен төрт жұлдыз академиясының барлығы.
Dialogue: 0,0:01:56.49,0:01:59.14,Default,,0,0,0,,Олар осында. (Майка) Біздің де үшінші күніміз.
Dialogue: 0,0:01:59.14,0:02:01.97,Default,,0,0,0,,Біз оны барынша қызықты етуіміз керек
Dialogue: 0,0:02:01.97,0:02:03.97,Default,,0,0,0,,Иә. Барымызды салайық!
Dialogue: 0,0:05:43.06,0:05:46.01,Default,,0,0,0,,үшінна сәттілік пен бақыт әкелетін оқиға
Dialogue: 0,0:05:46.01,0:05:51.50,Default,,0,0,0,,«Мен балық шеруі!» 3-ші күн басталады!
Dialogue: 0,0:05:51.50,0:05:55.00,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:05:59.66,0:06:03.18,Default,,0,0,0,,Бүгінгі күннің басты сәті, әрине, Достар кезеңі.
Dialogue: 0,0:06:03.18,0:06:06.15,Default,,0,0,0,,Юдзу және басқалары да бірлік құрайды.
Dialogue: 0,0:06:06.15,0:06:11.49,Default,,0,0,0,,Жұлдызды гармония академиясы бұған көп күш салуда, сондықтан мен оны асыға күтемін.
Dialogue: 0,0:06:11.49,0:06:15.34,Default,,0,0,0,,Бірінші кезең – Махаббат метеоры
Dialogue: 0,0:06:15.34,0:06:17.38,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:06:17.38,0:06:21.50,Default,,0,0,0,,Бұл Love Meatia-дан шыққан өте батыл.
Dialogue: 0,0:06:21.50,0:06:24.32,Default,,0,0,0,,Басынан бастап бұл ең жақсы Калиенте болды!
Dialogue: 0,0:06:24.32,0:06:28.17,Default,,0,0,0,,Басқаша айтқанда, бұл өте ыстық!
Dialogue: 0,0:06:28.17,0:06:31.23,Default,,0,0,0,,Бірдей тыныс, бір ырғақ
Dialogue: 0,0:06:31.23,0:06:34.16,Default,,0,0,0,,Қанатыңды мәңгіге жай, Карен
Dialogue: 0,0:06:34.16,0:06:37.50,Default,,0,0,0,,Бәрінен де жарқырай бер, Мирай
Dialogue: 0,0:06:37.50,0:06:44.32,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:06:44.32,0:06:50.31,Default,,0,0,0,,...
Dialogue: 0,0:06:50.31,0:06:56.65,Default,,0,0,0,,«Егер сіз Хикариді қаласаңыз, жақындасаңыз да кетіңіз».
Dialogue: 0,0:06:56.65,0:07:05.14,Default,,0,0,0,,«Сіз көз жұмып қалатын бірде-бір нәрсе жоқ».
Dialogue: 0,0:07:05.14,0:07:17.97,Default,,0,0,0,,...
Dialogue: 0,0:07:17.97,0:07:24.50,Default,,0,0,0,,«Арзан дүниеде жарқырай алмайсың ба?»
Dialogue: 0,0:07:24.50,0:07:30.80,Default,,0,0,0,,«Егер сіз қол созсаңыз, қол жеткізе алатын жарықтандыру»
Dialogue: 0,0:07:30.80,0:07:37.23,Default,,0,0,0,,«Сен шексіз арман алғың келе ме?»
Dialogue: 0,0:07:37.23,0:07:43.48,Default,,0,0,0,,«Мен мұнда қалағаннан гөрі қазір келгенді жақсы көремін...»
Dialogue: 0,0:07:43.48,0:07:46.87,Default,,0,0,0,,«Иә, сөздің қажеті жоқ».
Dialogue: 0,0:07:46.87,0:07:49.82,Default,,0,0,0,,«Енді оларды қабаттастырыңыз.»
Dialogue: 0,0:07:49.82,0:07:56.01,Default,,0,0,0,,«Себебі мен қанағаттанғым келмейді» «Себебі менің қолымнан келмейді»
Dialogue: 0,0:07:56.01,0:07:58.91,Default,,0,0,0,,«Ешқандай ымыра жоқ» «Ақырғы жоқ»
Dialogue: 0,0:07:58.91,0:08:01.41,Default,,0,0,0,,｢Жарқырауық｣
Dialogue: 0,0:08:03.82,0:08:10.26,Default,,0,0,0,,«Бағалы сыйлыққа ие бол және оны тектілікпен қалдыр».
Dialogue: 0,0:08:10.26,0:08:13.50,Default,,0,0,0,,«Мен оның өзгеретінін де білмеймін».
Dialogue: 0,0:08:13.50,0:08:16.87,Default,,0,0,0,,«Осы гауһар сияқты»
Dialogue: 0,0:08:16.87,0:08:22.99,Default,,0,0,0,,«Отты қаласаң, жақындасаң да аулақ жүр».
Dialogue: 0,0:08:22.99,0:08:31.81,Default,,0,0,0,,«Сіз көз жұма алатын ештеңе жоқ».
Dialogue: 0,0:08:31.81,0:08:46.14,Default,,0,0,0,,...
Dialogue: 0,0:08:46.14,0:08:51.12,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:08:51.12,0:08:54.04,Default,,0,0,0,,Ой... қызық емес пе?
Dialogue: 0,0:08:54.04,0:08:58.64,Default,,0,0,0,,Карен-сан мен Мираи-сан екеуі де керемет соло болды, бірақ...
Dialogue: 0,0:08:58.64,0:09:03.71,Default,,0,0,0,,Дос болғаныңызда, жеке ойнағаныңыздан басқа сүйкімділігіңіз бар.
Dialogue: 0,0:09:03.71,0:09:07.48,Default,,0,0,0,,Бір-біріңді жоғары көтеріп, одан сайын жарқыратыңдар
Dialogue: 0,0:09:07.48,0:09:10.32,Default,,0,0,0,,Бұл достар
Dialogue: 0,0:09:10.32,0:09:14.16,Default,,0,0,0,,Бұл Махаббат Меатиа. Бұл керемет
Dialogue: 0,0:09:14.16,0:09:19.76,Default,,0,0,0,,Бір күні мен Love Meatia немесе Pure Palette сияқты дос табамын.
Dialogue: 0,0:09:23.65,0:09:26.95,Default,,0,0,0,,Достар... бір күні мен де болады
Dialogue: 0,0:09:43.15,0:09:46.15,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:09:50.04,0:09:54.31,Default,,0,0,0,,Іс-шара жаңбыр тоқтағанша уақытша тоқтатылады.
Dialogue: 0,0:09:54.31,0:09:58.50,Default,,0,0,0,,Барлық келушілер гимназияға көшулеріңізді сұраймыз.
Dialogue: 0,0:09:58.50,0:10:02.49,Default,,0,0,0,,Коко-чан, бұл жаңбыр қанша уақытқа созылады?
Dialogue: 0,0:10:02.49,0:10:06.16,Default,,0,0,0,,Жарайды. Бұл өткінші жаңбыр, сондықтан жақын арада тоқтайтын сияқты.
Dialogue: 0,0:10:06.16,0:10:10.65,Default,,0,0,0,,Жақсы. Бұл жиі ашық фестивальдерде болады.
Dialogue: 0,0:10:10.65,0:10:12.65,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:10:16.32,0:10:19.47,Default,,0,0,0,,Иә! Ол бірден тазаланды. Бақытты
Dialogue: 0,0:10:19.47,0:10:22.17,Default,,0,0,0,,Ауа райы бұрынғыдай жақсы емес.
Dialogue: 0,0:10:24.83,0:10:26.98,Default,,0,0,0,,Ах, Каэл. Апыр-ай!
Dialogue: 0,0:10:26.98,0:10:29.46,Default,,0,0,0,,Ол дұрыс емес маусымда шықты ма?
Dialogue: 0,0:10:29.46,0:10:33.99,Default,,0,0,0,,Геко. Жоқ, бұл бақа - Харуниоми Гаэль.
Dialogue: 0,0:10:33.99,0:10:37.51,Default,,0,0,0,,Олар енді ғана шығып, белсенділік танытқан сияқты.
Dialogue: 0,0:10:37.51,0:10:41.66,Default,,0,0,0,,Эй, дұрыс.
Dialogue: 0,0:10:41.66,0:10:46.30,Default,,0,0,0,,Жақсы~! Бақалар... Толық бақалар!
Dialogue: 0,0:10:46.30,0:10:49.48,Default,,0,0,0,,Тағы~｡ Тағы не?
Dialogue: 0,0:10:49.48,0:10:53.15,Default,,0,0,0,,Негізінде осыған ұқсас нәрсе бұрын да болған.
Dialogue: 0,0:10:53.15,0:10:58.01,Default,,0,0,0,,Сол кезде маған Кареннің үй жануары жіберілді.
Dialogue: 0,0:10:58.01,0:11:00.58,Default,,0,0,0,,Карен-сан, өтінемін.
Dialogue: 0,0:11:00.58,0:11:03.47,Default,,0,0,0,,Сондай-ақ, Мока-чан, Чоко-чан және Марон-чан.
Dialogue: 0,0:11:03.47,0:11:06.97,Default,,0,0,0,,Маған біреуін жібере аласыз ба? кешіріңіз
Dialogue: 0,0:11:06.97,0:11:11.64,Default,,0,0,0,,Шын мәнінде, Мока-чан және басқалары қазір Карен аралында.
Dialogue: 0,0:11:11.64,0:11:16.16,Default,,0,0,0,,Ааа~ Бұл оқиғаға уақытында жетпейді.
Dialogue: 0,0:11:16.16,0:11:18.31,Default,,0,0,0,,Бірақ тұтынушылар
Dialogue: 0,0:11:18.31,0:11:20.65,Default,,0,0,0,,Мен эвакуация орнынан оралғалы жатырмын.
Dialogue: 0,0:11:20.65,0:11:24.32,Default,,0,0,0,,Не!? Бақа? Ұстаңыз! не? Бақа?
Dialogue: 0,0:11:24.32,0:11:27.32,Default,,0,0,0,,Оқиға бұлай жалғаса алмайды.
Dialogue: 0,0:11:30.98,0:11:34.48,Default,,0,0,0,,Құрметті келушілер, сәл күте тұрыңыз!
Dialogue: 0,0:11:40.65,0:11:43.97,Default,,0,0,0,,Бақытты-чан!? Біз бірдеңе істеуіміз керек!
Dialogue: 0,0:11:43.97,0:11:46.52,Default,,0,0,0,,ｹﾞｺｯ！
Dialogue: 0,0:11:46.52,0:11:50.81,Default,,0,0,0,,Мен барлығына шараның соңына дейін ләззат алғанын қалаймын.
Dialogue: 0,0:11:50.81,0:11:53.65,Default,,0,0,0,,Сонымен... уау
Dialogue: 0,0:11:53.65,0:11:57.82,Default,,0,0,0,,Сонымен... Өтінемін
Dialogue: 0,0:11:57.82,0:12:00.32,Default,,0,0,0,,Үйге қайт!
Dialogue: 0,0:12:00.32,0:12:04.32,Default,,0,0,0,,Лаки-чан. Біз де көмектесейік.
Dialogue: 0,0:12:16.79,0:12:19.14,Default,,0,0,0,,Судың иісі бар, Раки-чан
Dialogue: 0,0:12:19.14,0:12:21.66,Default,,0,0,0,,Өзім секіріп кеткеніме сене алар емеспін.
Dialogue: 0,0:12:21.66,0:12:25.31,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:12:25.31,0:12:30.82,Default,,0,0,0,,Досың қиындыққа тап болса, оны елемеуге болмайды. Кәне!
Dialogue: 0,0:12:30.82,0:12:33.87,Default,,0,0,0,,Мен бәрінің соңына дейін ләззат алғанын қалаймын.
Dialogue: 0,0:12:33.87,0:12:35.99,Default,,0,0,0,,Біз бәріміз бірдейміз.
Dialogue: 0,0:12:35.99,0:12:39.14,Default,,0,0,0,,Оны да әпкелеріңізге қалдырыңыз.
Dialogue: 0,0:12:39.14,0:12:42.24,Default,,0,0,0,,Дұрыс. Ол одан сайын қызық болып барады.
Dialogue: 0,0:12:48.82,0:12:52.17,Default,,0,0,0,,Рахмет. өтінемін
Dialogue: 0,0:12:52.17,0:13:00.00,Default,,0,0,0,,Мен Star Harmony академиясына ауыстым, мен шынымен күліп тұрмын.
Dialogue: 0,0:13:00.00,0:13:04.37,Default,,0,0,0,,ｳﾙﾄﾗ ﾐﾗｸﾙ ﾗｯｷｰ
Dialogue: 0,0:13:04.37,0:13:06.67,Default,,0,0,0,,Содан кейін бірге
Dialogue: 0,0:13:06.67,0:13:09.67,Default,,0,0,0,,ｱｲｶ～ﾂ！
Dialogue: 0,0:13:09.67,0:13:22.69,Default,,0,0,0,,...
Dialogue: 0,0:13:22.69,0:13:25.51,Default,,0,0,0,,Қараңыз. Апыр-ай!
Dialogue: 0,0:13:25.51,0:13:29.49,Default,,0,0,0,,Мен сізге көмектесе аламын ба? Мен де.
Dialogue: 0,0:13:29.49,0:13:33.49,Default,,0,0,0,,Біз де барайық. Иә. Иә!
Dialogue: 0,0:13:40.66,0:13:43.32,Default,,0,0,0,,үшін көмектесіп жатыр.
Dialogue: 0,0:13:43.32,0:13:48.85,Default,,0,0,0,,Бұл қандай да бір жолмен жұмыс істеуі мүмкін. Иә, барымызды салайық!
Dialogue: 0,0:13:48.85,0:14:08.65,Default,,0,0,0,,...
Dialogue: 0,0:14:08.65,0:14:11.75,Default,,0,0,0,,Ой... бітті.
Dialogue: 0,0:14:17.48,0:14:21.13,Default,,0,0,0,,Көмегің үшін барлығына рахмет.
Dialogue: 0,0:14:21.13,0:14:24.13,Default,,0,0,0,,Сізге рахмет, іс-шара жалғасуы мүмкін.
Dialogue: 0,0:14:24.13,0:14:26.82,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:14:26.82,0:14:29.02,Default,,0,0,0,,ﾌﾌｯ
Dialogue: 0,0:16:10.05,0:16:12.34,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:16:12.34,0:16:16.19,Default,,0,0,0,,, «Икатсу парадта!» 3-ші күні жалғасады
Dialogue: 0,0:16:16.19,0:16:18.48,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:16:18.48,0:16:21.48,Default,,0,0,0,,Келесі ән «Мен жалғыз емеспін!»
Dialogue: 0,0:16:21.48,0:16:28.17,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:16:28.17,0:16:35.00,Default,,0,0,0,,«Ұмытпаймын, қанша рет болса да айқайлаймын».
Dialogue: 0,0:16:35.00,0:16:38.48,Default,,0,0,0,,«Сіз жалғыз емессіз!»
Dialogue: 0,0:16:38.48,0:16:44.01,Default,,0,0,0,,...
Dialogue: 0,0:16:44.01,0:16:50.08,Default,,0,0,0,,«Мен әр адамның сезімін бір-бірлеп сыздым».
Dialogue: 0,0:16:50.08,0:16:58.35,Default,,0,0,0,,«Осы уақытқа дейін жалғасқан кенептер мені қайтадан күлдірді».
Dialogue: 0,0:16:58.35,0:17:04.74,Default,,0,0,0,,«Еңбек еткенің үшін көз жасын төгуге болмайды».
Dialogue: 0,0:17:04.74,0:17:13.20,Default,,0,0,0,,«Ойыңызды жаңартыңыз және келесі түске ауысыңыз».
Dialogue: 0,0:17:13.20,0:17:16.34,Default,,0,0,0,,«Мен бір нәрсеге өкінемін».
Dialogue: 0,0:17:16.34,0:17:19.17,Default,,0,0,0,,«Сіз тағы да бас тартамын дедіңіз».
Dialogue: 0,0:17:19.17,0:17:22.06,Default,,0,0,0,,«Бүгін кешегі күннен де болашақ»
Dialogue: 0,0:17:22.06,0:17:24.83,Default,,0,0,0,,«Ертең әлі белгісіз».
Dialogue: 0,0:17:24.83,0:17:27.72,Default,,0,0,0,,«Шексіздікке»
Dialogue: 0,0:17:27.72,0:17:30.27,Default,,0,0,0,,«Соңы жоқ»
Dialogue: 0,0:17:30.27,0:17:33.80,Default,,0,0,0,,«Дұрыс! Бұл Икацу!» «Бұл Икацу!»
Dialogue: 0,0:17:33.80,0:17:36.51,Default,,0,0,0,,«Бұл ең сүйкімді!» «Бұл ең сүйкімді!»
Dialogue: 0,0:17:36.51,0:17:41.83,Default,,0,0,0,,«Сенің еңбекқорлығыңның арқасында қозғалатын нәрселер бар».
Dialogue: 0,0:17:41.83,0:17:45.50,Default,,0,0,0,,«Сонымен, көбірек котлеттер!» «Көбірек котлеттер!»
Dialogue: 0,0:17:45.50,0:17:48.17,Default,,0,0,0,,«Мен оның балық екенін білдім!» «Мен оның балық екенін білдім!
Dialogue: 0,0:17:48.17,0:17:53.59,Default,,0,0,0,,«Әшекейдей жарқыра».
Dialogue: 0,0:17:53.59,0:17:58.33,Default,,0,0,0,,«Мен карталардың бірге жиналғанына сенімдімін».
Dialogue: 0,0:17:58.33,0:18:03.48,Default,,0,0,0,,«Бұл сіздің өміріңізді өзгертеді».
Dialogue: 0,0:18:03.48,0:18:06.00,Default,,0,0,0,,...
Dialogue: 0,0:18:06.00,0:18:08.94,Default,,0,0,0,,«Тым кең»
Dialogue: 0,0:18:08.94,0:18:11.49,Default,,0,0,0,,«Тым алыс»
Dialogue: 0,0:18:11.49,0:18:16.81,Default,,0,0,0,,«Мен жете алмаймын» деген оймен әлі де берілме».
Dialogue: 0,0:18:16.81,0:18:20.50,Default,,0,0,0,,"Кеттік! үшін жақсы!" «Бәрі жақсы!»
Dialogue: 0,0:18:20.50,0:18:23.17,Default,,0,0,0,,«Бәрі тамаша!» «Бәрі тамаша!»
Dialogue: 0,0:18:23.17,0:18:28.83,Default,,0,0,0,,«Әшекейдей жарқыра».
Dialogue: 0,0:18:28.83,0:18:33.50,Default,,0,0,0,,«Мен карталардың бірге жиналғанына сенімдімін».
Dialogue: 0,0:18:33.50,0:18:38.92,Default,,0,0,0,,«Бұл сіздің өміріңізді өзгертеді».
Dialogue: 0,0:18:38.92,0:18:43.82,Default,,0,0,0,,...
Dialogue: 0,0:18:43.82,0:18:49.20,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:18:49.20,0:18:52.27,Default,,0,0,0,,"Дұрыс! Бұл Икацу!" - Бұл Икацу!
Dialogue: 0,0:18:52.27,0:18:55.00,Default,,0,0,0,,«Бұл ең сүйкімді!» «Бұл ең сүйкімді!»
Dialogue: 0,0:18:55.00,0:19:00.16,Default,,0,0,0,,«Сенің еңбекқорлығыңның арқасында қозғалатын нәрселер бар».
Dialogue: 0,0:19:00.16,0:19:03.51,Default,,0,0,0,,«Сонымен, көбірек котлеттер!» «Көбірек котлеттер!»
Dialogue: 0,0:19:03.51,0:19:06.58,Default,,0,0,0,,үшін... ән айтып жатыр
Dialogue: 0,0:19:06.58,0:19:09.97,Default,,0,0,0,,"Дұрыс! Бұл Икацу!" Бұл бірлік сезімі тыныш емес.
Dialogue: 0,0:19:09.97,0:19:13.34,Default,,0,0,0,,үшін Раки-чан, Айне-чан, т.б.
Dialogue: 0,0:19:13.34,0:19:15.66,Default,,0,0,0,,Менің еңбектеніп жатқаныма қараңыз
Dialogue: 0,0:19:15.66,0:19:19.81,Default,,0,0,0,,көремін. Бірге еңбек ету арқылы жүрегіміз біртұтас болды.
Dialogue: 0,0:19:19.81,0:19:23.70,Default,,0,0,0,,«Сен де асыл тастай жарқыра».
Dialogue: 0,0:19:23.70,0:19:27.30,Default,,0,0,0,,"Кеттік! үшін жақсы!" «Бәрі жақсы!»
Dialogue: 0,0:19:27.30,0:19:30.82,Default,,0,0,0,,«Бәрі тамаша!» «Бәрі тамаша!»
Dialogue: 0,0:19:30.82,0:19:37.68,Default,,0,0,0,,«Ұмытпаймын, қанша рет болса да айқайлаймын».
Dialogue: 0,0:19:37.68,0:19:42.65,Default,,0,0,0,,«Сіз жалғыз емессіз!»
Dialogue: 0,0:19:42.65,0:19:45.75,Default,,0,0,0,,ﾌｯﾌｰ！
Dialogue: 0,0:19:48.14,0:19:51.71,Default,,0,0,0,,Керемет! Бұл қазір керемет болды
Dialogue: 0,0:19:51.71,0:19:54.33,Default,,0,0,0,,Бүркімен! Бүркімен, бүркімен, бүркімен
Dialogue: 0,0:19:54.33,0:19:59.35,Default,,0,0,0,,Иә, бұл менің достарымнан екеніне сенімдімін.
Dialogue: 0,0:19:59.35,0:20:03.25,Default,,0,0,0,,Лаки-чан, кел
Dialogue: 0,0:20:11.35,0:20:14.48,Default,,0,0,0,,Біреуді біреу жігерлендіреді
Dialogue: 0,0:20:14.48,0:20:18.99,Default,,0,0,0,,Мен қуып жеткім келетін сияқты және толқуымды тоқтата алмаймын...
Dialogue: 0,0:20:18.99,0:20:21.99,Default,,0,0,0,,Сол сезім байланыстырады, таратады
Dialogue: 0,0:20:21.99,0:20:27.18,Default,,0,0,0,,Өздігіңнен қолыңнан келмейтін нәрсені басқамен бірге жеңе аласың.
Dialogue: 0,0:20:27.18,0:20:32.17,Default,,0,0,0,,Жалғыз қалмау керемет. Достардың болғаны жақсы.
Dialogue: 0,0:20:32.17,0:20:34.67,Default,,0,0,0,,Бұл менің досымнан
Dialogue: 0,0:20:40.01,0:20:42.98,Default,,0,0,0,,3 күндік «Икацу парадта!» » сонымен қатар барлығыңызға рахмет
Dialogue: 0,0:20:42.98,0:20:45.66,Default,,0,0,0,,Үлкен жетістік
Dialogue: 0,0:20:45.66,0:20:48.33,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:20:48.33,0:20:52.34,Default,,0,0,0,,Бұл іс-шараны өткізуге не себеп болды?
Dialogue: 0,0:20:52.34,0:20:55.99,Default,,0,0,0,,Мені пұт ретінде үйреткендердің барлығына
Dialogue: 0,0:20:55.99,0:20:59.68,Default,,0,0,0,,Өйткені мен бір нәрсені қайтарғым келді
Dialogue: 0,0:20:59.68,0:21:03.16,Default,,0,0,0,,Бірақ мен бақыттымын және бақыттымын
Dialogue: 0,0:21:03.16,0:21:05.98,Default,,0,0,0,,Мен көп нәрсе алдым.
Dialogue: 0,0:21:05.98,0:21:08.49,Default,,0,0,0,,Сізге алғысымды айта алмаймын.
Dialogue: 0,0:21:08.49,0:21:13.16,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:21:13.16,0:21:15.33,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:21:15.33,0:21:19.00,Default,,0,0,0,,Encore Encore. иә?
Dialogue: 0,0:21:19.00,0:21:28.42,Default,,0,0,0,,ｱﾝｺｰﾙ ｱﾝｺｰﾙ…
Dialogue: 0,0:21:28.42,0:21:32.31,Default,,0,0,0,,Еңгізіңіз! Еңсеріңіз!
Dialogue: 0,0:21:32.31,0:21:38.20,Default,,0,0,0,,ｱﾝｺｰﾙ ｱﾝｺｰﾙ…
Dialogue: 0,0:21:38.20,0:21:42.25,Default,,0,0,0,,Икацу Икатсу…｡ Бұл Лаки Чан болуы керек.
Dialogue: 0,0:21:42.25,0:21:45.32,Default,,0,0,0,,Бұл тек бастамасы ғана. Иә, дұрыс.
Dialogue: 0,0:21:45.32,0:21:49.13,Default,,0,0,0,,Лаки-чан, асығыңыз. Кәне.
Dialogue: 0,0:21:49.13,0:21:51.98,Default,,0,0,0,,Икацу Икатсу…｡ Иә!
Dialogue: 0,0:21:51.98,0:21:59.30,Default,,0,0,0,,үшінна бақыт пен сәттілік әкелу үшін бар күшімді саламын.
Dialogue: 0,0:21:59.30,0:22:01.31,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:22:01.31,0:22:04.69,Default,,0,0,0,,«Мен сол күннен өзгеше болдым».
Dialogue: 0,0:22:04.69,0:22:09.99,Default,,0,0,0,,«Сәтті жақсы көргеніңіз үшін рахмет».
Dialogue: 0,0:22:14.02,0:22:18.02,Default,,0,0,0,,«Бұл ешқашан бітпейді».
Dialogue: 0,0:22:20.36,0:22:24.36,Default,,0,0,0,,«Әрқашан жақсы».
Dialogue: 0,0:22:26.70,0:22:30.30,Default,,0,0,0,,«Мен әрқашан жаныңдамын».
Dialogue: 0,0:22:33.02,0:22:36.72,Default,,0,0,0,,«Мен толық түсінемін».
Dialogue: 0,0:22:38.66,0:22:45.10,Default,,0,0,0,,«Әр күн кездейсоқ күн болды, бірдеңе жетіспеді».
Dialogue: 0,0:22:45.10,0:22:51.01,Default,,0,0,0,,«Мен өзімді бос сезіндім».
Dialogue: 0,0:22:51.01,0:22:57.01,Default,,0,0,0,,«Мен кенеттен жоғары қарасам, аспан тым биік және кең екен».
Dialogue: 0,0:22:57.01,0:23:03.67,Default,,0,0,0,,«Мен терең дем алып, есікті аштым».
Dialogue: 0,0:23:03.67,0:23:06.65,Default,,0,0,0,,«Жүректен жүрекке байланысты»
Dialogue: 0,0:23:06.65,0:23:09.66,Default,,0,0,0,,«Дыбыстар қабаттасады».
Dialogue: 0,0:23:09.66,0:23:16.31,Default,,0,0,0,,«Кішкене ерліктің болашағы осында».
Dialogue: 0,0:23:16.31,0:23:19.30,Default,,0,0,0,,«Мен сол күннен өзгеше болдым».
Dialogue: 0,0:23:19.30,0:23:22.65,Default,,0,0,0,,«Мен көп көз жасымды төктім».
Dialogue: 0,0:23:22.65,0:23:28.06,Default,,0,0,0,,«Ешқашан жоқ болып көрінген нақты нәрсе».
Dialogue: 0,0:23:28.06,0:23:31.98,Default,,0,0,0,,«Ақырында, әлемде бәрі өзгерді».
Dialogue: 0,0:23:31.98,0:23:37.67,Default,,0,0,0,,«Сәтті жақсы көргеніңіз үшін рахмет».
Dialogue: 0,0:23:37.67,0:23:41.66,Default,,0,0,0,,«Бір қадам алға - келесі кіреберіс».
Dialogue: 0,0:23:41.66,0:23:45.26,Default,,0,0,0,,«Бұл ешқашан бітпейді».
Dialogue: 0,0:23:47.33,0:23:51.73,Default,,0,0,0,,«Әрқашан жақсы».
Dialogue: 0,0:23:53.75,0:23:57.75,Default,,0,0,0,,«Мен әрқашан жаныңдамын».
Dialogue: 0,0:24:00.34,0:24:04.98,Default,,0,0,0,,«Мен толық түсінемін».
Dialogue: 0,0:24:04.98,0:24:09.65,Default,,0,0,0,,«Сіздің кіреберісіңіз»
Dialogue: 0,0:24:09.65,0:24:13.65,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:24:15.81,0:24:18.14,Default,,0,0,0,,Лаки-чан, 3 күн бойы тынымсыз еңбек еткеніңізге рахмет
Dialogue: 0,0:24:18.14,0:24:21.80,Default,,0,0,0,,Мен Бақытты алдым. Бұл шынымен көңілді болды.
Dialogue: 0,0:24:21.80,0:24:24.82,Default,,0,0,0,,Рахмет, Лаки-чан. Браво!
Dialogue: 0,0:24:24.82,0:24:29.02,Default,,0,0,0,,Не? Керемет сәттілік.
Dialogue: 0,0:28:10.67,0:28:15.16,Default,,0,0,0,,үшінна рахмет, бұл өте сәтті болды. Сізде достар болуы керек.
Dialogue: 0,0:28:15.16,0:28:18.63,Default,,0,0,0,,Достарыңыз көп, армандарыңыз көп, солай емес пе? Мио?
Dialogue: 0,0:28:18.63,0:28:20.63,Default,,0,0,0,,«Достар – қазына»
Dialogue: 0,0:30:37.74,0:30:40.87,Default,,0,0,0,,Бұл тікелей эфир болғандықтан, субтитрлерде типографиялық қателер болуы мүмкін. Түсінгеніңізге рахмет.
Dialogue: 0,0:30:42.37,0:30:48.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
