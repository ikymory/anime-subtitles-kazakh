Dialogue: 1,0:00:16.83,0:00:20.00, - ,atg7,0,0,0,,《Ани беруге болады》
Dialogue: 2,0:00:21.04,0:00:23.24, - ,atg1,0,0,0,,Эй, Анила нешеде?
Dialogue: 1,0:00:21.04,0:00:23.24, - ,atg7,0,0,0,,Қанша алдың?
Dialogue: 2,0:00:23.72,0:00:26.17, - ,atg1,0,0,0,,Мен ешқашан жасымды білмедім.
Dialogue: 1,0:00:23.72,0:00:26.17, - ,atg7,0,0,0,,Өзін-өзі бақылау
Dialogue: 2,0:00:26.63,0:00:29.74, - ,atg1,0,0,0,,Адамдар менің жасым 23-те екенін айтты.
Dialogue: 1,0:00:26.63,0:00:29.74, - ,atg7,0,0,0,,Мен басқа адамдардың мақсаттары үшін шамамен 23 жастамын.
Dialogue: 2,0:00:30.39,0:00:34.02, - ,atg1,0,0,0,,Сонымен, теңіз құмырасы жасы бойынша 4 жас шамасында.
Dialogue: 1,0:00:30.39,0:00:34.02, - ,atg7,0,0,0,,4 жыл қалды және 4 жыл бұрын
Dialogue: 2,0:00:34.37,0:00:35.98, - ,atg1,0,0,0,,Жасыңызды ескере отырып, шашыңыз ағарған.
Dialogue: 1,0:00:34.37,0:00:35.98, - ,atg7,0,0,0,,Жыл жылы
Dialogue: 2,0:00:36.39,0:00:38.02, - ,atg1,0,0,0,,Сәлем! Мені сұр шаш деп атама!
Dialogue: 1,0:00:36.39,0:00:38.02, - ,atg7,0,0,0,,Талантты болмасаңыз немесе шашыңыз ақ болса
Dialogue: 2,0:00:38.45,0:00:39.89, - ,atg1,0,0,0,,Бұл сұр шаш
Dialogue: 1,0:00:38.45,0:00:39.89, - ,atg7,0,0,0,,Айқайлап ағарған шаш
Dialogue: 2,0:00:40.38,0:00:42.48, - ,atg1,0,0,0,,Иә иә Ku Ray Hair Ku Ray Hair
Dialogue: 1,0:00:40.38,0:00:42.48, - ,atg7,0,0,0,,...
Dialogue: 2,0:00:42.48,0:00:44.60, - ,atg1,0,0,0,,Бұл Күрей емес, Сұр!
Dialogue: 1,0:00:42.48,0:00:44.60, - ,atg7,0,0,0,,Бірде-бір шаш ағарған шаш емес!
Dialogue: 2,0:00:45.24,0:00:47.09, - ,atg1,0,0,0,,Мен мұндай нәрсеге ашуланғаныма сене алар емеспін.
Dialogue: 1,0:00:45.24,0:00:47.09, - ,atg7,0,0,0,,Бұл нүкте шағын және маңызды.
Dialogue: 2,0:00:47.28,0:00:48.31, - ,atg1,0,0,0,,Баланың пои~
Dialogue: 1,0:00:47.28,0:00:48.31, - ,atg7,0,0,0,,Сен кішкентай баласың~
Dialogue: 2,0:00:49.02,0:00:50.60, - ,atg1,0,0,0,,Сіз сондайсыз
Dialogue: 1,0:00:49.02,0:00:50.60, - ,atg7,0,0,0,,Сіз кішкентайсыз.
Dialogue: 2,0:00:51.00,0:00:53.83, - ,atg1,0,0,0,,Сіз бір жарым жастасыз, бірақ әлі де суға түсе алмайсыз.
Dialogue: 1,0:00:51.00,0:00:53.83, - ,atg7,0,0,0,,...
Dialogue: 2,0:00:54.93,0:00:58.80, - ,atg1,0,0,0,,Мен 1 жасқа толғанда бірден суға түсе аламын.
Dialogue: 1,0:00:54.93,0:00:58.80, - ,atg7,0,0,0,,Мен Теншуқайдың мүшесімін.
Dialogue: 2,0:00:59.29,0:01:03.11, - ,atg1,0,0,0,,Сіз ешқашан жасыңызды білмегенсіз, солай ма?
Dialogue: 1,0:00:59.29,0:01:03.11, - ,atg7,0,0,0,,Өз жасыңызды жаздыңыз ба?
Dialogue: 2,0:01:03.44,0:01:06.30, - ,atg1,0,0,0,,А, жоқ, мен нақты білмеймін.
Dialogue: 1,0:01:03.44,0:01:06.30, - ,atg7,0,0,0,,Нақты сандар белгісіз.
Dialogue: 2,0:01:06.30,0:01:08.75, - ,atg1,0,0,0,,Қалай болғанда да, ол Кокораға қарағанда жылдамырақ болды.
Dialogue: 1,0:01:06.30,0:01:08.75, - ,atg7,0,0,0,,Контрапозитивті және оң арақатынастарды ертерек жасауға болады
Dialogue: 2,0:01:09.28,0:01:11.51, - ,atg1,0,0,0,,Ересек деген жалғыз нәрсе - шашың.
Dialogue: 1,0:01:09.28,0:01:11.51, - ,atg7,0,0,0,,Тек кәмелетке толған бала ту.
Dialogue: 2,0:01:12.48,0:01:13.62, - ,atg1,0,0,0,,Тарақ жейсіз бе?
Dialogue: 1,0:01:12.48,0:01:13.62, - ,atg7,0,0,0,,Сыбырлау?
Dialogue: 2,0:01:15.05,0:01:21.59,OP - ,atg1,0,0,0,,Дрейф, дрейф, күн сайын жақсы ракон
Dialogue: 1,0:01:15.05,0:01:21.59,OP - ,atg7,0,0,0,,Дрифтинг Дрейфинг Дрейфинг Дрейфинг Әрбір аспандағы қала - сәттілік ~
Dialogue: 2,0:01:21.91,0:01:24.49,OP - ,atg1,0,0,0,,Ыстық жаз Суық қыс
Dialogue: 1,0:01:21.91,0:01:24.49,OP - ,atg7,0,0,0,,Қатты ыстық пен суық қыста шек жоқ.
Dialogue: 2,0:01:24.49,0:01:28.58,OP - ,atg1,0,0,0,,Өйткені жабайы қан толқыған
Dialogue: 1,0:01:24.49,0:01:28.58,OP - ,atg7,0,0,0,,Қанның болуына байланысты
Dialogue: 2,0:01:28.75,0:01:32.58,OP - ,atg1,0,0,0,,Әр күн жаңа нәрселерге толы
Dialogue: 1,0:01:28.75,0:01:32.58,OP - ,atg7,0,0,0,,Аспандағы әрбір қала жаңа
Dialogue: 2,0:01:32.58,0:01:36.11,OP - ,atg1,0,0,0,,Біздің ережелер
Dialogue: 1,0:01:32.58,0:01:36.11,OP - ,atg7,0,0,0,,Бұл біз тиесілі жер.
Dialogue: 2,0:01:36.15,0:01:39.54,OP - ,atg1,0,0,0,,Теңіздегі жақсы құмырсқа
Dialogue: 1,0:01:36.15,0:01:39.54,OP - ,atg7,0,0,0,,Окайридегі Тацуяның жолы болды
