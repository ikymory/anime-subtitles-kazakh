Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:20.44,0:01:22.48,JPN,sp,0,0,0,,Ана?
Dialogue: 0,0:01:24.60,0:01:25.98,JPN,sp,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:01:27.60,0:01:30.23,JPN,,0,0,0,,Анашым, сіз қайдасыз?
Dialogue: 0,0:02:23.23,0:02:24.23,JPN,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:02:27.60,0:02:29.94,JPN,,0,0,0,,Сузуме, сен ояусың ба?
Dialogue: 0,0:02:32.44,0:02:33.52,JPN,,0,0,0,,оянды
Dialogue: 0,0:02:36.19,0:02:39.23,JPN,,0,0,0,,Бүкіл Кюсю аймағы жоғары қысыммен кең таралған.
Dialogue: 0,0:02:38.19,0:02:39.23,JPN,,0,0,0,,Itadadakimasu
Dialogue: 0,0:02:39.52,0:02:42.19,JPN,,0,0,0,,Бізге бүгін көгілдір аспан сергітеді.
Dialogue: 0,0:02:40.02,0:02:42.90,JPN,,0,0,0,,Сузуме, бүгін түскі ас қорабыңды ұмытпа.
Dialogue: 0,0:02:42.90,0:02:43.65,JPN,,0,0,0,,Yes
Dialogue: 0,0:02:44.02,0:02:47.44,JPN,,0,0,0,,Сондай-ақ, Сузуме, мен бүгін кешке сәл кешігіп қаламын.
Dialogue: 0,0:02:47.44,0:02:49.31,JPN,,0,0,0,,Маған кешкі асқа көмектесе аласыз ба?
Dialogue: 0,0:02:49.31,0:02:51.06,JPN,,0,0,0,,Е, Тамаки-сан, кездесудесің бе?
Dialogue: 0,0:02:51.06,0:02:52.52,JPN,,0,0,0,,Енді, ақырында, уақытыңызды алыңыз.
Dialogue: 0,0:02:52.52,0:02:53.56,JPN,,0,0,0,,Қосымша жұмыс уақыты
Dialogue: 0,0:02:53.56,0:02:55.73,JPN,,0,0,0,,Балық аулау тәжірибесіне дайындық
Dialogue: 0,0:03:01.27,0:03:02.40,JPN,sp,0,0,0,,Кеттік
Dialogue: 0,0:03:36.48,0:03:37.23,JPN,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:03:53.48,0:03:55.31,JPN,,0,0,0,,Эй, сен
Dialogue: 0,0:04:01.15,0:04:02.15,JPN,,0,0,0,,Осы жерде
Dialogue: 0,0:04:02.69,0:04:03.52,JPN,,0,0,0,,Қираған жоқ па?
Dialogue: 0,0:04:03.94,0:04:04.73,JPN,,0,0,0,,Үйінділер?
Dialogue: 0,0:04:05.48,0:04:06.77,JPN,,0,0,0,,Мен есікті іздеп жүрмін
Dialogue: 0,0:04:09.52,0:04:11.98,JPN,,0,0,0,,Ауылда халық тұрмаса
Dialogue: 0,0:04:11.98,0:04:13.81,JPN,,0,0,0,,Мынау тауда.
Dialogue: 0,0:04:14.40,0:04:16.02,JPN,,0,0,0,,Иә, рахмет
Dialogue: 0,0:04:27.94,0:04:29.90,JPN,,0,0,0,,Қайырлы таң, Сузуме
Dialogue: 0,0:04:29.90,0:04:31.15,JPN,,0,0,0,,Ая, қайырлы таң
Dialogue: 0,0:04:32.52,0:04:35.23,JPN,color-sp ▼,0,0,0,,Бетіңіз аздап қызарған сияқты, солай емес пе?
Dialogue: 0,0:04:35.23,0:04:36.85,JPN,,0,0,0,,О, өтірік, қызыл?
Dialogue: 0,0:04:36.85,0:04:37.65,JPN,,0,0,0,,Қызыл
Dialogue: 0,0:04:43.27,0:04:44.31,JPN,color-sp ▼,0,0,0,,Донгешита?
Dialogue: 0,0:04:45.81,0:04:47.06,JPN,,0,0,0,,Мен ұмытып кеткен бір нәрсені есіме түсірдім.
Dialogue: 0,0:04:47.52,0:04:49.15,JPN,,0,0,0,,Әй, мен сәл кешігіп қалдым.
Dialogue: 0,0:04:51.81,0:04:52.60,JPN,color-sp ▼,0,0,0,,Мен...
Dialogue: 0,0:04:54.60,0:04:55.52,JPN,,0,0,0,,Неге...
Dialogue: 0,0:05:15.56,0:05:16.65,JPN,,0,0,0,,Бұл жақсы, солай ма?
Dialogue: 0,0:05:17.81,0:05:19.77,JPN,,0,0,0,,Басқа қирандылар жоқ.
Dialogue: 0,0:05:30.60,0:05:33.65,JPN,color-sp ▼,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:34.10,0:05:35.60,JPN,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:05:36.77,0:05:38.69,JPN,,0,0,0,,Әдемі адам
Dialogue: 0,0:05:45.44,0:05:50.15,JPN,sp,0,0,0,,Мен сені бұрын бір жерде кездестірген сияқтымын.
Dialogue: 0,0:05:50.15,0:05:51.06,JPN,,0,0,0,,Мен сені бұрын бір жерде кездескендей сезінемін.
Dialogue: 0,0:05:52.60,0:05:53.49,JPN,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:05:53.49,0:05:54.65,JPN,,0,0,0,,Бұл алып кету ме?
Dialogue: 0,0:05:56.31,0:05:57.15,JPN,,0,0,0,,Үйге қайтайық.
Dialogue: 0,0:06:15.35,0:06:17.69,JPN,,0,0,0,,Сіз «есік» дедіңіз
Dialogue: 0,0:06:47.52,0:06:48.31,JPN,sp,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:06:58.85,0:06:59.77,JPN,,0,0,0,,Неліктен?
Dialogue: 0,0:07:17.35,0:07:17.98,JPN,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:36.94,0:07:37.65,JPN,,0,0,0,,Салқын.
Dialogue: 0,0:07:49.40,0:07:51.44,JPN,,0,0,0,,Не...
Dialogue: 0,0:07:51.98,0:07:52.52,JPN,,0,0,0,,Қорқынышты
Dialogue: 0,0:08:02.60,0:08:03.77,JPN,,0,0,0,,Міне, осында
Dialogue: 0,0:08:03.77,0:08:06.69,JPN,,0,0,0,,Атқарушы жұмысқа бара жатыр, Сузуме.
Dialogue: 0,0:08:08.56,0:08:10.19,JPN,,0,0,0,,Апайдың түскі ас қорабы шықты
Dialogue: 0,0:08:10.40,0:08:12.10,JPN,,0,0,0,,Махаббатым бүгін де тереңдемейді.
Dialogue: 0,0:08:14.02,0:08:14.73,JPN,,0,0,0,,Unosaa
Dialogue: 0,0:08:15.48,0:08:17.73,JPN,,0,0,0,,Уэнураның жанында қирандылар бар, солай ма?
Dialogue: 0,0:08:17.73,0:08:18.69,JPN,,0,0,0,,Ескі ыстық бұлақ қалашығы
Dialogue: 0,0:08:19.35,0:08:20.44,JPN,,0,0,0,,Шынымен бе?
Dialogue: 0,0:08:20.85,0:08:22.69,JPN,,0,0,0,,Бар сияқты, Акчин Яманака.
Dialogue: 0,0:08:23.40,0:08:24.48,JPN,,0,0,0,,Бұл не болды?
Dialogue: 0,0:08:24.98,0:08:25.60,JPN,,0,0,0,,Есік...
Dialogue: 0,0:08:27.85,0:08:28.69,JPN,,0,0,0,,Ақыр соңында, бәрі жақсы.
Dialogue: 0,0:08:28.69,0:08:29.60,JPN,,0,0,0,,Не болды, апа?
Dialogue: 0,0:08:29.60,0:08:31.44,JPN,,0,0,0,,Соңына дейін айтпа
Dialogue: 0,0:08:29.60,0:08:31.44,JPN,,0,0,0,,Маған қызық.
Dialogue: 0,0:08:34.02,0:08:36.40,JPN,color-sp ▼,0,0,0,,Әй, мына жерде өрт болып жатыр.
Dialogue: 0,0:08:36.40,0:08:37.56,JPN,,0,0,0,,Е, қайда?
Dialogue: 0,0:08:37.56,0:08:38.69,JPN,,0,0,0,,Қараңдаршы, мына тау
Dialogue: 0,0:08:38.69,0:08:39.77,JPN,,0,0,0,,Ей, сен қайдасың?
Dialogue: 0,0:08:39.77,0:08:41.40,JPN,,0,0,0,,Қараңызшы, түтін көтеріліп жатыр.
Dialogue: 0,0:08:41.40,0:08:43.19,JPN,,0,0,0,,Иә, қайда?
Dialogue: 0,0:08:43.52,0:08:44.85,JPN,color-sp ▼,0,0,0,,Ая, түсіндің бе?
Dialogue: 0,0:08:44.85,0:08:45.73,JPN,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:08:45.69,0:08:46.69,JPN,,0,0,0,,Өйткені
Dialogue: 0,0:08:45.73,0:08:46.69,JPN,sp,0,0,0,,Бұл дала өртінен шыққан түтін емес пе?
Dialogue: 0,0:08:46.69,0:08:47.98,JPN,,0,0,0,,Бұл дала өртінен шыққан түтін емес пе?
Dialogue: 0,0:08:47.60,0:08:48.65,JPN,,0,0,0,,Кираны қолдайтын жолдастар,
Dialogue: 0,0:08:50.60,0:08:51.44,JPN,color-sp ▼,0,0,0,,Не?
Dialogue: 0,0:08:51.44,0:08:52.27,JPN,,0,0,0,,Смартфон?
Dialogue: 0,0:08:52.77,0:08:53.19,JPN,,0,0,0,,Не?
Dialogue: 0,0:08:53.94,0:08:54.69,JPN,,0,0,0,,Бұл ескерту емес пе?
Dialogue: 0,0:08:54.52,0:08:56.35,JPN,,0,0,0,,Жер сілкінісі, қарқындылығы 4
Dialogue: 0,0:08:56.35,0:08:56.94,JPN,,0,0,0,,Sway?
Dialogue: 0,0:09:03.48,0:09:04.19,JPN,sp,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:09:04.73,0:09:05.65,JPN,color-sp ▼,0,0,0,,Жер сілкінісі
Dialogue: 0,0:09:05.65,0:09:06.19,JPN,,0,0,0,,Шынайы ма?
Dialogue: 0,0:09:06.65,0:09:07.77,JPN,color-sp ▼,0,0,0,,Шығу, шығу
Dialogue: 0,0:09:07.77,0:09:08.69,JPN,,0,0,0,,Әй, жүр!
Dialogue: 0,0:09:17.85,0:09:19.27,JPN,,0,0,0,,Мен біраз қорықтым.
Dialogue: 0,0:09:19.27,0:09:21.19,JPN,,0,0,0,,Хабарландыру тым асыра айтылған.
Dialogue: 0,0:09:21.19,0:09:21.65,JPN,,0,0,0,,Эй
Dialogue: 0,0:09:23.40,0:09:25.27,JPN,,0,0,0,,Сол жерде
Dialogue: 0,0:09:25.27,0:09:26.69,JPN,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:09:34.31,0:09:36.19,JPN,,0,0,0,,Әй, біз бұрын не туралы сөйлестік?
Dialogue: 0,0:09:36.81,0:09:40.19,JPN,,0,0,0,,Сузуме, жақсысың ба?
Dialogue: 0,0:09:40.98,0:09:42.19,JPN,,0,0,0,,Сіз көрмейсіз бе?
Dialogue: 0,0:09:44.19,0:09:45.69,JPN,sp,0,0,0,,Сәлем, Сузуме.
Dialogue: 0,0:09:52.60,0:09:53.69,JPN,sp,0,0,0,,Әке
Dialogue: 0,0:09:55.02,0:09:55.81,JPN,sp,0,0,0,,Неге ешкім жоқ?
Dialogue: 0,0:09:57.56,0:09:58.48,JPN,,0,0,0,,Бұл не?
Dialogue: 0,0:10:07.02,0:10:07.56,JPN,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:09.19,0:10:09.77,JPN,sp,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:11.35,0:10:12.10,JPN,sp,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:19.31,0:10:20.10,JPN,sp,0,0,0,,Сол есік.
Dialogue: 0,0:10:26.77,0:10:27.44,JPN,,0,0,0,,Сол адам
Dialogue: 0,0:10:36.90,0:10:39.02,JPN,,0,0,0,,Сіз не істеп жатырсыз? Бұл жерден кет.
Dialogue: 0,0:10:52.10,0:10:53.85,JPN,sp,0,0,0,,Ум, жақсысың ба?
Dialogue: 0,0:10:59.35,0:10:59.85,JPN,sp,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:00.69,0:11:02.85,JPN,sp,0,0,0,,Бұл жаман
Dialogue: 0,0:11:37.06,0:11:38.06,JPN,sp,0,0,0,,Жер сілкінісі
Dialogue: 0,0:11:37.60,0:11:38.35,JPN,sp,0,0,0,,Ақымақ
Dialogue: 0,0:11:40.27,0:11:40.94,JPN,sp,0,0,0,,Қауіпті!
Dialogue: 0,0:11:43.85,0:11:45.15,JPN,sp,0,0,0,,Бұл жерден кет
Dialogue: 0,0:11:56.31,0:11:57.10,JPN,sp,0,0,0,,Ақымақ
Dialogue: 0,0:12:16.35,0:12:17.06,JPN,sp,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:12:17.06,0:12:18.98,JPN,sp,0,0,0,,Біз бұл жерді жабуымыз керек, солай ма?
Dialogue: 0,0:12:28.52,0:12:30.81,JPN,,0,0,0,,Дана және көрінбейтін құдай
Dialogue: 0,0:12:30.81,0:12:32.35,JPN,,0,0,0,1,Алыстағы ата-бабаларымыздың жері.
Dialogue: 0,0:12:32.69,0:12:34.77,JPN,,0,0,0,2,Осы таулар мен өзендермен мен көптен араластым.
Dialogue: 0,0:12:35.15,0:12:36.48,JPN,,0,0,0,3,Кашикоми,кашикоми
Dialogue: 0,0:12:36.48,0:12:38.15,JPN,,0,0,0,4,Жауабыңызды кішіпейілділікпен сұраймын.
Dialogue: 0,0:12:38.27,0:12:38.98,JPN,sp,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:38.48,0:12:40.44,JPN,,0,0,0,5,Дана және көрінбейтін құдай
Dialogue: 0,0:12:40.81,0:12:42.44,JPN,,0,0,0,6,Алыстағы ата-бабаларымыздың жері.
Dialogue: 0,0:12:42.85,0:12:45.23,JPN,,0,0,0,7,Осы таулар мен өзендермен мен көптен араластым.
Dialogue: 0,0:12:45.48,0:12:46.73,JPN,,0,0,0,8,Кашикоми,кашикоми
Dialogue: 0,0:12:46.73,0:12:48.94,JPN,,0,0,0,9,Жауабыңызды кішіпейілділікпен сұраймын.
Dialogue: 0,0:12:35.48,0:12:37.73,JPN,,0,0,0,,Әке, асығыңыз,мұнда келіңіз.
Dialogue: 0,0:12:38.98,0:12:40.90,JPN,,0,0,0,,Менің ыстық бұлаққа бармағаныма біраз болды.
Dialogue: 0,0:12:40.44,0:12:42.52,JPN,,0,0,0,,Анашым,тағы шомылайық.
Dialogue: 0,0:12:44.07,0:12:46.27,JPN,,0,0,0,,Сіз қайтадан ішесіз бе?
Dialogue: 0,0:12:46.10,0:12:48.94,JPN,,0,0,0,,Ей, келесі жылы қайтайық,отбасылық саяхат
Dialogue: 0,0:12:51.98,0:12:52.52,JPN,sp,0,0,0,,жабық
Dialogue: 0,0:12:52.60,0:12:53.98,JPN,,0,0,0,,Мен жауап бергім келеді
Dialogue: 0,0:13:22.90,0:13:24.60,JPN,sp,0,0,0,,Ым, енді ше?
Dialogue: 0,0:13:25.10,0:13:27.31,JPN,sp,0,0,0,,Кілт тасы оны мөрмен жабуы керек еді.
Dialogue: 0,0:13:28.48,0:13:30.06,JPN,,0,0,0,,Бұл жерге не үшін келдің?
Dialogue: 0,0:13:30.60,0:13:31.81,JPN,,0,0,0,,Мен жауын құртын неге көрдім?
Dialogue: 0,0:13:32.27,0:13:33.73,JPN,,0,0,0,,Тірек тасы қайда кетті?
Dialogue: 0,0:13:34.73,0:13:35.41,JPN,sp,0,0,0,,Құрт?
Dialogue: 0,0:13:35.41,0:13:36.10,JPN,sp,0,0,0,,Тас дегеніміз не?
Dialogue: 0,0:13:36.90,0:13:38.06,JPN,sp,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:42.73,0:13:44.81,JPN,,0,0,0,,Бұл жер артқы есікке айналды.
Dialogue: 0,0:13:45.81,0:13:48.31,JPN,,0,0,0,,Артқы есіктен жауын құрттары шығады.
Dialogue: 0,0:13:49.48,0:13:51.19,JPN,,0,0,0,,Сізге көмектескен адамға рахмет
Dialogue: 0,0:13:51.85,0:13:54.31,JPN,,0,0,0,,Бірақ мұнда көргеніңізді ұмытыңыз.
Dialogue: 0,0:13:54.31,0:13:55.06,JPN,,0,0,0,,Үйге қайт
Dialogue: 0,0:13:56.98,0:13:57.56,JPN,,0,0,0,,Бірақ
Dialogue: 0,0:13:58.02,0:13:59.23,JPN,,0,0,0,,Күте тұрыңыз, бұл жарақат.
Dialogue: 0,0:14:04.94,0:14:06.81,JPN,,0,0,0,,Бұл өте күшті жер сілкінісі болды.
Dialogue: 0,0:14:06.48,0:14:08.31,JPN,,0,0,0,,Плиткалар құлап жатыр.
Dialogue: 0,0:14:08.40,0:14:10.48,JPN,,0,0,0,,Сіздің есіңізде жүргеніңізге қуаныштымын.
Dialogue: 0,0:14:10.48,0:14:12.56,JPN,,0,0,0,,Өйткені, дайын болу керек.
Dialogue: 0,0:14:11.31,0:14:13.90,JPN,,0,0,0,,Ағай, сонда маған көмектесе аласыз ба?
Dialogue: 0,0:14:13.90,0:14:15.19,JPN,,0,0,0,,Онда жақсы.
Dialogue: 0,0:14:18.94,0:14:20.02,JPN,,0,0,0,,Жоғарыға шығыңыз.
Dialogue: 0,0:14:20.02,0:14:21.35,JPN,,0,0,0,,Мен алғашқы көмек қобдишасын аламын.
Dialogue: 0,0:14:21.35,0:14:22.40,JPN,,0,0,0,,Жоқ, мен қазірдің өзінде...
Dialogue: 0,0:14:22.40,0:14:23.73,JPN,,0,0,0,,Егер сіз ауруханаларды соншалықты жек көрсеңіз
Dialogue: 0,0:14:23.73,0:14:24.98,JPN,,0,0,0,,Ең болмағанда алғашқы көмек көрсету
Dialogue: 0,0:14:25.65,0:14:26.94,JPN,,0,0,0,,Баланың өзімшілдігі?
Dialogue: 0,0:14:53.73,0:14:55.06,JPN,,0,0,0,,Балалар орындығы
Dialogue: 0,0:15:10.19,0:15:12.31,JPN,,0,0,0,,Бұрын сағат 13:20 шамасында.
Dialogue: 0,0:15:12.56,0:15:14.65,JPN,sp,0,0,0,,Эпицентрі Миядзаки префектурасының оңтүстігінде
Dialogue: 0,0:15:14.65,0:15:17.06,JPN,sp,0,0,0,,Ең жоғары сейсмикалық қарқындылығы 6-дан төмен жер сілкінісі болды.
Dialogue: 0,0:15:17.06,0:15:17.65,JPN,,0,0,0,,Ең жоғары сейсмикалық қарқындылығы 6-дан төмен жер сілкінісі болды.
Dialogue: 0,0:15:18.23,0:15:19.81,JPN,,0,0,0,,Бұл жер сілкінісіне байланысты цунами қаупі жоқ.
Dialogue: 0,0:15:19.81,0:15:20.69,JPN,,0,0,0,,Бұл жер сілкінісіне байланысты цунами қаупі жоқ.
Dialogue: 0,0:15:21.44,0:15:23.11,JPN,,0,0,0,,Қазіргі уақытта
Dialogue: 0,0:15:23.11,0:15:25.69,JPN,,0,0,0,,Жарақаттар сияқты адам зияны туралы ақпарат қосылмаған.
Dialogue: 0,0:15:27.90,0:15:28.85,JPN,,0,0,0,,Сіз үйреніп қалдыңыз.
Dialogue: 0,0:15:29.35,0:15:31.02,JPN,,0,0,0,,Себебі менің анам медбике болған
Dialogue: 0,0:15:31.69,0:15:34.35,JPN,,0,0,0,,Ал, менің саған қояйын деген сұрақтарым көп.
Dialogue: 0,0:15:34.35,0:15:35.23,JPN,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:15:36.56,0:15:38.94,JPN,,0,0,0,,Сіз жауын құрт дедіңіз, солай ма?
Dialogue: 0,0:15:39.35,0:15:42.81,JPN,,0,0,0,,Жаңбыр құрттары - жапон архипелагының астындағы орасан зор күш.
Dialogue: 0,0:15:43.44,0:15:44.90,JPN,,0,0,0,,Мақсатсыз немесе еріксіз
Dialogue: 0,0:15:44.90,0:15:46.48,JPN,,0,0,0,,Егер бұрмалану жиналса, ол жай ғана жабайы болады
Dialogue: 0,0:15:46.48,0:15:47.73,JPN,,0,0,0,,Жерді шайқаңыз
Dialogue: 0,0:15:47.73,0:15:49.85,JPN,,0,0,0,,Бірақ біз оны жеңдік, солай емес пе?
Dialogue: 0,0:15:50.27,0:15:52.02,JPN,,0,0,0,,Тек уақытша қамауда
Dialogue: 0,0:15:52.44,0:15:54.27,JPN,,0,0,0,,Егер тірек таспен мөрленбесе
Dialogue: 0,0:15:54.27,0:15:56.02,JPN,,0,0,0,,Жауан құрт тағы бір жерден шығады.
Dialogue: 0,0:15:57.19,0:15:58.98,JPN,,0,0,0,,Бұл тағы да жер сілкінісі болады дегенді білдіре ме?
Dialogue: 0,0:15:59.44,0:16:01.69,JPN,,0,0,0,,Менің міндетім мұның алдын алу.
Dialogue: 0,0:16:02.23,0:16:03.44,JPN,,0,0,0,,Жұмыс?
Dialogue: 0,0:16:05.81,0:16:07.60,JPN,,0,0,0,,Эй, сен кімсің?
Dialogue: 0,0:16:07.60,0:16:09.69,JPN,,0,0,0,,Уақытыңызды бөлгеніңіз үшін рахмет.
Dialogue: 0,0:16:10.60,0:16:12.65,JPN,,0,0,0,,Менің атым Сота, Мунаката Сота.
Dialogue: 0,0:16:13.56,0:16:15.77,JPN,,0,0,0,,Менің атым Сузуме Ивато.
Dialogue: 0,0:16:19.10,0:16:19.73,JPN,,0,0,0,,мысық
Dialogue: 0,0:16:20.85,0:16:22.60,JPN,,0,0,0,,Не, мына бала тым арық па?
Dialogue: 0,0:16:23.90,0:16:24.81,JPN,sp,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:16:34.94,0:16:36.56,JPN,,0,0,0,,Менің қарным қатты ашты.
Dialogue: 0,0:16:37.23,0:16:39.19,JPN,,0,0,0,,Жер сілкінісінен қорықпайсың ба?
Dialogue: 0,0:16:41.52,0:16:42.27,JPN,sp,0,0,0,,Сүйкімді
Dialogue: 0,0:16:42.69,0:16:44.02,JPN,sp,0,0,0,,Әй, сен менің балам боласың ба?
Dialogue: 0,0:16:44.44,0:16:44.98,JPN,sp,0,0,0,,Иә
Dialogue: 0,0:16:48.40,0:16:50.23,JPN,,0,0,0,,Торғай, мейірімді
Dialogue: 0,0:16:50.73,0:16:51.27,JPN,,0,0,0,,Ұнады
Dialogue: 0,0:16:53.98,0:16:55.77,JPN,,0,0,0,,Сіз мазасыз адамсыз
Dialogue: 0,0:17:03.69,0:17:05.19,JPN,,0,0,0,,Сота-сан, сен қайдасың?
Dialogue: 0,0:17:14.77,0:17:16.77,JPN,sp,0,0,0,,Бұл не?
Dialogue: 0,0:17:18.77,0:17:20.60,JPN,,0,0,0,,Сонымен, Сота-сан?
Dialogue: 0,0:17:20.60,0:17:21.52,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,0:17:22.65,0:17:23.35,JPN,,0,0,0,,Мен...
Dialogue: 0,0:17:26.23,0:17:27.35,JPN,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:17:27.81,0:17:28.65,JPN,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:17:29.90,0:17:30.90,JPN,,0,0,0,,Ақымақ
Dialogue: 0,0:17:40.19,0:17:41.31,JPN,,0,0,0,,Эй, эй, эй
Dialogue: 0,0:17:41.69,0:17:43.06,JPN,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:17:47.35,0:17:48.85,JPN,,0,0,0,,Өтірік, өтірік, өтірік
Dialogue: 0,0:17:48.85,0:17:49.44,JPN,,0,0,0,,Сузуме
Dialogue: 0,0:17:49.44,0:17:50.06,JPN,,0,0,0,,Тамаки мырза
Dialogue: 0,0:17:50.52,0:17:51.65,JPN,,0,0,0,,Кешіріңіз, мен кішкентаймын
Dialogue: 0,0:17:51.65,0:17:53.06,JPN,,0,0,0,,Әй, біз қайда барамыз?
Dialogue: 0,0:17:53.52,0:17:55.81,JPN,,0,0,0,,Мен сені уайымдап қайтып келмедім.
Dialogue: 0,0:17:56.19,0:17:56.81,JPN,,0,0,0,,Жер сілкінісі
Dialogue: 0,0:17:57.06,0:17:58.81,JPN,,0,0,0,,Сіз телефонға ешқашан жауап бермейсіз бе?
Dialogue: 0,0:17:58.81,0:18:00.06,JPN,,0,0,0,,Кешіріңіз, мен байқамадым.
Dialogue: 0,0:18:00.06,0:18:00.90,JPN,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:18:02.27,0:18:04.44,JPN,,0,0,0,,Қарашы, Сузуме, күтпе.
Dialogue: 0,0:18:08.06,0:18:08.60,JPN,sp,0,0,0,,мысық
Dialogue: 0,0:18:19.98,0:18:20.81,JPN,sp,0,0,0,,Бұл не?
Dialogue: 0,0:18:21.23,0:18:21.81,JPN,sp,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:24.23,0:18:26.69,JPN,sp,0,0,0,,Не, не?
Dialogue: 0,0:18:36.65,0:18:38.48,JPN,,0,0,0,,Сузуме-чан
Dialogue: 0,0:18:40.90,0:18:42.69,JPN,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:18:50.06,0:18:51.15,JPN,,0,0,0,,А, қазірдің өзінде
Dialogue: 0,0:18:52.44,0:18:54.65,JPN,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:56.90,0:18:59.10,JPN,,0,0,0,,Сізді ұзақ күткенім үшін кешіріңіз.
Dialogue: 0,0:18:59.90,0:19:02.23,JPN,,0,0,0,,Қауіпсіздік расталды.
Dialogue: 0,0:19:02.23,0:19:04.06,JPN,,0,0,0,,Кеме порттан кетеді.
Dialogue: 0,0:19:07.10,0:19:08.19,JPN,sp,0,0,0,,Бұрын не көрдіңіз?
Dialogue: 0,0:19:08.19,0:19:09.06,JPN,sp,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:19:08.81,0:19:09.98,JPN,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:19:09.56,0:19:10.35,JPN,sp,0,0,0,,Бұл ойыншық.
Dialogue: 0,0:19:10.35,0:19:11.40,JPN,,0,0,0,,Was it a chair?
Dialogue: 0,0:19:11.40,0:19:12.35,JPN,,0,0,0,,Well done
Dialogue: 0,0:19:12.85,0:19:14.40,JPN,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:19:14.85,0:19:16.40,JPN,,0,0,0,,Absolutely, no more
Dialogue: 0,0:19:22.85,0:19:23.73,JPN,sp,0,0,0,,Why run away?
Dialogue: 0,0:19:24.60,0:19:26.10,JPN,sp,0,0,0,,What did you do to my body?
Dialogue: 0,0:19:26.52,0:19:27.60,JPN,sp,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:28.44,0:19:29.31,JPN,sp,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:19:37.06,0:19:37.77,JPN,sp,0,0,0,,Торғай
Dialogue: 0,0:19:38.73,0:19:39.35,JPN,sp,0,0,0,,Жақында кездескенше
Dialogue: 0,0:19:53.60,0:19:54.19,JPN,sp,0,0,0,,Сонымен
Dialogue: 0,0:19:54.98,0:19:56.44,JPN,sp,0,0,0,,I'll stay at Ayanchi today.
Dialogue: 0,0:19:57.98,0:20:00.40,JPN,sp,0,0,0,,Sorry, I'll go home tomorrow anyway.
Dialogue: 0,0:20:00.06,0:20:01.94,JPN,sp,0,0,0,,Wait a moment, Suzume.
Dialogue: 0,0:20:02.35,0:20:03.98,JPN,sp,0,0,0,,Түнде қалуға болмайды.
Dialogue: 0,0:20:03.98,0:20:07.31,JPN,sp,0,0,0,,Сіз өз бөлмеңізде алғашқы медициналық көмек қобдишасын не үшін пайдаландыңыз?
Dialogue: 0,0:20:07.31,0:20:09.19,JPN,sp,0,0,0,,Someone was working on the house.
Dialogue: 0,0:20:09.81,0:20:11.85,JPN,sp,0,0,0,,Мен қараңғы нәрселер туралы ойлағым келмейді, бірақ
Dialogue: 0,0:20:11.85,0:20:12.94,JPN,sp,0,0,0,,Сіз
Dialogue: 0,0:20:13.19,0:20:14.69,JPN,sp,0,0,0,,Maybe I'll go out with some weird guy.
Dialogue: 0,0:20:14.69,0:20:14.85,JPN,sp,0,0,0,,Maybe I'll go out with some weird guy.
Dialogue: 0,0:20:14.85,0:20:16.40,JPN,sp,0,0,0,,No, it's healthy, it's okay!
Dialogue: 0,0:20:23.31,0:20:25.48,JPN,sp,0,0,0,,Did you also see the running chair?
Dialogue: 0,0:20:25.94,0:20:26.69,JPN,sp,0,0,0,,Жоқ
Dialogue: 0,0:20:36.94,0:20:37.90,JPN,sp,0,0,0,,Сота мырза
Dialogue: 0,0:20:37.90,0:20:40.19,JPN,sp,0,0,0,,Бұл кеме Эхимеге таңертең келеді.
Dialogue: 0,0:20:40.85,0:20:43.02,JPN,sp,0,0,0,,Мысық мінген кеме сол портта болған сияқты.
Dialogue: 0,0:20:43.52,0:20:44.10,JPN,sp,0,0,0,,Мен көремін.
Dialogue: 0,0:20:44.98,0:20:46.27,JPN,sp,0,0,0,,I bought some bread.
Dialogue: 0,0:20:46.81,0:20:47.94,JPN,sp,0,0,0,,Рахмет
Dialogue: 0,0:20:47.94,0:20:50.23,JPN,sp,0,0,0,,But I'm not hungry.
Dialogue: 0,0:20:50.23,0:20:50.81,JPN,sp,0,0,0,,Иә
Dialogue: 0,0:20:57.65,0:20:59.65,JPN,sp,0,0,0,,Um, that appearance?
Dialogue: 0,0:21:00.52,0:21:03.35,JPN,sp,0,0,0,,It seems I was cursed by that guy.
Dialogue: 0,0:21:03.35,0:21:04.40,JPN,sp,0,0,0,,What is a curse?
Dialogue: 0,0:21:04.81,0:21:05.60,JPN,sp,0,0,0,,Амансың ба?
Dialogue: 0,0:21:05.60,0:21:06.94,JPN,sp,0,0,0,,Doesn't it hurt?
Dialogue: 0,0:21:06.94,0:21:07.44,JPN,sp,0,0,0,,Doesn't it hurt?
Dialogue: 0,0:21:07.85,0:21:08.98,JPN,sp,0,0,0,,Ал Кира
Dialogue: 0,0:21:10.56,0:21:11.19,JPN,sp,0,0,0,,Дұрыс айтасың — ол әдеттегіден де көп әуре-сарсаңға түсіп жүр.
Dialogue: 0,0:21:12.02,0:21:14.48,JPN,sp,0,0,0,,But we have to do something.
Dialogue: 0,0:21:15.60,0:21:17.06,JPN,sp,0,0,0,,Um, Sota-san.
Dialogue: 0,0:21:17.73,0:21:19.90,JPN,sp,0,0,0,,There's something I'm curious about.
Dialogue: 0,0:21:21.52,0:21:22.77,JPN,sp,0,0,0,,Stone statue in the ruins
Dialogue: 0,0:21:23.23,0:21:24.44,JPN,sp,0,0,0,,That's the keystone
Dialogue: 0,0:21:24.69,0:21:25.69,JPN,sp,0,0,0,,Did you pull it out?
Dialogue: 0,0:21:26.35,0:21:27.35,JPN,sp,0,0,0,,I mean, I pulled it out.
Dialogue: 0,0:21:28.02,0:21:30.48,JPN,sp,0,0,0,,I see, then that cat is the keystone?
Dialogue: 0,0:21:30.90,0:21:32.65,JPN,sp,0,0,0,,Рөлден бас тартып, қашу деген нені білдіреді?
Dialogue: 0,0:21:33.56,0:21:34.69,JPN,sp,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:21:34.69,0:21:36.65,JPN,sp,0,0,0,,You set the keystone free
Dialogue: 0,0:21:36.65,0:21:38.35,JPN,sp,0,0,0,,I was cursed by that thing.
Dialogue: 0,0:21:38.85,0:21:39.44,JPN,sp,0,0,0,,Liar
Dialogue: 0,0:21:39.44,0:21:40.81,JPN,sp,0,0,0,,Sorry, I...
Dialogue: 0,0:21:42.23,0:21:42.94,JPN,sp,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:21:46.15,0:21:46.77,JPN,sp,0,0,0,,Жоқ
Dialogue: 0,0:21:47.40,0:21:50.31,JPN,sp,0,0,0,,Есікті кешіктіргеніме мен кінәлімін.
Dialogue: 0,0:21:50.90,0:21:52.10,JPN,sp,0,0,0,,It's not your fault
Dialogue: 0,0:21:52.10,0:21:52.85,JPN,sp,0,0,0,,Бірақ
Dialogue: 0,0:21:52.85,0:21:55.19,JPN,sp,0,0,0,,Suzume-san, I'm a closing master.
Dialogue: 0,0:21:55.60,0:21:56.69,JPN,sp,0,0,0,,Binding?
Dialogue: 0,0:21:57.19,0:21:59.09,JPN,sp,0,0,0,,To prevent disaster from occurring
Dialogue: 0,0:21:59.09,0:22:00.94,JPN,sp,0,0,0,,Close the door that has been opened
Dialogue: 0,0:22:01.44,0:22:03.56,JPN,sp,0,0,0,,That's how I travel around Japan.
Dialogue: 0,0:22:04.94,0:22:07.94,JPN,sp,0,0,0,,Бұл бастапқыда біздің монахшылардың жұмысы.
Dialogue: 0,0:22:08.73,0:22:10.06,JPN,sp,0,0,0,,You must be hungry.
Dialogue: 0,0:22:10.06,0:22:10.77,JPN,sp,0,0,0,,Мен сені нашар өтірікші деп ойлайтынмын.
Dialogue: 0,0:22:16.40,0:22:18.27,JPN,sp,0,0,0,,Return the cat to the keystone
Dialogue: 0,0:22:18.27,0:22:19.52,JPN,sp,0,0,0,,Seal earthworms
Dialogue: 0,0:22:20.15,0:22:23.06,JPN,sp,0,0,0,,Егер мен мұны істесем, мен міндетті түрде бастапқы пішініме ораламын.
Dialogue: 0,0:22:23.90,0:22:26.35,JPN,sp,0,0,0,,So you don't have to worry about anything
Dialogue: 0,0:22:27.77,0:22:30.15,JPN,sp,0,0,0,,You go home tomorrow
Dialogue: 0,0:22:42.10,0:22:43.69,JPN,>>,0,0,0,,Ана?
Dialogue: 0,0:22:45.98,0:22:47.60,JPN,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:22:49.15,0:22:52.44,JPN,,0,0,0,,Mom, where are you?
Dialogue: 0,0:23:14.19,0:23:15.85,JPN,sp,0,0,0,,Mr. Sota?
Dialogue: 0,0:23:16.60,0:23:18.02,JPN,sp,0,0,0,,Amazing sleeping position
Dialogue: 0,0:23:32.69,0:23:33.77,JPN,sp,0,0,0,,Соққы
Dialogue: 0,0:23:35.44,0:23:41.35,JPN,,0,0,0,,Бүгін Шикоку Микан паромын пайдаланғаныңыз үшін рахмет.
Dialogue: 0,0:23:42.23,0:23:46.69,JPN,,0,0,0,,Біздің барлық қызметкерлер сізді бортта қайта қарсы алуды асыға күтеді.
Dialogue: 0,0:23:46.69,0:23:47.85,JPN,,0,0,0,,Suzume-san?
Dialogue: 0,0:23:49.85,0:23:51.85,JPN,sp color,0,0,0,,I finally woke up
Dialogue: 0,0:23:52.31,0:23:54.44,JPN,color >>,0,0,0,,Sota-san, you never wake up.
Dialogue: 0,0:23:54.44,0:23:57.10,JPN,,0,0,0,,Мен мұның бәрі арман деп ойлай бастадым.
Dialogue: 0,0:23:57.52,0:23:59.19,JPN,,0,0,0,,Was I sleeping?
Dialogue: 0,0:24:00.31,0:24:01.35,JPN,,0,0,0,,Шынында да, ол үйде өте сабырлы.
Dialogue: 0,0:24:01.35,0:24:03.73,JPN,,0,0,0,,Now, how should we find the cat?
Dialogue: 0,0:24:03.73,0:24:05.60,JPN,,0,0,0,,Мен портта сұрақтар қоюдан бастаймын деп ойлаймын.
Dialogue: 0,0:24:06.35,0:24:07.65,JPN,,0,0,0,,Or rather, where is this?
Dialogue: 0,0:24:07.65,0:24:08.10,JPN,,0,0,0,,Hey, hey, man.
Dialogue: 0,0:24:08.10,0:24:08.56,JPN,default >>,0,0,0,,Hey, hey, man.
Dialogue: 0,0:24:08.98,0:24:11.81,JPN,,0,0,0,,The edge of Ehime?
Dialogue: 0,0:24:11.81,0:24:13.10,JPN,,0,0,0,,Wow, that was pretty bad.
Dialogue: 0,0:24:13.27,0:24:14.90,JPN,color >>,0,0,0,,If you take the next ferry
Dialogue: 0,0:24:14.90,0:24:16.85,JPN,,0,0,0,,You'll be able to go home today.
Dialogue: 0,0:24:16.85,0:24:17.10,JPN,,0,0,0,,Сен…
Dialogue: 0,0:24:17.10,0:24:17.35,JPN,,0,0,0,,Сен…
Dialogue: 0,0:24:18.35,0:24:18.85,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:24:22.52,0:24:23.60,JPN,Color sp,0,0,0,,Ah, white cat
Dialogue: 0,0:24:23.81,0:24:25.10,JPN,Color sp,0,0,0,,Ah, cute
Dialogue: 0,0:24:25.40,0:24:26.60,JPN,,0,0,0,,Oh, kitten.
Dialogue: 0,0:24:26.77,0:24:27.60,JPN,,0,0,0,,What's the name?
Dialogue: 0,0:24:27.81,0:24:28.60,JPN,,0,0,0,,What is your name?
Dialogue: 0,0:24:28.85,0:24:29.85,JPN,,0,0,0,,Не?
Dialogue: 0,0:24:29.98,0:24:30.85,JPN,,0,0,0,,Дайджин т.б.
Dialogue: 0,0:24:30.85,0:24:31.60,JPN,,0,0,0,,Daijin?
Dialogue: 0,0:24:31.85,0:24:33.35,JPN,,0,0,0,,Бұл Дайжинге ұқсайды.
Dialogue: 0,0:24:43.23,0:24:44.94,JPN,,0,0,0,,This is him, right?
Dialogue: 0,0:24:44.94,0:24:45.90,JPN,,0,0,0,,Қалай
Dialogue: 0,0:24:51.23,0:24:52.15,JPN,,0,0,0,,Daijin?
Dialogue: 0,0:24:52.94,0:24:55.40,JPN,,0,0,0,,Олай десеңіз, сіздің бетіңіздің түрі осындай шығар деп ойлаймын.
Dialogue: 0,0:24:55.40,0:24:57.65,JPN,,0,0,0,,Traveling by train, I have to follow you
Dialogue: 0,0:24:58.27,0:24:59.73,JPN,color >>,0,0,0,,Thank you so much, Suzume-san.
Dialogue: 0,0:25:00.15,0:25:01.60,JPN,,0,0,0,,Goodbye here.
Dialogue: 0,0:25:01.60,0:25:02.77,JPN,,0,0,0,,Үйге қайтқанда сақ болыңыз
Dialogue: 0,0:25:06.98,0:25:08.40,JPN,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:25:08.98,0:25:11.65,JPN,color sp,0,0,0,,If you don't go home, your family will be worried.
Dialogue: 0,0:25:11.85,0:25:13.90,JPN,sp,0,0,0,,Уайымдамаңыз, бізде лессез-фэйр саясаты бар.
Dialogue: 0,0:25:17.10,0:25:18.69,JPN,color >>,0,0,0,,It will be a dangerous journey
Dialogue: 0,0:25:18.69,0:25:20.77,JPN,,0,0,0,,I'm in trouble if I follow you.
Dialogue: 0,0:25:20.77,0:25:22.90,JPN,,0,0,0,,Even if you said that, Sota-san.
Dialogue: 0,0:25:23.19,0:25:23.81,JPN,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:25:28.81,0:25:29.90,JPN,,0,0,0,,Қалай
Dialogue: 0,0:25:29.90,0:25:32.65,JPN,,0,0,0,,It can be dangerous to walk in public.
Dialogue: 0,0:25:32.65,0:25:36.15,JPN,color sp,0,0,0,,At this rate, someone will catch Sota first.
Dialogue: 0,0:25:37.90,0:25:38.94,JPN,,0,0,0,,Менде басқа амал жоқ.
Dialogue: 0,0:25:39.94,0:25:42.90,JPN,,0,0,0,,Suzume-san, until you find the keystone
Dialogue: 0,0:25:43.48,0:25:44.48,JPN,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:25:45.19,0:25:46.40,JPN,,0,0,0,,Мен де солай.
Dialogue: 0,0:26:07.90,0:26:08.69,JPN,,0,0,0,,Сота мырза
Dialogue: 0,0:26:25.19,0:26:25.98,JPN,,0,0,0,,Жоқ!
Dialogue: 0,0:26:33.40,0:26:34.15,JPN,,0,0,0,,Hold it there
Dialogue: 0,0:26:41.31,0:26:42.48,JPN,,0,0,0,,Liar
Dialogue: 0,0:26:45.81,0:26:49.10,JPN,,0,0,0,,Thank you for saving me.
Dialogue: 0,0:26:49.10,0:26:49.69,JPN,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:26:50.31,0:26:52.23,JPN,,0,0,0,,You don't look like a wizard.
Dialogue: 0,0:26:52.23,0:26:53.31,JPN,,0,0,0,,What the hell did you do?
Dialogue: 0,0:26:54.15,0:26:56.69,JPN,,0,0,0,,It's like my body suddenly moved...
Dialogue: 0,0:26:57.65,0:26:59.19,JPN,,0,0,0,,Shinkara is amazing
Dialogue: 0,0:26:59.73,0:27:01.44,JPN,,0,0,0,,Chika, second year of high school
Dialogue: 0,0:27:02.02,0:27:03.94,JPN,,0,0,0,,Same age, I'm Suzume.
Dialogue: 0,0:27:04.31,0:27:07.77,JPN,,0,0,0,,Suzume's uniform is unlike any other kid around here.
Dialogue: 0,0:27:09.69,0:27:11.19,JPN,,0,0,0,,What, looking for a cat?
Dialogue: 0,0:27:11.60,0:27:12.56,JPN,,0,0,0,,From Kyushu?
Dialogue: 0,0:27:13.44,0:27:14.81,JPN,,0,0,0,,Suzume's pet cat?
Dialogue: 0,0:27:15.60,0:27:16.85,JPN,,0,0,0,,That's not the case.
Dialogue: 0,0:27:17.48,0:27:21.19,JPN,,0,0,0,,Эй, менің ойымша, бұл фотосуреттің орналасқан жері осында.
Dialogue: 0,0:27:21.19,0:27:21.60,JPN,,0,0,0,,Hey, I think the location of this photo is near here.
Dialogue: 0,0:27:26.15,0:27:26.81,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:27:28.60,0:27:29.31,JPN,,0,0,0,,Suzume?
Dialogue: 0,0:27:37.15,0:27:39.48,JPN,,0,0,0,,Oh, um, sorry, I have something urgent to do.
Dialogue: 0,0:27:41.65,0:27:42.81,JPN,,0,0,0,,Hey, I have something urgent.
Dialogue: 0,0:27:42.81,0:27:43.60,JPN,,0,0,0,,Сузуме
Dialogue: 0,0:27:47.02,0:27:48.90,JPN,,0,0,0,,Do earthworms appear anywhere?
Dialogue: 0,0:27:48.90,0:27:50.52,JPN,,0,0,0,,The back door of this property opened.
Dialogue: 0,0:27:50.90,0:27:51.44,JPN,,0,0,0,,Жақында жабылуы керек
Dialogue: 0,0:27:51.44,0:27:51.85,JPN,,0,0,0,,Жақында жабылуы керек
Dialogue: 0,0:27:52.27,0:27:54.15,JPN,,0,0,0,,Осы қашықтықты жүгіріп өтсеңіз, уақытында жете алмайсыз.
Dialogue: 0,0:27:54.31,0:27:55.02,JPN,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:27:55.02,0:27:55.94,JPN,,0,0,0,,Hey Suzume
Dialogue: 0,0:27:55.94,0:27:57.44,JPN,,0,0,0,,Hey, Suzume!
Dialogue: 0,0:27:58.60,0:27:59.10,JPN,,0,0,0,,Чика
Dialogue: 0,0:27:59.69,0:28:01.73,JPN,,0,0,0,,Мен оның не екенін білмеймін, бірақ бұл асығыс деп ойлаймын, солай ма?
Dialogue: 0,0:28:02.02,0:28:02.73,JPN,,0,0,0,,Жүру
Dialogue: 0,0:28:04.15,0:28:05.73,JPN,,0,0,0,,Is this really the case?
Dialogue: 0,0:28:06.10,0:28:07.98,JPN,,0,0,0,,There was a landslide a few years ago.
Dialogue: 0,0:28:07.98,0:28:09.23,JPN,,0,0,0,,Бұдан басқа ештеңе жоқ
Dialogue: 0,0:28:09.52,0:28:10.27,JPN,,0,0,0,,Бұл қиранды ма?
Dialogue: 0,0:28:10.73,0:28:12.23,JPN,,0,0,0,,Олай болса жақсы, өтінемін.
Dialogue: 0,0:28:12.90,0:28:13.98,JPN,,0,0,0,,Тағы да жер сілкінісі болады
Dialogue: 0,0:28:14.35,0:28:16.90,JPN,,0,0,0,,Құрт жерге құламай тұрып есікті жапсаңыз
Dialogue: 0,0:28:17.19,0:28:17.77,JPN,,0,0,0,,Алдын алуға болады
Dialogue: 0,0:28:18.19,0:28:19.15,JPN,,0,0,0,,Бұл жолы
Dialogue: 0,0:28:23.94,0:28:25.06,JPN,,0,0,0,,That's okay so far.
Dialogue: 0,0:28:25.65,0:28:27.44,JPN,,0,0,0,,Чика, көп рахмет
Dialogue: 0,0:28:27.44,0:28:28.98,JPN,,0,0,0,,О, күте тұрыңыз, Сузуме.
Dialogue: 0,0:28:30.02,0:28:32.73,JPN,,0,0,0,,Сузуме-сан, саған керегі осы.
Dialogue: 0,0:28:33.69,0:28:34.85,JPN,,0,0,0,,Сәлем, Сота-сан
Dialogue: 0,0:28:34.85,0:28:36.02,JPN,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:28:36.02,0:28:37.40,JPN,,0,0,0,,Сол балаға оралу.
Dialogue: 0,0:28:37.40,0:28:39.85,JPN,,0,0,0,,Wait, that body can't do it.
Dialogue: 0,0:28:41.27,0:28:42.31,JPN,,0,0,0,,Мен жасап көремін
Dialogue: 0,0:28:50.56,0:28:52.10,JPN,,0,0,0,,Мектептің артқы есігі бар.
Dialogue: 0,0:29:11.35,0:29:14.19,JPN,,0,0,0,,Бітім, мен мұны істегім де келмейді.
Dialogue: 0,0:29:15.69,0:29:16.65,JPN,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:29:25.35,0:29:26.44,JPN,,0,0,0,,Құлайды
Dialogue: 0,0:29:34.69,0:29:35.52,JPN,,0,0,0,,Сота мырза
Dialogue: 0,0:29:36.10,0:29:36.94,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,0:29:40.23,0:29:42.98,JPN,,0,0,0,,Are you not afraid of dying?
Dialogue: 0,0:29:42.98,0:29:43.90,JPN,,0,0,0,,Қорқынышты емес
Dialogue: 0,0:29:45.85,0:29:48.15,JPN,,0,0,0,,Suzume-san, you lock the door.
Dialogue: 0,0:29:48.90,0:29:49.40,JPN,,0,0,0,,Көзіңізді жабыңыз
Dialogue: 0,0:29:49.69,0:29:51.69,JPN,,0,0,0,,Think of the people who lived here
Dialogue: 0,0:29:52.02,0:29:53.02,JPN,,0,0,0,,Кілт тесігі ашылады
Dialogue: 0,0:29:53.90,0:29:55.19,JPN,,0,0,0,,That's what you said
Dialogue: 0,0:29:55.19,0:29:55.90,JPN,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:29:56.15,0:29:57.15,JPN,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:29:58.06,0:29:58.90,JPN,,0,0,0,,(Куними) Эй, Сакута, ұйықтап қалған соң шашың бүлініп қалыпты.
Dialogue: 0,0:29:59.35,0:30:01.27,JPN,,0,0,0,,Бұл жерде көптеген эмоциялар болған болуы керек.
Dialogue: 0,0:30:01.90,0:30:04.35,JPN,,0,0,0,,Осыны ойлап, дауысты тыңда
Dialogue: 0,0:30:06.98,0:30:07.56,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:30:07.73,0:30:08.31,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:30:08.48,0:30:09.15,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:30:09.31,0:30:10.35,JPN,,0,0,0,,Is the exam tomorrow?
Dialogue: 0,0:30:10.35,0:30:11.27,JPN,,0,0,0,,You studied,right?
Dialogue: 0,0:30:11.27,0:30:12.40,JPN,,0,0,0,,Бүгін тағы да ыстық.
Dialogue: 0,0:30:12.40,0:30:14.10,JPN,,0,0,0,,Next game,I can lose.
Dialogue: 0,0:30:14.10,0:30:17.23,JPN,,0,0,0,,Please come back after you graduate.
Dialogue: 0,0:30:17.60,0:30:19.90,JPN,,0,0,0,,Дана және көрінбейтін құдай
Dialogue: 0,0:30:20.56,0:30:22.40,JPN,,0,0,0,,Алыстағы ата-бабаларымыздың жері.
Dialogue: 0,0:30:22.90,0:30:25.90,JPN,,0,0,0,,Осы таулар мен өзендермен мен көптен араластым.
Dialogue: 0,0:30:26.19,0:30:27.98,JPN,,0,0,0,,Kashikomi,kashikomi
Dialogue: 0,0:30:28.44,0:30:29.73,JPN,,0,0,0,,Құрметпен...
Dialogue: 0,0:30:30.31,0:30:30.77,JPN,,0,0,0,,Қазір!
Dialogue: 0,0:30:31.27,0:30:33.27,JPN,,0,0,0,,I apologize in return!
Dialogue: 0,0:30:55.94,0:30:57.19,JPN,,0,0,0,,Well done, Suzume-san.
Dialogue: 0,0:30:58.23,0:31:00.35,JPN,,0,0,0,,Жер сілкінісінің алдын алдың
Dialogue: 0,0:31:01.19,0:31:02.52,JPN,,0,0,0,,Шынымен бе?
Dialogue: 0,0:31:03.48,0:31:06.02,JPN,,0,0,0,,It's like a lie, it's done, it's done
Dialogue: 0,0:31:06.02,0:31:07.94,JPN,,0,0,0,,Hey, aren't we amazing?
Dialogue: 0,0:31:08.52,0:31:10.06,JPN,,0,0,0,,Торғай, ғажап
Dialogue: 0,0:31:12.81,0:31:14.81,JPN,,0,0,0,,The back will open again
Dialogue: 0,0:31:15.48,0:31:17.02,JPN,,0,0,0,,Кілт тас, күте тұрыңыз!
Dialogue: 0,0:31:21.94,0:31:23.77,JPN,,0,0,0,,Did he open the door?
Dialogue: 0,0:31:29.90,0:31:31.27,JPN,,0,0,0,,?
Dialogue: 0,0:31:32.98,0:31:34.77,JPN,,0,0,0,,...
Dialogue: 0,0:31:35.48,0:31:38.27,JPN,,0,0,0,,Кеше Ая Чанмен қалатыныңды айттың.
Dialogue: 0,0:31:39.69,0:31:41.10,JPN,,0,0,0,,Шағын саяхат дегеніміз не?
Dialogue: 0,0:31:41.10,0:31:42.98,JPN,？？,0,0,0,,Бұл мені күлдіреді.
Dialogue: 0,0:31:43.85,0:31:45.98,JPN,,0,0,0,,Мен ертең міндетті түрде қайтамын.
Dialogue: 0,0:31:45.98,0:31:46.27,JPN,,0,0,0,,Бүгін түнде қайда болмақсың?
Dialogue: 0,0:31:46.27,0:31:47.56,JPN,,0,0,0,,Where are you going to stay tonight?
Dialogue: 0,0:31:47.35,0:31:49.60,JPN,,0,0,0,,...
Dialogue: 0,0:31:50.02,0:31:51.06,JPN,,0,0,0,,Өтінемін, жетекшілік етіңіз
Dialogue: 0,0:31:51.56,0:31:53.27,JPN,,0,0,0,,I will talk to Tamaki-san.
Dialogue: 0,0:31:53.81,0:31:55.69,JPN,,0,0,0,,Мен мұндай нәрселер туралы айтқым келмейді.
Dialogue: 0,0:31:55.69,0:31:57.02,JPN,,0,0,0,,?
Dialogue: 0,0:31:57.90,0:31:59.35,JPN,,0,0,0,,What's okay?
Dialogue: 0,0:31:58.40,0:32:00.27,JPN,,0,0,0,,...
Dialogue: 0,0:32:00.65,0:32:03.27,JPN,,0,0,0,,Қалай болғанда да, бүгін түнде қайда болатынымды біліңіз.
Dialogue: 0,0:32:03.27,0:32:05.94,JPN,,0,0,0,,Сіз мұны жалғыз істеуіңіз керек.
Dialogue: 0,0:32:09.94,0:32:11.02,JPN,,0,0,0,,Minoru-kun
Dialogue: 0,0:32:11.27,0:32:12.27,JPN,,0,0,0,,What Mioot?
Dialogue: 0,0:32:13.56,0:32:14.81,JPN,,0,0,0,,Shigeru-san met for drinks
Dialogue: 0,0:32:15.23,0:32:16.52,JPN,,0,0,0,,...
Dialogue: 0,0:32:16.90,0:32:18.77,JPN,,0,0,0,,Мүлдем, артық емес
Dialogue: 0,0:32:34.69,0:32:35.27,JPN,,0,0,0,,Иә
Dialogue: 0,0:32:35.52,0:32:37.77,JPN,,0,0,0,,...
Dialogue: 0,0:32:38.60,0:32:39.56,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:32:40.23,0:32:42.81,JPN,,0,0,0,,Эй, Сузуме, біз де осында тамақтанбаймыз?
Dialogue: 0,0:32:42.81,0:32:43.40,JPN,,0,0,0,,Әрине
Dialogue: 0,0:32:44.06,0:32:45.77,JPN,,0,0,0,,Кешіріңіз, күте тұрыңыз.
Dialogue: 0,0:32:48.35,0:32:49.02,JPN,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:32:49.48,0:32:50.48,JPN,,0,0,0,,...
Dialogue: 0,0:32:51.10,0:32:53.40,JPN,,0,0,0,,Менің қарным ашпайтын сияқты, бұл дене.
Dialogue: 0,0:32:57.90,0:32:59.27,JPN,,0,0,0,,Itadadakimasu
Dialogue: 0,0:33:09.31,0:33:10.85,JPN,color-sp ▼,0,0,0,,Дәмді
Dialogue: 0,0:33:11.90,0:33:14.06,JPN,,0,0,0,,Кішкене жылағыңыз келе ме?
Dialogue: 0,0:33:14.06,0:33:15.73,JPN,,0,0,0,,...
Dialogue: 0,0:33:16.27,0:33:18.44,JPN,,0,0,0,,You must be that hungry.
Dialogue: 0,0:33:19.06,0:33:21.40,JPN,,0,0,0,,Тұтынушылардың саны бүгін кенеттен өсті.
Dialogue: 0,0:33:21.98,0:33:23.48,JPN,,0,0,0,,Кеш тамақтанғанымыз үшін кешіріңіз.
Dialogue: 0,0:33:23.48,0:33:25.15,JPN,,0,0,0,,No, it's ridiculous.
Dialogue: 0,0:33:25.15,0:33:25.94,JPN,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:33:26.27,0:33:27.52,JPN,,0,0,0,,Түнуге рұқсат беруден басқа
Dialogue: 0,0:33:27.52,0:33:29.19,JPN,,0,0,0,,Ванна, юката және тамақ
Dialogue: 0,0:33:32.81,0:33:33.40,JPN,,0,0,0,,Кім?
Dialogue: 0,0:33:34.15,0:33:34.94,JPN,,0,0,0,,Апай
Dialogue: 0,0:33:42.19,0:33:45.44,JPN,,0,0,0,,Жақында бұл жігітке жігіт болады деп үміттенемін.
Dialogue: 0,0:33:45.44,0:33:46.77,JPN,,0,0,0,,Е, апа, сіз бойдақсыз ба?
Dialogue: 0,0:33:46.77,0:33:47.85,JPN,,0,0,0,,How old is it?
Dialogue: 0,0:33:47.85,0:33:49.19,JPN,,0,0,0,,Probably around 40 years old.
Dialogue: 0,0:33:50.19,0:33:51.60,JPN,,0,0,0,,...
Dialogue: 0,0:33:52.15,0:33:53.73,JPN,,0,0,0,,...
Dialogue: 0,0:33:53.73,0:33:55.19,JPN,,0,0,0,,...
Dialogue: 0,0:33:55.77,0:33:57.48,JPN,,0,0,0,,?
Dialogue: 0,0:33:57.48,0:33:57.94,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:33:58.44,0:33:59.90,JPN,,0,0,0,,...
Dialogue: 0,0:33:59.90,0:34:03.06,JPN,,0,0,0,,Мен апамның қымбат уақытын тонап алған шығармын деп ойлаймын.
Dialogue: 0,0:34:03.65,0:34:05.02,JPN,,0,0,0,,Соңғы кездері бұл туралы біраз ойланып жүрмін.
Dialogue: 0,0:34:06.48,0:34:08.19,JPN,,0,0,0,,Дұрыс, бұл бұрынғы жігіттің желісі.
Dialogue: 0,0:34:08.90,0:34:09.56,JPN,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:34:11.56,0:34:13.73,JPN,,0,0,0,,Менен аулақ жүргеніңді қалаймын.
Dialogue: 0,0:34:16.31,0:34:17.44,JPN,,0,0,0,,...
Dialogue: 0,0:34:18.10,0:34:20.69,JPN,color-sp ▼,0,0,0,,Сузуме, сен бір баламен кездесіп көрдің бе?
Dialogue: 0,0:34:20.98,0:34:22.19,JPN,,0,0,0,,...
Dialogue: 0,0:34:22.85,0:34:24.10,JPN,,0,0,0,,...
Dialogue: 0,0:34:24.65,0:34:27.15,JPN,,0,0,0,,Boys aren't good.
Dialogue: 0,0:34:28.10,0:34:29.18,JPN,,0,0,0,,...
Dialogue: 0,0:34:29.18,0:34:29.69,JPN,,0,0,0,,Жігіт пе?
Dialogue: 0,0:34:30.19,0:34:30.94,JPN,,0,0,0,,Want to listen?
Dialogue: 0,0:34:30.94,0:34:32.06,JPN,,0,0,0,,Оны тыңдағым келмейді.
Dialogue: 0,0:34:30.94,0:34:32.06,JPN,,0,0,0,,...
Dialogue: 0,0:34:33.35,0:34:35.19,JPN,,0,0,0,,...
Dialogue: 0,0:34:36.40,0:34:37.44,JPN,color-sp ▼,0,0,0,,Isn't that a lie?
Dialogue: 0,0:34:37.44,0:34:38.73,JPN,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:34:38.73,0:34:39.69,JPN,,0,0,0,,Not at all
Dialogue: 0,0:34:39.69,0:34:40.44,JPN,,0,0,0,,Moreover
Dialogue: 0,0:34:40.85,0:34:42.69,JPN,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:34:42.69,0:34:44.73,JPN,,0,0,0,,Ей, балалар ақымақ.
Dialogue: 0,0:34:49.06,0:34:50.69,JPN,color-sp ▼,0,0,0,,Бүгін Сузумеге рахмет
Dialogue: 0,0:34:50.69,0:34:52.69,JPN,,0,0,0,,Менің ол жерге бармағаныма біраз болды.
Dialogue: 0,0:34:53.65,0:34:55.44,JPN,color-sp ▼,0,0,0,,Мен оқыған орта мектеп
Dialogue: 0,0:34:55.44,0:34:56.94,JPN,,0,0,0,,It was there.
Dialogue: 0,0:34:57.44,0:34:59.35,JPN,,0,0,0,,Бірнеше жыл бұрын көшкіннің салдарынан
Dialogue: 0,0:34:59.35,0:35:00.69,JPN,,0,0,0,,Бүкіл ауыл тасталған.
Dialogue: 0,0:35:00.69,0:35:01.65,JPN,color-sp ▼,0,0,0,,Бүкіл ауыл тасталған.
Dialogue: 0,0:35:02.56,0:35:03.19,JPN,,0,0,0,,Hey, Suzume.
Dialogue: 0,0:35:04.15,0:35:06.10,JPN,,0,0,0,,Covered in mud
Dialogue: 0,0:35:06.10,0:35:07.44,JPN,,0,0,0,,Сен онда не істедің?
Dialogue: 0,0:35:08.23,0:35:09.77,JPN,,0,0,0,,Бұл не орындық?
Dialogue: 0,0:35:10.48,0:35:10.69,JPN,,0,0,0,,Эй, сен кімсің?
Dialogue: 0,0:35:10.69,0:35:13.40,JPN,,0,0,0,,Эй, сен кімсің?
Dialogue: 0,0:35:15.31,0:35:16.19,JPN,,0,0,0,,That chair
Dialogue: 0,0:35:16.73,0:35:18.23,JPN,,0,0,0,,It's a keepsake of my mother.
Dialogue: 0,0:35:18.98,0:35:19.69,JPN,,0,0,0,,Ах-ли
Dialogue: 0,0:35:20.90,0:35:22.85,JPN,,0,0,0,,Sorry, I can't say it properly.
Dialogue: 0,0:35:24.27,0:35:26.40,JPN,,0,0,0,,...
Dialogue: 0,0:35:26.98,0:35:28.60,JPN,,0,0,0,,It's all about secrets
Dialogue: 0,0:35:29.69,0:35:31.10,JPN,,0,0,0,,But why?
Dialogue: 0,0:35:31.65,0:35:34.69,JPN,,0,0,0,,Мен сенің маңызды бір ісің бар сияқты.
Dialogue: 0,0:35:37.02,0:35:38.56,JPN,,0,0,0,,Thank you, Chika
Dialogue: 0,0:35:39.10,0:35:40.44,JPN,,0,0,0,,Маңызды нәрсе істеп жатқаныңызға сенімдімін.
Dialogue: 0,0:35:40.90,0:35:42.02,JPN,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:35:43.44,0:35:44.81,JPN,,0,0,0,,...
Dialogue: 0,0:36:04.10,0:36:06.23,JPN,,0,0,0,,...
Dialogue: 0,0:36:07.06,0:36:08.23,JPN,,0,0,0,,Who is your boyfriend?
Dialogue: 0,0:36:08.60,0:36:09.69,JPN,,0,0,0,,...
Dialogue: 0,0:36:09.69,0:36:10.56,JPN,,0,0,0,,General theory
Dialogue: 0,0:36:11.27,0:36:12.85,JPN,,0,0,0,,At such times
Dialogue: 0,0:36:15.98,0:36:17.35,JPN,,0,0,0,,Wake me up if I kiss you
Dialogue: 0,0:36:18.69,0:36:20.35,JPN,,0,0,0,,You should be going home already, right?
Dialogue: 0,0:36:21.31,0:36:23.65,JPN,,0,0,0,,Yes, thank you very much for your help.
Dialogue: 0,0:36:23.65,0:36:25.65,JPN,,0,0,0,,Кез келген уақытта қайта келуге болады.
Dialogue: 0,0:36:25.65,0:36:26.15,JPN,,0,0,0,,Иә
Dialogue: 0,0:36:26.15,0:36:26.98,JPN,,0,0,0,,...
Dialogue: 0,0:36:27.52,0:36:28.60,JPN,,0,0,0,,This guy is amazing
Dialogue: 0,0:36:29.98,0:36:32.27,JPN,,0,0,0,,Where did this cat get in?
Dialogue: 0,0:36:32.27,0:36:34.65,JPN,,0,0,0,,々
Dialogue: 0,0:36:34.65,0:36:35.98,JPN,,0,0,0,,…
Dialogue: 0,0:36:37.10,0:36:38.23,JPN,,0,0,0,,...
Dialogue: 0,0:36:40.02,0:36:41.77,JPN,,0,0,0,,...
Dialogue: 0,0:36:43.06,0:36:45.44,JPN,,0,0,0,,Just wake up!
Dialogue: 0,0:36:58.56,0:36:59.60,JPN,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:37:00.23,0:37:01.35,JPN,,0,0,0,,Оның аузы жоқ.
Dialogue: 0,0:37:02.69,0:37:03.60,JPN,,0,0,0,,Сузуме-сан?
Dialogue: 0,0:37:05.69,0:37:06.60,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:37:06.60,0:37:07.10,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:37:07.81,0:37:09.10,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:37:09.60,0:37:10.73,JPN,,0,0,0,,...
Dialogue: 0,0:37:10.73,0:37:12.40,JPN,,0,0,0,,What does this guy want?
Dialogue: 0,0:37:12.85,0:37:14.77,JPN,,0,0,0,,Өйткені құмарлық – Құдайдың мәні.
Dialogue: 0,0:37:15.48,0:37:16.15,JPN,,0,0,0,,Ками?
Dialogue: 0,0:37:16.23,0:37:17.98,JPN,,0,0,0,,...
Dialogue: 0,0:37:18.48,0:37:19.60,JPN,,0,0,0,,We too
Dialogue: 0,0:37:19.60,0:37:21.90,JPN,,0,0,0,,?
Dialogue: 0,0:37:22.98,0:37:24.40,JPN,,0,0,0,,...
Dialogue: 0,0:37:24.90,0:37:25.98,JPN,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:37:25.98,0:37:27.35,JPN,,0,0,0,,...
Dialogue: 0,0:37:29.06,0:37:31.15,JPN,,0,0,0,,Иә, бұл менің кигенімнен гөрі маған жақсырақ көрінеді.
Dialogue: 0,0:37:31.85,0:37:34.48,JPN,,0,0,0,,Форма киіп, орындықты ұстасам, байқалмай ма?
Dialogue: 0,0:37:35.31,0:37:35.90,JPN,,0,0,0,,Chika…
Dialogue: 0,0:37:36.56,0:37:38.73,JPN,,0,0,0,,How should I thank you?
Dialogue: 0,0:37:38.73,0:37:41.48,JPN,,0,0,0,,Ол үшін уайымдама, маған қайта кел.
Dialogue: 0,0:37:42.02,0:37:43.60,JPN,,0,0,0,,Иә, мен міндетті түрде келемін.
Dialogue: 0,0:38:00.40,0:38:01.35,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,0:38:01.35,0:38:03.40,JPN,,0,0,0,,Біз өз ниетімізді нақтырақ көрсетуіміз керек.
Dialogue: 0,0:38:03.85,0:38:05.40,JPN,,0,0,0,,Қолды қатты бұлғау
Dialogue: 0,0:38:05.90,0:38:08.98,JPN,,0,0,0,,Сота мұны істесе, таң қалып, тоқтамас еді деп ойлаймын.
Dialogue: 0,0:38:08.98,0:38:10.77,JPN,,0,0,0,,Орындық қозғалса, біртүрлі болмай ма?
Dialogue: 0,0:38:11.23,0:38:11.85,JPN,,0,0,0,,Жақсы
Dialogue: 0,0:38:12.40,0:38:13.90,JPN,,0,0,0,,Мен білдім
Dialogue: 0,0:38:19.56,0:38:20.65,JPN,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:38:22.85,0:38:24.15,JPN,,0,0,0,,Автобуспен бара аламыз ба?
Dialogue: 0,0:38:26.15,0:38:28.15,JPN,,0,0,0,,Алты сағаттан кейін келесі автобус.
Dialogue: 0,0:38:30.35,0:38:31.65,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,0:38:31.94,0:38:34.77,JPN,,0,0,0,,Бұл орындық анаңның естелігі ме?
Dialogue: 0,0:38:35.23,0:38:35.85,JPN,,0,0,0,,Иә
Dialogue: 0,0:38:36.98,0:38:39.15,JPN,,0,0,0,,Неліктен оның тек үш аяғы бар?
Dialogue: 0,0:38:40.15,0:38:43.02,JPN,,0,0,0,,Бұл кішкентай кезімде болған, сондықтан көп нәрсе есімде жоқ.
Dialogue: 0,0:38:43.44,0:38:45.40,JPN,,0,0,0,,Мен бұл орындықты бір рет жоғалтып алдым.
Dialogue: 0,0:38:46.94,0:38:49.65,JPN,,0,0,0,,Тапсам, жоқ екен.
Dialogue: 0,0:39:04.06,0:39:05.40,JPN,,0,0,0,,Сіз қаншалықты алыс барасыз?
Dialogue: 0,0:39:06.02,0:39:07.40,JPN,,0,0,0,,Автобус келе жатқан жоқ.
Dialogue: 0,0:39:10.77,0:39:12.19,JPN,,0,0,0,,Иә, жалғыз саяхаттау.
Dialogue: 0,0:39:13.23,0:39:14.77,JPN,,0,0,0,,Кобеге қала ішінде жетуге болады ма?
Dialogue: 0,0:39:14.77,0:39:16.06,JPN,,0,0,0,,Иә, бұл пайдалы болар еді.
Dialogue: 0,0:39:17.31,0:39:20.15,JPN,,0,0,0,,Мен кішкентай балаларды үйдегі әжесімен кездесуге алып қайтып келе жатырмын.
Dialogue: 0,0:39:20.73,0:39:22.27,JPN,,0,0,0,,Біз де Кобеденміз
Dialogue: 0,0:39:22.27,0:39:23.48,JPN,,0,0,0,,Сіз бақыттысыз.
Dialogue: 0,0:39:25.15,0:39:26.73,JPN,,0,0,0,,Мама, бірдеңе дұрыс емес.
Dialogue: 0,0:39:26.73,0:39:27.40,JPN,,0,0,0,,Бұл не?
Dialogue: 0,0:39:27.48,0:39:30.85,JPN,,0,0,0,,Жүр, апаңның жүгіне тиіспе.
Dialogue: 0,0:39:30.85,0:39:31.77,JPN,,0,0,0,,Yes
Dialogue: 0,0:39:31.77,0:39:32.44,JPN,,0,0,0,,(Шиозаки) «Кісі өлтіруші» дегенің не?
Dialogue: 0,0:39:33.06,0:39:34.15,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:39:36.02,0:39:36.90,JPN,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:39:37.10,0:39:38.94,JPN,,0,0,0,,Мына балаларға қараңдар!
Dialogue: 0,0:39:38.94,0:39:39.60,JPN,,0,0,0,,Не?
Dialogue: 0,0:39:40.90,0:39:42.77,JPN,,0,0,0,,Оның ішінде жай ғана орындық бар.
Dialogue: 0,0:39:43.56,0:39:44.27,JPN,,0,0,0,,Дұрыс.
Dialogue: 0,0:39:45.06,0:39:46.40,JPN,,0,0,0,,Қараңыз
Dialogue: 0,0:40:17.56,0:40:19.65,JPN,,0,0,0,,Ей, абай бол, Кобо-сан!
Dialogue: 0,0:40:20.52,0:40:21.73,JPN,,0,0,0,,Орындықта шатассаңыз, кешіріңіз.
Dialogue: 0,0:40:21.73,0:40:22.31,JPN,,0,0,0,,Түсіндім
Dialogue: 0,0:40:22.31,0:40:22.90,JPN,,0,0,0,,Мен білемін
Dialogue: 0,0:40:39.35,0:40:41.48,JPN,,0,0,0,,Сіз бұл ойын-сауық саябағын осы жерден көре аласыз.
Dialogue: 0,0:40:41.65,0:40:42.60,JPN,,0,0,0,,Байқамадым
Dialogue: 0,0:40:43.44,0:40:45.27,JPN,,0,0,0,,Бұл ойын-сауық саябағы ма?
Dialogue: 0,0:40:45.27,0:40:46.48,JPN,,0,0,0,,Қараңдаршы, анау тау
Dialogue: 0,0:40:47.52,0:40:49.98,JPN,,0,0,0,,Кішкентай кезімде мені ертіп жүретін едің.
Dialogue: 0,0:40:50.73,0:40:52.73,JPN,,0,0,0,,Тұтынушылар азайып, саябақ жабылды.
Dialogue: 0,0:40:52.73,0:40:53.98,JPN,,0,0,0,,Жоюдың құны жоқ сияқты.
Dialogue: 0,0:40:53.98,0:40:54.52,JPN,,0,0,0,,Жоюдың құны жоқ сияқты.
Dialogue: 0,0:40:54.52,0:40:55.81,JPN,,0,0,0,,Қазір ашық жерде.
Dialogue: 0,0:40:57.02,0:40:59.98,JPN,,0,0,0,,Ондай жалғыз жерлер көбейіп барады.
Dialogue: 0,0:41:04.19,0:41:05.23,JPN,,0,0,0,,Усеян
Dialogue: 0,0:41:06.19,0:41:08.48,JPN,,0,0,0,,Осы балаларды қалдыруды жоспарлап отырған балабақша бар ма?
Dialogue: 0,0:41:08.48,0:41:10.27,JPN,,0,0,0,,Мен кенет демалысқа шыққан сияқтымын.
Dialogue: 0,0:41:10.85,0:41:11.81,JPN,,0,0,0,,О, міне
Dialogue: 0,0:41:13.02,0:41:14.10,JPN,,0,0,0,,Шынымен
Dialogue: 0,0:41:14.56,0:41:15.94,JPN,,0,0,0,,Мен дүкен ашқым келмейді.
Dialogue: 0,0:41:16.40,0:41:17.44,JPN,,0,0,0,,Біреуді табыңыз
Dialogue: 0,0:41:22.02,0:41:23.56,JPN,,0,0,0,,А, мм.
Dialogue: 0,0:41:23.94,0:41:25.85,JPN,,0,0,0,,Сонымен, біз не ойнауымыз керек?
Dialogue: 0,0:41:25.85,0:41:26.60,JPN,,0,0,0,,Ас әзірлеу
Dialogue: 0,0:41:26.60,0:41:27.06,JPN,,0,0,0,,Карри жасау
Dialogue: 0,0:41:27.06,0:41:27.40,JPN,,0,0,0,,Карри жасау
Dialogue: 0,0:41:27.40,0:41:29.06,JPN,,0,0,0,,Ия, Дон!
Dialogue: 0,0:41:32.31,0:41:33.06,JPN,,0,0,0,,Тамақ ішпеңіз
Dialogue: 0,0:41:33.27,0:41:35.06,JPN,,0,0,0,,Оны бос қалдырған жеңеді.
Dialogue: 0,0:41:35.06,0:41:36.44,JPN,,0,0,0,,Ия, Дон!
Dialogue: 0,0:41:37.69,0:41:38.56,JPN,,0,0,0,,Пайдасы жоқ. Бәрі бітті.
Dialogue: 0,0:41:40.48,0:41:42.06,JPN,,0,0,0,,Менің әпкем Фудзи тауы
Dialogue: 0,0:41:42.27,0:41:43.52,JPN,,0,0,0,,Ия, Дон!
Dialogue: 0,0:41:50.06,0:41:53.10,JPN,,0,0,0,,Мен балалы бола алмайтын шығармын.
Dialogue: 0,0:41:54.23,0:41:55.27,JPN,,0,0,0,,Менде басқа амал жоқ.
Dialogue: 0,0:41:59.73,0:42:01.19,JPN,,0,0,0,,Әй, шөп.
Dialogue: 0,0:42:03.60,0:42:05.52,JPN,,0,0,0,,Қараңызшы, бұл ғажап, солай емес пе?
Dialogue: 0,0:42:05.52,0:42:07.44,JPN,,0,0,0,,Бұл жақсы жасалған ойыншық.
Dialogue: 0,0:42:15.06,0:42:16.81,JPN,,0,0,0,,Келесі мен және мен
Dialogue: 0,0:42:20.52,0:42:21.90,JPN,,0,0,0,,Эй, мен де келесім.
Dialogue: 0,0:42:21.90,0:42:22.73,JPN,,0,0,0,,Сіз емес
Dialogue: 0,0:42:23.44,0:42:24.15,JPN,,0,0,0,,Сөйлесті
Dialogue: 0,0:42:25.44,0:42:26.60,JPN,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:42:26.60,0:42:29.65,JPN,,0,0,0,,Соңғы АИ-мен жабдықталған орындық тәрізді робот
Dialogue: 0,0:42:29.65,0:42:30.56,JPN,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:42:31.73,0:42:32.65,JPN,,0,0,0,,Сота
Dialogue: 0,0:42:32.65,0:42:34.48,JPN,,0,0,0,,Сота, ертең не болады?
Dialogue: 0,0:42:33.90,0:42:35.48,JPN,,0,0,0,,Сота, музыка ойна.
Dialogue: 0,0:42:34.90,0:42:36.40,JPN,,0,0,0,,Сота, Ширитори жасайық
Dialogue: 0,0:42:35.77,0:42:37.31,JPN,,0,0,0,,Сота, бүгінгі кабука қандай?
Dialogue: 0,0:42:37.31,0:42:38.77,JPN,,0,0,0,,Өйткені мен онша ақылды емеспін
Dialogue: 0,0:42:38.77,0:42:40.15,JPN,,0,0,0,,Не, Сузуме-сан?
Dialogue: 0,0:42:40.31,0:42:41.73,JPN,,0,0,0,,Ол тағы да сөйледі.
Dialogue: 0,0:42:44.52,0:42:45.90,JPN,,0,0,0,,Сіз қашқынсыз ба?
Dialogue: 0,0:42:48.02,0:42:51.10,JPN,,0,0,0,,Баттен, менің де бала кезім есімде.
Dialogue: 0,0:42:51.56,0:42:53.40,JPN,,0,0,0,,Сол жаста, білесің бе?
Dialogue: 0,0:42:53.40,0:42:57.15,JPN,,0,0,0,,Қаланың және сіздің ата-анаңыздың тар болғанын сездіңіз бе?
Dialogue: 0,0:42:57.77,0:42:58.40,JPN,,0,0,0,,Егер оларға жұлын сұйықтығы енгізілген болса,
Dialogue: 0,0:42:58.40,0:43:00.40,JPN,,0,0,0,,Маған оқиғаны айтып беріңізші?
Dialogue: 0,0:43:01.85,0:43:02.90,JPN,,0,0,0,,Дұрыс.
Dialogue: 0,0:43:04.44,0:43:04.90,JPN,,0,0,0,,Бұл бала қайда баруды жоспарлап отыр?
Dialogue: 0,0:43:04.90,0:43:06.94,JPN,,0,0,0,,Бұл бала қайда баруды жоспарлап отыр?
Dialogue: 0,0:43:06.94,0:43:08.35,JPN,,0,0,0,,Сіз не нәрсеге қанағаттанбайсыз?
Dialogue: 0,0:43:08.35,0:43:10.69,JPN,,0,0,0,,Қанша сұрасам да, қашып құтылады.
Dialogue: 0,0:43:10.69,0:43:12.65,JPN,,0,0,0,,Бүгін түнде қайда болатынымды айтпайсың.
Dialogue: 0,0:43:13.65,0:43:15.77,JPN,,0,0,0,,GPS смартфоны және т.б.
Dialogue: 0,0:43:15.77,0:43:16.94,JPN,,0,0,0,,Бөлісу
Dialogue: 0,0:43:17.27,0:43:19.44,JPN,,0,0,0,,Егер мен мұны істесем, мен өз аккаунтымды көре аламын ба?
Dialogue: 0,0:43:20.06,0:43:21.90,JPN,,0,0,0,,Suzume смартфонына сілтеме
Dialogue: 0,0:43:26.35,0:43:27.56,JPN,,0,0,0,,Бұл Донге ме?
Dialogue: 0,0:43:27.56,0:43:29.65,JPN,,0,0,0,,Мына қыз Кобиге бара жатыр.
Dialogue: 0,0:43:29.65,0:43:30.40,JPN,,0,0,0,,Коби
Dialogue: 0,0:43:31.06,0:43:33.65,JPN,,0,0,0,,Бұл өте алыс.
Dialogue: 0,0:43:34.23,0:43:36.06,JPN,,0,0,0,,Мен сені енді жалғыз қалдыра алмаймын.
Dialogue: 0,0:43:36.06,0:43:37.35,JPN,,0,0,0,,Ум, Тамаки-сан.
Dialogue: 0,0:43:37.65,0:43:39.69,JPN,,0,0,0,,Мен істей алатын тағы бір нәрсе бар ма?
Dialogue: 0,0:43:39.69,0:43:40.35,JPN,,0,0,0,,Минору-кун
Dialogue: 0,0:43:40.90,0:43:43.02,JPN,,0,0,0,,Мен ертеңнен бастап жұмыстан қысқа үзіліс аламын.
Dialogue: 0,0:43:44.60,0:43:46.23,JPN,,0,0,0,,Менің де демалуым керек сияқты.
Dialogue: 0,0:43:46.23,0:43:47.06,JPN,,0,0,0,,Неліктен?
Dialogue: 0,0:43:47.06,0:43:48.65,JPN,,0,0,0,,Сіз жұмысқа бармайсыз.
Dialogue: 0,0:43:49.27,0:43:50.27,JPN,,0,0,0,,Дұрыс.
Dialogue: 0,0:43:51.90,0:43:54.40,JPN,,0,0,0,,Сузуме-чан, бір сәтке келуге бола ма?
Dialogue: 0,0:43:54.60,0:43:55.48,JPN,,0,0,0,,Yes
Dialogue: 0,0:43:59.40,0:44:01.02,JPN,,0,0,0,,Руми-сан, сен сондай сұлусың
Dialogue: 0,0:44:01.94,0:44:02.81,JPN,,0,0,0,,Сіз басқа адамсыз ба?
Dialogue: 0,0:44:03.31,0:44:04.40,JPN,,0,0,0,,Кішкентайлар, амансыңдар ма?
Dialogue: 0,0:44:04.40,0:44:05.98,JPN,,0,0,0,,Иә, мен тыныш ұйықтап жатырмын.
Dialogue: 0,0:44:06.52,0:44:08.27,JPN,,0,0,0,,Олай болса, маған аздап көмектесе аласыз ба?
Dialogue: 0,0:44:08.94,0:44:11.51,JPN,,0,0,0,,Бұлай толып кету мүмкін емес.
Dialogue: 0,0:44:19.94,0:44:21.85,JPN,,0,0,0,,Ана, мына бала көмектесе ала ма?
Dialogue: 0,0:44:21.85,0:44:22.81,JPN,,0,0,0,,Оған не болды?
Dialogue: 0,0:44:22.81,0:44:25.06,JPN,,0,0,0,,О, қош келдіңіз.
Dialogue: 0,0:44:25.06,0:44:26.94,JPN,,0,0,0,,Аудиторияға баруға болады.
Dialogue: 0,0:44:26.94,0:44:27.52,JPN,,0,0,0,,Иә
Dialogue: 0,0:44:30.02,0:44:31.56,JPN,,0,0,0,,Бұны тез жуыңыз.
Dialogue: 0,0:44:31.56,0:44:32.27,JPN,,0,0,0,,Иә
Dialogue: 0,0:44:32.27,0:44:32.52,JPN,,0,0,0,,Маған мұз беріңізші
Dialogue: 0,0:44:32.52,0:44:33.10,JPN,,0,0,0,,Маған мұз беріңізші
Dialogue: 0,0:44:33.10,0:44:33.56,JPN,,0,0,0,,Иә
Dialogue: 0,0:44:33.56,0:44:34.81,JPN,,0,0,0,,Екі стақан шарап
Dialogue: 0,0:44:34.81,0:44:35.52,JPN,,0,0,0,,Түсінікті.
Dialogue: 0,0:44:35.52,0:44:36.98,JPN,,0,0,0,,Жоқ, анау емес, анау.
Dialogue: 0,0:44:36.98,0:44:37.40,JPN,,0,0,0,,Иә
Dialogue: 0,0:44:37.85,0:44:38.90,JPN,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:44:39.27,0:44:41.15,JPN,,0,0,0,,Сузуме-чан, үш орамал.
Dialogue: 0,0:44:41.39,0:44:41.85,JPN,,0,0,0,,Иә
Dialogue: 0,0:44:42.69,0:44:43.60,JPN,,0,0,0,,Бөтелке әлі бар ма?
Dialogue: 0,0:44:43.60,0:44:44.19,JPN,,0,0,0,,Жақсы
Dialogue: 0,0:44:44.19,0:44:45.15,JPN,,0,0,0,,Сасаки мырза
Dialogue: 0,0:44:45.15,0:44:45.65,JPN,,0,0,0,,Түсінікті.
Dialogue: 0,0:44:54.02,0:44:56.40,JPN,,0,0,0,,Ой, сен сондай жас қыз екенсің.
Dialogue: 0,0:44:56.77,0:44:58.23,JPN,,0,0,0,,Апаймен бірге ішейік.
Dialogue: 0,0:44:58.23,0:44:59.56,JPN,,0,0,0,,Дуэт айтайық
Dialogue: 0,0:44:59.56,0:45:01.10,JPN,,0,0,0,,Сіз әлі жассыз ба?
Dialogue: 0,0:45:00.11,0:45:01.10,JPN,,0,0,0,,Ерм
Dialogue: 0,0:45:01.40,0:45:02.44,JPN,,0,0,0,,О, мен сондай бақыттымын.
Dialogue: 0,0:45:02.44,0:45:03.91,JPN,,0,0,0,,Мен сендерге той беремін.
Dialogue: 0,0:45:04.69,0:45:06.52,JPN,,0,0,0,,Мики-чан, мен білмеймін.
Dialogue: 0,0:45:06.52,0:45:07.60,JPN,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:45:07.60,0:45:08.69,JPN,,0,0,0,,Басқа айтар сөзің жоқ па?
Dialogue: 0,0:45:08.69,0:45:09.47,JPN,,0,0,0,,Дайжин
Dialogue: 0,0:45:09.98,0:45:11.52,JPN,,0,0,0,,Мен енді ішпеймін.
Dialogue: 0,0:45:11.52,0:45:12.48,JPN,,0,0,0,,Сәлем!
Dialogue: 0,0:45:12.77,0:45:14.52,JPN,,0,0,0,,Даиджин, күткендей
Dialogue: 0,0:45:14.52,0:45:16.48,JPN,,0,0,0,,Эй, мен қуаныштымын.
Dialogue: 0,0:45:16.98,0:45:18.19,JPN,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:45:19.72,0:45:21.34,JPN,,0,0,0,,Сол орындықта.
Dialogue: 0,0:45:22.77,0:45:23.97,JPN,,0,0,0,,Бұл бірінші рет.
Dialogue: 0,0:45:24.85,0:45:25.60,JPN,,0,0,0,,Адам?
Dialogue: 0,0:45:25.60,0:45:27.27,JPN,,0,0,0,,Мен тыныш адаммын.
Dialogue: 0,0:45:27.27,0:45:29.40,JPN,,0,0,0,,Мен қарапайым адамдармен тез достасып кеттім.
Dialogue: 0,0:45:30.56,0:45:31.85,JPN,,0,0,0,,Е, аздап
Dialogue: 0,0:45:31.85,0:45:34.48,JPN,,0,0,0,,Бұл мысыққа ұқсамайды ма?
Dialogue: 0,0:45:34.48,0:45:35.60,JPN,,0,0,0,,Сонымен?
Dialogue: 0,0:45:35.94,0:45:37.44,JPN,,0,0,0,,Шибу керемет.
Dialogue: 0,0:45:42.35,0:45:43.77,JPN,,0,0,0,,О, қош келдіңіз.
Dialogue: 0,0:45:44.44,0:45:46.85,JPN,,0,0,0,,Мм, кешіріңіз, мен кішкентаймын...
Dialogue: 0,0:45:50.73,0:45:52.44,JPN,,0,0,0,,Сота-сан, Дайджин!
Dialogue: 0,0:45:59.44,0:46:01.31,JPN,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:46:02.90,0:46:04.60,JPN,,0,0,0,,Сузуме, Генки?
Dialogue: 0,0:46:07.94,0:46:09.10,JPN,,0,0,0,,Қара, қара.
Dialogue: 0,0:46:10.77,0:46:11.73,JPN,,0,0,0,,Құрт
Dialogue: 0,0:46:16.06,0:46:16.73,JPN,,0,0,0,,Дайжин
Dialogue: 0,0:46:18.48,0:46:20.02,JPN,,0,0,0,,Сузуме-сан, мен кетуім керек.
Dialogue: 0,0:46:27.06,0:46:27.73,JPN,,0,0,0,,Бұл жер сілкінісі ме?
Dialogue: 0,0:46:28.15,0:46:29.35,JPN,,0,0,0,,Өтірік
Dialogue: 0,0:46:30.15,0:46:31.10,JPN,,0,0,0,,Мики-чан мен Сүзүмэ-чан ше?
Dialogue: 0,0:46:31.10,0:46:31.98,JPN,,0,0,0,,Мики-чан мен Сюзэмэ-чан ше?
Dialogue: 0,0:46:33.98,0:46:34.98,JPN,,0,0,0,,Сол ойын-сауық саябағы.
Dialogue: 0,0:46:48.06,0:46:48.98,JPN,,0,0,0,,Доңғалақ
Dialogue: 0,0:46:49.27,0:46:50.56,JPN,,0,0,0,,Бұл артқы есік.
Dialogue: 0,0:46:54.27,0:46:55.31,JPN,,0,0,0,,Сота-сан, қарашы.
Dialogue: 0,0:46:58.98,0:46:59.73,JPN,,0,0,0,,Дайжин
Dialogue: 0,0:47:01.06,0:47:04.44,JPN,,0,0,0,,Сузүмэ-сан, мен Дайдзинді ұстап алып, оны кілт тасына қайтарамын.
Dialogue: 0,0:47:04.69,0:47:05.85,JPN,,0,0,0,,Ал, сіз
Dialogue: 0,0:47:06.98,0:47:08.77,JPN,,0,0,0,,Есікті жабыңыз және бекітіңіз
Dialogue: 0,0:47:09.19,0:47:09.94,JPN,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:47:17.02,0:47:17.90,JPN,,0,0,0,,Есікті сұраңыз
Dialogue: 0,0:47:26.06,0:47:26.73,JPN,,0,0,0,,Бұл не? Мен байланғанмын.
Dialogue: 0,0:47:32.19,0:47:32.77,JPN,,0,0,0,,бірақ көзге ілеспейтіндей жылдам
Dialogue: 0,0:47:33.15,0:47:34.10,JPN,,0,0,0,,Дененің қозғалуы
Dialogue: 0,0:47:34.40,0:47:35.69,JPN,,0,0,0,,Қашан үйрендің?
Dialogue: 0,0:47:36.40,0:47:37.10,JPN,,0,0,0,,Бұл жолы
Dialogue: 0,0:47:54.94,0:47:56.77,JPN,,0,0,0,,Торғай, ғажап
Dialogue: 0,0:48:00.52,0:48:01.15,JPN,,0,0,0,,Дайжин
Dialogue: 0,0:48:05.52,0:48:08.69,JPN,,0,0,0,,Бүгін оны бастапқы қалпына келтіру күні.
Dialogue: 0,0:48:23.77,0:48:24.81,JPN,,0,0,0,,Қара, жарық
Dialogue: 0,0:48:25.27,0:48:26.35,JPN,,0,0,0,,Бұл не?
Dialogue: 0,0:48:26.56,0:48:27.69,JPN,,0,0,0,,Үйінділер, солай ма?
Dialogue: 0,0:48:30.85,0:48:31.35,JPN,,0,0,0,,Не?
Dialogue: 0,0:48:34.73,0:48:35.77,JPN,,0,0,0,,Күт, күт, күт
Dialogue: 0,0:48:37.06,0:48:37.52,JPN,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:48:41.94,0:48:42.48,JPN,,0,0,0,,Ах.
Dialogue: 0,0:49:04.06,0:49:05.27,JPN,,0,0,0,,Ана?
Dialogue: 0,0:49:09.44,0:49:11.77,JPN,,0,0,0,,Кілттік тасқа оралып, жауын құртын басу.
Dialogue: 0,0:49:12.44,0:49:15.06,JPN,,0,0,0,,Шығыс бағанасы ғана ұзаққа бармайды.
Dialogue: 0,0:49:15.06,0:49:15.60,JPN,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,0:49:15.60,0:49:16.44,JPN,,0,0,0,,Неліктен?
Dialogue: 0,0:49:16.44,0:49:18.52,JPN,,0,0,0,,Мен сізге рөлді тапсырдым.
Dialogue: 0,0:49:18.77,0:49:20.23,JPN,,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:49:20.23,0:49:21.52,JPN,,0,0,0,,Сіз жоғалып кетесіз
Dialogue: 0,0:49:22.10,0:49:24.27,JPN,,0,0,0,,Дайджин торғаймен ойнайды
Dialogue: 0,0:49:24.56,0:49:25.69,JPN,,0,0,0,,Сузуме-санмен?
Dialogue: 0,0:49:30.60,0:49:31.52,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,0:49:31.81,0:49:33.52,JPN,,0,0,0,,Не болды, Сузуме-сан?
Dialogue: 0,0:49:34.23,0:49:35.02,JPN,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:49:35.35,0:49:36.77,JPN,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:49:39.23,0:49:41.10,JPN,,0,0,0,,Сузуме-сан, қайтып кел!
Dialogue: 0,0:49:41.10,0:49:42.27,JPN,,0,0,0,,Онда кірме
Dialogue: 0,0:49:43.15,0:49:44.27,JPN,,0,0,0,,Сузуме-сан!
Dialogue: 0,0:49:53.23,0:49:55.35,JPN,,0,0,0,,Сузуме-сан, сен айналмалы дөңгелектің ішіндесің!
Dialogue: 0,0:49:55.35,0:49:55.98,JPN,,0,0,0,,Сузуме-сан, сен айналмалы дөңгелектің ішіндесің!
Dialogue: 0,0:49:56.98,0:49:58.35,JPN,,0,0,0,,Оян
Dialogue: 0,0:49:58.35,0:50:00.10,JPN,,0,0,0,,Ол сол күйінде қалдырылған жағдайда құлап қалады.
Dialogue: 0,0:50:00.48,0:50:01.27,JPN,,0,0,0,,Ақымақ
Dialogue: 0,0:50:01.65,0:50:03.69,JPN,,0,0,0,,Дана және көрінбейтін құдай
Dialogue: 0,0:50:06.65,0:50:08.98,JPN,,0,0,0,,Алыстағы ата-бабаларымыздың жері.
Dialogue: 0,0:50:10.31,0:50:12.98,JPN,,0,0,0,,Осы таулар мен өзендермен мен көптен араластым.
Dialogue: 0,0:50:13.40,0:50:15.27,JPN,,0,0,0,,Кашикоми,кашикоми
Dialogue: 0,0:50:15.27,0:50:17.35,JPN,,0,0,0,,Жауабыңызды кішіпейілділікпен сұраймын.
Dialogue: 0,0:50:15.61,0:50:16.90,JPN,,0,0,0,,жоғары жоғары
Dialogue: 0,0:50:16.90,0:50:17.77,JPN,,0,0,0,,Жоқ,тек кедергі келтіресің.
Dialogue: 0,0:50:17.98,0:50:19.19,JPN,,0,0,0,,Сіз тым толқып тұрсыз.
Dialogue: 0,0:50:19.19,0:50:20.77,JPN,,0,0,0,,Мен бәріңмен бірге тағы барғым келеді.
Dialogue: 0,0:50:21.60,0:50:22.90,JPN,,0,0,0,,Бүгін мерейтой.
Dialogue: 0,0:50:22.90,0:50:23.85,JPN,,0,0,0,,Мен тағы да келемін деп үміттенемін
Dialogue: 0,0:50:23.85,0:50:25.94,JPN,,0,0,0,,Алғашқы кездесуіңізде ойын-сауық саябағына барасыз ба?
Dialogue: 0,0:50:25.94,0:50:27.48,JPN,,0,0,0,,Біз жақсы емеспіз.
Dialogue: 0,0:50:28.73,0:50:31.31,JPN,,0,0,0,,Әке,бізге көбірек келіңіз.
Dialogue: 0,0:50:28.73,0:50:31.31,JPN,,0,0,0,,Роликке тағы да мінейік
Dialogue: 0,0:50:33.98,0:50:35.02,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,0:50:35.40,0:50:36.02,JPN,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:50:36.56,0:50:37.19,JPN,,0,0,0,,Сота мырза
Dialogue: 0,0:50:50.19,0:50:52.77,JPN,,0,0,0,,Дана және көрінбейтін құдай
Dialogue: 0,0:50:52.90,0:50:54.69,JPN,,0,0,0,,Алыстағы ата-бабаларымыздың жері.
Dialogue: 0,0:50:55.48,0:50:58.27,JPN,,0,0,0,,Осы таулар мен өзендермен мен көптен араластым.
Dialogue: 0,0:50:59.15,0:51:00.98,JPN,,0,0,0,,Кашикоми,кашикоми
Dialogue: 0,0:51:01.73,0:51:03.52,JPN,,0,0,0,,Құрметпен...
Dialogue: 0,0:51:03.69,0:51:04.52,JPN,,0,0,0,,Қазір!
Dialogue: 0,0:51:04.77,0:51:05.94,JPN,,0,0,0,,Мен оны саған қайтарамын!
Dialogue: 0,0:51:17.69,0:51:18.31,JPN,,0,0,0,,Дайжин ше?
Dialogue: 0,0:51:19.44,0:51:20.69,JPN,,0,0,0,,Ол қайтадан қашып кетті
Dialogue: 0,0:51:25.06,0:51:26.06,JPN,,0,0,0,,ішке кірейік
Dialogue: 0,0:51:29.73,0:51:30.35,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:51:30.98,0:51:32.85,JPN,,0,0,0,,Бұл қорқынышты болды
Dialogue: 0,0:51:35.73,0:51:37.23,JPN,,0,0,0,,Сіз керемет болдыңыз
Dialogue: 0,0:51:37.23,0:51:38.10,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:51:42.40,0:51:46.19,JPN,,0,0,0,,Сузуме-сан, сен артқы есікте не қарап тұрдың?
Dialogue: 0,0:51:48.44,0:51:50.85,JPN,,0,0,0,,Өте тамаша жұлдызды аспан
Dialogue: 0,0:51:50.85,0:51:51.98,JPN,,0,0,0,,Шалғындық және
Dialogue: 0,0:51:51.98,0:51:53.06,JPN,,0,0,0,,Токио
Dialogue: 0,0:51:53.56,0:51:55.19,JPN,,0,0,0,,Мәңгілік әлемді көруге болады
Dialogue: 0,0:51:56.02,0:51:56.81,JPN,,0,0,0,,Токио?
Dialogue: 0,0:51:56.81,0:51:58.19,JPN,,0,0,0,,Бұл дүниенің екінші жағы
Dialogue: 0,0:51:58.19,0:51:59.56,JPN,,0,0,0,,Жаңбыр құрттарының тіршілік ету ортасы
Dialogue: 0,0:51:59.56,0:52:02.40,JPN,,0,0,0,,Мұндағы барлық уақыт бір уақытта
Dialogue: 0,0:52:02.40,0:52:04.23,JPN,,0,0,0,,Мен оны көріп тұрмын, бірақ кіре алмаймын ба?
Dialogue: 0,0:52:04.90,0:52:07.98,JPN,,0,0,0,,Мәңгілік өмір өлгендер баратын жер дейді.
Dialogue: 0,0:52:09.19,0:52:12.02,JPN,,0,0,0,,Бұл дүниеде өмір сүріп жатқан біз жете алмайтын жер
Dialogue: 0,0:52:12.69,0:52:14.35,JPN,,0,0,0,,Бұл баруға болмайтын жер.
Dialogue: 0,0:52:16.73,0:52:18.35,JPN,,0,0,0,,Жаман қыз қайтып келді
Dialogue: 0,0:52:19.56,0:52:20.48,JPN,,0,0,0,,Сузуме-чан
Dialogue: 0,0:52:20.81,0:52:22.02,JPN,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:52:22.56,0:52:23.73,JPN,,0,0,0,,Кешіріңіз, мм.
Dialogue: 0,0:52:23.94,0:52:25.60,JPN,,0,0,0,,Сондай сағатта жоғалып кеттің.
Dialogue: 0,0:52:25.60,0:52:26.65,JPN,,0,0,0,,Сіз қаншалықты уайымдадыңыз?
Dialogue: 0,0:52:26.65,0:52:28.48,JPN,,0,0,0,,Мен мұны қауіпсіз орындадым деп ойлаймын.
Dialogue: 0,0:52:28.48,0:52:29.73,JPN,,0,0,0,,Сейаға
Dialogue: 0,0:52:29.73,0:52:31.85,JPN,,0,0,0,,Үйден қашқанымыз дұрыс болды.
Dialogue: 0,0:52:36.31,0:52:37.23,JPN,,0,0,0,,Әзірге
Dialogue: 0,0:52:37.48,0:52:38.73,JPN,,0,0,0,,Бірдеңе жейміз бе?
Dialogue: 0,0:52:38.73,0:52:40.23,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:52:40.85,0:52:42.35,JPN,,0,0,0,,Қуырылған удон ше?
Dialogue: 0,0:52:42.35,0:52:44.15,JPN,,0,0,0,,Иә, оның үстіне қуырылған жұмыртқа салады.
Dialogue: 0,0:52:44.15,0:52:45.35,JPN,,0,0,0,,Сізге тунец майоны қажет емес пе?
Dialogue: 0,0:52:45.35,0:52:46.48,JPN,,0,0,0,,Иә, Сузуме-чан ше?
Dialogue: 0,0:52:46.98,0:52:48.98,JPN,,0,0,0,,Біз картоп салатын қолданамыз.
Dialogue: 0,0:52:49.81,0:52:50.98,JPN,,0,0,0,,Қуырылған удон кеспесі?
Dialogue: 0,0:52:52.60,0:52:54.02,JPN,,0,0,0,,Уау, ау!
Dialogue: 0,0:52:55.98,0:52:57.44,JPN,,0,0,0,,Бұл көп калория.
Dialogue: 0,0:52:56.73,0:52:58.48,JPN,,0,0,0,,Соңғы жебеге айналғанша...
Dialogue: 0,0:52:58.98,0:53:00.23,JPN,,0,0,0,,Itadadakimasu
Dialogue: 0,0:53:04.90,0:53:05.77,JPN,,0,0,0,,Дәмді
Dialogue: 0,0:53:05.77,0:53:06.98,JPN,,0,0,0,,Бұл сізді міндетті түрде семіз етеді
Dialogue: 0,0:53:06.98,0:53:07.73,JPN,,0,0,0,,Сырамен жақсы үйлесетін сияқты
Dialogue: 0,0:53:08.06,0:53:08.73,JPN,,0,0,0,,Сіз ішпейсіз бе?
Dialogue: 0,0:53:09.23,0:53:11.02,JPN,,0,0,0,,Ей, сонша іш.
Dialogue: 0,0:53:11.02,0:53:11.98,JPN,,0,0,0,,Бірақ ішеміз бе?
Dialogue: 0,0:53:11.98,0:53:13.81,JPN,,0,0,0,,Эй, Сота-сан да.
Dialogue: 0,0:53:12.31,0:53:13.27,JPN,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:53:13.27,0:53:15.85,JPN,,0,0,0,,Бірақ картоп салаты мен ойлағаннан да жақсы шықты.
Dialogue: 0,0:53:14.98,0:53:15.85,JPN,,0,0,0,,Мен?
Dialogue: 0,0:53:15.85,0:53:17.31,JPN,,0,0,0,,Келесі жолы жігітіме жасап беруім керек пе?
Dialogue: 0,0:53:17.31,0:53:18.73,JPN,,0,0,0,,Сенің жігітің жоқ, солай ма?
Dialogue: 0,0:53:18.73,0:53:20.10,JPN,,0,0,0,,Сіз мұны бірден жасай аласыз
Dialogue: 0,0:53:20.94,0:53:22.06,JPN,,0,0,0,,Не, мына орындық?
Dialogue: 0,0:53:22.06,0:53:23.17,JPN,,0,0,0,,О, бұл сүйкімді
Dialogue: 0,0:53:23.17,0:53:24.27,JPN,,0,0,0,,Балалар орындығы?
Dialogue: 0,0:53:24.27,0:53:25.15,JPN,,0,0,0,,Сен неге отырдың?
Dialogue: 0,0:53:25.69,0:53:26.77,JPN,,0,0,0,,Коби туралы естеліктер
Dialogue: 0,0:53:27.48,0:53:28.48,JPN,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:53:34.31,0:53:36.23,JPN,,0,0,0,,Менің ойымша, олар мені біртүрлі бала деп ойлады.
Dialogue: 0,0:53:36.73,0:53:37.56,JPN,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:53:38.52,0:53:41.19,JPN,,0,0,0,,Сота мырза үнемі осылай саяхаттаған ба?
Dialogue: 0,0:53:41.77,0:53:44.19,JPN,,0,0,0,,Мәңгі емес, Токиода пәтерім бар.
Dialogue: 0,0:53:45.19,0:53:47.73,JPN,,0,0,0,,Мен университетті бітіргенде мұғалім болуды жоспарлап отырмын.
Dialogue: 0,0:53:50.19,0:53:51.48,JPN,,0,0,0,,Сіз университет студентісіз бе?
Dialogue: 0,0:53:51.81,0:53:52.48,JPN,,0,0,0,,Дұрыс.
Dialogue: 0,0:53:52.73,0:53:53.67,JPN,,0,0,0,,Сіз жұмысқа тұрасыз ба?
Dialogue: 0,0:53:54.09,0:53:54.98,JPN,,0,0,0,,Жабу шебері кім?
Dialogue: 0,0:53:55.35,0:53:58.35,JPN,,0,0,0,,Клоистерлік – ұрпақтар бойы жалғасатын отбасылық бизнес.
Dialogue: 0,0:53:58.35,0:53:59.60,JPN,,0,0,0,,Мәңгілік жалғастыру
Dialogue: 0,0:54:00.44,0:54:02.44,JPN,,0,0,0,,Бірақ бұл күн көру үшін жеткіліксіз.
Dialogue: 0,0:54:02.44,0:54:03.48,JPN,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:54:04.35,0:54:05.73,JPN,,0,0,0,,Маңызды жұмыс болса да
Dialogue: 0,0:54:06.23,0:54:07.73,JPN,,0,0,0,,Маңызды жұмыс
Dialogue: 0,0:54:07.73,0:54:09.69,JPN,,0,0,0,,Адамдар көрмесе жақсы
Dialogue: 0,0:54:10.35,0:54:12.31,JPN,,0,0,0,,Бастапқы пішінге жылдам оралыңыз
Dialogue: 0,0:54:12.73,0:54:15.27,JPN,,0,0,0,,Мен қорытынды шебер ретінде де, мұғалім ретінде де істеймін.
Dialogue: 0,0:54:20.23,0:54:21.81,JPN,,0,0,0,,Бірақ қазірдің өзінде...
Dialogue: 0,0:54:27.65,0:54:29.06,JPN,,0,0,0,,Бірақ мен мүмкін
Dialogue: 0,0:54:30.10,0:54:32.27,JPN,,0,0,0,,Қазірдің өзінде... қазірдің өзінде...
Dialogue: 0,0:54:39.40,0:54:40.85,JPN,,0,0,0,,Қозғалу
Dialogue: 0,0:54:41.73,0:54:43.19,JPN,,0,0,0,,Жарық сөнеді
Dialogue: 0,0:54:43.73,0:54:45.10,JPN,,0,0,0,,Дауыс жоғалады
Dialogue: 0,0:54:45.65,0:54:47.02,JPN,,0,0,0,,Дене жоғалады
Dialogue: 0,0:54:47.73,0:54:49.19,JPN,,0,0,0,,Жүрек жоғалады
Dialogue: 0,0:54:51.06,0:54:55.52,JPN,,0,0,0,,Суық...
Dialogue: 0,0:54:55.98,0:54:56.94,JPN,,0,0,0,,Суық...
Dialogue: 0,0:55:12.77,0:55:13.81,JPN,,0,0,0,,Мен...
Dialogue: 0,0:55:25.85,0:55:28.98,JPN,,0,0,0,,Мен баратын жер осы ма?
Dialogue: 0,0:55:37.90,0:55:39.52,JPN,,0,0,0,,Сота мырза
Dialogue: 0,0:55:40.40,0:55:41.73,JPN,,0,0,0,,Сота мырза
Dialogue: 0,0:55:48.10,0:55:49.02,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:55:49.02,0:55:50.52,JPN,,0,0,0,,Ақыры мен ояндым
Dialogue: 0,0:55:50.52,0:55:51.88,JPN,,0,0,0,,Сәлем, Даиджин
Dialogue: 0,0:55:51.88,0:55:53.48,JPN,,0,0,0,,Тағы бір фотосурет жарияланды
Dialogue: 0,0:55:54.15,0:55:54.85,JPN,,0,0,0,,Қараңыз
Dialogue: 0,0:55:56.27,0:55:57.19,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,0:55:58.35,0:56:00.77,JPN,,0,0,0,,Маған дәл қазір не істедің?
Dialogue: 0,0:56:01.65,0:56:02.73,JPN,,0,0,0,,Негізінде
Dialogue: 0,0:56:04.40,0:56:06.73,JPN,,0,0,0,,Бүгін түнде дүкенде маған көмектесуіңізді сұраймын деп ойладым.
Dialogue: 0,0:56:06.73,0:56:07.85,JPN,,0,0,0,,Мен саған сенетінмін
Dialogue: 0,0:56:09.81,0:56:11.98,JPN,,0,0,0,,Мен мұны Сузуме-чанға беремін.
Dialogue: 0,0:56:12.52,0:56:13.52,JPN,,0,0,0,,Иә
Dialogue: 0,0:56:13.52,0:56:15.44,JPN,,0,0,0,,Ол одан да қашқан қызға ұқсайды.
Dialogue: 0,0:56:16.23,0:56:18.69,JPN,,0,0,0,,Руми-сан, саған көп рахмет.
Dialogue: 0,0:56:20.85,0:56:23.60,JPN,,0,0,0,,Ата-анаңызға дұрыстап хабарласыңыз.
Dialogue: 0,0:56:23.60,0:56:24.27,JPN,,0,0,0,,Иә
Dialogue: 0,0:56:24.81,0:56:25.48,JPN,,0,0,0,,Мен сәл ретсіз болсам да, әлі де батыр болуға ұмтылатын адаммын.
Dialogue: 0,0:56:25.48,0:56:27.48,JPN,,0,0,0,,Мен Тамаки-санды ұмытып кетіппін.
Dialogue: 0,0:56:28.10,0:56:29.40,JPN,,0,0,0,,55 пункт
Dialogue: 0,0:56:29.69,0:56:30.81,JPN,,0,0,0,,Сіз мені алып кетесіз бе?
Dialogue: 0,0:56:30.81,0:56:32.73,JPN,,0,0,0,,Сузуме-сан, сіз келесі рейске уақытында келесіз.
Dialogue: 0,0:56:32.98,0:56:34.85,JPN,,0,0,0,,Билет сатып алып, асығыңыз
Dialogue: 0,0:56:35.40,0:56:36.85,JPN,,0,0,0,,Сіз Шинкансенмен барасыз ба?
Dialogue: 0,0:56:36.85,0:56:37.98,JPN,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:56:37.98,0:56:39.73,JPN,,0,0,0,,Мен қазір Дайжиннің қайда екенін білемін.
Dialogue: 0,0:56:39.73,0:56:41.31,JPN,,0,0,0,,Бұл ең жылдам болар еді.
Dialogue: 0,0:56:41.77,0:56:42.98,JPN,,0,0,0,,Токиоға?
Dialogue: 0,0:56:42.98,0:56:44.65,JPN,,0,0,0,,Менің жинақтарым жойылды.
Dialogue: 0,0:56:44.98,0:56:46.64,JPN,,0,0,0,,Төлемді кейінірек жасаңыз.
Dialogue: 0,0:56:46.64,0:56:47.77,JPN,,0,0,0,,Университет студенті
Dialogue: 0,0:56:47.77,0:56:48.94,JPN,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:56:50.85,0:56:52.31,JPN,,0,0,0,,Сота-сан, қарашы.
Dialogue: 0,0:56:52.31,0:56:53.15,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:56:53.81,0:56:55.73,JPN,,0,0,0,,Шинкансен, ерте!
Dialogue: 0,0:56:55.98,0:56:57.15,JPN,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:56:57.15,0:56:58.31,JPN,,0,0,0,,Бұл тез.
Dialogue: 0,0:56:58.52,0:57:00.60,JPN,,0,0,0,,Жақында Атамиге келеді
Dialogue: 0,0:57:03.40,0:57:04.90,JPN,,0,0,0,,Сота-сан, мүмкін
Dialogue: 0,0:57:04.90,0:57:05.90,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:57:05.90,0:57:09.44,JPN,,0,0,0,,Фудзи тауын сағынған жоқпыз ба?
Dialogue: 0,0:57:09.44,0:57:10.06,JPN,,0,0,0,,Қараңыз
Dialogue: 0,0:57:10.48,0:57:13.02,JPN,,0,0,0,,Байқасаңыз, маған хабарлаңыз.
Dialogue: 0,0:57:13.73,0:57:14.56,JPN,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:57:14.94,0:57:16.35,JPN,,0,0,0,,Мен оны көргім келді
Dialogue: 0,0:57:16.90,0:57:18.06,JPN,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:57:18.65,0:57:21.56,JPN,,0,0,0,,Жақында соңғы аялдама - Токио.
Dialogue: 0,0:57:23.06,0:57:25.06,JPN,,0,0,0,,Жүргеніңіз үшін рахмет
Dialogue: 0,0:57:25.06,0:57:27.06,JPN,,0,0,0,,Токиоға, соңғы баратын жер Токиоға келді
Dialogue: 0,0:57:26.52,0:57:28.31,JPN,,0,0,0,,Сузуме-сан, ана жақта.
Dialogue: 0,0:57:29.02,0:57:29.65,JPN,,0,0,0,,Оң
Dialogue: 0,0:57:29.65,0:57:30.31,JPN,,0,0,0,,Солға
Dialogue: 0,0:57:30.65,0:57:31.44,JPN,,0,0,0,,Жоғарыда
Dialogue: 0,0:57:31.98,0:57:32.85,JPN,,0,0,0,,Пойыз сол жақта
Dialogue: 0,0:57:33.15,0:57:34.81,JPN,,0,0,0,,Мінейік, жүгірейік
Dialogue: 0,0:57:37.44,0:57:38.44,JPN,,0,0,0,,Түсіңіз
Dialogue: 0,0:57:43.15,0:57:45.44,JPN,,0,0,0,,Мені ат ретінде пайдаланғандай сезінемін.
Dialogue: 0,0:57:45.92,0:57:47.21,JPN,,0,0,0,,Дайжинді іздемес бұрын
Dialogue: 0,0:57:47.21,0:57:48.31,JPN,,0,0,0,,Менің барғым келетін жер бар
Dialogue: 0,0:57:49.27,0:57:50.77,JPN,,0,0,0,,Маған қоңырау шала аласыз ба?
Dialogue: 0,0:57:58.48,0:57:59.56,JPN,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:58:03.98,0:58:06.69,JPN,,0,0,0,,Ум, менің атым Ивато.
Dialogue: 0,0:58:07.60,0:58:09.27,JPN,,0,0,0,,Мен сізге ертерек қоңырау шалдым.
Dialogue: 0,0:58:11.13,0:58:11.98,JPN,,0,0,0,,Иә, иә
Dialogue: 0,0:58:11.98,0:58:13.77,JPN,,0,0,0,,Сіз Сота мырзаның туысысыз ба?
Dialogue: 0,0:58:13.77,0:58:15.44,JPN,,0,0,0,,Мен тыңдаймын.
Dialogue: 0,0:58:15.81,0:58:17.94,JPN,,0,0,0,,Иә, бұл сіздің бөлме кілті.
Dialogue: 0,0:58:18.40,0:58:20.65,JPN,,0,0,0,,Бұл 301-бөлме.
Dialogue: 0,0:58:20.65,0:58:22.02,JPN,,0,0,0,,Уақытыңызды алыңыз
Dialogue: 0,0:58:24.48,0:58:27.10,JPN,,0,0,0,,Сота-сан, сен танымалсың, солай емес пе?
Dialogue: 0,0:58:28.10,0:58:30.81,JPN,,0,0,0,,Ол сапардан қашан оралады?
Dialogue: 0,0:58:30.81,0:58:32.73,JPN,,0,0,0,,Сенсіз өзімді жалғыз сезінемін.
Dialogue: 0,0:58:32.73,0:58:34.52,JPN,,0,0,0,,Одан да тәтті және сүйкімді
Dialogue: 0,0:58:34.52,0:58:35.94,JPN,,0,0,0,,Ол әдемі, солай емес пе?
Dialogue: 0,0:58:36.73,0:58:38.10,JPN,,0,0,0,,Онша емес.
Dialogue: 0,0:58:41.81,0:58:42.69,JPN,,0,0,0,,Өтінемін
Dialogue: 0,0:58:44.44,0:58:45.65,JPN,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:58:54.10,0:58:55.69,JPN,,0,0,0,,Мен бір нәрсені білгім келеді.
Dialogue: 0,0:58:56.90,0:58:59.19,JPN,,0,0,0,,Сол кітап сөресінде картон қорап бар.
Dialogue: 0,0:58:59.65,0:59:00.73,JPN,,0,0,0,,Сіз оны ала аласыз ба?
Dialogue: 0,0:59:14.19,0:59:15.94,JPN,,0,0,0,,Сота-сан, мен сені бассам бола ма?
Dialogue: 0,0:59:15.94,0:59:17.44,JPN,,0,0,0,,Атқа мінер алдында сұраңыз
Dialogue: 0,0:59:27.69,0:59:30.94,JPN,,0,0,0,,Бұл жауын құрты болуы мүмкін бе?
Dialogue: 0,0:59:33.31,0:59:33.94,JPN,,0,0,0,,Иә
Dialogue: 0,0:59:34.60,0:59:36.19,JPN,,0,0,0,,Ал бұл негізгі тірек
Dialogue: 0,0:59:36.85,0:59:39.48,JPN,,0,0,0,,Батыс бағана және шығыс бағана
Dialogue: 0,0:59:39.94,0:59:41.10,JPN,,0,0,0,,Тірек тасы дегеніміз не?
Dialogue: 0,0:59:41.10,0:59:42.15,JPN,,0,0,0,,Екі бар.
Dialogue: 0,0:59:44.48,0:59:47.40,JPN,,0,0,0,,Артқы есікті жабу арқылы басуға болмайтын апаттар
Dialogue: 0,0:59:47.40,0:59:49.44,JPN,,0,0,0,,Адамдарды тірек тастармен жабуға болады.
Dialogue: 0,0:59:50.27,0:59:50.94,JPN,,0,0,0,,Сонымен
Dialogue: 0,0:59:50.94,0:59:52.85,JPN,,0,0,0,,Уақытқа байланысты орындар өзгереді
Dialogue: 0,0:59:55.69,0:59:57.40,JPN,,0,0,0,,Кюсюдегі негізгі тас болды
Dialogue: 0,0:59:57.40,0:59:59.60,JPN,,0,0,0,,Қазір ол Дайжин кейпінде қашып барады.
Dialogue: 0,1:00:00.35,1:00:02.44,JPN,,0,0,0,,Тағы бір негізгі тас осында
Dialogue: 0,1:00:02.44,1:00:03.48,JPN,,0,0,0,,Токиода орналасқан
Dialogue: 0,1:00:03.81,1:00:05.69,JPN,,0,0,0,,Әлі де жауын құртының басын төмен ұстау
Dialogue: 0,1:00:06.60,1:00:09.56,JPN,,0,0,0,,Менің білгім келетіні нақты орын.
Dialogue: 0,1:00:09.56,1:00:11.30,JPN,,0,0,0,,Токионың қай жерінде орналасқан?
Dialogue: 0,1:00:11.30,1:00:13.69,JPN,,0,0,0,,Бұл жерде үлкен артқы есік бар.
Dialogue: 0,1:00:14.40,1:00:16.10,JPN,,0,0,0,,Жүз жыл бұрын бір рет ашылған
Dialogue: 0,1:00:16.10,1:00:18.19,JPN,,0,0,0,,Канто аймағында үлкен апат болды
Dialogue: 0,1:00:18.65,1:00:22.69,JPN,,0,0,0,,Токиодағы артқы есікті сол кездегі жабу шеберлері жауып тастаған.
Dialogue: 0,1:00:23.56,1:00:24.44,JPN,,0,0,0,,Дайджин бұл
Dialogue: 0,1:00:24.44,1:00:27.40,JPN,,0,0,0,,Мүмкін сіз бұл есікті қайта ашқыңыз келетін шығар.
Dialogue: 0,1:00:34.19,1:00:35.15,JPN,,0,0,0,,Мүмкін емес
Dialogue: 0,1:00:35.56,1:00:37.94,JPN,,0,0,0,,Мұндай сипаттамалардың барлығы қара түсті.
Dialogue: 0,1:00:37.94,1:00:38.52,JPN,,0,0,0,,Мұндай сипаттамалардың барлығы қара түсті.
Dialogue: 0,1:00:38.81,1:00:40.94,JPN,,0,0,0,,Неліктен орналасқан жері құпия?
Dialogue: 0,1:00:41.27,1:00:43.06,JPN,,0,0,0,,Атадан сұраудан басқа амалым жоқ.
Dialogue: 0,1:00:43.48,1:00:44.48,JPN,,0,0,0,,Ата?
Dialogue: 0,1:00:44.48,1:00:46.15,JPN,,0,0,0,,Мені өсірген ол.
Dialogue: 0,1:00:46.15,1:00:47.94,JPN,,0,0,0,,Мен жақын жерде ауруханада жатырмын.
Dialogue: 0,1:00:48.40,1:00:50.65,JPN,,0,0,0,,Мен сенің көңіліңді қалдырғым келмеді.
Dialogue: 0,1:00:50.65,1:00:51.85,JPN,,0,0,0,,Осы сияқты
Dialogue: 0,1:00:54.10,1:00:56.02,JPN,,0,0,0,,Сота, сен сондасың ба?
Dialogue: 0,1:00:56.02,1:00:56.94,JPN,,0,0,0,,Міне, терезе ашық.
Dialogue: 0,1:00:56.94,1:00:58.23,JPN,,0,0,0,,Міне, терезе ашық.
Dialogue: 0,1:00:58.23,1:00:59.23,JPN,,0,0,0,,Бұл Серизава.
Dialogue: 0,1:00:59.23,1:01:00.65,JPN,,0,0,0,,Осындай кезде ұят
Dialogue: 0,1:01:00.65,1:01:01.81,JPN,,0,0,0,,Кім?
Dialogue: 0,1:01:01.81,1:01:03.94,JPN,,0,0,0,,Танысым, мені адастырып жібере аласыз ба?
Dialogue: 0,1:01:04.44,1:01:05.98,JPN,,0,0,0,,Сота, мен оны аша аламын ба?
Dialogue: 0,1:01:05.98,1:01:06.44,JPN,,0,0,0,,Мен оны ашамын, мен оны ашамын.
Dialogue: 0,1:01:06.44,1:01:07.65,JPN,,0,0,0,,Мен оны ашамын, мен оны ашамын.
Dialogue: 0,1:01:07.65,1:01:09.19,JPN,,0,0,0,,Ол жаман адам емес.
Dialogue: 0,1:01:11.44,1:01:12.69,JPN,,0,0,0,,Сәлем
Dialogue: 0,1:01:13.94,1:01:15.02,JPN,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:01:15.02,1:01:16.60,JPN,,0,0,0,,Әй, әпкем.
Dialogue: 0,1:01:16.60,1:01:18.02,JPN,,0,0,0,,Оның әпкесі болды ма?
Dialogue: 0,1:01:18.44,1:01:20.77,JPN,,0,0,0,,Біз апалы-сіңлілі ағайындармыз.
Dialogue: 0,1:01:21.40,1:01:23.19,JPN,,0,0,0,,Ум, Серизава-сан, солай ма?
Dialogue: 0,1:01:23.19,1:01:24.19,JPN,,0,0,0,,Ум, Серизава-сан, солай ма?
Dialogue: 0,1:01:26.52,1:01:27.94,JPN,,0,0,0,,Мұғалімнің жұмысқа орналасу емтиханы?
Dialogue: 0,1:01:28.27,1:01:30.69,JPN,,0,0,0,,Аа, кеше екінші емтихан болды.
Dialogue: 0,1:01:30.69,1:01:33.19,JPN,,0,0,0,,Ол өтетін жерге келмейді, бұл мүмкін емес.
Dialogue: 0,1:01:33.69,1:01:35.10,JPN,,0,0,0,,Кеше емтихан күні болды
Dialogue: 0,1:01:36.23,1:01:37.94,JPN,,0,0,0,,Бұл тым ақымақ, анау жігіт.
Dialogue: 0,1:01:38.23,1:01:40.44,JPN,,0,0,0,,Төрт жыл тынымсыз еңбектің құны жоқ па?
Dialogue: 0,1:01:40.85,1:01:41.69,JPN,,0,0,0,,Қызық
Dialogue: 0,1:01:41.69,1:01:44.02,JPN,,0,0,0,,Емтиханда тіпті мен жынды болдым.
Dialogue: 0,1:01:44.81,1:01:45.44,JPN,,0,0,0,,Кел, сен
Dialogue: 0,1:01:45.90,1:01:46.94,JPN,,0,0,0,,Бұл Торғай-чан ба?
Dialogue: 0,1:01:47.40,1:01:49.02,JPN,,0,0,0,,Сотамен бір рет хабарластым.
Dialogue: 0,1:01:49.02,1:01:51.73,JPN,,0,0,0,,Оған қайта бетін көрсетпеуін айт, себебі бұл тітіркендіреді.
Dialogue: 0,1:01:52.10,1:01:53.44,JPN,,0,0,0,,Ах, бірақ жиырма мың
Dialogue: 0,1:01:53.44,1:01:54.98,JPN,,0,0,0,,Мен сізге 20 000 иен қарызмын.
Dialogue: 0,1:01:54.98,1:01:56.81,JPN,,0,0,0,,Оны тез қайтарыңыз.
Dialogue: 0,1:01:56.81,1:02:00.19,JPN,,0,0,0,,Отбасылық кәсіп қиын деп естідім.
Dialogue: 0,1:02:00.56,1:02:03.02,JPN,,0,0,0,,Ол өзін жақсы ұстамайды.
Dialogue: 0,1:02:03.02,1:02:04.02,JPN,,0,0,0,,Мен ашуландым
Dialogue: 0,1:02:05.98,1:02:06.77,JPN,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,1:02:11.52,1:02:12.27,JPN,,0,0,0,,Ол шайқалады ма?
Dialogue: 0,1:02:13.69,1:02:14.77,JPN,,0,0,0,,Эй, эй
Dialogue: 0,1:02:15.73,1:02:16.60,JPN,,0,0,0,,тоқтатылды
Dialogue: 0,1:02:17.94,1:02:18.94,JPN,,0,0,0,,Амансың ба?
Dialogue: 0,1:02:20.98,1:02:21.94,JPN,,0,0,0,,Жабу
Dialogue: 0,1:02:26.35,1:02:27.85,JPN,,0,0,0,,Уау, ғажайып құс
Dialogue: 0,1:02:28.48,1:02:28.94,JPN,,0,0,0,,Кеттік
Dialogue: 0,1:02:30.77,1:02:31.65,JPN,,0,0,0,,Қазірге дейін қоғамдық үндеу жариялау қадамға бармауымыз керек пе?
Dialogue: 0,1:02:31.94,1:02:32.69,JPN,,0,0,0,,Сіз
Dialogue: 0,1:02:34.19,1:02:37.19,JPN,,0,0,0,,Мен Сота-санның емтиханы туралы білмедім.
Dialogue: 0,1:02:37.52,1:02:38.35,JPN,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,1:02:38.35,1:02:39.52,JPN,,0,0,0,,Бұл сіздің кінәңіз емес
Dialogue: 0,1:02:39.52,1:02:41.69,JPN,,0,0,0,,Себебі мен тіреуішті жұлып алдым.
Dialogue: 0,1:02:41.69,1:02:43.06,JPN,,0,0,0,,Бүгінгі сабақты аяқтаймыз
Dialogue: 0,1:02:43.06,1:02:44.81,JPN,,0,0,0,,Мысықты негізгі тасқа қайтарыңыз
Dialogue: 0,1:02:44.81,1:02:47.15,JPN,,0,0,0,,Мен бастапқы пішініме ораламын.
Dialogue: 0,1:02:50.02,1:02:50.90,JPN,,0,0,0,,А, қызық, бұл не?
Dialogue: 0,1:02:50.90,1:02:51.69,JPN,,0,0,0,,Уау, құс!
Dialogue: 0,1:02:52.10,1:02:53.52,JPN,,0,0,0,,Ғажайып құс
Dialogue: 0,1:02:58.27,1:03:00.10,JPN,,0,0,0,,Әй, артқы есік қайда?
Dialogue: 0,1:03:00.94,1:03:03.35,JPN,,0,0,0,,Алда, өзеннің төменгі ағысы?
Dialogue: 0,1:03:08.90,1:03:09.69,JPN,,0,0,0,,мысық
Dialogue: 0,1:03:12.10,1:03:12.94,JPN,,0,0,0,,Торғай
Dialogue: 0,1:03:13.60,1:03:14.48,JPN,,0,0,0,,Ойнайық
Dialogue: 0,1:03:14.48,1:03:15.19,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:03:15.56,1:03:16.19,JPN,,0,0,0,,Біраз
Dialogue: 0,1:03:18.35,1:03:19.06,JPN,,0,0,0,,Не?
Dialogue: 0,1:03:19.06,1:03:19.94,JPN,,0,0,0,,Жүгіретін орындық?
Dialogue: 0,1:03:32.56,1:03:33.19,JPN,,0,0,0,,Не?
Dialogue: 0,1:03:33.65,1:03:34.44,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:03:35.02,1:03:36.44,JPN,,0,0,0,,Негізгі тасқа оралу
Dialogue: 0,1:03:36.77,1:03:38.65,JPN,,0,0,0,,Менде енді жоқ.
Dialogue: 0,1:03:38.65,1:03:39.35,JPN,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,1:03:39.35,1:03:40.19,JPN,,0,0,0,,Неліктен?
Dialogue: 0,1:03:40.44,1:03:42.94,JPN,,0,0,0,,Сіз әлі түсінбедіңіз бе?
Dialogue: 0,1:03:46.73,1:03:47.56,JPN,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,1:03:49.15,1:03:49.73,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:04:00.52,1:04:01.94,JPN,,0,0,0,,Токионың артқы есігі қандай?
Dialogue: 0,1:04:02.65,1:04:03.94,JPN,,0,0,0,,Бұл артқа?
Dialogue: 0,1:04:04.23,1:04:06.19,JPN,,0,0,0,,Ол жерге қалай жетуге болады...
Dialogue: 0,1:04:26.60,1:04:27.60,JPN,,0,0,0,,Ол тоқтады ма?
Dialogue: 0,1:04:28.19,1:04:28.94,JPN,,0,0,0,,Жоқ
Dialogue: 0,1:04:39.65,1:04:40.52,JPN,,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,1:04:50.35,1:04:51.27,JPN,,0,0,0,,Жер сілкінісі
Dialogue: 0,1:04:51.77,1:04:52.85,JPN,,0,0,0,,Жер сілкінісі
Dialogue: 0,1:04:55.48,1:04:56.56,JPN,,0,0,0,,Дабыл тоқтады
Dialogue: 0,1:04:56.90,1:04:58.02,JPN,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,1:04:58.02,1:04:59.27,JPN,,0,0,0,,Мен шықтым
Dialogue: 0,1:05:00.10,1:05:01.85,JPN,,0,0,0,,Екінші тірек тасы
Dialogue: 0,1:05:07.23,1:05:08.44,JPN,,0,0,0,,Бүкіл дене шығады
Dialogue: 0,1:05:11.65,1:05:12.31,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:05:12.65,1:05:14.94,JPN,,0,0,0,,Күшті жер сілкінісінің алдын алу
Dialogue: 0,1:05:14.94,1:05:16.69,JPN,,0,0,0,,Сузуме-сан, мен барамын.
Dialogue: 0,1:05:18.31,1:05:19.19,JPN,,0,0,0,,Өтірік
Dialogue: 0,1:05:19.19,1:05:20.44,JPN,,0,0,0,,Сота-сан!
Dialogue: 0,1:05:30.85,1:05:31.60,JPN,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,1:05:33.73,1:05:34.71,JPN,,0,0,0,,Сузуме-сан!
Dialogue: 0,1:05:38.85,1:05:39.35,JPN,,0,0,0,,Не?
Dialogue: 0,1:05:39.35,1:05:39.81,JPN,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:05:39.81,1:05:40.35,JPN,,0,0,0,,Жаңа ғана не көрдіңіз?
Dialogue: 0,1:05:42.60,1:05:43.48,JPN,,0,0,0,,Бұл не?
Dialogue: 0,1:05:49.35,1:05:51.35,JPN,,0,0,0,,Сіз қаншалықты абайсыз?
Dialogue: 0,1:05:51.35,1:05:52.10,JPN,,0,0,0,,Өйткені
Dialogue: 0,1:05:54.35,1:05:55.44,JPN,,0,0,0,,Сузуме-сан!
Dialogue: 0,1:06:02.77,1:06:03.94,JPN,,0,0,0,,Қазір көмектесіңіз
Dialogue: 0,1:06:10.69,1:06:11.40,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:06:11.65,1:06:13.56,JPN,,0,0,0,,Құрттың беттері тұрақсыз
Dialogue: 0,1:06:13.56,1:06:14.65,JPN,,0,0,0,,Кетпеген жақсы
Dialogue: 0,1:06:15.44,1:06:15.90,JPN,,0,0,0,,Иә
Dialogue: 0,1:07:12.44,1:07:13.31,JPN,,0,0,0,,Жаңбыр құрттары
Dialogue: 0,1:07:14.15,1:07:15.81,JPN,,0,0,0,,Қаланы қамту
Dialogue: 0,1:07:20.44,1:07:21.35,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:07:22.23,1:07:24.44,JPN,,0,0,0,,Енді кілт тасын қағудан басқа амалым жоқ.
Dialogue: 0,1:07:24.44,1:07:25.31,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:07:25.31,1:07:26.56,JPN,,0,0,0,,Торғай
Dialogue: 0,1:07:28.23,1:07:30.06,JPN,,0,0,0,,Құрт құлады
Dialogue: 0,1:07:30.40,1:07:32.06,JPN,,0,0,0,,Жер сілкінісі болады
Dialogue: 0,1:07:32.31,1:07:33.31,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:07:36.48,1:07:37.44,JPN,,0,0,0,,Сота мырза?
Dialogue: 0,1:07:38.69,1:07:39.69,JPN,,0,0,0,,Не болды?
Dialogue: 0,1:07:40.94,1:07:42.56,JPN,,0,0,0,,Енді көп
Dialogue: 0,1:07:42.98,1:07:44.10,JPN,,0,0,0,,Адам өледі
Dialogue: 0,1:07:44.10,1:07:46.15,JPN,,0,0,0,,Неліктен бұлай етер едіңіз?
Dialogue: 0,1:07:46.15,1:07:47.65,JPN,,0,0,0,,Негізгі тасқа оралу.
Dialogue: 0,1:07:48.27,1:07:49.06,JPN,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,1:07:49.06,1:07:51.65,JPN,,0,0,0,,Дайцзин енді негізгі тас емес
Dialogue: 0,1:07:55.98,1:07:57.35,JPN,,0,0,0,,Сіз негізгі тассыз
Dialogue: 0,1:07:57.73,1:07:58.44,JPN,,0,0,0,,Бұл!
Dialogue: 0,1:08:03.40,1:08:04.69,JPN,,0,0,0,,Не істеуіміз керек, Сота-сан?
Dialogue: 0,1:08:05.44,1:08:06.40,JPN,,0,0,0,,Сота мырза?
Dialogue: 0,1:08:06.73,1:08:07.69,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,1:08:08.48,1:08:09.52,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,1:08:10.65,1:08:12.31,JPN,,0,0,0,,Ақыры түсіндім
Dialogue: 0,1:08:12.31,1:08:13.90,JPN,,0,0,0,,Мен оны осы уақытқа дейін байқамадым.
Dialogue: 0,1:08:14.27,1:08:15.73,JPN,,0,0,0,,Мен байқағым келмеді
Dialogue: 0,1:08:16.15,1:08:17.40,JPN,,0,0,0,,Эй, Сота-сан
Dialogue: 0,1:08:17.40,1:08:18.40,JPN,,0,0,0,,Дене...
Dialogue: 0,1:08:18.40,1:08:19.06,JPN,,0,0,0,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,1:08:19.06,1:08:20.40,JPN,,0,0,0,,Менің денем суық.
Dialogue: 0,1:08:21.23,1:08:24.19,JPN,,0,0,0,,Енді мен тірек болдым
Dialogue: 0,1:08:24.65,1:08:26.27,JPN,,0,0,0,,Орындыққа айналғанда
Dialogue: 0,1:08:26.69,1:08:29.65,JPN,,0,0,0,,Тірек тасы рөлі де маған берілді.
Dialogue: 0,1:08:30.81,1:08:32.15,JPN,,0,0,0,,Бұл...
Dialogue: 0,1:08:33.49,1:08:34.98,JPN,,0,0,0,,Бұл соңы ма?
Dialogue: 0,1:08:34.98,1:08:36.40,JPN,,0,0,0,,Осындай жерде
Dialogue: 0,1:08:36.98,1:08:37.94,JPN,,0,0,0,,Сота мырза?
Dialogue: 0,1:08:37.94,1:08:40.71,JPN,,0,0,0,,Бірақ мен сені кездестіргендіктен
Dialogue: 0,1:08:42.48,1:08:43.27,JPN,,0,0,0,,Сота мырза?
Dialogue: 0,1:08:44.23,1:08:45.23,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:08:45.23,1:08:46.48,JPN,,0,0,0,,Әй, Сота-сан!
Dialogue: 0,1:08:46.98,1:08:49.10,JPN,,0,0,0,,Сәлем, Сота-сан!
Dialogue: 0,1:08:50.52,1:08:52.23,JPN,,0,0,0,,Бұл енді Сота емес.
Dialogue: 0,1:08:52.52,1:08:53.31,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:08:53.73,1:08:54.48,JPN,,0,0,0,,Сіз!
Dialogue: 0,1:08:54.69,1:08:57.02,JPN,,0,0,0,,Кілт тасы жауын құрттарын шағып кетпей ме?
Dialogue: 0,1:08:57.60,1:08:58.48,JPN,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:08:58.73,1:09:00.98,JPN,,0,0,0,,Өйткені жауын құрттары түседі.
Dialogue: 0,1:09:01.23,1:09:02.52,JPN,,0,0,0,,Жер сілкінісі болады
Dialogue: 0,1:09:11.56,1:09:12.85,JPN,,0,0,0,,Құлай бастады
Dialogue: 0,1:09:13.15,1:09:13.98,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:09:13.98,1:09:15.52,JPN,,0,0,0,,Ояныңыз
Dialogue: 0,1:09:15.52,1:09:16.48,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:09:16.73,1:09:18.69,JPN,,0,0,0,,Ол енді Сота емес.
Dialogue: 0,1:09:19.60,1:09:21.23,JPN,,0,0,0,,Сота-сан, оян!
Dialogue: 0,1:09:21.60,1:09:23.56,JPN,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:09:23.94,1:09:25.98,JPN,,0,0,0,,Сота мырза, Сота мырза
Dialogue: 0,1:09:26.23,1:09:27.98,JPN,,0,0,0,,Көп адам өледі.
Dialogue: 0,1:09:28.98,1:09:30.73,JPN,,0,0,0,,қайталаймын.
Dialogue: 0,1:09:49.65,1:09:50.35,JPN,,0,0,0,,Маған ұнамайды
Dialogue: 0,1:09:51.56,1:09:52.94,JPN,,0,0,0,,Маған бұл енді ұнамайды
Dialogue: 0,1:09:53.69,1:09:55.02,JPN,,0,0,0,,Бұл не?
Dialogue: 0,1:10:16.90,1:10:17.52,JPN,,0,0,0,,Қараңызшы
Dialogue: 0,1:10:17.52,1:10:18.48,JPN,,0,0,0,,Уау!
Dialogue: 0,1:10:18.48,1:10:19.23,JPN,,0,0,0,,Аврораға ұқсайды
Dialogue: 0,1:10:19.23,1:10:20.52,JPN,,0,0,0,,Түнде кемпірқосақ?
Dialogue: 0,1:10:20.52,1:10:21.69,JPN,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,1:11:08.31,1:11:10.15,JPN,,0,0,0,,Анашым, сіз осындасыз ба?
Dialogue: 0,1:11:10.15,1:11:11.60,JPN,,0,0,0,,Әлі емес.
Dialogue: 0,1:11:20.02,1:11:21.19,JPN,,0,0,0,,Әлі емес пе?
Dialogue: 0,1:11:21.19,1:11:22.10,JPN,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,1:11:29.40,1:11:31.15,JPN,,0,0,0,,Әлі емес пе?
Dialogue: 0,1:11:31.15,1:11:32.44,JPN,,0,0,0,,Тағы да?
Dialogue: 0,1:11:35.23,1:11:36.85,JPN,,0,0,0,,Эй, әлі емес пе?
Dialogue: 0,1:11:36.85,1:11:38.44,JPN,,0,0,0,,(Нисимура) Цубасаның кеудесі өте үлкен, сондықтан ол жүгіргенде әр жаққа секіріп тұрады.
Dialogue: 0,1:11:40.85,1:11:42.44,JPN,,0,0,0,,Аяқталды
Dialogue: 0,1:11:42.69,1:11:44.98,JPN,,0,0,0,,Туған күніңмен, Сузуме
Dialogue: 0,1:11:46.65,1:11:49.60,JPN,,0,0,0,,Әй, мына баланың беті қайда?
Dialogue: 0,1:11:50.10,1:11:51.19,JPN,,0,0,0,,Бұл орындық.
Dialogue: 0,1:11:51.19,1:11:52.19,JPN,,0,0,0,,Сузумеге ерекше
Dialogue: 0,1:11:56.65,1:11:58.19,JPN,,0,0,0,,Иә, ше?
Dialogue: 0,1:12:02.06,1:12:04.19,JPN,,0,0,0,,Ол торғайға ұқсайды
Dialogue: 0,1:12:04.19,1:12:06.35,JPN,,0,0,0,,Рахмет, анашым
Dialogue: 0,1:12:07.73,1:12:10.65,JPN,,0,0,0,,Мен оны өмір бойы қастерлеймін.
Dialogue: 0,1:12:10.65,1:12:12.31,JPN,,0,0,0,,Өмір бойы?
Dialogue: 0,1:12:12.31,1:12:15.44,JPN,,0,0,0,,Бұл тұрды мама.
Dialogue: 0,1:12:17.35,1:12:19.10,JPN,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:12:19.52,1:12:21.19,JPN,,0,0,0,,Қанша уақыт болды?
Dialogue: 0,1:12:21.85,1:12:23.98,JPN,,0,0,0,,Сен оны жақсы ұстадың ба?
Dialogue: 0,1:12:33.73,1:12:34.73,JPN,,0,0,0,,Мұнда...
Dialogue: 0,1:12:37.69,1:12:38.52,JPN,,0,0,0,,Қайда?
Dialogue: 0,1:12:43.85,1:12:45.06,JPN,,0,0,0,,Сота мырза?
Dialogue: 0,1:12:54.77,1:12:55.81,JPN,,0,0,0,,Мұнда...
Dialogue: 0,1:12:58.94,1:13:00.19,JPN,,0,0,0,,Токионың артқы есігі
Dialogue: 0,1:13:11.35,1:13:12.56,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:13:25.35,1:13:26.31,JPN,,0,0,0,,Кірмеңіз
Dialogue: 0,1:13:27.44,1:13:28.98,JPN,,0,0,0,,Мен мәңгілік әлемдемін
Dialogue: 0,1:13:29.52,1:13:33.06,JPN,,0,0,0,,Сота мырза...
Dialogue: 0,1:13:33.35,1:13:34.60,JPN,,0,0,0,,Сота-сан!
Dialogue: 0,1:13:37.81,1:13:38.56,JPN,,0,0,0,,Торғай
Dialogue: 0,1:13:43.81,1:13:45.56,JPN,,0,0,0,,Ақыры екеуміз оңаша қалдық
Dialogue: 0,1:13:46.31,1:13:48.52,JPN,,0,0,0,,Дайджин, сен кінәлісің.
Dialogue: 0,1:13:48.52,1:13:49.90,JPN,,0,0,0,,Сота-санға оралу
Dialogue: 0,1:13:49.90,1:13:50.65,JPN,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,1:13:50.65,1:13:51.60,JPN,,0,0,0,,Неліктен?
Dialogue: 0,1:13:51.60,1:13:53.31,JPN,,0,0,0,,Мен енді адам емеспін
Dialogue: 0,1:13:56.02,1:13:57.77,JPN,,0,0,0,,Сота-санды қайтарыңыз.
Dialogue: 0,1:13:57.77,1:13:59.48,JPN,,0,0,0,,Маған торғай керек
Dialogue: 0,1:13:59.48,1:14:00.48,JPN,,0,0,0,,Қайтару
Dialogue: 0,1:14:00.48,1:14:02.27,JPN,,0,0,0,,Бәрінен де торғайлар
Dialogue: 0,1:14:02.27,1:14:03.27,JPN,,0,0,0,,Сіз?
Dialogue: 0,1:14:04.31,1:14:06.73,JPN,,0,0,0,,Саған Дайджин ұнамайды ма?
Dialogue: 0,1:14:07.56,1:14:08.35,JPN,,0,0,0,,Неліктен маған ұнайды?
Dialogue: 0,1:14:08.35,1:14:09.19,JPN,,0,0,0,,Маған ұнайды.
Dialogue: 0,1:14:09.19,1:14:10.23,JPN,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,1:14:20.44,1:14:21.56,JPN,,0,0,0,,Кетіңіз
Dialogue: 0,1:14:22.81,1:14:24.81,JPN,,0,0,0,,Менімен енді сөйлеспе
Dialogue: 0,1:14:25.77,1:14:28.77,JPN,,0,0,0,,Торғай маған ұнамады.
Dialogue: 0,1:14:43.48,1:14:45.40,JPN,,0,0,0,,Мен сізге міндетті түрде көмектесемін.
Dialogue: 0,1:14:46.81,1:14:48.10,JPN,,0,0,0,,Мен саған өтемін.
Dialogue: 0,1:15:30.73,1:15:32.52,JPN,,0,0,0,,Әй, мына балаға қарашы.
Dialogue: 0,1:15:32.81,1:15:34.02,JPN,,0,0,0,,Мен аяқ киім кимеймін.
Dialogue: 0,1:15:34.94,1:15:35.52,JPN,,0,0,0,,Бұл рас
Dialogue: 0,1:15:35.52,1:15:36.27,JPN,,0,0,0,,Мен сәл ретсіз болсам да, әлі де батыр болуға ұмтылатын адаммын.
Dialogue: 0,1:15:42.60,1:15:44.94,JPN,,0,0,0,,Киімі жыртылған қыз
Dialogue: 0,1:15:44.94,1:15:45.90,JPN,,0,0,0,,Жалаң аяқ емессің бе?
Dialogue: 0,1:15:45.90,1:15:46.77,JPN,,0,0,0,,Шынайы ма?
Dialogue: 0,1:15:49.02,1:15:51.23,JPN,,0,0,0,,Сен көп тынышталды, Мунаката-сан.
Dialogue: 0,1:15:51.23,1:15:53.27,JPN,,0,0,0,,Иә, кеше сәл дөрекі болды.
Dialogue: 0,1:15:54.90,1:15:56.02,JPN,,0,0,0,,Мунаката…
Dialogue: 0,1:16:09.27,1:16:12.52,JPN,,0,0,0,,Сота қателесті.
Dialogue: 0,1:16:12.52,1:16:13.77,JPN,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,1:16:13.77,1:16:18.27,JPN,,0,0,0,,Мм, мен Сота-саннан атаңның ауруханаға түскенін естідім.
Dialogue: 0,1:16:21.90,1:16:24.77,JPN,,0,0,0,,Сіз қатысасыз ба?
Dialogue: 0,1:16:25.56,1:16:28.06,JPN,,0,0,0,,Менің немерем не болды?
Dialogue: 0,1:16:29.90,1:16:32.27,JPN,,0,0,0,,Бекіткіш болып, мәңгілік өмір сүр
Dialogue: 0,1:16:33.06,1:16:34.27,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,1:16:35.52,1:16:39.27,JPN,,0,0,0,,Мен кеше осы терезеден жауын құрттарын көрдім.
Dialogue: 0,1:16:39.90,1:16:42.27,JPN,,0,0,0,,Мен де асыққым келді, бірақ
Dialogue: 0,1:16:42.73,1:16:47.02,JPN,,0,0,0,,Мен бұл дененің маған айтқанын тыңдамай тұра алмаймын.
Dialogue: 0,1:16:47.02,1:16:49.02,JPN,,0,0,0,,Мм, сондықтан мен мәңгілік әлемге қалай кіру керектігін білгім келеді.
Dialogue: 0,1:16:49.02,1:16:50.90,JPN,,0,0,0,,Мм, сондықтан мен мәңгілік әлемге қалай кіру керектігін білгім келеді.
Dialogue: 0,1:16:53.52,1:16:54.52,JPN,,0,0,0,,Неліктен?
Dialogue: 0,1:16:55.44,1:16:57.19,JPN,,0,0,0,,Себебі мен Сота-санға көмектесуім керек.
Dialogue: 0,1:16:57.19,1:16:58.94,JPN,,0,0,0,,It's an unnecessary intervention.
Dialogue: 0,1:17:00.10,1:17:03.60,JPN,,0,0,0,,Sota will spend decades from now on
Dialogue: 0,1:17:03.60,1:17:07.02,JPN,,0,0,0,,Тәңір тұратын негізгі тасқа айналу
Dialogue: 0,1:17:07.35,1:17:10.77,JPN,,0,0,0,,Ол енді бұл дүниеде бізге жетпейді.
Dialogue: 0,1:17:11.02,1:17:12.31,JPN,,0,0,0,,Бұл...
Dialogue: 0,1:17:12.31,1:17:13.52,JPN,,0,0,0,,Бірақ бір жолы бар...
Dialogue: 0,1:17:13.52,1:17:14.52,JPN,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,1:17:15.10,1:17:17.90,JPN,,0,0,0,,Немереңіздің сезімін өшіргіңіз келе ме?
Dialogue: 0,1:17:18.52,1:17:21.15,JPN,,0,0,0,,Кілт тасты кім пышақтады?
Dialogue: 0,1:17:21.48,1:17:22.35,JPN,,0,0,0,,Ум
Dialogue: 0,1:17:21.60,1:17:24.06,JPN,,0,0,0,,Сотаны пышақтап алдың ба?
Dialogue: 0,1:17:24.35,1:17:25.35,JPN,,0,0,0,,Бірақ...
Dialogue: 0,1:17:24.77,1:17:26.02,JPN,,0,0,0,,Жауап!
Dialogue: 0,1:17:26.02,1:17:27.02,JPN,,0,0,0,,Бұл менмін!
Dialogue: 0,1:17:27.40,1:17:28.81,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,1:17:28.81,1:17:30.52,JPN,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:17:30.52,1:17:33.94,JPN,,0,0,0,,Мен сені пышақтап тастамағанда миллион адам өлетін еді.
Dialogue: 0,1:17:33.94,1:17:36.81,JPN,,0,0,0,,Оны мақтан тұт, аузыңды жап
Dialogue: 0,1:17:37.10,1:17:39.27,JPN,,0,0,0,,Келген әлемге оралу
Dialogue: 0,1:17:45.27,1:17:49.31,JPN,,0,0,0,,Бұл қарапайым адамдар араласа алмайтын нәрсе емес.
Dialogue: 0,1:17:49.77,1:17:52.27,JPN,,0,0,0,,Барлығын ұмыт
Dialogue: 0,1:17:53.52,1:17:55.02,JPN,,0,0,0,,Can't be forgotten
Dialogue: 0,1:17:55.40,1:17:58.40,JPN,,0,0,0,,Мен жертөленің артқы есігін қайтадан ашамын.
Dialogue: 0,1:17:58.40,1:17:59.27,JPN,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,1:17:59.27,1:18:00.44,JPN,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,1:18:00.73,1:18:02.40,JPN,,0,0,0,,Қандай да бір жолмен ішке кіріңіз
Dialogue: 0,1:18:02.40,1:18:05.15,JPN,,0,0,0,,Жоқ, мен ол жерден кіре алмаймын.
Dialogue: 0,1:18:05.15,1:18:07.35,JPN,,0,0,0,,Артқы есікті ашпаңыз
Dialogue: 0,1:18:07.35,1:18:08.06,JPN,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:18:20.52,1:18:23.10,JPN,,0,0,0,,Мәңгілік өмір әдемі, бірақ
Dialogue: 0,1:18:23.10,1:18:24.52,JPN,,0,0,0,,Өлгендердің орны
Dialogue: 0,1:18:25.35,1:18:27.52,JPN,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,1:18:28.69,1:18:30.27,JPN,,0,0,0,,Қорқатын ештеңе жоқ
Dialogue: 0,1:18:30.27,1:18:33.27,JPN,,0,0,0,,Өмір сүресің бе, өлесің бе, бұл тек сәттілік.
Dialogue: 0,1:18:33.27,1:18:35.02,JPN,,0,0,0,,Мен кішкентай кезімнен осылай ойлайтынмын.
Dialogue: 0,1:18:35.35,1:18:36.27,JPN,,0,0,0,,Бірақ
Dialogue: 0,1:18:37.02,1:18:38.65,JPN,,0,0,0,,Сотасыз әлем
Dialogue: 0,1:18:38.65,1:18:40.02,JPN,,0,0,0,,Мен қорқамын
Dialogue: 0,1:18:49.02,1:18:53.81,JPN,,0,0,0,,Адам өмірінде бір ғана артқы есіктен тығыла алады.
Dialogue: 0,1:18:54.56,1:18:57.27,JPN,,0,0,0,,Мәңгілік дүниені көрдің ғой, солай ма?
Dialogue: 0,1:18:57.69,1:18:59.94,JPN,,0,0,0,,Онда не көрдің?
Dialogue: 0,1:19:00.65,1:19:04.10,JPN,,0,0,0,,Кішкентай кезімде бұл мен болдым.
Dialogue: 0,1:19:04.60,1:19:05.77,JPN,,0,0,0,,Өлді деген ана
Dialogue: 0,1:19:05.77,1:19:07.35,JPN,,0,0,0,,Өлді деген ана
Dialogue: 0,1:19:08.02,1:19:14.27,JPN,,0,0,0,,Мәңгілік әлемге жас кезіңізде адасып кеткен боларсыз.
Dialogue: 0,1:19:20.48,1:19:21.81,JPN,,0,0,0,,Сол уақыттағы артқы есікті табыңыз.
Dialogue: 0,1:19:21.81,1:19:24.52,JPN,,0,0,0,,Сол уақыттағы артқы есікті табыңыз.
Dialogue: 0,1:19:35.27,1:19:37.52,JPN,,0,0,0,,Ұзақ уақыт үшін рахмет.
Dialogue: 0,1:19:38.27,1:19:41.52,JPN,,0,0,0,,Сіз мұны ақырында жеңдіңіз бе?
Dialogue: 0,1:19:43.98,1:19:46.60,JPN,,0,0,0,,Сол баланың соңынан ересің бе?
Dialogue: 0,1:19:47.48,1:19:50.02,JPN,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,1:20:29.23,1:20:30.81,JPN,,0,0,0,,Мен сенің аяқ киіміңді қарызға аламын.
Dialogue: 0,1:20:30.81,1:20:31.69,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:20:45.65,1:20:47.77,JPN,,0,0,0,,Эй, эй!
Dialogue: 0,1:20:47.77,1:20:49.85,JPN,,0,0,0,,Сен, Сузуме-чан
Dialogue: 0,1:20:51.73,1:20:53.02,JPN,,0,0,0,,Серизава мырза?
Dialogue: 0,1:20:53.44,1:20:54.48,JPN,,0,0,0,,Қайда барасың?
Dialogue: 0,1:20:55.02,1:20:56.19,JPN,,0,0,0,,Сотаның орнында ма?
Dialogue: 0,1:20:57.27,1:20:58.73,JPN,,0,0,0,,Барыңыз, есікті іздеңіз
Dialogue: 0,1:20:59.69,1:21:01.19,JPN,,0,0,0,,Кешіріңіз, мен асығып тұрмын.
Dialogue: 0,1:21:01.19,1:21:03.31,JPN,,0,0,0,,Эй, сен қанша уақыт іздеп жүрсің?
Dialogue: 0,1:21:03.31,1:21:03.85,JPN,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:21:03.85,1:21:05.35,JPN,,0,0,0,,Екеуінің құда екені өтірік.
Dialogue: 0,1:21:05.35,1:21:06.23,JPN,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,1:21:06.65,1:21:07.48,JPN,,0,0,0,,Бортқа отырыңыз
Dialogue: 0,1:21:07.81,1:21:09.19,JPN,,0,0,0,,Сотаның орнына барасың, солай ма?
Dialogue: 0,1:21:09.19,1:21:10.85,JPN,,0,0,0,,Мен сені кез келген жерге апарамын.
Dialogue: 0,1:21:11.52,1:21:11.98,JPN,,0,0,0,,Неге сен?
Dialogue: 0,1:21:11.98,1:21:12.65,JPN,,0,0,0,,Неге сен?
Dialogue: 0,1:21:12.65,1:21:13.48,JPN,,0,0,0,,Достарымды уайымдау дұрыс емес пе?
Dialogue: 0,1:21:13.48,1:21:14.73,JPN,,0,0,0,,Достарыңды уайымдау дұрыс емес пе?
Dialogue: 0,1:21:15.10,1:21:15.85,JPN,,0,0,0,,Бұл не?
Dialogue: 0,1:21:15.85,1:21:16.60,JPN,,0,0,0,,Ұрыс?
Dialogue: 0,1:21:16.60,1:21:17.46,JPN,,0,0,0,,болды
Dialogue: 0,1:21:17.46,1:21:18.56,JPN,,0,0,0,,Сузуме
Dialogue: 0,1:21:19.94,1:21:20.77,JPN,,0,0,0,,Тамаки мырза?
Dialogue: 0,1:21:20.77,1:21:21.98,JPN,？？,0,0,0,,Жақсы
Dialogue: 0,1:21:21.98,1:21:23.81,JPN,？？,0,0,0,,Мен сені іздедім бе?
Dialogue: 0,1:21:24.06,1:21:26.31,JPN,,0,0,0,,Сен, Конкоға жақындама.
Dialogue: 0,1:21:26.31,1:21:27.56,JPN,,0,0,0,,Мен полиция шақырамын.
Dialogue: 0,1:21:27.56,1:21:28.31,JPN,,0,0,0,,Е, кім?
Dialogue: 0,1:21:28.56,1:21:30.27,JPN,,0,0,0,,Мына жігіт менің үйіме келді ме?
Dialogue: 0,1:21:30.27,1:21:32.31,JPN,,0,0,0,,Сіз аздап алданып қалдыңыз.
Dialogue: 0,1:21:32.31,1:21:33.10,JPN,,0,0,0,,Үйге қайтайық.
Dialogue: 0,1:21:33.81,1:21:34.77,JPN,,0,0,0,,Кешіріңіз, Тамаки-сан.
Dialogue: 0,1:21:34.48,1:21:35.31,JPN,,0,0,0,,Біраз
Dialogue: 0,1:21:34.77,1:21:35.73,JPN,,0,0,0,,Мен үйге бара алмаймын
Dialogue: 0,1:21:35.48,1:21:36.35,JPN,,0,0,0,,Сузуме
Dialogue: 0,1:21:37.10,1:21:38.44,JPN,,0,0,0,,Серизава мырза, мені шығарыңыз.
Dialogue: 0,1:21:42.94,1:21:43.65,JPN,,0,0,0,,Сузуме
Dialogue: 0,1:21:43.65,1:21:45.20,JPN,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:21:45.20,1:21:46.81,JPN,,0,0,0,,Сіз жалғыз өмір сүре алмайсыз.
Dialogue: 0,1:21:45.81,1:21:47.31,JPN,,0,0,0,,Бұл тек қана достық теннис матчы.
Dialogue: 0,1:21:46.81,1:21:47.94,JPN,,0,0,0,,Эй, Тамаки-сан, түс.
Dialogue: 0,1:21:47.94,1:21:49.06,JPN,,0,0,0,,Сузуме, жүр.
Dialogue: 0,1:21:47.94,1:21:50.90,JPN,,0,0,0,,Балалар, есіктен көлікке отырыңдар.
Dialogue: 0,1:21:49.06,1:21:50.01,JPN,,0,0,0,,Маған ұнамайды
Dialogue: 0,1:21:51.15,1:21:52.48,JPN,,0,0,0,,Бұл махаббат үшбұрышы.
Dialogue: 0,1:21:52.48,1:21:53.56,JPN,,0,0,0,,Адам, ең төменгі
Dialogue: 0,1:21:53.90,1:21:55.52,JPN,,0,0,0,,Мұның бәрі оқуға қатысты.
Dialogue: 0,1:21:54.71,1:21:55.52,JPN,,0,0,0,,Тынышталыңыз
Dialogue: 0,1:21:55.98,1:21:56.56,JPN,,0,0,0,,Өте шулы
Dialogue: 0,1:21:56.56,1:21:57.60,JPN,,0,0,0,,Бұл тым қатты
Dialogue: 0,1:22:00.65,1:22:01.31,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:22:01.31,1:22:02.90,JPN,,0,0,0,,Мысық сөйледі ме?
Dialogue: 0,1:22:01.31,1:22:02.90,JPN,,0,0,0,,Мысық сөйледі ме?
Dialogue: 0,1:22:03.21,1:22:04.31,JPN,,0,0,0,,Сөйлесуге мүмкіндік жоқ.
Dialogue: 0,1:22:04.90,1:22:06.60,JPN,,0,0,0,,О, дұрыс.
Dialogue: 0,1:22:04.90,1:22:06.60,JPN,,0,0,0,,О, дұрыс.
Dialogue: 0,1:22:07.94,1:22:09.44,JPN,,0,0,0,,Мысықтар сөйлемейді.
Dialogue: 0,1:22:09.44,1:22:10.06,JPN,,0,0,0,,Одан да көп
Dialogue: 0,1:22:10.06,1:22:10.81,JPN,,0,0,0,,Одан да көп
Dialogue: 0,1:22:11.44,1:22:13.60,JPN,,0,0,0,,Баратын жер жинағы
Dialogue: 0,1:22:11.90,1:22:12.90,JPN,,0,0,0,,Серизава мырза
Dialogue: 0,1:22:12.90,1:22:14.77,JPN,,0,0,0,,Олай болса, осы жерге өтіңіз.
Dialogue: 0,1:22:15.75,1:22:16.31,JPN,,0,0,0,,Алыста
Dialogue: 0,1:22:16.85,1:22:18.23,JPN,,0,0,0,,Сіз, бұл жер...
Dialogue: 0,1:22:18.23,1:22:20.56,JPN,,0,0,0,,Сіз мені кез келген жерге апара аласыз дедіңіз.
Dialogue: 0,1:22:21.27,1:22:22.02,JPN,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,1:22:22.02,1:22:23.40,JPN,,0,0,0,,Менің кетуім керек.
Dialogue: 0,1:22:28.98,1:22:30.06,JPN,,0,0,0,,Шынайы ма?
Dialogue: 0,1:22:30.94,1:22:33.06,JPN,,0,0,0,,Жарайды, мен бүгін үйге бара алмаймын.
Dialogue: 0,1:22:37.90,1:22:40.02,JPN,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:23:14.15,1:23:15.77,JPN,,0,0,0,,Ән тым қатты
Dialogue: 0,1:23:16.81,1:23:18.56,JPN,,0,0,0,,Бұл сіздің саяхатыңызды бастайтын ән.
Dialogue: 0,1:23:18.69,1:23:20.02,JPN,,0,0,0,,Жабайы мысықтар да бар.
Dialogue: 0,1:23:20.60,1:23:22.56,JPN,,0,0,0,,Сузуме сондай сүйкімді
Dialogue: 0,1:23:22.81,1:23:23.94,JPN,,0,0,0,,Әрқашан ұйықтау
Dialogue: 0,1:23:25.06,1:23:26.06,JPN,,0,0,0,,Бұл мысық Сузуменің мысығы ма?
Dialogue: 0,1:23:26.06,1:23:27.31,JPN,,0,0,0,,Бұл мысық Сузуменің мысығы ма?
Dialogue: 0,1:23:27.56,1:23:29.44,JPN,,0,0,0,,Бізде мысықтар жоқ.
Dialogue: 0,1:23:29.98,1:23:31.31,JPN,,0,0,0,,Серизава-кун...
Dialogue: 0,1:23:31.65,1:23:33.02,JPN,,0,0,0,,Білім беру факультеті?
Dialogue: 0,1:23:33.44,1:23:35.81,JPN,,0,0,0,,Ал, мен мұғалім болғым келеді.
Dialogue: 0,1:23:38.35,1:23:40.02,JPN,,0,0,0,,Бұл ескі көлік.
Dialogue: 0,1:23:40.02,1:23:42.48,JPN,,0,0,0,,Бұл пайдаланылған және өте арзан.
Dialogue: 0,1:23:42.48,1:23:43.56,JPN,,0,0,0,,Керемет емес пе?
Dialogue: 0,1:23:43.94,1:23:46.19,JPN,,0,0,0,,Сіз шынымен бақыттысыз ба?
Dialogue: 0,1:23:46.19,1:23:48.56,JPN,,0,0,0,,Бір жаққа 7 сағаттан астам уақыт кетеді.
Dialogue: 0,1:23:48.90,1:23:50.35,JPN,,0,0,0,,Сота іздеп жатыр
Dialogue: 0,1:23:50.35,1:23:51.81,JPN,,0,0,0,,Бұл менің қызым ғана емес.
Dialogue: 0,1:23:52.81,1:23:54.31,JPN,,0,0,0,,Қызым және емес
Dialogue: 0,1:23:54.81,1:23:56.81,JPN,,0,0,0,,Сузуме менің жиенім.
Dialogue: 0,1:23:57.44,1:23:59.81,JPN,,0,0,0,,Әпкем қайтыс болды, мен оны қабылдадым.
Dialogue: 0,1:23:59.81,1:24:02.06,JPN,,0,0,0,,Өйткені Конко екеуміз толық емес отбасы болдық.
Dialogue: 0,1:24:02.06,1:24:02.81,JPN,,0,0,0,,Не?
Dialogue: 0,1:24:03.19,1:24:05.90,JPN,,0,0,0,,Ол кезде Сузуме небәрі төрт жаста еді.
Dialogue: 0,1:24:06.48,1:24:09.69,JPN,,0,0,0,,Кенет өмірден озған анамды түсіне алмадым.
Dialogue: 0,1:24:09.69,1:24:11.10,JPN,,0,0,0,,Әлі іздеуде
Dialogue: 0,1:24:11.10,1:24:12.69,JPN,,0,0,0,,Сіз жоғалып кеткен кезіңіз болды ма?
Dialogue: 0,1:24:12.69,1:24:13.98,JPN,,0,0,0,,Сузуме!
Dialogue: 0,1:24:13.98,1:24:15.81,JPN,,0,0,0,,Сузуме қайда орналасқан?
Dialogue: 0,1:24:16.40,1:24:18.15,JPN,,0,0,0,,Сузуме!
Dialogue: 0,1:24:21.56,1:24:22.35,JPN,,0,0,0,,Апай?
Dialogue: 0,1:24:22.35,1:24:24.02,JPN,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:24:24.02,1:24:26.81,JPN,,0,0,0,,Кешіріңіз, мен сізді алып кетуге кешігіп қалдым.
Dialogue: 0,1:24:27.65,1:24:28.31,JPN,,0,0,0,,Сузуме, менің балам бол.
Dialogue: 0,1:24:28.31,1:24:30.81,JPN,,0,0,0,,Сузуме, менің балам бол.
Dialogue: 0,1:24:33.27,1:24:35.19,JPN,,0,0,0,,Содан бері 12 жыл
Dialogue: 0,1:24:35.52,1:24:36.85,JPN,,0,0,0,,Мені Кюсюге апарыңыз
Dialogue: 0,1:24:36.85,1:24:38.85,JPN,,0,0,0,,Біз мәңгі бірге өмір сүрсек те
Dialogue: 0,1:24:44.48,1:24:45.56,JPN,,0,0,0,,Сіз темекіні ұнатасыз ба?
Dialogue: 0,1:24:46.02,1:24:48.52,JPN,,0,0,0,,Бұл сіздің көлігіңіз.
Dialogue: 0,1:24:49.06,1:24:51.90,JPN,,0,0,0,,Ал, мен қазір Сузуменің туған қаласына қайтамын.
Dialogue: 0,1:24:52.15,1:24:54.10,JPN,,0,0,0,,Сота бар ма деп ойлаймын.
Dialogue: 0,1:24:54.10,1:24:55.19,JPN,,0,0,0,,Келіңіздер
Dialogue: 0,1:24:55.19,1:24:58.06,JPN,,0,0,0,,Бірақ енді ештеңе жоқ.
Dialogue: 0,1:24:58.56,1:25:01.06,JPN,,0,0,0,,Токиоға қазір қайтып келер ме едіңіз?
Dialogue: 0,1:25:01.52,1:25:03.65,JPN,,0,0,0,,Сонда бұл бала да бас тартуы мүмкін.
Dialogue: 0,1:25:03.65,1:25:04.31,JPN,,0,0,0,,Жоқ, мен Сотаға қарызым 20 000 иенді жинауым керек.
Dialogue: 0,1:25:04.31,1:25:06.90,JPN,,0,0,0,,Жоқ, мен Сотаға қарызым 20 000 иенді жинауым керек.
Dialogue: 0,1:25:08.31,1:25:11.10,JPN,,0,0,0,,Сіз қарызды өндіріп алушысыз.
Dialogue: 0,1:25:42.15,1:25:44.19,JPN,,0,0,0,,Жаңа ғана дірілдеп қалмады ма?
Dialogue: 0,1:25:44.19,1:25:45.98,JPN,,0,0,0,,Ах, мен ақыры ояндым.
Dialogue: 0,1:25:46.40,1:25:48.06,JPN,,0,0,0,,Қазір апам ұйықтап жатыр.
Dialogue: 0,1:25:48.40,1:25:50.31,JPN,,0,0,0,,Бәрімізге ұйқы жетіспейді.
Dialogue: 0,1:25:52.40,1:25:54.19,JPN,,0,0,0,,Бұл рас, жүгіріп келе жатқаныңды айта алмайсың.
Dialogue: 0,1:25:54.19,1:25:54.81,JPN,,0,0,0,,Тоқта
Dialogue: 0,1:26:00.85,1:26:02.52,JPN,,0,0,0,,Эй, эй
Dialogue: 0,1:26:02.52,1:26:03.40,JPN,,0,0,0,,Сузуме-чан
Dialogue: 0,1:26:24.48,1:26:25.40,JPN,,0,0,0,,көрсетілмейді
Dialogue: 0,1:26:26.56,1:26:28.35,JPN,,0,0,0,,Сота-сан оны ұстап тұр.
Dialogue: 0,1:26:30.85,1:26:31.44,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:26:32.31,1:26:34.15,JPN,,0,0,0,,Не істегің келеді?
Dialogue: 0,1:26:35.23,1:26:36.44,JPN,,0,0,0,,Неге сөйлемейсің?
Dialogue: 0,1:26:37.52,1:26:41.40,JPN,,0,0,0,,Ей, тірек тасы жабу шебері болуы шарт емес.
Dialogue: 0,1:26:42.23,1:26:43.40,JPN,,0,0,0,,Сіз кез келген адам бола аласыз ба?
Dialogue: 0,1:26:45.85,1:26:47.02,JPN,,0,0,0,,Сузуме-чан
Dialogue: 0,1:26:49.85,1:26:51.60,JPN,,0,0,0,,Не болды, жақсысың ба?
Dialogue: 0,1:26:51.60,1:26:53.40,JPN,,0,0,0,,Кешіріңіз, бұл ештеңе емес.
Dialogue: 0,1:26:54.02,1:26:54.90,JPN,,0,0,0,,Бізге асығу керек
Dialogue: 0,1:26:58.06,1:27:00.27,JPN,,0,0,0,,Қызық, жартысы келді ме?
Dialogue: 0,1:27:15.31,1:27:18.52,JPN,,0,0,0,,Бұл жер сондай әдемі жер еді.
Dialogue: 0,1:27:19.77,1:27:21.81,JPN,,0,0,0,,Бұл жер... таза ма?
Dialogue: 0,1:27:28.15,1:27:28.81,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,1:27:29.23,1:27:30.23,JPN,,0,0,0,,Мен тез кетуім керек
Dialogue: 0,1:27:39.31,1:27:40.65,JPN,,0,0,0,,Эй, эй
Dialogue: 0,1:27:41.10,1:27:42.27,JPN,,0,0,0,,Мысық, досым
Dialogue: 0,1:27:43.56,1:27:46.65,JPN,,0,0,0,,Олар терең қараңғы отбасы сияқты.
Dialogue: 0,1:28:21.10,1:28:21.73,JPN,,0,0,0,,Жаңбыр?
Dialogue: 0,1:28:22.19,1:28:23.90,JPN,,0,0,0,,Жоқ, рас па?
Dialogue: 0,1:28:23.90,1:28:25.06,JPN,,0,0,0,,Бұл жаман.
Dialogue: 0,1:28:25.77,1:28:27.81,JPN,,0,0,0,,Не? Шатыр бар!
Dialogue: 0,1:28:27.81,1:28:29.02,JPN,,0,0,0,,Ерте жабу.
Dialogue: 0,1:28:30.23,1:28:31.73,JPN,,0,0,0,,Сіз оны қолданып көргіңіз келе ме?
Dialogue: 0,1:28:49.81,1:28:50.65,JPN,,0,0,0,,Бір сәт?
Dialogue: 0,1:28:51.27,1:28:53.23,JPN,,0,0,0,,Бұл реттелмеген.
Dialogue: 0,1:28:53.81,1:28:56.40,JPN,,0,0,0,,Хаха, мен не істеуім керек?
Dialogue: 0,1:28:56.40,1:28:59.48,JPN,,0,0,0,,Жарайды, келесі демалыс аялдамасы жақын арада болады.
Dialogue: 0,1:28:59.65,1:29:02.04,JPN,,0,0,0,,Жол бойындағы станцияға дейін шамамен 40 км
Dialogue: 0,1:29:02.04,1:29:03.06,JPN,,0,0,0,,35 минут
Dialogue: 0,1:29:03.06,1:29:04.48,JPN,,0,0,0,,Бұл мүлдем жақын емес.
Dialogue: 0,1:29:10.60,1:29:11.73,JPN,,0,0,0,,Itadadakimasu
Dialogue: 0,1:29:15.78,1:29:17.94,JPN,,0,0,0,,Сіз хостпен біргесіз бе?
Dialogue: 0,1:29:17.94,1:29:21.65,JPN,,0,0,0,,Жоқ, ол кедей үй иесі сияқты.
Dialogue: 0,1:29:22.06,1:29:24.56,JPN,,0,0,0,,Сіз мені алдамақшы сияқтысыз.
Dialogue: 0,1:29:24.98,1:29:26.81,JPN,,0,0,0,,Жоқ, бұл қауіпті.
Dialogue: 0,1:29:27.19,1:29:28.69,JPN,,0,0,0,,Тек екі күшсіз әйел
Dialogue: 0,1:29:29.15,1:29:30.56,JPN,,0,0,0,,Автокөлік жабық бөлме.
Dialogue: 0,1:29:30.56,1:29:32.15,JPN,,0,0,0,,Жоқ, айырбасталатын көлікте
Dialogue: 0,1:29:32.65,1:29:33.56,JPN,,0,0,0,,Наоикен
Dialogue: 0,1:29:33.81,1:29:35.81,JPN,,0,0,0,,Тамаки мырза, сіз қазір Миягиде қай жердесіз?
Dialogue: 0,1:29:35.48,1:29:36.65,JPN,,0,0,0,,Бұл Тамаки-сан.
Dialogue: 0,1:29:37.31,1:29:37.94,JPN,,0,0,0,,Иә, иә
Dialogue: 0,1:29:37.52,1:29:38.98,JPN,？？,0,0,0,,Минору да көңілі қалды.
Dialogue: 0,1:29:38.35,1:29:39.44,JPN,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,1:29:40.77,1:29:44.69,JPN,,0,0,0,,Токиоға бара жатқан экспресс автобус дәл қазір тұрақта тоқтап тұр.
Dialogue: 0,1:29:45.02,1:29:46.48,JPN,,0,0,0,,Орындар толығымен бос.
Dialogue: 0,1:29:46.90,1:29:48.27,JPN,,0,0,0,,Осы жерден брондауыңызға болады.
Dialogue: 0,1:29:48.27,1:29:49.94,JPN,,0,0,0,,Эй, сәл күте тұршы, Минору-кун.
Dialogue: 0,1:29:50.35,1:29:52.35,JPN,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,1:29:52.35,1:29:53.40,JPN,,0,0,0,,тым кеш...
Dialogue: 0,1:30:07.44,1:30:08.31,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:30:08.90,1:30:11.60,JPN,,0,0,0,,Сота мырза...
Dialogue: 0,1:30:13.65,1:30:16.23,JPN,,0,0,0,,Сузуме, сен дәл қазір дірілдеп тұрсың.
Dialogue: 0,1:30:16.23,1:30:18.02,JPN,,0,0,0,,Барлық жағымсыз сезімдер мен жер сілкіністері
Dialogue: 0,1:30:20.19,1:30:22.69,JPN,,0,0,0,,Тамақтың қажеті жоқ екеніне сенімдісіз бе?
Dialogue: 0,1:30:27.40,1:30:31.23,JPN,,0,0,0,,Эй, Сузуме, менімен дұрыс сөйлескеніңді қалаймын.
Dialogue: 0,1:30:31.90,1:30:32.69,JPN,,0,0,0,,Не?
Dialogue: 0,1:30:33.44,1:30:36.23,JPN,,0,0,0,,Ата-анаңның үйіне барғың келе ме?
Dialogue: 0,1:30:36.85,1:30:37.65,JPN,,0,0,0,,Есік
Dialogue: 0,1:30:38.81,1:30:40.44,JPN,,0,0,0,,Кешіріңіз, мен жақсы сөйлей алмаймын.
Dialogue: 0,1:30:41.15,1:30:42.02,JPN,,0,0,0,,Бұл не?
Dialogue: 0,1:30:42.48,1:30:44.85,JPN,,0,0,0,,Адамдарға аздап қиындық туғызу
Dialogue: 0,1:30:44.85,1:30:45.56,JPN,,0,0,0,,Тітіркендіргіш
Dialogue: 0,1:30:46.44,1:30:47.94,JPN,,0,0,0,,Айтсаң да түсінбейсің.
Dialogue: 0,1:30:48.19,1:30:49.19,JPN,,0,0,0,,Тамаки мырзаға
Dialogue: 0,1:30:50.81,1:30:51.60,JPN,,0,0,0,,Үйге қайтайық.
Dialogue: 0,1:30:51.60,1:30:52.69,JPN,,0,0,0,,Каэде автобуспен
Dialogue: 0,1:30:52.98,1:30:54.48,JPN,,0,0,0,,Мен тіпті дұрыс түсіндіре алмаймын.
Dialogue: 0,1:30:54.48,1:30:55.65,JPN,,0,0,0,,Сол көк жүзімен
Dialogue: 0,1:30:55.65,1:30:56.98,JPN,,0,0,0,,Көріну үшін ештеңе жеме.
Dialogue: 0,1:30:56.98,1:30:57.69,JPN,,0,0,0,,Жібер
Dialogue: 0,1:30:57.69,1:30:58.40,JPN,,0,0,0,,Сузуме
Dialogue: 0,1:30:58.40,1:30:59.77,JPN,,0,0,0,,Тамаки-сан өтінемін үйге қайт.
Dialogue: 0,1:31:00.40,1:31:01.94,JPN,,0,0,0,,Мен сені менімен бірге келуді сұраған жоқпын.
Dialogue: 0,1:31:02.52,1:31:03.69,JPN,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,1:31:04.15,1:31:06.10,JPN,,0,0,0,,мені қатты алаңдатты.
Dialogue: 0,1:31:06.10,1:31:08.19,JPN,,0,0,0,,Бұл мен үшін тым ауыр
Dialogue: 0,1:31:17.94,1:31:20.65,JPN,,0,0,0,,Мен қазір шаршадым
Dialogue: 0,1:31:21.98,1:31:24.10,JPN,,0,0,0,,Маған Сузумені асырап алуға тура келді.
Dialogue: 0,1:31:24.69,1:31:27.44,JPN,,0,0,0,,Мен сізде он жылдан бері жұмыс істеп келемін.
Dialogue: 0,1:31:27.65,1:31:29.44,JPN,,0,0,0,,Мен ақымақ сияқтымын.
Dialogue: 0,1:31:30.65,1:31:31.94,JPN,,0,0,0,,Не істесең де, абай бол.
Dialogue: 0,1:31:32.44,1:31:34.10,JPN,,0,0,0,,Қандай бала анасынан айырылады?
Dialogue: 0,1:31:34.81,1:31:35.98,JPN,,0,0,0,,Себебі сіз сонда болдыңыз
Dialogue: 0,1:31:35.98,1:31:37.94,JPN,,0,0,0,,Мен ешкімді үйіме шақыра алмадым.
Dialogue: 0,1:31:37.94,1:31:38.90,JPN,,0,0,0,,Тұтқаны бар
Dialogue: 0,1:31:38.90,1:31:40.98,JPN,,0,0,0,,Тіпті неке аулау да жақсы болмайды.
Dialogue: 0,1:31:40.98,1:31:41.98,JPN,,0,0,0,,Лас өмір
Dialogue: 0,1:31:41.98,1:31:44.94,JPN,,0,0,0,,Менде әпкемнің ақшасы болса да, оның құны мүлдем болмас еді.
Dialogue: 0,1:31:46.73,1:31:48.44,JPN,,0,0,0,,Солай ма?
Dialogue: 0,1:31:50.77,1:31:51.94,JPN,,0,0,0,,Бірақ мен де
Dialogue: 0,1:31:52.10,1:31:53.94,JPN,,0,0,0,,Мен сені алып кетуге кешігіп қалдым.
Dialogue: 0,1:31:53.94,1:31:55.56,JPN,,0,0,0,,Мен сенімен бірге болған жоқпын, өйткені мен сенімен бірге болғым келді.
Dialogue: 0,1:31:55.90,1:31:57.10,JPN,,0,0,0,,Менің балам бол
Dialogue: 0,1:31:58.56,1:31:59.94,JPN,,0,0,0,,Тамаки-сан осылай деді.
Dialogue: 0,1:32:00.19,1:32:01.44,JPN,,0,0,0,,Менің балам бол
Dialogue: 0,1:32:01.69,1:32:03.44,JPN,,0,0,0,,Бұл есімде жоқ.
Dialogue: 0,1:32:03.77,1:32:05.94,JPN,,0,0,0,,Менің үйімнен кетуің керек.
Dialogue: 0,1:32:06.27,1:32:07.77,JPN,,0,0,0,,Маған өмірімді қайтар
Dialogue: 0,1:32:07.77,1:32:08.52,JPN,,0,0,0,,Маған өмірімді қайтар
Dialogue: 0,1:32:12.73,1:32:15.02,JPN,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:32:16.10,1:32:17.77,JPN,,0,0,0,,Садайжин
Dialogue: 0,1:32:19.56,1:32:21.02,JPN,,0,0,0,,Садайжин?
Dialogue: 0,1:32:28.85,1:32:29.85,JPN,,0,0,0,,Эй, Тамаки-сан?
Dialogue: 0,1:32:33.19,1:32:34.60,JPN,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,1:32:51.19,1:32:52.69,JPN,,0,0,0,,Тамаки-сан, жақсысың ба?
Dialogue: 0,1:32:53.44,1:32:54.42,JPN,,0,0,0,,20-шы эпизод: Бастықтың соңғы бұйрығы
Dialogue: 0,1:32:55.15,1:32:57.19,JPN,,0,0,0,,Кешіріңіз, мен...
Dialogue: 0,1:33:01.10,1:33:01.98,JPN,,0,0,0,,Серизава-кун
Dialogue: 0,1:33:02.52,1:33:03.27,JPN,,0,0,0,,Түсінікті.
Dialogue: 0,1:33:03.90,1:33:07.02,JPN,,0,0,0,,Мен өзімді біртүрлі сезінемін.
Dialogue: 0,1:33:08.15,1:33:11.60,JPN,,0,0,0,,Неге мен мұндай ақымақ сөз айттым?
Dialogue: 0,1:33:16.81,1:33:18.02,JPN,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:33:22.48,1:33:24.15,JPN,,0,0,0,,Терең қараңғылық
Dialogue: 0,1:33:27.90,1:33:29.06,JPN,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,1:33:30.81,1:33:31.40,JPN,,0,0,0,,Жоқ
Dialogue: 0,1:33:32.35,1:33:33.35,JPN,,0,0,0,,Бұл ма?
Dialogue: 0,1:33:46.77,1:33:48.85,JPN,,0,0,0,,Бұл көлік күн ашық кезде керемет сезінеді, солай ма?
Dialogue: 0,1:33:49.69,1:33:51.10,JPN,,0,0,0,,Ән тым қатты
Dialogue: 0,1:33:52.19,1:33:54.27,JPN,,0,0,0,,Мен оны қонаққа қарай таңдаймын.
Dialogue: 0,1:33:55.02,1:33:57.60,JPN,,0,0,0,,Сузуме-чан, сағыныш әуені жақсы.
Dialogue: 0,1:34:00.73,1:34:02.44,JPN,,0,0,0,,Ауа ауыр.
Dialogue: 0,1:34:02.44,1:34:03.35,JPN,,0,0,0,,Сәлем, жаңа жігіт.
Dialogue: 0,1:34:04.06,1:34:05.90,JPN,,0,0,0,,Тағы біреуі болады деп ойламадым.
Dialogue: 0,1:34:06.56,1:34:08.10,JPN,,0,0,0,,Бірақ бұл үлкен мысық.
Dialogue: 0,1:34:09.35,1:34:11.73,JPN,,0,0,0,,Кемпірқосақ, сәттілік тілейміз
Dialogue: 0,1:34:15.90,1:34:18.10,JPN,,0,0,0,,Барлығы жауап беруді тоқтатты.
Dialogue: 0,1:34:20.98,1:34:25.10,JPN,,0,0,0,,Сузуме-чан, мысықтар себепсіз сенің соңынан ермейді, солай ма?
Dialogue: 0,1:34:25.10,1:34:25.35,JPN,,0,0,0,,Бұл ит емес.
Dialogue: 0,1:34:25.35,1:34:26.27,JPN,,0,0,0,,Бұл ит емес.
Dialogue: 0,1:34:27.52,1:34:28.85,JPN,,0,0,0,,Қане, ақ пен қара
Dialogue: 0,1:34:29.27,1:34:32.27,JPN,,0,0,0,,Сіз шынымен де Сузуменің істегенін қалайсыз ба?
Dialogue: 0,1:34:32.27,1:34:33.19,JPN,,0,0,0,,бұл дұрыс
Dialogue: 0,1:34:34.73,1:34:37.35,JPN,,0,0,0,,Оны қолмен қайта біріктіріңіз
Dialogue: 0,1:34:40.10,1:34:42.23,JPN,,0,0,0,,Мысық сөйледі
Dialogue: 0,1:35:00.35,1:35:01.60,JPN,,0,0,0,,Ах, бекітілген.
Dialogue: 0,1:35:06.48,1:35:07.35,JPN,,0,0,0,,Шынайы ма?
Dialogue: 0,1:35:08.10,1:35:09.85,JPN,,0,0,0,,Бұл шынымен қауіпті болса керек.
Dialogue: 0,1:35:10.27,1:35:13.06,JPN,,0,0,0,,Айтайын дегенім, сен шынымен сөйлестің бе, Аннеко?
Dialogue: 0,1:35:13.60,1:35:16.85,JPN,,0,0,0,,Біз сөйлестік.
Dialogue: 0,1:35:17.10,1:35:18.98,JPN,,0,0,0,,Бұл не, психикалық құбылыс?
Dialogue: 0,1:35:18.98,1:35:20.60,JPN,,0,0,0,,Жоқ, ақымақ.
Dialogue: 0,1:35:20.73,1:35:21.65,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,1:35:22.85,1:35:24.15,JPN,,0,0,0,,Тоқтамайды
Dialogue: 0,1:35:25.56,1:35:26.69,JPN,,0,0,0,,Серизава мырза
Dialogue: 0,1:35:26.69,1:35:28.60,JPN,,0,0,0,,Бар болғаны 10 шақырым қалды.
Dialogue: 0,1:35:28.98,1:35:31.44,JPN,,0,0,0,,Межелі жерге дейін шамамен 20 шақырым.
Dialogue: 0,1:35:31.90,1:35:34.81,JPN,,0,0,0,,20км, әлі біраз алыс.
Dialogue: 0,1:35:34.81,1:35:36.02,JPN,,0,0,0,,Әрине
Dialogue: 0,1:35:36.02,1:35:36.85,JPN,,0,0,0,,Мен білемін.
Dialogue: 0,1:35:37.10,1:35:38.35,JPN,,0,0,0,,Мен жүгіріп жатырмын
Dialogue: 0,1:35:39.27,1:35:40.35,JPN,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:35:40.48,1:35:42.31,JPN,,0,0,0,,Серизава мырза мен Тамаки мырза да
Dialogue: 0,1:35:52.90,1:35:54.69,JPN,,0,0,0,,Серизава-кун, мен де барамын.
Dialogue: 0,1:35:55.19,1:35:57.60,JPN,,0,0,0,,Мені осы уақытқа дейін жібергеніңіз үшін рахмет.
Dialogue: 0,1:36:00.56,1:36:03.90,JPN,,0,0,0,,Сіз таңқаларлықтай жақсы мұғалім болып шығуыңыз мүмкін.
Dialogue: 0,1:36:06.60,1:36:08.35,JPN,,0,0,0,,Эй, эй, эй
Dialogue: 0,1:36:10.40,1:36:12.44,JPN,,0,0,0,,Бұл екеуіне не болды?
Dialogue: 0,1:36:18.06,1:36:20.48,JPN,,0,0,0,,Бұл жақсы, Сота бір.
Dialogue: 0,1:36:34.31,1:36:35.10,JPN,,0,0,0,,Тамаки мырза?
Dialogue: 0,1:36:36.40,1:36:37.52,JPN,,0,0,0,,Жетеді
Dialogue: 0,1:36:39.27,1:36:40.48,JPN,,0,0,0,,Қысқасы
Dialogue: 0,1:36:40.48,1:36:43.02,JPN,,0,0,0,,Өзіңізге ұнайтын адамға барғыңыз келе ме?
Dialogue: 0,1:36:45.19,1:36:46.35,JPN,,0,0,0,,Бұл махаббат немесе басқа нәрсе туралы емес.
Dialogue: 0,1:36:50.15,1:36:52.60,JPN,,0,0,0,,Эй, Сузуме, бұл мысықтар қандай?
Dialogue: 0,1:36:53.10,1:36:54.81,JPN,,0,0,0,,Мен оны Құдай сияқты сезінемін.
Dialogue: 0,1:36:54.81,1:36:55.90,JPN,,0,0,0,,Құдай
Dialogue: 0,1:36:59.81,1:37:02.40,JPN,,0,0,0,,Білесің бе, мен тұрақта не айттым.
Dialogue: 0,1:37:02.40,1:37:02.60,JPN,,0,0,0,,Білесің бе, мен тұрақта не айттым.
Dialogue: 0,1:37:03.31,1:37:05.65,JPN,,0,0,0,,Мен іштей бірдеңе ойладым.
Dialogue: 0,1:37:05.65,1:37:07.48,JPN,,0,0,0,,Бірақ мұны істеу керек
Dialogue: 0,1:37:08.27,1:37:08.90,JPN,,0,0,0,,Иә
Dialogue: 0,1:37:09.52,1:37:11.81,JPN,,0,0,0,,Жалпы, мұның бәрін істеу керек.
Dialogue: 0,1:37:13.73,1:37:14.90,JPN,,0,0,0,,Мен де
Dialogue: 0,1:37:16.02,1:37:17.65,JPN,,0,0,0,,Кешіріңіз, Тамаки-сан.
Dialogue: 0,1:37:19.35,1:37:22.27,JPN,,0,0,0,,Бұл менің 12 жылдан кейін үйге бірінші рет оралуым.
Dialogue: 0,1:37:35.31,1:37:37.19,JPN,,0,0,0,,Мен үйдемін, анашым.
Dialogue: 0,1:37:41.69,1:37:42.90,JPN,,0,0,0,,Мен үйдемін
Dialogue: 0,1:37:43.31,1:37:43.98,JPN,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:37:46.69,1:37:49.65,JPN,,0,0,0,,Сузуме, сен есейдің, әпке.
Dialogue: 0,1:37:50.73,1:37:53.85,JPN,,0,0,0,,Бұл бала не істемек?
Dialogue: 0,1:38:01.94,1:38:02.56,JPN,,0,0,0,,болды
Dialogue: 0,1:38:14.65,1:38:15.65,JPN,,0,0,0,,Күнделік?
Dialogue: 0,1:38:16.73,1:38:17.40,JPN,,0,0,0,,Иә
Dialogue: 0,1:38:17.40,1:38:19.69,JPN,,0,0,0,,Ол күндер көп есімде жоқ.
Dialogue: 0,1:38:20.10,1:38:22.52,JPN,,0,0,0,,Бірақ мен есіктен кіріп кеткен болуым керек.
Dialogue: 0,1:38:37.77,1:38:42.73,JPN,,0,0,0,,Үлкен цунами туралы ескерту жарияланды
Dialogue: 0,1:38:42.73,1:38:44.81,JPN,,0,0,0,,Мұхит маңындағылар үшін
Dialogue: 0,1:38:44.81,1:38:48.06,JPN,,0,0,0,,Биік жерге эвакуациялаңыз
Dialogue: 0,1:38:48.06,1:38:50.56,JPN,,0,0,0,,Цунами байқалды
Dialogue: 0,1:38:49.60,1:38:51.15,JPN,,0,0,0,,Анашым, білмейсіз бе?
Dialogue: 0,1:38:50.60,1:38:52.15,JPN,,0,0,0,,Жалғыз сен бе?
Dialogue: 0,1:38:51.15,1:38:53.10,JPN,,0,0,0,,Ол ауруханада жұмыс істеген.
Dialogue: 0,1:38:53.06,1:38:54.69,JPN,,0,0,0,,Анашым, сіз білмейсіз бе?
Dialogue: 0,1:38:54.06,1:38:56.06,JPN,,0,0,0,,Цубакиме-сан, мен сені әлі таппадым.
Dialogue: 0,1:38:55.52,1:38:57.60,JPN,？？,0,0,0,,Сол қызды бүгін тағы іздеуге тура келді.
Dialogue: 0,1:38:57.60,1:38:59.85,JPN,,0,0,0,,Торғайдың анасы, сен білмейсің бе?
Dialogue: 0,1:38:59.10,1:39:00.69,JPN,,0,0,0,,Бар болғаны төрт жаста
Dialogue: 0,1:39:00.10,1:39:01.31,JPN,,0,0,0,,Мүмкін қазірдің өзінде...
Dialogue: 0,1:39:01.06,1:39:02.19,JPN,,0,0,0,,Бұл ауырады.
Dialogue: 0,1:39:01.73,1:39:03.23,JPN,,0,0,0,,Poor guy
Dialogue: 0,1:39:01.90,1:39:03.69,JPN,,0,0,0,,Анашым, білмейсіз бе?
Dialogue: 0,1:39:03.23,1:39:04.85,JPN,,0,0,0,,Жалғыз
Dialogue: 0,1:39:04.31,1:39:06.31,JPN,,0,0,0,,Кешіріңіз, Сузуме-чан
Dialogue: 0,1:39:04.85,1:39:06.73,JPN,,0,0,0,,Анашым, білмейсіз бе?
Dialogue: 0,1:39:06.98,1:39:08.48,JPN,,0,0,0,,Кешіріңіз, кешіріңіз, кешіріңіз
Dialogue: 0,1:39:08.48,1:39:11.15,JPN,,0,0,0,,Анашым, сіз қайдасыз?
Dialogue: 0,1:39:15.65,1:39:17.73,JPN,,0,0,0,,Бұл арман емес еді
Dialogue: 0,1:39:18.94,1:39:20.90,JPN,,0,0,0,,Иә, ай шықты.
Dialogue: 0,1:39:20.90,1:39:21.15,JPN,,0,0,0,,Сол күні ай сол радио мұнарасының үстінде болды.
Dialogue: 0,1:39:21.15,1:39:23.48,JPN,,0,0,0,,Сол күні ай сол радио мұнарасының үстінде болды.
Dialogue: 0,1:39:25.27,1:39:27.65,JPN,,0,0,0,,Мына есікті іздеп жүргенің не?
Dialogue: 0,1:39:27.65,1:39:28.98,JPN,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,1:39:28.98,1:39:29.90,JPN,,0,0,0,,Сузуме
Dialogue: 0,1:39:30.27,1:39:33.73,JPN,,0,0,0,,Он екі жыл бұрынғы үйінділер қазір жоқ.
Dialogue: 0,1:39:38.85,1:39:39.65,JPN,,0,0,0,,Қайда?
Dialogue: 0,1:39:42.77,1:39:43.65,JPN,,0,0,0,,Торғай
Dialogue: 0,1:39:45.06,1:39:45.98,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:39:49.40,1:39:50.98,JPN,,0,0,0,,Эй, не?
Dialogue: 0,1:40:07.48,1:40:09.48,JPN,,0,0,0,,Дайджин, мүмкін сен бе?
Dialogue: 0,1:40:09.85,1:40:12.98,JPN,,0,0,0,,Сіз мені Уродо болған жерге жетелеп көрдіңіз бе?
Dialogue: 0,1:40:14.52,1:40:15.44,JPN,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,1:40:23.60,1:40:24.98,JPN,,0,0,0,,Рахмет, Дайжин
Dialogue: 0,1:40:27.98,1:40:29.23,JPN,,0,0,0,,Кеттік, торғай
Dialogue: 0,1:40:31.27,1:40:32.73,JPN,,0,0,0,,Сузуме
Dialogue: 0,1:40:33.06,1:40:35.48,JPN,,0,0,0,,Тамаки мырза, мен барамын.
Dialogue: 0,1:40:36.35,1:40:36.98,JPN,,0,0,0,,Қайда?
Dialogue: 0,1:40:37.23,1:40:38.48,JPN,,0,0,0,,Сізге ұнайтын адамда
Dialogue: 0,1:40:46.10,1:40:47.23,JPN,,0,0,0,,Сузуме...
Dialogue: 0,1:40:59.40,1:41:00.81,JPN,,0,0,0,,Жер отқа оранды
Dialogue: 0,1:41:04.48,1:41:05.23,JPN,,0,0,0,,Бұл...
Dialogue: 0,1:41:05.81,1:41:06.56,JPN,,0,0,0,,Бұл жауын құрты.
Dialogue: 0,1:41:11.94,1:41:13.44,JPN,,0,0,0,,Артқы есіктен шығасыз ба?
Dialogue: 0,1:41:24.81,1:41:25.73,JPN,,0,0,0,,Садайжин
Dialogue: 0,1:41:42.02,1:41:42.98,JPN,,0,0,0,,Бұл не?
Dialogue: 0,1:41:43.65,1:41:44.48,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:42:03.94,1:42:04.98,JPN,,0,0,0,,Дайджин, сен...
Dialogue: 0,1:42:07.52,1:42:09.23,JPN,,0,0,0,,Сузуме, жақсысың ба?
Dialogue: 0,1:42:11.98,1:42:13.48,JPN,,0,0,0,,Не, мұнда?
Dialogue: 0,1:42:14.48,1:42:16.15,JPN,,0,0,0,,Бұл мәңгілік дүние ме?
Dialogue: 0,1:42:17.94,1:42:18.90,JPN,,0,0,0,,Бұл Сота-сан.
Dialogue: 0,1:43:07.19,1:43:07.90,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:43:08.31,1:43:09.02,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:43:09.52,1:43:10.65,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:43:17.27,1:43:17.90,JPN,,0,0,0,,Торғай
Dialogue: 0,1:43:18.52,1:43:19.52,JPN,,0,0,0,,Тасты алып тастағаннан кейін
Dialogue: 0,1:43:19.94,1:43:21.65,JPN,,0,0,0,,Жауан құрт сыртқа шығып барады.
Dialogue: 0,1:43:21.77,1:43:23.40,JPN,,0,0,0,,Мен тірек боламын
Dialogue: 0,1:43:24.94,1:43:25.98,JPN,,0,0,0,,Мен ең болмағанда алған ақшамды қайтарып бергім келеді.
Dialogue: 0,1:43:27.35,1:43:28.52,JPN,,0,0,0,,Оян
Dialogue: 0,1:43:29.15,1:43:30.27,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:43:33.69,1:43:34.27,JPN,,0,0,0,,Сіз...
Dialogue: 0,1:43:47.56,1:43:51.52,JPN,,0,0,0,,Сота-сан, мен осы уақытқа дейін келдім.
Dialogue: 0,1:43:52.23,1:43:53.90,JPN,,0,0,0,,Маған жауап берші, Сота-сан.
Dialogue: 0,1:43:55.02,1:43:57.40,JPN,,0,0,0,,Сота-сан, сенің дауысыңды естуге рұқсат етші
Dialogue: 0,1:43:58.10,1:43:58.98,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:43:59.85,1:44:00.98,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:44:07.69,1:44:09.27,JPN,,0,0,0,,Эй, сен
Dialogue: 0,1:44:11.56,1:44:13.77,JPN,,0,0,0,,Бұл жерде қирандылар бар ма?
Dialogue: 0,1:44:14.23,1:44:15.27,JPN,,0,0,0,,Үйінділер?
Dialogue: 0,1:44:17.73,1:44:20.44,JPN,,0,0,0,,Өлімнен қорықпайсың ба?
Dialogue: 0,1:44:20.60,1:44:21.44,JPN,,0,0,0,,Қорқынышты емес
Dialogue: 0,1:44:21.44,1:44:23.35,JPN,,0,0,0,,Ей, біз ғажап емеспіз бе?
Dialogue: 0,1:44:23.94,1:44:25.19,JPN,,0,0,0,,Маңызды нәрсе істеп жатқаныңызға сенімдімін.
Dialogue: 0,1:44:25.19,1:44:26.69,JPN,,0,0,0,,Эй, Сота-сан да.
Dialogue: 0,1:44:26.98,1:44:29.35,JPN,,0,0,0,,Сота-сан, сен танымалсың, солай ма?
Dialogue: 0,1:44:30.02,1:44:30.73,JPN,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,1:44:31.23,1:44:31.98,JPN,,0,0,0,,Бұл...
Dialogue: 0,1:44:33.44,1:44:35.98,JPN,,0,0,0,,Бұл соңы ма?
Dialogue: 0,1:44:36.44,1:44:37.94,JPN,,0,0,0,,Осындай жерде
Dialogue: 0,1:44:38.44,1:44:40.69,JPN,,0,0,0,,Сотаның естеліктері?
Dialogue: 0,1:44:41.60,1:44:44.52,JPN,,0,0,0,,Бірақ мен сені кездестіргендіктен
Dialogue: 0,1:44:42.60,1:44:43.40,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:44:43.94,1:44:44.69,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:44:44.98,1:44:46.23,JPN,,0,0,0,,Сәлем, Сота-сан
Dialogue: 0,1:44:47.06,1:44:48.44,JPN,,0,0,0,,Мен сені кездестірсем ғой!
Dialogue: 0,1:44:48.56,1:44:49.44,JPN,,0,0,0,,Сота-сан!
Dialogue: 0,1:44:49.81,1:44:50.94,JPN,,0,0,0,,Менің жоғалып кеткім келмейді
Dialogue: 0,1:44:51.10,1:44:52.23,JPN,,0,0,0,,Мен көбірек өмір сүргім келеді
Dialogue: 0,1:44:52.44,1:44:53.48,JPN,,0,0,0,,Мен өмір сүргім келеді
Dialogue: 0,1:44:53.60,1:44:54.69,JPN,,0,0,0,,Мен өлуден қорқамын
Dialogue: 0,1:44:55.65,1:44:56.48,JPN,,0,0,0,,Мен өмір сүргім келеді
Dialogue: 0,1:44:56.69,1:44:57.60,JPN,,0,0,0,,Мен өмір сүргім келеді
Dialogue: 0,1:44:57.77,1:44:58.73,JPN,,0,0,0,,Мен өмір сүргім келеді
Dialogue: 0,1:44:58.98,1:45:01.10,JPN,,0,0,0,,Қосымша
Dialogue: 0,1:45:02.31,1:45:04.15,JPN,,0,0,0,,Мен де солаймын!
Dialogue: 0,1:45:04.81,1:45:06.60,JPN,,0,0,0,,Мен көбірек, көбірек өмір сүргім келеді
Dialogue: 0,1:45:07.15,1:45:08.23,JPN,,0,0,0,,Даусыңды естігім келеді
Dialogue: 0,1:45:08.65,1:45:09.69,JPN,,0,0,0,,Жалғыз болу қорқынышты
Dialogue: 0,1:45:10.10,1:45:11.60,JPN,,0,0,0,,Мен өлуден қорқамын
Dialogue: 0,1:45:12.23,1:45:13.40,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:45:51.19,1:45:52.40,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:45:54.40,1:45:55.65,JPN,,0,0,0,,Сузуме-сан?
Dialogue: 0,1:45:58.23,1:45:59.02,JPN,,0,0,0,,Мен...
Dialogue: 0,1:46:02.35,1:46:03.10,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:46:04.60,1:46:05.27,JPN,,0,0,0,,Не болды?
Dialogue: 0,1:46:06.27,1:46:07.02,JPN,,0,0,0,,Амансың ба?
Dialogue: 0,1:46:09.73,1:46:11.15,JPN,,0,0,0,,Дайцзиннің шашырауы
Dialogue: 0,1:46:11.48,1:46:14.40,JPN,,0,0,0,,Торғайдың баласы бола алмадым
Dialogue: 0,1:46:15.81,1:46:17.68,JPN,,0,0,0,,Торғайдың қолында
Dialogue: 0,1:46:18.15,1:46:20.15,JPN,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,1:46:24.85,1:46:25.60,JPN,,0,0,0,,Дайжин
Dialogue: 0,1:46:35.60,1:46:36.15,JPN,,0,0,0,,Екінші негізгі тас
Dialogue: 0,1:46:36.15,1:46:37.10,JPN,,0,0,0,,Екінші негізгі тас
Dialogue: 0,1:46:38.31,1:46:40.06,JPN,,0,0,0,,Артқы есіктен жауын құрттары шығады
Dialogue: 0,1:47:03.81,1:47:04.60,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,1:47:04.60,1:47:05.60,JPN,,0,0,0,,Мен жақсымын
Dialogue: 0,1:47:06.27,1:47:07.23,JPN,,0,0,0,,Не істеу керек?
Dialogue: 0,1:47:07.23,1:47:09.10,JPN,,0,0,0,,Тыңдаңыз және тыңдаңыз
Dialogue: 0,1:47:09.77,1:47:10.48,JPN,,0,0,0,,Менің артымнан жүр
Dialogue: 0,1:47:20.40,1:47:22.77,JPN,,0,0,0,,Дана және көрінбейтін құдай
Dialogue: 0,1:47:23.94,1:47:25.77,JPN,,0,0,0,,Алыстағы ата-бабаларымыздың жері.
Dialogue: 0,1:47:27.19,1:47:29.90,JPN,,0,0,0,,Осы таулар мен өзендермен мен көптен араластым.
Dialogue: 0,1:47:30.73,1:47:32.06,JPN,,0,0,0,,Кашикоми,кашикоми
Dialogue: 0,1:47:32.48,1:47:35.02,JPN,,0,0,0,,Жауабыңызды кішіпейілділікпен сұраймын.
Dialogue: 0,1:47:39.98,1:47:40.60,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,1:47:40.85,1:47:41.56,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,1:47:41.69,1:47:42.44,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,1:47:42.81,1:47:43.94,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,1:47:43.52,1:47:44.90,JPN,,0,0,0,,Itadadakimasu
Dialogue: 0,1:47:44.19,1:47:45.10,JPN,,0,0,0,,Гочисусан
Dialogue: 0,1:47:44.90,1:47:46.02,JPN,,0,0,0,,Алдымен,осындай алыпты аулау идеясы өзі—
Dialogue: 0,1:47:45.73,1:47:47.15,JPN,,0,0,0,,I'm going
Dialogue: 0,1:47:47.15,1:47:47.94,JPN,,0,0,0,,I'm going
Dialogue: 0,1:47:47.94,1:47:49.10,JPN,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:47:49.10,1:47:49.77,JPN,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:47:50.06,1:47:51.15,JPN,,0,0,0,,Тезірек оралыңыз.
Dialogue: 0,1:47:50.98,1:47:52.02,JPN,,0,0,0,,I'm going
Dialogue: 0,1:47:51.48,1:47:52.40,JPN,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:47:52.15,1:47:53.40,JPN,,0,0,0,,I'm going
Dialogue: 0,1:47:53.27,1:47:54.10,JPN,,0,0,0,,Не болды? Пластырь жапсыруым керек болар.
Dialogue: 0,1:47:54.23,1:47:54.85,JPN,,0,0,0,,Абайлаңыз
Dialogue: 0,1:47:54.81,1:47:58.77,JPN,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:47:56.60,1:47:57.44,JPN,,0,0,0,,I'm going
Dialogue: 0,1:47:58.77,1:48:00.23,JPN,,0,0,0,,I'm going
Dialogue: 0,1:48:01.73,1:48:04.44,JPN,,0,0,0,,Менің өміріме қауіп төніп тұрғанын білемін.
Dialogue: 0,1:48:04.98,1:48:07.48,JPN,,0,0,0,,Өлім әрқашан қасымда екенін білемін.
Dialogue: 0,1:48:08.77,1:48:10.19,JPN,,0,0,0,,Сонда да бар болғаны бір жыл болды
Dialogue: 0,1:48:10.52,1:48:11.94,JPN,,0,0,0,,Бүгінгі күн
Dialogue: 0,1:48:12.19,1:48:13.94,JPN,,0,0,0,,Тіпті бір сәтке болса да
Dialogue: 0,1:48:14.40,1:48:16.19,JPN,,0,0,0,,Біз мәңгілік болғымыз келеді
Dialogue: 0,1:48:17.19,1:48:18.69,JPN,,0,0,0,,Ұлы қаһарлы құдай
Dialogue: 0,1:48:19.35,1:48:21.23,JPN,,0,0,0,,Өтінемін,өтінемін
Dialogue: 0,1:48:21.81,1:48:23.19,JPN,,0,0,0,,Өтінемін
Dialogue: 0,1:48:29.60,1:48:30.48,JPN,,0,0,0,,Жарайды
Dialogue: 0,1:48:30.65,1:48:31.73,JPN,,0,0,0,,Өзіңізді тапсырыңыз
Dialogue: 0,1:48:53.48,1:48:54.81,JPN,,0,0,0,,Мен оны сізге қайтарамын!
Dialogue: 0,1:49:42.90,1:49:43.81,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,1:50:02.40,1:50:04.15,JPN,,0,0,0,,Сузуме-сан, мұнда біреу бар.
Dialogue: 0,1:50:05.73,1:50:06.56,JPN,,0,0,0,,Балалар?
Dialogue: 0,1:50:07.60,1:50:08.56,JPN,,0,0,0,,Ә? Мүмкін емес! Не болып жатыр?!
Dialogue: 0,1:50:08.85,1:50:10.40,JPN,,0,0,0,,Менің кетуім керек
Dialogue: 0,1:50:11.40,1:50:12.23,JPN,,0,0,0,,Сузуме-сан
Dialogue: 0,1:50:22.23,1:50:23.15,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,1:50:24.23,1:50:25.40,JPN,,0,0,0,,Олай ма еді?
Dialogue: 0,1:50:27.23,1:50:28.44,JPN,,0,0,0,,Мен ақыры түсіндім
Dialogue: 0,1:50:37.90,1:50:38.56,JPN,,0,0,0,,Торғай
Dialogue: 0,1:50:40.52,1:50:41.19,JPN,,0,0,0,,Торғай
Dialogue: 0,1:50:47.27,1:50:48.31,JPN,,0,0,0,,Ана?
Dialogue: 0,1:50:50.94,1:50:52.06,JPN,,0,0,0,,Жоқ
Dialogue: 0,1:50:53.77,1:50:56.15,JPN,,0,0,0,,Торғайдың анасы, сен білмейсің бе?
Dialogue: 0,1:50:56.15,1:50:58.15,JPN,,0,0,0,,Анам да торғайларды іздеді.
Dialogue: 0,1:50:58.15,1:50:59.81,JPN,,0,0,0,,Сіз шынымен уайымдап жатқаныңызға сенімдімін.
Dialogue: 0,1:51:00.06,1:51:02.94,JPN,,0,0,0,,Мен тез анама баруым керек.
Dialogue: 0,1:51:02.44,1:51:03.69,JPN,,0,0,0,,Торғай, білесің бе?
Dialogue: 0,1:51:03.27,1:51:06.31,JPN,,0,0,0,,Торғайдың анасы ауруханада жұмыс істейді.
Dialogue: 0,1:51:06.48,1:51:08.56,JPN,,0,0,0,,Ас әзірлеуге және қолөнерге жақсы.
Dialogue: 0,1:51:09.81,1:51:11.27,JPN,,0,0,0,,Сіз маған кез келген нәрсені жасай аласыз.
Dialogue: 0,1:51:11.27,1:51:12.02,JPN,,0,0,0,,Торғай
Dialogue: 0,1:51:12.02,1:51:12.73,JPN,,0,0,0,,Үй...
Dialogue: 0,1:51:13.65,1:51:15.48,JPN,,0,0,0,,Өйткені мен үйімнен айырылдым
Dialogue: 0,1:51:16.81,1:51:17.81,JPN,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:51:19.02,1:51:21.81,JPN,,0,0,0,,Мен торғайдың енді қайда екенін білмеймін.
Dialogue: 0,1:51:21.81,1:51:22.81,JPN,,0,0,0,,Мен торғайдың енді қайда екенін білмеймін.
Dialogue: 0,1:51:22.81,1:51:23.56,JPN,,0,0,0,,Жетеді!
Dialogue: 0,1:51:26.52,1:51:29.65,JPN,,0,0,0,,Мен бұрыннан білетінмін.
Dialogue: 0,1:51:30.77,1:51:31.69,JPN,,0,0,0,,Неліктен?
Dialogue: 0,1:51:31.69,1:51:33.15,JPN,,0,0,0,,Менің анам осында.
Dialogue: 0,1:51:33.31,1:51:35.35,JPN,,0,0,0,,Торғай іздеп жүргенін айтты.
Dialogue: 0,1:51:35.35,1:51:35.90,JPN,,0,0,0,,Торғай
Dialogue: 0,1:51:35.90,1:51:38.31,JPN,,0,0,0,,Анашым, сіз қайдасыз?
Dialogue: 0,1:51:41.19,1:51:43.27,JPN,,0,0,0,,Анашым!
Dialogue: 0,1:51:46.90,1:51:47.85,JPN,,0,0,0,,Анам…
Dialogue: 0,1:51:50.94,1:51:52.23,JPN,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:52:01.69,1:52:03.15,JPN,,0,0,0,,Ей, торғай, қарашы
Dialogue: 0,1:52:03.85,1:52:05.27,JPN,,0,0,0,,Торғай, қарашы
Dialogue: 0,1:52:06.56,1:52:07.90,JPN,,0,0,0,,Бұл торғай орындық.
Dialogue: 0,1:52:10.44,1:52:11.90,JPN,,0,0,0,,Мен не айтуым керек?
Dialogue: 0,1:52:13.40,1:52:14.69,JPN,,0,0,0,,Білесің бе, торғай.
Dialogue: 0,1:52:15.40,1:52:17.60,JPN,,0,0,0,,Қазір қанша қайғырсаң да
Dialogue: 0,1:52:18.19,1:52:21.10,JPN,,0,0,0,,Торғай болашақта дұрыс өсе ме?
Dialogue: 0,1:52:24.10,1:52:25.69,JPN,,0,0,0,,Сондықтан уайымдамаңыз
Dialogue: 0,1:52:26.23,1:52:28.10,JPN,,0,0,0,,Болашақ қорқынышты емес
Dialogue: 0,1:52:29.10,1:52:31.77,JPN,,0,0,0,,Сіз біреуді жақсы көресіз
Dialogue: 0,1:52:32.31,1:52:35.69,JPN,,0,0,0,,Сізді жақсы көретін көптеген адамдарды кездестіресіз
Dialogue: 0,1:52:36.60,1:52:39.19,JPN,,0,0,0,,Қазір қараңғы болып көрінуі мүмкін, бірақ
Dialogue: 0,1:52:39.81,1:52:41.48,JPN,,0,0,0,,Таң міндетті түрде бір күні келеді
Dialogue: 0,1:52:42.23,1:52:44.60,JPN,,0,0,0,,Жарықта өсесің
Dialogue: 0,1:52:45.73,1:52:46.98,JPN,,0,0,0,,Бұл міндетті түрде болады.
Dialogue: 0,1:52:47.73,1:52:50.02,JPN,,0,0,0,,Бұл сөзсіз шешілді.
Dialogue: 0,1:52:52.94,1:52:54.73,JPN,,0,0,0,,Сіздің әпкеңіз кім?
Dialogue: 0,1:52:57.44,1:52:58.35,JPN,,0,0,0,,(Нишики) Бұл... осы туралы сұрауға мен дұрыс адаммын ба?
Dialogue: 0,1:53:00.44,1:53:02.52,JPN,,0,0,0,,Ертең торғай
Dialogue: 0,1:53:25.98,1:53:27.77,JPN,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,1:53:29.69,1:53:33.90,JPN,,0,0,0,,Мен үшін маңызды нәрселердің бәрін бұрыннан алғанмын.
Dialogue: 0,1:53:38.52,1:53:39.27,JPN,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,1:53:59.15,1:53:59.90,JPN,,0,0,0,,Сузуме
Dialogue: 0,1:54:01.69,1:54:02.90,JPN,,0,0,0,,Тамаки-сан!
Dialogue: 0,1:54:02.90,1:54:03.65,JPN,,0,0,0,,Серизава?
Dialogue: 0,1:54:11.73,1:54:13.06,JPN,,0,0,0,,Бұл туралы айтатын болсақ, сіз
Dialogue: 0,1:54:13.19,1:54:15.73,JPN,,0,0,0,,Сота-кун маған ақшамды қайтарып алуымды айтты.
Dialogue: 0,1:54:16.40,1:54:17.85,JPN,,0,0,0,,О, бұл өтірік
Dialogue: 0,1:54:18.48,1:54:21.10,JPN,,0,0,0,,Керісінше, мен оны Сотадан алғанмын.
Dialogue: 0,1:54:21.85,1:54:23.56,JPN,,0,0,0,,Ол ұмытып кеткен сияқты.
Dialogue: 0,1:54:23.56,1:54:24.90,JPN,,0,0,0,,Үндемей тұрасың ба?
Dialogue: 0,1:54:26.81,1:54:28.48,JPN,,0,0,0,,Қандай дәрменсіз бала.
Dialogue: 0,1:54:33.56,1:54:35.48,JPN,,0,0,0,,Үйге бірге барсақ екен.
Dialogue: 0,1:54:35.81,1:54:38.85,JPN,,0,0,0,,Адамдардың жүрегінің салмағы жерді тыныштандырады.
Dialogue: 0,1:54:39.40,1:54:41.85,JPN,,0,0,0,,Қайда жоғалып кетті және артқы есік ашылды
Dialogue: 0,1:54:41.85,1:54:42.81,JPN,,0,0,0,,Тағы да бар екеніне сенімдімін
Dialogue: 0,1:54:43.81,1:54:46.10,JPN,,0,0,0,,Мен Токиоға есікті құлыптап қайтамын.
Dialogue: 0,1:54:52.19,1:54:52.94,JPN,,0,0,0,,Сота мырза
Dialogue: 0,1:54:53.31,1:54:53.85,JPN,,0,0,0,,Ум...
Dialogue: 0,1:54:59.98,1:55:01.90,JPN,,0,0,0,,Мені құтқарғаның үшін рахмет.
Dialogue: 0,1:55:03.10,1:55:04.06,JPN,,0,0,0,,Мен сені көруге барамын.
Dialogue: 0,1:55:04.06,1:55:04.73,JPN,,0,0,0,,Міндетті түрде.
Dialogue: 0,1:56:36.73,1:56:37.44,JPN,,0,0,0,,Қайта оралдын.
Dialogue: 1,1:55:11.94,1:55:17.23,JPN,,0,0,0,,Менде жоқ, менде жоқ нәрселерден жаратылғанмын
Dialogue: 1,1:55:17.94,1:55:23.02,JPN,,0,0,0,,Сіз мені қалыптастырасыз
Dialogue: 1,1:55:23.94,1:55:29.40,JPN,,0,0,0,,Мен мұны айтқанда күлесің, солай ма?
Dialogue: 1,1:55:29.90,1:55:35.48,JPN,,0,0,0,,Мен тіпті сол жүзді көргім келеді
Dialogue: 1,1:55:35.90,1:55:41.15,JPN,,0,0,0,,Менде жоқ, менде жоқ нәрселерден жаратылғанмын
Dialogue: 1,1:55:41.98,1:55:47.73,JPN,,0,0,0,,Бұл дүние сені мақтайды
Dialogue: 1,1:55:59.40,1:56:02.40,JPN,,0,0,0,,«Сіз осында болғанша»
Dialogue: 1,1:56:02.40,1:56:04.56,JPN,,0,0,0,,«Сіз осында болғанша»
Dialogue: 1,1:56:05.23,1:56:08.77,JPN,,0,0,0,,Келесі сөздер
Dialogue: 1,1:56:08.77,1:56:14.35,JPN,,0,0,0,,Қаншалықты қорқынышты көрінсе де
Dialogue: 1,1:56:14.35,1:56:16.81,JPN,,0,0,0,,Осы қолдармен
Dialogue: 1,1:56:17.27,1:56:20.35,JPN,,0,0,0,,Мен сені құшақтай аламын.
Dialogue: 1,1:56:20.35,1:56:23.41,JPN,,0,0,0,,Мен сенімен бірге көрген үмітсіздікті
Dialogue: 1,1:56:23.41,1:56:30.65,JPN,,0,0,0,,Сенсіз үміт жарқырап, бұлыңғыр болады
Dialogue: 1,1:56:38.48,1:56:42.23,JPN,,0,0,0,,Неге екені белгісіз, күлгеніңіз мейірімділікке ұқсайтын.
Dialogue: 1,1:56:42.23,1:56:43.98,JPN,,0,0,0,,Неге екені белгісіз, сіздің күлгеніңіз мейірімділікке ұқсайды.
Dialogue: 1,1:56:44.56,1:56:49.85,JPN,,0,0,0,,Ән айтуың бүгінгі жаңбырдай көрінді
Dialogue: 1,1:56:50.44,1:56:56.02,JPN,,0,0,0,,Адамдардың мыңдаған жылдардан кейін не істейтінінен
Dialogue: 1,1:56:56.52,1:57:01.98,JPN,,0,0,0,,Сенің әлі ешкім білмейтін жүзіңмен күлімдегеніңді көргім келеді
Dialogue: 1,1:57:02.73,1:57:08.19,JPN,,0,0,0,,Менде жоқ, менде жоқ нәрселерден жаратылғанмын
Dialogue: 1,1:57:08.94,1:57:14.48,JPN,,0,0,0,,Сіз мені қалыптастырасыз
Dialogue: 1,1:57:14.94,1:57:20.44,JPN,,0,0,0,,Атың құрғағанша айқайласам
Dialogue: 1,1:57:20.94,1:57:27.35,JPN,,0,0,0,,Саған жете алсам, қазір айқайлаймын
Dialogue: 1,1:58:06.19,1:58:11.52,JPN,,0,0,0,,Сіздің ішіңіздегі қызыл және көк сызықтар
Dialogue: 1,1:58:12.27,1:58:17.77,JPN,,0,0,0,,Олар жүрек арқылы байланысады
Dialogue: 1,1:58:18.52,1:58:24.02,JPN,,0,0,0,,Жел болса да мойымайтын дауыспен
Dialogue: 1,1:58:24.69,1:58:30.06,JPN,,0,0,0,,Енді мен жеткізу үшін сөздерді дамытамын
Dialogue: 1,1:58:30.48,1:58:33.19,JPN,,0,0,0,,Уақыт - ұйықтаушы
Dialogue: 1,1:58:33.19,1:58:36.23,JPN,,0,0,0,,Жел соғады
Dialogue: 1,1:58:36.23,1:58:39.31,JPN,,0,0,0,,Жұлдыздар алдауда
Dialogue: 1,1:58:39.31,1:58:43.10,JPN,,0,0,0,,Адамдар қараңғы
Dialogue: 1,1:58:43.10,1:58:47.77,JPN,,0,0,0,,Неге жылайсың деген сұраққа жауап беруге болады.
Dialogue: 1,1:58:47.81,1:58:49.35,JPN,,0,0,0,,Көз жасы емес
Dialogue: 1,1:58:49.35,1:58:53.90,JPN,,0,0,0,,Біз кездесеміз деген мағынада
Dialogue: 1,1:58:53.90,1:58:55.31,JPN,,0,0,0,,Қуып жету мүмкін емес
Dialogue: 1,1:58:55.31,1:59:01.60,JPN,,0,0,0,,Жалғыз бұл дене жетпейді деп зар
Dialogue: 1,1:59:01.60,1:59:06.02,JPN,,0,0,0,,Қолыңды ұстағанда ғана қалтырап кеттім
Dialogue: 1,1:59:06.06,1:59:07.77,JPN,,0,0,0,,Менің жүрегім бар еді
Dialogue: 1,1:59:07.81,1:59:12.31,JPN,,0,0,0,,Межелі жерге жеткенше неше мағынаны кесіп өтуіміз керек?
Dialogue: 1,1:59:12.31,1:59:13.81,JPN,,0,0,0,,Оны киюім керек пе?
Dialogue: 1,1:59:13.81,1:59:16.81,JPN,,0,0,0,,Ақымақтық жеткілікті
Dialogue: 1,1:59:16.81,1:59:19.94,JPN,,0,0,0,,Ұсқындық жарайды
Dialogue: 1,1:59:19.94,1:59:24.15,JPN,,0,0,0,,Әділдіктен тыс
Dialogue: 1,1:59:24.15,1:59:27.31,JPN,,0,0,0,,Мен сенің қолыңды ұстағым келеді
Dialogue: 1,1:59:38.15,1:59:43.69,JPN,,0,0,0,,Маңызды естеліктер есімде жоқ
Dialogue: 1,1:59:44.27,1:59:49.90,JPN,,0,0,0,,Мұндағы сөзбен жеткізу мүмкін емес сезімдер
Dialogue: 1,1:59:50.40,1:59:56.19,JPN,,0,0,0,,мүмкін
Dialogue: 1,1:59:56.52,2:00:01.98,JPN,,0,0,0,,Осының өзі жүректі жасайды.
Dialogue: 1,2:00:02.73,2:00:08.23,JPN,,0,0,0,,мүмкін
Dialogue: 1,2:00:08.90,2:00:14.40,JPN,,0,0,0,,Қазір де жүрегің сені «байқадым» деп тұрғанын сеземін.
Dialogue: 1,2:00:15.06,2:00:17.56,JPN,,0,0,0,,шапалақтау
Dialogue: 1,2:00:32.40,2:00:37.02,JPN,,0,0,0,,Неге жылайсың деген сұраққа жауап беруге болады.
Dialogue: 1,2:00:37.02,2:00:38.52,JPN,,0,0,0,,Көз жасы емес
Dialogue: 1,2:00:38.52,2:00:43.19,JPN,,0,0,0,,Біздің кездесуіміздің мағынасы мынандай
Dialogue: 1,2:00:43.19,2:00:44.60,JPN,,0,0,0,,Қуып жету мүмкін емес
Dialogue: 1,2:00:44.60,2:00:50.77,JPN,,0,0,0,,Бұл айқайдың өзі жеткіліксіз
Dialogue: 1,2:00:50.77,2:00:55.23,JPN,,0,0,0,,Қолыңды ұстағанда ғана қалтырап қалдым
Dialogue: 1,2:00:55.23,2:00:56.98,JPN,,0,0,0,,Менің жүрегім бар еді
Dialogue: 1,2:00:56.98,2:01:01.56,JPN,,0,0,0,,Межелі жерге жеткенше неше мағынаны кесіп өтуіміз керек?
Dialogue: 1,2:01:01.56,2:01:02.98,JPN,,0,0,0,,Оны киюім керек пе?
Dialogue: 1,2:01:02.98,2:01:06.06,JPN,,0,0,0,,Ақымақтық жақсы
Dialogue: 1,2:01:06.06,2:01:09.10,JPN,,0,0,0,,Ұсқындық жарайды
Dialogue: 1,2:01:09.10,2:01:13.31,JPN,,0,0,0,,Әділдіктен тыс
Dialogue: 1,2:01:13.31,2:01:16.85,JPN,,0,0,0,,Мен сенімен бірге тұрғым келеді
