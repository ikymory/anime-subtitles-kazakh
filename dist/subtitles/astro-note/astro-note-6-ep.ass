Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.13,0:00:04.13,Default,,0,0,0,,Тасымалдау аяқталды
Dialogue: 0,0:00:04.13,0:00:06.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:09.14,0:00:11.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:13.14,0:00:15.14,Default,,0,0,0,,Бұл... бұл не?
Dialogue: 0,0:00:15.14,0:00:18.15,Default,,0,0,0,,бұл... ана... ана⁉
Dialogue: 0,0:00:18.15,0:00:20.15,Default,,0,0,0,,Бейне хат...
Dialogue: 0,0:00:20.15,0:00:22.15,Default,,0,0,0,,Құрметті Мира (2 адам) Бақыт...
Dialogue: 0,0:00:22.15,0:00:26.15,Default,,0,0,0,,Менің саған айтпаған сырым бар.
Dialogue: 0,0:00:26.15,0:00:30.16,Default,,0,0,0,,Не? Мен сенен кішкене кіші едім
Dialogue: 0,0:00:30.16,0:00:33.16,Default,,0,0,0,,Мен жай ғана ыңғайлы некені қабылдай алмаймын➡
Dialogue: 0,0:00:33.16,0:00:36.16,Default,,0,0,0,,Мибо планетасынан қашып кеткен
Dialogue: 0,0:00:36.16,0:00:38.17,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:00:38.17,0:00:43.17,Default,,0,0,0,,♬～
Dialogue: 0,0:00:43.17,0:00:45.14,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:00:48.48,0:00:52.51,Default,,0,0,0,,｟Адара Неге? Егер сен маған үйленсең, Мибо планетасы қауіпсіз болады｠
Dialogue: 0,0:00:52.51,0:00:54.18,Default,,0,0,0,,｟Өміріңіздің соңына дейін өзіңізге ұнайтын нәрсені жасаңыз➡
Dialogue: 0,0:00:54.18,0:00:56.49,Default,,0,0,0,,Ешқандай ыңғайсыздықсыз өмір сүре аласыз! ｠
Dialogue: 0,0:00:56.49,0:00:59.49,Default,,0,0,0,,｟Маған ұнамайтын нәрсе ұнамайды! ｠
Dialogue: 0,0:00:59.49,0:01:02.42,Default,,0,0,0,,｟Адара~! ｠
Dialogue: 0,0:01:02.42,0:01:04.13,Default,,0,0,0,,｟Сондай табанды! ｠
Dialogue: 0,0:01:04.13,0:01:12.10,Default,,0,0,0,,♬～
Dialogue: 0,0:01:15.14,0:01:29.15,Default,,0,0,0,,♬～
Dialogue: 0,0:01:29.15,0:01:42.16,Default,,0,0,0,,♬～
Dialogue: 0,0:01:42.16,0:01:53.18,Default,,0,0,0,,♬～
Dialogue: 0,0:01:53.18,0:02:04.12,Default,,0,0,0,,♬～
Dialogue: 0,0:02:04.12,0:02:15.13,Default,,0,0,0,,♬～
Dialogue: 0,0:02:15.13,0:02:21.14,Default,,0,0,0,,♬～
Dialogue: 0,0:02:21.14,0:02:33.15,Default,,0,0,0,,♬～
Dialogue: 0,0:02:33.15,0:02:44.19,Default,,0,0,0,,♬～
Dialogue: 0,0:02:49.10,0:02:52.10,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:52.10,0:02:54.07,Default,,0,0,0,,｟Хахахахаха...｠
Dialogue: 0,0:02:57.11,0:03:01.08,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:03:06.11,0:03:08.08,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:03:14.12,0:03:19.43,Default,,0,0,0,,♬～
Dialogue: 0,0:03:19.43,0:03:21.13,Default,,0,0,0,,｟Уууу…｠
Dialogue: 0,0:03:21.13,0:03:27.14,Default,,0,0,0,,♬～
Dialogue: 0,0:03:27.14,0:03:31.07,Default,,0,0,0,,Мен Тасуке Шимотакайдомен таныстым.
Dialogue: 0,0:03:31.07,0:03:36.08,Default,,0,0,0,,♬～
Dialogue: 0,0:03:36.08,0:03:39.08,Default,,0,0,0,,｟n… Ha⁉｠
Dialogue: 0,0:03:39.08,0:03:47.39,Default,,0,0,0,,♬～
Dialogue: 0,0:03:47.39,0:03:50.09,Default,,0,0,0,,｟n…｠
Dialogue: 0,0:03:50.09,0:04:03.11,Default,,0,0,0,,♬～
Dialogue: 0,0:04:03.11,0:04:07.11,Default,,0,0,0,,Жарақат алғанымда Тасуке-сан маған қамқор болды➡
Dialogue: 0,0:04:07.11,0:04:11.11,Default,,0,0,0,,Ол маған тамақ әзірледі.
Dialogue: 0,0:04:11.11,0:04:14.12,Default,,0,0,0,,Ботқа, тәтті картоп, буға пісірілген тәтті картоп
Dialogue: 0,0:04:14.12,0:04:17.09,Default,,0,0,0,,Барлығы өте дәмді болды.
Dialogue: 0,0:04:20.12,0:04:25.13,Default,,0,0,0,,Ал біз ғашық болып қалдық
Dialogue: 0,0:04:25.13,0:04:27.13,Default,,0,0,0,,Егер біз Жерде осылай өмір сүре алсақ...
Dialogue: 0,0:04:27.13,0:04:30.13,Default,,0,0,0,,...Мен солай ойладым➡
Dialogue: 0,0:04:30.13,0:04:34.07,Default,,0,0,0,,Ол Мибо планетасының ханшайымы болады деп шешілген болатын➡
Dialogue: 0,0:04:34.07,0:04:37.07,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:04:37.07,0:04:40.08,Default,,0,0,0,,Мибо планетасының әскерилері менің орналасқан жерімді анықтады➡
Dialogue: 0,0:04:40.08,0:04:43.08,Default,,0,0,0,,Ол мені алып кетуге келді.
Dialogue: 0,0:04:43.08,0:04:46.08,Default,,0,0,0,,Мен Тасуке-санмен қашуға бел будым.
Dialogue: 0,0:04:46.08,0:04:49.08,Default,,0,0,0,,Қандай жағдай болмасын, мен сенімен бірге болғым келеді.
Dialogue: 0,0:04:49.08,0:04:51.09,Default,,0,0,0,,Мен және Тасуке ➡
Dialogue: 0,0:04:51.09,0:04:53.09,Default,,0,0,0,,Мақсатыма жетуге ниетім бар еді.
Dialogue: 0,0:04:53.09,0:04:56.09,Default,,0,0,0,,...бірақ!
Dialogue: 0,0:04:56.09,0:05:01.10,Default,,0,0,0,,Тағдыр қатыгез, Бұрышта қалдық.
Dialogue: 0,0:05:01.10,0:05:04.10,Default,,0,0,0,,Егер мен Мибо планетасына оралмасам➡
Dialogue: 0,0:05:04.10,0:05:08.10,Default,,0,0,0,,Жер мен жерді кесіп тастаймын дейді.
Dialogue: 0,0:05:08.10,0:05:12.11,Default,,0,0,0,,Біз Мибо планетасының әскері болсақ та, қандай қорқынышты!
Dialogue: 0,0:05:12.11,0:05:15.11,Default,,0,0,0,,«Адара-сан, не болса да, мен істеймін➡
Dialogue: 0,0:05:15.11,0:05:19.11,Default,,0,0,0,,Мен сені осында күтемін».
Dialogue: 0,0:05:19.11,0:05:23.12,Default,,0,0,0,,Менің Мибо планетасына оралудан басқа амалым қалмады.
Dialogue: 0,0:05:23.12,0:05:26.12,Default,,0,0,0,,А... не деген мұңды махаббат хикаясы
Dialogue: 0,0:05:26.12,0:05:28.12,Default,,0,0,0,,Тағдыр жазған екі жас➡
Dialogue: 0,0:05:28.12,0:05:31.39,Default,,0,0,0,,Ол жыртылды.
Dialogue: 0,0:05:31.39,0:05:34.06,Default,,0,0,0,,Мибо планетасының әскері осындай ма? Өте көп
Dialogue: 0,0:05:34.06,0:05:37.07,Default,,0,0,0,,Мені алып кетуге келген Мибо адамдарынан құпия ұстадым➡
Dialogue: 0,0:05:37.07,0:05:40.07,Default,,0,0,0,,Мен кілттерімді Жерде қалдыруды шештім.
Dialogue: 0,0:05:40.07,0:05:42.07,Default,,0,0,0,,Неліктен⁉ "Неге"➡
Dialogue: 0,0:05:42.07,0:05:45.07,Default,,0,0,0,,Дәл қазір сіздің ойыңызда осы екеніне сенімдімін.
Dialogue: 0,0:05:45.07,0:05:47.08,Default,,0,0,0,,Кілт жерде болғанша➡
Dialogue: 0,0:05:47.08,0:05:50.08,Default,,0,0,0,,Мен Жерге қайта бара аламын
Dialogue: 0,0:05:50.08,0:05:53.08,Default,,0,0,0,,Тасуке-санмен кездесуге болады.
Dialogue: 0,0:05:53.08,0:05:57.09,Default,,0,0,0,,Мәртебелі, бұл неге сіздің кіші аватарыңыз?
Dialogue: 0,0:05:57.09,0:06:00.09,Default,,0,0,0,,Алайда, көп ұзамай мен сені алып кетемін➡
Dialogue: 0,0:06:00.09,0:06:03.06,Default,,0,0,0,,Мен жүкті екенімді білдім.
Dialogue: 0,0:06:05.09,0:06:08.10,Default,,0,0,0,,Мира сенің нағыз әкең➡
Dialogue: 0,0:06:08.10,0:06:12.10,Default,,0,0,0,,Бұл Тайсуке Шимотакайдо, жерлік.
Dialogue: 0,0:06:12.10,0:06:14.10,Default,,0,0,0,,Ха... иә!?
Dialogue: 0,0:06:14.10,0:06:18.11,Default,,0,0,0,,Мәртебелі, сіздің патронаттық әкеңіз мұның бәрін білетін.
Dialogue: 0,0:06:18.11,0:06:22.11,Default,,0,0,0,,Ол мұны біліп, маған үйленді.
Dialogue: 0,0:06:22.11,0:06:24.11,Default,,0,0,0,,Неге қазір олай айтып отырсың?
Dialogue: 0,0:06:24.11,0:06:27.12,Default,,0,0,0,,«Неге қазір олай айтып отырсың?» ➡
Dialogue: 0,0:06:27.12,0:06:30.12,Default,,0,0,0,,Дәл қазір сіздің ойыңызда осы екеніне сенімдімін.
Dialogue: 0,0:06:30.12,0:06:34.06,Default,,0,0,0,,Бірде бірдеңе айтқым келді, бірақ айта алмаймын➡
Dialogue: 0,0:06:34.06,0:06:36.06,Default,,0,0,0,,Таққа отыруыңыз үшін➡
Dialogue: 0,0:06:36.06,0:06:39.06,Default,,0,0,0,,Мен кілтті қажет ететін жасқа келдім.
Dialogue: 0,0:06:39.06,0:06:43.06,Default,,0,0,0,,Әрине, мен Мәртебелін жақсы көрдім, бірақ➡
Dialogue: 0,0:06:43.06,0:06:47.07,Default,,0,0,0,,Мен Тасуке мырзаны ешқашан ұмытқан емеспін...
Dialogue: 0,0:06:47.07,0:06:50.07,Default,,0,0,0,,Мәртебелі, сіз өте театршылсыз.
Dialogue: 0,0:06:50.07,0:06:52.07,Default,,0,0,0,,Әдемі хикаяға ұқсатуға тырысамын➡
Dialogue: 0,0:06:52.07,0:06:55.08,Default,,0,0,0,,Басқаша айтқанда, ол жай ғана үйден қашып, еркекпен жыныстық қатынасқа түскен.
Dialogue: 0,0:06:55.08,0:06:57.08,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:57.08,0:06:59.08,Default,,0,0,0,,Сен қазір анаңмен сөйлесіп тұрғаныңа сенімдімін.
Dialogue: 0,0:06:59.08,0:07:02.08,Default,,0,0,0,,Сіз бір-екі қарғыс сөз айтқан шығарсыз➡
Dialogue: 0,0:07:02.08,0:07:05.09,Default,,0,0,0,,Бұл факт
Dialogue: 0,0:07:05.09,0:07:07.09,Default,,0,0,0,,《Мибо адамдары...》
Dialogue: 0,0:07:07.09,0:07:10.09,Default,,0,0,0,,《Бөлмеден ер адамның дауысы естілді...》
Dialogue: 0,0:07:10.09,0:07:14.10,Default,,0,0,0,,Менің ойымша, сіз дәл қазір кілтті іздеп жатырсыз...
Dialogue: 0,0:07:14.10,0:07:18.10,Default,,0,0,0,,Гошиттер⁉ Бұған дейін мен Жерде болдым...
Dialogue: 0,0:07:18.10,0:07:20.10,Default,,0,0,0,,Гошиттер?
Dialogue: 0,0:07:20.10,0:07:22.10,Default,,0,0,0,,Әрине, сіз қазірсіз➡
Dialogue: 0,0:07:22.10,0:07:25.11,Default,,0,0,0,,Жердің диетасы сізді таң қалдырады ма?
Dialogue: 0,0:07:25.11,0:07:27.11,Default,,0,0,0,,Сіз буға пісірілген тәтті картопты жеп қойдыңыз ба?
Dialogue: 0,0:07:27.11,0:07:30.11,Default,,0,0,0,,Тасуке жасаған таңғы ас
Dialogue: 0,0:07:30.11,0:07:33.05,Default,,0,0,0,,Грильде пісірілген балық Картоп ботқасы Шпинат суы
Dialogue: 0,0:07:33.05,0:07:38.05,Default,,0,0,0,,Мисо сорпасы Кружкадан жасалған Оданго тұздылары
Dialogue: 0,0:07:38.05,0:07:40.06,Default,,0,0,0,,Эй Шоин, мені ұста!
Dialogue: 0,0:07:40.06,0:07:42.02,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:07:44.06,0:07:47.03,Default,,0,0,0,,Ұпай! Қанша!
Dialogue: 0,0:07:49.06,0:07:56.07,Default,,0,0,0,,♪ (Байлықтың ызыңы)
Dialogue: 0,0:07:56.07,0:08:00.08,Default,,0,0,0,,Мм... Вакабаяши мырза, сіз не істеп жатырсыз?
Dialogue: 0,0:08:00.08,0:08:02.08,Default,,0,0,0,,Күріш карри
Dialogue: 0,0:08:02.08,0:08:04.08,Default,,0,0,0,,Өйткені лотос оны жегісі келеді.
Dialogue: 0,0:08:04.08,0:08:08.08,Default,,0,0,0,,Бұл Тасуке жиі жасайтын рецепт.
Dialogue: 0,0:08:08.08,0:08:10.09,Default,,0,0,0,,Иә!?
Dialogue: 0,0:08:10.09,0:08:12.09,Default,,0,0,0,,Мұны Вустершир соусымен жеп қойыңыз➡
Dialogue: 0,0:08:12.09,0:08:15.09,Default,,0,0,0,,Бұл Тасукенің күріш карри стилі.
Dialogue: 0,0:08:15.09,0:08:17.09,Default,,0,0,0,,Ху~ Дәмді көрінеді
Dialogue: 0,0:08:17.09,0:08:21.10,Default,,0,0,0,,Мен біраз уақытқа тезекке барамын, сіз карриді бақылай аласыз ба?
Dialogue: 0,0:08:21.10,0:08:23.10,Default,,0,0,0,,Иә
Dialogue: 0,0:08:23.10,0:08:25.07,Default,,0,0,0,,Пайдасыз қарсылығыңызды тоқтатып, шығыңыз!
Dialogue: 0,0:08:27.10,0:08:30.11,Default,,0,0,0,,Мүмкін мен де байқап көрермін.
Dialogue: 0,0:08:30.11,0:08:33.11,Default,,0,0,0,,⚟Уақыт ағымы Жер мен Мибо планетасы арасында әртүрлі.
Dialogue: 0,0:08:33.11,0:08:38.11,Default,,0,0,0,,⚟ Мибодағы бір жыл жердегі үш жыл.
Dialogue: 0,0:08:38.11,0:08:41.12,Default,,0,0,0,,⚟ Сен де менен үлкен болғанша➡
Dialogue: 0,0:08:41.12,0:08:45.12,Default,,0,0,0,,Кілтті алып, Мибо планетасына оралыңыз.
Dialogue: 0,0:08:45.12,0:08:48.12,Default,,0,0,0,,Хмф! Мибо планетасы мен ғаламның тыныштығы үшін
Dialogue: 0,0:08:48.12,0:08:54.13,Default,,0,0,0,,Кілттен түсетін жарық сізді кілт орналасқан жерге бағыттауы керек.
Dialogue: 0,0:08:54.13,0:08:58.10,Default,,0,0,0,,Тасуке орнын ауыстырмағанда, бақшада болар еді...
Dialogue: 0,0:09:02.14,0:09:05.11,Default,,0,0,0,,Ачи, ачи, а... Шөміш!
Dialogue: 0,0:09:07.14,0:09:10.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:10.15,0:09:12.11,Default,,0,0,0,,Ах... бұл қауіпті!
Dialogue: 0,0:09:14.15,0:09:16.15,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:16.15,0:09:19.15,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:09:19.15,0:09:21.16,Default,,0,0,0,,Құрметті ана
Dialogue: 0,0:09:21.16,0:09:25.16,Default,,0,0,0,,Анасы Тасукенің карриіне батып, жарылыстан қайтыс болды.
Dialogue: 0,0:09:25.16,0:09:29.16,Default,,0,0,0,,Тіпті берекелі болмайтын нәрселерді айтпа. Бұл факт.
Dialogue: 0,0:09:29.16,0:09:34.10,Default,,0,0,0,,Бұл Тасуке Шимотакайдо Мираның нағыз әкесі ме?
Dialogue: 0,0:09:34.10,0:09:37.11,Default,,0,0,0,,Кенеттен осылай айтсаң да, мен қиналамын.
Dialogue: 0,0:09:37.11,0:09:39.11,Default,,0,0,0,,Негізгі кеңес - бақ
Dialogue: 0,0:09:39.11,0:09:42.11,Default,,0,0,0,,Бұл туралы гошиттер де білген шығар.
Dialogue: 0,0:09:42.11,0:09:45.11,Default,,0,0,0,,Ол да кілттің жарығы маған жол көрсетеді➡ деді
Dialogue: 0,0:09:45.11,0:09:47.12,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:47.12,0:09:50.12,Default,,0,0,0,,...және? ол не істейді? Ах! Мен ұмыттым
Dialogue: 0,0:09:50.12,0:09:53.12,Default,,0,0,0,,Сіз қатты есеңгіреп тұрған сияқтысыз.
Dialogue: 0,0:09:53.12,0:09:56.12,Default,,0,0,0,,Мен біртүрлі түс көріп тұрған шығармын
Dialogue: 0,0:09:56.12,0:09:59.13,Default,,0,0,0,,Дұрыс, иттер сөйлей алмайды.
Dialogue: 0,0:09:59.13,0:10:01.13,Default,,0,0,0,,Бұл шындық.
Dialogue: 0,0:10:01.13,0:10:03.13,Default,,0,0,0,,Кешіріңіз, бірақ көргеніңіз➡
Dialogue: 0,0:10:03.13,0:10:06.13,Default,,0,0,0,,Ешкімге айтпасаңыз, мен риза болар едім.
Dialogue: 0,0:10:06.13,0:10:11.14,Default,,0,0,0,,Жарайды, егер мен бұлай айтсам, мені біртүрлі адам ретінде қабылдайды деп ойлаймын.
Dialogue: 0,0:10:11.14,0:10:13.14,Default,,0,0,0,,Мибо адамдары…
Dialogue: 0,0:10:13.14,0:10:19.15,Default,,0,0,0,,Иә, біз Мибо планетасының Мибо адамдарымыз.
Dialogue: 0,0:10:19.15,0:10:21.15,Default,,0,0,0,,Мира Мибодан...
Dialogue: 0,0:10:21.15,0:10:23.15,Default,,0,0,0,,Мен де
Dialogue: 0,0:10:23.15,0:10:27.16,Default,,0,0,0,,Күйеуі – кальмар, ал бөлмедегі адам – ит...
Dialogue: 0,0:10:27.16,0:10:31.09,Default,,0,0,0,,Кук... хехехехе...
Dialogue: 0,0:10:31.09,0:10:33.09,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:10:33.09,0:10:38.10,Default,,0,0,0,,Дұрыс! Жесір емес, Мибо адамы.
Dialogue: 0,0:10:38.10,0:10:42.10,Default,,0,0,0,,Не! Ахах... ахахха...
Dialogue: 0,0:10:42.10,0:10:44.11,Default,,0,0,0,,Миясака мырза?
Dialogue: 0,0:10:44.11,0:10:47.08,Default,,0,0,0,,Ол жақсы ма? Ах...
Dialogue: 0,0:10:49.11,0:10:53.11,Default,,0,0,0,,Сен оны бақшаға жерледің бе? (Көрсету) Бір шетінен қазып ал?
Dialogue: 0,0:10:53.11,0:10:55.12,Default,,0,0,0,,Мира! иә?
Dialogue: 0,0:10:55.12,0:10:58.12,Default,,0,0,0,,А, кешіріңіз, не?
Dialogue: 0,0:10:58.12,0:11:00.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:00.12,0:11:02.09,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:11:05.13,0:11:07.13,Default,,0,0,0,,Масакичи мырзаның алдында➡
Dialogue: 0,0:11:07.13,0:11:12.13,Default,,0,0,0,,Тасуке бұл жерде жиі отырып, жұлдыздарға қарайтынын айтады...
Dialogue: 0,0:11:12.13,0:11:17.14,Default,,0,0,0,,Тасуке осы пәтердегі бөлмесінде есінен танып қалды.
Dialogue: 0,0:11:17.14,0:11:21.14,Default,,0,0,0,,Бұл сенбі, таңғы ассыз күн➡
Dialogue: 0,0:11:21.14,0:11:24.15,Default,,0,0,0,,Түнге дейін ешкім байқамады
Dialogue: 0,0:11:24.15,0:11:27.15,Default,,0,0,0,,Бұл елде қарттар жалғыз өледі➡
Dialogue: 0,0:11:27.15,0:11:30.15,Default,,0,0,0,,Жалғыз өлу деп аталады.
Dialogue: 0,0:11:30.15,0:11:35.09,Default,,0,0,0,,Анаңды осында күткен шығарсың...
Dialogue: 0,0:11:35.09,0:11:37.09,Default,,0,0,0,,Бейшара Тасуке...
Dialogue: 0,0:11:37.09,0:11:42.10,Default,,0,0,0,,Мира, дайындал. Бұл сентиментальды уақыт емес.
Dialogue: 0,0:11:42.10,0:11:46.10,Default,,0,0,0,,Мираның әкесі кім болса да, Мира тақ мұрагері➡
Dialogue: 0,0:11:46.10,0:11:49.10,Default,,0,0,0,,Ғаламның тыныштығы Мираға байланысты.
Dialogue: 0,0:11:49.10,0:11:51.11,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:11:51.11,0:11:54.11,Default,,0,0,0,,Мен бұл ғимаратты тағы да зерттеймін.
Dialogue: 0,0:11:54.11,0:11:57.11,Default,,0,0,0,,Мира, қазір қолыңнан келгенін істе.
Dialogue: 0,0:11:57.11,0:12:00.11,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:12:00.11,0:12:03.12,Default,,0,0,0,,Бұл шынымен де солай ма? Иә?
Dialogue: 0,0:12:03.12,0:12:07.12,Default,,0,0,0,,Тасуке Шимотакайдоны аядың ба?
Dialogue: 0,0:12:07.12,0:12:09.16,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:12:11.06,0:12:14.06,Default,,0,0,0,,(Шығу белгісінің дыбысы)
Dialogue: 0,0:12:14.06,0:12:16.06,Default,,0,0,0,,Тасуке туралы көбірек білгіңіз келе ме?
Dialogue: 0,0:12:16.06,0:12:20.07,Default,,0,0,0,,Иә, оның қандай адам екені мені қызықтырды.
Dialogue: 0,0:12:20.07,0:12:23.07,Default,,0,0,0,,Әй, адамдар...Қызық, бұл қандай?
Dialogue: 0,0:12:23.07,0:12:26.07,Default,,0,0,0,,Хе хе хе хе хе хе хе хе... Иә?
Dialogue: 0,0:12:26.07,0:12:33.38,Default,,0,0,0,,Тасуке-санның құлап жатқанын мен таптым...
Dialogue: 0,0:12:33.38,0:12:36.38,Default,,0,0,0,,｟Тасуке-сан! Тұрақты! ｠
Dialogue: 0,0:12:36.38,0:12:41.09,Default,,0,0,0,,｟Не? Тасуке-сан, бұл не? ｠
Dialogue: 0,0:12:41.09,0:12:43.09,Default,,0,0,0,,｟Шайқау…｠
Dialogue: 0,0:12:43.09,0:12:48.10,Default,,0,0,0,,Соңына дейін таңғы ас туралы ойлады.
Dialogue: 0,0:12:48.10,0:12:51.10,Default,,0,0,0,,Адамдардың дәмді тағам жегенін көру➡
Dialogue: 0,0:12:51.10,0:12:53.10,Default,,0,0,0,,Ол мен көргенді ұнататын адам болды.
Dialogue: 0,0:12:53.10,0:12:56.10,Default,,0,0,0,,Ол солай болды.
Dialogue: 0,0:12:56.10,0:12:58.11,Default,,0,0,0,,Сәлем Тасуке...
Dialogue: 0,0:12:58.11,0:13:01.04,Default,,0,0,0,,Ааа, енді ойлап отырсам, жұмыстан кеш қайтқанда➡
Dialogue: 0,0:13:01.04,0:13:03.04,Default,,0,0,0,,Себебі мен компьютерде бірдеңе көріп отырдым➡
Dialogue: 0,0:13:03.04,0:13:07.05,Default,,0,0,0,,Мен тіпті атам эротикалық бейнелерді қарайды ма деп ойладым?
Dialogue: 0,0:13:07.05,0:13:11.05,Default,,0,0,0,,Бұл тиіннің үнемі бірдеңе жеп жатқаны бейнеленген.
Dialogue: 0,0:13:11.05,0:13:13.05,Default,,0,0,0,,Түнде су ішуге ас үйге барғанда➡
Dialogue: 0,0:13:13.05,0:13:15.06,Default,,0,0,0,,Мен оны әлі қарап отырдым.
Dialogue: 0,0:13:15.06,0:13:19.06,Default,,0,0,0,,Мен тиіннің 3 сағатқа жуық тамақ ішкенін көрдім.
Dialogue: 0,0:13:19.06,0:13:22.06,Default,,0,0,0,,Менің ойымша, Тасуке бұзық болған шығар.
Dialogue: 0,0:13:22.06,0:13:24.07,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:13:24.07,0:13:28.07,Default,,0,0,0,,Бұл да сүйкімді болды, маған ұнады.
Dialogue: 0,0:13:28.07,0:13:30.07,Default,,0,0,0,,Тасуке ата туралы
Dialogue: 0,0:13:30.07,0:13:34.08,Default,,0,0,0,,Мен мұның неліктен болғанын білгім келеді.
Dialogue: 0,0:13:34.08,0:13:36.08,Default,,0,0,0,,Ах... м...
Dialogue: 0,0:13:36.08,0:13:38.08,Default,,0,0,0,,Рен: Бұл менің әкем кінәлі.
Dialogue: 0,0:13:38.08,0:13:41.08,Default,,0,0,0,,Мен Мира-санға біраз уақыт карри қарауын өтіндім.
Dialogue: 0,0:13:41.08,0:13:44.09,Default,,0,0,0,,Мен сұрағаным үшін ғана (Рен) Бұл солай бола ма?
Dialogue: 0,0:13:44.09,0:13:46.09,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:13:46.09,0:13:48.09,Default,,0,0,0,,Миясака-кун келгенге дейінгі таңғы ас апаты.
Dialogue: 0,0:13:48.09,0:13:51.09,Default,,0,0,0,,Нарука кешіріңіз
Dialogue: 0,0:13:51.09,0:13:53.09,Default,,0,0,0,,Бұл күріш карри болды ма?
Dialogue: 0,0:13:53.09,0:13:55.10,Default,,0,0,0,,Бұл Тасуке-санның рецепті еді, солай ма?
Dialogue: 0,0:13:55.10,0:13:57.10,Default,,0,0,0,,Бұл өте дәмді!
Dialogue: 0,0:13:57.10,0:13:59.10,Default,,0,0,0,,Әке компьютерде➡
Dialogue: 0,0:13:59.10,0:14:02.04,Default,,0,0,0,,Tokyo Girls Festival бейнесін көре аламын ба?
Dialogue: 0,0:14:02.04,0:14:05.04,Default,,0,0,0,,Үй тапсырмасын орындаған соң (Рен) Иә!
Dialogue: 0,0:14:05.04,0:14:07.04,Default,,0,0,0,,Бұл небәрі 30 минут.
Dialogue: 0,0:14:07.04,0:14:11.05,Default,,0,0,0,,Вакабаяши мырза бұл рецептті неге біледі?
Dialogue: 0,0:14:11.05,0:14:14.05,Default,,0,0,0,,Мені оқытты
Dialogue: 0,0:14:14.05,0:14:18.05,Default,,0,0,0,,Тасуке-сан екі қолын сындырғанда, мен оған түрлі рецепттер бердім.
Dialogue: 0,0:14:18.05,0:14:21.06,Default,,0,0,0,,Сондай-ақ, Тортан Талон т.б.
Dialogue: 0,0:14:21.06,0:14:23.06,Default,,0,0,0,,Лехон Кавари т.б.
Dialogue: 0,0:14:23.06,0:14:26.06,Default,,0,0,0,,Гало-гало, т.б. Бір минут күтіңіз.
Dialogue: 0,0:14:26.06,0:14:30.06,Default,,0,0,0,,Мені қызықтыратын дүниелер көп...
Dialogue: 0,0:14:30.06,0:14:33.07,Default,,0,0,0,,Тайсуке мырза, сіз екі қолыңызды сындырдыңыз ба?
Dialogue: 0,0:14:33.07,0:14:35.07,Default,,0,0,0,,Дұрыс, хабаре үйірмесіне барғанымда.
Dialogue: 0,0:14:35.07,0:14:37.07,Default,,0,0,0,,Кабакура?
Dialogue: 0,0:14:37.07,0:14:41.08,Default,,0,0,0,,Қыздармен ішімдік ішіп көңіл көтеретін жер.
Dialogue: 0,0:14:41.08,0:14:44.08,Default,,0,0,0,,Сондықтан мен қызды ханшайымға ұқсатуға тырыстым➡
Dialogue: 0,0:14:44.08,0:14:46.08,Default,,0,0,0,,Екі қол бұрынғыдай сынған
Dialogue: 0,0:14:46.08,0:14:49.08,Default,,0,0,0,,Сіз ақымақсыз ба? Күрсін...
Dialogue: 0,0:14:49.08,0:14:52.09,Default,,0,0,0,,Тортан Талон немесе Гало-гало туралы не деуге болады?
Dialogue: 0,0:14:52.09,0:14:54.09,Default,,0,0,0,,Бұл филиппиндік тағам.
Dialogue: 0,0:14:54.09,0:14:57.09,Default,,0,0,0,,Филиппиндік пабқа анда-санда тәуелді болыңыз.
Dialogue: 0,0:14:57.09,0:14:59.09,Default,,0,0,0,,Ах, филиппиндік паб дегеніміз не?
Dialogue: 0,0:14:59.09,0:15:03.03,Default,,0,0,0,,Бұл әдемі филиппиндіктер жұмыс істейтін паб.
Dialogue: 0,0:15:03.03,0:15:08.04,Default,,0,0,0,,Адамдар филиппиндік тағамдарды әкелгенімді өте бағалайды.
Dialogue: 0,0:15:08.04,0:15:11.04,Default,,0,0,0,,Мені де талай рет алып кетті➡
Dialogue: 0,0:15:11.04,0:15:14.04,Default,,0,0,0,,Тасуке-сан кеуделі жат адам еді.
Dialogue: 0,0:15:14.04,0:15:16.04,Default,,0,0,0,,Бөтен кеуде?
Dialogue: 0,0:15:16.04,0:15:19.05,Default,,0,0,0,,Мен үлкен кеуделі қыздарды жақсы көремін.
Dialogue: 0,0:15:19.05,0:15:22.05,Default,,0,0,0,,Өте қызық болды.
Dialogue: 0,0:15:22.05,0:15:24.05,Default,,0,0,0,,Тасуке тірі болса➡
Dialogue: 0,0:15:24.05,0:15:27.05,Default,,0,0,0,,Мен сені вокзал алдында ашылған сыраханаға апарғым келді.
Dialogue: 0,0:15:27.05,0:15:29.06,Default,,0,0,0,,А, сырахана ше?
Dialogue: 0,0:15:29.06,0:15:32.06,Default,,0,0,0,,Жарайды, мен оны қалай да түсіндім.
Dialogue: 0,0:15:32.06,0:15:34.06,Default,,0,0,0,,⚟(Жеткізуші) Курьер арқылы.
Dialogue: 0,0:15:34.06,0:15:37.06,Default,,0,0,0,,Тасуке Шимотакайдоға арналған. иә?
Dialogue: 0,0:15:37.06,0:15:39.07,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:15:39.07,0:15:42.04,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:15:45.07,0:15:47.07,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:15:47.07,0:15:49.08,Default,,0,0,0,,Амансың ба? Мен рұқсатсыз аштым
Dialogue: 0,0:15:49.08,0:15:52.08,Default,,0,0,0,,Жарайды, жарайды, мына Акита-сан...
Dialogue: 0,0:15:52.08,0:15:56.08,Default,,0,0,0,,Ол бұрын Асторо манорында тұрған.
Dialogue: 0,0:15:56.08,0:15:58.09,Default,,0,0,0,,Ой, жүгері!
Dialogue: 0,0:15:58.09,0:16:01.02,Default,,0,0,0,,Акита мырзаға Тасуке мырзаның қайтыс болғаны хабарланды➡
Dialogue: 0,0:16:01.02,0:16:04.03,Default,,0,0,0,,Сіз білесіз бе? Иә әрине
Dialogue: 0,0:16:04.03,0:16:06.03,Default,,0,0,0,,Баяғыда, бұл жер Асунаро-со➡ болған кезде
Dialogue: 0,0:16:06.03,0:16:08.03,Default,,0,0,0,,Онда тұрған адамдар➡
Dialogue: 0,0:16:08.03,0:16:12.03,Default,,0,0,0,,Қиындыққа ұшыраған студенттер сияқты күнкөрістерін әрең табатын адамдар.
Dialogue: 0,0:16:12.03,0:16:15.04,Default,,0,0,0,,Мұндай адамдар тек жақсылығын қайтарады➡
Dialogue: 0,0:16:15.04,0:16:17.04,Default,,0,0,0,,Олар маған тамақ жібереді.
Dialogue: 0,0:16:17.04,0:16:20.04,Default,,0,0,0,,Акита-саннан басқа да көптеген адамдар бар.
Dialogue: 0,0:16:20.04,0:16:24.05,Default,,0,0,0,,Көп адамға Тасуке көмектесті!
Dialogue: 0,0:16:24.05,0:16:28.05,Default,,0,0,0,,Міне, мен де солардың бірімін.
Dialogue: 0,0:16:28.05,0:16:32.05,Default,,0,0,0,,Тасуке мырза? Мен оның жақсы адам екеніне сенімдімін.
Dialogue: 0,0:16:32.05,0:16:35.06,Default,,0,0,0,,Айналадағылардың бәрі саған қарыздар емес пе?
Dialogue: 0,0:16:35.06,0:16:37.06,Default,,0,0,0,,Ешкімге жаман сөз жоқ.
Dialogue: 0,0:16:37.06,0:16:40.06,Default,,0,0,0,,Жоқ, мен оны кешірмеймін.
Dialogue: 0,0:16:40.06,0:16:42.06,Default,,0,0,0,,Біз шоги➡ ойнадық
Dialogue: 0,0:16:42.06,0:16:45.07,Default,,0,0,0,,Жеңіспен ғана кетпеңіз.
Dialogue: 0,0:16:45.07,0:16:48.07,Default,,0,0,0,,Мен сонда барамын, сондықтан мені күтіңіз, қария!
Dialogue: 0,0:16:48.07,0:16:52.07,Default,,0,0,0,,Мен кейде киініп, раушан гүлін немесе бір нәрсені сатып аламын.
Dialogue: 0,0:16:52.07,0:16:55.08,Default,,0,0,0,,Ол жағымсыз нәрсе жасаған болуы керек, солай ма?
Dialogue: 0,0:16:55.08,0:16:58.08,Default,,0,0,0,,Бұл мүмкін, өйткені ол адам ақымақ болған.
Dialogue: 0,0:16:58.08,0:17:00.08,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:17:00.08,0:17:02.08,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:17:02.08,0:17:04.09,Default,,0,0,0,,Тасуке Шимотакайдо бұл➡
Dialogue: 0,0:17:04.09,0:17:07.09,Default,,0,0,0,,Маған әрқашан тірі заттардың жегенін көрген ұнайды➡
Dialogue: 0,0:17:07.09,0:17:10.09,Default,,0,0,0,,Ей, мен кеуделі бөтен адаммын!
Dialogue: 0,0:17:10.09,0:17:13.09,Default,,0,0,0,,Тасуке-санды аямау керек деп ойлаймын.
Dialogue: 0,0:17:13.09,0:17:15.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:15.10,0:17:18.10,Default,,0,0,0,,Шындықты адамның өзі ғана біледі➡
Dialogue: 0,0:17:18.10,0:17:21.10,Default,,0,0,0,,Оны бәрі жақсы көргені рас.
Dialogue: 0,0:17:21.10,0:17:25.11,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:17:25.11,0:17:28.11,Default,,0,0,0,,Рахмет Шоин
Dialogue: 0,0:17:28.11,0:17:33.11,Default,,0,0,0,,♬～
Dialogue: 0,0:17:33.11,0:17:35.08,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:17:39.12,0:17:42.12,Default,,0,0,0,,Қараңызшы, ол да дәмсіз және иіссіз, солай ма?
Dialogue: 0,0:17:42.12,0:17:44.13,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:17:44.13,0:17:46.09,Default,,0,0,0,,⚟ Иә?
Dialogue: 0,0:17:52.13,0:17:56.14,Default,,0,0,0,,Мм... бұл өткен күні болды.
Dialogue: 0,0:17:56.14,0:17:59.14,Default,,0,0,0,,Жарайды, ешкімге айтқан жоқпын.
Dialogue: 0,0:17:59.14,0:18:02.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:02.08,0:18:06.08,Default,,0,0,0,,Ум... жақсысың ба?
Dialogue: 0,0:18:06.08,0:18:09.08,Default,,0,0,0,,Мм... Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:18:09.08,0:18:13.09,Default,,0,0,0,,Миясака мырза: Бұл әдеттегіден басқаша.
Dialogue: 0,0:18:13.09,0:18:16.09,Default,,0,0,0,,Жарайды ма деп ойладым...
Dialogue: 0,0:18:16.09,0:18:18.09,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:18.09,0:18:20.09,Default,,0,0,0,,Мен көремін. Жақсы.
Dialogue: 0,0:18:20.09,0:18:22.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:31.11,0:18:35.08,Default,,0,0,0,,《Мүлдем болмады...》
Dialogue: 0,0:18:37.11,0:18:41.12,Default,,0,0,0,,《Мира-сан – Мибо планетасындағы Мибо адамы》
Dialogue: 0,0:18:41.12,0:18:45.12,Default,,0,0,0,,《Демек, сен бөтен адамсың, солай ма? 》
Dialogue: 0,0:18:45.12,0:18:49.12,Default,,0,0,0,,《Олар адамдарға осылай шабуыл жасайды ма? 》
Dialogue: 0,0:18:49.12,0:18:51.13,Default,,0,0,0,,《Мибо планетасының Мибо халқы
Dialogue: 0,0:18:51.13,0:18:55.13,Default,,0,0,0,,Бұл менің миым түсінетін нәрседен әлдеқайда көп.
Dialogue: 0,0:18:55.13,0:18:58.13,Default,,0,0,0,,《Ол әлі күйеуінен айырылған жесір.
Dialogue: 0,0:18:58.13,0:19:01.07,Default,,0,0,0,,Айтуың керек еді, қарғыс атсын! 》
Dialogue: 0,0:19:01.07,0:19:04.07,Default,,0,0,0,,Хэхехехе... Ой, бұл Миясака-кун емес. Қалдарыңыз қалай?
Dialogue: 0,0:19:04.07,0:19:07.07,Default,,0,0,0,,Бозарып кеткен сияқтысың, жақсысың ба?
Dialogue: 0,0:19:07.07,0:19:09.08,Default,,0,0,0,,Енді ойлап қарасам, Мира-чан кеше
Dialogue: 0,0:19:09.08,0:19:11.08,Default,,0,0,0,,Бұл сіздің сұлу жігітіңіз бе, Шоин мырза?
Dialogue: 0,0:19:11.08,0:19:16.08,Default,,0,0,0,,Біз кездесуде болдық, бірақ менің ойымша, ол адам махаббат қонақүйінде болды.
Dialogue: 0,0:19:16.08,0:19:20.09,Default,,0,0,0,,Ой! Миясака-кун, бүгін бізде жанды сегізаяқ бар.
Dialogue: 0,0:19:20.09,0:19:23.09,Default,,0,0,0,,Шоин мырза, сіз британдықсыз ба?
Dialogue: 0,0:19:23.09,0:19:26.09,Default,,0,0,0,,Президент энергиямен бірдеңе істеп жатыр➡
Dialogue: 0,0:19:26.09,0:19:30.10,Default,,0,0,0,,Мәртебесі де, абыройы да, ақшасы да бар, түрі де сондай!
Dialogue: 0,0:19:30.10,0:19:32.10,Default,,0,0,0,,Мира-чан, сен жақсы адамды ұстап алдың.
Dialogue: 0,0:19:32.10,0:19:35.10,Default,,0,0,0,,Мира-чан мен Шоуин-сан бірге өте жақсы көрінеді, солай емес пе?
Dialogue: 0,0:19:35.10,0:19:37.10,Default,,0,0,0,,Олар тамаша жұп.
Dialogue: 0,0:19:37.10,0:19:39.11,Default,,0,0,0,,А, кәмпит жегің келе ме?
Dialogue: 0,0:19:39.11,0:19:42.11,Default,,0,0,0,,Шоин Мираның жігіті емес➡
Dialogue: 0,0:19:42.11,0:19:45.11,Default,,0,0,0,,Бұл махаббат қонақ үйі емес, британдық емес!
Dialogue: 0,0:19:45.11,0:19:48.12,Default,,0,0,0,,Не? Сонда қанша адам?
Dialogue: 0,0:19:48.12,0:19:52.12,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:19:52.12,0:19:55.12,Default,,0,0,0,,Хмм... соның бәрін маған бер!
Dialogue: 0,0:19:55.12,0:19:57.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:57.12,0:19:59.13,Default,,0,0,0,,《Мира-сан - мибо тұлғасы➡
Dialogue: 0,0:19:59.13,0:20:02.06,Default,,0,0,0,,Мен де Наосукенің сөйлей алатынына таң қалдым➡
Dialogue: 0,0:20:02.06,0:20:05.07,Default,,0,0,0,,Менің жүрегімді ең көп тебірентетін нәрсе –➡
Dialogue: 0,0:20:05.07,0:20:08.07,Default,,0,0,0,,Соин да Мибо! 》
Dialogue: 0,0:20:08.07,0:20:10.04,Default,,0,0,0,,Ммм... Нмм...
Dialogue: 0,0:20:14.08,0:20:16.08,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:20:16.08,0:20:20.08,Default,,0,0,0,,Не? Бұл сегізаяқ!
Dialogue: 0,0:20:20.08,0:20:22.05,Default,,0,0,0,,Сегізаяқ?
Dialogue: 0,0:20:29.09,0:20:33.09,Default,,0,0,0,,Миясака мырза, жақсысыз ба?
Dialogue: 0,0:20:33.09,0:20:35.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.10,0:20:46.11,Default,,0,0,0,,⚟ Миясака-кун, мен біраз уайымдап тұрмын.
Dialogue: 0,0:20:46.11,0:20:48.11,Default,,0,0,0,,⚟ Бұл жай ғана әңгіме➡
Dialogue: 0,0:20:48.11,0:20:52.11,Default,,0,0,0,,Сізді алаңдататын нәрсе көп сияқты.
Dialogue: 0,0:20:52.11,0:20:56.12,Default,,0,0,0,,Маған қарқынды өзгерту керек сияқты.
Dialogue: 0,0:20:56.12,0:20:58.12,Default,,0,0,0,,⚟ Уайымдамайсың ба?
Dialogue: 0,0:20:58.12,0:21:02.06,Default,,0,0,0,,Мен не істеуім керек? ⚟ Қараңызшы, ол бар.
Dialogue: 0,0:21:02.06,0:21:06.06,Default,,0,0,0,,⚟ Қызық көрінетін жерлерге бірге баруға қалай қарайсыз?
Dialogue: 0,0:21:06.06,0:21:08.06,Default,,0,0,0,,Қызықтырасыз ба?
Dialogue: 0,0:21:08.06,0:21:11.07,Default,,0,0,0,,Фильмдер, демалыс күндері өткізілетін іс-шаралар және т.б.
Dialogue: 0,0:21:11.07,0:21:14.07,Default,,0,0,0,,Мені барғым келетін жерге шақыру туралы не айтасыз?
Dialogue: 0,0:21:14.07,0:21:18.04,Default,,0,0,0,,Қалай? ⚟"Менімен бірге барғың келе ме?"
Dialogue: 0,0:21:22.08,0:21:24.08,Default,,0,0,0,,《Сол қыз және Такуми Миясака➡
Dialogue: 0,0:21:24.08,0:21:27.08,Default,,0,0,0,,Жақсы болады деп үміттендім...》
Dialogue: 0,0:21:27.08,0:21:29.08,Default,,0,0,0,,《Мүмкін бұл жақсы емес шығар...》
Dialogue: 0,0:21:29.08,0:21:32.05,Default,,0,0,0,,《Иә? Бұл жерде! 》
Dialogue: 0,0:21:34.09,0:21:37.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:37.09,0:21:43.10,Default,,0,0,0,,♬～
Dialogue: 0,0:21:43.10,0:21:46.10,Default,,0,0,0,,《Не болды? Іске сәт! 》
Dialogue: 0,0:21:46.10,0:21:48.10,Default,,0,0,0,,Бір! Иә?
Dialogue: 0,0:21:48.10,0:21:50.10,Default,,0,0,0,,Аои-чан
Dialogue: 0,0:21:50.10,0:21:52.11,Default,,0,0,0,,А... аа... у...
Dialogue: 0,0:21:52.11,0:21:54.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.11,0:21:57.11,Default,,0,0,0,,Қаласаңыз, мұны бірге жасайық...
Dialogue: 0,0:21:57.11,0:21:59.11,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:21:59.11,0:22:02.05,Default,,0,0,0,,«Конмуши фестивалі»?
Dialogue: 0,0:22:02.05,0:22:06.05,Default,,0,0,0,,《Жәндіктер фестивалі өте қиын бірінші кездесу! 》
Dialogue: 0,0:22:06.05,0:22:10.06,Default,,0,0,0,,А, мынау көршілес бірлестігінен бе? Мен бұл туралы біраз уақыттан бері қызықтырдым.
Dialogue: 0,0:22:10.06,0:22:12.06,Default,,0,0,0,,《Өтірік болуы керек⁉》
Dialogue: 0,0:22:12.06,0:22:16.06,Default,,0,0,0,,Менімен бірге жәндіктерді жегіңіз келе ме?
Dialogue: 0,0:22:16.06,0:22:20.07,Default,,0,0,0,,Хехе... 《Қорқынышты, Аои Чан...》
Dialogue: 0,0:22:20.07,0:22:32.08,Default,,0,0,0,,♬～
Dialogue: 0,0:22:32.08,0:22:43.09,Default,,0,0,0,,♬～
Dialogue: 0,0:22:43.09,0:22:59.11,Default,,0,0,0,,♬～
Dialogue: 0,0:22:59.11,0:23:12.05,Default,,0,0,0,,♬～
Dialogue: 0,0:23:12.05,0:23:24.06,Default,,0,0,0,,♬～
Dialogue: 0,0:23:24.06,0:23:29.07,Default,,0,0,0,,♬～
Dialogue: 0,0:23:29.07,0:23:37.08,Default,,0,0,0,,♬～
Dialogue: 0,0:23:37.08,0:23:48.09,Default,,0,0,0,,♬～
