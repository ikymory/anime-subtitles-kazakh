Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.38,0:00:16.30,OS,,0000,0000,0000,,Мен оны іздеп дүниеге келдім.
Dialogue: 0,0:00:17.64,0:00:24.43,OS,,0000,0010,0000,,Жаңа дүниедегі өмірдің және алуға болатын барлық нәрселердің есебінен.
Dialogue: 0,0:00:32.14,0:00:35.04,OS,,0000,0000,0000,,Қыз бір жерден жиналған қоқыстан жасалған.
Dialogue: 0,0:00:35.48,0:00:37.43,OS,,0000,0000,0000,,Сен менің денемді жараттың
Dialogue: 0,0:00:43.77,0:00:45.45,OS,,0000,0000,0000,,Менің есте сақтау қабілетім тоқтап қалды
Dialogue: 0,0:00:46.76,0:00:48.73,OS,,0000,0000,0000,,Күш жұмсамай еске түсіре алмайды
Dialogue: 0,0:00:50.25,0:00:52.17,OS,,0000,0000,0000,,Осы уақытқа дейін қайда болдың?
Dialogue: 0,0:00:52.96,0:00:54.94,OS,,0000,0000,0000,,Қайда барсаң да, не істеп жүрсің?
Dialogue: 0,0:01:06.77,0:01:07.96,Default,,0000,0000,0000,,Жарайсыңдар
Dialogue: 0,0:01:09.58,0:01:11.99,OS,,0000,0000,0000,,Мен қызбен сөйлесе алмадым
Dialogue: 0,0:01:13.48,0:01:16.93,OS,,0000,0000,0000,,Бірақ мен мұны қалаған едім
Dialogue: 0,0:01:17.36,0:01:19.94,OS,,0000,0000,0000,,Бұл дүниедегі жалғыз жылулық
Dialogue: 0,0:01:22.00,0:01:26.80,OS,,0000,0000,0000,,Мен ешқандай жылуды сезе алмаймын, өйткені менің денем керексіз заттардан тұрады, бірақ...
Dialogue: 0,0:03:03.22,0:03:04.28,Default,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:03:04.47,0:03:06.10,Default,,0000,0000,0000,,Сонымен, сен кімсің?
Dialogue: 0,0:03:07.15,0:03:08.85,Default,,0000,0000,0000,,Өкініштісі, бұл клиент емес.
Dialogue: 0,0:03:09.24,0:03:11.94,Default,,0000,0000,0000,,Сіз әрқашан шатастырасыз,
Dialogue: 0,0:03:12.13,0:03:15.07,Default,,0000,0000,0000,,Енді төрт аяқтап кіріңіз, сонда мен сіздің клиент емес екеніңізді көремін.
Dialogue: 0,0:03:15.29,0:03:17.45,Default,,0000,0000,0000,,Бұдан кейін Когаға не болды?
Dialogue: 0,0:03:17.84,0:03:20.21,Default,,0000,0000,0000,,Келгеніңіз үшін кешіріңіз, бірақ мен ұйықтап жатырмын.
Dialogue: 0,0:03:20.49,0:03:21.88,Default,,0000,0000,0000,,Мені жалғыз қалдырыңыз.
Dialogue: 0,0:03:22.17,0:03:25.67,Default,,0000,0000,0000,,Мен саған айтамын, мен сенің атыңды қалжыңдағаным үшін айтқан жоқпын.
Dialogue: 0,0:03:25.93,0:03:26.93,Default,,0000,0000,0000,,Менмен болмаңыз!
Dialogue: 0,0:03:27.16,0:03:28.93,Default,,0000,0000,0000,,Мен бұл туралы ештеңе естіген жоқпын.
Dialogue: 0,0:03:29.05,0:03:30.42,Default,,0000,0000,0000,,Айтуға тура келсе, мынау болар еді.
Dialogue: 0,0:03:30.72,0:03:34.44,Default,,0000,0000,0000,,Аа, мен әкемді жақсы көремін, ол өте керемет.
Dialogue: 0,0:03:34.65,0:03:37.57,Default,,0000,0000,0000,,Әдемі анаңмен керемет көрінесің.
Dialogue: 0,0:03:38.77,0:03:40.13,Default,,0000,0000,0000,,Суық ештеңе жасамаңыз!
Dialogue: 0,0:03:40.13,0:03:41.45,Default,,0000,0000,0000,,Сіз мұны өзіңіз жасадыңыз!
Dialogue: 0,0:03:41.51,0:03:42.45,Default,,0000,0000,0000,,Mr. Okazaki
Dialogue: 0,0:03:43.15,0:03:45.89,Default,,0000,0000,0000,,Нағисаға қонаққа келдің бе?
Dialogue: 0,0:03:45.99,0:03:48.50,Default,,0000,0000,0000,,Ха, мен сенің ұйықтап жатқаныңды естідім...
Dialogue: 0,0:03:48.90,0:03:51.20,Default,,0000,0000,0000,,Жоқ, бұл жай ғана қызба.
Dialogue: 0,0:03:52.06,0:03:52.58,Default,,0000,0000,0000,,Тек...
Dialogue: 0,0:03:54.42,0:03:57.04,Default,,0000,0000,0000,,Нағиса басынан сәл әлсіз.
Dialogue: 0,0:03:57.69,0:04:00.49,Default,,0000,0000,0000,,Өткен жылы мен мектептен ұзақ үзіліс алдым...
Dialogue: 0,0:04:01.55,0:04:05.69,Default,,0000,0000,0000,,Сонымен, қауіпсіз болу үшін дәрігер маған бүгін түнде ұйықтау керектігін айтты.
Dialogue: 0,0:04:06.13,0:04:06.87,Default,,0000,0000,0000,,Шит… шит…
Dialogue: 0,0:04:07.57,0:04:11.82,Default,,0000,0000,0000,,Қалай болғанда да, мені көтеріп жүргеніңіздің арқасында мен ештеңеге алаңдамадым.
Dialogue: 0,0:04:12.23,0:04:13.05,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:04:13.45,0:04:15.46,Default,,0000,0000,0000,,Жоқ, бұл менің кінәм...
Dialogue: 0,0:04:17.72,0:04:19.41,Default,,0000,0000,0000,,Санаенің наны, оны ал.
Dialogue: 0,0:04:19.49,0:04:19.93,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:04:20.22,0:04:22.66,Default,,0000,0000,0000,,Қабыл ал, бұл менің ризалығымның белгісі.
Dialogue: 0,0:04:22.95,0:04:25.12,Default,,0000,0000,0000,,Мен мұнда ондай ниетпен келген жоқпын...
Dialogue: 0,0:04:25.43,0:04:26.46,Default,,0000,0000,0000,,Ұялмаңыз
Dialogue: 0,0:04:26.76,0:04:29.30,Default,,0000,0000,0000,,Ол бүгінде сатылмай қала береді...
Dialogue: 0,0:04:31.00,0:04:33.60,Default,,0000,0000,0000,,Менің наным… Менің наным…
Dialogue: 0,0:04:34.10,0:04:36.86,Default,,0000,0000,0000,,Бұл Кога Нанның жүгі еді...!
Dialogue: 0,0:04:39.10,0:04:41.92,Default,,0000,0000,0000,,Мен оны жақсы көремін!
Dialogue: 0,0:04:43.07,0:04:46.22,Default,,0000,0000,0000,,Ал, егер солай болса, менің ойымша, шынымен алаңдайтын ештеңе жоқ.
Dialogue: 0,0:04:46.24,0:04:48.51,Default,,0000,0000,0000,,Кешіріңіз, дүкен ше?
Dialogue: 0,0:04:48.92,0:04:50.84,Default,,0000,0000,0000,,Мен жаңа ғана сыртқа шықтым.
Dialogue: 0,0:04:52.96,0:04:54.28,Default,,0000,0000,0000,,Егер сізге ұнаса, бұл
Dialogue: 0,0:04:55.64,0:04:56.55,Default,,0000,0000,0000,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:04:56.71,0:04:59.03,Default,,0000,0000,0000,,Иә, мен де оны тегін алдым.
Dialogue: 0,0:04:59.19,0:05:00.52,Default,,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:05:00.90,0:05:03.98,Default,,0000,0000,0000,,Күйеуіңізге және Санаэ-санға рахмет айтыңыз.
Dialogue: 0,0:05:08.26,0:05:09.64,OS,,0000,0000,0000,,Ол әдемі адам...
Dialogue: 0,0:05:18.18,0:05:20.67,OS,,0000,0000,0000,,Әлсіз, бірақ ақымақ жігіт
Dialogue: 0,0:05:21.35,0:05:24.14,Default,,0000,0000,0000,,Сен, сен, сен сонда!
Dialogue: 0,0:05:24.32,0:05:25.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:27.07,0:05:28.84,Default,,0000,0000,0000,,Мына жараға қараңызшы.
Dialogue: 0,0:05:29.27,0:05:31.75,Default,,0000,0000,0000,,Құрылыс құралдары құлап, осылай болды.
Dialogue: 0,0:05:31.95,0:05:34.09,Default,,0000,0000,0000,,Сіз куәгер бола аласыз ба?
Dialogue: 0,0:05:34.27,0:05:35.00,Default,,0000,0000,0000,,Куәгер?
Dialogue: 0,0:05:35.17,0:05:37.66,Default,,0000,0000,0000,,Сенің қатысың жоқ адамдарды қатыстырғаның маған ұнамайды.
Dialogue: 0,0:05:38.19,0:05:41.03,Default,,0000,0000,0000,,Куәгер болмаса, қашасың!
Dialogue: 0,0:05:42.02,0:05:45.13,Default,,0000,0000,0000,,Мен талай рет айтқанымдай, мен ешқандай құралды түсірген жоқпын.
Dialogue: 0,0:05:45.57,0:05:47.95,Default,,0000,0000,0000,,Мен оны тастасам да, алдамаймын
Dialogue: 0,0:05:47.95,0:05:49.30,Default,,0000,0000,0000,,Оған сене аласыз ба?
Dialogue: 0,0:05:49.61,0:05:52.15,Default,,0000,0000,0000,,Жөндеуге ақша төлеуімді қаласаңыз, мен аламын.
Dialogue: 0,0:05:52.43,0:05:53.51,Default,,0000,0000,0000,,Сіз мойындайсыз!?
Dialogue: 0,0:05:54.01,0:05:56.76,Default,,0000,0000,0000,,Жоқ, мен сенің бір күні өткенге қарап, ойлануыңды қалаймын.
Dialogue: 0,0:05:57.15,0:06:00.83,Default,,0000,0000,0000,,Сол кездегі электриктің сөзі өтірік пе, жоқ па.
Dialogue: 0,0:06:01.37,0:06:03.65,Default,,0000,0000,0000,,Өзіңізді еркін сезінетін жер...
Dialogue: 0,0:06:04.00,0:06:06.22,Default,,0000,0000,0000,,Иә, сүйген адамыңнан!
Dialogue: 0,0:06:08.71,0:06:10.56,Default,,0000,0000,0000,,Бұл адам не айтып тұр?
Dialogue: 0,0:06:10.57,0:06:12.30,Default,,0000,0000,0000,,Жоқ, тіпті сұрасаң да
Dialogue: 0,0:06:13.12,0:06:15.72,Default,,0000,0000,0000,,Адам өмірі бір-бірін ренжітудің қайталануы.
Dialogue: 0,0:06:16.29,0:06:18.03,Default,,0000,0000,0000,,Басқаларға күдікпен қарау табиғи нәрсе.
Dialogue: 0,0:06:18.27,0:06:20.80,Default,,0000,0000,0000,,Бірақ сіз енді ештеңеге сене алмасаңыз,
Dialogue: 0,0:06:20.96,0:06:23.47,Default,,0000,0000,0000,,Өзгенің махаббатын сезіне алмаумен бірдей.
Dialogue: 0,0:06:23.80,0:06:26.38,Default,,0000,0000,0000,,Сізге жалғыз болу қиын ба?
Dialogue: 0,0:06:26.91,0:06:28.00,Default,,0000,0000,0000,,Сіз бағынышты өмір сүресіз бе?
Dialogue: 0,0:06:28.40,0:06:29.73,Default,,0000,0000,0000,,Шынымен күлесің бе?
Dialogue: 0,0:06:30.14,0:06:31.96,Default,,0000,0000,0000,,Ха...хаха...мүмкін
Dialogue: 0,0:06:32.38,0:06:32.92,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:06:34.07,0:06:36.44,Default,,0000,0000,0000,,Сонда сені жақсы көретін шығар.
Dialogue: 0,0:06:36.96,0:06:38.86,Default,,0000,0000,0000,,Сол махаббат сөніп қалмасын
Dialogue: 0,0:06:38.92,0:06:40.32,Default,,0000,0000,0000,,Мықты болып, аман бол
Dialogue: 0,0:06:40.70,0:06:43.94,OS,,0000,0000,0000,,Ол сондай қорқынышты жолдарды сеніммен айта алатын адам.
Dialogue: 0,0:06:44.71,0:06:45.25,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:48.95,0:06:49.66,Default,,0000,0000,0000,,Осымен
Dialogue: 0,0:06:50.92,0:06:51.67,Default,,0000,0000,0000,,Бұл мысық емес пе?
Dialogue: 0,0:06:52.22,0:06:52.86,Default,,0000,0000,0000,,мысық?
Dialogue: 0,0:06:53.20,0:06:55.32,Default,,0000,0000,0000,,Осы жағынан қарасаңыз, міне.
Dialogue: 0,0:06:56.48,0:06:58.58,Default,,0000,0000,0000,,Ах, шынымен, аа!
Dialogue: 0,0:06:59.48,0:07:03.25,Default,,0000,0000,0000,,Мысық қабырғадан секіріп түсіп, ойысқан, мен сенімдімін.
Dialogue: 0,0:07:04.10,0:07:06.02,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:07:09.31,0:07:10.50,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:07:12.86,0:07:15.05,Default,,0000,0000,0000,,Рахмет, мен құтқарылдым.
Dialogue: 0,0:07:15.21,0:07:17.85,Default,,0000,0000,0000,,Ой, жоқ, мен байқағанымды айтып отырмын.
Dialogue: 0,0:07:18.32,0:07:19.75,Default,,0000,0000,0000,,Ақырында дұрыстап иілгім келеді.
Dialogue: 0,0:07:20.32,0:07:21.88,Default,,0000,0000,0000,,Бос уақытыңыз болса да, маған хабарласыңыз.
Dialogue: 0,0:07:24.31,0:07:26.44,Default,,0000,0000,0000,,Ол не деді?
Dialogue: 0,0:07:27.00,0:07:29.61,Default,,0000,0000,0000,,Сіз жалғыз тұрасыз ба?
Dialogue: 0,0:07:29.77,0:07:31.90,Default,,0000,0000,0000,,Шынымен күлесің бе?
Dialogue: 0,0:07:32.28,0:07:33.24,Default,,0000,0000,0000,,Және басқа да көптеген нәрселер
Dialogue: 0,0:07:33.56,0:07:35.23,Default,,0000,0000,0000,,Аңызға айналған MC
Dialogue: 0,0:07:35.53,0:07:37.93,Default,,0000,0000,0000,,Бұл нағыз Юсуке Йошино ма?
Dialogue: 0,0:07:38.65,0:07:39.31,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:07:39.60,0:07:40.65,Default,,0000,0000,0000,,Мен ештеңе білмеймін
Dialogue: 0,0:07:40.98,0:07:42.83,Default,,0000,0000,0000,,Ол зейнеткерлікке шыққан харизматикалық музыкант.
Dialogue: 0,0:07:43.10,0:07:45.82,Default,,0000,0000,0000,,Олар компакт-дискілерді шығарып, жақсы сатылды.
Dialogue: 0,0:07:45.83,0:07:46.37,Default,,0000,0000,0000,,Шынайы ма?
Dialogue: 0,0:07:48.22,0:07:51.57,Default,,0000,0000,0000,,Ол жоғалып кетті, бірақ мен оның осы ауданда екенін білмедім.
Dialogue: 0,0:07:52.37,0:07:55.93,Default,,0000,0000,0000,,Менің әпкем жасаған ең жақсы альбом бар, тыңдаңыз.
Dialogue: 0,0:07:56.21,0:07:58.34,Default,,0000,0000,0000,,Бір минут күтіңіз! Эй, сенің әпкең бар ма?
Dialogue: 0,0:07:58.50,0:08:00.21,Default,,0000,0000,0000,,Мен бармын, айтпадың ба?
Dialogue: 0,0:08:00.94,0:08:02.70,Default,,0000,0000,0000,,Сунохараның әпкесі?
Dialogue: 0,0:08:03.57,0:08:05.83,Default,,0000,0000,0000,,Бет-әлпеті осындай жігіт екеніне сенімдімін.
Dialogue: 0,0:08:05.03,0:08:05.83,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:08:12.26,0:08:13.91,OS,,0000,0000,0000,,Юсуке Йошино...
Dialogue: 0,0:08:17.09,0:08:19.73,Default,,0000,0000,0000,,Оказаки! Оказаки! Сіз тыңдайсыз ба?
Dialogue: 0,0:08:20.12,0:08:20.89,Default,,0000,0000,0000,,Оказаки!
Dialogue: 0,0:08:21.85,0:08:22.91,Default,,0000,0000,0000,,О, не?
Dialogue: 0,0:08:23.13,0:08:24.79,Default,,0000,0000,0000,,Томойо Сакагами туралы.
Dialogue: 0,0:08:25.29,0:08:29.30,Default,,0000,0000,0000,,Мен ойладым, ол шынымен еркек емес пе?
Dialogue: 0,0:08:29.56,0:08:29.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:29.94,0:08:32.57,Default,,0000,0000,0000,,Әйелдің еркектен күшті болуы мүмкін емес.
Dialogue: 0,0:08:32.90,0:08:35.30,Default,,0000,0000,0000,,Басқаларды алдау үшін әйел кейпіне енеді.
Dialogue: 0,0:08:35.58,0:08:36.89,Default,,0000,0000,0000,,Шехер астрономиялық кітапханасының басқарма бастығы, «Юстиция» обсерваториясында
Dialogue: 0,0:08:37.35,0:08:38.79,Default,,0000,0000,0000,,Мен оны ертең дәлелдеймін.
Dialogue: 0,0:08:39.08,0:08:40.91,Default,,0000,0000,0000,,Оның адам екенін
Dialogue: 0,0:08:41.32,0:08:44.17,Default,,0000,0000,0000,,«Ол кезде Сунохара бұл туралы әлі хабардар емес еді».
Dialogue: 0,0:08:44.53,0:08:47.36,Default,,0000,0000,0000,,«Мен бұзық болу жолын бастағанымды түсіндім».
Dialogue: 0,0:08:47.88,0:08:49.09,Default,,0000,0000,0000,,Мен сізді толық ести алмаймын.
Dialogue: 0,0:08:52.86,0:08:53.90,Default,,0000,0000,0000,,Енді ше?
Dialogue: 0,0:08:54.35,0:08:56.71,Default,,0000,0000,0000,,Мен бүгін ұрыс таңдауға келген жоқпын.
Dialogue: 0,0:08:56.94,0:08:58.50,Default,,0000,0000,0000,,Мен біраз сөйлескім келеді.
Dialogue: 0,0:08:58.66,0:09:00.19,Default,,0000,0000,0000,,Тек мені тыңда.
Dialogue: 0,0:09:00.45,0:09:04.10,Default,,0000,0000,0000,,Мен бүгін таңертең артық ұйықтадым, мен ашуландым.
Dialogue: 0,0:09:04.48,0:09:06.39,Default,,0000,0000,0000,,Мінезіңізді өзгерткен жоқсыз ба?
Dialogue: 0,0:09:06.69,0:09:09.35,Default,,0000,0000,0000,,Сонымен, сақалымды қыруға бел будым.
Dialogue: 0,0:09:09.66,0:09:12.95,Default,,0000,0000,0000,,Ұстараның жүзі қиыршықтанып, қиналып қалдым.
Dialogue: 0,0:09:13.24,0:09:13.88,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:09:14.17,0:09:17.39,Default,,0000,0000,0000,,Кешіріңіз, ұстараңызды қарызға бере аласыз ба?
Dialogue: 0,0:09:17.73,0:09:19.69,Default,,0000,0000,0000,,Неліктен несие беруім керек?
Dialogue: 0,0:09:19.98,0:09:22.03,Default,,0000,0000,0000,,Иә! Ол жабысып қалды!
Dialogue: 0,0:09:22.18,0:09:23.57,Default,,0000,0000,0000,,Сіз де естідіңіз.
Dialogue: 0,0:09:23.77,0:09:24.48,Default,,0000,0000,0000,,Мен естідім...
Dialogue: 0,0:09:24.67,0:09:25.78,Default,,0000,0000,0000,,Бұл не туралы?
Dialogue: 0,0:09:26.03,0:09:28.36,Default,,0000,0000,0000,,Жаңа ғана: «Неге оны саған қарызға беруім керек?» дедіңіз.
Dialogue: 0,0:09:28.68,0:09:31.54,Default,,0000,0000,0000,,Бұл сізде ұстара бар дегенді білдіреді.
Dialogue: 0,0:09:31.75,0:09:32.39,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:09:32.39,0:09:33.45,Default,,0000,0000,0000,,Сізде бұл мүмкін емес.
Dialogue: 0,0:09:33.32,0:09:33.45,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:33.93,0:09:40.14,Default,,0000,0000,0000,,«Неге» десем, мен сізге өз мүлкімді қарызға беруге қандай міндеттімін?
Dialogue: 0,0:09:40.57,0:09:41.14,Default,,0000,0000,0000,,Бірінші кезекте...
Dialogue: 0,0:09:41.65,0:09:42.40,Default,,0000,0000,0000,,Бірінші кезекте?
Dialogue: 0,0:09:42.59,0:09:44.89,Default,,0000,0000,0000,,Әйелден мұны сұрау дөрекі!
Dialogue: 0,0:09:47.40,0:09:48.12,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:09:49.89,0:09:50.53,Default,,0000,0000,0000,,Мен өлемін!
Dialogue: 0,0:09:51.22,0:09:51.81,Default,,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:09:57.54,0:09:57.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:20.60,0:10:21.57,Default,,0000,0000,0000,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:10:22.70,0:10:25.62,Default,,0000,0000,0000,,Батыл бол, қолыңнан келгеннің бәрін жаса
Dialogue: 0,0:10:27.16,0:10:29.64,Default,,0000,0000,0000,,Мені кешірерсің бе деп едім.
Dialogue: 0,0:10:30.24,0:10:33.83,Default,,0000,0000,0000,,Себебі мен Оказаки мырзаны ренжіттім.
Dialogue: 0,0:10:34.48,0:10:37.07,Default,,0000,0000,0000,,Бұл менің кінәм болды.
Dialogue: 0,0:10:44.68,0:10:46.77,Default,,0000,0000,0000,,Кешіріңіз, сіз жеңілдейсіз деп үміттенемін.
Dialogue: 0,0:10:47.82,0:10:49.26,Default,,0000,0000,0000,,Расында, сен ақымақсың.
Dialogue: 0,0:10:52.47,0:10:52.95,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:10:59.11,0:11:02.52,Default,,0000,0000,0000,,Эй, сен ақымақ шығарсың, бірақ менің ойымша, бұл жақсы.
Dialogue: 0,0:11:05.06,0:11:06.17,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:11:07.57,0:11:08.76,Default,,0000,0000,0000,,Мен де солаймын.
Dialogue: 0,0:11:09.34,0:11:10.25,Default,,0000,0000,0000,,Бір жерде болу
Dialogue: 0,0:11:11.11,0:11:15.59,Default,,0000,0000,0000,,Дүниеде жүріп-тұруға шебер адамдар мен ақылды тактиканы қолданатын адамдардан алыс жер.
Dialogue: 0,0:11:17.32,0:11:18.81,Default,,0000,0000,0000,,Кейде қиын болуы мүмкін, бірақ
Dialogue: 0,0:11:19.10,0:11:21.49,Default,,0000,0000,0000,,Жалғыз жылап жатсаңыз, маған хабарласыңыз.
Dialogue: 0,0:11:21.86,0:11:22.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:22.61,0:11:23.78,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:11:24.49,0:11:25.76,Default,,0000,0000,0000,,Менің бәрібір бос уақытым бар.
Dialogue: 0,0:11:26.08,0:11:29.15,Default,,0000,0000,0000,,Мен сенімен аралассам жалықпайтын сияқтымын.
Dialogue: 0,0:11:29.55,0:11:30.56,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:11:30.86,0:11:32.56,Default,,0000,0000,0000,,Жылағың келсе, маған хабарлас.
Dialogue: 0,0:11:38.81,0:11:39.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:40.14,0:11:40.41,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:42.60,0:11:43.87,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:45.34,0:11:46.20,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:46.83,0:11:48.53,Default,,0000,0000,0000,,Пышақты іздеу
Dialogue: 0,0:11:48.63,0:11:49.18,Default,,0000,0000,0000,,Пышақ?
Dialogue: 0,0:11:49.18,0:11:49.61,Default,,0000,0000,0000,,О
Dialogue: 0,0:11:51.22,0:11:51.63,Default,,0000,0000,0000,,Бұл ма?
Dialogue: 0,0:11:52.10,0:11:53.29,Default,,0000,0000,0000,,Оны қайтарыңыз
Dialogue: 0,0:11:53.39,0:11:54.23,Default,,0000,0000,0000,,Қол жарақаттары туралы не деуге болады?
Dialogue: 0,0:11:54.34,0:11:56.70,Default,,0000,0000,0000,,Енді ауырмайды, жазылды.
Dialogue: 0,0:11:56.96,0:11:57.46,Default,,0000,0000,0000,,Қол алысу
Dialogue: 0,0:11:57.61,0:11:58.12,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:58.24,0:11:58.97,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:11:59.24,0:11:59.87,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:00.07,0:12:01.29,Default,,0000,0000,0000,,Бұл ауырмайды
Dialogue: 0,0:12:01.45,0:12:02.86,Default,,0000,0000,0000,,Бұл өте ауыр көрінеді.
Dialogue: 0,0:12:03.18,0:12:03.74,Default,,0000,0000,0000,,Жоғары бес
Dialogue: 0,0:12:03.91,0:12:05.78,Default,,0000,0000,0000,,Дриблинг...
Dialogue: 0,0:12:04.91,0:12:05.98,OS,,0000,0000,0000,,Тағы да сонда?
Dialogue: 0,0:12:05.98,0:12:06.82,Default,,0000,0000,0000,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:12:07.41,0:12:08.65,Default,,0000,0000,0000,,Енгізілді!
Dialogue: 0,0:12:08.78,0:12:09.42,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:10.23,0:12:11.00,Default,,0000,0000,0000,,Ауырды, солай ма?
Dialogue: 0,0:12:11.14,0:12:12.31,Default,,0000,0000,0000,,Бұл ауырмайды
Dialogue: 0,0:12:12.38,0:12:13.70,Default,,0000,0000,0000,,Бұл өте ауыр көрінеді.
Dialogue: 0,0:12:14.13,0:12:15.82,Default,,0000,0000,0000,,Сонымен, боксшылар мен жаттықтырушылар
Dialogue: 0,0:12:16.33,0:12:16.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:17.05,0:12:18.42,Default,,0000,0000,0000,,Эй, сен жаттықтырушысың.
Dialogue: 0,0:12:19.33,0:12:20.51,Default,,0000,0000,0000,,Осылай тұрыңыз
Dialogue: 0,0:12:21.06,0:12:24.81,Default,,0000,0000,0000,,Міне, мен сені қолымнан келгенше жұдырықтаймын.
Dialogue: 0,0:12:24.81,0:12:25.45,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:25.81,0:12:27.54,Default,,0000,0000,0000,,О, Оказаки мырза
Dialogue: 0,0:12:27.62,0:12:30.80,Default,,0000,0000,0000,,Бір екі, бір екі дейсің, жарай ма?
Dialogue: 0,0:12:30.97,0:12:31.59,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:12:32.15,0:12:32.86,Default,,0000,0000,0000,,Міне, басталды!
Dialogue: 0,0:12:33.28,0:12:34.47,Default,,0000,0000,0000,,Jab Jab Straight!
Dialogue: 0,0:12:34.47,0:12:36.34,Default,,0000,0000,0000,,Бір екі бір екі Бір екі бір екі
Dialogue: 0,0:12:37.21,0:12:39.31,Default,,0000,0000,0000,,Бір екі бір екі Бір екі бір екі
Dialogue: 0,0:12:39.77,0:12:42.63,Default,,0000,0000,0000,,Ва, бір екі бір екі бір екі бір екі бір...
Dialogue: 0,0:12:41.34,0:12:42.44,Default,,0000,0000,0000,,Сіз мұны қанша уақыттан бері істеп жүрсіз?
Dialogue: 0,0:12:42.87,0:12:43.27,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:12:45.61,0:12:46.97,Default,,0000,0000,0000,,Қоңырау соғылып тұр, кеттік.
Dialogue: 0,0:12:47.71,0:12:48.21,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:48.40,0:12:50.73,Default,,0000,0000,0000,,Ум, мен саған мынаны беремін.
Dialogue: 0,0:12:51.11,0:12:53.64,Default,,0000,0000,0000,,Бұл не? Эй!
Dialogue: 0,0:12:56.07,0:12:57.89,OS,,0000,0000,0000,,Жұлдыздар... дұрыс па?
Dialogue: 0,0:13:01.11,0:13:03.47,Default,,0000,0000,0000,,Сунохара Сунохара Ол тірі ме?
Dialogue: 0,0:13:03.79,0:13:04.63,Default,,0000,0000,0000,,Сабақтан кейін.
Dialogue: 0,0:13:04.91,0:13:05.37,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:13:06.47,0:13:08.63,Default,,0000,0000,0000,,Иә? Сабақ бітірдіңіз бе?
Dialogue: 0,0:13:09.10,0:13:11.30,Default,,0000,0000,0000,,Ах, шамамен 100 жыл бұрын.
Dialogue: 0,0:13:11.62,0:13:12.40,Default,,0000,0000,0000,,100 жыл!?
Dialogue: 0,0:13:12.59,0:13:14.60,Default,,0000,0000,0000,,Хехе, сен өлдің.
Dialogue: 0,0:13:14.61,0:13:16.59,Default,,0000,0000,0000,,Иә, бұл 3D кескіні.
Dialogue: 0,0:13:16.96,0:13:17.50,Default,,0000,0000,0000,,Сіз байсалдысыз ба?
Dialogue: 0,0:13:17.85,0:13:21.65,Default,,0000,0000,0000,,Томойо сені тепкеннен бері сен 100 жыл ұйықтадың.
Dialogue: 0,0:13:22.43,0:13:24.83,Default,,0000,0000,0000,,Бұл 100 жылдан кейінгі дүние.
Dialogue: 0,0:13:25.07,0:13:25.85,Default,,0000,0000,0000,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:13:26.07,0:13:27.90,Default,,0000,0000,0000,,Сонымен, әлемде не болып жатыр?
Dialogue: 0,0:13:28.07,0:13:28.70,Default,,0000,0000,0000,,жойылды
Dialogue: 0,0:13:29.02,0:13:29.74,Default,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:13:30.22,0:13:32.11,Default,,0000,0000,0000,,Уф, әке, ана.
Dialogue: 0,0:13:32.29,0:13:34.05,Default,,0000,0000,0000,,Соңына дейін ақымақ сияқты әрекет еткенім үшін кешірім сұраймын.
Dialogue: 0,0:13:34.26,0:13:36.71,Default,,0000,0000,0000,,Жалғыз болсам да күшті өмір сүремін
Dialogue: 0,0:13:36.92,0:13:38.68,Default,,0000,0000,0000,,Жарайды, тез оян.
Dialogue: 0,0:13:38.70,0:13:39.38,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:13:39.69,0:13:41.17,Default,,0000,0000,0000,,3D кескіндері арқылы іске қосылған
Dialogue: 0,0:13:41.50,0:13:43.20,Default,,0000,0000,0000,,Сонымен, Теме шынайы!
Dialogue: 0,0:13:43.47,0:13:44.90,Default,,0000,0000,0000,,Негізі мен киборгпын
Dialogue: 0,0:13:45.05,0:13:47.89,Default,,0000,0000,0000,,Е, сонда дүние жойылды ма?
Dialogue: 0,0:13:48.40,0:13:48.89,Default,,0000,0000,0000,,Рас
Dialogue: 0,0:13:49.05,0:13:49.98,Default,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:13:50.52,0:13:53.14,Default,,0000,0000,0000,,Әке, анашым, ақымақ болғаным үшін кешіріңіз.
Dialogue: 0,0:13:53.48,0:13:56.77,Default,,0000,0000,0000,,Мен Оказаки Киборгпен бірге тұрамын.
Dialogue: 0,0:13:57.39,0:13:58.87,Default,,0000,0000,0000,,Сіз де көп мінесіз.
Dialogue: 0,0:13:58.87,0:14:00.58,Default,,0000,0000,0000,,Не? Бұл өтірік болды ма?
Dialogue: 0,0:14:00.74,0:14:01.81,Default,,0000,0000,0000,,Сен сендің бе?
Dialogue: 0,0:14:02.07,0:14:03.84,Default,,0000,0000,0000,,Мен жартылай ұйықтап жатырмын, сондықтан мен сізге сенемін!
Dialogue: 0,0:14:03.93,0:14:04.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:04.30,0:14:06.85,Default,,0000,0000,0000,,Эй, тыңдап тұрсың ба! Оказаки
Dialogue: 0,0:14:10.85,0:14:12.21,Default,,0000,0000,0000,,Бірдеңе іздеп жүрсіз бе?
Dialogue: 0,0:14:12.79,0:14:13.19,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:14:17.40,0:14:18.89,Default,,0000,0000,0000,,Иа...өте сүйкімді...
Dialogue: 0,0:14:19.09,0:14:19.51,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:19.96,0:14:21.97,Default,,0000,0000,0000,,Оларда ит пен мысықта жоқ сүйкімділік бар.
Dialogue: 0,0:14:22.44,0:14:23.67,Default,,0000,0000,0000,,Сонымен бұл не?
Dialogue: 0,0:14:23.71,0:14:24.20,Default,,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:14:28.06,0:14:30.71,Default,,0000,0000,0000,,Бұл не? Қашпа...
Dialogue: 0,0:14:31.60,0:14:33.40,Default,,0000,0000,0000,,Ахаха мен оны жек көремін
Dialogue: 0,0:14:33.44,0:14:34.40,Default,,0000,0000,0000,,Сәлем!!!
Dialogue: 0,0:14:35.20,0:14:35.99,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:14:42.37,0:14:45.60,Default,,0000,0000,0000,,Қайсысы тиімдірек болды, Томойо Сунохараның соққысы?
Dialogue: 0,0:14:45.60,0:14:47.14,Default,,0000,0000,0000,,Сұрайтын тағы бір нәрсеңіз болуы керек!
Dialogue: 0,0:14:50.78,0:14:54.98,Default,,0000,0000,0000,,Дәл қазір мен аяқ киімнің түбімен ашық көк түсті бірдеңені көріп тұрмын...
Dialogue: 0,0:14:56.44,0:14:57.42,Default,,0000,0000,0000,,Оны ұмыт!
Dialogue: 0,0:14:57.42,0:14:59.48,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:15:06.81,0:15:09.16,Default,,0000,0000,0000,,Менің баламды не істейсің?
Dialogue: 0,0:15:09.45,0:15:11.02,Default,,0000,0000,0000,,Бұл сіздің үй жануарыңыз ба?
Dialogue: 0,0:15:11.18,0:15:12.29,Default,,0000,0000,0000,,Иә, Уринко.
Dialogue: 0,0:15:12.73,0:15:15.25,Default,,0000,0000,0000,,Қабан Ұрибу деп те аталады
Dialogue: 0,0:15:15.47,0:15:17.33,Default,,0000,0000,0000,,Омоені алуға келдің бе?
Dialogue: 0,0:15:17.41,0:15:18.14,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:15:18.55,0:15:21.01,Default,,0000,0000,0000,,Оның есімі Түймешік, ол өте сүйкімді, солай ма?
Dialogue: 0,0:15:21.28,0:15:22.82,Default,,0000,0000,0000,,Бұл өте жақсы есім.
Dialogue: 0,0:15:23.04,0:15:24.33,Default,,0000,0000,0000,,Иә? Не?
Dialogue: 0,0:15:24.55,0:15:25.44,Default,,0000,0000,0000,,Бұл ештеңе емес...
Dialogue: 0,0:15:25.89,0:15:27.80,Default,,0000,0000,0000,,Сәлем түймесі, сәлем айтыңыз.
Dialogue: 0,0:15:28.19,0:15:29.64,Default,,0000,0000,0000,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:15:31.52,0:15:32.44,Default,,0000,0000,0000,,Хахаха
Dialogue: 0,0:15:35.01,0:15:36.77,Default,,0000,0000,0000,,Брифингке жаттығу?
Dialogue: 0,0:15:37.00,0:15:40.85,Default,,0000,0000,0000,,Әй, сен ондай нәрселерді шебер басқаратын түрің емессің ғой?
Dialogue: 0,0:15:41.33,0:15:44.80,Default,,0000,0000,0000,,Мен сөйлеген сөздер мен шешендік сөздер туралы кітап іздеуді ойладым.
Dialogue: 0,0:15:45.33,0:15:46.76,Default,,0000,0000,0000,,Бұл жерде ме?
Dialogue: 0,0:15:46.76,0:15:48.43,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:15:50.59,0:15:52.31,Default,,0000,0000,0000,,Бүгін қалай болдыңыз?
Dialogue: 0,0:15:53.56,0:15:55.91,Default,,0000,0000,0000,,Әлде саған бірдеңе ұсынайын ба?
Dialogue: 0,0:15:56.04,0:15:57.35,Default,,0000,0000,0000,,Олай болса, ыстық кофе.
Dialogue: 0,0:15:57.41,0:15:58.76,Default,,0000,0000,0000,,О, Оказаки мырза
Dialogue: 0,0:15:59.17,0:16:00.53,Default,,0000,0000,0000,,Мен оны бірден саламын.
Dialogue: 0,0:16:00.84,0:16:02.23,Default,,0000,0000,0000,,Отырыңыз.
Dialogue: 0,0:16:06.44,0:16:07.27,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:16:07.77,0:16:09.63,Default,,0000,0000,0000,,Ах, рахмет
Dialogue: 0,0:16:13.67,0:16:14.30,Default,,0000,0000,0000,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:16:14.35,0:16:15.30,Default,,0000,0000,0000,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:16:17.34,0:16:19.27,Default,,0000,0000,0000,,Менің атым Юкин Миядзава.
Dialogue: 0,0:16:20.56,0:16:23.96,Default,,0000,0000,0000,,Сіз Томоя Оказаки және Нагиса Когасыз ба?
Dialogue: 0,0:16:24.56,0:16:27.09,Default,,0000,0000,0000,,Мұнда бірінші рет келіп тұрсыз, солай ма?
Dialogue: 0,0:16:27.25,0:16:29.04,Default,,0000,0000,0000,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:16:29.31,0:16:31.18,Default,,0000,0000,0000,,Сіз бұл орынға жауаптысыз ба?
Dialogue: 0,0:16:31.55,0:16:33.23,Default,,0000,0000,0000,,Бұл менің ниетім
Dialogue: 0,0:16:33.61,0:16:35.13,Default,,0000,0000,0000,,Маған бұл жер ұнайды.
Dialogue: 0,0:16:35.34,0:16:38.15,Default,,0000,0000,0000,,Бұл бұрын кітапхана болған, солай ма?
Dialogue: 0,0:16:38.42,0:16:39.71,Default,,0000,0000,0000,,Бұл бүгінгі күні де солай.
Dialogue: 0,0:16:40.10,0:16:43.66,Default,,0000,0000,0000,,Мұнда көп оқылмайтын кітаптар жинақталған.
Dialogue: 0,0:16:44.06,0:16:46.55,Default,,0000,0000,0000,,Бұл екінші кітапхана сияқты.
Dialogue: 0,0:16:47.10,0:16:50.14,Default,,0000,0000,0000,,Ескі бейне таспалар мен жазбалар да бар.
Dialogue: 0,0:16:50.50,0:16:54.56,Default,,0000,0000,0000,,Керемет, мен оны білмей тұрып кофеханаға айналды деп ойладым.
Dialogue: 0,0:16:54.94,0:16:58.23,Default,,0000,0000,0000,,Кейде әртүрлі тұтынушылар көп болады.
Dialogue: 0,0:16:58.66,0:16:59.75,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:17:00.10,0:17:01.40,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:01.76,0:17:05.90,Default,,0000,0000,0000,,О, жоқ, мен бұл мектепте ерекше адамдар көп деп ойладым.
Dialogue: 0,0:17:07.96,0:17:10.47,Default,,0000,0000,0000,,Жоқ. Бұл қала ма?
Dialogue: 0,0:17:12.81,0:17:16.65,Default,,0000,0000,0000,,Әзірше мені қонақ ретінде елестетіп көріңіз және менімен сөйлесіп көріңіз.
Dialogue: 0,0:17:17.01,0:17:18.94,Default,,0000,0000,0000,,Сабырлы болыңыз және анық сөйлеңіз
Dialogue: 0,0:17:19.14,0:17:20.02,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:17:20.23,0:17:23.69,Default,,0000,0000,0000,,Ерм, мен 3 В сыныбының оқушысы Нагиса Фурукавамын.
Dialogue: 0,0:17:23.89,0:17:27.53,Default,,0000,0000,0000,,Бүгін бізге қосылғаныңыз үшін рахмет.
Dialogue: 0,0:17:28.05,0:17:29.37,Default,,0000,0000,0000,,Ерм, ерм.
Dialogue: 0,0:17:29.45,0:17:30.89,Default,,0000,0000,0000,,Сәттілік Енді не болады?
Dialogue: 0,0:17:31.52,0:17:36.18,Default,,0000,0000,0000,,Драма үйірмесін қайта жаңғыртуды ұйғарған себебім...
Dialogue: 0,0:17:37.69,0:17:40.87,Default,,0000,0000,0000,,Әй, менде актерлікке деген қызығушылығым осылай пайда болды.
Dialogue: 0,0:17:41.31,0:17:43.47,Default,,0000,0000,0000,,Театрда тәжірибеңіз бар ма?
Dialogue: 0,0:17:43.83,0:17:45.90,Default,,0000,0000,0000,,Жоқ, мен толық әуесқоймын.
Dialogue: 0,0:17:46.33,0:17:48.83,Default,,0000,0000,0000,,Мен ешқандай мәліметтерді білмеймін.
Dialogue: 0,0:17:51.33,0:17:53.43,Default,,0000,0000,0000,,Менеджердің таңқаларлық мәлімдемесі
Dialogue: 0,0:17:55.06,0:17:58.08,Default,,0000,0000,0000,,Сұрақ Сіз қандай театрды орындайсыз?
Dialogue: 0,0:17:58.24,0:18:00.22,Default,,0000,0000,0000,,Бұл қандай ойын түрі?
Dialogue: 0,0:18:00.80,0:18:02.18,Default,,0000,0000,0000,,Әртүрлі болуы мүмкін
Dialogue: 0,0:18:02.41,0:18:04.14,Default,,0000,0000,0000,,Мюзиклдер, балалар пьесалары және т.б.
Dialogue: 0,0:18:04.41,0:18:06.60,Default,,0000,0000,0000,,Бұл реалистік заманауи драма ма, әлде сюрреализм ме?
Dialogue: 0,0:18:06.84,0:18:08.06,Default,,0000,0000,0000,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:18:08.58,0:18:09.07,Default,,0000,0000,0000,,Қайтару
Dialogue: 0,0:18:09.60,0:18:10.66,Default,,0000,0000,0000,,Келесі шайқас үшін!
Dialogue: 0,0:18:11.58,0:18:13.63,Default,,0000,0000,0000,,Олай болса, сұраққа жауап беріңдер.
Dialogue: 0,0:18:14.11,0:18:15.79,Default,,0000,0000,0000,,Сіз орындағыңыз келетін әңгіме бар дедіңіз.
Dialogue: 0,0:18:16.06,0:18:16.72,Default,,0000,0000,0000,,Бұл қандай ойын түрі?
Dialogue: 0,0:18:17.05,0:18:20.09,Default,,0000,0000,0000,,Бұл қызықты ойын.
Dialogue: 0,0:18:20.41,0:18:22.29,Default,,0000,0000,0000,,Бұл мүлдем күлкілі.
Dialogue: 0,0:18:22.68,0:18:23.90,Default,,0000,0000,0000,,Бұл күлкілі ойын ма?
Dialogue: 0,0:18:23.91,0:18:27.59,Default,,0000,0000,0000,,Жоқ, мен жай ғана күлемін дегенім емес...
Dialogue: 0,0:18:27.64,0:18:29.61,Default,,0000,0000,0000,,Сонымен, сізді жылататын элемент бар ма?
Dialogue: 0,0:18:29.78,0:18:33.26,Default,,0000,0000,0000,,Сіз жылай аласыз ба, әлде жылай алмайсыз ба...
Dialogue: 0,0:18:33.26,0:18:35.67,Default,,0000,0000,0000,,Қайсысы сізді күлдіреді немесе жылайды?
Dialogue: 0,0:18:35.69,0:18:38.04,Default,,0000,0000,0000,,Бс, шамамен ортасы. Эххе...
Dialogue: 0,0:18:40.63,0:18:43.76,Default,,0000,0000,0000,,Жарайды, мен сізге жауап бермек болдым.
Dialogue: 0,0:18:45.12,0:18:47.47,Default,,0000,0000,0000,,Келесі сұрақ.
Dialogue: 0,0:18:47.97,0:18:50.03,Default,,0000,0000,0000,,Мына парақшада қандай сурет бар?
Dialogue: 0,0:18:50.30,0:18:51.66,Default,,0000,0000,0000,,Данго үлкен отбасы!
Dialogue: 0,0:18:51.92,0:18:52.56,Default,,0000,0000,0000,,Дереу жауап
Dialogue: 0,0:18:52.92,0:18:58.39,Default,,0000,0000,0000,,Данго отбасы - әрбір жапондық білетін ұлттық танымал кейіпкер.
Dialogue: 0,0:18:58.67,0:19:02.53,Default,,0000,0000,0000,,Мен 100 адамнан тұратын отбасына қызғанышпен қараймын, өйткені олар өте көңілді жүрген сияқты.
Dialogue: 0,0:19:02.86,0:19:07.20,Default,,0000,0000,0000,,Егер сіз отбасыңызбен ойын-сауық саябағына барсаңыз, сіз қиындыққа тап боласыз.
Dialogue: 0,0:19:07.49,0:19:08.44,Default,,0000,0000,0000,,Бірақ данго үлкен...
Dialogue: 0,0:19:08.44,0:19:09.54,Default,,0000,0000,0000,,Гү… гүг… Дұрыс.
Dialogue: 0,0:19:10.47,0:19:12.83,Default,,0000,0000,0000,,Кенеттен сөйлеп сөйлей бермеңіз!
Dialogue: 0,0:19:13.14,0:19:15.10,Default,,0000,0000,0000,,Шиеленістің айырмашылығы тым көп, сондықтан оны ұстайтынына сенімдімін!
Dialogue: 0,0:19:15.26,0:19:16.42,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:19:17.14,0:19:19.59,Default,,0000,0000,0000,,А, жоқ, толқу жаман емес.
Dialogue: 0,0:19:19.95,0:19:24.34,Default,,0000,0000,0000,,Дегенмен, үлкен Данго отбасының түсіндірмесі сізді қатты қызықтырады деп ойламаймын.
Dialogue: 0,0:19:24.39,0:19:25.69,Default,,0000,0000,0000,,Иә, бұл дұрыс.
Dialogue: 0,0:19:25.86,0:19:29.55,Default,,0000,0000,0000,,Содан кейін бұл Данго отбасы үшін ақпараттық сессия болады.
Dialogue: 0,0:19:29.73,0:19:30.97,Default,,0000,0000,0000,,Алдағы жол қиын.
Dialogue: 0,0:19:31.16,0:19:32.71,Default,,0000,0000,0000,,Мен де солай ойлаймын.
Dialogue: 0,0:19:34.23,0:19:37.57,Default,,0000,0000,0000,,Неліктен бірінші кезекте театрмен айналысқыңыз келеді?
Dialogue: 0,0:19:38.31,0:19:39.56,Default,,0000,0000,0000,,Сізде тәжірибе жоқ, солай ма?
Dialogue: 0,0:19:40.48,0:19:41.70,Default,,0000,0000,0000,,Өйткені маған ұнайды
Dialogue: 0,0:19:41.92,0:19:42.94,Default,,0000,0000,0000,,Қандай орын?
Dialogue: 0,0:19:43.49,0:19:45.06,Default,,0000,0000,0000,,Мен бұл қызықты деп ойладым.
Dialogue: 0,0:19:45.30,0:19:47.15,Default,,0000,0000,0000,,Бірге әрекет ету
Dialogue: 0,0:19:47.49,0:19:53.92,Default,,0000,0000,0000,,Кішкентай кезімнен ауруға байланысты мектептегі пьесаларды және басқаларды жіберіп алуға тура келді.
Dialogue: 0,0:19:54.30,0:19:58.14,Default,,0000,0000,0000,,Мектеп жиі жабылды, сондықтан мен практикаға қатыса алмадым.
Dialogue: 0,0:19:58.74,0:20:02.71,Default,,0000,0000,0000,,Сондықтан бәрімен бірге өнер көрсетуді аңсадым.
Dialogue: 0,0:20:03.02,0:20:06.65,Default,,0000,0000,0000,,Орта мектепте драма үйірмесіне міндетті түрде қатысқым келді.
Dialogue: 0,0:20:06.84,0:20:09.26,Default,,0000,0000,0000,,Үш жыл бойы театрда бар күшімізді салайық.
Dialogue: 0,0:20:10.72,0:20:15.09,Default,,0000,0000,0000,,Бірақ соңында мен орта мектепте де мектепке көп келе алмадым...
Dialogue: 0,0:20:15.73,0:20:18.81,Default,,0000,0000,0000,,Үшінші курс студенті болған соң үзіліс алдым...
Dialogue: 0,0:20:20.60,0:20:23.09,Default,,0000,0000,0000,,Бірақ мен оны әлі де байқағым келеді.
Dialogue: 0,0:20:23.77,0:20:29.68,Default,,0000,0000,0000,,Мен ештеңе білмеймін, мен оған жаман немесе жаман болуым мүмкін, бірақ...
Dialogue: 0,0:20:30.02,0:20:32.59,Default,,0000,0000,0000,,Сонда да мен мүмкіндігінше тырысқым келеді...
Dialogue: 0,0:20:33.01,0:20:36.03,Default,,0000,0000,0000,,Бәріміз бірігіп, бір іспен айналысайық...
Dialogue: 0,0:20:36.76,0:20:39.20,Default,,0000,0000,0000,,Менің ойымша, бұл тамаша.
Dialogue: 0,0:20:39.93,0:20:41.76,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:20:46.38,0:20:48.14,Default,,0000,0000,0000,,Маған ұнайды.
Dialogue: 0,0:20:51.11,0:20:52.37,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:20:52.86,0:20:53.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:53.67,0:20:56.28,Default,,0000,0000,0000,,Бұл туралы брифинг сессиясында айтқан дұрыс болар еді деп ойлаймын.
Dialogue: 0,0:20:56.56,0:21:00.39,Default,,0000,0000,0000,,Не айтайын, сіз айтқыңыз келген нәрсені дәл айттыңыз деп ойлаймын.
Dialogue: 0,0:21:00.91,0:21:01.85,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:21:02.02,0:21:04.23,Default,,0000,0000,0000,,Мен өз ойымды дәл айтатын адаммын.
Dialogue: 0,0:21:04.54,0:21:07.84,Default,,0000,0000,0000,,Мен кейде ренжіп қаламын.
Dialogue: 0,0:21:08.05,0:21:10.40,Default,,0000,0000,0000,,Сондықтан өз сөзіңізге сеніңіз
Dialogue: 0,0:21:11.54,0:21:12.07,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:21:12.67,0:21:14.44,Default,,0000,0000,0000,,Қолыңнан келгеннің бәрін істе, Нагиса Фурукава
Dialogue: 0,0:21:16.50,0:21:16.89,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:19.45,0:21:22.66,Default,,0000,0000,0000,,Брифингке адамдар келеді ме?
Dialogue: 0,0:21:22.92,0:21:25.07,Default,,0000,0000,0000,,Қақпақты ашпайынша білмейсің.
Dialogue: 0,0:21:25.46,0:21:27.56,Default,,0000,0000,0000,,Бірақ мен көптеген парақшалар салдым.
Dialogue: 0,0:21:27.69,0:21:29.60,Default,,0000,0000,0000,,Тіпті екі-үш адам келсе...
Dialogue: 0,0:21:31.76,0:21:33.41,Default,,0000,0000,0000,,Мұнда флайер жоқ па?
Dialogue: 0,0:21:34.15,0:21:35.49,Default,,0000,0000,0000,,Иә, мен сенімдімін...
Dialogue: 0,0:21:36.70,0:21:41.90,Default,,0000,0010,0000,,Егер ол жерде флайер болса, оны студенттік кеңестен біреу жұлып алыпты.
Dialogue: 0,0:21:42.06,0:21:44.14,Default,,0000,0000,0000,,Неге оны жұлып алдың?
Dialogue: 0,0:21:44.37,0:21:46.88,Default,,0000,0000,0000,,Рұқсат алмағаныңыз үшін емес пе?
Dialogue: 0,0:21:47.37,0:21:50.10,Default,,0000,0000,0000,,Кога мырза мен оның достары сонда болды ма?
Dialogue: 0,0:21:50.62,0:21:53.48,Default,,0000,0000,0000,,Олай болса, басқа жерде қалған адамдардың бәрі...
Dialogue: 0,0:21:53.82,0:21:58.76,Default,,0000,0000,0000,,Нагиса Кога, 3 В сыныбы, тез арада студенттер кеңесінің бөлмесіне келіңіз.
Dialogue: 0,0:21:59.70,0:22:06.63,Default,,0000,0010,0000,,Қайталап айтамын, 3В сыныбының оқушысы Нагиса Фурукава мырза, тез арада студенттік кеңес бөлмесіне келіңіз.
Dialogue: 0,0:22:03.30,0:22:04.07,Default,,0000,0000,0000,,Кога…
Dialogue: 0,0:23:41.14,0:23:41.82,Default,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:23:42.43,0:23:44.44,Default,,0000,0000,0000,,Маған кеңес беріңізші.
Dialogue: 0,0:23:44.81,0:23:46.86,Default,,0000,0000,0000,,Томойоны өзіңізге ұнататындай сөйлеуді үйреніңіз.
Dialogue: 0,0:23:48.94,0:23:49.86,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:23:51.56,0:23:53.28,Default,,0000,0000,0000,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:23:53.59,0:23:55.12,Default,,0000,0000,0000,,Форма саған да жарасады.
Dialogue: 0,0:23:56.01,0:23:56.69,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:23:57.33,0:23:59.74,Default,,0000,0000,0000,,Бұл жолы мүлдем басқаша!
Dialogue: 0,0:24:01.83,0:24:02.59,Default,,0000,0000,0000,,Бірінші кезекте?
Dialogue: 0,0:24:03.12,0:24:04.05,Default,,0000,0000,0000,,Иә?
