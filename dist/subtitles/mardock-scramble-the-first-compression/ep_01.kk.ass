Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.05,0:00:00.05,Default,,0000,0000,0000,,=================ПЕРЕКЕТ===============
Dialogue: 0,0:00:00.05,0:00:03.87,staff2,,0000,0000,0000,,Бұл субтитр осы жұмыстың Z нұсқасын көруге арналған.
Dialogue: 0,0:00:14.04,0:00:19.75,staff2,,0000,0000,0000,,http://www.lightnovel.cn
Dialogue: 0,0:00:04.27,0:00:08.32,staff,,0000,0000,0000,,： 33  cici   ：K &  ： ：
Dialogue: 0,0:00:22.96,0:00:24.43,*Default,NTP,0000,0000,0000,,Өлгені жақсы
Dialogue: 0,0:00:41.27,0:00:43.54,*Default,NTP,0000,0000,0000,,Не, Барот, бірдеңе дедің бе?
Dialogue: 0,0:00:44.75,0:00:46.22,*Default,NTP,0000,0000,0000,,Nothing Shell
Dialogue: 0,0:00:47.31,0:00:50.32,*Default,NTP,0000,0000,0000,,Сіз бүгінгі шоудасыз
Dialogue: 0,0:00:50.88,0:00:52.31,*Default,NTP,0000,0000,0000,,Тек еске түсіру
Dialogue: 0,0:01:09.53,0:01:11.50,*Default,NTP,0000,0000,0000,,Бүгінгі ставка жақсы өтті
Dialogue: 0,0:01:18.36,0:01:20.47,*Default,NTP,0000,0000,0000,,Іс жақсы жалғасады
Dialogue: 0,0:03:32.37,0:03:34.27,*Default,NTP,0000,0000,0000,,Жақында Орталық саябақ
Dialogue: 0,0:03:36.30,0:03:37.66,*Default,NTP,0000,0000,0000,,Егер ештеңе болмаса, шегініңіз
Dialogue: 0,0:03:38.32,0:03:38.93,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:03:41.59,0:03:42.63,*Default,NTP,0000,0000,0000,,Сол адам
Dialogue: 0,0:03:43.06,0:03:45.59,*Default,NTP,0000,0000,0000,,Мен қашып кеткен қызды қорғаймын.
Dialogue: 0,0:03:46.35,0:03:49.39,*Default,NTP,0000,0000,0000,,4 бала өз-өзіне қол жұмсады, 2 бала жоғалды
Dialogue: 0,0:03:50.03,0:03:52.24,*Default,NTP,0000,0000,0000,,Егер ол қызда ешнәрсе жоқ болса, онда жақсы.
Dialogue: 0,0:03:52.87,0:03:55.01,*Default,NTP,0000,0000,0000,,Хмм, мәселе мынада
Dialogue: 0,0:03:55.24,0:03:58.86,*Default,NTP,0000,0000,0000,,Ол біз қалағандай 09 таңдай ма
Dialogue: 0,0:03:59.69,0:04:02.23,*Default,NTP,0000,0000,0000,,Мақсатты өзгерту курсы Қашықтықты сақтаңыз
Dialogue: 0,0:04:02.78,0:04:04.76,*Default,NTP,0000,0000,0000,,Ештеңе болмаса, бір-бірімізді өткізбей-ақ үйге қайтуға болады.
Dialogue: 0,0:04:05.50,0:04:06.93,*Default,NTP,0000,0000,0000,,Не болса да...
Dialogue: 0,0:04:08.75,0:04:11.91,*Default,NTP,0000,0000,0000,,Дүние сен ойлағаннан да ыстық.
Dialogue: 0,0:04:12.08,0:04:12.83,*Default,NTP,0000,0000,0000,,Уфкок
Dialogue: 0,0:04:18.60,0:04:19.27,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:04:20.56,0:04:22.91,*Default,NTP,0000,0000,0000,,Тоқтау уақытын орнатуды ұмытпаңыз
Dialogue: 0,0:04:46.20,0:04:47.82,*Default,NTP,0000,0000,0000,,Сіз жоғалтқан нәрсе
Dialogue: 0,0:04:48.61,0:04:50.07,*Default,NTP,0000,0000,0000,,Мен оны қайтарамын
Dialogue: 0,0:04:50.78,0:04:53.34,*Default,NTP,0000,0000,0000,,Бұл мені жақсы көретініңді білдіре ме?
Dialogue: 0,0:04:53.89,0:04:55.48,*Default,NTP,0000,0000,0000,,Керемет сұрақ.
Dialogue: 0,0:04:56.42,0:04:58.22,*Default,NTP,0000,0000,0000,,Махаббаттың анықтамасы – беру.
Dialogue: 0,0:04:58.97,0:05:00.24,*Default,NTP,0000,0000,0000,,Бұл үшін ережелер бар.
Dialogue: 0,0:05:00.90,0:05:04.80,*Default,NTP,0000,0000,0000,,Ережені сақтасаң, сені сүйетін боласың.
Dialogue: 0,0:05:10.30,0:05:12.14,*Default,NTP,0000,0000,0000,,Неге мен?
Dialogue: 0,0:05:13.34,0:05:15.00,*Default,NTP,0000,0000,0000,,Еш күмәнданбаңыз
Dialogue: 0,0:05:17.67,0:05:20.23,*Default,NTP,0000,0000,0000,,Ережені ұмытқан балаға не болады?
Dialogue: 0,0:05:22.25,0:05:24.03,*Default,NTP,0000,0000,0000,,Сіз Балотты білесіз бе?
Dialogue: 0,0:05:28.36,0:05:30.10,*Default,NTP,0000,0000,0000,,Уфкок бұрылысы.
Dialogue: 0,0:05:38.31,0:05:40.13,*Default,NTP,0000,0000,0000,,Жазу Бастайық
Dialogue: 0,0:05:40.66,0:05:41.60,*Default,NTP,0000,0000,0000,,Дайын
Dialogue: 0,0:05:43.40,0:05:43.91,*Default,NTP,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:05:44.54,0:05:46.96,*Default,NTP,0000,0000,0000,,Сол көліктен шыққан иіс қорқыныш билейді.
Dialogue: 0,0:05:48.06,0:05:52.00,*Default,NTP,0000,0000,0000,,Сіздің мұрыныңыз ерекше. Маған түсіндіріп беріңізші.
Dialogue: 0,0:05:52.66,0:05:53.99,*Default,NTP,0000,0000,0000,,Екеуі де қорқады
Dialogue: 0,0:05:54.91,0:05:56.70,*Default,NTP,0000,0000,0000,,Ерлерге де? неге?
Dialogue: 0,0:05:57.70,0:05:58.91,*Default,NTP,0000,0000,0000,,Суицидке жақын
Dialogue: 0,0:05:59.93,0:06:01.63,*Default,NTP,0000,0000,0000,,Сіз сол қызбен өз-өзіне қол жұмсауды жоспарлап отырсыз ба?
Dialogue: 0,0:06:02.40,0:06:04.37,*Default,NTP,0000,0000,0000,,Ол керемет жынды жігіт.
Dialogue: 0,0:06:06.18,0:06:06.82,*Default,NTP,0000,0000,0000,,Тағы біреуі келді.
Dialogue: 0,0:06:07.90,0:06:10.82,*Default,NTP,0000,0000,0000,,Сізге не берілгенін сұрадыңыз.
Dialogue: 0,0:06:12.07,0:06:13.73,*Default,NTP,0000,0000,0000,,Бірақ бәрібір, Барот.
Dialogue: 0,0:06:14.67,0:06:17.96,*Default,NTP,0000,0000,0000,,Маған қиын, бірақ саған да қиын, өлгім келгені сонша.
Dialogue: 0,0:06:19.49,0:06:21.82,*Default,NTP,0000,0000,0000,,Жоқ, мен өлемін. Менің естеліктерім...
Dialogue: 0,0:06:23.43,0:06:25.52,*Default,NTP,0000,0000,0000,,Бірақ сіз пішін қалдыра аласыз
Dialogue: 0,0:06:26.33,0:06:29.26,*Default,NTP,0000,0000,0000,,Олардың күлінен жасалған көк гауһар сияқты
Dialogue: 0,0:06:34.53,0:06:35.45,*Default,NTP,0000,0000,0000,,Сол сияқты
Dialogue: 0,0:06:36.71,0:06:38.10,*Default,NTP,0000,0000,0000,,Бұл әдемі көрініс.
Dialogue: 0,0:06:38.84,0:06:41.19,*Default,NTP,0000,0000,0000,,Бұдан былай одан да сұлу боласың.
Dialogue: 0,0:06:42.03,0:06:43.07,*Default,NTP,0000,0000,0000,,Көк гауһар
Dialogue: 0,0:06:44.05,0:06:47.34,*Default,NTP,0000,0000,0000,,Ереже бұзған баланың жауабы осы, Барот.
Dialogue: 0,0:06:55.80,0:06:57.89,*Default,NTP,0000,0000,0000,,Құдай-ау, қайнаған.
Dialogue: 0,0:06:58.35,0:07:00.36,*Default,NTP,0000,0000,0000,,Мен оның Shell жағында екеніне сене алмаймын...
Dialogue: 0,0:07:01.79,0:07:03.14,*Default,NTP,0000,0000,0000,,Ер адамның иісі өзгерді.
Dialogue: 0,0:07:03.52,0:07:04.28,*Default,NTP,0000,0000,0000,,Кісі өлтіру ниетінің иісі
Dialogue: 0,0:07:05.14,0:07:07.35,*Default,NTP,0000,0000,0000,,Менің иіс сезу қабілетім бойынша оны төтенше жағдай ретінде анықтаңыз.
Dialogue: 0,0:07:08.08,0:07:09.10,*Default,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:07:10.88,0:07:12.86,*Default,NTP,0000,0000,0000,,Жылжы! оған көмектес
Dialogue: 0,0:07:19.57,0:07:20.57,*Default,NTP,0000,0000,0000,,Неге мен?
Dialogue: 0,0:07:26.96,0:07:29.11,*Default,NTP,0000,0000,0000,,Өл, ақымақ! Өл!
Dialogue: 0,0:07:32.54,0:07:33.22,*Default,NTP,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:07:33.69,0:07:35.30,*Default,NTP,0000,0000,0000,,Сіз қоқыссыз!
Dialogue: 0,0:07:36.08,0:07:37.24,*Default,NTP,0000,0000,0000,,Өл!
Dialogue: 0,0:08:01.83,0:08:03.32,*Default,NTP,0000,0000,0000,,Олай сөйлеме дедім ғой!
Dialogue: 0,0:08:09.20,0:08:10.20,*Default,NTP,0000,0000,0000,,Мына жаққа қара!
Dialogue: 0,0:08:10.35,0:08:13.13,*Default,NTP,0000,0000,0000,,Дүние сен ойлағаннан да ыстық.
Dialogue: 0,0:08:13.72,0:08:16.74,*Default,NTP,0000,0000,0000,,Сол от сені аздап күйдірсін, Уфкок.
Dialogue: 0,0:08:16.84,0:08:20.54,*Default,NTP,0000,0000,0000,,Өрт мені өртеп жібермей тұрып сөндіремін. Бұл менің пайдалылығым.
Dialogue: 0,0:08:21.71,0:08:23.49,*Default,NTP,0000,0000,0000,,Ауырды ма, Шелл мырза?
Dialogue: 0,0:08:24.51,0:08:26.82,*Default,NTP,0000,0000,0000,,Бұл бала кезімде жасаған A10 операциясы.
Dialogue: 0,0:08:27.76,0:08:30.84,*Default,NTP,0000,0000,0000,,Сіз күйзеліске түскен кезде, миыңыз автоматты түрде бақытты сезінеді.
Dialogue: 0,0:08:31.60,0:08:33.76,*Default,NTP,0000,0000,0000,,Төменгі елді мекендерде қылмыстың алдын алу шараларының бірі
Dialogue: 0,0:08:33.83,0:08:35.76,*Default,NTP,0000,0000,0000,,Ақауларға байланысты тоқтатылды
Dialogue: 0,0:08:44.06,0:08:46.39,*Default,NTP,0000,0000,0000,,Менің жағдайда есте сақтау қабілеті жоғалады.
Dialogue: 0,0:08:47.42,0:08:50.21,*Default,NTP,0000,0000,0000,,Ауыстыру - бұл батырлық таблетка.
Dialogue: 0,0:08:51.03,0:08:53.28,*Default,NTP,0000,0000,0000,,Бұнда стресс немесе жанама әсерлер жоқ.
Dialogue: 0,0:08:54.30,0:08:56.71,*Default,NTP,0000,0000,0000,,Сіз бақытсыздықты қалай пайдалану керектігін білесіз.
Dialogue: 0,0:08:57.80,0:08:58.33,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:59.49,0:09:02.07,*Default,NTP,0000,0000,0000,,Сіздің арқаңызда мен бұл ырымнан аман шыға аламын.
Dialogue: 0,0:09:03.44,0:09:05.23,*Default,NTP,0000,0000,0000,,Әдемі көк гауһар
Dialogue: 0,0:09:06.11,0:09:08.93,*Default,NTP,0000,0000,0000,,Маған осы қаланың даңқы баспалдақтарымен көтерілуге рұқсат етіңіз.
Dialogue: 0,0:09:12.02,0:09:13.37,*Default,NTP,0000,0000,0000,,Әзірше қарастырылды
Dialogue: 0,0:09:13.88,0:09:16.11,*Default,NTP,0000,0000,0000,,Ол менің жаңа серіктесім болуы мүмкін.
Dialogue: 0,0:09:17.78,0:09:19.19,*Default,NTP,0000,0000,0000,,Бірақ бұл қорқынышты
Dialogue: 0,0:09:19.95,0:09:21.87,*Default,NTP,0000,0000,0000,,Ол 09 таңдай ма?
Dialogue: 0,0:09:22.79,0:09:24.14,*Default,NTP,0000,0000,0000,,Немесе өз өміріңнен бас тарт
Dialogue: 0,0:09:24.93,0:09:26.14,*Default,NTP,0000,0000,0000,,Мен сізге соңғы нұсқаны айтпаймын.
Dialogue: 0,0:09:28.20,0:09:31.31,*Default,NTP,0000,0000,0000,,Сонымен, бұл иіс есте сақтаудың өзін-өзі өлтіруі ме?
Dialogue: 0,0:09:32.04,0:09:34.70,*Default,NTP,0000,0000,0000,,Қызды естеліктерімен бірге өлтіру
Dialogue: 0,0:09:35.25,0:09:37.28,*Default,NTP,0000,0000,0000,,Бұл оның ішіндегі романтиканың бір түрі.
Dialogue: 0,0:09:37.87,0:09:38.83,*Default,NTP,0000,0000,0000,,Өлім жалғыздық
Dialogue: 0,0:09:39.42,0:09:43.02,*Default,NTP,0000,0000,0000,,Өзгенің өлімі өз өліміңнің қадірін арттырмайды.
Dialogue: 0,0:09:50.40,0:09:51.81,*Default,NTP,0000,0000,0000,,Неліктен мен?
Dialogue: 0,0:09:52.91,0:09:53.95,*Default,NTP,0000,0000,0000,,Таңдау
Dialogue: 0,0:09:56.93,0:09:58.96,*Default,NTP,0000,0000,0000,,Сіздің ондай құқығыңыз бар.
Dialogue: 0,0:10:03.56,0:10:05.42,*Default,NTP,0000,0000,0000,,Әлде өлгенді қалайсың ба?
Dialogue: 0,0:10:09.36,0:10:10.42,*Default,NTP,0000,0000,0000,,Оны тірі қалдыру дұрыс па?
Dialogue: 0,0:10:22.36,0:10:23.42,*Default,NTP,0000,0000,0000,,Қарғыс атқан ұрық метаморфозға ұшыраған жағдайда—
Dialogue: 0,0:11:50.43,0:11:51.61,*Default,NTP,0000,0000,0000,,Сіз ояу сияқтысыз.
Dialogue: 0,0:11:56.64,0:11:58.22,*Default,NTP,0000,0000,0000,,Мен дәрігермін бе? Пасха
Dialogue: 0,0:11:58.52,0:11:59.71,*Default,NTP,0000,0000,0000,,Сіздің жөндеуші...
Dialogue: 0,0:12:00.05,0:12:01.59,*Default,NTP,0000,0000,0000,,Негізі бұл менің дәрігерім.
Dialogue: 0,0:12:02.18,0:12:03.49,*Default,NTP,0000,0000,0000,,Бұл жасырыну
Dialogue: 0,0:12:04.00,0:12:05.39,*Default,NTP,0000,0000,0000,,Бастапқыда мәйітханада
Dialogue: 0,0:12:05.74,0:12:09.31,*Default,NTP,0000,0000,0000,,Біз 800 денені сақтай алдық.
Dialogue: 0,0:12:09.56,0:12:12.48,*Default,NTP,0000,0000,0000,,800 денені манипуляциялау арман сияқты.
Dialogue: 0,0:12:13.05,0:12:13.56,*Default,NTP,0000,0000,0000,,Сонымен...
Dialogue: 0,0:12:14.44,0:12:17.02,*Default,NTP,0000,0000,0000,,Жарықты жағып жіберсеңіз, қуанар едім.
Dialogue: 0,0:12:26.74,0:12:31.12,*Default,NTP,0000,0000,0000,,Иә әәәә
Dialogue: 0,0:12:35.26,0:12:38.14,*Default,NTP,0000,0000,0000,,А-а, сен дыбыс шығара аласың ба?
Dialogue: 0,0:12:40.94,0:12:44.09,*Default,NTP,0000,0000,0000,,Мен иіс сезу мен құлақ қалқанын сәтті қалпына келтіре алдым.
Dialogue: 0,0:12:44.68,0:12:47.24,*Default,NTP,0000,0000,0000,,Жарайды, мен оны ақырында емдеудің жолын табамын.
Dialogue: 0,0:12:47.83,0:12:49.44,*Default,NTP,0000,0000,0000,,Теріңізде ауырсыну немесе қышу бар ма?
Dialogue: 0,0:12:53.25,0:12:57.72,*Default,NTP,0000,0000,0000,,Сіз ес-түссіз жатқанда құзырлы органдар қойған сұрақтар мен жауаптарға жауап бердім.
Dialogue: 0,0:12:58.31,0:12:59.38,*Default,NTP,0000,0000,0000,,«Сіз өмір сүргіңіз келе ме?»
Dialogue: 0,0:12:59.54,0:13:01.46,*Default,NTP,0000,0000,0000,,«Өз құқықтарыңызды пайдаланғыңыз келе ме?»
Dialogue: 0,0:13:02.07,0:13:03.61,*Default,NTP,0000,0000,0000,,Ал сіздің бейсаналық\NТаңдалған
Dialogue: 0,0:13:03.75,0:13:05.32,*Default,NTP,0000,0000,0000,,09
Dialogue: 0,0:13:05.79,0:13:07.51,*Default,NTP,0000,0000,0000,,Мардук Скрембл 09
Dialogue: 0,0:13:08.24,0:13:09.31,*Default,NTP,0000,0000,0000,,Адам өмірін қорғау
Dialogue: 0,0:13:09.37,0:13:12.97,*Default,NTP,0000,0000,0000,,Бұл тыйым салынған ғылым мен технологияға арнайы рұқсат беретін төтенше заң.
Dialogue: 0,0:13:13.76,0:13:16.62,*Default,NTP,0000,0000,0000,,Мен әскерилердің ғарышты игеру саласында жұмыс істедім.
Dialogue: 0,0:13:17.07,0:13:19.40,*Default,NTP,0000,0000,0000,,Біз де сол теріні әзірледік.
Dialogue: 0,0:13:20.24,0:13:21.77,*Default,NTP,0000,0000,0000,,Бірақ соғыс аяқталды
Dialogue: 0,0:13:22.12,0:13:25.92,*Default,NTP,0000,0000,0000,,Енді мен 09 офицері ретінде пайдалы екенімді дәлелдеймін.
Dialogue: 0,0:13:26.43,0:13:30.34,*Default,NTP,0000,0000,0000,,Олай етпесеңіз, сіз адамдарға эксперимент жасау үшін түрмеге жіберілесіз.
Dialogue: 0,0:13:32.46,0:13:35.67,*Default,NTP,0000,0000,0000,,Сіздің теріңіз де сізді қорғауға арналған.
Dialogue: 0,0:13:36.59,0:13:38.59,*Default,NTP,0000,0000,0000,,Егер сіз мақұлдасаңыз
Dialogue: 0,0:13:38.98,0:13:41.31,*Default,NTP,0000,0000,0000,,Өмірді сақтау бағдарламасы жұмыс істейді.
Dialogue: 0,0:13:42.33,0:13:43.11,*Default,NTP,0000,0000,0000,,(Aizawa) Қызық. Жер асты әлемін басқарып отырған—
Dialogue: 0,0:13:43.58,0:13:47.93,*Default,NTP,0000,0000,0000,,Бізді іске жауапты адам етіп тағайындауыңызды қалаймын.
Dialogue: 0,0:13:52.85,0:13:53.71,*Default,NTP,0000,0000,0000,,Кімнің ісі?
Dialogue: 0,0:13:54.35,0:13:55.76,*Default,NTP,0000,0000,0000,,Shell Septinos
Dialogue: 0,0:13:56.82,0:13:59.70,*Default,NTP,0000,0000,0000,,Құмар ойыншыны көрсету білікті казино менеджері
Dialogue: 0,0:14:02.46,0:14:03.99,*Default,NTP,0000,0000,0000,,Ол оқиғаға себепкер болды.
Dialogue: 0,0:14:04.52,0:14:07.02,*Default,NTP,0000,0000,0000,,Ол ірі компанияда жұмыс істейді.
Dialogue: 0,0:14:07.57,0:14:10.55,*Default,NTP,0000,0000,0000,,Қазан ротасы – біздің жауымыз
Dialogue: 0,0:14:11.37,0:14:11.88,*Default,NTP,0000,0000,0000,,Жау?
Dialogue: 0,0:14:13.90,0:14:15.07,*Default,NTP,0000,0000,0000,,09-дан басқа
Dialogue: 0,0:14:15.29,0:14:17.95,*Default,NTP,0000,0000,0000,,Тыйым салынған ғылым мен технологияны пайдалануға рұқсат етілген компания
Dialogue: 0,0:14:18.68,0:14:22.75,*Default,NTP,0000,0000,0000,,Көңіл көтеру және ләззат Бұл October Inc.
Dialogue: 0,0:14:24.00,0:14:27.00,*Default,NTP,0000,0000,0000,,Shell компанияның лас ақшасын жылыстатуға жауапты.
Dialogue: 0,0:14:27.57,0:14:30.31,*Default,NTP,0000,0000,0000,,Біз сені қорғаймыз және оны ұстаймыз
Dialogue: 0,0:14:30.74,0:14:33.70,*Default,NTP,0000,0000,0000,,Істі шешкені үшін төлемді билік органдары төлейді.
Dialogue: 0,0:14:33.85,0:14:35.64,*Default,NTP,0000,0000,0000,,Үйіндіні сен екеуміз бөлеміз.
Dialogue: 0,0:14:36.07,0:14:38.63,*Default,NTP,0000,0000,0000,,Жаңа өмір бастауға қалай қарайсыз?
Dialogue: 0,0:14:43.23,0:14:43.92,*Default,NTP,0000,0000,0000,,егеуқұйрықтар ше?
Dialogue: 0,0:14:44.15,0:14:44.64,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:14:45.66,0:14:48.48,*Default,NTP,0000,0000,0000,,Сүйкімді, сөйлейтін... алтын тышқан
Dialogue: 0,0:14:49.56,0:14:52.71,*Default,NTP,0000,0000,0000,,Оның есі бар ма? үлкен қабілет
Dialogue: 0,0:14:53.01,0:14:54.83,*Default,NTP,0000,0000,0000,,Жүр, Уфукок, мен сені шақырып жатырмын!
Dialogue: 0,0:14:57.45,0:14:59.57,*Default,NTP,0000,0000,0000,,Одан да шыға алмайтын жігіт екен.
Dialogue: 0,0:15:05.23,0:15:07.56,*Default,NTP,0000,0000,0000,,Әйелді таң қалдыратын нәрсе емес, доктор.
Dialogue: 0,0:15:09.30,0:15:11.32,*Default,NTP,0000,0000,0000,,Бұл да ғарышты игеруге арналған.
Dialogue: 0,0:15:11.88,0:15:13.88,*Default,NTP,0000,0000,0000,,Кез келген затқа айнала алады
Dialogue: 0,0:15:14.00,0:15:15.43,*Default,NTP,0000,0000,0000,,Әмбебап Idem
Dialogue: 0,0:15:21.68,0:15:23.09,*Default,NTP,0000,0000,0000,,Қайырлы кеш, жас ханым.
Dialogue: 0,0:15:23.52,0:15:25.32,*Default,NTP,0000,0000,0000,,Сіз егеуқұйрықтарды жек көрмейсіз бе?
Dialogue: 0,0:15:25.75,0:15:27.69,*Default,NTP,0000,0000,0000,,Бірдеңе болса, мен тағы да радиода боламын.
Dialogue: 0,0:15:28.06,0:15:31.90,*Default,NTP,0000,0000,0000,,Радиода, теледидарда қалағаныңызша бола аласыз.
Dialogue: 0,0:15:31.96,0:15:34.42,*Default,NTP,0000,0000,0000,,Жұмыс туралы не айтасыз?
Dialogue: 0,0:15:34.42,0:15:36.29,*Default,NTP,0000,0000,0000,,Ол бәрін жоғалтты.
Dialogue: 0,0:15:37.07,0:15:39.71,*Default,NTP,0000,0000,0000,,Ең алдымен психикалық күтім қажет.
Dialogue: 0,0:15:40.71,0:15:41.69,*Default,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:15:42.92,0:15:46.59,*Default,NTP,0000,0000,0000,,Балалар, сендермен ынтымақтасу үшін басымды изеп қоюым керек пе?
Dialogue: 0,0:15:46.98,0:15:48.88,*Default,NTP,0000,0000,0000,,Ой! Тез сөйлейді
Dialogue: 0,0:15:49.52,0:15:53.46,*Default,NTP,0000,0000,0000,,Содан кейін бұл әтешті ұстаңыз және қабықты есте сақтаңыз.
Dialogue: 0,0:16:17.21,0:16:19.53,*Default,NTP,0000,0000,0000,,Мен оның мұндай анық пішінге ие болады деп күтпедім.
Dialogue: 0,0:16:20.41,0:16:22.91,*Default,NTP,0000,0000,0000,,Бұл сіздің жүрегіңіздің физикалық дәлелі.
Dialogue: 0,0:16:23.79,0:16:27.03,*Default,NTP,0000,0000,0000,,Осыны негізге ала отырып, біз Shell-ті жеңдік.
Dialogue: 0,0:16:27.59,0:16:29.08,*Default,NTP,0000,0000,0000,,Қазан айы...
Dialogue: 0,0:16:30.30,0:16:31.22,*Default,NTP,0000,0000,0000,,Бір минут күтіңіз!
Dialogue: 0,0:16:37.40,0:16:39.85,*Default,NTP,0000,0000,0000,,Неліктен? Егер сіз ер адамдармен тәжірибесіз болсаңыз да?
Dialogue: 0,0:16:40.71,0:16:41.42,*Default,NTP,0000,0000,0000,,Қайырлы таң, Камилла.
Dialogue: 0,0:16:43.16,0:16:45.06,*Default,NTP,0000,0000,0000,,Мен жүрегімнің қабығын жарған жоқпын.
Dialogue: 0,0:16:46.45,0:16:48.53,*Default,NTP,0000,0000,0000,,Тым көп нәрсе маған ауыр тиді
Dialogue: 0,0:16:49.57,0:16:51.03,*Default,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:51.92,0:16:53.70,*Default,NTP,0000,0000,0000,,Оған көмектескен біз болдық.
Dialogue: 0,0:16:54.68,0:16:57.61,*Default,NTP,0000,0000,0000,,Мен оның өмірінің мәнін бірге іздеуге міндеттімін.
Dialogue: 0,0:16:58.67,0:17:01.32,*Default,NTP,0000,0000,0000,,Оған өз өмірін беруді таңдауға мүмкіндік бермеу
Dialogue: 0,0:17:02.02,0:17:03.59,*Default,NTP,0000,0000,0000,,Менің қазіргі пайдалылығым
Dialogue: 0,0:17:22.07,0:17:23.56,*Default,NTP,0000,0000,0000,,Қайта туылғанда қандай сезім бар?
Dialogue: 0,0:17:24.46,0:17:28.05,*Default,NTP,0000,0000,0000,,Жадты сақтауды көптен армандаған сияқтымын
Dialogue: 0,0:17:28.79,0:17:32.28,*Default,NTP,0000,0000,0000,,Естеліктерді шығарып, жазып алыңыз және оларды санаңыздан өшіріңіз
Dialogue: 0,0:17:32.92,0:17:35.20,*Default,NTP,0000,0000,0000,,Олай етпесең миың шіріп кетеді.
Dialogue: 0,0:17:36.12,0:17:38.19,*Default,NTP,0000,0000,0000,,Дәрігер деректерді көшіріп алуы мүмкін бе?
Dialogue: 0,0:17:38.58,0:17:41.54,*Default,NTP,0000,0000,0000,,Енді бұл жай ғана арман.
Dialogue: 0,0:17:42.34,0:17:47.40,*Default,NTP,0000,0000,0000,,Менің ең соңғы естелігім, мен мәміле жасауға дайын болдым.
Dialogue: 0,0:17:48.81,0:17:50.47,*Default,NTP,0000,0000,0000,,Чип – менің жадым
Dialogue: 0,0:17:51.10,0:17:53.80,*Default,NTP,0000,0000,0000,,Карточкаларда козир бар, сен.
Dialogue: 0,0:17:54.64,0:17:57.66,*Default,NTP,0000,0000,0000,,Адам үшін өткеннің орны толмас.
Dialogue: 0,0:17:58.24,0:18:00.11,*Default,NTP,0000,0000,0000,,Бірақ мен тек қабықпен жақсымын.
Dialogue: 0,0:18:00.73,0:18:01.79,*Default,NTP,0000,0000,0000,,Мазмұны кейінірек келеді.
Dialogue: 0,0:18:02.89,0:18:05.39,*Default,NTP,0000,0000,0000,,Даңқ ыдысы, бұл менмін
Dialogue: 0,0:18:07.68,0:18:09.96,*Default,NTP,0000,0000,0000,,Scramble 09 шығарылды
Dialogue: 0,0:18:10.92,0:18:13.40,*Default,NTP,0000,0000,0000,,Руна? Балот? Бұл бала кім?
Dialogue: 0,0:18:14.05,0:18:15.85,*Default,NTP,0000,0000,0000,,Түсінде өлді деген әйел.
Dialogue: 0,0:18:16.40,0:18:17.01,*Default,NTP,0000,0000,0000,,Сіз жақсысыз ба?
Dialogue: 0,0:18:18.10,0:18:19.36,*Default,NTP,0000,0000,0000,,Қалпына келтіру керек еді
Dialogue: 0,0:18:19.36,0:18:22.14,*Default,NTP,0000,0000,0000,,Көк гауһардың шикізаты тірі және айнала қозғала ма?
Dialogue: 0,0:18:22.49,0:18:24.39,*Default,NTP,0000,0000,0000,,Бірінші сот мәмілесі болды.
Dialogue: 0,0:18:24.94,0:18:27.64,*Default,NTP,0000,0000,0000,,Бұл арам қылмыс жасаушылардың ісі ме?
Dialogue: 0,0:18:29.68,0:18:30.97,*Default,NTP,0000,0000,0000,,Убкок?Пентейно
Dialogue: 0,0:18:32.46,0:18:33.91,*Default,NTP,0000,0000,0000,,Біз бұрын бірге жұмыс істегенбіз.
Dialogue: 0,0:18:34.92,0:18:36.94,*Default,NTP,0000,0000,0000,,Мен сіздің мәмілеңізді түсінген болармын.
Dialogue: 0,0:18:37.33,0:18:41.00,*Default,NTP,0000,0000,0000,,Әлде мені нысанаға алу үшін әйелдерге көз салдың ба?
Dialogue: 0,0:18:42.46,0:18:43.89,*Default,NTP,0000,0000,0000,,Бұл менің ойыным
Dialogue: 0,0:18:44.46,0:18:46.36,*Default,NTP,0000,0000,0000,,Бұл да сенің ойының.
Dialogue: 0,0:18:47.83,0:18:51.39,*Default,NTP,0000,0000,0000,,Іс қатысушының қайтыс болуына немесе жоғалып кетуіне байланысты аяқталмайды.
Dialogue: 0,0:18:54.14,0:18:55.41,*Default,NTP,0000,0000,0000,,Дәрігерлер
Dialogue: 0,0:18:56.86,0:18:58.87,*Default,NTP,0000,0000,0000,,Әрине, менен басқа біреу
Dialogue: 0,0:18:58.87,0:19:01.26,*Default,NTP,0000,0000,0000,,Мен чипті алатын-алмайтынымды білмеймін.
Dialogue: 0,0:19:02.16,0:19:03.07,*Default,NTP,0000,0000,0000,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:19:03.97,0:19:04.91,*Default,NTP,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:19:06.00,0:19:08.12,*Default,NTP,0000,0000,0000,,Ол әйел есімде жоқ.
Dialogue: 0,0:19:08.12,0:19:09.23,*Default,NTP,0000,0000,0000,,Менің саусағым ауырып тұр.
Dialogue: 0,0:19:10.08,0:19:11.80,*Default,NTP,0000,0000,0000,,Мен оны неке жүзігіне айналдырғым келеді
Dialogue: 0,0:19:11.80,0:19:13.41,*Default,NTP,0000,0000,0000,,Ол ерекше әйел болды ма?
Dialogue: 0,0:19:14.54,0:19:15.81,*Default,NTP,0000,0000,0000,,Әйелдің есте сақтау қабілеті
Dialogue: 0,0:19:16.48,0:19:19.67,*Default,NTP,0000,0000,0000,,Ол әрқашан менің миымды жоюға тырысады.
Dialogue: 0,0:19:20.40,0:19:21.87,*Default,NTP,0000,0000,0000,,Мен жай ғана әйел болсам да
Dialogue: 0,0:19:23.73,0:19:26.45,*Default,NTP,0000,0000,0000,,Салмағы небәрі 20 грамм оқ адамды өлтіруі мүмкін.
Dialogue: 0,0:19:27.64,0:19:29.35,*Default,NTP,0000,0000,0000,,Маған сақинаны беріңіз.
Dialogue: 0,0:19:35.61,0:19:36.98,*Default,NTP,0000,0000,0000,,Бароттың сотқа келген мәселелері
Dialogue: 0,0:19:38.00,0:19:38.82,*Default,NTP,0000,0000,0000,,Оны тоқтатуға болады ма?
Dialogue: 0,0:19:39.45,0:19:42.27,*Default,NTP,0000,0000,0000,,Не? Мен барлық жазбаларды жібердім.
Dialogue: 0,0:19:43.15,0:19:44.43,*Default,NTP,0000,0000,0000,,Жұмыртқаны сындырайын
Dialogue: 0,0:19:44.54,0:19:47.05,*Default,NTP,0000,0000,0000,,Мазмұнды қабықшаға қайта салғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:19:47.58,0:19:49.05,*Default,NTP,0000,0000,0000,,Мен жұмыртқаны әлі қуырған жоқпын.
Dialogue: 0,0:19:49.24,0:19:49.63,*Default,NTP,0000,0000,0000,,Жоқ…
Dialogue: 0,0:19:50.54,0:19:50.91,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:19:52.59,0:19:54.22,*Default,NTP,0000,0000,0000,,Деректерді жіберуді тоқтаттыңыз ба?
Dialogue: 0,0:19:55.14,0:19:56.88,*Default,NTP,0000,0000,0000,,Қабілетіңіз тамаша.
Dialogue: 0,0:19:57.55,0:19:58.43,*Default,NTP,0000,0000,0000,,Бірақ неге?
Dialogue: 0,0:19:58.94,0:20:00.88,*Default,NTP,0000,0000,0000,,Бұл жерде мәңгілікке құлыпта қалғыңыз келе ме?
Dialogue: 0,0:20:01.60,0:20:03.23,*Default,NTP,0000,0000,0000,,Мен сотта өз міндеттерімді орындауым керек.
Dialogue: 0,0:20:03.54,0:20:06.24,*Default,NTP,0000,0000,0000,,Біздің қолымыздан келетіні – жаудың өлтірушіні босатуын күту.
Dialogue: 0,0:20:07.83,0:20:09.16,*Default,NTP,0000,0000,0000,,Одақтастар жоқ
Dialogue: 0,0:20:10.06,0:20:11.88,*Default,NTP,0000,0000,0000,,Егер бізге сенуге болмайтын болса ше?
Dialogue: 0,0:20:13.80,0:20:14.86,*Default,NTP,0000,0000,0000,,Мен сатқындықты қаламаймын
Dialogue: 0,0:20:15.31,0:20:16.60,*Default,NTP,0000,0000,0000,,Біз ешқашан...
Dialogue: 0,0:20:17.44,0:20:20.09,*Default,NTP,0000,0000,0000,,Балалар сендер маған үнемі қарап отырдыңдар.
Dialogue: 0,0:20:23.06,0:20:26.90,*Default,NTP,0000,0000,0000,,Мені тірілтіп, зорладың.
Dialogue: 0,0:20:27.00,0:20:27.82,*Default,NTP,0000,0000,0000,,Зорлау! ?
Dialogue: 0,0:20:28.47,0:20:29.68,*Default,NTP,0000,0000,0000,,Ах... ау, докудах
Dialogue: 0,0:20:32.48,0:20:35.05,*Default,NTP,0000,0000,0000,,Толық жауапкершілікті дәлелдеңіз
Dialogue: 0,0:20:35.95,0:20:40.24,*Default,NTP,0000,0000,0000,,Ең алдымен, біз сіздің өміріңізді сақтауға басымдық бердік.
Dialogue: 0,0:20:40.69,0:20:42.69,*Default,NTP,0000,0000,0000,,Бірақ мен сені ауруханаға апара алмаймын.
Dialogue: 0,0:20:43.67,0:20:46.29,*Default,NTP,0000,0000,0000,,Жау біліп, сол жерде өлтіріледі.
Dialogue: 0,0:20:47.21,0:20:48.74,*Default,NTP,0000,0000,0000,,Ал менің кезегім.
Dialogue: 0,0:20:49.58,0:20:53.55,*Default,NTP,0000,0000,0000,,Мен сені құтқару үшін менің дағдыларым керек еді, солай ма?
Dialogue: 0,0:20:54.95,0:20:58.51,*Default,NTP,0000,0000,0000,,Екіншіден, сізге де қарсылық керек болды.
Dialogue: 0,0:20:59.78,0:21:00.57,*Default,NTP,0000,0000,0000,,Қарсылық?
Dialogue: 0,0:21:01.27,0:21:03.41,*Default,NTP,0000,0000,0000,,Өзін-өзі қорғау және мылтықты қолдану
Dialogue: 0,0:21:04.80,0:21:06.40,*Default,NTP,0000,0000,0000,,Мен солдат болғым келмейді.
Dialogue: 0,0:21:08.01,0:21:11.16,*Default,NTP,0000,0000,0000,,Кома кезінде, санадан тыс санаға
Dialogue: 0,0:21:11.43,0:21:14.37,*Default,NTP,0000,0000,0000,,Бізде бар технология мен жоспарларды қолдандық.
Dialogue: 0,0:21:15.72,0:21:18.35,*Default,NTP,0000,0000,0000,,Сіз өзіңіздің ағымдағы жағдайыңызды таңдадыңыз.
Dialogue: 0,0:21:20.17,0:21:21.52,*Default,NTP,0000,0000,0000,,Мен бұл ақтауды білемін.
Dialogue: 0,0:21:22.17,0:21:24.18,*Default,NTP,0000,0000,0000,,Сіздер әрқашан
Dialogue: 0,0:21:24.46,0:21:26.18,*Default,NTP,0000,0000,0000,,Сенің де қалағаның осы еді.
Dialogue: 0,0:21:26.55,0:21:27.45,*Default,NTP,0000,0000,0000,,Айтыңызшы
Dialogue: 0,0:21:30.29,0:21:31.08,*Default,NTP,0000,0000,0000,,Балалар
Dialogue: 0,0:21:31.29,0:21:33.17,*Default,NTP,0000,0000,0000,,Мен сенің өтірік айтпайтыныңды білемін.
Dialogue: 0,0:21:35.72,0:21:37.68,*Default,NTP,0000,0000,0000,,Жарайды, мен оны Уфкокке қалдырамын.
Dialogue: 0,0:21:38.17,0:21:40.10,*Default,NTP,0000,0000,0000,,Мен не істеу керектігін білемін, бірақ
Dialogue: 0,0:21:40.38,0:21:41.75,*Default,NTP,0000,0000,0000,,Мен не істерімді білмеймін
Dialogue: 0,0:21:42.26,0:21:45.29,*Default,NTP,0000,0000,0000,,15 жасар қыз баланың денесін өзгерту
Dialogue: 0,0:21:45.37,0:21:47.76,*Default,NTP,0000,0000,0000,,Сотта қатысуға қатысты.
Dialogue: 0,0:21:49.41,0:21:52.50,*Default,NTP,0000,0000,0000,,Енді не істегіңіз келеді? Дауыс беру
Dialogue: 0,0:21:55.07,0:21:56.61,*Default,NTP,0000,0000,0000,,Мен тапсырыс берген киімдер келді.
Dialogue: 0,0:21:57.06,0:21:59.55,*Default,NTP,0000,0000,0000,,Оны түскі асқа бару үшін кигісі келеді.
Dialogue: 0,0:22:00.33,0:22:02.64,*Default,NTP,0000,0000,0000,,Сонымен қатар, мен басқарылатын сәйкестікті де босатамын.
Dialogue: 0,0:22:03.31,0:22:05.80,*Default,NTP,0000,0000,0000,,Өзіңді жапқың келмейтін сияқты емес пе?
Dialogue: 0,0:22:06.44,0:22:07.68,*Default,NTP,0000,0000,0000,,Жау сізді тауып алады.
Dialogue: 0,0:22:08.30,0:22:11.10,*Default,NTP,0000,0000,0000,,Бұл менің пайдалылығымды сезінудің жақсы мүмкіндігі.
Dialogue: 0,0:22:17.47,0:22:18.14,*Default,NTP,0000,0000,0000,,Иә, бұл
Dialogue: 0,0:22:23.70,0:22:27.97,*Default,NTP,0000,0000,0000,,Сіз әлеуметтік төлемдер бөліміне жүгіндіңіз. Бұл әзірге сіздің меншігіңіз.
Dialogue: 0,0:22:28.34,0:22:31.10,*Default,NTP,0000,0000,0000,,Мен нөмірді білмеймін, сондықтан Уфкоктан сұраңыз.
Dialogue: 0,0:22:31.55,0:22:34.80,*Default,NTP,0000,0000,0000,,Сондай-ақ... иә, дәріңді іш.
Dialogue: 0,0:22:35.31,0:22:37.72,*Default,NTP,0000,0000,0000,,Кейбір жерлерде терім әлі де тұрақсыз.
Dialogue: 0,0:22:38.36,0:22:41.81,*Default,NTP,0000,0000,0000,,Сондай-ақ... бүгіннен бастап күн тағы суытатын сияқты.
Dialogue: 0,0:22:42.28,0:22:44.55,*Default,NTP,0000,0000,0000,,Сақтықты түсіріп, суық тигізбе
Dialogue: 0,0:22:46.41,0:22:50.35,*Default,NTP,0000,0000,0000,,Уфукокты теріс пайдаланбай меңгере аласыз деп үміттенемін.
Dialogue: 0,0:23:03.51,0:23:04.21,*Default,NTP,0000,0000,0000,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:23:05.29,0:23:06.00,*Default,NTP,0000,0000,0000,,Тым тығыз емес пе?
Dialogue: 0,0:23:15.14,0:23:17.79,*Default,NTP,0000,0000,0000,,Фуичиму Ақ халатымның да жаңашыл екенін мақтан тұтамын.
Dialogue: 0,0:23:18.18,0:23:20.63,*Default,NTP,0000,0000,0000,,Сіздің костюміңізді де жеңу қиын.
Dialogue: 0,0:23:23.76,0:23:25.91,*Default,NTP,0000,0000,0000,,Кеттік.
Dialogue: 0,0:23:30.67,0:23:32.00,*Default,NTP,0000,0000,0000,,Бұл жолы клиент
Dialogue: 0,0:23:32.40,0:23:35.06,*Default,NTP,0000,0000,0000,,Бұл маған заттардың қалай болатыны туралы көп нәрсені үйретеді.
Dialogue: 0,0:23:35.63,0:23:36.80,*Default,NTP,0000,0000,0000,,Бұл үшін кешіріңіз
Dialogue: 0,0:23:38.84,0:23:39.21,*Default,NTP,0000,0000,0000,,Жоқ... не?
Dialogue: 0,0:23:40.01,0:23:43.11,*Default,NTP,0000,0000,0000,,Мен сені ренжіттім, бірақ рахмет
Dialogue: 0,0:23:43.60,0:23:45.11,*Default,NTP,0000,0000,0000,,Мен ақшаны дұрыстап қайтарамын.
Dialogue: 0,0:23:45.61,0:23:47.51,*Default,NTP,0000,0000,0000,,Сөйлегенде
Dialogue: 0,0:23:47.51,0:23:49.22,*Default,NTP,0000,0000,0000,,Уфкоктың дауысын беріңізші
Dialogue: 0,0:23:50.00,0:23:51.27,*Default,NTP,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:23:52.19,0:23:55.05,*Default,NTP,0000,0000,0000,,Мен өз дауысымды есіме түсіре алмаймын...
Dialogue: 0,0:23:56.17,0:23:58.36,*Default,NTP,0000,0000,0000,,Бір-бірден қайтарып аламын
Dialogue: 0,0:24:39.43,0:24:40.29,*Default,NTP,0000,0000,0000,,Жоқ, Балот
Dialogue: 0,0:24:43.74,0:24:45.89,*Default,NTP,0000,0000,0000,,Сізге бағдаршам қауіп төндіре ме?
Dialogue: 0,0:24:46.09,0:24:47.36,*Default,NTP,0000,0000,0000,,Сіздің өміріңізге қауіп төніп тұрғанын қаншалықты сезінесіз?
Dialogue: 0,0:24:47.97,0:24:49.59,*Default,NTP,0000,0000,0000,,Мен сені бұрын тоқтатқан жоқпын.
Dialogue: 0,0:24:50.34,0:24:51.71,*Default,NTP,0000,0000,0000,,Мен сіздің ұстамдылығыңызды көрдім.
Dialogue: 0,0:24:53.10,0:24:54.16,*Default,NTP,0000,0000,0000,,Қауіпсіздік белдігіне не болды?
Dialogue: 0,0:24:54.63,0:24:56.15,*Default,NTP,0000,0000,0000,,Көліктерді жарып, көңіл көтергіңіз келе ме?
Dialogue: 0,0:24:56.92,0:25:00.17,*Default,NTP,0000,0000,0000,,Сіз неге кенет ашуланасыз? Бағдаршамды бұзғаны үшін болды ма?
Dialogue: 0,0:25:00.38,0:25:01.44,*Default,NTP,0000,0000,0000,,Ашулы емес
Dialogue: 0,0:25:02.26,0:25:05.67,*Default,NTP,0000,0000,0000,,Бағдаршамды бұзып, біреуді көлік қағып кетсе де.
Dialogue: 0,0:25:05.73,0:25:07.55,*Default,NTP,0000,0000,0000,,Зардап шеккен мен емес, сенсің.
Dialogue: 0,0:25:09.22,0:25:10.19,*Default,NTP,0000,0000,0000,,Бұрын… пышақ еді.
Dialogue: 0,0:25:11.86,0:25:14.66,*Default,NTP,0000,0000,0000,,Мен сіз ұстанатын ережелерді өзіңіз таңдағаныңызды қалаймын.
Dialogue: 0,0:25:15.36,0:25:16.83,*Default,NTP,0000,0000,0000,,Сіздің қабілетіңіз жоғары.
Dialogue: 0,0:25:17.30,0:25:18.63,*Default,NTP,0000,0000,0000,,Бұлай айтпа
Dialogue: 0,0:25:19.32,0:25:19.77,*Default,NTP,0000,0000,0000,,Ах...
Dialogue: 0,0:25:21.34,0:25:22.39,*Default,NTP,0000,0000,0000,,Мен енді мұны істемеймін
Dialogue: 0,0:25:23.79,0:25:25.65,*Default,NTP,0000,0000,0000,,Ережелерді бір жақты енгізуге ниетім жоқ.
Dialogue: 0,0:25:26.41,0:25:28.62,*Default,NTP,0000,0000,0000,,Мен «жоқ» десем, бұл негізгі ой.
Dialogue: 0,0:25:28.90,0:25:30.60,*Default,NTP,0000,0000,0000,,Бұл сонымен қатар сізді қорғауға арналған.
Dialogue: 0,0:25:31.91,0:25:34.36,*Default,NTP,0000,0000,0000,,Мен де саған ешқашан жоқ деп айтпаймын.
Dialogue: 0,0:25:35.01,0:25:38.08,*Default,NTP,0000,0000,0000,,Бұл екеуміздің арамыздағы уәде деу дұрыс па?
Dialogue: 0,0:25:40.16,0:25:40.53,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:25:49.48,0:25:50.22,*Default,NTP,0000,0000,0000,,Ол өте шебер.
Dialogue: 0,0:25:50.97,0:25:52.20,*Default,NTP,0000,0000,0000,,Қыздар арасында
Dialogue: 0,0:25:52.51,0:25:54.35,*Default,NTP,0000,0000,0000,,Мен оны пайдалануда ең жақсы болдым.
Dialogue: 0,0:25:55.02,0:25:56.57,*Default,NTP,0000,0000,0000,,Ол менің өнерлі екенімді айтты.
Dialogue: 0,0:25:57.33,0:25:59.56,*Default,NTP,0000,0000,0000,,Мен қазба қалдықтарын қазу үшін жақсы болуы мүмкін деп ойладым.
Dialogue: 0,0:26:00.35,0:26:03.01,*Default,NTP,0000,0000,0000,,Болашақта бірдеңе істегіңіз келсе, бұл өте жақсы.
Dialogue: 0,0:26:04.97,0:26:05.54,*Default,NTP,0000,0000,0000,,Менің жеңуімнің себебі…
Dialogue: 0,0:26:06.52,0:26:08.20,*Default,NTP,0000,0000,0000,,Мүмкін менің ойыма осы ғана келген шығар
Dialogue: 0,0:26:12.65,0:26:15.02,*Default,NTP,0000,0000,0000,,Кейбір хоббиді де сатып алған дұрыс.
Dialogue: 0,0:26:17.64,0:26:18.78,*Default,NTP,0000,0000,0000,,Дауыс беруді тоқтатыңыз!
Dialogue: 0,0:26:24.87,0:26:26.35,*Default,NTP,0000,0000,0000,,Мен қарайтын боламын, әрі қарай жүр.
Dialogue: 0,0:26:45.98,0:26:47.09,*Default,NTP,0000,0000,0000,,Біраз уақыт кетті.
Dialogue: 0,0:26:48.48,0:26:50.77,*Default,NTP,0000,0000,0000,,Қарау Себебі камера бар еді
Dialogue: 0,0:26:51.48,0:26:54.08,*Default,NTP,0000,0000,0000,,Әйелдерді визуалды түрде ұстауға арналған заңсыз камера ма?
Dialogue: 0,0:26:54.63,0:26:56.02,*Default,NTP,0000,0000,0000,,Сіз шынымен түсіндім дейсіз бе?
Dialogue: 0,0:26:56.83,0:26:59.55,*Default,NTP,0000,0000,0000,,Сіз қазір көңілсіз және ыңғайсызсыз.
Dialogue: 0,0:27:00.35,0:27:02.80,*Default,NTP,0000,0000,0000,,Жағымсыз иіс шығады.
Dialogue: 0,0:27:03.86,0:27:04.46,*Default,NTP,0000,0000,0000,,Иіс?
Dialogue: 0,0:27:05.17,0:27:07.46,*Default,NTP,0000,0000,0000,,Егеуқұйрықтар басқа адамдардың эмоциясын дене иісі арқылы түсінеді
Dialogue: 0,0:27:07.99,0:27:08.79,*Default,NTP,0000,0000,0000,,Сіз білмедіңіз бе?
Dialogue: 0,0:27:09.65,0:27:11.69,*Default,NTP,0000,0000,0000,,Бұл камерада әдейі көрсетілу арқылы
Dialogue: 0,0:27:11.77,0:27:14.20,*Default,NTP,0000,0000,0000,,Мен қанша алатынымды білемін.
Dialogue: 0,0:27:15.37,0:27:15.74,*Default,NTP,0000,0000,0000,,Ах...
Dialogue: 0,0:27:17.09,0:27:20.70,*Default,NTP,0000,0000,0000,,Сенің көңіл-күйіңді білмеймін, тіпті адам емеспін.
Dialogue: 0,0:27:22.34,0:27:24.48,*Default,NTP,0000,0000,0000,,Сіз адамдардан мейірімдісіз
Dialogue: 0,0:27:25.65,0:27:28.63,*Default,NTP,0000,0000,0000,,Жоғарыда кафе бар. Сіз сонда жұмыс істей алуыңыз керек.
Dialogue: 0,0:27:32.11,0:27:33.35,*Default,NTP,0000,0000,0000,,Соғылған қабық
Dialogue: 0,0:27:33.35,0:27:35.40,*Default,NTP,0000,0000,0000,,Біз сіздің азаматтық хал актілерін тіркеуді қамтамасыз еттік.
Dialogue: 0,0:27:36.09,0:27:38.83,*Default,NTP,0000,0000,0000,,Осыған сәйкес, сіз 19 жастағы банк қызметкерісіз.
Dialogue: 0,0:27:39.67,0:27:41.95,*Default,NTP,0000,0000,0000,,Жалған жалақы белгілеу құжаттары арқылы ақшаны бөлу
Dialogue: 0,0:27:42.34,0:27:45.10,*Default,NTP,0000,0000,0000,,Ақшаны жылыстату жолдарының бірі болса керек
Dialogue: 0,0:27:45.37,0:27:48.19,*Default,NTP,0000,0000,0000,,Шарт - сіздің жеке қол жеткізу.
Dialogue: 0,0:27:50.46,0:27:52.01,*Default,NTP,0000,0000,0000,,Менің өлуім де шарт па?
Dialogue: 0,0:27:52.68,0:27:55.52,*Default,NTP,0000,0000,0000,,А...бірақ іс анықталды.
Dialogue: 0,0:27:55.52,0:27:57.69,*Default,NTP,0000,0000,0000,,Бізге шабуыл жасау құқығы берілді.
Dialogue: 0,0:27:58.47,0:28:01.22,*Default,NTP,0000,0000,0000,,Мен оларды бір-бірден тексеремін, жарай ма?
Dialogue: 0,0:28:01.71,0:28:02.12,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:28:03.43,0:28:04.49,*Default,NTP,0000,0000,0000,,Сенің ағаң кім?
Dialogue: 0,0:28:05.47,0:28:06.11,*Default,NTP,0000,0000,0000,,Түрме
Dialogue: 0,0:28:07.23,0:28:08.40,*Default,NTP,0000,0000,0000,,Сіздің ата-анаңыз әлі тірі, солай ма?
Dialogue: 0,0:28:08.89,0:28:11.28,*Default,NTP,0000,0000,0000,,Иә, бірақ екеуміз де ауруханадамыз.
Dialogue: 0,0:28:12.06,0:28:13.40,*Default,NTP,0000,0000,0000,,Сіз қай мектепте оқыдыңыз?
Dialogue: 0,0:28:14.16,0:28:17.31,*Default,NTP,0000,0000,0000,,Мен мұнда келе алмаймын, себебі маған ата-анамның қолы керек.
Dialogue: 0,0:28:18.49,0:28:19.57,*Default,NTP,0000,0000,0000,,Ата-анаң...
Dialogue: 0,0:28:20.25,0:28:21.07,*Default,NTP,0000,0000,0000,,Мен туралы
Dialogue: 0,0:28:21.33,0:28:23.34,*Default,NTP,0000,0000,0000,,Өйткені бұл менің балам деп ойламаймын.
Dialogue: 0,0:28:28.08,0:28:29.22,*Default,NTP,0000,0000,0000,,Құжаттар толық
Dialogue: 0,0:28:29.91,0:28:32.80,*Default,NTP,0000,0000,0000,,Енді Shell естеліктері бір жерде жазылған болса...
Dialogue: 0,0:28:33.43,0:28:35.15,*Default,NTP,0000,0000,0000,,Мен енді шыдай алмаймын
Dialogue: 0,0:28:35.98,0:28:36.80,*Default,NTP,0000,0000,0000,,Жарайсың
Dialogue: 0,0:28:37.44,0:28:40.15,*Default,NTP,0000,0000,0000,,Енді мұны Құқықтық мәселелер бюросына жіберсеңіз болғаны.
Dialogue: 0,0:28:40.72,0:28:41.73,*Default,NTP,0000,0000,0000,,Сіз оны басқаларға көрсетесіз бе?
Dialogue: 0,0:28:42.26,0:28:44.51,*Default,NTP,0000,0000,0000,,Менің өткен өмірім қандай болды?
Dialogue: 0,0:28:44.51,0:28:45.14,*Default,NTP,0000,0000,0000,,Бюллетень
Dialogue: 0,0:28:45.20,0:28:45.79,*Default,NTP,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:28:46.69,0:28:50.33,*Default,NTP,0000,0000,0000,,Мені түсініңіз
Dialogue: 0,0:28:52.58,0:28:54.38,*Default,NTP,0000,0000,0000,,Бұл идея туралы не ойлайсыз?
Dialogue: 0,0:28:55.46,0:28:57.64,*Default,NTP,0000,0000,0000,,Бұл қазба қазбалары.
Dialogue: 0,0:28:58.67,0:29:02.00,*Default,NTP,0000,0000,0000,,Жануарлар қанша жауыз болса да, бәрі тасқа айналып, ұйықтайды.
Dialogue: 0,0:29:02.63,0:29:05.55,*Default,NTP,0000,0000,0000,,Дәл қазір осында шынымен тірі адам сенсің.
Dialogue: 0,0:29:07.43,0:29:09.42,*Default,NTP,0000,0000,0000,,Сен мені ренжіткің келеді ме?
Dialogue: 0,0:29:12.15,0:29:13.30,*Default,NTP,0000,0000,0000,,Құжаттарды жоюға болады
Dialogue: 0,0:29:13.83,0:29:16.00,*Default,NTP,0000,0000,0000,,Егер бұл қазбалармен күресудің ең жақсы жолы болса.
Dialogue: 0,0:29:17.00,0:29:18.77,*Default,NTP,0000,0000,0000,,Олай істесең, қиналып қаласың, солай ма?
Dialogue: 0,0:29:19.02,0:29:22.29,*Default,NTP,0000,0000,0000,,Жоқ десең, мен оны істемеймін
Dialogue: 0,0:29:29.61,0:29:31.49,*Default,NTP,0000,0000,0000,,Жарайды, Уфкок.
Dialogue: 0,0:29:45.79,0:29:48.12,*Default,NTP,0000,0000,0000,,Мені де жынды деп ойлайсың ба?
Dialogue: 0,0:29:48.81,0:29:49.81,*Default,NTP,0000,0000,0000,,Жынды болып бара жатырсыз ба? неге?
Dialogue: 0,0:29:50.37,0:29:52.68,*Default,NTP,0000,0000,0000,,Бір нәрсеге қол тигізу үшін ақы алу, т.б.
Dialogue: 0,0:29:53.02,0:29:53.94,*Default,NTP,0000,0000,0000,,Сондай бала сияқты...
Dialogue: 0,0:29:54.54,0:29:58.38,*Default,NTP,0000,0000,0000,,Жоқ, мен көп еркектік ойларды білемін
Dialogue: 0,0:29:58.38,0:30:00.97,*Default,NTP,0000,0000,0000,,Мұндай жүйенің орнатылғанын білдіреді.
Dialogue: 0,0:30:01.57,0:30:02.63,*Default,NTP,0000,0000,0000,,Егер сіз ақылсыз болсаңыз
Dialogue: 0,0:30:02.91,0:30:04.98,*Default,NTP,0000,0000,0000,,Шынында да үлкен нәрсе есінен танып жатыр.
Dialogue: 0,0:30:07.23,0:30:08.98,*Default,NTP,0000,0000,0000,,Өзім туралы аздап айтып бере аламын ба?
Dialogue: 0,0:30:09.84,0:30:10.60,*Default,NTP,0000,0000,0000,,Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:30:12.44,0:30:15.50,*Default,NTP,0000,0000,0000,,Мен жұмыс істеген дүкенді полиция жауып тастаған кезде.
Dialogue: 0,0:30:16.03,0:30:17.87,*Default,NTP,0000,0000,0000,,Мені сұраған полиция қызметкері болды
Dialogue: 0,0:30:19.57,0:30:21.06,*Default,NTP,0000,0000,0000,,Неліктен тағы да жезөкшелік?
Dialogue: 0,0:30:22.47,0:30:23.57,*Default,NTP,0000,0000,0000,,Қыз емес
Dialogue: 0,0:30:25.53,0:30:26.50,*Default,NTP,0000,0000,0000,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:30:27.52,0:30:28.60,*Default,NTP,0000,0000,0000,,Сіз қашан...
Dialogue: 0,0:30:28.99,0:30:31.15,*Default,NTP,0000,0000,0000,,Қыздығыңызды сол бақытты жігітке бердіңіз бе?
Dialogue: 0,0:30:31.79,0:30:32.48,*Default,NTP,0000,0000,0000,,Бақытты…
Dialogue: 0,0:30:32.97,0:30:35.65,*Default,NTP,0000,0000,0000,,Мен сенің бұлай ойлайтыныңды білмедім.
Dialogue: 0,0:30:36.61,0:30:37.98,*Default,NTP,0000,0000,0000,,12 жасымда әкем
Dialogue: 0,0:30:40.43,0:30:44.40,*Default,NTP,0000,0000,0000,,Сіздің де қызыңызға тиіскіңіз келе ме?
Dialogue: 0,0:30:47.81,0:30:48.99,*Default,NTP,0000,0000,0000,,Жынды болу
Dialogue: 0,0:30:50.79,0:30:52.59,*Default,NTP,0000,0000,0000,,Мен ненің ақылсыз екенін білмеймін
Dialogue: 0,0:30:53.31,0:30:55.47,*Default,NTP,0000,0000,0000,,Сіздің одақтасыңыз жоқ екенін біліңіз.
Dialogue: 0,0:30:56.35,0:30:59.35,*Default,NTP,0000,0000,0000,,Сол кезде Шелл келіп, мені жақсы көретінін айтты.
Dialogue: 0,0:31:00.15,0:31:01.79,*Default,NTP,0000,0000,0000,,Сондықтан мен Шеллдің көлігіне міндім.
Dialogue: 0,0:31:03.11,0:31:04.89,*Default,NTP,0000,0000,0000,,Мен жындымын ба?
Dialogue: 0,0:31:05.42,0:31:07.30,*Default,NTP,0000,0000,0000,,Келіңіздер, кешіріңіздер.
Dialogue: 0,0:31:07.47,0:31:10.08,*Default,NTP,0000,0000,0000,,Ақыл-ойы адамдікіне жеткен егеуқұйрық.
Dialogue: 0,0:31:10.68,0:31:12.58,*Default,NTP,0000,0000,0000,,Кейбіреулер мені жынды дейді.
Dialogue: 0,0:31:12.88,0:31:14.68,*Default,NTP,0000,0000,0000,,Сіз? Неліктен?
Dialogue: 0,0:31:15.68,0:31:16.66,*Default,NTP,0000,0000,0000,,Сол адамға
Dialogue: 0,0:31:16.66,0:31:18.66,*Default,NTP,0000,0000,0000,,Мен сияқтылар жынды.
Dialogue: 0,0:31:19.36,0:31:21.57,*Default,NTP,0000,0000,0000,,Мен де кім екенімді білмеймін.
Dialogue: 0,0:31:22.55,0:31:25.22,*Default,NTP,0000,0000,0000,,Әскерилер мені жасады, бірақ зерттеудің өзі жойылды.
Dialogue: 0,0:31:26.16,0:31:29.50,*Default,NTP,0000,0000,0000,,Енді оның қоғамға пайдалылығын дәлелдей беру арқылы.
Dialogue: 0,0:31:29.92,0:31:31.60,*Default,NTP,0000,0000,0000,,Ақырында өмір сүруге рұқсат берілді
Dialogue: 0,0:31:32.89,0:31:34.40,*Default,NTP,0000,0000,0000,,Сондықтан маған көмектесесің
Dialogue: 0,0:31:35.73,0:31:37.61,*Default,NTP,0000,0000,0000,,Өмір сүруге рұқсат беру ...
Dialogue: 0,0:31:41.76,0:31:42.41,*Default,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:31:42.88,0:31:44.50,*Default,NTP,0000,0000,0000,,Дұшпандық иісі қайталанады.
Dialogue: 0,0:31:46.50,0:31:48.93,*Default,NTP,0000,0000,0000,,Бұл бұрынғы интернет-кафе. Мен оны кері таптым.
Dialogue: 0,0:31:49.38,0:31:50.09,*Default,NTP,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:31:50.24,0:31:51.24,*Default,NTP,0000,0000,0000,,Менің қолымнан ұста
Dialogue: 0,0:31:54.34,0:31:55.24,*Default,NTP,0000,0000,0000,,Мен өзіңізді қауіпсіз сезінгеніңізді қалаймын.
Dialogue: 0,0:31:55.90,0:31:58.60,*Default,NTP,0000,0000,0000,,Мен ең күшті қоян-қолтық ұрыс қаруы ретінде жасалды.
Dialogue: 0,0:31:58.92,0:32:00.03,*Default,NTP,0000,0000,0000,,Бұл әмбебап зат.
Dialogue: 0,0:32:08.24,0:32:09.04,*Default,NTP,0000,0000,0000,,Мұнда кел
Dialogue: 0,0:32:09.12,0:32:10.34,*Default,NTP,0000,0000,0000,,Мен тұрған жерге қолыңды соз
Dialogue: 0,0:32:18.31,0:32:19.03,*Default,NTP,0000,0000,0000,,Коно!
Dialogue: 0,0:32:25.55,0:32:27.14,*Default,NTP,0000,0000,0000,,Автотұраққа қайтайық.
Dialogue: 0,0:32:30.31,0:32:31.41,*Default,NTP,0000,0000,0000,,Тағы біреуі келді
Dialogue: 0,0:32:32.62,0:32:33.64,*Default,NTP,0000,0000,0000,,Мені тағы да жеңесің бе?
Dialogue: 0,0:32:33.99,0:32:36.36,*Default,NTP,0000,0000,0000,,Жоқ, ештеңе болмаса, үйге қайтайық.
Dialogue: 0,0:32:37.09,0:32:38.36,*Default,NTP,0000,0000,0000,,Сіз ештеңе жоқ деп ойлайсыз ба?
Dialogue: 0,0:32:38.79,0:32:39.87,*Default,NTP,0000,0000,0000,,Онсыз жақсы болар еді деп ойлаймын.
Dialogue: 0,0:32:40.83,0:32:43.53,*Default,NTP,0000,0000,0000,,Саған сүйенетінімді білмеймін.
Dialogue: 0,0:32:43.76,0:32:46.92,*Default,NTP,0000,0000,0000,,Бұл мәселе. Сіз менің пайдалылығыма куәсіз.
Dialogue: 0,0:32:47.78,0:32:48.27,*Default,NTP,0000,0000,0000,,Бұл жерде!
Dialogue: 0,0:32:54.05,0:32:55.55,*Default,NTP,0000,0000,0000,,Бірдеңе болды.
Dialogue: 0,0:32:55.81,0:32:57.10,*Default,NTP,0000,0000,0000,,Сенің күшіңмен құтылайық
Dialogue: 0,0:32:57.32,0:32:58.33,*Default,NTP,0000,0000,0000,,Мен саған жол көрсетемін
Dialogue: 0,0:32:58.76,0:33:01.11,*Default,NTP,0000,0000,0000,,Қауіпсіздік белдігін тағып, көлікті үрлеңіз
Dialogue: 0,0:33:01.70,0:33:03.86,*Default,NTP,0000,0000,0000,,Мен ешқашан көлік жүргізген емеспін
Dialogue: 0,0:33:04.52,0:33:06.48,*Default,NTP,0000,0000,0000,,Әр нәрсенің алғашқы қадамы бар.
Dialogue: 0,0:33:24.75,0:33:26.79,*Default,NTP,0000,0000,0000,,Жарайды, мен бейбіт түрде қашып құтылдым.
Dialogue: 0,0:33:27.36,0:33:29.78,*Default,NTP,0000,0000,0000,,Қарсы бағытта жүгіру тыныш па?
Dialogue: 0,0:33:30.25,0:33:31.86,*Default,NTP,0000,0000,0000,,Мен зымыранға айналады деп ойламадым.
Dialogue: 0,0:33:31.86,0:33:33.70,*Default,NTP,0000,0000,0000,,Жауды жай ғана бөлшектеп тастай алмайсың.
Dialogue: 0,0:33:33.94,0:33:34.60,*Default,NTP,0000,0000,0000,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:33:34.82,0:33:35.62,*Default,NTP,0000,0000,0000,,Бұл қылмыс
Dialogue: 0,0:33:36.07,0:33:38.38,*Default,NTP,0000,0000,0000,,Келесі күні мен қоқысқа тастаймын.
Dialogue: 0,0:33:39.48,0:33:41.26,*Default,NTP,0000,0000,0000,,Енді соңғысын жеңейік.
Dialogue: 0,0:33:52.78,0:33:54.66,*Default,NTP,0000,0000,0000,,Түпнұсқалары толығымен болғанымен
Dialogue: 0,0:33:54.77,0:33:57.48,*Default,NTP,0000,0000,0000,,Біртүрлі иіс бар, мен байқап тұрғандай...
Dialogue: 0,0:34:06.64,0:34:08.95,*Default,NTP,0000,0000,0000,,Іс жүргізушілер арасындағы ақпаратты ашу
Dialogue: 0,0:34:09.79,0:34:11.89,*Default,NTP,0000,0000,0000,,Бас тартсаңыз, қоғамдық көліктерді жалға беру агенттіктері
Dialogue: 0,0:34:12.20,0:34:14.45,*Default,NTP,0000,0000,0000,,Өз көзқарасыңыздың куәсі болыңыз
Dialogue: 0,0:34:15.12,0:34:17.14,*Default,NTP,0000,0000,0000,,Не? Сен не туралы айтып тұрсың?
Dialogue: 0,0:34:17.84,0:34:18.90,*Default,NTP,0000,0000,0000,,Офицерлер арасындағы
Dialogue: 0,0:34:19.02,0:34:21.11,*Default,NTP,0000,0000,0000,,Бейбіт шешім үшін келіссөздер жүргізу
Dialogue: 0,0:34:21.64,0:34:23.46,*Default,NTP,0000,0000,0000,,Бас тартсаңыз, сотта теріс болады.
Dialogue: 0,0:34:24.74,0:34:25.50,*Default,NTP,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:34:26.58,0:34:27.79,*Default,NTP,0000,0000,0000,,Кішкене сөйлесейік
Dialogue: 0,0:34:33.35,0:34:33.94,*Default,NTP,0000,0000,0000,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:34:34.53,0:34:36.64,*Default,NTP,0000,0000,0000,,Мен осында болғанша ол да маған тиіспейді.
Dialogue: 0,0:34:43.12,0:34:45.85,*Default,NTP,0000,0000,0000,,Бұл қазіргі пайдаланушы, Ufucock ме?
Dialogue: 0,0:34:46.41,0:34:48.80,*Default,NTP,0000,0000,0000,,Қандай ақпаратты ашу керек? Қайнатылған
Dialogue: 0,0:34:49.92,0:34:52.56,*Default,NTP,0000,0000,0000,,Тіршілікті сақтау бағдарламасын алып тастаңыз
Dialogue: 0,0:34:53.58,0:34:54.93,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:34:55.68,0:34:57.81,*Default,NTP,0000,0000,0000,,Сіз әлі де шешім деп ойлайсыз ба?
Dialogue: 0,0:34:59.63,0:35:02.90,*Default,NTP,0000,0000,0000,,Іске қатысы бар адам қайтыс болғанда не болатынын тыңдайық
Dialogue: 0,0:35:03.41,0:35:07.62,*Default,NTP,0000,0000,0000,,Барлық шешімдер жалғасуда. Өлтіру мұнымен аяқталады деп ойлайсыз ба?
Dialogue: 0,0:35:09.84,0:35:10.66,*Default,NTP,0000,0000,0000,,Қарақұрым қоңырау белгісі мұнараның шыңынан алыстап барады. Мен оны сеземін.
Dialogue: 0,0:35:12.99,0:35:15.85,*Default,NTP,0000,0000,0000,,Өлгің келмесе, істі қайтарып ал.
Dialogue: 0,0:35:16.42,0:35:17.14,*Default,NTP,0000,0000,0000,,Тыңдама, Балот
Dialogue: 0,0:35:17.61,0:35:19.76,*Default,NTP,0000,0000,0000,,Егер сен бас тартсаң, сені ешкім қорғай алмайды!
Dialogue: 0,0:35:23.11,0:35:26.72,*Default,NTP,0000,0000,0000,,Қысқартылған сот 3 күннен кейін өтеді. Басқа мәліметтерді алу үшін жалғасын күтіңіз.
Dialogue: 0,0:35:28.52,0:35:31.85,*Default,NTP,0000,0000,0000,,Мен сені қайтадан қолымда ұстауды асыға күтемін.
Dialogue: 0,0:35:32.79,0:35:33.79,*Default,NTP,0000,0000,0000,,Уфкок
Dialogue: 0,0:35:49.14,0:35:50.84,*Default,NTP,0000,0000,0000,,Сіз білесіз бе? Сол адам
Dialogue: 0,0:35:51.84,0:35:53.27,*Default,NTP,0000,0000,0000,,Қайнатылған Димсдил
Dialogue: 0,0:35:53.96,0:35:55.99,*Default,NTP,0000,0000,0000,,Менің бұрынғы серіктесім.
Dialogue: 0,0:35:56.41,0:35:57.11,*Default,NTP,0000,0000,0000,,Серіктес пе?
Dialogue: 0,0:35:57.70,0:35:59.64,*Default,NTP,0000,0000,0000,,Біз енді жау болдық.
Dialogue: 0,0:36:00.93,0:36:02.03,*Default,NTP,0000,0000,0000,,Қарғыс атқан ұрық метаморфозға ұшыраған жағдайда—
Dialogue: 0,0:36:02.67,0:36:03.61,*Default,NTP,0000,0000,0000,,Маған сеніңіз
Dialogue: 0,0:36:04.08,0:36:07.00,*Default,NTP,0000,0000,0000,,Мен сені қорғау арқылы пайдалымын...
Dialogue: 0,0:36:07.29,0:36:08.25,*Default,NTP,0000,0000,0000,,Неліктен мен?
Dialogue: 0,0:36:15.01,0:36:18.63,*Default,NTP,0000,0000,0000,,Сіз жынды емессіз. Сіз ештеңе істеген жоқсыз.
Dialogue: 0,0:36:19.24,0:36:20.12,*Default,NTP,0000,0000,0000,,Бұл жерде ештеңе жоқ
Dialogue: 0,0:36:20.92,0:36:23.51,*Default,NTP,0000,0000,0000,,Сізді өлтіруге ешқандай себеп жоқ.
Dialogue: 0,0:36:24.70,0:36:28.66,*Default,NTP,0000,0000,0000,,Мен сен үшін қолымнан келгеннің бәрін жасап, ісіңді шешкім келеді.
Dialogue: 0,0:36:29.87,0:36:31.64,*Default,NTP,0000,0000,0000,,Менің жағдайым?
Dialogue: 0,0:36:32.36,0:36:32.89,*Default,NTP,0000,0000,0000,,Піл
Dialogue: 0,0:36:35.16,0:36:35.92,*Default,NTP,0000,0000,0000,,Сотта
Dialogue: 0,0:36:36.45,0:36:38.51,*Default,NTP,0000,0000,0000,,Сіз мен және менің әкем туралы сұрайсыз ба?
Dialogue: 0,0:36:39.78,0:36:42.23,*Default,NTP,0000,0000,0000,,Мен оған не істедім немесе оны істеуге мәжбүр еттім,
Dialogue: 0,0:36:42.78,0:36:45.13,*Default,NTP,0000,0000,0000,,Менде қандай өмір бар?
Dialogue: 0,0:36:46.19,0:36:48.22,*Default,NTP,0000,0000,0000,,Сондықтан еркектер жаман емес...
Dialogue: 0,0:36:48.50,0:36:50.55,*Default,NTP,0000,0000,0000,,Менің мұндай логикаға келісуге ниетім жоқ.
Dialogue: 0,0:36:51.88,0:36:56.37,*Default,NTP,0000,0000,0000,,Мен сізбен ынтымақтасқым келеді. Маған сенесің бе?
Dialogue: 0,0:36:57.05,0:36:57.51,*Default,NTP,0000,0000,0000,,О
Dialogue: 0,0:36:58.48,0:36:59.54,*Default,NTP,0000,0000,0000,,Мен кешірім сұраймын
Dialogue: 0,0:37:00.33,0:37:02.30,*Default,NTP,0000,0000,0000,,Мен ренжімедім деп кешіріңіз
Dialogue: 0,0:37:03.13,0:37:05.10,*Default,NTP,0000,0000,0000,,Менің ойымша, өлген дұрыс
Dialogue: 0,0:37:05.48,0:37:07.67,*Default,NTP,0000,0000,0000,,Бірақ менің де өлгім келмейді.
Dialogue: 0,0:37:08.90,0:37:11.78,*Default,NTP,0000,0000,0000,,Мен бұлай сезініп өлгім келмейді
Dialogue: 0,0:37:13.25,0:37:16.17,*Default,NTP,0000,0000,0000,,Сіз осы уақытқа дейін жалғыз күресіп келдіңіз.
Dialogue: 0,0:37:16.93,0:37:18.01,*Default,NTP,0000,0000,0000,,Бұл тамаша
Dialogue: 0,0:37:19.22,0:37:20.10,*Default,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:37:21.02,0:37:21.61,*Default,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:37:21.95,0:37:23.86,*Default,NTP,0000,0000,0000,,Мен мойынсұнуға мәжбүр болдым.
Dialogue: 0,0:37:24.82,0:37:28.33,*Default,NTP,0000,0000,0000,,Бұл батылдық пен шыдамдылықты қажет ететін қиын шайқас.
Dialogue: 0,0:37:29.19,0:37:31.42,*Default,NTP,0000,0000,0000,,Бұдан былай мен сенімен бірге күресемін.
Dialogue: 0,0:37:32.29,0:37:34.58,*Default,NTP,0000,0000,0000,,Бұл күресудің жолы болмауы мүмкін екенін білесіз.
Dialogue: 0,0:37:34.77,0:37:37.73,*Default,NTP,0000,0000,0000,,Бірақ мен сенің де біздің қалай күресетінімізді білгеніңді қалаймын.
Dialogue: 0,0:37:38.40,0:37:40.45,*Default,NTP,0000,0000,0000,,Бұл сіздің ақталуыңыз ба?
Dialogue: 0,0:37:41.22,0:37:45.21,*Default,NTP,0000,0000,0000,,Мен де сен сияқтымын, Мен кім екенімді іздеймін.
Dialogue: 0,0:37:46.48,0:37:48.72,*Default,NTP,0000,0000,0000,,Бұл қалада қиындық жанып тұр
Dialogue: 0,0:37:49.79,0:37:51.59,*Default,NTP,0000,0000,0000,,Өзіңіздің күйіп қалған сезімдеріңізді проекциялау
Dialogue: 0,0:37:57.70,0:37:59.29,*Default,NTP,0000,0000,0000,,Болашақ жоқ
Dialogue: 0,0:38:00.56,0:38:03.95,*Default,NTP,0000,0000,0000,,Мен білетін балалардың барлығында ондай жоқ.
Dialogue: 0,0:38:04.44,0:38:06.95,*Default,NTP,0000,0000,0000,,Есірткі мен еркектен бейберекетпін.
Dialogue: 0,0:38:08.59,0:38:09.67,*Default,NTP,0000,0000,0000,,Оған дейін
Dialogue: 0,0:38:10.28,0:38:12.51,*Default,NTP,0000,0000,0000,,Мен тек тірі қалу үшін сылтау алғым келеді
Dialogue: 0,0:38:14.49,0:38:16.82,*Default,NTP,0000,0000,0000,,Мені жақсы көр Уфкок
Dialogue: 0,0:38:17.13,0:38:18.83,*Default,NTP,0000,0000,0000,,Жоқ... не?
Dialogue: 0,0:38:19.32,0:38:20.87,*Default,NTP,0000,0000,0000,,Маған кешірім айтыңыз
Dialogue: 0,0:38:21.42,0:38:22.75,*Default,NTP,0000,0000,0000,,Мен мұны саған қалаймын
Dialogue: 0,0:38:23.42,0:38:25.98,*Default,NTP,0000,0000,0000,,Мен не бұйырса, соны істеймін, соның ішінде сот.
Dialogue: 0,0:38:27.06,0:38:28.80,*Default,NTP,0000,0000,0000,,Сондықтан мен сені жақсы көремін
Dialogue: 0,0:38:28.88,0:38:29.92,*Default,NTP,0000,0000,0000,,О... күте тұрыңыз, жарай ма?
Dialogue: 0,0:38:30.66,0:38:33.97,*Default,NTP,0000,0000,0000,,Бұл сізге шешім бола ма?
Dialogue: 0,0:38:34.33,0:38:36.75,*Default,NTP,0000,0000,0000,,Мен сен сияқты біреудің сүйгенін қалаймын
Dialogue: 0,0:38:37.07,0:38:38.05,*Default,NTP,0000,0000,0000,,А... иә?
Dialogue: 0,0:38:38.95,0:38:41.18,*Default,NTP,0000,0000,0000,,Сіз... мені бұруға мәжбүрледіңіз бе?
Dialogue: 0,0:38:41.55,0:38:42.75,*Default,NTP,0000,0000,0000,,Қорғанысты бұзуға болады ма?
Dialogue: 0,0:38:42.94,0:38:45.45,*Default,NTP,0000,0000,0000,,Мен сен үшін қандаймын?
Dialogue: 0,0:38:46.56,0:38:49.44,*Default,NTP,0000,0000,0000,,Басқаша айтқанда, сіз іс бойынша клиент және тарапсыз.
Dialogue: 0,0:38:49.58,0:38:51.44,*Default,NTP,0000,0000,0000,,Маған қатысты шағымдарыңыз болса, Құқықтық мәселелер жөніндегі бюроға хабарласыңыз...
Dialogue: 0,0:38:51.44,0:38:54.36,*Default,NTP,0000,0000,0000,,Мен білмеймін, оны білмеймін.
Dialogue: 0,0:38:54.36,0:38:55.04,*Default,NTP,0000,0000,0000,,Жоқ... күте тұрыңыз.
Dialogue: 0,0:38:55.24,0:38:57.30,*Default,NTP,0000,0000,0000,,Тоқта, қара, қара, қара, мен егеуқұйрықпын.
Dialogue: 0,0:38:58.22,0:39:01.57,*Default,NTP,0000,0000,0000,,Қаласаңыз, мен ер адамға айнала аламын деп ойлайсыз ба?
Dialogue: 0,0:39:01.86,0:39:02.41,*Default,NTP,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,0:39:02.70,0:39:05.31,*Default,NTP,0000,0000,0000,,Мен сенің мейірімді тышқан екеніңді білемін.
Dialogue: 0,0:39:05.87,0:39:08.38,*Default,NTP,0000,0000,0000,,Мені де жынды деп ойлайсың ба?
Dialogue: 0,0:39:08.85,0:39:10.97,*Default,NTP,0000,0000,0000,,Жоқ... сіз мені үй жануарым деп ойлайсыз ба?
Dialogue: 0,0:39:15.78,0:39:16.96,*Default,NTP,0000,0000,0000,,Жаңа серіктес
Dialogue: 0,0:39:17.47,0:39:17.78,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:39:18.78,0:39:20.07,*Default,NTP,0000,0000,0000,,Міне, сіз айттыңыз
Dialogue: 0,0:39:20.42,0:39:23.69,*Default,NTP,0000,0000,0000,,Менің жаңа серігім, маған қарап
Dialogue: 0,0:39:24.87,0:39:28.24,*Default,NTP,0000,0000,0000,,Осы күйде айналаңызда не болып жатқанын білесіз бе?
Dialogue: 0,0:39:28.90,0:39:30.78,*Default,NTP,0000,0000,0000,,Ерекше сипаттамалар
Dialogue: 0,0:39:31.41,0:39:34.29,*Default,NTP,0000,0000,0000,,Снарк қабілеті сізге де қолайлы...
Dialogue: 0,0:39:41.65,0:39:45.49,*Default,NTP,0000,0000,0000,,Мені пайдаланатын адамдардан көп нәрсені талап етемін.
Dialogue: 0,0:39:46.41,0:39:48.64,*Default,NTP,0000,0000,0000,,Осылайша мен бұрынғы серіктесіммен жанжалдасып қалдым.
Dialogue: 0,0:39:49.72,0:39:52.05,*Default,NTP,0000,0000,0000,,Сонда да сіз клиентсіз.
Dialogue: 0,0:39:52.48,0:39:54.42,*Default,NTP,0000,0000,0000,,Менің серіктесім болғың келсе...
Dialogue: 0,0:39:55.26,0:39:58.40,*Default,NTP,0000,0000,0000,,Мен сенің айтқаныңның бәрін тыңдаймын, тіпті сотқа да барамын.
Dialogue: 0,0:39:59.00,0:40:02.29,*Default,NTP,0000,0000,0000,,Хм... жарайды, мен сәйкессіздік барын сезбей тұра алмаймын.
Dialogue: 0,0:40:02.98,0:40:04.66,*Default,NTP,0000,0000,0000,,Танысқаныма қуаныштымын, серіктес.
Dialogue: 0,0:40:06.17,0:40:08.52,*Default,NTP,0000,0000,0000,,Бюллетень Мені атыммен атаңыз
Dialogue: 0,0:40:09.48,0:40:12.07,*Default,NTP,0000,0000,0000,,Мен көремін. Рахмет, Барот.
Dialogue: 0,0:40:12.97,0:40:13.95,*Default,NTP,0000,0000,0000,,Мен Уфкокпын
Dialogue: 0,0:40:14.36,0:40:16.55,*Default,NTP,0000,0000,0000,,09 Офицер ретінде лицензияланған
Dialogue: 0,0:40:17.10,0:40:19.64,*Default,NTP,0000,0000,0000,,Әділет бюросы мені адам деп ойлайды, бірақ...
Dialogue: 0,0:40:20.43,0:40:21.70,*Default,NTP,0000,0000,0000,,Мен де солай ойлаймын.
Dialogue: 0,0:40:33.88,0:40:34.84,*Default,NTP,0000,0000,0000,,Бұл тамаша
Dialogue: 0,0:40:35.80,0:40:37.15,*Default,NTP,0000,0000,0000,,Бұл Балотқа ұқсайды ма?
Dialogue: 0,0:40:39.58,0:40:43.01,*Default,NTP,0000,0000,0000,,Бароттың сотқа келуінің шарты осы болса керек, доктор.
Dialogue: 0,0:40:43.71,0:40:45.53,*Default,NTP,0000,0000,0000,,Менің ақ тоным ұнамаса
Dialogue: 0,0:40:45.71,0:40:47.55,*Default,NTP,0000,0000,0000,,Маған алдымен айтқаныңды қалаймын.
Dialogue: 0,0:40:48.45,0:40:51.08,*Default,NTP,0000,0000,0000,,Ой, жоқ, мен қайтадан тексеруім керек.
Dialogue: 0,0:40:51.78,0:40:55.15,*Default,NTP,0000,0000,0000,,Әлі де дамып келе жатқан ұйымдар шынымен де қиын.
Dialogue: 0,0:40:56.19,0:40:56.97,*Default,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:40:57.87,0:41:01.22,*Default,NTP,0000,0000,0000,,Мен Балоттың даусын бастапқы қалпына келтірудің әртүрлі әдістерін қолданып жатырмын.
Dialogue: 0,0:41:03.14,0:41:05.20,*Default,NTP,0000,0000,0000,,Сіз мәңгілікке алмастырушыны қаламайсыз.
Dialogue: 0,0:41:12.68,0:41:14.01,*Default,NTP,0000,0000,0000,,Не... не болды?
Dialogue: 0,0:41:14.87,0:41:15.48,*Default,NTP,0000,0000,0000,,Менің жеңуімнің себебі…
Dialogue: 0,0:41:16.61,0:41:20.10,*Default,NTP,0000,0000,0000,,Қуаныштан басқа жағымсыз эмоциялар мен қорқыныштың иісін сезіндім.
Dialogue: 0,0:41:20.82,0:41:23.13,*Default,NTP,0000,0000,0000,,Сіз біздің пайдалылығымызға күмәндандыңыз.
Dialogue: 0,0:41:23.53,0:41:24.86,*Default,NTP,0000,0000,0000,,Күте тұрыңыз, мынаны қараңыз.
Dialogue: 0,0:41:26.29,0:41:27.17,*Default,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:41:28.23,0:41:31.44,*Default,NTP,0000,0000,0000,,Адамгершілікке жақындық танытуға болады деп ойлау дұрыс па?
Dialogue: 0,0:41:31.87,0:41:33.16,*Default,NTP,0000,0000,0000,,Иә, Уфкок.
Dialogue: 0,0:41:33.81,0:41:36.74,*Default,NTP,0000,0000,0000,,Олар бізді қатты ұнатты деп ойламайсың ба?
Dialogue: 0,0:41:42.91,0:41:45.15,*Default,NTP,0000,0000,0000,,Сізге үш түймені басу жеткілікті.
Dialogue: 0,0:41:45.54,0:41:47.28,*Default,NTP,0000,0000,0000,,Иә немесе жоқ, үнсіздік.
Dialogue: 0,0:41:47.85,0:41:49.04,*Default,NTP,0000,0000,0000,,Жазудан бас тартуыңызға болады
Dialogue: 0,0:41:51.47,0:41:53.06,*Default,NTP,0000,0000,0000,,Пасха жақсы көрінеді
Dialogue: 0,0:41:53.41,0:41:55.64,*Default,NTP,0000,0000,0000,,Әрқашан осылай болса, мен өзімді еркін сезінемін.
Dialogue: 0,0:41:57.72,0:41:59.89,*Default,NTP,0000,0000,0000,,Енді сол баланың сыртқы келбетін қарастырайық.
Dialogue: 0,0:42:00.20,0:42:02.01,*Default,NTP,0000,0000,0000,,Бұл тым әдемі.
Dialogue: 0,0:42:02.79,0:42:03.69,*Default,NTP,0000,0000,0000,,Ол жақсырақ
Dialogue: 0,0:42:03.69,0:42:05.96,*Default,NTP,0000,0000,0000,,Мен ер адамды азғырғандай болғанын қаламаймын.
Dialogue: 0,0:42:09.76,0:42:10.90,*Default,NTP,0000,0000,0000,,Шел мырзаға
Dialogue: 0,0:42:11.37,0:42:13.93,*Default,NTP,0000,0000,0000,,Зиян келтіру ниеті болған жоқ.
Dialogue: 0,0:42:14.19,0:42:15.36,*Default,NTP,0000,0000,0000,,Ыстық болса да
Dialogue: 0,0:42:15.83,0:42:18.24,*Default,NTP,0000,0000,0000,,Неліктен ол қарсылық көрсетпеді?
Dialogue: 0,0:42:19.14,0:42:21.32,*Default,NTP,0000,0000,0000,,Оның жоғалтқанын ескере отырып...
Dialogue: 0,0:42:23.18,0:42:26.07,*Default,NTP,0000,0000,0000,,Мен мұны сен үшін істеп жатырмын деп ойлағым келеді.
Dialogue: 0,0:42:26.94,0:42:27.99,*Default,NTP,0000,0000,0000,,Бұл процедура
Dialogue: 0,0:42:28.56,0:42:30.38,*Default,NTP,0000,0000,0000,,Сен екеуміздің арамыздағы шайқас осыдан кейін.
Dialogue: 0,0:42:31.97,0:42:33.26,*Default,NTP,0000,0000,0000,,Осы жерде
Dialogue: 0,0:42:33.32,0:42:36.18,*Default,NTP,0000,0000,0000,,Мен сізге таң қалдыратын фактіні айтуым керек.
Dialogue: 0,0:42:37.04,0:42:39.10,*Default,NTP,0000,0000,0000,,Қазіргіден сәл жас
Dialogue: 0,0:42:39.27,0:42:42.94,*Default,NTP,0000,0000,0000,,Биологиялық әкесімен жыныстық қатынаста болған.
Dialogue: 0,0:42:43.29,0:42:45.27,*Default,NTP,0000,0000,0000,,Солай емес пе? Руне Балот
Dialogue: 0,0:42:50.44,0:42:52.83,*Default,NTP,0000,0000,0000,,Бұл мүлдем қатысы жоқ сұрақ, бас төреші.
Dialogue: 0,0:42:53.57,0:42:54.14,*Default,NTP,0000,0000,0000,,Ой, тоқта! Төмендегі Коике үйінде су ағып жатыр!
Dialogue: 0,0:42:56.55,0:42:58.64,*Default,NTP,0000,0000,0000,,Оны сенен әкең сұрады ма?
Dialogue: 0,0:42:59.58,0:43:00.15,*Default,NTP,0000,0000,0000,,Ой, тоқта! Төмендегі Коике үйінде су ағып жатыр!
Dialogue: 0,0:43:03.58,0:43:05.32,*Default,NTP,0000,0000,0000,,Сіз қарсы тұрдыңыз ба?
Dialogue: 0,0:43:06.00,0:43:06.51,*Default,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:43:07.43,0:43:09.51,*Default,NTP,0000,0000,0000,,Неліктен қарсылық көрсетпедің?
Dialogue: 0,0:43:09.92,0:43:11.14,*Default,NTP,0000,0000,0000,,Жауап беру керек...
Dialogue: 0,0:43:13.52,0:43:15.97,*Default,NTP,0000,0000,0000,,«Мен әкемді жақсы көрдім».
Dialogue: 0,0:43:20.40,0:43:22.20,*Default,NTP,0000,0000,0000,,Ер адам ретінде?
Dialogue: 0,0:43:23.04,0:43:23.61,*Default,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:43:24.39,0:43:27.25,*Default,NTP,0000,0000,0000,,Бір рет емес, бірнеше рет?
Dialogue: 0,0:43:28.04,0:43:28.56,*Default,NTP,0000,0000,0000,,Ой, тоқта! Төмендегі Коике үйінде су ағып жатыр!
Dialogue: 0,0:43:31.68,0:43:35.11,*Default,NTP,0000,0000,0000,,Ағаңыз сіздің әкесімен қарым-қатынасыңызды байқады.
Dialogue: 0,0:43:35.42,0:43:37.59,*Default,NTP,0000,0000,0000,,Сіз әкеңізге күш қолдандыңыз ба?
Dialogue: 0,0:43:38.49,0:43:39.00,*Default,NTP,0000,0000,0000,,Ой, тоқта! Төмендегі Коике үйінде су ағып жатыр!
Dialogue: 0,0:43:43.04,0:43:45.23,*Default,NTP,0000,0000,0000,,Ағаңның ашуының себебін білесің бе?
Dialogue: 0,0:43:46.03,0:43:47.66,*Default,NTP,0000,0000,0000,,Ол жақсы ма?
Dialogue: 0,0:43:49.70,0:43:51.40,*Default,NTP,0000,0000,0000,,«Себебі сен мені сүйдің»
Dialogue: 0,0:43:52.05,0:43:53.42,*Default,NTP,0000,0000,0000,,Әйел ретінде?
Dialogue: 0,0:43:54.55,0:43:55.14,*Default,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:43:55.43,0:43:58.33,*Default,NTP,0000,0000,0000,,Ағаңның, әкеңнің зорлығы үшін
Dialogue: 0,0:43:58.49,0:44:00.33,*Default,NTP,0000,0000,0000,,Сіз қазір ауыр мүгедексіз бе?
Dialogue: 0,0:44:01.50,0:44:02.01,*Default,NTP,0000,0000,0000,,Ой, тоқта! Төмендегі Коике үйінде су ағып жатыр!
Dialogue: 0,0:44:08.53,0:44:10.79,*Default,NTP,0000,0000,0000,,Осыдан кейін әкеңізбен кездестіңіз бе?
Dialogue: 0,0:44:11.43,0:44:11.92,*Default,NTP,0000,0000,0000,,Ой, тоқта! Төмендегі Коике үйінде су ағып жатыр!
Dialogue: 0,0:44:12.39,0:44:14.55,*Default,NTP,0000,0000,0000,,Сіз оны әлі де жақсы көресіз бе?
Dialogue: 0,0:44:15.25,0:44:16.17,*Default,NTP,0000,0000,0000,,Тыныштық
Dialogue: 0,0:44:16.94,0:44:19.19,*Default,NTP,0000,0000,0000,,Әкеңді ер адамдай жақсы көресің бе?
Dialogue: 0,0:44:19.97,0:44:23.52,*Default,NTP,0000,0000,0000,,«Мен енді өз отбасымды қалай жақсы көретінімді білмеймін».
Dialogue: 0,0:44:24.87,0:44:28.86,*Default,NTP,0000,0000,0000,,Сіздің отбасыңыздың бұлай болуына өзің кінәлі деп ойлайсың ба?
Dialogue: 0,0:44:36.15,0:44:36.71,*Default,NTP,0000,0000,0000,,Ой, тоқта! Төмендегі Коике үйінде су ағып жатыр!
Dialogue: 0,0:44:41.83,0:44:42.96,*Default,NTP,0000,0000,0000,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:44:43.57,0:44:46.51,*Default,NTP,0000,0000,0000,,Оның сабырлы және ренжігені анық.
Dialogue: 0,0:44:47.66,0:44:49.95,*Default,NTP,0000,0000,0000,,Келесі жолы осылай ұпай жинай берейік.
Dialogue: 0,0:44:54.95,0:44:55.98,*Default,NTP,0000,0000,0000,,Дауыс беруге барайық
Dialogue: 0,0:44:59.00,0:45:02.72,*Default,NTP,0000,0000,0000,,Келесі жолы сот процесі жария болады және мен шара қолданамын.
Dialogue: 0,0:45:02.96,0:45:03.49,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:45:04.15,0:45:05.21,*Default,NTP,0000,0000,0000,,Егер сіз кері шыққыңыз келсе, дәл қазір.
Dialogue: 0,0:45:07.38,0:45:10.54,*Default,NTP,0000,0000,0000,,Сіз Ufkok үшін қолайлы пайдаланушы емессіз.
Dialogue: 0,0:45:14.65,0:45:16.25,*Default,NTP,0000,0000,0000,,Менің шешімім
Dialogue: 0,0:45:16.65,0:45:18.60,*Default,NTP,0000,0000,0000,,Уфкоктан мен сізден естігім келеді.
Dialogue: 0,0:45:21.93,0:45:23.38,*Default,NTP,0000,0000,0000,,Балот жақсы шыдады
Dialogue: 0,0:45:25.32,0:45:28.30,*Default,NTP,0000,0000,0000,,Балалар, маған айтыңдаршы, қалай күресесіңдер
Dialogue: 0,0:45:37.03,0:45:37.78,*Default,NTP,0000,0000,0000,,Сіз бе?
Dialogue: 0,0:45:38.89,0:45:41.03,*Default,NTP,0000,0000,0000,,Компания үшін сыйақы
Dialogue: 0,0:45:41.40,0:45:42.87,*Default,NTP,0000,0000,0000,,Бұл қандай компания?
Dialogue: 0,0:45:43.32,0:45:45.06,*Default,NTP,0000,0000,0000,,Бұл мал шаруашылығы серіктестігі.
Dialogue: 0,0:45:46.43,0:45:48.25,*Default,NTP,0000,0000,0000,,Сіз мистер Қайнағансыз, солай ма?
Dialogue: 0,0:45:48.53,0:45:50.92,*Default,NTP,0000,0000,0000,,Бастықтан естідім, ішке кірме.
Dialogue: 0,0:45:59.20,0:46:01.59,*Default,NTP,0000,0000,0000,,Bandersnudge компаниясына қош келдіңіз
Dialogue: 0,0:46:02.10,0:46:05.53,*Default,NTP,0000,0000,0000,,Мен сирек кездесетін шашпын. Сізбен танысқаныма қуаныштымын, Қатал жігіт мырза
Dialogue: 0,0:46:13.89,0:46:16.18,*Default,NTP,0000,0000,0000,,Бұл қайнатылған Гемисдар
Dialogue: 0,0:46:16.26,0:46:18.90,*Default,NTP,0000,0000,0000,,Мамандығымыздың ерекшелігіне байланысты қол алысудан аулақ болуымыз керек.
Dialogue: 0,0:46:19.43,0:46:21.54,*Default,NTP,0000,0000,0000,,Орташа Сызықтық тырнақ
Dialogue: 0,0:46:22.01,0:46:24.27,*Default,NTP,0000,0000,0000,,Бұл менің көше атым
Dialogue: 0,0:46:29.04,0:46:30.14,*Default,NTP,0000,0000,0000,,Нәтижелерді тексеріңіз
Dialogue: 0,0:46:32.73,0:46:35.96,*Default,NTP,0000,0000,0000,,Ми хирургтарының бес саусағы
Dialogue: 0,0:46:36.17,0:46:39.72,*Default,NTP,0000,0000,0000,,Мен де әйелдің қызғылт саусағын алдым.
Dialogue: 0,0:46:40.32,0:46:42.89,*Default,NTP,0000,0000,0000,,Миди, мен орауды аяқтадым.
Dialogue: 0,0:46:43.11,0:46:45.75,*Default,NTP,0000,0000,0000,,Ол минзиза ма?
Dialogue: 0,0:46:45.79,0:46:49.02,*Default,NTP,0000,0000,0000,,Минс, маған үлесіңді көрсет.
Dialogue: 0,0:46:49.31,0:46:51.43,*Default,NTP,0000,0000,0000,,Сізді біздің хоббиіміз қызықтырады ма?
Dialogue: 0,0:46:52.35,0:46:53.25,*Default,NTP,0000,0000,0000,,Растау.
Dialogue: 0,0:46:56.48,0:46:57.77,*Default,NTP,0000,0000,0000,,Мұнда қараңыз.
Dialogue: 0,0:46:57.97,0:47:00.87,*Default,NTP,0000,0000,0000,,Дәрігердің көздері таңғаларлық романтикалық, солай емес пе?
Dialogue: 0,0:47:01.24,0:47:03.24,*Default,NTP,0000,0000,0000,,Жарқырап тұр, солай емес пе?
Dialogue: 0,0:47:03.75,0:47:06.08,*Default,NTP,0000,0000,0000,,Минди, кешіріңіз.
Dialogue: 0,0:47:06.37,0:47:07.53,*Default,NTP,0000,0000,0000,,Бұл менікі
Dialogue: 0,0:47:07.88,0:47:10.31,*Default,NTP,0000,0000,0000,,Менің терісім мен шашым өте жақсы емес.
Dialogue: 0,0:47:10.60,0:47:12.97,*Default,NTP,0000,0000,0000,,Дәрігерлер тұрақты емес өмір сүреді.
Dialogue: 0,0:47:13.52,0:47:15.12,*Default,NTP,0000,0000,0000,,Медициналық тексеру деректері ше?
Dialogue: 0,0:47:15.48,0:47:16.44,*Default,NTP,0000,0000,0000,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:47:19.41,0:47:21.88,*Default,NTP,0000,0000,0000,,Эй, мен жаңа шортанмын
Dialogue: 0,0:47:22.43,0:47:26.99,*Default,NTP,0000,0000,0000,,Маған қол тигізуге рұқсат ете аласыз.
Dialogue: 0,0:47:28.56,0:47:29.28,*Default,NTP,0000,0000,0000,,Деректер туралы не деуге болады?
Dialogue: 0,0:47:30.01,0:47:32.61,*Default,NTP,0000,0000,0000,,Иә Миды емдеу деректерінің мысалы
Dialogue: 0,0:47:32.73,0:47:34.83,*Default,NTP,0000,0000,0000,,Тек осы дискіде қол жетімді
Dialogue: 0,0:47:37.68,0:47:39.51,*Default,NTP,0000,0000,0000,,Адамның қандай дене мүшелерін тастадың?
Dialogue: 0,0:47:40.03,0:47:43.97,*Default,NTP,0000,0000,0000,,Ештеңе! Трансплантация үшін Зерттеу үшін Азық-түлікке пайдалану…
Dialogue: 0,0:47:44.24,0:47:47.61,*Default,NTP,0000,0000,0000,,Лақтыратын жалғыз нәрсе - өмір өткеннен кейін қалған бостық.
Dialogue: 0,0:47:49.73,0:47:52.63,*Default,NTP,0000,0000,0000,,Сіздің бастықтарыңыз да бөліктермен ауыстырылды ма?
Dialogue: 0,0:47:53.04,0:47:54.98,*Default,NTP,0000,0000,0000,,Иә, ерекше
Dialogue: 0,0:47:55.05,0:47:55.88,*Default,NTP,0000,0000,0000,,Босс
Dialogue: 0,0:47:56.48,0:47:57.50,*Default,NTP,0000,0000,0000,,Маған кіруге рұқсат етіңіз
Dialogue: 0,0:48:00.71,0:48:02.65,*Default,NTP,0000,0000,0000,,Сегіз заң Мисдар Қайнады
Dialogue: 0,0:48:03.79,0:48:05.98,*Default,NTP,0000,0000,0000,,Маған жарайсың
Dialogue: 0,0:48:07.53,0:48:09.88,*Default,NTP,0000,0000,0000,,Мен коллекцияларды сирек өткіземін
Dialogue: 0,0:48:10.17,0:48:12.93,*Default,NTP,0000,0000,0000,,Менің іздеп жүргенім бір бөлек зат.
Dialogue: 0,0:48:14.13,0:48:17.46,*Default,NTP,0000,0000,0000,,Пуссика өзінің тарлығы мен сезімталдығымен мақтанады.
Dialogue: 0,0:48:19.61,0:48:20.20,*Default,NTP,0000,0000,0000,,Сыйақы
Dialogue: 0,0:48:25.25,0:48:27.25,*Default,NTP,0000,0000,0000,,Бұл сіздің келесі мақсатыңыз ба?
Dialogue: 0,0:48:27.92,0:48:30.97,*Default,NTP,0000,0000,0000,,09 Сізді қорғау үшін екі офицер мен қауіпсіздік құрылымы тағайындалады.
Dialogue: 0,0:48:31.52,0:48:32.34,*Default,NTP,0000,0000,0000,,Хо
Dialogue: 0,0:48:38.80,0:48:41.82,*Default,NTP,0000,0000,0000,,Жақсы, жақсы, анау саусақ.
Dialogue: 0,0:48:42.23,0:48:45.33,*Default,NTP,0000,0000,0000,,Мен әдемі теріні қалаймын. Мен оны қатты қалаймын.
Dialogue: 0,0:48:45.58,0:48:49.14,*Default,NTP,0000,0000,0000,,Оның көздері сондай мөлдір, періштедей.
Dialogue: 0,0:48:49.44,0:48:50.89,*Default,NTP,0000,0000,0000,,Бұл сүйкімді, солай емес пе?
Dialogue: 0,0:48:51.02,0:48:53.14,*Default,NTP,0000,0000,0000,,Күн сайын аз-аздан гормондық инъекциялар жасаңыз.
Dialogue: 0,0:48:53.41,0:48:55.53,*Default,NTP,0000,0000,0000,,Мен өмірімді кеңейткім келеді
Dialogue: 0,0:48:56.17,0:48:58.45,*Default,NTP,0000,0000,0000,,Жарайды, қалғаны мазмұнды.
Dialogue: 0,0:48:58.92,0:49:00.09,*Default,NTP,0000,0000,0000,,Оң қолға лайық
Dialogue: 0,0:49:00.09,0:49:01.72,*Default,NTP,0000,0000,0000,,мысық болуы мүмкін
Dialogue: 0,0:49:02.66,0:49:06.75,*Default,NTP,0000,0000,0000,,Бізді 5 дәрігермен көріңіз, бұл сүйікті ме?
Dialogue: 0,0:49:07.57,0:49:11.16,*Default,NTP,0000,0000,0000,,Ендеше оның қай мүшесін қалайсыз?
Dialogue: 0,0:49:12.35,0:49:14.72,*Default,NTP,0000,0000,0000,,Маған өмір жойылғаннан кейін бослықты бер
Dialogue: 0,0:49:23.36,0:49:26.67,*Default,NTP,0000,0000,0000,,Жоқ, бюллетень! Мұның бәріне жоқ!
Dialogue: 0,0:49:28.78,0:49:29.64,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:49:29.84,0:49:31.64,*Default,NTP,0000,0000,0000,,Мен сенің құйрығыңды енді қыспаймын
Dialogue: 0,0:49:31.64,0:49:33.50,*Default,NTP,0000,0000,0000,,Маған айтқандары да ұнамайды!
Dialogue: 0,0:49:33.99,0:49:36.48,*Default,NTP,0000,0000,0000,,Мен өз мінезімді жоққа шығарғандай сезінемін.
Dialogue: 0,0:49:36.97,0:49:40.24,*Default,NTP,0000,0000,0000,,Асыл құйрығың болса, шалбарыңа тығып ал.
Dialogue: 0,0:49:40.67,0:49:42.14,*Default,NTP,0000,0000,0000,,Докудар жігіт осылай деді.
Dialogue: 0,0:49:42.53,0:49:46.35,*Default,NTP,0000,0000,0000,,"Шалбарымның бөксесі томпайып тұр. Тіпті үлкені бірдеңе ағып кетті."
Dialogue: 0,0:49:47.58,0:49:50.28,*Default,NTP,0000,0000,0000,,Менің мақтаныш құйрығым өте жақсы!
Dialogue: 0,0:49:53.26,0:49:55.18,*Default,NTP,0000,0000,0000,,ше? Өтінемін күлмеңіз, өтінемін
Dialogue: 0,0:49:56.06,0:49:56.90,*Default,NTP,0000,0000,0000,,Бұрын… пышақ еді.
Dialogue: 0,0:49:59.29,0:50:00.00,*Default,NTP,0000,0000,0000,,Мен ашуланбаймын
Dialogue: 0,0:50:00.72,0:50:03.25,*Default,NTP,0000,0000,0000,,Мен шалбарымнан гөрі сенің киіміңді жөндегенді жөн көремін.
Dialogue: 0,0:50:03.89,0:50:06.11,*Default,NTP,0000,0000,0000,,Мен сияқты сенің денеңде шаш көп емес.
Dialogue: 0,0:50:06.64,0:50:07.36,*Default,NTP,0000,0000,0000,,Сіз суық тиіп қаласыз.
Dialogue: 0,0:50:08.71,0:50:09.14,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:50:18.58,0:50:22.05,*Default,NTP,0000,0000,0000,,Ыстыққа төзімді, суыққа төзімді, қысымға төзімді, соққыға төзімді костюм.
Dialogue: 0,0:50:22.60,0:50:24.51,*Default,NTP,0000,0000,0000,,Қосымша сіздің Snark-ті арттырады.
Dialogue: 0,0:50:29.29,0:50:30.41,*Default,NTP,0000,0000,0000,,Сүйкімді емес
Dialogue: 0,0:50:30.90,0:50:33.64,*Default,NTP,0000,0000,0000,,Дизайнды өз қалауыңыз бойынша еркін өзгертуге болады.
Dialogue: 0,0:50:34.01,0:50:35.78,*Default,NTP,0000,0000,0000,,Олай болса, костюмдер туралы әбігерді кейінірек сақтайық.
Dialogue: 0,0:50:38.14,0:50:38.93,*Default,NTP,0000,0000,0000,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:50:39.48,0:50:42.55,*Default,NTP,0000,0000,0000,,Теориялық тұрғыдан сіз өз денеңізді ұра аласыз.
Dialogue: 0,0:50:42.79,0:50:45.65,*Default,NTP,0000,0000,0000,,Сіз өзіңіздің физикалық денеңізді, сондай-ақ сезіміңізді жылдамдата аласыз.
Dialogue: 0,0:50:46.84,0:50:48.37,*Default,NTP,0000,0000,0000,,Ал, сынап көр.
Dialogue: 0,0:50:49.80,0:50:52.01,*Default,NTP,0000,0000,0000,,Ойланудың қажеті жоқ, тек сезіну керек
Dialogue: 0,0:50:57.45,0:50:58.22,*Default,NTP,0000,0000,0000,,Тамаша жұмыс
Dialogue: 0,0:50:59.06,0:51:02.76,*Default,NTP,0000,0000,0000,,Мен әр допқа бір рет ату туралы ойладым...
Dialogue: 0,0:51:03.52,0:51:04.11,*Default,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,0:51:04.86,0:51:06.62,*Default,NTP,0000,0000,0000,,Одан кейін қозғалу кезінде түсіріп көріңіз.
Dialogue: 0,0:51:13.67,0:51:14.86,*Default,NTP,0000,0000,0000,,Бұл шар тәрізді нысана.
Dialogue: 0,0:51:15.27,0:51:19.11,*Default,NTP,0000,0000,0000,,100% рикошетсіз орталыққа қалай соғуға болады?
Dialogue: 0,0:51:22.85,0:51:23.70,*Default,NTP,0000,0000,0000,,Прокурордан.
Dialogue: 0,0:51:24.87,0:51:27.12,*Default,NTP,0000,0000,0000,,Shell компаниясын басқарған бес нейрохирург
Dialogue: 0,0:51:27.55,0:51:28.81,*Default,NTP,0000,0000,0000,,Олар бір уақытта жоғалып кетті...
Dialogue: 0,0:51:29.51,0:51:31.51,*Default,NTP,0000,0000,0000,,Жарайды, мен қорықпаймын.
Dialogue: 0,0:51:32.23,0:51:33.39,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:51:33.90,0:51:35.84,*Default,NTP,0000,0000,0000,,Бұл мәселе өмірді құтқаратын бағдарлама.
Dialogue: 0,0:51:35.88,0:51:38.36,*Default,NTP,0000,0000,0000,,Оны ең маңызды деңгейге көтеруге негіз бар ма?
Dialogue: 0,0:51:38.68,0:51:39.73,*Default,NTP,0000,0000,0000,,Біз бір-бірімізді шақырамыз
Dialogue: 0,0:51:40.67,0:51:42.34,*Default,NTP,0000,0000,0000,,Мен де жаңа жасырынатын орын ұйымдастырамын.
Dialogue: 0,0:51:42.75,0:51:45.22,*Default,NTP,0000,0000,0000,,Иә, мен жоқта маған шабуыл жасалмайды деп қорқамын.
Dialogue: 0,0:51:45.86,0:51:47.84,*Default,NTP,0000,0000,0000,,Қауіпсіздік аппараты персоналмен қамтамасыз етілген.
Dialogue: 0,0:51:48.80,0:51:50.21,*Default,NTP,0000,0000,0000,,Ол сені бүгін түнде қорғайтын шығар.
Dialogue: 0,0:51:50.96,0:51:52.09,*Default,NTP,0000,0000,0000,,Мен сенгім келеді.
Dialogue: 0,0:51:52.93,0:51:54.13,*Default,NTP,0000,0000,0000,,Ал, мен барамын.
Dialogue: 0,0:51:54.66,0:51:56.62,*Default,NTP,0000,0000,0000,,Уфкоктың айтқанын мұқият тыңда.
Dialogue: 0,0:51:56.75,0:51:57.20,*Default,NTP,0000,0000,0000,,Бюллетень
Dialogue: 0,0:52:03.39,0:52:06.35,*Default,NTP,0000,0000,0000,,Мен сені тағы атсам болады ма? Өйткені бұл мені жақсы сезінеді
Dialogue: 0,0:52:06.99,0:52:08.54,*Default,NTP,0000,0000,0000,,Сондықтан зорлық-зомбылық танытуға болмайды.
Dialogue: 0,0:52:10.70,0:52:12.20,*Default,NTP,0000,0000,0000,,Қабық дәрігерді жойды ма?
Dialogue: 0,0:52:12.63,0:52:14.96,*Default,NTP,0000,0000,0000,,Shell мәмілесіне қатысты болуы мүмкін.
Dialogue: 0,0:52:15.67,0:52:18.69,*Default,NTP,0000,0000,0000,,Бұл Shell естеліктерін сақтау мүмкіндігін арттырады.
Dialogue: 0,0:52:19.29,0:52:20.43,*Default,NTP,0000,0000,0000,,Кім шабуыл жасайды?
Dialogue: 0,0:52:20.59,0:52:22.15,*Default,NTP,0000,0000,0000,,Белгісіз, келу міндетті емес.
Dialogue: 0,0:52:22.27,0:52:22.95,*Default,NTP,0000,0000,0000,,Олар келсе ше?
Dialogue: 0,0:52:23.13,0:52:24.11,*Default,NTP,0000,0000,0000,,Оны қауіпсіздікке қалдырыңыз
Dialogue: 0,0:52:25.03,0:52:26.68,*Default,NTP,0000,0000,0000,,Егер қауіпсіздік қызметкерлері де жоғалып кетсе ше?
Dialogue: 0,0:52:27.17,0:52:28.58,*Default,NTP,0000,0000,0000,,Оған өзіміз тойтарыс береміз
Dialogue: 0,0:52:29.63,0:52:30.28,*Default,NTP,0000,0000,0000,,Өлтіру?
Dialogue: 0,0:52:31.14,0:52:32.35,*Default,NTP,0000,0000,0000,,Мен осылай атуым керек пе?
Dialogue: 0,0:52:32.82,0:52:34.92,*Default,NTP,0000,0000,0000,,Қажет болғанша қорғаңыз
Dialogue: 0,0:52:35.92,0:52:37.84,*Default,NTP,0000,0000,0000,,Бірақ өлтіру үшін емес
Dialogue: 0,0:52:38.78,0:52:39.11,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:52:42.34,0:52:43.26,*Default,NTP,0000,0000,0000,,Енді демалайық па?
Dialogue: 0,0:52:43.99,0:52:46.16,*Default,NTP,0000,0000,0000,,Жарайды, сәл артық
Dialogue: 0,0:52:47.63,0:52:49.65,*Default,NTP,0000,0000,0000,,Неліктен қарсылық көрсетпедің?
Dialogue: 0,0:52:51.18,0:52:52.18,*Default,NTP,0000,0000,0000,,«Тыныштық»
Dialogue: 0,0:52:55.58,0:52:56.40,*Default,NTP,0000,0000,0000,,Қауіпсіздік туралы не деуге болады?
Dialogue: 0,0:52:57.54,0:53:00.07,*Default,NTP,0000,0000,0000,,Телефон желісі Қауіпсіздік жүйесінің желісі
Dialogue: 0,0:53:00.57,0:53:01.57,*Default,NTP,0000,0000,0000,,Екеуін де ұстаңыз
Dialogue: 0,0:53:06.55,0:53:08.19,*Default,NTP,0000,0000,0000,,Бәрі де бітті.
Dialogue: 0,0:53:08.56,0:53:11.42,*Default,NTP,0000,0000,0000,,Өте оңай Мен қазір кофе дайындап жатырмын.
Dialogue: 0,0:53:13.73,0:53:16.46,*Default,NTP,0000,0000,0000,,Мен біткен бойда шошқаларды жинаймын.
Dialogue: 0,0:53:19.32,0:53:21.72,*Default,NTP,0000,0000,0000,,Бұл шошқа толтырылған.
Dialogue: 0,0:53:21.86,0:53:26.27,*Default,NTP,0000,0000,0000,,Алғашқы түнімдей жүрегім дүрсілдеп тұр
Dialogue: 0,0:53:28.97,0:53:31.97,*Default,NTP,0000,0000,0000,,Мен де. Оны тез үйге әкелейік.
Dialogue: 0,0:53:34.65,0:53:36.63,*Default,NTP,0000,0000,0000,,Қорқыныш Өлімнің иісі
Dialogue: 0,0:53:39.90,0:53:41.21,*Default,NTP,0000,0000,0000,,Дайынсың ба?
Dialogue: 0,0:53:45.26,0:53:47.30,*Default,NTP,0000,0000,0000,,Мені қатты ұстаңыз
Dialogue: 0,0:53:49.63,0:53:52.84,*Default,NTP,0000,0000,0000,,Жылу көзі солтүстік ванна бөлмесінде және 1-қабатта анықталды
Dialogue: 0,0:53:53.57,0:53:54.55,*Default,NTP,0000,0000,0000,,Миди, жүр.
Dialogue: 0,0:53:56.03,0:53:58.83,*Default,NTP,0000,0000,0000,,Freshy Мұнда кім бар?
Dialogue: 0,0:53:59.48,0:54:02.30,*Default,NTP,0000,0000,0000,,Мен мылтығымды дайын күйде күтемін.
Dialogue: 0,0:54:03.65,0:54:06.32,*Default,NTP,0000,0000,0000,,Бұл ойын, қатал жігіт!
Dialogue: 0,0:54:11.47,0:54:12.39,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:54:16.17,0:54:18.85,*Default,NTP,0000,0000,0000,,Балғын Мен нені көріп тұрмын?
Dialogue: 0,0:54:19.10,0:54:21.59,*Default,NTP,0000,0000,0000,,Бұл ойын, қатал жігіт
Dialogue: 0,0:54:41.37,0:54:42.27,*Default,NTP,0000,0000,0000,,Не болды, Миди?
Dialogue: 0,0:54:42.82,0:54:45.29,*Default,NTP,0000,0000,0000,,Well Midi-мен байланысу мүмкін емес
Dialogue: 0,0:54:45.82,0:54:48.97,*Default,NTP,0000,0000,0000,,Ештеңе жоқ, ешкім болмады.
Dialogue: 0,0:54:49.26,0:54:51.67,*Default,NTP,0000,0000,0000,,Мақсатты іздеуді жалғастырыңыз
Dialogue: 0,0:54:54.80,0:54:57.02,*Default,NTP,0000,0000,0000,,Сен мұны міне аласың ба, Фреши?
Dialogue: 0,0:54:57.15,0:54:58.02,*Default,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:54:58.29,0:55:00.19,*Default,NTP,0000,0000,0000,,Миди мен басқалары жауын тапты ма?
Dialogue: 0,0:55:00.42,0:55:01.23,*Default,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:55:01.89,0:55:02.99,*Default,NTP,0000,0000,0000,,Маған сызбаларды жіберіңізші.
Dialogue: 0,0:55:03.38,0:55:04.16,*Default,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:55:09.20,0:55:10.47,*Default,NTP,0000,0000,0000,,Бейбақ!
Dialogue: 0,0:55:24.47,0:55:26.94,*Default,NTP,0000,0000,0000,,Жақсы! Freshy бұзылды!
Dialogue: 0,0:55:27.25,0:55:28.39,*Default,NTP,0000,0000,0000,,Жақсы! О! ?
Dialogue: 0,0:55:30.07,0:55:31.68,*Default,NTP,0000,0000,0000,,Мен сені ұрамын!
Dialogue: 0,0:55:32.23,0:55:36.89,*Default,NTP,0000,0000,0000,,Мен өзімді көз алмаңды кесіп тастаған шұңқырға саламын!
Dialogue: 0,0:55:47.68,0:55:51.09,*Default,NTP,0000,0000,0000,,О, құдай! Жалынды бала!
Dialogue: 0,0:55:51.40,0:55:53.69,*Default,NTP,0000,0000,0000,,Неліктен жау емес, бала?
Dialogue: 0,0:55:53.81,0:55:57.02,*Default,NTP,0000,0000,0000,,Түсіндірші, балғын, шошқа!
Dialogue: 0,0:56:00.86,0:56:02.56,*Default,NTP,0000,0000,0000,,Уау! Сен қайдасың, хакер тентек?
Dialogue: 0,0:56:02.88,0:56:05.50,*Default,NTP,0000,0000,0000,,Менімен араласпа, бейбақ!
Dialogue: 0,0:56:07.11,0:56:09.01,*Default,NTP,0000,0000,0000,,Сен сондай ақымақ еліктеушісің!
Dialogue: 0,0:56:10.53,0:56:13.16,*Default,NTP,0000,0000,0000,,Шошқаның сені былғауына рұқсат етемін, бейбақ!
Dialogue: 0,0:56:17.17,0:56:18.25,*Default,NTP,0000,0000,0000,,Қашықтан басқару пульті! ? !
Dialogue: 0,0:56:33.68,0:56:35.07,*Default,NTP,0000,0000,0000,,Өлтіремін!
Dialogue: 0,0:56:52.13,0:56:54.13,*Default,NTP,0000,0000,0000,,Шошқа сені зорласын
Dialogue: 0,0:56:54.75,0:56:55.95,*Default,NTP,0000,0000,0000,,Өлімнің иісі! Жабыңыз!
Dialogue: 0,0:57:09.85,0:57:10.52,*Default,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:57:11.32,0:57:13.02,*Default,NTP,0000,0000,0000,,Мен енді отты шар болғым келмейді.
Dialogue: 0,0:57:14.47,0:57:15.90,*Default,NTP,0000,0000,0000,,Соңғысы жер астында ма?
Dialogue: 0,0:57:16.37,0:57:17.80,*Default,NTP,0000,0000,0000,,Бұлай айтпа.
Dialogue: 0,0:57:18.19,0:57:19.39,*Default,NTP,0000,0000,0000,,Сіз көңіл көтеруге тырысасыз ба?
Dialogue: 0,0:57:20.03,0:57:22.80,*Default,NTP,0000,0000,0000,,Мен сендер маған үйреткен нәрселерді істеп жатырмын.
Dialogue: 0,0:57:23.01,0:57:23.54,*Default,NTP,0000,0000,0000,,Мен...
Dialogue: 0,0:57:23.54,0:57:24.46,*Default,NTP,0000,0000,0000,,Қарсымын!
Dialogue: 0,0:57:25.63,0:57:26.61,*Default,NTP,0000,0000,0000,,Мен мұны жақсы орындаймын
Dialogue: 0,0:57:29.30,0:57:30.88,*Default,NTP,0000,0000,0000,,Жаңа ма? Барлықтарыңыз жауап беріңіздерші
Dialogue: 0,0:57:32.21,0:57:34.06,*Default,NTP,0000,0000,0000,,Кез келген жерден есегіңізді бағыттаңыз!
Dialogue: 0,0:57:34.33,0:57:35.82,*Default,NTP,0000,0000,0000,,Мен бұл жігітті бір нәрсеге айналдырамын!
Dialogue: 0,0:57:57.34,0:57:59.47,*Default,NTP,0000,0000,0000,,Негізгі тактиканы ұстаныңыз!
Dialogue: 0,0:58:00.85,0:58:02.16,*Default,NTP,0000,0000,0000,,Бұл осылай болды
Dialogue: 0,0:58:02.59,0:58:03.25,*Default,NTP,0000,0000,0000,,Бюллетень?
Dialogue: 0,0:58:03.92,0:58:05.51,*Default,NTP,0000,0000,0000,,Барлық ер адамдар
Dialogue: 0,0:58:06.35,0:58:07.95,*Default,NTP,0000,0000,0000,,Мен әрқашан осылай сезінетінмін
Dialogue: 0,0:58:08.54,0:58:12.54,*Default,NTP,0000,0000,0000,,Өтінемін, маған қиянат жасама, тоқта...
Dialogue: 0,0:58:12.54,0:58:13.75,*Default,NTP,0000,0000,0000,,Жарайды, Уфукок.
Dialogue: 0,0:58:14.87,0:58:16.41,*Default,NTP,0000,0000,0000,,Мен сізді мейірімділікпен пайдаланамын
Dialogue: 0,0:58:18.14,0:58:20.94,*Default,NTP,0000,0000,0000,,Жоқ, ол жұмыс істемейді! Барлығы...
Dialogue: 0,0:58:21.29,0:58:23.25,*Default,NTP,0000,0000,0000,,Мен бұған сенбеймін...
Dialogue: 0,0:58:23.68,0:58:26.28,*Default,NTP,0000,0000,0000,,Бұл теріс пайдалану. Пайдаланушы ауытқыды.
Dialogue: 0,0:58:29.20,0:58:30.40,*Default,NTP,0000,0000,0000,,Жетеді.
Dialogue: 0,0:58:36.82,0:58:38.37,*Default,NTP,0000,0000,0000,,Мен сені зорлаймын, масқара!
Dialogue: 0,0:58:39.33,0:58:41.11,*Default,NTP,0000,0000,0000,,Мен сені зорлаймын! Ақымақ!
Dialogue: 0,0:58:41.93,0:58:44.11,*Default,NTP,0000,0000,0000,,Мен оны орындаймын Мен оны орындаймын
Dialogue: 0,0:58:44.91,0:58:45.73,*Default,NTP,0000,0000,0000,,Мен сені зорлаймын!
Dialogue: 0,0:58:46.69,0:58:48.04,*Default,NTP,0000,0000,0000,,Сіз қоқыссыз!
Dialogue: 0,0:58:48.63,0:58:49.84,*Default,NTP,0000,0000,0000,,Өл! Ақымақ!
Dialogue: 0,0:59:01.36,0:59:03.90,*Default,NTP,0000,0000,0000,,Уфкок? Жауап бер, не болды?
Dialogue: 0,0:59:04.33,0:59:06.02,*Default,NTP,0000,0000,0000,,Сәлем Уфукок!
Dialogue: 0,0:59:10.80,0:59:11.74,*Default,NTP,0000,0000,0000,,Уфукок!
Dialogue: 0,0:59:11.85,0:59:13.19,*Default,NTP,0000,0000,0000,,... Мені жіберіңізші.
Dialogue: 0,0:59:16.24,0:59:18.92,*Default,NTP,0000,0000,0000,,Маған тиіспе...
Dialogue: 0,0:59:20.14,0:59:22.10,*Default,NTP,0000,0000,0000,,Уфкок, не болды?
Dialogue: 0,0:59:22.47,0:59:23.84,*Default,NTP,0000,0000,0000,,Сәлем Уфукок!
Dialogue: 0,0:59:24.37,0:59:26.29,*Default,NTP,0000,0000,0000,,Тоқта, ол келе жатыр.
Dialogue: 0,0:59:26.76,0:59:28.19,*Default,NTP,0000,0000,0000,,Шатырға қашыңыз!
Dialogue: 0,0:59:38.78,0:59:40.64,*Default,NTP,0000,0000,0000,,Менің қолыма оралыңыз Уфкок
Dialogue: 0,0:59:41.68,0:59:44.03,*Default,NTP,0000,0000,0000,,Ол қыз бен менің айырмашылығым жоқ.
Dialogue: 0,0:59:45.66,0:59:46.83,*Default,NTP,0000,0000,0000,,Ол басқаша
Dialogue: 0,0:59:48.85,0:59:50.39,*Default,NTP,0000,0000,0000,,Қаш, Барот.
Dialogue: 0,0:59:51.39,0:59:55.41,*Default,NTP,0000,0000,0000,,Ол кісінің мені қорқытқаны сонша, мен өз өмірім үшін қорықтым.
Dialogue: 0,0:59:56.23,0:59:56.80,*Default,NTP,0000,0000,0000,,Сол себепті!
Dialogue: 0,0:59:57.46,0:59:59.42,*Default,NTP,0000,0000,0000,,Жоқ, ол...
Dialogue: 0,0:59:59.54,1:00:02.14,*Default,NTP,0000,0000,0000,,Мені түсініңіз
Dialogue: 0,1:00:23.88,1:00:25.08,*Default,NTP,0000,0000,0000,,Сіз естіген жоқсыз ба?
Dialogue: 0,1:00:25.94,1:00:27.07,*Default,NTP,0000,0000,0000,,Мен де сен сияқтымын
Dialogue: 0,1:00:27.07,1:00:29.09,*Default,NTP,0000,0000,0000,,Тыйым салынған технологиямен жасалған құбыжық.
Dialogue: 0,1:00:50.93,1:00:51.71,*Default,NTP,0000,0000,0000,,Уфукок!
Dialogue: 0,1:00:52.08,1:00:54.43,*Default,NTP,0000,0000,0000,,Зиянкестерден өзін-өзі қорғау
Dialogue: 0,1:00:55.22,1:00:57.15,*Default,NTP,0000,0000,0000,,Уфкок сізден бас тартты.
Dialogue: 0,1:01:05.14,1:01:08.14,*Default,NTP,0000,0000,0000,,Жоқ... Қайнатылған
Dialogue: 0,1:01:23.10,1:01:26.22,*Default,NTP,0000,0000,0000,,Неліктен пайдаланушының теріс пайдалануына жол береміз?
Dialogue: 0,1:01:28.90,1:01:29.88,*Default,NTP,0000,0000,0000,,Уфукок!
Dialogue: 0,1:01:32.68,1:01:34.07,*Default,NTP,0000,0000,0000,,Кешіріңіз, Уфукок.
Dialogue: 0,1:01:34.83,1:01:36.83,*Default,NTP,0000,0000,0000,,Кешіріңіз, бармаңыз.
Dialogue: 0,1:01:37.12,1:01:40.45,*Default,NTP,0000,0000,0000,,Менің қолымда болшы, Уфкок.
Dialogue: 0,1:01:41.41,1:01:42.33,*Default,NTP,0000,0000,0000,,Өтінемін….
Dialogue: 0,1:01:42.76,1:01:43.45,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:01:44.47,1:01:48.13,*Default,NTP,0000,0000,0000,,Бұл бас тарту реакциясының бір түрі. Уайымдамаңыз, ол жақында жазылады.
Dialogue: 0,1:01:49.09,1:01:50.71,*Default,NTP,0000,0000,0000,,Аз ғана уақытты осы жерден сатып алыңыз
Dialogue: 0,1:01:52.05,1:01:52.67,*Default,NTP,0000,0000,0000,,Абайлаңыз
Dialogue: 0,1:01:53.50,1:01:55.41,*Default,NTP,0000,0000,0000,,Ол ғимарат қабырғасымен жүреді.
Dialogue: 0,1:01:56.53,1:01:57.90,*Default,NTP,0000,0000,0000,,Мен де ертерек жүрдім.
Dialogue: 0,1:01:58.29,1:02:01.66,*Default,NTP,0000,0000,0000,,Бұл псевдогравитация. Ол сонымен қатар оқтың траекториясын өзгертеді.
Dialogue: 0,1:02:02.62,1:02:04.50,*Default,NTP,0000,0000,0000,,Мен сізге ертерек айтуым керек еді.
Dialogue: 0,1:02:05.60,1:02:06.42,*Default,NTP,0000,0000,0000,,Бұл менің қателігім болды.
Dialogue: 0,1:02:07.99,1:02:12.49,*Default,NTP,0000,0000,0000,,Оның денесі туралы мүмкіндігінше айтқым келмеді.
Dialogue: 0,1:02:13.12,1:02:16.66,*Default,NTP,0000,0000,0000,,Өткеніңді ешкімге айтқың келмейтіндей.
Dialogue: 0,1:02:17.70,1:02:19.01,*Default,NTP,0000,0000,0000,,Сен мейірімдісің
Dialogue: 0,1:02:19.68,1:02:21.95,*Default,NTP,0000,0000,0000,,Мен сені бұдан былай ренжіткім келмейді
Dialogue: 0,1:02:22.67,1:02:24.83,*Default,NTP,0000,0000,0000,,Жарайды, маған зиян тигізбейді.
Dialogue: 0,1:02:26.65,1:02:27.26,*Default,NTP,0000,0000,0000,,Мен келе жатырмын
Dialogue: 0,1:03:23.62,1:03:24.23,*Default,NTP,0000,0000,0000,,барлығы дерлік өлімге ұшырауға жақын қалды, бұл менің кінәм.
Dialogue: 0,1:03:25.79,1:03:28.67,*Default,NTP,0000,0000,0000,,Тез бұрылыңыз.
Dialogue: 0,1:03:30.81,1:03:31.80,*Default,NTP,0000,0000,0000,,Мені пайдаланыңыз
Dialogue: 0,1:03:33.90,1:03:36.66,*Default,NTP,0000,0000,0000,,Өзіңізді қорғаңыз
Dialogue: 0,1:03:39.87,1:03:43.98,*Default,NTP,0000,0000,0000,,Бұл мылтық ол кезде сен едің.
Dialogue: 0,1:03:46.18,1:03:47.57,*Default,NTP,0000,0000,0000,,Сен менімен біргесің
Dialogue: 0,1:03:47.57,1:03:50.43,*Default,NTP,0000,0000,0000,,Көбірек бос болу үшін жасалған
Dialogue: 0,1:03:54.50,1:03:55.50,*Default,NTP,0000,0000,0000,,Уфкок
Dialogue: 0,1:04:01.06,1:04:03.27,*Default,NTP,0000,0000,0000,,Бұл біздің болмысымыз
Dialogue: 0,1:04:04.51,1:04:05.35,*Default,NTP,0000,0000,0000,,Қорытынды
Dialogue: 0,1:04:06.85,1:04:12.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory