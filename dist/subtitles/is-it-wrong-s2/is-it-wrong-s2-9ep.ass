Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.93,0:00:36.60,Default,,0,0,0,,Қайда бардың! ? Соны ізде!
Dialogue: 0,0:00:36.60,0:00:41.94,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:00:41.94,0:00:44.94,Default,,0,0,0,,《Мен ең жаманмын...》
Dialogue: 0,0:00:44.94,0:00:47.11,Default,,0,0,0,,((Айша: Сонда бұл соғыс!
Dialogue: 0,0:00:47.11,0:00:49.11,Default,,0,0,0,,Отбасыңызбен! ))
Dialogue: 0,0:00:51.11,0:00:53.95,Default,,0,0,0,,《Мен ештеңе айта алмадым.
Dialogue: 0,0:00:53.95,0:00:59.12,Default,,0,0,0,,Егер сіз Харухиме-санға көмектессеңіз, Иштар Фамилиямен соғыс болады.
Dialogue: 0,0:00:59.12,0:01:02.96,Default,,0,0,0,,Бәрі де көрінді.
Dialogue: 0,0:01:02.96,0:01:05.96,Default,,0,0,0,,Шешімсіздік! 》
Dialogue: 0,0:01:05.96,0:01:11.13,Default,,0,0,0,,((Харухиме: Мен... Харухиме бақытты.
Dialogue: 0,0:01:11.13,0:01:16.47,Default,,0,0,0,,Бұл сөздерді естігеннен кейін өкінбеймін))
Dialogue: 0,0:01:16.47,0:01:18.97,Default,,0,0,0,,《Харухиме-сан…》
Dialogue: 0,0:01:22.48,0:01:25.58,Default,,0,0,0,,《Қоңырау: не істеуім керек...》
Dialogue: 0,0:03:10.29,0:03:13.66,Default,,0,0,0,,Мұнда Белл-кун және басқалары болуы керек. Оларға рұқсат етіңіз!
Dialogue: 0,0:03:13.66,0:03:16.99,Default,,0,0,0,,Құдай-ау, дәлелің бар ма?
Dialogue: 0,0:03:16.99,0:03:19.49,Default,,0,0,0,,Біз бүгін уақытша жабықпыз.
Dialogue: 0,0:03:19.49,0:03:22.50,Default,,0,0,0,,Бұйрық ешкімді өткізбеу.
Dialogue: 0,0:03:22.50,0:03:24.50,Default,,0,0,0,,Гуннууу….
Dialogue: 0,0:03:24.50,0:03:26.84,Default,,0,0,0,,Жақсы, күткендей.
Dialogue: 0,0:03:26.84,0:03:29.67,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:03:29.67,0:03:33.28,Default,,0,0,0,,Такемиказучи мырза. қалай болды?
Dialogue: 0,0:03:33.28,0:03:36.28,Default,,0,0,0,,Тағы да барлық кіре берістер мөрленген.
Dialogue: 0,0:03:36.28,0:03:38.45,Default,,0,0,0,,Сырттан емес➡
Dialogue: 0,0:03:38.45,0:03:41.45,Default,,0,0,0,,Оны сыртқа шығармауға тырысатын сияқты.
Dialogue: 0,0:03:41.45,0:03:43.45,Default,,0,0,0,,Белл-сама да, Микото-сама да➡
Dialogue: 0,0:03:43.45,0:03:46.62,Default,,0,0,0,,Әрине, мен де Харухиме-саманың қашып кетуіне жол бермеймін.
Dialogue: 0,0:03:46.62,0:03:52.46,Default,,0,0,0,,Уау! ! Белл-кунның пәктігіне қауіп төніп тұр! !
Dialogue: 0,0:03:52.46,0:03:55.80,Default,,0,0,0,,Кішкентай жаңа ойыншыны әлі таппадың ба? ?
Dialogue: 0,0:03:55.80,0:03:58.47,Default,,0,0,0,,Сіз не туралы айтып отырсыз? (айқай)
Dialogue: 0,0:03:58.47,0:04:01.94,Default,,0,0,0,,Бастапқыда бұл сіздің Иштар-самаға қарсы шыққаныңыз үшін болса керек.
Dialogue: 0,0:04:01.94,0:04:03.94,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:04:03.94,0:04:06.61,Default,,0,0,0,,Әлгі ұсқынсыз жігіт оның қашып кетуіне мүмкіндік беруі керек➡
Dialogue: 0,0:04:06.61,0:04:09.44,Default,,0,0,0,,Бұлай әуре болмау керек еді!
Dialogue: 0,0:04:09.44,0:04:12.45,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:04:12.45,0:04:15.48,Default,,0,0,0,,Кішкентай жаңа ойыншыны Иштар ханымға ұсыну➡
Dialogue: 0,0:04:15.48,0:04:18.65,Default,,0,0,0,,Бүгінгі түнгі рәсімнен кейін де әлі кеш емес.
Dialogue: 0,0:04:18.65,0:04:21.49,Default,,0,0,0,,Олармен ештеңе істей алмайсыз.
Dialogue: 0,0:04:21.49,0:04:23.96,Default,,0,0,0,,Тым болмаса қашып кетсін.
Dialogue: 0,0:04:28.16,0:04:30.83,Default,,0,0,0,,(Жезөкшелердің дауысы)
Dialogue: 0,0:04:30.83,0:04:33.10,Default,,0,0,0,,Дауыс алыстап кетті.
Dialogue: 0,0:04:37.41,0:04:39.41,Default,,0,0,0,,Мен аймақты барлаймын.
Dialogue: 0,0:04:43.75,0:04:47.58,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:47.58,0:04:49.58,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:04:49.58,0:04:51.75,Default,,0,0,0,,((Мен жезөкшемін.
Dialogue: 0,0:04:51.75,0:04:56.42,Default,,0,0,0,,Батыр үшін жезөкше жойылу символы))
Dialogue: 0,0:04:56.42,0:04:58.43,Default,,0,0,0,,Аа...
Dialogue: 0,0:04:58.43,0:05:01.43,Default,,0,0,0,,Арх!
Dialogue: 0,0:05:01.43,0:05:05.27,Default,,0,0,0,,Жоқ... олай емес!
Dialogue: 0,0:05:05.27,0:05:11.27,Default,,0,0,0,,Жоқ! Міне, біз қайран қалдыратын кейіпкер...
Dialogue: 0,0:05:11.27,0:05:15.61,Default,,0,0,0,,Мен болғым келетін батыр!
Dialogue: 0,0:05:15.61,0:05:17.61,Default,,0,0,0,,Ха... Ха!
Dialogue: 0,0:05:23.62,0:05:26.96,Default,,0,0,0,,Лорд Белл, қуғыншылардың саны айтарлықтай азайды.
Dialogue: 0,0:05:26.96,0:05:29.96,Default,,0,0,0,,Егер сіз артқа шегінетін болсаңыз, қазір уақыт.
Dialogue: 0,0:05:29.96,0:05:33.09,Default,,0,0,0,,Микото-сан, кешіріңіз.
Dialogue: 0,0:05:33.09,0:05:36.10,Default,,0,0,0,,Мен ол адамға көмектесемін.
Dialogue: 0,0:05:36.10,0:05:39.60,Default,,0,0,0,,Ха! ? Бірақ егер солай жасасаңыз ➡
Dialogue: 0,0:05:39.60,0:05:42.27,Default,,0,0,0,,Иштар Фамилия өздерін кешірмейді.
Dialogue: 0,0:05:42.27,0:05:45.94,Default,,0,0,0,,Мен не істеуім керек...? Мен түсінбедім.
Dialogue: 0,0:05:45.94,0:05:51.11,Default,,0,0,0,,Бірақ Құдай, Уэлф және Лили түсінетініне сенімдімін.
Dialogue: 0,0:05:51.11,0:05:55.78,Default,,0,0,0,,Харухимені алып, бірге қашып кетіңіз➡
Dialogue: 0,0:05:55.78,0:05:59.75,Default,,0,0,0,,Күшті болып, бір күні осы қалаға оралайық!
Dialogue: 0,0:06:02.46,0:06:04.43,Default,,0,0,0,,Лорд Белл….
Dialogue: 0,0:06:06.96,0:06:10.47,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:06:10.47,0:06:15.30,Default,,0,0,0,,Мен сізбен бір отбасында болғаныма өте қуаныштымын.
Dialogue: 0,0:06:15.30,0:06:18.97,Default,,0,0,0,,Гестия мен басқалармен бірге ұрысайық!
Dialogue: 0,0:06:18.97,0:06:21.94,Default,,0,0,0,,Иә. Иә.
Dialogue: 0,0:06:28.62,0:06:30.62,Default,,0,0,0,,《Ол кісіге айтайық.
Dialogue: 0,0:06:30.62,0:06:35.52,Default,,0,0,0,,Біз тамсанған нағыз батыр! 》
Dialogue: 0,0:06:38.39,0:06:40.40,Default,,0,0,0,,Айша~.
Dialogue: 0,0:06:40.40,0:06:42.73,Default,,0,0,0,,Мен Кішкентай Рукиді таба алмаймын.
Dialogue: 0,0:06:42.73,0:06:45.73,Default,,0,0,0,,Менің ойымша, ол қашып кетті.
Dialogue: 0,0:06:45.73,0:06:50.07,Default,,0,0,0,,Жоқ, мен келемін. О?
Dialogue: 0,0:06:50.07,0:06:56.28,Default,,0,0,0,,Еркектікке ұқсамаса да, шытырман оқиғалы жан.
Dialogue: 0,0:06:58.25,0:07:03.59,Default,,0,0,0,,Харухиме-дономен байланысқаннан кейін сіз осы сигналдық оқты іске қосасыз.
Dialogue: 0,0:07:03.59,0:07:06.59,Default,,0,0,0,,Жасыл түс сәтті құтқаруды білдіреді. Қызыл – ➡
Dialogue: 0,0:07:06.59,0:07:09.42,Default,,0,0,0,,Сәтсіздік. Егер қызыл болса.
Dialogue: 0,0:07:09.42,0:07:12.59,Default,,0,0,0,,Біреуі ырым болатын жерді іздеп жүр➡
Dialogue: 0,0:07:12.59,0:07:14.60,Default,,0,0,0,,Сесшосекиді жойыңыз!
Dialogue: 0,0:07:16.60,0:07:20.77,Default,,0,0,0,,Егер бұл Харухиме-санның тағдырын сәл де болса өзгертсе.
Dialogue: 0,0:07:20.77,0:07:23.94,Default,,0,0,0,,Лорд Белл.
Dialogue: 0,0:07:23.94,0:07:27.11,Default,,0,0,0,,Сәттілік.
Dialogue: 0,0:07:27.11,0:07:31.81,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:07:38.25,0:07:40.26,Default,,0,0,0,,《Көңілсіз болған дұрыс.
Dialogue: 0,0:07:40.26,0:07:43.09,Default,,0,0,0,,Батпаққа батып кетуге болмайды.
Dialogue: 0,0:07:43.09,0:07:45.59,Default,,0,0,0,,Бұл жақсы》
Dialogue: 0,0:07:45.59,0:07:50.10,Default,,0,0,0,,Болайық! Сол адамның батыры бол!
Dialogue: 0,0:07:50.10,0:07:53.60,Default,,0,0,0,,Ууууууу! !
Dialogue: 0,0:07:53.60,0:07:57.27,Default,,0,0,0,,Қайта... Кішкентай жаңа ойыншы! ? Ол майданнан келді!
Dialogue: 0,0:07:57.27,0:08:00.94,Default,,0,0,0,,Отты болт! ! (айқай)
Dialogue: 0,0:08:05.28,0:08:07.62,Default,,0,0,0,,Ууууууу! Шу, бұл шабуыл!
Dialogue: 0,0:08:07.62,0:08:10.29,Default,,0,0,0,,Кішкентай жаңа ойыншы келді! Апыр-ай!
Dialogue: 0,0:08:14.29,0:08:18.59,Default,,0,0,0,,《Тоқтама, жүгір! Тартыңыз! 》
Dialogue: 0,0:08:18.59,0:08:21.10,Default,,0,0,0,,Ах! (жарылыс дыбысы)
Dialogue: 0,0:08:21.10,0:08:23.60,Default,,0,0,0,,Жау шабуылы! Үйге қайт!
Dialogue: 0,0:08:23.60,0:08:26.10,Default,,0,0,0,,Сәлем! Бірдеңе болған сияқты ма?
Dialogue: 0,0:08:26.10,0:08:28.77,Default,,0,0,0,,Бұл жерде қалуға болады ма?
Dialogue: 0,0:08:28.77,0:08:32.87,Default,,0,0,0,,Мен күшейтуге баруым керек және біраз несие алуым керек. Уф, бұл шулы!
Dialogue: 0,0:08:32.87,0:08:35.38,Default,,0,0,0,,Бізге бұл жерді қорғау керек!
Dialogue: 0,0:08:35.38,0:08:37.55,Default,,0,0,0,,Жолдан шығыңыз. Апыр-ай!
Dialogue: 0,0:08:37.55,0:08:40.58,Default,,0,0,0,,Ах! Әй, жігіттер!
Dialogue: 0,0:08:40.58,0:08:43.75,Default,,0,0,0,,Хахахаха Міне кеттік!
Dialogue: 0,0:08:46.22,0:08:48.26,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:08:48.26,0:08:50.43,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:50.43,0:08:52.43,Default,,0,0,0,,Ха... Өрт болт!
Dialogue: 0,0:08:52.43,0:08:54.40,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:08:57.27,0:08:59.93,Default,,0,0,0,,Гррр... ха-ха.
Dialogue: 0,0:09:04.11,0:09:06.11,Default,,0,0,0,,Га.
Dialogue: 0,0:09:06.11,0:09:09.11,Default,,0,0,0,,《Уақыт сатып ал》
Dialogue: 0,0:09:09.11,0:09:12.58,Default,,0,0,0,,Асығыңыз! Жау шабуылы!
Dialogue: 0,0:09:12.58,0:09:15.25,Default,,0,0,0,,《Мен саған қарыздармын, Белл-доно》
Dialogue: 0,0:09:15.25,0:09:19.25,Default,,0,0,0,,Балалар сендер майданға аттаныңдар. Басқалар, сахна артында қорғанысыңызды күшейтіңіз!
Dialogue: 0,0:09:19.25,0:09:21.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:24.93,0:09:27.60,Default,,0,0,0,,Не?
Dialogue: 0,0:09:27.60,0:09:30.43,Default,,0,0,0,,Уф. Харухиме-доно қайда орналасқан?
Dialogue: 0,0:09:30.43,0:09:35.20,Default,,0,0,0,,Иә, солай айтуға болады!
Dialogue: 0,0:09:35.20,0:09:38.87,Default,,0,0,0,,Аспалы бақтың күту аймағында...
Dialogue: 0,0:09:38.87,0:09:40.88,Default,,0,0,0,,Ахх.
Dialogue: 0,0:09:43.38,0:09:46.71,Default,,0,0,0,,Аспалы бақтар….
Dialogue: 0,0:09:46.71,0:09:49.55,Default,,0,0,0,,Гехе Гехе Гехе Гехе Хэ.
Dialogue: 0,0:09:49.55,0:09:53.05,Default,,0,0,0,,Кішкентай Руки қайтып келді.
Dialogue: 0,0:09:53.05,0:09:56.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:56.72,0:09:59.73,Default,,0,0,0,,Самира, рәсімге дайындықты жалғастыр.
Dialogue: 0,0:09:59.73,0:10:05.07,Default,,0,0,0,,Айша мен Атай екеуіңе Кішкентай Рукимен сөйлесуге рұқсат етемін.
Dialogue: 0,0:10:05.07,0:10:08.57,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:10:08.57,0:10:11.24,Default,,0,0,0,,Уақыты келгенде, балалар➡
Dialogue: 0,0:10:11.24,0:10:13.24,Default,,0,0,0,,Оны аспалы баққа апарыңыз!
Dialogue: 0,0:10:13.24,0:10:15.44,Default,,0,0,0,,Ха! Хехе.
Dialogue: 0,0:10:24.75,0:10:26.75,Default,,0,0,0,,Маған қашуға рұқсат етіңіз! Күте тұрыңыз!
Dialogue: 0,0:10:26.75,0:10:28.92,Default,,0,0,0,,《Ол мені әлі де тартады》
Dialogue: 0,0:10:28.92,0:10:30.93,Default,,0,0,0,,Қайшымен шабуыл!
Dialogue: 0,0:10:34.26,0:10:37.10,Default,,0,0,0,,Арх! Алу, алу, алу.
Dialogue: 0,0:10:37.10,0:10:42.10,Default,,0,0,0,,Уау! Атайды сағынып қайттың ба?
Dialogue: 0,0:10:42.10,0:10:46.44,Default,,0,0,0,,Сізге әсер еткен жоқсыз ба! Уф! ?
Dialogue: 0,0:10:46.44,0:10:49.24,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:10:51.45,0:10:54.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:54.78,0:10:56.95,Default,,0,0,0,,Өрт болт! !
Dialogue: 0,0:10:56.95,0:10:59.12,Default,,0,0,0,,Сәлем! Жақсы! ?
Dialogue: 0,0:10:59.12,0:11:02.79,Default,,0,0,0,,Бұл кішкене сиқыр.
Dialogue: 0,0:11:02.79,0:11:04.79,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:07.96,0:11:09.96,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:12.63,0:11:15.30,Default,,0,0,0,,Жарайсың, сен.
Dialogue: 0,0:11:15.30,0:11:17.51,Default,,0,0,0,,Бірақ бәрі осы.
Dialogue: 0,0:11:20.31,0:11:24.65,Default,,0,0,0,,Гегей бұл жолы қашып кетпеймін.
Dialogue: 0,0:11:24.65,0:11:30.32,Default,,0,0,0,,Қарғыс атқыр... Ал, ал, ал, ал.
Dialogue: 0,0:11:30.32,0:11:32.52,Default,,0,0,0,,Түсіңдер, балалар.
Dialogue: 0,0:11:36.93,0:11:40.26,Default,,0,0,0,,Ха... Мырза Иштар!
Dialogue: 0,0:11:40.26,0:11:43.93,Default,,0,0,0,,Не айтып тұрсың! Бұл енді жақсы жер болады!
Dialogue: 0,0:11:43.93,0:11:47.44,Default,,0,0,0,,Сіз естіген жоқсыз ба? Фрин.
Dialogue: 0,0:11:47.44,0:11:50.61,Default,,0,0,0,,Түс, - дедім.
Dialogue: 0,0:11:50.61,0:11:53.27,Default,,0,0,0,,Барлығыңыз, Сесшосеки рәсіміне барыңыз.
Dialogue: 0,0:11:53.27,0:11:56.95,Default,,0,0,0,,Осы жолы сәтті орындаңыз. Сәтсіздікке жол берілмейді.
Dialogue: 0,0:11:56.95,0:11:59.45,Default,,0,0,0,,Кутчит!
Dialogue: 0,0:12:01.95,0:12:05.99,Default,,0,0,0,,Қош келдіңіз, Хестияның Кензокуы.
Dialogue: 0,0:12:05.99,0:12:09.16,Default,,0,0,0,,Мұнда өкініш білдірген әйел болды ма?
Dialogue: 0,0:12:09.16,0:12:11.83,Default,,0,0,0,,А... уф.
Dialogue: 0,0:12:11.83,0:12:15.66,Default,,0,0,0,,Уфуфу Сіз өте әдемі көрінесіз, солай емес пе?
Dialogue: 0,0:12:15.66,0:12:21.00,Default,,0,0,0,,Оны ұнатпайтын әйелге тапсырма. Дегенмен, бұл мен таңдаған нәрсе болуы мүмкін.
Dialogue: 0,0:12:21.00,0:12:24.51,Default,,0,0,0,,Маған хабарлаңыз. Неге➡
Dialogue: 0,0:12:24.51,0:12:28.18,Default,,0,0,0,,Харухимені құрбандыққа шалу керек пе?
Dialogue: 0,0:12:28.18,0:12:30.48,Default,,0,0,0,,Сендер тым талапшылсыңдар — менің кимоном мүлдем кір емес.
Dialogue: 0,0:12:30.48,0:12:35.25,Default,,0,0,0,,Сіз менің алдымда басқа әйелдер туралы айта аласыз ба?
Dialogue: 0,0:12:35.25,0:12:37.25,Default,,0,0,0,,Жауап беріңізші! !
Dialogue: 0,0:12:37.25,0:12:40.26,Default,,0,0,0,,(Сота) Жарайды. (Есіктің ашылып, жабылуының дыбысы)
Dialogue: 0,0:12:40.26,0:12:44.09,Default,,0,0,0,,Себебі оның сонша күші бар.
Dialogue: 0,0:12:44.09,0:12:47.10,Default,,0,0,0,,Ха! деңгейін көтеру.
Dialogue: 0,0:12:47.10,0:12:49.76,Default,,0,0,0,,Иә. Сол сиқырмен➡
Dialogue: 0,0:12:49.76,0:12:53.10,Default,,0,0,0,,Отбасының барлық мүшелері ➡ жоғарыласа
Dialogue: 0,0:12:53.10,0:12:56.10,Default,,0,0,0,,Сіз Freya Familia-ны жеңе аласыз!
Dialogue: 0,0:12:56.10,0:13:00.44,Default,,0,0,0,,Мен ол әйелді мұнарадан түсіре аламын.
Dialogue: 0,0:13:00.44,0:13:03.11,Default,,0,0,0,,Жоқ! ? Фрейя ханым?
Dialogue: 0,0:13:03.11,0:13:05.78,Default,,0,0,0,,Маған оның барлығы ұнамайды.
Dialogue: 0,0:13:05.78,0:13:12.12,Default,,0,0,0,,Менің орныма еркектер сол әйелді ең сұлу деп мақтайды.
Dialogue: 0,0:13:12.12,0:13:15.46,Default,,0,0,0,,Менің сұлулығымнан анау шошқаның ұрғашысы ше? ?
Dialogue: 0,0:13:15.46,0:13:19.46,Default,,0,0,0,,Ерлердің көздері түйнекті ме? Қарғыс атсын, жігіттер!
Dialogue: 0,0:13:19.46,0:13:23.97,Default,,0,0,0,,Сол үшін Харухимені жезөкше қылдың ба?
Dialogue: 0,0:13:23.97,0:13:26.47,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:13:26.47,0:13:28.80,Default,,0,0,0,,Жезөкшелерден неге аулақ жүрсің?
Dialogue: 0,0:13:28.80,0:13:34.08,Default,,0,0,0,,Денемізді қабаттап, ләззатқа берілу қасиетті әрекет.
Dialogue: 0,0:13:34.08,0:13:40.08,Default,,0,0,0,,Ерлердің хайуандық қасиетін басып, әйелдер дүниедегі бейбітшіліктің тірегіне айналады.
Dialogue: 0,0:13:40.08,0:13:45.29,Default,,0,0,0,,Осы төменгі әлемде еркек пен әйелдің қиылысуы кезінде жаңа өмір туады➡
Dialogue: 0,0:13:45.29,0:13:47.79,Default,,0,0,0,,Молшылыққа жетелейді.
Dialogue: 0,0:13:47.79,0:13:51.13,Default,,0,0,0,,Көп еркекпен араласу арам емес.
Dialogue: 0,0:13:51.13,0:13:55.46,Default,,0,0,0,,Сонда да Харухиме қиналып жатыр!
Dialogue: 0,0:13:55.46,0:13:59.97,Default,,0,0,0,,А, жеткілікті. Мен Ханамен таласпаймын.
Dialogue: 0,0:13:59.97,0:14:01.97,Default,,0,0,0,,Ах! Гах.
Dialogue: 0,0:14:01.97,0:14:03.97,Default,,0,0,0,,Таммуз - 4-деңгей.
Dialogue: 0,0:14:03.97,0:14:06.81,Default,,0,0,0,,Сенің жұқа қолдарың оны сілкіп тастай алмайды.
Dialogue: 0,0:14:06.81,0:14:08.98,Default,,0,0,0,,Куку куку….
Dialogue: 0,0:14:11.15,0:14:14.65,Default,,0,0,0,,Иә! иә! ?
Dialogue: 0,0:14:14.65,0:14:16.65,Default,,0,0,0,,аңқау бейбақ.
Dialogue: 0,0:14:16.65,0:14:18.99,Default,,0,0,0,,Гестия нені үйретті...?
Dialogue: 0,0:14:18.99,0:14:22.16,Default,,0,0,0,,А, ол пәк құдай ма?
Dialogue: 0,0:14:22.16,0:14:24.99,Default,,0,0,0,,Гах... сен неге киім киіп жүрсің? ?
Dialogue: 0,0:14:24.99,0:14:29.33,Default,,0,0,0,,Арх! Сүйегім ерігенше➡
Dialogue: 0,0:14:29.33,0:14:31.50,Default,,0,0,0,,Мен сені сүйсіндіремін.
Dialogue: 0,0:14:38.41,0:14:41.24,Default,,0,0,0,,Құрметті Фрейя.
Dialogue: 0,0:14:41.24,0:14:44.25,Default,,0,0,0,,Аллен және басқалардың баяндамасы.
Dialogue: 0,0:14:44.25,0:14:47.45,Default,,0,0,0,,Дайын бол. Мен де сонда боламын.
Dialogue: 0,0:14:56.42,0:14:58.43,Default,,0,0,0,,Гах. Эй, көзіңді ашпайсың ба!
Dialogue: 0,0:14:58.43,0:15:01.93,Default,,0,0,0,,Хмм, мүмкін емес! Өтінемін тез киініп ал!
Dialogue: 0,0:15:01.93,0:15:03.93,Default,,0,0,0,,Мына жігіт не болып жатыр?
Dialogue: 0,0:15:03.93,0:15:06.53,Default,,0,0,0,,Бұл мені баяғыда қызықтыруы керек еді.
Dialogue: 0,0:15:08.60,0:15:11.11,Default,,0,0,0,,Артыңызды бұрыңыз! Ха!
Dialogue: 0,0:15:17.11,0:15:19.45,Default,,0,0,0,,Ха, міне осы!
Dialogue: 0,0:15:19.45,0:15:23.45,Default,,0,0,0,,Reales Frese! Менің сүйікті кристалым! ?
Dialogue: 0,0:15:23.45,0:15:26.79,Default,,0,0,0,,Құдайдың «сүйкімділігі» бұл жігітке әсер етпейді! ?
Dialogue: 0,0:15:26.79,0:15:29.12,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:15:29.12,0:15:31.29,Default,,0,0,0,,Сен ақымақсың ба? !
Dialogue: 0,0:15:31.29,0:15:34.90,Default,,0,0,0,,Кешіріңіз! Өтінемін, мені кешірші!
Dialogue: 0,0:15:34.90,0:15:37.50,Default,,0,0,0,,Chase! Маған қашып кетуіме жол берме! Иә!
Dialogue: 0,0:15:40.23,0:15:42.74,Default,,0,0,0,,Мұны мүк сияқты жасаңыз!
Dialogue: 0,0:15:57.95,0:16:00.25,Default,,0,0,0,,Ах! ? (айқай)
Dialogue: 0,0:16:00.25,0:16:02.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:04.43,0:16:06.93,Default,,0,0,0,,Құрметті Микото.
Dialogue: 0,0:16:06.93,0:16:09.60,Default,,0,0,0,,Бұл жерден қашайық, Харухиме-доно.
Dialogue: 0,0:16:09.60,0:16:12.10,Default,,0,0,0,,Неге келдің?
Dialogue: 0,0:16:12.10,0:16:17.10,Default,,0,0,0,,Маған көмектессең, Иштар Фамилиясын жауға айналдырасың.
Dialogue: 0,0:16:17.10,0:16:21.28,Default,,0,0,0,,Сонда да Белл-доно сізге көмектесетінін айтты!
Dialogue: 0,0:16:21.28,0:16:24.78,Default,,0,0,0,,Лорд Кранель... мейірімді.
Dialogue: 0,0:16:24.78,0:16:29.12,Default,,0,0,0,,Жоқ! Ол кісі тек аяп, кінәлап ұрысып жатқан жоқ!
Dialogue: 0,0:16:29.12,0:16:31.29,Default,,0,0,0,,Құрметті Микото...
Dialogue: 0,0:16:31.29,0:16:34.72,Default,,0,0,0,,Өтінемін... жеткілікті.
Dialogue: 0,0:16:34.72,0:16:37.06,Default,,0,0,0,,Мен қазір жақсымын.
Dialogue: 0,0:16:37.06,0:16:39.56,Default,,0,0,0,,Неге! ? Неге бас тартасың!
Dialogue: 0,0:16:39.56,0:16:43.73,Default,,0,0,0,,Егер Харухиме-доно қаласа, Белл-доно сені ешқашан тастамайды! !
Dialogue: 0,0:16:43.73,0:16:45.73,Default,,0,0,0,,Ол ондай жігіт емес!
Dialogue: 0,0:16:45.73,0:16:47.74,Default,,0,0,0,,Микото-чан түсінбейді!
Dialogue: 0,0:16:47.74,0:16:50.57,Default,,0,0,0,,Га. Мен жезөкшемін.
Dialogue: 0,0:16:50.57,0:16:54.08,Default,,0,0,0,,Денеңізді тіпті ұнатпайтын адамға беріп, сол үшін ақша алу➡
Dialogue: 0,0:16:54.08,0:16:56.91,Default,,0,0,0,,Микото-чан өзін осылай кешіре ала ма?
Dialogue: 0,0:16:56.91,0:16:59.41,Default,,0,0,0,,Сол қыздан маған көмектесуін сұрауым керек пе?
Dialogue: 0,0:16:59.41,0:17:03.42,Default,,0,0,0,,Мені осындай лас денеңмен жаныңда қалдыруды сұрауым керек пе?
Dialogue: 0,0:17:03.42,0:17:06.09,Default,,0,0,0,,Балаға қауіп төнетінін білдіңіз бе?
Dialogue: 0,0:17:06.09,0:17:09.26,Default,,0,0,0,,Менің қолымнан келмейді! Менің қолымнан келмейді!
Dialogue: 0,0:17:09.26,0:17:12.43,Default,,0,0,0,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:17:12.43,0:17:14.43,Default,,0,0,0,,Мен егеуқұйрықты көрдім!
Dialogue: 0,0:17:16.43,0:17:18.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:18.43,0:17:21.27,Default,,0,0,0,,Микото-чан!
Dialogue: 0,0:17:21.27,0:17:25.11,Default,,0,0,0,,Ача~ Мен оның қашып кетуіне рұқсат бердім. Өкінішті!
Dialogue: 0,0:17:25.11,0:17:27.44,Default,,0,0,0,,(Оқ сигналының дыбысы)
Dialogue: 0,0:17:27.44,0:17:31.28,Default,,0,0,0,,Сәтсіздік! ? Микото-сан...
Dialogue: 0,0:17:31.28,0:17:33.41,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:17:33.41,0:17:35.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:39.09,0:17:41.46,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:17:51.93,0:17:54.00,Default,,0,0,0,,Гехе Гехе Гехе.
Dialogue: 0,0:17:57.10,0:18:00.98,Default,,0,0,0,,Енді салтты бастайық. Сесшосеки.
Dialogue: 0,0:18:21.46,0:18:25.43,Default,,0,0,0,,Бұл ұзақ болды. Қазір Фрея Фамилиямен.
Dialogue: 0,0:18:35.58,0:18:40.75,Default,,0,0,0,,(Ұрыс дыбысы)
Dialogue: 0,0:18:40.75,0:18:42.75,Default,,0,0,0,,Харухиме-доно! !
Dialogue: 0,0:18:42.75,0:18:45.59,Default,,0,0,0,,Хахаха! Жалғыз келдің бе?
Dialogue: 0,0:18:45.59,0:18:49.26,Default,,0,0,0,,Қуан, Харухиме, сенің батырың келді.
Dialogue: 0,0:18:49.26,0:18:52.76,Default,,0,0,0,,Неге... Қайтып келші, Микото-сама!
Dialogue: 0,0:18:52.76,0:18:55.26,Default,,0,0,0,,Қанша рет бас тартса да, қайтпаймын!
Dialogue: 0,0:18:55.26,0:18:58.57,Default,,0,0,0,,Мен... саған көмектесемін!
Dialogue: 0,0:18:58.57,0:19:01.10,Default,,0,0,0,,Сіз өте кереметсіз!
Dialogue: 0,0:19:01.10,0:19:04.44,Default,,0,0,0,,Сәлем! Иә!
Dialogue: 0,0:19:04.44,0:19:06.44,Default,,0,0,0,,Сәлем, Фрин.
Dialogue: 0,0:19:06.44,0:19:09.78,Default,,0,0,0,,Мына жігіт, маған рұқсат етіңіз. иә?
Dialogue: 0,0:19:09.78,0:19:13.78,Default,,0,0,0,,Рәсімге тым көп дайындалу және аздық ету. Жақсы емес пе?
Dialogue: 0,0:19:13.78,0:19:16.45,Default,,0,0,0,,Гехехехе қалағаныңды істе.
Dialogue: 0,0:19:16.45,0:19:20.96,Default,,0,0,0,,Міне осылай. Бәрімізді жеңсең➡
Dialogue: 0,0:19:20.96,0:19:24.96,Default,,0,0,0,,Мүмкін Иштар-сама тілегімді орындайтын шығар.
Dialogue: 0,0:19:24.96,0:19:29.43,Default,,0,0,0,,Жүр, жүр! Жақсы! Жаса, Самира!
Dialogue: 0,0:19:29.43,0:19:31.77,Default,,0,0,0,,Тоқта, күт, Самира-сан!
Dialogue: 0,0:19:31.77,0:19:33.87,Default,,0,0,0,,Адам маңызды емес!
Dialogue: 0,0:19:33.87,0:19:36.04,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:19:36.04,0:19:38.24,Default,,0,0,0,,Иә! Арх!
Dialogue: 0,0:19:43.54,0:19:45.55,Default,,0,0,0,,Ораора, міне осы! ?
Dialogue: 0,0:19:45.55,0:19:49.05,Default,,0,0,0,,《Күшті! Бұл 3 деңгейлі қуат》
Dialogue: 0,0:19:49.05,0:19:51.05,Default,,0,0,0,,Ха...
Dialogue: 0,0:19:56.22,0:19:58.89,Default,,0,0,0,,А? Қоян қашып кетті ме?
Dialogue: 0,0:19:58.89,0:20:01.90,Default,,0,0,0,,Не істеп жатырсың, Иштар?
Dialogue: 0,0:20:01.90,0:20:05.90,Default,,0,0,0,,Сәлем! Сіз бір жерден қарап отырсыз ба, кішкентай жаңағы?
Dialogue: 0,0:20:05.90,0:20:12.07,Default,,0,0,0,,Тез шықпасаң, асыл достарың жойылады!
Dialogue: 0,0:20:12.07,0:20:14.41,Default,,0,0,0,,Әлі жоқ! Ах!
Dialogue: 0,0:20:14.41,0:20:17.91,Default,,0,0,0,,Лорд Белл... әлі жоқ! !
Dialogue: 0,0:20:17.91,0:20:20.58,Default,,0,0,0,,Иә? Сонымен, сіз не істемексіз?
Dialogue: 0,0:20:20.58,0:20:22.58,Default,,0,0,0,,Бізде уақыт жоқ.
Dialogue: 0,0:20:30.93,0:20:33.43,Default,,0,0,0,,Ха! ? ((Такемиказучи: Тыңда, Микото.
Dialogue: 0,0:20:33.43,0:20:37.26,Default,,0,0,0,,Ниндзялар лас. Бұл сіздің мінезіңізге сәйкес келмейді.
Dialogue: 0,0:20:37.26,0:20:40.10,Default,,0,0,0,,Бірақ ниндзялар адал.
Dialogue: 0,0:20:40.10,0:20:42.77,Default,,0,0,0,,Егер маңызды адам болса➡
Dialogue: 0,0:20:42.77,0:20:48.61,Default,,0,0,0,,Сіз байсалды және мейірімдісіз, сондықтан сіз басқалардан жақсы шиноби бола алатыныңызға сенімдімін))
Dialogue: 0,0:20:48.61,0:20:52.28,Default,,0,0,0,,Қарсыласыңыздың болжауынан... асып кету.
Dialogue: 0,0:20:52.28,0:20:54.78,Default,,0,0,0,,Аяқтаймыз... Ах! ?
Dialogue: 0,0:20:54.78,0:20:57.79,Default,,0,0,0,,Іліп алсаң да, ақылды.
Dialogue: 0,0:20:57.79,0:20:59.79,Default,,0,0,0,,Ей, мұнда сиқыр бар ма?
Dialogue: 0,0:20:59.79,0:21:02.29,Default,,0,0,0,,Уақыт жоқ деп жатырсың!
Dialogue: 0,0:21:02.29,0:21:06.13,Default,,0,0,0,,Ха, кез келген нәрсе...
Dialogue: 0,0:21:06.13,0:21:08.63,Default,,0,0,0,,Жарып өту... Ga!
Dialogue: 0,0:21:08.63,0:21:10.97,Default,,0,0,0,,Мен бұл сиқырды соғыс ойынында көрдім. Құдайым-ай!
Dialogue: 0,0:21:10.97,0:21:13.63,Default,,0,0,0,,Бұл тым көп уақытты алады!
Dialogue: 0,0:21:13.63,0:21:17.81,Default,,0,0,0,,Көңіліңіз түсесіз, беріліңіз! Маған жол көрсетіңіз...
Dialogue: 0,0:21:17.81,0:21:20.47,Default,,0,0,0,,Сіз не істеп жатырсыз...?
Dialogue: 0,0:21:20.47,0:21:22.98,Default,,0,0,0,,Мына кішкентай денеде...
Dialogue: 0,0:21:22.98,0:21:25.98,Default,,0,0,0,,Амал жоқ... тоқтат! Kizentaru Сіздің….
Dialogue: 0,0:21:25.98,0:21:28.65,Default,,0,0,0,,Шинрёку!
Dialogue: 0,0:21:28.65,0:21:31.82,Default,,0,0,0,,《Қарсыластың күткенінен асып кету. Ниндзяның құпиясы➡
Dialogue: 0,0:21:31.82,0:21:33.79,Default,,0,0,0,,Ең нашар тосын шабуыл! 》
Dialogue: 0,0:21:33.79,0:21:37.12,Default,,0,0,0,,Ой, балалар, мына жігітті алып кетіңдер!
Dialogue: 0,0:21:37.12,0:21:40.96,Default,,0,0,0,,Сақтау! ! Тазартатын жарық! !
Dialogue: 0,0:21:40.96,0:21:42.93,Default,,0,0,0,,Ха!?
Dialogue: 0,0:21:45.30,0:21:48.30,Default,,0,0,0,,Жоқ! Сиқырлы қуат жарылысы! ?
Dialogue: 0,0:21:48.30,0:21:50.27,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:21:53.97,0:21:55.98,Default,,0,0,0,,Микото-чан!
Dialogue: 0,0:21:55.98,0:21:57.98,Default,,0,0,0,,《Қоңырау шалу….
Dialogue: 0,0:21:57.98,0:22:00.82,Default,,0,0,0,,Өтінемін➡
Dialogue: 0,0:22:00.82,0:22:03.98,Default,,0,0,0,,Харухиме-доно…》
Dialogue: 0,0:22:03.98,0:22:06.65,Default,,0,0,0,,О, Белл-доно! !
Dialogue: 0,0:22:06.65,0:22:10.12,Default,,0,0,0,,Ааааааа! !
Dialogue: 0,0:22:10.12,0:22:13.33,Default,,0,0,0,,Шале! Харухиме жасаңыз!
Dialogue: 0,0:22:13.33,0:22:15.33,Default,,0,0,0,,Харухиме-сан! !
Dialogue: 0,0:22:15.33,0:22:17.33,Default,,0,0,0,,Ахх!
Dialogue: 0,0:22:17.33,0:22:19.83,Default,,0,0,0,,(Тодорокидің анасы) Бірақ сен әлі де батыр болғың келеді ғой, иә?
Dialogue: 0,0:22:19.83,0:22:22.00,Default,,0,0,0,,Ааааааааааааа! !
Dialogue: 0,0:22:29.18,0:22:31.55,Default,,0,0,0,,Аа... Ха!
Dialogue: 0,0:22:33.05,0:22:38.05,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
