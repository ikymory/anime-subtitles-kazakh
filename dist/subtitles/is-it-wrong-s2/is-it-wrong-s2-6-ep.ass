Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:43.57,0:00:45.91,Default,,0,0,0,,Келіңдер, балалар➡
Dialogue: 0,0:00:45.91,0:00:49.08,Default,,0,0,0,,Түн келді.
Dialogue: 0,0:00:49.08,0:00:51.25,Default,,0,0,0,,Клиенттерді алыңыз!
Dialogue: 0,0:00:51.25,0:00:53.42,Default,,0,0,0,,Ерлердің көңілін көтеріңіз!
Dialogue: 0,0:00:53.42,0:00:55.92,Default,,0,0,0,,Қалауларыңызбен бөлісіңіз!
Dialogue: 0,0:00:55.92,0:00:57.92,Default,,0,0,0,,Бүгін түнде тағы➡
Dialogue: 0,0:00:57.92,0:01:00.62,Default,,0,0,0,,Махаббатты қалағанша жалма!
Dialogue: 0,0:02:46.23,0:02:50.07,Default,,0,0,0,,Кио Мен бүгін ерте үзіліс жасаймын!
Dialogue: 0,0:02:50.07,0:02:52.77,Default,,0,0,0,,Иә! Қайырлы түн.
Dialogue: 0,0:03:05.28,0:03:07.28,Default,,0,0,0,,Жарайды, мен саған еремін.
Dialogue: 0,0:03:07.28,0:03:09.45,Default,,0,0,0,,Артыңнан ергеніме біраз болды!
Dialogue: 0,0:03:09.45,0:03:12.95,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:03:12.95,0:03:15.12,Default,,0,0,0,,Соңғы кездері біртүрлі болып кетті➡
Dialogue: 0,0:03:15.12,0:03:17.13,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:03:17.13,0:03:20.13,Default,,0,0,0,,Басқалар сияқты оны түсіну оңай.
Dialogue: 0,0:03:20.13,0:03:22.13,Default,,0,0,0,,Ug….
Dialogue: 0,0:03:22.13,0:03:24.10,Default,,0,0,0,,Ах! Міне бітті!
Dialogue: 0,0:03:28.80,0:03:31.81,Default,,0,0,0,,Сіз Чигуса-самамен бірге болған шығарсыз...
Dialogue: 0,0:03:31.81,0:03:33.78,Default,,0,0,0,,Мен қайда бара жатырмын...
Dialogue: 0,0:03:36.08,0:03:38.55,Default,,0,0,0,,Мен оның осында екеніне сене алмадым!
Dialogue: 0,0:03:50.73,0:03:54.06,Default,,0,0,0,,Ал... Мүмкін осы жерде➡
Dialogue: 0,0:03:54.06,0:03:56.06,Default,,0,0,0,,Бұл…. аа….
Dialogue: 0,0:03:56.06,0:03:58.73,Default,,0,0,0,,Түнгі қала... Бұл ойын-сауық ауданы деп аталады.
Dialogue: 0,0:03:58.73,0:04:00.74,Default,,0,0,0,,Гүлп.
Dialogue: 0,0:04:00.74,0:04:03.41,Default,,0,0,0,,Түсіндім, бұл сіз іздеп жүрген нәрсе➡
Dialogue: 0,0:04:03.41,0:04:05.91,Default,,0,0,0,,Бізге ештеңе айта алмайтыныңызды түсінуге болады.
Dialogue: 0,0:04:05.91,0:04:07.91,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:04:07.91,0:04:11.25,Default,,0,0,0,,Бұл екеуіне өте алыс жер.
Dialogue: 0,0:04:11.25,0:04:13.58,Default,,0,0,0,,Бәрібір барайық. Мұнда адамдар көп болады.
Dialogue: 0,0:04:13.58,0:04:16.59,Default,,0,0,0,,Оны назардан тыс қалдырмаңыз. Иә!
Dialogue: 0,0:04:16.59,0:04:18.92,Default,,0,0,0,,Күрсін... Мынадай жер➡
Dialogue: 0,0:04:18.92,0:04:22.76,Default,,0,0,0,,Мен Белл-саманың бұл жерге аяқ басқанын қаламадым.
Dialogue: 0,0:04:22.76,0:04:25.46,Default,,0,0,0,,Жүр, аға, ойнайық?
Dialogue: 0,0:04:25.46,0:04:28.63,Default,,0,0,0,,Бірақ бәрібір бұрынғыдай.
Dialogue: 0,0:04:28.63,0:04:30.97,Default,,0,0,0,,Мұндағы көрікті жерлер мен иістер.
Dialogue: 0,0:04:30.97,0:04:33.14,Default,,0,0,0,,Сіз сонда болдыңыз ба?
Dialogue: 0,0:04:33.14,0:04:36.04,Default,,0,0,0,,Мені жаңа ғана бұрынғы әріптестерім әкелді.
Dialogue: 0,0:04:36.04,0:04:38.54,Default,,0,0,0,,Теріме сай келмей, бірден үйге қайттым.
Dialogue: 0,0:04:38.54,0:04:40.54,Default,,0,0,0,,Мынау аппақ шашы бар бала➡
Dialogue: 0,0:04:40.54,0:04:42.54,Default,,0,0,0,,Бүгінгі кеш ше? Уф! ?
Dialogue: 0,0:04:42.54,0:04:44.55,Default,,0,0,0,,Уақытында келдіңіз!
Dialogue: 0,0:04:44.55,0:04:47.75,Default,,0,0,0,,Бірақ олар қайда баруды жоспарлап отыр?
Dialogue: 0,0:04:50.05,0:04:53.22,Default,,0,0,0,,Жаман, кеттік! Ах!
Dialogue: 0,0:04:53.22,0:04:56.56,Default,,0,0,0,,Шыдамдылығыңыз үшін рахмет. Қазір қызмет көрсету уақыты!
Dialogue: 0,0:04:56.56,0:05:00.06,Default,,0,0,0,,О, күте тұрыңыз! (шулаған дауыстар)
Dialogue: 0,0:05:00.06,0:05:02.86,Default,,0,0,0,,Сәлем! Лилия!
Dialogue: 0,0:05:06.40,0:05:08.40,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:05:08.40,0:05:10.41,Default,,0,0,0,,Мені құтқарғаныңызға рахмет➡
Dialogue: 0,0:05:10.41,0:05:12.41,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:05:12.41,0:05:15.24,Default,,0,0,0,,Бірақ Лили мен басқалары неге мұнда?
Dialogue: 0,0:05:15.24,0:05:17.75,Default,,0,0,0,,Микото-сама және басқалары біртүрлі әрекет етті➡
Dialogue: 0,0:05:17.75,0:05:20.08,Default,,0,0,0,,Кешіріңіз, бірақ мен сіздің артыңыздан ердім.
Dialogue: 0,0:05:20.08,0:05:22.92,Default,,0,0,0,,Мен Ичирен Цукидің отбасы болдым.
Dialogue: 0,0:05:22.92,0:05:24.92,Default,,0,0,0,,Құпия сақтама.
Dialogue: 0,0:05:24.92,0:05:26.92,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:05:26.92,0:05:29.26,Default,,0,0,0,,Микотоны кінәламаңыз!
Dialogue: 0,0:05:29.26,0:05:31.26,Default,,0,0,0,,Себебі мен айтқан едім...
Dialogue: 0,0:05:31.26,0:05:34.23,Default,,0,0,0,,Түсіндіре аласыз ба?
Dialogue: 0,0:05:34.23,0:05:36.23,Default,,0,0,0,,Іс жүзінде➡
Dialogue: 0,0:05:36.23,0:05:38.23,Default,,0,0,0,,Біздің туған қаладан достар➡
Dialogue: 0,0:05:38.23,0:05:41.24,Default,,0,0,0,,Осы ойын-сауық ауданында жұмыс істейді деген қауесет бар➡
Dialogue: 0,0:05:41.24,0:05:43.24,Default,,0,0,0,,Мен мұны Чигуса-донодан естідім.
Dialogue: 0,0:05:43.24,0:05:45.24,Default,,0,0,0,,Жұмыс құралы ➡
Dialogue: 0,0:05:45.24,0:05:47.41,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:47.41,0:05:49.58,Default,,0,0,0,,Бала кезімізде бірге ойнадық➡
Dialogue: 0,0:05:49.58,0:05:51.75,Default,,0,0,0,,Ол қымбатты дос.
Dialogue: 0,0:05:51.75,0:05:53.75,Default,,0,0,0,,Бірақ бірнеше жыл бұрын➡
Dialogue: 0,0:05:53.75,0:05:55.92,Default,,0,0,0,,Оның қайда екені белгісіз...
Dialogue: 0,0:05:55.92,0:05:57.92,Default,,0,0,0,,Ол бізден бөлек➡
Dialogue: 0,0:05:57.92,0:06:00.26,Default,,0,0,0,,Асыл мәртебеге ие адам➡
Dialogue: 0,0:06:00.26,0:06:03.26,Default,,0,0,0,,Мен ойын-сауық ауданында жүргеніме сене алар емеспін...
Dialogue: 0,0:06:03.26,0:06:05.76,Default,,0,0,0,,Барлығымен кеңеспес бұрын➡
Dialogue: 0,0:06:05.76,0:06:09.26,Default,,0,0,0,,Мен өз көзіммен көру үшін осында келдім.
Dialogue: 0,0:06:09.26,0:06:11.93,Default,,0,0,0,,Асыл мәртебе... иә?
Dialogue: 0,0:06:11.93,0:06:13.90,Default,,0,0,0,,Мен жағдайды түсінемін.
Dialogue: 0,0:06:13.90,0:06:15.90,Default,,0,0,0,,Алайда абайсызда барсаңыз ➡
Dialogue: 0,0:06:15.90,0:06:18.91,Default,,0,0,0,,Мен бас тартуым керек пе? кешіріңіз….
Dialogue: 0,0:06:18.91,0:06:21.24,Default,,0,0,0,,Әйтеуір, осы жерден кетейік.
Dialogue: 0,0:06:21.24,0:06:24.08,Default,,0,0,0,,Сол адам туралы қосымша ақпарат жинаңыз...
Dialogue: 0,0:06:24.08,0:06:26.25,Default,,0,0,0,,Эй, Белл не болды?
Dialogue: 0,0:06:26.25,0:06:29.25,Default,,0,0,0,,Ах…. Белл-доно да келді ме?
Dialogue: 0,0:06:29.25,0:06:31.45,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:06:31.45,0:06:34.52,Default,,0,0,0,,(шулы дауыстар)
Dialogue: 0,0:06:34.52,0:06:39.19,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай! Уф!
Dialogue: 0,0:06:39.19,0:06:41.86,Default,,0,0,0,,Уау... уф.
Dialogue: 0,0:06:41.86,0:06:43.87,Default,,0,0,0,,Мен мүлдем бөлек қалдым...
Dialogue: 0,0:06:43.87,0:06:46.77,Default,,0,0,0,,Мен қайда баруым керек?
Dialogue: 0,0:06:56.38,0:06:58.38,Default,,0,0,0,,Хмм….
Dialogue: 0,0:07:07.72,0:07:09.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:17.57,0:07:20.74,Default,,0,0,0,,《Қоңырау: Түлкі жыртқыш... Ренард》
Dialogue: 0,0:07:20.74,0:07:22.74,Default,,0,0,0,,Бұл Беллкун ба?
Dialogue: 0,0:07:22.74,0:07:24.91,Default,,0,0,0,,Әй, Гермес!
Dialogue: 0,0:07:24.91,0:07:27.91,Default,,0,0,0,,Хехе, мен сені мұндай жерде кездестіремін деп ойламаппын.
Dialogue: 0,0:07:27.91,0:07:30.08,Default,,0,0,0,,Белл-кун да ескі. Уф.
Dialogue: 0,0:07:30.08,0:07:32.41,Default,,0,0,0,,Сіз іздеген адам болды ма?
Dialogue: 0,0:07:32.41,0:07:35.05,Default,,0,0,0,,А... жоқ, олай емес...
Dialogue: 0,0:07:35.05,0:07:37.52,Default,,0,0,0,,А, сен неге мұндасың, Гермес?
Dialogue: 0,0:07:37.52,0:07:41.19,Default,,0,0,0,,Ей, ақымақ нәрселерді тыңдама.
Dialogue: 0,0:07:41.19,0:07:44.86,Default,,0,0,0,,Менің осында болғанымды құпия сақтаңыз, жарай ма?
Dialogue: 0,0:07:44.86,0:07:47.70,Default,,0,0,0,,Бұл уәде. Ах ха….
Dialogue: 0,0:07:47.70,0:07:51.30,Default,,0,0,0,,Иә, бұл ерлер арасындағы уәденің белгісі.
Dialogue: 0,0:07:53.37,0:07:55.37,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:55.37,0:07:57.57,Default,,0,0,0,,Қуат беруші. Буфу!
Dialogue: 0,0:07:57.57,0:07:59.54,Default,,0,0,0,,Олай болса, Белл-кун, бір-бірімізбен сөйлесейік➡
Dialogue: 0,0:07:59.54,0:08:01.54,Default,,0,0,0,,Түнді көңілді өткізейік!
Dialogue: 0,0:08:01.54,0:08:03.55,Default,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:08:03.55,0:08:06.72,Default,,0,0,0,,Уау! Маған бұл керек емес!
Dialogue: 0,0:08:06.72,0:08:08.72,Default,,0,0,0,,Мен оны қайтарамын!
Dialogue: 0,0:08:08.72,0:08:10.75,Default,,0,0,0,,Уф! ? Ах.
Dialogue: 0,0:08:10.75,0:08:12.72,Default,,0,0,0,,Кешіріңіз! Жарайды?
Dialogue: 0,0:08:17.26,0:08:20.43,Default,,0,0,0,,Көрмейтін бет, солай емес пе?
Dialogue: 0,0:08:20.43,0:08:24.27,Default,,0,0,0,,Эй, бұл өте қызықты, солай емес пе?
Dialogue: 0,0:08:24.27,0:08:26.94,Default,,0,0,0,,Мен Айшамын. Сен ше?
Dialogue: 0,0:08:26.94,0:08:30.61,Default,,0,0,0,,Аа… аа….
Dialogue: 0,0:08:30.61,0:08:33.38,Default,,0,0,0,,Эй, бүгін кешке маған бір нәрсе алғың келе ме?
Dialogue: 0,0:08:33.38,0:08:36.88,Default,,0,0,0,,Ух... жоқ, мен... айтайын дегенім...
Dialogue: 0,0:08:36.88,0:08:39.18,Default,,0,0,0,,《Не? Сіз оны жылжыта алмайсыз ба? 》
Dialogue: 0,0:08:39.18,0:08:42.55,Default,,0,0,0,,Уууу... Ашуланба.
Dialogue: 0,0:08:42.55,0:08:44.55,Default,,0,0,0,,Муг...
Dialogue: 0,0:08:44.55,0:08:47.39,Default,,0,0,0,,Айша Бұл кім? (Жезөкше) Сіз бүгін кешке қонақсыз ба?
Dialogue: 0,0:08:47.39,0:08:49.39,Default,,0,0,0,,Мен оны осы жерден таптым.
Dialogue: 0,0:08:49.39,0:08:52.23,Default,,0,0,0,,Гуги…. Сіз аңғал көрінесіз, солай ма?
Dialogue: 0,0:08:52.23,0:08:54.40,Default,,0,0,0,,Уау, сондай сүйкімді!
Dialogue: 0,0:08:54.40,0:08:58.23,Default,,0,0,0,,Бұл мен ойын-сауық ауданында бірінші рет болып тұрмын ба?
Dialogue: 0,0:08:58.23,0:09:01.57,Default,,0,0,0,,Мм... Эй, Айша.
Dialogue: 0,0:09:01.57,0:09:04.57,Default,,0,0,0,,Бұл адам Кішкентай Руки емес пе?
Dialogue: 0,0:09:04.57,0:09:06.54,Default,,0,0,0,,Мугю….
Dialogue: 0,0:09:06.54,0:09:08.54,Default,,0,0,0,,Өткен күнгі соғыс ойыны туралы не айтасыз?
Dialogue: 0,0:09:08.54,0:09:11.58,Default,,0,0,0,,Расында~ Ақ шаш пен қызыл көз!
Dialogue: 0,0:09:11.58,0:09:13.75,Default,,0,0,0,,Тарихтағы ең жылдам рейтинг➡
Dialogue: 0,0:09:13.75,0:09:15.75,Default,,0,0,0,,Рекорд ұстаушы!
Dialogue: 0,0:09:15.75,0:09:17.92,Default,,0,0,0,,Ең бірінші көзіме түскені мен болдым!
Dialogue: 0,0:09:17.92,0:09:19.92,Default,,0,0,0,,Мен оны ешкімге бермеймін!
Dialogue: 0,0:09:19.92,0:09:22.92,Default,,0,0,0,,Е! Күте тұрыңыз!
Dialogue: 0,0:09:22.92,0:09:25.26,Default,,0,0,0,,Мен жай ғана отбасыммен ➡ дос болғым келеді
Dialogue: 0,0:09:25.26,0:09:28.43,Default,,0,0,0,,Мен жаңа ғана сені іздеп келдім... Өтінемін, маған демалыс беріңізші!
Dialogue: 0,0:09:28.43,0:09:31.60,Default,,0,0,0,,Сіз мұны айтуға дайынсыз.
Dialogue: 0,0:09:31.60,0:09:34.67,Default,,0,0,0,,Қараңыз, ең жоғары сапа.
Dialogue: 0,0:09:34.67,0:09:38.67,Default,,0,0,0,,Ең жақсы! ? Жүр, менімен жүр.
Dialogue: 0,0:09:38.67,0:09:41.51,Default,,0,0,0,,Бір адамды үйге апару.
Dialogue: 0,0:09:41.51,0:09:43.51,Default,,0,0,0,,Бұл дұрыс емес! Толығырақ➡
Dialogue: 0,0:09:43.51,0:09:45.51,Default,,0,0,0,,Мен айта алмаймын, бірақ бұл ➡
Dialogue: 0,0:09:45.51,0:09:47.72,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:09:49.68,0:09:51.69,Default,,0,0,0,,Өтінемін! өтінемін, мені кешірші!
Dialogue: 0,0:09:51.69,0:09:53.69,Default,,0,0,0,,Менің айтқым келгені бұл емес!
Dialogue: 0,0:09:53.69,0:09:55.69,Default,,0,0,0,,Өлетін жаман уақыт.
Dialogue: 0,0:09:55.69,0:09:58.03,Default,,0,0,0,,Өйткені мен Айшадан кейін келемін!
Dialogue: 0,0:09:58.03,0:10:00.36,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл мен!
Dialogue: 0,0:10:00.36,0:10:03.36,Default,,0,0,0,,Бүгінгі түннің олжасы сол адам➡
Dialogue: 0,0:10:03.36,0:10:05.37,Default,,0,0,0,,Айша.
Dialogue: 0,0:10:05.37,0:10:08.04,Default,,0,0,0,,Құрметті Иштар... Иә?
Dialogue: 0,0:10:08.04,0:10:10.21,Default,,0,0,0,,Иштарға қарама!
Dialogue: 0,0:10:10.21,0:10:12.21,Default,,0,0,0,,Арх! Қайтадан таң қалдым➡
Dialogue: 0,0:10:12.21,0:10:16.04,Default,,0,0,0,,Менің олжам ұрланса, шыдай алмаймын!
Dialogue: 0,0:10:16.04,0:10:19.71,Default,,0,0,0,,Иә. Бүгін кешке қонақ келеді.
Dialogue: 0,0:10:19.71,0:10:23.05,Default,,0,0,0,,Көк кісіні уайымдайтын уақытым жоқ.
Dialogue: 0,0:10:23.05,0:10:25.05,Default,,0,0,0,,《Бұл Иштар➡
Dialogue: 0,0:10:25.05,0:10:27.89,Default,,0,0,0,,Ха, бұл дегеніміз... мұнда ➡
Dialogue: 0,0:10:27.89,0:10:31.39,Default,,0,0,0,,Иштар отбасының үйі! ? 》
Dialogue: 0,0:10:31.39,0:10:33.39,Default,,0,0,0,,((Eina: Ishtar Familia —➡
Dialogue: 0,0:10:33.39,0:10:36.90,Default,,0,0,0,,Бұл Орариодағы ең күшті отбасылардың бірі.
Dialogue: 0,0:10:36.90,0:10:39.73,Default,,0,0,0,,Бұған әртүрлі себептер бар...
Dialogue: 0,0:10:39.73,0:10:43.24,Default,,0,0,0,,Менің ойымша, Белл-кунға білудің қажеті жоқ))
Dialogue: 0,0:10:43.24,0:10:46.41,Default,,0,0,0,,《Мынаны білдіреді➡
Dialogue: 0,0:10:46.41,0:10:48.41,Default,,0,0,0,,Сіз нені айтып тұрсыз?! 》
Dialogue: 0,0:10:48.41,0:10:50.41,Default,,0,0,0,,Мен бірінші болдым дедіңіз!
Dialogue: 0,0:10:50.41,0:10:52.41,Default,,0,0,0,,Лена қу!
Dialogue: 0,0:10:52.41,0:10:55.32,Default,,0,0,0,,Ленаны ұстап алайық! Ааааааааааааааааааааааааааааа!
Dialogue: 0,0:10:57.25,0:10:59.42,Default,,0,0,0,,Хмм… мм….
Dialogue: 0,0:10:59.42,0:11:02.09,Default,,0,0,0,,Өкінішке орай, бөлме толық емес.
Dialogue: 0,0:11:02.09,0:11:04.43,Default,,0,0,0,,Мен босағанша сені осында күтемін.
Dialogue: 0,0:11:04.43,0:11:06.59,Default,,0,0,0,,Әрине, мен мұнда суланып қалдым➡
Dialogue: 0,0:11:06.59,0:11:08.60,Default,,0,0,0,,Мен қарсы емеспін.
Dialogue: 0,0:11:08.60,0:11:10.93,Default,,0,0,0,,Иә! Жаман емес пе?
Dialogue: 0,0:11:10.93,0:11:13.60,Default,,0,0,0,,Мен басқа отбасынанмын...
Dialogue: 0,0:11:13.60,0:11:15.94,Default,,0,0,0,,А, анау... Авантюристті қорғау үшін➡
Dialogue: 0,0:11:15.94,0:11:17.94,Default,,0,0,0,,Үйіңізге біреуді шақыру...
Dialogue: 0,0:11:17.94,0:11:20.28,Default,,0,0,0,,Бұл әр түнде болады.
Dialogue: 0,0:11:20.28,0:11:24.15,Default,,0,0,0,,Амазонкалардың әдеттерін білмейсіз бе? Уф.
Dialogue: 0,0:11:24.15,0:11:26.15,Default,,0,0,0,,Адамды ұрлау➡
Dialogue: 0,0:11:26.15,0:11:29.48,Default,,0,0,0,,Мен оны жегім келеді. Фу.
Dialogue: 0,0:11:29.48,0:11:31.49,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:11:31.49,0:11:33.72,Default,,0,0,0,,Ертең таңертең үйге бара аласың ба?
Dialogue: 0,0:11:33.72,0:11:35.72,Default,,0,0,0,,Немесе келесі күні...
Dialogue: 0,0:11:35.72,0:11:37.73,Default,,0,0,0,,Мен бәрін сорамын➡
Dialogue: 0,0:11:37.73,0:11:40.23,Default,,0,0,0,,Рухым мен тамырым таусылғанша.
Dialogue: 0,0:11:40.23,0:11:42.90,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:11:42.90,0:11:46.07,Default,,0,0,0,,Жас жігіттің иісі бар!
Dialogue: 0,0:11:46.07,0:11:48.07,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:48.07,0:11:53.07,Default,,0,0,0,,Ге Ге Ге Ге Ге Гех!
Dialogue: 0,0:11:53.07,0:11:55.41,Default,,0,0,0,,Сен мұнда не үшін келдің, Фрин?
Dialogue: 0,0:11:55.41,0:11:58.08,Default,,0,0,0,,Отбасы жетекшісіне➡
Dialogue: 0,0:11:58.08,0:12:00.58,Default,,0,0,0,,Сөйлеу тәсілі қандай?
Dialogue: 0,0:12:00.58,0:12:02.58,Default,,0,0,0,,Айша.
Dialogue: 0,0:12:02.58,0:12:05.42,Default,,0,0,0,,Мен көрдім, көрдім, соғыс ойыны.
Dialogue: 0,0:12:05.42,0:12:08.59,Default,,0,0,0,,Сол кішкентай жаңағыны жей алу➡
Dialogue: 0,0:12:08.59,0:12:11.93,Default,,0,0,0,,Бұл өте керемет оқиға!
Dialogue: 0,0:12:11.93,0:12:15.76,Default,,0,0,0,,Сен... Маған ұнайды.
Dialogue: 0,0:12:15.76,0:12:17.77,Default,,0,0,0,,Қалжыңдамаңыз.
Dialogue: 0,0:12:17.77,0:12:19.77,Default,,0,0,0,,Бұл біз ұстаған олжа!
Dialogue: 0,0:12:19.77,0:12:22.27,Default,,0,0,0,,Атайға лайықты еркектер аз➡
Dialogue: 0,0:12:22.27,0:12:24.27,Default,,0,0,0,,Бұл қызықсыз!
Dialogue: 0,0:12:24.27,0:12:26.61,Default,,0,0,0,,Дәмі жетерлік емес пе?
Dialogue: 0,0:12:26.61,0:12:29.78,Default,,0,0,0,,Сенің дәмін сынағаннан кейін ол адам жарамсыз болып қалды➡
Dialogue: 0,0:12:29.78,0:12:31.78,Default,,0,0,0,,Нешеу бар деп ойлайсыңдар?
Dialogue: 0,0:12:31.78,0:12:35.88,Default,,0,0,0,,Атайдан басқаға көңілің толмайды, солай ма?
Dialogue: 0,0:12:35.88,0:12:39.05,Default,,0,0,0,,Тым сұлу болу күнә емес пе?
Dialogue: 0,0:12:39.05,0:12:41.89,Default,,0,0,0,,Иштар-сама да жақсы дейді➡
Dialogue: 0,0:12:41.89,0:12:44.56,Default,,0,0,0,,Ол маған сәйкес келмейді...
Dialogue: 0,0:12:44.56,0:12:46.73,Default,,0,0,0,,《Мен байыптымын...》
Dialogue: 0,0:12:46.73,0:12:49.06,Default,,0,0,0,,Сіз қалжыңдамайсыз! Сенің кесіріңнен➡
Dialogue: 0,0:12:49.06,0:12:51.07,Default,,0,0,0,,Менің үйіме ешкім жақындамайды!
Dialogue: 0,0:12:51.07,0:12:53.07,Default,,0,0,0,,Біреуді алып қашу азап!
Dialogue: 0,0:12:53.07,0:12:55.07,Default,,0,0,0,,Үрмеңіз.
Dialogue: 0,0:12:55.07,0:12:57.41,Default,,0,0,0,,Оның сұлулығы мен күші Атайдай емес➡
Dialogue: 0,0:12:57.41,0:12:59.57,Default,,0,0,0,,Ұсқынсыз адамдар.
Dialogue: 0,0:12:59.57,0:13:02.58,Default,,0,0,0,,Айнаға қара, бақа.
Dialogue: 0,0:13:02.58,0:13:05.91,Default,,0,0,0,,Бұл қазірдің өзінде тітіркендіргіш.
Dialogue: 0,0:13:05.91,0:13:09.25,Default,,0,0,0,,Амазонкалар сияқты ақ пен қараға барайық!
Dialogue: 0,0:13:09.25,0:13:11.92,Default,,0,0,0,,Бұл жақсы құбыжық.
Dialogue: 0,0:13:11.92,0:13:15.26,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:15.26,0:13:17.59,Default,,0,0,0,,Хи хи...
Dialogue: 0,0:13:17.59,0:13:19.63,Default,,0,0,0,,Уф, уаааааааааааааааааааа!
Dialogue: 0,0:13:19.63,0:13:21.63,Default,,0,0,0,,Ерте құс жеңеді!
Dialogue: 0,0:13:21.63,0:13:24.47,Default,,0,0,0,,《Жүгір! Жүгір, жүгір!
Dialogue: 0,0:13:24.47,0:13:27.30,Default,,0,0,0,,Түсіндім! Мен ұсталып қалатыныма сенімдімін➡
Dialogue: 0,0:13:27.30,0:13:29.80,Default,,0,0,0,,Мен енді өзім бола алмаймын! 》
Dialogue: 0,0:13:29.80,0:13:31.81,Default,,0,0,0,,Гяаааааааа….
Dialogue: 0,0:13:31.81,0:13:34.74,Default,,0,0,0,,Хахаха... Қарғыс атсын!
Dialogue: 0,0:13:34.74,0:13:38.25,Default,,0,0,0,,《Арман, үміт, сағыныш үзілді➡
Dialogue: 0,0:13:38.25,0:13:41.58,Default,,0,0,0,,Bell Cranel... аяқталды!
Dialogue: 0,0:13:41.58,0:13:44.09,Default,,0,0,0,,Жүгіру! 》
Dialogue: 0,0:13:44.09,0:13:46.59,Default,,0,0,0,,Кішкентай Руки қашып кетті! ?
Dialogue: 0,0:13:46.59,0:13:49.76,Default,,0,0,0,,Ұстап алсаң, сый болатын сияқты!
Dialogue: 0,0:13:49.76,0:13:51.73,Default,,0,0,0,,《Тек үй емес➡
Dialogue: 0,0:13:51.73,0:13:53.73,Default,,0,0,0,,Ishtar Familia-ның ықпал ету аймағы➡
Dialogue: 0,0:13:53.73,0:13:57.07,Default,,0,0,0,,Бұл қызыл жарық ауданы!
Dialogue: 0,0:13:57.07,0:13:59.77,Default,,0,0,0,,Шықпасаң, ақыры қолға түсесің!
Dialogue: 0,0:13:59.77,0:14:02.27,Default,,0,0,0,,Шығу жолы қандай? Шығу жолы қандай?
Dialogue: 0,0:14:02.27,0:14:05.77,Default,,0,0,0,,Міне болды! Гу... уф!
Dialogue: 0,0:14:05.77,0:14:08.78,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:14:08.78,0:14:10.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.62,0:14:21.59,Default,,0,0,0,,Мен осындамын! Ха! ?
Dialogue: 0,0:14:21.59,0:14:25.26,Default,,0,0,0,,Іздеу! Бұл бір жерде!
Dialogue: 0,0:14:25.26,0:14:30.77,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:14:30.77,0:14:32.77,Default,,0,0,0,,Жоқ! (аяқ дыбыстары)
Dialogue: 0,0:14:36.20,0:14:38.21,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:14:38.21,0:14:40.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:47.55,0:14:50.72,Default,,0,0,0,,Біз сізді күттік, сэр.
Dialogue: 0,0:14:50.72,0:14:53.39,Default,,0,0,0,,Ах! ? Эх...
Dialogue: 0,0:14:53.39,0:14:57.56,Default,,0,0,0,,Бүгін түнде мен түнгі скраб жасаймын.
Dialogue: 0,0:14:57.56,0:15:01.40,Default,,0,0,0,,Менің атым Харухиме.
Dialogue: 0,0:15:01.40,0:15:03.60,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:05.57,0:15:08.07,Default,,0,0,0,,Енді осы жаққа келіңізші.
Dialogue: 0,0:15:08.07,0:15:11.57,Default,,0,0,0,,Е... ә, ә, әй.
Dialogue: 0,0:15:11.57,0:15:13.91,Default,,0,0,0,,А... А, жоқ, бұл➡
Dialogue: 0,0:15:13.91,0:15:15.91,Default,,0,0,0,,Мен басқамын! Ах! ?
Dialogue: 0,0:15:21.92,0:15:23.92,Default,,0,0,0,,Ал... жезөкшелер үйі➡
Dialogue: 0,0:15:23.92,0:15:27.26,Default,,0,0,0,,Бұл бірінші рет пе...? Иә! ?
Dialogue: 0,0:15:27.26,0:15:29.42,Default,,0,0,0,,Түсіндім... Харухиме➡
Dialogue: 0,0:15:29.42,0:15:31.93,Default,,0,0,0,,Маған қалдырыңыз….
Dialogue: 0,0:15:31.93,0:15:35.73,Default,,0,0,0,,Уа! Ах! О, бұл!
Dialogue: 0,0:15:35.73,0:15:37.90,Default,,0,0,0,,Жарайды, сэр.
Dialogue: 0,0:15:37.90,0:15:39.90,Default,,0,0,0,,Харухиме➡
Dialogue: 0,0:15:39.90,0:15:43.27,Default,,0,0,0,,Барлығын маған қалдырыңыз...
Dialogue: 0,0:15:46.07,0:15:48.74,Default,,0,0,0,,Демалыңыз...
Dialogue: 0,0:15:50.75,0:15:54.25,Default,,0,0,0,,Жақсы…. [Белл: Не? 》
Dialogue: 0,0:15:54.25,0:15:56.55,Default,,0,0,0,,Мырзалар➡
Dialogue: 0,0:15:56.55,0:15:58.85,Default,,0,0,0,,Клавикул~.
Dialogue: 0,0:16:02.06,0:16:05.73,Default,,0,0,0,,О, у... Сәлеметсіз бе?
Dialogue: 0,0:16:05.73,0:16:09.90,Default,,0,0,0,,Кюуу~. Эй, эй! ?
Dialogue: 0,0:16:09.90,0:16:12.40,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:16:12.40,0:16:14.40,Default,,0,0,0,,Мен сізді тұтынушы деп қате ойлап қалдым➡
Dialogue: 0,0:16:14.40,0:16:16.40,Default,,0,0,0,,Тіпті мұндай жексұрындыққа...
Dialogue: 0,0:16:16.40,0:16:18.41,Default,,0,0,0,,Жоқ, жоқ, солай...
Dialogue: 0,0:16:18.41,0:16:20.91,Default,,0,0,0,,Бұл жерге өз бетіммен келгеніме мен кінәлімін...
Dialogue: 0,0:16:20.91,0:16:24.08,Default,,0,0,0,,Менің атым Харухиме.
Dialogue: 0,0:16:24.08,0:16:26.08,Default,,0,0,0,,Сіз ше? Ах➡
Dialogue: 0,0:16:26.08,0:16:28.25,Default,,0,0,0,,Мен Белл Кранелмін!
Dialogue: 0,0:16:28.25,0:16:31.09,Default,,0,0,0,,Мистер Кранель?
Dialogue: 0,0:16:31.09,0:16:33.86,Default,,0,0,0,,Егер сіз тұтынушы болмасаңыз➡
Dialogue: 0,0:16:33.86,0:16:36.69,Default,,0,0,0,,Кранель мырза неліктен осы қызыл жарық ауданында?
Dialogue: 0,0:16:36.69,0:16:40.86,Default,,0,0,0,,А, м-м, бұл... Иә?
Dialogue: 0,0:16:40.86,0:16:43.36,Default,,0,0,0,,Солай ма? Айшаға және басқаларға➡
Dialogue: 0,0:16:43.36,0:16:45.37,Default,,0,0,0,,Қуғында...
Dialogue: 0,0:16:45.37,0:16:47.37,Default,,0,0,0,,Сіз бұл адамды танисыз ба?
Dialogue: 0,0:16:47.37,0:16:51.04,Default,,0,0,0,,Иә, сен маған әрқашан жақсысың.
Dialogue: 0,0:16:51.04,0:16:53.21,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:53.21,0:16:55.21,Default,,0,0,0,,Бірінші рет пайдаланушылар үшін осы жерден бастаңыз➡
Dialogue: 0,0:16:55.21,0:16:57.55,Default,,0,0,0,,Шығу қиын болады.
Dialogue: 0,0:16:57.55,0:16:59.55,Default,,0,0,0,,Таң атқанда➡
Dialogue: 0,0:16:59.55,0:17:02.05,Default,,0,0,0,,Мен сізді саңылауға апарамын.
Dialogue: 0,0:17:02.05,0:17:04.05,Default,,0,0,0,,О, жақсы ма?
Dialogue: 0,0:17:04.05,0:17:07.05,Default,,0,0,0,,Иә, бұл тек бір түндік кездесу болар еді➡
Dialogue: 0,0:17:07.05,0:17:09.06,Default,,0,0,0,,Харухиме Кранель-сама➡ тиесілі
Dialogue: 0,0:17:09.06,0:17:11.56,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:17:11.56,0:17:13.73,Default,,0,0,0,,Уууу.
Dialogue: 0,0:17:13.73,0:17:16.40,Default,,0,0,0,,Балама қандай?➡
Dialogue: 0,0:17:16.40,0:17:18.40,Default,,0,0,0,,Менімен бірге болғанша➡
Dialogue: 0,0:17:18.40,0:17:20.40,Default,,0,0,0,,Біз сөйлесе аламыз ба?
Dialogue: 0,0:17:20.40,0:17:22.90,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:17:22.90,0:17:26.41,Default,,0,0,0,,Олай болса, Кранел мырза, осы Орариоға➡ қосылыңыз
Dialogue: 0,0:17:26.41,0:17:28.41,Default,,0,0,0,,Авантюрист болу үшін бе?
Dialogue: 0,0:17:28.41,0:17:31.75,Default,,0,0,0,,Түс сияқты бірдеңе болды...
Dialogue: 0,0:17:31.75,0:17:33.71,Default,,0,0,0,,Ал менде ақша жоқ еді.
Dialogue: 0,0:17:33.71,0:17:36.22,Default,,0,0,0,,Солай ма? Мен➡
Dialogue: 0,0:17:36.22,0:17:39.39,Default,,0,0,0,,Мен мұнда Қиыр Шығыстан келген себебім.
Dialogue: 0,0:17:39.39,0:17:41.89,Default,,0,0,0,,Қиыр Шығыс? иә.
Dialogue: 0,0:17:41.89,0:17:45.73,Default,,0,0,0,,Төрт мезгілі ерекше табиғаты мол жер.
Dialogue: 0,0:17:45.73,0:17:47.73,Default,,0,0,0,,Бірақ мен➡
Dialogue: 0,0:17:47.73,0:17:51.07,Default,,0,0,0,,11 жасымда үйімнен бас тарттым.
Dialogue: 0,0:17:51.07,0:17:53.57,Default,,0,0,0,,Ата-ана мен бала арасындағы қарым-қатынастан бас тарту➡
Dialogue: 0,0:17:53.57,0:17:56.07,Default,,0,0,0,,Сіз оны кесіп тастады дейсіз бе?
Dialogue: 0,0:17:56.07,0:17:58.41,Default,,0,0,0,,Әкемнің ашуы маған қатты әсер етті➡
Dialogue: 0,0:17:58.41,0:18:01.24,Default,,0,0,0,,Бұл сөзсіз болды.
Dialogue: 0,0:18:01.24,0:18:03.58,Default,,0,0,0,,Одан кейін түрлі оқиғалар болды➡
Dialogue: 0,0:18:03.58,0:18:06.08,Default,,0,0,0,,Мен осы ойын-сауық аймағымын➡
Dialogue: 0,0:18:06.08,0:18:08.72,Default,,0,0,0,,Ол Ishtar Familia-ға сатылды.
Dialogue: 0,0:18:08.72,0:18:11.39,Default,,0,0,0,,Хмм…. Бірақ ➡
Dialogue: 0,0:18:11.39,0:18:13.39,Default,,0,0,0,,Орарио да оған тәнті болды.
Dialogue: 0,0:18:13.39,0:18:15.89,Default,,0,0,0,,Бұл жер де Қиыр Шығыста орналасқан➡
Dialogue: 0,0:18:15.89,0:18:18.56,Default,,0,0,0,,Қаншама хикаялар тараған.
Dialogue: 0,0:18:18.56,0:18:21.06,Default,,0,0,0,,«Зындан ораториясы»?
Dialogue: 0,0:18:21.06,0:18:24.73,Default,,0,0,0,,Иә! Сонымен қатар, шетелдік рыцарьлар Қасиетті Граильді іздейді➡
Dialogue: 0,0:18:24.73,0:18:27.07,Default,,0,0,0,,Лабиринт арқылы саяхаттау туралы әңгіме!
Dialogue: 0,0:18:27.07,0:18:29.07,Default,,0,0,0,,Бұл «Гарардтың шытырман оқиғасы»!
Dialogue: 0,0:18:29.07,0:18:31.24,Default,,0,0,0,,Емі жоқ дертке шалдыққан ханшайымды сауықтыру➡
Dialogue: 0,0:18:31.24,0:18:33.17,Default,,0,0,0,,Қасиетті Граалды іздеуге барыңыз...
Dialogue: 0,0:18:33.17,0:18:35.18,Default,,0,0,0,,Сіз білесіз бе? Олай болса ➡
Dialogue: 0,0:18:35.18,0:18:38.35,Default,,0,0,0,,Шамда мөрленген рухтарға көмектесетін сиқыршы...
Dialogue: 0,0:18:38.35,0:18:40.35,Default,,0,0,0,,«Сиқыршы Аладдин»!
Dialogue: 0,0:18:40.35,0:18:42.68,Default,,0,0,0,,Уау! Мүмкін➡
Dialogue: 0,0:18:42.68,0:18:44.69,Default,,0,0,0,,Харухименің де батырлық тарихы бар ма?
Dialogue: 0,0:18:44.69,0:18:46.79,Default,,0,0,0,,Иә! Мен оны жақсы көремін!
Dialogue: 0,0:18:50.02,0:18:52.36,Default,,0,0,0,,Мен оны уәде еткендей жеткіздім.
Dialogue: 0,0:18:52.36,0:18:54.40,Default,,0,0,0,,Түсінесіз деп ойлаймын➡
Dialogue: 0,0:18:54.40,0:18:56.36,Default,,0,0,0,,Бұл туралы бір ауыз сөз айтпа.
Dialogue: 0,0:18:56.36,0:18:58.73,Default,,0,0,0,,Ақылға қонымды.
Dialogue: 0,0:18:58.73,0:19:01.24,Default,,0,0,0,,Сіздің сеніміңізге опасыздық жасау ниетім жоқ.
Dialogue: 0,0:19:01.24,0:19:03.74,Default,,0,0,0,,Бірақ сіз мұнымен не істейсіз?
Dialogue: 0,0:19:03.74,0:19:05.74,Default,,0,0,0,,Ішіне қарадың ба?
Dialogue: 0,0:19:05.74,0:19:08.74,Default,,0,0,0,,Мен оны кездейсоқ көрдім.
Dialogue: 0,0:19:08.74,0:19:10.75,Default,,0,0,0,,Тым ұзақ емес➡
Dialogue: 0,0:19:10.75,0:19:13.58,Default,,0,0,0,,Мен саған бір қызық көрсетемін.
Dialogue: 0,0:19:13.58,0:19:15.58,Default,,0,0,0,,Патша болып көрінген әлгі әйел➡
Dialogue: 0,0:19:15.58,0:19:18.25,Default,,0,0,0,,Жермен жорғалап жүргендей.
Dialogue: 0,0:19:18.25,0:19:21.26,Default,,0,0,0,,Богиня қорқынышты.
Dialogue: 0,0:19:21.26,0:19:24.26,Default,,0,0,0,,Гермес Мен бақытты боламын деп ойлаймын➡
Dialogue: 0,0:19:24.26,0:19:26.26,Default,,0,0,0,,Сізде ақпарат жоқ па?
Dialogue: 0,0:19:26.26,0:19:28.26,Default,,0,0,0,,Әлгі әйелдің кемшілігі неде?
Dialogue: 0,0:19:28.26,0:19:30.26,Default,,0,0,0,,Егер бар болса, біз бұл туралы айттық.
Dialogue: 0,0:19:30.26,0:19:32.27,Default,,0,0,0,,Сұлулық Құдайының алдында жатыр➡
Dialogue: 0,0:19:32.27,0:19:35.34,Default,,0,0,0,,Мен оны киюім керек еді...
Dialogue: 0,0:19:35.34,0:19:37.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:37.34,0:19:39.34,Default,,0,0,0,,«Адасқан Диралдо»➡
Dialogue: 0,0:19:39.34,0:19:42.34,Default,,0,0,0,,“Жерджио қасиетті аңыз”… Харухиме-сан➡
Dialogue: 0,0:19:42.34,0:19:45.18,Default,,0,0,0,,Сіз көп әңгіме оқисыз!
Dialogue: 0,0:19:45.18,0:19:47.18,Default,,0,0,0,,Мистер Кранель керемет!
Dialogue: 0,0:19:47.18,0:19:49.68,Default,,0,0,0,,Сіз шынымен бәрін білесіз...
Dialogue: 0,0:19:49.68,0:19:52.02,Default,,0,0,0,,Мен тек қаһармандық әңгімелерді айтамын.
Dialogue: 0,0:19:52.02,0:19:56.19,Default,,0,0,0,,Харухиме-сан басқа оқиғалар туралы көбірек білетін сияқты.
Dialogue: 0,0:19:56.19,0:19:59.36,Default,,0,0,0,,Бірақ менің сүйікті оқиғам ➡
Dialogue: 0,0:19:59.36,0:20:03.03,Default,,0,0,0,,Бұл батырлық ертегі. Дәстүрлі түрде Қиыр Шығыста тараған➡
Dialogue: 0,0:20:03.03,0:20:06.70,Default,,0,0,0,,Ол кішкентай болса да, жын-шайтанның шабуылына ұшыраған қызды құтқарып қалды➡
Dialogue: 0,0:20:06.70,0:20:09.20,Default,,0,0,0,,Мононофусама оқиғасы.
Dialogue: 0,0:20:09.20,0:20:12.21,Default,,0,0,0,,Бұл ``1000 Дожи''.
Dialogue: 0,0:20:12.21,0:20:15.21,Default,,0,0,0,,Кітаптар әлемі сияқты ➡
Dialogue: 0,0:20:15.21,0:20:17.21,Default,,0,0,0,,Батыр менің қолымды алады➡
Dialogue: 0,0:20:17.21,0:20:20.21,Default,,0,0,0,,Мені сүйсінетін әлемге алып кеткім келеді.
Dialogue: 0,0:20:20.21,0:20:22.88,Default,,0,0,0,,Қалай... бұл жәй ғана босқа➡
Dialogue: 0,0:20:22.88,0:20:24.89,Default,,0,0,0,,Бұл жай ғана арман оқиғасы.
Dialogue: 0,0:20:24.89,0:20:28.56,Default,,0,0,0,,Мені алып кетуге құқығым жоқ...
Dialogue: 0,0:20:28.56,0:20:30.89,Default,,0,0,0,,Міне!
Dialogue: 0,0:20:30.89,0:20:33.89,Default,,0,0,0,,Батырлар Харухиме сияқты адамдарды тастамайды!
Dialogue: 0,0:20:33.89,0:20:35.90,Default,,0,0,0,,Сіз білікті емессіз!
Dialogue: 0,0:20:35.90,0:20:39.07,Default,,0,0,0,,Сіз өте мейірімдісіз, Кранел мырза.
Dialogue: 0,0:20:39.07,0:20:41.07,Default,,0,0,0,,Бірақ мен➡
Dialogue: 0,0:20:41.07,0:20:43.07,Default,,0,0,0,,Сіз әдемі ханшайым болмасаңыз➡
Dialogue: 0,0:20:43.07,0:20:45.07,Default,,0,0,0,,Құрбандыққа шалынған кедей ➡
Dialogue: 0,0:20:45.07,0:20:47.07,Default,,0,0,0,,Ол әулие де емес.
Dialogue: 0,0:20:47.07,0:20:49.58,Default,,0,0,0,,Мен жезөкшемін.
Dialogue: 0,0:20:49.58,0:20:52.25,Default,,0,0,0,,Ха... (Харухиме) Мен әлі жетілмеген болсам да➡
Dialogue: 0,0:20:52.25,0:20:55.58,Default,,0,0,0,,Денемді көптеген мырзаларға сеніп тапсырдым➡
Dialogue: 0,0:20:55.58,0:20:58.09,Default,,0,0,0,,Біз бір қабатта тұрамыз.
Dialogue: 0,0:20:58.09,0:21:01.09,Default,,0,0,0,,Пәктігімді өз еркіммен қорғамаймын➡
Dialogue: 0,0:21:01.09,0:21:04.43,Default,,0,0,0,,Ақша алу үшін көктемді өткіздім.
Dialogue: 0,0:21:04.43,0:21:06.59,Default,,0,0,0,,Мен сондай төменмін➡
Dialogue: 0,0:21:06.59,0:21:09.60,Default,,0,0,0,,Олар сізді қалай құтқара алады?
Dialogue: 0,0:21:14.44,0:21:18.27,Default,,0,0,0,,Батыр үшін жезөкше жойылу символы.
Dialogue: 0,0:21:18.27,0:21:21.61,Default,,0,0,0,,Мен кір екенімді түсінген күннен бастап➡
Dialogue: 0,0:21:21.61,0:21:24.61,Default,,0,0,0,,Сол әдемі оқиғаны айтып берші➡
Dialogue: 0,0:21:24.61,0:21:26.78,Default,,0,0,0,,Оқуға жарамды емес.
Dialogue: 0,0:21:26.78,0:21:28.78,Default,,0,0,0,,Таңдану➡
Dialogue: 0,0:21:28.78,0:21:30.95,Default,,0,0,0,,Рұқсат етілмейді.
Dialogue: 0,0:21:30.95,0:21:32.95,Default,,0,0,0,,Мен➡
Dialogue: 0,0:21:32.95,0:21:35.16,Default,,0,0,0,,Ол жай ғана жезөкше.
Dialogue: 0,0:21:38.43,0:21:40.76,Default,,0,0,0,,Сағат таусылып барады.
Dialogue: 0,0:21:40.76,0:21:44.10,Default,,0,0,0,,Бұл өте қызықты уақыт болды.
Dialogue: 0,0:21:44.10,0:21:46.27,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:21:48.27,0:21:51.44,Default,,0,0,0,,Егер сіз осы жолмен жүрсеңіз, сіз Дедрус көшесінде боласыз.
Dialogue: 0,0:21:51.44,0:21:54.58,Default,,0,0,0,,Айша-санның өзі сені бұл жерден таба алмаса керек.
Dialogue: 0,0:21:54.58,0:21:56.78,Default,,0,0,0,,Жүр, асығыңыз.
Dialogue: 0,0:22:02.95,0:22:05.79,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:22:05.79,0:22:07.76,Default,,0,0,0,,Сіз не істеп жатырсыз? Ха...
Dialogue: 0,0:22:09.79,0:22:12.13,Default,,0,0,0,,Мен суық тиіп қалдым, қайтып келемін.
Dialogue: 0,0:22:12.13,0:22:14.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:18.47,0:22:21.47,Default,,0,0,0,,Уф, уф, сәлем….
Dialogue: 0,0:22:21.47,0:22:24.31,Default,,0,0,0,,Уф.
Dialogue: 0,0:22:24.31,0:22:26.31,Default,,0,0,0,,Белл Кранель...?
Dialogue: 0,0:22:26.31,0:22:28.48,Default,,0,0,0,,Мен ол балаға ғашық болғаныма сене алар емеспін➡
Dialogue: 0,0:22:28.48,0:22:30.98,Default,,0,0,0,,Мен ол әйелді түсінбеймін.
Dialogue: 0,0:22:30.98,0:22:32.98,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:22:32.98,0:22:35.45,Default,,0,0,0,,Мен ол баланы алып кетемін.
Dialogue: 0,0:22:36.95,0:22:41.95,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
