Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.96,0:00:36.97,Default,,0,0,0,,Олай болса, оған көмектесу мүмкін емес. Apollo Familia бұл➡
Dialogue: 0,0:00:36.97,0:00:39.13,Default,,0,0,0,,Мен сені соғыс ойынына шақырамын!
Dialogue: 0,0:00:39.13,0:00:41.14,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:41.14,0:00:43.14,Default,,0,0,0,,Мен соғыс ойынын күттім!
Dialogue: 0,0:00:43.14,0:00:45.14,Default,,0,0,0,,Аполлонға мейірімділік жоқ!
Dialogue: 0,0:00:45.14,0:00:47.14,Default,,0,0,0,,Мен оған керісінше қарадым!
Dialogue: 0,0:00:47.14,0:00:49.14,Default,,0,0,0,,Егер біз жеңсек➡
Dialogue: 0,0:00:49.14,0:00:52.48,Default,,0,0,0,,Kenzoku Bell Cranel алыңыз!
Dialogue: 0,0:00:52.48,0:00:56.82,Default,,0,0,0,,Ха! ? Бұл жақсы емес, Гестия.
Dialogue: 0,0:00:56.82,0:01:00.16,Default,,0,0,0,,Мен бұл сүйкімді қызды өзіме қалдырамын.
Dialogue: 0,0:01:00.16,0:01:03.33,Default,,0,0,0,,Басынан мақсатың осы ма, бұзық?
Dialogue: 0,0:01:03.33,0:01:05.49,Default,,0,0,0,,Бұл қорқынышты нәрсе.
Dialogue: 0,0:01:05.49,0:01:09.50,Default,,0,0,0,,Біз бір-бірімізге көкте махаббатты сыбырластырамыз, солай ма?
Dialogue: 0,0:01:09.50,0:01:11.50,Default,,0,0,0,,Өтірік айтпа, өтірік айт!
Dialogue: 0,0:01:11.50,0:01:14.17,Default,,0,0,0,,Мен асығыс ұсыныстан бас тартар едім!
Dialogue: 0,0:01:14.17,0:01:17.51,Default,,0,0,0,,Қалай болғанда да! Мен бұл фарспен бірге жүре алмаймын!
Dialogue: 0,0:01:17.51,0:01:20.01,Default,,0,0,0,,Соғыс ойындарын қабылдауға ешқандай себеп жоқ!
Dialogue: 0,0:01:20.01,0:01:22.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:22.01,0:01:24.01,Default,,0,0,0,,Сіз өкінесіз бе?
Dialogue: 0,0:01:24.01,0:01:26.01,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:01:26.01,0:01:28.02,Default,,0,0,0,,Кеттік, Белл-кун!
Dialogue: 0,0:01:28.02,0:01:30.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:33.82,0:01:35.99,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:19.36,0:03:22.83,Default,,0,0,0,,Ха, бұл соғыс ойыны екеніне сенімдімін➡
Dialogue: 0,0:03:22.83,0:03:25.00,Default,,0,0,0,,Бұл таныстар арасындағы жекпе-жек болды, солай ма?
Dialogue: 0,0:03:25.00,0:03:27.34,Default,,0,0,0,,Ах, ережелерді келіскеннен кейін➡
Dialogue: 0,0:03:27.34,0:03:29.67,Default,,0,0,0,,Бұл жаппай соғыс.
Dialogue: 0,0:03:29.67,0:03:33.11,Default,,0,0,0,,Жеңімпаз жеңілгеннен бәрін алады.
Dialogue: 0,0:03:33.11,0:03:37.45,Default,,0,0,0,,Мүшелерден бастап ақшаға дейін.
Dialogue: 0,0:03:37.45,0:03:40.12,Default,,0,0,0,,Аполлон, менің отбасымдағы адам➡
Dialogue: 0,0:03:40.12,0:03:43.62,Default,,0,0,0,,Ол бұл жай ғана Белл-кун екенін білсе де, солай істеді...
Dialogue: 0,0:03:43.62,0:03:46.79,Default,,0,0,0,,Бүгін мен Уэльф пен Лили➡мен зынданға кірдім
Dialogue: 0,0:03:46.79,0:03:48.82,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,0:03:48.82,0:03:51.83,Default,,0,0,0,,Иә. Толық емес жұмысымды да тез бітіремін.
Dialogue: 0,0:03:51.83,0:03:54.00,Default,,0,0,0,,Түнде бірге демалайық.
Dialogue: 0,0:03:56.33,0:03:58.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:02.84,0:04:04.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:04.84,0:04:06.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:06.84,0:04:09.51,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:04:09.51,0:04:11.81,Default,,0,0,0,,Таңертеңнен бері шу көп болды ма?
Dialogue: 0,0:04:11.81,0:04:13.82,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:04:13.82,0:04:15.82,Default,,0,0,0,,​​О?
Dialogue: 0,0:04:15.82,0:04:17.82,Default,,0,0,0,,Донпачидің иісі бар.
Dialogue: 0,0:04:17.82,0:04:21.99,Default,,0,0,0,,А, отбасының... жанжал?
Dialogue: 0,0:04:21.99,0:04:24.49,Default,,0,0,0,,Няға ұқсайды. Мүмкін➡
Dialogue: 0,0:04:24.49,0:04:27.83,Default,,0,0,0,,Оның шашы ағарған. Магг!
Dialogue: 0,0:04:27.83,0:04:29.87,Default,,0,0,0,,Аня, үндеме!
Dialogue: 0,0:04:29.87,0:04:32.03,Default,,0,0,0,,Муф! Мугугу!
Dialogue: 0,0:04:37.27,0:04:39.27,Default,,0,0,0,,Жарайсың ба, Құдай!
Dialogue: 0,0:04:39.27,0:04:41.94,Default,,0,0,0,,Ой-оу! Аполлон ➡
Dialogue: 0,0:04:41.94,0:04:44.45,Default,,0,0,0,,Сіз кенеттен күшті шаралармен келдіңіз!
Dialogue: 0,0:04:44.45,0:04:46.45,Default,,0,0,0,,Мен бұған сене алмадым...
Dialogue: 0,0:04:46.45,0:04:48.62,Default,,0,0,0,,Аполлон Фамилияның шабуылы.
Dialogue: 0,0:04:48.62,0:04:52.12,Default,,0,0,0,,Сәлем, менің Белл-кунмен бірге махаббат ұясы!
Dialogue: 0,0:04:52.12,0:04:54.96,Default,,0,0,0,,Не? Кел, Белл-кун!
Dialogue: 0,0:04:54.96,0:04:56.96,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:04:56.96,0:04:59.26,Default,,0,0,0,,Қарғыс атсын! (Мысық адам) Уф!
Dialogue: 0,0:05:02.80,0:05:04.80,Default,,0,0,0,,Хмм, ха!
Dialogue: 0,0:05:07.14,0:05:10.54,Default,,0,0,0,,Цк. Ол түтіннің астында қашып кетті ме?
Dialogue: 0,0:05:12.97,0:05:15.14,Default,,0,0,0,,Бұны қаланың қақ ортасына орнатқанына сене алар емеспін.
Dialogue: 0,0:05:15.14,0:05:17.15,Default,,0,0,0,,Ха-ха... Қарғыс атсын.
Dialogue: 0,0:05:17.15,0:05:19.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:23.32,0:05:25.65,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:05:25.65,0:05:27.66,Default,,0,0,0,,Уау! Ха ха ха!
Dialogue: 0,0:05:27.66,0:05:30.99,Default,,0,0,0,,Белл-кун Әйтеуір, гильдияға барайық.
Dialogue: 0,0:05:30.99,0:05:32.96,Default,,0,0,0,,Ол жерде саған жау да тиісе алмайды!
Dialogue: 0,0:05:32.96,0:05:34.93,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:05:37.30,0:05:39.97,Default,,0,0,0,,- бұл тұйыққа тірелу! ?
Dialogue: 0,0:05:39.97,0:05:42.47,Default,,0,0,0,,Ұста, Құдай! Ха! ?
Dialogue: 0,0:05:42.47,0:05:45.74,Default,,0,0,0,,Хмф! Вааааааааааааааааааааааааа!
Dialogue: 0,0:05:48.31,0:05:50.31,Default,,0,0,0,,Бас тартқан дұрыс.
Dialogue: 0,0:05:50.31,0:05:52.98,Default,,0,0,0,,Ха!?
Dialogue: 0,0:05:52.98,0:05:55.48,Default,,0,0,0,,Аполлон өзіне ұнаған баланы таңдады➡
Dialogue: 0,0:05:55.48,0:05:57.65,Default,,0,0,0,,Мен сені жердің шетіне дейін қуамын.
Dialogue: 0,0:05:57.65,0:06:00.99,Default,,0,0,0,,Бізде де, Кассандрада да солай болды.
Dialogue: 0,0:06:00.99,0:06:03.99,Default,,0,0,0,,Қаладан қалаға Елден елге➡
Dialogue: 0,0:06:03.99,0:06:08.50,Default,,0,0,0,,Сізде идея болғанша, мәңгі және мәңгі.
Dialogue: 0,0:06:08.50,0:06:10.50,Default,,0,0,0,,Белл-кюн….
Dialogue: 0,0:06:10.50,0:06:12.50,Default,,0,0,0,,Нуфухухихи….
Dialogue: 0,0:06:12.50,0:06:14.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:14.50,0:06:17.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:17.01,0:06:20.01,Default,,0,0,0,,Берілмейсіз бе? Досыңа айналатын балаға➡
Dialogue: 0,0:06:20.01,0:06:22.34,Default,,0,0,0,,Мен тым қатал болғым келмейді.
Dialogue: 0,0:06:22.34,0:06:24.68,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:06:24.68,0:06:26.85,Default,,0,0,0,,№.
Dialogue: 0,0:06:26.85,0:06:29.52,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:29.52,0:06:32.52,Default,,0,0,0,,Онда алыңыз!
Dialogue: 0,0:06:32.52,0:06:34.76,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:34.76,0:06:36.76,Default,,0,0,0,,Уф….
Dialogue: 0,0:06:36.76,0:06:38.76,Default,,0,0,0,,Өрт болт!
Dialogue: 0,0:06:44.43,0:06:46.43,Default,,0,0,0,,Аһ!
Dialogue: 0,0:06:49.27,0:06:51.77,Default,,0,0,0,,Қашып барады Бұл жылдам.
Dialogue: 0,0:06:51.77,0:06:54.94,Default,,0,0,0,,Бұл бәрібір ысырап, сондықтан мен бас тартуым керек.
Dialogue: 0,0:06:54.94,0:06:57.11,Default,,0,0,0,,Дафне-чан.
Dialogue: 0,0:06:57.11,0:07:00.62,Default,,0,0,0,,Өйткені, ол баланы ынталандыратын нәрсе➡
Dialogue: 0,0:07:00.62,0:07:02.62,Default,,0,0,0,,Маған бұл жақсы емес сияқты.
Dialogue: 0,0:07:02.62,0:07:05.79,Default,,0,0,0,,Не, тағы бір прекогнитивті арман?
Dialogue: 0,0:07:05.79,0:07:09.29,Default,,0,0,0,,Иә... Жараланған қоян➡
Dialogue: 0,0:07:09.29,0:07:12.63,Default,,0,0,0,,Айдың үстінен ұшып, Күнді жұтамын...
Dialogue: 0,0:07:12.63,0:07:14.63,Default,,0,0,0,,Осылай жалғаса беретініне сенімдімін➡
Dialogue: 0,0:07:14.63,0:07:16.97,Default,,0,0,0,,Қайтымсыз...
Dialogue: 0,0:07:16.97,0:07:19.47,Default,,0,0,0,,Иә, иә, ақымақ ештеңе айтпа➡
Dialogue: 0,0:07:19.47,0:07:21.97,Default,,0,0,0,,Біз де сізге ереміз.
Dialogue: 0,0:07:21.97,0:07:26.14,Default,,0,0,0,,Аа, сен маған неге сенбейсің?
Dialogue: 0,0:07:33.95,0:07:35.95,Default,,0,0,0,,тым кеш.
Dialogue: 0,0:07:35.95,0:07:39.79,Default,,0,0,0,,Иә, мен мистер Беллдің кешіккеніне сене алар емеспін...
Dialogue: 0,0:07:39.79,0:07:42.12,Default,,0,0,0,,Жаман сезімде жалғыз мен бе?
Dialogue: 0,0:07:42.12,0:07:44.13,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:44.13,0:07:46.09,Default,,0,0,0,,Эй, сен мұны естідің бе? ?
Dialogue: 0,0:07:46.09,0:07:49.76,Default,,0,0,0,,Аполлон Фамилияның жігіттері қалада ашуланды!
Dialogue: 0,0:07:49.76,0:07:51.77,Default,,0,0,0,,Қарсылас – Хестия Фамилия!
Dialogue: 0,0:07:51.77,0:07:54.47,Default,,0,0,0,,Кішкентай Рукиді ұрып-соғып жатыр!
Dialogue: 0,0:07:54.47,0:07:56.44,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:07:58.61,0:08:01.61,Default,,0,0,0,,Мына бала... шабуыл жасап жатыр ма?
Dialogue: 0,0:08:01.61,0:08:03.95,Default,,0,0,0,,Иә! Apollo Familia➡
Dialogue: 0,0:08:03.95,0:08:06.61,Default,,0,0,0,,Барлығы Аргонавт-кунды қуып келе жатқан сияқты!
Dialogue: 0,0:08:06.61,0:08:09.95,Default,,0,0,0,,Қалада шу шықты!
Dialogue: 0,0:08:09.95,0:08:12.95,Default,,0,0,0,,Өтінемін, мені біртүрлі сезінбе, Эйс.
Dialogue: 0,0:08:12.95,0:08:16.62,Default,,0,0,0,,Мен сізге 18-ші қабатта көмектескен кездегі жағдай басқаша.
Dialogue: 0,0:08:16.62,0:08:19.46,Default,,0,0,0,,Хестия Фамилияға қол ұшын берген Манес➡
Dialogue: 0,0:08:19.46,0:08:22.63,Default,,0,0,0,,Мұны жасамаңыз.
Dialogue: 0,0:08:22.63,0:08:24.63,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:27.14,0:08:29.97,Default,,0,0,0,,Қарғыс атсын! Хахаха….
Dialogue: 0,0:08:29.97,0:08:32.17,Default,,0,0,0,,Кешіріңіз, Белл-кун.
Dialogue: 0,0:08:32.17,0:08:34.11,Default,,0,0,0,,Мен аяғымды сүйреп бара жаттым...
Dialogue: 0,0:08:34.11,0:08:36.44,Default,,0,0,0,,Бұл Құдайдың кінәсі емес!
Dialogue: 0,0:08:36.44,0:08:40.12,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:08:40.12,0:08:43.28,Default,,0,0,0,,《Сол эмблема...》
Dialogue: 0,0:08:43.28,0:08:45.79,Default,,0,0,0,,Уф, Белл-кун! ? Апыр-ай!
Dialogue: 0,0:08:45.79,0:08:47.79,Default,,0,0,0,,Хэ-хэ! Арх!
Dialogue: 0,0:08:47.79,0:08:50.63,Default,,0,0,0,,Арх! Гррр!
Dialogue: 0,0:08:50.63,0:08:52.99,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:08:58.13,0:09:00.64,Default,,0,0,0,,Гиакинтос мырза….
Dialogue: 0,0:09:00.64,0:09:03.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:03.30,0:09:06.14,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:06.14,0:09:08.14,Default,,0,0,0,,Арх! Гах...
Dialogue: 0,0:09:08.14,0:09:10.51,Default,,0,0,0,,Белл-кун! Ха!
Dialogue: 0,0:09:13.82,0:09:16.65,Default,,0,0,0,,Осы уақытқа дейін қашып құтылғаныңыз өте жақсы.
Dialogue: 0,0:09:16.65,0:09:18.62,Default,,0,0,0,,Белл Кранел.
Dialogue: 0,0:09:18.62,0:09:22.82,Default,,0,0,0,,Қуан, мен сенімен өзім айналысамын.
Dialogue: 0,0:09:24.83,0:09:26.83,Default,,0,0,0,,Арг. Ха...
Dialogue: 0,0:09:26.83,0:09:29.33,Default,,0,0,0,,Арх! Күрсін.
Dialogue: 0,0:09:29.33,0:09:32.67,Default,,0,0,0,,Хмф! Хахаха.
Dialogue: 0,0:09:32.67,0:09:35.90,Default,,0,0,0,,Ааааа! Қарғыс атсын.
Dialogue: 0,0:09:35.90,0:09:38.21,Default,,0,0,0,,Белл-кун... Белл-кун!
Dialogue: 0,0:09:42.24,0:09:45.75,Default,,0,0,0,,Белл-кун!
Dialogue: 0,0:09:45.75,0:09:48.42,Default,,0,0,0,,Оны дереу тоқтату керек!
Dialogue: 0,0:09:48.42,0:09:51.09,Default,,0,0,0,,Apollo Familia-ға қазір хабарлаңыз!
Dialogue: 0,0:09:51.09,0:09:54.26,Default,,0,0,0,,Қалада төбелескендер жазаланады!
Dialogue: 0,0:09:54.26,0:09:56.26,Default,,0,0,0,,Оны айтудың қажеті жоқ.
Dialogue: 0,0:09:56.26,0:09:59.59,Default,,0,0,0,,Біз алатын жазаларға дайын болуымыз керек.
Dialogue: 0,0:09:59.59,0:10:02.10,Default,,0,0,0,,Міне! Осылай жасап жатқанда➡
Dialogue: 0,0:10:02.10,0:10:04.43,Default,,0,0,0,,Хестия Фамилияға шабуыл жасалуда! ?
Dialogue: 0,0:10:04.43,0:10:06.43,Default,,0,0,0,,Себебі➡
Dialogue: 0,0:10:06.43,0:10:09.77,Default,,0,0,0,,Гильдия араласа алатын шектеулер бар.
Dialogue: 0,0:10:09.77,0:10:11.77,Default,,0,0,0,,Белл-кун….
Dialogue: 0,0:10:11.77,0:10:13.94,Default,,0,0,0,,Уф ха ха….
Dialogue: 0,0:10:13.94,0:10:18.75,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:10:20.78,0:10:23.79,Default,,0,0,0,,Аполлонға ғашық болған сенсің ➡
Dialogue: 0,0:10:23.79,0:10:26.12,Default,,0,0,0,,Мен оны жек көрем...
Dialogue: 0,0:10:26.12,0:10:28.12,Default,,0,0,0,,Бұл да Ұстаздың тілегі.
Dialogue: 0,0:10:28.12,0:10:31.29,Default,,0,0,0,,Мен сені даңқты отбасымның мүшесі етемін.
Dialogue: 0,0:10:31.29,0:10:33.63,Default,,0,0,0,,Хмм... хе.
Dialogue: 0,0:10:33.63,0:10:35.96,Default,,0,0,0,,Хаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:10:35.96,0:10:38.13,Default,,0,0,0,,Баяу.
Dialogue: 0,0:10:38.13,0:10:40.80,Default,,0,0,0,,Қоян сияқты үрме.
Dialogue: 0,0:10:40.80,0:10:42.80,Default,,0,0,0,,Аһ!
Dialogue: 0,0:10:42.80,0:10:44.81,Default,,0,0,0,,Уф….
Dialogue: 0,0:10:44.81,0:10:47.14,Default,,0,0,0,,Белл-кун!
Dialogue: 0,0:10:47.14,0:10:49.98,Default,,0,0,0,,Ух... ку....
Dialogue: 0,0:10:49.98,0:10:52.48,Default,,0,0,0,,Ку…гаха!
Dialogue: 0,0:10:52.48,0:10:55.98,Default,,0,0,0,,Гуфу… Гуфу….
Dialogue: 0,0:10:55.98,0:10:58.29,Default,,0,0,0,,Сіз әлі есіңізде ме?
Dialogue: 0,0:11:00.32,0:11:02.32,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:11:02.32,0:11:04.83,Default,,0,0,0,,Сенің түрің шіркін, сабағың жоқ.
Dialogue: 0,0:11:04.83,0:11:06.83,Default,,0,0,0,,Неліктен Аполлон мұндай әрекетке барды?
Dialogue: 0,0:11:06.83,0:11:08.83,Default,,0,0,0,,Сіз тіркелдіңіз бе?
Dialogue: 0,0:11:08.83,0:11:10.83,Default,,0,0,0,,Арх!
Dialogue: 0,0:11:10.83,0:11:14.50,Default,,0,0,0,,Оған жаным мен тәнімді арнаймын.
Dialogue: 0,0:11:14.50,0:11:18.01,Default,,0,0,0,,Ол адам туралы бәрін мен ғана қабылдай аламын...
Dialogue: 0,0:11:18.01,0:11:20.01,Default,,0,0,0,,Ах! қарақат….
Dialogue: 0,0:11:20.01,0:11:22.68,Default,,0,0,0,,Мен оны бәрібір кейін түзетемін.
Dialogue: 0,0:11:22.68,0:11:24.68,Default,,0,0,0,,Бір қол немесе аяқ➡
Dialogue: 0,0:11:24.68,0:11:26.68,Default,,0,0,0,,Оны кесуге болады.
Dialogue: 0,0:11:26.68,0:11:29.68,Default,,0,0,0,,Ха! ? Уф.
Dialogue: 0,0:11:29.68,0:11:33.32,Default,,0,0,0,,Ух... уф.
Dialogue: 0,0:11:33.32,0:11:37.33,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:37.33,0:11:42.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:42.33,0:11:45.10,Default,,0,0,0,,Сондықтан мен озық авантюристтерді жек көремін.
Dialogue: 0,0:11:47.34,0:11:49.60,Default,,0,0,0,,Қоңырау қашады.
Dialogue: 0,0:11:53.68,0:11:55.84,Default,,0,0,0,,Мерген?
Dialogue: 0,0:11:59.68,0:12:02.65,Default,,0,0,0,,Фуфуфу.
Dialogue: 0,0:12:06.02,0:12:09.86,Default,,0,0,0,,Ал, мен енді қаша алмаймын...
Dialogue: 0,0:12:09.86,0:12:11.83,Default,,0,0,0,,Ол адам қуанады…
Dialogue: 0,0:12:11.83,0:12:13.86,Default,,0,0,0,,Белл-кун, жақсысың ба?
Dialogue: 0,0:12:13.86,0:12:17.33,Default,,0,0,0,,Мықты бол. Кешіріңіз... Құдай...
Dialogue: 0,0:12:19.37,0:12:21.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:21.70,0:12:23.67,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:28.01,0:12:31.11,Default,,0,0,0,,Ку... Уф, осылай қалса...
Dialogue: 0,0:12:34.45,0:12:37.45,Default,,0,0,0,,Сіз қызықты нәрсе істеп жатырсыз.
Dialogue: 0,0:12:37.45,0:12:39.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:39.62,0:12:41.62,Default,,0,0,0,,Оны да араластырайық.
Dialogue: 0,0:12:41.62,0:12:43.63,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:43.63,0:12:47.13,Default,,0,0,0,,Балалар, менің Apollo Familia-ны қорғауды жоспарлайсыз ба?
Dialogue: 0,0:12:47.13,0:12:50.13,Default,,0,0,0,,Мен одақтасымның қаупінен бас тарта алмаймын!
Dialogue: 0,0:12:50.13,0:12:52.13,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:12:52.13,0:12:54.14,Default,,0,0,0,,Ааа!
Dialogue: 0,0:12:54.14,0:12:56.14,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:56.14,0:12:58.14,Default,,0,0,0,,Оны кінәлаңыз! Хмф!
Dialogue: 0,0:13:01.81,0:13:05.31,Default,,0,0,0,,Құрметті Белл! (Вэлф) Жақсысың ба, Белл!
Dialogue: 0,0:13:05.31,0:13:07.65,Default,,0,0,0,,Уэлф Лили! ?
Dialogue: 0,0:13:07.65,0:13:10.35,Default,,0,0,0,,Миаха! ? Неге тіпті сен!
Dialogue: 0,0:13:14.16,0:13:16.99,Default,,0,0,0,,Дүрбелеңді естіп, Такемиказучиге барыңыз➡
Dialogue: 0,0:13:16.99,0:13:19.16,Default,,0,0,0,,Мен қолдау сұрау үшін сонда болдым.
Dialogue: 0,0:13:19.16,0:13:21.16,Default,,0,0,0,,Мен оны уақытында орындағаныма қуаныштымын.
Dialogue: 0,0:13:21.16,0:13:23.50,Default,,0,0,0,,Миаха, сен...
Dialogue: 0,0:13:23.50,0:13:25.50,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:13:27.50,0:13:31.01,Default,,0,0,0,,Белл мырза, бұл жерден қашайық. Эх...
Dialogue: 0,0:13:31.01,0:13:33.14,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:33.14,0:13:35.64,Default,,0,0,0,,Бұны оларға қалдырыңыз. (Қоңырау/Гестия) Ха...
Dialogue: 0,0:13:35.64,0:13:37.65,Default,,0,0,0,,Міне болды! Кішкентай жаңа ойыншы!
Dialogue: 0,0:13:37.65,0:13:39.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:39.61,0:13:42.28,Default,,0,0,0,,Енді рақым жоқ. Бар!
Dialogue: 0,0:13:42.28,0:13:45.79,Default,,0,0,0,,Уф... уф. Қоңырау-доно!
Dialogue: 0,0:13:45.79,0:13:47.79,Default,,0,0,0,,Кешіріңіз, бәріңіз!
Dialogue: 0,0:13:51.46,0:13:54.13,Default,,0,0,0,,Хахаха... Белл-кун гильдиясынан➡
Dialogue: 0,0:13:54.13,0:13:56.16,Default,,0,0,0,,Біраз уақыт өтті➡
Dialogue: 0,0:13:56.16,0:13:58.17,Default,,0,0,0,,Осы жерден солтүстікке қарай жүріңіз!
Dialogue: 0,0:13:58.17,0:14:00.17,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:14:00.17,0:14:03.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:03.84,0:14:05.84,Default,,0,0,0,,Біз мұнымен айналысамыз.
Dialogue: 0,0:14:05.84,0:14:08.51,Default,,0,0,0,,Леди Белл және басқалары, гильдияға барыңыз.
Dialogue: 0,0:14:08.51,0:14:10.85,Default,,0,0,0,,Тазалай салысымен артыңыздан қуамын!
Dialogue: 0,0:14:10.85,0:14:14.02,Default,,0,0,0,,Бірақ! Жарайды, жүр!
Dialogue: 0,0:14:14.02,0:14:17.35,Default,,0,0,0,,Кешіріңіз! Мен оны сұрадым!
Dialogue: 0,0:14:17.35,0:14:20.02,Default,,0,0,0,,Лилисуке, мені қолда! Мен білемін!
Dialogue: 0,0:14:20.02,0:14:22.19,Default,,0,0,0,,Бірақ шын мәнінде Белл-самасыз➡
Dialogue: 0,0:14:22.19,0:14:24.19,Default,,0,0,0,,Менің ойымша, бұл жақсы ма?
Dialogue: 0,0:14:24.19,0:14:26.86,Default,,0,0,0,,Аа, егер қазір мен болсам➡
Dialogue: 0,0:14:26.86,0:14:30.03,Default,,0,0,0,,Хмф! Бұл әбден мүмкін емес пе?
Dialogue: 0,0:14:30.03,0:14:32.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:32.03,0:14:33.97,Default,,0,0,0,,Алаңдама, Лилисуке!
Dialogue: 0,0:14:33.97,0:14:36.64,Default,,0,0,0,,Лорд Уэлф!
Dialogue: 0,0:14:36.64,0:14:39.11,Default,,0,0,0,,Бұл сізді алдауына жол бермеңіз.
Dialogue: 0,0:14:41.81,0:14:44.48,Default,,0,0,0,,Хахахаха.
Dialogue: 0,0:14:44.48,0:14:46.75,Default,,0,0,0,,Чит Нуаа!
Dialogue: 0,0:14:49.48,0:14:52.32,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:14:52.32,0:14:54.62,Default,,0,0,0,,Сен осындасың ба, Арде?
Dialogue: 0,0:14:54.62,0:14:56.62,Default,,0,0,0,,Ах ха….
Dialogue: 0,0:14:58.66,0:15:02.50,Default,,0,0,0,,Занис мырза….
Dialogue: 0,0:15:02.50,0:15:04.50,Default,,0,0,0,,Сіздің жақсы болғаныңызға қуаныштымын.
Dialogue: 0,0:15:04.50,0:15:09.00,Default,,0,0,0,,Өйткені маған сені өлді деп айтты.
Dialogue: 0,0:15:09.00,0:15:12.84,Default,,0,0,0,,Арх! Ах!
Dialogue: 0,0:15:12.84,0:15:15.18,Default,,0,0,0,,Лилисуке! Сен не істеп жатырсың?
Dialogue: 0,0:15:15.18,0:15:18.51,Default,,0,0,0,,Тірекке не болды?
Dialogue: 0,0:15:18.51,0:15:21.85,Default,,0,0,0,,Лилисуке!
Dialogue: 0,0:15:21.85,0:15:25.69,Default,,0,0,0,,Құрметті Уэлф, Лили Soma Familia-ға оралады.
Dialogue: 0,0:15:25.69,0:15:27.86,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз. Белл мырзаға
Dialogue: 0,0:15:27.86,0:15:29.86,Default,,0,0,0,,хабарлаңыз.
Dialogue: 0,0:15:29.86,0:15:32.86,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:15:32.86,0:15:34.76,Default,,0,0,0,,Сәлем Лилисуке! Қайда бара жатырсың?
Dialogue: 0,0:15:34.76,0:15:38.43,Default,,0,0,0,,Сәлем! Қат! Сатан алғыр!
Dialogue: 0,0:15:38.43,0:15:40.60,Default,,0,0,0,,​​О?
Dialogue: 0,0:15:40.60,0:15:42.60,Default,,0,0,0,,《Вельф: Бұл эмблема》
Dialogue: 0,0:15:42.60,0:15:46.94,Default,,0,0,0,,Қат! Қайда бардың! Іздеу!
Dialogue: 0,0:15:46.94,0:15:48.94,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:15:48.94,0:15:51.61,Default,,0,0,0,,Амансың ба? Белл-кун.
Dialogue: 0,0:15:51.61,0:15:53.95,Default,,0,0,0,,Иә, әйтеуір...
Dialogue: 0,0:15:53.95,0:15:57.12,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:57.12,0:15:59.52,Default,,0,0,0,,Иә? иә….
Dialogue: 0,0:16:01.79,0:16:04.13,Default,,0,0,0,,Гильдия әлі алыс.
Dialogue: 0,0:16:04.13,0:16:06.13,Default,,0,0,0,,Қуғыншылар көп болады.
Dialogue: 0,0:16:06.13,0:16:08.63,Default,,0,0,0,,Аа...
Dialogue: 0,0:16:12.13,0:16:15.14,Default,,0,0,0,,Сіз мені естисіз бе, Белл Кранел? (2 адам) Ха! ?
Dialogue: 0,0:16:15.14,0:16:17.31,Default,,0,0,0,,Сіз қайда жасырсаңыз да➡
Dialogue: 0,0:16:17.31,0:16:19.81,Default,,0,0,0,,Біз сізді қудалай береміз.
Dialogue: 0,0:16:19.81,0:16:23.14,Default,,0,0,0,,Осы сәттен аман қалуға тырысудың пайдасы жоқ.
Dialogue: 0,0:16:23.14,0:16:26.15,Default,,0,0,0,,Жерде де, зынданда да солай!
Dialogue: 0,0:16:26.15,0:16:29.55,Default,,0,0,0,,Енді сіз үшін демалыс күндері болмайды деп ойлаңыз!
Dialogue: 0,0:16:31.49,0:16:33.42,Default,,0,0,0,,Ешқайда….
Dialogue: 0,0:16:33.42,0:16:36.92,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:16:36.92,0:16:38.93,Default,,0,0,0,,Белл-кун, мені тыңда.
Dialogue: 0,0:16:38.93,0:16:41.76,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, біздің болашағымыз жоқ.
Dialogue: 0,0:16:41.76,0:16:43.76,Default,,0,0,0,,Екі шешім бар.
Dialogue: 0,0:16:43.76,0:16:47.44,Default,,0,0,0,,Жеңіске жету мүмкіндігі жоқ шайқаспен күресуім керек пе?
Dialogue: 0,0:16:47.44,0:16:49.94,Default,,0,0,0,,Осы Орариодан қашқыңыз келе ме?
Dialogue: 0,0:16:49.94,0:16:51.94,Default,,0,0,0,,Аа...
Dialogue: 0,0:16:51.94,0:16:54.11,Default,,0,0,0,,Менің қасымда болсаң➡
Dialogue: 0,0:16:54.11,0:16:56.28,Default,,0,0,0,,Маған қайда баратыным маңызды емес!
Dialogue: 0,0:16:56.28,0:17:01.12,Default,,0,0,0,,Басқа адам бас тартқанша, мен сенімен өмір бойы қашып өтемін!
Dialogue: 0,0:17:01.12,0:17:05.29,Default,,0,0,0,,Құдаймен бірге...
Dialogue: 0,0:17:05.29,0:17:07.29,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:10.63,0:17:12.63,Default,,0,0,0,,Белл-кун.
Dialogue: 0,0:17:12.63,0:17:14.63,Default,,0,0,0,,Мен саған ұнайсың ба?
Dialogue: 0,0:17:14.63,0:17:16.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:16.63,0:17:18.63,Default,,0,0,0,,Бұл маңызды!
Dialogue: 0,0:17:18.63,0:17:20.64,Default,,0,0,0,,Мені жақсы көремін десең➡
Dialogue: 0,0:17:20.64,0:17:23.30,Default,,0,0,0,,Мен шешімдімін.
Dialogue: 0,0:17:23.30,0:17:28.31,Default,,0,0,0,,Сөздеріңізге сенсем, қолымнан бәрі келеді.
Dialogue: 0,0:17:28.31,0:17:30.31,Default,,0,0,0,,Қалағаныңызша ұрысуға болады!
Dialogue: 0,0:17:30.31,0:17:34.25,Default,,0,0,0,,Уау. Сен маған ұнайсың.
Dialogue: 0,0:17:34.25,0:17:36.42,Default,,0,0,0,,Сүйкімді, мен оған көмектесе алмаймын.
Dialogue: 0,0:17:36.42,0:17:39.09,Default,,0,0,0,,Мен сенің жаныңда мәңгі болғым келеді.
Dialogue: 0,0:17:39.09,0:17:41.09,Default,,0,0,0,,Мен сені бергім келмейді.
Dialogue: 0,0:17:41.09,0:17:45.43,Default,,0,0,0,,Құдай...
Dialogue: 0,0:17:45.43,0:17:47.93,Default,,0,0,0,,Белл-кун... сен➡
Dialogue: 0,0:17:47.93,0:17:50.60,Default,,0,0,0,,Мен туралы не ойлайсың?
Dialogue: 0,0:17:50.60,0:17:53.94,Default,,0,0,0,,Аа...
Dialogue: 0,0:17:53.94,0:17:55.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:55.94,0:17:58.61,Default,,0,0,0,,Мен сізді құрметтеймін!
Dialogue: 0,0:17:58.61,0:18:01.61,Default,,0,0,0,,Менің айтқым келгені бұл емес!
Dialogue: 0,0:18:01.61,0:18:05.01,Default,,0,0,0,,Ммммм!
Dialogue: 0,0:18:07.62,0:18:09.95,Default,,0,0,0,,Міне, су жолы болды!
Dialogue: 0,0:18:09.95,0:18:11.95,Default,,0,0,0,,Не!
Dialogue: 0,0:18:11.95,0:18:13.96,Default,,0,0,0,,Қашайық! Құдай!
Dialogue: 0,0:18:16.29,0:18:19.79,Default,,0,0,0,,Сәлем! Маңызды нәрсеге араласу!
Dialogue: 0,0:18:19.79,0:18:22.46,Default,,0,0,0,,Мен сені енді кешіре алмаймын! Белл-кун, бұл оңтүстік-батыс➡
Dialogue: 0,0:18:22.46,0:18:24.47,Default,,0,0,0,,Солтүстікке емес, оңтүстік-батысқа бағыттаңыз!
Dialogue: 0,0:18:24.47,0:18:26.47,Default,,0,0,0,,Иә! ? Оңтүстік-батыс➡
Dialogue: 0,0:18:26.47,0:18:28.47,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:18:30.97,0:18:32.94,Default,,0,0,0,,Жаудың қорғаны….
Dialogue: 0,0:18:32.94,0:18:34.94,Default,,0,0,0,,Аполлон Фамилия?
Dialogue: 0,0:18:34.94,0:18:38.21,Default,,0,0,0,,Аполлон осында болуы керек! Қазір қақпаны ашыңыз!
Dialogue: 0,0:19:00.97,0:19:02.97,Default,,0,0,0,,Сәлем Хестия.
Dialogue: 0,0:19:02.97,0:19:04.97,Default,,0,0,0,,Мен осы уақытқа дейін келдім➡
Dialogue: 0,0:19:04.97,0:19:06.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:06.97,0:19:09.31,Default,,0,0,0,,О... Парум-кун➡
Dialogue: 0,0:19:09.31,0:19:11.31,Default,,0,0,0,,Иә! Өтінемін, маған осы қолғаптарды беріңізші.
Dialogue: 0,0:19:11.31,0:19:13.58,Default,,0,0,0,,Е... иә….
Dialogue: 0,0:19:15.65,0:19:17.65,Default,,0,0,0,,Хмф! Хмм.
Dialogue: 0,0:19:17.65,0:19:19.65,Default,,0,0,0,,Gi! ?
Dialogue: 0,0:19:19.65,0:19:21.62,Default,,0,0,0,,Ахх...
Dialogue: 0,0:19:23.82,0:19:26.66,Default,,0,0,0,,Өте жақсы! Неге қабылдамасқа!
Dialogue: 0,0:19:26.66,0:19:28.66,Default,,0,0,0,,Соғыс ойындары!
Dialogue: 0,0:19:28.66,0:19:30.66,Default,,0,0,0,,Хехехе….
Dialogue: 0,0:19:30.66,0:19:33.10,Default,,0,0,0,,Екі құдайдың арасында келісім бар!
Dialogue: 0,0:19:33.10,0:19:35.27,Default,,0,0,0,,Жігіттер! Бұл соғыс ойыны!
Dialogue: 0,0:19:37.27,0:19:41.11,Default,,0,0,0,,Жарайсыңдар! Гильдияға соғыс ойынына өтініш беріңіз!
Dialogue: 0,0:19:41.11,0:19:44.11,Default,,0,0,0,,Уақытша Денат шақырылды!
Dialogue: 0,0:19:44.11,0:19:48.28,Default,,0,0,0,,Бәрі келе жатыр! Бізде фестиваль болмағанына көп уақыт болды!
Dialogue: 0,0:19:48.28,0:19:50.45,Default,,0,0,0,,Ереже құдайлардың алдында➡
Dialogue: 0,0:19:50.45,0:19:52.45,Default,,0,0,0,,Әділ шешейік.
Dialogue: 0,0:19:52.45,0:19:55.22,Default,,0,0,0,,Толық мәліметтер кейінірек беріледі.
Dialogue: 0,0:20:01.13,0:20:03.63,Default,,0,0,0,,Ха ха қоңырау! Лорд Хестия!
Dialogue: 0,0:20:03.63,0:20:06.43,Default,,0,0,0,,Ха, жақсы! Сенімен бәрі жақсы ма?
Dialogue: 0,0:20:06.43,0:20:09.44,Default,,0,0,0,,О, одан да көп... Кешіріңіз.
Dialogue: 0,0:20:09.44,0:20:11.47,Default,,0,0,0,,Лилисуке Soma Familia жігіттеріне бұрылды...
Dialogue: 0,0:20:11.47,0:20:13.44,Default,,0,0,0,,Лилия! ? Ха!
Dialogue: 0,0:20:15.81,0:20:17.81,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:17.81,0:20:19.78,Default,,0,0,0,,Күте тұрыңыз! Уф!
Dialogue: 0,0:20:19.78,0:20:21.78,Default,,0,0,0,,Белл-кунды қолдаушы-кун➡
Dialogue: 0,0:20:21.78,0:20:23.78,Default,,0,0,0,,Біз сізге міндетті түрде көмектесеміз.
Dialogue: 0,0:20:23.78,0:20:25.79,Default,,0,0,0,,Не істеу керек болса, соны істе.
Dialogue: 0,0:20:25.79,0:20:28.46,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:28.46,0:20:30.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:32.83,0:20:34.83,Default,,0,0,0,,Қарғыс атсын! Соғыс ойыны➡
Dialogue: 0,0:20:34.83,0:20:37.33,Default,,0,0,0,,Ол басталғанша біраз уақыт сатып алуға тырысыңыз.
Dialogue: 0,0:20:37.33,0:20:39.33,Default,,0,0,0,,Осы уақытта қолыңыздан келгенше көп нәрсені жасаңыз➡
Dialogue: 0,0:20:39.33,0:20:41.34,Default,,0,0,0,,Күшті болыңыз.
Dialogue: 0,0:20:41.34,0:20:43.67,Default,,0,0,0,,Міне, бізге жеңу керек➡
Dialogue: 0,0:20:43.67,0:20:46.51,Default,,0,0,0,,Бір ғана жол бар.
Dialogue: 0,0:20:46.51,0:20:48.64,Default,,0,0,0,,Күшті бол, Белл-кун.
Dialogue: 0,0:20:48.64,0:20:50.85,Default,,0,0,0,,Бүгін шабуыл жасаған балалардың бәрінен де көп.
Dialogue: 0,0:20:50.85,0:20:54.01,Default,,0,0,0,,Ең бастысы! Сіз жасай аласыз.
Dialogue: 0,0:20:54.01,0:20:56.32,Default,,0,0,0,,Жоқ, мұны тек сіз жасай аласыз!
Dialogue: 0,0:20:56.32,0:20:59.49,Default,,0,0,0,,Ха! иә….
Dialogue: 0,0:20:59.49,0:21:02.32,Default,,0,0,0,,Иә, Құдай!
Dialogue: 0,0:21:02.32,0:21:04.83,Default,,0,0,0,,Өтінемін! өтінемін!
Dialogue: 0,0:21:04.83,0:21:06.83,Default,,0,0,0,,Мен сізден бір нәрсе сұрағым келеді!
Dialogue: 0,0:21:06.83,0:21:09.50,Default,,0,0,0,,Маған Эйс Уолленштейнмен кездесуге рұқсат етіңіз!
Dialogue: 0,0:21:09.50,0:21:12.67,Default,,0,0,0,,Ақымақ болма, сен! Мен қауесетті естідім!
Dialogue: 0,0:21:12.67,0:21:15.17,Default,,0,0,0,,Мен Эйз мырзадан соғыс ойынына көмектесуін өтінемін➡
Dialogue: 0,0:21:15.17,0:21:17.17,Default,,0,0,0,,Сіз ұялмайсыз ба?
Dialogue: 0,0:21:17.17,0:21:19.17,Default,,0,0,0,,Бұл дұрыс емес! өтінемін!
Dialogue: 0,0:21:19.17,0:21:21.18,Default,,0,0,0,,Не шу?
Dialogue: 0,0:21:21.18,0:21:23.18,Default,,0,0,0,,Тион мырза!
Dialogue: 0,0:21:26.18,0:21:29.05,Default,,0,0,0,,Қарғыс атсын! Гррр.
Dialogue: 0,0:21:29.05,0:21:31.05,Default,,0,0,0,,Бұл жерден тез кет.
Dialogue: 0,0:21:31.05,0:21:35.96,Default,,0,0,0,,Мен мұндай ақымақ еліктеуді кешіре алмаймын, солай ма?
Dialogue: 0,0:21:35.96,0:21:38.06,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:21:40.46,0:21:42.46,Default,,0,0,0,,Хмф!
Dialogue: 0,0:21:42.46,0:21:44.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:51.31,0:21:53.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:53.31,0:21:55.31,Default,,0,0,0,,Yaho~ Аргонавт-кун!
Dialogue: 0,0:21:55.31,0:21:57.81,Default,,0,0,0,,Эйс-сан Тиона-сан!
Dialogue: 0,0:21:57.81,0:22:01.32,Default,,0,0,0,,Эйс сенің менің үйіме келгеніңді көргенін айтты.
Dialogue: 0,0:22:01.32,0:22:03.65,Default,,0,0,0,,Сосын көңілім көтеріліп, Tione➡ үшін спектакль қойдым
Dialogue: 0,0:22:03.65,0:22:05.65,Default,,0,0,0,,Осылайша мен соққыға жығылдым.
Dialogue: 0,0:22:05.65,0:22:08.82,Default,,0,0,0,,Біз бетпе-бет кездесе алмаймыз, солай ма?
Dialogue: 0,0:22:08.82,0:22:10.83,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:22:10.83,0:22:13.83,Default,,0,0,0,,Мен соғыс ойындары туралы естідім.
Dialogue: 0,0:22:13.83,0:22:16.50,Default,,0,0,0,,Отбасылық жағдайлар болғанымен➡
Dialogue: 0,0:22:16.50,0:22:18.80,Default,,0,0,0,,Мен сені тастап кеткенім дұрыс емес деп ойлаймын.
Dialogue: 0,0:22:21.67,0:22:23.67,Default,,0,0,0,,Мен соғыс ойынын жеңгім келеді➡
Dialogue: 0,0:22:23.67,0:22:25.67,Default,,0,0,0,,Арнайы дайындықтан өтуге бола ма?
Dialogue: 0,0:22:25.67,0:22:27.68,Default,,0,0,0,,Бұл қылыш не өзі?!➡
Dialogue: 0,0:22:27.68,0:22:29.68,Default,,0,0,0,,Жарайды, шешілді!
Dialogue: 0,0:22:29.68,0:22:31.85,Default,,0,0,0,,Мен де саған көмектесемін, Аполлон Фамилия➡
Dialogue: 0,0:22:31.85,0:22:33.95,Default,,0,0,0,,Оны жең! Аргонавт!
Dialogue: 0,0:22:33.95,0:22:36.78,Default,,0,0,0,,Рахмет, Тиона-сан➡
Dialogue: 0,0:22:36.78,0:22:38.99,Default,,0,0,0,,Мистер Көздер!
Dialogue: 0,0:22:38.99,0:22:41.66,Default,,0,0,0,,《Қоңырау: Күшті бол.
Dialogue: 0,0:22:41.66,0:22:43.66,Default,,0,0,0,,Барлығы үшін.
Dialogue: 0,0:22:43.66,0:22:46.03,Default,,0,0,0,,Сол адамға қарсы жеңіске жету》
Dialogue: 0,0:22:47.53,0:22:52.53,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
