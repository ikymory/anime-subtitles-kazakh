Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.81,0:00:10.89,Default,,0,0,0,,Мердігерлер ұтымды ойлайды дейді.
Dialogue: 0,0:00:11.88,0:00:15.82,Default,,0,0,0,,Әр уақытта және кез келген жағдайда сабырлы болу маңызды.
Dialogue: 0,0:00:16.07,0:00:19.40,Default,,0,0,0,,Ең жақсы жауапты шығаруға болатынын көрсетеді.
Dialogue: 0,0:00:21.57,0:00:23.45,Default,,0,0,0,,Сіз ояусыз ба? мысық
Dialogue: 0,0:00:25.99,0:00:27.58,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,0:00:28.29,0:00:29.25,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:00:29.70,0:00:31.79,Default,,0,0,0,,Тіпті келісімшарт иелері де қорқады
Dialogue: 0,0:00:32.17,0:00:34.21,Default,,0,0,0,,Тек эмоцияға берілмеңіз
Dialogue: 0,0:00:37.50,0:00:40.51,Default,,0,0,0,,Әсіресе мені жау тығылған жерге апарса.
Dialogue: 0,0:00:48.64,0:00:50.06,Default,,0,0,0,,Қайда бара жатырсың? мысық
Dialogue: 0,0:00:52.89,0:00:54.60,Default,,0,0,0,,Мен мердігермін
Dialogue: 0,0:00:54.81,0:00:56.86,Default,,0,0,0,,Неге екені белгісіз, қазір мысық.
Dialogue: 0,0:00:57.15,0:01:00.78,Default,,0,0,0,,Дегенмен, біз қазіргі жағдай туралы ұтымды пайымдаулар жасай аламыз.
Dialogue: 0,0:01:01.49,0:01:03.45,Default,,0,0,0,,Мен жаудың ортасындамын
Dialogue: 0,0:01:03.91,0:01:06.20,Default,,0,0,0,,Бұл сіздің ең жақсы ставкаңыз
Dialogue: 0,0:02:45.22,0:02:46.31,Default,,0,0,0,,Бұл әлі де ауырады ма?
Dialogue: 0,0:02:47.85,0:02:49.48,Default,,0,0,0,,Рахмет, бәрі жақсы.
Dialogue: 0,0:02:50.10,0:02:52.35,Default,,0,0,0,,Пандорадағы қарапайым адамдар
Dialogue: 0,0:02:52.90,0:02:55.69,Default,,0,0,0,,Секция бастығын тергесең де, ештеңе таппайсың!
Dialogue: 0,0:02:56.27,0:02:58.44,Default,,0,0,0,,Бірақ мен оны министрлер кабинетінен келеді деп күткен жоқпын.
Dialogue: 0,0:02:58.44,0:03:01.74,Default,,0,0,0,,Мен Пандораны шақырмайды деп ойлаймын.
Dialogue: 0,0:03:02.53,0:03:04.20,Default,,0,0,0,,Жапон полициясы іссапарға шықса
Dialogue: 0,0:03:04.70,0:03:08.66,Default,,0,0,0,,Шешім дипломатиялық мәселелерге қайшы келетін шығар.
Dialogue: 0,0:03:09.16,0:03:10.37,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:03:10.79,0:03:11.83,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:03:12.17,0:03:14.88,Default,,0,0,0,,Тергеу өкілеттігі ешқашан берілмеді.
Dialogue: 0,0:03:15.00,0:03:16.42,Default,,0,0,0,,Бұл Жапония ғой.
Dialogue: 0,0:03:17.38,0:03:18.17,Default,,0,0,0,,Сыртқы істер бөлімі 4
Dialogue: 0,0:03:20.05,0:03:20.55,Default,,0,0,0,,Иә
Dialogue: 0,0:03:21.22,0:03:21.76,Default,,0,0,0,,Менеджер
Dialogue: 0,0:03:22.59,0:03:23.84,Default,,0,0,0,,Менеджер қоңырау шалып жатыр.
Dialogue: 0,0:03:26.14,0:03:26.97,Default,,0,0,0,,Бұл Кирихара.
Dialogue: 0,0:03:27.60,0:03:28.81,Default,,0,0,0,,Hairidamae
Dialogue: 0,0:03:33.52,0:03:36.31,Default,,0,0,0,,Екі агент бұрыннан біледі.
Dialogue: 0,0:03:39.11,0:03:41.44,Default,,0,0,0,,Мен сенімен бірінші рет кездесіп тұрмын
Dialogue: 0,0:03:42.20,0:03:45.74,Default,,0,0,0,,MI6 Қиыр Шығыс аймағына жауапты.
Dialogue: 0,0:03:46.16,0:03:47.33,Default,,0,0,0,,Бұл Рикад.
Dialogue: 0,0:03:48.66,0:03:49.58,Default,,0,0,0,,Бұл Кирихара.
Dialogue: 0,0:03:50.50,0:03:52.58,Default,,0,0,0,,Сені келуді сұраған басқа ешкім емес.
Dialogue: 0,0:03:52.66,0:03:54.96,Default,,0,0,0,,Бұл шамамен 11 қараша.
Dialogue: 0,0:03:55.21,0:03:55.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:56.13,0:03:57.67,Default,,0,0,0,,Ашық сұраңыз
Dialogue: 0,0:03:58.42,0:04:00.76,Default,,0,0,0,,Оның қайда екенін білесің бе?
Dialogue: 0,0:04:02.05,0:04:03.72,Default,,0,0,0,,Сөзіңді қайтарып жатқан сияқтымын.
Dialogue: 0,0:04:03.93,0:04:05.51,Default,,0,0,0,,Мұндағы сызық.
Dialogue: 0,0:04:05.64,0:04:06.89,Default,,0,0,0,,Уг!?
Dialogue: 0,0:04:06.93,0:04:09.10,Default,,0,0,0,,Оның сол жерден жоғалып кеткені
Dialogue: 0,0:04:09.51,0:04:12.06,Default,,0,0,0,,Бұл сіздің миссияңыздың бір бөлігі емес пе?
Dialogue: 0,0:04:12.81,0:04:16.69,Default,,0,0,0,,Доктор Шрейдердің ұрлануымен байланысты болуы мүмкін.
Dialogue: 0,0:04:22.03,0:04:25.53,Default,,0,0,0,,Бір аптадан бері одан хабар жоқ.
Dialogue: 0,0:04:26.32,0:04:27.66,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:04:28.24,0:04:30.54,Default,,0,0,0,,Мұны да бәріміз білуіміз керек.
Dialogue: 0,0:04:30.99,0:04:34.66,Default,,0,0,0,,Ол әлі де MI6-ның ең жақсы агенті ме?
Dialogue: 0,0:04:35.37,0:04:38.96,Default,,0,0,0,,Әлде ол террористтің агенті болды ма?
Dialogue: 0,0:04:41.63,0:04:44.63,Default,,0,0,0,,Кездескен сайын жасарасың, ақпан.
Dialogue: 0,0:04:44.92,0:04:47.43,Default,,0,0,0,,Жоқ, мен оны Эмбер деп атауым керек.
Dialogue: 0,0:04:48.09,0:04:51.60,Default,,0,0,0,,Сіз үшін ештеңе өзгерген жоқ 11 қараша
Dialogue: 0,0:04:52.18,0:04:54.52,Default,,0,0,0,,Мен басқа адамның кім екенін білмеймін.
Dialogue: 0,0:04:54.60,0:04:55.39,Default,,0,0,0,,Жаңбырлы тұман?
Dialogue: 0,0:04:56.10,0:04:58.81,Default,,0,0,0,,Ол сіз іздеп жүрген адам ма?
Dialogue: 0,0:04:59.27,0:05:00.90,Default,,0,0,0,,Жоқ, менде ондай хобби жоқ.
Dialogue: 0,0:05:00.94,0:05:02.11,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:02.86,0:05:05.11,Default,,0,0,0,,Менің уақытым аз, сөйлесейік.
Dialogue: 0,0:05:05.61,0:05:06.49,Default,,0,0,0,,Маған кез келген нәрсені сұраңыз
Dialogue: 0,0:05:06.78,0:05:07.49,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:05:07.91,0:05:09.49,Default,,0,0,0,,Сонымен, сіздің сүйікті тағамыңыз қандай?
Dialogue: 0,0:05:09.87,0:05:10.49,Default,,0,0,0,,Apple
Dialogue: 0,0:05:10.91,0:05:12.66,Default,,0,0,0,,Менің де солай болуым кездейсоқтық.
Dialogue: 0,0:05:12.99,0:05:14.00,Default,,0,0,0,,Өтірікке толы
Dialogue: 0,0:05:14.29,0:05:15.33,Default,,0,0,0,,Біз бір-біріміз, солай ма?
Dialogue: 0,0:05:18.29,0:05:21.21,Default,,0,0,0,,Міне, негізгі тақырыпқа көшетін кез келді.
Dialogue: 0,0:05:21.71,0:05:22.38,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:23.13,0:05:25.59,Default,,0,0,0,,Мен бір ғана сұрағым бар
Dialogue: 0,0:05:25.92,0:05:29.84,Default,,0,0,0,,Сіз опасыздық жасаған қандай ұйым?
Dialogue: 0,0:05:30.47,0:05:31.30,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:05:31.72,0:05:35.10,Default,,0,0,0,,Менде бұл туралы айтатын тағы бір адам бар.
Dialogue: 0,0:05:43.98,0:05:45.23,Default,,0,0,0,,Осы жерді басыңыз
Dialogue: 0,0:05:49.24,0:05:50.49,Default,,0,0,0,,Доктор Шрейдер
Dialogue: 0,0:05:50.53,0:05:51.78,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:05:52.24,0:05:53.49,Default,,0,0,0,,Олардың достары?
Dialogue: 0,0:05:53.53,0:05:56.70,Default,,0,0,0,,Айтқаныңызға байланысты болуы мүмкін.
Dialogue: 0,0:05:58.71,0:06:02.54,Default,,0,0,0,,Сондықтан мен Пандораның ғалымымын.
Dialogue: 0,0:06:02.96,0:06:05.67,Default,,0,0,0,,Сіз қандай ұйым туралы айтып отырсыз?
Dialogue: 0,0:06:05.71,0:06:09.47,Default,,0,0,0,,Олар сіздің бұрын айтқаныңызды тыңдасын, соның ішінде.
Dialogue: 0,0:06:09.63,0:06:10.30,Default,,0,0,0,,Енді сен агент емессің.
Dialogue: 0,0:06:12.10,0:06:14.31,Default,,0,0,0,,Мұндағы қалыпты мөлшерлеме қандай?
Dialogue: 0,0:06:14.47,0:06:14.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:15.26,0:06:18.14,Default,,0,0,0,,Сонда қанша адам мердігер емес?
Dialogue: 0,0:06:18.60,0:06:19.69,Default,,0,0,0,,Барлығы мердігер.
Dialogue: 0,0:06:22.15,0:06:24.44,Default,,0,0,0,,Менің жалғыз одақтасым – сол мысық.
Dialogue: 0,0:06:24.69,0:06:25.90,Default,,0,0,0,,Бұл адам да мердігер
Dialogue: 0,0:06:30.03,0:06:32.70,Default,,0,0,0,,Бұрынғы уәде әлі де жарамды ма?
Dialogue: 0,0:06:33.28,0:06:36.45,Default,,0,0,0,,Мен не сұрасам да, сен мені ешқашан өлтірмейсің.
Dialogue: 0,0:06:37.04,0:06:38.04,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:06:42.88,0:06:46.42,Default,,0,0,0,,Менің зерттеуім өте қарапайым.
Dialogue: 0,0:06:47.21,0:06:50.88,Default,,0,0,0,,Егер сәтті болса, барлық келісімшарт иелері бұл планетадан жоғалады!
Dialogue: 0,0:06:52.47,0:06:53.01,Default,,0,0,0,,Не? !
Dialogue: 0,0:06:55.39,0:06:55.85,Default,,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,0:06:56.72,0:06:57.35,Default,,0,0,0,,Иә
Dialogue: 0,0:06:58.18,0:07:00.44,Default,,0,0,0,,Мао әлі тірі ме?
Dialogue: 0,0:07:01.14,0:07:03.44,Default,,0,0,0,,Жіп кесілгенше тірі
Dialogue: 0,0:07:04.40,0:07:06.23,Default,,0,0,0,,Эмбердің мақсаты қандай?
Dialogue: 0,0:07:06.48,0:07:09.03,Default,,0,0,0,,Өткенде Джин, қазір Мао
Dialogue: 0,0:07:09.11,0:07:13.36,Default,,0,0,0,,Оның үстіне, MI6-ның жігітімен кездесу уақыты келді.
Dialogue: 0,0:07:14.70,0:07:15.16,Default,,0,0,0,,Күміс
Dialogue: 0,0:07:16.03,0:07:19.08,Default,,0,0,0,,Сол кезде Эмбер саған не айтты?
Dialogue: 0,0:07:20.83,0:07:21.96,Default,,0,0,0,,Қара туралы
Dialogue: 0,0:07:26.38,0:07:29.46,Default,,0,0,0,,Қараның өткені мен болашағы
Dialogue: 0,0:07:36.68,0:07:38.06,Default,,0,0,0,,Эй, сәл күте тұрыңыз
Dialogue: 0,0:07:38.47,0:07:40.64,Default,,0,0,0,,Жалғыз баруға ниетіңіз жоқ деп ойлаймын.
Dialogue: 0,0:07:41.14,0:07:44.73,Default,,0,0,0,,Қаншалықты жақсы болсаңыз да, бұл жолы аман қалуыңызға кепілдік жоқ.
Dialogue: 0,0:07:45.44,0:07:46.94,Default,,0,0,0,,Маодан бас тартыңыз.
Dialogue: 0,0:07:47.48,0:07:49.78,Default,,0,0,0,,Дәл осындай жағдайда ол солай істейтін еді.
Dialogue: 0,0:07:51.07,0:07:52.82,Default,,0,0,0,,Эмбердің мақсаты мен.
Dialogue: 0,0:07:54.07,0:07:56.74,Default,,0,0,0,,Мен енді ешкімді тартқым келмейді.
Dialogue: 0,0:08:02.79,0:08:04.62,Default,,0,0,0,,Мен оны іздеуім керек пе?
Dialogue: 0,0:08:07.75,0:08:08.92,Default,,0,0,0,,Сіз қызыл бұршақ пастасын да ішесіз бе?
Dialogue: 0,0:08:10.92,0:08:12.84,Default,,0,0,0,,Уайымдаудың қажеті жоқ.
Dialogue: 0,0:08:13.88,0:08:17.26,Default,,0,0,0,,Адамның ешқандай із қалдыруы мүмкін емес.
Dialogue: 0,0:08:18.64,0:08:22.10,Default,,0,0,0,,Одан басқа неге ынтымақтаспайсың?
Dialogue: 0,0:08:22.48,0:08:24.98,Default,,0,0,0,,Бастықтың бұйрықтары? Немесе
Dialogue: 0,0:08:25.65,0:08:27.94,Default,,0,0,0,,Мен неге екенін білгім келеді
Dialogue: 0,0:08:28.65,0:08:29.48,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:08:29.94,0:08:32.40,Default,,0,0,0,,Ол неге олай айтты?
Dialogue: 0,0:08:33.78,0:08:36.24,Default,,0,0,0,,Бұдан былай дос та, жау да болмайды.
Dialogue: 0,0:08:36.99,0:08:39.08,Default,,0,0,0,,Өз түйсігіңізге сеніңіз
Dialogue: 0,0:08:45.83,0:08:52.05,Default,,0,0,0,,Доктор Шредер жоспардың құрылымдық теңдеуінің шешімін алған сияқты.
Dialogue: 0,0:08:52.51,0:08:56.43,Default,,0,0,0,,Үшінші зерттеу мұнарасының тобы да бізбен бірдей қорытынды жасайды.
Dialogue: 0,0:08:57.43,0:09:01.18,Default,,0,0,0,,Сонда сізге доктор Шредер енді керек емес пе?
Dialogue: 0,0:09:02.72,0:09:06.85,Default,,0,0,0,,Енді менде Метеор фрагментін алмастыратын бірдеңе бар,
Dialogue: 0,0:09:09.69,0:09:11.48,Default,,0,0,0,,Мұндай жоспар мүмкін емес!
Dialogue: 0,0:09:11.82,0:09:14.86,Default,,0,0,0,,Өкінішке орай, бұл мүмкін.
Dialogue: 0,0:09:15.15,0:09:17.20,Default,,0,0,0,,Оңтүстік Америкада сәтсіздікке ұшырасам да.
Dialogue: 0,0:09:17.74,0:09:20.62,Default,,0,0,0,,Аспан қақпасының жоғалып кетуіне не себеп болды?
Dialogue: 0,0:09:21.91,0:09:24.16,Default,,0,0,0,,Біз оны өшіріп тастағандай емеспіз.
Dialogue: 0,0:09:24.50,0:09:26.66,Default,,0,0,0,,Дәлірек айтсақ, жоғалып кеткен жоқ.
Dialogue: 0,0:09:27.04,0:09:29.88,Default,,0,0,0,,Біздің жоспарымыз орындалмай тұрып
Dialogue: 0,0:09:30.00,0:09:31.75,Default,,0,0,0,,Біртүрлі сәулелі құбылыс бар.
Dialogue: 0,0:09:32.05,0:09:35.63,Default,,0,0,0,,Осыдан кейін бірден Оңтүстік Америкадағы Аспан қақпасының айналасында 1500 км.
Dialogue: 0,0:09:35.84,0:09:38.93,Default,,0,0,0,,Барлық физикалық тәсілдерден бас тартыңыз
Dialogue: 0,0:09:39.22,0:09:41.60,Default,,0,0,0,,Қол сұғылмайтын аумаққа айналды.
Dialogue: 0,0:09:41.85,0:09:46.06,Default,,0,0,0,,Одан ағып жатқан ланцернопт реакциясы
Dialogue: 0,0:09:46.10,0:09:48.44,Default,,0,0,0,,Тозақ қақпасы тәрізді аюлар жұбынан және т.б.
Dialogue: 0,0:09:48.56,0:09:51.90,Default,,0,0,0,,Аспан қақпасы әлі де бар деген болжам бар.
Dialogue: 0,0:09:52.02,0:09:54.19,Default,,0,0,0,,Қолымыз да, аяғымыз да жоқ.
Dialogue: 0,0:09:54.36,0:09:58.49,Default,,0,0,0,,Бірақ неге бұл жолы болды?
Dialogue: 0,0:09:58.49,0:10:01.78,Default,,0,0,0,,Менің есептеуімде қате болуы мүмкін емес.
Dialogue: 0,0:10:01.78,0:10:04.79,Default,,0,0,0,,Онда мен білмейтін бірдеңе болуы керек.
Dialogue: 0,0:10:09.37,0:10:13.04,Default,,0,0,0,,-де? Токиода осындай нәрсе жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:10:13.63,0:10:17.51,Default,,0,0,0,,Әйтпесе, бұл жолы шынымен де жоғалып кетеміз.
Dialogue: 0,0:10:18.30,0:10:21.14,Default,,0,0,0,,Бұл сіз болашаққа қарап тұрған сияқтысыз.
Dialogue: 0,0:10:21.43,0:10:23.10,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:10:23.51,0:10:24.93,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:10:25.22,0:10:26.56,Default,,0,0,0,,Дәлелдеуге рұқсат етіңіз.
Dialogue: 0,0:10:27.93,0:10:28.69,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:10:30.06,0:10:32.44,Default,,0,0,0,,Сіз бұл жерден кеткеннен кейін өлесіз.
Dialogue: 0,0:10:48.16,0:10:49.54,Default,,0,0,0,,Эй, сен қалай ойлайсың?
Dialogue: 0,0:10:49.75,0:10:52.00,Default,,0,0,0,,Ол қалай өледі?
Dialogue: 0,0:10:52.42,0:10:55.46,Default,,0,0,0,,Біз де өлім жазасына кесілді.
Dialogue: 0,0:10:55.92,0:10:58.05,Default,,0,0,0,,Бұл тек сол жігітке қатысты емес.
Dialogue: 0,0:10:58.46,0:10:59.59,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:11:00.09,0:11:01.76,Default,,0,0,0,,Әлі тәжірибенің ортасында
Dialogue: 0,0:11:02.34,0:11:04.26,Default,,0,0,0,,Келісім-шарт иесі үшін бұл бата.
Dialogue: 0,0:11:04.55,0:11:06.81,Default,,0,0,0,,Егер Эмбердің әңгімесі рас болса
Dialogue: 0,0:11:08.47,0:11:11.60,Default,,0,0,0,,Сізге көмекке келетін достарыңыз жоқ па?
Dialogue: 0,0:11:12.27,0:11:14.61,Default,,0,0,0,,Мердігерлер – ұтымды тіршілік иелері
Dialogue: 0,0:11:14.94,0:11:18.94,Default,,0,0,0,,Ешкім өлетінін біле тұра секіретіндей ақымақ емес.
Dialogue: 0,0:11:20.19,0:11:23.20,Default,,0,0,0,,Кем дегенде, мен осылай істейтін едім
Dialogue: 0,0:11:39.71,0:11:41.59,Default,,0,0,0,,Қара қырғын кірді
Dialogue: 0,0:11:42.09,0:11:42.84,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:11:43.72,0:11:45.76,Default,,0,0,0,,Мұнда ешкім өлмеуі керек.
Dialogue: 0,0:11:47.81,0:11:50.31,Default,,0,0,0,,Ұйымға енді ол қажет емес
Dialogue: 0,0:12:09.24,0:12:12.29,Default,,0,0,0,,Сізді кеш жібергенім үшін кешіріңіз.
Dialogue: 0,0:12:12.58,0:12:13.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:18.21,0:12:20.17,Default,,0,0,0,,Мен қарашаны таптым
Dialogue: 0,0:12:23.01,0:12:23.42,Default,,0,0,0,,Қайда?
Dialogue: 0,0:12:35.35,0:12:36.40,Default,,0,0,0,,(Миямура) Хмм… Өлмегенің жөн болар
Dialogue: 0,0:12:37.65,0:12:38.23,Default,,0,0,0,,Күміс
Dialogue: 0,0:12:40.11,0:12:40.90,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:12:47.74,0:12:48.28,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:11.10,0:13:11.97,Default,,0,0,0,,Кәріптас
Dialogue: 0,0:13:20.23,0:13:24.28,Default,,0,0,0,,Мәселені ертерек шешкіңіз келе ме?
Dialogue: 0,0:13:24.32,0:13:25.11,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:13:26.15,0:13:28.62,Default,,0,0,0,,Сіздің жалғыз жұмысыңыз сізді тоқтату, солай ма?
Dialogue: 0,0:13:30.78,0:13:31.91,Default,,0,0,0,,Қара! Артында қалды!
Dialogue: 0,0:13:58.44,0:14:00.02,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:14:00.90,0:14:03.65,Default,,0,0,0,,Менен тағы не алмақсың?
Dialogue: 0,0:14:04.69,0:14:07.11,Default,,0,0,0,,Мәліметтерді басқа мысықтан сұраңыз.
Dialogue: 0,0:14:08.95,0:14:10.11,Default,,0,0,0,,Мен саған бәрін айтып беремін
Dialogue: 0,0:14:21.21,0:14:22.17,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:14:33.30,0:14:33.89,Default,,0,0,0,,Қара!
Dialogue: 0,0:14:45.44,0:14:46.28,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:15:05.25,0:15:10.38,Default,,0,0,0,,Қандай жағдай болмасын, біз бұл оқиғаның кейіпкері бола алмайтын сияқтымыз.
Dialogue: 0,0:15:11.51,0:15:13.47,Default,,0,0,0,,Қалғаныңыз үшін рахмет, Неко-чан.
Dialogue: 0,0:15:21.69,0:15:22.19,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:15:23.98,0:15:26.61,Default,,0,0,0,,Ішіңізбен жатып, қолыңызды еденге жайлап қойыңыз!
Dialogue: 0,0:15:28.28,0:15:28.99,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:15:52.22,0:15:53.01,Default,,0,0,0,,Доктор Шрейдер!
Dialogue: 0,0:15:53.34,0:15:54.14,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:15:54.84,0:15:55.80,Default,,0,0,0,,Доктор Шрейдер!
Dialogue: 0,0:15:58.10,0:16:00.06,Default,,0,0,0,,Мен жылдам тексеруден өттім.
Dialogue: 0,0:16:00.64,0:16:03.77,Default,,0,0,0,,Дәрігердің миында естеліктердің қайта жазылуының ізі де жоқ.
Dialogue: 0,0:16:04.19,0:16:05.48,Default,,0,0,0,,Өмірлік көрсеткіштері де қалыпты.
Dialogue: 0,0:16:08.61,0:16:09.98,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:10.57,0:16:11.28,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:16:13.28,0:16:13.91,Default,,0,0,0,,Менеджер
Dialogue: 0,0:16:14.24,0:16:15.11,Default,,0,0,0,,Гокурудада
Dialogue: 0,0:16:15.95,0:16:16.66,Default,,0,0,0,,Dr.
Dialogue: 0,0:16:17.83,0:16:18.74,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:16:19.20,0:16:21.54,Default,,0,0,0,,Бұл жағдайдың себебі Оңтүстік Америка.
Dialogue: 0,0:16:22.79,0:16:24.33,Default,,0,0,0,,Бетперде киген мердігер
Dialogue: 0,0:16:24.67,0:16:27.04,Default,,0,0,0,,Сол кісінің құдіретінің арқасында.
Dialogue: 0,0:16:28.38,0:16:30.38,Default,,0,0,0,,Тәжірибені жылдам қайта бастаймыз
Dialogue: 0,0:16:30.42,0:16:31.67,Default,,0,0,0,,Олардың сізден озып кетуіне жол бермеңіз
Dialogue: 0,0:16:31.71,0:16:32.72,Default,,0,0,0,,Олардың сізден озып кетуіне жол бермеңіз
Dialogue: 0,0:16:32.76,0:16:33.55,Default,,0,0,0,,Dr.
Dialogue: 0,0:16:34.59,0:16:36.93,Default,,0,0,0,,Эксперимент қайта басталды
Dialogue: 0,0:16:41.31,0:16:42.23,Default,,0,0,0,,Жерде не бар?
Dialogue: 0,0:16:43.06,0:16:45.06,Default,,0,0,0,,Дәрігерді Пандораға апарыңыз.
Dialogue: 0,0:16:45.56,0:16:48.31,Default,,0,0,0,,Бірақ дәрігердің әлі де істейтін ісі бар.
Dialogue: 0,0:16:48.65,0:16:49.82,Default,,0,0,0,,Біз де солай.
Dialogue: 0,0:16:51.15,0:16:52.19,Default,,0,0,0,,Құрметпен
Dialogue: 0,0:16:55.07,0:16:55.78,Default,,0,0,0,,Директор!
Dialogue: 0,0:16:56.86,0:16:58.24,Default,,0,0,0,,Мойынсұнудан басқа амал жоқ
Dialogue: 0,0:17:04.75,0:17:05.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:06.25,0:17:08.54,Default,,0,0,0,,Дәрігер оларға бәрін айтты ма?
Dialogue: 0,0:17:09.25,0:17:10.71,Default,,0,0,0,,Сіз айтқандай
Dialogue: 0,0:17:11.00,0:17:15.55,Default,,0,0,0,,Жоспарларды келесі Ұлы дақ цикліне дейін кейінге қалдыру қауіпті сияқты
Dialogue: 0,0:17:16.38,0:17:17.22,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:17:17.93,0:17:21.60,Default,,0,0,0,,Ол кісінің билік етуіне қамқорлық жасады.
Dialogue: 0,0:17:22.56,0:17:23.02,Default,,0,0,0,,Сонымен
Dialogue: 0,0:17:32.61,0:17:34.11,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:17:34.57,0:17:36.61,Default,,0,0,0,,Мен өз тапсырмамды орындадым.
Dialogue: 0,0:17:38.62,0:17:39.37,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:17:40.03,0:17:42.54,Default,,0,0,0,,Ұйым үлгісі туралы көбірек біліңіз.
Dialogue: 0,0:17:43.33,0:17:46.54,Default,,0,0,0,,Сіз қорқып қалдыңыз.
Dialogue: 0,0:17:47.21,0:17:50.21,Default,,0,0,0,,Мен сенің сырыңды ашамын деп
Dialogue: 0,0:17:51.29,0:17:55.67,Default,,0,0,0,,Мен ең жақсы бағынушымды жоғалтып алудан көбірек қорықтым.
Dialogue: 0,0:17:57.26,0:17:59.51,Default,,0,0,0,,Тек сіз білесіз
Dialogue: 0,0:18:00.55,0:18:04.10,Default,,0,0,0,,Кимидачи Мердігерге келетін соңғы сәтке дейін
Dialogue: 0,0:18:05.77,0:18:06.64,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:18:08.10,0:18:09.27,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:11.44,0:18:15.32,Default,,0,0,0,,Егер теру сигналы тоқтаса, 15 секунд ішінде хабарлама қалдырыңыз.
Dialogue: 0,0:18:17.78,0:18:18.49,Default,,0,0,0,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 0,0:18:19.70,0:18:21.24,Default,,0,0,0,,Мен тыныш отыруды жоспарладым.
Dialogue: 0,0:18:22.20,0:18:26.41,Default,,0,0,0,,Сізге қауіп төніп тұрған жағдайды жасаған сияқтысыз.
Dialogue: 0,0:18:27.71,0:18:30.21,Default,,0,0,0,,Мен саған айтамын, бұл әзіл.
Dialogue: 0,0:19:01.49,0:19:05.58,Default,,0,0,0,,Бағаны соңына дейін адал төлеу керек емес пе?
Dialogue: 0,0:19:15.71,0:19:16.05,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:17.96,0:19:21.51,Default,,0,0,0,,Неліктен ол мұны істеуге мәжбүр болды?
Dialogue: 0,0:19:22.47,0:19:24.39,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:19:27.14,0:19:29.73,Default,,0,0,0,,Артық ештеңе айтпаған дұрыс
Dialogue: 0,0:19:31.02,0:19:35.65,Default,,0,0,0,,Сол себепті әлгі кісі ештеңе айтпастан өлді.
Dialogue: 0,0:19:37.36,0:19:41.61,Default,,0,0,0,,Бұл мердігерге тән ақылға қонымды пікір.
Dialogue: 0,0:19:43.36,0:19:45.49,Default,,0,0,0,,Сенің сезімдеріңізге шынымды айтсам қуаныштымын.
Dialogue: 0,0:19:46.03,0:19:47.66,Default,,0,0,0,,Рахмет Мисаки
Dialogue: 0,0:20:00.42,0:20:03.93,Default,,0,0,0,,Мен ақыры жоспарланған қуыршақ санын жинай алдым.
Dialogue: 0,0:20:06.93,0:20:08.68,Default,,0,0,0,,Уақытты енді кері қайтару мүмкін емес
Dialogue: 0,0:20:25.74,0:20:27.28,Default,,0,0,0,,Мен сізге не үшін көмектесуім керек?
Dialogue: 0,0:20:27.87,0:20:29.83,Default,,0,0,0,,Мұндай жағдайда ең жақсы әрекет
Dialogue: 0,0:20:29.99,0:20:31.91,Default,,0,0,0,,Мен сені жалғыз қалдырамын.
Dialogue: 0,0:20:32.66,0:20:36.42,Default,,0,0,0,,Түсіну үшін мердігердің ақылға қонымды пікірі қажет емес.
Dialogue: 0,0:20:36.96,0:20:38.67,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:20:41.80,0:20:43.76,Default,,0,0,0,,Балалар сендер ақымақсыңдар.
Dialogue: 0,0:20:44.59,0:20:46.30,Default,,0,0,0,,Ол жалғыз ақымақ
Dialogue: 0,0:20:51.93,0:20:53.89,Default,,0,0,0,,Тағы не? Шұғыл бизнес
Dialogue: 0,0:20:54.56,0:20:55.23,Default,,0,0,0,,О
Dialogue: 0,0:20:56.44,0:20:59.11,Default,,0,0,0,,MI6 күні жігіт қайтыс болды
Dialogue: 0,0:20:59.73,0:21:01.11,Default,,0,0,0,,Шынымен бе? ! сары
Dialogue: 0,0:21:02.65,0:21:05.86,Default,,0,0,0,,Өзіңізбен бірге бастығыңызды және оның кейбір қарамағындағыларды алыңыз.
Dialogue: 0,0:21:06.91,0:21:07.99,Default,,0,0,0,,Ұйымдастыру
Dialogue: 0,0:21:08.66,0:21:12.29,Default,,0,0,0,,Олар Маоның бар екенін анықтауға біраз уақыт қалды.
Dialogue: 0,0:21:12.58,0:21:14.62,Default,,0,0,0,,Бірақ бұған дейін біліңіз
Dialogue: 0,0:21:15.37,0:21:17.25,Default,,0,0,0,,Онда нақты не болды?
Dialogue: 0,0:21:17.96,0:21:21.09,Default,,0,0,0,,Ол кісі өлетінін білген.
Dialogue: 0,0:21:23.67,0:21:27.59,Default,,0,0,0,,Менің тірі қалуымның себебі бар сияқты.
Dialogue: 0,0:21:28.64,0:21:30.39,Default,,0,0,0,,Мен мұны Эмберден естідім.
Dialogue: 0,0:21:31.89,0:21:36.44,Default,,0,0,0,,Ұйым біздің барлық мердігерлерді осы дүниеден өшіруді көздеп отыр.
Dialogue: 0,0:21:36.60,0:21:37.06,Default,,0,0,0,,Не?
Dialogue: 0,0:21:37.98,0:21:40.23,Default,,0,0,0,,Эмбердің достары қарсы
Dialogue: 0,0:21:40.48,0:21:43.99,Default,,0,0,0,,Сондықтан бес жыл бұрын Оңтүстік Америка қақпасын жойдым.
Dialogue: 0,0:21:44.36,0:21:46.57,Default,,0,0,0,,Күте тұрыңыз, сіз нені айтып тұрсыз? Сіз
Dialogue: 0,0:21:46.95,0:21:47.61,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:48.41,0:21:51.28,Default,,0,0,0,,Оның бұл әрекетіне ешқандай себеп жоқ!
Dialogue: 0,0:21:51.99,0:21:53.87,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:21:54.33,0:21:56.46,Default,,0,0,0,,Ол адам ондай адам емес.
Dialogue: 0,0:22:05.47,0:22:07.18,Default,,0,0,0,,Мұның мәні неде? !
Dialogue: 0,0:23:41.23,0:23:44.15,Default,,0,0,0,,Екеуі орындарынан айырылып, қаланы аралады.
Dialogue: 0,0:23:44.77,0:23:46.98,Default,,0,0,0,,Ер адам қайтыс болған жерде кездесіңіз
Dialogue: 0,0:23:47.61,0:23:49.49,Default,,0,0,0,,Ойнап жүрген екі адам
Dialogue: 0,0:23:50.32,0:23:53.57,Default,,0,0,0,,Менің жүрегімде сақтаған күмәнім аузымнан шықпайды.
Dialogue: 0,0:23:54.20,0:23:59.04,Default,,0,0,0,,Уақыт бозғылт ымырт түсті ойлармен өтеді.
Dialogue: 0,0:24:00.08,0:24:04.29,Default,,0,0,0,,Соңына дейін кері санақ біз білмей тұрып басталды.
Dialogue: 0,0:24:05.13,0:24:08.34,Default,,0,0,0,,Ал ол қоштасады
Dialogue: 0,0:24:09.84,0:24:15.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
