Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:56.55,0:00:59.55,Default,,0,0,0,,Қозғалмай, қолдарыңды көтеріп, ақырын маған қарай бұрыл.
Dialogue: 0,0:01:10.65,0:01:11.90,Default,,0,0,0,,Жалғыз мердігер?
Dialogue: 0,0:01:19.53,0:01:20.70,Default,,0,0,0,,Жұлдыз солтүстік-шығысқа жылжиды
Dialogue: 0,0:01:21.16,0:01:22.12,Default,,0,0,0,,Мердігер
Dialogue: 0,0:01:23.29,0:01:26.50,Default,,0,0,0,,Астрономиялық департамент хабарлаған GR-544 белсенділігін растаңыз
Dialogue: 0,0:01:26.79,0:01:28.87,Default,,0,0,0,,Әдетте Луи француз агенті ретінде белгілі.
Dialogue: 0,0:01:29.67,0:01:31.67,Default,,0,0,0,,Түсінді Жел бағытын тексеру
Dialogue: 0,0:01:32.00,0:01:34.25,Default,,0,0,0,,Полиция күштерін шығысқа қарай жылжытыңыз және оны қоршаңыз.
Dialogue: 0,0:01:34.63,0:01:35.21,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:01:38.43,0:01:41.35,Default,,0,0,0,,Жұлдыздың мердігер Луис екенін барлық мүшелерге хабарлаңыз
Dialogue: 0,0:01:41.89,0:01:44.93,Default,,0,0,0,,Қабілет - ауырлық күші адам Ikukan тапаншасын пайдалануға мүмкіндік береді
Dialogue: 0,0:01:45.39,0:01:47.52,Default,,0,0,0,,Оны байқаған бойда атудан тартынбаңыз.
Dialogue: 0,0:02:39.82,0:02:43.24,Default,,0,0,0,,Бұл келісім-шарттың бағасы ма? Бұл қиын сұрақ.
Dialogue: 0,0:02:54.29,0:02:56.13,Default,,0,0,0,,Бақылау рухының қуыршағы?
Dialogue: 0,0:03:11.73,0:03:12.27,Default,,0,0,0,,Заттар
Dialogue: 0,0:03:12.60,0:03:13.81,Default,,0,0,0,,Ши...Яран
Dialogue: 0,0:03:24.45,0:03:26.70,Default,,0,0,0,,Рас, әйел заттың иесі.
Dialogue: 0,0:03:34.75,0:03:35.88,Default,,0,0,0,,Қай ұйым?
Dialogue: 0,0:03:36.38,0:03:39.46,Default,,0,0,0,,Жағдайға байланысты әйелден заттар алынуы мүмкін.
Dialogue: 0,0:03:40.22,0:03:41.59,Default,,0,0,0,,Балалар мен сендерге бере аламын.
Dialogue: 0,0:03:42.26,0:03:45.89,Default,,0,0,0,,Бұл мердігерге лайық ақылға қонымды шешім.
Dialogue: 0,0:03:57.82,0:03:59.48,Default,,0,0,0,,Күміс полиция
Dialogue: 0,0:04:00.40,0:04:03.49,Default,,0,0,0,,А нүктесін өтуге үш минут қалды
Dialogue: 0,0:04:03.86,0:04:06.28,Default,,0,0,0,,Шығаратын кез келді.
Dialogue: 0,0:04:10.37,0:04:13.41,Default,,0,0,0,,Күте тұрыңыз, мен бармайынша ол маған ештеңе бермейді.
Dialogue: 0,0:04:14.33,0:04:16.38,Default,,0,0,0,,Тоқта, Қара, оны әлі де пайдалана аласың.
Dialogue: 0,0:04:17.38,0:04:21.05,Default,,0,0,0,,Беттеріңе қарап құсқым келеді.
Dialogue: 0,0:04:27.39,0:04:29.10,Default,,0,0,0,,Бас жұлдыз түсіп кетті.
Dialogue: 0,0:04:34.02,0:04:36.10,Default,,0,0,0,,Бұл қалада бұл заттың пайда болғанына он жыл болды.
Dialogue: 0,0:04:36.86,0:04:40.02,Default,,0,0,0,,Сол қабырғасыз пейзаждың қандай болғанын есте сақтау қиын.
Dialogue: 0,0:04:40.94,0:04:42.86,Default,,0,0,0,,Сонда не болды?
Dialogue: 0,0:04:43.90,0:04:45.28,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:04:45.61,0:04:46.61,Default,,0,0,0,,Ешкім білмейді
Dialogue: 0,0:04:47.70,0:04:49.41,Default,,0,0,0,,Біз адамдар жасай алдық
Dialogue: 0,0:04:49.91,0:04:53.58,Default,,0,0,0,,Тек сол биік қабырғаларды тұрғызып, бәрін жабыңыз.
Dialogue: 0,0:04:54.41,0:04:55.08,Default,,0,0,0,,Жалпы атау
Dialogue: 0,0:04:55.29,0:04:56.08,Default,,0,0,0,,Тозақ қақпасы
Dialogue: 0,0:04:58.92,0:05:00.71,Default,,0,0,0,,Ерекше қабілеті бар адамдарды мердігерлер деп атайды
Dialogue: 0,0:05:01.46,0:05:05.13,Default,,0,0,0,,Қуыршақ деп аталатын пассивті орталардың болуы алғаш рет расталды.
Dialogue: 0,0:05:06.01,0:05:09.14,Default,,0,0,0,,Бұл нәрсе пайда болғаннан кейін бір апта өтті.
Dialogue: 0,0:06:45.23,0:06:47.44,Default,,0,0,0,,Жалпы аты Луис Шын аты белгісіз
Dialogue: 0,0:06:47.82,0:06:51.41,Default,,0,0,0,,Францияның Сыртқы қауіпсіздік дирекциясында күшті қатысуы бар агент
Dialogue: 0,0:06:51.66,0:06:52.41,Default,,0,0,0,,Мердігер
Dialogue: 0,0:06:53.41,0:06:55.62,Default,,0,0,0,,Мессиер мінез-құлық GR-544
Dialogue: 0,0:06:56.08,0:06:57.50,Default,,0,0,0,,Қабілет - бұл гравитация блогы
Dialogue: 0,0:06:58.29,0:07:01.71,Default,,0,0,0,,Француз билігі қазір бұл оқиғаға қатысы бар екенін жоққа шығарады
Dialogue: 0,0:07:02.17,0:07:03.00,Default,,0,0,0,,Өлім себебі
Dialogue: 0,0:07:03.50,0:07:07.30,Default,,0,0,0,,Белгісіз Тұншығу немесе дәрілік реакция белгілері жоқ
Dialogue: 0,0:07:07.84,0:07:09.55,Default,,0,0,0,,Бұл мердігердің жұмысы ма?
Dialogue: 0,0:07:10.09,0:07:11.59,Default,,0,0,0,,Астрономиялық бөлімнің есебі бойынша
Dialogue: 0,0:07:12.18,0:07:17.81,Default,,0,0,0,,Белсенділігі сол уақытта расталған ең ықтимал жұлдыз саны BK-201
Dialogue: 0,0:07:18.39,0:07:19.81,Default,,0,0,0,,Расталмаған сан
Dialogue: 0,0:07:20.52,0:07:21.39,Default,,0,0,0,,Расталмаған
Dialogue: 0,0:07:21.69,0:07:22.27,Default,,0,0,0,,Иә
Dialogue: 0,0:07:22.65,0:07:25.56,Default,,0,0,0,,Қатысты деп есептелетін барлық істер шешілмей қалды
Dialogue: 0,0:07:26.07,0:07:28.19,Default,,0,0,0,,Жәбірленушінің өлімінің себебі Қабілетті Жеміс Аю
Dialogue: 0,0:07:28.65,0:07:30.07,Default,,0,0,0,,Мен ештеңе түсінбеймін
Dialogue: 0,0:07:30.95,0:07:35.20,Default,,0,0,0,,Қарғыс алған келісімшарт иесі деген қауесет осы ма?
Dialogue: 0,0:07:36.54,0:07:38.24,Default,,0,0,0,,Өсек деген жай ғана өсек
Dialogue: 0,0:07:38.95,0:07:40.70,Default,,0,0,0,,Егер сізді қорқытса не істеу керек?
Dialogue: 0,0:07:42.67,0:07:43.54,Default,,0,0,0,,Заттар үшін
Dialogue: 0,0:07:43.96,0:07:47.42,Default,,0,0,0,,Ұлттық зертханадан Panpora ядросына рұқсатсыз кіру
Dialogue: 0,0:07:47.46,0:07:49.96,Default,,0,0,0,,Құпия ақпарат алынып тасталды
Dialogue: 0,0:07:50.55,0:07:54.64,Default,,0,0,0,,Мазмұны туралы білуге құқығымыз жоқ.
Dialogue: 0,0:07:54.89,0:07:55.66,Default,,0,0,0,,Әйел
Dialogue: 0,0:07:56.22,0:07:58.22,Default,,0,0,0,,Чиаки Шинода 26 Вэй
Dialogue: 0,0:07:58.68,0:08:02.39,Default,,0,0,0,,Қақпа ішіндегі физикалық қасиеттер туралы диссертациямен магистратура
Dialogue: 0,0:08:02.69,0:08:05.15,Default,,0,0,0,,Оқуды бітіргеннен кейін ұлттық ғылыми-зерттеу институтында жұмыс істеді
Dialogue: 0,0:08:05.61,0:08:07.40,Default,,0,0,0,,Екі апта бойы рұқсатсыз жұмыста болмауы
Dialogue: 0,0:08:07.73,0:08:09.53,Default,,0,0,0,,Қазіргі тұрған жері белгісіз
Dialogue: 0,0:08:10.19,0:08:13.61,Default,,0,0,0,,Мердігерлерге қатысты істер дер кезінде хабарланды.
Dialogue: 0,0:08:14.11,0:08:15.82,Default,,0,0,0,,ME жадты жою
Dialogue: 0,0:08:16.49,0:08:17.87,Default,,0,0,0,,Бұл менің ата-анам туралы.
Dialogue: 0,0:08:18.24,0:08:21.50,Default,,0,0,0,,Сол кезде байланыс болмағаны анықталды.
Dialogue: 0,0:08:22.21,0:08:26.58,Default,,0,0,0,,Қақпаға қатысты ақпараттың ағып кетуі тікелей ұлттық қауіпсіздік дағдарысын тудырады.
Dialogue: 0,0:08:27.09,0:08:30.80,Default,,0,0,0,,Куәгерлер тірідей жау қолына түспеуі керек.
Dialogue: 0,0:08:31.51,0:08:33.42,Default,,0,0,0,,Түсіндім, Кирихара.
Dialogue: 0,0:08:36.89,0:08:39.26,Default,,0,0,0,,Мердігермен байланыста болған кез келген қоғам мүшесі
Dialogue: 0,0:08:39.60,0:08:41.27,Default,,0,0,0,,Оның жады өшірілді
Dialogue: 0,0:08:42.14,0:08:45.56,Default,,0,0,0,,Мердігерге қатысты барлық ақпарат өте маңызды.
Dialogue: 0,0:08:46.86,0:08:49.19,Default,,0,0,0,,Бірақ бұл қауесеттерді тоқтата алмайды.
Dialogue: 0,0:08:50.03,0:08:52.44,Default,,0,0,0,,«Монстр өлтіруші» роботы
Dialogue: 0,0:08:53.20,0:08:55.32,Default,,0,0,0,,Адамдардың оларға деген сезімі
Dialogue: 0,0:08:55.70,0:08:57.11,Default,,0,0,0,,Қорқыныш пен күдікке толы
Dialogue: 0,0:08:58.58,0:09:00.45,Default,,0,0,0,,Менің атым Мисаки Кирихара
Dialogue: 0,0:09:01.37,0:09:05.21,Default,,0,0,0,,This case is with a contractor called BK-201.
Dialogue: 0,0:09:05.75,0:09:09.54,Default,,0,0,0,,Бұл біздің Қоғамдық қауіпсіздік министрлігінің 4-ші Сыртқы істер бөлімімен алғашқы кездесуіміз болады.
Dialogue: 0,0:09:44.41,0:09:45.75,Default,,0,0,0,,Кім курьер
Dialogue: 0,0:09:47.21,0:09:49.17,Default,,0,0,0,,Religious solicitation Because it's on time
Dialogue: 0,0:09:49.17,0:09:49.92,Default,,0,0,0,,№.
Dialogue: 0,0:09:50.00,0:09:52.63,Default,,0,0,0,,That's the gravestone guy who always calls me.
Dialogue: 0,0:09:53.05,0:09:55.46,Default,,0,0,0,,Шулы. Менің ойымша, бұл оларға әлі қажет емес.
Dialogue: 0,0:09:55.72,0:09:58.22,Default,,0,0,0,,Ол емес, вокзал алдындағы фудо...
Dialogue: 0,0:09:58.30,0:10:01.35,Default,,0,0,0,,Ah, the electrical shop next to the real estate shop.
Dialogue: 0,0:10:01.60,0:10:03.43,Default,,0,0,0,,Мен көптен күттім. Жүр, тез, тезірек.
Dialogue: 0,0:10:07.52,0:10:09.48,Default,,0,0,0,,Біраздан бері солай болды.
Dialogue: 0,0:10:11.61,0:10:13.82,Default,,0,0,0,,Әй, әке, тұрсаң жаман көрінеді.
Dialogue: 0,0:10:19.03,0:10:23.08,Default,,0,0,0,,Сіз қандай да бір жолмен цифрлық жүйеге өтсеңіз, ешқандай шу шықпайды дедіңіз.
Dialogue: 0,0:10:28.96,0:10:31.58,Default,,0,0,0,,Бұл ескі теледидар ма? Сіз оны түзете аласыз ба?
Dialogue: 0,0:10:32.38,0:10:33.88,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:10:36.17,0:10:38.34,Default,,0,0,0,,...Сондықтан ол көпшілікке жарияланбады.
Dialogue: 0,0:10:39.76,0:10:41.05,Default,,0,0,0,,Ах.
Dialogue: 0,0:10:42.51,0:10:44.72,Default,,0,0,0,,Эцуто, менің ойымша, бұл Ли...
Dialogue: 0,0:10:45.06,0:10:46.06,Default,,0,0,0,,Бұл И Сун Сун.
Dialogue: 0,0:10:46.60,0:10:47.77,Default,,0,0,0,,Ли мырза
Dialogue: 0,0:10:48.19,0:10:50.10,Default,,0,0,0,,Мен бұл туралы жылжымайтын мүлік агентінен естідім.
Dialogue: 0,0:10:50.48,0:10:51.56,Default,,0,0,0,,Қытайдан
Dialogue: 0,0:10:51.56,0:10:53.36,Default,,0,0,0,,Иә, мен халықаралық студентпін.
Dialogue: 0,0:10:54.57,0:10:57.07,Default,,0,0,0,,Well, the customs are different so it must be difficult.
Dialogue: 0,0:10:57.40,0:11:00.82,Default,,0,0,0,,Көршілермен достық қарым-қатынаста болыңыз және қиындық тудырмауға тырысыңыз.
Dialogue: 0,0:11:01.32,0:11:01.95,Default,,0,0,0,,Иә
Dialogue: 0,0:11:06.29,0:11:07.29,Default,,0,0,0,,Харагучи мырза
Dialogue: 0,0:11:07.66,0:11:11.75,Default,,0,0,0,,I'm going to enter this room from today...uhm.
Dialogue: 0,0:11:12.00,0:11:12.79,Default,,0,0,0,,Бұл И Сун Сун.
Dialogue: 0,0:11:13.04,0:11:14.42,Default,,0,0,0,,Танысқаныма қуаныштымын, Ли мырза
Dialogue: 0,0:11:21.97,0:11:24.05,Default,,0,0,0,,Қажет болғаннан артық тіл табысудың қажеті жоқ.
Dialogue: 0,0:11:24.51,0:11:25.10,Default,,0,0,0,,Иә
Dialogue: 0,0:11:31.27,0:11:33.02,Default,,0,0,0,,Мақсат расталды
Dialogue: 0,0:11:33.69,0:11:35.48,Default,,0,0,0,,Барып, жағдайды көрейік пе?
Dialogue: 0,0:11:36.40,0:11:38.23,Default,,0,0,0,,Қара қырғыш немесе басқа нәрсе
Dialogue: 0,0:12:30.00,0:12:33.71,Default,,0,0,0,,Нененене, Аяме-чанның жасөспірім екені сөзсіз.
Dialogue: 0,0:12:34.37,0:12:35.25,Default,,0,0,0,,Тағы да 22.
Dialogue: 0,0:12:36.46,0:12:39.55,Default,,0,0,0,,Атсу, келесі аптада сенің туған күнің, сондықтан келіп дұрыстап тойла.
Dialogue: 0,0:12:40.17,0:12:41.46,Default,,0,0,0,,Әй, бұл тұтынушылар да.
Dialogue: 0,0:12:41.76,0:12:42.97,Default,,0,0,0,,А, түсіндім, түсіндім.
Dialogue: 0,0:12:43.93,0:12:45.72,Default,,0,0,0,,Барлығы, барлығы
Dialogue: 0,0:12:46.09,0:12:47.64,Default,,0,0,0,,Не... не істеп жатыр деп ойлайсың?
Dialogue: 0,0:12:48.01,0:12:50.01,Default,,0,0,0,,Иә, қаржылық мәселелер.
Dialogue: 0,0:12:50.56,0:12:51.31,Default,,0,0,0,,Collection etc.
Dialogue: 0,0:12:51.60,0:12:52.35,Default,,0,0,0,,late late
Dialogue: 0,0:12:52.85,0:12:53.64,Default,,0,0,0,,Land raiser
Dialogue: 0,0:12:54.02,0:12:54.89,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:55.15,0:12:56.31,Default,,0,0,0,,Harder and harder
Dialogue: 0,0:12:56.73,0:12:58.86,Default,,0,0,0,,Өтірік~ Мен мұнымен міндетті түрде барамын.
Dialogue: 0,0:13:00.19,0:13:02.07,Default,,0,0,0,,Бұл мемлекеттік қызметші. A civil servant.
Dialogue: 0,0:13:02.65,0:13:03.49,Default,,0,0,0,,Қазірше сау бол,
Dialogue: 0,0:13:03.78,0:13:06.86,Default,,0,0,0,,Мұндай сұмдық мемлекеттік қызметшілер ғана бар.
Dialogue: 0,0:13:09.87,0:13:12.95,Default,,0,0,0,,Кешіріңіз, тұтынушы. It's time for a change.
Dialogue: 0,0:13:14.04,0:13:16.17,Default,,0,0,0,,Қош бол, келесі жолы мені ұсыныңыз.
Dialogue: 0,0:13:17.29,0:13:18.75,Default,,0,0,0,,Келесі аптада уәде бер.
Dialogue: 0,0:13:19.46,0:13:20.34,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:13:24.93,0:13:27.64,Default,,0,0,0,,Қазіргі балалар ұқсас деп ойладың ба?
Dialogue: 0,0:13:28.18,0:13:29.97,Default,,0,0,0,,Менің алған әсерім басқаша.
Dialogue: 0,0:13:30.56,0:13:32.56,Default,,0,0,0,,Әйелдерді макияж арқылы өзгертуге болады.
Dialogue: 0,0:13:40.98,0:13:43.78,Default,,0,0,0,,Бірақ бұл жаман идея, солай емес пе?
Dialogue: 0,0:13:44.11,0:13:46.78,Default,,0,0,0,,Жарайды, мен саған түбіртек беремін.
Dialogue: 0,0:13:47.07,0:13:49.62,Default,,0,0,0,,Жоқ, бұл дұрыс емес. Егер менеджер білсе...
Dialogue: 0,0:13:50.28,0:13:51.03,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:13:57.37,0:13:58.79,Default,,0,0,0,,Барлығы, мен қиналдым.
Dialogue: 0,0:13:59.25,0:14:01.46,Default,,0,0,0,,Менің балам аңдыушы сияқты әрекет еткенде
Dialogue: 0,0:14:01.75,0:14:02.55,Default,,0,0,0,,…
Dialogue: 0,0:14:03.84,0:14:05.40,Default,,0,0,0,,Бұл полиция, жолдан кет.
Dialogue: 0,0:14:10.97,0:14:11.64,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:14:46.72,0:14:47.67,Default,,0,0,0,,Сізді қуып жатыр ма?
Dialogue: 0,0:14:50.43,0:14:51.05,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:14:55.39,0:14:56.18,Default,,0,0,0,,Жоқ, қашпа.
Dialogue: 0,0:14:56.48,0:14:57.06,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:15:30.97,0:15:32.30,Default,,0,0,0,,Мен жұлдыздарға қарап отырдым
Dialogue: 0,0:15:33.35,0:15:33.97,Default,,0,0,0,,Иә
Dialogue: 0,0:15:34.64,0:15:35.68,Default,,0,0,0,,Осындай қалада
Dialogue: 0,0:15:36.81,0:15:37.43,Default,,0,0,0,,Иә
Dialogue: 0,0:15:38.89,0:15:42.90,Default,,0,0,0,,Мына жерден көріп тұрған жұлдызды аспан қазір бәрі жалған.
Dialogue: 0,0:15:47.69,0:15:50.07,Default,,0,0,0,,Мен сені бір жерде кездестірдім.
Dialogue: 0,0:15:54.28,0:15:55.24,Default,,0,0,0,,Харагучи мырза
Dialogue: 0,0:15:56.49,0:15:59.08,Default,,0,0,0,,Дұрыс. 202 бөлме.
Dialogue: 0,0:15:59.62,0:16:02.12,Default,,0,0,0,,Мен бүгін көрші үйге көшіп келген Лимін.
Dialogue: 0,0:16:04.67,0:16:05.75,Default,,0,0,0,,I have to go now
Dialogue: 0,0:16:07.13,0:16:07.71,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:08.21,0:16:09.09,Default,,0,0,0,,2-эпизод: Буггарати келеді
Dialogue: 0,0:16:53.88,0:16:55.93,Default,,0,0,0,,Чиаки Бұл менмін, Жан.
Dialogue: 0,0:16:57.18,0:16:57.76,Default,,0,0,0,,Жан?
Dialogue: 0,0:16:58.10,0:16:58.81,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,0:16:59.47,0:17:01.68,Default,,0,0,0,,Жан, Луи не болып жатыр?
Dialogue: 0,0:17:01.93,0:17:06.15,Default,,0,0,0,,Quietly, Louis has come up with a situation that he can't let go of right now.
Dialogue: 0,0:17:07.23,0:17:07.90,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,0:17:08.40,0:17:11.11,Default,,0,0,0,,Полицейлер сияқты, кенеттен дүкенге келіңіз.
Dialogue: 0,0:17:11.61,0:17:12.94,Default,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:17:13.57,0:17:16.20,Default,,0,0,0,,Сізбен басқа біреу хабарласты ма?
Dialogue: 0,0:17:20.08,0:17:23.62,Default,,0,0,0,,Мен сізге дәл қазір айта алмаймын. Мен қауіпсіз жерде тығылып жүрмін.
Dialogue: 0,0:17:24.54,0:17:28.00,Default,,0,0,0,,Менде әлі де бар. Қазір қайда?
Dialogue: 0,0:17:30.30,0:17:34.59,Default,,0,0,0,,Луи ешқашан өзінен басқа ешкімге айтпауы керек.
Dialogue: 0,0:17:35.09,0:17:36.13,Default,,0,0,0,,Дос болсаң да
Dialogue: 0,0:17:37.89,0:17:40.56,Default,,0,0,0,,Луимен сәйкес келу қауіпті.
Dialogue: 0,0:17:57.11,0:17:57.82,Default,,0,0,0,,Сіз
Dialogue: 0,0:17:58.16,0:17:59.57,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:18:10.63,0:18:12.00,Default,,0,0,0,,No, go quickly.
Dialogue: 0,0:18:13.55,0:18:14.09,Default,,0,0,0,,Қашыңыз
Dialogue: 0,0:18:16.84,0:18:18.18,Default,,0,0,0,,Lancel Nobuto синхротронды сәулелену
Dialogue: 0,0:18:34.65,0:18:35.94,Default,,0,0,0,,Мердігер
Dialogue: 0,0:19:06.98,0:19:10.40,Default,,0,0,0,,Көп болуы керек...
Dialogue: 0,0:19:10.98,0:19:15.61,Default,,0,0,0,,Жоспарды өзгерту сақтықпен жасалуы керек, себебі олар күтпеген кедергілерді тудыруы мүмкін.
Dialogue: 0,0:19:16.74,0:19:18.36,Default,,0,0,0,,Same as this guy
Dialogue: 0,0:19:21.28,0:19:24.20,Default,,0,0,0,,Егер сіз оны осылай тізсеңіз, әдемі болады деп ойлаймын.
Dialogue: 0,0:19:24.87,0:19:26.49,Default,,0,0,0,,Бұл таңқаларлық қиын
Dialogue: 0,0:19:27.16,0:19:31.75,Default,,0,0,0,,Алайда бұл нені білдіретінін білмеймін.
Dialogue: 0,0:19:32.42,0:19:36.84,Default,,0,0,0,,Бұл мен төлеуім керек келісім-шарттың бағасы.
Dialogue: 0,0:19:48.18,0:19:49.27,Default,,0,0,0,,Луи қайтыс болды
Dialogue: 0,0:19:52.27,0:19:54.52,Default,,0,0,0,,Өтірік емес, Луи өлді.
Dialogue: 0,0:19:55.36,0:19:56.40,Default,,0,0,0,,Ол өлтірілді.
Dialogue: 0,0:19:57.69,0:19:58.94,Default,,0,0,0,,Бұл есептен тыс болды.
Dialogue: 0,0:20:00.32,0:20:02.99,Default,,0,0,0,,Мен Луиден де жақсы келісімшарт иесі болатынына сене алмаймын.
Dialogue: 0,0:20:03.87,0:20:07.45,Default,,0,0,0,,Мердігер Луис та мердігер болып табылады
Dialogue: 0,0:20:08.45,0:20:11.41,Default,,0,0,0,,Сіз білмеуіңіз керек еді.
Dialogue: 0,0:20:14.38,0:20:15.59,Default,,0,0,0,,Алда тұрған адам кім?
Dialogue: 0,0:20:16.75,0:20:19.05,Default,,0,0,0,,Бұрын менің басымнан ұрған адам
Dialogue: 0,0:20:19.84,0:20:21.30,Default,,0,0,0,,Ол енді тірі емес шығар.
Dialogue: 0,0:20:22.09,0:20:23.89,Default,,0,0,0,,Бір-бірімізді білетін сияқтымыз.
Dialogue: 0,0:20:24.30,0:20:26.93,Default,,0,0,0,,Мен...білмеймін. Біз бүгін бірінші рет кездестік.
Dialogue: 0,0:20:27.97,0:20:28.89,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:20:29.39,0:20:31.10,Default,,0,0,0,,Менің уақытым жоқ.
Dialogue: 0,0:20:31.48,0:20:33.77,Default,,0,0,0,,Жылдам әдісті қолдануға рұқсат етіңіз.
Dialogue: 0,0:20:39.69,0:20:40.69,Default,,0,0,0,,Бұл күтпеген жағдай.
Dialogue: 0,0:20:41.24,0:20:45.41,Default,,0,0,0,,Бұлай көрінсе де, аздап ауырады, біз де келісімшарт иелері.
Dialogue: 0,0:20:46.24,0:20:51.50,Default,,0,0,0,,Қуыршақтардан айырмашылығы, олардың тұлғасын бағдарламаға байланысты жазуға болады.
Dialogue: 0,0:20:58.55,0:20:59.59,Default,,0,0,0,,Мен қатысуды сезіндім
Dialogue: 0,0:21:00.17,0:21:00.92,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:21:02.55,0:21:03.63,Default,,0,0,0,,Менің ойымша, бұл ештеңе емес.
Dialogue: 0,0:21:03.63,0:21:04.55,Default,,0,0,0,,Рухты бақылау?
Dialogue: 0,0:21:05.76,0:21:07.97,Default,,0,0,0,,Олай болса, оны тек мердігер ғана көре алады.
Dialogue: 0,0:21:14.77,0:21:15.44,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:21:23.65,0:21:27.41,Default,,0,0,0,,Біртүрлі Электрондық құлыпта үш жақты қорғаныс жүйесі болды.
Dialogue: 0,0:21:27.91,0:21:31.74,Default,,0,0,0,,Иә, бұл кездейсоқтық екенін елестету қиын.
Dialogue: 0,0:23:42.88,0:23:44.25,Default,,0,0,0,,Бұлттардың арасына үңілу
Dialogue: 0,0:23:44.55,0:23:45.75,Default,,0,0,0,,Жалған жұлдызды аспан
Dialogue: 0,0:23:46.80,0:23:50.01,Default,,0,0,0,,Жылы сөз тұйық жүректі босатады
Dialogue: 0,0:23:50.72,0:23:52.68,Default,,0,0,0,,Әйел алға шығады
Dialogue: 0,0:23:53.76,0:23:55.10,Default,,0,0,0,,Қарадан да күңгірт
Dialogue: 0,0:23:55.60,0:23:57.22,Default,,0,0,0,,Түбі жоқ балшық болуы мүмкін
Dialogue: 0,0:23:58.77,0:24:01.02,Default,,0,0,0,,Адамның жалған аспанда не көретіні
Dialogue: 0,0:24:01.77,0:24:04.15,Default,,0,0,0,,Өмірдің көк ұшқыны сөнеді
Dialogue: 0,0:24:05.57,0:24:08.15,Default,,0,0,0,,Жұлдыздар құлады
Dialogue: 0,0:24:09.65,0:24:15.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
