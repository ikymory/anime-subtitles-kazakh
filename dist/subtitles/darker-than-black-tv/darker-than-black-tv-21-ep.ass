Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:43.56,0:00:45.77,Default,,0,0,0,,Мен түсіндім, бұл жақсы ма?
Dialogue: 0,0:00:45.81,0:00:46.98,Default,,0,0,0,,Шешілген Шешілген
Dialogue: 0,0:01:10.25,0:01:11.88,Default,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:01:15.21,0:01:18.68,Default,,0,0,0,,Бұл біткен соң, мүмкіндігінше одан құтылуға тырысайық.
Dialogue: 0,0:01:51.21,0:01:53.29,Default,,0,0,0,,Не болды? Талдау аяқталды ма?
Dialogue: 0,0:01:53.59,0:01:55.50,Default,,0,0,0,,Жоқ! Доктор Шрейдер...
Dialogue: 0,0:03:34.94,0:03:35.94,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:03:37.86,0:03:38.57,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:03:45.41,0:03:47.41,Default,,0,0,0,,Күдікті! Негізгі көшеге қашыңыз!
Dialogue: 0,0:03:57.25,0:03:59.34,Default,,0,0,0,,Мен сені күннің ортасында ұстап алайын
Dialogue: 0,0:03:59.80,0:04:00.46,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:04:01.46,0:04:02.09,Default,,0,0,0,,Менеджер
Dialogue: 0,0:04:10.10,0:04:14.23,Default,,0,0,0,,Екеуі де американдық дәретханаларды нысанаға алуды тапсырған сияқты.
Dialogue: 0,0:04:14.52,0:04:15.31,Default,,0,0,0,,Мына жігіттер?
Dialogue: 0,0:04:15.98,0:04:16.81,Default,,0,0,0,,EPR
Dialogue: 0,0:04:17.36,0:04:20.90,Default,,0,0,0,,Террористік жарылыстар сериясын жасауға әрекеттенген мердігерлер тобы.
Dialogue: 0,0:04:21.44,0:04:24.61,Default,,0,0,0,,Біз бұрын тұтқындаған адам да мүше екенін мойындады.
Dialogue: 0,0:04:24.95,0:04:26.91,Default,,0,0,0,,Мені ұйымдастырушыға қандай анықтамалар жетелейді?
Dialogue: 0,0:04:27.12,0:04:28.20,Default,,0,0,0,,Іздеу
Dialogue: 0,0:04:29.12,0:04:32.70,Default,,0,0,0,,жақсы нәтиже бермеуі мүмкін
Dialogue: 0,0:04:33.16,0:04:36.21,Default,,0,0,0,,Кейбір естеліктер бұзылғанының белгілері бар.
Dialogue: 0,0:04:37.17,0:04:39.67,Default,,0,0,0,,Бұрын жіберілген қылмыс туралы арыз бойынша.
Dialogue: 0,0:04:40.09,0:04:43.96,Default,,0,0,0,,EPR мақсаты – мердігердің бар екендігін жария ету.
Dialogue: 0,0:04:44.17,0:04:46.38,Default,,0,0,0,,Заңды құқықтарды алу
Dialogue: 0,0:04:46.84,0:04:48.05,Default,,0,0,0,,Тәсілге қарамастан
Dialogue: 0,0:04:48.30,0:04:50.10,Default,,0,0,0,,Оның мақсатын түсіну
Dialogue: 0,0:04:50.18,0:04:52.26,Default,,0,0,0,,Шынымды айтсам, қиын емес.
Dialogue: 0,0:04:53.18,0:04:55.56,Default,,0,0,0,,Алайда ұсталған күдіктілер
Dialogue: 0,0:04:55.85,0:04:58.60,Default,,0,0,0,,Жалпы есте сақтаудың белгілі бір кемшіліктері болды
Dialogue: 0,0:04:59.27,0:05:02.07,Default,,0,0,0,,Ұйымдастырушыға қатысты кез келген ақпаратпен.
Dialogue: 0,0:05:03.36,0:05:04.57,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:05:05.15,0:05:06.90,Default,,0,0,0,,Мен де жайсыздықты сезінемін.
Dialogue: 0,0:05:07.53,0:05:10.62,Default,,0,0,0,,Бұл іс олардың соңғы ісінен өзгеше.
Dialogue: 0,0:05:10.91,0:05:14.66,Default,,0,0,0,,Басқа бірдеңе ойнап тұрған жоқ па?
Dialogue: 0,0:05:15.50,0:05:17.71,Default,,0,0,0,,Түсіндім, қызықпын.
Dialogue: 0,0:05:19.08,0:05:22.54,Default,,0,0,0,,Кез келген жағдайда мен Америка елшілігін ескерту деңгейін көтеруге шақырамын.
Dialogue: 0,0:05:22.75,0:05:24.71,Default,,0,0,0,,Сұраныс дереу жасалуы керек.
Dialogue: 0,0:05:25.22,0:05:26.88,Default,,0,0,0,,Сіз тікелей елшілікке барасыз
Dialogue: 0,0:05:27.09,0:05:30.01,Default,,0,0,0,,Қауіпсіздік офицері Харрис Бернхэм және
Dialogue: 0,0:05:30.14,0:05:32.14,Default,,0,0,0,,Болашақ шараларды талқылаңыз.
Dialogue: 0,0:05:32.26,0:05:34.31,Default,,0,0,0,,Жарайды, кешіріңіз.
Dialogue: 0,0:05:41.61,0:05:42.52,Default,,0,0,0,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:05:44.15,0:05:45.57,Default,,0,0,0,,Астрономия бөлімінің есебі
Dialogue: 0,0:05:46.69,0:05:48.28,Default,,0,0,0,,Мысалға түскен үш адам
Dialogue: 0,0:05:48.53,0:05:49.49,Default,,0,0,0,,Сәйкес нәтижелер
Dialogue: 0,0:05:49.66,0:05:54.79,Default,,0,0,0,,Бұл қабілет кеше түнде барлығы 11 рет іске қосылған жұлдыздан өзгеше сияқты.
Dialogue: 0,0:05:55.04,0:05:59.04,Default,,0,0,0,,Қызық, жақында болған жарылыстардың әсері болды ма?
Dialogue: 0,0:05:59.46,0:06:01.79,Default,,0,0,0,,Бұл қалыпты жылдармен салыстырғанда қалыпты емес.
Dialogue: 0,0:06:02.25,0:06:07.34,Default,,0,0,0,,Менің ойымша, маған Ұлы Қара дақ пен Гархинд толқын ұзындығы да әсер етті.
Dialogue: 0,0:06:07.42,0:06:10.13,Default,,0,0,0,,Мацумото мырза, егер солай десеңіз, Гархинде.
Dialogue: 0,0:06:10.80,0:06:12.43,Default,,0,0,0,,Гарингедакчу
Dialogue: 0,0:06:14.06,0:06:15.89,Default,,0,0,0,,Сізді мазалайтын нәрсе бар ма?
Dialogue: 0,0:06:16.10,0:06:17.31,Default,,0,0,0,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:06:17.73,0:06:21.52,Default,,0,0,0,,Қалай болғанда да, 3 күн қалды Ұлы қара дақ 3 күннен кейін аяқталады
Dialogue: 0,0:06:22.15,0:06:26.02,Default,,0,0,0,,Егер жағдай әдеттегідей болса, сақтанушыларға қатысты оқиғалар азаюы керек.
Dialogue: 0,0:06:26.44,0:06:27.61,Default,,0,0,0,,Оған дейін босаңсуға болмайды
Dialogue: 0,0:06:27.69,0:06:28.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:29.49,0:06:31.99,Default,,0,0,0,,Соңғы уақытта оғаш құбылыстар көп болды.
Dialogue: 0,0:06:32.66,0:06:36.16,Default,,0,0,0,,Менің ойымша, бұл Ұлы Қара дақтың пайда болуына қатысы жоқ.
Dialogue: 0,0:06:36.62,0:06:40.37,Default,,0,0,0,,Оның ішінде ақиқат деген қауесеттер бар табиғаттан тыс тіршілік иелері.
Dialogue: 0,0:06:40.62,0:06:42.62,Default,,0,0,0,,Үкімет немесе полиция фестивалі немесе...
Dialogue: 0,0:06:42.63,0:06:46.55,Default,,0,0,0,,Бұл керемет тәрбиелік күш пе? Мен де қалаймын. Сіз оны қаламайсыз ба?
Dialogue: 0,0:06:46.80,0:06:49.80,Default,,0,0,0,,Не? О, мен басқашамын...
Dialogue: 0,0:06:50.51,0:06:53.09,Default,,0,0,0,,Қолды қолданбай заттарды қозғалтуға болмайды.
Dialogue: 0,0:06:53.26,0:06:54.51,Default,,0,0,0,,Әрине ыңғайлы
Dialogue: 0,0:06:55.18,0:06:57.47,Default,,0,0,0,,Адамдар көп болғанда, үстелде отырғанда
Dialogue: 0,0:06:57.56,0:06:59.89,Default,,0,0,0,,Ыдыстарды тез тазалаңыз.
Dialogue: 0,0:07:02.85,0:07:05.27,Default,,0,0,0,,Сіз ешқашан адамдар көп жерде болған емеспін деп ойлайсыз ба?
Dialogue: 0,0:07:06.15,0:07:06.98,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:08.15,0:07:09.19,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:07:09.49,0:07:10.15,Default,,0,0,0,,Бір дәреже бойынша
Dialogue: 0,0:07:16.53,0:07:17.49,Default,,0,0,0,,Тамақты күтіп тұрсыз ба?
Dialogue: 0,0:07:17.87,0:07:20.29,Default,,0,0,0,,Ақымақ болма, мен сені күтіп едім.
Dialogue: 0,0:07:21.50,0:07:22.46,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:07:27.67,0:07:29.76,Default,,0,0,0,,Мұндағы қауіпсіздік мінсіз.
Dialogue: 0,0:07:30.30,0:07:33.01,Default,,0,0,0,,Жақында болған жарылыстан кейін қауіпсіздік қызметкерлері ұлғайтылды.
Dialogue: 0,0:07:33.38,0:07:35.97,Default,,0,0,0,,Сақтық үшін елші де еліне қайтарылды.
Dialogue: 0,0:07:36.68,0:07:39.68,Default,,0,0,0,,Бірақ алдыңғы жағдайда 10-нан 5-і
Dialogue: 0,0:07:39.85,0:07:43.27,Default,,0,0,0,,Ол экстерриториалдылық танылған үй-жайдың ішінен жүзеге асырылады.
Dialogue: 0,0:07:43.77,0:07:48.61,Default,,0,0,0,,Басқаша айтқанда, сырттан ғана қауіпсіздік жеткіліксіз, сондықтан бізде де ішкі қауіпсіздік болуы керек пе?
Dialogue: 0,0:07:49.78,0:07:50.53,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:07:51.03,0:07:52.99,Default,,0,0,0,,Бізді жылжытқыңыз келсе
Dialogue: 0,0:07:53.20,0:07:56.07,Default,,0,0,0,,Өз еліңіздің үкіметін басқарудан бастаңыз.
Dialogue: 0,0:07:56.91,0:08:00.41,Default,,0,0,0,,Егер олар Америка Құрама Штаттарымен байланысып, онда рұқсат берілсе.
Dialogue: 0,0:08:00.70,0:08:03.41,Default,,0,0,0,,Біз де сізді қарсы аламыз.
Dialogue: 0,0:08:04.29,0:08:08.42,Default,,0,0,0,,Жарайды, рұқсат алсаң ғана.
Dialogue: 0,0:08:15.14,0:08:17.22,Default,,0,0,0,,Мен бұған мүлдем сенбеймін.
Dialogue: 0,0:08:17.68,0:08:20.72,Default,,0,0,0,,Қатты жел жаңалық емес.
Dialogue: 0,0:08:21.64,0:08:22.43,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:08:25.56,0:08:26.90,Default,,0,0,0,,О, бұл жігіт
Dialogue: 0,0:08:35.49,0:08:36.61,Default,,0,0,0,,Сіз әлі жарақат алдыңыз ба?
Dialogue: 0,0:08:37.20,0:08:38.45,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:08:38.87,0:08:39.83,Default,,0,0,0,,(Танжиро) Ах!
Dialogue: 0,0:08:41.24,0:08:43.70,Default,,0,0,0,,Айтпақшы, біз бүгін мұнда не істеп жатырмыз?
Dialogue: 0,0:08:43.79,0:08:48.13,Default,,0,0,0,,Бізге жарылыстар қатары жалғасады деген ақпарат келді.
Dialogue: 0,0:08:49.21,0:08:51.38,Default,,0,0,0,,Өйткені сіз де зардап шектіңіз.
Dialogue: 0,0:08:51.80,0:08:54.13,Default,,0,0,0,,Мен түсінемін, сіз күте алмайсыз.
Dialogue: 0,0:08:54.42,0:08:55.51,Default,,0,0,0,,Бұл біз үшін
Dialogue: 0,0:08:55.72,0:09:00.51,Default,,0,0,0,,Мен жай ғана жарылысты ең жақсы жерден көргім келді.
Dialogue: 0,0:09:03.06,0:09:03.93,Default,,0,0,0,,Сен менімен бірге құлайсың!
Dialogue: 0,0:09:04.68,0:09:08.69,Default,,0,0,0,,Негізінде, мен Америка елшілігіне қатысты басқа да ақпаратты алдым.
Dialogue: 0,0:09:09.23,0:09:12.02,Default,,0,0,0,,Мен сізге хабарлаймын деп ойладым.
Dialogue: 0,0:09:12.98,0:09:15.03,Default,,0,0,0,,Соңғы рет алғыс ретінде
Dialogue: 0,0:09:16.03,0:09:17.36,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:18.87,0:09:22.45,Default,,0,0,0,,Мисаки, сіз ғалым Роберт Шредерді білесіз бе?
Dialogue: 0,0:09:22.79,0:09:25.20,Default,,0,0,0,,Егер есімде дұрыс болса, сіз Gate зерттеушісісіз.
Dialogue: 0,0:09:25.50,0:09:28.67,Default,,0,0,0,,Жұмбақ шешкендіктен біраз уақыт қызу тақырыпқа айналды.
Dialogue: 0,0:09:29.38,0:09:31.75,Default,,0,0,0,,Мен сенің атыңды бұл күндері мүлдем естімеймін.
Dialogue: 0,0:09:32.00,0:09:36.55,Default,,0,0,0,,Шын мәнінде, ол соңғы уақытқа дейін Пандораның ең терең жерінде оқшауланған.
Dialogue: 0,0:09:37.26,0:09:38.05,Default,,0,0,0,,Неліктен? !
Dialogue: 0,0:09:39.01,0:09:41.47,Default,,0,0,0,,EPR оны нысанаға алды
Dialogue: 0,0:09:41.93,0:09:43.06,Default,,0,0,0,,Неге екенін білмеймін
Dialogue: 0,0:09:43.43,0:09:47.23,Default,,0,0,0,,Бірақ алдыңғы түнде мені ұрлап әкетті.
Dialogue: 0,0:09:47.98,0:09:52.52,Default,,0,0,0,,Мен бұл оқиғаға Америка елшілігінің қатысы барын білмедім.
Dialogue: 0,0:09:52.98,0:09:53.61,Default,,0,0,0,,Оған дейін
Dialogue: 0,0:09:54.23,0:09:58.70,Default,,0,0,0,,Алайда ол ең маңызды адам болғандықтан, оған қуыршақ ілінді.
Dialogue: 0,0:09:59.36,0:10:01.37,Default,,0,0,0,,Жіп үзілген жер...
Dialogue: 0,0:10:02.70,0:10:03.91,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:10:04.24,0:10:04.99,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:10:05.87,0:10:07.96,Default,,0,0,0,,Бірақ Америка елшілігінің ішінде
Dialogue: 0,0:10:08.12,0:10:11.96,Default,,0,0,0,,EPR мүшелері ол жерде жасырынбайтынына кепілдік жоқ.
Dialogue: 0,0:10:13.96,0:10:15.17,Default,,0,0,0,,Өздеріңіз білетіндей
Dialogue: 0,0:10:15.55,0:10:17.92,Default,,0,0,0,,ақпан, EPR ұйымдастырушысы, сонымен қатар
Dialogue: 0,0:10:18.38,0:10:21.93,Default,,0,0,0,,Ол бір кездері бізбен жұмыс істеген агент болатын.
Dialogue: 0,0:10:23.14,0:10:24.18,Default,,0,0,0,,Қазір басқаша ма?
Dialogue: 0,0:10:24.89,0:10:25.93,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:39.32,0:10:42.99,Default,,0,0,0,,Кешіріңіз, оның терең әжімдері бар еді...
Dialogue: 0,0:10:44.70,0:10:45.41,Default,,0,0,0,,Мисаки
Dialogue: 0,0:10:45.83,0:10:46.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:50.71,0:10:53.17,Default,,0,0,0,,Бұдан былай дос та, жау да болмайды.
Dialogue: 0,0:10:54.79,0:10:57.88,Default,,0,0,0,,Тек түйсігіңізге сеніңіз және соған сәйкес әрекет етіңіз
Dialogue: 0,0:11:02.39,0:11:04.14,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:11:11.77,0:11:15.23,Default,,0,0,0,,Жапон полициясы ақыры оралды.
Dialogue: 0,0:11:15.73,0:11:16.65,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:11:17.65,0:11:21.40,Default,,0,0,0,,Бұл жолы да дәл осындай бомбалау бізді нысанаға алатын сияқты.
Dialogue: 0,0:11:21.95,0:11:23.53,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:11:24.28,0:11:27.16,Default,,0,0,0,,Міне, нақты дәлел жоқ.
Dialogue: 0,0:11:27.87,0:11:29.24,Default,,0,0,0,,Осы аз ақпаратпен
Dialogue: 0,0:11:29.41,0:11:33.83,Default,,0,0,0,,Мемлекеттік құпияларды әшкерелеу арқылы сізден ынтымақтастық сұраймыз деп ойладыңыз ба?
Dialogue: 0,0:11:34.67,0:11:36.04,Default,,0,0,0,,Бірақ бұл қауіпті емес пе?
Dialogue: 0,0:11:36.50,0:11:39.34,Default,,0,0,0,,ЦРУ-ға лаңкестік шабуыл жасағандар солар болса керек.
Dialogue: 0,0:11:39.67,0:11:40.76,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:11:41.13,0:11:44.18,Default,,0,0,0,,Мен мұндағы қауіпсіздік бөлімінің бастығымын. Оны айналып өтуге жол жоқ.
Dialogue: 0,0:11:45.22,0:11:45.89,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:11:46.55,0:11:50.22,Default,,0,0,0,,Сонда мен сені ұмыттырамын, әдеттегідей.
Dialogue: 0,0:11:53.27,0:11:56.86,Default,,0,0,0,,Барлығын ұмытпас бұрын маңызды құжаттарды алыңыз
Dialogue: 0,0:11:57.90,0:11:58.73,Default,,0,0,0,,Британия
Dialogue: 0,0:12:03.57,0:12:05.11,Default,,0,0,0,,Мұнда ғибадатхана бар, жаным.
Dialogue: 0,0:12:37.69,0:12:41.40,Default,,0,0,0,,Мен нағыз доктор Шрейдерді таптым.
Dialogue: 0,0:12:42.03,0:12:43.24,Default,,0,0,0,,Қоғамдық қауіпсіздікті қамтамасыз ету басталды
Dialogue: 0,0:12:43.78,0:12:46.66,Default,,0,0,0,,EPR осында бағытталған.
Dialogue: 0,0:12:47.12,0:12:51.99,Default,,0,0,0,,Эмбер маған бұл аймақты нысанаға алу жоспарлары туралы хабарлаған жоқ.
Dialogue: 0,0:12:52.29,0:12:53.50,Default,,0,0,0,,Мен де тыңдамаймын.
Dialogue: 0,0:12:53.87,0:12:55.83,Default,,0,0,0,,Басқаша айтқанда, осында енгізу
Dialogue: 0,0:12:56.17,0:12:59.17,Default,,0,0,0,,Бұл ұйымдасқан блеф дегенді білдіре ме?
Dialogue: 0,0:12:59.59,0:13:00.34,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:13:06.13,0:13:10.30,Default,,0,0,0,,Орталықтағы қақпаға қарсы бөлшектерді соғу үшін үдеткішті қолдану арқылы
Dialogue: 0,0:13:10.43,0:13:12.56,Default,,0,0,0,,Қақпаның тұрақтылығын бұзу
Dialogue: 0,0:13:13.39,0:13:18.40,Default,,0,0,0,,Қагемүшаға естеліктердің салыну мүмкіндігін жоққа шығаруға болмайды.
Dialogue: 0,0:13:18.77,0:13:23.07,Default,,0,0,0,,Дегенмен, алынған ақпарат міндетті түрде өзіне тиесілі сияқты.
Dialogue: 0,0:13:23.44,0:13:26.28,Default,,0,0,0,,Онымен кездесуге тұрарлық па?
Dialogue: 0,0:13:29.49,0:13:31.24,Default,,0,0,0,,Тағы сәл күтейік
Dialogue: 0,0:13:31.62,0:13:33.12,Default,,0,0,0,,Нағыз дәрігер болсаң
Dialogue: 0,0:13:33.24,0:13:36.96,Default,,0,0,0,,Олар мұнда кез келген жолмен келеді.
Dialogue: 0,0:13:37.08,0:13:40.92,Default,,0,0,0,,Егер бұл Эмбердің еркі болса
Dialogue: 0,0:14:08.95,0:14:11.32,Default,,0,0,0,,Полиция әдеттегіден көп
Dialogue: 0,0:14:21.00,0:14:21.96,Default,,0,0,0,,Кокомока
Dialogue: 0,0:14:23.30,0:14:24.09,Default,,0,0,0,,Мен бара аламын ба?
Dialogue: 0,0:14:26.55,0:14:27.34,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:14:29.47,0:14:31.01,Default,,0,0,0,,Уақытты өзіңізге қалдырыңыз.
Dialogue: 0,0:14:31.55,0:14:32.26,Default,,0,0,0,,Мен бара аламын ба?
Dialogue: 0,0:14:32.47,0:14:33.22,Default,,0,0,0,,Кез келген уақытта
Dialogue: 0,0:14:33.56,0:14:37.47,Default,,0,0,0,,Мен бәрібір диверсиямын, елшілікті жарып жіберетін сенсің.
Dialogue: 0,0:14:38.56,0:14:39.23,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:55.24,0:14:57.33,Default,,0,0,0,,Сайто-сан, сен қалай ойлайсың? Бұл
Dialogue: 0,0:14:58.21,0:15:01.79,Default,,0,0,0,,Үйленген кезде қызыл бұршақ пастасы мен сүттің нарықтық бағасы бекітілген шығар.
Dialogue: 0,0:15:02.00,0:15:05.04,Default,,0,0,0,,Бұл әлі шешілген жоқ, бұл дұрыс емес.
Dialogue: 0,0:15:05.13,0:15:06.42,Default,,0,0,0,,Керек болмаса, жеме.
Dialogue: 0,0:15:06.80,0:15:07.88,Default,,0,0,0,,Бас Мей.
Dialogue: 0,0:15:14.18,0:15:14.89,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:15:15.22,0:15:15.80,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:15:22.56,0:15:25.65,Default,,0,0,0,,Осы күндері бөтелкедегі сүтті қайдан сатып алдыңыз?
Dialogue: 0,0:15:25.82,0:15:28.40,Default,,0,0,0,,Ей, бөтелкелер қоршаған орта үшін ең жақсы нәрсе.
Dialogue: 0,0:15:28.69,0:15:30.11,Default,,0,0,0,,Қайта өңдеу! Қайта өңдеу!
Dialogue: 0,0:15:30.32,0:15:30.78,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:34.95,0:15:35.53,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:42.29,0:15:42.79,Default,,0,0,0,,Тездетіңіз
Dialogue: 0,0:15:45.75,0:15:46.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:48.05,0:15:48.67,Default,,0,0,0,,ішке кірді
Dialogue: 0,0:15:49.46,0:15:50.67,Default,,0,0,0,,Юши Күміс
Dialogue: 0,0:15:51.68,0:15:54.39,Default,,0,0,0,,Сол жерден 20м алға дейін тура жүріңіз
Dialogue: 0,0:16:00.93,0:16:03.60,Default,,0,0,0,,Сіздің алдыңызда ғимараттың кіре берісінде екі күзетші тұр.
Dialogue: 0,0:16:04.19,0:16:05.40,Default,,0,0,0,,Оңға бұрылыңыз
Dialogue: 0,0:16:07.02,0:16:08.82,Default,,0,0,0,,Алдыңғы бұрышты айналып өтетін жолмен жүріңіз
Dialogue: 0,0:16:09.61,0:16:11.78,Default,,0,0,0,,Бірінші бөлменің терезесі ашық.
Dialogue: 0,0:16:13.24,0:16:13.82,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:16:18.29,0:16:19.79,Default,,0,0,0,,Жарайды, мен бардым.
Dialogue: 0,0:16:34.84,0:16:36.01,Default,,0,0,0,,5 минуттан кейін орнатыңыз
Dialogue: 0,0:16:36.30,0:16:37.80,Default,,0,0,0,,Түсінді, шегін.
Dialogue: 0,0:16:39.43,0:16:40.22,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:17:10.80,0:17:13.26,Default,,0,0,0,,Мен сенімен мұнша тез кездесемін деп ойламаппын
Dialogue: 0,0:17:16.09,0:17:19.26,Default,,0,0,0,,Мен Эмберді таңдағаныма қуаныштымын.
Dialogue: 0,0:17:23.52,0:17:25.64,Default,,0,0,0,,Сондықтан алаңдаудың қажеті жоқ.
Dialogue: 0,0:17:26.23,0:17:27.52,Default,,0,0,0,,Бұл жай еркелік
Dialogue: 0,0:17:28.11,0:17:31.11,Default,,0,0,0,,Сонымен қатар, шыққан түтіндер сіздің юрисдикцияңызда.
Dialogue: 0,0:17:31.57,0:17:32.65,Default,,0,0,0,,Оған біздің қатысымыз жоқ.
Dialogue: 0,0:17:32.98,0:17:34.74,Default,,0,0,0,,Бұл бұрыс болуы мүмкін
Dialogue: 0,0:17:35.15,0:17:38.11,Default,,0,0,0,,Қазірдің өзінде үй-жайлар жұқа созылған кезде,
Dialogue: 0,0:17:38.37,0:17:39.41,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:17:42.04,0:17:43.20,Default,,0,0,0,,Өрт сөндіру бөліміне хабарласыңыз!
Dialogue: 0,0:17:43.29,0:17:43.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:44.29,0:17:46.62,Default,,0,0,0,,Бұл оқыс оқиға! Бұл бір нәрсе болуы керек ...
Dialogue: 0,0:17:46.67,0:17:47.67,Default,,0,0,0,,Бернхэм мырза!
Dialogue: 0,0:17:48.08,0:17:49.88,Default,,0,0,0,,Оларды ішке кіргізбеңіз!
Dialogue: 0,0:17:56.63,0:17:57.17,Default,,0,0,0,,Иә
Dialogue: 0,0:17:57.59,0:17:58.30,Default,,0,0,0,,Бұл Кирихара.
Dialogue: 0,0:17:58.55,0:18:00.39,Default,,0,0,0,,Енді мұны істеуге ешқандай себеп жоқ.
Dialogue: 0,0:18:00.93,0:18:02.10,Default,,0,0,0,,Елшіліктің жағдайы қандай?
Dialogue: 0,0:18:02.43,0:18:04.77,Default,,0,0,0,,Енгізу және тексеру мүмкін емес
Dialogue: 0,0:18:05.52,0:18:07.10,Default,,0,0,0,,Директор, сізден бір өтінішім бар.
Dialogue: 0,0:18:07.64,0:18:11.65,Default,,0,0,0,,Арнайы қауіпсіздік шарасы ретінде бізге елшілікке кіруге рұқсат етіңіз.
Dialogue: 0,0:18:11.90,0:18:12.48,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:18:12.94,0:18:15.28,Default,,0,0,0,,Бұл жылдамдықпен жәбірленушіні құтқару мүмкін болмайды.
Dialogue: 0,0:18:15.53,0:18:17.82,Default,,0,0,0,,Сіз ұйымдастырушыға қатысты анықтамаларды жоғалтуыңыз мүмкін.
Dialogue: 0,0:18:19.32,0:18:21.74,Default,,0,0,0,,Жарайды, маған бес минут уақыт беріңіз.
Dialogue: 0,0:18:23.45,0:18:24.95,Default,,0,0,0,,Маған айтқандай.
Dialogue: 0,0:18:25.79,0:18:27.91,Default,,0,0,0,,Министрлер кабинетінің Бас хатшысы оны мақұлдады ма?
Dialogue: 0,0:18:28.58,0:18:32.25,Default,,0,0,0,,Мен Америка Құрама Штаттарымен қарым-қатынас одан әрі шиеленіспейді деп үміттенемін.
Dialogue: 0,0:18:33.50,0:18:36.51,Default,,0,0,0,,Сырттан осындай анық сылтау болса
Dialogue: 0,0:18:37.05,0:18:41.30,Default,,0,0,0,,Осыдан кейін АҚШ-тағы достарым маған шулы түрін басуға көмектеседі.
Dialogue: 0,0:18:41.80,0:18:42.30,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:18:48.23,0:18:51.56,Default,,0,0,0,,Зардап шеккендерді жедел жәрдем қызметкерлеріне тез жеткізіңіз!
Dialogue: 0,0:18:52.19,0:18:53.40,Default,,0,0,0,,Осындай кездерде жалғыз мен...
Dialogue: 0,0:18:56.69,0:18:57.90,Default,,0,0,0,,Өйткені екеуіңде де бірдей квирк бар ма?
Dialogue: 0,0:19:51.46,0:19:56.29,Default,,0,0,0,,Дәрігерді ұрлап, төбелесу туралы бұйрық болған жоқ деп ойлаймын.
Dialogue: 0,0:20:01.22,0:20:02.09,Default,,0,0,0,,Бұл ол.
Dialogue: 0,0:20:03.84,0:20:05.97,Default,,0,0,0,,Эмбер іздеп жүрген адам кім?
Dialogue: 0,0:20:06.30,0:20:08.51,Default,,0,0,0,,Өкінішке орай, солай сияқты.
Dialogue: 0,0:20:10.43,0:20:13.60,Default,,0,0,0,,Егер солай болса, мен бұл ойынды сізге қалдырамын.
Dialogue: 0,0:20:25.03,0:20:27.20,Default,,0,0,0,,Қайта кездескенше, Қара мылтық мырза.
Dialogue: 0,0:20:42.34,0:20:45.43,Default,,0,0,0,,Дәрігерді алып кеткен сен бе?
Dialogue: 0,0:20:46.39,0:20:48.72,Default,,0,0,0,,Көптен бері 11 қарашада көрмеген
Dialogue: 0,0:20:50.18,0:20:51.56,Default,,0,0,0,,Мен сені ақпанда көргім келеді
Dialogue: 0,0:20:52.64,0:20:53.39,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:58.27,0:21:00.15,Default,,0,0,0,,Ол да соны қалайды
Dialogue: 0,0:21:26.51,0:21:29.22,Default,,0,0,0,,Мылтығыңызды қойып, қолыңызды басыңыздың артына қойыңыз!
Dialogue: 0,0:21:31.43,0:21:34.81,Default,,0,0,0,,Мен Кирихара, Токио қалалық полиция департаментінің Қоғамдық қауіпсіздік департаментінің 4-ші сыртқы істер бөлімінің бастығымын.
Dialogue: 0,0:21:35.39,0:21:36.52,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:36.69,0:21:37.52,Default,,0,0,0,,Бұл Pandora
Dialogue: 0,0:21:40.36,0:21:40.90,Default,,0,0,0,,Қозғалыс
Dialogue: 0,0:21:45.45,0:21:45.90,Default,,0,0,0,,Қозғалыс
Dialogue: 0,0:21:54.29,0:21:56.16,Default,,0,0,0,,Кешігіп қалдың, қара.
Dialogue: 0,0:21:56.75,0:21:57.96,Default,,0,0,0,,Сіз сөйлей аласыз ба? Неко-чан
Dialogue: 0,0:23:41.69,0:23:46.11,Default,,0,0,0,,Әлгі біртүрлі ақ шашты адам дүниенің шындығын айтты.
Dialogue: 0,0:23:47.19,0:23:50.70,Default,,0,0,0,,Ол жерде әлі де біртүрлі адамдар болды.
Dialogue: 0,0:23:51.70,0:23:57.66,Default,,0,0,0,,Аң кейпіндегі адам, болашақты сөйлейтін адам, өлім жазасына кесілген адам.
Dialogue: 0,0:23:59.16,0:24:01.54,Default,,0,0,0,,Қашып құтыла алмайтын болашақ
Dialogue: 0,0:24:02.21,0:24:04.88,Default,,0,0,0,,Бұған қайшы келетін нәрсе - адамдардың өмір сүру тәсілі.
Dialogue: 0,0:24:05.71,0:24:08.30,Default,,0,0,0,,Ал күлгін түтін тарайды
Dialogue: 0,0:24:09.80,0:24:15.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
