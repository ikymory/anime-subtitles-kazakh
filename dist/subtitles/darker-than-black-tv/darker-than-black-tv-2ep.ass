Dialogue: 0,0:24:06.69,0:24:08.69,Default,,0,0,0,,

Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.90,0:00:12.19,Default,,0,0,0,,Мен бұл аспанда жұлдыздар ағып жатқанын білемін
Dialogue: 0,0:00:12.73,0:00:14.53,Default,,0,0,0,,Олардың өмірі қашан аяқталады
Dialogue: 0,0:00:16.24,0:00:18.45,Default,,0,0,0,,Қазір әлемнің бір жерінде
Dialogue: 0,0:00:18.95,0:00:20.58,Default,,0,0,0,,Мердігер қайтыс болды.
Dialogue: 0,0:00:24.58,0:00:27.96,Default,,0,0,0,,Осыдан он жыл бұрын дәл сол күні нағыз жұлдызды аспан ғайып болды.
Dialogue: 0,0:00:28.67,0:00:30.34,Default,,0,0,0,,Осы жалғанмен ауыстырылды
Dialogue: 0,0:00:31.67,0:00:34.01,Default,,0,0,0,,Мердігер деген мейірімсіз адам
Dialogue: 0,0:00:35.07,0:00:37.47,Default,,0,0,0,,Қуыршақ деп аталатын жансыз дене
Dialogue: 0,0:00:38.59,0:00:41.68,Default,,0,0,0,,Үкіметтер олардың ақпараттары таралады деп қорықты.
Dialogue: 0,0:00:42.22,0:00:46.23,Default,,0,0,0,,Ақыр соңында, ME көмегімен, Gade-ден алынған жаңа технология
Dialogue: 0,0:00:46.56,0:00:49.35,Default,,0,0,0,,Мен байланысқан нәрселер туралы естеліктерді жойдым.
Dialogue: 0,0:00:50.86,0:00:54.65,Default,,0,0,0,,Барлық елдер өз мүмкіндіктерін толық пайдаланып жатса да.
Dialogue: 0,0:00:56.40,0:00:57.36,Default,,0,0,0,,Егжей-тегжейлі?
Dialogue: 0,0:00:58.66,0:01:00.82,Default,,0,0,0,,Мен ғылыми-зерттеу институтында ұзақ уақыт жұмыс істеймін.
Dialogue: 0,0:01:01.32,0:01:04.04,Default,,0,0,0,,Мен білуім керек емес нәрселерді үйрендім.
Dialogue: 0,0:01:05.04,0:01:08.12,Default,,0,0,0,,Және олардың қандай да бір байланысы бар.
Dialogue: 0,0:01:09.08,0:01:10.29,Default,,0,0,0,,Мүмкін мен орта мектепте оқып жүрген кезімде.
Dialogue: 0,0:01:11.08,0:01:12.75,Default,,0,0,0,,Ата-анасы жазатайым оқиғадан қайтыс болды
Dialogue: 0,0:01:13.84,0:01:16.30,Default,,0,0,0,,Жоқ, бұл маған айтылғандықтан.
Dialogue: 0,0:01:16.67,0:01:17.38,Default,,0,0,0,,Шындығында, бұл басқаша.
Dialogue: 0,0:01:18.09,0:01:22.64,Default,,0,0,0,,Мен мердігердің ата-анасын өлтіргенін көрдім.
Dialogue: 0,0:01:24.18,0:01:28.43,Default,,0,0,0,,Содан бері мені қызықтырады.
Dialogue: 0,0:03:02.61,0:03:07.45,Default,,0,0,0,,Астрономиялық департамент де шамамен бір уақытта француз агентінің қызметін растады.
Dialogue: 0,0:03:07.83,0:03:08.74,Default,,0,0,0,,Аты – Жан
Dialogue: 0,0:03:09.24,0:03:11.95,Default,,0,0,0,,Қабілет материал алмасу түрі телепортация болып табылады.
Dialogue: 0,0:03:12.33,0:03:13.87,Default,,0,0,0,,Рухты бақылау арқылы іздеу
Dialogue: 0,0:03:14.04,0:03:17.71,Default,,0,0,0,,Оқиға орны анықталды, бірақ ешбір із қалмады.
Dialogue: 0,0:03:18.38,0:03:22.26,Default,,0,0,0,,Мен бір рет қауіпсіздікті қамтамасыз ету мүмкіндігіне ие болғаныма өкінемін
Dialogue: 0,0:03:26.34,0:03:29.17,Default,,0,0,0,,Сізге үзіліс қажет, бірақ сақтықты түсіру өлімге әкелуі мүмкін.
Dialogue: 0,0:03:29.64,0:03:33.02,Default,,0,0,0,,BK201-де де белсенділік белгілері бар сияқты.
Dialogue: 0,0:03:33.18,0:03:34.19,Default,,0,0,0,,Онда бірден сонда барайық.
Dialogue: 0,0:03:39.94,0:03:41.19,Default,,0,0,0,,Сенің арқасында тіпті трусигім де суға малып кетті. О, Құдай-ай…
Dialogue: 0,0:03:41.19,0:03:42.78,Default,,0,0,0,,Неге?
Dialogue: 0,0:03:56.12,0:03:59.32,Default,,0,0,0,,Түсінемін, мен мұнымен де біттім.
Dialogue: 0,0:04:01.19,0:04:04.80,Default,,0,0,0,,Киіміңді тез ауыстырғаның жөн. Мен келесі бөлмеге қайтамын.
Dialogue: 0,0:04:05.51,0:04:06.59,Default,,0,0,0,,Егер бірдеңе болса
Dialogue: 0,0:04:07.69,0:04:10.68,Default,,0,0,0,,Бұл рас па? Бүгін не болды?
Dialogue: 0,0:04:11.60,0:04:15.12,Default,,0,0,0,,Луи келісімшарттың иесі болды және қайтыс болды.
Dialogue: 0,0:04:17.06,0:04:21.15,Default,,0,0,0,,Тоқта, мені жалғыз қалдырма
Dialogue: 0,0:04:28.36,0:04:29.57,Default,,0,0,0,,Жарықты қоспаңыз
Dialogue: 0,0:04:32.58,0:04:35.74,Default,,0,0,0,,Бұл таныс еден жоспары болуы керек болса да, бұл біртүрлі.
Dialogue: 0,0:04:36.08,0:04:38.74,Default,,0,0,0,,Оңға және солға айналдыруда біртүрлі нәрсе бар.
Dialogue: 0,0:04:39.63,0:04:40.84,Default,,0,0,0,,Жалғанға ұқсайды
Dialogue: 0,0:04:43.38,0:04:45.26,Default,,0,0,0,,Менің көшіп келгеніме екі апта ғана болды.
Dialogue: 0,0:04:45.80,0:04:48.72,Default,,0,0,0,,Мен өзімді шынымен тірідей сезіндім.
Dialogue: 0,0:04:49.59,0:04:51.93,Default,,0,0,0,,Мен бірінші рет осылай болдым.
Dialogue: 0,0:04:52.81,0:04:55.35,Default,,0,0,0,,Мен дүкенде жұмыс істеу мүмкін емес деп ойладым.
Dialogue: 0,0:04:56.27,0:04:58.81,Default,,0,0,0,,Мен оны сынап көрдім, таң қаларлықтай мен байланып қалдым.
Dialogue: 0,0:04:59.48,0:05:03.02,Default,,0,0,0,,Мен қарғыс атқандай бар уақытымды ғылыми-зерттеу институтында зерттеумен өткіздім.
Dialogue: 0,0:05:03.23,0:05:04.53,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:05:04.94,0:05:08.20,Default,,0,0,0,,Қайсысы шын екенін білмеймін десем болады.
Dialogue: 0,0:05:08.45,0:05:12.11,Default,,0,0,0,,Ең бастысы, Луи жақында мені алып кетуге келеді.
Dialogue: 0,0:05:12.87,0:05:14.16,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:05:17.08,0:05:18.71,Default,,0,0,0,,Мен енді қайтып бара алмаймын деп ойлаймын.
Dialogue: 0,0:05:20.71,0:05:21.96,Default,,0,0,0,,Мүмкіндік бар ма?
Dialogue: 0,0:05:22.52,0:05:27.63,Default,,0,0,0,,Хехехе, бұлай болуы мүмкін емес. Мен сенетін жалғыз адам Луи болды.
Dialogue: 0,0:05:31.39,0:05:32.55,Default,,0,0,0,,Мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:05:35.43,0:05:36.72,Default,,0,0,0,,Қан демоні өнері: Өлімге шолу
Dialogue: 0,0:05:40.31,0:05:44.00,Default,,0,0,0,,Бірақ, бірақ сен бүгін ғана келдің.
Dialogue: 0,0:05:44.23,0:05:47.59,Default,,0,0,0,,Бүгін мұнда келу менің тағдырыма жазылғанына сенімдімін.
Dialogue: 0,0:05:48.28,0:05:52.89,Default,,0,0,0,,Бақытым бүгін сені кездестіретінімді айтты.
Dialogue: 0,0:05:59.21,0:06:02.99,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз әлі де қашып кете аласыз.
Dialogue: 0,0:06:03.63,0:06:04.54,Default,,0,0,0,,Мен туралы
Dialogue: 0,0:06:04.92,0:06:06.67,Default,,0,0,0,,Сіздің бетіңіз бәрібір көрінеді
Dialogue: 0,0:06:07.34,0:06:08.97,Default,,0,0,0,,Жақында осы бөлмеде
Dialogue: 0,0:06:12.39,0:06:14.26,Default,,0,0,0,,Сенген дұрыс
Dialogue: 0,0:06:32.91,0:06:34.03,Default,,0,0,0,,Acchaaa
Dialogue: 0,0:06:34.24,0:06:35.58,Default,,0,0,0,,Сіз өзіңізден озып кеттіңіз.
Dialogue: 0,0:06:36.08,0:06:38.24,Default,,0,0,0,,Әйтеуір, анықтама іздеп көрейік.
Dialogue: 0,0:06:38.75,0:06:40.58,Default,,0,0,0,,Бірдеңе бола ма?
Dialogue: 0,0:06:53.34,0:06:54.39,Default,,0,0,0,,Бұл мысық па?
Dialogue: 0,0:07:01.48,0:07:02.56,Default,,0,0,0,,Менің бір танысым бар.
Dialogue: 0,0:07:02.94,0:07:07.68,Default,,0,0,0,,I work in Macau, doing trade and other related work.
Dialogue: 0,0:07:08.86,0:07:11.24,Default,,0,0,0,,Олар төлқұжат дайындады, т.б.
Dialogue: 0,0:07:11.82,0:07:14.45,Default,,0,0,0,,Жалғандық, контрабанда және т.б.
Dialogue: 0,0:07:20.24,0:07:22.62,Default,,0,0,0,,You said you were an international student.
Dialogue: 0,0:07:24.08,0:07:26.46,Default,,0,0,0,,Әртүрлі жағдайлар болады.
Dialogue: 0,0:07:28.54,0:07:31.71,Default,,0,0,0,,Мен білмей тұрып, бұл ел басына күн туды.
Dialogue: 0,0:07:32.09,0:07:35.09,Default,,0,0,0,,Бірақ маған көп ақша керек.
Dialogue: 0,0:07:36.01,0:07:40.39,Default,,0,0,0,,Мен банктен көбірек ақша алсам ғой.
Dialogue: 0,0:07:41.27,0:07:43.43,Default,,0,0,0,,Қандай да бір балама болса
Dialogue: 0,0:07:45.02,0:07:46.23,Default,,0,0,0,,Ақпарат туралы не деуге болады?
Dialogue: 0,0:07:46.60,0:07:47.40,Default,,0,0,0,,Ақпарат
Dialogue: 0,0:07:47.94,0:07:53.90,Default,,0,0,0,,Иә, Pandora орталығына кіру арқылы алынған өте құпия ақпарат.
Dialogue: 0,0:07:54.32,0:07:58.99,Default,,0,0,0,,Бұл рас па? Қақпаға қатысты ақпарат жоғары бағамен сатылуы керек.
Dialogue: 0,0:07:59.20,0:08:00.87,Default,,0,0,0,,Қаншалықты кішкентай болса да
Dialogue: 0,0:08:01.54,0:08:03.62,Default,,0,0,0,,Compression type gravity repulsion element or
Dialogue: 0,0:08:03.83,0:08:06.67,Default,,0,0,0,,This is the core theory of the ME technology request.
Dialogue: 0,0:08:07.83,0:08:10.34,Default,,0,0,0,,Then I'm sure it will sell for a very high price.
Dialogue: 0,0:08:10.63,0:08:13.46,Default,,0,0,0,,Жарайды, Харагучи-сан.
Dialogue: 0,0:08:15.84,0:08:19.43,Default,,0,0,0,,Харагучи – жалған есім, шын аты – Чиаки
Dialogue: 0,0:08:19.72,0:08:21.76,Default,,0,0,0,,Менің атым Чиаки Шинода.
Dialogue: 0,0:08:22.27,0:08:25.85,Default,,0,0,0,,Чиаки-сан, бұл жақсы есім.
Dialogue: 0,0:08:26.06,0:08:30.11,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Ли Шэншунмын.
Dialogue: 0,0:08:30.36,0:08:32.07,Default,,0,0,0,,Танысқаныма қуаныштымын, Ли мырза
Dialogue: 0,0:08:33.23,0:08:34.44,Default,,0,0,0,,Жақсы есім.
Dialogue: 0,0:08:36.26,0:08:42.08,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, сізде жіберген барлық заттар бар ма?
Dialogue: 0,0:08:42.37,0:08:43.29,Default,,0,0,0,,Иә
Dialogue: 0,0:08:43.62,0:08:44.50,Default,,0,0,0,,Уақытыңызды бөліңіз.
Dialogue: 0,0:08:46.71,0:08:49.42,Default,,0,0,0,,Жарайды, сіз менен кез келген нәрсені сұрай аласыз дедім.
Dialogue: 0,0:08:49.92,0:08:51.79,Default,,0,0,0,,Осының бәрін жейсің.
Dialogue: 0,0:08:53.21,0:08:56.51,Default,,0,0,0,,Кешіріңіз, бұл әдеттегіден аз.
Dialogue: 0,0:09:01.35,0:09:04.43,Default,,0,0,0,,Сіз міндетті түрде салмақ қосасыз.
Dialogue: 0,0:09:05.14,0:09:08.73,Default,,0,0,0,,It may be fine now, but I'm over 30 and will definitely gain weight.
Dialogue: 0,0:09:08.98,0:09:10.86,Default,,0,0,0,,Әйтпесе, дүние қателескен болар еді.
Dialogue: 0,0:09:16.13,0:09:19.70,Default,,0,0,0,,Болашаққа алаңдайтын уақыт емес пе?
Dialogue: 0,0:09:38.68,0:09:39.72,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:09:43.01,0:09:46.37,Default,,0,0,0,,Соңғы кездері мен аздап шаршадым.
Dialogue: 0,0:09:48.10,0:09:49.35,Default,,0,0,0,,Eat first
Dialogue: 0,0:10:01.81,0:10:04.33,Default,,0,0,0,,Түсіндім, естідім.
Dialogue: 0,0:10:04.49,0:10:06.20,Default,,0,0,0,,Қандай тамаша қадам.
Dialogue: 0,0:10:07.75,0:10:08.45,Default,,0,0,0,,Huang
Dialogue: 0,0:10:08.75,0:10:12.25,Default,,0,0,0,,Бұл жұмысқа сенен артық лайықты ешкім жоқ.
Dialogue: 0,0:10:13.50,0:10:16.59,Default,,0,0,0,,Өйткені, кінә сезімі жоқ.
Dialogue: 0,0:10:19.09,0:10:20.76,Default,,0,0,0,,Буцудың көзі ілініп тұр, солай ма?
Dialogue: 0,0:10:21.22,0:10:22.59,Default,,0,0,0,,Get it now!
Dialogue: 0,0:10:24.85,0:10:26.43,Default,,0,0,0,,Олар жақындап келеді
Dialogue: 0,0:10:26.81,0:10:29.77,Default,,0,0,0,,Әйелді проблемаға айналдырмай тұрып құтыл.
Dialogue: 0,0:10:31.60,0:10:32.69,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:10:56.88,0:10:59.17,Default,,0,0,0,,Қош келдіңіздер, екеуіңіз бе?
Dialogue: 0,0:11:04.84,0:11:05.89,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:11:07.67,0:11:09.56,Default,,0,0,0,,Мен аздап қиналып тұрмын.
Dialogue: 0,0:11:09.89,0:11:11.35,Default,,0,0,0,,Hey, wait.
Dialogue: 0,0:11:32.75,0:11:33.33,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:11:34.00,0:11:34.71,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:34.96,0:11:35.58,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:11:51.57,0:11:53.69,Default,,0,0,0,,Jean escaped.
Dialogue: 0,0:11:54.02,0:11:54.89,Default,,0,0,0,,Қосылыңыз
Dialogue: 0,0:11:55.73,0:11:57.71,Default,,0,0,0,,О, бұл сөзсіз тышқан.
Dialogue: 0,0:12:13.83,0:12:15.12,Default,,0,0,0,,Байланыс үзілді
Dialogue: 0,0:12:15.67,0:12:18.54,Default,,0,0,0,,Не болып жатыр? Сіз маған опасыздық жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:12:18.88,0:12:22.49,Default,,0,0,0,,Бұл жағдайда оған опасыздық жасау оған жақсылық әкелмейді.
Dialogue: 0,0:12:22.80,0:12:25.63,Default,,0,0,0,,Contractors do not do anything that is not profitable.
Dialogue: 0,0:12:25.93,0:12:27.84,Default,,0,0,0,,Бірақ қозғалыс біртүрлі.
Dialogue: 0,0:12:28.22,0:12:30.18,Default,,0,0,0,,Неге әйелді өлтірмейсің?
Dialogue: 0,0:12:30.72,0:12:32.35,Default,,0,0,0,,Сіз тым көп уақыт жұмсап жатырсыз
Dialogue: 0,0:12:32.97,0:12:34.85,Default,,0,0,0,,Бұл, әрине, біртүрлі.
Dialogue: 0,0:12:35.48,0:12:36.60,Default,,0,0,0,,Қара не істеп жатыр?
Dialogue: 0,0:12:36.94,0:12:37.81,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:12:37.81,0:12:38.50,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:12:39.77,0:12:41.15,Default,,0,0,0,,Су жоқ жерде болу
Dialogue: 0,0:12:44.36,0:12:44.99,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:12:45.40,0:12:45.74,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:51.66,0:12:53.56,Default,,0,0,0,,Кешіріңіз. Бұл менің кінәм.
Dialogue: 0,0:12:57.08,0:13:01.42,Default,,0,0,0,,Бұл мүмкін емес. Мен олардан қаша алмаймын.
Dialogue: 0,0:13:04.01,0:13:05.51,Default,,0,0,0,,You look tired.
Dialogue: 0,0:13:06.22,0:13:09.89,Default,,0,0,0,,Мен өзімді өлі адамдай сезінемін. I should sleep now.
Dialogue: 0,0:13:11.76,0:13:16.68,Default,,0,0,0,,I'm tired. Мен сол жігіттердің мейіріміне көп түстім.
Dialogue: 0,0:13:18.41,0:13:20.56,Default,,0,0,0,,Мен қашуға тырыстым
Dialogue: 0,0:13:20.98,0:13:23.86,Default,,0,0,0,,Мен білмей тұрып, тағы да алдымнан шықтың.
Dialogue: 0,0:13:24.48,0:13:28.20,Default,,0,0,0,,Біреудің өміріне тағы да осылай араласу.
Dialogue: 0,0:13:28.53,0:13:32.91,Default,,0,0,0,,Мен сені кешіре алмаймын, бірақ мен ең кешіре алмайтын нәрсе
Dialogue: 0,0:13:33.45,0:13:38.30,Default,,0,0,0,,Мен де олардың соңынан еріп келемін.
Dialogue: 0,0:13:40.79,0:13:42.09,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:42.59,0:13:47.36,Default,,0,0,0,,Бірақ мен мұны ата-анам қайтыс болғанда түсіндім.
Dialogue: 0,0:13:47.63,0:13:49.86,Default,,0,0,0,,Мен оларды көрдім, бірақ куәлік бермедім.
Dialogue: 0,0:13:51.22,0:13:53.64,Default,,0,0,0,,Басқа мердігер әлі бала еді.
Dialogue: 0,0:13:54.47,0:13:56.06,Default,,0,0,0,,Жүзіңді көре алмасам да
Dialogue: 0,0:13:56.85,0:14:02.46,Default,,0,0,0,,Бірақ мен қараңғыда көрген Лансернопдо синхротрондық сәулеленуінің жарқырауы
Dialogue: 0,0:14:02.94,0:14:04.75,Default,,0,0,0,,Көзімді жібере алмаймын
Dialogue: 0,0:14:06.32,0:14:07.44,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:14:08.70,0:14:14.21,Default,,0,0,0,,Бұл өзімнің мойындауым болса да, бұл басқа біреудің арманындай сезіледі, мен түсінемін.
Dialogue: 0,0:14:15.16,0:14:19.00,Default,,0,0,0,,Мердігердің жадын жоғалтқан дұрыс болар еді.
Dialogue: 0,0:14:21.42,0:14:24.50,Default,,0,0,0,,Осындай естеліктер болса да, мен оларды осы уақытқа дейін тастай алмадым.
Dialogue: 0,0:14:25.80,0:14:27.88,Default,,0,0,0,,Егер ол кетсе, мен енді мен болмаймын
Dialogue: 0,0:14:28.49,0:14:32.32,Default,,0,0,0,,Мен де солай сезініп, қорқамын.
Dialogue: 0,0:14:39.89,0:14:44.44,Default,,0,0,0,,Тіпті өшіргіңіз келетін, бірақ өшіре алмайтын сезімдеріңіз бар.
Dialogue: 0,0:14:50.36,0:14:54.83,Default,,0,0,0,,Мердігерлер адам емес; олар адам терісін киген машиналарды өлтіруде.
Dialogue: 0,0:14:56.03,0:14:56.91,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:14:57.37,0:15:02.25,Default,,0,0,0,,Тәуекелді азайту үшін куәгерлерді өлтіру керек
Dialogue: 0,0:15:03.37,0:15:06.17,Default,,0,0,0,,Олар өтірікшілер және сатқындар.
Dialogue: 0,0:15:32.49,0:15:33.40,Default,,0,0,0,,Why here?
Dialogue: 0,0:15:57.51,0:15:58.35,Default,,0,0,0,,Оны ұмыт
Dialogue: 0,0:16:17.16,0:16:21.58,Default,,0,0,0,,Менің атым Такафуджи, маған Мита полиция бөлімшесінен қоңырау соғып, Шиноданы олар тінту кезінде қамауға алды.
Dialogue: 0,0:16:22.41,0:16:24.66,Default,,0,0,0,,Францияға кірген ерлер де көрінді.
Dialogue: 0,0:16:25.33,0:16:26.46,Default,,0,0,0,,Оқиға орнына дереу барыңыз
Dialogue: 0,0:16:26.71,0:16:29.29,Default,,0,0,0,,Түсінікті Көмек сұрау
Dialogue: 0,0:16:30.96,0:16:34.01,Default,,0,0,0,,Астрономиялық бөлім BK201 қызметін растады
Dialogue: 0,0:16:34.51,0:16:34.97,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:36.30,0:16:37.59,Default,,0,0,0,,Менеджер Мацумото.
Dialogue: 0,0:16:38.64,0:16:40.72,Default,,0,0,0,,Чиаки Шиноданың мәйіті расталды.
Dialogue: 0,0:16:42.27,0:16:42.93,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:16:48.52,0:16:50.52,Default,,0,0,0,,Are you standing? Мында кел.
Dialogue: 0,0:17:00.20,0:17:00.91,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:17:26.64,0:17:30.02,Default,,0,0,0,,Contractor? Сен Луис жасаған адамсың.
Dialogue: 0,0:17:36.82,0:17:40.05,Default,,0,0,0,,Сен Луиді өлтірдің бе?
Dialogue: 0,0:17:41.37,0:17:42.16,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:43.49,0:17:43.83,Default,,0,0,0,,Ах.
Dialogue: 0,0:17:44.37,0:17:47.75,Default,,0,0,0,,Мен сізге мердігердің өтірікші екенін айттым.
Dialogue: 0,0:17:49.81,0:17:52.17,Default,,0,0,0,,Егеуқұйрық қақпанға түсіп қалды
Dialogue: 0,0:18:00.82,0:18:03.43,Default,,0,0,0,,Бұл әйел Чиаки Шинода емес.
Dialogue: 0,0:18:03.74,0:18:09.56,Default,,0,0,0,,Бұл ME арқылы Чиаки Шиноданың естеліктері алынған қуыршақ.
Dialogue: 0,0:18:11.40,0:18:15.94,Default,,0,0,0,,Кілтсөзбен бағдарламаланған жазбадан жай ғана кері тартылды
Dialogue: 0,0:18:16.40,0:18:19.99,Default,,0,0,0,,Менің мінезім бәрібір бірнеше күнге ғана созылды.
Dialogue: 0,0:18:20.70,0:18:21.95,Default,,0,0,0,,Бұл тұзақ болды
Dialogue: 0,0:18:22.70,0:18:25.24,Default,,0,0,0,,Сізді еліктіру үшін
Dialogue: 0,0:18:29.91,0:18:32.21,Default,,0,0,0,,Мен бұлай оңай ұсталады деп ойламаппын
Dialogue: 0,0:18:32.79,0:18:34.29,Default,,0,0,0,,Бұл шынымен Луи ме?
Dialogue: 0,0:18:34.59,0:18:38.72,Default,,0,0,0,,Өкінішке орай, қара күртешені тек өзі кие алады.
Dialogue: 0,0:18:38.76,0:18:42.05,Default,,0,0,0,,Ол оқ өткізбейтін. Сіз таң қалдыңыз ба?
Dialogue: 0,0:18:50.48,0:18:51.19,Default,,0,0,0,,Аарон
Dialogue: 0,0:19:32.77,0:19:35.48,Default,,0,0,0,,Бұл алдау болды ма?
Dialogue: 0,0:19:36.56,0:19:39.86,Default,,0,0,0,,Нақты нәрсе басқа жолмен табылды.
Dialogue: 0,0:19:40.36,0:19:43.20,Default,,0,0,0,,Ұйым бәрін білді.
Dialogue: 0,0:19:44.36,0:19:47.16,Default,,0,0,0,,Қуыршақты неге өлтірмедің?
Dialogue: 0,0:19:49.04,0:19:51.70,Default,,0,0,0,,Бұл зең емес, тірі.
Dialogue: 0,0:19:52.58,0:19:55.78,Default,,0,0,0,,Бұл кедей қуыршақ. Бұл пассивті орта.
Dialogue: 0,0:19:56.58,0:20:00.38,Default,,0,0,0,,Ал сіз мердігерлер, өлтіретін машиналардан басқа ештеңе емессіз.
Dialogue: 0,0:20:00.67,0:20:03.31,Default,,0,0,0,,Жүр, Хуан, біз әлі біткен жоқпыз.
Dialogue: 0,0:20:03.63,0:20:05.26,Default,,0,0,0,,Күміс жігіт қайда?
Dialogue: 0,0:20:06.28,0:20:07.78,Default,,0,0,0,,Жіп бекітілген
Dialogue: 0,0:21:11.83,0:21:12.37,Default,,0,0,0,,Иә
Dialogue: 0,0:21:13.04,0:21:15.12,Default,,0,0,0,,Кешіріңіз, бұл полицияға тиесілі.
Dialogue: 0,0:21:15.79,0:21:20.29,Default,,0,0,0,,Мен көрші тұратын Харагучи мырзадан сұрағым келеді.
Dialogue: 0,0:21:21.04,0:21:23.96,Default,,0,0,0,,Сіз ерекше нәрсе байқадыңыз ба?
Dialogue: 0,0:21:24.84,0:21:28.84,Default,,0,0,0,,Мен мұнда жаңа ғана көшіп келдім, ештеңе болған жоқ.
Dialogue: 0,0:21:29.39,0:21:32.18,Default,,0,0,0,,Сіз шетелдіксіз бе? Кешіріңіз.
Dialogue: 0,0:21:32.35,0:21:35.27,Default,,0,0,0,,Шетелдік иммиграциялық тіркеу куәлігіңізді көруге рұқсат етіңіз.
Dialogue: 0,0:21:37.10,0:21:37.73,Default,,0,0,0,,Иә
Dialogue: 0,0:21:39.98,0:21:41.78,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:21:41.94,0:21:46.09,Default,,0,0,0,,Есіңізде бірдеңе болса, бізге осы жерден хабарласыңыз.
Dialogue: 0,0:21:46.94,0:21:47.99,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:21:56.29,0:21:58.27,Default,,0,0,0,,Бастық, не болды?
Dialogue: 0,0:21:59.75,0:22:01.46,Default,,0,0,0,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:22:03.63,0:22:05.00,Default,,0,0,0,,Кеттік, Киото.
Dialogue: 0,0:23:42.60,0:23:45.15,Default,,0,0,0,,Тозақты тұманда қалдыру керек еді
Dialogue: 0,0:23:45.86,0:23:50.40,Default,,0,0,0,,Қабырғадан шыққан көк нұр – артта қалдырған өткенге жол көрсетуші.
Dialogue: 0,0:23:51.07,0:23:54.57,Default,,0,0,0,,Тоқта, баланың кінәсі жоқ.
Dialogue: 0,0:23:55.70,0:23:57.45,Default,,0,0,0,,Айқай бос жерге жоғалады
Dialogue: 0,0:23:57.74,0:24:00.50,Default,,0,0,0,,Жарқыраған жұлдыз – шарттың белгісі
Dialogue: 0,0:24:01.20,0:24:04.17,Default,,0,0,0,,Өшілмейтін мәңгілік қарғыс
Dialogue: 0,0:24:05.04,0:24:07.50,Default,,0,0,0,,Ал жарық сөнеді
Dialogue: 0,0:24:09.00,0:24:15.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
