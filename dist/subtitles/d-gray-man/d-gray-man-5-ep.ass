Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:06.00,Default,,0,0,0,,[Музыка]
Dialogue: 0,0:00:06.00,0:00:11.00,Default,,0,0,0,,Кеуде қуысындағы жарақатта
Dialogue: 0,0:00:11.00,0:00:16.00,Default,,0,0,0,,Толып жатқан қол мен тамағы
Dialogue: 0,0:00:16.00,0:00:22.00,Default,,0,0,0,,Бірін-бірі қайталайтын сәттер
Dialogue: 0,0:00:22.00,0:00:27.00,Default,,0,0,0,,Байланысқан сезімдерді балқыту
Dialogue: 0,0:00:27.00,0:00:32.00,Default,,0,0,0,,Суымайтын қызбамен ауыру
Dialogue: 0,0:00:32.00,0:00:38.00,Default,,0,0,0,,Соңғы дауысты да естімеймін
Dialogue: 0,0:00:38.00,0:00:44.00,Default,,0,0,0,,Бұл жолы мен сені қатты құшақтап алсам, үзіліп кететіндей болдым
Dialogue: 0,0:00:44.00,0:00:49.00,Default,,0,0,0,,Сен қалтырап тұрдың
Dialogue: 0,0:00:49.00,0:00:53.00,Default,,0,0,0,,Алақанда
Dialogue: 0,0:00:53.00,0:00:57.00,Default,,0,0,0,,Маған қол тигізуге рұқсат етіңіз
Dialogue: 0,0:00:57.00,0:01:01.00,Default,,0,0,0,,Сіз оны іздегеніңізге сенімдімін.
Dialogue: 0,0:01:01.00,0:01:08.00,Default,,0,0,0,,Ешқашан өшпейтін ғажайыптың есімі
Dialogue: 0,0:01:08.00,0:01:17.00,Default,,0,0,0,,Маған алақаныңызбен қаттырақ тигізіңіз
Dialogue: 0,0:01:18.00,0:01:22.00,Default,,0,0,0,,Әр деңгей жоғары
Dialogue: 0,0:01:22.00,0:01:28.00,Default,,0,0,0,,Келесі
Dialogue: 0,0:01:48.00,0:01:53.00,Default,,0,0,0,,Бұл баяғыда қираған қала екеніне сенімдімін.
Dialogue: 0,0:01:53.00,0:01:56.00,Default,,0,0,0,,Мақсатты заттың елесі
Dialogue: 0,0:01:56.00,0:01:57.00,Default,,0,0,0,,Елес?
Dialogue: 0,0:01:57.00,0:02:01.00,Default,,0,0,0,,Топан су кезіндегі кінәсіздік
Dialogue: 0,0:02:01.00,0:02:06.00,Default,,0,0,0,,Қазіргі заманға дейін ол әртүрлі күйлерге жиі өзгерді.
Dialogue: 0,0:02:06.00,0:02:10.00,Default,,0,0,0,,Және ол әрқашан механикалық құбылыстарды тудырады.
Dialogue: 0,0:02:10.00,0:02:12.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:12.00,0:02:14.00,Default,,0,0,0,,Екі адам...
Dialogue: 0,0:02:14.00,0:02:19.00,Default,,0,0,0,,Мен сені бейнеледім... сенің күшіңді!
Dialogue: 0,0:02:20.00,0:02:23.00,Default,,0,0,0,,Бұл бас шайтан! Кандер!
Dialogue: 0,0:02:23.00,0:02:25.00,Default,,0,0,0,,Өл!
Dialogue: 0,0:02:41.00,0:02:44.00,Default,,0,0,0,,Сен қуыршақсың...
Dialogue: 0,0:02:44.00,0:02:47.00,Default,,0,0,0,,Бұл Матердің елесі еді.
Dialogue: 0,0:02:53.00,0:02:54.00,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:03:24.00,0:03:27.00,Default,,0,0,0,,Егер жағдай болса, маған хабарлаңыз.
Dialogue: 0,0:03:28.00,0:03:31.00,Default,,0,0,0,,Сүйкімді қыздармен күресуге болмайды.
Dialogue: 0,0:03:41.00,0:03:44.00,Default,,0,0,0,,Гузор жақында өледі.
Dialogue: 0,0:03:44.00,0:03:47.00,Default,,0,0,0,,Оған дейін мені тастап кетпе
Dialogue: 0,0:03:47.00,0:03:51.00,Default,,0,0,0,,Мен саған бұл жүректі бере аламын!
Dialogue: 0,0:03:53.00,0:03:59.00,Default,,0,0,0,,Матер қаласы Құдайдың ұмытылған жері деп аталғанын білесіз бе?
Dialogue: 0,0:03:59.00,0:04:01.00,Default,,0,0,0,,Иә, мен естідім.
Dialogue: 0,0:04:01.00,0:04:07.00,Default,,0,0,0,,Бұл қалада тұратын адамдар қатал климат пен күшті күн сәулесінен аулақ болу үшін
Dialogue: 0,0:04:07.00,0:04:10.00,Default,,0,0,0,,Олар резиденциясын жер астында кеңейтті.
Dialogue: 0,0:04:10.00,0:04:13.00,Default,,0,0,0,,Ұзақ, ұзақ уақыт қазуды жалғастырыңыз
Dialogue: 0,0:04:13.00,0:04:18.00,Default,,0,0,0,,Олар алда не күтіп тұрғанын тапты.
Dialogue: 0,0:04:23.00,0:04:28.00,Default,,0,0,0,,Үмітсіздік пен қасірет, бұл Матер қаласы жойылуға бет алды.
Dialogue: 0,0:04:28.00,0:04:33.00,Default,,0,0,0,,Сол азапты күндерді бір сәтке ғана ұмыттыратын қуыршақ.
Dialogue: 0,0:04:33.00,0:04:36.00,Default,,0,0,0,,Олар жасап жатты
Dialogue: 0,0:04:36.00,0:04:40.00,Default,,0,0,0,,Би билейтін және ән салатын қуыршақтар
Dialogue: 0,0:04:54.00,0:04:58.00,Default,,0,0,0,,Бірнеше жүз жылдан кейін қала қирады.
Dialogue: 0,0:04:58.00,0:05:01.00,Default,,0,0,0,,Ән тыңдайтын адам болмаса да
Dialogue: 0,0:05:01.00,0:05:06.00,Default,,0,0,0,,Бір ғана қуыршақ қозғала берді.
Dialogue: 0,0:05:06.00,0:05:12.00,Default,,0,0,0,,Бір күні Матер қаласына бір бала келді.
Dialogue: 0,0:05:12.00,0:05:20.00,Default,,0,0,0,,Ол қираған қалаға қирау кезеңінің соңында ешкімнің көмегінсіз келді.
Dialogue: 0,0:05:24.00,0:05:29.00,Default,,0,0,0,,Боуя, сен ән айтқың келе ме?
Dialogue: 0,0:05:32.00,0:05:36.00,Default,,0,0,0,,Боуя, сен ән айтқың келе ме?
Dialogue: 0,0:05:36.00,0:05:40.00,Default,,0,0,0,,Матер қаласының қирағанына 500 жыл
Dialogue: 0,0:05:40.00,0:05:44.00,Default,,0,0,0,,Адамдардың бұл қалаға алғаш рет келуі емес еді.
Dialogue: 0,0:05:44.00,0:05:47.00,Default,,0,0,0,,Мен осы уақытқа дейін 5 ересек адаммен кездестім.
Dialogue: 0,0:05:47.00,0:05:53.00,Default,,0,0,0,,Ән айтқысы келе ме деп сұрағанда, бәрі маған шапты.
Dialogue: 0,0:05:53.00,0:05:57.00,Default,,0,0,0,,Сондықтан мен бұл баланы да солай деп ойладым.
Dialogue: 0,0:05:57.00,0:06:01.00,Default,,0,0,0,,Мені қабылдамасаң, мен сені өлтіремін.
Dialogue: 0,0:06:01.00,0:06:04.00,Default,,0,0,0,,Бұрынғы ересектер сияқты
Dialogue: 0,0:06:04.00,0:06:07.00,Default,,0,0,0,,Боуя, сен ән айтқың келе ме?
Dialogue: 0,0:06:08.00,0:06:11.00,Default,,0,0,0,,Мен адам қуыршақпын
Dialogue: 0,0:06:11.00,0:06:15.00,Default,,0,0,0,,Менің бар болу себебім – адамзат үшін еңбек ету.
Dialogue: 0,0:06:15.00,0:06:18.00,Default,,0,0,0,,Өтінемін, ән айтайыншы
Dialogue: 0,0:06:18.00,0:06:20.00,Default,,0,0,0,,Мистер Боули
Dialogue: 0,0:06:20.00,0:06:23.00,Default,,0,0,0,,Маған ән айтасың ба?
Dialogue: 0,0:06:23.00,0:06:27.00,Default,,0,0,0,,Маған бұрын ешкім бұлай істеген емес.
Dialogue: 0,0:06:27.00,0:06:29.00,Default,,0,0,0,,Менің атым Гузол.
Dialogue: 0,0:06:29.00,0:06:32.00,Default,,0,0,0,,Әй, ән айт, мистер Боули.
Dialogue: 0,0:06:45.00,0:06:49.00,Default,,0,0,0,,Қарашы, сен қазір сондай әдемісің, Лала.
Dialogue: 0,0:06:49.00,0:06:53.00,Default,,0,0,0,,Мен сізді осылай атай аламын ба, Мистер Боули?
Dialogue: 0,0:06:56.00,0:07:01.00,Default,,0,0,0,,Сол күннен бері ондаған жылдар бойы Гузор менімен бірге болды.
Dialogue: 0,0:07:03.00,0:07:07.00,Default,,0,0,0,,Гузол, жақсысың ба, Гузол?
Dialogue: 0,0:07:08.00,0:07:12.00,Default,,0,0,0,,Лара, менің жанымда мәңгі болшы.
Dialogue: 0,0:07:12.00,0:07:18.00,Default,,0,0,0,,Ал мен өлсем, қолым сені тоқтатсын
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,Иә, Гузор
Dialogue: 0,0:07:20.00,0:07:24.00,Default,,0,0,0,,Мен Гузордың қуыршағымын
Dialogue: 0,0:07:24.00,0:07:27.00,Default,,0,0,0,,Гузор көп ұзамай қозғалуды тоқтатады.
Dialogue: 0,0:07:27.00,0:07:31.00,Default,,0,0,0,,Жүрек тондары күшейіп, тынышталады
Dialogue: 0,0:07:31.00,0:07:36.00,Default,,0,0,0,,Олай болса, мен сенімен соңына дейін тағы біраз қалуға рұқсат етемін.
Dialogue: 0,0:07:36.00,0:07:40.00,Default,,0,0,0,,Матер қаласы жойылғаннан бері 500 адам болды.
Dialogue: 0,0:07:40.00,0:07:44.00,Default,,0,0,0,,Матер қаласы жойылғаннан кейін 500 жыл бойы
Dialogue: 0,0:07:44.00,0:07:48.00,Default,,0,0,0,,Гузор ғана мені қуыршақ ретінде қабылдады.
Dialogue: 0,0:07:48.00,0:07:52.00,Default,,0,0,0,,Гүзөл өлсе, жүрегімді өзіңмен ала аласың.
Dialogue: 0,0:07:52.00,0:07:56.00,Default,,0,0,0,,Сондықтан мен сені соңына дейін Гузолдың қуыршағы болуға рұқсат етемін.
Dialogue: 0,0:07:56.00,0:07:58.00,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:08:02.00,0:08:04.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:08:05.00,0:08:08.00,Default,,0,0,0,,Қарт өлгенше күте тұр дедім.
Dialogue: 0,0:08:08.00,0:08:12.00,Default,,0,0,0,,Ібілістің қашан келетінін білмейтін мына жағдайда, оған уақытымыз жоқ.
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,Қанда
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Біз мұнда не үшін келдік?
Dialogue: 0,0:08:16.00,0:08:19.00,Default,,0,0,0,,Қазір қуыршақтың жүрегін алыңыз.
Dialogue: 0,0:08:28.00,0:08:30.00,Default,,0,0,0,,қабылдау мүмкін емес
Dialogue: 0,0:08:31.00,0:08:35.00,Default,,0,0,0,,Кешіріңіз, мен оны алғым келмейді.
Dialogue: 0,0:08:35.00,0:08:39.00,Default,,0,0,0,,Бұл пальто жарақат алған адамға жастық ретінде пайдалануға арналмаған.
Dialogue: 0,0:08:39.00,0:08:42.00,Default,,0,0,0,,Жын шығаратын адам қандай киім киер еді
Dialogue: 0,0:08:46.00,0:08:50.00,Default,,0,0,0,,Құрбандықтың арқасында құтқарылу бар, жаңадан келген адам.
Dialogue: 0,0:08:50.00,0:08:54.00,Default,,0,0,0,,Өтінемін, алып кетпеңіз
Dialogue: 0,0:08:55.00,0:08:57.00,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:58.00,0:09:01.00,Default,,0,0,0,,Сосын мен звондаймын.
Dialogue: 0,0:09:01.00,0:09:04.00,Default,,0,0,0,,Осы екеуінің құрбаны болуым керек пе?
Dialogue: 0,0:09:04.00,0:09:09.00,Default,,0,0,0,,Олар тек өздері қалаған соңды қалайды.
Dialogue: 0,0:09:09.00,0:09:13.00,Default,,0,0,0,,Оған дейін мен бұл қуыршақтан жақсы дәм алмаймын.
Dialogue: 0,0:09:13.00,0:09:16.00,Default,,0,0,0,,Мен шайтанды жойсам, еш қиындық болмайды.
Dialogue: 0,0:09:16.00,0:09:20.00,Default,,0,0,0,,Құрбандық арқылы ғана жеңуге болатын соғыс жай ғана мағынасыз.
Dialogue: 0,0:09:24.00,0:09:27.00,Default,,0,0,0,,Лорд Канда, Лорд Уокер
Dialogue: 0,0:09:27.00,0:09:33.00,Default,,0,0,0,,Бұл керемет аңғал. Өзіңді аясаң, біреу үшін өзіңді тепкілейсің.
Dialogue: 0,0:09:33.00,0:09:36.00,Default,,0,0,0,,Маңызды ештеңе жоқ па?
Dialogue: 0,0:09:36.00,0:09:40.00,Default,,0,0,0,,Мен әлдеқашан маңызды нәрсені жоғалтып алдым.
Dialogue: 0,0:09:40.00,0:09:45.00,Default,,0,0,0,,Менде сені аяуға негіз жоқ.
Dialogue: 0,0:09:45.00,0:09:50.00,Default,,0,0,0,,Мен мұндай нәрсені көргім келмейді, бар болғаны.
Dialogue: 0,0:09:50.00,0:09:55.00,Default,,0,0,0,,Мен кішкентай адам емеспін, жүрегімде
Dialogue: 0,0:09:55.00,0:09:59.00,Default,,0,0,0,,Мен кішкентай адам болғандықтан, үлкен дүниеден артықпын.
Dialogue: 0,0:09:59.00,0:10:03.00,Default,,0,0,0,,Жүрегім көз алдымда тұрған нәрсеге, Қиып тастай алмаймын.
Dialogue: 0,0:10:03.00,0:10:06.00,Default,,0,0,0,,Сондықтан қолымнан келсе қорғағым келеді.
Dialogue: 0,0:10:13.00,0:10:15.00,Default,,0,0,0,,Кусол
Dialogue: 0,0:10:26.00,0:10:28.00,Default,,0,0,0,,Бұл ол
Dialogue: 0,0:10:33.00,0:10:35.00,Default,,0,0,0,,Кінәсіздік Морай
Dialogue: 0,0:10:42.00,0:10:45.00,Default,,0,0,0,,Ла, лала, лала
Dialogue: 0,0:10:49.00,0:10:52.00,Default,,0,0,0,,Әй, бұл кінәсіздік пе?
Dialogue: 0,0:10:56.00,0:10:58.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:10.00,0:11:13.00,Default,,0,0,0,,Бұл кінәсіздікті қайтарыңыз
Dialogue: 0,0:11:15.00,0:11:17.00,Default,,0,0,0,,Қайта бер.
Dialogue: 0,0:11:17.00,0:11:19.00,Default,,0,0,0,,Уокер мырзаның шайтанға қарсы қаруы
Dialogue: 0,0:11:20.00,0:11:22.00,Default,,0,0,0,,Мен оны қайта жасауды жоспарлап отырмын.
Dialogue: 0,0:11:22.00,0:11:25.00,Default,,0,0,0,,Құрбандық типтегі эксзорцистер қаруды эмоциямен басқара алады.
Dialogue: 0,0:11:25.00,0:11:29.00,Default,,0,0,0,,Кінәсіз оның ашуына жауап беріп, бас тартты.
Dialogue: 0,0:11:29.00,0:11:33.00,Default,,0,0,0,,Соған қарамастан, бұл жігіттің өлтіру ниеті қандай ақылсыз.
Dialogue: 0,0:11:33.00,0:11:35.00,Default,,0,0,0,,Қару жоқ.
Dialogue: 0,0:11:35.00,0:11:37.00,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:11:37.00,0:11:39.00,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:11:39.00,0:11:41.00,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:11:41.00,0:11:43.00,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:11:45.00,0:11:47.00,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:11:47.00,0:11:49.00,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:11:49.00,0:11:51.00,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:11:51.00,0:11:53.00,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:11:55.00,0:11:57.00,Default,,0,0,0,,Қару әлі пішімделмеген болса да
Dialogue: 0,0:12:03.00,0:12:05.00,Default,,0,0,0,,Егер бұл мылтық болса
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0,0,0,,болды
Dialogue: 0,0:12:15.00,0:12:16.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:18.00,0:12:19.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:28.00,0:12:29.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:31.00,0:12:32.00,Default,,0,0,0,,Уфуфуфу…
Dialogue: 0,0:12:32.00,0:12:35.00,Default,,0,0,0,,Сондықтан мен құмға айналдым, сондықтан мен оны бұза алмаймын ...
Dialogue: 0,0:12:37.00,0:12:38.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:39.00,0:12:40.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:41.00,0:12:42.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:42.00,0:12:43.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:44.00,0:12:45.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:45.00,0:12:50.00,Default,,0,0,0,,Хахахаха...Мен сені ұстадым! Енді мұны істей алмайсың! Енді мұны істей алмайсың!
Dialogue: 0,0:12:52.00,0:12:55.00,Default,,0,0,0,,Менің өлгеніме қанша уақыт керек екен...
Dialogue: 0,0:12:57.00,0:12:58.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:58.00,0:12:59.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:59.00,0:13:00.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:00.00,0:13:02.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:02.00,0:13:03.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:03.00,0:13:04.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:04.00,0:13:05.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:05.00,0:13:06.00,Default,,0,0,0,,Окатаро!
Dialogue: 0,0:13:06.00,0:13:10.00,Default,,0,0,0,,Жарайды... оның кісі өлтіру ниеті... жойылған жоқ...
Dialogue: 0,0:13:10.00,0:13:11.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:11.00,0:13:12.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:13.00,0:13:14.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:14.00,0:13:16.00,Default,,0,0,0,,Увааааааааааааааааааааааа!
Dialogue: 0,0:13:17.00,0:13:19.00,Default,,0,0,0,,Ол сені іште атып тастады ма?
Dialogue: 0,0:13:20.00,0:13:21.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:25.00,0:13:26.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:26.00,0:13:37.00,Default,,0,0,0,,Кінәсіздік байыптылықты жеткізеді және миға тікелей үйретеді...Ми денені қозғалтады...Жаңа...жамандық қаруын қалай қолдану керек...
Dialogue: 0,0:13:37.00,0:13:39.00,Default,,0,0,0,,Бұл жолы... қылыш!
Dialogue: 0,0:13:39.00,0:13:40.00,Default,,0,0,0,,(Оқушы) Қайырлы таң. (Оқушы) Қайырлы таң. Ой, күйіп кеткен екен!
Dialogue: 0,0:13:44.00,0:13:45.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:49.00,0:13:53.00,Default,,0,0,0,,Құм... құм терісі...
Dialogue: 0,0:13:54.00,0:14:07.00,Default,,0,0,0,,ең жылдам
Dialogue: 0,0:14:09.00,0:14:12.00,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:14:17.00,0:14:20.00,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:14:21.00,0:14:23.00,Default,,0,0,0,,Мәңгілік қасымда болшы
Dialogue: 0,0:14:23.00,0:14:26.00,Default,,0,0,0,,Ал мен өлгенде
Dialogue: 0,0:14:26.00,0:14:30.00,Default,,0,0,0,,Менің қолым сені тоқтатсын
Dialogue: 0,0:14:31.00,0:14:35.00,Default,,0,0,0,,Әлгі қарғыс атқыр әйел Лаланы жақсы көрді.
Dialogue: 0,0:14:35.00,0:14:37.00,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:14:39.00,0:14:42.00,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:14:43.00,0:14:46.00,Default,,0,0,0,,Қарғыс атсын, неге?
Dialogue: 0,0:14:46.00,0:14:48.00,Default,,0,0,0,,Баяғы жігіттің қолы болса да
Dialogue: 0,0:14:48.00,0:14:51.00,Default,,0,0,0,,Неліктен жеңілемін деп ойлайсың?
Dialogue: 0,0:14:51.00,0:14:54.00,Default,,0,0,0,,Бұл сіздің шегіңіз.
Dialogue: 0,0:14:54.00,0:14:57.00,Default,,0,0,0,,Бір қару болса да, оны әртүрлі адамдар қолданады.
Dialogue: 0,0:14:57.00,0:14:59.00,Default,,0,0,0,,Музыкаға қарсы қаруды кім шынымен қолдана алады?
Dialogue: 0,0:14:59.00,0:15:03.00,Default,,0,0,0,,Бейкүнәсіздікпен үйлесімді тек эксзорцистер
Dialogue: 0,0:15:03.00,0:15:06.00,Default,,0,0,0,,Кінәсіздікпен синхронизацияланған сайын
Dialogue: 0,0:15:06.00,0:15:09.00,Default,,0,0,0,,Эксорцист күшейеді
Dialogue: 0,0:15:23.00,0:15:25.00,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:15:25.00,0:15:27.00,Default,,0,0,0,,Қайта серпілу
Dialogue: 0,0:15:27.00,0:15:30.00,Default,,0,0,0,,Сіздің денеңіз өскен қаруды ұстай алмай жатыр ма?
Dialogue: 0,0:15:36.00,0:15:39.00,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:15:43.00,0:15:45.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:15:51.00,0:15:53.00,Default,,0,0,0,,тістеген
Dialogue: 0,0:15:53.00,0:15:55.00,Default,,0,0,0,,Бұл ақылсыз нәрсе
Dialogue: 0,0:15:55.00,0:15:58.00,Default,,0,0,0,,Мұндай кірден жалықпаңыз.
Dialogue: 0,0:15:58.00,0:16:01.00,Default,,0,0,0,,Осы қарқынмен өмір бойы жанып кетесің.
Dialogue: 0,0:16:01.00,0:16:03.00,Default,,0,0,0,,Сол екі адамды кім қорғап, соттаған?
Dialogue: 0,0:16:03.00,0:16:05.00,Default,,0,0,0,,Теми, солай ма?
Dialogue: 0,0:16:05.00,0:16:08.00,Default,,0,0,0,,Мен сен сияқты тәттілерді жек көремін.
Dialogue: 0,0:16:08.00,0:16:10.00,Default,,0,0,0,,Айтқанында тұрмайтындар
Dialogue: 0,0:16:10.00,0:16:13.00,Default,,0,0,0,,Мен оны одан сайын жек көремін
Dialogue: 0,0:16:14.00,0:16:18.00,Default,,0,0,0,,Сізге бұл екі жағдайда да ұнамайтын шығар.
Dialogue: 0,0:16:18.00,0:16:22.00,Default,,0,0,0,,Бұл жерде ерекше ештеңе жоқ.
Dialogue: 0,0:16:22.00,0:16:26.00,Default,,0,0,0,,Мен аз ғана үзіліс алдым.
Dialogue: 0,0:16:26.00,0:16:29.00,Default,,0,0,0,,Ол үнемі тітіркендіргіш.
Dialogue: 0,0:16:29.00,0:16:33.00,Default,,0,0,0,,Оны тағы бір рет алыңыз.
Dialogue: 0,0:16:33.00,0:16:37.00,Default,,0,0,0,,Кінәсіздік іске қосылды
Dialogue: 0,0:16:39.00,0:16:42.00,Default,,0,0,0,,Кайдзю Ичиген
Dialogue: 0,0:16:43.00,0:16:46.00,Default,,0,0,0,,Оны өшіріңіз
Dialogue: 0,0:16:51.00,0:16:54.00,Default,,0,0,0,,Оны өшіріңіз
Dialogue: 0,0:16:54.00,0:16:57.00,Default,,0,0,0,,Оны өшіріңіз
Dialogue: 0,0:17:24.00,0:17:27.00,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:17:27.00,0:17:30.00,Default,,0,0,0,,Тағы да Лараға
Dialogue: 0,0:17:36.00,0:17:38.00,Default,,0,0,0,,Адамдар
Dialogue: 0,0:17:38.00,0:17:41.00,Default,,0,0,0,,Ән айтқыңыз келе ме?
Dialogue: 0,0:17:41.00,0:17:43.00,Default,,0,0,0,,Ән
Dialogue: 0,0:17:43.00,0:17:45.00,Default,,0,0,0,,Ән
Dialogue: 0,0:17:45.00,0:17:47.00,Default,,0,0,0,,Ән
Dialogue: 0,0:17:47.00,0:17:49.00,Default,,0,0,0,,Ән
Dialogue: 0,0:17:49.00,0:17:51.00,Default,,0,0,0,,Ән
Dialogue: 0,0:17:51.00,0:17:53.00,Default,,0,0,0,,Ән
Dialogue: 0,0:17:53.00,0:17:56.00,Default,,0,0,0,,Ән туралы не айтасыз?
Dialogue: 0,0:18:03.00,0:18:05.00,Default,,0,0,0,,Адам
Dialogue: 0,0:18:07.00,0:18:09.00,Default,,0,0,0,,Ән
Dialogue: 0,0:18:09.00,0:18:11.00,Default,,0,0,0,,Ән айту
Dialogue: 0,0:18:15.00,0:18:17.00,Default,,0,0,0,,Ән
Dialogue: 0,0:18:17.00,0:18:19.00,Default,,0,0,0,,Ән айту
Dialogue: 0,0:18:20.00,0:18:22.00,Default,,0,0,0,,Ән айту
Dialogue: 0,0:18:22.00,0:18:26.00,Default,,0,0,0,,Лала...Мен сені жақсы көремін
Dialogue: 0,0:18:30.00,0:18:32.00,Default,,0,0,0,,Сіз ұйықтайсыз ба?
Dialogue: 0,0:18:34.00,0:18:38.00,Default,,0,0,0,,Енді бесік жырын айтайық
Dialogue: 0,0:18:52.00,0:18:56.00,Default,,0,0,0,,Неге ұйықтап жатырсың? Сізді мұқият қадағалаңыз.
Dialogue: 0,0:18:56.00,0:18:58.00,Default,,0,0,0,,Жара туралы не деуге болады?
Dialogue: 0,0:18:58.00,0:19:00.00,Default,,0,0,0,,Мен тез сауығып кетемін.
Dialogue: 0,0:19:00.00,0:19:03.00,Default,,0,0,0,,Қалай қарасаңыз да, толық қалпына келу үшін 5 ай керек...
Dialogue: 0,0:19:03.00,0:19:05.00,Default,,0,0,0,,Урус
Dialogue: 0,0:19:05.00,0:19:08.00,Default,,0,0,0,,Мен культпен жаңа ғана байланысқа шықтым.
Dialogue: 0,0:19:08.00,0:19:10.00,Default,,0,0,0,,Бұл күтушінің бұйрығы.
Dialogue: 0,0:19:10.00,0:19:12.00,Default,,0,0,0,,Мен келесі тапсырмаға барамын.
Dialogue: 0,0:19:12.00,0:19:14.00,Default,,0,0,0,,Сіз бұлай өлмейсіз.
Dialogue: 0,0:19:14.00,0:19:16.00,Default,,0,0,0,,Сен бұлай өлмейсің.
Dialogue: 0,0:19:16.00,0:19:18.00,Default,,0,0,0,,Сіз бұлай өлмейсіз.
Dialogue: 0,0:19:18.00,0:19:20.00,Default,,0,0,0,,Сен бұлай өлмейсің.
Dialogue: 0,0:19:20.00,0:19:22.00,Default,,0,0,0,,Мен келесі тапсырмаға барамын.
Dialogue: 0,0:19:22.00,0:19:25.00,Default,,0,0,0,,Сіз Innocence-ті штабқа жеткізуіңіз керек.
Dialogue: 0,0:19:25.00,0:19:27.00,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:30.00,0:19:33.00,Default,,0,0,0,,Егер ол ауырса, қуыршақты тоқтатыңыз.
Dialogue: 0,0:19:33.00,0:19:35.00,Default,,0,0,0,,Бұл енді Лала емес, солай ма?
Dialogue: 0,0:19:35.00,0:19:38.00,Default,,0,0,0,,Бұл екеуміздің арамыздағы уәде.
Dialogue: 0,0:19:38.00,0:19:40.00,Default,,0,0,0,,Лараны тоқтату үшін
Dialogue: 0,0:19:40.00,0:19:42.00,Default,,0,0,0,,Гузор мырза болмаса, жақсы емес.
Dialogue: 0,0:19:44.00,0:19:46.00,Default,,0,0,0,,Сен сондай тәттісің.
Dialogue: 0,0:19:47.00,0:19:50.00,Default,,0,0,0,,Біз жын шығарушылар жойғышпыз.
Dialogue: 0,0:19:50.00,0:19:52.00,Default,,0,0,0,,Мен құтқарушы емеспін.
Dialogue: 0,0:19:53.00,0:19:55.00,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:19:55.00,0:19:57.00,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:20:10.00,0:20:13.00,Default,,0,0,0,,Гузол өлгеннен кейінгі үшінші түн
Dialogue: 0,0:20:14.00,0:20:16.00,Default,,0,0,0,,Лара тоқтады.
Dialogue: 0,0:20:25.00,0:20:27.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:28.00,0:20:31.00,Default,,0,0,0,,Үзілгенше ән айтайын
Dialogue: 0,0:20:32.00,0:20:35.00,Default,,0,0,0,,Енді мен уәдемді орындай аламын.
Dialogue: 0,0:20:43.00,0:20:45.00,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:20:48.00,0:20:50.00,Default,,0,0,0,,тістеген
Dialogue: 0,0:20:51.00,0:20:53.00,Default,,0,0,0,,Демек, Хигучи Кира емес болып шықты ғой?
Dialogue: 0,0:20:53.00,0:20:56.00,Default,,0,0,0,,Мен біреуді құтқара алатын жойғыш болғым келеді
Dialogue: 0,0:21:13.00,0:21:16.00,Default,,0,0,0,,Гузол өлгеннен кейінгі үшінші түн
Dialogue: 0,0:21:25.00,0:21:30.00,Default,,0,0,0,,Тоңған ернімді тістеп
Dialogue: 0,0:21:31.00,0:21:36.00,Default,,0,0,0,,Екі адам, иық тірестіру
Dialogue: 0,0:21:37.00,0:21:42.00,Default,,0,0,0,,Мен сені соңғы рет көрдім
Dialogue: 0,0:21:43.00,0:21:48.00,Default,,0,0,0,,Жадтың тереңінде жасырылған
Dialogue: 0,0:21:50.00,0:21:55.00,Default,,0,0,0,,Көлде
Dialogue: 0,0:21:56.00,0:22:02.00,Default,,0,0,0,,Сол жүрген ғажайып жас
Dialogue: 0,0:22:02.00,0:22:06.00,Default,,0,0,0,,Сонымен, ол осындай
Dialogue: 0,0:22:06.00,0:22:13.00,Default,,0,0,0,,Менімен қоштаспа
Dialogue: 0,0:22:14.00,0:22:16.00,Default,,0,0,0,,Махаббат
Dialogue: 0,0:22:17.00,0:22:20.00,Default,,0,0,0,,Сезіміңді түсіне алмаймын
Dialogue: 0,0:22:20.00,0:22:22.00,Default,,0,0,0,,Жара осындай
Dialogue: 0,0:22:23.00,0:22:25.00,Default,,0,0,0,,Өшірмеңіз
Dialogue: 0,0:22:26.00,0:22:28.00,Default,,0,0,0,,Өшірмеңіз
Dialogue: 0,0:22:28.00,0:22:30.00,Default,,0,0,0,,Келесі жолы, D Gray Man
Dialogue: 0,0:22:30.00,0:22:32.00,Default,,0,0,0,,Уондервайға қоңырау шалатын адам
Dialogue: 0,0:22:32.00,0:22:35.00,Default,,0,0,0,,Жандарды бейшара шайтандарға құтқару
Dialogue: 0,0:22:36.50,0:22:42.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory