Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:06.00,Default,,0,0,0,,- Ән, композиция, аранжировка-
Dialogue: 0,0:00:06.00,0:00:11.00,Default,,0,0,0,,Кеуде қуысындағы жарақатта
Dialogue: 0,0:00:11.00,0:00:16.00,Default,,0,0,0,,Толып жатқан қол мен тамағы
Dialogue: 0,0:00:16.00,0:00:22.00,Default,,0,0,0,,Бірін-бірі қайталайтын сәттер
Dialogue: 0,0:00:22.00,0:00:27.00,Default,,0,0,0,,Байланысқан сезімдерді балқыту
Dialogue: 0,0:00:27.00,0:00:32.00,Default,,0,0,0,,Ешқашан суымайтын ыстықпен жылыған
Dialogue: 0,0:00:32.00,0:00:38.00,Default,,0,0,0,,Соңғы дауысты да естімеймін
Dialogue: 0,0:00:38.00,0:00:44.00,Default,,0,0,0,,Бұл жолы мен сені қатты құшақтап алсам, үзіліп кететіндей болдым
Dialogue: 0,0:00:44.00,0:00:49.00,Default,,0,0,0,,Сен қалтырап тұрдың
Dialogue: 0,0:00:49.00,0:00:53.00,Default,,0,0,0,,Алақанда
Dialogue: 0,0:00:53.00,0:00:57.00,Default,,0,0,0,,Маған қол тигізуге рұқсат етіңіз
Dialogue: 0,0:00:57.00,0:01:01.00,Default,,0,0,0,,Сіз оны іздегеніңізге сенімдімін.
Dialogue: 0,0:01:01.00,0:01:08.00,Default,,0,0,0,,Ешқашан өшпейтін ғажайыптың есімі
Dialogue: 0,0:01:08.00,0:01:17.00,Default,,0,0,0,,Маған алақаныңызбен қаттырақ тигізіңіз
Dialogue: 0,0:01:18.00,0:01:22.00,Default,,0,0,0,,Ешқашан аяқталмайды
Dialogue: 0,0:01:22.00,0:01:28.00,Default,,0,0,0,,Фаллоуэй босатылды
Dialogue: 0,0:01:47.00,0:01:49.00,Default,,0,0,0,,Адамдар ашқан
Dialogue: 0,0:01:49.00,0:01:53.00,Default,,0,0,0,,Әртүрлі формада болуы мүмкін
Dialogue: 0,0:01:53.00,0:01:56.00,Default,,0,0,0,,Мен неге екенін білмеймін
Dialogue: 0,0:01:56.00,0:01:59.00,Default,,0,0,0,,Ол әрқашан механикалық құбылыстарды тудырады.
Dialogue: 0,0:01:59.00,0:02:01.00,Default,,0,0,0,,Лорд Уокер
Dialogue: 0,0:02:01.00,0:02:04.00,Default,,0,0,0,,Матер елесі туралы әңгімені білесіз бе?
Dialogue: 0,0:02:04.00,0:02:05.00,Default,,0,0,0,,- Жоқ
Dialogue: 0,0:02:05.00,0:02:07.00,Default,,0,0,0,,Міне
Dialogue: 0,0:02:07.00,0:02:11.00,Default,,0,0,0,,Ертеде қираған Матер қаласында елес тұрады.
Dialogue: 0,0:02:11.00,0:02:15.00,Default,,0,0,0,,Елес - Матер қаласының бұрынғы тұрғыны.
Dialogue: 0,0:02:15.00,0:02:17.00,Default,,0,0,0,,Жалғыздықты емдеу
Dialogue: 0,0:02:17.00,0:02:21.00,Default,,0,0,0,,Қалаға жақындаған адамдарды сүйреткенде
Dialogue: 0,0:02:28.00,0:02:30.00,Default,,0,0,0,,Кінәсіздік
Dialogue: 0,0:02:30.00,0:02:32.00,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:02:33.00,0:02:35.00,Default,,0,0,0,,Шексіз
Dialogue: 0,0:02:35.00,0:02:37.00,Default,,0,0,0,,Ең нашар болашақ
Dialogue: 0,0:02:38.00,0:02:40.00,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:02:40.00,0:02:42.00,Default,,0,0,0,,Әлем
Dialogue: 0,0:02:42.00,0:02:44.00,Default,,0,0,0,,Ичимару
Dialogue: 0,0:02:52.00,0:02:55.00,Default,,0,0,0,,Сен маған көмектесуге келдің.
Dialogue: 0,0:02:56.00,0:02:58.00,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:02:58.00,0:03:01.00,Default,,0,0,0,,Матер елесі
Dialogue: 0,0:03:07.00,0:03:09.00,Default,,0,0,0,,Матер елесі
Dialogue: 0,0:03:11.00,0:03:12.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:12.00,0:03:14.00,Default,,0,0,0,,Бұл шайтан емес
Dialogue: 0,0:03:14.00,0:03:15.00,Default,,0,0,0,,Жалған?
Dialogue: 0,0:03:15.00,0:03:17.00,Default,,0,0,0,,осында
Dialogue: 0,0:03:17.00,0:03:19.00,Default,,0,0,0,,осында
Dialogue: 0,0:03:29.00,0:03:31.00,Default,,0,0,0,,I
Dialogue: 0,0:03:34.00,0:03:36.00,Default,,0,0,0,,2 адам
Dialogue: 0,0:03:37.00,0:03:38.00,Default,,0,0,0,,2 адам
Dialogue: 0,0:03:42.00,0:03:44.00,Default,,0,0,0,,Мен мұнда не үшін келдім?
Dialogue: 0,0:03:44.00,0:03:46.00,Default,,0,0,0,,Мен көрсеттім.
Dialogue: 0,0:03:46.00,0:03:47.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:03:47.00,0:03:49.00,Default,,0,0,0,,Сіздің күшіңіз
Dialogue: 0,0:03:52.00,0:03:55.00,Default,,0,0,0,,Бұл менің қабілетім
Dialogue: 0,0:03:55.00,0:03:57.00,Default,,0,0,0,,Жын 2-деңгейге дейін дамыды
Dialogue: 0,0:03:57.00,0:04:00.00,Default,,0,0,0,,Жаңа қабілеттерді ояту
Dialogue: 0,0:04:00.00,0:04:03.00,Default,,0,0,0,,Ал менің қабілетім
Dialogue: 0,0:04:03.00,0:04:05.00,Default,,0,0,0,,Қолыңызды тигізетін нәрсені көрсетіңіз
Dialogue: 0,0:04:05.00,0:04:07.00,Default,,0,0,0,,Оны өзіңіз жасаңыз
Dialogue: 0,0:04:07.00,0:04:09.00,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:04:27.00,0:04:28.00,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:04:28.00,0:04:29.00,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:04:29.00,0:04:32.00,Default,,0,0,0,,Бұл дамыған жынның күші ме?
Dialogue: 0,0:04:33.00,0:04:36.00,Default,,0,0,0,,Мектепте серуендеушілермен қалай күресуге болады
Dialogue: 0,0:04:36.00,0:04:38.00,Default,,0,0,0,,Қандай күш!
Dialogue: 0,0:04:39.00,0:04:41.00,Default,,0,0,0,,Өл
Dialogue: 0,0:04:59.00,0:05:01.00,Default,,0,0,0,,Мен мұнда жүктеме болғым келмейді.
Dialogue: 0,0:05:02.00,0:05:05.00,Default,,0,0,0,,Сізде жақсы нәрсе бар.
Dialogue: 0,0:05:10.00,0:05:11.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:05:11.00,0:05:13.00,Default,,0,0,0,,өлтіру
Dialogue: 0,0:05:14.00,0:05:15.00,Default,,0,0,0,,Ібіліс
Dialogue: 0,0:05:15.00,0:05:17.00,Default,,0,0,0,,Кінәсіздік - керісінше.
Dialogue: 0,0:05:17.00,0:05:19.00,Default,,0,0,0,,Қараңғы материя
Dialogue: 0,0:05:19.00,0:05:22.00,Default,,0,0,0,,Қараңғы заттан жасалған
Dialogue: 0,0:05:22.00,0:05:23.00,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:05:23.00,0:05:25.00,Default,,0,0,0,,Біз соғұрлым дамимыз
Dialogue: 0,0:05:25.00,0:05:26.00,Default,,0,0,0,,Зат өседі
Dialogue: 0,0:05:26.00,0:05:28.00,Default,,0,0,0,,Күшейтіледі
Dialogue: 0,0:05:28.00,0:05:30.00,Default,,0,0,0,,Келесі деңгейге жеткен шайтан
Dialogue: 0,0:05:30.00,0:05:31.00,Default,,0,0,0,,Эгоның болуы
Dialogue: 0,0:05:31.00,0:05:33.00,Default,,0,0,0,,Сөздерді айту
Dialogue: 0,0:05:33.00,0:05:34.00,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:05:34.00,0:05:36.00,Default,,0,0,0,,Жаңа қабілеттерді ояту
Dialogue: 0,0:05:36.00,0:05:38.00,Default,,0,0,0,,Бастапқы деңгеймен салыстырғанда
Dialogue: 0,0:05:38.00,0:05:40.00,Default,,0,0,0,,Күшті болады
Dialogue: 0,0:05:40.00,0:05:41.00,Default,,0,0,0,,Біз бұрын соғысқанбыз
Dialogue: 0,0:05:41.00,0:05:43.00,Default,,0,0,0,,Ол мен жеңетін адам емес.
Dialogue: 0,0:05:43.00,0:05:45.00,Default,,0,0,0,,Не болады?
Dialogue: 0,0:05:45.00,0:05:47.00,Default,,0,0,0,,ерте ме, кеш пе
Dialogue: 0,0:05:47.00,0:05:48.00,Default,,0,0,0,,Сол шайтан
Dialogue: 0,0:05:48.00,0:05:50.00,Default,,0,0,0,,Мұнда келу деген сөз.
Dialogue: 0,0:05:50.00,0:05:52.00,Default,,0,0,0,,Бізге
Dialogue: 0,0:05:53.00,0:05:54.00,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:05:54.00,0:05:56.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:56.00,0:05:58.00,Default,,0,0,0,,Шайтан келгенге дейін
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,Сіз кінәсіздікті қалайсыз ба?
Dialogue: 0,0:06:01.00,0:06:02.00,Default,,0,0,0,,О
Dialogue: 0,0:06:02.00,0:06:03.00,Default,,0,0,0,,Мүмкін болса
Dialogue: 0,0:06:03.00,0:06:04.00,Default,,0,0,0,,Қазір!
Dialogue: 0,0:06:07.00,0:06:08.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:11.00,0:06:12.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:06:13.00,0:06:15.00,Default,,0,0,0,,Мен Матердің елесімін.
Dialogue: 0,0:06:16.00,0:06:18.00,Default,,0,0,0,,Бұл нағыз елес емес.
Dialogue: 0,0:06:18.00,0:06:19.00,Default,,0,0,0,,О
Dialogue: 0,0:06:19.00,0:06:21.00,Default,,0,0,0,,Мен қуыршақпын
Dialogue: 0,0:06:21.00,0:06:22.00,Default,,0,0,0,,Гусол
Dialogue: 0,0:06:23.00,0:06:24.00,Default,,0,0,0,,Қуыршақ?
Dialogue: 0,0:06:25.00,0:06:26.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:26.00,0:06:28.00,Default,,0,0,0,,Тау жыныстары және құрғақ климат
Dialogue: 0,0:06:29.00,0:06:31.00,Default,,0,0,0,,Қатты күн сәулесі
Dialogue: 0,0:06:31.00,0:06:33.00,Default,,0,0,0,,Матер бұрын болған
Dialogue: 0,0:06:34.00,0:06:37.00,Default,,0,0,0,,Құдай тастап кеткен жер деп аталды.
Dialogue: 0,0:06:39.00,0:06:42.00,Default,,0,0,0,,Матер халқы үмітсіздік пен азапта өмір сүреді.
Dialogue: 0,0:06:42.00,0:06:44.00,Default,,0,0,0,,Оны уақытша ұмыту
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Мен қуыршақ жасадым
Dialogue: 0,0:06:47.00,0:06:48.00,Default,,0,0,0,,Би
Dialogue: 0,0:06:48.00,0:06:50.00,Default,,0,0,0,,Ән ойнайтын қуыршақтар
Dialogue: 0,0:06:51.00,0:06:53.00,Default,,0,0,0,,Ақырында қала жойылады.
Dialogue: 0,0:06:53.00,0:06:55.00,Default,,0,0,0,,Адамдар жоғалып кетсе де
Dialogue: 0,0:06:55.00,0:06:57.00,Default,,0,0,0,,Қуыршақ қозғала берді.
Dialogue: 0,0:07:00.00,0:07:01.00,Default,,0,0,0,,Түсіндім. Яғни Лиза-Лиза шарф арқылы Риппл энергиясын өткізіп, оны қаруға айналдырады
Dialogue: 0,0:07:01.00,0:07:03.00,Default,,0,0,0,,Бұл Матердің елесі.
Dialogue: 0,0:07:04.00,0:07:07.00,Default,,0,0,0,,Бұл қала 500 жыл бұрын жойылған
Dialogue: 0,0:07:07.00,0:07:10.00,Default,,0,0,0,,Содан бері көшіп жүрсіз бе?
Dialogue: 0,0:07:11.00,0:07:13.00,Default,,0,0,0,,Жүрегіңде жазықсыздық болсын
Dialogue: 0,0:07:13.00,0:07:15.00,Default,,0,0,0,,Кінәсіздіктің күші?
Dialogue: 0,0:07:15.00,0:07:16.00,Default,,0,0,0,,Бұл мүмкін.
Dialogue: 0,0:07:17.00,0:07:18.00,Default,,0,0,0,,Үлкен қуыршақты алып жүру
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,Бұл жерден қашып құтылу мүмкін емес.
Dialogue: 0,0:07:20.00,0:07:22.00,Default,,0,0,0,,Қатысқаным үшін кешірім сұраймын.
Dialogue: 0,0:07:22.00,0:07:24.00,Default,,0,0,0,,Мен сенің жүрегіңді қалаймын
Dialogue: 0,0:07:24.00,0:07:25.00,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:07:25.00,0:07:28.00,Default,,0,0,0,,Егер қашып құтыла алмасаң, тығыл.
Dialogue: 0,0:07:29.00,0:07:30.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:07:30.00,0:07:31.00,Default,,0,0,0,,Мен
Dialogue: 0,0:07:31.00,0:07:33.00,Default,,0,0,0,,Мен Гузорданмын
Dialogue: 0,0:07:33.00,0:07:36.00,Default,,0,0,0,,Адамдар тастап кеткен бала.
Dialogue: 0,0:07:36.00,0:07:39.00,Default,,0,0,0,,Мен оны көтеріп, қасыма қойдым.
Dialogue: 0,0:07:40.00,0:07:41.00,Default,,0,0,0,,Гузор
Dialogue: 0,0:07:41.00,0:07:42.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,Мен саған жасырын дедім.
Dialogue: 0,0:07:44.00,0:07:46.00,Default,,0,0,0,,Сен қайда тығыласың?
Dialogue: 0,0:07:47.00,0:07:48.00,Default,,0,0,0,,Томака
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,Мен алыстан тыңдадым.
Dialogue: 0,0:07:52.00,0:07:54.00,Default,,0,0,0,,Бұрын күшті әсер болды.
Dialogue: 0,0:07:54.00,0:07:56.00,Default,,0,0,0,,Лорд Очердің қауіпсіздігі белгісіз.
Dialogue: 0,0:07:57.00,0:08:00.00,Default,,0,0,0,,Енді ғимараттан тек шайтан шықты.
Dialogue: 0,0:08:00.00,0:08:02.00,Default,,0,0,0,,Големді қуу
Dialogue: 0,0:08:02.00,0:08:03.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:03.00,0:08:06.00,Default,,0,0,0,,Енді мен големді гидке жіберемін.
Dialogue: 0,0:08:06.00,0:08:08.00,Default,,0,0,0,,Тиммен бірге осында кел.
Dialogue: 0,0:08:08.00,0:08:10.00,Default,,0,0,0,,Ұзындығы қауіпті
Dialogue: 0,0:08:10.00,0:08:13.00,Default,,0,0,0,,Енді маған Тим түсірген кадрлар керек.
Dialogue: 0,0:08:13.00,0:08:15.00,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:08:23.00,0:08:24.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:26.00,0:08:27.00,Default,,0,0,0,,Ол тесілді ме?
Dialogue: 0,0:08:29.00,0:08:31.00,Default,,0,0,0,,Енді кім?
Dialogue: 0,0:08:31.00,0:08:33.00,Default,,0,0,0,,Mattel's Bolle қайда?
Dialogue: 0,0:08:46.00,0:08:48.00,Default,,0,0,0,,Томасқа барыңыз
Dialogue: 0,0:08:48.00,0:08:51.00,Default,,0,0,0,,Уақыт таусылды ма?
Dialogue: 0,0:08:52.00,0:08:53.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:57.00,0:08:58.00,Default,,0,0,0,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:09:19.00,0:09:20.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:23.00,0:09:24.00,Default,,0,0,0,,Ібіліс
Dialogue: 0,0:09:25.00,0:09:28.00,Default,,0,0,0,,Мен қанша уақыт ес-түссіз болдым?
Dialogue: 0,0:09:29.00,0:09:31.00,Default,,0,0,0,,Ол қайда кетті?
Dialogue: 0,0:09:32.00,0:09:33.00,Default,,0,0,0,,Тым күшті
Dialogue: 0,0:09:33.00,0:09:35.00,Default,,0,0,0,,Сіз біреуді осылай жеңе аласыз ба?
Dialogue: 0,0:09:36.00,0:09:38.00,Default,,0,0,0,,Енді мен Кантаны және басқаларды іздеуім керек.
Dialogue: 0,0:09:43.00,0:09:44.00,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:09:46.00,0:09:47.00,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:09:48.00,0:09:49.00,Default,,0,0,0,,Томака
Dialogue: 0,0:09:49.00,0:09:50.00,Default,,0,0,0,,Маттельдің Болле
Dialogue: 0,0:09:50.00,0:09:51.00,Default,,0,0,0,,Қайда ол? Сол кілтке ұқсас зат қайда…
Dialogue: 0,0:09:55.00,0:09:56.00,Default,,0,0,0,,Бұл Тим Кэмпи.
Dialogue: 0,0:09:59.00,0:10:02.00,Default,,0,0,0,,Маған көрген жын туралы ақпаратты көрсет, Тим.
Dialogue: 0,0:10:12.00,0:10:13.00,Default,,0,0,0,,Айна сияқты
Dialogue: 0,0:10:14.00,0:10:15.00,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:10:15.00,0:10:17.00,Default,,0,0,0,,Мына шайтан төңкерілген
Dialogue: 0,0:10:20.00,0:10:22.00,Default,,0,0,0,,Төңкерілген бе?
Dialogue: 0,0:10:32.00,0:10:33.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:35.00,0:10:37.00,Default,,0,0,0,,Мүмкін мен адасып қалған шығармын.
Dialogue: 0,0:10:40.00,0:10:41.00,Default,,0,0,0,,...
Dialogue: 0,0:10:41.00,0:10:44.00,Default,,0,0,0,,Бұл жолды ешкім білмейді
Dialogue: 0,0:10:44.00,0:10:46.00,Default,,0,0,0,,Ібіліс те, жын шығарушы да келмейді.
Dialogue: 0,0:10:46.00,0:10:48.00,Default,,0,0,0,,Мен ештеңе көре алмаймын
Dialogue: 0,0:10:48.00,0:10:50.00,Default,,0,0,0,,Жақсысың ба, Ирара?
Dialogue: 0,0:10:50.00,0:10:51.00,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:10:51.00,0:10:52.00,Default,,0,0,0,,Мұнда
Dialogue: 0,0:10:53.00,0:10:54.00,Default,,0,0,0,,Өйткені мен
Dialogue: 0,0:10:54.00,0:10:57.00,Default,,0,0,0,,Мен мұнда мәңгі жер астында өмір сүрдім.
Dialogue: 0,0:10:57.00,0:11:00.00,Default,,0,0,0,,Мен дүниеге келгеннен бері
Dialogue: 0,0:11:06.00,0:11:08.00,Default,,0,0,0,,Мен келдім, Гузор.
Dialogue: 0,0:11:11.00,0:11:12.00,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:11:12.00,0:11:14.00,Default,,0,0,0,,Психологиялық болған кезде қандай болады
Dialogue: 0,0:11:14.00,0:11:17.00,Default,,0,0,0,,Киім мен қару оңға және солға төңкерілген
Dialogue: 0,0:11:17.00,0:11:19.00,Default,,0,0,0,,Кейбір адамдар психологиялық тұрғыдан үзілген.
Dialogue: 0,0:11:19.00,0:11:21.00,Default,,0,0,0,,Мұқият қарасаңыз, сол және оң жақтары қарама-қарсы орналасқан.
Dialogue: 0,0:11:21.00,0:11:25.00,Default,,0,0,0,,Оның үстіне бұл іші бос және тек сыртқы түрі үшін.
Dialogue: 0,0:11:26.00,0:11:29.00,Default,,0,0,0,,Бұл тек бетперделеу қабілеті ғана емес.
Dialogue: 0,0:11:29.00,0:11:31.00,Default,,0,0,0,,Объектіні бір нәрсемен көшіру
Dialogue: 0,0:11:31.00,0:11:32.00,Default,,0,0,0,,айтуым керек пе?
Dialogue: 0,0:11:32.00,0:11:34.00,Default,,0,0,0,,Сонымен қатар, егер сіз оны көшірілгенмен жабдықтасаңыз
Dialogue: 0,0:11:34.00,0:11:37.00,Default,,0,0,0,,Сіз тіпті қабілеттерді өзіңіздікіне айналдыра алатын сияқтысыз.
Dialogue: 0,0:11:37.00,0:11:40.00,Default,,0,0,0,,Психологияның сол қолын түрлендіру
Dialogue: 0,0:11:40.00,0:11:42.00,Default,,0,0,0,,Олардың шабуылдап жатқанын көргенде
Dialogue: 0,0:11:42.00,0:11:45.00,Default,,0,0,0,,Әлгі бейбақ – мұң екен
Dialogue: 0,0:11:45.00,0:11:48.00,Default,,0,0,0,,Мен Уокер мырзаны іздеуім керек еді.
Dialogue: 0,0:11:48.00,0:11:51.00,Default,,0,0,0,,Егер шайтан өзін Мистер Уокер етіп жасырса ше?
Dialogue: 0,0:11:51.00,0:11:53.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:53.00,0:11:56.00,Default,,0,0,0,,Сіз оңай айта аласыз, өйткені сол және оң жақтары керісінше.
Dialogue: 0,0:11:56.00,0:11:58.00,Default,,0,0,0,,Егер ол сол қалпында көрінсе
Dialogue: 0,0:11:58.00,0:12:00.00,Default,,0,0,0,,Сен сондай ақымақсың.
Dialogue: 0,0:12:04.00,0:12:05.00,Default,,0,0,0,,Лорд Канта
Dialogue: 0,0:12:12.00,0:12:13.00,Default,,0,0,0,,Мүмкін…
Dialogue: 0,0:12:13.00,0:12:14.00,Default,,0,0,0,,мүмкін…
Dialogue: 0,0:12:21.00,0:12:22.00,Default,,0,0,0,,G…
Dialogue: 0,0:12:22.00,0:12:23.00,Default,,0,0,0,,Ганда
Dialogue: 0,0:12:24.00,0:12:25.00,Default,,0,0,0,,Сол жақ…
Dialogue: 0,0:12:25.00,0:12:26.00,Default,,0,0,0,,Сол және оң жақтары керісінше
Dialogue: 0,0:12:32.00,0:12:33.00,Default,,0,0,0,,Шамасы
Dialogue: 0,0:12:33.00,0:12:35.00,Default,,0,0,0,,Сіз мүлде ақымақ сияқтысыз.
Dialogue: 0,0:12:35.00,0:12:36.00,Default,,0,0,0,,G…
Dialogue: 0,0:12:36.00,0:12:37.00,Default,,0,0,0,,Ганда
Dialogue: 0,0:12:38.00,0:12:39.00,Default,,0,0,0,,Дон…
Dialogue: 0,0:12:39.00,0:12:40.00,Default,,0,0,0,,Дон…
Dialogue: 0,0:12:40.00,0:12:41.00,Default,,0,0,0,,Ең нашар болашақ
Dialogue: 0,0:12:42.00,0:12:44.00,Default,,0,0,0,,Су астындағы бірінші генерал
Dialogue: 0,0:12:45.00,0:12:47.00,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,0:12:59.00,0:13:02.00,Default,,0,0,0,,У...Уокер...болма...
Dialogue: 0,0:13:03.00,0:13:04.00,Default,,0,0,0,,Сен…
Dialogue: 0,0:13:05.00,0:13:06.00,Default,,0,0,0,,Шин Іле
Dialogue: 0,0:13:07.00,0:13:09.00,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,0:13:10.00,0:13:11.00,Default,,0,0,0,,Сен
Dialogue: 0,0:13:11.00,0:13:14.00,Default,,0,0,0,,Неге шайтанды қорғадың?
Dialogue: 0,0:13:14.00,0:13:15.00,Default,,0,0,0,,Ганда
Dialogue: 0,0:13:15.00,0:13:19.00,Default,,0,0,0,,Менің сол көзімнің шайтанға қарауға күші бар екенін білесің.
Dialogue: 0,0:13:19.00,0:13:21.00,Default,,0,0,0,,Бұл адам шайтан емес
Dialogue: 0,0:13:22.00,0:13:23.00,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:13:24.00,0:13:27.00,Default,,0,0,0,,У...Уокер...болма...
Dialogue: 0,0:13:27.00,0:13:29.00,Default,,0,0,0,,Бетіндегі кесу...
Dialogue: 0,0:13:29.00,0:13:31.00,Default,,0,0,0,,Бұл... тері ме?
Dialogue: 0,0:13:34.00,0:13:35.00,Default,,0,0,0,,Тома
Dialogue: 0,0:13:36.00,0:13:37.00,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:13:37.00,0:13:38.00,Default,,0,0,0,,Тома - шайтан.
Dialogue: 0,0:13:38.00,0:13:39.00,Default,,0,0,0,,Ганда
Dialogue: 0,0:13:49.00,0:13:50.00,Default,,0,0,0,,Га... Ганда
Dialogue: 0,0:13:53.00,0:13:56.00,Default,,0,0,0,,Эй... мен білмей тұрып...
Dialogue: 0,0:13:58.00,0:14:01.00,Default,,0,0,0,,Мен сенімен кездескен сәттен бастап.
Dialogue: 0,0:14:01.00,0:14:03.00,Default,,0,0,0,,Сары големді ұсақтағаннан кейін
Dialogue: 0,0:14:03.00,0:14:06.00,Default,,0,0,0,,Біз бұл Томаны да таптық.
Dialogue: 0,0:14:07.00,0:14:11.00,Default,,0,0,0,,Мына жігіттің түрін көрсетсем көрінбейді деп ойладым.
Dialogue: 0,0:14:11.00,0:14:15.00,Default,,0,0,0,,Қараңызшы, сіз де сол және оң жақтардың кері бұрылуына алаңдадыңыз, солай ма?
Dialogue: 0,0:14:15.00,0:14:19.00,Default,,0,0,0,,Сондықтан мен Тоума деген жігітке ақ шашты жігіттің бейнесін қойдым.
Dialogue: 0,0:14:21.00,0:14:23.00,Default,,0,0,0,,Мен ақылдымын
Dialogue: 0,0:14:23.00,0:14:25.00,Default,,0,0,0,,Менің терім – шағылыс
Dialogue: 0,0:14:25.00,0:14:28.00,Default,,0,0,0,,Эксорцист Мантутқа алданып қалды
Dialogue: 0,0:14:37.00,0:14:40.00,Default,,0,0,0,,Өлді! Эксорцист өлді!
Dialogue: 0,0:14:41.00,0:14:44.00,Default,,0,0,0,,Өлуім керек пе...Мен...
Dialogue: 0,0:14:44.00,0:14:46.00,Default,,0,0,0,,Мен ол адамды тапқанша...
Dialogue: 0,0:14:46.00,0:14:51.00,Default,,0,0,0,,Мен өле алмаймын...Мен...
Dialogue: 0,0:14:51.00,0:14:52.00,Default,,0,0,0,,Өлме!
Dialogue: 0,0:14:57.00,0:15:00.00,Default,,0,0,0,,Уау! Мен тұрып өлдім!
Dialogue: 0,0:15:00.00,0:15:03.00,Default,,0,0,0,,Қанша тырыссаң да пайдасы жоқ!
Dialogue: 0,0:15:30.00,0:15:31.00,Default,,0,0,0,,Гундам!
Dialogue: 0,0:15:34.00,0:15:36.00,Default,,0,0,0,,Әлі тірі...
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0,0,0,,Чикишу…
Dialogue: 0,0:15:39.00,0:15:43.00,Default,,0,0,0,,Әлгі бейбақ... ол дәл қазір күшті емес еді ғой?
Dialogue: 0,0:15:44.00,0:15:46.00,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,0:15:47.00,0:15:48.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:48.00,0:15:50.00,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:50.00,0:15:53.00,Default,,0,0,0,,Олар қайда кетті?
Dialogue: 0,0:15:53.00,0:15:58.00,Default,,0,0,0,,Очер мырза...мені жалғыз қалдырыңызшы.
Dialogue: 0,0:15:58.00,0:16:01.00,Default,,0,0,0,,Сіз де жарақат алған шығарсыз.
Dialogue: 0,0:16:02.00,0:16:04.00,Default,,0,0,0,,Мен кеттім...
Dialogue: 0,0:16:04.00,0:16:07.00,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:16:07.00,0:16:10.00,Default,,0,0,0,,Бұлай жалғаса берсе, мен ешқашан қашып құтыла алмаймын.
Dialogue: 0,0:16:11.00,0:16:14.00,Default,,0,0,0,,Егер мен жасыратын жер болса...
Dialogue: 0,0:16:14.00,0:16:16.00,Default,,0,0,0,,Мен қашып құтыла алмаймын
Dialogue: 0,0:16:16.00,0:16:18.00,Default,,0,0,0,,Мен қашып құтыла алмаймын
Dialogue: 0,0:16:18.00,0:16:20.00,Default,,0,0,0,,Мен қашып құтыла алмаймын
Dialogue: 0,0:16:20.00,0:16:23.00,Default,,0,0,0,,Егер мен жасыратын жер болса...
Dialogue: 0,0:16:24.00,0:16:26.00,Default,,0,0,0,,Бұл қайда!
Dialogue: 0,0:16:27.00,0:16:31.00,Default,,0,0,0,,Қайда кеттіңіз, Эксазистер!
Dialogue: 0,0:16:40.00,0:16:43.00,Default,,0,0,0,,Қызық, шайқас әлі жалғасып жатыр ма?
Dialogue: 0,0:16:44.00,0:16:46.00,Default,,0,0,0,,Жарайды, Гузор.
Dialogue: 0,0:16:47.00,0:16:49.00,Default,,0,0,0,,Әй, Гузор
Dialogue: 0,0:16:49.00,0:16:52.00,Default,,0,0,0,,Сен неге қуыршақпын дедің?
Dialogue: 0,0:16:52.00,0:16:56.00,Default,,0,0,0,,Лаланы басқа адамдар құртқанын қаламадым.
Dialogue: 0,0:17:00.00,0:17:01.00,Default,,0,0,0,,Гузор…
Dialogue: 0,0:17:04.00,0:17:07.00,Default,,0,0,0,,Кешіріңіз, мен біраз жатқым келеді.
Dialogue: 0,0:17:07.00,0:17:08.00,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:17:17.00,0:17:19.00,Default,,0,0,0,,А-а-а, боқ-боқ
Dialogue: 0,0:17:21.00,0:17:24.00,Default,,0,0,0,,Енді көп уақытыңыз жоқ.
Dialogue: 0,0:17:24.00,0:17:26.00,Default,,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:17:27.00,0:17:29.00,Default,,0,0,0,,Лара, мен ұйықтағым келеді
Dialogue: 0,0:17:29.00,0:17:33.00,Default,,0,0,0,,Жарайды, мен саған бесік жырын айтамын.
Dialogue: 0,0:17:46.00,0:17:49.00,Default,,0,0,0,,Матейлдің елесі қуыршақ болды
Dialogue: 0,0:17:49.00,0:17:51.00,Default,,0,0,0,,Олар қашып кетті.
Dialogue: 0,0:17:51.00,0:17:54.00,Default,,0,0,0,,Жасыратын жер болуы керек.
Dialogue: 0,0:17:54.00,0:17:56.00,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:17:56.00,0:18:00.00,Default,,0,0,0,,Енді қуыршақтан артық...
Dialogue: 0,0:18:00.00,0:18:02.00,Default,,0,0,0,,Мен дыбысты естимін
Dialogue: 0,0:18:06.00,0:18:08.00,Default,,0,0,0,,Неліктен төменнен...
Dialogue: 0,0:18:08.00,0:18:09.00,Default,,0,0,0,,Жел?
Dialogue: 0,0:18:09.00,0:18:11.00,Default,,0,0,0,,Бұғыдан соққан жел
Dialogue: 0,0:18:20.00,0:18:23.00,Default,,0,0,0,,Жел келе жатыр
Dialogue: 0,0:18:27.00,0:18:30.00,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:18:30.00,0:18:32.00,Default,,0,0,0,,Не?
Dialogue: 0,0:18:32.00,0:18:34.00,Default,,0,0,0,,Не?
Dialogue: 0,0:18:35.00,0:18:38.00,Default,,0,0,0,,Мұнда жасыруға болады.
Dialogue: 0,0:18:38.00,0:18:41.00,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:18:41.00,0:18:45.00,Default,,0,0,0,,Эксорцист!
Dialogue: 0,0:18:47.00,0:18:49.00,Default,,0,0,0,,Құссу…
Dialogue: 0,0:18:59.00,0:19:01.00,Default,,0,0,0,,Ол әрқашан төмендейді
Dialogue: 0,0:19:01.00,0:19:03.00,Default,,0,0,0,,Қаншалықты төмен?
Dialogue: 0,0:19:19.00,0:19:21.00,Default,,0,0,0,,Бұл ән.
Dialogue: 0,0:19:31.00,0:19:35.00,Default,,0,0,0,,Сынақ
Dialogue: 0,0:19:51.00,0:19:53.00,Default,,0,0,0,,Тас және құрғақ ағаш бұйымдары
Dialogue: 0,0:19:53.00,0:19:56.00,Default,,0,0,0,,Қатты күн сәулесі
Dialogue: 0,0:19:56.00,0:19:59.00,Default,,0,0,0,,Матейль бір кездері а
Dialogue: 0,0:19:59.00,0:20:02.00,Default,,0,0,0,,Құдай тастап кеткен жер деп аталды.
Dialogue: 0,0:20:03.00,0:20:07.00,Default,,0,0,0,,Матейл халқы үмітсіздік пен азапта өмір сүреді.
Dialogue: 0,0:20:07.00,0:20:12.00,Default,,0,0,0,,Біраз уақыт ұмыту үшін қуыршақ жасадым.
Dialogue: 0,0:20:12.00,0:20:16.00,Default,,0,0,0,,Би билейтін және ән айтатын қуыршақтар
Dialogue: 0,0:20:16.00,0:20:20.00,Default,,0,0,0,,Ақырында қала құлап, адамдар жойылып кетсе де
Dialogue: 0,0:20:20.00,0:20:23.00,Default,,0,0,0,,Қуыршақ қозғала берді.
Dialogue: 0,0:20:24.00,0:20:28.00,Default,,0,0,0,,Бұл Матейлдің елесі.
Dialogue: 0,0:20:29.00,0:20:33.00,Default,,0,0,0,,Матейл елесі
Dialogue: 0,0:20:44.00,0:20:46.00,Default,,0,0,0,,Сен келдің.
Dialogue: 0,0:20:46.00,0:20:49.00,Default,,0,0,0,,Сен қуыршақсың...
Dialogue: 0,0:20:49.00,0:20:53.00,Default,,0,0,0,,Бұл Маттейлдің елесі еді.
Dialogue: 0,0:21:00.00,0:21:04.00,Default,,0,0,0,,(Куними) Эй, Сакута, ұйықтап қалған соң шашың бүлініп қалыпты.
Dialogue: 0,0:21:06.00,0:21:10.00,Default,,0,0,0,,Түнгі өсу
Dialogue: 0,0:21:11.00,0:21:15.00,Default,,0,0,0,,Түнгі өсу
Dialogue: 0,0:21:25.00,0:21:30.00,Default,,0,0,0,,Тоңған ернімді тістеп
Dialogue: 0,0:21:31.00,0:21:36.00,Default,,0,0,0,,Екі адам, бұрыштан бұрышқа
Dialogue: 0,0:21:37.00,0:21:42.00,Default,,0,0,0,,Мен сені көрген ең жақсы күн
Dialogue: 0,0:21:43.00,0:21:48.00,Default,,0,0,0,,Жадтың тереңінде жасырылған
Dialogue: 0,0:21:50.00,0:21:59.00,Default,,0,0,0,,Көлде серуендеу
Dialogue: 0,0:21:59.00,0:22:02.00,Default,,0,0,0,,Мен тамаша болашақпын
Dialogue: 0,0:22:02.00,0:22:05.00,Default,,0,0,0,,Қар сүйісі
Dialogue: 0,0:22:05.00,0:22:13.00,Default,,0,0,0,,Менімен бұлай қоштаспа
Dialogue: 0,0:22:14.00,0:22:20.00,Default,,0,0,0,,Махаббатты, қайғыны, сезімді алып тастау мүмкін емес
Dialogue: 0,0:22:20.00,0:22:26.00,Default,,0,0,0,,Бұл тыртық, оны өшірме.
Dialogue: 0,0:22:26.00,0:22:29.00,Default,,0,0,0,,Өшірмеңіз
Dialogue: 0,0:22:33.00,0:22:36.00,Default,,0,0,0,,Ән айту үшін өмір сүрген қуыршақ
Dialogue: 0,0:22:36.00,0:22:41.00,Default,,0,0,0,,Лаланың ән салған даусы биязы, Матай елін орап жатыр.
Dialogue: 0,0:22:41.00,0:22:44.00,Default,,0,0,0,,Мен бұл әнші дауысты қорғағым келеді
Dialogue: 0,0:22:44.00,0:22:46.00,Default,,0,0,0,,Келесі жолы Д.Грейман
Dialogue: 0,0:22:46.00,0:22:48.00,Default,,0,0,0,,Маған бесік жырын тыңдауға рұқсат етіңіз
Dialogue: 0,0:22:48.00,0:22:51.00,Default,,0,0,0,,Жамандыққа қарамастан жанның құтқарылуы.
Dialogue: 0,0:22:52.50,0:22:58.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory