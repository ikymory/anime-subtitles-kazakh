Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:06.00,Default,,0,0,0,,- Ән, композиция, аранжировка-
Dialogue: 0,0:00:06.00,0:00:11.00,Default,,0,0,0,,Кеуде қуысының төңкерілген жарақаты
Dialogue: 0,0:00:11.00,0:00:16.00,Default,,0,0,0,,Толып жатқан қол мен тамағы
Dialogue: 0,0:00:16.00,0:00:22.00,Default,,0,0,0,,Бірін-бірі қайталайтын сәттер
Dialogue: 0,0:00:22.00,0:00:27.00,Default,,0,0,0,,Байланысқан сезімдерді балқыту
Dialogue: 0,0:00:27.00,0:00:32.00,Default,,0,0,0,,Суымайтын қызбамен ауыру
Dialogue: 0,0:00:32.00,0:00:38.00,Default,,0,0,0,,Соңғы дауысты да естімеймін
Dialogue: 0,0:00:38.00,0:00:44.00,Default,,0,0,0,,Бұл жолы мен сені қатты құшақтап алсам, үзіліп кететіндей болдым
Dialogue: 0,0:00:44.00,0:00:49.00,Default,,0,0,0,,Сен қалтырап тұрдың
Dialogue: 0,0:00:49.00,0:00:53.00,Default,,0,0,0,,Алақанда
Dialogue: 0,0:00:53.00,0:00:57.00,Default,,0,0,0,,Маған қол тигізуге рұқсат етіңіз
Dialogue: 0,0:00:57.00,0:01:01.00,Default,,0,0,0,,Сіз оны іздегеніңізге сенімдімін.
Dialogue: 0,0:01:01.00,0:01:08.00,Default,,0,0,0,,Ешқашан өшпейтін ғажайыптың есімі
Dialogue: 0,0:01:08.00,0:01:17.00,Default,,0,0,0,,Маған алақаныңызбен қаттырақ тигізіңіз
Dialogue: 0,0:01:18.00,0:01:22.00,Default,,0,0,0,,Ешқашан бітпейді
Dialogue: 0,0:01:22.00,0:01:28.00,Default,,0,0,0,,Келесі
Dialogue: 0,0:01:29.00,0:01:32.00,Default,,0,0,0,,- Ән, композиция, өңдеу-
Dialogue: 0,0:01:44.00,0:01:48.00,Default,,0,0,0,,- Композиция/Композиция/Аранжировка-
Dialogue: 0,0:01:48.00,0:01:51.00,Default,,0,0,0,,Мен кондуктордан сұрадым, бірақ әзірге кете алмайтын сияқтымыз.
Dialogue: 0,0:01:51.00,0:01:52.00,Default,,0,0,0,,- Композиция/Композиция/Аранжировка-
Dialogue: 0,0:01:53.00,0:01:58.00,Default,,0,0,0,,Неліктен бұл Кінәсіздік Лаламен біріктірілді?
Dialogue: 0,0:01:58.00,0:02:02.00,Default,,0,0,0,,Мен неге осындай қолдармен тудым?
Dialogue: 0,0:02:02.00,0:02:07.00,Default,,0,0,0,,Неліктен Кінәсіздік мені жарасымды етіп таңдады?
Dialogue: 0,0:02:22.00,0:02:24.00,Default,,0,0,0,,Бұл шайтан!
Dialogue: 0,0:02:27.00,0:02:28.00,Default,,0,0,0,,Бұл шайтан!
Dialogue: 0,0:02:28.00,0:02:30.00,Default,,0,0,0,,Алыста!
Dialogue: 0,0:02:31.00,0:02:32.00,Default,,0,0,0,,Лорд Моркар!
Dialogue: 0,0:02:32.00,0:02:34.00,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:02:34.00,0:02:35.00,Default,,0,0,0,,Шайтан!
Dialogue: 0,0:02:35.00,0:02:37.00,Default,,0,0,0,,Қайда?
Dialogue: 0,0:02:40.00,0:02:42.00,Default,,0,0,0,,Шайтан деген жоқ!
Dialogue: 0,0:02:44.00,0:02:46.00,Default,,0,0,0,,Мен көремін!
Dialogue: 0,0:02:46.00,0:02:49.00,Default,,0,0,0,,Өкініштісі, бұл жігіттің еркелігі.
Dialogue: 0,0:02:49.00,0:02:53.00,Default,,0,0,0,,Ол үнемі шайтан екен деп шу шығарады!
Dialogue: 0,0:02:53.00,0:02:55.00,Default,,0,0,0,,Бұл жай ғана көңіл көтеру үшін емес, ақымақ!
Dialogue: 0,0:02:55.00,0:02:57.00,Default,,0,0,0,,Шынында да шайтан бар!
Dialogue: 0,0:02:57.00,0:03:01.00,Default,,0,0,0,,Бұл әлемді ақырындап басып алады!
Dialogue: 0,0:03:02.00,0:03:03.00,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:03:03.00,0:03:08.00,Default,,0,0,0,,Дәл қазір ана жақта қалпақ киген кәрі жігіт келе жатыр!
Dialogue: 0,0:03:08.00,0:03:10.00,Default,,0,0,0,,- Композиция/Композиция/Аранжировка/Аранжировка-
Dialogue: 0,0:03:11.00,0:03:14.00,Default,,0,0,0,,Кешіріңіз, бұл ештеңе емес.
Dialogue: 0,0:03:15.00,0:03:20.00,Default,,0,0,0,,Мен онымен араласып жүргенімде, мына қызды алып кетті.
Dialogue: 0,0:03:21.00,0:03:25.00,Default,,0,0,0,,Ақыр соңында, келесі жолы шуласаң да, мен сенімен енді араласпаймын!
Dialogue: 0,0:03:25.00,0:03:26.00,Default,,0,0,0,,қаңтар!
Dialogue: 0,0:03:29.00,0:03:31.00,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:03:31.00,0:03:32.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:33.00,0:03:35.00,Default,,0,0,0,,- Композиция, композиция, аранжировка, аранжировка, аранжировка-
Dialogue: 0,0:03:36.00,0:03:40.00,Default,,0,0,0,,Менің көзім сені алдамайды.
Dialogue: 0,0:03:42.00,0:03:44.00,Default,,0,0,0,,Сен шайтансың.
Dialogue: 0,0:03:44.00,0:03:46.00,Default,,0,0,0,,Ия...
Dialogue: 0,0:03:54.00,0:03:56.00,Default,,0,0,0,,Менің көзім алданбайды
Dialogue: 0,0:04:00.00,0:04:02.00,Default,,0,0,0,,Сен шайтансың
Dialogue: 0,0:04:07.00,0:04:09.00,Default,,0,0,0,,Жан Кун... солай ма?
Dialogue: 0,0:04:09.00,0:04:13.00,Default,,0,0,0,,Сіз жындар туралы көп білетін сияқтысыз, бірақ...
Dialogue: 0,0:04:15.00,0:04:18.00,Default,,0,0,0,,О, бұл Эспозито! Мен оны бірінші рет көріп тұрмын!
Dialogue: 0,0:04:18.00,0:04:20.00,Default,,0,0,0,,Қазіргі Тайя жын қаруы қандай?
Dialogue: 0,0:04:20.00,0:04:22.00,Default,,0,0,0,,Маған дәптеріңді көрсет! Эй!
Dialogue: 0,0:04:23.00,0:04:24.00,Default,,0,0,0,,О, не?
Dialogue: 0,0:04:31.00,0:04:32.00,Default,,0,0,0,,Мен кеттім...
Dialogue: 0,0:04:32.00,0:04:36.00,Default,,0,0,0,,Менің әкем Қара орденді ғалым.
Dialogue: 0,0:04:36.00,0:04:39.00,Default,,0,0,0,,Мен көптен бері оралмадым.
Dialogue: 0,0:04:39.00,0:04:44.00,Default,,0,0,0,,Содан кейін мен уақытты өлтіру үшін оқып жүрген әкемнің зерттеу материалдарынан жындар туралы білдім.
Dialogue: 0,0:04:44.00,0:04:47.00,Default,,0,0,0,,Лорд Уокер... Лорд Уокер...
Dialogue: 0,0:04:47.00,0:04:50.00,Default,,0,0,0,,Бұрынғы қариялар мұны білмеді.
Dialogue: 0,0:04:50.00,0:04:55.00,Default,,0,0,0,,Мен қаланы жындардың шабуылынан қорғау үшін патрульдемін.
Dialogue: 0,0:04:55.00,0:04:56.00,Default,,0,0,0,,Патруль?
Dialogue: 0,0:04:56.00,0:05:01.00,Default,,0,0,0,,Менің досым бар! Оны Лео деп атайды және ол өте жақсы жігіт.
Dialogue: 0,0:05:01.00,0:05:05.00,Default,,0,0,0,,Уокер мырза, егер сіз өзімшілдікпен әрекет етсеңіз, мен қиыншылыққа тап боламын.
Dialogue: 0,0:05:05.00,0:05:07.00,Default,,0,0,0,,Мен тезірек штабқа оралуым керек.
Dialogue: 0,0:05:07.00,0:05:10.00,Default,,0,0,0,,А, иә, мен білемін.
Dialogue: 0,0:05:10.00,0:05:14.00,Default,,0,0,0,,Бұл патрульдердің мақсаты жындарды зерттеу.
Dialogue: 0,0:05:14.00,0:05:16.00,Default,,0,0,0,,Неліктен зерттегіңіз келеді?
Dialogue: 0,0:05:16.00,0:05:17.00,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:05:17.00,0:05:23.00,Default,,0,0,0,,Бір күні мен ұлы ғалым болып, жындарды әп-сәтте жоя алатын қару жасаймын!
Dialogue: 0,0:05:23.00,0:05:26.00,Default,,0,0,0,,Мм, жарайды, А-чан.
Dialogue: 0,0:05:27.00,0:05:28.00,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:05:28.00,0:05:29.00,Default,,0,0,0,,Не?
Dialogue: 0,0:05:29.00,0:05:33.00,Default,,0,0,0,,Эксорцистер соншалықты кедей көрінеді.
Dialogue: 0,0:05:33.00,0:05:35.00,Default,,0,0,0,,Кедей ме?
Dialogue: 0,0:05:35.00,0:05:38.00,Default,,0,0,0,,Менің бейнем көнекөз қария еді.
Dialogue: 0,0:05:38.00,0:05:40.00,Default,,0,0,0,,Бұл Алленге мүлдем қарама-қарсы.
Dialogue: 0,0:05:44.00,0:05:46.00,Default,,0,0,0,,Осылайша сіз жын шығарушы болдыңыз.
Dialogue: 0,0:05:46.00,0:05:51.00,Default,,0,0,0,,Ол жерге қалай жеттіңіз? Ол жерге қалай жеттіңіз? Біреудің ақшасы ма?
Dialogue: 0,0:05:51.00,0:05:53.00,Default,,0,0,0,,Менің ойымша, ақша мұны істемейді ...
Dialogue: 0,0:05:54.00,0:05:57.00,Default,,0,0,0,,Сол ұлы шайтан қаруын қайдан алдың?
Dialogue: 0,0:05:57.00,0:06:00.00,Default,,0,0,0,,Алғаш рет қашан жынды осылай жойдыңыз?
Dialogue: 0,0:06:00.00,0:06:02.00,Default,,0,0,0,,Сол кезде қандай сезімде болдыңыз?
Dialogue: 0,0:06:02.00,0:06:04.00,Default,,0,0,0,,Осы уақытқа дейін қанша жындарды жойдыңыз?
Dialogue: 0,0:06:08.00,0:06:11.00,Default,,0,0,0,,Мені қарғыс атсын, Аллен!
Dialogue: 0,0:06:21.00,0:06:24.00,Default,,0,0,0,,Джин, мойынды тым сыртқа шығармау керек.
Dialogue: 0,0:06:25.00,0:06:29.00,Default,,0,0,0,,Лео достарымен патрульге шығуды тоқтатты.
Dialogue: 0,0:06:29.00,0:06:33.00,Default,,0,0,0,,Қажетсіз нәрсе жасап, Сеннен Ширайшидің көзіне түссеңіз, бұл қауіпті.
Dialogue: 0,0:06:35.00,0:06:36.00,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,0:06:37.00,0:06:38.00,Default,,0,0,0,,Пияз?
Dialogue: 0,0:06:43.00,0:06:45.00,Default,,0,0,0,,Мен, мен, меза!
Dialogue: 0,0:06:46.00,0:06:48.00,Default,,0,0,0,,Менің өнертабысым - пияз бомбасы!
Dialogue: 0,0:06:49.00,0:06:52.00,Default,,0,0,0,,Ібілістің шабуылын елемеуге болмайды!
Dialogue: 0,0:06:53.00,0:06:56.00,Default,,0,0,0,,Мен Алленге қарағанда әлдеқайда пайдалымын.
Dialogue: 0,0:06:56.00,0:06:58.00,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:07:00.00,0:07:02.00,Default,,0,0,0,,Қажетсіз істерге араласып кеткендіктен.
Dialogue: 0,0:07:02.00,0:07:03.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:07:04.00,0:07:11.00,Default,,0,0,0,,Иә, егер сіз соншалықты уайымдасаңыз, осы қаланы басқаратын іздеуші оны бақылап тұрсын.
Dialogue: 0,0:07:11.00,0:07:12.00,Default,,0,0,0,,Не?
Dialogue: 0,0:07:12.00,0:07:14.00,Default,,0,0,0,,Сондықтан, тезірек штабқа баруыңызды өтінемін.
Dialogue: 0,0:07:14.00,0:07:16.00,Default,,0,0,0,,Иә, рахмет, Тама.
Dialogue: 0,0:07:16.00,0:07:17.00,Default,,0,0,0,,Ешқашан аяқталмайды
Dialogue: 0,0:07:18.00,0:07:19.00,Default,,0,0,0,,Ол ешқашан бітпейді
Dialogue: 0,0:07:20.00,0:07:22.00,Default,,0,0,0,,Біткен соң ғажайып
Dialogue: 0,0:07:23.00,0:07:25.00,Default,,0,0,0,,О, бұл
Dialogue: 0,0:07:25.00,0:07:27.00,Default,,0,0,0,,Артық емес.
Dialogue: 0,0:07:27.00,0:07:30.00,Default,,0,0,0,,Алда көп нәрсе бар.
Dialogue: 0,0:07:34.00,0:07:37.00,Default,,0,0,0,,Ленали штабтың үй екенін айтты.
Dialogue: 0,0:07:38.00,0:07:40.00,Default,,0,0,0,,Сен неге адамдарды сонша қорғайсың?
Dialogue: 0,0:07:40.00,0:07:42.00,Default,,0,0,0,,Кофе ішуші?
Dialogue: 0,0:07:42.00,0:07:43.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:43.00,0:07:45.00,Default,,0,0,0,,Ум, Ленали.
Dialogue: 0,0:07:46.00,0:07:47.00,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:07:47.00,0:07:48.00,Default,,0,0,0,,Не?
Dialogue: 0,0:07:48.00,0:07:52.00,Default,,0,0,0,,Бұл қалпына келтірілген кінәсіздік.
Dialogue: 0,0:07:52.00,0:07:56.00,Default,,0,0,0,,Ах, оны Фебрастаға апарыңыз, ол оны қорғайды.
Dialogue: 0,0:07:57.00,0:07:58.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:58.00,0:07:59.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:59.00,0:08:00.00,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:08:01.00,0:08:02.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:03.00,0:08:04.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:05.00,0:08:06.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:06.00,0:08:07.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:07.00,0:08:08.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:08.00,0:08:09.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:10.00,0:08:18.00,Default,,0,0,0,,ЛАОС
Dialogue: 0,0:08:18.00,0:08:21.00,Default,,0,0,0,,Гонконг
Dialogue: 0,0:08:21.00,0:08:23.00,Default,,0,0,0,,Мұндай сезім реакциясы
Dialogue: 0,0:08:24.00,0:08:32.00,Default,,0,0,0,,Және қырыққабат
Dialogue: 0,0:08:33.00,0:08:34.00,Default,,0,0,0,,мүкжидек
Dialogue: 0,0:08:35.00,0:08:37.50,Default,,0,0,0,,Чин
Dialogue: 0,0:08:35.00,0:08:37.00,Default,,0,0,0,,Жаңа ғана өттім
Dialogue: 0,0:08:39.00,0:08:47.00,Default,,0,0,0,,Жарамдылығы белгісіз Кінәсіздікті келесі жолы Генсуи мен басқалары қайтып келгенше мен қорғауым керек.
Dialogue: 0,0:08:47.00,0:08:57.00,Default,,0,0,0,,Генсуи, оның ішінде сіздің шебер Крестіңіз, мұнда жоқ. Олар сондай-ақ белгісіз Innocence-пен үйлесімді біреуді табу миссиясында.
Dialogue: 0,0:08:57.00,0:09:03.00,Default,,0,0,0,,Осылайша сіз жын шығарушы болдыңыз. Сіз қалай эксзорцист болдыңыз?
Dialogue: 0,0:09:06.00,0:09:10.00,Default,,0,0,0,,Сіз эксорцист болғыңыз келе ме?
Dialogue: 0,0:09:11.00,0:09:14.00,Default,,0,0,0,,Қараңызшы, Аллен мырза.
Dialogue: 0,0:09:16.00,0:09:22.00,Default,,0,0,0,,Эбу денесінің ішінде кінәсіздіктің 109 тесігі белгіленген.
Dialogue: 0,0:09:22.00,0:09:29.00,Default,,0,0,0,,Ішімде біраз ұйықтап, Жазықсыз, лайықты адамды кездестір.
Dialogue: 0,0:09:29.00,0:09:33.00,Default,,0,0,0,,Қаруыңды қарызға берген күнге дейін
Dialogue: 0,0:09:35.00,0:09:52.00,Default,,0,0,0,,Осы уақытқа дейін кінәсіздіктің 41 бөлігі қалпына келтірілді. Дүниеде әлі де кінәсіздік бар.
Dialogue: 0,0:10:05.00,0:10:07.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:21.00,0:10:26.00,Default,,0,0,0,,Тоқтама, жүре бер
Dialogue: 0,0:10:36.00,0:10:38.00,Default,,0,0,0,,Мана
Dialogue: 0,0:10:42.00,0:10:49.00,Default,,0,0,0,,Шаршадым деп ойлаймын. Көп нәрсені есіме түсіріп, жақсы ұйықтай алмадым.
Dialogue: 0,0:10:49.00,0:10:52.00,Default,,0,0,0,,Сосын мен оны сұрадым.
Dialogue: 0,0:10:52.00,0:10:54.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:54.00,0:10:56.00,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:10:56.00,0:10:57.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:57.00,0:11:00.00,Default,,0,0,0,,Буфетке кірмеген дұрыс.
Dialogue: 0,0:11:00.00,0:11:06.00,Default,,0,0,0,,Дұрыс, Джерри тамақты күйдіріп алған сияқты, оның иісі қорқынышты.
Dialogue: 0,0:11:06.00,0:11:08.00,Default,,0,0,0,,Өйткені иіс шыдамайды
Dialogue: 0,0:11:08.00,0:11:11.00,Default,,0,0,0,,Мен мұндай нәрсеге жақсымын.
Dialogue: 0,0:11:11.00,0:11:13.00,Default,,0,0,0,,Әйтеуір, енді кірме.
Dialogue: 0,0:11:13.00,0:11:15.00,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:11:15.00,0:11:19.00,Default,,0,0,0,,Мен сізге кейінірек қоңырау шаламын, сондықтан бөлмеңізде тағы біраз күтіңіз.
Dialogue: 0,0:11:19.00,0:11:22.00,Default,,0,0,0,,Иә
Dialogue: 0,0:11:25.00,0:11:26.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:26.00,0:11:28.00,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:11:28.00,0:11:32.00,Default,,0,0,0,,Ғылыми топта Жан деген әке бар ма?
Dialogue: 0,0:11:32.00,0:11:35.00,Default,,0,0,0,,Иә? Жан?
Dialogue: 0,0:11:49.00,0:11:54.00,Default,,0,0,0,,Онда сіз Джейк Рассел туралы айтып отырған боларсыз.
Dialogue: 0,0:11:55.00,0:11:58.00,Default,,0,0,0,,Рассел тобы таудың арғы жағында.
Dialogue: 0,0:12:04.00,0:12:06.00,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:12:06.00,0:12:09.00,Default,,0,0,0,,Тепе-теңдік нәзік тепе-теңдікте сақталады.
Dialogue: 0,0:12:09.00,0:12:14.00,Default,,0,0,0,,Нашар қозғалтсаң, тау құлап, сені де езеді.
Dialogue: 0,0:12:14.00,0:12:17.00,Default,,0,0,0,,Сіз мистер Расселсіз бе?
Dialogue: 0,0:12:19.00,0:12:21.00,Default,,0,0,0,,Мен кеше Жанмен кездестім.
Dialogue: 0,0:12:21.00,0:12:25.00,Default,,0,0,0,,Ол қаланы жын-шайтандардан қорғау үшін патрульдейтінін айтты.
Dialogue: 0,0:12:25.00,0:12:28.00,Default,,0,0,0,,Әкеңізге қауіпті істерді тоқтатуын айтыңыз.
Dialogue: 0,0:12:28.00,0:12:30.00,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:12:30.00,0:12:33.00,Default,,0,0,0,,Оны табу үшін маған үш күн қажет болды.
Dialogue: 0,0:12:33.00,0:12:34.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:34.00,0:12:36.00,Default,,0,0,0,,Мен мұнда есептеуде қате жібердім бе?
Dialogue: 0,0:12:36.00,0:12:38.00,Default,,0,0,0,,Мен бір аптаны босқа өткіздім
Dialogue: 0,0:12:38.00,0:12:41.00,Default,,0,0,0,,Қайтадан басынан бастап
Dialogue: 0,0:12:46.00,0:12:48.00,Default,,0,0,0,,Енді орындалды.
Dialogue: 0,0:12:48.00,0:12:51.00,Default,,0,0,0,,Дайындық жақсы.
Dialogue: 0,0:12:52.00,0:12:55.00,Default,,0,0,0,,Харреннің алғашқы сәтті миссиясын тойлау
Dialogue: 0,0:12:55.00,0:12:57.00,Default,,0,0,0,,Бәріміз бірге көңіл көтерейік
Dialogue: 0,0:12:57.00,0:12:59.00,Default,,0,0,0,,«Қиын екен.»
Dialogue: 0,0:12:59.00,0:13:02.00,Default,,0,0,0,,Харрен-кун еш жерде жоқ.
Dialogue: 0,0:13:10.00,0:13:12.00,Default,,0,0,0,,Мистер Уокер қайда?
Dialogue: 0,0:13:12.00,0:13:15.00,Default,,0,0,0,,Біз де іздейміз
Dialogue: 0,0:13:15.00,0:13:17.00,Default,,0,0,0,,Қызық, қайда бардың?
Dialogue: 0,0:13:17.00,0:13:21.00,Default,,0,0,0,,Лорд Уокер Жан деген балаға барса керек.
Dialogue: 0,0:13:22.00,0:13:25.00,Default,,0,0,0,,Маған қайта қоңырау шалмасаңыз, бұл қауіпті.
Dialogue: 0,0:13:25.00,0:13:28.00,Default,,0,0,0,,Баланы бақылап тұрған табушылардың бірі
Dialogue: 0,0:13:28.00,0:13:31.00,Default,,0,0,0,,Мен сені жын өлтірді деген хабар алдым.
Dialogue: 0,0:13:36.00,0:13:40.00,Default,,0,0,0,,Jumbo Chama тұтынушысы.
Dialogue: 0,0:13:40.00,0:13:43.00,Default,,0,0,0,,Джумбо Чама
Dialogue: 0,0:13:46.00,0:13:48.00,Default,,0,0,0,,Кім?
Dialogue: 0,0:13:48.00,0:13:50.00,Default,,0,0,0,,Раянна
Dialogue: 0,0:13:50.00,0:13:53.00,Default,,0,0,0,,Раянна
Dialogue: 0,0:13:54.00,0:13:56.00,Default,,0,0,0,,Көптен бері досыммен кездеспедім
Dialogue: 0,0:13:56.00,0:14:00.00,Default,,0,0,0,,Мен уайымдадым, өйткені мен сізден жерлеу рәсімінен бері хабар алмадым.
Dialogue: 0,0:14:00.00,0:14:03.00,Default,,0,0,0,,Сіз қазір туыстарыңызбен тұрасыз ба?
Dialogue: 0,0:14:03.00,0:14:07.00,Default,,0,0,0,,Менің қолымнан келгеннің бәрі сізге көмектеседі, сондықтан менің көңіл-күйімді көтеріңіз.
Dialogue: 0,0:14:09.00,0:14:11.00,Default,,0,0,0,,Бұл әйтеуір басқаша сезіледі.
Dialogue: 0,0:14:11.00,0:14:14.00,Default,,0,0,0,,Анамның қайтыс болғанын естігенде қатты таң қалса керек.
Dialogue: 0,0:14:14.00,0:14:18.00,Default,,0,0,0,,Мен сенің көңіліңді көтеру үшін бірдеңе істей аламын ба?
Dialogue: 0,0:14:18.00,0:14:20.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:20.00,0:14:23.00,Default,,0,0,0,,Мен кеше бірінші жынымды таптым.
Dialogue: 0,0:14:25.00,0:14:28.00,Default,,0,0,0,,Мың жылдық ақ жүзді мен де көрдім
Dialogue: 0,0:14:28.00,0:14:31.00,Default,,0,0,0,,Сөз жоқ, қазір қағазға түсіремін.
Dialogue: 0,0:14:31.00,0:14:34.00,Default,,0,0,0,,Міне, солай
Dialogue: 0,0:14:34.00,0:14:36.00,Default,,0,0,0,,Олай, былай
Dialogue: 0,0:14:36.00,0:14:38.00,Default,,0,0,0,,Ленале
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,Менің ағам үшін.
Dialogue: 0,0:14:43.00,0:14:46.00,Default,,0,0,0,,Арлен ғана емес, Ленали де кетті.
Dialogue: 0,0:14:46.00,0:14:48.00,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:14:48.00,0:14:50.00,Default,,0,0,0,,Мен ол жайлы білмеймін.
Dialogue: 0,0:14:50.00,0:14:54.00,Default,,0,0,0,,Сондықтан ол қайтып келе салысымен той жасауымыз керек еді.
Dialogue: 0,0:14:54.00,0:14:56.00,Default,,0,0,0,,Ол өлді, балақай.
Dialogue: 0,0:14:58.00,0:15:02.00,Default,,0,0,0,,Осы ащы адамға таратып, қайтадан патрульге шығайық.
Dialogue: 0,0:15:03.00,0:15:08.00,Default,,0,0,0,,Жан, мен сенің бір сәтке келуіңді қалаймын.
Dialogue: 0,0:15:09.00,0:15:14.00,Default,,0,0,0,,Мен оны өз аузымнан да дұрыс түсіндіруім керек.
Dialogue: 0,0:15:17.00,0:15:18.00,Default,,0,0,0,,Иә
Dialogue: 0,0:15:18.00,0:15:21.00,Default,,0,0,0,,Ум, менің атым Аллен Уокер.
Dialogue: 0,0:15:21.00,0:15:23.00,Default,,0,0,0,,Сен осындасың ба, Жан?
Dialogue: 0,0:15:23.00,0:15:25.00,Default,,0,0,0,,Бұл джумбочама ма?
Dialogue: 0,0:15:33.00,0:15:35.00,Default,,0,0,0,,Сен тіпті уағыз айтып өлдің бе?
Dialogue: 0,0:15:35.00,0:15:37.00,Default,,0,0,0,,Мен сені тыңдамаймын.
Dialogue: 0,0:15:37.00,0:15:38.00,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:15:38.00,0:15:39.00,Default,,0,0,0,,Кеттік, Лео.
Dialogue: 0,0:15:45.00,0:15:47.00,Default,,0,0,0,,Ал, күте тұр, Жан.
Dialogue: 0,0:15:47.00,0:15:48.00,Default,,0,0,0,,Бала
Dialogue: 0,0:15:56.00,0:15:58.00,Default,,0,0,0,,Бұл сіз келгіңіз келетін жер ме?
Dialogue: 0,0:15:58.00,0:16:01.00,Default,,0,0,0,,Анаңның зиратына барғың келді ме?
Dialogue: 0,0:16:01.00,0:16:04.00,Default,,0,0,0,,Олай болса тез айт.
Dialogue: 0,0:16:04.00,0:16:05.00,Default,,0,0,0,,Судың иісі
Dialogue: 0,0:16:08.00,0:16:10.00,Default,,0,0,0,,Қайырлы кеш, Жан.
Dialogue: 0,0:16:16.00,0:16:18.00,Default,,0,0,0,,Millennium White
Dialogue: 0,0:16:24.00,0:16:26.00,Default,,0,0,0,,Қазір қашып кет, Лео.
Dialogue: 0,0:16:26.00,0:16:27.00,Default,,0,0,0,,Арыстан
Dialogue: 0,0:16:27.00,0:16:29.00,Default,,0,0,0,,Эй, не болды?
Dialogue: 0,0:16:29.00,0:16:32.00,Default,,0,0,0,,Қашпасаң, ақтар өледі.
Dialogue: 0,0:16:32.00,0:16:35.00,Default,,0,0,0,,Лео-кун баяғыда өлген болар еді.
Dialogue: 0,0:16:37.00,0:16:40.00,Default,,0,0,0,,Анамды жерлеу күні.
Dialogue: 0,0:16:40.00,0:16:48.00,Default,,0,0,0,,Менің жолыма түскенің үшін сені жалғыз қалдыратын шайтан осы.
Dialogue: 0,0:16:48.00,0:16:49.00,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:16:50.00,0:16:52.00,Default,,0,0,0,,Бұл рас, Жан.
Dialogue: 0,0:16:57.00,0:16:58.00,Default,,0,0,0,,Арыстан
Dialogue: 0,0:17:02.00,0:17:04.00,Default,,0,0,0,,Бала адам емес.
Dialogue: 0,0:17:04.00,0:17:11.00,Default,,0,0,0,,Досыңның, шайтанның терісін киген мыңжылдық ақ қару.
Dialogue: 0,0:17:13.00,0:17:18.00,Default,,0,0,0,,Жанның досы Леоның анасы жақында қайтыс болды.
Dialogue: 0,0:17:18.00,0:17:22.00,Default,,0,0,0,,Жанды бақылап тұрған Финдерді өлтірген жын болса керек
Dialogue: 0,0:17:22.00,0:17:24.00,Default,,0,0,0,,Димкампи
Dialogue: 0,0:17:24.00,0:17:26.00,Default,,0,0,0,,Аллен мырза
Dialogue: 0,0:17:28.00,0:17:29.00,Default,,0,0,0,,Кім?
Dialogue: 0,0:17:29.00,0:17:31.00,Default,,0,0,0,,Мен сенің жауыңмын
Dialogue: 0,0:17:32.00,0:17:34.00,Default,,0,0,0,,Сіз эксорцистсіз бе?
Dialogue: 0,0:17:34.00,0:17:37.00,Default,,0,0,0,,Сәлем, танысқаныма қуаныштымын.
Dialogue: 0,0:17:37.00,0:17:39.00,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:17:39.00,0:17:41.00,Default,,0,0,0,,Фалко!!
Dialogue: 0,0:17:44.00,0:17:46.00,Default,,0,0,0,,Крест, шайтанды құрту
Dialogue: 0,0:17:47.00,0:17:49.00,Default,,0,0,0,,Жанды сақта
Dialogue: 0,0:17:52.00,0:17:53.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:17:55.00,0:17:56.00,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:17:57.00,0:18:01.00,Default,,0,0,0,,Неліктен, Лео неге шайтан?
Dialogue: 0,0:18:01.00,0:18:03.00,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:18:03.00,0:18:07.00,Default,,0,0,0,,Тіпті шайтанның шайқасы да осы жігіттен басталды.
Dialogue: 0,0:18:07.00,0:18:12.00,Default,,0,0,0,,Қаланы бірге қорғауға тырыссақ та, бұл жігіттің шайтан болуы мүмкін емес.
Dialogue: 0,0:18:12.00,0:18:15.00,Default,,0,0,0,,Дәлел ретінде не айтасыз?
Dialogue: 0,0:18:23.00,0:18:24.00,Default,,0,0,0,,Арыстан
Dialogue: 0,0:18:29.00,0:18:30.00,Default,,0,0,0,,Аллен
Dialogue: 0,0:18:32.00,0:18:34.00,Default,,0,0,0,,Аллен атылды.
Dialogue: 0,0:18:34.00,0:18:39.00,Default,,0,0,0,,Жоқ, шайтанның оқтары адам ағзасын бұзатын вирусқа толы.
Dialogue: 0,0:18:41.00,0:18:47.00,Default,,0,0,0,,Әй, оқтың алдынан ойланбастан секіруге не жетсін.
Dialogue: 0,0:18:48.00,0:18:52.00,Default,,0,0,0,,Жан, сен ренжіттің.
Dialogue: 0,0:18:52.00,0:18:55.00,Default,,0,0,0,,Күш болмаса да, шек бар.
Dialogue: 0,0:18:55.00,0:18:59.00,Default,,0,0,0,,Жан, сен ренжіттің.
Dialogue: 0,0:18:59.00,0:19:05.00,Default,,0,0,0,,Күш-қуатым жоқ болса да, әділдікке құмармын, мені жаман адам, жаман адам деп санайды.
Dialogue: 0,0:19:06.00,0:19:12.00,Default,,0,0,0,,Мен барлығына шайтан жасап жатырмын.
Dialogue: 0,0:19:13.00,0:19:16.00,Default,,0,0,0,,Сіз қалай ойлайсыз? Ұсқынсыз.
Dialogue: 0,0:19:16.00,0:19:21.00,Default,,0,0,0,,Бұл адам жүрегінен туындаған күнәнің жемісі.
Dialogue: 0,0:19:21.00,0:19:27.00,Default,,0,0,0,,Сіз шайтанды менің қолымнан жасалған қару деп ойлайтын сияқтысыз.
Dialogue: 0,0:19:27.00,0:19:31.00,Default,,0,0,0,,Жындар адамның жүрегінен туады.
Dialogue: 0,0:19:31.00,0:19:37.00,Default,,0,0,0,,Дұрыс, бұл шайтан сіздің ең жақын досыңыз Леодан туған.
Dialogue: 0,0:19:37.00,0:19:38.00,Default,,0,0,0,,Лео?
Dialogue: 0,0:19:38.00,0:19:48.00,Default,,0,0,0,,Лео Хакушакудың күшін пайдаланып, қайтыс болған анасының жанын осы дүниеге әкеліп, оны жынға айналдырды.
Dialogue: 0,0:19:48.00,0:19:57.00,Default,,0,0,0,,Мен оның анасының жын боп қиналғанын көріп тұрмын.
Dialogue: 0,0:19:57.00,0:20:04.00,Default,,0,0,0,,Көрдіңіз бе? Сен не туралы айтып тұрсың? Бұл өлім түбі жоқ.
Dialogue: 0,0:20:04.00,0:20:12.00,Default,,0,0,0,,Мен үлкен зұлымдық қаруын ұстаған адаммын. Ағзадағы вирустарды тазартуға болады
Dialogue: 0,0:20:19.00,0:20:22.00,Default,,0,0,0,,Өлім, өлім тікелей әсер етеді
Dialogue: 0,0:20:22.00,0:20:26.00,Default,,0,0,0,,Бұл сіз үшін не?
Dialogue: 0,0:20:26.00,0:20:28.00,Default,,0,0,0,,Қарғыс
Dialogue: 0,0:20:30.00,0:20:34.00,Default,,0,0,0,,Баяғыда мен үшін маңызды біреуді жынға айналдырдым.
Dialogue: 0,0:20:34.00,0:20:40.00,Default,,0,0,0,,Сол қарғыстың арқасында бұл көздер шайтанның ішіндегі жанды көреді.
Dialogue: 0,0:20:40.00,0:20:47.00,Default,,0,0,0,,О, есімде. Жолдасым сені бір рет кездестірді.
Dialogue: 0,0:20:49.00,0:20:56.00,Default,,0,0,0,,Сіз Аллен Уокерсіз, әкесін жынға айналдырған баласыз.
Dialogue: 0,0:20:57.00,0:21:00.00,Default,,0,0,0,,Аллен әкесін жынға айналдырды.
Dialogue: 0,0:21:18.00,0:21:27.00,Default,,0,0,0,,Осы жерде ернімізді тістеп, иықтарымызды біріктіреміз.
Dialogue: 0,0:21:28.00,0:21:38.00,Default,,0,0,0,,Мен сені соңғы рет көрген күнді жадымда жасырдым.
Dialogue: 0,0:21:38.00,0:21:47.00,Default,,0,0,0,,Көлде серуендеу, Сол Ғажайып жастар
Dialogue: 0,0:21:47.00,0:21:55.00,Default,,0,0,0,,Қар сүю, қош бол сенімен
Dialogue: 0,0:21:55.00,0:22:01.00,Default,,0,0,0,,Осы сәт, сенімен бірге жүріп, осы сәт
Dialogue: 0,0:22:01.00,0:22:08.00,Default,,0,0,0,,Қар сүю, қош бол сенімен
Dialogue: 0,0:22:08.00,0:22:13.00,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:22:14.00,0:22:20.00,Default,,0,0,0,,Махаббатты, қайғыны, сезімді алып тастау мүмкін емес
Dialogue: 0,0:22:20.00,0:22:28.00,Default,,0,0,0,,Шрамдар, оларды өшірме, өшірме
Dialogue: 0,0:22:32.00,0:22:37.00,Default,,0,0,0,,Біздің алдымызда пайда болған Мыңжылдық Ақ
Dialogue: 0,0:22:37.00,0:22:43.00,Default,,0,0,0,,Сол суретті көргенде, сол жаман күн есіме оралды.
Dialogue: 0,0:22:43.00,0:22:47.00,Default,,0,0,0,,Келесі жолы Д.Греймен, Аналық жады кестесі
Dialogue: 0,0:22:47.00,0:22:50.00,Default,,0,0,0,,Бейшара шайтанның жанын құтқару
Dialogue: 0,0:22:51.50,0:22:57.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory