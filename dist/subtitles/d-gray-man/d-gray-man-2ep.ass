Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:06.00,Default,,0,0,0,,- Музыка-
Dialogue: 0,0:00:06.00,0:00:11.00,Default,,0,0,0,,Кеуде қуысындағы жарақатта
Dialogue: 0,0:00:11.00,0:00:16.00,Default,,0,0,0,,Толып жатқан қол мен тамағы
Dialogue: 0,0:00:16.00,0:00:22.00,Default,,0,0,0,,Бірін-бірі қайталайтын сәттер
Dialogue: 0,0:00:22.00,0:00:27.00,Default,,0,0,0,,Қосылып, балқытамыз деп ойладым
Dialogue: 0,0:00:27.00,0:00:32.00,Default,,0,0,0,,Суымайтын қызбамен ауыру
Dialogue: 0,0:00:32.00,0:00:38.00,Default,,0,0,0,,Соңғы дауысты да естімеймін
Dialogue: 0,0:00:38.00,0:00:44.00,Default,,0,0,0,,Бұл жолы мен сені қатты құшақтап алсам, үзіліп кететіндей болдым
Dialogue: 0,0:00:44.00,0:00:49.00,Default,,0,0,0,,Сен қалтырап тұрдың
Dialogue: 0,0:00:49.00,0:00:53.00,Default,,0,0,0,,Алақанда
Dialogue: 0,0:00:53.00,0:00:57.00,Default,,0,0,0,,Маған қол тигізуге рұқсат етіңіз
Dialogue: 0,0:00:57.00,0:01:01.00,Default,,0,0,0,,Сіз оны іздегеніңізге сенімдімін.
Dialogue: 0,0:01:01.00,0:01:08.00,Default,,0,0,0,,Ешқашан өшпейтін ғажайыптың есімі
Dialogue: 0,0:01:08.00,0:01:17.00,Default,,0,0,0,,Маған алақаныңызбен қаттырақ тигізіңіз
Dialogue: 0,0:01:18.00,0:01:22.00,Default,,0,0,0,,Ешқашан аяқталмайды
Dialogue: 0,0:01:22.00,0:01:27.00,Default,,0,0,0,,Falloway-ді босатыңыз
Dialogue: 0,0:01:33.00,0:01:34.00,Default,,0,0,0,,Эксорцист
Dialogue: 0,0:01:34.00,0:01:38.00,Default,,0,0,0,,Құдай көргендер
Dialogue: 0,0:01:40.00,0:01:43.00,Default,,0,0,0,,Олар қараңғылықтан шығады
Dialogue: 0,0:01:43.00,0:01:46.00,Default,,0,0,0,,Тәкаппарларды менсінбеу
Dialogue: 0,0:01:59.00,0:02:03.00,Default,,0,0,0,,Әй, мына жерге неге мұндай нәрсені салдың?
Dialogue: 0,0:02:13.00,0:02:15.00,Default,,0,0,0,,Ақыры келді
Dialogue: 0,0:02:15.00,0:02:17.00,Default,,0,0,0,,Exorcist штабы
Dialogue: 0,0:02:17.00,0:02:19.00,Default,,0,0,0,,Қара табыну
Dialogue: 0,0:02:20.00,0:02:22.00,Default,,0,0,0,,Кана
Dialogue: 0,0:02:22.00,0:02:24.00,Default,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,0:02:24.00,0:02:26.00,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:02:26.00,0:02:28.00,Default,,0,0,0,,Бұл атмосфералық.
Dialogue: 0,0:02:29.00,0:02:32.00,Default,,0,0,0,,Міне, Тим Кэмпи.
Dialogue: 0,0:02:32.00,0:02:34.00,Default,,0,0,0,,Мен бәрібір баруым керек пе?
Dialogue: 0,0:02:43.00,0:02:45.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:02:45.00,0:02:48.00,Default,,0,0,0,,Сен сол жартасқа шыға алдың ба?
Dialogue: 0,0:02:48.00,0:02:50.00,Default,,0,0,0,,Олар осы жаққа келеді.
Dialogue: 0,0:02:50.00,0:02:52.00,Default,,0,0,0,,Бұл қандай бала?
Dialogue: 0,0:02:52.00,0:02:55.00,Default,,0,0,0,,Жоқ, мен бөгде адамды кіргіземін.
Dialogue: 0,0:02:55.00,0:02:57.00,Default,,0,0,0,,Сен неге оны жардан түсірмедің?
Dialogue: 0,0:02:57.00,0:02:59.00,Default,,0,0,0,,Ах, мэр Комуши.
Dialogue: 0,0:02:59.00,0:03:02.00,Default,,0,0,0,,Бұл өзімді бөтен адам сияқты сезінбеймін.
Dialogue: 0,0:03:02.00,0:03:04.00,Default,,0,0,0,,Мынаны қарашы, ағайын.
Dialogue: 0,0:03:04.00,0:03:08.00,Default,,0,0,0,,Бұл баланың жанында шикі су құйылған голем бар.
Dialogue: 0,0:03:08.00,0:03:11.00,Default,,0,0,0,,Мен Кросс Мариан шикі суын таныстыра алдым.
Dialogue: 0,0:03:11.00,0:03:13.00,Default,,0,0,0,,Бұл Аллен Хокер.
Dialogue: 0,0:03:13.00,0:03:17.00,Default,,0,0,0,,Мен культ басшыларымен танысқым келеді.
Dialogue: 0,0:03:17.00,0:03:19.00,Default,,0,0,0,,Мен Генсуиді білемін.
Dialogue: 0,0:03:19.00,0:03:21.00,Default,,0,0,0,,Бұл адам тірі ме?
Dialogue: 0,0:03:21.00,0:03:23.00,Default,,0,0,0,,Ол кіріспе деп аталады.
Dialogue: 0,0:03:23.00,0:03:26.00,Default,,0,0,0,,Әкім, сіз менен бірдеңе сұрап тұрсыз ба?
Dialogue: 0,0:03:29.00,0:03:31.00,Default,,0,0,0,,Ол адам тірі ме?
Dialogue: 0,0:03:31.00,0:03:33.00,Default,,0,0,0,,Бұл адам тірі ме?
Dialogue: 0,0:03:33.00,0:03:35.00,Default,,0,0,0,,Сіз тыңдайсыз ба?
Dialogue: 0,0:03:40.00,0:03:42.00,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:03:42.00,0:03:46.00,Default,,0,0,0,,Хмм, қақпашы физикалық тексеруден өткеннен кейін.
Dialogue: 0,0:03:51.00,0:03:53.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:55.00,0:04:00.00,Default,,0,0,0,,Рентгендік зерттеу, шайтан ма, әлде адам ба? Жоғары линза
Dialogue: 0,0:04:04.00,0:04:08.00,Default,,0,0,0,,Бұл қате ме?
Dialogue: 0,0:04:15.00,0:04:18.00,Default,,0,0,0,,Мына жігіт шықты
Dialogue: 0,0:04:20.00,0:04:24.00,Default,,0,0,0,,Мына жігіттің қарғыс атқаны шықты
Dialogue: 0,0:04:24.00,0:04:26.00,Default,,0,0,0,,Ментакул жұмысының жолақ мөрі
Dialogue: 0,0:04:26.00,0:04:30.00,Default,,0,0,0,,1000, 800 адам жолдас болуы мүмкін.
Dialogue: 0,0:04:31.00,0:04:34.00,Default,,0,0,0,,Ащы жаңа
Dialogue: 0,0:04:34.00,0:04:36.00,Default,,0,0,0,,Ащы жаңа
Dialogue: 0,0:04:36.00,0:04:38.00,Default,,0,0,0,,Жүністің эфтокисті кім?
Dialogue: 0,0:04:38.00,0:04:40.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:40.00,0:04:42.00,Default,,0,0,0,,Қандаға келді.
Dialogue: 0,0:04:52.00,0:04:54.00,Default,,0,0,0,,Жалғыз келе жатырсыз ба?
Dialogue: 0,0:04:54.00,0:04:56.00,Default,,0,0,0,,Жақсы батылдық, солай емес пе?
Dialogue: 0,0:04:56.00,0:04:58.00,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:04:58.00,0:05:00.00,Default,,0,0,0,,Мен бір нәрсені дұрыс түсінбедім.
Dialogue: 0,0:05:00.00,0:05:02.00,Default,,0,0,0,,Шексіз Батту
Dialogue: 0,0:05:25.00,0:05:27.00,Default,,0,0,0,,Жындарға қарсы қаруда сызаттар бар
Dialogue: 0,0:05:27.00,0:05:29.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:05:29.00,0:05:31.00,Default,,0,0,0,,Бұл қандай қол?
Dialogue: 0,0:05:31.00,0:05:33.00,Default,,0,0,0,,Бұл шайтанға қарсы қару.
Dialogue: 0,0:05:33.00,0:05:35.00,Default,,0,0,0,,Мен жын шығарушымын
Dialogue: 0,0:05:35.00,0:05:37.00,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:05:37.00,0:05:39.00,Default,,0,0,0,,Қақпашы
Dialogue: 0,0:05:39.00,0:05:41.00,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:05:41.00,0:05:43.00,Default,,0,0,0,,Мен бесбұрышты көрдім.
Dialogue: 0,0:05:43.00,0:05:45.00,Default,,0,0,0,,Бұл шайтан болса ше?
Dialogue: 0,0:05:45.00,0:05:47.00,Default,,0,0,0,,Мен адаммын
Dialogue: 0,0:05:47.00,0:05:49.00,Default,,0,0,0,,Біраз қарғыс алғаным рас.
Dialogue: 0,0:05:49.00,0:05:51.00,Default,,0,0,0,,Ол жақсы адам.
Dialogue: 0,0:05:51.00,0:05:53.00,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:05:57.00,0:06:01.00,Default,,0,0,0,,Ішіне қарап білуге ​​болады.
Dialogue: 0,0:06:05.00,0:06:07.00,Default,,0,0,0,,Осы шексіздікте
Dialogue: 0,0:06:07.00,0:06:09.00,Default,,0,0,0,,Мен сені кесіп тастаймын
Dialogue: 0,0:06:09.00,0:06:11.00,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:06:11.00,0:06:12.00,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:06:12.00,0:06:14.00,Default,,0,0,0,,Мен сенің жауың емеспін.
Dialogue: 0,0:06:14.00,0:06:17.00,Default,,0,0,0,,Мастер Кросс сізге таныстыру хатын жіберуі керек еді.
Dialogue: 0,0:06:22.00,0:06:25.00,Default,,0,0,0,,Генсуидің кіріспе хаты
Dialogue: 0,0:06:25.00,0:06:27.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:27.00,0:06:29.00,Default,,0,0,0,,Бидай адамдарға арналған
Dialogue: 0,0:06:32.00,0:06:34.00,Default,,0,0,0,,Сіз сонда
Dialogue: 0,0:06:34.00,0:06:36.00,Default,,0,0,0,,Менің үстелімді тексеріңіз
Dialogue: 0,0:06:36.00,0:06:38.00,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:06:38.00,0:06:40.00,Default,,0,0,0,,Комуги-ниисан
Dialogue: 0,0:06:43.00,0:06:45.00,Default,,0,0,0,,Мен де саған көмектесемін.
Dialogue: 0,0:06:47.00,0:06:49.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:49.00,0:06:51.00,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:06:51.00,0:06:53.00,Default,,0,0,0,,Мен де емес.
Dialogue: 0,0:06:53.00,0:06:55.00,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:06:55.00,0:06:57.00,Default,,0,0,0,,Кросс Генсуидің кіріспе хаты
Dialogue: 0,0:06:57.00,0:06:59.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:59.00,0:07:01.00,Default,,0,0,0,,Бидайға
Dialogue: 0,0:07:01.00,0:07:03.00,Default,,0,0,0,,Жақында Аллен есімді бала келеді.
Dialogue: 0,0:07:03.00,0:07:05.00,Default,,0,0,0,,Мен оны сізге жіберемін, өтінемін.
Dialogue: 0,0:07:05.00,0:07:07.00,Default,,0,0,0,,Крест
Dialogue: 0,0:07:07.00,0:07:09.00,Default,,0,0,0,,Бұл сізге де, маған да тиімді мәміле, иә?
Dialogue: 0,0:07:09.00,0:07:10.00,Default,,0,0,0,,Ревер тобының жетекшісі
Dialogue: 0,0:07:10.00,0:07:12.00,Default,,0,0,0,,Канда-кун, тоқтат.
Dialogue: 0,0:07:12.00,0:07:14.00,Default,,0,0,0,,Басқа кофе алуға тырысу
Dialogue: 0,0:07:14.00,0:07:16.00,Default,,0,0,0,,Үстеліңізді анда-санда ретке келтіріңіз.
Dialogue: 0,0:07:16.00,0:07:18.00,Default,,0,0,0,,Жүр, шабуылды доғар.
Dialogue: 0,0:07:18.00,0:07:21.00,Default,,0,0,0,,Тоқта десем де, білемін.
Dialogue: 0,0:07:24.00,0:07:26.00,Default,,0,0,0,,Ленале
Dialogue: 0,0:07:26.00,0:07:28.00,Default,,0,0,0,,Ол аға
Dialogue: 0,0:07:28.00,0:07:30.00,Default,,0,0,0,,Маған дайындалуға көмектесіңізші.
Dialogue: 0,0:07:30.00,0:07:32.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Менің топқа кіргеніме көп уақыт болды.
Dialogue: 0,0:07:34.00,0:07:36.00,Default,,0,0,0,,Немесе ашық қақпа
Dialogue: 0,0:07:40.00,0:07:42.00,Default,,0,0,0,,Крест жіберген бала?
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,Бағалау Мәйіт бар сияқты.
Dialogue: 0,0:07:44.00,0:07:46.00,Default,,0,0,0,,Грантқа қабылдау
Dialogue: 0,0:07:46.00,0:07:48.00,Default,,0,0,0,,Аллен Уокер мырза
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Бидай?
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:07:52.00,0:07:54.00,Default,,0,0,0,,Кешіріңіз, ерте және кеш.
Dialogue: 0,0:07:54.00,0:07:56.00,Default,,0,0,0,,Бала Крест Генсуидің шәкірті болды.
Dialogue: 0,0:07:56.00,0:07:58.00,Default,,0,0,0,,Тим Гампи қоса беріледі.
Dialogue: 0,0:07:58.00,0:08:00.00,Default,,0,0,0,,Бұл ең жақсы дәлел.
Dialogue: 0,0:08:00.00,0:08:02.00,Default,,0,0,0,,Сондықтан мен айттым
Dialogue: 0,0:08:02.00,0:08:04.00,Default,,0,0,0,,Эй, кешірім сұра.
Dialogue: 0,0:08:04.00,0:08:06.00,Default,,0,0,0,,Ревер тобының жетекшісі
Dialogue: 0,0:08:06.00,0:08:08.00,Default,,0,0,0,,Менің кінәм бар ма?
Dialogue: 0,0:08:08.00,0:08:10.00,Default,,0,0,0,,Ол біздің біріміз.
Dialogue: 0,0:08:10.00,0:08:12.00,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:08:16.00,0:08:18.00,Default,,0,0,0,,Сіз маған қазір тоқтаңыз деп жатырсыз.
Dialogue: 0,0:08:18.00,0:08:20.00,Default,,0,0,0,,Мен тезірек кіруім керек.
Dialogue: 0,0:08:20.00,0:08:22.00,Default,,0,0,0,,Оны жабыңыз.
Dialogue: 0,0:08:22.00,0:08:24.00,Default,,0,0,0,,Кірістіру
Dialogue: 0,0:08:28.00,0:08:30.00,Default,,0,0,0,,Мен Леналимін, бас қыз.
Dialogue: 0,0:08:30.00,0:08:32.00,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:08:32.00,0:08:34.00,Default,,0,0,0,,Ах, Кандер.
Dialogue: 0,0:08:38.00,0:08:40.00,Default,,0,0,0,,аты болды, солай ма?
Dialogue: 0,0:08:40.00,0:08:42.00,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:08:44.00,0:08:46.00,Default,,0,0,0,,Қарғыс алған адам
Dialogue: 0,0:08:46.00,0:08:48.00,Default,,0,0,0,,Қол алысайық па?
Dialogue: 0,0:08:48.00,0:08:50.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:50.00,0:08:52.00,Default,,0,0,0,,Миссиядан жаңа ғана оралдым
Dialogue: 0,0:08:52.00,0:08:54.00,Default,,0,0,0,,Көңілдісіз бе?
Dialogue: 0,0:08:58.00,0:09:00.00,Default,,0,0,0,,Сіз жаңасыз ба?
Dialogue: 0,0:09:00.00,0:09:02.00,Default,,0,0,0,,Не, сен бала емессің бе?
Dialogue: 0,0:09:02.00,0:09:04.00,Default,,0,0,0,,Мұны істейік
Dialogue: 0,0:09:04.00,0:09:06.00,Default,,0,0,0,,Бұл шашта не бар, таза ақ па?
Dialogue: 0,0:09:06.00,0:09:08.00,Default,,0,0,0,,Қарғыс алған сияқты
Dialogue: 0,0:09:08.00,0:09:10.00,Default,,0,0,0,,Жақсысың ба, балақай?
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Кінәсіздікке.
Dialogue: 0,0:09:12.00,0:09:14.00,Default,,0,0,0,,Жасы маңызды емес.
Dialogue: 0,0:09:14.00,0:09:16.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:16.00,0:09:18.00,Default,,0,0,0,,Қара табыну
Dialogue: 0,0:09:22.00,0:09:24.00,Default,,0,0,0,,Бұл асхана
Dialogue: 0,0:09:24.00,0:09:26.00,Default,,0,0,0,,Бұл қабат оқу орталығы
Dialogue: 0,0:09:26.00,0:09:28.00,Default,,0,0,0,,3 деңгей бар
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0,0,0,,О, жалпы бөлме.
Dialogue: 0,0:09:32.00,0:09:34.00,Default,,0,0,0,,Сонымен қатар, санаторийлер мен
Dialogue: 0,0:09:34.00,0:09:36.00,Default,,0,0,0,,Сондай-ақ кітапхана мен қызметкерлер бөлмесі бар.
Dialogue: 0,0:09:36.00,0:09:38.00,Default,,0,0,0,,Мен саған кейінірек көрсетемін.
Dialogue: 0,0:09:38.00,0:09:40.00,Default,,0,0,0,,Барлық жын шығарушылар
Dialogue: 0,0:09:40.00,0:09:42.00,Default,,0,0,0,,Мен өз миссияма осы жерден бара жатырмын.
Dialogue: 0,0:09:42.00,0:09:44.00,Default,,0,0,0,,Сонымен, штаб туралы
Dialogue: 0,0:09:44.00,0:09:46.00,Default,,0,0,0,,Кейбір адамдар оны үй деп атайды.
Dialogue: 0,0:09:46.00,0:09:48.00,Default,,0,0,0,,Үй, үй?
Dialogue: 0,0:09:48.00,0:09:50.00,Default,,0,0,0,,Жаңа ғана қалды
Dialogue: 0,0:09:50.00,0:09:52.00,Default,,0,0,0,,Кейбір адамдар әдейі қайтпайды.
Dialogue: 0,0:09:54.00,0:09:56.00,Default,,0,0,0,,Мастер
Dialogue: 0,0:09:56.00,0:09:58.00,Default,,0,0,0,,Cross Gensui туралы не деуге болады?
Dialogue: 0,0:09:58.00,0:10:00.00,Default,,0,0,0,,Балалар, сендер Үндістанда болдыңдар, солай ма?
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0,0,0,,Бұл 3 ай бұрын болды
Dialogue: 0,0:10:04.00,0:10:06.00,Default,,0,0,0,,Аллен
Dialogue: 0,0:10:06.00,0:10:08.00,Default,,0,0,0,,Иә, ұстаз.
Dialogue: 0,0:10:08.00,0:10:10.00,Default,,0,0,0,,Сіз менің көмекшім боласыз
Dialogue: 0,0:10:10.00,0:10:12.00,Default,,0,0,0,,Үш жыл болды
Dialogue: 0,0:10:12.00,0:10:14.00,Default,,0,0,0,,Сізге де уақыт келді
Dialogue: 0,0:10:14.00,0:10:16.00,Default,,0,0,0,,Сіздің толыққанды тұлға болатын кез келді.
Dialogue: 0,0:10:18.00,0:10:20.00,Default,,0,0,0,,Бүгіннен бастап ресми түрде
Dialogue: 0,0:10:20.00,0:10:22.00,Default,,0,0,0,,Өзіңізді эксорцист деп атауға рұқсат етіңіз
Dialogue: 0,0:10:22.00,0:10:24.00,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:10:24.00,0:10:26.00,Default,,0,0,0,,Бірақ бұл үшін
Dialogue: 0,0:10:26.00,0:10:28.00,Default,,0,0,0,,Сәлемдесу үшін менімен бірге штабқа бару керек.
Dialogue: 0,0:10:30.00,0:10:32.00,Default,,0,0,0,,Сіз штабтың қайда екенін білесіз.
Dialogue: 0,0:10:34.00,0:10:36.00,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:10:36.00,0:10:38.00,Default,,0,0,0,,Мақсатымның орнына қоямын.
Dialogue: 0,0:10:40.00,0:10:42.00,Default,,0,0,0,,Мен басшыға таныстыру хатын жіберемін.
Dialogue: 0,0:10:44.00,0:10:46.00,Default,,0,0,0,,Оянғанда, кет.
Dialogue: 0,0:10:46.00,0:10:48.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:48.00,0:10:50.00,Default,,0,0,0,,Сіз жарылуды жоспарлап отырсыз ба, шебер?
Dialogue: 0,0:10:50.00,0:10:52.00,Default,,0,0,0,,Мен ол жерді жек көремін.
Dialogue: 0,0:10:56.00,0:10:58.00,Default,,0,0,0,,Шәкіртті қағып, есінен танып, қашып кеттің бе?
Dialogue: 0,0:11:02.00,0:11:04.00,Default,,0,0,0,,Бұл қабат?
Dialogue: 0,0:11:04.00,0:11:06.00,Default,,0,0,0,,Бұл менің ағамның орны.
Dialogue: 0,0:11:06.00,0:11:08.00,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:11:08.00,0:11:10.00,Default,,0,0,0,,Мен Томонага Секиден келген Ли Коморимін.
Dialogue: 0,0:11:10.00,0:11:12.00,Default,,0,0,0,,Қош келдіңіз, Аллен мырза.
Dialogue: 0,0:11:12.00,0:11:14.00,Default,,0,0,0,,Дәл қазір қиын болды.
Dialogue: 0,0:11:14.00,0:11:16.00,Default,,0,0,0,,Кім ретінде?
Dialogue: 0,0:11:18.00,0:11:20.00,Default,,0,0,0,,Ал, сен маған қолыңды көрсете аласың ба?
Dialogue: 0,0:11:22.00,0:11:24.00,Default,,0,0,0,,Бұрын Кана-кун маған шабуыл жасағанда
Dialogue: 0,0:11:24.00,0:11:26.00,Default,,0,0,0,,Сіз қаруды зақымдадыңыз ба?
Dialogue: 0,0:11:28.00,0:11:30.00,Default,,0,0,0,,Өзіңізді ұстаудың қажеті жоқ
Dialogue: 0,0:11:32.00,0:11:34.00,Default,,0,0,0,,Нервтеріңіз бұзылып жатыр.
Dialogue: 0,0:11:34.00,0:11:36.00,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:11:36.00,0:11:38.00,Default,,0,0,0,,Маған сиқырлы бас сүйекті әкеліңіз
Dialogue: 0,0:11:38.00,0:11:40.00,Default,,0,0,0,,Иә
Dialogue: 0,0:11:40.00,0:11:42.00,Default,,0,0,0,,Оны іске қосуға болады ма?
Dialogue: 0,0:11:42.00,0:11:44.00,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:11:50.00,0:11:52.00,Default,,0,0,0,,Сіз реттеуші түрісіз.
Dialogue: 0,0:11:52.00,0:11:54.00,Default,,0,0,0,,Регламент түрі?
Dialogue: 0,0:11:54.00,0:11:56.00,Default,,0,0,0,,Иә, адам денесін қаруландыратын конформист.
Dialogue: 0,0:11:58.00,0:12:00.00,Default,,0,0,0,,Ібіліске қарсы көптеген қарулардың ішінде
Dialogue: 0,0:12:00.00,0:12:02.00,Default,,0,0,0,,Бұл ең сирек кездесетін түрі.
Dialogue: 0,0:12:02.00,0:12:04.00,Default,,0,0,0,,Бұл қандай жабдық?
Dialogue: 0,0:12:04.00,0:12:06.00,Default,,0,0,0,,Жөндеу
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Өйткені бұл аздап таң қалдырады.
Dialogue: 0,0:12:08.00,0:12:10.00,Default,,0,0,0,,Егер сіз жарақат алғыңыз келмесе
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0,0,0,,Оны көрмеген дұрыс.
Dialogue: 0,0:12:12.00,0:12:14.00,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:12:14.00,0:12:16.00,Default,,0,0,0,,Әрекет
Dialogue: 0,0:12:18.00,0:12:20.00,Default,,0,0,0,,Бұл басталды
Dialogue: 0,0:12:20.00,0:12:22.00,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:12:22.00,0:12:24.00,Default,,0,0,0,,Кешіріңіз, бірақ сіздің емдеуіңіз өрескел болды.
Dialogue: 0,0:12:26.00,0:12:28.00,Default,,0,0,0,,Комори мырза сіздің үлкен ағаңыз болды ма?
Dialogue: 0,0:12:28.00,0:12:30.00,Default,,0,0,0,,Осыдан кейін сіз сонда барасыз, солай ма?
Dialogue: 0,0:12:30.00,0:12:32.00,Default,,0,0,0,,Аллен-кун, сен адамсың ба?
Dialogue: 0,0:12:32.00,0:12:34.00,Default,,0,0,0,,Маған растау керек пе?
Dialogue: 0,0:12:34.00,0:12:36.00,Default,,0,0,0,,Ақырында
Dialogue: 0,0:12:36.00,0:12:38.00,Default,,0,0,0,,Өйткені біз адамбыз
Dialogue: 0,0:12:38.00,0:12:40.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:42.00,0:12:44.00,Default,,0,0,0,,Бұл дүниеде
Dialogue: 0,0:12:44.00,0:12:46.00,Default,,0,0,0,,Қандай нәсілдер қарғысқа ұшырайды?
Dialogue: 0,0:12:46.00,0:12:48.00,Default,,0,0,0,,Өйткені тек адамдар
Dialogue: 0,0:12:48.00,0:12:50.00,Default,,0,0,0,,Сиқырлы бас сүйегінің кесірінен ертеңге дейін жұмыс істемейді.
Dialogue: 0,0:12:50.00,0:12:52.00,Default,,0,0,0,,Ол дұрыс емделді.
Dialogue: 0,0:12:52.00,0:12:54.00,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:12:54.00,0:12:56.00,Default,,0,0,0,,Дегенмен жанама әсерлері бар.
Dialogue: 0,0:12:56.00,0:12:58.00,Default,,0,0,0,,Шектеулі түрі өте сирек кездеседі.
Dialogue: 0,0:12:58.00,0:13:00.00,Default,,0,0,0,,Кінәсіздіктің күші
Dialogue: 0,0:13:00.00,0:13:02.00,Default,,0,0,0,,Мен ең көп көрсете алатын таңдалған адаммын.
Dialogue: 0,0:13:02.00,0:13:04.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:04.00,0:13:06.00,Default,,0,0,0,,Кінәсіздік?
Dialogue: 0,0:13:12.00,0:13:14.00,Default,,0,0,0,,Бұл Құдайдың кінәсіздігі
Dialogue: 0,0:13:14.00,0:13:16.00,Default,,0,0,0,,Құдайдың кінәсіздігі
Dialogue: 0,0:13:16.00,0:13:18.00,Default,,0,0,0,,Құдайдың кінәсіздігі
Dialogue: 0,0:13:18.00,0:13:20.00,Default,,0,0,0,,Құдайдың кінәсіздігі
Dialogue: 0,0:13:20.00,0:13:22.00,Default,,0,0,0,,Құдайдың кінәсіздігі
Dialogue: 0,0:13:22.00,0:13:24.00,Default,,0,0,0,,Құдайдың кінәсіздігі
Dialogue: 0,0:13:24.00,0:13:26.00,Default,,0,0,0,,Құдіретті күш
Dialogue: 0,0:13:26.00,0:13:28.00,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:13:28.00,0:13:30.00,Default,,0,0,0,,Бізде Құдай бар
Dialogue: 0,0:13:30.00,0:13:32.00,Default,,0,0,0,,Біздің бастық
Dialogue: 0,0:13:32.00,0:13:34.00,Default,,0,0,0,,Үлкен су тапшылығынан зардап шегетін адамдар.
Dialogue: 0,0:13:36.00,0:13:38.00,Default,,0,0,0,,Енді өзіңізді бағалаңыз.
Dialogue: 0,0:13:38.00,0:13:40.00,Default,,0,0,0,,Мен оны сол адамдарға көрсетемін.
Dialogue: 0,0:13:40.00,0:13:42.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:52.00,0:13:54.00,Default,,0,0,0,,Кінәсіздік
Dialogue: 0,0:13:58.00,0:14:00.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:02.00,0:14:04.00,Default,,0,0,0,,Ақылға қонымсыз
Dialogue: 0,0:14:04.00,0:14:06.00,Default,,0,0,0,,Бұл сиқырлы бас сүйек және ертеңге дейін қозғалмайды.
Dialogue: 0,0:14:06.00,0:14:08.00,Default,,0,0,0,,Мен айттым ғой, солай ма?
Dialogue: 0,0:14:08.00,0:14:10.00,Default,,0,0,0,,Комуй-сан!
Dialogue: 0,0:14:10.00,0:14:12.00,Default,,0,0,0,,Сіз не айтасыз, Хебраскар?
Dialogue: 0,0:14:12.00,0:14:14.00,Default,,0,0,0,,Бұл Құдайдың адамы сізге ұнай ма?
Dialogue: 0,0:14:16.00,0:14:18.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:18.00,0:14:20.00,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:14:20.00,0:14:22.00,Default,,0,0,0,,Денеңіздің ішінде бірдеңе іздеп жатқанын сезіну
Dialogue: 0,0:14:24.00,0:14:26.00,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:14:26.00,0:14:28.00,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:14:28.00,0:14:30.00,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:14:32.00,0:14:34.00,Default,,0,0,0,,Жүйкелерім шал болып тұрса да
Dialogue: 0,0:14:34.00,0:14:36.00,Default,,0,0,0,,Іске қосуды мәжбүрлемеңіз.
Dialogue: 0,0:14:36.00,0:14:38.00,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,Мен сенің жауың емеспін
Dialogue: 0,0:14:50.00,0:14:52.00,Default,,0,0,0,,2%
Dialogue: 0,0:14:52.00,0:14:54.00,Default,,0,0,0,,16%
Dialogue: 0,0:14:54.00,0:14:56.00,Default,,0,0,0,,30%
Dialogue: 0,0:14:56.00,0:14:58.00,Default,,0,0,0,,53%
Dialogue: 0,0:14:58.00,0:15:00.00,Default,,0,0,0,,83%
Dialogue: 0,0:15:00.00,0:15:02.00,Default,,0,0,0,,Шамасы 83%
Dialogue: 0,0:15:02.00,0:15:04.00,Default,,0,0,0,,Сіз бен қару арасындағы синхрондау жылдамдығы қазір ең жоғары мәнге жеткен сияқты.
Dialogue: 0,0:15:04.00,0:15:06.00,Default,,0,0,0,,Синхрондау жылдамдығы?
Dialogue: 0,0:15:06.00,0:15:08.00,Default,,0,0,0,,Жындарға қарсы қаруды белсендіру
Dialogue: 0,0:15:08.00,0:15:10.00,Default,,0,0,0,,2%
Dialogue: 0,0:15:10.00,0:15:12.00,Default,,0,0,0,,16%
Dialogue: 0,0:15:12.00,0:15:14.00,Default,,0,0,0,,30%
Dialogue: 0,0:15:14.00,0:15:16.00,Default,,0,0,0,,53%
Dialogue: 0,0:15:16.00,0:15:18.00,Default,,0,0,0,,83%
Dialogue: 0,0:15:18.00,0:15:22.00,Default,,0,0,0,,Бұл сан жын-шайтанға қарсы қаруды белсендіруге арналған өмірлік желі болып табылады.
Dialogue: 0,0:15:22.00,0:15:24.00,Default,,0,0,0,,Синхрондау жылдамдығы неғұрлым төмен болса
Dialogue: 0,0:15:24.00,0:15:26.00,Default,,0,0,0,,Оны іске қосу қиын болады
Dialogue: 0,0:15:26.00,0:15:28.00,Default,,0,0,0,,Конформистер де қауіпті болады
Dialogue: 0,0:15:30.00,0:15:32.00,Default,,0,0,0,,Мен сені қорқытпақ болған жоқпын.
Dialogue: 0,0:15:32.00,0:15:34.00,Default,,0,0,0,,Мен жай ғана
Dialogue: 0,0:15:34.00,0:15:36.00,Default,,0,0,0,,Өзіңіздің кінәсіздігіңізді түртіңіз
Dialogue: 0,0:15:36.00,0:15:38.00,Default,,0,0,0,,Тек білуге тырысамын
Dialogue: 0,0:15:38.00,0:15:40.00,Default,,0,0,0,,Менің кінәсіз екенімді білесің бе?
Dialogue: 0,0:15:42.00,0:15:44.00,Default,,0,0,0,,Аллен Уокер
Dialogue: 0,0:15:44.00,0:15:46.00,Default,,0,0,0,,Сіздің кінәсіздігіңіз
Dialogue: 0,0:15:46.00,0:15:48.00,Default,,0,0,0,,Кінәсіздік қашан болады?
Dialogue: 0,0:15:48.00,0:15:50.00,Default,,0,0,0,,Қара болашақта
Dialogue: 0,0:15:50.00,0:15:52.00,Default,,0,0,0,,Уақыттың ұлы жойғышын туады
Dialogue: 0,0:15:52.00,0:15:54.00,Default,,0,0,0,,Уақытты бұзушы
Dialogue: 0,0:15:58.00,0:16:00.00,Default,,0,0,0,,Мен шынымен түсінбеймін
Dialogue: 0,0:16:00.00,0:16:02.00,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:16:02.00,0:16:04.00,Default,,0,0,0,,Гебрасканың пайғамбарлықтары жиі орындалады.
Dialogue: 0,0:16:04.00,0:16:06.00,Default,,0,0,0,,Аллен, сенен көп нәрсе күтуге болады деп ойлаймын.
Dialogue: 0,0:16:08.00,0:16:10.00,Default,,0,0,0,,Мен сені бір рет жұдырықтай аламын ба?
Dialogue: 0,0:16:10.00,0:16:12.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:12.00,0:16:14.00,Default,,0,0,0,,Ереже - топқа кіргендердің кінәсіздігі сыналады.
Dialogue: 0,0:16:14.00,0:16:16.00,Default,,0,0,0,,Алдымен соны айтыңызшы.
Dialogue: 0,0:16:18.00,0:16:20.00,Default,,0,0,0,,Кінәсіздік деген нені білдіреді?
Dialogue: 0,0:16:22.00,0:16:24.00,Default,,0,0,0,,Мен оны дұрыс түсіндіремін.
Dialogue: 0,0:16:26.00,0:16:28.00,Default,,0,0,0,,Бұл ертегіні кім біледі?
Dialogue: 0,0:16:28.00,0:16:30.00,Default,,0,0,0,,Қара орден және оның филиалдары
Dialogue: 0,0:16:30.00,0:16:32.00,Default,,0,0,0,,Және тек Мыңжылдық Ақ Тас
Dialogue: 0,0:16:32.00,0:16:34.00,Default,,0,0,0,,Барлығы шамамен жүз жыл бұрын
Dialogue: 0,0:16:36.00,0:16:38.00,Default,,0,0,0,,Текшенің ашылуынан басталды
Dialogue: 0,0:16:44.00,0:16:46.00,Default,,0,0,0,,Ұрпаққа
Dialogue: 0,0:16:46.00,0:16:48.00,Default,,0,0,0,,Қараңғылықты жеңдік.
Dialogue: 0,0:16:48.00,0:16:50.00,Default,,0,0,0,,Және олар жойылуда.
Dialogue: 0,0:16:52.00,0:16:54.00,Default,,0,0,0,,Болашақта болатын апаттан
Dialogue: 0,0:16:54.00,0:16:56.00,Default,,0,0,0,,Жеңілдік беру
Dialogue: 0,0:16:56.00,0:16:58.00,Default,,0,0,0,,Хабарды қазір қалдырыңыз
Dialogue: 0,0:17:00.00,0:17:02.00,Default,,0,0,0,,Онда не болды
Dialogue: 0,0:17:02.00,0:17:04.00,Default,,0,0,0,,Ежелгі өркениеттің пайғамбарлығы және
Dialogue: 0,0:17:04.00,0:17:06.00,Default,,0,0,0,,Заттың қолданылу тәсілі
Dialogue: 0,0:17:06.00,0:17:08.00,Default,,0,0,0,,Бір нәрсені болжау
Dialogue: 0,0:17:08.00,0:17:10.00,Default,,0,0,0,,Табылды
Dialogue: 0,0:17:10.00,0:17:12.00,Default,,0,0,0,,Белгілі бір зат болып табылады
Dialogue: 0,0:17:12.00,0:17:14.00,Default,,0,0,0,,Құдайдың кристалы деп аталады.
Dialogue: 0,0:17:14.00,0:17:16.00,Default,,0,0,0,,Тылсым күштерге толы зат.
Dialogue: 0,0:17:16.00,0:17:18.00,Default,,0,0,0,,Кубтың өзі де солай болды.
Dialogue: 0,0:17:20.00,0:17:22.00,Default,,0,0,0,,Біз оны кінәсіздік деп атаймыз.
Dialogue: 0,0:17:24.00,0:17:26.00,Default,,0,0,0,,Мен сіздің сол қолыңызға салынған қаруды айтып отырмын.
Dialogue: 0,0:17:28.00,0:17:30.00,Default,,0,0,0,,Шайтанға қарсы қару дегеніміз не?
Dialogue: 0,0:17:30.00,0:17:32.00,Default,,0,0,0,,Кінәсіздік қаруға айналады.
Dialogue: 0,0:17:34.00,0:17:36.00,Default,,0,0,0,,Текшені кім жасады?
Dialogue: 0,0:17:36.00,0:17:38.00,Default,,0,0,0,,Біртіндеп
Dialogue: 0,0:17:38.00,0:17:40.00,Default,,0,0,0,,Текшені кім жасады?
Dialogue: 0,0:17:40.00,0:17:42.00,Default,,0,0,0,,Осы кінәсіздікпен
Dialogue: 0,0:17:42.00,0:17:44.00,Default,,0,0,0,,Мыңжылдық ақ таспен шайқасты
Dialogue: 0,0:17:44.00,0:17:46.00,Default,,0,0,0,,Ширайши!?
Dialogue: 0,0:17:52.00,0:17:54.00,Default,,0,0,0,,Мыңжылдық Ширайшиді жеңе алдым
Dialogue: 0,0:17:54.00,0:17:56.00,Default,,0,0,0,,Бірақ соңында
Dialogue: 0,0:17:56.00,0:17:58.00,Default,,0,0,0,,Дүние бір рет жойылды
Dialogue: 0,0:18:00.00,0:18:02.00,Default,,0,0,0,,Ескі өсиетте жазылған
Dialogue: 0,0:18:02.00,0:18:04.00,Default,,0,0,0,,Бұл Нұхтың хош иісі.
Dialogue: 0,0:18:04.00,0:18:06.00,Default,,0,0,0,,Текшедегі үш күн қараңғылық
Dialogue: 0,0:18:06.00,0:18:08.00,Default,,0,0,0,,ретінде жазылғанымен
Dialogue: 0,0:18:10.00,0:18:12.00,Default,,0,0,0,,Бірақ текшенің болжамы бойынша
Dialogue: 0,0:18:12.00,0:18:14.00,Default,,0,0,0,,Дүниенің ақыры қайтадан бітетін сияқты.
Dialogue: 0,0:18:14.00,0:18:16.00,Default,,0,0,0,,Мыңжылдық Ширайши
Dialogue: 0,0:18:20.00,0:18:22.00,Default,,0,0,0,,Болжағандай Ширайши бұл дүниеге қайта оралды.
Dialogue: 0,0:18:22.00,0:18:24.00,Default,,0,0,0,,Сол жерде Қара орденнің негізі қаланды.
Dialogue: 0,0:18:28.00,0:18:30.00,Default,,0,0,0,,Апостолдарды, яғни конформистерді жинау
Dialogue: 0,0:18:30.00,0:18:32.00,Default,,0,0,0,,Лайықты адам жоқ
Dialogue: 0,0:18:32.00,0:18:34.00,Default,,0,0,0,,Innocence іске қосылғанша күтіңіз
Dialogue: 0,0:18:36.00,0:18:38.00,Default,,0,0,0,,Кінәсіздік конформисті
Dialogue: 0,0:18:38.00,0:18:40.00,Default,,0,0,0,,Бұл жын шығарушы
Dialogue: 0,0:18:40.00,0:18:42.00,Default,,0,0,0,,Бірақ эксорцистке қарсы тұру үшін
Dialogue: 0,0:18:42.00,0:18:44.00,Default,,0,0,0,,Мыңжылдық Ақ тас шайтанды да жаратты
Dialogue: 0,0:18:48.00,0:18:50.00,Default,,0,0,0,,Ақ болса шайтан жазықсыз
Dialogue: 0,0:18:50.00,0:18:52.00,Default,,0,0,0,,Қараңғы зат, қара зат
Dialogue: 0,0:18:52.00,0:18:54.00,Default,,0,0,0,,Қараңғы заттан жасалған
Dialogue: 0,0:18:54.00,0:18:56.00,Default,,0,0,0,,Ширайши де кінәсіздікті іздейді
Dialogue: 0,0:18:56.00,0:18:58.00,Default,,0,0,0,,Жою үшін жұмыс
Dialogue: 0,0:19:00.00,0:19:02.00,Default,,0,0,0,,Нұхтың әтірімен
Dialogue: 0,0:19:02.00,0:19:04.00,Default,,0,0,0,,Дүниенің ақыры қайтадан аяқталды
Dialogue: 0,0:19:04.00,0:19:06.00,Default,,0,0,0,,Әлемге Нұхтың хош иісі
Dialogue: 0,0:19:06.00,0:19:08.00,Default,,0,0,0,,109 қайғылы кінәсіздік
Dialogue: 0,0:19:08.00,0:19:10.00,Default,,0,0,0,,Алдымен әр түрлі жерлерге барамыз
Dialogue: 0,0:19:10.00,0:19:12.00,Default,,0,0,0,,Ұйқыдағы кінәсіздік
Dialogue: 0,0:19:12.00,0:19:14.00,Default,,0,0,0,,Қалпына келтірілді
Dialogue: 0,0:19:14.00,0:19:16.00,Default,,0,0,0,,Ширайшиді жеңу үшін біз жеткілікті күш жинауымыз керек.
Dialogue: 0,0:19:18.00,0:19:20.00,Default,,0,0,0,,Ширайшиге дейін
Dialogue: 0,0:19:22.00,0:19:24.00,Default,,0,0,0,,Біз осы қасиетті соғыста жеңілген кезде
Dialogue: 0,0:19:24.00,0:19:26.00,Default,,0,0,0,,Қиямет күні туралы пайғамбарлықтар орындалады
Dialogue: 0,0:19:28.00,0:19:30.00,Default,,0,0,0,,Бұл дүние жойылады
Dialogue: 0,0:19:30.00,0:19:32.00,Default,,0,0,0,,Өтінемін, осы жерде қалыңыз.
Dialogue: 0,0:19:32.00,0:19:34.00,Default,,0,0,0,,Оны Innocence таңдады.
Dialogue: 0,0:19:34.00,0:19:36.00,Default,,0,0,0,,Сіздің
Dialogue: 0,0:19:36.00,0:19:38.00,Default,,0,0,0,,Тағдыр
Dialogue: 0,0:19:38.00,0:19:40.00,Default,,0,0,0,,Бұл тағдыр
Dialogue: 0,0:19:42.00,0:19:44.00,Default,,0,0,0,,Дүние үшін қолымыздан келгеннің бәрін бірге жасайық
Dialogue: 0,0:19:44.00,0:19:46.00,Default,,0,0,0,,Бұл тіпті шайқас емес.
Dialogue: 0,0:19:46.00,0:19:48.00,Default,,0,0,0,,Иә
Dialogue: 0,0:19:52.00,0:19:54.00,Default,,0,0,0,,Қара қауымға қош келдіңіз
Dialogue: 0,0:19:54.00,0:19:56.00,Default,,0,0,0,,Жын шығарудың көпшілігі
Dialogue: 0,0:19:56.00,0:19:58.00,Default,,0,0,0,,Олар дүние жүзіне миссиялар бойынша шашыраңқы болғанымен,
Dialogue: 0,0:19:58.00,0:20:00.00,Default,,0,0,0,,Жақында кездесеміз
Dialogue: 0,0:20:00.00,0:20:02.00,Default,,0,0,0,,Айтпақшы, Хебраска да эксзорцисттердің бірі.
Dialogue: 0,0:20:06.00,0:20:08.00,Default,,0,0,0,,Мен текше слесарь ретінде
Dialogue: 0,0:20:08.00,0:20:10.00,Default,,0,0,0,,Шіркеу құрылған күннен бастап
Dialogue: 0,0:20:10.00,0:20:12.00,Default,,0,0,0,,Кінәсіздікті сақтаушы
Dialogue: 0,0:20:12.00,0:20:14.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:20:14.00,0:20:16.00,Default,,0,0,0,,Алланың жиһаздары бар болсын
Dialogue: 0,0:20:22.00,0:20:24.00,Default,,0,0,0,,Тим Кэмпи
Dialogue: 0,0:20:24.00,0:20:26.00,Default,,0,0,0,,Қызық, қайда бардың?
Dialogue: 0,0:20:26.00,0:20:28.00,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:20:28.00,0:20:30.00,Default,,0,0,0,,Жаяу жүре беріңіз
Dialogue: 0,0:20:32.00,0:20:34.00,Default,,0,0,0,,Біз осында келдік
Dialogue: 0,0:20:34.00,0:20:36.00,Default,,0,0,0,,О.
Dialogue: 0,0:20:36.00,0:20:38.00,Default,,0,0,0,,Соңында бастапқы жолда
Dialogue: 0,0:20:38.00,0:20:40.00,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:20:40.00,0:20:42.00,Default,,0,0,0,,Қандай жағдай болса да тоқтама
Dialogue: 0,0:20:42.00,0:20:44.00,Default,,0,0,0,,О.
Dialogue: 0,0:20:44.00,0:20:46.00,Default,,0,0,0,,О.
Dialogue: 0,0:20:46.00,0:20:48.00,Default,,0,0,0,,О.
Dialogue: 0,0:20:48.00,0:20:50.00,Default,,0,0,0,,О.
Dialogue: 0,0:20:50.00,0:20:52.00,Default,,0,0,0,,О.
Dialogue: 0,0:20:52.00,0:20:54.00,Default,,0,0,0,,О.
Dialogue: 0,0:20:54.00,0:20:56.00,Default,,0,0,0,,Қандай жағдай болса да тоқтама
Dialogue: 0,0:20:56.00,0:20:58.00,Default,,0,0,0,,Өмірінің соңына дейін
Dialogue: 0,0:20:58.00,0:21:00.00,Default,,0,0,0,,Жаяу жүріңіз
Dialogue: 0,0:21:24.00,0:21:26.00,Default,,0,0,0,,Денемде болмасам да, әлі де заттарды ұстай аламын ғой, ә?
Dialogue: 0,0:21:26.00,0:21:28.00,Default,,0,0,0,,Ерніңді тістеу
Dialogue: 0,0:21:30.00,0:21:32.00,Default,,0,0,0,,Екі адам
Dialogue: 0,0:21:32.00,0:21:34.00,Default,,0,0,0,,...
Dialogue: 0,0:21:34.00,0:21:36.00,Default,,0,0,0,,Бірге жиналайық
Dialogue: 0,0:21:36.00,0:21:38.00,Default,,0,0,0,,Соңында
Dialogue: 0,0:21:38.00,0:21:40.00,Default,,0,0,0,,Мен сені көрген күнім
Dialogue: 0,0:21:42.00,0:21:44.00,Default,,0,0,0,,есте сақтау
Dialogue: 0,0:21:44.00,0:21:46.00,Default,,0,0,0,,Онда
Dialogue: 0,0:21:46.00,0:21:48.00,Default,,0,0,0,,жасырын
Dialogue: 0,0:21:48.00,0:21:50.00,Default,,0,0,0,,көл
Dialogue: 0,0:21:50.00,0:21:52.00,Default,,0,0,0,,Көлде
Dialogue: 0,0:21:56.00,0:21:58.00,Default,,0,0,0,,Жаяу жүру
Dialogue: 0,0:21:58.00,0:22:00.00,Default,,0,0,0,,О.
Dialogue: 0,0:22:00.00,0:22:02.00,Default,,0,0,0,,Бір Чан Форфус
Dialogue: 0,0:22:02.00,0:22:04.00,Default,,0,0,0,,Kiss бастау
Dialogue: 0,0:22:04.00,0:22:06.00,Default,,0,0,0,,Эрвин, бұның бәрі сенің операцияңның нәтижесі ме?
Dialogue: 0,0:22:06.00,0:22:08.00,Default,,0,0,0,,Сізбен бірге
Dialogue: 0,0:22:08.00,0:22:10.00,Default,,0,0,0,,Қош бол
Dialogue: 0,0:22:10.00,0:22:12.00,Default,,0,0,0,,Айтпа
Dialogue: 0,0:22:14.00,0:22:16.00,Default,,0,0,0,,Махаббат
Dialogue: 0,0:22:16.00,0:22:18.00,Default,,0,0,0,,Дене
Dialogue: 0,0:22:18.00,0:22:20.00,Default,,0,0,0,,Бір рет қабылдауға болмайды
Dialogue: 0,0:22:20.00,0:22:22.00,Default,,0,0,0,,Жара осындай
Dialogue: 0,0:22:22.00,0:22:24.00,Default,,0,0,0,,Өшірмеңіз
Dialogue: 0,0:22:26.00,0:22:28.00,Default,,0,0,0,,Өшірмеңіз
Dialogue: 0,0:22:48.00,0:22:50.00,Default,,0,0,0,,Бейшара шайтанға
Dialogue: 0,0:22:50.00,0:22:52.00,Default,,0,0,0,,Жанның құтқарылуы
