Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.36,0:00:33.49,Default,,0,0,0,,Жарайды, жарты жолға дейін 10 төбе сызығы!
Dialogue: 0,0:00:33.61,0:00:34.57,Default,,0,0,0,,Бір уақытта екі адам!
Dialogue: 0,0:00:35.20,0:00:36.41,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:38.83,0:00:40.12,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:41.62,0:00:43.83,Default,,0,0,0,,Цукишима Бар күш-қуатыңызбен жүгіріңіз!
Dialogue: 0,0:00:44.54,0:00:45.67,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:45.79,0:00:46.88,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:00:48.25,0:00:49.09,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:52.42,0:00:57.47,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:00:57.68,0:00:58.64,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:58.76,0:01:00.43,Default,,0,0,0,,Ugg (Хината) Сәлем
Dialogue: 0,0:01:05.77,0:01:07.40,Default,,0,0,0,,О, Цукишима, жақсы жұмыс.
Dialogue: 0,0:01:07.52,0:01:12.61,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:01:12.98,0:01:15.74,Default,,0,0,0,,Эй, сен қаншаға барасың? Балалар сендер
Dialogue: 0,0:01:15.86,0:01:18.53,Default,,0,0,0,,Бұл жеткілікті емес пе? Оны жай қалдырыңыз.
Dialogue: 0,0:01:18.66,0:01:22.45,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:01:22.58,0:01:24.45,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:01:24.58,0:01:26.04,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:01:26.16,0:01:27.67,Default,,0,0,0,,Тория!
Dialogue: 0,0:01:27.92,0:01:32.75,Default,,0,0,0,,(Хината мен Кагеяманың айқайы)
Dialogue: 0,0:01:35.42,0:01:36.67,Default,,0,0,0,,О
Dialogue: 0,0:01:37.26,0:01:38.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:38.89,0:01:41.60,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:01:42.06,0:01:45.10,Default,,0,0,0,,Ешкім соңынан ермейді
Dialogue: 0,0:01:45.68,0:01:48.14,Default,,0,0,0,,Сіз жолда қате бұрылыс алдыңыз, солай ма?
Dialogue: 0,0:01:48.27,0:01:50.27,Default,,0,0,0,,Бұл сенсің, ақымақ!
Dialogue: 0,0:01:52.02,0:01:53.57,Default,,0,0,0,,Ол қайда? мұнда
Dialogue: 0,0:01:53.94,0:01:56.78,Default,,0,0,0,,Wakano 3-chome?
Dialogue: 0,0:01:57.36,0:02:00.62,Default,,0,0,0,,Вакано туралы айтатын болсақ, Шираторизаваның қасында емес пе?
Dialogue: 0,0:02:00.74,0:02:02.74,Default,,0,0,0,,Шираторизава Ушивака ма?
Dialogue: 0,0:02:03.16,0:02:04.70,Default,,0,0,0,,Менен бірдеңе керек пе?
Dialogue: 0,0:02:19.26,0:02:20.47,Default,,0,0,0,,Егер сізде ештеңе болмаса, барыңыз.
Dialogue: 0,0:02:20.59,0:02:21.43,Default,,0,0,0,,Ах
Dialogue: 0,0:02:21.93,0:02:26.43,Default,,0,0,0,,Біз Карасуноданбыз. Шираторизаваны барлау мүмкін бе?
Dialogue: 0,0:02:27.52,0:02:29.14,Default,,0,0,0,,Карасуно...
Dialogue: 0,0:02:29.27,0:02:31.73,Default,,0,0,0,,Бұл біртүрлі асығыс шабуылдарды қолданатын команда.
Dialogue: 0,0:02:31.86,0:02:32.77,Default,,0,0,0,,Ах
Dialogue: 0,0:02:34.77,0:02:36.28,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:02:36.40,0:02:38.70,Default,,0,0,0,,Сіздің қабілеттеріңіз қандай болса да,
Dialogue: 0,0:02:39.28,0:02:42.74,Default,,0,0,0,,Көріну бізді әлсіретпейді.
Dialogue: 0,0:02:49.21,0:02:51.25,Default,,0,0,0,,Бұл өте жылдам қарқын.
Dialogue: 0,0:02:51.37,0:02:54.09,Default,,0,0,0,,О, құдайым, көңілім көтеріліп барады!
Dialogue: 0,0:02:54.21,0:02:55.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:55.21,0:02:57.26,Default,,0,0,0,,Сабыр ет, ақымақ! Ит!
Dialogue: 0,0:02:57.63,0:03:00.13,Default,,0,0,0,,Бұл сенің бірінші серуенің, ақымақ!
Dialogue: 0,0:03:06.64,0:03:10.69,Default,,0,0,0,,О, Хиро!
Dialogue: 0,0:03:17.28,0:03:20.11,Default,,0,0,0,,Бұл волейбол клубының гимназиясына ұқсайды
Dialogue: 0,0:03:20.24,0:03:21.57,Default,,0,0,0,,О
Dialogue: 0,0:03:22.86,0:03:24.49,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:03:24.62,0:03:27.66,Default,,0,0,0,,Иә? Басқа мектеп жоқ па?
Dialogue: 0,0:03:27.79,0:03:29.95,Default,,0,0,0,,Жаттығу матчы... Сіздің қарсыласыңыз кім?
Dialogue: 0,0:03:30.33,0:03:32.58,Default,,0,0,0,,Бұл университет студенті емес пе?
Dialogue: 0,0:03:32.71,0:03:33.63,Default,,0,0,0,,Университет!
Dialogue: 0,0:03:33.75,0:03:38.34,Default,,0,0,0,,Префектурада Шираторизавамен бәсекелесе алатын орта мектеп жоқ.
Dialogue: 0,0:03:38.80,0:03:40.72,Default,,0,0,0,,Сіз кешіктіңіз (Хината) А...
Dialogue: 0,0:03:40.84,0:03:43.47,Default,,0,0,0,,Мен Карасуно орта мектебінен келген Кагеямамын.
Dialogue: 0,0:03:43.59,0:03:45.05,Default,,0,0,0,,Мен барлау жасай аламын ба?
Dialogue: 0,0:03:45.51,0:03:48.77,Default,,0,0,0,,Кагеяма... Китагава Даиичи?
Dialogue: 0,0:03:49.02,0:03:52.48,Default,,0,0,0,,Иә, мен мұны қабылдап, құладым.
Dialogue: 0,0:03:52.60,0:03:54.23,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:03:55.06,0:03:58.40,Default,,0,0,0,,Сенің ойыныңды орта мектепте көргенім есімде.
Dialogue: 0,0:03:59.36,0:04:02.45,Default,,0,0,0,,Бізге эйс қызметін атқара алмайтын сетер керек емес.
Dialogue: 0,0:04:04.07,0:04:04.95,Default,,0,0,0,,Пухат
Dialogue: 0,0:04:05.28,0:04:07.66,Default,,0,0,0,,Сіз өзіңізді барынша тырысып жатқандай сезінбейсіз.
Dialogue: 0,0:04:07.78,0:04:08.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:09.45,0:04:12.25,Default,,0,0,0,,Бірақ егер солай болса, онда Ұлы Патша да.
Dialogue: 0,0:04:12.37,0:04:14.29,Default,,0,0,0,,Ол префектурадағы ең күшті сетер.
Dialogue: 0,0:04:14.79,0:04:18.84,Default,,0,0,0,,Ойкава... ол тамаша ойыншы.
Dialogue: 0,0:04:18.96,0:04:20.76,Default,,0,0,0,,Менің үйіме келуіңіз керек еді.
Dialogue: 0,0:04:21.55,0:04:22.88,Default,,0,0,0,,Ойкава бұл...
Dialogue: 0,0:04:23.01,0:04:26.89,Default,,0,0,0,,Қай жерде жүрсе де, ол өз командасының үздіктерін шығаратын септікші.
Dialogue: 0,0:04:27.68,0:04:30.01,Default,,0,0,0,,Бұл оның қабілеті.
Dialogue: 0,0:04:30.14,0:04:33.10,Default,,0,0,0,,Нашар топырақ жақсы жеміс бермейді.
Dialogue: 0,0:04:33.98,0:04:36.81,Default,,0,0,0,,«Таң жер»... Бұл нені білдіреді?
Dialogue: 0,0:04:38.77,0:04:41.82,Default,,0,0,0,,Аоба Джохсай Ойкавадан басқа әлсіз
Dialogue: 0,0:04:42.24,0:04:43.82,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:45.11,0:04:46.66,Default,,0,0,0,,Әлсіз...
Dialogue: 0,0:04:53.25,0:04:55.50,Default,,0,0,0,,Цинчэн кедей ел болса...
Dialogue: 0,0:04:55.62,0:04:59.79,Default,,0,0,0,,Біз нақты немесе бір нәрсеміз бе?
Dialogue: 0,0:05:00.00,0:05:00.84,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:09.22,0:05:11.68,Default,,0,0,0,,Егер сізді қандай да бір түрде ренжіткен болсам, кешірім сұраймын.
Dialogue: 0,0:05:12.35,0:05:16.35,Default,,0,0,0,,Аоба Джохсайдан жеңіліп, тіпті префектуралық финалға да өте алмайтындар бар.
Dialogue: 0,0:05:16.48,0:05:18.90,Default,,0,0,0,,Не десең де, маған бәрібір.
Dialogue: 0,0:05:29.74,0:05:30.91,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:05:43.13,0:05:46.26,Default,,0,0,0,,Мен бетоннан жасалған Шойо Хинатамын.
Dialogue: 0,0:05:51.14,0:05:53.26,Default,,0,0,0,,Сізді ұрыңыз...
Dialogue: 0,0:05:53.60,0:05:54.93,Default,,0,0,0,,Елдің барлық жеріне барыңыз
Dialogue: 0,0:06:14.74,0:06:16.66,Default,,0,0,0,,(Бүркіт жылауы)
Dialogue: 0,0:06:16.79,0:06:18.37,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:07:13.30,0:07:14.30,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:07:14.51,0:07:16.47,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:07:16.81,0:07:19.52,Default,,0,0,0,,Бүгін Томизавадағы Сендай қалалық гимназиясында -
Dialogue: 0,0:07:20.23,0:07:24.31,Default,,0,0,0,,Орта мектептегі волейболдан бүкіл Жапония чемпионаты
Dialogue: 0,0:07:24.44,0:07:28.03,Default,,0,0,0,,Мияги префектурасының өкілі Харутака волейбол ойынын шешуші матч.
Dialogue: 0,0:07:28.15,0:07:31.49,Default,,0,0,0,,Ширек финал Жартылай финал өтті
Dialogue: 0,0:07:32.07,0:07:34.37,Default,,0,0,0,,Бірінші кездесу Карасуно орта мектебіне қарсы болды.
Dialogue: 0,0:07:34.49,0:07:36.78,Default,,0,0,0,,Күшті Аоба Жосай орта мектебін жеңді.
Dialogue: 0,0:07:37.03,0:07:39.00,Default,,0,0,0,,Менің финалға өткеніме көп уақыт болды.
Dialogue: 0,0:07:39.41,0:07:41.75,Default,,0,0,0,,Бізге аздап жеңісті көрсетіңіз
Dialogue: 0,0:07:41.87,0:07:42.75,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:07:42.87,0:07:45.00,Default,,0,0,0,,Аоджоны жай ғана көрсетпе
Dialogue: 0,0:07:45.38,0:07:47.75,Default,,0,0,0,,Келесіде екінші жартылай финалдық матч.
Dialogue: 0,0:07:47.88,0:07:50.84,Default,,0,0,0,,Бұл оңай жеңген танымал орта мектеп.
Dialogue: 0,0:07:50.97,0:07:53.55,Default,,0,0,0,,Сіз финалға өткен сияқтысыз.
Dialogue: 0,0:07:53.97,0:07:58.18,Default,,0,0,0,,Бұл құбыжық Вакатоси Усидзима басқаратын Шираторизава академиясы.
Dialogue: 0,0:07:58.64,0:08:03.69,Default,,0,0,0,,Карасуно орта мектебі жердегі қуаты жоғары Шираторизава академиясын қаншалықты жалғастырады?
Dialogue: 0,0:08:03.98,0:08:05.52,Default,,0,0,0,,Назар аударыңыз!
Dialogue: 0,0:08:06.02,0:08:08.36,Default,,0,0,0,,Мияги префектурасының шыңын шешу үшін шайқас
Dialogue: 0,0:08:08.48,0:08:10.40,Default,,0,0,0,,Оны жіберіп алмаңыз!
Dialogue: 0,0:08:14.53,0:08:18.20,Default,,0,0,0,,Ал, ертең Шираторизаваға қарсы күресеміз...
Dialogue: 0,0:08:19.16,0:08:21.87,Default,,0,0,0,,Ойкаваға қосылғаннан кейінгі үш жыл ішінде...
Dialogue: 0,0:08:22.00,0:08:26.42,Default,,0,0,0,,Аоба Джосай Шираторизаваға қарсы ешқашан жеңіске жеткен емес.
Dialogue: 0,0:08:26.75,0:08:28.67,Default,,0,0,0,,Тіпті бір рет емес
Dialogue: 0,0:08:29.05,0:08:30.13,Default,,0,0,0,,Біреуге қоңырау шалыңыз...
Dialogue: 0,0:08:30.67,0:08:32.63,Default,,0,0,0,,«Абсолюттік патша»
Dialogue: 0,0:08:33.05,0:08:34.59,Default,,0,0,0,,Әрине, Ушидзима, бірақ...
Dialogue: 0,0:08:34.72,0:08:38.14,Default,,0,0,0,,Префектурада басқа да көптеген жоғары сыныпты жігіттер бар.
Dialogue: 0,0:08:38.51,0:08:41.39,Default,,0,0,0,,Префектурадағы ең күшті атау тек көрсету үшін ғана емес.
Dialogue: 0,0:08:41.89,0:08:45.56,Default,,0,0,0,,Шираторизава сіз ойлағаннан да күшті.
Dialogue: 0,0:08:45.81,0:08:48.73,Default,,0,0,0,,Ешкім бізді жеңеміз деп ойламайды.
Dialogue: 0,0:08:48.86,0:08:49.69,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:50.11,0:08:51.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:51.32,0:08:52.82,Default,,0,0,0,,Не? Хината
Dialogue: 0,0:08:52.94,0:08:54.20,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:08:54.45,0:08:56.49,Default,,0,0,0,,Иә? (Хината) Менің ойымша...
Dialogue: 0,0:08:56.61,0:08:58.45,Default,,0,0,0,,Эй, жаттықтырушыға бұрыл, сен...
Dialogue: 0,0:08:58.57,0:09:01.41,Default,,0,0,0,,Аа, жоқ, бұл менің айтқым келгені емес.
Dialogue: 0,0:09:01.83,0:09:03.62,Default,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:09:04.16,0:09:05.21,Default,,0,0,0,,Иә
Dialogue: 0,0:09:05.79,0:09:10.17,Default,,0,0,0,,Ешкім жеңеміз деп ойлаған жоқ, Сейджиоға қарсы да солай болды.
Dialogue: 0,0:09:10.55,0:09:12.76,Default,,0,0,0,,Сондықтан бұл маңызды емес!
Dialogue: 0,0:09:13.01,0:09:14.51,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:09:14.88,0:09:15.72,Default,,0,0,0,,Иә
Dialogue: 0,0:09:16.68,0:09:19.14,Default,,0,0,0,,Біз де ертең үміткер боламыз.
Dialogue: 0,0:09:19.35,0:09:21.39,Default,,0,0,0,,Сіздерге үлкен реніш көрсетейік.
Dialogue: 0,0:09:21.51,0:09:22.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:23.39,0:09:26.23,Default,,0,0,0,,Құлаған құдіретті ұшпайтын қарға
Dialogue: 0,0:09:26.44,0:09:30.57,Default,,0,0,0,,Сен туралы енді ешкім олай айтпайды.
Dialogue: 0,0:09:31.11,0:09:34.94,Default,,0,0,0,,Қанаттары желге толы қарға енді аспанда ұшып келеді.
Dialogue: 0,0:09:35.78,0:09:37.28,Default,,0,0,0,,Ал, балалар, бара алуларың керек.
Dialogue: 0,0:09:38.28,0:09:41.45,Default,,0,0,0,,Барлық жол, барлық жол
Dialogue: 0,0:09:42.08,0:09:44.66,Default,,0,0,0,,Ал, бәріңе, уақыт келді.
Dialogue: 0,0:09:45.50,0:09:48.42,Default,,0,0,0,,Ертең тағы да жеңіске жетіп, еліміздің түкпір-түкпіріне барайық!
Dialogue: 0,0:09:48.75,0:09:51.84,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:10:05.27,0:10:06.48,Default,,0,0,0,,Кішкентай алып
Dialogue: 0,0:10:07.23,0:10:10.94,Default,,0,0,0,,Финалға бір күн қалғанда қандай сезімде болдыңыз?
Dialogue: 0,0:10:11.40,0:10:13.23,Default,,0,0,0,,Мен қобалжыдым
Dialogue: 0,0:10:13.65,0:10:14.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:17.28,0:10:18.95,Default,,0,0,0,,Қуаныштымын!
Dialogue: 0,0:10:22.24,0:10:25.20,Default,,0,0,0,,Ертең... біз жеңеміз
Dialogue: 0,0:10:25.83,0:10:26.95,Default,,0,0,0,,О!
Dialogue: 0,0:10:32.13,0:10:34.71,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:10:43.85,0:10:45.64,Default,,0,0,0,,Савамура!
Dialogue: 0,0:10:46.14,0:10:47.85,Default,,0,0,0,,Мен сені қолдауға келдім!
Dialogue: 0,0:10:48.39,0:10:50.81,Default,,0,0,0,,Мичимия, сен шынымен келдің.
Dialogue: 0,0:10:50.94,0:10:54.23,Default,,0,0,0,,Уау, біз шынымен финалда жекпе-жек өткіземіз.
Dialogue: 0,0:10:54.36,0:10:55.36,Default,,0,0,0,,Керемет!
Dialogue: 0,0:10:55.48,0:10:58.40,Default,,0,0,0,,Иә, бұл қауіпті!
Dialogue: 0,0:10:58.53,0:11:01.49,Default,,0,0,0,,Сондықтан сөздік қорыңыз қорқынышты.
Dialogue: 0,0:11:01.61,0:11:02.66,Default,,0,0,0,,Қорытынды
Dialogue: 0,0:11:02.78,0:11:04.08,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:11:04.45,0:11:06.04,Default,,0,0,0,,Міне!
Dialogue: 0,0:11:06.58,0:11:09.66,Default,,0,0,0,,Жоқ, у... жеке емес.
Dialogue: 0,0:11:09.79,0:11:11.21,Default,,0,0,0,,Менің ойымша, оны барлығы бір бөліктен түсінеді.
Dialogue: 0,0:11:11.33,0:11:13.75,Default,,0,0,0,,Біздікі де сондай...
Dialogue: 0,0:11:13.88,0:11:15.00,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:11:15.59,0:11:17.67,Default,,0,0,0,,Мичимия күткендей, сіз өте мұқиятсыз.
Dialogue: 0,0:11:17.92,0:11:19.76,Default,,0,0,0,,Маған оны орындыққа қоюға рұқсат етіңіз
Dialogue: 0,0:11:19.88,0:11:21.55,Default,,0,0,0,,...
Dialogue: 0,0:11:21.68,0:11:23.22,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:11:24.80,0:11:26.01,Default,,0,0,0,,Я...
Dialogue: 0,0:11:26.14,0:11:29.39,Default,,0,0,0,,Маған бере алатын болсаң, сен үшін бұл өткен баға.
Dialogue: 0,0:11:32.31,0:11:33.85,Default,,0,0,0,,Хаха, кеттік!
Dialogue: 0,0:11:35.98,0:11:38.03,Default,,0,0,0,,Уау
Dialogue: 0,0:11:38.48,0:11:41.24,Default,,0,0,0,,Күткендей, финалда адам көп.
Dialogue: 0,0:11:41.36,0:11:43.53,Default,,0,0,0,,Рю Бұл қорқатын уақыт емес.
Dialogue: 0,0:11:43.66,0:11:46.08,Default,,0,0,0,,…
Dialogue: 0,0:11:46.20,0:11:47.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:48.66,0:11:51.41,Default,,0,0,0,,...
Dialogue: 0,0:11:51.62,0:11:54.33,Default,,0,0,0,,...
Dialogue: 0,0:11:54.96,0:11:58.25,Default,,0,0,0,,Осыншама көп көрерменнің алдында өнер көрсетсеңіз не болады деп ойлайсыз?
Dialogue: 0,0:11:58.38,0:11:58.88,Default,,0,0,0,,…
Dialogue: 0,0:11:58.88,0:12:00.05,Default,,0,0,0,,Не болса да...
Dialogue: 0,0:11:58.88,0:12:00.05,Default,,0,0,0,,―
Dialogue: 0,0:12:00.05,0:12:00.17,Default,,0,0,0,,Не болса да...
Dialogue: 0,0:12:00.17,0:12:01.30,Default,,0,0,0,,…
Dialogue: 0,0:12:00.17,0:12:01.30,Default,,0,0,0,,Осының өзі оны керемет етеді, солай емес пе?
Dialogue: 0,0:12:01.30,0:12:02.59,Default,,0,0,0,,Осының өзі оны керемет етеді, солай емес пе?
Dialogue: 0,0:12:02.72,0:12:03.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:05.43,0:12:06.76,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:07.14,0:12:08.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:09.39,0:12:10.56,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:10.68,0:12:14.48,Default,,0,0,0,,Кя Нишитани-кун Танака-кун керемет!
Dialogue: 0,0:12:15.02,0:12:17.44,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:12:17.90,0:12:19.44,Default,,0,0,0,,...
Dialogue: 0,0:12:19.57,0:12:20.40,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:21.94,0:12:23.07,Default,,0,0,0,,Жануар демі: жетінші форма
Dialogue: 0,0:12:24.45,0:12:25.87,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:12:27.20,0:12:28.91,Default,,0,0,0,,Ноя-сан, мен істеймін!
Dialogue: 0,0:12:29.03,0:12:31.91,Default,,0,0,0,,Бұл матчта сіз кенеттен батырға айналасыз!
Dialogue: 0,0:12:32.04,0:12:33.96,Default,,0,0,0,,Мен жеңілмеймін, Рю!
Dialogue: 0,0:12:34.08,0:12:35.33,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:12:35.71,0:12:37.88,Default,,0,0,0,,...
Dialogue: 0,0:12:38.00,0:12:40.88,Default,,0,0,0,,Әй, ұят болды, айқайыңды доғар!
Dialogue: 0,0:12:38.00,0:12:40.88,Default,,0,0,0,,Мен қызып кеттім! Мен жанып кеттім! Мен жанып кеттім! Мен жанып кеттім!
Dialogue: 0,0:12:41.01,0:12:44.22,Default,,0,0,0,,Бірақ бұл әдеттегідей сенімді.
Dialogue: 0,0:12:41.01,0:12:44.22,Default,,0,0,0,,Мен қызып кеттім! Мен жанып кеттім! Мен жанып кеттім! Мен жанып кеттім!
Dialogue: 0,0:12:44.22,0:12:45.26,Default,,0,0,0,,Мен қызып кеттім! Мен жанып кеттім! Мен жанып кеттім! Мен жанып кеттім!
Dialogue: 0,0:12:45.38,0:12:47.05,Default,,0,0,0,,（）
Dialogue: 0,0:12:47.05,0:12:48.05,Default,,0,0,0,,（）
Dialogue: 0,0:12:47.05,0:12:48.05,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:12:55.06,0:13:00.44,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:13:09.03,0:13:10.62,Default,,0,0,0,,...
Dialogue: 0,0:13:11.12,0:13:14.25,Default,,0,0,0,,Біздің қолдауымыз ойыншыларға күш береді
Dialogue: 0,0:13:14.62,0:13:16.75,Default,,0,0,0,,...
Dialogue: 0,0:13:16.87,0:13:18.25,Default,,0,0,0,,Yes
Dialogue: 0,0:13:18.50,0:13:22.51,Default,,0,0,0,,...
Dialogue: 0,0:13:22.67,0:13:27.59,Default,,0,0,0,,Бар, жүр, Карасуно, итер, итер, Карасуно
Dialogue: 0,0:13:27.72,0:13:31.22,Default,,0,0,0,,...
Dialogue: 0,0:13:31.76,0:13:33.56,Default,,0,0,0,,Бұл... Бұл дұрыс па?
Dialogue: 0,0:13:33.68,0:13:35.94,Default,,0,0,0,,Ренжіп қалсақ не істеуіміз керек?
Dialogue: 0,0:13:36.60,0:13:39.94,Default,,0,0,0,,Мына жігіттерге қараңдаршы, олар таңқаларлық емес пе?
Dialogue: 0,0:13:40.31,0:13:41.90,Default,,0,0,0,,１ …
Dialogue: 0,0:13:42.02,0:13:44.94,Default,,0,0,0,,Маған асқазанға дәрі керек... (Тохо) Менің де қарным ашты...
Dialogue: 0,0:13:45.07,0:13:46.86,Default,,0,0,0,,Орталық сот…
Dialogue: 0,0:13:46.99,0:13:50.91,Default,,0,0,0,,Ноя-сан, бұл көңілді, бұл көңілді! (Нишитани) Мен қызғанамын!
Dialogue: 0,0:13:51.12,0:13:53.62,Default,,0,0,0,,Танака Нишитани! Шу шығармаңыз!
Dialogue: 0,0:13:53.74,0:13:54.79,Default,,0,0,0,,Сіз тым ашуланшақсыз, солай емес пе?
Dialogue: 0,0:13:54.91,0:13:57.50,Default,,0,0,0,,Ей, құла... Бәрі құла...
Dialogue: 0,0:13:59.33,0:14:00.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:01.34,0:14:03.17,Default,,0,0,0,,Мен күдікті адам емеспін.
Dialogue: 0,0:14:03.30,0:14:04.17,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:04.42,0:14:07.97,Default,,0,0,0,,Бір күдікті адам кезіп жүр екен, мен оны көргенде қашып кетті, мен оны ұстадым!
Dialogue: 0,0:14:08.09,0:14:10.84,Default,,0,0,0,,Бір сәт... (Саэко) Мен оны Шираторизаваның тыңшысы деп ойладым.
Dialogue: 0,0:14:11.18,0:14:12.72,Default,,0,0,0,,Не! (Мэйкоу) Ух...
Dialogue: 0,0:14:12.85,0:14:14.85,Default,,0,0,0,,Жарайды... күте тұрыңыз, мен туысқанмын.
Dialogue: 0,0:14:15.47,0:14:17.56,Default,,0,0,0,,Цукишима Хотарудың ағасы
Dialogue: 0,0:14:17.81,0:14:19.48,Default,,0,0,0,,Цукишиманың үлкен ағасы!?
Dialogue: 0,0:14:19.60,0:14:21.40,Default,,0,0,0,,Тынш!
Dialogue: 0,0:14:21.52,0:14:23.98,Default,,0,0,0,,Маған ойынға келмеу керектігін айтты.
Dialogue: 0,0:14:24.11,0:14:26.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:26.32,0:14:27.99,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:28.40,0:14:30.20,Default,,0,0,0,,Олар бір-біріне ұқсамайды.
Dialogue: 0,0:14:30.32,0:14:32.45,Default,,0,0,0,,Негізінен атмосфера... (Саэко) Иә?
Dialogue: 0,0:14:33.28,0:14:34.66,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:14:35.04,0:14:36.58,Default,,0,0,0,,Шираторизава!
Dialogue: 0,0:14:36.70,0:14:38.29,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:14:38.41,0:14:41.00,Default,,0,0,0,,Шираторизава!
Dialogue: 0,0:14:41.83,0:14:44.38,Default,,0,0,0,,Шираторизава!
Dialogue: 0,0:14:45.34,0:14:50.84,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:14:51.01,0:14:52.39,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:52.51,0:14:53.68,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:53.80,0:14:56.43,Default,,0,0,0,,Кеттік! (Shiratorizawa Cheer Team) Кеттік!
Dialogue: 0,0:14:56.56,0:14:57.77,Default,,0,0,0,,Бүгінгі қарсыласымыз
Dialogue: 0,0:14:57.89,0:14:59.14,Default,,0,0,0,,Бүгінгі қарсыласымыз
Dialogue: 0,0:14:59.27,0:15:00.56,Default,,0,0,0,,Карасуно орта мектебі!
Dialogue: 0,0:15:00.69,0:15:02.06,Default,,0,0,0,,Карасуно орта мектебі!
Dialogue: 0,0:15:02.19,0:15:04.77,Default,,0,0,0,,Құрметпен, Құрметпен (Шираторизава қолдау тобы) Құрметпен, құрметпен
Dialogue: 0,0:15:04.90,0:15:07.90,Default,,0,0,0,,Кеттік! (Shiratorizawa Cheer Team) Кеттік!
Dialogue: 0,0:15:08.03,0:15:09.28,Default,,0,0,0,,Керемет
Dialogue: 0,0:15:09.40,0:15:13.07,Default,,0,0,0,,Аа, бұл шынымен де күшті мектеп сияқты.
Dialogue: 0,0:15:20.41,0:15:21.54,Default,,0,0,0,,Ha
Dialogue: 0,0:15:22.71,0:15:23.54,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:15:30.05,0:15:34.80,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:15:40.35,0:15:42.23,Default,,0,0,0,,
Dialogue: 0,0:15:42.60,0:15:44.94,Default,,0,0,0,,Тынш! (Хината) А...
Dialogue: 0,0:15:46.48,0:15:47.40,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:47.52,0:15:48.36,Default,,0,0,0,,Уау
Dialogue: 0,0:15:49.28,0:15:50.65,Default,,0,0,0,,Бенкей
Dialogue: 0,0:15:51.07,0:15:52.15,Default,,0,0,0,,О...
Dialogue: 0,0:15:52.28,0:15:54.70,Default,,0,0,0,,Ол кісінің Беңкей екені анық.
Dialogue: 0,0:15:54.82,0:15:56.24,Default,,0,0,0,,Шион-сан (Охира) Иә.
Dialogue: 0,0:15:56.41,0:15:57.70,Default,,0,0,0,,Шион!
Dialogue: 0,0:15:57.99,0:16:02.25,Default,,0,0,0,,Бүгінгі кішкентай бала Шион-кунға міндетті түрде Бенкей лақап атын берді.
Dialogue: 0,0:16:02.37,0:16:04.75,Default,,0,0,0,,Қате сурет үшін кешірім сұраймыз.
Dialogue: 0,0:16:04.88,0:16:07.92,Default,,0,0,0,,Бұл Карасуноның бірінші жылдағы жылдам шабуыл дуэтінің бірі ме?
Dialogue: 0,0:16:08.05,0:16:09.67,Default,,0,0,0,,Ә? Шынында ма?
Dialogue: 0,0:16:09.88,0:16:12.13,Default,,0,0,0,,Керемет кілт!
Dialogue: 0,0:16:12.63,0:16:15.01,Default,,0,0,0,,Эй, балалар, кеше солай істедіңдер.
Dialogue: 0,0:16:15.14,0:16:15.97,Default,,0,0,0,,Ах
Dialogue: 0,0:16:16.68,0:16:19.93,Default,,0,0,0,,Бірақ мен мұны сеніммен айта аламын.
Dialogue: 0,0:16:20.56,0:16:23.60,Default,,0,0,0,,Мен ұпай жинау қабілетім бойынша ешқашан жеңілмеймін!
Dialogue: 0,0:16:24.31,0:16:25.69,Default,,0,0,0,,Ең алдымен-
Dialogue: 0,0:16:26.98,0:16:28.82,Default,,0,0,0,,Ұрысты бақылау
Dialogue: 0,0:16:29.15,0:16:30.48,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:16:34.03,0:16:36.24,Default,,0,0,0,,Әлгі кішкентай жігіт дәл астынан соқты.
Dialogue: 0,0:16:36.37,0:16:37.99,Default,,0,0,0,,Өте жылдам!
Dialogue: 0,0:16:38.12,0:16:39.83,Default,,0,0,0,,Сіз жай ғана баптағышты ұстадыңыз ба?
Dialogue: 0,0:16:40.12,0:16:43.33,Default,,0,0,0,,Аоджоның бұл жолы келмегеніне таң қалдым.
Dialogue: 0,0:16:43.46,0:16:45.17,Default,,0,0,0,,Бұл қызық Карасуно
Dialogue: 0,0:16:45.29,0:16:46.29,Default,,0,0,0,,That's right.
Dialogue: 0,0:16:46.63,0:16:50.21,Default,,0,0,0,,Кім келсе де, оларды күштеп түсіру керек!
Dialogue: 0,0:16:50.34,0:16:53.22,Default,,0,0,0,,Егер сіз үлкен мәміле жасағыңыз келсе, шабуыл жасамас бұрын дағдыларыңызды жетілдіріңіз.
Dialogue: 0,0:16:53.34,0:16:54.72,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:16:54.84,0:16:58.30,Default,,0,0,0,,Әдеттегідей, сенің айтқандарың да, сөйлегендерің де керемет, Тех.
Dialogue: 0,0:16:58.43,0:16:59.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:00.06,0:17:02.98,Default,,0,0,0,,Меніңше, бұлай еркелету жақсы емес.
Dialogue: 0,0:17:03.10,0:17:05.48,Default,,0,0,0,,Ката! Тайчи қатал
Dialogue: 0,0:17:06.06,0:17:07.52,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:17:07.65,0:17:09.73,Default,,0,0,0,,Бір жылдан кейін ол менің тұрақты адамым болды.
Dialogue: 0,0:17:09.86,0:17:12.61,Default,,0,0,0,,Ол эйс болатын адам!
Dialogue: 0,0:17:12.99,0:17:13.99,Default,,0,0,0,,Хмф!
Dialogue: 0,0:17:14.19,0:17:16.36,Default,,0,0,0,,Біз сіздің үміттеріңізді ақтаймыз!
Dialogue: 0,0:17:17.16,0:17:20.41,Default,,0,0,0,,Дұрыс, қолыңнан келгеннің бәрін жаса, болашақ эйс (Гошики) Уау!
Dialogue: 0,0:17:20.53,0:17:22.41,Default,,0,0,0,,Өтінемін, мұны жасамаңыз, себебі ол нашарлайды.
Dialogue: 0,0:17:23.04,0:17:24.91,Default,,0,0,0,,Біріншіден, қабылдаңыз.
Dialogue: 0,0:17:25.04,0:17:27.75,Default,,0,0,0,,Вакатоши-кун, мен де бүгін сенен сұраймын.
Dialogue: 0,0:17:28.04,0:17:32.30,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз, тек Вакатошиге сенбеңіз.
Dialogue: 0,0:17:32.42,0:17:34.97,Default,,0,0,0,,Оң қол, Бенкей?
Dialogue: 0,0:17:35.09,0:17:37.18,Default,,0,0,0,,
Dialogue: 0,0:17:37.68,0:17:40.01,Default,,0,0,0,,Олардың басталуы күтілгендей.
Dialogue: 0,0:17:40.14,0:17:41.22,Default,,0,0,0,,Мүмкіндіктер Есіңізде ме?
Dialogue: 0,0:17:41.35,0:17:42.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:42.72,0:17:45.27,Default,,0,0,0,,Мен Ушидзима туралы шешім қабылдай алмайтыным анық.
Dialogue: 0,0:17:45.39,0:17:48.10,Default,,0,0,0,,Ауыстырыңыз және оны қайтарыңыз Бұл жақсы
Dialogue: 0,0:17:48.23,0:17:51.65,Default,,0,0,0,,Екінші жағы да машина емес. Қателер міндетті түрде болады.
Dialogue: 0,0:17:52.07,0:17:53.86,Default,,0,0,0,,Сіз не істеу керектігін білесіз бе?
Dialogue: 0,0:17:53.98,0:17:56.11,Default,,0,0,0,,О!
Dialogue: 0,0:17:56.24,0:17:57.32,Default,,0,0,0,,
Dialogue: 0,0:17:57.45,0:18:00.53,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:18:00.66,0:18:06.33,Default,,0,0,0,,Волейболдан орта мектептің бүкіл Жапония чемпионаты қазір басталады
Dialogue: 0,0:18:06.46,0:18:11.21,Default,,0,0,0,,Мияги префектурасының өкілі шешуші матч Ерлер арасындағы чемпионаттың шешуші матчы
Dialogue: 0,0:18:11.67,0:18:15.46,Default,,0,0,0,,Мияги префектуралық Карасуно орта мектебі қарсы.
Dialogue: 0,0:18:15.88,0:18:20.22,Default,,0,0,0,,Шираторизава Гакуэн орта мектебінің ойыны басталады.
Dialogue: 0,0:18:20.34,0:18:21.60,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:18:21.72,0:18:23.22,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:18:28.02,0:18:33.40,Default,,0,0,0,,Карасуно орта мектебінің бастапқы ойыншыларымен таныстыру
Dialogue: 0,0:18:33.52,0:18:35.61,Default,,0,0,0,,№1 Даичи Савамура
Dialogue: 0,0:18:35.73,0:18:40.49,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:40.86,0:18:42.99,Default,,0,0,0,,№ 3 Асахи Томине
Dialogue: 0,0:18:43.12,0:18:46.66,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:47.20,0:18:49.21,Default,,0,0,0,,№ 5 Рюноскэ Танака
Dialogue: 0,0:18:49.33,0:18:52.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:52.50,0:18:53.67,Default,,0,0,0,,Тынш!
Dialogue: 0,0:18:54.04,0:18:56.09,Default,,0,0,0,,№ 9 Тобио Кагеяма
Dialogue: 0,0:18:56.21,0:18:59.47,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:59.97,0:19:02.18,Default,,0,0,0,,№10 Шойо Хината
Dialogue: 0,0:19:02.30,0:19:06.14,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:06.47,0:19:08.77,Default,,0,0,0,,№ 11 Цукисима Хотару
Dialogue: 0,0:19:08.89,0:19:09.98,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:10.10,0:19:12.06,Default,,0,0,0,,Өрт сөндірушілер! (Мэйкоу) Бір сәт тоқтаңыз...
Dialogue: 0,0:19:12.48,0:19:15.15,Default,,0,0,0,,№ 4 Либеро Ю Нишитани
Dialogue: 0,0:19:15.27,0:19:17.28,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:17.40,0:19:18.82,Default,,0,0,0,,Hyahoo!
Dialogue: 0,0:19:19.19,0:19:21.57,Default,,0,0,0,,Директор Итетцу Такеда
Dialogue: 0,0:19:21.70,0:19:24.41,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:24.53,0:19:28.54,Default,,0,0,0,,Келесі, Шираторизава Гакуэн орта мектебі...
Dialogue: 0,0:19:28.66,0:19:31.92,Default,,0,0,0,,Бастапқы ойыншыларды таныстыру
Dialogue: 0,0:19:32.04,0:19:34.29,Default,,0,0,0,,№1 Вакатоси Ушидзима
Dialogue: 0,0:19:34.42,0:19:35.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:35.92,0:19:38.21,Default,,0,0,0,,Ушидзима-кун!
Dialogue: 0,0:19:38.71,0:19:40.59,Default,,0,0,0,,№4 Шион Охира
Dialogue: 0,0:19:40.72,0:19:42.63,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:43.01,0:19:44.97,Default,,0,0,0,,№ 5 Сатору Тендо
Dialogue: 0,0:19:45.10,0:19:46.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:47.01,0:19:49.18,Default,,0,0,0,,№ 8 Гошикико
Dialogue: 0,0:19:49.31,0:19:51.10,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:51.85,0:19:53.98,Default,,0,0,0,,№10 Кендзиро Ширабу
Dialogue: 0,0:19:54.10,0:19:55.81,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:56.65,0:19:58.94,Default,,0,0,0,,№12 Тайчи Каваниши
Dialogue: 0,0:19:59.07,0:20:00.53,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:00.82,0:20:04.20,Default,,0,0,0,,№ 14 Либеро Хаято Ямагата
Dialogue: 0,0:20:04.32,0:20:05.95,Default,,0,0,0,,Тыныш! (қуаныш)
Dialogue: 0,0:20:06.16,0:20:08.41,Default,,0,0,0,,Директор Каджи Вашишо
Dialogue: 0,0:20:08.54,0:20:10.58,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:11.25,0:20:15.33,Default,,0,0,0,,Құрметті көрермендер, екі командаға да сәттілік тілеймін.
Dialogue: 0,0:20:15.46,0:20:18.05,Default,,0,0,0,,Жомарт қолдауыңыз үшін рахмет.
Dialogue: 0,0:20:18.17,0:20:19.80,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:20:20.34,0:20:22.47,Default,,0,0,0,,Мен олардың шиеленістерін сезінемін.
Dialogue: 0,0:20:22.59,0:20:27.80,Default,,0,0,0,,Хинатаның жүктеп салған кезде ашқан жаңалығы Оны көргенде мен оның атмосферасы өте жақсы деп ойладым.
Dialogue: 0,0:20:27.93,0:20:30.85,Default,,0,0,0,,Арғы жағы үшін бұл сан рет басып өткен жол.
Dialogue: 0,0:20:30.97,0:20:33.31,Default,,0,0,0,,Екінші жағынан, бұл менің бірінші финалым.
Dialogue: 0,0:20:33.44,0:20:35.52,Default,,0,0,0,,Бірінші орталық сот
Dialogue: 0,0:20:35.65,0:20:38.27,Default,,0,0,0,,Қалыпты болып қала алмауыңыз таңқаларлық емес.
Dialogue: 0,0:20:42.78,0:20:43.99,Default,,0,0,0,,
Dialogue: 0,0:20:44.11,0:20:46.87,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:47.53,0:20:48.62,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:49.45,0:20:50.29,Default,,0,0,0,,Ушидзима мырза
Dialogue: 0,0:20:53.21,0:20:54.50,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:20:59.92,0:21:01.13,Default,,0,0,0,,Хмф!
Dialogue: 0,0:21:02.17,0:21:03.09,Default,,0,0,0,,Ұстадым!
Dialogue: 0,0:21:09.89,0:21:10.72,Default,,0,0,0,,
Dialogue: 0,0:21:11.18,0:21:15.23,Default,,0,0,0,,Нааиский Ушидзима!
Dialogue: 0,0:21:15.56,0:21:18.98,Default,,0,0,0,,Ушидзима! Ушидзима!
Dialogue: 0,0:21:24.78,0:21:28.07,Default,,0,0,0,,Әй, шықты, кетті.
Dialogue: 0,0:21:30.08,0:21:31.99,Default,,0,0,0,,Сол Нишитани-кун...
Dialogue: 0,0:21:33.33,0:21:34.37,Default,,0,0,0,,Үш бөтелке, өтінемін
Dialogue: 0,0:21:34.50,0:21:35.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:37.54,0:21:40.38,Default,,0,0,0,,Мен оған міндетті түрде үйренемін.
Dialogue: 0,0:21:42.38,0:21:44.09,Default,,0,0,0,,Шираторизавадағы Ушивака
Dialogue: 0,0:21:44.38,0:21:46.05,Default,,0,0,0,,Иә? (Нишитани) Егер...
Dialogue: 0,0:21:46.38,0:21:49.01,Default,,0,0,0,,«Мен Карасуноға тиесілімін»
Dialogue: 0,0:21:49.43,0:21:50.43,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:21:50.55,0:21:53.14,Default,,0,0,0,,Хахахаха Дұрыс.
Dialogue: 0,0:21:53.27,0:21:55.56,Default,,0,0,0,,Ушидзиманың барлық шабуылдарын тоқтатыңыз
Dialogue: 0,0:21:55.68,0:21:58.73,Default,,0,0,0,,Немесе оны алу мүмкін емес.
Dialogue: 0,0:21:58.90,0:21:59.73,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:22:00.77,0:22:03.86,Default,,0,0,0,,Көтеруге болмайтын шыбықтар алуға болады!
Dialogue: 0,0:22:04.40,0:22:05.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:05.99,0:22:07.61,Default,,0,0,0,,Жалпы қорғаныс
Dialogue: 0,0:22:07.78,0:22:09.41,Default,,0,0,0,,Бұл Усидзиманың мамандығы болса керек.
Dialogue: 0,0:22:09.53,0:22:11.95,Default,,0,0,0,,Көлденең жағын блокпен мықтап бекітіңіз.
Dialogue: 0,0:22:12.08,0:22:14.91,Default,,0,0,0,,Нишитаниді ашық түзу жағына қойыңыз
Dialogue: 0,0:22:15.62,0:22:18.25,Default,,0,0,0,,Либероны соғуға тырысыңыз.
Dialogue: 0,0:22:22.59,0:22:23.88,Default,,0,0,0,,Жақсы уақыт!
Dialogue: 0,0:22:30.59,0:22:31.89,Default,,0,0,0,,
Dialogue: 0,0:22:32.35,0:22:35.52,Default,,0,0,0,,Иә? Егер сіз біртүрлі нәрсені сезсеңіз ...
Dialogue: 0,0:22:35.97,0:22:37.93,Default,,0,0,0,,Сол жақтағы бірінші нөмір солақай ма?
Dialogue: 0,0:22:38.69,0:22:40.19,Default,,0,0,0,,Солақай адамдар -
Dialogue: 0,0:22:40.44,0:22:44.90,Default,,0,0,0,,Масақты соққанда, оның айналу жолы оң қолды адамдар үшін басқаша болады.
Dialogue: 0,0:22:45.61,0:22:47.36,Default,,0,0,0,,Волейбол – допты ұстай алмайтын доп ойыны.
Dialogue: 0,0:22:48.15,0:22:50.57,Default,,0,0,0,,Сонымен қатар, допты ұстайтын бет өте тар.
Dialogue: 0,0:22:51.70,0:22:53.49,Default,,0,0,0,,Сондықтан сіз допты алған сәтте -
Dialogue: 0,0:22:53.62,0:22:56.37,Default,,0,0,0,,Оның соғу жолы сәл басқаша...
Dialogue: 0,0:22:56.50,0:22:58.87,Default,,0,0,0,,Бұл үлкен сәйкессіздік тудырады
Dialogue: 0,0:23:02.38,0:23:03.21,Default,,0,0,0,,
Dialogue: 0,0:23:03.34,0:23:05.71,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:23:06.05,0:23:07.67,Default,,0,0,0,,Иә? Қандай дыбыс?
Dialogue: 0,0:23:07.80,0:23:10.63,Default,,0,0,0,,А, бұл техникалық күту уақыты.
Dialogue: 0,0:23:10.76,0:23:11.84,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:23:11.97,0:23:14.85,Default,,0,0,0,,Тек 5-сеттік матч кезінде енгізілген. Күту кезінде
Dialogue: 0,0:23:14.97,0:23:18.73,Default,,0,0,0,,Біреуінде 8 немесе 16 ұпай болғанда енгізіңіз.
Dialogue: 0,0:23:18.85,0:23:19.68,Default,,0,0,0,,Меніңше...
Dialogue: 0,0:23:20.48,0:23:21.85,Default,,0,0,0,,Ұят болды, Нишитани.
Dialogue: 0,0:23:21.98,0:23:24.23,Default,,0,0,0,,Өйткені ол Ушиваканың ұшқындарына жауап берді.
Dialogue: 0,0:23:24.36,0:23:27.90,Default,,0,0,0,,Мен қол тигізген ұшқыш толық қуатта емес еді.
Dialogue: 0,0:23:28.03,0:23:28.86,Default,,0,0,0,,На
Dialogue: 0,0:23:29.44,0:23:32.78,Default,,0,0,0,,Мен орта мектепте оқып жүргенімде солақай жігітпен жасаған асуым болды
Dialogue: 0,0:23:32.91,0:23:35.28,Default,,0,0,0,,Мұны істеу өте қиын болғаны есімде.
Dialogue: 0,0:23:35.41,0:23:39.41,Default,,0,0,0,,Ушиваканың жұмсақ соққысы да өлімге әкелетін қару.
Dialogue: 0,0:23:39.91,0:23:43.63,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:23:44.21,0:23:46.84,Default,,0,0,0,,Барлығының жүздері қатып қалған.
Dialogue: 0,0:23:46.96,0:23:48.38,Default,,0,0,0,,Релакс Релакс
Dialogue: 0,0:23:48.51,0:23:49.46,Default,,0,0,0,,Демалу…
Dialogue: 0,0:23:49.80,0:23:51.51,Default,,0,0,0,,…kusu
Dialogue: 0,0:23:53.59,0:23:54.85,Default,,0,0,0,,Я...
Dialogue: 0,0:23:54.97,0:23:56.68,Default,,0,0,0,,
Dialogue: 0,0:24:01.06,0:24:01.81,Default,,0,0,0,,Хмф!
Dialogue: 0,0:24:02.81,0:24:04.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:05.06,0:24:06.02,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:24:06.48,0:24:08.28,Default,,0,0,0,,Ниссер!
Dialogue: 0,0:24:08.82,0:24:10.28,Default,,0,0,0,,Кешіріңіз, келесі!
Dialogue: 0,0:24:10.40,0:24:11.70,Default,,0,0,0,,Дегенмен, менің ойымша, бұл жақсы жоспар.
Dialogue: 0,0:24:12.11,0:24:14.41,Default,,0,0,0,,Мен қызмет көрсету-қабылдау болмаған жағдайда болғаныма қуаныштымын.
Dialogue: 0,0:24:15.53,0:24:19.66,Default,,0,0,0,,Біртүрлі, ең алдымен...
Dialogue: 0,0:24:20.75,0:24:22.16,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:24:22.79,0:24:25.13,Default,,0,0,0,,Кел, кел.
Dialogue: 0,0:24:26.25,0:24:26.96,Default,,0,0,0,,Кел, кел, кел...
Dialogue: 0,0:24:26.96,0:24:27.79,Default,,0,0,0,,Кел, кел, кел...
Dialogue: 0,0:24:26.96,0:24:27.79,Default,,0,0,0,,Тағы бір!
Dialogue: 0,0:24:27.79,0:24:28.71,Default,,0,0,0,,Кел, кел, кел...
Dialogue: 0,0:24:28.71,0:24:29.84,Default,,0,0,0,,Кел, кел, кел...
Dialogue: 0,0:24:28.71,0:24:29.84,Default,,0,0,0,,
Dialogue: 0,0:24:29.96,0:24:31.34,Default,,0,0,0,,Маған кел!
Dialogue: 0,0:24:31.76,0:24:34.43,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:24:44.52,0:24:45.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:45.48,0:24:46.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:48.52,0:24:50.11,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:24:50.23,0:24:51.44,Default,,0,0,0,,Жарайды, тамаша!
Dialogue: 0,0:24:51.57,0:24:52.86,Default,,0,0,0,,Шешіңіз!
Dialogue: 0,0:24:54.65,0:24:55.86,Default,,0,0,0,,Соққыңыз келе ме?
Dialogue: 0,0:24:57.95,0:24:59.45,Default,,0,0,0,,Уф
Dialogue: 0,0:24:59.74,0:25:01.70,Default,,0,0,0,,Сой! (Karasuno мүшелері) Тынш!
Dialogue: 0,0:25:02.04,0:25:04.62,Default,,0,0,0,,Бұл сіздің айтқаныңызды орындаудың үшінші әрекеті ме?
Dialogue: 0,0:25:04.75,0:25:05.92,Default,,0,0,0,,Мен жеңіле алмаймын
Dialogue: 0,0:25:06.42,0:25:08.08,Default,,0,0,0,,Жарайды, қарсы шабуыл!
Dialogue: 0,0:25:08.21,0:25:11.55,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:25:12.38,0:25:13.88,Default,,0,0,0,,Шойо пайда болды!
Dialogue: 0,0:25:14.01,0:25:15.63,Default,,0,0,0,,Бірінші рет пайда болған кезде
Dialogue: 0,0:25:15.76,0:25:18.47,Default,,0,0,0,,Айналу жылдам болды.
Dialogue: 0,0:25:18.60,0:25:19.76,Default,,0,0,0,,Бір ату, соны гол!
Dialogue: 0,0:25:19.89,0:25:21.31,Default,,0,0,0,,
Dialogue: 0,0:25:27.90,0:25:29.65,Default,,0,0,0,,Ол қызмет көрсетпейді.
Dialogue: 0,0:25:29.77,0:25:31.73,Default,,0,0,0,,Артқы шабуылға дайындалу.
Dialogue: 0,0:25:34.86,0:25:35.78,Default,,0,0,0,,
Dialogue: 0,0:25:36.36,0:25:38.24,Default,,0,0,0,,Бір адамға уақыт айырмашылығы...
Dialogue: 0,0:25:38.57,0:25:40.12,Default,,0,0,0,,Иә! (Хината) Қарғыс атқыр...
Dialogue: 0,0:25:40.24,0:25:43.79,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:25:43.91,0:25:45.12,Default,,0,0,0,,
Dialogue: 0,0:25:45.25,0:25:46.75,Default,,0,0,0,,Ниссер!
Dialogue: 0,0:25:47.21,0:25:48.04,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:25:48.79,0:25:49.71,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:25:50.13,0:25:51.21,Default,,0,0,0,,
Dialogue: 0,0:25:52.46,0:25:53.88,Default,,0,0,0,,Керемет төреші!
Dialogue: 0,0:25:54.01,0:25:57.09,Default,,0,0,0,,Шираторизавада қателіктер жоқ.
Dialogue: 0,0:25:57.22,0:25:58.43,Default,,0,0,0,,Маған ұнады!
Dialogue: 0,0:26:00.51,0:26:01.64,Default,,0,0,0,,Уф
Dialogue: 0,0:26:02.85,0:26:03.93,Default,,0,0,0,,
Dialogue: 0,0:26:04.56,0:26:05.93,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:26:06.06,0:26:06.89,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:26:07.02,0:26:11.19,Default,,0,0,0,,Кагеяма мен Нишитанидің өзін әдеттегідей ұстауы таңқаларлық емес.
Dialogue: 0,0:26:11.31,0:26:12.15,Default,,0,0,0,,Иә
Dialogue: 0,0:26:12.27,0:26:13.69,Default,,0,0,0,,
Dialogue: 0,0:26:19.32,0:26:20.87,Default,,0,0,0,,Қарғыс атсын, мен оны ұға алмаймын.
Dialogue: 0,0:26:21.70,0:26:22.95,Default,,0,0,0,,Хината соңғы!
Dialogue: 0,0:26:24.08,0:26:25.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:26:26.83,0:26:29.37,Default,,0,0,0,,Блокты соғыңыз! (Такинуэ) Тамаша серпіліс!
Dialogue: 0,0:26:29.87,0:26:31.17,Default,,0,0,0,,Тағы бір рет Тағы бір рет
Dialogue: 0,0:26:34.92,0:26:36.46,Default,,0,0,0,,Тей! (Тендо)
Dialogue: 0,0:26:37.72,0:26:41.39,Default,,0,0,0,,Мен бетоннан Шойо Хинатамын.
Dialogue: 0,0:26:41.93,0:26:43.97,Default,,0,0,0,,Сені ұрдым...
Dialogue: 0,0:26:44.14,0:26:45.18,Default,,0,0,0,,Елдің барлық жеріне барыңыз
Dialogue: 0,0:26:48.52,0:26:49.77,Default,,0,0,0,,Тей!
Dialogue: 0,0:26:51.52,0:26:52.77,Default,,0,0,0,,Ах
Dialogue: 0,0:26:53.94,0:26:54.86,Default,,0,0,0,,Мені бер
Dialogue: 0,0:26:55.19,0:26:56.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:56.48,0:26:57.40,Default,,0,0,0,,Ушидзима мырза!
Dialogue: 0,0:27:00.61,0:27:01.57,Default,,0,0,0,,
Dialogue: 0,0:27:01.70,0:27:04.53,Default,,0,0,0,,Угги гугугу…
Dialogue: 0,0:27:04.66,0:27:07.58,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:27:08.29,0:27:10.12,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:27:12.29,0:27:13.75,Default,,0,0,0,,Иә
Dialogue: 0,0:27:13.88,0:27:18.05,Default,,0,0,0,,Менімен тек өзін ғана қызықтыратын Вакатоши-кун жарысып жатыр.
Dialogue: 0,0:27:18.17,0:27:19.63,Default,,0,0,0,,Қандай қызық!
Dialogue: 0,0:27:19.84,0:27:22.09,Default,,0,0,0,,Ннуну... (Танака) Келесі кезекте!
Dialogue: 0,0:27:22.47,0:27:26.39,Default,,0,0,0,,Вакатоши-кун, сен Карасуноның 10 санын білесің бе?
Dialogue: 0,0:27:26.51,0:27:27.77,Default,,0,0,0,,Біз көшеде кездестік
Dialogue: 0,0:27:27.89,0:27:28.81,Default,,0,0,0,,Жол?
Dialogue: 0,0:27:28.93,0:27:31.64,Default,,0,0,0,,Мені жеңіп, ел аралаймын деді.
Dialogue: 0,0:27:31.77,0:27:32.85,Default,,0,0,0,,Не? Көшеде?
Dialogue: 0,0:27:34.11,0:27:35.36,Default,,0,0,0,,Енді ойлап қарасам, Ушидзима-сан
Dialogue: 0,0:27:35.48,0:27:38.61,Default,,0,0,0,,Мектепке бөгде адамдарды кіргізгеніңіз үшін ұрысып қалдыңыз.
Dialogue: 0,0:27:38.74,0:27:41.36,Default,,0,0,0,,Қызықты Карасуно саны 10
Dialogue: 0,0:27:41.49,0:27:42.91,Default,,0,0,0,,Сондықтан маған ұнады
Dialogue: 0,0:27:43.03,0:27:44.24,Default,,0,0,0,,Жоқ, маған ұнамайды.
Dialogue: 0,0:27:44.37,0:27:45.20,Default,,0,0,0,,Не? (Охира) Иә?
Dialogue: 0,0:27:46.45,0:27:49.25,Default,,0,0,0,,Мен негізсіз сенімді жек көремін.
Dialogue: 0,0:27:50.21,0:27:51.92,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:27:52.04,0:27:55.34,Default,,0,0,0,,Мен 5 сеттік матчтың бірінші сетінен жеңіліп қалдым.
Dialogue: 0,0:27:55.71,0:28:00.09,Default,,0,0,0,,Бұл жиында Усидзиманың ұпайы 11 ұпай.
Dialogue: 0,0:28:00.22,0:28:02.55,Default,,0,0,0,,Ұпайлардың жартысына жуығы жиналады
Dialogue: 0,0:28:02.68,0:28:03.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:03.59,0:28:06.89,Default,,0,0,0,,Дегенмен, Ушидзиманың доптарды алуы...
Dialogue: 0,0:28:07.01,0:28:10.27,Default,,0,0,0,,Шираторизава осылайша жойылып жатыр.
Dialogue: 0,0:28:10.85,0:28:14.94,Default,,0,0,0,,Тіпті тікелей ұпай әкелмейтін шабуылдар да кейінірек ойналады.
Dialogue: 0,0:28:15.06,0:28:15.98,Default,,0,0,0,,Ұмытпа!
Dialogue: 0,0:28:16.11,0:28:17.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:28:17.44,0:28:19.44,Default,,0,0,0,,
Dialogue: 0,0:28:19.82,0:28:21.90,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:28:22.32,0:28:24.16,Default,,0,0,0,,Ақылды шешім қабылда, инженер!
Dialogue: 0,0:28:24.28,0:28:25.12,Default,,0,0,0,,Иә
Dialogue: 0,0:28:25.82,0:28:26.83,Default,,0,0,0,,
Dialogue: 0,0:28:31.00,0:28:32.00,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:28:33.71,0:28:34.54,Default,,0,0,0,,Nu
Dialogue: 0,0:28:36.50,0:28:38.63,Default,,0,0,0,,Синхрондалған шабуыл!
Dialogue: 0,0:28:38.75,0:28:40.88,Default,,0,0,0,,Бір уақытта төрт адам шабуыл жасайды
Dialogue: 0,0:28:43.72,0:28:44.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:46.18,0:28:47.18,Default,,0,0,0,,
Dialogue: 0,0:28:47.30,0:28:48.47,Default,,0,0,0,,Көрінбейтін белгілері жоқ, біртіндеп өршіп бара жатқан ауру сияқты—
Dialogue: 0,0:28:48.60,0:28:51.52,Default,,0,0,0,,Бар, жүр, Карасуно! Итер, Карасуно!
Dialogue: 0,0:28:51.89,0:28:53.85,Default,,0,0,0,,Сізді алаңдатты.
Dialogue: 0,0:28:53.98,0:28:55.48,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:28:57.44,0:28:59.02,Default,,0,0,0,,
Dialogue: 0,0:29:01.99,0:29:02.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:29:04.32,0:29:05.86,Default,,0,0,0,,Жарайды, мен оны шатастырдым!
Dialogue: 0,0:29:06.36,0:29:07.20,Default,,0,0,0,,Ушидзима мырза!
Dialogue: 0,0:29:09.66,0:29:11.29,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:29:11.70,0:29:15.50,Default,,0,0,0,,Ұпай алсаңыз да, оны қазіргідей сақтаған дұрыс.
Dialogue: 0,0:29:15.62,0:29:16.75,Default,,0,0,0,,О
Dialogue: 0,0:29:17.08,0:29:20.71,Default,,0,0,0,,Уау, ол жігіт тағы қызмет етті ме?
Dialogue: 0,0:29:20.84,0:29:22.30,Default,,0,0,0,,
Dialogue: 0,0:29:23.05,0:29:25.01,Default,,0,0,0,,Вакатоши Ниссер!
Dialogue: 0,0:29:26.59,0:29:27.51,Default,,0,0,0,,Хмф!
Dialogue: 0,0:29:27.64,0:29:28.80,Default,,0,0,0,,Босатыңыз...
Dialogue: 0,0:29:30.01,0:29:31.51,Default,,0,0,0,,Гуха…
Dialogue: 0,0:29:32.14,0:29:35.02,Default,,0,0,0,,Гаха Жоспарланғандай
Dialogue: 0,0:29:35.14,0:29:36.48,Default,,0,0,0,,Менің көз жасым келді.
Dialogue: 0,0:29:36.98,0:29:38.35,Default,,0,0,0,,Керемет, Танака!
Dialogue: 0,0:29:38.48,0:29:39.23,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:29:39.23,0:29:42.03,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:29:39.23,0:29:42.03,Default,,0,0,0,,Ушивака Гяфун десең!
Dialogue: 0,0:29:42.03,0:29:42.48,Default,,0,0,0,,Ушивака Гяфун десең!
Dialogue: 0,0:29:42.61,0:29:45.40,Default,,0,0,0,,Хинатаның Ушивакаға қатысы бар ма?
Dialogue: 0,0:29:45.53,0:29:47.95,Default,,0,0,0,,Оған бірдеңе дұрыс болмаған сияқты.
Dialogue: 0,0:29:48.07,0:29:51.70,Default,,0,0,0,,Иә? Бұл жерді білмеймін, бірақ басқа мектепке қатысы бар сияқты.
Dialogue: 0,0:29:51.83,0:29:53.29,Default,,0,0,0,,
Dialogue: 0,0:29:55.41,0:29:58.88,Default,,0,0,0,,Қорғама, ойланбастан шабуыл жасай бер
Dialogue: 0,0:30:00.71,0:30:02.30,Default,,0,0,0,,Мүмкіндік добы!
Dialogue: 0,0:30:03.59,0:30:05.72,Default,,0,0,0,,Беріңіз!
Dialogue: 0,0:30:05.92,0:30:07.68,Default,,0,0,0,,Қайтадан қиғаш ұшу!
Dialogue: 0,0:30:12.68,0:30:13.52,Default,,0,0,0,,Ах
Dialogue: 0,0:30:16.14,0:30:17.19,Default,,0,0,0,,
Dialogue: 0,0:30:19.31,0:30:22.19,Default,,0,0,0,,Керемет бала…
Dialogue: 0,0:30:27.28,0:30:31.41,Default,,0,0,0,,Вакатоши-кунды жеңгің келсе, алдымен мені жең.
Dialogue: 0,0:30:31.66,0:30:33.08,Default,,0,0,0,,Ах-ли
Dialogue: 0,0:30:33.58,0:30:36.41,Default,,0,0,0,,Guess monster пайда болды
Dialogue: 0,0:30:37.16,0:30:38.46,Default,,0,0,0,,Guess дегеніміз не?
Dialogue: 0,0:30:38.58,0:30:40.88,Default,,0,0,0,,Шираторизава №5 Ол гей жігіт пе?
Dialogue: 0,0:30:41.00,0:30:43.75,Default,,0,0,0,,Мен... Қызық, ол мені соқыр қылмақ па, әлде бірдеңе ме?
Dialogue: 0,0:30:43.88,0:30:45.42,Default,,0,0,0,,Сау болыңыз Хината
Dialogue: 0,0:30:45.55,0:30:47.76,Default,,0,0,0,,Бұл қате.
Dialogue: 0,0:30:49.13,0:30:50.34,Default,,0,0,0,,Тей!
Dialogue: 0,0:30:50.76,0:30:52.43,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:30:52.55,0:30:53.68,Default,,0,0,0,,
Dialogue: 0,0:30:56.85,0:30:58.35,Default,,0,0,0,,Тей! (Савамура) Хамф
Dialogue: 0,0:30:58.73,0:31:00.19,Default,,0,0,0,,Керемет қабыл алыңыздар!
Dialogue: 0,0:31:01.40,0:31:02.44,Default,,0,0,0,,Амаева
Dialogue: 0,0:31:11.70,0:31:13.45,Default,,0,0,0,,Уау
Dialogue: 0,0:31:13.58,0:31:15.95,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:31:16.49,0:31:18.91,Default,,0,0,0,,Күткендей, мен тайм-аут алдым.
Dialogue: 0,0:31:19.46,0:31:23.96,Default,,0,0,0,,Сол 5 саны, неге сонша рет бұғаттайсың...
Dialogue: 0,0:31:24.67,0:31:28.51,Default,,0,0,0,,Сол 5-ші блоктың сипаттамасы – оқу және түйсік.
Dialogue: 0,0:31:28.63,0:31:29.47,Default,,0,0,0,,«Ойлан блогы»
Dialogue: 0,0:31:30.93,0:31:31.80,Default,,0,0,0,,Ойлан?
Dialogue: 0,0:31:31.93,0:31:34.35,Default,,0,0,0,,GUESS «болжау» дегенді білдіреді
Dialogue: 0,0:31:34.47,0:31:38.22,Default,,0,0,0,,Лақтыру көтерілмес бұрын шабуылды оқып, инстинктпен дерлік секіріңіз.
Dialogue: 0,0:31:39.06,0:31:41.81,Default,,0,0,0,,Бұл жеке дағдыларға негізделген блок.
Dialogue: 0,0:31:41.94,0:31:46.11,Default,,0,0,0,,Менің ойымша, 5 санының оқылуы өте өткір.
Dialogue: 0,0:31:47.23,0:31:49.19,Default,,0,0,0,,Артық ойға алданып қалмаңыз
Dialogue: 0,0:31:49.32,0:31:50.15,Default,,0,0,0,,Біз!
Dialogue: 0,0:31:50.61,0:31:52.32,Default,,0,0,0,,
Dialogue: 0,0:31:52.86,0:31:55.33,Default,,0,0,0,,Тағы бір бөтелке!
Dialogue: 0,0:31:57.29,0:31:58.12,Default,,0,0,0,,Тей!
Dialogue: 0,0:31:58.33,0:32:00.00,Default,,0,0,0,,Алдыңғы Алдыңғы! (Савамура) Ух...
Dialogue: 0,0:32:00.58,0:32:01.41,Default,,0,0,0,,...
Dialogue: 0,0:32:02.29,0:32:04.92,Default,,0,0,0,,Мен қателік жібердім!
Dialogue: 0,0:32:05.25,0:32:06.46,Default,,0,0,0,,Уф (Ямагата) Хамф
Dialogue: 0,0:32:06.59,0:32:08.71,Default,,0,0,0,,Тағы бір рет Тағы бір рет! (Нишитани) Ша!
Dialogue: 0,0:32:09.09,0:32:10.09,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:32:10.21,0:32:13.01,Default,,0,0,0,,Оның қимылдарында заңдылық жоқ деп ойлау керек.
Dialogue: 0,0:32:13.80,0:32:15.68,Default,,0,0,0,,Сондай-ақ, мұндай адам ...
Dialogue: 0,0:32:16.55,0:32:18.81,Default,,0,0,0,,Сол және оң жақ ені толық.
Dialogue: 0,0:32:19.27,0:32:21.06,Default,,0,0,0,,Жиі қозғалыңыз
Dialogue: 0,0:32:22.44,0:32:23.56,Default,,0,0,0,,Тей!
Dialogue: 0,0:32:24.06,0:32:24.90,Default,,0,0,0,,
Dialogue: 0,0:32:25.02,0:32:27.15,Default,,0,0,0,,Тынш!
Dialogue: 0,0:32:27.27,0:32:28.82,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:32:28.94,0:32:30.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:32:30.61,0:32:33.95,Default,,0,0,0,,Бұл 10 саны тым ерте болды.
Dialogue: 0,0:32:34.07,0:32:37.20,Default,,0,0,0,,Егер сіз тек бір қарқынды артта қалдырсаңыз, ол сізге енді жетпейді.
Dialogue: 0,0:32:37.33,0:32:40.87,Default,,0,0,0,,«Мен қателік жібердім!» «Мен қателестім!» деген сөздің көрінісі?
Dialogue: 0,0:32:42.41,0:32:43.62,Default,,0,0,0,,...
Dialogue: 0,0:32:48.34,0:32:49.67,Default,,0,0,0,,Onech! (Тендо) Цк
Dialogue: 0,0:32:52.51,0:32:53.51,Default,,0,0,0,,Ванч
Dialogue: 0,0:32:53.97,0:32:55.34,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:32:57.39,0:32:58.64,Default,,0,0,0,,Ішек
Dialogue: 0,0:32:59.64,0:33:00.81,Default,,0,0,0,,Ах
Dialogue: 0,0:33:01.02,0:33:01.85,Default,,0,0,0,,
Dialogue: 0,0:33:01.98,0:33:04.56,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:33:04.69,0:33:07.77,Default,,0,0,0,,Енді бұл қолөнер! Ақымақ!
Dialogue: 0,0:33:07.90,0:33:11.78,Default,,0,0,0,,Үйленген неке болса, әйелмен жаса!
Dialogue: 0,0:33:12.57,0:33:12.90,Default,,0,0,0,,Екеуміз соқтығыссақ та, бара бер, ақымақ!
Dialogue: 0,0:33:12.90,0:33:15.32,Default,,0,0,0,,Екеуміз соқтығыссақ та, бара бер, ақымақ!
Dialogue: 0,0:33:12.90,0:33:15.32,Default,,0,0,0,,Директор Они шықты
Dialogue: 0,0:33:15.32,0:33:15.45,Default,,0,0,0,,Екеуміз соқтығыссақ та, бара бер, ақымақ!
Dialogue: 0,0:33:15.45,0:33:16.49,Default,,0,0,0,,Екеуміз соқтығыссақ та, бара бер, ақымақ!
Dialogue: 0,0:33:15.45,0:33:16.49,Default,,0,0,0,,Бүгін тыныш болады деп ойладым.
Dialogue: 0,0:33:16.49,0:33:17.95,Default,,0,0,0,,Бүгін тыныш болады деп ойладым.
Dialogue: 0,0:33:18.07,0:33:21.91,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:33:22.37,0:33:24.12,Default,,0,0,0,,
Dialogue: 0,0:33:24.66,0:33:26.54,Default,,0,0,0,,Шуга Нейсер!
Dialogue: 0,0:33:27.88,0:33:29.04,Default,,0,0,0,,Шион Мэй!
Dialogue: 0,0:33:30.00,0:33:30.84,Default,,0,0,0,,Уф
Dialogue: 0,0:33:33.21,0:33:34.63,Default,,0,0,0,,Олар бізден озып кету үшін қиып өтті ме?
Dialogue: 0,0:33:35.01,0:33:36.34,Default,,0,0,0,,бастап...
Dialogue: 0,0:33:36.63,0:33:38.80,Default,,0,0,0,,Синхрондалған шабуыл!
Dialogue: 0,0:33:40.18,0:33:41.39,Default,,0,0,0,,Тей!
Dialogue: 0,0:33:41.51,0:33:42.35,Default,,0,0,0,,
Dialogue: 0,0:33:42.60,0:33:45.06,Default,,0,0,0,,Тыныш! (Сугавара) Керемет Кагеяма!
Dialogue: 0,0:33:45.44,0:33:47.48,Default,,0,0,0,,Хмм, бұл ыңғайсыз!
Dialogue: 0,0:33:47.60,0:33:49.94,Default,,0,0,0,,Немеремнің буынынан кейін де өзгермейді.
Dialogue: 0,0:33:50.06,0:33:54.03,Default,,0,0,0,,А, Карасуноның жаттықтырушысы Карасуно-сенсейдің немересі болатын.
Dialogue: 0,0:33:54.28,0:33:55.57,Default,,0,0,0,,Уйо…
Dialogue: 0,0:33:55.70,0:34:00.32,Default,,0,0,0,,Мен әрқашан жаңа нәрселер күш деп есептедім.
Dialogue: 0,0:34:00.45,0:34:03.04,Default,,0,0,0,,Оны ұнатпайтын адам.
Dialogue: 0,0:34:03.66,0:34:06.96,Default,,0,0,0,,Бұл ұғымдар шайқасы.
Dialogue: 0,0:34:07.83,0:34:10.71,Default,,0,0,0,,Уё бұрыннан бар.
Dialogue: 0,0:34:11.21,0:34:12.63,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:34:12.75,0:34:15.09,Default,,0,0,0,,Жоғары сынып оқушысының қазіргі жағдайы
Dialogue: 0,0:34:16.21,0:34:18.51,Default,,0,0,0,,Кім күшті екенін қараңыз!
Dialogue: 0,0:34:19.93,0:34:23.93,Default,,0,0,0,,Сіз бұрынғыдай жақсы көрінесіз, Вашишо-сенсей.
Dialogue: 0,0:34:24.06,0:34:24.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:26.85,0:34:27.81,Default,,0,0,0,,Ha
Dialogue: 0,0:34:28.31,0:34:29.77,Default,,0,0,0,,Чивас!
Dialogue: 0,0:34:30.35,0:34:34.11,Default,,0,0,0,,Ол қорқынышты ескі жаттықтырушы, Уёның атасы.
Dialogue: 0,0:34:34.23,0:34:35.73,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:34:36.19,0:34:37.44,Default,,0,0,0,,Хмф! (Сугавара) Уф
Dialogue: 0,0:34:37.57,0:34:38.90,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:34:40.03,0:34:43.74,Default,,0,0,0,,Ваши мырза ешқашан өзгерген емес.
Dialogue: 0,0:34:43.87,0:34:45.75,Default,,0,0,0,,Қарапайым - ең жақсы
Dialogue: 0,0:34:45.87,0:34:49.71,Default,,0,0,0,,Биіктік пен қуатты сүйіңіз, антеннаңызды әрқашан жоғары ұстаңыз
Dialogue: 0,0:34:49.83,0:34:52.38,Default,,0,0,0,,Мықты ойыншыларды тауып, жинаңыз
Dialogue: 0,0:34:53.46,0:34:57.13,Default,,0,0,0,,Сөзбе-сөз Ушидзима сияқты негізгі ойыншының айналасында орналасқан.
Dialogue: 0,0:34:57.26,0:34:59.05,Default,,0,0,0,,Оларға кедергі жасамаңыз...
Dialogue: 0,0:35:00.30,0:35:01.14,Default,,0,0,0,,
Dialogue: 0,0:35:01.72,0:35:04.68,Default,,0,0,0,,Менің ойымша, бұл Шираторизаваның стилі.
Dialogue: 0,0:35:08.89,0:35:10.65,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:35:10.77,0:35:16.86,Default,,0,0,0,,♪ Сіз не істедіңіз? Жүрегіңді маған бер
Dialogue: 0,0:35:17.44,0:35:20.28,Default,,0,0,0,,♪ Бөлшектерге бөліңіз!
Dialogue: 0,0:35:20.61,0:35:22.24,Default,,0,0,0,,Қый!
Dialogue: 0,0:35:24.49,0:35:25.70,Default,,0,0,0,,Блок?
Dialogue: 0,0:35:25.95,0:35:28.70,Default,,0,0,0,,♪ Рух
Dialogue: 0,0:35:30.04,0:35:31.83,Default,,0,0,0,,Куу…
Dialogue: 0,0:35:32.33,0:35:33.92,Default,,0,0,0,,Тәртіп жоқ
Dialogue: 0,0:35:34.13,0:35:36.00,Default,,0,0,0,,Көзілдірікті бала
Dialogue: 0,0:35:37.80,0:35:39.88,Default,,0,0,0,,Менің күмәнім бар.
Dialogue: 0,0:35:40.47,0:35:42.47,Default,,0,0,0,,Неге сонша тырысып жатырсың?
Dialogue: 0,0:35:43.22,0:35:46.47,Default,,0,0,0,,Волейбол – бұл жай ғана клубтық жұмыс, ол болашақта сіздің түйіндемеңізде болады.
Dialogue: 0,0:35:46.60,0:35:48.64,Default,,0,0,0,,«Мен студент кезімде үйірме жұмыстарында көп жұмыс істедім».
Dialogue: 0,0:35:48.77,0:35:50.85,Default,,0,0,0,,Бұл туралы жазудың қажеті жоқ па?
Dialogue: 0,0:35:51.48,0:35:54.69,Default,,0,0,0,,Цукишима-кун, сен волейбол ойнағанды ​​ұнатасың ба?
Dialogue: 0,0:35:57.65,0:35:59.07,Default,,0,0,0,,Жоқ, әсіресе...
Dialogue: 0,0:35:59.19,0:36:01.65,Default,,0,0,0,,Бұл сіздің сорғыш болғандықтан емес пе?
Dialogue: 0,0:36:01.78,0:36:02.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:36:04.82,0:36:05.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:06.41,0:36:10.87,Default,,0,0,0,,Болашақ ше, келесі ойында жеңе аламын ба, т.б.
Dialogue: 0,0:36:11.00,0:36:12.71,Default,,0,0,0,,Бұл қазір маңызды емес
Dialogue: 0,0:36:13.37,0:36:15.92,Default,,0,0,0,,Алдымдағы затты жою үшін...
Dialogue: 0,0:36:16.42,0:36:21.38,Default,,0,0,0,,Мұның бәрі өз күшіңіздің 120% ашқан кездегі рахатқа байланысты.
Dialogue: 0,0:36:25.09,0:36:27.81,Default,,0,0,0,,Бұл менің оқиғам ғана.
Dialogue: 0,0:36:27.93,0:36:31.18,Default,,0,0,0,,Бұл барлығына қатысты емес.
Dialogue: 0,0:36:31.31,0:36:34.52,Default,,0,0,0,,Мен сіздің «жай клуб қызметі» дегенді түсінбеймін.
Dialogue: 0,0:36:34.65,0:36:36.56,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес.
Dialogue: 0,0:36:37.02,0:36:37.90,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:36:38.57,0:36:41.36,Default,,0,0,0,,Егер сол сәт келсе...
Dialogue: 0,0:36:45.20,0:36:46.03,Default,,0,0,0,,Ум...
Dialogue: 0,0:36:46.24,0:36:47.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:48.49,0:36:50.91,Default,,0,0,0,,3 блок үшін уақыт
Dialogue: 0,0:36:51.83,0:36:54.25,Default,,0,0,0,,Маған қалдыра аласыз ба?
Dialogue: 0,0:36:55.00,0:36:56.58,Default,,0,0,0,,
Dialogue: 0,0:36:57.54,0:36:58.92,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:37:00.25,0:37:01.09,Default,,0,0,0,,Ішек
Dialogue: 0,0:37:04.05,0:37:04.88,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:37:05.89,0:37:06.84,Default,,0,0,0,,Уф
Dialogue: 0,0:37:07.22,0:37:09.31,Default,,0,0,0,,Сіз бірден орнатушыны нысанаға алдыңыз.
Dialogue: 0,0:37:09.56,0:37:10.93,Default,,0,0,0,,Вакатоши!
Dialogue: 0,0:37:12.77,0:37:14.64,Default,,0,0,0,,Баяу жүріңіз
Dialogue: 0,0:37:14.77,0:37:16.35,Default,,0,0,0,,Se...
Dialogue: 0,0:37:17.90,0:37:19.44,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:37:23.65,0:37:25.36,Default,,0,0,0,,Біз бәріміз бірге отырып, бір шыныаяқ ішкен күн де болар еді.
Dialogue: 0,0:37:28.24,0:37:31.83,Default,,0,0,0,,Жиын соңында бағалы сыйлық табысталды
Dialogue: 0,0:37:31.95,0:37:33.79,Default,,0,0,0,,Әрине осылай!
Dialogue: 0,0:37:36.54,0:37:37.38,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:37:38.38,0:37:39.21,Default,,0,0,0,,
Dialogue: 0,0:37:39.34,0:37:41.55,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:37:42.67,0:37:47.30,Default,,0,0,0,,Қарсы қондырушыны алдап бұғаттаудан ләззат...
Dialogue: 0,0:37:47.43,0:37:49.26,Default,,0,0,0,,Жетістікке жету сезімін де бермеңіз.
Dialogue: 0,0:37:50.10,0:37:55.23,Default,,0,0,0,,Қайсарлықпен, табандылықпен және тапқырлықпен
Dialogue: 0,0:37:55.64,0:37:57.19,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:37:59.94,0:38:01.65,Default,,0,0,0,,Тегін емес
Dialogue: 0,0:38:01.82,0:38:02.65,Default,,0,0,0,,Tsk
Dialogue: 0,0:38:03.23,0:38:05.40,Default,,0,0,0,,Қысым, кернеу...
Dialogue: 0,0:38:06.28,0:38:07.28,Default,,0,0,0,,Беруді жалғастырыңыз
Dialogue: 0,0:38:08.11,0:38:08.95,Default,,0,0,0,,...
Dialogue: 0,0:38:09.12,0:38:10.83,Default,,0,0,0,,Кугг…
Dialogue: 0,0:38:13.12,0:38:15.12,Default,,0,0,0,,Қосылыңыз!
Dialogue: 0,0:38:19.25,0:38:20.38,Default,,0,0,0,,Эй!
Dialogue: 0,0:38:21.17,0:38:22.09,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:38:22.21,0:38:23.30,Default,,0,0,0,,
Dialogue: 0,0:38:23.75,0:38:25.30,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:38:28.13,0:38:28.97,Default,,0,0,0,,
Dialogue: 0,0:38:29.09,0:38:30.55,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:39:23.40,0:39:24.23,Default,,0,0,0,,Ушидзима мырза!
Dialogue: 0,0:39:26.36,0:39:27.69,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:39:28.28,0:39:29.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:39:29.90,0:39:31.36,Default,,0,0,0,,Бағдарлама коды…
Dialogue: 0,0:39:31.61,0:39:33.45,Default,,0,0,0,,Хмф! (Тохо) Қайтар, қайтар!
Dialogue: 0,0:39:33.57,0:39:35.08,Default,,0,0,0,,Тория (Танака) Дайчи-сан, жақсы!
Dialogue: 0,0:39:35.91,0:39:37.45,Default,,0,0,0,,Мүмкіндік добы!
Dialogue: 0,0:39:44.63,0:39:46.84,Default,,0,0,0,,Менің спикеріме-
Dialogue: 0,0:39:47.17,0:39:49.05,Default,,0,0,0,,Жолды босат!
Dialogue: 0,0:39:50.34,0:39:51.80,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:40:13.11,0:40:14.74,Default,,0,0,0,,Ушивака тоқтады!
Dialogue: 0,0:40:14.87,0:40:16.83,Default,,0,0,0,,Бұл кім? Ол (аудитория) мен білмеймін.
Dialogue: 0,0:40:16.95,0:40:18.04,Default,,0,0,0,,Керемет!
Dialogue: 0,0:40:18.16,0:40:22.08,Default,,0,0,0,,2-топ Мен оны қайтардым!
Dialogue: 0,0:40:23.62,0:40:25.88,Default,,0,0,0,,Бір ғана блок
Dialogue: 0,0:40:26.00,0:40:28.55,Default,,0,0,0,,25 ұпайдан тек 1 ұпай
Dialogue: 0,0:40:29.42,0:40:32.43,Default,,0,0,0,,Такага клубының қызметі...
Dialogue: 0,0:40:34.14,0:40:36.22,Default,,0,0,0,,Егер сол сәт келсе...
Dialogue: 0,0:40:37.85,0:40:40.81,Default,,0,0,0,,Волейбол ойынына ілінген сәт.
Dialogue: 0,0:40:40.81,0:40:42.48,Default,,0,0,0,,Волейбол ойынына ілінген сәт.
Dialogue: 0,0:40:40.81,0:40:42.48,Default,,0,0,0,,Неге олай? Өте суықсың ғой.
Dialogue: 0,0:40:42.48,0:40:44.90,Default,,0,0,0,,Неге олай? Өте суықсың ғой.
Dialogue: 0,0:40:46.56,0:40:48.98,Default,,0,0,0,,Цукишима!
Dialogue: 0,0:40:49.11,0:40:49.94,Default,,0,0,0,,I… Ita
Dialogue: 0,0:40:50.19,0:40:52.40,Default,,0,0,0,,Ағымдағы Ушивака секірулері
Dialogue: 0,0:40:52.53,0:40:54.86,Default,,0,0,0,,Жүгіруге де, секіруге де уақытым болмады.
Dialogue: 0,0:40:55.53,0:40:58.41,Default,,0,0,0,,Жоқ, күттіңіз бе?
Dialogue: 0,0:41:00.08,0:41:01.20,Default,,0,0,0,,Цукишима!
Dialogue: 0,0:41:05.75,0:41:08.38,Default,,0,0,0,,«100-ден 1 ұпай»
Dialogue: 0,0:41:13.80,0:41:14.84,Default,,0,0,0,,Куру мырза
Dialogue: 0,0:41:14.97,0:41:17.26,Default,,0,0,0,,Бұл Куру-сан болса, бұл не болды...
Dialogue: 0,0:41:17.39,0:41:18.93,Default,,0,0,0,,Ушивакамару?
Dialogue: 0,0:41:19.05,0:41:20.47,Default,,0,0,0,,Оны тоқтатуға бола ма?
Dialogue: 0,0:41:20.60,0:41:22.64,Default,,0,0,0,,Ушивака!
Dialogue: 0,0:41:22.89,0:41:24.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:24.52,0:41:28.61,Default,,0,0,0,,Сіз 10-нан 1-ге жуық тоқтай алмайсыз, солай ма?
Dialogue: 0,0:41:30.65,0:41:31.73,Default,,0,0,0,,Не ол?
Dialogue: 0,0:41:31.86,0:41:34.78,Default,,0,0,0,,Қарсылас не болып жатқанын білетін Бокутодан ерекшеленеді.
Dialogue: 0,0:41:34.90,0:41:36.82,Default,,0,0,0,,Мен шынымды айттым.
Dialogue: 0,0:41:37.32,0:41:41.20,Default,,0,0,0,,Қарсыласыңды 100% жеңу мүмкін емес, солай ма?
Dialogue: 0,0:41:41.33,0:41:44.75,Default,,0,0,0,,Кейде бұл бір бөлік тек бір нүкте болып табылады.
Dialogue: 0,0:41:44.87,0:41:48.96,Default,,0,0,0,,Уақытқа байланысты бұл жағдайды өзгертетін нүкте болуы мүмкін.
Dialogue: 0,0:41:49.25,0:41:51.17,Default,,0,0,0,,Команда толқыған кезде...
Dialogue: 0,0:41:51.30,0:41:55.42,Default,,0,0,0,,Немесе шарасыз жағдайда мүмкіндік жасаңыз.
Dialogue: 0,0:41:55.55,0:42:00.51,Default,,0,0,0,,Егер сіз оны жинай алсаңыз, бұл 100-ден 1 ұпайға жетеді...
Dialogue: 0,0:42:00.64,0:42:03.60,Default,,0,0,0,,1 ұпай болса, 100 ұпай қанша болады?
Dialogue: 0,0:42:03.89,0:42:05.98,Default,,0,0,0,,Мен де сенің айтқаныңды түсіне бастадым.
Dialogue: 0,0:42:06.19,0:42:08.31,Default,,0,0,0,,Көрдім, Куру ақымақ екен.
Dialogue: 0,0:42:08.44,0:42:11.32,Default,,0,0,0,,Адамдар мені ақымақ деп атағанын қаламаймын.
Dialogue: 0,0:42:08.44,0:42:11.32,Default,,0,0,0,,Жақсы әңгіме екен деп ойлап, тыңдадым.
Dialogue: 0,0:42:11.32,0:42:11.61,Default,,0,0,0,,Жақсы әңгіме екен деп ойлап, тыңдадым.
Dialogue: 0,0:42:11.90,0:42:12.23,Default,,0,0,0,,Бірақ бір нүкте бір ғана нүкте, солай емес пе?
Dialogue: 0,0:42:12.23,0:42:14.53,Default,,0,0,0,,Бірақ бір нүкте бір ғана нүкте, солай емес пе?
Dialogue: 0,0:42:12.23,0:42:14.53,Default,,0,0,0,,«Идиот» дегеннен гөрі «Идиот» деген дұрыс.
Dialogue: 0,0:42:14.53,0:42:14.65,Default,,0,0,0,,Бірақ бір нүкте бір ғана нүкте, солай емес пе?
Dialogue: 0,0:42:14.65,0:42:15.32,Default,,0,0,0,,Бірақ бір нүкте бір ғана нүкте, солай емес пе?
Dialogue: 0,0:42:14.65,0:42:15.32,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:42:15.44,0:42:16.45,Default,,0,0,0,,Фу…
Dialogue: 0,0:42:15.44,0:42:16.45,Default,,0,0,0,,Желудің биіктігін салыстыру сияқты сөздерді айтпа.
Dialogue: 0,0:42:16.45,0:42:17.03,Default,,0,0,0,,Желудің биіктігін салыстыру сияқты сөздерді айтпа.
Dialogue: 0,0:42:17.03,0:42:17.78,Default,,0,0,0,,Желудің биіктігін салыстыру сияқты сөздерді айтпа.
Dialogue: 0,0:42:17.03,0:42:17.78,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:42:17.78,0:42:17.91,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:42:17.91,0:42:18.99,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:42:17.91,0:42:18.99,Default,,0,0,0,,Жақсы араласайық
Dialogue: 0,0:42:19.11,0:42:20.91,Default,,0,0,0,,Ең үлкен ақымақ болма!
Dialogue: 0,0:42:21.03,0:42:23.33,Default,,0,0,0,,Идиот! (Хайбане) №1 Хината.
Dialogue: 0,0:42:23.45,0:42:24.54,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:42:29.42,0:42:30.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:36.26,0:42:38.88,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:42:39.97,0:42:42.39,Default,,0,0,0,,Кеттік (Шираторизава қолдау көрсету тобы) Кеттік
Dialogue: 0,0:42:42.51,0:42:44.93,Default,,0,0,0,,Кеттік (Шираторизава қолдау көрсету тобы) Кеттік
Dialogue: 0,0:42:45.14,0:42:47.56,Default,,0,0,0,,Карасуно орта мектебі! (Shiratorizawa Cheer Team) Карасуно орта мектебі!
Dialogue: 0,0:42:47.69,0:42:50.06,Default,,0,0,0,,Карасуно орта мектебі! (Shiratorizawa Cheer Team) Карасуно орта мектебі!
Dialogue: 0,0:42:50.19,0:42:52.31,Default,,0,0,0,,Танысқаныма қуаныштымын! (Shiratorizawa Cheer Team) Танысқаныма қуаныштымын...
Dialogue: 0,0:42:52.44,0:42:53.48,Default,,0,0,0,,О
Dialogue: 0,0:42:53.61,0:42:55.57,Default,,0,0,0,,Егер сіз осылай қозғалсаңыз...
Dialogue: 0,0:42:56.03,0:43:00.03,Default,,0,0,0,,Мен оны қабылдауға және блоктауға шебер болуы керек деп ойладым.
Dialogue: 0,0:43:01.78,0:43:06.29,Default,,0,0,0,,Бойыңыз бойынша жарыса алмасаңыз, техникаңыз да нашар болса, не істей аласыз?
Dialogue: 0,0:43:06.70,0:43:08.96,Default,,0,0,0,,Гах!
Dialogue: 0,0:43:09.08,0:43:12.84,Default,,0,0,0,,«Балалық, балалық және жетілмеген».
Dialogue: 0,0:43:12.96,0:43:14.67,Default,,0,0,0,,Жарайсың ба? (Хината) Жарайды.
Dialogue: 0,0:43:14.80,0:43:18.22,Default,,0,0,0,,Агага... аа...
Dialogue: 0,0:43:18.34,0:43:20.76,Default,,0,0,0,,Шираторизава!
Dialogue: 0,0:43:21.55,0:43:22.55,Default,,0,0,0,,Ширатори…
Dialogue: 0,0:43:22.68,0:43:24.72,Default,,0,0,0,,Отырыңыз, демалыңыз!
Dialogue: 0,0:43:25.89,0:43:31.44,Default,,0,0,0,,Финалдың атмосферасы мен Шираторизавадағы зеңбіректерге үйреніп қалған шығарсыз.
Dialogue: 0,0:43:32.06,0:43:34.86,Default,,0,0,0,,Істеп жатқан ісіңізде негізінен ештеңе жоқ.
Dialogue: 0,0:43:34.98,0:43:36.07,Default,,0,0,0,,Жоғалмаңыз
Dialogue: 0,0:43:36.65,0:43:40.90,Default,,0,0,0,,Жеңіске жету жолы - шабуылда да, қорғаныста да сандық артықшылық жасау.
Dialogue: 0,0:43:41.03,0:43:42.20,Default,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:43:42.32,0:43:43.16,Default,,0,0,0,,Дегенмен, менің ойымша, бұл жақсы жоспар.
Dialogue: 0,0:43:43.28,0:43:45.74,Default,,0,0,0,,
Dialogue: 0,0:43:47.41,0:43:48.95,Default,,0,0,0,,Түсіндім, Хината.
Dialogue: 0,0:43:49.08,0:43:52.29,Default,,0,0,0,,Ушивака жиындар арасында бірдеңе айтты ма?
Dialogue: 0,0:43:52.42,0:43:53.83,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:43:54.17,0:43:57.34,Default,,0,0,0,,Құлақ жігіттің өмір сүруге құқығы жоқ.
Dialogue: 0,0:43:57.46,0:43:58.67,Default,,0,0,0,,Меніңше...
Dialogue: 0,0:43:58.80,0:44:02.05,Default,,0,0,0,,Шынымен, паранойя? Кіріңізші, өтінемін?
Dialogue: 0,0:44:02.47,0:44:04.89,Default,,0,0,0,,Семантикалық тұрғыдан алғанда, иә.
Dialogue: 0,0:44:05.01,0:44:07.97,Default,,0,0,0,,Хината бұлай айтса не істер екен деп ойлаймын.
Dialogue: 0,0:44:08.10,0:44:10.06,Default,,0,0,0,,Күлесің бе?
Dialogue: 0,0:44:10.18,0:44:11.35,Default,,0,0,0,,Жоқ, себебі-
Dialogue: 0,0:44:12.14,0:44:16.40,Default,,0,0,0,,Осыны айтып ренжіп қалатын адам болсаң, қазір келме.
Dialogue: 0,0:44:16.52,0:44:17.82,Default,,0,0,0,,
Dialogue: 0,0:44:22.66,0:44:23.95,Default,,0,0,0,,Арасында! Жақсы нүкте!
Dialogue: 0,0:44:25.87,0:44:27.53,Default,,0,0,0,,Кешіріңіз, қысқа болды
Dialogue: 0,0:44:27.87,0:44:29.12,Default,,0,0,0,,Охира мырза!
Dialogue: 0,0:44:29.50,0:44:30.50,Default,,0,0,0,,О, сұмдық
Dialogue: 0,0:44:31.16,0:44:32.96,Default,,0,0,0,,Мен қызғаншақпын
Dialogue: 0,0:44:33.08,0:44:35.25,Default,,0,0,0,,Мен қызғанамын, бірақ...
Dialogue: 0,0:44:35.79,0:44:37.38,Default,,0,0,0,,Жоқ! Бұл блок болса да ...
Dialogue: 0,0:44:38.05,0:44:41.47,Default,,0,0,0,,Дәл ұшқынның ұшып кетуі сияқты
Dialogue: 0,0:44:42.59,0:44:44.09,Default,,0,0,0,,Жүгіру жолы.
Dialogue: 0,0:44:44.43,0:44:46.72,Default,,0,0,0,,Жасанды қанаттар
Dialogue: 0,0:44:50.31,0:44:51.52,Default,,0,0,0,,Хмф!
Dialogue: 0,0:44:51.98,0:44:53.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:54.27,0:44:55.15,Default,,0,0,0,,
Dialogue: 0,0:44:55.27,0:44:58.44,Default,,0,0,0,,Ой, мен оны тоқтаттым!
Dialogue: 0,0:44:58.82,0:45:00.28,Default,,0,0,0,,Мен қызғанамын...
Dialogue: 0,0:45:01.36,0:45:03.53,Default,,0,0,0,,Бойына қарап жарыспа
Dialogue: 0,0:45:03.74,0:45:05.41,Default,,0,0,0,,Мен олай айтқан жоқпын!
Dialogue: 0,0:45:08.08,0:45:10.20,Default,,0,0,0,,Не, сондасың ба?
Dialogue: 0,0:45:10.49,0:45:11.50,Default,,0,0,0,,Ах
Dialogue: 0,0:45:11.62,0:45:15.37,Default,,0,0,0,,Бармаймын дедіңіз, себебі кім жеңсе де ренжіп қаласыз.
Dialogue: 0,0:45:15.71,0:45:19.67,Default,,0,0,0,,Кім жеңсе де, оның жеңілген жағын көре аласыз.
Dialogue: 0,0:45:19.80,0:45:21.34,Default,,0,0,0,,Сен бөтен жігітсің.
Dialogue: 0,0:45:21.46,0:45:24.22,Default,,0,0,0,,Мен жалқау болғым келмейді.
Dialogue: 0,0:45:24.51,0:45:28.43,Default,,0,0,0,,Сонда да 10 санының импульсі бірдей.
Dialogue: 0,0:45:29.10,0:45:31.52,Default,,0,0,0,,Бұл, әрине, құбыжық.
Dialogue: 0,0:45:32.02,0:45:35.48,Default,,0,0,0,,Бірақ сол құбыжықпен кездескендерге келсек...
Dialogue: 0,0:45:35.60,0:45:36.94,Default,,0,0,0,,Бұл мен жинаған нәрсе емес.
Dialogue: 0,0:45:37.06,0:45:38.48,Default,,0,0,0,,
Dialogue: 0,0:45:39.15,0:45:42.44,Default,,0,0,0,,Секірудің төбесі Секірудің төбесі Секірудің шыңы...
Dialogue: 0,0:45:42.57,0:45:44.15,Default,,0,0,0,,Жоғары!
Dialogue: 0,0:45:45.90,0:45:48.03,Default,,0,0,0,,Алдыңғы Алдыңғы! (Савамура) Хмф!
Dialogue: 0,0:45:48.16,0:45:49.24,Default,,0,0,0,,Солға!
Dialogue: 0,0:45:50.20,0:45:50.99,Default,,0,0,0,,Тей!
Dialogue: 0,0:45:51.41,0:45:52.24,Default,,0,0,0,,Onech!
Dialogue: 0,0:45:52.54,0:45:54.12,Default,,0,0,0,,Мүмкіндік добы!
Dialogue: 0,0:45:55.21,0:45:56.04,Default,,0,0,0,,Вакатоши-кун!
Dialogue: 0,0:45:56.92,0:45:58.50,Default,,0,0,0,,Хината кел
Dialogue: 0,0:45:59.33,0:46:00.21,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,0:46:00.84,0:46:01.96,Default,,0,0,0,,Қолдау!
Dialogue: 0,0:46:03.01,0:46:04.17,Default,,0,0,0,,Тей!
Dialogue: 0,0:46:05.97,0:46:07.89,Default,,0,0,0,,Бір рет түрту!
Dialogue: 0,0:46:08.09,0:46:09.34,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:46:11.64,0:46:13.56,Default,,0,0,0,,Бұл екінші жағы ма?
Dialogue: 0,0:46:13.81,0:46:14.98,Default,,0,0,0,,Ә? Бөлме…
Dialogue: 0,0:46:20.77,0:46:21.61,Default,,0,0,0,,
Dialogue: 0,0:46:21.94,0:46:23.82,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:46:24.49,0:46:26.28,Default,,0,0,0,,Танака: Керемет қолдау!
Dialogue: 0,0:46:29.99,0:46:30.95,Default,,0,0,0,,5 7 5!
Dialogue: 0,0:46:31.07,0:46:33.66,Default,,0,0,0,,Карасуно үзіліс!
Dialogue: 0,0:46:33.95,0:46:37.33,Default,,0,0,0,,Менің шынтағым жалпы төмен түсіп жатыр!
Dialogue: 0,0:46:37.46,0:46:39.88,Default,,0,0,0,,Жарып өте алсаң да, жарып өте алмайсың!
Dialogue: 0,0:46:40.38,0:46:44.96,Default,,0,0,0,,Оның үлкен фигурасы бар, сондықтан оны осылай істеу керек ...
Dialogue: 0,0:46:45.09,0:46:47.09,Default,,0,0,0,,Динамикалық? (Ваши Такуми) Иә!
Dialogue: 0,0:46:47.97,0:46:52.97,Default,,0,0,0,,Хмм, Карасуноның қорғанысы матч барысында дамиды.
Dialogue: 0,0:46:53.10,0:46:56.14,Default,,0,0,0,,Гарнирленген пышақ болса да.
Dialogue: 0,0:46:56.27,0:46:57.27,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:46:57.39,0:47:00.19,Default,,0,0,0,,Тесіксіз қорғаныс болмайды.
Dialogue: 0,0:47:01.86,0:47:03.65,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:47:03.77,0:47:07.57,Default,,0,0,0,,Жеке физикалық қабілеттілік биіктігі мен күші
Dialogue: 0,0:47:07.74,0:47:12.07,Default,,0,0,0,,Егер бұл күштің жалғыз дәлелі болса, ойын оңайырақ болар еді.
Dialogue: 0,0:47:12.53,0:47:13.62,Default,,0,0,0,,Бірақ-
Dialogue: 0,0:47:13.74,0:47:18.71,Default,,0,0,0,,Ол болмағандықтан, ол терең, ал ол болмағандықтан ол қызықты.
Dialogue: 0,0:47:18.91,0:47:20.37,Default,,0,0,0,,
Dialogue: 0,0:47:20.83,0:47:24.13,Default,,0,0,0,,Бұл жолы мен сізге мүмкіндік беремін!
Dialogue: 0,0:47:29.72,0:47:30.80,Default,,0,0,0,,Бұрынғы желіге қосылу!
Dialogue: 0,0:47:30.93,0:47:32.09,Default,,0,0,0,,Мен қарсыласымды өлтіру үшін келген жоқпын
Dialogue: 0,0:47:36.31,0:47:37.22,Default,,0,0,0,,Кеттік
Dialogue: 0,0:47:37.35,0:47:39.39,Default,,0,0,0,,Сено…
Dialogue: 0,0:47:44.19,0:47:45.15,Default,,0,0,0,,Ә? Бөлме…
Dialogue: 0,0:47:50.28,0:47:51.11,Default,,0,0,0,,
Dialogue: 0,0:47:51.24,0:47:53.12,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:47:53.32,0:47:56.41,Default,,0,0,0,,Мақсатты бос орын
Dialogue: 0,0:47:56.54,0:48:00.33,Default,,0,0,0,,Сонда да, Кагеяма, мен оны алдым деп ойладым.
Dialogue: 0,0:48:00.91,0:48:05.38,Default,,0,0,0,,Бұл шабуылды 10 санының ақылсыз қозғалысымен орнатыңыз.
Dialogue: 0,0:48:05.50,0:48:08.42,Default,,0,0,0,,Матчтың басынан бастап оны әдеттегідей сақтаңыз.
Dialogue: 0,0:48:08.92,0:48:13.05,Default,,0,0,0,,Ойын барысында допты басқаларға қарағанда көбірек ұстаңыз
Dialogue: 0,0:48:13.80,0:48:17.26,Default,,0,0,0,,Бәлкім, сол жерде ең бірінші шегі жеткен шығар.
Dialogue: 0,0:48:20.43,0:48:21.39,Default,,0,0,0,,
Dialogue: 0,0:48:21.85,0:48:23.35,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:48:29.03,0:48:30.15,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:48:30.28,0:48:31.11,Default,,0,0,0,,
Dialogue: 0,0:48:31.24,0:48:33.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:48:34.28,0:48:36.03,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:48:36.16,0:48:39.12,Default,,0,0,0,,(құлаған дыбыс)
Dialogue: 0,0:48:45.38,0:48:46.59,Default,,0,0,0,,
Dialogue: 0,0:48:52.34,0:48:53.97,Default,,0,0,0,,Нишитани!
Dialogue: 0,0:48:54.38,0:48:55.22,Default,,0,0,0,,Тей!
Dialogue: 0,0:48:56.97,0:48:59.35,Default,,0,0,0,,Боқ жын қызмет етеді
Dialogue: 0,0:49:02.56,0:49:04.90,Default,,0,0,0,,Тынш!
Dialogue: 0,0:49:05.02,0:49:07.11,Default,,0,0,0,,Алдын алды! (Айхара) Ия!
Dialogue: 0,0:49:07.23,0:49:09.69,Default,,0,0,0,,Шуга жақсырақ!
Dialogue: 0,0:49:10.94,0:49:12.32,Default,,0,0,0,,Шион Мэй!
Dialogue: 0,0:49:15.78,0:49:17.41,Default,,0,0,0,,Керемет қабыл алыңыздар!
Dialogue: 0,0:49:18.16,0:49:20.16,Default,,0,0,0,,Әдемі пішін...
Dialogue: 0,0:49:20.49,0:49:21.70,Default,,0,0,0,,Бұл тәртіпсіз!
Dialogue: 0,0:49:24.21,0:49:25.33,Default,,0,0,0,,На
Dialogue: 0,0:49:25.75,0:49:27.25,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:49:27.38,0:49:28.21,Default,,0,0,0,,
Dialogue: 0,0:49:28.34,0:49:29.96,Default,,0,0,0,,Не! (Тендо) Цк
Dialogue: 0,0:49:30.50,0:49:31.96,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:49:32.42,0:49:36.13,Default,,0,0,0,,Бар, жүр, Карасуно! Итер, Карасуно!
Dialogue: 0,0:49:41.56,0:49:42.93,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:49:43.06,0:49:44.06,Default,,0,0,0,,
Dialogue: 0,0:49:49.15,0:49:49.98,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:49:50.19,0:49:51.94,Default,,0,0,0,,Бұрын! (Ямагата) Хмф!
Dialogue: 0,0:49:52.07,0:49:53.74,Default,,0,0,0,,Мүмкіндік добы!
Dialogue: 0,0:49:58.41,0:49:59.87,Default,,0,0,0,,Қысқа!
Dialogue: 0,0:50:07.04,0:50:09.00,Default,,0,0,0,,Дене оңға қарай ағып жатыр...
Dialogue: 0,0:50:09.71,0:50:11.21,Default,,0,0,0,,Сол қол
Dialogue: 0,0:50:20.22,0:50:22.56,Default,,0,0,0,,
Dialogue: 0,0:50:22.89,0:50:25.60,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:50:26.48,0:50:29.56,Default,,0,0,0,,Маған бірдеңе болды...
Dialogue: 0,0:50:31.48,0:50:33.32,Default,,0,0,0,,Жақсы мұқаба…
Dialogue: 0,0:50:33.44,0:50:35.65,Default,,0,0,0,,Әдемі жүзді киіңіз
Dialogue: 0,0:50:36.53,0:50:38.16,Default,,0,0,0,,Оның орнына, Кагеяма.
Dialogue: 0,0:50:38.28,0:50:39.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:50:40.07,0:50:43.41,Default,,0,0,0,,Мен тағы бір жиын жасай аламын!
Dialogue: 0,0:50:45.45,0:50:46.62,Default,,0,0,0,,О
Dialogue: 0,0:50:47.41,0:50:52.29,Default,,0,0,0,,♪ Шира Тори Зава Шира Тори Зава
Dialogue: 0,0:50:47.41,0:50:52.29,Default,,0,0,0,,♪ Бар, жүр, Карасуно, итер, итер, Карасуно
Dialogue: 0,0:50:53.67,0:50:55.21,Default,,0,0,0,,Қорытынды жиын
Dialogue: 0,0:50:55.71,0:50:58.34,Default,,0,0,0,,Мен Сугаварадан бастайын деп ойлаймын.
Dialogue: 0,0:50:58.63,0:50:59.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:51:00.89,0:51:02.14,Default,,0,0,0,,Өтінемін, Сугавара!
Dialogue: 0,0:51:00.89,0:51:02.14,Default,,0,0,0,,Жарайды, қобалжатын ештеңе жоқ.
Dialogue: 0,0:51:02.14,0:51:02.26,Default,,0,0,0,,Жарайды, қобалжатын ештеңе жоқ.
Dialogue: 0,0:51:02.26,0:51:04.10,Default,,0,0,0,,Жарайды, қобалжатын ештеңе жоқ.
Dialogue: 0,0:51:02.26,0:51:04.10,Default,,0,0,0,,Сугавара мырза, бар күшіңізді салыңыз.
Dialogue: 0,0:51:04.22,0:51:04.85,Default,,0,0,0,,Бір шымшып кірген кездерім болды.
Dialogue: 0,0:51:04.85,0:51:05.68,Default,,0,0,0,,Бір шымшып кірген кездерім болды.
Dialogue: 0,0:51:04.85,0:51:05.68,Default,,0,0,0,,Шуга-сан
Dialogue: 0,0:51:05.68,0:51:05.81,Default,,0,0,0,,Бір шымшып кірген кездерім болды.
Dialogue: 0,0:51:05.81,0:51:07.02,Default,,0,0,0,,Бір шымшып кірген кездерім болды.
Dialogue: 0,0:51:05.81,0:51:07.02,Default,,0,0,0,,Маған қатты лақтырыңыз.
Dialogue: 0,0:51:07.02,0:51:07.60,Default,,0,0,0,,Маған қатты лақтырыңыз.
Dialogue: 0,0:51:07.81,0:51:09.10,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:51:09.44,0:51:12.52,Default,,0,0,0,,Денем жылы, бірақ қолым суық.
Dialogue: 0,0:51:15.19,0:51:16.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:16.19,0:51:17.03,Default,,0,0,0,,Ах
Dialogue: 0,0:51:20.36,0:51:21.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:22.91,0:51:23.99,Default,,0,0,0,,Ha
Dialogue: 0,0:51:25.45,0:51:27.45,Default,,0,0,0,,Ке... неке күту керек!
Dialogue: 0,0:51:27.58,0:51:31.21,Default,,0,0,0,,Жарайды, мен Сугавараға үйленемін деген ойым жоқ.
Dialogue: 0,0:51:31.33,0:51:32.67,Default,,0,0,0,,Сіз мұны түсінбейсіз.
Dialogue: 0,0:51:33.29,0:51:36.25,Default,,0,0,0,,Кагеяма: Мен шаршадым.
Dialogue: 0,0:51:36.38,0:51:41.22,Default,,0,0,0,,Бұл оны аздап тынығуға мүмкіндік беріп, содан кейін оны маңызды жерлерде қайта қолдану сияқты ма?
Dialogue: 0,0:51:41.34,0:51:43.64,Default,,0,0,0,,Оған дейін мен оған дейін күтуім керек.
Dialogue: 0,0:51:44.39,0:51:47.72,Default,,0,0,0,,Савайака, саған жүк тым ауыр емес пе?
Dialogue: 0,0:51:50.27,0:51:51.81,Default,,0,0,0,,Өтінемін, инженерия.
Dialogue: 0,0:51:51.94,0:51:53.31,Default,,0,0,0,,Келесі Эйс!
Dialogue: 0,0:51:53.44,0:51:54.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:51:54.56,0:51:56.11,Default,,0,0,0,,Мен оны бір бөлікпен кесемін!
Dialogue: 0,0:51:56.23,0:51:57.78,Default,,0,0,0,,О!
Dialogue: 0,0:52:03.20,0:52:04.28,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:52:04.57,0:52:05.53,Default,,0,0,0,,Асахи!
Dialogue: 0,0:52:06.08,0:52:07.66,Default,,0,0,0,,Хмф!
Dialogue: 0,0:52:07.91,0:52:09.25,Default,,0,0,0,,Жақсы! (Уё) Шаа!
Dialogue: 0,0:52:10.46,0:52:13.00,Default,,0,0,0,,5-ші жиын 15 ұпаймен шектелген.
Dialogue: 0,0:52:13.33,0:52:14.54,Default,,0,0,0,,​​Солай ма?
Dialogue: 0,0:52:14.67,0:52:16.88,Default,,0,0,0,,Аа, бұл өте тез өтеді.
Dialogue: 0,0:52:17.00,0:52:17.84,Default,,0,0,0,,
Dialogue: 0,0:52:19.05,0:52:21.09,Default,,0,0,0,,Асахи Ниссер!
Dialogue: 0,0:52:29.60,0:52:30.98,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:52:31.64,0:52:33.56,Default,,0,0,0,,Нишиноя!
Dialogue: 0,0:52:33.69,0:52:34.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:38.19,0:52:39.90,Default,,0,0,0,,Тегін орнатудан -
Dialogue: 0,0:52:40.57,0:52:43.07,Default,,0,0,0,,Либеродан басқа барлығы синхронды!
Dialogue: 0,0:52:43.74,0:52:44.57,Default,,0,0,0,,Уау
Dialogue: 0,0:52:44.70,0:52:45.53,Default,,0,0,0,,Tsk
Dialogue: 0,0:52:45.70,0:52:46.70,Default,,0,0,0,,Хмф!
Dialogue: 0,0:52:47.53,0:52:49.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:49.45,0:52:50.41,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:52:50.83,0:52:52.62,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:52:53.42,0:52:54.88,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:52:55.00,0:52:57.54,Default,,0,0,0,,Тіпті бір блок ізбасары да жоқ.
Dialogue: 0,0:52:57.67,0:52:59.34,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:52:59.88,0:53:02.88,Default,,0,0,0,,Карасуно, маған онша қатты шабуыл жасама.
Dialogue: 0,0:53:03.01,0:53:05.18,Default,,0,0,0,,Ах, либеро оны көтереді.
Dialogue: 0,0:53:05.30,0:53:08.56,Default,,0,0,0,,Одан басқа, мен барлығының шабуыл жасағанын бірінші рет көріп тұрмын.
Dialogue: 0,0:53:09.35,0:53:13.23,Default,,0,0,0,,Маған қазіргісі таң қалды, бірақ 10 саны ұнамайды.
Dialogue: 0,0:53:13.60,0:53:18.02,Default,,0,0,0,,10 санын ұнатпайтындықтан емес пе?
Dialogue: 0,0:53:18.15,0:53:20.19,Default,,0,0,0,,Сіз түсінбейтін нәрселер қорқынышты.
Dialogue: 0,0:53:21.15,0:53:22.07,Default,,0,0,0,,Қорқынышты емес
Dialogue: 0,0:53:22.19,0:53:25.61,Default,,0,0,0,,Жоқ, жоқ, білесің бе, мен «бірдеңе дұрыс емес» деп ойлап отырмын.
Dialogue: 0,0:53:26.20,0:53:27.87,Default,,0,0,0,,Кем дегенде «бірдеңе дұрыс емес»
Dialogue: 0,0:53:27.99,0:53:31.29,Default,,0,0,0,,Бұл сен үшін жаңа сенсация емес пе, Вакатоши?
Dialogue: 0,0:53:33.66,0:53:36.21,Default,,0,0,0,,Мен Карасуноның бірінші курс дуэті туралы қауесетті естігенде...
Dialogue: 0,0:53:37.00,0:53:38.00,Default,,0,0,0,,Мен күттім
Dialogue: 0,0:53:39.17,0:53:40.71,Default,,0,0,0,,Мен осы уақытқа дейін не кездестірдім -
Dialogue: 0,0:53:40.84,0:53:43.76,Default,,0,0,0,,Менің ойымша, олар кішірек, жақсырақ ойыншылар сияқты.
Dialogue: 0,0:53:46.13,0:53:47.68,Default,,0,0,0,,Бірақ жоқ
Dialogue: 0,0:53:49.05,0:53:49.89,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:53:52.68,0:53:54.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:53:55.48,0:53:58.40,Default,,0,0,0,,Маған бірдеңе ұнамайды
Dialogue: 0,0:54:02.03,0:54:02.86,Default,,0,0,0,,
Dialogue: 0,0:54:03.11,0:54:05.32,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:54:07.82,0:54:09.91,Default,,0,0,0,,Ушидзима мырза, жақсырақ!
Dialogue: 0,0:54:10.03,0:54:12.99,Default,,0,0,0,,Вакатоши, өтінемін, маған күшті нәрсе беріңіз!
Dialogue: 0,0:54:14.20,0:54:15.21,Default,,0,0,0,,
Dialogue: 0,0:54:18.88,0:54:20.04,Default,,0,0,0,,Хмф!
Dialogue: 0,0:54:20.34,0:54:21.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:54:21.29,0:54:22.96,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:54:23.42,0:54:24.97,Default,,0,0,0,,
Dialogue: 0,0:54:28.30,0:54:29.14,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:54:30.55,0:54:32.56,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:54:34.77,0:54:35.81,Default,,0,0,0,,
Dialogue: 0,0:54:39.31,0:54:40.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:45.07,0:54:45.94,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:54:46.44,0:54:47.28,Default,,0,0,0,,Адамдар өте оңай өліп қалады, иә?
Dialogue: 0,0:54:47.40,0:54:48.41,Default,,0,0,0,,
Dialogue: 0,0:54:50.03,0:54:51.57,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:54:52.33,0:54:55.41,Default,,0,0,0,,Цукишима негізінен ешқашан жем болмайды.
Dialogue: 0,0:54:56.16,0:54:59.71,Default,,0,0,0,,Цукисима лақтырылған жерге міндетті түрде келеді.
Dialogue: 0,0:55:00.13,0:55:05.51,Default,,0,0,0,,Сіздің алдыңызда әрқашан қабырға болуы қаншалықты жағымсыз?
Dialogue: 0,0:55:06.46,0:55:09.51,Default,,0,0,0,,Егер сіз мұны 5 жиынтықта жасай алсаңыз...
Dialogue: 0,0:55:09.72,0:55:13.93,Default,,0,0,0,,Ең сезімтал адам да қатты күйзеліске ұшырайды.
Dialogue: 0,0:55:21.77,0:55:22.77,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:55:24.07,0:55:24.90,Default,,0,0,0,,Гррр…
Dialogue: 0,0:55:25.03,0:55:25.86,Default,,0,0,0,,
Dialogue: 0,0:55:26.44,0:55:28.32,Default,,0,0,0,,Жақсы қоңырау...су?
Dialogue: 0,0:55:29.07,0:55:30.57,Default,,0,0,0,,шықты ма?
Dialogue: 0,0:55:31.24,0:55:32.24,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:55:32.37,0:55:33.74,Default,,0,0,0,,Жаса... Бұл Дон Май.
Dialogue: 0,0:55:33.99,0:55:35.79,Default,,0,0,0,,Қате? бақытты
Dialogue: 0,0:55:37.20,0:55:38.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:38.50,0:55:40.42,Default,,0,0,0,,А, қосымша шақыру?
Dialogue: 0,0:55:40.54,0:55:41.42,Default,,0,0,0,,Не?
Dialogue: 0,0:55:41.54,0:55:43.92,Default,,0,0,0,,Брок оған сәл тиіп тұрды.
Dialogue: 0,0:55:44.04,0:55:46.05,Default,,0,0,0,,Шираторизаваның ұпайы.
Dialogue: 0,0:55:46.17,0:55:47.21,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:55:47.76,0:55:50.68,Default,,0,0,0,,Бірақ бұл жақсы тренд Switch Switch!
Dialogue: 0,0:55:51.51,0:55:52.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:55:53.43,0:55:54.60,Default,,0,0,0,,Мм... (Уё) А?
Dialogue: 0,0:55:55.89,0:55:58.89,Default,,0,0,0,,Оның қолдары біртүрлі.
Dialogue: 0,0:55:59.39,0:56:01.77,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:56:03.10,0:56:04.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:56:04.77,0:56:05.69,Default,,0,0,0,,Не?
Dialogue: 0,0:56:11.24,0:56:12.20,Default,,0,0,0,,Ах
Dialogue: 0,0:56:12.32,0:56:15.62,Default,,0,0,0,,Мен Ушиваканың тырнақтарына қол тигізгенде сынып қалды.
Dialogue: 0,0:56:16.28,0:56:18.50,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:56:18.87,0:56:19.70,Default,,0,0,0,,Нарита!
Dialogue: 0,0:56:19.83,0:56:21.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:56:22.21,0:56:24.04,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:56:24.63,0:56:28.25,Default,,0,0,0,,Әңгіменің соңында сол көзілдіріктің жоғалуы тым азапты.
Dialogue: 0,0:56:32.13,0:56:33.64,Default,,0,0,0,,Өзіңізге біраз уақыт сатып алыңыз!
Dialogue: 0,0:56:33.93,0:56:34.76,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:56:34.89,0:56:38.81,Default,,0,0,0,,Сіз қайтып келгенше, сіз бүкіл елге барасыз!
Dialogue: 0,0:56:41.06,0:56:42.27,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:56:47.36,0:56:48.19,Default,,0,0,0,,Өрт сөндірушілер
Dialogue: 0,0:56:48.98,0:56:51.44,Default,,0,0,0,,Бауырым, сен мұнда не істеп жүрсің?
Dialogue: 0,0:56:51.57,0:56:52.45,Default,,0,0,0,,Мен білдім...
Dialogue: 0,0:56:52.57,0:56:55.70,Default,,0,0,0,,Ол інісінің батырлық келбетін көруге келген болуы керек.
Dialogue: 0,0:56:56.03,0:56:59.49,Default,,0,0,0,,Бұл негізінен пайдасыз.
Dialogue: 0,0:56:59.70,0:57:04.29,Default,,0,0,0,,Ал, 5 жиын шаршатады, сондықтан үзіліс жасаған дұрыс.
Dialogue: 0,0:57:04.42,0:57:06.00,Default,,0,0,0,,Қол ауырады, бірақ...
Dialogue: 0,0:57:07.54,0:57:08.92,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:57:12.55,0:57:14.68,Default,,0,0,0,,Менің достарым мен оларды жалғыз қалдырсам да жеңеді!
Dialogue: 0,0:57:15.43,0:57:18.22,Default,,0,0,0,,Тек сонша сену керек.
Dialogue: 0,0:57:18.89,0:57:20.60,Default,,0,0,0,,Қарсымын!
Dialogue: 0,0:57:21.22,0:57:22.93,Default,,0,0,0,,Қайтып келсем, жеңіліп қалдым.
Dialogue: 0,0:57:23.06,0:57:25.65,Default,,0,0,0,,...Бұл сөзсіз олай емес.
Dialogue: 0,0:57:30.65,0:57:33.95,Default,,0,0,0,,Цукишиманың осылай көріне бастағанына сене алар емеспін.
Dialogue: 0,0:57:35.41,0:57:38.07,Default,,0,0,0,,Бұл жерде жігеріңді көрсетудің орнына, қашан көрсетесің?
Dialogue: 0,0:57:38.07,0:57:38.91,Default,,0,0,0,,Осы жерде көрсетпей, қайсарлығыңды қашан көрсетесің?
Dialogue: 0,0:57:38.07,0:57:38.91,Default,,0,0,0,,
Dialogue: 0,0:57:39.49,0:57:40.45,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:57:40.66,0:57:41.62,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:57:42.12,0:57:42.95,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:57:44.50,0:57:46.71,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:57:49.92,0:57:51.17,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:57:52.01,0:57:53.09,Default,,0,0,0,,
Dialogue: 0,0:57:53.21,0:57:54.51,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:57:54.63,0:57:56.63,Default,,0,0,0,,Кешіріңіз (Гошики) Дон Май.
Dialogue: 0,0:57:57.18,0:57:59.64,Default,,0,0,0,,Ха, ақыры бұзылды.
Dialogue: 0,0:57:59.89,0:58:03.60,Default,,0,0,0,,Ушивака ағымдағы қызмет көрсету кезегінде қанша рет қатарынан ұпай алды?
Dialogue: 0,0:58:03.73,0:58:05.60,Default,,0,0,0,,5? (Такинуэ) 6 ұпай.
Dialogue: 0,0:58:05.73,0:58:07.65,Default,,0,0,0,,Үштен артық?
Dialogue: 0,0:58:07.77,0:58:10.11,Default,,0,0,0,,Бірақ бұл жерде Хината ойнайды.
Dialogue: 0,0:58:10.36,0:58:12.40,Default,,0,0,0,,Тағы бірдеңе жасаңыз!
Dialogue: 0,0:58:14.28,0:58:16.82,Default,,0,0,0,,Нарита мырза, жақсырақ!
Dialogue: 0,0:58:16.95,0:58:17.95,Default,,0,0,0,,Ниссер!
Dialogue: 0,0:58:18.07,0:58:19.16,Default,,0,0,0,,
Dialogue: 0,0:58:19.28,0:58:20.53,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:58:21.87,0:58:22.70,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:58:22.83,0:58:23.87,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:58:24.00,0:58:25.12,Default,,0,0,0,,Тендо!
Dialogue: 0,0:58:25.25,0:58:26.46,Default,,0,0,0,,Хоо!
Dialogue: 0,0:58:26.58,0:58:27.33,Default,,0,0,0,,Ах
Dialogue: 0,0:58:27.71,0:58:28.58,Default,,0,0,0,,Асахи мырза!
Dialogue: 0,0:58:30.04,0:58:31.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:58:41.05,0:58:42.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:58:43.14,0:58:45.06,Default,,0,0,0,,Бұл Кагеяма емес, секірме.
Dialogue: 0,0:58:45.27,0:58:47.77,Default,,0,0,0,,Кез келген адаммен жылдам қарқын
Dialogue: 0,0:58:49.65,0:58:51.52,Default,,0,0,0,,1 блок!
Dialogue: 0,0:58:51.65,0:58:54.11,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:58:56.24,0:58:58.91,Default,,0,0,0,,Хината Мен жақсысың ба?
Dialogue: 0,0:58:59.28,0:59:00.24,Default,,0,0,0,,Uss
Dialogue: 0,0:59:00.37,0:59:02.33,Default,,0,0,0,,Мен оны бейтаныс жерде алдым.
Dialogue: 0,0:59:03.24,0:59:04.49,Default,,0,0,0,,Қолым уақытында дайын емес...
Dialogue: 0,0:59:04.62,0:59:06.54,Default,,0,0,0,,«Бұл бет-бейне қабылдау!» Мен ойладым...
Dialogue: 0,0:59:06.66,0:59:08.37,Default,,0,0,0,,Менің мұрныма тигенін қаламаймын.
Dialogue: 0,0:59:08.50,0:59:12.09,Default,,0,0,0,,А, сонда сіз оны көре алдыңыз және ол ауыстырылды ма?
Dialogue: 0,0:59:13.17,0:59:16.17,Default,,0,0,0,,Мұрыннан қан кетсе, орындықта отырасың.
Dialogue: 0,0:59:19.97,0:59:23.60,Default,,0,0,0,,Жеңіске жететінімізге күмәнім жоқ.
Dialogue: 0,0:59:24.76,0:59:28.35,Default,,0,0,0,,Бірақ енді бірінші рет түсінікті...
Dialogue: 0,0:59:30.10,0:59:32.56,Default,,0,0,0,,Мен сені басып алғым келеді
Dialogue: 0,0:59:32.90,0:59:34.27,Default,,0,0,0,,Ха…
Dialogue: 0,0:59:35.69,0:59:36.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:40.45,0:59:41.28,Default,,0,0,0,,
Dialogue: 0,0:59:41.78,0:59:44.95,Default,,0,0,0,,Жарайды, жарайды, берілме.
Dialogue: 0,0:59:45.08,0:59:46.66,Default,,0,0,0,,А, эй, солай.
Dialogue: 0,0:59:47.45,0:59:49.41,Default,,0,0,0,,Кагеяма тұр!
Dialogue: 0,0:59:50.75,0:59:52.58,Default,,0,0,0,,Мен қайтамын
Dialogue: 0,0:59:55.55,0:59:57.59,Default,,0,0,0,,Жарайды, жарайды! Вакатоши жақсы!
Dialogue: 0,0:59:57.88,0:59:58.72,Default,,0,0,0,,Бес түс
Dialogue: 0,1:00:01.84,1:00:02.97,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,1:00:03.97,1:00:05.93,Default,,0,0,0,,Кешіріңіз, ұзақ болды!
Dialogue: 0,1:00:07.81,1:00:08.81,Default,,0,0,0,,Шуга!
Dialogue: 0,1:00:11.94,1:00:14.11,Default,,0,0,0,,Барлық синхрондалған шабуылдар!
Dialogue: 0,1:00:14.77,1:00:16.07,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:00:17.61,1:00:18.61,Default,,0,0,0,,Тея!
Dialogue: 0,1:00:18.74,1:00:19.74,Default,,0,0,0,,
Dialogue: 0,1:00:19.86,1:00:21.74,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:00:21.90,1:00:23.87,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:00:24.12,1:00:25.95,Default,,0,0,0,,Ей!
Dialogue: 0,1:00:26.08,1:00:28.33,Default,,0,0,0,,Міне келді!
Dialogue: 0,1:00:33.96,1:00:36.34,Default,,0,0,0,,Батейама-кун ақыры қайта тірілді ме?
Dialogue: 0,1:00:38.55,1:00:40.42,Default,,0,0,0,,Бастың артқы жағын бақылаңыз
Dialogue: 0,1:00:40.55,1:00:41.84,Default,,0,0,0,,Иә
Dialogue: 0,1:00:41.97,1:00:43.38,Default,,0,0,0,,
Dialogue: 0,1:00:47.97,1:00:49.02,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,1:00:50.77,1:00:51.98,Default,,0,0,0,,Уф!
Dialogue: 0,1:00:54.10,1:00:56.52,Default,,0,0,0,,Оны тірілткен бойда ұсыныңыз!
Dialogue: 0,1:00:56.86,1:00:58.73,Default,,0,0,0,,Бұл кездейсоқ доп. Сақ болыңыз!
Dialogue: 0,1:00:58.94,1:00:59.98,Default,,0,0,0,,Аура... (Кагеяма) Жарайды!
Dialogue: 0,1:01:02.53,1:01:04.82,Default,,0,0,0,,Бірінші түрту орнатылды!
Dialogue: 0,1:01:04.99,1:01:05.82,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,1:01:09.62,1:01:12.87,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:01:13.00,1:01:14.37,Default,,0,0,0,,
Dialogue: 0,1:01:16.13,1:01:17.04,Default,,0,0,0,,Уф!
Dialogue: 0,1:01:17.17,1:01:18.00,Default,,0,0,0,,Хмф!
Dialogue: 0,1:01:19.92,1:01:21.21,Default,,0,0,0,,Вакатоши!
Dialogue: 0,1:01:22.42,1:01:23.84,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,1:01:26.84,1:01:28.01,Default,,0,0,0,,Ах
Dialogue: 0,1:01:28.39,1:01:30.52,Default,,0,0,0,,Интернеттен өте алыс!
Dialogue: 0,1:01:33.60,1:01:34.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:01:34.69,1:01:36.48,Default,,0,0,0,,Бұл...
Dialogue: 0,1:01:36.98,1:01:39.19,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:01:39.44,1:01:41.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:01:46.07,1:01:49.08,Default,,0,0,0,,Хмм...
Dialogue: 0,1:01:59.34,1:02:01.67,Default,,0,0,0,,Сабырлы немесе дәлірек шоғырланған.
Dialogue: 0,1:02:01.80,1:02:04.55,Default,,0,0,0,,Бұл қазіргі соғыс жағдайы туралы емес, бәлкім...
Dialogue: 0,1:02:05.05,1:02:08.93,Default,,0,0,0,,Қайтып келгенде не істеймін деген ой
Dialogue: 0,1:02:12.52,1:02:13.35,Default,,0,0,0,,
Dialogue: 0,1:02:13.47,1:02:15.60,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:02:17.98,1:02:20.44,Default,,0,0,0,,Сен мені бұрышқа түсірдің, Карасуно.
Dialogue: 0,1:02:20.57,1:02:22.82,Default,,0,0,0,,Оның үстіне Мегане-кун да мұнда жоқ.
Dialogue: 0,1:02:23.65,1:02:26.28,Default,,0,0,0,,Мен бұл сәйкестік нүктесін қалай жеңуге болады...
Dialogue: 0,1:02:23.65,1:02:26.28,Default,,0,0,0,,Тағы бір нүкте! Тағы бір нүкте!
Dialogue: 0,1:02:26.28,1:02:27.61,Default,,0,0,0,,Тағы бір нүкте! Тағы бір нүкте!
Dialogue: 0,1:02:27.74,1:02:28.99,Default,,0,0,0,,
Dialogue: 0,1:02:27.74,1:02:28.99,Default,,0,0,0,,Тағы бір нүкте! Тағы бір нүкте...
Dialogue: 0,1:02:28.99,1:02:30.49,Default,,0,0,0,,Тағы бір нүкте! Тағы бір нүкте...
Dialogue: 0,1:02:33.24,1:02:33.91,Default,,0,0,0,,Хамф!
Dialogue: 0,1:02:34.45,1:02:35.37,Default,,0,0,0,,Уф...
Dialogue: 0,1:02:35.71,1:02:37.12,Default,,0,0,0,,Керемет қабыл алыңыздар!
Dialogue: 0,1:02:38.92,1:02:40.75,Default,,0,0,0,,Синхрондалған шабуыл!
Dialogue: 0,1:02:44.38,1:02:45.21,Default,,0,0,0,,
Dialogue: 0,1:02:45.51,1:02:47.38,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:02:47.51,1:02:50.14,Default,,0,0,0,,Жігітті алғаннан кейін бірден ұруға батылы бар ма?
Dialogue: 0,1:02:50.26,1:02:52.10,Default,,0,0,0,,Шеш, шеш, Карасуно!
Dialogue: 0,1:02:52.22,1:02:56.27,Default,,0,0,0,,Өрт, күй, Карасуно! Шеш, шеш, Карасуно!
Dialogue: 0,1:02:56.39,1:03:00.27,Default,,0,0,0,,Өрт, күй, Карасуно! Шеш, шеш, Карасуно!
Dialogue: 0,1:03:00.44,1:03:02.27,Default,,0,0,0,,Өрт, күй, Карасуно!
Dialogue: 0,1:03:02.57,1:03:04.28,Default,,0,0,0,,Бар, жүр, Карасуно!
Dialogue: 0,1:03:04.57,1:03:06.53,Default,,0,0,0,,Өрт, күй, Карасуно!
Dialogue: 0,1:03:06.65,1:03:08.57,Default,,0,0,0,,Шеш, шеш, Карасуно!
Dialogue: 0,1:03:08.70,1:03:12.03,Default,,0,0,0,,Өрт, күй, Карасуно! Шеш, шеш, Карасуно!
Dialogue: 0,1:03:12.16,1:03:13.58,Default,,0,0,0,,Карасуно! Өрт, күйдір...
Dialogue: 0,1:03:13.70,1:03:17.58,Default,,0,0,0,,♪ Ормандағы Мияко
Dialogue: 0,1:03:17.71,1:03:22.54,Default,,0,0,0,,♪ Тікелей төменде ұстаңыз
Dialogue: 0,1:03:22.75,1:03:27.38,Default,,0,0,0,,♪ Басыңды көтерсең, ерлік боларсың.
Dialogue: 0,1:03:27.51,1:03:32.05,Default,,0,0,0,,♪ Сендай сарайы
Dialogue: 0,1:03:32.35,1:03:33.35,Default,,0,0,0,,Карасуно!
Dialogue: 0,1:03:32.35,1:03:33.35,Default,,0,0,0,,♪ Біздің мектеп
Dialogue: 0,1:03:33.35,1:03:33.47,Default,,0,0,0,,♪ Біздің мектеп
Dialogue: 0,1:03:33.47,1:03:36.89,Default,,0,0,0,,♪ Біздің мектеп
Dialogue: 0,1:03:33.47,1:03:36.89,Default,,0,0,0,,Өрт, күй, Карасуно! Шешіңіз, шешіңіз ...
Dialogue: 0,1:03:36.89,1:03:37.02,Default,,0,0,0,,♪ Біздің мектеп
Dialogue: 0,1:03:37.02,1:03:38.02,Default,,0,0,0,,♪ Біздің мектеп
Dialogue: 0,1:03:37.02,1:03:38.02,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,1:03:38.02,1:03:38.27,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,1:03:38.27,1:03:40.39,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,1:03:38.27,1:03:40.39,Default,,0,0,0,,♪ О, керемет
Dialogue: 0,1:03:40.39,1:03:42.98,Default,,0,0,0,,♪ О, даңқты
Dialogue: 0,1:03:43.36,1:03:44.69,Default,,0,0,0,,
Dialogue: 0,1:03:43.36,1:03:44.69,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:03:44.69,1:03:48.07,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:03:48.24,1:03:49.70,Default,,0,0,0,,♪ О, даңқты
Dialogue: 0,1:03:49.70,1:03:50.74,Default,,0,0,0,,♪ О, керемет
Dialogue: 0,1:03:49.70,1:03:50.74,Default,,0,0,0,,Қысқа!
Dialogue: 0,1:03:50.74,1:03:51.32,Default,,0,0,0,,♪ О, даңқты
Dialogue: 0,1:03:51.32,1:03:52.16,Default,,0,0,0,,♪ О, керемет
Dialogue: 0,1:03:51.32,1:03:52.16,Default,,0,0,0,,Уф
Dialogue: 0,1:03:52.16,1:03:52.70,Default,,0,0,0,,♪ О, керемет
Dialogue: 0,1:03:52.70,1:03:53.20,Default,,0,0,0,,♪ О, керемет
Dialogue: 0,1:03:52.70,1:03:53.20,Default,,0,0,0,,Торды көздеудің мәні бар.
Dialogue: 0,1:03:53.20,1:03:53.32,Default,,0,0,0,,Торды көздеудің мәні бар.
Dialogue: 0,1:03:53.32,1:03:55.33,Default,,0,0,0,,Торды көздеудің мәні бар.
Dialogue: 0,1:03:53.32,1:03:55.33,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:03:55.33,1:03:55.49,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:03:55.49,1:03:57.58,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:03:55.49,1:03:57.58,Default,,0,0,0,,Бес түс! (Бес түс) Иә
Dialogue: 0,1:03:57.58,1:03:58.04,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:03:58.87,1:04:00.08,Default,,0,0,0,,Уф!
Dialogue: 0,1:04:00.79,1:04:01.62,Default,,0,0,0,,Уф
Dialogue: 0,1:04:01.87,1:04:04.09,Default,,0,0,0,,Қосылды! Біз қосылдық!
Dialogue: 0,1:04:04.59,1:04:05.84,Default,,0,0,0,,Кагеяма соңғы!
Dialogue: 0,1:04:08.63,1:04:11.13,Default,,0,0,0,,Бұл сіздің мүмкіндігіңіз! Тағы бір соққы!
Dialogue: 0,1:04:11.26,1:04:13.34,Default,,0,0,0,,Қондырушы қабылдасын
Dialogue: 0,1:04:13.89,1:04:15.05,Default,,0,0,0,,Ушидзима мырза!
Dialogue: 0,1:04:15.26,1:04:16.43,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,1:04:16.56,1:04:18.93,Default,,0,0,0,,Уақытты өткізіп алсаңыз, бітті
Dialogue: 0,1:04:19.06,1:04:21.31,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:04:22.10,1:04:23.23,Default,,0,0,0,,Ішек
Dialogue: 0,1:04:24.94,1:04:25.69,Default,,0,0,0,,Уф
Dialogue: 0,1:04:26.27,1:04:27.11,Default,,0,0,0,,Ах
Dialogue: 0,1:04:27.23,1:04:28.82,Default,,0,0,0,,О, айналайын!
Dialogue: 0,1:04:28.94,1:04:32.07,Default,,0,0,0,,Тәтті, бірақ мен оны қайтару үшін біраз уақыттан бері қолдан келгеннің бәрін жасап жатырмын.
Dialogue: 0,1:04:32.70,1:04:34.28,Default,,0,0,0,,Ол әлі құлаған жоқ!
Dialogue: 0,1:04:34.49,1:04:36.45,Default,,0,0,0,,Ол әлі құлаған жоқ!
Dialogue: 0,1:04:36.58,1:04:36.91,Default,,0,0,0,,Оны алыңыз! (Ямагучи) Тоқта!
Dialogue: 0,1:04:36.91,1:04:38.45,Default,,0,0,0,,Оны алыңыз! (Ямагучи) Тоқта!
Dialogue: 0,1:04:36.91,1:04:38.45,Default,,0,0,0,,Бұл бір нүкте!
Dialogue: 0,1:04:38.83,1:04:40.66,Default,,0,0,0,,Міндетті түрде қабылдаңыз!
Dialogue: 0,1:04:41.00,1:04:43.33,Default,,0,0,0,,Шулы, мынау күштірек!
Dialogue: 0,1:04:47.92,1:04:48.75,Default,,0,0,0,,
Dialogue: 0,1:04:48.88,1:04:51.26,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:04:52.55,1:04:56.35,Default,,0,0,0,,♪ Ормандағы Мияко
Dialogue: 0,1:04:56.68,1:05:01.68,Default,,0,0,0,,♪ Тікелей төменде ұстаңыз
Dialogue: 0,1:05:01.81,1:05:06.52,Default,,0,0,0,,♪ Басыңды көтерсең, ерлік боларсың.
Dialogue: 0,1:05:06.65,1:05:10.74,Default,,0,0,0,,♪ Сендай сарайы
Dialogue: 0,1:05:11.07,1:05:17.16,Default,,0,0,0,,♪ Біздің мектеп
Dialogue: 0,1:05:17.28,1:05:20.83,Default,,0,0,0,,♪ О, керемет
Dialogue: 0,1:05:20.83,1:05:22.37,Default,,0,0,0,,♪ О, керемет
Dialogue: 0,1:05:20.83,1:05:22.37,Default,,0,0,0,,Жоқ, барлығының атмосферасы ауыр.
Dialogue: 0,1:05:22.37,1:05:22.50,Default,,0,0,0,,Жоқ, барлығының атмосферасы ауыр.
Dialogue: 0,1:05:22.50,1:05:24.04,Default,,0,0,0,,Жоқ, барлығының атмосферасы ауыр.
Dialogue: 0,1:05:22.50,1:05:24.04,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:05:24.04,1:05:24.17,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:05:24.17,1:05:25.67,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:05:24.17,1:05:25.67,Default,,0,0,0,,Бірақ күту уақыты аяқталды...
Dialogue: 0,1:05:25.67,1:05:25.79,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:05:25.79,1:05:26.96,Default,,0,0,0,,♪ Шираторизава академиясы
Dialogue: 0,1:05:25.79,1:05:26.96,Default,,0,0,0,,Төмен қара...
Dialogue: 0,1:05:26.96,1:05:27.25,Default,,0,0,0,,төмен қара...
Dialogue: 0,1:05:27.25,1:05:27.67,Default,,0,0,0,,Төмен қара...
Dialogue: 0,1:05:27.25,1:05:27.67,Default,,0,0,0,,♪ Ах...
Dialogue: 0,1:05:27.67,1:05:27.84,Default,,0,0,0,,♪ Ах...
Dialogue: 0,1:05:27.84,1:05:29.09,Default,,0,0,0,,♪ Ах...
Dialogue: 0,1:05:27.84,1:05:29.09,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:05:29.09,1:05:31.71,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:05:33.13,1:05:34.55,Default,,0,0,0,,алқап –
Dialogue: 0,1:05:36.39,1:05:39.39,Default,,0,0,0,,Бұл әрқашан биіктен көрінетін спорт түрі!
Dialogue: 0,1:05:40.43,1:05:41.81,Default,,0,0,0,,Хехе
Dialogue: 0,1:05:44.98,1:05:46.35,Default,,0,0,0,,Хехехе
Dialogue: 0,1:05:46.48,1:05:48.02,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,1:05:48.15,1:05:50.27,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:05:50.40,1:05:51.28,Default,,0,0,0,,Джинка-чан!
Dialogue: 0,1:05:51.69,1:05:52.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:52.90,1:05:54.03,Default,,0,0,0,,Ах
Dialogue: 0,1:06:02.45,1:06:03.79,Default,,0,0,0,,Цукки!
Dialogue: 0,1:06:04.25,1:06:05.41,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:05.54,1:06:07.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:09.21,1:06:11.17,Default,,0,0,0,,Өрт сөндірушілер жақсы ма?
Dialogue: 0,1:06:11.38,1:06:14.01,Default,,0,0,0,,Маған ауыр тиген кішкентай саусағым болды.
Dialogue: 0,1:06:14.13,1:06:17.76,Default,,0,0,0,,Олар оны сақина саусағына бекітіп, ойынды жалғастыратын сияқты.
Dialogue: 0,1:06:19.18,1:06:20.10,Default,,0,0,0,,Бірақ мүмкін-
Dialogue: 0,1:06:20.89,1:06:23.68,Default,,0,0,0,,Ауыратыны – ештеңе басылған жоқ.
Dialogue: 0,1:06:26.73,1:06:28.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:28.81,1:06:30.23,Default,,0,0,0,,Оқыңыз
Dialogue: 0,1:06:30.36,1:06:32.19,Default,,0,0,0,,Бұл енді жұмыс істемейтін сияқты.
Dialogue: 0,1:06:34.53,1:06:36.95,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,1:06:37.07,1:06:38.86,Default,,0,0,0,,Өтінемін, Цукишима.
Dialogue: 0,1:06:42.16,1:06:43.58,Default,,0,0,0,,Цукишима!
Dialogue: 0,1:06:43.70,1:06:47.08,Default,,0,0,0,,Батырдың түрі осы емес пе, бейбақ!
Dialogue: 0,1:06:47.33,1:06:50.33,Default,,0,0,0,,Мм... бұл 3 блок болған кезде.
Dialogue: 0,1:06:50.46,1:06:52.09,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,1:06:57.63,1:07:00.89,Default,,0,0,0,,Бұлай болмайды деп ойлаймын, бірақ екіленудің қажеті жоқ.
Dialogue: 0,1:07:01.01,1:07:03.10,Default,,0,0,0,,Олай ойламасаңыз, айтпаңыз.
Dialogue: 0,1:07:03.22,1:07:04.10,Default,,0,0,0,,Эй
Dialogue: 0,1:07:04.52,1:07:05.68,Default,,0,0,0,,Иә
Dialogue: 0,1:07:07.56,1:07:10.27,Default,,0,0,0,,Ширафу Сіздің уәдеңіз есімде.
Dialogue: 0,1:07:10.40,1:07:11.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:12.31,1:07:16.57,Default,,0,0,0,,Сіз мені кез келген жағдайда аяусыз пайдалана аласыз ба?
Dialogue: 0,1:07:19.07,1:07:20.20,Default,,0,0,0,,Иә
Dialogue: 0,1:07:20.70,1:07:22.20,Default,,0,0,0,,
Dialogue: 0,1:07:24.83,1:07:25.95,Default,,0,0,0,,Әй!
Dialogue: 0,1:07:27.37,1:07:28.25,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:07:28.46,1:07:29.96,Default,,0,0,0,,Оши Оши!
Dialogue: 0,1:07:30.08,1:07:31.17,Default,,0,0,0,,Оны маған беріңіз!
Dialogue: 0,1:07:31.29,1:07:32.17,Default,,0,0,0,,Ha
Dialogue: 0,1:07:35.25,1:07:36.76,Default,,0,0,0,,Тағы кездескенше!
Dialogue: 0,1:07:36.88,1:07:39.01,Default,,0,0,0,,Бар, Вакатоши-кун!
Dialogue: 0,1:07:48.14,1:07:49.69,Default,,0,0,0,,Ах! (Шимизу) Оң қол!
Dialogue: 0,1:07:51.48,1:07:54.40,Default,,0,0,0,,Бұл ақымақтық емес пе?
Dialogue: 0,1:07:54.86,1:07:56.78,Default,,0,0,0,,Бұл Хината емес.
Dialogue: 0,1:07:58.11,1:08:01.07,Default,,0,0,0,,Мен соңына дейін күрескім келеді
Dialogue: 0,1:08:02.45,1:08:05.28,Default,,0,0,0,,Бір рет түрту!
Dialogue: 0,1:08:05.87,1:08:06.99,Default,,0,0,0,,Хмф!
Dialogue: 0,1:08:07.54,1:08:09.46,Default,,0,0,0,,Дей! (Тохо) Нишитани жақсы!
Dialogue: 0,1:08:10.71,1:08:12.21,Default,,0,0,0,,Мүмкіндік добы!
Dialogue: 0,1:08:13.21,1:08:14.04,Default,,0,0,0,,Ушидзима мырза!
Dialogue: 0,1:08:14.50,1:08:16.05,Default,,0,0,0,,Жарықтан уақыт айырмашылығы
Dialogue: 0,1:08:16.30,1:08:17.55,Default,,0,0,0,,Оны бос қалдырыңыз!
Dialogue: 0,1:08:19.05,1:08:20.72,Default,,0,0,0,,Нишитани мырзаның көзқарасы
Dialogue: 0,1:08:20.93,1:08:22.38,Default,,0,0,0,,Сәлем! (Нишитани) Иә!
Dialogue: 0,1:08:22.51,1:08:23.93,Default,,0,0,0,,Керемет қабыл алыңыздар!
Dialogue: 0,1:08:24.05,1:08:24.89,Default,,0,0,0,,Асахи мырза!
Dialogue: 0,1:08:25.93,1:08:26.76,Default,,0,0,0,,Инженерлік!
Dialogue: 0,1:08:26.89,1:08:27.85,Default,,0,0,0,,Гррр…
Dialogue: 0,1:08:28.10,1:08:30.02,Default,,0,0,0,,Өте жақсы өтінемін!
Dialogue: 0,1:08:30.81,1:08:31.77,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,1:08:33.69,1:08:34.69,Default,,0,0,0,,Мен ұрамын
Dialogue: 0,1:08:35.11,1:08:36.90,Default,,0,0,0,,3 қатарынан Ушивака!
Dialogue: 0,1:08:41.07,1:08:42.11,Default,,0,0,0,,Хмф!
Dialogue: 0,1:08:42.24,1:08:43.45,Default,,0,0,0,,Ақ белбеу!
Dialogue: 0,1:08:47.95,1:08:50.33,Default,,0,0,0,,Цукишима кең!
Dialogue: 0,1:08:51.29,1:08:52.62,Default,,0,0,0,,Блеф!
Dialogue: 0,1:08:55.54,1:08:56.67,Default,,0,0,0,,Уф
Dialogue: 0,1:08:56.79,1:08:58.38,Default,,0,0,0,,Уау! (Сугавара) Бірақ...
Dialogue: 0,1:08:58.84,1:09:01.42,Default,,0,0,0,,Үзіліс!
Dialogue: 0,1:09:01.84,1:09:04.14,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:09:04.59,1:09:06.89,Default,,0,0,0,,Карасуно шын мәнінде барлық қоректік.
Dialogue: 0,1:09:07.01,1:09:09.47,Default,,0,0,0,,Мен көзілдірікті бірінші рет көріп тұрмын.
Dialogue: 0,1:09:09.60,1:09:10.52,Default,,0,0,0,,Жай алдау
Dialogue: 0,1:09:11.02,1:09:16.27,Default,,0,0,0,,Біз өте сәтті жасалған шабуылды оңай лақтырып тастай алмаймыз.
Dialogue: 0,1:09:16.48,1:09:20.78,Default,,0,0,0,,Шираторизава жеке күш-қуатты меңгереді және өз стилін ешқашан бұзбайды.
Dialogue: 0,1:09:21.40,1:09:26.16,Default,,0,0,0,,Бірақ Карасуноның ұстанатын стилі жоқ шығар.
Dialogue: 0,1:09:27.74,1:09:29.91,Default,,0,0,0,,Ескі және берік Шираторизава
Dialogue: 0,1:09:30.74,1:09:33.37,Default,,0,0,0,,Жаңа және шектен шыққан Карасуно
Dialogue: 0,1:09:33.71,1:09:36.75,Default,,0,0,0,,Кім жеңсе де тітіркендіреді, сондықтан екеуміз жеңілейік.
Dialogue: 0,1:09:36.88,1:09:38.67,Default,,0,0,0,,Сен бөтен жігітсің.
Dialogue: 0,1:09:42.09,1:09:44.72,Default,,0,0,0,,Әр адамның аяғы өз шегінде.
Dialogue: 0,1:09:45.22,1:09:49.14,Default,,0,0,0,,Көріп отырғаныңыздай, Ушиваканың хиттері көп, сондықтан бұл табиғи нәрсе.
Dialogue: 0,1:09:49.26,1:09:50.81,Default,,0,0,0,,Карасуноның шабуыл шебі
Dialogue: 0,1:09:50.93,1:09:54.94,Default,,0,0,0,,Спайк соққыларының саны немесе жүгіру кезіндегі жүгірулердің саны көп.
Dialogue: 0,1:09:56.48,1:09:59.77,Default,,0,0,0,,Бұл бос қадам сияқты көрінуі мүмкін, бірақ...
Dialogue: 0,1:09:59.90,1:10:02.28,Default,,0,0,0,,Міне, Карасуноның шабуылы...
Dialogue: 0,1:10:02.40,1:10:06.95,Default,,0,0,0,,Бұл Шираторизава блогынан құтылуымыздың ең үлкен себебі.
Dialogue: 0,1:10:08.20,1:10:13.87,Default,,0,0,0,,Ең үздік Танака, Томине және Савамура өз шегінен асып кетулері керек еді.
Dialogue: 0,1:10:14.00,1:10:16.00,Default,,0,0,0,,Өрт, күй, Карасуно...
Dialogue: 0,1:10:16.12,1:10:21.13,Default,,0,0,0,,Егер волейбол жеке жарыс болса, біз Шираторизаваны жеңе алмаймыз.
Dialogue: 0,1:10:21.25,1:10:24.55,Default,,0,0,0,,Олардың денелері кішкентай және жеке шабуыл күші төмен.
Dialogue: 0,1:10:25.26,1:10:27.13,Default,,0,0,0,,Бірақ сотта алты адам бар.
Dialogue: 0,1:10:27.26,1:10:30.10,Default,,0,0,0,,Біз жеңіске жеткен жоқпыз, өйткені ғажайып орын алады.
Dialogue: 0,1:10:30.60,1:10:33.39,Default,,0,0,0,,Тұжырымдама соңына дейін өзгеріссіз қалады!
Dialogue: 0,1:10:33.68,1:10:35.27,Default,,0,0,0,,Ұрысты басқарыңыз!
Dialogue: 0,1:10:35.39,1:10:36.81,Default,,0,0,0,,О!
Dialogue: 0,1:10:38.23,1:10:39.06,Default,,0,0,0,,
Dialogue: 0,1:10:41.86,1:10:43.65,Default,,0,0,0,,Шион мырза! (Охира) Аййо!
Dialogue: 0,1:10:49.03,1:10:49.87,Default,,0,0,0,,Гррр…
Dialogue: 0,1:10:50.16,1:10:51.20,Default,,0,0,0,,Дей!
Dialogue: 0,1:10:51.33,1:10:52.24,Default,,0,0,0,,
Dialogue: 0,1:10:52.87,1:10:54.75,Default,,0,0,0,,Тынш!
Dialogue: 0,1:10:54.87,1:10:56.96,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,1:10:57.08,1:10:58.71,Default,,0,0,0,,Мені кешірші, Хината.
Dialogue: 0,1:10:58.96,1:11:02.34,Default,,0,0,0,,Карасуно тек ерік-жігерімен қозғалатын сияқты.
Dialogue: 0,1:11:02.54,1:11:06.51,Default,,0,0,0,,Вакатоши де авангардқа көшіп, оған шығуға мүмкіндік берді.
Dialogue: 0,1:11:06.63,1:11:07.88,Default,,0,0,0,,
Dialogue: 0,1:11:08.13,1:11:09.43,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:11:11.72,1:11:12.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:16.73,1:11:18.35,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:11:18.48,1:11:21.44,Default,,0,0,0,,Мен сонда құлайтынымды білсем де...
Dialogue: 0,1:11:21.90,1:11:24.32,Default,,0,0,0,,Менің аяғым қозғалмайды!
Dialogue: 0,1:11:25.03,1:11:26.24,Default,,0,0,0,,Уф
Dialogue: 0,1:11:26.78,1:11:28.03,Default,,0,0,0,,Нишитани…
Dialogue: 0,1:11:30.32,1:11:31.53,Default,,0,0,0,,Уау
Dialogue: 0,1:11:33.95,1:11:36.45,Default,,0,0,0,,Нишитани!
Dialogue: 0,1:11:36.91,1:11:38.04,Default,,0,0,0,,Ei
Dialogue: 0,1:11:38.87,1:11:40.79,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:40.92,1:11:41.83,Default,,0,0,0,,
Dialogue: 0,1:11:41.96,1:11:44.59,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:11:45.30,1:11:47.13,Default,,0,0,0,,Я...
Dialogue: 0,1:11:47.63,1:11:49.55,Default,,0,0,0,,Рахмет сізге Нишитани!
Dialogue: 0,1:11:49.68,1:11:52.39,Default,,0,0,0,,«Мен Карасуноға тиесілімін»!
Dialogue: 0,1:11:52.51,1:11:55.47,Default,,0,0,0,,Бірақ менің де қолымнан келмейтін нәрселер бар.
Dialogue: 0,1:11:55.60,1:11:57.39,Default,,0,0,0,,Сондықтан бұл мүмкін емес екенін білсем де айтып отырмын.
Dialogue: 0,1:11:58.43,1:12:02.40,Default,,0,0,0,,Жамбастарым жыртылып кетсе де, ауада төбелесемін.
Dialogue: 0,1:12:03.48,1:12:04.65,Default,,0,0,0,,Кеттік! (Хината) Иә!
Dialogue: 0,1:12:12.16,1:12:12.99,Default,,0,0,0,,
Dialogue: 0,1:12:15.83,1:12:17.12,Default,,0,0,0,,Хаято!
Dialogue: 0,1:12:17.45,1:12:18.58,Default,,0,0,0,,Енгізілді
Dialogue: 0,1:12:19.12,1:12:20.96,Default,,0,0,0,,Хината позициясының өзгеруі (Хината) Ух...
Dialogue: 0,1:12:24.50,1:12:26.92,Default,,0,0,0,,Уақыт айырмашылығының шабуылдары көзілдіріктерде жұмыс істемейді.
Dialogue: 0,1:12:27.25,1:12:30.47,Default,,0,0,0,,Олай болса, орталықты жылдамдықпен жарып өтуге болады.
Dialogue: 0,1:12:30.84,1:12:32.80,Default,,0,0,0,,Орталықты осында жасаңыз!
Dialogue: 0,1:12:33.01,1:12:36.85,Default,,0,0,0,,Тамаша эйс - бұл тамаша алдау!
Dialogue: 0,1:12:37.06,1:12:38.52,Default,,0,0,0,,Тайчиге барыңыз!
Dialogue: 0,1:12:40.39,1:12:42.44,Default,,0,0,0,,Не айтып тұрсың, ессіз?
Dialogue: 0,1:12:42.64,1:12:45.27,Default,,0,0,0,,Міне, балақай.
Dialogue: 0,1:12:46.40,1:12:48.03,Default,,0,0,0,,Тыңда, балақай!
Dialogue: 0,1:12:48.15,1:12:49.49,Default,,0,0,0,,Қорғасын блогы
Dialogue: 0,1:12:49.61,1:12:52.65,Default,,0,0,0,,Шыдамдылық пен табандылық үшін блок болумен қатар...
Dialogue: 0,1:12:56.62,1:12:59.08,Default,,0,0,0,,Соңғы күлетін блок
Dialogue: 0,1:13:04.33,1:13:07.25,Default,,0,0,0,,Бір рет түрту!
Dialogue: 0,1:13:10.96,1:13:11.80,Default,,0,0,0,,Шабуыл
Dialogue: 0,1:13:12.05,1:13:12.88,Default,,0,0,0,,басқа...
Dialogue: 0,1:13:13.18,1:13:14.05,Default,,0,0,0,,Параметрлер
Dialogue: 0,1:13:14.39,1:13:15.22,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:13:17.51,1:13:18.56,Default,,0,0,0,,Минус темп...
Dialogue: 0,1:13:20.22,1:13:21.81,Default,,0,0,0,,Артқы шабуыл!
Dialogue: 0,1:13:22.56,1:13:23.52,Default,,0,0,0,,Жүр!
Dialogue: 0,1:13:23.81,1:13:25.48,Default,,0,0,0,,Тайчиге секіріңіз!
Dialogue: 0,1:13:27.40,1:13:28.77,Default,,0,0,0,,Тей!
Dialogue: 0,1:13:28.90,1:13:30.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:31.78,1:13:32.61,Default,,0,0,0,,Ах
Dialogue: 0,1:13:32.82,1:13:34.11,Default,,0,0,0,,Ақ мата!
Dialogue: 0,1:13:34.49,1:13:35.32,Default,,0,0,0,,Иә!
Dialogue: 0,1:13:35.66,1:13:36.78,Default,,0,0,0,,Тікелей!
Dialogue: 0,1:13:37.20,1:13:39.33,Default,,0,0,0,,Сено…
Dialogue: 0,1:13:40.79,1:13:42.16,Default,,0,0,0,,Хмф!
Dialogue: 0,1:13:43.50,1:13:44.37,Default,,0,0,0,,Гррр…
Dialogue: 0,1:13:45.62,1:13:47.21,Default,,0,0,0,,Кагеяма Соңғы!
Dialogue: 0,1:13:47.33,1:13:48.46,Default,,0,0,0,,Хината Жақсысың ба?
Dialogue: 0,1:13:48.59,1:13:49.55,Default,,0,0,0,,Ай
Dialogue: 0,1:13:50.09,1:13:51.26,Default,,0,0,0,,Бұл бар!
Dialogue: 0,1:13:51.46,1:13:52.71,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,1:13:56.30,1:13:58.68,Default,,0,0,0,,Хехе, ойлануға орын жоқ.
Dialogue: 0,1:13:58.93,1:14:00.56,Default,,0,0,0,,Ушидзима мырза!
Dialogue: 0,1:14:00.97,1:14:02.10,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:14:02.52,1:14:04.85,Default,,0,0,0,,Иә? Бүгін бірінші рет -
Dialogue: 0,1:14:05.10,1:14:07.10,Default,,0,0,0,,3 бөліктен тұратын блокта -
Dialogue: 0,1:14:07.35,1:14:09.77,Default,,0,0,0,,Түзуді қатайту үшін келді!
Dialogue: 0,1:14:15.15,1:14:16.61,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:14:17.49,1:14:18.37,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,1:14:18.49,1:14:19.87,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,1:14:22.41,1:14:24.33,Default,,0,0,0,,Тепе-теңдікті жоғалтып алсам да...
Dialogue: 0,1:14:24.87,1:14:27.04,Default,,0,0,0,,Дәл осының алдында кесіп өтуге өзгертілді
Dialogue: 0,1:14:31.92,1:14:34.30,Default,,0,0,0,,(Цукисима мен Хинатаның ыңырануы)
Dialogue: 0,1:14:34.80,1:14:38.01,Default,,0,0,0,,Боқтық...
Dialogue: 0,1:14:38.84,1:14:41.76,Default,,0,0,0,,Керемет...
Dialogue: 0,1:14:42.60,1:14:43.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:44.06,1:14:45.73,Default,,0,0,0,,Даа!
Dialogue: 0,1:14:46.44,1:14:50.81,Default,,0,0,0,,Гргх... Асахи!
Dialogue: 0,1:14:50.94,1:14:52.61,Default,,0,0,0,,Соңғы!
Dialogue: 0,1:14:55.24,1:14:56.99,Default,,0,0,0,,Kugggg…
Dialogue: 0,1:15:01.20,1:15:04.16,Default,,0,0,0,,Хмм...
Dialogue: 0,1:15:04.75,1:15:05.95,Default,,0,0,0,,Хмф!
Dialogue: 0,1:15:06.08,1:15:08.08,Default,,0,0,0,,Мүмкіндік добы!
Dialogue: 0,1:15:09.71,1:15:13.59,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:15:13.71,1:15:14.92,Default,,0,0,0,,№ 10 Келе жатыр!
Dialogue: 0,1:15:15.05,1:15:15.88,Default,,0,0,0,,Ах
Dialogue: 0,1:15:17.93,1:15:20.05,Default,,0,0,0,,No 10 Секірмей ме?
Dialogue: 0,1:15:20.18,1:15:21.01,Default,,0,0,0,,Ha
Dialogue: 0,1:15:26.89,1:15:28.39,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,1:15:48.46,1:15:53.46,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,1:16:01.72,1:16:03.18,Default,,0,0,0,,Тория!
Dialogue: 0,1:16:03.64,1:16:04.89,Default,,0,0,0,,Уф...
Dialogue: 0,1:16:12.35,1:16:15.15,Default,,0,0,0,,Волейбол – биіктіктегі доп ойыны
Dialogue: 0,1:16:15.65,1:16:18.28,Default,,0,0,0,,Үлкен адамдар күштірек екені анық.
Dialogue: 0,1:16:18.94,1:16:21.41,Default,,0,0,0,,Фигураларды меңгеру де күш
Dialogue: 0,1:16:21.57,1:16:24.78,Default,,0,0,0,,Күресудің жаңа тәсілдерін табу да күш
Dialogue: 0,1:16:25.74,1:16:30.54,Default,,0,0,0,,Сондықтан қазір әртүрлі шабуылдар мен қорғаныс түрлері жасалуда.
Dialogue: 0,1:16:32.33,1:16:34.92,Default,,0,0,0,,«Күш» шын мәнінде алуан түрлі.
Dialogue: 0,1:16:36.21,1:16:40.55,Default,,0,0,0,,Бұрынғы жаттықтырушы Элли Селингер бірде былай деді:
Dialogue: 0,1:16:41.55,1:16:46.43,Default,,0,0,0,,«Неге мен болашақта ешқандай даму немесе өзгеріс болмайды деп сенемін?»
Dialogue: 0,1:16:47.31,1:16:48.85,Default,,0,0,0,,«Жоқ»
Dialogue: 0,1:16:52.14,1:16:52.89,Default,,0,0,0,,(доптың құлаған дыбысы)
Dialogue: 0,1:17:02.74,1:17:05.70,Default,,0,0,0,,
Dialogue: 0,1:17:08.74,1:17:11.58,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:17:11.71,1:17:13.58,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:17:13.75,1:17:15.75,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:17:15.88,1:17:18.30,Default,,0,0,0,,Бұл менің інім!
Dialogue: 0,1:17:18.42,1:17:19.76,Default,,0,0,0,,Бұл көзілдірік!
Dialogue: 0,1:17:20.17,1:17:23.22,Default,,0,0,0,,Иә...
Dialogue: 0,1:17:23.63,1:17:25.34,Default,,0,0,0,,Мен мұны шынымен жасадым
Dialogue: 0,1:17:34.31,1:17:37.61,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:17:37.73,1:17:39.82,Default,,0,0,0,,Уау! (Кадеяма/Хината) Уау...
Dialogue: 0,1:17:39.94,1:17:40.86,Default,,0,0,0,,Цукки!
Dialogue: 0,1:17:51.29,1:17:54.21,Default,,0,0,0,,Қош бол жұмағым
Dialogue: 0,1:17:54.71,1:17:56.42,Default,,0,0,0,,Әй, сапқа тұр!
Dialogue: 0,1:17:57.04,1:17:58.88,Default,,0,0,0,,Тұра алмаймын...
Dialogue: 0,1:17:59.34,1:18:01.96,Default,,0,0,0,,Қарашы, Шойо (Хината) Ах, эй, а...
Dialogue: 0,1:18:02.09,1:18:03.17,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, барыңды істе
Dialogue: 0,1:18:03.30,1:18:05.30,Default,,0,0,0,,
Dialogue: 0,1:18:06.26,1:18:08.30,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:18:15.56,1:18:18.61,Default,,0,0,0,,Кагеяма, сен жақсы жұмыс істейсің.
Dialogue: 0,1:18:18.73,1:18:20.40,Default,,0,0,0,,Оны Ива Чан да байқады ма?
Dialogue: 0,1:18:20.65,1:18:25.61,Default,,0,0,0,,Меганекун қайтып келіп, қандай да бір блок нұсқау берген шығар.
Dialogue: 0,1:18:26.20,1:18:30.12,Default,,0,0,0,,Мүмкін, Ушивакаға қарсы "Түзіңді қатайт" деген сияқты нәрсе бар ма?
Dialogue: 0,1:18:31.12,1:18:32.91,Default,,0,0,0,,Тобио қызмет еткеннен кейін...
Dialogue: 0,1:18:33.04,1:18:36.75,Default,,0,0,0,,Мен айқышта тұрған Чиби Чанмен бірден орын ауыстырдым.
Dialogue: 0,1:18:37.46,1:18:40.17,Default,,0,0,0,,Себебі Нишитани-кун ол жерде болмады.
Dialogue: 0,1:18:40.54,1:18:43.30,Default,,0,0,0,,Сондай-ақ, соңғы минутта жағымсыз қайтару.
Dialogue: 0,1:18:43.42,1:18:45.17,Default,,0,0,0,,Шәкіртіңіз күткендей.
Dialogue: 0,1:18:45.30,1:18:46.51,Default,,0,0,0,,Ол шәкірт емес!
Dialogue: 0,1:18:47.34,1:18:50.39,Default,,0,0,0,,Ха, әзірше солай.
Dialogue: 0,1:18:50.51,1:18:55.27,Default,,0,0,0,,Мен оны әдеттегіден басқа нәрсе істеуге келген Чиби-чанмен тамаша үйлестірдім.
Dialogue: 0,1:18:55.39,1:18:57.48,Default,,0,0,0,,Бұл өте жиіркенішті көрінеді
Dialogue: 0,1:18:58.06,1:19:01.44,Default,,0,0,0,,Бұл жақсы жұмыстың алғышарты...
Dialogue: 0,1:19:02.02,1:19:04.78,Default,,0,0,0,,Бұл бір жылға арналған көзілдірік.
Dialogue: 0,1:19:05.19,1:19:06.70,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,1:19:06.82,1:19:10.74,Default,,0,0,0,,Чиби-чан - лақтырғың келетін спикер.
Dialogue: 0,1:19:10.87,1:19:13.62,Default,,0,0,0,,Тобионы итеріп жатыр.
Dialogue: 0,1:19:15.08,1:19:17.29,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:19:17.41,1:19:20.29,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:19:21.08,1:19:23.25,Default,,0,0,0,,Кенджиро, жақсысың ба?
Dialogue: 0,1:19:24.05,1:19:25.71,Default,,0,0,0,,Иә
Dialogue: 0,1:19:26.34,1:19:28.51,Default,,0,0,0,,Мен біраз абдырап қалдым...
Dialogue: 0,1:19:29.72,1:19:32.97,Default,,0,0,0,,Сіз жеңілемін деп ойламайсыз, солай ма?
Dialogue: 0,1:19:35.14,1:19:35.97,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,1:19:36.48,1:19:40.10,Default,,0,0,0,,Мұнда ешкім жеңілеміз деп ойламайды.
Dialogue: 0,1:20:04.96,1:20:07.26,Default,,0,0,0,,Қайтып келгеннен кейін кездесу
Dialogue: 0,1:20:07.51,1:20:10.18,Default,,0,0,0,,Марапаттау рәсімінен кейін автобусқа отырыңыз.
Dialogue: 0,1:20:10.51,1:20:11.47,Default,,0,0,0,,Иә (Шираторизава мүшелері) Біз
Dialogue: 0,1:20:14.51,1:20:17.18,Default,,0,0,0,,...және кейінірек 100 қызмет етіңіз
Dialogue: 0,1:20:19.27,1:20:20.89,Default,,0,0,0,,Ха (Гошики) Иә.
Dialogue: 0,1:20:28.99,1:20:31.78,Default,,0,0,0,,(шу)
Dialogue: 0,1:20:32.07,1:20:35.03,Default,,0,0,0,,Қолдауыңызға рахмет!
Dialogue: 0,1:20:35.24,1:20:37.49,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:20:37.87,1:20:40.37,Default,,0,0,0,,Жарайсың! (Шимада) Балалар сендер кереметсіңдер!
Dialogue: 0,1:20:40.50,1:20:42.96,Default,,0,0,0,,Мен сені сүйемін, Рю!
Dialogue: 0,1:20:45.34,1:20:47.38,Default,,0,0,0,,Уф...
Dialogue: 0,1:20:47.63,1:20:53.34,Default,,0,0,0,,Савамура, Сугавара және Томине жеңістерімен құттықтаймыз!
Dialogue: 0,1:20:53.72,1:20:54.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:59.14,1:21:00.39,Default,,0,0,0,,Ha
Dialogue: 0,1:21:01.10,1:21:02.48,Default,,0,0,0,,Аа…
Dialogue: 0,1:21:07.48,1:21:10.78,Default,,0,0,0,,Ушидзима-сан, бұл өте керемет болды.
Dialogue: 0,1:21:13.66,1:21:17.83,Default,,0,0,0,,Бетоннан Шойо Хината Тобио Кагеяма
Dialogue: 0,1:21:20.91,1:21:22.58,Default,,0,0,0,,Келесі жолы жеңіліс
Dialogue: 0,1:21:24.04,1:21:26.42,Default,,0,0,0,,Мен сенімен бір кезеңге міндетті түрде барамын!
Dialogue: 0,1:21:26.54,1:21:29.59,Default,,0,0,0,,Мен сені Ойкава-саннан артық деп міндетті түрде айтамын!
Dialogue: 0,1:21:37.43,1:21:42.43,Default,,0,0,0,,♪~
Dialogue: 0,1:25:32.54,1:25:37.54,Default,,0,0,0,,~♪
Dialogue: 0,1:25:38.46,1:25:40.76,Default,,0,0,0,,Міне, осының бәрі тапсыру үшін.
Dialogue: 0,1:25:41.05,1:25:42.42,Default,,0,0,0,,Тағы бір нәрсе бар...
Dialogue: 0,1:25:42.55,1:25:43.42,Default,,0,0,0,,Ал сосын!
Dialogue: 0,1:25:43.55,1:25:45.89,Default,,0,0,0,,А-а-а
Dialogue: 0,1:25:46.09,1:25:46.93,Default,,0,0,0,,Каваниши
Dialogue: 0,1:25:47.85,1:25:49.51,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,1:25:50.31,1:25:51.39,Default,,0,0,0,,Тендодан кейін...
Dialogue: 0,1:25:51.52,1:25:54.06,Default,,0,0,0,,Вакатоши-кун, сен өлгенде солай айтасың.
Dialogue: 0,1:25:54.19,1:25:58.48,Default,,0,0,0,,Сіз блоктың кілтісіз. Сіз сенімдірек болуыңыз керек.
Dialogue: 0,1:25:58.61,1:26:00.53,Default,,0,0,0,,Сонымен қатар қызметіңізді күшейтіңіз.
Dialogue: 0,1:26:00.65,1:26:01.86,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,1:26:02.07,1:26:04.40,Default,,0,0,0,,Ақ мата (Ақ мата) Иә!
Dialogue: 0,1:26:04.53,1:26:07.57,Default,,0,0,0,,Болашақ команданы құрастыру өз еркіңізде.
Dialogue: 0,1:26:07.95,1:26:11.83,Default,,0,0,0,,Бізде әлсіз спикерлер жоқ, сондықтан оларды барынша пайдаланыңыз.
Dialogue: 0,1:26:12.45,1:26:13.29,Default,,0,0,0,,Иә
Dialogue: 0,1:26:13.75,1:26:15.50,Default,,0,0,0,,Умеда (Умеда) Иә!
Dialogue: 0,1:26:15.62,1:26:19.79,Default,,0,0,0,,Пішініңізді тұрақты ұстаңыз, жай ғана жаттығулар жасамаңыз.
Dialogue: 0,1:26:19.92,1:26:20.75,Default,,0,0,0,,Иә!
Dialogue: 0,1:26:21.05,1:26:22.76,Default,,0,0,0,,Юнохама (Юнохама) Иә!
Dialogue: 0,1:26:22.88,1:26:25.18,Default,,0,0,0,,Блокқа жылдамырақ жауап беру
Dialogue: 0,1:26:25.30,1:26:26.47,Default,,0,0,0,,Иә!
Dialogue: 0,1:26:26.80,1:26:28.60,Default,,0,0,0,,Сіз бәріне айтуды жоспарлап отырсыз ба?
Dialogue: 0,1:26:28.72,1:26:30.31,Default,,0,0,0,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,1:26:30.43,1:26:32.47,Default,,0,0,0,,Айтайын дегенім, сіз мұқият қарадыңыз.
Dialogue: 0,1:26:32.64,1:26:33.64,Default,,0,0,0,,Иә!
Dialogue: 0,1:26:33.77,1:26:35.19,Default,,0,0,0,,Iida (Iida) Иә!
Dialogue: 0,1:26:35.89,1:26:39.31,Default,,0,0,0,,Психикалық блокты қабылдау
Dialogue: 0,1:26:39.44,1:26:41.61,Default,,0,0,0,,Қиындықтардың шегі жоқ
Dialogue: 0,1:26:41.98,1:26:44.65,Default,,0,0,0,,Мен Эйс болдым деп үлкен мәлімдеме жасадым ...
Dialogue: 0,1:26:45.11,1:26:46.32,Default,,0,0,0,,Бес түс
Dialogue: 0,1:26:46.45,1:26:47.36,Default,,0,0,0,,Иә
Dialogue: 0,1:26:48.70,1:26:49.95,Default,,0,0,0,,Кимоноым шаңмен кірленді.
Dialogue: 0,1:27:00.59,1:27:01.42,Default,,0,0,0,,Иә!
Dialogue: 0,1:27:02.09,1:27:03.88,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:27:04.17,1:27:06.47,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:27:09.47,1:27:12.97,Default,,0,0,0,,Қара, қара, қара, мен жыламаймын.
Dialogue: 0,1:27:13.10,1:27:15.27,Default,,0,0,0,,Сіз бұлай команданы басқара алмайсыз.
Dialogue: 0,1:27:19.02,1:27:21.65,Default,,0,0,0,,Жарайды, 100-ге қызмет етіңіз.
Dialogue: 0,1:27:21.77,1:27:24.44,Default,,0,0,0,,Ех! Өйткені, біз де солай істеп жатырмыз ба?
Dialogue: 0,1:27:24.78,1:27:27.11,Default,,0,0,0,,Менің ойымша, екеуі де жақсы.
Dialogue: 0,1:27:27.24,1:27:28.70,Default,,0,0,0,,Я...
Dialogue: 0,1:27:29.03,1:27:32.20,Default,,0,0,0,,Мен бұл серуендеу емес екеніне қуаныштымын.
Dialogue: 0,1:27:32.33,1:27:36.25,Default,,0,0,0,,(доптың секіру дыбысы)
Dialogue: 0,1:27:38.54,1:27:43.54,Default,,0,0,0,,
Dialogue: 0,1:27:49.88,1:27:53.01,Default,,0,0,0,,Токионың өкілі қазірден бастап шешіледі, солай ма?
Dialogue: 0,1:27:53.18,1:27:54.01,Default,,0,0,0,,О
Dialogue: 0,1:27:54.51,1:27:57.98,Default,,0,0,0,,Токио бірінші іріктеу турында 4 мектепке дейін қысқарды.
Dialogue: 0,1:27:58.10,1:28:01.27,Default,,0,0,0,,Ұлттық құраманың шешуші матчы қараша айында өтті деп ойлаймын.
Dialogue: 0,1:28:01.40,1:28:03.23,Default,,0,0,0,,Хмм...
Dialogue: 0,1:28:03.36,1:28:04.73,Default,,0,0,0,,Некоманы жеңіңіз!
Dialogue: 0,1:28:05.40,1:28:06.69,Default,,0,0,0,,Сәлем, Кагеяма?
Dialogue: 0,1:28:07.19,1:28:09.90,Default,,0,0,0,,Некома өкілдік жақта қалса
Dialogue: 0,1:28:10.11,1:28:11.20,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:11.45,1:28:13.66,Default,,0,0,0,,Ол келеді деп шешілді.
Dialogue: 0,1:28:18.12,1:28:21.79,Default,,0,0,0,,Енді ешқашан ойналмайтын матчты ойнайық.
Dialogue: 0,1:28:23.21,1:28:24.46,Default,,0,0,0,,Көктем орта мектебінде!
Dialogue: 0,1:28:24.59,1:28:27.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:28:30.22,1:28:32.26,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:28:32.39,1:28:33.97,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:28:34.43,1:28:35.85,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:28:36.43,1:28:37.72,Default,,0,0,0,,Көктем!
Dialogue: 0,1:28:37.85,1:28:41.31,Default,,0,0,0,,
Dialogue: 0,1:28:42.81,1:28:48.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory