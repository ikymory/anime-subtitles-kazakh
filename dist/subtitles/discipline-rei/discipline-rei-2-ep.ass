Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:29.68,0:00:33.22,Default,,0,0,0,,Итай О, не?
Dialogue: 0,0:00:35.21,0:00:37.11,Default,,0,0,0,,Сіз ақыры ояндыңыз.
Dialogue: 0,0:00:37.11,0:00:39.18,Default,,0,0,0,,Жүр, мен айқайлаймын.
Dialogue: 0,0:00:39.95,0:00:41.81,Default,,0,0,0,,Менімен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:00:42.18,0:00:44.65,Default,,0,0,0,,Мен сені ешқашан кешірмеймін
Dialogue: 0,0:00:44.65,0:00:46.24,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:00:46.24,0:00:47.38,Default,,0,0,0,,Өйткені сен мейірімдісің
Dialogue: 0,0:00:47.38,0:00:50.75,Default,,0,0,0,,Ниеттеріңізге қарай мен сізді кешіре аламын.
Dialogue: 0,0:00:50.75,0:00:52.63,Default,,0,0,0,,Не? Сақ болу дегенді қалай түсінесіңдер?
Dialogue: 0,0:00:52.63,0:00:54.98,Default,,0,0,0,,Мен Джунның менімен жұмыс істегенін қалаймын.
Dialogue: 0,0:00:56.21,0:01:01.41,Default,,0,0,0,,Мен сенің Могидің орнына Джунның мүшесі болғаныңды қалаймын.
Dialogue: 0,0:01:03.39,0:01:08.73,Default,,0,0,0,,Джунның айналасында маған ұнамайтын адамдар әлі де көп.
Dialogue: 0,0:01:11.37,0:01:14.02,Default,,0,0,0,,Сіз маған біреуді зорлаймын дейсіз бе?
Dialogue: 0,0:01:19.06,0:01:21.26,Default,,0,0,0,,Иә! Сіз жақсысыз ба?
Dialogue: 0,0:01:21.85,0:01:22.99,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:01:23.36,0:01:25.37,Default,,0,0,0,,Джунға көмектесе аласыз ба?
Dialogue: 0,0:01:26.30,0:01:27.95,Default,,0,0,0,,Немесе?
Dialogue: 0,0:01:31.53,0:01:33.11,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:01:33.11,0:01:36.34,Default,,0,0,0,,Мен сен сияқты адаммен ешқашан қызметтес болмас едім!
Dialogue: 0,0:01:38.74,0:01:40.71,Default,,0,0,0,,Жақсы айтылған! Киоширо
Dialogue: 0,0:01:49.01,0:01:50.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:52.87,0:01:56.34,Default,,0,0,0,,Сол дыбысты айтсаң, жыландар қозып кетеді.
Dialogue: 0,0:01:56.63,0:02:02.20,Default,,0,0,0,,Өзін-өзі ойлайтын, тазалыққа жаны құмар адам бағынбайтын, санитарлық талаптарға сай келмейтін жануарларға шыдай алмайды.
Dialogue: 0,0:02:02.24,0:02:04.45,Default,,0,0,0,,Жыландарды ұнатпайтын сияқты.
Dialogue: 0,0:02:04.45,0:02:06.38,Default,,0,0,0,,А, бұл анық, солай ма?
Dialogue: 0,0:02:06.38,0:02:09.25,Default,,0,0,0,,Оңай иіс шығарады және тістейді.
Dialogue: 0,0:02:09.62,0:02:13.17,Default,,0,0,0,,Кет! жоқ!
Dialogue: 0,0:02:15.70,0:02:19.40,Default,,0,0,0,,Тоқта, өлесің.
Dialogue: 0,0:02:21.69,0:02:24.65,Default,,0,0,0,,Ямико-сан, бұл не?
Dialogue: 0,0:02:25.28,0:02:27.05,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:02:27.05,0:02:29.89,Default,,0,0,0,,Енді оның бойында қорқыныш пен жиіркеніш пайда болды.
Dialogue: 0,0:02:29.89,0:02:31.92,Default,,0,0,0,,Тек жыныстық қатынасқа түскен
Dialogue: 0,0:02:39.20,0:02:41.47,Default,,0,0,0,,Маған көбірек сиқыршы
Dialogue: 0,0:02:41.47,0:02:44.85,Default,,0,0,0,,Маған көп бер, Ылғалдылығыма терең.
Dialogue: 0,0:02:47.08,0:02:50.61,Default,,0,0,0,,Ауырды, бірақ бәрібір.
Dialogue: 0,0:02:50.61,0:02:52.54,Default,,0,0,0,,Баяу қозғалу
Dialogue: 0,0:02:53.21,0:02:54.62,Default,,0,0,0,,Суда
Dialogue: 0,0:02:54.62,0:02:56.90,Default,,0,0,0,,Менің ішім жарылып кетеді
Dialogue: 0,0:02:56.90,0:02:59.60,Default,,0,0,0,,Жерленген, кіріп-шығады.
Dialogue: 0,0:02:59.60,0:03:03.68,Default,,0,0,0,,Бүкіл жатыр жерленеді!
Dialogue: 0,0:03:06.71,0:03:07.71,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:07.71,0:03:10.51,Default,,0,0,0,,Ішімдегінің бәрі ауырады.
Dialogue: 0,0:03:11.88,0:03:13.73,Default,,0,0,0,,Жоқ, ол бұзылады.
Dialogue: 0,0:03:13.73,0:03:14.77,Default,,0,0,0,,No
Dialogue: 0,0:03:23.30,0:03:25.65,Default,,0,0,0,,Мен пенис алғым келеді
Dialogue: 0,0:03:25.65,0:03:27.18,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:03:27.18,0:03:29.37,Default,,0,0,0,,Менің мысығым жылап тұрған сияқты
Dialogue: 0,0:03:30.57,0:03:33.40,Default,,0,0,0,,Кёичиро, сіздің кезегіңіз келген сияқты.
Dialogue: 0,0:03:33.86,0:03:35.47,Default,,0,0,0,,Міне, мен оны енгіземін.
Dialogue: 0,0:03:35.47,0:03:36.57,Default,,0,0,0,,Күшіңізді жоғалтыңыз
Dialogue: 0,0:03:41.74,0:03:46.27,Default,,0,0,0,,Иә! Менің қалағаным осы еді, өтінемін, көп қозғалыңыз!
Dialogue: 0,0:03:46.33,0:03:49.62,Default,,0,0,0,,Ішімдегінің бәрін араластырып
Dialogue: 0,0:03:53.40,0:03:57.25,Default,,0,0,0,,Кёичиро, менің үмітімді ақта. Ұстаудың қажеті жоқ.
Dialogue: 0,0:03:58.81,0:04:00.97,Default,,0,0,0,,А, мен білемін.
Dialogue: 0,0:04:02.62,0:04:05.67,Default,,0,0,0,,Бұл ғажап, мен қатты сезінемін
Dialogue: 0,0:04:05.67,0:04:08.18,Default,,0,0,0,,Көбірек жупожупо
Dialogue: 0,0:04:09.08,0:04:12.10,Default,,0,0,0,,Джунның құрсағында, мені көп мазақ қыл
Dialogue: 0,0:04:14.45,0:04:17.51,Default,,0,0,0,,Уау, Джун енді лас.
Dialogue: 0,0:04:17.51,0:04:21.50,Default,,0,0,0,,Сүт бездері бактерияларға толы, бірақ олар мұны істеп жатыр.
Dialogue: 0,0:04:21.50,0:04:23.99,Default,,0,0,0,,О, қорқынышты иіс.
Dialogue: 0,0:04:25.40,0:04:27.57,Default,,0,0,0,,Ылғалды иіс шығады.
Dialogue: 0,0:04:27.57,0:04:29.07,Default,,0,0,0,,Мен мұны қаламаймын
Dialogue: 0,0:04:29.76,0:04:31.61,Default,,0,0,0,,Менің денем шыдамайды
Dialogue: 0,0:04:33.70,0:04:36.76,Default,,0,0,0,,Егер сіз соншалықты көп жасасаңыз
Dialogue: 0,0:04:40.16,0:04:43.90,Default,,0,0,0,,Жоқ, қызғаныштан өлесің.
Dialogue: 0,0:04:46.68,0:04:50.47,Default,,0,0,0,,Енді жоқ, Джун жынды болып барады.
Dialogue: 0,0:04:52.75,0:04:54.96,Default,,0,0,0,,Егер сіз соншалықты көп жасасаңыз, онда
Dialogue: 0,0:04:56.90,0:04:57.97,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:05:05.67,0:05:08.06,Default,,0,0,0,,Жоқ, менің жатырым бұзылады.
Dialogue: 0,0:05:13.60,0:05:16.88,Default,,0,0,0,,Жыныс мүшесі жақсы, ылғалы жоқ.
Dialogue: 0,0:05:18.48,0:05:22.78,Default,,0,0,0,,Оны шығарып, шәуетпен толтырыңыз.
Dialogue: 0,0:05:28.83,0:05:31.00,Default,,0,0,0,,шығарылды
Dialogue: 0,0:05:31.00,0:05:34.57,Default,,0,0,0,,Джунның маңызды жерлерінде ақ көбелек бар.
Dialogue: 0,0:05:42.10,0:05:45.04,Default,,0,0,0,,Джунның ішінен тамшы
Dialogue: 0,0:05:51.22,0:05:52.78,Default,,0,0,0,,Шығу\NМен
Dialogue: 0,0:05:52.78,0:05:55.24,Default,,0,0,0,,Жоқ, томарана
Dialogue: 0,0:05:55.24,0:05:57.84,Default,,0,0,0,,Қол астындағыларға да қарай алмаймын.
Dialogue: 0,0:05:57.84,0:05:59.20,Default,,0,0,0,,Бұл аң сияқты
Dialogue: 0,0:05:59.20,0:06:01.98,Default,,0,0,0,,Жоқ, қарамаңыз.
Dialogue: 0,0:06:02.95,0:06:05.00,Default,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:06:09.81,0:06:11.71,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:06:11.89,0:06:15.05,Default,,0,0,0,,Сенің бірдеңені шығарып жібергеніңе сене алар емеспін.
Dialogue: 0,0:06:15.05,0:06:16.90,Default,,0,0,0,,Ластанған мақтаныш
Dialogue: 0,0:06:16.90,0:06:19.05,Default,,0,0,0,,Мен жек көретін нәрсе маған жақындай түседі
Dialogue: 0,0:06:19.05,0:06:21.54,Default,,0,0,0,,Осылай бәрін әшкерелеу керек
Dialogue: 0,0:06:21.54,0:06:24.87,Default,,0,0,0,,Қараңғылықты тазарта алмайтын шығар.
Dialogue: 0,0:06:30.53,0:06:32.24,Default,,0,0,0,,Мен саусақтарымды тоқтата алмаймын
Dialogue: 0,0:06:32.39,0:06:34.79,Default,,0,0,0,,Жоқ, жоқ, мен кетейін деп жатырмын.
Dialogue: 0,0:06:35.81,0:06:37.68,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:06:38.72,0:06:42.14,Default,,0,0,0,,Бұл Какуи мырзаға тиесілі.
Dialogue: 0,0:06:55.58,0:06:58.48,Default,,0,0,0,,О, осындай жерде кездескенім қандай кездейсоқтық.
Dialogue: 0,0:06:58.48,0:06:59.59,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:59.59,0:07:01.66,Default,,0,0,0,,Мен шамалы желге ілініп қалдым
Dialogue: 0,0:07:02.04,0:07:03.34,Default,,0,0,0,,Манабе-санға не болды?
Dialogue: 0,0:07:04.18,0:07:06.47,Default,,0,0,0,,Бұл менің сүйікті жерім
Dialogue: 0,0:07:06.88,0:07:09.26,Default,,0,0,0,,Көңіл-күйімді өзгерткім келгенде жиі келемін.
Dialogue: 0,0:07:09.72,0:07:14.77,Default,,0,0,0,,Аа, дұрыс, жақында Муцугучи мырза сізді уайымдаған сияқты.
Dialogue: 0,0:07:14.77,0:07:16.84,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:07:17.33,0:07:18.82,Default,,0,0,0,,Бұған ешқандай себеп жоқ, солай ма?
Dialogue: 0,0:07:18.92,0:07:21.65,Default,,0,0,0,,Себебі Муцугучи мырза сізді менсінбеген.
Dialogue: 0,0:07:22.60,0:07:24.30,Default,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:07:24.30,0:07:26.68,Default,,0,0,0,,Жоқ, жоқ, маған бәрібір.
Dialogue: 0,0:07:27.09,0:07:31.69,Default,,0,0,0,,Сондай-ақ, өткен күні мен Рокугучи мырзаға шай бөлмесінің кілтін бердім, ол ешқашан оралмады.
Dialogue: 0,0:07:32.09,0:07:34.06,Default,,0,0,0,,Мұндай жағдай бұрын соңды болмаған
Dialogue: 0,0:07:34.06,0:07:35.39,Default,,0,0,0,,Қызық, не болды?
Dialogue: 0,0:07:41.37,0:07:43.55,Default,,0,0,0,,Сізді кенеттен шақырғаным үшін кешіріңіз.
Dialogue: 0,0:07:44.12,0:07:44.99,Default,,0,0,0,,Шын мәнінде
Dialogue: 0,0:07:46.06,0:07:47.16,Default,,0,0,0,,Қайда?
Dialogue: 0,0:07:49.06,0:07:50.56,Default,,0,0,0,,А, мінеки!
Dialogue: 0,0:07:53.17,0:07:54.33,Default,,0,0,0,,W-неге?
Dialogue: 0,0:07:58.84,0:08:02.00,Default,,0,0,0,,Егер сіз асықпасаңыз, қиындыққа тап болуыңыз мүмкін.
Dialogue: 0,0:08:00.92,0:08:06.49,Default,,0,0,0,,Ақыр соңында, сіз шай бөлмесінің кілтін жоғалтып алып, іздегеніңізді таба алмайсыз, солай ма?
Dialogue: 0,0:08:06.49,0:08:08.24,Default,,0,0,0,,Кешіріңіз, мұғалім.
Dialogue: 0,0:08:08.24,0:08:10.31,Default,,0,0,0,,Бірақ келесі жолы міндетті түрде табыңыз
Dialogue: 0,0:08:10.31,0:08:11.16,Default,,0,0,0,,Жетеді
Dialogue: 0,0:08:11.16,0:08:12.28,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:08:12.28,0:08:14.84,Default,,0,0,0,,Кешіріңіз, мұғалім, мен.
Dialogue: 0,0:08:15.23,0:08:18.11,Default,,0,0,0,,Мен кілттерімді міндетті түрде қайтарып алып, бар күшіммен іздеймін.
Dialogue: 0,0:08:16.89,0:08:18.36,Default,,0,0,0,,Сіз мені жібересіз бе?
Dialogue: 0,0:08:18.36,0:08:19.86,Default,,0,0,0,,Какуи мырза
Dialogue: 0,0:08:29.81,0:08:30.60,Default,,0,0,0,,«Қиын екен.»
Dialogue: 0,0:08:30.60,0:08:32.27,Default,,0,0,0,,біреу жедел жәрдем
Dialogue: 0,0:08:34.02,0:08:35.60,Default,,0,0,0,,Қан көп ағып жатыр.
Dialogue: 0,0:08:35.94,0:08:38.14,Default,,0,0,0,,Жедел жәрдем
Dialogue: 0,0:08:39.92,0:08:41.43,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:08:55.35,0:08:58.43,Default,,0,0,0,,Әй, біраз болды. Қатты болды.
Dialogue: 0,0:08:58.43,0:09:03.07,Default,,0,0,0,,Міне, Какуи мырза мен Муцугучи мырзамен де солай болды.
Dialogue: 0,0:09:03.72,0:09:06.43,Default,,0,0,0,,Котобишима мырза да кенеттен жұмысын тоқтатты.
Dialogue: 0,0:09:07.09,0:09:09.78,Default,,0,0,0,,Өйткені олардың жұмысы бірден келді.
Dialogue: 0,0:09:09.78,0:09:13.72,Default,,0,0,0,,Бос емес болсам да, оны жақсы көретіндіктен істеп жатырмын.
Dialogue: 0,0:09:13.72,0:09:16.37,Default,,0,0,0,,Күткендей үш адамның жұмысы ауыр.
Dialogue: 0,0:09:16.69,0:09:19.73,Default,,0,0,0,,Егер бұл қиын жұмыс болмаса, мен сізге көмектесе аламын ба?
Dialogue: 0,0:09:20.33,0:09:22.54,Default,,0,0,0,,Жарайды, мен жұмысқа аламын!
Dialogue: 0,0:09:22.54,0:09:23.43,Default,,0,0,0,,Бұл ерте.
Dialogue: 0,0:09:23.97,0:09:27.57,Default,,0,0,0,,Бұл өте мейірімді әзіл.
Dialogue: 0,0:09:27.57,0:09:29.63,Default,,0,0,0,,Ширайши мырза сізден мұны сұрады ма?
Dialogue: 0,0:09:31.85,0:09:37.60,Default,,0,0,0,,Жақсы, егер маған көмектесе алсаңыз, мен оны бағалаймын және сіздің мектеп жиналысына қатысуыңызды мақұлдаймын.
Dialogue: 0,0:09:38.07,0:09:42.17,Default,,0,0,0,,Тез болғаным үшін кешіріңіз, бірақ иә, бұл шай бөлмесінің кілті.
Dialogue: 0,0:09:42.17,0:09:44.49,Default,,0,0,0,,Бұдан былай күнде тазалап тұрыңыз.
Dialogue: 0,0:09:44.49,0:09:48.19,Default,,0,0,0,,Өйткені сен менің жұмысыма көмектесесің, солай ма?
Dialogue: 0,0:09:48.60,0:09:52.19,Default,,0,0,0,,Олай болса, кіріп-шығуды жеңілдеткен дұрыс деп ойлаймын.
Dialogue: 0,0:09:52.19,0:09:54.57,Default,,0,0,0,,Олай болса, көмекші-күн, танысқаныма қуаныштымын.
Dialogue: 0,0:09:56.64,0:09:57.99,Default,,0,0,0,,Бұл тұзақ
Dialogue: 0,0:09:57.99,0:09:58.88,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:09:58.88,0:10:00.75,Default,,0,0,0,,Тым біркелкі өту
Dialogue: 0,0:10:01.22,0:10:05.82,Default,,0,0,0,,Бәрімізге жолды өзі ойып салғандай.
Dialogue: 0,0:10:06.03,0:10:08.50,Default,,0,0,0,,Сондай-ақ көп мүдделі адам деп айтылады.
Dialogue: 0,0:10:08.92,0:10:11.48,Default,,0,0,0,,Осы жерден мұқият әрекет еткен дұрыс.
Dialogue: 0,0:10:18.23,0:10:19.83,Default,,0,0,0,,Бірақ бұл мүмкіндік.
Dialogue: 0,0:10:19.83,0:10:24.79,Default,,0,0,0,,Жағдайлар қатысушылар ойлағаннан да жылдамырақ қозғалатыны рас емес пе?
Dialogue: 0,0:10:24.79,0:10:27.75,Default,,0,0,0,,Мұндай ойлау тәсілі бар болса да,
Dialogue: 0,0:10:28.41,0:10:30.89,Default,,0,0,0,,Жарайсың ба? Асығыс еліктемеңіз
Dialogue: 0,0:10:32.37,0:10:33.57,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:10:47.56,0:10:48.95,Default,,0,0,0,,Саки-чан хаса
Dialogue: 0,0:10:48.95,0:10:50.60,Default,,0,0,0,,Мо, Моги-кун
Dialogue: 0,0:10:50.60,0:10:52.75,Default,,0,0,0,,Мен тым көп білдім, солай емес пе?
Dialogue: 0,0:10:54.25,0:10:56.24,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:11:01.76,0:11:04.77,Default,,0,0,0,,*Бұл бұл емес.
Dialogue: 0,0:11:04.77,0:11:06.35,Default,,0,0,0,,Бұл да басқа
Dialogue: 0,0:11:07.25,0:11:09.64,Default,,0,0,0,,Бір жерде түсінік болуы керек
Dialogue: 0,0:11:11.21,0:11:15.16,Default,,0,0,0,,Шүкір, мен оны еш жерден таба алмаймын.
Dialogue: 0,0:11:19.72,0:11:21.05,Default,,0,0,0,,Бұл іс жарыққа шыққанына төрт айдан асты.
Dialogue: 0,0:11:25.71,0:11:31.74,Default,,0,0,0,,Мектеп жиналысын таратып, оны мұғалімдеріміз Манабе-санмен бірге жалғастырайық.
Dialogue: 0,0:11:32.27,0:11:35.79,Default,,0,0,0,,Менің жоспарыммен келіспедің бе?
Dialogue: 0,0:11:35.79,0:11:39.62,Default,,0,0,0,,Тым көп тырнамағаныңыз дұрыс.
Dialogue: 0,0:11:40.21,0:11:43.75,Default,,0,0,0,,Манабе мырза, сіздің ойыңыз қате.
Dialogue: 0,0:11:51.29,0:11:53.18,Default,,0,0,0,,Ол көрінді.
Dialogue: 0,0:11:58.91,0:12:01.29,Default,,0,0,0,,Бұл факті ме?
Dialogue: 0,0:12:01.83,0:12:03.99,Default,,0,0,0,,Иә, мұның бәрі рас.
Dialogue: 0,0:12:03.99,0:12:07.13,Default,,0,0,0,,Хинасе мырза да байсалды, солай ма? Мен әсер алдым
Dialogue: 0,0:12:07.91,0:12:11.11,Default,,0,0,0,,Бірақ байсалдылығың сенің жауыңа айналды.
Dialogue: 0,0:12:12.72,0:12:15.04,Default,,0,0,0,,Мұғалімнің айтқанын орындасаң
Dialogue: 0,0:12:17.08,0:12:20.20,Default,,0,0,0,,Мен бұлай болмағанын қалаймын.
Dialogue: 0,0:12:20.20,0:12:21.93,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:12:24.90,0:12:26.55,Default,,0,0,0,,Уф, ауырып тұр.
Dialogue: 0,0:12:26.99,0:12:29.29,Default,,0,0,0,,Сіз мұны жаңа ғана жасадыңыз.
Dialogue: 0,0:12:32.71,0:12:35.32,Default,,0,0,0,,Күте тұрыңыз, бұл туралы ше?
Dialogue: 0,0:12:35.32,0:12:37.82,Default,,0,0,0,,Бұл енді сізге еніп кетеді.
Dialogue: 0,0:12:39.34,0:12:40.93,Default,,0,0,0,,Не?
Dialogue: 0,0:12:44.37,0:12:47.94,Default,,0,0,0,,А-а, оның қалың болуы мүмкін емес.
Dialogue: 0,0:12:47.94,0:12:49.80,Default,,0,0,0,,Тоқта, тоқта.
Dialogue: 0,0:12:55.77,0:12:58.32,Default,,0,0,0,,Не? Қан шығып жатыр
Dialogue: 0,0:12:58.32,0:13:01.17,Default,,0,0,0,,Сіздің бірінші еркектің әтешінің дәмі қандай?
Dialogue: 0,0:13:01.72,0:13:05.27,Default,,0,0,0,,Әпкем көбірек ауырса керек.
Dialogue: 0,0:13:06.96,0:13:10.51,Default,,0,0,0,,Оны тез немесе басқаша босатыңыз
Dialogue: 0,0:13:11.34,0:13:13.10,Default,,0,0,0,,Жарайды, ол жыртылады.
Dialogue: 0,0:13:13.96,0:13:17.96,Default,,0,0,0,,Жоқ, ауырды.
Dialogue: 0,0:13:17.96,0:13:21.08,Default,,0,0,0,,Не? Сіз өзіңізді зорланғандай сезіне бастадыңыз ба?
Dialogue: 0,0:13:21.08,0:13:25.56,Default,,0,0,0,,Академиялық қоғамның президенті судың осындай ұятсыз дыбысын шығарды.
Dialogue: 0,0:13:25.56,0:13:28.79,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:13:29.38,0:13:34.02,Default,,0,0,0,,Мына азғын төраға! Сүйіспеншілік менің мысығымнан түссін
Dialogue: 0,0:13:36.92,0:13:38.74,Default,,0,0,0,,*Жоқ, Хинасе-кун
Dialogue: 0,0:13:57.48,0:13:59.83,Default,,0,0,0,,Егер сіз тек арқаны кінәласаңыз
Dialogue: 0,0:14:09.99,0:14:11.05,Default,,0,0,0,,Мен оны жіберемін.
Dialogue: 0,0:14:11.05,0:14:15.92,Default,,0,0,0,,Жоқ, жұмыс істемей тұрғанда тоқтасаңыз, тоқтаңыз.
Dialogue: 0,0:14:17.51,0:14:19.00,Default,,0,0,0,,Шәует шығаруға болмайды
Dialogue: 0,0:14:20.39,0:14:23.06,Default,,0,0,0,,Жоқ, оны шығармаңыз.
Dialogue: 0,0:14:24.87,0:14:27.49,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:28.33,0:14:32.23,Default,,0,0,0,,Шынымен іштей
Dialogue: 0,0:14:34.06,0:14:35.79,Default,,0,0,0,,келе жатыр
Dialogue: 0,0:14:36.89,0:14:39.55,Default,,0,0,0,,*Ыстық. Бұл үлкен сома. А, жоқ.
Dialogue: 0,0:14:45.63,0:14:47.19,Default,,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:14:58.27,0:15:00.63,Default,,0,0,0,,Жоқ, артық емес
Dialogue: 0,0:15:06.20,0:15:08.95,Default,,0,0,0,,А, менің ішім жоғары көтерілді.
Dialogue: 0,0:15:11.98,0:15:15.12,Default,,0,0,0,,Жоқ, жоқ, солай.
Dialogue: 0,0:15:22.20,0:15:24.31,Default,,0,0,0,,Әлі алда
Dialogue: 0,0:15:24.31,0:15:26.65,Default,,0,0,0,,Ол күшейе түседі.
Dialogue: 0,0:15:29.83,0:15:31.51,Default,,0,0,0,,Егер сіз соншалықты күшті болуға мәжбүр болсаңыз
Dialogue: 0,0:15:31.91,0:15:33.27,Default,,0,0,0,,Артқы жағындағы
Dialogue: 0,0:15:35.83,0:15:37.49,Default,,0,0,0,,Эгуча жоқ
Dialogue: 0,0:15:38.08,0:15:39.72,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:40.51,0:15:42.27,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:42.56,0:15:43.81,Default,,0,0,0,,Бұл шекке жақын
Dialogue: 0,0:15:44.05,0:15:45.03,Default,,0,0,0,,Мен оны жіберемін.
Dialogue: 0,0:15:45.03,0:15:46.73,Default,,0,0,0,,Мен оны ешқашан шығарамын деп ойламадым.
Dialogue: 0,0:15:47.45,0:15:49.40,Default,,0,0,0,,Ішінде тағы бір нәрсе.
Dialogue: 0,0:15:50.18,0:15:52.24,Default,,0,0,0,,Тоқта, шәует жоқ.
Dialogue: 0,0:15:58.88,0:16:01.58,Default,,0,0,0,,Мен енді онша көп кірмейтін болсам да.
Dialogue: 0,0:16:02.16,0:16:04.01,Default,,0,0,0,,Кері ағын
Dialogue: 0,0:16:07.40,0:16:09.11,Default,,0,0,0,,Сондай-ақ ішінде
Dialogue: 0,0:16:18.39,0:16:19.54,Default,,0,0,0,,Соншалықты
Dialogue: 0,0:16:20.43,0:16:23.27,Default,,0,0,0,,Менің мысығым сынып қалатын сияқты
Dialogue: 0,0:16:26.26,0:16:29.06,Default,,0,0,0,,Менің тамыр соғысым іштей соғып тұр.
Dialogue: 0,0:16:31.65,0:16:34.10,Default,,0,0,0,,Мен тереңірек барамын.
Dialogue: 0,0:16:36.56,0:16:40.15,Default,,0,0,0,,Жоқ, егер сіз мені күштірек етсеңіз, мен күшейтемін.
Dialogue: 0,0:16:41.74,0:16:44.79,Default,,0,0,0,,Одан әрі жүруге әлі ерте.
Dialogue: 0,0:16:53.14,0:16:54.78,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:16:55.30,0:16:56.65,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:16:59.74,0:17:01.86,Default,,0,0,0,,А, келе жатыр!
Dialogue: 0,0:17:03.87,0:17:05.39,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:17:05.39,0:17:06.31,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:17:07.53,0:17:09.32,Default,,0,0,0,,Иә, мен оны өшіремін.
Dialogue: 0,0:17:09.46,0:17:12.99,Default,,0,0,0,,Мен сізге соңғы сығымды беремін.
Dialogue: 0,0:17:13.69,0:17:16.18,Default,,0,0,0,,Ішінен шәует жарылды, сыртқа шығарма.
Dialogue: 0,0:17:16.18,0:17:18.10,Default,,0,0,0,,*Мен де? ? ?
Dialogue: 0,0:17:29.98,0:17:32.90,Default,,0,0,0,,Шәуеттің көп түсуі
Dialogue: 0,0:17:36.83,0:17:40.32,Default,,0,0,0,,Қалың көже толып барады
Dialogue: 0,0:17:40.59,0:17:43.52,Default,,0,0,0,,Құрсағыма көп төгіледі
Dialogue: 0,0:18:06.37,0:18:07.58,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:18:08.72,0:18:10.46,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:10.63,0:18:13.91,Default,,0,0,0,,Кеңеске мән бермей, ойланбастан шайханаға бардым.
Dialogue: 0,0:18:14.58,0:18:17.39,Default,,0,0,0,,Ол мені жүзуге мәжбүр етті, мен ақылсыз болып қалдым.
Dialogue: 0,0:18:17.39,0:18:19.43,Default,,0,0,0,,Мен оны зорладым
Dialogue: 0,0:18:20.23,0:18:24.05,Default,,0,0,0,,Кешіріңіз, мен қараңғы инспектор ретінде дисквалификацияландым.
Dialogue: 0,0:18:24.56,0:18:27.41,Default,,0,0,0,,Мен кез келген жазаны алғым келеді.
Dialogue: 0,0:18:29.76,0:18:31.12,Default,,0,0,0,,Жетеді
Dialogue: 0,0:18:31.12,0:18:34.87,Default,,0,0,0,,Мен оның іс-әрекеті мен қарым-қатынасынан осы уақытқа дейін бір нәрсе үйрендім.
Dialogue: 0,0:18:35.25,0:18:37.51,Default,,0,0,0,,Оның мәні - мазохизм
Dialogue: 0,0:18:38.72,0:18:40.23,Default,,0,0,0,,Басқаша айтқанда, М дегенді қалай түсінесіңдер?
Dialogue: 0,0:18:40.98,0:18:41.92,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:41.92,0:18:45.30,Default,,0,0,0,,Гакусейкайдың еңбегі мен осы оқиғаның маңызы зор.
Dialogue: 0,0:18:45.30,0:18:48.00,Default,,0,0,0,,Ол қатты қиналып жатқанын сезеді.
Dialogue: 0,0:18:48.00,0:18:51.77,Default,,0,0,0,,Санасыз түрде жанқиярлық арқылы тілектерін қанағаттандыруға тырысу
Dialogue: 0,0:18:52.25,0:18:57.89,Default,,0,0,0,,Дегенмен, Вакана Манабе оқиды, жаттығу жасайды және мектепке барады.
Dialogue: 0,0:18:58.21,0:19:02.89,Default,,0,0,0,,Ол бәрін меңгергендіктен, ол өзін толыққанды сезінбейді.
Dialogue: 0,0:19:03.16,0:19:06.55,Default,,0,0,0,,Мен бағынбайтыныма сенемін.
Dialogue: 0,0:19:08.13,0:19:11.93,Default,,0,0,0,,Басқаша айтқанда, Вакана Манабе бағындырғысы келеді.
Dialogue: 0,0:19:11.93,0:19:14.22,Default,,0,0,0,,Сонда сіз мазохизмді айтасыз ба?
Dialogue: 0,0:19:14.55,0:19:18.41,Default,,0,0,0,,Алайда орташа қарсылас оны бағындыра алмайды.
Dialogue: 0,0:19:18.41,0:19:21.06,Default,,0,0,0,,Мұны шешу мүмкін емес, солай ма?
Dialogue: 0,0:19:24.32,0:19:25.47,Default,,0,0,0,,Сіз осындасыз
Dialogue: 0,0:19:26.22,0:19:27.61,Default,,0,0,0,,О, мен?
Dialogue: 0,0:19:29.01,0:19:30.30,Default,,0,0,0,,Кішіпейіл болма
Dialogue: 0,0:19:30.30,0:19:34.82,Default,,0,0,0,,Сіздің ішіңізде бұрын өсірген садизм рухы бар.
Dialogue: 0,0:19:35.79,0:19:38.21,Default,,0,0,0,,Осы уақытқа дейінгі жетістіктер мен сәтсіздіктерге көз жүгіртіп, ойға қалдым
Dialogue: 0,0:19:38.21,0:19:40.30,Default,,0,0,0,,Сіз басқаларды қорлайсыз
Dialogue: 0,0:19:40.30,0:19:42.26,Default,,0,0,0,,Сексуалдық қозу бар сияқты
Dialogue: 0,0:19:43.25,0:19:46.71,Default,,0,0,0,,Басқа адамның денесін күштеп қосу арқылы түсінуге тырысу
Dialogue: 0,0:19:46.71,0:19:50.85,Default,,0,0,0,,Масохисттің көзқарасы бойынша ол идеал садист.
Dialogue: 0,0:19:51.29,0:19:54.03,Default,,0,0,0,,Егер сіз өзіңіздің талантыңызды 100% көрсете алсаңыз
Dialogue: 0,0:19:54.03,0:19:57.22,Default,,0,0,0,,Вакана Манабенің жалықтыруға уақыты болмайды, солай ма?
Dialogue: 0,0:19:58.04,0:20:03.34,Default,,0,0,0,,Әйел жынысының дәмін татып, оның ләззатына батқандар одан құтыла алмайды.
Dialogue: 0,0:20:05.30,0:20:09.44,Default,,0,0,0,,Вакана Манабе міндетті түрде Киошироға оралады.
Dialogue: 0,0:20:14.85,0:20:17.32,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:20:36.07,0:20:38.57,Default,,0,0,0,,Жоқ, ол бұзылады.
Dialogue: 0,0:20:38.57,0:20:40.31,Default,,0,0,0,,Бұл бөлік бөлінеді.
Dialogue: 0,0:20:40.31,0:20:44.01,Default,,0,0,0,,Сіздің денеңіздің ләззат алуға төзімділігі тым аз.
Dialogue: 0,0:20:44.01,0:20:47.52,Default,,0,0,0,,Ендеше, бұдан былай көңіліңіз қалағанша ләззат алыңыз.
Dialogue: 0,0:20:48.01,0:20:53.02,Default,,0,0,0,,Әй, өтінемін, алыңыз, мен мұны істей алмаймын, мен алмаймын.
Dialogue: 0,0:20:54.74,0:20:55.77,Default,,0,0,0,,Оны аласың ба?
Dialogue: 0,0:20:56.09,0:20:59.71,Default,,0,0,0,,Сіз шынымен сіздің анусыңызды осылай алғанымды қалайсыз ба?
Dialogue: 0,0:21:09.41,0:21:13.84,Default,,0,0,0,,Жоқ, ол бұзылады. Барайық!
Dialogue: 0,0:21:14.39,0:21:15.63,Default,,0,0,0,,Сүт бездері
Dialogue: 0,0:21:16.24,0:21:18.70,Default,,0,0,0,,Тоқта, тоқта
Dialogue: 0,0:21:18.70,0:21:21.71,Default,,0,0,0,,Оның пәктігін алып тастау өте жақсы болды.
Dialogue: 0,0:21:21.71,0:21:24.00,Default,,0,0,0,,Мына пәк қыз ше?
Dialogue: 0,0:21:24.00,0:21:26.51,Default,,0,0,0,,Бұл мүмкін емес. Менің бөксесі ол жерге сыймайды.
Dialogue: 0,0:21:26.51,0:21:28.31,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:21:28.58,0:21:30.11,Default,,0,0,0,,Артық емес
Dialogue: 0,0:21:37.00,0:21:38.27,Default,,0,0,0,,Ауырсыну
Dialogue: 0,0:21:38.76,0:21:40.38,Default,,0,0,0,,Жүр, қозғалайық.
Dialogue: 0,0:21:42.91,0:21:46.34,Default,,0,0,0,,Ол бұзылады. Ол бұзылады.
Dialogue: 0,0:21:48.91,0:21:52.17,Default,,0,0,0,,Қан, қан ауырады
Dialogue: 0,0:21:52.17,0:21:54.88,Default,,0,0,0,,Қаншалықты харизматикалық болса да, боқ лас.
Dialogue: 0,0:21:54.88,0:21:56.86,Default,,0,0,0,,Дөрекі сөздер айтпа
Dialogue: 0,0:21:58.68,0:22:02.80,Default,,0,0,0,,Менің бөксемді кешіріңіз, өйткені мен қозғала алмаймын және ол ауырады.
Dialogue: 0,0:22:03.39,0:22:04.85,Default,,0,0,0,,Мына азғын әйел
Dialogue: 0,0:22:04.85,0:22:09.10,Default,,0,0,0,,Киоширо! Сол мегитсунды аспанға апарыңыз
Dialogue: 0,0:22:09.69,0:22:13.17,Default,,0,0,0,,Мектеп кеңесінің төрағасы скучно және скучно сезінбей тұра алмайды.
Dialogue: 0,0:22:13.17,0:22:15.40,Default,,0,0,0,,Мен оны қабылдап, орындаймын.
Dialogue: 0,0:22:15.99,0:22:19.04,Default,,0,0,0,,*Иә, мықтап қазып алыңыз. Бөксенің іші жақсы ма? ? ? ?
Dialogue: 0,0:22:19.04,0:22:21.35,Default,,0,0,0,,Мұндай эротикалық әйел жоқ.
Dialogue: 0,0:22:24.29,0:22:26.63,Default,,0,0,0,,Менің бөксемде
Dialogue: 0,0:22:27.20,0:22:28.38,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:22:29.13,0:22:31.25,Default,,0,0,0,,Мен есектегі есек
Dialogue: 0,0:22:33.71,0:22:36.11,Default,,0,0,0,,Мен-барамын, бөксесімен барамын.
Dialogue: 0,0:22:37.64,0:22:41.65,Default,,0,0,0,,Мен сіздің лас анусыңыздың ішіне кіремін.
Dialogue: 0,0:22:50.45,0:22:54.37,Default,,0,0,0,,Ал, ол әлі шығып жатыр.
Dialogue: 0,0:23:00.22,0:23:03.78,Default,,0,0,0,,Бұл мені өлтіреді
Dialogue: 0,0:23:13.70,0:23:18.96,Default,,0,0,0,,Тәніңізде сақтаған барлық қараңғылықты ләззатпен түкіріп тастаңыз.
Dialogue: 0,0:23:21.12,0:23:23.31,Default,,0,0,0,,кел, кел
Dialogue: 0,0:23:38.47,0:23:40.68,Default,,0,0,0,,Хмм, біткен сияқты.
Dialogue: 0,0:23:41.42,0:23:43.49,Default,,0,0,0,,Бұл жігіт іздеген сараңдық
Dialogue: 0,0:23:43.49,0:23:45.30,Default,,0,0,0,,Тым көп зерігу
Dialogue: 0,0:23:45.54,0:23:47.78,Default,,0,0,0,,Кёичироның қолдарымен толтырылған
Dialogue: 0,0:23:47.78,0:23:51.49,Default,,0,0,0,,Бұл шынымен де сәтті болды.
Dialogue: 0,0:24:05.34,0:24:08.30,Default,,0,0,0,,Менің тапсырмам орындалды, менің саған бұдан артық пайдасы жоқ.
Dialogue: 0,0:24:08.66,0:24:11.68,Default,,0,0,0,,Сіз енді қараңғылықпен байланыссыз.
Dialogue: 0,0:24:11.68,0:24:14.21,Default,,0,0,0,,Бұдан былай нұрлы жолмен жүр.
Dialogue: 0,0:24:14.46,0:24:16.05,Default,,0,0,0,,Жарайды, сау болдың деп үміттенемін.
Dialogue: 0,0:24:19.64,0:24:21.10,Default,,0,0,0,,Ямико-сан
Dialogue: 0,0:24:23.02,0:24:26.23,Default,,0,0,0,,Әпкем жоғалып кеткенде, Ямико сонда болды.
Dialogue: 0,0:24:26.73,0:24:30.15,Default,,0,0,0,,Ямико-сан кеткенде, менің айналамда ешкім жоқ.
Dialogue: 0,0:24:30.84,0:24:32.83,Default,,0,0,0,,Мен осы уақытқа дейін не істедім
Dialogue: 0,0:24:39.77,0:24:40.79,Default,,0,0,0,,Кио-чан!
Dialogue: 0,0:24:42.24,0:24:43.09,Default,,0,0,0,,Апа
Dialogue: 0,0:24:45.14,0:24:48.03,Default,,0,0,0,,Мен жай ғана Кио Чанмен танысқым келді.
Dialogue: 0,0:24:48.83,0:24:51.82,Default,,0,0,0,,Ауруханадан қалай қаштыңыз?
Dialogue: 0,0:24:52.62,0:24:56.13,Default,,0,0,0,,Жоқ, сіз Ширайши мырзадан ештеңе естіген жоқсыз ба?
Dialogue: 0,0:24:56.32,0:24:58.43,Default,,0,0,0,,Мен жаңа ғана ауруханадан шықтым.
Dialogue: 0,0:24:58.98,0:25:01.22,Default,,0,0,0,,Сонда сен мені таң қалдырдың.
Dialogue: 0,0:25:01.69,0:25:06.08,Default,,0,0,0,,Ол тосын сый жасау үшін үндемей қалған шығар.
Dialogue: 0,0:25:06.67,0:25:10.00,Default,,0,0,0,,Мен Ширайши мырзадан әр түрлі әңгімелердің бәрін естідім.
Dialogue: 0,0:25:10.23,0:25:11.97,Default,,0,0,0,,Мұғалім кешірім сұрады.
Dialogue: 0,0:25:12.21,0:25:15.03,Default,,0,0,0,,Кио Чанды өз жұмысыма қатыстыру
Dialogue: 0,0:25:15.03,0:25:17.50,Default,,0,0,0,,Кешірім сұраудың қажеті жоқ
Dialogue: 0,0:25:18.16,0:25:20.74,Default,,0,0,0,,Мен апам үшін кек алдым.
Dialogue: 0,0:25:21.08,0:25:23.58,Default,,0,0,0,,Бірақ мені кекшіл жын болудан не құтқарды
Dialogue: 0,0:25:23.58,0:25:25.32,Default,,0,0,0,,Ямико-санға осында болғаныңыз үшін рахмет.
Dialogue: 0,0:25:25.32,0:25:28.27,Default,,0,0,0,,Мен кек алғым келмеді
Dialogue: 0,0:25:28.47,0:25:31.77,Default,,0,0,0,,Мені қорғауға бар күшіңді салғаныңды білемін.
Dialogue: 0,0:25:32.28,0:25:38.54,Default,,0,0,0,,Бірақ мен Кио Чанның ренжігеніне немесе менің кесірімнен басқалардың ренжігеніне шыдай алмаймын деп ойлаймын.
Dialogue: 0,0:25:39.56,0:25:43.76,Default,,0,0,0,,Жарайды, мен ешқашан апамды мұңайтатын ештеңе жасамаймын.
Dialogue: 0,0:25:44.63,0:25:47.09,Default,,0,0,0,,Әпкең не десе, соны тыңдаймын.
Dialogue: 0,0:25:47.83,0:25:50.96,Default,,0,0,0,,Олай болса, мен сізге бірден жақсылық сұрай аламын ба?
Dialogue: 0,0:26:01.48,0:26:03.82,Default,,0,0,0,,Жыныс мүшесі дегеніміз не?
Dialogue: 0,0:26:04.41,0:26:07.90,Default,,0,0,0,,Әй, анау апа не істеп жүр?
Dialogue: 0,0:26:08.60,0:26:12.78,Default,,0,0,0,,Кешіріңіз, Кио Чан кішкентай кезінде.
Dialogue: 0,0:26:13.16,0:26:15.86,Default,,0,0,0,,Бірге шомылғаннан бері.
Dialogue: 0,0:26:15.86,0:26:19.06,Default,,0,0,0,,Сен есейдің, аздап шошып кеттім.
Dialogue: 0,0:26:20.03,0:26:23.20,Default,,0,0,0,,Көп нәрсені есте сақтайтыныңызға сенімдімін.
Dialogue: 0,0:26:24.38,0:26:26.23,Default,,0,0,0,,Мен енді қарай алмаймын
Dialogue: 0,0:26:29.79,0:26:31.84,Default,,0,0,0,,Мен саған не болғанын білемін.
Dialogue: 0,0:26:32.49,0:26:33.94,Default,,0,0,0,,Сіз еркектерден қорқасыз ба?
Dialogue: 0,0:26:34.28,0:26:36.30,Default,,0,0,0,,Сонда өзіңді итермелеудің қажеті жоқ.
Dialogue: 0,0:26:36.74,0:26:39.43,Default,,0,0,0,,Маған інісіндей қарасаң.
Dialogue: 0,0:26:40.92,0:26:43.71,Default,,0,0,0,,Менің ұлдардан қорқатыным рас.
Dialogue: 0,0:26:44.13,0:26:48.29,Default,,0,0,0,,Киочан менің інім, бірақ ол мен үшін ерекше.
Dialogue: 0,0:26:48.54,0:26:51.12,Default,,0,0,0,,Мен әрқашан Кио Чан туралы ойлайтынмын
Dialogue: 0,0:26:52.05,0:26:55.24,Default,,0,0,0,,Мен де сенің әпкеңді ойлап жүрдім.
Dialogue: 0,0:26:56.57,0:26:58.36,Default,,0,0,0,,Иә, мен мұны білдім.
Dialogue: 0,0:26:58.36,0:27:01.05,Default,,0,0,0,,Мен Кио Чанды енді ешқашан жібермеймін
Dialogue: 0,0:27:01.33,0:27:04.07,Default,,0,0,0,,Олай болса, иә.
Dialogue: 0,0:27:06.32,0:27:07.67,Default,,0,0,0,,Мұның жалғасы
Dialogue: 0,0:27:07.77,0:27:08.94,Default,,0,0,0,,Аты Аспан
Dialogue: 0,0:27:09.06,0:27:10.68,Default,,0,0,0,,Емізік тозағы
Dialogue: 0,0:27:10.83,0:27:11.77,Default,,0,0,0,,Бинауральды
Dialogue: 0,0:27:11.86,0:27:14.44,Default,,0,0,0,,Жасырын сөзді сыбырлайтын бонустық CD-де.
Dialogue: 0,0:27:15.94,0:27:21.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory