Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.59,0:00:06.09,Default,,0,0,0,,Кибитсу Гакуэн, мұнда тек үздік студенттер қабылданады
Dialogue: 0,0:00:07.19,0:00:10.81,Default,,0,0,0,,Бұл мектептегі еркін атмосферасы бар атақты дайындық мектебі.
Dialogue: 0,0:00:11.81,0:00:19.95,Default,,0,0,0,,Кибитсу Гакуен қаласында үш студент қыздан тұратын «Гакусейкай» деп аталатын автономды топ болды.
Dialogue: 0,0:00:20.40,0:00:27.39,Default,,0,0,0,,Олар элитаның элитасы, оларға ешкім қарсы шыға алмайды.
Dialogue: 0,0:00:29.84,0:00:33.38,Default,,0,0,0,,Мұғалім болса да
Dialogue: 0,0:00:37.28,0:00:39.08,Default,,0,0,0,,Сіз
Dialogue: 0,0:00:40.68,0:00:42.65,Default,,0,0,0,,Мен тым көп білдім, солай емес пе?
Dialogue: 0,0:00:44.53,0:00:46.55,Default,,0,0,0,,Ақымақ нәрселерге еліктеуді доғар
Dialogue: 0,0:00:52.70,0:00:54.11,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:00:57.37,0:00:58.35,Default,,0,0,0,,Шулы
Dialogue: 0,0:00:59.43,0:01:03.28,Default,,0,0,0,,Жоқ, біреу, біреу маған көмектесіңізші.
Dialogue: 0,0:01:03.84,0:01:06.27,Default,,0,0,0,,Маған көмектес, Кио Чан
Dialogue: 0,0:01:07.89,0:01:08.82,Default,,0,0,0,,Әпке?
Dialogue: 0,0:01:11.38,0:01:13.30,Default,,0,0,0,,Соңғы кездері үйге кеш қайтып жүрмін.
Dialogue: 0,0:01:14.01,0:01:14.96,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:01:15.58,0:01:17.10,Default,,0,0,0,,Менің жігітім бар
Dialogue: 0,0:01:17.10,0:01:19.20,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:01:19.70,0:01:22.93,Default,,0,0,0,,10 жыл болды ма?
Dialogue: 0,0:01:23.62,0:01:27.14,Default,,0,0,0,,Әпкем екеуміз биологиялық ағайынды емеспіз.
Dialogue: 0,0:01:27.14,0:01:29.49,Default,,0,0,0,,Олар ерлі-зайыптылардың өгей балалары.
Dialogue: 0,0:01:29.81,0:01:32.79,Default,,0,0,0,,Бірақ әке-шешем апаттан қайтыс болған кезде
Dialogue: 0,0:01:33.17,0:01:34.92,Default,,0,0,0,,Әлі студент болған апам,
Dialogue: 0,0:01:34.92,0:01:37.70,Default,,0,0,0,,Жұмыс істегенде өзін дамытамын деді.
Dialogue: 0,0:01:38.38,0:01:41.65,Default,,0,0,0,,Маған неге сонша сезімталсың, апа?
Dialogue: 0,0:01:42.30,0:01:44.68,Default,,0,0,0,,Әпке күннен күнге сұлуланып барады
Dialogue: 0,0:01:44.68,0:01:47.26,Default,,0,0,0,,Маған қатты ұнайды
Dialogue: 0,0:01:47.56,0:01:49.29,Default,,0,0,0,,Шынымды айтсам, мен оны жақсы көремін.
Dialogue: 0,0:01:49.29,0:01:52.96,Default,,0,0,0,,Жас әрі әдемі әйел мұғалім менің әпкем.
Dialogue: 0,0:01:52.96,0:01:57.37,Default,,0,0,0,,Мен бұл азапты эмоцияларды қайда шығаруым керек?
Dialogue: 0,0:01:57.37,0:02:00.53,Default,,0,0,0,,Мен енді шыдай алмаймын.
Dialogue: 0,0:02:01.76,0:02:02.87,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:04.89,0:02:07.51,Default,,0,0,0,,Оқу және жақсы компанияға қосылу
Dialogue: 0,0:02:07.51,0:02:11.35,Default,,0,0,0,,Мен жақсы жалақы алдым, сосын апам екеуміз
Dialogue: 0,0:02:25.88,0:02:28.11,Default,,0,0,0,,тым кеш шығар.
Dialogue: 0,0:02:28.81,0:02:30.52,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:02:32.05,0:02:34.68,Default,,0,0,0,,Сіздің кеудеңіз әдемі, Хинасе мырза.
Dialogue: 0,0:02:34.68,0:02:37.05,Default,,0,0,0,,*Ол жерді түртіңіз.
Dialogue: 0,0:02:37.88,0:02:40.03,Default,,0,0,0,,Сіз оны шынымен сезінесіз, солай ма?
Dialogue: 0,0:02:40.03,0:02:42.95,Default,,0,0,0,,Оның кеуделері сондай керемет!
Dialogue: 0,0:02:47.28,0:02:50.15,Default,,0,0,0,,Бұл әрекетті қазір тоқтатыңыз
Dialogue: 0,0:02:50.15,0:02:54.50,Default,,0,0,0,,Оқушыларымның қылмыскер болғанын қаламаймын.
Dialogue: 0,0:02:56.33,0:02:58.44,Default,,0,0,0,,Бұл шулы ауыз.
Dialogue: 0,0:02:59.76,0:03:02.80,Default,,0,0,0,,Бұл күш қанша уақытқа созылады?
Dialogue: 0,0:03:03.84,0:03:08.88,Default,,0,0,0,,Тоқтатыңызшы, болды.
Dialogue: 0,0:03:10.01,0:03:14.31,Default,,0,0,0,,Жоқ, өтінемін, Кио-чан, Кио-чан, маған көмектес!
Dialogue: 0,0:03:14.31,0:03:17.38,Default,,0,0,0,,Қараңдар, мен мұны көп жасаймын!
Dialogue: 0,0:03:25.41,0:03:29.46,Default,,0,0,0,,Бұл қан емес пе? Саки Чан пәк қыз болған.
Dialogue: 0,0:03:31.82,0:03:33.79,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:03:33.79,0:03:35.40,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:03:35.76,0:03:39.50,Default,,0,0,0,,Бұл ауыр көрінеді! Бұл қыздың қаны ма?
Dialogue: 0,0:03:40.40,0:03:42.35,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:03:43.53,0:03:47.71,Default,,0,0,0,,Мен сізді одан да жақсы сезінуге мүмкіндік беремін.
Dialogue: 0,0:03:47.71,0:03:50.33,Default,,0,0,0,,Менің ойыма ештеңе келмейді
Dialogue: 0,0:03:51.14,0:03:55.76,Default,,0,0,0,,Енді жоқ, Кио-чан, Кио-чан, Кио-чан!
Dialogue: 0,0:03:56.81,0:04:02.36,Default,,0,0,0,,Ей, уақыт болды, кілегеймен аяқтаймыз.
Dialogue: 0,0:04:02.36,0:04:05.55,Default,,0,0,0,,Кремпи - бұл тек кремпи
Dialogue: 0,0:04:05.97,0:04:08.05,Default,,0,0,0,,Әй, кеттік!
Dialogue: 0,0:04:13.25,0:04:17.19,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:28.70,0:04:31.08,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:04:33.11,0:04:35.59,Default,,0,0,0,,Сәлем әпке
Dialogue: 0,0:04:35.59,0:04:38.27,Default,,0,0,0,,Эй, сен қайдасың?
Dialogue: 0,0:04:56.90,0:04:58.59,Default,,0,0,0,,Сіз
Dialogue: 0,0:05:15.78,0:05:18.59,Default,,0,0,0,,Сонда ``Гакусейкай'' әпкеңе қамқор болды ма?
Dialogue: 0,0:05:19.37,0:05:23.81,Default,,0,0,0,,Бұл дүниеде сен білмесең бақытты болатын нәрселер көп.
Dialogue: 0,0:05:27.85,0:05:32.02,Default,,0,0,0,,Хинасе мырзаға ұқсағың келмесе, тым тереңге түспе.
Dialogue: 0,0:05:32.73,0:05:34.16,Default,,0,0,0,,Ал, күте тұрыңыз.
Dialogue: 0,0:05:34.16,0:05:38.26,Default,,0,0,0,,Мен әпкемнің осы жағдайға ұшырауына себеп болған Гакусейкайдың қараңғы жағын ашқым келеді.
Dialogue: 0,0:05:38.26,0:05:40.34,Default,,0,0,0,,Өтінемін, мен бәрін істеймін
Dialogue: 0,0:05:42.20,0:05:46.25,Default,,0,0,0,,Бұл сұмдық адамдарды осылай жалғыз қалдыра алмаймыз.
Dialogue: 0,0:05:47.69,0:05:52.33,Default,,0,0,0,,Мм, сен қараңғы инспектордың жұмысын білесің бе?
Dialogue: 0,0:05:53.68,0:05:55.48,Default,,0,0,0,,Бұл Манабе-сан.
Dialogue: 0,0:05:55.76,0:05:57.22,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:05:58.54,0:05:59.84,Default,,0,0,0,,Қайда қарап тұрсың?
Dialogue: 0,0:06:06.33,0:06:08.73,Default,,0,0,0,,Вакана Манабе
Dialogue: 0,0:06:09.43,0:06:11.72,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:06:11.72,0:06:12.83,Default,,0,0,0,,Кешіктірмеңіз
Dialogue: 0,0:06:12.83,0:06:14.30,Default,,0,0,0,,Иә, мен білмей тұрып
Dialogue: 0,0:06:14.30,0:06:19.34,Default,,0,0,0,,“Гакусейкай” – Кибитсу Гакуэнді басқаратын және басқаратын ұйым.
Dialogue: 0,0:06:19.34,0:06:26.51,Default,,0,0,0,,Үш студент өкілі орталықта және мұғалімдерге немесе ПТА-ға қарағанда көбірек билікке ие деп айтылады.
Dialogue: 0,0:06:26.51,0:06:32.21,Default,,0,0,0,,Осы уақытта, сахна артында зорлық-зомбылық және жасырын қайырымдылық сияқты алаңдатарлық қауесеттер сыбырлап жатыр.
Dialogue: 0,0:06:32.21,0:06:36.30,Default,,0,0,0,,Вакана Манабе үш өкілдің арасында
Dialogue: 0,0:06:36.30,0:06:39.44,Default,,0,0,0,,Гакусейкайдың төрағасы және директоры және шай рәсімі клубының жетекшісі.
Dialogue: 0,0:06:39.44,0:06:41.13,Default,,0,0,0,,Төрағаның немересі.
Dialogue: 0,0:06:41.13,0:06:44.24,Default,,0,0,0,,Ол харизматикалық және айналасындағылардан үлкен үміт күтеді.
Dialogue: 0,0:06:44.24,0:06:46.31,Default,,0,0,0,,Ол сенімді оқушы.
Dialogue: 0,0:06:47.42,0:06:49.33,Default,,0,0,0,,Вакана Манабеден басқа
Dialogue: 0,0:06:49.33,0:06:50.80,Default,,0,0,0,,Джун Котобишима
Dialogue: 0,0:06:50.80,0:06:54.75,Default,,0,0,0,,Ол тәртіптік комитеттің 3-курс төрағасы және өсіп келе жатқан жаңа пұт.
Dialogue: 0,0:06:54.75,0:06:56.71,Default,,0,0,0,,Тек анда-санда келетін болса да
Dialogue: 0,0:06:56.71,0:06:58.97,Default,,0,0,0,,Мектепте өте танымал
Dialogue: 0,0:06:58.97,0:07:01.75,Default,,0,0,0,,Жанкүйерлер арасындағы ынтымақтастық өте күшті.
Dialogue: 0,0:07:02.60,0:07:04.55,Default,,0,0,0,,Соңында Рокукучику
Dialogue: 0,0:07:04.55,0:07:08.33,Default,,0,0,0,,Бірінші курс студенті болса да спорттық директор болып тағайындалды.
Dialogue: 0,0:07:08.33,0:07:11.52,Default,,0,0,0,,Жеңіл атлетика клубында көптеген рекордтар жасау
Dialogue: 0,0:07:11.53,0:07:17.00,Default,,0,0,0,,Ол данышпан атлетикалық қабілет пен кішкентай жануар сияқты сүйкімділік арасындағы алшақтықтан танымал болған сияқты.
Dialogue: 0,0:07:17.75,0:07:21.56,Default,,0,0,0,,Алдымен, жауыңды білуден баста.
Dialogue: 0,0:07:21.56,0:07:22.56,Default,,0,0,0,,Ең алдымен
Dialogue: 0,0:07:23.41,0:07:26.30,Default,,0,0,0,,Байланыс жасалуы керек
Dialogue: 0,0:07:29.37,0:07:30.72,Default,,0,0,0,,I-itata!
Dialogue: 0,0:07:31.80,0:07:33.09,Default,,0,0,0,,Ямимару мырза
Dialogue: 0,0:07:33.09,0:07:34.78,Default,,0,0,0,,Сол Айтатата
Dialogue: 0,0:07:34.78,0:07:36.08,Default,,0,0,0,,Ауырды, төменге түсе аласыз ба?
Dialogue: 0,0:07:36.08,0:07:39.97,Default,,0,0,0,,Бұл күзеннің керемет аты Ямимару-сан.
Dialogue: 0,0:07:39.97,0:07:43.20,Default,,0,0,0,,Мен әрқашан Ямиконың басында отырамын және үндемеймін.
Dialogue: 0,0:07:43.20,0:07:45.70,Default,,0,0,0,,Ашуланғанда тістеп алады, өзін ұстай алмай қалады.
Dialogue: 0,0:07:47.55,0:07:50.79,Default,,0,0,0,,Ямимару мырза тітіркеніп, ашулы.
Dialogue: 0,0:07:50.79,0:07:51.84,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:51.84,0:07:54.68,Default,,0,0,0,,Келіңіз де, сәлем беріңіз!
Dialogue: 0,0:07:54.68,0:07:56.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:02.27,0:08:03.43,Default,,0,0,0,,Осы сатыға разы емессің бе?
Dialogue: 0,0:08:03.48,0:08:04.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:04.56,0:08:06.69,Default,,0,0,0,,Кешіріңіз, бұл менің айтқым келгенім емес.
Dialogue: 0,0:08:09.65,0:08:14.24,Default,,0,0,0,,Сонша кешірім сұрасаң, енді ашуланбайсың, солай ма?
Dialogue: 0,0:08:16.50,0:08:18.34,Default,,0,0,0,,Айтпақшы, ашығын сұрайын.
Dialogue: 0,0:08:18.34,0:08:20.64,Default,,0,0,0,,Манабеден қандай әсер алдың?
Dialogue: 0,0:08:20.64,0:08:24.59,Default,,0,0,0,,Президенттің әпкеме шабуыл жасауға рұқсат бергеніне сене алар емеспін.
Dialogue: 0,0:08:24.59,0:08:26.94,Default,,0,0,0,,Студенттердің өкілдері онша жақсы емес.
Dialogue: 0,0:08:26.94,0:08:28.08,Default,,0,0,0,,Мүмкін солай
Dialogue: 0,0:08:28.70,0:08:31.43,Default,,0,0,0,,Вакана Манабе – үздік студент.
Dialogue: 0,0:08:31.43,0:08:33.71,Default,,0,0,0,,Ол көшбасшылығы күшті әйел.
Dialogue: 0,0:08:34.44,0:08:35.51,Default,,0,0,0,,Иә
Dialogue: 0,0:08:37.10,0:08:40.90,Default,,0,0,0,,Бірақ әрбір адамда екі жақты табиғат бар.
Dialogue: 0,0:08:41.69,0:08:46.17,Default,,0,0,0,,Егер сіз мұны көре алмасаңыз, сіз қараңғы инспектор қызметін атқара алмайсыз.
Dialogue: 0,0:08:48.38,0:08:49.88,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:09:00.32,0:09:03.07,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:09:03.66,0:09:05.25,Default,,0,0,0,,Буси!
Dialogue: 0,0:09:06.91,0:09:08.78,Default,,0,0,0,,Котобишима Сенпай
Dialogue: 0,0:09:10.24,0:09:12.75,Default,,0,0,0,,Сіз сенімдісіз бе? векторда
Dialogue: 0,0:09:12.75,0:09:15.74,Default,,0,0,0,,Р нүктесі АВ түзуінде болуы үшін
Dialogue: 0,0:09:16.09,0:09:18.40,Default,,0,0,0,,Математика мұғалімі Микадо Какуи
Dialogue: 0,0:09:18.40,0:09:20.90,Default,,0,0,0,,Әпкеммен салыстырмалы түрде жақын болған адам.
Dialogue: 0,0:09:21.53,0:09:24.68,Default,,0,0,0,,Ер адамның көзқарасы бойынша ол дөрекі қарт сияқты көрінеді.
Dialogue: 0,0:09:24.68,0:09:27.08,Default,,0,0,0,,Қыздар арасында танымал сияқты.
Dialogue: 0,0:09:29.64,0:09:32.78,Default,,0,0,0,,Мүмкін апаң да ағаңды ойлап жүрген шығар?
Dialogue: 0,0:09:35.62,0:09:36.99,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:09:39.57,0:09:41.35,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:42.52,0:09:44.91,Default,,0,0,0,,Бүгін таңертеңгі артқы көрініс
Dialogue: 0,0:09:44.91,0:09:50.21,Default,,0,0,0,,Ал, мен біраз уақытқа жұмысты тоқтатып, бар ойымды сабаққа аударуды жоспарлап отырмын.
Dialogue: 0,0:09:50.21,0:09:52.69,Default,,0,0,0,,Хмм, бұл жақсы болар еді.
Dialogue: 0,0:09:53.50,0:09:56.34,Default,,0,0,0,,Жақсы басшылық бергеніңіз үшін рахмет.
Dialogue: 0,0:09:56.34,0:09:58.31,Default,,0,0,0,,Шашым қатты қатайып қалады, сондықтан шомылғым келмейді.
Dialogue: 0,0:09:59.48,0:10:02.65,Default,,0,0,0,,А, біз бүгін таңертең кездестік, солай ма?
Dialogue: 0,0:10:02.65,0:10:04.23,Default,,0,0,0,,А, иә
Dialogue: 0,0:10:04.30,0:10:06.58,Default,,0,0,0,,Ылғалды, көзім нашар.
Dialogue: 0,0:10:06.92,0:10:10.57,Default,,0,0,0,,Сондықтан жақыннан бір нәрсеге қараған кезде көзілдірікті шешесіз.
Dialogue: 0,0:10:11.05,0:10:13.18,Default,,0,0,0,,Эй, сенің атың кім?
Dialogue: 0,0:10:13.18,0:10:15.42,Default,,0,0,0,,Ой, мен Киоширомын.
Dialogue: 0,0:10:15.42,0:10:19.26,Default,,0,0,0,,Танысқаныма қуаныштымын, Кёичиро-кун
Dialogue: 0,0:10:19.26,0:10:21.18,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:10:21.69,0:10:23.44,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:10:25.30,0:10:27.16,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:10:27.71,0:10:29.09,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:10:30.34,0:10:32.36,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:10:32.46,0:10:33.74,Default,,0,0,0,,Хинасе мырза кім?
Dialogue: 0,0:10:34.14,0:10:36.37,Default,,0,0,0,,Шабуылдың шокынан демалып жатқан сияқты.
Dialogue: 0,0:10:36.37,0:10:37.17,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:10:37.17,0:10:39.22,Default,,0,0,0,,Моги мақтанышпен сөйледі.
Dialogue: 0,0:10:39.22,0:10:41.72,Default,,0,0,0,,Хинасе мырза мен оны әйелге айналдырдым дейді.
Dialogue: 0,0:10:41.72,0:10:46.54,Default,,0,0,0,,Бұл сіз бе? Мұғалімдер де ең нашар, осындай нәрсеге шабуыл жасайды.
Dialogue: 0,0:10:46.54,0:10:50.81,Default,,0,0,0,,Бірақ осы күндері маған шабуыл жасалса, ауруханаға түсемін бе?
Dialogue: 0,0:10:50.81,0:10:51.73,Default,,0,0,0,,Балалар
Dialogue: 0,0:10:52.21,0:10:52.90,Default,,0,0,0,,Эй
Dialogue: 0,0:10:54.28,0:10:58.86,Default,,0,0,0,,Әлсіз әйел мұғалімнің сабақтан кейін жалғыз қалуы қауіпті.
Dialogue: 0,0:10:59.61,0:11:01.02,Default,,0,0,0,,Тым көп
Dialogue: 0,0:11:01.02,0:11:03.52,Default,,0,0,0,,Сонымен, менің қандай кәсіпім бар?
Dialogue: 0,0:11:03.52,0:11:05.82,Default,,0,0,0,,Хинасе мұғалім туралы айтар сөзім бар.
Dialogue: 0,0:11:05.82,0:11:08.11,Default,,0,0,0,,Сіз оны соңғы рет қашан көрдіңіз?
Dialogue: 0,0:11:08.11,0:11:10.60,Default,,0,0,0,,А, бұл эротикалық болды.
Dialogue: 0,0:11:11.09,0:11:14.18,Default,,0,0,0,,Менің дәу баламды (ұлымның жыныс мүшесін) соған салсаң
Dialogue: 0,0:11:14.18,0:11:16.65,Default,,0,0,0,,Жылау және жылау
Dialogue: 0,0:11:17.93,0:11:21.91,Default,,0,0,0,,Дегенмен, сізді мұндай жерге шақыру ұят болар еді.
Dialogue: 0,0:11:21.91,0:11:24.37,Default,,0,0,0,,Сені шынымен зорлағанымды қалайсың ба?
Dialogue: 0,0:11:28.02,0:11:29.12,Default,,0,0,0,,Ұят болды
Dialogue: 0,0:11:29.12,0:11:31.76,Default,,0,0,0,,Сен сияқты қоқыс жиренішті.
Dialogue: 0,0:11:34.78,0:11:36.10,Default,,0,0,0,,'Егер мен Польнареффтің мұрнына саусағымды тығып қойсам ➡
Dialogue: 0,0:11:47.85,0:11:49.73,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:11:51.22,0:11:55.57,Default,,0,0,0,,Сәттілік немесе сәтсіздік
Dialogue: 0,0:11:55.57,0:12:00.05,Default,,0,0,0,,Енді менің білгенімді құсқанымды қалайсың ба?
Dialogue: 0,0:12:00.80,0:12:05.39,Default,,0,0,0,,Қобисиманың бұйырғанын орындадық.
Dialogue: 0,0:12:06.08,0:12:08.54,Default,,0,0,0,,Оған ешкім қарсы тұра алмайды.
Dialogue: 0,0:12:10.42,0:12:12.92,Default,,0,0,0,,Енді нені зерттейтінімізді шештік.
Dialogue: 0,0:12:12.92,0:12:14.76,Default,,0,0,0,,Көбішіма-сенпай?
Dialogue: 0,0:12:15.46,0:12:18.10,Default,,0,0,0,,Жарайды, айналадан сұрайын.
Dialogue: 0,0:12:18.10,0:12:20.73,Default,,0,0,0,,Мектепте оның жанкүйерлері аз болуы мүмкін.
Dialogue: 0,0:12:20.73,0:12:22.06,Default,,0,0,0,,Мүмкін оның мақсаты – Эренді жеп қою.
Dialogue: 0,0:12:22.06,0:12:25.33,Default,,0,0,0,,Жанкүйерлер туралы ақпаратты жинасаңыз да, сіз фактілерді көре алмайсыз.
Dialogue: 0,0:12:25.33,0:12:27.83,Default,,0,0,0,,Онымен тікелей байланысыңыз
Dialogue: 0,0:12:33.10,0:12:35.82,Default,,0,0,0,,Сәлем? Жарайды емес пе?
Dialogue: 0,0:12:35.82,0:12:39.91,Default,,0,0,0,,Мен сені әрқашан жақсы деп ойлайтынмын.
Dialogue: 0,0:12:40.82,0:12:43.14,Default,,0,0,0,,Ақымақ болма. Мен мұғаліммін.
Dialogue: 0,0:12:43.14,0:12:44.13,Default,,0,0,0,,Ал сіз
Dialogue: 0,0:12:44.87,0:12:47.14,Default,,0,0,0,,Мұғалім болсаң, уайымдаушысың.
Dialogue: 0,0:12:47.14,0:12:51.83,Default,,0,0,0,,Жарайды. Кішкене ойнасаңыз, оны ешқашан біле алмайсыз.
Dialogue: 0,0:12:52.60,0:12:58.13,Default,,0,0,0,,Мен де БАҚ-тан қорқамын, айтпа! Мұның бәрі құпия
Dialogue: 0,0:12:58.92,0:13:03.00,Default,,0,0,0,,Сіз тым тартымды және күдіктісіз.
Dialogue: 0,0:13:03.00,0:13:05.39,Default,,0,0,0,,Сонымен, мақсаты не?
Dialogue: 0,0:13:05.82,0:13:07.45,Default,,0,0,0,,Бұл қызыл нүкте үшін өтемақы ма?
Dialogue: 0,0:13:07.45,0:13:08.84,Default,,0,0,0,,Шын мәнінде
Dialogue: 0,0:13:08.84,0:13:13.42,Default,,0,0,0,,Мен сенен мен көз тіккен студент қыздарға қорқынышты істер жасағаныңды қалаймын.
Dialogue: 0,0:13:14.48,0:13:16.03,Default,,0,0,0,,Бұл қорқынышты ма?
Dialogue: 0,0:13:16.31,0:13:17.38,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:13:17.39,0:13:21.30,Default,,0,0,0,,Қараңызшы, Хисао мырзаның зорланғанын білесіз бе?
Dialogue: 0,0:13:21.30,0:13:25.09,Default,,0,0,0,,Бұл сіздің ақшаңыз екеніне сенімдісіз бе?
Dialogue: 0,0:13:25.67,0:13:26.71,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:13:26.71,0:13:31.37,Default,,0,0,0,,Мен басқа біреуден маған көмектесуін сұрадым, бірақ соңғы уақытта біраз қиналып жүрмін.
Dialogue: 0,0:13:33.42,0:13:38.75,Default,,0,0,0,,Джун Котобишима мырзаға жазылған айыптау хаты Мен сіздің әлсіздігіңізді білемін. Мектептің көзіне түскің келмесе, кешке гимназияға жалғыз кел! !
Dialogue: 0,0:13:41.56,0:13:43.36,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:13:44.49,0:13:46.43,Default,,0,0,0,,Иә, бұл сіз болдыңыз ба?
Dialogue: 0,0:13:47.12,0:13:51.22,Default,,0,0,0,,Мұндай айыптау хаты өте жексұрын, солай емес пе?
Dialogue: 0,0:13:53.13,0:13:55.21,Default,,0,0,0,,Сонымен мақсат не?
Dialogue: 0,0:13:56.34,0:13:59.83,Default,,0,0,0,,Мен сізден үлкен әпкем Хинасе Саки туралы сұрағым келеді.
Dialogue: 0,0:14:00.60,0:14:02.55,Default,,0,0,0,,О, сен, мүмкін емес.
Dialogue: 0,0:14:03.11,0:14:05.66,Default,,0,0,0,,Неліктен апаңызға шабуыл жасау үшін моги қолдандыңыз?
Dialogue: 0,0:14:05.66,0:14:06.90,Default,,0,0,0,,Енді жауап беріңіз!
Dialogue: 0,0:14:06.90,0:14:09.46,Default,,0,0,0,,Жарайды, бұл көздің жауын алды.
Dialogue: 0,0:14:09.46,0:14:10.52,Default,,0,0,0,,Не?
Dialogue: 0,0:14:10.92,0:14:12.88,Default,,0,0,0,,Қараңдаршы, ол кісі көзге түседі, солай ма?
Dialogue: 0,0:14:12.88,0:14:15.42,Default,,0,0,0,,Жаныңда жүргенде мені мазалайды.
Dialogue: 0,0:14:15.62,0:14:18.38,Default,,0,0,0,,Мен көзіме тотығуды қаламаймын.
Dialogue: 0,0:14:18.38,0:14:21.64,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:14:21.64,0:14:24.58,Default,,0,0,0,,Мен сені өз қолыммен пайдалануды ойладым.
Dialogue: 0,0:14:24.58,0:14:26.71,Default,,0,0,0,,Бұлай болғаны ұят.
Dialogue: 0,0:14:26.71,0:14:27.69,Default,,0,0,0,,Шынында да, ол үйде өте сабырлы.
Dialogue: 0,0:14:27.69,0:14:32.79,Default,,0,0,0,,Сонда да сен үлкен апаларды жақсы көретін бұзықсың.
Dialogue: 0,0:14:33.34,0:14:35.77,Default,,0,0,0,,Менің отбасым масқара болды.
Dialogue: 0,0:14:35.77,0:14:37.48,Default,,0,0,0,,Мен туралы не білесің?
Dialogue: 0,0:14:37.83,0:14:42.35,Default,,0,0,0,,Иә! маған көмектесші!
Dialogue: 0,0:14:42.91,0:14:45.92,Default,,0,0,0,,Иә? Даусыңыз кішкентай болды ма?
Dialogue: 0,0:14:46.73,0:14:49.85,Default,,0,0,0,,Біреу келеді!
Dialogue: 0,0:14:51.50,0:14:54.86,Default,,0,0,0,,Әй, бұл қатал, шыңғырған дауыс.
Dialogue: 0,0:14:54.86,0:14:56.99,Default,,0,0,0,,Сіз сақтандыру дәрігерісіз бе?
Dialogue: 0,0:14:56.99,0:14:58.75,Default,,0,0,0,,Сіз бұл баламен дос болдыңыз ба?
Dialogue: 0,0:14:59.31,0:15:04.40,Default,,0,0,0,,А, оққағарларға сол сақтандыру дәрігері керек сияқты.
Dialogue: 0,0:15:05.79,0:15:10.00,Default,,0,0,0,,Джун Кобисима Сіз ауырсынуды білуіңіз керек
Dialogue: 0,0:15:15.44,0:15:20.42,Default,,0,0,0,,Ryou Seifai: Мектептегі әдемі қыз санкциялардың құпия жазбасы
Dialogue: 0,0:15:20.89,0:15:22.73,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:15:22.73,0:15:24.21,Default,,0,0,0,,Даусыңыз дірілдеп тұр.
Dialogue: 0,0:15:24.41,0:15:26.72,Default,,0,0,0,,Басыңызға не болатынын білетініңізге сенімдісіз бе?
Dialogue: 0,0:15:27.36,0:15:30.61,Default,,0,0,0,,Жоқ! Жіберу! Осылай салқын
Dialogue: 0,0:15:30.61,0:15:32.67,Default,,0,0,0,,Шатаспаңыз
Dialogue: 0,0:15:33.39,0:15:34.40,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:34.40,0:15:36.54,Default,,0,0,0,,Уау! Ол дымқыл
Dialogue: 0,0:15:36.96,0:15:38.68,Default,,0,0,0,,Менің виллам дірілдеп тұр.
Dialogue: 0,0:15:38.68,0:15:39.99,Default,,0,0,0,,Жоқ, қарамаңыз
Dialogue: 0,0:15:39.99,0:15:42.96,Default,,0,0,0,,Сіз мұғалімсіз бе? тоқтатуға рұқсат етіңіз
Dialogue: 0,0:15:42.96,0:15:45.63,Default,,0,0,0,,Әй, не деген шулы әйел.
Dialogue: 0,0:15:45.63,0:15:47.71,Default,,0,0,0,,Сонда дәмі ше?
Dialogue: 0,0:15:47.71,0:15:50.08,Default,,0,0,0,,Онда, жоқ, жоқ.
Dialogue: 0,0:15:53.36,0:15:57.86,Default,,0,0,0,,Сіз мұны істеуден құтылмайсыз.
Dialogue: 0,0:15:57.86,0:16:01.88,Default,,0,0,0,,Солай болса да тентек сұйықтық толып жатыр.
Dialogue: 0,0:16:01.88,0:16:03.15,Default,,0,0,0,,No
Dialogue: 0,0:16:03.80,0:16:05.84,Default,,0,0,0,,Күштің жоқтығы
Dialogue: 0,0:16:06.34,0:16:08.31,Default,,0,0,0,,Ол қатты босаңсыды.
Dialogue: 0,0:16:08.46,0:16:09.68,Default,,0,0,0,,Бірақ бұған дейін осы жолы талқылауымыз керек бірнеше мәселе бар.
Dialogue: 0,0:16:12.23,0:16:14.60,Default,,0,0,0,,Не? Жоқ, бәрі осы
Dialogue: 0,0:16:14.60,0:16:17.37,Default,,0,0,0,,Қазір немен күресіп жатырсыз?
Dialogue: 0,0:16:19.01,0:16:21.60,Default,,0,0,0,,Оны дұрыс салғаныңызға көз жеткізіңіз!
Dialogue: 0,0:16:22.91,0:16:27.29,Default,,0,0,0,,Уау, тарылып кеткені сонша, жұлынып кететін сияқты.
Dialogue: 0,0:16:28.91,0:16:30.66,Default,,0,0,0,,Құрамында
Dialogue: 0,0:16:32.65,0:16:36.41,Default,,0,0,0,,Кеттік, түбіне дейін аузыңа сал.
Dialogue: 0,0:16:37.23,0:16:40.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:44.14,0:16:45.28,Default,,0,0,0,,Енгізілді
Dialogue: 0,0:16:45.28,0:16:47.03,Default,,0,0,0,,Мен қалаймын!
Dialogue: 0,0:16:48.74,0:16:54.02,Default,,0,0,0,,Мен қалаймын, жоқ! Оны қазірдің өзінде шығарыңыз, қазірдің өзінде шығарыңыз!
Dialogue: 0,0:16:54.46,0:16:57.50,Default,,0,0,0,,Қан шығып жатыр. Неге ол пәк қыз еді.
Dialogue: 0,0:16:57.50,0:16:58.60,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:00.29,0:17:04.99,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:17:04.99,0:17:08.31,Default,,0,0,0,,Не айтсаң да, шын мәні осы жерден басталады.
Dialogue: 0,0:17:20.95,0:17:23.60,Default,,0,0,0,,Сүйкімді дыбыс шығару
Dialogue: 0,0:17:24.85,0:17:29.32,Default,,0,0,0,,Пискалар *біртіндеп* сиқырларды ұната бастаған сияқты.
Dialogue: 0,0:17:29.32,0:17:32.42,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:17:32.42,0:17:35.74,Default,,0,0,0,,Сонда мен сені әтешті одан сайын ұнатамын!
Dialogue: 0,0:17:41.33,0:17:45.05,Default,,0,0,0,,Жоқ, жоқ, менің денем оны өздігінен сезінеді.
Dialogue: 0,0:17:47.93,0:17:49.15,Default,,0,0,0,,Баратын уақыт келді
Dialogue: 0,0:17:49.15,0:17:50.62,Default,,0,0,0,,Мұны байыппен қабылдаңыз
Dialogue: 0,0:17:51.15,0:17:53.50,Default,,0,0,0,,Жоқ, іші жоқ!
Dialogue: 0,0:17:53.50,0:17:57.65,Default,,0,0,0,,Сыртта, сыртта, іште, жоқ!
Dialogue: 0,0:18:05.46,0:18:08.96,Default,,0,0,0,,О, бұл рас.
Dialogue: 0,0:18:08.96,0:18:13.13,Default,,0,0,0,,Бұл қорқынышты, мен міндетті түрде жүкті боламын.
Dialogue: 0,0:18:13.82,0:18:15.97,Default,,0,0,0,,Шешуші шайқас уақыты келді
Dialogue: 0,0:18:16.38,0:18:19.03,Default,,0,0,0,,Бұл өтірік, солай ма? Сондай-ақ
Dialogue: 0,0:18:22.48,0:18:27.08,Default,,0,0,0,,Жоқ, мен жүкті болғаныма сене алар емеспін!
Dialogue: 0,0:18:27.95,0:18:31.86,Default,,0,0,0,,О, солай! қайтадан үлкейеді
Dialogue: 0,0:18:37.71,0:18:39.63,Default,,0,0,0,,Қайтадан келеді!
Dialogue: 0,0:18:39.63,0:18:44.40,Default,,0,0,0,,Жоқ, ішіме кірме, мен жүкті боламын!
Dialogue: 0,0:18:55.94,0:18:59.30,Default,,0,0,0,,Ішінде тағы не істеуім керек?
Dialogue: 0,0:18:59.61,0:19:02.80,Default,,0,0,0,,Мен енді кумир бола алмаймын
Dialogue: 0,0:19:03.55,0:19:05.95,Default,,0,0,0,,Сіз әлі де студент бола аласыз, солай ма?
Dialogue: 0,0:19:05.95,0:19:10.43,Default,,0,0,0,,Сіз қол тигізген барлық құрбандар мектептен қуылды.
Dialogue: 0,0:19:11.43,0:19:16.28,Default,,0,0,0,,Егер сіз мектептен кеткен болсаңыз, мұндай жағдай болмас еді.
Dialogue: 0,0:19:16.28,0:19:21.03,Default,,0,0,0,,Жалғыз мен кетсем де, Сора-чан осында болғанша солай болады.
Dialogue: 0,0:19:22.36,0:19:25.51,Default,,0,0,0,,Сора-чан Рокукучи Сора дегенді білдіреді ме?
Dialogue: 0,0:19:26.77,0:19:29.13,Default,,0,0,0,,Тағы кім бар?
Dialogue: 0,0:19:29.13,0:19:30.71,Default,,0,0,0,,Артық емес
Dialogue: 0,0:19:41.61,0:19:43.89,Default,,0,0,0,,Мұғалім №
Dialogue: 0,0:19:45.60,0:19:47.70,Default,,0,0,0,,Мастурбация дегеніміз не?
Dialogue: 0,0:19:49.80,0:19:54.51,Default,,0,0,0,,Менің кишегім ыстық, мен оны көбірек қалаймын, қаттырақ.
Dialogue: 0,0:19:54.94,0:19:59.60,Default,,0,0,0,,Иісі мұрынға терең еніп, таралады.
Dialogue: 0,0:19:59.60,0:20:01.54,Default,,0,0,0,,Жоқ, менің жамбасым қозғалады.
Dialogue: 0,0:20:01.54,0:20:03.77,Default,,0,0,0,,Мұғалімнің жақсы иісі
Dialogue: 0,0:20:04.32,0:20:05.93,Default,,0,0,0,,Менің саусағым тығылып қалды.
Dialogue: 0,0:20:06.86,0:20:09.10,Default,,0,0,0,,Сіз мұнда қанша уақыт болдыңыз? Ямико-сан
Dialogue: 0,0:20:09.10,0:20:10.50,Default,,0,0,0,,Өтінемін, мені шошытпаңыз.
Dialogue: 0,0:20:10.50,0:20:13.43,Default,,0,0,0,,Тыныш болыңыз. Егер сізді байқасаңыз не істейсіз?
Dialogue: 0,0:20:13.43,0:20:16.09,Default,,0,0,0,,Бұл тұрудың уақыты емес.
Dialogue: 0,0:20:16.71,0:20:20.55,Default,,0,0,0,,Ішіңізде қайнап жатқан қуаныш шырыны толып жатыр.
Dialogue: 0,0:20:20.55,0:20:23.11,Default,,0,0,0,,Бұл жақсы сезінеді, сэр.
Dialogue: 0,0:20:23.11,0:20:25.37,Default,,0,0,0,,Мен көбірек алғым келеді.
Dialogue: 0,0:20:25.87,0:20:28.71,Default,,0,0,0,,Әй, жақсы болды, менің жолдасым да дірілдеп тұр.
Dialogue: 0,0:20:28.71,0:20:31.11,Default,,0,0,0,,Мен саусақтарымды тоқтата алмаймын. Жоқ, жоқ.
Dialogue: 0,0:20:31.11,0:20:34.78,Default,,0,0,0,,Мен барамын, барамын, мұғалім.
Dialogue: 0,0:20:34.78,0:20:38.10,Default,,0,0,0,,Жоқ, барамын, барамын
Dialogue: 0,0:20:56.52,0:20:58.89,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:01.63,0:21:03.52,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:21:03.52,0:21:05.97,Default,,0,0,0,,Сіз мұны тегін жасай аламын деп ойлайсыз ба?
Dialogue: 0,0:21:06.30,0:21:09.40,Default,,0,0,0,,Мен клуб бөлмесінен өтіп бара жатқанымда, дем алған дыбыс естідім.
Dialogue: 0,0:21:10.12,0:21:13.95,Default,,0,0,0,,Ашық өтірік айтып жатырсың, шын мәнінде сен менің денемді ғана аңдып жүрсің.
Dialogue: 0,0:21:14.95,0:21:16.71,Default,,0,0,0,,О, бұл жаман болды.
Dialogue: 0,0:21:17.42,0:21:18.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:19.13,0:21:21.02,Default,,0,0,0,,Не үшін өкінесіз?
Dialogue: 0,0:21:21.02,0:21:24.26,Default,,0,0,0,,Мен сені ешқашан, ешқашан, ешқашан кешірмеймін!
Dialogue: 0,0:21:25.18,0:21:27.98,Default,,0,0,0,,Енді сіздің кезегіңіз, сондықтан дайындалыңыз.
Dialogue: 0,0:21:31.98,0:21:33.63,Default,,0,0,0,,Бұл жыныс мүшесі
Dialogue: 0,0:21:33.70,0:21:36.46,Default,,0,0,0,,Олай болса, ол неге үлкен?
Dialogue: 0,0:21:37.92,0:21:39.89,Default,,0,0,0,,Міне осылай болады
Dialogue: 0,0:21:39.89,0:21:42.45,Default,,0,0,0,,Әдепсіз түрде
Dialogue: 0,0:21:43.68,0:21:45.87,Default,,0,0,0,,Иіс
Dialogue: 0,0:21:46.37,0:21:47.95,Default,,0,0,0,,Жағымсыз иіс
Dialogue: 0,0:21:47.95,0:21:49.21,Default,,0,0,0,,Егер сіз мұны істесеңіз
Dialogue: 0,0:21:49.64,0:21:52.32,Default,,0,0,0,,Одан да үлкен
Dialogue: 0,0:21:54.12,0:21:57.95,Default,,0,0,0,,*Бұл әтеш? ? ?
Dialogue: 0,0:21:59.88,0:22:02.63,Default,,0,0,0,,Ыстық шырын көбірек шығады
Dialogue: 0,0:22:05.80,0:22:07.05,Default,,0,0,0,,Керемет иіс
Dialogue: 0,0:22:07.05,0:22:08.87,Default,,0,0,0,,*Мұрыным ауырып тұр
Dialogue: 0,0:22:12.45,0:22:15.06,Default,,0,0,0,,Шығу Мен қазір кетемін!
Dialogue: 0,0:22:15.06,0:22:16.96,Default,,0,0,0,,Бару керек болса, тез кет.
Dialogue: 0,0:22:16.96,0:22:18.95,Default,,0,0,0,,Менің алдымнан өтіңізші.
Dialogue: 0,0:22:19.71,0:22:22.12,Default,,0,0,0,,＊
Dialogue: 0,0:22:30.58,0:22:35.08,Default,,0,0,0,,Ғажайып мөлшер, ғажайып иіс, бұл ұрықтың иісі
Dialogue: 0,0:22:37.31,0:22:39.70,Default,,0,0,0,,Бұл ұрықтың дәмі
Dialogue: 0,0:22:39.70,0:22:41.81,Default,,0,0,0,,Сен қазір менің сүйіктімсің.
Dialogue: 0,0:22:42.56,0:22:44.71,Default,,0,0,0,,Жоқ, осыншама ұзақ
Dialogue: 0,0:22:44.71,0:22:46.55,Default,,0,0,0,,Мен шай бөлмесіне асығуым керек.
Dialogue: 0,0:22:47.06,0:22:48.49,Default,,0,0,0,,Мұғаліммен уәде
Dialogue: 0,0:22:51.75,0:22:52.89,Default,,0,0,0,,Шай бөлмесі?
Dialogue: 0,0:22:52.89,0:22:54.28,Default,,0,0,0,,Сіз шай бөлмесін айттыңыз ба?
Dialogue: 0,0:22:55.94,0:22:57.65,Default,,0,0,0,,Жарайды, мен сенің соңынан еремін.
Dialogue: 0,0:22:57.65,0:22:58.77,Default,,0,0,0,,А, иә
Dialogue: 0,0:23:01.32,0:23:06.06,Default,,0,0,0,,Не? Бұл ауырмайды. Мұғалім болсаң неге қолыңда кісен бар?
Dialogue: 0,0:23:06.33,0:23:07.91,Default,,0,0,0,,Жібер, ақымақ!
Dialogue: 0,0:23:08.49,0:23:10.65,Default,,0,0,0,,Неге шай бөлмесіне бардың?
Dialogue: 0,0:23:11.21,0:23:14.06,Default,,0,0,0,,Сіз не істеп жатырсыз? Тезірек мені жібер, ақымақ.
Dialogue: 0,0:23:14.06,0:23:15.42,Default,,0,0,0,,Кім саған бірдеңе деді?
Dialogue: 0,0:23:16.04,0:23:19.66,Default,,0,0,0,,үшін? Бос киска осылай көрінеді
Dialogue: 0,0:23:19.96,0:23:21.85,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:23:21.85,0:23:24.91,Default,,0,0,0,,Иісі аздап қышқыл, терлейді.
Dialogue: 0,0:23:24.91,0:23:27.16,Default,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,0:23:27.16,0:23:30.37,Default,,0,0,0,,Тоқтағанымды қаласаңыз, сұрақтарыма жауап бере аласыз ба?
Dialogue: 0,0:23:33.54,0:23:36.12,Default,,0,0,0,,Шай бөлмесіне баруыңызға нақты не себеп болды?
Dialogue: 0,0:23:36.98,0:23:38.68,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:23:42.34,0:23:45.06,Default,,0,0,0,,Мен жай ғана ұмытып кеткен нәрсені алуға бардым.
Dialogue: 0,0:23:45.06,0:23:47.36,Default,,0,0,0,,Онда неге қашып кеттің?
Dialogue: 0,0:23:49.20,0:23:50.04,Default,,0,0,0,,Мені күт
Dialogue: 0,0:23:53.47,0:23:55.48,Default,,0,0,0,,Өйткені сендер табандысыңдар
Dialogue: 0,0:23:55.92,0:23:58.38,Default,,0,0,0,,Сен мені бұрышқа тығып алдың, Мукучи Сора, ойлан!
Dialogue: 0,0:23:58.38,0:23:59.96,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:24:00.40,0:24:03.44,Default,,0,0,0,,Не болды? Сіз мұны әлі айтпайсыз ба?
Dialogue: 0,0:24:03.88,0:24:08.49,Default,,0,0,0,,Сондықтан мен бірдеңені ұмытып қалдым және үй тапсырмасын басып шығаруды ұмытып кеттім.
Dialogue: 0,0:24:09.02,0:24:11.86,Default,,0,0,0,,Хм, онда мен сені дұрыстап жауап аламын.
Dialogue: 0,0:24:12.31,0:24:13.99,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:24:20.57,0:24:24.05,Default,,0,0,0,,Жоқ, жоқ, тоқтат, жоқ!
Dialogue: 0,0:24:24.26,0:24:26.27,Default,,0,0,0,,Веро кіріп келеді
Dialogue: 0,0:24:28.36,0:24:30.49,Default,,0,0,0,,Жоқ, жоқ, тоқтатыңыз.
Dialogue: 0,0:24:41.58,0:24:43.36,Default,,0,0,0,,Бөксеге дейін?
Dialogue: 0,0:24:46.38,0:24:48.90,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:24:49.46,0:24:53.02,Default,,0,0,0,,Неліктен бөксесіме бұлай болды?
Dialogue: 0,0:24:58.03,0:25:01.38,Default,,0,0,0,,Ол жерге тіліңізді де, саусақтарыңызды да салмаңыз.
Dialogue: 0,0:25:03.49,0:25:06.19,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:25:10.93,0:25:13.86,Default,,0,0,0,,Менің ішім дірілдейді
Dialogue: 0,0:25:16.26,0:25:17.36,Default,,0,0,0,,Жоқ
Dialogue: 0,0:25:19.80,0:25:23.83,Default,,0,0,0,,Эй, доғаршы. Бұл мағынасыз. Бұл күйде қалыпты жағдай.
Dialogue: 0,0:25:25.64,0:25:26.84,Default,,0,0,0,,Тоқта
Dialogue: 0,0:25:32.76,0:25:35.98,Default,,0,0,0,,Онда, жоқ, осылай
Dialogue: 0,0:25:36.68,0:25:39.13,Default,,0,0,0,,Денем еріп бара жатқандай
Dialogue: 0,0:25:41.52,0:25:44.22,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:25:54.99,0:25:56.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:26:05.18,0:26:07.89,Default,,0,0,0,,Не? Сол ақымақ сұрақ
Dialogue: 0,0:26:08.54,0:26:09.57,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:26:09.78,0:26:13.10,Default,,0,0,0,,Соған қарамастан мен бар күшімді салдым.
Dialogue: 0,0:26:13.29,0:26:16.08,Default,,0,0,0,,Сіз шынымен де ақпарат алған жоқсыз, солай ма?
Dialogue: 0,0:26:16.08,0:26:20.14,Default,,0,0,0,,Олай десеңіз де, менің тәжірибем жоқ және бұл туралы.
Dialogue: 0,0:26:20.67,0:26:21.98,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:26:21.98,0:26:27.23,Default,,0,0,0,,Мен одан жауап алған болсам, Рокукучи көп нәрсені айтар еді деп сенемін.
Dialogue: 0,0:26:27.94,0:26:30.17,Default,,0,0,0,,Осыны ойласам, аяқтай алмаймын.
Dialogue: 0,0:26:31.13,0:26:31.87,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:26:31.87,0:26:33.07,Default,,0,0,0,,Не? Қайда?
Dialogue: 0,0:26:33.46,0:26:37.08,Default,,0,0,0,,Сабақтары нашар оқушыларға түзету сабақтарын ұсынамын.
Dialogue: 0,0:26:37.08,0:26:38.38,Default,,0,0,0,,«Зардап шегушілер ашу-ыза білдіреді»
Dialogue: 0,0:26:39.14,0:26:40.49,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:26:41.08,0:26:43.53,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:26:43.53,0:26:46.72,Default,,0,0,0,,Эй Ямико, сен неге бұлайсың?
Dialogue: 0,0:26:47.00,0:26:49.72,Default,,0,0,0,,Бұл мені бұзық етіп көрсетеді.
Dialogue: 0,0:26:51.83,0:26:53.40,Default,,0,0,0,,Сәлем, Ямико-сан
Dialogue: 0,0:26:53.83,0:26:55.12,Default,,0,0,0,,Ей, тыныш отыр.
Dialogue: 0,0:26:55.12,0:26:56.84,Default,,0,0,0,,Жоғары қара
Dialogue: 0,0:26:58.48,0:27:01.19,Default,,0,0,0,,Сіз не істеп жатырсыз? Ямико-сан
Dialogue: 0,0:27:04.45,0:27:05.71,Default,,0,0,0,,Кетіңіз.
Dialogue: 0,0:27:06.13,0:27:07.33,Default,,0,0,0,,Жалқау болмаңыз
Dialogue: 0,0:27:07.54,0:27:08.80,Default,,0,0,0,,Оны тез жалаңыз
Dialogue: 0,0:27:09.94,0:27:13.66,Default,,0,0,0,,Менің айтқанымды істе, таңдауың жоқ.
Dialogue: 0,0:27:18.56,0:27:19.90,Default,,0,0,0,,Иә.
Dialogue: 0,0:27:20.37,0:27:23.05,Default,,0,0,0,,Қараңызшы, сіз суланып бара жатырсыз, солай емес пе?
Dialogue: 0,0:27:23.14,0:27:24.80,Default,,0,0,0,,Барған сайын толып жатыр
Dialogue: 0,0:27:25.30,0:27:26.75,Default,,0,0,0,,Дерлік
Dialogue: 0,0:27:26.75,0:27:29.61,Default,,0,0,0,,Оны сәл жабысқақ етіп жасаңыз
Dialogue: 0,0:27:29.61,0:27:31.95,Default,,0,0,0,,Қайта-қайта тергендей
Dialogue: 0,0:27:33.13,0:27:35.78,Default,,0,0,0,,Тіл алыс.
Dialogue: 0,0:27:35.78,0:27:37.32,Default,,0,0,0,,(Hagakure) Осы жолы сені қашып құтыла алмайсың! (Black) Уф…
Dialogue: 0,0:27:37.32,0:27:40.77,Default,,0,0,0,,Қаттырақ, қаттырақ сору
Dialogue: 0,0:27:47.37,0:27:49.70,Default,,0,0,0,,Сұйық толып жатыр.
Dialogue: 0,0:27:49.70,0:27:52.60,Default,,0,0,0,,Сіз де толып бара жатырсыз.
Dialogue: 0,0:27:58.60,0:28:01.19,Default,,0,0,0,,Сіз қалай ойлайсыз? Қараңғы және тәтті емес пе?
Dialogue: 0,0:28:01.19,0:28:03.07,Default,,0,0,0,,Сіз жұтып қоюға болады
Dialogue: 0,0:28:08.31,0:28:10.51,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:28:21.52,0:28:23.85,Default,,0,0,0,,Өте орынды.
Dialogue: 0,0:28:23.85,0:28:28.71,Default,,0,0,0,,Соңғы бөлім өз қалауларыма қатысты болған сияқты.
Dialogue: 0,0:28:30.16,0:28:31.95,Default,,0,0,0,,Түсінесің бе, Киоширо?
Dialogue: 0,0:28:32.28,0:28:34.35,Default,,0,0,0,,Бұл сезімді ұмытпа
Dialogue: 0,0:28:34.35,0:28:38.07,Default,,0,0,0,,Мен сені тек өшпенділікпен, қалаумен ғана қинадым ба?
Dialogue: 0,0:28:39.31,0:28:41.35,Default,,0,0,0,,Жақсы сезілген сияқты.
Dialogue: 0,0:28:42.91,0:28:45.17,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:28:45.17,0:28:46.29,Default,,0,0,0,,Ах, бұл дұрыс емес.
Dialogue: 0,0:28:46.29,0:28:49.75,Default,,0,0,0,,Сіз өзіңізбен бірге болып, Мукукучи Сораға шабуыл жасадыңыз.
Dialogue: 0,0:28:49.75,0:28:51.53,Default,,0,0,0,,Бұл жеңіс немесе жеңіліс емес, бұл шабуыл.
Dialogue: 0,0:28:51.93,0:28:54.80,Default,,0,0,0,,Толық кекшіл жыныстық қылмыс ретінде
Dialogue: 0,0:28:55.77,0:28:57.13,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:28:57.13,0:28:58.93,Default,,0,0,0,,Мен не айтамын?
Dialogue: 0,0:28:58.93,0:29:01.03,Default,,0,0,0,,Мен не істеймін
Dialogue: 0,0:29:01.03,0:29:04.12,Default,,0,0,0,,Не істеу керек Әрқашан есте сақтаңыз
Dialogue: 0,0:29:04.37,0:29:06.62,Default,,0,0,0,,Сезіміңізге қарап алға ұмтылмаңыз.
Dialogue: 0,0:29:07.12,0:29:10.75,Default,,0,0,0,,Түсіндім, табыс пен жеңіліс пен кек алудың айырмашылығы бар.
Dialogue: 0,0:29:10.75,0:29:11.77,Default,,0,0,0,,Иә.
Dialogue: 0,0:29:11.77,0:29:13.25,Default,,0,0,0,,Рахмет, Ямико-сан
Dialogue: 0,0:29:13.25,0:29:16.38,Default,,0,0,0,,Маған алғыс керек емес. Оның орнына маған нәтиже беріңіз.
Dialogue: 0,0:29:16.51,0:29:18.98,Default,,0,0,0,,Бұл құрмет көрсетудің ең жақсы жолы.
Dialogue: 0,0:29:20.48,0:29:26.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory