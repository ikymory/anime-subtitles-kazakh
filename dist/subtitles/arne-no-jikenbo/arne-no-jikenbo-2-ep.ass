Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.58,0:00:05.08,Default,,0,0,0,,♪～
Dialogue: 0,0:01:24.25,0:01:29.25,Default,,0,0,0,,～♪
Dialogue: 0,0:01:35.88,0:01:37.38,Default,,0,0,0,,Уау, өте әдемі
Dialogue: 0,0:01:37.47,0:01:39.39,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:01:39.47,0:01:40.68,Default,,0,0,0,,Блумун Стацтан
Dialogue: 0,0:01:40.76,0:01:42.43,Default,,0,0,0,,Үйге қайтар жолда
Dialogue: 0,0:01:42.52,0:01:43.35,Default,,0,0,0,,Цвей ше?
Dialogue: 0,0:01:43.43,0:01:45.27,Default,,0,0,0,,Мен тіпті назар аудармадым.
Dialogue: 0,0:01:45.35,0:01:46.35,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:47.65,0:01:49.31,Default,,0,0,0,,Бұл маған қандай да бір түрде еске түсіреді
Dialogue: 0,0:01:50.15,0:01:53.23,Default,,0,0,0,,Сол күні мен Арне-саманы кездестірдім
Dialogue: 0,0:01:56.70,0:02:00.28,Default,,0,0,0,,Анашым, дүниеден өткеніңізге екі жыл болды.
Dialogue: 0,0:02:01.62,0:02:04.91,Default,,0,0,0,,Бүгін шығар деп ойладым.
Dialogue: 0,0:02:06.50,0:02:07.92,Default,,0,0,0,,(Теледидарды өшіру дыбысы)
Dialogue: 0,0:02:09.88,0:02:12.55,Default,,0,0,0,,Бұл жолы әкеммен
Dialogue: 0,0:02:14.76,0:02:17.22,Default,,0,0,0,,Қош келдіңіз, Рин ханым.
Dialogue: 0,0:02:17.30,0:02:20.01,Default,,0,0,0,,Тамақ дайын.
Dialogue: 0,0:02:20.09,0:02:21.60,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Рин.
Dialogue: 0,0:02:22.47,0:02:24.81,Default,,0,0,0,,Сіз де жеуіңіз керек.
Dialogue: 0,0:02:25.31,0:02:28.23,Default,,0,0,0,,Роуз екеуміз біттік.
Dialogue: 0,0:02:31.94,0:02:35.48,Default,,0,0,0,,А... Мен анамның бейітіне бардым.
Dialogue: 0,0:02:35.57,0:02:36.99,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:37.57,0:02:40.36,Default,,0,0,0,,Келесі жылы менімен бірге барғың келе ме?
Dialogue: 0,0:02:40.45,0:02:42.24,Default,,0,0,0,,Анаңның да бақытты болатынына сенімдімін...
Dialogue: 0,0:02:42.32,0:02:44.45,Default,,0,0,0,,Не айту керек!
Dialogue: 0,0:02:44.54,0:02:45.91,Default,,0,0,0,,Қақпақ…
Dialogue: 0,0:02:46.54,0:02:48.33,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:48.41,0:02:51.96,Default,,0,0,0,,Әйелім... Роза өлген жоқ!
Dialogue: 0,0:02:52.04,0:02:55.09,Default,,0,0,0,,Роза... Роза менімен бірге...
Dialogue: 0,0:02:56.38,0:02:58.76,Default,,0,0,0,,Әке! (Элис Диана) Күйеу!
Dialogue: 0,0:03:02.80,0:03:03.89,Default,,0,0,0,,Элиза
Dialogue: 0,0:03:03.97,0:03:05.56,Default,,0,0,0,,Күйеуіңізді бөлмеңізге әкеліңіз
Dialogue: 0,0:03:05.64,0:03:06.97,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:03:07.06,0:03:08.68,Default,,0,0,0,,Иә, мен осындамын!
Dialogue: 0,0:03:08.77,0:03:12.31,Default,,0,0,0,,(сағат шырылдаған дыбыс)
Dialogue: 0,0:03:12.40,0:03:15.65,Default,,0,0,0,,Рин ханым, қарсысыз ба?
Dialogue: 0,0:03:15.73,0:03:19.86,Default,,0,0,0,,Енді сыртқа жалғыз шықпауыңызды өтінемін.
Dialogue: 0,0:03:19.95,0:03:22.49,Default,,0,0,0,,Бұл күндері қалада қиыншылық көп.
Dialogue: 0,0:03:22.57,0:03:25.37,Default,,0,0,0,,Сондай-ақ кісі өлтіру ісі туралы қауесет бар.
Dialogue: 0,0:03:25.99,0:03:27.49,Default,,0,0,0,,Бірақ бұл естеліктер мен үш-төрт жастағы кезімдегі ғой, иә?
Dialogue: 0,0:03:27.58,0:03:32.46,Default,,0,0,0,,Беделді Рейнвейс отбасының жалғыз қызына ештеңе болмауы керек.
Dialogue: 0,0:03:32.54,0:03:34.00,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:03:39.88,0:03:41.47,Default,,0,0,0,,Ана…
Dialogue: 0,0:03:43.89,0:03:48.77,Default,,0,0,0,,Егер қиналсаңыз, бұл кулон Рин-чанға көмектеседі...
Dialogue: 0,0:03:52.35,0:03:55.23,Default,,0,0,0,,Егер мен сені қолдайтын болсам, әрине
Dialogue: 0,0:03:55.31,0:03:58.82,Default,,0,0,0,,Мұрагер ретінде, тырыссам...
Dialogue: 0,0:03:59.44,0:04:03.86,Default,,0,0,0,,А... Бұл жақсы емес. Мен толық теріс режимдемін.
Dialogue: 0,0:04:03.95,0:04:05.24,Default,,0,0,0,,Мұндай жағдайда...
Dialogue: 0,0:04:08.66,0:04:10.37,Default,,0,0,0,,Бұл жылдамдықтың өзгеруі!
Dialogue: 0,0:04:10.45,0:04:14.21,Default,,0,0,0,,Мен сау болмасам, әкем де сау болмайды!
Dialogue: 0,0:04:15.21,0:04:16.67,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:04:16.75,0:04:18.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:18.21,0:04:22.30,Default,,0,0,0,,Күтілгендей, Жапонияның Имамура бренді ең жақсы.
Dialogue: 0,0:04:22.38,0:04:25.59,Default,,0,0,0,,Созылу, сезіну және құны
Dialogue: 0,0:04:25.68,0:04:29.06,Default,,0,0,0,,Енді көңіл-күйімізді көтерейік!
Dialogue: 0,0:04:32.77,0:04:35.94,Default,,0,0,0,,(Ашық музыка)
Dialogue: 0,0:04:38.27,0:04:41.94,Default,,0,0,0,,Адамның қанын жұтатын өлмейтін құбыжық.
Dialogue: 0,0:04:42.03,0:04:43.20,Default,,0,0,0,,Вампир
Dialogue: 0,0:04:43.90,0:04:47.20,Default,,0,0,0,,Оның шыңында тоғыз патша болған.
Dialogue: 0,0:04:47.28,0:04:50.12,Default,,0,0,0,,Бірақ мен үлкен күшке ие болсам да, мен сені жеңе алмаймын ...
Dialogue: 0,0:04:50.20,0:04:53.21,Default,,0,0,0,,Вампир аңшысы пайда болады.
Dialogue: 0,0:04:53.29,0:04:59.46,Default,,0,0,0,,Патшалар өздерінің жауларын жеңіп, әлемді билеу үшін жүректерін құрбан етеді.
Dialogue: 0,0:04:59.55,0:05:06.30,Default,,0,0,0,,Жалғыз және ең өлімші вампир, Nointator дүниеге келді.
Dialogue: 0,0:05:06.39,0:05:10.26,Default,,0,0,0,,Хехехехе мен сені күттім жауым.
Dialogue: 0,0:05:10.35,0:05:11.18,Default,,0,0,0,,Міне келдік!
Dialogue: 0,0:05:11.27,0:05:13.10,Default,,0,0,0,,Жүрсең оба таратасың.
Dialogue: 0,0:05:13.18,0:05:16.06,Default,,0,0,0,,Сізге қарсы тұрған адамға сәбидей қарайды.
Dialogue: 0,0:05:16.15,0:05:18.15,Default,,0,0,0,,Ең жаман және ең жаман болмыс!
Dialogue: 0,0:05:18.23,0:05:19.98,Default,,0,0,0,,Адам
Dialogue: 0,0:05:20.07,0:05:23.36,Default,,0,0,0,,Қызыл ай астында бақытты биле!
Dialogue: 0,0:05:23.44,0:05:24.90,Default,,0,0,0,,Ай!
Dialogue: 0,0:05:25.82,0:05:27.16,Default,,0,0,0,,Жамандық!
Dialogue: 0,0:05:27.24,0:05:28.70,Default,,0,0,0,,Қанды!
Dialogue: 0,0:05:28.78,0:05:30.03,Default,,0,0,0,,Мәңгілік!
Dialogue: 0,0:05:30.12,0:05:35.66,Default,,0,0,0,,Нұсқаушы!
Dialogue: 0,0:05:37.46,0:05:38.79,Default,,0,0,0,,Ха...
Dialogue: 0,0:05:38.88,0:05:41.75,Default,,0,0,0,,Күтілгендей, вампирлер ең жақсы!
Dialogue: 0,0:05:41.84,0:05:44.01,Default,,0,0,0,,Күндердің күнінде көз алдыма келер...
Dialogue: 0,0:05:44.72,0:05:48.22,Default,,0,0,0,,Мойнымнан қаным
Dialogue: 0,0:05:48.93,0:05:51.26,Default,,0,0,0,,Эххехехехе...
Dialogue: 0,0:05:52.81,0:05:54.73,Default,,0,0,0,,Қарқынды өзгерту үшін жеткілікті ме?
Dialogue: 0,0:05:57.35,0:05:59.90,Default,,0,0,0,,Егер Гордон мырза сізді осылай киінген болса.
Dialogue: 0,0:05:59.98,0:06:02.23,Default,,0,0,0,,Бұл сөзсіз уағыз.
Dialogue: 0,0:06:02.32,0:06:03.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:08.74,0:06:10.28,Default,,0,0,0,,Әке?
Dialogue: 0,0:06:14.95,0:06:17.16,Default,,0,0,0,,Осы сағатта қайда барасың...
Dialogue: 0,0:06:35.68,0:06:38.35,Default,,0,0,0,,Әке, маған бірдеңе болды...
Dialogue: 0,0:06:40.69,0:06:41.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:41.94,0:06:42.52,Default,,0,0,0,,(ер адамның айқайы)
Dialogue: 0,0:06:42.52,0:06:43.86,Default,,0,0,0,,(ер адамның айқайы)
Dialogue: 0,0:06:42.52,0:06:43.86,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:46.86,0:06:48.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:50.24,0:06:53.03,Default,,0,0,0,,Бұл... өлтірілді...
Dialogue: 0,0:06:53.12,0:06:54.37,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:06:54.99,0:06:56.20,Default,,0,0,0,,...жоқ
Dialogue: 0,0:07:02.84,0:07:04.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:05.30,0:07:08.72,Default,,0,0,0,,(Риннің қатты тыныс алуы)
Dialogue: 0,0:07:09.63,0:07:12.22,Default,,0,0,0,,Не... не? Неліктен?
Dialogue: 0,0:07:12.30,0:07:13.55,Default,,0,0,0,,Әкеңіз ше?
Dialogue: 0,0:07:13.64,0:07:15.47,Default,,0,0,0,,Бүгінгі адамдар кімдер...
Dialogue: 0,0:07:17.98,0:07:19.43,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:07:22.15,0:07:23.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:24.73,0:07:26.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:24.73,0:07:26.61,Default,,0,0,0,,(қатты аяқ дыбыстары)
Dialogue: 0,0:07:26.61,0:07:27.61,Default,,0,0,0,,(қатты аяқ дыбыстары)
Dialogue: 0,0:07:28.19,0:07:29.74,Default,,0,0,0,,Маған біреу көмектес
Dialogue: 0,0:07:29.82,0:07:31.45,Default,,0,0,0,,Әке, ана!
Dialogue: 0,0:07:49.01,0:07:49.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:55.47,0:07:56.81,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:07:57.43,0:07:59.27,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:07:59.35,0:08:01.27,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:08:04.61,0:08:08.86,Default,,0,0,0,,Қалада осындай жер болды ма?
Dialogue: 0,0:08:12.40,0:08:15.99,Default,,0,0,0,,Ал... Мені біреу бақылап тұрғандай сезінемін.
Dialogue: 0,0:08:16.07,0:08:17.53,Default,,0,0,0,,（）
Dialogue: 0,0:08:20.25,0:08:21.16,Default,,0,0,0,,（）
Dialogue: 0,0:08:39.56,0:08:43.39,Default,,0,0,0,,Кешіріңіз... Мұнда біреу бар ма?
Dialogue: 0,0:08:43.48,0:08:44.52,Default,,0,0,0,,（）
Dialogue: 0,0:08:58.53,0:09:01.62,Default,,0,0,0,,Фильмнің орналасқан жері сияқты
Dialogue: 0,0:09:04.25,0:09:05.33,Default,,0,0,0,,Табыт…
Dialogue: 0,0:09:05.42,0:09:09.38,Default,,0,0,0,,Сонымен, мен бұл адамды вампир болады деп күтпедім...
Dialogue: 0,0:09:09.46,0:09:10.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:10.38,0:09:13.67,Default,,0,0,0,,Жоқ, жоқ, ақылмен ойлан.
Dialogue: 0,0:09:13.76,0:09:17.59,Default,,0,0,0,,Негізі адам баласының табыт ашуы мүмкін емес.
Dialogue: 0,0:09:17.68,0:09:20.14,Default,,0,0,0,,（）
Dialogue: 0,0:09:20.22,0:09:21.97,Default,,0,0,0,,Мүмкін бұл арман шығар?
Dialogue: 0,0:09:22.06,0:09:25.06,Default,,0,0,0,,Ха... Көрдім, мұның бәрі арман болды!
Dialogue: 0,0:09:25.14,0:09:26.77,Default,,0,0,0,,Бұл сөзсіз арман!
Dialogue: 0,0:09:26.85,0:09:28.73,Default,,0,0,0,,Ондай жағдайда уайымдамаңыз...
Dialogue: 0,0:09:28.81,0:09:30.40,Default,,0,0,0,,Ех!
Dialogue: 0,0:09:33.40,0:09:34.24,Default,,0,0,0,,(Қарт әйел) Құдайым-ай, сіз қандай құмар әрі жігерлі талапкерсіз.
Dialogue: 0,0:09:35.11,0:09:36.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:47.42,0:09:49.00,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:09:49.08,0:09:50.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:50.67,0:09:51.67,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:53.26,0:09:57.01,Default,,0,0,0,,(Отбасы күлкісі)
Dialogue: 0,0:09:57.09,0:09:58.97,Default,,0,0,0,,Рин-чан сен жақсы қызсың.
Dialogue: 0,0:09:59.05,0:10:00.05,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:10:00.72,0:10:02.10,Default,,0,0,0,,Лин
Dialogue: 0,0:10:02.18,0:10:03.02,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:04.31,0:10:07.19,Default,,0,0,0,,Мейірімді болған кезде әке
Dialogue: 0,0:10:11.77,0:10:13.07,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:10:15.19,0:10:16.03,Default,,0,0,0,,А...
Dialogue: 0,0:10:16.61,0:10:18.66,Default,,0,0,0,,Мен ұйықтап жатырмын...
Dialogue: 0,0:10:18.74,0:10:20.24,Default,,0,0,0,,Ха! ДДСҰ?
Dialogue: 0,0:10:18.74,0:10:20.24,Default,,0,0,0,,(шу)
Dialogue: 0,0:10:27.66,0:10:30.33,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:10:32.38,0:10:33.21,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:10:33.30,0:10:34.55,Default,,0,0,0,,Не!
Dialogue: 0,0:10:37.76,0:10:39.55,Default,,0,0,0,,Танысқаныма қуаныштымын, аа...
Dialogue: 0,0:10:40.34,0:10:41.51,Default,,0,0,0,,Мен Джишемін
Dialogue: 0,0:10:42.55,0:10:44.22,Default,,0,0,0,,Сіз тек айнада өмір сүре аласыз.
Dialogue: 0,0:10:44.31,0:10:46.60,Default,,0,0,0,,Тұрақсыз болмыс
Dialogue: 0,0:10:47.10,0:10:49.27,Default,,0,0,0,,Бұл арман емес, солай ма?
Dialogue: 0,0:10:49.35,0:10:51.23,Default,,0,0,0,,Бұл арман болар еді, солай ма?
Dialogue: 0,0:10:51.31,0:10:57.07,Default,,0,0,0,,Өйткені, бұл құлыптың иесі өте қорқынышты вампир.
Dialogue: 0,0:10:57.15,0:11:00.91,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:00.99,0:11:03.66,Default,,0,0,0,,Вампир…
Dialogue: 0,0:11:04.28,0:11:06.12,Default,,0,0,0,,Иә вампир
Dialogue: 0,0:11:06.75,0:11:08.21,Default,,0,0,0,,Қаныңды сору үшін
Dialogue: 0,0:11:08.29,0:11:11.08,Default,,0,0,0,,Мен сені тірі қалдырып, қамап жатырмын.
Dialogue: 0,0:11:13.63,0:11:14.75,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:16.76,0:11:21.51,Default,,0,0,0,,Менің ұйқымды бұз, ақымақ.
Dialogue: 0,0:11:21.59,0:11:24.72,Default,,0,0,0,,Сіз қан құрбаны болуға дайынсыз ба?
Dialogue: 0,0:11:27.77,0:11:30.06,Default,,0,0,0,,Немесе... Айнадан көрінбейді.
Dialogue: 0,0:11:30.14,0:11:32.94,Default,,0,0,0,,Сонымен, сіз шынымен нағыз вампирсіз бе?
Dialogue: 0,0:11:35.48,0:11:36.98,Default,,0,0,0,,олар 6000–7000 метр биіктікте ұша алады, және—
Dialogue: 0,0:11:37.07,0:11:39.74,Default,,0,0,0,,Өтінемін, қанымды сорып алшы!
Dialogue: 0,0:11:39.82,0:11:40.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.95,0:11:43.74,Default,,0,0,0,,Ол нағыз вампир!
Dialogue: 0,0:11:43.82,0:11:46.37,Default,,0,0,0,,Олай болса, барлығын бірден орындаңыз!
Dialogue: 0,0:11:46.45,0:11:49.54,Default,,0,0,0,,Тоқта, адам, сабыр ет.
Dialogue: 0,0:11:49.62,0:11:51.46,Default,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:11:51.54,0:11:54.54,Default,,0,0,0,,Мен оны аздап қорқытсам, қашып кетпей ме?
Dialogue: 0,0:11:54.63,0:11:55.17,Default,,0,0,0,,(Риннің толқыған дауысы)
Dialogue: 0,0:11:55.17,0:11:56.88,Default,,0,0,0,,(Риннің толқыған дауысы)
Dialogue: 0,0:11:55.17,0:11:56.88,Default,,0,0,0,,Бұл қызық, солай емес пе?
Dialogue: 0,0:11:56.88,0:11:56.96,Default,,0,0,0,,(Риннің толқыған дауысы)
Dialogue: 0,0:11:56.96,0:11:58.00,Default,,0,0,0,,(Риннің толқыған дауысы)
Dialogue: 0,0:11:56.96,0:11:58.00,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:11:58.09,0:12:02.55,Default,,0,0,0,,Бұл «тұңғиық ұйқысы» деген не? Маған мағынасы жоқ жолдарды айтуға мәжбүрлейді
Dialogue: 0,0:12:02.63,0:12:03.47,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:12:03.55,0:12:05.18,Default,,0,0,0,,Кел, кел!
Dialogue: 0,0:12:05.26,0:12:08.64,Default,,0,0,0,,Өтінемін, қанымды сор!
Dialogue: 0,0:12:12.56,0:12:14.35,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:14.44,0:12:18.69,Default,,0,0,0,,Өзім сүйсінген адамның алдында мақтанбасқа амалым болмады...
Dialogue: 0,0:12:18.78,0:12:20.07,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:12:20.15,0:12:22.65,Default,,0,0,0,,Менің ақыл-ойымды жоғалту деген нені білдіреді?
Dialogue: 0,0:12:22.74,0:12:25.03,Default,,0,0,0,,Бұл өте маңызды нәрсе, адамдар.
Dialogue: 0,0:12:25.12,0:12:27.16,Default,,0,0,0,,Оның аты Арне
Dialogue: 0,0:12:27.24,0:12:30.00,Default,,0,0,0,,Ол вампир және осы сарайдың иесі.
Dialogue: 0,0:12:30.08,0:12:33.12,Default,,0,0,0,,Адамдарды рұқсатсыз әкелу
Dialogue: 0,0:12:33.21,0:12:35.46,Default,,0,0,0,,Бұл қызықты көрінеді.
Dialogue: 0,0:12:35.54,0:12:37.38,Default,,0,0,0,,Әйтеуір, тезірек кет.
Dialogue: 0,0:12:37.46,0:12:39.38,Default,,0,0,0,,Менің саған пайдасы жоқ.
Dialogue: 0,0:12:39.46,0:12:42.80,Default,,0,0,0,,Дұрыс, тіпті бір тістесе де...
Dialogue: 0,0:12:42.88,0:12:43.72,Default,,0,0,0,,Я...
Dialogue: 0,0:12:43.80,0:12:47.80,Default,,0,0,0,,Адамның вампирге бірінші рет осылай әрекет етуі.
Dialogue: 0,0:12:47.89,0:12:49.10,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:12:49.18,0:12:52.98,Default,,0,0,0,,Арне тек қанды ғана ішеді, оны детектив сыйлығы ретінде алған.
Dialogue: 0,0:12:53.06,0:12:54.31,Default,,0,0,0,,Детектив?
Dialogue: 0,0:12:54.39,0:12:55.23,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:12:55.31,0:12:57.23,Default,,0,0,0,,Мен әлі ештеңе айтқан жоқпын!
Dialogue: 0,0:12:57.31,0:12:59.82,Default,,0,0,0,,Мен сұрамай-ақ түсінемін.
Dialogue: 0,0:12:59.90,0:13:02.11,Default,,0,0,0,,Ол сенен бірдеңе сұрамақшы болған шығар.
Dialogue: 0,0:13:02.19,0:13:04.57,Default,,0,0,0,,Оны көру үшін...
Dialogue: 0,0:13:04.65,0:13:06.07,Default,,0,0,0,,Детектив күткендей!
Dialogue: 0,0:13:06.16,0:13:08.49,Default,,0,0,0,,Негізі ол менің әкем...
Dialogue: 0,0:13:08.58,0:13:09.58,Default,,0,0,0,,Эй
Dialogue: 0,0:13:12.91,0:13:14.92,Default,,0,0,0,,Мен тыңдауды аяқтадым.
Dialogue: 0,0:13:15.00,0:13:19.63,Default,,0,0,0,,Сіз оны қарап шыға аласыз ба? әкең не істеп жатыр
Dialogue: 0,0:13:19.71,0:13:21.63,Default,,0,0,0,,Бұл шынымен де түкке тұрғысыз...
Dialogue: 0,0:13:21.71,0:13:25.59,Default,,0,0,0,,Саған қол көтерген әкең де сол ба?
Dialogue: 0,0:13:25.68,0:13:27.39,Default,,0,0,0,,Бірлескенді білдіреді.
Dialogue: 0,0:13:27.47,0:13:29.60,Default,,0,0,0,,Әкем осылай деді...!
Dialogue: 0,0:13:29.68,0:13:31.47,Default,,0,0,0,,Әңгіменің соңы
Dialogue: 0,0:13:31.56,0:13:33.73,Default,,0,0,0,,Мен тек мені қызықтыратын сұрауларды қабылдаймын.
Dialogue: 0,0:13:33.81,0:13:38.44,Default,,0,0,0,,Иә, жақсы ма? Мен де саған тегін көмектесемін.
Dialogue: 0,0:13:38.52,0:13:40.40,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:13:42.48,0:13:43.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:43.78,0:13:46.66,Default,,0,0,0,,Адам Оны қайдан алдың?
Dialogue: 0,0:13:46.74,0:13:48.49,Default,,0,0,0,,Э? Ах…
Dialogue: 0,0:13:48.57,0:13:52.12,Default,,0,0,0,,Оны маған марқұм анам бойтұмар етіп берген.
Dialogue: 0,0:13:52.20,0:13:53.45,Default,,0,0,0,,Хмм…
Dialogue: 0,0:13:55.16,0:13:57.62,Default,,0,0,0,,Мені біраз қызықтырды.
Dialogue: 0,0:13:57.71,0:13:59.08,Default,,0,0,0,,Вампир-сама?
Dialogue: 0,0:13:59.17,0:14:00.17,Default,,0,0,0,,Тоқта
Dialogue: 0,0:14:00.25,0:14:03.05,Default,,0,0,0,,Тергеу кезінде нәсілдің атымен аталуы мүмкін емес.
Dialogue: 0,0:14:03.13,0:14:06.01,Default,,0,0,0,,Тергеу барысында...
Dialogue: 0,0:14:06.09,0:14:10.76,Default,,0,0,0,,А, өзіңізді таныстырыңызшы, менің Арне детектив агенттігінің клиентім.
Dialogue: 0,0:14:10.85,0:14:13.72,Default,,0,0,0,,Бұл Рин! Бұл Линн Рейнвейс!
Dialogue: 0,0:14:13.81,0:14:18.48,Default,,0,0,0,,Менің әкемнің не істеп жатқанын тергеп беріңізші!
Dialogue: 0,0:14:23.48,0:14:26.65,Default,,0,0,0,,Арне-сама, кешігіп қалдың, Джичет-сан.
Dialogue: 0,0:14:26.74,0:14:29.41,Default,,0,0,0,,Ол киінген шығар.
Dialogue: 0,0:14:29.49,0:14:31.37,Default,,0,0,0,,А, Джише жақсы.
Dialogue: 0,0:14:31.45,0:14:34.20,Default,,0,0,0,,Джише қандай нәсіл?
Dialogue: 0,0:14:34.29,0:14:37.25,Default,,0,0,0,,Әлгі құлақтар... қасқырлар шығар?
Dialogue: 0,0:14:37.33,0:14:40.46,Default,,0,0,0,,Мен жай ғана қасқыр баламын
Dialogue: 0,0:14:40.54,0:14:42.34,Default,,0,0,0,,Ертегілерде кездеседі ме?
Dialogue: 0,0:14:42.42,0:14:45.01,Default,,0,0,0,,Иә, ертегілерде кездесетін өтірікші.
Dialogue: 0,0:14:45.09,0:14:47.34,Default,,0,0,0,,Бұл да өтірік болуы мүмкін.
Dialogue: 0,0:14:47.42,0:14:48.30,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:48.38,0:14:49.63,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:14:49.72,0:14:50.72,Default,,0,0,0,,Құрметті Арне
Dialogue: 0,0:14:52.68,0:14:55.06,Default,,0,0,0,,Кака кака... Өте сүйкімді!
Dialogue: 0,0:14:55.14,0:14:57.27,Default,,0,0,0,,Әпкемнің құшағында...
Dialogue: 0,0:14:58.06,0:15:00.52,Default,,0,0,0,,Тоқта, Линн Райнвейс
Dialogue: 0,0:15:00.60,0:15:04.27,Default,,0,0,0,,Мен Арне Нойинтертермін, ол сіздің өтінішіңізді қабылдады.
Dialogue: 0,0:15:04.36,0:15:05.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:05.28,0:15:07.65,Default,,0,0,0,,Иә! Фуфуфуфу…
Dialogue: 0,0:15:07.74,0:15:10.82,Default,,0,0,0,,Арне мырза? Жоқ... Арне-чан?
Dialogue: 0,0:15:10.91,0:15:12.62,Default,,0,0,0,,Кішкентай...
Dialogue: 0,0:15:12.70,0:15:16.33,Default,,0,0,0,,Сіз жаңа ғана «ноинтатер» дедіңіз бе?
Dialogue: 0,0:15:16.41,0:15:17.29,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,0:15:17.37,0:15:20.54,Default,,0,0,0,,Evily! Қанды! Мәңгілік!
Dialogue: 0,0:15:20.62,0:15:23.00,Default,,0,0,0,,Нұсқаушы! ...оның?
Dialogue: 0,0:15:23.08,0:15:25.13,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:15:25.21,0:15:26.80,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:15:26.88,0:15:31.01,Default,,0,0,0,,Менің алдымда Әке, Ана, Лорд Нонтатор келеді.
Dialogue: 0,0:15:31.09,0:15:33.51,Default,,0,0,0,,Қазір бір ғана жүрек бар.
Dialogue: 0,0:15:34.14,0:15:35.10,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:15:35.18,0:15:38.52,Default,,0,0,0,,Тергеуге барар алдында мен қан қорын дайындап алғым келеді.
Dialogue: 0,0:15:38.60,0:15:42.02,Default,,0,0,0,,Сұраныс төлемі болып табылатын қаныңызды дәл қазір алайын ба?
Dialogue: 0,0:15:42.65,0:15:44.90,Default,,0,0,0,,Әрине, жақсы! Ха ха ха ха...
Dialogue: 0,0:15:44.98,0:15:48.53,Default,,0,0,0,,Сіздің бұл шиеленісіңіз әлі де қорқынышты.
Dialogue: 0,0:15:48.61,0:15:50.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:51.07,0:15:54.37,Default,,0,0,0,,Мені алдап кетті Бұл алаяқтық
Dialogue: 0,0:15:54.45,0:15:57.33,Default,,0,0,0,,Мен қан алу туралы ешқашан естіген емеспін!
Dialogue: 0,0:15:57.41,0:16:00.04,Default,,0,0,0,,Оны сақтап, өзіңізбен бірге алып жүргеніңіз дұрысырақ.
Dialogue: 0,0:16:00.12,0:16:03.42,Default,,0,0,0,,Уф, қыздың арманы~!
Dialogue: 0,0:16:05.79,0:16:06.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:06.96,0:16:10.22,Default,,0,0,0,,Енді оның шынайы түрін көруге болады.
Dialogue: 0,0:16:10.30,0:16:15.18,Default,,0,0,0,,Сіз менің қонағымсыз және сіз қазірдің өзінде осы қаланың мүшесісіз.
Dialogue: 0,0:16:15.26,0:16:16.10,Default,,0,0,0,,(Құбыжықтардың күлкісі)
Dialogue: 0,0:16:16.10,0:16:17.64,Default,,0,0,0,,(Құбыжықтардың күлкісі)
Dialogue: 0,0:16:16.10,0:16:17.64,Default,,0,0,0,,Бұл Ругенберг
Dialogue: 0,0:16:18.39,0:16:21.10,Default,,0,0,0,,Адамдар емес адамдар тұратын қала.
Dialogue: 0,0:16:26.52,0:16:27.90,Default,,0,0,0,,Көзге тиюден аулақ болыңыз
Dialogue: 0,0:16:27.98,0:16:31.65,Default,,0,0,0,,Адамдар - бұл қала тұрғындары үшін құнды азық.
Dialogue: 0,0:16:31.74,0:16:33.57,Default,,0,0,0,,Иә... О, жоқ!
Dialogue: 0,0:16:33.66,0:16:37.66,Default,,0,0,0,,Мен... Мен Қашан? Неге мұндасың?
Dialogue: 0,0:16:37.74,0:16:40.50,Default,,0,0,0,,Білмеймін, көңілім кетіп қалған болуы керек.
Dialogue: 0,0:16:40.58,0:16:42.04,Default,,0,0,0,,Рухы қашады...
Dialogue: 0,0:16:48.13,0:16:50.51,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:16:50.59,0:16:52.59,Default,,0,0,0,,Бұл сарайдың артқы қақпасы.
Dialogue: 0,0:16:52.67,0:16:55.64,Default,,0,0,0,,Осы жерден сіз байқамай кіре аласыз.
Dialogue: 0,0:16:55.72,0:16:57.85,Default,,0,0,0,,Бірақ күн сәулесі...
Dialogue: 0,0:16:57.93,0:16:59.93,Default,,0,0,0,,Бір дәрежеде жақсы.
Dialogue: 0,0:17:00.01,0:17:02.18,Default,,0,0,0,,Айтпақшы, нұсқауларды жаттадың ба?
Dialogue: 0,0:17:02.27,0:17:03.31,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:17:03.98,0:17:06.23,Default,,0,0,0,,Мен бірінші кірдім
Dialogue: 0,0:17:06.31,0:17:10.53,Default,,0,0,0,,Әкеңді және қызметшілерді бірінші қабатқа тарт.
Dialogue: 0,0:17:10.61,0:17:12.78,Default,,0,0,0,,Осы уақытта Арне-сама...
Dialogue: 0,0:17:12.86,0:17:17.45,Default,,0,0,0,,Үйге кіріп, үшінші қабаттағы әкесінің бөлмесін тінту.
Dialogue: 0,0:17:17.53,0:17:21.12,Default,,0,0,0,,Егер сіз назар аударсаңыз, бұл қиын, сондықтан бар күшіңізді салыңыз.
Dialogue: 0,0:17:21.20,0:17:22.45,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:17:24.54,0:17:26.75,Default,,0,0,0,,А... Иә? Немесе ... кілт.
Dialogue: 0,0:17:26.83,0:17:29.42,Default,,0,0,0,,Әй... орнына
Dialogue: 0,0:17:32.92,0:17:33.84,Default,,0,0,0,,(Есікті қағады)
Dialogue: 0,0:17:33.92,0:17:34.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:36.55,0:17:38.34,Default,,0,0,0,,Қазір не істеп жатырсың...
Dialogue: 0,0:17:38.43,0:17:40.51,Default,,0,0,0,,Қанмен қайталанатын кілт жасады
Dialogue: 0,0:17:40.60,0:17:42.27,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:42.35,0:17:45.77,Default,,0,0,0,,Таң қалмаңыз, мені ішке шақырыңыз.
Dialogue: 0,0:17:47.81,0:17:49.31,Default,,0,0,0,,Яғни, сен біреуді тергеп жүріп сол автобусқа түсіп қалдың ғой, иә?
Dialogue: 0,0:17:49.40,0:17:50.23,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:50.86,0:17:52.36,Default,,0,0,0,,Ханым? Ха!
Dialogue: 0,0:17:53.19,0:17:55.03,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:17:55.11,0:17:57.11,Default,,0,0,0,,Бәріміз түні бойы іздедік.
Dialogue: 0,0:17:57.20,0:17:59.20,Default,,0,0,0,,Ка...Кай-сан
Dialogue: 0,0:17:59.28,0:18:00.33,Default,,0,0,0,,Ал...
Dialogue: 0,0:18:00.95,0:18:02.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:02.41,0:18:03.79,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,0:18:03.87,0:18:07.00,Default,,0,0,0,,Жақында жүзіңізді барлығына көрсетіңіз.
Dialogue: 0,0:18:07.08,0:18:09.75,Default,,0,0,0,,А... анау әке ше?
Dialogue: 0,0:18:09.83,0:18:12.13,Default,,0,0,0,,Мен бөлмемде тағатсыздана күтемін.
Dialogue: 0,0:18:12.21,0:18:13.84,Default,,0,0,0,,Бұл... сэр.
Dialogue: 0,0:18:13.92,0:18:16.88,Default,,0,0,0,,Рин ханым қайтып келді.
Dialogue: 0,0:18:16.97,0:18:17.80,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:18.97,0:18:20.55,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:30.77,0:18:33.07,Default,,0,0,0,,Тұманға айналғаныма біраз болды
Dialogue: 0,0:18:33.15,0:18:35.82,Default,,0,0,0,,Қан босқа кетеді.
Dialogue: 0,0:18:37.36,0:18:40.74,Default,,0,0,0,,Дворянның бөлмесі үшін бұл өте жалаң көрініс.
Dialogue: 0,0:18:42.37,0:18:43.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:46.12,0:18:48.87,Default,,0,0,0,,Рин Рейнвейстің анасы?
Dialogue: 0,0:18:48.96,0:18:51.00,Default,,0,0,0,,Әй, сұлу адам
Dialogue: 0,0:18:51.08,0:18:53.00,Default,,0,0,0,,А, кулон
Dialogue: 0,0:18:53.59,0:18:56.63,Default,,0,0,0,,Арне Сіз қамалда уайымдап жүрсіз бе?
Dialogue: 0,0:18:56.71,0:18:59.55,Default,,0,0,0,,Мен баяғыда бір жігітті кездестірдім, оның да сол күйі бар.
Dialogue: 0,0:18:59.63,0:19:01.47,Default,,0,0,0,,...басқа адам шығар.
Dialogue: 0,0:19:01.55,0:19:02.68,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:19:05.52,0:19:07.31,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:07.39,0:19:08.52,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:13.36,0:19:17.11,Default,,0,0,0,,Бөлме мүлдем түссіз емес сияқты.
Dialogue: 0,0:19:18.32,0:19:20.99,Default,,0,0,0,,«Мен түнде шыққым келді»?
Dialogue: 0,0:19:21.07,0:19:22.95,Default,,0,0,0,,Не болды, қарт әже?
Dialogue: 0,0:19:24.03,0:19:26.20,Default,,0,0,0,,Қандай өкінішті!
Dialogue: 0,0:19:26.29,0:19:29.54,Default,,0,0,0,,Жас ханым Рейнвейс отбасының мұрагері.
Dialogue: 0,0:19:29.62,0:19:31.46,Default,,0,0,0,,Маған біраз уақыт сатып алу керек
Dialogue: 0,0:19:31.54,0:19:34.50,Default,,0,0,0,,Сен де не істедің, Бернд?
Dialogue: 0,0:19:34.59,0:19:36.30,Default,,0,0,0,,О, мен бе?
Dialogue: 0,0:19:36.38,0:19:37.38,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:19:37.46,0:19:39.67,Default,,0,0,0,,Мен дұрыс күзетілдім.
Dialogue: 0,0:19:39.76,0:19:43.51,Default,,0,0,0,,Менің айтайын дегенім, жас келіншек құтылмайды деп ойлаймын...
Dialogue: 0,0:19:43.60,0:19:45.39,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:45.47,0:19:47.52,Default,,0,0,0,,Келесі жолы түнде далаға шыққанда
Dialogue: 0,0:19:47.60,0:19:49.64,Default,,0,0,0,,Маған дұрыстап айтшы, Рин Чан.
Dialogue: 0,0:19:49.73,0:19:51.56,Default,,0,0,0,,Басқа уақыт ешқашан болмайды!
Dialogue: 0,0:19:51.64,0:19:54.65,Default,,0,0,0,,Сіз кісі өлтіру ісін ұмыттыңыз ба?
Dialogue: 0,0:19:54.73,0:19:57.86,Default,,0,0,0,,Сол күні кешке де бір адам қаза тапты.
Dialogue: 0,0:19:57.94,0:19:58.90,Default,,0,0,0,,Бір адам?
Dialogue: 0,0:20:01.40,0:20:03.16,Default,,0,0,0,,Екі адам емес...
Dialogue: 0,0:20:03.24,0:20:05.45,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:05.53,0:20:06.37,Default,,0,0,0,,Әке!
Dialogue: 0,0:20:06.45,0:20:08.62,Default,,0,0,0,,Уф, гохо, гохо...
Dialogue: 0,0:20:08.70,0:20:10.16,Default,,0,0,0,,Мырза!
Dialogue: 0,0:20:10.25,0:20:11.58,Default,,0,0,0,,Әке!
Dialogue: 0,0:20:12.25,0:20:15.29,Default,,0,0,0,,Розэ сен үшін уайымдады.
Dialogue: 0,0:20:15.38,0:20:16.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:20.21,0:20:21.51,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:20:22.01,0:20:24.14,Default,,0,0,0,,Содан бері екі жыл өтті.
Dialogue: 0,0:20:24.22,0:20:27.39,Default,,0,0,0,,Бірге күткіңіз келе ме?
Dialogue: 0,0:20:27.47,0:20:29.64,Default,,0,0,0,,Мен сенің әкеңді қолдаймын.
Dialogue: 0,0:20:29.72,0:20:30.81,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:31.77,0:20:33.19,Default,,0,0,0,,Тырнақтарыңды қадалама.
Dialogue: 0,0:20:33.27,0:20:34.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:34.85,0:20:38.32,Default,,0,0,0,,Жақын арада сіз Роузбен кездесесіз.
Dialogue: 0,0:20:38.40,0:20:40.07,Default,,0,0,0,,Тағы да үш адам
Dialogue: 0,0:20:47.70,0:20:49.08,Default,,0,0,0,,Әке...
Dialogue: 0,0:20:49.16,0:20:50.29,Default,,0,0,0,,Ах
Dialogue: 0,0:20:52.87,0:20:53.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:55.04,0:20:55.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:56.00,0:20:58.59,Default,,0,0,0,,А... аа... Арне-сама?
Dialogue: 0,0:20:58.67,0:21:01.42,Default,,0,0,0,,Жарқанат - Арне-сама!
Dialogue: 0,0:21:01.51,0:21:02.63,Default,,0,0,0,,Біртүрлі. Шынында да, бәрі біртүрлі.
Dialogue: 0,0:21:02.72,0:21:05.09,Default,,0,0,0,,Мен әкемнің бөлмесін зерттедім.
Dialogue: 0,0:21:05.18,0:21:06.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:06.97,0:21:08.81,Default,,0,0,0,,Тергеу есебі
Dialogue: 0,0:21:09.85,0:21:11.60,Default,,0,0,0,,Бар
Dialogue: 0,0:21:12.81,0:21:16.56,Default,,0,0,0,,Жақында… дерлік
Dialogue: 0,0:21:25.61,0:21:30.62,Default,,0,0,0,,♪～
Dialogue: 0,0:22:48.57,0:22:54.08,Default,,0,0,0,,～♪
