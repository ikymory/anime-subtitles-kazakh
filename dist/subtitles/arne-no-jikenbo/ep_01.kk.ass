Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.33,0:00:08.13,Default,,0,0,0,,Дүниеде екі түрлі адамдар бар
Dialogue: 0,0:00:08.96,0:00:12.09,Default,,0,0,0,,Комикстерді ұнататындар және ұнатпайтындар
Dialogue: 0,0:00:13.84,0:00:15.68,Default,,0,0,0,,Әрине, мен бұрынғымын.
Dialogue: 0,0:00:15.76,0:00:19.43,Default,,0,0,0,,Жарайсыңдар! Вольфман қайтып келді! Хехе
Dialogue: 0,0:00:21.56,0:00:24.90,Default,,0,0,0,,Дүниеде екі түрлі адамдар бар.
Dialogue: 0,0:00:25.98,0:00:30.86,Default,,0,0,0,,Адам емес... Адам емеске сенетіндер де, сенбейтіндер де
Dialogue: 0,0:00:32.03,0:00:33.03,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:34.70,0:00:36.62,Default,,0,0,0,,Жауап бермес бұрын
Dialogue: 0,0:00:36.70,0:00:38.78,Default,,0,0,0,,I Луи Хартман
Dialogue: 0,0:00:38.87,0:00:40.58,Default,,0,0,0,,Бірінші оқиғаға тоқталайық.
Dialogue: 0,0:00:44.79,0:00:49.46,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:00:50.55,0:00:51.63,Default,,0,0,0,,Иә
Dialogue: 0,0:00:52.84,0:00:53.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:55.84,0:00:56.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:59.51,0:01:05.14,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:59.51,0:01:05.14,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:01:07.73,0:01:08.81,Default,,0,0,0,,Льюис…
Dialogue: 0,0:01:18.62,0:01:19.83,Default,,0,0,0,,Тек баралдай
Dialogue: 0,0:01:34.09,0:01:35.42,Default,,0,0,0,,Ананың...
Dialogue: 0,0:01:36.13,0:01:38.80,Default,,0,0,0,,Қан алынады...
Dialogue: 0,0:01:38.89,0:01:42.56,Default,,0,0,0,,Хартманды қабір қазушы вампир өлтірді.
Dialogue: 0,0:01:42.64,0:01:44.06,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:44.14,0:01:46.44,Default,,0,0,0,,Вампирлер – ырым
Dialogue: 0,0:01:46.52,0:01:49.02,Default,,0,0,0,,Оқиға нақты әлемде болып жатыр!
Dialogue: 0,0:01:49.10,0:01:53.28,Default,,0,0,0,,Бірақ кәдімгі адам осылай біреуді өлтіруі мүмкін... Иә?
Dialogue: 0,0:01:53.36,0:01:55.78,Default,,0,0,0,,Ах, мына үлкен тесік.
Dialogue: 0,0:01:55.86,0:01:58.82,Default,,0,0,0,,Сіз қабір қазатын вампирлер жоқ дейсіз!
Dialogue: 0,0:01:58.91,0:02:01.28,Default,,0,0,0,,Тоқта, Льюис! Жіберу!
Dialogue: 0,0:02:01.37,0:02:03.33,Default,,0,0,0,,Мен жібере алсам!
Dialogue: 0,0:02:03.41,0:02:05.08,Default,,0,0,0,,Жалпы, сендер полициясыңдар.
Dialogue: 0,0:02:05.16,0:02:07.29,Default,,0,0,0,,Өйткені біз қылмыскерді ешқашан ұстай алмаймыз.
Dialogue: 0,0:02:07.37,0:02:08.42,Default,,0,0,0,,Менің әкем осындай...
Dialogue: 0,0:02:08.50,0:02:10.04,Default,,0,0,0,,Ой! Незуко қайда?
Dialogue: 0,0:02:13.17,0:02:15.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:21.55,0:02:23.22,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:02:23.97,0:02:27.18,Default,,0,0,0,,Қылмыскерді өз қолыммен ұстаймын!
Dialogue: 0,0:02:29.94,0:02:33.52,Default,,0,0,0,,Есіктің ашылғанын естідім.
Dialogue: 0,0:02:34.15,0:02:37.32,Default,,0,0,0,,Менің жаңа есігім
Dialogue: 0,0:02:43.99,0:02:46.29,Default,,0,0,0,,Мен келе жатырмын, әке.
Dialogue: 0,0:02:52.63,0:02:57.13,Default,,0,0,0,,♪～
Dialogue: 0,0:04:16.29,0:04:21.30,Default,,0,0,0,,～♪
Dialogue: 0,0:04:31.14,0:04:32.60,Default,,0,0,0,,Бұл гуляш
Dialogue: 0,0:04:32.69,0:04:36.81,Default,,0,0,0,,Бұл ел тағамдары, бірақ оның дәмі үйдегі тағам сияқты ма?
Dialogue: 0,0:04:36.90,0:04:39.53,Default,,0,0,0,,Бұл дүкен өте танымал.
Dialogue: 0,0:04:39.61,0:04:41.11,Default,,0,0,0,,Кеше теңіз жағалауға барып келгенімізге байланысты,
Dialogue: 0,0:04:41.74,0:04:43.24,Default,,0,0,0,,Әй... Аделина
Dialogue: 0,0:04:43.32,0:04:45.49,Default,,0,0,0,,О, Одо, сен үйге барасың ба?
Dialogue: 0,0:04:45.57,0:04:47.78,Default,,0,0,0,,Ертең таңертең ерте.
Dialogue: 0,0:04:47.87,0:04:50.16,Default,,0,0,0,,Мен көремін. Шығару күні.
Dialogue: 0,0:04:50.24,0:04:53.12,Default,,0,0,0,,Қарияның шулағаны сонша, мені алып кетуді өтіндім.
Dialogue: 0,0:04:53.21,0:04:56.75,Default,,0,0,0,,Хехе, жақсы емес пе? Бұл перзенттік имандылықтың деңгейі.
Dialogue: 0,0:04:58.04,0:04:58.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:05.97,0:05:07.51,Default,,0,0,0,,Қош келдіңіз, Льюис.
Dialogue: 0,0:05:07.59,0:05:09.39,Default,,0,0,0,,Бүгін тағы патрульдесіз бе?
Dialogue: 0,0:05:09.47,0:05:12.47,Default,,0,0,0,,Соңғы оқиғадан бері бір ай өтті.
Dialogue: 0,0:05:12.56,0:05:14.73,Default,,0,0,0,,Тамырларды тым көп жинамаңыз.
Dialogue: 0,0:05:14.81,0:05:16.60,Default,,0,0,0,,Мен құлап қалсам, мен
Dialogue: 0,0:05:16.69,0:05:20.07,Default,,0,0,0,,Мен сенің әкең мен шешеңе қарсы тұра алмаймын.
Dialogue: 0,0:05:21.44,0:05:22.82,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:05:22.90,0:05:26.11,Default,,0,0,0,,Мен әкемді өлтірген адамды ұстағанша.
Dialogue: 0,0:05:26.20,0:05:28.16,Default,,0,0,0,,Ешқашан құламаңыз
Dialogue: 0,0:05:28.24,0:05:29.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:29.16,0:05:32.08,Default,,0,0,0,,Мені уайымдағаны осы.
Dialogue: 0,0:05:32.16,0:05:36.29,Default,,0,0,0,,Дұрыс, мен бүгін гуляш жасадым. Сізге ұнайды, солай емес пе?
Dialogue: 0,0:05:37.67,0:05:40.29,Default,,0,0,0,,Хехе, мен бірден әкелемін, отыра тұрыңыз.
Dialogue: 0,0:05:44.76,0:05:46.22,Default,,0,0,0,,Тыңда, Льюис.
Dialogue: 0,0:05:47.01,0:05:50.18,Default,,0,0,0,,Оқиғалар бұл жерде болмайды.
Dialogue: 0,0:05:50.26,0:05:52.64,Default,,0,0,0,,Бұл нақты әлемде болады
Dialogue: 0,0:05:52.72,0:05:53.56,Default,,0,0,0,,О...
Dialogue: 0,0:05:53.64,0:05:55.68,Default,,0,0,0,,Сүйікті сөз тіркесі: Әкемдікі
Dialogue: 0,0:05:55.77,0:05:57.85,Default,,0,0,0,,Сіз соншалықты көп айтасыз ба?
Dialogue: 0,0:05:57.94,0:05:59.15,Default,,0,0,0,,Мен айтып тұрмын
Dialogue: 0,0:05:59.23,0:06:02.73,Default,,0,0,0,,Қалай болғанда да, осыны есте сақтаңыз.
Dialogue: 0,0:06:02.82,0:06:05.28,Default,,0,0,0,,Шындықты көруді әдетке айналдырыңыз.
Dialogue: 0,0:06:05.36,0:06:07.24,Default,,0,0,0,,Оған да қарап қалмаңыз.
Dialogue: 0,0:06:07.32,0:06:08.99,Default,,0,0,0,,Бақылаңыз
Dialogue: 0,0:06:09.07,0:06:10.28,Default,,0,0,0,,Сонда сөзсіз
Dialogue: 0,0:06:10.37,0:06:12.74,Default,,0,0,0,,Ең бастысы көзге түседі
Dialogue: 0,0:06:14.04,0:06:16.21,Default,,0,0,0,,Әкем өлтірілген күннен бастап
Dialogue: 0,0:06:16.79,0:06:20.33,Default,,0,0,0,,Менің әлемімде қазір тек шындық бар
Dialogue: 0,0:06:20.42,0:06:24.51,Default,,0,0,0,,Әрбір шығарылымда пайда болатын құбыжықтар және әлемді құтқаратын кейіпкерлер
Dialogue: 0,0:06:24.59,0:06:26.63,Default,,0,0,0,,Із-түссіз жоғалып кетті
Dialogue: 0,0:06:26.72,0:06:28.43,Default,,0,0,0,,Құрметті Арне! иә?
Dialogue: 0,0:06:28.51,0:06:31.72,Default,,0,0,0,,Келесі құрбан пайда болған кезде тым кеш.
Dialogue: 0,0:06:31.80,0:06:32.81,Default,,0,0,0,,(үстелді түрту дыбысы)
Dialogue: 0,0:06:31.80,0:06:32.81,Default,,0,0,0,,Ал кінәлі вампир болуы мүмкін!
Dialogue: 0,0:06:32.81,0:06:35.14,Default,,0,0,0,,Ал кінәлі вампир болуы мүмкін!
Dialogue: 0,0:06:35.22,0:06:36.39,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:37.35,0:06:40.15,Default,,0,0,0,,Сабыр ет, Рин Рейнвейс
Dialogue: 0,0:06:40.23,0:06:42.77,Default,,0,0,0,,Вампирлер кінәлі
Dialogue: 0,0:06:42.86,0:06:44.78,Default,,0,0,0,,Бұл жай ғана өсек
Dialogue: 0,0:06:44.86,0:06:46.07,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:06:46.15,0:06:50.32,Default,,0,0,0,,Біз сериялық кісі өлтірушіні не болса да ұстауымыз керек.
Dialogue: 0,0:06:50.41,0:06:51.78,Default,,0,0,0,,Жоқ! Ах...
Dialogue: 0,0:06:51.87,0:06:53.66,Default,,0,0,0,,Бұл жағдайда кінәлі
Dialogue: 0,0:06:53.74,0:06:57.04,Default,,0,0,0,,Мен оны Хартманның детектив агенттігінен аламын!
Dialogue: 0,0:06:57.12,0:06:58.75,Default,,0,0,0,,Әкемнің жауларынан кек ал!
Dialogue: 0,0:06:58.83,0:07:01.71,Default,,0,0,0,,А... жау?
Dialogue: 0,0:07:01.79,0:07:04.63,Default,,0,0,0,,Балалар, сендер не істей аласыңдар!
Dialogue: 0,0:07:04.71,0:07:06.96,Default,,0,0,0,,А... бала дейсіз бе?
Dialogue: 0,0:07:07.05,0:07:09.30,Default,,0,0,0,,Сонда сен кімсің?
Dialogue: 0,0:07:09.38,0:07:10.22,Default,,0,0,0,,Сіз ересексіз бе?
Dialogue: 0,0:07:10.30,0:07:13.18,Default,,0,0,0,,Әлде суперқаһарман ба?
Dialogue: 0,0:07:13.26,0:07:16.22,Default,,0,0,0,,Хмм... мен...
Dialogue: 0,0:07:16.31,0:07:17.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.69,0:07:21.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:21.60,0:07:22.77,Default,,0,0,0,,Льюис!
Dialogue: 0,0:07:26.02,0:07:28.82,Default,,0,0,0,,Бір-біріне соқтығысқаннан кейін де «кешірім» жоқ па?
Dialogue: 0,0:07:28.90,0:07:30.03,Default,,0,0,0,,Жаман қыз.
Dialogue: 0,0:07:30.11,0:07:34.03,Default,,0,0,0,,Кешіріңіз, бірақ бұл түсінікті.
Dialogue: 0,0:07:34.12,0:07:37.04,Default,,0,0,0,,Льюистің әкесі бесінші құрбан болды...
Dialogue: 0,0:07:37.12,0:07:38.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:38.25,0:07:40.25,Default,,0,0,0,,Мен жеке тергеуші болдым.
Dialogue: 0,0:07:40.33,0:07:41.75,Default,,0,0,0,,Қаладағы қауесеттер
Dialogue: 0,0:07:41.83,0:07:45.17,Default,,0,0,0,,Олар қылмыскерге жақын болған сияқты.
Dialogue: 0,0:07:45.25,0:07:47.63,Default,,0,0,0,,Сол себепті өлтірілді.
Dialogue: 0,0:07:55.43,0:07:56.31,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:56.39,0:07:59.02,Default,,0,0,0,,Льюис мырза...?
Dialogue: 0,0:07:59.10,0:08:00.31,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:08:02.94,0:08:03.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:17.03,0:08:19.58,Default,,0,0,0,,Уау~ Хэхе
Dialogue: 0,0:08:19.66,0:08:21.75,Default,,0,0,0,,Бұл өте әдемі!
Dialogue: 0,0:08:21.83,0:08:25.71,Default,,0,0,0,,Мұндай үлкен гүлзарға күтім жасау қиын.
Dialogue: 0,0:08:25.79,0:08:28.92,Default,,0,0,0,,Қалада барлығы саған қамқорлық жасай ма?
Dialogue: 0,0:08:29.42,0:08:30.71,Default,,0,0,0,,Аделина
Dialogue: 0,0:08:30.80,0:08:33.05,Default,,0,0,0,,Бұл керемет, Аделина.
Dialogue: 0,0:08:33.13,0:08:35.80,Default,,0,0,0,,Осындай керемет дүкенді басқарудың үстіне,
Dialogue: 0,0:08:35.89,0:08:38.06,Default,,0,0,0,,Гүл бақшасына күтім жасау
Dialogue: 0,0:08:40.31,0:08:41.64,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:41.73,0:08:45.69,Default,,0,0,0,,Аделина менен Луис туралы сұрады.
Dialogue: 0,0:08:45.77,0:08:46.86,Default,,0,0,0,,Егер сізде жанашырлық болса...
Dialogue: 0,0:08:47.90,0:08:49.73,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:08:50.32,0:08:52.32,Default,,0,0,0,,Біз ұқсаспыз.
Dialogue: 0,0:08:52.40,0:08:53.32,Default,,0,0,0,,А...
Dialogue: 0,0:08:59.33,0:09:00.62,Default,,0,0,0,,Сіз де?
Dialogue: 0,0:09:01.50,0:09:03.91,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:04.00,0:09:08.42,Default,,0,0,0,,Менің атым Линн Райнвейс және мен Арне детектив агенттігінің көмекшісімін.
Dialogue: 0,0:09:08.50,0:09:11.00,Default,,0,0,0,,Арне Детектив Агенттігі...
Dialogue: 0,0:09:11.09,0:09:13.38,Default,,0,0,0,,Бұл бала детектив пе?
Dialogue: 0,0:09:13.47,0:09:17.18,Default,,0,0,0,,Иә! Арне мырза біздің кеңсенің директоры.
Dialogue: 0,0:09:17.26,0:09:20.14,Default,,0,0,0,,Ол өте жақсы детектив.
Dialogue: 0,0:09:20.97,0:09:23.10,Default,,0,0,0,,Сіз бәсекелессіз бе?
Dialogue: 0,0:09:23.18,0:09:25.10,Default,,0,0,0,,Льюис мырза
Dialogue: 0,0:09:25.19,0:09:27.77,Default,,0,0,0,,Бізбен күш біріктіргіңіз келе ме?
Dialogue: 0,0:09:27.85,0:09:31.02,Default,,0,0,0,,Сериялық өлтірушіні тез және сенімді ұстау
Dialogue: 0,0:09:31.11,0:09:31.94,Default,,0,0,0,,Бас тарт!
Dialogue: 0,0:09:32.53,0:09:35.03,Default,,0,0,0,,Мен сізге қылмыскерді ұстаймын дедім.
Dialogue: 0,0:09:35.11,0:09:39.07,Default,,0,0,0,,Хартманның детектив агенттігі Блуменштадттың қиын ісімен жұмыс істеп жатыр...
Dialogue: 0,0:09:39.16,0:09:41.12,Default,,0,0,0,,Әкем шешті!
Dialogue: 0,0:09:41.20,0:09:44.08,Default,,0,0,0,,Енді мен әкемнің міндетін аламын!
Dialogue: 0,0:09:44.16,0:09:47.04,Default,,0,0,0,,Мен ешкімнің көмегін де, аяушылықты да қабылдамаймын!
Dialogue: 0,0:09:48.21,0:09:52.80,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:09:52.88,0:09:56.30,Default,,0,0,0,,Сонда жай ғана ақпарат алмасу туралы не айтасыз?
Dialogue: 0,0:09:56.97,0:09:59.80,Default,,0,0,0,,Бұл көмек те, рақым да емес.
Dialogue: 0,0:09:59.89,0:10:04.39,Default,,0,0,0,,Мұның бәрі басқа адамды өз мақсаттарыңыз үшін пайдалану туралы.
Dialogue: 0,0:10:04.47,0:10:07.23,Default,,0,0,0,,Мен жалған ақпарат таратсам ше?
Dialogue: 0,0:10:07.31,0:10:09.90,Default,,0,0,0,,Сол кезде бұл Лин Рейнвейс
Dialogue: 0,0:10:09.98,0:10:12.32,Default,,0,0,0,,Мастер Арненің көмекшісінің атынан...
Dialogue: 0,0:10:12.40,0:10:15.57,Default,,0,0,0,,«Бұл өтірік!» Мен сізге дәл сол арқылы көрсетемін.
Dialogue: 0,0:10:15.65,0:10:16.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:20.37,0:10:23.45,Default,,0,0,0,,Жарайды... жай ғана ақпарат алмасу.
Dialogue: 0,0:10:24.41,0:10:25.95,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:33.59,0:10:36.05,Default,,0,0,0,,Мен бұл оқиғаны естігенде
Dialogue: 0,0:10:36.13,0:10:38.59,Default,,0,0,0,,Біз жақын маңдағы қалалар мен ауылдарға да барамыз.
Dialogue: 0,0:10:38.68,0:10:41.72,Default,,0,0,0,,Біз осыған ұқсас оқиғалардың болған-болмағанын зерттедік.
Dialogue: 0,0:10:41.80,0:10:44.85,Default,,0,0,0,,Бірде-бір оқиға болған жоқ ...
Dialogue: 0,0:10:44.93,0:10:49.35,Default,,0,0,0,,Қабір қазушы вампир оқиғасы тек осы ауылда болып жатыр.
Dialogue: 0,0:10:49.44,0:10:50.27,Default,,0,0,0,,А...
Dialogue: 0,0:10:50.35,0:10:51.98,Default,,0,0,0,,Мұның бәрі қылмыскер үшін
Dialogue: 0,0:10:52.06,0:10:55.82,Default,,0,0,0,,Бұл ауылда қылмыс жасаудың мәні бар екенін білдіреді.
Dialogue: 0,0:10:55.90,0:10:57.99,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:10:58.07,0:11:02.87,Default,,0,0,0,,Қылмыскердің шын мақсаты - көп мөлшердегі қанды ұрлау.
Dialogue: 0,0:11:02.95,0:11:04.28,Default,,0,0,0,,Льюис мырза
Dialogue: 0,0:11:04.37,0:11:06.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:06.12,0:11:09.79,Default,,0,0,0,,Құрметті Арне, сіздің қаныңызды ұрлаудағы мақсат не?
Dialogue: 0,0:11:09.87,0:11:10.75,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:11:10.83,0:11:12.83,Default,,0,0,0,,Өйткені біз бірінші кезекте қан жинап жатырмыз.
Dialogue: 0,0:11:12.92,0:11:16.00,Default,,0,0,0,,Ол «Қабір қазушы вампир» деп аталады, солай ма?
Dialogue: 0,0:11:16.09,0:11:19.13,Default,,0,0,0,,Қылмыскер алған қанды не істейді?
Dialogue: 0,0:11:19.22,0:11:21.51,Default,,0,0,0,,Сіз қалай ойлайсыз, Льюис мырза?
Dialogue: 0,0:11:21.59,0:11:24.26,Default,,0,0,0,,Хм... Ішетін шығармын?
Dialogue: 0,0:11:24.35,0:11:25.93,Default,,0,0,0,,Менің вампир болғаным үшін емес.
Dialogue: 0,0:11:26.01,0:11:28.77,Default,,0,0,0,,Өйткені ол өзін вампирмін деп ойлайтын адам.
Dialogue: 0,0:11:28.85,0:11:33.15,Default,,0,0,0,,«Бұл әлемде нағыз вампирлер жоқ».
Dialogue: 0,0:11:33.23,0:11:36.86,Default,,0,0,0,,Әрине, бұл нақты әлемде болып жатыр.
Dialogue: 0,0:11:36.94,0:11:37.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:38.03,0:11:40.11,Default,,0,0,0,,Бұл не, Линн Рейнвейс?
Dialogue: 0,0:11:40.20,0:11:43.95,Default,,0,0,0,,Менің ойымша, бұл кінәлі вампир емес.
Dialogue: 0,0:11:44.03,0:11:46.20,Default,,0,0,0,,Сонымен вампирлер...
Dialogue: 0,0:11:46.28,0:11:48.83,Default,,0,0,0,,Ал, мені тыңда.
Dialogue: 0,0:11:49.54,0:11:52.17,Default,,0,0,0,,Бүгін таңертең Мастер Арне екеуміз мәйітханаға бардық.
Dialogue: 0,0:11:52.25,0:11:56.42,Default,,0,0,0,,Маған 11-ші және ең жаңа құрбанның денесін көрсетті.
Dialogue: 0,0:11:56.50,0:11:59.13,Default,,0,0,0,,Мәйітте вампирдің тістеген іздері бар.
Dialogue: 0,0:11:59.21,0:12:00.97,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:01.05,0:12:04.18,Default,,0,0,0,,Сондықтан мен кінәлі вампир емес деп ойлаймын.
Dialogue: 0,0:12:04.26,0:12:05.76,Default,,0,0,0,,Негіздер 1
Dialogue: 0,0:12:05.85,0:12:07.06,Default,,0,0,0,,және негіздер 2
Dialogue: 0,0:12:07.14,0:12:10.73,Default,,0,0,0,,Бұл қылмыскер ұрлаған қанның көп мөлшерінде.
Dialogue: 0,0:12:10.81,0:12:13.23,Default,,0,0,0,,Қылмыскер денені орасан зор күшпен қысты.
Dialogue: 0,0:12:13.31,0:12:15.94,Default,,0,0,0,,Қанның көп мөлшері жиналып жатыр деген ой бар.
Dialogue: 0,0:12:16.02,0:12:17.73,Default,,0,0,0,,Осылайша жиналған қанның құрамында
Dialogue: 0,0:12:17.82,0:12:20.44,Default,,0,0,0,,Қоспалардың көп мөлшерін араластыру керек.
Dialogue: 0,0:12:20.53,0:12:22.32,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:20.53,0:12:22.32,Default,,0,0,0,,Барлық вампирлер - керемет гурмандар.
Dialogue: 0,0:12:22.32,0:12:23.11,Default,,0,0,0,,Барлық вампирлер - керемет гурмандар.
Dialogue: 0,0:12:23.20,0:12:24.11,Default,,0,0,0,,Құрамында қоспасы бар қанды қалаймын.
Dialogue: 0,0:12:24.11,0:12:25.12,Default,,0,0,0,,Ішінде қоспасы бар қанды қалаймын.
Dialogue: 0,0:12:24.11,0:12:25.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:25.12,0:12:26.70,Default,,0,0,0,,Ішінде қоспасы бар қанды қалаймын.
Dialogue: 0,0:12:26.78,0:12:31.83,Default,,0,0,0,,Сондықтан сериялық өлтіруші/вампир теориясы 100% мүмкін емес!
Dialogue: 0,0:12:31.91,0:12:33.29,Default,,0,0,0,,Дәлелдеу
Dialogue: 0,0:12:33.37,0:12:36.88,Default,,0,0,0,,Вампирлер сияқты шындыққа жанаспайтын нәрселер бар деп есептей отырып.
Dialogue: 0,0:12:36.96,0:12:39.80,Default,,0,0,0,,Талқылау кезінде 100% мүмкін емес!
Dialogue: 0,0:12:39.88,0:12:41.51,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:41.59,0:12:45.76,Default,,0,0,0,,Көбірек болса, қандай ақпаратты тапқаныңызды айтыңыз.
Dialogue: 0,0:12:45.84,0:12:49.64,Default,,0,0,0,,Құрбандардың барлығы ірі денелі адамдар.
Dialogue: 0,0:12:49.72,0:12:54.90,Default,,0,0,0,,Жасы, кәсібі, үйленген немесе үйленбеген, хоббиі, т.б. әр түрлі болады.
Dialogue: 0,0:12:54.98,0:12:56.73,Default,,0,0,0,,Олардың дене бітімдері бірдей
Dialogue: 0,0:12:56.81,0:13:01.86,Default,,0,0,0,,Бұл үлкен адамнан көп қан жинауға болатынын білдіре ме?
Dialogue: 0,0:13:01.94,0:13:05.61,Default,,0,0,0,,Барлық қылмыстар түн ортасы мен таңның таңы аралығында болған.
Dialogue: 0,0:13:05.70,0:13:08.24,Default,,0,0,0,,Бұл да жәбірленуші жалғыз болған кезде.
Dialogue: 0,0:13:08.33,0:13:09.83,Default,,0,0,0,,Жақсы көздеу
Dialogue: 0,0:13:09.91,0:13:12.83,Default,,0,0,0,,Бұл қылмыскер өте жақсы хабардар.
Dialogue: 0,0:13:12.91,0:13:14.96,Default,,0,0,0,,Бір түнде
Dialogue: 0,0:13:15.04,0:13:17.79,Default,,0,0,0,,Өйткені ол кісі өлтірудің осы түрін жасады.
Dialogue: 0,0:13:17.88,0:13:19.96,Default,,0,0,0,,Қылмыскердің өзі ірі адам.
Dialogue: 0,0:13:20.05,0:13:23.59,Default,,0,0,0,,Немесе қылмысты бірнеше қылмыскер жасаған деп есептейді.
Dialogue: 0,0:13:23.67,0:13:26.22,Default,,0,0,0,,Жақсы зерттеліп, талданған.
Dialogue: 0,0:13:26.30,0:13:27.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:27.84,0:13:30.97,Default,,0,0,0,,Өйткені ол Винсент Хартманның ұлы.
Dialogue: 0,0:13:32.52,0:13:34.43,Default,,0,0,0,,Бұл менің барлық ақпаратым.
Dialogue: 0,0:13:34.52,0:13:37.27,Default,,0,0,0,,Ах... ақпарат алмасуды аяқтаған соң.
Dialogue: 0,0:13:37.35,0:13:40.07,Default,,0,0,0,,Мен шай ішуді ойладым.
Dialogue: 0,0:13:40.15,0:13:42.07,Default,,0,0,0,,Менің бұған уақытым жоқ.
Dialogue: 0,0:13:42.15,0:13:44.03,Default,,0,0,0,,Қалғанын өзім істеймін.
Dialogue: 0,0:13:44.11,0:13:48.66,Default,,0,0,0,,Рин-чанның әрекетін менсінбейтін адам мың өлімге лайық екенін білесіз бе?
Dialogue: 0,0:13:50.28,0:13:51.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:52.70,0:13:55.41,Default,,0,0,0,,Уф... (Эми) Мен білемін... солай ма?
Dialogue: 0,0:13:55.50,0:13:57.58,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:13:58.29,0:13:59.83,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:14:01.42,0:14:02.42,Default,,0,0,0,,Какао…
Dialogue: 0,0:14:02.50,0:14:05.92,Default,,0,0,0,,Аделина маған Луисті ұнататынын айтты.
Dialogue: 0,0:14:08.76,0:14:10.30,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:14:10.39,0:14:11.81,Default,,0,0,0,,Құрамында зефир бар ма?
Dialogue: 0,0:14:11.89,0:14:14.60,Default,,0,0,0,,Әрине жасадым!
Dialogue: 0,0:14:17.31,0:14:18.52,Default,,0,0,0,,Льюис мырза
Dialogue: 0,0:14:19.02,0:14:23.19,Default,,0,0,0,,Іс шешілгеннен кейін бізбен бірге келгіңіз келе ме?
Dialogue: 0,0:14:23.28,0:14:27.65,Default,,0,0,0,,Арне-сама керемет детектив, сондықтан одан көп нәрсені үйренетініңізге сенімдімін.
Dialogue: 0,0:14:28.20,0:14:31.03,Default,,0,0,0,,Ей, рұқсатсыз көмекшілер санын көбейтуге тырыспа.
Dialogue: 0,0:14:31.12,0:14:34.87,Default,,0,0,0,,Мұндай мейірімділік те Рин Чанның бір сүйкімділігі.
Dialogue: 0,0:14:34.95,0:14:36.29,Default,,0,0,0,,Әрине
Dialogue: 0,0:14:36.37,0:14:39.42,Default,,0,0,0,,Жауап бермес бұрын жақсылап ойлану керек.
Dialogue: 0,0:14:41.21,0:14:42.84,Default,,0,0,0,,Ойлан
Dialogue: 0,0:14:42.92,0:14:44.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:47.22,0:14:48.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.88,0:14:52.55,Default,,0,0,0,,А, бұл қызанақ шырыны.
Dialogue: 0,0:14:52.64,0:14:54.56,Default,,0,0,0,,Томат шырыны...
Dialogue: 0,0:14:55.31,0:14:58.14,Default,,0,0,0,,Түсі қызыл, қанға ұқсайды, солай ма?
Dialogue: 0,0:14:58.23,0:15:00.69,Default,,0,0,0,,Сондықтан қанды елестетіп ішкенде,
Dialogue: 0,0:15:00.77,0:15:01.27,Default,,0,0,0,,Сіз өзіңізді вампир сияқты сезіне аласыз...
Dialogue: 0,0:15:01.27,0:15:02.11,Default,,0,0,0,,Сіз өзіңізді вампир сияқты сезінесіз...
Dialogue: 0,0:15:01.27,0:15:02.11,Default,,0,0,0,,Льюис
Dialogue: 0,0:15:02.11,0:15:02.19,Default,,0,0,0,,Сіз өзіңізді вампир сияқты сезінесіз...
Dialogue: 0,0:15:02.19,0:15:03.02,Default,,0,0,0,,Сіз өзіңізді вампир сияқты сезіне аласыз...
Dialogue: 0,0:15:02.19,0:15:03.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:03.11,0:15:05.23,Default,,0,0,0,,Мен қанның иісін сеземін.
Dialogue: 0,0:15:05.32,0:15:08.19,Default,,0,0,0,,А, онда...
Dialogue: 0,0:15:08.28,0:15:09.90,Default,,0,0,0,,Басқалар болуы мүмкін.
Dialogue: 0,0:15:09.99,0:15:11.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:14.95,0:15:16.16,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:15:16.24,0:15:19.91,Default,,0,0,0,,Анамның ең қастерлеген орамал
Dialogue: 0,0:15:20.00,0:15:22.63,Default,,0,0,0,,Әкем өлтірілгенде қасымда болды.
Dialogue: 0,0:15:23.59,0:15:26.88,Default,,0,0,0,,Сен анаңды жақсы көрдің.
Dialogue: 0,0:15:30.18,0:15:31.01,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:31.09,0:15:34.01,Default,,0,0,0,,Шындықты көруді әдетке айналдырыңыз.
Dialogue: 0,0:15:34.10,0:15:37.52,Default,,0,0,0,,Қарап қана қоймай, бақылаңыз.
Dialogue: 0,0:15:39.06,0:15:40.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:45.11,0:15:46.19,Default,,0,0,0,,Хартманды қабір қазушы вампир өлтірді.
Dialogue: 0,0:15:46.19,0:15:47.86,Default,,0,0,0,,Хартманды қабір қазушы вампир өлтірді.
Dialogue: 0,0:15:46.19,0:15:47.86,Default,,0,0,0,,Бірақ осылай өлтіресің.
Dialogue: 0,0:15:47.94,0:15:49.53,Default,,0,0,0,,Мұның бәрі қылмыскер үшін.
Dialogue: 0,0:15:47.94,0:15:49.53,Default,,0,0,0,,Егер сіз қарапайым адам болсаңыз... иә?
Dialogue: 0,0:15:49.61,0:15:51.82,Default,,0,0,0,,Бұл ауылда қылмыс жасаудың мәні бар екенін білдіреді.
Dialogue: 0,0:15:49.61,0:15:51.82,Default,,0,0,0,,Ах, мына үлкен тесік.
Dialogue: 0,0:15:51.82,0:15:51.91,Default,,0,0,0,,Ах, мына үлкен тесік.
Dialogue: 0,0:15:51.91,0:15:53.74,Default,,0,0,0,,Әй, мына үлкен тесік.
Dialogue: 0,0:15:51.91,0:15:53.74,Default,,0,0,0,,Қылмыскердің өзі ірі адам.
Dialogue: 0,0:15:53.82,0:15:54.99,Default,,0,0,0,,Қылмыскер қанды алды
Dialogue: 0,0:15:53.82,0:15:54.99,Default,,0,0,0,,Немесе қылмысты бірнеше қылмыскерлер жасаған деп есептейді.
Dialogue: 0,0:15:54.99,0:15:55.08,Default,,0,0,0,,Немесе қылмысты бірнеше қылмыскер жасаған деп есептейді.
Dialogue: 0,0:15:55.08,0:15:57.41,Default,,0,0,0,,Немесе қылмысты бірнеше қылмыскер жасаған деп есептейді.
Dialogue: 0,0:15:55.08,0:15:57.41,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:58.66,0:16:00.37,Default,,0,0,0,,Мен сен осы тасты жарып өте алмайсың деп ойладым…
Dialogue: 0,0:16:01.08,0:16:02.04,Default,,0,0,0,,Льюис! Бұл қиын, Льюис!
Dialogue: 0,0:16:02.04,0:16:03.71,Default,,0,0,0,,Льюис! Бұл қиын, Льюис!
Dialogue: 0,0:16:06.25,0:16:09.05,Default,,0,0,0,,Одо... өлді ме?
Dialogue: 0,0:16:09.13,0:16:11.84,Default,,0,0,0,,Әй, мен өз өмірімді өзім қидым.
Dialogue: 0,0:16:11.93,0:16:13.13,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:13.22,0:16:14.26,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:16:14.34,0:16:19.22,Default,,0,0,0,,«Мен қабір қазушы вампирмін» деген өз-өзіне қол жұмсау туралы жазба қалды.
Dialogue: 0,0:16:19.31,0:16:20.48,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:20.56,0:16:24.60,Default,,0,0,0,,Льюис, бұл сенің әкеңді бақытты ететін шығар.
Dialogue: 0,0:16:24.69,0:16:26.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:26.77,0:16:28.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:29.32,0:16:30.74,Default,,0,0,0,,Льюис мырза!
Dialogue: 0,0:16:31.53,0:16:36.53,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:16:48.00,0:16:50.96,Default,,0,0,0,,Аделина қабір қазушы вампир болған, солай ма?
Dialogue: 0,0:16:53.51,0:16:56.89,Default,,0,0,0,,Кеше түнде сіз сыбайласыңыз Одоны өлтірдіңіз.
Dialogue: 0,0:16:56.97,0:16:59.51,Default,,0,0,0,,Жоқ, Льюис, сен не туралы айтып тұрсың?
Dialogue: 0,0:16:59.60,0:17:03.98,Default,,0,0,0,,Оның өзін-өзі өлтіру сияқты көріну себебі Одоның қылмысты жалғыз жасағанын жасыру болды.
Dialogue: 0,0:17:04.06,0:17:05.81,Default,,0,0,0,,Сіз шаршадыңыз.
Dialogue: 0,0:17:05.90,0:17:08.48,Default,,0,0,0,,Сол себепті мен сендерге тамырды толтырмаңдар дедім.
Dialogue: 0,0:17:08.57,0:17:11.94,Default,,0,0,0,,Әкем мен шешем маған шындықты айтты.
Dialogue: 0,0:17:12.03,0:17:13.90,Default,,0,0,0,,Бейшара Льюис
Dialogue: 0,0:17:13.99,0:17:16.41,Default,,0,0,0,,Екеуі баяғыда өлген.
Dialogue: 0,0:17:18.41,0:17:22.37,Default,,0,0,0,,Бұл әкем өлтірілгенде қасында болған анамның орамалы.
Dialogue: 0,0:17:23.41,0:17:26.83,Default,,0,0,0,,Әкем бұл туралы өлетін хабар қалдырды.
Dialogue: 0,0:17:28.08,0:17:31.30,Default,,0,0,0,,Маған сеніңіз, байқаймын.
Dialogue: 0,0:17:31.38,0:17:32.96,Default,,0,0,0,,Льюис…
Dialogue: 0,0:17:33.84,0:17:36.72,Default,,0,0,0,,Ақ гүлге қызыл сұйықтық берсең
Dialogue: 0,0:17:36.80,0:17:40.18,Default,,0,0,0,,Гүлдің жапырақтарын сорып қызыл түске бояйды.
Dialogue: 0,0:17:40.85,0:17:44.06,Default,,0,0,0,,Ақ гүлдерді қызыл түске бояған адам кінәлі.
Dialogue: 0,0:17:44.14,0:17:46.14,Default,,0,0,0,,Мұны маған әкем айтты.
Dialogue: 0,0:17:46.23,0:17:50.44,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:17:50.52,0:17:53.11,Default,,0,0,0,,Мен бұл гүлді жақсы көремін
Dialogue: 0,0:17:53.19,0:17:54.65,Default,,0,0,0,,Түстен басқа.
Dialogue: 0,0:17:55.45,0:17:57.41,Default,,0,0,0,,Сондықтан мен оны өзгертемін
Dialogue: 0,0:17:57.49,0:18:00.83,Default,,0,0,0,,Қараңызшы, бұл сізге жақсы көрінеді, солай ма? маған
Dialogue: 0,0:18:00.91,0:18:05.58,Default,,0,0,0,,Бұл гүлдің түсі ғана емес пе? Неге...
Dialogue: 0,0:18:05.66,0:18:08.50,Default,,0,0,0,,Қалаған түске қалай бояймын
Dialogue: 0,0:18:08.58,0:18:11.04,Default,,0,0,0,,Адамның қаны ең жақсы
Dialogue: 0,0:18:11.13,0:18:15.01,Default,,0,0,0,,Көзімнің түсіндей қызыл қан!
Dialogue: 0,0:18:15.09,0:18:16.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:18.80,0:18:21.18,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:18:21.85,0:18:22.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:22.76,0:18:25.68,Default,,0,0,0,,Бір ғана қателік бар, Льюис.
Dialogue: 0,0:18:32.98,0:18:35.36,Default,,0,0,0,,Менің сыбайласым ақымақ емес.
Dialogue: 0,0:18:35.44,0:18:37.03,Default,,0,0,0,,Бұл голем.
Dialogue: 0,0:18:37.11,0:18:40.49,Default,,0,0,0,,Өйткені мен големдерді қолданатын бақсымын.
Dialogue: 0,0:18:43.33,0:18:45.33,Default,,0,0,0,,Қабір...?
Dialogue: 0,0:18:47.37,0:18:48.37,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:54.13,0:18:55.76,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:59.18,0:19:00.51,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:19:05.10,0:19:07.77,Default,,0,0,0,,Қош бол Льюис
Dialogue: 0,0:19:14.82,0:19:16.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:22.87,0:19:24.91,Default,,0,0,0,,Al...ne?
Dialogue: 0,0:19:25.83,0:19:28.37,Default,,0,0,0,,Мен осы жерден басшылықты аламын.
Dialogue: 0,0:19:36.46,0:19:39.34,Default,,0,0,0,,Жоқ... вампир ме?
Dialogue: 0,0:19:39.42,0:19:41.72,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:19:42.39,0:19:45.10,Default,,0,0,0,,Мен жай вампир емеспін.
Dialogue: 0,0:19:49.35,0:19:51.14,Default,,0,0,0,,Голем!
Dialogue: 0,0:19:55.98,0:19:57.57,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:59.57,0:20:04.07,Default,,0,0,0,,Вампирлердің жоғарғы жағында тұрған тоғыз патшасы бар.
Dialogue: 0,0:20:04.95,0:20:09.08,Default,,0,0,0,,Баяғыда сол патшалар дүниені билеуге келді.
Dialogue: 0,0:20:09.16,0:20:11.37,Default,,0,0,0,,Әр жүректі ұсын
Dialogue: 0,0:20:11.46,0:20:15.59,Default,,0,0,0,,Ең күшті және ең өлімші вампир дүниеге келді.
Dialogue: 0,0:20:16.92,0:20:18.30,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:18.38,0:20:20.84,Default,,0,0,0,,Бұл Арне Нойнтатор!
Dialogue: 0,0:20:23.64,0:20:24.64,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:20:25.80,0:20:28.14,Default,,0,0,0,,Вампирлер бар
Dialogue: 0,0:20:28.89,0:20:30.89,Default,,0,0,0,,Бақсылар да, големалар да
Dialogue: 0,0:20:30.98,0:20:33.39,Default,,0,0,0,,Ал ол...
Dialogue: 0,0:20:33.48,0:20:36.36,Default,,0,0,0,,Арне Нойнтатор – қаһарман
Dialogue: 0,0:20:36.44,0:20:37.19,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:37.19,0:20:38.65,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:37.19,0:20:38.65,Default,,0,0,0,,Әке, бұл нағыз дүние.
Dialogue: 0,0:20:38.65,0:20:41.32,Default,,0,0,0,,Әке, бұл нағыз дүние.
Dialogue: 0,0:20:41.40,0:20:42.32,Default,,0,0,0,,Льюис мырза!
Dialogue: 0,0:20:46.82,0:20:50.16,Default,,0,0,0,,Льюис мырза, Льюис мырза!
Dialogue: 0,0:20:50.24,0:20:51.91,Default,,0,0,0,,Льюис мырза!
Dialogue: 0,0:20:53.00,0:20:56.96,Default,,0,0,0,,Есіктің жабылғанын естідім.
Dialogue: 0,0:20:57.04,0:20:58.42,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:20:58.50,0:21:02.26,Default,,0,0,0,,Бұл менің қысқа ғұмырымның біткен үні.
Dialogue: 0,0:21:04.88,0:21:06.05,Default,,0,0,0,,Голем!
Dialogue: 0,0:21:06.14,0:21:08.01,Default,,0,0,0,,(Голем ырылдады)
Dialogue: 0,0:21:08.85,0:21:09.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:16.02,0:21:17.40,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:21:18.44,0:21:19.27,Default,,0,0,0,,Kia...
Dialogue: 0,0:21:21.94,0:21:22.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:24.61,0:21:25.99,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:21:29.66,0:21:30.74,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:21:30.83,0:21:32.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:32.37,0:21:34.75,Default,,0,0,0,,Некромансердің қабілетін пайдаландым.
Dialogue: 0,0:21:35.75,0:21:38.21,Default,,0,0,0,,Мен кек аламын, Льюис.
Dialogue: 0,0:21:40.50,0:21:44.38,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,0:21:44.47,0:21:46.18,Default,,0,0,0,,Он жыл. Мен он жыл күттім.
Dialogue: 0,0:21:46.26,0:21:47.09,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:21:47.93,0:21:53.02,Default,,0,0,0,,(қайталанған пышақтау дыбысы)
Dialogue: 0,0:21:59.15,0:22:00.98,Default,,0,0,0,,Ол мүлде келмейді.
Dialogue: 0,0:22:01.07,0:22:02.61,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:22:02.69,0:22:06.11,Default,,0,0,0,,Мұнда күніне үш автобус қана жүреді.
Dialogue: 0,0:22:06.61,0:22:08.57,Default,,0,0,0,,Жарайды, жүрейік. (Эми) Иә.
Dialogue: 0,0:22:11.74,0:22:14.16,Default,,0,0,0,,Кел, Линн Райнвейс
Dialogue: 0,0:22:15.58,0:22:17.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:19.21,0:22:22.59,Default,,0,0,0,,Хм... Аа~ жақсы ұйықтадым.
Dialogue: 0,0:22:22.67,0:22:24.01,Default,,0,0,0,,Сіз ақыры ояндыңыз.
Dialogue: 0,0:22:24.09,0:22:24.92,Default,,0,0,0,,Біраз
Dialogue: 0,0:22:25.01,0:22:26.76,Default,,0,0,0,,Қанша ұйықтасаң да, көп ұйықтайсың.
Dialogue: 0,0:22:26.84,0:22:28.93,Default,,0,0,0,,Бұл жерде көп қиындық көрдік.
Dialogue: 0,0:22:29.01,0:22:31.51,Default,,0,0,0,,? Мен бұл туралы білмеймін
Dialogue: 0,0:22:31.60,0:22:34.43,Default,,0,0,0,,Бұлай айтқаның мені ашуландырады.
Dialogue: 0,0:22:38.44,0:22:40.94,Default,,0,0,0,,Осылайша Арне Детектив Агенттігі
Dialogue: 0,0:22:41.02,0:22:43.07,Default,,0,0,0,,Бір іс шешілді
Dialogue: 0,0:22:45.11,0:22:47.90,Default,,0,0,0,,Бірақ менің демалуға уақытым жоқ.
Dialogue: 0,0:22:47.99,0:22:49.66,Default,,0,0,0,,Арне-сама екеуміздің алдында
Dialogue: 0,0:22:49.74,0:22:52.12,Default,,0,0,0,,Қиын істер әлі де көп.
Dialogue: 0,0:22:52.20,0:22:54.24,Default,,0,0,0,,Мен сені күтемін.
Dialogue: 0,0:22:55.74,0:23:01.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
