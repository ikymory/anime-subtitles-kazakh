Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.58,0:00:05.08,Default,,0,0,0,,♪～
Dialogue: 0,0:01:24.25,0:01:29.25,Default,,0,0,0,,～♪
Dialogue: 0,0:01:35.80,0:01:37.93,Default,,0,0,0,,Алдымен алибиіңізді тексеріңіз.
Dialogue: 0,0:01:38.51,0:01:40.47,Default,,0,0,0,,Үйдің иесі - Лин Рейнвейс.
Dialogue: 0,0:01:40.55,0:01:41.93,Default,,0,0,0,,Қоңырау шалмас бұрын
Dialogue: 0,0:01:42.01,0:01:46.19,Default,,0,0,0,,Екі қызметші бірінші болып әрекет етті, солай ма?
Dialogue: 0,0:01:46.85,0:01:47.77,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:01:47.85,0:01:49.31,Default,,0,0,0,,Диана да бөлмесінен шығып кетті.
Dialogue: 0,0:01:49.40,0:01:51.27,Default,,0,0,0,,Екінші қабаттағы қонақ бөлмесіне барсам, Джише...
Dialogue: 0,0:01:51.36,0:01:53.94,Default,,0,0,0,,А... хмм, мен оны айнадан көрдім.
Dialogue: 0,0:01:54.03,0:01:55.24,Default,,0,0,0,,Құдай-ай. Дұшпанның қабілетін түсіне бастадым.
Dialogue: 0,0:01:55.32,0:01:58.82,Default,,0,0,0,,Айна алдынан өткенде оны көруге болатындай етіп жасалған.
Dialogue: 0,0:01:58.91,0:01:59.91,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:59.99,0:02:03.37,Default,,0,0,0,,Басқаша айтқанда, үшінші қабаттағы шебер бөлмесіне бару
Dialogue: 0,0:02:03.99,0:02:05.50,Default,,0,0,0,,Бұл екінші қабаттағы айна ма?
Dialogue: 0,0:02:05.58,0:02:06.71,Default,,0,0,0,,Асхана күзетшісіне
Dialogue: 0,0:02:06.79,0:02:09.00,Default,,0,0,0,,Куә болу деген осы.
Dialogue: 0,0:02:13.46,0:02:16.59,Default,,0,0,0,,Шамамен сол уақытта Кай баспалдақпен жүрді.
Dialogue: 0,0:02:16.67,0:02:19.09,Default,,0,0,0,,Мен Дианамен қонақ бөлмесінде қосыламын.
Dialogue: 0,0:02:19.18,0:02:23.35,Default,,0,0,0,,Бұл кезде Хайнц көрген фигура Кай болды.
Dialogue: 0,0:02:23.43,0:02:28.19,Default,,0,0,0,,Айтпақшы, бағбан сарайға қонақ бөлмесінен кірген жоқ.
Dialogue: 0,0:02:28.27,0:02:29.98,Default,,0,0,0,,Мен оны айнадан да растадым.
Dialogue: 0,0:02:30.06,0:02:31.06,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:02:31.15,0:02:32.73,Default,,0,0,0,,Элиза ас үйде болды.
Dialogue: 0,0:02:32.82,0:02:34.69,Default,,0,0,0,,Әкеңнің бөлмесіне бар.
Dialogue: 0,0:02:34.78,0:02:36.78,Default,,0,0,0,,Бірақ мен бөлменің алдына жеткенде, мен екінші қабаттың дәлізіне бұрылдым.
Dialogue: 0,0:02:36.78,0:02:37.82,Default,,0,0,0,,Бірақ мен бөлменің алдына жеткенде, мен екінші қабаттың дәлізіне бұрылдым.
Dialogue: 0,0:02:36.78,0:02:37.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:37.82,0:02:39.41,Default,,0,0,0,,Бірақ мен бөлменің алдына жеткенде, мен екінші қабаттың дәлізіне бұрылдым.
Dialogue: 0,0:02:39.49,0:02:42.03,Default,,0,0,0,,Маған су керек емес екенін еске түсіру
Dialogue: 0,0:02:42.12,0:02:43.03,Default,,0,0,0,,Мазмұнын вазаға беру
Dialogue: 0,0:02:43.03,0:02:44.54,Default,,0,0,0,,Мазмұнын вазаға беру
Dialogue: 0,0:02:43.03,0:02:44.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:45.16,0:02:46.41,Default,,0,0,0,,Сол кезде И
Dialogue: 0,0:02:46.50,0:02:48.50,Default,,0,0,0,,Әкем маған телефон соқты.
Dialogue: 0,0:02:48.58,0:02:50.71,Default,,0,0,0,,Мен үшінші қабатқа бара жатыр едім.
Dialogue: 0,0:02:50.79,0:02:52.79,Default,,0,0,0,,Мен өтіп бара жатқанда екінші қабатта
Dialogue: 0,0:02:50.79,0:02:52.79,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:02:52.88,0:02:56.26,Default,,0,0,0,,Элиза вазалар мен стакандардың сынған дыбысын естиді.
Dialogue: 0,0:02:56.34,0:02:59.01,Default,,0,0,0,,Тек әкеңнің бөлмесіне бар.
Dialogue: 0,0:03:00.34,0:03:01.18,Default,,0,0,0,,Сол жерде оны қылмыскер соққыға жыққан.
Dialogue: 0,0:03:01.18,0:03:02.64,Default,,0,0,0,,Сол жерде оны қылмыскер соққыға жыққан.
Dialogue: 0,0:03:01.18,0:03:02.64,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:03:02.72,0:03:04.01,Default,,0,0,0,,Юкайдан есінен танып қалды.
Dialogue: 0,0:03:04.10,0:03:06.22,Default,,0,0,0,,«Юкай» дегеніміз не?
Dialogue: 0,0:03:06.31,0:03:09.56,Default,,0,0,0,,Қалай болғанда да, Элиза дәлізді жинады.
Dialogue: 0,0:03:09.64,0:03:11.27,Default,,0,0,0,,Үшінші қабаттағы қоймаға барыңыз
Dialogue: 0,0:03:11.35,0:03:14.15,Default,,0,0,0,,Ол алмастыратын ваза іздеп жүргенін айтты.
Dialogue: 0,0:03:14.23,0:03:15.40,Default,,0,0,0,,Шамамен сол уақытта
Dialogue: 0,0:03:15.48,0:03:17.36,Default,,0,0,0,,Гордон мырза бөлмесінен шығып кетті.
Dialogue: 0,0:03:17.44,0:03:20.49,Default,,0,0,0,,Ас үйде Хайнц мырзамен бірге тамақ ішу туралы сөйлесіңіз.
Dialogue: 0,0:03:20.57,0:03:24.12,Default,,0,0,0,,Жолда асханада Бернд мырзаны кездестірдім.
Dialogue: 0,0:03:24.20,0:03:26.16,Default,,0,0,0,,Біраз уақыттан кейін
Dialogue: 0,0:03:26.24,0:03:30.08,Default,,0,0,0,,Алдын ала шақырылған күзетші шебердің бөлмесіне барды.
Dialogue: 0,0:03:30.16,0:03:33.13,Default,,0,0,0,,Элиза вазаны дұрыс емес жерден тауып алды.
Dialogue: 0,0:03:33.21,0:03:35.29,Default,,0,0,0,,Екінші қабаттың дәлізіне түсу
Dialogue: 0,0:03:35.38,0:03:40.30,Default,,0,0,0,,Ал Бернд мырза әкесінің бөлмесіне бару үшін қайталанатын кілтті пайдаланады.
Dialogue: 0,0:03:40.93,0:03:43.55,Default,,0,0,0,,Олар мені өлі жатқан жерінен тапты.
Dialogue: 0,0:03:43.64,0:03:45.55,Default,,0,0,0,,айқайлады
Dialogue: 0,0:03:45.64,0:03:48.02,Default,,0,0,0,,Қайталанатын кілт тағы кімде бар?
Dialogue: 0,0:03:48.10,0:03:51.44,Default,,0,0,0,,Қарт күтуші мен үлкен қызметші
Dialogue: 0,0:03:51.52,0:03:53.27,Default,,0,0,0,,Жағдай осылай ұйымдастырылған ба?
Dialogue: 0,0:03:53.35,0:03:54.19,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:03:58.03,0:03:59.65,Default,,0,0,0,,Иә? иә!
Dialogue: 0,0:03:59.74,0:04:02.07,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:04:02.74,0:04:04.07,Default,,0,0,0,,Егер сондай жағдай болса, біздің оңай үйлесе алатынымызға көз жеткізгім келеді.
Dialogue: 0,0:04:04.16,0:04:07.24,Default,,0,0,0,,Мына қызметші сізге дәрі суын беруге келді.
Dialogue: 0,0:04:07.33,0:04:09.54,Default,,0,0,0,,Шебер бөлмесіне бару
Dialogue: 0,0:04:09.62,0:04:11.00,Default,,0,0,0,,Жай ғана бөлмеге кіріңіз.
Dialogue: 0,0:04:11.00,0:04:11.91,Default,,0,0,0,,Жай ғана бөлмеге кіріңіз.
Dialogue: 0,0:04:11.00,0:04:11.91,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:04:12.00,0:04:14.71,Default,,0,0,0,,Артымнан келген Рин Рейнвейсті нокаутқа түсірдім.
Dialogue: 0,0:04:14.71,0:04:16.04,Default,,0,0,0,,Артымнан келген Рин Рейнвейсті нокаутқа түсірдім.
Dialogue: 0,0:04:14.71,0:04:16.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:16.13,0:04:16.92,Default,,0,0,0,,Эй, ха!
Dialogue: 0,0:04:16.92,0:04:17.84,Default,,0,0,0,,Эй, ха!
Dialogue: 0,0:04:16.92,0:04:17.84,Default,,0,0,0,,Содан кейін ол Ұстазды жер астына итеріп жіберіп, өлтірді.
Dialogue: 0,0:04:17.84,0:04:20.30,Default,,0,0,0,,Содан кейін ол Ұстазды жер астына итеріп жіберіп, өлтірді.
Dialogue: 0,0:04:20.88,0:04:21.76,Default,,0,0,0,,Көрші қоймада да қару бар.
Dialogue: 0,0:04:21.76,0:04:23.30,Default,,0,0,0,,Көрші қоймада да қару бар.
Dialogue: 0,0:04:21.76,0:04:23.30,Default,,0,0,0,,(Элизаның күлкісі)
Dialogue: 0,0:04:23.30,0:04:23.38,Default,,0,0,0,,(Элизаның күлкісі)
Dialogue: 0,0:04:23.38,0:04:26.51,Default,,0,0,0,,(Элизаның күлкісі)
Dialogue: 0,0:04:23.38,0:04:26.51,Default,,0,0,0,,Алаяқтың басын кесіп тастау оңай болар еді.
Dialogue: 0,0:04:26.60,0:04:27.97,Default,,0,0,0,,Алаяқ?
Dialogue: 0,0:04:28.68,0:04:32.35,Default,,0,0,0,,Басы жоқ өлік сенің әкең емес.
Dialogue: 0,0:04:32.43,0:04:34.06,Default,,0,0,0,,Шынайы дене жер астында
Dialogue: 0,0:04:34.14,0:04:34.98,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:35.06,0:04:36.98,Default,,0,0,0,,Жоқ... Мен жер астындамын...
Dialogue: 0,0:04:37.06,0:04:37.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:37.90,0:04:38.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:37.90,0:04:38.77,Default,,0,0,0,,Қылмыс жасаған соң бөлмені құлыптап, қоймаға қашып кеткен.
Dialogue: 0,0:04:38.77,0:04:42.90,Default,,0,0,0,,Қылмыс жасаған соң бөлмені құлыптап, қоймаға қашып кеткен.
Dialogue: 0,0:04:42.99,0:04:45.74,Default,,0,0,0,,Кішкентай қызметшілер ғана пайдалана алатын көлік құралдары...
Dialogue: 0,0:04:45.82,0:04:48.62,Default,,0,0,0,,Желдеткіш арқылы
Dialogue: 0,0:04:49.49,0:04:53.62,Default,,0,0,0,,Бұл өте тар, бірақ кішкентай қызметші өтіп кете алады.
Dialogue: 0,0:04:54.29,0:04:55.12,Default,,0,0,0,,атап өтілді!
Dialogue: 0,0:04:55.71,0:04:58.42,Default,,0,0,0,,Элиза желдеткіштерді пайдаланбайды!
Dialogue: 0,0:04:58.50,0:05:00.21,Default,,0,0,0,,Желдеткіштен өткенде
Dialogue: 0,0:05:00.30,0:05:02.09,Default,,0,0,0,,Бұл шаң жұмақ болатын
Dialogue: 0,0:05:02.88,0:05:07.05,Default,,0,0,0,,Егер Элиза бірінші болып өтсе, шаң жойылар еді.
Dialogue: 0,0:05:07.64,0:05:08.76,Default,,0,0,0,,Иә
Dialogue: 0,0:05:10.14,0:05:10.97,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:05:11.06,0:05:12.93,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:05:13.02,0:05:14.77,Default,,0,0,0,,Бұл қызметші кінәлі емес.
Dialogue: 0,0:05:14.85,0:05:15.69,Default,,0,0,0,,Элиза!
Dialogue: 0,0:05:15.77,0:05:18.02,Default,,0,0,0,,Рин ханым~!
Dialogue: 0,0:05:18.11,0:05:19.98,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:05:20.07,0:05:21.44,Default,,0,0,0,,Уф, жақсы...
Dialogue: 0,0:05:21.53,0:05:24.61,Default,,0,0,0,,Келесі кезек сізде, Линн Рейнвейс.
Dialogue: 0,0:05:25.45,0:05:26.99,Default,,0,0,0,,Бұл кездесу
Dialogue: 0,0:05:29.32,0:05:31.79,Default,,0,0,0,,Мен кінәлімін...
Dialogue: 0,0:05:37.25,0:05:39.46,Default,,0,0,0,,Ха...мырза. Хайнц
Dialogue: 0,0:05:39.54,0:05:43.21,Default,,0,0,0,,Мен қылмыс жасамас бұрын ас үйден шығып, әкемнің бөлмесіне бардым...
Dialogue: 0,0:05:43.30,0:05:47.13,Default,,0,0,0,,Асхана немесе артқы аула арқылы ас үйге кіру
Dialogue: 0,0:05:47.22,0:05:48.84,Default,,0,0,0,,Буфетте күзетші бар.
Dialogue: 0,0:05:48.93,0:05:50.22,Default,,0,0,0,,Ол жерде көптен болған сияқтысыз ба?
Dialogue: 0,0:05:50.30,0:05:52.68,Default,,0,0,0,,Сонымен... Енді аулаға барайық.
Dialogue: 0,0:05:52.77,0:05:55.02,Default,,0,0,0,,Аулада күзетші ит бар
Dialogue: 0,0:05:55.10,0:05:56.56,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:05:56.64,0:05:58.02,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:58.56,0:06:01.65,Default,,0,0,0,,Сонда Гейнц мырза кінәлі емес.
Dialogue: 0,0:06:01.73,0:06:03.28,Default,,0,0,0,,А...?
Dialogue: 0,0:06:03.36,0:06:04.57,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:06:04.65,0:06:07.32,Default,,0,0,0,,Қашып кетсең де, Мені пайдаланбақ ниетің болса.
Dialogue: 0,0:06:07.40,0:06:09.82,Default,,0,0,0,,Жақсырақ шегерім жасаңыз
Dialogue: 0,0:06:09.91,0:06:10.78,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:12.28,0:06:14.37,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:14.45,0:06:15.75,Default,,0,0,0,,Рин-чанға рахмет
Dialogue: 0,0:06:20.75,0:06:21.59,Default,,0,0,0,,Колт! Оу!
Dialogue: 0,0:06:21.67,0:06:23.59,Default,,0,0,0,,Өйткені олар бірге әрекет етті
Dialogue: 0,0:06:23.67,0:06:25.59,Default,,0,0,0,,Сыбайлас ретінде қорытынды жасау
Dialogue: 0,0:06:25.67,0:06:26.51,Default,,0,0,0,,Бұл екі адам
Dialogue: 0,0:06:26.59,0:06:29.30,Default,,0,0,0,,Магистрдің бөлмесіне қалай кіруге болатынын білсем.
Dialogue: 0,0:06:29.38,0:06:30.80,Default,,0,0,0,,Қылмыс оңай
Dialogue: 0,0:06:31.39,0:06:34.60,Default,,0,0,0,,Бағбан сарайға қонақ бөлмесінен кірмеді делік.
Dialogue: 0,0:06:34.68,0:06:37.52,Default,,0,0,0,,Кіру үшін баспалдақ пайдаланылды.
Dialogue: 0,0:06:37.60,0:06:40.85,Default,,0,0,0,,Баспалдақ екінші қабатқа жетуге жеткілікті.
Dialogue: 0,0:06:40.94,0:06:45.53,Default,,0,0,0,,Егер сіз қонақ бөлмесінің террасасына көтерілсеңіз, үшінші қабатқа көтеріле аласыз.
Dialogue: 0,0:06:45.61,0:06:48.24,Default,,0,0,0,,Алайда ол салмақты бір адам көтере алмайды...
Dialogue: 0,0:06:48.32,0:06:49.86,Default,,0,0,0,,Көтеруге болмайды
Dialogue: 0,0:06:49.95,0:06:52.53,Default,,0,0,0,,Бірақ қонақ бөлмесінде қызметші қыз күтіп тұрды.
Dialogue: 0,0:06:52.62,0:06:53.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:54.08,0:06:55.99,Default,,0,0,0,,Баспалдақпен екі адам көтеріледі
Dialogue: 0,0:06:56.08,0:06:59.37,Default,,0,0,0,,Бағбан үшінші қабатқа баспалдақпен көтеріледі.
Dialogue: 0,0:06:59.46,0:07:04.13,Default,,0,0,0,,Содан кейін шатырға шығып, шебер бөлмесінің жоғарғы жағына өтіңіз.
Dialogue: 0,0:07:04.21,0:07:08.38,Default,,0,0,0,,Кейінірек қызметші қожайынға келіп, оның назарын аударады.
Dialogue: 0,0:07:08.47,0:07:11.51,Default,,0,0,0,,Осы кезде террассадан бағбан кіріп келді.
Dialogue: 0,0:07:11.59,0:07:12.22,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:12.22,0:07:13.26,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:12.22,0:07:13.26,Default,,0,0,0,,Қылмысты екі адам жасады
Dialogue: 0,0:07:13.26,0:07:14.30,Default,,0,0,0,,Қылмысты екі адам жасады
Dialogue: 0,0:07:15.22,0:07:18.64,Default,,0,0,0,,Мәйіттің басы мен өлтіретін қаруды бағбан алып кеткен.
Dialogue: 0,0:07:19.35,0:07:20.56,Default,,0,0,0,,Қызметші есікті қайталама кілтпен құлыптады.
Dialogue: 0,0:07:20.56,0:07:21.77,Default,,0,0,0,,Қызметші есікті қайталама кілтпен құлыптады.
Dialogue: 0,0:07:20.56,0:07:21.77,Default,,0,0,0,,(Кілтті құлыптау дыбысы)
Dialogue: 0,0:07:22.31,0:07:24.61,Default,,0,0,0,,Демек, бұл екеуі кінәлі.
Dialogue: 0,0:07:24.69,0:07:25.82,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:25.90,0:07:27.32,Default,,0,0,0,,Жоқ! Біз...
Dialogue: 0,0:07:27.94,0:07:28.94,Default,,0,0,0,,Оны көрсетіңіз!
Dialogue: 0,0:07:29.03,0:07:32.16,Default,,0,0,0,,Екі адам баспалдақты көтере алмайды!
Dialogue: 0,0:07:32.24,0:07:33.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:33.45,0:07:36.24,Default,,0,0,0,,Диана биіктіктен қатты қорқады.
Dialogue: 0,0:07:36.33,0:07:38.54,Default,,0,0,0,,Террасаға шығуға болмайды.
Dialogue: 0,0:07:38.62,0:07:42.33,Default,,0,0,0,,Қонақ бөлмесінен шықпаған екі адамға қарсы қылмыс жасау мүмкін емес!
Dialogue: 0,0:07:42.92,0:07:44.79,Default,,0,0,0,,Бір Жокер бар; карталар мінсіз рет-ретімен тұрған сияқты.
Dialogue: 0,0:07:48.13,0:07:49.51,Default,,0,0,0,,Рин ханым
Dialogue: 0,0:07:49.59,0:07:53.26,Default,,0,0,0,,Екеуіңіз туралы кейінірек айтып беріңізші.
Dialogue: 0,0:07:54.22,0:07:55.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:56.81,0:07:59.31,Default,,0,0,0,,Енді екі адам қалды.
Dialogue: 0,0:08:00.06,0:08:01.77,Default,,0,0,0,,Қайсысын таңдау керек?
Dialogue: 0,0:08:04.56,0:08:06.15,Default,,0,0,0,,Шамасы, сіз
Dialogue: 0,0:08:06.23,0:08:09.48,Default,,0,0,0,,Сіз кінәлі деп ойламайтын адамды таңдап жатқан сияқтысыз.
Dialogue: 0,0:08:09.57,0:08:11.95,Default,,0,0,0,,Егер... мен жас ханым ретінде таңдалмасам ше?
Dialogue: 0,0:08:12.03,0:08:13.74,Default,,0,0,0,,Сіз кінәлі дегенді айтасыз ба?
Dialogue: 0,0:08:14.53,0:08:16.87,Default,,0,0,0,,Әрине, олар сені таңдайды, солай ма?
Dialogue: 0,0:08:16.95,0:08:18.54,Default,,0,0,0,,Эй... Мен кінәлі емеспін.
Dialogue: 0,0:08:18.62,0:08:20.29,Default,,0,0,0,,Тоқта, сен дөрекісің!
Dialogue: 0,0:08:20.37,0:08:21.91,Default,,0,0,0,,Құрметтемеу деген болмайды!
Dialogue: 0,0:08:22.00,0:08:23.08,Default,,0,0,0,,Ой…
Dialogue: 0,0:08:23.75,0:08:24.88,Default,,0,0,0,,Гордон мырза!
Dialogue: 0,0:08:25.92,0:08:26.79,Default,,0,0,0,,А...
Dialogue: 0,0:08:26.88,0:08:30.34,Default,,0,0,0,,Берунд Бұл Берунд
Dialogue: 0,0:08:30.42,0:08:34.51,Default,,0,0,0,,Берунд Берунд...
Dialogue: 0,0:08:34.59,0:08:37.72,Default,,0,0,0,,Менің таңдауым... Гордон мырза.
Dialogue: 0,0:08:37.80,0:08:39.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:39.26,0:08:40.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:40.77,0:08:42.60,Default,,0,0,0,,Бірінші қабаттағы қарияның бөлмесінен
Dialogue: 0,0:08:42.68,0:08:45.56,Default,,0,0,0,,Мастер бөлмесіне қалай жетуге болады?
Dialogue: 0,0:08:45.65,0:08:46.98,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:08:47.06,0:08:50.78,Default,,0,0,0,,Бұл қарт адамның қылмыс жасауы мүмкін емес дегенді білдіреді.
Dialogue: 0,0:08:51.40,0:08:52.24,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:08:54.49,0:08:57.78,Default,,0,0,0,,Жоқ... Не? Мен күзетшімін!
Dialogue: 0,0:08:57.87,0:08:59.03,Default,,0,0,0,,Неліктен біреу біреуді өлтіреді?
Dialogue: 0,0:08:59.12,0:09:00.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:00.12,0:09:02.79,Default,,0,0,0,,Жоқ! Мен кінәлі емеспін
Dialogue: 0,0:09:02.87,0:09:03.96,Default,,0,0,0,,Бернд-чан...
Dialogue: 0,0:09:04.04,0:09:06.17,Default,,0,0,0,,Неге... ақыр соңында
Dialogue: 0,0:09:06.25,0:09:07.25,Default,,0,0,0,,Бұл сіз бе?
Dialogue: 0,0:09:07.33,0:09:09.96,Default,,0,0,0,,Бұл күлкілі оқиға!
Dialogue: 0,0:09:10.55,0:09:14.76,Default,,0,0,0,,А... Расымен де Бернд мырза кінәлі ме?
Dialogue: 0,0:09:14.84,0:09:16.26,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:09:16.34,0:09:17.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:17.80,0:09:18.93,Default,,0,0,0,,Сәлем күзетші
Dialogue: 0,0:09:19.01,0:09:21.01,Default,,0,0,0,,Не? Мен кінәлімін...
Dialogue: 0,0:09:23.06,0:09:24.27,Default,,0,0,0,,Эй!
Dialogue: 0,0:09:26.52,0:09:29.27,Default,,0,0,0,,Хмм... Бұл менің естігенімнен де көп.
Dialogue: 0,0:09:29.36,0:09:32.40,Default,,0,0,0,,А, Бернд мырза қанды көргенде есінен танып қалады...
Dialogue: 0,0:09:33.03,0:09:35.70,Default,,0,0,0,,Бірлескендер мәйіттің басын кесіп тастады.
Dialogue: 0,0:09:35.78,0:09:38.53,Default,,0,0,0,,Мен сені ваннада ренжіттім.
Dialogue: 0,0:09:38.62,0:09:40.16,Default,,0,0,0,,Бұл жігіт үшін мүмкін емес.
Dialogue: 0,0:09:41.58,0:09:44.41,Default,,0,0,0,,Бұл іс ерекше жағдайларда
Dialogue: 0,0:09:44.50,0:09:48.00,Default,,0,0,0,,Себебі мен әдетте білмейтін ақпаратты білемін.
Dialogue: 0,0:09:48.08,0:09:50.63,Default,,0,0,0,,Мен осыған назар аудардым.
Dialogue: 0,0:09:50.71,0:09:52.55,Default,,0,0,0,,Айна…
Dialogue: 0,0:09:52.63,0:09:56.17,Default,,0,0,0,,Ха... Бұл Джише қарап тұрған әркімнің ақпараты.
Dialogue: 0,0:09:56.26,0:09:57.34,Default,,0,0,0,,Сіз әлі байқамадыңыз ба?
Dialogue: 0,0:09:57.43,0:09:58.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:01.10,0:10:02.76,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:02.85,0:10:05.98,Default,,0,0,0,,Әрине, сіз бұл туралы білетінсіз, солай емес пе? Джиче
Dialogue: 0,0:10:06.06,0:10:08.19,Default,,0,0,0,,Е, сен нені айтып тұрсың?
Dialogue: 0,0:10:08.27,0:10:11.73,Default,,0,0,0,,Мен көмектесіп жатырмын деп ойладым.
Dialogue: 0,0:10:11.82,0:10:13.48,Default,,0,0,0,,Хмм, сіз қалай ойлайсыз?
Dialogue: 0,0:10:13.98,0:10:16.40,Default,,0,0,0,,Желдеткіш арқылы қашпау
Dialogue: 0,0:10:16.49,0:10:18.03,Default,,0,0,0,,Биіктікте жұмыс істей алмайды
Dialogue: 0,0:10:18.66,0:10:20.49,Default,,0,0,0,,Басқа адамның куәгерінің айғақтары бар.
Dialogue: 0,0:10:20.57,0:10:23.12,Default,,0,0,0,,Қанның көрінуі есінен танып қалады.
Dialogue: 0,0:10:23.20,0:10:24.45,Default,,0,0,0,,Тек бір адам
Dialogue: 0,0:10:24.54,0:10:27.91,Default,,0,0,0,,Айна бақылау алибиді алып тастасақ
Dialogue: 0,0:10:28.00,0:10:30.17,Default,,0,0,0,,Еркін қозғалатын адамдар бар.
Dialogue: 0,0:10:30.71,0:10:32.54,Default,,0,0,0,,Бірақ алып тастау...
Dialogue: 0,0:10:32.63,0:10:34.88,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:10:34.96,0:10:36.76,Default,,0,0,0,,Адамдар үшін емес
Dialogue: 0,0:10:38.18,0:10:39.18,Default,,0,0,0,,Мен мұндай боларын ойламаппын.
Dialogue: 0,0:10:40.05,0:10:41.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:42.01,0:10:43.60,Default,,0,0,0,,Зише көрдіңіз бе?
Dialogue: 0,0:10:43.68,0:10:45.85,Default,,0,0,0,,Өйткені бұл сарайда күтуші ретінде...
Dialogue: 0,0:10:45.93,0:10:46.98,Default,,0,0,0,,Батлер?
Dialogue: 0,0:10:47.06,0:10:48.19,Default,,0,0,0,,А...
Dialogue: 0,0:10:48.27,0:10:51.61,Default,,0,0,0,,Үлкен қызметші және кіші қызметші
Dialogue: 0,0:10:51.69,0:10:54.19,Default,,0,0,0,,Бағбан күзетшісі аспаз
Dialogue: 0,0:10:54.27,0:10:57.28,Default,,0,0,0,,Бұл сарайда жұмыс істейтін бес адам, солай ма?
Dialogue: 0,0:10:57.90,0:10:59.53,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:59.61,0:11:03.53,Default,,0,0,0,,Эй Рин-Чан, мен сені көптен бері қызықтырып жүрмін.
Dialogue: 0,0:11:04.37,0:11:06.75,Default,,0,0,0,,Гордон деген кім?
Dialogue: 0,0:11:09.79,0:11:12.42,Default,,0,0,0,,Мен өз шындығымды ашамын ба?
Dialogue: 0,0:11:14.63,0:11:17.26,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:11:17.34,0:11:18.34,Default,,0,0,0,,Иә
Dialogue: 0,0:11:20.34,0:11:22.09,Default,,0,0,0,,Арне-самамен пікірлесуде
Dialogue: 0,0:11:22.18,0:11:26.06,Default,,0,0,0,,Біз бұл сарайдағы адамдар үшін қылмыс мүмкін емес екенін дәлелдедік.
Dialogue: 0,0:11:26.14,0:11:28.77,Default,,0,0,0,,Бірақ айнаны пайдаланып алиби...
Dialogue: 0,0:11:28.85,0:11:33.11,Default,,0,0,0,,Бұл кінәлі адам деген алғышартқа негізделген.
Dialogue: 0,0:11:33.77,0:11:36.69,Default,,0,0,0,,Сіз вампирсіз, солай емес пе?
Dialogue: 0,0:11:37.28,0:11:38.65,Default,,0,0,0,,Гордон мырза
Dialogue: 0,0:11:42.82,0:11:45.37,Default,,0,0,0,,Әй, ата, кітабыңызды оқыңыз.
Dialogue: 0,0:11:46.03,0:11:48.70,Default,,0,0,0,,Бұл үшінші кітап.
Dialogue: 0,0:11:48.79,0:11:50.33,Default,,0,0,0,,Та-да!
Dialogue: 0,0:11:50.41,0:11:52.67,Default,,0,0,0,,Ұйқыңыз келгенше оқыңыз
Dialogue: 0,0:11:53.50,0:11:55.59,Default,,0,0,0,,Өте қатты ашуландырады—
Dialogue: 0,0:11:55.67,0:11:58.76,Default,,0,0,0,,Иә! Әже мен сізді жақсы көремін!
Dialogue: 0,0:12:01.09,0:12:03.47,Default,,0,0,0,,Вампир? мен?
Dialogue: 0,0:12:07.97,0:12:10.39,Default,,0,0,0,,Модерацияда ойнаңыз
Dialogue: 0,0:12:10.48,0:12:13.48,Default,,0,0,0,,Енді айнаның алдында тұр.
Dialogue: 0,0:12:13.56,0:12:16.40,Default,,0,0,0,,Егер сіз вампир болмасаңыз, айнадағы көріністі көре алуыңыз керек.
Dialogue: 0,0:12:16.48,0:12:17.77,Default,,0,0,0,,Рин-чан
Dialogue: 0,0:12:17.86,0:12:20.40,Default,,0,0,0,,Гордон мырза екеумізді қылмыскер ұрып-соқты...
Dialogue: 0,0:12:20.49,0:12:22.82,Default,,0,0,0,,Мен сені ұрдым.
Dialogue: 0,0:12:22.90,0:12:24.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:24.11,0:12:26.24,Default,,0,0,0,,Бірақ қарт мені ұрған жоқ.
Dialogue: 0,0:12:26.32,0:12:29.49,Default,,0,0,0,,Бұл оның құрбанды өзі ойнаған фарс болса керек.
Dialogue: 0,0:12:30.20,0:12:32.46,Default,,0,0,0,,Мені бір нәрсе мазалады.
Dialogue: 0,0:12:32.54,0:12:35.25,Default,,0,0,0,,Сол сынған ваза...
Dialogue: 0,0:12:35.33,0:12:38.50,Default,,0,0,0,,Бұл Элизаның жұмысы болды ма?
Dialogue: 0,0:12:39.25,0:12:42.59,Default,,0,0,0,,Гордон мырза, үшінші қабатқа шықпау керек еді.
Dialogue: 0,0:12:42.67,0:12:44.72,Default,,0,0,0,,Сынған вазаны қашан көрдің?
Dialogue: 0,0:12:47.22,0:12:48.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:57.48,0:12:59.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:01.19,0:13:03.03,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:13:03.11,0:13:06.74,Default,,0,0,0,,Мен мұның фарспен аяқталуын қаладым.
Dialogue: 0,0:13:06.82,0:13:10.45,Default,,0,0,0,,Айнамен бақылаудың басынан мағынасы болмады.
Dialogue: 0,0:13:11.20,0:13:14.54,Default,,0,0,0,,Әкеңнің бөлмесінде үнемі болдың ғой, солай емес пе?
Dialogue: 0,0:13:15.54,0:13:19.79,Default,,0,0,0,,Мені нокаутқа түсіргеннен кейін әкеңді өлтірдім.
Dialogue: 0,0:13:19.88,0:13:21.92,Default,,0,0,0,,Мен өз бөлмеме оралдым.
Dialogue: 0,0:13:22.01,0:13:24.30,Default,,0,0,0,,Айнаның алдынан өту
Dialogue: 0,0:13:24.38,0:13:26.68,Default,,0,0,0,,Неліктен әкең...
Dialogue: 0,0:13:26.76,0:13:30.68,Default,,0,0,0,,Мен бәріңді әлі де жақсы көремін.
Dialogue: 0,0:13:31.35,0:13:32.97,Default,,0,0,0,,Осы үйге қызмет ет
Dialogue: 0,0:13:33.06,0:13:37.15,Default,,0,0,0,,Адамдар арасында өмір сүру жаман емес деп ойладым.
Dialogue: 0,0:13:38.10,0:13:40.90,Default,,0,0,0,,Бірақ шамамен бір ай бұрын?
Dialogue: 0,0:13:40.98,0:13:45.36,Default,,0,0,0,,Менің күйеуім қара аукцион арқылы алынды.
Dialogue: 0,0:13:46.15,0:13:47.82,Default,,0,0,0,,Начзеллер мырза...
Dialogue: 0,0:13:47.91,0:13:49.07,Default,,0,0,0,,Мен шынымен қызмет етуім керек патшаның жүрегі.
Dialogue: 0,0:13:49.07,0:13:52.41,Default,,0,0,0,,Мен шынымен қызмет етуім керек патшаның жүрегі.
Dialogue: 0,0:13:49.07,0:13:52.41,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:13:53.12,0:13:57.67,Default,,0,0,0,,Күйеуіммен бірге адамның қажетті денелерін жинап бітірдік.
Dialogue: 0,0:13:57.75,0:14:00.50,Default,,0,0,0,,Қайта тірілу рәсімін орындау ғана қалды.
Dialogue: 0,0:14:00.59,0:14:02.05,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:14:02.13,0:14:06.13,Default,,0,0,0,,Мен әйелімнен гөрі лорд Начзехлерді тірілткім келді.
Dialogue: 0,0:14:06.22,0:14:07.47,Default,,0,0,0,,Тағдырымыз өріліп-үйлессін
Dialogue: 0,0:14:07.55,0:14:08.39,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:08.47,0:14:10.43,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:14:10.51,0:14:15.89,Default,,0,0,0,,Күйеуінің әйелімен қайта қосылу тілегі орындалды.
Dialogue: 0,0:14:15.98,0:14:20.27,Default,,0,0,0,,Начзелер денесінің бөлігі ретінде
Dialogue: 0,0:14:20.36,0:14:21.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:21.90,0:14:25.11,Default,,0,0,0,,Сонымен, сіз шебердің бөлмесіне жалған мәйітті орналастырдыңыз ба?
Dialogue: 0,0:14:25.19,0:14:29.91,Default,,0,0,0,,Қайта тірілген патша және оның құрамына енген күйеуі мен әйелі
Dialogue: 0,0:14:29.99,0:14:33.62,Default,,0,0,0,,Ал Леди Лин лайықты отағасы болды.
Dialogue: 0,0:14:33.70,0:14:36.58,Default,,0,0,0,,Өйткені мен бұл сарайда мәңгі өмір сүргім келеді.
Dialogue: 0,0:14:36.66,0:14:37.96,Default,,0,0,0,,Отағасы?
Dialogue: 0,0:14:38.04,0:14:40.63,Default,,0,0,0,,Оны қуыршаққа айналдырып, күлдіруге тырысыңыз
Dialogue: 0,0:14:40.71,0:14:41.54,Default,,0,0,0,,А...
Dialogue: 0,0:14:41.63,0:14:44.38,Default,,0,0,0,,Мен оның қолында тістеген іздерін көрдім.
Dialogue: 0,0:14:44.46,0:14:45.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:49.18,0:14:51.26,Default,,0,0,0,,Асыл мәртебең болса
Dialogue: 0,0:14:51.34,0:14:54.64,Default,,0,0,0,,Начзехлердің қайта өркендеуінен кейін қалпына келтіру оңай
Dialogue: 0,0:14:54.72,0:14:57.48,Default,,0,0,0,,Ұстазды өлтіруге осы себеп болса керек.
Dialogue: 0,0:14:57.56,0:15:00.02,Default,,0,0,0,,Рин Рейнвейсті бақылау
Dialogue: 0,0:15:00.10,0:15:02.19,Default,,0,0,0,,Сіз зәулім үйді басып алуды жоспарлағансыз, солай емес пе?
Dialogue: 0,0:15:05.23,0:15:09.40,Default,,0,0,0,,Сіз күткендей, Арне Нойнтатор.
Dialogue: 0,0:15:09.49,0:15:12.03,Default,,0,0,0,,Сіз мені танисыз ба?
Dialogue: 0,0:15:12.12,0:15:16.24,Default,,0,0,0,,Мен жас ханымның қаны бірінші сорылады деп ойламаппын.
Dialogue: 0,0:15:16.33,0:15:19.58,Default,,0,0,0,,Менің айтқанымды тыңдамасаң,
Dialogue: 0,0:15:19.66,0:15:21.46,Default,,0,0,0,,Ол тіпті өлмеуі керек.
Dialogue: 0,0:15:22.21,0:15:25.67,Default,,0,0,0,,Жас ханым адам емес еді ғой, солай ма?
Dialogue: 0,0:15:27.42,0:15:31.59,Default,,0,0,0,,Мен әлі де...
Dialogue: 0,0:15:32.97,0:15:35.97,Default,,0,0,0,,Мұның бәрі жоспардан тыс.
Dialogue: 0,0:15:36.06,0:15:38.81,Default,,0,0,0,,Жас ханым да: «Мен полиция шақырамын», - деді.
Dialogue: 0,0:15:38.89,0:15:42.56,Default,,0,0,0,,Сол себепті Рин Рейнвейсті өлтірмек болдыңыз ба?
Dialogue: 0,0:15:43.23,0:15:47.48,Default,,0,0,0,,Менің күйеуім де Бернд деп атады.
Dialogue: 0,0:15:47.57,0:15:52.74,Default,,0,0,0,,Егер бұл дүрбелең болмаса, Қожа әлдеқашан тіріліп кетер еді.
Dialogue: 0,0:15:52.82,0:15:55.45,Default,,0,0,0,,Хехехе хахаха...
Dialogue: 0,0:15:55.53,0:15:59.62,Default,,0,0,0,,Бұл енді маңызды емес
Dialogue: 0,0:15:59.70,0:16:00.54,Default,,0,0,0,,Иә
Dialogue: 0,0:16:01.37,0:16:04.04,Default,,0,0,0,,Сол қолдармен қарудың қажеті жоқ.
Dialogue: 0,0:16:05.88,0:16:08.42,Default,,0,0,0,,Хухаха... Вахахаха...!
Dialogue: 0,0:16:08.51,0:16:10.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:20.56,0:16:21.64,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:16:21.64,0:16:24.77,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:16:21.64,0:16:24.77,Default,,0,0,0,,Менде бар нәрсені пайдалану...
Dialogue: 0,0:16:26.27,0:16:29.15,Default,,0,0,0,,Фухахаха...
Dialogue: 0,0:16:29.23,0:16:32.78,Default,,0,0,0,,Міне, Начзелер мырза...
Dialogue: 0,0:16:32.86,0:16:34.66,Default,,0,0,0,,Аман болсын!
Dialogue: 0,0:16:38.91,0:16:43.12,Default,,0,0,0,,Гя гя гя гя...!
Dialogue: 0,0:16:44.54,0:16:47.92,Default,,0,0,0,,Қайтып келді!
Dialogue: 0,0:16:48.00,0:16:50.38,Default,,0,0,0,,(Начзелердің күлкісі)
Dialogue: 0,0:16:52.63,0:16:53.97,Default,,0,0,0,,(Сүйектердің дірілдеген дыбысы)
Dialogue: 0,0:16:52.63,0:16:53.97,Default,,0,0,0,,Менің денем ұзақ уақыттан кейін
Dialogue: 0,0:16:53.97,0:16:55.39,Default,,0,0,0,,Менің денем ұзақ уақыттан кейін
Dialogue: 0,0:16:55.47,0:16:59.14,Default,,0,0,0,,Қарт кезіңізде қандай сезімде болғаныңызды білесіз бе?
Dialogue: 0,0:16:59.89,0:17:03.77,Default,,0,0,0,,Эй... Ноинтетер мырза.
Dialogue: 0,0:17:03.85,0:17:06.48,Default,,0,0,0,,Сіз тіпті дыбыс шығара алмайсыз ба?
Dialogue: 0,0:17:06.56,0:17:10.11,Default,,0,0,0,,Сөйлегені сияқты, ол ақымақ көрінеді.
Dialogue: 0,0:17:10.19,0:17:11.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:11.40,0:17:15.57,Default,,0,0,0,,Менің жүрегімді ұрлаған сенсің!
Dialogue: 0,0:17:17.70,0:17:18.53,Default,,0,0,0,,Хамф!
Dialogue: 0,0:17:19.24,0:17:21.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:21.29,0:17:24.83,Default,,0,0,0,,Сіз вампирлер арасындағы мәселені қалай шешуді жоспарлайсыз?
Dialogue: 0,0:17:25.62,0:17:26.79,Default,,0,0,0,,Иә
Dialogue: 0,0:17:32.84,0:17:34.72,Default,,0,0,0,,Қарасам, бұл қанды шайқас.
Dialogue: 0,0:17:34.80,0:17:36.55,Default,,0,0,0,,Гя гя гия гя...!
Dialogue: 0,0:17:36.63,0:17:39.14,Default,,0,0,0,,Қанды шайқаста жоғалған қан қарсыласқа тиесілі.
Dialogue: 0,0:17:39.22,0:17:41.93,Default,,0,0,0,,Барлық қаныңызды сіңіріңіз
Dialogue: 0,0:17:42.02,0:17:44.85,Default,,0,0,0,,Мен Ноинтатар боламын!
Dialogue: 0,0:17:48.61,0:17:49.44,Default,,0,0,0,,Қызықты
Dialogue: 0,0:17:49.52,0:17:53.74,Default,,0,0,0,,Жүр, тамақ ішіп, бір-бірімізді өлтірейік!
Dialogue: 0,0:18:03.04,0:18:04.66,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:08.75,0:18:11.63,Default,,0,0,0,,Менің айналама қарауға уақытым жоқ!
Dialogue: 0,0:18:12.25,0:18:14.34,Default,,0,0,0,,Қатты нәрсе...
Dialogue: 0,0:18:14.42,0:18:16.42,Default,,0,0,0,,Сіз бүкіл қаныңызды жұмсауды жоспарлап отырсыз ба?
Dialogue: 0,0:18:16.51,0:18:19.64,Default,,0,0,0,,Қаныңды түгел алсаң, ол Чара!
Dialogue: 0,0:18:19.72,0:18:21.14,Default,,0,0,0,,Бар!
Dialogue: 0,0:18:21.22,0:18:23.81,Default,,0,0,0,,Шарасыз жігіт
Dialogue: 0,0:18:23.89,0:18:25.10,Default,,0,0,0,,Бұл өте керемет!
Dialogue: 0,0:18:30.73,0:18:31.82,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:37.07,0:18:38.45,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:18:58.80,0:18:59.88,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:19:02.60,0:19:03.56,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:06.81,0:19:07.93,Default,,0,0,0,,...
Dialogue: 0,0:19:11.02,0:19:13.69,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:24.87,0:19:27.20,Default,,0,0,0,,Ку... Боқ...
Dialogue: 0,0:19:27.29,0:19:29.21,Default,,0,0,0,,Бұл менің жеңісім.
Dialogue: 0,0:19:31.00,0:19:33.88,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:34.50,0:19:36.34,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:19:36.42,0:19:39.67,Default,,0,0,0,,Менің де, сенің де жүрегіміз бір.
Dialogue: 0,0:19:39.76,0:19:41.97,Default,,0,0,0,,Мен жоғалтуым керек еді...
Dialogue: 0,0:19:42.05,0:19:45.22,Default,,0,0,0,,Сіздің ұрыс стиліңіз тым ысырапшыл.
Dialogue: 0,0:19:45.31,0:19:46.60,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:47.81,0:19:50.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:50.69,0:19:52.60,Default,,0,0,0,,Гя гя гя гя...!
Dialogue: 0,0:19:55.73,0:19:57.36,Default,,0,0,0,,Сіз әлі де күресіп жатырсыз ба?
Dialogue: 0,0:19:57.44,0:20:01.32,Default,,0,0,0,,(Алыптың ырылдауы)
Dialogue: 0,0:20:04.37,0:20:09.00,Default,,0,0,0,,Мен жеңілдім демеңіз!
Dialogue: 0,0:20:10.54,0:20:15.34,Default,,0,0,0,,(Начзелердің күлкісі)
Dialogue: 0,0:20:19.96,0:20:21.59,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:19.96,0:20:21.59,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:20:24.43,0:20:27.01,Default,,0,0,0,,Жүрегіңізді қайтарыңыз
Dialogue: 0,0:20:31.64,0:20:32.48,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:32.56,0:20:35.90,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:20:37.77,0:20:41.57,Default,,0,0,0,,Цк... сен бейбақ.
Dialogue: 0,0:20:57.13,0:20:58.67,Default,,0,0,0,,Қауіпке барма.
Dialogue: 0,0:20:58.75,0:21:00.67,Default,,0,0,0,,Құрметті Арне...
Dialogue: 0,0:21:00.76,0:21:03.01,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:21:04.13,0:21:06.89,Default,,0,0,0,,Мм... Гордон мырза...
Dialogue: 0,0:21:08.35,0:21:09.43,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:09.51,0:21:10.39,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:19.07,0:21:21.44,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:21:21.53,0:21:23.36,Default,,0,0,0,,Басқа қызметшілерге не болды?
Dialogue: 0,0:21:23.44,0:21:25.82,Default,,0,0,0,,Алдымен мені эвакуациялады.
Dialogue: 0,0:21:25.91,0:21:28.37,Default,,0,0,0,,Мен Арне-саманы күтемін.
Dialogue: 0,0:21:28.45,0:21:29.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:31.74,0:21:33.45,Default,,0,0,0,,Еңбекті көп қажет ететін
Dialogue: 0,0:21:34.96,0:21:36.62,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:21:37.83,0:21:41.21,Default,,0,0,0,,Ай жарқырап, әдемі.
Dialogue: 0,0:21:41.30,0:21:42.84,Default,,0,0,0,,Шаң
Dialogue: 0,0:21:42.92,0:21:45.30,Default,,0,0,0,,Аха…
Dialogue: 0,0:21:45.80,0:21:47.14,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:21:47.22,0:21:49.60,Default,,0,0,0,,Дүние біткен сияқты.
Dialogue: 0,0:21:49.68,0:21:50.97,Default,,0,0,0,,Сен ақымақсың ба? Ах...
Dialogue: 0,0:21:51.56,0:21:52.81,Default,,0,0,0,,Линн Рейнвейс
Dialogue: 0,0:21:52.89,0:21:53.98,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:21:54.06,0:21:55.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:55.10,0:21:57.48,Default,,0,0,0,,Сіздің әлеміңіз тым кішкентай
Dialogue: 0,0:21:57.56,0:21:59.52,Default,,0,0,0,,Аспаннан көрінген сарай
Dialogue: 0,0:21:59.61,0:22:00.98,Default,,0,0,0,,Ол қандай болды?
Dialogue: 0,0:22:01.69,0:22:02.86,Default,,0,0,0,,...
Dialogue: 0,0:22:02.94,0:22:05.11,Default,,0,0,0,,Ол кішкентай болып көрінді.
Dialogue: 0,0:22:05.19,0:22:08.45,Default,,0,0,0,,Бұл бәрінен бұрын.
Dialogue: 0,0:22:10.28,0:22:11.83,Default,,0,0,0,,Сіз шешесіз.
Dialogue: 0,0:22:22.34,0:22:26.17,Default,,0,0,0,,Мен әлемді көбірек көргім келеді
Dialogue: 0,0:22:26.26,0:22:28.80,Default,,0,0,0,,Соңғы бірнеше күнде мен білдім
Dialogue: 0,0:22:29.80,0:22:32.14,Default,,0,0,0,,Үйдің сыртындағы әлем
Dialogue: 0,0:22:32.64,0:22:34.85,Default,,0,0,0,,Арне-сама әлемі
Dialogue: 0,0:22:36.52,0:22:40.65,Default,,0,0,0,,Олай болса, сіз осындай жерде айға қарап тұрар ма едіңіз?
Dialogue: 0,0:22:47.15,0:22:49.53,Default,,0,0,0,,Кеттік, Линн Райнвейс
Dialogue: 0,0:22:49.61,0:22:51.99,Default,,0,0,0,,Иә, Арне-сама.
Dialogue: 0,0:22:53.49,0:22:59.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
