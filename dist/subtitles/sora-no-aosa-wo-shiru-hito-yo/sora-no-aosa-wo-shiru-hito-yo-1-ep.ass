Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.50,0:00:04.92,Default,,0,0,0,,
Dialogue: 0,0:00:05.00,0:00:06.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:27.19,0:00:29.07,Default,,0,0,0,,(Қыздардың күлкісі)
Dialogue: 0,0:00:29.15,0:00:31.03,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:00:31.11,0:00:35.11,Default,,0,0,0,,(Тікұшақ роторының дыбысы)
Dialogue: 0,0:00:41.29,0:00:43.79,Default,,0,0,0,,(шу жоғалады)
Dialogue: 0,0:00:52.76,0:00:57.18,Default,,0,0,0,,(төмен дыбысты басс дыбыс)
Dialogue: 0,0:01:02.89,0:01:09.90,Default,,0,0,0,,(«Гандхара» негізі)
Dialogue: 0,0:01:17.66,0:01:20.03,Default,,0,0,0,,Мен оны үнемі іздеймін
Dialogue: 0,0:01:30.46,0:01:31.88,Default,,0,0,0,,Мен оны іздеп жүрмін
Dialogue: 0,0:01:32.88,0:01:34.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:41.60,0:01:44.18,Default,,0,0,0,,Ламинарияны қайтадан өшіру
Dialogue: 0,0:01:44.68,0:01:45.93,Default,,0,0,0,,Бүгін барлық ламинариялар
Dialogue: 0,0:01:46.02,0:01:47.98,Default,,0,0,0,,Иә, неге, Ақан!
Dialogue: 0,0:01:48.06,0:01:50.86,Default,,0,0,0,,Туна майосы жақсы деп 10 000 рет айттым.
Dialogue: 0,0:01:50.94,0:01:52.82,Default,,0,0,0,,-Келп жақсы -себебі
Dialogue: 0,0:01:52.90,0:01:54.57,Default,,0,0,0,,Мен Аойдан жеңіліп қалдым.
Dialogue: 0,0:01:54.65,0:01:56.61,Default,,0,0,0,,10 000 рет айттым, бірақ жеңілдім.
Dialogue: 0,0:01:58.74,0:02:01.87,Default,,0,0,0,,Жаттығу жасайық!
Dialogue: 0,0:02:01.95,0:02:04.66,Default,,0,0,0,,Не, сен әлі тамақтанып жүрсің бе?
Dialogue: 0,0:02:04.74,0:02:05.75,Default,,0,0,0,,Тезірек тамақтанып ал!
Dialogue: 0,0:02:05.83,0:02:08.67,Default,,0,0,0,,Менің Akane Special отты үрлейді.
Dialogue: 0,0:02:08.75,0:02:10.21,Default,,0,0,0,,Бұл Хидидің аты.
Dialogue: 0,0:02:10.29,0:02:11.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:11.50,0:02:13.00,Default,,0,0,0,,Аоимо...
Dialogue: 0,0:02:13.67,0:02:14.84,Default,,0,0,0,,Мен мұны істегім келеді
Dialogue: 0,0:02:14.92,0:02:18.09,Default,,0,0,0,,Әй, сен неге маған гитара үйретпейсің?
Dialogue: 0,0:02:18.80,0:02:20.05,Default,,0,0,0,,Ммм!
Dialogue: 0,0:02:20.68,0:02:23.47,Default,,0,0,0,,А? Сонда мен не істей аламын?
Dialogue: 0,0:02:23.56,0:02:24.35,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:24.43,0:02:26.14,Default,,0,0,0,,- Иә? -(Або) А?
Dialogue: 0,0:02:27.27,0:02:29.56,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,0:02:29.64,0:02:31.52,Default,,0,0,0,,Бұл маған таңданасың дегенді білдіре ме?
Dialogue: 0,0:02:31.60,0:02:32.86,Default,,0,0,0,,Аои-чан
Dialogue: 0,0:02:32.94,0:02:34.15,Default,,0,0,0,,Жоқ... аа аа
Dialogue: 0,0:02:34.23,0:02:35.61,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:02:36.11,0:02:39.28,Default,,0,0,0,,Бірақ оның әйелге негізделгені керемет.
Dialogue: 0,0:02:39.86,0:02:40.86,Default,,0,0,0,,Ня Ао
Dialogue: 0,0:02:40.95,0:02:43.24,Default,,0,0,0,,Үлкен болған соң, сен менің басымсың.
Dialogue: 0,0:02:43.32,0:02:45.29,Default,,0,0,0,,Эй, онда мен ше?
Dialogue: 0,0:02:45.37,0:02:47.00,Default,,0,0,0,,Саған жақсы, Аой
Dialogue: 0,0:02:47.08,0:02:49.50,Default,,0,0,0,,- Або хор ма? -(Або) А?
Dialogue: 0,0:02:49.58,0:02:52.00,Default,,0,0,0,,Жақсырақ, биші?
Dialogue: 0,0:02:52.08,0:02:53.59,Default,,0,0,0,,Бамба сен
Dialogue: 0,0:02:53.67,0:02:55.80,Default,,0,0,0,,Эй, эй, сен жаттығу жасап жатырсың, солай ма?
Dialogue: 0,0:02:55.88,0:02:57.26,Default,,0,0,0,,Біз неден бастауымыз керек?
Dialogue: 0,0:02:57.34,0:02:58.55,Default,,0,0,0,,Ах~
Dialogue: 0,0:02:59.05,0:03:01.30,Default,,0,0,0,,Мм... Ақан ше?
Dialogue: 0,0:03:01.89,0:03:02.68,Default,,0,0,0,,Әдеттегі
Dialogue: 0,0:03:02.76,0:03:05.14,Default,,0,0,0,,-Жарайды! -(Бэмба) Тағы кездескенше?
Dialogue: 0,0:03:05.22,0:03:06.97,Default,,0,0,0,,Кеттік, Мичинко!
Dialogue: 0,0:03:07.06,0:03:07.89,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:07.97,0:03:09.18,Default,,0,0,0,,А... сәл күте тұрыңыз.
Dialogue: 0,0:03:09.27,0:03:10.85,Default,,0,0,0,,Бір минут.
Dialogue: 0,0:03:10.94,0:03:13.10,Default,,0,0,0,,-Hehehehehe - (Масамичи) Бамба микрофонының ашасы
Dialogue: 0,0:03:13.19,0:03:15.82,Default,,0,0,0,,- (Бэмба) Иә? -(Або) Ей, солай істейсің бе?
Dialogue: 0,0:03:16.40,0:03:18.03,Default,,0,0,0,,Онда барсаңыз...
Dialogue: 0,0:03:19.61,0:03:21.99,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:03:22.07,0:03:25.20,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:03:25.28,0:03:27.62,Default,,0,0,0,,♪ Онда барсаңыз
Dialogue: 0,0:03:27.70,0:03:34.71,Default,,0,0,0,,♪ Кез келген арман орындалады дейді
Dialogue: 0,0:03:36.13,0:03:41.55,Default,,0,0,0,,♪ Барлығы барғысы келеді
Dialogue: 0,0:03:41.63,0:03:46.51,Default,,0,0,0,,♪ Алыстағы әлем
Dialogue: 0,0:03:46.60,0:03:49.39,Default,,0,0,0,,♪ Елдің аты – Гандхара.
Dialogue: 0,0:03:49.47,0:03:51.85,Default,,0,0,0,,♪ Бір жерде утопия
Dialogue: 0,0:03:51.94,0:03:53.10,Default,,0,0,0,,♪ Не істеуім керек...
Dialogue: 0,0:03:53.19,0:03:57.23,Default,,0,0,0,,Бірақ мен сенімдімін...
Dialogue: 0,0:03:57.86,0:03:59.53,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:04:00.32,0:04:02.65,Default,,0,0,0,,Бұл тым алыс...
Dialogue: 0,0:04:02.74,0:04:04.16,Default,,0,0,0,,Жазатайым оқиға болмайды
Dialogue: 0,0:04:04.24,0:04:05.57,Default,,0,0,0,,Екеуміз біргеміз
Dialogue: 0,0:04:06.20,0:04:08.70,Default,,0,0,0,,Басқа адам басқа жаққа қарап тұрған сияқты.
Dialogue: 0,0:04:08.79,0:04:11.70,Default,,0,0,0,,Екі қызыңызды қалдырғаныңызға өкінетініңізге сенімдімін.
Dialogue: 0,0:04:12.29,0:04:15.12,Default,,0,0,0,,Акане-чан, сен қазір үшінші курстасың, солай ма?
Dialogue: 0,0:04:15.21,0:04:16.58,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:04:17.34,0:04:18.38,Default,,0,0,0,,Аои-чан
Dialogue: 0,0:04:18.92,0:04:20.88,Default,,0,0,0,,Әпкеңнің айтқанын мұқият тыңда.
Dialogue: 0,0:04:21.55,0:04:24.63,Default,,0,0,0,,Бұдан былай екеуміз бірге жұмыс істеуіміз керек.
Dialogue: 0,0:04:38.65,0:04:40.44,Default,,0,0,0,,Мен бара алмаймын
Dialogue: 0,0:04:40.53,0:04:41.61,Default,,0,0,0,,Ах
Dialogue: 0,0:04:43.49,0:04:45.61,Default,,0,0,0,,Неліктен? Неліктен?
Dialogue: 0,0:04:45.70,0:04:47.87,Default,,0,0,0,,Токиодағы кәсіптік-техникалық училищеге бірге баруға уәде береміз!
Dialogue: 0,0:04:47.95,0:04:49.33,Default,,0,0,0,,(Ақанның күрсінуі)
Dialogue: 0,0:04:52.12,0:04:53.33,Default,,0,0,0,,Ақан!
Dialogue: 0,0:04:54.12,0:04:54.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:55.42,0:04:57.92,Default,,0,0,0,,Ака-ни, мені қорлама, ақымақ!
Dialogue: 0,0:04:58.00,0:04:59.04,Default,,0,0,0,,Аой…
Dialogue: 0,0:04:59.13,0:05:01.63,Default,,0,0,0,,Менің қарындасымды ертіп жүрме, ақымақ!
Dialogue: 0,0:05:01.71,0:05:02.46,Default,,0,0,0,,Май!
Dialogue: 0,0:05:02.55,0:05:05.34,Default,,0,0,0,,De… Менің денемдегі майдың пайызы 7%.
Dialogue: 0,0:05:05.43,0:05:06.68,Default,,0,0,0,,- Шулы май! -Эй Аой
Dialogue: 0,0:05:06.76,0:05:08.14,Default,,0,0,0,,Горилла маймыл!
Dialogue: 0,0:05:08.22,0:05:09.72,Default,,0,0,0,,Менің қарындасымды өзіңізбен бірге алып кетпеңіз.
Dialogue: 0,0:05:09.80,0:05:12.72,Default,,0,0,0,,Ака-ни мен Аои әрқашан бірге болған!
Dialogue: 0,0:05:13.43,0:05:15.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:22.07,0:05:25.78,Default,,0,0,0,,Мен әлі іздеп жүрмін
Dialogue: 0,0:05:28.87,0:05:30.62,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:05:39.79,0:05:41.25,Default,,0,0,0,,
Dialogue: 0,0:05:54.93,0:05:56.93,Default,,0,0,0,,♪~
Dialogue: 0,0:06:24.42,0:06:25.55,Default,,0,0,0,,Іздеу
Dialogue: 0,0:06:33.22,0:06:37.23,Default,,0,0,0,,Кез келген арман орындалатын жер...
Dialogue: 0,0:06:40.14,0:06:42.15,Default,,0,0,0,,~♪
Dialogue: 0,0:06:43.56,0:06:45.48,Default,,0,0,0,,Не? Айтпақшы, Сенпай, не болды?
Dialogue: 0,0:06:47.15,0:06:48.57,Default,,0,0,0,,- (Студент) Сау бол - (Оқушы) Көріскенше
Dialogue: 0,0:06:49.74,0:06:50.82,Default,,0,0,0,,Мен Токиоға барамын
Dialogue: 0,0:06:50.91,0:06:53.20,Default,,0,0,0,,Мен орналасқан жерді білемін, бірақ
Dialogue: 0,0:06:53.28,0:06:55.66,Default,,0,0,0,,Сіз жоғары оқу орнына түскіңіз келмейді, солай ма?
Dialogue: 0,0:06:55.74,0:06:56.87,Default,,0,0,0,,Жұмыспен қамту?
Dialogue: 0,0:06:57.37,0:07:00.12,Default,,0,0,0,,Толық емес жұмыс уақытында мен тобыммен бірге әлемді жаулап алдым.
Dialogue: 0,0:07:00.21,0:07:02.54,Default,,0,0,0,,Топ...Мүшелер кімдер?
Dialogue: 0,0:07:02.63,0:07:04.25,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:07:04.92,0:07:07.00,Default,,0,0,0,,Жұмысқа орналасу...
Dialogue: 0,0:07:07.09,0:07:09.26,Default,,0,0,0,,Иә, келесі Отаки мырза, кіріңіз.
Dialogue: 0,0:07:09.34,0:07:10.72,Default,,0,0,0,,Иә
Dialogue: 0,0:07:12.84,0:07:14.35,Default,,0,0,0,,Біраз қысым бар~
Dialogue: 0,0:07:14.43,0:07:15.85,Default,,0,0,0,,Отаки тез...
Dialogue: 0,0:07:15.93,0:07:18.52,Default,,0,0,0,,А, мен саған үйленемін!
Dialogue: 0,0:07:18.60,0:07:20.48,Default,,0,0,0,,Менің әлі серіктесім жоқ...
Dialogue: 0,0:07:20.56,0:07:21.98,Default,,0,0,0,,Жұмысқа орналасу
Dialogue: 0,0:07:22.06,0:07:23.27,Default,,0,0,0,,Иә Келесі
Dialogue: 0,0:07:23.35,0:07:25.90,Default,,0,0,0,,Иә~ Тағы біраз сөйлесейік.
Dialogue: 0,0:07:25.98,0:07:27.57,Default,,0,0,0,,Біздің болашағымыз
Dialogue: 0,0:07:32.66,0:07:37.12,Default,,0,0,0,,Қала әкімдігі жыл соңына қарай қыза түсуде.
Dialogue: 0,0:07:37.20,0:07:39.16,Default,,0,0,0,,Келесі айда алып кету мүмкін болмауы мүмкін.
Dialogue: 0,0:07:39.25,0:07:44.96,Default,,0,0,0,,Ой, менің үйімнен мектепке дейін жаяу бір сағат кетеді.
Dialogue: 0,0:07:45.04,0:07:46.79,Default,,0,0,0,,Жақсы, жақсы маусым.
Dialogue: 0,0:07:46.88,0:07:49.96,Default,,0,0,0,,Күзгі жапырақтарды тамашалап, тауға шығу керемет емес пе?
Dialogue: 0,0:07:50.51,0:07:53.43,Default,,0,0,0,,А, мен тауларды жек көремін.
Dialogue: 0,0:07:53.51,0:07:54.39,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:54.89,0:07:56.01,Default,,0,0,0,,Бассейн дегеніміз не?
Dialogue: 0,0:07:56.10,0:07:59.81,Default,,0,0,0,,Өйткені, бұл қабырғамен қоршалғандай.
Dialogue: 0,0:08:00.48,0:08:04.23,Default,,0,0,0,,Бізді үлкен түрмеде отыр.
Dialogue: 0,0:08:04.31,0:08:06.65,Default,,0,0,0,,Аоидың орта мектебінің лирикасы
Dialogue: 0,0:08:06.73,0:08:08.40,Default,,0,0,0,,Сіз кез келген нәрсені айта аласыз.
Dialogue: 0,0:08:08.48,0:08:11.74,Default,,0,0,0,,Әйтеуір, мен бұл жерден кетемін.
Dialogue: 0,0:08:25.37,0:08:26.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:30.71,0:08:31.76,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:31.84,0:08:34.59,Default,,0,0,0,,Ах, Аканэ-чан, Аои-чан
Dialogue: 0,0:08:34.68,0:08:35.72,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:08:35.80,0:08:37.18,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:37.26,0:08:38.80,Default,,0,0,0,,Бүгін кешке жиналамыз
Dialogue: 0,0:08:38.89,0:08:41.35,Default,,0,0,0,,Масамичи-чан тым көп адам жинап жатыр.
Dialogue: 0,0:08:41.43,0:08:44.19,Default,,0,0,0,,Менде жастықтар мен үстелдер жеткіліксіз, сондықтан мен Ямагучи мырзамен біргемін...
Dialogue: 0,0:08:44.27,0:08:45.81,Default,,0,0,0,,О, мен саған көмектесемін.
Dialogue: 0,0:08:45.90,0:08:47.98,Default,,0,0,0,,-Ой, жарайды -Қарашы, Аой
Dialogue: 0,0:08:48.48,0:08:49.61,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:51.48,0:08:53.53,Default,,0,0,0,,Кешіріңіз, мен үйге бара жатқан едім.
Dialogue: 0,0:08:53.61,0:08:57.03,Default,,0,0,0,,Мүлдем емес, тіпті мен жақындаймын.
Dialogue: 0,0:08:57.11,0:08:59.24,Default,,0,0,0,,Иә, Акане-чан, алмұрт жегің келе ме?
Dialogue: 0,0:08:59.33,0:09:00.91,Default,,0,0,0,,Е, мен жеймін, жеймін.
Dialogue: 0,0:09:00.99,0:09:03.33,Default,,0,0,0,,Ол шынымен жақсы әпке.
Dialogue: 0,0:09:03.41,0:09:05.46,Default,,0,0,0,,Рахмет, Аои Чан.
Dialogue: 0,0:09:05.96,0:09:08.88,Default,,0,0,0,,Сізге тым көп алғыс айтуды айтқан кезде
Dialogue: 0,0:09:09.54,0:09:12.67,Default,,0,0,0,,Мен бүлік шығарғым келеді
Dialogue: 0,0:09:14.09,0:09:15.63,Default,,0,0,0,,Жоқ, мен білдім.
Dialogue: 0,0:09:15.72,0:09:20.01,Default,,0,0,0,,Мисо картоп дүңгіршегі - мен дәмі көбірек алуды қалайтын жер.
Dialogue: 0,0:09:20.10,0:09:23.27,Default,,0,0,0,,Мисоға юзу немесе шичими қосыңыз.
Dialogue: 0,0:09:23.35,0:09:26.48,Default,,0,0,0,,Бірақ, адамдар шынымен осылай келе ме?
Dialogue: 0,0:09:26.56,0:09:29.36,Default,,0,0,0,,Сен маған әлсіз нәрсе айттың, жігіт.
Dialogue: 0,0:09:29.44,0:09:33.48,Default,,0,0,0,,Тіпті осы жердегі туристер үшін де туристердің көпшілігі қалада.
Dialogue: 0,0:09:33.99,0:09:37.66,Default,,0,0,0,,Бұл жерде маған қатты соққы бермеңіз.
Dialogue: 0,0:09:37.74,0:09:38.49,Default,,0,0,0,,О
Dialogue: 0,0:09:38.57,0:09:40.66,Default,,0,0,0,,Егер сіз үлкен толқынға мінбесеңіз, сіз ақша жоғалтасыз.
Dialogue: 0,0:09:40.74,0:09:42.79,Default,,0,0,0,,Туризм бөлімінен Масамичи
Dialogue: 0,0:09:42.87,0:09:44.62,Default,,0,0,0,,Өйткені сіз маған икемділік бердіңіз.
Dialogue: 0,0:09:44.70,0:09:48.04,Default,,0,0,0,,Дұрыс, бұл біраз жұмыс істеген сияқты.
Dialogue: 0,0:09:48.12,0:09:50.00,Default,,0,0,0,,Бұл тіпті қалалық әкімдікте де қауесет.
Dialogue: 0,0:09:50.08,0:09:51.71,Default,,0,0,0,,Уақытыңды босқа өткізбе Ақане!
Dialogue: 0,0:09:51.79,0:09:53.50,Default,,0,0,0,,Не, бұл өтірік пе?
Dialogue: 0,0:09:53.59,0:09:55.17,Default,,0,0,0,,Көп шығып жатқан жоқ па?
Dialogue: 0,0:09:55.26,0:09:56.38,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:09:56.47,0:09:59.34,Default,,0,0,0,,Сырттан әншілерді немесе топтарды әкелмеңіз.
Dialogue: 0,0:09:59.43,0:10:01.85,Default,,0,0,0,,Мұның бәрі жергілікті қауымдастық туралы.
Dialogue: 0,0:10:02.35,0:10:04.64,Default,,0,0,0,,Ао Чан да қатысса ше?
Dialogue: 0,0:10:06.14,0:10:10.73,Default,,0,0,0,,Егер ол қаланы жандандыру үшін қолданылса, бұл енді музыка емес.
Dialogue: 0,0:10:10.81,0:10:12.90,Default,,0,0,0,,Дыбыстан ләззат алмаңыз
Dialogue: 0,0:10:12.98,0:10:16.49,Default,,0,0,0,,Дыбысты азап ретінде жазу «дыбыс - ауырсыну» дегенді білдіреді
Dialogue: 0,0:10:16.99,0:10:19.86,Default,,0,0,0,,Мен жай ғана жақсы нәрсе айттым деп ойлайтын шығарсыз, бірақ
Dialogue: 0,0:10:19.95,0:10:21.74,Default,,0,0,0,,Өйткені мен мүлдем ештеңе айта алмаймын.
Dialogue: 0,0:10:22.62,0:10:23.66,Default,,0,0,0,,Ита-та-тат
Dialogue: 0,0:10:23.74,0:10:27.96,Default,,0,0,0,,Әйтеуір, бұл жерлер музыка арқылы қайта туды.
Dialogue: 0,0:10:33.50,0:10:35.25,Default,,0,0,0,,Аой! Цуг!
Dialogue: 0,0:10:35.34,0:10:36.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:36.71,0:10:37.88,Default,,0,0,0,,Әке
Dialogue: 0,0:10:39.05,0:10:42.97,Default,,0,0,0,,Ах~ Сіз бүгін тағы да ғибадатханада жаттығуға барасыз ба?
Dialogue: 0,0:10:43.05,0:10:44.06,Default,,0,0,0,,Иә
Dialogue: 0,0:10:44.14,0:10:45.72,Default,,0,0,0,,Сағат 9-ға дейін орындаңыз.
Dialogue: 0,0:10:45.81,0:10:49.94,Default,,0,0,0,,Сіздің бассыңыз біртүрлі және қорқынышты естіледі.
Dialogue: 0,0:10:51.85,0:10:54.94,Default,,0,0,0,,Хмм... Менің үйімде дыбыс өткізбейтін бөлме бар.
Dialogue: 0,0:10:55.02,0:10:56.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:57.23,0:10:59.36,Default,,0,0,0,,Бауырым, қаламайсың ба?
Dialogue: 0,0:10:59.45,0:11:00.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:00.91,0:11:03.28,Default,,0,0,0,,Әке, кенеттен үзілмеңіз.
Dialogue: 0,0:11:03.37,0:11:05.58,Default,,0,0,0,,Ажырасқандарға бере алмаймын.
Dialogue: 0,0:11:05.66,0:11:08.00,Default,,0,0,0,,Мен біреудің мені алдауының құрбаны болдым!
Dialogue: 0,0:11:08.08,0:11:10.12,Default,,0,0,0,,Бұл таза және дұрыс талақ.
Dialogue: 0,0:11:10.21,0:11:11.83,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:11:11.92,0:11:15.09,Default,,0,0,0,,- (Масамичи) Ах~ Эй Аои -Хмм~?
Dialogue: 0,0:11:15.17,0:11:17.80,Default,,0,0,0,,Синно есіңізде ме?
Dialogue: 0,0:11:19.59,0:11:22.26,Default,,0,0,0,,Әй, әйтеуір, неге?
Dialogue: 0,0:11:22.34,0:11:25.76,Default,,0,0,0,,О, жоқ... есіңде болмаса, жарайды.
Dialogue: 0,0:11:25.85,0:11:27.22,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:31.39,0:11:37.02,Default,,0,0,0,,♪ Қатты қайрауға болатын HP
Dialogue: 0,0:11:37.11,0:11:43.24,Default,,0,0,0,,♪ Бұл бәрібір менің кінәм.
Dialogue: 0,0:11:45.32,0:11:47.28,Default,,0,0,0,,Бұрынғы әке
Dialogue: 0,0:11:50.04,0:11:52.25,Default,,0,0,0,,Мен де келіспеймін.
Dialogue: 0,0:11:52.87,0:11:55.33,Default,,0,0,0,,Бірақ...ол адам да...
Dialogue: 0,0:11:55.42,0:11:58.13,Default,,0,0,0,,Бұл жерде ол туралы айтпа
Dialogue: 0,0:11:58.63,0:12:00.76,Default,,0,0,0,,Осы жерде болмаса жақсы емес пе еді?
Dialogue: 0,0:12:02.59,0:12:04.05,Default,,0,0,0,,Маған ұнамайды, бірақ
Dialogue: 0,0:12:04.97,0:12:07.35,Default,,0,0,0,,Міне, осы жерден...
Dialogue: 0,0:12:08.39,0:12:09.56,Default,,0,0,0,,(Коджоу) Иджичи мырза, маған бір сұрақ бар: «Терезе» деген нақты не?
Dialogue: 0,0:12:09.64,0:12:12.31,Default,,0,0,0,,Қараңызшы, оны қаттырақ ұстау керек.
Dialogue: 0,0:12:12.39,0:12:13.94,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:14.02,0:12:15.02,Default,,0,0,0,,О
Dialogue: 0,0:12:15.10,0:12:19.65,Default,,0,0,0,,Ао, мұқият қарасаң, көз алмасында мең көрінеді.
Dialogue: 0,0:12:19.73,0:12:22.40,Default,,0,0,0,,Менімен бірге
Dialogue: 0,0:12:22.49,0:12:25.41,Default,,0,0,0,,Көз алмасында мең бар, мен үлкен мәміле боламын.
Dialogue: 0,0:12:25.49,0:12:28.66,Default,,0,0,0,,Біз жұлдыздармыз.
Dialogue: 0,0:12:28.74,0:12:29.79,Default,,0,0,0,,Таңдаулы жұлдыз!
Dialogue: 0,0:12:29.87,0:12:32.79,Default,,0,0,0,,Иә, бұл кім?
Dialogue: 0,0:12:32.87,0:12:34.42,Default,,0,0,0,,Бұл тым жұмбақ, солай емес пе?
Dialogue: 0,0:12:34.50,0:12:36.63,Default,,0,0,0,,Бұл не? Бұл салқын!
Dialogue: 0,0:12:36.71,0:12:38.54,Default,,0,0,0,,- Керемет! -Хехехе
Dialogue: 0,0:12:41.13,0:12:42.51,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:47.97,0:12:49.22,Default,,0,0,0,,Я~
Dialogue: 0,0:12:49.31,0:12:53.52,Default,,0,0,0,,Данкичи Нитобе де бұрын «Кохакуда» пайда болған, солай ма?
Dialogue: 0,0:12:53.60,0:12:55.90,Default,,0,0,0,,Аа~ менің есіме бір нәрсе түсті.
Dialogue: 0,0:12:55.98,0:12:58.73,Default,,0,0,0,,Сіз оғаш Кинкиракин Омикошиге мінгенсіз, солай ма?
Dialogue: 0,0:12:58.81,0:13:01.48,Default,,0,0,0,,Иә, мен де көрдім.
Dialogue: 0,0:13:01.57,0:13:02.74,Default,,0,0,0,,Оқиғаға сәйкес
Dialogue: 0,0:13:02.82,0:13:05.57,Default,,0,0,0,,Бізде жергілікті әндер осы жерде жасалуы керек.
Dialogue: 0,0:13:05.65,0:13:08.99,Default,,0,0,0,,Мен олардан ән мәтініне «отшашулар атылып жатыр» деген сөзді қосуды өтіндім.
Dialogue: 0,0:13:09.07,0:13:12.04,Default,,0,0,0,,Содан кейін шын мәнінде Дон Дон Дон отшашуы!
Dialogue: 0,0:13:12.12,0:13:13.33,Default,,0,0,0,,Отшашу? Керемет
Dialogue: 0,0:13:13.41,0:13:15.71,Default,,0,0,0,,Бұл шынымен қозғалды ма?
Dialogue: 0,0:13:15.79,0:13:19.00,Default,,0,0,0,,Бұл! ең үлкеніне айналу
Dialogue: 0,0:13:19.08,0:13:24.30,Default,,0,0,0,,Менің... Өмірімді тәуекелге бел байлаған ең маңызды нәрсе.
Dialogue: 0,0:13:26.13,0:13:29.51,Default,,0,0,0,,Олай болса, оқиғаға қатысты көмек сұраңыз, Ақане.
Dialogue: 0,0:13:29.60,0:13:30.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.43,0:13:33.43,Default,,0,0,0,,Азаматтық істер бөлімінде бүкіл оқиға болды.
Dialogue: 0,0:13:33.52,0:13:36.27,Default,,0,0,0,,Мен тыңдаймын. Сәттілік, Айои-сан.
Dialogue: 0,0:13:36.35,0:13:37.14,Default,,0,0,0,,А...
Dialogue: 0,0:13:37.23,0:13:39.19,Default,,0,0,0,,Накамура~ Кездесуді бастайық.
Dialogue: 0,0:13:39.27,0:13:42.69,Default,,0,0,0,,Жарайды, егжей-тегжейлі кейінірек айтамын.
Dialogue: 0,0:13:42.78,0:13:44.40,Default,,0,0,0,,Сәлем Мичинко!
Dialogue: 0,0:13:44.49,0:13:47.11,Default,,0,0,0,,Ал, қазір бос уақытымыз көп.
Dialogue: 0,0:13:47.20,0:13:49.03,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:13:50.03,0:13:51.08,Default,,0,0,0,,Иә~
Dialogue: 0,0:13:54.87,0:13:58.75,Default,,0,0,0,,Мичинко сізді жақсы көретінін білесіз бе?
Dialogue: 0,0:13:58.83,0:14:01.38,Default,,0,0,0,,Хмм, бұл рас.
Dialogue: 0,0:14:01.96,0:14:04.63,Default,,0,0,0,,Сізді мазасыздандыратын әрекеттерді доғарыңыз.
Dialogue: 0,0:14:10.05,0:14:13.85,Default,,0,0,0,,Біз бала кезден доспыз және бірге жұмыс істейміз.
Dialogue: 0,0:14:13.93,0:14:16.31,Default,,0,0,0,,Қарым-қатынаста, әйтеуір түсінсең де
Dialogue: 0,0:14:16.39,0:14:18.73,Default,,0,0,0,,Кейбір нәрселерді дауыстап айтуға болмайды.
Dialogue: 0,0:14:18.81,0:14:21.44,Default,,0,0,0,,Бұл ересектерге тән әдептілік
Dialogue: 0,0:14:22.52,0:14:25.23,Default,,0,0,0,,Үлкендер қызықсыз.
Dialogue: 0,0:14:27.11,0:14:32.28,Default,,0,0,0,,Неліктен бұл туралы көбірек ойламайсың?
Dialogue: 0,0:14:32.37,0:14:32.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:33.03,0:14:34.54,Default,,0,0,0,,Қосымша білім
Dialogue: 0,0:14:35.12,0:14:38.12,Default,,0,0,0,,Бөлек оқу кезінде де топ құра аласыз.
Dialogue: 0,0:14:38.21,0:14:40.87,Default,,0,0,0,,Бұл шешілген жоқ па?
Dialogue: 0,0:14:40.96,0:14:43.92,Default,,0,0,0,,Мен бұдан былай шыдамаймын деп уәде бердім.
Dialogue: 0,0:14:44.42,0:14:45.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:45.67,0:14:48.80,Default,,0,0,0,,Уәдеңді бұзба
Dialogue: 0,0:14:52.01,0:14:55.10,Default,,0,0,0,,-Жарайды, мен жаттығуға барамын. -Хмм.
Dialogue: 0,0:15:15.99,0:15:17.33,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:15:18.33,0:15:19.16,Default,,0,0,0,,Иә
Dialogue: 0,0:15:21.92,0:15:28.92,Default,,0,0,0,,(төмен ызылдаған бас дыбыс)
Dialogue: 0,0:15:52.82,0:15:55.82,Default,,0,0,0,,(Өнімділікті арттыру)
Dialogue: 0,0:16:00.12,0:16:01.62,Default,,0,0,0,,Шу!
Dialogue: 0,0:16:01.71,0:16:03.58,Default,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,0:16:03.67,0:16:07.29,Default,,0,0,0,,Оның үстіне ырғақ пен уақыт жиіркенішті... Иә?
Dialogue: 0,0:16:10.05,0:16:10.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.51,0:16:13.47,Default,,0,0,0,,Кім?
Dialogue: 0,0:16:13.97,0:16:15.39,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:16:17.64,0:16:18.47,Default,,0,0,0,,Эй
Dialogue: 0,0:16:19.26,0:16:22.06,Default,,0,0,0,,Біз жұлдыздармыз.
Dialogue: 0,0:16:22.89,0:16:24.81,Default,,0,0,0,,Шин...?
Dialogue: 0,0:16:24.90,0:16:27.23,Default,,0,0,0,,Иә? Мен туралы...
Dialogue: 0,0:16:27.31,0:16:29.57,Default,,0,0,0,,Бұл менің формасым.
Dialogue: 0,0:16:30.07,0:16:32.78,Default,,0,0,0,,Сіз менің жанкүйерімсіз бе?
Dialogue: 0,0:16:32.86,0:16:34.36,Default,,0,0,0,,Қолыңды қысайын ба?
Dialogue: 0,0:16:35.32,0:16:38.37,Default,,0,0,0,,...Не? иә?
Dialogue: 0,0:16:43.79,0:16:46.17,Default,,0,0,0,,Өйткені, Шинно...
Dialogue: 0,0:16:46.25,0:16:47.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:47.96,0:16:48.92,Default,,0,0,0,,Сонымен? Сіз...
Dialogue: 0,0:16:49.00,0:16:50.13,Default,,0,0,0,,Ака-ни~!
Dialogue: 0,0:16:50.21,0:16:51.76,Default,,0,0,0,,Эй... Эй!
Dialogue: 0,0:16:51.84,0:16:53.67,Default,,0,0,0,,Ака-ни~!
Dialogue: 0,0:16:53.76,0:16:54.88,Default,,0,0,0,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:16:54.97,0:16:55.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:55.80,0:16:58.10,Default,,0,0,0,,Ооо... а?
Dialogue: 0,0:16:58.60,0:17:00.89,Default,,0,0,0,,Иә? Бұл не...
Dialogue: 0,0:17:02.27,0:17:03.89,Default,,0,0,0,,Хмм! Ах…
Dialogue: 0,0:17:04.85,0:17:06.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:06.94,0:17:10.02,Default,,0,0,0,,Сәлем! Бұл жерден кетіңіз!
Dialogue: 0,0:17:12.32,0:17:14.03,Default,,0,0,0,,(Ақанның гуілдеуі)
Dialogue: 0,0:17:14.11,0:17:15.20,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:17:17.78,0:17:19.49,Default,,0,0,0,,А... Ака-ни!
Dialogue: 0,0:17:19.58,0:17:21.66,Default,,0,0,0,,Иә? Сіз әлі жаттығуды аяқтадыңыз ба?
Dialogue: 0,0:17:21.74,0:17:23.79,Default,,0,0,0,,Бүгін Аойдың сүйікті фарш котлеті...
Dialogue: 0,0:17:23.87,0:17:25.21,Default,,0,0,0,,Ши... Шиннога!
Dialogue: 0,0:17:26.21,0:17:28.88,Default,,0,0,0,,А, кешіріңіз.
Dialogue: 0,0:17:29.38,0:17:31.96,Default,,0,0,0,,Сонымен Шинноға не болды?
Dialogue: 0,0:17:32.05,0:17:34.84,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:17:34.92,0:17:38.64,Default,,0,0,0,,Иә, мен бірдеңені жаттығып жатқанымда кенет есіме бір нәрсе түсті.
Dialogue: 0,0:17:39.14,0:17:43.60,Default,,0,0,0,,Не болып жатыр деп таң қалдым, болды.
Dialogue: 0,0:17:45.39,0:17:47.90,Default,,0,0,0,,Көптен бері хабарласқан жоқпыз.
Dialogue: 0,0:17:48.48,0:17:51.52,Default,,0,0,0,,Мен оның тірі немесе өлі екенін білмеймін.
Dialogue: 0,0:17:51.61,0:17:52.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:54.69,0:17:57.65,Default,,0,0,0,,Иә, мүмкіндік болды ма?
Dialogue: 0,0:17:57.74,0:17:59.62,Default,,0,0,0,,Басқа ештеңе жоқ па?
Dialogue: 0,0:17:59.70,0:18:03.16,Default,,0,0,0,,Өйткені қалай қарасаң да бұрынғыдай...
Dialogue: 0,0:18:03.24,0:18:04.62,Default,,0,0,0,,Аой?
Dialogue: 0,0:18:05.12,0:18:07.66,Default,,0,0,0,,Әй, есік ашық қалды.
Dialogue: 0,0:18:07.75,0:18:09.83,Default,,0,0,0,,Сен соншалықты бейқамсың.
Dialogue: 0,0:18:09.92,0:18:10.79,Default,,0,0,0,,Мичинко?
Dialogue: 0,0:18:10.88,0:18:13.38,Default,,0,0,0,,...Екеуің не істеп жатырсыңдар?
Dialogue: 0,0:18:13.46,0:18:15.09,Default,,0,0,0,,-Не... -Кешкі ас...
Dialogue: 0,0:18:15.17,0:18:16.63,Default,,0,0,0,,Олай емес!
Dialogue: 0,0:18:16.72,0:18:17.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:17.84,0:18:19.47,Default,,0,0,0,,Оқиға туралы анықтама
Dialogue: 0,0:18:19.55,0:18:20.76,Default,,0,0,0,,Мен мұны естідім.
Dialogue: 0,0:18:20.84,0:18:23.39,Default,,0,0,0,,Иә? Мен саған бүгінгі күнді айтпадым ба?
Dialogue: 0,0:18:23.47,0:18:24.18,Default,,0,0,0,,Біз Мемлекеттік қауіпсіздік басқармасынан келдік.
Dialogue: 0,0:18:24.26,0:18:26.56,Default,,0,0,0,,Әй, бәрібір, тезірек!
Dialogue: 0,0:18:29.73,0:18:32.15,Default,,0,0,0,,Мұғалім келгенде, оны ашыңыз.
Dialogue: 0,0:18:32.23,0:18:34.02,Default,,0,0,0,,Экономика қарқынды дамып келеді
Dialogue: 0,0:18:34.11,0:18:34.94,Default,,0,0,0,,Әке
Dialogue: 0,0:18:35.03,0:18:37.95,Default,,0,0,0,,Түні бойы пісіргеніңіз осы ма?
Dialogue: 0,0:18:38.03,0:18:40.24,Default,,0,0,0,,Әй, шатаспа!
Dialogue: 0,0:18:40.32,0:18:41.99,Default,,0,0,0,,Егер сіз осындай нәрсені істеп жатсаңыз...
Dialogue: 0,0:18:42.07,0:18:43.83,Default,,0,0,0,,Бірақ бүгін неге келесің?
Dialogue: 0,0:18:43.91,0:18:45.49,Default,,0,0,0,,Оқиға бір аптадан кейін болады, солай ма?
Dialogue: 0,0:18:45.58,0:18:46.66,Default,,0,0,0,,Міне.
Dialogue: 0,0:18:46.75,0:18:50.29,Default,,0,0,0,,Нитөбе мырза, ол жергілікті әндердің шебері емес пе?
Dialogue: 0,0:18:50.37,0:18:54.21,Default,,0,0,0,,Тек сонда ғана болатын дәмді тағам мен адамдардың жылуын сезіну керек.
Dialogue: 0,0:18:54.29,0:18:57.42,Default,,0,0,0,,Елдің жаны ән айта алмайды, бірдеңе.
Dialogue: 0,0:18:57.51,0:19:00.09,Default,,0,0,0,,Бұл үшін қалалық әкімдік төлейді, солай ма?
Dialogue: 0,0:19:00.18,0:19:02.76,Default,,0,0,0,,Жақсылап барады, солай емес пе?
Dialogue: 0,0:19:02.85,0:19:05.18,Default,,0,0,0,,Сөзсіз...
Dialogue: 0,0:19:05.85,0:19:07.10,Default,,0,0,0,,Цуг?
Dialogue: 0,0:19:07.18,0:19:09.18,Default,,0,0,0,,(ысырма дыбысы бірінен соң бірі шығады)
Dialogue: 0,0:19:09.27,0:19:10.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:11.35,0:19:12.44,Default,,0,0,0,,Не?
Dialogue: 0,0:19:16.98,0:19:20.24,Default,,0,0,0,,Барлықтарыңызға күткеніңізге рахмет.
Dialogue: 0,0:19:20.32,0:19:22.99,Default,,0,0,0,,Бір адам Данкичи Нитобе
Dialogue: 0,0:19:23.78,0:19:26.24,Default,,0,0,0,,Жол бойы егістік пен таулардың үстінде
Dialogue: 0,0:19:26.33,0:19:29.20,Default,,0,0,0,,Біз смайликтер сыйлығын жеткізуге келдік.
Dialogue: 0,0:19:29.79,0:19:32.21,Default,,0,0,0,,Әй, Фе... Жалынды ма?
Dialogue: 0,0:19:32.29,0:19:34.25,Default,,0,0,0,,О, бұл Дан Чан.
Dialogue: 0,0:19:35.63,0:19:38.05,Default,,0,0,0,,Иә? Ака-ни?
Dialogue: 0,0:19:40.26,0:19:45.18,Default,,0,0,0,,♪ Сексуалды жігіт келді
Dialogue: 0,0:19:45.26,0:19:48.68,Default,,0,0,0,,♪ Смартфонды ұстаңыз, иә, сыр
Dialogue: 0,0:19:50.39,0:19:52.90,Default,,0,0,0,,Не, бұл...
Dialogue: 0,0:19:52.98,0:19:54.65,Default,,0,0,0,,-Шинно... -Иә?
Dialogue: 0,0:19:54.73,0:19:57.52,Default,,0,0,0,,Эй Цугу, дұрыс ұста.
Dialogue: 0,0:19:59.03,0:20:01.20,Default,,0,0,0,,♪ Бұл ауырады.
Dialogue: 0,0:20:01.28,0:20:03.95,Default,,0,0,0,,♪ Бұл қиын.
Dialogue: 0,0:20:04.57,0:20:05.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:08.62,0:20:10.91,Default,,0,0,0,,♪ Күлімсіреуді қайта толтыру
Dialogue: 0,0:20:11.00,0:20:12.79,Default,,0,0,0,,♪ Мен көмектесе алмаймын
Dialogue: 0,0:20:12.87,0:20:14.00,Default,,0,0,0,,Е!
Dialogue: 0,0:20:14.08,0:20:17.38,Default,,0,0,0,,♪ Барлығы бірге, иә сыр
Dialogue: 0,0:20:21.47,0:20:23.59,Default,,0,0,0,,О, сәл күте тұршы, Ао Чан
Dialogue: 0,0:20:23.68,0:20:25.14,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:20:25.64,0:20:26.68,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:20:32.43,0:20:36.23,Default,,0,0,0,,Әке, ана және ата-баба ұрпақтары
Dialogue: 0,0:20:36.31,0:20:37.81,Default,,0,0,0,,Маған күш бер!
Dialogue: 0,0:20:38.32,0:20:39.82,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:20:41.03,0:20:44.45,Default,,0,0,0,,Ао-чан, мен түбіртек алдым, бірақ бұл.
Dialogue: 0,0:20:44.53,0:20:46.03,Default,,0,0,0,,А...
Dialogue: 0,0:20:48.78,0:20:52.58,Default,,0,0,0,,Шынында Шинно деген адам болды ма?
Dialogue: 0,0:20:52.66,0:20:55.71,Default,,0,0,0,,Иә, мен оны елес деп ойладым.
Dialogue: 0,0:20:55.79,0:20:58.71,Default,,0,0,0,,Бірақ мен вокзалда көргенім нағыз Шино болды.
Dialogue: 0,0:20:58.79,0:21:00.75,Default,,0,0,0,,Олай болса, мұнда көргеніміз...
Dialogue: 0,0:21:00.84,0:21:02.38,Default,,0,0,0,,Ұқсас адам бар ма?
Dialogue: 0,0:21:02.46,0:21:03.84,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:21:03.92,0:21:06.30,Default,,0,0,0,,Бірақ бұл рас...
Dialogue: 0,0:21:06.39,0:21:09.05,Default,,0,0,0,,Мен оны шынымен түсінбеймін, бірақ онда бірдеңе дұрыс емес.
Dialogue: 0,0:21:12.18,0:21:16.35,Default,,0,0,0,,-Қалай? -(Масацугу) Хмм мұнда ешкім жоқ.
Dialogue: 0,0:21:16.44,0:21:19.82,Default,,0,0,0,,Не? Бұлай болмауы керек...
Dialogue: 0,0:21:21.69,0:21:23.44,Default,,0,0,0,,Сіз неден қашып жүрсіз?
Dialogue: 0,0:21:23.53,0:21:24.78,Default,,0,0,0,,Иә? Эй!
Dialogue: 0,0:21:25.99,0:21:28.24,Default,,0,0,0,,Ао-чан? Ха... жібер!
Dialogue: 0,0:21:28.32,0:21:31.58,Default,,0,0,0,,...Ой? Не, бұл не?
Dialogue: 0,0:21:31.66,0:21:32.95,Default,,0,0,0,,Мичинко ұқсайды
Dialogue: 0,0:21:33.04,0:21:34.41,Default,,0,0,0,,- Ммм - (Масацугу) Ой, уау.
Dialogue: 0,0:21:36.46,0:21:38.04,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:38.13,0:21:39.71,Default,,0,0,0,,Сондықтан Шинно!
Dialogue: 0,0:21:39.79,0:21:41.67,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:41.75,0:21:44.13,Default,,0,0,0,,Ао-чан, қазір қаш.
Dialogue: 0,0:21:44.21,0:21:46.09,Default,,0,0,0,,Ао-чан...
Dialogue: 0,0:21:47.63,0:21:52.31,Default,,0,0,0,,...
Dialogue: 0,0:21:54.02,0:21:55.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:55.27,0:21:57.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:59.77,0:22:03.53,Default,,0,0,0,,Бір күні Акане Токиоға бармайтынын айтты.
Dialogue: 0,0:22:06.90,0:22:09.20,Default,,0,0,0,,Мен үйге бара алмаймын...
Dialogue: 0,0:22:12.41,0:22:15.29,Default,,0,0,0,,Мен мұнда көп нәрсені ойладым.
Dialogue: 0,0:22:15.37,0:22:20.83,Default,,0,0,0,,Сонымен, мен оянсам... таң болды ма?
Dialogue: 0,0:22:20.92,0:22:22.42,Default,,0,0,0,,Неліктен сұрақ формасы?
Dialogue: 0,0:22:22.50,0:22:24.84,Default,,0,0,0,,Мен де түсінбеймін.
Dialogue: 0,0:22:25.34,0:22:28.80,Default,,0,0,0,,Әйтеуір, мен қатты шаршадым, сондықтан ол жерде ес-түссіз отырдым.
Dialogue: 0,0:22:28.88,0:22:30.55,Default,,0,0,0,,Қатты дыбыс мені оятты...
Dialogue: 0,0:22:30.64,0:22:31.93,Default,,0,0,0,,Шу?
Dialogue: 0,0:22:32.01,0:22:33.22,Default,,0,0,0,,Ммм
Dialogue: 0,0:22:33.31,0:22:36.14,Default,,0,0,0,,Шынында да, сен оны түсінгендей болады.
Dialogue: 0,0:22:36.64,0:22:39.06,Default,,0,0,0,,Егер сізге күтпеген жерден 13 жылдан кейін болады деп айтылса да
Dialogue: 0,0:22:39.14,0:22:41.23,Default,,0,0,0,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:22:41.31,0:22:44.02,Default,,0,0,0,,Түсіндім, бұл Таро Урашима.
Dialogue: 0,0:22:44.11,0:22:45.98,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:46.07,0:22:47.32,Default,,0,0,0,,Бірақ жақсы
Dialogue: 0,0:22:47.40,0:22:50.61,Default,,0,0,0,,Егер уақыт таусылған болса, онда сіз ештеңе істей алмайсыз.
Dialogue: 0,0:22:50.70,0:22:52.87,Default,,0,0,0,,Қазіргі жағдайды қабылдауға әлі ерте.
Dialogue: 0,0:22:52.95,0:22:53.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:22:53.99,0:22:57.08,Default,,0,0,0,,Мен сені қабылдағаным сенің арқаң.
Dialogue: 0,0:22:57.91,0:23:00.46,Default,,0,0,0,,Қалай қарасаңыз да, бұл шағын үлгі.
Dialogue: 0,0:23:00.54,0:23:01.58,Default,,0,0,0,,Бұл жарық.
Dialogue: 0,0:23:01.67,0:23:05.38,Default,,0,0,0,,Біріншіден, бұл елес емес. Бұл шынайы.
Dialogue: 0,0:23:05.46,0:23:06.88,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:23:06.96,0:23:08.67,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:23:09.17,0:23:10.63,Default,,0,0,0,,Хмм.
Dialogue: 0,0:23:11.30,0:23:12.72,Default,,0,0,0,,Бұл тірі рух па?
Dialogue: 0,0:23:12.80,0:23:14.10,Default,,0,0,0,,Тірі рух?
Dialogue: 0,0:23:14.18,0:23:15.97,Default,,0,0,0,,Әй, сен мұны жиі айтпайсың ба?
Dialogue: 0,0:23:16.06,0:23:18.43,Default,,0,0,0,,Біреуге қатты сезіміңіз болса
Dialogue: 0,0:23:18.52,0:23:21.85,Default,,0,0,0,,Білмей тірі рухтарды жіберу
Dialogue: 0,0:23:21.94,0:23:22.94,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:23:23.02,0:23:25.65,Default,,0,0,0,,Қарсыласыңды өлгенше сөгесің.
Dialogue: 0,0:23:25.73,0:23:29.57,Default,,0,0,0,,А... Шинно, мені әпкем тастап кетті.
Dialogue: 0,0:23:29.65,0:23:32.36,Default,,0,0,0,,Сол өкініштен туған шығар.
Dialogue: 0,0:23:32.86,0:23:35.08,Default,,0,0,0,,-Не, не айтып тұрсың? - (Аои/Масацугу) Иә?
Dialogue: 0,0:23:35.16,0:23:36.54,Default,,0,0,0,,Өкінбеймін
Dialogue: 0,0:23:36.62,0:23:39.37,Default,,0,0,0,,Мен әлі бас тартпаймын.
Dialogue: 0,0:23:39.45,0:23:40.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:40.58,0:23:42.75,Default,,0,0,0,,Көп нәрсені ойланып шештім.
Dialogue: 0,0:23:42.83,0:23:46.17,Default,,0,0,0,,Тек Токиоға барып, үлкен музыкант бол.
Dialogue: 0,0:23:46.25,0:23:49.63,Default,,0,0,0,,Ақанды жарқылдап көтеріп алайық.
Dialogue: 0,0:23:49.71,0:23:51.13,Default,,0,0,0,,Бұл қалдық қандай оң нәтиже береді?
Dialogue: 0,0:23:51.22,0:23:54.89,Default,,0,0,0,,Бірақ неге бұлай болды!
Dialogue: 0,0:23:54.97,0:23:57.56,Default,,0,0,0,,Акане, ол қазір 31-де, солай ма?
Dialogue: 0,0:23:57.64,0:24:00.23,Default,,0,0,0,,Сіз 31-десіз... Иә? Санжу…
Dialogue: 0,0:24:00.31,0:24:02.23,Default,,0,0,0,,Әй, Ақане, сен үйленбегенсің ғой?
Dialogue: 0,0:24:02.31,0:24:02.89,Default,,0,0,0,,Иә
Dialogue: 0,0:24:02.98,0:24:03.77,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:24:03.85,0:24:06.44,Default,,0,0,0,,Хмм, тым қуанбау керек.
Dialogue: 0,0:24:06.52,0:24:08.82,Default,,0,0,0,,Хмм, мен оны тезірек алуым керек.
Dialogue: 0,0:24:08.90,0:24:10.65,Default,,0,0,0,,Біз кездесеміз бе?
Dialogue: 0,0:24:10.74,0:24:13.70,Default,,0,0,0,,А... ақымақ! Енді сені кездестіруге мүмкіндік жоқ!
Dialogue: 0,0:24:13.78,0:24:15.99,Default,,0,0,0,,Мені естімедің бе?
Dialogue: 0,0:24:16.07,0:24:17.87,Default,,0,0,0,,Үлкен музыкант болған соң...
Dialogue: 0,0:24:17.95,0:24:19.83,Default,,0,0,0,,Үлкен ме, жоқ па білмеймін.
Dialogue: 0,0:24:19.91,0:24:21.37,Default,,0,0,0,,Бұл болды, солай ма?
Dialogue: 0,0:24:21.46,0:24:22.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:22.37,0:24:24.04,Default,,0,0,0,,Не болды саған? Біраз қақтығысқыш болып тұрсың ғой?
Dialogue: 0,0:24:24.12,0:24:28.21,Default,,0,0,0,,31 жаста сіз музыкант болдыңыз.
Dialogue: 0,0:24:31.21,0:24:32.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:33.76,0:24:35.55,Default,,0,0,0,,Мен біраз уақытқа барамын.
Dialogue: 0,0:24:35.64,0:24:36.80,Default,,0,0,0,,Не? Күте тұрыңыз...
Dialogue: 0,0:24:36.89,0:24:39.56,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,0:24:40.35,0:24:41.56,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:24:42.06,0:24:43.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:45.69,0:24:48.44,Default,,0,0,0,,Жарайды, бұл да тағдыр.
Dialogue: 0,0:24:48.52,0:24:50.28,Default,,0,0,0,,Мен де таң қалдым.
Dialogue: 0,0:24:50.36,0:24:54.36,Default,,0,0,0,,Жергілікті ән шығарғыңыз келсе, мен міндетті түрде Нитөбе мырзаны ұсынар едім.
Dialogue: 0,0:24:54.45,0:24:56.91,Default,,0,0,0,,Мен оқиғаның кадрларын жинадым.
Dialogue: 0,0:24:57.41,0:25:00.29,Default,,0,0,0,,Бэк-топта бала күнгі досым болды.
Dialogue: 0,0:25:00.37,0:25:01.33,Default,,0,0,0,,Нашинно
Dialogue: 0,0:25:01.41,0:25:02.62,Default,,0,0,0,,Тамақ ішейік
Dialogue: 0,0:25:02.70,0:25:05.92,Default,,0,0,0,,Бұл Шинносуке үшін жеңісті қайтару қойылымы.
Dialogue: 0,0:25:06.67,0:25:09.67,Default,,0,0,0,,Мұнда бір ерекшелік бар: соло гитара.
Dialogue: 0,0:25:09.75,0:25:13.26,Default,,0,0,0,,Әй, жақсы. Маған да жасауға рұқсат етіңізші.
Dialogue: 0,0:25:13.34,0:25:16.43,Default,,0,0,0,,Сіздің саксофоныңызда жұдырық жоқ.
Dialogue: 0,0:25:16.51,0:25:18.18,Default,,0,0,0,,Жоқ, жоқ, жұдырық!
Dialogue: 0,0:25:18.26,0:25:21.22,Default,,0,0,0,,Мен Аоимен Шинноның қайтып келетіні туралы сөйлестім.
Dialogue: 0,0:25:21.31,0:25:24.02,Default,,0,0,0,,Иә? Ақан, бірдеңе дедіңіз бе?
Dialogue: 0,0:25:24.10,0:25:24.89,Default,,0,0,0,,Жоқ
Dialogue: 0,0:25:24.98,0:25:26.39,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:26.48,0:25:29.11,Default,,0,0,0,,Екеуіңнің қарым-қатынастарың осындай ма?
Dialogue: 0,0:25:29.19,0:25:29.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:29.94,0:25:32.28,Default,,0,0,0,,Ал, мен мұны сіздің қиялыңызға қалдырамын.
Dialogue: 0,0:25:32.36,0:25:34.11,Default,,0,0,0,,Күте тұрыңыз... мичинко
Dialogue: 0,0:25:34.19,0:25:34.74,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:25:34.82,0:25:36.95,Default,,0,0,0,,Ka~ Спирттің дәмі нашар.
Dialogue: 0,0:25:37.03,0:25:38.07,Default,,0,0,0,,Қымбат толтыру!
Dialogue: 0,0:25:38.16,0:25:39.62,Default,,0,0,0,,А, ет де сал.
Dialogue: 0,0:25:40.41,0:25:41.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:25:42.33,0:25:46.04,Default,,0,0,0,,Сіз бұл жерден кете алмаймын дейсіз бе? Бұл тірі рухтан гөрі жердегі рух па?
Dialogue: 0,0:25:46.12,0:25:49.08,Default,,0,0,0,,Соны біле тұра мен қатты қозғалдым...
Dialogue: 0,0:25:50.88,0:25:52.96,Default,,0,0,0,,Тілегім орындалады деп сенемін.
Dialogue: 0,0:25:53.05,0:25:54.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:55.59,0:25:57.68,Default,,0,0,0,,Осы кезде мен ойладым
Dialogue: 0,0:25:57.76,0:26:02.89,Default,,0,0,0,,Оқуды ерте бітір, Токиодан ерте кет, тез болашаққа айнал
Dialogue: 0,0:26:02.97,0:26:05.68,Default,,0,0,0,,Мен тезірек Ақанені алып кеткім келеді.
Dialogue: 0,0:26:07.02,0:26:10.27,Default,,0,0,0,,Ол күннің тез келуі мүмкін емес.
Dialogue: 0,0:26:10.77,0:26:14.28,Default,,0,0,0,,Сондықтан мен шын мәнінде тірі рух болсам да.
Dialogue: 0,0:26:14.36,0:26:16.11,Default,,0,0,0,,Бұл кек емес.
Dialogue: 0,0:26:16.61,0:26:17.61,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:26:18.11,0:26:20.57,Default,,0,0,0,,Қалай болғанда да, мен түсінбеймін.
Dialogue: 0,0:26:20.66,0:26:22.53,Default,,0,0,0,,Мен бір нәрсені білемін!
Dialogue: 0,0:26:22.62,0:26:25.37,Default,,0,0,0,,Келешек Ақан екеуміз қосылсақ
Dialogue: 0,0:26:25.45,0:26:27.16,Default,,0,0,0,,Барлығы тамаша сәйкес келеді, солай ма?
Dialogue: 0,0:26:27.79,0:26:31.79,Default,,0,0,0,,Содан мен тірі рух ретінде денеме қағылып оралдым.
Dialogue: 0,0:26:31.88,0:26:33.25,Default,,0,0,0,,Хмм.
Dialogue: 0,0:26:33.84,0:26:35.88,Default,,0,0,0,,Соны сұрадым, көз алмасы
Dialogue: 0,0:26:37.97,0:26:38.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:40.39,0:26:42.68,Default,,0,0,0,,Сіз әрқашан осылай болдыңыз ба?
Dialogue: 0,0:26:42.76,0:26:45.22,Default,,0,0,0,,Хмм... мүмкін.
Dialogue: 0,0:26:45.72,0:26:48.23,Default,,0,0,0,,Ол ересек адамға ұқсайды.
Dialogue: 0,0:26:48.73,0:26:50.23,Default,,0,0,0,,- (Масацугу) Не істеуіміз керек? -иә?
Dialogue: 0,0:26:50.81,0:26:54.82,Default,,0,0,0,,Синно-сан айтқандай, сен бізге екеуін біріктіруге көмектесесің бе?
Dialogue: 0,0:26:55.57,0:26:57.49,Default,,0,0,0,,Мүмкін соншалықты жаман емес шығар
Dialogue: 0,0:26:57.57,0:26:58.70,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:26:58.78,0:27:01.36,Default,,0,0,0,,Менің әпкем маған...
Dialogue: 0,0:27:03.78,0:27:06.70,Default,,0,0,0,,Бұл жерде байланғанның орнына...
Dialogue: 0,0:27:08.66,0:27:11.21,Default,,0,0,0,,Жүр, кештен кейінгі кешке барайық.
Dialogue: 0,0:27:12.25,0:27:13.50,Default,,0,0,0,,Иә, қазір.
Dialogue: 0,0:27:13.59,0:27:17.13,Default,,0,0,0,,Жүр, Шинноске, құсқың келсе, дәретханаға бар.
Dialogue: 0,0:27:17.67,0:27:20.59,Default,,0,0,0,,А-а, енді жақсы емес.
Dialogue: 0,0:27:20.68,0:27:21.59,Default,,0,0,0,,Хмм.
Dialogue: 0,0:27:21.68,0:27:23.22,Default,,0,0,0,,Рам-чи, сен қорқыныштысың!
Dialogue: 0,0:27:23.30,0:27:25.72,Default,,0,0,0,,Мен ішкен жоқпын, сондықтан көлікті шығарып салайын.
Dialogue: 0,0:27:25.81,0:27:26.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:26.64,0:27:29.98,Default,,0,0,0,,Масамичи-сан, келесі жолы мен қыздармен дүкенге барғым келеді.
Dialogue: 0,0:27:30.06,0:27:31.85,Default,,0,0,0,,Жергілікті сұлулық
Dialogue: 0,0:27:32.56,0:27:33.56,Default,,0,0,0,,Иә...
Dialogue: 0,0:27:33.65,0:27:34.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:36.07,0:27:40.07,Default,,0,0,0,,(Көлікте ойнайтын музыка)
Dialogue: 0,0:27:49.95,0:27:51.83,Default,,0,0,0,,«Гандхара»?
Dialogue: 0,0:27:53.92,0:27:54.71,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:27:56.88,0:28:01.09,Default,,0,0,0,,Менің арманым орындалды деп ойлаймын.
Dialogue: 0,0:28:01.59,0:28:03.76,Default,,0,0,0,,Бұл шынымен де орындалды.
Dialogue: 0,0:28:04.72,0:28:06.60,Default,,0,0,0,,Сен мені мазақ етіп тұрсың.
Dialogue: 0,0:28:06.68,0:28:11.81,Default,,0,0,0,,Синно маскүнемдікпен осындай жаман істерді жасайтын адам болатын.
Dialogue: 0,0:28:12.56,0:28:15.02,Default,,0,0,0,,Сіз бойдақсыз ба?
Dialogue: 0,0:28:15.56,0:28:17.44,Default,,0,0,0,,Мені күтпедің бе?
Dialogue: 0,0:28:18.53,0:28:21.32,Default,,0,0,0,,Хмм, күткен сияқтымын.
Dialogue: 0,0:28:22.20,0:28:24.86,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:28:27.70,0:28:29.33,Default,,0,0,0,,(Есікті қағады)
Dialogue: 0,0:28:29.41,0:28:31.08,Default,,0,0,0,,Қараңдар, біз келдік.
Dialogue: 0,0:28:31.91,0:28:34.00,Default,,0,0,0,,Абайлап жүріп, қазір су әкел...
Dialogue: 0,0:28:34.08,0:28:36.84,Default,,0,0,0,,Тағы ішейік, Айои мырза.
Dialogue: 0,0:28:37.42,0:28:39.63,Default,,0,0,0,,Мен ақымақ ештеңе айтқан жоқпын.
Dialogue: 0,0:28:40.26,0:28:41.30,Default,,0,0,0,,Эй
Dialogue: 0,0:28:41.38,0:28:42.34,Default,,0,0,0,,Аа...
Dialogue: 0,0:28:42.84,0:28:43.34,Default,,0,0,0,,Хмм
Dialogue: 0,0:28:45.01,0:28:46.18,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:28:46.76,0:28:50.85,Default,,0,0,0,,Дұрыс, бұл жаста ысырап.
Dialogue: 0,0:28:50.93,0:28:52.56,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:28:53.35,0:28:55.52,Default,,0,0,0,,Жақсы, ол азаймайды.
Dialogue: 0,0:28:56.40,0:28:59.86,Default,,0,0,0,,13 жылдан кейін қайта кездескенде айтатын жолыңыз осы ма?
Dialogue: 0,0:29:01.94,0:29:03.49,Default,,0,0,0,,Мені ренжітпе
Dialogue: 0,0:29:09.41,0:29:13.12,Default,,0,0,0,,Мен тіпті келмедім.
Dialogue: 0,0:29:14.16,0:29:17.88,Default,,0,0,0,,Менің бұлай келмеуім керек еді.
Dialogue: 0,0:29:18.38,0:29:19.67,Default,,0,0,0,,(Есікті қағады)
Dialogue: 0,0:29:19.75,0:29:22.71,Default,,0,0,0,,Дәл қазір Аои
Dialogue: 0,0:29:22.80,0:29:24.92,Default,,0,0,0,,Қош келдіңіз, тез болдыңыз.
Dialogue: 0,0:29:25.01,0:29:26.01,Default,,0,0,0,,Э~?
Dialogue: 0,0:29:26.59,0:29:29.72,Default,,0,0,0,,Мен ойын-сауыққа соңына дейін жете алмаймын.
Dialogue: 0,0:29:29.80,0:29:33.56,Default,,0,0,0,,Бүгін шомылмай ұйықтайық.
Dialogue: 0,0:29:33.64,0:29:34.85,Default,,0,0,0,,Хмм.
Dialogue: 0,0:29:35.35,0:29:37.77,Default,,0,0,0,,Әй, бүгін бірге жатайық па?
Dialogue: 0,0:29:37.85,0:29:38.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:38.65,0:29:41.11,Default,,0,0,0,,Жарайды, біраз уақыт өтті.
Dialogue: 0,0:29:47.66,0:29:49.57,Default,,0,0,0,,-Эй -Хмм?
Dialogue: 0,0:29:49.66,0:29:52.45,Default,,0,0,0,,Синносуке Канемуро туралы айтып беріңізші
Dialogue: 0,0:29:52.54,0:29:54.91,Default,,0,0,0,,Хмм, жай ғана мас па?
Dialogue: 0,0:29:55.00,0:29:57.62,Default,,0,0,0,,Қазір емес, өткенде.
Dialogue: 0,0:29:58.12,0:30:01.04,Default,,0,0,0,,Бұл өте ұзақ уақыт болды, мен ұмытып кеттім.
Dialogue: 0,0:30:01.54,0:30:03.76,Default,,0,0,0,,Кішкентай апаның есте сақтау қабілеті нашар.
Dialogue: 0,0:30:06.55,0:30:10.22,Default,,0,0,0,,Бірақ менің кішкентай әпкемнің жігіті болмағанына көп болды.
Dialogue: 0,0:30:11.18,0:30:14.31,Default,,0,0,0,,Оның белгілі бір мөлшері болды.
Dialogue: 0,0:30:15.56,0:30:17.31,Default,,0,0,0,,Не? Өтірік!
Dialogue: 0,0:30:17.39,0:30:20.19,Default,,0,0,0,,Сіз мүлде ондай емес едіңіз. Неге үндемедің?
Dialogue: 0,0:30:20.27,0:30:24.61,Default,,0,0,0,,Ahaha, what is it? Аои Ака-ниге қатты ғашық.
Dialogue: 0,0:30:24.69,0:30:25.49,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:30:25.57,0:30:28.03,Default,,0,0,0,,-What is that! -хехехе
Dialogue: 0,0:30:28.11,0:30:29.20,Default,,0,0,0,,Мен енді білмеймін!
Dialogue: 0,0:30:33.45,0:30:34.45,Default,,0,0,0,,～
Dialogue: 0,0:30:40.17,0:30:42.38,Default,,0,0,0,,Хмм...хехе
Dialogue: 0,0:30:43.50,0:30:44.67,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:30:45.17,0:30:48.55,Default,,0,0,0,,Бірақ бұл шынымен де жақсы болды ма? сіздің түскі асыңыз
Dialogue: 0,0:30:48.63,0:30:50.72,Default,,0,0,0,,Мен кейінірек ыңғайлы дүкенге тоқтаймын.
Dialogue: 0,0:30:50.80,0:30:53.10,Default,,0,0,0,,Шынымен бе? Жарайды онда
Dialogue: 0,0:30:55.35,0:30:56.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:56.10,0:30:59.94,Default,,0,0,0,,Жоқ... Менің қарным ашты деп ойлаймын.
Dialogue: 0,0:31:00.44,0:31:02.27,Default,,0,0,0,,Мен оны жинап жатқан сияқты емеспін.
Dialogue: 0,0:31:02.36,0:31:03.73,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:31:03.82,0:31:05.82,Default,,0,0,0,,Бәрібір қызықсыз.
Dialogue: 0,0:31:05.90,0:31:06.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:06.69,0:31:08.86,Default,,0,0,0,,Гитара Анжан Бос уақытыңыз болса...
Dialogue: 0,0:31:08.95,0:31:10.99,Default,,0,0,0,,Мм, жіптер тот басқан
Dialogue: 0,0:31:11.07,0:31:13.32,Default,,0,0,0,,Мен сатып алайын ба? With nickel...
Dialogue: 0,0:31:13.41,0:31:14.78,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:31:18.12,0:31:19.37,Default,,0,0,0,,Күтілгендей, жоқ.
Dialogue: 0,0:31:19.46,0:31:21.50,Default,,0,0,0,,Әй, айтпақшы, неге маған «Секір» сатып алмайсың?
Dialogue: 0,0:31:21.58,0:31:24.42,Default,,0,0,0,,«Кочикамені» оқымасам, үлгере алмаймын.
Dialogue: 0,0:31:24.50,0:31:26.25,Default,,0,0,0,,«Кочикаме» аяқталды
Dialogue: 0,0:31:26.34,0:31:28.72,Default,,0,0,0,,Иә? «Кочикаме» бітпейді!
Dialogue: 0,0:31:28.80,0:31:31.34,Default,,0,0,0,,Рио-сан, егер ол жоғалып кетсе, Мәңгілік деген не?
Dialogue: 0,0:31:31.43,0:31:32.97,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:31:33.05,0:31:34.10,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:31:34.18,0:31:36.60,Default,,0,0,0,,Рё-сан, сен кіммен біттің? Жоқ, мен мұны тыңдамаймын.
Dialogue: 0,0:31:36.68,0:31:39.52,Default,,0,0,0,,Мен шынымен де қобалжымаймын.
Dialogue: 0,0:31:45.69,0:31:46.32,Default,,0,0,0,,Ах
Dialogue: 0,0:31:46.90,0:31:49.28,Default,,0,0,0,,Не? Бұл Цугу емес, Мичинко ма?
Dialogue: 0,0:31:49.86,0:31:52.03,Default,,0,0,0,,Бұрын осылай болған ба?
Dialogue: 0,0:31:52.11,0:31:54.45,Default,,0,0,0,,Сондықтан Синно «миниатюра» дейді.
Dialogue: 0,0:31:56.87,0:31:58.29,Default,,0,0,0,,Ака-ни…
Dialogue: 0,0:31:59.95,0:32:02.96,Default,,0,0,0,,Біз бір сыныпта оқыдық
Dialogue: 0,0:32:10.01,0:32:13.30,Default,,0,0,0,,Ой, бастауыш сынып оқушылары?
Dialogue: 0,0:32:13.38,0:32:15.14,Default,,0,0,0,,Менің әпкем...
Dialogue: 0,0:32:17.76,0:32:20.39,Default,,0,0,0,,Маған ұқсас нәрсе...
Dialogue: 0,0:32:28.52,0:32:33.45,Default,,0,0,0,,«Бірақ сен аспанның қандай көгілдір екенін білесің бе?»
Dialogue: 0,0:32:34.03,0:32:36.03,Default,,0,0,0,,- (Бала) Айой - А?
Dialogue: 0,0:32:36.12,0:32:39.20,Default,,0,0,0,,Эй, бәлкім, қайта қарау керек шығар?
Dialogue: 0,0:32:39.70,0:32:40.66,Default,,0,0,0,,Менің тобымда...
Dialogue: 0,0:32:40.75,0:32:42.54,Default,,0,0,0,,Сіз өзіңізден де нашар адаммен бірігіп алсаңыз да
Dialogue: 0,0:32:42.62,0:32:44.25,Default,,0,0,0,,Өйткені бұл бос уақыт
Dialogue: 0,0:32:44.75,0:32:46.50,Default,,0,0,0,,ұсқынсыз
Dialogue: 0,0:32:46.58,0:32:49.13,Default,,0,0,0,,Әлгі жігіттің аузы жаман екен.
Dialogue: 0,0:32:49.21,0:32:51.84,Default,,0,0,0,,- (Чика) Не деген ысырап - А?
Dialogue: 0,0:32:51.92,0:32:56.14,Default,,0,0,0,,Топтағы жалғыз ерлер тобы болу өте дәмді.
Dialogue: 0,0:32:56.22,0:33:00.14,Default,,0,0,0,,А, бірақ бұған уақытыңыз жеткілікті ме?
Dialogue: 0,0:33:00.22,0:33:05.02,Default,,0,0,0,,Сіз Токиоға барасыз, себебі ол жерде үлкен кісі бар, солай ма?
Dialogue: 0,0:33:05.10,0:33:06.27,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:33:06.35,0:33:07.98,Default,,0,0,0,,Бұл қауесет
Dialogue: 0,0:33:08.06,0:33:11.23,Default,,0,0,0,,Оның айтуынша, оны әрқашан ер адам көлігімен алып кетеді.
Dialogue: 0,0:33:11.32,0:33:14.32,Default,,0,0,0,,Эй, мені жігітіңнің досымен таныстыршы.
Dialogue: 0,0:33:14.40,0:33:17.37,Default,,0,0,0,,Мәселе туындаса да, мен сізді сотқа бермеймін.
Dialogue: 0,0:33:17.45,0:33:18.74,Default,,0,0,0,,(Аоидың күрсінуі)
Dialogue: 0,0:33:18.83,0:33:19.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:20.33,0:33:22.95,Default,,0,0,0,,Ендеше, қазір танысуды бастайық па?
Dialogue: 0,0:33:23.04,0:33:24.41,Default,,0,0,0,,Кэш
Dialogue: 0,0:33:25.75,0:33:28.54,Default,,0,0,0,,Ал, енді сахна бюджеті туралы...
Dialogue: 0,0:33:28.63,0:33:29.46,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:33:29.54,0:33:32.84,Default,,0,0,0,,Бұл «Нитобе мырзаның жергілікті махаббатты түсінуге арналған бюджеті» қандай?
Dialogue: 0,0:33:32.92,0:33:34.05,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:33:34.13,0:33:36.34,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:33:37.97,0:33:38.80,Default,,0,0,0,,Бұл...
Dialogue: 0,0:33:39.80,0:33:41.72,Default,,0,0,0,,Осыны ескере отырып...
Dialogue: 0,0:33:41.81,0:33:45.27,Default,,0,0,0,,Әй, бұл қырылған мұзымен әйгілі.
Dialogue: 0,0:33:45.85,0:33:48.52,Default,,0,0,0,,Е, 18 000 қырылған мұз...
Dialogue: 0,0:33:48.60,0:33:51.73,Default,,0,0,0,,Кез келген нәрсе, егер сіз барлық талғамды жеңе алмасаңыз.
Dialogue: 0,0:33:51.82,0:33:54.53,Default,,0,0,0,,Дүкеншінің рухын қабылдай алмасаң
Dialogue: 0,0:33:54.61,0:33:56.86,Default,,0,0,0,,Менің ойымша, сіз бас тартуыңыз керек.
Dialogue: 0,0:33:56.95,0:33:58.45,Default,,0,0,0,,Ах Нагаторо
Dialogue: 0,0:33:58.53,0:34:00.45,Default,,0,0,0,,Сызықтың қиылысуы?
Dialogue: 0,0:34:00.53,0:34:02.87,Default,,0,0,0,,Түскі асқа Мисо шошқа еті мен жаңғақ кеспесі
Dialogue: 0,0:34:02.95,0:34:04.75,Default,,0,0,0,,Сіз қанша жейсіз?
Dialogue: 0,0:34:07.08,0:34:08.50,Default,,0,0,0,,- (Масамичи) Акане! -иә?
Dialogue: 0,0:34:08.58,0:34:11.25,Default,,0,0,0,,А... а...
Dialogue: 0,0:34:12.05,0:34:13.34,Default,,0,0,0,,Не?
Dialogue: 0,0:34:13.84,0:34:16.51,Default,,0,0,0,,Сіз ашуланған шығарсыз.
Dialogue: 0,0:34:17.01,0:34:19.51,Default,,0,0,0,,Ашуланбаған дұрыс емес пе?
Dialogue: 0,0:34:21.55,0:34:22.85,Default,,0,0,0,,Мен айтқанымдай
Dialogue: 0,0:34:22.93,0:34:25.22,Default,,0,0,0,,Мен Нитобе мырзаға ұсыныс жасамақ болғанымда,
Dialogue: 0,0:34:25.31,0:34:28.81,Default,,0,0,0,,Оны кездейсоқ тауып алғаным рас.
Dialogue: 0,0:34:29.31,0:34:32.86,Default,,0,0,0,,Бірақ бір рет шешпесеңіз
Dialogue: 0,0:34:32.94,0:34:36.03,Default,,0,0,0,,Мен өзімді осы уақыт бойы Шинносукеге байлап қойғандай сезінемін.
Dialogue: 0,0:34:36.11,0:34:39.03,Default,,0,0,0,,-Ол үшін уайымдама - (Масамичи) А... Хм...
Dialogue: 0,0:34:39.11,0:34:41.57,Default,,0,0,0,,Менің тәуелсіздігіме соншалықты күмәнданасыз ба?
Dialogue: 0,0:34:42.16,0:34:44.37,Default,,0,0,0,,Мен де адаммын.
Dialogue: 0,0:34:44.45,0:34:48.29,Default,,0,0,0,,Менің өмірім осы уақытқа дейін өз таңдауларым мен шешімдерім болды.
Dialogue: 0,0:34:50.00,0:34:53.84,Default,,0,0,0,,Ешкімге ерік бермеймін.
Dialogue: 0,0:34:57.63,0:35:00.59,Default,,0,0,0,,Айойдың жігіті шынымен жұмыс істей ме?
Dialogue: 0,0:35:01.09,0:35:03.81,Default,,0,0,0,,Студент достарың бар ма? Жоқ, жұмыс істейтіндер де...
Dialogue: 0,0:35:03.89,0:35:08.73,Default,,0,0,0,,Мен оқиғаны түсінбеймін, бірақ мен бұл ысырапты жақсы сезінемін ...
Dialogue: 0,0:35:10.06,0:35:11.94,Default,,0,0,0,,Мичинкоға ұқсайды ма?
Dialogue: 0,0:35:12.02,0:35:13.56,Default,,0,0,0,,
Dialogue: 0,0:35:13.65,0:35:15.48,Default,,0,0,0,,А, келдің бе?
Dialogue: 0,0:35:16.15,0:35:18.74,Default,,0,0,0,,Иә? Достар?
Dialogue: 0,0:35:18.82,0:35:20.11,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:35:20.20,0:35:22.16,Default,,0,0,0,,Ах... Эй... Сәлем~
Dialogue: 0,0:35:22.24,0:35:23.87,Default,,0,0,0,,Ах
Dialogue: 0,0:35:23.95,0:35:27.50,Default,,0,0,0,,-Қарашы, сен еркек емессің ғой? -(Чика) Уау~
Dialogue: 0,0:35:27.58,0:35:30.00,Default,,0,0,0,,Иә? Сізді бұғы қағып кетті ме?
Dialogue: 0,0:35:30.67,0:35:32.96,Default,,0,0,0,,Иә? Бұғыға ма?
Dialogue: 0,0:35:33.33,0:35:34.13,Default,,0,0,0,,Иә
Dialogue: 0,0:35:34.21,0:35:36.96,Default,,0,0,0,,Баста Ито мырза және барабанда Кодама мырза
Dialogue: 0,0:35:37.05,0:35:38.30,Default,,0,0,0,,Мені бірдеңе соқты...
Dialogue: 0,0:35:38.38,0:35:39.55,Default,,0,0,0,,Иә...
Dialogue: 0,0:35:39.63,0:35:42.64,Default,,0,0,0,,-Тамаша болды -(Негіз) Өкінбеймін.
Dialogue: 0,0:35:42.72,0:35:44.01,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:35:44.10,0:35:45.97,Default,,0,0,0,,Сіз маған дұрыстап пісіріңіз дедіңіз ғой, солай ма?
Dialogue: 0,0:35:46.06,0:35:47.89,Default,,0,0,0,,Күте тұрсаң, мына жігіт сені жеп қояды!
Dialogue: 0,0:35:47.97,0:35:49.18,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:35:49.27,0:35:52.65,Default,,0,0,0,,Уау, рок! Мен өзімді музыкант сияқты сезінемін
Dialogue: 0,0:35:52.73,0:35:54.31,Default,,0,0,0,,Хмм?
Dialogue: 0,0:35:54.40,0:35:56.77,Default,,0,0,0,,Нақты өнімділік қиын ба?
Dialogue: 0,0:35:56.86,0:35:59.44,Default,,0,0,0,,Менде бәрібір дыбыс көзі бар.
Dialogue: 0,0:35:59.53,0:36:01.90,Default,,0,0,0,,Ең сорақысы, тіпті жанды дыбыс болмаса да...
Dialogue: 0,0:36:01.99,0:36:05.32,Default,,0,0,0,,Қабылданбады~ Қабылданбады♪
Dialogue: 0,0:36:05.41,0:36:07.03,Default,,0,0,0,,Нитобе мырза?
Dialogue: 0,0:36:07.12,0:36:10.12,Default,,0,0,0,,Дыбыс – тірі зат, ол – тіршілік.
Dialogue: 0,0:36:10.20,0:36:13.88,Default,,0,0,0,,Жанды музыкасыз энканың жүрегін айта алмайсың.
Dialogue: 0,0:36:13.96,0:36:15.42,Default,,0,0,0,,Бұл Нитобе Данкичи
Dialogue: 0,0:36:15.50,0:36:17.80,Default,,0,0,0,,Тек фонда караокемен ән айту
Dialogue: 0,0:36:17.88,0:36:19.42,Default,,0,0,0,,Көше баласы болғаным үшін кешірім сұраймын.
Dialogue: 0,0:36:19.51,0:36:20.76,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:36:20.84,0:36:24.18,Default,,0,0,0,,Егер сіз қазірден бастап жаңа адам іздесеңіз...
Dialogue: 0,0:36:24.68,0:36:25.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:26.30,0:36:29.31,Default,,0,0,0,,Барабан мен бассқа не жетіспейді, солай ма?
Dialogue: 0,0:36:29.39,0:36:30.64,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:36:30.73,0:36:34.52,Default,,0,0,0,,Міне, сіз! Барабаншы мен бас гитараға арналған
Dialogue: 0,0:36:35.06,0:36:36.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:36.11,0:36:37.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:38.19,0:36:40.03,Default,,0,0,0,,Мен оны… қолданамын деп ойламаған едім
Dialogue: 0,0:36:40.11,0:36:43.36,Default,,0,0,0,,Жоғары сынып оқушысы мен қалалық әкімдіктің адамы алмастырады.
Dialogue: 0,0:36:43.45,0:36:44.61,Default,,0,0,0,,Қызықты көрінеді.
Dialogue: 0,0:36:44.70,0:36:45.78,Default,,0,0,0,,Жоқ, мүмкін емес.
Dialogue: 0,0:36:45.87,0:36:48.87,Default,,0,0,0,,Бірақ Нитөбе мырзаның көңіл-күйі жақсы.
Dialogue: 0,0:36:48.95,0:36:51.00,Default,,0,0,0,,Мен әлі үкімет кеңсесіне өзім барып түсіндіремін.
Dialogue: 0,0:36:51.08,0:36:55.54,Default,,0,0,0,,Ах~ Неліктен бұл болып жатыр...
Dialogue: 0,0:36:55.63,0:36:58.00,Default,,0,0,0,,Мен балалар ойынымен араласқым келмейді.
Dialogue: 0,0:36:58.09,0:37:00.80,Default,,0,0,0,,Мұны кәсіпқойлар жасайды.
Dialogue: 0,0:37:01.96,0:37:04.26,Default,,0,0,0,,Сіз шоудың жұлдызы екеніңізді айттыңыз.
Dialogue: 0,0:37:04.76,0:37:05.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:07.35,0:37:10.31,Default,,0,0,0,,Көрейік бұл жай ғана көңіл көтеру үшін.
Dialogue: 0,0:37:10.39,0:37:12.31,Default,,0,0,0,,Ой Аой
Dialogue: 0,0:37:12.39,0:37:15.10,Default,,0,0,0,,Жақсы идея!
Dialogue: 0,0:37:15.90,0:37:18.56,Default,,0,0,0,,Маған көруге рұқсат етіңіз.
Dialogue: 0,0:37:23.61,0:37:26.70,Default,,0,0,0,,(бассты реттеу дыбысы)
Dialogue: 0,0:37:28.49,0:37:31.37,Default,,0,0,0,,Уау~ Ахаха
Dialogue: 0,0:37:38.75,0:37:40.29,Default,,0,0,0,,Мичинко
Dialogue: 0,0:37:40.38,0:37:41.63,Default,,0,0,0,,Хаа…
Dialogue: 0,0:37:44.51,0:37:45.51,Default,,0,0,0,,
Dialogue: 0,0:37:45.59,0:37:50.89,Default,,0,0,0,,(Күшті басс өнімділігі)
Dialogue: 0,0:37:50.97,0:37:53.43,Default,,0,0,0,,♪ Онда барсаңыз
Dialogue: 0,0:37:53.52,0:37:56.48,Default,,0,0,0,,♪ Кез келген арман
Dialogue: 0,0:37:56.56,0:38:00.86,Default,,0,0,0,,♪ Бұл орындалады
Dialogue: 0,0:38:01.86,0:38:06.86,Default,,0,0,0,,♪ Барлығы барғысы келеді
Dialogue: 0,0:38:07.45,0:38:09.20,Default,,0,0,0,,О, Умина
Dialogue: 0,0:38:09.28,0:38:10.74,Default,,0,0,0,,Иә, мен мұны істеймін.
Dialogue: 0,0:38:10.83,0:38:12.16,Default,,0,0,0,,Бірақ неге «Гандхара»?
Dialogue: 0,0:38:12.24,0:38:15.08,Default,,0,0,0,,♪ Елдің аты – Гандхара.
Dialogue: 0,0:38:15.66,0:38:17.58,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:38:17.67,0:38:20.29,Default,,0,0,0,,♪ Ол жаққа қалай баруға болады?
Dialogue: 0,0:38:20.38,0:38:24.30,Default,,0,0,0,,♪ Маған айтқаныңызды қалаймын.
Dialogue: 0,0:38:24.38,0:38:26.01,Default,,0,0,0,,♪ Гандхара, Гандхара
Dialogue: 0,0:38:26.09,0:38:29.84,Default,,0,0,0,,Керемет Мен спектакльге деген сүйіспеншілікті сезінемін
Dialogue: 0,0:38:29.93,0:38:33.22,Default,,0,0,0,,Бұл фестивальдің басты ерекшелігі болады.
Dialogue: 0,0:38:33.31,0:38:34.93,Default,,0,0,0,,♪ Гандхара
Dialogue: 0,0:38:35.02,0:38:37.48,Default,,0,0,0,,♪ Гандхара, Гандхара
Dialogue: 0,0:38:37.56,0:38:44.11,Default,,0,0,0,,♪ Гандхара, махаббат елі
Dialogue: 0,0:38:50.53,0:38:53.78,Default,,0,0,0,,Уау! Бұл керемет Ао!
Dialogue: 0,0:38:53.87,0:38:57.33,Default,,0,0,0,,Сіз бұл жаста қалай кәсіби бэк-топтың мүшесі бола аласыз?
Dialogue: 0,0:38:57.41,0:38:59.92,Default,,0,0,0,,Бұл жай ғана болады.
Dialogue: 0,0:39:00.00,0:39:01.42,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:39:01.50,0:39:03.63,Default,,0,0,0,,Ао-чан негізгі дененің жанында болса
Dialogue: 0,0:39:03.71,0:39:06.92,Default,,0,0,0,,Ака-нидің нақты адаммен кездесу мүмкіндігі көбірек болады.
Dialogue: 0,0:39:07.01,0:39:11.05,Default,,0,0,0,,О! Екеумізді жақындастыруға мүмкіндік туды.
Dialogue: 0,0:39:11.14,0:39:14.76,Default,,0,0,0,,Бірақ мұны шынымен жасауға бола ма?
Dialogue: 0,0:39:15.60,0:39:17.81,Default,,0,0,0,,Кәсіби мамандармен...
Dialogue: 0,0:39:17.89,0:39:19.02,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:39:19.10,0:39:23.27,Default,,0,0,0,,Сен мен сияқты жұлдызсың.
Dialogue: 0,0:39:27.11,0:39:29.07,Default,,0,0,0,,Олай болса, жаттығу жасайық.
Dialogue: 0,0:39:29.15,0:39:30.40,Default,,0,0,0,,Сіз ұпай жинадыңыз ба?
Dialogue: 0,0:39:30.49,0:39:32.41,Default,,0,0,0,,Ах... иә
Dialogue: 0,0:39:32.49,0:39:36.66,Default,,0,0,0,,Эй, Аой, сен осындасың ба?
Dialogue: 0,0:39:38.58,0:39:39.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:40.58,0:39:41.37,Default,,0,0,0,,Увааах! Уф!
Dialogue: 0,0:39:41.46,0:39:43.38,Default,,0,0,0,,Иә? Бол... шынымен емес...
Dialogue: 0,0:39:43.46,0:39:45.09,Default,,0,0,0,,Менің қарындасыма не болды?
Dialogue: 0,0:39:45.17,0:39:48.26,Default,,0,0,0,,Ах... Мм...
Dialogue: 0,0:39:48.84,0:39:51.68,Default,,0,0,0,,Бүгін жынды болғаным үшін кешірім сұраймын.
Dialogue: 0,0:39:51.76,0:39:53.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:53.09,0:39:57.56,Default,,0,0,0,,Мен Аойдың үлкен сахнада тұрғанын елестеткенімде, мен жай ғана...
Dialogue: 0,0:39:58.64,0:40:00.98,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:40:01.06,0:40:05.48,Default,,0,0,0,,Ал... Мен оны асыға күтемін.
Dialogue: 0,0:40:06.94,0:40:07.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:40:07.82,0:40:10.44,Default,,0,0,0,,Әй, мына тәттіні де жеп қойшы.
Dialogue: 0,0:40:11.86,0:40:14.57,Default,,0,0,0,,Олай болса кешікпе.
Dialogue: 0,0:40:14.66,0:40:16.33,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:40:16.41,0:40:17.66,Default,,0,0,0,,Хаа~
Dialogue: 0,0:40:17.74,0:40:19.75,Default,,0,0,0,,Сіз оны жасырып үлгердіңіз.
Dialogue: 0,0:40:19.83,0:40:20.83,Default,,0,0,0,,Иә
Dialogue: 0,0:40:21.91,0:40:22.83,Default,,0,0,0,,Уау
Dialogue: 0,0:40:22.92,0:40:24.88,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:40:25.88,0:40:27.84,Default,,0,0,0,,Сен кәрі қаңбақ болып кеттің.
Dialogue: 0,0:40:27.92,0:40:29.26,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:40:31.09,0:40:33.68,Default,,0,0,0,,Ол сондай сүйкімді қарт
Dialogue: 0,0:40:34.72,0:40:37.43,Default,,0,0,0,,Үлгіден де, гравюрлік пұттан да артық
Dialogue: 0,0:40:37.51,0:40:40.85,Default,,0,0,0,,Ол сүйкімді әрі әдемі қарт қаңбақ.
Dialogue: 0,0:40:43.19,0:40:45.48,Default,,0,0,0,,Мм, жақсысың ба?
Dialogue: 0,0:40:46.27,0:40:47.90,Default,,0,0,0,,Нига!
Dialogue: 0,0:40:48.94,0:40:51.49,Default,,0,0,0,,Ақанға қиынырақ болса керек.
Dialogue: 0,0:40:51.57,0:40:52.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:52.86,0:40:55.07,Default,,0,0,0,,Мен үшін бүгін кеше
Dialogue: 0,0:40:55.57,0:40:57.49,Default,,0,0,0,,Ақанең көптен бері жалғыз
Dialogue: 0,0:40:58.41,0:41:01.95,Default,,0,0,0,,Ақанның да тезірек бақытты болғанын қалаймын.
Dialogue: 0,0:41:02.66,0:41:03.91,Default,,0,0,0,,Шинно…
Dialogue: 0,0:41:04.00,0:41:07.96,Default,,0,0,0,,Ах! ...Олай болса да, мен аздап қартайдым.
Dialogue: 0,0:41:08.04,0:41:10.59,Default,,0,0,0,,Менің ойымша, сіз гитарада жақсы ойнайсыз.
Dialogue: 0,0:41:10.67,0:41:12.59,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:41:12.67,0:41:13.76,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:41:13.84,0:41:15.93,Default,,0,0,0,,Саған суретке түсейін бе? Бейне
Dialogue: 0,0:41:16.01,0:41:17.97,Default,,0,0,0,,- Иә? -(Масацугу) Қазір
Dialogue: 0,0:41:18.05,0:41:21.31,Default,,0,0,0,,Сіз мұны істей алмайсыз ба? Бұл ақылсыз. Смартфон.
Dialogue: 0,0:41:21.39,0:41:23.48,Default,,0,0,0,,Бұл ойын да керемет болды.
Dialogue: 0,0:41:23.56,0:41:25.19,Default,,0,0,0,,Маған бір түнді қарызға беріңізші.
Dialogue: 0,0:41:25.27,0:41:26.31,Default,,0,0,0,,Әдетте мүмкін емес
Dialogue: 0,0:41:26.40,0:41:27.56,Default,,0,0,0,,Олай болса мен саған қарызға берейін бе?
Dialogue: 0,0:41:27.65,0:41:29.11,Default,,0,0,0,,- (Масацугу) А? - Жарайды ма?
Dialogue: 0,0:41:29.19,0:41:31.40,Default,,0,0,0,,Маңызды емес, шамамен бір күн.
Dialogue: 0,0:41:31.48,0:41:34.15,Default,,0,0,0,,Мені тек Ака-ни мен Цугу деп атайды.
Dialogue: 0,0:41:34.24,0:41:35.86,Default,,0,0,0,,Құпия сөз
Dialogue: 0,0:41:35.95,0:41:37.36,Default,,0,0,0,,Сәлем! Жеке ақпарат
Dialogue: 0,0:41:37.45,0:41:38.74,Default,,0,0,0,,Рахмет сізге Ао
Dialogue: 0,0:41:38.82,0:41:41.04,Default,,0,0,0,,Сен шынымен жақсы бала болып өстің.
Dialogue: 0,0:41:41.12,0:41:43.50,Default,,0,0,0,,Әй, басыңды абайсызда ұстама!
Dialogue: 0,0:41:43.58,0:41:47.12,Default,,0,0,0,,Хахахаха! Хехехе...
Dialogue: 0,0:41:47.21,0:41:47.71,Default,,0,0,0,,Эй?
Dialogue: 0,0:41:50.25,0:41:52.46,Default,,0,0,0,,Сіз шынымен суретке түскіңіз келе ме? Бейне
Dialogue: 0,0:41:52.55,0:41:53.71,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:41:54.63,0:41:58.39,Default,,0,0,0,,Егер сіз қазір өзіңізге қарасаңыз, көңіліңіз қалуы мүмкін.
Dialogue: 0,0:41:58.89,0:41:59.64,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:41:59.72,0:42:00.93,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:42:01.01,0:42:02.56,Default,,0,0,0,,Шинно ақымақ
Dialogue: 0,0:42:02.64,0:42:06.10,Default,,0,0,0,,Ол мейірімді және ешқашан адамдарды мазақ етпейді.
Dialogue: 0,0:42:06.19,0:42:07.77,Default,,0,0,0,,Және! Ах...
Dialogue: 0,0:42:10.90,0:42:11.94,Default,,0,0,0,,Не?
Dialogue: 0,0:42:12.69,0:42:14.28,Default,,0,0,0,,Бетцуни~
Dialogue: 0,0:42:21.74,0:42:24.75,Default,,0,0,0,,-да? Неге мұндасың?
Dialogue: 0,0:42:24.83,0:42:27.00,Default,,0,0,0,,Синносукенің бейнебаянын түсіресіз бе?
Dialogue: 0,0:42:27.08,0:42:29.29,Default,,0,0,0,,Маған қалдырыңыз, мен жақсымын.
Dialogue: 0,0:42:29.38,0:42:32.59,Default,,0,0,0,,Басқа үй жұмыстары мен менеджерге ұқсас тапсырмалар?
Dialogue: 0,0:42:32.67,0:42:35.80,Default,,0,0,0,,Мен келгенде ол сонда болды.
Dialogue: 0,0:42:35.88,0:42:38.63,Default,,0,0,0,,Ал, материалдар көп болса жақсы болмай ма?
Dialogue: 0,0:42:38.72,0:42:41.18,Default,,0,0,0,,Әңгімені түсіндің, кішкентай.
Dialogue: 0,0:42:41.26,0:42:42.60,Default,,0,0,0,,Қатты жақын қашықтықтағы шайқаста ол дерлік ешқандай осал тұс қалдырмайды—
Dialogue: 0,0:42:42.68,0:42:45.10,Default,,0,0,0,,Олай болса, жаттығуды бастау уақыты келді.
Dialogue: 0,0:42:45.18,0:42:46.93,Default,,0,0,0,,Құрметпен қарау
Dialogue: 0,0:42:47.02,0:42:47.77,Default,,0,0,0,,Иә
Dialogue: 0,0:42:47.85,0:42:54.86,Default,,0,0,0,,(«Чичибу Донто Койдан» шығу)
Dialogue: 0,0:42:58.11,0:42:59.78,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:42:59.86,0:43:03.95,Default,,0,0,0,,Хаха~ Шинносуке өте керемет.
Dialogue: 0,0:43:04.62,0:43:05.62,Default,,0,0,0,,Аа...
Dialogue: 0,0:43:06.12,0:43:07.58,Default,,0,0,0,,Уау~
Dialogue: 0,0:43:09.46,0:43:12.25,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? Аои-чан
Dialogue: 0,0:43:12.33,0:43:13.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:13.96,0:43:15.09,Default,,0,0,0,,Сіз басссыз, солай ма?
Dialogue: 0,0:43:15.17,0:43:17.88,Default,,0,0,0,,Сіз неге ерекшеленуге тырысасыз?
Dialogue: 0,0:43:17.97,0:43:19.76,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,0:43:19.84,0:43:21.39,Default,,0,0,0,,Хаха...
Dialogue: 0,0:43:21.47,0:43:23.76,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:43:23.85,0:43:28.89,Default,,0,0,0,,Менің ойымша, әйелдер бірінші кезекте бассты ойнауға жарамайды.
Dialogue: 0,0:43:29.39,0:43:30.06,Default,,0,0,0,,Ня Ао
Dialogue: 0,0:43:30.14,0:43:33.23,Default,,0,0,0,,Үлкен болсаң, сен менің бассың.
Dialogue: 0,0:43:33.73,0:43:34.61,Default,,0,0,0,,Қол және дене...
Dialogue: 0,0:43:34.69,0:43:36.61,Default,,0,0,0,,Сіз айттыңыз, солай ма?
Dialogue: 0,0:43:36.69,0:43:39.53,Default,,0,0,0,,Әділ, бірақ мен әуесқоймын.
Dialogue: 0,0:43:39.61,0:43:41.49,Default,,0,0,0,,Бұл бірінші рет, сондықтан біраз...
Dialogue: 0,0:43:41.57,0:43:45.49,Default,,0,0,0,,Мәселе, әуесқойлардың кәсіби әлемге мұрындарын қағуында.
Dialogue: 0,0:43:46.49,0:43:48.41,Default,,0,0,0,,Біріншіден, бұл Мичинко-сан.
Dialogue: 0,0:43:48.50,0:43:51.37,Default,,0,0,0,,Сенің іргең тартып қалғандықтан, осылай құлап қалдың.
Dialogue: 0,0:43:51.46,0:43:52.88,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:43:52.96,0:43:54.38,Default,,0,0,0,,Барабандар ырғақты сақтай білуі керек
Dialogue: 0,0:43:54.46,0:43:55.17,Default,,0,0,0,,Әңгімелейтін ештеңе жоқ...
Dialogue: 0,0:43:55.25,0:43:57.84,Default,,0,0,0,,Ах~ Шин-чан! сонда болды!
Dialogue: 0,0:43:57.92,0:43:59.30,Default,,0,0,0,,Уау, өте кең!
Dialogue: 0,0:43:59.38,0:44:01.01,Default,,0,0,0,,Сәлем, Эко-чан!
Dialogue: 0,0:44:01.09,0:44:01.88,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:44:01.97,0:44:04.22,Default,,0,0,0,,Мен келдім~ Шин Чан
Dialogue: 0,0:44:04.30,0:44:05.85,Default,,0,0,0,,Не? неге?
Dialogue: 0,0:44:05.93,0:44:07.64,Default,,0,0,0,,Мені алып кетуге келе жатқаныңызды естідім.
Dialogue: 0,0:44:07.72,0:44:10.68,Default,,0,0,0,,Дүкенге алдымен Нитөбе мырза барған сияқты.
Dialogue: 0,0:44:10.77,0:44:13.90,Default,,0,0,0,,Күтілгендей, кәсіпқойлар әртүрлі.
Dialogue: 0,0:44:13.98,0:44:14.98,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:44:15.06,0:44:17.44,Default,,0,0,0,,Жүр, Шин Чан, кеттік.
Dialogue: 0,0:44:17.52,0:44:19.86,Default,,0,0,0,,Шинносуке-сан мас болғанда жаман көрінеді.
Dialogue: 0,0:44:19.94,0:44:23.28,Default,,0,0,0,,Уау, сен жабайы типсің.
Dialogue: 0,0:44:23.36,0:44:25.12,Default,,0,0,0,,Бүгін аяқталды.
Dialogue: 0,0:44:25.20,0:44:26.24,Default,,0,0,0,,Иә
Dialogue: 0,0:44:27.74,0:44:29.29,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:44:29.37,0:44:32.75,Default,,0,0,0,,Бейнежазбаны Айои мырзаның смартфонына жібердім.
Dialogue: 0,0:44:32.83,0:44:34.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:34.92,0:44:35.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:37.92,0:44:41.09,Default,,0,0,0,,Қарғыс атқыр қария!
Dialogue: 0,0:44:41.17,0:44:42.38,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:44:42.47,0:44:45.26,Default,,0,0,0,,Мына лас қарт не?
Dialogue: 0,0:44:45.34,0:44:46.93,Default,,0,0,0,,Оның үстіне бұл хабаре клубы.
Dialogue: 0,0:44:47.60,0:44:50.02,Default,,0,0,0,,Мен бұлай Ақанеге тастай алмаймын.
Dialogue: 0,0:44:50.10,0:44:53.81,Default,,0,0,0,,Ақанмен кездеспей тұрып, өзімді қалпына келтіруім керек.
Dialogue: 0,0:44:55.85,0:44:57.69,Default,,0,0,0,,Бірақ жақсы...
Dialogue: 0,0:45:00.65,0:45:04.20,Default,,0,0,0,,Сіз шынымен кәсіпқой болдыңыз.
Dialogue: 0,0:45:05.28,0:45:07.74,Default,,0,0,0,,Чикшоу, анау бейбақ.
Dialogue: 0,0:45:08.24,0:45:11.20,Default,,0,0,0,,Сен соншалықты ақымақ болсаң да, салқын болуға тырысасың!
Dialogue: 0,0:45:11.29,0:45:12.08,Default,,0,0,0,,Дебесо?
Dialogue: 0,0:45:12.16,0:45:14.62,Default,,0,0,0,,Әй, қарашы?
Dialogue: 0,0:45:14.71,0:45:16.04,Default,,0,0,0,,Сіз оны маған көрсете аласыз.
Dialogue: 0,0:45:16.13,0:45:19.38,Default,,0,0,0,,Ал, ендігі кезек Аоға келді.
Dialogue: 0,0:45:19.46,0:45:20.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:20.17,0:45:22.05,Default,,0,0,0,,Қатты және қытырлақ ойнаңыз
Dialogue: 0,0:45:22.13,0:45:25.47,Default,,0,0,0,,Оның асқақтығын талқанда.
Dialogue: 0,0:45:26.68,0:45:30.89,Default,,0,0,0,,Сонымен... сіз мұны істей аласыз ба?
Dialogue: 0,0:45:30.97,0:45:33.06,Default,,0,0,0,,Сенің қолыңнан келетініне сенімдімін.
Dialogue: 0,0:45:33.14,0:45:35.14,Default,,0,0,0,,Сөзсіз сен
Dialogue: 0,0:45:35.23,0:45:37.48,Default,,0,0,0,,Дұрыс? көз алмасының жұлдызы
Dialogue: 0,0:45:37.56,0:45:38.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:40.65,0:45:42.65,Default,,0,0,0,,Иә... иә!
Dialogue: 0,0:45:42.73,0:45:45.03,Default,,0,0,0,,Жарайды, бірден жаттығу жасайық.
Dialogue: 0,0:45:45.61,0:45:46.70,Default,,0,0,0,,Метроном бар ма?
Dialogue: 0,0:45:46.78,0:45:49.66,Default,,0,0,0,,Егер бұл қолданба болса, ол сол смартфонда.
Dialogue: 0,0:45:49.74,0:45:52.62,Default,,0,0,0,,Басқа смартфон? Бұл шынымен таңқаларлық
Dialogue: 0,0:45:53.41,0:45:54.96,Default,,0,0,0,,Я~
Dialogue: 0,0:45:55.46,0:46:00.50,Default,,0,0,0,,Егер Шинно сол Шинносукеге оралса
Dialogue: 0,0:46:00.59,0:46:02.67,Default,,0,0,0,,Қазір не болып жатыр...
Dialogue: 0,0:46:02.76,0:46:06.59,Default,,0,0,0,,Орын қанша ретсіз болса да, негізі жақсы.
Dialogue: 0,0:46:06.68,0:46:08.30,Default,,0,0,0,,Ырғақты дұрыс сақтаңыз
Dialogue: 0,0:46:08.93,0:46:11.76,Default,,0,0,0,,Мен бәріне еруім керек сияқты.
Dialogue: 0,0:46:11.85,0:46:15.73,Default,,0,0,0,,Айналаңыздағы дыбыстарды тыңдаңыз, бірақ өз қарқыныңызды бұзбаңыз
Dialogue: 0,0:46:15.81,0:46:16.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:18.81,0:46:19.65,Default,,0,0,0,,Иә
Dialogue: 0,0:46:23.28,0:46:27.11,Default,,0,0,0,,Ех~ Шинносуке мырза, сіз осында емессіз бе?
Dialogue: 0,0:46:27.20,0:46:30.16,Default,,0,0,0,,Неге... нақты өнімділік осында дерлік.
Dialogue: 0,0:46:30.24,0:46:33.66,Default,,0,0,0,,Біріншіден, менде бүгін репетиция жоспарланған жоқ.
Dialogue: 0,0:46:33.74,0:46:39.00,Default,,0,0,0,,Сондай-ақ, әуесқойлармен бірге жаттығу жасасаңыз, шеберлігіңіз солғын болады.
Dialogue: 0,0:46:41.08,0:46:42.38,Default,,0,0,0,,Ер адамның аты – Ллойд Форджер
Dialogue: 0,0:46:43.17,0:46:45.92,Default,,0,0,0,,Адамдарды мазақ етуден қорықпа
Dialogue: 0,0:46:46.01,0:46:48.22,Default,,0,0,0,,Синнодан мүлде басқаша.
Dialogue: 0,0:46:48.30,0:46:49.76,Default,,0,0,0,,Бұлай не болуы мүмкін еді...
Dialogue: 0,0:46:49.84,0:46:50.76,Default,,0,0,0,,Шинно?
Dialogue: 0,0:46:50.84,0:46:54.01,Default,,0,0,0,,Ах, бұл Шинносукенің ескі лақап аты.
Dialogue: 0,0:46:54.10,0:46:54.77,Default,,0,0,0,,Я~
Dialogue: 0,0:46:54.85,0:46:56.06,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:46:56.14,0:46:58.69,Default,,0,0,0,,Шинно Синноске емес!
Dialogue: 0,0:46:59.44,0:47:00.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:00.81,0:47:04.44,Default,,0,0,0,,Накамура-сан! Мұнда бос орын бар.
Dialogue: 0,0:47:04.53,0:47:07.69,Default,,0,0,0,,О! Қарашы, Аой, жаттығу жасайық.
Dialogue: 0,0:47:07.78,0:47:12.07,Default,,0,0,0,,Біздің ырғақ бөлімі күшті болмаса, бастай алмаймыз.
Dialogue: 0,0:47:12.16,0:47:13.87,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:47:15.45,0:47:19.79,Default,,0,0,0,,Шинно мен Шинносуке... екеуі де жақсы.
Dialogue: 0,0:47:19.87,0:47:22.42,Default,,0,0,0,,Егер сіз ол жерде болмасаңыз, онда бәрі жақсы.
Dialogue: 0,0:47:26.55,0:47:28.34,Default,,0,0,0,,Гитараның солосы керемет болды.
Dialogue: 0,0:47:28.42,0:47:30.05,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:47:30.13,0:47:30.93,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:47:31.01,0:47:32.18,Default,,0,0,0,,Жоқ, бұл мен үшін мүмкін емес.
Dialogue: 0,0:47:54.66,0:47:56.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:57.37,0:47:59.00,Default,,0,0,0,,Хакен!
Dialogue: 0,0:47:59.08,0:48:02.00,Default,,0,0,0,,(«Чичибу Донто Койдан» шығу)
Dialogue: 0,0:48:04.96,0:48:07.25,Default,,0,0,0,,(соңғы ескерту)
Dialogue: 0,0:48:09.26,0:48:10.38,Default,,0,0,0,,Жарайды
Dialogue: 0,0:48:11.63,0:48:12.72,Default,,0,0,0,,Ал, тағы бір рет
Dialogue: 0,0:48:12.80,0:48:14.64,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:48:14.72,0:48:17.06,Default,,0,0,0,,Сіз оны үнемі ойнай бермейсіз бе?
Dialogue: 0,0:48:17.14,0:48:20.48,Default,,0,0,0,,Сен де осында келмес бұрын Мичинкоға ұқсайтынсың, солай ма?
Dialogue: 0,0:48:20.56,0:48:21.85,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:48:21.94,0:48:24.06,Default,,0,0,0,,Оның үстіне сағат 9-ға таяп қалды.
Dialogue: 0,0:48:24.15,0:48:27.02,Default,,0,0,0,,Осындай кезде Мичинко да мені кешіреді.
Dialogue: 0,0:48:27.57,0:48:28.94,Default,,0,0,0,,Оқуға болады ма?
Dialogue: 0,0:48:29.03,0:48:30.44,Default,,0,0,0,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,0:48:30.53,0:48:33.16,Default,,0,0,0,,Мен жоғары оқу орнына түсуді жоспарламаймын.
Dialogue: 0,0:48:33.24,0:48:35.41,Default,,0,0,0,,Эй, не істеуіміз керек?
Dialogue: 0,0:48:38.12,0:48:40.00,Default,,0,0,0,,Токиоға барып, топта ойнаңыз
Dialogue: 0,0:48:40.08,0:48:41.25,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:48:41.33,0:48:44.71,Default,,0,0,0,,Менің өсиетімді мұрагер ететін адам осында!
Dialogue: 0,0:48:44.79,0:48:47.46,Default,,0,0,0,,Мені дәл осылай мақтамаңыз.
Dialogue: 0,0:48:48.21,0:48:50.92,Default,,0,0,0,,Менікі айлакер
Dialogue: 0,0:48:51.42,0:48:52.17,Default,,0,0,0,,Йокосима?
Dialogue: 0,0:48:53.47,0:48:56.18,Default,,0,0,0,,Мен туған жерімнен кеткім келеді
Dialogue: 0,0:48:58.14,0:49:01.60,Default,,0,0,0,,Өйткені мен кішкентай әпкемнің өз қалауынша өмір сүргенін қалаймын.
Dialogue: 0,0:49:02.39,0:49:06.10,Default,,0,0,0,,Менің әпкем мен үшін не істегісі келеді
Dialogue: 0,0:49:06.61,0:49:09.98,Default,,0,0,0,,Сен көп шыдағаныңа сенімдімін.
Dialogue: 0,0:49:11.49,0:49:13.70,Default,,0,0,0,,Мен осында қалсам
Dialogue: 0,0:49:13.78,0:49:17.07,Default,,0,0,0,,Менің қарындасым осында мәңгілікке байланып қалады.
Dialogue: 0,0:49:18.49,0:49:22.79,Default,,0,0,0,,Оның үстіне, мен істегім келетін ештеңе жоқ.
Dialogue: 0,0:49:22.87,0:49:25.42,Default,,0,0,0,,Мен сенің ақшаңды ысырап еткеніңді қаламаймын
Dialogue: 0,0:49:26.00,0:49:29.92,Default,,0,0,0,,Менің кесірімнен бұдан былай қиындық тудырғым келмейді.
Dialogue: 0,0:49:30.75,0:49:33.13,Default,,0,0,0,,Сіз өзіңізді тым көп айыптайсыз.
Dialogue: 0,0:49:33.22,0:49:34.80,Default,,0,0,0,,Ешкім сен кінәлі деп ойламайды...
Dialogue: 0,0:49:34.88,0:49:39.60,Default,,0,0,0,,Ол туралы бәрі ойлайды, оның ішінде көршінің апасы, туыстары да.
Dialogue: 0,0:49:41.14,0:49:42.31,Default,,0,0,0,,Ao...
Dialogue: 0,0:49:43.43,0:49:44.77,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:49:45.44,0:49:48.15,Default,,0,0,0,,Сондықтан мен осы жерден кетемін.
Dialogue: 0,0:49:49.11,0:49:51.36,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:49:52.28,0:49:52.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:53.03,0:49:54.82,Default,,0,0,0,,Не?
Dialogue: 0,0:49:56.32,0:50:00.37,Default,,0,0,0,,Мен неге мұндамын деп ойладым.
Dialogue: 0,0:50:01.08,0:50:02.91,Default,,0,0,0,,Тірі рух дегеніміз не?
Dialogue: 0,0:50:04.41,0:50:08.08,Default,,0,0,0,,Менің ойымша, бұл тәжірибесіздік емес.
Dialogue: 0,0:50:08.17,0:50:10.67,Default,,0,0,0,,Бірақ бұл шын мәнінде менмін
Dialogue: 0,0:50:11.38,0:50:16.01,Default,,0,0,0,,Мүмкін ол осы жерден шығуға қорқатын шығар.
Dialogue: 0,0:50:16.88,0:50:20.18,Default,,0,0,0,,Сіз шынымен де кереметсіз.
Dialogue: 0,0:50:20.26,0:50:21.85,Default,,0,0,0,,Көп нәрсеге алаңдасам да
Dialogue: 0,0:50:22.68,0:50:27.19,Default,,0,0,0,,Мұқият ойлан, шешім қабылда, бұл жерден кетейік.
Dialogue: 0,0:50:30.31,0:50:31.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:32.52,0:50:34.57,Default,,0,0,0,,Өткен күннің орнына
Dialogue: 0,0:50:34.65,0:50:36.36,Default,,0,0,0,,Өз кезегінде сіз...
Dialogue: 0,0:50:36.45,0:50:39.32,Default,,0,0,0,,Басс барлығына еру керек
Dialogue: 0,0:50:41.66,0:50:44.41,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:50:44.49,0:50:46.87,Default,,0,0,0,,Болашақ басшы күткендей
Dialogue: 0,0:50:46.96,0:50:49.54,Default,,0,0,0,,Не? Ендігі болашақ қандай?
Dialogue: 0,0:50:49.62,0:50:50.25,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:50:50.33,0:50:51.54,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:50:51.63,0:50:52.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:52.84,0:50:56.51,Default,,0,0,0,,Есіңде болсын, сен ештеңе уәде еткен жоқсың.
Dialogue: 0,0:50:56.59,0:50:59.51,Default,,0,0,0,,Бассты ойнағанда осылай ойлайсыз ба?
Dialogue: 0,0:51:02.51,0:51:03.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:04.72,0:51:06.02,Default,,0,0,0,,-Мм! -На...
Dialogue: 0,0:51:06.60,0:51:08.52,Default,,0,0,0,,Мен үшін де солай істе
Dialogue: 0,0:51:08.60,0:51:11.06,Default,,0,0,0,,Не? Мен оны сипап алсам жақсы ма?
Dialogue: 0,0:51:11.56,0:51:14.23,Default,,0,0,0,,Маңдай! Декопин өтінемін
Dialogue: 0,0:51:14.32,0:51:17.28,Default,,0,0,0,,Иә... жарайды.
Dialogue: 0,0:51:17.36,0:51:20.24,Default,,0,0,0,,- Барлығын қабыл алыңыз! -Уау
Dialogue: 0,0:51:21.16,0:51:23.53,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,0:51:23.62,0:51:25.70,Default,,0,0,0,,"Оған қанша төлейсің?"
Dialogue: 0,0:51:28.00,0:51:30.25,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:51:30.33,0:51:33.50,Default,,0,0,0,,Иә? Эй ау!
Dialogue: 0,0:51:42.59,0:51:43.60,Default,,0,0,0,,Аа...
Dialogue: 0,0:51:47.93,0:51:50.60,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:51:54.65,0:51:58.65,Default,,0,0,0,,Ака-ни мен Шинносуке-санды дұрыстап жинаңыз
Dialogue: 0,0:51:59.19,0:52:00.86,Default,,0,0,0,,Менің әпкем үшін де...
Dialogue: 0,0:52:02.16,0:52:03.95,Default,,0,0,0,,Синно үшін де
Dialogue: 0,0:52:07.70,0:52:10.04,Default,,0,0,0,,- (Оқушы) Қайырлы таң - (Оқушы) Қайырлы таң
Dialogue: 0,0:52:28.31,0:52:29.52,Default,,0,0,0,,Хм~
Dialogue: 0,0:52:34.15,0:52:38.07,Default,,0,0,0,,Эй, тыңдашы, Чика кеше бір жігітпен болған.
Dialogue: 0,0:52:38.15,0:52:39.28,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,0:52:39.36,0:52:42.70,Default,,0,0,0,,Иә, ол үлкенірек және өте ащы қария.
Dialogue: 0,0:52:42.78,0:52:43.86,Default,,0,0,0,,Сіз қартсыз ба?
Dialogue: 0,0:52:43.95,0:52:45.87,Default,,0,0,0,,Жоқ, ол өте жақсы болған сияқты.
Dialogue: 0,0:52:45.95,0:52:47.12,Default,,0,0,0,,Сізде ақша бар ма?
Dialogue: 0,0:52:48.29,0:52:49.79,Default,,0,0,0,,
Dialogue: 0,0:52:50.91,0:52:52.58,Default,,0,0,0,,Қайырлы таң~ Әй...
Dialogue: 0,0:52:52.66,0:52:55.08,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:52:56.50,0:52:59.55,Default,,0,0,0,,Ауырса, жібер!
Dialogue: 0,0:53:00.92,0:53:03.93,Default,,0,0,0,,Мен кеше сенімен болдым...
Dialogue: 0,0:53:04.01,0:53:06.14,Default,,0,0,0,,Шинносуке-сан?
Dialogue: 0,0:53:07.89,0:53:08.89,Default,,0,0,0,,Ер адамның аты – Ллойд Форджер
Dialogue: 0,0:53:08.97,0:53:09.93,Default,,0,0,0,,Не?
Dialogue: 0,0:53:10.02,0:53:14.56,Default,,0,0,0,,Сізге Айои-сан мен Шинносуке-сан шынымен ұнады ма?
Dialogue: 0,0:53:14.64,0:53:16.31,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:53:16.40,0:53:17.52,Default,,0,0,0,,Мен Шинногамын...
Dialogue: 0,0:53:22.82,0:53:27.82,Default,,0,0,0,,Мен енді досымның жігітіне ештеңе істемес едім.
Dialogue: 0,0:53:27.91,0:53:30.87,Default,,0,0,0,,Шинно Синносукеден өзгеше, солай ма?
Dialogue: 0,0:53:31.37,0:53:32.37,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:53:32.45,0:53:36.33,Default,,0,0,0,,...ал Айои мырза Шинноны ұнататынын айтты.
Dialogue: 0,0:53:39.50,0:53:41.59,Default,,0,0,0,,А, мен оны жақсы көремін!
Dialogue: 0,0:53:42.13,0:53:44.05,Default,,0,0,0,,Әй, иә... Бұл қандай кейіпкер?
Dialogue: 0,0:53:44.13,0:53:45.93,Default,,0,0,0,,Маған ұнағаны жаман ба?
Dialogue: 0,0:53:46.01,0:53:48.18,Default,,0,0,0,,Жоқ, ешкім кінәлі емес...
Dialogue: 0,0:53:49.51,0:53:52.10,Default,,0,0,0,,Иә, бұл не? Күте тұрыңыз...
Dialogue: 0,0:53:52.18,0:53:53.56,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:53:54.56,0:53:56.56,Default,,0,0,0,,Жоқ...не?
Dialogue: 0,0:53:56.65,0:53:59.19,Default,,0,0,0,,А... Айои мырза?
Dialogue: 0,0:53:59.27,0:54:01.98,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:54:11.33,0:54:12.66,Default,,0,0,0,,Хмм…
Dialogue: 0,0:54:15.29,0:54:17.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:18.04,0:54:19.38,Default,,0,0,0,,...
Dialogue: 0,0:54:19.46,0:54:20.38,Default,,0,0,0,,(Есікті қағады)
Dialogue: 0,0:54:20.46,0:54:23.00,Default,,0,0,0,,Бүгін таңертең есікті құлыптауды ұмыттыңыз ба?
Dialogue: 0,0:54:24.30,0:54:25.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:25.92,0:54:28.97,Default,,0,0,0,,О... Аой?
Dialogue: 0,0:54:30.01,0:54:32.18,Default,,0,0,0,,Хаа~ Мен таң қалдым.
Dialogue: 0,0:54:32.76,0:54:35.64,Default,,0,0,0,,Алдымен үйге барғыңыз келсе, маған хабарлаңыз.
Dialogue: 0,0:54:35.73,0:54:38.77,Default,,0,0,0,,Осы жерден хабарлассам да қосылмайды.
Dialogue: 0,0:54:39.85,0:54:41.19,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:54:41.27,0:54:42.61,Default,,0,0,0,,Хмм?
Dialogue: 0,0:54:43.19,0:54:44.44,Default,,0,0,0,,Шинно…
Dialogue: 0,0:54:45.74,0:54:48.45,Default,,0,0,0,,Синносукенің соңынан ерген жоқсың ба?
Dialogue: 0,0:54:48.95,0:54:52.24,Default,,0,0,0,,Не? Кенет не?
Dialogue: 0,0:54:52.33,0:54:53.91,Default,,0,0,0,,Артымнан сіңлім ерсе
Dialogue: 0,0:54:54.49,0:54:58.62,Default,,0,0,0,,Сонда Шинносуке-сан ондай ақымақ болмас еді.
Dialogue: 0,0:54:59.25,0:55:03.21,Default,,0,0,0,,Баяғыда қандай болса, сол күйінде қалуы мүмкін.
Dialogue: 0,0:55:04.30,0:55:06.21,Default,,0,0,0,,Мм, сен не айтып тұрсың?
Dialogue: 0,0:55:06.30,0:55:07.59,Default,,0,0,0,,Он көлеңке техникасы
Dialogue: 0,0:55:08.30,0:55:10.26,Default,,0,0,0,,Мен өзімнің қарындасымдай болғым келмейді!
Dialogue: 0,0:55:11.85,0:55:15.22,Default,,0,0,0,,Не істегіңіз келетінін ұстаныңыз және өкініңіз.
Dialogue: 0,0:55:15.31,0:55:16.52,Default,,0,0,0,,Жоқ
Dialogue: 0,0:55:17.23,0:55:19.94,Default,,0,0,0,,Мен бұл жерде мәңгілікке аяқталатынына сене алмаймын
Dialogue: 0,0:55:20.02,0:55:22.52,Default,,0,0,0,,Мен бұл үшін кешірім сұраймын!
Dialogue: 0,0:55:22.61,0:55:25.90,Default,,0,0,0,,Мен мұны айтқым келген жоқ.
Dialogue: 0,0:55:26.78,0:55:28.28,Default,,0,0,0,,Менің әпкем...
Dialogue: 0,0:55:29.57,0:55:30.66,Default,,0,0,0,,Менің әпкем...
Dialogue: 0,0:55:30.74,0:55:33.07,Default,,0,0,0,,Мен шынымен...
Dialogue: 0,0:55:33.16,0:55:34.45,Default,,0,0,0,,ақымақ көрінеді!
Dialogue: 0,0:55:34.95,0:55:35.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:39.37,0:55:41.50,Default,,0,0,0,,Ақымақ сияқты...?
Dialogue: 0,0:55:43.67,0:55:44.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:46.42,0:55:47.96,Default,,0,0,0,,А, сәл көк?
Dialogue: 0,0:56:10.32,0:56:12.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:23.67,0:56:24.79,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:56:25.71,0:56:27.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:56:28.05,0:56:29.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:56:30.05,0:56:34.14,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:56:36.01,0:56:37.06,Default,,0,0,0,,Хаха
Dialogue: 0,0:56:38.72,0:56:39.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:40.18,0:56:42.19,Default,,0,0,0,,Аға, ол ашық.
Dialogue: 0,0:56:43.65,0:56:46.77,Default,,0,0,0,,Аои~ Бар ма~?
Dialogue: 0,0:56:56.20,0:56:57.16,Default,,0,0,0,,Хаа…
Dialogue: 0,0:57:05.92,0:57:09.71,Default,,0,0,0,,«Сен мен сияқты болғың келмейді»?
Dialogue: 0,0:57:15.97,0:57:19.10,Default,,0,0,0,,Ммм! Хаа...
Dialogue: 0,0:57:21.56,0:57:22.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:57:37.24,0:57:38.41,Default,,0,0,0,,Фу…
Dialogue: 0,0:57:39.49,0:57:41.49,Default,,0,0,0,,Мата ламинариялары
Dialogue: 0,0:57:42.95,0:57:44.21,Default,,0,0,0,,Ах~
Dialogue: 0,0:57:45.50,0:57:48.71,Default,,0,0,0,,мен өзім туралы
Dialogue: 0,0:57:48.79,0:57:53.26,Default,,0,0,0,,Менің ойымша, ол жаман адам.
Dialogue: 0,0:57:53.34,0:57:54.22,Default,,0,0,0,,Иә
Dialogue: 0,0:57:54.30,0:57:57.68,Default,,0,0,0,,Бастауыш сынып оқушысынан бір электрондық пошта арқылы бассты алуды сұраңыз.
Dialogue: 0,0:57:57.76,0:57:58.68,Default,,0,0,0,,Кенет ішке кірді
Dialogue: 0,0:57:58.76,0:58:01.18,Default,,0,0,0,,Өз бөлмеңіз сияқты демалуға болатын орын.
Dialogue: 0,0:58:01.26,0:58:03.02,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:58:03.60,0:58:07.06,Default,,0,0,0,,Әлгі Шинносуке меннен мың есе жаман шығар!
Dialogue: 0,0:58:07.15,0:58:08.56,Default,,0,0,0,,Ао-чан шалбары
Dialogue: 0,0:58:08.65,0:58:10.02,Default,,0,0,0,,Шешім!
Dialogue: 0,0:58:10.11,0:58:12.82,Default,,0,0,0,,(Масамичидің қорылдауы)
Dialogue: 0,0:58:13.78,0:58:16.24,Default,,0,0,0,,Ао-чан, сәл тыныштал.
Dialogue: 0,0:58:16.32,0:58:18.99,Default,,0,0,0,,-Мичинко - (Масамичи) Хмм... А?
Dialogue: 0,0:58:19.07,0:58:22.20,Default,,0,0,0,,Мен, Мичинко және Ака-ни, мен саған оны құрастыруға көмектесемін.
Dialogue: 0,0:58:22.29,0:58:25.00,Default,,0,0,0,,(Әділ жолдың есігі)
Dialogue: 0,0:58:25.08,0:58:27.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:27.46,0:58:29.67,Default,,0,0,0,,Әке, түн болды.
Dialogue: 0,0:58:30.79,0:58:32.38,Default,,0,0,0,,Ах... Аой
Dialogue: 0,0:58:32.46,0:58:36.72,Default,,0,0,0,,Сіз ажырасқан адамға қайта тұрмысқа шығуға мүлдем қарсы екеніңізді айттыңыз, солай ма?
Dialogue: 0,0:58:36.80,0:58:38.30,Default,,0,0,0,,Ол алынып тасталды
Dialogue: 0,0:58:38.89,0:58:42.01,Default,,0,0,0,,Қазір әлгі Шинносукенің қолына түскеннен жақсы.
Dialogue: 0,0:58:44.64,0:58:48.60,Default,,0,0,0,,Рахмет, бірақ маған сіздің ынтымақтастығыңыз қажет емес.
Dialogue: 0,0:58:48.69,0:58:49.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:50.44,0:58:53.32,Default,,0,0,0,,Бұл жұмысты Нитобе мырзадан сұрауда шешуші фактор не болды?
Dialogue: 0,0:58:53.90,0:58:55.65,Default,,0,0,0,,Себебі Синно сонда болды
Dialogue: 0,0:58:55.74,0:58:56.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:00.95,0:59:04.91,Default,,0,0,0,,Бұзылған дүниелер көп, мен оны тазаламайынша алға жылжи алмаймын деп ойлаймын.
Dialogue: 0,0:59:04.99,0:59:09.12,Default,,0,0,0,,Менің жасым да, Ақанең де.
Dialogue: 0,0:59:09.96,0:59:10.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:59:12.67,0:59:14.46,Default,,0,0,0,,Суық!
Dialogue: 0,0:59:14.55,0:59:16.26,Default,,0,0,0,,Әй, не істеп жатырсың, Аой!
Dialogue: 0,0:59:16.34,0:59:17.51,Default,,0,0,0,,Лас
Dialogue: 0,0:59:17.59,0:59:20.72,Default,,0,0,0,,Ересектердің де шашы ұшқыр, іші болады.
Dialogue: 0,0:59:20.80,0:59:21.84,Default,,0,0,0,,Бәрі лас!
Dialogue: 0,0:59:21.93,0:59:22.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:23.51,0:59:24.39,Default,,0,0,0,,Ао-чан...
Dialogue: 0,0:59:24.47,0:59:28.48,Default,,0,0,0,,Эй Цугу, маған орамал әкелші.
Dialogue: 0,0:59:29.06,0:59:30.60,Default,,0,0,0,,Цуг~
Dialogue: 0,0:59:49.87,0:59:52.29,Default,,0,0,0,,- (Чика) Әпке - А?
Dialogue: 0,0:59:52.79,0:59:54.88,Default,,0,0,0,,Мұны қайда қою керек?
Dialogue: 0,0:59:54.96,0:59:56.96,Default,,0,0,0,,А, мен оны алайын.
Dialogue: 0,0:59:57.80,1:00:00.22,Default,,0,0,0,,Кешіріңіз, бүгін сенбі.
Dialogue: 0,1:00:00.30,1:00:04.26,Default,,0,0,0,,Мен үйірмемен айналыспаймын, бос уақытым көп.
Dialogue: 0,1:00:04.35,1:00:07.47,Default,,0,0,0,,Мен сізге ертеңгі спектакльге дейін көмектесемін.
Dialogue: 0,1:00:07.56,1:00:10.77,Default,,0,0,0,,Ах, Айои-сан.
Dialogue: 0,1:00:10.85,1:00:12.94,Default,,0,0,0,,Эй!
Dialogue: 0,1:00:15.23,1:00:17.78,Default,,0,0,0,,Ах... Шикато тағы да
Dialogue: 0,1:00:24.57,1:00:26.41,Default,,0,0,0,,-Сәлеметсіз бе - (пернетақта) Иә?
Dialogue: 0,1:00:27.49,1:00:29.45,Default,,0,0,0,,Лайт мырза біздің тұрған жерімізді растағысы келеді.
Dialogue: 0,1:00:29.54,1:00:30.71,Default,,0,0,0,,Мен оны іздедім.
Dialogue: 0,1:00:30.79,1:00:32.12,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,1:00:32.21,1:00:34.50,Default,,0,0,0,,Шин… Сондай-ақ Канемуро мырза туралы.
Dialogue: 0,1:00:34.58,1:00:36.46,Default,,0,0,0,,Мен сені іздеп жүрген сияқтымын.
Dialogue: 0,1:00:36.54,1:00:40.51,Default,,0,0,0,,А, жарайды, мен сенің орныңа келемін.
Dialogue: 0,1:00:40.59,1:00:42.43,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,1:00:42.51,1:00:47.06,Default,,0,0,0,,Бұл оның туған қаласы, солай ма? Менің ойымша, әртүрлі нәрселер бар.
Dialogue: 0,1:00:47.72,1:00:48.64,Default,,0,0,0,,Әртүрлі заттар?
Dialogue: 0,1:00:49.22,1:00:51.39,Default,,0,0,0,,Мен сахнаның артындағы адаммын.
Dialogue: 0,1:00:51.48,1:00:54.06,Default,,0,0,0,,Ол бір рет жеке орындаушы ретінде дебют жасады.
Dialogue: 0,1:00:54.15,1:00:56.90,Default,,0,0,0,,Бір ғана әнмен аяқталған сияқты.
Dialogue: 0,1:01:00.99,1:01:02.32,Default,,0,0,0,,Я~
Dialogue: 0,1:01:07.78,1:01:09.83,Default,,0,0,0,,-Тау - (Масацугу) Мотояма
Dialogue: 0,1:01:12.29,1:01:12.79,Default,,0,0,0,,Не болды?
Dialogue: 0,1:01:13.54,1:01:15.88,Default,,0,0,0,,Бүгін мерекеге дайындалмайсың ба?
Dialogue: 0,1:01:16.38,1:01:18.04,Default,,0,0,0,,Иә, аздап.
Dialogue: 0,1:01:18.84,1:01:20.34,Default,,0,0,0,,Мен айтайын деп ойладым
Dialogue: 0,1:01:20.42,1:01:21.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:22.47,1:01:24.55,Default,,0,0,0,,Маған Ао Чан ұнайды
Dialogue: 0,1:01:25.26,1:01:26.80,Default,,0,0,0,,Алғашқы махаббат дегеніміз не?
Dialogue: 0,1:01:26.89,1:01:27.64,Default,,0,0,0,,Е...
Dialogue: 0,1:01:31.06,1:01:31.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:31.97,1:01:33.77,Default,,0,0,0,,Синно-сан неге ұялшақ?
Dialogue: 0,1:01:33.85,1:01:37.73,Default,,0,0,0,,Мен ұялған сияқты емеспін...
Dialogue: 0,1:01:38.94,1:01:42.24,Default,,0,0,0,,Сіз өте қартайған болуыңыз керек.
Dialogue: 0,1:01:42.90,1:01:44.78,Default,,0,0,0,,Ал, әзірге.
Dialogue: 0,1:01:45.28,1:01:48.45,Default,,0,0,0,,Бірақ мен жұмысқа тұрған кезде,
Dialogue: 0,1:01:48.53,1:01:52.41,Default,,0,0,0,,10 жастан аз жас айырмашылығы жай ғана қателік болар еді.
Dialogue: 0,1:01:53.12,1:01:56.25,Default,,0,0,0,,О... О, жақсы.
Dialogue: 0,1:01:56.33,1:01:57.46,Default,,0,0,0,,Сонымен
Dialogue: 0,1:01:57.54,1:02:01.67,Default,,0,0,0,,Ао Чан оқуда жақсы болмаса да, мен бар күшімді саламын.
Dialogue: 0,1:02:01.75,1:02:05.43,Default,,0,0,0,,Мен қандай да бір қажетті құндылыққа ие адам болғым келеді.
Dialogue: 0,1:02:06.38,1:02:08.55,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:02:09.35,1:02:11.35,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,1:02:12.72,1:02:15.39,Default,,0,0,0,,Менің қарсыласым бар.
Dialogue: 0,1:02:15.48,1:02:17.06,Default,,0,0,0,,О, шынымен бе?
Dialogue: 0,1:02:17.15,1:02:17.90,Default,,0,0,0,,Иә
Dialogue: 0,1:02:17.98,1:02:18.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:20.23,1:02:22.73,Default,,0,0,0,,Иә? иә?
Dialogue: 0,1:02:22.82,1:02:25.90,Default,,0,0,0,,Сіз қалай ойлайсыз? Ао Чан туралы
Dialogue: 0,1:02:25.99,1:02:29.12,Default,,0,0,0,,Эй, сәл күте тұр, Цугу, тыныштал.
Dialogue: 0,1:02:29.20,1:02:31.33,Default,,0,0,0,,Мен бұл сөздерге сол күйінде жауап беремін.
Dialogue: 0,1:02:35.25,1:02:37.04,Default,,0,0,0,,Мен...
Dialogue: 0,1:02:37.62,1:02:39.29,Default,,0,0,0,,Бұл менің тәжірибем ғана.
Dialogue: 0,1:02:39.38,1:02:42.00,Default,,0,0,0,,Мені кеше ғана Ақан тастап кетті.
Dialogue: 0,1:02:42.63,1:02:45.72,Default,,0,0,0,,Күні кешеге дейін Аой бөтен болды.
Dialogue: 0,1:02:45.80,1:02:46.55,Default,,0,0,0,,...?
Dialogue: 0,1:02:48.26,1:02:51.85,Default,,0,0,0,,Мен Шинносукенің тірі рухымын, осылайша...
Dialogue: 0,1:02:54.22,1:02:57.69,Default,,0,0,0,,Маған бұлай ғашық болудан ештеңе істей алмайсың.
Dialogue: 0,1:02:58.19,1:02:59.98,Default,,0,0,0,,Иә, мен солай ойлаймын.
Dialogue: 0,1:03:01.11,1:03:02.19,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:03:04.57,1:03:09.24,Default,,0,0,0,,Әй, сен мұнда қанша уақыт боласың?
Dialogue: 0,1:03:10.28,1:03:12.07,Default,,0,0,0,,Жақынбаңыз
Dialogue: 0,1:03:13.41,1:03:17.08,Default,,0,0,0,,Уау, түбегейлі атау мағынасы
Dialogue: 0,1:03:18.50,1:03:22.67,Default,,0,0,0,,Сонымен, сіз бұл туралы ерекше ештеңе жоқ деп айттыңыз.
Dialogue: 0,1:03:22.75,1:03:24.71,Default,,0,0,0,,Ештеңе болуы мүмкін емес еді!
Dialogue: 0,1:03:24.80,1:03:29.38,Default,,0,0,0,,Бейбақ плюс бос тырнақ таза емес гетеросексуалды жыныстық қатынасқа тең...
Dialogue: 0,1:03:29.47,1:03:32.05,Default,,0,0,0,,Мен де таң қалдым, солай ма?
Dialogue: 0,1:03:32.64,1:03:36.18,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,1:03:36.27,1:03:38.23,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,1:03:38.31,1:03:42.81,Default,,0,0,0,,Мені осы жерден алып кететін ханзада қайда?
Dialogue: 0,1:03:42.90,1:03:46.48,Default,,0,0,0,,Отаки-сан, сіз бұрын сұраған қабылдау формасы.
Dialogue: 0,1:03:46.57,1:03:47.90,Default,,0,0,0,,Барлығын ескерсек, біз үшеу болып өмір сүруге үйрене бастадық.
Dialogue: 0,1:03:47.99,1:03:51.07,Default,,0,0,0,,Мен оны кіреберісте және мына арбаға қалдырдым.
Dialogue: 0,1:03:52.20,1:03:59.21,Default,,0,0,0,,(Гитараның жұлынған дыбысы)
Dialogue: 0,1:04:22.65,1:04:27.44,Default,,0,0,0,,♪ Онда барсаңыз
Dialogue: 0,1:04:28.40,1:04:33.82,Default,,0,0,0,,♪ Кез келген арман
Dialogue: 0,1:04:34.66,1:04:39.45,Default,,0,0,0,,♪ Егер ол орындалса...
Dialogue: 0,1:04:45.67,1:04:46.75,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:04:48.25,1:04:49.84,Default,,0,0,0,,Неліктен жұмысты тастап жатырсыз?
Dialogue: 0,1:04:49.92,1:04:50.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:53.59,1:04:54.72,Default,,0,0,0,,Әрі қарай жалғастыр.
Dialogue: 0,1:04:57.56,1:04:59.14,Default,,0,0,0,,Хаа…
Dialogue: 0,1:05:04.31,1:05:07.82,Default,,0,0,0,,Осы жерден Токиоға барсам
Dialogue: 0,1:05:07.90,1:05:10.53,Default,,0,0,0,,Мен кез келген арманның орындалатынын сезіндім
Dialogue: 0,1:05:11.36,1:05:13.61,Default,,0,0,0,,Бірақ бұл басқаша.
Dialogue: 0,1:05:15.20,1:05:19.45,Default,,0,0,0,,Менің арманым орындалды. Мен гитарада дұрыс ойнаймын.
Dialogue: 0,1:05:19.54,1:05:22.00,Default,,0,0,0,,Энка әншінің минус тобы?
Dialogue: 0,1:05:22.08,1:05:24.21,Default,,0,0,0,,Мен мұны істегім келген сияқты емес.
Dialogue: 0,1:05:24.29,1:05:25.04,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,1:05:25.12,1:05:27.04,Default,,0,0,0,,Менің көңілім толмады.
Dialogue: 0,1:05:27.92,1:05:30.17,Default,,0,0,0,,Мен Нитөбе мырзаға ризамын.
Dialogue: 0,1:05:30.25,1:05:33.34,Default,,0,0,0,,Музыкамен айналысудың өзі бір бақыт.
Dialogue: 0,1:05:34.51,1:05:37.93,Default,,0,0,0,,Бірақ мен әр түрлі заттарды лақтырып тастауға бардым.
Dialogue: 0,1:05:38.51,1:05:41.06,Default,,0,0,0,,Шығу керек болды ма, білмеймін.
Dialogue: 0,1:05:46.23,1:05:49.61,Default,,0,0,0,,Сонымен, мен басқа ән сұрай аламын ба?
Dialogue: 0,1:05:49.69,1:05:50.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:54.40,1:05:56.70,Default,,0,0,0,,«Аспанның көгілдірлігін білетін сен»
Dialogue: 0,1:05:56.78,1:05:57.78,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:05:59.66,1:06:00.49,Default,,0,0,0,,Неге...
Dialogue: 0,1:06:01.12,1:06:04.71,Default,,0,0,0,,Мен оны Шинноның жеке дебюттік әнін дұрыс сатып алдым
Dialogue: 0,1:06:04.79,1:06:06.54,Default,,0,0,0,,Қара тарих, солай ма?
Dialogue: 0,1:06:08.75,1:06:10.46,Default,,0,0,0,,«Гандхара» сияқты
Dialogue: 0,1:06:10.54,1:06:12.17,Default,,0,0,0,,Бұл менің сүйікті әнім
Dialogue: 0,1:06:12.71,1:06:13.76,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:25.77,1:06:30.73,Default,,0,0,0,,(Сергітетін әуен)
Dialogue: 0,1:06:30.82,1:06:34.24,Default,,0,0,0,,♪ Маған мүлдем ұнамады
Dialogue: 0,1:06:34.32,1:06:39.87,Default,,0,0,0,,♪ Қорқынышты фильмдер және карамель хош иісі бар сүйісулер
Dialogue: 0,1:06:39.95,1:06:43.16,Default,,0,0,0,,♪ Маған мүлдем ұнамады
Dialogue: 0,1:06:43.24,1:06:45.62,Default,,0,0,0,,♪ Және де
Dialogue: 0,1:06:45.71,1:06:49.58,Default,,0,0,0,,♪ Енді айқайлап тұрғанда
Dialogue: 0,1:06:49.67,1:06:55.80,Default,,0,0,0,,♪ Мен сіздің профиліңізді іздеп жүрмін
Dialogue: 0,1:06:57.01,1:06:58.47,Default,,0,0,0,,Нитобе Дэн Йошиказэ
Dialogue: 0,1:06:59.34,1:07:04.97,Default,,0,0,0,,♪ Бос жүректің тұзақтары
Dialogue: 0,1:07:05.06,1:07:10.35,Default,,0,0,0,,♪ Ештеңені көру үшін тым қараңғы
Dialogue: 0,1:07:11.48,1:07:15.15,Default,,0,0,0,,Бұл не? Енді дұрыс ән айт.
Dialogue: 0,1:07:15.23,1:07:16.94,Default,,0,0,0,,Келесі Сайтоның математика стилі
Dialogue: 0,1:07:17.03,1:07:21.24,Default,,0,0,0,,♪ Ешқандай негіз жоқ
Dialogue: 0,1:07:25.54,1:07:29.04,Default,,0,0,0,,Ака-ни... және...
Dialogue: 0,1:07:32.29,1:07:36.38,Default,,0,0,0,,Менің әпкемді осылай күлдіретін адам
Dialogue: 0,1:07:37.92,1:07:39.09,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,1:07:42.97,1:07:45.72,Default,,0,0,0,,Шинно... Не?
Dialogue: 0,1:07:50.23,1:07:52.15,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,1:07:52.23,1:07:56.73,Default,,0,0,0,,Хаа... хаха ах~ менің ішім ауырып кетті
Dialogue: 0,1:07:56.82,1:07:59.70,Default,,0,0,0,,Енді әдеттегідей ән айт.
Dialogue: 0,1:07:59.78,1:08:02.66,Default,,0,0,0,,Өйткені, сізбен бірге болу жақсы сезінеді.
Dialogue: 0,1:08:03.91,1:08:05.16,Default,,0,0,0,,Тынышталыңыз және бірге болыңыз?
Dialogue: 0,1:08:05.24,1:08:06.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:06.95,1:08:09.12,Default,,0,0,0,,Қайтып оралуым керек пе?
Dialogue: 0,1:08:10.21,1:08:13.75,Default,,0,0,0,,Менің қазіргі жұмысымда болашағым жоқ сияқты.
Dialogue: 0,1:08:13.83,1:08:14.84,Default,,0,0,0,,No
Dialogue: 0,1:08:14.92,1:08:19.59,Default,,0,0,0,,Менің айналамдағы адамдар ауыр жұмысқа орналаса бастады.
Dialogue: 0,1:08:20.17,1:08:25.14,Default,,0,0,0,,Маған мән бермейтін жаста шығармын.
Dialogue: 0,1:08:25.22,1:08:26.22,Default,,0,0,0,,No
Dialogue: 0,1:08:26.72,1:08:29.52,Default,,0,0,0,,Бұлай болса, Шинно жоқ болады!
Dialogue: 0,1:08:29.60,1:08:31.23,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,1:08:31.81,1:08:36.02,Default,,0,0,0,,Қазіргі заманда 30-ға жуық адамдар әлі жас.
Dialogue: 0,1:08:36.11,1:08:38.44,Default,,0,0,0,,Тынышталуға әлі ерте.
Dialogue: 0,1:08:38.53,1:08:39.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:41.36,1:08:44.82,Default,,0,0,0,,Мен мұнда ғана істей алатын нәрселер бар.
Dialogue: 0,1:08:44.91,1:08:47.62,Default,,0,0,0,,Мен әлі көп нәрседен бас тартқан жоқпын.
Dialogue: 0,1:08:47.70,1:08:50.58,Default,,0,0,0,,Иә, бұдан былай, қазірден бастап
Dialogue: 0,1:08:57.00,1:08:58.17,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:08:58.75,1:08:59.92,Default,,0,0,0,,Оған не болды?
Dialogue: 0,1:09:00.42,1:09:04.64,Default,,0,0,0,,Иә, дұрыс... Иә.
Dialogue: 0,1:09:09.01,1:09:10.31,Default,,0,0,0,,Сіз қайтып барасыз ба?
Dialogue: 0,1:09:10.39,1:09:12.85,Default,,0,0,0,,А, мен қазір кетуім керек.
Dialogue: 0,1:09:12.94,1:09:14.31,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,1:09:20.15,1:09:21.15,Default,,0,0,0,,Хаа…
Dialogue: 0,1:09:25.07,1:09:26.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:30.37,1:09:31.12,Default,,0,0,0,,Ах
Dialogue: 0,1:09:52.27,1:09:55.27,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,1:10:07.45,1:10:11.62,Default,,0,0,0,,Менің қарындасым осылай жылайды.
Dialogue: 0,1:10:12.91,1:10:14.50,Default,,0,0,0,,Мен білмедім
Dialogue: 0,1:10:15.41,1:10:16.87,Default,,0,0,0,,Мен ешқашан жыламадым
Dialogue: 0,1:10:19.50,1:10:21.80,Default,,0,0,0,,Қанша уақыт көрмегеніме таң қалдым.
Dialogue: 0,1:10:37.35,1:10:38.90,Default,,0,0,0,,Ака-ни Мухитори...
Dialogue: 0,1:10:47.03,1:10:49.24,Default,,0,0,0,,Ммм... Уау.
Dialogue: 0,1:10:53.87,1:10:56.21,Default,,0,0,0,,Ммм
Dialogue: 0,1:10:58.00,1:10:59.33,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:10:59.42,1:11:01.29,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,1:11:01.79,1:11:02.54,Default,,0,0,0,,Ита
Dialogue: 0,1:11:05.71,1:11:07.80,Default,,0,0,0,,Стратегия...
Dialogue: 0,1:11:10.22,1:11:10.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:21.52,1:11:24.53,Default,,0,0,0,,(қуырылған дыбыс)
Dialogue: 0,1:11:31.91,1:11:32.87,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:33.49,1:11:35.58,Default,,0,0,0,,-Кора Аой, жарайды... -Хмм, жоқ, жоқ!
Dialogue: 0,1:11:35.66,1:11:38.04,Default,,0,0,0,,Қазірдің өзінде~ Аои-кун?
Dialogue: 0,1:11:38.12,1:11:41.13,Default,,0,0,0,,Бос уақытыңыз болса, неге кішкене көмектеспейсіз?
Dialogue: 0,1:11:41.21,1:11:42.04,Default,,0,0,0,,Е, жоқ.
Dialogue: 0,1:11:42.13,1:11:44.55,Default,,0,0,0,,Ака-ни қуырылған тағамды жақсы жейді.
Dialogue: 0,1:11:44.63,1:11:46.63,Default,,0,0,0,,Тамақ пісіргені жақсы.
Dialogue: 0,1:11:46.71,1:11:49.30,Default,,0,0,0,,Тіпті материалдар қуаныштан айқайлайды.
Dialogue: 0,1:11:50.26,1:11:52.43,Default,,0,0,0,,Хе, жақсы.
Dialogue: 0,1:11:53.35,1:11:56.52,Default,,0,0,0,,«Қиындық тудырмайды» деген не?
Dialogue: 0,1:11:57.06,1:12:01.02,Default,,0,0,0,,Кішкентай әпкем бәрін де істей алатындай сезінді.
Dialogue: 0,1:12:01.52,1:12:07.07,Default,,0,0,0,,Бірақ менің кішкентай әпкем керемет көрінді...
Dialogue: 0,1:12:28.01,1:12:29.59,Default,,0,0,0,,Мен үшін...
Dialogue: 0,1:12:37.43,1:12:40.60,Default,,0,0,0,,Өйткені сіз көп еңбек еттіңіз
Dialogue: 0,1:12:44.10,1:12:45.44,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,1:12:49.28,1:12:53.20,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,1:13:01.41,1:13:02.79,Default,,0,0,0,,Хмм...
Dialogue: 0,1:13:03.42,1:13:04.33,Default,,0,0,0,,Хмм
Dialogue: 0,1:13:18.81,1:13:20.43,Default,,0,0,0,,Хмм…
Dialogue: 0,1:13:20.93,1:13:23.39,Default,,0,0,0,,бірақ қанға бөккен қол дәл алдына ұсынылғанда да,
Dialogue: 0,1:13:26.19,1:13:27.19,Default,,0,0,0,,На
Dialogue: 0,1:13:29.36,1:13:32.07,Default,,0,0,0,,Не... Бұл не, Аока?
Dialogue: 0,1:13:32.15,1:13:33.78,Default,,0,0,0,,Құпия сөз қандай болды? Құпия сөз қандай болды?
Dialogue: 0,1:13:33.86,1:13:34.95,Default,,0,0,0,,Бұл мені таң қалдырды.
Dialogue: 0,1:13:35.03,1:13:36.87,Default,,0,0,0,,Маған Шинно ұнайды
Dialogue: 0,1:13:41.95,1:13:43.58,Default,,0,0,0,,Ах~
Dialogue: 0,1:13:44.33,1:13:47.54,Default,,0,0,0,,Мм... Сенің осындай сезімде болғаныңа қуаныштымын.
Dialogue: 0,1:13:47.63,1:13:50.59,Default,,0,0,0,,Бірақ ойланыңыз, мен тірі рухпын...
Dialogue: 0,1:13:50.67,1:13:51.67,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,1:13:54.30,1:13:54.88,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:54.97,1:13:58.35,Default,,0,0,0,,Өйткені Шинноның дауысы өте мейірімді.
Dialogue: 0,1:13:58.43,1:14:00.14,Default,,0,0,0,,Осындай дауысы бар адамдар
Dialogue: 0,1:14:00.22,1:14:02.10,Default,,0,0,0,,Жұбаныш беретін нәрсе.
Dialogue: 0,1:14:02.18,1:14:04.98,Default,,0,0,0,,Жалпы аяушылық сияқты сөздер айтады.
Dialogue: 0,1:14:06.06,1:14:07.27,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:07.35,1:14:10.73,Default,,0,0,0,,Тіпті бұл жайлылық немесе басқа нәрсе үшін болмаса да.
Dialogue: 0,1:14:11.40,1:14:15.15,Default,,0,0,0,,Шинноның дауысы сүйкімді және жылы.
Dialogue: 0,1:14:15.78,1:14:19.12,Default,,0,0,0,,Оны естігім келмейді, себебі бұл менің жүрегімді ауыртады.
Dialogue: 0,1:14:20.58,1:14:23.54,Default,,0,0,0,,Әзірше мен өз сезімдерімді айтып берейін.
Dialogue: 0,1:14:28.54,1:14:29.63,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,1:14:34.76,1:14:36.72,Default,,0,0,0,,Маған Шинно ұнайды
Dialogue: 0,1:14:38.01,1:14:42.97,Default,,0,0,0,,Маған Шинносуке емес, қазір осында жүрген Шинно ұнайды.
Dialogue: 0,1:14:43.81,1:14:45.56,Default,,0,0,0,,Мен сенімен мәңгі бірге болғым келеді
Dialogue: 0,1:14:46.44,1:14:49.23,Default,,0,0,0,,Мен Шинносукеге қайта оралғанды ​​жөн көремін.
Dialogue: 0,1:14:49.31,1:14:51.19,Default,,0,0,0,,Мен оның бұрынғыдай болғанын қалаймын.
Dialogue: 0,1:14:53.48,1:14:54.32,Default,,0,0,0,,Ao...
Dialogue: 0,1:14:54.40,1:14:57.57,Default,,0,0,0,,Бірақ... Бірақ!
Dialogue: 0,1:14:58.70,1:15:01.99,Default,,0,0,0,,Мен де өз әпкемді жақсы көремін!
Dialogue: 0,1:15:04.04,1:15:09.25,Default,,0,0,0,,Менің әпкем әлі күнге дейін Шинносукені жақсы көреді.
Dialogue: 0,1:15:09.88,1:15:12.13,Default,,0,0,0,,Әпкемнің бақытын ойлау
Dialogue: 0,1:15:13.63,1:15:15.80,Default,,0,0,0,,Бірақ содан кейін Шинно...
Dialogue: 0,1:15:18.09,1:15:20.80,Default,,0,0,0,,Мен енді не істерімді білмеймін
Dialogue: 0,1:15:21.64,1:15:24.06,Default,,0,0,0,,Эй, мен не істеуім керек?
Dialogue: 0,1:15:26.06,1:15:27.06,Default,,0,0,0,,Оған қол тигізбеңіз!
Dialogue: 0,1:15:27.14,1:15:28.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:29.02,1:15:32.61,Default,,0,0,0,,Маған көбірек тиген сайын, мен сені ұнатамын!
Dialogue: 0,1:15:33.57,1:15:36.28,Default,,0,0,0,,Сонымен... онда мен не істеуім керек?
Dialogue: 0,1:15:36.36,1:15:38.45,Default,,0,0,0,,Сіз Шинноны да танымайсыз ба?
Dialogue: 0,1:15:38.53,1:15:39.66,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,1:15:39.74,1:15:40.95,Default,,0,0,0,,Олай болса!
Dialogue: 0,1:15:44.33,1:15:45.24,Default,,0,0,0,,Демон Көзі: Тағдырды анықтау.
Dialogue: 0,1:15:45.33,1:15:48.04,Default,,0,0,0,,Күте тұрыңыз! Ао, күте тұрыңыз!
Dialogue: 0,1:15:48.62,1:15:50.12,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:15:51.33,1:15:54.96,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,1:15:55.92,1:15:58.84,Default,,0,0,0,,Мені қууға болмайды
Dialogue: 0,1:16:00.59,1:16:04.60,Default,,0,0,0,,Мен сені қуғым келсе де, қолымнан келмейді.
Dialogue: 0,1:16:06.56,1:16:08.93,Default,,0,0,0,,Менің қолымнан келетіні - сені қазірден бастап шығарып салу.
Dialogue: 0,1:16:10.81,1:16:16.11,Default,,0,0,0,,Егер мен бұрынғы күйіме оралсам не болады?
Dialogue: 0,1:16:16.19,1:16:17.86,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,1:16:18.78,1:16:24.32,Default,,0,0,0,,Бірақ Ао бала сияқты жылап отыр.
Dialogue: 0,1:16:25.20,1:16:27.20,Default,,0,0,0,,Менің қолымнан келетін жалғыз нәрсе - сені шығарып салу...
Dialogue: 0,1:16:29.91,1:16:31.12,Default,,0,0,0,,Мен жыламаймын
Dialogue: 0,1:16:32.62,1:16:35.59,Default,,0,0,0,,Мен жыламаймын, жаңбыр жауып тұр
Dialogue: 0,1:16:44.09,1:16:47.89,Default,,0,0,0,,Эй, мен мұнда неге келдім?
Dialogue: 0,1:16:52.14,1:16:54.27,Default,,0,0,0,,«Неге»?
Dialogue: 0,1:17:15.83,1:17:20.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:17:22.92,1:17:23.93,Default,,0,0,0,,Ах
Dialogue: 0,1:17:26.18,1:17:27.51,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:17:29.26,1:17:30.43,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:17:30.93,1:17:34.60,Default,,0,0,0,,Сол... Кешегі үшін кешірім сұраймын.
Dialogue: 0,1:17:34.69,1:17:37.94,Default,,0,0,0,,Не? Жоқ, кешірім сұрайтын ештеңе жоқ.
Dialogue: 0,1:17:38.02,1:17:39.94,Default,,0,0,0,,Мен де көп ренжітетін істерге араластым.
Dialogue: 0,1:17:40.03,1:17:41.74,Default,,0,0,0,,-Бірақ... -(Чика) Жоқ, сондықтан...
Dialogue: 0,1:17:41.82,1:17:42.99,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,1:17:43.49,1:17:44.99,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:17:45.07,1:17:47.12,Default,,0,0,0,,Мұғалім, не жетіспейді?
Dialogue: 0,1:17:47.20,1:17:48.33,Default,,0,0,0,,Кулон
Dialogue: 0,1:17:48.41,1:17:51.41,Default,,0,0,0,,Менде үнемі тағып жүретін кулон жоқ.
Dialogue: 0,1:17:51.50,1:17:53.46,Default,,0,0,0,,Кулон... Ах!
Dialogue: 0,1:17:53.54,1:17:55.58,Default,,0,0,0,,Сол жағымсыз дәм...
Dialogue: 0,1:17:57.63,1:18:00.59,Default,,0,0,0,,Бұл менің Генкидамым.
Dialogue: 0,1:18:00.67,1:18:04.13,Default,,0,0,0,,Әр жерде әртүрлі адамдардан алынған ойлар
Dialogue: 0,1:18:04.22,1:18:05.26,Default,,0,0,0,,Шектелген
Dialogue: 0,1:18:05.84,1:18:08.89,Default,,0,0,0,,Онсыз жергілікті жүрек ән айта алмайды.
Dialogue: 0,1:18:08.97,1:18:11.81,Default,,0,0,0,,Энканың жүрегін жырлай алмайсың.
Dialogue: 0,1:18:11.89,1:18:12.72,Default,,0,0,0,,Иә
Dialogue: 0,1:18:12.81,1:18:15.89,Default,,0,0,0,,Мен мұндай жолды бұрын естіген сияқтымын...
Dialogue: 0,1:18:17.27,1:18:20.57,Default,,0,0,0,,Мұғалім, ол тіпті көлікте де болған жоқ.
Dialogue: 0,1:18:20.65,1:18:21.94,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:22.03,1:18:23.07,Default,,0,0,0,,Мұғалім
Dialogue: 0,1:18:23.15,1:18:25.57,Default,,0,0,0,,Қалай болғанда да, мен соңғы көргенім болды
Dialogue: 0,1:18:25.65,1:18:26.78,Default,,0,0,0,,Бұл қашан?
Dialogue: 0,1:18:26.86,1:18:28.91,Default,,0,0,0,,Иә? ақырында?
Dialogue: 0,1:18:28.99,1:18:30.20,Default,,0,0,0,,А, онда...
Dialogue: 0,1:18:30.28,1:18:31.99,Default,,0,0,0,,Ал...
Dialogue: 0,1:18:32.08,1:18:33.70,Default,,0,0,0,,Ах Вадо қирандылары
Dialogue: 0,1:18:33.79,1:18:34.96,Default,,0,0,0,,Міне, болды.
Dialogue: 0,1:18:35.04,1:18:38.25,Default,,0,0,0,,Бұл... Мицумина храмы ма?
Dialogue: 0,1:18:38.33,1:18:39.96,Default,,0,0,0,,Тым ләззат алу
Dialogue: 0,1:18:40.04,1:18:44.17,Default,,0,0,0,,Дәлірек айтсақ, әйелдермен қолтықтасып түскен суреттерім көп...
Dialogue: 0,1:18:44.26,1:18:48.05,Default,,0,0,0,,Хахахаха Бұл жергілікті тұрғындармен араласқан сияқты.
Dialogue: 0,1:18:48.14,1:18:50.60,Default,,0,0,0,,Бұл кешегі күн.
Dialogue: 0,1:18:50.68,1:18:53.60,Default,,0,0,0,,Аа, бұл аспан емес.
Dialogue: 0,1:18:53.68,1:18:54.77,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,1:18:54.85,1:18:56.44,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,1:18:56.52,1:18:58.85,Default,,0,0,0,,Менің соңғы кигенім...
Dialogue: 0,1:18:58.94,1:19:00.06,Default,,0,0,0,,болды
Dialogue: 0,1:19:00.15,1:19:03.40,Default,,0,0,0,,А, бұл туннель өте атмосфералық.
Dialogue: 0,1:19:03.48,1:19:06.61,Default,,0,0,0,,Қоршау бар еді, бірақ мен оны аздап өтуге тура келді.
Dialogue: 0,1:19:06.70,1:19:07.74,Default,,0,0,0,,Міне, солай!
Dialogue: 0,1:19:07.82,1:19:09.49,Default,,0,0,0,,Не болды саған? Біраз қақтығысқыш болып тұрсың ғой?
Dialogue: 0,1:19:09.57,1:19:12.49,Default,,0,0,0,,Тірі қалу сезімі күшті болды.
Dialogue: 0,1:19:12.58,1:19:14.41,Default,,0,0,0,,Ал, мен барып іздейін.
Dialogue: 0,1:19:14.49,1:19:15.37,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:15.45,1:19:16.96,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,1:19:17.04,1:19:19.04,Default,,0,0,0,,Мұғалім, қайталауға дайындалыңыз.
Dialogue: 0,1:19:19.12,1:19:22.00,Default,,0,0,0,,А... Ақане, абай болыңыз.
Dialogue: 0,1:19:36.43,1:19:37.23,Default,,0,0,0,,Ака-ни
Dialogue: 0,1:19:37.31,1:19:39.60,Default,,0,0,0,,Иә? Аой?
Dialogue: 0,1:19:41.23,1:19:42.44,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,1:19:44.19,1:19:45.36,Default,,0,0,0,,Жоқ
Dialogue: 0,1:19:45.44,1:19:46.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:47.03,1:19:48.82,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,1:19:49.40,1:19:52.99,Default,,0,0,0,,Иә, сіздің де жаттығуларыңызға сәттілік.
Dialogue: 0,1:19:54.83,1:19:57.91,Default,,0,0,0,,Енді кулонның сізге қайтарылатынына сеніңіз.
Dialogue: 0,1:19:58.50,1:20:01.75,Default,,0,0,0,,Біз не істеуіміз керек, соны істейік
Dialogue: 0,1:20:01.83,1:20:04.50,Default,,0,0,0,,Жергілікті халықтың ойын босқа жібермеңіз
Dialogue: 0,1:20:04.59,1:20:07.09,Default,,0,0,0,,Демалуға уақыт жоқ.
Dialogue: 0,1:20:07.17,1:20:09.59,Default,,0,0,0,,Мен сенің бұлай айтқаныңды сеземін.
Dialogue: 0,1:20:09.67,1:20:11.55,Default,,0,0,0,,Шинносуке ше?
Dialogue: 0,1:20:11.64,1:20:14.26,Default,,0,0,0,,А, мен тоқтауым керек жер бар.
Dialogue: 0,1:20:14.35,1:20:16.68,Default,,0,0,0,,Мен сізге кейінірек қосыламын.
Dialogue: 0,1:20:16.77,1:20:18.06,Default,,0,0,0,,Е...
Dialogue: 0,1:20:29.90,1:20:31.11,Default,,0,0,0,,Хм~
Dialogue: 0,1:20:35.66,1:20:36.66,Default,,0,0,0,,Хаа…
Dialogue: 0,1:20:37.49,1:20:38.29,Default,,0,0,0,,​​О?
Dialogue: 0,1:20:44.13,1:20:44.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:56.22,1:20:57.93,Default,,0,0,0,,...
Dialogue: 0,1:20:58.39,1:21:02.35,Default,,0,0,0,,Оны көру үшін неге сонша жол жүрдің?
Dialogue: 0,1:21:06.06,1:21:06.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:09.65,1:21:13.24,Default,,0,0,0,,(әлсіз гүрілдеу)
Dialogue: 0,1:21:13.32,1:21:14.95,Default,,0,0,0,,Хмм?
Dialogue: 0,1:21:16.95,1:21:17.95,Default,,0,0,0,,Ол шайқалды ма?
Dialogue: 0,1:21:22.29,1:21:25.17,Default,,0,0,0,,(Өсуі)
Dialogue: 0,1:21:25.25,1:21:26.33,Default,,0,0,0,,Кя~!
Dialogue: 0,1:21:27.92,1:21:31.30,Default,,0,0,0,,Иә, дәл қазір дірілдеп кетті.
Dialogue: 0,1:21:31.38,1:21:32.13,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,1:21:32.22,1:21:35.14,Default,,0,0,0,,Хмм, әзірге соңғы жаңалықтар жоқ.
Dialogue: 0,1:21:35.22,1:21:36.22,Default,,0,0,0,,Не!
Dialogue: 0,1:21:37.22,1:21:39.51,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,1:21:39.60,1:21:41.14,Default,,0,0,0,,(Кугисаки) Демек, бұрын олар үшеуі бір уақытта қарғысқа ұшыраған—
Dialogue: 0,1:21:41.22,1:21:43.48,Default,,0,0,0,,Хино жағында көшкін болды.
Dialogue: 0,1:21:43.56,1:21:46.02,Default,,0,0,0,,Неліктен туризм бөлімі ескерту беруі керек?
Dialogue: 0,1:21:46.10,1:21:47.77,Default,,0,0,0,,Бір рет артқа оралыңыз
Dialogue: 0,1:21:47.86,1:21:49.77,Default,,0,0,0,,- (Басқарушы) Көшкін? - (Нитөбе) О, құдай!
Dialogue: 0,1:21:49.86,1:21:52.74,Default,,0,0,0,,Әй, жоқ, көрініс тауда жатқан сияқты.
Dialogue: 0,1:21:52.82,1:21:56.03,Default,,0,0,0,,Әзірге ешқандай ірі шығын расталмады.
Dialogue: 0,1:21:56.53,1:21:58.49,Default,,0,0,0,,Өйткені, бұл бұрынғы жер сілкінісі еді.
Dialogue: 0,1:21:58.58,1:22:00.99,Default,,0,0,0,,Кеше аздап жаңбыр жауды.
Dialogue: 0,1:22:01.08,1:22:03.91,Default,,0,0,0,,Хино... Бұл менің әпкем барған туннель бар жер.
Dialogue: 0,1:22:04.00,1:22:05.79,Default,,0,0,0,,- (Чика) Эх - (Масамичи) Ах.
Dialogue: 0,1:22:05.87,1:22:06.58,Default,,0,0,0,,Сенің қарындасың ше?
Dialogue: 0,1:22:06.67,1:22:10.55,Default,,0,0,0,,Ао-чан, тыныштал, смартфон
Dialogue: 0,1:22:11.17,1:22:12.34,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:13.76,1:22:15.13,Default,,0,0,0,,Айои мырза...
Dialogue: 0,1:22:19.43,1:22:21.60,Default,,0,0,0,,Жоқ, қосыла алмаймын.
Dialogue: 0,1:22:21.68,1:22:24.18,Default,,0,0,0,,Жоқ, жоқ, сіз тым көп ойлап отырған шығарсыз.
Dialogue: 0,1:22:24.27,1:22:26.56,Default,,0,0,0,,Теріс ойлау жақсы емес.
Dialogue: 0,1:22:26.65,1:22:28.98,Default,,0,0,0,,Оң оң
Dialogue: 0,1:22:29.06,1:22:30.23,Default,,0,0,0,,Сіз айтасыз.
Dialogue: 0,1:22:30.32,1:22:32.73,Default,,0,0,0,,Әйтеуір, мен үкімет кеңсесіне барамын.
Dialogue: 0,1:22:32.82,1:22:36.20,Default,,0,0,0,,Мен бір нәрсені білген бойда сізге хабарласамын, осында күтіңіз.
Dialogue: 0,1:22:36.78,1:22:39.57,Default,,0,0,0,,Олай болса, профессор, мен мұны естігеніме өкінемін.
Dialogue: 0,1:22:39.66,1:22:41.91,Default,,0,0,0,,Иә, абай болыңыз.
Dialogue: 0,1:22:41.99,1:22:43.75,Default,,0,0,0,,Жарайды, Цугу, мен сенен менің артымнан жүруіңді сұраймын.
Dialogue: 0,1:22:43.83,1:22:44.87,Default,,0,0,0,,Иә
Dialogue: 0,1:22:47.12,1:22:48.38,Default,,0,0,0,,Ао-чан
Dialogue: 0,1:22:50.63,1:22:53.71,Default,,0,0,0,,Бұл не өзі! Олар кішірейіп кеткен—
Dialogue: 0,1:22:53.80,1:22:55.84,Default,,0,0,0,,А... күте тұрыңыз... Айои мырза?
Dialogue: 0,1:22:56.34,1:22:57.43,Default,,0,0,0,,Е!
Dialogue: 0,1:22:58.64,1:23:01.30,Default,,0,0,0,,Иә, сондықтан мен бұл жолмен жүрдім.
Dialogue: 0,1:23:01.39,1:23:04.56,Default,,0,0,0,,Не? О... эй! көк?
Dialogue: 0,1:23:05.35,1:23:07.06,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:23:08.56,1:23:13.19,Default,,0,0,0,,Неліктен мен орта мектепте оқимын?
Dialogue: 0,1:23:15.32,1:23:18.20,Default,,0,0,0,,Мен көремін… Күткендей…
Dialogue: 0,1:23:19.99,1:23:22.45,Default,,0,0,0,,Akane Special алуға келдің бе?
Dialogue: 0,1:23:22.53,1:23:25.08,Default,,0,0,0,,Иә? неге?
Dialogue: 0,1:23:26.00,1:23:29.71,Default,,0,0,0,,Толық емес жұмысымнан ақша жинап, Ақанмен дүкен аралауға шықтым.
Dialogue: 0,1:23:29.79,1:23:31.21,Default,,0,0,0,,Бұл қымбат гитара.
Dialogue: 0,1:23:31.84,1:23:34.88,Default,,0,0,0,,Көп жылдар бойы мен оны жалғыз қалдырып, қарап отырдым.
Dialogue: 0,1:23:37.30,1:23:38.63,Default,,0,0,0,,және бұл балалар арасында кемсітушілік пен қорлауға әкеліп соғатын сияқты.
Dialogue: 0,1:23:39.13,1:23:43.39,Default,,0,0,0,,Армандарың орындалмады деп неге сонша күйзелдің?
Dialogue: 0,1:23:44.35,1:23:45.97,Default,,0,0,0,,Бала не біледі?
Dialogue: 0,1:23:46.06,1:23:49.81,Default,,0,0,0,,Түсінгім де келмейді, лас қария туралы.
Dialogue: 0,1:23:49.89,1:23:51.60,Default,,0,0,0,,Сіз... иә?
Dialogue: 0,1:23:51.69,1:23:52.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:53.77,1:23:54.48,Default,,0,0,0,,Ах
Dialogue: 0,1:23:55.19,1:23:56.61,Default,,0,0,0,,Шин... Ах...
Dialogue: 0,1:23:58.19,1:24:01.49,Default,,0,0,0,,Иә, Шинносуке-сан?
Dialogue: 0,1:24:02.37,1:24:03.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:24:03.28,1:24:05.08,Default,,0,0,0,,Не болды? Ао
Dialogue: 0,1:24:05.66,1:24:07.29,Default,,0,0,0,,Дұрыс, Шинноның қарындасы!
Dialogue: 0,1:24:07.37,1:24:08.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:09.54,1:24:11.79,Default,,0,0,0,,Иә? Көшкін?
Dialogue: 0,1:24:11.88,1:24:13.08,Default,,0,0,0,,Ал Ақан?
Dialogue: 0,1:24:13.17,1:24:14.54,Default,,0,0,0,,Мен әлі білмеймін!
Dialogue: 0,1:24:15.09,1:24:20.84,Default,,0,0,0,,Енді Мичинко қарап жатыр, менің ойымша, бәрі жақсы.
Dialogue: 0,1:24:20.93,1:24:23.22,Default,,0,0,0,,Бірақ мен сізбен байланыса алмаймын.
Dialogue: 0,1:24:23.30,1:24:27.68,Default,,0,0,0,,Маған бұл жер ұнамайтын сияқты...
Dialogue: 0,1:24:28.39,1:24:30.69,Default,,0,0,0,,Не, таң қалмаңыз.
Dialogue: 0,1:24:30.77,1:24:34.69,Default,,0,0,0,,Ал, әзірге мен Мичинконың хабарласуын күтемін.
Dialogue: 0,1:24:35.23,1:24:37.32,Default,,0,0,0,,Неге сабырлысың?
Dialogue: 0,1:24:37.40,1:24:38.15,Default,,0,0,0,,Әй?
Dialogue: 0,1:24:38.86,1:24:41.65,Default,,0,0,0,,Сен неге тұрсың?
Dialogue: 0,1:24:41.74,1:24:43.11,Default,,0,0,0,,Неліктен...
Dialogue: 0,1:24:43.20,1:24:45.53,Default,,0,0,0,,Тезірек Ақанені табыңыз!
Dialogue: 0,1:24:45.62,1:24:47.95,Default,,0,0,0,,Неге ештеңе істемейсіз?
Dialogue: 0,1:24:48.04,1:24:49.66,Default,,0,0,0,,Сондықтан мен қазір барсам да...
Dialogue: 0,1:24:49.75,1:24:50.37,Default,,0,0,0,,Қылмыс тарихындағы ең жеккөрінішті, жүрек айнытатын қылмыскер
Dialogue: 0,1:24:50.46,1:24:51.66,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,1:24:51.75,1:24:52.75,Default,,0,0,0,,Эй
Dialogue: 0,1:24:52.83,1:24:55.17,Default,,0,0,0,,Әйелім бармаса не істеуім керек?
Dialogue: 0,1:24:56.80,1:24:58.92,Default,,0,0,0,,Мені ренжітпе
Dialogue: 0,1:25:00.05,1:25:01.38,Default,,0,0,0,,Шинно…
Dialogue: 0,1:25:02.01,1:25:04.09,Default,,0,0,0,,Үлкен музыкант болу
Dialogue: 0,1:25:04.18,1:25:07.35,Default,,0,0,0,,Ақане, сен келіп ұрламауың керек еді ғой?
Dialogue: 0,1:25:08.56,1:25:12.31,Default,,0,0,0,,Бұл минус тобы ма? Бұл Энка ма?
Dialogue: 0,1:25:12.89,1:25:13.98,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,1:25:14.06,1:25:14.77,Default,,0,0,0,,Үндетпе
Dialogue: 0,1:25:14.85,1:25:15.86,Default,,0,0,0,,және бұл балалар арасында кемсітушілік пен қорлауға әкеліп соғатын сияқты.
Dialogue: 0,1:25:15.94,1:25:19.23,Default,,0,0,0,,Мылқау, ақымақ, мен құсық батпаққа итеріп жібергендей болдым.
Dialogue: 0,1:25:19.32,1:25:20.90,Default,,0,0,0,,Болашақта сіз сияқты біреу...
Dialogue: 0,1:25:20.99,1:25:21.99,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,1:25:22.07,1:25:22.74,Default,,0,0,0,,Тоқта
Dialogue: 0,1:25:22.82,1:25:26.83,Default,,0,0,0,,Тіпті мен күнде бірдеңе істеймін.
Dialogue: 0,1:25:26.91,1:25:29.45,Default,,0,0,0,,Ах, гитара өте жақсы болды.
Dialogue: 0,1:25:29.54,1:25:32.46,Default,,0,0,0,,Егер сіз осылай ойнай алсаңыз, оны кез келген жерде жасай аласыз.
Dialogue: 0,1:25:32.54,1:25:35.83,Default,,0,0,0,,Бұл әлем байланыс пен сәттілікке негізделген.
Dialogue: 0,1:25:35.92,1:25:37.79,Default,,0,0,0,,Жақсы болсаң, қолыңнан бәрі келеді.
Dialogue: 0,1:25:37.88,1:25:39.50,Default,,0,0,0,,Ештеңені білмейтін бала
Dialogue: 0,1:25:39.59,1:25:41.67,Default,,0,0,0,,О, мен ештеңе білмеймін!
Dialogue: 0,1:25:41.76,1:25:42.30,Default,,0,0,0,,Әй?
Dialogue: 0,1:25:43.17,1:25:47.18,Default,,0,0,0,,Мен бұл жерден кете алмадым.
Dialogue: 0,1:25:47.76,1:25:48.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:49.51,1:25:50.72,Default,,0,0,0,,Шинно…
Dialogue: 0,1:25:51.22,1:25:51.93,Default,,0,0,0,,Сол күні...
Dialogue: 0,1:25:52.77,1:25:55.27,Default,,0,0,0,,Аканэ Токиоға бармауымды өтінді.
Dialogue: 0,1:25:55.35,1:25:57.52,Default,,0,0,0,,Бұл үлкен соққы болды.
Dialogue: 0,1:25:58.27,1:26:01.73,Default,,0,0,0,,Токиоға барыңыз, топ құрыңыз және тікелей эфирде ойнаңыз.
Dialogue: 0,1:26:02.36,1:26:06.45,Default,,0,0,0,,Дебют жасаңыз және күн сайын көңілді болыңыз
Dialogue: 0,1:26:06.53,1:26:08.66,Default,,0,0,0,,Бұл менің арманым еді
Dialogue: 0,1:26:09.45,1:26:13.45,Default,,0,0,0,,Барлығы —
Dialogue: 0,1:26:13.54,1:26:17.00,Default,,0,0,0,,Алғышарт Ақан сонда болады.
Dialogue: 0,1:26:18.33,1:26:21.92,Default,,0,0,0,,Үлкен музыкант болғанын айтып, мені алып кетуге келді.
Dialogue: 0,1:26:22.01,1:26:24.13,Default,,0,0,0,,Мен не болатынын білмеймін.
Dialogue: 0,1:26:25.09,1:26:29.43,Default,,0,0,0,,Мен сол кездегі мен едім, енді ешқайда кеткім келмейді.
Dialogue: 0,1:26:30.22,1:26:34.27,Default,,0,0,0,,Мәңгі осылай қалуы керек деп ойладым.
Dialogue: 0,1:26:35.85,1:26:39.44,Default,,0,0,0,,Бірақ сіз шықтыңыз.
Dialogue: 0,1:26:41.32,1:26:43.61,Default,,0,0,0,,Мен дұрыс алға жылжыдым деп ойлаймын!
Dialogue: 0,1:26:44.32,1:26:46.61,Default,,0,0,0,,Ей, ойланып көрейін.
Dialogue: 0,1:26:47.24,1:26:48.87,Default,,0,0,0,,Мен сенмін, солай ма?
Dialogue: 0,1:26:49.57,1:26:51.62,Default,,0,0,0,,Олай болса, ойлануға рұқсат етіңіз!
Dialogue: 0,1:26:52.12,1:26:55.29,Default,,0,0,0,,Менің ойымша, қате болуы мүмкін көптеген нәрселер бар.
Dialogue: 0,1:26:55.37,1:26:56.37,Default,,0,0,0,,Әлі болашақта...
Dialogue: 0,1:26:58.79,1:27:01.38,Default,,0,0,0,,Мүмкін мен сенің орнында болсам жақсы болар еді.
Dialogue: 0,1:27:04.26,1:27:06.05,Default,,0,0,0,,Ойланайыншы!
Dialogue: 0,1:27:09.18,1:27:10.18,Default,,0,0,0,,Мен...
Dialogue: 0,1:27:11.68,1:27:14.22,Default,,0,0,0,,Қарғыс атсын... Жетеді!
Dialogue: 0,1:27:14.31,1:27:15.60,Default,,0,0,0,,-Шин... -Уф!
Dialogue: 0,1:27:16.14,1:27:18.39,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,1:27:25.15,1:27:27.57,Default,,0,0,0,,Не істеп жатырсың?
Dialogue: 0,1:27:28.49,1:27:30.53,Default,,0,0,0,,Бугатти қоңырауды бастықтың киіміне бір жерге қадап қойған.
Dialogue: 0,1:27:31.49,1:27:32.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:32.49,1:27:35.62,Default,,0,0,0,,Мен сенімен бірге барамын!
Dialogue: 0,1:27:35.70,1:27:38.75,Default,,0,0,0,,(дірілдеген жіптердің дыбысы)
Dialogue: 0,1:27:38.83,1:27:44.84,Default,,0,0,0,,Ол жерде қарт адамдай қыбырлап жүре бер.
Dialogue: 0,1:27:45.34,1:27:46.30,Default,,0,0,0,,Неге...
Dialogue: 0,1:27:46.38,1:27:49.26,Default,,0,0,0,,Мен жаңа ғана тоқтадым.
Dialogue: 0,1:27:49.84,1:27:55.14,Default,,0,0,0,,Бірақ Ақанең туралы ойлану сезімі мәңгілікке жалғасады.
Dialogue: 0,1:27:56.27,1:27:59.64,Default,,0,0,0,,Мұның бәрі сіз үшін
Dialogue: 0,1:27:59.73,1:28:03.52,Default,,0,0,0,,Себебі мен жеңілмеймін...Ооооо~!
Dialogue: 0,1:28:06.03,1:28:07.61,Default,,0,0,0,,А... Ао?
Dialogue: 0,1:28:07.69,1:28:10.91,Default,,0,0,0,,Мен де жеңілмеймін!
Dialogue: 0,1:28:10.99,1:28:14.28,Default,,0,0,0,,Мен өзімнің сіңілімді қалай сезінемін!
Dialogue: 0,1:28:14.37,1:28:17.00,Default,,0,0,0,,(Қатты дірілдеген жіптердің дыбысы)
Dialogue: 0,1:28:19.79,1:28:20.71,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,1:28:20.79,1:28:24.63,Default,,0,0,0,,Оны қазірдің өзінде ұстаған дұрыс емес пе? Ао
Dialogue: 0,1:28:25.34,1:28:31.09,Default,,0,0,0,,Шулы!
Dialogue: 0,1:28:31.18,1:28:32.64,Default,,0,0,0,,(жіптің үзілген дыбысы)
Dialogue: 0,1:28:49.90,1:28:50.95,Default,,0,0,0,,Ита
Dialogue: 0,1:28:54.87,1:28:56.24,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,1:28:57.08,1:28:57.79,Default,,0,0,0,,Ах
Dialogue: 0,1:29:00.33,1:29:02.83,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:29:02.92,1:29:03.92,Default,,0,0,0,,Иә
Dialogue: 0,1:29:04.42,1:29:05.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:29:05.88,1:29:09.01,Default,,0,0,0,,Ал, біз барамыз.
Dialogue: 0,1:29:09.09,1:29:11.34,Default,,0,0,0,,Қарт не істеу керек?
Dialogue: 0,1:29:12.09,1:29:14.47,Default,,0,0,0,,Не... не істеуім керек...
Dialogue: 0,1:29:15.05,1:29:15.93,Default,,0,0,0,,Мен...
Dialogue: 0,1:29:16.01,1:29:17.18,Default,,0,0,0,,Кеттік, Ао!
Dialogue: 0,1:29:17.26,1:29:18.89,Default,,0,0,0,,Әй, иә! Күте тұрыңыз...
Dialogue: 0,1:29:18.97,1:29:20.18,Default,,0,0,0,,Сәлем сен!
Dialogue: 0,1:29:24.44,1:29:27.15,Default,,0,0,0,,Өзіңнің өзімшіл нәрселеріңді айта бересің!
Dialogue: 0,1:29:29.78,1:29:32.53,Default,,0,0,0,,Эй... Шинно!
Dialogue: 0,1:29:32.61,1:29:34.11,Default,,0,0,0,,-Хахаха! -Асығыңыз!
Dialogue: 0,1:29:34.20,1:29:35.49,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,1:29:36.16,1:29:37.37,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,1:29:37.45,1:29:38.74,Default,,0,0,0,,Егер Урарака Качанға тиіп қалса—
Dialogue: 0,1:29:38.83,1:29:41.37,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,1:29:45.29,1:29:47.54,Default,,0,0,0,,Мені күтіңіз~ Акане~!
Dialogue: 0,1:29:47.63,1:29:51.26,Default,,0,0,0,,Уау! Ахх!
Dialogue: 0,1:29:54.55,1:29:55.72,Default,,0,0,0,,Ұшу...
Dialogue: 0,1:29:55.80,1:29:58.39,Default,,0,0,0,,Бұл не, ақымақтық!
Dialogue: 0,1:29:58.47,1:30:00.60,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,1:30:02.18,1:30:04.48,Default,,0,0,0,,-Хахахаха! -Апыр-ай!
Dialogue: 0,1:30:04.56,1:30:06.69,Default,,0,0,0,,Ой, бұл не болып жатыр?
Dialogue: 0,1:30:06.77,1:30:10.32,Default,,0,0,0,,Мен мұны естігім келеді!
Dialogue: 0,1:30:10.40,1:30:13.69,Default,,0,0,0,,Хаа... еш жерде такси жоқ.
Dialogue: 0,1:30:13.78,1:30:15.86,Default,,0,0,0,,Ауылды қарғыс атсын!
Dialogue: 0,1:30:36.34,1:30:41.01,Default,,0,0,0,,Сол фотоны қарап отырып, көп нәрсені түсіндім.
Dialogue: 0,1:30:41.51,1:30:42.77,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,1:30:43.27,1:30:45.98,Default,,0,0,0,,Бұл жігіт Анки
Dialogue: 0,1:30:46.48,1:30:50.11,Default,,0,0,0,,Мен өзімді құлыптау арқылы ғана алға жылжи алдым.
Dialogue: 0,1:30:50.86,1:30:53.48,Default,,0,0,0,,Моккай, мен сенімен бетпе-бет келмек болдым.
Dialogue: 0,1:31:06.91,1:31:09.83,Default,,0,0,0,,Бұл сезім менің де ішімде
Dialogue: 0,1:31:10.59,1:31:13.63,Default,,0,0,0,,Өкінбе
Dialogue: 0,1:31:14.63,1:31:17.80,Default,,0,0,0,,Жоқ, сондықтан қауіпсіздікті тексеру аяқталғанша.
Dialogue: 0,1:31:17.88,1:31:20.89,Default,,0,0,0,,Бұдан былай көлікпен кіре алмайсыз.
Dialogue: 0,1:31:20.97,1:31:22.51,Default,,0,0,0,,Жол бойындағы вокзалдан бір көшеге артқа...
Dialogue: 0,1:31:22.60,1:31:25.35,Default,,0,0,0,,Жетеді! Бұл жақсы балық аулау
Dialogue: 0,1:31:25.43,1:31:26.85,Default,,0,0,0,,Иә? Эй
Dialogue: 0,1:31:27.35,1:31:28.81,Default,,0,0,0,,Тек машина жақсы емес.
Dialogue: 0,1:31:29.40,1:31:31.48,Default,,0,0,0,,- (Шинносуке) Олай болса... - (Або) Сен... Шинсің бе?
Dialogue: 0,1:31:31.56,1:31:33.27,Default,,0,0,0,,- (Шинносуке) А? -(Або) Бұл менмін, менмін.
Dialogue: 0,1:31:33.36,1:31:34.53,Default,,0,0,0,,Або
Dialogue: 0,1:31:34.61,1:31:35.44,Default,,0,0,0,,Ах
Dialogue: 0,1:31:35.53,1:31:37.40,Default,,0,0,0,,Біраз уақыт өтті. Қашан қайтасыз?
Dialogue: 0,1:31:37.49,1:31:38.24,Default,,0,0,0,,Нашар!
Dialogue: 0,1:31:38.32,1:31:40.41,Default,,0,0,0,,Мен асығыспын. Менің сөйлесуге уақытым жоқ.
Dialogue: 0,1:31:40.49,1:31:42.62,Default,,0,0,0,,Ах... Эй! Бір минут күтіңіз
Dialogue: 0,1:31:42.70,1:31:44.66,Default,,0,0,0,,Қайда асығыс бара жатырсың?
Dialogue: 0,1:31:44.74,1:31:46.41,Default,,0,0,0,,Бұл Гандхара!
Dialogue: 0,1:31:47.71,1:31:48.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:50.21,1:31:54.25,Default,,0,0,0,,Сондықтан мен сонда болдым.
Dialogue: 0,1:31:54.96,1:31:56.34,Default,,0,0,0,,Өкінішті...
Dialogue: 0,1:31:57.47,1:31:59.34,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:31:59.43,1:32:00.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:03.26,1:32:07.43,Default,,0,0,0,,Сүйген адамыңның сезімін қолдай алмасаң
Dialogue: 0,1:32:09.27,1:32:11.23,Default,,0,0,0,,Сіз әрқашан өкінесіз
Dialogue: 0,1:32:13.36,1:32:18.86,Default,,0,0,0,,Мен білемін, өйткені мен сіңілімді асырай алмадым.
Dialogue: 0,1:32:19.74,1:32:20.53,Default,,0,0,0,,Ao...
Dialogue: 0,1:32:21.16,1:32:27.75,Default,,0,0,0,,Сондықтан мен Шинно мен Шинносүкені қолдаймын.
Dialogue: 0,1:32:33.17,1:32:34.34,Default,,0,0,0,,Иә
Dialogue: 0,1:32:34.42,1:32:35.25,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:32:35.75,1:32:36.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:37.00,1:32:38.80,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,1:32:51.39,1:32:52.77,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,1:32:52.85,1:32:53.65,Default,,0,0,0,,Не...
Dialogue: 0,1:32:54.15,1:32:58.99,Default,,0,0,0,,Балаға дем алсаң, жылауын тоқтатады дейді.
Dialogue: 0,1:33:06.83,1:33:08.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:33:08.83,1:33:10.16,Default,,0,0,0,,Шулы
Dialogue: 0,1:33:14.71,1:33:17.55,Default,,0,0,0,,Аспан көк
Dialogue: 0,1:33:21.47,1:33:23.93,Default,,0,0,0,,Сыртқа шыққым келді, бірақ шыққым келді.
Dialogue: 0,1:33:25.18,1:33:27.18,Default,,0,0,0,,Өте әдемі болды.
Dialogue: 0,1:33:30.31,1:33:31.39,Default,,0,0,0,,О
Dialogue: 0,1:33:34.69,1:33:35.98,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:33:46.41,1:33:48.91,Default,,0,0,0,,О, Хакен!
Dialogue: 0,1:33:49.41,1:33:52.62,Default,,0,0,0,,Қандай қиыншылық.
Dialogue: 0,1:33:52.71,1:33:55.33,Default,,0,0,0,,Сіз осындай жағдайда болсаңыз да
Dialogue: 0,1:33:56.04,1:33:58.25,Default,,0,0,0,,Мен қатты уайымдап тұрмын.
Dialogue: 0,1:34:03.26,1:34:04.72,Default,,0,0,0,,Шинно?
Dialogue: 0,1:34:08.26,1:34:10.26,Default,,0,0,0,,(Синносукенің ауыр тыныс алуы)
Dialogue: 0,1:34:11.52,1:34:12.52,Default,,0,0,0,,Ах
Dialogue: 0,1:34:14.10,1:34:15.10,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,1:34:15.19,1:34:18.98,Default,,0,0,0,,Ха ха ха... мен қайдамын?
Dialogue: 0,1:34:19.61,1:34:20.40,Default,,0,0,0,,Ақан ше?
Dialogue: 0,1:34:24.45,1:34:25.86,Default,,0,0,0,,Ha
Dialogue: 0,1:34:25.95,1:34:29.33,Default,,0,0,0,,Мен түсіндім, бұл күлкілі.
Dialogue: 0,1:34:30.03,1:34:31.54,Default,,0,0,0,,Шинноға ұқсайды.
Dialogue: 0,1:34:31.62,1:34:32.95,Default,,0,0,0,,Сенесің бе?
Dialogue: 0,1:34:33.04,1:34:36.62,Default,,0,0,0,,Өйткені шын мәнінде Шин осында.
Dialogue: 0,1:34:36.71,1:34:39.92,Default,,0,0,0,,Әй, сен тым қыңырсың.
Dialogue: 0,1:34:40.00,1:34:41.84,Default,,0,0,0,,О, бірақ бәрібір.
Dialogue: 0,1:34:41.92,1:34:42.55,Default,,0,0,0,,Әй?
Dialogue: 0,1:34:43.17,1:34:44.63,Default,,0,0,0,,Бұл жерде қараңғы
Dialogue: 0,1:34:45.13,1:34:48.05,Default,,0,0,0,,Жарық жер болса, қартайғаныңды білерсің.
Dialogue: 0,1:34:48.84,1:34:51.26,Default,,0,0,0,,Шинно, сен менің көңілімді қалдырасың.
Dialogue: 0,1:34:51.35,1:34:52.81,Default,,0,0,0,,Сендер-ай, шіркін!
Dialogue: 0,1:34:52.89,1:34:54.81,Default,,0,0,0,,Мен қазір Ақанені дұрыс көрдім.
Dialogue: 0,1:34:54.89,1:34:56.77,Default,,0,0,0,,Не? қашан қайда?
Dialogue: 0,1:34:56.85,1:34:57.77,Default,,0,0,0,,ғибадатханада
Dialogue: 0,1:34:58.98,1:35:02.78,Default,,0,0,0,,Мен Аоны тексеруге келгенде және оған күріш шарларын әкелгенде.
Dialogue: 0,1:35:02.86,1:35:05.36,Default,,0,0,0,,Уау, шын ба?
Dialogue: 0,1:35:05.44,1:35:07.78,Default,,0,0,0,,Бұл ламинария болды.
Dialogue: 0,1:35:08.32,1:35:09.62,Default,,0,0,0,,-Хмм? -Онигири
Dialogue: 0,1:35:09.70,1:35:11.91,Default,,0,0,0,,Туна мен майоны ұнатамын десем де.
Dialogue: 0,1:35:11.99,1:35:14.16,Default,,0,0,0,,Әрқашан Аоның сүйікті ламинариясымен бірге
Dialogue: 0,1:35:14.25,1:35:16.54,Default,,0,0,0,,Хехе, кешіріңіз.
Dialogue: 0,1:35:16.62,1:35:20.13,Default,,0,0,0,,Бірақ мен қазір түсіндім.
Dialogue: 0,1:35:20.21,1:35:21.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:24.05,1:35:27.30,Default,,0,0,0,,«Құдықтағы бақа мұхитты білмейді»
Dialogue: 0,1:35:28.01,1:35:30.89,Default,,0,0,0,,«Алайда мен аспанның қаншалықты көгілдір екенін білемін»
Dialogue: 0,1:35:32.68,1:35:34.43,Default,,0,0,0,,Ақанның жақсы көретін сөздері
Dialogue: 0,1:35:35.10,1:35:36.39,Default,,0,0,0,,Шинно?
Dialogue: 0,1:35:37.14,1:35:39.81,Default,,0,0,0,,тунец пен майо балдырлармен бәсекелесе алмайды.
Dialogue: 0,1:35:40.31,1:35:42.61,Default,,0,0,0,,Аспанның қандай көгілдір екенін білгенде
Dialogue: 0,1:35:49.32,1:35:51.07,Default,,0,0,0,,Сүйкімді болып шықты, солай емес пе?
Dialogue: 0,1:35:51.16,1:35:54.99,Default,,0,0,0,,А? Пфффффф...
Dialogue: 0,1:35:55.91,1:35:57.29,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:35:57.79,1:35:59.04,Default,,0,0,0,,Ол үлкейе берді.
Dialogue: 0,1:35:59.12,1:36:04.50,Default,,0,0,0,,Дос емес, ебедейсіз және ақылсыз
Dialogue: 0,1:36:06.01,1:36:08.67,Default,,0,0,0,,Бірақ бұл өте тура.
Dialogue: 0,1:36:08.76,1:36:09.76,Default,,0,0,0,,Иә
Dialogue: 0,1:36:10.34,1:36:16.85,Default,,0,0,0,,Ол Шинноға өте ұқсайды, өйткені ол тура және ақымақ.
Dialogue: 0,1:36:16.93,1:36:17.93,Default,,0,0,0,,Иә
Dialogue: 0,1:36:18.98,1:36:20.31,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,1:36:21.19,1:36:22.10,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:36:22.86,1:36:27.03,Default,,0,0,0,,Кішкентай әпкеңді бәрінен де қадірлей алатын сенсің.
Dialogue: 0,1:36:31.03,1:36:34.66,Default,,0,0,0,,Саған ғашық болғаныма қуаныштымын
Dialogue: 0,1:36:39.29,1:36:40.83,Default,,0,0,0,,Жоқ
Dialogue: 0,1:36:40.92,1:36:44.21,Default,,0,0,0,,Өйткені біз оның қайтадан қашан құлайтынын білмейміз.
Dialogue: 0,1:36:44.29,1:36:46.00,Default,,0,0,0,,Аспанда ұша білу керек
Dialogue: 0,1:36:46.09,1:36:48.84,Default,,0,0,0,,Мені жіберіңізші! Акане...
Dialogue: 0,1:36:49.76,1:36:50.76,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:50.84,1:36:52.30,Default,,0,0,0,,Сіз не істеп жатырсыз? Балалар сендер
Dialogue: 0,1:36:53.89,1:36:54.55,Default,,0,0,0,,О
Dialogue: 0,1:36:55.85,1:36:57.10,Default,,0,0,0,,Акане Жақсы...
Dialogue: 0,1:36:57.18,1:36:57.97,Default,,0,0,0,,-Аой! -Уау
Dialogue: 0,1:36:58.60,1:37:00.85,Default,,0,0,0,,Эй... Ака-ни Шиге...
Dialogue: 0,1:37:00.94,1:37:02.14,Default,,0,0,0,,Не? Қорқынышты
Dialogue: 0,1:37:02.23,1:37:03.94,Default,,0,0,0,,Бұдан жақсырақ болды ма?
Dialogue: 0,1:37:04.02,1:37:07.02,Default,,0,0,0,,Ештеңе емес, мен уайымдаймын.
Dialogue: 0,1:37:07.11,1:37:10.74,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Барлығы уайымдады.
Dialogue: 0,1:37:10.82,1:37:14.95,Default,,0,0,0,,Кешіріңіз, Аой, сізді алаңдатқаным үшін~
Dialogue: 0,1:37:16.87,1:37:20.70,Default,,0,0,0,,Бұл рас!
Dialogue: 0,1:37:42.48,1:37:44.98,Default,,0,0,0,,Иә? Үйге жалғыз барасың ба?
Dialogue: 0,1:37:45.06,1:37:45.69,Default,,0,0,0,,Иә
Dialogue: 0,1:37:45.77,1:37:48.94,Default,,0,0,0,,Иә? Неліктен? Әр адам дұрыс міне алады.
Dialogue: 0,1:37:49.02,1:37:52.61,Default,,0,0,0,,Жоқ, жоқ, әпкемнің көлігінде төртеумізге қиын.
Dialogue: 0,1:37:52.70,1:37:55.03,Default,,0,0,0,,Жолда такси алыңыз
Dialogue: 0,1:37:55.11,1:37:56.32,Default,,0,0,0,,Жоқ, онда мен...
Dialogue: 0,1:37:56.41,1:37:59.33,Default,,0,0,0,,Жоқ, үшеуміз барамыз.
Dialogue: 0,1:38:00.16,1:38:01.45,Default,,0,0,0,,Аой?
Dialogue: 0,1:38:03.46,1:38:05.71,Default,,0,0,0,,Джейн Шинно
Dialogue: 0,1:38:07.29,1:38:11.42,Default,,0,0,0,,О, рахмет, көз алмасы жұлдыз
Dialogue: 0,1:38:27.23,1:38:32.23,Default,,0,0,0,,Иә? Мына жігіт ұйықтап жатыр ма?
Dialogue: 0,1:38:33.90,1:38:37.07,Default,,0,0,0,,Жарайды, сен қолыңнан келгеннің бәрін жасадың.
Dialogue: 0,1:38:42.54,1:38:45.00,Default,,0,0,0,,- (Шинносуке) Менмін - А?
Dialogue: 0,1:38:45.58,1:38:49.04,Default,,0,0,0,,Мен дұрыс алға жылжып жатырмын деп ойлаймын.
Dialogue: 0,1:38:49.13,1:38:50.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:51.00,1:38:53.96,Default,,0,0,0,,Бірақ мұның бәрі әлі де орындалып жатқан жұмыс.
Dialogue: 0,1:38:55.84,1:38:58.59,Default,,0,0,0,,Жолда жүргенім есіме түсті.
Dialogue: 0,1:39:00.10,1:39:04.48,Default,,0,0,0,,Сондықтан мен де берілгім келмейді.
Dialogue: 0,1:39:06.10,1:39:07.10,Default,,0,0,0,,Иә
Dialogue: 0,1:39:08.90,1:39:12.32,Default,,0,0,0,,Сондықтан мен де сенен бас тартпаймын.
Dialogue: 0,1:39:12.40,1:39:14.57,Default,,0,0,0,,Иә? иә? …және
Dialogue: 0,1:39:23.08,1:39:24.95,Default,,0,0,0,,«Үш адам»?
Dialogue: 0,1:39:27.58,1:39:29.54,Default,,0,0,0,,Түсіндім, Аой
Dialogue: 0,1:39:30.17,1:39:33.55,Default,,0,0,0,,Ол кезде мен сияқты еді.
Dialogue: 0,1:39:44.43,1:39:48.98,Default,,0,0,0,,Мүмкін келесі жолы тунец майосы күріш шарларын жасап көремін.
Dialogue: 0,1:39:49.06,1:39:51.36,Default,,0,0,0,,Иә?иә?
Dialogue: 0,1:39:52.19,1:39:53.82,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,1:39:55.15,1:39:55.98,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:05.20,1:40:08.91,Default,,0,0,0,,(Аоидың ауыр тыныс алуы)
Dialogue: 0,1:40:15.67,1:40:18.34,Default,,0,0,0,,Ахх!
Dialogue: 0,1:40:24.39,1:40:26.97,Default,,0,0,0,,Мен жыламаймын!
Dialogue: 0,1:40:38.94,1:40:39.95,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:41.32,1:40:43.24,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,1:40:52.92,1:40:58.30,Default,,0,0,0,,Жылау... емес...
Dialogue: 0,1:41:04.34,1:41:06.06,Default,,0,0,0,,Шинно Бака
Dialogue: 0,1:41:23.53,1:41:25.03,Default,,0,0,0,,Хмм…
Dialogue: 0,1:41:26.24,1:41:27.16,Default,,0,0,0,,Әй!
Dialogue: 0,1:41:30.83,1:41:33.25,Default,,0,0,0,,Әй, аспан...
Dialogue: 0,1:41:35.29,1:41:36.75,Default,,0,0,0,,Көк
Dialogue: 0,1:41:36.84,1:41:38.84,Default,,0,0,0,,♪~
Dialogue: 0,1:46:18.16,1:46:20.16,Default,,0,0,0,,~♪
Dialogue: 0,1:46:21.66,1:46:27.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory