Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:31.86,0:00:33.40,Default,,0,0,0,,Жақында мен…
Dialogue: 0,0:00:33.99,0:00:38.03,Default,,0,0,0,,Бұл өмірді бақытты етіп аяқта
Dialogue: 0,0:00:48.25,0:00:52.01,Default,,0,0,0,,Ол әлі тірі ме?
Dialogue: 0,0:01:07.06,0:01:08.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:14.74,0:01:18.45,Default,,0,0,0,,Бүгінгі беттегі 1-ескертпенің кестесі—
Dialogue: 0,0:01:18.57,0:01:20.33,Default,,0,0,0,,Кесте енгізілді
Dialogue: 0,0:01:20.95,0:01:26.08,Default,,0,0,0,,17 тамыз сағат 10.00 Шоу-дори қиылысы
Dialogue: 0,0:01:29.04,0:01:31.17,Default,,0,0,0,,Есіңізде жоқ жоспарлар?
Dialogue: 0,0:01:31.21,0:01:32.88,Default,,0,0,0,,Иә
Dialogue: 0,0:01:32.92,0:01:37.97,Default,,0,0,0,,Менің IP терминалыма жадымда жоқ кесте енгізілді.
Dialogue: 0,0:01:43.22,0:01:46.14,Default,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:01:47.06,0:01:49.44,Default,,0,0,0,,Шамамен екі жарым сағат қалды.
Dialogue: 0,0:01:50.23,0:01:52.86,Default,,0,0,0,,Параллель дүниеден бір қарт келеді...
Dialogue: 0,0:01:52.98,0:01:54.44,Default,,0,0,0,,Сіз оны жай ғана терген жоқсыз ба?
Dialogue: 0,0:01:55.65,0:01:59.03,Default,,0,0,0,,А, мүмкін солай шығар.
Dialogue: 0,0:01:59.07,0:02:00.66,Default,,0,0,0,,Немесе—
Dialogue: 0,0:02:00.70,0:02:03.29,Default,,0,0,0,,Не жазғанымды ұмытып кететінім сонша.
Dialogue: 0,0:02:03.33,0:02:05.37,Default,,0,0,0,,Атам жынды болды ма?
Dialogue: 0,0:02:05.45,0:02:07.29,Default,,0,0,0,,Махаббат! (Күнтізбе) Иә
Dialogue: 0,0:02:07.41,0:02:10.04,Default,,0,0,0,,Бұл ықтималырақ.
Dialogue: 0,0:02:11.42,0:02:13.63,Default,,0,0,0,,Сонымен барасың ба?
Dialogue: 0,0:02:14.63,0:02:16.22,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:02:16.97,0:02:19.39,Default,,0,0,0,,Бұл уәде сияқты.
Dialogue: 0,0:02:19.47,0:02:21.47,Default,,0,0,0,,Бармағаныңыз жөн, ата.
Dialogue: 0,0:02:21.51,0:02:22.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:23.35,0:02:24.52,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:24.89,0:02:26.52,Default,,0,0,0,,Менің ойымша, бұл бұлыңғыр...
Dialogue: 0,0:02:26.60,0:02:27.81,Default,,0,0,0,,Оған назар аударыңыз
Dialogue: 0,0:02:27.89,0:02:30.52,Default,,0,0,0,,Махаббат! Енді ол туралы алаңдамаңыз
Dialogue: 0,0:02:30.90,0:02:34.15,Default,,0,0,0,,Ал салқындатылған шоколад - сағат 3-те дәм.
Dialogue: 0,0:02:34.65,0:02:36.36,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:36.82,0:02:39.95,Default,,0,0,0,,Түскі асқа дейін бөлмеңде оқисың, солай ма?
Dialogue: 0,0:02:40.49,0:02:44.24,Default,,0,0,0,,Сондықтан мен оқуымды сүйемелдеу үшін арпа шайын қолданамын.
Dialogue: 0,0:02:49.37,0:02:52.84,Default,,0,0,0,,(жылжымалы есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:02:52.96,0:02:54.75,Default,,0,0,0,,Мен бұл күндері бастауыш сынып оқушысымын.
Dialogue: 0,0:02:54.88,0:02:58.38,Default,,0,0,0,,Сіз параллель әлем сөзін білесіз.
Dialogue: 0,0:02:58.59,0:03:00.59,Default,,0,0,0,,Төменгі сыныптарда үйренетін сияқты.
Dialogue: 0,0:03:00.76,0:03:02.30,Default,,0,0,0,,Ели айтты
Dialogue: 0,0:03:03.47,0:03:04.64,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:05.60,0:03:07.35,Default,,0,0,0,,Неге бармайсың?
Dialogue: 0,0:03:07.43,0:03:08.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:08.64,0:03:10.14,Default,,0,0,0,,Сізге қызық па?
Dialogue: 0,0:03:11.19,0:03:13.65,Default,,0,0,0,,Мүмкін барсам, есіме түсіп қалар.
Dialogue: 0,0:03:14.44,0:03:17.40,Default,,0,0,0,,Иә, жақын жерде.
Dialogue: 0,0:03:24.16,0:03:25.66,Default,,0,0,0,,Мен біраз уақытқа барамын.
Dialogue: 0,0:03:25.70,0:03:27.87,Default,,0,0,0,,Иә, абай болыңыз.
Dialogue: 0,0:03:27.91,0:03:29.33,Default,,0,0,0,,Иә
Dialogue: 0,0:03:30.12,0:03:32.29,Default,,0,0,0,,Күте тұрыңыз (күнтізбе) Иә?
Dialogue: 0,0:03:32.37,0:03:35.17,Default,,0,0,0,,Мен қазір қалпақ алып келейін.
Dialogue: 0,0:03:35.79,0:03:37.67,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:03:38.92,0:03:40.13,Default,,0,0,0,,Бұл?
Dialogue: 0,0:03:46.93,0:03:50.39,Default,,0,0,0,,(Бағдаршам сигналы сигналы)
Dialogue: 0,0:04:12.54,0:04:15.33,Default,,0,0,0,,Әй, мұндай жерде не болып жатыр?
Dialogue: 0,0:04:15.42,0:04:16.71,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:04:20.26,0:04:22.47,Default,,0,0,0,,Сен мені алып кетуге келдің бе?
Dialogue: 0,0:04:23.72,0:04:26.60,Default,,0,0,0,,Иә, мен сені алып кетуге келдім.
Dialogue: 0,0:04:44.28,0:04:45.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:46.16,0:04:51.41,Default,,0,0,0,,(Бағдаршам сигналы сигналы)
Dialogue: 0,0:04:51.58,0:04:53.50,Default,,0,0,0,,Сигнал өзгереді
Dialogue: 0,0:04:53.58,0:04:56.83,Default,,0,0,0,,Жаяу жүргіншілер өткелінің ішінде тоқтамаңыз
Dialogue: 0,0:05:02.09,0:05:05.51,Default,,0,0,0,,Өтіп бара жатып тоқтамаңыз
Dialogue: 0,0:05:12.35,0:05:14.56,Default,,0,0,0,,Параллельді жылжу жасадыңыз ба?
Dialogue: 0,0:05:15.35,0:05:17.19,Default,,0,0,0,,IEPP көрсету
Dialogue: 0,0:05:22.94,0:05:24.07,Default,,0,0,0,,Қате...?
Dialogue: 0,0:05:25.15,0:05:27.11,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:05:39.08,0:05:41.05,Default,,0,0,0,,Адам дүниеге келген сәттен бастап-
Dialogue: 0,0:05:41.13,0:05:42.80,Default,,0,0,0,,Біз сансыз таңдау жасадық.
Dialogue: 0,0:05:44.34,0:05:47.72,Default,,0,0,0,,Сол таңдауда мен таңдамаған дүние...
Dialogue: 0,0:05:47.80,0:05:52.35,Default,,0,0,0,,Параллель дүние Басқаша айтқанда, бұл параллель әлем...
Dialogue: 0,0:05:52.43,0:05:54.27,Default,,0,0,0,,Қазір дәлелденді
Dialogue: 0,0:05:56.94,0:06:00.81,Default,,0,0,0,,Параллель дүниелер арқылы жылжу үшін параллель жылжу.
Dialogue: 0,0:06:01.48,0:06:05.15,Default,,0,0,0,,Бірақ бұл дененің физикалық қозғалыста екенін білдірмейді.
Dialogue: 0,0:06:05.61,0:06:08.82,Default,,0,0,0,,«Қиял» деп аталатын сана ғана ауыстырылады.
Dialogue: 0,0:06:09.66,0:06:13.45,Default,,0,0,0,,Кішігірім параллель жылжулар күнделікті орын алады, бірақ...
Dialogue: 0,0:06:13.83,0:06:15.79,Default,,0,0,0,,Елеусіз
Dialogue: 0,0:06:17.29,0:06:20.13,Default,,0,0,0,,Кейде мен тастаған нәрселер жоғалып кетеді.
Dialogue: 0,0:06:20.21,0:06:23.25,Default,,0,0,0,,Тек сенімді болу үшін мен қайта тексеріп, таптым...
Dialogue: 0,0:06:23.38,0:06:26.01,Default,,0,0,0,,Көбінесе кішігірім параллель жылжулардан туындайды
Dialogue: 0,0:06:28.38,0:06:30.68,Default,,0,0,0,,Бірегей әлем 0-ге тең деп есептей отырып,
Dialogue: 0,0:06:30.80,0:06:32.55,Default,,0,0,0,,0-ден қираған әлем
Dialogue: 0,0:06:32.64,0:06:35.39,Default,,0,0,0,,Жоғалмаған әлемге ауысу -
Dialogue: 0,0:06:35.47,0:06:37.43,Default,,0,0,0,,Ол қайтадан 0-ге оралды.
Dialogue: 0,0:06:41.19,0:06:42.73,Default,,0,0,0,,0-ден неғұрлым алыс болса —
Dialogue: 0,0:06:42.86,0:06:44.69,Default,,0,0,0,,Физикалық дүниедегі айырмашылықтар кеңейіп келеді
Dialogue: 0,0:06:46.07,0:06:48.70,Default,,0,0,0,,Сіз 0-ден басқа кәсіпте жұмыс істейсіз бе?
Dialogue: 0,0:06:48.78,0:06:50.78,Default,,0,0,0,,Басқа серіктеске үйленген...
Dialogue: 0,0:06:51.53,0:06:55.16,Default,,0,0,0,,Бірақ мұның бәрі таңдаудан тыс дүние.
Dialogue: 0,0:06:56.91,0:06:59.67,Default,,0,0,0,,Мен жасаған бірінші үлкен таңдау...
Dialogue: 0,0:06:59.75,0:07:01.50,Default,,0,0,0,,Мен жеті жаста едім.
Dialogue: 0,0:07:03.34,0:07:06.38,Default,,0,0,0,,Әкеммен (Маюми Такасаки) Анаммен
Dialogue: 0,0:07:06.46,0:07:07.88,Default,,0,0,0,,Сіз қайсысымен барасыз?
Dialogue: 0,0:07:08.42,0:07:10.76,Default,,0,0,0,,Менің ата-анам қай жерде және қалай айтты?
Dialogue: 0,0:07:10.84,0:07:12.47,Default,,0,0,0,,Енді есімде жоқ
Dialogue: 0,0:07:12.76,0:07:14.89,Default,,0,0,0,,Бірақ оның мағынасы осы.
Dialogue: 0,0:07:15.89,0:07:18.89,Default,,0,0,0,,Мен не ойладым, не айттым?
Dialogue: 0,0:07:20.44,0:07:23.31,Default,,0,0,0,,Ата-анам ажырасқаннан кейін де айына бірнеше рет—
Dialogue: 0,0:07:23.44,0:07:25.90,Default,,0,0,0,,Үшеуміз дүкен аралап, көңіл көтердік.
Dialogue: 0,0:07:26.61,0:07:27.73,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:07:27.82,0:07:30.82,Default,,0,0,0,,Қызықты уақыт өткен соң әкеммен қоштастым.
Dialogue: 0,0:07:31.11,0:07:34.41,Default,,0,0,0,,Мен анаммен ол туған үйге қайтамын.
Dialogue: 0,0:07:35.66,0:07:38.04,Default,,0,0,0,,Анамның үйі кең, бірақ өте ескі...
Dialogue: 0,0:07:38.20,0:07:40.12,Default,,0,0,0,,«Атам бала кезінде
Dialogue: 0,0:07:40.21,0:07:41.96,Default,,0,0,0,,Ол әлдеқашан ескі еді».
Dialogue: 0,0:07:42.08,0:07:44.00,Default,,0,0,0,,...атам айтқандай жаста.
Dialogue: 0,0:07:45.13,0:07:48.05,Default,,0,0,0,,Екінші қабат болмаса да, екі кіреберіс болды...
Dialogue: 0,0:07:48.26,0:07:50.26,Default,,0,0,0,,Екі отбасылық үй емес
Dialogue: 0,0:07:50.51,0:07:51.59,Default,,0,0,0,,«Кесте бұл...
Dialogue: 0,0:07:51.68,0:07:54.72,Default,,0,0,0,,Оны тек Жаңа жыл және ерекше күндерде ашуға болады».
Dialogue: 0,0:07:55.10,0:07:57.93,Default,,0,0,0,,«Мен әдетте артқы жағындағы кішісін ғана қолданамын.»
Dialogue: 0,0:07:59.06,0:08:00.85,Default,,0,0,0,,Үйдегі атасы мен әжесі—
Dialogue: 0,0:08:00.98,0:08:03.31,Default,,0,0,0,,Сол кезде үлкен ит болды.
Dialogue: 0,0:08:05.40,0:08:07.94,Default,,0,0,0,,Ауладағы тоғанда балық та, тасбақа да жоқ.
Dialogue: 0,0:08:08.44,0:08:10.44,Default,,0,0,0,,Бөлмелердің көпшілігі бос -
Dialogue: 0,0:08:11.20,0:08:13.95,Default,,0,0,0,,Тек ауа мен төбелер көп болды.
Dialogue: 0,0:08:16.49,0:08:18.45,Default,,0,0,0,,Хаха...
Dialogue: 0,0:08:24.08,0:08:26.38,Default,,0,0,0,,(ойыншық мылтық ату дыбысы)
Dialogue: 0,0:08:26.92,0:08:30.63,Default,,0,0,0,,(ойыншық мылтық ату дыбысы)
Dialogue: 0,0:08:32.17,0:08:34.59,Default,,0,0,0,,Күнтізбе Бұл не болды?
Dialogue: 0,0:08:34.72,0:08:37.85,Default,,0,0,0,,Өткенде әкеммен кездескенде, ол маған оны сатып алды.
Dialogue: 0,0:08:37.93,0:08:40.31,Default,,0,0,0,,8-ші туған күніне сыйлық!
Dialogue: 0,0:08:50.82,0:08:51.90,Default,,0,0,0,,Юно
Dialogue: 0,0:08:53.28,0:08:55.41,Default,,0,0,0,,Өрт
Dialogue: 0,0:08:55.49,0:08:57.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:57.45,0:08:58.95,Default,,0,0,0,,Саған әлі ерте
Dialogue: 0,0:09:00.04,0:09:03.25,Default,,0,0,0,,Мақсатты жас 10 жас және одан жоғары екенін айтады.
Dialogue: 0,0:09:03.87,0:09:07.67,Default,,0,0,0,,Иә, бірақ басқа балаларда да бар.
Dialogue: 0,0:09:07.96,0:09:10.84,Default,,0,0,0,,Басқа балалардың жаман қылығына еліктеудің қажеті жоқ.
Dialogue: 0,0:09:10.92,0:09:12.26,Default,,0,0,0,,Ата!
Dialogue: 0,0:09:15.51,0:09:17.51,Default,,0,0,0,,(Юноның үрген дауысы)
Dialogue: 0,0:09:17.68,0:09:19.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:19.76,0:09:21.31,Default,,0,0,0,,(Юноның үрген дауысы)
Dialogue: 0,0:09:22.39,0:09:24.43,Default,,0,0,0,,Күнтізбе
Dialogue: 0,0:09:24.73,0:09:26.98,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:29.82,0:09:33.99,Default,,0,0,0,,Мен атаммен енді ешқашан сөйлеспеймін!
Dialogue: 0,0:09:59.30,0:10:01.05,Default,,0,0,0,,(Юноның ізі)
Dialogue: 0,0:10:08.73,0:10:10.06,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:10:11.02,0:10:12.11,Default,,0,0,0,,Не?
Dialogue: 0,0:10:12.19,0:10:15.36,Default,,0,0,0,,Юнхомен серуендеуге бола ма?
Dialogue: 0,0:10:15.44,0:10:16.61,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:10:16.65,0:10:19.57,Default,,0,0,0,,Оянуға да дайындық болады, асығыңыздар.
Dialogue: 0,0:10:30.46,0:10:32.50,Default,,0,0,0,,(Юноның ырылдаған дыбысы)
Dialogue: 0,0:10:32.63,0:10:35.38,Default,,0,0,0,,Уау! Юнхо!
Dialogue: 0,0:10:36.51,0:10:37.59,Default,,0,0,0,,(Юноның үрген дауысы)
Dialogue: 0,0:10:38.09,0:10:40.26,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:10:40.34,0:10:42.14,Default,,0,0,0,,Жоқ, кенеттен.
Dialogue: 0,0:10:42.22,0:10:43.85,Default,,0,0,0,,Ах! Юнхо!
Dialogue: 0,0:10:43.97,0:10:45.81,Default,,0,0,0,,Күте тұрыңыз, Юно! Күте тұрыңыз!
Dialogue: 0,0:10:45.89,0:10:47.18,Default,,0,0,0,,Ал... а...
Dialogue: 0,0:10:53.27,0:10:55.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:15.17,0:11:17.55,Default,,0,0,0,,Эй, мынаны аша аласың ба?
Dialogue: 0,0:11:17.63,0:11:19.59,Default,,0,0,0,,Осы қақпақты ашыңыз.
Dialogue: 0,0:11:28.18,0:11:29.35,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:11:33.56,0:11:36.11,Default,,0,0,0,,Сәлем! күте тұрыңыз!
Dialogue: 0,0:11:36.19,0:11:37.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:33.83,0:12:38.04,Default,,0,0,0,,Виртуалды химия... Әкемнің жұмыс орны.
Dialogue: 0,0:12:38.46,0:12:40.92,Default,,0,0,0,,О, бұл! Бұл үшін кешіріңіз!
Dialogue: 0,0:12:42.26,0:12:43.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:43.47,0:12:45.93,Default,,0,0,0,,Сіз маған телефоныңызды бере аласыз ба?
Dialogue: 0,0:12:46.93,0:12:48.68,Default,,0,0,0,,Бірақ мен таң қалдым.
Dialogue: 0,0:12:48.72,0:12:50.93,Default,,0,0,0,,Сіз мені күтпеген жерден шақырасыз.
Dialogue: 0,0:12:51.18,0:12:54.48,Default,,0,0,0,,Егер сіз зертханада болсаңыз, әкеңізге қоңырау шалар едіңіз.
Dialogue: 0,0:12:54.56,0:12:58.02,Default,,0,0,0,,Себебі мен әкемнің ұялы телефон нөмірін білмеймін.
Dialogue: 0,0:12:58.23,0:13:00.23,Default,,0,0,0,,Сіз менің нөмірімді білесіз бе?
Dialogue: 0,0:13:00.32,0:13:04.15,Default,,0,0,0,,Мен оны білемін, дәлірек айтсам, есімде. Мен оны әрқашан ойнаймын.
Dialogue: 0,0:13:04.86,0:13:07.95,Default,,0,0,0,,Не айтып тұрсың, жынды бала?
Dialogue: 0,0:13:08.66,0:13:10.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:13.16,0:13:15.33,Default,,0,0,0,,Күнтізбе Сіз не істеп жатырсыз?
Dialogue: 0,0:13:16.08,0:13:18.04,Default,,0,0,0,,Ерекше ештеңе жоқ
Dialogue: 0,0:13:24.97,0:13:27.89,Default,,0,0,0,,Күнтізбе жаңа ғана келді.
Dialogue: 0,0:13:28.05,0:13:29.22,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:13:30.43,0:13:32.27,Default,,0,0,0,,О, күнтізбе
Dialogue: 0,0:13:32.47,0:13:34.56,Default,,0,0,0,,Ха (Маюми) Анаң ас үйде ме?
Dialogue: 0,0:13:34.64,0:13:35.77,Default,,0,0,0,,О
Dialogue: 0,0:13:36.65,0:13:38.36,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:13:38.44,0:13:40.73,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:13:42.40,0:13:45.95,Default,,0,0,0,,Бұл мен болған әлем емес.
Dialogue: 0,0:13:48.07,0:13:50.16,Default,,0,0,0,,Мен осындамын...
Dialogue: 0,0:13:50.20,0:13:52.74,Default,,0,0,0,,Әкемнің соңынан еруді таңдаған дүние...
Dialogue: 0,0:13:53.33,0:13:56.67,Default,,0,0,0,,Ал мынау ата өмір сүретін дүние.
Dialogue: 0,0:13:56.75,0:13:59.63,Default,,0,0,0,,Иә, кез келген уақытта келіңіз.
Dialogue: 0,0:14:00.38,0:14:04.17,Default,,0,0,0,,Енді мен де Юноға барып тамақ берейін деп ойлаймын.
Dialogue: 0,0:14:04.26,0:14:06.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:06.68,0:14:08.26,Default,,0,0,0,,Мен де сенімен бірге барамын!
Dialogue: 0,0:14:10.26,0:14:13.52,Default,,0,0,0,,Иә, солай істейік.
Dialogue: 0,0:14:19.40,0:14:22.52,Default,,0,0,0,,Юно, күнтізбе бүгін келді.
Dialogue: 0,0:14:22.98,0:14:24.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:31.87,0:14:33.29,Default,,0,0,0,,Ата?
Dialogue: 0,0:14:33.45,0:14:36.12,Default,,0,0,0,,Күнтізбеде не дұрыс емес?
Dialogue: 0,0:14:36.91,0:14:40.17,Default,,0,0,0,,Бүгін мен атаммен ұйықтай аламын ба?
Dialogue: 0,0:14:40.63,0:14:42.54,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:14:43.13,0:14:44.84,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:14:45.01,0:14:46.30,Default,,0,0,0,,Бұл туралы айтатын болсақ -
Dialogue: 0,0:14:46.38,0:14:49.80,Default,,0,0,0,,Мен 8 жасқа толғалы бері бірінші рет келіп тұрмын деп ойлаймын.
Dialogue: 0,0:14:58.10,0:15:00.48,Default,,0,0,0,,Юно өлді, солай ма?
Dialogue: 0,0:15:01.02,0:15:02.56,Default,,0,0,0,,О
Dialogue: 0,0:15:05.15,0:15:08.45,Default,,0,0,0,,Сіз қандай да бір жолмен тірі бола алмайсыз ба?
Dialogue: 0,0:15:08.74,0:15:10.32,Default,,0,0,0,,Мен сені аяймын...
Dialogue: 0,0:15:10.41,0:15:14.83,Default,,0,0,0,,Өлген нәрсенің қайта тірілу мүмкіндігі жоқ.
Dialogue: 0,0:15:19.04,0:15:21.37,Default,,0,0,0,,Ата... Кешіріңіз.
Dialogue: 0,0:15:21.50,0:15:24.75,Default,,0,0,0,,Мен әлі де атаммен ұрысып жүрдім...
Dialogue: 0,0:15:26.76,0:15:28.01,Default,,0,0,0,,Ұрыс?
Dialogue: 0,0:15:28.09,0:15:32.22,Default,,0,0,0,,Соңғы рет мұнда келгенде ұрысып қалдыңыз ба?
Dialogue: 0,0:15:35.06,0:15:38.10,Default,,0,0,0,,Атаң бірдеңе деп ұрысты ма?
Dialogue: 0,0:15:40.44,0:15:44.02,Default,,0,0,0,,Тіпті мұндай жағдай орын алса да, бұл сізді жек көретінімді білдірмейді.
Dialogue: 0,0:15:44.11,0:15:45.61,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:15:46.15,0:15:48.82,Default,,0,0,0,,Шынымен бе? Неліктен?
Dialogue: 0,0:15:50.40,0:15:52.28,Default,,0,0,0,,Э? (Танихара) Шиндэ! Менімен бірге Макдоналдсқа бар.
Dialogue: 0,0:15:52.57,0:15:56.62,Default,,0,0,0,,Күнтізбе мен мұңайғанда, басқалар мұңайғанда өзгеше.
Dialogue: 0,0:15:56.70,0:15:58.08,Default,,0,0,0,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:15:58.58,0:16:00.25,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:16:00.33,0:16:02.83,Default,,0,0,0,,Маған мұңайған кезде ұнамайды.
Dialogue: 0,0:16:03.21,0:16:06.13,Default,,0,0,0,,Иә, бәрі де сондай.
Dialogue: 0,0:16:06.67,0:16:08.00,Default,,0,0,0,,Сонымен адамдар
Dialogue: 0,0:16:08.09,0:16:10.47,Default,,0,0,0,,Уақытша көңіл-күйге немесе басқа себептерге байланысты
Dialogue: 0,0:16:10.55,0:16:13.39,Default,,0,0,0,,Басқаларды ренжітетін істермен айналысу
Dialogue: 0,0:16:14.97,0:16:17.51,Default,,0,0,0,,Әдетте кейінірек
Dialogue: 0,0:16:17.64,0:16:19.77,Default,,0,0,0,,Маған қызық, ол неге олай жасады...
Dialogue: 0,0:16:19.85,0:16:21.77,Default,,0,0,0,,Сәтсіздікті тану
Dialogue: 0,0:16:23.98,0:16:27.36,Default,,0,0,0,,Бірақ ол кезде мен қайта әрекет жасай алмадым...
Dialogue: 0,0:16:27.44,0:16:30.94,Default,,0,0,0,,Қайта-қайта баяғы мұңды сезімдермен қиналу
Dialogue: 0,0:16:31.61,0:16:34.53,Default,,0,0,0,,Бұл өте ауыр.
Dialogue: 0,0:16:37.70,0:16:40.04,Default,,0,0,0,,Ата өз тәжірибесінен былай дейді:
Dialogue: 0,0:16:40.16,0:16:42.62,Default,,0,0,0,,Мүмкін болса бармағаныңыз дұрыс.
Dialogue: 0,0:16:42.71,0:16:44.79,Default,,0,0,0,,Мен жай ғана уайымдап тұрмын
Dialogue: 0,0:16:45.00,0:16:46.63,Default,,0,0,0,,Себебі мен күнтізбелерді жақсы көремін
Dialogue: 0,0:16:47.46,0:16:49.17,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:49.38,0:16:51.84,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:16:52.55,0:16:53.72,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:53.80,0:16:57.30,Default,,0,0,0,,Атам кейде қателеседі.
Dialogue: 0,0:16:57.76,0:17:01.77,Default,,0,0,0,,Соңында күнтізбе не істеу керектігін шешеді.
Dialogue: 0,0:17:02.52,0:17:05.44,Default,,0,0,0,,Бұдан былай Коёми көп нәрсені басынан өткереді.
Dialogue: 0,0:17:06.06,0:17:07.86,Default,,0,0,0,,Егер сіз тырыспасаңыз не болады?
Dialogue: 0,0:17:07.94,0:17:11.44,Default,,0,0,0,,Сіз әлі ешкім білмейтін нәрсеге тап болуыңыз мүмкін.
Dialogue: 0,0:17:11.57,0:17:15.36,Default,,0,0,0,,Күнтізбелердің көптеген нұсқалары бар.
Dialogue: 0,0:17:16.11,0:17:18.03,Default,,0,0,0,,Таңдаулар…
Dialogue: 0,0:17:19.12,0:17:20.66,Default,,0,0,0,,Сонда менің атам—
Dialogue: 0,0:17:20.70,0:17:23.29,Default,,0,0,0,,Мүмкіндіктің мағынасын түсіндірдің, бірақ...
Dialogue: 0,0:17:23.37,0:17:26.46,Default,,0,0,0,,Ол кезде мен оны жақсы түсіне алмайтынмын.
Dialogue: 0,0:17:28.92,0:17:32.96,Default,,0,0,0,,Қарапайым түсіндіру тіпті атама да қиын.
Dialogue: 0,0:17:33.88,0:17:35.63,Default,,0,0,0,,Күнтізбе дана болғандықтан—
Dialogue: 0,0:17:35.68,0:17:38.55,Default,,0,0,0,,Түсінсеңіз, басқаларға жақсылап жеткізіңіз.
Dialogue: 0,0:17:39.55,0:17:40.72,Default,,0,0,0,,Иә
Dialogue: 0,0:17:41.51,0:17:43.02,Default,,0,0,0,,Күнтізбе сәтсіз болса да—
Dialogue: 0,0:17:43.10,0:17:45.31,Default,,0,0,0,,Атам мені ешқашан жек көрмейді.
Dialogue: 0,0:17:45.89,0:17:48.90,Default,,0,0,0,,Атам кейде қателессе де—
Dialogue: 0,0:17:48.98,0:17:51.40,Default,,0,0,0,,Өтінемін, тез арада мені жек көрме.
Dialogue: 0,0:17:54.86,0:17:57.74,Default,,0,0,0,,Мен де атамды жақсы көремін.
Dialogue: 0,0:18:18.59,0:18:20.35,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:18:22.93,0:18:24.35,Default,,0,0,0,,Ана?
Dialogue: 0,0:18:28.39,0:18:30.10,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:30.48,0:18:32.23,Default,,0,0,0,,Әже ше?
Dialogue: 0,0:18:32.82,0:18:35.28,Default,,0,0,0,,Жетекшіге тазалауды тапсырыңыз.
Dialogue: 0,0:18:35.36,0:18:37.65,Default,,0,0,0,,Мен қазір үлкен залда ұйықтап жатырмын.
Dialogue: 0,0:18:42.95,0:18:44.95,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:45.04,0:18:47.66,Default,,0,0,0,,Анашым, кеше мен...
Dialogue: 0,0:18:47.83,0:18:50.00,Default,,0,0,0,,Ұялмаңыз
Dialogue: 0,0:18:50.08,0:18:51.58,Default,,0,0,0,,Осындай кезде
Dialogue: 0,0:18:51.96,0:18:55.38,Default,,0,0,0,,Біреумен жатқым келетіні таңқаларлық емес.
Dialogue: 0,0:18:56.76,0:18:57.97,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:58.09,0:19:00.47,Default,,0,0,0,,Енді дайындалайық.
Dialogue: 0,0:19:00.64,0:19:04.76,Default,,0,0,0,,Мен атамды дұрыстап жіберуім керек.
Dialogue: 0,0:19:08.73,0:19:11.15,Default,,0,0,0,,Құрбандық үстелінде қойылған атамның портреті...
Dialogue: 0,0:19:11.44,0:19:13.15,Default,,0,0,0,,Оның бет-әлпеті ашулы,
Dialogue: 0,0:19:13.65,0:19:17.40,Default,,0,0,0,,Юбенің момын атасы бір кісідей көрінбеді.
Dialogue: 0,0:19:18.15,0:19:21.91,Default,,0,0,0,,Табыттағы арық адам да марқұмның портретіне ұқсамайды.
Dialogue: 0,0:19:27.70,0:19:29.41,Default,,0,0,0,,Мен суды ауыстырдым.
Dialogue: 0,0:19:29.66,0:19:31.88,Default,,0,0,0,,Рахмет, сол жерде қалдырыңыз.
Dialogue: 0,0:19:32.38,0:19:33.46,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:33.54,0:19:36.21,Default,,0,0,0,,Олай болса, анау биік шкафтың басы —
Dialogue: 0,0:19:36.25,0:19:37.63,Default,,0,0,0,,Оны ашыңыз
Dialogue: 0,0:19:37.71,0:19:38.80,Default,,0,0,0,,Иә
Dialogue: 0,0:19:38.88,0:19:40.38,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:19:40.47,0:19:41.72,Default,,0,0,0,,Иә
Dialogue: 0,0:19:46.14,0:19:47.72,Default,,0,0,0,,Анашым бұл
Dialogue: 0,0:19:47.81,0:19:51.52,Default,,0,0,0,,Әй, мен бірдеңені ұстайтынмын.
Dialogue: 0,0:19:51.56,0:19:52.65,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:19:52.69,0:19:53.77,Default,,0,0,0,,Бұл бөлме
Dialogue: 0,0:19:53.86,0:19:55.40,Default,,0,0,0,,Бұл оны бос қалдыру керек дегенді білдірмейді.
Dialogue: 0,0:19:55.48,0:19:56.94,Default,,0,0,0,,Болдырмау…
Dialogue: 0,0:20:02.61,0:20:03.70,Default,,0,0,0,,Сол кезде —
Dialogue: 0,0:20:04.41,0:20:06.83,Default,,0,0,0,,Ақырында, үш ата бір-біріне...
Dialogue: 0,0:20:06.91,0:20:08.70,Default,,0,0,0,,Ол менің ішімде адам болды.
Dialogue: 0,0:20:12.92,0:20:14.04,Default,,0,0,0,,Бұл –
Dialogue: 0,0:20:14.13,0:20:17.30,Default,,0,0,0,,Бұл менің параллель әлемдер туралы хабардар еткен алғашқы оқиға болды.
Dialogue: 0,0:20:18.71,0:20:20.34,Default,,0,0,0,,Юно менің әлемімде -
Dialogue: 0,0:20:20.42,0:20:22.80,Default,,0,0,0,,Екі жылдан кейін өмірінің соңында қайтыс болды.
Dialogue: 0,0:20:22.88,0:20:25.85,Default,,0,0,0,,Сол дүниеде көрген жерімде ұйықтау
Dialogue: 0,0:20:28.01,0:20:30.68,Default,,0,0,0,,Ол параллель дүниелердің бар екенін көрсетті.
Dialogue: 0,0:20:30.77,0:20:32.56,Default,,0,0,0,,Бірінші жарияланған –
Dialogue: 0,0:20:32.60,0:20:34.69,Default,,0,0,0,,Жапондық виртуалды ғылым институты
Dialogue: 0,0:20:34.77,0:20:37.73,Default,,0,0,0,,Басқаша айтқанда, бұл менің әкем жұмыс істейтін ғылыми мекеме.
Dialogue: 0,0:20:38.90,0:20:42.57,Default,,0,0,0,,Әкелеріміздің зерттеу нәтижелері әлемнің түкпір-түкпірінен назар аударды.
Dialogue: 0,0:20:43.20,0:20:45.24,Default,,0,0,0,,Осындай тамаша әкенің арқасы ма?
Dialogue: 0,0:20:45.78,0:20:47.74,Default,,0,0,0,,Мен көп оқымасам да...
Dialogue: 0,0:20:47.83,0:20:49.58,Default,,0,0,0,,Менің бағаларым өте жақсы болды.
Dialogue: 0,0:20:51.58,0:20:54.71,Default,,0,0,0,,Бірақ әдеттен тыс жақсы бағалар...
Dialogue: 0,0:20:54.79,0:20:57.79,Default,,0,0,0,,Жасөспірімдік шақта жалғыздықты білдіреді
Dialogue: 0,0:20:59.80,0:21:03.13,Default,,0,0,0,,Кем дегенде, мен сол кезде осылай ойладым.
Dialogue: 0,0:21:04.30,0:21:07.89,Default,,0,0,0,,«Кёми~ Сенің достарың көп емес пе?»
Dialogue: 0,0:21:08.01,0:21:11.27,Default,,0,0,0,,Анам осылай деді, бірақ бұл дұрыс емес.
Dialogue: 0,0:21:11.93,0:21:15.27,Default,,0,0,0,,Кіші сыныпта менің бірде-бір досым болған жоқ.
Dialogue: 0,0:21:16.23,0:21:17.77,Default,,0,0,0,,Мен ант бердім
Dialogue: 0,0:21:17.86,0:21:20.27,Default,,0,0,0,,Орта мектепте мен достасуға тырыстым.
Dialogue: 0,0:21:21.07,0:21:22.24,Default,,0,0,0,,Сонымен—
Dialogue: 0,0:21:22.32,0:21:25.07,Default,,0,0,0,,Қабылдау емтиханын сыныптың жоғарғы жағында тапсырған адам ұсынылады.
Dialogue: 0,0:21:25.20,0:21:28.99,Default,,0,0,0,,Мен жаңа студенттің сәлемдесуінен сыпайы түрде бас тарттым.
Dialogue: 0,0:21:32.20,0:21:34.54,Default,,0,0,0,,Осылайша сіз ерекше назар аудара алмайсыз.
Dialogue: 0,0:21:36.17,0:21:39.50,Default,,0,0,0,,Мен ойланбастан достасуды ойладым.
Dialogue: 0,0:21:40.80,0:21:44.26,Default,,0,0,0,,Бірақ шындық соншалықты жұмсақ болған жоқ.
Dialogue: 0,0:21:52.72,0:21:54.73,Default,,0,0,0,,Жоғары сыныпты даярлық мектептерінде:
Dialogue: 0,0:21:54.81,0:21:57.35,Default,,0,0,0,,Басқаларға алаңдаушылық атмосферасы болмады...
Dialogue: 0,0:21:58.56,0:22:00.27,Default,,0,0,0,,Менің орта мектептегі өмірім-
Dialogue: 0,0:22:00.40,0:22:03.28,Default,,0,0,0,,Мен тағы да жалғыз нұсқаға ұмтылдым.
Dialogue: 0,0:22:10.37,0:22:11.83,Default,,0,0,0,,Күнтізбе!
Dialogue: 0,0:22:11.91,0:22:13.33,Default,,0,0,0,,（）
Dialogue: 0,0:22:13.41,0:22:15.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:15.71,0:22:18.00,Default,,0,0,0,,Неге мені елемейсің, Коёми!
Dialogue: 0,0:22:19.67,0:22:21.50,Default,,0,0,0,,Э? Ах…
Dialogue: 0,0:22:21.63,0:22:24.71,Default,,0,0,0,,Мм... Такигава мырза?
Dialogue: 0,0:22:25.09,0:22:27.97,Default,,0,0,0,,Бұл күнтізбе мен туралы ма?
Dialogue: 0,0:22:28.13,0:22:30.01,Default,,0,0,0,,Тағы кім бар?
Dialogue: 0,0:22:31.14,0:22:33.01,Default,,0,0,0,,Мен енді ашуланбаймын
Dialogue: 0,0:22:34.43,0:22:35.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:35.93,0:22:37.44,Default,,0,0,0,,Егер сіз әлі де кешірім сұрағыңыз келсе—
Dialogue: 0,0:22:37.52,0:22:39.44,Default,,0,0,0,,Үйге қайтып бара жатқанда сұраймын.
Dialogue: 0,0:22:39.73,0:22:40.98,Default,,0,0,0,,Әй, эй...
Dialogue: 0,0:22:41.52,0:22:43.48,Default,,0,0,0,,Сәл күте тұрыңыз, Такигава мырза.
Dialogue: 0,0:22:45.03,0:22:47.53,Default,,0,0,0,,Бұрын не болды? Оны қалай атауға болады
Dialogue: 0,0:22:47.57,0:22:48.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:48.86,0:22:51.12,Default,,0,0,0,,Маған мұндай көзқарас ұнамайды.
Dialogue: 0,0:22:51.45,0:22:54.45,Default,,0,0,0,,Не болды? Такигава мырза
Dialogue: 0,0:22:54.87,0:22:56.50,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:22:56.58,0:22:59.54,Default,,0,0,0,,Соңғы кездері біздің қарым-қатынасымыз аздап кеткені рас.
Dialogue: 0,0:22:59.62,0:23:02.42,Default,,0,0,0,,Бірақ бұл әдіс күнтізбеге ұқсайды дегенді білдірмейді...
Dialogue: 0,0:23:10.34,0:23:12.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:23:17.14,0:23:18.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:31.49,0:23:33.66,Default,,0,0,0,,Бұл аз
Dialogue: 0,0:23:35.12,0:23:36.91,Default,,0,0,0,,Сізге әлі де бірдеңе керек пе?
Dialogue: 0,0:23:37.08,0:23:39.33,Default,,0,0,0,,Менде бір оқиға, салмақты әңгіме.
Dialogue: 0,0:23:40.46,0:23:42.96,Default,,0,0,0,,Менімен бірге жүр, мен түсіндіремін.
Dialogue: 0,0:23:45.17,0:23:46.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:58.68,0:24:00.06,Default,,0,0,0,,Караоке?
Dialogue: 0,0:24:08.23,0:24:09.44,Default,,0,0,0,,Отырсам ше?
Dialogue: 0,0:24:12.99,0:24:14.12,Default,,0,0,0,,Иә
Dialogue: 0,0:24:21.71,0:24:23.21,Default,,0,0,0,,Сіз бұл не екенін білесіз бе?
Dialogue: 0,0:24:23.79,0:24:25.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:25.63,0:24:26.75,Default,,0,0,0,,Ал...
Dialogue: 0,0:24:27.25,0:24:29.71,Default,,0,0,0,,Қол сағаты... солай емес пе?
Dialogue: 0,0:24:30.30,0:24:32.13,Default,,0,0,0,,Сіз IP терминалын білесіз бе?
Dialogue: 0,0:24:34.05,0:24:35.60,Default,,0,0,0,,Кез келген жағдайда...
Dialogue: 0,0:24:35.68,0:24:38.22,Default,,0,0,0,,Мен қазір қай параллель әлемдемін?
Dialogue: 0,0:24:38.26,0:24:40.68,Default,,0,0,0,,Бұл оны көрсететін құрылғы, солай ма?
Dialogue: 0,0:24:41.23,0:24:44.15,Default,,0,0,0,,Мен оның әлі де тестілеу сатысында екеніне сенімдімін.
Dialogue: 0,0:24:44.23,0:24:46.48,Default,,0,0,0,,Жалған ғылымды зерттеушілер, т.б.
Dialogue: 0,0:24:46.56,0:24:49.15,Default,,0,0,0,,Бұл адам бақылаушы ретінде әрекет етеді.
Dialogue: 0,0:24:49.65,0:24:51.61,Default,,0,0,0,,Менің әкем сол зерттеуші.
Dialogue: 0,0:24:52.20,0:24:55.95,Default,,0,0,0,,Әй, менің әкем де сол институтта жұмыс істейді...
Dialogue: 0,0:24:55.99,0:24:57.12,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:24:57.20,0:24:59.41,Default,,0,0,0,,олар ондағы жазбаларды сақтау үшін көшіріп жазады—
Dialogue: 0,0:25:00.04,0:25:01.12,Default,,0,0,0,,Жақсы
Dialogue: 0,0:25:01.79,0:25:05.67,Default,,0,0,0,,Менің білім деңгейімнің әлемдік күнтізбеден еш айырмашылығы жоқ.
Dialogue: 0,0:25:06.29,0:25:09.75,Default,,0,0,0,,«Менің» дегені… uh…
Dialogue: 0,0:25:10.38,0:25:13.67,Default,,0,0,0,,Сосын... Такигава мырза міне...
Dialogue: 0,0:25:15.47,0:25:16.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:20.64,0:25:22.31,Default,,0,0,0,,Осы жерден қараңыз—
Dialogue: 0,0:25:22.39,0:25:25.14,Default,,0,0,0,,85Бұл сіздің алыс дүниеден келгеніңізді білдіреді.
Dialogue: 0,0:25:25.27,0:25:26.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:27.90,0:25:29.44,Default,,0,0,0,,Сонымен мен—
Dialogue: 0,0:25:29.57,0:25:32.49,Default,,0,0,0,,Мен параллель ауысқанымды түсінбей-
Dialogue: 0,0:25:32.57,0:25:36.82,Default,,0,0,0,,Коёми... Мен Такасаки-кунды шақырдым.
Dialogue: 0,0:25:37.87,0:25:39.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:46.17,0:25:48.50,Default,,0,0,0,,Мен оны ішсем ше? Бұл қызықты емес пе?
Dialogue: 0,0:25:48.54,0:25:51.05,Default,,0,0,0,,А... иә
Dialogue: 0,0:25:53.88,0:25:55.76,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:25:55.88,0:25:58.09,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:25:59.35,0:26:00.64,Default,,0,0,0,,Өйткені біз ғашықпыз
Dialogue: 0,0:26:01.89,0:26:03.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:26:03.18,0:26:06.48,Default,,0,0,0,,Сонда мен ол адаммен қандай қарым-қатынастамын?
Dialogue: 0,0:26:13.28,0:26:19.78,Default,,0,0,0,,(Sekikomi күнтізбесі)
Dialogue: 0,0:26:20.24,0:26:22.20,Default,,0,0,0,,Мен сенің сүйіктіңмін бе?
Dialogue: 0,0:26:22.95,0:26:25.62,Default,,0,0,0,,Бұл... ғашық - бұл...
Dialogue: 0,0:26:26.12,0:26:28.46,Default,,0,0,0,,Жігіт пен қыз деп аталатын...
Dialogue: 0,0:26:28.62,0:26:29.96,Default,,0,0,0,,Мені есіңде бар ғой, иә?
Dialogue: 0,0:26:30.29,0:26:32.50,Default,,0,0,0,,Ах... Сонымен...
Dialogue: 0,0:26:32.63,0:26:34.76,Default,,0,0,0,,Деликатес Суги
Dialogue: 0,0:26:37.80,0:26:38.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:39.43,0:26:40.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:26:41.01,0:26:43.47,Default,,0,0,0,,Ах! Мен өзімді ерекше сезінемін!
Dialogue: 0,0:26:43.76,0:26:46.02,Default,,0,0,0,,Бұл менің күнтізбемнен мүлдем басқа!
Dialogue: 0,0:26:47.35,0:26:48.52,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:26:49.27,0:26:50.65,Default,,0,0,0,,Менің күнтізбем –
Dialogue: 0,0:26:50.69,0:26:53.86,Default,,0,0,0,,Неғұрлым берік және сенімді...
Dialogue: 0,0:26:54.69,0:26:56.78,Default,,0,0,0,,Сенімді? (аккорд) Дұрыс.
Dialogue: 0,0:26:57.11,0:26:59.70,Default,,0,0,0,,Маған қаңғыбас ит шабуылдай жаздаған кезде —
Dialogue: 0,0:26:59.78,0:27:01.28,Default,,0,0,0,,Сіз маған көмектестіңіз.
Dialogue: 0,0:27:01.87,0:27:04.29,Default,,0,0,0,,Қаңғыбас ит? қашан?
Dialogue: 0,0:27:06.20,0:27:07.29,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:27:10.21,0:27:12.00,Default,,0,0,0,,Мм...!
Dialogue: 0,0:27:13.79,0:27:17.13,Default,,0,0,0,,Сіз Коёми Такасакисіз, солай ма?
Dialogue: 0,0:27:18.22,0:27:19.34,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:27:19.88,0:27:22.93,Default,,0,0,0,,Бұл жай ғана Коёми Такасаки болмаса да.
Dialogue: 0,0:27:24.10,0:27:27.56,Default,,0,0,0,,Бірақ ол сіздің күнтізбеңізден өзгеше болса да көмектесе алмайды.
Dialogue: 0,0:27:28.39,0:27:31.02,Default,,0,0,0,,85 өте алыс болуы керек.
Dialogue: 0,0:27:31.40,0:27:33.61,Default,,0,0,0,,Күнтізбелері бірдей болғанымен, олар әртүрлі дерлік адамдар емес пе?
Dialogue: 0,0:27:34.27,0:27:35.57,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:27:35.78,0:27:37.40,Default,,0,0,0,,Жоқ, себебі—
Dialogue: 0,0:27:37.57,0:27:40.53,Default,,0,0,0,,Мен бұл жерде Такигава мырза туралы ештеңе білмеймін...
Dialogue: 0,0:27:40.86,0:27:42.45,Default,,0,0,0,,Мен туралы...
Dialogue: 0,0:27:42.53,0:27:44.83,Default,,0,0,0,,Сен кім туралы айтып тұрсың?
Dialogue: 0,0:27:44.95,0:27:46.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:46.29,0:27:47.79,Default,,0,0,0,,Бұл туралы Такигава мырза
Dialogue: 0,0:27:47.87,0:27:49.00,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:27:49.12,0:27:50.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:50.50,0:27:52.63,Default,,0,0,0,,Ана жақта немесе ана жақта
Dialogue: 0,0:27:52.71,0:27:55.50,Default,,0,0,0,,Оларды тек аты-жөнімен атаған дұрыс емес пе?
Dialogue: 0,0:27:56.25,0:27:59.09,Default,,0,0,0,,Бұл әлем «Такасаки-кун және Такигава-сан»
Dialogue: 0,0:27:59.47,0:28:02.13,Default,,0,0,0,,Менің әлемім – «күнтізбе және аккордтар»
Dialogue: 0,0:28:03.01,0:28:04.39,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:28:04.47,0:28:05.72,Default,,0,0,0,,Мен...
Dialogue: 0,0:28:06.18,0:28:09.77,Default,,0,0,0,,Мен сені Казүнэ десем жарай ма?
Dialogue: 0,0:28:10.10,0:28:12.48,Default,,0,0,0,,Жарайды, неге?
Dialogue: 0,0:28:13.44,0:28:17.40,Default,,0,0,0,,Күнтізбе осылай атайды, солай ма?
Dialogue: 0,0:28:17.69,0:28:21.49,Default,,0,0,0,,Менің оларды дәл осылай атағаным біртүрлі...
Dialogue: 0,0:28:21.99,0:28:23.49,Default,,0,0,0,,Бұл жай ғана есім
Dialogue: 0,0:28:23.74,0:28:26.41,Default,,0,0,0,,Оның үстіне мен өзіммін.
Dialogue: 0,0:28:26.53,0:28:27.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:29.04,0:28:30.96,Default,,0,0,0,,Егер сізге аккордтар ұнаса...
Dialogue: 0,0:28:31.16,0:28:32.46,Default,,0,0,0,,Тақырыпқа оралу...
Dialogue: 0,0:28:32.54,0:28:36.96,Default,,0,0,0,,IP терминалы ойдан шығарылған және...
Dialogue: 0,0:28:37.00,0:28:38.34,Default,,0,0,0,,Сандық
Dialogue: 0,0:28:38.42,0:28:39.51,Default,,0,0,0,,Иә
Dialogue: 0,0:28:40.05,0:28:43.34,Default,,0,0,0,,Бұтақтардың санын қашықтыққа ауыстыру арқылы өрнектеледі, солай ма?
Dialogue: 0,0:28:44.22,0:28:47.51,Default,,0,0,0,,85 параллельді жылжу айтарлықтай емес пе?
Dialogue: 0,0:28:47.64,0:28:50.98,Default,,0,0,0,,Бірақ мен мектептен кейін Такасаки-кунмен сөйлескенше...
Dialogue: 0,0:28:51.14,0:28:53.48,Default,,0,0,0,,Мен ауысым болғанын түсінбедім.
Dialogue: 0,0:28:54.48,0:28:55.98,Default,,0,0,0,,Бұл біртүрлі емес.
Dialogue: 0,0:28:56.11,0:28:58.90,Default,,0,0,0,,Менің ойымша, 85 өте алыс емес.
Dialogue: 0,0:28:59.94,0:29:01.78,Default,,0,0,0,,Мен бұл туралы ойладым ...
Dialogue: 0,0:29:02.99,0:29:07.24,Default,,0,0,0,,Бір кездері алыс дүниелерден алынған көптеген әлемдер арасында—
Dialogue: 0,0:29:07.37,0:29:10.62,Default,,0,0,0,,Бір бағытта қайта-қайта тармақталған ағын түзіледі.
Dialogue: 0,0:29:10.79,0:29:14.29,Default,,0,0,0,,Жағдайы өте ұқсас дүние кездейсоқ пайда болды ма деп ойлаймын.
Dialogue: 0,0:29:14.83,0:29:18.50,Default,,0,0,0,,Әр түрлі жолдармен жүрсек те, бір жерге жеттік.
Dialogue: 0,0:29:18.92,0:29:20.80,Default,,0,0,0,,Бұл «флюктуация» сияқты нәрсе ме?
Dialogue: 0,0:29:21.17,0:29:23.42,Default,,0,0,0,,Егер ойдан шығарылған материя материяға ұқсас болса —
Dialogue: 0,0:29:23.51,0:29:26.39,Default,,0,0,0,,...
Dialogue: 0,0:29:26.97,0:29:28.76,Default,,0,0,0,,Содан кейін не болады...
Dialogue: 0,0:29:29.43,0:29:30.76,Default,,0,0,0,,Конвергенция
Dialogue: 0,0:29:30.89,0:29:33.60,Default,,0,0,0,,Екі дүние тоғысады
Dialogue: 0,0:29:33.98,0:29:37.40,Default,,0,0,0,,Жоқ, екі дүниенің тарихы екі бөлек...
Dialogue: 0,0:29:37.48,0:29:39.65,Default,,0,0,0,,Әлде жоқ па?
Dialogue: 0,0:29:40.32,0:29:43.82,Default,,0,0,0,,Қос жұлдыз сияқты, бірдей қашықтықты сақтайды және бір-біріне әсер етеді
Dialogue: 0,0:29:43.94,0:29:46.61,Default,,0,0,0,,Бір бағытта жүру... т.б.
Dialogue: 0,0:29:47.62,0:29:49.62,Default,,0,0,0,,Жалған ғылымның ойлау үлгісінде—
Dialogue: 0,0:29:49.99,0:29:52.50,Default,,0,0,0,,Параллель дүниелерді судағы көпіршіктермен салыстыру
Dialogue: 0,0:29:52.91,0:29:54.66,Default,,0,0,0,,Осы үлгі бойынша—
Dialogue: 0,0:29:54.75,0:29:57.29,Default,,0,0,0,,Екі көпіршік бір-бірінің айналасында айналады.
Dialogue: 0,0:29:57.42,0:29:59.92,Default,,0,0,0,,Бір бағытта көтерілу
Dialogue: 0,0:30:00.04,0:30:01.38,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:30:02.17,0:30:03.76,Default,,0,0,0,,Бірақ әлі жоқ
Dialogue: 0,0:30:03.80,0:30:06.26,Default,,0,0,0,,Такасаки-кун мен Күнтізбе мүлдем басқа.
Dialogue: 0,0:30:06.68,0:30:08.51,Default,,0,0,0,,Мүмкін мен жай ғана адасып жүрген шығармын...
Dialogue: 0,0:30:08.68,0:30:12.10,Default,,0,0,0,,Такигава мырзада орын алған 85 ауысым және аккордтар:
Dialogue: 0,0:30:12.18,0:30:14.43,Default,,0,0,0,,Қызық, бұл бірдеңені білдіреді ме?
Dialogue: 0,0:30:14.52,0:30:15.68,Default,,0,0,0,,Иә
Dialogue: 0,0:30:16.52,0:30:19.65,Default,,0,0,0,,Екі көпіршікті бір-бірінен ажыратпайтын күш
Dialogue: 0,0:30:20.90,0:30:22.36,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:30:22.61,0:30:24.69,Default,,0,0,0,,Содан кейін, мысалы, Такигава мырза
Dialogue: 0,0:30:24.82,0:30:28.03,Default,,0,0,0,,Жоқ, аккордтар менімен бірге.
Dialogue: 0,0:30:29.28,0:30:31.37,Default,,0,0,0,,Мен Такасаки-кунмен біргемін бе?
Dialogue: 0,0:30:31.78,0:30:33.87,Default,,0,0,0,,О... кешіріңіз.
Dialogue: 0,0:30:33.95,0:30:36.04,Default,,0,0,0,,Дұрыс емес, тым көп секіру.
Dialogue: 0,0:30:36.21,0:30:38.29,Default,,0,0,0,,Жоқ, мен абдырап қалдым...
Dialogue: 0,0:30:39.42,0:30:42.92,Default,,0,0,0,,Маған Такасаки-кун ерекше ұнамайды.
Dialogue: 0,0:30:43.59,0:30:44.76,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:30:44.88,0:30:48.59,Default,,0,0,0,,Бірақ мен күнтізбелерді жақсы көремін, сондықтан...
Dialogue: 0,0:30:48.88,0:30:51.43,Default,,0,0,0,,Такигава мырзаның Такасаки мырзаға ғашық болу мүмкіндігі бар.
Dialogue: 0,0:30:51.51,0:30:52.93,Default,,0,0,0,,Бар болуы мүмкін
Dialogue: 0,0:30:53.39,0:30:54.77,Default,,0,0,0,,Сондай-ақ Такасаки-кун үшін—
Dialogue: 0,0:30:54.85,0:30:57.60,Default,,0,0,0,,Бұл үшін опциялар болуы керек.
Dialogue: 0,0:30:57.89,0:31:00.90,Default,,0,0,0,,Жарайды, егер сізге ұнаса, бар күшіңізді салыңыз.
Dialogue: 0,0:31:01.69,0:31:02.82,Default,,0,0,0,,А...
Dialogue: 0,0:31:04.11,0:31:05.90,Default,,0,0,0,,Мен не болатынын білмеймін, бірақ...
Dialogue: 0,0:31:06.03,0:31:08.65,Default,,0,0,0,,Бұл біраз уақытқа дейін құпия сақталады.
Dialogue: 0,0:31:08.95,0:31:10.49,Default,,0,0,0,,Себебі мен шу шығарғым келмейді
Dialogue: 0,0:31:11.41,0:31:12.87,Default,,0,0,0,,Мұнда да бөлек кетейік.
Dialogue: 0,0:31:13.87,0:31:16.08,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:31:16.25,0:31:18.37,Default,,0,0,0,,А, мен төлеймін.
Dialogue: 0,0:31:18.58,0:31:20.29,Default,,0,0,0,,Өйткені аккорд тапсырыс беруші болып табылады.
Dialogue: 0,0:31:20.92,0:31:22.54,Default,,0,0,0,,Бұл қызықты перспектива.
Dialogue: 0,0:31:23.04,0:31:24.50,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:31:25.59,0:31:26.76,Default,,0,0,0,,Мен осы жерден кеткенде—
Dialogue: 0,0:31:26.84,0:31:29.88,Default,,0,0,0,,Такасаки-кун сияқты, оны табиғи түрде сақтаңыз.
Dialogue: 0,0:31:30.05,0:31:33.26,Default,,0,0,0,,Иә, ә... әрине.
Dialogue: 0,0:31:33.64,0:31:36.31,Default,,0,0,0,,Иә, тек ағынмен жүріңіз.
Dialogue: 0,0:31:37.43,0:31:38.64,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:31:38.77,0:31:41.31,Default,,0,0,0,,Мен сені ертең тағы көретінімді білмеймін.
Dialogue: 0,0:31:41.48,0:31:42.69,Default,,0,0,0,,А...
Dialogue: 0,0:31:42.77,0:31:44.94,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,0:31:45.98,0:31:47.53,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:31:48.82,0:31:50.24,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:31:51.32,0:31:52.78,Default,,0,0,0,,Айтыңыз:
Dialogue: 0,0:31:52.87,0:31:55.37,Default,,0,0,0,,Мен және Такигава-сан мен білмеймін
Dialogue: 0,0:31:55.66,0:31:58.08,Default,,0,0,0,,85 дүниеден келген аккордтар ажыратылды.
Dialogue: 0,0:31:58.37,0:31:59.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:02.71,0:32:05.42,Default,,0,0,0,,85 параллель әлем...
Dialogue: 0,0:32:08.26,0:32:10.30,Default,,0,0,0,,О
Dialogue: 0,0:32:14.85,0:32:16.06,Default,,0,0,0,,Келесі күні
Dialogue: 0,0:32:16.31,0:32:19.22,Default,,0,0,0,,Әрине ол мектепке келді.
Dialogue: 0,0:32:22.56,0:32:23.69,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:32:23.77,0:32:26.90,Default,,0,0,0,,Бұл аккорд па, әлде Такигава мырза...
Dialogue: 0,0:32:30.28,0:32:32.20,Default,,0,0,0,,85, егер сіз алыс болсаңыз—
Dialogue: 0,0:32:32.32,0:32:34.62,Default,,0,0,0,,Атмосфера сәл басқаша болуы керек.
Dialogue: 0,0:32:35.32,0:32:38.74,Default,,0,0,0,,Оның сыртқы түрі аккорд сияқты көрінді
Dialogue: 0,0:32:40.04,0:32:41.21,Default,,0,0,0,,Бірақ мен—
Dialogue: 0,0:32:41.29,0:32:44.17,Default,,0,0,0,,Мен Такигава мырзамен ешқашан амандасып көрмеппін, сондықтан...
Dialogue: 0,0:32:44.25,0:32:47.46,Default,,0,0,0,,Екі адамның бір-бірінен айырмашылығын салыстыруға болмайды.
Dialogue: 0,0:32:49.38,0:32:50.96,Default,,0,0,0,,Келесі күні де
Dialogue: 0,0:32:51.05,0:32:52.93,Default,,0,0,0,,Келесі күні де
Dialogue: 0,0:32:53.01,0:32:54.30,Default,,0,0,0,,Келесі күні де
Dialogue: 0,0:32:54.84,0:32:57.01,Default,,0,0,0,,Әрине мен оны кездестірдім.
Dialogue: 0,0:32:58.35,0:33:00.10,Default,,0,0,0,,Тек ештеңе айтқан жоқ
Dialogue: 0,0:33:01.81,0:33:03.10,Default,,0,0,0,,Сөйлей алмадым
Dialogue: 0,0:33:07.52,0:33:10.94,Default,,0,0,0,,Оның әлемінде сол дүниенің қызметшісі бар дейді.
Dialogue: 0,0:33:15.78,0:33:19.54,Default,,0,0,0,,Бұл жерде мен емес, басқа мен.
Dialogue: 0,0:33:21.04,0:33:22.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:22.29,0:33:23.54,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:33:37.59,0:33:39.01,Default,,0,0,0,,Бұл әлемде
Dialogue: 0,0:33:39.64,0:33:43.10,Default,,0,0,0,,Ол екеуміз ғашық болып танысқан сияқтымыз.
Dialogue: 0,0:33:49.86,0:33:53.57,Default,,0,0,0,,Басқа қызметші мен менің құрбым
Dialogue: 0,0:34:12.17,0:34:13.55,Default,,0,0,0,,Бұл-
Dialogue: 0,0:34:13.71,0:34:15.17,Default,,0,0,0,,Мен үйге барғым келеді...
Dialogue: 0,0:34:15.26,0:34:19.01,Default,,0,0,0,,Сіз барғыңыз келетін параллель әлемге баруға бола ма?
Dialogue: 0,0:34:19.22,0:34:21.10,Default,,0,0,0,,Теориялық мүмкін.
Dialogue: 0,0:34:21.81,0:34:24.85,Default,,0,0,0,,Шындығында, біз қазір қосымша ауысым жасаймыз—
Dialogue: 0,0:34:25.27,0:34:28.52,Default,,0,0,0,,Яғни, ерікті параллель әлемдерге ауысуға қатысты—
Dialogue: 0,0:34:28.60,0:34:29.86,Default,,0,0,0,,Зерттеу үстінде
Dialogue: 0,0:34:29.94,0:34:31.52,Default,,0,0,0,,Солай ма? Сонда...
Dialogue: 0,0:34:31.57,0:34:34.65,Default,,0,0,0,,Бірақ ол техникалық тұрғыда бекітілмеген.
Dialogue: 0,0:34:35.07,0:34:39.11,Default,,0,0,0,,Оны іс жүзінде қолдану үшін тағы 10 жыл қажет болуы мүмкін.
Dialogue: 0,0:34:40.28,0:34:41.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:34:42.03,0:34:43.20,Default,,0,0,0,,Рахмет
Dialogue: 0,0:34:43.70,0:34:46.33,Default,,0,0,0,,Иә, кездескенше.
Dialogue: 0,0:34:47.29,0:34:49.12,Default,,0,0,0,,10 жыл...
Dialogue: 0,0:35:05.68,0:35:07.14,Default,,0,0,0,,Қайырлы таң аккорды
Dialogue: 0,0:35:11.06,0:35:12.19,Default,,0,0,0,,Аккорд?
Dialogue: 0,0:35:14.02,0:35:15.19,Default,,0,0,0,,(жасыл сигнал сигналы)
Dialogue: 0,0:35:15.32,0:35:17.32,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:20.24,0:35:21.87,Default,,0,0,0,,Бұл Такигава мырза.
Dialogue: 0,0:35:25.49,0:35:27.16,Default,,0,0,0,,
Dialogue: 0,0:35:27.25,0:35:30.12,Default,,0,0,0,,Аккорд үйіне қайтуға мүмкіндік алды.
Dialogue: 0,0:35:57.90,0:36:00.40,Default,,0,0,0,,Сәлем, сізге қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,0:36:02.07,0:36:03.20,Default,,0,0,0,,Бұл…
Dialogue: 0,0:36:03.28,0:36:04.45,Default,,0,0,0,,Иә
Dialogue: 0,0:36:04.95,0:36:07.12,Default,,0,0,0,,Кіріңіз, отырыңыз.
Dialogue: 0,0:36:07.20,0:36:08.70,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:36:14.54,0:36:16.09,Default,,0,0,0,,Бірдеңе ішуді қалайсыз ба?
Dialogue: 0,0:36:16.17,0:36:17.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:36:18.30,0:36:19.88,Default,,0,0,0,,А... бірдеңе айтқың келе ме?
Dialogue: 0,0:36:20.22,0:36:22.01,Default,,0,0,0,,А? (Күнтізбе) Жоқ...
Dialogue: 0,0:36:28.68,0:36:30.52,Default,,0,0,0,,Мм... сонда...
Dialogue: 0,0:36:31.18,0:36:32.77,Default,,0,0,0,,Сөзге тікелей көшейік.
Dialogue: 0,0:36:33.90,0:36:35.40,Default,,0,0,0,,Мен оны жазбама жаздым, бірақ...
Dialogue: 0,0:36:35.77,0:36:37.23,Default,,0,0,0,,Біраз уақыттан бері—
Dialogue: 0,0:36:37.40,0:36:39.74,Default,,0,0,0,,Сіз 85-тің параллель әлеміне бардыңыз, солай ма?
Dialogue: 0,0:36:41.19,0:36:42.61,Default,,0,0,0,,Иә
Dialogue: 0,0:36:42.78,0:36:44.53,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:36:45.03,0:36:47.62,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:36:47.78,0:36:49.54,Default,,0,0,0,,Қалай...?
Dialogue: 0,0:36:49.66,0:36:52.16,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:36:53.21,0:36:54.88,Default,,0,0,0,,Мен ол дүниеде кіммін...
Dialogue: 0,0:36:59.25,0:37:00.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:02.09,0:37:03.26,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:37:03.55,0:37:05.01,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:37:05.09,0:37:06.55,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:37:08.22,0:37:10.56,Default,,0,0,0,,Мұнда қалай болды?
Dialogue: 0,0:37:10.68,0:37:11.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:11.85,0:37:13.94,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,0:37:14.60,0:37:16.90,Default,,0,0,0,,Бұл жерде мен аккордтар туралы айттым.
Dialogue: 0,0:37:17.65,0:37:18.82,Default,,0,0,0,,Аккорд?
Dialogue: 0,0:37:18.86,0:37:22.28,Default,,0,0,0,,Аа, кешіріңіз. Егер бұл сізге ыңғайсыздық тудырса, мен тоқтаймын.
Dialogue: 0,0:37:24.70,0:37:26.78,Default,,0,0,0,,Жоқ, маңызды емес.
Dialogue: 0,0:37:28.74,0:37:30.45,Default,,0,0,0,,Мәзірді қалайсыз ба?
Dialogue: 0,0:37:30.70,0:37:32.08,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:37:32.37,0:37:33.50,Default,,0,0,0,,Иә
Dialogue: 0,0:37:34.75,0:37:35.83,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:37:40.96,0:37:42.88,Default,,0,0,0,,Бұл қандай болды?
Dialogue: 0,0:37:43.05,0:37:44.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:44.42,0:37:45.63,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:37:45.72,0:37:46.80,Default,,0,0,0,,Аккорд
Dialogue: 0,0:37:48.05,0:37:49.14,Default,,0,0,0,,Аккорд –
Dialogue: 0,0:37:49.76,0:37:52.81,Default,,0,0,0,,Мен Коёмиге ғашық болдым ба?
Dialogue: 0,0:37:54.10,0:37:55.27,Default,,0,0,0,,Сүйіспеншілік пе?
Dialogue: 0,0:37:55.35,0:37:56.48,Default,,0,0,0,,Иә
Dialogue: 0,0:37:57.06,0:37:58.90,Default,,0,0,0,,А, әрине, маған емес.
Dialogue: 0,0:37:59.40,0:38:00.90,Default,,0,0,0,,Күнтізбе сол жерде...
Dialogue: 0,0:38:01.02,0:38:03.49,Default,,0,0,0,,85 жыл әлеміндегі Такасаки күнтізбесі туралы
Dialogue: 0,0:38:04.86,0:38:06.36,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:38:06.61,0:38:09.32,Default,,0,0,0,,Онда крем қосылған торттарды да жей алмайды ғой, иә?
Dialogue: 0,0:38:12.45,0:38:14.33,Default,,0,0,0,,Бұл себеп емес.
Dialogue: 0,0:38:16.29,0:38:17.50,Default,,0,0,0,,Такигава мырза
Dialogue: 0,0:38:18.46,0:38:20.38,Default,,0,0,0,,Менімен... менімен...
Dialogue: 0,0:38:23.42,0:38:26.30,Default,,0,0,0,,Менің досым бола аласың ба?
Dialogue: 0,0:38:32.47,0:38:34.35,Default,,0,0,0,,Томо… Дачи…
Dialogue: 0,0:38:35.52,0:38:37.52,Default,,0,0,0,,Иә
Dialogue: 0,0:38:42.77,0:38:45.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:47.32,0:38:48.61,Default,,0,0,0,,Такигава мырза?
Dialogue: 0,0:38:49.95,0:38:53.16,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:38:53.37,0:38:57.29,Default,,0,0,0,,Ахахахахха!
Dialogue: 0,0:38:57.41,0:38:59.37,Default,,0,0,0,,Такигава мырза?
Dialogue: 0,0:38:59.50,0:39:02.84,Default,,0,0,0,,Онда? Достарың қандай?
Dialogue: 0,0:39:03.30,0:39:04.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:04.71,0:39:07.13,Default,,0,0,0,,Эй, мынаны қарашы.
Dialogue: 0,0:39:13.01,0:39:14.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:16.64,0:39:18.27,Default,,0,0,0,,Немесе... Аккорд! ?
Dialogue: 0,0:39:18.35,0:39:20.81,Default,,0,0,0,,Жоқ... сен мені алдадың!
Dialogue: 0,0:39:20.94,0:39:23.23,Default,,0,0,0,,Бастапқы әлеміме оралсам жақсы болар еді.
Dialogue: 0,0:39:23.48,0:39:24.78,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:39:25.07,0:39:26.57,Default,,0,0,0,,Морио қаласы керемет орын.
Dialogue: 0,0:39:27.24,0:39:28.45,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:39:29.57,0:39:31.07,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:39:37.04,0:39:38.37,Default,,0,0,0,,Пломба?
Dialogue: 0,0:39:38.46,0:39:39.79,Default,,0,0,0,,Жарайсың, солай ма?
Dialogue: 0,0:39:40.33,0:39:43.29,Default,,0,0,0,,Ум... у... Айтайын дегенім...
Dialogue: 0,0:39:43.38,0:39:44.50,Default,,0,0,0,,Басқаша айтқанда—
Dialogue: 0,0:39:44.59,0:39:46.17,Default,,0,0,0,,Басынан бастап мен...
Dialogue: 0,0:39:46.25,0:39:48.88,Default,,0,0,0,,Мен параллель әлемге барған жоқпын.
Dialogue: 0,0:39:50.51,0:39:53.97,Default,,0,0,0,,Мен әрқашан осы әлемнің Кадзүнэ Такигава болдым.
Dialogue: 0,0:39:54.97,0:39:58.31,Default,,0,0,0,,85-ші аккорд деген ұғым жоқ.
Dialogue: 0,0:39:59.27,0:40:01.02,Default,,0,0,0,,Айтуынша, кеше ол мөлдір сәбиді немесе сондай бір нәрсені тапқан екен—
Dialogue: 0,0:40:02.02,0:40:03.31,Default,,0,0,0,,Неліктен олай?
Dialogue: 0,0:40:05.69,0:40:06.82,Default,,0,0,0,,Қарсы алу
Dialogue: 0,0:40:07.36,0:40:08.82,Default,,0,0,0,,Кек алу?
Dialogue: 0,0:40:09.32,0:40:11.78,Default,,0,0,0,,Себебі сен мені ұмыттың
Dialogue: 0,0:40:11.86,0:40:13.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:16.54,0:40:18.45,Default,,0,0,0,,Ах... (аккорд) Сондықтан!
Dialogue: 0,0:40:18.62,0:40:20.83,Default,,0,0,0,,Такасаки-кун төрағалық емтиханын тапсырды...
Dialogue: 0,0:40:20.87,0:40:23.33,Default,,0,0,0,,Бірінші курс студенті Сіз жоқ дедіңіз, солай ма?
Dialogue: 0,0:40:23.79,0:40:26.71,Default,,0,0,0,,А, иә
Dialogue: 0,0:40:26.80,0:40:28.17,Default,,0,0,0,,Оның орнына—
Dialogue: 0,0:40:28.21,0:40:31.59,Default,,0,0,0,,Қабылдау салтанатында мен жаңа студенттердің валедикторы болдым.
Dialogue: 0,0:40:33.05,0:40:34.18,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:40:34.80,0:40:36.35,Default,,0,0,0,,Қараңызшы, тіпті есімде жоқ.
Dialogue: 0,0:40:36.97,0:40:39.72,Default,,0,0,0,,Тіпті мен, президент, мақтанатынмын...
Dialogue: 0,0:40:40.06,0:40:42.98,Default,,0,0,0,,Оны маған бергеніңді кешіре алмаймын!
Dialogue: 0,0:40:47.07,0:40:49.73,Default,,0,0,0,,Мм... Мен олай ойламаймын...
Dialogue: 0,0:40:50.65,0:40:52.45,Default,,0,0,0,,Мүмкін сіз осылай кек алатын шығарсыз?
Dialogue: 0,0:40:54.53,0:40:57.12,Default,,0,0,0,,Бұл туралы. Әдетте.
Dialogue: 0,0:40:58.54,0:40:59.62,Default,,0,0,0,,Иә...
Dialogue: 0,0:40:59.79,0:41:02.79,Default,,0,0,0,,Мен олай ойламаймын, бірақ бұл қалыпты жағдай.
Dialogue: 0,0:41:04.25,0:41:07.96,Default,,0,0,0,,Мен ерекшеленгім келмеді...
Dialogue: 0,0:41:08.84,0:41:10.63,Default,,0,0,0,,Мен саған қиындық тудырдым ба?
Dialogue: 0,0:41:13.34,0:41:15.09,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:41:17.55,0:41:18.76,Default,,0,0,0,,Татуласу
Dialogue: 0,0:41:19.39,0:41:22.10,Default,,0,0,0,,Күлдіргеннен кейін өзімді жақсы сезіндім.
Dialogue: 0,0:41:23.14,0:41:24.23,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:41:36.87,0:41:38.66,Default,,0,0,0,,Аккорд (аккорд) Не?
Dialogue: 0,0:41:39.12,0:41:42.25,Default,,0,0,0,,Өтінемін... менімен бірге болыңыз.
Dialogue: 0,0:41:43.00,0:41:44.54,Default,,0,0,0,,Жоқ (күнтізбе) иә?
Dialogue: 0,0:41:44.87,0:41:46.12,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:41:46.21,0:41:50.17,Default,,0,0,0,,Маған ұнайтын күнтізбе сенімдірек.
Dialogue: 0,0:41:51.55,0:41:53.09,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:41:54.97,0:41:57.47,Default,,0,0,0,,Такасаки-кун, жоқ!
Dialogue: 0,0:41:58.22,0:42:01.64,Default,,0,0,0,,Сонымен, менің алғашқы мойындауым...
Dialogue: 0,0:42:01.89,0:42:05.27,Default,,0,0,0,,Бұрынғыдай сәлемдеме.
Dialogue: 0,0:42:06.90,0:42:08.65,Default,,0,0,0,,Бұл толығымен апатқа айналды.
Dialogue: 0,0:42:08.98,0:42:10.98,Default,,0,0,0,,Хааа~
Dialogue: 0,0:42:11.94,0:42:14.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:42:15.32,0:42:17.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:21.28,0:42:22.49,Default,,0,0,0,,Алайда —
Dialogue: 0,0:42:22.58,0:42:24.33,Default,,0,0,0,,Мен сізге сәлемдемеңіз десем де...
Dialogue: 0,0:42:24.91,0:42:27.79,Default,,0,0,0,,Аккорд бірінші болып сөйледі.
Dialogue: 0,0:42:28.33,0:42:29.42,Default,,0,0,0,,Не?
Dialogue: 0,0:42:29.92,0:42:31.21,Default,,0,0,0,,Міне
Dialogue: 0,0:42:31.75,0:42:34.30,Default,,0,0,0,,95 ұпай, бұл ұят.
Dialogue: 0,0:42:34.38,0:42:35.76,Default,,0,0,0,,Онда жоқ
Dialogue: 0,0:42:36.26,0:42:37.47,Default,,0,0,0,,Бұл мәселе-
Dialogue: 0,0:42:38.30,0:42:40.80,Default,,0,0,0,,Такасаки-кун ғана дұрыс жауап берді.
Dialogue: 0,0:42:41.05,0:42:43.52,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,0:42:44.43,0:42:45.98,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:42:46.43,0:42:49.44,Default,,0,0,0,,Неліктен сен ғана айлалы сұрақтарға түспейсің?
Dialogue: 0,0:42:49.98,0:42:51.48,Default,,0,0,0,,Бұл қулық...
Dialogue: 0,0:42:51.56,0:42:53.78,Default,,0,0,0,,Бұл әлі сабақта оқытылмаған.
Dialogue: 0,0:42:53.86,0:42:54.99,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:42:55.07,0:42:56.24,Default,,0,0,0,,Иә
Dialogue: 0,0:42:56.28,0:42:59.49,Default,,0,0,0,,Дегенмен, осы уақытқа дейін айтылғандарды кеңейтетін болсақ ...
Dialogue: 0,0:43:00.32,0:43:02.33,Default,,0,0,0,,Бұрынғы еркелік әлі де жеткіліксіз болды ма?
Dialogue: 0,0:43:02.66,0:43:04.83,Default,,0,0,0,,Бірдеңе болса, ол менімен жарыса бастады...
Dialogue: 0,0:43:05.50,0:43:08.83,Default,,0,0,0,,Бұл әдіс күшті ме, әлде шынайы ма...
Dialogue: 0,0:43:09.04,0:43:10.63,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:43:11.42,0:43:12.63,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:43:13.59,0:43:14.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:43:17.42,0:43:19.05,Default,,0,0,0,,Бұл... керемет.
Dialogue: 0,0:43:19.09,0:43:20.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:20.93,0:43:22.18,Default,,0,0,0,,Такасаки-кун
Dialogue: 0,0:43:22.26,0:43:25.31,Default,,0,0,0,,Сіз жапон тілінің классикалық сынағынан 100 ұпай жинаған жоқсыз, солай ма?
Dialogue: 0,0:43:25.89,0:43:27.31,Default,,0,0,0,,Кеңес керек пе?
Dialogue: 0,0:43:28.14,0:43:30.65,Default,,0,0,0,,Маған көне мәтіндер немесе сол сияқты нәрселер маңызды емес.
Dialogue: 0,0:43:30.69,0:43:31.77,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:43:31.86,0:43:35.28,Default,,0,0,0,,Сіз бұрыштарды кесіп аласыз. Мұны байыппен жасаңыз.
Dialogue: 0,0:43:36.74,0:43:38.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:43:38.28,0:43:40.24,Default,,0,0,0,,Мен неге бұлай болғанын білмеймін, бірақ...
Dialogue: 0,0:43:40.36,0:43:42.82,Default,,0,0,0,,Казүнэ екеуміз түскі үзіліс кезінде және сабақтан кейін...
Dialogue: 0,0:43:42.95,0:43:46.16,Default,,0,0,0,,Мен шағын оқу сабақтарын өткізе бастадым.
Dialogue: 0,0:43:47.08,0:43:49.21,Default,,0,0,0,,Басында мен күдіктендім, бірақ...
Dialogue: 0,0:43:49.33,0:43:50.58,Default,,0,0,0,,Өйткені
Dialogue: 0,0:43:50.62,0:43:53.04,Default,,0,0,0,,Онымен сөйлесу бір ғанибет...
Dialogue: 0,0:43:53.38,0:43:55.59,Default,,0,0,0,,Мен де соған өзімді сала бастадым.
Dialogue: 0,0:43:56.38,0:43:57.84,Default,,0,0,0,,Оқу сабақтары мен үшін –
Dialogue: 0,0:43:57.92,0:44:00.01,Default,,0,0,0,,Бұл маған үлкен қуаныш сыйлады, бірақ...
Dialogue: 0,0:44:00.13,0:44:01.97,Default,,0,0,0,,Өз сыныбында үздік екі оқушы...
Dialogue: 0,0:44:02.05,0:44:04.10,Default,,0,0,0,,Олар қатты жұмыс істеген сияқты болды ма?
Dialogue: 0,0:44:04.43,0:44:07.77,Default,,0,0,0,,Бірте-бірте сыныптастарым жинала бастады...
Dialogue: 0,0:44:07.85,0:44:10.98,Default,,0,0,0,,Екеумізге арналған кеңістік оңай жойылады...
Dialogue: 0,0:44:11.10,0:44:15.02,Default,,0,0,0,,«Егер сіз шынымен бағаларыңызды жақсартқыңыз келсе, қыспақ мектебіне барыңыз...»
Dialogue: 0,0:44:15.15,0:44:17.40,Default,,0,0,0,,Шынымды айтсам, мен солай ойладым.
Dialogue: 0,0:44:18.74,0:44:20.11,Default,,0,0,0,,Алайда —
Dialogue: 0,0:44:20.20,0:44:23.53,Default,,0,0,0,,Оқу сабағының нәтижесінде сыныптастар арасындағы әңгіме көбейді.
Dialogue: 0,0:44:23.95,0:44:26.66,Default,,0,0,0,,Барлық сыныптың орташа баллы өсті.
Dialogue: 0,0:44:26.74,0:44:30.00,Default,,0,0,0,,Сыныптағы атмосфера тыныштандырылған құбылыс болды.
Dialogue: 0,0:44:32.92,0:44:35.17,Default,,0,0,0,,Мен де дос деп атайтын адамды таптым.
Dialogue: 0,0:44:36.63,0:44:38.92,Default,,0,0,0,,Бірақ біз жақын болғаннан кейін де...
Dialogue: 0,0:44:39.01,0:44:42.68,Default,,0,0,0,,Өйткені Такасакиде адамның жүрегі жоқ.\NКейде
Dialogue: 0,0:44:42.76,0:44:44.47,Default,,0,0,0,,т.б.
Dialogue: 0,0:44:45.14,0:44:46.39,Default,,0,0,0,,Аккордта...
Dialogue: 0,0:44:46.47,0:44:48.52,Default,,0,0,0,,Күнтізбе тым сезімтал емес
Dialogue: 0,0:44:48.77,0:44:50.27,Default,,0,0,0,,жиі айтылады.
Dialogue: 0,0:44:51.14,0:44:53.60,Default,,0,0,0,,Басқаша айтқанда, менде адамның жүрегі жоқ—
Dialogue: 0,0:44:54.15,0:44:58.15,Default,,0,0,0,,Сондықтан біз басқа тұлғаны ескере отырып әрекет ете алмаймыз.
Dialogue: 0,0:44:58.53,0:45:02.11,Default,,0,0,0,,Ал сіз одан мүлде бейхабарсыз.
Dialogue: 0,0:45:06.32,0:45:07.99,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:45:09.08,0:45:10.83,Default,,0,0,0,,Мен орта мектепте оқимын.
Dialogue: 0,0:45:11.00,0:45:14.75,Default,,0,0,0,,Достардың көмегімен, дәлірек айтқанда, қызығушылықтан...
Dialogue: 0,0:45:15.13,0:45:16.50,Default,,0,0,0,,Аккордты мойындау...
Dialogue: 0,0:45:17.46,0:45:18.55,Default,,0,0,0,,Аккорд!
Dialogue: 0,0:45:19.21,0:45:20.76,Default,,0,0,0,,Не?
Dialogue: 0,0:45:21.46,0:45:25.30,Default,,0,0,0,,Сіз білесіз деп ойлаймын, бірақ сіз маған қатты ұнайсыз.
Dialogue: 0,0:45:25.59,0:45:26.85,Default,,0,0,0,,Менімен... (Микрофонның дыбысы қосулы)
Dialogue: 0,0:45:28.85,0:45:30.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:45:30.56,0:45:33.02,Default,,0,0,0,,(Достар күлкісі)
Dialogue: 0,0:45:39.94,0:45:41.07,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:45:46.16,0:45:48.07,Default,,0,0,0,,Менде адамның жүрегі жоқ
Dialogue: 0,0:45:48.45,0:45:49.95,Default,,0,0,0,,Түсініспеушіліктің шегі бар
Dialogue: 0,0:45:53.75,0:45:56.00,Default,,0,0,0,,Аккордтар мүлде қолданылмайды—
Dialogue: 0,0:45:56.58,0:46:00.00,Default,,0,0,0,,Мектеп бітіру рәсімі күні мойындау оңай айналып өтті.
Dialogue: 0,0:46:02.26,0:46:03.92,Default,,0,0,0,,Мен жалғастырдым:
Dialogue: 0,0:46:04.05,0:46:08.47,Default,,0,0,0,,Бұл виртуалды ғылым бөлімін құрған әлемдегі бірінші университет болды...
Dialogue: 0,0:46:09.10,0:46:11.14,Default,,0,0,0,,Мұнда да аккорд сияқты болды.
Dialogue: 0,0:46:13.60,0:46:14.73,Default,,0,0,0,,Айтпақшы—
Dialogue: 0,0:46:15.52,0:46:17.15,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:46:17.69,0:46:18.77,Default,,0,0,0,,Не?
Dialogue: 0,0:46:19.15,0:46:21.36,Default,,0,0,0,,Менімен бірге шығасың ба?
Dialogue: 0,0:46:21.65,0:46:22.78,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:46:23.36,0:46:24.65,Default,,0,0,0,,Қайда?
Dialogue: 0,0:46:32.08,0:46:34.70,Default,,0,0,0,,
Dialogue: 0,0:46:37.58,0:46:39.75,Default,,0,0,0,,Біз осылай кездесе бастадық.
Dialogue: 0,0:46:42.50,0:46:43.92,Default,,0,0,0,,Аккордтар негізінен —
Dialogue: 0,0:46:44.01,0:46:46.72,Default,,0,0,0,,Ол данышпанның тыныш және салқын стилін сақтап қалды, бірақ...
Dialogue: 0,0:46:47.01,0:46:48.38,Default,,0,0,0,,Екеуміз ғана болғанда...
Dialogue: 0,0:46:48.47,0:46:50.89,Default,,0,0,0,,Әзіл айту немесе тәтті болу
Dialogue: 0,0:46:51.97,0:46:55.18,Default,,0,0,0,,Бірақ мен түсінбейтін себептермен жиі ашуланамын.
Dialogue: 0,0:46:55.60,0:46:57.56,Default,,0,0,0,,Нәтижесі Мен және аккорд:
Dialogue: 0,0:46:57.64,0:46:59.65,Default,,0,0,0,,Қайта-қайта жабысып, ажырату
Dialogue: 0,0:46:59.73,0:47:01.48,Default,,0,0,0,,Та-ка-саки-!
Dialogue: 0,0:47:06.99,0:47:08.11,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:47:08.57,0:47:09.70,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:47:10.07,0:47:11.28,Default,,0,0,0,,Ұйқысы келген сияқты
Dialogue: 0,0:47:11.49,0:47:13.62,Default,,0,0,0,,Иә, ұйқым келіп тұр...
Dialogue: 0,0:47:23.67,0:47:25.26,Default,,0,0,0,,Әй, шаш!
Dialogue: 0,0:47:28.26,0:47:29.72,Default,,0,0,0,,Университетті бітіргеннен кейін—
Dialogue: 0,0:47:30.01,0:47:31.59,Default,,0,0,0,,Екеуміз бірге
Dialogue: 0,0:47:31.80,0:47:35.01,Default,,0,0,0,,Менің әкем директордың орынбасары болып табылатын Виртуалды ғылыми зерттеу институтына қосылды.
Dialogue: 0,0:47:37.64,0:47:38.81,Default,,0,0,0,,Не болды?
Dialogue: 0,0:47:38.98,0:47:40.19,Default,,0,0,0,,Иә
Dialogue: 0,0:47:40.35,0:47:43.23,Default,,0,0,0,,Бұл бірінші рет емес, солай ма? (күнтізбе) Иә?
Dialogue: 0,0:47:43.94,0:47:46.86,Default,,0,0,0,,Сіз турлар мен сұхбаттар үшін осында бірнеше рет болдыңыз.
Dialogue: 0,0:47:47.86,0:47:49.99,Default,,0,0,0,,Олай десеңіз, иә.
Dialogue: 0,0:47:50.57,0:47:52.57,Default,,0,0,0,,Бұл күндері IP терминалдары...
Dialogue: 0,0:47:52.66,0:47:54.74,Default,,0,0,0,,Ол практикалық қолдану қарсаңында болды, бірақ...
Dialogue: 0,0:47:55.03,0:47:57.04,Default,,0,0,0,,Кейде ақаулар болды.
Dialogue: 0,0:47:58.50,0:48:01.12,Default,,0,0,0,,Бізге тағайындалған бірінші команда:
Dialogue: 0,0:48:01.21,0:48:04.38,Default,,0,0,0,,Мақсат IP терминалдарының сенімділігін арттыру болды.
Dialogue: 0,0:48:04.42,0:48:07.51,Default,,0,0,0,,♪~
Dialogue: 0,0:48:07.59,0:48:12.18,Default,,0,0,0,,♪ Жыл мезгілінің сұлулығы бізді сөзсіз қалдырады
Dialogue: 0,0:48:12.26,0:48:17.85,Default,,0,0,0,,♪ Ол ақырында жүрегіңнің ең шетінде кеуіп қалады.
Dialogue: 0,0:48:17.93,0:48:22.94,Default,,0,0,0,,♪ Оны мазасыз жүрегіңе қалдыр да, түннен ары кет
Dialogue: 0,0:48:23.06,0:48:28.23,Default,,0,0,0,,♪ Мазасыз ауруыңызды осында тастаңыз.
Dialogue: 0,0:48:28.32,0:48:32.91,Default,,0,0,0,,♪ Ақырында өтетін бір сәттік сезімдерге
Dialogue: 0,0:48:32.99,0:48:38.20,Default,,0,0,0,,♪ Ғашық болып қалатын гүл шоғы
Dialogue: 0,0:48:38.45,0:48:43.33,Default,,0,0,0,,♪ Ертеңгі күннің нұрын іздеу
Dialogue: 0,0:48:43.42,0:48:48.71,Default,,0,0,0,,♪ Бұл өте ауыр
Dialogue: 0,0:48:48.80,0:48:53.72,Default,,0,0,0,,♪ Жүрегіңе жету үшін
Dialogue: 0,0:48:54.05,0:48:59.06,Default,,0,0,0,,♪ Жаңа көрген табиғатты жібермеймін
Dialogue: 0,0:48:59.27,0:49:02.85,Default,,0,0,0,,♪ Бұл біздің дәлеліміз.
Dialogue: 0,0:49:04.10,0:49:08.57,Default,,0,0,0,,♪ Жазғы жаңбыр мен қыстың аптап ыстығы
Dialogue: 0,0:49:09.32,0:49:13.61,Default,,0,0,0,,♪ Күздің тікенегі мен көктемнің түстері
Dialogue: 0,0:49:14.49,0:49:16.24,Default,,0,0,0,,♪ Сізге
Dialogue: 0,0:49:17.12,0:49:18.37,Default,,0,0,0,,♪ Тек сіз үшін
Dialogue: 0,0:49:18.45,0:49:19.58,Default,,0,0,0,,Бұл жұмыс істейтін сияқты.
Dialogue: 0,0:49:19.62,0:49:20.87,Default,,0,0,0,,Иә.
Dialogue: 0,0:49:22.75,0:49:25.46,Default,,0,0,0,,Жақсы емес пе? Айтайын дегенім, мінсіз
Dialogue: 0,0:49:26.54,0:49:28.13,Default,,0,0,0,,Мен мектептегі іс-шараларды ерекше жек көрдім
Dialogue: 0,0:49:28.59,0:49:30.84,Default,,0,0,0,,Қылқалам қаламдарын пайдалану өте оңай.
Dialogue: 0,0:49:31.84,0:49:33.55,Default,,0,0,0,,Көз контурлағышы!
Dialogue: 0,0:49:33.80,0:49:35.09,Default,,0,0,0,,Исла...?
Dialogue: 0,0:49:38.39,0:49:41.47,Default,,0,0,0,,Сіз шынымен байқамадыңыз ба?
Dialogue: 0,0:49:41.64,0:49:42.85,Default,,0,0,0,,Мен оны аша аламын!
Dialogue: 0,0:49:42.98,0:49:44.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:46.19,0:49:47.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:48.06,0:49:49.94,Default,,0,0,0,,Смартфондарға ақпаратты енгізу көп уақытты алады.
Dialogue: 0,0:49:50.27,0:49:51.61,Default,,0,0,0,,Экран кішкентай—
Dialogue: 0,0:49:51.69,0:49:54.32,Default,,0,0,0,,Барлық теңдеуді қайта қарау қиын, солай емес пе?
Dialogue: 0,0:49:54.53,0:49:56.95,Default,,0,0,0,,Ал анаң ше?
Dialogue: 0,0:49:57.20,0:50:00.87,Default,,0,0,0,,А, айтшы, мен тазалау ақысын төлеймін.
Dialogue: 0,0:50:01.70,0:50:03.20,Default,,0,0,0,,Шын мәнінде емес
Dialogue: 0,0:50:03.79,0:50:05.54,Default,,0,0,0,,Түсіндім, кешіріңіз.
Dialogue: 0,0:50:06.29,0:50:07.50,Default,,0,0,0,,Көйлек Ақшасын төлеймін.
Dialogue: 0,0:50:07.71,0:50:09.79,Default,,0,0,0,,Жақсы (күнтізбе) Ах...
Dialogue: 0,0:50:09.96,0:50:15.22,Default,,0,0,0,,~♪
Dialogue: 0,0:50:19.30,0:50:20.89,Default,,0,0,0,,Аккордтар және менің идеяларым:
Dialogue: 0,0:50:21.10,0:50:24.14,Default,,0,0,0,,IP терминалдарының өнімділігін айтарлықтай жақсартты
Dialogue: 0,0:50:25.60,0:50:28.27,Default,,0,0,0,,Сондықтан өте жақын параллель әлемде—
Dialogue: 0,0:50:28.40,0:50:32.23,Default,,0,0,0,,Адамдар күнделікті заттарды байқамай ауыстырады екен.
Dialogue: 0,0:50:33.90,0:50:36.57,Default,,0,0,0,,Терминалдар жалпы мониторларға да таратылады.
Dialogue: 0,0:50:36.95,0:50:39.32,Default,,0,0,0,,Қосымша деректерді жинау басталды
Dialogue: 0,0:50:41.99,0:50:44.37,Default,,0,0,0,,Маған тұрмысқа шығуыңызды өтінемін
Dialogue: 0,0:50:52.71,0:50:54.34,Default,,0,0,0,,Аквамарин.
Dialogue: 0,0:50:54.42,0:50:55.55,Default,,0,0,0,,Иә
Dialogue: 0,0:50:56.05,0:50:58.34,Default,,0,0,0,,Наурыздың туған тасы деп естідім.
Dialogue: 0,0:51:00.05,0:51:02.26,Default,,0,0,0,,Күнтізбе үшін қолайлы
Dialogue: 0,0:51:04.35,0:51:07.19,Default,,0,0,0,,Не болды? Бұл менің сол жақ сақина саусағым.
Dialogue: 0,0:51:07.23,0:51:08.39,Default,,0,0,0,,Га
Dialogue: 0,0:51:11.11,0:51:12.19,Default,,0,0,0,,Рахмет
Dialogue: 0,0:51:12.27,0:51:15.40,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұдан былай емес.
Dialogue: 0,0:51:16.11,0:51:18.36,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:51:23.83,0:51:26.79,Default,,0,0,0,,Сыртта сыра ішуге аздап салқын.
Dialogue: 0,0:51:27.08,0:51:28.37,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:51:28.46,0:51:31.67,Default,,0,0,0,,Бірақ мен бәрібір стақандағы сыраны ішкім келеді.
Dialogue: 0,0:51:32.84,0:51:35.00,Default,,0,0,0,,Ал шын мәнінде мұнда -
Dialogue: 0,0:51:35.13,0:51:37.67,Default,,0,0,0,,Сіз аздап ерекше түнгі көріністі көре аласыз...
Dialogue: 0,0:51:38.13,0:51:40.13,Default,,0,0,0,,Мен уақытты қате түсіндім деп ойлаймын.
Dialogue: 0,0:51:41.01,0:51:42.35,Default,,0,0,0,,Уфуфу…
Dialogue: 0,0:51:42.72,0:51:45.18,Default,,0,0,0,,Бұл Такасаки-кунға көбірек ұқсайды.
Dialogue: 0,0:51:45.72,0:51:46.97,Default,,0,0,0,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,0:51:47.14,0:51:50.06,Default,,0,0,0,,Мен сол түнгі көріністі асыға күтемін.
Dialogue: 0,0:51:51.27,0:51:52.61,Default,,0,0,0,,Эй?
Dialogue: 0,0:51:54.23,0:51:55.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:55.78,0:51:56.86,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:51:57.36,0:51:59.53,Default,,0,0,0,,Сөмке
Dialogue: 0,0:51:59.70,0:52:01.32,Default,,0,0,0,,Қарама-қарсы жақ (аккорд) Иә?
Dialogue: 0,0:52:02.57,0:52:05.41,Default,,0,0,0,,А? Бұл біртүрлі
Dialogue: 0,0:52:06.12,0:52:08.50,Default,,0,0,0,,Мен оны оң жаққа қойдым деп ойлаймын...
Dialogue: 0,0:52:13.08,0:52:14.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:52:14.29,0:52:15.92,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:52:17.46,0:52:18.71,Default,,0,0,0,,Сіз неден бастайсыз?
Dialogue: 0,0:52:19.72,0:52:21.47,Default,,0,0,0,,Мен кенет ойладым
Dialogue: 0,0:52:22.55,0:52:25.64,Default,,0,0,0,,Бұл сақинаны алған 0 аккорд болды ма?
Dialogue: 0,0:52:26.31,0:52:28.72,Default,,0,0,0,,Мен ол кезде 0 болдым ба?
Dialogue: 0,0:52:28.77,0:52:29.85,Default,,0,0,0,,
Dialogue: 0,0:52:30.43,0:52:31.56,Default,,0,0,0,,Иә
Dialogue: 0,0:52:31.81,0:52:32.94,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:52:33.02,0:52:35.65,Default,,0,0,0,,Коёми Такасаки, осы жерді басыңыз.
Dialogue: 0,0:52:51.16,0:52:52.71,Default,,0,0,0,,IP терминалы
Dialogue: 0,0:52:53.21,0:52:55.00,Default,,0,0,0,,Иә, аккордтар да.
Dialogue: 0,0:52:55.25,0:52:56.42,Default,,0,0,0,,Иә
Dialogue: 0,0:53:00.51,0:53:07.51,Default,,0,0,0,,♪～(Үйлену наурызы)
Dialogue: 0,0:53:25.49,0:53:28.49,Default,,0,0,0,,Мен кімге үйленемін?
Dialogue: 0,0:53:28.78,0:53:32.79,Default,,0,0,0,,~♪
Dialogue: 0,0:53:35.17,0:53:37.79,Default,,0,0,0,,Параллель дүниелерді зерттеу алға жылжыған сайын—
Dialogue: 0,0:53:38.29,0:53:41.01,Default,,0,0,0,,Параллель дүниелер бір-бірімен байланысқандықтан—
Dialogue: 0,0:53:41.30,0:53:43.76,Default,,0,0,0,,Бүкіл әлем кванттық компьютерге айналады.
Dialogue: 0,0:53:44.59,0:53:46.14,Default,,0,0,0,,Жалған ғылым ғана емес —
Dialogue: 0,0:53:46.51,0:53:49.26,Default,,0,0,0,,Барлық ғылым мен техниканың дамуы жеделдей бастады.
Dialogue: 0,0:53:51.35,0:53:53.27,Default,,0,0,0,,Менің үйімде
Dialogue: 0,0:53:53.31,0:53:55.94,Default,,0,0,0,,Алдыңғы кіреберіс қысқа уақыт ішінде екі рет ашылды.
Dialogue: 0,0:53:56.81,0:53:58.65,Default,,0,0,0,,Мен өзімді толығымен жалғыз сезінемін.
Dialogue: 0,0:54:00.52,0:54:02.78,Default,,0,0,0,,Бірақ жаңа отбасы да келді.
Dialogue: 0,0:54:03.36,0:54:04.45,Default,,0,0,0,,Қандай түс?
Dialogue: 0,0:54:04.53,0:54:05.78,Default,,0,0,0,,Апельсин!
Dialogue: 0,0:54:06.20,0:54:07.32,Default,,0,0,0,,Мұнда қараңыз.
Dialogue: 0,0:54:07.53,0:54:09.03,Default,,0,0,0,,♬~
Dialogue: 0,0:54:11.95,0:54:13.50,Default,,0,0,0,,Ненің суретін салып жатырсың?
Dialogue: 0,0:54:14.04,0:54:15.29,Default,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:54:15.96,0:54:18.21,Default,,0,0,0,,Сіз түсінбейтін нәрсені салып жатырсыз ба?
Dialogue: 0,0:54:18.54,0:54:19.71,Default,,0,0,0,,Иә
Dialogue: 0,0:54:20.00,0:54:22.76,Default,,0,0,0,,Атын білмеймін, бірақ керемет болды
Dialogue: 0,0:54:23.01,0:54:25.68,Default,,0,0,0,,Иә, сен оны қайдан көрдің?
Dialogue: 0,0:54:26.01,0:54:27.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:54:28.09,0:54:30.81,Default,,0,0,0,,Бұған дейін әкеммен бірге көруге бардым.
Dialogue: 0,0:54:30.93,0:54:32.01,Default,,0,0,0,,Қайда?
Dialogue: 0,0:54:32.35,0:54:35.31,Default,,0,0,0,,Құпияны білмеймін
Dialogue: 0,0:54:35.52,0:54:37.90,Default,,0,0,0,,Не? Бұл қайда?
Dialogue: 0,0:54:37.98,0:54:39.23,Default,,0,0,0,,Құпия
Dialogue: 0,0:54:39.73,0:54:41.65,Default,,0,0,0,,Айтыңызшы~
Dialogue: 0,0:54:41.73,0:54:43.03,Default,,0,0,0,,Айтпа
Dialogue: 0,0:54:43.11,0:54:44.82,Default,,0,0,0,,Құт
Dialogue: 0,0:54:44.94,0:54:47.36,Default,,0,0,0,,Мама, сіз мені мазалап жатырсыз~
Dialogue: 0,0:54:47.53,0:54:49.99,Default,,0,0,0,,Эй, айтшы~
Dialogue: 0,0:54:50.07,0:54:52.12,Default,,0,0,0,,Кочо Кочо Кочо~
Dialogue: 0,0:54:52.20,0:54:55.04,Default,,0,0,0,,Көңілді сияқты, бірақ сыртқа шығатын кез келді.
Dialogue: 0,0:54:55.41,0:54:59.13,Default,,0,0,0,,Сузугане, суреттің қайда екенін айтпайсың.
Dialogue: 0,0:54:59.29,0:55:02.46,Default,,0,0,0,,Әкем нені жақсы көретінін біледі.
Dialogue: 0,0:55:02.63,0:55:05.09,Default,,0,0,0,,Хмм, қай жерде екен деп ойлаймын.
Dialogue: 0,0:55:05.34,0:55:06.97,Default,,0,0,0,,Бұл әлі орындалып жатқан жұмыс
Dialogue: 0,0:55:07.05,0:55:08.30,Default,,0,0,0,,Хмм.
Dialogue: 0,0:55:09.34,0:55:11.51,Default,,0,0,0,,Ал, енді барайық.
Dialogue: 0,0:55:11.64,0:55:12.72,Default,,0,0,0,,Е...
Dialogue: 0,0:55:12.85,0:55:14.68,Default,,0,0,0,,Тағы біраз сурет салған соң
Dialogue: 0,0:55:15.02,0:55:16.77,Default,,0,0,0,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:55:17.27,0:55:19.94,Default,,0,0,0,,Ал, бүгінгі ерекше...
Dialogue: 0,0:55:20.06,0:55:22.61,Default,,0,0,0,,Қарындаштарыңызды қалдырып, сыртқа шығуға болады.
Dialogue: 0,0:55:22.77,0:55:24.15,Default,,0,0,0,,Сен жинамайсың ба?
Dialogue: 0,0:55:24.32,0:55:27.53,Default,,0,0,0,,Егер солай болса, сіз қайтып келіп, қалғанын бірден сыза аласыз, солай ма?
Dialogue: 0,0:55:27.74,0:55:28.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:55:31.57,0:55:33.58,Default,,0,0,0,,Бірақ қарындашты баспаңыз
Dialogue: 0,0:55:33.78,0:55:34.95,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:55:35.41,0:55:40.17,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:55:45.50,0:55:49.34,Default,,0,0,0,,Көрме өткізу үшін алаңның ішінде қараңғы жарық аймақтары бар.
Dialogue: 0,0:55:50.47,0:55:53.47,Default,,0,0,0,,Қиял хайуанаттар бағы өзара әрекеттестікке толы...
Dialogue: 0,0:55:58.31,0:55:59.85,Default,,0,0,0,,Ах! Хахаха
Dialogue: 0,0:56:03.94,0:56:05.27,Default,,0,0,0,,Жалғастырмайды
Dialogue: 0,0:56:05.40,0:56:07.07,Default,,0,0,0,,Әлі де біраз уақыт керек сияқты.
Dialogue: 0,0:56:07.69,0:56:10.45,Default,,0,0,0,,Мүмкін шамамен 5 немесе 10 минут.
Dialogue: 0,0:56:11.03,0:56:12.24,Default,,0,0,0,,Қазір аккорд қайда?
Dialogue: 0,0:56:12.45,0:56:16.33,Default,,0,0,0,,Орталық алаңдағы төбені тұман деп атайды.
Dialogue: 0,0:56:16.95,0:56:18.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:56:18.29,0:56:19.58,Default,,0,0,0,,Аккорд?
Dialogue: 0,0:56:20.25,0:56:21.42,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:56:21.46,0:56:26.30,Default,,0,0,0,,(адамның қатты айқайы)
Dialogue: 0,0:56:26.42,0:56:30.34,Default,,0,0,0,,(Қашып бара жатқан адамдардың дауыстары)
Dialogue: 0,0:56:30.42,0:56:33.39,Default,,0,0,0,,Хаа ха ха ха ха
Dialogue: 0,0:56:38.10,0:56:40.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:41.94,0:56:44.36,Default,,0,0,0,,Керемет пе? Керемет!
Dialogue: 0,0:56:48.07,0:56:50.69,Default,,0,0,0,,Керемет! Осы жолмен
Dialogue: 0,0:56:51.32,0:56:52.45,Default,,0,0,0,,Мыңғыр!
Dialogue: 0,0:56:52.95,0:56:54.53,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:56:54.99,0:56:57.70,Default,,0,0,0,,Ооооооооо!
Dialogue: 0,0:56:59.45,0:57:01.79,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:57:01.96,0:57:03.71,Default,,0,0,0,,Керемет!
Dialogue: 0,0:57:03.96,0:57:05.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:57:08.13,0:57:11.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:57:11.34,0:57:13.05,Default,,0,0,0,,(Бұзықтың айқайы)
Dialogue: 0,0:57:13.18,0:57:15.39,Default,,0,0,0,,Ах! Уф
Dialogue: 0,0:57:15.51,0:57:17.01,Default,,0,0,0,,Кя! ! (күнтізбе) бұл!
Dialogue: 0,0:57:17.18,0:57:18.64,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:57:50.09,0:57:51.38,Default,,0,0,0,,Не болды?
Dialogue: 0,0:57:52.13,0:57:53.30,Default,,0,0,0,,Иә
Dialogue: 0,0:57:53.72,0:57:56.43,Default,,0,0,0,,Жоқ, мен жаман түс көріп тұрмын.
Dialogue: 0,0:57:57.43,0:57:59.72,Default,,0,0,0,,Осыдан кейін болды, солай ма?
Dialogue: 0,0:58:00.10,0:58:02.39,Default,,0,0,0,,Ах (аккорд) бірақ бәрібір
Dialogue: 0,0:58:03.02,0:58:05.10,Default,,0,0,0,,Енді алаңдайтын ештеңе жоқ
Dialogue: 0,0:58:05.64,0:58:06.98,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:58:07.69,0:58:10.86,Default,,0,0,0,,Қылмыскер де сол жерде ұсталды.
Dialogue: 0,0:58:15.45,0:58:18.41,Default,,0,0,0,,Ең бастысы, мен Рионың қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:58:19.33,0:58:22.12,Default,,0,0,0,,Қылмыскермен бетпе-бет келгені үшін Коёмиге рахмет.
Dialogue: 0,0:58:22.66,0:58:24.25,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,0:58:25.37,0:58:28.75,Default,,0,0,0,,Мен Кадзүнэ айтқан адамға біраз жақындадым ба деп ойлаймын...
Dialogue: 0,0:58:28.92,0:58:30.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:30.21,0:58:32.55,Default,,0,0,0,,Қараңызшы, сіз мұны баяғыда айттыңыз.
Dialogue: 0,0:58:33.26,0:58:36.34,Default,,0,0,0,,Менің күнтізбем сенімдірек адам.
Dialogue: 0,0:58:40.64,0:58:41.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:42.18,0:58:45.52,Default,,0,0,0,,Райо екеуіңнің араларыңда ештеңе болмағанына қуаныштымын.
Dialogue: 0,0:58:47.27,0:58:48.52,Default,,0,0,0,,Аккорд
Dialogue: 0,0:58:53.53,0:58:57.70,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:59:12.09,0:59:14.51,Default,,0,0,0,,Істі біржола сүйреп апару жақсы емес...
Dialogue: 0,0:59:14.76,0:59:17.51,Default,,0,0,0,,Мен мүмкіндігінше тезірек қалыпты өмірге оралған дұрыс деп ойлаймын.
Dialogue: 0,0:59:18.26,0:59:21.51,Default,,0,0,0,,Келесі аптада оны қайтадан балабақшаға жіберуге қалай болады?
Dialogue: 0,0:59:21.68,0:59:24.31,Default,,0,0,0,,Менің барғым келеді! Мен балабақшаға барғым келеді
Dialogue: 0,0:59:24.39,0:59:25.52,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:59:25.56,0:59:28.23,Default,,0,0,0,,Көшеге алып шыққанда маған бірдеңе болса ше?
Dialogue: 0,0:59:28.31,0:59:29.77,Default,,0,0,0,,Ах... (Рё) А...
Dialogue: 0,0:59:31.52,0:59:32.61,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:59:32.73,0:59:35.07,Default,,0,0,0,,Анам ашулы емес.
Dialogue: 0,0:59:35.19,0:59:36.28,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:59:38.11,0:59:40.78,Default,,0,0,0,,Сіз таң қалдыңыз ба? кешіріңіз
Dialogue: 0,0:59:41.74,0:59:44.45,Default,,0,0,0,,Иә, түскі асқа не жегің келеді?
Dialogue: 0,0:59:44.58,0:59:47.79,Default,,0,0,0,,Не? Мен таңғы ас іштім.
Dialogue: 0,0:59:49.46,0:59:52.21,Default,,0,0,0,,Соқтығыс! (Күнтізбе) О
Dialogue: 0,0:59:54.17,0:59:55.25,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:59:55.34,0:59:57.21,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:59:57.67,0:59:59.05,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:59:59.17,1:00:01.84,Default,,0,0,0,,Үйге бара жатқанда сатып алатын нәрсе бар ма?
Dialogue: 0,1:00:01.93,1:00:03.47,Default,,0,0,0,,Иә.
Dialogue: 0,1:00:04.05,1:00:05.64,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:00:05.76,1:00:09.39,Default,,0,0,0,,Ұшатын гуманоид Оны терезеден шығаруға болады ма?
Dialogue: 0,1:00:09.48,1:00:11.35,Default,,0,0,0,,Жел ұшып, адасып кетесің.
Dialogue: 0,1:00:11.40,1:00:12.44,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:12.48,1:00:14.27,Default,,0,0,0,,Қараңызшы, мен айттым.
Dialogue: 0,1:00:14.36,1:00:16.61,Default,,0,0,0,,Хмм.
Dialogue: 0,1:00:16.69,1:00:19.70,Default,,0,0,0,,Эй, Райо, бұл сурет әлі орындалу үстінде.
Dialogue: 0,1:00:19.90,1:00:21.66,Default,,0,0,0,,Сіз сурет салуды жалғастырмайсыз ба?
Dialogue: 0,1:00:21.86,1:00:23.28,Default,,0,0,0,,Өз орныңды біл.
Dialogue: 0,1:00:23.37,1:00:26.62,Default,,0,0,0,,Мен не болғанын ұмытып қалдым.
Dialogue: 0,1:00:30.71,1:00:32.33,Default,,0,0,0,,Казунэ-кун ше?
Dialogue: 0,1:00:33.08,1:00:36.25,Default,,0,0,0,,Осыдан кейін бірден сіз маған қарағанда сабырлы болдыңыз...
Dialogue: 0,1:00:36.59,1:00:38.76,Default,,0,0,0,,Мен бұл аккорд сияқты естіледі деп ойладым...
Dialogue: 0,1:00:40.01,1:00:42.63,Default,,0,0,0,,Соңғы үш күнде...
Dialogue: 0,1:00:43.59,1:00:45.93,Default,,0,0,0,,Мен Риодан бір сәтке де кетуге тырыспаймын.
Dialogue: 0,1:00:46.56,1:00:49.56,Default,,0,0,0,,Міне, осындай оқиға болған соң.
Dialogue: 0,1:00:49.81,1:00:52.02,Default,,0,0,0,,Ана үшін табиғи нәрсе емес пе?
Dialogue: 0,1:00:52.64,1:00:55.06,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,1:00:55.15,1:00:56.73,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:00:57.82,1:00:59.65,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,1:00:59.90,1:01:02.99,Default,,0,0,0,,Осы жолы Рьюді қорғай алғаныңызға қуаныштымын, бірақ...
Dialogue: 0,1:01:03.07,1:01:06.24,Default,,0,0,0,,Әйтпесе, сіз тіпті білмейсіз.
Dialogue: 0,1:01:06.41,1:01:07.83,Default,,0,0,0,,Егер жоқ болса ше?
Dialogue: 0,1:01:08.16,1:01:09.29,Default,,0,0,0,,
Dialogue: 0,1:01:09.33,1:01:12.00,Default,,0,0,0,,Кешіріңіз. Сіз сенімдісіз бе?
Dialogue: 0,1:01:12.08,1:01:13.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:01:13.29,1:01:16.29,Default,,0,0,0,,Директордың орынбасары, сәл кешіріңіз.
Dialogue: 0,1:01:22.38,1:01:25.93,Default,,0,0,0,,Маған False Science агенттігінен шұғыл хабарлама келді...
Dialogue: 0,1:01:26.43,1:01:27.51,Default,,0,0,0,,Төтенше жағдай?
Dialogue: 0,1:01:27.64,1:01:31.10,Default,,0,0,0,,Иә, жаңадан құрылған жылжымалы бақылау бөлмесіне сілтеме жасай отырып.
Dialogue: 0,1:01:32.35,1:01:33.69,Default,,0,0,0,,Хмм...
Dialogue: 0,1:01:43.11,1:01:46.87,Default,,0,0,0,,SIP 22 салыстырмалы мәні плюс 10 ма?
Dialogue: 0,1:01:47.12,1:01:49.66,Default,,0,0,0,,Мәселе ауысым қашықтығы...
Dialogue: 0,1:01:50.12,1:01:52.33,Default,,0,0,0,,Мен бүгін ерте кетемін.
Dialogue: 0,1:01:52.41,1:01:54.00,Default,,0,0,0,,Күту күнтізбесі
Dialogue: 0,1:01:54.67,1:01:56.33,Default,,0,0,0,,Казунэ-кун үшін—
Dialogue: 0,1:01:56.38,1:01:57.96,Default,,0,0,0,,Рұқсат етілмеген қосымша ауыстыру —
Dialogue: 0,1:01:58.00,1:01:59.63,Default,,0,0,0,,Бұл расталған сияқты.
Dialogue: 0,1:02:00.88,1:02:02.63,Default,,0,0,0,,«Қосымша ауысым»
Dialogue: 0,1:02:02.88,1:02:07.14,Default,,0,0,0,,Жасанды түрде параллель ығысу жасау үшін магниттік генераторды пайдалану —
Dialogue: 0,1:02:07.30,1:02:10.22,Default,,0,0,0,,Белгілі бір параллель әлемде өзіңізбен орындарды ауыстыру үшін ауысыңыз
Dialogue: 0,1:02:12.39,1:02:15.48,Default,,0,0,0,,10 жылдан астам елестету ғылымы институтында...
Dialogue: 0,1:02:15.56,1:02:18.06,Default,,0,0,0,,Мен қосымша ауысымдармен тәжірибе жасап көрдім, бірақ...
Dialogue: 0,1:02:18.23,1:02:20.98,Default,,0,0,0,,Қазірдің өзінде эксперименттер жүргізгенде —
Dialogue: 0,1:02:21.07,1:02:24.19,Default,,0,0,0,,Қадағалау органына хабарлау қажет
Dialogue: 0,1:02:25.07,1:02:27.82,Default,,0,0,0,,Қосымша ауысым әртүрлі мәселелерге толы
Dialogue: 0,1:02:28.49,1:02:31.99,Default,,0,0,0,,Солардың бірі – қылмыс үшін пайдаланылу мүмкіндігі.
Dialogue: 0,1:02:32.83,1:02:36.92,Default,,0,0,0,,Сіздің отбасыңыздың қауіпсіздігі – біздің басты міндетіміз екені айтпаса да түсінікті.
Dialogue: 0,1:02:37.75,1:02:40.00,Default,,0,0,0,,Бірақ жағдай қалай болатынына байланысты
Dialogue: 0,1:02:40.17,1:02:42.84,Default,,0,0,0,,Академия мен қоғамға үлкен әсері
Dialogue: 0,1:02:43.13,1:02:44.80,Default,,0,0,0,,Мұқият ұстаңыз
Dialogue: 0,1:02:45.72,1:02:47.59,Default,,0,0,0,,Бізді алаңдататын нәрсе:
Dialogue: 0,1:02:47.68,1:02:50.64,Default,,0,0,0,,Бұл сәл күрделірек басқа мәселе болды.
Dialogue: 0,1:02:53.22,1:02:54.43,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:03:05.11,1:03:07.32,Default,,0,0,0,,Аккорд? Бұл менмін
Dialogue: 0,1:03:09.28,1:03:11.03,Default,,0,0,0,,Рио Мен оны ашамын.
Dialogue: 0,1:03:52.53,1:03:56.91,Default,,0,0,0,,Хаха хаха
Dialogue: 0,1:04:13.85,1:04:15.43,Default,,0,0,0,,Мұндай жерде суық емес пе?
Dialogue: 0,1:04:15.76,1:04:16.89,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,1:04:17.68,1:04:19.10,Default,,0,0,0,,Мен оны жолда сатып алдым.
Dialogue: 0,1:04:19.77,1:04:21.35,Default,,0,0,0,,Мен какао сауамын
Dialogue: 0,1:04:21.52,1:04:22.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:26.40,1:04:28.36,Default,,0,0,0,,Сенің мұнда келу себебің...
Dialogue: 0,1:04:28.49,1:04:30.45,Default,,0,0,0,,Суреттің қай жерде екенін білдіңіз бе?
Dialogue: 0,1:04:30.95,1:04:33.53,Default,,0,0,0,,Жоқ, мен бүгін таңертең білдім.
Dialogue: 0,1:04:34.03,1:04:35.49,Default,,0,0,0,,Ол кезде шынымен...
Dialogue: 0,1:04:37.04,1:04:38.41,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:04:39.41,1:04:40.71,Default,,0,0,0,,Ол кезде ол әлі-
Dialogue: 0,1:04:40.87,1:04:43.71,Default,,0,0,0,,Біз бір әлемде болдық емес пе?
Dialogue: 0,1:04:44.17,1:04:46.92,Default,,0,0,0,,Ах! Какаоны аша аласыз ба?
Dialogue: 0,1:04:47.13,1:04:48.51,Default,,0,0,0,,Кейінірек
Dialogue: 0,1:04:48.80,1:04:50.13,Default,,0,0,0,,Иә
Dialogue: 0,1:04:51.47,1:04:53.14,Default,,0,0,0,,Жарайды, мен оны осында қалдырамын.
Dialogue: 0,1:04:53.26,1:04:54.43,Default,,0,0,0,,Иә
Dialogue: 0,1:04:54.85,1:04:56.31,Default,,0,0,0,,Анам бір нәрсені ұмытып қалды
Dialogue: 0,1:04:57.39,1:04:58.72,Default,,0,0,0,,Тіпті шешіп алсаңыз да—
Dialogue: 0,1:04:58.81,1:05:01.18,Default,,0,0,0,,Қосымша ауысымдар бақыланады
Dialogue: 0,1:05:01.27,1:05:02.77,Default,,0,0,0,,Логикалық емес
Dialogue: 0,1:05:03.52,1:05:05.44,Default,,0,0,0,,Себебі мен оның 0 болғанын қаламаймын
Dialogue: 0,1:05:06.02,1:05:08.23,Default,,0,0,0,,Сіз жеке тұлғаның таралуына алаңдамайсыз ба?
Dialogue: 0,1:05:21.62,1:05:23.29,Default,,0,0,0,,«Тұлғаның таралуы»
Dialogue: 0,1:05:24.04,1:05:26.29,Default,,0,0,0,,Алыс әлемге ауысқанда—
Dialogue: 0,1:05:26.46,1:05:28.92,Default,,0,0,0,,Егер тармақ сол әлемде болса —
Dialogue: 0,1:05:29.13,1:05:31.55,Default,,0,0,0,,Бастапқы дүниеден алыстау
Dialogue: 0,1:05:32.34,1:05:35.59,Default,,0,0,0,,Сондай-ақ, орын ауыстырған адамның көзқарасы бойынша...
Dialogue: 0,1:05:35.80,1:05:38.22,Default,,0,0,0,,Қайту үшін екі орын болады.
Dialogue: 0,1:05:38.51,1:05:41.52,Default,,0,0,0,,Әрбір әрекет күрделі тармақталуды тудырады.
Dialogue: 0,1:05:43.19,1:05:44.77,Default,,0,0,0,,Мен бірден ғылыми-зерттеу институтына барамын...
Dialogue: 0,1:05:44.81,1:05:45.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:05:48.36,1:05:50.32,Default,,0,0,0,,Мен бұл баланы енді ешқашан тастамаймын.
Dialogue: 0,1:05:52.78,1:05:54.82,Default,,0,0,0,,Сен бұл дүниенің аккорды емессің
Dialogue: 0,1:05:54.91,1:05:56.62,Default,,0,0,0,,Ақыры кездестік.
Dialogue: 0,1:05:56.66,1:05:58.20,Default,,0,0,0,,Жоқ
Dialogue: 0,1:05:58.24,1:05:59.37,Default,,0,0,0,,Сенің салқындығың емес
Dialogue: 0,1:06:00.83,1:06:01.91,Default,,0,0,0,,Сіздің...
Dialogue: 0,1:06:02.87,1:06:04.87,Default,,0,0,0,,Сіздің әлеміңіздің салқындығы...
Dialogue: 0,1:06:08.79,1:06:10.88,Default,,0,0,0,,Ана қайда? (аккорд) Ха
Dialogue: 0,1:06:11.63,1:06:14.13,Default,,0,0,0,,Әй, ана қайда кетті?
Dialogue: 0,1:06:17.39,1:06:19.10,Default,,0,0,0,,Иә.
Dialogue: 0,1:06:19.22,1:06:22.81,Default,,0,0,0,,Сен енді менің салқыным емессің.
Dialogue: 0,1:06:23.31,1:06:27.48,Default,,0,0,0,,Менің Рауым ғана өлді.
Dialogue: 0,1:06:28.69,1:06:30.15,Default,,0,0,0,,Менің аяғым...
Dialogue: 0,1:06:31.27,1:06:32.78,Default,,0,0,0,,Ол қозғалмады...
Dialogue: 0,1:06:34.28,1:06:35.49,Default,,0,0,0,,Мен қорқамын...
Dialogue: 0,1:06:37.16,1:06:40.66,Default,,0,0,0,,Мен ол балаға көмектесе алмадым.
Dialogue: 0,1:06:41.70,1:06:44.00,Default,,0,0,0,,Кешіріңіз, Рё
Dialogue: 0,1:06:44.37,1:06:46.83,Default,,0,0,0,,Мен сені қорғай алмаймын
Dialogue: 0,1:06:48.00,1:06:49.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:06:53.59,1:06:56.17,Default,,0,0,0,,Райо Қарындашты ал
Dialogue: 0,1:06:56.68,1:06:58.76,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,1:06:59.97,1:07:02.10,Default,,0,0,0,,Оны басудан сақ болыңыз.
Dialogue: 0,1:07:02.26,1:07:04.06,Default,,0,0,0,,Иә
Dialogue: 0,1:07:06.27,1:07:14.69,Default,,0,0,0,,(аккордты жылау)
Dialogue: 0,1:07:15.15,1:07:16.32,Default,,0,0,0,,Бұл сіздің кінәңіз емес
Dialogue: 0,1:07:16.40,1:07:17.86,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,1:07:18.82,1:07:21.45,Default,,0,0,0,,Мен ол баланы өлтірдім.
Dialogue: 0,1:07:21.53,1:07:24.20,Default,,0,0,0,,Күнтізбе де солай ойлайтынына сенімдімін.
Dialogue: 0,1:07:25.25,1:07:27.46,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,1:07:27.62,1:07:29.62,Default,,0,0,0,,Сіз түсінбейсіз!
Dialogue: 0,1:07:29.75,1:07:34.25,Default,,0,0,0,,Бақытқа көштің. Мен саған ешқашан ештеңе істемеймін!
Dialogue: 0,1:07:36.97,1:07:38.43,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,1:07:39.34,1:07:40.93,Default,,0,0,0,,Бірақ мен түсіндім.
Dialogue: 0,1:07:42.01,1:07:45.35,Default,,0,0,0,,Қанша алыс кетсем де, Мен бәрібір менмін
Dialogue: 0,1:07:47.06,1:07:48.35,Default,,0,0,0,,Мен қазір-
Dialogue: 0,1:07:48.85,1:07:52.23,Default,,0,0,0,,Мен Аккордтың қайтып келуін шын жүректен күтемін.
Dialogue: 0,1:07:53.23,1:07:56.36,Default,,0,0,0,,Сондықтан мен сенің әлеміңде мен екенімді білемін...
Dialogue: 0,1:07:56.65,1:07:59.03,Default,,0,0,0,,Мен сіздің қайтып келуіңізді күтемін.
Dialogue: 0,1:08:00.45,1:08:01.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:03.03,1:08:04.12,Default,,0,0,0,,Иә
Dialogue: 0,1:08:05.54,1:08:06.66,Default,,0,0,0,,Ах
Dialogue: 0,1:08:07.29,1:08:08.75,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,1:08:12.75,1:08:13.92,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:08:14.04,1:08:16.55,Default,,0,0,0,,Көрдіңіз бе? Электр жарығы қосылды!
Dialogue: 0,1:08:19.01,1:08:20.76,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,1:08:43.24,1:08:45.33,Default,,0,0,0,,Хидака-сан, бұл не?
Dialogue: 0,1:08:45.70,1:08:48.04,Default,,0,0,0,,Иә, зерттеу мақсатында—
Dialogue: 0,1:08:48.12,1:08:50.62,Default,,0,0,0,,IP терминалын клондау
Dialogue: 0,1:08:57.80,1:08:59.63,Default,,0,0,0,,Орындалды!
Dialogue: 0,1:09:01.63,1:09:04.01,Default,,0,0,0,,Сіз бұл жерге кіре алмайсыз.
Dialogue: 0,1:09:04.26,1:09:08.14,Default,,0,0,0,,Жарайды, маған бәрібір.
Dialogue: 0,1:09:09.06,1:09:10.18,Default,,0,0,0,,Мен саған мынаны беремін!
Dialogue: 0,1:09:10.56,1:09:11.89,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:09:14.27,1:09:15.94,Default,,0,0,0,,Мен мұны көргім келді
Dialogue: 0,1:09:18.44,1:09:19.65,Default,,0,0,0,,Рахмет
Dialogue: 0,1:09:26.41,1:09:27.87,Default,,0,0,0,,Аккорд
Dialogue: 0,1:09:33.87,1:09:36.42,Default,,0,0,0,,Олай болса, сау болыңыз.
Dialogue: 0,1:09:37.38,1:09:39.42,Default,,0,0,0,,Деликатес
Dialogue: 0,1:09:39.67,1:09:41.92,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,1:09:48.51,1:09:51.68,Default,,0,0,0,,«Айлакер» Ол солай айтқан сияқты.
Dialogue: 0,1:09:53.48,1:09:55.94,Default,,0,0,0,,Неліктен бұл жалғыз...
Dialogue: 0,1:10:02.74,1:10:04.91,Default,,0,0,0,,Қосымша ауысым хаттамасын бастау
Dialogue: 0,1:10:05.24,1:10:06.87,Default,,0,0,0,,Өмірлік маңызды ауытқулар жоқ
Dialogue: 0,1:10:06.99,1:10:08.95,Default,,0,0,0,,Магнит өрісі кеңейді
Dialogue: 0,1:10:09.28,1:10:11.37,Default,,0,0,0,,Қосымша ауысымды бастау
Dialogue: 0,1:10:16.88,1:10:19.17,Default,,0,0,0,,Қосымша ауысым аяқталды
Dialogue: 0,1:10:20.13,1:10:21.92,Default,,0,0,0,,Өмірлік көрсеткіштер қалыпты, бірақ-
Dialogue: 0,1:10:22.01,1:10:23.72,Default,,0,0,0,,Менің ми толқындарым аздап төмен.
Dialogue: 0,1:10:33.81,1:10:34.94,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:10:35.31,1:10:36.44,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:10:37.90,1:10:39.77,Default,,0,0,0,,Ол кездегі IP капсуласы —
Dialogue: 0,1:10:39.90,1:10:42.28,Default,,0,0,0,,Ол тек сырттан басқаруға болатындай етіп жасалған.
Dialogue: 0,1:10:43.15,1:10:45.15,Default,,0,0,0,,13-ші аккордтың серіктестері —
Dialogue: 0,1:10:45.24,1:10:47.28,Default,,0,0,0,,Бұл 13-тің қызметшісі болуы керек.
Dialogue: 0,1:10:47.99,1:10:51.03,Default,,0,0,0,,Осы мәселеге байланысты екеуі академиялық қоғамнан шығарылуы мүмкін.
Dialogue: 0,1:10:52.37,1:10:54.58,Default,,0,0,0,,Салқындық пен зерттеушілікті жоғалту —
Dialogue: 0,1:10:54.79,1:10:57.42,Default,,0,0,0,,Біз өмір сүрудің жаңа жолын табуымыз керек
Dialogue: 0,1:11:00.00,1:11:02.38,Default,,0,0,0,,Сәйкестендіру диффузиясы орын алады және—
Dialogue: 0,1:11:02.67,1:11:04.84,Default,,0,0,0,,Бұл тұлға да сандық жағынан 0 емес.
Dialogue: 0,1:11:05.47,1:11:07.97,Default,,0,0,0,,Бифуркация осы жаққа ауысқанда орын алды—
Dialogue: 0,1:11:08.26,1:11:11.55,Default,,0,0,0,,Екі адамға бөлінген, саны 0 емес
Dialogue: 0,1:11:13.39,1:11:16.18,Default,,0,0,0,,Бірақ бұл адамнан 0-ге жақын ешкім жоқ.
Dialogue: 0,1:11:17.31,1:11:18.81,Default,,0,0,0,,Осы адамның көзқарасы бойынша—
Dialogue: 0,1:11:18.94,1:11:20.90,Default,,0,0,0,,Ағымдағы мен мен Рио 0 емес.
Dialogue: 0,1:11:26.70,1:11:28.41,Default,,0,0,0,,Баяғыда-
Dialogue: 0,1:11:28.49,1:11:30.95,Default,,0,0,0,,Мүмкіндіктің мағынасын маған айтқан біреу болды...
Dialogue: 0,1:11:31.53,1:11:34.04,Default,,0,0,0,,Соңында бастауыш сынып оқушылары онша түсінбейтін әңгіме болды.
Dialogue: 0,1:11:34.41,1:11:35.87,Default,,0,0,0,,Иә
Dialogue: 0,1:11:36.16,1:11:37.96,Default,,0,0,0,,Бұл мен үшін үй тапсырмасы.
Dialogue: 0,1:11:38.83,1:11:40.25,Default,,0,0,0,,Бірақ сол адамға да —
Dialogue: 0,1:11:40.50,1:11:42.46,Default,,0,0,0,,Нақты жауап жоқ сияқты.
Dialogue: 0,1:11:42.88,1:11:44.30,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,1:11:44.92,1:11:46.72,Default,,0,0,0,,Әлі жауап жоқ
Dialogue: 0,1:11:47.34,1:11:50.55,Default,,0,0,0,,Бірақ мен мүмкіндіктерді жақсы көремін
Dialogue: 0,1:11:51.76,1:11:54.51,Default,,0,0,0,,Мен қайта-қайта ойланып отырып, мен мұны түсіндім
Dialogue: 0,1:11:54.64,1:11:57.64,Default,,0,0,0,,Мм... Махаббат туралы әңгіме?
Dialogue: 0,1:11:57.93,1:12:01.65,Default,,0,0,0,,Мен адамдарды барлық мүмкіндіктерімен жақсы көргім келеді.
Dialogue: 0,1:12:01.73,1:12:04.65,Default,,0,0,0,,Сізге әрбір мүмкіндік ұнайды ма?
Dialogue: 0,1:12:05.32,1:12:09.15,Default,,0,0,0,,Бақытты болу мүмкіндігі және бақытсыз болу мүмкіндігі —
Dialogue: 0,1:12:10.03,1:12:12.49,Default,,0,0,0,,Барлығы, соның ішінде.
Dialogue: 0,1:12:12.66,1:12:13.83,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,1:12:14.95,1:12:19.12,Default,,0,0,0,,Бақыттың мүмкіндігі қанша болса, бақытсыздықтың да мүмкіндігі сонша болуы керек.
Dialogue: 0,1:12:19.96,1:12:21.71,Default,,0,0,0,,Біз тірі болғанша
Dialogue: 0,1:12:22.08,1:12:24.46,Default,,0,0,0,,Менің ойымша, ол осы қадамдарды ретімен өтеді.
Dialogue: 0,1:12:25.05,1:12:26.17,Default,,0,0,0,,Иә
Dialogue: 0,1:12:26.59,1:12:29.80,Default,,0,0,0,,Мысалы, дүниеде 100 ханзада болса...
Dialogue: 0,1:12:29.97,1:12:31.55,Default,,0,0,0,,100 қызметші болды делік—
Dialogue: 0,1:12:32.14,1:12:34.14,Default,,0,0,0,,100 қызметшілер –
Dialogue: 0,1:12:34.22,1:12:36.06,Default,,0,0,0,,Мен сені 100 рет сүйетініме сенімдімін
Dialogue: 0,1:12:37.27,1:12:40.48,Default,,0,0,0,,Бақытсыз болсаң да, бақытты болсаң да
Dialogue: 0,1:12:41.06,1:12:42.65,Default,,0,0,0,,Әрбір әлемде
Dialogue: 0,1:12:42.73,1:12:45.36,Default,,0,0,0,,Әрқайсымыз аккордтарды жақсы көреміз.
Dialogue: 0,1:12:46.94,1:12:48.78,Default,,0,0,0,,Аккорд I...
Dialogue: 0,1:12:50.61,1:12:52.78,Default,,0,0,0,,Хмм...
Dialogue: 0,1:12:56.03,1:12:58.04,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:59.54,1:13:03.21,Default,,0,0,0,,Мен де бәріңді жақсы көремін
Dialogue: 0,1:13:04.21,1:13:06.67,Default,,0,0,0,,Сіз мені де қаңғыбас иттен құтқардыңыз...
Dialogue: 0,1:13:07.09,1:13:08.63,Default,,0,0,0,,Жоқ, сіз де емессіз.
Dialogue: 0,1:13:09.05,1:13:11.30,Default,,0,0,0,,Не? Не айтқың келеді?
Dialogue: 0,1:13:11.76,1:13:13.80,Default,,0,0,0,,Ештеңе
Dialogue: 0,1:13:25.73,1:13:29.07,Default,,0,0,0,,Одан кейін бейбіт қартайдық...
Dialogue: 0,1:13:29.78,1:13:31.86,Default,,0,0,0,,Әке мен шешеден—
Dialogue: 0,1:13:31.99,1:13:35.12,Default,,0,0,0,,Енді ата мен әже деп аталады
Dialogue: 0,1:13:35.91,1:13:37.74,Default,,0,0,0,,Сізге жақын адамдардан—
Dialogue: 0,1:13:37.83,1:13:40.87,Default,,0,0,0,,Үлкендер бірінен соң бірі кетіп жатты, бірақ...
Dialogue: 0,1:13:41.16,1:13:43.29,Default,,0,0,0,,Менің үйімнің есігі —
Dialogue: 0,1:13:43.37,1:13:46.13,Default,,0,0,0,,Жаңа жыл күні ғана ашылған жоқ.
Dialogue: 0,1:13:47.21,1:13:49.17,Default,,0,0,0,,Бірақ ол ашылғалы тұрған сияқты.
Dialogue: 0,1:13:49.67,1:13:52.30,Default,,0,0,0,,Ал мен кететін сияқтымын.
Dialogue: 0,1:13:53.17,1:13:55.51,Default,,0,0,0,,Дәрігер маған былай деді...
Dialogue: 0,1:13:55.68,1:13:59.14,Default,,0,0,0,,Менің немерем Ай 10-ға жақындаған болатын.
Dialogue: 0,1:14:01.10,1:14:04.02,Default,,0,0,0,,Аккорд ештеңе айтқан жоқ
Dialogue: 0,1:14:06.60,1:14:10.02,Default,,0,0,0,,Мен біртүрлі тыныштықты сезіндім.
Dialogue: 0,1:14:13.90,1:14:15.57,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,1:14:15.82,1:14:18.91,Default,,0,0,0,,​​Иә, қайырлы түн.
Dialogue: 0,1:14:21.45,1:14:24.54,Default,,0,0,0,,Мен отбасыма қиындық тудырғым келмеді, бірақ...
Dialogue: 0,1:14:25.21,1:14:27.71,Default,,0,0,0,,Райо мен Эридің ұсынысымен...
Dialogue: 0,1:14:28.04,1:14:30.04,Default,,0,0,0,,Мен таныс үйдемін—
Dialogue: 0,1:14:30.13,1:14:33.21,Default,,0,0,0,,Мен соңғы уақытымды өткізуді шештім
Dialogue: 0,1:14:43.14,1:14:44.60,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:46.73,1:14:48.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:05.00,1:15:07.92,Default,,0,0,0,,Танысқаныма қуаныштымын, Кадзуон Такасаки
Dialogue: 0,1:15:08.46,1:15:10.63,Default,,0,0,0,,Менің атым Кадзуон Такигава.
Dialogue: 0,1:15:11.67,1:15:13.50,Default,,0,0,0,,Ең алдымен кешірім сұраймын.
Dialogue: 0,1:15:14.05,1:15:16.80,Default,,0,0,0,,Қосымша ауысымды рұқсатсыз жасағаным үшін кешірім сұраймыз.
Dialogue: 0,1:15:17.63,1:15:21.47,Default,,0,0,0,,Енді мен сіздің көмегіңізбен осы хатты жазып отырмын.
Dialogue: 0,1:15:23.31,1:15:27.69,Default,,0,0,0,,Негізі мен сізден бір нәрсе сұрағым келеді.
Dialogue: 0,1:15:28.35,1:15:33.48,Default,,0,0,0,,Осы мақсатта мен және менің әлемнің күнтізбесі—
Dialogue: 0,1:15:33.90,1:15:37.86,Default,,0,0,0,,Мен сізге Хидака Коёми туралы айтуым керек.
Dialogue: 0,1:15:38.53,1:15:41.20,Default,,0,0,0,,Бұл ұзақ болуы мүмкін, бірақ...
Dialogue: 0,1:15:41.49,1:15:43.74,Default,,0,0,0,,Бізге қосылыңыз.
Dialogue: 0,1:15:48.41,1:15:52.34,Default,,0,0,0,,Мен және Коёми Хидака үйленбеген.
Dialogue: 0,1:15:53.21,1:15:55.63,Default,,0,0,0,,Мәңгілік зерттеу серіктесі ретінде—
Dialogue: 0,1:15:55.88,1:15:58.59,Default,,0,0,0,,Біз көп жылдар бойы біргеміз.
Dialogue: 0,1:15:59.01,1:16:02.22,Default,,0,0,0,,Бұл әлем және біздің әлем дегеніміз не?
Dialogue: 0,1:16:02.60,1:16:05.81,Default,,0,0,0,,Ата-анасы жеті жасында ажырасып кеткен.
Dialogue: 0,1:16:05.89,1:16:08.73,Default,,0,0,0,,Қай жақтан ілесеміз деп екіге бөлінген сияқты.
Dialogue: 0,1:16:10.19,1:16:14.44,Default,,0,0,0,,Мен Коёми Хидакамен орта мектепте оқып жүргенімде таныстым.
Dialogue: 0,1:16:15.07,1:16:17.90,Default,,0,0,0,,Ешкіммен сөйлеспейді, сабаққа да келмейді.
Dialogue: 0,1:16:18.07,1:16:20.45,Default,,0,0,0,,Жоғары баға алған жиіркенішті жігіт
Dialogue: 0,1:16:21.16,1:16:24.28,Default,,0,0,0,,Мен оны өзімнің қарсыласым деп ойладым.
Dialogue: 0,1:16:25.54,1:16:29.16,Default,,0,0,0,,Мен оның университетке түскісі келмейтінін білгенде...
Dialogue: 0,1:16:29.33,1:16:34.59,Default,,0,0,0,,Мен жеңілдік пен жалғыздықтың араласуын сезіндім.
Dialogue: 0,1:16:35.71,1:16:37.42,Default,,0,0,0,,Енді мен бұл туралы ойласам,
Dialogue: 0,1:16:37.55,1:16:40.72,Default,,0,0,0,,Мүмкін бұл жай ғана бақталастық емес шығар.
Dialogue: 0,1:16:42.05,1:16:47.35,Default,,0,0,0,,Әйтеуір, осыдан кейін мен Қиял ғылым институтына кірдім.
Dialogue: 0,1:16:47.43,1:16:48.73,Default,,0,0,0,,Онымен қайта қосылды
Dialogue: 0,1:16:49.43,1:16:51.98,Default,,0,0,0,,сәл өзгеше болуы мүмкін.
Dialogue: 0,1:16:52.69,1:16:57.86,Default,,0,0,0,,Мен онымен кездесу үшін Жалған ғылым институтына бардым.
Dialogue: 0,1:17:13.92,1:17:16.38,Default,,0,0,0,,Ақырында ол маған былай деді:
Dialogue: 0,1:17:16.46,1:17:18.71,Default,,0,0,0,,Мен сіздермен жасырын зерттеу жүргізгім келеді.
Dialogue: 0,1:17:18.80,1:17:20.34,Default,,0,0,0,,Мен сізге жақындадым.
Dialogue: 0,1:17:20.97,1:17:24.30,Default,,0,0,0,,Уақыт саяхатын зерттейді.
Dialogue: 0,1:17:25.05,1:17:26.39,Default,,0,0,0,,Дәл жазылғандай жауап беріп отырсың — қазір сәнде жүрген сол «қолмен басқарылатын» кішкентай қыздардың бірісің бе?
Dialogue: 0,1:17:26.80,1:17:30.60,Default,,0,0,0,,Сіз қаншалықты ақылсыз және ақымақ деп ойлайсыз?
Dialogue: 0,1:17:31.60,1:17:33.56,Default,,0,0,0,,Сіз түсінесіз
Dialogue: 0,1:17:34.73,1:17:36.61,Default,,0,0,0,,Әуелде әзіл деп ойладым
Dialogue: 0,1:17:37.23,1:17:39.48,Default,,0,0,0,,Ол институттағы ең эксцентрик жігіт.
Dialogue: 0,1:17:39.57,1:17:41.61,Default,,0,0,0,,Ең жақсы жағынан қалжың ба деп ойлаймын.
Dialogue: 0,1:17:42.28,1:17:45.41,Default,,0,0,0,,Бірақ ол әзіл айтатын адам емес еді.
Dialogue: 0,1:17:46.20,1:17:50.45,Default,,0,0,0,,Ол мүмкіндігінше шыншыл болды.
Dialogue: 0,1:17:51.50,1:17:53.96,Default,,0,0,0,,Өйткені бұл
Dialogue: 0,1:17:54.12,1:17:58.25,Default,,0,0,0,,Өйткені қиылыстағы елеске көмектесудің жалғыз жолы осы еді.
Dialogue: 0,1:17:59.46,1:18:03.72,Default,,0,0,0,,Қиылыстағы елес оның жас ғашығы болатын.
Dialogue: 0,1:18:04.80,1:18:11.81,Default,,0,0,0,,♪~
Dialogue: 0,1:18:26.99,1:18:30.91,Default,,0,0,0,,♪ Білмес бұрын
Dialogue: 0,1:18:31.12,1:18:37.54,Default,,0,0,0,,♪ Бір-бірімізге соншалықты жақын болсақ та
Dialogue: 0,1:18:37.71,1:18:48.09,Default,,0,0,0,,♪ Уақытты кері қайтара алсам, тағдырым басқаша болар ма еді?
Dialogue: 0,1:18:49.18,1:18:53.72,Default,,0,0,0,,♪ Жасыңыз қанша болса да
Dialogue: 0,1:18:53.89,1:19:00.40,Default,,0,0,0,,♪ Мен кереметтерге сенгім келді.
Dialogue: 0,1:19:00.57,1:19:05.40,Default,,0,0,0,,♪ Әжім болып, тозып кетсе де
Dialogue: 0,1:19:05.53,1:19:11.28,Default,,0,0,0,,♪ Мен сені міндетті түрде алып кетемін.
Dialogue: 0,1:19:12.58,1:19:17.54,Default,,0,0,0,,♪ Кез келген жағдайда
Dialogue: 0,1:19:17.62,1:19:22.46,Default,,0,0,0,,♪ Мұны істегеніңіз сонша, оны жек көрдіңіз.
Dialogue: 0,1:19:22.63,1:19:25.21,Default,,0,0,0,,♪ «Не болса да» емес, «Мен сенімдімін»
Dialogue: 0,1:19:25.30,1:19:28.18,Default,,0,0,0,,♪ Бұл әлдеқайда жақсы
Dialogue: 0,1:19:28.30,1:19:34.93,Default,,0,0,0,,♪ Мен бұл оңай болады деп ойлағым келді.
Dialogue: 0,1:19:36.85,1:19:39.98,Default,,0,0,0,,♪ Бұл көз жасының нәтижесі.
Dialogue: 0,1:19:40.10,1:19:45.32,Default,,0,0,0,,♪ Қоштасу азапты
Dialogue: 0,1:19:45.36,1:19:48.07,Default,,0,0,0,,♪ Әдеттегідей
Dialogue: 0,1:19:48.24,1:19:50.45,Default,,0,0,0,,♪ Күлімсіреп: «Кездескенше» деңіз.
Dialogue: 0,1:19:50.53,1:19:53.53,Default,,0,0,0,,♪ Бүгіннен бастап бірінен соң бірі
Dialogue: 0,1:19:53.66,1:19:55.33,Default,,0,0,0,,Апат салдарынан ол...
Dialogue: 0,1:19:55.37,1:19:57.75,Default,,0,0,0,,Дене мен қуыс бөлінген...
Dialogue: 0,1:19:57.96,1:20:00.96,Default,,0,0,0,,Қиылыста елес болды
Dialogue: 0,1:20:01.63,1:20:05.71,Default,,0,0,0,,«Бұл менің кінәм», - деді Коёми.
Dialogue: 0,1:20:06.26,1:20:08.42,Default,,0,0,0,,Және дәл осы ой-
Dialogue: 0,1:20:08.76,1:20:11.51,Default,,0,0,0,,Оны сол қиылыстан құтқару үшін зерттеу...
Dialogue: 0,1:20:11.59,1:20:13.35,Default,,0,0,0,,Мен жалғастырдым.
Dialogue: 0,1:20:14.10,1:20:20.31,Default,,0,0,0,,Оның сыртқы түрі туралы не айта аламын? Бұл ақылсыз...
Dialogue: 0,1:20:21.27,1:20:26.15,Default,,0,0,0,,Бірақ екінші жағынан, бұл сондай таза және азапты ...
Dialogue: 0,1:20:27.07,1:20:32.66,Default,,0,0,0,,Кішкентай бала жылап жатқандай болды...
Dialogue: 0,1:20:33.66,1:20:38.00,Default,,0,0,0,,Оның жету жолы уақытқа саяхат жасау арқылы болды.
Dialogue: 0,1:20:39.62,1:20:43.13,Default,,0,0,0,,Әрине, бұл физикалық уақыт саяхаты емес...
Dialogue: 0,1:20:43.75,1:20:46.59,Default,,0,0,0,,Виртуалды әлемде уақыт саяхаты
Dialogue: 0,1:20:46.84,1:20:49.97,Default,,0,0,0,,, яғни уақытты ауыстыру
Dialogue: 0,1:20:51.76,1:20:53.93,Default,,0,0,0,,Уақыт ауысымы…
Dialogue: 0,1:20:56.01,1:20:57.64,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:20:57.72,1:21:01.35,Default,,0,0,0,,Мен сені міндетті түрде құтқарамын! Уау...
Dialogue: 0,1:21:02.60,1:21:04.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:04.65,1:21:06.90,Default,,0,0,0,,Жетер, Коёми-кун.
Dialogue: 0,1:21:07.02,1:21:08.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:08.82,1:21:10.95,Default,,0,0,0,,Көп уақыт болды, солай емес пе?
Dialogue: 0,1:21:12.57,1:21:13.74,Default,,0,0,0,,Бетбелгі?
Dialogue: 0,1:21:14.12,1:21:15.66,Default,,0,0,0,,Мен үшін…
Dialogue: 0,1:21:17.20,1:21:20.25,Default,,0,0,0,,Сондықтан Коёми-кун тірі...
Dialogue: 0,1:21:20.75,1:21:22.29,Default,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,1:21:23.33,1:21:24.67,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,1:21:25.00,1:21:26.29,Default,,0,0,0,,Сіз уәде бердіңіз, солай ма?
Dialogue: 0,1:21:27.21,1:21:29.46,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін
Dialogue: 0,1:21:29.51,1:21:31.17,Default,,0,0,0,,♪Біз мұны бәрібір істеуіміз керек
Dialogue: 0,1:21:31.26,1:21:34.80,Default,,0,0,0,,♪ Артқа жол жоқ
Dialogue: 0,1:21:34.89,1:21:39.39,Default,,0,0,0,,♪ Мен болашақты түсіне алмадым
Dialogue: 0,1:21:39.47,1:21:41.02,Default,,0,0,0,,Мен және Коёми -
Dialogue: 0,1:21:41.10,1:21:44.73,Default,,0,0,0,,Мен ондаған жылдар бойы уақытты ауыстыруды зерттедім.
Dialogue: 0,1:21:44.98,1:21:48.44,Default,,0,0,0,,Мен мұны қалай жасау керектігін түсіндім.
Dialogue: 0,1:21:48.94,1:21:50.53,Default,,0,0,0,,Ал нәтиже—
Dialogue: 0,1:21:50.99,1:21:54.28,Default,,0,0,0,,Сондай-ақ Коёмидің миы өлуі мүмкін.
Dialogue: 0,1:21:54.99,1:21:58.49,Default,,0,0,0,,Қаншалықты өзімшіл және өзін жақсы көретін...
Dialogue: 0,1:21:58.58,1:22:00.45,Default,,0,0,0,,Басқалардың қолайсыздығына мән бермеу
Dialogue: 0,1:22:01.25,1:22:05.71,Default,,0,0,0,,Жарайды, мен ғана ыңғайсыздыққа ұшыраған шығармын.
Dialogue: 0,1:22:06.38,1:22:11.17,Default,,0,0,0,,Оған не болғанына қарамастан, оның шешімі ешқашан өзгермеді.
Dialogue: 0,1:22:12.67,1:22:15.89,Default,,0,0,0,,Мен енді таң қалмадым.
Dialogue: 0,1:22:16.64,1:22:18.72,Default,,0,0,0,,Ақыр соңында...
Dialogue: 0,1:22:18.80,1:22:22.27,Default,,0,0,0,,Артымда қалатын мен туралы ештеңе ойлай алмаймын.
Dialogue: 0,1:22:22.73,1:22:25.31,Default,,0,0,0,,Олай болса, соңына дейін бірге болайық.
Dialogue: 0,1:22:26.15,1:22:28.73,Default,,0,0,0,,Мұндай қыңыр сезім...
Dialogue: 0,1:22:28.94,1:22:31.86,Default,,0,0,0,,Мен мұны істей алатын жалғыз адам сияқты сезінемін
Dialogue: 0,1:22:33.44,1:22:34.53,Default,,0,0,0,,Біз—
Dialogue: 0,1:22:34.57,1:22:37.32,Default,,0,0,0,,Біз уақыт ауысымының баратын жерін мұқият таңдадық.
Dialogue: 0,1:22:38.57,1:22:42.45,Default,,0,0,0,,Бұл сіз қазір өмір сүріп жатқан әлем еді.
Dialogue: 0,1:22:43.45,1:22:45.67,Default,,0,0,0,,Екеуінің арасында не болды?
Dialogue: 0,1:22:45.75,1:22:48.42,Default,,0,0,0,,Күнтізбе бізге ештеңе айтпайды.
Dialogue: 0,1:22:49.50,1:22:52.80,Default,,0,0,0,,Бірақ екі адам ешқашан кездеспейтін әлемде...
Dialogue: 0,1:22:53.13,1:22:55.88,Default,,0,0,0,,Жазатайым оқиғалар болмайтынын қайталаңыз.
Dialogue: 0,1:22:59.51,1:23:06.52,Default,,0,0,0,,♪ Олай болса естеліктеріміз туралы сөйлесейік.
Dialogue: 0,1:23:14.15,1:23:20.83,Default,,0,0,0,,~♪
Dialogue: 0,1:23:21.28,1:23:24.37,Default,,0,0,0,,Сіз мені ұзақ күттірдіңіз.
Dialogue: 0,1:23:24.79,1:23:27.46,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,1:23:29.54,1:23:31.88,Default,,0,0,0,,Бала кезімде сені кездестіргенімде...
Dialogue: 0,1:23:32.71,1:23:34.26,Default,,0,0,0,,Сіз апатқа ұшырадыңыз—
Dialogue: 0,1:23:35.51,1:23:38.63,Default,,0,0,0,,Содан бері 60 жыл өтті.
Dialogue: 0,1:23:39.64,1:23:41.72,Default,,0,0,0,,Бұл өте ұзақ уақыт болды
Dialogue: 0,1:23:42.14,1:23:43.51,Default,,0,0,0,,Коёми-кун?
Dialogue: 0,1:23:44.47,1:23:47.14,Default,,0,0,0,,Шиори, қош бол.
Dialogue: 0,1:23:47.60,1:23:48.73,Default,,0,0,0,,Эх!
Dialogue: 0,1:23:52.31,1:23:56.19,Default,,0,0,0,,Кеше күнтізбе уақыт ауысымын орындады.
Dialogue: 0,1:23:57.11,1:23:59.11,Default,,0,0,0,,Бұл дүниеде —
Dialogue: 0,1:23:59.20,1:24:02.20,Default,,0,0,0,,Зерттеу барысында бір ғана қария құлап қалды.
Dialogue: 0,1:24:02.28,1:24:05.16,Default,,0,0,0,,Оның миы өліп қалған дейді.
Dialogue: 0,1:24:06.45,1:24:09.46,Default,,0,0,0,,Бірақ мен ғана білемін
Dialogue: 0,1:24:10.37,1:24:13.71,Default,,0,0,0,,Ол сіздің әлеміңіздің өткеніне не істеді
Dialogue: 0,1:24:15.05,1:24:18.01,Default,,0,0,0,,Мен қазір сенің жаныңда ұйықтап жатырмын.
Dialogue: 0,1:24:18.09,1:24:20.43,Default,,0,0,0,,Сіздің күйеуіңіз «Кёми Такасаки»
Dialogue: 0,1:24:21.26,1:24:25.85,Default,,0,0,0,,7 жасынан бастап оған «Кёми Хидака» деген жалған табиғат сіңген.
Dialogue: 0,1:24:26.47,1:24:29.35,Default,,0,0,0,,Оған да бұл дүниеде...
Dialogue: 0,1:24:29.73,1:24:33.19,Default,,0,0,0,,Құтқарылған күнтізбе оның бостығы оған ағып жатыр.
Dialogue: 0,1:24:34.52,1:24:37.44,Default,,0,0,0,,Егер біз осылай өмір сүре берсек...
Dialogue: 0,1:24:37.78,1:24:39.95,Default,,0,0,0,,Екеуі ешқашан кездеспейді
Dialogue: 0,1:24:40.78,1:24:42.45,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:24:43.20,1:24:44.53,Default,,0,0,0,,Өйткені екі адам...
Dialogue: 0,1:24:44.62,1:24:48.00,Default,,0,0,0,,Өйткені мен ешқашан кездеспейтін әлемді таңдадым.
Dialogue: 0,1:24:49.71,1:24:52.83,Default,,0,0,0,,Бірақ уақыт ауысымының алдында-
Dialogue: 0,1:24:53.08,1:24:56.88,Default,,0,0,0,,Коёми онымен қайта кездесуге уәде бергенін айтты.
Dialogue: 0,1:24:58.71,1:25:01.55,Default,,0,0,0,,Сол дүниедегі өміріңіздің соңында—
Dialogue: 0,1:25:01.80,1:25:04.60,Default,,0,0,0,,Біз сол жерде жиналып отырмыз.
Dialogue: 0,1:25:05.51,1:25:07.14,Default,,0,0,0,,Теориялық болжамдар—
Dialogue: 0,1:25:07.47,1:25:11.94,Default,,0,0,0,,Уақыт ауысымынан кейін бұл дүниенің естеліктерінің қалу мүмкіндігі қандай?
Dialogue: 0,1:25:12.02,1:25:14.23,Default,,0,0,0,,0-ге тең деп айта аламыз.
Dialogue: 0,1:25:15.48,1:25:16.61,Default,,0,0,0,,Сонымен—
Dialogue: 0,1:25:16.69,1:25:20.49,Default,,0,0,0,,Жас ғашығын сендіру үшін сылтау болса керек.
Dialogue: 0,1:25:21.95,1:25:24.24,Default,,0,0,0,,Орындау қиын уәде
Dialogue: 0,1:25:25.91,1:25:27.74,Default,,0,0,0,,Уәдеден гөрі
Dialogue: 0,1:25:27.95,1:25:30.66,Default,,0,0,0,,Мұндай ғажайыптың болуы мүмкін дейді.
Dialogue: 0,1:25:30.75,1:25:33.37,Default,,0,0,0,,Күнтізбенің әлсіз үміті
Dialogue: 0,1:25:48.64,1:25:50.22,Default,,0,0,0,,Енді мен—
Dialogue: 0,1:25:50.35,1:25:53.73,Default,,0,0,0,,Мен сол кереметті жүзеге асырғым келеді.
Dialogue: 0,1:25:55.23,1:25:58.27,Default,,0,0,0,,Шынымен де, жүрегімнің бір жерінде...
Dialogue: 0,1:25:58.32,1:26:01.28,Default,,0,0,0,,Мен олардың кездескенін қаламадым.
Dialogue: 0,1:26:02.32,1:26:03.57,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:26:05.74,1:26:08.24,Default,,0,0,0,,Енді күйеуіңіздің IP терминалында—
Dialogue: 0,1:26:08.66,1:26:12.54,Default,,0,0,0,,Мен кездесуге Шоуа-дори қиылысында кірдім.
Dialogue: 0,1:26:19.34,1:26:20.67,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,1:26:20.75,1:26:25.38,Default,,0,0,0,,Оны уәде етілген жерге жіберуіңізді өтінемін.
Dialogue: 0,1:26:27.89,1:26:30.31,Default,,0,0,0,,Шынайы жаз
Dialogue: 0,1:26:30.93,1:26:33.27,Default,,0,0,0,,Егер сен басқа мен болсаң...
Dialogue: 0,1:26:33.35,1:26:36.90,Default,,0,0,0,,Сенің ойың жоқ екеніне сенімдімін...
Dialogue: 0,1:26:37.06,1:26:41.61,Default,,0,0,0,,Маған бұл әлемдік күнтізбе Хидака күнтізбесі ұнайды
Dialogue: 0,1:26:43.69,1:26:47.41,Default,,0,0,0,,Әрине бұл романтикалық қарым-қатынастағы махаббат.
Dialogue: 0,1:26:47.78,1:26:51.45,Default,,0,0,0,,Некеге апаратын махаббат басқаша болды.
Dialogue: 0,1:26:52.49,1:26:54.08,Default,,0,0,0,,Әлі-
Dialogue: 0,1:26:54.16,1:26:59.00,Default,,0,0,0,,Мен Коёми Хидаканы өміріммен жақсы көрдім.
Dialogue: 0,1:26:59.13,1:27:01.84,Default,,0,0,0,,Енді мен терең сезінемін.
Dialogue: 0,1:27:04.05,1:27:07.13,Default,,0,0,0,,Мен бұл өзімшіл өтініш екенін білемін.
Dialogue: 0,1:27:07.76,1:27:09.64,Default,,0,0,0,,Өйткені, сіз үшін
Dialogue: 0,1:27:09.93,1:27:12.22,Default,,0,0,0,,Мен үшін де -
Dialogue: 0,1:27:13.31,1:27:17.69,Default,,0,0,0,,Өйткені сіз өзіңіздің сүйікті адамыңызды басқа біреуге жібересіз.
Dialogue: 0,1:27:19.36,1:27:23.40,Default,,0,0,0,,Менің сезімімді өзіңдікімен байланыстырғаныңды қалаймын.
Dialogue: 0,1:27:28.78,1:27:31.45,Default,,0,0,0,,Бақыт пен бақытсыздық қайталанады
Dialogue: 0,1:27:33.04,1:27:35.87,Default,,0,0,0,,Бірақ біреу біреу туралы ойлайды
Dialogue: 0,1:27:36.83,1:27:40.88,Default,,0,0,0,,Сол ойлардың бір-бірімен байланысатынына сене алсаңыз...
Dialogue: 0,1:27:45.92,1:27:49.39,Default,,0,0,0,,Біз белгілі бір әлемде туылғанбыз...
Dialogue: 0,1:27:50.72,1:27:51.85,Default,,0,0,0,,Кездесу…
Dialogue: 0,1:27:52.97,1:27:54.18,Default,,0,0,0,,Өмір сүру...
Dialogue: 0,1:27:54.52,1:27:57.60,Default,,0,0,0,,Өлудің де мағынасы бар екенін...
Dialogue: 0,1:27:57.94,1:28:01.56,Default,,0,0,0,,Мен мұны өмірімнің соңында айта аламын деп ойлаймын.
Dialogue: 0,1:28:06.82,1:28:07.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:11.49,1:28:12.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:13.49,1:28:14.91,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:28:15.20,1:28:16.62,Default,,0,0,0,,P.S.
Dialogue: 0,1:28:16.70,1:28:20.00,Default,,0,0,0,,Негізі мен бұрын бір рет қана ауысқанмын.
Dialogue: 0,1:28:20.50,1:28:23.59,Default,,0,0,0,,Мен сол кезде көрген аквамарин сақинасы—
Dialogue: 0,1:28:23.79,1:28:25.80,Default,,0,0,0,,Маған рұқсатсыз көшіруге рұқсат етілді.
Dialogue: 0,1:28:26.26,1:28:27.63,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:28:50.74,1:28:51.86,Default,,0,0,0,,Қате?
Dialogue: 0,1:28:53.03,1:28:54.45,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,1:28:55.45,1:28:56.87,Default,,0,0,0,,Қанша қашықтыққа ұшты?
Dialogue: 0,1:29:03.58,1:29:06.34,Default,,0,0,0,,Параллель жылжу орын алады деп есептесек—
Dialogue: 0,1:29:06.96,1:29:09.80,Default,,0,0,0,,Бұл қыз жаяу жүргіншілер өткелінде тұрған әлемде
Dialogue: 0,1:29:09.88,1:29:13.30,Default,,0,0,0,,Мен ештеңе істей алмаймын, өйткені мен қазір тұрған жерде емеспін.
Dialogue: 0,1:29:14.14,1:29:16.26,Default,,0,0,0,,Мен оның орнына арғы жаққа кеттім...
Dialogue: 0,1:29:16.43,1:29:18.93,Default,,0,0,0,,Мен шатастырмаймын деп үміттенемін...
Dialogue: 0,1:29:19.64,1:29:22.81,Default,,0,0,0,,Дұға ма?
Dialogue: 0,1:29:25.19,1:29:27.52,Default,,0,0,0,,Бірақ қате нені білдіреді?
Dialogue: 0,1:29:28.03,1:29:31.53,Default,,0,0,0,,Өлшеу мүмкін болмаса, мүмкін...
Dialogue: 0,1:29:32.15,1:29:35.66,Default,,0,0,0,,Егер қиялдың өзінде өзгеріс орын алса...
Dialogue: 0,1:29:35.91,1:29:37.24,Default,,0,0,0,,Күтіңіз...
Dialogue: 0,1:29:37.37,1:29:39.37,Default,,0,0,0,,Мен мұндай ойды естідім.
Dialogue: 0,1:29:40.08,1:29:41.54,Default,,0,0,0,,Бұл қандай қағаз?
Dialogue: 0,1:29:42.37,1:29:44.96,Default,,0,0,0,,Сіз мұны бір академиялық конференцияда естідіңіз бе?
Dialogue: 0,1:29:45.33,1:29:47.84,Default,,0,0,0,,Сіз кіммен сөйлестіңіз?
Dialogue: 0,1:29:48.38,1:29:52.84,Default,,0,0,0,,А, аа! Ууууууу...
Dialogue: 0,1:29:53.09,1:29:54.30,Default,,0,0,0,,Уф...
Dialogue: 0,1:29:55.39,1:29:57.43,Default,,0,0,0,,Уау... аа...
Dialogue: 0,1:29:58.89,1:30:03.52,Default,,0,0,0,,♬~
Dialogue: 0,1:30:05.65,1:30:07.36,Default,,0,0,0,,Уф...
Dialogue: 0,1:30:13.11,1:30:14.32,Default,,0,0,0,,Уф...
Dialogue: 0,1:30:14.40,1:30:17.87,Default,,0,0,0,,Уф, хаха...
Dialogue: 0,1:30:19.83,1:30:23.12,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:30:23.21,1:30:24.37,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:30:25.37,1:30:28.17,Default,,0,0,0,,Амансың ба? сәлем?
Dialogue: 0,1:30:28.29,1:30:29.88,Default,,0,0,0,,Медицина…
Dialogue: 0,1:30:30.55,1:30:33.13,Default,,0,0,0,,Дәрі қабылдау...
Dialogue: 0,1:30:37.05,1:30:39.10,Default,,0,0,0,,А, бұл ма?
Dialogue: 0,1:30:40.47,1:30:42.18,Default,,0,0,0,,Оны қазір ашуға болады.
Dialogue: 0,1:30:42.43,1:30:43.68,Default,,0,0,0,,(таблетка қорабын ашу дыбысы)
Dialogue: 0,1:30:44.52,1:30:46.90,Default,,0,0,0,,Иә, ала аламын ба?
Dialogue: 0,1:31:07.37,1:31:08.92,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,1:31:11.09,1:31:13.09,Default,,0,0,0,,А, қазір бәрі жақсы.
Dialogue: 0,1:31:13.84,1:31:15.42,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,1:31:15.80,1:31:18.51,Default,,0,0,0,,(Экипаж мүшесі 1) Жұмысты жалғастырып, қазынаны көрсекші.
Dialogue: 0,1:31:20.35,1:31:21.56,Default,,0,0,0,,Рахмет
Dialogue: 0,1:31:23.60,1:31:28.19,Default,,0,0,0,,Қарсы болмасаңыз, атыңызды білуге ​​бола ма?
Dialogue: 0,1:31:28.81,1:31:31.94,Default,,0,0,0,,Ескертудің қажеті жоқ
Dialogue: 0,1:31:32.32,1:31:33.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:33.57,1:31:35.32,Default,,0,0,0,,А, жоқ.
Dialogue: 0,1:31:36.07,1:31:37.45,Default,,0,0,0,,Хори, көмектесіп жібересің бе?
Dialogue: 0,1:31:38.07,1:31:41.66,Default,,0,0,0,,Өлер алдында бір рет айтқым келді.
Dialogue: 0,1:31:42.12,1:31:44.95,Default,,0,0,0,,«Бұл туралы айтудың қажеті жоқ».
Dialogue: 0,1:31:45.70,1:31:50.21,Default,,0,0,0,,А... Мен сізге көмектесе алатыныма қуаныштымын.
Dialogue: 0,1:31:50.29,1:31:52.63,Default,,0,0,0,,Өтінемін (күнтізбе) Кешіріңіз.
Dialogue: 0,1:31:53.13,1:31:54.21,Default,,0,0,0,,Рыцарь Рейнхарт.
Dialogue: 0,1:31:54.42,1:31:55.84,Default,,0,0,0,,О, бұл
Dialogue: 0,1:31:56.42,1:31:59.01,Default,,0,0,0,,Иә, бұл әйелдерге арналған зат.
Dialogue: 0,1:31:59.80,1:32:01.18,Default,,0,0,0,,Бұл қарызға алынған нәрсе.
Dialogue: 0,1:32:01.64,1:32:02.97,Default,,0,0,0,,Иә
Dialogue: 0,1:32:03.10,1:32:04.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:04.97,1:32:06.39,Default,,0,0,0,,Ум...
Dialogue: 0,1:32:06.89,1:32:09.31,Default,,0,0,0,,Біз бір жерде кездестік пе?
Dialogue: 0,1:32:09.56,1:32:10.73,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:13.77,1:32:16.03,Default,,0,0,0,,Кешіріңіз, сіздің атыңыз кім?
Dialogue: 0,1:32:16.53,1:32:17.95,Default,,0,0,0,,Бұл Такасаки
Dialogue: 0,1:32:24.62,1:32:28.75,Default,,0,0,0,,Кешіріңіз, мен түсінбеген сияқтымын.
Dialogue: 0,1:32:29.62,1:32:31.92,Default,,0,0,0,,О, солай ма?
Dialogue: 0,1:32:33.04,1:32:34.50,Default,,0,0,0,,Мүмкін—
Dialogue: 0,1:32:34.59,1:32:38.17,Default,,0,0,0,,Мүмкін біз параллель әлемде кездескен шығармыз.
Dialogue: 0,1:32:38.42,1:32:40.22,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,1:32:40.26,1:32:42.34,Default,,0,0,0,,Бұл мүмкіндік.
Dialogue: 0,1:32:42.72,1:32:45.22,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:32:45.72,1:32:46.97,Default,,0,0,0,,Ум...
Dialogue: 0,1:32:48.35,1:32:52.35,Default,,0,0,0,,Сіз қазір бақыттысыз ба?
Dialogue: 0,1:32:55.40,1:32:59.61,Default,,0,0,0,,Иә, мен өте қуаныштымын.
Dialogue: 0,1:33:02.45,1:33:04.03,Default,,0,0,0,,(Танжиро) Ах!
Dialogue: 0,1:33:04.49,1:33:05.87,Default,,0,0,0,,Сонымен
Dialogue: 0,1:33:07.95,1:33:09.79,Default,,0,0,0,,Сақ бол
Dialogue: 0,1:33:10.16,1:33:11.42,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:33:12.50,1:33:15.88,Default,,0,0,0,,Қош бол, рахмет
Dialogue: 0,1:33:41.82,1:33:43.11,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:33:43.78,1:33:44.95,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:33:45.62,1:33:47.16,Default,,0,0,0,,Сіз мені күтіп тұрсыз ба?
Dialogue: 0,1:33:47.66,1:33:49.04,Default,,0,0,0,,Жақсы.
Dialogue: 0,1:33:50.00,1:33:51.25,Default,,0,0,0,,Айтпақшы—
Dialogue: 0,1:33:52.33,1:33:53.67,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:33:53.75,1:33:55.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:56.00,1:33:59.00,Default,,0,0,0,,IEPP қатені көрсетеді.
Dialogue: 0,1:33:59.09,1:34:01.21,Default,,0,0,0,,Мен қазір қайда екенімді білмеймін.
Dialogue: 0,1:34:01.76,1:34:03.47,Default,,0,0,0,,Оны қалай айту керек
Dialogue: 0,1:34:03.97,1:34:05.76,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,1:34:06.05,1:34:08.47,Default,,0,0,0,,Қараңызшы, бұл ақаулық па?
Dialogue: 0,1:34:08.64,1:34:12.43,Default,,0,0,0,,Иә? Бұл сирек.
Dialogue: 0,1:34:12.56,1:34:17.48,Default,,0,0,0,,Менің Шоуа-дори қиылысында шыққаным дұрыс па?
Dialogue: 0,1:34:17.81,1:34:21.15,Default,,0,0,0,,Иә, сағат 10-да.
Dialogue: 0,1:34:21.32,1:34:22.65,Default,,0,0,0,,Иә
Dialogue: 0,1:34:22.78,1:34:24.91,Default,,0,0,0,,Параллель ауысу орын алса да—
Dialogue: 0,1:34:25.20,1:34:28.33,Default,,0,0,0,,Бұл маңайдағы сияқты, сондықтан жақын арада 0-ге оралады деп ойлаймын.
Dialogue: 0,1:34:30.08,1:34:33.91,Default,,0,0,0,,Сонда қандай уәде болды?
Dialogue: 0,1:34:34.25,1:34:37.08,Default,,0,0,0,,Ой, ешкім келмеді.
Dialogue: 0,1:34:37.79,1:34:39.38,Default,,0,0,0,,Иә
Dialogue: 0,1:34:42.34,1:34:45.26,Default,,0,0,0,,Кестеде қате болуы мүмкін.
Dialogue: 0,1:34:46.13,1:34:49.97,Default,,0,0,0,,Алайда мен белгілі бір адаммен керемет кездестім.
Dialogue: 0,1:34:50.76,1:34:53.56,Default,,0,0,0,,Бұл кім? Ескі таныс?
Dialogue: 0,1:34:53.98,1:34:57.02,Default,,0,0,0,,Жоқ, мен оны танымаймын.
Dialogue: 0,1:34:57.31,1:35:01.19,Default,,0,0,0,,Адам қазір бақыттымын деді.
Dialogue: 0,1:35:01.36,1:35:03.53,Default,,0,0,0,,Мен бұған қатты қуандым.
Dialogue: 0,1:35:08.37,1:35:10.99,Default,,0,0,0,,Ол мүлдем бейтаныс адам еді, солай ма?
Dialogue: 0,1:35:11.49,1:35:12.58,Default,,0,0,0,,Иә
Dialogue: 0,1:35:12.66,1:35:16.00,Default,,0,0,0,,Бейтаныс адамдардың бақыты мені қуантты
Dialogue: 0,1:35:16.62,1:35:19.67,Default,,0,0,0,,Бейтаныс адамның бақытына қуана білу...
Dialogue: 0,1:35:19.88,1:35:23.30,Default,,0,0,0,,Бақытты білгендіктен екенін түсіндім.
Dialogue: 0,1:35:23.42,1:35:26.01,Default,,0,0,0,,Аа... бұл қарапайым.
Dialogue: 0,1:35:26.55,1:35:27.68,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:35:28.30,1:35:32.39,Default,,0,0,0,,Қарапайым сөзбен айтуға тырыссаңыз, бұл сөзсіз.
Dialogue: 0,1:35:33.85,1:35:35.39,Default,,0,0,0,,Аккордтар
Dialogue: 0,1:35:35.85,1:35:40.19,Default,,0,0,0,,Мен қазір бақыттымын, өйткені сен осындасың
Dialogue: 0,1:35:41.69,1:35:42.94,Default,,0,0,0,,Хмм...
Dialogue: 0,1:35:44.23,1:35:47.15,Default,,0,0,0,,Мұны 0 адамға айтыңыз
Dialogue: 0,1:35:47.57,1:35:49.07,Default,,0,0,0,,Әрине айтамын
Dialogue: 0,1:35:50.03,1:35:53.16,Default,,0,0,0,,Бірақ мен барлығыңызға айтқым келеді
Dialogue: 0,1:35:56.04,1:36:01.21,Default,,0,0,0,,Сонымен қатар, жай аккорд емес, біреуді жақсы көрген әрқайсымызға.
Dialogue: 0,1:36:01.88,1:36:05.13,Default,,0,0,0,,Себебі сен Кадзүнэден басқа біреуді жақсы көрдің...
Dialogue: 0,1:36:05.71,1:36:09.34,Default,,0,0,0,,Мен аккордтарды жақсы көре алдым
Dialogue: 0,1:36:09.59,1:36:11.64,Default,,0,0,0,,Рахмет
Dialogue: 0,1:36:12.47,1:36:14.35,Default,,0,0,0,,Ата, қош келдіңіз
Dialogue: 0,1:36:15.02,1:36:16.31,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:36:17.18,1:36:18.39,Default,,0,0,0,,Оқусыз-
Dialogue: 0,1:36:18.48,1:36:20.85,Default,,0,0,0,,Менің ойымша, сіз атаның сыртқа шығып жатқанын көріп отырсыз.
Dialogue: 0,1:36:20.98,1:36:22.11,Default,,0,0,0,,Хе...
Dialogue: 0,1:36:22.19,1:36:24.52,Default,,0,0,0,,Себебі мен қызық болдым.
Dialogue: 0,1:36:24.61,1:36:26.07,Default,,0,0,0,,(Махаббат ізі)
Dialogue: 0,1:36:26.28,1:36:28.45,Default,,0,0,0,,Махаббат қызық
Dialogue: 0,1:36:29.03,1:36:31.11,Default,,0,0,0,,Сақ болыңыз
Dialogue: 0,1:36:33.83,1:36:37.83,Default,,0,0,0,,Мен сен болмасам да сен мені сүйдің.
Dialogue: 0,1:36:37.95,1:36:40.12,Default,,0,0,0,,Аккорд емес адамға
Dialogue: 0,1:36:41.63,1:36:45.25,Default,,0,0,0,,Сізге және сіздің жақындарыңызға сенемін...
Dialogue: 0,1:36:45.92,1:36:51.09,Default,,0,0,0,,Мен сен әлемнің бір жерінде бақыттысың деп үміттенемін
Dialogue: 0,1:37:01.02,1:37:08.03,Default,,0,0,0,,♪~
Dialogue: 0,1:37:21.83,1:37:24.42,Default,,0,0,0,,♪ Шуақты аспан бір жаққа кетті
Dialogue: 0,1:37:24.54,1:37:26.71,Default,,0,0,0,,♪ Жалпақ өмірде
Dialogue: 0,1:37:26.80,1:37:30.26,Default,,0,0,0,,♪ Таныс профиль
Dialogue: 0,1:37:30.34,1:37:33.13,Default,,0,0,0,,♪ Терезені соққан жаңбырдың даусы
Dialogue: 0,1:37:33.22,1:37:35.26,Default,,0,0,0,,♪ Олай дейтін болсам
Dialogue: 0,1:37:35.35,1:37:37.72,Default,,0,0,0,,♪ Барлығы елеусіз
Dialogue: 0,1:37:37.85,1:37:41.35,Default,,0,0,0,,♪ Тривиальды сөздер
Dialogue: 0,1:37:41.48,1:37:43.81,Default,,0,0,0,,♪ Трейлинг
Dialogue: 0,1:37:46.15,1:37:49.23,Default,,0,0,0,,♪ Қанша қиналғаныма сене алар емеспін
Dialogue: 0,1:37:49.36,1:37:52.28,Default,,0,0,0,,♪ Бірақ есімде жоқ
Dialogue: 0,1:37:52.49,1:37:56.20,Default,,0,0,0,,♪ Әрине екеуі
Dialogue: 0,1:37:56.28,1:37:57.87,Default,,0,0,0,,♪ сүйіспеншілікті тәрбиелеу
Dialogue: 0,1:37:58.08,1:38:00.70,Default,,0,0,0,,♪ Арзан өмір сүрейік
Dialogue: 0,1:38:00.83,1:38:03.46,Default,,0,0,0,,♪ Бос сөзді айтайық.
Dialogue: 0,1:38:03.54,1:38:06.08,Default,,0,0,0,,♪ Құрғақ таң қайталағандай,
Dialogue: 0,1:38:06.17,1:38:08.80,Default,,0,0,0,,♪ Қуансақ күлейік
Dialogue: 0,1:38:08.88,1:38:10.51,Default,,0,0,0,,♪ Мен алда не болатынына сенімдімін
Dialogue: 0,1:38:10.59,1:38:11.67,Default,,0,0,0,,♪ Мен білмеймін
Dialogue: 0,1:38:11.76,1:38:12.84,Default,,0,0,0,,♪ Енді мен жай ғана
Dialogue: 0,1:38:12.92,1:38:14.43,Default,,0,0,0,,♪ Сен қурап қалдың
Dialogue: 0,1:38:14.51,1:38:16.51,Default,,0,0,0,,♪ Құрғап кетпесін
Dialogue: 0,1:38:16.64,1:38:19.35,Default,,0,0,0,,♪ Ән айт
Dialogue: 0,1:38:40.83,1:38:43.46,Default,,0,0,0,,♪ Бір-бірін жұбату оңай
Dialogue: 0,1:38:43.58,1:38:45.75,Default,,0,0,0,,♪ Демек, бізде бар нәрсе
Dialogue: 0,1:38:45.83,1:38:49.29,Default,,0,0,0,,♪ Бұлыңғыр аспан
Dialogue: 0,1:38:49.38,1:38:52.55,Default,,0,0,0,,♪ Түсіндегі сағым
Dialogue: 0,1:38:54.42,1:38:57.64,Default,,0,0,0,,♪ Сіздің назарыңызды аударуға тырысу
Dialogue: 0,1:38:57.72,1:39:00.72,Default,,0,0,0,,♪ Мен өзімді жақсы сезіндім.
Dialogue: 0,1:39:00.85,1:39:06.14,Default,,0,0,0,,♪ Бұл жас, шіркін махаббат
Dialogue: 0,1:39:06.27,1:39:09.02,Default,,0,0,0,,♪ Қаңғыбас қараңғылықтың соңында
Dialogue: 0,1:39:09.15,1:39:11.69,Default,,0,0,0,,♪ Бейбіт жүрек нұрға бөленді
Dialogue: 0,1:39:11.78,1:39:12.82,Default,,0,0,0,,♪ созылды
Dialogue: 0,1:39:12.90,1:39:14.53,Default,,0,0,0,,♪ Алақаны ше?
Dialogue: 0,1:39:14.61,1:39:17.03,Default,,0,0,0,,♪ Жібермейік
Dialogue: 0,1:39:17.28,1:39:19.82,Default,,0,0,0,,♪ Жаңбырда жорғалап жүрген гортензияға қараңдар
Dialogue: 0,1:39:19.95,1:39:20.95,Default,,0,0,0,,♪ Бірге шайқаңыз
Dialogue: 0,1:39:21.03,1:39:22.54,Default,,0,0,0,,♪ Сіздің сөздеріңіз
Dialogue: 0,1:39:22.66,1:39:24.87,Default,,0,0,0,,♪ Оның өшіп кетуіне жол бермеңіз
Dialogue: 0,1:39:24.95,1:39:27.58,Default,,0,0,0,,♪ Аспанға қара
Dialogue: 0,1:39:39.09,1:39:41.72,Default,,0,0,0,,♪ Біз сыбырластық
Dialogue: 0,1:39:41.81,1:39:44.52,Default,,0,0,0,,♪ Менің кәдімгі сырым бар еді
Dialogue: 0,1:39:44.60,1:39:46.60,Default,,0,0,0,,♪ Шараптың көз жасы жаңбырындай
Dialogue: 0,1:39:46.69,1:39:49.31,Default,,0,0,0,,♪ Естеліктер
Dialogue: 0,1:39:49.85,1:39:52.65,Default,,0,0,0,,♪ Лапис лазули арқылы
Dialogue: 0,1:39:52.73,1:39:53.65,Default,,0,0,0,,♪ ыңғайсыз
Dialogue: 0,1:39:53.69,1:39:55.40,Default,,0,0,0,,♪ Екеуміз бірге күлдік
Dialogue: 0,1:39:55.49,1:39:57.53,Default,,0,0,0,,♪ Керемет күлкі үшін
Dialogue: 0,1:39:57.61,1:40:00.99,Default,,0,0,0,,♪ Мені таң қалдырды.
Dialogue: 0,1:40:02.03,1:40:03.45,Default,,0,0,0,,♪ Қараңыз
Dialogue: 0,1:40:03.62,1:40:06.25,Default,,0,0,0,,♪ Арзан өмір сүрейік
Dialogue: 0,1:40:06.33,1:40:09.00,Default,,0,0,0,,♪ Бос сөзді айтайық.
Dialogue: 0,1:40:09.08,1:40:11.67,Default,,0,0,0,,♪ Бірінен соң бірі құрғақ таң
Dialogue: 0,1:40:11.75,1:40:14.25,Default,,0,0,0,,♪ Қуансақ күлейік
Dialogue: 0,1:40:14.38,1:40:16.05,Default,,0,0,0,,♪ Мен болашақ болатынына сенімдімін
Dialogue: 0,1:40:16.13,1:40:17.13,Default,,0,0,0,,♪ Мен білмеймін
Dialogue: 0,1:40:17.22,1:40:18.26,Default,,0,0,0,,♪ Енді мен жай ғана
Dialogue: 0,1:40:18.30,1:40:19.93,Default,,0,0,0,,♪ Сен қурап қалдың
Dialogue: 0,1:40:20.01,1:40:22.10,Default,,0,0,0,,♪ Құрғап кетпесін
Dialogue: 0,1:40:22.18,1:40:24.93,Default,,0,0,0,,♪ Ән айт
Dialogue: 0,1:40:25.10,1:40:27.39,Default,,0,0,0,,♪ Өзіңіз сияқты болыңыз
Dialogue: 0,1:40:27.52,1:40:30.40,Default,,0,0,0,,♪ Мен сені жақсы көремін
Dialogue: 0,1:40:35.15,1:40:42.16,Default,,0,0,0,,♪~
Dialogue: 0,1:42:03.95,1:42:10.95,Default,,0,0,0,,~♪
Dialogue: 0,1:42:12.45,1:42:18.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory