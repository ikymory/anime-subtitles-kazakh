Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.87,0:00:11.95,Default,,0,0,0,,Boss
Dialogue: 0,0:00:12.08,0:00:14.58,Default,,0,0,0,,Егер сіз сол ережемен біреумен төбелессеңіз
Dialogue: 0,0:00:14.70,0:00:17.71,Default,,0,0,0,,Мен саған көмектесемін.
Dialogue: 0,0:00:18.37,0:00:19.38,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:20.75,0:00:23.38,Default,,0,0,0,,Жарайды, бірге...
Dialogue: 0,0:00:24.76,0:00:26.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:26.47,0:00:27.88,Default,,0,0,0,,Гофу…
Dialogue: 0,0:00:29.43,0:00:30.43,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:00:31.72,0:00:32.72,Default,,0,0,0,,Құт бастық!
Dialogue: 0,0:00:35.10,0:00:35.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:36.39,0:00:38.39,Default,,0,0,0,,Қазір қашып құтыла алмайсың.
Dialogue: 0,0:00:38.52,0:00:40.69,Default,,0,0,0,,«Әлемге қателер қажет емес»
Dialogue: 0,0:00:40.94,0:00:42.19,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:42.31,0:00:42.82,Default,,0,0,0,,(Гадоллдың айқайы)
Dialogue: 0,0:00:42.82,0:00:43.73,Default,,0,0,0,,(Гадоллдың айқайы)
Dialogue: 0,0:00:42.82,0:00:43.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:43.73,0:00:46.40,Default,,0,0,0,,(Гадоллдың айқайы)
Dialogue: 0,0:00:48.99,0:00:53.99,Default,,0,0,0,,♪~
Dialogue: 0,0:02:13.86,0:02:18.87,Default,,0,0,0,,~♪
Dialogue: 0,0:02:24.17,0:02:26.92,Default,,0,0,0,,Эй, сен кімсің? Аман қалған ба?
Dialogue: 0,0:02:27.09,0:02:28.75,Default,,0,0,0,,~ ұқсайды
Dialogue: 0,0:02:28.88,0:02:29.42,Default,,0,0,0,,Бірақ бұл жігіт неге әлі тірі?
Dialogue: 0,0:02:29.42,0:02:30.88,Default,,0,0,0,,Бірақ бұл жігіт неге әлі тірі?
Dialogue: 0,0:02:29.42,0:02:30.88,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:02:30.88,0:02:31.01,Default,,0,0,0,,Бірақ бұл жігіт неге әлі тірі?
Dialogue: 0,0:02:31.34,0:02:34.01,Default,,0,0,0,,Жаңа үлгі? Ол аман қалады ма?
Dialogue: 0,0:02:34.80,0:02:35.68,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:02:35.80,0:02:36.76,Default,,0,0,0,,Командир?
Dialogue: 0,0:02:37.26,0:02:40.31,Default,,0,0,0,,Сіз GGS-тен қашып құтыла алмайсыз.
Dialogue: 0,0:02:40.43,0:02:42.64,Default,,0,0,0,,Тек оның ішінде басқару чипі болса.
Dialogue: 0,0:02:42.89,0:02:43.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:43.89,0:02:45.60,Default,,0,0,0,,Гадоллдың сәйкестендіру нөмірі жоқ!
Dialogue: 0,0:02:46.15,0:02:47.48,Default,,0,0,0,,Басқару чипі жоқ...
Dialogue: 0,0:02:47.82,0:02:49.98,Default,,0,0,0,,Жүйенің бақылауында емес бар болу...
Dialogue: 0,0:02:50.11,0:02:52.15,Default,,0,0,0,,Жүйеге тапсырыс сұраңыз!
Dialogue: 0,0:02:52.44,0:02:55.45,Default,,0,0,0,,Сонымен қатар, Decadence іске қосылды!
Dialogue: 0,0:02:56.32,0:02:58.41,Default,,0,0,0,,Сол дауыс... Гадол?
Dialogue: 0,0:02:58.74,0:03:00.49,Default,,0,0,0,,Тағы бір қате...
Dialogue: 0,0:03:00.62,0:03:03.21,Default,,0,0,0,,Гуе Гю~!
Dialogue: 0,0:03:03.33,0:03:05.87,Default,,0,0,0,,Жарайды, мен мұндамын.
Dialogue: 0,0:03:06.00,0:03:06.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:07.50,0:03:08.63,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:03:09.25,0:03:10.21,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:11.13,0:03:12.46,Default,,0,0,0,,Жарайды, мен дереу барамын.
Dialogue: 0,0:03:12.59,0:03:16.43,Default,,0,0,0,,Gugggggg...
Dialogue: 0,0:03:16.76,0:03:19.64,Default,,0,0,0,,Ешқандай қиналмаңыз.
Dialogue: 0,0:03:19.76,0:03:21.01,Default,,0,0,0,,Қателердің алдында!
Dialogue: 0,0:03:21.14,0:03:23.64,Default,,0,0,0,,Ой-а-а...
Dialogue: 0,0:03:25.85,0:03:27.10,Default,,0,0,0,,(инге салынған дыбыс)
Dialogue: 0,0:03:37.82,0:03:39.24,Default,,0,0,0,,Нацумэ!
Dialogue: 0,0:03:39.87,0:03:41.16,Default,,0,0,0,,Нацумэ!
Dialogue: 0,0:03:41.49,0:03:42.87,Default,,0,0,0,,Ей, өзіңізді ұстаңыз!
Dialogue: 0,0:03:43.41,0:03:44.62,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:03:44.75,0:03:45.54,Default,,0,0,0,,Нацумэ!
Dialogue: 0,0:03:45.79,0:03:47.37,Default,,0,0,0,,Уф! Апыр-ай! Арх!
Dialogue: 0,0:03:49.71,0:03:50.54,Default,,0,0,0,,Я...
Dialogue: 0,0:03:50.67,0:03:52.88,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:03:53.17,0:03:55.22,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:03:55.34,0:03:57.05,Default,,0,0,0,,Ха! Бастық!
Dialogue: 0,0:03:57.18,0:04:00.14,Default,,0,0,0,,Бастық! Өтінемін оян!
Dialogue: 0,0:04:00.26,0:04:01.89,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:04:02.72,0:04:04.47,Default,,0,0,0,,А... ол жұмысбасты жігіт.
Dialogue: 0,0:04:04.77,0:04:07.35,Default,,0,0,0,,Бастық... Бастық!
Dialogue: 0,0:04:07.48,0:04:08.40,Default,,0,0,0,,Не?
Dialogue: 0,0:04:08.52,0:04:09.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:09.65,0:04:10.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:11.40,0:04:14.78,Default,,0,0,0,,Иә? Ол кезде... неге мұндай жерде болдың?
Dialogue: 0,0:04:15.36,0:04:16.95,Default,,0,0,0,,Сондықтан мен Кабурагимін.
Dialogue: 0,0:04:17.36,0:04:18.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:18.49,0:04:21.41,Default,,0,0,0,,Мен бұл енді қолданылмайтын элемент екенін айттым ба?
Dialogue: 0,0:04:21.83,0:04:24.16,Default,,0,0,0,,Бұл – жаратылған дүние.
Dialogue: 0,0:04:24.41,0:04:26.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:27.12,0:04:28.92,Default,,0,0,0,,Бастық... Бұл не?
Dialogue: 0,0:04:29.46,0:04:31.34,Default,,0,0,0,,Шатасып жатқаныңыз таңқаларлық емес.
Dialogue: 0,0:04:31.46,0:04:33.96,Default,,0,0,0,,Бірақ қазір мен Кабурагимін.
Dialogue: 0,0:04:34.55,0:04:36.13,Default,,0,0,0,,Сіз ынтымақтастық жасайсыз ба?
Dialogue: 0,0:04:36.47,0:04:39.30,Default,,0,0,0,,А... Бастық...
Dialogue: 0,0:04:39.68,0:04:40.72,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:41.18,0:04:42.60,Default,,0,0,0,,Егер сені ұруға рұқсат етсең
Dialogue: 0,0:04:42.72,0:04:44.60,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:04:44.72,0:04:45.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:50.81,0:04:52.48,Default,,0,0,0,,Бұрынғы дауыс...
Dialogue: 0,0:04:52.86,0:04:55.48,Default,,0,0,0,,А, аман қалу... жоқ
Dialogue: 0,0:04:56.32,0:04:58.24,Default,,0,0,0,,Бұл Гадол жасалған.
Dialogue: 0,0:04:58.95,0:05:00.11,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:05:00.24,0:05:01.95,Default,,0,0,0,,Гадоллдың өзін-өзі көбейту мүмкіндігі жоқ.
Dialogue: 0,0:05:02.32,0:05:04.12,Default,,0,0,0,,Жүйенің толық бақылауында болуы керек...
Dialogue: 0,0:05:04.41,0:05:07.58,Default,,0,0,0,,Оның үлгісі бізде болмағандықтан, бұл жай ғана болжам.
Dialogue: 0,0:05:07.70,0:05:11.33,Default,,0,0,0,,Дәл менің алдымда тұр. Бұл ең жақсы дәлел.
Dialogue: 0,0:05:11.67,0:05:14.59,Default,,0,0,0,,Гадол – біз жаратқан жаратылыс.
Dialogue: 0,0:05:15.09,0:05:18.34,Default,,0,0,0,,Ерік бостандығына арналмаған
Dialogue: 0,0:05:18.72,0:05:21.76,Default,,0,0,0,,Жою алдында қандай да бір мутация пайда болды ма?
Dialogue: 0,0:05:22.51,0:05:25.43,Default,,0,0,0,,Жүйе тұрғысынан бұл да қате.
Dialogue: 0,0:05:26.47,0:05:27.56,Default,,0,0,0,,Бұл қателік пе...
Dialogue: 0,0:05:28.10,0:05:30.81,Default,,0,0,0,,Жаңа қателер осылай туады
Dialogue: 0,0:05:31.40,0:05:35.73,Default,,0,0,0,,Барлығын бақылау менмендік ой.
Dialogue: 0,0:05:36.44,0:05:38.32,Default,,0,0,0,,Гадолл қатесі...
Dialogue: 0,0:05:38.44,0:05:40.36,Default,,0,0,0,,Мен сияқты
Dialogue: 0,0:05:46.62,0:05:48.83,Default,,0,0,0,,Кешіріңіз құбыр
Dialogue: 0,0:05:49.37,0:05:50.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:01.13,0:06:01.97,Default,,0,0,0,,Boss
Dialogue: 0,0:06:02.72,0:06:03.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:04.59,0:06:06.39,Default,,0,0,0,,Декадентті тоқтатыңыз!
Dialogue: 0,0:06:12.64,0:06:14.27,Default,,0,0,0,,Олар шабуыл жасамайды...
Dialogue: 0,0:06:14.40,0:06:16.57,Default,,0,0,0,,Шабуыл мақсаты қойылған жоқ па?
Dialogue: 0,0:06:16.69,0:06:17.73,Default,,0,0,0,,Бұйрық! иә?
Dialogue: 0,0:06:17.94,0:06:19.61,Default,,0,0,0,,Жүйеден тапсырыс
Dialogue: 0,0:06:19.74,0:06:22.20,Default,,0,0,0,,«Омега» деп аталатын белгісіз Гадолл
Dialogue: 0,0:06:22.32,0:06:24.11,Default,,0,0,0,,Декаденспен жою
Dialogue: 0,0:06:24.24,0:06:27.49,Default,,0,0,0,,Жарайды, вампир гарпуны Омега нысанасы!
Dialogue: 0,0:06:39.59,0:06:42.30,Default,,0,0,0,,(Омеганың айқайы)
Dialogue: 0,0:06:42.97,0:06:45.76,Default,,0,0,0,,Резервуардың зақымдалуына байланысты максималды мәнге дейін зарядтау мүмкін емес.
Dialogue: 0,0:06:46.26,0:06:48.22,Default,,0,0,0,,Ағымдағы оксон мөлшері 58%
Dialogue: 0,0:06:48.64,0:06:52.10,Default,,0,0,0,,Уақыт жоқ. Зеңбіректі 60% жағыңыз.
Dialogue: 0,0:06:52.48,0:06:53.98,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:06:54.10,0:06:55.52,Default,,0,0,0,,Зеңбіректің тұтануы
Dialogue: 0,0:07:01.44,0:07:02.82,Default,,0,0,0,,ұшыруға дайындық аяқталғанша
Dialogue: 0,0:07:03.36,0:07:08.41,Default,,0,0,0,,5 4 3 2 1
Dialogue: 0,0:07:08.53,0:07:09.37,Default,,0,0,0,,Өрт!
Dialogue: 0,0:07:21.63,0:07:23.01,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:07:26.01,0:07:27.09,Default,,0,0,0,,Әй...
Dialogue: 0,0:07:26.01,0:07:27.09,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:07:27.09,0:07:27.22,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:07:27.22,0:07:28.55,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:07:27.22,0:07:28.55,Default,,0,0,0,,Құрыш зақымдалған!
Dialogue: 0,0:07:32.06,0:07:35.06,Default,,0,0,0,,Мына жігіт... кет құшағымнан! Толық шығарылым!
Dialogue: 0,0:07:35.27,0:07:36.56,Default,,0,0,0,,Күш керемет!
Dialogue: 0,0:07:47.20,0:07:48.16,Default,,0,0,0,,Не!
Dialogue: 0,0:08:05.22,0:08:07.13,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:08:07.38,0:08:09.14,Default,,0,0,0,,Кя! Сатан алғыр!
Dialogue: 0,0:08:15.02,0:08:16.89,Default,,0,0,0,,Қарғыс атсын... Зақымдану жағдайы қандай?
Dialogue: 0,0:08:17.14,0:08:19.10,Default,,0,0,0,,Жетек бөлігінің зақымдалуы 75%
Dialogue: 0,0:08:19.35,0:08:21.11,Default,,0,0,0,,Шіркін бе?
Dialogue: 0,0:08:21.23,0:08:22.19,Default,,0,0,0,,Қазіргі уақытта мүмкін емес
Dialogue: 0,0:08:22.90,0:08:24.07,Default,,0,0,0,,Омега тыныштығы
Dialogue: 0,0:08:24.40,0:08:26.82,Default,,0,0,0,,Бұл зақымдануды қалпына келтіретін сияқты.
Dialogue: 0,0:08:27.20,0:08:28.91,Default,,0,0,0,,Жүйеден командалық бұйрық
Dialogue: 0,0:08:29.32,0:08:32.24,Default,,0,0,0,,Омегаға қарсы қатты зеңбірек қолданылады делінген.
Dialogue: 0,0:08:32.49,0:08:33.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.66,0:08:36.87,Default,,0,0,0,,Уақытты сатып алуға болады. Қазіргі жағдайды түсіну. Асығыңыз!
Dialogue: 0,0:08:37.00,0:08:38.00,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:08:45.92,0:08:46.76,Default,,0,0,0,,Пәрмен
Dialogue: 0,0:08:47.22,0:08:49.68,Default,,0,0,0,,Омега жасушасының бөліну жылдамдығы қалыпты емес.
Dialogue: 0,0:08:50.39,0:08:51.26,Default,,0,0,0,,Не?
Dialogue: 0,0:08:59.35,0:09:01.52,Default,,0,0,0,,Эволюция... сонда?
Dialogue: 0,0:09:08.95,0:09:11.99,Default,,0,0,0,,Қатты зеңбірек атуға дайын!
Dialogue: 0,0:09:16.83,0:09:19.96,Default,,0,0,0,,Омега ішінде оксон энергиясының жоғары концентрациясы анықталды!
Dialogue: 0,0:09:20.08,0:09:20.87,Default,,0,0,0,,Өрт!
Dialogue: 0,0:09:34.35,0:09:35.18,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:35.39,0:09:36.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:37.06,0:09:38.93,Default,,0,0,0,,Не? (Киборг) Үзіліс!
Dialogue: 0,0:09:39.27,0:09:41.14,Default,,0,0,0,,Жоқ, бұл не?
Dialogue: 0,0:09:45.98,0:09:48.24,Default,,0,0,0,,Жарайды, бүгінгі сабаққа осы жеткілікті.
Dialogue: 0,0:09:48.36,0:09:50.15,Default,,0,0,0,,Pipo Pipo
Dialogue: 0,0:09:50.65,0:09:52.91,Default,,0,0,0,,Уақыт келді ме?
Dialogue: 0,0:09:53.20,0:09:54.66,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:54.78,0:09:57.74,Default,,0,0,0,,Менің рөлім осымен аяқталады.
Dialogue: 0,0:09:57.87,0:10:01.21,Default,,0,0,0,,Pipo Pipo Pipo Pipo
Dialogue: 0,0:10:05.00,0:10:06.71,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:10:06.84,0:10:07.71,Default,,0,0,0,,Бұйрық! Ах!
Dialogue: 0,0:10:07.96,0:10:10.01,Default,,0,0,0,,Омега жасушасының белсенділігі төмендейді
Dialogue: 0,0:10:10.13,0:10:12.80,Default,,0,0,0,,Эй... ұйықтап жатқан сияқты!
Dialogue: 0,0:10:13.13,0:10:14.80,Default,,0,0,0,,Бас кеңсеге келтірілген залал көлемі белгісіз.
Dialogue: 0,0:10:14.93,0:10:16.43,Default,,0,0,0,,Ағымдағы ақпаратқа сүйенсек...
Dialogue: 0,0:10:16.56,0:10:17.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:18.77,0:10:21.43,Default,,0,0,0,,Минато командирі, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:10:21.56,0:10:23.44,Default,,0,0,0,,Декаденс қызметкерлері де
Dialogue: 0,0:10:24.10,0:10:27.69,Default,,0,0,0,,Decadence қызметін тоқтату туралы шешім қабылдады.
Dialogue: 0,0:10:28.19,0:10:29.19,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:30.19,0:10:34.03,Default,,0,0,0,,Ғарыштық компрессормен декаданс күмбезін жабыңыз
Dialogue: 0,0:10:34.16,0:10:37.58,Default,,0,0,0,,Омега екеуміз ешнәрсеге азайып қалдық.
Dialogue: 0,0:10:48.67,0:10:51.80,Default,,0,0,0,,Кері санақ енді ғана басталды.
Dialogue: 0,0:10:51.92,0:10:55.76,Default,,0,0,0,,Пайдаланушылардан нұсқауларға сәйкес жүйеден шығу сұралады.
Dialogue: 0,0:10:56.26,0:10:58.10,Default,,0,0,0,,Сәлем, шығу керек пе?
Dialogue: 0,0:10:58.39,0:11:00.56,Default,,0,0,0,,Гадолл дәл сіздің алдыңызда, солай емес пе?
Dialogue: 0,0:11:00.68,0:11:02.35,Default,,0,0,0,,Бұл оқиғаның бір түрі емес пе?
Dialogue: 0,0:11:02.77,0:11:04.60,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:11:05.02,0:11:07.19,Default,,0,0,0,,Сізге ештеңе істеудің қажеті жоқ.
Dialogue: 0,0:11:07.65,0:11:08.82,Default,,0,0,0,,Біздің компания
Dialogue: 0,0:11:08.94,0:11:11.82,Default,,0,0,0,,Біз ақылға қонымды шешімдер қабылдаймыз
Dialogue: 0,0:11:12.15,0:11:14.03,Default,,0,0,0,,Жүйе әлі бұзылмағанша
Dialogue: 0,0:11:14.15,0:11:16.62,Default,,0,0,0,,Регенерация мүмкін
Dialogue: 0,0:11:26.75,0:11:29.59,Default,,0,0,0,,Е... бұл ақымақтық!
Dialogue: 0,0:11:29.71,0:11:30.63,Default,,0,0,0,,Міне, дәл осы жерден басталады! Мен дәл осы жерден бастаймын!
Dialogue: 0,0:11:31.00,0:11:32.34,Default,,0,0,0,,Джил, сен мені естисің бе?
Dialogue: 0,0:11:32.46,0:11:33.80,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:34.47,0:11:35.26,Default,,0,0,0,,Чи…
Dialogue: 0,0:11:35.38,0:11:36.76,Default,,0,0,0,,Балапан Сіз мені естисіз бе?
Dialogue: 0,0:11:37.18,0:11:39.01,Default,,0,0,0,,Минато, не болып жатыр?
Dialogue: 0,0:11:39.30,0:11:40.93,Default,,0,0,0,,Декаданс...
Dialogue: 0,0:11:41.26,0:11:42.60,Default,,0,0,0,,Жабық
Dialogue: 0,0:11:43.10,0:11:44.18,Default,,0,0,0,,Не?
Dialogue: 0,0:11:44.31,0:11:46.19,Default,,0,0,0,,Бұл кері санақ бұл туралы ма?
Dialogue: 0,0:11:46.56,0:11:49.15,Default,,0,0,0,,А, бәрі бітті.
Dialogue: 0,0:11:49.27,0:11:51.44,Default,,0,0,0,,Біз ештеңе істей алмаймыз
Dialogue: 0,0:11:51.57,0:11:53.69,Default,,0,0,0,,Жоқ, декаденция бар.
Dialogue: 0,0:11:53.90,0:11:55.32,Default,,0,0,0,,Джил, жақсысың ба?
Dialogue: 0,0:11:55.57,0:11:57.36,Default,,0,0,0,,Иә, бұл әсіресе
Dialogue: 0,0:11:57.49,0:11:59.53,Default,,0,0,0,,Байланыс қалпына келтірілді.
Dialogue: 0,0:11:59.87,0:12:01.53,Default,,0,0,0,,Сен неменесің...
Dialogue: 0,0:12:01.95,0:12:04.87,Default,,0,0,0,,Танысқаныма қуаныштымын, бұрынғы командир.
Dialogue: 0,0:12:05.00,0:12:07.17,Default,,0,0,0,,Ол жай ғана қатесі бар киборг.
Dialogue: 0,0:12:07.79,0:12:09.58,Default,,0,0,0,,Декаденс туралы не деуге болады?
Dialogue: 0,0:12:10.34,0:12:14.30,Default,,0,0,0,,Денеңіз ретінде Decadence арқылы жүйеге кіріңіз.
Dialogue: 0,0:12:14.42,0:12:17.13,Default,,0,0,0,,Иә! Не? Мен мұны істей алуым керек ...
Dialogue: 0,0:12:17.26,0:12:20.35,Default,,0,0,0,,Иә, әрине тәуекелдер бар, бірақ
Dialogue: 0,0:12:21.01,0:12:21.85,Default,,0,0,0,,Эмилия бүкіл түн бойы мұнда болды ма?
Dialogue: 0,0:12:22.56,0:12:24.10,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:12:24.39,0:12:28.69,Default,,0,0,0,,Мен бұрын Decadent Core әзірлеуге жауапты мүше болдым.
Dialogue: 0,0:12:29.10,0:12:29.94,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:30.44,0:12:33.69,Default,,0,0,0,,Біздің денеміз жүйелердің бақылауында.
Dialogue: 0,0:12:33.82,0:12:36.32,Default,,0,0,0,,Тек өзек тәуелсіз компонент болып табылады.
Dialogue: 0,0:12:36.53,0:12:39.57,Default,,0,0,0,,Тек оны декаденстің өзегіне қосыңыз.
Dialogue: 0,0:12:39.95,0:12:41.83,Default,,0,0,0,,Айтпақшы, кешіріңіз.
Dialogue: 0,0:12:42.16,0:12:43.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:44.24,0:12:45.08,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:12:45.29,0:12:48.83,Default,,0,0,0,,Жоқ! Декаденсті жүйеден тәуелсіз етудің мәні неде?
Dialogue: 0,0:12:49.12,0:12:51.46,Default,,0,0,0,,Мұның бәрі қоқыс.
Dialogue: 0,0:12:51.67,0:12:53.84,Default,,0,0,0,,Қоқыс па, әлде декаденс емес пе.
Dialogue: 0,0:12:53.96,0:12:56.34,Default,,0,0,0,,Бұған қарсы тұрудың жолы жоқ.
Dialogue: 0,0:12:56.63,0:12:59.51,Default,,0,0,0,,Күте тұрыңыз, бос сөз аяқталды.
Dialogue: 0,0:12:59.63,0:13:01.85,Default,,0,0,0,,Одан да кеткен жақсы.
Dialogue: 0,0:13:02.22,0:13:04.10,Default,,0,0,0,,Сәлем! Ку... Бастық!
Dialogue: 0,0:13:04.51,0:13:05.85,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:13:05.97,0:13:09.64,Default,,0,0,0,,Міне, көптеген гадоллдар пайда болды.
Dialogue: 0,0:13:09.77,0:13:11.86,Default,,0,0,0,,Уф... бұл жиіркенішті.
Dialogue: 0,0:13:12.69,0:13:14.94,Default,,0,0,0,,Менің уақытым жоқ, Джил, өтінемін.
Dialogue: 0,0:13:15.36,0:13:16.19,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:16.40,0:13:17.90,Default,,0,0,0,,Сәлем, балапан! (ажыраған дыбыс)
Dialogue: 0,0:13:18.03,0:13:19.99,Default,,0,0,0,,Хмм... Қияметсіз бе!
Dialogue: 0,0:13:20.28,0:13:22.07,Default,,0,0,0,,Бастық, тезірек барайық!
Dialogue: 0,0:13:22.32,0:13:25.29,Default,,0,0,0,,Бар, менің бір ісім бар.
Dialogue: 0,0:13:25.41,0:13:28.33,Default,,0,0,0,,Иә? Жоқ, не...
Dialogue: 0,0:13:29.33,0:13:30.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.21,0:13:32.50,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:42.51,0:13:44.72,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:13:44.85,0:13:46.89,Default,,0,0,0,,Одан бұрын біреуін қалайсыз ба? иә?
Dialogue: 0,0:13:47.68,0:13:48.64,Default,,0,0,0,,Неліктен бұл қате?
Dialogue: 0,0:13:50.39,0:13:54.23,Default,,0,0,0,,Қате - бұл белгілі бір сәттен бастап көретін нәрсе.
Dialogue: 0,0:13:54.52,0:13:57.86,Default,,0,0,0,,Сіз жай ғана біреу шешкен жүйе негізінде шешім қабылдап жатырсыз.
Dialogue: 0,0:13:57.98,0:14:01.20,Default,,0,0,0,,Сондықтан жүйеден сұраңыз
Dialogue: 0,0:14:02.78,0:14:04.87,Default,,0,0,0,,Мүмкіндік болса
Dialogue: 0,0:14:11.16,0:14:13.88,Default,,0,0,0,,Нақты не болып жатыр...
Dialogue: 0,0:14:14.04,0:14:15.63,Default,,0,0,0,,Гадолл Тағы да бар!
Dialogue: 0,0:14:15.96,0:14:17.38,Default,,0,0,0,,Менен сұрама
Dialogue: 0,0:14:17.50,0:14:18.76,Default,,0,0,0,,Маған қарама
Dialogue: 0,0:14:19.38,0:14:22.76,Default,,0,0,0,,Ха... Дәмді ішімдік ішіп едім...
Dialogue: 0,0:14:23.22,0:14:24.89,Default,,0,0,0,,Бейбақтар, кеттік!
Dialogue: 0,0:14:25.05,0:14:26.97,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:27.26,0:14:29.06,Default,,0,0,0,,Уа!
Dialogue: 0,0:14:29.43,0:14:31.18,Default,,0,0,0,,Жаса! (Танкер) Жүр!
Dialogue: 0,0:14:31.31,0:14:33.56,Default,,0,0,0,,Ахх!
Dialogue: 0,0:14:33.69,0:14:34.85,Default,,0,0,0,,Жоғары… уф…
Dialogue: 0,0:14:34.98,0:14:36.69,Default,,0,0,0,,Уф, бұл өте жаман...
Dialogue: 0,0:14:36.82,0:14:39.03,Default,,0,0,0,,Көп ішкен ақымақсың.
Dialogue: 0,0:14:39.69,0:14:41.69,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:45.82,0:14:46.95,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:47.08,0:14:48.99,Default,,0,0,0,,Мен құтқарылдым. Мистер Куб ше?
Dialogue: 0,0:14:49.87,0:14:52.29,Default,,0,0,0,,Мен бастықтың ғана қолынан келетін іспен айналысуға бардым.
Dialogue: 0,0:14:52.71,0:14:53.71,Default,,0,0,0,,Иә
Dialogue: 0,0:14:53.83,0:14:56.54,Default,,0,0,0,,Сонда біз қазір істей алатынымызды жасай аламыз!
Dialogue: 0,0:14:56.67,0:14:57.42,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:14:57.54,0:14:58.67,Default,,0,0,0,,Я...
Dialogue: 0,0:14:58.80,0:15:00.80,Default,,0,0,0,,Вахаха...
Dialogue: 0,0:15:05.18,0:15:06.80,Default,,0,0,0,,Бұл әлі де қажет пе?
Dialogue: 0,0:15:07.10,0:15:08.68,Default,,0,0,0,,Бар
Dialogue: 0,0:15:08.81,0:15:13.06,Default,,0,0,0,,Бұрынғы Decadence-пен қосылу әрекеті жасалмаған.
Dialogue: 0,0:15:13.18,0:15:14.48,Default,,0,0,0,,Сол адам – бәрінен әлсіз
Dialogue: 0,0:15:14.60,0:15:16.27,Default,,0,0,0,,Сіз де біртүрлі адамсыз.
Dialogue: 0,0:15:16.94,0:15:20.40,Default,,0,0,0,,Егер сіз басқаларды бөлшек сияқты ойласаңыз, сізді алаңдатуыңыз мүмкін ...
Dialogue: 0,0:15:20.73,0:15:22.65,Default,,0,0,0,,Қайсысы нағыз сенсің?
Dialogue: 0,0:15:22.78,0:15:24.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:24.95,0:15:26.16,Default,,0,0,0,,Бұл қате.
Dialogue: 0,0:15:26.66,0:15:27.78,Default,,0,0,0,,Джил?
Dialogue: 0,0:15:27.91,0:15:30.41,Default,,0,0,0,,Мінсіз жүйені мақсат еткенде
Dialogue: 0,0:15:30.54,0:15:34.16,Default,,0,0,0,,Қателердің белгісіз элементіне қажеттілік болмауы керек еді.
Dialogue: 0,0:15:34.46,0:15:39.25,Default,,0,0,0,,Бірақ сол белгісіздіктен шығатын нәрсені елемеуге болмайды.
Dialogue: 0,0:15:39.38,0:15:43.30,Default,,0,0,0,,Онда жаңа нәрсе болуы мүмкін
Dialogue: 0,0:15:43.97,0:15:46.18,Default,,0,0,0,,Сіз қателескен жоқсыз.
Dialogue: 0,0:15:46.55,0:15:49.68,Default,,0,0,0,,Иә? Жақсы...?
Dialogue: 0,0:15:50.51,0:15:51.51,Default,,0,0,0,,Орындалды
Dialogue: 0,0:15:51.64,0:15:55.60,Default,,0,0,0,,Қайта жүктегеннен кейін Decadence қызметіне қосылуға болады.
Dialogue: 0,0:15:55.73,0:15:59.19,Default,,0,0,0,,Алайда біз жауапкершілікті өз мойнымызға ала алмаймыз.
Dialogue: 0,0:15:59.52,0:16:01.86,Default,,0,0,0,,Мен саған айттым ба? Мен дайынмын
Dialogue: 0,0:16:07.95,0:16:12.74,Default,,0,0,0,,Мен сол кездегі Decadence-те қалдырған қатеммен не болады деп ойлаймын...
Dialogue: 0,0:16:13.16,0:16:15.20,Default,,0,0,0,,Қызықты.
Dialogue: 0,0:16:15.33,0:16:17.67,Default,,0,0,0,,Сәлем! Балалар тыңдаңдар!
Dialogue: 0,0:16:17.79,0:16:19.71,Default,,0,0,0,,Декаденция міндетті түрде қайтады
Dialogue: 0,0:16:20.21,0:16:21.71,Default,,0,0,0,,Гадолдың жақындауына жол берме!
Dialogue: 0,0:16:22.05,0:16:23.67,Default,,0,0,0,,Түсінікті! Сіз жігіттер!
Dialogue: 0,0:16:24.01,0:16:25.30,Default,,0,0,0,,Эй, оны маған қалдыр.
Dialogue: 0,0:16:25.42,0:16:26.55,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:27.13,0:16:30.35,Default,,0,0,0,,Біз де ұтыла алмаймыз, кеттік!
Dialogue: 0,0:16:30.47,0:16:31.72,Default,,0,0,0,,Өзімді жоғалтып алған сияқтымын.
Dialogue: 0,0:16:32.10,0:16:33.18,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:16:33.47,0:16:34.93,Default,,0,0,0,,Ооо...
Dialogue: 0,0:16:35.06,0:16:36.43,Default,,0,0,0,,Жаса!
Dialogue: 0,0:16:36.77,0:16:38.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:38.27,0:16:40.61,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:40.61,0:16:41.61,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:40.61,0:16:41.61,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:16:41.61,0:16:42.48,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:16:45.49,0:16:46.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:54.87,0:16:57.04,Default,,0,0,0,,Көріскенше, Нацюме...
Dialogue: 0,0:16:59.50,0:17:01.46,Default,,0,0,0,,Енді не…
Dialogue: 0,0:17:32.66,0:17:34.37,Default,,0,0,0,,Шалғам Күтіңіз!
Dialogue: 0,0:17:34.99,0:17:36.29,Default,,0,0,0,,Минато?
Dialogue: 0,0:17:36.79,0:17:38.71,Default,,0,0,0,,Қазіргі жағдайда оның барар жері жоқ.
Dialogue: 0,0:17:38.83,0:17:40.62,Default,,0,0,0,,Мен осы жерден кетемін.
Dialogue: 0,0:17:41.46,0:17:42.88,Default,,0,0,0,,Қашып кетсем не істеуім керек?
Dialogue: 0,0:17:43.00,0:17:44.59,Default,,0,0,0,,Бұдан басқа не бар?
Dialogue: 0,0:17:45.17,0:17:47.55,Default,,0,0,0,,Қайта құру жолдарын ойластыру
Dialogue: 0,0:17:47.67,0:17:49.22,Default,,0,0,0,,Өтінемін, менің айтқанымды орындаңыз...
Dialogue: 0,0:17:49.34,0:17:50.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:50.63,0:17:52.26,Default,,0,0,0,,Мен сенімен бара алмаймын.
Dialogue: 0,0:17:52.59,0:17:55.68,Default,,0,0,0,,Сіз төбелессеңіз де жеңіске жету мүмкіндігі жоқ! Сен бекер өлдің!
Dialogue: 0,0:17:57.64,0:18:00.44,Default,,0,0,0,,Басқа ештеңе істей алмаймын.
Dialogue: 0,0:18:01.77,0:18:03.35,Default,,0,0,0,,Бұл танкер ме?
Dialogue: 0,0:18:03.48,0:18:04.94,Default,,0,0,0,,Адамдар үшін...
Dialogue: 0,0:18:05.69,0:18:07.57,Default,,0,0,0,,Қате болуы мүмкін
Dialogue: 0,0:18:08.15,0:18:09.24,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:09.99,0:18:11.40,Default,,0,0,0,,Мен бұл дұрыс екеніне сенімдімін.
Dialogue: 0,0:18:11.61,0:18:12.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:13.03,0:18:14.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:14.62,0:18:15.95,Default,,0,0,0,,Неге...
Dialogue: 0,0:18:16.45,0:18:19.25,Default,,0,0,0,,Мұндай бетті қалай жасайсың!
Dialogue: 0,0:18:19.79,0:18:22.12,Default,,0,0,0,,Мен енді түсінбеймін
Dialogue: 0,0:18:22.29,0:18:23.83,Default,,0,0,0,,Жүйе сонымен қатар...
Dialogue: 0,0:18:24.46,0:18:25.88,Default,,0,0,0,,Мен де...
Dialogue: 0,0:18:27.30,0:18:31.84,Default,,0,0,0,,Мен не істегім келетінін білмеймін
Dialogue: 0,0:18:35.43,0:18:36.72,Default,,0,0,0,,Шаба өте жақсы.
Dialogue: 0,0:18:36.85,0:18:38.10,Default,,0,0,0,,Ыңғайлы (Киборг) Іш, іш.
Dialogue: 0,0:18:39.43,0:18:40.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:43.14,0:18:45.23,Default,,0,0,0,,Не? машина?
Dialogue: 0,0:18:45.48,0:18:47.61,Default,,0,0,0,,Бұл не... тірі зат?
Dialogue: 0,0:18:47.90,0:18:50.11,Default,,0,0,0,,Иә! Эй, танкер!
Dialogue: 0,0:18:50.44,0:18:51.82,Default,,0,0,0,,Танкер, шындап.
Dialogue: 0,0:18:51.94,0:18:54.11,Default,,0,0,0,,Уф~ Мен оны көрмегелі біраз болды.
Dialogue: 0,0:18:54.36,0:18:55.62,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:18:55.74,0:18:56.91,Default,,0,0,0,,Ол бұзылды ма?
Dialogue: 0,0:18:57.41,0:18:59.08,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:59.20,0:19:00.91,Default,,0,0,0,,Бұл қателік Нацюме емес пе?
Dialogue: 0,0:19:01.16,0:19:02.16,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:02.54,0:19:04.17,Default,,0,0,0,,Неліктен менің атым?
Dialogue: 0,0:19:04.50,0:19:07.88,Default,,0,0,0,,Біз Кабураги мырзаның достарымыз.
Dialogue: 0,0:19:08.00,0:19:12.30,Default,,0,0,0,,Бұл сіз беріліс деп атайтындардың шынайы түрі.
Dialogue: 0,0:19:12.42,0:19:14.26,Default,,0,0,0,,Қараңызшы, бұл да солай.
Dialogue: 0,0:19:14.51,0:19:16.55,Default,,0,0,0,,Не? тістері?
Dialogue: 0,0:19:16.68,0:19:18.01,Default,,0,0,0,,Ум...
Dialogue: 0,0:19:18.43,0:19:21.72,Default,,0,0,0,,Олай болса... Бастықтың шын келбеті қандай...
Dialogue: 0,0:19:21.85,0:19:24.60,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,0:19:24.73,0:19:26.02,Default,,0,0,0,,А...
Dialogue: 0,0:19:26.31,0:19:27.81,Default,,0,0,0,,Бастық дегеніміз не?
Dialogue: 0,0:19:27.94,0:19:28.90,Default,,0,0,0,,Ол тоқтатылды.
Dialogue: 0,0:19:29.02,0:19:31.36,Default,,0,0,0,,Маған олай қарама.
Dialogue: 0,0:19:34.99,0:19:36.91,Default,,0,0,0,,Бұл өте... сүйкімді...
Dialogue: 0,0:19:37.03,0:19:37.78,Default,,0,0,0,,Не!
Dialogue: 0,0:19:38.20,0:19:40.28,Default,,0,0,0,,Бұл сүйкімді Ахахха...
Dialogue: 0,0:19:40.54,0:19:41.70,Default,,0,0,0,,Сүйкімді?
Dialogue: 0,0:19:41.83,0:19:43.20,Default,,0,0,0,,Бұл сүйкімді
Dialogue: 0,0:19:43.33,0:19:45.12,Default,,0,0,0,,Мен? (Кайборг) Уайымдама!
Dialogue: 0,0:19:46.00,0:19:49.17,Default,,0,0,0,,Бастықтың досы болсаң, мен де доспын.
Dialogue: 0,0:19:49.29,0:19:50.80,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:19:51.05,0:19:51.80,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:19:52.21,0:19:53.05,Default,,0,0,0,,Танысқаныма қуаныштымын~
Dialogue: 0,0:19:53.17,0:19:53.92,Default,,0,0,0,,I Нацумэ
Dialogue: 0,0:19:54.05,0:19:54.80,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:19:55.47,0:19:57.76,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:58.47,0:20:00.30,Default,,0,0,0,,«Мен білмеймін»…
Dialogue: 0,0:20:01.68,0:20:03.35,Default,,0,0,0,,Мен де солай болдым
Dialogue: 0,0:20:03.47,0:20:07.81,Default,,0,0,0,,Ештеңе жоқ, тек сынықтарды күту.
Dialogue: 0,0:20:08.15,0:20:10.57,Default,,0,0,0,,Бірақ мені қате құтқарды.
Dialogue: 0,0:20:10.69,0:20:11.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:12.57,0:20:15.95,Default,,0,0,0,,Бұл жүйе үшін қате, бірақ мен үшін емес.
Dialogue: 0,0:20:16.24,0:20:17.28,Default,,0,0,0,,Сондықтан мен ойладым
Dialogue: 0,0:20:18.49,0:20:20.28,Default,,0,0,0,,Өзіңіз шешесіз
Dialogue: 0,0:20:20.53,0:20:21.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:23.29,0:20:24.58,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,0:20:26.62,0:20:27.46,Default,,0,0,0,,Минато
Dialogue: 0,0:20:28.37,0:20:29.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:29.50,0:20:32.55,Default,,0,0,0,,Іс жүзінде мұны бір адам байланыстыра алмайды.
Dialogue: 0,0:20:32.67,0:20:33.88,Default,,0,0,0,,Маған көмектес
Dialogue: 0,0:20:34.01,0:20:35.34,Default,,0,0,0,,Өтірік айтпа
Dialogue: 0,0:20:36.26,0:20:40.60,Default,,0,0,0,,Егер бұл орындалмаса, бізде бәрі орындалғанша күтуден басқа амал қалмайды.
Dialogue: 0,0:20:43.14,0:20:45.56,Default,,0,0,0,,Бұл... қауіп пе?
Dialogue: 0,0:20:46.52,0:20:49.31,Default,,0,0,0,,Егер бұл сізге ұқсайтын болса, солай.
Dialogue: 0,0:20:49.69,0:20:50.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:50.98,0:20:54.94,Default,,0,0,0,,Мен сенен мені осында келеді деп күтпедім...
Dialogue: 0,0:20:55.32,0:20:58.95,Default,,0,0,0,,Менімен соңына дейін күресесің бе?
Dialogue: 0,0:21:00.53,0:21:05.20,Default,,0,0,0,,Ха... хахахаха
Dialogue: 0,0:21:11.54,0:21:12.92,Default,,0,0,0,,(монитор жұмысының дыбысы)
Dialogue: 0,0:21:12.92,0:21:13.75,Default,,0,0,0,,(монитор жұмысының дыбысы)
Dialogue: 0,0:21:12.92,0:21:13.75,Default,,0,0,0,,Бұл пайдалы.
Dialogue: 0,0:21:13.75,0:21:13.88,Default,,0,0,0,,(монитор жұмысының дыбысы)
Dialogue: 0,0:21:13.88,0:21:16.63,Default,,0,0,0,,(монитор жұмысының дыбысы)
Dialogue: 0,0:21:13.88,0:21:16.63,Default,,0,0,0,,Енді мен қате ретінде толығымен сертификатталдым.
Dialogue: 0,0:21:16.76,0:21:18.22,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:19.26,0:21:20.55,Default,,0,0,0,,Саана
Dialogue: 0,0:21:20.68,0:21:23.30,Default,,0,0,0,,Бұл сіздікі сияқты маңызды емес.
Dialogue: 0,0:21:33.65,0:21:36.19,Default,,0,0,0,,Рахмет, командир Минато.
Dialogue: 0,0:21:37.36,0:21:38.36,Default,,0,0,0,,О
Dialogue: 0,0:21:50.12,0:21:51.46,Default,,0,0,0,,Жоғарғы дәрежедегілер
Dialogue: 0,0:21:52.12,0:21:54.42,Default,,0,0,0,,Келісуге жақын қалдық.
Dialogue: 0,0:21:54.54,0:21:56.92,Default,,0,0,0,,Бүгін сізден қолдау күтемін.
Dialogue: 0,0:22:08.35,0:22:10.48,Default,,0,0,0,,Шақалақ Сіз дайынсыз ба?
Dialogue: 0,0:22:16.32,0:22:19.65,Default,,0,0,0,,Декаденс іске қосылды!
Dialogue: 0,0:22:19.94,0:22:24.95,Default,,0,0,0,,♪~
Dialogue: 0,0:23:44.86,0:23:49.87,Default,,0,0,0,,~♪
