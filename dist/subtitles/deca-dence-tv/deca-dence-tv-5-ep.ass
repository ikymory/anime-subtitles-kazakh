Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.00,0:00:05.71,Default,,0,0,0,,(Қақпаның дыбысы)
Dialogue: 0,0:00:05.83,0:00:07.79,Default,,0,0,0,,Біздің 6-шы бөлімшенің міндеті
Dialogue: 0,0:00:07.92,0:00:10.92,Default,,0,0,0,,Тұман тудыратын Гадолл α-ны жойыңыз.
Dialogue: 0,0:00:11.26,0:00:14.93,Default,,0,0,0,,Жергілікті атмосфералық қысым төмен және физикалық күш тез жоғалады.
Dialogue: 0,0:00:15.05,0:00:16.72,Default,,0,0,0,,Тез әрекет етіңіз
Dialogue: 0,0:00:17.14,0:00:18.85,Default,,0,0,0,,Бұл соңғы шайқас
Dialogue: 0,0:00:19.22,0:00:22.23,Default,,0,0,0,,Миссияны кез келген жағдайда орындаңыз Тамаша!
Dialogue: 0,0:00:22.64,0:00:23.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:25.77,0:00:27.15,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:00:31.48,0:00:32.90,Default,,0,0,0,,Сорти!
Dialogue: 0,0:00:34.45,0:00:36.91,Default,,0,0,0,,Hyahooooo~!
Dialogue: 0,0:00:42.04,0:00:47.04,Default,,0,0,0,,♪~
Dialogue: 0,0:02:06.91,0:02:11.92,Default,,0,0,0,,~♪
Dialogue: 0,0:02:17.51,0:02:19.55,Default,,0,0,0,,Қарғыс атсын! Ооо!
Dialogue: 0,0:02:19.68,0:02:22.89,Default,,0,0,0,,Маған қаруыңды бер! Қалпына кел!
Dialogue: 0,0:02:23.01,0:02:24.93,Default,,0,0,0,,Уайымдамаңыз! Ілгері жүру!
Dialogue: 0,0:02:25.47,0:02:27.52,Default,,0,0,0,,Гадолл α сағат 10 бағытында
Dialogue: 0,0:02:28.69,0:02:31.23,Default,,0,0,0,,Мен алысты мүлде көре алмаймын...
Dialogue: 0,0:02:31.56,0:02:32.48,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:32.61,0:02:34.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:34.23,0:02:36.99,Default,,0,0,0,,Ах! Күренай-сан
Dialogue: 0,0:02:37.28,0:02:39.24,Default,,0,0,0,,Ах... Юрико... Мұнда мен үшін орын жоқ па?
Dialogue: 0,0:02:39.95,0:02:41.91,Default,,0,0,0,,Сен ойнауға келдің бе?
Dialogue: 0,0:02:42.03,0:02:44.12,Default,,0,0,0,,Не? Жоқ, олай емес
Dialogue: 0,0:02:44.41,0:02:46.83,Default,,0,0,0,,Сонда сіз қалқымайсыз.
Dialogue: 0,0:02:47.04,0:02:48.12,Default,,0,0,0,,Бұл ұрыс алаңы
Dialogue: 0,0:02:48.41,0:02:49.91,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:02:50.08,0:02:51.62,Default,,0,0,0,,Жеңіс туралы ғана ойламаңыз
Dialogue: 0,0:02:53.29,0:02:54.38,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:59.42,0:03:01.84,Default,,0,0,0,,Ораораораора!
Dialogue: 0,0:03:01.97,0:03:04.60,Default,,0,0,0,,Мына Доткин-сама мені өлтірмекші.
Dialogue: 0,0:03:04.72,0:03:06.26,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:03:10.85,0:03:12.23,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:03:12.35,0:03:13.35,Default,,0,0,0,,Маған ұнамайды, иә?
Dialogue: 0,0:03:13.86,0:03:16.32,Default,,0,0,0,,Бұрынғыдай айуандық
Dialogue: 0,0:03:16.77,0:03:18.19,Default,,0,0,0,,Керемет емес
Dialogue: 0,0:03:18.99,0:03:19.82,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:03:24.53,0:03:25.53,Default,,0,0,0,,Itadaki!
Dialogue: 0,0:03:27.20,0:03:29.83,Default,,0,0,0,,Ақымақ болмаңыз!
Dialogue: 0,0:03:29.95,0:03:31.37,Default,,0,0,0,,Менен ұрлама, бейбақ!
Dialogue: 0,0:03:31.50,0:03:34.17,Default,,0,0,0,,Тұманға байланысты көріну нашар болса да, бұл әлі де керемет
Dialogue: 0,0:03:34.29,0:03:35.79,Default,,0,0,0,,S дәрежесінен күткендей!
Dialogue: 0,0:03:36.04,0:03:38.42,Default,,0,0,0,,Үй жануарларының кішкентай шабақтары
Dialogue: 0,0:03:38.55,0:03:39.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:40.80,0:03:43.01,Default,,0,0,0,,Гадолл α не болып жатыр?
Dialogue: 0,0:03:43.13,0:03:44.59,Default,,0,0,0,,Барлығы өлтіріледі.
Dialogue: 0,0:03:45.39,0:03:48.10,Default,,0,0,0,,Бірақ бұл миссия C дәрежесі болды.
Dialogue: 0,0:03:49.39,0:03:50.89,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:03:59.86,0:04:00.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:01.78,0:04:03.49,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:04:03.61,0:04:06.03,Default,,0,0,0,,Гадолл α Ол шынымен бар ма?
Dialogue: 0,0:04:06.16,0:04:08.74,Default,,0,0,0,,Тісті доңғалақтар сізді жеңген жоқ па?
Dialogue: 0,0:04:09.20,0:04:12.50,Default,,0,0,0,,Олай болса қуанышпен ұяға бет аласың.
Dialogue: 0,0:04:14.92,0:04:15.75,Default,,0,0,0,,Не?
Dialogue: 0,0:04:16.04,0:04:17.34,Default,,0,0,0,,Не!
Dialogue: 0,0:04:22.34,0:04:23.34,Default,,0,0,0,,Беріліс...
Dialogue: 0,0:04:24.18,0:04:25.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:33.43,0:04:36.44,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:04:36.56,0:04:38.06,Default,,0,0,0,,Гуруру…
Dialogue: 0,0:04:38.31,0:04:40.57,Default,,0,0,0,,Қарғыс атсын... Гадол α табылды!
Dialogue: 0,0:04:41.03,0:04:43.24,Default,,0,0,0,,Тыңда, тапсырмаңды орында.
Dialogue: 0,0:04:45.53,0:04:47.24,Default,,0,0,0,,Гурул Гаа!
Dialogue: 0,0:04:47.57,0:04:48.91,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,0:04:49.16,0:04:51.91,Default,,0,0,0,,Уууу!
Dialogue: 0,0:04:52.20,0:04:53.96,Default,,0,0,0,,Өзімді жоғалтып алған сияқтымын.
Dialogue: 0,0:04:58.25,0:04:59.09,Default,,0,0,0,,Не?
Dialogue: 0,0:04:59.42,0:05:02.01,Default,,0,0,0,,Гомес! Сен ақымақ бала!
Dialogue: 0,0:05:04.34,0:05:05.51,Default,,0,0,0,,Гуаа
Dialogue: 0,0:05:06.22,0:05:07.26,Default,,0,0,0,,Гаха
Dialogue: 0,0:05:08.18,0:05:09.01,Default,,0,0,0,,Не?
Dialogue: 0,0:05:09.68,0:05:10.51,Default,,0,0,0,,Гах...
Dialogue: 0,0:05:10.89,0:05:12.56,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:05:12.93,0:05:14.10,Default,,0,0,0,,Танктерді көздеу
Dialogue: 0,0:05:14.23,0:05:15.02,Default,,0,0,0,,Ахх!
Dialogue: 0,0:05:15.14,0:05:17.19,Default,,0,0,0,,Балалар, кетіңдер!
Dialogue: 0,0:05:17.40,0:05:19.65,Default,,0,0,0,,Бірақ қарындас, тезірек!
Dialogue: 0,0:05:23.94,0:05:26.15,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:26.28,0:05:27.11,Default,,0,0,0,,Иә! Ах!
Dialogue: 0,0:05:27.24,0:05:28.49,Default,,0,0,0,,Нацумэ!
Dialogue: 0,0:05:30.07,0:05:31.87,Default,,0,0,0,,Коннооооо!
Dialogue: 0,0:05:32.29,0:05:33.12,Default,,0,0,0,,Гуах!
Dialogue: 0,0:05:33.29,0:05:34.25,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:37.25,0:05:38.75,Default,,0,0,0,,Ха! Нацум!
Dialogue: 0,0:05:38.88,0:05:40.59,Default,,0,0,0,,Гуруру…
Dialogue: 0,0:05:41.88,0:05:43.25,Default,,0,0,0,,Гаха
Dialogue: 0,0:05:44.55,0:05:45.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:45.67,0:05:46.47,Default,,0,0,0,,Не… Не істеп жатырсың!?
Dialogue: 0,0:05:46.76,0:05:47.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:49.18,0:05:51.30,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:05:52.01,0:05:52.85,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:05:53.43,0:05:54.35,Default,,0,0,0,,Болды... Әпке!
Dialogue: 0,0:05:54.47,0:05:55.64,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:05:55.81,0:05:57.85,Default,,0,0,0,,Бұл қазірдің өзінде қиын.
Dialogue: 0,0:05:58.35,0:06:02.15,Default,,0,0,0,,Қуанған баланың өлгенін көру...
Dialogue: 0,0:06:02.27,0:06:03.11,Default,,0,0,0,,Ах... мен...
Dialogue: 0,0:06:03.61,0:06:07.78,Default,,0,0,0,,Жауапкершілікті сезіну жылы.
Dialogue: 0,0:06:08.20,0:06:09.32,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:06:09.45,0:06:12.37,Default,,0,0,0,,Мынау... Мен дайынмын...
Dialogue: 0,0:06:12.99,0:06:15.45,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:06:15.91,0:06:18.37,Default,,0,0,0,,Мистер Йошитоки
Dialogue: 0,0:06:18.92,0:06:22.38,Default,,0,0,0,,(Миндидің ауыр тыныс алуы)
Dialogue: 0,0:06:22.50,0:06:24.75,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:06:24.92,0:06:27.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:27.51,0:06:29.84,Default,,0,0,0,,Осылай қалса қауіпті...
Dialogue: 0,0:06:30.18,0:06:31.89,Default,,0,0,0,,Ол жойылады...
Dialogue: 0,0:06:32.01,0:06:32.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:33.22,0:06:35.85,Default,,0,0,0,,Әй, эй, сен не істейсің?
Dialogue: 0,0:06:38.68,0:06:40.06,Default,,0,0,0,,Өтінемін, осы екеуін қорға
Dialogue: 0,0:06:48.82,0:06:51.82,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:06:52.70,0:06:54.24,Default,,0,0,0,,Гуаа
Dialogue: 0,0:06:54.45,0:06:56.29,Default,,0,0,0,,Джиеее
Dialogue: 0,0:06:57.41,0:06:58.54,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:06.38,0:07:07.59,Default,,0,0,0,,Не!
Dialogue: 0,0:07:08.17,0:07:09.30,Default,,0,0,0,,Ине...
Dialogue: 0,0:07:09.84,0:07:11.72,Default,,0,0,0,,Мен оны шығарып алдым...
Dialogue: 0,0:07:13.14,0:07:16.64,Default,,0,0,0,,Мынау не... мына жігіт...
Dialogue: 0,0:07:16.76,0:07:18.31,Default,,0,0,0,,Гуаааа
Dialogue: 0,0:07:19.27,0:07:20.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:23.10,0:07:24.86,Default,,0,0,0,,Сондықтан мен айттым.
Dialogue: 0,0:07:24.98,0:07:26.36,Default,,0,0,0,,Саған әлі ерте.
Dialogue: 0,0:07:26.48,0:07:27.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:28.61,0:07:31.45,Default,,0,0,0,,Ку... Бастық?
Dialogue: 0,0:07:40.75,0:07:43.79,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:07:43.96,0:07:44.71,Default,,0,0,0,,Барлық қызметкерлер
Dialogue: 0,0:07:44.71,0:07:45.29,Default,,0,0,0,,Барлық қызметкерлер
Dialogue: 0,0:07:44.71,0:07:45.29,Default,,0,0,0,,Ха! Не?
Dialogue: 0,0:07:45.29,0:07:45.42,Default,,0,0,0,,Ха! Не?
Dialogue: 0,0:07:45.42,0:07:47.42,Default,,0,0,0,,Ха! Не?
Dialogue: 0,0:07:45.42,0:07:47.42,Default,,0,0,0,,Тез арада өз позицияңызды алыңыз.
Dialogue: 0,0:07:47.92,0:07:48.13,Default,,0,0,0,,Сіз ұрыс даласына кіргіңіз келе ме?
Dialogue: 0,0:07:48.13,0:07:49.63,Default,,0,0,0,,Сіз ұрыс даласына кіргіңіз келе ме?
Dialogue: 0,0:07:48.13,0:07:49.63,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:07:49.76,0:07:51.26,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:07:49.76,0:07:51.26,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:07:51.26,0:07:52.01,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:07:52.01,0:07:52.68,Default,,0,0,0,,Оқиға 15 минуттан кейін басталады
Dialogue: 0,0:07:52.01,0:07:52.68,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:52.68,0:07:53.43,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:55.76,0:07:56.85,Default,,0,0,0,,Минато?
Dialogue: 0,0:07:56.97,0:07:58.93,Default,,0,0,0,,Бұл тұман шығаратын баяғы гадолл.
Dialogue: 0,0:07:59.64,0:08:02.69,Default,,0,0,0,,Жүйе білмейінше, оны тоқтатудың жолы жоқ, солай ма?
Dialogue: 0,0:08:02.81,0:08:05.19,Default,,0,0,0,,Иә? Кенет, сен не туралы айтып тұрсың?
Dialogue: 0,0:08:05.31,0:08:06.69,Default,,0,0,0,,Бұл мүмкін емес, солай емес пе?
Dialogue: 0,0:08:07.94,0:08:10.44,Default,,0,0,0,,Дұрыс айтасың, сөзіңді бөлдім.
Dialogue: 0,0:08:10.82,0:08:12.32,Default,,0,0,0,,Эй, мынау түрі
Dialogue: 0,0:08:12.45,0:08:14.91,Default,,0,0,0,,Мен саған үндеме дедім.
Dialogue: 0,0:08:15.03,0:08:17.20,Default,,0,0,0,,Мен жай ғана түтіккен денемді жылытқым келеді.
Dialogue: 0,0:08:17.74,0:08:19.45,Default,,0,0,0,,Пайдаланушылар риза болса, жақсы.
Dialogue: 0,0:08:19.58,0:08:21.04,Default,,0,0,0,,Не! Эй!
Dialogue: 0,0:08:21.75,0:08:23.83,Default,,0,0,0,,(Автокөлік үдеткішінің дыбысы)
Dialogue: 0,0:08:26.17,0:08:28.09,Default,,0,0,0,,Ку... Бастық?
Dialogue: 0,0:08:28.38,0:08:31.76,Default,,0,0,0,,Сондықтан мен саған әлі ерте дедім.
Dialogue: 0,0:08:31.88,0:08:33.93,Default,,0,0,0,,Бұл... сынған шокпен.
Dialogue: 0,0:08:34.05,0:08:35.97,Default,,0,0,0,,Мен өз күшімді пайдалана алмадым.
Dialogue: 0,0:08:36.26,0:08:38.76,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:08:39.06,0:08:41.77,Default,,0,0,0,,О, бұл үшін кешірім сұраймын!
Dialogue: 0,0:08:43.18,0:08:44.35,Default,,0,0,0,,Гуаа
Dialogue: 0,0:08:44.77,0:08:46.69,Default,,0,0,0,,Гуаа
Dialogue: 0,0:08:47.02,0:08:49.69,Default,,0,0,0,,Га-га-гаа!
Dialogue: 0,0:08:49.94,0:08:52.15,Default,,0,0,0,,Кишааааа
Dialogue: 0,0:08:52.28,0:08:53.69,Default,,0,0,0,,Чи…
Dialogue: 0,0:08:56.16,0:08:57.07,Default,,0,0,0,,Уау~
Dialogue: 0,0:08:57.20,0:08:58.24,Default,,0,0,0,,Мен ештеңе көрмеймін
Dialogue: 0,0:08:58.37,0:08:59.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:59.33,0:09:00.70,Default,,0,0,0,,Кел! сурет?
Dialogue: 0,0:09:01.74,0:09:03.16,Default,,0,0,0,,Сәлем, бастық!
Dialogue: 0,0:09:03.29,0:09:04.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:04.41,0:09:06.54,Default,,0,0,0,,Ататата...
Dialogue: 0,0:09:06.67,0:09:08.38,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:09:08.50,0:09:09.46,Default,,0,0,0,,Достар әлі бар...
Dialogue: 0,0:09:09.84,0:09:12.46,Default,,0,0,0,,Мені жайына қалдыр, мен әлгі Гадоллды жеңе алмаймын.
Dialogue: 0,0:09:12.80,0:09:13.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:14.30,0:09:16.09,Default,,0,0,0,,Сіз бастық болсаңыз да...
Dialogue: 0,0:09:16.22,0:09:16.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:17.76,0:09:20.51,Default,,0,0,0,,Олай болса, мен барлығын құтқаруым керек.
Dialogue: 0,0:09:20.85,0:09:23.93,Default,,0,0,0,,Олай жасасаң, өлгенмен тең.
Dialogue: 0,0:09:24.35,0:09:25.60,Default,,0,0,0,,Бірақ... Бірақ
Dialogue: 0,0:09:25.73,0:09:27.06,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:09:27.23,0:09:28.06,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:34.40,0:09:37.07,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:09:37.99,0:09:41.16,Default,,0,0,0,,Мен өзімді шектен шығарамын
Dialogue: 0,0:09:41.41,0:09:42.29,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:42.58,0:09:45.00,Default,,0,0,0,,Мен өзімді шегіне жеткізгім келеді!
Dialogue: 0,0:09:46.00,0:09:46.96,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:48.25,0:09:50.29,Default,,0,0,0,,Шектеу...
Dialogue: 0,0:09:50.42,0:09:53.34,Default,,0,0,0,,Мен бұл туралы баяғыда ұмытып кетіппін.
Dialogue: 0,0:09:57.09,0:09:58.34,Default,,0,0,0,,Гуах
Dialogue: 0,0:09:59.39,0:10:01.14,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:01.26,0:10:03.68,Default,,0,0,0,,Сіз оны мына тұманда көре аласыз ба...
Dialogue: 0,0:10:03.81,0:10:05.35,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:10:05.64,0:10:07.73,Default,,0,0,0,,Чикусо, сен қайдасың...
Dialogue: 0,0:10:09.27,0:10:11.48,Default,,0,0,0,,Кешіріңіздер, балалар.
Dialogue: 0,0:10:11.77,0:10:14.53,Default,,0,0,0,,Арматура келе жатыр, тез жүгір!
Dialogue: 0,0:10:15.11,0:10:16.57,Default,,0,0,0,,Бөлімше жетекшісі…
Dialogue: 0,0:10:16.86,0:10:20.78,Default,,0,0,0,,Уууу!
Dialogue: 0,0:10:22.12,0:10:22.87,Default,,0,0,0,,Гуаа
Dialogue: 0,0:10:22.99,0:10:24.49,Default,,0,0,0,,Сен ақымақсың!
Dialogue: 0,0:10:24.95,0:10:26.20,Default,,0,0,0,,(ДжоДжо) Бұл таңқаларлық! Мен сен...
Dialogue: 0,0:10:26.66,0:10:27.50,Default,,0,0,0,,Тез жүр!
Dialogue: 0,0:10:30.33,0:10:32.17,Default,,0,0,0,,Барлығымыз бұл жерден кетейік.
Dialogue: 0,0:10:32.42,0:10:36.17,Default,,0,0,0,,Нацюме, сен, мен кейін түсіндіремін! тез!
Dialogue: 0,0:10:37.01,0:10:38.09,Default,,0,0,0,,Гуаааа
Dialogue: 0,0:10:41.01,0:10:41.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:41.89,0:10:43.10,Default,,0,0,0,,Гуаааа...
Dialogue: 0,0:10:43.22,0:10:44.72,Default,,0,0,0,,Ей, балапан, не істеп жатырсың!
Dialogue: 0,0:10:44.97,0:10:46.56,Default,,0,0,0,,Онымен ұрыспа
Dialogue: 0,0:10:47.98,0:10:49.81,Default,,0,0,0,,Менің жоспарларым бұзылды.
Dialogue: 0,0:10:49.94,0:10:52.02,Default,,0,0,0,,Мен сенің өлуіңе енді жол бере алмаймын
Dialogue: 0,0:10:52.90,0:10:53.98,Default,,0,0,0,,Не?
Dialogue: 0,0:10:54.61,0:10:57.32,Default,,0,0,0,,Сіз сонда танкер туралы айтып отырсыз ба?
Dialogue: 0,0:10:57.94,0:11:00.24,Default,,0,0,0,,Мен қашсам, ол өледі.
Dialogue: 0,0:11:00.61,0:11:02.41,Default,,0,0,0,,Сенің есі дұрыс па...
Dialogue: 0,0:11:02.82,0:11:04.91,Default,,0,0,0,,Қаш, Гадол сені қумайды!
Dialogue: 0,0:11:05.41,0:11:07.16,Default,,0,0,0,,Қазір әлі уақыт бар
Dialogue: 0,0:11:07.62,0:11:12.08,Default,,0,0,0,,Сіз тек Танкер үшін жауынгер болып оралу туралы әңгімені тотықұспен айтқыңыз келе ме?
Dialogue: 0,0:11:13.17,0:11:15.29,Default,,0,0,0,,Бұл жігіт қате болды.
Dialogue: 0,0:11:15.75,0:11:17.42,Default,,0,0,0,,Әлі де әлеммен күресуде
Dialogue: 0,0:11:17.76,0:11:20.93,Default,,0,0,0,,Мен аман қалып, қалағаныма қол жеткіздім.
Dialogue: 0,0:11:21.26,0:11:22.68,Default,,0,0,0,,Мен сияқты емес
Dialogue: 0,0:11:26.26,0:11:27.77,Default,,0,0,0,,Шектегіш?
Dialogue: 0,0:11:27.89,0:11:28.93,Default,,0,0,0,,Тоқта, балапан!
Dialogue: 0,0:11:29.06,0:11:32.56,Default,,0,0,0,,Сол Гадолды өлтірсең, сценарий өзгереді!
Dialogue: 0,0:11:33.10,0:11:35.69,Default,,0,0,0,,Шалғам! Сіз оны қайтара алмайсыз!
Dialogue: 0,0:11:36.86,0:11:40.19,Default,,0,0,0,,Мен оның... өлуіне жол бере алмаймын.
Dialogue: 0,0:11:40.49,0:11:43.70,Default,,0,0,0,,Менде бұл қате бар...
Dialogue: 0,0:11:44.03,0:11:44.99,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:45.37,0:11:48.99,Default,,0,0,0,,Сіз аман қалдыңыз!
Dialogue: 0,0:11:49.16,0:11:50.41,Default,,0,0,0,,Гвуууух!
Dialogue: 0,0:11:51.37,0:11:52.29,Default,,0,0,0,,Хамф!
Dialogue: 0,0:11:52.42,0:11:53.79,Default,,0,0,0,,Гуа!
Dialogue: 0,0:11:59.30,0:12:00.55,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:12:01.22,0:12:02.47,Default,,0,0,0,,Гаа гаа!
Dialogue: 0,0:12:07.85,0:12:09.56,Default,,0,0,0,,Гааа
Dialogue: 0,0:12:10.56,0:12:13.19,Default,,0,0,0,,Уууу!
Dialogue: 0,0:12:16.65,0:12:18.94,Default,,0,0,0,,Ga… Ga… Gi…
Dialogue: 0,0:12:19.07,0:12:21.15,Default,,0,0,0,,Га… Гаги…
Dialogue: 0,0:12:29.74,0:12:31.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:32.29,0:12:35.83,Default,,0,0,0,,(Кабурагидің ауыр тыныс алуы)
Dialogue: 0,0:12:38.00,0:12:42.05,Default,,0,0,0,,Ши... Гадолл α командирінің биологиялық реакциясы жоқ.
Dialogue: 0,0:12:42.67,0:12:43.13,Default,,0,0,0,,Тұманның шығуы тоқтады
Dialogue: 0,0:12:43.13,0:12:44.43,Default,,0,0,0,,Тұман шығару тоқтатылды
Dialogue: 0,0:12:43.13,0:12:44.43,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:12:44.55,0:12:45.84,Default,,0,0,0,,Ауа қысымын басқару да жойылды
Dialogue: 0,0:12:45.97,0:12:47.18,Default,,0,0,0,,Тегіс деңгейге оралу
Dialogue: 0,0:12:47.30,0:12:49.51,Default,,0,0,0,,Ах... Ха!
Dialogue: 0,0:12:49.85,0:12:51.81,Default,,0,0,0,,Нашар! Бұл нәрсе қозғала бастады!
Dialogue: 0,0:12:54.23,0:12:56.69,Default,,0,0,0,,Тұман ешқашан сейілмейтін сияқты.
Dialogue: 0,0:12:56.81,0:12:59.02,Default,,0,0,0,,Бұл түсініксіз.
Dialogue: 0,0:12:59.15,0:13:01.73,Default,,0,0,0,,Бізде басқа амал жоқ
Dialogue: 0,0:13:01.86,0:13:02.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:02.99,0:13:04.15,Default,,0,0,0,,Ах! Тұман...
Dialogue: 0,0:13:06.70,0:13:08.41,Default,,0,0,0,,Бұл «Ұя»
Dialogue: 0,0:13:08.70,0:13:11.08,Default,,0,0,0,,Олар өз міндеттерін орындады.
Dialogue: 0,0:13:11.20,0:13:12.41,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:13:12.70,0:13:15.62,Default,,0,0,0,,Жарайды, келе алатындар келсін!
Dialogue: 0,0:13:15.75,0:13:17.67,Default,,0,0,0,,Мақсат ұясы!
Dialogue: 0,0:13:17.83,0:13:19.21,Default,,0,0,0,,Уууу!
Dialogue: 0,0:13:19.21,0:13:20.29,Default,,0,0,0,,Уууу!
Dialogue: 0,0:13:19.21,0:13:20.29,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:13:20.29,0:13:20.42,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:13:20.42,0:13:21.21,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:13:20.42,0:13:21.21,Default,,0,0,0,,Не!
Dialogue: 0,0:13:21.63,0:13:22.84,Default,,0,0,0,,Әй, не? Не болады?
Dialogue: 0,0:13:22.84,0:13:24.55,Default,,0,0,0,,Әй, не? Не болады?
Dialogue: 0,0:13:22.84,0:13:24.55,Default,,0,0,0,,(Қорқынышты айқай)
Dialogue: 0,0:13:24.55,0:13:25.63,Default,,0,0,0,,(Қорқынышты айқай)
Dialogue: 0,0:13:25.63,0:13:27.47,Default,,0,0,0,,(Қорқынышты айқай)
Dialogue: 0,0:13:25.63,0:13:27.47,Default,,0,0,0,,Бұл қандай дауыс?
Dialogue: 0,0:13:30.51,0:13:32.22,Default,,0,0,0,,Аа.
Dialogue: 0,0:13:32.39,0:13:34.10,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:34.43,0:13:36.60,Default,,0,0,0,,Міне, осында.
Dialogue: 0,0:13:37.39,0:13:40.73,Default,,0,0,0,,Бұл айтарлықтай зиян келтірген сияқты. Мүмкін осылай жалғастыра береміз бе?
Dialogue: 0,0:13:43.32,0:13:44.36,Default,,0,0,0,,Ооо! Не?
Dialogue: 0,0:13:44.49,0:13:45.86,Default,,0,0,0,,Қаш!
Dialogue: 0,0:14:07.88,0:14:10.14,Default,,0,0,0,,Не... бұл...
Dialogue: 0,0:14:10.43,0:14:12.43,Default,,0,0,0,,Үлкен! Үлкен өрескел!
Dialogue: 0,0:14:12.56,0:14:15.31,Default,,0,0,0,,Сонда бұл Гадоллдың көшбасшысы ма?
Dialogue: 0,0:14:15.43,0:14:16.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:16.52,0:14:17.35,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:14:17.48,0:14:18.81,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:18.94,0:14:19.85,Default,,0,0,0,,Ябе!
Dialogue: 0,0:14:19.98,0:14:23.40,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:14:23.69,0:14:25.90,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті, бұл қауіпті!
Dialogue: 0,0:14:26.03,0:14:28.65,Default,,0,0,0,,Сіз не істемексіз? Бұл әлі әзірлену үстінде.
Dialogue: 0,0:14:28.99,0:14:29.95,Default,,0,0,0,,Шулы
Dialogue: 0,0:14:30.07,0:14:32.03,Default,,0,0,0,,Көңіліңіз толқып тұрса, зейініңізді жинақтай алмайсыз.
Dialogue: 0,0:14:32.87,0:14:35.29,Default,,0,0,0,,Әй, жұлдыздар қақпасын дереу артқа тарт!
Dialogue: 0,0:14:35.58,0:14:37.54,Default,,0,0,0,,Жоқ, жоқ, жоқ, мүмкін емес, мүмкін емес~
Dialogue: 0,0:14:37.79,0:14:40.37,Default,,0,0,0,,Оны ойыншылар да, танкистер де көреді.
Dialogue: 0,0:14:40.75,0:14:42.79,Default,,0,0,0,,Бәрінен бұрын ақымақтардың көңілі көтеріледі.
Dialogue: 0,0:14:42.92,0:14:45.00,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз!
Dialogue: 0,0:14:45.17,0:14:46.67,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:14:46.80,0:14:49.63,Default,,0,0,0,,Цк... Декаденс іске қосылды!
Dialogue: 0,0:14:49.88,0:14:52.34,Default,,0,0,0,,Иә, бірақ оксон тапшылығына байланысты
Dialogue: 0,0:14:52.47,0:14:53.97,Default,,0,0,0,,Бұл әдеттегіден ұзағырақ уақыт алады.
Dialogue: 0,0:14:54.10,0:14:55.18,Default,,0,0,0,,Жарайды, асығыңыз!
Dialogue: 0,0:14:55.72,0:14:57.10,Default,,0,0,0,,Вампир гарпунымен ату!
Dialogue: 0,0:15:08.53,0:15:10.86,Default,,0,0,0,,Жұлдыздар қақпасы аймақты кеңейтеді
Dialogue: 0,0:15:15.53,0:15:17.41,Default,,0,0,0,,Оксон инфузиясының басталуы
Dialogue: 0,0:15:17.79,0:15:20.41,Default,,0,0,0,,Толтыру деңгейі небәрі 42%
Dialogue: 0,0:15:21.04,0:15:22.42,Default,,0,0,0,,Барлық жауынгерлерге хабарландыру!
Dialogue: 0,0:15:23.08,0:15:26.05,Default,,0,0,0,,Үлкен Гадолл жұлдыздар қақпасын нысанаға алыңыз!
Dialogue: 0,0:15:26.17,0:15:29.09,Default,,0,0,0,,Ұстау режимін аяқтау үшін маған біраз уақыт беріңіз!
Dialogue: 0,0:15:29.21,0:15:30.38,Default,,0,0,0,,Миссия дәрежесі - S.
Dialogue: 0,0:15:30.51,0:15:32.43,Default,,0,0,0,,Барлығы оны сұрады!
Dialogue: 0,0:15:32.76,0:15:35.35,Default,,0,0,0,,Сіз бұрынғыдан да оттайсыз, солай емес пе?
Dialogue: 0,0:15:35.51,0:15:37.06,Default,,0,0,0,,Сәлем Минато!
Dialogue: 0,0:15:37.77,0:15:39.60,Default,,0,0,0,,Соңында мен барамын. (Исам) Кеттік.
Dialogue: 0,0:15:39.93,0:15:42.44,Default,,0,0,0,,Той уақыты келді!
Dialogue: 0,0:15:43.77,0:15:46.15,Default,,0,0,0,,Осы жерден аяқтаңыз! Барайық!
Dialogue: 0,0:15:46.36,0:15:47.78,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:15:51.78,0:15:54.95,Default,,0,0,0,,Бұл сценарийді өзгертудің нәтижесі ме?
Dialogue: 0,0:15:56.49,0:15:57.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:57.62,0:16:00.83,Default,,0,0,0,,Бастық! Сәл күте тұрыңыз
Dialogue: 0,0:16:02.37,0:16:04.33,Default,,0,0,0,,Иә, Гадолл α -
Dialogue: 0,0:16:04.58,0:16:07.13,Default,,0,0,0,,Бұл коллекторлық агенттіктің жұмысы сияқты.
Dialogue: 0,0:16:07.25,0:16:09.00,Default,,0,0,0,,Пипопипопипи!
Dialogue: 0,0:16:09.38,0:16:10.30,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:10.42,0:16:13.51,Default,,0,0,0,,Тиісті түрде жазаланады деп сенемін.
Dialogue: 0,0:16:13.97,0:16:17.35,Default,,0,0,0,,Бұл жеткілікті!
Dialogue: 0,0:16:22.85,0:16:24.81,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:16:25.06,0:16:27.48,Default,,0,0,0,,Уау, мен қатты толқып тұрмын
Dialogue: 0,0:16:27.61,0:16:28.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:29.11,0:16:30.61,Default,,0,0,0,,Құсса~
Dialogue: 0,0:16:30.73,0:16:31.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:35.45,0:16:39.08,Default,,0,0,0,,Жұлдыздар қақпасынан оксон энергиясының жоғары концентрациясы анықталды!
Dialogue: 0,0:16:50.80,0:16:51.09,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:16:51.09,0:16:52.97,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:16:51.09,0:16:52.97,Default,,0,0,0,,Уау! (Оператор) Кя!
Dialogue: 0,0:16:52.97,0:16:53.26,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:16:53.26,0:16:54.47,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:16:53.26,0:16:54.47,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:16:55.09,0:16:56.22,Default,,0,0,0,,Денедегі оксон
Dialogue: 0,0:16:56.34,0:16:58.97,Default,,0,0,0,,Ол қатты қысыммен ұшып бара жатқан сияқты!
Dialogue: 0,0:16:59.51,0:17:02.47,Default,,0,0,0,,Егер бұл сізге тікелей әсер етсе, бұл эпизодтың соңы.
Dialogue: 0,0:17:03.02,0:17:04.48,Default,,0,0,0,,Қандай күш...
Dialogue: 0,0:17:04.98,0:17:06.48,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:17:06.94,0:17:09.98,Default,,0,0,0,,Бұрынғы шабуылға байланысты Оксон инъекциялық кабелі үзілген!
Dialogue: 0,0:17:10.27,0:17:12.61,Default,,0,0,0,,Оксонды жүктеу жылдамдығы 66%
Dialogue: 0,0:17:12.99,0:17:16.36,Default,,0,0,0,,Сіз Гадоллды штаб-пәтерден шұғыл түрде уақытша тоқтатуды сұрағыңыз келе ме?
Dialogue: 0,0:17:16.49,0:17:19.12,Default,,0,0,0,,Бұл ысырап. Бұл жағдайда біз оны уақытында жасай алмаймыз.
Dialogue: 0,0:17:25.91,0:17:28.13,Default,,0,0,0,,Бұл аяқталмаған...
Dialogue: 0,0:17:28.25,0:17:30.21,Default,,0,0,0,,Қаш! Ухё~
Dialogue: 0,0:17:32.67,0:17:34.05,Default,,0,0,0,,Егер мен оны жоя алсам...
Dialogue: 0,0:17:34.17,0:17:35.88,Default,,0,0,0,,Ухёхёхё~
Dialogue: 0,0:17:36.30,0:17:37.47,Default,,0,0,0,,Эй, сен!
Dialogue: 0,0:17:37.59,0:17:38.64,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:17:38.76,0:17:40.47,Default,,0,0,0,,Не болып жатыр? Бұл
Dialogue: 0,0:17:40.60,0:17:42.35,Default,,0,0,0,,Маған бересіз бе? Ку... Босс?
Dialogue: 0,0:17:42.47,0:17:43.77,Default,,0,0,0,,Гуаа, ұры!
Dialogue: 0,0:17:43.89,0:17:44.64,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:45.56,0:17:47.64,Default,,0,0,0,,Жүйке кабелін жалғаңыз
Dialogue: 0,0:17:54.28,0:17:55.86,Default,,0,0,0,,Қосылым аяқталды
Dialogue: 0,0:17:56.32,0:17:59.41,Default,,0,0,0,,Decadence Interception пішінін белсендіру аяқталды
Dialogue: 0,0:17:59.82,0:18:02.03,Default,,0,0,0,,Декаданс Толық жылдамдық алға!
Dialogue: 0,0:18:02.16,0:18:03.79,Default,,0,0,0,,Қауіпсіздік шегіне жетіңіз!
Dialogue: 0,0:18:03.91,0:18:06.16,Default,,0,0,0,,Мен оны міндетті түрде бір соққымен аяқтаймын! (Оператор) Түсінікті.
Dialogue: 0,0:18:06.62,0:18:08.62,Default,,0,0,0,,Декаденс зеңбірегі тұтануы (оператор) Иә!
Dialogue: 0,0:18:08.75,0:18:09.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:09.79,0:18:13.63,Default,,0,0,0,,Жұлдыздар қақпасында қайтадан оксон энергиясының жоғары концентрациясы анықталды!
Dialogue: 0,0:18:13.75,0:18:14.67,Default,,0,0,0,,Не?
Dialogue: 0,0:18:15.05,0:18:17.72,Default,,0,0,0,,Тым ерте! Зеңбірек тұтануы уақытында емес!
Dialogue: 0,0:18:17.84,0:18:18.80,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:21.64,0:18:22.81,Default,,0,0,0,,Бұл келе жатыр!
Dialogue: 0,0:18:22.93,0:18:24.31,Default,,0,0,0,,Қаш!
Dialogue: 0,0:18:24.56,0:18:27.31,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,0:18:30.65,0:18:33.11,Default,,0,0,0,,Уууу!
Dialogue: 0,0:18:33.23,0:18:35.65,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:51.21,0:18:52.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:52.71,0:18:53.67,Default,,0,0,0,,Шалғам…
Dialogue: 0,0:18:54.09,0:18:56.09,Default,,0,0,0,,Декаденс бекітілген
Dialogue: 0,0:18:56.21,0:18:57.67,Default,,0,0,0,,Енді ауқымда
Dialogue: 0,0:18:58.72,0:19:00.43,Default,,0,0,0,,Decadence зеңбірек тұтану аяқталды
Dialogue: 0,0:19:03.68,0:19:04.93,Default,,0,0,0,,Бет...
Dialogue: 0,0:19:06.31,0:19:07.93,Default,,0,0,0,,Ұсқынсыз құбыжық
Dialogue: 0,0:19:12.10,0:19:13.61,Default,,0,0,0,,Маған жанашырлығыңызды көрсетіңіз!
Dialogue: 0,0:19:13.73,0:19:14.69,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:19:21.86,0:19:22.95,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:20:00.78,0:20:02.49,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:20:03.36,0:20:04.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:04.32,0:20:07.74,Default,,0,0,0,,Бастық? Қорқынышты жүзіңіз не болды?
Dialogue: 0,0:20:08.83,0:20:10.04,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:20:10.95,0:20:13.21,Default,,0,0,0,,Жарайды, Кабу, сен істедің.
Dialogue: 0,0:20:13.33,0:20:15.00,Default,,0,0,0,,Кешіріңіз, не болды?
Dialogue: 0,0:20:15.38,0:20:16.84,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:20:16.96,0:20:19.55,Default,,0,0,0,,Бұл оқиғаны бұрмалағаным үшін.
Dialogue: 0,0:20:19.67,0:20:20.51,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:20.88,0:20:22.76,Default,,0,0,0,,Сіз ештеңеге өкінемін дейсіз ғой, солай ма?
Dialogue: 0,0:20:22.88,0:20:24.59,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:20:24.97,0:20:26.51,Default,,0,0,0,,Ой… бұл қорқынышты!
Dialogue: 0,0:20:41.78,0:20:44.03,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:20:44.49,0:20:45.57,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:20:47.66,0:20:48.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:49.16,0:20:51.08,Default,,0,0,0,,Жаңа кезең?
Dialogue: 0,0:20:51.20,0:20:53.58,Default,,0,0,0,,Ха, бұл оған тұрарлық сияқты.
Dialogue: 0,0:20:53.71,0:20:55.96,Default,,0,0,0,,О, бірінші рет келісіп отырмыз.
Dialogue: 0,0:20:56.25,0:20:58.29,Default,,0,0,0,,Не... не болып жатыр?
Dialogue: 0,0:20:58.42,0:21:00.71,Default,,0,0,0,,Гадолл жойылды...
Dialogue: 0,0:21:01.92,0:21:04.34,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:21:04.80,0:21:07.26,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:08.10,0:21:11.22,Default,,0,0,0,,Бұл сәтті болмайды және әлем тыныш болмайды.
Dialogue: 0,0:21:11.97,0:21:14.69,Default,,0,0,0,,Шайқас ешқашан аяқталмайды
Dialogue: 0,0:21:15.73,0:21:20.19,Default,,0,0,0,,Бастық: Сіз осындай нәрсе болуы мүмкін екенін білесіз бе?
Dialogue: 0,0:21:20.32,0:21:21.86,Default,,0,0,0,,Құбырды сұраңыз
Dialogue: 0,0:21:22.61,0:21:23.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:24.24,0:21:25.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:29.28,0:21:31.03,Default,,0,0,0,,Бастық?
Dialogue: 0,0:21:38.04,0:21:40.96,Default,,0,0,0,,Қайырлы таң, Кабураги мырза.
Dialogue: 0,0:21:41.34,0:21:44.30,Default,,0,0,0,,Біздің мұнда не үшін келгенімізді білесіз бе?
Dialogue: 0,0:21:44.42,0:21:45.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:45.84,0:21:47.76,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:21:48.09,0:21:50.55,Default,,0,0,0,,«Әлемге қателер қажет емес»
Dialogue: 0,0:21:50.68,0:21:51.64,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:21:54.18,0:21:56.18,Default,,0,0,0,,Дүниеде қателер бар...
Dialogue: 0,0:21:57.27,0:21:58.15,Default,,0,0,0,,Қалайша біз жеңілгенімізді мойындап, басымызды иеміз?
Dialogue: 0,0:21:59.15,0:22:01.15,Default,,0,0,0,,Фугия!
Dialogue: 0,0:22:05.61,0:22:10.99,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:11.12,0:22:16.12,Default,,0,0,0,,♪~
Dialogue: 0,0:23:35.91,0:23:40.91,Default,,0,0,0,,~♪
Dialogue: 0,0:23:42.41,0:23:48.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory