Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.13,0:00:16.14,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:16.55,0:00:18.22,Default,,0,0,0,,Гуггггг... Гах...
Dialogue: 0,0:00:18.56,0:00:19.64,Default,,0,0,0,,Уф... (танкер) Көмектесіңізші...
Dialogue: 0,0:00:19.76,0:00:21.35,Default,,0,0,0,,Мен… Бұл… Менің денем…
Dialogue: 0,0:00:21.64,0:00:22.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:22.93,0:00:24.02,Default,,0,0,0,,Бұл ұрыс алаңы
Dialogue: 0,0:00:24.14,0:00:24.89,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:25.02,0:00:27.65,Default,,0,0,0,,Сіз жауынгер болғыңыз келетіні туралы ойыңызды өзгерттіңіз бе?
Dialogue: 0,0:00:31.94,0:00:34.11,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:00:39.28,0:00:41.54,Default,,0,0,0,,(Сөмкенің орындау дыбысы)
Dialogue: 0,0:00:41.54,0:00:44.46,Default,,0,0,0,,(Сөмке дыбысы)
Dialogue: 0,0:00:41.54,0:00:44.46,Default,,0,0,0,,Бұл тітіркендіргіш. Қайтадан басталды.
Dialogue: 0,0:00:45.00,0:00:49.46,Default,,0,0,0,,Рұқсатсыз ұрыс даласына барып, рұқсатсыз өліп қалсаң, мен сені асырамаймын.
Dialogue: 0,0:00:50.75,0:00:53.97,Default,,0,0,0,,Олар жақсы ұл-қыздар болды.
Dialogue: 0,0:00:54.47,0:00:57.26,Default,,0,0,0,,Ол жақсы күйеу мен әйел болды.
Dialogue: 0,0:00:57.39,0:00:59.97,Default,,0,0,0,,Ол жақсы әке және шеше болды.
Dialogue: 0,0:01:00.51,0:01:01.89,Default,,0,0,0,,Ең бастысы
Dialogue: 0,0:01:02.02,0:01:04.89,Default,,0,0,0,,Олардың бәрі бірдей ержүрек жауынгерлер еді.
Dialogue: 0,0:01:05.39,0:01:08.23,Default,,0,0,0,,Олар мына елсіз әлемде
Dialogue: 0,0:01:08.81,0:01:11.15,Default,,0,0,0,,Сол қызу өмір сүрді
Dialogue: 0,0:01:11.65,0:01:14.78,Default,,0,0,0,,Мен олардың өмір жолын мақтан тұтамын
Dialogue: 0,0:01:14.99,0:01:18.70,Default,,0,0,0,,Жауынгерлеріміздің жаны жәннатта болсын.
Dialogue: 0,0:01:21.20,0:01:22.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:22.33,0:01:24.08,Default,,0,0,0,,Дұрыс, ақсақал.
Dialogue: 0,0:01:24.20,0:01:25.96,Default,,0,0,0,,Өздігінен өлме
Dialogue: 0,0:01:26.08,0:01:28.96,Default,,0,0,0,,Ки-иииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииии
Dialogue: 0,0:01:34.13,0:01:35.84,Default,,0,0,0,,Декаданс
Dialogue: 0,0:01:36.05,0:01:39.30,Default,,0,0,0,,Оны сізге Solid Quake әкелді.
Dialogue: 0,0:01:39.43,0:01:43.81,Default,,0,0,0,,Сіз бұрын-соңды болмаған толқуды сезіне алатын үлкен ойын-сауық нысаны
Dialogue: 0,0:01:46.98,0:01:49.15,Default,,0,0,0,,Бұл виртуалды кеңістік емес
Dialogue: 0,0:01:50.02,0:01:52.52,Default,,0,0,0,,Кең байтақ Еуразия материгінде орналасқан
Dialogue: 0,0:01:53.53,0:01:56.69,Default,,0,0,0,,Ойыншы Decadence жылжымалы бекінісіне отырады.
Dialogue: 0,0:01:56.82,0:01:59.24,Default,,0,0,0,,Барлығы шынайы әлемнен ләззат алыңыз
Dialogue: 0,0:02:00.37,0:02:02.33,Default,,0,0,0,,Алдымен ойыншы Gear болады.
Dialogue: 0,0:02:02.45,0:02:03.70,Default,,0,0,0,,Тағайындалған негізгі денеге
Dialogue: 0,0:02:03.83,0:02:06.25,Default,,0,0,0,,Қалауыңызша реттеңіз
Dialogue: 0,0:02:06.83,0:02:09.46,Default,,0,0,0,,Дайын болған кезде достарыңызбен жұмыс жасаңыз
Dialogue: 0,0:02:09.58,0:02:11.75,Default,,0,0,0,,Гадолл аңшылық шытырман оқиғасына аттаныңыз
Dialogue: 0,0:02:11.88,0:02:13.75,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:02:14.63,0:02:16.51,Default,,0,0,0,,Мен өлгенде мұнымен не болады?
Dialogue: 0,0:02:16.97,0:02:18.93,Default,,0,0,0,,Өйткені тісті беріліс денесі тірі дене.
Dialogue: 0,0:02:19.05,0:02:21.01,Default,,0,0,0,,Басынан басынан бастаңыз.
Dialogue: 0,0:02:21.14,0:02:22.64,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:02:22.89,0:02:25.31,Default,,0,0,0,,Сондықтан да шиеленіс сезімі бар болғандықтан танымал.
Dialogue: 0,0:02:25.43,0:02:27.89,Default,,0,0,0,,Оны да көріңіз, қызық болады
Dialogue: 0,0:02:28.06,0:02:30.69,Default,,0,0,0,,Үнемі өзгеретін салмақсыз шайқас
Dialogue: 0,0:02:30.94,0:02:34.07,Default,,0,0,0,,Тәжірибе жинап, рейтингтің жоғарғы жағына ұмтылыңыз
Dialogue: 0,0:02:34.48,0:02:36.82,Default,,0,0,0,,Қару-жарақ пен сауыттың алуан түрі
Dialogue: 0,0:02:37.28,0:02:40.74,Default,,0,0,0,,Тек беріліс қабатының астында орналасқан цистерналар қаласында
Dialogue: 0,0:02:40.86,0:02:44.70,Default,,0,0,0,,Сіз сондай-ақ жойылып кету қаупі төнген адам танкерлерімен әрекеттесе аласыз
Dialogue: 0,0:02:44.91,0:02:50.46,Default,,0,0,0,,Қанағаттану деңгейі 90% болатын бұрын-соңды болмаған ауқымдағы үлкен шайқас.
Dialogue: 0,0:02:50.58,0:02:52.71,Default,,0,0,0,,Жақыннан дәм татып көріңіз!
Dialogue: 0,0:02:59.05,0:03:04.05,Default,,0,0,0,,♪~
Dialogue: 0,0:04:23.93,0:04:28.93,Default,,0,0,0,,~♪
Dialogue: 0,0:04:41.73,0:04:42.82,Default,,0,0,0,,Үлкен гадолл
Dialogue: 0,0:04:42.94,0:04:44.99,Default,,0,0,0,,Диландтың жойылуы аяқталды
Dialogue: 0,0:04:45.11,0:04:47.95,Default,,0,0,0,,Барлық қызметкерлерге еңбектеріңіз үшін алғыс айтамыз.
Dialogue: 0,0:04:48.32,0:04:50.41,Default,,0,0,0,,Оксонды енгізуді ұмытпаңыз
Dialogue: 0,0:04:50.54,0:04:53.62,Default,,0,0,0,,Компьютеріңізді тиісті түрде қайта іске қосыңыз.
Dialogue: 0,0:04:53.96,0:04:56.21,Default,,0,0,0,,Күніңіз жемісті болсын.
Dialogue: 0,0:04:57.25,0:05:00.13,Default,,0,0,0,,Бәріңе сәлем, Кабураги мырза, еңбегіңіз үшін рахмет.
Dialogue: 0,0:05:00.25,0:05:01.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:01.50,0:05:02.96,Default,,0,0,0,,Мен оны көрдім~
Dialogue: 0,0:05:03.09,0:05:03.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:04.05,0:05:06.01,Default,,0,0,0,,Ұрыс даласын соңғы рет көргеніме көп уақыт болды.
Dialogue: 0,0:05:06.13,0:05:06.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:07.80,0:05:09.10,Default,,0,0,0,,Сіз оны монитордан көрдіңіз бе?
Dialogue: 0,0:05:09.22,0:05:11.97,Default,,0,0,0,,Иә, керемет болды!
Dialogue: 0,0:05:12.10,0:05:15.44,Default,,0,0,0,,Топ Ранкер болған кезіңіз есіңізде ме?
Dialogue: 0,0:05:17.73,0:05:19.61,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:05:19.81,0:05:22.19,Default,,0,0,0,,Иә? Кабураги-сан?
Dialogue: 0,0:05:22.32,0:05:24.94,Default,,0,0,0,,Сонда Оксонды қоя алмайсың ба?
Dialogue: 0,0:05:25.40,0:05:28.70,Default,,0,0,0,,Не? Бұл біртүрлі
Dialogue: 0,0:05:32.95,0:05:34.08,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:05:34.87,0:05:38.08,Default,,0,0,0,,Мен енді ешқашан майданға бармаймын...
Dialogue: 0,0:05:40.17,0:05:41.25,Default,,0,0,0,,Донателло мырза
Dialogue: 0,0:05:41.38,0:05:43.71,Default,,0,0,0,,Сіз шектеулерді шығару туралы білесіз бе?
Dialogue: 0,0:05:44.42,0:05:45.92,Default,,0,0,0,,Оны кім естіді?
Dialogue: 0,0:05:46.05,0:05:47.97,Default,,0,0,0,,Білмесеңіз, уайымдамаңыз.
Dialogue: 0,0:05:48.30,0:05:51.60,Default,,0,0,0,,Иә? Білсеңіз маған хабарлаңыз
Dialogue: 0,0:05:51.72,0:05:55.10,Default,,0,0,0,,Маған қарашы, оның ақымақ адал адамдарға қатысы жоқ.
Dialogue: 0,0:05:55.22,0:05:56.73,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:57.10,0:05:58.77,Default,,0,0,0,,Чира (Түркия) Иә?
Dialogue: 0,0:05:58.90,0:06:00.02,Default,,0,0,0,,Я...
Dialogue: 0,0:06:00.27,0:06:01.86,Default,,0,0,0,,Майки
Dialogue: 0,0:06:01.98,0:06:04.73,Default,,0,0,0,,Сол қол жұлынса не болар еді?
Dialogue: 0,0:06:04.86,0:06:06.36,Default,,0,0,0,,Не? Бұл ауырады
Dialogue: 0,0:06:06.53,0:06:07.61,Default,,0,0,0,,Сәлем Түркия
Dialogue: 0,0:06:07.90,0:06:11.66,Default,,0,0,0,,Жарайды, мен мұны қалай істеу керектігін де білмеймін.
Dialogue: 0,0:06:11.78,0:06:13.87,Default,,0,0,0,,Жарайды, айтыңызшы.
Dialogue: 0,0:06:14.12,0:06:16.12,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:06:16.25,0:06:17.12,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:06:17.71,0:06:19.17,Default,,0,0,0,,Дұрыс айтасыз...
Dialogue: 0,0:06:19.29,0:06:23.00,Default,,0,0,0,,Дененің қолын жұлып алғанда ауру сезімі бар.
Dialogue: 0,0:06:23.13,0:06:25.63,Default,,0,0,0,,Негізгі дененің қолын жұлып алатындай емес.
Dialogue: 0,0:06:25.96,0:06:27.59,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:27.72,0:06:30.26,Default,,0,0,0,,Егер олар шынымен зақымдалған болса, оны ешкім жасамас еді.
Dialogue: 0,0:06:30.80,0:06:33.97,Default,,0,0,0,,Шектеуішті босату бұл шектеуді жояды.
Dialogue: 0,0:06:34.10,0:06:36.27,Default,,0,0,0,,Мәселе мынада, сіз шынымен зақымдайсыз.
Dialogue: 0,0:06:36.68,0:06:38.81,Default,,0,0,0,,Не? Бұл қауіпті емес пе?
Dialogue: 0,0:06:38.94,0:06:39.77,Default,,0,0,0,,О
Dialogue: 0,0:06:39.89,0:06:42.31,Default,,0,0,0,,Негізгі корпустың жойылу мүмкіндігі бар.
Dialogue: 0,0:06:42.44,0:06:45.27,Default,,0,0,0,,-мен бір мезгілде элементар денеге қатысты шектеу де жойылады.
Dialogue: 0,0:06:45.40,0:06:48.28,Default,,0,0,0,,Сондықтан сіздің спорттық қабілеттеріңіз артады.
Dialogue: 0,0:06:48.95,0:06:52.16,Default,,0,0,0,,Тәуекелге айырбас ретінде күштің артуы
Dialogue: 0,0:06:52.49,0:06:54.37,Default,,0,0,0,,Эри-чан маған хат жіберіпті. Қандай ғажап, иә?
Dialogue: 0,0:06:54.49,0:06:56.37,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:06:56.49,0:06:58.16,Default,,0,0,0,,Жоқ, мен мұны істеген жоқпын.
Dialogue: 0,0:06:58.70,0:07:01.25,Default,,0,0,0,,Әй, Кабураги-сан, сенің қимылың сондай өткір.
Dialogue: 0,0:07:01.37,0:07:02.67,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:02.79,0:07:06.92,Default,,0,0,0,,Ауырсынуға құмар ойыншы жасаған алдау сияқты.
Dialogue: 0,0:07:07.55,0:07:08.97,Default,,0,0,0,,Осындай нәрсемен араласу
Dialogue: 0,0:07:09.09,0:07:12.34,Default,,0,0,0,,Ақымақ пен жындылар солай істейді, солай ма?
Dialogue: 0,0:07:12.68,0:07:14.10,Default,,0,0,0,,Осымен
Dialogue: 0,0:07:14.35,0:07:15.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:16.06,0:07:16.51,Default,,0,0,0,,Мен сұрамағандай кейіп танытамын.
Dialogue: 0,0:07:16.51,0:07:17.35,Default,,0,0,0,,Мен сұрамағандай кейіп танытамын.
Dialogue: 0,0:07:16.51,0:07:17.35,Default,,0,0,0,,О!
Dialogue: 0,0:07:17.35,0:07:17.81,Default,,0,0,0,,Мен сұрамағандай кейіп танытамын.
Dialogue: 0,0:07:17.93,0:07:18.77,Default,,0,0,0,,Қауіпті әңгіме
Dialogue: 0,0:07:18.89,0:07:20.39,Default,,0,0,0,,Мұны жеке режимде орындаңыз
Dialogue: 0,0:07:20.52,0:07:22.02,Default,,0,0,0,,Жоғарғы дәрежедегілер
Dialogue: 0,0:07:22.44,0:07:25.69,Default,,0,0,0,,Жақында біз келісім нүктесінде боламыз. Бүгінгі қолдауыңыз үшін рахмет.
Dialogue: 0,0:07:25.82,0:07:27.94,Default,,0,0,0,,Донателло-самаға қалдырыңыз!
Dialogue: 0,0:07:28.48,0:07:30.70,Default,,0,0,0,,Біз бүгін тағы да жабайы боламыз!
Dialogue: 0,0:07:30.82,0:07:32.07,Default,,0,0,0,,Дұрыс айтасыңдар, балалар!
Dialogue: 0,0:07:32.41,0:07:33.28,Default,,0,0,0,,Кеттік! (Ер) Иә
Dialogue: 0,0:07:33.41,0:07:34.32,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:07:34.74,0:07:37.20,Default,,0,0,0,,Енді кеш уақыты!
Dialogue: 0,0:07:37.33,0:07:38.74,Default,,0,0,0,,Бар, жүр, жүр!
Dialogue: 0,0:07:38.87,0:07:41.21,Default,,0,0,0,,Уууу!
Dialogue: 0,0:07:41.41,0:07:43.75,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:07:51.30,0:07:52.13,Default,,0,0,0,,Қалғанын саған қалдырамын.
Dialogue: 0,0:07:53.34,0:07:54.47,Default,,0,0,0,,Хамф!
Dialogue: 0,0:07:56.05,0:07:57.76,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:14.45,0:08:16.24,Default,,0,0,0,,О...
Dialogue: 0,0:08:16.37,0:08:17.70,Default,,0,0,0,,Шынымен жүректі елжіретеді…
Dialogue: 0,0:08:17.87,0:08:19.91,Default,,0,0,0,,Сәлем Кабураги-сан
Dialogue: 0,0:08:20.04,0:08:22.16,Default,,0,0,0,,Ой! Бұл жоғары сапалы Оксон ба?
Dialogue: 0,0:08:22.29,0:08:23.54,Default,,0,0,0,,Yo Max
Dialogue: 0,0:08:23.66,0:08:25.42,Default,,0,0,0,,Сіз сәулелерге шомылғыңыз келетін сияқтысыз.
Dialogue: 0,0:08:25.54,0:08:28.29,Default,,0,0,0,,Жоғары сатыдағылар ақымақ емес.
Dialogue: 0,0:08:28.42,0:08:29.96,Default,,0,0,0,,Маған бірдеңе сатып аласың ба?
Dialogue: 0,0:08:30.09,0:08:32.76,Default,,0,0,0,,Ха... Басқа амалым жоқ. Маған жазыл.
Dialogue: 0,0:08:33.05,0:08:34.47,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:08:34.59,0:08:36.97,Default,,0,0,0,,Мен жоғары сапалы Оксонмен де бөліскеніңізді қалаймын.
Dialogue: 0,0:08:37.09,0:08:39.26,Default,,0,0,0,,Бұл мүмкін емес сұрақ.
Dialogue: 0,0:08:39.39,0:08:41.27,Default,,0,0,0,,Ухёхёхёхё...
Dialogue: 0,0:08:41.47,0:08:43.27,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:08:43.52,0:08:46.23,Default,,0,0,0,,Хяхахаха... хахахаха...
Dialogue: 0,0:08:51.78,0:08:53.78,Default,,0,0,0,,Ах Майки
Dialogue: 0,0:08:53.90,0:08:56.95,Default,,0,0,0,,Соңғы кездері рейтингте көтеріліп келе жатқаныңызды айтады.
Dialogue: 0,0:08:57.07,0:08:57.99,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:08:58.62,0:09:02.04,Default,,0,0,0,,Жарайды, мен Кабураги мырзадан қалыс қалған жоқпын.
Dialogue: 0,0:09:02.58,0:09:04.04,Default,,0,0,0,,Хо…
Dialogue: 0,0:09:18.97,0:09:20.22,Default,,0,0,0,,Хун
Dialogue: 0,0:09:52.71,0:09:55.09,Default,,0,0,0,,Кешіріңіз, маған уақыт бөліңіз.
Dialogue: 0,0:09:55.38,0:09:57.55,Default,,0,0,0,,Маған бәрібір. Не болды?
Dialogue: 0,0:09:57.68,0:10:01.43,Default,,0,0,0,,Ах... Негізі соңғы кездері рейтингім жақсарған жоқ.
Dialogue: 0,0:10:01.68,0:10:04.39,Default,,0,0,0,,Мен Кабураги мырзадан кеңес сұрағым келеді.
Dialogue: 0,0:10:04.56,0:10:06.18,Default,,0,0,0,,Нашар өсу?
Dialogue: 0,0:10:06.48,0:10:09.48,Default,,0,0,0,,Иә, мен соңғы кездері тоқырауға ұшырадым.
Dialogue: 0,0:10:09.60,0:10:12.19,Default,,0,0,0,,Тіпті бірдеңе жетіспейтінін білемін.
Dialogue: 0,0:10:15.53,0:10:16.99,Default,,0,0,0,,О... не?
Dialogue: 0,0:10:17.78,0:10:19.45,Default,,0,0,0,,That's right.
Dialogue: 0,0:10:19.57,0:10:21.91,Default,,0,0,0,,Неге менің орнына Донателлодан сұрамайсың?
Dialogue: 0,0:10:22.41,0:10:23.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:23.83,0:10:24.58,Default,,0,0,0,,Не!
Dialogue: 0,0:10:26.41,0:10:28.00,Default,,0,0,0,,Кабураги-сан, солай!
Dialogue: 0,0:10:28.25,0:10:29.33,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:29.46,0:10:30.29,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:10:30.42,0:10:32.50,Default,,0,0,0,,Сіз шектегішті қалай босату керектігін білесіз!
Dialogue: 0,0:10:32.63,0:10:33.46,Default,,0,0,0,,Алдымен осы жігіт туралы білетіндерімізді реттеп көрейік.
Dialogue: 0,0:10:35.17,0:10:36.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:36.63,0:10:37.72,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:38.34,0:10:40.97,Default,,0,0,0,,Сіз, сөзсіз, жоғары деңгейлі адамсыз.
Dialogue: 0,0:10:41.09,0:10:43.01,Default,,0,0,0,,Қазіргідей жақсы.
Dialogue: 0,0:10:43.30,0:10:47.27,Default,,0,0,0,,Басқалар сияқты менің де күмәнім болған жоқ.
Dialogue: 0,0:10:47.39,0:10:48.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:48.48,0:10:51.81,Default,,0,0,0,,Егер мен компанияның жүйесіне иелік етсем
Dialogue: 0,0:10:51.94,0:10:54.15,Default,,0,0,0,,Ауыстыруға болатын...
Dialogue: 0,0:10:55.11,0:10:57.11,Default,,0,0,0,,Скреп - бұл рөлді орындағанның мақтанышы.
Dialogue: 0,0:10:57.23,0:10:58.94,Default,,0,0,0,,Мен әрқашан осылай ойладым
Dialogue: 0,0:10:59.49,0:11:01.32,Default,,0,0,0,,Бірақ мен ранжер болған соң өзгердім.
Dialogue: 0,0:11:01.74,0:11:02.66,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:11:03.49,0:11:04.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:05.70,0:11:07.12,Default,,0,0,0,,Маған енді ұнамайды!
Dialogue: 0,0:11:07.24,0:11:09.46,Default,,0,0,0,,Сізді ауыстыруға болатын күйге оралу!
Dialogue: 0,0:11:09.58,0:11:12.42,Default,,0,0,0,,Егер бұл жалғаса берсе, мен сенімдімін
Dialogue: 0,0:11:12.54,0:11:14.75,Default,,0,0,0,,Сіздің рейтингіңіз төмендейді.
Dialogue: 0,0:11:15.75,0:11:18.59,Default,,0,0,0,,Жоқ... бір боялған соң, қайтып орала алмайсың.
Dialogue: 0,0:11:18.92,0:11:20.59,Default,,0,0,0,,Біз жақсы орындаймыз!
Dialogue: 0,0:11:20.72,0:11:23.09,Default,,0,0,0,,Оны қолданатын ойыншылар бар, солай ма?
Dialogue: 0,0:11:23.22,0:11:24.64,Default,,0,0,0,,Себебі
Dialogue: 0,0:11:24.76,0:11:27.31,Default,,0,0,0,,Ойыншылар мен ранкерлер қолданғанда басқаша.
Dialogue: 0,0:11:27.43,0:11:28.97,Default,,0,0,0,,Ол қате ретінде жойылады.
Dialogue: 0,0:11:29.14,0:11:31.06,Default,,0,0,0,,Мен өзімді шегіне жеткізгім келеді!
Dialogue: 0,0:11:31.19,0:11:31.94,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:32.06,0:11:33.15,Default,,0,0,0,,Кабураги мырза!
Dialogue: 0,0:11:33.60,0:11:36.15,Default,,0,0,0,,Өтінемін! Өтінемін!
Dialogue: 0,0:11:41.45,0:11:43.20,Default,,0,0,0,,20%-ға дейін...
Dialogue: 0,0:11:43.32,0:11:44.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:44.70,0:11:48.37,Default,,0,0,0,,Шектеуішті жою 20% шектелетініне уәде беріңіз.
Dialogue: 0,0:11:48.83,0:11:51.16,Default,,0,0,0,,Олай болса, шабуылға төтеп бере аласыз.
Dialogue: 0,0:11:51.37,0:11:52.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:52.96,0:11:55.17,Default,,0,0,0,,Рахмет! Хехе!
Dialogue: 0,0:11:59.00,0:12:01.92,Default,,0,0,0,,Не деп күліп тұрсың? Бұл жақсы сезінеді
Dialogue: 0,0:12:02.22,0:12:04.93,Default,,0,0,0,,А... кешіріңіз, мен майдан даласын асыға күтемін.
Dialogue: 0,0:12:05.05,0:12:07.76,Default,,0,0,0,,Дәрежеңіз көтерілді деп, ренжімеңіз.
Dialogue: 0,0:12:08.14,0:12:09.56,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:12:09.68,0:12:11.73,Default,,0,0,0,,Мен осында болғаныма қуаныштымын.
Dialogue: 0,0:12:12.06,0:12:13.73,Default,,0,0,0,,олар ондағы жазбаларды сақтау үшін көшіріп жазады—
Dialogue: 0,0:12:13.98,0:12:15.23,Default,,0,0,0,,Жоғарғы дәрежелілер
Dialogue: 0,0:12:15.60,0:12:17.61,Default,,0,0,0,,Келісуге жақын қалдық.
Dialogue: 0,0:12:17.73,0:12:19.23,Default,,0,0,0,,Бүгін мен де сенен сұраймын.
Dialogue: 0,0:12:25.16,0:12:26.45,Default,,0,0,0,,Міне...
Dialogue: 0,0:12:26.57,0:12:27.32,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:12:27.95,0:12:29.16,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:12:35.75,0:12:37.96,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:12:41.01,0:12:43.47,Default,,0,0,0,,Әлемге қателер қажет емес
Dialogue: 0,0:12:43.72,0:12:45.76,Default,,0,0,0,,Уау! Тоқта!
Dialogue: 0,0:12:45.89,0:12:47.22,Default,,0,0,0,,Ах, уау, а...
Dialogue: 0,0:12:47.43,0:12:49.72,Default,,0,0,0,,Pipo pipo pipo~
Dialogue: 0,0:12:50.06,0:12:52.73,Default,,0,0,0,,Құпиялылықты бұзу – елеулі қате
Dialogue: 0,0:12:53.14,0:12:54.81,Default,,0,0,0,,Оны қайтарыңыз.
Dialogue: 0,0:12:54.94,0:12:56.98,Default,,0,0,0,,Бұл құнды ресурс.
Dialogue: 0,0:12:59.06,0:13:00.94,Default,,0,0,0,,Көкнәр
Dialogue: 0,0:13:01.07,0:13:01.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:01.98,0:13:03.49,Default,,0,0,0,,Күшік күшік!
Dialogue: 0,0:13:04.11,0:13:07.24,Default,,0,0,0,,Хмм, бұл өте маңызды мәселе.
Dialogue: 0,0:13:07.99,0:13:10.20,Default,,0,0,0,,Сіз алдаушылардың бірісіз бе?
Dialogue: 0,0:13:10.33,0:13:11.24,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:11.37,0:13:12.91,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:13.04,0:13:14.50,Default,,0,0,0,,Майки…
Dialogue: 0,0:13:14.62,0:13:17.58,Default,,0,0,0,,Джиджи… Гаггагага…
Dialogue: 0,0:13:20.42,0:13:21.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.38,0:13:25.17,Default,,0,0,0,,Бұл кім? Мына жігітті оқытқан жігіт!
Dialogue: 0,0:13:25.30,0:13:26.59,Default,,0,0,0,,Түркия! (Түркия) Иә!
Dialogue: 0,0:13:26.72,0:13:28.80,Default,,0,0,0,,Уф, жоқ!
Dialogue: 0,0:13:28.93,0:13:29.97,Default,,0,0,0,,Донателло, тоқтат!
Dialogue: 0,0:13:30.10,0:13:31.68,Default,,0,0,0,,(төбелес дауыстары)
Dialogue: 0,0:13:32.18,0:13:33.97,Default,,0,0,0,,ақымақ
Dialogue: 0,0:13:48.45,0:13:50.03,Default,,0,0,0,,Кабураги мырза
Dialogue: 0,0:13:50.16,0:13:53.62,Default,,0,0,0,,Сізді ұстағаным үшін кешіріңіз, жоғары дәрежелі қызметкер.
Dialogue: 0,0:13:53.74,0:13:56.46,Default,,0,0,0,,Бұл басқа ранжер зорлық-зомбылық танытқандықтан қабылданған шара.
Dialogue: 0,0:13:58.50,0:13:59.46,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:14:00.00,0:14:03.63,Default,,0,0,0,,Майки шектеушіні босатады, бұл тыйым салынған әрекет.
Dialogue: 0,0:14:03.75,0:14:05.21,Default,,0,0,0,,Қырылған
Dialogue: 0,0:14:05.71,0:14:07.63,Default,,0,0,0,,Демек, ранкер командасы таратылады.
Dialogue: 0,0:14:07.76,0:14:09.72,Default,,0,0,0,,Жоқ! Команда жауапты емес!
Dialogue: 0,0:14:10.59,0:14:11.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:11.55,0:14:14.64,Default,,0,0,0,,Тәуекелге айырбастау күшінің артуы
Dialogue: 0,0:14:14.77,0:14:18.44,Default,,0,0,0,,Ауырсынуға құмар ойыншы жасаған алдау сияқты.
Dialogue: 0,0:14:18.56,0:14:19.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:19.90,0:14:20.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:20.86,0:14:21.73,Default,,0,0,0,,Мұны қабылдаңыз
Dialogue: 0,0:14:22.23,0:14:26.94,Default,,0,0,0,,Жүйе бұл Ранкердің жалпы тәртібіне қатысты мәселе екенін анықтады.
Dialogue: 0,0:14:27.07,0:14:30.74,Default,,0,0,0,,Ертеңнен бастап қол-аяғымыз болып жұмыс істейсің.
Dialogue: 0,0:14:31.24,0:14:32.83,Default,,0,0,0,,Күндізгі сауыт жөндеуші
Dialogue: 0,0:14:32.95,0:14:35.24,Default,,0,0,0,,Түнде коллектор ретінде әрекет етіңіз.
Dialogue: 0,0:14:35.83,0:14:36.91,Default,,0,0,0,,Коллекционер?
Dialogue: 0,0:14:36.91,0:14:37.04,Default,,0,0,0,,Коллекционер?
Dialogue: 0,0:14:36.91,0:14:37.04,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:14:37.04,0:14:37.16,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:14:37.16,0:14:38.00,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:14:37.16,0:14:38.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:39.33,0:14:41.21,Default,,0,0,0,,Кейбір адамдар
Dialogue: 0,0:14:41.33,0:14:45.55,Default,,0,0,0,,Бұл дүниеге ыңғайсыз адамдар жиі шығады.
Dialogue: 0,0:14:45.67,0:14:48.01,Default,,0,0,0,,Мұның бәрі қателер
Dialogue: 0,0:14:49.34,0:14:52.60,Default,,0,0,0,,Қателер әлем үшін қаншалықты қауіпті?
Dialogue: 0,0:14:52.72,0:14:54.60,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:14:55.93,0:14:58.64,Default,,0,0,0,,Жүйе қатені жояды.
Dialogue: 0,0:14:58.85,0:15:02.73,Default,,0,0,0,,Адамның ішіне чипті жинау керек.
Dialogue: 0,0:15:02.86,0:15:05.23,Default,,0,0,0,,Мен де қате таптым.
Dialogue: 0,0:15:05.36,0:15:07.28,Default,,0,0,0,,Сондай-ақ хабарлаңыз
Dialogue: 0,0:15:09.15,0:15:11.28,Default,,0,0,0,,Жеткізгішті қайта бер.
Dialogue: 0,0:15:12.03,0:15:14.49,Default,,0,0,0,,Мен және сіз Компанияның мүлкі
Dialogue: 0,0:15:14.62,0:15:16.74,Default,,0,0,0,,Күшік күшік Бас тартуға...
Dialogue: 0,0:15:17.33,0:15:19.62,Default,,0,0,0,,Менің жүйеге қарсы шығу ниетім жоқ.
Dialogue: 0,0:15:19.91,0:15:21.71,Default,,0,0,0,,Жақсы көзқарас
Dialogue: 0,0:15:21.83,0:15:23.75,Default,,0,0,0,,Донателло және басқалар сияқты емес.
Dialogue: 0,0:15:24.25,0:15:26.21,Default,,0,0,0,,Иә! Ол нені білдіреді?
Dialogue: 0,0:15:26.50,0:15:28.13,Default,,0,0,0,,Олар ақымақ
Dialogue: 0,0:15:28.26,0:15:31.09,Default,,0,0,0,,Мен жүйенің шешімін орындамадым.
Dialogue: 0,0:15:31.84,0:15:34.72,Default,,0,0,0,,Сондықтан мені түзеу мекемесіне, Көкнәр Попи Көкнәрге жіберді.
Dialogue: 0,0:15:35.35,0:15:36.72,Default,,0,0,0,,Айха.
Dialogue: 0,0:15:37.72,0:15:40.10,Default,,0,0,0,,Енді қайталаңыз
Dialogue: 0,0:15:40.27,0:15:42.73,Default,,0,0,0,,«Әлемге қателер қажет емес»
Dialogue: 0,0:15:43.27,0:15:44.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:45.81,0:15:47.11,Default,,0,0,0,,Кабураги мырза?
Dialogue: 0,0:15:47.40,0:15:48.32,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:49.40,0:15:52.49,Default,,0,0,0,,Әлемге қателер қажет емес
Dialogue: 0,0:16:01.96,0:16:04.71,Default,,0,0,0,,Мұны өзім шешуге рұқсат етіңіз.
Dialogue: 0,0:16:06.09,0:16:08.30,Default,,0,0,0,,Сәлем Майки...
Dialogue: 0,0:16:11.13,0:16:13.59,Default,,0,0,0,,Маған күресуді үйретіңізші!
Dialogue: 0,0:16:13.88,0:16:17.26,Default,,0,0,0,,Мен «сол күшке» қосылғым келеді!
Dialogue: 0,0:16:17.39,0:16:19.14,Default,,0,0,0,,Сіз әлі де солай айтасыз ба?
Dialogue: 0,0:16:19.26,0:16:21.77,Default,,0,0,0,,Аскөктен аздап үйренсек ше?
Dialogue: 0,0:16:22.23,0:16:24.81,Default,,0,0,0,,Содан бері көшеге шығуға қорқатынын айтты.
Dialogue: 0,0:16:24.94,0:16:26.48,Default,,0,0,0,,Мен кеңсеге жұмысқа бардым.
Dialogue: 0,0:16:26.61,0:16:28.61,Default,,0,0,0,,Менің өлгім де, берілгім де келмейді.
Dialogue: 0,0:16:29.53,0:16:31.36,Default,,0,0,0,,Не айтсаң да, түкке тұрғысыз.
Dialogue: 0,0:16:31.82,0:16:33.40,Default,,0,0,0,,Түсінікті...
Dialogue: 0,0:16:33.53,0:16:36.87,Default,,0,0,0,,Осыншама көп сұрасаң, нәтиже шықпаса, менің амалым жоқ.
Dialogue: 0,0:16:37.16,0:16:38.87,Default,,0,0,0,,Бастық, кешіріңіз!
Dialogue: 0,0:16:39.28,0:16:40.12,Default,,0,0,0,,Не!
Dialogue: 0,0:16:40.58,0:16:42.00,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:16:42.16,0:16:44.96,Default,,0,0,0,,Айтпасаң мен саған құбырды айтамын!
Dialogue: 0,0:16:45.08,0:16:45.92,Default,,0,0,0,,Не!
Dialogue: 0,0:16:46.04,0:16:48.67,Default,,0,0,0,,Содан кейін бастық Decadence-тен шығарылды.
Dialogue: 0,0:16:48.79,0:16:51.76,Default,,0,0,0,,Сүйкімді Пип-чан тартылған етке айналады!
Dialogue: 0,0:16:51.88,0:16:54.34,Default,,0,0,0,,Сіз мені қорқытасыз ба?
Dialogue: 0,0:16:54.59,0:16:57.34,Default,,0,0,0,,Егер бұл сізге ұқсайтын болса, солай.
Dialogue: 0,0:16:58.93,0:17:00.10,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:17:01.64,0:17:02.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:04.10,0:17:06.85,Default,,0,0,0,,Кешіріңіз! Бұрынғы айтқаным өтірік!
Dialogue: 0,0:17:06.98,0:17:09.11,Default,,0,0,0,,Мен бұл фотоны бағалаймын...
Dialogue: 0,0:17:09.90,0:17:11.86,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:17:12.61,0:17:14.36,Default,,0,0,0,,Мен біттім
Dialogue: 0,0:17:14.90,0:17:17.49,Default,,0,0,0,,Өлгенше күнде солай өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:17:17.82,0:17:19.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:20.99,0:17:23.37,Default,,0,0,0,,Бұл сәл артық.
Dialogue: 0,0:17:24.04,0:17:25.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:29.75,0:17:31.17,Default,,0,0,0,,Өл, қарт жезөкше!
Dialogue: 0,0:17:31.30,0:17:33.38,Default,,0,0,0,,О, қош келдіңіз, Нацумэ-чан
Dialogue: 0,0:17:33.67,0:17:36.30,Default,,0,0,0,,Ах! Баға тағы көтерілді ме?
Dialogue: 0,0:17:36.43,0:17:38.55,Default,,0,0,0,,Соңғы кездері жақсы емеспін.
Dialogue: 0,0:17:38.68,0:17:40.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:40.72,0:17:42.81,Default,,0,0,0,,Бұл жай ғана...
Dialogue: 0,0:17:42.93,0:17:45.43,Default,,0,0,0,,Хмм... Жарайды, мен шештім!
Dialogue: 0,0:17:45.56,0:17:46.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:50.77,0:17:51.90,Default,,0,0,0,,Бастық?
Dialogue: 0,0:17:52.23,0:17:53.82,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:17:53.94,0:17:54.90,Default,,0,0,0,,Иә! (Дүкенші) Әй!
Dialogue: 0,0:17:55.99,0:17:58.32,Default,,0,0,0,,Сәлем Нацумэ-чан!
Dialogue: 0,0:17:58.66,0:18:00.87,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:18:00.99,0:18:01.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:03.20,0:18:05.66,Default,,0,0,0,,Иә? Бұл қайда?
Dialogue: 0,0:18:06.25,0:18:08.92,Default,,0,0,0,,Ах! Қайда бара жатырсың?
Dialogue: 0,0:18:14.30,0:18:15.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:15.38,0:18:16.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:16.92,0:18:17.84,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:18:21.14,0:18:22.64,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:23.06,0:18:23.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:28.14,0:18:29.48,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:18:29.60,0:18:31.06,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:18:32.36,0:18:33.86,Default,,0,0,0,,Бастық! Ха!
Dialogue: 0,0:18:35.32,0:18:37.53,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:18:37.65,0:18:39.53,Default,,0,0,0,,Көрдіңіз бе...
Dialogue: 0,0:18:40.49,0:18:41.87,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:18:42.20,0:18:44.37,Default,,0,0,0,,Соңғысы сіздің чипіңіз.
Dialogue: 0,0:18:45.12,0:18:46.50,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:18:46.62,0:18:47.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:50.42,0:18:51.54,Default,,0,0,0,,Не?
Dialogue: 0,0:18:51.92,0:18:53.29,Default,,0,0,0,,Неліктен өңделмейді?
Dialogue: 0,0:18:53.42,0:18:56.38,Default,,0,0,0,,Енді мен түсінбейтін не айтып тұрсың?
Dialogue: 0,0:18:56.51,0:18:59.88,Default,,0,0,0,,Айтайын дегенім, ұйықтап жатқан адамдардың ақшасын ұрлау жақсы емес!
Dialogue: 0,0:19:00.01,0:19:00.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:00.88,0:19:04.05,Default,,0,0,0,,Бастық: Сіз шынымен де мұндай нәрсені жасайтын адам емессіз бе?
Dialogue: 0,0:19:04.26,0:19:05.93,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:19:06.27,0:19:07.93,Default,,0,0,0,,Мен не болғанын білмеймін.
Dialogue: 0,0:19:08.39,0:19:11.94,Default,,0,0,0,,Бітті деме, берілме!
Dialogue: 0,0:19:12.23,0:19:13.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:14.02,0:19:16.07,Default,,0,0,0,,Мен оны саған қарызға беремін!
Dialogue: 0,0:19:16.19,0:19:19.24,Default,,0,0,0,,Иә! Менің барлық қымбат дүниелерім!
Dialogue: 0,0:19:19.82,0:19:24.62,Default,,0,0,0,,Поо! Кукукуку…
Dialogue: 0,0:19:24.74,0:19:26.03,Default,,0,0,0,,Хахаха... аа...?
Dialogue: 0,0:19:26.20,0:19:27.12,Default,,0,0,0,,Мм!
Dialogue: 0,0:19:27.24,0:19:29.08,Default,,0,0,0,,Бұл күлкі емес!
Dialogue: 0,0:19:29.20,0:19:31.71,Default,,0,0,0,,Мен мүлдем ақша алған жоқпын!
Dialogue: 0,0:19:31.83,0:19:33.17,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:19:33.29,0:19:35.21,Default,,0,0,0,,Мен енді ұрлық жасамаймын, үйге қайт.
Dialogue: 0,0:19:35.34,0:19:36.50,Default,,0,0,0,,Эй, бұл не? Қалай айту керек!
Dialogue: 0,0:19:36.50,0:19:37.80,Default,,0,0,0,,Эй, бұл не? Қалай айту керек!
Dialogue: 0,0:19:36.50,0:19:37.80,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:40.42,0:19:41.76,Default,,0,0,0,,Егер Хигучи екінші Кира сияқты тек қарап-ақ адам өлтіре алса, онда Кираның шын кім екені бағдарлама соңында ашылады!
Dialogue: 0,0:19:41.88,0:19:44.30,Default,,0,0,0,,Барлық адамдар чиптермен басқарылады
Dialogue: 0,0:19:45.14,0:19:47.01,Default,,0,0,0,,Ұрлық деп қателессеңіз де
Dialogue: 0,0:19:47.14,0:19:49.06,Default,,0,0,0,,Міндетті түрде өңделуі керек
Dialogue: 0,0:19:52.60,0:19:53.56,Default,,0,0,0,,Не?
Dialogue: 0,0:19:54.23,0:19:55.81,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:03.03,0:20:03.24,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:20:03.24,0:20:04.07,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:20:03.24,0:20:04.07,Default,,0,0,0,,Не!
Dialogue: 0,0:20:06.28,0:20:07.58,Default,,0,0,0,,Не...
Dialogue: 0,0:20:08.04,0:20:09.12,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:20:09.24,0:20:11.71,Default,,0,0,0,,Оны жүйе танымайды ма?
Dialogue: 0,0:20:12.75,0:20:14.00,Default,,0,0,0,,Қате…
Dialogue: 0,0:20:14.54,0:20:16.71,Default,,0,0,0,,! Сол сияқты
Dialogue: 0,0:20:16.84,0:20:19.00,Default,,0,0,0,,Мен бұл күшке қосыла алмадым.
Dialogue: 0,0:20:19.42,0:20:20.96,Default,,0,0,0,,Бұл шынымен жаман ба?
Dialogue: 0,0:20:22.63,0:20:25.01,Default,,0,0,0,,Сәлем Майки
Dialogue: 0,0:20:25.84,0:20:26.72,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:35.06,0:20:36.98,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:20:37.11,0:20:39.15,Default,,0,0,0,,Бұл не деген жиіркенішті бет?
Dialogue: 0,0:20:39.69,0:20:42.99,Default,,0,0,0,,Неге маған күресуді үйреткіңіз келді?
Dialogue: 0,0:20:45.03,0:20:46.78,Default,,0,0,0,,That's right.
Dialogue: 0,0:20:46.91,0:20:49.49,Default,,0,0,0,,Қателер бұл әлемде қалай өмір сүреді?
Dialogue: 0,0:20:50.04,0:20:51.62,Default,,0,0,0,,Мен тексергім келді.
Dialogue: 0,0:20:51.83,0:20:54.33,Default,,0,0,0,,Иә? Қате дегеніміз не?
Dialogue: 0,0:20:54.46,0:20:55.33,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:20:55.46,0:20:56.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:56.58,0:20:59.50,Default,,0,0,0,,Басқаша айтқанда, жәндік сияқты әлсіз дегенді білдіреді.
Dialogue: 0,0:20:59.63,0:21:01.30,Default,,0,0,0,,Бұл аздап нашар емес пе?
Dialogue: 0,0:21:01.76,0:21:04.17,Default,,0,0,0,,Үміт болмаса, бас тарт.
Dialogue: 0,0:21:04.30,0:21:05.93,Default,,0,0,0,,Не? Маған ұнамайды
Dialogue: 0,0:21:07.59,0:21:10.72,Default,,0,0,0,,О! Бұл керемет~
Dialogue: 0,0:21:10.85,0:21:12.56,Default,,0,0,0,,Не, мұнда бірінші рет келіп тұрсың ба?
Dialogue: 0,0:21:13.48,0:21:15.94,Default,,0,0,0,,Мен сол күшке байланысты әскерге түсе алмадым.
Dialogue: 0,0:21:19.02,0:21:20.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:20.65,0:21:22.61,Default,,0,0,0,,Бұл Gear негізі!
Dialogue: 0,0:21:22.73,0:21:25.65,Default,,0,0,0,,Мен басқа әлемге келгендей болдым!
Dialogue: 0,0:21:28.20,0:21:30.83,Default,,0,0,0,,Уау, тамаша!
Dialogue: 0,0:21:30.95,0:21:32.87,Default,,0,0,0,,Иә? Тері дүкені?
Dialogue: 0,0:21:33.41,0:21:35.12,Default,,0,0,0,,Бұл не? бұл?
Dialogue: 0,0:21:35.25,0:21:37.87,Default,,0,0,0,,Ах! Сәл күте тұрыңыз!
Dialogue: 0,0:21:39.13,0:21:40.88,Default,,0,0,0,,Әлемге қателер қажет болмаса
Dialogue: 0,0:21:41.55,0:21:44.21,Default,,0,0,0,,Оны өшіру керек
Dialogue: 0,0:21:46.51,0:21:48.64,Default,,0,0,0,,Әлемге қателер қажет болмаса
Dialogue: 0,0:21:49.51,0:21:52.47,Default,,0,0,0,,Ол түкке тұрғысыз болады
Dialogue: 0,0:21:53.97,0:21:55.60,Default,,0,0,0,,Бірақ сол кезде
Dialogue: 0,0:21:56.56,0:21:59.15,Default,,0,0,0,,Мен... әрине...
Dialogue: 0,0:22:01.02,0:22:02.73,Default,,0,0,0,,Мен құтқарылдым.
Dialogue: 0,0:22:11.03,0:22:16.04,Default,,0,0,0,,♪~
Dialogue: 0,0:23:35.91,0:23:40.91,Default,,0,0,0,,~♪
Dialogue: 0,0:23:42.41,0:23:48.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory