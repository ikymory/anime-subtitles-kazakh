Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.37,0:00:04.42,Default,,0,0,0,,Куб Сіз дайынсыз ба?
Dialogue: 0,0:00:10.42,0:00:13.68,Default,,0,0,0,,Декаденс іске қосылды!
Dialogue: 0,0:00:16.47,0:00:17.43,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:17.72,0:00:19.18,Default,,0,0,0,,Неліктен ол басталмайды?
Dialogue: 0,0:00:19.64,0:00:21.10,Default,,0,0,0,,Бұйрық! Ха!
Dialogue: 0,0:00:21.22,0:00:22.39,Default,,0,0,0,,Негізгі денеде қауіпті
Dialogue: 0,0:00:22.52,0:00:23.69,Default,,0,0,0,,Мен жақында қайтамын...
Dialogue: 0,0:00:23.85,0:00:24.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:26.56,0:00:28.23,Default,,0,0,0,,Жерде не...
Dialogue: 0,0:00:29.07,0:00:31.48,Default,,0,0,0,,Денеңіз ретінде декаденспен кіресіз бе?
Dialogue: 0,0:00:31.61,0:00:33.45,Default,,0,0,0,,Қосылым аяқталды
Dialogue: 0,0:00:33.57,0:00:34.53,Default,,0,0,0,,Бір түнде, 452 адамнан тұратын тұрғындардың арасынан—
Dialogue: 0,0:00:34.90,0:00:36.82,Default,,0,0,0,,Бірақ мен оны бастай алмаймын.
Dialogue: 0,0:00:36.95,0:00:38.32,Default,,0,0,0,,Ағымдағы жағдайды түсінуді сұраңыз
Dialogue: 0,0:00:38.45,0:00:40.29,Default,,0,0,0,,Біз әлі де бірдеңе істей аламыз.
Dialogue: 0,0:00:40.62,0:00:41.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:41.66,0:00:42.79,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:00:43.37,0:00:45.29,Default,,0,0,0,,Эй, қарашы (Киборг) Мынау ақылсыз!
Dialogue: 0,0:00:45.87,0:00:47.67,Default,,0,0,0,,Декаденс, қозғалма
Dialogue: 0,0:00:47.79,0:00:48.79,Default,,0,0,0,,Неге...
Dialogue: 0,0:00:49.13,0:00:52.17,Default,,0,0,0,,Қосылым сәтті болған сияқты.
Dialogue: 0,0:00:52.30,0:00:54.55,Default,,0,0,0,,Қалғаны Кабураги-санға қалды.
Dialogue: 0,0:00:54.67,0:00:56.89,Default,,0,0,0,,Иә! байланыс?
Dialogue: 0,0:00:57.01,0:00:58.55,Default,,0,0,0,,Бастыққа не болды?
Dialogue: 0,0:00:58.76,0:01:00.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:00.31,0:01:01.31,Default,,0,0,0,,Бұл бастық
Dialogue: 0,0:01:01.85,0:01:03.81,Default,,0,0,0,,Иә? тістері?
Dialogue: 0,0:01:04.14,0:01:04.93,Default,,0,0,0,,Кабураги мырза
Dialogue: 0,0:01:05.06,0:01:07.06,Default,,0,0,0,,Мен Декаденциямен байланыстырдым.
Dialogue: 0,0:01:07.19,0:01:09.44,Default,,0,0,0,,Басқаша айтқанда, сіз айтқан бастық...
Dialogue: 0,0:01:09.56,0:01:11.32,Default,,0,0,0,,Енді бұл
Dialogue: 0,0:01:18.91,0:01:20.08,Default,,0,0,0,,…Елшілік шын мәнінде шетелде орналасқанын білесіз ғой.
Dialogue: 0,0:01:20.70,0:01:23.58,Default,,0,0,0,,Deca-Dance қазір Cub Dance деп аталады.
Dialogue: 0,0:01:23.75,0:01:24.79,Default,,0,0,0,,Гяхахаха! (Киборг) Иә!
Dialogue: 0,0:01:24.91,0:01:26.92,Default,,0,0,0,,Керемет, Джилл.
Dialogue: 0,0:01:27.08,0:01:28.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:28.37,0:01:29.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:30.50,0:01:34.01,Default,,0,0,0,,Бар, менің бір ісім бар.
Dialogue: 0,0:01:35.38,0:01:38.09,Default,,0,0,0,,Бастық әрқашан осылай, солай ма?
Dialogue: 0,0:01:38.22,0:01:38.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:40.01,0:01:42.97,Default,,0,0,0,,Бұл не қажет болса да істеуге жеткілікті өзімшіл.
Dialogue: 0,0:01:43.39,0:01:44.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:44.56,0:01:46.68,Default,,0,0,0,,Бірақ біз қалай күресеміз?
Dialogue: 0,0:01:46.81,0:01:48.48,Default,,0,0,0,,Ол әлдеқашан тозған, солай емес пе?
Dialogue: 0,0:01:48.60,0:01:49.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:49.85,0:01:51.98,Default,,0,0,0,,Иә, қару жасайық.
Dialogue: 0,0:01:52.11,0:01:52.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:52.98,0:01:54.69,Default,,0,0,0,,«Балапан биі» қаруы
Dialogue: 0,0:01:54.82,0:01:57.24,Default,,0,0,0,,Мұны бастық қуаттандырды.
Dialogue: 0,0:01:57.45,0:01:59.45,Default,,0,0,0,,«Бұл сіздің қаруыңыз».
Dialogue: 0,0:01:59.57,0:02:01.24,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:02:01.37,0:02:02.91,Default,,0,0,0,,Таразылар тым әртүрлі
Dialogue: 0,0:02:03.20,0:02:05.29,Default,,0,0,0,,Бастық та былай деді:
Dialogue: 0,0:02:05.41,0:02:08.29,Default,,0,0,0,,«Бөлшектерді қажетінше өзгертуге болады»
Dialogue: 0,0:02:08.71,0:02:11.17,Default,,0,0,0,,Сонымен бөлшектер...
Dialogue: 0,0:02:11.71,0:02:13.38,Default,,0,0,0,,Осыны айтып тұрсың ба?
Dialogue: 0,0:02:14.05,0:02:14.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:15.26,0:02:16.42,Default,,0,0,0,,Не? (Кайборг) Не істеп жатырсың?
Dialogue: 0,0:02:16.55,0:02:17.88,Default,,0,0,0,,Түсіндіңіз бе? (Киборг) Мен түсінбеймін.
Dialogue: 0,0:02:18.93,0:02:21.14,Default,,0,0,0,,Ескі бөлшектерді пайдалансаңыз...
Dialogue: 0,0:02:21.55,0:02:24.68,Default,,0,0,0,,Осылайша... Жоқ, жоқ, бірақ қалай...
Dialogue: 0,0:02:24.81,0:02:26.89,Default,,0,0,0,,Түсіндім, егер сіз аймақтарды пайдалансаңыз...
Dialogue: 0,0:02:30.40,0:02:31.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:31.94,0:02:32.90,Default,,0,0,0,,Джил мырза?
Dialogue: 0,0:02:33.31,0:02:36.07,Default,,0,0,0,,Негізсіз тілек...
Dialogue: 0,0:02:36.19,0:02:37.90,Default,,0,0,0,,Олай емес сияқты.
Dialogue: 0,0:02:38.07,0:02:40.57,Default,,0,0,0,,Тек бір рет шектеу.
Dialogue: 0,0:02:41.03,0:02:42.78,Default,,0,0,0,,Бастыққа сеніңіз!
Dialogue: 0,0:02:42.91,0:02:43.91,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:44.24,0:02:45.74,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:02:45.87,0:02:46.70,Default,,0,0,0,,Сонымен не істеп жатырсың?
Dialogue: 0,0:02:46.83,0:02:47.91,Default,,0,0,0,,Мен білемін бе?
Dialogue: 0,0:02:50.00,0:02:52.17,Default,,0,0,0,,Хмм... жағдай қалай?
Dialogue: 0,0:02:52.38,0:02:54.38,Default,,0,0,0,,Қайта жүктеу кезеңі аяқталды
Dialogue: 0,0:02:54.50,0:02:56.05,Default,,0,0,0,,Мен себебін білмеймін
Dialogue: 0,0:02:56.17,0:02:57.46,Default,,0,0,0,,Операциялық жүйедегі шу
Dialogue: 0,0:02:57.59,0:03:00.68,Default,,0,0,0,,Жүйе тарапынан кейбір кедергілер болуы мүмкін.
Dialogue: 0,0:03:00.80,0:03:02.26,Default,,0,0,0,,Цк, ақыр соңында?
Dialogue: 0,0:03:02.39,0:03:03.22,Default,,0,0,0,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,0:03:03.76,0:03:06.06,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:03:06.22,0:03:07.89,Default,,0,0,0,,Сіз тек сене аласыз және күте аласыз.
Dialogue: 0,0:03:08.02,0:03:09.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:09.52,0:03:12.60,Default,,0,0,0,,Бұрынғы қолбасшы ынтымақтастықты сұрайды
Dialogue: 0,0:03:12.94,0:03:13.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:16.40,0:03:18.48,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:18.82,0:03:20.32,Default,,0,0,0,,Сіз оны ақырында тазаладыңыз ба?
Dialogue: 0,0:03:20.45,0:03:21.36,Default,,0,0,0,,және бұл балалар арасында кемсітушілік пен қорлауға әкеліп соғатын сияқты.
Dialogue: 0,0:03:21.70,0:03:23.53,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:03:23.66,0:03:24.62,Default,,0,0,0,,Өтірікші (Исаам)...
Dialogue: 0,0:03:24.74,0:03:25.74,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:26.41,0:03:28.87,Default,,0,0,0,,Балалар, бұл соңғы тапсырма.
Dialogue: 0,0:03:29.29,0:03:30.87,Default,,0,0,0,,Не? (Иссам) Миссия?
Dialogue: 0,0:03:31.54,0:03:33.00,Default,,0,0,0,,Барлық жерде шашыраңқы -
Dialogue: 0,0:03:33.12,0:03:35.71,Default,,0,0,0,,Бұрынғы Декаденс бөліктеріне оксонды қосу
Dialogue: 0,0:03:36.42,0:03:38.71,Default,,0,0,0,,Сенің маған өмір бергеніңді қалаймын.
Dialogue: 0,0:03:39.09,0:03:41.72,Default,,0,0,0,,Бұл тозудың қаруы.
Dialogue: 0,0:03:42.18,0:03:45.85,Default,,0,0,0,,Сізде бір ғана мүмкіндік бар, бірақ мен сізді міндетті түрде жеңемін.
Dialogue: 0,0:03:46.64,0:03:47.85,Default,,0,0,0,,Мен сізден өтіндім, мырзалар.
Dialogue: 0,0:03:49.18,0:03:51.85,Default,,0,0,0,,Декаденстің болашағы үшін
Dialogue: 0,0:03:52.14,0:03:54.19,Default,,0,0,0,,Мен қатты тұрып қалдым.
Dialogue: 0,0:03:54.31,0:03:55.36,Default,,0,0,0,,Қашан жоғалды?
Dialogue: 0,0:03:55.69,0:03:56.81,Default,,0,0,0,,Бар, жүр, жүр!
Dialogue: 0,0:03:56.94,0:03:57.86,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:03:58.57,0:04:00.11,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:04:00.24,0:04:00.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:01.11,0:04:02.49,Default,,0,0,0,,Барлығы бірден қайда кетті?
Dialogue: 0,0:04:02.82,0:04:04.99,Default,,0,0,0,,Уууу!
Dialogue: 0,0:04:05.28,0:04:07.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:07.24,0:04:09.12,Default,,0,0,0,,Сәлем әпке!
Dialogue: 0,0:04:10.41,0:04:12.37,Default,,0,0,0,,Келіңіз, бізге де көмектесіңіз.
Dialogue: 0,0:04:12.79,0:04:14.12,Default,,0,0,0,,Көмектесу дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:15.58,0:04:17.17,Default,,0,0,0,,Миссия
Dialogue: 0,0:04:18.46,0:04:19.46,Default,,0,0,0,,Эй, сен мұны естідің бе?
Dialogue: 0,0:04:19.59,0:04:21.55,Default,,0,0,0,,Decadence өз қызметін тоқтататын сияқты ма?
Dialogue: 0,0:04:21.67,0:04:23.26,Default,,0,0,0,,Соңғы тапсырма аяқталды.
Dialogue: 0,0:04:23.38,0:04:25.13,Default,,0,0,0,,Жоқ, мен кіріп жатырмын!
Dialogue: 0,0:04:25.26,0:04:26.22,Default,,0,0,0,,Мен де (Киборг) Мен де
Dialogue: 0,0:04:26.34,0:04:27.14,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:04:27.26,0:04:28.64,Default,,0,0,0,,Көпіршікті көпіршік көпіршік...
Dialogue: 0,0:04:30.68,0:04:33.23,Default,,0,0,0,,Иә! Бұл не? Бұл не?
Dialogue: 0,0:04:33.35,0:04:35.60,Default,,0,0,0,,Мен кіруді тоқтата алмаймын!
Dialogue: 0,0:04:36.02,0:04:36.94,Default,,0,0,0,,Шу!
Dialogue: 0,0:04:37.06,0:04:38.61,Default,,0,0,0,,Мына жігіттер (Салли) қандай қауіпті? Біз не істеуіміз керек?
Dialogue: 0,0:04:38.73,0:04:40.32,Default,,0,0,0,,Қызмет тоқтатылды, солай ма? (Салли) О, не істеуіміз керек?
Dialogue: 0,0:04:40.44,0:04:43.07,Default,,0,0,0,,Бірақ мен сенің сезіміңді білемін~ (Сони) Ааа!
Dialogue: 0,0:04:43.19,0:04:48.20,Default,,0,0,0,,♪~
Dialogue: 0,0:05:09.14,0:05:14.14,Default,,0,0,0,,~♪
Dialogue: 0,0:05:15.44,0:05:18.52,Default,,0,0,0,,Иә, солай болды.
Dialogue: 0,0:05:19.48,0:05:23.57,Default,,0,0,0,,Қандай қызықсыз тапсырма.
Dialogue: 0,0:05:24.11,0:05:25.57,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:05:26.20,0:05:29.45,Default,,0,0,0,,Оның қарсыласы мен!
Dialogue: 0,0:05:31.87,0:05:33.87,Default,,0,0,0,,Келесі бөлім...
Dialogue: 0,0:05:34.00,0:05:35.83,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:05:35.96,0:05:37.71,Default,,0,0,0,,Бұл күтпеген жерден жылдам.
Dialogue: 0,0:05:38.25,0:05:41.71,Default,,0,0,0,,Барлық белсенді емес ойыншылар жүйеге кіріп жатқан сияқты.
Dialogue: 0,0:05:42.67,0:05:43.71,Default,,0,0,0,,... иә?
Dialogue: 0,0:05:43.88,0:05:45.13,Default,,0,0,0,,Yahoo (cyborg) достары
Dialogue: 0,0:05:45.26,0:05:47.47,Default,,0,0,0,,Бұл соңғы (киборг) партия.
Dialogue: 0,0:05:48.13,0:05:49.47,Default,,0,0,0,,Бұл жұмыс істейтін сияқты
Dialogue: 0,0:05:49.80,0:05:53.10,Default,,0,0,0,,Кабураги мырза оны іске қоса алмаса, бұл мүлдем мағынасыз.
Dialogue: 0,0:05:53.22,0:05:56.23,Default,,0,0,0,,Кеңістіктің өзі жоғалады.
Dialogue: 0,0:05:56.35,0:05:57.85,Default,,0,0,0,,Кеңістіктің өзі?
Dialogue: 0,0:05:58.31,0:06:00.77,Default,,0,0,0,,Иә, гадоллдың бәрі.
Dialogue: 0,0:06:00.90,0:06:03.86,Default,,0,0,0,,Уақытымыз аз қалды.
Dialogue: 0,0:06:04.40,0:06:06.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:06.40,0:06:08.74,Default,,0,0,0,,Неліктен бастық бастамайды?
Dialogue: 0,0:06:09.07,0:06:10.45,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:10.57,0:06:14.54,Default,,0,0,0,,Өйткені, бұрын ешқашан Декаденспен байланысты ештеңе болған емес.
Dialogue: 0,0:06:15.91,0:06:17.41,Default,,0,0,0,,Бастық...
Dialogue: 0,0:06:19.17,0:06:20.04,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:06:20.46,0:06:22.54,Default,,0,0,0,,Гах! (Киборгтар) Уау!
Dialogue: 0,0:06:22.67,0:06:26.09,Default,,0,0,0,,(киборгтардың айқайы)
Dialogue: 0,0:06:26.21,0:06:28.05,Default,,0,0,0,,Ei (Cyborg) О...
Dialogue: 0,0:06:28.17,0:06:29.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:29.30,0:06:30.26,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:06:30.38,0:06:31.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:36.93,0:06:37.77,Default,,0,0,0,,Не?
Dialogue: 0,0:06:37.89,0:06:39.02,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:06:40.44,0:06:43.02,Default,,0,0,0,,Поо... Ахахха!
Dialogue: 0,0:06:44.27,0:06:47.74,Default,,0,0,0,,Кабураги мырзамен жақсы төбелесіп жатырсыз.
Dialogue: 0,0:06:52.91,0:06:55.20,Default,,0,0,0,,Эй (Киборг) Ол қозғала бастады.
Dialogue: 0,0:06:55.33,0:06:58.16,Default,,0,0,0,,Ал, сен ояусың.
Dialogue: 0,0:07:05.25,0:07:06.13,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:07:06.80,0:07:08.88,Default,,0,0,0,,Декаденс күмбезінің сыртында
Dialogue: 0,0:07:09.55,0:07:13.14,Default,,0,0,0,,Бұл бір кездері ақымақ адамдар өмір сүрген қаланың видеосы.
Dialogue: 0,0:07:13.68,0:07:17.06,Default,,0,0,0,,Барлық тіршілік иелері өмір сүре алмайтын жерде
Dialogue: 0,0:07:17.18,0:07:19.43,Default,,0,0,0,,Бұл менің де туған жерім
Dialogue: 0,0:07:19.56,0:07:20.39,Default,,0,0,0,,Не?
Dialogue: 0,0:07:23.06,0:07:25.77,Default,,0,0,0,,Осы ақымақ тарихты қайталамау үшін
Dialogue: 0,0:07:25.90,0:07:28.23,Default,,0,0,0,,Мен жасалдым
Dialogue: 0,0:07:31.49,0:07:34.66,Default,,0,0,0,,Толық басқарудың тәуелсіз жүйесі.
Dialogue: 0,0:07:35.16,0:07:36.62,Default,,0,0,0,,Сіз жүйе болдыңыз ба?
Dialogue: 0,0:07:37.08,0:07:38.29,Default,,0,0,0,,Хугин Мунин
Dialogue: 0,0:07:38.41,0:07:41.41,Default,,0,0,0,,Жүйенің қызмет ету мерзімін жүзеге асыратын аяқ киім
Dialogue: 0,0:07:41.54,0:07:44.13,Default,,0,0,0,,Жүйенің өзінде ешқандай субстанция жоқ.
Dialogue: 0,0:07:44.71,0:07:45.63,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:07:45.75,0:07:48.17,Default,,0,0,0,,Неліктен бекер күресеміз?
Dialogue: 0,0:07:48.30,0:07:51.26,Default,,0,0,0,,Гадоллды декаденспен жеңу мүмкін емес.
Dialogue: 0,0:07:51.38,0:07:53.13,Default,,0,0,0,,Сіз мұны да білесіз бе?
Dialogue: 0,0:07:54.22,0:07:56.60,Default,,0,0,0,,Бұл мен бас тартпаймын деген сөз емес.
Dialogue: 0,0:07:56.72,0:07:58.64,Default,,0,0,0,,Маған Decadence бақылауын беріңіз.
Dialogue: 0,0:08:03.35,0:08:05.86,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:08:06.36,0:08:07.77,Default,,0,0,0,,Сіз мені қате деп мазалайсыз ба?
Dialogue: 0,0:08:08.36,0:08:10.15,Default,,0,0,0,,Жүйенің шын мағынасында
Dialogue: 0,0:08:10.28,0:08:12.57,Default,,0,0,0,,Қателердің бар екені расталды.
Dialogue: 0,0:08:12.70,0:08:13.53,Default,,0,0,0,,Не?
Dialogue: 0,0:08:13.74,0:08:15.87,Default,,0,0,0,,Қателерді жою әрекеті
Dialogue: 0,0:08:15.99,0:08:17.66,Default,,0,0,0,,Оған қарсы болғандар
Dialogue: 0,0:08:17.78,0:08:21.79,Default,,0,0,0,,Екі жақтың әрекетінің өзі жүйенің бір бөлігі.
Dialogue: 0,0:08:21.91,0:08:23.66,Default,,0,0,0,,және әрекеттің салдары
Dialogue: 0,0:08:23.92,0:08:26.92,Default,,0,0,0,,Күшті жүйе құрылды
Dialogue: 0,0:08:27.88,0:08:30.80,Default,,0,0,0,,Жүйелер деректерді әмбебап сақтайды.
Dialogue: 0,0:08:30.92,0:08:33.92,Default,,0,0,0,,Өзгеріс уақыты келгенде, ол жаңартылады.
Dialogue: 0,0:08:34.63,0:08:36.93,Default,,0,0,0,,Бұл бірнеше рет жасалды
Dialogue: 0,0:08:37.64,0:08:40.93,Default,,0,0,0,,Қазіргі уақытта болып жатқан оқиғалар жүйеге арналған
Dialogue: 0,0:08:41.06,0:08:44.35,Default,,0,0,0,,Үлкен ағынның бір бөлігі ғана
Dialogue: 0,0:08:44.52,0:08:48.19,Default,,0,0,0,,Қазір әлем үлкен өзгерістер уақытын күтіп тұр.
Dialogue: 0,0:08:48.65,0:08:51.19,Default,,0,0,0,,Сіз күресуге тырысатын әрекеттер
Dialogue: 0,0:08:51.57,0:08:53.78,Default,,0,0,0,,Жүйенің бір бөлігі ғана
Dialogue: 0,0:08:53.90,0:08:55.40,Default,,0,0,0,,Қанша күрессең де
Dialogue: 0,0:08:55.53,0:08:58.70,Default,,0,0,0,,Біз бұл үлкен трендті өзгерте алмаймыз.
Dialogue: 0,0:09:00.28,0:09:02.95,Default,,0,0,0,,Өзгеремін деп қорқасыз ба?
Dialogue: 0,0:09:03.12,0:09:03.96,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:04.25,0:09:07.58,Default,,0,0,0,,Мен өз еркіммен ғана күресемін.
Dialogue: 0,0:09:07.79,0:09:09.84,Default,,0,0,0,,Жүйенің ыңғайлылығы маңызды емес.
Dialogue: 0,0:09:10.29,0:09:12.59,Default,,0,0,0,,Бастық! Сіз мені естисіз, солай ма?
Dialogue: 0,0:09:12.84,0:09:16.09,Default,,0,0,0,,Сіз осындай сәтте бас тартасыз ба? Бастық!
Dialogue: 0,0:09:16.88,0:09:19.80,Default,,0,0,0,,Мені құтқарған Нацумэ есімді адам
Dialogue: 0,0:09:19.93,0:09:21.60,Default,,0,0,0,,Ол сондай жігіт.
Dialogue: 0,0:09:21.89,0:09:24.10,Default,,0,0,0,,Жүйе ешкімді құтқармайды
Dialogue: 0,0:09:24.56,0:09:25.56,Default,,0,0,0,,Тек...
Dialogue: 0,0:09:25.77,0:09:29.36,Default,,0,0,0,,Бұл жай ғана заттардың нәтижесіне қарай өзгеретін нәрсе.
Dialogue: 0,0:09:29.94,0:09:31.32,Default,,0,0,0,,Өмір сүру дегеніміз
Dialogue: 0,0:09:31.65,0:09:33.48,Default,,0,0,0,,Бастық!
Dialogue: 0,0:09:33.86,0:09:34.99,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:36.70,0:09:37.99,Default,,0,0,0,,Уф! (Оң қолдың сынған дыбысы)
Dialogue: 0,0:09:41.70,0:09:43.20,Default,,0,0,0,,Аузыңды жап, қара!
Dialogue: 0,0:09:43.58,0:09:44.58,Default,,0,0,0,,Хун
Dialogue: 0,0:09:45.50,0:09:47.21,Default,,0,0,0,,Қанша күрессем де
Dialogue: 0,0:09:47.33,0:09:48.58,Default,,0,0,0,,Сен өлесің
Dialogue: 0,0:09:48.71,0:09:53.05,Default,,0,0,0,,Дүниедегі өзгерістерді көре алмайтынымыз өкінішті.
Dialogue: 0,0:09:54.01,0:09:54.76,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:58.05,0:09:58.88,Default,,0,0,0,,Шу таза...
Dialogue: 0,0:09:59.39,0:10:02.14,Default,,0,0,0,,Commander Decadence қайтадан бақылауға алынды.
Dialogue: 0,0:10:06.27,0:10:07.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:08.44,0:10:10.65,Default,,0,0,0,,Қайырлы таң, бастық!
Dialogue: 0,0:10:12.15,0:10:14.69,Default,,0,0,0,,Шалғам Күтуден шаршадым.
Dialogue: 0,0:10:14.82,0:10:15.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:16.28,0:10:19.03,Default,,0,0,0,,Декаденс іске қосылды!
Dialogue: 0,0:10:23.62,0:10:25.83,Default,,0,0,0,,Декаденс іске қосылды!
Dialogue: 0,0:10:28.12,0:10:30.58,Default,,0,0,0,,Шақалақ Сіз жағдайды түсіне аласыз ба?
Dialogue: 0,0:10:30.75,0:10:33.13,Default,,0,0,0,,А, бірақ сәл күте тұрыңыз.
Dialogue: 0,0:10:33.25,0:10:35.25,Default,,0,0,0,,Тым көп ақпарат...
Dialogue: 0,0:10:35.84,0:10:37.26,Default,,0,0,0,,Картадағы нүктелерге қараңыз
Dialogue: 0,0:10:38.22,0:10:42.30,Default,,0,0,0,,Ескі бөліктерді қосып, оларды тануға мүмкіндік бересіз бе?
Dialogue: 0,0:10:42.43,0:10:44.26,Default,,0,0,0,,О, мен оны жинап алайыншы.
Dialogue: 0,0:10:44.60,0:10:45.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:45.72,0:10:47.52,Default,,0,0,0,,Алдымен аймақты кеңейтейік.
Dialogue: 0,0:10:47.85,0:10:50.02,Default,,0,0,0,,Жарайды, вампир гарпунын өрте!
Dialogue: 0,0:11:00.11,0:11:02.28,Default,,0,0,0,,Гадолл Омега аймағын кеңейту
Dialogue: 0,0:11:03.12,0:11:05.24,Default,,0,0,0,,Иә? Уа, уай, ау!
Dialogue: 0,0:11:05.83,0:11:08.41,Default,,0,0,0,,Декаденс Бөлшектерді жинаңыз!
Dialogue: 0,0:11:16.50,0:11:18.26,Default,,0,0,0,,Жалған жарық бағыттаушы талшық...
Dialogue: 0,0:11:18.38,0:11:20.05,Default,,0,0,0,,Тірі зат сияқты
Dialogue: 0,0:11:23.59,0:11:24.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:25.10,0:11:26.31,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:26.60,0:11:27.64,Default,,0,0,0,,Керемет! (Киборг) Бұл әдемі.
Dialogue: 0,0:11:27.77,0:11:29.10,Default,,0,0,0,,Хмм... сәл тар!
Dialogue: 0,0:11:39.32,0:11:40.07,Default,,0,0,0,,Не?
Dialogue: 0,0:11:40.19,0:11:40.95,Default,,0,0,0,,Ябба!
Dialogue: 0,0:11:41.07,0:11:42.57,Default,,0,0,0,,Керемет, жүр!
Dialogue: 0,0:11:44.95,0:11:47.54,Default,,0,0,0,,Бірінен соң бірі... Бөлшектер...
Dialogue: 0,0:11:47.66,0:11:48.58,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:11:49.54,0:11:50.79,Default,,0,0,0,,Бұл не? Мен байланғанмын.
Dialogue: 0,0:11:51.04,0:11:52.33,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:11:55.88,0:11:58.59,Default,,0,0,0,,Бұл декаденс пе?
Dialogue: 0,0:12:04.47,0:12:07.10,Default,,0,0,0,,Омега ішінде оксон энергиясының жоғары концентрациясы анықталды
Dialogue: 0,0:12:07.56,0:12:09.10,Default,,0,0,0,,Жоқ! Шалғам!
Dialogue: 0,0:12:09.39,0:12:11.93,Default,,0,0,0,,Ол қазірдің өзінде толық қуатта. Біз үлгере алмаймыз!
Dialogue: 0,0:12:15.27,0:12:16.23,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:16.36,0:12:17.69,Default,,0,0,0,,Тағы да
Dialogue: 0,0:12:18.02,0:12:19.98,Default,,0,0,0,,Қат! Осы уакытқа дейін?
Dialogue: 0,0:12:20.11,0:12:20.86,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:23.36,0:12:24.78,Default,,0,0,0,,Гах ха ха!
Dialogue: 0,0:12:25.61,0:12:26.62,Default,,0,0,0,,Донателло? не?
Dialogue: 0,0:12:26.91,0:12:29.62,Default,,0,0,0,,Жалқау болма, Балапан!
Dialogue: 0,0:12:30.24,0:12:32.29,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:12:32.41,0:12:35.12,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:12:35.29,0:12:37.13,Default,,0,0,0,,Хмм, не? Не?
Dialogue: 0,0:12:37.25,0:12:38.88,Default,,0,0,0,,Сіз не істемексіз? Сол жігіт
Dialogue: 0,0:12:39.04,0:12:40.25,Default,,0,0,0,,Уау! (Киборг) Босс!
Dialogue: 0,0:12:40.38,0:12:43.88,Default,,0,0,0,,Тек маңдай бөлігінің тізбегі бұзылған.
Dialogue: 0,0:12:46.89,0:12:48.64,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:12:53.93,0:12:55.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:57.65,0:12:59.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:59.15,0:13:00.44,Default,,0,0,0,,Жақсы! (Киборг) Неге?
Dialogue: 0,0:13:04.99,0:13:06.95,Default,,0,0,0,,Уау! Жүгіріп кету!
Dialogue: 0,0:13:07.20,0:13:08.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:09.28,0:13:10.20,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:11.54,0:13:13.00,Default,,0,0,0,,Омега тыныштығы
Dialogue: 0,0:13:13.12,0:13:16.21,Default,,0,0,0,,Ұстау бөліктері қосылым аяқталғанша 10% қалды
Dialogue: 0,0:13:16.67,0:13:19.21,Default,,0,0,0,,Жарайды, параллель ұшыруға дайындалайық.
Dialogue: 0,0:13:19.34,0:13:21.34,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:13:21.46,0:13:22.71,Default,,0,0,0,,Егер бізге шабуыл жасалса, онда
Dialogue: 0,0:13:23.09,0:13:24.67,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:13:24.80,0:13:26.72,Default,,0,0,0,,Өйткені, бастық ғажап
Dialogue: 0,0:13:26.93,0:13:30.93,Default,,0,0,0,,Барлығымыз Саркозидің ішімдігімен тост айтайық.
Dialogue: 0,0:13:31.35,0:13:32.56,Default,,0,0,0,,Апай?
Dialogue: 0,0:13:32.85,0:13:33.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:34.10,0:13:35.43,Default,,0,0,0,,Не? (Киборг) А...
Dialogue: 0,0:13:35.56,0:13:37.06,Default,,0,0,0,,Балалар, сендер не қарап тұрсыңдар?
Dialogue: 0,0:13:37.19,0:13:38.40,Default,,0,0,0,,Ннуну...
Dialogue: 0,0:13:38.52,0:13:39.69,Default,,0,0,0,,Ка-пе
Dialogue: 0,0:13:40.02,0:13:41.57,Default,,0,0,0,,А? Дұрыс па?
Dialogue: 0,0:13:41.69,0:13:43.11,Default,,0,0,0,,Шобо... (Киборг) Жоқ.
Dialogue: 0,0:13:43.23,0:13:44.28,Default,,0,0,0,,Пепе Пепе (Киборг) №
Dialogue: 0,0:13:44.40,0:13:45.15,Default,,0,0,0,,Жоқ! (Киборг) Мүмкін емес
Dialogue: 0,0:13:45.28,0:13:46.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:46.40,0:13:47.15,Default,,0,0,0,,Я...
Dialogue: 0,0:13:47.28,0:13:48.45,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:13:50.87,0:13:52.20,Default,,0,0,0,,Барлық бөлшектер бекітілген
Dialogue: 0,0:13:52.49,0:13:53.33,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:53.45,0:13:55.33,Default,,0,0,0,,Шалғам Мен сені шекке тартамын.
Dialogue: 0,0:13:55.45,0:13:56.21,Default,,0,0,0,,О
Dialogue: 0,0:13:56.75,0:13:58.42,Default,,0,0,0,,Декаденс зеңбіректерінің тұтануы
Dialogue: 0,0:14:05.71,0:14:07.93,Default,,0,0,0,,Омега әрекетті жалғастырады
Dialogue: 0,0:14:08.72,0:14:10.51,Default,,0,0,0,,Балапан Дайынсың ба?
Dialogue: 0,0:14:10.64,0:14:11.47,Default,,0,0,0,,О
Dialogue: 0,0:14:11.60,0:14:12.51,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:12.81,0:14:13.76,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:20.10,0:14:20.94,Default,,0,0,0,,Нацумэ!
Dialogue: 0,0:14:21.52,0:14:23.19,Default,,0,0,0,,Бұл не? (Оператор) Қосалқы бөлшектер.
Dialogue: 0,0:14:23.57,0:14:24.65,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:14:24.78,0:14:26.28,Default,,0,0,0,,Ол жерден тез кет!
Dialogue: 0,0:14:26.78,0:14:28.78,Default,,0,0,0,,Тұр!
Dialogue: 0,0:14:29.36,0:14:31.41,Default,,0,0,0,,Тұр! Тұр!
Dialogue: 0,0:14:31.53,0:14:33.28,Default,,0,0,0,,Оооххх!
Dialogue: 0,0:14:33.66,0:14:34.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:35.08,0:14:36.29,Default,,0,0,0,,Нацумэ!
Dialogue: 0,0:14:36.66,0:14:38.04,Default,,0,0,0,,Тым қобалжымаңыз
Dialogue: 0,0:14:38.41,0:14:39.54,Default,,0,0,0,,Күренай мырза
Dialogue: 0,0:14:39.67,0:14:42.00,Default,,0,0,0,,Мұндай затты өз бетіңізше алып жүру мүмкін емес!
Dialogue: 0,0:14:42.13,0:14:43.17,Default,,0,0,0,,Хмм! Ха!
Dialogue: 0,0:14:43.54,0:14:45.42,Default,,0,0,0,,Ауыр жүкті маған қалдыр!
Dialogue: 0,0:14:45.67,0:14:47.80,Default,,0,0,0,,Сіз ұрыс алаңын ұнатпаймын дедіңіз ғой, солай ма?
Dialogue: 0,0:14:47.92,0:14:49.72,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:14:50.05,0:14:51.64,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:14:53.85,0:14:55.68,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:56.56,0:14:58.89,Default,,0,0,0,,Бір нәрсені дұрыс істемеу
Dialogue: 0,0:14:59.06,0:15:00.19,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:02.19,0:15:03.19,Default,,0,0,0,,Су астында беткі қабаттан әрбір 10 метрге тереңдеген сайын—
Dialogue: 0,0:15:03.31,0:15:04.69,Default,,0,0,0,,Уау уау...
Dialogue: 0,0:15:04.82,0:15:06.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:07.78,0:15:09.95,Default,,0,0,0,,... декаденцияда?
Dialogue: 0,0:15:10.07,0:15:11.61,Default,,0,0,0,,Бастық...
Dialogue: 0,0:15:12.78,0:15:14.24,Default,,0,0,0,,Сол жерде қалмаңыз.
Dialogue: 0,0:15:16.08,0:15:18.20,Default,,0,0,0,,Decadence Іске қосуға дайын
Dialogue: 0,0:15:18.33,0:15:19.75,Default,,0,0,0,,Шалғам Енді ешқашан
Dialogue: 0,0:15:19.96,0:15:20.79,Default,,0,0,0,,Оны шешпеңіз
Dialogue: 0,0:15:20.92,0:15:21.75,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:15:22.12,0:15:24.63,Default,,0,0,0,,Кеңістікті сығу құрылғысының іске қосылуына 90 минут қалды
Dialogue: 0,0:15:27.09,0:15:28.38,Default,,0,0,0,,Мені ұр!
Dialogue: 0,0:15:31.88,0:15:36.89,Default,,0,0,0,,♪~
Dialogue: 0,0:15:37.14,0:15:39.10,Default,,0,0,0,,…
Dialogue: 0,0:15:39.81,0:15:41.27,Default,,0,0,0,,Өлмейтін? Сол жігіт
Dialogue: 0,0:15:41.39,0:15:42.56,Default,,0,0,0,,Шығаруды одан да арттырыңыз
Dialogue: 0,0:15:43.23,0:15:46.57,Default,,0,0,0,,Менің енді қолымнан келмейді... Оксон жетпейді.
Dialogue: 0,0:15:47.36,0:15:48.23,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:48.57,0:15:50.36,Default,,0,0,0,,Тәтті... Мм! (шу)
Dialogue: 0,0:15:56.53,0:15:57.99,Default,,0,0,0,,Ах (Киборг) Бұл қауіпті!
Dialogue: 0,0:15:58.12,0:15:59.24,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:15:59.54,0:16:01.83,Default,,0,0,0,,Декаденстің аяқталуына жол бермеңіз!
Dialogue: 0,0:16:01.96,0:16:02.75,Default,,0,0,0,,Жеңіліс!
Dialogue: 0,0:16:03.04,0:16:04.04,Default,,0,0,0,,Бұл жасырын.
Dialogue: 0,0:16:04.17,0:16:05.25,Default,,0,0,0,,Балапан биі...
Dialogue: 0,0:16:05.38,0:16:06.25,Default,,0,0,0,,Жоғалтып алмаңыз!
Dialogue: 0,0:16:06.50,0:16:08.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:08.50,0:16:10.26,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:14.09,0:16:15.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:15.93,0:16:17.22,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:19.14,0:16:22.39,Default,,0,0,0,,Бітті деме, берілме!
Dialogue: 0,0:16:23.02,0:16:26.77,Default,,0,0,0,,Мен күшейіп, «сол күшке» қосыламын!
Dialogue: 0,0:16:27.69,0:16:29.78,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:16:30.65,0:16:34.03,Default,,0,0,0,,Мен өзімді шектен шығарамын
Dialogue: 0,0:16:35.24,0:16:38.28,Default,,0,0,0,,Сондықтан мен бар күшімді салуым керек...
Dialogue: 0,0:16:38.58,0:16:42.04,Default,,0,0,0,,Маған көбірек көмектесу керек...
Dialogue: 0,0:16:42.25,0:16:43.41,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:44.04,0:16:47.54,Default,,0,0,0,,Мен білетін бастыққа сенемін деп шештім.
Dialogue: 0,0:17:01.43,0:17:06.44,Default,,0,0,0,,~♪
Dialogue: 0,0:17:11.53,0:17:13.28,Default,,0,0,0,,Декадентті шектегіштің шығарылуы
Dialogue: 0,0:17:13.44,0:17:14.28,Default,,0,0,0,,Шалғам!
Dialogue: 0,0:17:15.57,0:17:16.95,Default,,0,0,0,,Жүзбе…
Dialogue: 0,0:17:17.36,0:17:19.57,Default,,0,0,0,,Сіз шулысыз.
Dialogue: 0,0:17:19.78,0:17:21.33,Default,,0,0,0,,Мен сізге бұрын айтқанмын.
Dialogue: 0,0:17:24.25,0:17:29.29,Default,,0,0,0,,Мен бәрін құртамын!
Dialogue: 0,0:17:36.09,0:17:40.55,Default,,0,0,0,,Джуууууу...
Dialogue: 0,0:17:57.86,0:17:59.07,Default,,0,0,0,,Сооо...
Dialogue: 0,0:17:59.36,0:18:00.32,Default,,0,0,0,,Яба…
Dialogue: 0,0:18:00.45,0:18:02.28,Default,,0,0,0,,Мен жасадым... дұрыс па?
Dialogue: 0,0:18:02.41,0:18:04.37,Default,,0,0,0,,Аа, солай көрінеді...
Dialogue: 0,0:18:04.91,0:18:05.83,Default,,0,0,0,,Уау
Dialogue: 0,0:18:05.95,0:18:07.62,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:18:10.13,0:18:11.63,Default,,0,0,0,,О... мен жасадым.
Dialogue: 0,0:18:11.84,0:18:13.59,Default,,0,0,0,,Уау, сіз оны уақытында орындадыңыз!
Dialogue: 0,0:18:13.71,0:18:14.76,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:15.76,0:18:17.05,Default,,0,0,0,,Я...
Dialogue: 0,0:18:17.97,0:18:20.39,Default,,0,0,0,,Барлығы, жүйеден шығыңыз, құлайсыз.
Dialogue: 0,0:18:21.18,0:18:22.89,Default,,0,0,0,,Ол мұны істеді!
Dialogue: 0,0:18:23.01,0:18:24.39,Default,,0,0,0,,Балапан биі жеңеді
Dialogue: 0,0:18:24.52,0:18:25.81,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:25.93,0:18:26.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:27.02,0:18:28.81,Default,,0,0,0,,Баланың биі...
Dialogue: 0,0:18:32.77,0:18:36.19,Default,,0,0,0,,Қателер әлі де қызықты.
Dialogue: 0,0:18:36.57,0:18:37.61,Default,,0,0,0,,Жетті. Мен сені де, әпкеңді де өлтіремін.
Dialogue: 0,0:18:37.74,0:18:38.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:39.03,0:18:42.20,Default,,0,0,0,,Декаденс ыдырап жатыр...
Dialogue: 0,0:18:48.25,0:18:49.79,Default,,0,0,0,,Бастық…
Dialogue: 0,0:18:52.84,0:18:55.46,Default,,0,0,0,,Көріскенше Нацумэ
Dialogue: 0,0:19:03.72,0:19:07.14,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:07.27,0:19:08.60,Default,,0,0,0,,Мұнда? О
Dialogue: 0,0:19:08.73,0:19:10.23,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:19:10.56,0:19:11.77,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:19:12.65,0:19:13.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:14.31,0:19:15.98,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:18.49,0:19:20.57,Default,,0,0,0,,Бастық, кешіріңіз.
Dialogue: 0,0:19:20.82,0:19:24.28,Default,,0,0,0,,Менің жасаған оң қолым сынды.
Dialogue: 0,0:19:24.74,0:19:27.49,Default,,0,0,0,,Мен оны қазірден бастап өзім қалпына келтіремін.
Dialogue: 0,0:19:28.66,0:19:31.37,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:19:33.21,0:19:34.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:35.29,0:19:38.01,Default,,0,0,0,,(Шұғылдың құлау дыбысы)
Dialogue: 0,0:19:42.97,0:19:44.76,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:44.89,0:19:49.89,Default,,0,0,0,,♪~
Dialogue: 0,0:20:04.07,0:20:05.45,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:20:05.57,0:20:08.20,Default,,0,0,0,,О, сіз оны жақсы таптыңыз.
Dialogue: 0,0:20:08.33,0:20:11.21,Default,,0,0,0,,Ол шашыраңқы бөліктердің қоқыстарына көмілген.
Dialogue: 0,0:20:11.33,0:20:12.92,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:20:13.21,0:20:15.92,Default,,0,0,0,,Мен көп нәрсені сұрайтын адаммын.
Dialogue: 0,0:20:16.08,0:20:18.30,Default,,0,0,0,,Менен сұрамасаң да істеймін.
Dialogue: 0,0:20:18.42,0:20:22.13,Default,,0,0,0,,Қателер әрқашан менің зерттеуімнің тақырыбы болды.
Dialogue: 0,0:20:22.51,0:20:24.68,Default,,0,0,0,,Жоғарғы әкімші туралы не деуге болады?
Dialogue: 0,0:20:25.01,0:20:27.22,Default,,0,0,0,,Проблемалар көп.
Dialogue: 0,0:20:27.35,0:20:30.18,Default,,0,0,0,,Менің қолымнан көп нәрсе келмейді.
Dialogue: 0,0:20:30.31,0:20:34.14,Default,,0,0,0,,Біз жаңа жүйені егжей-тегжейлі жаңартамыз.
Dialogue: 0,0:20:34.27,0:20:36.02,Default,,0,0,0,,Мен бұл жұмысты сол екі адамға қалдырамын.
Dialogue: 0,0:20:36.02,0:20:37.61,Default,,0,0,0,,Ол жұмысты да сол екеуіне қалдырамын.
Dialogue: 0,0:20:36.02,0:20:37.61,Default,,0,0,0,,(Сонидің ашулы дауысы)
Dialogue: 0,0:20:37.61,0:20:37.69,Default,,0,0,0,,(Сонидің ашулы дауысы)
Dialogue: 0,0:20:37.94,0:20:39.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:39.36,0:20:40.69,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:20:41.40,0:20:42.82,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:20:43.32,0:20:46.45,Default,,0,0,0,,Міне, менің жинағаным осы ғана.
Dialogue: 0,0:20:46.91,0:20:47.78,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:47.91,0:20:49.70,Default,,0,0,0,,Әртүрлі үлгі деректер.
Dialogue: 0,0:20:50.12,0:20:52.08,Default,,0,0,0,,Гадолл боқының ингредиенттер тізімі.
Dialogue: 0,0:20:52.20,0:20:53.83,Default,,0,0,0,,Оксон ликерінің рецепті
Dialogue: 0,0:20:53.96,0:20:55.50,Default,,0,0,0,,Донателломен қалай әрекет ету керек
Dialogue: 0,0:20:55.62,0:20:57.46,Default,,0,0,0,,Джосукенің әкесіне —
Dialogue: 0,0:20:58.13,0:20:58.96,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:59.92,0:21:02.05,Default,,0,0,0,,А... Мен сенімдімін...
Dialogue: 0,0:21:02.88,0:21:06.09,Default,,0,0,0,,Сол кезде Кабураги-санды жаңартқанда.
Dialogue: 0,0:21:06.22,0:21:09.05,Default,,0,0,0,,Үлгі ретінде сақтық көшірме жасау…
Dialogue: 0,0:21:06.22,0:21:09.05,Default,,0,0,0,,~♪
Dialogue: 0,0:21:09.05,0:21:09.47,Default,,0,0,0,,~♪
Dialogue: 0,0:21:09.47,0:21:10.31,Default,,0,0,0,,~♪
Dialogue: 0,0:21:09.47,0:21:10.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:11.68,0:21:12.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:14.35,0:21:16.31,Default,,0,0,0,,Уау! (Кайборг) О, менің!
Dialogue: 0,0:21:16.69,0:21:19.02,Default,,0,0,0,,Дұрыс, дұрыс
Dialogue: 0,0:21:20.23,0:21:22.11,Default,,0,0,0,,Қайта туылған декаденция
Dialogue: 0,0:21:22.23,0:21:24.36,Default,,0,0,0,,Әртүрлі салаларға бөлінді.
Dialogue: 0,0:21:24.49,0:21:26.03,Default,,0,0,0,,Ойын-сауық кешені
Dialogue: 0,0:21:26.36,0:21:29.70,Default,,0,0,0,,Ферма аймағындағы сүйікті ауылшаруашылық құралдарын реттеңіз.
Dialogue: 0,0:21:30.28,0:21:31.29,Default,,0,0,0,,Танкермен
Dialogue: 0,0:21:31.41,0:21:33.91,Default,,0,0,0,,Егін көп өсірейік
Dialogue: 0,0:21:34.96,0:21:36.83,Default,,0,0,0,,Декаденстің өзегі жаңартылды.
Dialogue: 0,0:21:36.96,0:21:38.46,Default,,0,0,0,,Аттракцион аймағында
Dialogue: 0,0:21:38.67,0:21:42.05,Default,,0,0,0,,Үнемі өзгеретін салмақсыз негізгі допты тамашалаңыз
Dialogue: 0,0:21:42.17,0:21:43.59,Default,,0,0,0,,Жүр! О, менің!
Dialogue: 0,0:21:44.17,0:21:45.13,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:21:45.59,0:21:47.18,Default,,0,0,0,,Жасайық
Dialogue: 0,0:21:48.01,0:21:49.14,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:21:49.85,0:21:52.14,Default,,0,0,0,,Ұрысты ұмытуға болмайды.
Dialogue: 0,0:21:52.26,0:21:53.10,Default,,0,0,0,,Қан атқылау, ет секіру
Dialogue: 0,0:21:53.10,0:21:54.14,Default,,0,0,0,,Қан атқылап, ет секірді Хааа!
Dialogue: 0,0:21:54.60,0:21:55.68,Default,,0,0,0,,Ең керемет жекпе-жек!
Dialogue: 0,0:21:55.68,0:21:56.69,Default,,0,0,0,,Ең керемет жекпе-жек! (Көрермендер) Уууу!
Dialogue: 0,0:21:56.69,0:21:57.14,Default,,0,0,0,,Уууу!
Dialogue: 0,0:21:57.98,0:22:00.73,Default,,0,0,0,,Тоқтап, қараңызшы.
Dialogue: 0,0:22:01.11,0:22:03.28,Default,,0,0,0,,Эй, сен маған көмектесе аласың!
Dialogue: 0,0:22:03.40,0:22:04.23,Default,,0,0,0,,Аха…
Dialogue: 0,0:22:04.82,0:22:06.74,Default,,0,0,0,,Ғажайып Гадоль аймағында
Dialogue: 0,0:22:06.86,0:22:08.78,Default,,0,0,0,,Осы сүйкімді адамдармен қайта қауышу
Dialogue: 0,0:22:08.91,0:22:10.74,Default,,0,0,0,,Гадолмен қауіпсіз әрекеттесіңіз
Dialogue: 0,0:22:11.12,0:22:11.28,Default,,0,0,0,,Менің Гадорымды да көтеруге болады
Dialogue: 0,0:22:11.28,0:22:13.66,Default,,0,0,0,,Менің Гадоллымды да көтеруге болады
Dialogue: 0,0:22:11.28,0:22:13.66,Default,,0,0,0,,Иә...
Dialogue: 0,0:22:13.79,0:22:14.95,Default,,0,0,0,,Эй, сен тағы да келдің бе?
Dialogue: 0,0:22:15.08,0:22:17.08,Default,,0,0,0,,Ах, Итата... Шашымды жеме.
Dialogue: 0,0:22:17.21,0:22:19.25,Default,,0,0,0,,Ахаха... сүйкімді
Dialogue: 0,0:22:19.58,0:22:21.79,Default,,0,0,0,,Тұрғын ауданның бұрынғы танк қаласы
Dialogue: 0,0:22:21.92,0:22:24.88,Default,,0,0,0,,Бірдей ерекшеліктерімен айтарлықтай жаңару
Dialogue: 0,0:22:25.01,0:22:27.01,Default,,0,0,0,,Сіз киборгтарды да, танкерлерді де тамашалай аласыз.
Dialogue: 0,0:22:27.13,0:22:29.47,Default,,0,0,0,,Жаңа қалаға қош келдіңіз
Dialogue: 0,0:22:30.97,0:22:34.22,Default,,0,0,0,,Басқа әрекеттердің қатарында
Dialogue: 0,0:22:34.35,0:22:38.02,Default,,0,0,0,,Ең танымал кен орнын барлау - ең жақсы жады
Dialogue: 0,0:22:38.14,0:22:38.89,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:46.61,0:22:48.40,Default,,0,0,0,,Біріншісі – сараймен байланысты адамдардың сеніміне ие болу.
Dialogue: 0,0:23:00.71,0:23:02.46,Default,,0,0,0,,Қош бол әпке
Dialogue: 0,0:23:02.58,0:23:04.42,Default,,0,0,0,,Көңілді болды. Жуықта көріскенше.
Dialogue: 0,0:23:04.75,0:23:08.26,Default,,0,0,0,,Иә, рахмет, қайта келіңіз.
Dialogue: 0,0:23:09.22,0:23:13.39,Default,,0,0,0,,Олай болса, бүгінгі қажырлы еңбектеріңізге рахмет.
Dialogue: 0,0:23:14.85,0:23:16.31,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:23:21.06,0:23:21.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:27.11,0:23:28.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:29.74,0:23:31.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:32.61,0:23:33.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:35.45,0:23:37.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:38.91,0:23:44.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory