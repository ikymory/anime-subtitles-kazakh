Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.43,0:00:11.56,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:00:11.68,0:00:14.35,Default,,0,0,0,,3 2 1
Dialogue: 0,0:00:25.86,0:00:29.32,Default,,0,0,0,,Бастық, бұл жер біртүрлі екен ғой.
Dialogue: 0,0:00:29.70,0:00:31.78,Default,,0,0,0,,Бұл Гадолдың ұясы емес...
Dialogue: 0,0:00:32.45,0:00:34.25,Default,,0,0,0,,Тіпті бұрынғы адам...
Dialogue: 0,0:00:34.37,0:00:35.75,Default,,0,0,0,,Жүзбе...
Dialogue: 0,0:00:36.54,0:00:38.50,Default,,0,0,0,,Бұл дүниенің бәрі...
Dialogue: 0,0:00:38.96,0:00:40.29,Default,,0,0,0,,Гадол да
Dialogue: 0,0:00:40.46,0:00:42.46,Default,,0,0,0,,Тіпті бұл дене
Dialogue: 0,0:00:44.34,0:00:46.26,Default,,0,0,0,,Бұл жалған
Dialogue: 0,0:00:47.72,0:00:48.80,Default,,0,0,0,,А...
Dialogue: 0,0:00:49.05,0:00:49.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:55.98,0:00:59.90,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:03.11,0:01:05.07,Default,,0,0,0,,Тыңда, Нацум...
Dialogue: 0,0:01:05.40,0:01:08.70,Default,,0,0,0,,Бұл жер сіз әлем деп ойлайсыз
Dialogue: 0,0:01:08.82,0:01:11.78,Default,,0,0,0,,Бұл біз киборгтар жасаған әлем.
Dialogue: 0,0:01:12.74,0:01:14.29,Default,,0,0,0,,Гадол осында жасалған
Dialogue: 0,0:01:15.83,0:01:18.58,Default,,0,0,0,,Декаденске шабуыл жасау үшін бағдарламаланған
Dialogue: 0,0:01:20.29,0:01:21.67,Default,,0,0,0,,Біз үшін бұл жер
Dialogue: 0,0:01:23.29,0:01:25.59,Default,,0,0,0,,Бұл Гадоллмен шайқастан ләззат алатын ойын ғана...
Dialogue: 0,0:01:25.71,0:01:27.09,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:27.51,0:01:28.72,Default,,0,0,0,,Нацум!
Dialogue: 0,0:01:28.97,0:01:30.93,Default,,0,0,0,,Сәлем! Сәлем Нацум!
Dialogue: 0,0:01:31.22,0:01:33.64,Default,,0,0,0,,Нацумэ! Мықты болыңыз! Эй...
Dialogue: 0,0:01:34.47,0:01:35.97,Default,,0,0,0,,Жүзбе…
Dialogue: 0,0:01:36.97,0:01:41.98,Default,,0,0,0,,♪~
Dialogue: 0,0:03:01.93,0:03:06.94,Default,,0,0,0,,~♪
Dialogue: 0,0:03:10.36,0:03:11.53,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:11.65,0:03:12.40,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:03:12.53,0:03:13.78,Default,,0,0,0,,Бәрібір қиын сияқты.
Dialogue: 0,0:03:13.90,0:03:14.70,Default,,0,0,0,,Яби
Dialogue: 0,0:03:14.95,0:03:16.37,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:03:16.49,0:03:18.20,Default,,0,0,0,,Бұл өте төтенше жағдай.
Dialogue: 0,0:03:18.49,0:03:19.54,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:19.66,0:03:21.91,Default,,0,0,0,,Неліктен «GGS» іске қосылды және оны жасады!
Dialogue: 0,0:03:22.08,0:03:23.66,Default,,0,0,0,,Міне... дәл осылай.
Dialogue: 0,0:03:23.79,0:03:26.04,Default,,0,0,0,,Decadence ішіндегі Гадоллдар жойылды!
Dialogue: 0,0:03:26.17,0:03:28.59,Default,,0,0,0,,Біз не істеуіміз керек? Біз не істеуіміз керек? Мен не істеуім керек...
Dialogue: 0,0:03:28.71,0:03:31.17,Default,,0,0,0,,Шулы! Менің ойымша, бұл ыстық!
Dialogue: 0,0:03:31.30,0:03:33.05,Default,,0,0,0,,Не істейсің... (Sony)!
Dialogue: 0,0:03:33.17,0:03:34.43,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:03:34.84,0:03:36.30,Default,,0,0,0,,Гадолл зауытына!
Dialogue: 0,0:03:36.43,0:03:37.55,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:03:37.80,0:03:41.10,Default,,0,0,0,,Қателік... бұл қателердің кесірінен...
Dialogue: 0,0:03:41.22,0:03:42.06,Default,,0,0,0,,Әй, әлі жоқ!
Dialogue: 0,0:03:42.85,0:03:44.73,Default,,0,0,0,,Деректерді тасымалдау аяқталды
Dialogue: 0,0:03:44.85,0:03:46.77,Default,,0,0,0,,Жарайды, жүйеден шығайық.
Dialogue: 0,0:03:46.90,0:03:47.98,Default,,0,0,0,,Бұл жігітпен не істеуіміз керек?
Dialogue: 0,0:03:47.98,0:03:48.73,Default,,0,0,0,,Бұл жігітпен не істеуіміз керек?
Dialogue: 0,0:03:47.98,0:03:48.73,Default,,0,0,0,,Ми Ми…
Dialogue: 0,0:03:48.73,0:03:48.86,Default,,0,0,0,,Ми Ми…
Dialogue: 0,0:03:48.86,0:03:50.40,Default,,0,0,0,,Mi Mi…
Dialogue: 0,0:03:48.86,0:03:50.40,Default,,0,0,0,,Қойшы мені, бәрібір өлемін
Dialogue: 0,0:03:50.40,0:03:51.19,Default,,0,0,0,,Қойшы мені, бәрібір өлемін
Dialogue: 0,0:03:51.32,0:03:52.48,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:53.19,0:03:54.57,Default,,0,0,0,,Не?
Dialogue: 0,0:03:55.07,0:03:57.16,Default,,0,0,0,,Мен Мен…
Dialogue: 0,0:03:57.32,0:03:58.91,Default,,0,0,0,,Мен! (Зауыт меңгерушісі) Айтпа, бейбақ.
Dialogue: 0,0:03:59.03,0:03:59.78,Default,,0,0,0,,Бакуго-кунға қарсы қандай жоспары барын сұрамақ едім.
Dialogue: 0,0:04:00.16,0:04:01.08,Default,,0,0,0,,Мен!
Dialogue: 0,0:04:01.20,0:04:02.66,Default,,0,0,0,,Кеттік! Мен...
Dialogue: 0,0:04:03.25,0:04:05.50,Default,,0,0,0,,Mi mi mi mi…
Dialogue: 0,0:04:09.13,0:04:11.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:11.46,0:04:14.63,Default,,0,0,0,,Цк...белгіге айналады.
Dialogue: 0,0:04:14.76,0:04:16.09,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:04:16.22,0:04:17.47,Default,,0,0,0,,Уау
Dialogue: 0,0:04:17.59,0:04:18.43,Default,,0,0,0,,Кя! (Зауыт басшысы) Не?
Dialogue: 0,0:04:18.59,0:04:20.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:21.31,0:04:23.18,Default,,0,0,0,,(лифт құлаған дыбыс)
Dialogue: 0,0:04:26.77,0:04:28.85,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:04:28.98,0:04:30.19,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:04:30.40,0:04:31.82,Default,,0,0,0,,Еріп жатыр ма?
Dialogue: 0,0:04:31.94,0:04:33.36,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 0,0:04:33.78,0:04:36.32,Default,,0,0,0,,Нацум, сен мұны істедің.
Dialogue: 0,0:04:36.61,0:04:38.61,Default,,0,0,0,,Мен өзім өлемін
Dialogue: 0,0:04:38.74,0:04:39.66,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:04:39.91,0:04:41.16,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:04:41.28,0:04:42.83,Default,,0,0,0,,Бұл қате, солай ма? Бұл...
Dialogue: 0,0:04:42.95,0:04:45.20,Default,,0,0,0,,Эй, әй, шын, бұл не?
Dialogue: 0,0:04:45.33,0:04:47.21,Default,,0,0,0,,Бұл мүлдем қате.
Dialogue: 0,0:04:47.71,0:04:48.54,Default,,0,0,0,,(Жүйелік дыбыс)
Dialogue: 0,0:04:48.67,0:04:50.46,Default,,0,0,0,,Қате коды 0440
Dialogue: 0,0:04:50.58,0:04:51.71,Default,,0,0,0,,Бұл орын алғандықтан
Dialogue: 0,0:04:51.92,0:04:54.80,Default,,0,0,0,,Қызметті уақытша тоқтату
Dialogue: 0,0:04:54.92,0:04:56.80,Default,,0,0,0,,Қалпына келтіруді күтіңіз
Dialogue: 0,0:04:57.34,0:05:00.26,Default,,0,0,0,,Бұл не? Бұл шатастырады.
Dialogue: 0,0:05:00.72,0:05:02.22,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:05:03.35,0:05:05.47,Default,,0,0,0,,Командир, не істеуіміз керек...
Dialogue: 0,0:05:06.14,0:05:08.27,Default,,0,0,0,,Күткіңіз келе ме?
Dialogue: 0,0:05:08.69,0:05:10.10,Default,,0,0,0,,Саана
Dialogue: 0,0:05:10.23,0:05:11.94,Default,,0,0,0,,Жүйені сұраңыз
Dialogue: 0,0:05:12.06,0:05:13.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:15.65,0:05:17.24,Default,,0,0,0,,(Сота) Жарайды. (Есіктің ашылып, жабылуының дыбысы)
Dialogue: 0,0:05:18.99,0:05:20.16,Default,,0,0,0,,Шалғам…
Dialogue: 0,0:05:21.24,0:05:23.70,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз...
Dialogue: 0,0:05:30.00,0:05:32.63,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:05:32.96,0:05:34.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:34.59,0:05:35.63,Default,,0,0,0,,Ия, жоқ!
Dialogue: 0,0:05:35.84,0:05:37.88,Default,,0,0,0,,(Кенет тежеу дыбысы)
Dialogue: 0,0:05:38.88,0:05:41.59,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:42.26,0:05:44.39,Default,,0,0,0,,Анау жара... Әй!
Dialogue: 0,0:05:44.81,0:05:47.64,Default,,0,0,0,,Бұл арман емес...
Dialogue: 0,0:05:49.77,0:05:52.06,Default,,0,0,0,,Біз армандамаймыз
Dialogue: 0,0:05:52.19,0:05:53.77,Default,,0,0,0,,Балалар сендерден басқаша
Dialogue: 0,0:05:55.15,0:05:57.90,Default,,0,0,0,,Мен бұл туралы бәріне тезірек айтуым керек...
Dialogue: 0,0:05:58.03,0:05:59.40,Default,,0,0,0,,Бұл ысырап, иә?
Dialogue: 0,0:05:59.78,0:06:04.03,Default,,0,0,0,,Бұл дүниенің ақиқаты сендерге тыйым салынған.
Dialogue: 0,0:06:04.53,0:06:08.66,Default,,0,0,0,,Ақиқатты білетін адамдар... Дүние қателікке шыдамайды.
Dialogue: 0,0:06:09.00,0:06:10.41,Default,,0,0,0,,Жарайды, алдымен осыны оқимын, бітірген соң екіншісін де оқимыз ба?
Dialogue: 0,0:06:10.58,0:06:12.37,Default,,0,0,0,,Сіз жалғыз ерекшеліксіз.
Dialogue: 0,0:06:12.50,0:06:13.38,Default,,0,0,0,,Ой, Құдай-ай, осы асыл кітаптарды былыққа қалдырып кеткенсіңдер…
Dialogue: 0,0:06:13.50,0:06:14.84,Default,,0,0,0,,Сіз бұл өтірік деп ойлайсыз ба?
Dialogue: 0,0:06:14.96,0:06:15.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:17.17,0:06:18.67,Default,,0,0,0,,Тіпті әкең де...
Dialogue: 0,0:06:18.88,0:06:20.22,Default,,0,0,0,,А...
Dialogue: 0,0:06:20.76,0:06:22.55,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:22.89,0:06:25.22,Default,,0,0,0,,Муро, дұрыс айтасың.
Dialogue: 0,0:06:25.35,0:06:28.31,Default,,0,0,0,,Ах... бұл дүние біртүрлі ғой.
Dialogue: 0,0:06:28.56,0:06:30.18,Default,,0,0,0,,Бір құпия бар...
Dialogue: 0,0:06:30.56,0:06:33.40,Default,,0,0,0,,Мықты бол, біз құлдырауға қайтамыз.
Dialogue: 0,0:06:33.77,0:06:36.65,Default,,0,0,0,,Нацуме әке, мен жақында қайтамын.
Dialogue: 0,0:06:37.11,0:06:38.11,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:06:44.16,0:06:47.37,Default,,0,0,0,,Мен бұл дүниенің шындығына тым жақындадым...
Dialogue: 0,0:06:48.49,0:06:49.66,Default,,0,0,0,,Сонымен
Dialogue: 0,0:06:50.00,0:06:51.96,Default,,0,0,0,,Қате ретінде өлтірілді
Dialogue: 0,0:06:56.79,0:06:58.42,Default,,0,0,0,,Бастық бұл...
Dialogue: 0,0:06:59.13,0:07:01.84,Default,,0,0,0,,Бұл сіз мұны білетінсіз.
Dialogue: 0,0:07:02.72,0:07:04.43,Default,,0,0,0,,Сондай-ақ Гадол туралы
Dialogue: 0,0:07:04.84,0:07:06.60,Default,,0,0,0,,Әлем туралы да
Dialogue: 0,0:07:07.05,0:07:08.64,Default,,0,0,0,,Әкем туралы да...
Dialogue: 0,0:07:10.02,0:07:11.35,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:07:12.02,0:07:13.94,Default,,0,0,0,,Сонымен сен мені алдадың.
Dialogue: 0,0:07:14.14,0:07:16.27,Default,,0,0,0,,Нацумэ... I
Dialogue: 0,0:07:21.82,0:07:23.11,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:23.40,0:07:25.66,Default,,0,0,0,,Мен әлемді өзгерткім келмеді
Dialogue: 0,0:07:26.37,0:07:28.66,Default,,0,0,0,,Мен өзімді сенімді сезінгім келді.
Dialogue: 0,0:07:29.54,0:07:34.33,Default,,0,0,0,,Егер мен көп тырысып, күшейсем, бәрі өзгеруі мүмкін.
Dialogue: 0,0:07:35.71,0:07:38.42,Default,,0,0,0,,Бірақ бұл ақымақ көрінеді...
Dialogue: 0,0:07:39.46,0:07:42.67,Default,,0,0,0,,Мен бұл туралы ештеңе білгім келмеді.
Dialogue: 0,0:07:42.80,0:07:43.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:43.97,0:07:46.14,Default,,0,0,0,,Мен ештеңе өзгермегеніне қуаныштымын
Dialogue: 0,0:07:48.55,0:07:50.01,Default,,0,0,0,,Сіз туралы...
Dialogue: 0,0:07:50.51,0:07:52.68,Default,,0,0,0,,Сенбесем ғой...
Dialogue: 0,0:07:55.77,0:07:57.10,Default,,0,0,0,,Мыау! Ах, Ферис, не болды?
Dialogue: 0,0:07:57.94,0:07:59.52,Default,,0,0,0,,(Йошимура) Коузен туралы сыбыстар кең тарала бастады—
Dialogue: 0,0:08:16.12,0:08:17.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:25.05,0:08:26.22,Default,,0,0,0,,Құбырлар…
Dialogue: 0,0:08:31.01,0:08:32.56,Default,,0,0,0,,Бұл жаман болды...
Dialogue: 0,0:09:06.59,0:09:08.68,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:09:08.80,0:09:10.30,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:09:10.43,0:09:13.35,Default,,0,0,0,,Іш, іш~ (цистерна) Бүгін барайық~
Dialogue: 0,0:09:15.06,0:09:17.98,Default,,0,0,0,,Гадолл жігіттерінің барлығы жоғалып кетті.
Dialogue: 0,0:09:18.10,0:09:19.90,Default,,0,0,0,,Ол шынымен жойылды ма?
Dialogue: 0,0:09:20.02,0:09:21.98,Default,,0,0,0,,Мәліметтерге алаңдамаңыз
Dialogue: 0,0:09:22.11,0:09:25.32,Default,,0,0,0,,Тісті доңғалақтар туралы айтатын болсақ, олар жауды іздегенде де ұсталмайтын сияқты.
Dialogue: 0,0:09:25.44,0:09:27.32,Default,,0,0,0,,Мүмкін мен сыртқа шығып өмір сүретін шығармын!
Dialogue: 0,0:09:27.44,0:09:29.78,Default,,0,0,0,,Сіз өзіңізге ұнайтын жерге бара аласыз және өзіңізге ұнайтын нәрсені жасай аласыз!
Dialogue: 0,0:09:29.91,0:09:30.86,Default,,0,0,0,,Бостандық!
Dialogue: 0,0:09:30.99,0:09:33.62,Default,,0,0,0,,Бостандық пен бейбітшілік құтты болсын!
Dialogue: 0,0:09:33.99,0:09:35.37,Default,,0,0,0,,Гахахаха!
Dialogue: 0,0:09:35.70,0:09:37.96,Default,,0,0,0,,Жарайды, тағы тост айтайық.
Dialogue: 0,0:09:39.41,0:09:40.37,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:40.83,0:09:43.63,Default,,0,0,0,,Нацюме, сен мұнда не істеп жүрсің?
Dialogue: 0,0:09:43.79,0:09:44.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:45.34,0:09:46.92,Default,,0,0,0,,Хмм? сурет?
Dialogue: 0,0:09:47.55,0:09:50.38,Default,,0,0,0,,А... Аман-есен келгеніңізге қуаныштымын, қош келдіңіз.
Dialogue: 0,0:09:50.51,0:09:51.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:51.39,0:09:53.10,Default,,0,0,0,,Мұнда кел, мұнда кел.
Dialogue: 0,0:09:54.72,0:09:56.68,Default,,0,0,0,,Ах! не болды?
Dialogue: 0,0:09:56.81,0:09:57.85,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:10:01.06,0:10:02.48,Default,,0,0,0,,Жүзбе…
Dialogue: 0,0:10:04.27,0:10:09.95,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:10:12.86,0:10:14.99,Default,,0,0,0,,Бұл сенің қалаған пішінің емес дегенмен бірдей.
Dialogue: 0,0:10:16.54,0:10:19.12,Default,,0,0,0,,Осы уақытқа дейін қандай мақсатта?
Dialogue: 0,0:10:19.25,0:10:21.08,Default,,0,0,0,,Сіз көп жұмыс істеген болуыңыз керек ...
Dialogue: 0,0:10:27.71,0:10:29.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:30.92,0:10:32.18,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:34.72,0:10:35.80,Default,,0,0,0,,(Жүйелік дыбыс)
Dialogue: 0,0:10:35.93,0:10:36.93,Default,,0,0,0,,Кабураги мырза
Dialogue: 0,0:10:37.06,0:10:39.14,Default,,0,0,0,,Онда қанша уақыт тұруды жоспарлайсыз?
Dialogue: 0,0:10:39.56,0:10:41.31,Default,,0,0,0,,Тезірек оралыңыз!
Dialogue: 0,0:10:41.44,0:10:42.52,Default,,0,0,0,,Ойын полициясы?
Dialogue: 0,0:10:42.77,0:10:44.94,Default,,0,0,0,,Иә, бұл күткеннен ертерек.
Dialogue: 0,0:10:45.06,0:10:48.53,Default,,0,0,0,,Жүйе маған тағы бір жою бұйрығын берген сияқты.
Dialogue: 0,0:10:48.98,0:10:50.40,Default,,0,0,0,,Тек асығыңыз!
Dialogue: 0,0:10:50.53,0:10:52.15,Default,,0,0,0,,Иә! Қарғыс атқыр...
Dialogue: 0,0:11:05.96,0:11:08.92,Default,,0,0,0,,Хмм, бұл қате.
Dialogue: 0,0:11:09.05,0:11:11.47,Default,,0,0,0,,ID іздеу босқа кеткен сияқты.
Dialogue: 0,0:11:11.59,0:11:14.59,Default,,0,0,0,,Тісті беріліс бейнесін де пайдалана алмайсыз.
Dialogue: 0,0:11:14.72,0:11:15.64,Default,,0,0,0,,Қазір...
Dialogue: 0,0:11:15.97,0:11:17.39,Default,,0,0,0,,Гуе~
Dialogue: 0,0:11:18.43,0:11:19.72,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:11:19.85,0:11:22.14,Default,,0,0,0,,Сол жоспармен жүрейік.
Dialogue: 0,0:11:36.20,0:11:37.74,Default,,0,0,0,,Кю~
Dialogue: 0,0:11:38.28,0:11:40.45,Default,,0,0,0,,Кю~ Кю~
Dialogue: 0,0:11:41.37,0:11:43.46,Default,,0,0,0,,(шатырлардың соғу дыбысы)
Dialogue: 0,0:11:57.59,0:11:58.93,Default,,0,0,0,,Жүзбе
Dialogue: 0,0:11:59.93,0:12:01.26,Default,,0,0,0,,Күренай мырза...
Dialogue: 0,0:12:01.39,0:12:02.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:04.94,0:12:06.81,Default,,0,0,0,,Олай емес сияқты.
Dialogue: 0,0:12:10.73,0:12:12.11,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:12.65,0:12:14.86,Default,,0,0,0,,Мен неге сенуім керек?
Dialogue: 0,0:12:15.36,0:12:18.57,Default,,0,0,0,,Мен көп нәрсені көріп, өзгердім...
Dialogue: 0,0:12:18.70,0:12:20.53,Default,,0,0,0,,Еркін өмір сүру...
Dialogue: 0,0:12:20.99,0:12:22.66,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,0:12:23.29,0:12:26.54,Default,,0,0,0,,Бірақ мен енді ештеңе білгім келмейді.
Dialogue: 0,0:12:27.17,0:12:28.79,Default,,0,0,0,,Мен ештеңе істегім келмейді
Dialogue: 0,0:12:29.96,0:12:31.38,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:12:31.50,0:12:33.92,Default,,0,0,0,,Мен не істегім келеді?
Dialogue: 0,0:12:38.18,0:12:39.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:39.68,0:12:42.51,Default,,0,0,0,,Мен Нацуманың қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:12:42.76,0:12:44.77,Default,,0,0,0,,Нацуме менің досым болғанына қуаныштымын.
Dialogue: 0,0:12:45.98,0:12:48.02,Default,,0,0,0,,Фэй айтқандай
Dialogue: 0,0:12:48.35,0:12:50.77,Default,,0,0,0,,Өзгертудің қажеті жоқ еді, солай ма?
Dialogue: 0,0:12:52.98,0:12:56.49,Default,,0,0,0,,Нені көрдіңіз, не естідіңіз, не сезіндіңіз
Dialogue: 0,0:12:56.61,0:12:57.78,Default,,0,0,0,,Тек сіз білесіз
Dialogue: 0,0:12:58.45,0:13:00.45,Default,,0,0,0,,Біреудің пікірі маңызды емес.
Dialogue: 0,0:13:00.57,0:13:01.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:01.99,0:13:03.83,Default,,0,0,0,,Бұл сіздікі
Dialogue: 0,0:13:04.29,0:13:06.00,Default,,0,0,0,,Өзіңізге қамқорлық жасаңыз
Dialogue: 0,0:13:06.91,0:13:08.54,Default,,0,0,0,,Менің…
Dialogue: 0,0:13:08.67,0:13:10.42,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:10.58,0:13:13.50,Default,,0,0,0,,Ахаха... Мен солай ойладым.
Dialogue: 0,0:13:13.88,0:13:14.92,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:13:15.17,0:13:17.76,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:13:19.72,0:13:21.34,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:13:21.76,0:13:23.18,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:23.31,0:13:25.43,Default,,0,0,0,,U.A. Спорттық күні тез арада келіп жетті
Dialogue: 0,0:13:27.14,0:13:28.44,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:13:29.52,0:13:31.19,Default,,0,0,0,,(Жүйелік дыбыс)
Dialogue: 0,0:13:31.65,0:13:32.98,Default,,0,0,0,,Соңында?
Dialogue: 0,0:13:33.11,0:13:34.90,Default,,0,0,0,,Кешіріңіз, не болып жатыр?
Dialogue: 0,0:13:35.03,0:13:37.94,Default,,0,0,0,,Уақыт өте маңызды. Барайық!
Dialogue: 0,0:13:38.07,0:13:39.07,Default,,0,0,0,,О
Dialogue: 0,0:13:39.49,0:13:42.66,Default,,0,0,0,,Бұл жерден кетейік. Тездетіңіздер, бейбақтар!
Dialogue: 0,0:13:44.41,0:13:45.83,Default,,0,0,0,,Міне! Асықшы!
Dialogue: 0,0:13:45.95,0:13:47.58,Default,,0,0,0,,Мен оны жайына қалдырамын.
Dialogue: 0,0:13:47.70,0:13:49.16,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:13:54.88,0:13:56.92,Default,,0,0,0,,Балалар, сендер қандай ақымақсыңдар!
Dialogue: 0,0:13:57.05,0:13:58.05,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:14:03.09,0:14:03.93,Default,,0,0,0,,Уау (полиция) Не!
Dialogue: 0,0:14:04.05,0:14:04.80,Default,,0,0,0,,Сырғанақ!
Dialogue: 0,0:14:04.93,0:14:05.68,Default,,0,0,0,,Бұл қауіпті! (Полиция) Уау!
Dialogue: 0,0:14:06.06,0:14:07.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:08.56,0:14:09.81,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:14:10.23,0:14:11.56,Default,,0,0,0,,Егер сіз әбігерге түссеңіз, мен сізді сонда қалдырамын. (Полиция) А?
Dialogue: 0,0:14:12.23,0:14:13.56,Default,,0,0,0,,Тезірек жүріңдер, бейбақтар!
Dialogue: 0,0:14:13.69,0:14:16.23,Default,,0,0,0,,Асығыңыз, асығыңыз! Сіз кешігіп қаласыз!
Dialogue: 0,0:14:16.36,0:14:17.32,Default,,0,0,0,,(басылған қосқыштың дыбысы)
Dialogue: 0,0:14:18.90,0:14:19.78,Default,,0,0,0,,Ах! (Полиция) Не?
Dialogue: 0,0:14:19.95,0:14:21.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:21.20,0:14:23.11,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:14:26.28,0:14:27.24,Default,,0,0,0,,Ура!
Dialogue: 0,0:14:29.75,0:14:32.00,Default,,0,0,0,,Эй, Абайо тезек фабрикасы
Dialogue: 0,0:14:32.12,0:14:34.63,Default,,0,0,0,,Қош бол~ (Киборг) Мен қайта ораламын.
Dialogue: 0,0:14:34.96,0:14:37.09,Default,,0,0,0,,Идиот, сен қайтесің?
Dialogue: 0,0:14:37.38,0:14:40.80,Default,,0,0,0,,Бірақ бәрі үшін рахмет! Сәлем!
Dialogue: 0,0:14:40.92,0:14:42.93,Default,,0,0,0,,Банзай Банзай!
Dialogue: 0,0:14:48.64,0:14:53.27,Default,,0,0,0,,Менің көргенім, естігенім, сезгенім...
Dialogue: 0,0:14:53.77,0:14:56.52,Default,,0,0,0,,Бүгіннен бастап мен Кабураги-гумиге қарыздар боламын.
Dialogue: 0,0:14:56.65,0:14:57.77,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:14:57.94,0:15:01.24,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:15:02.82,0:15:04.66,Default,,0,0,0,,Бұл ұрыс алаңы
Dialogue: 0,0:15:04.95,0:15:07.45,Default,,0,0,0,,Сіз жауынгер болғыңыз келетіні туралы ойыңызды өзгерттіңіз бе?
Dialogue: 0,0:15:08.16,0:15:10.33,Default,,0,0,0,,Маған күресуді үйретіңізші!
Dialogue: 0,0:15:10.66,0:15:12.16,Default,,0,0,0,,Бірдеңе айту бекер
Dialogue: 0,0:15:12.46,0:15:14.79,Default,,0,0,0,,Иә! Менің барлық қымбат дүниелерім!
Dialogue: 0,0:15:15.00,0:15:17.50,Default,,0,0,0,,Поо! Кукукуку…
Dialogue: 0,0:15:17.79,0:15:20.71,Default,,0,0,0,,Неге маған күресуді үйреткіңіз келді?
Dialogue: 0,0:15:21.05,0:15:22.72,Default,,0,0,0,,That's right.
Dialogue: 0,0:15:22.84,0:15:25.47,Default,,0,0,0,,Қателер бұл әлемде қалай өмір сүреді?
Dialogue: 0,0:15:25.97,0:15:27.60,Default,,0,0,0,,Мен тексергім келді.
Dialogue: 0,0:15:27.72,0:15:29.60,Default,,0,0,0,,Уау! Буу!
Dialogue: 0,0:15:33.06,0:15:35.94,Default,,0,0,0,,Бұл керемет, бастық!
Dialogue: 0,0:15:36.15,0:15:38.32,Default,,0,0,0,,Бұл әлсіздік емес.
Dialogue: 0,0:15:38.57,0:15:40.32,Default,,0,0,0,,Бұл сіздің қаруыңыз.
Dialogue: 0,0:15:40.48,0:15:43.07,Default,,0,0,0,,Мынау не... мына жігіт...
Dialogue: 0,0:15:44.32,0:15:45.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:46.87,0:15:48.49,Default,,0,0,0,,Сондықтан мен айттым.
Dialogue: 0,0:15:48.62,0:15:50.16,Default,,0,0,0,,Саған әлі ерте.
Dialogue: 0,0:15:50.29,0:15:51.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:51.37,0:15:52.91,Default,,0,0,0,,Бастық?
Dialogue: 0,0:15:53.16,0:15:55.33,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:15:55.87,0:15:59.59,Default,,0,0,0,,Мен өзімді шектен шығарамын
Dialogue: 0,0:16:04.26,0:16:07.05,Default,,0,0,0,,Неліктен Оксонды қоспайсыз?
Dialogue: 0,0:16:07.18,0:16:09.39,Default,,0,0,0,,Бос емеспін, бейқам болдым.
Dialogue: 0,0:16:09.51,0:16:10.56,Default,,0,0,0,,Чача ойынын ойнайық
Dialogue: 0,0:16:10.68,0:16:12.77,Default,,0,0,0,,Ка~! Такуё
Dialogue: 0,0:16:14.94,0:16:17.15,Default,,0,0,0,,Эй, сенің де қолыңнан келеді.
Dialogue: 0,0:16:17.27,0:16:18.27,Default,,0,0,0,,(Сота) Онда менің үйіме барайық! Апама айтамын!
Dialogue: 0,0:16:18.65,0:16:20.02,Default,,0,0,0,,Іш
Dialogue: 0,0:16:20.27,0:16:22.78,Default,,0,0,0,,Бұл маймыл жасаған соңғы Оксон ликері.
Dialogue: 0,0:16:23.78,0:16:24.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:29.70,0:16:31.12,Default,,0,0,0,,Npp ha~
Dialogue: 0,0:16:31.24,0:16:32.74,Default,,0,0,0,,Дәмі қорқынышты.
Dialogue: 0,0:16:32.87,0:16:35.29,Default,,0,0,0,,Көз алмасы жаншылған біреу бар деп үміттенемін.
Dialogue: 0,0:16:35.41,0:16:37.04,Default,,0,0,0,,Гахахаха...
Dialogue: 0,0:16:55.39,0:16:57.48,Default,,0,0,0,,Сіз не істемексіз? Бұдан былай
Dialogue: 0,0:16:57.81,0:17:01.19,Default,,0,0,0,,Гадоль зауыты бірнеше жылдан кейін қайта салынады.
Dialogue: 0,0:17:01.31,0:17:03.48,Default,,0,0,0,,Бұған дейін Декадентті аяқтаңыз.
Dialogue: 0,0:17:04.03,0:17:04.86,Default,,0,0,0,,А...
Dialogue: 0,0:17:04.99,0:17:08.86,Default,,0,0,0,,Басқаша айтқанда, сіз жүйеге нағыз жекпе-жекті сатуға тырысасыз.
Dialogue: 0,0:17:08.99,0:17:11.49,Default,,0,0,0,,Сынық Бұл түзу сызық емес пе?
Dialogue: 0,0:17:12.33,0:17:14.74,Default,,0,0,0,,Мен кездеспеймін.
Dialogue: 0,0:17:14.95,0:17:17.46,Default,,0,0,0,,Мен жаңа ойыншық іздедім.
Dialogue: 0,0:17:17.58,0:17:19.37,Default,,0,0,0,,Қызық болып көрінсе, сыртқа шығайық.
Dialogue: 0,0:17:19.50,0:17:20.96,Default,,0,0,0,,Бұл күлкілі болуы мүмкін емес.
Dialogue: 0,0:17:21.25,0:17:22.42,Default,,0,0,0,,Не болса да
Dialogue: 0,0:17:22.54,0:17:26.46,Default,,0,0,0,,Біз де мүлде адасып қалдық.
Dialogue: 0,0:17:27.92,0:17:28.68,Default,,0,0,0,,Не!
Dialogue: 0,0:17:28.80,0:17:30.97,Default,,0,0,0,,Кіру! Маған қазір жібер, Джил!
Dialogue: 0,0:17:31.09,0:17:34.35,Default,,0,0,0,,Не? Мен бұл жерде істей алмаймын. Мен келесі жасырынуға жетуім керек.
Dialogue: 0,0:17:34.60,0:17:36.35,Default,,0,0,0,,Қарғыс атсын... Қап!
Dialogue: 0,0:17:40.06,0:17:42.19,Default,,0,0,0,,Мен енді іше алмаймын~
Dialogue: 0,0:17:42.31,0:17:43.61,Default,,0,0,0,,Әлі жоқ~
Dialogue: 0,0:17:43.73,0:17:45.19,Default,,0,0,0,,Бұл тамаша (танкер) хахаха...
Dialogue: 0,0:17:49.99,0:17:50.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:56.91,0:17:58.41,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:18:01.88,0:18:03.46,Default,,0,0,0,,Бастық!
Dialogue: 0,0:18:04.84,0:18:08.34,Default,,0,0,0,,«Мен саған осы уақытқа дейін шындықты айта алмадым...»
Dialogue: 0,0:18:08.47,0:18:10.09,Default,,0,0,0,,«Мен өкінемін»
Dialogue: 0,0:18:10.76,0:18:13.72,Default,,0,0,0,,«Сонымен бірге шындықты айту арқылы...»
Dialogue: 0,0:18:13.85,0:18:16.56,Default,,0,0,0,,«Мен сені ренжіткеніме өкінемін».
Dialogue: 0,0:18:17.52,0:18:21.90,Default,,0,0,0,,«Адамдар, мен сендерді алдадым».
Dialogue: 0,0:18:22.19,0:18:23.94,Default,,0,0,0,,«Бұл дүниенің билігі болды».
Dialogue: 0,0:18:24.65,0:18:26.36,Default,,0,0,0,,«Ережелерді сақтау арқылы—»
Dialogue: 0,0:18:26.48,0:18:29.49,Default,,0,0,0,,«Мен өз өмірімді басқалардың қасіретіне назар аудармай өткіздім».
Dialogue: 0,0:18:30.07,0:18:31.99,Default,,0,0,0,,«Бұл қалыпты жағдай болды».
Dialogue: 0,0:18:33.32,0:18:37.74,Default,,0,0,0,,«Мен сені алғаш көргенде өмірге деген ынтымағым болмады».
Dialogue: 0,0:18:37.87,0:18:39.66,Default,,0,0,0,,«Мен өлетін болдым».
Dialogue: 0,0:18:40.21,0:18:42.33,Default,,0,0,0,,«Өмір сүруден бас тарту арқылы...»
Dialogue: 0,0:18:42.46,0:18:45.67,Default,,0,0,0,,«Мүмкін ол бәрін жеңілдетуге тырысқан шығар».
Dialogue: 0,0:18:46.21,0:18:49.67,Default,,0,0,0,,«Бірақ мен сенің өмір жолыңды көргенде...»
Dialogue: 0,0:18:50.26,0:18:52.18,Default,,0,0,0,,«Мені бұл өмір жолы қызықтырды».
Dialogue: 0,0:18:53.59,0:18:56.18,Default,,0,0,0,,«Мен өзімді шектен шығуды шештім».
Dialogue: 0,0:18:57.39,0:18:59.10,Default,,0,0,0,,«Бұдан былай...»
Dialogue: 0,0:18:59.39,0:19:02.94,Default,,0,0,0,,«Мен әлем ережелерін бұзу үшін әрекет етемін».
Dialogue: 0,0:19:03.81,0:19:08.44,Default,,0,0,0,,«Менің ойымша, бұл ең болмағанда мен өтей алатын өтемақы».
Dialogue: 0,0:19:09.82,0:19:12.45,Default,,0,0,0,,«Өзің қалағандай өмір сүр».
Dialogue: 0,0:19:13.91,0:19:15.45,Default,,0,0,0,,«Сенде бәрі жақсы».
Dialogue: 0,0:19:17.99,0:19:19.66,Default,,0,0,0,,Жарайды, алдымен осыны оқимын, бітірген соң екіншісін де оқимыз ба?
Dialogue: 0,0:19:21.04,0:19:22.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:23.50,0:19:26.04,Default,,0,0,0,,Ескі декаданс бөліктері?
Dialogue: 0,0:19:26.21,0:19:27.63,Default,,0,0,0,,Ыңғайлы Ыңғайлы ~
Dialogue: 0,0:19:27.75,0:19:28.63,Default,,0,0,0,,Ең жақсысы емес пе?
Dialogue: 0,0:19:28.75,0:19:30.55,Default,,0,0,0,,Сіз мұнда мүлдем қауіпсізсіз.
Dialogue: 0,0:19:32.22,0:19:34.84,Default,,0,0,0,,Иә? Балалар, не істеп жатырсыңдар?
Dialogue: 0,0:19:34.97,0:19:37.64,Default,,0,0,0,,Менде гадолл болмаса да жүйеге кірсем, не істеуім керек?
Dialogue: 0,0:19:37.85,0:19:39.56,Default,,0,0,0,,Әлі емес пе? Тезірек, Джил!
Dialogue: 0,0:19:39.93,0:19:42.48,Default,,0,0,0,,Сондай-ақ~ Сондықтан бір ұяшық...
Dialogue: 0,0:19:43.18,0:19:44.89,Default,,0,0,0,,Аман болыңыз...
Dialogue: 0,0:19:45.23,0:19:47.15,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:19:50.69,0:19:52.65,Default,,0,0,0,,Сәлем, бастық! Бар, иә?
Dialogue: 0,0:19:52.94,0:19:55.20,Default,,0,0,0,,Бастық мен ашамын!
Dialogue: 0,0:19:55.49,0:19:56.70,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:57.57,0:19:58.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:58.53,0:19:59.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:00.03,0:20:01.49,Default,,0,0,0,,Әй, бастық!
Dialogue: 0,0:20:01.62,0:20:03.04,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:20:03.16,0:20:05.42,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:06.50,0:20:09.09,Default,,0,0,0,,Бастық, мен оны оқыдым.
Dialogue: 0,0:20:09.21,0:20:10.67,Default,,0,0,0,,Бұл қандай әріп?
Dialogue: 0,0:20:11.71,0:20:14.26,Default,,0,0,0,,Мен сіздің не айтқыңыз келетінін түсіндім, бірақ
Dialogue: 0,0:20:15.05,0:20:17.34,Default,,0,0,0,,Басқа жерге баруды жоспарлап отырсыз ба?
Dialogue: 0,0:20:17.72,0:20:19.43,Default,,0,0,0,,А, мен...
Dialogue: 0,0:20:19.64,0:20:20.93,Default,,0,0,0,,Бұл тым өзімшілдік!
Dialogue: 0,0:20:21.06,0:20:21.85,Default,,0,0,0,,Не?
Dialogue: 0,0:20:21.97,0:20:24.52,Default,,0,0,0,,Айтқыңыз келгенді жазып, қашып кетесіз бе?
Dialogue: 0,0:20:24.64,0:20:25.69,Default,,0,0,0,,Ал не?
Dialogue: 0,0:20:26.06,0:20:28.06,Default,,0,0,0,,«Жақсысың ба?»
Dialogue: 0,0:20:28.19,0:20:30.90,Default,,0,0,0,,Бұл мүлдем дұрыс емес!
Dialogue: 0,0:20:31.27,0:20:33.74,Default,,0,0,0,,Жарайды... жай ғана...
Dialogue: 0,0:20:35.07,0:20:37.45,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:20:38.16,0:20:39.99,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:20:40.12,0:20:42.49,Default,,0,0,0,,Осы уақыт бойы мені алдағаныма сене алар емеспін.
Dialogue: 0,0:20:43.24,0:20:44.45,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:44.58,0:20:48.46,Default,,0,0,0,,Бастықпен не өткіздім, немен ұрыстым...
Dialogue: 0,0:20:49.17,0:20:50.88,Default,,0,0,0,,Менің істегенім өтірік емес
Dialogue: 0,0:20:51.00,0:20:51.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:53.05,0:20:56.30,Default,,0,0,0,,Бұл сіз өзіңіз шешетін нәрсе.
Dialogue: 0,0:20:57.26,0:20:58.38,Default,,0,0,0,,Сонымен, мен
Dialogue: 0,0:20:59.64,0:21:03.14,Default,,0,0,0,,Мен білетін бастыққа сенуді жөн көрдім.
Dialogue: 0,0:21:04.47,0:21:05.85,Default,,0,0,0,,Нацюме...
Dialogue: 0,0:21:05.98,0:21:07.02,Default,,0,0,0,,Boss
Dialogue: 0,0:21:07.14,0:21:09.65,Default,,0,0,0,,Егер сіз сол ережемен біреумен төбелессеңіз
Dialogue: 0,0:21:09.77,0:21:12.77,Default,,0,0,0,,Мен саған көмектесемін.
Dialogue: 0,0:21:13.48,0:21:14.48,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:15.78,0:21:18.53,Default,,0,0,0,,Жарайды, бірге...
Dialogue: 0,0:21:19.95,0:21:21.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.53,0:21:22.95,Default,,0,0,0,,Гофу…
Dialogue: 0,0:21:24.54,0:21:25.45,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:21:26.75,0:21:27.79,Default,,0,0,0,,Қарғыс атқыр бастық!
Dialogue: 0,0:21:28.58,0:21:30.04,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:21:30.71,0:21:33.42,Default,,0,0,0,,Сіз мұнда күткендей келдіңіз бе?
Dialogue: 0,0:21:34.84,0:21:37.88,Default,,0,0,0,,Сіз де қашып құтыла алмайсыз.
Dialogue: 0,0:21:38.01,0:21:38.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:38.88,0:21:41.72,Default,,0,0,0,,«Әлемге қателер қажет емес»
Dialogue: 0,0:21:42.47,0:21:44.31,Default,,0,0,0,,Джил! Қалай болғанда да, мұны істеу мүмкін бе деп ойлаймын!
Dialogue: 0,0:21:45.10,0:21:46.31,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:21:46.77,0:21:49.52,Default,,0,0,0,,Кабурагидің нақты денесіне кіру мүмкін емес.
Dialogue: 0,0:21:49.64,0:21:50.44,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:21:51.15,0:21:52.61,Default,,0,0,0,,Осы қарқынмен ол...
Dialogue: 0,0:21:52.73,0:21:54.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.98,0:21:56.78,Default,,0,0,0,,Иә? Бұл қандай дыбыс?
Dialogue: 0,0:21:56.90,0:21:58.03,Default,,0,0,0,,Жетті. Мен сені де, әпкеңді де өлтіремін.
Dialogue: 0,0:21:58.15,0:22:01.28,Default,,0,0,0,,Әй... Бұл не?!
Dialogue: 0,0:22:03.20,0:22:05.16,Default,,0,0,0,,Жоқ! Не айтқың келеді?
Dialogue: 0,0:22:05.58,0:22:08.66,Default,,0,0,0,,А... сонда бәрі біткен жоқ па?
Dialogue: 0,0:22:08.79,0:22:10.92,Default,,0,0,0,,Бұл қызық болады, солай емес пе?
Dialogue: 0,0:22:12.38,0:22:15.42,Default,,0,0,0,,(Гадоллдың айқайы)
Dialogue: 0,0:22:20.01,0:22:25.01,Default,,0,0,0,,♪~
Dialogue: 0,0:23:44.97,0:23:49.97,Default,,0,0,0,,~♪
