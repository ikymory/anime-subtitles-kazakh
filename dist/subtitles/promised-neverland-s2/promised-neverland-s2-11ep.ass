Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(♪~Ашық ән)
Dialogue: 0,0:00:16.80,0:00:20.93,Default,,0,0,0,,♪ есімде қалдым есімде ♪
Dialogue: 0,0:00:21.02,0:00:24.77,Default,,0,0,0,,♪ Бір көзді ашып-жұмғанша және үмітсіздік сезімі ♪
Dialogue: 0,0:00:24.85,0:00:28.73,Default,,0,0,0,,♪ Мен оянсам да, мен әлі түс көрдім ♪
Dialogue: 0,0:00:28.82,0:00:33.07,Default,,0,0,0,,♪ Біздің сәттеріміз жарқыраған оқиға ♪
Dialogue: 0,0:00:33.15,0:00:37.45,Default,,0,0,0,,♪ Сағаттың секунд тілі ♪
Dialogue: 0,0:00:37.53,0:00:40.12,Default,,0,0,0,,♪ Кішкене күліңіз ♪
Dialogue: 0,0:00:40.20,0:00:46.12,Default,,0,0,0,,♪ Ол саған толы еді ♪
Dialogue: 0,0:00:48.88,0:00:53.05,Default,,0,0,0,,♪ Ертең мұзды құрт ♪
Dialogue: 0,0:00:53.13,0:00:53.92,Default,,0,0,0,,♪ Қалай болғанда да ♪
Dialogue: 0,0:00:54.01,0:00:56.97,Default,,0,0,0,,♪ Мен жоғалтқым келмейтін нәрселер бар ♪
Dialogue: 0,0:00:57.05,0:00:58.55,Default,,0,0,0,,♪ Тағдырдан тыс ♪
Dialogue: 0,0:00:58.64,0:01:00.68,Default,,0,0,0,,♪ Мен сені таптым ♪
Dialogue: 0,0:01:00.76,0:01:04.56,Default,,0,0,0,,♪ Көз жасының енді мағынасы жоқ ♪
Dialogue: 0,0:01:04.64,0:01:07.02,Default,,0,0,0,,♪ Ол тез айналады ♪
Dialogue: 0,0:01:07.10,0:01:08.48,Default,,0,0,0,,♪ Дүниенің түкпірінде ♪
Dialogue: 0,0:01:08.56,0:01:11.40,Default,,0,0,0,,♪ Бұл айқай ♪ сияқты
Dialogue: 0,0:01:11.48,0:01:12.98,Default,,0,0,0,,♪ Тыныс алу ♪
Dialogue: 0,0:01:13.07,0:01:16.99,Default,,0,0,0,,♪ Мыңдаған жылдар өткен соң қайта кездессек ♪
Dialogue: 0,0:01:17.07,0:01:20.87,Default,,0,0,0,,♪ Үмітсіздіктен ары күліңіз ♪
Dialogue: 0,0:01:26.41,0:01:27.71,Default,,0,0,0,,(Ашық ән~♪)
Dialogue: 0,0:01:33.05,0:01:36.80,Default,,0,0,0,,Бостандық? Мен бос емеспін деп ойлайсың ба?
Dialogue: 0,0:01:36.88,0:01:41.05,Default,,0,0,0,,Біз бәріміз лауазым тағдырының құрсауындамыз.
Dialogue: 0,0:01:41.81,0:01:45.60,Default,,0,0,0,,Сіз де дүниеге келген сәттен бастап тағдырдың ауыртпалығындасыз.
Dialogue: 0,0:01:45.68,0:01:48.19,Default,,0,0,0,,Жоқ! Мен көшбасшы болғым келді
Dialogue: 0,0:01:49.10,0:01:52.11,Default,,0,0,0,,Қалаймын...Мен ағамды қалаймын...
Dialogue: 0,0:01:52.19,0:01:54.69,Default,,0,0,0,,Сіз шынымен де осыны қаладыңыз ба?
Dialogue: 0,0:01:54.78,0:01:57.53,Default,,0,0,0,,Бұл өтірік, екіжүзді!
Dialogue: 0,0:01:57.61,0:02:00.45,Default,,0,0,0,,Сіз де, Минерва да
Dialogue: 0,0:02:00.53,0:02:03.45,Default,,0,0,0,,Өзгертейік, сен де
Dialogue: 0,0:02:03.54,0:02:07.21,Default,,0,0,0,,Мен мұны істей алмаймын. Мен мұны істей алмаймын.
Dialogue: 0,0:02:07.29,0:02:11.33,Default,,0,0,0,,Сіз мұны істей аласыз, бұл бұрын ешқашан жасалмаған, сондықтан қазір жасайық.
Dialogue: 0,0:02:11.42,0:02:12.25,Default,,0,0,0,,Га
Dialogue: 0,0:02:14.75,0:02:17.01,Default,,0,0,0,,Қиын болса да, оны міндетті түрде өзгертуге болады.
Dialogue: 0,0:02:17.80,0:02:19.43,Default,,0,0,0,,Тіпті тағдыр, тіпті дүние
Dialogue: 0,0:02:21.55,0:02:22.93,Default,,0,0,0,,Еркін болайық па?
Dialogue: 0,0:02:25.01,0:02:26.60,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:02:26.68,0:02:28.27,Default,,0,0,0,,Дүниені қорғаңыз
Dialogue: 0,0:02:29.14,0:02:32.98,Default,,0,0,0,,Менің отбасым асыл миссияны мойнына алады.
Dialogue: 0,0:02:33.06,0:02:35.44,Default,,0,0,0,,Екі дүниенің құрметті қақпашысы
Dialogue: 0,0:02:36.48,0:02:40.45,Default,,0,0,0,,Басшы ағам менің батырым болды.
Dialogue: 0,0:02:41.32,0:02:43.45,Default,,0,0,0,,Иә...сол күнге дейін
Dialogue: 0,0:02:45.95,0:02:46.79,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:48.16,0:02:49.79,Default,,0,0,0,,Біздің отбасымыз –
Dialogue: 0,0:02:49.87,0:02:52.58,Default,,0,0,0,,Сіз досыңызға опасыздық жасауға уәде бердіңіз бе?
Dialogue: 0,0:02:53.71,0:02:57.51,Default,,0,0,0,,Жеуге жарамды балалардың ата-бабалары бірінші Ратридың жолдастары ма?
Dialogue: 0,0:02:58.26,0:03:01.63,Default,,0,0,0,,Ол бейбітшілікке қарсы шыққан жауласушы топтың қаскөйі емес пе еді?
Dialogue: 0,0:03:02.80,0:03:06.81,Default,,0,0,0,,Бұл... ескі Зәңге естелігі.
Dialogue: 0,0:03:06.89,0:03:10.48,Default,,0,0,0,,Ол жүздеген жылдар бойы бұрмаланып, жасырылған.
Dialogue: 0,0:03:10.56,0:03:12.65,Default,,0,0,0,,Бірінші Ратридің өкініштері
Dialogue: 0,0:03:13.81,0:03:16.23,Default,,0,0,0,,Екі дүниені қорғау керек
Dialogue: 0,0:03:16.94,0:03:20.86,Default,,0,0,0,,Бірақ... сол жеуге болатын балалар...
Dialogue: 0,0:03:21.74,0:03:25.78,Default,,0,0,0,,Ағам жолдан адасып, күнәға батты.
Dialogue: 0,0:03:26.53,0:03:30.16,Default,,0,0,0,,Бірақ мен ойладым, қандай керемет.
Dialogue: 0,0:03:30.75,0:03:33.92,Default,,0,0,0,,Жеке сезімдерді жою арқылы әлемді құтқарған батыл шешім
Dialogue: 0,0:03:34.00,0:03:35.67,Default,,0,0,0,,Бұл асыл миссия.
Dialogue: 0,0:03:36.38,0:03:39.46,Default,,0,0,0,,Жоқ... бұл жаза.
Dialogue: 0,0:03:39.55,0:03:41.26,Default,,0,0,0,,Және бұл қарғыс болды
Dialogue: 0,0:03:42.72,0:03:45.60,Default,,0,0,0,,(Петр) Сол күннен кейін ағам өзгерді.
Dialogue: 0,0:03:46.35,0:03:48.14,Default,,0,0,0,,Минерва деп аталады және т.б.
Dialogue: 0,0:03:48.22,0:03:51.68,Default,,0,0,0,,Жеуге жарамды балаларды құтқару үшін әртүрлі іс-шараларды бастады
Dialogue: 0,0:03:52.81,0:03:56.23,Default,,0,0,0,,Менің ағам дұрыс емес, мен оны тоқтатуым керек.
Dialogue: 0,0:03:56.90,0:03:59.94,Default,,0,0,0,,Жеуге жарамды бала – қажетті құрбандық.
Dialogue: 0,0:04:00.03,0:04:02.45,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:04:11.08,0:04:12.08,Default,,0,0,0,,Мәйіт ше?
Dialogue: 0,0:04:17.67,0:04:19.38,Default,,0,0,0,,Сіздің ағаңыздың соңғы сәті қандай болды...?
Dialogue: 0,0:04:20.51,0:04:24.18,Default,,0,0,0,,Сізге "кешіріңіз"
Dialogue: 0,0:04:25.64,0:04:26.84,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:34.23,0:04:36.98,Default,,0,0,0,,Увааааааааааааааааааа
Dialogue: 0,0:04:37.06,0:04:39.19,Default,,0,0,0,,Бауырымды құрбандыққа шалсам да...
Dialogue: 0,0:04:39.27,0:04:42.53,Default,,0,0,0,,Мен Лартри отбасының миссиясын міндетті түрде орындаймын.
Dialogue: 0,0:04:43.11,0:04:46.91,Default,,0,0,0,,Қанша азап болса да, дүниені қорғау
Dialogue: 0,0:04:46.99,0:04:48.32,Default,,0,0,0,,Мен осылай шештім.
Dialogue: 0,0:04:49.91,0:04:53.16,Default,,0,0,0,,Сіз тұтқындасыз ба? Отбасы мүшесі ретінде?
Dialogue: 0,0:04:53.25,0:04:55.16,Default,,0,0,0,,Тағдыр? басқа!
Dialogue: 0,0:04:55.25,0:04:58.17,Default,,0,0,0,,Бұл асыл миссия. Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:04:59.13,0:04:59.96,Default,,0,0,0,,Петір
Dialogue: 0,0:05:02.26,0:05:05.43,Default,,0,0,0,,(Питер) Тағдырға қарсы тұруға тырыстың ба?
Dialogue: 0,0:05:06.97,0:05:09.01,Default,,0,0,0,,Сіз еркін болғыңыз келді ме?
Dialogue: 0,0:05:10.89,0:05:12.52,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:14.10,0:05:16.60,Default,,0,0,0,,Менің еркін болғанымды қаладың ба?
Dialogue: 0,0:05:19.52,0:05:21.02,Default,,0,0,0,,(Петр) Я...
Dialogue: 0,0:05:22.78,0:05:24.19,Default,,0,0,0,,Біз бірге тұрамыз ба?
Dialogue: 0,0:05:25.15,0:05:27.95,Default,,0,0,0,,Біз бірге өзгереміз бе? Ақымақтар
Dialogue: 0,0:05:28.82,0:05:31.70,Default,,0,0,0,,Сондықтан сізді қанауда.
Dialogue: 0,0:05:31.78,0:05:35.50,Default,,0,0,0,,Өзгеруі керек жындар әлемі ғана емес.
Dialogue: 0,0:05:36.16,0:05:38.79,Default,,0,0,0,,Жындар саған не істеді?
Dialogue: 0,0:05:38.88,0:05:42.75,Default,,0,0,0,,Адамдар ерте заманнан бері мұны бір-бірімен қайталап келеді.
Dialogue: 0,0:05:43.30,0:05:47.30,Default,,0,0,0,,Иә, адамдар адамды жемесе де...
Dialogue: 0,0:05:47.80,0:05:51.26,Default,,0,0,0,,Қалағаныңды істе, бұл менің шығыным
Dialogue: 0,0:05:51.35,0:05:55.22,Default,,0,0,0,,Кез келген жерге барыңыз, мен үшін бәрі баяу болды
Dialogue: 0,0:05:56.06,0:05:57.48,Default,,0,0,0,,Әлемді өзгерту керек пе?
Dialogue: 0,0:05:57.56,0:05:59.73,Default,,0,0,0,,Хаха! Қолыңыздан келсе, жасап көріңіз.
Dialogue: 0,0:06:00.52,0:06:02.44,Default,,0,0,0,,Сіздің зұлымдық күресіңіз
Dialogue: 0,0:06:02.52,0:06:04.86,Default,,0,0,0,,Мен сені тозақтың шетінен сауықтырамын.
Dialogue: 0,0:06:04.94,0:06:05.94,Default,,0,0,0,,(Тосын тыныс)
Dialogue: 0,0:06:06.03,0:06:07.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:07.15,0:06:08.99,Default,,0,0,0,,(пышақ кесу дыбысы)
Dialogue: 0,0:06:12.03,0:06:12.95,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:06:16.79,0:06:19.12,Default,,0,0,0,,Жоқ, сен өлуің керек...
Dialogue: 0,0:06:20.54,0:06:21.50,Default,,0,0,0,,Идиот...
Dialogue: 0,0:06:22.38,0:06:25.55,Default,,0,0,0,,Бұл оңай лақтырылатын нәрсе ме?
Dialogue: 0,0:06:27.76,0:06:29.55,Default,,0,0,0,,Мен осында өлемін
Dialogue: 0,0:06:31.14,0:06:32.68,Default,,0,0,0,,Лартри ретінде
Dialogue: 0,0:06:35.14,0:06:35.97,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:42.15,0:06:42.98,Default,,0,0,0,,(көз жасын сүрту)
Dialogue: 0,0:06:44.65,0:06:45.48,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:06:46.61,0:06:48.61,Default,,0,0,0,,Мен оны міндетті түрде өзгертемін және сізге көрсетемін.
Dialogue: 0,0:06:50.07,0:06:52.57,Default,,0,0,0,,(Халықтың айқайы)
Dialogue: 0,0:06:58.08,0:06:59.33,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:01.12,0:07:02.25,Default,,0,0,0,,(төмен қарай пышақталған қарудың дыбысы)
Dialogue: 0,0:07:02.83,0:07:03.88,Default,,0,0,0,,Уау
Dialogue: 0,0:07:13.47,0:07:15.26,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:15.35,0:07:16.76,Default,,0,0,0,,Лорд Эверк
Dialogue: 0,0:07:16.85,0:07:20.56,Default,,0,0,0,,(Эверк) Не болып жатыр? Мәртебелі алдында
Dialogue: 0,0:07:20.64,0:07:22.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:22.15,0:07:24.81,Default,,0,0,0,,Мен Эверк мырзадан шұғыл хабарлама алдым.
Dialogue: 0,0:07:25.57,0:07:27.19,Default,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:07:27.28,0:07:30.36,Default,,0,0,0,,Грейсфилд фермасынан есеп алынды.
Dialogue: 0,0:07:30.99,0:07:34.66,Default,,0,0,0,,Анам мен әпкелеріме де рахмет.
Dialogue: 0,0:07:34.74,0:07:38.16,Default,,0,0,0,,Біз жай ғана қалағанымызды жасадық.
Dialogue: 0,0:07:39.00,0:07:42.42,Default,,0,0,0,,Сіз адам әлеміне барасыз ба? асығыңыз
Dialogue: 0,0:07:44.13,0:07:46.75,Default,,0,0,0,,Адам әлеміне бірге барайық, аналар.
Dialogue: 0,0:07:46.84,0:07:47.67,Default,,0,0,0,,(Таңқаларлық дауыс)
Dialogue: 0,0:07:49.21,0:07:51.80,Default,,0,0,0,,Біз алмаймыз...
Dialogue: 0,0:07:53.51,0:07:56.97,Default,,0,0,0,,Мен осында қалып, қолымнан келгеннің бәрін жасағым келеді.
Dialogue: 0,0:07:57.89,0:07:59.43,Default,,0,0,0,,Мен сіздің сезімдеріңізді бағалаймын.
Dialogue: 0,0:08:00.60,0:08:04.44,Default,,0,0,0,,Ал сен ұмыттың ба? Менің сенімен тұруға құқығым жоқ...
Dialogue: 0,0:08:04.52,0:08:06.36,Default,,0,0,0,,Бұл бейберекет және шулы
Dialogue: 0,0:08:07.23,0:08:09.44,Default,,0,0,0,,Мен өліп, сен үшін бірдеңе істеуім керек пе?
Dialogue: 0,0:08:10.19,0:08:12.15,Default,,0,0,0,,Сіз одан шаршадыңыз ба?
Dialogue: 0,0:08:12.24,0:08:15.74,Default,,0,0,0,,Өкінетін болсаң, өмір сүріп, адам әлемінде тазала.
Dialogue: 0,0:08:17.70,0:08:19.33,Default,,0,0,0,,Мен тірі болғаныма қуаныштымын
Dialogue: 0,0:08:19.99,0:08:23.58,Default,,0,0,0,,Өмірде ғана кешірілетін күнәлар бар, өкініштер де бар.
Dialogue: 0,0:08:24.37,0:08:27.08,Default,,0,0,0,,Бұл жеткілікті. Мен енді ешкімге кек сақтамаймын.
Dialogue: 0,0:08:28.17,0:08:30.59,Default,,0,0,0,,Ендеше, сендер де кеттік.
Dialogue: 0,0:08:30.67,0:08:32.72,Default,,0,0,0,,(Росси) Кеттік, кеттік, анашым!
Dialogue: 0,0:08:32.80,0:08:35.22,Default,,0,0,0,,Дұрыс па? анам
Dialogue: 0,0:08:35.30,0:08:36.22,Default,,0,0,0,,Эххе
Dialogue: 0,0:08:36.30,0:08:38.47,Default,,0,0,0,,(эмоция тынысы)
Dialogue: 0,0:08:39.47,0:08:41.97,Default,,0,0,0,,Неге... неге мені кешіре аласың?
Dialogue: 0,0:08:42.89,0:08:45.23,Default,,0,0,0,,Мен сені көпке дейін кешіре алмадым
Dialogue: 0,0:08:46.44,0:08:49.73,Default,,0,0,0,,Мен түсінбедім. Ана - жау.
Dialogue: 0,0:08:49.82,0:08:51.61,Default,,0,0,0,,Мен бұл анамды жеңуім керек
Dialogue: 0,0:08:52.44,0:08:56.20,Default,,0,0,0,,Бірақ мен сыртқа шыққанда, бұл есіме түседі
Dialogue: 0,0:08:56.28,0:08:58.03,Default,,0,0,0,,Тек мейірімді аналар
Dialogue: 0,0:08:58.74,0:08:59.83,Default,,0,0,0,,Бұл туралы көп ойлану
Dialogue: 0,0:09:00.79,0:09:02.33,Default,,0,0,0,,Неге екенін түсінемін.
Dialogue: 0,0:09:03.41,0:09:06.54,Default,,0,0,0,,Ананың мейірімділігі мен махаббаты...
Dialogue: 0,0:09:06.62,0:09:08.71,Default,,0,0,0,,Барлығы шынайы болды
Dialogue: 0,0:09:10.34,0:09:13.51,Default,,0,0,0,,Өйткені, ананы бәрі жақсы көреді.
Dialogue: 0,0:09:14.09,0:09:14.97,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:15.05,0:09:16.97,Default,,0,0,0,,Қанша опасыздық жасасам да
Dialogue: 0,0:09:17.05,0:09:19.64,Default,,0,0,0,,Анам өзін кешіре алмаса да
Dialogue: 0,0:09:20.22,0:09:24.14,Default,,0,0,0,,Ана - біз үшін жалғыз ана.
Dialogue: 0,0:09:25.56,0:09:29.69,Default,,0,0,0,,Ендеше бірге тұрайық, анашым.
Dialogue: 0,0:09:29.77,0:09:30.65,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:30.73,0:09:32.65,Default,,0,0,0,,Анашым—!
Dialogue: 0,0:09:32.73,0:09:36.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:37.11,0:09:39.70,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,0:09:40.74,0:09:42.24,Default,,0,0,0,,Вирк мырза
Dialogue: 0,0:09:43.83,0:09:45.25,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:09:45.87,0:09:49.13,Default,,0,0,0,,Бізде әлі жұмыс бар.
Dialogue: 0,0:09:50.13,0:09:52.67,Default,,0,0,0,,Сіз адам әлеміне барасыз
Dialogue: 0,0:09:53.80,0:09:56.17,Default,,0,0,0,,Маған көмекке келгеніңіз үшін рахмет.
Dialogue: 0,0:09:57.51,0:09:58.38,Default,,0,0,0,,Егер мен басынан бастап араласқан болсам, сенің қолдарың мен құлақтарың—
Dialogue: 0,0:09:59.01,0:10:01.39,Default,,0,0,0,,Мен сені кездестіргеніме қуаныштымын
Dialogue: 0,0:10:01.97,0:10:03.39,Default,,0,0,0,,Шебер бол
Dialogue: 0,0:10:03.97,0:10:04.81,Default,,0,0,0,,Иә
Dialogue: 0,0:10:08.27,0:10:09.44,Default,,0,0,0,,(машинаның бұрылу дыбысы)
Dialogue: 0,0:10:10.02,0:10:13.19,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:10:19.28,0:10:21.70,Default,,0,0,0,,(шатастырылған дауыс)
Dialogue: 0,0:10:21.78,0:10:24.20,Default,,0,0,0,,(Жұмбақ музыка)
Dialogue: 0,0:10:30.71,0:10:31.92,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:11:00.20,0:11:03.87,Default,,0,0,0,,Бұл адам әлеміне әкеледі—
Dialogue: 0,0:11:03.95,0:11:04.87,Default,,0,0,0,,Қақпа
Dialogue: 0,0:11:11.17,0:11:12.75,Default,,0,0,0,,Оны қаламмен белсендіруге болатын сияқты.
Dialogue: 0,0:11:18.80,0:11:19.72,Default,,0,0,0,,Мен оны ашамын.
Dialogue: 0,0:11:20.63,0:11:21.47,Default,,0,0,0,,Иә
Dialogue: 0,0:11:26.10,0:11:27.06,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:11:27.14,0:11:28.02,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:29.14,0:11:30.94,Default,,0,0,0,,Мен шынымен бара аламын.
Dialogue: 0,0:11:32.60,0:11:34.40,Default,,0,0,0,,Адам әлеміне
Dialogue: 0,0:11:46.12,0:11:48.24,Default,,0,0,0,,(керемет дауыс)
Dialogue: 0,0:12:00.17,0:12:01.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:02.80,0:12:03.80,Default,,0,0,0,,Эмма?
Dialogue: 0,0:12:04.39,0:12:05.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:06.55,0:12:08.47,Default,,0,0,0,,Біз әлі бара алмаймыз.
Dialogue: 0,0:12:09.35,0:12:10.18,Default,,0,0,0,,Е...
Dialogue: 0,0:12:11.39,0:12:13.39,Default,,0,0,0,,Не... дейсіз бе?
Dialogue: 0,0:12:14.27,0:12:15.40,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:16.02,0:12:18.69,Default,,0,0,0,,Біз осында қаламыз
Dialogue: 0,0:12:18.77,0:12:21.24,Default,,0,0,0,,Эй! Не айтқың келеді?
Dialogue: 0,0:12:23.95,0:12:24.86,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:27.20,0:12:29.16,Default,,0,0,0,,Мен бұл әлемді өзгерткім келеді
Dialogue: 0,0:12:29.24,0:12:30.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:31.04,0:12:34.00,Default,,0,0,0,,Мен сыртқа шығып, екі адамды кездестірдім.
Dialogue: 0,0:12:34.08,0:12:36.38,Default,,0,0,0,,Маған бұл дүние туралы білім берілді
Dialogue: 0,0:12:37.25,0:12:41.63,Default,,0,0,0,,Бұдан басқа адам әлемі, мың жыл бұрын берілген уәде
Dialogue: 0,0:12:42.88,0:12:44.38,Default,,0,0,0,,Сол уәденің арқасында
Dialogue: 0,0:12:44.47,0:12:48.60,Default,,0,0,0,,Жеуге жарамды балалар құрбандыққа шалынатын адамдар болып табылды.
Dialogue: 0,0:12:49.35,0:12:51.64,Default,,0,0,0,,Мен мұны өзгерте аламын ба?
Dialogue: 0,0:12:52.27,0:12:56.81,Default,,0,0,0,,Менің ойымша, бұл уәде қайтадан жасалуы мүмкін емес пе?
Dialogue: 0,0:12:56.90,0:13:00.11,Default,,0,0,0,,Мен уәдемізді жаңартып, осы дүниені өзгерткім келеді.
Dialogue: 0,0:13:01.07,0:13:04.99,Default,,0,0,0,,Тек Грейсфилд емес, осы дүниедегі жеуге болатын барлық балалар.
Dialogue: 0,0:13:05.07,0:13:07.45,Default,,0,0,0,,Мен сені адам әлеміне апарғым келеді.
Dialogue: 0,0:13:08.57,0:13:12.12,Default,,0,0,0,,Сондықтан мен әлі адам әлеміне бармаймын.
Dialogue: 0,0:13:14.33,0:13:16.00,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:16.62,0:13:18.75,Default,,0,0,0,,(Норман) Мен Эмма осылай айтады деп ойладым.
Dialogue: 0,0:13:20.34,0:13:22.80,Default,,0,0,0,,(Норман) Мен де сенімен қаламын, иә?
Dialogue: 0,0:13:23.46,0:13:25.26,Default,,0,0,0,,Жаман қарау —
Dialogue: 0,0:13:25.34,0:13:28.64,Default,,0,0,0,,Мен жаппай өнім өндіретін фермалардан көптеген балаларды көрдім.
Dialogue: 0,0:13:29.35,0:13:31.39,Default,,0,0,0,,Мен мүмкіндігінше көп адамды құтқарғым келеді.
Dialogue: 0,0:13:32.22,0:13:35.31,Default,,0,0,0,,Оның үстіне жасырынған жерде біраз балалар қалды.
Dialogue: 0,0:13:35.39,0:13:36.39,Default,,0,0,0,,Норман
Dialogue: 0,0:13:37.06,0:13:37.90,Default,,0,0,0,,Күрсін
Dialogue: 0,0:13:37.98,0:13:39.56,Default,,0,0,0,,●
Dialogue: 0,0:13:39.65,0:13:42.36,Default,,0,0,0,,Мен әлемді немесе басқа нәрсені өзгертуге тырыспаймын.
Dialogue: 0,0:13:42.44,0:13:46.57,Default,,0,0,0,,Басқа жеуге жарамды балаларға көмектескіңіз келетінін тіпті ойламаңыз.
Dialogue: 0,0:13:47.11,0:13:50.49,Default,,0,0,0,,Тіпті адам әлеміне қашып кетсем де.
Dialogue: 0,0:13:50.57,0:13:54.04,Default,,0,0,0,,Содан кейін фермалар болды, және олардың үстіндегілері —
Dialogue: 0,0:13:54.12,0:13:57.16,Default,,0,0,0,,Бұл олар сіздің артыңыздан басқа әлемге бармайды дегенді білдірмейді.
Dialogue: 0,0:13:57.25,0:13:58.79,Default,,0,0,0,,Патшалар мен дворяндар?
Dialogue: 0,0:13:59.67,0:14:02.09,Default,,0,0,0,,Осындай қозғалыстарды бақылап отыру үшін
Dialogue: 0,0:14:02.17,0:14:05.67,Default,,0,0,0,,Мен мұнда біреу қалуы керек деп ойладым.
Dialogue: 0,0:14:07.05,0:14:07.93,Default,,0,0,0,,(күліп дем)
Dialogue: 0,0:14:08.51,0:14:09.43,Default,,0,0,0,,(күліп дем)
Dialogue: 0,0:14:09.51,0:14:10.93,Default,,0,0,0,,Бұл өзара.
Dialogue: 0,0:14:12.89,0:14:13.72,Default,,0,0,0,,Егер мен басынан бастап араласқан болсам, сенің қолдарың мен құлақтарың—
Dialogue: 0,0:14:15.27,0:14:18.06,Default,,0,0,0,,Мен де Эмма сияқты әлемді өзгерткім келеді.
Dialogue: 0,0:14:20.06,0:14:24.07,Default,,0,0,0,,Мен өз қанымның мағынасы туралы ойладым.
Dialogue: 0,0:14:24.90,0:14:27.78,Default,,0,0,0,,Эммамен және басқалармен кездескеннен кейін мен ақыры түсіндім.
Dialogue: 0,0:14:28.45,0:14:30.70,Default,,0,0,0,,Тіпті осы дүниені өзгерту үшін
Dialogue: 0,0:14:32.12,0:14:35.16,Default,,0,0,0,,Демек, Эмма және басқалары қалса
Dialogue: 0,0:14:35.24,0:14:36.70,Default,,0,0,0,,Мен де көмектескім келеді
Dialogue: 0,0:14:39.92,0:14:41.04,Default,,0,0,0,,Музыка…
Dialogue: 0,0:14:41.96,0:14:43.17,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:43.25,0:14:44.21,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:14:44.88,0:14:47.92,Default,,0,0,0,,Бұл плантацияны бақылауды жояды.
Dialogue: 0,0:14:48.01,0:14:50.34,Default,,0,0,0,,Патша мен төрелер үндемейді.
Dialogue: 0,0:14:51.26,0:14:54.35,Default,,0,0,0,,Біз қалсақ, бізді нысанаға алатын жаулар болады.
Dialogue: 0,0:14:54.43,0:14:56.93,Default,,0,0,0,,Ол сіз бұрынғы адам болмайды.
Dialogue: 0,0:14:57.60,0:15:01.31,Default,,0,0,0,,Бізге тек бізден гөрі көбірек күш қажет.
Dialogue: 0,0:15:01.98,0:15:03.86,Default,,0,0,0,,Олай болса бізді де артта қалдыр.
Dialogue: 0,0:15:05.36,0:15:06.82,Default,,0,0,0,,Сіз достарыңызды құтқарып жатырсыз, солай ма?
Dialogue: 0,0:15:06.90,0:15:09.03,Default,,0,0,0,,Біз күшке айналамыз
Dialogue: 0,0:15:09.11,0:15:10.49,Default,,0,0,0,,Ааа!
Dialogue: 0,0:15:10.57,0:15:12.74,Default,,0,0,0,,Бұл шынымен судың иісі.
Dialogue: 0,0:15:12.82,0:15:16.16,Default,,0,0,0,,Бұл туралы да айтып беріңізші.
Dialogue: 0,0:15:19.75,0:15:21.12,Default,,0,0,0,,Соңғы минут үшін кешіріңіз.
Dialogue: 0,0:15:21.21,0:15:22.04,Default,,0,0,0,,Егер мен басынан бастап араласқан болсам, сенің қолдарың мен құлақтарың—
Dialogue: 0,0:15:22.12,0:15:24.29,Default,,0,0,0,,Неліктен? Бірге барайық
Dialogue: 0,0:15:24.38,0:15:25.63,Default,,0,0,0,,Сонда мен де қала беремін.
Dialogue: 0,0:15:25.71,0:15:28.51,Default,,0,0,0,,Мен де! Мен бөлек тұрғанды жек көремін
Dialogue: 0,0:15:28.59,0:15:31.51,Default,,0,0,0,,Дон және басқалары... жақсысың ба? Қазір
Dialogue: 0,0:15:31.59,0:15:35.05,Default,,0,0,0,,Біздің бәріміздің осы дүниеден жіберетін балаларымыз бар.
Dialogue: 0,0:15:35.14,0:15:37.51,Default,,0,0,0,,Мен сенің адам әлемінде маған көмектесуіңді қалаймын.
Dialogue: 0,0:15:38.18,0:15:39.35,Default,,0,0,0,,Е...
Dialogue: 0,0:15:39.43,0:15:42.77,Default,,0,0,0,,Минерва-санның баспанасы сізге көмектесті, солай ма?
Dialogue: 0,0:15:42.85,0:15:45.15,Default,,0,0,0,,Енді көмектесу кезегі бізде!
Dialogue: 0,0:15:45.23,0:15:48.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:50.74,0:15:52.36,Default,,0,0,0,,(көз жасын сүрту)
Dialogue: 0,0:15:53.24,0:15:54.16,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:15:54.91,0:15:57.49,Default,,0,0,0,,Мен басқа балаларға да көмектесемін!
Dialogue: 0,0:15:57.58,0:15:59.41,Default,,0,0,0,,Минерва сияқты
Dialogue: 0,0:16:03.71,0:16:04.67,Default,,0,0,0,,Егер мен басынан бастап араласқан болсам, сенің қолдарың мен құлақтарың—
Dialogue: 0,0:16:05.96,0:16:09.67,Default,,0,0,0,,Мен аналардың адам әлемінде де өз отбасын қорғағанын қалаймын.
Dialogue: 0,0:16:10.76,0:16:12.13,Default,,0,0,0,,Барлығыңыз өтінемін
Dialogue: 0,0:16:18.26,0:16:19.10,Default,,0,0,0,,Иә
Dialogue: 0,0:16:22.69,0:16:25.19,Default,,0,0,0,,Жаппай өндіріс фермаларының балалары да құтқарылады.
Dialogue: 0,0:16:25.27,0:16:26.90,Default,,0,0,0,,Онда емделу
Dialogue: 0,0:16:28.52,0:16:30.44,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:16:32.36,0:16:34.45,Default,,0,0,0,,Аман-есен оралыңыз
Dialogue: 0,0:16:34.53,0:16:36.82,Default,,0,0,0,,Әйтпесе, мен сені кешірмеймін!
Dialogue: 0,0:16:36.91,0:16:37.74,Default,,0,0,0,,Иә
Dialogue: 0,0:16:40.70,0:16:42.04,Default,,0,0,0,,Фил
Dialogue: 0,0:16:43.29,0:16:44.21,Default,,0,0,0,,Егер мен басынан бастап араласқан болсам, сенің қолдарың мен құлақтарың—
Dialogue: 0,0:16:45.17,0:16:47.21,Default,,0,0,0,,Жарайды, мен де қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:16:48.13,0:16:52.34,Default,,0,0,0,,Мен сені қанша рет болса да күтемін.
Dialogue: 0,0:16:52.42,0:16:53.26,Default,,0,0,0,,Иә
Dialogue: 0,0:16:57.22,0:16:57.97,Default,,0,0,0,,Мен де қарауылда боламын, сен демалып ал.
Dialogue: 0,0:16:58.05,0:17:00.10,Default,,0,0,0,,Мұны маған қалдыр!
Dialogue: 0,0:17:00.18,0:17:01.72,Default,,0,0,0,,О, мен оны сұрадым.
Dialogue: 0,0:17:13.61,0:17:15.07,Default,,0,0,0,,(Тыныс жүгіре бастайды)
Dialogue: 0,0:17:15.15,0:17:15.99,Default,,0,0,0,,Эмма!
Dialogue: 0,0:17:16.07,0:17:19.78,Default,,0,0,0,,Үйге кеш келсең, мен сені алып кетемін.
Dialogue: 0,0:17:19.87,0:17:23.62,Default,,0,0,0,,Аман-есен оралыңыз.
Dialogue: 0,0:17:23.70,0:17:27.88,Default,,0,0,0,,Иә, уәде беремін.
Dialogue: 0,0:17:27.96,0:17:29.84,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:17:36.63,0:17:37.47,Default,,0,0,0,,(күлімсіреген дауыс)
Dialogue: 0,0:17:40.14,0:17:41.31,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:17:48.60,0:17:51.19,Default,,0,0,0,,(жарқын музыка)
Dialogue: 0,0:18:33.15,0:18:35.61,Default,,0,0,0,,«Туылған күніңмен»
Dialogue: 0,0:19:05.18,0:19:07.35,Default,,0,0,0,,(Драмалық музыка)
Dialogue: 0,0:20:30.27,0:20:31.27,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:31.35,0:20:33.14,Default,,0,0,0,,Күте тұрыңыз, күтіңіз (Тома).
Dialogue: 0,0:20:33.23,0:20:34.81,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:20:38.94,0:20:39.78,Default,,0,0,0,,Фил!
Dialogue: 0,0:20:43.95,0:20:46.20,Default,,0,0,0,,(Драмалық музыка)
Dialogue: 0,0:20:46.28,0:20:47.20,Default,,0,0,0,,Егер мен басынан бастап араласқан болсам, сенің қолдарың мен құлақтарың—
Dialogue: 0,0:20:54.54,0:20:56.88,Default,,0,0,0,,Барлығы қазір
Dialogue: 0,0:20:58.92,0:21:01.17,Default,,0,0,0,,(♪~Соңындағы ән)
Dialogue: 0,0:21:01.26,0:21:06.72,Default,,0,0,0,,♪ Бір тілесең, Ай көлеңкесін ♪
Dialogue: 0,0:21:06.80,0:21:09.26,Default,,0,0,0,,♪ Қандай сиқырлы түн ♪
Dialogue: 0,0:21:09.35,0:21:11.72,Default,,0,0,0,,♪ Оны шешетініңізге сенімдімін ♪
Dialogue: 0,0:21:23.07,0:21:25.74,Default,,0,0,0,,♪ Даусыңыз анық ♪
Dialogue: 0,0:21:25.82,0:21:28.49,Default,,0,0,0,,♪ Жел түнді ♪ жариялады
Dialogue: 0,0:21:28.57,0:21:33.87,Default,,0,0,0,,♪ Көк әлемде бәрі ертегіде ұйықтайды ♪
Dialogue: 0,0:21:33.95,0:21:36.62,Default,,0,0,0,,♪ Ұйқыдасың ♪
Dialogue: 0,0:21:36.71,0:21:39.38,Default,,0,0,0,,♪ Мен жабылған қабақтарымды аштым ♪
Dialogue: 0,0:21:39.46,0:21:42.55,Default,,0,0,0,,♪ Мен ойлағаннан да көп ♪
Dialogue: 0,0:21:42.63,0:21:45.17,Default,,0,0,0,,♪ Бұлыңғыр болмаңыз ♪
Dialogue: 0,0:21:46.72,0:21:51.64,Default,,0,0,0,,♪ Бұл дауыс сізге жетсе ♪
Dialogue: 0,0:21:51.72,0:21:53.06,Default,,0,0,0,,♪ Жауап жоқ ♪
Dialogue: 0,0:21:53.14,0:21:54.39,Default,,0,0,0,,♪ Мен әлі де қалғым келеді ♪
Dialogue: 0,0:21:54.47,0:21:57.69,Default,,0,0,0,,♪ Мен оқиғаның аяқталғанын қаламаймын ♪
Dialogue: 0,0:21:57.77,0:22:02.77,Default,,0,0,0,,♪ Бұл түннен асып кет ♪
Dialogue: 0,0:22:02.86,0:22:03.90,Default,,0,0,0,,♪ Сізбен ♪
Dialogue: 0,0:22:03.98,0:22:06.86,Default,,0,0,0,,♪ Маған сөз керек емес, сондықтан әзірше ♪
Dialogue: 0,0:22:06.95,0:22:09.91,Default,,0,0,0,,♪ Мен бір-бірінің жылуын растағым келеді ♪
Dialogue: 0,0:22:09.99,0:22:10.87,Default,,0,0,0,,♪ Өтінемін ♪
Dialogue: 0,0:22:10.95,0:22:13.54,Default,,0,0,0,,♪ Мен ♪ оянбайтын түс көрейін
Dialogue: 0,0:22:13.62,0:22:16.62,Default,,0,0,0,,♪ Ол қол біздікі ♪
Dialogue: 0,0:22:16.71,0:22:21.34,Default,,0,0,0,,♪ Босатпай, ақырын тіледім ♪
Dialogue: 0,0:22:24.92,0:22:26.63,Default,,0,0,0,,(Соңғы ән~♪)
Dialogue: 0,0:22:29.05,0:22:31.35,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:22:32.85,0:22:37.85,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
