Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(♪~Ашық ән)
Dialogue: 0,0:00:16.80,0:00:20.93,Default,,0,0,0,,♪ есімде қалдым есімде ♪
Dialogue: 0,0:00:21.02,0:00:24.77,Default,,0,0,0,,♪ Бір көзді ашып-жұмғанша және үмітсіздік сезімі ♪
Dialogue: 0,0:00:24.85,0:00:28.73,Default,,0,0,0,,♪ Мен оянсам да, мен әлі түс көрдім ♪
Dialogue: 0,0:00:28.82,0:00:33.07,Default,,0,0,0,,♪ Біздің сәттеріміз жарқыраған оқиға ♪
Dialogue: 0,0:00:33.15,0:00:37.45,Default,,0,0,0,,♪ Сағаттың секунд тілі ♪
Dialogue: 0,0:00:37.53,0:00:40.12,Default,,0,0,0,,♪ Кішкене күліңіз ♪
Dialogue: 0,0:00:40.20,0:00:42.79,Default,,0,0,0,,♪ Сізге толы ♪
Dialogue: 0,0:00:42.87,0:00:46.12,Default,,0,0,0,,♪ Толық болды ♪
Dialogue: 0,0:00:48.88,0:00:53.05,Default,,0,0,0,,♪ Ертең мұзды құрт ♪
Dialogue: 0,0:00:53.13,0:00:54.13,Default,,0,0,0,,♪ Қалай болғанда да ♪
Dialogue: 0,0:00:54.22,0:00:56.97,Default,,0,0,0,,♪ Мен жоғалтқым келмейтін нәрселер бар ♪
Dialogue: 0,0:00:57.05,0:00:58.85,Default,,0,0,0,,♪ Тағдырдан тыс ♪
Dialogue: 0,0:00:58.93,0:01:00.68,Default,,0,0,0,,♪ Мен сені таптым ♪
Dialogue: 0,0:01:00.76,0:01:04.56,Default,,0,0,0,,♪ Көз жасының енді мағынасы жоқ ♪
Dialogue: 0,0:01:04.64,0:01:07.02,Default,,0,0,0,,♪ Ол тез айналады ♪
Dialogue: 0,0:01:07.10,0:01:08.48,Default,,0,0,0,,♪ Дүниенің түкпірінде ♪
Dialogue: 0,0:01:08.56,0:01:11.48,Default,,0,0,0,,♪ Бұл айқай ♪ сияқты
Dialogue: 0,0:01:11.57,0:01:12.98,Default,,0,0,0,,♪ Тыныс алу ♪
Dialogue: 0,0:01:13.07,0:01:16.99,Default,,0,0,0,,♪ Мыңдаған жылдар өткен соң қайта кездессек ♪
Dialogue: 0,0:01:17.07,0:01:20.87,Default,,0,0,0,,♪ Үмітсіздіктен ары күліңіз ♪
Dialogue: 0,0:01:26.41,0:01:27.71,Default,,0,0,0,,(Ашық ән~♪)
Dialogue: 0,0:01:31.59,0:01:32.92,Default,,0,0,0,,(Түсіну дыбысы)
Dialogue: 0,0:01:33.00,0:01:34.80,Default,,0,0,0,,Уау... уф
Dialogue: 0,0:01:36.09,0:01:38.55,Default,,0,0,0,,(Адасқан жынның айқайы)
Dialogue: 0,0:01:50.15,0:01:52.69,Default,,0,0,0,,(Мазасыз музыка)
Dialogue: 0,0:01:55.24,0:01:56.07,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:01:56.78,0:01:58.82,Default,,0,0,0,,Сіз мені мұнда шынымен әкелесіз деп ойламаймын.
Dialogue: 0,0:01:59.70,0:02:04.08,Default,,0,0,0,,Бірақ... қазірдің өзінде кеш. Жою - жалғыз жол.
Dialogue: 0,0:02:04.66,0:02:08.21,Default,,0,0,0,,Бұл ешқашан кеш емес. Жақында Musica осында болады.
Dialogue: 0,0:02:09.12,0:02:11.08,Default,,0,0,0,,Мен енді мұны істей алмаймын
Dialogue: 0,0:02:12.09,0:02:16.17,Default,,0,0,0,,Ферма біздің не істегенімізді міндетті түрде біледі.
Dialogue: 0,0:02:17.42,0:02:17.92,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:18.01,0:02:20.43,Default,,0,0,0,,Бірақ Норман, сіз мұны қаламайсыз.
Dialogue: 0,0:02:22.51,0:02:25.56,Default,,0,0,0,,(Норман) Неге, мен сені өлтіре алмадым.
Dialogue: 0,0:02:29.10,0:02:30.94,Default,,0,0,0,,(Норман) Эмма... Мен шештім.
Dialogue: 0,0:02:31.65,0:02:34.44,Default,,0,0,0,,Мен енді Норманның мені өлтіруіне жол бермеймін.
Dialogue: 0,0:02:34.52,0:02:36.86,Default,,0,0,0,,Ол Норманды жалғыз қалдырмайды.
Dialogue: 0,0:02:38.07,0:02:39.90,Default,,0,0,0,,Бұл шынымен ауыртпалық емес пе?
Dialogue: 0,0:02:40.53,0:02:44.58,Default,,0,0,0,,Бірақ мен ақылдымын, сондықтан сенімді жолды таңдаймын.
Dialogue: 0,0:02:44.66,0:02:48.20,Default,,0,0,0,,Ол сондай мейірімді, ол әркімнің салмағын иығында көтереді.
Dialogue: 0,0:02:49.29,0:02:50.79,Default,,0,0,0,,Құдай сияқты
Dialogue: 0,0:02:58.80,0:03:00.55,Default,,0,0,0,,Сіз неден қорқасыз?
Dialogue: 0,0:03:01.30,0:03:02.26,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:03:02.97,0:03:04.85,Default,,0,0,0,,Маған қазір Норман.
Dialogue: 0,0:03:04.93,0:03:07.22,Default,,0,0,0,,Мен қорқып, қалтырап тұрмын. Мен кішкентай бала сияқтымын.
Dialogue: 0,0:03:09.64,0:03:10.14,Default,,0,0,0,,Норман
Dialogue: 0,0:03:10.23,0:03:12.73,Default,,0,0,0,,(Норман) Келме! Мен осы уақытқа дейін келдім
Dialogue: 0,0:03:13.31,0:03:14.90,Default,,0,0,0,,Менің кері қайтуға ниетім жоқ.
Dialogue: 0,0:03:14.98,0:03:18.36,Default,,0,0,0,,Жоқ, мен сені бұл жолы жалғыз жібермеймін.
Dialogue: 0,0:03:20.36,0:03:21.53,Default,,0,0,0,,Сәлем Норман
Dialogue: 0,0:03:22.61,0:03:25.16,Default,,0,0,0,,Құдайға айналудың қажеті жоқ.
Dialogue: 0,0:03:25.91,0:03:29.04,Default,,0,0,0,,Норман басқаларға қарағанда күшті және мейірімді, бірақ
Dialogue: 0,0:03:29.62,0:03:32.00,Default,,0,0,0,,Бірдей қорқақ және тәкаппар.
Dialogue: 0,0:03:33.71,0:03:34.79,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:03:35.50,0:03:38.59,Default,,0,0,0,,Бізге сеніңіз, бұл қиын
Dialogue: 0,0:03:38.67,0:03:42.55,Default,,0,0,0,,Бізге де азапты және қорқынышты нәрселерді бөл.
Dialogue: 0,0:03:43.13,0:03:44.64,Default,,0,0,0,,Оны сенің арқаңда көтеріп жүруге рұқсат ет
Dialogue: 0,0:03:46.01,0:03:48.06,Default,,0,0,0,,Мен жай ғана...Эмма және басқалар
Dialogue: 0,0:03:48.14,0:03:50.02,Default,,0,0,0,,Маған сенің мені қорғауың керек емес.
Dialogue: 0,0:03:50.64,0:03:53.48,Default,,0,0,0,,Мен Норманның қасында жүргім келеді
Dialogue: 0,0:03:53.56,0:03:54.40,Default,,0,0,0,,Рей
Dialogue: 0,0:03:54.48,0:03:57.07,Default,,0,0,0,,Адамдарға берілмеуді айт
Dialogue: 0,0:03:57.15,0:04:00.74,Default,,0,0,0,,Қайта жалғыз қиналатын болашақты таңдайсыз ба?
Dialogue: 0,0:04:00.82,0:04:04.74,Default,,0,0,0,,Ақымақ болма! Сіз бірге өскен отбасыңыз ба?
Dialogue: 0,0:04:06.07,0:04:09.87,Default,,0,0,0,,Эй, сен не істегің келеді, Норман?
Dialogue: 0,0:04:09.95,0:04:11.08,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:04:11.83,0:04:15.58,Default,,0,0,0,,Тым кеш. Артқа қайтару жоқ!
Dialogue: 0,0:04:15.67,0:04:19.13,Default,,0,0,0,,Баяу болу деген нәрсе жоқ. Әлсіз болғаны дұрыс.
Dialogue: 0,0:04:19.21,0:04:21.09,Default,,0,0,0,,Егер бұл нағыз Норман болса
Dialogue: 0,0:04:22.09,0:04:25.22,Default,,0,0,0,,Бірге күресіп, бірге күлейік
Dialogue: 0,0:04:27.93,0:04:30.60,Default,,0,0,0,,Біз бірге өсеміз бе?
Dialogue: 0,0:04:32.23,0:04:33.69,Default,,0,0,0,,Уф…
Dialogue: 0,0:04:45.95,0:04:48.87,Default,,0,0,0,,(Норманның жылауы)
Dialogue: 0,0:04:48.95,0:04:50.45,Default,,0,0,0,,Мен өмір сүргім келеді
Dialogue: 0,0:04:51.12,0:04:54.62,Default,,0,0,0,,Мен өмір сүргім келеді, бірге өмір сүргім келеді
Dialogue: 0,0:04:54.71,0:04:55.96,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:56.67,0:04:59.38,Default,,0,0,0,,Қайта қош келдіңіз Норман
Dialogue: 0,0:04:59.46,0:05:03.34,Default,,0,0,0,,Бірақ бұл әлі де мүмкін емес.
Dialogue: 0,0:05:04.17,0:05:08.14,Default,,0,0,0,,Мен де Ламбда препаратының арқасында ұзақ өмір сүре алмаймын.
Dialogue: 0,0:05:13.27,0:05:14.39,Default,,0,0,0,,(Адасқан жынның тынысы)
Dialogue: 0,0:05:14.48,0:05:15.89,Default,,0,0,0,,(Тосын тыныс)
Dialogue: 0,0:05:21.69,0:05:23.03,Default,,0,0,0,,Мен қазір қашып кетемін.
Dialogue: 0,0:05:23.11,0:05:25.03,Default,,0,0,0,,(Жын дауысы)
Dialogue: 0,0:05:25.11,0:05:28.53,Default,,0,0,0,,Ата! Ата...
Dialogue: 0,0:05:29.82,0:05:30.78,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:05:31.95,0:05:33.49,Default,,0,0,0,,(Жын дауысы)
Dialogue: 0,0:05:33.58,0:05:34.79,Default,,0,0,0,,Сонжу!
Dialogue: 0,0:05:34.87,0:05:36.91,Default,,0,0,0,,Норман ше?
Dialogue: 0,0:05:37.67,0:05:39.17,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:05:40.25,0:05:41.54,Default,,0,0,0,,(Қолдың кесілген дыбысы)
Dialogue: 0,0:05:49.39,0:05:50.64,Default,,0,0,0,,(будың ысқырған дыбысы)
Dialogue: 0,0:05:50.72,0:05:53.18,Default,,0,0,0,,(Онидің ыңырсыуы)
Dialogue: 0,0:05:56.64,0:05:59.06,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:06:00.48,0:06:01.81,Default,,0,0,0,,Әке!
Dialogue: 0,0:06:01.90,0:06:04.32,Default,,0,0,0,,(Жылау кезінде жүгіру дыбысы)
Dialogue: 0,0:06:06.44,0:06:09.82,Default,,0,0,0,,(Жын-ана) Ум... Рахмет.
Dialogue: 0,0:06:09.91,0:06:14.08,Default,,0,0,0,,Ештеңе емес, егер мұны ішсеңіз, бәріңіз қалыпты жағдайға ораласыз.
Dialogue: 0,0:06:14.16,0:06:16.33,Default,,0,0,0,,Балалар, сендер де азғындаудың қажеті жоқ.
Dialogue: 0,0:06:17.25,0:06:19.33,Default,,0,0,0,,Тезірек, ол балаға да сусын беріңіз.
Dialogue: 0,0:06:19.42,0:06:21.83,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:06:23.25,0:06:24.84,Default,,0,0,0,,Сіз бұл музыка деп айттыңыз.
Dialogue: 0,0:06:24.92,0:06:25.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:25.84,0:06:28.84,Default,,0,0,0,,(Вильк) Қанды қызды танисың ба?
Dialogue: 0,0:06:30.84,0:06:31.72,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:06:33.51,0:06:35.22,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:06:35.31,0:06:37.73,Default,,0,0,0,,(Бала жын) Анашым!
Dialogue: 0,0:06:37.81,0:06:39.98,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:43.36,0:06:44.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:46.07,0:06:47.36,Default,,0,0,0,,(Таңқаларлық тыныс)
Dialogue: 0,0:06:48.03,0:06:50.95,Default,,0,0,0,,Келме, Келме
Dialogue: 0,0:06:51.03,0:06:52.24,Default,,0,0,0,,(кіші жын) мені өлтірме
Dialogue: 0,0:06:52.32,0:06:53.74,Default,,0,0,0,,Мені өлтірме
Dialogue: 0,0:06:54.45,0:06:56.74,Default,,0,0,0,,Барлық жындар бірдей
Dialogue: 0,0:06:58.33,0:07:00.12,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:07:00.21,0:07:02.21,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:08.97,0:07:10.34,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:07:12.64,0:07:14.72,Default,,0,0,0,,(Соққы дыбысы)
Dialogue: 0,0:07:16.35,0:07:17.77,Default,,0,0,0,,Ах... күрсін...
Dialogue: 0,0:07:19.98,0:07:21.27,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:21.98,0:07:23.77,Default,,0,0,0,,Неге...уф...
Dialogue: 0,0:07:23.86,0:07:25.27,Default,,0,0,0,,Барбара!
Dialogue: 0,0:07:25.36,0:07:27.28,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:07:29.36,0:07:31.28,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:07:32.86,0:07:36.28,Default,,0,0,0,,Тоқта, Заджи, жеткілікті.
Dialogue: 0,0:07:39.41,0:07:41.21,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:07:42.62,0:07:45.08,Default,,0,0,0,,Босс (Норман) Барлығын кешіріңіз.
Dialogue: 0,0:07:45.84,0:07:48.71,Default,,0,0,0,,Менің істегім келгені жындардан кек алу емес еді.
Dialogue: 0,0:07:49.30,0:07:50.92,Default,,0,0,0,,Бұл сіздің отбасыңызды сақтау туралы.
Dialogue: 0,0:07:52.68,0:07:54.09,Default,,0,0,0,,Мен қателестім
Dialogue: 0,0:07:54.18,0:07:55.60,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:55.68,0:07:57.35,Default,,0,0,0,,Не...?
Dialogue: 0,0:07:58.10,0:08:00.89,Default,,0,0,0,,(Норман) Уақытым жоқ деген сылтау айтамын.
Dialogue: 0,0:08:00.98,0:08:04.23,Default,,0,0,0,,Мен өзім қаламаған жолдың дұрыс екеніне өзімді сендіруге тырыстым.
Dialogue: 0,0:08:05.31,0:08:08.52,Default,,0,0,0,,Мен де сіз сияқты есірткі тәжірибесіне ұшырадым.
Dialogue: 0,0:08:09.40,0:08:12.36,Default,,0,0,0,,Ұстамалар әлдеқашан 4-деңгейге жетті.
Dialogue: 0,0:08:13.20,0:08:14.57,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:15.28,0:08:18.99,Default,,0,0,0,,Өйткені бастық Грейсфилдтің «Арнайы» үлгісінің үлгісі болып табылады.
Dialogue: 0,0:08:19.08,0:08:20.75,Default,,0,0,0,,Бұл эксперименттік тақырып емес еді, солай ма?
Dialogue: 0,0:08:23.12,0:08:26.17,Default,,0,0,0,,Бұл сендер үшін өтірік.
Dialogue: 0,0:08:26.25,0:08:27.88,Default,,0,0,0,,Мен сенімді бастық болғым келді.
Dialogue: 0,0:08:29.05,0:08:31.42,Default,,0,0,0,,Мен сенің уайымдағаныңды немесе алаңдағаныңды қаламадым.
Dialogue: 0,0:08:32.51,0:08:33.34,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:34.30,0:08:37.72,Default,,0,0,0,,Мен қандай да бір түрде емдік препарат жасай аламын деп үміттендім.
Dialogue: 0,0:08:37.80,0:08:40.35,Default,,0,0,0,,Бұл ақпаратты қолдайтындар
Dialogue: 0,0:08:40.43,0:08:42.77,Default,,0,0,0,,Әрқайсысы тазартылды.
Dialogue: 0,0:08:43.43,0:08:45.85,Default,,0,0,0,,Содан кейін шектеулі уақыт ішінде
Dialogue: 0,0:08:45.94,0:08:48.02,Default,,0,0,0,,Мен әлемді өзгертуім керек деп ойладым
Dialogue: 0,0:08:48.98,0:08:52.53,Default,,0,0,0,,Бірақ шындық, мен енді ешкімді өлтіргім келмейді.
Dialogue: 0,0:08:53.82,0:08:57.37,Default,,0,0,0,,Мен жойылуды таңдағым келмейді, мен кеткен уақытта
Dialogue: 0,0:08:57.45,0:09:00.49,Default,,0,0,0,,Бұл жолы мен еш өкінбей таңдау жасағым келеді.
Dialogue: 0,0:09:04.50,0:09:05.37,Default,,0,0,0,,Егер бізге шабуыл жасалса, онда
Dialogue: 0,0:09:10.50,0:09:11.42,Default,,0,0,0,,(Ашу тынысы)
Dialogue: 0,0:09:11.50,0:09:13.30,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:09:13.38,0:09:15.88,Default,,0,0,0,,Мен - біз
Dialogue: 0,0:09:15.97,0:09:18.18,Default,,0,0,0,,Өмір енді маңызды емес
Dialogue: 0,0:09:18.26,0:09:21.18,Default,,0,0,0,,Жындардың жойылуы - барлығы үшін жалғыз құтқару.
Dialogue: 0,0:09:21.26,0:09:22.97,Default,,0,0,0,,We won't give up yet. Біз...
Dialogue: 0,0:09:23.06,0:09:24.23,Default,,0,0,0,,Винсент
Dialogue: 0,0:09:24.98,0:09:28.15,Default,,0,0,0,,Enough is enough, isn't it?
Dialogue: 0,0:09:28.23,0:09:31.86,Default,,0,0,0,,Біз әрқашан барлық ауыртпалықты бастықтарымызға жүктедік.
Dialogue: 0,0:09:32.57,0:09:36.11,Default,,0,0,0,,Even the boss is a human being just like us.
Dialogue: 0,0:09:36.78,0:09:37.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:39.07,0:09:42.12,Default,,0,0,0,,I will take revenge on the demon
Dialogue: 0,0:09:43.12,0:09:44.95,Default,,0,0,0,,Мен әрқашан солай ойлайтынмын.
Dialogue: 0,0:09:46.12,0:09:47.08,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:48.54,0:09:50.75,Default,,0,0,0,,The boss is more important than revenge.
Dialogue: 0,0:09:51.34,0:09:52.50,Default,,0,0,0,,Ааа
Dialogue: 0,0:09:52.59,0:09:54.01,Default,,0,0,0,,ол маған шексіз артықшылық беретін қаруға айналады.
Dialogue: 0,0:09:54.92,0:09:55.76,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:09:55.84,0:09:58.22,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:09:58.30,0:09:59.14,Default,,0,0,0,,Музыка!
Dialogue: 0,0:09:59.84,0:10:01.64,Default,,0,0,0,,Жаман қан...қыз
Dialogue: 0,0:10:01.72,0:10:03.14,Default,,0,0,0,,(Онима дыбысы)
Dialogue: 0,0:10:03.22,0:10:04.35,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:10:06.56,0:10:10.73,Default,,0,0,0,,Қаланың солтүстік жағындағы жын-перілердің көпшілігі бұрынғы қалпына оралды.
Dialogue: 0,0:10:11.31,0:10:14.90,Default,,0,0,0,,Олардың қанын бөліссе болғаны, олар бірдеңе істей алады.
Dialogue: 0,0:10:16.03,0:10:17.40,Default,,0,0,0,,Жақсы
Dialogue: 0,0:10:17.49,0:10:20.41,Default,,0,0,0,,It's better to leave here once.
Dialogue: 0,0:10:20.99,0:10:23.03,Default,,0,0,0,,Бұған дейін бұл адамдардың жұмысы екені белгілі болған
Dialogue: 0,0:10:24.16,0:10:26.54,Default,,0,0,0,,We'll explain the blood thing.
Dialogue: 0,0:10:27.29,0:10:29.29,Default,,0,0,0,,Okay, our place is...
Dialogue: 0,0:10:30.12,0:10:32.29,Default,,0,0,0,,Жолда мен Джилда мен Доннан естідім.
Dialogue: 0,0:10:32.96,0:10:33.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:38.26,0:10:40.68,Default,,0,0,0,,Yes, you guys should drink this too.
Dialogue: 0,0:10:41.26,0:10:42.97,Default,,0,0,0,,I'm sure you'll be fine.
Dialogue: 0,0:10:43.05,0:10:44.18,Default,,0,0,0,,Уау
Dialogue: 0,0:10:51.44,0:10:52.90,Default,,0,0,0,,Рэй!
Dialogue: 0,0:10:53.40,0:10:55.07,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:10:56.65,0:11:00.91,Default,,0,0,0,,Тұрақты радиобайланысқа сәйкес Фил мен оның тобы жөнелтіледі деп шешілді.
Dialogue: 0,0:11:01.49,0:11:02.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:04.33,0:11:07.91,Default,,0,0,0,,(Boss Oni) So what about the Lambda plan? (Питер) Жақсы болып жатыр.
Dialogue: 0,0:11:08.62,0:11:10.54,Default,,0,0,0,,The laboratory was destroyed.
Dialogue: 0,0:11:10.62,0:11:13.88,Default,,0,0,0,,22194 қашып құтылды
Dialogue: 0,0:11:13.96,0:11:16.88,Default,,0,0,0,,I guess I can recover from this blunder.
Dialogue: 0,0:11:17.63,0:11:21.26,Default,,0,0,0,,You were the one who guided our escape...
Dialogue: 0,0:11:21.34,0:11:24.14,Default,,0,0,0,,You can get both of them back.
Dialogue: 0,0:11:24.72,0:11:27.72,Default,,0,0,0,,They're all coming back, right?
Dialogue: 0,0:11:27.81,0:11:29.68,Default,,0,0,0,,Изабелла әже
Dialogue: 0,0:11:30.77,0:11:34.06,Default,,0,0,0,,Yes, in the shelter we raided.
Dialogue: 0,0:11:34.15,0:11:37.53,Default,,0,0,0,,Онда болуы керек радио да қалмады.
Dialogue: 0,0:11:38.19,0:11:41.95,Default,,0,0,0,,Қашып кеткен балалар бұл радионы иемденді.
Dialogue: 0,0:11:42.03,0:11:45.66,Default,,0,0,0,,Ферманың радиотолқындары бірінен соң бірі тоқтатылып жатыр деген болжам бар.
Dialogue: 0,0:11:46.49,0:11:49.29,Default,,0,0,0,,There, through radio
Dialogue: 0,0:11:49.37,0:11:53.46,Default,,0,0,0,,Грейсфилд фермасында барлығына жүк тасымалдау туралы ақпарат шығарылды.
Dialogue: 0,0:11:54.96,0:11:57.88,Default,,0,0,0,,They return to the rescue.
Dialogue: 0,0:11:58.55,0:12:00.59,Default,,0,0,0,,Will everyone be shipped?
Dialogue: 0,0:12:00.67,0:12:03.72,Default,,0,0,0,,Put the lambda plan into action
Dialogue: 0,0:12:03.80,0:12:07.26,Default,,0,0,0,,Барлық фермаларды бір Lambda түріндегі фермаға біріктіріңіз
Dialogue: 0,0:12:07.93,0:12:11.73,Default,,0,0,0,,Ескі қымбат, жоғары тәуекелді өндірістік желілерді жойыңыз
Dialogue: 0,0:12:11.81,0:12:14.40,Default,,0,0,0,,Жаңа препараттармен мидың мәжбүрлі дамуы
Dialogue: 0,0:12:14.48,0:12:17.52,Default,,0,0,0,,Жоғары сапалы жеуге жарамды балаларды сенімді түрде алыңыз
Dialogue: 0,0:12:18.23,0:12:21.90,Default,,0,0,0,,Қай жылғы жеміс беретіні маңызды емес, ол жеуге болатын ең жақсы нәресте.
Dialogue: 0,0:12:21.99,0:12:23.90,Default,,0,0,0,,Әрқашан және мүмкіндігінше
Dialogue: 0,0:12:23.99,0:12:27.03,Default,,0,0,0,,Бұдан былай сіз өз өніміңізді бере аласыз.
Dialogue: 0,0:12:28.70,0:12:29.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:29.99,0:12:33.87,Default,,0,0,0,,Бірақ кейбір жаппай өнім шығаратын шаруашылықтарды жалғыз қалдыру керек.
Dialogue: 0,0:12:33.96,0:12:35.92,Default,,0,0,0,,Бізге қарапайым халықтың еті де керек.
Dialogue: 0,0:12:36.00,0:12:38.00,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:12:39.67,0:12:41.92,Default,,0,0,0,,Енді лямбда жобасын бастаңыз
Dialogue: 0,0:12:42.72,0:12:43.55,Default,,0,0,0,,Иә
Dialogue: 0,0:12:53.52,0:12:55.69,Default,,0,0,0,,Сіз нені білдіреді?
Dialogue: 0,0:12:55.77,0:12:59.06,Default,,0,0,0,,Кенеттен барлығы жөнелтілді.
Dialogue: 0,0:12:59.15,0:13:02.82,Default,,0,0,0,,Біртүрлі. Бастапқыда 6 жастан бастап жіберілді.
Dialogue: 0,0:13:02.90,0:13:05.49,Default,,0,0,0,,Тым ерте (Норман) Ламбда.
Dialogue: 0,0:13:06.49,0:13:08.28,Default,,0,0,0,,Ламбда деректері қалды.
Dialogue: 0,0:13:08.99,0:13:10.16,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:10.74,0:13:12.79,Default,,0,0,0,,Дәрі-дәрмек пен эксперимент арқылы ламбда —
Dialogue: 0,0:13:12.87,0:13:16.83,Default,,0,0,0,,Бұл миы дамыған жеуге жарамды балаларды шығаруға арналған сынақ алаңы.
Dialogue: 0,0:13:18.00,0:13:19.79,Default,,0,0,0,,Болашақта ферма қандай болады?
Dialogue: 0,0:13:19.88,0:13:22.67,Default,,0,0,0,,Барлық шаруа қожалықтары жаңа фермалармен ауыстырылады деп жоспарланған болатын.
Dialogue: 0,0:13:23.42,0:13:25.09,Default,,0,0,0,,Грейсфилд сияқты
Dialogue: 0,0:13:25.17,0:13:28.68,Default,,0,0,0,,Жоғары шығындар мен тәуекелді әдістер жойылады
Dialogue: 0,0:13:28.76,0:13:30.93,Default,,0,0,0,,Ламбданы жойыңыз
Dialogue: 0,0:13:31.01,0:13:33.93,Default,,0,0,0,,Мен бұл жоспарды бұза аламын деп ойладым, бірақ...
Dialogue: 0,0:13:34.48,0:13:37.69,Default,,0,0,0,,Сонымен Фил және басқалары ламбдалар сияқты...
Dialogue: 0,0:13:37.77,0:13:39.06,Default,,0,0,0,,Шаруашылықтың жаңа түрі?
Dialogue: 0,0:13:40.23,0:13:41.07,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:13:41.15,0:13:45.36,Default,,0,0,0,,Қарғыс атсын... біз сол тозақты қайтадан бастаймыз ба?
Dialogue: 0,0:13:45.44,0:13:46.57,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:13:47.24,0:13:48.82,Default,,0,0,0,,Мен көмекке баруым керек.
Dialogue: 0,0:13:48.91,0:13:50.78,Default,,0,0,0,,Бірақ... қалай?
Dialogue: 0,0:13:50.87,0:13:54.08,Default,,0,0,0,,Сондай-ақ, бұл бірінші кезекте бізді азғыру үшін жасалған тұзақ болуы мүмкін.
Dialogue: 0,0:13:54.16,0:13:56.33,Default,,0,0,0,,Тіпті солай болса да, мен кетуім керек.
Dialogue: 0,0:13:56.41,0:13:59.46,Default,,0,0,0,,Ақымақ Грейсфилд т.б.
Dialogue: 0,0:13:59.54,0:14:02.96,Default,,0,0,0,,Бұл кез келген жерде ең қатаң қауіпсіздігі бар жоғары деңгейдегі ферма.
Dialogue: 0,0:14:03.05,0:14:05.67,Default,,0,0,0,,Көмек беру былай тұрсын, басып кіру де мүмкін емес.
Dialogue: 0,0:14:05.76,0:14:06.92,Default,,0,0,0,,(Тосын тыныс)
Dialogue: 0,0:14:08.68,0:14:11.10,Default,,0,0,0,,Эмма Музыка!
Dialogue: 0,0:14:12.72,0:14:14.60,Default,,0,0,0,,Қала туралы не деуге болады? Жарайды
Dialogue: 0,0:14:15.18,0:14:16.35,Default,,0,0,0,,(бақытты тыныс)
Dialogue: 0,0:14:16.43,0:14:19.48,Default,,0,0,0,,Бірақ ферма байқаса
Dialogue: 0,0:14:19.56,0:14:21.86,Default,,0,0,0,,Бұл қаладағы барлық адамдар аңға түседі.
Dialogue: 0,0:14:23.69,0:14:26.65,Default,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:14:26.74,0:14:29.07,Default,,0,0,0,,Біз азғындықтан құтылмайынша
Dialogue: 0,0:14:29.15,0:14:31.66,Default,,0,0,0,,Ерте ме, кеш пе адасқанға айналады.
Dialogue: 0,0:14:31.74,0:14:34.70,Default,,0,0,0,,Олар бір-бірімен соғысатын еді.
Dialogue: 0,0:14:35.29,0:14:36.12,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:14:36.91,0:14:40.25,Default,,0,0,0,,Менің атым Вирк. 700 жыл бұрын.
Dialogue: 0,0:14:40.33,0:14:43.00,Default,,0,0,0,,Мен сен арқылы құтқарылған аман қалдым.
Dialogue: 0,0:14:44.42,0:14:46.01,Default,,0,0,0,,Сіз... осы қаннан
Dialogue: 0,0:14:46.09,0:14:48.80,Default,,0,0,0,,(Тыныш күлкі дыбысы)
Dialogue: 0,0:14:50.22,0:14:52.51,Default,,0,0,0,,Саған бергім келетін бір нәрсе бар.
Dialogue: 0,0:14:57.85,0:14:58.85,Default,,0,0,0,,Иә
Dialogue: 0,0:15:00.77,0:15:02.90,Default,,0,0,0,,Бұл... қаламның
Dialogue: 0,0:15:03.48,0:15:06.03,Default,,0,0,0,,Бұл шамамен 15 жыл бұрын болды
Dialogue: 0,0:15:06.11,0:15:08.90,Default,,0,0,0,,Ауылдың сыртында өлі табылды.
Dialogue: 0,0:15:08.99,0:15:11.41,Default,,0,0,0,,Бұл адамдарда бар нәрсе болды.
Dialogue: 0,0:15:13.49,0:15:14.66,Default,,0,0,0,,(Мистикалық музыка)
Dialogue: 0,0:15:14.74,0:15:16.99,Default,,0,0,0,,Мен түсінгенде
Dialogue: 0,0:15:17.49,0:15:20.37,Default,,0,0,0,,Әр жерден қан иісі шықты.
Dialogue: 0,0:15:21.46,0:15:25.63,Default,,0,0,0,,Көре алмасаңыз да, қатты қиналғаныңызды білдім.
Dialogue: 0,0:15:26.55,0:15:29.72,Default,,0,0,0,,Осында қалдырсаң, жабайы табиғатта табылады.
Dialogue: 0,0:15:29.80,0:15:33.93,Default,,0,0,0,,Мен жегенім аз ғана уақыт болды деп ойладым.
Dialogue: 0,0:15:36.64,0:15:40.27,Default,,0,0,0,,Мен жақындағанымда да ол түсінбеген сияқты.
Dialogue: 0,0:15:41.10,0:15:45.06,Default,,0,0,0,,Менің ойымша, ол есін жоғалтқысы келді және ұйықтауға жақын болды.
Dialogue: 0,0:15:46.44,0:15:50.82,Default,,0,0,0,,Мен оны соңғы демімді алайын деп тұрғанша ұстадым.
Dialogue: 0,0:15:51.53,0:15:55.41,Default,,0,0,0,,Маңызды сияқты өмір сүруге тырысу
Dialogue: 0,0:15:56.41,0:15:59.83,Default,,0,0,0,,«Мұны жеуге жарамды балаларға беріңіз»
Dialogue: 0,0:15:59.91,0:16:03.33,Default,,0,0,0,,«Оларға біраз үміт беріңіз»
Dialogue: 0,0:16:05.50,0:16:08.00,Default,,0,0,0,,Мен ол адамды жедім.
Dialogue: 0,0:16:08.09,0:16:09.51,Default,,0,0,0,,(Таңқаларлық тыныс)
Dialogue: 0,0:16:09.59,0:16:11.51,Default,,0,0,0,,Рәсімді орындаңыз
Dialogue: 0,0:16:11.59,0:16:15.09,Default,,0,0,0,,Ол етті отбасымен бөлісті.
Dialogue: 0,0:16:16.22,0:16:19.52,Default,,0,0,0,,Өмір сүруге талпынған адамдарды көру
Dialogue: 0,0:16:21.48,0:16:24.44,Default,,0,0,0,,Адамдар тек тамақ емес
Dialogue: 0,0:16:24.52,0:16:26.31,Default,,0,0,0,,Ерік-жігері бар нәрсе
Dialogue: 0,0:16:27.19,0:16:29.23,Default,,0,0,0,,Мен де олар үшін өз өмірімді тәуекел еттім.
Dialogue: 0,0:16:29.32,0:16:32.03,Default,,0,0,0,,Мен қорғағым келетін бір нәрсе бар екенін түсіндім.
Dialogue: 0,0:16:32.99,0:16:34.28,Default,,0,0,0,,Бірақ мен оны жедім.
Dialogue: 0,0:16:35.82,0:16:37.74,Default,,0,0,0,,Мен соңғы 700 жылмын
Dialogue: 0,0:16:37.83,0:16:40.49,Default,,0,0,0,,Мен қаным жаман екенін жасырып өмір сүрдім.
Dialogue: 0,0:16:41.50,0:16:44.87,Default,,0,0,0,,Жеуге қажет емес ет болған шығар.
Dialogue: 0,0:16:44.96,0:16:48.34,Default,,0,0,0,,Айналасындағылардың бәрі аштық пен азғындықтан зардап шегеді.
Dialogue: 0,0:16:48.42,0:16:50.88,Default,,0,0,0,,Осы қанның күшін пайдалансаң...
Dialogue: 0,0:16:50.96,0:16:53.92,Default,,0,0,0,,Егер мен әрекет жасасам
Dialogue: 0,0:16:54.01,0:16:56.89,Default,,0,0,0,,Көптеген адамдардың өмірін сақтап қалуға болатын еді.
Dialogue: 0,0:16:59.64,0:17:02.73,Default,,0,0,0,,Бірақ мұны істесеңіз, сіз де...
Dialogue: 0,0:17:02.81,0:17:06.31,Default,,0,0,0,,Бұл сіздің отбасыңыздың өміріне де қауіп төндіреді.
Dialogue: 0,0:17:07.98,0:17:08.90,Default,,0,0,0,,Сонымен—
Dialogue: 0,0:17:09.40,0:17:13.07,Default,,0,0,0,,Мен өзіме-өзім айттым да, көзім жұмылды.
Dialogue: 0,0:17:17.32,0:17:20.16,Default,,0,0,0,,Мен мұнда мәңгілік дұға етіп келемін
Dialogue: 0,0:17:20.24,0:17:22.20,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:17:22.29,0:17:23.41,Default,,0,0,0,,(Ойланған тыныс)
Dialogue: 0,0:17:25.66,0:17:27.50,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:17:27.58,0:17:30.25,Default,,0,0,0,,Мүмкін біз бір нәрсені өзгерте аламыз
Dialogue: 0,0:17:31.13,0:17:34.55,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін.
Dialogue: 0,0:17:34.63,0:17:36.84,Default,,0,0,0,,Мен оны саған бердім.
Dialogue: 0,0:17:37.84,0:17:39.09,Default,,0,0,0,,Иә
Dialogue: 0,0:17:43.27,0:17:44.10,Default,,0,0,0,,(Таңқаларлық тыныс)
Dialogue: 0,0:17:47.64,0:17:51.40,Default,,0,0,0,,Бұл ферма бас кеңсесінің жобасы ма?
Dialogue: 0,0:17:51.48,0:17:54.36,Default,,0,0,0,,Бұл өтірік... бұл тек ішкі карта емес.
Dialogue: 0,0:17:54.94,0:17:58.41,Default,,0,0,0,,Ғимарат ішіндегі қауіпсіздікті ұйымдастыру, сымдар мен тізбектер
Dialogue: 0,0:17:58.49,0:17:59.99,Default,,0,0,0,,Барлығы жазылған.
Dialogue: 0,0:18:00.74,0:18:04.24,Default,,0,0,0,,Бұл адам әлеміне апаратын қақпа ма?
Dialogue: 0,0:18:04.95,0:18:07.25,Default,,0,0,0,,Эй, егер менде бұл болса...
Dialogue: 0,0:18:07.33,0:18:09.25,Default,,0,0,0,,Фил және басқаларды сақтауға болады
Dialogue: 0,0:18:09.33,0:18:11.00,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:18:15.09,0:18:17.51,Default,,0,0,0,,Винсент, мына жерге қара.
Dialogue: 0,0:18:18.43,0:18:21.26,Default,,0,0,0,,Бұл… медицина…
Dialogue: 0,0:18:21.35,0:18:22.64,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:23.35,0:18:27.14,Default,,0,0,0,,Бұл жанама әсерлерді емдеуге арналған дәрі. Біз оны қалай жасау керектігін де білдік!
Dialogue: 0,0:18:27.23,0:18:30.90,Default,,0,0,0,,Сонымен... біз аман қала аламыз ба...?
Dialogue: 0,0:18:32.48,0:18:33.32,Default,,0,0,0,,Иә
Dialogue: 0,0:18:34.48,0:18:36.15,Default,,0,0,0,,(Көз жасымен тыныс алу)
Dialogue: 0,0:18:36.74,0:18:38.65,Default,,0,0,0,,Менің ойымша, бұл үшін өлу керек емес.
Dialogue: 0,0:18:39.24,0:18:41.16,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:18:42.24,0:18:44.66,Default,,0,0,0,,Босс (Барбара) Босс Жақсы.
Dialogue: 0,0:18:45.83,0:18:47.87,Default,,0,0,0,,Иә, өмір сүрейік
Dialogue: 0,0:18:48.37,0:18:51.54,Default,,0,0,0,,Үмітімді байланыстыра алғаныма қуаныштымын.
Dialogue: 0,0:18:54.59,0:18:55.42,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:19:05.26,0:19:06.10,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:19:07.35,0:19:09.94,Default,,0,0,0,,Сіз және сіздің отбасыңыз...
Dialogue: 0,0:19:11.02,0:19:11.98,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:19:16.78,0:19:18.69,Default,,0,0,0,,(Немере Онидің аяқ дыбысы)
Dialogue: 0,0:19:18.78,0:19:19.95,Default,,0,0,0,,(Тосын тыныс)
Dialogue: 0,0:19:21.91,0:19:26.83,Default,,0,0,0,,Ум...сен біздің бірімізсің.
Dialogue: 0,0:19:26.91,0:19:29.66,Default,,0,0,0,,Сіздің басыңыздан көптеген қорқынышты оқиғалар болды, солай емес пе?
Dialogue: 0,0:19:30.41,0:19:31.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:36.30,0:19:37.71,Default,,0,0,0,,Куууу…
Dialogue: 0,0:19:40.55,0:19:42.93,Default,,0,0,0,,Біз кеткелі жатырмыз
Dialogue: 0,0:19:43.84,0:19:45.26,Default,,0,0,0,,(Вилк) Эмма иә?
Dialogue: 0,0:19:48.93,0:19:49.77,Default,,0,0,0,,Егер мен басынан бастап араласқан болсам, сенің қолдарың мен құлақтарың—
Dialogue: 0,0:19:50.98,0:19:52.27,Default,,0,0,0,,Эмма?
Dialogue: 0,0:19:52.35,0:19:53.77,Default,,0,0,0,,Ух...иә
Dialogue: 0,0:19:56.94,0:19:59.82,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:20:05.99,0:20:09.91,Default,,0,0,0,,Сізге көп рахмет, Вирк мырза.
Dialogue: 0,0:20:10.75,0:20:14.37,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:20:15.83,0:20:17.42,Default,,0,0,0,,Бұл Эмма.
Dialogue: 0,0:20:18.38,0:20:22.38,Default,,0,0,0,,Мен Эмма міндетті түрде әркімнің жолын таңдайды деп ойладым.
Dialogue: 0,0:20:23.05,0:20:25.05,Default,,0,0,0,,Барлығы, соның ішінде жындар.
Dialogue: 0,0:20:26.35,0:20:28.31,Default,,0,0,0,,Себебі Эмма жойылуды таңдаған жоқ.
Dialogue: 0,0:20:28.93,0:20:33.06,Default,,0,0,0,,Енді бұл ақпарат, енді бұл шындық.
Dialogue: 0,0:20:33.64,0:20:36.56,Default,,0,0,0,,Сіз қозғалған кезде мұндай нәрселер туралы ойламайсыз, солай ма?
Dialogue: 0,0:20:42.19,0:20:44.78,Default,,0,0,0,,Филге және басқаларға көмектесейік.
Dialogue: 0,0:20:46.41,0:20:47.32,Default,,0,0,0,,Иә
Dialogue: 0,0:20:48.28,0:20:49.16,Default,,0,0,0,,(күлімсіреген тыныс)
Dialogue: 0,0:20:50.24,0:20:53.79,Default,,0,0,0,,Жарайды, Грейс далалық үйіне барайық!
Dialogue: 0,0:20:53.87,0:20:56.04,Default,,0,0,0,,Оу!
Dialogue: 0,0:21:07.89,0:21:10.56,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:11.60,0:21:13.35,Default,,0,0,0,,Бұл Грейсфилд.
Dialogue: 0,0:21:14.23,0:21:15.19,Default,,0,0,0,,Ақпарат бар
Dialogue: 0,0:21:16.27,0:21:17.94,Default,,0,0,0,,Мен сауда жасағым келеді
Dialogue: 0,0:21:18.02,0:21:20.52,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:21:22.11,0:21:24.11,Default,,0,0,0,,(♪~Соңындағы ән)
Dialogue: 0,0:21:24.19,0:21:29.70,Default,,0,0,0,,♪ Бір тілесең, Ай көлеңкесін ♪
Dialogue: 0,0:21:29.78,0:21:32.16,Default,,0,0,0,,♪ Қандай сиқырлы түн ♪
Dialogue: 0,0:21:32.24,0:21:34.71,Default,,0,0,0,,♪ Оны шешетініңізге сенімдімін ♪
Dialogue: 0,0:21:46.05,0:21:48.76,Default,,0,0,0,,♪ Даусыңыз анық ♪
Dialogue: 0,0:21:48.84,0:21:51.47,Default,,0,0,0,,♪ Жел түнді ♪ жариялады
Dialogue: 0,0:21:51.56,0:21:56.85,Default,,0,0,0,,♪ Көк әлемде бәрі ертегіде ұйықтайды ♪
Dialogue: 0,0:21:56.94,0:21:59.65,Default,,0,0,0,,♪ Ұйқыдасың ♪
Dialogue: 0,0:21:59.73,0:22:02.36,Default,,0,0,0,,♪ Мен жабылған қабақтарымды аштым ♪
Dialogue: 0,0:22:02.44,0:22:05.53,Default,,0,0,0,,♪ Мен ойлағаннан да көп ♪
Dialogue: 0,0:22:05.61,0:22:08.16,Default,,0,0,0,,♪ Бұлыңғыр болмаңыз ♪
Dialogue: 0,0:22:10.16,0:22:14.62,Default,,0,0,0,,♪ Бұл дауыс сізге жетсе ♪
Dialogue: 0,0:22:14.70,0:22:16.04,Default,,0,0,0,,♪ Жауап жоқ ♪
Dialogue: 0,0:22:16.12,0:22:17.37,Default,,0,0,0,,♪ Мен әлі де қалғым келеді ♪
Dialogue: 0,0:22:17.46,0:22:20.67,Default,,0,0,0,,♪ Мен оқиғаның аяқталғанын қаламаймын ♪
Dialogue: 0,0:22:20.75,0:22:25.76,Default,,0,0,0,,♪ Бұл түннен асып кет ♪
Dialogue: 0,0:22:25.84,0:22:26.88,Default,,0,0,0,,♪ Сізбен ♪
Dialogue: 0,0:22:26.97,0:22:29.84,Default,,0,0,0,,♪ Маған сөз керек емес, сондықтан әзірше ♪
Dialogue: 0,0:22:29.93,0:22:32.89,Default,,0,0,0,,♪ Мен бір-бірінің жылуын растағым келеді ♪
Dialogue: 0,0:22:32.97,0:22:33.89,Default,,0,0,0,,♪ Өтінемін ♪
Dialogue: 0,0:22:33.97,0:22:36.52,Default,,0,0,0,,♪ Мен ♪ оянбайтын түс көрейін
Dialogue: 0,0:22:36.60,0:22:39.60,Default,,0,0,0,,♪ Ол қол біздікі ♪
Dialogue: 0,0:22:39.69,0:22:44.32,Default,,0,0,0,,♪ Босатпай, ақырын тіледім ♪
Dialogue: 0,0:22:47.74,0:22:49.78,Default,,0,0,0,,(Соңғы ән~♪)
Dialogue: 0,0:22:51.28,0:22:56.28,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
