Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(♪~Ашық ән)
Dialogue: 0,0:00:16.80,0:00:20.93,Default,,0,0,0,,♪ есімде қалдым есімде ♪
Dialogue: 0,0:00:21.02,0:00:24.77,Default,,0,0,0,,♪ Бір көзді ашып-жұмғанша және үмітсіздік сезімі ♪
Dialogue: 0,0:00:24.85,0:00:28.73,Default,,0,0,0,,♪ Мен оянсам да, мен әлі түс көрдім ♪
Dialogue: 0,0:00:28.82,0:00:33.07,Default,,0,0,0,,♪ Біздің сәттеріміз жарқыраған оқиға ♪
Dialogue: 0,0:00:33.15,0:00:37.45,Default,,0,0,0,,♪ Сағаттың секунд тілі ♪
Dialogue: 0,0:00:37.53,0:00:40.12,Default,,0,0,0,,♪ Кішкене күліңіз ♪
Dialogue: 0,0:00:40.20,0:00:42.79,Default,,0,0,0,,♪ Сізге толы ♪
Dialogue: 0,0:00:42.87,0:00:46.12,Default,,0,0,0,,♪ Толық болды ♪
Dialogue: 0,0:00:48.88,0:00:53.05,Default,,0,0,0,,♪ Ертең мұзды құрт ♪
Dialogue: 0,0:00:53.13,0:00:53.97,Default,,0,0,0,,♪ Қалай болғанда да ♪
Dialogue: 0,0:00:54.05,0:00:56.97,Default,,0,0,0,,♪ Мен жоғалтқым келмейтін нәрселер бар ♪
Dialogue: 0,0:00:57.05,0:00:58.76,Default,,0,0,0,,♪ Тағдырдан тыс ♪
Dialogue: 0,0:00:58.85,0:01:00.68,Default,,0,0,0,,♪ Мен сені таптым ♪
Dialogue: 0,0:01:00.76,0:01:04.56,Default,,0,0,0,,♪ Көз жасының енді мағынасы жоқ ♪
Dialogue: 0,0:01:04.64,0:01:07.02,Default,,0,0,0,,♪ Ол тез айналады ♪
Dialogue: 0,0:01:07.10,0:01:08.48,Default,,0,0,0,,♪ Дүниенің түкпірінде ♪
Dialogue: 0,0:01:08.56,0:01:11.40,Default,,0,0,0,,♪ Бұл айқай ♪ сияқты
Dialogue: 0,0:01:11.48,0:01:12.98,Default,,0,0,0,,♪ Тыныс алу ♪
Dialogue: 0,0:01:13.07,0:01:16.99,Default,,0,0,0,,♪ Мыңдаған жылдар өткен соң қайта кездессек ♪
Dialogue: 0,0:01:17.07,0:01:20.87,Default,,0,0,0,,♪ Үмітсіздіктен ары күліңіз ♪
Dialogue: 0,0:01:26.41,0:01:27.71,Default,,0,0,0,,(Ашық ән~♪)
Dialogue: 0,0:01:32.00,0:01:33.55,Default,,0,0,0,,Біз болған үшінші зауыт болды
Dialogue: 0,0:01:34.30,0:01:37.01,Default,,0,0,0,,Өрттен кейін ол өшірілді және Фил мен оның достары...
Dialogue: 0,0:01:37.09,0:01:39.51,Default,,0,0,0,,Басқа төрт зауытқа таратылды
Dialogue: 0,0:01:40.22,0:01:42.22,Default,,0,0,0,,Әр зауытта шамамен 40 адам
Dialogue: 0,0:01:42.89,0:01:46.56,Default,,0,0,0,,Олардың барлығын шығарып, штабтың жертөлесінің ең терең жеріндегі «қақпаға» барыңыз.
Dialogue: 0,0:01:47.52,0:01:51.56,Default,,0,0,0,,Ол жерге апаратын жалғыз нәрсе - бұл тікелей лифт.
Dialogue: 0,0:01:51.65,0:01:53.94,Default,,0,0,0,,Мақсат - алдымен осында жету.
Dialogue: 0,0:01:54.57,0:01:56.69,Default,,0,0,0,,Бірақ қақпашы үндемейді.
Dialogue: 0,0:01:56.78,0:01:58.07,Default,,0,0,0,,Қақпашы?
Dialogue: 0,0:01:58.15,0:02:01.83,Default,,0,0,0,,(Норман) Питер Лартли Джеймс Лартлидің інісі.
Dialogue: 0,0:02:01.91,0:02:03.20,Default,,0,0,0,,Минерваның…
Dialogue: 0,0:02:03.87,0:02:06.20,Default,,0,0,0,,Оның қасында әпкелері бар.
Dialogue: 0,0:02:06.87,0:02:10.08,Default,,0,0,0,,Жынның қауіпсіздігі әдетте 30-40 болады
Dialogue: 0,0:02:10.17,0:02:13.17,Default,,0,0,0,,Біз екеуін де жеңуіміз керек.
Dialogue: 0,0:02:13.25,0:02:16.34,Default,,0,0,0,,Жеуге жарамды балаларды құтқару үшін қашқын келе жатыр ма?
Dialogue: 0,0:02:17.05,0:02:20.09,Default,,0,0,0,,(Винсент) О, олар шындықты көре алмайды.
Dialogue: 0,0:02:21.30,0:02:22.85,Default,,0,0,0,,Иттің өліміне өкінемін.
Dialogue: 0,0:02:23.43,0:02:25.77,Default,,0,0,0,,Бұл оның саған опасыздық жасайтынын білдіре ме?
Dialogue: 0,0:02:25.85,0:02:28.48,Default,,0,0,0,,Операцияның егжей-тегжейлерін айтудың орнына
Dialogue: 0,0:02:28.56,0:02:30.60,Default,,0,0,0,,Менің қауіпсіздігіме кепілдік беруіңізді қалаймын.
Dialogue: 0,0:02:31.52,0:02:32.44,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:32.52,0:02:34.86,Default,,0,0,0,,(Винсент) Сіз жындар ауылындағы оқиға туралы білесіз бе?
Dialogue: 0,0:02:35.90,0:02:39.45,Default,,0,0,0,,Бұл біз жасаған препаратпен тәжірибе болды.
Dialogue: 0,0:02:42.12,0:02:44.66,Default,,0,0,0,,(Питер) Жарайды, мен саған сенемін.
Dialogue: 0,0:02:45.95,0:02:48.00,Default,,0,0,0,,Ол химиялық заттарды шашу үшін дайындалған.
Dialogue: 0,0:02:48.08,0:02:50.00,Default,,0,0,0,,Шар бар
Dialogue: 0,0:02:50.96,0:02:54.00,Default,,0,0,0,,Жаңа айдың қараңғылығын пайдаланып, барлығы кемеге мінеді
Dialogue: 0,0:02:54.09,0:02:55.63,Default,,0,0,0,,Аспаннан химиялық заттарды шашу
Dialogue: 0,0:02:56.71,0:02:58.63,Default,,0,0,0,,Қауіпсіздікті жойғаннан кейін
Dialogue: 0,0:02:58.72,0:03:01.43,Default,,0,0,0,,Әр өсімдікке тарап, басып кірді.
Dialogue: 0,0:03:01.51,0:03:05.76,Default,,0,0,0,,Жеуге жарамды баланы босатып, аспаннан қашуды жоспарлаңыз.
Dialogue: 0,0:03:08.39,0:03:09.27,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:03:09.35,0:03:10.98,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:11.06,0:03:15.11,Default,,0,0,0,,Фермадағы қауіпсіздік химиялық бүркуге дайындық кезінде өзгертілді.
Dialogue: 0,0:03:15.82,0:03:18.03,Default,,0,0,0,,Әпкелерді орналастыру да аяқталды
Dialogue: 0,0:03:18.69,0:03:20.90,Default,,0,0,0,,Сәттілік Изабелла әже
Dialogue: 0,0:03:20.99,0:03:22.03,Default,,0,0,0,,(иіскейді)
Dialogue: 0,0:03:22.11,0:03:23.11,Default,,0,0,0,,(мырылдады)
Dialogue: 0,0:03:23.20,0:03:26.53,Default,,0,0,0,,(Питер) Сәтсіздік жасаудың пайдасы жоқ, бірақ Норман...
Dialogue: 0,0:03:27.91,0:03:31.04,Default,,0,0,0,,Сіз әлі де Lambda жобасы үшін үлгі ретінде қызмет ете аласыз.
Dialogue: 0,0:03:32.58,0:03:34.79,Default,,0,0,0,,Қашқын қашып құтылсын
Dialogue: 0,0:03:34.88,0:03:36.42,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:03:36.50,0:03:37.84,Default,,0,0,0,,Мен оны ұстадым! Уау
Dialogue: 0,0:03:37.92,0:03:39.55,Default,,0,0,0,,Сіз сақтығыңызды түсірдіңіз, Фил.
Dialogue: 0,0:03:39.63,0:03:42.38,Default,,0,0,0,,Иә! Енді мен...
Dialogue: 0,0:03:42.47,0:03:43.30,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:47.39,0:03:49.81,Default,,0,0,0,,Кәне, бәріміз дайындалыңдар.
Dialogue: 0,0:03:49.89,0:03:52.23,Default,,0,0,0,,Керемет! Бәрің біргесің бе?
Dialogue: 0,0:03:52.31,0:03:53.31,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:03:53.39,0:03:55.27,Default,,0,0,0,,(Қуаныш дауысы)
Dialogue: 0,0:03:56.77,0:03:57.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:59.07,0:04:01.40,Default,,0,0,0,,Шисло, сіз оны ұша аламын деп ойлайсыз ба?
Dialogue: 0,0:04:01.49,0:04:03.24,Default,,0,0,0,,Аа, проблема жоқ.
Dialogue: 0,0:04:04.41,0:04:06.24,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,0:04:07.41,0:04:08.74,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,0:04:12.12,0:04:13.41,Default,,0,0,0,,(Таңқаларлық дауыс)
Dialogue: 0,0:04:15.25,0:04:17.84,Default,,0,0,0,,Бұл таңқаларлық емес пе? Сонжу жер асты өткелі
Dialogue: 0,0:04:17.92,0:04:21.67,Default,,0,0,0,,Мен енді сендермен бірге осы жерден өтетінімді ешқашан ойламадым.
Dialogue: 0,0:04:21.76,0:04:23.55,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:04:24.76,0:04:27.93,Default,,0,0,0,,Екі адамды қатыстырғаным үшін кешірім сұраймын.
Dialogue: 0,0:04:30.56,0:04:32.77,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:04:32.85,0:04:34.19,Default,,0,0,0,,(Таңқаларлық дауыс)
Dialogue: 0,0:04:34.27,0:04:36.40,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:04:36.48,0:04:37.61,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:39.02,0:04:39.86,Default,,0,0,0,,(иіскеу)
Dialogue: 0,0:04:45.20,0:04:47.12,Default,,0,0,0,,Рэй Норман
Dialogue: 0,0:04:48.37,0:04:51.62,Default,,0,0,0,,Менің екеуіңмен сөйлескім келетін бір нәрсе бар.
Dialogue: 0,0:04:52.29,0:04:53.12,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:53.20,0:04:55.75,Default,,0,0,0,,Фил, киіміңді ауыстырмайсың ба?
Dialogue: 0,0:04:56.29,0:05:00.63,Default,,0,0,0,,Шерри Евген… Барлығына!
Dialogue: 0,0:05:00.71,0:05:04.88,Default,,0,0,0,,Енді тездетіп дайындал, Фил.
Dialogue: 0,0:05:04.97,0:05:07.51,Default,,0,0,0,,(Сирена дыбысы)
Dialogue: 0,0:05:10.31,0:05:11.35,Default,,0,0,0,,Бастайық
Dialogue: 0,0:05:11.97,0:05:13.89,Default,,0,0,0,,(шардың жалынының дыбысы)
Dialogue: 0,0:05:18.19,0:05:21.15,Default,,0,0,0,,(Шайқас басталатын сияқты музыка)
Dialogue: 0,0:05:45.88,0:05:49.55,Default,,0,0,0,,(Они операторы) Барлық жеуге жарамды балалар өсіру аймағынан көшірілді.
Dialogue: 0,0:05:50.09,0:05:51.85,Default,,0,0,0,,Бұл әлі де бос қабық.
Dialogue: 0,0:05:51.93,0:05:52.89,Default,,0,0,0,,Мен оларды сағындым.
Dialogue: 0,0:05:55.43,0:05:56.39,Default,,0,0,0,,Жұмысты бастау
Dialogue: 0,0:05:59.56,0:06:00.40,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:06:11.41,0:06:14.95,Default,,0,0,0,,Әрбір өсімдікке бағытталған мақсатты дисперсия
Dialogue: 0,0:06:16.25,0:06:18.58,Default,,0,0,0,,Жарайды, тартыңыз да, түсіріңіз.
Dialogue: 0,0:06:19.33,0:06:21.46,Default,,0,0,0,,Ол түскен жерді түсіріңіз
Dialogue: 0,0:06:21.54,0:06:23.67,Default,,0,0,0,,(Бастық жын) Егер сіз қарсылық көрсетсеңіз, мен сізді өлтіруге қарсы емеспін.
Dialogue: 0,0:06:23.75,0:06:25.67,Default,,0,0,0,,(Қақпаның ашылған дыбысы)
Dialogue: 0,0:06:27.51,0:06:29.18,Default,,0,0,0,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:06:38.60,0:06:39.52,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:06:40.77,0:06:41.69,Default,,0,0,0,,(шардың жарылған дыбысы)
Dialogue: 0,0:06:46.28,0:06:47.69,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:06:51.20,0:06:52.62,Default,,0,0,0,,(Ауаның шығуы)
Dialogue: 0,0:07:03.21,0:07:05.55,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:12.59,0:07:14.55,Default,,0,0,0,,А... жоқ.
Dialogue: 0,0:07:14.64,0:07:16.76,Default,,0,0,0,,Сендер қайда лақтырылды?
Dialogue: 0,0:07:17.39,0:07:19.56,Default,,0,0,0,,(Тосын тыныс)
Dialogue: 0,0:07:21.52,0:07:22.52,Default,,0,0,0,,(Тосын тыныс)
Dialogue: 0,0:07:26.36,0:07:27.36,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:07:27.86,0:07:30.03,Default,,0,0,0,,А... басқа шарлар да бар шығар?
Dialogue: 0,0:07:32.78,0:07:36.20,Default,,0,0,0,,Жоқ... ау!
Dialogue: 0,0:07:43.42,0:07:45.71,Default,,0,0,0,,(Они операторы) Құрлық күштері Біреумен сөйлесу
Dialogue: 0,0:07:45.79,0:07:48.55,Default,,0,0,0,,(Бастық жын) Сіз мені өлтіре аласыз. Тезірек отты сөндір.
Dialogue: 0,0:07:48.63,0:07:50.97,Default,,0,0,0,,(Бастық жын) Ішкі қауіпсіздікті де жіберіңіз. (Оператор Демон) Ха!
Dialogue: 0,0:07:51.05,0:07:53.34,Default,,0,0,0,,Ламбданың сәтсіздігі!
Dialogue: 0,0:07:59.18,0:08:01.23,Default,,0,0,0,,(Дүрсімен қону дыбысы)
Dialogue: 0,0:08:02.48,0:08:04.56,Default,,0,0,0,,(Асығыс тыныс)
Dialogue: 0,0:08:18.74,0:08:21.95,Default,,0,0,0,,Бір жақсысы, от ескі құдыққа жетпеген.
Dialogue: 0,0:08:22.04,0:08:23.92,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:08:28.29,0:08:29.63,Default,,0,0,0,,Ах! (Таңқаларлық тыныс)
Dialogue: 0,0:08:29.71,0:08:32.26,Default,,0,0,0,,Бұл мен өзіммен бірге ала алмайтын консервіленген тағам.
Dialogue: 0,0:08:32.34,0:08:35.01,Default,,0,0,0,,О, сен жақсы ма едің?
Dialogue: 0,0:08:35.09,0:08:37.51,Default,,0,0,0,,Балалар! Тез жүріңіз (Томас Руньон) Иә.
Dialogue: 0,0:08:37.60,0:08:39.85,Default,,0,0,0,,(Таңқаларлық музыка)
Dialogue: 0,0:08:41.93,0:08:43.48,Default,,0,0,0,,Өрт тез таралады
Dialogue: 0,0:08:43.56,0:08:45.73,Default,,0,0,0,,Өрт сөндіру жұмыстарына кедергі келтірілді
Dialogue: 0,0:08:45.81,0:08:47.52,Default,,0,0,0,,Сыртқы қолдауды сұрау
Dialogue: 0,0:08:50.11,0:08:51.11,Default,,0,0,0,,(Ойлау тынысы)
Dialogue: 0,0:08:52.86,0:08:54.40,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:08:54.49,0:08:55.78,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:08:55.86,0:08:57.57,Default,,0,0,0,,(өрмелеу тынысы)
Dialogue: 0,0:08:57.66,0:09:00.03,Default,,0,0,0,,Бұл кім? неге ерікті
Dialogue: 0,0:09:00.12,0:09:01.54,Default,,0,0,0,,Эй!
Dialogue: 0,0:09:02.87,0:09:04.25,Default,,0,0,0,,Бұл... бұл есірткі ме?
Dialogue: 0,0:09:04.33,0:09:06.12,Default,,0,0,0,,(Они) Гува!
Dialogue: 0,0:09:10.92,0:09:12.26,Default,,0,0,0,,Бұл жай ғана түтін экраны
Dialogue: 0,0:09:13.17,0:09:15.09,Default,,0,0,0,,(байлау дыбысы)
Dialogue: 0,0:09:15.17,0:09:17.09,Default,,0,0,0,,(Таңқаларлық музыка)
Dialogue: 0,0:09:24.18,0:09:27.94,Default,,0,0,0,,(1-бала) Эй, не болды?
Dialogue: 0,0:09:28.02,0:09:29.65,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,0:09:31.73,0:09:32.78,Default,,0,0,0,,Фил
Dialogue: 0,0:09:34.44,0:09:36.36,Default,,0,0,0,,(Тосын тыныс)
Dialogue: 0,0:09:38.74,0:09:39.74,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,0:09:40.66,0:09:41.49,Default,,0,0,0,,Аха
Dialogue: 0,0:09:42.29,0:09:43.12,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:09:45.45,0:09:46.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:47.71,0:09:50.33,Default,,0,0,0,,Дже... Джеми Тынш!
Dialogue: 0,0:09:50.42,0:09:54.51,Default,,0,0,0,,Жарайды, мен көмектесуге келдім. Эммадан хабарлама.
Dialogue: 0,0:09:55.30,0:09:57.51,Default,,0,0,0,,«Мен мұны сұрадым, Фил.»
Dialogue: 0,0:09:58.59,0:10:00.22,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,0:10:01.85,0:10:02.97,Default,,0,0,0,,(Көз жасын сүртіп тұрған дауыс)
Dialogue: 0,0:10:07.48,0:10:08.39,Default,,0,0,0,,Сәтті қосылым
Dialogue: 0,0:10:08.48,0:10:09.40,Default,,0,0,0,,Винсент?
Dialogue: 0,0:10:09.48,0:10:11.15,Default,,0,0,0,,Босс қосылымы сәтті.
Dialogue: 0,0:10:11.86,0:10:13.65,Default,,0,0,0,,Бұл да жақсы, Эмма!
Dialogue: 0,0:10:14.40,0:10:15.40,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:18.82,0:10:22.24,Default,,0,0,0,,Енді әрекет етуді бастайық.
Dialogue: 0,0:10:23.12,0:10:25.04,Default,,0,0,0,,Ах! Ішінде жеуге болатын нәресте!
Dialogue: 0,0:10:25.12,0:10:26.37,Default,,0,0,0,,Не?
Dialogue: 0,0:10:26.87,0:10:28.71,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:10:29.29,0:10:30.88,Default,,0,0,0,,Сіз мені ести аласыз ба?
Dialogue: 0,0:10:30.96,0:10:32.96,Default,,0,0,0,,Егер мен сенімен мәміле жасасам ше?
Dialogue: 0,0:10:33.67,0:10:35.00,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:10:35.09,0:10:37.34,Default,,0,0,0,,Біз Ламбда апатын ешқашан ұмытпаймыз
Dialogue: 0,0:10:37.42,0:10:40.47,Default,,0,0,0,,Lambda жобасы бұл жолы жойылады.
Dialogue: 0,0:10:40.55,0:10:42.72,Default,,0,0,0,,Басқару жұмыс істемейді
Dialogue: 0,0:10:42.80,0:10:44.22,Default,,0,0,0,,Жүйені қалпына келтіруді жылдамдату
Dialogue: 0,0:10:45.43,0:10:47.81,Default,,0,0,0,,Олар ішкі ақпаратты қайдан алды?
Dialogue: 0,0:10:47.89,0:10:48.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:49.60,0:10:51.23,Default,,0,0,0,,Қолдаушы ма?
Dialogue: 0,0:10:51.31,0:10:53.98,Default,,0,0,0,,Өлгеннен кейін де мені мазалап жүрсің бе?
Dialogue: 0,0:10:54.07,0:10:56.44,Default,,0,0,0,,Уильям Минерва!
Dialogue: 0,0:10:59.40,0:11:02.57,Default,,0,0,0,,Бұл 1-ші зауыт. Жауап беріңіз.
Dialogue: 0,0:11:02.66,0:11:03.49,Default,,0,0,0,,Хун
Dialogue: 0,0:11:03.57,0:11:04.49,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:11:17.30,0:11:20.76,Default,,0,0,0,,Жарайды, жүре бер және лифтке апаратын жолды бекіт.
Dialogue: 0,0:11:21.63,0:11:23.68,Default,,0,0,0,,Саймон Фил
Dialogue: 0,0:11:23.76,0:11:27.85,Default,,0,0,0,,Тег ойынын жалғастырайық. Сен не туралы айтып тұрсың?
Dialogue: 0,0:11:28.56,0:11:30.31,Default,,0,0,0,,Хори, көмектесіп жібересің бе?
Dialogue: 0,0:11:31.35,0:11:32.77,Default,,0,0,0,,Иә, хехе
Dialogue: 0,0:11:32.85,0:11:33.77,Default,,0,0,0,,Дыбысты ауыстыру
Dialogue: 0,0:11:34.36,0:11:35.77,Default,,0,0,0,,Ауыспалы дыбыс
Dialogue: 0,0:11:35.86,0:11:37.73,Default,,0,0,0,,(Винсент) Кез келген уақытта бара аласыз.
Dialogue: 0,0:11:42.74,0:11:45.45,Default,,0,0,0,,Барлығы мені алып кетуге келді.
Dialogue: 0,0:11:47.24,0:11:51.50,Default,,0,0,0,,Сигнал берілгенде, бәріміз бірге тегті ойнайық
Dialogue: 0,0:11:52.75,0:11:53.71,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:11:53.79,0:11:54.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:55.04,0:11:57.96,Default,,0,0,0,,Барлығына! Дайынсыз ба?
Dialogue: 0,0:11:58.63,0:12:00.46,Default,,0,0,0,,Жүр, жын келе жатыр.
Dialogue: 0,0:12:03.05,0:12:04.47,Default,,0,0,0,,Қаш!
Dialogue: 0,0:12:06.05,0:12:09.31,Default,,0,0,0,,(Балалардың қуаныш дауыстары)
Dialogue: 0,0:12:09.39,0:12:12.27,Default,,0,0,0,,Балалар, күтіңіздер...
Dialogue: 0,0:12:16.27,0:12:18.57,Default,,0,0,0,,(Норман) Жарайды.
Dialogue: 0,0:12:18.65,0:12:20.57,Default,,0,0,0,,Біз де лифтке барамыз
Dialogue: 0,0:12:20.65,0:12:21.57,Default,,0,0,0,,Әй
Dialogue: 0,0:12:21.65,0:12:23.07,Default,,0,0,0,,Уақыт келді ме?
Dialogue: 0,0:12:23.15,0:12:25.32,Default,,0,0,0,,(Таңқаларлық музыка)
Dialogue: 0,0:12:25.41,0:12:26.95,Default,,0,0,0,,(Тыныс алу жүгіру)
Dialogue: 0,0:12:32.79,0:12:34.25,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:12:34.33,0:12:35.71,Default,,0,0,0,,(Балалар) Ах...
Dialogue: 0,0:12:35.79,0:12:36.71,Default,,0,0,0,,Міне осылай!
Dialogue: 0,0:12:36.79,0:12:38.21,Default,,0,0,0,,(Тыныс алу жүгіру)
Dialogue: 0,0:12:38.29,0:12:39.92,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:12:43.63,0:12:46.05,Default,,0,0,0,,Бұл тікелей лифт
Dialogue: 0,0:12:55.77,0:12:58.36,Default,,0,0,0,,Мұнда! Бұл осылай
Dialogue: 0,0:13:00.15,0:13:02.65,Default,,0,0,0,,(Эмоционалды тыныс алу)
Dialogue: 0,0:13:02.74,0:13:03.57,Default,,0,0,0,,Фил
Dialogue: 0,0:13:06.03,0:13:06.86,Default,,0,0,0,,Эмма?
Dialogue: 0,0:13:07.99,0:13:08.82,Default,,0,0,0,,Фил…
Dialogue: 0,0:13:11.62,0:13:14.50,Default,,0,0,0,,Һм. Рақмет.
Dialogue: 0,0:13:14.58,0:13:17.12,Default,,0,0,0,,(қуаныштан жылау)
Dialogue: 0,0:13:17.83,0:13:21.96,Default,,0,0,0,,Мен сені сағындым, мен сені сағындым, Эмма.
Dialogue: 0,0:13:22.05,0:13:25.63,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Рахмет Фил.
Dialogue: 0,0:13:25.72,0:13:28.14,Default,,0,0,0,,(Шерри) Ах!
Dialogue: 0,0:13:28.84,0:13:32.14,Default,,0,0,0,,Бұл шынымен Эмма және Томас Ланион.
Dialogue: 0,0:13:32.22,0:13:33.93,Default,,0,0,0,,Доминик де!
Dialogue: 0,0:13:34.02,0:13:35.73,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:13:36.56,0:13:39.02,Default,,0,0,0,,Мен сені әкелдім!
Dialogue: 0,0:13:40.56,0:13:43.57,Default,,0,0,0,,Мұнда барлығы таңқаларлық
Dialogue: 0,0:13:43.65,0:13:45.03,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:13:45.11,0:13:47.53,Default,,0,0,0,,(жарқын музыка)
Dialogue: 0,0:13:52.37,0:13:53.91,Default,,0,0,0,,Жарайды, бұл бәрі.
Dialogue: 0,0:13:54.50,0:13:55.66,Default,,0,0,0,,Иә
Dialogue: 0,0:14:01.75,0:14:03.80,Default,,0,0,0,,(машинаның бұрылу дыбысы)
Dialogue: 0,0:14:05.51,0:14:07.38,Default,,0,0,0,,Иә? (қорқынышты тыныс)
Dialogue: 0,0:14:09.84,0:14:10.68,Default,,0,0,0,,Дионың Рух толқынының шынайы табиғатын қалай ашуға болады
Dialogue: 0,0:14:15.77,0:14:17.69,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:25.53,0:14:29.32,Default,,0,0,0,,Қайтадан қош келдіңіздер менің сүйкімді балаларым
Dialogue: 0,0:14:30.66,0:14:31.70,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:14:33.49,0:14:35.91,Default,,0,0,0,,(Тосын тыныс)
Dialogue: 0,0:14:36.00,0:14:38.87,Default,,0,0,0,,Жүйе қалпына келтірілді.
Dialogue: 0,0:14:39.96,0:14:42.71,Default,,0,0,0,,Жарайсың Изабелла әже
Dialogue: 0,0:14:43.96,0:14:47.88,Default,,0,0,0,,Мәңгілік балалар, ойын бітті
Dialogue: 0,0:14:48.47,0:14:50.51,Default,,0,0,0,,Питер Лартли
Dialogue: 0,0:14:50.59,0:14:53.14,Default,,0,0,0,,Бұл адам ... қақпашы.
Dialogue: 0,0:14:53.22,0:14:54.89,Default,,0,0,0,,Біраз уақыт болды, Норман.
Dialogue: 0,0:14:55.64,0:14:58.14,Default,,0,0,0,,(Питер) Және Ламбданың (Барбара) сәтсіздігі міне!
Dialogue: 0,0:14:58.23,0:15:00.48,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:15:00.56,0:15:04.23,Default,,0,0,0,,Тіпті атылған жағдайда эксперимент жүргізілетін субъектінің денесі өледі.
Dialogue: 0,0:15:04.32,0:15:05.15,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:15:05.23,0:15:07.78,Default,,0,0,0,,Қару-жарақтарыңызды тастап, артқа тұрыңыз.
Dialogue: 0,0:15:07.86,0:15:12.16,Default,,0,0,0,,Қараңызшы, анам да осылай дейді. Ата-анаңның айтқанын тыңда.
Dialogue: 0,0:15:12.24,0:15:13.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:25.38,0:15:28.96,Default,,0,0,0,,Өкініштісі, құтқару әрекеті сәтсіз аяқталды.
Dialogue: 0,0:15:30.76,0:15:33.18,Default,,0,0,0,,Әрқашан осылай аяқталса да
Dialogue: 0,0:15:33.26,0:15:36.43,Default,,0,0,0,,Ешбір өкінбей қайттыңдар.
Dialogue: 0,0:15:36.51,0:15:38.18,Default,,0,0,0,,Бұл нәтиже
Dialogue: 0,0:15:39.14,0:15:40.64,Default,,0,0,0,,Бұл аянышты.
Dialogue: 0,0:15:48.32,0:15:52.57,Default,,0,0,0,,Менің жүзеге асырғым келетін болашағым бар. Менің өлгім келмейтін отбасым бар.
Dialogue: 0,0:15:53.49,0:15:56.45,Default,,0,0,0,,Ол үшін мен қанша рет болса да берілмеймін.
Dialogue: 0,0:15:56.53,0:15:59.20,Default,,0,0,0,,Тағдыр болса да?
Dialogue: 0,0:15:59.29,0:16:01.50,Default,,0,0,0,,Тағдырды құрт!
Dialogue: 0,0:16:01.58,0:16:02.50,Default,,0,0,0,,(Ашу тынысы)
Dialogue: 0,0:16:03.62,0:16:05.00,Default,,0,0,0,,Керемет
Dialogue: 0,0:16:05.58,0:16:07.38,Default,,0,0,0,,Ха...ха!
Dialogue: 0,0:16:07.46,0:16:11.01,Default,,0,0,0,,Міне, мен өсірген балаларым.
Dialogue: 0,0:16:11.72,0:16:14.26,Default,,0,0,0,,Барлығыңызға толық ұпай.
Dialogue: 0,0:16:14.34,0:16:15.89,Default,,0,0,0,,(Мылтық көтеріліп жатқан дыбыс)
Dialogue: 0,0:16:15.97,0:16:17.76,Default,,0,0,0,,Изабелла сен!
Dialogue: 0,0:16:17.85,0:16:20.14,Default,,0,0,0,,Балалар, ауыл шаруашылығын қалай жүргізу керек
Dialogue: 0,0:16:20.22,0:16:22.85,Default,,0,0,0,,Мен оған жай ғана қанықтым.
Dialogue: 0,0:16:22.94,0:16:25.15,Default,,0,0,0,,Сондықтан мен оны жоюды шештім.
Dialogue: 0,0:16:26.73,0:16:28.15,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:16:29.15,0:16:29.90,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:16:29.98,0:16:32.15,Default,,0,0,0,,Мені қате түсінбеңіз
Dialogue: 0,0:16:32.24,0:16:35.20,Default,,0,0,0,,Біздің қызығушылықтарымыз бірдей болды.
Dialogue: 0,0:16:37.28,0:16:39.20,Default,,0,0,0,,Рахмет анашым
Dialogue: 0,0:16:40.08,0:16:40.91,Default,,0,0,0,,(күлімсіреген тыныс)
Dialogue: 0,0:16:41.54,0:16:42.91,Default,,0,0,0,,(Өкініш дауысы)
Dialogue: 0,0:16:43.83,0:16:45.37,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:16:47.92,0:16:49.25,Default,,0,0,0,,Майюри көз алдымызда жоғалып бара жатқандай болды
Dialogue: 0,0:16:49.92,0:16:51.80,Default,,0,0,0,,Кеудеміздегі чип болса
Dialogue: 0,0:16:51.88,0:16:54.51,Default,,0,0,0,,Жүйе ұясының артықшылығын пайдалану арқылы ол өшірілген.
Dialogue: 0,0:16:55.09,0:16:56.01,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:16:56.09,0:16:59.01,Default,,0,0,0,,Біз енді ешқашан берілмейміз
Dialogue: 0,0:16:59.64,0:17:01.52,Default,,0,0,0,,Мен енді ештеңеге байланысты емеспін
Dialogue: 0,0:17:02.81,0:17:04.02,Default,,0,0,0,,Checkmate
Dialogue: 0,0:17:04.77,0:17:06.06,Default,,0,0,0,,Питер Рэтли
Dialogue: 0,0:17:06.15,0:17:08.36,Default,,0,0,0,,(Жабылатын дыбыс әсері)
Dialogue: 0,0:17:09.77,0:17:10.65,Default,,0,0,0,,(мазақ еткен дауыс)
Dialogue: 0,0:17:10.73,0:17:12.32,Default,,0,0,0,,Checkmate?
Dialogue: 0,0:17:13.03,0:17:15.99,Default,,0,0,0,,Бұрышта отырғандар сендерсіңдер.
Dialogue: 0,0:17:16.49,0:17:20.53,Default,,0,0,0,,Басқа шаруа қожалықтарынан қосымша күштер қазірдің өзінде жолымызға түсіп жатыр.
Dialogue: 0,0:17:21.70,0:17:23.75,Default,,0,0,0,,Жеуге жарамды балалар
Dialogue: 0,0:17:23.83,0:17:27.25,Default,,0,0,0,,Ал асыл тұқымды бақылаушы Сіз мені естисіз бе?
Dialogue: 0,0:17:28.25,0:17:30.75,Default,,0,0,0,,Жақында күшейткіштер келеді.
Dialogue: 0,0:17:31.38,0:17:34.17,Default,,0,0,0,,Одан әрі қарсылық көрсету бекер.
Dialogue: 0,0:17:34.26,0:17:36.47,Default,,0,0,0,,Тыныш түрде беріл.
Dialogue: 0,0:17:37.05,0:17:38.47,Default,,0,0,0,,Тағдыр және дүние
Dialogue: 0,0:17:39.05,0:17:40.97,Default,,0,0,0,,Ешқашан құлатпаңыз
Dialogue: 0,0:17:41.06,0:17:44.10,Default,,0,0,0,,Жеу үшін туылған сендерге
Dialogue: 0,0:17:44.18,0:17:48.19,Default,,0,0,0,,Әу бастан жеңіс те, еркіндік те жоқ.
Dialogue: 0,0:17:48.27,0:17:50.11,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:17:52.44,0:17:53.48,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:17:53.57,0:17:54.69,Default,,0,0,0,,Не?
Dialogue: 0,0:17:54.78,0:17:56.78,Default,,0,0,0,,Бірақ... сыртқы қақпа шабуылда.
Dialogue: 0,0:17:56.86,0:17:57.74,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:17:57.82,0:18:01.16,Default,,0,0,0,,(Адамдар) Сено (Соққы дыбысы)
Dialogue: 0,0:18:06.83,0:18:07.58,Default,,0,0,0,,(Адамдардың айқайы)
Dialogue: 0,0:18:07.66,0:18:10.75,Default,,0,0,0,,(Адамдар) Енді біз көтерілетін уақыт.
Dialogue: 0,0:18:10.83,0:18:13.25,Default,,0,0,0,,Ферманы енді сіз басқара алмайсыз.
Dialogue: 0,0:18:13.84,0:18:15.26,Default,,0,0,0,,Алайда дәл сол адамдар, олар өмірін қатерге тігіп қорғайтындар
Dialogue: 0,0:18:15.34,0:18:16.88,Default,,0,0,0,,Күшейткіштер емес
Dialogue: 0,0:18:16.97,0:18:20.05,Default,,0,0,0,,Адамдар, сансыз адамдар.
Dialogue: 0,0:18:20.14,0:18:22.22,Default,,0,0,0,,Ферманы қоршап тұр
Dialogue: 0,0:18:22.30,0:18:25.18,Default,,0,0,0,,Адамдар? Не айтқың келеді?
Dialogue: 0,0:18:25.27,0:18:26.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:26.48,0:18:28.89,Default,,0,0,0,,(қорқынышты музыка)
Dialogue: 0,0:18:31.81,0:18:34.90,Default,,0,0,0,,Эмманың отбасы осында ма?
Dialogue: 0,0:18:36.99,0:18:40.91,Default,,0,0,0,,(Соғысқан адамдардың дауысы)
Dialogue: 0,0:18:42.99,0:18:44.33,Default,,0,0,0,,Ал күшейту туралы не деуге болады?
Dialogue: 0,0:18:44.41,0:18:46.12,Default,,0,0,0,,Адамдардың ұстап қалуы
Dialogue: 0,0:18:46.20,0:18:47.16,Default,,0,0,0,,(есіктің сынған дыбысы)
Dialogue: 0,0:18:50.00,0:18:52.00,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:18:52.08,0:18:52.92,Default,,0,0,0,,(Байланыстың дыбысы өшіп жатыр)
Dialogue: 0,0:18:53.63,0:18:56.17,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:59.17,0:19:01.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:04.39,0:19:05.43,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:19:05.51,0:19:08.89,Default,,0,0,0,,Сіз мен жағындасыз, солай ма? Музыка
Dialogue: 0,0:19:08.98,0:19:09.94,Default,,0,0,0,,Иә
Dialogue: 0,0:19:10.02,0:19:12.06,Default,,0,0,0,,Барлығы жарақат алды ма?
Dialogue: 0,0:19:12.15,0:19:13.44,Default,,0,0,0,,Иә
Dialogue: 0,0:19:13.52,0:19:15.40,Default,,0,0,0,,Неге... адамдар
Dialogue: 0,0:19:16.32,0:19:19.86,Default,,0,0,0,,Жеуге жарамды балаларды жегіңіз келгені сонша, қолыңыз тамағыңыздан шығып кетеді, солай ма?
Dialogue: 0,0:19:20.78,0:19:25.20,Default,,0,0,0,,Жоқ, бізге енді жеуге жарамды балалар керек емес.
Dialogue: 0,0:19:25.28,0:19:26.95,Default,,0,0,0,,Осы кісінің қанына байланысты
Dialogue: 0,0:19:28.50,0:19:29.33,Default,,0,0,0,,Қан…?
Dialogue: 0,0:19:31.21,0:19:33.58,Default,,0,0,0,,Ха! Амал жоқ
Dialogue: 0,0:19:34.21,0:19:35.63,Default,,0,0,0,,Жаман қан!
Dialogue: 0,0:19:35.71,0:19:39.88,Default,,0,0,0,,Барлық адамдарда зұлым қанның күші бар ма?
Dialogue: 0,0:19:40.67,0:19:42.84,Default,,0,0,0,,Болмашы қорға жабысу
Dialogue: 0,0:19:42.93,0:19:47.14,Default,,0,0,0,,Мен бұдан былай өз отбасымды азғындау азаптарына бағындыру арқылы өмір сүре алмаймын.
Dialogue: 0,0:19:48.10,0:19:50.52,Default,,0,0,0,,Плантациялардың үстемдігін тоқтату
Dialogue: 0,0:19:50.60,0:19:53.40,Default,,0,0,0,,Біз осылай шештік және осында келдік.
Dialogue: 0,0:19:53.48,0:19:54.73,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:19:55.81,0:19:57.40,Default,,0,0,0,,Идиот...
Dialogue: 0,0:19:57.98,0:20:01.65,Default,,0,0,0,,Балалар, сендер тек бастамасыңдар, бірақ
Dialogue: 0,0:20:01.74,0:20:04.57,Default,,0,0,0,,Мен оны назардан тыс қалдыра алмадым.
Dialogue: 0,0:20:04.66,0:20:06.74,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:20:06.83,0:20:07.91,Default,,0,0,0,,Вирк мырза
Dialogue: 0,0:20:09.08,0:20:10.45,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:14.50,0:20:16.42,Default,,0,0,0,,(Көңілсіздік тынысы)
Dialogue: 0,0:20:21.26,0:20:22.42,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:20:23.47,0:20:27.14,Default,,0,0,0,,Сіз мың жыл бұрынғы қақтығысты қайта тұтатқыңыз келе ме?
Dialogue: 0,0:20:27.80,0:20:30.56,Default,,0,0,0,,Көбірек жындар адамдарды жеуге міндетті болмаса,
Dialogue: 0,0:20:30.64,0:20:32.77,Default,,0,0,0,,Адамзат әлеміне барсақ та
Dialogue: 0,0:20:32.85,0:20:35.69,Default,,0,0,0,,Жындар азғындамайды және жойылмайды.
Dialogue: 0,0:20:35.77,0:20:40.19,Default,,0,0,0,,Мен басқаларды құрбан ететін дүниені аяқтағым келеді.
Dialogue: 0,0:20:40.28,0:20:44.45,Default,,0,0,0,,(Петр) Ешқандай құрбандықсыз бейбітшілікке қол жеткізу мүмкін емес.
Dialogue: 0,0:20:45.11,0:20:48.45,Default,,0,0,0,,Біздің Ратри руының ата-бабалары берген уәде.
Dialogue: 0,0:20:48.53,0:20:51.29,Default,,0,0,0,,Өйткені ол қорғалған
Dialogue: 0,0:20:51.37,0:20:53.62,Default,,0,0,0,,Себебі мен сені қорғауды жалғастырдым...!
Dialogue: 0,0:20:54.33,0:20:57.96,Default,,0,0,0,,Егер ферма жойылса, сіздің қақпашы рөліңіз де жоғалады.
Dialogue: 0,0:20:58.04,0:20:58.88,Default,,0,0,0,,Ха...
Dialogue: 0,0:21:02.05,0:21:03.05,Default,,0,0,0,,Егер мен басынан бастап араласқан болсам, сенің қолдарың мен құлақтарың—
Dialogue: 0,0:21:11.68,0:21:13.98,Default,,0,0,0,,Еркін болайық
Dialogue: 0,0:21:15.64,0:21:19.27,Default,,0,0,0,,Бірге өмір сүрейік Питер Лартли
Dialogue: 0,0:21:22.53,0:21:24.15,Default,,0,0,0,,(♪~Соңындағы ән)
Dialogue: 0,0:21:24.24,0:21:29.74,Default,,0,0,0,,♪ Бір тілесең, Ай көлеңкесін ♪
Dialogue: 0,0:21:29.83,0:21:32.20,Default,,0,0,0,,♪ Қандай сиқырлы түн ♪
Dialogue: 0,0:21:32.29,0:21:34.75,Default,,0,0,0,,♪ Оны шешетініңізге сенімдімін ♪
Dialogue: 0,0:21:46.13,0:21:48.76,Default,,0,0,0,,♪ Даусыңыз анық ♪
Dialogue: 0,0:21:48.84,0:21:51.56,Default,,0,0,0,,♪ Жел түнді ♪ жариялады
Dialogue: 0,0:21:51.64,0:21:54.14,Default,,0,0,0,,♪ Көк дүниедегі бәрі ♪
Dialogue: 0,0:21:54.22,0:21:56.89,Default,,0,0,0,,♪ Ертегіде ұйықтау ♪
Dialogue: 0,0:21:56.98,0:21:59.69,Default,,0,0,0,,♪ Ұйқыдасың ♪
Dialogue: 0,0:21:59.77,0:22:02.40,Default,,0,0,0,,♪ Мен жабылған қабақтарымды аштым ♪
Dialogue: 0,0:22:02.48,0:22:05.57,Default,,0,0,0,,♪ Мен ойлағаннан да көп ♪
Dialogue: 0,0:22:05.65,0:22:08.20,Default,,0,0,0,,♪ Бұлыңғыр болмаңыз ♪
Dialogue: 0,0:22:09.74,0:22:14.66,Default,,0,0,0,,♪ Бұл дауыс сізге жетсе ♪
Dialogue: 0,0:22:14.75,0:22:16.08,Default,,0,0,0,,♪ Жауап жоқ ♪
Dialogue: 0,0:22:16.16,0:22:17.41,Default,,0,0,0,,♪ Мен әлі де қалғым келеді ♪
Dialogue: 0,0:22:17.50,0:22:20.71,Default,,0,0,0,,♪ Мен оқиғаның аяқталғанын қаламаймын ♪
Dialogue: 0,0:22:20.79,0:22:25.80,Default,,0,0,0,,♪ Бұл түннен асып кет ♪
Dialogue: 0,0:22:25.88,0:22:26.92,Default,,0,0,0,,♪ Сізбен ♪
Dialogue: 0,0:22:27.01,0:22:29.89,Default,,0,0,0,,♪ Маған сөз керек емес, сондықтан әзірше ♪
Dialogue: 0,0:22:29.97,0:22:32.93,Default,,0,0,0,,♪ Мен бір-бірінің жылуын растағым келеді ♪
Dialogue: 0,0:22:33.01,0:22:33.97,Default,,0,0,0,,♪ Өтінемін ♪
Dialogue: 0,0:22:34.06,0:22:36.56,Default,,0,0,0,,♪ Мен ♪ оянбайтын түс көрейін
Dialogue: 0,0:22:36.64,0:22:39.64,Default,,0,0,0,,♪ Ол қол біздікі ♪
Dialogue: 0,0:22:39.73,0:22:44.36,Default,,0,0,0,,♪ Босатпай, ақырын тіледім ♪
Dialogue: 0,0:22:47.78,0:22:49.82,Default,,0,0,0,,(Соңғы ән~♪)
Dialogue: 0,0:22:51.32,0:22:56.32,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
