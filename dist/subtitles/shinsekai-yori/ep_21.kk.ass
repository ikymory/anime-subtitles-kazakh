Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:49.47,0:00:51.43,Default,,0,0,0,,Уау! Уау...
Dialogue: 0,0:00:51.43,0:00:55.43,Default,,0,0,0,,Ах! …
Dialogue: 0,0:00:56.42,0:00:59.44,Default,,0,0,0,,Енді Сейджози храмына барыңыз.
Dialogue: 0,0:00:59.44,0:01:01.43,Default,,0,0,0,,Ниими мырзаға не болады?
Dialogue: 0,0:01:01.43,0:01:05.41,Default,,0,0,0,,Мен Томико ханымның хабарын Шусей Кабураги мырзаға жеткіземін.
Dialogue: 0,0:01:05.41,0:01:07.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:14.46,0:01:17.44,Default,,0,0,0,,Қорқыныш ақыл-ойды сал етеді
Dialogue: 0,0:01:17.44,0:01:20.43,Default,,0,0,0,,Жаудың тілейтіні осы
Dialogue: 0,0:01:20.43,0:01:23.45,Default,,0,0,0,,Барлығыңыз тынышталыңыздар.
Dialogue: 0,0:01:23.45,0:01:28.45,Default,,0,0,0,,Құбыжық егеуқұйрықтар шайтандық жоспар құрып жатыр.
Dialogue: 0,0:01:28.45,0:01:30.45,Default,,0,0,0,,Адамдарға қарсы көтеріліс жоспары
Dialogue: 0,0:01:31.46,0:01:33.44,Default,,0,0,0,,Марқұмды жоқтауда
Dialogue: 0,0:01:33.44,0:01:37.46,Default,,0,0,0,,Біз қазір жиналуымыз керек
Dialogue: 0,0:01:37.46,0:01:40.47,Default,,0,0,0,,Иә! Бірлесіңіздер!
Dialogue: 0,0:01:40.47,0:01:42.43,Default,,0,0,0,,Бакемонезуге өлім!
Dialogue: 0,0:01:42.43,0:01:47.46,Default,,0,0,0,,Бакемонезуге өлім! …
Dialogue: 0,0:01:47.46,0:01:52.43,Default,,0,0,0,,Бакемонезу өлімі...
Dialogue: 0,0:01:52.43,0:01:55.43,Default,,0,0,0,,Бакемонезуге өлім! …
Dialogue: 0,0:02:03.44,0:02:05.44,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:02:19.47,0:02:21.44,Default,,0,0,0,,Қашайық!
Dialogue: 0,0:02:21.44,0:02:23.46,Default,,0,0,0,,Бірақ! Шусей мырзаға!
Dialogue: 0,0:02:23.46,0:02:27.48,Default,,0,0,0,,Пайдасыз! Бұл жағдайда бұл өте... иә?
Dialogue: 0,0:02:27.48,0:02:29.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:44.48,0:02:48.48,Default,,0,0,0,,Барлығын құтқара алмағаныма шыдай алмаймын.
Dialogue: 0,0:02:55.47,0:02:58.46,Default,,0,0,0,,Бірақ кек менікі.
Dialogue: 0,0:02:58.46,0:03:01.46,Default,,0,0,0,,Бұл ұсқынсыз және қарғысқа ұшыраған жаратылыс
Dialogue: 0,0:03:01.46,0:03:04.47,Default,,0,0,0,,Бәкенезу деп аталатын түрдің өзі...
Dialogue: 0,0:03:04.47,0:03:06.49,Default,,0,0,0,,Жапон архипелагынан Құдайдың елі
Dialogue: 0,0:03:06.49,0:03:09.49,Default,,0,0,0,,Біз оны жоюға уәде береміз.
Dialogue: 0,0:03:15.48,0:03:20.48,Default,,0,0,0,,Шынымды айтсам, бұл табандылық таң қалдырады, бірақ...
Dialogue: 0,0:03:20.48,0:03:26.48,Default,,0,0,0,,Өкінішке орай, мен қанша тырыссам да, бұл мен үшін жұмыс істемейді.
Dialogue: 0,0:03:31.48,0:03:34.46,Default,,0,0,0,,Бас қолбасшы қайда?
Dialogue: 0,0:03:34.46,0:03:36.45,Default,,0,0,0,,Айтыңыз, немесе...
Dialogue: 0,0:03:36.45,0:03:39.49,Default,,0,0,0,,Я Ямаро...
Dialogue: 0,0:03:39.49,0:03:41.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:42.45,0:03:44.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:48.48,0:03:50.48,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:02.46,0:04:04.48,Default,,0,0,0,,Уау! Бұл жын ғой!
Dialogue: 0,0:04:04.48,0:04:06.48,Default,,0,0,0,,Жын келді!
Dialogue: 0,0:04:08.50,0:04:11.50,Default,,0,0,0,,Гаа~!
Dialogue: 0,0:04:13.47,0:04:15.49,Default,,0,0,0,,Егер бұл жын болса...
Dialogue: 0,0:04:15.49,0:04:18.49,Default,,0,0,0,,Бұл ақымақ... бұл мүмкін емес!
Dialogue: 0,0:04:19.48,0:04:21.46,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:04:21.46,0:04:23.46,Default,,0,0,0,,Уф! Ах!
Dialogue: 0,0:04:26.47,0:04:31.47,Default,,0,0,0,,Қалғанын саған қалдырамын.
Dialogue: 0,0:04:32.47,0:04:35.47,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:39.48,0:04:44.48,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:56.50,0:04:58.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:01.48,0:05:03.48,Default,,0,0,0,,Мария? Иә?
Dialogue: 0,0:05:04.47,0:05:08.47,Default,,0,0,0,,Сіз шынымен...жынсыз ба?
Dialogue: 0,0:05:09.46,0:05:11.46,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:05:12.46,0:05:16.46,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:05:17.50,0:05:22.50,Default,,0,0,0,,Гу Гуваа~!
Dialogue: 0,0:05:24.49,0:05:26.49,Default,,0,0,0,,Хи хи хи
Dialogue: 0,0:05:28.48,0:05:30.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:37.49,0:05:39.45,Default,,0,0,0,,Сен жай ғана... отты қайта тұтаттың, иә?
Dialogue: 0,0:05:39.45,0:05:43.48,Default,,0,0,0,,Қарапайым дағдыларыңыздан бас тарту оңай.
Dialogue: 0,0:05:43.48,0:05:46.48,Default,,0,0,0,,Кем дегенде осыны байқап көріңіз.
Dialogue: 0,0:05:46.48,0:05:48.46,Default,,0,0,0,,Ууууууууууууууууууууууууууууууу!
Dialogue: 0,0:05:48.46,0:05:50.50,Default,,0,0,0,,Ерте маусым! Ах
Dialogue: 0,0:05:50.50,0:05:52.48,Default,,0,0,0,,Ояну!
Dialogue: 0,0:05:52.48,0:05:54.45,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын!
Dialogue: 0,0:05:54.45,0:05:57.49,Default,,0,0,0,,Қаш! Ұрыс көз алдында
Dialogue: 0,0:05:57.49,0:05:59.47,Default,,0,0,0,,Не? Не дейсіз...
Dialogue: 0,0:05:59.47,0:06:03.50,Default,,0,0,0,,Дәл қазір Шусей мырзаның блефі әлі жұмыс істеп тұр, мен қозғала алмаймын.
Dialogue: 0,0:06:03.50,0:06:06.50,Default,,0,0,0,,Бірақ оның түсінгені уақыт мәселесі.
Dialogue: 0,0:06:06.50,0:06:08.50,Default,,0,0,0,,Не байқадың?
Dialogue: 0,0:06:08.50,0:06:11.47,Default,,0,0,0,,Шуксинг мырза шабуылды басу және өлім механизміне байланысты.
Dialogue: 0,0:06:11.47,0:06:13.49,Default,,0,0,0,,Өзі де адам болған жынды өлтіре алмайсың.
Dialogue: 0,0:06:13.49,0:06:16.48,Default,,0,0,0,,Бірақ ол басқа!
Dialogue: 0,0:06:16.48,0:06:21.46,Default,,0,0,0,,Бірақ жындар да Шуксинг мырзаны жеңе алмайды, солай ма?
Dialogue: 0,0:06:21.46,0:06:23.50,Default,,0,0,0,,Кез келген шабуыл тойтарыс береді.
Dialogue: 0,0:06:23.50,0:06:28.49,Default,,0,0,0,,Жоқ, оған оңай.
Dialogue: 0,0:06:28.49,0:06:31.49,Default,,0,0,0,,Ессіз...
Dialogue: 0,0:06:31.49,0:06:34.48,Default,,0,0,0,,Қарғыс атқан билік... Қарғыс атқылаған күш...
Dialogue: 0,0:06:34.48,0:06:36.48,Default,,0,0,0,,Ағып кету…
Dialogue: 0,0:06:37.48,0:06:41.50,Default,,0,0,0,,Гааа~!
Dialogue: 0,0:06:41.50,0:06:44.47,Default,,0,0,0,,Гаа ааа...
Dialogue: 0,0:06:44.47,0:06:46.49,Default,,0,0,0,,Хехе...
Dialogue: 0,0:06:46.49,0:06:50.48,Default,,0,0,0,,А...
Dialogue: 0,0:06:50.48,0:06:53.48,Default,,0,0,0,,Хэхехехехе...
Dialogue: 0,0:06:53.48,0:06:55.48,Default,,0,0,0,,A… G…
Dialogue: 0,0:06:55.48,0:06:57.47,Default,,0,0,0,,Хехе...
Dialogue: 0,0:06:57.47,0:06:59.50,Default,,0,0,0,,Ааааа…
Dialogue: 0,0:06:59.50,0:07:01.49,Default,,0,0,0,,Қаш! Қазір немесе ешқашан!
Dialogue: 0,0:07:01.49,0:07:04.49,Default,,0,0,0,,Эхехехе Ехехехе Хэхехе...
Dialogue: 0,0:07:05.47,0:07:07.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:15.47,0:07:17.47,Default,,0,0,0,,Aa
Dialogue: 0,0:07:17.47,0:07:22.47,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:07:28.48,0:07:31.48,Default,,0,0,0,,Ерте маусым! Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:31.48,0:07:33.50,Default,,0,0,0,,Жарайды! Ниими ше?
Dialogue: 0,0:07:33.50,0:07:35.50,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:35.50,0:07:37.49,Default,,0,0,0,,Ой~!
Dialogue: 0,0:07:37.49,0:07:39.47,Default,,0,0,0,,Гя~ во~ о~
Dialogue: 0,0:07:39.47,0:07:42.47,Default,,0,0,0,,Асығыңыз! Осы жаққа кел!
Dialogue: 0,0:07:46.48,0:07:48.47,Default,,0,0,0,,Жағымсыз иіс...
Dialogue: 0,0:07:48.47,0:07:50.47,Default,,0,0,0,,Иә
Dialogue: 0,0:07:53.51,0:07:57.51,Default,,0,0,0,,Абайлаңыз, ол әлі тірі болуы мүмкін.
Dialogue: 0,0:08:06.50,0:08:08.50,Default,,0,0,0,,Сіз сөйлей аласыз ба?
Dialogue: 0,0:08:12.47,0:08:16.47,Default,,0,0,0,,Do… Gua…
Dialogue: 0,0:08:18.50,0:08:23.50,Default,,0,0,0,,Менің сұрағаныма адал жауап берсең, қиналмай өлуге рұқсат етемін!
Dialogue: 0,0:08:25.49,0:08:28.49,Default,,0,0,0,,Сіз шынымен жаман тамақ жеген сияқтысыз.
Dialogue: 0,0:08:28.49,0:08:31.49,Default,,0,0,0,,Неліктен адамдарға қарсы тұру үшін соншалықты күш саласыз?
Dialogue: 0,0:08:31.49,0:08:35.49,Default,,0,0,0,,Балалар, не ойлап тұрғандарыңды түсінбеймін.
Dialogue: 0,0:08:36.50,0:08:39.50,Default,,0,0,0,,Не болды? Сіз тілде сөйлей аласыз ба?
Dialogue: 0,0:08:39.50,0:08:42.50,Default,,0,0,0,,Енді түсінбеймін деп сөйлегеннің жөні жоқ.
Dialogue: 0,0:08:42.50,0:08:44.51,Default,,0,0,0,,Алдау қажет емес
Dialogue: 0,0:08:44.51,0:08:50.51,Default,,0,0,0,,Егер солай болса, айтыңызшы, Ногицүнемару қайда?
Dialogue: 0,0:08:52.50,0:08:55.50,Default,,0,0,0,,Бәріңді Ногицунемару алдап жатыр.
Dialogue: 0,0:08:55.50,0:08:57.50,Default,,0,0,0,,Мұны қалай түсінбейсің?
Dialogue: 0,0:08:57.50,0:09:02.51,Default,,0,0,0,,Ол сарбаздардың өмірін ойламайды.
Dialogue: 0,0:09:02.51,0:09:04.49,Default,,0,0,0,,Бұл нонсенс...
Dialogue: 0,0:09:04.49,0:09:09.48,Default,,0,0,0,,Себеп алдында жеке адамның өмірі шашындай жеңіл.
Dialogue: 0,0:09:09.48,0:09:11.52,Default,,0,0,0,,Себебі?
Dialogue: 0,0:09:11.52,0:09:16.49,Default,,0,0,0,,Біздің бүкіл нәсілімізді сіздің озбырлықтан босату үшін.
Dialogue: 0,0:09:16.49,0:09:18.47,Default,,0,0,0,,Тирания нені білдіреді?
Dialogue: 0,0:09:18.47,0:09:21.48,Default,,0,0,0,,Саған соншалықты жаман қарағаным есімде жоқ.
Dialogue: 0,0:09:21.48,0:09:24.51,Default,,0,0,0,,Бізде интеллект жоғары
Dialogue: 0,0:09:24.51,0:09:28.50,Default,,0,0,0,,Бастапқыда маған сізбен бірдей қарау керек еді.
Dialogue: 0,0:09:28.50,0:09:32.49,Default,,0,0,0,,Соған қарамастан, шайтандарыңның күшімен
Dialogue: 0,0:09:32.49,0:09:36.51,Default,,0,0,0,,Ар-намысымды талан-таражға салып, айуандай қарады.
Dialogue: 0,0:09:36.51,0:09:39.51,Default,,0,0,0,,Сені жер бетінен өшіруден басқа амал жоқ.
Dialogue: 0,0:09:39.51,0:09:43.50,Default,,0,0,0,,Біздің мақтанышымызды қалпына келтірудің жолы жоқ.
Dialogue: 0,0:09:43.50,0:09:47.49,Default,,0,0,0,,Сіз шынымен де мұны істей аламын деп ойлайсыз ба?
Dialogue: 0,0:09:47.49,0:09:49.50,Default,,0,0,0,,Ақымақтар, бұл сұмдық айла.
Dialogue: 0,0:09:49.50,0:09:52.49,Default,,0,0,0,,Көптеген адамдарды өлтірді
Dialogue: 0,0:09:52.49,0:09:56.50,Default,,0,0,0,,Алайда бір адам аман қалса,
Dialogue: 0,0:09:56.50,0:10:00.52,Default,,0,0,0,,Мен бәріңді өлтіре аламын!
Dialogue: 0,0:10:00.52,0:10:02.52,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:10:02.52,0:10:04.50,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:10:04.50,0:10:08.52,Default,,0,0,0,,Азаттықтың қаһарманы Скеалер бізбен бірге болғанша.
Dialogue: 0,0:10:08.52,0:10:11.53,Default,,0,0,0,,Ал көктен біздің лагерьге
Dialogue: 0,0:10:11.53,0:10:14.50,Default,,0,0,0,,Енді Мәсіх түсті!
Dialogue: 0,0:10:14.50,0:10:17.48,Default,,0,0,0,,Мәсіх? Сіз бұл жын туралы айтып отырсыз ба?
Dialogue: 0,0:10:17.48,0:10:24.48,Default,,0,0,0,,Жын? Жындар сендерсіңдер!
Dialogue: 0,0:10:25.51,0:10:27.51,Default,,0,0,0,,(Абдул) Һм? (Жан) Э?
Dialogue: 0,0:10:30.48,0:10:33.48,Default,,0,0,0,,Жоқ! Бұл жігіт мені өзімді өлтіруге мәжбүрлеу үшін.
Dialogue: 0,0:10:33.48,0:10:35.52,Default,,0,0,0,,Мен саған әдейі секірдім.
Dialogue: 0,0:10:35.52,0:10:39.50,Default,,0,0,0,,Кеттік. Біз күте алмаймыз.
Dialogue: 0,0:10:39.50,0:10:44.49,Default,,0,0,0,,Маған Томико-сама берген соңғы тапсырма бар.
Dialogue: 0,0:10:44.49,0:10:47.49,Default,,0,0,0,,Жігіттер, тез арада Сейджози храмына баруларың керек.
Dialogue: 0,0:10:51.52,0:10:55.50,Default,,0,0,0,,Төтенше жағдай туралы ескерту Төтенше жағдай туралы ескерту
Dialogue: 0,0:10:55.50,0:11:00.51,Default,,0,0,0,,Жын пайда болды...
Dialogue: 0,0:11:00.51,0:11:02.49,Default,,0,0,0,,Аты мен түрі белгісіз
Dialogue: 0,0:11:02.49,0:11:06.52,Default,,0,0,0,,Бұл Крогиустың 1 немесе 2 типті нұсқасы сияқты.
Dialogue: 0,0:11:06.52,0:11:10.50,Default,,0,0,0,,Жындар Каява-но Сатоға шабуыл жасап, көптеген шығынға ұшырады.
Dialogue: 0,0:11:10.50,0:11:14.49,Default,,0,0,0,,Мүмкіндігінше тезірек эвакуациялаңыз
Dialogue: 0,0:11:14.49,0:11:17.53,Default,,0,0,0,,Егер сіз қала орталығында болсаңыз, дереу кетіңіз.
Dialogue: 0,0:11:17.53,0:11:20.53,Default,,0,0,0,,Маңайдағылар да қаладан кетуі керек.
Dialogue: 0,0:11:20.53,0:11:23.53,Default,,0,0,0,,Мүмкіндігінше алысқа жүгіріңіз
Dialogue: 0,0:11:26.50,0:11:29.49,Default,,0,0,0,,Ниими мырза бізбен бірге келе алады ма?
Dialogue: 0,0:11:29.49,0:11:33.49,Default,,0,0,0,,Жоқ, мен мәдениет үйіне баруым керек.
Dialogue: 0,0:11:33.49,0:11:36.48,Default,,0,0,0,,Бұл Томико-саманың нұсқаулары.
Dialogue: 0,0:11:36.48,0:11:40.50,Default,,0,0,0,,Бірақ қазір оны таратуға кеш емес пе?
Dialogue: 0,0:11:40.50,0:11:45.52,Default,,0,0,0,,Жындар Каява-но Сатодағы адамдардың көпшілігін жойып үлгерді...
Dialogue: 0,0:11:45.52,0:11:50.53,Default,,0,0,0,,Мен тым кеш пе білмеймін, бірақ...
Dialogue: 0,0:11:50.53,0:11:53.53,Default,,0,0,0,,Егер бір адам болса да хабар тарату арқылы қашып құтыла алса
Dialogue: 0,0:11:53.53,0:11:56.53,Default,,0,0,0,,Бұл ысырап болмауы керек.
Dialogue: 0,0:11:59.53,0:12:02.52,Default,,0,0,0,,Маңайдағылар да қаланы тастап кетуі керек.
Dialogue: 0,0:12:02.52,0:12:04.52,Default,,0,0,0,,Мүмкіндігінше алысқа жүгіріңіз
Dialogue: 0,0:12:07.51,0:12:09.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:11.50,0:12:15.50,Default,,0,0,0,,``Үйге'' ағып жатыр, тез үйге қайтайық.
Dialogue: 0,0:12:17.50,0:12:22.50,Default,,0,0,0,,Ниими мырза да қашып кеткен сияқты. Иә.
Dialogue: 0,0:12:52.50,0:12:54.52,Default,,0,0,0,,Ах! Ниими-сан әлі осында
Dialogue: 0,0:12:54.52,0:12:56.52,Default,,0,0,0,,Га
Dialogue: 0,0:13:11.51,0:13:16.51,Default,,0,0,0,,Екеуің де амансыңдар деп үміттенемін...
Dialogue: 0,0:13:23.54,0:13:25.54,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:52.63,0:13:55.63,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:13:55.63,0:13:58.63,Default,,0,0,0,,Қазір үлкен залға келе аласыз ба?
Dialogue: 0,0:13:59.62,0:14:03.62,Default,,0,0,0,,Сатору Асахина мен Саки Ватанабе қатысты.
Dialogue: 0,0:14:04.59,0:14:06.61,Default,,0,0,0,,О...
Dialogue: 0,0:14:06.61,0:14:09.61,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:14:09.61,0:14:14.61,Default,,0,0,0,,Томико-самада өзгеріс бар ма?
Dialogue: 0,0:14:16.64,0:14:18.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:19.62,0:14:21.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:37.63,0:14:42.63,Default,,0,0,0,,Менің ата-анам мұнда келмеді ме?
Dialogue: 0,0:14:44.60,0:14:46.63,Default,,0,0,0,,Сіз пайда болдыңыз.
Dialogue: 0,0:14:46.63,0:14:49.63,Default,,0,0,0,,Не? Қазір қайдасың?
Dialogue: 0,0:14:50.59,0:14:55.63,Default,,0,0,0,,Екеуің Муши Шонин және Гёсутешимен сөйлестіңдер.
Dialogue: 0,0:14:55.63,0:14:57.61,Default,,0,0,0,,Сіз қалаға оралдыңыз хаха...
Dialogue: 0,0:14:57.61,0:14:59.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:59.63,0:15:04.60,Default,,0,0,0,,Қазір тез арада жындыны қалай болса да тоқтату керек.
Dialogue: 0,0:15:04.60,0:15:08.59,Default,,0,0,0,,Сол үшін мен қаладағы таза емес мысықтардың барлығын босаттым.
Dialogue: 0,0:15:08.59,0:15:10.61,Default,,0,0,0,,Жындармен бетпе-бет келгенде...
Dialogue: 0,0:15:10.61,0:15:13.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:13.61,0:15:16.60,Default,,0,0,0,,Екеуің келгенде маған бересіңдер.
Dialogue: 0,0:15:16.60,0:15:19.60,Default,,0,0,0,,Менің саған сақтайтын нәрсем бар. Ах...
Dialogue: 0,0:15:19.60,0:15:22.60,Default,,0,0,0,,Мен оны кейінірек қараймын.
Dialogue: 0,0:15:23.62,0:15:27.62,Default,,0,0,0,,Маған дереу көрсетіңіз...
Dialogue: 0,0:15:29.63,0:15:32.63,Default,,0,0,0,,Жарайды, мен оны бірден әкелемін.
Dialogue: 0,0:15:32.63,0:15:36.62,Default,,0,0,0,,Оның алдында сенімен танысқысы келетін адам бар.
Dialogue: 0,0:15:36.62,0:15:38.64,Default,,0,0,0,,Біз сізді күтеміз.
Dialogue: 0,0:15:38.64,0:15:40.64,Default,,0,0,0,,Иә
Dialogue: 0,0:15:49.63,0:15:51.62,Default,,0,0,0,,Инуи мырза!
Dialogue: 0,0:15:51.62,0:15:55.60,Default,,0,0,0,,Ватанабе мырза, сіздің қауіпсіз болғаныңызға қуаныштымын. Асахина-сан да...
Dialogue: 0,0:15:55.60,0:15:58.64,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:15:58.64,0:16:00.63,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:16:00.63,0:16:03.61,Default,,0,0,0,,Маған берілген тапсырманы орындай алмады
Dialogue: 0,0:16:03.61,0:16:07.62,Default,,0,0,0,,Менің қолымнан келгені қашып кету болды.
Dialogue: 0,0:16:07.62,0:16:10.60,Default,,0,0,0,,Болды...екінші адам жын болды.
Dialogue: 0,0:16:10.60,0:16:12.62,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:16:12.62,0:16:14.61,Default,,0,0,0,,Жоқ, тым болмаса сәл ертерек.
Dialogue: 0,0:16:14.61,0:16:17.63,Default,,0,0,0,,Қалаға хабарлай алсам ғой...
Dialogue: 0,0:16:17.63,0:16:19.61,Default,,0,0,0,,Инуи мырза
Dialogue: 0,0:16:19.61,0:16:21.61,Default,,0,0,0,,Шиоя шыбындар колониясын жоюға кім барды?
Dialogue: 0,0:16:21.61,0:16:23.63,Default,,0,0,0,,Бұл бір апта бұрын болды, солай ма?
Dialogue: 0,0:16:23.63,0:16:26.63,Default,,0,0,0,,Бұдан кейін не болды?
Dialogue: 0,0:16:29.60,0:16:33.63,Default,,0,0,0,,Біз Қауіпсіздік Кеңесінің бұйрығымен сайтқа бет алдық.
Dialogue: 0,0:16:33.63,0:16:38.63,Default,,0,0,0,,Алайда Шиоя Шыбындар колониясының әскері әлдеқашан жоғалып кеткен болатын.
Dialogue: 0,0:16:39.61,0:16:41.63,Default,,0,0,0,,Алғашқы үш күн
Dialogue: 0,0:16:41.63,0:16:44.63,Default,,0,0,0,,Бүкіл күн нәтижесіз барлаумен аяқталды.
Dialogue: 0,0:16:45.62,0:16:50.62,Default,,0,0,0,,Ақыры, төртінші күні түнгі лагерьдің қалдықтарын таптым.
Dialogue: 0,0:16:51.63,0:16:57.63,Default,,0,0,0,,Бір сағатқа жуық аңдығаннан кейін біз бір взвод егеуқұйрықтарды таптық.
Dialogue: 0,0:17:06.62,0:17:08.62,Default,,0,0,0,,Git! Гига!
Dialogue: 0,0:17:11.63,0:17:13.62,Default,,0,0,0,,Гаг гаг
Dialogue: 0,0:17:13.62,0:17:16.62,Default,,0,0,0,,Гуа~
Dialogue: 0,0:17:18.62,0:17:20.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:31.62,0:17:33.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:36.62,0:17:39.62,Default,,0,0,0,,Сіз кімсіз? Уф...
Dialogue: 0,0:17:39.62,0:17:41.62,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:17:42.63,0:17:44.61,Default,,0,0,0,,Гуэа~
Dialogue: 0,0:17:44.61,0:17:47.63,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:17:47.63,0:17:50.63,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:17:57.63,0:18:00.63,Default,,0,0,0,,Қараңғы түскенше күтемін
Dialogue: 0,0:18:00.63,0:18:02.61,Default,,0,0,0,,Мен қаланы нысанаға аламын деп ойладым.
Dialogue: 0,0:18:02.61,0:18:04.65,Default,,0,0,0,,Бірақ тышқандар
Dialogue: 0,0:18:04.65,0:18:07.65,Default,,0,0,0,,Мен мәңгілік бірдеңе іздегендей болдым.
Dialogue: 0,0:18:07.65,0:18:13.64,Default,,0,0,0,,Олар Қасқырдың бес адамнан тұратын топтарда жұмыс істейтінін білді.
Dialogue: 0,0:18:13.64,0:18:16.64,Default,,0,0,0,,Менің қолымнан келгеннің бәрі табылмас үшін.
Dialogue: 0,0:18:16.64,0:18:20.63,Default,,0,0,0,,Қоршаудан құтылу мүмкін болмады.
Dialogue: 0,0:18:20.63,0:18:25.62,Default,,0,0,0,,Алайда төртінші күні кеше түстен кейін болды.
Dialogue: 0,0:18:25.62,0:18:29.64,Default,,0,0,0,,Кенеттен бүкіл Бакематсу әскері қозғала бастады.
Dialogue: 0,0:18:29.64,0:18:33.64,Default,,0,0,0,,Мен қалаға бет алғанша қараңғы түскенше күттім.
Dialogue: 0,0:18:35.61,0:18:37.65,Default,,0,0,0,,Бакемонезу шетке
Dialogue: 0,0:18:37.65,0:18:42.64,Default,,0,0,0,,Мен сізге жындар туралы бірден ескерту қажеттігін сезіндім.
Dialogue: 0,0:18:42.64,0:18:45.62,Default,,0,0,0,,Біз Михараши но Сатоға жеттік.
Dialogue: 0,0:18:45.62,0:18:47.64,Default,,0,0,0,,Мен бір адамды таба алмаймын. Ах...
Dialogue: 0,0:18:47.64,0:18:49.64,Default,,0,0,0,,Жазғы фестиваль...
Dialogue: 0,0:18:49.64,0:18:54.63,Default,,0,0,0,,Иә, адамдар төлеп жатты, бірақ...
Dialogue: 0,0:18:54.63,0:18:56.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:56.63,0:19:00.64,Default,,0,0,0,,Егер сіз ауруханада немесе балабақшада болсаңыз, онда әрқашан біреу болады...
Dialogue: 0,0:19:00.64,0:19:02.61,Default,,0,0,0,,Әрине, оларда мұндай әдет бар.
Dialogue: 0,0:19:02.61,0:19:04.66,Default,,0,0,0,,Мен білдім
Dialogue: 0,0:19:04.66,0:19:08.65,Default,,0,0,0,,Осы уақытқа дейін колониялар арасындағы дау шешілген сайын,
Dialogue: 0,0:19:08.65,0:19:11.65,Default,,0,0,0,,Мен осындай көрініске куә болдым.
Dialogue: 0,0:19:11.65,0:19:16.65,Default,,0,0,0,,Ол кезде мен мұны төменгі жануарлар жасайтын нәрсе деп ойладым.
Dialogue: 0,0:19:16.65,0:19:18.64,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:19:18.64,0:19:21.63,Default,,0,0,0,,Мүмкін адам...
Dialogue: 0,0:19:21.63,0:19:25.63,Default,,0,0,0,,Бір минут күтіңіз! Бұл құбыжық егеуқұйрық...
Dialogue: 0,0:19:25.63,0:19:27.63,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:28.65,0:19:33.65,Default,,0,0,0,,Олар қорқынышты түрде адам сәбилерін нысанаға алды.
Dialogue: 0,0:19:34.66,0:19:36.64,Default,,0,0,0,,Ең болмағанда… Микасаның жиі басы ауырады деген факті➡
Dialogue: 0,0:19:36.64,0:19:40.66,Default,,0,0,0,,Бұлардың барлығы Цучигумо патшайымынан туған жас аңдар.
Dialogue: 0,0:19:40.66,0:19:43.65,Default,,0,0,0,,Жас аң? балам?
Dialogue: 0,0:19:43.65,0:19:46.65,Default,,0,0,0,,Бұл бағалы олжа
Dialogue: 0,0:19:46.65,0:19:51.64,Default,,0,0,0,,Біздің колонияның ертеңіне қолдау көрсететін жұмыс күші болыңыз.
Dialogue: 0,0:19:51.64,0:19:53.64,Default,,0,0,0,,Патшайым өлім жазасына кесілді
Dialogue: 0,0:19:53.64,0:19:56.61,Default,,0,0,0,,Біз өмір бойы құл болып қорлық көреміз.
Dialogue: 0,0:19:56.61,0:20:00.63,Default,,0,0,0,,Тірі болғанша, малдан кем қарайды.
Dialogue: 0,0:20:00.63,0:20:04.63,Default,,0,0,0,,Өліп қалса, егістікке лақтырылады немесе егістікке тыңайтқыш ретінде пайдаланылады.
Dialogue: 0,0:20:05.62,0:20:07.66,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:07.66,0:20:13.63,Default,,0,0,0,,Ногицунемарудың шынайы мақсаты – адам баласын алу...
Dialogue: 0,0:20:13.63,0:20:15.63,Default,,0,0,0,,Ха...
Dialogue: 0,0:20:15.63,0:20:17.65,Default,,0,0,0,,Бұл қос ойын да емес.
Dialogue: 0,0:20:17.65,0:20:20.65,Default,,0,0,0,,Біріншіден, Мамору мен Марияның баласы.
Dialogue: 0,0:20:20.65,0:20:22.65,Default,,0,0,0,,Бала өседі
Dialogue: 0,0:20:22.65,0:20:25.62,Default,,0,0,0,,Шусей мырза да жеңетін жынға айналды.
Dialogue: 0,0:20:25.62,0:20:28.66,Default,,0,0,0,,10 жылдан кейін сол жеңіске жеткен көптеген балалар
Dialogue: 0,0:20:28.66,0:20:30.65,Default,,0,0,0,,Егер әркім сиқырлы күшті пайдалана білсе...
Dialogue: 0,0:20:30.65,0:20:33.63,Default,,0,0,0,,Хехе…
Dialogue: 0,0:20:33.63,0:20:37.64,Default,,0,0,0,,Мен ақыры түсіндім
Dialogue: 0,0:20:37.64,0:20:40.66,Default,,0,0,0,,Бұл Ногицунемарудың жасырын суретін салған.
Dialogue: 0,0:20:40.66,0:20:43.66,Default,,0,0,0,,Бұл керемет дизайн болды.
Dialogue: 0,0:20:43.66,0:20:46.66,Default,,0,0,0,,Жынды қолдану
Dialogue: 0,0:20:46.66,0:20:49.63,Default,,0,0,0,,Егер сіз Камисудың 66 қаласын ала алсаңыз, бұл да жақсы.
Dialogue: 0,0:20:49.63,0:20:53.65,Default,,0,0,0,,Толық жеңу мүмкін болмаса да
Dialogue: 0,0:20:53.65,0:20:57.64,Default,,0,0,0,,Қанша 10 жыл өмір сүре алады
Dialogue: 0,0:20:57.64,0:21:00.64,Default,,0,0,0,,Балабақшадағы сәбилер
Dialogue: 0,0:21:00.64,0:21:03.64,Default,,0,0,0,,Бакемонезу тәрбиеленген
Dialogue: 0,0:21:03.64,0:21:06.65,Default,,0,0,0,,Сен де жын болып өссең
Dialogue: 0,0:21:06.65,0:21:10.67,Default,,0,0,0,,Жапонияның ешбір қаласы қарсылық көрсете алмайды.
Dialogue: 0,0:21:10.67,0:21:14.62,Default,,0,0,0,,Содан кейін олар тағы да балаларды ұрлады.
Dialogue: 0,0:21:14.62,0:21:17.63,Default,,0,0,0,,Жындар әскерін құрсаң
Dialogue: 0,0:21:17.63,0:21:21.65,Default,,0,0,0,,Жапониядан Қиыр Шығыс Азияға және бүкіл Еуразиядан
Dialogue: 0,0:21:21.65,0:21:26.65,Default,,0,0,0,,Бүкіл әлемді жаулап алудың өзі арман емес.
Dialogue: 0,0:21:27.65,0:21:31.65,Default,,0,0,0,,Ұлы Бакемацу империясының дүниеге келуі
Dialogue: 0,0:23:07.67,0:23:09.65,Default,,0,0,0,,Сіз Томико-самадансыз.
Dialogue: 0,0:23:09.65,0:23:11.64,Default,,0,0,0,,Таңдалған адам екеніңді ұмытпа.
Dialogue: 0,0:23:11.64,0:23:13.67,Default,,0,0,0,,Мұндай емдеу түрі тым көп.
Dialogue: 0,0:23:13.67,0:23:15.64,Default,,0,0,0,,Кем дегенде мына тізбекті алып тастаңыз.
Dialogue: 0,0:23:15.64,0:23:18.65,Default,,0,0,0,,Менің басымнан осындай бірдеңе болса қиналып қалар едім.
Dialogue: 0,0:23:18.65,0:23:20.65,Default,,0,0,0,,Менің уақытым жоқ. Мен баруым керек.
