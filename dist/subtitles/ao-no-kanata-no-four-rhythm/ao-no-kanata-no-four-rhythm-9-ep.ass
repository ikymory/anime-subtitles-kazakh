Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.66,0:00:26.96,Default,,0,0,0,,Неліктен Мисаки-сенпай баспаны Асука-сенпайға жеткізеді?
Dialogue: 0,0:00:27.32,0:00:29.01,Default,,0,0,0,,Жақсы, маңызды емес.
Dialogue: 0,0:00:29.19,0:00:33.09,Default,,0,0,0,,Маширо жаңбырға байланысты жаттығудан үзіліс алады, сондықтан менімен аздап араласыңыз.
Dialogue: 0,0:00:33.24,0:00:36.66,Default,,0,0,0,,А, маған кенеттен айтты.
Dialogue: 0,0:00:36.66,0:00:38.48,Default,,0,0,0,,Мен тез барамын
Dialogue: 0,0:00:38.48,0:00:42.05,Default,,0,0,0,,Мисаки-сенпай, әрине жауап иә.
Dialogue: 0,0:00:43.30,0:00:48.37,Default,,0,0,0,,Жауабы аспанда екені сөзсіз
Dialogue: 0,0:00:49.33,0:00:55.37,Default,,0,0,0,,Шексіз әлем, қараңғылықты жарып өт
Dialogue: 0,0:00:48.07,0:00:49.50,Default,,0,0,0,,Сол дауыс…
Dialogue: 0,0:00:50.58,0:00:51.64,Default,,0,0,0,,Асука
Dialogue: 0,0:00:52.57,0:00:54.24,Default,,0,0,0,,Сіз ән айтып жатырсыз.
Dialogue: 0,0:00:55.57,0:01:01.89,Default,,0,0,0,,Күлді ойлар – Аспан чемпионы Зефирион
Dialogue: 0,0:02:37.92,0:02:39.55,Default,,0,0,0,,Бір нәрсені жоғалтты
Dialogue: 0,0:02:39.55,0:02:42.48,Default,,0,0,0,,Бұл ән Зефирионның негізгі әні болды.
Dialogue: 0,0:02:42.61,0:02:43.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:43.79,0:02:46.27,Default,,0,0,0,,Бұл мен кішкентай кезімде көрген робот аниме.
Dialogue: 0,0:02:46.52,0:02:48.83,Default,,0,0,0,,Не деген пайдасыз басты кейіпкер.
Dialogue: 0,0:02:48.83,0:02:49.32,Default,,0,0,0,,Не?
Dialogue: 0,0:02:49.32,0:02:52.38,Default,,0,0,0,,Сіз Зефирионға мінгенде, сіз жеңілмейтін боласыз.
Dialogue: 0,0:02:53.14,0:02:54.30,Default,,0,0,0,,Асукадан
Dialogue: 0,0:02:54.47,0:02:57.44,Default,,0,0,0,,Басып шығаруды жеткізгеніңіз үшін рахмет.
Dialogue: 0,0:02:57.68,0:02:59.19,Default,,0,0,0,,Мен оны анамнан алдым.
Dialogue: 0,0:02:59.19,0:03:01.07,Default,,0,0,0,,Байқамағаным үшін кешіріңіз
Dialogue: 0,0:03:01.12,0:03:02.99,Default,,0,0,0,,Мен оны біраз уақытқа қарызға аламын ба?
Dialogue: 0,0:03:02.99,0:03:03.84,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:03:04.49,0:03:07.86,Default,,0,0,0,,Сіз бұрын Зефирионның әнін орындадыңыз.
Dialogue: 0,0:03:07.86,0:03:09.40,Default,,0,0,0,,Келесі жолы Зефири жасайық.
Dialogue: 0,0:03:13.41,0:03:14.63,Default,,0,0,0,,Мен жауап алдым
Dialogue: 0,0:03:14.81,0:03:16.68,Default,,0,0,0,,Zefi Zephy дегеніміз не?
Dialogue: 0,0:03:16.68,0:03:19.07,Default,,0,0,0,,Менің ойымша, бұл міндетті түрде істеу керек нәрсе.
Dialogue: 0,0:03:19.07,0:03:23.36,Default,,0,0,0,,Жоқ, менде алаңдайтын ештеңе болған жоқ.
Dialogue: 0,0:03:27.14,0:03:28.96,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:29.60,0:03:33.41,Default,,0,0,0,,Қайырлы таң, Асука-чан жақсы көрінеді.
Dialogue: 0,0:03:33.41,0:03:35.57,Default,,0,0,0,,Иә, алаңдатқанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:03:36.10,0:03:38.69,Default,,0,0,0,,Мисаки-чан, кешегі күн үшін рахмет.
Dialogue: 0,0:03:40.09,0:03:41.18,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:44.05,0:03:47.92,Default,,0,0,0,,Жаңа менеджер, тәжірибеден болмағаныма кешірім сұраймын.
Dialogue: 0,0:03:47.92,0:03:49.87,Default,,0,0,0,,Иә, кеше жаңбыр жауды.
Dialogue: 0,0:03:49.87,0:03:53.13,Default,,0,0,0,,Қызық, жаңа күріш жақын арада орыла ма?
Dialogue: 0,0:03:53.36,0:03:54.27,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:54.28,0:03:56.30,Default,,0,0,0,,Қайырлы таң жаттықтырушы
Dialogue: 0,0:03:56.47,0:03:58.18,Default,,0,0,0,,Асука, жақсысың ба?
Dialogue: 0,0:03:58.18,0:04:01.05,Default,,0,0,0,,Иә, сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:04:01.05,0:04:02.42,Default,,0,0,0,,Бүгін үйірмеге қатыса аламын деп ойлайсыз ба?
Dialogue: 0,0:04:02.42,0:04:05.73,Default,,0,0,0,,Иә, бәрі жақсы. Уайымдама.
Dialogue: 0,0:04:05.73,0:04:10.20,Default,,0,0,0,,Өйткені, Асука меннен бөлек.
Dialogue: 0,0:04:11.12,0:04:12.05,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:04:09.99,0:04:12.09,Default,,0,0,0,,Сіз аурудан енді ғана жазылып келе жатырсыз, сондықтан өзіңізді қатты итермеңіз.
Dialogue: 0,0:04:12.09,0:04:16.28,Default,,0,0,0,,Жоқ, жоқ, мен бес сағат бойы үздіксіз ұшатын сияқтымын.
Dialogue: 0,0:04:16.28,0:04:17.90,Default,,0,0,0,,Асука-чанға ұқсайды
Dialogue: 0,0:04:23.23,0:04:25.41,Default,,0,0,0,,А...Асука-сенпай?
Dialogue: 0,0:04:28.21,0:04:31.70,Default,,0,0,0,,Мен...Кешіріңіз, мен жақсы ұша алмаймын.
Dialogue: 0,0:04:32.10,0:04:34.87,Default,,0,0,0,,Позаңызды тұрақтандыруға және түзу ұшуға тырысыңыз.
Dialogue: 0,0:04:34.87,0:04:36.32,Default,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:04:39.03,0:04:41.49,Default,,0,0,0,,Сосын келесіде хай ё йо
Dialogue: 0,0:04:41.80,0:04:42.76,Default,,0,0,0,,Иә
Dialogue: 0,0:04:47.36,0:04:49.05,Default,,0,0,0,,Олай болса, келесі жолы
Dialogue: 0,0:04:49.05,0:04:50.68,Default,,0,0,0,,Иә
Dialogue: 0,0:04:55.16,0:04:56.04,Default,,0,0,0,,Асука
Dialogue: 0,0:05:00.16,0:05:02.59,Default,,0,0,0,,Қызық, Асука-чанға не болды?
Dialogue: 0,0:05:02.59,0:05:04.14,Default,,0,0,0,,Асука сәл
Dialogue: 0,0:05:04.34,0:05:05.45,Default,,0,0,0,,Иә
Dialogue: 0,0:05:08.51,0:05:09.68,Default,,0,0,0,,Асука-чан
Dialogue: 0,0:05:13.47,0:05:16.34,Default,,0,0,0,,Кешіріңіз, бұл мүлдем жақсы емес.
Dialogue: 0,0:05:16.85,0:05:20.71,Default,,0,0,0,,Бұл рас. Менің шытырман оқиғалы кітабым жоғалып кеткен сияқты.
Dialogue: 0,0:05:21.41,0:05:22.67,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:23.85,0:05:25.23,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:26.89,0:05:29.07,Default,,0,0,0,,Бүгінгі күнді икемділікпен аяқтайық.
Dialogue: 0,0:05:29.62,0:05:30.48,Default,,0,0,0,,Жаттықтырушы
Dialogue: 0,0:05:30.87,0:05:33.73,Default,,0,0,0,,Үйге келгенде суретті жаттықтыруға тырысыңыз.
Dialogue: 0,0:05:34.72,0:05:37.10,Default,,0,0,0,,Жақсы ұшуды елестетіңіз.
Dialogue: 0,0:05:37.79,0:05:39.72,Default,,0,0,0,,Олай болса, ертең қайталап көрейік.
Dialogue: 0,0:05:41.08,0:05:42.49,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:43.54,0:05:45.50,Default,,0,0,0,,Сен бүкіл отбасыңмен бірге осыған көшіп алғаның дұрыс.
Dialogue: 0,0:05:48.53,0:05:49.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:49.95,0:05:55.09,Default,,0,0,0,,Жарайды, кез келген спорт түрінен ұлы спортшылар кейде өз пішінін жоғалтады дейді.
Dialogue: 0,0:06:00.93,0:06:10.16,Default,,0,0,0,,Шамды қосып, тұрыңыз
Dialogue: 0,0:06:11.55,0:06:20.66,Default,,0,0,0,,Менің пайдасыз мен жай ғана қалқып тұрады
Dialogue: 0,0:06:30.45,0:06:31.24,Default,,0,0,0,,Эй
Dialogue: 0,0:06:34.36,0:06:35.63,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:36.53,0:06:37.52,Default,,0,0,0,,Қауырсын
Dialogue: 0,0:06:38.31,0:06:39.63,Default,,0,0,0,,Зефирион?
Dialogue: 0,0:06:40.12,0:06:42.83,Default,,0,0,0,,Сіз жоғалған баласыз ба?
Dialogue: 0,0:06:42.93,0:06:46.48,Default,,0,0,0,,Мен... адасқан жоқпын.
Dialogue: 0,0:06:47.40,0:06:48.48,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:06:48.48,0:06:52.40,Default,,0,0,0,,Мен жылауық, мазасыз, жоқ-жоқ, жоқ-жоқ, жоқ-жоқ.
Dialogue: 0,0:06:52.41,0:06:53.94,Default,,0,0,0,,Зефирион?
Dialogue: 0,0:06:56.40,0:06:58.21,Default,,0,0,0,,Олай болса бірге ойнайық
Dialogue: 0,0:07:00.43,0:07:01.25,Default,,0,0,0,,Кеттік
Dialogue: 0,0:07:02.26,0:07:03.25,Default,,0,0,0,,Иә
Dialogue: 0,0:07:27.87,0:07:29.34,Default,,0,0,0,,Мен қазір үйге бара жатырмын
Dialogue: 0,0:07:30.66,0:07:33.92,Default,,0,0,0,,Дос болып қалсақ та
Dialogue: 0,0:07:37.43,0:07:38.58,Default,,0,0,0,,Мен саған мынаны беремін
Dialogue: 0,0:07:40.63,0:07:41.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:41.83,0:07:42.99,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:07:44.84,0:07:46.32,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:52.40,0:07:54.38,Default,,0,0,0,,Бұл басынан бері бұзылды.
Dialogue: 0,0:08:03.07,0:08:04.74,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:09.69,0:08:13.16,Default,,0,0,0,,Мен сенің ұша алмайтыныңды естідім, бірақ осы уақытқа дейін ұша аласың.
Dialogue: 0,0:08:13.48,0:08:14.92,Default,,0,0,0,,Мисаки-чан
Dialogue: 0,0:08:16.66,0:08:19.45,Default,,0,0,0,,Эй, мен түскі қорапты сыныпта ұмытып кетіппін.
Dialogue: 0,0:08:19.61,0:08:21.84,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:08:21.99,0:08:23.77,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:08:29.54,0:08:30.88,Default,,0,0,0,,Ол тіркелмеген.
Dialogue: 0,0:08:32.34,0:08:33.48,Default,,0,0,0,,Шашты әшекейлеу
Dialogue: 0,0:08:34.80,0:08:38.82,Default,,0,0,0,,Мен... оны киюге болмайды деп ойлаймын.
Dialogue: 0,0:08:39.40,0:08:43.16,Default,,0,0,0,,Бұл қауырсындар менікі емес шығар.
Dialogue: 0,0:08:43.89,0:08:46.88,Default,,0,0,0,,Кішкентай кезімнен аспанда ұшқым келді.
Dialogue: 0,0:08:47.43,0:08:49.76,Default,,0,0,0,,Мен өзімнің жаман мінезімді өзгерткім келді.
Dialogue: 0,0:08:50.02,0:08:55.22,Default,,0,0,0,,Сондықтан мен Кунашимаға алғаш ұшқанда қатты қуандым.
Dialogue: 0,0:08:56.09,0:08:59.72,Default,,0,0,0,,ФК бастағаннан кейін қатты жаттығу кезінде
Dialogue: 0,0:08:59.79,0:09:02.36,Default,,0,0,0,,Мен көптеген таңғажайып адамдарды кездестірдім.
Dialogue: 0,0:09:02.65,0:09:05.73,Default,,0,0,0,,Содан соң қызық болды.
Dialogue: 0,0:09:06.76,0:09:10.94,Default,,0,0,0,,Мен сондай-ақ Inui's FC шынымен керемет деп ойладым.
Dialogue: 0,0:09:11.51,0:09:14.04,Default,,0,0,0,,Осындай нәрсені жасай алатын адамдар бар.
Dialogue: 0,0:09:14.57,0:09:19.64,Default,,0,0,0,,Мен де ары қарай ұша аламын деп ойладым.
Dialogue: 0,0:09:21.54,0:09:25.70,Default,,0,0,0,,Бірақ мен жай ғана толқыдым.
Dialogue: 0,0:09:26.79,0:09:30.75,Default,,0,0,0,,Мен Инуи мырзаның ойында ештеңе істей алмадым.
Dialogue: 0,0:09:31.69,0:09:35.45,Default,,0,0,0,,Бұл жақсы болмады, мүлде өзгерген жоқ.
Dialogue: 0,0:09:36.12,0:09:37.65,Default,,0,0,0,,Осы уақытқа дейін қауырсындар
Dialogue: 0,0:09:37.81,0:09:41.93,Default,,0,0,0,,Бұл мен Мисаки-чан мен жаттықтырушыдан алған нәрсем еді.
Dialogue: 0,0:09:42.40,0:09:45.89,Default,,0,0,0,,Сондықтан мен ештеңе істей алмаймын ба деп қорқамын.
Dialogue: 0,0:09:46.01,0:09:47.76,Default,,0,0,0,,Енді ұша алмайды
Dialogue: 0,0:09:49.84,0:09:50.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:57.64,0:10:01.07,Default,,0,0,0,,Жалғыз жаттығу бос сияқты.
Dialogue: 0,0:10:01.27,0:10:04.52,Default,,0,0,0,,Асука-чан бүгін де имидждік жаттығулар жасағысы келеді.
Dialogue: 0,0:10:04.52,0:10:05.76,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:10:25.46,0:10:26.77,Default,,0,0,0,,Асука...
Dialogue: 0,0:11:02.10,0:11:03.14,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:04.02,0:11:05.84,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:11:05.84,0:11:07.70,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:07.86,0:11:09.40,Default,,0,0,0,,Көңілсіз жүзбен
Dialogue: 0,0:11:09.40,0:11:11.63,Default,,0,0,0,,Менің үйімнің алдында тұрсаң да
Dialogue: 0,0:11:12.34,0:11:15.65,Default,,0,0,0,,Мен сіздің хабарламаңызға жауап бергім келді.
Dialogue: 0,0:11:15.65,0:11:17.69,Default,,0,0,0,,Менің ұялы телефонымның батареясы таусылған.
Dialogue: 0,0:11:17.69,0:11:19.62,Default,,0,0,0,,Не істеу керектігін ойластырған соң...
Dialogue: 0,0:11:19.62,0:11:24.28,Default,,0,0,0,,Сондықтан да Асуқа-сенпайға келіп жауап қайтару тән.
Dialogue: 0,0:11:25.20,0:11:28.74,Default,,0,0,0,,Жүр, Маширо неге мұнда?
Dialogue: 0,0:11:28.74,0:11:29.96,Default,,0,0,0,,Өйткені
Dialogue: 0,0:11:29.96,0:11:33.56,Default,,0,0,0,,Мисаки-сенпай маған Асука-сенпайдың осында екенін хабарлады.
Dialogue: 0,0:11:33.56,0:11:35.60,Default,,0,0,0,,Асықпадың ба?
Dialogue: 0,0:11:35.69,0:11:37.49,Default,,0,0,0,,Ешқашан бейберекеттікте адаспаңыз
Dialogue: 0,0:11:37.49,0:11:41.85,Default,,0,0,0,,Мен мұнда үлкен ағамның тағамын жеу үшін келген сияқты емеспін.
Dialogue: 0,0:11:42.49,0:11:44.76,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:11:44.76,0:11:46.05,Default,,0,0,0,,Тез тамақтанып алайық
Dialogue: 0,0:11:46.05,0:11:48.21,Default,,0,0,0,,Иә, itadakimasu
Dialogue: 0,0:11:48.24,0:11:49.92,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:11:50.47,0:11:52.84,Default,,0,0,0,,Бүгін мен гиоза жасап көрдім.
Dialogue: 0,0:11:52.84,0:11:56.28,Default,,0,0,0,,Иек сорпасы мол ұшатын балық балық шарлары.
Dialogue: 0,0:11:56.28,0:11:57.93,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:11:57.93,0:12:00.10,Default,,0,0,0,,Сенпайдың ұшатын балығы гиозасы
Dialogue: 0,0:12:00.10,0:12:01.57,Default,,0,0,0,,Маған махаббат керек емес
Dialogue: 0,0:12:01.57,0:12:03.12,Default,,0,0,0,,Алайда дәл сол адамдар, олар өмірін қатерге тігіп қорғайтындар
Dialogue: 0,0:12:03.13,0:12:05.30,Default,,0,0,0,,Бұл жақсы болуы керек.
Dialogue: 0,0:12:07.11,0:12:09.04,Default,,0,0,0,,Өте дәмді
Dialogue: 0,0:12:11.77,0:12:12.70,Default,,0,0,0,,Асука
Dialogue: 0,0:12:13.12,0:12:13.84,Default,,0,0,0,,Иә
Dialogue: 0,0:12:14.01,0:12:16.49,Default,,0,0,0,,Бүгін менің үйімде бол.
Dialogue: 0,0:12:17.36,0:12:19.39,Default,,0,0,0,,Түнде… Түнде…
Dialogue: 0,0:12:20.43,0:12:23.34,Default,,0,0,0,,Мисаки... Мисаки Сенпай
Dialogue: 0,0:12:23.45,0:12:28.74,Default,,0,0,0,,Мисаки-сенпайдың құшағында мен боламын.
Dialogue: 0,0:12:29.76,0:12:31.85,Default,,0,0,0,,Эй, тез тамақтан.
Dialogue: 0,0:12:31.85,0:12:32.66,Default,,0,0,0,,Мен оны тазалай алмаймын.
Dialogue: 0,0:12:32.66,0:12:33.77,Default,,0,0,0,,Иә
Dialogue: 0,0:12:36.96,0:12:41.07,Default,,0,0,0,,Сенпай Жоқ, жоқ, солай...
Dialogue: 0,0:12:44.49,0:12:45.76,Default,,0,0,0,,Таку
Dialogue: 0,0:12:45.96,0:12:47.83,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:48.42,0:12:50.94,Default,,0,0,0,,Мен Мисаки-чанға қиындық туғыздым.
Dialogue: 0,0:12:51.51,0:12:53.07,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:58.18,0:12:59.07,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:00.31,0:13:01.97,Default,,0,0,0,,Жұмысты тоқтату туралы хабарлама т.б.
Dialogue: 0,0:13:02.73,0:13:04.28,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:05.24,0:13:07.50,Default,,0,0,0,,Мисаки-чанға не болды?
Dialogue: 0,0:13:07.65,0:13:08.82,Default,,0,0,0,,Мен?
Dialogue: 0,0:13:09.77,0:13:11.37,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:12.76,0:13:15.06,Default,,0,0,0,,Қанша көрсем де әдемі
Dialogue: 0,0:13:17.35,0:13:19.63,Default,,0,0,0,,Маширо, сен бір жерге кетіп қалдың
Dialogue: 0,0:13:19.63,0:13:22.59,Default,,0,0,0,,Мен сондай қажетсіз баламын ба?
Dialogue: 0,0:13:22.59,0:13:26.01,Default,,0,0,0,,Мен өзімді қазір тастанды мысықтай сезінемін.
Dialogue: 0,0:13:26.01,0:13:27.53,Default,,0,0,0,,Иә, иә, мен оны лақтырып жібердім.
Dialogue: 0,0:13:28.83,0:13:32.26,Default,,0,0,0,,Түсінікті, Ожамасиро жоғалып кетеді.
Dialogue: 0,0:13:32.26,0:13:34.84,Default,,0,0,0,,Осыдан кейін екеуің бір-бірімен сырласуға болады.
Dialogue: 0,0:13:37.52,0:13:40.57,Default,,0,0,0,,Бұл фотоны қайдан алдың?
Dialogue: 0,0:13:40.57,0:13:41.97,Default,,0,0,0,,Менің де оны көргім келеді
Dialogue: 0,0:13:41.97,0:13:42.98,Default,,0,0,0,,Е, сәл күте тұрыңыз.
Dialogue: 0,0:13:46.49,0:13:48.73,Default,,0,0,0,,Бұл бала кім?
Dialogue: 0,0:13:48.73,0:13:49.73,Default,,0,0,0,,20-шы эпизод: Бастықтың соңғы бұйрығы
Dialogue: 0,0:13:50.35,0:13:51.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:52.75,0:13:55.28,Default,,0,0,0,,Мен жиі қателесетінмін.
Dialogue: 0,0:13:56.25,0:13:57.44,Default,,0,0,0,,Жарқыл…
Dialogue: 0,0:13:57.45,0:13:59.29,Default,,0,0,0,,Мен оны туған күніме сатып алдым.
Dialogue: 0,0:13:59.29,0:14:01.33,Default,,0,0,0,,Қуанғаным сонша, көбінесе жалғыз ұшатынмын.
Dialogue: 0,0:14:01.73,0:14:03.78,Default,,0,0,0,,Ақырында оған жетпей қалдым.
Dialogue: 0,0:14:03.78,0:14:06.21,Default,,0,0,0,,Кездейсоқ ойындарды ойнау
Dialogue: 0,0:14:06.36,0:14:08.45,Default,,0,0,0,,Мисаки-чан көңілді жүрген сияқты
Dialogue: 0,0:14:08.72,0:14:11.26,Default,,0,0,0,,Бірақ мен тез жалықтым.
Dialogue: 0,0:14:11.49,0:14:15.14,Default,,0,0,0,,Мен мұны білмей тұрып, ұшатын циркке назар аударуды қойдым.
Dialogue: 0,0:14:16.09,0:14:19.62,Default,,0,0,0,,Асука келген соң, мен тағы да еріксіз кірісіп кеттім.
Dialogue: 0,0:14:24.80,0:14:27.54,Default,,0,0,0,,Бұл жолы мен қашып кеттім
Dialogue: 0,0:14:29.36,0:14:32.59,Default,,0,0,0,,Мен Шиндо-санмен жақсы араластым деп ойладым.
Dialogue: 0,0:14:32.76,0:14:34.25,Default,,0,0,0,,Шындығында, мүлде...
Dialogue: 0,0:14:34.90,0:14:37.52,Default,,0,0,0,,Бірақ ол Асука туралы байсалды болды.
Dialogue: 0,0:14:37.93,0:14:41.48,Default,,0,0,0,,Мен көңілім қалды. Неге екенін түсінбедім.
Dialogue: 0,0:14:42.11,0:14:45.89,Default,,0,0,0,,Синдо мырза Инуи мырзаның кездесуінде жеңілді.
Dialogue: 0,0:14:46.09,0:14:47.85,Default,,0,0,0,,Оған сенгім келмеді
Dialogue: 0,0:14:48.09,0:14:51.07,Default,,0,0,0,,Мен өзімнен қорықтым.
Dialogue: 0,0:14:53.76,0:14:55.15,Default,,0,0,0,,Бірақ Асука...
Dialogue: 0,0:14:56.32,0:14:58.28,Default,,0,0,0,,Мен бұл керемет болды дедім.
Dialogue: 0,0:15:00.12,0:15:03.84,Default,,0,0,0,,Түсінбедім, бір-бірімізге сай емеспіз деп ойладым.
Dialogue: 0,0:15:06.03,0:15:10.32,Default,,0,0,0,,Синдо мырза осылай жеңілсе де, мүлде қорықпады.
Dialogue: 0,0:15:10.93,0:15:13.12,Default,,0,0,0,,Керісінше, мен ынталымын.
Dialogue: 0,0:15:13.17,0:15:15.95,Default,,0,0,0,,Бұл қорқынышты, өйткені бұл қызықты.
Dialogue: 0,0:15:17.25,0:15:21.05,Default,,0,0,0,,Маған ондай нәрсе ұнамайды, сондықтан...
Dialogue: 0,0:15:21.92,0:15:23.66,Default,,0,0,0,,Мен жұмыстан шығу туралы ойладым.
Dialogue: 0,0:15:24.12,0:15:25.76,Default,,0,0,0,,Мисаки-чан...
Dialogue: 0,0:15:29.20,0:15:30.35,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:15:32.80,0:15:34.72,Default,,0,0,0,,Бұл мен үшін жағымсыз.
Dialogue: 0,0:15:34.72,0:15:36.19,Default,,0,0,0,,Үш Құдайханымды адам қолымен ластау—
Dialogue: 0,0:15:36.19,0:15:37.94,Default,,0,0,0,,Мисаки-чан керемет
Dialogue: 0,0:15:40.03,0:15:41.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:42.24,0:15:43.22,Default,,0,0,0,,Асука...
Dialogue: 0,0:15:43.60,0:15:47.49,Default,,0,0,0,,Өйткені... Мисаки-чан мені алып кетті
Dialogue: 0,0:15:47.49,0:15:50.13,Default,,0,0,0,,Ол мені аспан әлеміне апарды.
Dialogue: 0,0:15:50.64,0:15:52.60,Default,,0,0,0,,Мисаки-чанға қара
Dialogue: 0,0:15:52.82,0:15:56.44,Default,,0,0,0,,Мен де сондай әдемі ұшсам екен.
Dialogue: 0,0:15:57.31,0:15:58.87,Default,,0,0,0,,А...рахмет
Dialogue: 0,0:15:58.87,0:15:59.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:04.03,0:16:05.71,Default,,0,0,0,,Асука жақсы.
Dialogue: 0,0:16:05.71,0:16:08.04,Default,,0,0,0,,Өз қанаттарымен ұша алады.
Dialogue: 0,0:16:08.23,0:16:09.62,Default,,0,0,0,,Ешқандай негіз болмаса да
Dialogue: 0,0:16:09.62,0:16:11.23,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:16:14.98,0:16:16.75,Default,,0,0,0,,Аа, осыншама ұзақ
Dialogue: 0,0:16:16.75,0:16:18.21,Default,,0,0,0,,Тезірек ұйықтауым керек пе?
Dialogue: 0,0:16:18.21,0:16:18.98,Default,,0,0,0,,Иә
Dialogue: 0,0:16:19.03,0:16:21.26,Default,,0,0,0,,Жарайды, мен футонды шығарайын, маған көмектес.
Dialogue: 0,0:16:21.36,0:16:22.77,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:16:19.95,0:16:24.93,Default,,0,0,0,,Тастанды мысық Маширо, сіз оны алмайсыз, солай ма?
Dialogue: 0,0:16:25.85,0:16:26.93,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:16:27.51,0:16:30.10,Default,,0,0,0,,Жарайды, оған көмектесу мүмкін емес.
Dialogue: 0,0:16:33.68,0:16:40.56,Default,,0,0,0,,Жеңілмейтін қанаттар Жұлдыздарды айналып жүгіреді
Dialogue: 0,0:16:40.56,0:16:47.25,Default,,0,0,0,,Жауабы аспанда екені сөзсіз
Dialogue: 0,0:16:47.25,0:16:54.08,Default,,0,0,0,,Шексіз әлем, қараңғылықты жарып өт
Dialogue: 0,0:16:54.08,0:17:03.42,Default,,0,0,0,,Күлді ойлар – Аспан чемпионы Зефирион
Dialogue: 0,0:17:07.92,0:17:11.17,Default,,0,0,0,,Екеуің де мені ұмытпадыңдар ма?
Dialogue: 0,0:17:11.37,0:17:14.34,Default,,0,0,0,,Түсіндім. Сіз олардың әлеміне кірдіңіз бе?
Dialogue: 0,0:17:14.34,0:17:16.32,Default,,0,0,0,,Дұрыс айтасың, сен сондай мазасыз адамсың.\NСіз
Dialogue: 0,0:17:16.32,0:17:17.61,Default,,0,0,0,,туралы естідіңіз бе?
Dialogue: 0,0:17:17.64,0:17:20.02,Default,,0,0,0,,Кешіріңіз, Маширо-чан.
Dialogue: 0,0:17:20.02,0:17:22.35,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:17:39.67,0:17:41.94,Default,,0,0,0,,Асығыңыз, кешігіп қаласыз.
Dialogue: 0,0:17:41.94,0:17:43.13,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:17:43.13,0:17:44.42,Default,,0,0,0,,А...мм...
Dialogue: 0,0:17:44.42,0:17:46.75,Default,,0,0,0,,Бұл не? Бұл Даш.
Dialogue: 0,0:17:46.75,0:17:47.90,Default,,0,0,0,,Мисаки-чан
Dialogue: 0,0:17:48.09,0:17:49.45,Default,,0,0,0,,Не?
Dialogue: 0,0:17:50.84,0:17:51.98,Default,,0,0,0,,Мен және...
Dialogue: 0,0:17:53.62,0:17:55.16,Default,,0,0,0,,Матч ойнаңыз
Dialogue: 0,0:17:56.50,0:17:57.98,Default,,0,0,0,,Асука-сенпай...
Dialogue: 0,0:17:59.43,0:18:02.49,Default,,0,0,0,,Жауап аспанда жатыр.
Dialogue: 0,0:18:07.81,0:18:10.52,Default,,0,0,0,,Бұл жұмысқа келмеу туралы есеп болды ма?
Dialogue: 0,0:18:10.66,0:18:15.00,Default,,0,0,0,,Иә, мен демалыс алғым келді.
Dialogue: 0,0:18:17.05,0:18:18.48,Default,,0,0,0,,-дағы Мисаки туралы не деуге болады?
Dialogue: 0,0:18:18.48,0:18:21.20,Default,,0,0,0,,Мен енді Асукамен жарысатын боламын.
Dialogue: 0,0:18:21.28,0:18:23.68,Default,,0,0,0,,ойынында Асукаға жеңіліп қалсаңыз, қайтарыңыз.
Dialogue: 0,0:18:24.92,0:18:28.09,Default,,0,0,0,,Асуканың тәтті болғаны сонша, жауабы аспанда.
Dialogue: 0,0:18:28.42,0:18:30.88,Default,,0,0,0,,Ауадағы жалғыз нәрсе - жеңесің бе, жеңілесің бе.
Dialogue: 0,0:18:31.03,0:18:33.44,Default,,0,0,0,,Мен міндетті түрде жеңемін
Dialogue: 0,0:18:33.88,0:18:35.01,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:18:40.00,0:18:43.37,Default,,0,0,0,,Асукамен төбелесу өте қорқынышты.
Dialogue: 0,0:18:44.37,0:18:47.25,Default,,0,0,0,,Мен жеңсем, Мисаки-чан қайтып келеді.
Dialogue: 0,0:18:47.44,0:18:49.05,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын
Dialogue: 0,0:18:49.21,0:18:50.52,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:18:50.52,0:18:51.37,Default,,0,0,0,,Жиын
Dialogue: 0,0:18:56.57,0:18:58.67,Default,,0,0,0,,Дұрыс ұшу
Dialogue: 0,0:18:58.67,0:19:00.92,Default,,0,0,0,,Қалай ұшу керек екені есімде.
Dialogue: 0,0:19:02.23,0:19:04.04,Default,,0,0,0,,Асука-сенпай нүктесі
Dialogue: 0,0:19:07.16,0:19:08.27,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:11.23,0:19:12.40,Default,,0,0,0,,Жою мүмкін емес
Dialogue: 0,0:19:12.76,0:19:14.16,Default,,0,0,0,,Өтірік
Dialogue: 0,0:19:15.22,0:19:17.54,Default,,0,0,0,,Мисаки-чан бірге жасайық
Dialogue: 0,0:19:17.59,0:19:23.23,Default,,0,0,0,,Асука: Бұл менің жолым.
Dialogue: 0,0:19:23.73,0:19:27.57,Default,,0,0,0,,Мисаки Сенпай 1-2-ге қарсы нүкте
Dialogue: 0,0:19:35.31,0:19:36.26,Default,,0,0,0,,Тәтті
Dialogue: 0,0:19:36.93,0:19:39.90,Default,,0,0,0,,Мисаки Сенпай 1-ден 3-ке дейін
Dialogue: 0,0:19:41.06,0:19:43.18,Default,,0,0,0,,Мисаки-чан керемет
Dialogue: 0,0:19:43.60,0:19:45.64,Default,,0,0,0,,Бірақ мен де
Dialogue: 0,0:19:46.59,0:19:47.98,Default,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:19:48.88,0:19:50.73,Default,,0,0,0,,Асука-сенпай нүктесі
Dialogue: 0,0:19:51.28,0:19:52.90,Default,,0,0,0,,Кеттік, Асука.
Dialogue: 0,0:19:54.34,0:19:55.12,Default,,0,0,0,,Иә
Dialogue: 0,0:20:03.47,0:20:04.62,Default,,0,0,0,,Жоғары...
Dialogue: 0,0:20:13.30,0:20:15.57,Default,,0,0,0,,Бұл Delta Force ма?
Dialogue: 0,0:20:15.95,0:20:17.62,Default,,0,0,0,,Асуканың импровизациясы?
Dialogue: 0,0:20:34.50,0:20:36.82,Default,,0,0,0,,Бұл менмін, түсіндім.
Dialogue: 0,0:20:37.54,0:20:38.93,Default,,0,0,0,,Қорқыныштысы болды
Dialogue: 0,0:20:39.15,0:20:43.87,Default,,0,0,0,,Мен алғаш рет байыпты бола алдым, өйткені мен өзіме құмар болатын нәрсені таптым.
Dialogue: 0,0:20:45.32,0:20:48.81,Default,,0,0,0,,Бірақ мен әлі де қорқатын шығармын.
Dialogue: 0,0:20:48.95,0:20:49.87,Default,,0,0,0,,Асука ше?
Dialogue: 0,0:20:50.07,0:20:55.40,Default,,0,0,0,,Мен тек жоғары қарап ұшып жүрмін.
Dialogue: 0,0:20:56.03,0:20:59.18,Default,,0,0,0,,Менің ойымша, жауап аспанда жатыр.
Dialogue: 0,0:21:00.92,0:21:02.02,Default,,0,0,0,,Бұл іске араласпа.
Dialogue: 0,0:21:03.32,0:21:04.60,Default,,0,0,0,,Мисаки Сенпай
Dialogue: 0,0:21:04.93,0:21:07.53,Default,,0,0,0,,Мен жеңдім, не істеуім керек?
Dialogue: 0,0:21:09.07,0:21:10.05,Default,,0,0,0,,Сізде қалам бар ма?
Dialogue: 0,0:21:10.34,0:21:10.97,Default,,0,0,0,,Иә
Dialogue: 0,0:21:11.24,0:21:12.30,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:21:14.73,0:21:15.29,Default,,0,0,0,,Иә
Dialogue: 0,0:21:15.84,0:21:16.76,Default,,0,0,0,,Міне
Dialogue: 0,0:21:18.87,0:21:21.76,Default,,0,0,0,,Қайту емес, қайту
Dialogue: 0,0:21:21.84,0:21:23.18,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:23.21,0:21:25.06,Default,,0,0,0,,Демек, сіз жаңа мүшесіз.
Dialogue: 0,0:21:25.06,0:21:26.08,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:21:26.08,0:21:28.56,Default,,0,0,0,,Бүгіннен бастап мені Маширо-сенпай деп атаңыз.
Dialogue: 0,0:21:28.56,0:21:29.44,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:31.65,0:21:37.24,Default,,0,0,0,,Жеңілмейтін қанаттар Жұлдыздарды айналып жүгіреді
Dialogue: 0,0:21:37.80,0:21:43.49,Default,,0,0,0,,Жауабы аспанда екені сөзсіз
Dialogue: 0,0:21:43.75,0:21:50.26,Default,,0,0,0,,Шексіз әлемнің қараңғылығын бұзыңыз
Dialogue: 0,0:21:50.26,0:21:56.76,Default,,0,0,0,,Айқайлаған ойлар – Аспан чемпионы Зефирион
Dialogue: 0,0:21:36.05,0:21:38.41,Default,,0,0,0,,Эй, бұл Гефирион ба?
Dialogue: 0,0:21:38.41,0:21:39.85,Default,,0,0,0,,Сенпай, мен саған айта алмаймын.
Dialogue: 0,0:21:39.85,0:21:41.41,Default,,0,0,0,,Бұл сізді Зефир етпейді.
Dialogue: 0,0:21:43.21,0:21:46.26,Default,,0,0,0,,Асуканың қанаттары Гефирионның қанаттары болды ма?
Dialogue: 0,0:21:46.26,0:21:48.19,Default,,0,0,0,,Сондықтан айта алмаймын.
Dialogue: 0,0:21:48.19,0:21:51.20,Default,,0,0,0,,Мен оны кішкентай кезімде аралдағы баладан алдым.
Dialogue: 0,0:21:51.29,0:21:52.65,Default,,0,0,0,,Арал баласы…
Dialogue: 0,0:21:52.65,0:21:54.08,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:21:54.67,0:21:57.49,Default,,0,0,0,,Бір қыздың жаттықтырушы болғаны сияқты.
Dialogue: 0,0:21:57.60,0:21:58.43,Default,,0,0,0,,Жалпы
Dialogue: 0,0:21:58.53,0:22:00.97,Default,,0,0,0,,Бұл менің бала кезімдегі оқиға.
Dialogue: 0,0:22:01.95,0:22:05.92,Default,,0,0,0,,Айтпақшы, мен баяғыда дала ойынында ойнаған балам да дәл осындай бала деп ойлаймын.
Dialogue: 0,0:22:06.10,0:22:08.44,Default,,0,0,0,,Сол бала емес пе?
Dialogue: 0,0:22:10.09,0:22:11.73,Default,,0,0,0,,Мен шынымен түсінбеймін
Dialogue: 0,0:22:12.27,0:22:13.58,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:23:46.33,0:23:48.56,Default,,0,0,0,,Біздің ФК әдемі
Dialogue: 0,0:23:48.56,0:23:50.26,Default,,0,0,0,,Ня, сағат 6 болды ма?
Dialogue: 0,0:23:50.26,0:23:51.21,Default,,0,0,0,,Жаттықтырушы?
Dialogue: 0,0:23:51.86,0:23:53.95,Default,,0,0,0,,Бұл FC үшін де ме?
Dialogue: 0,0:23:55.45,0:24:01.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory