Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.07,0:00:08.50,Default,,0,0,0,,Бұл таңқаларлық. Бұл шынымен де жарыс.
Dialogue: 0,0:00:08.50,0:00:11.21,Default,,0,0,0,,Егер бұл жалған турнир болса, біз қиындыққа тап боламыз.
Dialogue: 0,0:00:11.31,0:00:13.45,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,0:00:16.35,0:00:18.10,Default,,0,0,0,,Соңында орта мектептің соңғы турнирі
Dialogue: 0,0:00:18.10,0:00:21.92,Default,,0,0,0,,Қалай болғанда да, қатыса алатыныма қуаныштымын.
Dialogue: 0,0:00:22.15,0:00:24.29,Default,,0,0,0,,Менеджер, мен бар күшімді саламын.
Dialogue: 0,0:00:24.29,0:00:27.69,Default,,0,0,0,,О, жарайсың, Курашина, көңіл-күйіңді көтер.
Dialogue: 0,0:00:29.20,0:00:31.66,Default,,0,0,0,,Бұл шиеленіс деген не?
Dialogue: 0,0:00:31.79,0:00:36.87,Default,,0,0,0,,Нян Мен таңертең ештеңе істеудің қажеті жоқ, нян.
Dialogue: 0,0:00:36.87,0:00:40.31,Default,,0,0,0,,Мен Мисакидің матчының күннің екінші жартысында болғанын қалаймын.
Dialogue: 0,0:00:40.31,0:00:41.31,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:00:44.64,0:00:46.37,Default,,0,0,0,,Дүкендер де бар.
Dialogue: 0,0:00:46.03,0:00:47.44,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:00:47.51,0:00:50.78,Default,,0,0,0,,Мисаки-сенпай таза ақ удонды сатады.
Dialogue: 0,0:00:51.68,0:00:54.81,Default,,0,0,0,,Ия, түскі асқа удон ішейік.
Dialogue: 0,0:00:58.69,0:01:01.76,Default,,0,0,0,,Дұрыс, кешіріңіз, Тобико-сан.
Dialogue: 0,0:01:02.03,0:01:04.32,Default,,0,0,0,,Бірақ бұл дәмді болды.
Dialogue: 0,0:01:05.04,0:01:06.32,Default,,0,0,0,,таза ақ
Dialogue: 0,0:01:06.85,0:01:07.96,Default,,0,0,0,,Минори
Dialogue: 0,0:01:09.11,0:01:12.76,Default,,0,0,0,,Мен бүгін матчқа түсініктеме беремін, сондықтан оған қамқорлық жасаңыз.
Dialogue: 0,0:01:13.03,0:01:14.09,Default,,0,0,0,,Тікелей түсініктеме?
Dialogue: 0,0:01:14.24,0:01:17.66,Default,,0,0,0,,Негізі бұл турнир теледидардан көрсетіледі.
Dialogue: 0,0:01:17.67,0:01:18.52,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:01:18.64,0:01:22.08,Default,,0,0,0,,Теледидарға шықсам, бәрінің кумиріне айналамын.
Dialogue: 0,0:01:22.08,0:01:24.20,Default,,0,0,0,,Мен бұған шыдамаймын.
Dialogue: 0,0:01:24.26,0:01:26.73,Default,,0,0,0,,Сенпай менің жалғыз кумирім
Dialogue: 0,0:01:26.91,0:01:28.80,Default,,0,0,0,,Ағаның бетіне мозаика сал.
Dialogue: 0,0:01:28.80,0:01:30.17,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:01:30.32,0:01:32.43,Default,,0,0,0,,Ол қай жерде көрсетіледі?
Dialogue: 0,0:01:32.66,0:01:34.06,Default,,0,0,0,,Бұл төрт арал арнасы.
Dialogue: 0,0:01:34.99,0:01:37.88,Default,,0,0,0,,Не, жергілікті кабельдік теледидар?
Dialogue: 0,0:01:38.24,0:01:40.80,Default,,0,0,0,,Жүр, мен турнир кестесін тез тексерейін.
Dialogue: 0,0:03:20.63,0:03:22.72,Default,,0,0,0,,Сәлем бәріңе, сәттілік.
Dialogue: 0,0:03:22.99,0:03:24.14,Default,,0,0,0,,Сатоин мырза
Dialogue: 0,0:03:24.82,0:03:26.83,Default,,0,0,0,,Оқу-жаттығу жиынындағы көмектеріңіз үшін рахмет.
Dialogue: 0,0:03:27.84,0:03:29.47,Default,,0,0,0,,Көп уақыт өтті.
Dialogue: 0,0:03:32.03,0:03:34.67,Default,,0,0,0,,Сонымен, біз қашан дос болдық?
Dialogue: 0,0:03:34.82,0:03:37.02,Default,,0,0,0,,Бірінші жылдық одақ құрдық.
Dialogue: 0,0:03:37.41,0:03:39.64,Default,,0,0,0,,Қалайсың, Хината-кун?
Dialogue: 0,0:03:40.03,0:03:44.35,Default,,0,0,0,,Сіз қалай ойлайсыз? Көптеген ойыншыларымыз ресми ойынға алғаш рет қатысуда.
Dialogue: 0,0:03:44.56,0:03:47.28,Default,,0,0,0,,Мені жалайтын болсаң, қиналып қаласың.
Dialogue: 0,0:03:48.66,0:03:49.93,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:03:53.89,0:03:55.93,Default,,0,0,0,,Барлығың қараңдар!
Dialogue: 0,0:03:57.25,0:04:01.08,Default,,0,0,0,,Эй, менің Сатоин мырзамен жолым болмады.
Dialogue: 0,0:04:02.29,0:04:04.92,Default,,0,0,0,,Мен Саки Инуимін, Kairyo академиясының екінші курс студентімін.
Dialogue: 0,0:04:05.17,0:04:07.10,Default,,0,0,0,,Бұл мен ешқашан естімеген ойыншы.
Dialogue: 0,0:04:07.92,0:04:10.00,Default,,0,0,0,,Мен Ичиноза-чанмын ба?
Dialogue: 0,0:04:11.33,0:04:13.37,Default,,0,0,0,,Асука Йоцушима Суйсан үшін жыл ба?
Dialogue: 0,0:04:13.97,0:04:16.08,Default,,0,0,0,,Бұл Такафуджиден кейінгі күшті мектеп.
Dialogue: 0,0:04:16.11,0:04:18.48,Default,,0,0,0,,Бұл күшті. Мен оны асыға күтемін.
Dialogue: 0,0:04:18.55,0:04:20.54,Default,,0,0,0,,Бұрынғыдай қарапайым
Dialogue: 0,0:04:20.83,0:04:24.56,Default,,0,0,0,,Бұл Йоцушима Суйсанның жолбарыс балығы Арика.
Dialogue: 0,0:04:24.64,0:04:26.68,Default,,0,0,0,,Хаха, таза ақ.
Dialogue: 0,0:04:28.37,0:04:30.83,Default,,0,0,0,,Сіз мұны шынымен жасадыңыз FC
Dialogue: 0,0:04:31.12,0:04:32.25,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:04:32.42,0:04:34.47,Default,,0,0,0,,Сіз Маширо-чанды білесіз бе?
Dialogue: 0,0:04:34.47,0:04:36.12,Default,,0,0,0,,Біз бала кезден доспыз.
Dialogue: 0,0:04:36.15,0:04:37.86,Default,,0,0,0,,Туна-чан
Dialogue: 0,0:04:37.86,0:04:39.87,Default,,0,0,0,,Оны тунец деп атамаңыз
Dialogue: 0,0:04:39.87,0:04:44.51,Default,,0,0,0,,Маширочидің сыныптасы Йоцушима Суйсанның бірінші курс студенті.
Dialogue: 0,0:04:44.51,0:04:47.18,Default,,0,0,0,,Бұл сіздің тұрақты дәрежеге ие болғаныңызды білдіреді, солай емес пе?
Dialogue: 0,0:04:47.87,0:04:49.96,Default,,0,0,0,,Мен Маширо ФК бастады деп естідім.
Dialogue: 0,0:04:50.16,0:04:52.99,Default,,0,0,0,,Мен матчты ойнағым келді, сондықтан мен бар күшімді салдым.
Dialogue: 0,0:04:53.38,0:04:57.31,Default,,0,0,0,,Блоктар әртүрлі болғандықтан, матчты тек финалда ойнауға болады.
Dialogue: 0,0:04:57.70,0:05:00.81,Default,,0,0,0,,Міндетті түрде аман қал, өйткені мен де қаламын.
Dialogue: 0,0:05:01.73,0:05:03.83,Default,,0,0,0,,Қандай ұлы рух, Туна-чан.
Dialogue: 0,0:05:03.83,0:05:05.79,Default,,0,0,0,,Сондықтан тунец демеңіз. Айтпа.
Dialogue: 0,0:05:05.79,0:05:09.85,Default,,0,0,0,,Әй, сен бастықтарға тағы да құрмет көрсетуді ұмытып кетіпсің, Юрика.
Dialogue: 0,0:05:10.39,0:05:11.64,Default,,0,0,0,,Маю апа
Dialogue: 0,0:05:11.73,0:05:15.08,Default,,0,0,0,,Менің әпкем ретінде сенің сәтсіздігім менің сәтсіздігім.
Dialogue: 0,0:05:15.25,0:05:16.52,Default,,0,0,0,,Бұл өкінішті.
Dialogue: 0,0:05:16.77,0:05:21.17,Default,,0,0,0,,Кешіріңіз, әпке, жазаға шыдаңыз.
Dialogue: 0,0:05:21.17,0:05:22.19,Default,,0,0,0,,Ханым
Dialogue: 0,0:05:22.50,0:05:24.89,Default,,0,0,0,,Әпкесінің Икеззу
Dialogue: 0,0:05:24.95,0:05:25.76,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:05:28.79,0:05:34.59,Default,,0,0,0,,Уайымдама, мен сүйген адамыма олай жасамас едім.
Dialogue: 0,0:05:35.86,0:05:37.37,Default,,0,0,0,,Әпке
Dialogue: 0,0:05:42.91,0:05:44.21,Default,,0,0,0,,Йоцушима Суйсан үшін
Dialogue: 0,0:05:44.21,0:05:48.47,Default,,0,0,0,,Бағыт беру үшін үлкендер мен кішілермен келісім-шарт жасау дәстүрі бар.
Dialogue: 0,0:05:48.47,0:05:49.27,Default,,0,0,0,,Шарт
Dialogue: 0,0:05:49.27,0:05:50.48,Default,,0,0,0,,Мектептерді ауыстырайық
Dialogue: 0,0:05:50.48,0:05:51.48,Default,,0,0,0,,№
Dialogue: 0,0:05:51.57,0:05:54.54,Default,,0,0,0,,Жақында ашылу салтанаты болады.
Dialogue: 0,0:05:54.85,0:05:58.71,Default,,0,0,0,,Барлық спортшылар турнирдің штаб-пәтері шатырының алдына жиналуларыңызды сұраймыз.
Dialogue: 0,0:05:58.71,0:06:03.00,Default,,0,0,0,,Кешіріңіз. Кешіріңіз. Кейінірек кездесеміз.
Dialogue: 0,0:06:03.46,0:06:04.56,Default,,0,0,0,,Маширо
Dialogue: 0,0:06:07.91,0:06:11.39,Default,,0,0,0,,Ол кезде...мейірімді адам
Dialogue: 0,0:06:11.94,0:06:13.90,Default,,0,0,0,,Сіз FC ойынын ойнадыңыз.
Dialogue: 0,0:06:15.20,0:06:18.24,Default,,0,0,0,,А...м... өткен күн үшін рахмет...
Dialogue: 0,0:06:17.78,0:06:18.52,Default,,0,0,0,,Саки
Dialogue: 0,0:06:29.04,0:06:32.70,Default,,0,0,0,,Күткендеріңізге рахмет, төрт арал арнасын тамашалайтын баршаңызға.
Dialogue: 0,0:06:32.80,0:06:37.13,Default,,0,0,0,,Мен Кунахама Гакуиндік Минори Хосакамын, мен түсініктемеге жауаптымын.
Dialogue: 0,0:06:37.55,0:06:41.36,Default,,0,0,0,,Ұшатын цирк бойынша Жапония чемпионатының жазғы турнирі аяқталды
Dialogue: 0,0:06:41.55,0:06:44.16,Default,,0,0,0,,Батыс Кюсю аймақтық алдын ала жарыстары басталады
Dialogue: 0,0:06:47.91,0:06:50.96,Default,,0,0,0,,Ақырында ұшатын костюм киіп ойын ойнауға болады
Dialogue: 0,0:06:50.96,0:06:51.78,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:06:51.78,0:06:57.60,Default,,0,0,0,,Мен оны асыға күтемін. Мен оны асыға күтемін...
Dialogue: 0,0:06:52.96,0:06:55.12,Default,,0,0,0,,Асука-сенпай тым құрғақ
Dialogue: 0,0:06:55.31,0:06:57.53,Default,,0,0,0,,Кернеу тым жоғары.
Dialogue: 0,0:06:58.21,0:07:00.67,Default,,0,0,0,,Маширо-чан ол костюмде де жақсы көрінеді.
Dialogue: 0,0:07:02.16,0:07:04.98,Default,,0,0,0,,Мен бұған пластиналық сауыт қосқым келеді
Dialogue: 0,0:07:04.98,0:07:06.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:06.39,0:07:08.24,Default,,0,0,0,,Соңында басталады
Dialogue: 0,0:07:08.53,0:07:11.00,Default,,0,0,0,,Әркім қолынан келгеннің бәрін жасайды.
Dialogue: 0,0:07:11.30,0:07:15.42,Default,,0,0,0,,Мен екінші раундқа өтіп, Шиндо-санмен тағы бір рет жұдырықтасқым келеді.
Dialogue: 0,0:07:15.52,0:07:18.08,Default,,0,0,0,,Күтілгендей, мақсат ең жақсы сегіздік.
Dialogue: 0,0:07:18.50,0:07:21.15,Default,,0,0,0,,Аспан билеушісі боламын
Dialogue: 0,0:07:21.15,0:07:22.13,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:07:22.13,0:07:24.61,Default,,0,0,0,,Бұл әдеттегідей.
Dialogue: 0,0:07:24.61,0:07:27.63,Default,,0,0,0,,Жарайсың, Курашина, жұмысым бітті.
Dialogue: 0,0:07:37.43,0:07:41.13,Default,,0,0,0,,Енді А блогының бірінші турының бірінші ойынын ойнайық.
Dialogue: 0,0:07:42.63,0:07:44.77,Default,,0,0,0,,Маширо-чан, бар күшіңді сал
Dialogue: 0,0:07:44.77,0:07:45.95,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:07:47.63,0:07:50.00,Default,,0,0,0,,Бұл жай ғана сәтсіздік.
Dialogue: 0,0:07:50.00,0:07:51.08,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:07:51.60,0:07:56.11,Default,,0,0,0,,Өйткені мен Сатоин мырзаны жеңе алатынымды мүлде сезінбеймін.
Dialogue: 0,0:07:56.23,0:08:00.49,Default,,0,0,0,,Тіпті Машироның өзі оқу-жаттығу жиынынан кейін айтарлықтай өсті.
Dialogue: 0,0:08:00.77,0:08:01.76,Default,,0,0,0,,Өзіңізге сенімді болыңыз
Dialogue: 0,0:08:03.95,0:08:06.16,Default,,0,0,0,,Маширо қандай жекпе-жек стилін қолданғысы келеді?
Dialogue: 0,0:08:07.39,0:08:11.40,Default,,0,0,0,,Біріншіден, жеңу немесе жеңіліс емес, көңіліңізден шыққан ойын бірінші орында.
Dialogue: 0,0:08:12.43,0:08:13.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:14.50,0:08:18.41,Default,,0,0,0,,Мен жылдамдаушы ретінде әділ және шаршы алаңда күрескім келеді.
Dialogue: 0,0:08:18.61,0:08:19.48,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:20.18,0:08:24.92,Default,,0,0,0,,Бірақ ро-йо-йо жасау уақыты әдеттегіден кеш.
Dialogue: 0,0:08:25.03,0:08:26.14,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:27.60,0:08:29.64,Default,,0,0,0,,Сатоин мырза - жан-жақты тип.
Dialogue: 0,0:08:30.08,0:08:32.30,Default,,0,0,0,,Жекпе-жек стилі қарсыласына байланысты жиі өзгереді
Dialogue: 0,0:08:32.99,0:08:36.99,Default,,0,0,0,,Бірақ ол Машироның спикерге айналғанын әлі білмесе керек.
Dialogue: 0,0:08:37.44,0:08:38.17,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:08:38.63,0:08:41.07,Default,,0,0,0,,Егер сіз Сатоин мырзаны күрескер деп ойлай алсаңыз.
Dialogue: 0,0:08:41.47,0:08:43.05,Default,,0,0,0,,Таңбашаларды қолданбау керек
Dialogue: 0,0:08:43.31,0:08:45.32,Default,,0,0,0,,Осылайша жылдамдықта жарысуға болады.
Dialogue: 0,0:08:45.75,0:08:47.60,Default,,0,0,0,,Көремін, түсінемін.
Dialogue: 0,0:08:48.67,0:08:50.48,Default,,0,0,0,,Бірінші жолда аз басымдықпен ұтсаңыз
Dialogue: 0,0:08:50.63,0:08:53.15,Default,,0,0,0,,Екінші жолда жылдамдықпен мінген Машироның басымдығы бар
Dialogue: 0,0:08:53.52,0:08:55.24,Default,,0,0,0,,Олай болса, үшінші шұңқырды да алу керек.
Dialogue: 0,0:08:56.34,0:08:56.92,Default,,0,0,0,,Иә
Dialogue: 0,0:08:59.84,0:09:05.98,Default,,0,0,0,,Енді өзін-өзі жариялаған «Күлгін раушан» Рейко Сатоинге қарсы күшті Такато академиясының екінші жылының уақыты келді.
Dialogue: 0,0:09:06.77,0:09:08.48,Default,,0,0,0,,Кунахама академиясы 1 курс
Dialogue: 0,0:09:08.55,0:09:12.64,Default,,0,0,0,,Маширо Удонның постер қызы Арисака Маширо арасындағы матч басталады
Dialogue: 0,0:09:13.38,0:09:15.07,Default,,0,0,0,,Енді орналасқан жері туралы
Dialogue: 0,0:09:19.33,0:09:20.01,Default,,0,0,0,,Жиын
Dialogue: 0,0:09:24.56,0:09:27.08,Default,,0,0,0,,Енді екі спортшы да жарысты бастады.
Dialogue: 0,0:09:27.19,0:09:30.01,Default,,0,0,0,,Дегенмен, Арисақа сәл кешігіп қалған сияқты.
Dialogue: 0,0:09:30.03,0:09:33.15,Default,,0,0,0,,Жарайды, тынышталып, ро-йо-йо ойнай бастаңыз.
Dialogue: 0,0:09:33.97,0:09:34.48,Default,,0,0,0,,Иә
Dialogue: 0,0:09:37.01,0:09:39.74,Default,,0,0,0,,Сато-кун, арғы жағы Ро-Йо-Йоға келді.
Dialogue: 0,0:09:39.91,0:09:42.28,Default,,0,0,0,,Менеджер, мені Сатоин деп атаңыз.
Dialogue: 0,0:09:42.59,0:09:44.44,Default,,0,0,0,,Эй, Ро-йо-йо?
Dialogue: 0,0:09:46.34,0:09:47.76,Default,,0,0,0,,Ол күрескер ме?
Dialogue: 0,0:09:54.50,0:09:56.04,Default,,0,0,0,,Арисака нүктесі
Dialogue: 0,0:09:56.27,0:09:57.18,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:09:58.27,0:10:00.03,Default,,0,0,0,,Бұл күтпеген жағдай
Dialogue: 0,0:10:00.08,0:10:03.87,Default,,0,0,0,,Бірінші ұпайды бірінші курс студенті және бірінші рет ойнаған Арисака алады.
Dialogue: 0,0:10:03.99,0:10:05.25,Default,,0,0,0,,Керемет
Dialogue: 0,0:10:05.25,0:10:06.86,Default,,0,0,0,,Таза ақ түске өтіңіз
Dialogue: 0,0:10:07.22,0:10:08.76,Default,,0,0,0,,Бұл жылдамдық жылдамырақ
Dialogue: 0,0:10:08.99,0:10:10.81,Default,,0,0,0,,Бұл өте жылдам.
Dialogue: 0,0:10:10.93,0:10:13.21,Default,,0,0,0,,Сато-кун, жылдамдықпен жеңе алмайсың.
Dialogue: 0,0:10:13.46,0:10:14.97,Default,,0,0,0,,Үшінші жолға таңбаша
Dialogue: 0,0:10:15.03,0:10:17.74,Default,,0,0,0,,«Сатоин» директоры.
Dialogue: 0,0:10:21.70,0:10:23.08,Default,,0,0,0,,Арисака нүктесі
Dialogue: 0,0:10:23.49,0:10:26.40,Default,,0,0,0,,Арисака қатарынан екінші ұпай алды
Dialogue: 0,0:10:24.98,0:10:26.20,Default,,0,0,0,,Ах… Тога…
Dialogue: 0,0:10:28.80,0:10:30.22,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:10:30.63,0:10:31.93,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:10:32.34,0:10:35.95,Default,,0,0,0,,А, дұрыс, мен Рикамен жасаған жаттығуым.
Dialogue: 0,0:10:51.57,0:10:53.40,Default,,0,0,0,,Жақсы, жақсы шешім.
Dialogue: 0,0:10:53.47,0:10:57.66,Default,,0,0,0,,Оқу-жаттығу жиындарынан айырмашылығы, негіздері игерілді.
Dialogue: 0,0:11:00.37,0:11:04.01,Default,,0,0,0,,Мен негізіне адал жылдамдықпен жүруге үйрендім.
Dialogue: 0,0:11:10.91,0:11:14.19,Default,,0,0,0,,Маширочи өзінің кішкентай денесін пайдаланып, барын салуда.
Dialogue: 0,0:11:18.11,0:11:19.48,Default,,0,0,0,,Сатоин нүктесі
Dialogue: 0,0:11:20.11,0:11:22.62,Default,,0,0,0,,Енді осы жерден қарсы шабуылға шығайық.
Dialogue: 0,0:11:26.15,0:11:27.53,Default,,0,0,0,,Сатоин нүктесі
Dialogue: 0,0:11:30.66,0:11:33.16,Default,,0,0,0,,Қалғанын саған қалдырамын, Сато-кун.
Dialogue: 0,0:11:33.49,0:11:35.60,Default,,0,0,0,,Демек, бұл Сатоин.
Dialogue: 0,0:11:37.65,0:11:41.13,Default,,0,0,0,,Ойын жиынтығының жеңімпазы Сатоин
Dialogue: 0,0:11:42.82,0:11:43.89,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:11:43.89,0:11:45.36,Default,,0,0,0,,Сен бүкіл отбасыңмен бірге осыған көшіп алғаның дұрыс.
Dialogue: 0,0:11:47.19,0:11:48.80,Default,,0,0,0,,Мен жеңіліп қалдым.
Dialogue: 0,0:11:49.17,0:11:52.83,Default,,0,0,0,,Бірақ Маширо-чан Тобио-сан сияқты жарқырап тұрды.
Dialogue: 0,0:11:56.35,0:11:58.03,Default,,0,0,0,,Сіз Маширо ең жақсысын жасадыңыз
Dialogue: 0,0:11:58.42,0:11:59.07,Default,,0,0,0,,О
Dialogue: 0,0:12:06.15,0:12:07.53,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:18.15,0:12:20.44,Default,,0,0,0,,B блогы 1-тур 2-ші матч
Dialogue: 0,0:12:20.67,0:12:22.88,Default,,0,0,0,,Кунахама академиясы Мисаки Тобисаваға қарсы
Dialogue: 0,0:12:23.01,0:12:25.60,Default,,0,0,0,,Такато Гакуэн Рика Ичинозаның кездесуі
Dialogue: 0,0:12:26.02,0:12:28.43,Default,,0,0,0,,Ичиноза бірінші ұпайды жинағаннан кейін
Dialogue: 0,0:12:28.43,0:12:30.68,Default,,0,0,0,,Біржақты болып кетті.
Dialogue: 0,0:12:32.91,0:12:34.25,Default,,0,0,0,,Тобисава нүктесі
Dialogue: 0,0:12:34.88,0:12:36.99,Default,,0,0,0,,Мисаки-чан керемет
Dialogue: 0,0:12:36.99,0:12:39.15,Default,,0,0,0,,Ол нақты спектакльдерде өте жақсы тип.
Dialogue: 0,0:12:39.63,0:12:42.73,Default,,0,0,0,,Тышқанды көздеген мысықтай, бақаны көздеген жыландай
Dialogue: 0,0:12:42.80,0:12:44.27,Default,,0,0,0,,Мадока маған ұрысады
Dialogue: 0,0:12:44.42,0:12:47.13,Default,,0,0,0,,Мен ағама онша ұрыспаймын.
Dialogue: 0,0:12:49.30,0:12:50.17,Default,,0,0,0,,Рика…
Dialogue: 0,0:12:51.01,0:12:52.88,Default,,0,0,0,,Біз оның одан әрі құлдырауына жол бере алмаймыз.
Dialogue: 0,0:12:52.98,0:12:54.03,Default,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:12:59.09,0:12:59.82,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:13:00.05,0:13:01.26,Default,,0,0,0,,Рика, жүр
Dialogue: 0,0:13:01.51,0:13:03.10,Default,,0,0,0,,Сіз кімді жақтайсыз?
Dialogue: 0,0:13:03.15,0:13:04.06,Default,,0,0,0,,Екеуі де.
Dialogue: 0,0:13:10.26,0:13:11.76,Default,,0,0,0,,Тобисава нүктесі
Dialogue: 0,0:13:11.86,0:13:16.27,Default,,0,0,0,,Ичиноза Мен ит төбелесінен қалай да құтылғым келеді.
Dialogue: 0,0:13:16.40,0:13:19.15,Default,,0,0,0,,Тобисава қозғалысын толығымен тоқтатады.
Dialogue: 0,0:13:19.91,0:13:21.95,Default,,0,0,0,,Мен жеңілмеймін...
Dialogue: 0,0:13:29.31,0:13:30.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:30.55,0:13:32.20,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:32.63,0:13:37.44,Default,,0,0,0,,Мен Мисакиге әдейі қол тигізуге рұқсат етемін және қашу үшін кері шегіну мен импульсті пайдаланамын.
Dialogue: 0,0:13:37.57,0:13:38.68,Default,,0,0,0,,Моги мырзадан Цукидің қозғалысын бақылап отыруды сұраңызшы.
Dialogue: 0,0:13:39.15,0:13:40.68,Default,,0,0,0,,Ичинозаны айналып өтіңіз
Dialogue: 0,0:13:41.19,0:13:43.69,Default,,0,0,0,,Маған тиіспе, азғырылма
Dialogue: 0,0:13:43.92,0:13:44.70,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:50.55,0:13:53.02,Default,,0,0,0,,Ондайда кім бірінші қозғалса, сол кемшілікте болады.
Dialogue: 0,0:13:53.19,0:13:55.72,Default,,0,0,0,,Стратегия оны матчтың соңына дейін жеткізу.
Dialogue: 0,0:13:57.38,0:14:01.20,Default,,0,0,0,,Мұндай тактика да бар. Мен көп нәрсені үйрендім.
Dialogue: 0,0:14:03.59,0:14:06.54,Default,,0,0,0,,Ойын жиынтығының жеңімпазы Тобисава
Dialogue: 0,0:14:07.39,0:14:11.79,Default,,0,0,0,,Тобисава күшті Такафуджидің бір бұрышын жеңді
Dialogue: 0,0:14:12.51,0:14:14.75,Default,,0,0,0,,Жақсы жұмыс Мисаки, жарайсың
Dialogue: 0,0:14:14.87,0:14:18.04,Default,,0,0,0,,Бұл керемет, Мисаки-чан, өте керемет.
Dialogue: 0,0:14:18.34,0:14:20.19,Default,,0,0,0,,Менің ойымша, бұл осындай нәрсе.
Dialogue: 0,0:14:20.58,0:14:21.64,Default,,0,0,0,,Тобисава мырза
Dialogue: 0,0:14:22.87,0:14:24.35,Default,,0,0,0,,Сен бүкіл отбасыңмен бірге осыған көшіп алғаның дұрыс.
Dialogue: 0,0:14:25.23,0:14:28.04,Default,,0,0,0,,Бұл толық жеңіліс болды. Рақмет сізге.
Dialogue: 0,0:14:28.50,0:14:30.25,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:36.19,0:14:37.82,Default,,0,0,0,,Олай болса, тағы да ойнайық.
Dialogue: 0,0:14:38.72,0:14:40.17,Default,,0,0,0,,Келесі жолы мен жеңемін
Dialogue: 0,0:14:44.34,0:14:47.88,Default,,0,0,0,,Мен ашылуды мақсат етуге тым көп шоғырланудан шаршадым.
Dialogue: 0,0:14:48.39,0:14:50.04,Default,,0,0,0,,Сіз оңай жеңе алмайсыз.
Dialogue: 0,0:14:50.48,0:14:51.96,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:14:52.16,0:14:53.96,Default,,0,0,0,,Тобисава өзіне сенімді адам.
Dialogue: 0,0:14:54.23,0:14:58.11,Default,,0,0,0,,18 жасында Францияның ашық чемпионатында жеңіске жеткен теннисші айтты.
Dialogue: 0,0:14:58.40,0:15:03.02,Default,,0,0,0,,«Бұл әрқашан нәтиже бермейді, сондықтан сізге сенімділік қажет».
Dialogue: 0,0:15:03.28,0:15:06.79,Default,,0,0,0,,Жарайды, онда мен сенімдірек барамын.
Dialogue: 0,0:15:06.79,0:15:08.04,Default,,0,0,0,,Айналмаңыз
Dialogue: 0,0:15:08.69,0:15:09.52,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:15:09.67,0:15:13.42,Default,,0,0,0,,Жақында бірінші айналымның 10-шы ойыны басталады.
Dialogue: 0,0:15:13.94,0:15:17.00,Default,,0,0,0,,Әр блоктағы ойыншылар дайындалыңыз.
Dialogue: 0,0:15:17.54,0:15:19.24,Default,,0,0,0,,Бұл Kairyo академиясының қызметкері Саки Инуи.
Dialogue: 0,0:15:19.97,0:15:21.71,Default,,0,0,0,,Өйткені бұрынғы деректер мүлдем жоқ
Dialogue: 0,0:15:22.00,0:15:23.68,Default,,0,0,0,,Қалай шығатынын оқи алмаймын.
Dialogue: 0,0:15:23.87,0:15:24.84,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:15:25.17,0:15:27.84,Default,,0,0,0,,Егер сіз оны жылдамдатсаңыз, жылдамдасаңыз және оны бұзсаңыз жақсы.
Dialogue: 0,0:15:27.95,0:15:29.29,Default,,0,0,0,,Жылдамдық ең жақсы
Dialogue: 0,0:15:29.59,0:15:32.49,Default,,0,0,0,,Мен оттаймын Мен оттаймын
Dialogue: 0,0:15:35.57,0:15:37.79,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:15:38.58,0:15:43.90,Default,,0,0,0,,Мм... Менің атым Ирина, мен Саки Инуидің екіншісімін.
Dialogue: 0,0:15:44.51,0:15:47.28,Default,,0,0,0,,А, бұл Хината. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:15:47.55,0:15:50.43,Default,,0,0,0,,Бұл оның Жапонияда бірінші рет жарысқа қатысуы.
Dialogue: 0,0:15:50.71,0:15:51.98,Default,,0,0,0,,Жұмсақ болыңыз
Dialogue: 0,0:15:52.32,0:15:56.00,Default,,0,0,0,,Бұл сіздің шетелде ойнағаныңызды білдіре ме?
Dialogue: 0,0:15:56.37,0:15:57.92,Default,,0,0,0,,Ұлыбританияда иә
Dialogue: 0,0:15:58.59,0:16:00.83,Default,,0,0,0,,Барымызды бірге жасайық.
Dialogue: 0,0:16:04.16,0:16:08.76,Default,,0,0,0,,Англия... ұшатын цирктің туған жері?
Dialogue: 0,0:16:10.11,0:16:12.41,Default,,0,0,0,,Мен бұл стақанды ешқашан көрген емеспін.
Dialogue: 0,0:16:13.39,0:16:15.88,Default,,0,0,0,,Директор: Менің қарсыласым, Инуи.
Dialogue: 0,0:16:16.39,0:16:18.88,Default,,0,0,0,,Бойы аласа, дене сызығы жіңішке.
Dialogue: 0,0:16:19.28,0:16:21.15,Default,,0,0,0,,Ол қашатын күрескердің түрі болуы мүмкін.
Dialogue: 0,0:16:21.94,0:16:23.77,Default,,0,0,0,,Ит төбелесіне жол бермеңіз
Dialogue: 0,0:16:24.00,0:16:25.85,Default,,0,0,0,,Бірінші жолда жылдамдықты арттырыңыз
Dialogue: 0,0:16:25.92,0:16:26.74,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:16:26.74,0:16:27.74,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:16:28.10,0:16:28.73,Default,,0,0,0,,Жиын
Dialogue: 0,0:16:33.44,0:16:35.34,Default,,0,0,0,,Директор: Қарсы жақ та жылдамдықты асырған.
Dialogue: 0,0:16:37.35,0:16:38.03,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:16:38.03,0:16:40.28,Default,,0,0,0,,Әй, жылдамдықты көрсету.
Dialogue: 0,0:16:41.65,0:16:43.13,Default,,0,0,0,,Құрғақ нүкте
Dialogue: 0,0:16:46.88,0:16:48.16,Default,,0,0,0,,Құрғақ нүкте
Dialogue: 0,0:16:53.09,0:16:54.54,Default,,0,0,0,,Құрғақ нүкте
Dialogue: 0,0:16:54.95,0:16:58.08,Default,,0,0,0,,Енді айырмашылық 3 ұпай. Біз оны қайтара аламыз ба?
Dialogue: 0,0:16:59.71,0:17:03.08,Default,,0,0,0,,Хината: Мен қазір ең қызық болып тұрмын.
Dialogue: 0,0:17:03.51,0:17:05.77,Default,,0,0,0,,Менің алдымда менен жылдамырақ адам тұр.
Dialogue: 0,0:17:06.26,0:17:08.28,Default,,0,0,0,,Онда мен мұны істеймін...
Dialogue: 0,0:17:09.78,0:17:11.48,Default,,0,0,0,,Тек рухпен озып кету
Dialogue: 0,0:17:11.95,0:17:14.14,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:21.07,0:17:23.93,Default,,0,0,0,,Ойын жинағының жеңімпазы Инуи ойыншысы
Dialogue: 0,0:17:24.74,0:17:27.27,Default,,0,0,0,,Бауырым, бұл тез болды.
Dialogue: 0,0:17:27.27,0:17:29.49,Default,,0,0,0,,Менеджер маған қатты әсер етті.
Dialogue: 0,0:17:29.49,0:17:32.91,Default,,0,0,0,,Өзіңізге адал болу керемет.
Dialogue: 0,0:17:40.48,0:17:41.88,Default,,0,0,0,,Бұл керемет жылдамдық
Dialogue: 0,0:17:42.11,0:17:44.19,Default,,0,0,0,,Жоқ, бұл үлкен мәселе емес.
Dialogue: 0,0:17:44.47,0:17:46.59,Default,,0,0,0,,Жоқ, егер сіз менен сұрасаңыз...
Dialogue: 0,0:17:47.14,0:17:50.12,Default,,0,0,0,,Аа, дұрыс, мен көптен бері ойланып жүрмін.
Dialogue: 0,0:17:50.47,0:17:51.58,Default,,0,0,0,,Сол стақан...
Dialogue: 0,0:17:53.01,0:17:57.55,Default,,0,0,0,,Бұл әкем бастаған Avalon өндірушісі.
Dialogue: 0,0:17:58.45,0:17:59.39,Default,,0,0,0,,Авалон…
Dialogue: 0,0:18:00.43,0:18:01.34,Default,,0,0,0,,Олай болса
Dialogue: 0,0:18:07.47,0:18:11.45,Default,,0,0,0,,Ко Ко Ко Ко Коуч. Бұл біздің бірінші матчымыз.
Dialogue: 0,0:18:11.75,0:18:13.53,Default,,0,0,0,,Иә, тынышталайық.
Dialogue: 0,0:18:13.60,0:18:16.91,Default,,0,0,0,,Жарайды, менің жүрегім толығымен Тобико-сан.
Dialogue: 0,0:18:17.25,0:18:20.28,Default,,0,0,0,,Е, иә, басқа ойыншы - жылдамдық.
Dialogue: 0,0:18:20.67,0:18:23.52,Default,,0,0,0,,Алдымен теория бойынша қозғалып, оның қалай өтетінін көрейік.
Dialogue: 0,0:18:23.76,0:18:26.36,Default,,0,0,0,,Иә, мен оны қадағалаймын.
Dialogue: 0,0:18:31.94,0:18:33.58,Default,,0,0,0,,Өйткені мен ешқашан жеңілмеймін
Dialogue: 0,0:18:33.84,0:18:37.10,Default,,0,0,0,,Иә, бірге көңіл көтерейік...
Dialogue: 0,0:18:37.99,0:18:40.19,Default,,0,0,0,,Енді В блогының бірінші кезеңі.
Dialogue: 0,0:18:40.40,0:18:43.85,Default,,0,0,0,,Кунахама Гакуин ұшатын балықты жақсы көретін Асука Курашинамен бірге
Dialogue: 0,0:18:44.10,0:18:48.60,Default,,0,0,0,,Бұл Йоцушима Суйсанның жоғары дәрежелі тунец ойыншысы Юрика Торао арасындағы матч.
Dialogue: 0,0:18:48.90,0:18:50.09,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:18:50.64,0:18:51.21,Default,,0,0,0,,Жиын
Dialogue: 0,0:18:54.79,0:18:56.65,Default,,0,0,0,,Юрика Ройоё
Dialogue: 0,0:18:56.82,0:18:57.32,Default,,0,0,0,,Иә
Dialogue: 0,0:18:58.48,0:19:02.35,Default,,0,0,0,,Ой, жолбарыс ойыншысы төмен йо-йомен жылдамдады.
Dialogue: 0,0:19:02.35,0:19:04.78,Default,,0,0,0,,Асука Бұл екінші жолға төте жол.
Dialogue: 0,0:19:04.90,0:19:05.88,Default,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:19:11.47,0:19:12.78,Default,,0,0,0,,Жолбарыс балығы
Dialogue: 0,0:19:12.98,0:19:13.63,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:19:15.65,0:19:17.31,Default,,0,0,0,,Екінші қатарда күту
Dialogue: 0,0:19:17.83,0:19:18.78,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:19:23.19,0:19:25.77,Default,,0,0,0,,Бұл үлкен қайшы қандай?
Dialogue: 0,0:19:26.32,0:19:29.29,Default,,0,0,0,,Қозғалыс үлкен болғандықтан, болашақты болжау оңай болуы керек.
Dialogue: 0,0:19:35.12,0:19:36.52,Default,,0,0,0,,Тағы бір төте жол
Dialogue: 0,0:19:36.91,0:19:38.01,Default,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:19:40.56,0:19:41.72,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,0:19:42.42,0:19:45.31,Default,,0,0,0,,Бірақ оның қалай жұлынғанына таң қалдым.
Dialogue: 0,0:19:45.63,0:19:47.68,Default,,0,0,0,,Бұл нағыз матчтың нағыз қызығы.
Dialogue: 0,0:19:48.23,0:19:49.18,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:19:50.51,0:19:53.64,Default,,0,0,0,,Мен болашақты болжай алмайтын қызық.
Dialogue: 0,0:19:55.17,0:19:56.20,Default,,0,0,0,,Келесі жолы тоқтаңыз
Dialogue: 0,0:19:58.77,0:20:00.20,Default,,0,0,0,,Жолбарыс балығы
Dialogue: 0,0:20:00.75,0:20:03.58,Default,,0,0,0,,Мені көбірек шайқаңыз, Юрика.
Dialogue: 0,0:20:03.89,0:20:05.36,Default,,0,0,0,,Иә, әпке.
Dialogue: 0,0:20:07.87,0:20:10.44,Default,,0,0,0,,Үлкен көш келді.
Dialogue: 0,0:20:12.72,0:20:14.16,Default,,0,0,0,,О, мен мұны істеймін.
Dialogue: 0,0:20:14.16,0:20:16.16,Default,,0,0,0,,Юрикамен тамаша қозғалады.
Dialogue: 0,0:20:16.58,0:20:18.06,Default,,0,0,0,,Оң…Сол…
Dialogue: 0,0:20:18.34,0:20:21.21,Default,,0,0,0,,Неге менің артымнан келе жатырсың?
Dialogue: 0,0:20:21.49,0:20:23.86,Default,,0,0,0,,Оң…Сол…Оң…
Dialogue: 0,0:20:23.86,0:20:25.15,Default,,0,0,0,,Жоғарыда емес пе?
Dialogue: 0,0:20:27.17,0:20:28.75,Default,,0,0,0,,Илеу
Dialogue: 0,0:20:49.44,0:20:50.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:50.51,0:20:52.03,Default,,0,0,0,,Үйкеліс кезінде...
Dialogue: 0,0:20:52.59,0:20:54.48,Default,,0,0,0,,Әуе соққысы дегеніміз не?
Dialogue: 0,0:20:55.41,0:20:58.84,Default,,0,0,0,,Қандай еркін FC.
Dialogue: 0,0:21:01.78,0:21:05.07,Default,,0,0,0,,Асука, ит төбелесіңді осылай жалғастыра бер.
Dialogue: 0,0:21:05.97,0:21:06.52,Default,,0,0,0,,Иә
Dialogue: 0,0:21:10.16,0:21:11.42,Default,,0,0,0,,Бұл дәл сен күткендей.
Dialogue: 0,0:21:11.54,0:21:13.40,Default,,0,0,0,,Жеңімпаз Курашина
Dialogue: 0,0:21:14.59,0:21:15.97,Default,,0,0,0,,Жарайсың Асука
Dialogue: 0,0:21:15.97,0:21:17.72,Default,,0,0,0,,Асука-сенпай керемет
Dialogue: 0,0:21:17.89,0:21:19.47,Default,,0,0,0,,Ұшатын балық пайда болды.
Dialogue: 0,0:21:23.51,0:21:24.51,Default,,0,0,0,,(Үш мүйізді) Құрлықтағыдай еркін қозғала алмайсың. Көресің әлі!
Dialogue: 0,0:21:24.96,0:21:27.06,Default,,0,0,0,,Эй, сен неге кенет ұйықтап қалдың?
Dialogue: 0,0:21:27.06,0:21:29.28,Default,,0,0,0,,Ой, бұл қауіпті, дұрыстап ұста
Dialogue: 0,0:21:29.68,0:21:31.91,Default,,0,0,0,,Асука-сенпай таң қаларлықтай ауыр
Dialogue: 0,0:21:31.91,0:21:34.92,Default,,0,0,0,,А, мен сені бәрібір демалыс орнына апарамын.
Dialogue: 0,0:21:38.69,0:21:42.43,Default,,0,0,0,,Кешіріңіз, мен бүгінгі күнді тым көп күтемін.
Dialogue: 0,0:21:42.77,0:21:47.50,Default,,0,0,0,,Содан мен одан сайын қобалжыдым, мүлдем ұйықтай алмадым.
Dialogue: 0,0:21:47.75,0:21:51.42,Default,,0,0,0,,Сонымен, шиеленіс әдеттегіден жоғары болды.
Dialogue: 0,0:21:51.54,0:21:53.26,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:21:53.84,0:21:55.16,Default,,0,0,0,,Иә
Dialogue: 0,0:21:57.17,0:21:59.42,Default,,0,0,0,,Алғашқы жеңісіңізбен құттықтаймыз
Dialogue: 0,0:22:02.02,0:22:03.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:04.99,0:22:06.73,Default,,0,0,0,,Бүгін жақсы ұйықтаңыз.
Dialogue: 0,0:22:06.82,0:22:09.16,Default,,0,0,0,,Ертең екінші тур.
Dialogue: 0,0:22:09.75,0:22:11.21,Default,,0,0,0,,Ол ұйықтап қалды.
Dialogue: 0,0:23:46.88,0:23:49.12,Default,,0,0,0,,Барымызды салайық, Шиндо-сан.
Dialogue: 0,0:23:49.12,0:23:50.47,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:23:50.47,0:23:52.24,Default,,0,0,0,,Рахмет сізге Асука
Dialogue: 0,0:23:52.24,0:23:54.16,Default,,0,0,0,,Сіздің мүмкіндігіңіз осы ма?
Dialogue: 0,0:23:55.66,0:24:01.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory