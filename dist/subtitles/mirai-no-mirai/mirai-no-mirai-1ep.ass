Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.47,0:00:19.47,Default,,0,0,0,,♪~
Dialogue: 0,0:02:02.41,0:02:09.42,Default,,0,0,0,,~♪
Dialogue: 0,0:02:13.05,0:02:17.01,Default,,0,0,0,,(Кун Чанның тыныс шығару дыбысы)
Dialogue: 0,0:02:27.39,0:02:31.15,Default,,0,0,0,,А... Әлі жоқ деп ойлаймын.
Dialogue: 0,0:02:32.94,0:02:36.19,Default,,0,0,0,,Иә, жақсы. Мен күтемін.
Dialogue: 0,0:02:37.32,0:02:39.28,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:02:40.66,0:02:43.08,Default,,0,0,0,,Иә, абай болыңыз.
Dialogue: 0,0:02:46.20,0:02:49.58,Default,,0,0,0,,Кун-чан, сенің анаң жақында келеді.
Dialogue: 0,0:02:49.67,0:02:50.67,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:02:50.75,0:02:52.79,Default,,0,0,0,,Сіз оны шынымен күтесіз бе?
Dialogue: 0,0:02:52.88,0:02:55.13,Default,,0,0,0,,Ләззат алыңыз! Бір!
Dialogue: 0,0:02:55.30,0:02:56.30,Default,,0,0,0,,Бір!
Dialogue: 0,0:02:56.38,0:02:57.84,Default,,0,0,0,,Күшік сияқты
Dialogue: 0,0:02:58.13,0:03:01.68,Default,,0,0,0,,Кун-чан, сәбилер таза бөлмені жақсы көреді.
Dialogue: 0,0:03:01.76,0:03:03.39,Default,,0,0,0,,Сонымен, сіз тазалағыңыз келе ме?
Dialogue: 0,0:03:03.47,0:03:04.47,Default,,0,0,0,,Иә
Dialogue: 0,0:03:04.56,0:03:06.56,Default,,0,0,0,,Мен мұны өзім жасай аламын ба? Иә
Dialogue: 0,0:03:06.64,0:03:07.81,Default,,0,0,0,,Олай болса өтінемін
Dialogue: 0,0:03:07.89,0:03:09.18,Default,,0,0,0,,Иә
Dialogue: 0,0:03:11.90,0:03:13.61,Default,,0,0,0,,Әже, ол жоғарыда.
Dialogue: 0,0:03:13.69,0:03:14.77,Default,,0,0,0,,Иә
Dialogue: 0,0:03:19.70,0:03:22.62,Default,,0,0,0,,Бірақ сен біртүрлі үй салдың.
Dialogue: 0,0:03:22.70,0:03:24.58,Default,,0,0,0,,Егер сіз сәулетшіге үйленсеңіз —
Dialogue: 0,0:03:24.66,0:03:27.33,Default,,0,0,0,,Бұл мен лайықты үйде тұра алмаймын дегенді білдіре ме?
Dialogue: 0,0:03:27.75,0:03:29.83,Default,,0,0,0,,Сәлем, Юкко Бір!
Dialogue: 0,0:03:29.91,0:03:34.38,Default,,0,0,0,,(ойыншық пойыздың қозғалу дыбысы)
Dialogue: 0,0:03:38.71,0:03:39.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:40.93,0:03:44.47,Default,,0,0,0,,Кун-чан... бұрынғыдан да бытыраңқы.
Dialogue: 0,0:03:44.60,0:03:49.27,Default,,0,0,0,,Baby Сізге қайсысы ұнайды, E233 сериясы немесе Азуса?
Dialogue: 0,0:03:49.35,0:03:51.89,Default,,0,0,0,,Енді қайсысы?
Dialogue: 0,0:03:52.65,0:03:55.56,Default,,0,0,0,,А, Юкко, ол бақшада ойнағысы келген сияқты.
Dialogue: 0,0:03:55.65,0:03:56.69,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:03:56.77,0:03:57.94,Default,,0,0,0,,Кетіңіз.
Dialogue: 0,0:03:58.03,0:03:59.78,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:04:04.20,0:04:06.78,Default,,0,0,0,,Оны әже жинайды.
Dialogue: 0,0:04:13.33,0:04:14.88,Default,,0,0,0,,Асығыңыз, асығыңыз
Dialogue: 0,0:04:17.96,0:04:19.59,Default,,0,0,0,,Кеттік, иә!
Dialogue: 0,0:04:23.05,0:04:24.09,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:04:24.39,0:04:26.47,Default,,0,0,0,,Кеттік, иә!
Dialogue: 0,0:04:33.44,0:04:34.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:39.27,0:04:41.11,Default,,0,0,0,,Ах
Dialogue: 0,0:04:42.07,0:04:43.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:49.79,0:04:51.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:57.13,0:04:58.25,Default,,0,0,0,,Ах
Dialogue: 0,0:04:59.75,0:05:02.63,Default,,0,0,0,,Уау
Dialogue: 0,0:05:16.23,0:05:18.02,Default,,0,0,0,,Ғажайып...
Dialogue: 0,0:05:19.19,0:05:20.82,Default,,0,0,0,,Рақмет. Кешіріңіз.
Dialogue: 0,0:05:20.94,0:05:21.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:27.49,0:05:28.87,Default,,0,0,0,,Кун-чан
Dialogue: 0,0:05:35.12,0:05:36.54,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:05:39.04,0:05:40.17,Default,,0,0,0,,Анашым!
Dialogue: 0,0:05:40.88,0:05:42.59,Default,,0,0,0,,Анашым!
Dialogue: 0,0:05:44.05,0:05:46.84,Default,,0,0,0,,Ал, Охиме-сама, келдік.
Dialogue: 0,0:05:46.93,0:05:48.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:54.14,0:05:56.19,Default,,0,0,0,,Мен үйдемін, Кун Чан
Dialogue: 0,0:05:56.27,0:05:57.94,Default,,0,0,0,,Мама, қош келдіңіз
Dialogue: 0,0:05:59.23,0:06:00.81,Default,,0,0,0,,Жалғыздық болса керек!
Dialogue: 0,0:06:01.15,0:06:04.44,Default,,0,0,0,,Суықта емделген бе? Кешіріңіз, мен үйде болмадым
Dialogue: 0,0:06:06.03,0:06:07.65,Default,,0,0,0,,Бұл нәресте ме?
Dialogue: 0,0:06:08.41,0:06:09.45,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:09.66,0:06:12.03,Default,,0,0,0,,Маған көрсет! маған көрсет!
Dialogue: 0,0:06:29.43,0:06:31.60,Default,,0,0,0,,Ол Кун Чанның сіңлісі.
Dialogue: 0,0:06:32.85,0:06:34.22,Default,,0,0,0,,Қарындасы...
Dialogue: 0,0:06:35.64,0:06:37.68,Default,,0,0,0,,Сүйкімді?
Dialogue: 0,0:06:43.40,0:06:44.65,Default,,0,0,0,,Ғажайып...
Dialogue: 0,0:06:48.90,0:06:50.49,Default,,0,0,0,,Ақырын
Dialogue: 0,0:06:56.70,0:06:57.70,Default,,0,0,0,,Ах
Dialogue: 0,0:06:59.58,0:07:03.96,Default,,0,0,0,,Мен оянып, оған қарадым.
Dialogue: 0,0:07:04.29,0:07:06.13,Default,,0,0,0,,Мен оны әлі көре алмаймын
Dialogue: 0,0:07:06.59,0:07:08.59,Default,,0,0,0,,Бірақ мен саған қарап тұрмын
Dialogue: 0,0:07:10.84,0:07:13.05,Default,,0,0,0,,Енді жақсы араласайық.
Dialogue: 0,0:07:14.18,0:07:15.22,Default,,0,0,0,,Иә
Dialogue: 0,0:07:15.31,0:07:18.18,Default,,0,0,0,,Егер бірдеңе болса, мені қорғаңыз.
Dialogue: 0,0:07:19.10,0:07:20.14,Default,,0,0,0,,Иә
Dialogue: 0,0:07:23.69,0:07:25.23,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:07:25.44,0:07:27.23,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:27.44,0:07:31.28,Default,,0,0,0,,Аа, Кун-чан, балаға қандай есім қояр едің?
Dialogue: 0,0:07:31.36,0:07:33.20,Default,,0,0,0,,Аты? Иә
Dialogue: 0,0:07:33.53,0:07:36.83,Default,,0,0,0,,Ал, хмм.
Dialogue: 0,0:07:37.24,0:07:38.25,Default,,0,0,0,,Нозоми
Dialogue: 0,0:07:38.33,0:07:40.50,Default,,0,0,0,,Нозоми Нозомика
Dialogue: 0,0:07:40.62,0:07:42.58,Default,,0,0,0,,Түсіндім, жаман емес.
Dialogue: 0,0:07:42.96,0:07:44.96,Default,,0,0,0,,Өтеулі қарлығаш
Dialogue: 0,0:07:45.04,0:07:48.67,Default,,0,0,0,,Қарлығаш Қарлығаш...
Dialogue: 0,0:07:49.42,0:07:50.55,Default,,0,0,0,,Қарлығаш?
Dialogue: 0,0:07:50.63,0:07:52.63,Default,,0,0,0,,Бұл Шинкансеннің аты, солай ма?
Dialogue: 0,0:07:52.72,0:07:56.47,Default,,0,0,0,,Не? Ахахха
Dialogue: 0,0:07:57.06,0:07:59.73,Default,,0,0,0,,Мен сенің жаныңда тағы біраз қалсам деп едім.
Dialogue: 0,0:07:59.81,0:08:02.56,Default,,0,0,0,,Мен үлкен әжемді ауруханаға баруым керек.
Dialogue: 0,0:08:02.64,0:08:05.19,Default,,0,0,0,,Жарайды, құтқарылдым, шынымен.
Dialogue: 0,0:08:05.31,0:08:07.11,Default,,0,0,0,,Бірақ сіз маған кез келген уақытта қайта қоңырау шала аласыз.
Dialogue: 0,0:08:07.19,0:08:08.57,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:08.69,0:08:10.11,Default,,0,0,0,,Әкеме сәлем айт
Dialogue: 0,0:08:10.19,0:08:12.78,Default,,0,0,0,,Кун-чан, мен Шинкансенмен тағы келемін.
Dialogue: 0,0:08:12.91,0:08:14.24,Default,,0,0,0,,Қош бол
Dialogue: 0,0:08:14.32,0:08:16.03,Default,,0,0,0,,Бала да
Dialogue: 0,0:08:16.28,0:08:17.70,Default,,0,0,0,,Қайта кездескенше
Dialogue: 0,0:08:18.04,0:08:25.04,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:08:35.22,0:08:38.39,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:08:38.85,0:08:40.56,Default,,0,0,0,,Қайырлы таң Кун Чан
Dialogue: 0,0:08:40.89,0:08:43.64,Default,,0,0,0,,Қайырлы таң анашым
Dialogue: 0,0:08:45.52,0:08:47.61,Default,,0,0,0,,Қайырлы таң балақай
Dialogue: 0,0:08:50.53,0:08:52.82,Default,,0,0,0,,Иә~ Ах!
Dialogue: 0,0:08:54.15,0:08:56.49,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:08:57.45,0:08:58.58,Default,,0,0,0,,А-чи а-чи!
Dialogue: 0,0:08:59.49,0:09:01.20,Default,,0,0,0,,Acchi!
Dialogue: 0,0:09:05.46,0:09:07.54,Default,,0,0,0,,Анашым, сүт көбірек
Dialogue: 0,0:09:07.63,0:09:08.71,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:08.79,0:09:11.21,Default,,0,0,0,,Жоқ! анам банан
Dialogue: 0,0:09:11.30,0:09:13.72,Default,,0,0,0,,Иә~
Dialogue: 0,0:09:13.80,0:09:16.34,Default,,0,0,0,,Жоқ! Анашым!
Dialogue: 0,0:09:16.43,0:09:18.39,Default,,0,0,0,,Иә, қазірдің өзінде~!
Dialogue: 0,0:09:28.86,0:09:32.03,Default,,0,0,0,,Мен шаң сорамын, ойыншықтарыңды жаймаңдар.
Dialogue: 0,0:09:32.99,0:09:36.86,Default,,0,0,0,,О, қымбаттым!
Dialogue: 0,0:09:36.95,0:09:39.12,Default,,0,0,0,,Иә, сергітетін сияқты~
Dialogue: 0,0:09:39.20,0:09:41.33,Default,,0,0,0,,Муу~ О, Кун-чан
Dialogue: 0,0:09:41.70,0:09:43.54,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:09:43.62,0:09:45.16,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:45.25,0:09:46.50,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:09:46.58,0:09:49.63,Default,,0,0,0,,Уау, бұл кішкентай болды ма деп ойлаймын.
Dialogue: 0,0:09:49.71,0:09:51.71,Default,,0,0,0,,Бұл менің екінші балам, сондықтан менің қолымнан келеді.
Dialogue: 0,0:09:51.84,0:09:54.34,Default,,0,0,0,,Жоқ, мен үлкен бала кезімде қандай болды деп ойлаймын.
Dialogue: 0,0:09:54.42,0:09:56.13,Default,,0,0,0,,Ұмыту оңай
Dialogue: 0,0:09:56.22,0:09:57.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:57.63,0:10:01.39,Default,,0,0,0,,Бұл жолы, Юми, сен бала күтімі бойынша демалысыңды ерте аяқтайсың ба?
Dialogue: 0,0:10:01.47,0:10:03.93,Default,,0,0,0,,Иә, редакцияда көмектескен аға әріптесім...
Dialogue: 0,0:10:04.02,0:10:05.60,Default,,0,0,0,,Мен декреттік демалысқа шығамын.
Dialogue: 0,0:10:05.73,0:10:09.06,Default,,0,0,0,,Бұдан былай үйді күйеуіңіз басқарады.
Dialogue: 0,0:10:09.31,0:10:10.36,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:10:10.44,0:10:13.65,Default,,0,0,0,,Менің жұмысымды тастап, фрилансер болатын кез келді.
Dialogue: 0,0:10:13.73,0:10:17.24,Default,,0,0,0,,Жарайды, мен үйде жұмыс істеп жатқанда үй шаруасымен айналысамын.
Dialogue: 0,0:10:17.32,0:10:19.07,Default,,0,0,0,,Уау, бұл таңқаларлық.
Dialogue: 0,0:10:19.16,0:10:20.28,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:10:20.37,0:10:22.99,Default,,0,0,0,,Бұл тамаша нәрсе. Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:10:23.20,0:10:26.96,Default,,0,0,0,,(Әкенің күбірлеуі)
Dialogue: 0,0:10:27.04,0:10:30.54,Default,,0,0,0,,Удон~ Фуфун Хамфун~
Dialogue: 0,0:10:30.63,0:10:32.92,Default,,0,0,0,,Иә? не? басқаша
Dialogue: 0,0:10:33.00,0:10:34.76,Default,,0,0,0,,Маған қызық. Не?
Dialogue: 0,0:10:34.84,0:10:36.80,Default,,0,0,0,,Сосын айтамын, иә.
Dialogue: 0,0:10:37.26,0:10:38.59,Default,,0,0,0,,Мен сені көптен бері жақсы көремін.
Dialogue: 0,0:10:38.68,0:10:41.97,Default,,0,0,0,,Өзге аналардың алдында мейірімді әке болып әрекет ету
Dialogue: 0,0:10:42.05,0:10:43.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.14,0:10:45.52,Default,,0,0,0,,Бірақ сізді назардан тыс қалдырады.
Dialogue: 0,0:10:46.02,0:10:48.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:48.44,0:10:49.98,Default,,0,0,0,,Ыстық! Ахх!
Dialogue: 0,0:10:50.65,0:10:52.06,Default,,0,0,0,,А... Мен оны сүртуім керек.
Dialogue: 0,0:10:53.15,0:10:55.15,Default,,0,0,0,,Үстелді сүртуге арналған ыдыс орамал.
Dialogue: 0,0:10:55.23,0:10:57.28,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:10:59.74,0:11:02.41,Default,,0,0,0,,Мен наурыз айында жұмысқа қайтамын...
Dialogue: 0,0:11:02.49,0:11:05.29,Default,,0,0,0,,Оны тек жақшамен емес, дұрыс орындауымыз керек.
Dialogue: 0,0:11:05.37,0:11:07.62,Default,,0,0,0,,Ол ешқашан айналып кетпейді.
Dialogue: 0,0:11:08.87,0:11:09.87,Default,,0,0,0,,Иә
Dialogue: 0,0:11:09.96,0:11:13.79,Default,,0,0,0,,Мен бұрынғыдай жалғыз істей алмаймын.
Dialogue: 0,0:11:14.84,0:11:15.92,Default,,0,0,0,,Иә
Dialogue: 0,0:11:16.80,0:11:18.09,Default,,0,0,0,,Кун-чан—
Dialogue: 0,0:11:18.17,0:11:21.05,Default,,0,0,0,,Балаңызға көп нәрсе жасаңыз
Dialogue: 0,0:11:23.35,0:11:26.97,Default,,0,0,0,,Ендеше бірге серуендеп, жәндіктердің атын үйретейік.
Dialogue: 0,0:11:27.10,0:11:28.60,Default,,0,0,0,,Инелік
Dialogue: 0,0:11:28.98,0:11:32.35,Default,,0,0,0,,Сонымен қатар, мен сендерге бұлттардың пішіні қандай болатынын айтып беремін.
Dialogue: 0,0:11:32.44,0:11:33.44,Default,,0,0,0,,Скорпион
Dialogue: 0,0:11:34.52,0:11:35.52,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:11:35.61,0:11:40.45,Default,,0,0,0,,Көшеге шығуға әлі ерте. Ол сәл есейгенше күтемін.
Dialogue: 0,0:11:40.57,0:11:41.78,Default,,0,0,0,,Yes
Dialogue: 0,0:11:53.67,0:11:55.54,Default,,0,0,0,,«Онибаба Хигеге қарсы»
Dialogue: 0,0:11:55.71,0:11:58.34,Default,,0,0,0,,«Онибаба тік тұрып ашуланғанда...
Dialogue: 0,0:11:58.42,0:12:00.51,Default,,0,0,0,,Мен сақалды қудым»
Dialogue: 0,0:12:00.97,0:12:03.09,Default,,0,0,0,,Егер сақалды бір жаққа таратсаңыз...
Dialogue: 0,0:12:03.18,0:12:06.18,Default,,0,0,0,,Мен Yamanote Line E235 сериясына секірдім.
Dialogue: 0,0:12:06.39,0:12:10.93,Default,,0,0,0,,Мен Keihin Tohoku Line E233 сериясында Онибабаны қудым.
Dialogue: 0,0:12:11.35,0:12:13.52,Default,,0,0,0,,Дегенмен, Табата станциясынан өткенде...
Dialogue: 0,0:12:13.60,0:12:15.69,Default,,0,0,0,,Бір ғажабы, Онибаба мен Хиге бөлініп кетті...
Dialogue: 0,0:12:16.02,0:12:17.94,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:19.32,0:12:21.95,Default,,0,0,0,,Балаңыздың ұйқысын бұзбаңыз
Dialogue: 0,0:12:22.82,0:12:24.20,Default,,0,0,0,,Муу!
Dialogue: 0,0:12:24.49,0:12:26.28,Default,,0,0,0,,Тағы?
Dialogue: 0,0:12:26.37,0:12:27.37,Default,,0,0,0,,Оны қатты итеріңіз
Dialogue: 0,0:12:27.45,0:12:28.45,Default,,0,0,0,,Жаңа туған нәресте қорқынышты
Dialogue: 0,0:12:28.54,0:12:29.54,Default,,0,0,0,,Анашым!
Dialogue: 0,0:12:29.62,0:12:31.54,Default,,0,0,0,,Ауызға дұрыс ұстамасаңыз, ауа кіріп кетеді.
Dialogue: 0,0:12:31.62,0:12:33.58,Default,,0,0,0,,Әке! Осы сияқты көбірек...
Dialogue: 0,0:12:34.12,0:12:35.88,Default,,0,0,0,,Әке! Уау, ингаляция мүлдем басқаша.
Dialogue: 0,0:12:35.96,0:12:37.04,Default,,0,0,0,,Ішіп болған соң, мен сені ұрайын.
Dialogue: 0,0:12:37.13,0:12:38.34,Default,,0,0,0,,Анашым!
Dialogue: 0,0:12:38.42,0:12:39.42,Default,,0,0,0,,Бөртпе
Dialogue: 0,0:12:39.88,0:12:41.88,Default,,0,0,0,,Әр нәрсенің бастауы бар, сондықтан...
Dialogue: 0,0:12:51.27,0:12:53.27,Default,,0,0,0,,Бұл жуғыш затты іш киіміңізге пайдаланыңыз.
Dialogue: 0,0:12:53.35,0:12:55.15,Default,,0,0,0,,Шұлықтар ше? шұлықтар да
Dialogue: 0,0:12:55.23,0:12:57.40,Default,,0,0,0,,Е... іш киім қанша тұрады?
Dialogue: 0,0:13:00.73,0:13:01.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:21.38,0:13:28.39,Default,,0,0,0,,(Кун Чанның ауыр тыныс алуы)
Dialogue: 0,0:13:33.06,0:13:34.06,Default,,0,0,0,,Иә
Dialogue: 0,0:13:36.39,0:13:37.81,Default,,0,0,0,,Mugggggggg
Dialogue: 0,0:13:39.81,0:13:40.82,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:43.36,0:13:44.74,Default,,0,0,0,,Куку куку
Dialogue: 0,0:13:45.36,0:13:46.95,Default,,0,0,0,,Кахаха
Dialogue: 0,0:13:48.41,0:13:50.95,Default,,0,0,0,,Кукукукукуку ахаха
Dialogue: 0,0:13:51.33,0:13:54.58,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:13:54.66,0:13:55.66,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:55.75,0:13:59.58,Default,,0,0,0,,Кун-чан, сен не істедің? Сіз тіл табысуға уәде бердіңіз!
Dialogue: 0,0:13:59.67,0:14:00.75,Default,,0,0,0,,Біз тіл табыса алмаймыз
Dialogue: 0,0:14:00.84,0:14:03.17,Default,,0,0,0,,Балаңызды жақсы күтіңіз.
Dialogue: 0,0:14:03.26,0:14:04.26,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,0:14:04.34,0:14:06.01,Default,,0,0,0,,Сәлем, өтінемін! Мен істей алмаймын!
Dialogue: 0,0:14:06.09,0:14:09.72,Default,,0,0,0,,...
Dialogue: 0,0:14:16.48,0:14:19.06,Default,,0,0,0,,(қатты жылау)
Dialogue: 0,0:14:19.15,0:14:21.86,Default,,0,0,0,,Сіз не істеп жатырсыз? Сенің жаңа туғаныңа сене алар емеспін!
Dialogue: 0,0:14:24.82,0:14:31.37,Default,,0,0,0,,(нәресте жылауы)
Dialogue: 0,0:14:32.28,0:14:35.08,Default,,0,0,0,,(Юкконың айқайы)
Dialogue: 0,0:14:35.16,0:14:36.79,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:14:39.33,0:14:42.00,Default,,0,0,0,,Қарама! Эй! Иә иә
Dialogue: 0,0:14:42.09,0:14:44.25,Default,,0,0,0,,Кун! Ол баланың үлкен ағасы, солай ма?
Dialogue: 0,0:14:44.67,0:14:46.05,Default,,0,0,0,,Бұл сенің ағаң емес!
Dialogue: 0,0:14:46.13,0:14:47.30,Default,,0,0,0,,Ол менің ағам!
Dialogue: 0,0:14:47.38,0:14:49.13,Default,,0,0,0,,Ана тіпті ана емес!
Dialogue: 0,0:14:49.22,0:14:50.76,Default,,0,0,0,,Сонымен, сіз нені айтасыз?
Dialogue: 0,0:14:50.84,0:14:51.85,Default,,0,0,0,,Онибаба!
Dialogue: 0,0:14:52.22,0:14:53.51,Default,,0,0,0,,Онибаба!
Dialogue: 0,0:14:53.72,0:14:54.72,Default,,0,0,0,,На
Dialogue: 0,0:14:55.10,0:14:57.31,Default,,0,0,0,,Не! а?
Dialogue: 0,0:14:57.39,0:15:00.19,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:15:00.27,0:15:01.73,Default,,0,0,0,,Әке!
Dialogue: 0,0:15:02.23,0:15:04.94,Default,,0,0,0,,Жылама, жылама~
Dialogue: 0,0:15:06.82,0:15:10.28,Default,,0,0,0,,Жылама~ Жарайды, жарайды
Dialogue: 0,0:15:12.74,0:15:14.12,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:15:14.33,0:15:20.08,Default,,0,0,0,,(Кун Чанның жылағаны)
Dialogue: 0,0:15:21.29,0:15:23.21,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:15:24.84,0:15:27.13,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:15:27.51,0:15:28.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.72,0:15:35.51,Default,,0,0,0,,Аспаз аспаз Аспаз... ызылдап жатыр.
Dialogue: 0,0:15:40.19,0:15:43.73,Default,,0,0,0,,Яғни, мен қызмын ғой.
Dialogue: 0,0:15:45.23,0:15:48.36,Default,,0,0,0,,Маған қазір өзіңізді қалай сезінетініңізді болжауға рұқсат етіңіз.
Dialogue: 0,0:15:49.11,0:15:50.86,Default,,0,0,0,,Мен жай ғана қызғанамын
Dialogue: 0,0:15:52.03,0:15:56.16,Default,,0,0,0,,Жабу? «Тоқ» нені білдіреді?
Dialogue: 0,0:15:56.87,0:16:01.37,Default,,0,0,0,,Осы уақытқа дейін мен әкем мен анамның махаббатын монополиялап келгенмін.
Dialogue: 0,0:16:01.83,0:16:05.46,Default,,0,0,0,,Ешқандай ескертусіз кенеттен келген кішкентай жігітке...
Dialogue: 0,0:16:05.54,0:16:08.92,Default,,0,0,0,,Махаббатымыз тамырымен жұлынды
Dialogue: 0,0:16:10.05,0:16:12.68,Default,,0,0,0,,Қол көтерсем ұрысатынымды білемін.
Dialogue: 0,0:16:12.76,0:16:16.93,Default,,0,0,0,,Бірақ мен қарсылық көрсете алмай, жасадым.
Dialogue: 0,0:16:18.14,0:16:19.27,Default,,0,0,0,,Хехехе
Dialogue: 0,0:16:19.60,0:16:20.77,Default,,0,0,0,,Бұл жұлдыз емес пе?
Dialogue: 0,0:16:22.23,0:16:23.23,Default,,0,0,0,,Гааах!
Dialogue: 0,0:16:23.52,0:16:25.11,Default,,0,0,0,,Ол ханзада.
Dialogue: 0,0:16:25.19,0:16:26.27,Default,,0,0,0,,Ханзада?
Dialogue: 0,0:16:26.36,0:16:31.19,Default,,0,0,0,,Иә, сен туылғанға дейін осы үйде.
Dialogue: 0,0:16:32.70,0:16:36.20,Default,,0,0,0,,Енді ханзаданың алдында тізерлеп отырыңдар.
Dialogue: 0,0:16:40.41,0:16:42.62,Default,,0,0,0,,Әкем мен шешем мен туралы айтты—
Dialogue: 0,0:16:42.71,0:16:45.46,Default,,0,0,0,,Бұл мен үшін маңызды болды.
Dialogue: 0,0:16:45.54,0:16:49.59,Default,,0,0,0,,Ол әрқашан менің қасымда болды және: «Сен шынымен сүйкімдісің» деді.
Dialogue: 0,0:16:49.67,0:16:52.55,Default,,0,0,0,,Басымнан ақырын сипады.
Dialogue: 0,0:16:53.72,0:16:54.76,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:16:55.05,0:16:59.43,Default,,0,0,0,,Сен келгеннен бері мені одан әрі бұрышқа итеріп жіберді...
Dialogue: 0,0:16:59.51,0:17:02.18,Default,,0,0,0,,Тамақтар сүйікті дәмдерден арнайы ұсыныстарға ауысады.
Dialogue: 0,0:17:02.27,0:17:06.02,Default,,0,0,0,,Күнде тамақ жоқ, мақтау, көңіл бөлу жоқ ...
Dialogue: 0,0:17:06.10,0:17:08.61,Default,,0,0,0,,Менің айтарым, маған ұрысады.
Dialogue: 0,0:17:08.69,0:17:10.90,Default,,0,0,0,,Сол кезде түсіндім
Dialogue: 0,0:17:11.99,0:17:13.28,Default,,0,0,0,,Махаббат
Dialogue: 0,0:17:13.86,0:17:16.66,Default,,0,0,0,,Мен оны жоғалтып алдым...
Dialogue: 0,0:17:16.82,0:17:20.99,Default,,0,0,0,,Бұл қаншалықты қайғылы, қайғылы және азапты болды!
Dialogue: 0,0:17:21.08,0:17:22.33,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:17:22.41,0:17:23.41,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:17:23.50,0:17:26.42,Default,,0,0,0,,Білмейсіз бе? Сіз білмеймін дейсіз бе?
Dialogue: 0,0:17:26.88,0:17:29.75,Default,,0,0,0,,О, түсіндім, бәрі жақсы.
Dialogue: 0,0:17:30.09,0:17:32.42,Default,,0,0,0,,Бірақ... бұл басқаның мәселесі емес.
Dialogue: 0,0:17:32.51,0:17:34.80,Default,,0,0,0,,Сен де сондай болатын күн туады.
Dialogue: 0,0:17:34.88,0:17:36.26,Default,,0,0,0,,Бұл жақсы сезінеді!
Dialogue: 0,0:17:38.30,0:17:39.55,Default,,0,0,0,,Шынында да, бұл жігіт жақсы адам болуы мүмкін, білесің бе?
Dialogue: 0,0:17:40.60,0:17:41.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:44.06,0:17:45.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:45.14,0:17:46.73,Default,,0,0,0,,Иә (М) Ах.
Dialogue: 0,0:17:50.48,0:17:51.52,Default,,0,0,0,,Иә
Dialogue: 0,0:17:52.32,0:17:53.36,Default,,0,0,0,,Иә
Dialogue: 0,0:17:55.40,0:17:56.53,Default,,0,0,0,,Иә (Ұ) Аха!
Dialogue: 0,0:17:56.61,0:17:59.62,Default,,0,0,0,,(жүгіру)
Dialogue: 0,0:17:59.87,0:18:01.03,Default,,0,0,0,,Иә
Dialogue: 0,0:18:02.49,0:18:03.50,Default,,0,0,0,,Иә
Dialogue: 0,0:18:03.58,0:18:04.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:04.91,0:18:05.91,Default,,0,0,0,,Иә (Ұ) Аха!
Dialogue: 0,0:18:06.29,0:18:07.71,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:08.21,0:18:09.33,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:18:09.67,0:18:11.34,Default,,0,0,0,,Ой! Сіз не істедіңіз?
Dialogue: 0,0:18:11.42,0:18:13.38,Default,,0,0,0,,ше? Тоқта...
Dialogue: 0,0:18:14.05,0:18:15.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:25.35,0:18:27.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:32.07,0:18:35.82,Default,,0,0,0,,Қайтар мені, құйрығымды қайтар!
Dialogue: 0,0:18:37.03,0:18:42.03,Default,,0,0,0,,(Кун Чанның күлкісі)
Dialogue: 0,0:18:42.12,0:18:44.99,Default,,0,0,0,,Күте тұрыңыз! қазірдің өзінде!
Dialogue: 0,0:18:46.33,0:18:49.04,Default,,0,0,0,,Бұл туралы не деуге болады! Бұл дұрыс!
Dialogue: 0,0:18:49.12,0:18:51.08,Default,,0,0,0,,Жоқ! О, күт!
Dialogue: 0,0:18:51.25,0:18:53.25,Default,,0,0,0,,Уф уф, осылай!
Dialogue: 0,0:18:53.34,0:18:56.55,Default,,0,0,0,,Бір ғана емес! Ақымақ болмаңыз және оны қайтарыңыз!
Dialogue: 0,0:18:56.63,0:18:58.42,Default,,0,0,0,,Жоқ, көбірек ойнаңыз!
Dialogue: 0,0:18:58.51,0:19:00.51,Default,,0,0,0,,Ойнама Бұл ауырады!
Dialogue: 0,0:19:04.93,0:19:06.43,Default,,0,0,0,,Ой, тоқтат!
Dialogue: 0,0:19:07.31,0:19:10.48,Default,,0,0,0,,Не болды? Эй Юкко
Dialogue: 0,0:19:10.73,0:19:13.90,Default,,0,0,0,,Әй... Әй, не істеп жатырсың?!
Dialogue: 0,0:19:15.86,0:19:18.65,Default,,0,0,0,,Юкко... не болды? Юкко
Dialogue: 0,0:19:18.74,0:19:19.74,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:19:19.82,0:19:21.49,Default,,0,0,0,,Кун-чан, бұл Юкко!
Dialogue: 0,0:19:21.82,0:19:22.91,Default,,0,0,0,,Ах~
Dialogue: 0,0:19:22.99,0:19:25.16,Default,,0,0,0,,Оны маған қайтаруыңызды өтінемін.
Dialogue: 0,0:19:41.05,0:19:42.09,Default,,0,0,0,,Уфф!
Dialogue: 0,0:19:42.34,0:19:44.97,Default,,0,0,0,,Осы уақытқа дейін сәбидей қимылдап, жабайы болдың.
Dialogue: 0,0:19:45.05,0:19:46.39,Default,,0,0,0,,Бұл қазірдің өзінде
Dialogue: 0,0:19:46.47,0:19:49.31,Default,,0,0,0,,Қыңыр адам болсаң да, тез өзгересің.
Dialogue: 0,0:19:49.64,0:19:52.31,Default,,0,0,0,,Бұл нәресте орамы емес, бұл нәресте орамы.
Dialogue: 0,0:19:52.48,0:19:54.90,Default,,0,0,0,,Сонымен, Юкконың не айтып тұрғанын түсіндің бе?
Dialogue: 0,0:19:55.27,0:19:59.86,Default,,0,0,0,,Иә, ол одан да дәмді ит тағамын жегім келеді дейді.
Dialogue: 0,0:19:59.94,0:20:02.32,Default,,0,0,0,,Цк, мен түсінемін.
Dialogue: 0,0:20:02.41,0:20:06.08,Default,,0,0,0,,Жарайды, мен қазір жаңасын сатып аламын деп ойлаймын.
Dialogue: 0,0:20:06.20,0:20:07.33,Default,,0,0,0,,(Юкконың үруі)
Dialogue: 0,0:20:33.81,0:20:36.52,Default,,0,0,0,,Мм, бақыттымын
Dialogue: 0,0:20:37.40,0:20:40.15,Default,,0,0,0,,Мен сенің орныңды баса аламын ба?
Dialogue: 0,0:20:40.74,0:20:42.32,Default,,0,0,0,,Өйткені сіз сүт ішпейсіз бе?
Dialogue: 0,0:20:42.40,0:20:45.16,Default,,0,0,0,,Мен сені ұстасам да, сен мүлде жылауыңды тоқтатпайсың...
Dialogue: 0,0:20:45.24,0:20:47.37,Default,,0,0,0,,Тек сені ұстап тұрасың, сен қаттысың
Dialogue: 0,0:20:47.49,0:20:49.66,Default,,0,0,0,,Әрине болмайды, иә?
Dialogue: 0,0:20:49.74,0:20:52.33,Default,,0,0,0,,Кун-чанмен бірге болғанымда, мен ештеңе істемедім.
Dialogue: 0,0:20:52.41,0:20:54.83,Default,,0,0,0,,Кешіріңіз, мен жұмысқа қашып кеттім.
Dialogue: 0,0:20:54.92,0:20:57.46,Default,,0,0,0,,Сонда да ол тек менің түр-түсімді ғана бақылап отырады.
Dialogue: 0,0:20:57.54,0:20:59.34,Default,,0,0,0,,Ол ең нашар әке.
Dialogue: 0,0:20:59.71,0:21:03.42,Default,,0,0,0,,Ер адамдар сәбилерге қызықпайды деп ойладым.
Dialogue: 0,0:21:03.88,0:21:06.09,Default,,0,0,0,,А, бірақ мені қызықтырады.
Dialogue: 0,0:21:06.18,0:21:08.05,Default,,0,0,0,,Иә? Бұл өтірік емес пе?
Dialogue: 0,0:21:08.14,0:21:11.98,Default,,0,0,0,,Бұл шынымен де керемет шықты!
Dialogue: 0,0:21:12.23,0:21:15.14,Default,,0,0,0,,Қараңдар! Ахахха! Қараңдар, қараңдар
Dialogue: 0,0:21:15.23,0:21:16.98,Default,,0,0,0,,Бұл сөзсіз өтірік.
Dialogue: 0,0:21:17.06,0:21:18.44,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:21:18.77,0:21:19.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:19.90,0:21:21.15,Default,,0,0,0,,Не? не?
Dialogue: 0,0:21:21.23,0:21:22.99,Default,,0,0,0,,Мен жай ғана ойладым.
Dialogue: 0,0:21:23.86,0:21:25.91,Default,,0,0,0,,(Ұялы телефонды қабылдау дыбысы)
Dialogue: 0,0:21:27.16,0:21:28.41,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:28.95,0:21:30.08,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:21:30.16,0:21:31.95,Default,,0,0,0,,Менің ойымша, сіз оны нұсқаулық деп атай аласыз.
Dialogue: 0,0:21:32.04,0:21:34.08,Default,,0,0,0,,Иә, бұл жақсы деп ойлаймын.
Dialogue: 0,0:21:38.13,0:21:41.09,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:21:47.84,0:21:49.51,Default,,0,0,0,,Қайырлы таң Кун Чан
Dialogue: 0,0:21:49.93,0:21:51.10,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:21:51.22,0:21:53.56,Default,,0,0,0,,Әй, артыңа қарашы.
Dialogue: 0,0:21:55.18,0:21:56.73,Default,,0,0,0,,Онда не айтылған?
Dialogue: 0,0:21:56.81,0:21:58.06,Default,,0,0,0,,Болашаққа ат қою
Dialogue: 0,0:21:58.15,0:21:59.15,Default,,0,0,0,,Болашақ?
Dialogue: 0,0:21:59.23,0:22:02.07,Default,,0,0,0,,Сәбидің аты Мирай-чан.
Dialogue: 0,0:22:06.82,0:22:08.87,Default,,0,0,0,,Мираи...чан...
Dialogue: 0,0:22:14.54,0:22:16.16,Default,,0,0,0,,Мираи-чан?
Dialogue: 0,0:22:16.71,0:22:19.38,Default,,0,0,0,,Ахаха біртүрлі есім!
Dialogue: 0,0:22:25.59,0:22:26.97,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:22:27.26,0:22:28.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:28.47,0:22:31.14,Default,,0,0,0,,Охина-сама қыздар мерекесі
Dialogue: 0,0:22:31.22,0:22:32.22,Default,,0,0,0,,Ойвай?
Dialogue: 0,0:22:32.31,0:22:33.97,Default,,0,0,0,,Деніңіз сау болып өсуіңізге тілектеспін.
Dialogue: 0,0:22:34.06,0:22:35.85,Default,,0,0,0,,Бұл дұға ету туралы.
Dialogue: 0,0:22:37.27,0:22:40.86,Default,,0,0,0,,Тоқта, бұл Мирай-чан, тиіспе.
Dialogue: 0,0:22:40.94,0:22:42.52,Default,,0,0,0,,Мен де Кун Чанды қалаймын
Dialogue: 0,0:22:42.65,0:22:44.65,Default,,0,0,0,,Кун-чан, бала ғой, солай ма?
Dialogue: 0,0:22:45.94,0:22:48.95,Default,,0,0,0,,Тіпті Юкко да саған тиіспейді. Ол бала, солай ма?
Dialogue: 0,0:22:50.07,0:22:52.45,Default,,0,0,0,,(домофон қоңырауы)
Dialogue: 0,0:22:52.53,0:22:54.49,Default,,0,0,0,,Сәлеметсіз бе, қош келдіңіз
Dialogue: 0,0:22:54.58,0:22:56.04,Default,,0,0,0,,Йокогама жылы, солай емес пе?
Dialogue: 0,0:22:56.41,0:22:57.75,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:22:57.83,0:23:02.38,Default,,0,0,0,,Өйткені, қыздардың киімдері ұлдарға қарағанда әртүрлі.
Dialogue: 0,0:23:04.09,0:23:06.67,Default,,0,0,0,,3 ай болды, солай емес пе?
Dialogue: 0,0:23:06.76,0:23:08.93,Default,,0,0,0,,Менің салмағым туған кездегі салмағымнан екі есе көп.
Dialogue: 0,0:23:09.01,0:23:11.64,Default,,0,0,0,,Сіз отырдыңыз ба? Иә, дерлік
Dialogue: 0,0:23:11.72,0:23:16.39,Default,,0,0,0,,Мирай-чан Бұл менің атам~ Мирай-чан
Dialogue: 0,0:23:16.68,0:23:17.93,Default,,0,0,0,,А-у-
Dialogue: 0,0:23:18.02,0:23:19.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:19.27,0:23:21.19,Default,,0,0,0,,Кун-чан, маған кедергі жасама
Dialogue: 0,0:23:21.27,0:23:25.11,Default,,0,0,0,,Бұл сіздің үлкен әжеңіз Мирай-чанға көрсететін нәрсе.
Dialogue: 0,0:23:25.82,0:23:28.40,Default,,0,0,0,,Кун-чанның да видеосын түсіріңіз! Суретке түсіріңіз!
Dialogue: 0,0:23:28.49,0:23:30.95,Default,,0,0,0,,Түсіндім, түсіндім, түсіндім, түсіндім, иә.
Dialogue: 0,0:23:31.16,0:23:34.20,Default,,0,0,0,,О~ Бұл тамаша О, тамаша
Dialogue: 0,0:23:34.33,0:23:35.41,Default,,0,0,0,,Мираи-чан
Dialogue: 0,0:23:35.54,0:23:37.95,Default,,0,0,0,,Кун-чанның видеосын түсіріңіз!
Dialogue: 0,0:23:38.33,0:23:41.83,Default,,0,0,0,,Иә, иә, иә, о~
Dialogue: 0,0:23:41.92,0:23:43.75,Default,,0,0,0,,Мираи-чан хей
Dialogue: 0,0:23:44.00,0:23:45.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:45.55,0:23:46.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:47.00,0:23:48.21,Default,,0,0,0,,Бұл көгеру ме?
Dialogue: 0,0:23:48.30,0:23:49.51,Default,,0,0,0,,Қайда?
Dialogue: 0,0:23:50.22,0:23:52.22,Default,,0,0,0,,Міне, сонда, шынымен.
Dialogue: 0,0:23:52.30,0:23:53.97,Default,,0,0,0,,Бұл туғаннан бері
Dialogue: 0,0:23:54.05,0:23:55.51,Default,,0,0,0,,Дұрыс тексеруден өттіңіз бе?
Dialogue: 0,0:23:55.60,0:23:58.98,Default,,0,0,0,,Иә, бірақ ол жоғалып кете ме, қала ма білмеймін.
Dialogue: 0,0:23:59.06,0:24:03.35,Default,,0,0,0,,Иә... Сен қалсаң, ол кейін уайымдауы мүмкін.
Dialogue: 0,0:24:03.48,0:24:05.57,Default,,0,0,0,,Хмм.
Dialogue: 0,0:24:09.65,0:24:12.16,Default,,0,0,0,,Мебина мен Обинаха жұбы
Dialogue: 0,0:24:12.24,0:24:15.12,Default,,0,0,0,,Ана мен әке, әже мен ата
Dialogue: 0,0:24:15.20,0:24:18.20,Default,,0,0,0,,Үлкен әже мен үлкен ата сияқты.
Dialogue: 0,0:24:18.29,0:24:21.66,Default,,0,0,0,,Кун-чан, өткен жылы арғы атаңның жерлеуіне барғаның есіңде ме?
Dialogue: 0,0:24:21.75,0:24:22.75,Default,,0,0,0,,Иә
Dialogue: 0,0:24:23.04,0:24:24.46,Default,,0,0,0,,Енді ойлап көрейікші
Dialogue: 0,0:24:24.54,0:24:27.34,Default,,0,0,0,,Арғы ата мен үлкен әже туралы аңыз рас па?
Dialogue: 0,0:24:27.46,0:24:28.50,Default,,0,0,0,,Не?
Dialogue: 0,0:24:28.59,0:24:32.34,Default,,0,0,0,,Арғы атам менімен алғаш рет Икеда клиникасында кездесіп, оған тұрмысқа шығуымды өтінді...
Dialogue: 0,0:24:32.47,0:24:36.22,Default,,0,0,0,,«Бәйгеде жеңсең, қолыңнан келеді», – деді үлкен әжем.
Dialogue: 0,0:24:36.30,0:24:39.89,Default,,0,0,0,,Сонымен арғы атам жеңді, осылайша біз жиналдық.
Dialogue: 0,0:24:39.97,0:24:42.73,Default,,0,0,0,,Мен халықтың өзінен мұндайды естіген емеспін.
Dialogue: 0,0:24:42.81,0:24:46.61,Default,,0,0,0,,Ех! Өйткені жаназада Ямато ағай да, басқалар да осылай деді.
Dialogue: 0,0:24:46.69,0:24:48.65,Default,,0,0,0,,Атамның жамбас буыны нашар болған.
Dialogue: 0,0:24:48.73,0:24:49.78,Default,,0,0,0,,Бұл Маюцуба.
Dialogue: 0,0:24:49.86,0:24:50.99,Default,,0,0,0,,Не, өтірік пе?
Dialogue: 0,0:24:51.07,0:24:53.82,Default,,0,0,0,,Міне, сондықтан да аңыз, солай ма?
Dialogue: 0,0:24:53.99,0:24:56.53,Default,,0,0,0,,Иә? Қуыршақтар туралы аңыздар да бар.
Dialogue: 0,0:24:56.62,0:24:57.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:57.83,0:25:01.33,Default,,0,0,0,,Мереке бітсе, неке кешігеді, солай ма?
Dialogue: 0,0:25:01.41,0:25:03.79,Default,,0,0,0,,Бұл күнде ешкімнің шаруасы жоқ.
Dialogue: 0,0:25:04.46,0:25:06.58,Default,,0,0,0,,Сіз қанша уақытқа кешігіп келесіз?
Dialogue: 0,0:25:06.67,0:25:09.00,Default,,0,0,0,,Әр күн бір жыл.
Dialogue: 0,0:25:09.09,0:25:12.88,Default,,0,0,0,,Даха, қызық, ол санды берудің негізі неде?
Dialogue: 0,0:25:12.97,0:25:16.72,Default,,0,0,0,,Аңыз, жай ғана аңыз
Dialogue: 0,0:25:19.97,0:25:23.48,Default,,0,0,0,,Эй, мен кешігіп барамын.
Dialogue: 0,0:25:27.23,0:25:28.23,Default,,0,0,0,,Кун-чан
Dialogue: 0,0:25:28.31,0:25:30.82,Default,,0,0,0,,Мама, мен бүгін-ертең іссапарда болмаймын.
Dialogue: 0,0:25:30.90,0:25:31.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:25:32.24,0:25:33.74,Default,,0,0,0,,Жақсы қыз болып, үйде отыр.
Dialogue: 0,0:25:33.82,0:25:34.82,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:25:35.20,0:25:37.91,Default,,0,0,0,,Егер сіз оны шығарайын деп жатсаңыз, әкеңізге айтыңыз.
Dialogue: 0,0:25:38.03,0:25:39.28,Default,,0,0,0,,Барма~
Dialogue: 0,0:25:39.37,0:25:41.45,Default,,0,0,0,,Олай болса, балалар.
Dialogue: 0,0:25:41.54,0:25:42.58,Default,,0,0,0,,Yes
Dialogue: 0,0:25:43.41,0:25:44.71,Default,,0,0,0,,Амон, ол жігіт қауіпті.
Dialogue: 0,0:25:44.79,0:25:47.33,Default,,0,0,0,,Кейінірек, Охина-сама, бүгін таста.
Dialogue: 0,0:25:47.42,0:25:48.50,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:25:48.58,0:25:49.71,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:25:49.79,0:25:51.21,Default,,0,0,0,,Анашым!
Dialogue: 0,0:25:55.59,0:25:57.43,Default,,0,0,0,,Өте керемет~
Dialogue: 0,0:26:00.68,0:26:02.85,Default,,0,0,0,,Анам жақсы. мен барамын.
Dialogue: 0,0:26:02.93,0:26:04.52,Default,,0,0,0,,Әке маған ұнамайды!
Dialogue: 0,0:26:04.77,0:26:06.14,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:26:06.52,0:26:07.73,Default,,0,0,0,,О, кешіріңіз.
Dialogue: 0,0:26:07.90,0:26:09.90,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,0:26:11.15,0:26:12.15,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:26:14.36,0:26:16.90,Default,,0,0,0,,Бұл белгі...
Dialogue: 0,0:26:23.95,0:26:25.91,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:26:26.00,0:26:28.08,Default,,0,0,0,,Уау~ Қайтып келді!
Dialogue: 0,0:26:28.33,0:26:29.67,Default,,0,0,0,,Уау, бұл өте ұзақ!
Dialogue: 0,0:26:35.38,0:26:37.51,Default,,0,0,0,,(Мираи-чанның жылауы)
Dialogue: 0,0:26:39.22,0:26:42.10,Default,,0,0,0,,Әке маған ұнамайды! Иә иә
Dialogue: 0,0:26:42.60,0:26:44.72,Default,,0,0,0,,Жүр, ұйықтап алайық~
Dialogue: 0,0:26:49.81,0:26:52.27,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:27:03.62,0:27:08.41,Default,,0,0,0,,(Әкенің ұйықтап жатқан тынысы)
Dialogue: 0,0:27:21.34,0:27:23.35,Default,,0,0,0,,Әке, ойна
Dialogue: 0,0:27:23.43,0:27:25.77,Default,,0,0,0,,Неге Ю Чанның үйінде ойнамайсың?
Dialogue: 0,0:27:25.85,0:27:27.81,Default,,0,0,0,,Иә, әкесімен.
Dialogue: 0,0:27:28.39,0:27:31.19,Default,,0,0,0,,Әке, бұл сізге ұнамады, солай ма?
Dialogue: 0,0:27:31.31,0:27:34.19,Default,,0,0,0,,Маған бұл ұнамайды, сондықтан онымен ойнаңыз.
Dialogue: 0,0:27:34.73,0:27:37.19,Default,,0,0,0,,Иә, түсіндім...
Dialogue: 0,0:27:37.28,0:27:38.94,Default,,0,0,0,,Суретті кітаптарды оқу
Dialogue: 0,0:27:39.20,0:27:40.40,Default,,0,0,0,,Иә
Dialogue: 0,0:27:41.07,0:27:42.78,Default,,0,0,0,,Бейнені көрсетіңіз
Dialogue: 0,0:27:43.78,0:27:44.78,Default,,0,0,0,,Иә
Dialogue: 0,0:27:44.87,0:27:47.12,Default,,0,0,0,,Айналдыру сайысын өткізіңіз
Dialogue: 0,0:27:48.37,0:27:50.00,Default,,0,0,0,,Хмм…
Dialogue: 0,0:27:52.96,0:27:54.29,Default,,0,0,0,,Иә
Dialogue: 0,0:27:57.96,0:27:59.88,Default,,0,0,0,,Мираи-чан
Dialogue: 0,0:28:00.01,0:28:03.22,Default,,0,0,0,,Мираи-чан, сен китті көрдің бе?
Dialogue: 0,0:28:04.35,0:28:07.01,Default,,0,0,0,,Маған Мирай-чан ұнамайды.
Dialogue: 0,0:28:14.06,0:28:15.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:25.87,0:28:30.70,Default,,0,0,0,,(Кун-чан ызылдаған)
Dialogue: 0,0:28:32.04,0:28:35.54,Default,,0,0,0,,(Құстардың сайрап, ұшып бара жатқан дыбыстары)
Dialogue: 0,0:28:37.04,0:28:39.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:44.22,0:28:46.51,Default,,0,0,0,,Иә? Қайтадан
Dialogue: 0,0:28:47.35,0:28:53.69,Default,,0,0,0,,(Әртүрлі құстардың дыбыстары)
Dialogue: 0,0:28:55.35,0:28:56.86,Default,,0,0,0,,(Сынған нәрсенің дыбысы)
Dialogue: 0,0:29:02.28,0:29:04.57,Default,,0,0,0,,Бұл не? Ах!
Dialogue: 0,0:29:09.37,0:29:11.70,Default,,0,0,0,,Кит тәттілері! Ах!
Dialogue: 0,0:29:12.54,0:29:15.58,Default,,0,0,0,,Бұл да! Ахаха, міне, тағы барамыз! Ухуху
Dialogue: 0,0:29:17.46,0:29:20.71,Default,,0,0,0,,(Кун Чанның күлкісі)
Dialogue: 0,0:29:21.30,0:29:22.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:29.01,0:29:30.35,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:29:31.56,0:29:32.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:33.02,0:29:34.81,Default,,0,0,0,,Менің бетіммен ойнауды доғар.
Dialogue: 0,0:29:36.31,0:29:37.31,Default,,0,0,0,,Гааах!
Dialogue: 0,0:29:37.65,0:29:40.61,Default,,0,0,0,,Осы уақытқа дейін мен сені ұрып жылаттым.
Dialogue: 0,0:29:40.69,0:29:41.86,Default,,0,0,0,,Я...
Dialogue: 0,0:29:42.07,0:29:44.65,Default,,0,0,0,,Бірақ мұны былай қойғанда, ендігі мәселе...
Dialogue: 0,0:29:45.15,0:29:46.20,Default,,0,0,0,,Бұл!
Dialogue: 0,0:29:46.86,0:29:48.95,Default,,0,0,0,,А, мүмкін...
Dialogue: 0,0:29:49.20,0:29:50.41,Default,,0,0,0,,Болашақ...
Dialogue: 0,0:29:50.70,0:29:51.79,Default,,0,0,0,,Мираи-чан?
Dialogue: 0,0:29:52.70,0:29:53.70,Default,,0,0,0,,Қарама!
Dialogue: 0,0:29:53.87,0:29:54.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:59.67,0:30:01.59,Default,,0,0,0,,Әр күн – бір жыл…
Dialogue: 0,0:30:01.67,0:30:04.55,Default,,0,0,0,,«Не, бар болғаны бір жыл болды ма?» деп ойлайтын шығарсыз.
Dialogue: 0,0:30:04.63,0:30:08.18,Default,,0,0,0,,Бірақ әр жыл бір уақытта бір жыл жиналса не болады?
Dialogue: 0,0:30:08.26,0:30:09.76,Default,,0,0,0,,Не болады?
Dialogue: 0,0:30:10.18,0:30:13.18,Default,,0,0,0,,Сіз жақсы көретін адамыңызға үйлене алмауыңыз мүмкін...
Dialogue: 0,0:30:13.52,0:30:15.14,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:30:15.35,0:30:17.06,Default,,0,0,0,,Сіздің сүйікті адамыңыз кім?
Dialogue: 0,0:30:17.14,0:30:19.44,Default,,0,0,0,,Шо... Шо... Болашақ туралы айт
Dialogue: 0,0:30:19.52,0:30:22.90,Default,,0,0,0,,Әй, сен жүгіресің бе? Ей, біз үйленуге асықтық...
Dialogue: 0,0:30:22.98,0:30:26.11,Default,,0,0,0,,Әйтеуір, әкеңе айт, тезірек тастасын!
Dialogue: 0,0:30:28.91,0:30:29.95,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:30:30.87,0:30:31.91,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:30:32.03,0:30:33.70,Default,,0,0,0,,Мираи-чан, сен маған ұнамайсың.
Dialogue: 0,0:30:33.91,0:30:35.20,Default,,0,0,0,,Неліктен бұл сізге ұнамайды?
Dialogue: 0,0:30:35.29,0:30:37.08,Default,,0,0,0,,Біз тіл табыса алмаймыз
Dialogue: 0,0:30:37.21,0:30:40.29,Default,,0,0,0,,Әй, мен әкеме айта алмаймын.
Dialogue: 0,0:30:40.38,0:30:41.63,Default,,0,0,0,,Неліктен? Эй
Dialogue: 0,0:30:41.71,0:30:43.59,Default,,0,0,0,,Өтінемін, ағайын.
Dialogue: 0,0:30:43.67,0:30:46.38,Default,,0,0,0,,Кун-чан, ол Мирай-чанның ағасы емес пе?
Dialogue: 0,0:30:49.30,0:30:53.85,Default,,0,0,0,,Хохо Солай ма? Солай ма?
Dialogue: 0,0:30:53.93,0:30:56.89,Default,,0,0,0,,Олай болса, халықтың өтінішін тыңдамасаң...
Dialogue: 0,0:30:57.39,0:30:59.06,Default,,0,0,0,,Өйткені бұл ара ойыны.
Dialogue: 0,0:30:59.14,0:31:00.52,Default,,0,0,0,,Ара ойыны?
Dialogue: 0,0:31:04.11,0:31:06.94,Default,,0,0,0,,Бөксіңізді шайқаңыз~
Dialogue: 0,0:31:07.86,0:31:10.86,Default,,0,0,0,,Серуендеу~
Dialogue: 0,0:31:14.20,0:31:16.12,Default,,0,0,0,,Чику чику чику чику (Кун-чанның күлкісі)
Dialogue: 0,0:31:16.20,0:31:18.33,Default,,0,0,0,,тікенді тікенді
Dialogue: 0,0:31:18.41,0:31:20.54,Default,,0,0,0,,тікенді тікенді
Dialogue: 0,0:31:20.96,0:31:23.04,Default,,0,0,0,,(Кун Чанның ауыр тыныс алуы)
Dialogue: 0,0:31:23.38,0:31:25.59,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің айтқанымды естіп тұрсың ба?
Dialogue: 0,0:31:25.92,0:31:27.09,Default,,0,0,0,,Эй
Dialogue: 0,0:31:27.97,0:31:29.84,Default,,0,0,0,,Көбірек жасаңыз
Dialogue: 0,0:31:31.22,0:31:34.18,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:31:35.18,0:31:36.52,Default,,0,0,0,,Қосымша
Dialogue: 0,0:31:37.43,0:31:38.85,Default,,0,0,0,,Әке
Dialogue: 0,0:31:38.93,0:31:40.02,Default,,0,0,0,,Yes
Dialogue: 0,0:31:40.19,0:31:42.06,Default,,0,0,0,,Охина-сама, қарашы.
Dialogue: 0,0:31:42.98,0:31:44.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:31:44.65,0:31:46.48,Default,,0,0,0,,Оны тастағанға не жетсін?
Dialogue: 0,0:31:47.07,0:31:48.40,Default,,0,0,0,,Хмм.
Dialogue: 0,0:31:48.49,0:31:49.86,Default,,0,0,0,,Әке
Dialogue: 0,0:31:50.11,0:31:51.20,Default,,0,0,0,,Yes
Dialogue: 0,0:31:52.28,0:31:53.45,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:31:54.07,0:31:56.41,Default,,0,0,0,,Олай болса жауапкершілікті алып таста, аға.
Dialogue: 0,0:31:56.87,0:31:58.12,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:31:58.45,0:32:01.71,Default,,0,0,0,,Жарайды, күте тұрыңыз!
Dialogue: 0,0:32:02.33,0:32:04.34,Default,,0,0,0,,Не? Маған қолдарыңды көрсет
Dialogue: 0,0:32:04.42,0:32:05.42,Default,,0,0,0,,Hand?
Dialogue: 0,0:32:05.50,0:32:09.21,Default,,0,0,0,,Уау, бұл керемет. Ол балшыққа толы емес. Ол жақсы.
Dialogue: 0,0:32:09.30,0:32:10.30,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:32:10.38,0:32:12.64,Default,,0,0,0,,Әй, жетеді, сұрамаймын.
Dialogue: 0,0:32:12.72,0:32:14.43,Default,,0,0,0,,Неліктен? Тоқта!
Dialogue: 0,0:32:15.97,0:32:17.47,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:32:32.28,0:32:34.91,Default,,0,0,0,,Қорап… Қорап…
Dialogue: 0,0:32:43.92,0:32:45.17,Default,,0,0,0,,болды
Dialogue: 0,0:32:50.01,0:32:51.09,Default,,0,0,0,,Хмм.
Dialogue: 0,0:33:02.14,0:33:03.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:07.65,0:33:08.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:09.86,0:33:12.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:15.78,0:33:17.07,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:33:17.16,0:33:18.28,Default,,0,0,0,,Онда жоқ!
Dialogue: 0,0:33:18.70,0:33:21.12,Default,,0,0,0,,Мираи-чан қайда? Мирай қайда?
Dialogue: 0,0:33:21.66,0:33:22.79,Default,,0,0,0,,Уф!
Dialogue: 0,0:33:23.58,0:33:24.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:27.13,0:33:29.09,Default,,0,0,0,,Не, ол құлап қалды ма?
Dialogue: 0,0:33:29.63,0:33:30.88,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:33:31.42,0:33:34.05,Default,,0,0,0,,Мираи-чан жақсы жұмыс
Dialogue: 0,0:33:35.88,0:33:37.59,Default,,0,0,0,,Сіз оны дәл қазір көрдіңіз бе?
Dialogue: 0,0:33:37.72,0:33:40.56,Default,,0,0,0,,Бала жоғалып кетті деп ойлағанымда, ол қайтадан пайда болды.
Dialogue: 0,0:33:40.64,0:33:44.60,Default,,0,0,0,,Бұл біртүрлі. Бұл нені білдіреді?
Dialogue: 0,0:33:44.69,0:33:48.44,Default,,0,0,0,,Басқаша айтқанда, болашақ Мирай-чан мен сәби Мирай-чан
Dialogue: 0,0:33:48.52,0:33:51.15,Default,,0,0,0,,Бұл олардың бір уақытта жоқ екенін білдіре ме?
Dialogue: 0,0:33:51.28,0:33:52.53,Default,,0,0,0,,Бар болу?
Dialogue: 0,0:33:52.61,0:33:55.82,Default,,0,0,0,,Өзіңнің бар екендігіңе сен ғана қызық емессің бе?
Dialogue: 0,0:33:55.95,0:33:57.99,Default,,0,0,0,,Сіз адам тілінде сөйлесеңіз де
Dialogue: 0,0:33:58.07,0:34:00.08,Default,,0,0,0,,Ойланып көріңізші, мүлде емес.
Dialogue: 0,0:34:00.16,0:34:01.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:02.16,0:34:03.62,Default,,0,0,0,,Мәселе бұл емес
Dialogue: 0,0:34:04.46,0:34:07.25,Default,,0,0,0,,Енді мен қуыршақпен не істеу керектігін шешуім керек.
Dialogue: 0,0:34:07.54,0:34:09.54,Default,,0,0,0,,Ойлануға уақыт болса, Юкко!
Dialogue: 0,0:34:09.63,0:34:10.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:10.75,0:34:12.96,Default,,0,0,0,,Маған да көмектесіңізші. Иә.
Dialogue: 0,0:34:13.05,0:34:15.26,Default,,0,0,0,,Ағам әкемнің назарын аударды.
Dialogue: 0,0:34:16.51,0:34:17.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:20.60,0:34:21.64,Default,,0,0,0,,Не?
Dialogue: 0,0:34:21.72,0:34:22.93,Default,,0,0,0,,Бұрын
Dialogue: 0,0:34:23.02,0:34:24.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:24.10,0:34:25.35,Default,,0,0,0,,Мұны тағы бір рет орындаңыз
Dialogue: 0,0:34:25.43,0:34:26.52,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:34:27.64,0:34:32.78,Default,,0,0,0,,(Кун Чанның күлкісі)
Dialogue: 0,0:34:32.86,0:34:33.94,Default,,0,0,0,,Хехехе
Dialogue: 0,0:34:35.57,0:34:37.95,Default,,0,0,0,,Оның несі қызық?
Dialogue: 0,0:34:52.00,0:34:53.25,Default,,0,0,0,,Әке
Dialogue: 0,0:34:53.92,0:34:56.88,Default,,0,0,0,,Сен білесің~ Кун Чан.
Dialogue: 0,0:34:57.26,0:34:59.38,Default,,0,0,0,,Не? Не болды? Қыбырлап жүрсің.
Dialogue: 0,0:34:59.47,0:35:00.76,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:35:01.30,0:35:02.72,Default,,0,0,0,,Э-э-э—
Dialogue: 0,0:35:03.51,0:35:05.35,Default,,0,0,0,,Иә? Біз шығамыз ба?
Dialogue: 0,0:35:05.60,0:35:07.35,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:35:07.52,0:35:09.85,Default,,0,0,0,,Мынаны алып тастаңыз...
Dialogue: 0,0:35:10.35,0:35:12.06,Default,,0,0,0,,Ол шығады, солай ма? Ол шықпайды.
Dialogue: 0,0:35:12.15,0:35:13.48,Default,,0,0,0,,Шығыңыз келсе, маған хабарлаңыз.
Dialogue: 0,0:35:15.53,0:35:19.61,Default,,0,0,0,,Юкко! Оны мұнда бөлшектеу үшін не істейміз?
Dialogue: 0,0:35:19.70,0:35:22.03,Default,,0,0,0,,О... кешіріңіз!
Dialogue: 0,0:35:22.12,0:35:23.49,Default,,0,0,0,,Сізге қайтудың қажеті жоқ!
Dialogue: 0,0:35:23.58,0:35:24.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:26.62,0:35:27.66,Default,,0,0,0,,Хмм?
Dialogue: 0,0:35:49.60,0:35:51.52,Default,,0,0,0,,Неліктен құлады?
Dialogue: 0,0:35:57.23,0:35:59.03,Default,,0,0,0,,Бұл қандай физикалық құбылыс?
Dialogue: 0,0:35:59.32,0:36:01.70,Default,,0,0,0,,Юкко, дем алма...
Dialogue: 0,0:36:01.78,0:36:02.78,Default,,0,0,0,,Э~?
Dialogue: 0,0:36:02.87,0:36:03.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:03.99,0:36:05.41,Default,,0,0,0,,Уф
Dialogue: 0,0:36:05.49,0:36:06.54,Default,,0,0,0,,Хмм?
Dialogue: 0,0:36:06.62,0:36:08.04,Default,,0,0,0,,О, аа~
Dialogue: 0,0:36:08.12,0:36:09.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:09.25,0:36:10.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:36:10.33,0:36:11.79,Default,,0,0,0,,Ха! Уф
Dialogue: 0,0:36:12.58,0:36:13.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:13.88,0:36:16.21,Default,,0,0,0,,Бұл қандай құбылыс?
Dialogue: 0,0:36:18.88,0:36:20.13,Default,,0,0,0,,Ах~
Dialogue: 0,0:36:21.68,0:36:22.59,Default,,0,0,0,,Ах~
Dialogue: 0,0:36:23.72,0:36:25.14,Default,,0,0,0,,Уау~
Dialogue: 0,0:36:26.14,0:36:28.14,Default,,0,0,0,,Мен кетемін, иә?
Dialogue: 0,0:36:28.22,0:36:29.52,Default,,0,0,0,,Шық
Dialogue: 0,0:36:29.89,0:36:31.35,Default,,0,0,0,,Уау! күтіңіз күтіңіз
Dialogue: 0,0:36:31.44,0:36:32.60,Default,,0,0,0,,Мен күте алмаймын
Dialogue: 0,0:36:32.69,0:36:35.11,Default,,0,0,0,,Күтіңіз, күтіңіз, тағы біраз күтіңіз
Dialogue: 0,0:36:35.19,0:36:37.61,Default,,0,0,0,,Сәл ұстаңыз, ұстаңыз! О
Dialogue: 0,0:36:39.74,0:36:42.45,Default,,0,0,0,,Тааа! Мен өлемін деп ойладым!
Dialogue: 0,0:36:43.20,0:36:44.45,Default,,0,0,0,,Қазір!
Dialogue: 0,0:36:55.42,0:36:58.09,Default,,0,0,0,,(дәретхананың ағу дыбысы)
Dialogue: 0,0:36:58.17,0:36:59.80,Default,,0,0,0,,Сіз қолыңызды өзіңіз сүрте аласыз ба?
Dialogue: 0,0:37:00.21,0:37:02.13,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:37:03.43,0:37:04.64,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:37:14.14,0:37:15.69,Default,,0,0,0,,Бұл жұмыс істеді ме?
Dialogue: 0,0:37:15.85,0:37:18.15,Default,,0,0,0,,Ааах…
Dialogue: 0,0:37:18.32,0:37:19.52,Default,,0,0,0,,Не?
Dialogue: 0,0:37:19.94,0:37:21.53,Default,,0,0,0,,Таяқсыз!
Dialogue: 0,0:37:21.61,0:37:23.24,Default,,0,0,0,,Шак дегеніміз не?
Dialogue: 0,0:37:23.32,0:37:25.36,Default,,0,0,0,,Бұл сіздің қолыңыздағы тақта сияқты.
Dialogue: 0,0:37:25.45,0:37:29.20,Default,,0,0,0,,Мен не істеуім керек? Егер менде таяқ болмаса, оны дұрыс қоя алмаймын.
Dialogue: 0,0:37:29.79,0:37:32.58,Default,,0,0,0,,Әй, таяқ дегенді қалай түсінесің?
Dialogue: 0,0:37:32.66,0:37:33.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:38.25,0:37:40.30,Default,,0,0,0,,А... міне, болды.
Dialogue: 0,0:38:27.51,0:38:29.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:31.76,0:38:34.18,Default,,0,0,0,,Ах~
Dialogue: 0,0:38:37.19,0:38:39.94,Default,,0,0,0,,Ахх~
Dialogue: 0,0:38:45.65,0:38:46.95,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:38:48.78,0:38:50.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:56.91,0:38:58.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:59.58,0:39:00.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:39:08.84,0:39:10.43,Default,,0,0,0,,Рахмет, ағайын.
Dialogue: 0,0:39:11.01,0:39:12.76,Default,,0,0,0,,Біз бірге бірдеңе істегенде—
Dialogue: 0,0:39:12.85,0:39:16.06,Default,,0,0,0,,Жолдастық сезімін дамытып, достасуға болады.
Dialogue: 0,0:39:16.52,0:39:19.35,Default,,0,0,0,,Сіз қалай ойлайсыз? Мені аздап ұната бастадыңыз ба?
Dialogue: 0,0:39:19.81,0:39:21.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:39:21.94,0:39:22.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:23.32,0:39:24.86,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:39:25.23,0:39:28.78,Default,,0,0,0,,Фуууууууууууууууууууууууу
Dialogue: 0,0:39:39.46,0:39:40.96,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:39:41.12,0:39:42.67,Default,,0,0,0,,Қайтадан қош келдіңіз~
Dialogue: 0,0:39:42.75,0:39:45.05,Default,,0,0,0,,Мен шаршадым~
Dialogue: 0,0:39:45.50,0:39:48.05,Default,,0,0,0,,Мирай-чан, мен саған кеудеңді бірден беремін.
Dialogue: 0,0:39:48.42,0:39:51.22,Default,,0,0,0,,Ах, Хина-сама, оны тастағаның үшін рахмет.
Dialogue: 0,0:39:51.93,0:39:54.05,Default,,0,0,0,,А, мен ұмытып кетіппін!
Dialogue: 0,0:39:56.10,0:39:57.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:58.39,0:40:00.56,Default,,0,0,0,,Сіз қайтып келгеннен кейін кетті ме?
Dialogue: 0,0:40:00.81,0:40:04.31,Default,,0,0,0,,Не? Бұл әзіл мүлдем күлкілі емес.
Dialogue: 0,0:40:04.94,0:40:07.57,Default,,0,0,0,,Құрметті Хина, Кун Чан кетіп қалды.
Dialogue: 0,0:40:07.65,0:40:10.61,Default,,0,0,0,,Не? Кездескенше, Мирай-чан
Dialogue: 0,0:40:10.70,0:40:11.95,Default,,0,0,0,,Мираи-чан?
Dialogue: 0,0:40:12.03,0:40:13.57,Default,,0,0,0,,Және Юкко
Dialogue: 0,0:40:15.70,0:40:20.25,Default,,0,0,0,,Аа, солай, Кун-чан, мен болашақ Мирай-чанды кездестірдім.
Dialogue: 0,0:40:20.58,0:40:22.71,Default,,0,0,0,,Эй, сен не істедің?
Dialogue: 0,0:40:22.79,0:40:25.09,Default,,0,0,0,,Хачи ойыны Хачи?
Dialogue: 0,0:40:25.17,0:40:27.30,Default,,0,0,0,,Сондай-ақ Дарума-сан құлап түсті.
Dialogue: 0,0:40:27.38,0:40:29.51,Default,,0,0,0,,Түсіндім, бұл жақсы.
Dialogue: 0,0:40:29.88,0:40:33.30,Default,,0,0,0,,Әкем де жақында есейген Мирай-чанмен кездескісі келеді.
Dialogue: 0,0:40:34.05,0:40:35.39,Default,,0,0,0,,Сәлем анашым?
Dialogue: 0,0:40:35.80,0:40:37.22,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:40:38.31,0:40:41.52,Default,,0,0,0,,Бірақ, меніңше, анам оны баяу қабылдағаны дұрыс.
Dialogue: 0,0:40:41.60,0:40:44.77,Default,,0,0,0,,Дәл қазір мен әлі сәби Мирай-чанды жақсы көремін.
Dialogue: 0,0:40:45.27,0:40:48.48,Default,,0,0,0,,Кун-чан да Мирай-чан сәбиді қалайды.
Dialogue: 0,0:40:48.78,0:40:50.44,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:40:50.53,0:40:54.07,Default,,0,0,0,,Хм
Dialogue: 0,0:41:04.50,0:41:05.92,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:41:06.00,0:41:07.54,Default,,0,0,0,,Мм, анашым
Dialogue: 0,0:41:07.63,0:41:10.21,Default,,0,0,0,,Жеңіс~ Кун-чан қайда?
Dialogue: 0,0:41:10.30,0:41:13.80,Default,,0,0,0,,Менің құрсағымда Кун-чан осыдан кейін туды.
Dialogue: 0,0:41:13.97,0:41:15.84,Default,,0,0,0,,Ол қандай сәби еді?
Dialogue: 0,0:41:16.05,0:41:17.97,Default,,0,0,0,,Ол қазір Мирай-чанға ұқсайды.
Dialogue: 0,0:41:18.05,0:41:19.22,Default,,0,0,0,,Маған Мирай-чан ұнамайды
Dialogue: 0,0:41:19.31,0:41:21.52,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:41:22.93,0:41:25.02,Default,,0,0,0,,О, бұл ма?
Dialogue: 0,0:41:25.10,0:41:28.19,Default,,0,0,0,,Мм, анашым, сіз әдемісіз!
Dialogue: 0,0:41:28.27,0:41:29.86,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:41:30.15,0:41:31.19,Default,,0,0,0,,Жұқа
Dialogue: 0,0:41:31.28,0:41:32.78,Default,,0,0,0,,Шулы
Dialogue: 0,0:41:33.53,0:41:35.53,Default,,0,0,0,,Осы жерден
Dialogue: 0,0:41:36.32,0:41:39.28,Default,,0,0,0,,Бұл кезде мен әкемді кездестірдім.
Dialogue: 0,0:41:39.74,0:41:41.54,Default,,0,0,0,,Мен жұмысқа кіріскен кезде
Dialogue: 0,0:41:42.04,0:41:43.96,Default,,0,0,0,,Университетті бітіру рәсімі
Dialogue: 0,0:41:44.79,0:41:45.79,Default,,0,0,0,,Орта мектеп
Dialogue: 0,0:41:46.21,0:41:49.00,Default,,0,0,0,,Кіші орта мектеп қазірдің өзінде зұлмат заман
Dialogue: 0,0:41:49.54,0:41:52.17,Default,,0,0,0,,Бастауыш мектеп көңілді болды~
Dialogue: 0,0:41:52.71,0:41:54.09,Default,,0,0,0,,Қабылдау рәсімі
Dialogue: 0,0:41:54.51,0:41:56.68,Default,,0,0,0,,А, мынаны қара, Юичи.
Dialogue: 0,0:41:56.76,0:41:58.01,Default,,0,0,0,,Юичи?
Dialogue: 0,0:41:58.09,0:42:01.64,Default,,0,0,0,,Анаңның інісінің тойын тойладық.
Dialogue: 0,0:42:01.72,0:42:03.10,Default,,0,0,0,,Сендер жақсы дос емессіңдер ме?
Dialogue: 0,0:42:03.18,0:42:04.81,Default,,0,0,0,,Біз жақсы дос болдық.
Dialogue: 0,0:42:04.89,0:42:07.60,Default,,0,0,0,,Олар екі жаста болғандықтан, егіз сияқты болды.
Dialogue: 0,0:42:07.69,0:42:08.69,Default,,0,0,0,,Бұл мысық.
Dialogue: 0,0:42:08.77,0:42:11.86,Default,,0,0,0,,Әй, бұл туған күніне арналған тұлып.
Dialogue: 0,0:42:11.94,0:42:13.78,Default,,0,0,0,,Мен оны үлкен әжемнен алдым.
Dialogue: 0,0:42:13.94,0:42:15.36,Default,,0,0,0,,Кун-чан да ұсынады
Dialogue: 0,0:42:15.45,0:42:16.91,Default,,0,0,0,,Не? неге?
Dialogue: 0,0:42:16.99,0:42:19.24,Default,,0,0,0,,Міне, сенің туған күнің.
Dialogue: 0,0:42:19.32,0:42:21.12,Default,,0,0,0,,Әлі көп жол бар, солай ма?
Dialogue: 0,0:42:21.99,0:42:23.25,Default,,0,0,0,,Мен велосипедті ұнатамын.
Dialogue: 0,0:42:23.33,0:42:25.41,Default,,0,0,0,,Неліктен? Бұл менің туған күнім де емес
Dialogue: 0,0:42:25.50,0:42:27.50,Default,,0,0,0,,Сәлем, велосипед
Dialogue: 0,0:42:27.58,0:42:28.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:29.04,0:42:33.34,Default,,0,0,0,,Ах~ Ах~ Бұл не... қазірдің өзінде?
Dialogue: 0,0:42:34.17,0:42:36.93,Default,,0,0,0,,Мен оны жаңа ғана тазаласам да.
Dialogue: 0,0:42:37.51,0:42:38.93,Default,,0,0,0,,Маған бұл түс ұнайды
Dialogue: 0,0:42:39.01,0:42:41.51,Default,,0,0,0,,Әже келеді, сондықтан жинаңыз.
Dialogue: 0,0:42:41.60,0:42:42.72,Default,,0,0,0,,Бұл түс өте әдемі
Dialogue: 0,0:42:42.81,0:42:43.93,Default,,0,0,0,,Эй, Кун-чан!
Dialogue: 0,0:42:44.35,0:42:45.85,Default,,0,0,0,,Әкеммен бірге жинастыру
Dialogue: 0,0:42:45.93,0:42:47.48,Default,,0,0,0,,Мен бүгін жұмыста емеспін.
Dialogue: 0,0:42:47.56,0:42:48.94,Default,,0,0,0,,Сонда сіз мұны істей алмайсыз ба?
Dialogue: 0,0:42:49.02,0:42:51.27,Default,,0,0,0,,Тазаланбайтынның бәрін лақтырып тастаймын!
Dialogue: 0,0:42:51.77,0:42:52.77,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:42:52.86,0:42:55.36,Default,,0,0,0,,Онда мен саған енді ештеңе сатып алмаймын.
Dialogue: 0,0:42:55.44,0:42:57.65,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:42:57.74,0:42:58.99,Default,,0,0,0,,Содан кейін оны тазалаңыз!
Dialogue: 0,0:42:59.07,0:43:02.37,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:43:03.70,0:43:06.83,Default,,0,0,0,,Ха... Мен тағы ашуландым.
Dialogue: 0,0:43:07.33,0:43:09.21,Default,,0,0,0,,Маған Мираи-чан ұнамайды!
Dialogue: 0,0:43:09.29,0:43:12.21,Default,,0,0,0,,Жоқ, мені ұрмаңыз! Сен маған тіл табысасың деп тұрсың ғой, солай ма?
Dialogue: 0,0:43:12.29,0:43:13.92,Default,,0,0,0,,(домофон қоңырауы)
Dialogue: 0,0:43:14.00,0:43:16.17,Default,,0,0,0,,Әже осында.
Dialogue: 0,0:43:26.47,0:43:29.19,Default,,0,0,0,,Мені күт, мен қайтамын.
Dialogue: 0,0:43:29.56,0:43:31.65,Default,,0,0,0,,(домофон қоңырауы)
Dialogue: 0,0:43:31.73,0:43:33.69,Default,,0,0,0,,Иә Иә Иә
Dialogue: 0,0:43:36.82,0:43:38.11,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:43:48.58,0:43:50.17,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:43:53.63,0:43:56.55,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:43:57.67,0:44:00.68,Default,,0,0,0,,Онибаба! Анамның Онибаба!
Dialogue: 0,0:44:00.76,0:44:03.43,Default,,0,0,0,,Маған сенің анаң ұнамайды!
Dialogue: 0,0:44:06.81,0:44:08.18,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:44:08.27,0:44:10.64,Default,,0,0,0,,(судағы көпіршіктердің дыбысы)
Dialogue: 0,0:44:42.47,0:44:43.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:45.51,0:44:47.31,Default,,0,0,0,,«Маған ұнамайды», солай ма?
Dialogue: 0,0:44:47.97,0:44:50.68,Default,,0,0,0,,Ах... Болашақ Мираи-чан
Dialogue: 0,0:44:50.77,0:44:55.02,Default,,0,0,0,,Ал аға, сен мені Шинкансенмен тағы ұрмақ болдың.
Dialogue: 0,0:44:55.56,0:44:57.02,Default,,0,0,0,,Бұл Шинкансен емес
Dialogue: 0,0:44:57.44,0:44:59.98,Default,,0,0,0,,Шинкансен адамдарды ұруға арналмаған.
Dialogue: 0,0:45:00.32,0:45:01.65,Default,,0,0,0,,Super Azusadamon
Dialogue: 0,0:45:01.74,0:45:03.36,Default,,0,0,0,,Екеуі де жақсы!
Dialogue: 0,0:45:03.95,0:45:07.58,Default,,0,0,0,,Әй, анаңды неге жақсы көрмейсің?
Dialogue: 0,0:45:08.16,0:45:09.87,Default,,0,0,0,,Мен оған қамқорлық жасай алмаймын.
Dialogue: 0,0:45:09.95,0:45:11.87,Default,,0,0,0,,Бұл сирек демалыс күні болса да...
Dialogue: 0,0:45:11.96,0:45:14.75,Default,,0,0,0,,Маған жамандық жасап, пәле жасасаң, өкініш болмай ма?
Dialogue: 0,0:45:16.79,0:45:18.38,Default,,0,0,0,,Сәлем бауырым
Dialogue: 0,0:45:18.50,0:45:20.67,Default,,0,0,0,,Кун-чан, ол сүйкімді емес пе?
Dialogue: 0,0:45:20.76,0:45:21.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:23.84,0:45:26.76,Default,,0,0,0,,Мираи-чан мен Юкко сүйкімді
Dialogue: 0,0:45:28.76,0:45:31.52,Default,,0,0,0,,Бірақ Кун Чан сүйкімді емес
Dialogue: 0,0:45:32.14,0:45:35.69,Default,,0,0,0,,А... ә...
Dialogue: 0,0:45:36.10,0:45:39.15,Default,,0,0,0,,Бұл дұрыс емес, аға, сүйкімді екенсіз.
Dialogue: 0,0:45:39.23,0:45:41.32,Default,,0,0,0,,Жоқ, сүйкімді емес.
Dialogue: 0,0:45:41.40,0:45:44.11,Default,,0,0,0,,Сүйкімді, сондықтан...
Dialogue: 0,0:45:44.36,0:45:46.66,Default,,0,0,0,,Сол жігіт осы сапарға қосыла алмайды!
Dialogue: 0,0:45:47.16,0:45:48.45,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:45:48.53,0:45:49.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:50.41,0:45:51.87,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:45:53.79,0:45:56.67,Default,,0,0,0,,(Кун Чанның жылағаны)
Dialogue: 0,0:46:19.31,0:46:21.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:46:23.74,0:46:24.74,Default,,0,0,0,,Буруруру
Dialogue: 0,0:46:26.03,0:46:28.20,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:46:29.20,0:46:30.95,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:46:37.00,0:46:41.75,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:46:54.72,0:47:00.69,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:47:02.02,0:47:03.78,Default,,0,0,0,,Не қайғылы?
Dialogue: 0,0:47:08.78,0:47:11.49,Default,,0,0,0,,Жарайды, жарайды, жылама...
Dialogue: 0,0:47:19.83,0:47:22.38,Default,,0,0,0,,Рахмет, сіз өте мейірімдісіз.
Dialogue: 0,0:47:22.46,0:47:23.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:24.17,0:47:27.13,Default,,0,0,0,,Бірақ мен шынымен жыламадым.
Dialogue: 0,0:47:28.84,0:47:31.93,Default,,0,0,0,,Хат жазғанда біраз эмоцияға бергенім дұрыс деп ойладым.
Dialogue: 0,0:47:32.30,0:47:33.35,Default,,0,0,0,,Хехе
Dialogue: 0,0:48:02.33,0:48:03.84,Default,,0,0,0,,Сіз не жаздыңыз?
Dialogue: 0,0:48:04.21,0:48:05.38,Default,,0,0,0,,«Әжеге –
Dialogue: 0,0:48:05.46,0:48:08.42,Default,,0,0,0,,Мысық тырнағысы келеді, кешіріңізші».
Dialogue: 0,0:48:08.51,0:48:09.55,Default,,0,0,0,,Мысық…
Dialogue: 0,0:48:10.09,0:48:14.85,Default,,0,0,0,,Жануарларға ұнайтын мінезім бар, кез келген баламен оңай тіл табысып кетемін.
Dialogue: 0,0:48:15.26,0:48:16.39,Default,,0,0,0,,Бірақ әже
Dialogue: 0,0:48:16.47,0:48:19.14,Default,,0,0,0,,Менің жануарларға аллергиям бар, сондықтан оған рұқсат етілмейді.
Dialogue: 0,0:48:19.48,0:48:21.64,Default,,0,0,0,,Үй жануарын ұстағыңыз келсе, оны сыртта ұстаңыз.
Dialogue: 0,0:48:21.98,0:48:24.61,Default,,0,0,0,,Бірақ сыртта мал ұстайтын үйлер жоқ.
Dialogue: 0,0:48:25.06,0:48:28.90,Default,,0,0,0,,Сондықтан мен рұқсат алғанша ондаған хат жаза беремін.
Dialogue: 0,0:48:29.40,0:48:32.91,Default,,0,0,0,,Әжемнің жүйкесі жұқарғанша мен тоқтамаймын.
Dialogue: 0,0:48:34.32,0:48:36.28,Default,,0,0,0,,(мысықтардың дауысы)
Dialogue: 0,0:48:36.83,0:48:39.54,Default,,0,0,0,,Жарайды, жарайды, жүр.
Dialogue: 0,0:48:40.46,0:48:43.08,Default,,0,0,0,,Қорықпа, дос болайық?
Dialogue: 0,0:48:43.17,0:48:45.00,Default,,0,0,0,,(қорқытатын айқай)
Dialogue: 0,0:48:45.75,0:48:51.17,Default,,0,0,0,,(мысықтың мияулап, кетіп бара жатқан дыбысы)
Dialogue: 0,0:48:55.30,0:48:57.43,Default,,0,0,0,,Сенің бауырларың бар ма? Бар
Dialogue: 0,0:48:57.51,0:48:58.51,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:48:58.60,0:49:01.10,Default,,0,0,0,,Қарындас (қыз) Мен інімін
Dialogue: 0,0:49:01.60,0:49:04.23,Default,,0,0,0,,Өйткені сен менен жақсы оқи алмайсың және әлсізсің.
Dialogue: 0,0:49:04.31,0:49:06.31,Default,,0,0,0,,Бірден жылап жіберді
Dialogue: 0,0:49:06.81,0:49:09.86,Default,,0,0,0,,Сондықтан анам мені ағамнан жақсы көреді.
Dialogue: 0,0:49:10.53,0:49:12.15,Default,,0,0,0,,Әже жақсы болмаса да...
Dialogue: 0,0:49:12.24,0:49:15.78,Default,,0,0,0,,Сенің анаң мысық ұстайтынына сенімдімін, солай ма?
Dialogue: 0,0:49:17.91,0:49:22.16,Default,,0,0,0,,Аа, інім жылап тұрғанына өте қуаныштымын.
Dialogue: 0,0:49:24.54,0:49:25.54,Default,,0,0,0,,♪~
Dialogue: 0,0:49:36.55,0:49:37.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:42.23,0:49:44.44,Default,,0,0,0,,(шу)
Dialogue: 0,0:49:45.90,0:49:47.94,Default,,0,0,0,,Ағаңның ойыншықтарымен ойнауға болады.
Dialogue: 0,0:49:52.78,0:49:54.57,Default,,0,0,0,,Бірақ саған ұрыспайсың ба?
Dialogue: 0,0:49:55.07,0:49:58.41,Default,,0,0,0,,Себебі, ол лас болғанда қызық болады.
Dialogue: 0,0:50:03.96,0:50:05.29,Default,,0,0,0,,Расында!
Dialogue: 0,0:50:05.37,0:50:06.54,Default,,0,0,0,,Қарныңыз ашты ма?
Dialogue: 0,0:50:19.26,0:50:20.60,Default,,0,0,0,,Сіз де жеуге болады.
Dialogue: 0,0:50:20.85,0:50:22.89,Default,,0,0,0,,Бірақ саған ұрыспайсың ба?
Dialogue: 0,0:50:24.02,0:50:26.94,Default,,0,0,0,,Себебі, оны лас жегенде дәмді болады.
Dialogue: 0,0:50:40.74,0:50:41.91,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:50:41.99,0:50:43.87,Default,,0,0,0,,Дұрыс? дәмді!
Dialogue: 0,0:50:43.95,0:50:44.95,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:50:45.04,0:50:46.33,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:50:46.41,0:50:50.17,Default,,0,0,0,,Ахахха вахахаха
Dialogue: 0,0:50:54.92,0:50:57.30,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:50:57.47,0:50:59.01,Default,,0,0,0,,Сонда бұл туралы не деуге болады?
Dialogue: 0,0:51:02.05,0:51:03.47,Default,,0,0,0,,Бұл қызық!
Dialogue: 0,0:51:06.43,0:51:07.85,Default,,0,0,0,,Сонда бұл туралы не деуге болады?
Dialogue: 0,0:51:08.60,0:51:09.65,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:51:11.98,0:51:13.15,Default,,0,0,0,,Қызық!
Dialogue: 0,0:51:13.61,0:51:20.62,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:51:22.33,0:51:26.70,Default,,0,0,0,,(құлаған заттардың немесе бөтелкелердің бір-біріне соқтығысуы)
Dialogue: 0,0:51:29.71,0:51:31.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:36.34,0:51:37.72,Default,,0,0,0,,Бұл анам...
Dialogue: 0,0:51:37.97,0:51:40.13,Default,,0,0,0,,Мен не істеуім керек? Мен ашуланамын...
Dialogue: 0,0:51:45.22,0:51:46.52,Default,,0,0,0,,Қазір үйге қайт
Dialogue: 0,0:51:53.44,0:51:57.36,Default,,0,0,0,,Сенгісіз! Бұндай тәртіпсіздік жасау дегенді қалай түсінесіңдер?
Dialogue: 0,0:51:57.44,0:51:58.49,Default,,0,0,0,,(Қыздың жылауы)
Dialogue: 0,0:51:58.57,0:52:02.32,Default,,0,0,0,,Мен қазірдің өзінде жынданып кеттім! Мен сіздің барлық ойыншықтарыңызды лақтырып тастаймын!
Dialogue: 0,0:52:03.16,0:52:05.70,Default,,0,0,0,,Анашым, кешіріңіз!
Dialogue: 0,0:52:06.12,0:52:11.00,Default,,0,0,0,,(Қыздың жылауы)
Dialogue: 0,0:52:11.37,0:52:14.09,Default,,0,0,0,,Мен саған енді ешқашан тәтті сатып алмаймын!
Dialogue: 0,0:52:14.17,0:52:18.67,Default,,0,0,0,,Кешіріңіз! Анашым, кешіріңіз!
Dialogue: 0,0:52:34.27,0:52:41.03,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:52:41.78,0:52:43.03,Default,,0,0,0,,Кешкі ас ше?
Dialogue: 0,0:52:43.70,0:52:47.33,Default,,0,0,0,,Мен оянбаймын... Кун-чан менің қазынам
Dialogue: 0,0:52:51.08,0:52:53.92,Default,,0,0,0,,Бұл менің ескі жолым, солай ма?
Dialogue: 0,0:52:54.00,0:52:55.88,Default,,0,0,0,,Енді менің желісім
Dialogue: 0,0:52:56.00,0:52:57.67,Default,,0,0,0,,(Әжемнің күлкісі)
Dialogue: 0,0:52:58.75,0:53:02.05,Default,,0,0,0,,Соңында мысық ала алмағаныма қынжылдым.
Dialogue: 0,0:53:02.13,0:53:03.68,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:53:03.76,0:53:07.89,Default,,0,0,0,,Мен өзімді Юичиден де жақсы көретінмін деп ойладым.
Dialogue: 0,0:53:07.97,0:53:11.48,Default,,0,0,0,,Көбірек көңіл бөлуді қажет ететін балаларды ата-анасы жақсы көретінін білмедім.
Dialogue: 0,0:53:11.56,0:53:13.94,Default,,0,0,0,,Тіпті көп жұмыс жасадың.
Dialogue: 0,0:53:14.35,0:53:17.27,Default,,0,0,0,,Қыңыр және қиын
Dialogue: 0,0:53:17.36,0:53:20.28,Default,,0,0,0,,Менің есімде қалғаны айғайлап, айқайлау болды.
Dialogue: 0,0:53:20.36,0:53:21.53,Default,,0,0,0,,Көк, көк…
Dialogue: 0,0:53:21.61,0:53:23.57,Default,,0,0,0,,Әрқашан бейберекет.
Dialogue: 0,0:53:23.95,0:53:27.91,Default,,0,0,0,,Мен үйленгеннен кейін ғана үй жинауды үйрендім.
Dialogue: 0,0:53:28.45,0:53:30.08,Default,,0,0,0,,Таң қалды
Dialogue: 0,0:53:33.16,0:53:34.92,Default,,0,0,0,,Тіпті жұмыс істегенде де—
Dialogue: 0,0:53:35.00,0:53:38.42,Default,,0,0,0,,Балаларымды тәрбиелеуде қолымнан келгеннің бәрін жасауға тырысамын.
Dialogue: 0,0:53:39.17,0:53:42.42,Default,,0,0,0,,Бірақ мен мұны түсінгенде, мен жай ғана ашуландым.
Dialogue: 0,0:53:42.80,0:53:46.30,Default,,0,0,0,,«Осындай ана болғаным дұрыс па?» деп уайымдай бастадым.
Dialogue: 0,0:53:49.47,0:53:53.31,Default,,0,0,0,,Бірақ мен сенің кішкене болса да бақытты болғаныңды қалаймын...
Dialogue: 0,0:53:54.06,0:53:59.48,Default,,0,0,0,,Бала тәрбиесінде тілек маңызды екенін білу керек.
Dialogue: 0,0:54:02.86,0:54:05.40,Default,,0,0,0,,Тілек...?
Dialogue: 0,0:54:06.03,0:54:09.03,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:54:09.12,0:54:10.16,Default,,0,0,0,,Фалько…
Dialogue: 0,0:54:21.38,0:54:23.21,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:54:28.05,0:54:32.72,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:54:32.81,0:54:38.31,Default,,0,0,0,,(пойыздың жүру дыбысы)
Dialogue: 0,0:54:48.66,0:54:52.91,Default,,0,0,0,,Әріпті ананың орнына қою қандай тамаша.
Dialogue: 0,0:54:53.24,0:54:57.87,Default,,0,0,0,,Мұны қайдан білдіңіз? Әкем де жасап көруі керек шығар.
Dialogue: 0,0:54:58.12,0:54:59.13,Default,,0,0,0,,Ах~
Dialogue: 0,0:54:59.21,0:55:00.75,Default,,0,0,0,,Иә иә Мираи-чан
Dialogue: 0,0:55:01.25,0:55:03.75,Default,,0,0,0,,Хмм, баа!
Dialogue: 0,0:55:04.13,0:55:06.42,Default,,0,0,0,,Ум, балам!
Dialogue: 0,0:55:06.63,0:55:08.88,Default,,0,0,0,,Хмм бахаха~!
Dialogue: 0,0:55:09.09,0:55:10.47,Default,,0,0,0,,Ах
Dialogue: 0,0:55:10.89,0:55:13.31,Default,,0,0,0,,Сіз мүлде күлмейсіз...
Dialogue: 0,0:55:15.85,0:55:21.44,Default,,0,0,0,,(Балалардың жанды дауыстары)
Dialogue: 0,0:55:27.11,0:55:29.45,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,0:55:29.53,0:55:30.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:55:34.12,0:55:36.00,Default,,0,0,0,,Не? Сіз шынымен жаттығу дөңгелектерін қолданғыңыз келе ме?
Dialogue: 0,0:55:36.08,0:55:36.95,Default,,0,0,0,,Иә
Dialogue: 0,0:55:37.04,0:55:38.66,Default,,0,0,0,,Қазір бастайсыз ба? Иә
Dialogue: 0,0:55:38.75,0:55:40.75,Default,,0,0,0,,Сонымен, атпен жүру үшін жаттығуды қалайсыз ба?
Dialogue: 0,0:55:40.83,0:55:41.92,Default,,0,0,0,,Иә
Dialogue: 0,0:55:43.04,0:55:44.46,Default,,0,0,0,,Шынымен, шынымен бе?
Dialogue: 0,0:55:44.55,0:55:45.76,Default,,0,0,0,,Иә
Dialogue: 0,0:55:58.77,0:56:00.64,Default,,0,0,0,,Кун-чан, айтшы
Dialogue: 0,0:56:00.73,0:56:06.61,Default,,0,0,0,,Жарайды, аяқты педальға қойып, қатты бассаң, алға жылжиды...
Dialogue: 0,0:56:06.69,0:56:08.78,Default,,0,0,0,,А, күте тұрыңыз! Ах!
Dialogue: 0,0:56:09.90,0:56:10.91,Default,,0,0,0,,Ах
Dialogue: 0,0:56:10.99,0:56:12.28,Default,,0,0,0,,Жарайсың.
Dialogue: 0,0:56:12.36,0:56:13.82,Default,,0,0,0,,Онда кеттік!
Dialogue: 0,0:56:14.66,0:56:17.62,Default,,0,0,0,,Жарайды, міне, мұнда, жарайды, жарайды! Әй, Әйте!
Dialogue: 0,0:56:18.45,0:56:19.50,Default,,0,0,0,,Ауырмайды ма?
Dialogue: 0,0:56:19.58,0:56:22.17,Default,,0,0,0,,Ой!
Dialogue: 0,0:56:24.13,0:56:27.09,Default,,0,0,0,,Оңға солға оңға! Иә, оңға, солға, оңға!
Dialogue: 0,0:56:27.17,0:56:28.17,Default,,0,0,0,,Иә! Ittete…
Dialogue: 0,0:56:29.30,0:56:32.13,Default,,0,0,0,,Оң солға! Оңға солға! иә! Ой...
Dialogue: 0,0:56:32.89,0:56:34.05,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:56:34.51,0:56:37.68,Default,,0,0,0,,Әй, велосипед қорқынышты!
Dialogue: 0,0:56:37.77,0:56:39.35,Default,,0,0,0,,Жылама Жылама
Dialogue: 0,0:56:39.43,0:56:41.77,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:56:41.85,0:56:44.11,Default,,0,0,0,,Бұл сіздің бірінші рет мініп отырсыз ба?
Dialogue: 0,0:56:44.19,0:56:45.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:45.77,0:56:47.40,Default,,0,0,0,,Сіз жаттығу жасайсыз ба?
Dialogue: 0,0:56:47.48,0:56:49.57,Default,,0,0,0,,Айтайын ба? (4-бала) Бұл оңай.
Dialogue: 0,0:56:49.65,0:56:51.20,Default,,0,0,0,,(Мираи-чанның жылауы)
Dialogue: 0,0:56:51.28,0:56:52.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:52.82,0:56:55.45,Default,,0,0,0,,Олай болса, ағаларыңның саған сабақ бергенін қалайсың ба?
Dialogue: 0,0:56:55.99,0:56:57.58,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:56:57.66,0:56:58.70,Default,,0,0,0,,Әке!
Dialogue: 0,0:57:03.96,0:57:05.88,Default,,0,0,0,,Аа... Кешіріңіз, шынымен.
Dialogue: 0,0:57:06.38,0:57:08.84,Default,,0,0,0,,Жерді тепкілеп көріңіз.
Dialogue: 0,0:57:09.09,0:57:10.92,Default,,0,0,0,,Импульсті және жүзуді құру
Dialogue: 0,0:57:11.01,0:57:12.09,Default,,0,0,0,,Алдыңғы шығыңыз!
Dialogue: 0,0:57:12.17,0:57:13.63,Default,,0,0,0,,Мен сені сыртта күтемін.
Dialogue: 0,0:57:13.72,0:57:15.76,Default,,0,0,0,,Жарайды, маған ер!
Dialogue: 0,0:57:16.76,0:57:17.76,Default,,0,0,0,,А...
Dialogue: 0,0:57:18.51,0:57:20.60,Default,,0,0,0,,Жақсы, жақсы (әйел) Өте сүйкімді
Dialogue: 0,0:57:21.23,0:57:23.02,Default,,0,0,0,,Әке...
Dialogue: 0,0:57:24.10,0:57:25.44,Default,,0,0,0,,Әке...
Dialogue: 0,0:57:27.44,0:57:28.77,Default,,0,0,0,,Иә? не болды?
Dialogue: 0,0:57:28.86,0:57:29.98,Default,,0,0,0,,Қызу!
Dialogue: 0,0:57:30.61,0:57:32.19,Default,,0,0,0,,7 ай болды.
Dialogue: 0,0:57:32.99,0:57:35.61,Default,,0,0,0,,Ах! Мен жылап жатырмын! (3-бала) Иә? Шынайы ма?
Dialogue: 0,0:57:35.78,0:57:37.41,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:57:37.91,0:57:40.41,Default,,0,0,0,,Әке!
Dialogue: 0,0:57:41.20,0:57:43.08,Default,,0,0,0,,Әке!
Dialogue: 0,0:57:43.16,0:57:45.58,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:57:46.42,0:57:48.96,Default,,0,0,0,,Кешіріңіз, қайта атқа мінейік.
Dialogue: 0,0:57:49.04,0:57:50.92,Default,,0,0,0,,Мен енді велосипед айдамаймын!
Dialogue: 0,0:57:51.21,0:57:53.84,Default,,0,0,0,,Әр нәрсенің басы бар.
Dialogue: 0,0:57:53.92,0:57:56.39,Default,,0,0,0,,Бұл ештеңе емес! қазірдің өзінде!
Dialogue: 0,0:57:56.97,0:57:58.26,Default,,0,0,0,,О Кун Чан
Dialogue: 0,0:57:58.35,0:58:01.27,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:58:01.77,0:58:02.77,Default,,0,0,0,,Хааа~
Dialogue: 0,0:58:04.44,0:58:07.19,Default,,0,0,0,,Ах~ Ах!
Dialogue: 0,0:58:07.35,0:58:10.36,Default,,0,0,0,,Иә? Бұл менің үлкен атам.
Dialogue: 0,0:58:10.44,0:58:11.65,Default,,0,0,0,,Ах~
Dialogue: 0,0:58:14.28,0:58:17.32,Default,,0,0,0,,Әке, сіз маған ұнамайсыз!
Dialogue: 0,0:58:21.49,0:58:22.75,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:58:22.83,0:58:28.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:44.68,0:58:46.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:53.61,0:59:00.62,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:59:17.05,0:59:17.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:59:21.47,0:59:22.68,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:59:22.76,0:59:24.72,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:59:27.85,0:59:29.06,Default,,0,0,0,,Бұл жігіт сізді қызықтырады ма?
Dialogue: 0,0:59:29.14,0:59:30.15,Default,,0,0,0,,Жоқ
Dialogue: 0,0:59:30.23,0:59:31.94,Default,,0,0,0,,Сіз мінгіңіз келе ме? Уф
Dialogue: 0,0:59:32.02,0:59:33.94,Default,,0,0,0,,Ұялудың қажеті жоқ, жоқ...
Dialogue: 0,0:59:34.02,0:59:36.15,Default,,0,0,0,,Сіз оны шынымен айдауыңыз керек, солай ма? Уф
Dialogue: 0,0:59:37.03,0:59:41.49,Default,,0,0,0,,Не, сен міне алмайсың ба? Әттең.
Dialogue: 0,0:59:41.57,0:59:44.16,Default,,0,0,0,,Әр нәрсенің басы бар.
Dialogue: 0,0:59:44.24,0:59:45.87,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:59:46.66,0:59:51.04,Default,,0,0,0,,Иә, «бастамасы бар» дейсіз бе?
Dialogue: 0,0:59:53.00,0:59:59.93,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,1:00:15.82,1:00:17.69,Default,,0,0,0,,Аяқ... (Жас жігіт) А?
Dialogue: 0,1:00:17.78,1:00:19.32,Default,,0,0,0,,Сіздің аяғыңыз ауырады ма?
Dialogue: 0,1:00:19.40,1:00:21.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:00:22.03,1:00:25.87,Default,,0,0,0,,Соғыс кезінде мен мінген кеме аударылып, осылай аяқталды.
Dialogue: 0,1:00:27.20,1:00:31.46,Default,,0,0,0,,Бірақ бір рет үйреніп алсаңыз, бұл сіз күткендей ыңғайсыз емес.
Dialogue: 0,1:00:41.88,1:00:43.72,Default,,0,0,0,,О, кір!
Dialogue: 0,1:00:45.55,1:00:48.89,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,1:00:48.97,1:00:50.81,Default,,0,0,0,,Бірінші рет көру
Dialogue: 0,1:00:50.98,1:00:53.60,Default,,0,0,0,,Ха, бірінші рет болып тұрсың ба?
Dialogue: 0,1:00:55.77,1:00:57.52,Default,,0,0,0,,Жылқы? Иә
Dialogue: 0,1:00:57.61,1:00:59.28,Default,,0,0,0,,Не көріп тұрсың? Иә
Dialogue: 0,1:00:59.36,1:01:01.07,Default,,0,0,0,,Шынымен бе? Иә
Dialogue: 0,1:01:01.40,1:01:03.82,Default,,0,0,0,,Хмм.
Dialogue: 0,1:01:04.87,1:01:07.58,Default,,0,0,0,,А, мұнда біреу бар ма?
Dialogue: 0,1:01:07.87,1:01:08.91,Default,,0,0,0,,Иә
Dialogue: 0,1:01:08.99,1:01:10.33,Default,,0,0,0,,Мен ат киімін сұрай аламын ба?
Dialogue: 0,1:01:10.41,1:01:11.41,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,1:01:11.50,1:01:12.96,Default,,0,0,0,,Қазір дайын
Dialogue: 0,1:01:15.29,1:01:16.88,Default,,0,0,0,,Саған қиын болғанына сенімдімін.
Dialogue: 0,1:01:18.00,1:01:21.63,Default,,0,0,0,,Ola aura aura yoiyoitto
Dialogue: 0,1:01:21.72,1:01:23.97,Default,,0,0,0,,О, уау, бұл керемет!
Dialogue: 0,1:01:27.10,1:01:29.43,Default,,0,0,0,,О! иә? Мен алмаймын...
Dialogue: 0,1:01:29.52,1:01:30.52,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:36.94,1:01:38.15,Default,,0,0,0,,Әке!
Dialogue: 0,1:01:38.86,1:01:40.69,Default,,0,0,0,,Әке!
Dialogue: 0,1:01:41.15,1:01:43.03,Default,,0,0,0,,Әке? Мен?
Dialogue: 0,1:01:43.28,1:01:44.36,Default,,0,0,0,,Уау~
Dialogue: 0,1:01:46.70,1:01:50.12,Default,,0,0,0,,Қорықпа. Сен қорықсаң, аттар да қорқады.
Dialogue: 0,1:01:50.74,1:01:52.00,Default,,0,0,0,,Кеттік
Dialogue: 0,1:01:57.13,1:02:01.80,Default,,0,0,0,,Жылқылар енді бізден қорықпайды, олар бізді қабылдады.
Dialogue: 0,1:02:02.55,1:02:03.92,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,1:02:04.47,1:02:05.63,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:02:05.72,1:02:07.80,Default,,0,0,0,,Алға қара
Dialogue: 0,1:02:08.30,1:02:12.72,Default,,0,0,0,,Төменге қарама, тек алысқа қара
Dialogue: 0,1:02:25.90,1:02:26.91,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:29.37,1:02:30.66,Default,,0,0,0,,Бұл...
Dialogue: 0,1:02:30.99,1:02:34.37,Default,,0,0,0,,Не? Бұл қорқынышты емес
Dialogue: 0,1:02:34.46,1:02:35.46,Default,,0,0,0,,Иә
Dialogue: 0,1:02:35.75,1:02:36.79,Default,,0,0,0,,Хехе
Dialogue: 0,1:02:37.79,1:02:39.38,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:50.47,1:02:51.97,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,1:02:52.81,1:02:53.93,Default,,0,0,0,,Алысты көру
Dialogue: 0,1:02:57.48,1:03:00.31,Default,,0,0,0,,Жарайды, тездетейік.
Dialogue: 0,1:03:07.70,1:03:14.70,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,1:03:25.63,1:03:30.01,Default,,0,0,0,,Асуко Мен бұрын жұмыс істеген ұшақ компаниясы.
Dialogue: 0,1:03:47.15,1:03:48.36,Default,,0,0,0,,Сіз әлі қорқасыз ба?
Dialogue: 0,1:03:49.24,1:03:50.57,Default,,0,0,0,,Мен қорықпаймын...
Dialogue: 0,1:03:50.66,1:03:52.95,Default,,0,0,0,,Сіз көкжиекті көре аласыз ба?
Dialogue: 0,1:03:53.08,1:03:54.33,Default,,0,0,0,,Мен оларды көріп тұрмын
Dialogue: 0,1:04:19.94,1:04:21.14,Default,,0,0,0,,Кеме!
Dialogue: 0,1:04:23.69,1:04:27.23,Default,,0,0,0,,Айла кез келген көлікке бірдей.
Dialogue: 0,1:04:27.69,1:04:31.03,Default,,0,0,0,,Біреуіне мінсе, кез келген нәрсені мінуге болады.
Dialogue: 0,1:04:31.91,1:04:35.87,Default,,0,0,0,,Жылқылар, кемелер, ұшақтар...
Dialogue: 0,1:04:43.83,1:04:45.09,Default,,0,0,0,,Әке
Dialogue: 0,1:04:45.38,1:04:46.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:46.75,1:04:47.84,Default,,0,0,0,,Тамаша, салқын таң, иә?
Dialogue: 0,1:04:47.92,1:04:51.63,Default,,0,0,0,,Дұрыс, мен мұны жасадым.
Dialogue: 0,1:04:51.72,1:04:52.72,Default,,0,0,0,,Жоқ
Dialogue: 0,1:05:00.14,1:05:01.94,Default,,0,0,0,,Хе хехе
Dialogue: 0,1:05:24.37,1:05:25.63,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,1:05:26.08,1:05:29.17,Default,,0,0,0,,Неліктен осындай маңызды құжатты шығаруды ұмытып кетесіз?
Dialogue: 0,1:05:29.38,1:05:31.21,Default,,0,0,0,,Сондықтан кешіріңіз~
Dialogue: 0,1:05:31.34,1:05:33.59,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,1:05:34.47,1:05:36.93,Default,,0,0,0,,Бұлай ашуланба~
Dialogue: 0,1:05:37.64,1:05:38.72,Default,,0,0,0,,Әке
Dialogue: 0,1:05:39.68,1:05:40.77,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,1:05:40.85,1:05:43.14,Default,,0,0,0,,Не, Кун-чан, бұл құрмет пе?
Dialogue: 0,1:05:43.31,1:05:44.77,Default,,0,0,0,,Мен саябаққа барамын
Dialogue: 0,1:05:44.85,1:05:46.02,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:46.10,1:05:48.69,Default,,0,0,0,,Мен велосипед тебемін, иә?
Dialogue: 0,1:05:49.02,1:05:50.15,Default,,0,0,0,,Міне!
Dialogue: 0,1:05:52.40,1:05:54.57,Default,,0,0,0,,Жалғыз болған дұрыс па?
Dialogue: 0,1:05:54.70,1:05:56.07,Default,,0,0,0,,Жарайды
Dialogue: 0,1:06:01.58,1:06:02.58,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,1:06:05.79,1:06:06.79,Default,,0,0,0,,Уф
Dialogue: 0,1:06:08.63,1:06:09.63,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:09.71,1:06:10.71,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:06:17.22,1:06:18.22,Default,,0,0,0,,Уф
Dialogue: 0,1:06:22.10,1:06:23.10,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:24.02,1:06:25.23,Default,,0,0,0,,Кун-чанға сәттілік!
Dialogue: 0,1:06:27.94,1:06:30.40,Default,,0,0,0,,Алыста… алыс…
Dialogue: 0,1:06:33.15,1:06:35.90,Default,,0,0,0,,А-а-а-а-а!
Dialogue: 0,1:06:35.99,1:06:37.11,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:39.87,1:06:42.70,Default,,0,0,0,,А, а... ха
Dialogue: 0,1:06:43.20,1:06:47.04,Default,,0,0,0,,Ах! Алыс... Алыс...
Dialogue: 0,1:06:56.09,1:06:57.76,Default,,0,0,0,,О! таңқаларлық!
Dialogue: 0,1:06:58.47,1:07:03.14,Default,,0,0,0,,Ууууу... аа аааа...
Dialogue: 0,1:07:03.60,1:07:06.89,Default,,0,0,0,,Ааа... ааа
Dialogue: 0,1:07:08.06,1:07:09.65,Default,,0,0,0,,Керемет! таңқаларлық!
Dialogue: 0,1:07:09.73,1:07:13.32,Default,,0,0,0,,Ааааааааааааааааааааааааааааа
Dialogue: 0,1:07:22.08,1:07:23.66,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:23.74,1:07:27.83,Default,,0,0,0,,Кун Чан жасады! Мен оны істедім!
Dialogue: 0,1:07:32.50,1:07:34.17,Default,,0,0,0,,Мен оны оңай міндім.
Dialogue: 0,1:07:34.25,1:07:35.42,Default,,0,0,0,,Оңай, солай ма?
Dialogue: 0,1:07:35.51,1:07:37.97,Default,,0,0,0,,Ойнайық (4-бала) Бірге барайық.
Dialogue: 0,1:07:38.05,1:07:40.55,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:47.81,1:07:48.85,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:50.40,1:07:53.82,Default,,0,0,0,,Керемет Кун Чан, ғажап!
Dialogue: 0,1:07:54.52,1:07:58.15,Default,,0,0,0,,Кун-чан, мен көп еңбек еттім, өйткені әкем мені қолдады.
Dialogue: 0,1:07:58.61,1:08:00.20,Default,,0,0,0,,«Ол менің кім екенімді де білмейді»
Dialogue: 0,1:08:00.28,1:08:01.70,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:08:03.78,1:08:08.16,Default,,0,0,0,,(Кун-чан ызылдаған)
Dialogue: 0,1:08:12.04,1:08:14.17,Default,,0,0,0,,Балалар керемет.
Dialogue: 0,1:08:14.84,1:08:16.76,Default,,0,0,0,,Маған мұны ешкім үйретпесе де...
Dialogue: 0,1:08:16.84,1:08:19.67,Default,,0,0,0,,Кенеттен сіз мұны істей аласыз.
Dialogue: 0,1:08:19.76,1:08:20.88,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,1:08:21.22,1:08:24.55,Default,,0,0,0,,Мирай-чан, сен енді мені ұстағанда жыламайсың, солай ма?
Dialogue: 0,1:08:24.64,1:08:25.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:25.72,1:08:27.31,Default,,0,0,0,,Сіз жеңілдеп қалған сияқтысыз.
Dialogue: 0,1:08:27.68,1:08:30.23,Default,,0,0,0,,Сіздің ұстаған қолыңыз да көтерілген жоқ па?
Dialogue: 0,1:08:30.31,1:08:33.52,Default,,0,0,0,,Жоқ, жоқ, сен мені қазір ойламайсың.
Dialogue: 0,1:08:33.73,1:08:36.86,Default,,0,0,0,,Қалай болғанда да, Кун-чан керемет.
Dialogue: 0,1:08:37.69,1:08:38.74,Default,,0,0,0,,Иә, иә
Dialogue: 0,1:08:38.86,1:08:40.65,Default,,0,0,0,,А, бұл әке.
Dialogue: 0,1:08:40.74,1:08:41.95,Default,,0,0,0,,Һм? Қайда?
Dialogue: 0,1:08:42.03,1:08:43.03,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,1:08:44.37,1:08:47.24,Default,,0,0,0,,Жоқ, жоқ, бұл керемет.
Dialogue: 0,1:08:47.49,1:08:49.08,Default,,0,0,0,,Жоқ, әке.
Dialogue: 0,1:08:49.16,1:08:52.75,Default,,0,0,0,,Жоқ, менің арғы атам былтыр дүниеден өтті...
Dialogue: 0,1:08:54.04,1:08:55.21,Default,,0,0,0,,Ұлы ата?
Dialogue: 0,1:08:55.96,1:09:00.63,Default,,0,0,0,,Менің үлкен атам соғыс кезінде жойғыш ұшақтардың қозғалтқыштарын жасаған.
Dialogue: 0,1:09:01.13,1:09:03.01,Default,,0,0,0,,Содан кейін ол әскерге шақырылды —
Dialogue: 0,1:09:03.09,1:09:06.76,Default,,0,0,0,,Мені кемелерге соқтығысатын арнайы шабуыл жасағы енгізді, бірақ...
Dialogue: 0,1:09:06.85,1:09:08.52,Default,,0,0,0,,Бақытымызға орай өлген жоқпын...
Dialogue: 0,1:09:08.68,1:09:12.69,Default,,0,0,0,,Соғыстан кейін бұл мотоциклдер шығаратын компания болды...
Dialogue: 0,1:09:17.32,1:09:19.86,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,1:09:22.15,1:09:24.61,Default,,0,0,0,,Рахмет, үлкен аға
Dialogue: 0,1:09:26.32,1:09:30.54,Default,,0,0,0,,(қарлығаш айқайы)
Dialogue: 0,1:09:30.79,1:09:32.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:09:32.75,1:09:35.75,Default,,0,0,0,,Хмм, бұл туралы не деуге болады?
Dialogue: 0,1:09:35.92,1:09:37.79,Default,,0,0,0,,Жоқ! Сары деген не?
Dialogue: 0,1:09:37.88,1:09:39.05,Default,,0,0,0,,Қазіргі уақытта жуу
Dialogue: 0,1:09:39.13,1:09:40.76,Default,,0,0,0,,Сары жақсырақ
Dialogue: 0,1:09:40.84,1:09:42.30,Default,,0,0,0,,Әлі кепкен жоқ.
Dialogue: 0,1:09:42.38,1:09:43.38,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,1:09:43.47,1:09:44.97,Default,,0,0,0,,Сонымен, шалбарыңызбен барғыңыз келе ме?
Dialogue: 0,1:09:45.05,1:09:46.05,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,1:09:46.18,1:09:47.85,Default,,0,0,0,,Олай болса, киіңіз.
Dialogue: 0,1:09:47.93,1:09:50.35,Default,,0,0,0,,Ах~ Итата... Ах
Dialogue: 0,1:09:50.43,1:09:51.85,Default,,0,0,0,,Ах
Dialogue: 0,1:09:51.93,1:09:53.98,Default,,0,0,0,,Сіз бірдеңе іздеп жүрсіз бе?
Dialogue: 0,1:09:54.06,1:09:57.61,Default,,0,0,0,,Болашақ рейс~ Енді өзгеріп алайық.
Dialogue: 0,1:09:57.69,1:09:59.69,Default,,0,0,0,,Анашым, маған сары шалбар ұнайды.
Dialogue: 0,1:09:59.77,1:10:01.82,Default,,0,0,0,,Юкко, үндеме, бұл менің басымда жаңғырық.
Dialogue: 0,1:10:01.90,1:10:03.74,Default,,0,0,0,,Әй, сары жақсы екен.
Dialogue: 0,1:10:03.82,1:10:05.45,Default,,0,0,0,,Бұл сізге өте жарасады.
Dialogue: 0,1:10:05.53,1:10:07.49,Default,,0,0,0,,Уақыт келді, мен білемін.
Dialogue: 0,1:10:07.57,1:10:08.83,Default,,0,0,0,,Багажды тиеу керек
Dialogue: 0,1:10:08.91,1:10:10.29,Default,,0,0,0,,Мен білемін!
Dialogue: 0,1:10:10.37,1:10:13.54,Default,,0,0,0,,Иә, иә, кешіріңіз, мен енді ештеңе айтпаймын.
Dialogue: 0,1:10:13.62,1:10:14.96,Default,,0,0,0,,Оны қалай айту керек
Dialogue: 0,1:10:15.04,1:10:16.79,Default,,0,0,0,,Жоқ... жоқ, жоқ, жоқ!
Dialogue: 0,1:10:16.88,1:10:18.13,Default,,0,0,0,,Ештеңе
Dialogue: 0,1:10:18.21,1:10:20.34,Default,,0,0,0,,Мен көк шалбарды жек көре бастадым.
Dialogue: 0,1:10:20.42,1:10:22.17,Default,,0,0,0,,Не? Маған сары түсті ұнайды
Dialogue: 0,1:10:22.26,1:10:24.22,Default,,0,0,0,,Ах~ мен киімімді шеше алмаймын! Мен киімімді шеше алмаймын!
Dialogue: 0,1:10:24.34,1:10:25.68,Default,,0,0,0,,Эй
Dialogue: 0,1:10:25.76,1:10:28.68,Default,,0,0,0,,Иә иә иә иә
Dialogue: 0,1:10:32.56,1:10:36.65,Default,,0,0,0,,Сен Мирай-Чанды Кун Чаннан артық жақсы көресің бе?
Dialogue: 0,1:10:38.61,1:10:39.65,Default,,0,0,0,,Эй!
Dialogue: 0,1:10:39.73,1:10:40.82,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,1:10:40.90,1:10:42.36,Default,,0,0,0,,Мен бармаймын!
Dialogue: 0,1:10:42.44,1:10:43.44,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,1:10:43.53,1:10:44.82,Default,,0,0,0,,Үйден қаш!
Dialogue: 0,1:10:44.90,1:10:46.57,Default,,0,0,0,,Үйден қашып, жоғарғы қабаттағы бөлмеге бару керек пе?
Dialogue: 0,1:10:46.70,1:10:49.20,Default,,0,0,0,,Иә, мен үйден қашып бара жатырмын!
Dialogue: 0,1:10:50.74,1:10:52.16,Default,,0,0,0,,Кун-чан?
Dialogue: 0,1:10:54.04,1:10:55.04,Default,,0,0,0,,Я...
Dialogue: 0,1:10:55.66,1:10:56.96,Default,,0,0,0,,Хмм… неге осы мысықты бақытты етуге тек мен ғана тиіс?
Dialogue: 0,1:11:00.21,1:11:02.75,Default,,0,0,0,,Кун-чан кетіп қалды!
Dialogue: 0,1:11:06.13,1:11:07.63,Default,,0,0,0,,Му!
Dialogue: 0,1:11:09.89,1:11:12.01,Default,,0,0,0,,Кун-чан кетіп қалды!
Dialogue: 0,1:11:14.81,1:11:15.89,Default,,0,0,0,,Му!
Dialogue: 0,1:11:16.27,1:11:18.23,Default,,0,0,0,,Неге келмейсің!
Dialogue: 0,1:11:19.31,1:11:20.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:22.23,1:11:23.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:24.48,1:11:25.90,Default,,0,0,0,,Қайда?
Dialogue: 0,1:11:27.32,1:11:30.32,Default,,0,0,0,,Барлығы Кун Чанды тастап кетті ме?
Dialogue: 0,1:11:31.41,1:11:33.12,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:34.20,1:11:36.25,Default,,0,0,0,,Маған барлығы ұнамайды!
Dialogue: 0,1:11:42.63,1:11:46.42,Default,,0,0,0,,(Кун Чанның жылағаны)
Dialogue: 0,1:11:46.51,1:11:48.47,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,1:11:49.72,1:11:51.72,Default,,0,0,0,,(қарлығаш айқайы)
Dialogue: 0,1:11:51.80,1:11:55.85,Default,,0,0,0,,Бұл көзқараста не дұрыс емес?
Dialogue: 0,1:11:55.93,1:11:58.39,Default,,0,0,0,,А, бұл жақсы емес...
Dialogue: 0,1:12:02.27,1:12:03.27,Default,,0,0,0,,Гааах!
Dialogue: 0,1:12:03.36,1:12:05.65,Default,,0,0,0,,Сіз қазір лагерьге барасыз ба?
Dialogue: 0,1:12:05.78,1:12:08.53,Default,,0,0,0,,Жәндіктерді жинау және мерекелік отшашуды көру
Dialogue: 0,1:12:08.61,1:12:11.07,Default,,0,0,0,,Сіз ата мен әженің үйінде тұрасыз, солай ма?
Dialogue: 0,1:12:11.36,1:12:13.91,Default,,0,0,0,,Бұл бәрі асыға күткен жазғы демалыс.
Dialogue: 0,1:12:13.99,1:12:17.16,Default,,0,0,0,,Мен жақсы естеліктер қалдыруға өте қуаныштымын.
Dialogue: 0,1:12:17.25,1:12:20.58,Default,,0,0,0,,Бұл сізге ұнамайтын сияқты.
Dialogue: 0,1:12:21.08,1:12:22.79,Default,,0,0,0,,Сол себепті?
Dialogue: 0,1:12:22.88,1:12:26.09,Default,,0,0,0,,Қайсысы маңызды, шалбар ма, әлде жақсы естеліктер ме?
Dialogue: 0,1:12:26.17,1:12:30.34,Default,,0,0,0,,Жақсы, түсіндің. Түсінсең, келіп кешірім сұра.
Dialogue: 0,1:12:32.84,1:12:34.55,Default,,0,0,0,,Шалбар (жоғары сынып оқушысы) Иә?
Dialogue: 0,1:12:34.93,1:12:36.60,Default,,0,0,0,,Сізге бұл ұнамайды.
Dialogue: 0,1:12:36.68,1:12:37.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:38.02,1:12:39.56,Default,,0,0,0,,Сізге бұл ұнамайды!
Dialogue: 0,1:12:39.81,1:12:41.81,Default,,0,0,0,,Маған ұнамайды, ұнамайды!
Dialogue: 0,1:12:41.90,1:12:43.77,Default,,0,0,0,,Маған ұнамайды, ұнамайды, маған ұнамайды!
Dialogue: 0,1:12:43.86,1:12:46.27,Default,,0,0,0,,Маған ұнамайды, ұнамайды, маған ұнамайды!
Dialogue: 0,1:12:46.40,1:12:50.90,Default,,0,0,0,,Саған ұнамайды... Ұнамайды...
Dialogue: 0,1:12:55.33,1:12:56.53,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:56.62,1:12:57.91,Default,,0,0,0,,Мінбе!
Dialogue: 0,1:12:58.95,1:13:00.62,Default,,0,0,0,,Сіз оны мінбейсіз бе?
Dialogue: 0,1:13:02.25,1:13:04.04,Default,,0,0,0,,(кету туралы ысқырық)
Dialogue: 0,1:13:05.38,1:13:07.42,Default,,0,0,0,,О, күте тұрыңыз! Күте тұрыңыз!
Dialogue: 0,1:13:16.51,1:13:17.56,Default,,0,0,0,,Гакига
Dialogue: 0,1:13:20.60,1:13:22.23,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:24.35,1:13:25.52,Default,,0,0,0,,Бұл вагон-цистерна!
Dialogue: 0,1:13:28.19,1:13:29.61,Default,,0,0,0,,Бұл контейнерлік вагон!
Dialogue: 0,1:13:30.07,1:13:33.78,Default,,0,0,0,,Narita Express және Ueno Tokyo Line—
Dialogue: 0,1:13:33.86,1:13:35.66,Default,,0,0,0,,Yamanote желісі!
Dialogue: 0,1:13:36.41,1:13:38.66,Default,,0,0,0,,Ах
Dialogue: 0,1:13:42.71,1:13:43.75,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:49.80,1:13:52.34,Default,,0,0,0,,Бұл Шинкансеннің қандай түрі?
Dialogue: 0,1:13:53.22,1:13:56.64,Default,,0,0,0,,Пойыз келе жатыр. Сақ болыңыз.
Dialogue: 0,1:14:01.43,1:14:05.06,Default,,0,0,0,,Токио ~ Токио ~ Мінгеніңіз үшін рахмет
Dialogue: 0,1:14:05.15,1:14:07.15,Default,,0,0,0,,Бұл пойыз экспедиторлық пойыз болады.
Dialogue: 0,1:14:07.23,1:14:09.07,Default,,0,0,0,,Не? Эх...
Dialogue: 0,1:14:10.98,1:14:15.28,Default,,0,0,0,,Сіз отырғызуды жалғастыра алмайсыз. Есік жабылады. Сақ болыңыз.
Dialogue: 0,1:14:15.36,1:14:18.07,Default,,0,0,0,,Иә Есік жабылады Есік жабылады
Dialogue: 0,1:14:18.16,1:14:19.24,Default,,0,0,0,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,1:14:22.95,1:14:28.96,Default,,0,0,0,,(көптеген шет тіліндегі хабарландырулар)
Dialogue: 0,1:14:32.51,1:14:34.42,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,1:14:37.09,1:14:40.31,Default,,0,0,0,,Уау! Бұл Шинкансен!
Dialogue: 0,1:14:50.02,1:14:52.07,Default,,0,0,0,,(Билет қақпасының ескерту дыбысы)
Dialogue: 0,1:14:52.15,1:14:53.23,Default,,0,0,0,,Мінуге болмайды
Dialogue: 0,1:14:53.32,1:14:54.40,Default,,0,0,0,,Билет жоқ!
Dialogue: 0,1:14:54.49,1:14:55.99,Default,,0,0,0,,Мінуге болмайды
Dialogue: 0,1:14:56.07,1:14:57.53,Default,,0,0,0,,Мен үйге бара жатырмын!
Dialogue: 0,1:15:07.33,1:15:10.42,Default,,0,0,0,,Бірақ... үйге қалай жетуім керек?
Dialogue: 0,1:15:10.50,1:15:11.75,Default,,0,0,0,,Ахаха, ол шөптей өсіп жатыр ғой~
Dialogue: 0,1:15:11.84,1:15:13.67,Default,,0,0,0,,Жоғалған бала туралы хабарлама
Dialogue: 0,1:15:13.76,1:15:15.30,Default,,0,0,0,,Иә, иә, иә, иә, иә!
Dialogue: 0,1:15:15.38,1:15:18.55,Default,,0,0,0,,Дайсуке-кун Гая Гая Уордынан Дайсуке-кун
Dialogue: 0,1:15:18.64,1:15:21.30,Default,,0,0,0,,Ана «күміс қоңыраудың» астында күтіп тұр
Dialogue: 0,1:15:21.39,1:15:23.26,Default,,0,0,0,,Анашым!
Dialogue: 0,1:15:23.35,1:15:24.56,Default,,0,0,0,,Дай-чан!
Dialogue: 0,1:15:25.98,1:15:28.44,Default,,0,0,0,,Ахаха, ол шөптей өсіп жатыр ғой~
Dialogue: 0,1:15:28.52,1:15:30.02,Default,,0,0,0,,Жоғалған бала туралы хабарлама
Dialogue: 0,1:15:30.10,1:15:31.81,Default,,0,0,0,,Иә, иә, иә, иә, иә!
Dialogue: 0,1:15:31.90,1:15:35.24,Default,,0,0,0,,Мусамуса қаласынан Сае Чан
Dialogue: 0,1:15:35.32,1:15:37.53,Default,,0,0,0,,Әкесі «мысық қоңырауының» астында күтіп тұр
Dialogue: 0,1:15:37.61,1:15:40.37,Default,,0,0,0,,Са Чан, әке!
Dialogue: 0,1:15:40.45,1:15:41.78,Default,,0,0,0,,Са-чан!
Dialogue: 0,1:15:46.04,1:15:47.41,Default,,0,0,0,,Әке!
Dialogue: 0,1:15:49.04,1:15:50.58,Default,,0,0,0,,А, бұл дұрыс емес...
Dialogue: 0,1:15:51.33,1:15:52.67,Default,,0,0,0,,Ана…
Dialogue: 0,1:15:53.34,1:15:55.51,Default,,0,0,0,,Әй, анашым!
Dialogue: 0,1:15:57.42,1:16:01.43,Default,,0,0,0,,Анашым!
Dialogue: 0,1:16:04.56,1:16:07.06,Default,,0,0,0,,О... Онибаба...
Dialogue: 0,1:16:43.22,1:16:44.89,Default,,0,0,0,,Тек балалар...
Dialogue: 0,1:16:53.65,1:16:55.02,Default,,0,0,0,,Келесі адам
Dialogue: 0,1:16:55.11,1:16:56.11,Default,,0,0,0,,Ах
Dialogue: 0,1:16:58.78,1:17:02.45,Default,,0,0,0,,Сіз бір нәрсені ұмыттыңыз ба? Сіз қандай жүкті жоғалттыңыз?
Dialogue: 0,1:17:02.53,1:17:04.16,Default,,0,0,0,,Айттым ғой, ешкім бізді қуалап жүрген жоқ!
Dialogue: 0,1:17:04.57,1:17:08.58,Default,,0,0,0,,Бұл жоғалған зат туралы хабарландыру есептегіші. Басқа мәселелер бойынша...
Dialogue: 0,1:17:08.91,1:17:10.58,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,1:17:10.96,1:17:13.33,Default,,0,0,0,,Жоғалдың ба? Сонымен не жоғалттыңыз?
Dialogue: 0,1:17:14.08,1:17:16.92,Default,,0,0,0,,Сіз өзіңізді айтып тұрсыз ба?
Dialogue: 0,1:17:17.92,1:17:18.92,Default,,0,0,0,,Иә
Dialogue: 0,1:17:19.01,1:17:21.72,Default,,0,0,0,,Жарайды, енді бізге қоңырау шалу керек —
Dialogue: 0,1:17:21.80,1:17:23.26,Default,,0,0,0,,Бірнеше сұрақтар қойыңыз
Dialogue: 0,1:17:23.72,1:17:25.39,Default,,0,0,0,,Алдымен атыңызды айтыңыз.
Dialogue: 0,1:17:25.47,1:17:27.76,Default,,0,0,0,,Кун-чан (тіркеуді аяқтау үшін қоңырау)
Dialogue: 0,1:17:28.47,1:17:31.98,Default,,0,0,0,,Тіркелгеннен кейін анаңыздың атын енгізіңіз.
Dialogue: 0,1:17:32.06,1:17:36.90,Default,,0,0,0,,Анамның аты? Ал, бұл не?
Dialogue: 0,1:17:36.98,1:17:37.98,Default,,0,0,0,,Аты-жөніңізді енгізіңіз.
Dialogue: 0,1:17:38.07,1:17:41.86,Default,,0,0,0,,Иә? неге? Ал, бұл!
Dialogue: 0,1:17:41.94,1:17:43.65,Default,,0,0,0,,(Ақаулық сигналы)
Dialogue: 0,1:17:43.99,1:17:47.87,Default,,0,0,0,,Тіркеу сәтсіз аяқталды. Әрі қарай, әкеңіздің атын енгізіңіз.
Dialogue: 0,1:17:48.03,1:17:49.87,Default,,0,0,0,,Әкесінің аты?
Dialogue: 0,1:17:49.95,1:17:53.21,Default,,0,0,0,,Ерм... Ерм... Ерм...
Dialogue: 0,1:17:53.58,1:17:55.00,Default,,0,0,0,,(Ақаулық сигналы)
Dialogue: 0,1:17:55.08,1:17:59.13,Default,,0,0,0,,Тіркеу мүмкін болмады. Басқа отбасы мүшелерінің есімдерін көрсетіңіз.
Dialogue: 0,1:17:59.46,1:18:00.63,Default,,0,0,0,,Юкко
Dialogue: 0,1:18:00.76,1:18:02.09,Default,,0,0,0,,(Ақаулық сигналы)
Dialogue: 0,1:18:02.17,1:18:05.93,Default,,0,0,0,,Үй жануарларын шақыруға болмайтынын ескеріңіз.
Dialogue: 0,1:18:06.01,1:18:08.22,Default,,0,0,0,,Басқа отбасы мүшелерінің аты-жөнін көрсетіңіз.
Dialogue: 0,1:18:08.30,1:18:09.76,Default,,0,0,0,,Э-э-э—
Dialogue: 0,1:18:10.60,1:18:12.68,Default,,0,0,0,,Басқа отбасы мүшелерінің аты-жөнін көрсетіңіз.
Dialogue: 0,1:18:12.77,1:18:17.02,Default,,0,0,0,,уһ уһ уһ
Dialogue: 0,1:18:18.02,1:18:19.98,Default,,0,0,0,,(Ақаулық сигналы)
Dialogue: 0,1:18:20.07,1:18:21.44,Default,,0,0,0,,Тіркелу мүмкін емес
Dialogue: 0,1:18:21.53,1:18:24.61,Default,,0,0,0,,Сондықтан оны шақырудың қажеті жоқ.
Dialogue: 0,1:18:24.74,1:18:27.16,Default,,0,0,0,,Олай етпесем не болады?
Dialogue: 0,1:18:27.24,1:18:29.37,Default,,0,0,0,,Бұл өте үлкен станция.
Dialogue: 0,1:18:29.45,1:18:33.25,Default,,0,0,0,,Күнде сен сияқты жоғалған балалар көп.
Dialogue: 0,1:18:33.33,1:18:37.75,Default,,0,0,0,,Оларды алуға ешкім келмесе, балалар шұңқырда
Dialogue: 0,1:18:37.83,1:18:40.80,Default,,0,0,0,,Арнайы Шинкансен алу керек
Dialogue: 0,1:18:41.30,1:18:43.46,Default,,0,0,0,,Сіз мінгенде қайда барасыз?
Dialogue: 0,1:18:43.84,1:18:46.88,Default,,0,0,0,,Барар жері жоқ балалар қайда барады?
Dialogue: 0,1:18:49.05,1:18:50.56,Default,,0,0,0,,Бұл жалғыз ел
Dialogue: 0,1:18:50.72,1:18:52.64,Default,,0,0,0,,А-а-а-а-а-а...
Dialogue: 0,1:18:52.81,1:18:57.27,Default,,0,0,0,,Синкансен жақында келеді
Dialogue: 0,1:19:18.29,1:19:21.29,Default,,0,0,0,,Не? мен неге мұндамын?
Dialogue: 0,1:19:22.25,1:19:23.88,Default,,0,0,0,,(Жұмбақ мүйіз)
Dialogue: 0,1:19:23.96,1:19:25.21,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:49.91,1:19:51.74,Default,,0,0,0,,Декимасуға мініңіз
Dialogue: 0,1:19:52.83,1:19:53.99,Default,,0,0,0,,Ал Вайолет ше?
Dialogue: 0,1:19:56.12,1:20:00.21,Default,,0,0,0,,А, мен оны жек көремін!
Dialogue: 0,1:20:00.29,1:20:02.29,Default,,0,0,0,,Декимасуға мініңіз
Dialogue: 0,1:20:05.21,1:20:06.42,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:07.17,1:20:08.55,Default,,0,0,0,,Ааах…
Dialogue: 0,1:20:11.43,1:20:13.76,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,1:20:15.31,1:20:19.19,Default,,0,0,0,,Декимасуда жүру Декимасуда жүру
Dialogue: 0,1:20:19.27,1:20:20.77,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,1:20:21.27,1:20:23.69,Default,,0,0,0,,Пойызға міну...
Dialogue: 0,1:20:25.73,1:20:27.90,Default,,0,0,0,,Хмм, ә
Dialogue: 0,1:20:30.15,1:20:32.37,Default,,0,0,0,,И-я-да!
Dialogue: 0,1:20:32.45,1:20:35.83,Default,,0,0,0,,Онда өзіңді дәлелдеу керек
Dialogue: 0,1:20:37.04,1:20:40.58,Default,,0,0,0,,Кун-чан бұл... Кун-чан
Dialogue: 0,1:20:42.08,1:20:43.58,Default,,0,0,0,,Анасының баласы
Dialogue: 0,1:20:43.88,1:20:45.04,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,1:20:45.42,1:20:48.76,Default,,0,0,0,,Кун-чан... әкенің баласы
Dialogue: 0,1:20:48.84,1:20:50.26,Default,,0,0,0,,Иә? ДДСҰ?
Dialogue: 0,1:20:50.38,1:20:54.01,Default,,0,0,0,,Кун-чан... - Юккоға жеңіл тамақ беретін адам.
Dialogue: 0,1:20:54.18,1:20:55.72,Default,,0,0,0,,Сенің анаң кім?
Dialogue: 0,1:20:56.14,1:20:59.98,Default,,0,0,0,,Менің анам... өз бөлмесін жақсы жинамайды.
Dialogue: 0,1:21:00.27,1:21:01.69,Default,,0,0,0,,Сенің әкең кім?
Dialogue: 0,1:21:01.94,1:21:04.94,Default,,0,0,0,,Әкесі Мирай-чанды ұстай алмайды
Dialogue: 0,1:21:05.36,1:21:07.15,Default,,0,0,0,,Маған Мирай-чан ұнамайды
Dialogue: 0,1:21:07.40,1:21:08.90,Default,,0,0,0,,Мираи-чан...
Dialogue: 0,1:21:10.70,1:21:12.41,Default,,0,0,0,,Мираи-чан...
Dialogue: 0,1:21:12.78,1:21:15.95,Default,,0,0,0,,Кун-чанның… Кун-чанның…
Dialogue: 0,1:21:17.41,1:21:19.00,Default,,0,0,0,,(Мираи-чанның дауысы)
Dialogue: 0,1:21:19.08,1:21:20.29,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:22.92,1:21:25.50,Default,,0,0,0,,Ах! Мирай-чан, сен мұнда не үшін келдің?
Dialogue: 0,1:21:28.17,1:21:29.21,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:29.59,1:21:31.30,Default,,0,0,0,,Онда барма! Апыр-ай!
Dialogue: 0,1:21:36.05,1:21:37.97,Default,,0,0,0,,Декимасуға мініңіз
Dialogue: 0,1:21:38.22,1:21:40.06,Default,,0,0,0,,Мираи-чан!
Dialogue: 0,1:21:41.73,1:21:45.86,Default,,0,0,0,,Декимасуда жүру Декимасуда жүру
Dialogue: 0,1:21:46.06,1:21:48.27,Default,,0,0,0,,Мінбе!
Dialogue: 0,1:21:50.19,1:21:51.57,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:58.37,1:22:02.71,Default,,0,0,0,,Кун-чан бұл... Кун-чан
Dialogue: 0,1:22:03.04,1:22:04.37,Default,,0,0,0,,А-у-
Dialogue: 0,1:22:07.34,1:22:10.13,Default,,0,0,0,,Кун-чан - Мирай-чанның ағасы!
Dialogue: 0,1:22:10.67,1:22:12.55,Default,,0,0,0,,(тіркеуді аяқтау сигналы)
Dialogue: 0,1:22:15.13,1:22:17.05,Default,,0,0,0,,Мен сізді шақырғым келеді.
Dialogue: 0,1:22:17.14,1:22:20.31,Default,,0,0,0,,Исоисо Уордтағы Мираи-чан Мираи-чан
Dialogue: 0,1:22:20.39,1:22:24.23,Default,,0,0,0,,Жер асты Шинкансен платформасында менің ағам Кун Чан қоңырау шалып жатыр.
Dialogue: 0,1:22:27.48,1:22:28.56,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:28.81,1:22:30.98,Default,,0,0,0,,Иә? Онда емес...
Dialogue: 0,1:22:31.90,1:22:33.03,Default,,0,0,0,,Таптым!
Dialogue: 0,1:22:33.11,1:22:33.94,Default,,0,0,0,,Ах
Dialogue: 0,1:22:34.82,1:22:35.95,Default,,0,0,0,,Бұл қозғалыс...
Dialogue: 0,1:22:38.07,1:22:39.74,Default,,0,0,0,,Болашақ Мираи-чан!
Dialogue: 0,1:22:40.16,1:22:42.54,Default,,0,0,0,,Үйден қашып кетсең де адасу ақымақтық сияқты.
Dialogue: 0,1:22:43.12,1:22:46.12,Default,,0,0,0,,Уф... Мен оны көптен бері іздеп жүрмін.
Dialogue: 0,1:22:46.50,1:22:48.38,Default,,0,0,0,,Кеттік! Уау
Dialogue: 0,1:23:04.48,1:23:06.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:06.98,1:23:08.65,Default,,0,0,0,,Содан кейін келесі адам
Dialogue: 0,1:23:11.90,1:23:15.07,Default,,0,0,0,,Уау! Болашақ ұшу!
Dialogue: 0,1:23:15.95,1:23:16.95,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:17.03,1:23:20.16,Default,,0,0,0,,Бұл не? Мүмкін құлап жатқан шығар?
Dialogue: 0,1:23:20.24,1:23:21.24,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,1:23:22.08,1:23:23.45,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,1:23:23.54,1:23:25.87,Default,,0,0,0,,Онда бірдеңе көріп тұрсың ба?
Dialogue: 0,1:23:26.08,1:23:28.92,Default,,0,0,0,,Мм... сіздің бақшаңыздағы емен ағашы?
Dialogue: 0,1:23:29.00,1:23:32.34,Default,,0,0,0,,Бұл солай көрінуі мүмкін, бірақ бұл біздің отбасымыздың тарихының көрсеткіші.
Dialogue: 0,1:23:32.42,1:23:33.63,Default,,0,0,0,,Саке?
Dialogue: 0,1:23:34.13,1:23:37.01,Default,,0,0,0,,Кітапхана кітаптарын ұйымдастыру Көрсеткіш бар емес пе?
Dialogue: 0,1:23:37.09,1:23:40.51,Default,,0,0,0,,Дәл солай, үйіміздің бүгіні, өткені, болашағы...
Dialogue: 0,1:23:40.59,1:23:42.60,Default,,0,0,0,,Барлығы карталарда сақталады
Dialogue: 0,1:23:42.81,1:23:46.43,Default,,0,0,0,,Мен інім бар уақыттың картасын табуым керек...
Dialogue: 0,1:23:47.10,1:23:48.35,Default,,0,0,0,,Оны табу керек пе?
Dialogue: 0,1:23:48.56,1:23:49.81,Default,,0,0,0,,Мен үйге бара алмаймын, иә?
Dialogue: 0,1:23:49.90,1:23:51.27,Default,,0,0,0,,Кірейік!
Dialogue: 0,1:23:59.20,1:24:01.49,Default,,0,0,0,,Ааах…
Dialogue: 0,1:24:19.26,1:24:22.39,Default,,0,0,0,,Велосипедті көріп тұрсың ба? Иә
Dialogue: 0,1:24:22.89,1:24:25.93,Default,,0,0,0,,Әке?
Dialogue: 0,1:24:26.02,1:24:28.23,Default,,0,0,0,,Негізі әкем физикалық тұрғыдан әлсіз...
Dialogue: 0,1:24:28.31,1:24:31.15,Default,,0,0,0,,Мен бастауыш сыныпқа барған кезімде де велосипед тебе алмадым.
Dialogue: 0,1:24:31.52,1:24:34.06,Default,,0,0,0,,Мен қазір жылап жаттығамын.
Dialogue: 0,1:24:34.15,1:24:35.73,Default,,0,0,0,,Әке...
Dialogue: 0,1:24:36.07,1:24:37.11,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:24:37.19,1:24:38.53,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:24:52.96,1:24:54.29,Default,,0,0,0,,Бұл бала ма?
Dialogue: 0,1:24:54.38,1:24:56.05,Default,,0,0,0,,Бұл Юкко, иә?
Dialogue: 0,1:24:56.13,1:24:59.63,Default,,0,0,0,,Жақында мен ана итпен қоштасып, үйге әкелемін.
Dialogue: 0,1:25:00.47,1:25:01.72,Default,,0,0,0,,Юкко...
Dialogue: 0,1:25:02.64,1:25:05.93,Default,,0,0,0,,Юкко!
Dialogue: 0,1:25:16.57,1:25:18.73,Default,,0,0,0,,Әй, анашым!
Dialogue: 0,1:25:18.82,1:25:20.44,Default,,0,0,0,,Менің қолымда бар -
Dialogue: 0,1:25:20.74,1:25:24.11,Default,,0,0,0,,Қаңғыбас мысықтың еркелігінен құлаған қарлығаш балапан.
Dialogue: 0,1:25:24.32,1:25:25.95,Default,,0,0,0,,Осы сәттен бастап, ана
Dialogue: 0,1:25:26.03,1:25:29.54,Default,,0,0,0,,Мен мысықтарды қатты жақсы көретінмін, ал қазір ұнатпаймын.
Dialogue: 0,1:25:37.17,1:25:43.55,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:25:57.90,1:26:04.11,Default,,0,0,0,,Ааааааааа!
Dialogue: 0,1:26:31.39,1:26:36.77,Default,,0,0,0,,(Хигурашидің айқайы)
Dialogue: 0,1:26:36.85,1:26:38.73,Default,,0,0,0,,Мен сол ағашқа бара аламын ба? (Әйел) Иә?
Dialogue: 0,1:26:39.61,1:26:41.11,Default,,0,0,0,,Я...
Dialogue: 0,1:26:44.65,1:26:46.24,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,1:26:50.37,1:26:55.00,Default,,0,0,0,,(Жас жігіттің ауыр тыныс алуы)
Dialogue: 0,1:27:15.18,1:27:20.86,Default,,0,0,0,,(Жас жігіттің ауыр тыныс алуы)
Dialogue: 0,1:27:26.20,1:27:29.99,Default,,0,0,0,,О-чан өте жылдам, мен ол жеңіледі деп ойладым.
Dialogue: 0,1:27:30.20,1:27:31.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:34.70,1:27:36.91,Default,,0,0,0,,Уфуфу, бұл біртүрлі.
Dialogue: 0,1:27:37.83,1:27:41.71,Default,,0,0,0,,Сол кезде арғы атам соншалықты қатты жүзбесе...
Dialogue: 0,1:27:42.54,1:27:46.34,Default,,0,0,0,,Менің үлкен әжем әдейі баяу жүгірмегенде...
Dialogue: 0,1:27:46.84,1:27:49.22,Default,,0,0,0,,Біз тіпті қосылмадық.
Dialogue: 0,1:27:50.59,1:27:54.81,Default,,0,0,0,,Осы сияқты көптеген ұсақ-түйектер жиналды ...
Dialogue: 0,1:27:55.98,1:27:58.48,Default,,0,0,0,,Бұл бізді бүгінгі кім екенімізді көрсетеді.
Dialogue: 0,1:28:00.23,1:28:01.56,Default,,0,0,0,,Енді?
Dialogue: 0,1:28:31.51,1:28:33.51,Default,,0,0,0,,Үлкен аға
Dialogue: 0,1:28:34.68,1:28:36.97,Default,,0,0,0,,Әкесі мен анасы қоңырау шалады.
Dialogue: 0,1:28:38.60,1:28:39.81,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:28:39.89,1:28:41.10,Default,,0,0,0,,Не?
Dialogue: 0,1:28:41.19,1:28:44.11,Default,,0,0,0,,Таңғы асты отырып ішіңіз.
Dialogue: 0,1:28:44.65,1:28:45.82,Default,,0,0,0,,Тамақтану керек пе?
Dialogue: 0,1:28:45.90,1:28:47.86,Default,,0,0,0,,Қажет емес
Dialogue: 0,1:28:50.57,1:28:51.61,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:52.49,1:28:55.08,Default,,0,0,0,,Болашақ Мираи Чан?
Dialogue: 0,1:28:55.62,1:28:57.29,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,1:28:57.37,1:29:00.25,Default,,0,0,0,,Мен «қазіргі уақытта өмір сүремін»
Dialogue: 0,1:29:00.96,1:29:02.42,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,1:29:04.04,1:29:06.67,Default,,0,0,0,,Мұның бұрын не болғанын біреу біледі ме?
Dialogue: 0,1:29:06.75,1:29:07.76,Default,,0,0,0,,Иә
Dialogue: 0,1:29:07.84,1:29:10.38,Default,,0,0,0,,Хехехе, мұндай нәрсе
Dialogue: 0,1:29:10.47,1:29:11.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:29:11.76,1:29:15.35,Default,,0,0,0,,Үйге өзіңіз бара аласыз, қайта адаспаңыз.
Dialogue: 0,1:29:16.64,1:29:17.93,Default,,0,0,0,,Қоштасып жатырсың ба?
Dialogue: 0,1:29:18.02,1:29:19.39,Default,,0,0,0,,Біз есімізді жоғалтқан болармыз, иә?
Dialogue: 0,1:29:19.89,1:29:22.73,Default,,0,0,0,,Бұдан былай біз бірге болатынымыз соншалық, сен онымен ауырасың.
Dialogue: 0,1:29:36.03,1:29:43.04,Default,,0,0,0,,(мотор дыбысы)
Dialogue: 0,1:30:04.56,1:30:05.73,Default,,0,0,0,,(Артқы есіктің ашылған дыбысы)
Dialogue: 0,1:30:06.23,1:30:08.36,Default,,0,0,0,,Бас ауруы жазылды ма?
Dialogue: 0,1:30:08.86,1:30:10.15,Default,,0,0,0,,Сол екі клонды бір-бірімен шайқастырып отыр—
Dialogue: 0,1:30:10.40,1:30:13.61,Default,,0,0,0,,Өзіңізді күтіңіз...
Dialogue: 0,1:30:14.82,1:30:17.03,Default,,0,0,0,,Соңғы кездері сіз мейірімді болып кеттіңіз.
Dialogue: 0,1:30:17.12,1:30:18.20,Default,,0,0,0,,Мен?
Dialogue: 0,1:30:18.53,1:30:20.29,Default,,0,0,0,,Бұрын олай емес еді.
Dialogue: 0,1:30:20.37,1:30:22.00,Default,,0,0,0,,Өткенде қашан болды?
Dialogue: 0,1:30:22.25,1:30:23.66,Default,,0,0,0,,Кун-чан туылғанға дейін
Dialogue: 0,1:30:23.75,1:30:25.04,Default,,0,0,0,,Баяғыда ма?
Dialogue: 0,1:30:25.12,1:30:27.38,Default,,0,0,0,,Жұмыста үнемі қобалжыдым.
Dialogue: 0,1:30:27.46,1:30:29.09,Default,,0,0,0,,Сосын сен де
Dialogue: 0,1:30:29.17,1:30:31.34,Default,,0,0,0,,Мен? Не өзгерді?
Dialogue: 0,1:30:31.51,1:30:33.13,Default,,0,0,0,,Қозғалмаған
Dialogue: 0,1:30:33.22,1:30:34.63,Default,,0,0,0,,Я~
Dialogue: 0,1:30:35.47,1:30:38.10,Default,,0,0,0,,Бұрын мен қобалжып, тез қобалжыйтынмын.
Dialogue: 0,1:30:38.18,1:30:41.81,Default,,0,0,0,,Әй, тоқтат, есіме түсірме.
Dialogue: 0,1:30:41.89,1:30:44.89,Default,,0,0,0,,Мен мұнымен аяқталамыз деп ойламаппын.
Dialogue: 0,1:30:45.48,1:30:48.36,Default,,0,0,0,,Балалар кінәлі шығар.
Dialogue: 0,1:30:54.07,1:30:57.49,Default,,0,0,0,,Бұл оның бұрынғыдан да әкеге ұқсағанын білдіре ме?
Dialogue: 0,1:30:57.57,1:31:00.24,Default,,0,0,0,,Өте көп, өте...
Dialogue: 0,1:31:00.37,1:31:02.91,Default,,0,0,0,,Мен ше? Сіз анаға көбірек ұқсадыңыз ба?
Dialogue: 0,1:31:03.00,1:31:05.50,Default,,0,0,0,,Әділ, бірақ ең жақсы емес
Dialogue: 0,1:31:05.58,1:31:08.92,Default,,0,0,0,,Ең жаманы болмаса, жеткілікті жақсы.
Dialogue: 0,1:31:10.04,1:31:12.67,Default,,0,0,0,,Хехехехехехехехе
Dialogue: 0,1:31:13.51,1:31:15.84,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,1:31:15.92,1:31:19.18,Default,,0,0,0,,(Әке мен шешенің күлкісі)
Dialogue: 0,1:31:19.26,1:31:20.85,Default,,0,0,0,,Жақсы достар
Dialogue: 0,1:31:24.89,1:31:25.89,Default,,0,0,0,,Ах~
Dialogue: 0,1:31:31.94,1:31:33.86,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,1:31:35.49,1:31:36.49,Default,,0,0,0,,Тамақтану керек пе?
Dialogue: 0,1:31:36.57,1:31:37.61,Default,,0,0,0,,Ах~
Dialogue: 0,1:31:40.70,1:31:41.83,Default,,0,0,0,,Иә
Dialogue: 0,1:31:54.92,1:31:57.59,Default,,0,0,0,,Кунчан! Мирай-чан!
Dialogue: 0,1:31:57.76,1:31:59.43,Default,,0,0,0,,Мен дайынмын~
Dialogue: 0,1:31:59.59,1:32:00.72,Default,,0,0,0,,Хаа
Dialogue: 0,1:32:00.80,1:32:02.39,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,1:32:04.93,1:32:06.93,Default,,0,0,0,,А~о
Dialogue: 0,1:32:16.36,1:32:18.32,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,1:32:24.74,1:32:27.54,Default,,0,0,0,,Ахх!
Dialogue: 0,1:32:27.75,1:32:28.75,Default,,0,0,0,,Ихихихихи
Dialogue: 0,1:32:31.75,1:32:34.29,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,1:32:37.30,1:32:40.93,Default,,0,0,0,,Жүріңдер, бәріміз сыртқа шығайық!
Dialogue: 0,1:32:43.18,1:32:45.97,Default,,0,0,0,,Уа!
Dialogue: 0,1:32:50.94,1:32:52.31,Default,,0,0,0,,(Паровоз ысқырығы)
Dialogue: 0,1:32:52.40,1:32:59.40,Default,,0,0,0,,♪~
Dialogue: 0,1:37:46.90,1:37:53.91,Default,,0,0,0,,~♪
Dialogue: 0,1:37:55.41,1:38:01.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory