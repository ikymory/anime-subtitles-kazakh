Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.41,0:01:43.41,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:09.33,0:04:13.33,Default,,0,0,0,,<Құдайлар патшалығынан асып түскен Гоку және жойылу Құдайы Берус>
Dialogue: 0,0:04:13.33,0:04:18.34,Default,,0,0,0,,<Екеуінің арасындағы шайқас шынымен де қиян-кескі болды>
Dialogue: 0,0:04:18.34,0:04:20.34,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:04:20.34,0:04:22.34,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:27.35,0:04:33.35,Default,,0,0,0,,<Ал сол шайқас қайда аяқталды...>
Dialogue: 0,0:04:33.35,0:04:39.35,Default,,0,0,0,,<Бирус уәде еткендей Жерді жоюға тырысты, бірақ...>
Dialogue: 0,0:04:46.37,0:04:50.37,Default,,0,0,0,,<Күнделікті жалқаулығыма байланысты физикалық күшім шегінде>
Dialogue: 0,0:04:50.37,0:04:55.38,Default,,0,0,0,,<Жер жойылудан аман қалды>
Dialogue: 0,0:04:55.38,0:04:58.38,Default,,0,0,0,,Қанша уақыт ұйықтап жатырсың?
Dialogue: 0,0:04:58.38,0:05:01.38,Default,,0,0,0,,Хмф... Мен шынымен ұйықтап қалдым.
Dialogue: 0,0:05:01.38,0:05:03.38,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:05:14.33,0:05:16.33,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет! →
Dialogue: 0,0:05:16.33,0:05:19.33,Default,,0,0,0,,Мен Транкстың орнына барамын!
Dialogue: 0,0:05:23.34,0:05:25.34,Default,,0,0,0,,Олай болса, Чичи.
Dialogue: 0,0:05:25.34,0:05:28.34,Default,,0,0,0,,Мен де Кай патшамен жаттығуға барамын.
Dialogue: 0,0:05:28.34,0:05:30.34,Default,,0,0,0,,Иә? Жаттығу ма?
Dialogue: 0,0:05:30.34,0:05:34.35,Default,,0,0,0,,Иә. Менің денем де жақсы сезінеді→
Dialogue: 0,0:05:34.35,0:05:36.35,Default,,0,0,0,,Ола, көбірек жаттыға →
Dialogue: 0,0:05:36.35,0:05:39.35,Default,,0,0,0,,Беерус-самаға қарап, күшейе түс.
Dialogue: 0,0:05:39.35,0:05:41.35,Default,,0,0,0,,Оның кигені осы емес пе еді?
Dialogue: 0,0:05:41.35,0:05:43.36,Default,,0,0,0,,Жоқ! Ха! ?
Dialogue: 0,0:05:43.36,0:05:47.36,Default,,0,0,0,,Бұл дұрыс емес. Сіз өткен күні бәрі жақсы дедіңіз.
Dialogue: 0,0:05:47.36,0:05:50.36,Default,,0,0,0,,Мен 100 миллион Зени алған кезде.
Dialogue: 0,0:05:50.36,0:05:54.36,Default,,0,0,0,,Иә? Бұл ақша қазірдің өзінде игерілді.
Dialogue: 0,0:05:57.37,0:06:00.37,Default,,0,0,0,,Не? Ку~.
Dialogue: 0,0:06:00.37,0:06:02.38,Default,,0,0,0,,Өтірік~.
Dialogue: 0,0:06:02.38,0:06:05.38,Default,,0,0,0,,Гоку! Ұмытып қалдыңыз ба? иә?
Dialogue: 0,0:06:05.38,0:06:08.31,Default,,0,0,0,,Гоханның орнында бала туады.
Dialogue: 0,0:06:08.31,0:06:11.32,Default,,0,0,0,,Сүйкімді немересімен төбелескен қария →
Dialogue: 0,0:06:11.32,0:06:13.32,Default,,0,0,0,,Мен оны саған көрсете алмаймын.
Dialogue: 0,0:06:13.32,0:06:15.32,Default,,0,0,0,,Маған қазірден бастап көп жұмыс істеу керек →
Dialogue: 0,0:06:15.32,0:06:19.33,Default,,0,0,0,,Бірден немере-шөберенің құрметіне бөленетін асыл ата бола алмайсың.
Dialogue: 0,0:06:19.33,0:06:24.33,Default,,0,0,0,,О, бірақ... менің жаттығуым...
Dialogue: 0,0:06:24.33,0:06:29.34,Default,,0,0,0,,Осыншама күресу жеткілікті.
Dialogue: 0,0:06:29.34,0:06:31.34,Default,,0,0,0,,Жүр, жұмысқа барайық!
Dialogue: 0,0:06:31.34,0:06:33.34,Default,,0,0,0,,Аа...
Dialogue: 0,0:06:35.34,0:06:38.34,Default,,0,0,0,,Иә! Ааа….
Dialogue: 0,0:06:42.35,0:06:45.35,Default,,0,0,0,,Енді мен тамақ дайындауым керек.
Dialogue: 0,0:06:45.35,0:06:50.36,Default,,0,0,0,,Е, Видель-сан, сен мұны қайталай алмайсың.
Dialogue: 0,0:06:50.36,0:06:55.36,Default,,0,0,0,,Тамақты мен жасаймын, Видель-сан осында демалсын.
Dialogue: 0,0:06:55.36,0:06:58.36,Default,,0,0,0,,Таңертең тамақ дайындаған дұрыс деп айтпадың ба?
Dialogue: 0,0:06:58.36,0:07:01.37,Default,,0,0,0,,Жоқ, жоқ. Өзіңізді құрсақта сәби болуға мәжбүрлеңіз →
Dialogue: 0,0:07:01.37,0:07:04.37,Default,,0,0,0,,Бірдеңе бола қалса, бұл апат болар еді.
Dialogue: 0,0:07:04.37,0:07:06.39,Default,,0,0,0,,Бұл ана үшін де проблема.
Dialogue: 0,0:07:06.39,0:07:10.31,Default,,0,0,0,,Бір сәт көзіңді алсаң, мынаны көресің.
Dialogue: 0,0:07:10.31,0:07:14.31,Default,,0,0,0,,Мен тамақ жасап жатқанда анамды бақылаңыз.
Dialogue: 0,0:07:16.32,0:07:21.32,Default,,0,0,0,,Жарайды... Жарайды, мен жетемін.
Dialogue: 0,0:07:21.32,0:07:24.32,Default,,0,0,0,,Уфуфу Сіз қиналған әкесіз.
Dialogue: 0,0:07:24.32,0:07:28.33,Default,,0,0,0,,Біз печенье жеп, бірге күтеміз бе?
Dialogue: 0,0:07:28.33,0:07:31.33,Default,,0,0,0,,Мм... Рецепт Рецепт бұл...
Dialogue: 0,0:07:31.33,0:07:32.93,Default,,0,0,0,,Ойнайық. Әйтеуір біз пианисттер ғой.
Dialogue: 0,0:07:44.34,0:07:49.35,Default,,0,0,0,,《Ол одан асып түсті. Super Saiyan Құдайдың патшалығы》→
Dialogue: 0,0:07:49.35,0:07:53.35,Default,,0,0,0,,《Бееруспен күресу және даму》
Dialogue: 0,0:07:55.36,0:07:59.36,Default,,0,0,0,,《Какарот... Мен сенен міндетті түрде асып түсемін》
Dialogue: 0,0:08:02.60,0:08:06.33,Default,,0,0,0,,Мм. Иә иә.
Dialogue: 0,0:08:06.33,0:08:10.20,Default,,0,0,0,,Хо. Мұрын шашы да проблема емес. →
Dialogue: 0,0:08:10.20,0:08:12.20,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:16.21,0:08:18.21,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:18.21,0:08:21.21,Default,,0,0,0,,Жарайды, мен біраз уақытқа барайын.
Dialogue: 0,0:08:27.22,0:08:29.22,Default,,0,0,0,,Кун!
Dialogue: 0,0:08:29.22,0:08:31.22,Default,,0,0,0,,Иә? Жарайды, жарайды.
Dialogue: 0,0:08:31.22,0:08:34.23,Default,,0,0,0,,Барлығы Шайтан алаңына жиналды. →
Dialogue: 0,0:08:34.23,0:08:39.23,Default,,0,0,0,,Ал теледидардың арғы жағындағы барлық адамдар, бүкіл жер бетінде. →
Dialogue: 0,0:08:39.23,0:08:42.24,Default,,0,0,0,,Жерді соққан жұмбақ құбылыс қандай болды?
Dialogue: 0,0:08:42.24,0:08:46.24,Default,,0,0,0,,Шындық ашылғалы тұр!
Dialogue: 0,0:08:46.24,0:08:48.24,Default,,0,0,0,,≪ (Модератор) Ах. →
Dialogue: 0,0:08:48.24,0:08:52.25,Default,,0,0,0,,Біздің кейіпкеріміз Шайтан мырза келді!
Dialogue: 0,0:08:52.25,0:08:55.25,Default,,0,0,0,,
Dialogue: 0,0:08:55.25,0:08:59.25,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:59.25,0:09:02.26,Default,,0,0,0,,Бұрылыс! Бұрылыс! →
Dialogue: 0,0:09:02.26,0:09:07.29,Default,,0,0,0,,Бұрылыс! Бұрылыс! Бұрылыс….
Dialogue: 0,0:09:07.29,0:09:09.29,Default,,0,0,0,,Ха ха….
Dialogue: 0,0:09:13.30,0:09:15.30,Default,,0,0,0,,Жерге жетуімізге 13 минут қалды.
Dialogue: 0,0:09:15.30,0:09:18.30,Default,,0,0,0,,Сол жұлдызда біздің жауымыз →
Dialogue: 0,0:09:18.30,0:09:21.30,Default,,0,0,0,,Бұл нәсіл жоқ, солай ма?
Dialogue: 0,0:09:24.31,0:09:27.31,Default,,0,0,0,,Жарайды. Олардың интеллект деңгейі бізбен бірдей →
Dialogue: 0,0:09:27.31,0:09:29.32,Default,,0,0,0,,Бұл нәсіл жоқ.
Dialogue: 0,0:09:29.32,0:09:31.32,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:33.32,0:09:38.32,Default,,0,0,0,,Бұрылыс! Бұрылыс! Бұрылыс!
Dialogue: 0,0:09:38.32,0:09:42.33,Default,,0,0,0,,Иә! (қол шапалақтау/қолдау)
Dialogue: 0,0:09:42.33,0:09:44.33,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:09:44.33,0:09:47.33,Default,,0,0,0,,Шайтан мырза. Шаршаған кезде келгеніңіз үшін рахмет →
Dialogue: 0,0:09:47.33,0:09:49.34,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:09:49.34,0:09:52.34,Default,,0,0,0,,Бірден, өткен күні болған сол жұмбақ құбылыс→
Dialogue: 0,0:09:52.34,0:09:55.34,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:09:55.34,0:09:57.34,Default,,0,0,0,,Иә? Ха….
Dialogue: 0,0:09:57.34,0:09:59.35,Default,,0,0,0,,Бұл Жоюшы Құдайдың ісі!
Dialogue: 0,0:09:59.35,0:10:01.35,Default,,0,0,0,,Ах... Жоюшы Құдай?
Dialogue: 0,0:10:01.35,0:10:03.35,Default,,0,0,0,,Не? сол.
Dialogue: 0,0:10:05.35,0:10:09.29,Default,,0,0,0,,Жою құдайы құдай ма, әлде бір нәрсе ме?
Dialogue: 0,0:10:09.29,0:10:11.29,Default,,0,0,0,,Ах! Әрине!
Dialogue: 0,0:10:11.29,0:10:12.96,Default,,0,0,0,,Өз есіміңді ғаламға таныт→
Dialogue: 0,0:10:12.96,0:10:16.20,Default,,0,0,0,,Бұл жойқын зұлым құдайдың шабуылы болды.
Dialogue: 0,0:10:16.20,0:10:18.20,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:10:18.20,0:10:23.20,Default,,0,0,0,,Жою Құдайы Би… Би…→
Dialogue: 0,0:10:23.20,0:10:26.21,Default,,0,0,0,,B… B….
Dialogue: 0,0:10:26.21,0:10:30.21,Default,,0,0,0,,Қалай болғанда да, Жоюшы Құдай өзінің келесі нысанасын таңдады...
Dialogue: 0,0:10:30.21,0:10:33.21,Default,,0,0,0,,Уау! Бұл жер болды!
Dialogue: 0,0:10:33.21,0:10:36.22,Default,,0,0,0,,Мен бірінші болып → екенін түсіндім
Dialogue: 0,0:10:36.22,0:10:40.22,Default,,0,0,0,,Жою Құдайы Би... Би... Би~→
Dialogue: 0,0:10:40.22,0:10:44.22,Default,,0,0,0,,Мен... → тұратын жерін анықтадым
Dialogue: 0,0:10:44.22,0:10:47.23,Default,,0,0,0,,Иә! Бұл қиыр оңтүстік теңіз.
Dialogue: 0,0:10:47.23,0:10:49.23,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:10:49.23,0:10:54.23,Default,,0,0,0,,Мен сол жаққа бет алдым да, қирау құдайына тап болдым, Бибіс!
Dialogue: 0,0:10:54.23,0:10:57.23,Default,,0,0,0,,Жою үшін қолынан келгеннің бәрін жасайтын зұлым құдаймен!
Dialogue: 0,0:10:59.24,0:11:02.24,Default,,0,0,0,,Сол денеден зұлымдықтың зор аурасы шығады→
Dialogue: 0,0:11:02.24,0:11:04.24,Default,,0,0,0,,Ол шығарылды!
Dialogue: 0,0:11:04.24,0:11:06.25,Default,,0,0,0,,Уау... Уау! →
Dialogue: 0,0:11:06.25,0:11:10.18,Default,,0,0,0,,Иә. Ааа сынақ тесті.
Dialogue: 0,0:11:10.18,0:11:14.18,Default,,0,0,0,,Бірақ мен іркілмей соған қарай бет алдым!
Dialogue: 0,0:11:18.19,0:11:20.19,Default,,0,0,0,,《Ааа! 》
Dialogue: 0,0:11:20.19,0:11:22.20,Default,,0,0,0,,《Ғұн》 《Ша! 》
Dialogue: 0,0:11:22.20,0:11:25.20,Default,,0,0,0,,《Ха! 》
Dialogue: 0,0:11:25.20,0:11:29.20,Default,,0,0,0,,Адал болайық. Қолымды да, аяғымды да қозғалта алмадым.
Dialogue: 0,0:11:29.20,0:11:32.21,Default,,0,0,0,,Шайтан мырза? (Еркек) Міне...
Dialogue: 0,0:11:32.21,0:11:35.21,Default,,0,0,0,,Біз шарасыз жағдайдамыз.
Dialogue: 0,0:11:35.21,0:11:38.21,Default,,0,0,0,,Бірақ содан кейін бір керемет болды.
Dialogue: 0,0:11:38.21,0:11:42.22,Default,,0,0,0,,Денемнің түбінен зор күш көтеріледі...
Dialogue: 0,0:11:42.22,0:11:46.22,Default,,0,0,0,,《Ооооооо...》
Dialogue: 0,0:11:46.22,0:11:50.22,Default,,0,0,0,,《Ооооо...》
Dialogue: 0,0:11:50.22,0:11:54.23,Default,,0,0,0,,《Ха! Ха! Ха! 》
Dialogue: 0,0:11:54.23,0:11:58.23,Default,,0,0,0,,Мен құдайға айналдым!
Dialogue: 0,0:11:58.23,0:12:00.23,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:12:00.23,0:12:02.24,Default,,0,0,0,,[Теледидар] (Барлығы) Бұрылыс…. (Каме Эрмит) Хмм.
Dialogue: 0,0:12:02.24,0:12:04.24,Default,,0,0,0,,[Теледидар] (Барлығы) Бұрылыс….
Dialogue: 0,0:12:04.24,0:12:06.24,Default,,0,0,0,,Бұл қызықсыз... →
Dialogue: 0,0:12:06.24,0:12:08.17,Default,,0,0,0,,Почитто.
Dialogue: 0,0:12:08.17,0:12:10.18,Default,,0,0,0,,《Уау! 》
Dialogue: 0,0:12:10.18,0:12:12.18,Default,,0,0,0,,Құдайға айналған маған →
Dialogue: 0,0:12:12.18,0:12:16.18,Default,,0,0,0,,Ол қиратушы құдай болса да, ол менің жауым емес еді!
Dialogue: 0,0:12:16.18,0:12:19.19,Default,,0,0,0,,《Дададада...》→
Dialogue: 0,0:12:19.19,0:12:21.19,Default,,0,0,0,,《Ха~! 》
Dialogue: 0,0:12:21.19,0:12:25.19,Default,,0,0,0,,Иә! О! Жыртып тастаңыз! Жыртып тастаңыз!
Dialogue: 0,0:12:25.19,0:12:28.19,Default,,0,0,0,,《Да! ! 》
Dialogue: 0,0:12:28.19,0:12:30.20,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:12:30.20,0:12:33.20,Default,,0,0,0,,Сіз Бибісті сәтті тойтардыңыз!
Dialogue: 0,0:12:33.20,0:12:35.20,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:12:35.20,0:12:37.20,Default,,0,0,0,,Ми... Шайтан мырза.
Dialogue: 0,0:12:37.20,0:12:42.21,Default,,0,0,0,,Сол жұмбақ құбылыстың артында мұндай шайқас жатқанын білмедім.
Dialogue: 0,0:12:42.21,0:12:45.21,Default,,0,0,0,,Бұл шындық!
Dialogue: 0,0:12:45.21,0:12:49.22,Default,,0,0,0,,Жерді тағы да Шайтан мырза құтқарды.
Dialogue: 0,0:12:49.22,0:12:52.22,Default,,0,0,0,,Шайтан….
Dialogue: 0,0:12:52.22,0:12:55.22,Default,,0,0,0,,Иә? Не? Бұл.
Dialogue: 0,0:12:55.22,0:12:57.22,Default,,0,0,0,,Бұл метеорит пе?
Dialogue: 0,0:12:57.22,0:13:00.22,Default,,0,0,0,,Мұнда кел! Апыр-ай!
Dialogue: 0,0:13:03.23,0:13:06.23,Default,,0,0,0,,Шайтан мырза, жүгіріңіз!
Dialogue: 0,0:13:08.17,0:13:10.17,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:13:18.18,0:13:20.18,Default,,0,0,0,,Ғарыш кемесі?
Dialogue: 0,0:13:23.18,0:13:25.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:25.52,0:13:27.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:29.19,0:13:33.19,Default,,0,0,0,,Бұл бөтен адам! Бөтен адам пайда болды!
Dialogue: 0,0:15:18.36,0:15:21.37,Default,,0,0,0,,Шетелдіктер? (Еркек) Жауды өлтіруге келдің бе?
Dialogue: 0,0:15:21.37,0:15:23.37,Default,,0,0,0,,Жау….
Dialogue: 0,0:15:28.37,0:15:31.37,Default,,0,0,0,,Елші Сіз келген сияқтысыз.
Dialogue: 0,0:15:38.38,0:15:41.39,Default,,0,0,0,,Сәлем! О... Эй!
Dialogue: 0,0:15:41.39,0:15:43.39,Default,,0,0,0,,Өтінемін. (Елші) Хмм.
Dialogue: 0,0:15:43.39,0:15:46.39,Default,,0,0,0,,Сәлем! (Елші) А?
Dialogue: 0,0:15:46.39,0:15:48.39,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:15:50.40,0:15:53.40,Default,,0,0,0,,Сәлем! (хатшы) Иә.
Dialogue: 0,0:15:53.40,0:15:56.40,Default,,0,0,0,,Ха~ Қайда барсам да осы.
Dialogue: 0,0:15:56.40,0:15:59.41,Default,,0,0,0,,Менің бетім шынымен де қорқынышты ма?
Dialogue: 0,0:15:59.41,0:16:02.41,Default,,0,0,0,,Барлығына! Қорықпа. →
Dialogue: 0,0:16:02.41,0:16:05.41,Default,,0,0,0,,Бұл адам Сунак планетасының елшісі. →
Dialogue: 0,0:16:05.41,0:16:10.43,Default,,0,0,0,,Мен бұл планетада жойылу құдайы Берусты жеңген бір батыр бар деп естідім→
Dialogue: 0,0:16:10.43,0:16:12.35,Default,,0,0,0,,Сәлем беруге келдім.
Dialogue: 0,0:16:12.35,0:16:14.35,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:16:14.35,0:16:16.36,Default,,0,0,0,,Сен мұнда жауды өлтіру үшін келдің...
Dialogue: 0,0:16:16.36,0:16:20.36,Default,,0,0,0,,Соның дәлелі ретінде Сунаку бөтен адам, маған үлкен құрмет пен сәлем жолдаңыз→
Dialogue: 0,0:16:20.36,0:16:22.36,Default,,0,0,0,,Маған көрсетейін.
Dialogue: 0,0:16:22.36,0:16:27.37,Default,,0,0,0,,Су~су~су~ на~на~на~→
Dialogue: 0,0:16:27.37,0:16:30.37,Default,,0,0,0,,Куууууун!
Dialogue: 0,0:16:33.37,0:16:39.38,Default,,0,0,0,,Біреу біледі ме? Қиратушы Құдайды жеңген батыр.
Dialogue: 0,0:16:39.38,0:16:41.38,Default,,0,0,0,,О...
Dialogue: 0,0:16:41.38,0:16:44.38,Default,,0,0,0,,Жоюшы Құдайды тойтарған мен болдым.
Dialogue: 0,0:16:44.38,0:16:47.38,Default,,0,0,0,,Сіз? (Хатшы) Елші!
Dialogue: 0,0:16:49.39,0:16:51.39,Default,,0,0,0,,О.
Dialogue: 0,0:16:51.39,0:16:55.39,Default,,0,0,0,,Жақсы, сізбен танысқаным мақтаныш.
Dialogue: 0,0:16:55.39,0:16:59.40,Default,,0,0,0,,Жерді жойылу Құдайынан қорғау үшін ғарышта үлкен беделге ие.
Dialogue: 0,0:16:59.40,0:17:05.40,Default,,0,0,0,,Ахаха... Осы Шайтанға ғашық болсаң, Жоюшы Құдай енді сенің жауың емес.
Dialogue: 0,0:17:05.40,0:17:09.41,Default,,0,0,0,,Сондықтан біз сіздердің жетістіктеріңізді мадақтаймыз→
Dialogue: 0,0:17:09.41,0:17:12.41,Default,,0,0,0,,Мен сендерге осы батырдың медалін бергім келеді.
Dialogue: 0,0:17:15.35,0:17:19.35,Default,,0,0,0,,қараңыз. Біздің кейіпкеріміз Шайтан мырза →
Dialogue: 0,0:17:19.35,0:17:22.35,Default,,0,0,0,,Ол енді ғаламның қаһарманы.
Dialogue: 0,0:17:22.35,0:17:24.36,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:24.36,0:17:26.36,Default,,0,0,0,,Не!
Dialogue: 0,0:17:28.36,0:17:30.36,Default,,0,0,0,,Бұл Гарби!
Dialogue: 0,0:17:30.36,0:17:32.36,Default,,0,0,0,,Батырмен қол алыспай→
Dialogue: 0,0:17:32.36,0:17:34.37,Default,,0,0,0,,Жаңа кейіпкерді тануға болмайды. →
Dialogue: 0,0:17:34.37,0:17:40.37,Default,,0,0,0,,Егер ол адам нағыз батыр болса, оның бізге күш-қуатын көрсету оңай болады.
Dialogue: 0,0:17:40.37,0:17:44.38,Default,,0,0,0,,Хмм…. Менің бір өтінішім бар...
Dialogue: 0,0:17:44.38,0:17:49.38,Default,,0,0,0,,Мен Сунаку планетамның кейіпкері Гарбимен аранжировка жасағым келеді.
Dialogue: 0,0:17:49.38,0:17:51.38,Default,,0,0,0,,Сәлем! 《Бұл әзіл емес. 》→
Dialogue: 0,0:17:51.38,0:17:54.39,Default,,0,0,0,,《Мен бұлай біреумен ұрыса алмаймын.》
Dialogue: 0,0:17:54.39,0:17:56.39,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:17:56.39,0:17:58.39,Default,,0,0,0,,Е, а, бірақ→
Dialogue: 0,0:17:58.39,0:18:02.39,Default,,0,0,0,,Мен жойылу Құдайымен күресуден әлі шаршадым...
Dialogue: 0,0:18:02.39,0:18:05.40,Default,,0,0,0,,Ой! Шайтан мырза Құдайдың құдіретіне ие болды →
Dialogue: 0,0:18:05.40,0:18:08.40,Default,,0,0,0,,Сунак планетасының кейіпкері сынаққа түседі!
Dialogue: 0,0:18:08.40,0:18:10.42,Default,,0,0,0,,Бақа, ақымақ! Тоқта!
Dialogue: 0,0:18:10.42,0:18:12.34,Default,,0,0,0,,Бұрылыс! Бұрылыс!
Dialogue: 0,0:18:12.34,0:18:17.34,Default,,0,0,0,,《Мен не істеуім керек? Осы кезде менің құрметім...
Dialogue: 0,0:18:17.34,0:18:20.35,Default,,0,0,0,,《Иә! 》 Уф!
Dialogue: 0,0:18:20.35,0:18:24.35,Default,,0,0,0,,Менің ішім кенет ауырып кетті! дәретхана!
Dialogue: 0,0:18:24.35,0:18:28.35,Default,,0,0,0,,[ТЕЛ] (қоңырау үні) Гохан-кун, Гохан-кун шықшы.
Dialogue: 0,0:18:28.35,0:18:32.36,Default,,0,0,0,,[ТЕЛ] (дірілдеткіш дыбысы) Уау! Ававауа….
Dialogue: 0,0:18:32.36,0:18:34.36,Default,,0,0,0,,Су, су, су!
Dialogue: 0,0:18:34.36,0:18:38.36,Default,,0,0,0,,Бұл біртүрлі. Содан кейін бұл Вегета.
Dialogue: 0,0:18:38.36,0:18:42.37,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:18:42.37,0:18:44.37,Default,,0,0,0,,Неліктен ешкім көрінбейді?
Dialogue: 0,0:18:44.37,0:18:47.37,Default,,0,0,0,,Шайтан мырза, амансыз ба?
Dialogue: 0,0:18:47.37,0:18:49.67,Default,,0,0,0,,≪Жарайды! Мен жақында ораламын!
Dialogue: 0,0:18:51.38,0:18:55.38,Default,,0,0,0,,《Жаман. Мен не істеуім керек...》
Dialogue: 0,0:18:55.38,0:18:57.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:57.38,0:19:00.39,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:00.39,0:19:02.39,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:02.39,0:19:05.39,Default,,0,0,0,,Біз сендерге алаң дайындадық. →
Dialogue: 0,0:19:05.39,0:19:08.39,Default,,0,0,0,,Көңіліңіз жеткенше күресіңіз.
Dialogue: 0,0:19:08.39,0:19:10.36,Default,,0,0,0,,Біздің кейіпкеріміз Гарби→
Dialogue: 0,0:19:10.36,0:19:14.23,Default,,0,0,0,,Толығымен алыс жерде біз қаншалықты алыстай аламыз?
Dialogue: 0,0:19:14.23,0:19:17.24,Default,,0,0,0,,《Жаман, жаман...》
Dialogue: 0,0:19:17.24,0:19:19.24,Default,,0,0,0,,《Жер бетіндегі ең күшті жекпе-жек шебері күткендей》→
Dialogue: 0,0:19:19.24,0:19:21.24,Default,,0,0,0,,《Мен ешқандай қуат сезбеймін》→
Dialogue: 0,0:19:21.24,0:19:25.24,Default,,0,0,0,,《Бір қарағанда, олқылықтар өте көп》
Dialogue: 0,0:19:25.24,0:19:27.25,Default,,0,0,0,,Серіктесті сұраңыз!
Dialogue: 0,0:19:27.25,0:19:30.25,Default,,0,0,0,,Ойын басталды! ? Йо, йо, хо, хо.
Dialogue: 0,0:19:30.25,0:19:33.25,Default,,0,0,0,,Әлі дайын емес сияқты.
Dialogue: 0,0:19:33.25,0:19:35.25,Default,,0,0,0,,《ku～》→
Dialogue: 0,0:19:35.25,0:19:39.26,Default,,0,0,0,,《Мүмкін бұл → ішінде Гоку немесе Вегета бар шығар
Dialogue: 0,0:19:39.26,0:19:42.26,Default,,0,0,0,,Әйтпесе, Криллин-кун немесе анау жасыл жігіт...→
Dialogue: 0,0:19:42.26,0:19:45.26,Default,,0,0,0,,Бұл жағдайда тіпті Goten немесе Trunks...》
Dialogue: 0,0:19:45.26,0:19:47.27,Default,,0,0,0,,Енді шайқас!
Dialogue: 0,0:19:47.27,0:19:50.27,Default,,0,0,0,,Йо, йо, фу!
Dialogue: 0,0:19:50.27,0:19:52.27,Default,,0,0,0,,Әлі дайын емес сияқты.
Dialogue: 0,0:19:52.27,0:19:55.27,Default,,0,0,0,,Иә? Сіз не істеп жатырсыз, Шайтан мырза?
Dialogue: 0,0:19:57.28,0:20:00.28,Default,,0,0,0,,Йо-йо-ху.
Dialogue: 0,0:20:00.28,0:20:04.28,Default,,0,0,0,,《Жақсы емес...》 ≪Сәттілік Сатан мырза!
Dialogue: 0,0:20:06.29,0:20:08.29,Default,,0,0,0,,Иә! 《Гоку-сан! 》→
Dialogue: 0,0:20:08.29,0:20:12.32,Default,,0,0,0,,《О, бұл шынымен де Құдайдың көмегі》
Dialogue: 0,0:20:12.32,0:20:14.33,Default,,0,0,0,,Не болды? (Еркек) Бұл кім? Сол жігіт.
Dialogue: 0,0:20:14.33,0:20:16.33,Default,,0,0,0,,Сіз Шайтанның шәкіртісіз бе?
Dialogue: 0,0:20:16.33,0:20:19.33,Default,,0,0,0,,Жақсы, сіз дұрыс жерге келдіңіз.
Dialogue: 0,0:20:19.33,0:20:22.33,Default,,0,0,0,,Бұл зат бұзылған.
Dialogue: 0,0:20:22.33,0:20:25.34,Default,,0,0,0,,Гүлдеп тұрған адамның үйіне бардым, бірақ ешкім жоқ.\NӨйткені мен сені
Dialogue: 0,0:20:25.34,0:20:29.34,Default,,0,0,0,,-де көрдім. Бұл түзетілді ме?
Dialogue: 0,0:20:29.34,0:20:31.34,Default,,0,0,0,,Тағы да...?
Dialogue: 0,0:20:31.34,0:20:35.35,Default,,0,0,0,,Қолдарыңыз жақсы ма? өтінемін
Dialogue: 0,0:20:35.35,0:20:39.35,Default,,0,0,0,,Одан гөрі, Гоку-сан, сен мен үшін бірдеңе жасағың келе ме?
Dialogue: 0,0:20:39.35,0:20:41.35,Default,,0,0,0,,А, сен ше?
Dialogue: 0,0:20:41.35,0:20:43.36,Default,,0,0,0,,Сіз қалай ойлайсыз? Күшті сияқты.
Dialogue: 0,0:20:43.36,0:20:45.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:47.36,0:20:49.36,Default,,0,0,0,,Жоқ, бірақ бұл Шайтан мырза→
Dialogue: 0,0:20:49.36,0:20:51.36,Default,,0,0,0,,Бұл сіздің сәйкестігіңіз.
Dialogue: 0,0:20:51.36,0:20:54.37,Default,,0,0,0,,Жарайды, ұстанудың қажеті жоқ.
Dialogue: 0,0:20:54.37,0:20:56.37,Default,,0,0,0,,Мен мұны кез келген уақытта істей аламын.
Dialogue: 0,0:20:56.37,0:20:59.37,Default,,0,0,0,,Олай болса, мен сізге біраз уақытқа рұқсат етемін деп ойлаймын.
Dialogue: 0,0:20:59.37,0:21:02.37,Default,,0,0,0,,Негізі мен сені жаттығуға жібере алмадым →
Dialogue: 0,0:21:02.37,0:21:05.38,Default,,0,0,0,,Денем қышиды. жақсы…. →
Dialogue: 0,0:21:05.38,0:21:09.38,Default,,0,0,0,,Гарбимен! Біріншіден, бұл адам менің қарсыласым! →
Dialogue: 0,0:21:09.38,0:21:12.32,Default,,0,0,0,,Менімен күресуге жарамды екеніңді көрейін.
Dialogue: 0,0:21:12.32,0:21:15.32,Default,,0,0,0,,Не? Сіз сондай әуесқоймен күрескіңіз келе ме?
Dialogue: 0,0:21:15.32,0:21:17.32,Default,,0,0,0,,Бұл таңқаларлық оқиға.
Dialogue: 0,0:21:17.32,0:21:22.33,Default,,0,0,0,,Иә. Қалай қарасаң да, ауылдан келген қарияға ұқсайды.
Dialogue: 0,0:21:22.33,0:21:27.33,Default,,0,0,0,,Қандай қорлық. Мен ешқашан мұндай қарым-қатынасты күтпедім ...
Dialogue: 0,0:21:27.33,0:21:31.34,Default,,0,0,0,,《Қазір қара. Мен сені үрлеймін! 》
Dialogue: 0,0:21:31.34,0:21:36.34,Default,,0,0,0,,Олай болса, бастайық! Маған кез келген жерден қоңырау шалыңыз!
Dialogue: 0,0:21:36.34,0:21:38.34,Default,,0,0,0,,Егер сіз осынша көп сатып алсаңыз→
Dialogue: 0,0:21:38.34,0:21:42.35,Default,,0,0,0,,Гохан мен басқалары әзірге тамақ туралы уайымдамауы керек.
Dialogue: 0,0:21:42.35,0:21:44.35,Default,,0,0,0,,Қарғыс атқыр... неге мен?
Dialogue: 0,0:21:44.35,0:21:48.35,Default,,0,0,0,,Тегін тамақ ішіп жатқанда, анда-санда қыдырып тұру керек.
Dialogue: 0,0:21:48.35,0:21:50.36,Default,,0,0,0,,Видельге тамақ беріп, оны дені сау сәби етіңіз→
Dialogue: 0,0:21:50.36,0:21:52.36,Default,,0,0,0,,Мен босануым керек. ≪(қуаныш)
Dialogue: 0,0:21:52.36,0:21:54.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.03,0:21:56.26,Default,,0,0,0,,Немерем! иә?
Dialogue: 0,0:21:56.26,0:21:58.26,Default,,0,0,0,,Шайтан мырзаның агенті. →
Dialogue: 0,0:21:58.26,0:22:00.27,Default,,0,0,0,,Бұл үлкен сенімділік!
Dialogue: 0,0:22:00.27,0:22:05.27,Default,,0,0,0,,Гоку! Ондай жерде не істеп жүрсің?
Dialogue: 0,0:22:05.27,0:22:07.27,Default,,0,0,0,,Иә! ? Чичи….
Dialogue: 0,0:22:07.27,0:22:09.27,Default,,0,0,0,,О, жоқ... Шайтан мырза!
Dialogue: 0,0:22:09.27,0:22:13.21,Default,,0,0,0,,Егер олар менің ұшып бара жатқанымды білсе, мен жынды боламын, сондықтан мені жұдырықпен ұрыңыз.
Dialogue: 0,0:22:13.21,0:22:16.22,Default,,0,0,0,,Иә! ? тез! Асықшы!
Dialogue: 0,0:22:16.22,0:22:18.22,Default,,0,0,0,,Ах… иә…. →
Dialogue: 0,0:22:18.22,0:22:21.22,Default,,0,0,0,,Шайтан соққысы!
Dialogue: 0,0:22:21.22,0:22:26.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:26.23,0:22:29.23,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:22:29.23,0:22:31.23,Default,,0,0,0,,Гоку! Сен қашып кеттің.
Dialogue: 0,0:22:31.23,0:22:34.23,Default,,0,0,0,,Ху... Гоку-сан...
Dialogue: 0,0:22:34.23,0:22:37.24,Default,,0,0,0,,О, тамаша техника!
Dialogue: 0,0:22:37.24,0:22:40.24,Default,,0,0,0,,Міне кеттік! Өте бәсекеге қабілетті!
Dialogue: 0,0:22:40.24,0:22:42.01,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:22:42.01,0:22:45.24,Default,,0,0,0,,Ой, кенеттен ойын басталды.
Dialogue: 0,0:22:45.24,0:22:48.25,Default,,0,0,0,,Шайтан мырза Гарбидің шабуылынан жалтарады!
Dialogue: 0,0:22:48.25,0:22:50.25,Default,,0,0,0,,Шайтан мырза күткендей!
Dialogue: 0,0:22:50.25,0:22:53.25,Default,,0,0,0,,Қарсыласыңмен ара қашықтықты өлшеп жатырсың ба?
Dialogue: 0,0:22:53.25,0:22:55.25,Default,,0,0,0,,Сіз осылай жұдырық ала аласыз ба?
Dialogue: 0,0:22:55.25,0:22:58.26,Default,,0,0,0,,Шайтан Құдайдың құдіретін сақтайды! →
Dialogue: 0,0:22:58.26,0:23:01.26,Default,,0,0,0,,Бұл қандай да бір стратегия ма? ?
Dialogue: 0,0:23:01.26,0:23:03.26,Default,,0,0,0,,Сен неге шабуыл жасамайсың?
Dialogue: 0,0:23:03.26,0:23:05.26,Default,,0,0,0,,Сіз қорқып жатқан шығарсыз?
Dialogue: 0,0:23:05.26,0:23:07.27,Default,,0,0,0,,《Жаман! 》
Dialogue: 0,0:23:07.27,0:23:11.20,Default,,0,0,0,,Сіз Қиратушы Құдайды шынымен жеңдіңіз бе?
Dialogue: 0,0:23:11.20,0:23:14.21,Default,,0,0,0,,《Осы қарқынмен намысым кетеді...》→
Dialogue: 0,0:23:14.21,0:23:16.21,Default,,0,0,0,,《Оны істеуден басқа амалымыз жоқ! 》
Dialogue: 0,0:23:18.21,0:23:21.21,Default,,0,0,0,,《Қашпа, шайтан. Сіз жасай аласыз →
Dialogue: 0,0:23:21.21,0:23:24.22,Default,,0,0,0,,《Сіз оны сол кезде де тоқтатуға болар еді》→
Dialogue: 0,0:23:24.22,0:23:27.22,Default,,0,0,0,,《Сіз Видельді қорғадыңыз》→
Dialogue: 0,0:23:27.22,0:23:34.23,Default,,0,0,0,,《Мен саған рұқсат бермеймін! Мен сізге міндетті түрде рұқсат етемін! 》
Dialogue: 0,0:23:34.23,0:23:37.23,Default,,0,0,0,,Мен саған Құдайдың құдіретін көрсетемін!
Dialogue: 0,0:23:37.23,0:23:42.23,Default,,0,0,0,,Оооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:23:42.23,0:23:44.24,Default,,0,0,0,,Сіз құдай болдыңыз ба? ?
Dialogue: 0,0:23:44.24,0:23:46.24,Default,,0,0,0,,Уау...!
Dialogue: 0,0:23:46.24,0:23:50.24,Default,,0,0,0,,Иә! Мен Құдаймын!
Dialogue: 0,0:23:50.24,0:23:52.24,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:23:57.25,0:24:00.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:00.25,0:24:02.25,Default,,0,0,0,,《Не? мүмкіндік»
Dialogue: 0,0:24:02.25,0:24:05.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:05.26,0:24:07.26,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,0:24:09.26,0:24:13.20,Default,,0,0,0,,Ха ха ха ха... Бір!
Dialogue: 0,0:24:13.20,0:24:15.20,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:24:15.20,0:24:18.20,Default,,0,0,0,,Хмм! ? Мен иттерді жек көремін!
Dialogue: 0,0:24:18.20,0:24:20.21,Default,,0,0,0,,О... Эй.
Dialogue: 0,0:24:20.21,0:24:23.21,Default,,0,0,0,,Уайымдамаңыз. Олар сол жарыс сияқты озық емес.
Dialogue: 0,0:24:23.21,0:24:25.21,Default,,0,0,0,,Бір…. (Хатшы/Елші) Гах! !
Dialogue: 0,0:24:25.21,0:24:29.21,Default,,0,0,0,,Елші, қош болыңыз!
Dialogue: 0,0:24:31.22,0:24:36.22,Default,,0,0,0,,Су~су~су~ на~на~на~→
Dialogue: 0,0:24:36.22,0:24:39.22,Default,,0,0,0,,Куууууун!
Dialogue: 0,0:24:44.23,0:24:46.23,Default,,0,0,0,,Аа...
Dialogue: 0,0:24:46.23,0:24:50.24,Default,,0,0,0,,Мен қорқамын~ ит~.
Dialogue: 0,0:24:50.24,0:24:55.24,Default,,0,0,0,,Сол жарысты жеңу үшін ондаған мың жыл қажет сияқты.
Dialogue: 0,0:24:55.24,0:24:57.24,Default,,0,0,0,,Хмм….
Dialogue: 0,0:24:57.24,0:25:01.25,Default,,0,0,0,,Шайтан мырзаның соққысы Галбиді шошытып, шегінді.
Dialogue: 0,0:25:01.25,0:25:04.25,Default,,0,0,0,,Әлде... жеңдіңіз бе...?
Dialogue: 0,0:25:04.25,0:25:07.25,Default,,0,0,0,,Кун. иә?
Dialogue: 0,0:25:14.26,0:25:18.26,Default,,0,0,0,,Сіз оны көрдіңіз бе? Бұл Құдайдың құдіретіне ие болды →
Dialogue: 0,0:25:18.26,0:25:21.27,Default,,0,0,0,,Шайтанның күші! (қуаныш)
Dialogue: 0,0:25:21.27,0:25:23.27,Default,,0,0,0,,Шайтан мырза, толық жеңіс!
Dialogue: 0,0:25:23.27,0:25:25.27,Default,,0,0,0,,Бұрылыс…. 《Жақсы~》
Dialogue: 0,0:25:25.27,0:25:28.27,Default,,0,0,0,,Әке, кеш болды.
Dialogue: 0,0:25:28.27,0:25:30.28,Default,,0,0,0,,Жұмыс Қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:25:30.28,0:25:34.28,Default,,0,0,0,,Сен қайтып келсең, демалсын!
Dialogue: 0,0:25:34.28,0:25:37.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:37.28,0:25:42.29,Default,,0,0,0,,Кешіріңіз. Мен бүгін үйге бара алмаймын деп ойлаймын.
Dialogue: 0,0:25:42.29,0:25:46.29,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:25:46.29,0:25:56.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:48.29,0:26:50.29,Default,,0,0,0,,Сәлем, Гоку!
Dialogue: 0,0:26:50.29,0:26:53.29,Default,,0,0,0,,Өйткені, Беерус-самаға қарап, күшейе бер.
Dialogue: 0,0:26:53.29,0:26:56.29,Default,,0,0,0,,Менің жаттығуыма Чи-Чи тыйым салды.
Dialogue: 0,0:26:56.29,0:26:59.30,Default,,0,0,0,,Жарайды ма? Криллин мені қатты ұрды.
Dialogue: 0,0:26:59.30,0:27:01.30,Default,,0,0,0,,Менің қазіргі күшім әлі де жетпейді.
Dialogue: 0,0:27:01.30,0:27:04.30,Default,,0,0,0,,Беерус-саманы дайындаған шебер болса→
Dialogue: 0,0:27:04.30,0:27:06.30,Default,,0,0,0,,Ола да шәкірт.
Dialogue: 0,0:27:06.30,0:27:08.30,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:12.34,0:27:14.34,Default,,0,0,0,,Міндетті түрде тексеріңіз!
Dialogue: 0,0:27:15.84,0:27:21.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory