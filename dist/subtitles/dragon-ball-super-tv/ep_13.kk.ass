Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:32.80,0:01:42.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:10.23,0:04:14.23,Default,,0,0,0,,<Теңіздерді жарып, аспанды күйдіріп кеткен шайқас→
Dialogue: 0,0:04:14.23,0:04:18.23,Default,,0,0,0,,Соңында, соңғы кезең＞
Dialogue: 0,0:04:18.23,0:04:20.24,Default,,0,0,0,,<Сыралардың толық қуаты→
Dialogue: 0,0:04:20.24,0:04:25.24,Default,,0,0,0,,Гокуды баяу бұру>
Dialogue: 0,0:04:25.24,0:04:28.24,Default,,0,0,0,,Сіз жақсы орындадыңыз.
Dialogue: 0,0:04:30.25,0:04:32.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:34.25,0:04:37.25,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:04:37.25,0:04:41.26,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:04:41.26,0:04:43.26,Default,,0,0,0,,Ой! ?
Dialogue: 0,0:04:43.26,0:04:45.26,Default,,0,0,0,,Супер Сайян Құдайдың құдіреті →
Dialogue: 0,0:04:45.26,0:04:47.26,Default,,0,0,0,,Мен Олаға айттым.
Dialogue: 0,0:04:47.26,0:04:52.27,Default,,0,0,0,,Жоғары... Жоғары қарай жүріңіз!
Dialogue: 0,0:04:52.27,0:04:54.27,Default,,0,0,0,,Ааа!
Dialogue: 0,0:04:54.27,0:04:58.27,Default,,0,0,0,,Уф! Жоқ!
Dialogue: 0,0:04:58.27,0:05:01.28,Default,,0,0,0,,Ааа!
Dialogue: 0,0:05:01.28,0:05:05.28,Default,,0,0,0,,Яаааа!
Dialogue: 0,0:05:10.22,0:05:14.22,Default,,0,0,0,,<Екеуінің үлкен күштері бір-бірімен соқтығысады→
Dialogue: 0,0:05:14.22,0:05:19.22,Default,,0,0,0,,Ол ғаламды жоюға тырысты＞
Dialogue: 0,0:05:37.25,0:05:42.25,Default,,0,0,0,,Ха! иә? Ал ғарыш ше?
Dialogue: 0,0:05:42.25,0:05:44.25,Default,,0,0,0,,Гоку жақсы ма?
Dialogue: 0,0:05:44.25,0:05:46.26,Default,,0,0,0,,Үшінші соқтығыс →
Dialogue: 0,0:05:46.26,0:05:51.26,Default,,0,0,0,,Нақты іс басталатын сияқты. Қараңыз.
Dialogue: 0,0:05:53.26,0:05:55.26,Default,,0,0,0,,Ах!?
Dialogue: 0,0:06:00.27,0:06:03.27,Default,,0,0,0,,Кукуку… куку….
Dialogue: 0,0:06:03.27,0:06:05.27,Default,,0,0,0,,Куку...!
Dialogue: 0,0:06:10.21,0:06:14.21,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:06:16.22,0:06:19.22,Default,,0,0,0,,Ку… Куу….
Dialogue: 0,0:06:19.22,0:06:22.22,Default,,0,0,0,,Иә? Хмф!
Dialogue: 0,0:06:22.22,0:06:25.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:25.23,0:06:29.23,Default,,0,0,0,,Қарғыс атсын...! Гррр... Ха!
Dialogue: 0,0:06:34.24,0:06:38.24,Default,,0,0,0,,Иә. Нгг...
Dialogue: 0,0:06:40.24,0:06:43.25,Default,,0,0,0,,Иә. Хмф!
Dialogue: 0,0:06:43.25,0:06:45.25,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:06:47.25,0:06:49.25,Default,,0,0,0,,Кукку… куку….
Dialogue: 0,0:06:49.25,0:06:53.26,Default,,0,0,0,,Гугугугу...!
Dialogue: 0,0:06:53.26,0:06:56.26,Default,,0,0,0,,Гуаааа... ау!
Dialogue: 0,0:06:56.26,0:06:58.26,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:06:58.26,0:07:01.26,Default,,0,0,0,,Жарылыс дәл қазір Гоку мен Берус арасында болды →
Dialogue: 0,0:07:01.26,0:07:03.27,Default,,0,0,0,,Рухтардың керемет соқтығысуы кезінде→
Dialogue: 0,0:07:03.27,0:07:05.27,Default,,0,0,0,,Бұл жай ғана болды...
Dialogue: 0,0:07:05.27,0:07:12.21,Default,,0,0,0,,Бұл өте жоғары тығыздықтағы энергияны өндірді.
Dialogue: 0,0:07:12.21,0:07:14.21,Default,,0,0,0,,Егер бұл нәрсе пайда болса...
Dialogue: 0,0:07:14.21,0:07:19.21,Default,,0,0,0,,Бұл жолы дүние бітпейді.
Dialogue: 0,0:07:19.21,0:07:22.21,Default,,0,0,0,,Куку….
Dialogue: 0,0:07:26.22,0:07:29.22,Default,,0,0,0,,Gugggggggg….
Dialogue: 0,0:07:31.23,0:07:33.23,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:36.23,0:07:41.23,Default,,0,0,0,,Гах...!
Dialogue: 0,0:07:45.24,0:07:48.24,Default,,0,0,0,,Куу….
Dialogue: 0,0:07:55.25,0:07:57.25,Default,,0,0,0,,О...
Dialogue: 0,0:07:57.25,0:08:01.26,Default,,0,0,0,,қараңыз. Анықталмаған бұрмалау→
Dialogue: 0,0:08:01.26,0:08:05.26,Default,,0,0,0,,Шайтан-Ситиде ғана емес, бүкіл әлемде!
Dialogue: 0,0:08:05.26,0:08:09.20,Default,,0,0,0,,Бұл бір нәрсенің хабаршысы ма?
Dialogue: 0,0:08:09.20,0:08:21.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:21.21,0:08:25.21,Default,,0,0,0,,Ах... ақырзаман келгендей сезіледі.
Dialogue: 0,0:08:25.21,0:08:29.22,Default,,0,0,0,,Дұрыс. сурет? Не айтқың келеді?
Dialogue: 0,0:08:29.22,0:08:31.22,Default,,0,0,0,,Супер Сайян Құдайы→
Dialogue: 0,0:08:31.22,0:08:33.22,Default,,0,0,0,,Осыншама күшке ие болу→
Dialogue: 0,0:08:33.22,0:08:35.22,Default,,0,0,0,,Бұл күтпеген жағдай болды.
Dialogue: 0,0:08:35.22,0:08:40.23,Default,,0,0,0,,Сіз оны жойсаңыз да, ол тек бір Жерді немесе жақын орналасқан бірнеше жұлдызды ғана жояды. →
Dialogue: 0,0:08:40.23,0:08:45.23,Default,,0,0,0,,Берус-сама да солай ойлағанына сенімдімін. →
Dialogue: 0,0:08:45.23,0:08:49.24,Default,,0,0,0,,Жоқ, Құдайдың өзі түсінбейтін нәрселер бар →
Dialogue: 0,0:08:49.24,0:08:51.24,Default,,0,0,0,,Иә, бар. Уау...→
Dialogue: 0,0:08:51.24,0:08:53.24,Default,,0,0,0,,Сіз оны нақты түсіндіре аласыз ба?
Dialogue: 0,0:08:53.24,0:08:57.25,Default,,0,0,0,,Қысқасы, екеуінің күші тым күшті→
Dialogue: 0,0:08:57.25,0:09:01.25,Default,,0,0,0,,Осының арқасында дүние бітеді.
Dialogue: 0,0:09:03.25,0:09:07.25,Default,,0,0,0,,Не?!
Dialogue: 0,0:09:11.19,0:09:14.19,Default,,0,0,0,,Дүние бітеді...?
Dialogue: 0,0:09:17.20,0:09:22.20,Default,,0,0,0,,Өтінемін! Бұрынғыдай сиқырыңызбен барлығын қорғаңыз!
Dialogue: 0,0:09:22.20,0:09:24.21,Default,,0,0,0,,Өтінемін, олай айтпаңыз.
Dialogue: 0,0:09:24.21,0:09:26.21,Default,,0,0,0,,Дүниенің жойылуы мүмкін қандай күш→
Dialogue: 0,0:09:26.21,0:09:29.21,Default,,0,0,0,,Оны тоқтату мүмкін емес, солай ма?
Dialogue: 0,0:09:32.21,0:09:38.22,Default,,0,0,0,,А... а...
Dialogue: 0,0:09:38.22,0:09:42.22,Default,,0,0,0,,Куу!
Dialogue: 0,0:09:42.22,0:09:46.23,Default,,0,0,0,,Онда маған айтшы, дәл қазір төбелесуді доғарайын!
Dialogue: 0,0:09:46.23,0:09:50.23,Default,,0,0,0,,Өтінемін! Дәл осылай!
Dialogue: 0,0:09:50.23,0:09:53.24,Default,,0,0,0,,(Хироко) Дегенмен, мен өзімді сәл жалғыз сезінемін.
Dialogue: 0,0:09:53.24,0:09:55.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:59.24,0:10:03.25,Default,,0,0,0,,Бұл туралы не деуге болады! иә?
Dialogue: 0,0:10:03.25,0:10:07.18,Default,,0,0,0,,«Елдің кез келген жерінде жеуге болатын билет»?
Dialogue: 0,0:10:07.18,0:10:11.19,Default,,0,0,0,,Қандай қызықты! Нхухуху.
Dialogue: 0,0:10:11.19,0:10:14.19,Default,,0,0,0,,А, мен не істеуім керек? Эй!
Dialogue: 0,0:10:14.19,0:10:17.19,Default,,0,0,0,,Төтенше өте өте →
Dialogue: 0,0:10:17.19,0:10:21.20,Default,,0,0,0,,Мен саған қатты ұнадым.
Dialogue: 0,0:10:21.20,0:10:24.20,Default,,0,0,0,,
Dialogue: 0,0:10:24.20,0:10:27.20,Default,,0,0,0,,Кешіріңіз. Дааа!
Dialogue: 0,0:10:27.20,0:10:29.20,Default,,0,0,0,,Сен де өлесің!
Dialogue: 0,0:10:29.20,0:10:33.21,Default,,0,0,0,,≪(соққы дыбысы)
Dialogue: 0,0:10:33.21,0:10:49.22,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:49.22,0:10:52.23,Default,,0,0,0,,Уф...!
Dialogue: 0,0:10:52.23,0:10:54.23,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:10:54.23,0:11:04.24,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:04.24,0:11:15.18,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:15.18,0:11:18.19,Default,,0,0,0,,Сіз қатты тырысып жатырсыз.
Dialogue: 0,0:11:18.19,0:11:22.19,Default,,0,0,0,,Бірақ мен аздап жалықтым!
Dialogue: 0,0:11:24.19,0:11:27.20,Default,,0,0,0,,Гугугу...!
Dialogue: 0,0:11:27.20,0:11:30.20,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:30.20,0:11:33.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:36.21,0:11:38.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:38.21,0:11:42.21,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:44.21,0:11:47.22,Default,,0,0,0,,Мынау... бұл жарық! ?
Dialogue: 0,0:11:47.22,0:11:49.22,Default,,0,0,0,,О!
Dialogue: 0,0:11:51.22,0:11:53.22,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:11:53.22,0:11:56.23,Default,,0,0,0,,Мен сізге міндетті түрде рұқсат етемін!
Dialogue: 0,0:11:56.23,0:11:58.23,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:11:58.23,0:12:00.23,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:12:00.23,0:12:04.23,Default,,0,0,0,,Видель-сан! Гохан-кун!
Dialogue: 0,0:12:04.23,0:12:17.18,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:17.18,0:12:19.18,Default,,0,0,0,,О...
Dialogue: 0,0:12:19.18,0:12:39.20,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:39.20,0:12:41.20,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:41.20,0:12:46.21,Default,,0,0,0,,Иә? сурет? сурет?
Dialogue: 0,0:12:46.21,0:12:50.21,Default,,0,0,0,,«Құрғап қалған болар ма?»
Dialogue: 0,0:12:52.21,0:12:54.21,Default,,0,0,0,,Сен тірісің бе...?
Dialogue: 0,0:12:57.22,0:13:01.22,Default,,0,0,0,,Видель-сан, жақсысың ба? Иә.
Dialogue: 0,0:13:01.22,0:13:04.23,Default,,0,0,0,,Барлығы қауіпсіз сияқты.
Dialogue: 0,0:13:04.23,0:13:07.23,Default,,0,0,0,,Сіз нені айтасыз...?
Dialogue: 0,0:13:09.16,0:13:12.17,Default,,0,0,0,,Бабалар, мынау жер бетінде не...?
Dialogue: 0,0:13:12.17,0:13:14.17,Default,,0,0,0,,Мм.
Dialogue: 0,0:13:14.17,0:13:18.17,Default,,0,0,0,,Бірақ неге...? Ха! Мүмкін емес!
Dialogue: 0,0:13:18.17,0:13:22.18,Default,,0,0,0,,Махаббатымның құдіреті ғажайыпты тудырды! ?
Dialogue: 0,0:13:22.18,0:13:25.18,Default,,0,0,0,,Менің махаббатым жерді қорғады!
Dialogue: 0,0:13:25.18,0:13:28.18,Default,,0,0,0,,Түсіндім... міне, осыны білдіреді!
Dialogue: 0,0:13:28.18,0:13:31.19,Default,,0,0,0,,Ухахаха!
Dialogue: 0,0:13:31.19,0:13:34.19,Default,,0,0,0,,Шайтан ең күшті!
Dialogue: 0,0:13:34.19,0:13:37.19,Default,,0,0,0,,《Жоғалып кетті ме!?》
Dialogue: 0,0:13:37.19,0:13:40.19,Default,,0,0,0,,[ТЕЛ] А?
Dialogue: 0,0:13:42.20,0:13:44.20,Default,,0,0,0,,Иә? Бұл пицца ма?
Dialogue: 0,0:15:27.27,0:15:29.27,Default,,0,0,0,,Қазірдің өзінде! Анықтамалар үшін → хабарласыңыз
Dialogue: 0,0:15:29.27,0:15:32.27,Default,,0,0,0,,Асығыс бар!
Dialogue: 0,0:15:32.27,0:15:34.28,Default,,0,0,0,,[TEL] Дұрыс! →
Dialogue: 0,0:15:34.28,0:15:36.28,Default,,0,0,0,,Баспасөз конференциясын дайындаңыз!
Dialogue: 0,0:15:36.28,0:15:38.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:38.28,0:15:42.28,Default,,0,0,0,,Түсінбейсіз бе? Мен жерді құтқардым!
Dialogue: 0,0:15:42.28,0:15:47.29,Default,,0,0,0,,О, автограф сессиясы өтетін орынды қамтамасыз етуді ұмытпаңыз!
Dialogue: 0,0:15:47.29,0:15:50.29,Default,,0,0,0,,Жоқ, жоқ! Бұл күмбез!
Dialogue: 0,0:15:50.29,0:15:53.30,Default,,0,0,0,,Күмбезді ұстаңыз!
Dialogue: 0,0:15:53.30,0:15:55.30,Default,,0,0,0,,О, Беерус-сама.
Dialogue: 0,0:15:55.30,0:15:58.30,Default,,0,0,0,,Сіз бұл әдісті таңдадыңыз ба?
Dialogue: 0,0:15:58.30,0:16:00.30,Default,,0,0,0,,Күтпеген тосынсый.
Dialogue: 0,0:16:05.31,0:16:08.31,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:16:13.32,0:16:18.32,Default,,0,0,0,,Бұл жердегі барлық энергия босатылды.
Dialogue: 0,0:16:18.32,0:16:22.26,Default,,0,0,0,,Олай болды... Сенің қолыңнан келеді.
Dialogue: 0,0:16:22.26,0:16:26.26,Default,,0,0,0,,Сіз 100% күш-жігеріңізді салсаңыз.
Dialogue: 0,0:16:26.26,0:16:29.26,Default,,0,0,0,,100%? аа.
Dialogue: 0,0:16:29.26,0:16:34.27,Default,,0,0,0,,Сол кезде де Беерус-сама әлі байсалды емес еді! ?
Dialogue: 0,0:16:34.27,0:16:38.27,Default,,0,0,0,,Одерете. Сіз әлі де күшіңізді жасырасыз ба?
Dialogue: 0,0:16:38.27,0:16:41.28,Default,,0,0,0,,Өйткені бұл салқын емес, солай емес пе? иә?
Dialogue: 0,0:16:41.28,0:16:43.28,Default,,0,0,0,,Мен Құдаймын.
Dialogue: 0,0:16:43.28,0:16:46.28,Default,,0,0,0,,Сайяндарға қарсы бар күшіңді жұмса.
Dialogue: 0,0:16:46.28,0:16:49.28,Default,,0,0,0,,Мен мұндай көріксіз көріністі әшкерелегенді жөн көремін →
Dialogue: 0,0:16:49.28,0:16:51.29,Default,,0,0,0,,Өлгені жақсы.
Dialogue: 0,0:16:51.29,0:16:55.29,Default,,0,0,0,,Каа! Берус-сама, солай...
Dialogue: 0,0:16:55.29,0:16:59.29,Default,,0,0,0,,Мен осы уақытқа дейін солай ойладым.
Dialogue: 0,0:16:59.29,0:17:03.30,Default,,0,0,0,,Бірақ мен бұл жекпе-жекте жеңілгім келмейді!
Dialogue: 0,0:17:03.30,0:17:06.30,Default,,0,0,0,,Қаншалықты салқын болса да, жұрт оған күлсе де→
Dialogue: 0,0:17:06.30,0:17:08.30,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:17:08.30,0:17:10.31,Default,,0,0,0,,Сізді ұрып-соғады →
Dialogue: 0,0:17:10.31,0:17:15.31,Default,,0,0,0,,Мен күштірек екенімді дәлелдеймін!
Dialogue: 0,0:17:15.31,0:17:18.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:18.31,0:17:22.25,Default,,0,0,0,,Иә. Олай болса, бастайық!
Dialogue: 0,0:17:22.25,0:17:25.25,Default,,0,0,0,,Бұл күлетін нәрсе емес.
Dialogue: 0,0:17:25.25,0:17:27.26,Default,,0,0,0,,Бұл өте көп.
Dialogue: 0,0:17:27.26,0:17:29.26,Default,,0,0,0,,Оны қалай алуға болады?
Dialogue: 0,0:17:29.26,0:17:32.26,Default,,0,0,0,,Сонымен стратегия қандай?
Dialogue: 0,0:17:32.26,0:17:34.26,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:17:34.26,0:17:36.26,Default,,0,0,0,,Беерус-сама ше?
Dialogue: 0,0:17:39.27,0:17:42.27,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:17:42.27,0:17:45.27,Default,,0,0,0,,Хехе. Беерус-сама сияқты!
Dialogue: 0,0:17:45.27,0:18:02.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:02.29,0:18:05.29,Default,,0,0,0,,Гува! О!
Dialogue: 0,0:18:05.29,0:18:08.30,Default,,0,0,0,,Сен лассың, Беерус-сама!
Dialogue: 0,0:18:08.30,0:18:12.30,Default,,0,0,0,,Сізде тез алаңдайтын әдет бар.
Dialogue: 0,0:18:14.30,0:18:17.31,Default,,0,0,0,,Беерус-сама керемет!
Dialogue: 0,0:18:17.31,0:18:20.33,Default,,0,0,0,,Соққы күші 5 минут бұрынғыдан мүлде басқаша!
Dialogue: 0,0:18:20.33,0:18:24.25,Default,,0,0,0,,Өзің де, күш-қуатың артқан.
Dialogue: 0,0:18:24.25,0:18:26.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:26.25,0:18:28.25,Default,,0,0,0,,Допты жұлып алған адам — біздің Хью Хадсон мектебінің мақтанышы —
Dialogue: 0,0:18:28.25,0:18:30.25,Default,,0,0,0,,Міне! Арх!
Dialogue: 0,0:18:30.25,0:18:33.25,Default,,0,0,0,,100%!
Dialogue: 0,0:18:33.25,0:18:35.26,Default,,0,0,0,,Ха! Қарғыс атсын!
Dialogue: 0,0:18:35.26,0:18:39.26,Default,,0,0,0,,Тіпті Ола 100%!
Dialogue: 0,0:18:39.26,0:18:41.26,Default,,0,0,0,,Кеяаааааа!
Dialogue: 0,0:18:41.26,0:18:43.26,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:18:43.26,0:18:46.27,Default,,0,0,0,,Гугга!
Dialogue: 0,0:18:46.27,0:18:48.27,Default,,0,0,0,,Хмф!
Dialogue: 0,0:18:48.27,0:18:51.27,Default,,0,0,0,,Ой! Апыр-ай!
Dialogue: 0,0:18:51.27,0:18:53.27,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:53.27,0:18:56.28,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:18:56.28,0:18:58.28,Default,,0,0,0,,Сіз мұны айналып өте алмайсыз.
Dialogue: 0,0:19:00.28,0:19:02.28,Default,,0,0,0,,Кукукуку….
Dialogue: 0,0:19:02.28,0:19:04.28,Default,,0,0,0,,Иә! Не! ?
Dialogue: 0,0:19:06.29,0:19:11.29,Default,,0,0,0,,Арх! Жіберу!
Dialogue: 0,0:19:11.29,0:19:13.29,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:19:13.29,0:19:15.30,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:19:15.30,0:19:19.30,Default,,0,0,0,,Ой! Қарғыс атқыр...
Dialogue: 0,0:19:19.30,0:19:22.24,Default,,0,0,0,,Басын соғу өте беймәлім!
Dialogue: 0,0:19:22.24,0:19:25.24,Default,,0,0,0,,Бірақ ол жұмыс істеді. Бұл жұмыс істемейді.
Dialogue: 0,0:19:25.24,0:19:30.24,Default,,0,0,0,,Өтірік! Лала ла ла...!
Dialogue: 0,0:19:33.25,0:19:36.25,Default,,0,0,0,,Қаншама шабуылдармен соқтығыссақ та→
Dialogue: 0,0:19:36.25,0:19:40.26,Default,,0,0,0,,Әлемді бұзатын толқындар пайда болған жоқ! ?
Dialogue: 0,0:19:40.26,0:19:44.26,Default,,0,0,0,,Неліктен? (Кәрі Кай) Түсінбейсің бе?
Dialogue: 0,0:19:44.26,0:19:47.26,Default,,0,0,0,,Бұл жай ғана ұрыс шығар.
Dialogue: 0,0:19:47.26,0:19:50.26,Default,,0,0,0,,Жоқ! Хмф!
Dialogue: 0,0:19:53.27,0:19:56.27,Default,,0,0,0,,Уақыт бітті ме?
Dialogue: 0,0:19:56.27,0:19:59.27,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба? Даа! Ха!
Dialogue: 0,0:19:59.27,0:20:01.28,Default,,0,0,0,,Ей, сен жақсы жұмыс жасадың.
Dialogue: 0,0:20:01.28,0:20:03.28,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:03.28,0:20:07.28,Default,,0,0,0,,Мен өз шегімнен бірнеше рет асып, күшейдім.
Dialogue: 0,0:20:07.28,0:20:10.29,Default,,0,0,0,,Сайян болғанына қарамастан→
Dialogue: 0,0:20:10.29,0:20:14.29,Default,,0,0,0,,Маған осыншама күшті пайдалануға қалай батылы бардың?
Dialogue: 0,0:20:14.29,0:20:17.29,Default,,0,0,0,,Ол тамаша жігіт.
Dialogue: 0,0:20:17.29,0:20:20.29,Default,,0,0,0,,Тіссең, тіліңді тістейсің!
Dialogue: 0,0:20:22.23,0:20:25.23,Default,,0,0,0,,Уф! Гах...
Dialogue: 0,0:20:25.23,0:20:40.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:40.25,0:20:42.25,Default,,0,0,0,,Пикколо-сан Готен.
Dialogue: 0,0:20:42.25,0:20:44.25,Default,,0,0,0,,Барлығы қауіпсіз болды.
Dialogue: 0,0:20:44.25,0:20:47.25,Default,,0,0,0,,Иә, бәрі жақсы.
Dialogue: 0,0:20:49.26,0:20:51.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:51.26,0:20:53.26,Default,,0,0,0,,Бұл сенің әкеңнің рухы! Күте тұрыңыз.
Dialogue: 0,0:20:53.26,0:20:56.26,Default,,0,0,0,,Ки... сезе білу.
Dialogue: 0,0:20:56.26,0:20:59.27,Default,,0,0,0,,Жоқ, мүмкін емес...
Dialogue: 0,0:20:59.27,0:21:01.27,Default,,0,0,0,,Дұрыс. →
Dialogue: 0,0:21:01.27,0:21:05.27,Default,,0,0,0,,Сон Гоку энергиясын сезіну фактісі→
Dialogue: 0,0:21:05.27,0:21:09.28,Default,,0,0,0,,Уақыт өте келе ол Super Saiyan Құдайы бола алады→
Dialogue: 0,0:21:09.28,0:21:17.29,Default,,0,0,0,,Ол жай ғана Супер Сайян болуға қайта оралғаннан басқа амал жоқ.
Dialogue: 0,0:21:17.29,0:21:19.29,Default,,0,0,0,,Міне...
Dialogue: 0,0:21:19.29,0:21:23.29,Default,,0,0,0,,Сонда әкең ше?
Dialogue: 0,0:21:25.23,0:21:27.23,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:30.23,0:21:32.23,Default,,0,0,0,,Жарайды, Готен-кун.
Dialogue: 0,0:21:32.23,0:21:34.24,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:21:34.24,0:21:37.24,Default,,0,0,0,,Дүниенің ақыры болады деп бұрын айтқанмен→
Dialogue: 0,0:21:37.24,0:21:39.24,Default,,0,0,0,,Өшірулі! Тіпті бұл жолы...
Dialogue: 0,0:21:39.24,0:21:41.24,Default,,0,0,0,,Ммм, дәмді екен.
Dialogue: 0,0:21:41.24,0:21:44.25,Default,,0,0,0,,Тезірек шықса екен.
Dialogue: 0,0:21:44.25,0:21:49.25,Default,,0,0,0,,Себебі мен Берус-саманың көңілді жүргенін көрдім→
Dialogue: 0,0:21:49.25,0:21:52.25,Default,,0,0,0,,900 жылдай уақыт өтті.
Dialogue: 0,0:21:52.25,0:21:55.26,Default,,0,0,0,,Жарайды, мен де кәдесый алдым →
Dialogue: 0,0:21:55.26,0:22:00.26,Default,,0,0,0,,Мен осы жерде тұрамын.
Dialogue: 0,0:22:00.26,0:22:03.26,Default,,0,0,0,,Күтіңіз. Мен әлі жеңілген жоқпын.
Dialogue: 0,0:22:03.26,0:22:05.26,Default,,0,0,0,,Босатыңыз.
Dialogue: 0,0:22:08.27,0:22:10.27,Default,,0,0,0,,Жібер!
Dialogue: 0,0:22:17.28,0:22:20.30,Default,,0,0,0,,Сіз нені айтасыз? ?
Dialogue: 0,0:22:20.30,0:22:26.30,Default,,0,0,0,,《Жарайды... «Әзірше дүрбелеңнің қажеті жоқ». Осыны айтып тұрсың ба? 》
Dialogue: 0,0:22:29.22,0:22:32.23,Default,,0,0,0,,《Мықты болу өкінішті》→
Dialogue: 0,0:22:32.23,0:22:35.23,Default,,0,0,0,,《Осындай қызықты уақытты сыйлаған досыма→
Dialogue: 0,0:22:35.23,0:22:38.23,Default,,0,0,0,,Мен қоштасуым керек》
Dialogue: 0,0:22:38.23,0:22:40.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:40.24,0:22:42.24,Default,,0,0,0,,Түсінбейсің бе?
Dialogue: 0,0:22:42.24,0:22:46.24,Default,,0,0,0,,Біздің кешіміз аяқталды.
Dialogue: 0,0:22:46.24,0:22:50.25,Default,,0,0,0,,Қарғыс атсын! Гах...
Dialogue: 0,0:22:50.25,0:22:55.25,Default,,0,0,0,,Супер Сайян Құдайдың құдіреті алыстан жоғалады →
Dialogue: 0,0:22:55.25,0:22:57.25,Default,,0,0,0,,Сіз қазірдің өзінде...
Dialogue: 0,0:22:57.25,0:22:59.25,Default,,0,0,0,,Тағы да! ?
Dialogue: 0,0:22:59.25,0:23:02.26,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:23:02.26,0:23:04.26,Default,,0,0,0,,Хааа~
Dialogue: 0,0:23:04.26,0:23:07.26,Default,,0,0,0,,Куу... Арх! иә?
Dialogue: 0,0:23:07.26,0:23:10.27,Default,,0,0,0,,Не болып жатыр? ше?
Dialogue: 0,0:23:10.27,0:23:12.27,Default,,0,0,0,,Уақыт емес пе? иә?
Dialogue: 0,0:23:12.27,0:23:14.27,Default,,0,0,0,,Сол себепті!
Dialogue: 0,0:23:14.27,0:23:19.27,Default,,0,0,0,,Super Saiyan Құдайдың аурасы жоғалып кеткен шығар!
Dialogue: 0,0:23:19.27,0:23:22.21,Default,,0,0,0,,А... Сіз мұны кеш түсіндіңіз!
Dialogue: 0,0:23:22.21,0:23:24.21,Default,,0,0,0,,Иә? Қашан?
Dialogue: 0,0:23:24.21,0:23:28.22,Default,,0,0,0,,Бірақ, мен өзімді мүлде әлсірегендей сезінбеймін, солай ма?
Dialogue: 0,0:23:28.22,0:23:30.22,Default,,0,0,0,,Не болып жатыр? Берус мырза.
Dialogue: 0,0:23:30.22,0:23:33.22,Default,,0,0,0,,Менен сұрама! Бұл Құдай, солай ма?
Dialogue: 0,0:23:35.22,0:23:37.23,Default,,0,0,0,,
Dialogue: 0,0:23:37.23,0:23:40.23,Default,,0,0,0,,Шамасы, Супер Сайян Құдайдың құдіреті →
Dialogue: 0,0:23:40.23,0:23:44.23,Default,,0,0,0,,Уақыт біткендіктен жоғалып кетпеген сияқты.
Dialogue: 0,0:23:44.23,0:23:49.24,Default,,0,0,0,,Билік өз күшіңізге толығымен қосылды.
Dialogue: 0,0:23:49.24,0:23:52.24,Default,,0,0,0,,Құдайдың қызыл нұры сенің ішіңде →
Dialogue: 0,0:23:52.24,0:23:57.25,Default,,0,0,0,,Әлі де жалын болып жанады.
Dialogue: 0,0:23:57.25,0:24:00.25,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:24:00.25,0:24:03.25,Default,,0,0,0,,Ал, сен қалай ойлайсың?
Dialogue: 0,0:24:03.25,0:24:05.25,Default,,0,0,0,,Ола - Ола.
Dialogue: 0,0:24:05.25,0:24:07.26,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:24:07.26,0:24:11.26,Default,,0,0,0,,А, мен сентиментальды болып ақша жоғалттым.
Dialogue: 0,0:24:11.26,0:24:14.26,Default,,0,0,0,,Sentinantale дегеніміз не?
Dialogue: 0,0:24:14.26,0:24:17.27,Default,,0,0,0,,О, құдайым. Тағы сөйлессеңіз →
Dialogue: 0,0:24:17.27,0:24:19.27,Default,,0,0,0,,Идиоттар жұқтыруы ықтимал.
Dialogue: 0,0:24:19.27,0:24:23.20,Default,,0,0,0,,Хахаха, жоқ, менің ойымша, ол жұқтырған.
Dialogue: 0,0:24:23.20,0:24:26.21,Default,,0,0,0,,Тез жалғастырайық!
Dialogue: 0,0:24:26.21,0:24:30.21,Default,,0,0,0,,Ах. Кел.
Dialogue: 0,0:24:30.21,0:24:34.22,Default,,0,0,0,,Ааа! !
Dialogue: 0,0:24:34.22,0:24:37.22,Default,,0,0,0,,Ааа...! Хмф!
Dialogue: 0,0:24:37.22,0:24:42.22,Default,,0,0,0,,Дааааа! !
Dialogue: 0,0:24:45.23,0:24:48.23,Default,,0,0,0,,Уау! Олай болса!
Dialogue: 0,0:24:51.23,0:24:54.23,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:24:57.24,0:24:59.24,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:25:04.25,0:25:08.25,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:25:08.25,0:25:14.26,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:25:14.26,0:25:18.26,Default,,0,0,0,,Хяаа! Хааа!
Dialogue: 0,0:25:20.26,0:25:23.26,Default,,0,0,0,,<Шынында да шайқас құдайы...>
Dialogue: 0,0:25:23.26,0:25:26.27,Default,,0,0,0,,<Жоқ, мен жай ғана төбелескен ақымақ болдым→
Dialogue: 0,0:25:26.27,0:25:30.27,Default,,0,0,0,,Жою құдайы Берус пен Сон Гоку＞
Dialogue: 0,0:25:30.27,0:25:33.27,Default,,0,0,0,,<Тіпті ғаламды жойып жіберетін күш→
Dialogue: 0,0:25:33.27,0:25:38.28,Default,,0,0,0,,Бір-бірін ұрып-соғып жатқан екі адамның төбелесі>
Dialogue: 0,0:25:38.28,0:25:44.28,Default,,0,0,0,,<Ол қалай шешіледі?>
Dialogue: 0,0:25:46.29,0:25:56.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:49.28,0:26:51.29,Default,,0,0,0,,Сәлем, Гоку.
Dialogue: 0,0:26:51.29,0:26:53.29,Default,,0,0,0,,Беерус-сама қаншалықты күшті болса да→
Dialogue: 0,0:26:53.29,0:26:56.29,Default,,0,0,0,,Адамның шегін ерікті түрде шешпеңіз!
Dialogue: 0,0:26:56.29,0:27:00.29,Default,,0,0,0,,Супер Сайян Құдайдың құдіреті кетсе де→
Dialogue: 0,0:27:00.29,0:27:04.30,Default,,0,0,0,,Мен саған Жерді де, барлығын да жоюға ешқашан рұқсат бермеймін!
Dialogue: 0,0:27:04.30,0:27:07.30,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:12.31,0:27:14.31,Default,,0,0,0,,Міндетті түрде тексеріңіз!
Dialogue: 0,0:27:15.81,0:27:21.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory