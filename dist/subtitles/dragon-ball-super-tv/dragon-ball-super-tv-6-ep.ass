Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.13,0:01:43.13,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:08.55,0:04:13.56,Default,,0,0,0,,<Кайтодағы гоку жаттығуы>
Dialogue: 0,0:04:13.56,0:04:18.56,Default,,0,0,0,,<Оның алдында Жою құдайы Бер пайда болды>
Dialogue: 0,0:04:18.56,0:04:20.57,Default,,0,0,0,,Супер Сайян Құдайы ма?
Dialogue: 0,0:04:20.57,0:04:24.57,Default,,0,0,0,,Егер сіз жай ғана супер Сайян болсаңыз, мен білетін едім.
Dialogue: 0,0:04:24.57,0:04:27.57,Default,,0,0,0,,Жоқ, мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:04:27.57,0:04:33.58,Default,,0,0,0,,<Гоку Берусты күш сынағына шақыру бақытына ие болды.>
Dialogue: 0,0:04:33.58,0:04:36.58,Default,,0,0,0,,Жою құдайы Хане→
Dialogue: 0,0:04:36.58,0:04:38.58,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:04:38.58,0:04:40.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:40.59,0:04:45.59,Default,,0,0,0,,<Сыралар Гокуды басым күшпен жеңді→
Dialogue: 0,0:04:45.59,0:04:51.60,Default,,0,0,0,,Жерге көрінбейтін Супер Сайян Құдайын іздеу>
Dialogue: 0,0:04:51.60,0:04:53.60,Default,,0,0,0,,Міне, бәрі де осында. →
Dialogue: 0,0:04:53.60,0:04:55.60,Default,,0,0,0,,Сол жаққа барып, бірге шуласайық.
Dialogue: 0,0:04:55.60,0:04:57.60,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:04:57.60,0:05:01.61,Default,,0,0,0,,Хун. Неліктен сіз өзіңізге керемет көрінуге тырысасыз?
Dialogue: 0,0:05:01.61,0:05:04.61,Default,,0,0,0,,Иә! Жарайды, қалағаныңды істе.
Dialogue: 0,0:05:04.61,0:05:07.55,Default,,0,0,0,,<Жер вегетасы туралы не деуге болады?>
Dialogue: 0,0:05:07.55,0:05:12.55,Default,,0,0,0,,Берустың ашуын тоқтату мүмкін бе?＞
Dialogue: 0,0:05:25.56,0:05:27.57,Default,,0,0,0,,Ооо!
Dialogue: 0,0:05:27.57,0:05:30.57,Default,,0,0,0,,Жақсы! Жақсы! →
Dialogue: 0,0:05:30.57,0:05:35.57,Default,,0,0,0,,Ешқашан кешке бармаңыз.
Dialogue: 0,0:05:35.57,0:05:38.58,Default,,0,0,0,,Не? Бұрын жасағаным дұрыс деп ойлаған нәрселер →
Dialogue: 0,0:05:38.58,0:05:40.58,Default,,0,0,0,,Мен солай айтсам да.
Dialogue: 0,0:05:40.58,0:05:45.58,Default,,0,0,0,,Тіпті сен барғың келмейтінін айттың.
Dialogue: 0,0:05:45.58,0:05:47.59,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:05:47.59,0:05:52.59,Default,,0,0,0,,Сензу бұршақтарының күші таң қалдырады. Ол толығымен емделді.
Dialogue: 0,0:05:52.59,0:05:55.59,Default,,0,0,0,,Мен саған сензу бұршақтарын бермеуім керек еді. →
Dialogue: 0,0:05:55.59,0:05:59.60,Default,,0,0,0,,күрсіну. Иә? Сенімен бәрі жақсы ма? Кай патша.
Dialogue: 0,0:05:59.60,0:06:02.60,Default,,0,0,0,,Бұл мүлдем дұрыс емес!
Dialogue: 0,0:06:02.60,0:06:06.62,Default,,0,0,0,,Мен күйзелістен өмірімнің ұзақтығы қысқарады деп қорқамын.
Dialogue: 0,0:06:06.62,0:06:09.54,Default,,0,0,0,,Оның ғұмыры әлдеқашан өтті емес пе?
Dialogue: 0,0:06:09.54,0:06:11.54,Default,,0,0,0,,Не?
Dialogue: 0,0:06:11.54,0:06:14.55,Default,,0,0,0,,Түсіндім. Түсіндім. Мен кетуім керек, солай ма?
Dialogue: 0,0:06:14.55,0:06:17.55,Default,,0,0,0,,О, түсіндің бе?
Dialogue: 0,0:06:19.55,0:06:22.55,Default,,0,0,0,,Ғалам жойылса, жақсы сөз болмас еді.
Dialogue: 0,0:06:22.55,0:06:26.55,Default,,0,0,0,,Осы жерде күтіңіз. (Кай) Дұрыс. Бұл жақсы.
Dialogue: 0,0:06:28.56,0:06:32.56,Default,,0,0,0,,Мен шынымен шыдай аламын ба деп ойлаймын. Мен сенімді емеспін.
Dialogue: 0,0:06:32.56,0:06:34.56,Default,,0,0,0,,О, менің….
Dialogue: 0,0:06:39.57,0:06:43.58,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:06:43.58,0:06:46.58,Default,,0,0,0,,Ахахха! Ахахха!
Dialogue: 0,0:06:49.58,0:06:53.59,Default,,0,0,0,,Вегета мұны істейтін шығар.
Dialogue: 0,0:06:53.59,0:06:55.59,Default,,0,0,0,,Кешіріңіз. (Готен) Эй! Апыр-ай!
Dialogue: 0,0:07:00.59,0:07:02.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:05.60,0:07:08.60,Default,,0,0,0,,Ха! Ха! себебі! Эй!
Dialogue: 0,0:07:11.54,0:07:14.54,Default,,0,0,0,,Гей. Апыр-ай.
Dialogue: 0,0:07:19.54,0:07:22.54,Default,,0,0,0,,Какарот тек екі рет түсірді ме?
Dialogue: 0,0:07:25.55,0:07:28.55,Default,,0,0,0,,Боқ.
Dialogue: 0,0:07:28.55,0:07:32.56,Default,,0,0,0,,《Сіз Вегета-сама қорқып кетті дейсіз бе? 》
Dialogue: 0,0:07:32.56,0:07:34.56,Default,,0,0,0,,《Жоятын Құдай Берус》
Dialogue: 0,0:07:34.56,0:07:37.56,Default,,0,0,0,,《Бұл мен бір жерден естіген есім》
Dialogue: 0,0:07:37.56,0:07:40.57,Default,,0,0,0,,《Бірақ қайда? 》
Dialogue: 0,0:07:40.57,0:07:43.57,Default,,0,0,0,,≪Сәлеметсіз бе, ханзада Вегета. (Вегета) Га.
Dialogue: 0,0:07:43.57,0:08:03.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:03.59,0:08:06.61,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:06.61,0:08:08.61,Default,,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:08:13.53,0:08:15.53,Default,,0,0,0,,Банг! (Вегета) Ах!
Dialogue: 0,0:08:19.54,0:08:22.54,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:08:22.54,0:08:24.54,Default,,0,0,0,,Hmph. →
Dialogue: 0,0:08:24.54,0:08:27.55,Default,,0,0,0,,Сәлеметсіз бе. (Вегета) Сен кімсің!?
Dialogue: 0,0:08:27.55,0:08:32.55,Default,,0,0,0,,Мен өз атымды айтуым керек пе? Өйткені сен әлдеқашан өлдің.
Dialogue: 0,0:08:32.55,0:08:35.55,Default,,0,0,0,,Бұл... бұл!
Dialogue: 0,0:08:35.55,0:08:38.55,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:41.56,0:08:45.56,Default,,0,0,0,,《Сонымен... денең қозғалды ма? 》
Dialogue: 0,0:08:45.56,0:08:47.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:51.57,0:08:55.57,Default,,0,0,0,,Ах... →
Dialogue: 0,0:08:55.57,0:08:58.57,Default,,0,0,0,,Ахх!
Dialogue: 0,0:09:01.58,0:09:06.58,Default,,0,0,0,,《Уф...》
Dialogue: 0,0:09:11.52,0:09:15.53,Default,,0,0,0,,《Мен неге сонша ашуландым?→
Dialogue: 0,0:09:15.53,0:09:18.53,Default,,0,0,0,,Түсіндің бе? 》 (Кинг Вегета)《Сәлем...》
Dialogue: 0,0:09:18.53,0:09:21.53,Default,,0,0,0,,《Сәлем》 (Кинг Вегета) 《Өтінемін... маған тапсырыстарыңызды беріңіз→
Dialogue: 0,0:09:21.53,0:09:25.54,Default,,0,0,0,,Өйткені, ол уәде етілген мерзімде уәдесін орындай алмады.
Dialogue: 0,0:09:25.54,0:09:28.54,Default,,0,0,0,,《Жоқ》 (Кинг Вегета) 《Уф》
Dialogue: 0,0:09:28.54,0:09:30.54,Default,,0,0,0,,《Әкем солай көрінеді》
Dialogue: 0,0:09:30.54,0:09:33.55,Default,,0,0,0,,《Әзілдеп жатырмын. Бұл не деген жігіт...》
Dialogue: 0,0:09:33.55,0:09:36.55,Default,,0,0,0,,《Мен үлкен жүректі Құдаймын》→
Dialogue: 0,0:09:36.55,0:09:39.55,Default,,0,0,0,,《Бірақ мен шыдай алмайтын бір нәрсе бар →
Dialogue: 0,0:09:39.55,0:09:43.56,Default,,0,0,0,,Бір ғана нәрсе бар.》 (Кинг Вегета)《Ух...》
Dialogue: 0,0:09:43.56,0:09:49.56,Default,,0,0,0,,《Бұл лайықты құрмет көрсете алмайтын адамдардың сезімсіздігі.》
Dialogue: 0,0:09:49.56,0:09:51.56,Default,,0,0,0,,《Уф! 》 (Вегета) 《Аа! 》
Dialogue: 0,0:09:51.56,0:09:54.57,Default,,0,0,0,,《Менде ғаламдағы ең жайлы жастық→
Dialogue: 0,0:09:54.57,0:09:57.57,Default,,0,0,0,,Ол маған әкелуді бұйырды.
Dialogue: 0,0:09:57.57,0:10:02.57,Default,,0,0,0,,《Сен оны әлдебір планетадан ұрлап алдың》
Dialogue: 0,0:10:04.58,0:10:08.51,Default,,0,0,0,,《Мен қанша адамды өлтіргенімді білмеймін.''
Dialogue: 0,0:10:08.51,0:10:11.52,Default,,0,0,0,,Сізде өзіңіз үшін әлемдегі ең жақсы жастық бар→
Dialogue: 0,0:10:11.52,0:10:17.52,Default,,0,0,0,,Екіншісін бергеніңді білмедім деп ойладың ба? 》
Dialogue: 0,0:10:17.52,0:10:22.53,Default,,0,0,0,,《Уау! 》 (Вегета) 《А...》
Dialogue: 0,0:10:22.53,0:10:26.53,Default,,0,0,0,,《Ей... алданып қалма! 》
Dialogue: 0,0:10:26.53,0:10:28.53,Default,,0,0,0,,《Иә? 》 (Вегета) 《Аа! 》
Dialogue: 0,0:10:28.53,0:10:32.54,Default,,0,0,0,,《Уф... ух》
Dialogue: 0,0:10:32.54,0:10:35.54,Default,,0,0,0,,《Аа...》
Dialogue: 0,0:10:43.55,0:10:47.55,Default,,0,0,0,,《Жоятын Құдай Берус》→
Dialogue: 0,0:10:47.55,0:10:52.56,Default,,0,0,0,,《Бұл жігіт Какаротты екі соққымен жеңе алды...》
Dialogue: 0,0:10:52.56,0:10:55.56,Default,,0,0,0,,Мүмкін мен есейіп уақытыңды өлтіретін адам боламын →
Dialogue: 0,0:10:55.56,0:10:58.56,Default,,0,0,0,,Мен солай ойладым. Менің көңілім қалды. →
Dialogue: 0,0:10:58.56,0:11:02.56,Default,,0,0,0,,Сол кезде олар бүкіл планетаны жоюы керек еді.
Dialogue: 0,0:11:05.57,0:11:07.51,Default,,0,0,0,,Эй.
Dialogue: 0,0:11:07.51,0:11:11.51,Default,,0,0,0,,Super Saiyan God деген есім таныс емес пе?
Dialogue: 0,0:11:11.51,0:11:15.51,Default,,0,0,0,,Супер Сайян Құдайы...?
Dialogue: 0,0:11:15.51,0:11:17.52,Default,,0,0,0,,Білмейтін сияқтысың.
Dialogue: 0,0:11:17.52,0:11:20.52,Default,,0,0,0,,Ах…. ≪Аа.
Dialogue: 0,0:11:20.52,0:11:22.52,Default,,0,0,0,,Ах…. иә?
Dialogue: 0,0:11:24.52,0:11:26.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:26.52,0:11:29.53,Default,,0,0,0,,О, сіз осындай жерде болдыңыз ба? иә?
Dialogue: 0,0:11:29.53,0:11:31.53,Default,,0,0,0,,Ку... Ах.
Dialogue: 0,0:11:31.53,0:11:33.53,Default,,0,0,0,,Вегета. (Вегета) Келме!
Dialogue: 0,0:11:33.53,0:11:35.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:35.53,0:11:40.54,Default,,0,0,0,,Ханзада Вегета, сіз әйелдерге дөрекі емессіз бе?
Dialogue: 0,0:11:40.54,0:11:43.54,Default,,0,0,0,,Ол аздап ішкен сияқты.
Dialogue: 0,0:11:43.54,0:11:45.54,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:11:45.54,0:11:48.55,Default,,0,0,0,,Кешіктіргеніміз үшін кешірім сұраймыз. Мен Уис.
Dialogue: 0,0:11:48.55,0:11:51.55,Default,,0,0,0,,Ал бұл менің қожайыным Беерус-сама.
Dialogue: 0,0:11:51.55,0:11:53.55,Default,,0,0,0,,Егер сіз Жерге кездейсоқ келсеңіз →
Dialogue: 0,0:11:53.55,0:11:56.55,Default,,0,0,0,,Вегета танысқаныма қуаныштымын.
Dialogue: 0,0:11:56.55,0:12:00.56,Default,,0,0,0,,Уау, мен таң қалдым. Сіздің достарыңыз болды ма?
Dialogue: 0,0:12:00.56,0:12:03.56,Default,,0,0,0,,Ойланып қарасам, олар Жерден емес сияқты.
Dialogue: 0,0:12:03.56,0:12:05.56,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:12:05.56,0:12:10.50,Default,,0,0,0,,Булма, Вегетаның әйелі. Сізбен танысқаным мақтаныш.
Dialogue: 0,0:12:10.50,0:12:12.50,Default,,0,0,0,,Қарсы болмасаң, менімен кешке барғың келе ме?
Dialogue: 0,0:12:12.50,0:12:17.51,Default,,0,0,0,,Бүгін менің туған күнім. Мен екеуіңе қош келдіңіздер.
Dialogue: 0,0:12:17.51,0:12:20.51,Default,,0,0,0,,Мейірімділігіңіз үшін рахмет.
Dialogue: 0,0:12:20.51,0:12:23.52,Default,,0,0,0,,Негізі біраз уақыттан бері өте дәмді иіс шығып жатыр→
Dialogue: 0,0:12:23.52,0:12:27.52,Default,,0,0,0,,Жүрегім саған тартқан. Онда барайық.
Dialogue: 0,0:12:27.52,0:12:31.52,Default,,0,0,0,,Ал... күте тұрыңыз! а….
Dialogue: 0,0:12:31.52,0:12:33.53,Default,,0,0,0,,Барлығының назарына! →
Dialogue: 0,0:12:33.53,0:12:36.53,Default,,0,0,0,,Вегетаның достары Берус пен Уис.
Dialogue: 0,0:12:36.53,0:12:40.53,Default,,0,0,0,,Сәлеметсіз бе. Сәлем. (қол шапалақтау)
Dialogue: 0,0:12:40.53,0:12:43.53,Default,,0,0,0,,Сәлем, сәлем, сәлем.
Dialogue: 0,0:12:45.54,0:12:47.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:51.54,0:12:54.54,Default,,0,0,0,,Сәлем. Сәлем, сәлем.
Dialogue: 0,0:12:56.55,0:13:01.55,Default,,0,0,0,,《Ашуыңды жоғалтпасаң, олар саған зиян тигізбейді》
Dialogue: 0,0:13:04.56,0:13:08.49,Default,,0,0,0,,《Бұл қажетсіз қиындық тудыруы мүмкін аймақ па?》
Dialogue: 0,0:13:08.49,0:13:10.50,Default,,0,0,0,,Бұл адам Ямча. (Вегета) Га.
Dialogue: 0,0:13:10.50,0:13:12.50,Default,,0,0,0,,Қайырлы күн. Хаха.
Dialogue: 0,0:13:12.50,0:13:14.50,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:14.50,0:13:16.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:16.50,0:13:21.51,Default,,0,0,0,,Менің бұл жерде ескі адам екенім рас. Ал мен оны дауыстап айта алмаймын, бірақ →
Dialogue: 0,0:13:21.51,0:13:26.51,Default,,0,0,0,,Оның жекпе-жектегі шеберлігі де 1-ші және 2-ші орынға таласатын деңгейде. Мен сенің қобалжығаныңды түсінемін.
Dialogue: 0,0:13:26.51,0:13:30.52,Default,,0,0,0,,Бірақ бұл тамаша кеш, солай емес пе? Дөрекі лекцияға барайық!
Dialogue: 0,0:13:30.52,0:13:33.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:33.52,0:13:35.52,Default,,0,0,0,,Әлгі ақымақ!
Dialogue: 0,0:13:35.52,0:13:38.52,Default,,0,0,0,,Эй, күте тұрыңыз. (Вегета) Ах.
Dialogue: 0,0:13:38.52,0:13:41.53,Default,,0,0,0,,Жақсы. бұл?
Dialogue: 0,0:13:41.53,0:13:43.53,Default,,0,0,0,,Бұл мен бұрын көрмеген тағам.
Dialogue: 0,0:13:43.53,0:13:45.53,Default,,0,0,0,,Бұл →
Dialogue: 0,0:13:45.53,0:13:47.53,Default,,0,0,0,,Орыс такояки!
Dialogue: 0,0:13:47.53,0:13:50.54,Default,,0,0,0,,О.
Dialogue: 0,0:13:50.54,0:13:53.54,Default,,0,0,0,,Сегізаяқтың орнына осылардың біреуі ғана→
Dialogue: 0,0:13:53.54,0:13:56.54,Default,,0,0,0,,Көп васаби араласқан джекпот бар деген трюк.
Dialogue: 0,0:13:56.54,0:13:59.54,Default,,0,0,0,,Енді көңіл көтерейік!
Dialogue: 0,0:13:59.54,0:14:01.55,Default,,0,0,0,,《Идиот》
Dialogue: 0,0:14:01.55,0:14:03.55,Default,,0,0,0,,Қажетсіз істермен айналыспаңыз!
Dialogue: 0,0:14:03.55,0:14:06.55,Default,,0,0,0,,Не? Бұл не? Мен қатты абдырап қалдым.
Dialogue: 0,0:14:06.55,0:14:09.55,Default,,0,0,0,,Дұрыс. Қызық емес пе? (Вегета) Ах...
Dialogue: 0,0:14:13.56,0:14:15.56,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:14:15.56,0:14:17.56,Default,,0,0,0,,Мен васабидің не екенін білмеймін, бірақ→
Dialogue: 0,0:14:17.56,0:14:22.57,Default,,0,0,0,,Орысша Такояки Бұл шынымен тәбетті көрнекі.
Dialogue: 0,0:14:22.57,0:14:25.57,Default,,0,0,0,,Бұл Banna Star супер тәтті қара шие соусына ұқсас→
Dialogue: 0,0:14:25.57,0:14:28.57,Default,,0,0,0,,Хмф, хмф... Әлі де хош иісті.
Dialogue: 0,0:14:28.57,0:14:31.58,Default,,0,0,0,,Тым шулы болмаңыз. Сіз оны жеген кезде білесіз.
Dialogue: 0,0:14:31.58,0:14:36.58,Default,,0,0,0,,Уа. Бірінші болу үшін көңіл-күйіңіз жақсы болуы керек.
Dialogue: 0,0:14:36.58,0:14:38.58,Default,,0,0,0,,Иә. Берус! Берус!
Dialogue: 0,0:14:38.58,0:14:44.59,Default,,0,0,0,,Берус! Берус! Берус! Берус! Берус!
Dialogue: 0,0:14:44.59,0:14:48.59,Default,,0,0,0,,《Ой... сабыр ет. Өте көп》→
Dialogue: 0,0:14:48.59,0:14:52.60,Default,,0,0,0,,《Васабимен бір оқпен бірдеңе алу мүмкін емес》→
Dialogue: 0,0:14:52.60,0:14:54.60,Default,,0,0,0,,《Сұрау》
Dialogue: 0,0:14:54.60,0:15:05.61,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:05.61,0:15:07.55,Default,,0,0,0,,Иә? (Вегета) Ах.
Dialogue: 0,0:15:07.55,0:15:10.55,Default,,0,0,0,,Мм!? (Вегета) Ах!
Dialogue: 0,0:16:53.12,0:16:56.12,Default,,0,0,0,,А... аа....
Dialogue: 0,0:16:56.12,0:17:01.13,Default,,0,0,0,,Уф….
Dialogue: 0,0:17:01.13,0:17:03.13,Default,,0,0,0,,О… ой… ой….
Dialogue: 0,0:17:08.13,0:17:10.13,Default,,0,0,0,,Аа….
Dialogue: 0,0:17:14.14,0:17:18.14,Default,,0,0,0,,Бітті. Аа….
Dialogue: 0,0:17:20.14,0:17:23.15,Default,,0,0,0,,Ух... у... →
Dialogue: 0,0:17:23.15,0:17:28.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:28.15,0:17:30.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:30.15,0:17:33.16,Default,,0,0,0,,Үлпілдек ұндағы→
Dialogue: 0,0:17:33.16,0:17:35.16,Default,,0,0,0,,Сегізаяқтың құрылымы. →
Dialogue: 0,0:17:35.16,0:17:38.16,Default,,0,0,0,,Неліктен мен осы уақытқа дейін бұл ынтымақтастықты байқамадым?
Dialogue: 0,0:17:38.16,0:17:42.17,Default,,0,0,0,,Тұздық та жақсы. Шынымен жақсы!
Dialogue: 0,0:17:42.17,0:17:46.17,Default,,0,0,0,,Бұл дәмді. Оны қазір кешкі ас мәзіріңізге қосыңыз.
Dialogue: 0,0:17:46.17,0:17:48.11,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:17:48.11,0:17:50.11,Default,,0,0,0,,Васаби жоқ. Жақсы.
Dialogue: 0,0:17:50.11,0:17:53.11,Default,,0,0,0,,Барка. Мұндай кезде васаби → қолданған дұрыс
Dialogue: 0,0:17:53.11,0:17:55.11,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:17:55.11,0:17:57.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:57.11,0:17:59.12,Default,,0,0,0,,Тексеру. Өшті.
Dialogue: 0,0:17:59.12,0:18:02.12,Default,,0,0,0,,күрсіну. Қанша жүрек болса да, жетпейді.
Dialogue: 0,0:18:02.12,0:18:05.12,Default,,0,0,0,,Қараңыз! Бұл қызықты емес пе?
Dialogue: 0,0:18:05.12,0:18:07.12,Default,,0,0,0,,Ах.
Dialogue: 0,0:18:07.12,0:18:09.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:09.13,0:18:11.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:11.13,0:18:13.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:13.13,0:18:15.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:15.13,0:18:19.13,Default,,0,0,0,,Неге тек мен ғана?
Dialogue: 0,0:18:22.14,0:18:24.14,Default,,0,0,0,,Бұл тыныш.
Dialogue: 0,0:18:24.14,0:18:26.14,Default,,0,0,0,,Менің ішім тоқ→
Dialogue: 0,0:18:26.14,0:18:28.15,Default,,0,0,0,,Бұл өте жақсы сезінеді.
Dialogue: 0,0:18:28.15,0:18:31.15,Default,,0,0,0,,Мен мүлдем ұмытып кеттім ...
Dialogue: 0,0:18:31.15,0:18:34.15,Default,,0,0,0,,Дүниені бағындыру тым көп қиындық тудырмай ма?
Dialogue: 0,0:18:34.15,0:18:37.15,Default,,0,0,0,,Иә, иә. Бұл дұрыс.
Dialogue: 0,0:18:37.15,0:18:40.16,Default,,0,0,0,,…Бұл рас па? →
Dialogue: 0,0:18:40.16,0:18:44.16,Default,,0,0,0,,Палау бандысының өмір сүруінің себебі – әлемдік үстемдік! →
Dialogue: 0,0:18:44.16,0:18:47.18,Default,,0,0,0,,Мен мүлде, мүлде, мүлде бас тарта алмаймын! →
Dialogue: 0,0:18:47.18,0:18:52.10,Default,,0,0,0,,Айдаһар шарлары осы кемеде! →
Dialogue: 0,0:18:52.10,0:18:55.11,Default,,0,0,0,,Нгах…. →
Dialogue: 0,0:18:55.11,0:18:57.11,Default,,0,0,0,,Уф….
Dialogue: 0,0:18:57.11,0:19:01.11,Default,,0,0,0,,Егер бос уақытыңыз болса, маған қалдықтарды толтыруға көмектесе аласыз ба?
Dialogue: 0,0:19:01.11,0:19:03.11,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:10.12,0:19:28.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:28.14,0:19:30.14,Default,,0,0,0,,Цк. Апыр-ай!
Dialogue: 0,0:19:32.14,0:19:34.15,Default,,0,0,0,,Хехе. (Готен) Дұрыс.
Dialogue: 0,0:19:34.15,0:19:36.15,Default,,0,0,0,,Әлі жоқ! (Готен) Уау! →
Dialogue: 0,0:19:36.15,0:19:38.15,Default,,0,0,0,,Бұл қорқынышты, Транкс!
Dialogue: 0,0:19:38.15,0:19:41.15,Default,,0,0,0,,Жартылай жер. Және бала.
Dialogue: 0,0:19:41.15,0:19:45.16,Default,,0,0,0,,Ал екіншісі - осылай.
Dialogue: 0,0:19:45.16,0:19:51.10,Default,,0,0,0,,Күрсіну…. Супер Сайян Құдай. сен қайдасың?
Dialogue: 0,0:19:51.10,0:19:54.10,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз! →
Dialogue: 0,0:19:54.10,0:19:56.10,Default,,0,0,0,,Такояки пирамидасы!
Dialogue: 0,0:19:56.10,0:19:58.10,Default,,0,0,0,,Еңбектеріңіз үшін рахмет. Рақмет сізге.
Dialogue: 0,0:19:58.10,0:20:00.10,Default,,0,0,0,,Енді не істейсің?
Dialogue: 0,0:20:00.10,0:20:05.11,Default,,0,0,0,,Менде енді ештеңе жоқ. Менің де ішім ісіп кетті.
Dialogue: 0,0:20:05.11,0:20:08.11,Default,,0,0,0,,Қайтып барып ұйықтайтын курсқа барар ма екенмін.
Dialogue: 0,0:20:08.11,0:20:11.12,Default,,0,0,0,,《Иә. жақсы. Өз планетаңызға тез оралыңыз》
Dialogue: 0,0:20:11.12,0:20:13.12,Default,,0,0,0,,Сәлем. (Вегета) Иә.
Dialogue: 0,0:20:13.12,0:20:17.12,Default,,0,0,0,,Мен Кайтода болдым... мм, бұл не болды?
Dialogue: 0,0:20:17.12,0:20:20.12,Default,,0,0,0,,Сон Гоку. Дұрыс, Гоку.
Dialogue: 0,0:20:20.12,0:20:23.13,Default,,0,0,0,,Онымен қандай қарым-қатынастасыз?
Dialogue: 0,0:20:23.13,0:20:25.13,Default,,0,0,0,,Немесе... Айтайын дегенім, олар жау...
Dialogue: 0,0:20:25.13,0:20:27.13,Default,,0,0,0,,Немесе дұрысырақ?
Dialogue: 0,0:20:27.13,0:20:30.13,Default,,0,0,0,,Ах... Аа….
Dialogue: 0,0:20:33.14,0:20:37.14,Default,,0,0,0,,Көрмегеніме біраз болды, Сайяндар да өзгерді.
Dialogue: 0,0:20:37.14,0:20:40.14,Default,,0,0,0,,Толығымен жоғалған.
Dialogue: 0,0:20:40.14,0:20:42.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:42.15,0:20:45.15,Default,,0,0,0,,Уа! (Готен) А.
Dialogue: 0,0:20:45.15,0:20:47.17,Default,,0,0,0,,А... О, жоқ.
Dialogue: 0,0:20:47.17,0:20:49.17,Default,,0,0,0,,Кешіріңіз! Апыр-ай!
Dialogue: 0,0:20:51.09,0:20:53.09,Default,,0,0,0,,(Оқушы) Қайырлы таң. (Оқушы) Қайырлы таң. Ой, күйіп кеткен екен!
Dialogue: 0,0:20:55.09,0:20:57.09,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:21:00.10,0:21:03.10,Default,,0,0,0,,《Не болды! 》
Dialogue: 0,0:21:03.10,0:21:06.10,Default,,0,0,0,,Сіз ашулысыз ба? Соған ұқсайды ма?
Dialogue: 0,0:21:06.10,0:21:08.11,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:08.11,0:21:11.11,Default,,0,0,0,,Орынсыз. Мен ашулы емеспін.
Dialogue: 0,0:21:11.11,0:21:15.11,Default,,0,0,0,,Мен қатты ашуландым.
Dialogue: 0,0:21:15.11,0:21:18.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:18.12,0:21:20.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:25.12,0:21:28.13,Default,,0,0,0,,Ой... иә!
Dialogue: 0,0:21:28.13,0:21:31.13,Default,,0,0,0,,Иә!? (Вегета) Ах!
Dialogue: 0,0:21:31.13,0:21:33.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:33.13,0:21:35.13,Default,,0,0,0,,Ах.
Dialogue: 0,0:21:35.13,0:21:38.13,Default,,0,0,0,,Сіз нені айтасыз? Енді?
Dialogue: 0,0:21:40.14,0:21:46.14,Default,,0,0,0,,Міне, сол жаққа қара, Хагакуре-сан!
Dialogue: 0,0:21:46.14,0:21:49.08,Default,,0,0,0,,Иә! Эй!
Dialogue: 0,0:21:49.08,0:21:51.08,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:21:51.08,0:21:53.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:56.09,0:21:59.09,Default,,0,0,0,,О! (Бірус Үйіс) Иә?
Dialogue: 0,0:22:04.10,0:22:07.10,Default,,0,0,0,,Taco taco taco taco taco taco….
Dialogue: 0,0:22:07.10,0:22:10.10,Default,,0,0,0,,Turco Turco.
Dialogue: 0,0:22:10.10,0:22:13.10,Default,,0,0,0,,Мен саған дәл қазір қытырлақ және жұмсақ тамақ әкелемін!
Dialogue: 0,0:22:13.10,0:22:16.11,Default,,0,0,0,,Келесі жолы васабисіз тапсырыс беремін!
Dialogue: 0,0:22:16.11,0:22:19.11,Default,,0,0,0,,Әйтеуір ашулы атмосфера сейілді.
Dialogue: 0,0:22:19.11,0:22:22.11,Default,,0,0,0,,Ашулансам қарным ашады.
Dialogue: 0,0:22:22.11,0:22:25.12,Default,,0,0,0,,Айтпақшы, Беерус-сама. Пудинг деп аталатын десерт → болып табылады
Dialogue: 0,0:22:25.12,0:22:28.12,Default,,0,0,0,,Тамағыңызды ұнаттыңыз ба? пудинг?
Dialogue: 0,0:22:28.12,0:22:31.12,Default,,0,0,0,,Бұл шынымен тегіс және дәмді.
Dialogue: 0,0:22:31.12,0:22:34.13,Default,,0,0,0,,Бұл не? Бұл қайда? Жарайды онда.
Dialogue: 0,0:22:34.13,0:22:37.13,Default,,0,0,0,,Менің сүйікті жарымның туған күнін жандандыру→
Dialogue: 0,0:22:37.13,0:22:39.13,Default,,0,0,0,,Осы уақытқа дейін баруға қалай батылы бардың?
Dialogue: 0,0:22:39.13,0:22:42.13,Default,,0,0,0,,Мен оны қарап шықтым, Вегета. (Вегета) Үндетпе...
Dialogue: 0,0:22:42.13,0:22:44.14,Default,,0,0,0,,Ах.
Dialogue: 0,0:22:44.14,0:22:47.15,Default,,0,0,0,,Иә, иә. Хмф, хмф.
Dialogue: 0,0:22:47.15,0:22:49.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:49.07,0:22:53.08,Default,,0,0,0,,Кешіріңіз. Мен дүкен қызметкерлерінен оның сатылып кеткенін сұрадым. →
Dialogue: 0,0:22:53.08,0:22:57.08,Default,,0,0,0,,Осы пудингті бізбен бөлісе аласыз ба?
Dialogue: 0,0:22:57.08,0:23:01.09,Default,,0,0,0,,Қараңыз. Сондықтан мұның бәрін өзіңізге қалдырсаңыз, жақсы емес.
Dialogue: 0,0:23:01.09,0:23:04.09,Default,,0,0,0,,《О, бұл》→
Dialogue: 0,0:23:04.09,0:23:08.09,Default,,0,0,0,,《Пурупуру Шиния》→
Dialogue: 0,0:23:08.09,0:23:11.10,Default,,0,0,0,,《Дәмді көрінеді》 (Сілекейдің дыбысы)
Dialogue: 0,0:23:11.10,0:23:16.10,Default,,0,0,0,,Жоқ, кешіріңіз. Бір емес, екеуі.
Dialogue: 0,0:23:16.10,0:23:19.10,Default,,0,0,0,,Жоқ. Бәрі менікі. Аа уже.
Dialogue: 0,0:23:19.10,0:23:24.11,Default,,0,0,0,,Кешіріңіз. Біз алыс жұлдыздан келдік.
Dialogue: 0,0:23:24.11,0:23:27.11,Default,,0,0,0,,Пудинг деп аталатын тағамды өткізіп алсаңыз→
Dialogue: 0,0:23:27.11,0:23:31.12,Default,,0,0,0,,Келесі тамақты қашан жейтінімді білмеймін. Сонымен...
Dialogue: 0,0:23:31.12,0:23:33.12,Default,,0,0,0,,Мм. Сүйікті сүйікті...
Dialogue: 0,0:23:33.12,0:23:36.12,Default,,0,0,0,,Ах! Буу.
Dialogue: 0,0:23:36.12,0:23:39.12,Default,,0,0,0,,Ах! Хмф!
Dialogue: 0,0:23:39.12,0:23:42.13,Default,,0,0,0,,Мен күштімін. Сондықтан мен көп жеймін.
Dialogue: 0,0:23:42.13,0:23:44.13,Default,,0,0,0,,Шағымдарыңыз бар ма?
Dialogue: 0,0:23:48.07,0:23:53.07,Default,,0,0,0,,Бұл сіздің теорияңыз ба?
Dialogue: 0,0:23:53.07,0:23:55.07,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:23:55.07,0:23:58.08,Default,,0,0,0,,Күте тұрыңыз! Бұл жерде менің бетімді елемеңіз ...
Dialogue: 0,0:23:58.08,0:24:00.08,Default,,0,0,0,,Кедергі.
Dialogue: 0,0:24:00.08,0:24:02.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:02.08,0:24:04.08,Default,,0,0,0,,Ах.
Dialogue: 0,0:24:11.09,0:24:14.09,Default,,0,0,0,,О... тоқта!
Dialogue: 0,0:24:18.10,0:24:23.10,Default,,0,0,0,,Буу! Буубуубуубуу….
Dialogue: 0,0:24:23.10,0:24:25.10,Default,,0,0,0,,О, құдайым. иә? →
Dialogue: 0,0:24:25.10,0:24:27.10,Default,,0,0,0,,Ухухуху.
Dialogue: 0,0:24:27.10,0:24:31.10,Default,,0,0,0,,Буу! Оны үрлеп тастаңыз!
Dialogue: 0,0:24:33.11,0:24:35.11,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:24:35.11,0:24:39.12,Default,,0,0,0,,Мен үлкен жүректі Құдаймын.
Dialogue: 0,0:24:39.12,0:24:45.12,Default,,0,0,0,,В…. Уау Уау Уау!
Dialogue: 0,0:24:45.12,0:24:48.06,Default,,0,0,0,,Бірақ мен шыдай алмайтын бір нәрсе бар →
Dialogue: 0,0:24:48.06,0:24:51.06,Default,,0,0,0,,Бір ғана нәрсе бар.
Dialogue: 0,0:24:51.06,0:24:54.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:56.07,0:25:01.07,Default,,0,0,0,,Бұл сізге лайықты құрмет көрсете алмайтын адамдардың сезімсіздігі.
Dialogue: 0,0:25:01.07,0:25:07.07,Default,,0,0,0,,Бұл! Апыр-ай!
Dialogue: 0,0:25:10.08,0:25:12.08,Default,,0,0,0,,Хехе.
Dialogue: 0,0:25:19.09,0:25:21.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:21.09,0:25:23.09,Default,,0,0,0,,Конверт пе?
Dialogue: 0,0:25:28.10,0:25:31.10,Default,,0,0,0,,Аа….
Dialogue: 0,0:25:37.11,0:25:40.11,Default,,0,0,0,,《Дайын》
Dialogue: 0,0:25:40.11,0:25:44.11,Default,,0,0,0,,《Толық аяқталды》
Dialogue: 0,0:25:46.12,0:25:56.12,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:48.11,0:26:50.11,Default,,0,0,0,,Сәлем, Гоку.
Dialogue: 0,0:26:50.11,0:26:53.12,Default,,0,0,0,,Беерус-сама ақыры ашуланды.
Dialogue: 0,0:26:53.12,0:26:56.12,Default,,0,0,0,,Күте тұрыңыз! Пикколо Гохан! О, тіпті Готенкс!
Dialogue: 0,0:26:56.12,0:26:58.12,Default,,0,0,0,,Сенің туған күнің шашылып жатыр емес пе?
Dialogue: 0,0:26:58.12,0:27:01.13,Default,,0,0,0,,Бұлманың бұлай үндемей қалуы мүмкін емес.
Dialogue: 0,0:27:01.13,0:27:03.13,Default,,0,0,0,,Вегета, не болды!
Dialogue: 0,0:27:03.13,0:27:06.13,Default,,0,0,0,,Ештеңе істемеу сізге ұқсамайды.
Dialogue: 0,0:27:06.13,0:27:08.13,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:12.14,0:27:14.14,Default,,0,0,0,,Міндетті түрде қарап шығу керек.
Dialogue: 0,0:27:15.64,0:27:21.64,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory