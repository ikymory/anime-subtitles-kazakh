Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.36,0:01:43.36,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:09.42,0:04:11.42,Default,,0,0,0,,<Вегетамен→
Dialogue: 0,0:04:11.42,0:04:17.43,Default,,0,0,0,,Гоку Жою құдайы Берус тұратын планетада жаттығуға шешім қабылдады>
Dialogue: 0,0:04:17.43,0:04:23.43,Default,,0,0,0,,<Екеуі Уис берген тапсырманы орындап көрді>
Dialogue: 0,0:04:23.43,0:04:27.44,Default,,0,0,0,,<Осындай уақытта, Ғаламда шалғайда→
Dialogue: 0,0:04:27.44,0:04:30.44,Default,,0,0,0,,Тіпті жердің тыныштығын шайқауы мүмкін→
Dialogue: 0,0:04:30.44,0:04:35.44,Default,,0,0,0,,Жаңа қауіп қозғала бастады>
Dialogue: 0,0:04:35.44,0:04:38.45,Default,,0,0,0,,Хмм, сөзсіз.
Dialogue: 0,0:04:38.45,0:04:40.45,Default,,0,0,0,,Мен ойлағандай.
Dialogue: 0,0:04:40.45,0:04:42.45,Default,,0,0,0,,Вадос.
Dialogue: 0,0:04:45.45,0:04:48.45,Default,,0,0,0,,Хмм, мен қателескен шығармын...
Dialogue: 0,0:05:30.43,0:05:33.44,Default,,0,0,0,,Келіңіздер, бәріңіз! Бастайық!
Dialogue: 0,0:05:33.44,0:05:53.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:53.46,0:05:55.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:55.46,0:05:57.46,Default,,0,0,0,,Гах... →
Dialogue: 0,0:05:57.46,0:06:00.46,Default,,0,0,0,,Уф…. →
Dialogue: 0,0:06:00.46,0:06:02.46,Default,,0,0,0,,Гугугугу….
Dialogue: 0,0:06:02.46,0:06:07.40,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:07.40,0:06:10.41,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:10.41,0:06:12.41,Default,,0,0,0,,Эй, күл.
Dialogue: 0,0:06:12.41,0:06:15.41,Default,,0,0,0,,Эй, сәлем. (Періште) Күл.
Dialogue: 0,0:06:15.41,0:06:17.41,Default,,0,0,0,,<<Әй, эй.
Dialogue: 0,0:06:17.41,0:06:20.42,Default,,0,0,0,,Бірге күлейік. Бұл қызық.
Dialogue: 0,0:06:20.42,0:06:24.42,Default,,0,0,0,,Гах! →
Dialogue: 0,0:06:24.42,0:06:28.42,Default,,0,0,0,,Сәлем! !
Dialogue: 0,0:06:28.42,0:06:31.42,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:06:34.43,0:06:37.43,Default,,0,0,0,,Жағдайды хабарлаңыз! (Бақа солдат) Ха!
Dialogue: 0,0:06:37.43,0:06:41.44,Default,,0,0,0,,Біздің ең үлкен күшіміз 1-ші және 2-ші батальон жойылды.
Dialogue: 0,0:06:41.44,0:06:46.44,Default,,0,0,0,,Келесі 3-ші батальонның жартысы хабарсыз кетті.
Dialogue: 0,0:06:46.44,0:06:49.44,Default,,0,0,0,,Біз сарбаздарымыздың 60% жоғалттық па?
Dialogue: 0,0:06:49.44,0:06:52.45,Default,,0,0,0,,Одан артық нәрсе жаман болар еді...
Dialogue: 0,0:06:52.45,0:06:55.45,Default,,0,0,0,,Сіз тіпті әскери келбетіңізді сақтай алмайсыз.
Dialogue: 0,0:06:55.45,0:06:57.45,Default,,0,0,0,,Сорбет мырза?
Dialogue: 0,0:06:59.45,0:07:01.46,Default,,0,0,0,,Егер бұл орын алса →
Dialogue: 0,0:07:01.46,0:07:04.46,Default,,0,0,0,,Өйткені, Фриеза-самадан бізді тірілтуді сұраудан басқа амалымыз жоқ →
Dialogue: 0,0:07:04.46,0:07:07.40,Default,,0,0,0,,Енді жол жоқ. (Барлығы) иә?
Dialogue: 0,0:07:07.40,0:07:09.40,Default,,0,0,0,,Фриза-сама? жаңғыру?
Dialogue: 0,0:07:09.40,0:07:12.40,Default,,0,0,0,,Намекиялықтардың тірі қалғандары табылды ма?
Dialogue: 0,0:07:12.40,0:07:15.40,Default,,0,0,0,,Жоқ. Ол әлі ашылған жоқ.
Dialogue: 0,0:07:15.40,0:07:17.41,Default,,0,0,0,,Мм. Сорбет мырза.
Dialogue: 0,0:07:17.41,0:07:19.41,Default,,0,0,0,,Иә? Егер Freeza-sama →
Dialogue: 0,0:07:19.41,0:07:22.41,Default,,0,0,0,,Қайта тірілдің десеңіз, әскеріміздің жағдайын өзіңіз бағамдай аласыз →
Dialogue: 0,0:07:22.41,0:07:25.41,Default,,0,0,0,,Оны өзгертуге бола ма? Тагома! →
Dialogue: 0,0:07:25.41,0:07:29.42,Default,,0,0,0,,Сіз ештеңе түсінбейсіз. Күрсіну….
Dialogue: 0,0:07:29.42,0:07:32.42,Default,,0,0,0,,Өзінің абсолютті күшімен Фриза-сама →
Dialogue: 0,0:07:32.42,0:07:35.42,Default,,0,0,0,,Бұл ғаламның көп бөлігі бақылауда→
Dialogue: 0,0:07:35.42,0:07:38.43,Default,,0,0,0,,Сол аяусыз көріністен→
Dialogue: 0,0:07:38.43,0:07:42.43,Default,,0,0,0,,Ол зұлымдық императоры ретінде бүкіл әлемде қорқатын.
Dialogue: 0,0:07:42.43,0:07:46.43,Default,,0,0,0,,《Кеттік, зерігуден арылайық》
Dialogue: 0,0:08:04.45,0:08:06.47,Default,,0,0,0,,《Охохохо》
Dialogue: 0,0:08:06.47,0:08:09.39,Default,,0,0,0,,《Бұл әдемі отшашулар. Охохохо...》
Dialogue: 0,0:08:09.39,0:08:11.39,Default,,0,0,0,,Егер сол адам өмірге қайта оралса →
Dialogue: 0,0:08:11.39,0:08:16.40,Default,,0,0,0,,Біздің әскер міндетті түрде қайта құрылады. →
Dialogue: 0,0:08:16.40,0:08:19.40,Default,,0,0,0,,Қараңыз. Фриэза-сама қайта тірілсе ше →
Dialogue: 0,0:08:19.40,0:08:21.40,Default,,0,0,0,,Бұл модельдеу. →
Dialogue: 0,0:08:21.40,0:08:24.41,Default,,0,0,0,,Әлемнің 70% біздікі болады.
Dialogue: 0,0:08:24.41,0:08:26.41,Default,,0,0,0,,О! Бірақ→
Dialogue: 0,0:08:26.41,0:08:28.41,Default,,0,0,0,,Бұл шынымен де жақсы жұмыс істей ме?
Dialogue: 0,0:08:28.41,0:08:31.41,Default,,0,0,0,,Сіз күмәнданасыз ба? Фриеза-сама қайтыс болғаннан кейін →
Dialogue: 0,0:08:31.41,0:08:34.42,Default,,0,0,0,,Фризаның әскерін кім қолдады?
Dialogue: 0,0:08:34.42,0:08:37.42,Default,,0,0,0,,Бұл Сорбет мырза. Дұрыс, бұл менмін.
Dialogue: 0,0:08:37.42,0:08:41.42,Default,,0,0,0,,Бұл менің стратегиям және менің миым. →
Dialogue: 0,0:08:41.42,0:08:45.43,Default,,0,0,0,,Уайымдамаңыз. Бұл есептеуде ешқандай қате жоқ. →
Dialogue: 0,0:08:45.43,0:08:49.43,Default,,0,0,0,,Фриеза-сама менімен келісетініне сенімдімін.
Dialogue: 0,0:08:49.43,0:08:52.43,Default,,0,0,0,,Жарайды. Жерге барайық.
Dialogue: 0,0:08:52.43,0:08:54.44,Default,,0,0,0,,Не? Дегенмен→
Dialogue: 0,0:08:54.44,0:08:56.44,Default,,0,0,0,,Жер қауіпті емес пе?
Dialogue: 0,0:08:56.44,0:08:59.44,Default,,0,0,0,,Айдаһар шарын таба алатын әйел →
Dialogue: 0,0:08:59.44,0:09:02.44,Default,,0,0,0,,Фриеза-саманы жеңген Сайянның досы.
Dialogue: 0,0:09:02.44,0:09:04.45,Default,,0,0,0,,Біз қазір осындай жайбарақат жұмыс жасаймыз→
Dialogue: 0,0:09:04.45,0:09:07.38,Default,,0,0,0,,Сіз мұны айта аламын деп ойлайсыз ба? ?
Dialogue: 0,0:09:07.38,0:09:10.39,Default,,0,0,0,,Намекиан табылмайтындықтан→
Dialogue: 0,0:09:10.39,0:09:13.39,Default,,0,0,0,,Тәуекелдерді біле тұра Жерге барудан басқа амалым жоқ. →
Dialogue: 0,0:09:13.39,0:09:15.39,Default,,0,0,0,,Шпиондық камераның түсірілімін жіберіңіз.
Dialogue: 0,0:09:18.39,0:09:22.40,Default,,0,0,0,,Айдаһар шарларын жалғыз бұл әйел таба алмайтын сияқты. →
Dialogue: 0,0:09:22.40,0:09:25.40,Default,,0,0,0,,Тагома! Жерге бірге барайық! Ха!
Dialogue: 0,0:09:25.40,0:09:27.40,Default,,0,0,0,,Сорбет мырза, сізге еріп жүруге рұқсат етіңіз.
Dialogue: 0,0:09:27.40,0:09:29.40,Default,,0,0,0,,№ →
Dialogue: 0,0:09:29.40,0:09:32.41,Default,,0,0,0,,Жердегі Сайяндардың жауынгерлік күші зор→
Dialogue: 0,0:09:32.41,0:09:36.41,Default,,0,0,0,,Оның скаутерсіз де заттарды анықтау мүмкіндігі бар сияқты. →
Dialogue: 0,0:09:36.41,0:09:39.41,Default,,0,0,0,,Егер сіз үлкен топпен барсаңыз, сізді байқап қалуы мүмкін.
Dialogue: 0,0:09:39.41,0:09:43.42,Default,,0,0,0,,Түсінді. Артық кеткенім үшін кешіріңіз.
Dialogue: 0,0:09:43.42,0:09:47.42,Default,,0,0,0,,Ондай жағдайда Шисами екеуміз Жерге бет аламыз→
Dialogue: 0,0:09:47.42,0:09:49.42,Default,,0,0,0,,Артында Сорбет-сама қалса қауіпсіз емес пе?
Dialogue: 0,0:09:49.42,0:09:52.43,Default,,0,0,0,,Сіз осында тұра аласыз ба? →
Dialogue: 0,0:09:52.43,0:09:57.43,Default,,0,0,0,,Мен өз қолыммен Фриеза-саманы тірілтемін.
Dialogue: 0,0:09:59.43,0:10:07.38,Default,,0,0,0,,Уау! Әке әке...! →
Dialogue: 0,0:10:07.38,0:10:09.38,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:10:09.38,0:10:12.38,Default,,0,0,0,,Уау! Алақай! Тат! →
Dialogue: 0,0:10:12.38,0:10:14.38,Default,,0,0,0,,Уау... Тея ха! Эй...! →
Dialogue: 0,0:10:14.38,0:10:16.38,Default,,0,0,0,,Атта! Ха! Ха! Ха! →
Dialogue: 0,0:10:16.38,0:10:20.39,Default,,0,0,0,,Жаса! Та ха... да!
Dialogue: 0,0:10:20.39,0:10:22.39,Default,,0,0,0,,Алыңыз!
Dialogue: 0,0:10:22.39,0:10:25.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:25.39,0:10:29.40,Default,,0,0,0,,Дараа! (Гоку/Вегета) О, жоқ...!
Dialogue: 0,0:10:29.40,0:10:33.40,Default,,0,0,0,,Уау! (Вегета) Алыңыз!
Dialogue: 0,0:10:33.40,0:10:35.40,Default,,0,0,0,,Иә Stop Stop.
Dialogue: 0,0:10:37.41,0:10:40.41,Default,,0,0,0,,Екеуің де бұрынғыдан жақсысың→
Dialogue: 0,0:10:40.41,0:10:43.41,Default,,0,0,0,,Дегенмен, ол әлі де жеткілікті жылдам емес.
Dialogue: 0,0:10:43.41,0:10:45.41,Default,,0,0,0,,Қараңдаршы, мен өз қолтаңбамды жаздым.
Dialogue: 0,0:10:45.41,0:10:47.41,Default,,0,0,0,,Не? О?
Dialogue: 0,0:10:49.42,0:10:52.42,Default,,0,0,0,,Уау! Бұл таңқаларлық, Мистер Уис!
Dialogue: 0,0:10:52.42,0:10:54.42,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:10:54.42,0:10:57.43,Default,,0,0,0,,Айтпақшы, Вегета мырза. (Вегета) Не?
Dialogue: 0,0:10:57.43,0:11:00.43,Default,,0,0,0,,Сіз шайқаста данышпан болсаңыз да→
Dialogue: 0,0:11:00.43,0:11:03.43,Default,,0,0,0,,Сіз әрқашан Гокудан бір қадам алдасыз.
Dialogue: 0,0:11:03.43,0:11:06.45,Default,,0,0,0,,Цк. Оны анық айт.
Dialogue: 0,0:11:06.45,0:11:08.37,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:11:08.37,0:11:11.37,Default,,0,0,0,,Сіз білесіз бе! Міне бітті!
Dialogue: 0,0:11:11.37,0:11:15.38,Default,,0,0,0,,Сіз әрқашан тым қобалжыйсыз. →
Dialogue: 0,0:11:15.38,0:11:18.38,Default,,0,0,0,,Олай болса, сіз қиын уақытта толық қуатта жұмыс істей алмайсыз.
Dialogue: 0,0:11:18.38,0:11:22.38,Default,,0,0,0,,Демалу керек уақытта демалу да маңызды. →
Dialogue: 0,0:11:22.38,0:11:24.39,Default,,0,0,0,,Гоку сияқты.
Dialogue: 0,0:11:24.39,0:11:27.39,Default,,0,0,0,,Хаха Дұрыс, Вегета.
Dialogue: 0,0:11:27.39,0:11:30.39,Default,,0,0,0,,K. Бірақ екінші жағынан...
Dialogue: 0,0:11:30.39,0:11:33.39,Default,,0,0,0,,Иә? Апыр-ай...!
Dialogue: 0,0:11:33.39,0:11:35.40,Default,,0,0,0,,Тым босаңсу да қиындық тудырады.
Dialogue: 0,0:11:35.40,0:11:40.40,Default,,0,0,0,,Сондай-ақ, сіздің шектен тыс сенімділігіңіз үлкен мәселе. →
Dialogue: 0,0:11:40.40,0:11:43.40,Default,,0,0,0,,Қанша күшті болсаң да, есіңді мүлде жоғалтсаң→
Dialogue: 0,0:11:43.40,0:11:45.41,Default,,0,0,0,,Дене нәзік.
Dialogue: 0,0:11:45.41,0:11:48.41,Default,,0,0,0,,Гоку өзіне сенімді болғаны сонша, сақтығын төмендететін көрініс бар→
Dialogue: 0,0:11:48.41,0:11:50.41,Default,,0,0,0,,Жиі көрінеді.
Dialogue: 0,0:11:50.41,0:11:52.41,Default,,0,0,0,,Хе, дұрыс.
Dialogue: 0,0:11:52.41,0:11:55.42,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:11:55.42,0:11:58.42,Default,,0,0,0,,Хун. →
Dialogue: 0,0:11:58.42,0:12:02.42,Default,,0,0,0,,Енді жаттығуымыздың қарқынын арттырайық.
Dialogue: 0,0:12:02.42,0:12:22.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:22.38,0:12:25.38,Default,,0,0,0,,Баа. (Пан күледі)
Dialogue: 0,0:12:25.38,0:12:27.38,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:12:27.38,0:12:30.39,Default,,0,0,0,,(Панның күлкісі)
Dialogue: 0,0:12:30.39,0:12:33.39,Default,,0,0,0,,Сүйікті сүйіктім... баа!
Dialogue: 0,0:12:33.39,0:12:36.39,Default,,0,0,0,,(Панның күлкісі)
Dialogue: 0,0:12:36.39,0:12:38.39,Default,,0,0,0,,≪(Гохан) Кешіріңіз, Пикколо-сан.
Dialogue: 0,0:12:38.39,0:12:40.40,Default,,0,0,0,,Мен сәл кешігіп қалдым.
Dialogue: 0,0:12:40.40,0:12:43.40,Default,,0,0,0,,Жүр, Гохан... Бұл тез болды, солай емес пе?
Dialogue: 0,0:12:43.40,0:12:46.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:46.40,0:12:49.40,Default,,0,0,0,,Сәлем Пан Чан, үйде болғаныңызға рахмет.
Dialogue: 0,0:12:49.40,0:12:53.41,Default,,0,0,0,,Пикколоның ағасы Ол өте мейірімді еді, солай емес пе?
Dialogue: 0,0:12:53.41,0:12:56.41,Default,,0,0,0,,(Панның күлкісі)
Dialogue: 0,0:12:56.41,0:12:58.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:58.41,0:13:00.42,Default,,0,0,0,,Пикколо-сан, не болды?
Dialogue: 0,0:13:00.42,0:13:04.42,Default,,0,0,0,,Байқамайсың ба? Мен сол бағытта қозғалатын жағымсыз күш сезінемін.
Dialogue: 0,0:13:04.42,0:13:07.36,Default,,0,0,0,,А... А, енді ойласам.
Dialogue: 0,0:13:07.36,0:13:11.36,Default,,0,0,0,,Не? Кәне.
Dialogue: 0,0:13:11.36,0:13:13.36,Default,,0,0,0,,Жақында…. →
Dialogue: 0,0:13:13.36,0:13:17.37,Default,,0,0,0,,Күмән жоқ... алда не күтіп тұр...
Dialogue: 0,0:13:17.37,0:13:20.37,Default,,0,0,0,,О! Гүлп.
Dialogue: 0,0:13:20.37,0:13:22.37,Default,,0,0,0,,Біз мұны жасадық! Шу жаным!
Dialogue: 0,0:13:22.37,0:13:24.37,Default,,0,0,0,,Иә! Құрметті палау!
Dialogue: 0,0:13:24.37,0:13:29.38,Default,,0,0,0,,Енді сізде барлық жеті Айдаһар шары бар!
Dialogue: 0,0:13:29.38,0:13:31.38,Default,,0,0,0,,Осы жерге жету үшін қаншама қиындықтан өттің→
Dialogue: 0,0:13:31.38,0:13:33.38,Default,,0,0,0,,Сіз оны жеңдіңіз бе?
Dialogue: 0,0:13:33.38,0:13:35.38,Default,,0,0,0,,Түсіндім, балалар. →
Dialogue: 0,0:13:35.38,0:13:37.39,Default,,0,0,0,,Теңіздің арғы жағында, таулардың ар жағында→
Dialogue: 0,0:13:37.39,0:13:40.39,Default,,0,0,0,,Көптеген аңдармен күрескеннен кейін →
Dialogue: 0,0:13:40.39,0:13:45.39,Default,,0,0,0,,Біз мұны ақырында орындадық! →
Dialogue: 0,0:13:45.39,0:13:47.40,Default,,0,0,0,,Гуфуфу. Қазір әлем →
Dialogue: 0,0:13:47.40,0:13:50.40,Default,,0,0,0,,Бұл палау патшаға тиесілі болады.
Dialogue: 0,0:13:50.40,0:13:53.40,Default,,0,0,0,,≪Бұл туралы не деуге болады? (Барлығы) иә?
Dialogue: 0,0:13:53.40,0:13:55.40,Default,,0,0,0,,Мен саған Айдаһар шарын беремін.
Dialogue: 0,0:13:55.40,0:13:57.41,Default,,0,0,0,,Нанана... Балалар не істеп жатырсыңдар?
Dialogue: 0,0:13:57.41,0:13:59.41,Default,,0,0,0,,Бізді жалама!
Dialogue: 0,0:13:59.41,0:14:01.41,Default,,0,0,0,,Ұрлық жасауға тыйым салынады!
Dialogue: 0,0:14:06.41,0:14:10.42,Default,,0,0,0,,Сәлем! (3 адам) Уау...!
Dialogue: 0,0:14:10.42,0:14:12.42,Default,,0,0,0,,Балалар мен сендерден күш-қуат берулеріңізді сұраймын.
Dialogue: 0,0:14:12.42,0:14:16.42,Default,,0,0,0,,Дұрыс! Ха.
Dialogue: 0,0:16:00.36,0:16:02.36,Default,,0,0,0,,Уф….
Dialogue: 0,0:16:02.36,0:16:05.36,Default,,0,0,0,,Мен жинаған Айдаһар шарлары...
Dialogue: 0,0:16:07.37,0:16:09.37,Default,,0,0,0,,Маған әлі де ұнамайды! (Шу палау) А?
Dialogue: 0,0:16:09.37,0:16:12.37,Default,,0,0,0,,Бұл біздікі емес пе!
Dialogue: 0,0:16:12.37,0:16:14.38,Default,,0,0,0,,Менің! Эгоизмді доғар!
Dialogue: 0,0:16:14.38,0:16:17.38,Default,,0,0,0,,Иә! Бұл адамдар, әрине, қауіпті!
Dialogue: 0,0:16:17.38,0:16:19.38,Default,,0,0,0,,≪Не істеп жатырсың!
Dialogue: 0,0:16:19.38,0:16:21.38,Default,,0,0,0,,Қазір бастаңыз!
Dialogue: 0,0:16:21.38,0:16:23.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:25.39,0:16:28.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:28.39,0:16:30.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:34.40,0:16:39.40,Default,,0,0,0,,Уф... хах.
Dialogue: 0,0:16:41.40,0:16:44.41,Default,,0,0,0,,Кел, Шенрон! →
Dialogue: 0,0:16:44.41,0:16:48.41,Default,,0,0,0,,Менің тілегімді орындауыңызды өтінемін!
Dialogue: 0,0:16:48.41,0:16:51.41,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:16:51.41,0:16:53.35,Default,,0,0,0,,О. Ах.
Dialogue: 0,0:16:53.35,0:16:55.35,Default,,0,0,0,,Уау….
Dialogue: 0,0:16:57.35,0:17:01.36,Default,,0,0,0,,Аспан қараңғыланды...
Dialogue: 0,0:17:01.36,0:17:04.36,Default,,0,0,0,,Мен бұған сенбеймін... Шенрон ба?
Dialogue: 0,0:17:10.36,0:17:17.37,Default,,0,0,0,,(Шенронның ырылдауы)
Dialogue: 0,0:17:17.37,0:17:19.37,Default,,0,0,0,,Бұл Шенрон.
Dialogue: 0,0:17:19.37,0:17:22.38,Default,,0,0,0,,Қане, тілегіңді айт.
Dialogue: 0,0:17:22.38,0:17:25.38,Default,,0,0,0,,Кез келген тілекті орындаймын.
Dialogue: 0,0:17:25.38,0:17:28.38,Default,,0,0,0,,Өтінемін. Осы арқылы өз өміріңізді сақтаңыз...
Dialogue: 0,0:17:28.38,0:17:33.39,Default,,0,0,0,,Мм. Сіз үшін әлі де кейбір пайдалану құндылығы болуы мүмкін.
Dialogue: 0,0:17:33.39,0:17:35.39,Default,,0,0,0,,Эх!
Dialogue: 0,0:17:35.39,0:17:38.39,Default,,0,0,0,,Сорбет-сама, тезірек! Жарайды, жарайды.
Dialogue: 0,0:17:40.39,0:17:42.39,Default,,0,0,0,,Ал, мен айтайын...
Dialogue: 0,0:17:44.40,0:17:49.40,Default,,0,0,0,,Фу... Мен Фриэза-саманы тірілтемін!
Dialogue: 0,0:17:49.40,0:17:52.40,Default,,0,0,0,,Фриза-сама?
Dialogue: 0,0:17:54.34,0:17:57.34,Default,,0,0,0,,Не болды? Кез келген тілек орындалады, солай ма?
Dialogue: 0,0:17:57.34,0:17:59.35,Default,,0,0,0,,Әрине мүмкін.
Dialogue: 0,0:17:59.35,0:18:01.35,Default,,0,0,0,,Бірақ сол адамның денесі →
Dialogue: 0,0:18:01.35,0:18:06.35,Default,,0,0,0,,Ол баяғыда үзілген, қайта қалпына келтіру мүмкін емес.
Dialogue: 0,0:18:06.35,0:18:08.36,Default,,0,0,0,,《Freeza》
Dialogue: 0,0:18:08.36,0:18:10.36,Default,,0,0,0,,《Тааа! ! 》
Dialogue: 0,0:18:15.36,0:18:19.37,Default,,0,0,0,,Менің жаным сол күйінде қайта оралуының еш мәні жоқ.
Dialogue: 0,0:18:19.37,0:18:22.37,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:22.37,0:18:25.37,Default,,0,0,0,,Бұл жаман... Бөлініп кетсе де →
Dialogue: 0,0:18:25.37,0:18:28.38,Default,,0,0,0,,Қазіргі уақытта әскерилер қолданатын соңғы ойнату жабдығы →
Dialogue: 0,0:18:28.38,0:18:31.38,Default,,0,0,0,,Сіз оны қайта жандандыра аласыз.
Dialogue: 0,0:18:31.38,0:18:33.38,Default,,0,0,0,,Түсіндім... бұл дұрыс.
Dialogue: 0,0:18:33.38,0:18:35.38,Default,,0,0,0,,Мен сенімдімін Фриэза-сама.
Dialogue: 0,0:18:35.38,0:18:39.39,Default,,0,0,0,,Сәлем! Маған оның ыдырауы маңызды емес, оны қайта тірілт!
Dialogue: 0,0:18:39.39,0:18:42.39,Default,,0,0,0,,Бұл өте бастық сияқты.
Dialogue: 0,0:18:42.39,0:18:44.39,Default,,0,0,0,,Уф... →
Dialogue: 0,0:18:44.39,0:18:48.40,Default,,0,0,0,,Фриэза-саманы тірілтіңіз...
Dialogue: 0,0:18:48.40,0:18:52.40,Default,,0,0,0,,Оған көмектесу мүмкін емес. Түсіндім.
Dialogue: 0,0:18:54.34,0:18:57.34,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:19:02.34,0:19:07.35,Default,,0,0,0,,Енді қалған екі тілегіңді айт.
Dialogue: 0,0:19:07.35,0:19:10.35,Default,,0,0,0,,Екі тілек? Ол әлі де орындала ма?
Dialogue: 0,0:19:10.35,0:19:14.36,Default,,0,0,0,,Иә. Жер құдайы өзгергенде →
Dialogue: 0,0:19:14.36,0:19:17.36,Default,,0,0,0,,Мен де жаңарттым.
Dialogue: 0,0:19:17.36,0:19:21.36,Default,,0,0,0,,Дегенмен, бұл планетадағы барлық адамдар өмірге қайта оралады деп айтылады→
Dialogue: 0,0:19:21.36,0:19:25.37,Default,,0,0,0,,Үлкен күшті қажет ететін тілектер→
Dialogue: 0,0:19:25.37,0:19:29.37,Default,,0,0,0,,Екі тілекті бірден жейді.
Dialogue: 0,0:19:29.37,0:19:31.37,Default,,0,0,0,,Мен... білмедім.
Dialogue: 0,0:19:31.37,0:19:34.38,Default,,0,0,0,,Екі ғана қалды. Папа Фриеза-сама да →
Dialogue: 0,0:19:34.38,0:19:37.38,Default,,0,0,0,,Қайта тірілтіп, саған берсем жақсы емес пе?
Dialogue: 0,0:19:37.38,0:19:39.38,Default,,0,0,0,,Менен сұрасаңыз...
Dialogue: 0,0:19:39.38,0:19:41.38,Default,,0,0,0,,Эй, мен 1 миллион Зени алғым келеді!
Dialogue: 0,0:19:41.38,0:19:44.38,Default,,0,0,0,,Мен әлемдегі ең жақсы балмұздақ алғым келеді!
Dialogue: 0,0:19:47.39,0:19:49.39,Default,,0,0,0,,Ауырсыну!
Dialogue: 0,0:19:49.39,0:19:52.41,Default,,0,0,0,,Иә! о!
Dialogue: 0,0:19:52.41,0:19:56.33,Default,,0,0,0,,Иә? Сәлем! Суық, суық, суық!
Dialogue: 0,0:19:56.33,0:19:58.33,Default,,0,0,0,,Мұз пакеттері қызмет болып табылады.
Dialogue: 0,0:19:58.33,0:20:01.34,Default,,0,0,0,,Менің тілегім орындалды.
Dialogue: 0,0:20:01.34,0:20:04.34,Default,,0,0,0,,Қош бол.
Dialogue: 0,0:20:11.35,0:20:13.35,Default,,0,0,0,,Уа, ау... →
Dialogue: 0,0:20:13.35,0:20:15.35,Default,,0,0,0,,Бауырлар!
Dialogue: 0,0:20:15.35,0:20:17.35,Default,,0,0,0,,Енді сіз үшін →
Dialogue: 0,0:20:17.35,0:20:20.35,Default,,0,0,0,,Мен оны Айдаһар допты іздестіруді ойладым, бірақ...
Dialogue: 0,0:20:20.35,0:20:22.36,Default,,0,0,0,,≪Сорбет-сама! Тезірек алайық. →
Dialogue: 0,0:20:22.36,0:20:25.36,Default,,0,0,0,,Сайяндар келуі мүмкін.
Dialogue: 0,0:20:25.36,0:20:28.36,Default,,0,0,0,,≪(Шу) Иә?
Dialogue: 0,0:20:30.36,0:20:32.37,Default,,0,0,0,,Фриеза-самадан күткендей.
Dialogue: 0,0:20:32.37,0:20:38.37,Default,,0,0,0,,Осы өмірлік күш пен қазіргі технологияның көмегімен оны міндетті түрде қалпына келтіруге болады.
Dialogue: 0,0:20:40.37,0:20:43.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:43.38,0:20:46.38,Default,,0,0,0,,Сәлем! !
Dialogue: 0,0:20:50.38,0:20:52.35,Default,,0,0,0,,Жүр, қайтайық! Ха!
Dialogue: 0,0:20:52.35,0:20:55.22,Default,,0,0,0,,≪(Шу май палау) Ым... иә? Не!
Dialogue: 0,0:20:55.22,0:20:58.22,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым...
Dialogue: 0,0:21:05.23,0:21:07.23,Default,,0,0,0,,Гекко... Гекко...
Dialogue: 0,0:21:07.23,0:21:10.24,Default,,0,0,0,,Geko?
Dialogue: 0,0:21:10.24,0:21:12.24,Default,,0,0,0,,Гекогеко~.
Dialogue: 0,0:21:12.24,0:21:15.24,Default,,0,0,0,,Хмф, сізге қиын болды. →
Dialogue: 0,0:21:15.24,0:21:17.24,Default,,0,0,0,,Жарайды, мен жақында қайтамын.
Dialogue: 0,0:21:17.24,0:21:21.24,Default,,0,0,0,,Бұл жолы Фриза-сама мен сарбаздармен.
Dialogue: 0,0:21:34.26,0:21:36.26,Default,,0,0,0,,Құрметті палау. Фриза - →
Dialogue: 0,0:21:36.26,0:21:39.27,Default,,0,0,0,,Бұл не? Сен білесің бе?
Dialogue: 0,0:21:39.27,0:21:43.27,Default,,0,0,0,,Қандай болса да, бұл керемет нәрсе емес сияқты. →
Dialogue: 0,0:21:43.27,0:21:46.27,Default,,0,0,0,,Иә! Біз ғарыш кемесін жасап жатырмыз →
Dialogue: 0,0:21:46.27,0:21:48.28,Default,,0,0,0,,Бір планетаға қашыңыз!
Dialogue: 0,0:21:48.28,0:21:52.28,Default,,0,0,0,,Не? Сіз ғарыш кемесін жасай аласыз ба?
Dialogue: 0,0:21:52.28,0:21:54.32,Default,,0,0,0,,Сіз алған 1 миллион зеннимен →
Dialogue: 0,0:21:54.32,0:21:57.32,Default,,0,0,0,,Бірдеңе істе! Бұл жақсы болды! Шуу!
Dialogue: 0,0:21:57.32,0:21:59.32,Default,,0,0,0,,Сіз! бәрібір 100 миллион →
Dialogue: 0,0:21:59.32,0:22:01.32,Default,,0,0,0,,Мен көбірек ақша жұмсағанымды қалаймын!
Dialogue: 0,0:22:01.32,0:22:04.33,Default,,0,0,0,,Тіпті сен, неліктен балмұздақ?
Dialogue: 0,0:22:04.33,0:22:06.33,Default,,0,0,0,,Еріп кетсе, бітті!
Dialogue: 0,0:22:06.33,0:22:10.33,Default,,0,0,0,,Уау... Мен көптен бері ұстадым!
Dialogue: 0,0:22:10.33,0:22:12.33,Default,,0,0,0,,Балалар! →
Dialogue: 0,0:22:12.33,0:22:19.34,Default,,0,0,0,,Мен... мен... тілек айта алмадым.
Dialogue: 0,0:22:19.34,0:22:23.34,Default,,0,0,0,,Құрметті палау, егер сізде осы ғана болса→
Dialogue: 0,0:22:23.34,0:22:25.35,Default,,0,0,0,,Әзірше той жасай аламыз.
Dialogue: 0,0:22:25.35,0:22:29.35,Default,,0,0,0,,Қараңдар! Бізде әлемдегі ең жақсы балмұздақ бар!
Dialogue: 0,0:22:29.35,0:22:31.35,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:22:31.35,0:22:34.36,Default,,0,0,0,,Алдымен балмұздақты әсем жеп алайық →
Dialogue: 0,0:22:34.36,0:22:37.36,Default,,0,0,0,,Жүр тамақ ішейік! (Шу Май) Иә!
Dialogue: 0,0:22:37.36,0:22:41.36,Default,,0,0,0,,♪♪ «Балмұздақтан кейін не жеу керек?»
Dialogue: 0,0:22:41.36,0:22:43.36,Default,,0,0,0,,Әрине, бұл Монджаяки.
Dialogue: 0,0:22:43.36,0:22:46.37,Default,,0,0,0,,Жоғалып кетті…. Қызық, бұл не болды?
Dialogue: 0,0:22:46.37,0:22:48.37,Default,,0,0,0,,Менде жағымсыз сезім бар.
Dialogue: 0,0:22:48.37,0:22:51.37,Default,,0,0,0,,(Панның күлкісі)
Dialogue: 0,0:22:51.37,0:22:54.31,Default,,0,0,0,,Сорбет мырза. Әйтеуір Жердегі Сайяндарға →
Dialogue: 0,0:22:54.31,0:22:56.31,Default,,0,0,0,,Сіз табылмадыңыз.
Dialogue: 0,0:22:56.31,0:23:01.32,Default,,0,0,0,,Мен айттым ғой. Менің есептеуімде қате жоқ.
Dialogue: 0,0:23:01.32,0:23:04.32,Default,,0,0,0,,Дегенмен, мен әлі де аздап алаңдаймын. Бұл не?
Dialogue: 0,0:23:04.32,0:23:07.32,Default,,0,0,0,,Біздің армия үшін Фризаның қайта тірілуі → болып табылады
Dialogue: 0,0:23:07.32,0:23:09.32,Default,,0,0,0,,Бұл шынымен қажет пе?
Dialogue: 0,0:23:09.32,0:23:13.33,Default,,0,0,0,,Сіз әлі де айтасыз ба? Маған қазір керек! →
Dialogue: 0,0:23:13.33,0:23:16.33,Default,,0,0,0,,Фриеза-сама мен негізгі басшылар тамырынан айырылды→
Dialogue: 0,0:23:16.33,0:23:19.33,Default,,0,0,0,,Біз білген бойда әскерімізге сын айтыла бастады→
Dialogue: 0,0:23:19.33,0:23:23.34,Default,,0,0,0,,Бас көтерген бір-екі планета ғана болған жоқ.
Dialogue: 0,0:23:23.34,0:23:27.34,Default,,0,0,0,,Одан да сорақысы, іштегі адамдардың басшылығын да әбігерге салды.
Dialogue: 0,0:23:27.34,0:23:33.35,Default,,0,0,0,,Мен Фриэза-саманы баяғыда ғана көрдім.→
Dialogue: 0,0:23:33.35,0:23:37.35,Default,,0,0,0,,Мен оны соншалықты кішкентай және таңқаларлық деп күтпедім.
Dialogue: 0,0:23:37.35,0:23:40.35,Default,,0,0,0,,Хун. Біз анда-санда кездесетінбіз →
Dialogue: 0,0:23:40.35,0:23:43.36,Default,,0,0,0,,Мен оның сұмдығын сезіндім.
Dialogue: 0,0:23:43.36,0:23:46.36,Default,,0,0,0,,Солай ма? Егер ол сіздің күткеніңізге сәйкес келмесе →
Dialogue: 0,0:23:46.36,0:23:49.36,Default,,0,0,0,,Ол тек атымен ғана тітіркендіргіш диктатор.
Dialogue: 0,0:23:49.36,0:23:52.38,Default,,0,0,0,,Иә? ≪Қандай өкінішті!
Dialogue: 0,0:23:52.38,0:23:55.30,Default,,0,0,0,,Тагома! Осындай әлсіз оймен →
Dialogue: 0,0:23:55.30,0:23:58.31,Default,,0,0,0,,Фриеза-сама басшы болып қайта тіріле ме?
Dialogue: 0,0:23:58.31,0:24:00.31,Default,,0,0,0,,Шисами….
Dialogue: 0,0:24:00.31,0:24:04.31,Default,,0,0,0,,Фриеза-сама қайта тірілсе, балалар түсінесіңдер.
Dialogue: 0,0:24:04.31,0:24:09.32,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:24:09.32,0:24:14.32,Default,,0,0,0,,Өмірге қайта оралыңыз!
Dialogue: 0,0:24:29.34,0:24:32.34,Default,,0,0,0,,Уау! о….
Dialogue: 0,0:24:34.34,0:24:36.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:44.35,0:24:47.35,Default,,0,0,0,,Иә? (Вегета) Не болды? Какарот.
Dialogue: 0,0:24:47.35,0:24:52.33,Default,,0,0,0,,Жарайды, мен оның не екенін білмеймін, бірақ өзімді жаман сезінемін.
Dialogue: 0,0:24:52.33,0:24:54.19,Default,,0,0,0,,Жалқау болмаңыз. Хмм….
Dialogue: 0,0:24:54.19,0:24:58.19,Default,,0,0,0,,Мүмкін бұл менің қиялым шығар...
Dialogue: 0,0:25:04.20,0:25:07.21,Default,,0,0,0,,О...
Dialogue: 0,0:25:07.21,0:25:10.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:18.22,0:25:21.22,Default,,0,0,0,,Бұл біртүрлі сезім.
Dialogue: 0,0:25:21.22,0:25:28.23,Default,,0,0,0,,Қайта тірілемін деп ойламаппын.
Dialogue: 0,0:25:28.23,0:25:34.23,Default,,0,0,0,,<Зұлым император Фриеза күтпеген жерден оралды>
Dialogue: 0,0:25:34.23,0:25:39.24,Default,,0,0,0,,<Бір кездері қатты шайқасқан Гоку мен оның достарынан кек алу→
Dialogue: 0,0:25:39.24,0:25:44.24,Default,,0,0,0,,Бұл басталғалы жатыр>
Dialogue: 0,0:25:44.24,0:25:46.25,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:25:46.25,0:25:56.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:49.31,0:26:52.31,Default,,0,0,0,,Сәлеметсіз бе. Мен Готенмін. →
Dialogue: 0,0:26:52.31,0:26:55.35,Default,,0,0,0,,Біртүрлі ғарыш кемесі келеді де, оны бұрын көрмеген адам →
Dialogue: 0,0:26:55.35,0:26:57.35,Default,,0,0,0,,Бұлма-санды өзіңмен бірге ала кел. →
Dialogue: 0,0:26:57.35,0:26:59.35,Default,,0,0,0,,Бұл маска қызық екен. →
Dialogue: 0,0:26:59.35,0:27:02.36,Default,,0,0,0,,Сіз шынымен Бұлма-санның танысысыз ба? →
Dialogue: 0,0:27:02.36,0:27:04.36,Default,,0,0,0,,Ол неге екені белгісіз үрейленіп тұрған сияқты...
Dialogue: 0,0:27:04.36,0:27:07.36,Default,,0,0,0,,Келесі «Dragon Ball Super»
Dialogue: 0,0:27:11.37,0:27:13.37,Default,,0,0,0,,Міндетті түрде тексеріңіз.
Dialogue: 0,0:27:14.87,0:27:20.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory