Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:32.63,0:01:42.63,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:11.08,0:04:16.09,Default,,0,0,0,,<Тарихтағы ең күшті жау Маджин Буу пайда болуымен→
Dialogue: 0,0:04:16.09,0:04:21.09,Default,,0,0,0,,Жер өте қиын жағдайда болды>
Dialogue: 0,0:04:21.09,0:04:26.10,Default,,0,0,0,,<Гоку мен Вегета Маджин Бууға қарсы тұру>
Dialogue: 0,0:04:26.10,0:04:30.10,Default,,0,0,0,,<Шайтанның шақыруымен, жер бетіндегі барлық адамдармен→
Dialogue: 0,0:04:30.10,0:04:35.11,Default,,0,0,0,,Бүкіл ғаламның энергиясын жинайтын Super Genki шарымен →
Dialogue: 0,0:04:35.11,0:04:40.11,Default,,0,0,0,,Ақыры Гоку Маджин Бууды жеңді
Dialogue: 0,0:04:43.12,0:04:45.12,Default,,0,0,0,,<Алты айдан кейін>
Dialogue: 0,0:04:45.12,0:04:51.12,Default,,0,0,0,,<Айдаһар шарларының күші адамдардың Буу туралы естеліктерін өшіреді→
Dialogue: 0,0:04:51.12,0:04:54.12,Default,,0,0,0,,Біраз уақыт өтті＞
Dialogue: 0,0:05:14.08,0:05:22.09,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:22.09,0:05:24.09,Default,,0,0,0,,Не? Ах.
Dialogue: 0,0:05:29.10,0:05:31.10,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:05:34.10,0:05:39.11,Default,,0,0,0,,О. Сен қыңыр жігітсің, Вегетаға қарашы.
Dialogue: 0,0:05:39.11,0:05:42.11,Default,,0,0,0,,Хе. Жақсы.
Dialogue: 0,0:05:44.11,0:05:47.11,Default,,0,0,0,,≪(Готен) Әкесі. Иә?
Dialogue: 0,0:05:47.11,0:05:49.12,Default,,0,0,0,,Бұл түскі ас қорабы.
Dialogue: 0,0:05:49.12,0:05:53.12,Default,,0,0,0,,О, Готен. Не, мектеп бітті ме?
Dialogue: 0,0:05:53.12,0:05:55.12,Default,,0,0,0,,Бүгін жексенбі.
Dialogue: 0,0:05:55.12,0:05:59.13,Default,,0,0,0,,Бұл демалыс күні ме? Ах. Хи хи хи.
Dialogue: 0,0:05:59.13,0:06:01.13,Default,,0,0,0,,Олай болса, оның орнына мына жігітті айдаңызшы.
Dialogue: 0,0:06:01.13,0:06:03.13,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:06.15,0:06:08.07,Default,,0,0,0,,О! Түскі ас қорабы Түскі ас қорабы.
Dialogue: 0,0:06:08.07,0:06:10.07,Default,,0,0,0,,О!
Dialogue: 0,0:06:10.07,0:06:12.07,Default,,0,0,0,,Itadadakimasu.
Dialogue: 0,0:06:23.08,0:06:25.08,Default,,0,0,0,,Жоқ, мен жедім!
Dialogue: 0,0:06:25.08,0:06:27.09,Default,,0,0,0,,Ас үшін рахмет.
Dialogue: 0,0:06:27.09,0:06:29.09,Default,,0,0,0,,Жарайды. Ха!
Dialogue: 0,0:06:31.09,0:06:33.09,Default,,0,0,0,,Тея! (Готен) Иә?
Dialogue: 0,0:06:33.09,0:06:38.10,Default,,0,0,0,,Дұрыс! Ха! Татататата!
Dialogue: 0,0:06:38.10,0:06:41.10,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:06:41.10,0:06:43.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:43.10,0:06:45.10,Default,,0,0,0,,Тория!
Dialogue: 0,0:06:45.10,0:06:47.10,Default,,0,0,0,,Уау! Хаха.
Dialogue: 0,0:06:49.11,0:06:51.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:51.11,0:06:53.11,Default,,0,0,0,,Уф! Апыр-ай!
Dialogue: 0,0:06:53.11,0:06:55.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:57.12,0:06:59.12,Default,,0,0,0,,О?
Dialogue: 0,0:07:02.12,0:07:08.06,Default,,0,0,0,,Готен Егер сіз мұны дұрыс орындамасаңыз, сіз жаттығуларыңызға назар аудара алмайсыз.
Dialogue: 0,0:07:08.06,0:07:10.06,Default,,0,0,0,,Әкең жаттықты ма?
Dialogue: 0,0:07:10.06,0:07:14.07,Default,,0,0,0,,Ах. Маджин Буу шынымен күшті болды.
Dialogue: 0,0:07:14.07,0:07:17.07,Default,,0,0,0,,Мен жалғыз Оламен жеңе алмадым.
Dialogue: 0,0:07:17.07,0:07:20.07,Default,,0,0,0,,Мұндай жағдайдың қайталанбайтынына кепілдік жоқ.
Dialogue: 0,0:07:20.07,0:07:22.07,Default,,0,0,0,,Мен сол уақытқа дайындалуым керек.
Dialogue: 0,0:07:22.07,0:07:25.08,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:25.08,0:07:27.08,Default,,0,0,0,,Шынымды айтсам →
Dialogue: 0,0:07:27.08,0:07:31.08,Default,,0,0,0,,Мен Кай патшаның үйіне барып жаттығу жасадым, бірақ Чичи...
Dialogue: 0,0:07:31.08,0:07:37.09,Default,,0,0,0,,《Гоку-сан, бұл уәде. Еңбек етіп, ақша табыңыз! 》
Dialogue: 0,0:07:37.09,0:07:41.09,Default,,0,0,0,,Сіздің анаңыз әлемдегі ең күшті адам болуы мүмкін.
Dialogue: 0,0:07:41.09,0:07:43.10,Default,,0,0,0,,Ушимаудың атасы Чимо→
Dialogue: 0,0:07:43.10,0:07:47.10,Default,,0,0,0,,Қазына өртеніп кетті, сондықтан оларда көп ақша жоқ сияқты.
Dialogue: 0,0:07:49.10,0:07:51.10,Default,,0,0,0,,Бірақ менің анам →
Dialogue: 0,0:07:51.10,0:07:54.11,Default,,0,0,0,,Егер сіз әке болсаңыз, сізде табысы жоғары жұмыс болар еді →
Dialogue: 0,0:07:54.11,0:07:57.11,Default,,0,0,0,,Мен осылай дедім. Шайтан мырза сияқты.
Dialogue: 0,0:07:57.11,0:08:01.11,Default,,0,0,0,,Менің ойымша, Ола осылай босаңсыған кезде жаттығуды ұнатады.
Dialogue: 0,0:08:04.12,0:08:07.05,Default,,0,0,0,,Әке Хата Бұл бейберекет.
Dialogue: 0,0:08:07.05,0:08:11.05,Default,,0,0,0,,Хи хи хи хи ахахха.
Dialogue: 0,0:08:14.06,0:08:17.06,Default,,0,0,0,,Сіз не істеп жатырсыз? Мен оны сізге жақында әкелемін.
Dialogue: 0,0:08:17.06,0:08:20.06,Default,,0,0,0,,Уф… аа….
Dialogue: 0,0:08:26.07,0:08:30.08,Default,,0,0,0,,Беерус-сама, асыңыз дәмді болсын. →
Dialogue: 0,0:08:30.08,0:08:34.08,Default,,0,0,0,,Біздің барлық тағамдарды біздің жоғары санатты аспаздар бар шеберлігімен дайындайды →
Dialogue: 0,0:08:34.08,0:08:38.08,Default,,0,0,0,,Тревиан өнімдерінің бірінде табылған.
Dialogue: 0,0:08:38.08,0:08:41.09,Default,,0,0,0,,Иә? Хмм. →
Dialogue: 0,0:08:41.09,0:08:43.09,Default,,0,0,0,,Міне.
Dialogue: 0,0:08:46.09,0:08:48.09,Default,,0,0,0,,Хмм. (Патша) Эй!
Dialogue: 0,0:08:48.09,0:08:51.10,Default,,0,0,0,,Иә? Кун-кун Кун-кун-кун.
Dialogue: 0,0:08:51.10,0:08:54.10,Default,,0,0,0,,Ұят болды, Беерус-сама.
Dialogue: 0,0:08:54.10,0:08:56.10,Default,,0,0,0,,Бұл не? (Патша) Ух...
Dialogue: 0,0:08:58.10,0:09:01.11,Default,,0,0,0,,Какакака… Толығымен органикалық егіншілік, табиғи микробсыз сиырлар →
Dialogue: 0,0:09:01.11,0:09:03.11,Default,,0,0,0,,Біз A la Planetese-деміз!
Dialogue: 0,0:09:03.11,0:09:06.13,Default,,0,0,0,,A la pla pla pla? →
Dialogue: 0,0:09:06.13,0:09:10.13,Default,,0,0,0,,Бұл өте қиын атау. Уф….
Dialogue: 0,0:09:21.06,0:09:27.07,Default,,0,0,0,,Бұл дәмді емес пе? Тұздың мөлшері өте жақсы, дәл маған ұнайтындай.
Dialogue: 0,0:09:27.07,0:09:30.07,Default,,0,0,0,,Ах! Сонда бұл жұлдыз ше?
Dialogue: 0,0:09:30.07,0:09:33.07,Default,,0,0,0,,Бірақ сәлем. (Патша) Уф!
Dialogue: 0,0:09:33.07,0:09:35.07,Default,,0,0,0,,Майы аздап көп, солай емес пе?
Dialogue: 0,0:09:35.07,0:09:37.08,Default,,0,0,0,,Уф….
Dialogue: 0,0:09:37.08,0:09:40.08,Default,,0,0,0,,Бұл жолы мен оны жартыға қалдырамын.
Dialogue: 0,0:09:40.08,0:09:42.08,Default,,0,0,0,,Тек жартысы?
Dialogue: 0,0:09:52.09,0:09:55.09,Default,,0,0,0,,Бұл дәмді емес пе? Берус мырза.
Dialogue: 0,0:09:55.09,0:09:59.10,Default,,0,0,0,,Майды көп жеу денеге пайдалы емес.
Dialogue: 0,0:09:59.10,0:10:02.10,Default,,0,0,0,,Майды көп жеуге болмайды.
Dialogue: 0,0:10:04.10,0:10:07.04,Default,,0,0,0,,Шайтан мырза, бірдеңе айтыңызшы.
Dialogue: 0,0:10:07.04,0:10:10.04,Default,,0,0,0,,Дүниежүзілік Бейбітшілік сыйлығының лауреаты болу туралы не айтасыз?
Dialogue: 0,0:10:10.04,0:10:13.05,Default,,0,0,0,,Кейбіреулер марапат тым кеш келді дейді.
Dialogue: 0,0:10:13.05,0:10:15.05,Default,,0,0,0,,Шайтан мырза. →
Dialogue: 0,0:10:15.05,0:10:17.05,Default,,0,0,0,,О.
Dialogue: 0,0:10:17.05,0:10:20.05,Default,,0,0,0,,Осымен мәлімдеймін.
Dialogue: 0,0:10:20.05,0:10:24.06,Default,,0,0,0,,Жерде мәңгілік тыныштық орнады.
Dialogue: 0,0:10:24.06,0:10:29.06,Default,,0,0,0,,Содан бері жер бетінде басқыншылар пайда болған жоқ.
Dialogue: 0,0:10:29.06,0:10:33.07,Default,,0,0,0,,Себебі менің атақ-даңғым бүкіл әлемге жетті. →
Dialogue: 0,0:10:33.07,0:10:35.07,Default,,0,0,0,,Мен оны көріп тұрмын.
Dialogue: 0,0:10:35.07,0:10:37.07,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:10:37.07,0:10:39.07,Default,,0,0,0,,Осы шайтанның күшінен дірілдеу→
Dialogue: 0,0:10:39.07,0:10:44.08,Default,,0,0,0,,Ғаламдағы жаман адамдардың қорқынышты көрінісі.
Dialogue: 0,0:10:44.08,0:10:47.08,Default,,0,0,0,,Сәлем! Таа!
Dialogue: 0,0:10:47.08,0:10:50.08,Default,,0,0,0,,шықты! Шайтанның жұдырығы дәл осы. →
Dialogue: 0,0:10:50.08,0:10:52.08,Default,,0,0,0,,Жерді қорғайтын жұдырық!
Dialogue: 0,0:10:52.08,0:10:55.09,Default,,0,0,0,,Гах ха ха ха.
Dialogue: 0,0:10:55.09,0:10:57.09,Default,,0,0,0,,Шайтан аш.
Dialogue: 0,0:10:57.09,0:10:59.09,Default,,0,0,0,,Аа….
Dialogue: 0,0:10:59.09,0:11:01.09,Default,,0,0,0,,А? Гагагага….
Dialogue: 0,0:11:03.10,0:11:06.12,Default,,0,0,0,,Буу. (асқазанның айқайлауы)
Dialogue: 0,0:11:06.12,0:11:08.03,Default,,0,0,0,,Біртүрлі нәрсе пайда болды.
Dialogue: 0,0:11:08.03,0:11:11.04,Default,,0,0,0,,Шайтан аш!
Dialogue: 0,0:11:11.04,0:11:13.04,Default,,0,0,0,,Буу-сан, мен қазір біраз асығып тұрмын.
Dialogue: 0,0:11:13.04,0:11:15.04,Default,,0,0,0,,Менің қарным ашты! Ах!
Dialogue: 0,0:11:15.04,0:11:19.04,Default,,0,0,0,,Не? Сол жігіт. Ол әлемді құтқарған батырды мақтан тұтатын сияқты.
Dialogue: 0,0:11:19.04,0:11:22.05,Default,,0,0,0,,Шайтаннан күштірек шығар?
Dialogue: 0,0:11:22.05,0:11:24.05,Default,,0,0,0,,Ой... (Тілшілер) О!
Dialogue: 0,0:11:24.05,0:11:26.05,Default,,0,0,0,,Уф….
Dialogue: 0,0:11:26.05,0:11:28.05,Default,,0,0,0,,Барлығыңыз тынышталыңыздар.
Dialogue: 0,0:11:28.05,0:11:30.06,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:11:30.06,0:11:32.06,Default,,0,0,0,,Бұл адамнан не жасырайын→
Dialogue: 0,0:11:32.06,0:11:36.06,Default,,0,0,0,,Менен ілім сұрау үшін ғаламның шетінен келдің→
Dialogue: 0,0:11:36.06,0:11:38.06,Default,,0,0,0,,Ол ғарыш жауынгері.
Dialogue: 0,0:11:38.06,0:11:41.07,Default,,0,0,0,,Менің нөмірі бірінші шәкіртім, былайша айтқанда.
Dialogue: 0,0:11:41.07,0:11:44.07,Default,,0,0,0,,Солай болды ма? Шайтан күткендей.
Dialogue: 0,0:11:44.07,0:11:46.07,Default,,0,0,0,,Тіпті ғаламның өзі маған сабақ беру үшін келетініне сене алар емеспін.
Dialogue: 0,0:11:46.07,0:11:48.07,Default,,0,0,0,,Уф….
Dialogue: 0,0:11:48.07,0:11:51.08,Default,,0,0,0,,Енді артқы жағына барайық.
Dialogue: 0,0:11:51.08,0:11:53.08,Default,,0,0,0,,Мен сізге кейінірек маңызды жаттығулар беремін.
Dialogue: 0,0:11:53.08,0:11:55.08,Default,,0,0,0,,Менің қарным ашты!
Dialogue: 0,0:11:55.08,0:11:58.08,Default,,0,0,0,,Менің артта күтуім керек екенін түсінбейсің бе?
Dialogue: 0,0:11:58.08,0:12:00.09,Default,,0,0,0,,Боу!
Dialogue: 0,0:12:00.09,0:12:02.09,Default,,0,0,0,,Арх!
Dialogue: 0,0:12:04.09,0:12:06.09,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:09.03,0:12:13.03,Default,,0,0,0,,Мм.
Dialogue: 0,0:12:13.03,0:12:19.04,Default,,0,0,0,,Бұл таңқаларлық. Өйткені, Шайтан – дүниенің, жоқ, ғаламның батыры!
Dialogue: 0,0:12:19.04,0:12:25.04,Default,,0,0,0,,Хахахаха. Эй... Бір сәт кешіріңіз. дәретхана. →
Dialogue: 0,0:12:25.04,0:12:27.05,Default,,0,0,0,,Сонымен →
Dialogue: 0,0:12:27.05,0:12:30.05,Default,,0,0,0,,Буу мырза, бұлай ашуланбаңызшы.
Dialogue: 0,0:12:30.05,0:12:34.05,Default,,0,0,0,,Мен саған кейін дәмді ас дайындаймын.
Dialogue: 0,0:12:34.05,0:12:36.06,Default,,0,0,0,,Менің қарным ашты!
Dialogue: 0,0:12:36.06,0:12:41.06,Default,,0,0,0,,Иә! Мен мұнда шоколад бар екеніне сенімдімін... →
Dialogue: 0,0:12:41.06,0:12:44.06,Default,,0,0,0,,Не? Гайя! →
Dialogue: 0,0:12:44.06,0:12:48.07,Default,,0,0,0,,Сәлем Видель! Шоколад қайда? →
Dialogue: 0,0:12:48.07,0:12:52.07,Default,,0,0,0,,Видель!
Dialogue: 0,0:12:52.07,0:12:54.07,Default,,0,0,0,,Сізге жақсы, Гохан.
Dialogue: 0,0:12:54.07,0:12:57.08,Default,,0,0,0,,Сіз бұл кітапты біраз уақыттан бері алғыңыз келді, солай емес пе?
Dialogue: 0,0:12:57.08,0:13:00.08,Default,,0,0,0,,...
Dialogue: 0,0:13:00.08,0:13:03.08,Default,,0,0,0,,Әдеттегідей рахмет, Видель-сан.
Dialogue: 0,0:13:03.08,0:13:07.02,Default,,0,0,0,,...
Dialogue: 0,0:13:07.02,0:13:11.02,Default,,0,0,0,,Өйткені Видель-сан маған үнемі заттар сатып алады →
Dialogue: 0,0:13:11.02,0:13:14.03,Default,,0,0,0,,Өйткені мен саған ештеңе сатып ала алмаймын.
Dialogue: 0,0:13:14.03,0:13:16.03,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:13:16.03,0:13:18.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:18.03,0:13:21.03,Default,,0,0,0,,Одан да, Гохан, жақсы оқы→
Dialogue: 0,0:13:21.03,0:13:23.03,Default,,0,0,0,,Сіз керемет ғалым боласыз!
Dialogue: 0,0:13:27.04,0:13:30.04,Default,,0,0,0,,Иә! Уууу. →
Dialogue: 0,0:13:30.04,0:13:34.04,Default,,0,0,0,,Иә! Сол жақтағы наубайханаға тоқталайық.
Dialogue: 0,0:13:37.05,0:13:39.05,Default,,0,0,0,,Хун.
Dialogue: 0,0:13:39.05,0:13:41.05,Default,,0,0,0,,Сыйлық па?
Dialogue: 0,0:13:41.05,0:13:46.06,Default,,0,0,0,,Иә. Гохан-ни-чан, сен Видель-санға үйлендің, солай ма? →
Dialogue: 0,0:13:46.06,0:13:48.06,Default,,0,0,0,,Мен Видель-санға бірдеңе бергім келеді.
Dialogue: 0,0:13:48.06,0:13:52.06,Default,,0,0,0,,Мм, сыйлық?
Dialogue: 0,0:13:52.06,0:13:54.07,Default,,0,0,0,,...
Dialogue: 0,0:13:54.07,0:13:56.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:56.07,0:13:58.07,Default,,0,0,0,,...
Dialogue: 0,0:13:58.07,0:14:03.08,Default,,0,0,0,,...
Dialogue: 0,0:14:03.08,0:14:05.08,Default,,0,0,0,,Жарайды Жарайды. →
Dialogue: 0,0:14:05.08,0:14:09.08,Default,,0,0,0,,Маған оны да көрсете аласыз ба? (Сатушы) Бұл ма?
Dialogue: 0,0:14:09.08,0:14:12.08,Default,,0,0,0,,Уау. (Әйел) Уау!
Dialogue: 0,0:14:12.08,0:14:14.09,Default,,0,0,0,,...
Dialogue: 0,0:14:14.09,0:14:16.09,Default,,0,0,0,,（）…
Dialogue: 0,0:14:16.09,0:14:19.09,Default,,0,0,0,,Саған осындай бірдеңе берсем де, бақытты болмаймын. →
Dialogue: 0,0:14:19.09,0:14:22.09,Default,,0,0,0,,Саған берейін десем, мен саған одан да үлкен нәрсе беруім керек.
Dialogue: 0,0:14:22.09,0:14:26.10,Default,,0,0,0,,Иә. (Сатушы) Ой... Кешіріңіз.
Dialogue: 0,0:14:26.10,0:14:28.10,Default,,0,0,0,,（）
Dialogue: 0,0:14:28.10,0:14:30.10,Default,,0,0,0,,Мына жерде? (Готен) Иә.
Dialogue: 0,0:14:30.10,0:14:32.10,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:32.10,0:14:35.11,Default,,0,0,0,,...
Dialogue: 0,0:14:35.11,0:14:37.11,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:39.11,0:14:42.11,Default,,0,0,0,,（）
Dialogue: 0,0:14:42.11,0:14:44.11,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:27.09,0:16:30.09,Default,,0,0,0,,О. Сіздің теріңіз шынымен толық.
Dialogue: 0,0:16:30.09,0:16:32.09,Default,,0,0,0,,Сізге не ұнайды?
Dialogue: 0,0:16:32.09,0:16:36.09,Default,,0,0,0,,Мм, егер зергерлік бұйымдар жақсы болмаса→
Dialogue: 0,0:16:36.09,0:16:38.10,Default,,0,0,0,,Бұл Кешосуи.
Dialogue: 0,0:16:38.10,0:16:40.10,Default,,0,0,0,,...
Dialogue: 0,0:16:40.10,0:16:43.10,Default,,0,0,0,,Әйелдер жатар алдында бетіне жағатын нәрсе.
Dialogue: 0,0:16:43.10,0:16:45.10,Default,,0,0,0,,Маған анам осылай деді.
Dialogue: 0,0:16:45.10,0:16:47.11,Default,,0,0,0,,《 》
Dialogue: 0,0:16:47.11,0:16:49.11,Default,,0,0,0,,《Мен оны Видельге беруім керек пе?》
Dialogue: 0,0:16:49.11,0:16:51.11,Default,,0,0,0,,《Мен де сол балаға жақсы қарауым керек→
Dialogue: 0,0:16:51.11,0:16:55.11,Default,,0,0,0,,Маған қарағанда тез әжім түсетін сияқты.
Dialogue: 0,0:16:55.11,0:16:58.12,Default,,0,0,0,,Ондай жағдайда Видель-сан бақытты болады.
Dialogue: 0,0:16:58.12,0:17:01.12,Default,,0,0,0,,Иә. Бірден барайық. (Готен) Иә.
Dialogue: 0,0:17:04.12,0:17:07.13,Default,,0,0,0,,Мен оны қалтамдағы ақшаға сатып алмаймын.
Dialogue: 0,0:17:07.13,0:17:09.13,Default,,0,0,0,,(Хироко) Дегенмен, мен өзімді сәл жалғыз сезінемін.
Dialogue: 0,0:17:09.13,0:17:11.13,Default,,0,0,0,,6000 Зени!? (Готен/Транкс) Иә?
Dialogue: 0,0:17:11.13,0:17:14.13,Default,,0,0,0,,Неліктен мұндай нәрсе 6000 ценни тұрады?
Dialogue: 0,0:17:14.13,0:17:16.13,Default,,0,0,0,,Демек, бұл өнімде→ бар
Dialogue: 0,0:17:16.13,0:17:19.14,Default,,0,0,0,,Құрамында теріге жұмсақ әсер ететін ингредиенттер→
Dialogue: 0,0:17:19.14,0:17:22.07,Default,,0,0,0,,Тамаша ағарту әсері. Ағарту дегеніміз не?
Dialogue: 0,0:17:22.07,0:17:27.08,Default,,0,0,0,,Бұл менің ауылымдағы ыстық бұлақтардан әлдеқайда жақсы. →
Dialogue: 0,0:17:27.08,0:17:29.08,Default,,0,0,0,,Оны 3 күн бойы, тіпті кемпіріңіздің терісін де жібітіп көріңіз →
Dialogue: 0,0:17:29.08,0:17:32.08,Default,,0,0,0,,Ол тайғақ. (Готен/Транкс) Иә?
Dialogue: 0,0:17:32.08,0:17:36.09,Default,,0,0,0,,Ей, ақсақал, анау қайнаған бұлақ?
Dialogue: 0,0:17:36.09,0:17:38.09,Default,,0,0,0,,Ыстық бұлақ? Сонымен →
Dialogue: 0,0:17:38.09,0:17:42.09,Default,,0,0,0,,Кемпірлерді тегіс сезінетін ыстық бұлақ.
Dialogue: 0,0:17:42.09,0:17:46.10,Default,,0,0,0,,Бұл менің ауылым ба? Осы жерден →
Dialogue: 0,0:17:46.10,0:17:48.10,Default,,0,0,0,,Қатты алға → бұрылыңыз
Dialogue: 0,0:17:48.10,0:17:51.10,Default,,0,0,0,,Тауға дейін бардым.
Dialogue: 0,0:17:51.10,0:17:54.10,Default,,0,0,0,,А... рахмет!
Dialogue: 0,0:17:57.11,0:18:01.11,Default,,0,0,0,,Осы жерге дейін барыңыз. (Готен) Ол қатты иіледі.
Dialogue: 0,0:18:03.12,0:18:05.12,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:18:05.12,0:18:07.12,Default,,0,0,0,,Әй, ана жақта емес пе?
Dialogue: 0,0:18:10.12,0:18:14.13,Default,,0,0,0,,Ха ха ха…. Hacksion!
Dialogue: 0,0:18:14.13,0:18:16.13,Default,,0,0,0,,Ақ және лас нәрсе.
Dialogue: 0,0:18:16.13,0:18:21.13,Default,,0,0,0,,Адамдарға толы. Жоғарыға барайық.
Dialogue: 0,0:18:23.07,0:18:26.07,Default,,0,0,0,,Менің ойымша, бұл жерде емес.
Dialogue: 0,0:18:26.07,0:18:28.07,Default,,0,0,0,,Уа. Эй, ана жаққа қара.
Dialogue: 0,0:18:28.07,0:18:30.08,Default,,0,0,0,,Уау, бұл әдемі.
Dialogue: 0,0:18:30.08,0:18:35.08,Default,,0,0,0,,Бұл оны тегіс етеді. О, мүлде.
Dialogue: 0,0:18:39.08,0:18:41.09,Default,,0,0,0,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:18:41.09,0:18:44.09,Default,,0,0,0,,Толығырақ.
Dialogue: 0,0:18:44.09,0:18:46.09,Default,,0,0,0,,Эй, абай бол. (Готен) Иә.
Dialogue: 0,0:18:50.10,0:18:53.10,Default,,0,0,0,,Жарайды, кеттік. (Готен) Иә.
Dialogue: 0,0:18:53.10,0:18:55.10,Default,,0,0,0,,Шах! (Готен) Иә?
Dialogue: 0,0:18:55.10,0:18:57.10,Default,,0,0,0,,Уау! (Готен) Уау!
Dialogue: 0,0:18:57.10,0:18:59.10,Default,,0,0,0,,Маған қалдырыңыз! →
Dialogue: 0,0:18:59.10,0:19:04.11,Default,,0,0,0,,Йо. (Үлкен жылан) Гаа!
Dialogue: 0,0:19:04.11,0:19:06.11,Default,,0,0,0,,Гаа!
Dialogue: 0,0:19:06.11,0:19:10.12,Default,,0,0,0,,Бұл қауіпті! Бұл Видель-санға сыйлық.
Dialogue: 0,0:19:10.12,0:19:12.12,Default,,0,0,0,,Гаа! (Сандықтар/Готен) Уау.
Dialogue: 0,0:19:12.12,0:19:14.12,Default,,0,0,0,,Гаа! →
Dialogue: 0,0:19:14.12,0:19:16.12,Default,,0,0,0,,Гаа! Апыр-ай!
Dialogue: 0,0:19:16.12,0:19:18.12,Default,,0,0,0,,Гаа! Готен!
Dialogue: 0,0:19:18.12,0:19:23.06,Default,,0,0,0,,Жарайды, жарайды. Апыр-ай. Апыр-ай. →
Dialogue: 0,0:19:23.06,0:19:25.06,Default,,0,0,0,,Уау! →
Dialogue: 0,0:19:25.06,0:19:27.07,Default,,0,0,0,,Мистер Транкс.
Dialogue: 0,0:19:27.07,0:19:30.07,Default,,0,0,0,,Йо. О? →
Dialogue: 0,0:19:30.07,0:19:33.07,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:19:33.07,0:19:35.07,Default,,0,0,0,,Таа!
Dialogue: 0,0:19:35.07,0:19:38.07,Default,,0,0,0,,Гаа! Ол табанды жігіт.
Dialogue: 0,0:19:42.08,0:19:44.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:44.08,0:19:46.08,Default,,0,0,0,,Тоқта, Готен! →
Dialogue: 0,0:19:46.08,0:19:50.09,Default,,0,0,0,,Солай етсең, бүкіл ыстық бұлақ ұшып кетеді!
Dialogue: 0,0:19:50.09,0:19:54.09,Default,,0,0,0,,Уф. (Үлкен жылан) Шах!
Dialogue: 0,0:19:54.09,0:19:56.09,Default,,0,0,0,,Уа. Алыңыз!
Dialogue: 0,0:19:56.09,0:19:58.10,Default,,0,0,0,,Ах. Қарғыс атсын. →
Dialogue: 0,0:19:58.10,0:20:01.10,Default,,0,0,0,,Ха! →
Dialogue: 0,0:20:01.10,0:20:06.10,Default,,0,0,0,,Да-да-да-да...! →
Dialogue: 0,0:20:06.10,0:20:08.10,Default,,0,0,0,,О! (Үлкен жылан) Ух!
Dialogue: 0,0:20:18.12,0:20:20.12,Default,,0,0,0,,Кешо Суи ше?
Dialogue: 0,0:20:22.05,0:20:25.05,Default,,0,0,0,,Хехе. Хехе.
Dialogue: 0,0:20:28.06,0:20:32.06,Default,,0,0,0,,<<Видель-сан. (Видель) Иә?
Dialogue: 0,0:20:32.06,0:20:35.07,Default,,0,0,0,,Хэхехе. (Готен) Хахаха.
Dialogue: 0,0:20:35.07,0:20:38.07,Default,,0,0,0,,Иә. Бұл үйлену тойы.
Dialogue: 0,0:20:38.07,0:20:42.07,Default,,0,0,0,,Ал, мереке? Готен-кун? рақмет сізге.
Dialogue: 0,0:20:42.07,0:20:45.08,Default,,0,0,0,,О, Готен сандықтары.
Dialogue: 0,0:20:45.08,0:20:48.08,Default,,0,0,0,,Әй, аға.
Dialogue: 0,0:20:48.08,0:20:50.08,Default,,0,0,0,,Тағы кім болуы мүмкін?
Dialogue: 0,0:20:50.08,0:20:53.08,Default,,0,0,0,,Готеннің үйлену тойына сыйлық.
Dialogue: 0,0:20:53.08,0:20:56.09,Default,,0,0,0,,Бұл Кешосуи. Кешусуи?
Dialogue: 0,0:20:56.09,0:20:58.09,Default,,0,0,0,,Мен Транкспен балық аулауға бардым.
Dialogue: 0,0:20:58.09,0:21:00.09,Default,,0,0,0,,Хехе.
Dialogue: 0,0:21:00.09,0:21:05.10,Default,,0,0,0,,Ах…. Бұл дұрыс. Мен үшін жолыңнан кет.
Dialogue: 0,0:21:05.10,0:21:08.10,Default,,0,0,0,,Оны қосып көріңіз. (Видель) Иә.
Dialogue: 0,0:21:15.11,0:21:17.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:17.11,0:21:19.11,Default,,0,0,0,,《Тек су ма? 》
Dialogue: 0,0:21:19.11,0:21:22.05,Default,,0,0,0,,Хехе. Хехехехехе.
Dialogue: 0,0:21:22.05,0:21:25.05,Default,,0,0,0,,Ах... →
Dialogue: 0,0:21:25.05,0:21:27.05,Default,,0,0,0,,Хехе.
Dialogue: 0,0:21:32.06,0:21:34.06,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:34.06,0:21:37.06,Default,,0,0,0,,Өте жақсы. Ол теріңізге сіңіп кеткендей болады.
Dialogue: 0,0:21:37.06,0:21:40.07,Default,,0,0,0,,Рахмет, Готен-кун мен Транкс-кун.
Dialogue: 0,0:21:40.07,0:21:43.07,Default,,0,0,0,,Ах…. Хехе.
Dialogue: 0,0:21:43.07,0:21:46.07,Default,,0,0,0,,Оның кеткенін маған хабарлаңыз. Мен оны қайтадан аламын.
Dialogue: 0,0:21:46.07,0:21:48.07,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:50.08,0:21:55.08,Default,,0,0,0,,көремін. Видель бұған қуанады. Сіз жақсы іс жасадыңыз.
Dialogue: 0,0:21:55.08,0:21:58.08,Default,,0,0,0,,Иә. ...Ал ол қандай үй болды?
Dialogue: 0,0:21:58.08,0:22:00.09,Default,,0,0,0,,Бұл үлкен болды.
Dialogue: 0,0:22:00.09,0:22:04.09,Default,,0,0,0,,Мынау шайтанның маған салған үйі. Рақмет сізге.
Dialogue: 0,0:22:04.09,0:22:08.09,Default,,0,0,0,,Енді Гохан қалағанынша оқи алады.
Dialogue: 0,0:22:08.09,0:22:11.09,Default,,0,0,0,,≪(Автокөлік сигналы) (Готен/Гоку) Иә?
Dialogue: 0,0:22:13.10,0:22:17.10,Default,,0,0,0,,Сәлем, Гоку-сан. Мен Чичи-саннан сұрағанымда →
Dialogue: 0,0:22:17.10,0:22:20.12,Default,,0,0,0,,Мен бұл жерде деп естідім. О, Шайтан мырза.
Dialogue: 0,0:22:20.12,0:22:23.04,Default,,0,0,0,,Мен жай ғана сен туралы айтып едім.
Dialogue: 0,0:22:23.04,0:22:27.05,Default,,0,0,0,,Кешіріңіз. Гоханға үлкен үй салып бер.
Dialogue: 0,0:22:27.05,0:22:32.05,Default,,0,0,0,,Бұл жақсы. Видель де менің қызым.
Dialogue: 0,0:22:32.05,0:22:37.06,Default,,0,0,0,,Одан жақсырақ. Түстен кейінгі жаңалықтарды көрдіңіз бе?
Dialogue: 0,0:22:37.06,0:22:39.06,Default,,0,0,0,,Жоқ, білмеймін.
Dialogue: 0,0:22:39.06,0:22:42.06,Default,,0,0,0,,О, солай ма? Іс жүзінде →
Dialogue: 0,0:22:42.06,0:22:45.06,Default,,0,0,0,,Бұл жолы мен Дүниежүзілік Бейбітшілік сыйлығын аламын →
Dialogue: 0,0:22:45.06,0:22:49.07,Default,,0,0,0,,Рахмет. дүние?
Dialogue: 0,0:22:49.07,0:22:53.07,Default,,0,0,0,,Қарашы, мен әлемді құтқардым деп айта бердім, солай ма? →
Dialogue: 0,0:22:53.07,0:22:56.07,Default,,0,0,0,,Сондықтан мен арнайы ақшалай сыйлық алдым. →
Dialogue: 0,0:22:56.07,0:22:58.08,Default,,0,0,0,,100 миллион Зени.
Dialogue: 0,0:22:58.08,0:23:01.08,Default,,0,0,0,,100 миллион Зени!? Тынш.
Dialogue: 0,0:23:03.08,0:23:05.08,Default,,0,0,0,,Аа... Бірақ бұл жүлде ақшасы
Dialogue: 0,0:23:05.08,0:23:08.09,Default,,0,0,0,,Шындығында, сіз оны алуыңыз керек.
Dialogue: 0,0:23:08.09,0:23:11.09,Default,,0,0,0,,Ендеше жеткізіп берейік. Маған онша көп ақша керек емес.
Dialogue: 0,0:23:11.09,0:23:13.09,Default,,0,0,0,,Ал... жарайды, олай айтпа.
Dialogue: 0,0:23:13.09,0:23:16.09,Default,,0,0,0,,Мен жалғыз соғысқан сияқты емеспін.
Dialogue: 0,0:23:16.09,0:23:20.07,Default,,0,0,0,,Сіз де жақсы күрестіңіз, солай емес пе?
Dialogue: 0,0:23:20.07,0:23:21.93,Default,,0,0,0,,Мен қазірдің өзінде өте баймын.
Dialogue: 0,0:23:21.93,0:23:23.94,Default,,0,0,0,,Вегета-сан да бас тартты.
Dialogue: 0,0:23:23.94,0:23:27.94,Default,,0,0,0,,Ал, ол адам дүниедегі ең бай адам.
Dialogue: 0,0:23:27.94,0:23:32.94,Default,,0,0,0,,Эй, 100 миллион Зениде қанша 100 000 Зени бар?
Dialogue: 0,0:23:32.94,0:23:34.95,Default,,0,0,0,,Не? 100 000 Зени ше?
Dialogue: 0,0:23:34.95,0:23:37.95,Default,,0,0,0,,Ал, бұл 1000.
Dialogue: 0,0:23:37.95,0:23:41.95,Default,,0,0,0,,1000!? 100 000 Зени 1 000 ма?
Dialogue: 0,0:23:41.95,0:23:44.96,Default,,0,0,0,,Жарайды... Маған керегі жоқ. Мұндай қорқынышты ақша сомасы.
Dialogue: 0,0:23:44.96,0:23:46.96,Default,,0,0,0,,Оны алуым керек пе?
Dialogue: 0,0:23:46.96,0:23:48.96,Default,,0,0,0,,Не? Анам да →
Dialogue: 0,0:23:48.96,0:23:51.96,Default,,0,0,0,,Кай патшада әке тәрбиесі→
Dialogue: 0,0:23:51.96,0:23:54.97,Default,,0,0,0,,Сіз мені кешіретініңізге сенімдімін. Мен түсінемін!
Dialogue: 0,0:23:54.97,0:23:57.97,Default,,0,0,0,,Ах…. Әй, бірақ...
Dialogue: 0,0:23:57.97,0:24:02.97,Default,,0,0,0,,Гоку мырза. Мұны Готен-кун да айтты.
Dialogue: 0,0:24:02.97,0:24:07.98,Default,,0,0,0,,Ммм... Ммм....
Dialogue: 0,0:24:07.98,0:24:09.98,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:24:09.98,0:24:12.98,Default,,0,0,0,,Онда мен оны аламын. Бұл шынымен жақсы ма?
Dialogue: 0,0:24:12.98,0:24:15.99,Default,,0,0,0,,Иә! Олай болса...
Dialogue: 0,0:24:15.99,0:24:18.99,Default,,0,0,0,,Рахмет. О, жақсы!
Dialogue: 0,0:24:18.99,0:24:23.03,Default,,0,0,0,,Ым, бұған қандай балама бар?→
Dialogue: 0,0:24:23.03,0:24:28.03,Default,,0,0,0,,Мұны құпия сақтаңыз. (Готен/Гоку) Иә?
Dialogue: 0,0:24:28.03,0:24:32.04,Default,,0,0,0,,Мен... 100 миллион Зени!?
Dialogue: 0,0:24:32.04,0:24:34.04,Default,,0,0,0,,Керемет емес пе, Гоку!
Dialogue: 0,0:24:34.04,0:24:37.04,Default,,0,0,0,,Осылай болса, Гөтен де мектепке сығымдап кетсін→
Dialogue: 0,0:24:37.04,0:24:40.05,Default,,0,0,0,,Сіз сондай-ақ көптеген репетиторларды ала аласыз.
Dialogue: 0,0:24:40.05,0:24:42.05,Default,,0,0,0,,Сіз мұны істедіңіз. Дұрыс Чичи→
Dialogue: 0,0:24:42.05,0:24:47.05,Default,,0,0,0,,Ора, мен Кай патшаның орнына жаттығуға барсам болады ма?
Dialogue: 0,0:24:47.05,0:24:50.06,Default,,0,0,0,,Ах. Бірақ анда-санда қайтып келуің керек.
Dialogue: 0,0:24:50.06,0:24:53.06,Default,,0,0,0,,Иә! Жақсы!
Dialogue: 0,0:24:53.06,0:24:58.06,Default,,0,0,0,,Хехе. Түсіндім. Бұл дұрыс.
Dialogue: 0,0:24:58.06,0:25:00.07,Default,,0,0,0,,Бірден бос мектеп пен жеке оқытушыны іздеңіз. →
Dialogue: 0,0:25:00.07,0:25:03.07,Default,,0,0,0,,Бірдеңе болса, мен жер бетіндегі ең жақсы тәрбиешінің болғанын қалаймын.
Dialogue: 0,0:25:03.07,0:25:05.07,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:25:05.07,0:25:09.07,Default,,0,0,0,,Гоку! 100 миллион Зени алғаныңыз рас па?
Dialogue: 0,0:25:09.07,0:25:12.08,Default,,0,0,0,,Бар болғаны осы болса, менде Pichi Pichi Gal DVD → болады
Dialogue: 0,0:25:12.08,0:25:14.08,Default,,0,0,0,,Сіз олардың тоннасын сатып ала аласыз. →
Dialogue: 0,0:25:14.08,0:25:17.08,Default,,0,0,0,,Мен оны бірден сатып аламын! Уф!
Dialogue: 0,0:25:17.08,0:25:19.08,Default,,0,0,0,,Сіз осындай нәрсені төлеуге мүмкіндігіңіз бар ма? →
Dialogue: 0,0:25:19.08,0:25:23.02,Default,,0,0,0,,Иә! (Кәме-сеннин) Қалай! Апыр-ай!
Dialogue: 0,0:25:23.02,0:25:34.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:34.03,0:25:39.04,Default,,0,0,0,,Баба, тағы бір жұлдыз сөніп қалды.
Dialogue: 0,0:25:39.04,0:25:41.04,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:25:41.04,0:25:43.04,Default,,0,0,0,,Хмм….
Dialogue: 0,0:25:46.04,0:25:56.04,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:48.11,0:26:50.11,Default,,0,0,0,,Сәлем, Гоку.
Dialogue: 0,0:26:50.11,0:26:54.11,Default,,0,0,0,,Ех! Вегета отбасылық сапарда ма?
Dialogue: 0,0:26:54.11,0:26:57.12,Default,,0,0,0,,Бұлма мен Сандықтар қатты қуанған →
Dialogue: 0,0:26:57.12,0:27:01.12,Default,,0,0,0,,Вегета менімен бірге жүреді деп ойламаймын.
Dialogue: 0,0:27:01.12,0:27:05.12,Default,,0,0,0,,Ой, Кай патша, көлік жүргізгенде абай болмасаңыз, сізге қауіп төнеді.
Dialogue: 0,0:27:05.12,0:27:07.12,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:11.13,0:27:13.13,Default,,0,0,0,,Міндетті түрде тексеріңіз!
Dialogue: 0,0:27:14.63,0:27:20.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory