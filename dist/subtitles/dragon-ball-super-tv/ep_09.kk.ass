Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.27,0:01:43.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:08.25,0:04:11.25,Default,,0,0,0,,(Исуми Миямура) Иә (Ишикава) Маған беріп тұрсың ба?
Dialogue: 0,0:04:13.26,0:04:15.26,Default,,0,0,0,,Уақыт жұмсауға тұрарлық еді>
Dialogue: 0,0:04:15.26,0:04:19.26,Default,,0,0,0,,<Тас, қағаз, жердің тіршілігі үшін қайшы→
Dialogue: 0,0:04:19.26,0:04:21.26,Default,,0,0,0,,Улонг жоғалды＞
Dialogue: 0,0:04:24.27,0:04:27.27,Default,,0,0,0,,<Енді жер жойылмайды→
Dialogue: 0,0:04:27.27,0:04:33.28,Default,,0,0,0,,Оны ешкім тоқтата алмайды ма? ＞
Dialogue: 0,0:04:33.28,0:04:35.28,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:04:35.28,0:04:37.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:42.29,0:04:46.29,Default,,0,0,0,,Сол Super Saiyan Құдайы мүмкін →
Dialogue: 0,0:04:46.29,0:04:48.29,Default,,0,0,0,,Мен оны таба алмауым мүмкін.
Dialogue: 0,0:04:48.29,0:04:54.30,Default,,0,0,0,,Маған аз ғана уақыт беріңіз. Біраз ғана. Жақсы емес пе?
Dialogue: 0,0:04:54.30,0:04:56.30,Default,,0,0,0,,Бұл аз ғана.
Dialogue: 0,0:04:56.30,0:04:59.30,Default,,0,0,0,,Рахмет, Беерус-сама.
Dialogue: 0,0:04:59.30,0:05:02.31,Default,,0,0,0,,Какарот! Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:05:02.31,0:05:04.31,Default,,0,0,0,,Мен Шенронның билігін қарызға алдым.
Dialogue: 0,0:05:18.26,0:05:21.26,Default,,0,0,0,,Жақсы. →
Dialogue: 0,0:05:21.26,0:05:23.26,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:05:25.26,0:05:29.27,Default,,0,0,0,,Рахмет. Бұл тілек допқа ұқсайды.
Dialogue: 0,0:05:29.27,0:05:32.27,Default,,0,0,0,,Жер құдайы Намекианға ұқсайды.
Dialogue: 0,0:05:32.27,0:05:37.28,Default,,0,0,0,,Мен тілек шарының үлкенірек болғанын сезіндім.
Dialogue: 0,0:05:37.28,0:05:40.28,Default,,0,0,0,,Мм, бұл менің қиялым шығар.
Dialogue: 0,0:05:40.28,0:05:42.28,Default,,0,0,0,,Бұл менің қиялым ғана емес.
Dialogue: 0,0:05:42.28,0:05:46.28,Default,,0,0,0,,Жердің тілек шары кішкентай сияқты. Хмм.
Dialogue: 0,0:05:46.28,0:06:02.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:02.30,0:06:04.30,Default,,0,0,0,,Кел, Шенрон!
Dialogue: 0,0:06:04.30,0:06:07.30,Default,,0,0,0,,Тілегіңіз орындалсын!
Dialogue: 0,0:06:30.26,0:06:35.26,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:06:42.27,0:06:44.28,Default,,0,0,0,,Дауыл... боран келе жатыр! →
Dialogue: 0,0:06:44.28,0:06:46.28,Default,,0,0,0,,Асығыңыз! Шу жаным!
Dialogue: 0,0:06:46.28,0:06:49.28,Default,,0,0,0,,А... Уф.
Dialogue: 0,0:06:49.28,0:06:52.28,Default,,0,0,0,,Әй, палау-сама, мынаны қарашы!
Dialogue: 0,0:06:52.28,0:06:54.29,Default,,0,0,0,,Не? →
Dialogue: 0,0:06:54.29,0:06:57.29,Default,,0,0,0,,Гах... болды!
Dialogue: 0,0:06:57.29,0:06:59.29,Default,,0,0,0,,Шенрон!
Dialogue: 0,0:06:59.29,0:07:02.29,Default,,0,0,0,,Айдаһар шарлары шынымен де бар еді.
Dialogue: 0,0:07:02.29,0:07:04.30,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:07:04.30,0:07:06.31,Default,,0,0,0,,Қараңдар! Сіз жігіттер!
Dialogue: 0,0:07:06.31,0:07:09.23,Default,,0,0,0,,Мен дұрыс емес пе едім!
Dialogue: 0,0:07:09.23,0:07:11.24,Default,,0,0,0,,Уф.
Dialogue: 0,0:07:11.24,0:07:14.24,Default,,0,0,0,,Кеттік! Сол кемеге қайта мін! (Шу Май) Иә!?
Dialogue: 0,0:07:14.24,0:07:17.24,Default,,0,0,0,,«Не!?» емес (Шу Май) Иә?
Dialogue: 0,0:07:17.24,0:07:19.24,Default,,0,0,0,,Қараңғы!
Dialogue: 0,0:07:19.24,0:07:22.24,Default,,0,0,0,,Қатар мүмкіндігінше қатты болыңыз!
Dialogue: 0,0:07:27.25,0:07:30.26,Default,,0,0,0,,Кез келген тілекті орындаймын. →
Dialogue: 0,0:07:30.26,0:07:33.26,Default,,0,0,0,,Енді өз тілегіңді айт.
Dialogue: 0,0:07:33.26,0:07:35.26,Default,,0,0,0,,Мен сізден сұрайын деп отырмын →
Dialogue: 0,0:07:35.26,0:07:38.26,Default,,0,0,0,,Сіз Super Saiyan Құдайы туралы білесіз бе?
Dialogue: 0,0:07:38.26,0:07:42.27,Default,,0,0,0,,Білсең, маған телефон соғуыңды қалаймын.
Dialogue: 0,0:07:42.27,0:07:44.27,Default,,0,0,0,,Пайдалану оңай.
Dialogue: 0,0:07:44.27,0:07:46.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:48.27,0:07:53.28,Default,,0,0,0,,Енді сізді Беерус-сама жоюдың қажеті жоқ.
Dialogue: 0,0:07:53.28,0:07:56.28,Default,,0,0,0,,Не!? Би... бұл Беерус-сама!?
Dialogue: 0,0:07:56.28,0:07:58.28,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:07:58.28,0:08:01.29,Default,,0,0,0,,Ах…. (Шенрон) Уа, ау, ау...
Dialogue: 0,0:08:01.29,0:08:03.29,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:08:03.29,0:08:07.23,Default,,0,0,0,,О... Эй... Сәлем, бұл Беерус-сама.
Dialogue: 0,0:08:07.23,0:08:11.23,Default,,0,0,0,,Осындай биік жерден келгенім үшін кешірім сұраймын. →
Dialogue: 0,0:08:11.23,0:08:15.23,Default,,0,0,0,,Мен сенің жер бетінде болатыныңды ешқашан елестеткен емеспін.
Dialogue: 0,0:08:15.23,0:08:18.24,Default,,0,0,0,,Оның орнына, Супер Сайян Құдайы →
Dialogue: 0,0:08:18.24,0:08:20.24,Default,,0,0,0,,Маған тез қоңырау шалыңыз.
Dialogue: 0,0:08:20.24,0:08:23.24,Default,,0,0,0,,Жоқ, солай →
Dialogue: 0,0:08:23.24,0:08:27.25,Default,,0,0,0,,Негізі оны бірден шақыру мүмкін емес.
Dialogue: 0,0:08:27.25,0:08:29.25,Default,,0,0,0,,Ех!
Dialogue: 0,0:08:29.25,0:08:31.25,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:08:31.25,0:08:34.25,Default,,0,0,0,,Сіз нені айтасыз? Болды...
Dialogue: 0,0:08:34.25,0:08:36.25,Default,,0,0,0,,Ух... Мм!
Dialogue: 0,0:08:36.25,0:08:38.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:41.26,0:08:44.26,Default,,0,0,0,,Не? (Шенрон) Ах!
Dialogue: 0,0:08:44.26,0:08:46.26,Default,,0,0,0,,Ах... Беерус-сама.
Dialogue: 0,0:08:46.26,0:08:50.27,Default,,0,0,0,,Супер Сайян Құдайы→
Dialogue: 0,0:08:50.27,0:08:53.27,Default,,0,0,0,,Сайян мифологиясында кездесетін құдай→
Dialogue: 0,0:08:53.27,0:08:56.27,Default,,0,0,0,,Қазіргі уақытта жоқ.
Dialogue: 0,0:08:56.27,0:08:59.28,Default,,0,0,0,,Егер бұл жай ғана жасау әдісі болса →
Dialogue: 0,0:08:59.28,0:09:03.28,Default,,0,0,0,,Сізге үйретуге болады.
Dialogue: 0,0:09:03.28,0:09:06.30,Default,,0,0,0,,Иә? (Шенрон) О, о...
Dialogue: 0,0:09:06.30,0:09:11.22,Default,,0,0,0,,Бұл Намек планетасының аңызға айналған кітабында жазылған. →
Dialogue: 0,0:09:11.22,0:09:16.23,Default,,0,0,0,,«Бес әділ Сайян қол ұстасып →
Dialogue: 0,0:09:16.23,0:09:19.23,Default,,0,0,0,,Жүрегіңді басқа әділ Сайянға құйсаң→
Dialogue: 0,0:09:19.23,0:09:24.24,Default,,0,0,0,,Сайяндардың құдайы бол».
Dialogue: 0,0:09:24.24,0:09:28.24,Default,,0,0,0,,Басқаша айтқанда, ол Супер Сайян Құдайына айналады.
Dialogue: 0,0:09:28.24,0:09:30.24,Default,,0,0,0,,(Хироко) Дегенмен, мен өзімді сәл жалғыз сезінемін.
Dialogue: 0,0:09:30.24,0:09:34.25,Default,,0,0,0,,Вегета Сіз Сайяндардың ханзадасысыз, солай ма?
Dialogue: 0,0:09:34.25,0:09:38.25,Default,,0,0,0,,Неліктен бұл туралы білмейсің? (Вегета) Цк.
Dialogue: 0,0:09:38.25,0:09:40.25,Default,,0,0,0,,Мен сізге қалай екенін айттым.
Dialogue: 0,0:09:40.25,0:09:43.25,Default,,0,0,0,,Бұл үшін кешірім сұраймын.→
Dialogue: 0,0:09:43.25,0:09:46.26,Default,,0,0,0,,(Норияки Какёин) 500 сингапур доллары.
Dialogue: 0,0:09:46.26,0:09:49.26,Default,,0,0,0,,Хмм…. Хмм.
Dialogue: 0,0:09:49.26,0:09:52.26,Default,,0,0,0,,Сонымен... онда Беерус-сама →
Dialogue: 0,0:09:52.26,0:09:56.27,Default,,0,0,0,,Біз сізді қайтадан көргіміз келеді.
Dialogue: 0,0:09:56.27,0:09:58.27,Default,,0,0,0,,Охон.
Dialogue: 0,0:09:58.27,0:10:00.27,Default,,0,0,0,,Қоштасу.
Dialogue: 0,0:10:06.24,0:10:10.11,Default,,0,0,0,,Шенроннан келген адам қашып кетті. иә.
Dialogue: 0,0:10:10.11,0:10:12.12,Default,,0,0,0,,Қане, ерте бастайық.
Dialogue: 0,0:10:12.12,0:10:15.12,Default,,0,0,0,,Не... сен не айттың? Шенрон.
Dialogue: 0,0:10:15.12,0:10:17.12,Default,,0,0,0,,О, мен шынымен түсінбедім.
Dialogue: 0,0:10:17.12,0:10:21.13,Default,,0,0,0,,Бес әділ сайян қол ұстасып →
Dialogue: 0,0:10:21.13,0:10:24.13,Default,,0,0,0,,Жүрегіңді бір Сайянға жалғасаң →
Dialogue: 0,0:10:24.13,0:10:28.13,Default,,0,0,0,,Солардың бірі сайяндардың құдайы болатын сияқты.
Dialogue: 0,0:10:28.13,0:10:31.14,Default,,0,0,0,,Super Saiyan God дегеніңіз осы ма?
Dialogue: 0,0:10:31.14,0:10:33.14,Default,,0,0,0,,Иә. бәлкім.
Dialogue: 0,0:10:33.14,0:10:35.14,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:10:35.14,0:10:38.14,Default,,0,0,0,,Мұнда жүрегі таза сайандар бар→
Dialogue: 0,0:10:38.14,0:10:41.14,Default,,0,0,0,,Жартылай жерді қосқанда 4 адам ғана.
Dialogue: 0,0:10:44.15,0:10:46.15,Default,,0,0,0,,Жоқ, бес адам бар.
Dialogue: 0,0:10:46.15,0:10:51.16,Default,,0,0,0,,Вегета да қазір толықтай дұрыс ақылға ие.
Dialogue: 0,0:10:51.16,0:10:53.16,Default,,0,0,0,,Мен бұл туралы білмеймін. Пикколо!
Dialogue: 0,0:10:53.16,0:10:55.16,Default,,0,0,0,,Алдын ала пікір жоқ!
Dialogue: 0,0:10:55.16,0:10:59.16,Default,,0,0,0,,Ол отбасын сапарға шығарып салатын жақсы әке.
Dialogue: 0,0:10:59.16,0:11:01.17,Default,,0,0,0,,Цк. Жақсы.
Dialogue: 0,0:11:01.17,0:11:05.17,Default,,0,0,0,,Иә? Вегета, жасайық!
Dialogue: 0,0:11:05.17,0:11:07.17,Default,,0,0,0,,Уф….
Dialogue: 0,0:11:18.22,0:11:22.22,Default,,0,0,0,,Боқ. Неліктен Какарот әрқашан басты кейіпкер болып табылады?
Dialogue: 0,0:11:22.22,0:11:25.22,Default,,0,0,0,,Олай айтпа, Вегета.
Dialogue: 0,0:11:25.22,0:11:28.23,Default,,0,0,0,,Егер мен сәтті болсам, келесі жолы сізге рұқсат етемін.
Dialogue: 0,0:11:28.23,0:11:30.23,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:11:30.23,0:11:50.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:50.25,0:11:56.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:56.25,0:11:59.26,Default,,0,0,0,,Ух... (Видель Чичи Шайтан) Ух...
Dialogue: 0,0:11:59.26,0:12:02.26,Default,,0,0,0,,Уау! Гах...
Dialogue: 0,0:12:11.20,0:12:13.20,Default,,0,0,0,,Иә? (Вегета) Иә?
Dialogue: 0,0:12:13.20,0:12:15.21,Default,,0,0,0,,Иә? Ах.
Dialogue: 0,0:12:15.21,0:12:17.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:23.21,0:12:25.22,Default,,0,0,0,,Какарот Сіз бірдеңені сезінесіз бе?
Dialogue: 0,0:12:25.22,0:12:28.22,Default,,0,0,0,,Айтсаңыз да.
Dialogue: 0,0:12:28.22,0:12:33.22,Default,,0,0,0,,Құдай, мен түсінбеймін.
Dialogue: 0,0:12:33.22,0:12:35.23,Default,,0,0,0,,Сөзсіз ки →
Dialogue: 0,0:12:35.23,0:12:38.23,Default,,0,0,0,,Ол бұрынғыдан да үлкен.
Dialogue: 0,0:12:38.23,0:12:40.23,Default,,0,0,0,,Ах. Бұл шынымен таңқаларлық.
Dialogue: 0,0:12:40.23,0:12:43.23,Default,,0,0,0,,Бұл сөзсіз келесі мен.
Dialogue: 0,0:12:45.24,0:12:47.24,Default,,0,0,0,,Уф….
Dialogue: 0,0:12:47.24,0:12:49.24,Default,,0,0,0,,Уф….
Dialogue: 0,0:12:49.24,0:12:51.24,Default,,0,0,0,,Уау. Ах...
Dialogue: 0,0:14:39.82,0:14:42.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:42.82,0:14:44.82,Default,,0,0,0,,Күрсін... бұл дұрыс емес.
Dialogue: 0,0:14:44.82,0:14:46.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:46.82,0:14:49.83,Default,,0,0,0,,Құйғаның ақыл емес, жүрегің.
Dialogue: 0,0:14:49.83,0:14:53.83,Default,,0,0,0,,Барлығыңыз мұқият ойланыңыздар.
Dialogue: 0,0:14:53.83,0:14:57.84,Default,,0,0,0,,«Бес әділ сайян бірде» →
Dialogue: 0,0:14:57.84,0:15:01.84,Default,,0,0,0,,Барлығы 6 адам керек емес пе?
Dialogue: 0,0:15:01.84,0:15:03.84,Default,,0,0,0,,Иә? 6 адам?
Dialogue: 0,0:15:03.84,0:15:06.84,Default,,0,0,0,,Иә!? Жоқ. Бір адам жеткіліксіз.
Dialogue: 0,0:15:06.84,0:15:08.84,Default,,0,0,0,,Цк.
Dialogue: 0,0:15:11.85,0:15:15.85,Default,,0,0,0,,Бар болғаны 5 сайян бар→
Dialogue: 0,0:15:15.85,0:15:18.86,Default,,0,0,0,,Сәтіңіз таусылған сияқты. (Вегета) Қарғыс атсын.
Dialogue: 0,0:15:18.86,0:15:22.86,Default,,0,0,0,,Какарот, сенен үлкен үміт күткен ақымақ болдым!
Dialogue: 0,0:15:22.86,0:15:26.86,Default,,0,0,0,,Жаман Бұл жақсы болмады. Мен бара аламын деп ойладым.
Dialogue: 0,0:15:26.86,0:15:28.86,Default,,0,0,0,,(Хироко) Дегенмен, мен өзімді сәл жалғыз сезінемін.
Dialogue: 0,0:15:32.80,0:15:34.80,Default,,0,0,0,,Ухуху….
Dialogue: 0,0:15:41.81,0:15:44.82,Default,,0,0,0,,А... бұл! (Барлығы) иә?
Dialogue: 0,0:15:44.82,0:15:46.82,Default,,0,0,0,,Иә? Бұл жақсы емес, Видель-сан.
Dialogue: 0,0:15:46.82,0:15:49.82,Default,,0,0,0,,Ах... бұл….
Dialogue: 0,0:15:49.82,0:15:53.82,Default,,0,0,0,,Ішімдегі Сайян жақсы емес пе?
Dialogue: 0,0:15:53.82,0:15:57.83,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:15:57.83,0:15:59.83,Default,,0,0,0,,Ех!
Dialogue: 0,0:15:59.83,0:16:04.84,Default,,0,0,0,,Видель-сан... Ішіңдегі біздің бала ма?
Dialogue: 0,0:16:04.84,0:16:06.84,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:16:06.84,0:16:11.84,Default,,0,0,0,,Хаха, біз мұны жасадық! Yahoo!
Dialogue: 0,0:16:11.84,0:16:14.85,Default,,0,0,0,,Хмф! Сен істедің, Видель!
Dialogue: 0,0:16:14.85,0:16:18.85,Default,,0,0,0,,Сәлем әке. Бұл бата!
Dialogue: 0,0:16:18.85,0:16:21.85,Default,,0,0,0,,Сіз қашан дүниеге келесіз? Сіз атауды шештіңіз бе?
Dialogue: 0,0:16:21.85,0:16:23.85,Default,,0,0,0,,Жоқ. Әлі ештеңе жоқ.
Dialogue: 0,0:16:23.85,0:16:26.86,Default,,0,0,0,,Олай болса маған қалдырыңыз. →
Dialogue: 0,0:16:26.86,0:16:28.86,Default,,0,0,0,,Өйткені Гоку мен Гохан осында→
Dialogue: 0,0:16:28.86,0:16:30.88,Default,,0,0,0,,Гомен туралы не ойлайсың?
Dialogue: 0,0:16:30.88,0:16:32.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:32.80,0:16:34.80,Default,,0,0,0,,Әй, сен ата болады дейсің бе?
Dialogue: 0,0:16:34.80,0:16:36.80,Default,,0,0,0,,Құттықтаймыз Гоку!
Dialogue: 0,0:16:36.80,0:16:38.80,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:38.80,0:16:40.81,Default,,0,0,0,,Хаха хахахаха. Гррр.
Dialogue: 0,0:16:40.81,0:16:44.81,Default,,0,0,0,,Супер Сайян құдайын тез жасаңыз!
Dialogue: 0,0:16:44.81,0:16:46.81,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:46.81,0:16:50.82,Default,,0,0,0,,Бірақ құрсағындағы нәресте→
Dialogue: 0,0:16:50.82,0:16:53.82,Default,,0,0,0,,Сайянмын десең де.
Dialogue: 0,0:16:53.82,0:16:55.82,Default,,0,0,0,,Әке. иә?
Dialogue: 0,0:16:55.82,0:16:57.82,Default,,0,0,0,,Сіз Жерді құтқара аласыз.
Dialogue: 0,0:16:57.82,0:17:00.83,Default,,0,0,0,,Видель-санды қосып көрейік.
Dialogue: 0,0:17:00.83,0:17:02.83,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:02.83,0:17:05.83,Default,,0,0,0,,Ола Мен супер Сайян құдайына айналдым.
Dialogue: 0,0:17:10.84,0:17:15.84,Default,,0,0,0,,Баршалар, жүректеріңді төгіп алыңдар. Жүрек.
Dialogue: 0,0:17:15.84,0:17:35.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:35.79,0:17:37.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:37.80,0:17:41.80,Default,,0,0,0,,Хмм? Ештеңе болмайды.
Dialogue: 0,0:17:41.80,0:17:44.80,Default,,0,0,0,,Менің ойымша, бұл Вегета кінәлі ме?
Dialogue: 0,0:17:44.80,0:17:46.80,Default,,0,0,0,,Tsk! Заттарды назардан тыс қалдырмаңыз!
Dialogue: 0,0:17:46.80,0:17:51.81,Default,,0,0,0,,Әлде сәби Гоханның есі дұрыс емес шығар?
Dialogue: 0,0:17:51.81,0:17:54.81,Default,,0,0,0,,Кешіріңіз, әке! Бұл дұрыс!
Dialogue: 0,0:17:54.81,0:17:56.81,Default,,0,0,0,,А, жаман, жаман.
Dialogue: 0,0:17:56.81,0:17:59.81,Default,,0,0,0,,Енді зейініңді жинақтап, жүрегіңді соған құй.
Dialogue: 0,0:18:06.82,0:18:08.83,Default,,0,0,0,,Барлығыңызды өтінемін.
Dialogue: 0,0:18:08.83,0:18:12.83,Default,,0,0,0,,Сіз міндетті түрде жетістікке жетесіз. Қолыңнан келгеннің бәрін жаса, Видель.
Dialogue: 0,0:18:15.83,0:18:17.83,Default,,0,0,0,,Һм?
Dialogue: 0,0:18:21.84,0:18:25.84,Default,,0,0,0,,Иә? Әй, Видель-санның асқазаны!
Dialogue: 0,0:18:25.84,0:18:30.86,Default,,0,0,0,,А... ыстық. Менің асқазаным...
Dialogue: 0,0:18:30.86,0:18:50.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:50.80,0:19:10.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:10.82,0:19:14.83,Default,,0,0,0,,О, Құдай?
Dialogue: 0,0:19:14.83,0:19:19.83,Default,,0,0,0,,Конверт пе?
Dialogue: 0,0:19:19.83,0:19:28.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:28.84,0:19:32.78,Default,,0,0,0,,Ах! Бұл жолы не болды?
Dialogue: 0,0:19:32.78,0:19:52.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:52.80,0:19:55.80,Default,,0,0,0,,Уау Уау Уау! Апыр-ай!
Dialogue: 0,0:19:58.80,0:20:00.80,Default,,0,0,0,,(Хироко) Дегенмен, мен өзімді сәл жалғыз сезінемін.
Dialogue: 0,0:20:04.81,0:20:09.81,Default,,0,0,0,,Видель-сан, жақсысың ба? Иә.
Dialogue: 0,0:20:09.81,0:20:12.82,Default,,0,0,0,,Денем аздап ауырады.
Dialogue: 0,0:20:12.82,0:20:14.82,Default,,0,0,0,,Сіз құдайға айналуыңыз мүмкін. →
Dialogue: 0,0:20:14.82,0:20:16.82,Default,,0,0,0,,Тек шыдамды болыңыз!
Dialogue: 0,0:20:16.82,0:20:19.82,Default,,0,0,0,,Басқаны сынап көрсең де болады, Какарот.
Dialogue: 0,0:20:22.83,0:20:24.83,Default,,0,0,0,,Мм.
Dialogue: 0,0:20:24.83,0:20:40.78,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:40.78,0:20:45.78,Default,,0,0,0,,Аа….
Dialogue: 0,0:20:45.78,0:20:50.79,Default,,0,0,0,,Жоқ. Бұрынғыдан басқаша.
Dialogue: 0,0:20:50.79,0:20:52.79,Default,,0,0,0,,Бірдеңе болатын сияқты.
Dialogue: 0,0:20:52.79,0:20:54.79,Default,,0,0,0,,Иә, Беерус-сама.
Dialogue: 0,0:20:54.79,0:20:58.80,Default,,0,0,0,,Бұл мен айтқан жай киден басқаша болған сияқты.
Dialogue: 0,0:20:58.80,0:21:00.80,Default,,0,0,0,,О.
Dialogue: 0,0:21:00.80,0:21:08.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:08.81,0:21:10.81,Default,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:21:10.81,0:21:12.81,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:21:12.81,0:21:32.76,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:32.76,0:21:43.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:43.77,0:21:47.78,Default,,0,0,0,,Ах…. бұл!
Dialogue: 0,0:21:47.78,0:21:51.78,Default,,0,0,0,,Жаңбыр жауып тұр!? (Каме Эрмит) Ауырды. Неліктен Хёга?
Dialogue: 0,0:21:51.78,0:22:11.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:11.80,0:22:31.76,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:31.76,0:22:38.76,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:38.76,0:22:41.77,Default,,0,0,0,,Уф... Какарот.
Dialogue: 0,0:22:41.77,0:23:01.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:01.79,0:23:09.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:14.80,0:23:16.80,Default,,0,0,0,,Какарот.
Dialogue: 0,0:23:16.80,0:23:20.80,Default,,0,0,0,,Ақырында біз Super Saiyan Құдайын кездестіреміз бе?
Dialogue: 0,0:23:20.80,0:23:22.81,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:23:22.81,0:23:26.81,Default,,0,0,0,,Гоку. (Барлығы) Ах....
Dialogue: 0,0:23:26.81,0:23:28.81,Default,,0,0,0,,Немересі.
Dialogue: 0,0:23:30.83,0:23:32.75,Default,,0,0,0,,Хмм….
Dialogue: 0,0:23:32.75,0:23:35.75,Default,,0,0,0,,Пайғамбарлық түс дұрыс болса жақсы болар еді.
Dialogue: 0,0:23:42.76,0:23:44.76,Default,,0,0,0,,О.
Dialogue: 0,0:23:50.77,0:23:53.77,Default,,0,0,0,,О...
Dialogue: 0,0:23:53.77,0:23:55.77,Default,,0,0,0,,Аа….
Dialogue: 0,0:23:55.77,0:23:57.77,Default,,0,0,0,,Аа….
Dialogue: 0,0:24:01.78,0:24:03.78,Default,,0,0,0,,Маю-сан менің жейдемнің үстінде жатыр…
Dialogue: 0,0:24:03.78,0:24:06.78,Default,,0,0,0,,Уф... Жарайды ма? Видель мырза.
Dialogue: 0,0:24:06.78,0:24:08.79,Default,,0,0,0,,Ух... иә.
Dialogue: 0,0:24:08.79,0:24:28.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:28.81,0:24:45.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:53.83,0:24:57.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:57.83,0:24:59.84,Default,,0,0,0,,Гоку. →
Dialogue: 0,0:24:59.84,0:25:04.84,Default,,0,0,0,,Бұл шынымен Гоку Садабе ме?
Dialogue: 0,0:25:04.84,0:25:06.84,Default,,0,0,0,,Жасарту емес пе?
Dialogue: 0,0:25:06.84,0:25:08.84,Default,,0,0,0,,Сіз қалай ойлайсыз? Денде.
Dialogue: 0,0:25:10.85,0:25:12.85,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:15.85,0:25:19.86,Default,,0,0,0,,Күтуге тұрарлық сияқты.
Dialogue: 0,0:25:19.86,0:25:24.86,Default,,0,0,0,,Беерус-сама, мен сені ұзақ күттім.
Dialogue: 0,0:25:26.86,0:25:31.86,Default,,0,0,0,,Гого... Гоку жігіті... Ақыры...
Dialogue: 0,0:25:38.81,0:25:40.81,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:40.81,0:25:43.81,Default,,0,0,0,,Әй, көңілім көтеріліп барады.
Dialogue: 0,0:25:45.82,0:25:55.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:47.81,0:26:49.81,Default,,0,0,0,,Сәлем, Гоку.
Dialogue: 0,0:26:49.81,0:26:53.82,Default,,0,0,0,,Мен таң қалдым. Әй, сен шынымен құдайға айналған сияқтысың.
Dialogue: 0,0:26:53.82,0:26:57.82,Default,,0,0,0,,Осы ғажайып күшпен мен бұл жолы жеңілмеймін.
Dialogue: 0,0:26:57.82,0:27:00.82,Default,,0,0,0,,Ой, Беерус-сама, мен сенен оздым.
Dialogue: 0,0:27:00.82,0:27:02.83,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:27:02.83,0:27:05.83,Default,,0,0,0,,Соққы жақсы түспейді.
Dialogue: 0,0:27:05.83,0:27:08.83,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:11.84,0:27:13.84,Default,,0,0,0,,Сіз оны міндетті түрде тексеруіңіз керек.
Dialogue: 0,0:27:15.34,0:27:21.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory