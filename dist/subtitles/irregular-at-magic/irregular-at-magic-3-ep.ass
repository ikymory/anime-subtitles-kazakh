Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.75,0:00:11.36,Default,NTP,0,0,0,,Ұстаңыз.
Dialogue: 0,0:00:10.82,0:00:11.16,JPDB-ja,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:00:12.89,0:00:13.86,Default,NTP,0,0,0,,Сіз жасаған қозғалыс...
Dialogue: 0,0:00:12.92,0:00:16.94,JPDB-ja,,0,0,0,,Ағымдағы қозғалыс алдын ала әзірленген өзін-өзі жеделдету әдісі болды ма?
Dialogue: 0,0:00:13.86,0:00:17.87,Default,NTP,0,0,0,,Өзін-өзі жеделдету заклинамасын алдын ала қолдандыңыз ба?
Dialogue: 0,0:00:18.94,0:00:21.25,Default,NTP,0,0,0,,Бұл сиқыр емес еді.
Dialogue: 0,0:00:19.00,0:00:20.22,JPDB-ja,,0,0,0,,Сиқыр емес
Dialogue: 0,0:00:21.25,0:00:24.47,Default,NTP,0,0,0,,Бұл адал физикалық техника болды.
Dialogue: 0,0:00:21.70,0:00:24.50,JPDB-ja,,0,0,0,,Нағыз физикалық техника
Dialogue: 0,0:00:31.45,0:00:33.22,Default,NTP,0,0,0,,Менің ағам ниндзюцумен айналысады.
Dialogue: 0,0:00:31.48,0:00:36.62,JPDB-ja,,0,0,0,,Менің ағамды ниндзюцу шебері Коконое Якумо Сенсей жаттықтырады.
Dialogue: 0,0:00:33.87,0:00:36.72,Default,NTP,0,0,0,,Ол Якумо Коконое жаттығуынан өтуде.
Dialogue: 0,0:00:37.38,0:00:39.38,Default,NTP,0,0,0,,Сол Коконое...?
Dialogue: 0,0:00:37.44,0:00:38.98,JPDB-ja,,0,0,0,,Сол Коконое-сенсейге
Dialogue: 0,0:00:39.38,0:00:43.82,Default,NTP,0,0,0,,Сонда сіздің шабуылда қолданған сиқырыңыз да ниндзюцу болды ма?
Dialogue: 0,0:00:39.44,0:00:43.04,JPDB-ja,,0,0,0,,Сонымен, бұл шабуылға қолданылған сиқыр да ниндзюцу болды ма?
Dialogue: 0,0:00:43.82,0:00:47.81,Default,NTP,0,0,0,,Бұл маған тек Psion толқындарын шығарғандай көрінді...
Dialogue: 0,0:00:44.08,0:00:47.68,JPDB-ja,,0,0,0,,Бұл жай ғана Psion толқынының өзі шығарылған сияқты болды.
Dialogue: 0,0:00:48.14,0:00:49.80,Default,NTP,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:48.18,0:00:48.90,JPDB-ja,,0,0,0,,Біздің Yotsuba тобымыздың әрі қарай өсуі мен дамуы үшін,
Dialogue: 0,0:00:49.80,0:00:52.70,Default,,0,0,0,,Бұл сингулярлық түрдегі маңызды заклинание болды,
Dialogue: 0,0:00:49.90,0:00:52.18,JPDB-ja,,0,0,0,,Бұл дірілдің негізгі бір жүйелі сиқыры.
Dialogue: 0,0:00:52.70,0:00:55.32,Default,NTP,0,0,0,,және мен тек Psion толқындарын жасау болды.
Dialogue: 0,0:00:52.80,0:00:54.96,JPDB-ja,,0,0,0,,Жаңа ғана псиондық толқын құрылды
Dialogue: 0,0:00:55.32,0:00:56.57,Default,NTP,0,0,0,,Сонда да,
Dialogue: 0,0:00:55.44,0:00:56.58,JPDB-ja,,0,0,0,,Бірақ содан кейін
Dialogue: 0,0:00:56.57,0:00:59.70,Default,NTP,0,0,0,,бұл Ханзо-кунның неліктен нокаутқа түскенін түсіндірмейді.
Dialogue: 0,0:00:57.02,0:00:59.54,JPDB-ja,,0,0,0,,Ханзо-кунның неге құлағанын білмеймін.
Dialogue: 0,0:01:01.37,0:01:02.58,Default,NTP,0,0,0,,Ол босқа кетті.
Dialogue: 0,0:01:01.48,0:01:02.36,JPDB-ja,,0,0,0,,Мен мас болдым.
Dialogue: 0,0:01:03.20,0:01:04.08,JPDB-ja,,0,0,0,,мас
Dialogue: 0,0:01:03.33,0:01:05.58,Default,NTP,0,0,0,,Босқа кетті ме? Нақты не туралы?
Dialogue: 0,0:01:04.46,0:01:05.30,JPDB-ja,,0,0,0,,Жерде не?
Dialogue: 0,0:01:06.27,0:01:11.09,Default,NTP,0,0,0,,Сиқыршылар Псиондарды көрінетін жарық пен дыбыс толқындарын қабылдайтындай қабылдайды.
Dialogue: 0,0:01:06.38,0:01:07.76,JPDB-ja,,0,0,0,,Сиқыршы Scion пайдаланады.
Dialogue: 0,0:01:08.14,0:01:10.96,JPDB-ja,,0,0,0,,Көрінетін жарық пен естілетін дыбыс толқындары сияқты қабылданады
Dialogue: 0,0:01:12.07,0:01:14.77,Default,NTP,0,0,0,,Сиқыршы күтпеген Псиондарға тап болғанда,
Dialogue: 0,0:01:12.08,0:01:14.36,JPDB-ja,,0,0,0,,Сиқыршы күтпеген псионға ұшырады.
Dialogue: 0,0:01:14.77,0:01:18.47,Default,NTP,0,0,0,,денесінің дірілдеп жатқанын галлюцинациялайды.
Dialogue: 0,0:01:14.78,0:01:18.48,JPDB-ja,,0,0,0,,Сіз шын мәнінде сіздің денеңіз шайқалып жатыр деген елес аласыз.
Dialogue: 0,0:01:21.05,0:01:22.35,Default,NTP,0,0,0,,Бұл адасу болды
Dialogue: 0,0:01:21.10,0:01:22.34,JPDB-ja,,0,0,0,,Осы иллюзия бойынша
Dialogue: 0,0:01:23.27,0:01:26.48,Default,NTP,0,0,0,,бұл теңіз ауруының күшті шабуылына ұқсас нәрсе әкелді.
Dialogue: 0,0:01:23.30,0:01:26.30,JPDB-ja,,0,0,0,,Бұл қатты теңіз ауруы сияқты болды.
Dialogue: 0,0:01:26.87,0:01:30.98,Default,NTP,0,0,0,,Соншалықты күшті толқын ... қалай болдыңыз ...?
Dialogue: 0,0:01:26.90,0:01:30.24,JPDB-ja,,0,0,0,,Мұндай күшті толқындар қалай пайда болады?
Dialogue: 0,0:01:31.69,0:01:34.32,Default,NTP,0,0,0,,Құрама толқындар, солай ма?
Dialogue: 0,0:01:31.70,0:01:34.14,JPDB-ja,,0,0,0,,Толқындық синтез
Dialogue: 0,0:01:35.59,0:01:39.40,Default,NTP,0,0,0,,Сіз тербеліс жиіліктері өзгеретін үш қатарынан Psion толқындарын жасадыңыз,
Dialogue: 0,0:01:35.60,0:01:38.98,JPDB-ja,,0,0,0,,Әртүрлі жиіліктегі үш ретті псиондық толқындарды жасаңыз
Dialogue: 0,0:01:39.36,0:01:44.30,JPDB-ja,,0,0,0,,Үш толқын Хатторимен қабаттасатын жерде дәл біріктірілетін етіп реттеңіз.
Dialogue: 0,0:01:39.40,0:01:44.70,Default,NTP,0,0,0,,оларды үшеуі Хаттори тұрған жерде біріктіретіндей етіп калибрледі,
Dialogue: 0,0:01:44.64,0:01:47.96,JPDB-ja,,0,0,0,,Үшбұрышты толқын сияқты күшті толқын тудырса керек.
Dialogue: 0,0:01:44.70,0:01:48.83,Default,NTP,0,0,0,,содан кейін үшбұрышты толқын сияқты күшті толқын тудырды.
Dialogue: 0,0:01:49.95,0:01:52.17,Default,NTP,0,0,0,,Өте әсерлі, Ичихара ханым.
Dialogue: 0,0:01:50.00,0:01:52.04,JPDB-ja,,0,0,0,,Керемет жұмыс, Ичихара-сенпай.
Dialogue: 0,0:01:53.24,0:01:56.10,JPDB-ja,,0,0,0,,Солай болса да, аз уақыттың ішінде қалай үлгердің?
Dialogue: 0,0:01:53.26,0:01:56.64,Default,NTP,0,0,0,,Дегенмен, сіз мұны қысқа уақыт ішінде қалай жеңе алдыңыз?
Dialogue: 0,0:01:57.90,0:01:59.72,JPDB-ja,,0,0,0,,Өңдеу жылдамдығы сонша болса
Dialogue: 0,0:01:57.90,0:02:03.03,Default,NTP,0,0,0,,Осындай өңдеу жылдамдығымен сіздің техникалық ұпайларыңыз соншалықты төмен болатынын түсінбеймін.
Dialogue: 0,0:02:00.32,0:02:02.62,JPDB-ja,,0,0,0,,Тәжірибелік дағдыны бағалау төмен болды деп айтуға болмайды.
Dialogue: 0,0:02:06.59,0:02:07.52,Default,NTP,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:02:06.64,0:02:07.62,JPDB-ja,,0,0,0,,Бұл
Dialogue: 0,0:02:08.02,0:02:12.06,JPDB-ja,,0,0,0,,Шиба-кунның CAD «Күміс мүйіз» емес пе?
Dialogue: 0,0:02:08.03,0:02:12.02,Default,NTP,0,0,0,,Кез келген жағдайда, Шиба-кун, сіздің CAD күміс мүйіз бе?
Dialogue: 0,0:02:12.53,0:02:18.03,Default,NTP,0,0,0,,Күміс мүйіз? Таурус Күмістегідей, жұмбақ данышпан сиқыршы инженер?
Dialogue: 0,0:02:12.60,0:02:13.64,JPDB-ja,,0,0,0,,Күміс мүйіз
Dialogue: 0,0:02:14.20,0:02:17.88,JPDB-ja,,0,0,0,,Сол жұмбақ данышпан сиқыршы Таврдың күмісі Күміс
Dialogue: 0,0:02:18.60,0:02:20.28,Default,NTP,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:02:18.64,0:02:20.10,JPDB-ja,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:02:21.06,0:02:23.78,Default,NTP,0,0,0,,Төрт жапырақ технологиясы бойынша маман!
Dialogue: 0,0:02:21.16,0:02:23.22,JPDB-ja,,0,0,0,,Төрт жапырақ технологиясына ерекше
Dialogue: 0,0:02:23.78,0:02:30.29,Default,NTP,0,0,0,,Шын аты, сыртқы түрі және профилі жұмбақ жасырылған ғажайып CAD инженері!
Dialogue: 0,0:02:23.84,0:02:27.56,JPDB-ja,,0,0,0,,Оның шын аты-жөні, сыртқы түрі және профилі – барлығы жұмбақ.
Dialogue: 0,0:02:27.56,0:02:29.66,JPDB-ja,,0,0,0,,Miracle CAD инженері
Dialogue: 0,0:02:30.98,0:02:35.29,Default,NTP,0,0,0,,Loop Cast жүйесін бірінші болып енгізген бағдарламалау данышпаны!
Dialogue: 0,0:02:31.00,0:02:35.40,JPDB-ja,,0,0,0,,Дүние жүзіндегі бірінші циклдік жүйені жасаған данышпан бағдарламашы
Dialogue: 0,0:02:35.88,0:02:42.37,Default,NTP,0,0,0,,«Күміс мүйіз» - бұл Taurus Silver өзі жасаған мамандандырылған CAD моделінің атауы,
Dialogue: 0,0:02:35.94,0:02:37.50,JPDB-ja,,0,0,0,,Silverhorn дегеніміз не?
Dialogue: 0,0:02:37.78,0:02:42.10,JPDB-ja,,0,0,0,,Taurus Silver - бұл толығымен теңшелген арнайы CAD үлгісінің атауы.
Dialogue: 0,0:02:42.37,0:02:44.81,Default,NTP,0,0,0,,және ол Loop Casting үшін оңтайландырылған!
Dialogue: 0,0:02:42.38,0:02:44.62,JPDB-ja,,0,0,0,,Циклді шығару үшін оңтайландырылған
Dialogue: 0,0:02:45.18,0:02:48.58,Default,NTP,0,0,0,,Бірақ Рин Чан, бұл қосылмайды, солай ма?
Dialogue: 0,0:02:45.22,0:02:47.80,JPDB-ja,,0,0,0,,Бірақ Рин Чан, бұл таңқаларлық емес.
Dialogue: 0,0:02:48.58,0:02:50.81,Default,NTP,0,0,0,,Жоқ, ол қосылмайды.
Dialogue: 0,0:02:48.68,0:02:50.62,JPDB-ja,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:02:51.78,0:02:57.70,Default,NTP,0,0,0,,Loop Cast бағдарламасының мақсаты – дәл сол заклинаның дәйекті шақыруларын іске қосу.
Dialogue: 0,0:02:51.86,0:02:52.82,JPDB-ja,,0,0,0,,Циклді шығару
Dialogue: 0,0:02:53.18,0:02:56.98,JPDB-ja,,0,0,0,,Бұл тек бір сиқырды үздіксіз қосуға арналған.
Dialogue: 0,0:02:57.70,0:03:03.32,Default,NTP,0,0,0,,Түрлі тербелістердің бірнеше толқындарын жасау үшін Loop Cast пайдалану мүмкін емес.
Dialogue: 0,0:02:57.80,0:02:58.40,JPDB-ja,,0,0,0,,Олай болса
Dialogue: 0,0:02:58.86,0:03:03.04,JPDB-ja,,0,0,0,,Әртүрлі жиіліктегі бірнеше толқынды құру мүмкін болмауы керек
Dialogue: 0,0:03:03.82,0:03:09.10,Default,NTP,0,0,0,,Менің ойымша, егер тербеліс айнымалылар ретінде анықталса, мүмкін,
Dialogue: 0,0:03:04.20,0:03:08.54,JPDB-ja,,0,0,0,,Діріл жиілігін анықтайтын бөлікті айнымалы етіп жасасаңыз мүмкін болар еді.
Dialogue: 0,0:03:09.10,0:03:15.21,Default,NTP,0,0,0,,бірақ тербелістерді координаталарымен, қарқындылығымен және ұзақтығымен бірге тағы бір айнымалы ретінде орнату үшін...
Dialogue: 0,0:03:09.22,0:03:12.18,JPDB-ja,,0,0,0,,Ұзақтыққа қосымша қарқындылықты үйлестіреді
Dialogue: 0,0:03:12.42,0:03:15.04,JPDB-ja,,0,0,0,,Діріл жиілігін айнымалыларға түрлендіру кезінде
Dialogue: 0,0:03:17.26,0:03:21.22,JPDB-ja,,0,0,0,,Сіз мұны шынымен істеп жатырмын деп айтасыз ба?
Dialogue: 0,0:03:17.27,0:03:18.21,Default,NTP,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:03:18.97,0:03:21.97,Default,NTP,0,0,0,,сіз дәл осы жерден шығардыңыз ба?
Dialogue: 0,0:03:23.62,0:03:25.09,Default,NTP,0,0,0,,Осы мектепте,
Dialogue: 0,0:03:23.72,0:03:29.54,JPDB-ja,,0,0,0,,Көп айнымалылар өңдеу жылдамдығын, есептеу масштабын және кедергі күшін жақсартады.
Dialogue: 0,0:03:25.09,0:03:29.73,Default,NTP,0,0,0,,көп айнымалылар бағалауға жатпайды... өңдеу жылдамдығы ретінде емес,
Dialogue: 0,0:03:30.24,0:03:34.66,JPDB-ja,,0,0,0,,Бұл мектепте бағаланбайтын элемент.
Dialogue: 0,0:03:30.29,0:03:35.48,Default,NTP,0,0,0,,есептеу шкаласы ретінде де, кедергі қарқындылығы ретінде де емес.
Dialogue: 0,0:03:37.51,0:03:39.03,Default,NTP,0,0,0,,Практикалық емтиханда,
Dialogue: 0,0:03:37.60,0:03:40.28,JPDB-ja,,0,0,0,,Тәжірибелік емтиханда сиқырлы қуатты бағалау
Dialogue: 0,0:03:39.03,0:03:43.38,Default,NTP,0,0,0,,сиқырлы шеберлік ұпайлары емлені шақыру жылдамдығымен анықталады,
Dialogue: 0,0:03:41.08,0:03:44.92,JPDB-ja,,0,0,0,,Сиқырды белсендіру жылдамдығы Сиқырлы формуланың өлшемі
Dialogue: 0,0:03:43.38,0:03:48.95,Default,NTP,0,0,0,,Сиқырлы реттілік ауқымы және мақсатты деректерді қайта жазу күші.
Dialogue: 0,0:03:45.46,0:03:48.48,JPDB-ja,,0,0,0,,Объектінің ақпаратын қайта жазу күшімен анықталады
Dialogue: 0,0:03:49.87,0:03:55.08,Default,NTP,0,0,0,,Түсінемін, тесттер сіздің шынайы қабілеттеріңізді көрсетпесе, солай болады.
Dialogue: 0,0:03:49.92,0:03:50.68,JPDB-ja,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:51.34,0:03:54.90,JPDB-ja,,0,0,0,,Тесттер шынайы қабілетті көрсетпегенде солай бола ма?
Dialogue: 0,0:03:55.51,0:03:58.09,Default,NTP,0,0,0,,Амансың ба, Ханзокун?
Dialogue: 0,0:03:55.52,0:03:57.58,JPDB-ja,,0,0,0,,Ханзо-кун, жақсысың ба?
Dialogue: 0,0:03:59.03,0:04:00.51,Default,NTP,0,0,0,,Менде бәрі жақсы!
Dialogue: 0,0:03:59.06,0:03:59.80,JPDB-ja,,0,0,0,,Жарайды
Dialogue: 0,0:04:04.78,0:04:05.89,Default,NTP,0,0,0,,Шиба-сан?
Dialogue: 0,0:04:04.82,0:04:05.48,JPDB-ja,,0,0,0,,Шиба мырза
Dialogue: 0,0:04:07.62,0:04:08.39,Default,NTP,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:04:07.68,0:04:08.18,JPDB-ja,,0,0,0,,Иә
Dialogue: 0,0:04:08.85,0:04:12.96,Default,NTP,0,0,0,,Менің бұрын айтқаным... непотизм туралы... бұл маған дөрекі болды.
Dialogue: 0,0:04:08.90,0:04:12.58,JPDB-ja,,0,0,0,,Бұған дейін мен өзімшіл болып жатырмын деп дөрекі сөздер айттым.
Dialogue: 0,0:04:14.14,0:04:17.53,Default,NTP,0,0,0,,Үкімі бұлыңғыр болған мен едім.
Dialogue: 0,0:04:14.32,0:04:16.50,JPDB-ja,,0,0,0,,Бұлт көзді мен едім.
Dialogue: 0,0:04:17.53,0:04:18.65,Default,,0,0,0,,Сіз мені кешіресіз деп үміттенемін.
Dialogue: 0,0:04:17.64,0:04:18.36,JPDB-ja,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:04:19.85,0:04:22.73,Default,NTP,0,0,0,,Негізі, мен қатардан шыққан адаммын.
Dialogue: 0,0:04:19.86,0:04:22.30,JPDB-ja,,0,0,0,,Арсыз сөзді айтқан мен едім.
Dialogue: 0,0:04:24.86,0:04:26.62,Default,NTP,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:04:24.92,0:04:25.90,JPDB-ja,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:04:50.48,0:04:53.90,JPDB-ja,,0,0,0,,Енді әртүрлі күтпеген оқиғалар орын алды.
Dialogue: 0,0:04:50.50,0:04:51.02,Default,NTP,0,0,0,,Жарайды,
Dialogue: 0,0:04:51.54,0:04:54.14,Default,NTP,0,0,0,,біз күтпеген жерден жолдан шығып қалдық,
Dialogue: 0,0:04:54.67,0:04:59.02,Default,NTP,0,0,0,,, бірақ біз неге қайта жолға түсіп, Тәртіптік комитеттің штаб-пәтеріне бармаймыз?
Dialogue: 0,0:04:54.68,0:04:58.22,JPDB-ja,,0,0,0,,Бастапқыда жоспарлағандай тәртіптік комитеттің штабына барамыз ба?
Dialogue: 2,0:04:58.73,0:04:59.35,OP Romaji,,0,0,0,fx,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
