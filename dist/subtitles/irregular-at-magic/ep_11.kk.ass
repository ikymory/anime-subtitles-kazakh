Dialogue: 0,0:02:43.73,0:02:44.59,JPDB-ja,,0,0,0,,Өлмеген
Dialogue: 0,0:02:43.93,0:02:45.48,Default,NTP,0,0,0,,Өлмеген.
Dialogue: 0,0:02:45.48,0:02:46.56,Default,NTP,0,0,0,,Бұл керемет болды!
Dialogue: 0,0:02:45.55,0:02:46.37,JPDB-ja,,0,0,0,,Жақсы қол.
Dialogue: 0,0:02:48.27,0:02:54.19,Default,NTP,0,0,0,,Соқыр позициядан сіз нысаналарды өлімге әкелместен бір оқпен залалсыздандырдыңыз.
Dialogue: 0,0:02:48.37,0:02:49.47,JPDB-ja,,0,0,0,,Соқыр позициядан
Dialogue: 0,0:02:49.95,0:02:53.81,JPDB-ja,,0,0,0,,Қарсыласын өлімге әкеліп соқтырмай бір соққымен қабілетсіз етеді.
Dialogue: 0,0:02:55.21,0:02:56.36,Default,NTP,0,0,0,,Бұл мүмкін болатын ең жақсы нәтиже.
Dialogue: 0,0:02:55.25,0:02:56.33,JPDB-ja,,0,0,0,,Ең жақсы нәтиже.
Dialogue: 0,0:02:58.35,0:03:02.17,Default,NTP,0,0,0,,Бірақ сен маған көмекке келмегенде, мен оққа ұшар едім.
Dialogue: 0,0:02:58.46,0:03:01.77,JPDB-ja,,0,0,0,,Бірақ егер Тацуяның қолдауы болмаса, мен атылып кетер едім.
Dialogue: 0,0:03:02.17,0:03:03.45,Default,NTP,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:03:02.19,0:03:02.69,JPDB-ja,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:03:04.17,0:03:06.33,Default,NTP,0,0,0,,Бұл жай ғана гипотеза.
Dialogue: 0,0:03:04.34,0:03:05.81,JPDB-ja,,0,0,0,,Бұл жай ғана болжам.
Dialogue: 0,0:03:06.33,0:03:09.84,Default,NTP,0,0,0,,Сіз өзіңіздің сиқырыңызбен бұл зиянкестерді сәтті басып алдыңыз.
Dialogue: 0,0:03:06.45,0:03:09.01,JPDB-ja,,0,0,0,,Сіз өзіңіздің сиқырыңызбен ұрыны қолға түсірдіңіз.
Dialogue: 0,0:03:09.84,0:03:11.21,Default,NTP,0,0,0,,Бұл маңызды нәрсе.
Dialogue: 0,0:03:09.89,0:03:11.34,JPDB-ja,,0,0,0,,Бұл жалғыз факт
Dialogue: 0,0:03:13.18,0:03:17.21,Default,NTP,0,0,0,,Микихико, сен өзіңді қандай боламын деп елестетесің?
Dialogue: 0,0:03:13.27,0:03:13.85,JPDB-ja,,0,0,0,,Микихико
Dialogue: 0,0:03:14.91,0:03:17.50,JPDB-ja,,0,0,0,,Қалай ойлайсыңдар, жер бетіндегі шынайы форма қандай?
Dialogue: 0,0:03:17.89,0:03:18.84,Default,NTP,0,0,0,,Ал, мен...
Dialogue: 0,0:03:18.01,0:03:18.75,JPDB-ja,,0,0,0,,Бұл...
Dialogue: 0,0:03:19.43,0:03:22.94,Default,NTP,0,0,0,,Қанша қарсы тұрсаң да, олар қаншалықты шебер болса да,
Dialogue: 0,0:03:19.49,0:03:22.46,JPDB-ja,,0,0,0,,Қанша қарсылас болса да, қандай шеберлік болса да
Dialogue: 0,0:03:22.94,0:03:26.75,Default,NTP,0,0,0,,оларды ешкімнің көмегінсіз жеңе аласыз.
Dialogue: 0,0:03:22.98,0:03:25.89,JPDB-ja,,0,0,0,,Сіз ешкімнің қолдауын қажет етпей-ақ жеңе аласыз.
Dialogue: 0,0:03:26.75,0:03:29.60,Default,NTP,0,0,0,,Маған іс-әрекеттеріңізді осындай ұғымға негіздеп жатқаныңызды айтпаңыз.
Dialogue: 0,0:03:26.81,0:03:29.38,JPDB-ja,,0,0,0,,Менің ойымша, бұл стандарт емес.
Dialogue: 0,0:03:31.39,0:03:32.75,Default,NTP,0,0,0,,Ятоны таптың ба?
Dialogue: 0,0:03:31.59,0:03:32.19,JPDB-ja,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:03:33.61,0:03:35.36,Default,NTP,0,0,0,,Мен өзімді осы жерде қайталаймын.
Dialogue: 0,0:03:33.70,0:03:35.25,JPDB-ja,,0,0,0,,Тағы да айтайын
Dialogue: 0,0:03:36.07,0:03:40.69,Default,NTP,0,0,0,,Сен ақымақсың. Неліктен сіз өзіңізді соншалықты дәрежеге түсіресіз?
Dialogue: 0,0:03:36.13,0:03:37.14,JPDB-ja,,0,0,0,,Сен ақымақсың
Dialogue: 0,0:03:37.85,0:03:40.18,JPDB-ja,,0,0,0,,Неліктен сіз өзіңізді сонша жоққа шығаруға тырысасыз?
Dialogue: 0,0:03:42.18,0:03:44.75,Default,NTP,0,0,0,,Айтсам да түсінбейсіңдер.
Dialogue: 0,0:03:42.23,0:03:43.90,JPDB-ja,,0,0,0,,Тацуяға айтсаң да түсінбейді.
Dialogue: 0,0:03:44.75,0:03:47.29,Default,NTP,0,0,0,,Мен бұл туралы енді ештеңе істей алмаймын.
Dialogue: 0,0:03:44.85,0:03:46.63,JPDB-ja,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:03:47.29,0:03:49.33,Default,NTP,0,0,0,,Шындығында, бір жолы болуы мүмкін.
Dialogue: 0,0:03:47.39,0:03:48.61,JPDB-ja,,0,0,0,,Бәлкім, бірдеңе болатын шығар.
Dialogue: 0,0:03:49.94,0:03:55.07,Default,NTP,0,0,0,,Микихико, сізді қызықтыратын нәрсе сенің жылдамдығың емес пе?
Dialogue: 0,0:03:50.05,0:03:50.54,JPDB-ja,,0,0,0,,Микихико
Dialogue: 0,0:03:51.31,0:03:54.39,JPDB-ja,,0,0,0,,Сізді алаңдататын нәрсе - сиқырлы белсендіру жылдамдығы, солай ма?
Dialogue: 0,0:03:55.07,0:03:56.69,Default,NTP,0,0,0,,Оны Эрикадан алдың ба?
Dialogue: 0,0:03:55.13,0:03:56.11,JPDB-ja,,0,0,0,,Сіз Эрикадан сұрадыңыз ба?
Dialogue: 0,0:03:56.69,0:03:57.34,Default,NTP,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:03:56.71,0:03:57.21,JPDB-ja,,0,0,0,,Жоқ
Dialogue: 0,0:03:57.34,0:03:58.93,Default,NTP,0,0,0,,Сонда сен қайдан білдің?
Dialogue: 0,0:03:57.63,0:03:58.46,JPDB-ja,,0,0,0,,Сонда неге?
Dialogue: 0,0:03:58.93,0:04:01.48,Default,NTP,0,0,0,,Сиқырларыңызда артық құрамдас бөліктер тым көп.
Dialogue: 0,0:03:59.02,0:04:01.07,JPDB-ja,,0,0,0,,Сіздің техникаңызда тым көп шығын бар.
Dialogue: 0,0:04:01.48,0:04:02.22,Default,NTP,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:04:01.65,0:04:02.07,JPDB-ja,,0,0,0,,Не?
Dialogue: 0,0:04:02.89,0:04:05.01,Default,NTP,0,0,0,,Бұл сіздің талантыңызда емес.
Dialogue: 0,0:04:02.98,0:04:04.45,JPDB-ja,,0,0,0,,Сіздің қабілетіңіз емес
Dialogue: 0,0:04:05.01,0:04:07.72,Default,NTP,0,0,0,,Менің айтқаным, мәселенің өзі сиқырдың өзінде.
Dialogue: 0,0:04:05.11,0:04:07.38,JPDB-ja,,0,0,0,,Ол хирургиялық процедураның өзінде ақау бар екенін айтты.
Dialogue: 0,0:04:07.72,0:04:12.83,Default,NTP,0,0,0,,Менің заклинаниелерім Йошида жанұясының жылдар мен жылдар бойы үздіксіз жетілдірулерінің нәтижесі!
Dialogue: 0,0:04:07.95,0:04:09.13,JPDB-ja,,0,0,0,,Менің техникам
Dialogue: 0,0:04:09.21,0:04:12.54,JPDB-ja,,0,0,0,,Йошида отбасы осы жылдар ішінде көптеген жақсартуларға қол жеткізді.
Dialogue: 0,0:04:12.83,0:04:14.95,JPDB-ja,,0,0,0,,Бір-екі рет көрген соң
Dialogue: 0,0:04:12.83,0:04:14.96,Default,NTP,0,0,0,,Сіз оларды бір-екі рет көрдіңіз, сонда сіз кімсіз...?
Dialogue: 0,0:04:14.95,0:04:16.13,JPDB-ja,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:04:14.96,0:04:16.23,Default,NTP,0,0,0,,Бірақ мен айта аламын.
Dialogue: 0,0:04:16.83,0:04:22.61,Default,NTP,0,0,0,,Оларды «көру» арқылы мен активтендіру ретінің мазмұнын оқып, сиқырлы тізбекті талдай аламын.
Dialogue: 0,0:04:16.93,0:04:19.91,JPDB-ja,,0,0,0,,Іске қосу рәсімінің мазмұнын қарап отырып оқи аламын.
Dialogue: 0,0:04:20.41,0:04:22.34,JPDB-ja,,0,0,0,,Сиқырлы формулаларды талдай алады
Dialogue: 0,0:04:23.49,0:04:26.37,Default,NTP,0,0,0,,Сіз мұны істей алмайсыз...
Dialogue: 0,0:04:23.51,0:04:26.23,JPDB-ja,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:04:26.79,0:04:29.44,Default,NTP,0,0,0,,Маған сенуге мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:04:26.93,0:04:28.93,JPDB-ja,,0,0,0,,Адамдарды сізге сенуге мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:04:29.44,0:04:30.54,Default,NTP,0,0,0,,Тацуя...
Dialogue: 0,0:04:29.51,0:04:29.97,JPDB-ja,,0,0,0,,Тацуя
Dialogue: 0,0:04:30.51,0:04:32.79,JPDB-ja,,0,0,0,,Әйтеуір, енді мына жігіттермен айналысуымыз керек.
Dialogue: 0,0:04:30.54,0:04:31.12,Default,NTP,0,0,0,,Қалай болғанда да,
Dialogue: 0,0:04:31.54,0:04:33.54,Default,NTP,0,0,0,,дәл қазір біз бұл жігіттерге қамқорлық жасауымыз керек.
Dialogue: 0,0:04:33.54,0:04:37.30,Default,NTP,0,0,0,,Мен күзетте тұрамын, сондықтан күзетшілерді осында түсіре аласыз ба?
Dialogue: 0,0:04:33.66,0:04:34.75,JPDB-ja,,0,0,0,,Өйткені мен сені бақылап отырамын
Dialogue: 0,0:04:35.05,0:04:36.54,JPDB-ja,,0,0,0,,Күзетшіні шақыра аласыз ба?
Dialogue: 0,0:04:37.30,0:04:38.69,Default,NTP,0,0,0,,О... әрине.
Dialogue: 0,0:04:43.47,0:04:45.97,Default,NTP,0,0,0,,Сіз бұл кеңеспен ешқандай жұдырық көтерген жоқсыз, солай ма?
Dialogue: 0,0:04:43.65,0:04:45.81,JPDB-ja,,0,0,0,,Бұл өте кешірімсіз кеңес.
Dialogue: 0,0:04:47.19,0:04:48.35,Default,NTP,0,0,0,,Майор!
Dialogue: 0,0:04:47.26,0:04:47.65,JPDB-ja,,0,0,0,,Майор
Dialogue: 0,0:04:52.70,0:04:56.10,Default,NTP,0,0,0,,Басқаларға немқұрайлы қарайтын адам үшін бұл ерекше, Арнайы офицер.
Dialogue: 0,0:04:52.79,0:04:55.38,JPDB-ja,,0,0,0,,Арнайы лейтенанттың басқаларға немқұрайлы қарауы ерекше.
Dialogue: 0,0:04:56.10,0:04:57.98,Default,NTP,0,0,0,,«Елсіз» шектен шығып жатыр.
Dialogue: 0,0:04:56.27,0:04:57.63,JPDB-ja,,0,0,0,,Елеусіздік асыра сілтеу болар еді
Dialogue: 0,0:04:58.63,0:05:00.54,Default,NTP,0,0,0,,Ол сенің көңіліңе әсер етті ме?
Dialogue: 0,0:04:58.73,0:04:59.90,JPDB-ja,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:05:00.54,0:05:04.58,Default,NTP,0,0,0,,Өйткені, бұл бала сіздің ішкі күресіңізбен бөлісетін сияқты.
Dialogue: 0,0:05:00.61,0:05:04.03,JPDB-ja,,0,0,0,,Бұл баланың да сен сияқты қиыншылықтары бар сияқты.
Dialogue: 0,0:05:04.58,0:05:07.99,Default,NTP,0,0,0,,Мен бұл деңгейдегі күресті бітірдім.
Dialogue: 0,0:05:04.67,0:05:07.59,JPDB-ja,,0,0,0,,Егер сіз бұл деңгейге алаңдасаңыз, мен бітіргенмін.
Dialogue: 0,0:05:07.99,0:05:11.24,Default,NTP,0,0,0,,Басқаша айтқанда, оның қандай болғаны есіңізде ме?
Dialogue: 0,0:05:08.27,0:05:10.70,JPDB-ja,,0,0,0,,Бұл сіздің есіңізде екенін білдіре ме?
Dialogue: 4,0:05:14.51,0:05:18.59,Default,NTP,0,0,0,,Ақырында, сиқырлы шеберліктердің ұлттық сиқырлы орта мектебінің ізгі ниет турнирін ашатын кез келді...
Dialogue: 0,0:05:14.62,0:05:18.25,JPDB-ja,,0,0,0,,Соңында, Ұлттық сиқырлы орта мектептің достық сиқыршылар сайысы
Dialogue: 0,0:05:14.83,0:05:19.21,Signs,,0,0,0,,2095-08-03 Тоғыз мектеп байқауының өтетін орны
Dialogue: 0,0:05:16.92,0:05:20.75,Signs,,0,0,0,,2095-08-03
Dialogue: 0,0:05:16.92,0:05:20.75,Signs,,0,0,0,,2095-08-03
Dialogue: 0,0:05:16.92,0:05:20.75,Signs,,0,0,0,,Ұлттық сиқырлы орта мектеп достығы
Dialogue: 4,0:05:18.59,0:05:20.75,Default,NTP,0,0,0,,Тоғыз мектеп байқауы ретінде танымал.
Dialogue: 0,0:05:18.65,0:05:20.65,JPDB-ja,,0,0,0,,Бұл «Тоғыз мектеп» турнирінің басы.
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,2095 Ұлттық сиқырлы орта мектеп достық сиқыршылар сайысы
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Ашылу салтанаты
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Бірінші орта мектеп
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Екінші орта мектеп
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Үшінші орта мектеп
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Төртінші орта мектеп
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Бесінші орта мектеп
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Алтыншы орта мектеп
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Жетінші орта мектеп
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Сегізінші орта мектеп
Dialogue: 0,0:05:20.75,0:05:26.51,Signs,,0,0,0,,Тоғызыншы орта мектеп
Dialogue: 4,0:05:21.47,0:05:23.44,Default,NTP,0,0,0,,Биылғы турнир әдеттегі форматта өтеді...
Dialogue: 0,0:05:21.54,0:05:25.46,JPDB-ja,,0,0,0,,Бұл турнир әдеттегідей өткізіледі, негізгі турнир және жаңа ойыншылар турнирі әрқайсысы 5 күнде өткізіледі.
Dialogue: 4,0:05:23.44,0:05:28.58,Default,NTP,0,0,0,,5 күндік ресми матчтар мен жаңа ойыншылар жарыстары, барлығы он күн.
Dialogue: 0,0:05:25.74,0:05:27.97,JPDB-ja,,0,0,0,,Барлығы 10 күн өткізіледі.
Dialogue: 4,0:05:28.58,0:05:31.38,Default,NTP,0,0,0,,Биыл баршаның назары Бірінші орта мектепке ауды.
Dialogue: 0,0:05:28.59,0:05:32.46,JPDB-ja,,0,0,0,,Биылғы жылдың басты назары Ичи орта мектебінің үшінші рет қатарынан чемпиондық атағын жеңе ала ма, жоқ па деген сұрақ.
Dialogue: 0,0:05:31.38,0:05:35.77,Default,NTP,0,0,0,,Олар үшінші рет атағын ала ма, әлде Үшінші орта мектеп бұл жолды бұза ма?
Dialogue: 0,0:05:32.78,0:05:35.65,JPDB-ja,,0,0,0,,Немесе Үшінші орта мектеп олардың қатарынан титулдарды жеңіп алуына кедергі жасай ма?
Dialogue: 0,0:05:35.77,0:05:37.52,Notes,,0,0,0,,3 тамыз Қыздар арасындағы шайқас тақтасының іріктеу матчтары өтетін орын
Dialogue: 0,0:05:41.19,0:05:43.98,Signs,,0,0,0,,Жауынгерлік тақтаның іріктеу өткізілетін орны
Dialogue: 0,0:05:42.12,0:05:44.69,Default,NTP,0,0,0,,Хонока, физикалық жағдайыңыз қалай?
Dialogue: 0,0:05:42.18,0:05:44.37,JPDB-ja,,0,0,0,,Хонока, денсаулығыңды күтіп жүрсің бе?
Dialogue: 0,0:05:45.15,0:05:48.41,JPDB-ja,,0,0,0,,Жарайды, мен дене жаттығуларын жалғастырдым.
Dialogue: 0,0:05:45.15,0:05:48.88,Default,NTP,0,0,0,,Менде бәрі жақсы. Мен шыдамдылықты арттыру үшін жаттығамын,
Dialogue: 0,0:05:48.88,0:05:51.82,Default,NTP,0,0,0,,және мен де көбірек ұйықтап жатырмын.
Dialogue: 0,0:05:49.01,0:05:51.31,JPDB-ja,,0,0,0,,Мен де көбірек ұйықтауға тырысамын.
Dialogue: 0,0:05:51.82,0:05:54.91,Default,NTP,0,0,0,,Бұл күндері Гоноканың бұлшық еті артып келеді, білесіз бе!
Dialogue: 0,0:05:51.94,0:05:54.57,JPDB-ja,,0,0,0,,Хоноканың бұлшық еті көп болды.
Dialogue: 0,0:05:54.91,0:05:56.86,Default,NTP,0,0,0,,Жүр, олай айтпа, Миюки!
Dialogue: 0,0:05:55.01,0:05:56.51,JPDB-ja,,0,0,0,,Жоқ, тоқтат, Миюки.
Dialogue: 0,0:05:56.82,0:05:59.57,JPDB-ja,,0,0,0,,Менің анау мачо әйел болайын деген ниетім жоқ.
Dialogue: 0,0:05:56.86,0:06:00.42,Default,NTP,0,0,0,,Мен мұндай мачо әйелге айналуды жоспарлап отырған жоқпын, жарай ма?
Dialogue: 0,0:06:01.11,0:06:04.03,Default,NTP,0,0,0,,Қараңыз! Қазір маған Тацуя-санның өзі күледі!
Dialogue: 0,0:06:01.25,0:06:03.78,JPDB-ja,,0,0,0,,Қарашы, Тацуя-сан маған күлді.
Dialogue: 0,0:06:04.03,0:06:07.53,Default,NTP,0,0,0,,Оның күлгенінің бірден-бір себебі, сіз оны айтудың біртүрлі әдісін таңдадыңыз.
Dialogue: 0,0:06:04.10,0:06:07.15,JPDB-ja,,0,0,0,,Менің күлгенімнің жалғыз себебі, Хоноканың айтқаны күлкілі болды.
Dialogue: 0,0:06:07.53,0:06:08.80,Default,NTP,0,0,0,,Енді қосыласың ба, Шидзуку?
Dialogue: 0,0:06:07.62,0:06:08.62,JPDB-ja,,0,0,0,,Тамшыға
Dialogue: 0,0:06:09.67,0:06:12.88,Default,NTP,0,0,0,,Жақсы! Мен бәрібір біртүрлімін.
Dialogue: 0,0:06:09.75,0:06:12.67,JPDB-ja,,0,0,0,,Жақсы, мен бәрібір топтан шықтым.
Dialogue: 0,0:06:12.88,0:06:16.84,Default,NTP,0,0,0,,Екеуіңнен айырмашылығым мен Тацуя-санға менің оқиғаларымды қарай алмаймын.
Dialogue: 0,0:06:12.93,0:06:16.21,JPDB-ja,,0,0,0,,Тацуя екеуміз сияқты матчты да көре алмайды.
Dialogue: 0,0:06:16.84,0:06:20.56,Default,NTP,0,0,0,,Жарайды, бірақ мен Мираж Батта сіз үшін дәл реттеуді жасаймын.
Dialogue: 0,0:06:16.94,0:06:17.98,JPDB-ja,,0,0,0,,Мираж Бат
Dialogue: 0,0:06:17.98,0:06:20.41,JPDB-ja,,0,0,0,,Мен Хоноканың реттеулеріне де жауапты боламын.
Dialogue: 0,0:06:21.13,0:06:24.11,Default,NTP,0,0,0,,Бірақ мен сенен менің Battle Board матчыма қатысуды сұрай алмаймын, солай ма?
Dialogue: 0,0:06:21.21,0:06:23.66,JPDB-ja,,0,0,0,,Сіз шайқас тақтасын басқармайсыз, солай ма?
Dialogue: 0,0:06:24.11,0:06:28.32,Default,NTP,0,0,0,,Миюки мен Шидзуку екі оқиға үшін де сізді алады.
Dialogue: 0,0:06:24.21,0:06:27.81,JPDB-ja,,0,0,0,,Тацуя Миюкиге де, Шидзукуға да жауапты.
Dialogue: 0,0:06:29.06,0:06:31.34,Default,NTP,0,0,0,,Бірақ мен сіздің жаттығу сабақтарыңызға қатыстым,
Dialogue: 0,0:06:29.06,0:06:32.87,JPDB-ja,,0,0,0,,Осыған байланысты біз бірге жаттығып, стратегияларды бірге ойластырдық.
Dialogue: 0,0:06:31.34,0:06:35.33,Default,NTP,0,0,0,,және біз сіздің шайқас жоспарыңызды бірге жасадық, сондықтан сіз ешбір жағдайда қалыспайсыз...
Dialogue: 0,0:06:33.22,0:06:35.15,JPDB-ja,,0,0,0,,Мен сені топтан қалдырмаймын...
Dialogue: 0,0:06:35.31,0:06:36.11,JPDB-ja,,0,0,0,,Тацуя-сан
Dialogue: 0,0:06:35.33,0:06:39.58,Default,NTP,0,0,0,,Тацуя-сан, бұл Хонока-санның саған айтқысы келгені емес.
Dialogue: 0,0:06:36.51,0:06:39.62,JPDB-ja,,0,0,0,,Бұл Хоноканың айтып тұрғаны емес.
Dialogue: 0,0:06:39.95,0:06:43.71,Default,NTP,0,0,0,,Онии-сама... Шынымен де, менің ойымша, сіз тым түсініксіз болып тұрсыз.
Dialogue: 0,0:06:39.98,0:06:43.53,JPDB-ja,,0,0,0,,Аға, меніңше, сіз тым сезімталсыз.
Dialogue: 0,0:06:43.71,0:06:46.09,Default,NTP,0,0,0,,Эврика! Тацуя-санда сіз ешқашан білмеген кемшілік!
Dialogue: 0,0:06:43.83,0:06:46.05,JPDB-ja,,0,0,0,,Тацуя-кунның таңғаларлық әлсіздігі анықталды
Dialogue: 0,0:06:46.09,0:06:47.46,Default,NTP,0,0,0,,Толық қаттылық?
Dialogue: 0,0:06:46.34,0:06:47.37,JPDB-ja,,0,0,0,,Пак Нен Ин?
Dialogue: 0,0:06:53.71,0:06:55.60,Default,NTP,0,0,0,,Ресми әйелдер шайқас кеңесі шарасына қош келдіңіз.
Dialogue: 0,0:06:53.77,0:06:55.61,JPDB-ja,,0,0,0,,Негізгі турнир әйелдер шайқас тақтасы
Dialogue: 0,0:06:55.60,0:06:58.60,Signs,,0,0,0,,Қыздар арасындағы жекпе-жек тақтасының үшінші іріктеу жарысы
Dialogue: 0,0:06:55.60,0:06:58.60,Signs,,0,0,0,,Мари Ватанабе
Dialogue: 0,0:06:55.60,0:06:58.60,Signs,,0,0,0,,Бірінші орта мектеп
Dialogue: 0,0:06:55.60,0:06:58.60,Signs,,0,0,0,,Бірінші орта мектеп
Dialogue: 0,0:06:55.60,0:06:58.60,Signs,,0,0,0,,Готу Хибики
Dialogue: 0,0:06:55.60,0:06:58.60,Signs,,0,0,0,,Төртінші орта мектеп
Dialogue: 0,0:06:55.97,0:06:58.60,Default,NTP,0,0,0,,Жақында сынақтардың үшінші матчы басталады.
Dialogue: 0,0:06:56.06,0:06:58.30,JPDB-ja,,0,0,0,,Жақында үшінші іріктеу матчы басталады
Dialogue: 0,0:06:59.10,0:07:01.85,Default,NTP,0,0,0,,Спортшылар, орындарыңызды алыңыздар.
Dialogue: 0,0:06:59.14,0:07:01.21,JPDB-ja,,0,0,0,,Ойыншылар өздеріне белгіленген орындарды алуы керек.
Dialogue: 0,0:07:04.41,0:07:06.86,Default,NTP,0,0,0,,Иә! Ол бұрынғыдай мылқау...
Dialogue: 0,0:07:04.46,0:07:06.74,JPDB-ja,,0,0,0,,Уау, әлі де бастық әйел.
Dialogue: 0,0:07:08.61,0:07:12.11,Default,NTP,0,0,0,,Бірінші орта мектеп, үшінші курс, Мари Ватанабе ханым.
Dialogue: 0,0:07:08.61,0:07:12.11,Signs,,0,0,0,,Қыздар арасындағы жекпе-жек тақтасының үшінші іріктеу жарысы
Dialogue: 0,0:07:08.74,0:07:11.75,JPDB-ja,,0,0,0,,Мари Ватанабе, 3 курс, Даиичи орта мектебі
Dialogue: 0,0:07:12.81,0:07:15.19,JPDB-ja,,0,0,0,,Мари
Dialogue: 0,0:07:12.81,0:07:16.08,Default,NTP,0,0,0,,Мари!
Dialogue: 0,0:07:16.39,0:07:19.01,Default,NTP,0,0,0,,Оның адал жанкүйерлері бар екенін көріп тұрмын.
Dialogue: 0,0:07:16.42,0:07:18.49,JPDB-ja,,0,0,0,,Сіздің жанкүйерлеріңіз көп.
Dialogue: 0,0:07:19.01,0:07:20.65,Default,NTP,0,0,0,,Бұл түсінікті.
Dialogue: 0,0:07:19.07,0:07:22.70,JPDB-ja,,0,0,0,,Түсінген сияқтымын, Отанабе-сенпай салқын.
Dialogue: 0,0:07:20.65,0:07:23.71,Default,NTP,0,0,0,,Өйткені, Ватанабе ханым өте керемет.
Dialogue: 0,0:07:24.57,0:07:25.50,JPDB-ja,,0,0,0,,Сіздің белгіңізде
Dialogue: 0,0:07:24.57,0:07:26.21,Default,NTP,0,0,0,,Сіздің белгіңізде...
Dialogue: 0,0:07:32.85,0:07:34.45,Default,NTP,0,0,0,,Өзін-өзі жою заклинамасы?
Dialogue: 0,0:07:32.97,0:07:34.25,JPDB-ja,,0,0,0,,Суицид тактикасы?
Dialogue: 0,0:07:34.45,0:07:38.56,Default,NTP,0,0,0,,Ол үлкен толқын жасап, басқа қатысушыларды қуып жібермек болған шығар.
Dialogue: 0,0:07:34.53,0:07:35.07,JPDB-ja,,0,0,0,,Мүмкін
Dialogue: 0,0:07:35.53,0:07:38.58,JPDB-ja,,0,0,0,,Менің ойымша, олар үлкен толқын жасап, басқа ойыншылардың мазасын алмақ болды.
Dialogue: 0,0:07:38.56,0:07:40.06,Default,NTP,0,0,0,,Эй, олар ойынға қайта оралды!
Dialogue: 0,0:07:38.75,0:07:40.06,JPDB-ja,,0,0,0,,Әй, жағдай көтерілді.
Dialogue: 0,0:07:46.06,0:07:49.82,Default,NTP,0,0,0,,Қозғалыс сиқырын көп тарату кезінде күшейту магиясын қолдану, иә?
Dialogue: 0,0:07:46.41,0:07:49.74,JPDB-ja,,0,0,0,,Шынықтыру магиясын қолдану және қозғалыс магиясын көп тарату?
Dialogue: 0,0:07:50.26,0:07:53.07,Default,NTP,0,0,0,,Сиқырды күшейту? Ол нені нығайтады?
Dialogue: 0,0:07:50.29,0:07:51.18,JPDB-ja,,0,0,0,,Шынықтыру сиқыры?
Dialogue: 0,0:07:51.81,0:07:52.93,JPDB-ja,,0,0,0,,Сіз нені емдеп жатырсыз?
Dialogue: 0,0:07:53.72,0:07:58.83,Default,NTP,0,0,0,,Ол құлап қалмас үшін өзінің салыстырмалы орнын тақтаға бекітеді.
Dialogue: 0,0:07:53.79,0:07:54.98,JPDB-ja,,0,0,0,,Тақтадан құлап кетпеңіз
Dialogue: 0,0:07:55.45,0:07:57.95,JPDB-ja,,0,0,0,,Сіз бен тақтаның арасындағы салыстырмалы орын бекітілген.
Dialogue: 0,0:07:59.21,0:08:03.28,Default,NTP,0,0,0,,Күшейткіш сиқыр затты күшейтуге арналған заклинание емес.
Dialogue: 0,0:07:59.30,0:08:02.63,JPDB-ja,,0,0,0,,Шынықтыру магиясы заттардың беріктігін арттыратын сиқыр емес.
Dialogue: 0,0:08:03.28,0:08:06.30,Default,NTP,0,0,0,,Бұл компоненттердің салыстырмалы орнын бекітуге арналған сиқыр.
Dialogue: 0,0:08:03.39,0:08:05.35,JPDB-ja,,0,0,0,,Бөлшектердің өзара орналасуын бекітетін сиқыр.
Dialogue: 0,0:08:06.30,0:08:08.34,Default,NTP,0,0,0,,Сіз мұны түсінесіз, солай емес пе?
Dialogue: 0,0:08:06.45,0:08:07.71,JPDB-ja,,0,0,0,,Сіз мұны түсінесіз, солай ма?
Dialogue: 0,0:08:08.34,0:08:10.59,Default,NTP,0,0,0,,Иә, иә, өйткені мен оны өзім қолданамын.
Dialogue: 0,0:08:08.43,0:08:10.27,JPDB-ja,,0,0,0,,Себебі мен оны шынымен қолданамын.
Dialogue: 0,0:08:11.02,0:08:15.59,Default,NTP,0,0,0,,Ватанабе ханым өзін және тақтасын бір құрамдас бөліктен тұратын бір нысанға айналдырды,
Dialogue: 0,0:08:11.13,0:08:12.05,JPDB-ja,,0,0,0,,Ватанабе Сенпай
Dialogue: 0,0:08:12.58,0:08:15.62,JPDB-ja,,0,0,0,,Сіз және тақта бір заттың бөліктері ретінде
Dialogue: 0,0:08:16.27,0:08:19.35,Default,NTP,0,0,0,,және осы заклинание арқылы ол өзінің салыстырмалы орнын бекітеді.
Dialogue: 0,0:08:16.31,0:08:18.89,JPDB-ja,,0,0,0,,Өзінің салыстырмалы орнын бекітетін сиқырды орындайды
Dialogue: 0,0:08:19.87,0:08:24.11,Default,NTP,0,0,0,,Және ол жалғыз нысан ретінде өзіне және тақтаға Қозғалыс сиқырын құйып жатыр.
Dialogue: 0,0:08:19.94,0:08:22.26,JPDB-ja,,0,0,0,,Ал сен және тақта бір адамсың
Dialogue: 0,0:08:22.41,0:08:23.57,JPDB-ja,,0,0,0,,Қозғалыс сиқыры
Dialogue: 0,0:08:24.11,0:08:25.95,Default,NTP,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:08:25.95,0:08:28.36,Default,NTP,0,0,0,,Дегенмен, бұл қызықты қолданба...
Dialogue: 0,0:08:26.13,0:08:28.19,JPDB-ja,,0,0,0,,Бірақ бұл қызықты қолдану.
Dialogue: 0,0:08:29.37,0:08:31.74,Default,NTP,0,0,0,,Демек, ол Vibration Magic қолданбасын да пайдаланады ма?
Dialogue: 0,0:08:29.43,0:08:31.49,JPDB-ja,,0,0,0,,Сіз сондай-ақ діріл сиқырын қолданасыз ба?
Dialogue: 0,0:08:32.06,0:08:36.74,Default,NTP,0,0,0,,Әсерлі. Ол сиқырлы заклинаниелердің үш-төрт түрін үздіксіз жасайды.
Dialogue: 0,0:08:32.11,0:08:32.66,JPDB-ja,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:08:33.55,0:08:36.87,JPDB-ja,,0,0,0,,Әрқашан сиқырдың үш-төрт түрін көп тарату.
Dialogue: 0,0:08:46.76,0:08:48.20,Default,NTP,0,0,0,,Ол өте стратег.
Dialogue: 0,0:08:46.82,0:08:47.81,JPDB-ja,,0,0,0,,Ол тактик.
Dialogue: 0,0:08:48.20,0:08:49.96,Default,NTP,0,0,0,,Жоқ, ол жай ғана жақсы адам емес.
Dialogue: 0,0:08:48.25,0:08:49.85,JPDB-ja,,0,0,0,,Оның мінезі нашар.
Dialogue: 0,0:08:49.96,0:08:53.97,Signs,,0,0,0,,Қыздар арасындағы жекпе-жек тақтасының үшінші іріктеу жарысы
Dialogue: 0,0:08:50.77,0:08:52.56,Default,NTP,0,0,0,,Кімнің бірінші келетінін білеміз.
Dialogue: 0,0:08:50.85,0:08:52.03,JPDB-ja,,0,0,0,,Бірінші орын анықталды.
Dialogue: 0,0:08:52.56,0:08:53.97,Default,NTP,0,0,0,,Оқу, оқу
Dialogue: 0,0:08:58.95,0:09:02.06,Default,NTP,0,0,0,,Майор Казама, сізге қонақ келді.
Dialogue: 0,0:08:59.05,0:09:01.37,JPDB-ja,,0,0,0,,Майор Казама, сіз осындасыз.
Dialogue: 0,0:09:02.06,0:09:03.02,Default,NTP,0,0,0,,Кіріңіз.
Dialogue: 0,0:09:02.14,0:09:02.42,JPDB-ja,,0,0,0,,Қою
Dialogue: 0,0:09:05.25,0:09:07.17,Default,NTP,0,0,0,,Онда оны киемін!
Dialogue: 0,0:09:05.33,0:09:05.97,JPDB-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:07.17,0:09:08.27,Default,NTP,0,0,0,,Бақыт Құдайы деп танылған адамның адасқан заттарды жинаушы болуы – әрі сиқыршы!
Dialogue: 0,0:09:07.22,0:09:07.83,JPDB-ja,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:09:08.67,0:09:10.15,Default,NTP,0,0,0,,Сәлем, отырыңыз.
Dialogue: 0,0:09:08.75,0:09:09.39,JPDB-ja,,0,0,0,,Ал, көбейтіңдер.
Dialogue: 0,0:09:10.15,0:09:12.65,Default,NTP,0,0,0,,Жоқ, мен мұнда жақсымын.
Dialogue: 0,0:09:10.45,0:09:12.35,JPDB-ja,,0,0,0,,Жоқ, мен осындамын
Dialogue: 0,0:09:13.15,0:09:21.34,Default,NTP,0,0,0,,Тацуя, біз сізді бүгін арнайы офицер Рюуя Оогуро, стратегиялық деңгейдегі сиқыршы ретінде шақырған жоқпыз.
Dialogue: 0,0:09:13.21,0:09:14.02,JPDB-ja,,0,0,0,,Тацуя-кун
Dialogue: 0,0:09:14.77,0:09:19.75,JPDB-ja,,0,0,0,,Бүгін біз сізді ``Стратегиялық кластағы сиқыршы, арнайы лейтенант Тацуя Дайкоку'' ретінде таныстырамыз.
Dialogue: 0,0:09:19.75,0:09:20.99,JPDB-ja,,0,0,0,,Шақырылмаған
Dialogue: 0,0:09:21.34,0:09:25.04,Default,NTP,0,0,0,,Біз сізді досымыз Шиба Тацуя ретінде шақырдық.
Dialogue: 0,0:09:21.47,0:09:24.90,JPDB-ja,,0,0,0,,Біз сізді «Тацуя Шиба» досымыз ретінде шақырдық.
Dialogue: 0,0:09:25.72,0:09:29.77,Default,NTP,0,0,0,,Егер сіз бізбен бірге рәсімде болсаңыз, біз не істерімізді білмейміз.
Dialogue: 0,0:09:25.82,0:09:28.97,JPDB-ja,,0,0,0,,Көп тыйсаң, бәлеге қаламыз.
Dialogue: 0,0:09:29.77,0:09:31.04,Default,NTP,0,0,0,,Капитан Санада...
Dialogue: 0,0:09:29.87,0:09:30.77,JPDB-ja,,0,0,0,,Капитан Санада
Dialogue: 0,0:09:32.07,0:09:35.05,Default,NTP,0,0,0,,Өте жақсы. Кешіріңіз.
Dialogue: 0,0:09:32.11,0:09:34.19,JPDB-ja,,0,0,0,,Түсіндім, кешіріңіз.
Dialogue: 0,0:09:41.21,0:09:43.27,Default,NTP,0,0,0,,Шыныаяқтар рухты түсірмейді,
Dialogue: 0,0:09:41.26,0:09:43.21,JPDB-ja,,0,0,0,,Бұл шыныаяқпен жұмыс істемейді.
Dialogue: 0,0:09:44.36,0:09:46.39,Default,NTP,0,0,0,,бірақ тост ше?
Dialogue: 0,0:09:44.41,0:09:45.58,JPDB-ja,,0,0,0,,Біз тост ішейік пе?
Dialogue: 0,0:09:47.11,0:09:48.65,Default,NTP,0,0,0,,Өткен түнгі оқиға туралы,
Dialogue: 0,0:09:47.26,0:09:49.73,JPDB-ja,,0,0,0,,Кеше түнгі оқиғаға қатысты ұрының жеке басы
Dialogue: 0,0:09:48.65,0:09:53.40,Default,NTP,0,0,0,,Бұл зиянкестердің мен сізге өткен күні айтқан Бассыз Айдаһарлармен бірге екеніне күмән жоқ.
Dialogue: 0,0:09:49.91,0:09:53.19,JPDB-ja,,0,0,0,,Бұл мен бұрын айтқан басы жоқ айдаһар.
Dialogue: 0,0:09:53.96,0:09:57.00,Default,NTP,0,0,0,,Сіз күдіктенгендей, олар ҰҚК-ны нысанаға алып отыр ма?
Dialogue: 0,0:09:54.02,0:09:56.29,JPDB-ja,,0,0,0,,Мақсат әлі де тоғыз мектеп турнирі ме?
Dialogue: 0,0:09:57.00,0:09:58.45,Default,NTP,0,0,0,,Бұл әлі де зерттелуде.
Dialogue: 0,0:09:57.05,0:10:00.42,JPDB-ja,,0,0,0,,Біз қазір тексеріп жатырмыз. Мұны білген соң сізге хабарлаймыз.
Dialogue: 0,0:09:59.15,0:10:01.57,Default,NTP,0,0,0,,Біз білгенде сізге хабарлаймын.
Dialogue: 0,0:10:01.57,0:10:02.69,Default,NTP,0,0,0,,Өтінемін.
Dialogue: 0,0:10:01.73,0:10:02.42,JPDB-ja,,0,0,0,,Өтінемін
Dialogue: 0,0:10:02.69,0:10:05.45,Default,NTP,0,0,0,,Сонда да сенің дәл сол жерде болғаныңа таң қалдым.
Dialogue: 0,0:10:02.74,0:10:05.47,JPDB-ja,,0,0,0,,Қалай болғанда да, мен оқиға орнында жиі болдым.
Dialogue: 0,0:10:06.14,0:10:07.96,Default,NTP,0,0,0,,Сіз бірдеңе іздеп жүрдіңіз бе?
Dialogue: 0,0:10:06.26,0:10:07.79,JPDB-ja,,0,0,0,,Мүмкін сіз күзетте болған шығарсыз?
Dialogue: 0,0:10:08.34,0:10:12.38,Default,NTP,0,0,0,,Мен серуендеп бара жатқанымда, олардың бар екенін байқадым, бәрі осы.
Dialogue: 0,0:10:08.39,0:10:11.73,JPDB-ja,,0,0,0,,Мен серуендеп бара жатқанымда кездейсоқ белгіге түстім.
Dialogue: 0,0:10:12.38,0:10:14.75,Default,NTP,0,0,0,,Осындай кеш уақытта?
Dialogue: 0,0:10:12.51,0:10:13.94,JPDB-ja,,0,0,0,,Осы кешке дейін?
Dialogue: 0,0:10:14.75,0:10:18.66,Default,NTP,0,0,0,,Мен АЖО-ны матчтар үшін дәл баптадым.
Dialogue: 0,0:10:14.89,0:10:17.70,JPDB-ja,,0,0,0,,Себебі мен CAD бәсекелестігін реттеп отырдым.
Dialogue: 0,0:10:18.66,0:10:19.97,Default,NTP,0,0,0,,Сіздің әріптестеріңіз...
Dialogue: 0,0:10:18.79,0:10:22.17,JPDB-ja,,0,0,0,,«Күміс» туралы әріптестерің біле ме?
Dialogue: 0,0:10:20.33,0:10:22.47,Default,NTP,0,0,0,,«Күміс» туралы біледі ме?
Dialogue: 0,0:10:22.91,0:10:24.39,JPDB-ja,,0,0,0,,Жоқ, майор Яманака
Dialogue: 0,0:10:22.93,0:10:25.10,Default,NTP,0,0,0,,Жоқ, майор Яманака.
Dialogue: 0,0:10:25.10,0:10:27.52,Default,NTP,0,0,0,,Өйткені, бұл құпия.
Dialogue: 0,0:10:25.21,0:10:26.85,JPDB-ja,,0,0,0,,Бұл құпия.
Dialogue: 0,0:10:27.52,0:10:29.94,Default,NTP,0,0,0,,Сіз қандай да бір іс-шараларға қатысып жатқан жоқсыз ба?
Dialogue: 0,0:10:27.57,0:10:29.41,JPDB-ja,,0,0,0,,Ойыншы ретінде қатыспайсыз ба?
Dialogue: 0,0:10:29.94,0:10:33.86,Default,NTP,0,0,0,,Flash Cast дағдыларымен сіз өте жақсы жұмыс істейсіз деп ойлаймын.
Dialogue: 0,0:10:30.06,0:10:31.71,JPDB-ja,,0,0,0,,Егер сізде флэш түсіру техникасы болса
Dialogue: 0,0:10:31.71,0:10:33.65,JPDB-ja,,0,0,0,,Менің ойымша, бұл өте жақсы жүріп жатыр.
Dialogue: 0,0:10:34.21,0:10:38.36,Default,NTP,0,0,0,,Әрине, Материалдық жарылыс бар, бірақ сізде тұманның дисперсиясы да бар.
Dialogue: 0,0:10:34.27,0:10:36.11,JPDB-ja,,0,0,0,,Материал жарылып кетті
Dialogue: 0,0:10:36.58,0:10:38.23,JPDB-ja,,0,0,0,,Тұманның таралуы да бар.
Dialogue: 0,0:10:38.91,0:10:44.76,Default,NTP,0,0,0,,Тұманның дисперсиясы сияқты заттарды молекулалық деңгейде дисперстілеу - бұл А дәрежесіндегі жойқын сиқыр,
Dialogue: 0,0:10:38.94,0:10:42.18,JPDB-ja,,0,0,0,,Заттарды молекулалық деңгейге ыдырататын тұман дисперсиясы
Dialogue: 0,0:10:42.45,0:10:46.51,JPDB-ja,,0,0,0,,Бұл А дәрежелі өлімге тең, сондықтан оны тоғыз мектеп шайқасында пайдалану мүмкін емес.
Dialogue: 0,0:10:44.76,0:10:46.62,Default,NTP,0,0,0,,сондықтан ол оны ҰҚК-да пайдалана алмайды.
Dialogue: 0,0:10:46.62,0:10:50.37,Default,NTP,0,0,0,,Бұл не, Майор Санада? Сіз білмедіңіз бе?
Dialogue: 0,0:10:46.93,0:10:50.25,JPDB-ja,,0,0,0,,Әй, капитан Санада, білмейсің бе?
Dialogue: 0,0:10:50.97,0:10:56.22,Default,NTP,0,0,0,,ҰҚК шектеулері персоналға қарсы салдары болуы мүмкін оқиғаларға қойылады.
Dialogue: 0,0:10:51.05,0:10:52.26,JPDB-ja,,0,0,0,,Тоғыз мектеп турнирінің ережелері
Dialogue: 0,0:10:52.73,0:10:55.87,JPDB-ja,,0,0,0,,Егер зат тұлғааралық қарым-қатынас мүмкіндігі бар конкурсқа орналастырылса
Dialogue: 0,0:10:56.11,0:10:57.27,JPDB-ja,,0,0,0,,Жылдам ату және
Dialogue: 0,0:10:56.22,0:11:00.01,Default,NTP,0,0,0,,Жылдам ату және тіректерді бұзудан босатылады.
Dialogue: 0,0:10:57.49,0:10:59.57,JPDB-ja,,0,0,0,,Pillars Break қарастырылмаған.
Dialogue: 0,0:11:00.82,0:11:09.02,Default,NTP,0,0,0,,Қалай болғанда да, ашық турнирде өте құпия әскери сиқырды көрсету жақсы идея емес, солай ма? Тацуя...
Dialogue: 0,0:11:00.93,0:11:03.83,JPDB-ja,,0,0,0,,Қалай болғанда да, бұл әскери құпия сиқыр.
Dialogue: 0,0:11:03.83,0:11:06.81,JPDB-ja,,0,0,0,,Оны ашық жарыста қолдануға болмайды.
Dialogue: 0,0:11:08.37,0:11:08.90,JPDB-ja,,0,0,0,,Тацуя
Dialogue: 0,0:11:09.74,0:11:11.52,Default,NTP,0,0,0,,Түсіндім, майор.
Dialogue: 0,0:11:09.85,0:11:11.35,JPDB-ja,,0,0,0,,Түсіндім, майор.
Dialogue: 0,0:11:12.38,0:11:17.53,Default,NTP,0,0,0,,Дегенмен, мен сияқты инженердің бәсекеге түсуі екіталай.
Dialogue: 0,0:11:12.46,0:11:16.10,JPDB-ja,,0,0,0,,Дегенмен, техникалық персонал өздері ойыншыға айналған жағдайда,
Dialogue: 0,0:11:16.38,0:11:17.53,JPDB-ja,,0,0,0,,Оны елестету қиын.
Dialogue: 0,0:11:19.06,0:11:21.04,Default,NTP,0,0,0,,Бұл ақыл-ой мәселесі.
Dialogue: 0,0:11:19.11,0:11:20.55,JPDB-ja,,0,0,0,,Бұл қарастырылатын мәселе.
Dialogue: 0,0:11:23.22,0:11:25.28,Default,NTP,0,0,0,,Менің білуім керек, сіз бір бетте екенсіз.
Dialogue: 0,0:11:23.29,0:11:24.70,JPDB-ja,,0,0,0,,Білсең, жақсы.
Dialogue: 0,0:11:25.67,0:11:28.54,Default,NTP,0,0,0,,Тацуя! Мұнда, мына жерде!
Dialogue: 0,0:11:25.73,0:11:27.55,JPDB-ja,,0,0,0,,Тацуя-кун міне, міне
Dialogue: 0,0:11:26.03,0:11:28.12,Signs,,0,0,0,,Жылдам ату бойынша іріктеу турнирінің өтетін орны
Dialogue: 0,0:11:30.90,0:11:33.60,Default,NTP,0,0,0,,Тек ширек финал, және оның қаншалықты танымал екенін қараңыз.
Dialogue: 0,0:11:30.95,0:11:33.05,JPDB-ja,,0,0,0,,Бұл ширек финалдан бері өте танымал болды.
Dialogue: 0,0:11:33.60,0:11:35.42,Default,NTP,0,0,0,,Себебі төрайым жарысады.
Dialogue: 0,0:11:33.67,0:11:35.27,JPDB-ja,,0,0,0,,Өйткені төраға шығады.
Dialogue: 0,0:11:35.95,0:11:38.92,Default,NTP,0,0,0,,Қалған сіріңкелер осы сияқты көп емес.
Dialogue: 0,0:11:36.06,0:11:38.17,JPDB-ja,,0,0,0,,Басқа ешбір ойында мұндай адам көп емес.
Dialogue: 0,0:11:39.54,0:11:42.10,Default,NTP,0,0,0,,Хонока, сен көре алатыныңа сенімдісің бе?
Dialogue: 0,0:11:39.59,0:11:41.34,JPDB-ja,,0,0,0,,Хоноканы көру қиын емес пе?
Dialogue: 0,0:11:42.10,0:11:43.34,Default,NTP,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:11:42.18,0:11:43.01,JPDB-ja,,0,0,0,,Жарайды
Dialogue: 0,0:11:43.34,0:11:46.81,Default,NTP,0,0,0,,Түсіндім... Айтпақшы, Микихико не болды?
Dialogue: 0,0:11:43.50,0:11:46.59,JPDB-ja,,0,0,0,,көремін. Айтпақшы, Микихикоға не болды?
Dialogue: 0,0:11:46.81,0:11:49.37,Default,NTP,0,0,0,,Ол өзін жақсы сезінбейтінін айтады. Бізге оның бөлмесінде демалатынын айтты.
Dialogue: 0,0:11:47.03,0:11:51.11,JPDB-ja,,0,0,0,,Ол өзін ауырып жатқанын және бөлмесінде демалып жатқанын айтты.
Dialogue: 0,0:11:49.37,0:11:51.31,Default,NTP,0,0,0,,Ыстық оған жеткен болуы керек.
Dialogue: 0,0:11:51.78,0:11:58.39,Default,NTP,0,0,0,,Көзілдірігім болмаса, мен де құлап қалуым мүмкін еді.
Dialogue: 0,0:11:51.83,0:11:53.79,JPDB-ja,,0,0,0,,Ыстыққа ұшыраған сияқтысыз.
Dialogue: 0,0:11:54.43,0:11:58.03,JPDB-ja,,0,0,0,,Егер мен көзілдірік тақпағанымда, мен де түсіп қалуым мүмкін еді.
Dialogue: 0,0:12:03.95,0:12:06.95,Signs,,0,0,0,,Матоба
Dialogue: 0,0:12:03.95,0:12:06.95,Signs,,0,0,0,,Кейко
Dialogue: 0,0:12:03.95,0:12:06.95,Signs,,0,0,0,,Бесінші орта мектеп
Dialogue: 0,0:12:03.95,0:12:06.95,Signs,,0,0,0,,Саегуса
Dialogue: 0,0:12:03.95,0:12:06.95,Signs,,0,0,0,,Майуми
Dialogue: 0,0:12:03.95,0:12:06.95,Signs,,0,0,0,,Бірінші орта мектеп
Dialogue: 0,0:12:24.36,0:12:25.34,Default,NTP,0,0,0,,Керемет...
Dialogue: 0,0:12:24.43,0:12:25.22,JPDB-ja,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:12:25.76,0:12:28.49,Default,NTP,0,0,0,,Саегуса ханымның «Дер Фрайшуц...»
Dialogue: 0,0:12:25.86,0:12:27.94,JPDB-ja,,0,0,0,,Саегуса-сенпайдың Сиқырлы оқ садақшысы
Dialogue: 0,0:12:28.49,0:12:31.35,Default,NTP,0,0,0,,Бұл өткен жылғыдан да жылдамырақ.
Dialogue: 0,0:12:28.62,0:12:30.50,JPDB-ja,,0,0,0,,Өткен жылғыдан да жылдам
Dialogue: 0,0:12:31.35,0:12:32.85,Signs,,0,0,0,,Матоба
Dialogue: 0,0:12:31.35,0:12:32.85,Signs,,0,0,0,,Кейко
Dialogue: 0,0:12:31.35,0:12:32.85,Signs,,0,0,0,,Бесінші орта мектеп
Dialogue: 0,0:12:31.35,0:12:32.85,Signs,,0,0,0,,Саегуса
Dialogue: 0,0:12:31.35,0:12:32.85,Signs,,0,0,0,,Майуми
Dialogue: 0,0:12:31.35,0:12:32.85,Signs,,0,0,0,,Бірінші орта мектеп
Dialogue: 0,0:12:56.67,0:12:58.88,Signs,,0,0,0,,тарау
Dialogue: 0,0:12:56.67,0:12:58.88,Signs,,0,0,0,,тарау
Dialogue: 0,0:12:56.67,0:12:58.88,Signs,,0,0,0,,тарау
Dialogue: 0,0:12:56.67,0:12:58.88,Signs,,0,0,0,,тарау
Dialogue: 0,0:12:56.67,0:12:58.88,Signs,,0,0,0,,Тоғыз мектеп сайысы
Dialogue: 0,0:12:56.67,0:12:58.88,Signs,,0,0,0,,Тоғыз мектеп сайысы
Dialogue: 0,0:12:56.67,0:12:58.88,Signs,,0,0,0,,Тоғыз мектеп сайысы
Dialogue: 0,0:12:56.67,0:12:58.88,Signs,,0,0,0,,Тоғыз мектеп сайысы
Dialogue: 0,0:12:59.38,0:13:00.75,Default,NTP,0,0,0,,Сәлем!
Dialogue: 0,0:12:59.54,0:13:00.90,JPDB-ja,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:13:02.46,0:13:06.47,Default,NTP,0,0,0,,Төрайым, «Жылдам ату» сайысында жеңіске жеткеніңізбен құттықтаймыз!
Dialogue: 0,0:13:02.53,0:13:06.33,JPDB-ja,,0,0,0,,Төраға, жылдам ату бойынша жеңісіңіз құтты болсын.
Dialogue: 0,0:13:06.47,0:13:11.85,Default,NTP,0,0,0,,Рахмет. Ал Мари, сіз Battle Board жартылай финалына да өттіңіз.
Dialogue: 0,0:13:06.75,0:13:07.79,JPDB-ja,,0,0,0,,Рахмет
Dialogue: 0,0:13:08.58,0:13:11.73,JPDB-ja,,0,0,0,,Мари қауіпсіз және жартылай финалға өтті.
Dialogue: 0,0:13:12.23,0:13:14.43,Default,NTP,0,0,0,,Әзірге бәрі күткендей жүріп жатыр.
Dialogue: 0,0:13:12.29,0:13:13.97,JPDB-ja,,0,0,0,,Біріншіден, барлығы кесте бойынша.
Dialogue: 0,0:13:14.43,0:13:17.85,Default,NTP,0,0,0,,And First High тобы ұлдарға арналған Speed ​​Shooting жарысында да жеңіске жетті.
Dialogue: 0,0:13:14.53,0:13:17.71,JPDB-ja,,0,0,0,,Ұлдардың бірінші орта мектебі жылдам ату жарысында жеңіске жетті.
Dialogue: 0,0:13:17.85,0:13:22.98,Default,NTP,0,0,0,,Жауынгерлік тақта тырнақ тістейтін нәрсе болды, бірақ Хаттори аман қалды, иә?
Dialogue: 0,0:13:18.23,0:13:20.38,JPDB-ja,,0,0,0,,Мен шайқас тақтасында аздап қорықтым, бірақ
Dialogue: 0,0:13:20.95,0:13:22.89,JPDB-ja,,0,0,0,,Хаттори қандай да бір жолмен аман қалады ма?
Dialogue: 0,0:13:23.37,0:13:26.36,Default,NTP,0,0,0,,Оның CAD түзетулері оған жұмыс істемейтін сияқты.
Dialogue: 0,0:13:23.47,0:13:26.34,JPDB-ja,,0,0,0,,CAD реттеуі дұрыс болмаған сияқты.
Dialogue: 0,0:13:26.76,0:13:30.99,Default,NTP,0,0,0,,Ол күні бойы техникалық персоналдан Киношита-кунмен оны өзгертті, солай емес пе?
Dialogue: 0,0:13:26.87,0:13:30.79,JPDB-ja,,0,0,0,,Бүгін сіз Киношита мырзамен, техникалық персоналмен үйлестірдіңіз.
Dialogue: 0,0:13:31.53,0:13:34.37,Default,NTP,0,0,0,,Fortunately, Hanzo-kun's off tomorrow.
Dialogue: 0,0:13:31.54,0:13:33.99,JPDB-ja,,0,0,0,,Бақытымызға орай, Ханзо ертең жұмыста емес.
Dialogue: 0,0:13:34.37,0:13:37.50,Default,NTP,0,0,0,,Біз оған оны өз қалауынша реттеуге мүмкіндік беруіміз керек, менің ойымша.
Dialogue: 0,0:13:34.43,0:13:37.39,JPDB-ja,,0,0,0,,Сіз жасай алатын жалғыз нәрсе - ол оны ұнатпайынша істеуге рұқсат беру.
Dialogue: 0,0:13:38.29,0:13:43.08,Default,NTP,0,0,0,,Бірақ ойлап қарасаңыз, Киношита-кунда ертең Әйелдер тобының балы шарасы бар, солай емес пе?
Dialogue: 0,0:13:38.38,0:13:42.51,JPDB-ja,,0,0,0,,Бірақ Киношита-кун, ертең әйелдерге арналған бұлтты доп болды, солай ма?
Dialogue: 0,0:13:43.08,0:13:48.02,Default,NTP,0,0,0,,Ол қосалқы инженер болғандықтан, мен оны жоғалту қиындық тудыратынына сенбеймін.
Dialogue: 0,0:13:43.21,0:13:45.21,JPDB-ja,,0,0,0,,Ол қосалқы инженер, сондықтан
Dialogue: 0,0:13:45.73,0:13:47.55,JPDB-ja,,0,0,0,,Қызық, мен оны тастап кетсем де, қандай да бір қиындықтар туындайды ма?
Dialogue: 0,0:13:48.02,0:13:51.26,Default,NTP,0,0,0,,Мұның бәрін Изумиге тапсыру қауіпті емес пе?
Dialogue: 0,0:13:48.13,0:13:50.91,JPDB-ja,,0,0,0,,Оны жалғыз Изумиге қалдыру қауіпті емес пе?
Dialogue: 0,0:13:51.26,0:13:56.27,Default,NTP,0,0,0,,Олай болса, Шиба-кунды толтыруын сұрағанға не жетсін, өйткені ол ертең де, арғы күні де жұмыстан шығады?
Dialogue: 0,0:13:51.55,0:13:53.99,JPDB-ja,,0,0,0,,Сонымен ертең де, арғы күн де ​​демалыс болады.
Dialogue: 0,0:13:53.99,0:13:56.15,JPDB-ja,,0,0,0,,Сіздің орныңызға Шиба-кунды сұрауға не жетсін?
Dialogue: 0,0:13:57.58,0:14:00.11,Default,NTP,0,0,0,,Менің ойымша, бұл біздің ең жақсы ставкамыз, иә?
Dialogue: 0,0:13:57.73,0:13:58.99,JPDB-ja,,0,0,0,,Бұл ең жақсысы шығар
Dialogue: 0,0:13:59.93,0:14:03.17,JPDB-ja,,0,0,0,,Олай болса Миюки-сан, Тацуя-кунға айт.
Dialogue: 0,0:14:00.11,0:14:04.03,Default,NTP,0,0,0,,Жарайды, Миюки-сан, Тацуя-кунға хабарлайсың ба?
Dialogue: 0,0:14:04.03,0:14:05.24,Default,NTP,0,0,0,,Өте жақсы!
Dialogue: 0,0:14:04.13,0:14:04.57,JPDB-ja,,0,0,0,,Иә
Dialogue: 0,0:14:07.19,0:14:09.32,Default,NTP,0,0,0,,Түнде осында келдің бе?
Dialogue: 0,0:14:07.25,0:14:09.59,JPDB-ja,,0,0,0,,Түнде неге келдің?
Dialogue: 0,0:14:10.94,0:14:12.49,Default,NTP,0,0,0,,Мен сізге ыңғайсыздық тудырдым ба?
Dialogue: 0,0:14:10.99,0:14:12.23,JPDB-ja,,0,0,0,,Қолайсыздық үшін кешірім сұрайсыз ба?
Dialogue: 0,0:14:13.82,0:14:14.49,Default,NTP,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:14:13.89,0:14:16.93,JPDB-ja,,0,0,0,,Жоқ, маған хабарлағаныңызға ризамын.
Dialogue: 0,0:14:15.21,0:14:17.30,Default,NTP,0,0,0,,Маған хабар бергеніңіз үшін ризамын,
Dialogue: 0,0:14:17.30,0:14:21.35,Default,NTP,0,0,0,,бірақ қонақ үй ме, жоқ па, бұл сағатта жас қыз қыдырып жүрмеуі керек.
Dialogue: 0,0:14:17.41,0:14:18.78,JPDB-ja,,0,0,0,,Қонақ үй ішінде болса да.
Dialogue: 0,0:14:19.29,0:14:20.86,JPDB-ja,,0,0,0,,Қыздардың сыртқа шығатын уақыты емес.
Dialogue: 0,0:14:22.65,0:14:26.51,Default,NTP,0,0,0,,Иә... Мені кешіріңіз, Онии-сама.
Dialogue: 0,0:14:22.70,0:14:26.29,JPDB-ja,,0,0,0,,Иә, кешіріңіз, аға.
Dialogue: 0,0:14:27.27,0:14:29.76,Default,NTP,0,0,0,,Жүзіңіздегі зор күлімсіреумен кешірім сұрау шын мәнінде...
Dialogue: 0,0:14:27.35,0:14:29.49,JPDB-ja,,0,0,0,,Күлімсіреп кешірім сұрасаң да
Dialogue: 0,0:14:30.79,0:14:35.02,Default,NTP,0,0,0,,Қалай болғанда да, маған хабарлағаныңызға рахмет. Мен сені бөлмеңе апарамын.
Dialogue: 0,0:14:30.83,0:14:32.79,JPDB-ja,,0,0,0,,Қалай болғанда да, маған хабарлағаныңызға рахмет.
Dialogue: 0,0:14:34.18,0:14:35.14,JPDB-ja,,0,0,0,,Мен сені бөлмеңе апарамын.
Dialogue: 0,0:14:35.47,0:14:37.89,Default,NTP,0,0,0,,О, жоқ, мен өз бетімше жақсы боламын.
Dialogue: 0,0:14:35.61,0:14:37.51,JPDB-ja,,0,0,0,,Жоқ, сіз мұны жалғыз жасай аласыз.
Dialogue: 0,0:14:37.89,0:14:40.77,Default,NTP,0,0,0,,Мен сізді бұрынғыдан артық мазалайды...
Dialogue: 0,0:14:38.05,0:14:40.15,JPDB-ja,,0,0,0,,Менің бұдан артық уақытымды алуға мүмкіндігім жоқ.
Dialogue: 0,0:14:40.77,0:14:45.32,Default,NTP,0,0,0,,Мен бір нәрсенің ортасында болуым мүмкін, бірақ мен жай ғана ақымақпын, сондықтан бұл туралы алаңдамаңыз.
Dialogue: 0,0:14:40.93,0:14:41.94,JPDB-ja,,0,0,0,,Орындалу үстінде десе де
Dialogue: 0,0:14:41.98,0:14:45.07,JPDB-ja,,0,0,0,,Бұл жай ғана көңіл көтеру үшін, сондықтан бұл туралы алаңдамаңыз.
Dialogue: 0,0:14:45.32,0:14:50.19,Default,NTP,0,0,0,,Иә, бірақ бұл CAD бағдарламасы емес пе?
Dialogue: 0,0:14:45.49,0:14:49.37,JPDB-ja,,0,0,0,,Бірақ қазіргісі CAD бағдарламасы, солай емес пе?
Dialogue: 0,0:14:50.19,0:14:52.80,Default,NTP,0,0,0,,Оның ҰҚК-ге еш қатысы жоқ.
Dialogue: 0,0:14:50.29,0:14:51.89,JPDB-ja,,0,0,0,,Өйткені оның Тоғыз мектеп турниріне еш қатысы жоқ.
Dialogue: 0,0:14:52.80,0:14:55.83,Default,NTP,0,0,0,,Сонымен қатар, бағдарламаның өзі ойыншық сияқты.
Dialogue: 0,0:14:52.91,0:14:55.50,JPDB-ja,,0,0,0,,Бағдарламаның өзі ойыншық сияқты.
Dialogue: 0,0:14:56.73,0:14:58.97,Default,NTP,0,0,0,,Ойыншық, сен айттың ба?
Dialogue: 0,0:14:56.79,0:14:58.58,JPDB-ja,,0,0,0,,Бұл ойыншық па?
Dialogue: 0,0:14:58.97,0:14:59.33,Default,NTP,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:15:00.35,0:15:02.71,Default,NTP,0,0,0,,Дәл қазір сіз басымдылыққа иесіз.
Dialogue: 0,0:15:00.41,0:15:02.19,JPDB-ja,,0,0,0,,Сіз менің басымдығымсыз.
Dialogue: 0,0:15:02.71,0:15:04.19,Default,NTP,0,0,0,,О, менің...
Dialogue: 0,0:15:02.81,0:15:03.70,JPDB-ja,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:15:04.14,0:15:07.46,JPDB-ja,,0,0,0,,Менің ағам мені сенен артық санайды.
Dialogue: 0,0:15:04.19,0:15:05.31,Default,NTP,0,0,0,,Өзіңді тыңда, ағайын!
Dialogue: 0,0:15:05.31,0:15:08.21,Default,NTP,0,0,0,,Маған маңыздырақ екенімді айт!
Dialogue: 0,0:15:08.21,0:15:11.72,Default,NTP,0,0,0,,Мағынаны дұрыс түсіндіңіз, бірақ менің ойымша, бұл нюанс өте маңызды емес...
Dialogue: 0,0:15:08.30,0:15:11.58,JPDB-ja,,0,0,0,,Мағыналары бірдей, бірақ нюанстар өте әртүрлі болып көрінеді.
Dialogue: 0,0:15:13.38,0:15:14.65,Default,NTP,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:15:13.39,0:15:13.95,JPDB-ja,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:15:14.65,0:15:16.47,Default,NTP,0,0,0,,Иә, Онии-сама.
Dialogue: 0,0:15:14.73,0:15:16.14,JPDB-ja,,0,0,0,,Иә, аға.
Dialogue: 0,0:15:16.81,0:15:20.44,Default,NTP,0,0,0,,Мм... Мен де солай сезінемін, Онии-сама.
Dialogue: 0,0:15:16.89,0:15:20.22,JPDB-ja,,0,0,0,,Миюки сенің ағаңмен бірдей.
Dialogue: 0,0:15:20.44,0:15:21.14,Default,NTP,0,0,0,,Не?
Dialogue: 0,0:15:20.53,0:15:20.99,JPDB-ja,,0,0,0,,Жақсы
Dialogue: 0,0:15:22.74,0:15:26.19,Default,NTP,0,0,0,,Сен мен үшін бәрінен де маңыздысың, Онии-сама.
Dialogue: 0,0:15:22.79,0:15:25.63,JPDB-ja,,0,0,0,,Миюки де, ағам мен үшін бәрінен де маңызды.
Dialogue: 0,0:15:30.82,0:15:32.99,Signs,,0,0,0,,08-04 Конкурстың екінші күні
Dialogue: 0,0:15:30.99,0:15:32.99,Signs,,0,0,0,,Топтық допты іріктеу турнирінің өтетін орны
Dialogue: 0,0:15:36.04,0:15:37.04,Default,NTP,0,0,0,,Тацуя-кун...
Dialogue: 0,0:15:36.07,0:15:40.70,JPDB-ja,,0,0,0,,Тацуя-кун, бүгін танысқаныма қуаныштымын.
Dialogue: 0,0:15:39.54,0:15:41.04,Default,NTP,0,0,0,,Мен бүгін саған сенемін!
Dialogue: 0,0:15:41.75,0:15:45.41,Default,NTP,0,0,0,,Сіз кездейсоқ сол киіммен жарысасыз ба?
Dialogue: 0,0:15:41.85,0:15:44.90,JPDB-ja,,0,0,0,,Сіз сол киіммен шығасыз ба?
Dialogue: 0,0:15:45.41,0:15:46.04,Default,NTP,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:15:45.49,0:15:46.15,JPDB-ja,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:15:47.63,0:15:49.94,JPDB-ja,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:15:48.76,0:15:50.51,Default,NTP,0,0,0,,Бұл күлкілі көрінеді ме?
Dialogue: 0,0:15:50.51,0:15:51.76,Default,NTP,0,0,0,,Мен оған жақсы көрінбеймін бе?
Dialogue: 0,0:15:50.71,0:15:51.58,JPDB-ja,,0,0,0,,Маған сәйкес келмейді
Dialogue: 0,0:15:53.25,0:15:54.76,Default,NTP,0,0,0,,Бұл сізге өте жақсы айналады.
Dialogue: 0,0:15:53.34,0:15:54.62,JPDB-ja,,0,0,0,,Бұл сізге өте жарасады.
Dialogue: 0,0:15:55.32,0:15:56.39,Default,NTP,0,0,0,,Бұл солай ма?
Dialogue: 0,0:15:55.57,0:15:58.31,JPDB-ja,,0,0,0,,Иә, рахмет
Dialogue: 0,0:15:57.62,0:15:58.52,Default,NTP,0,0,0,,Рахмет!
Dialogue: 0,0:16:02.87,0:16:06.30,JPDB-ja,,0,0,0,,Тацуя-кун, маған қол ұшын беріңізші.
Dialogue: 0,0:16:02.89,0:16:03.85,Default,NTP,0,0,0,,Тацуя-кун?
Dialogue: 0,0:16:04.61,0:16:06.61,Default,NTP,0,0,0,,Маған қол ұшын бересіз бе?
Dialogue: 0,0:16:17.74,0:16:19.33,Default,NTP,0,0,0,,Бұл жеткілікті жақсы.
Dialogue: 0,0:16:17.77,0:16:18.58,JPDB-ja,,0,0,0,,Жетеді
Dialogue: 0,0:16:30.03,0:16:31.49,Default,NTP,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:16:30.13,0:16:30.77,JPDB-ja,,0,0,0,,Рахмет
Dialogue: 0,0:16:31.49,0:16:33.03,Default,NTP,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:16:31.54,0:16:32.54,JPDB-ja,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:16:34.97,0:16:37.40,Default,NTP,0,0,0,,Бұл мен үшін жаңалық!
Dialogue: 0,0:16:35.05,0:16:36.29,JPDB-ja,,0,0,0,,Жаңа нәрсе
Dialogue: 0,0:16:37.40,0:16:40.16,Default,NTP,0,0,0,,Менің үлкен ағам мен сіңлім бар,
Dialogue: 0,0:16:37.71,0:16:41.59,JPDB-ja,,0,0,0,,Менің ағам мен сіңлім бар, бірақ інім жоқ.
Dialogue: 0,0:16:40.16,0:16:41.93,Default,NTP,0,0,0,,бірақ іні емес, көріп тұрсың.
Dialogue: 0,0:16:44.44,0:16:48.44,Default,NTP,0,0,0,,Сіз маған ешқашан ерекше күтім көрсетпейтініңізді білесіз бе?
Dialogue: 0,0:16:44.77,0:16:48.21,JPDB-ja,,0,0,0,,Тацуя-кун маған ерекше қарамайды.
Dialogue: 0,0:16:48.73,0:16:51.99,JPDB-ja,,0,0,0,,Мен тым таныс болғым келмейді.
Dialogue: 0,0:16:48.87,0:16:52.44,Default,NTP,0,0,0,,Мен сенімен соншалықты таныс әрекет еткеніме сенбеймін...
Dialogue: 0,0:16:53.89,0:16:56.24,Default,NTP,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:16:54.03,0:16:55.71,JPDB-ja,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:16:56.24,0:17:00.95,Default,NTP,0,0,0,,Сіз шиеленіспейсіз, ашуланбайсыз немесе бәрі маған алаңдамайсыз, білесіз бе?
Dialogue: 0,0:16:56.37,0:17:00.62,JPDB-ja,,0,0,0,,Сіз біртүрлі тұрмайсыз, қобалжымайсыз және қозғалмайсыз.
Dialogue: 0,0:17:01.41,0:17:03.71,Default,NTP,0,0,0,,Қызық, бала інім бар ма екен?
Dialogue: 0,0:17:01.47,0:17:05.07,JPDB-ja,,0,0,0,,Менің інім осындай ма деп ойлаймын.
Dialogue: 0,0:17:04.26,0:17:05.49,Default,NTP,0,0,0,,Әзіл!
Dialogue: 0,0:17:07.72,0:17:12.26,Default,NTP,0,0,0,,Білмеймін... Бар болғаны өзімнен кейінгі сіңлім.
Dialogue: 0,0:17:07.79,0:17:08.31,JPDB-ja,,0,0,0,,Келіңіздер
Dialogue: 0,0:17:09.58,0:17:11.25,JPDB-ja,,0,0,0,,Менің де тек бір қарындасым бар.
Dialogue: 0,0:17:12.26,0:17:14.27,Default,NTP,0,0,0,,Сіздің ойыңыз бар.
Dialogue: 0,0:17:12.43,0:17:13.34,JPDB-ja,,0,0,0,,Солай ма?
Dialogue: 0,0:17:14.27,0:17:18.42,Default,NTP,0,0,0,,Кешіріңіз. Мен тіркеліп, басқа спортшылардың жағдайын көргім келеді,
Dialogue: 0,0:17:14.47,0:17:14.93,JPDB-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:15.78,0:17:18.25,JPDB-ja,,0,0,0,,Мен де басқа ойыншылардың жағдайын көргім келеді.
Dialogue: 0,0:17:18.42,0:17:19.10,Default,NTP,0,0,0,,сондықтан кешіріңіз.
Dialogue: 0,0:17:18.65,0:17:18.94,JPDB-ja,,0,0,0,,Қазір
Dialogue: 0,0:17:19.70,0:17:20.82,Default,NTP,0,0,0,,Мен саған сенемін!
Dialogue: 0,0:17:19.73,0:17:20.55,JPDB-ja,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:17:20.82,0:17:22.60,Default,NTP,0,0,0,,Бұл қажет емес.
Dialogue: 0,0:17:20.91,0:17:22.11,JPDB-ja,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:17:26.49,0:17:28.02,JPDB-ja,,0,0,0,,О, Изуми
Dialogue: 0,0:17:26.49,0:17:28.13,Default,NTP,0,0,0,,Сәлем, Изумин.
Dialogue: 0,0:17:28.13,0:17:32.73,Default,NTP,0,0,0,,Саегуса, мен сенен мені олай атамауыңды өтіндім.
Dialogue: 0,0:17:28.19,0:17:32.45,JPDB-ja,,0,0,0,,Нанакуса, мені олай деуді доғаршы.
Dialogue: 0,0:17:33.23,0:17:37.24,Default,NTP,0,0,0,,Сонымен Изуми ханым, «бұл қажет емес» дегеніңізбен не айтқыңыз келді?
Dialogue: 0,0:17:33.30,0:17:35.14,JPDB-ja,,0,0,0,,Сонымен Изуми-сенпай
Dialogue: 0,0:17:35.90,0:17:36.91,JPDB-ja,,0,0,0,,Қажет емес
Dialogue: 0,0:17:37.72,0:17:39.74,Default,NTP,0,0,0,,О... Шиба-кун,
Dialogue: 0,0:17:38.85,0:17:39.50,JPDB-ja,,0,0,0,,Шиба-кун
Dialogue: 0,0:17:40.38,0:17:43.32,Default,NTP,0,0,0,,сен әрі қарай Саегусаның матчын тамашала.
Dialogue: 0,0:17:40.42,0:17:42.58,JPDB-ja,,0,0,0,,Сен Саегусаның матчын көріп тұрсың.
Dialogue: 0,0:17:43.32,0:17:46.03,Default,NTP,0,0,0,,Қалғанын өзім шешемін.
Dialogue: 0,0:17:43.46,0:17:45.06,JPDB-ja,,0,0,0,,Қалғанын өзім шешемін.
Dialogue: 0,0:17:46.03,0:17:48.37,Default,NTP,0,0,0,,Бұл дұрыс па? Өте жақсы.
Dialogue: 0,0:17:46.21,0:17:46.78,JPDB-ja,,0,0,0,,Солай ма?
Dialogue: 0,0:17:47.53,0:17:48.15,JPDB-ja,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:17:49.00,0:17:50.01,Default,NTP,0,0,0,,Кездескенше.
Dialogue: 0,0:17:49.10,0:17:49.51,JPDB-ja,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:17:57.46,0:17:59.96,Default,NTP,0,0,0,,Ол жаман бала емес, бірақ...
Dialogue: 0,0:17:57.54,0:17:59.46,JPDB-ja,,0,0,0,,Ол жаман бала емес.
Dialogue: 0,0:18:01.89,0:18:04.39,Signs,,0,0,0,,Саегуса Маюми
Dialogue: 0,0:18:01.89,0:18:04.39,Signs,,0,0,0,,Бірінші орта мектеп
Dialogue: 0,0:18:01.89,0:18:04.39,Signs,,0,0,0,,Ямагами Мисато
Dialogue: 0,0:18:01.89,0:18:04.39,Signs,,0,0,0,,Жетінші орта мектеп
Dialogue: 0,0:18:36.50,0:18:38.63,Default,NTP,0,0,0,,Қыздар күткендей өнер көрсетуде.
Dialogue: 0,0:18:36.57,0:18:38.17,JPDB-ja,,0,0,0,,Қыздар кесте бойынша.
Dialogue: 0,0:18:39.43,0:18:40.84,Signs,,0,0,0,,Жарыстың екінші күні
Dialogue: 0,0:18:39.59,0:18:40.84,Signs,,0,0,0,,Ice Pillars Break Іріктеу турнирінің өтетін орны
Dialogue: 0,0:18:39.62,0:18:41.96,Default,NTP,0,0,0,,Әйелдер тіректерінің сынуы, екінші айналым.
Dialogue: 0,0:18:39.70,0:18:41.49,JPDB-ja,,0,0,0,,Әйелдер тірегі 2-ші кезең
Dialogue: 0,0:18:41.96,0:18:45.16,Default,NTP,0,0,0,,Бірінші орта мектеп, Канон Чийода ханым.
Dialogue: 0,0:18:42.05,0:18:44.30,JPDB-ja,,0,0,0,,Даиичи орта мектебі Канон Чийода
Dialogue: 0,0:18:45.16,0:18:46.39,Default,NTP,0,0,0,,Рейки.
Dialogue: 0,0:18:45.21,0:18:45.75,JPDB-ja,,0,0,0,,Жарайды
Dialogue: 0,0:18:47.93,0:18:50.15,Signs,,0,0,0,,Сатонака Мадоко
Dialogue: 0,0:18:47.93,0:18:50.15,Signs,,0,0,0,,Тоғызыншы орта мектеп
Dialogue: 0,0:18:47.93,0:18:50.15,Signs,,0,0,0,,Чийода Канон
Dialogue: 0,0:18:47.93,0:18:50.15,Signs,,0,0,0,,Бірінші орта мектеп
Dialogue: 0,0:18:48.02,0:18:50.15,Default,NTP,0,0,0,,Чийода ханымның жағдайы қалай?
Dialogue: 0,0:18:48.07,0:18:50.02,JPDB-ja,,0,0,0,,Чийода-сенпайдың жағдайы қалай?
Dialogue: 0,0:18:50.52,0:18:52.91,Default,NTP,0,0,0,,Ол өте қызық.
Dialogue: 0,0:18:50.65,0:18:52.37,JPDB-ja,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:18:52.91,0:18:55.90,Default,NTP,0,0,0,,Менің естуімше, ол бірінші раундта ең қысқа уақытта жеңіске жетті.
Dialogue: 0,0:18:52.99,0:18:55.59,JPDB-ja,,0,0,0,,Бірінші раундта ең қысқа уақытта жеңіске жеткеніңізді естідім.
Dialogue: 0,0:18:56.60,0:18:58.65,Default,NTP,0,0,0,,Сіз Канонның мінезін білесіз...
Dialogue: 0,0:18:56.70,0:18:58.43,JPDB-ja,,0,0,0,,Өйткені Канонның мінезі осындай.
Dialogue: 0,0:18:59.24,0:19:00.16,Default,NTP,0,0,0,,Басталып жатыр.
Dialogue: 0,0:18:59.34,0:18:59.99,JPDB-ja,,0,0,0,,Өзіңді масқараласаң не, күлсе не болады?—
Dialogue: 0,0:19:08.33,0:19:09.80,Default,NTP,0,0,0,,Мина көзі.
Dialogue: 0,0:19:08.77,0:19:09.41,JPDB-ja,,0,0,0,,Шахта көзі
Dialogue: 0,0:19:09.80,0:19:10.54,Default,NTP,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:19:09.89,0:19:14.06,JPDB-ja,,0,0,0,,Иә, Чийода отбасы - бұл діріл жүйесі, қашықтағы қатты діріл сиқыры.
Dialogue: 0,0:19:10.54,0:19:14.09,Default,NTP,0,0,0,,Чийода отбасы ұзақ қашықтыққа созылатын қатты заттардың діріл типіндегі сиқырды меңгергені белгілі,
Dialogue: 0,0:19:14.09,0:19:18.59,Default,NTP,0,0,0,,және әсіресе жерді дірілдететін заклинаниелерде.
Dialogue: 0,0:19:14.41,0:19:18.45,JPDB-ja,,0,0,0,,Солардың ішінде жерді тербететін сиқырға ерекше шебер.
Dialogue: 0,0:19:30.64,0:19:35.90,Default,NTP,0,0,0,,Ол қорғанысын күшейткен сияқты, бірақ Чийода ханымның шабуылдарына төтеп бере алмайды.
Dialogue: 0,0:19:30.97,0:19:32.85,JPDB-ja,,0,0,0,,Қорғаныс күшейтілген сияқты.
Dialogue: 0,0:19:33.10,0:19:35.73,JPDB-ja,,0,0,0,,Чийода-сенпайдың шабуылына жауап бере алмады
Dialogue: 0,0:19:46.52,0:19:49.88,Default,NTP,0,0,0,,Оның қарсыласы бірінші шабуыл стратегиясына ауысқан сияқты, бірақ...
Dialogue: 0,0:19:46.62,0:19:49.37,JPDB-ja,,0,0,0,,Қарсылас шабуыл басымдығына ауысқан сияқты.
Dialogue: 0,0:19:52.41,0:19:55.88,Default,NTP,0,0,0,,Не ол шынымен шешуші, немесе оның әдістері тайғақ...
Dialogue: 0,0:19:52.49,0:19:54.07,JPDB-ja,,0,0,0,,Ең дұрысы.
Dialogue: 0,0:19:54.62,0:19:55.78,JPDB-ja,,0,0,0,,Дөрекі айтқанда?
Dialogue: 0,0:19:56.61,0:20:00.14,Default,NTP,0,0,0,,Өзіңізді шығарып алмас бұрын оларды шығарыңыз... бұл сізге Канон.
Dialogue: 0,0:19:56.67,0:19:59.77,JPDB-ja,,0,0,0,,Жеңілмес бұрын Канонды жеңу керек.
Dialogue: 0,0:20:05.34,0:20:09.89,Default,NTP,0,0,0,,Ал, жоқ... Стратегия ретінде бұл дұрыс емес деп ойлаймын.
Dialogue: 0,0:20:05.42,0:20:09.03,JPDB-ja,,0,0,0,,Жоқ. Менің ойымша, бұл қате стратегия емес.
Dialogue: 0,0:20:14.07,0:20:15.31,Default,NTP,0,0,0,,Жеңіс!
Dialogue: 0,0:20:14.23,0:20:14.87,JPDB-ja,,0,0,0,,Жеңіс
Dialogue: 0,0:20:19.07,0:20:21.07,Signs,,0,0,0,,Бірінші орта мектеп
Dialogue: 0,0:20:30.51,0:20:32.45,Default,NTP,0,0,0,,Не болып жатыр?
Dialogue: 0,0:20:30.61,0:20:31.77,JPDB-ja,,0,0,0,,Не болды?
Dialogue: 0,0:20:32.45,0:20:36.00,Default,NTP,0,0,0,,Ерлер тобының добы нәтижелері біз күткендей болмағандықтан,
Dialogue: 0,0:20:32.55,0:20:35.61,JPDB-ja,,0,0,0,,Ерлер арасындағы бұлтты доптың нәтижелері күткендей болмады.
Dialogue: 0,0:20:36.00,0:20:39.09,Default,NTP,0,0,0,,біз жалпы титулды жеңу үшін болжамдарымызды қайта есептеп жатырмыз.
Dialogue: 0,0:20:36.21,0:20:39.25,JPDB-ja,,0,0,0,,Біз жалпы жеңіс перспективаларын қайта есептейміз.
Dialogue: 0,0:20:40.55,0:20:42.84,Default,NTP,0,0,0,,Біздің қазіргі көшбасшымызды ескере отырып,
Dialogue: 0,0:20:40.66,0:20:42.58,JPDB-ja,,0,0,0,,Ағымдағы жетекшіні ескере отырып
Dialogue: 0,0:20:42.84,0:20:47.33,Default,NTP,0,0,0,,егер біз әйелдердің ресми жекпе-жегін жеңіп алсақ, ерлер тіректерінің сынуы,
Dialogue: 0,0:20:43.17,0:20:44.89,JPDB-ja,,0,0,0,,Негізгі турнирге арналған әйелдер жекпе-жек тақтасы
Dialogue: 0,0:20:45.58,0:20:46.97,JPDB-ja,,0,0,0,,Ерлердің тіректерінің сынуы
Dialogue: 0,0:20:47.33,0:20:51.85,Default,NTP,0,0,0,,Mirage Bat және Monolith Code оқиғалары, ол қауіпсіз жерде болуы керек.
Dialogue: 0,0:20:47.43,0:20:48.22,JPDB-ja,,0,0,0,,Мираж Бат
Dialogue: 0,0:20:48.58,0:20:51.58,JPDB-ja,,0,0,0,,Егер сіз Monolith Code арқылы жеңсеңіз, қауіпсіз аймақта боласыз.
Dialogue: 0,0:20:51.85,0:20:56.21,Default,NTP,0,0,0,,Басқаша айтқанда, қалған алты ресми матчтың ішінде,
Dialogue: 0,0:20:52.13,0:20:53.21,JPDB-ja,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:20:53.91,0:20:55.82,JPDB-ja,,0,0,0,,Осы жылы қалған алты оқиғадан
Dialogue: 0,0:20:56.21,0:20:59.61,Default,NTP,0,0,0,,Біз олардың кем дегенде төртеуін жеңуіміз керек пе?
Dialogue: 0,0:20:56.35,0:20:59.43,JPDB-ja,,0,0,0,,Бұл төрт жарыста жеңуім керек дегенді білдіре ме?
Dialogue: 0,0:21:00.14,0:21:02.25,Default,NTP,0,0,0,,Олар ұпайлардың жартысы ғана болуы мүмкін,
Dialogue: 0,0:21:00.27,0:21:01.93,JPDB-ja,,0,0,0,,Ұпайлар жарты болса да
Dialogue: 0,0:21:02.25,0:21:05.49,Default,NTP,0,0,0,,, бірақ біздің жаңадан келген матчтардағы нәтижелеріміз жалпы титулға жету мүмкіндігімізді өзгертетін сияқты.
Dialogue: 0,0:21:02.35,0:21:05.89,JPDB-ja,,0,0,0,,Жаңа ойыншылар сайысындағы көрсеткіш жалпы жеңіске әсер етуі мүмкін.
Dialogue: 0,0:21:11.69,0:21:16.12,Default,NTP,0,0,0,,Оны салып, жарты күнде жіберетінін кім білген?
Dialogue: 0,0:21:11.79,0:21:15.63,JPDB-ja,,0,0,0,,Жарты күнде басып шығарып, құрастырып, маған жібереді деп ойламаппын.
Dialogue: 0,0:21:18.05,0:21:21.95,Default,NTP,0,0,0,,Онии-сама, мен кірсем жақсы болар ма еді?
Dialogue: 0,0:21:18.09,0:21:21.26,JPDB-ja,,0,0,0,,Бауырым, сөзіңді бөлуге бола ма?
Dialogue: 0,0:21:21.95,0:21:23.13,Default,NTP,0,0,0,,Кіріңіз.
Dialogue: 0,0:21:22.07,0:21:22.46,JPDB-ja,,0,0,0,,Өтінемін
Dialogue: 0,0:21:23.91,0:21:25.88,Default,NTP,0,0,0,,Кешіріңіз, Онии-сама.
Dialogue: 0,0:21:23.97,0:21:25.71,JPDB-ja,,0,0,0,,Кешіріңіз, аға.
Dialogue: 0,0:21:26.77,0:21:28.37,Default,NTP,0,0,0,,Біз ойнауға келдік!
Dialogue: 0,0:21:26.85,0:21:28.13,JPDB-ja,,0,0,0,,Мен ойнауға келдім.
Dialogue: 0,0:21:28.37,0:21:29.76,Default,NTP,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:21:28.43,0:21:29.51,JPDB-ja,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:21:29.76,0:21:31.14,Default,NTP,0,0,0,,- Кешіріңіз! - Кешіріңіз!
Dialogue: 0,0:21:29.98,0:21:31.06,JPDB-ja,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:21:31.14,0:21:32.86,Default,NTP,0,0,0,,Эй, кір!
Dialogue: 0,0:21:31.43,0:21:32.30,JPDB-ja,,0,0,0,,Мен сізге кедергі келтіремін
Dialogue: 0,0:21:32.86,0:21:34.27,Default,NTP,0,0,0,,Онда оны киемін!
Dialogue: 0,0:21:32.95,0:21:33.81,JPDB-ja,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:36.41,0:21:40.65,Default,NTP,0,0,0,,Тацуя-кун, бұл кездейсоқ қаруланған біріктірілген CAD ма?
Dialogue: 0,0:21:36.49,0:21:37.15,JPDB-ja,,0,0,0,,Тацуя-кун
Dialogue: 0,0:21:37.45,0:21:40.54,JPDB-ja,,0,0,0,,Бұл қарумен біріктірілген CAD болуы мүмкін бе?
Dialogue: 0,0:21:41.19,0:21:42.14,Default,NTP,0,0,0,,Дұрыс.
Dialogue: 0,0:21:41.22,0:21:41.65,JPDB-ja,,0,0,0,,Дұрыс
Dialogue: 0,0:21:43.82,0:21:45.83,Default,NTP,0,0,0,,Бұл сіз айтқан ойыншық па?
Dialogue: 0,0:21:43.89,0:21:45.39,JPDB-ja,,0,0,0,,Бұл бірдей ойыншық па?
Dialogue: 0,0:21:45.83,0:21:46.30,JPDB-ja,,0,0,0,,О
Dialogue: 0,0:21:45.83,0:21:46.65,Default,NTP,0,0,0,,Оқу, оқу
Dialogue: 0,0:21:53.46,0:21:54.04,Default,NTP,0,0,0,,Лео!
Dialogue: 0,0:21:53.58,0:21:53.94,JPDB-ja,,0,0,0,,Арыстан
Dialogue: 0,0:21:54.04,0:21:56.08,Default,NTP,0,0,0,,Солай емес пе...
Dialogue: 0,0:21:56.08,0:21:58.04,Default,,0,0,0,,Тацуя, қарашы, солай ма?
Dialogue: 0,0:21:56.14,0:21:56.67,JPDB-ja,,0,0,0,,Тацуя
Dialogue: 0,0:21:56.97,0:21:57.89,JPDB-ja,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:21:58.35,0:21:59.67,Default,NTP,0,0,0,,Сіз оны қолданып көргіңіз келмейді ме?
Dialogue: 0,0:21:58.41,0:21:59.58,JPDB-ja,,0,0,0,,Оны көргіңіз келмей ме?
Dialogue: 0,0:22:00.04,0:22:01.67,Default,NTP,0,0,0,,Кім, мен?
Dialogue: 0,0:22:00.94,0:22:01.37,JPDB-ja,,0,0,0,,Мен
Dialogue: 0,0:22:02.25,0:22:03.49,Default,NTP,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:22:02.35,0:22:04.78,JPDB-ja,,0,0,0,,Менің ойымша, бұл сізге қолайлы
Dialogue: 0,0:22:03.49,0:22:05.25,Default,NTP,0,0,0,,Менің ойымша, бұл сіздің аллеяңызда болар еді.
Dialogue: 0,0:22:11.00,0:22:11.89,Default,NTP,0,0,0,,Мен ойынмын...
Dialogue: 0,0:22:11.05,0:22:11.59,JPDB-ja,,0,0,0,,Мен оны… есептей алмаймын.
Dialogue: 0,0:22:13.22,0:22:15.17,Default,NTP,0,0,0,,Әрине, мен сенің теңіз шошқаң боламын.
Dialogue: 0,0:22:13.33,0:22:14.71,JPDB-ja,,0,0,0,,Мен сіздің эксперименттік пәніңіз боламын.
Dialogue: 0,0:22:16.18,0:22:22.36,ED Kanji,,0,0,0,,Жұмсақ жел, бүршік жарады
Dialogue: 0,0:22:16.18,0:22:22.36,ED Romaji,,0,0,0,,ясашии казе мебуку цубоми
Dialogue: 0,0:22:16.18,0:22:22.36,ED English,,0,0,0,,Нәзік желде бүршік жарған өсімдіктер
Dialogue: 0,0:22:16.21,0:22:21.61,JPED-ja,,0,0,0,,Жұмсақ жел, бүршік жарады
Dialogue: 0,0:22:22.36,0:22:28.32,ED Kanji,,0,0,0,,Қаланы бояған гүлдер
Dialogue: 0,0:22:22.36,0:22:28.32,ED Romaji,,0,0,0,,machi Someteku hanatachi
Dialogue: 0,0:22:22.36,0:22:28.32,ED English,,0,0,0,,Қаланы бояйтын гүлдер
Dialogue: 0,0:22:22.39,0:22:27.83,JPED-ja,,0,0,0,,Қаланы бояған гүлдер
Dialogue: 0,0:22:28.32,0:22:34.62,ED Kanji,,0,0,0,,Сұлулық уақыт өткен сайын өседі
Dialogue: 0,0:22:28.32,0:22:34.62,ED Romaji,,0,0,0,,утсукушиса во токи томо ни
Dialogue: 0,0:22:28.32,0:22:34.62,ED English,,0,0,0,,Уақытпен бірге сұлулық
Dialogue: 0,0:22:28.65,0:22:33.97,JPED-ja,,0,0,0,,Сұлулық уақытпен бірге келеді
Dialogue: 0,0:22:34.62,0:22:40.54,ED Kanji,,0,0,0,,Армандай кетті
Dialogue: 0,0:22:34.62,0:22:40.54,ED Romaji,,0,0,0,,yume no you ni naku natte shimau
Dialogue: 0,0:22:34.62,0:22:40.54,ED English,,0,0,0,,түс сияқты жоғалады
Dialogue: 0,0:22:34.67,0:22:40.25,JPED-ja,,0,0,0,,Түсіндей өлді
Dialogue: 0,0:22:40.54,0:22:45.38,ED Kanji,,0,0,0,,Сіздің жылулық
Dialogue: 0,0:22:40.54,0:22:45.38,ED Romaji,,0,0,0,,anata no nukumori
Dialogue: 0,0:22:40.54,0:22:45.38,ED English,,0,0,0,,Жылулығыңыз бар ма деп ойлаймын
Dialogue: 0,0:22:40.93,0:22:44.81,JPED-ja,,0,0,0,,Сіздің жылулық
Dialogue: 0,0:22:47.01,0:22:53.26,ED Kanji,,0,0,0,,Қызық, ол да солай жоғалып кете ме?
Dialogue: 0,0:22:47.01,0:22:53.26,ED Romaji,,0,0,0,,жараға онажи де киете шимау кана
Dialogue: 0,0:22:47.01,0:22:53.26,ED English,,0,0,0,,солай жоғалады
Dialogue: 0,0:22:47.07,0:22:52.53,JPED-ja,,0,0,0,,Қызық, ол да солай жоғалып кете ме?
Dialogue: 0,0:22:55.56,0:22:58.39,ED Romaji,,0,0,0,,Менің махаббатымның пішіні
Dialogue: 0,0:22:55.61,0:22:58.09,JPED-ja,,0,0,0,,менің махаббатымның көлеңкесі
Dialogue: 0,0:22:58.39,0:23:02.27,ED Kanji,,0,0,0,,Соңы болса да
Dialogue: 0,0:22:58.39,0:23:02.27,ED Romaji,,0,0,0,,owari ga atte mo
Dialogue: 0,0:22:58.39,0:23:02.27,ED English,,0,0,0,,Соңы болса да,
Dialogue: 0,0:22:58.41,0:23:02.27,JPED-ja,,0,0,0,,Соңы болса да
Dialogue: 0,0:23:02.73,0:23:08.15,ED Kanji,,0,0,0,,Қорықпай ән айт
Dialogue: 0,0:23:02.73,0:23:08.15,ED Romaji,,0,0,0,,osorezu ni uta wo utaou
Dialogue: 0,0:23:02.73,0:23:08.15,ED English,,0,0,0,,қорықпай ән айтайық
Dialogue: 0,0:23:02.77,0:23:08.01,JPED-ja,,0,0,0,,Ән айтудан қорықпа
Dialogue: 0,0:23:08.15,0:23:10.90,ED Romaji,,0,0,0,,Мәңгілік жыр
Dialogue: 0,0:23:08.19,0:23:10.63,JPED-ja,,0,0,0,,мәңгілік жыр
Dialogue: 0,0:23:10.90,0:23:15.16,ED Kanji,,0,0,0,,Пішін қажет емес
Dialogue: 0,0:23:10.90,0:23:15.16,ED Romaji,,0,0,0,,катачи ва иранаи
Dialogue: 0,0:23:10.90,0:23:15.16,ED English,,0,0,0,,Оған пішін қажет емес
Dialogue: 0,0:23:10.91,0:23:15.03,JPED-ja,,0,0,0,,Пішін қажет емес
Dialogue: 0,0:23:15.16,0:23:19.91,ED Kanji,,0,0,0,,Мені ұстап, сезгеніңді қалаймын.
Dialogue: 0,0:23:15.16,0:23:19.91,ED Romaji,,0,0,0,,дакишимете канджите хошии
Dialogue: 0,0:23:15.16,0:23:19.91,ED English,,0,0,0,,Мен сенің мені құшақтап жатқаныңды сезгім келеді
Dialogue: 0,0:23:15.17,0:23:19.69,JPED-ja,,0,0,0,,Мені ұстап, сезгеніңді қалаймын
Dialogue: 0,0:23:21.00,0:23:23.00,ED Kanji,,0,0,0,,Тіпті 10 жылдан кейін
Dialogue: 0,0:23:21.00,0:23:23.00,ED Romaji,,0,0,0,,жуунен саки мо
Dialogue: 0,0:23:21.00,0:23:23.00,ED English,,0,0,0,,Тіпті он жылдан кейін
Dialogue: 0,0:23:21.07,0:23:24.17,JPED-ja,,0,0,0,,Он жылдан кейін
