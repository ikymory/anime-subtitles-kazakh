Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:36.73,0:00:38.98,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:00:42.90,0:00:45.07,Default,,0,0,0,,[О, жоқ! ]
Dialogue: 0,0:00:47.91,0:00:50.83,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:01:00.46,0:01:02.75,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:01:09.55,0:01:11.72,Default,,0,0,0,,[Жетеді! ]
Dialogue: 0,0:01:19.56,0:01:20.11,Default,,0,0,0,,Не...?
Dialogue: 0,0:01:28.15,0:01:29.28,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:01:37.33,0:01:39.25,Default,,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:01:51.01,0:01:53.31,Default,,0,0,0,,Қоян бар ма? !
Dialogue: 0,0:01:58.85,0:02:00.94,Default,,0,0,0,,Ни-сан, сен қайдасың?
Dialogue: 0,0:02:14.12,0:02:14.91,Default,,0,0,0,,Не-сан!
Dialogue: 0,0:02:19.50,0:02:21.21,Default,,0,0,0,,[Кіру/шығу]
Dialogue: 0,0:02:26.50,0:02:27.21,Default,,0,0,0,,Не-сан!
Dialogue: 0,0:03:28.00,0:03:31.00,Default,,0,0,0,,Қысқа шығарма
Dialogue: 0,0:03:48.96,0:03:51.00,Default,,0,0,0,,Инь-Янның әртүрлі ноталары 100 жылдық ыдыстардан кейін
Dialogue: 0,0:03:51.00,0:03:55.60,Default,,0,0,0,,Рух болып, рух алудан.
Dialogue: 0,0:03:56.96,0:03:59.00,Default,,0,0,0,,Біреудің жүрегін алдау
Dialogue: 0,0:03:59.00,0:04:02.60,Default,,0,0,0,,Бұл Цукумогами деп аталады. «Цукумогамикиден»
Dialogue: 0,0:05:47.60,0:05:54.69,Default,,0,0,0,,Тоқсан тоғыз
Dialogue: 0,0:06:08.60,0:06:11.69,Default,,0,0,0,,Мен осы қатты жаңбырда адасып қалдым.
Dialogue: 0,0:06:13.98,0:06:17.19,Default,,0,0,0,,Жаңбыр басылғанша демалуға рұқсат етіңізші.
Dialogue: 0,0:07:12.96,0:07:15.63,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:07:20.00,0:07:22.00,Default,,0,0,0,,Итететта
Dialogue: 0,0:07:43.28,0:07:46.91,Default,,0,0,0,,♪Бәрі бір реттік, эй♪
Dialogue: 0,0:07:47.28,0:07:50.83,Default,,0,0,0,,♪Бұл соншалықты ретсіз және бір реттік♪
Dialogue: 0,0:07:50.91,0:07:54.83,Default,,0,0,0,,♪Егер жыртылып кетсе, оны майып еткеннен пайда жоқ♪
Dialogue: 0,0:07:55.12,0:07:58.92,Default,,0,0,0,,♪Үзілсе, пайдасы жоқ♪
Dialogue: 0,0:07:59.50,0:08:05.05,Default,,0,0,0,,♪Барлық жерде, бір реттік, биік, биік, биік♪
Dialogue: 0,0:08:05.18,0:08:08.60,Default,,0,0,0,,♪Барлық жерде, бір реттік, биік, биік, биік♪
Dialogue: 0,0:08:11.52,0:08:15.19,Default,,0,0,0,,Уау... бұл жақсы қолшатыр.
Dialogue: 0,0:08:16.77,0:08:18.23,Default,,0,0,0,,Кішкене қарыз ал!
Dialogue: 0,0:08:59.02,0:08:59.52,Default,,0,0,0,,
Dialogue: 0,0:09:17.87,0:09:18.37,Default,,0,0,0,,♪Acchakoccha...Мен үйге бара жатырмын
Dialogue: 0,0:09:19.75,0:09:23.67,Default,,0,0,0,,Қайтарыңыз! Үйге бар!
Dialogue: 0,0:10:35.08,0:10:37.66,Default,,0,0,0,,Мен... әдемімін бе?
Dialogue: 0,0:10:40.92,0:10:41.83,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:10:42.42,0:10:46.17,Default,,0,0,0,,Барлығы маған әдемі екенімді айтты.
Dialogue: 0,0:10:47.09,0:10:47.76,Default,,0,0,0,,Бірақ
Dialogue: 0,0:10:48.46,0:10:52.68,Default,,0,0,0,,Адамдардың сәні сәт сайын өзгеріп отырады.
Dialogue: 0,0:10:53.72,0:10:57.85,Default,,0,0,0,,Модадан шығып, сандықтағы көң
Dialogue: 0,0:10:59.52,0:11:00.27,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:11:01.39,0:11:04.98,Default,,0,0,0,,Мен... әдемімін бе?
Dialogue: 0,0:11:18.45,0:11:20.12,Default,,0,0,0,,Қандай жақсы жанасу
Dialogue: 0,0:11:20.62,0:11:22.37,Default,,0,0,0,,Біраз тозғанымен.
Dialogue: 0,0:11:22.83,0:11:23.92,Default,,0,0,0,,Бұл жақсы!
Dialogue: 0,0:11:24.79,0:11:27.04,Default,,0,0,0,,Кішкене қарыз ал!
Dialogue: 0,0:11:46.98,0:11:48.48,Default,,0,0,0,,Иә, әдемі.
Dialogue: 0,0:12:05.54,0:12:08.09,Default,,0,0,0,,Мен өтіп бара жатқан саяхатшымын
Dialogue: 0,0:12:08.67,0:12:11.30,Default,,0,0,0,,Себебі қатты жаңбырда адасып қалдым
Dialogue: 0,0:12:11.76,0:12:14.88,Default,,0,0,0,,Ол сенің орныңа рұқсатсыз кірген сияқты.
Dialogue: 0,0:12:15.30,0:12:16.14,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:18.22,0:12:20.52,Default,,0,0,0,,Мені тезірек шығара аласыз ба?
Dialogue: 0,0:14:04.58,0:14:06.41,Default,,0,0,0,,Бұл қорқынышты иіс
Dialogue: 0,0:14:23.18,0:14:24.60,Default,,0,0,0,,Егер сіз қатты шаршасаңыз
Dialogue: 0,0:14:24.93,0:14:27.27,Default,,0,0,0,,Оны тек қоқысқа тастаңыз.
Dialogue: 0,0:14:29.64,0:14:30.19,Default,,0,0,0,,бұған дейін
Dialogue: 0,0:14:30.35,0:14:33.81,Default,,0,0,0,,Мұны ұмытпаңыз
Dialogue: 0,0:14:43.78,0:14:46.99,Default,,0,0,0,,Жамандыққа түскенше басқаларға көп көмегін тигізді.
Dialogue: 0,0:14:48.62,0:14:49.58,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:17:29.62,0:17:37.58,Default,,0,0,0,,Өрт сөндіру бекеті
Dialogue: 0,0:17:51.62,0:17:53.58,Default,,0,0,0,,
Dialogue: 0,0:17:53.60,0:17:57.58,Default,,0,0,0,,
Dialogue: 0,0:18:59.04,0:19:02.00,Default,,0,0,0,,Алхор? Сізге тағы бір нәрсе керек пе?
Dialogue: 0,0:19:01.83,0:19:05.29,Default,,0,0,0,,Кешіріңіз, жас ханым, мен мұны осында қалдырып, дереу кетемін.
Dialogue: 0,0:19:22.77,0:19:23.85,Default,,0,0,0,,Жас жігіт!
Dialogue: 0,0:19:24.56,0:19:25.90,Default,,0,0,0,,Мацуйоши-чан!
Dialogue: 0,0:19:31.00,0:19:35.00,Default,,0,0,0,,Сәлем! Кездескенше!
Dialogue: 0,0:19:36.00,0:19:38.00,Default,,0,0,0,,Шашаша!
Dialogue: 0,0:19:40.04,0:19:41.50,Default,,0,0,0,,Өзіңізге қажетін алыңыз
Dialogue: 0,0:19:43.00,0:19:45.00,Default,,0,0,0,,Сәлем! Кездескенше! Шашаша!
Dialogue: 0,0:19:50.21,0:19:51.38,Default,,0,0,0,,Жас жігіт!
Dialogue: 0,0:19:51.63,0:19:53.09,Default,,0,0,0,,Мацуйоши-чан!
Dialogue: 0,0:20:07.77,0:20:09.15,Default,,0,0,0,,Сіз қара өрік пісіруге шебер емессіз.
Dialogue: 0,0:20:12.28,0:20:13.49,Default,,0,0,0,,Мен қараймын.
Dialogue: 0,0:20:18.78,0:20:19.83,Default,,0,0,0,,Түзетілді!
Dialogue: 0,0:20:20.04,0:20:21.33,Default,,0,0,0,,Садакикидон?
Dialogue: 0,0:20:21.75,0:20:22.79,Default,,0,0,0,,Эй
Dialogue: 0,0:20:23.96,0:20:25.08,Default,,0,0,0,,Өрт қай жерде?
Dialogue: 0,0:20:25.62,0:20:27.42,Default,,0,0,0,,Төбеде біреу тұр ма?
Dialogue: 0,0:20:27.46,0:20:29.34,Default,,0,0,0,,Эй, мен бір қарап алайын.
Dialogue: 0,0:20:34.88,0:20:36.00,Default,,0,0,0,,Хонджоның айналасында ма?
Dialogue: 0,0:20:36.00,0:20:38.47,Default,,0,0,0,,Жел солтүстік-батыстан соғады, сондықтан жақсы болуы керек.
Dialogue: 0,0:20:44.64,0:20:45.64,Default,,0,0,0,,Мацуйоши мырза!
Dialogue: 0,0:20:45.85,0:20:47.15,Default,,0,0,0,,Көрші үйдегі жас шебер!
Dialogue: 0,0:20:48.00,0:20:49.50,Default,,0,0,0,,Тынш!
Dialogue: 0,0:20:55.57,0:20:58.57,Default,,0,0,0,,Мацуёси мырзаның отты жақсы көруі де мәселе.
Dialogue: 0,0:20:58.57,0:20:59.87,Default,,0,0,0,,Мацуёси қайда кетті?
Dialogue: 0,0:21:00.41,0:21:03.20,Default,,0,0,0,,Жартылай қоңырау соғылғанда көзіңді алма дедім!
Dialogue: 0,0:21:03.58,0:21:05.00,Default,,0,0,0,,Бас кеңсе қызметкері Джихэй қайда кетті?
Dialogue: 0,0:21:05.71,0:21:10.34,Default,,0,0,0,,Басына біреуді жіберіп, отқа кіргізбеуін айт.
Dialogue: 0,0:21:11.67,0:21:14.17,Default,,0,0,0,,Бұл көп жұмысты қажет етті деп естідіңіз бе?
Dialogue: 0,0:21:14.17,0:21:16.09,Default,,0,0,0,,Сіз бұл туралы тағы айтып отырсыз ба?
Dialogue: 0,0:21:16.09,0:21:18.80,Default,,0,0,0,,Наритая ыдыс-аяқтары туралы қаншалықты пысық болса да, өте күрделі екендігімен танымал.
Dialogue: 0,0:21:22.89,0:21:24.93,Default,,0,0,0,,Енді, жігіт, сәлем берші.
Dialogue: 0,0:21:26.94,0:21:28.52,Default,,0,0,0,,Менің атым Вакана.
Dialogue: 0,0:21:36.70,0:21:39.32,Default,,0,0,0,,Мен сізге қарапайым адам сияқты істеу керек нәрселердің бәрін үйреттім.
Dialogue: 0,0:21:39.66,0:21:41.78,Default,,0,0,0,,Мен қиыншылықтың не екенін білмеймін.
Dialogue: 0,0:22:06.27,0:22:07.43,Default,,0,0,0,,[Жас жігіт! ]
Dialogue: 0,0:22:07.73,0:22:09.14,Default,,0,0,0,,[Мацуйоши-чан! ]
Dialogue: 0,0:22:14.48,0:22:15.19,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:22:16.40,0:22:18.53,Default,,0,0,0,,«Деніңізді, шашыңызды және теріңізді ата-анаңыз қабылдайды».
Dialogue: 0,0:22:19.03,0:22:21.70,Default,,0,0,0,,«Зиян келтіруге батылдық танытпау – перзенттік имандылықтың бастауы».
Dialogue: 0,0:22:21.87,0:22:23.12,Default,,0,0,0,,Сіз Мацуёсиді білесіз бе?
Dialogue: 0,0:22:24.62,0:22:27.79,Default,,0,0,0,,Бұл татуировкасы бар адамдар үстел басында отыратын Оми-я емес.
Dialogue: 0,0:22:28.71,0:22:29.33,Default,,0,0,0,,Бас тартылды!
Dialogue: 0,0:22:36.76,0:22:37.38,Default,,0,0,0,,Овака-чан
Dialogue: 0,0:22:37.84,0:22:38.97,Default,,0,0,0,,Мацуёси мырза!
Dialogue: 0,0:22:39.47,0:22:40.05,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:40.84,0:22:43.30,Default,,0,0,0,,Әкем ақыры менен бас тартты.
Dialogue: 0,0:22:43.97,0:22:44.64,Default,,0,0,0,,Өйткені
Dialogue: 0,0:22:44.85,0:22:47.06,Default,,0,0,0,,Мацуйоши жалғыз ұлыңыз емес пе?
Dialogue: 0,0:22:47.06,0:22:47.81,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:22:48.52,0:22:49.81,Default,,0,0,0,,Өйткені біз солай жасадық.
Dialogue: 0,0:22:50.31,0:22:51.48,Default,,0,0,0,,Енді мен өртті сөндіре аламын.
Dialogue: 0,0:22:52.31,0:22:55.19,Default,,0,0,0,,Мацуёси мырза бала кезінен солай болған.
Dialogue: 0,0:22:55.94,0:22:57.48,Default,,0,0,0,,Бірақ бұлай болса, жас жігіт
Dialogue: 0,0:22:58.07,0:23:01.36,Default,,0,0,0,,Мацуёси мырзамен кездескім келсе де, оны бірден көре алмас едім.
Dialogue: 0,0:23:01.86,0:23:02.57,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:23:03.24,0:23:04.03,Default,,0,0,0,,Мен сені көруге келемін.
Dialogue: 0,0:23:04.78,0:23:05.66,Default,,0,0,0,,Мацуёси мырза
Dialogue: 0,0:23:06.29,0:23:07.20,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:23:07.91,0:23:08.54,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:23:09.00,0:23:10.62,Default,,0,0,0,,Балалық шақтағы уәде
Dialogue: 0,0:23:11.29,0:23:12.12,Default,,0,0,0,,Бала кезіңізде?
Dialogue: 0,0:23:12.92,0:23:13.42,Default,,0,0,0,,Иә
Dialogue: 0,0:23:14.21,0:23:15.21,Default,,0,0,0,,Балалық шақ
Dialogue: 0,0:23:45.95,0:23:48.45,Default,,0,0,0,,[Құттықтаулар келесі айдың 3-інде қабылданды.]
Dialogue: 0,0:23:49.12,0:23:53.92,Default,,0,0,0,,[Оның алдында мен Кобики-чодағы ханымға барып, оби туралы сұрауым керек.]
Dialogue: 0,0:24:02.34,0:24:03.63,Default,,0,0,0,,Бұл бос құлақ па?
Dialogue: 0,0:24:18.90,0:24:20.03,Default,,0,0,0,,Мацуёси мырза
Dialogue: 0,0:25:25.51,0:25:26.22,Default,,0,0,0,,Өрік!
Dialogue: 0,0:25:26.72,0:25:27.55,Default,,0,0,0,,Жақсысың ба? Жүгіріп кету! Асығыңыз!
Dialogue: 0,0:25:28.34,0:25:30.22,Default,,0,0,0,,Бұл кедергі! Бұл кедергі! Жолдан кет!
Dialogue: 0,0:25:33.72,0:25:35.60,Default,,0,0,0,,Қарағай! Мацуёси сонда емес пе?
Dialogue: 0,0:25:35.85,0:25:36.98,Default,,0,0,0,,Әй, бас! Мұнда!
Dialogue: 0,0:25:37.35,0:25:38.77,Default,,0,0,0,,Өрттің көзі сіздің үйіңіздің жанында жатқан сияқты.
Dialogue: 0,0:25:38.90,0:25:40.69,Default,,0,0,0,,Шатырға шығып, қандай үйді бұзу керектігі туралы нұсқау бере аласыз ба?
Dialogue: 0,0:25:40.69,0:25:41.32,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:26:09.22,0:26:10.09,Default,,0,0,0,,Менің жыныс мүшесім
Dialogue: 0,0:26:10.84,0:26:11.60,Default,,0,0,0,,Овака-чанчимо
Dialogue: 0,0:26:13.97,0:26:16.10,Default,,0,0,0,,Тацуми тас қоймада біраз уақытқа созылады.
Dialogue: 0,0:26:16.68,0:26:19.19,Default,,0,0,0,,Солтүстік-батыс бұрыш пен жоғалған Ушитора қауіпті
Dialogue: 0,0:26:19.44,0:26:21.86,Default,,0,0,0,,Жолдың арғы жағында көп қабатты үйлер орналасқан.
Dialogue: 0,0:26:23.02,0:26:24.11,Default,,0,0,0,,Өрт сол жаққа таралса
Dialogue: 0,0:26:24.86,0:26:25.90,Default,,0,0,0,,Хонганджи храмына бір жалау
Dialogue: 0,0:26:26.23,0:26:28.45,Default,,0,0,0,,Уайымдама, мен саған хабарлаймын.
Dialogue: 0,0:26:33.95,0:26:34.49,Default,,0,0,0,,Вака-чан
Dialogue: 0,0:26:44.50,0:26:45.92,Default,,0,0,0,,Осы және анау баған.
Dialogue: 0,0:26:46.34,0:26:47.38,Default,,0,0,0,,Енді сәулені айналып өт
Dialogue: 0,0:26:52.76,0:26:53.72,Default,,0,0,0,,Жас жігіт!
Dialogue: 0,0:26:54.60,0:26:56.18,Default,,0,0,0,,Жас жігіт!
Dialogue: 0,0:27:00.06,0:27:00.98,Default,,0,0,0,,Мацуёси мырза?
Dialogue: 0,0:27:02.02,0:27:03.31,Default,,0,0,0,,Мацуйоши мырза!
Dialogue: 0,0:27:05.11,0:27:05.77,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:27:25.09,0:27:25.67,Default,,0,0,0,,бара алмаймын
Dialogue: 0,0:27:26.17,0:27:26.75,Default,,0,0,0,,Сол үй
Dialogue: 0,0:27:27.34,0:27:27.96,Default,,0,0,0,,Жас жігіт!
Dialogue: 0,0:27:28.42,0:27:29.76,Default,,0,0,0,,Онда барма!
Dialogue: 0,0:27:33.97,0:27:34.76,Default,,0,0,0,,Жас жігіт!
Dialogue: 0,0:27:41.77,0:27:43.02,Default,,0,0,0,,Жарайды, жабыңыз!
Dialogue: 0,0:27:58.95,0:28:01.16,Default,,0,0,0,,Сіз тым қатты тырысып жатырсыз ба?
Dialogue: 0,0:28:23.31,0:28:25.35,Default,,0,0,0,,Жоғарыға шықпаңыз!
Dialogue: 0,0:28:30.36,0:28:32.78,Default,,0,0,0,,Мацуйоши мырза!
Dialogue: 0,0:29:37.68,0:29:40.47,Default,,0,0,0,,Адамдардың не айтып жатқанын түсіне аласыз ба?
Dialogue: 0,0:29:41.81,0:29:44.14,Default,,0,0,0,,Мен естіген құбыжық
Dialogue: 0,0:29:45.85,0:29:48.73,Default,,0,0,0,,Өлтір, құбыжық.
Dialogue: 0,0:30:15.85,0:30:18.73,Default,,0,0,0,,ГАМБО
Dialogue: 0,0:30:24.60,0:30:27.14,Default,,0,0,0,,Ол әлдеқайда жақсырақ болды, солай емес пе?
Dialogue: 0,0:30:30.40,0:30:33.15,Default,,0,0,0,,Маған демалыс беріңіз, ауыл бастығы!
Dialogue: 0,0:30:33.40,0:30:36.44,Default,,0,0,0,,Айтпа! Күйеуіңізді қалдырыңыз
Dialogue: 0,0:30:36.53,0:30:38.40,Default,,0,0,0,,Бұл Могами-саманың бұйрығы.
Dialogue: 0,0:30:38.57,0:30:40.32,Default,,0,0,0,,Не айтсаң да!
Dialogue: 0,0:30:41.57,0:30:43.66,Default,,0,0,0,,Будданың мейірімділігі дегеніміз не?
Dialogue: 0,0:30:44.08,0:30:45.04,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:30:46.54,0:30:48.41,Default,,0,0,0,,Могами-сама сендермен трюк ойнайды
Dialogue: 0,0:30:48.91,0:30:51.25,Default,,0,0,0,,Олар атқыштар отрядын жіберуі керек.
Dialogue: 0,0:31:09.81,0:31:10.85,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:31:17.36,0:31:21.11,Default,,0,0,0,,Бұл ауылда алатын ештеңе қалмады.
Dialogue: 0,0:31:33.50,0:31:36.63,Default,,0,0,0,,Бұл жабайы самурайларға көмектесетін уақыт емес.
Dialogue: 0,0:31:40.26,0:31:44.01,Default,,0,0,0,,Бұл жын ақ аю болуы мүмкін бе?
Dialogue: 0,0:31:46.43,0:31:51.06,Default,,0,0,0,,Жоқ. Бұл биіктігі 10 фут үлкен қызыл жын тәрізді құбыжық.
Dialogue: 0,0:31:51.56,0:31:52.60,Default,,0,0,0,,Канжу Нагаре
Dialogue: 0,0:31:53.27,0:31:57.40,Default,,0,0,0,,Маған көмектескеніңіз үшін алғыс айтпаймын, бірақ жындыны жойыңыз.
Dialogue: 0,0:31:57.94,0:32:01.86,Default,,0,0,0,,Содан бері әр түнде жын шығады.
Dialogue: 0,0:32:01.86,0:32:03.61,Default,,0,0,0,,Ол қызымды ұрлап әкетті.
Dialogue: 0,0:32:03.78,0:32:07.87,Default,,0,0,0,,Сол қыз бұл ауылдан соңғы болып кеткен.
Dialogue: 0,0:32:08.99,0:32:13.29,Default,,0,0,0,,Оны беруден басқа амалым жоқ.
Dialogue: 0,0:32:14.83,0:32:15.83,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:32:16.58,0:32:18.21,Default,,0,0,0,,Ондай нәрсемен ешкім бәсекелесе алмайды.
Dialogue: 0,0:32:19.34,0:32:20.17,Default,,0,0,0,,Чао!
Dialogue: 0,0:32:25.01,0:32:28.10,Default,,0,0,0,,Самурай-сама, өтінемін.
Dialogue: 0,0:32:28.39,0:32:34.48,Default,,0,0,0,,Тәңір де, Будда да жоқ, самурайға жабысудан басқа амалымыз жоқ.
Dialogue: 0,0:33:19.52,0:33:20.19,Default,,0,0,0,,Аю!
Dialogue: 0,0:33:32.45,0:33:35.25,Default,,0,0,0,,Мен көмектесе алмаймын...Мен көмектесе алмаймын
Dialogue: 0,0:33:56.35,0:33:57.52,Default,,0,0,0,,Жын келді
Dialogue: 0,0:34:00.81,0:34:01.61,Default,,0,0,0,,Маған көмектесіңізші...?
Dialogue: 0,0:34:19.29,0:34:20.21,Default,,0,0,0,,Гумбо?
Dialogue: 0,0:34:35.22,0:34:37.27,Default,,0,0,0,,Оме ва варасу
Dialogue: 0,0:34:56.83,0:34:59.08,Default,,0,0,0,,Жалғыз болу қауіпті!
Dialogue: 0,0:35:13.68,0:35:15.72,Default,,0,0,0,,Сіз құдайдың елшісісіз бе?
Dialogue: 0,0:35:41.41,0:35:42.87,Default,,0,0,0,,Өтінемін, мені өлтіріңіз
Dialogue: 0,0:35:43.42,0:35:44.63,Default,,0,0,0,,Достар...?
Dialogue: 0,0:35:47.71,0:35:50.05,Default,,0,0,0,,Бұл жігіттер жын балалар!
Dialogue: 0,0:35:53.43,0:35:57.26,Default,,0,0,0,,Туғанға дейін
Dialogue: 0,0:35:57.60,0:36:00.48,Default,,0,0,0,,Мені өлтір! Өтінемін
Dialogue: 0,0:37:04.25,0:37:09.71,Default,,0,0,0,,Қорқыныштысың... Қорқыныштысың... Қазірдің өзінде тоқтат!
Dialogue: 0,0:37:11.21,0:37:12.92,Default,,0,0,0,,Қарамаңдар, дұға етіңдер!
Dialogue: 0,0:37:15.09,0:37:16.80,Default,,0,0,0,,Бұл сіз іздеген құтқару.
Dialogue: 0,0:37:17.55,0:37:19.26,Default,,0,0,0,,Соңына дейін сеніңіз
Dialogue: 0,0:37:19.55,0:37:20.22,Default,,0,0,0,,Бірақ
Dialogue: 0,0:37:23.22,0:37:27.10,Default,,0,0,0,,Намаз оқысаң, өлтіру ниетімен оқы!
Dialogue: 0,0:37:41.08,0:37:42.45,Default,,0,0,0,,Ібіліс!
Dialogue: 0,0:38:54.82,0:38:55.82,Default,,0,0,0,,Ату!
Dialogue: 0,0:39:53.83,0:39:55.79,Default,,0,0,0,,Рахмет Гумбо!
Dialogue: 0,0:40:04.64,0:40:05.43,Default,,0,0,0,,Не?
Dialogue: 0,0:40:12.31,0:40:15.61,Default,,0,0,0,,Түсіндіріңіз. Бұл ақ аю кім?
Dialogue: 0,0:40:17.61,0:40:20.11,Default,,0,0,0,,Мүмкін... Мен сенбеймін деп ойлаймын.
Dialogue: 0,0:41:42.19,0:41:44.61,Default,,0,0,0,,Сонымен, сіз әскери қызметтен босағаннан кейін өмір сүресіз бе?
Dialogue: 0,0:41:48.57,0:41:51.33,Default,,0,0,0,,Джин мырзаның бойы ұзын болғандықтан, оған көп жалақы алады деп ойлаймын.
Dialogue: 0,0:41:54.75,0:41:56.58,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,0:41:59.54,0:42:02.21,Default,,0,0,0,,Не? Сіз оны әлдеқашан қолдандыңыз ба?
Dialogue: 0,0:42:06.17,0:42:08.68,Default,,0,0,0,,30 гектарға жуық жүзімдіктер.
Dialogue: 0,0:42:15.10,0:42:15.85,Default,,0,0,0,,Бұл шарап па?
Dialogue: 0,0:42:24.36,0:42:25.61,Default,,0,0,0,,Әй, қолымнан келсе жіберемін.
Dialogue: 0,0:42:30.41,0:42:31.91,Default,,0,0,0,,Мен мұны асыға күтемін.
Dialogue: 0,0:42:39.62,0:42:41.50,Default,,0,0,0,,Тірі болсам ше...
Dialogue: 0,0:42:44.46,0:42:47.34,Default,,0,0,0,,Ей, бүгінгі жұмыс тек қоқыс іздеу.
Dialogue: 0,0:42:47.42,0:42:50.13,Default,,0,0,0,,Ол тіпті бір себет бутерброд әкелді.
Dialogue: 0,0:42:50.84,0:42:54.14,Default,,0,0,0,,Бұл жаяу серуендеуге өте көңілсіз жер.
Dialogue: 0,0:43:17.75,0:43:23.67,Default,,0,0,0,,Қарумен қоштасу
Dialogue: 0,0:43:29.51,0:43:30.30,Default,,0,0,0,,Жақсы аулау
Dialogue: 0,0:43:30.47,0:43:32.18,Default,,0,0,0,,Барлау ұшағына қош келдіңіз!
Dialogue: 0,0:43:32.18,0:43:34.01,Default,,0,0,0,,Уау камера камерасы!
Dialogue: 0,0:43:34.51,0:43:36.47,Default,,0,0,0,,Мен келесісін іске қосамын, сондықтан оны алып тастаңыз.
Dialogue: 0,0:43:36.93,0:43:38.02,Default,,0,0,0,,Уа!
Dialogue: 0,0:43:41.48,0:43:42.69,Default,,0,0,0,,Жақсы жұмыс Junkie
Dialogue: 0,0:43:43.23,0:43:44.06,Default,,0,0,0,,Чис!
Dialogue: 0,0:43:44.36,0:43:45.31,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:43:45.61,0:43:48.19,Default,,0,0,0,,Келу үшін шамамен 5 минут кетеді.
Dialogue: 0,0:43:48.53,0:43:50.86,Default,,0,0,0,,Біз келгенде, біз бірінші орындайтын нәрсе - UAV ұшыру.
Dialogue: 0,0:43:51.45,0:43:52.41,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:44:01.16,0:44:05.71,Default,,0,0,0,,Бұл қорғаныс костюмі әрқашан ыстық көрінеді.
Dialogue: 0,0:44:06.04,0:44:08.67,Default,,0,0,0,,Оның кондиционері бар.
Dialogue: 0,0:44:08.92,0:44:10.05,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:44:10.46,0:44:12.59,Default,,0,0,0,,Мониторға қараңыз.
Dialogue: 0,0:44:18.68,0:44:21.02,Default,,0,0,0,,Әй, алға қара, ақымақ!
Dialogue: 0,0:44:21.02,0:44:22.64,Default,,0,0,0,,Жоқ, мен артқа қарап тұрдым.
Dialogue: 0,0:44:22.64,0:44:25.89,Default,,0,0,0,,- Айтқың келгені бұл емес - Дұрыс.
Dialogue: 0,0:44:26.02,0:44:27.40,Default,,0,0,0,,- Мүлдем... - Жаман болды.
Dialogue: 0,0:44:29.48,0:44:30.86,Default,,0,0,0,,Ей, бұлай тынымсыз болма.
Dialogue: 0,0:44:32.61,0:44:34.57,Default,,0,0,0,,Жүр... кеттік
Dialogue: 0,0:44:35.20,0:44:38.12,Default,,0,0,0,,Құлаған туннельге кіріңіз
Dialogue: 0,0:44:38.12,0:44:42.12,Default,,0,0,0,,500 метрдей жерде сіз затты іздеу керек нүкте.
Dialogue: 0,0:44:40.87,0:44:42.37,Default,,0,0,0,,Қош қорықпаңыз
Dialogue: 0,0:44:44.42,0:44:45.62,Default,,0,0,0,,Марле, аяғың мықты болсын.
Dialogue: 0,0:44:45.79,0:44:46.42,Default,,0,0,0,,Иә
Dialogue: 0,0:44:51.34,0:44:53.42,Default,,0,0,0,,Лейтенант, не болды?
Dialogue: 0,0:44:53.59,0:44:55.97,Default,,0,0,0,,Жарайды, Марле бақаны басты.
Dialogue: 0,0:44:56.05,0:44:57.60,Default,,0,0,0,,Қараңдаршы, мына жерде.
Dialogue: 0,0:44:57.68,0:44:58.64,Default,,0,0,0,,Мені қорқытпа
Dialogue: 0,0:45:04.02,0:45:04.81,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:45:05.31,0:45:07.65,Default,,0,0,0,,Лейтенант, абай болыңыз.
Dialogue: 0,0:45:07.73,0:45:10.07,Default,,0,0,0,,Енді жылу көзі пайда болды.
Dialogue: 0,0:45:18.37,0:45:20.70,Default,,0,0,0,,Жарайды, құрылыс алаңын өзгертейік.
Dialogue: 0,0:45:21.49,0:45:23.20,Default,,0,0,0,,Барлығың тыңдаңдар!
Dialogue: 0,0:45:24.08,0:45:25.66,Default,,0,0,0,,Батыстағы қирандыларда бір нәрсе жасырынып жатыр.
Dialogue: 0,0:45:25.96,0:45:26.92,Default,,0,0,0,,Бұл ұшқышсыз қарудың бір түрі.
Dialogue: 0,0:45:29.63,0:45:31.17,Default,,0,0,0,,Жер астын зерттемес бұрын серуендеу
Dialogue: 0,0:45:31.63,0:45:33.34,Default,,0,0,0,,Мен оны әдеттегідей орнатамын.
Dialogue: 0,0:45:33.88,0:45:35.42,Default,,0,0,0,,Маған басқа ұшқышсыз ұшақ беріңіз.
Dialogue: 0,0:45:35.67,0:45:36.93,Default,,0,0,0,,Жау қазірдің өзінде қозғалыста.
Dialogue: 0,0:45:37.55,0:45:38.59,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:45:47.48,0:45:48.48,Default,,0,0,0,,Бұл Марл.
Dialogue: 0,0:45:48.69,0:45:50.40,Default,,0,0,0,,Оң жақтағы ақ ғимаратқа көтеріліңіз
Dialogue: 0,0:45:50.69,0:45:52.07,Default,,0,0,0,,Гимлет түсінді
Dialogue: 0,0:46:03.16,0:46:04.37,Default,,0,0,0,,Жүр, кеттік!
Dialogue: 0,0:46:05.62,0:46:06.46,Default,,0,0,0,,Курс
Dialogue: 0,0:46:07.21,0:46:09.42,Default,,0,0,0,,Бекітілген
Dialogue: 0,0:46:18.93,0:46:19.89,Default,,0,0,0,,Бұл Джин
Dialogue: 0,0:46:19.89,0:46:22.01,Default,,0,0,0,,Қиылыс орны лайықты.
Dialogue: 0,0:46:40.82,0:46:43.20,Default,,0,0,0,,Бұл Рам, біз мергендік нүктені бекіттік.
Dialogue: 0,0:46:43.33,0:46:43.91,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:46:45.04,0:46:46.16,Default,,0,0,0,,Бұл тез, Рам.
Dialogue: 0,0:46:46.37,0:46:47.87,Default,,0,0,0,,Параметрлерді аяқтап, күтіңіз.
Dialogue: 0,0:46:49.04,0:46:50.54,Default,,0,0,0,,Junkie Сіз маған оқиға орнынан деректерді бере аласыз ба?
Dialogue: 0,0:46:50.54,0:46:55.38,Default,,0,0,0,,Жау шығысқа қарай жылжиды, көшеге шықсаңыз, оны осы жерден көре аласыз.
Dialogue: 0,0:46:55.67,0:46:56.76,Default,,0,0,0,,Сіз тозақ отын ата аласыз ба?
Dialogue: 0,0:46:57.05,0:46:57.84,Default,,0,0,0,,Кез келген уақытта
Dialogue: 0,0:46:57.88,0:46:58.92,Default,,0,0,0,,Жарайды, нұсқауларды күтіңіз.
Dialogue: 0,0:47:00.43,0:47:01.43,Default,,0,0,0,,Марле ше?
Dialogue: 0,0:47:01.59,0:47:03.39,Default,,0,0,0,,Бұл Марле, қозғалыста.
Dialogue: 0,0:47:03.43,0:47:04.93,Default,,0,0,0,,Үш ұшқышсыз ұшақ ұшырылды
Dialogue: 0,0:47:05.26,0:47:05.93,Default,,0,0,0,,Түсінді.
Dialogue: 0,0:47:06.31,0:47:07.60,Default,,0,0,0,,Джин Жағдайды хабарлау.
Dialogue: 0,0:47:07.77,0:47:09.31,Default,,0,0,0,,Бұл соңғысы.
Dialogue: 0,0:47:09.31,0:47:11.60,Default,,0,0,0,,Мұны орнатқаннан кейін, ату нүктесіне өтіңіз.
Dialogue: 0,0:47:11.77,0:47:12.65,Default,,0,0,0,,Жалғастыруыңызды өтінеміз.
Dialogue: 0,0:47:13.23,0:47:14.11,Default,,0,0,0,,Қалаулыны жіберу
Dialogue: 0,0:47:14.52,0:47:15.65,Default,,0,0,0,,Бұл лас
Dialogue: 0,0:47:15.65,0:47:17.19,Default,,0,0,0,,Тозақ отын бірден тастаңыз
Dialogue: 0,0:47:17.74,0:47:19.78,Default,,0,0,0,,Түсіндім, мен тозақ отын тастаймын.
Dialogue: 0,0:47:27.54,0:47:28.87,Default,,0,0,0,,Жунки, енді ше?
Dialogue: 0,0:47:29.41,0:47:30.29,Default,,0,0,0,,Иә
Dialogue: 0,0:47:33.21,0:47:34.75,Default,,0,0,0,,Бұл Гонк па?
Dialogue: 0,0:47:39.38,0:47:40.63,Default,,0,0,0,,Барлығыңызды тыңдаңыз! Бұл гимлет
Dialogue: 0,0:47:41.38,0:47:42.34,Default,,0,0,0,,Бомбалау сәтсіз аяқталды
Dialogue: 0,0:47:42.34,0:47:43.59,Default,,0,0,0,,Жау осы жолмен келе жатыр.
Dialogue: 0,0:47:44.22,0:47:45.60,Default,,0,0,0,,Бейнежазбаны қарасаңыз, бұл өздігінен жүретін резервуар.
Dialogue: 0,0:47:46.06,0:47:47.22,Default,,0,0,0,,Бірақ біз үйренген нәрсені жасайық.
Dialogue: 0,0:47:48.14,0:47:49.43,Default,,0,0,0,,Мен де позицияларды жылжытамын
Dialogue: 0,0:47:49.93,0:47:51.10,Default,,0,0,0,,Марле, оған дейін сергек болыңыз.
Dialogue: 0,0:47:55.27,0:47:56.48,Default,,0,0,0,,Бұл Марл
Dialogue: 0,0:47:56.48,0:47:57.11,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:47:59.19,0:48:00.82,Default,,0,0,0,,Сіз оны қазір көре аласыз
Dialogue: 0,0:48:06.41,0:48:07.37,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:48:07.37,0:48:09.41,Default,,0,0,0,,Лазерлік көрсеткіш белгісі
Dialogue: 0,0:48:14.00,0:48:15.50,Default,,0,0,0,,Сіз не істеп жатырсыз? !
Dialogue: 0,0:48:17.21,0:48:18.17,Default,,0,0,0,,Марле, жақсысың ба?
Dialogue: 0,0:48:19.09,0:48:20.51,Default,,0,0,0,,Лазерлік таңбаланған!
Dialogue: 0,0:48:20.96,0:48:23.13,Default,,0,0,0,,Сіз өз жұмысыңызды орындаған сияқтысыз.
Dialogue: 0,0:48:23.59,0:48:26.35,Default,,0,0,0,,...
Dialogue: 0,0:48:26.76,0:48:28.64,Default,,0,0,0,,Marl жүйесін тексеру.
Dialogue: 0,0:48:28.76,0:48:29.89,Default,,0,0,0,,Мен оны жай ғана іске қостым.
Dialogue: 0,0:48:29.89,0:48:31.14,Default,,0,0,0,,Барлығы жасыл
Dialogue: 0,0:48:31.85,0:48:32.98,Default,,0,0,0,,Бұл нақты нәрсе, бастайық.
Dialogue: 0,0:48:32.98,0:48:34.85,Default,,0,0,0,,Түсіндім, біріншісін тастаймын.
Dialogue: 0,0:48:35.60,0:48:36.27,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:48:36.40,0:48:36.94,Default,,0,0,0,,Жарылысқа 4 секунд қалды
Dialogue: 0,0:48:37.11,0:48:39.00,Default,,0,0,0,,3...2
Dialogue: 0,0:48:40.00,0:48:41.00,Default,,0,0,0,,1
Dialogue: 0,0:48:52.29,0:48:54.00,Default,,0,0,0,,Бұл қошқар іздеуші соққы.
Dialogue: 0,0:48:54.29,0:48:55.42,Default,,0,0,0,,Келесі ғимаратқа көшу
Dialogue: 0,0:48:55.54,0:48:56.04,Default,,0,0,0,,Жарайды
Dialogue: 0,0:49:13.23,0:49:15.64,Default,,0,0,0,,Бұл Марл, мен екіншісін тастаймын.
Dialogue: 0,0:49:18.81,0:49:20.69,Default,,0,0,0,,Жарайды, жүр!
Dialogue: 0,0:49:20.77,0:49:25.00,Default,,0,0,0,,4...3...2...1 жарылысқа дейін
Dialogue: 0,0:49:38.42,0:49:39.54,Default,,0,0,0,,Рам, жақсысың ба?
Dialogue: 0,0:49:40.00,0:49:42.80,Default,,0,0,0,,Екіншісін түсіру және қозғалу
Dialogue: 0,0:50:00.56,0:50:02.57,Default,,0,0,0,,Қошқар!
Dialogue: 0,0:50:17.04,0:50:18.58,Default,,0,0,0,,Мәжбүрлі разряд!
Dialogue: 0,0:50:22.63,0:50:24.30,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:50:28.34,0:50:29.55,Default,,0,0,0,,Қошқар!
Dialogue: 0,0:50:39.48,0:50:40.23,Default,,0,0,0,,Шытыр, сытыр, шырыл, шапыр, шапыр, шытыр, шатыр, шашыра!
Dialogue: 0,0:50:40.85,0:50:41.94,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:50:42.27,0:50:43.32,Default,,0,0,0,,деп ойладым
Dialogue: 0,0:50:44.44,0:50:46.74,Default,,0,0,0,,Джин, Снуптың тесігін жаб, мен сені қолдаймын.
Dialogue: 0,0:50:54.45,0:50:55.83,Default,,0,0,0,,Гимлет!
Dialogue: 0,0:50:55.83,0:50:56.83,Default,,0,0,0,,Джин, өтінемін!
Dialogue: 0,0:50:56.83,0:50:57.50,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:51:00.46,0:51:01.50,Default,,0,0,0,,Керемет!
Dialogue: 0,0:51:11.72,0:51:13.55,Default,,0,0,0,,Джин мырза, асығыңыз!
Dialogue: 0,0:51:13.97,0:51:16.47,Default,,0,0,0,,Джин, қанықтыру шабуылына қалай дайындалып жатырсың?
Dialogue: 0,0:51:17.02,0:51:18.18,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,0:51:20.77,0:51:22.23,Default,,0,0,0,,Қат! Junkie!
Dialogue: 0,0:51:22.81,0:51:25.48,Default,,0,0,0,,Бұл Junkie, Тозақ оты әрқашан жақсы.
Dialogue: 0,0:51:25.57,0:51:27.48,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:51:29.65,0:51:30.53,Default,,0,0,0,,Жарайды, Гимлет.
Dialogue: 0,0:51:32.99,0:51:33.82,Default,,0,0,0,,Жаса!
Dialogue: 0,0:51:33.95,0:51:34.62,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:51:40.00,0:51:41.08,Default,,0,0,0,,Junkie Сіз оны көре аласыз ба?
Dialogue: 0,0:51:41.08,0:51:41.71,Default,,0,0,0,,Иә
Dialogue: 0,0:51:41.87,0:51:42.58,Default,,0,0,0,,Жаса!
Dialogue: 0,0:51:42.58,0:51:43.67,Default,,0,0,0,,Тозақ отының тамшысы
Dialogue: 0,0:51:45.54,0:51:46.46,Default,,0,0,0,,Бұл басталды!
Dialogue: 0,0:51:46.80,0:51:48.34,Default,,0,0,0,,Чикусо!
Dialogue: 0,0:51:51.43,0:51:53.09,Default,,0,0,0,,Ой, бейбақ!
Dialogue: 0,0:51:55.76,0:51:56.81,Default,,0,0,0,,Мен мұны байқадым!
Dialogue: 0,0:51:56.93,0:51:58.14,Default,,0,0,0,,Қошқар! Атпа!
Dialogue: 0,0:51:58.68,0:51:59.77,Default,,0,0,0,,Шулы!
Dialogue: 0,0:52:21.16,0:52:22.71,Default,,0,0,0,,Гонк реакциясы жойылды
Dialogue: 0,0:52:27.84,0:52:29.21,Default,,0,0,0,,Ол ештеңе білмесе де, оны әлі де кепілге алуға болады
Dialogue: 0,0:52:29.67,0:52:31.26,Default,,0,0,0,,Не болып жатыр? Эй!
Dialogue: 0,0:52:48.98,0:52:50.69,Default,,0,0,0,,Менің ойымша, бұл жер астында...
Dialogue: 0,0:52:51.40,0:52:52.61,Default,,0,0,0,,Көңіл-күйлеріңізді көтеріңіз
Dialogue: 0,0:52:53.36,0:52:55.20,Default,,0,0,0,,Міне, нағыз іс бүгін басталады.
Dialogue: 0,0:53:08.25,0:53:10.96,Default,,0,0,0,,Қайырлы кеш, бұл Токио Розасы.
Dialogue: 0,0:53:10.96,0:53:12.92,Default,,0,0,0,,Не туралы айтып тұрғаныңызды түсіну қиын.
Dialogue: 0,0:53:13.34,0:53:14.97,Default,,0,0,0,,Қабылдау жақсы Junkie
Dialogue: 0,0:53:15.59,0:53:17.68,Default,,0,0,0,,Біз осы жерден бөлініп, іздеуді бастаймыз.
Dialogue: 0,0:53:18.01,0:53:19.85,Default,,0,0,0,,Рам мен Марлды шығыстан іздеңіз.
Dialogue: 0,0:53:20.01,0:53:20.81,Default,,0,0,0,,...
Dialogue: 0,0:53:21.14,0:53:22.14,Default,,0,0,0,,Біз батысты айналып өтеміз
Dialogue: 0,0:53:22.31,0:53:23.02,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:53:24.02,0:53:26.10,Default,,0,0,0,,Сіз оны Марленың радиобасқаруымен таба алмайсыз ба?
Dialogue: 0,0:53:26.69,0:53:28.27,Default,,0,0,0,,Бұл сақтық үшін.
Dialogue: 0,0:53:28.48,0:53:29.23,Default,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:53:30.57,0:53:33.57,Default,,0,0,0,,- О, жігіт - бұл балаларда жақсы жолақтар бар
Dialogue: 0,0:53:34.07,0:53:36.53,Default,,0,0,0,,Сонда Джин-сан кетсе де, сенің қолыңнан келеді ме?
Dialogue: 0,0:53:37.61,0:53:39.20,Default,,0,0,0,,Сәттілік, капитан-сан.
Dialogue: 0,0:53:42.62,0:53:47.37,Default,,0,0,0,,Дәл қазір артиллериялық оқ арқылы жүгіру сізге де зиян тигізетінін түсіндіңіз бе?
Dialogue: 0,0:53:47.58,0:53:49.63,Default,,0,0,0,,Бірақ тренингте бізді достарымызды тастамауға үйретті.
Dialogue: 0,0:53:49.67,0:53:51.17,Default,,0,0,0,,Идиот! Мені ешкім мақтамайды
Dialogue: 0,0:53:51.71,0:53:52.67,Default,,0,0,0,,Рахмет айтпа!
Dialogue: 0,0:54:10.77,0:54:13.28,Default,,0,0,0,,Бұл Марле, біз нысананы таптық.
Dialogue: 0,0:54:14.86,0:54:17.74,Default,,0,0,0,,Бұл арнайы оқтұмсық па? Мен бұл шынымен бар деп ойламаймын.
Dialogue: 0,0:54:34.59,0:54:37.34,Default,,0,0,0,,Бұл Марл, мен TL-ге кірдім.
Dialogue: 0,0:54:38.18,0:54:41.33,Default,,0,0,0,,Жақсы жұмыс Кіруді бастаңыз Мен жақын арада боламын
Dialogue: 0,0:54:41.34,0:54:43.26,Default,,0,0,0,,Junkie, журналдарды дереу құрастыра аласыз ба?
Dialogue: 0,0:54:44.26,0:54:44.68,Default,,0,0,0,,Қалаусыз ба?
Dialogue: 0,0:54:45.68,0:54:46.39,Default,,0,0,0,,Не болды? Junkie!
Dialogue: 0,0:54:46.73,0:54:47.85,Default,,0,0,0,,Бұл Гимлет, жібер!
Dialogue: 0,0:54:49.02,0:54:51.23,Default,,0,0,0,,Марле, жауап бер. Бұл Гимлет.
Dialogue: 0,0:54:51.98,0:54:53.27,Default,,0,0,0,,Бұл Марл
Dialogue: 0,0:54:53.86,0:54:54.90,Default,,0,0,0,,Есімшімен байланысу мүмкін емес
Dialogue: 0,0:54:55.19,0:54:56.86,Default,,0,0,0,,Жерді дереу іздеуге барлаушыларды жіберіңіз.
Dialogue: 0,0:54:57.74,0:54:59.49,Default,,0,0,0,,Жерде ме?
Dialogue: 0,0:54:59.74,0:55:00.57,Default,,0,0,0,,Сәлем Мар!
Dialogue: 0,0:55:07.45,0:55:08.79,Default,,0,0,0,,Қайтадан ұпай жинау.
Dialogue: 0,0:55:09.21,0:55:09.75,Default,,0,0,0,,Мен бүгін твиттер жазып жатырмын.
Dialogue: 0,0:55:10.17,0:55:11.37,Default,,0,0,0,,Джин
Dialogue: 0,0:55:11.40,0:55:14.29,Default,,0,0,0,,- Марл тағы да? - Джин мырза, нашақордан жауап жоқ. Менде жағымсыз сезім бар. Мен жақында жерде боламын!
Dialogue: 0,0:55:22.84,0:55:23.26,Default,,0,0,0,,Қошқар!
Dialogue: 0,0:55:24.89,0:55:27.47,Default,,0,0,0,,Менің буындарым... қозғалмайды.
Dialogue: 0,0:55:29.60,0:55:31.56,Default,,0,0,0,,Жат! Бұл бұрынғы Гонк!
Dialogue: 0,0:55:33.11,0:55:33.86,Default,,0,0,0,,Гимлет!
Dialogue: 0,0:55:34.15,0:55:34.98,Default,,0,0,0,,Іске қосқышты орнатыңыз
Dialogue: 0,0:55:35.44,0:55:36.48,Default,,0,0,0,,Марле, жақсысың ба?
Dialogue: 0,0:55:36.86,0:55:38.90,Default,,0,0,0,,Қозғалыс машинасы қатып қалады!
Dialogue: 0,0:55:39.36,0:55:39.90,Default,,0,0,0,,Түтін!
Dialogue: 0,0:55:40.28,0:55:40.99,Default,,0,0,0,,Күте тұрыңыз, Марл!
Dialogue: 0,0:55:40.99,0:55:41.66,Default,,0,0,0,,Сол жерде атсаңыз да
Dialogue: 0,0:55:42.50,0:55:44.00,Default,,0,0,0,,Разряд!
Dialogue: 0,0:55:46.12,0:55:47.12,Default,,0,0,0,,Қошқар!
Dialogue: 0,0:55:54.84,0:55:55.38,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:56:01.17,0:56:02.22,Default,,0,0,0,,Гимлет!
Dialogue: 0,0:56:08.39,0:56:09.56,Default,,0,0,0,,Рамға не болды?
Dialogue: 0,0:56:09.60,0:56:10.73,Default,,0,0,0,,Буланған
Dialogue: 0,0:56:11.39,0:56:13.56,Default,,0,0,0,,Gimlet UAV-дан бейне!
Dialogue: 0,0:56:13.73,0:56:17.23,Default,,0,0,0,,Нашақор! Junkie! Сен тірісің бе? Junkie!
Dialogue: 0,0:56:18.40,0:56:20.07,Default,,0,0,0,,Бұл Джин, мен артқа кеттім.
Dialogue: 0,0:56:21.07,0:56:22.11,Default,,0,0,0,,Электромагниттік гранаталарды қолданыңыз!
Dialogue: 0,0:56:22.45,0:56:22.99,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:56:24.61,0:56:25.74,Default,,0,0,0,,Мен және Марле оны бақылауда ұстаймыз
Dialogue: 0,0:56:26.03,0:56:27.78,Default,,0,0,0,,Біз үш санаймыз, сондықтан уақытты дұрыс белгілеңіз!
Dialogue: 0,0:56:28.58,0:56:29.91,Default,,0,0,0,,Электромагниттік импульс қолданылса, оны ұсақтаңыз
Dialogue: 0,0:56:31.33,0:56:32.91,Default,,0,0,0,,Марле TL-ді жоюы керек
Dialogue: 0,0:56:34.58,0:56:35.96,Default,,0,0,0,,Осымен біз оқтұмсықты қайтара алмаймыз.
Dialogue: 0,0:56:36.29,0:56:37.84,Default,,0,0,0,,Бұл жағдайда сіздің міндетіңіз оны жою.
Dialogue: 0,0:56:38.25,0:56:42.38,Default,,0,0,0,,Жарайсың ба? 1...2...3 жүрейік!
Dialogue: 0,0:56:53.02,0:56:54.27,Default,,0,0,0,,Марл? ше? Марл!
Dialogue: 0,0:56:58.69,0:56:59.90,Default,,0,0,0,,Марл! Орындалды ма?
Dialogue: 0,0:57:01.23,0:57:02.78,Default,,0,0,0,,Жоқ... сәл ғана
Dialogue: 0,0:57:06.62,0:57:08.62,Default,,0,0,0,,TL-ді қазір жойыңыз
Dialogue: 0,0:57:09.03,0:57:13.04,Default,,0,0,0,,Сақтандырғышты құлыптаңыз және оқтұмсықты жағу үшін күшейткішті жағыңыз.
Dialogue: 0,0:57:15.08,0:57:15.79,Default,,0,0,0,,Иә
Dialogue: 0,0:57:17.13,0:57:20.21,Default,,0,0,0,,Бұл Джин, Гонктың ұшырғышын сындырыңыз.
Dialogue: 0,0:57:20.25,0:57:22.21,Default,,0,0,0,,Сол жерден негізгі мылтықты жойыңыз.
Dialogue: 0,0:57:26.97,0:57:29.55,Default,,0,0,0,,Бұл Марл, мен TL-ге кірдім.
Dialogue: 0,0:57:30.01,0:57:32.68,Default,,0,0,0,,Мен күшейткіш дайын болғанда хабарлаймын.
Dialogue: 0,0:57:36.69,0:57:37.65,Default,,0,0,0,,Тезірек, Марле!
Dialogue: 0,0:57:37.94,0:57:39.73,Default,,0,0,0,,Гонк қайта іске қосылса, ол бірден жарылып кетеді.
Dialogue: 0,0:57:41.94,0:57:45.24,Default,,0,0,0,,Гимлет! Негізгі мылтықты майданнан жойыңыз
Dialogue: 0,0:57:46.53,0:57:47.74,Default,,0,0,0,,Бұл соқыр нүкте
Dialogue: 0,0:57:47.78,0:57:49.07,Default,,0,0,0,,Кешіріңіз, менде қиындық туындады. Бұл туралы бірдеңе жасаңыз.
Dialogue: 0,0:57:49.07,0:57:49.74,Default,,0,0,0,,Бұл Марл.
Dialogue: 0,0:57:50.03,0:57:52.09,Default,,0,0,0,,Төбесі үйіндімен жабылған.
Dialogue: 0,0:57:52.09,0:57:54.44,Default,,0,0,0,,Күшейткіш тұтанбайды! Мен оны алып тастауға кеттім!
Dialogue: 0,0:57:54.45,0:57:56.29,Default,,0,0,0,,Жарайды, абай болыңыз! Асығыңыз!
Dialogue: 0,0:58:01.71,0:58:05.05,Default,,0,0,0,,Гимлет Әлі емес пе? ! Гонк қайта іске қосылғалы тұр
Dialogue: 0,0:58:07.18,0:58:09.76,Default,,0,0,0,,Кешіріңіз, толықсы әдемі болып шықты.
Dialogue: 0,0:58:20.15,0:58:22.69,Default,,0,0,0,,Марл! джин!
Dialogue: 0,0:58:47.34,0:58:48.38,Default,,0,0,0,,Марл! Жүгіріп кету!
Dialogue: 0,0:58:59.98,0:59:00.56,Default,,0,0,0,,Джин!
Dialogue: 0,0:59:11.95,0:59:13.78,Default,,0,0,0,,Джин, қаш! джин!
Dialogue: 0,1:00:28.15,1:00:29.65,Default,,0,0,0,,Капитан Гимлет
Dialogue: 0,1:00:31.57,1:00:33.03,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз оятуға болады деп ойлайсыз ба?
Dialogue: 0,1:00:38.91,1:00:39.74,Default,,0,0,0,,Дүрбелең емес!
Dialogue: 0,1:00:39.91,1:00:41.37,Default,,0,0,0,,Алдымен өртті сөндір, содан кейін қаш
Dialogue: 0,1:00:41.70,1:00:44.04,Default,,0,0,0,,Иә... Қашу
Dialogue: 0,1:00:49.46,1:00:51.17,Default,,0,0,0,,Марл! Эй! Марл!
Dialogue: 0,1:00:52.20,1:00:54.50,Default,,0,0,0,,Атчи Атчи!
Dialogue: 0,1:00:56.80,1:00:58.51,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,1:00:59.01,1:01:01.31,Default,,0,0,0,,Ыстық! ...Капитан!
Dialogue: 0,1:01:04.23,1:01:05.27,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,1:01:40.31,1:01:41.89,Default,,0,0,0,,Дұшпандық реакция жоғалады
Dialogue: 0,1:01:43.81,1:01:45.10,Default,,0,0,0,,Жоюшы режимі аяқталды
Dialogue: 0,1:01:46.77,1:01:48.40,Default,,0,0,0,,Бұл Gonk AP
Dialogue: 0,1:01:48.98,1:01:52.23,Default,,0,0,0,,Негізгі қару мен теледидарды бақылау жүйесінің зақымдалуы
Dialogue: 0,1:01:52.78,1:01:54.28,Default,,0,0,0,,Мен енді үйге қайтамын.
Dialogue: 0,1:01:57.95,1:02:01.20,Default,,0,0,0,,Қарғыс атсын! Күте тұрыңыз, сіз қашып жатырсыз ба? !
Dialogue: 0,1:02:16.01,1:02:17.55,Default,,0,0,0,,Дұшпандық реакция минус
Dialogue: 0,1:02:18.05,1:02:19.64,Default,,0,0,0,,Жауынгерлік емес деп танылды
Dialogue: 0,1:02:19.76,1:02:21.01,Default,,0,0,0,,Не? !
Dialogue: 0,1:02:21.30,1:02:23.56,Default,,0,0,0,,Бұл шектеулі ұрыс аймағы.
Dialogue: 0,1:02:23.68,1:02:26.10,Default,,0,0,0,,Азаматтар дереу кетуі керек
Dialogue: 0,1:02:26.14,1:02:27.23,Default,,0,0,0,,Сен бейбақ!
Dialogue: 0,1:02:34.00,1:02:37.90,Default,,0,0,0,,1 кг-нан астам бактерия болды.
Dialogue: 0,1:02:38.91,1:02:40.20,Default,,0,0,0,,Мына жерден қараңыз
Dialogue: 0,1:02:42.87,1:02:45.95,Default,,0,0,0,,Бұл соғыс біздің негіздемеміз.
Dialogue: 0,1:02:46.79,1:02:50.21,Default,,0,0,0,,Осы кітапшаны оқысаңыз, түсінесіз.
Dialogue: 0,1:02:51.25,1:02:52.96,Default,,0,0,0,,Әзіл! Бұл мыңжапырақ!
Dialogue: 0,1:02:54.46,1:03:00.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory