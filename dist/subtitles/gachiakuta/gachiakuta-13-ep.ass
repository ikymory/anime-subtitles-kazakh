Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.21,0:00:17.15,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:00:17.15,0:00:19.15,Default,,0,0,0,,Мама, құс
Dialogue: 0,0:00:19.15,0:00:21.22,Default,,0,0,0,,Бұл қара құс➡
Dialogue: 0,0:00:21.22,0:00:24.22,Default,,0,0,0,,Маккуро Курокуро Курикури~➡
Dialogue: 0,0:00:24.22,0:00:26.22,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:00:26.22,0:00:30.99,Default,,0,0,0,,Амо-чан, Қара құс саған ғашық бола алмайды➡
Dialogue: 0,0:00:30.99,0:00:33.16,Default,,0,0,0,,Ендеше оны жайына қалдырайық, жарай ма?
Dialogue: 0,0:00:34.33,0:00:36.30,Default,,0,0,0,,Не?
Dialogue: 0,0:00:37.33,0:00:39.67,Default,,0,0,0,,Жарайды, жек көремін, жек көремін, жек көремін.
Dialogue: 0,0:00:39.67,0:00:41.67,Default,,0,0,0,,Онда барыңыз➡
Dialogue: 0,0:00:41.67,0:00:43.67,Default,,0,0,0,,Мінсіз серіппені тастамаңыз➡
Dialogue: 0,0:00:43.67,0:00:45.67,Default,,0,0,0,,Бақа Бақа
Dialogue: 0,0:00:45.67,0:00:47.68,Default,,0,0,0,,Не?
Dialogue: 0,0:00:47.68,0:00:51.75,Default,,0,0,0,,Қара құс мырза, болды, тез кеттік.
Dialogue: 0,0:00:53.52,0:00:56.59,Default,,0,0,0,,Қайда бара жатырсыңдар, үйректер?
Dialogue: 0,0:00:56.59,0:01:00.36,Default,,0,0,0,,Амо-чан өзін жақсы көретін адаммен бірге.
Dialogue: 0,0:01:04.69,0:01:06.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:14.97,0:01:18.31,Default,,0,0,0,,Ана? (Амоның анасы) Жарайсың, Амо-чан➡
Dialogue: 0,0:01:18.31,0:01:20.31,Default,,0,0,0,,Егер сол адам
Dialogue: 0,0:01:20.31,0:01:23.81,Default,,0,0,0,,Мен сені әрқашан жақсы көремін
Dialogue: 0,0:01:23.81,0:01:26.68,Default,,0,0,0,,Сен бақытты адамсың, Амо-чан.
Dialogue: 0,0:01:27.65,0:01:29.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:29.65,0:01:31.62,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:01:32.65,0:01:34.72,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:36.99,0:01:38.96,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:41.00,0:01:43.83,Default,,0,0,0,,Сізге жыланбалық қатты ұнай ма?
Dialogue: 0,0:01:43.83,0:01:47.20,Default,,0,0,0,,Хэхе хаха хехехехе
Dialogue: 0,0:02:18.03,0:02:21.87,Default,,0,0,0,,Әй, аға, қайда бара жатырсыз?
Dialogue: 0,0:02:21.87,0:02:25.04,Default,,0,0,0,,Бізде сіз үшін тамаша үй бар➡
Dialogue: 0,0:02:25.04,0:02:27.88,Default,,0,0,0,,Онда ешкім араласпайды➡
Dialogue: 0,0:02:27.88,0:02:30.81,Default,,0,0,0,,Бұл тек бізге арналған үй
Dialogue: 0,0:02:30.81,0:02:33.65,Default,,0,0,0,,Уау, сарайға ұқсайды.
Dialogue: 0,0:02:33.65,0:02:36.72,Default,,0,0,0,,Көшеге шықпаңыз, бұл қауіпті
Dialogue: 0,0:02:39.32,0:02:43.83,Default,,0,0,0,,Бұл тамаша үй. Мен оны анама көрсеткім келеді.
Dialogue: 0,0:02:43.83,0:02:49.66,Default,,0,0,0,,Анаңыз сіздің ортаңызда болудан бас тартты➡
Dialogue: 0,0:02:49.66,0:02:53.64,Default,,0,0,0,,Бүгіннен бастап мен қоршаған орта боламын.
Dialogue: 0,0:02:54.67,0:02:58.74,Default,,0,0,0,,Мен сені әрқашан асыраймын.
Dialogue: 0,0:03:02.28,0:03:04.95,Default,,0,0,0,,Көптеген суретті кітаптар
Dialogue: 0,0:03:07.12,0:03:09.69,Default,,0,0,0,,Көп тамақ
Dialogue: 0,0:03:12.19,0:03:14.86,Default,,0,0,0,,Көп киім
Dialogue: 0,0:03:15.96,0:03:17.96,Default,,0,0,0,,Сәлем аға
Dialogue: 0,0:03:17.96,0:03:20.80,Default,,0,0,0,,Сіз бұл затты жұмыстан аласыз ба?
Dialogue: 0,0:03:20.80,0:03:22.80,Default,,0,0,0,,Дұрыс➡
Dialogue: 0,0:03:22.80,0:03:25.13,Default,,0,0,0,,Себебі мен курьермін➡
Dialogue: 0,0:03:25.13,0:03:28.10,Default,,0,0,0,,Жабдықтардың қажеті жоқ.
Dialogue: 0,0:03:29.14,0:03:33.14,Default,,0,0,0,,Және... бірақ...
Dialogue: 0,0:03:33.14,0:03:37.48,Default,,0,0,0,,Бірақ мені барлық Курьерлер жек көреді.
Dialogue: 0,0:03:37.48,0:03:40.98,Default,,0,0,0,,Сыртта қалыпты болса да, неге деп ойлаймын.
Dialogue: 0,0:03:40.98,0:03:42.98,Default,,0,0,0,,Бұл қорқынышты➡
Dialogue: 0,0:03:42.98,0:03:46.05,Default,,0,0,0,,Шабарман үшін бағалы сыйлық болса да.
Dialogue: 0,0:03:49.99,0:03:53.06,Default,,0,0,0,,Амо… Амо…➡
Dialogue: 0,0:03:53.06,0:03:55.06,Default,,0,0,0,,Бұл бөлме бастапқыда➡ болды
Dialogue: 0,0:03:55.06,0:03:59.00,Default,,0,0,0,,Сіз бұл жерді қандай да бір ырым-тыйымдар жасайтын орын деп айттыңыз.
Dialogue: 0,0:03:59.00,0:04:01.77,Default,,0,0,0,,Ендеше біз де салт-дәстүрді орындайық.
Dialogue: 0,0:04:01.77,0:04:04.11,Default,,0,0,0,,Әдеттегі әдет-ғұрып
Dialogue: 0,0:04:04.11,0:04:06.61,Default,,0,0,0,,Сәлем аға
Dialogue: 0,0:04:06.61,0:04:12.45,Default,,0,0,0,,Амо, мен мұны істеген сайын жүрегім жиі соғады.
Dialogue: 0,0:04:12.45,0:04:14.78,Default,,0,0,0,,Бұл ауыр болады
Dialogue: 0,0:04:14.78,0:04:16.75,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:04:17.79,0:04:19.76,Default,,0,0,0,,Амо
Dialogue: 0,0:04:21.46,0:04:25.46,Default,,0,0,0,,Бұл махаббат хаха
Dialogue: 0,0:04:25.46,0:04:27.53,Default,,0,0,0,,Эмма!
Dialogue: 0,0:04:27.53,0:04:29.53,Default,,0,0,0,,Қараңдар! ➡
Dialogue: 0,0:04:29.53,0:04:33.14,Default,,0,0,0,,Суреттер кітабындағы қыз да ханзадаға ғашық болды ғой?
Dialogue: 0,0:04:33.14,0:04:35.14,Default,,0,0,0,,Сонымен қатар
Dialogue: 0,0:04:35.14,0:04:37.81,Default,,0,0,0,,Сен маған ғашықсың
Dialogue: 0,0:04:37.81,0:04:40.78,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:04:43.65,0:04:46.15,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:46.15,0:04:48.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:49.65,0:04:53.22,Default,,0,0,0,,Бұл махаббат, солай ма?
Dialogue: 0,0:05:06.27,0:05:13.78,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:13.78,0:05:17.45,Default,,0,0,0,,Оқ-дақтың иісі өте жақсы.
Dialogue: 0,0:05:17.45,0:05:19.41,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:23.45,0:05:29.96,Default,,0,0,0,,Мен жалғыз емеспін Мен жалғыз емеспін➡
Dialogue: 0,0:05:29.96,0:05:32.46,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:05:32.46,0:05:34.80,Default,,0,0,0,,Уфуфуфу алғашқы махаббат
Dialogue: 0,0:05:34.80,0:05:37.63,Default,,0,0,0,,Бұл сезім алғашқы махаббат, солай ма?
Dialogue: 0,0:05:37.63,0:05:39.63,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,0:05:39.63,0:05:42.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:47.64,0:05:49.61,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:05:52.31,0:05:54.48,Default,,0,0,0,,Гааах!
Dialogue: 0,0:05:58.15,0:07:26.44,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:41.02,0:07:43.39,Default,,0,0,0,,⚟Мазалағаным үшін кешіріңіз
Dialogue: 0,0:07:43.39,0:07:45.46,Default,,0,0,0,,А…?
Dialogue: 0,0:07:45.46,0:07:49.46,Default,,0,0,0,,Ммм... Балалар не істеп жатырсыңдар?
Dialogue: 0,0:07:49.46,0:07:52.07,Default,,0,0,0,,Неге рұқсатсыз кіріп жатырсыз➡
Dialogue: 0,0:07:52.07,0:07:56.07,Default,,0,0,0,,Бұл тек Амо екеумізге арналған кеңістік. Эй!
Dialogue: 0,0:07:56.07,0:07:58.41,Default,,0,0,0,,Конно
Dialogue: 0,0:07:58.41,0:08:00.41,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:08:00.41,0:08:03.01,Default,,0,0,0,,Мен қазір кетуім керек.
Dialogue: 0,0:08:03.01,0:08:04.98,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:08:06.51,0:08:10.99,Default,,0,0,0,,Мен сені адамдық қаруыммен өлтіремін.
Dialogue: 0,0:08:16.86,0:08:18.83,Default,,0,0,0,,Гааа
Dialogue: 0,0:08:34.88,0:08:36.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:45.39,0:08:48.06,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:52.23,0:08:55.70,Default,,0,0,0,,Бұл сізге көбірек сәйкес келеді.
Dialogue: 0,0:08:57.30,0:09:01.07,Default,,0,0,0,,⚟Жүрегімнен не түсті
Dialogue: 0,0:09:01.07,0:09:04.34,Default,,0,0,0,,Ах ⚟Бұл оны толтырады.
Dialogue: 0,0:09:12.58,0:09:14.55,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:09:16.92,0:09:18.92,Default,,0,0,0,,Ах
Dialogue: 0,0:09:18.92,0:09:21.89,Default,,0,0,0,,⚟Бұл ең жақыны сияқты.
Dialogue: 0,0:09:26.26,0:09:28.73,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:09:30.93,0:09:33.44,Default,,0,0,0,,⚟Қызым➡
Dialogue: 0,0:09:33.44,0:09:36.77,Default,,0,0,0,,Уақыты келгенше қарызға берейік➡
Dialogue: 0,0:09:36.77,0:09:39.27,Default,,0,0,0,,Оны мұқият пайдаланыңыз
Dialogue: 0,0:09:39.27,0:09:41.74,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:09:48.78,0:09:51.05,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:09:53.12,0:09:55.29,Default,,0,0,0,,Періште?
Dialogue: 0,0:09:57.63,0:09:59.59,Default,,0,0,0,,Ах
Dialogue: 0,0:10:00.63,0:10:03.20,Default,,0,0,0,,Уф аа
Dialogue: 0,0:10:22.58,0:10:26.05,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:10:30.66,0:10:33.66,Default,,0,0,0,,Ағай, көрдіңіз бе? ток
Dialogue: 0,0:10:33.66,0:10:37.10,Default,,0,0,0,,Бұл адамдар періште болуы керек.
Dialogue: 0,0:10:37.10,0:10:39.10,Default,,0,0,0,,Керемет емес! ?
Dialogue: 0,0:10:39.10,0:10:42.10,Default,,0,0,0,,Бұл суретті кітап емес, шынайы өмір
Dialogue: 0,0:10:42.10,0:10:46.11,Default,,0,0,0,,Амо О, түсіндім, ұрып қалдың емес пе?
Dialogue: 0,0:10:46.11,0:10:49.11,Default,,0,0,0,,Жарақатыңды ойлап уайымдама... Бұл менің аяқ киімім.
Dialogue: 0,0:10:49.11,0:10:52.45,Default,,0,0,0,,Менен ұрлауға қалай дәтің бар, қарғыс атқан әуесқой! Жақсы уф
Dialogue: 0,0:10:52.45,0:10:56.45,Default,,0,0,0,,Сіз сияқты адамның қолын тигізгені дұрыс деп ойлайсыз ба? ➡
Dialogue: 0,0:10:56.45,0:10:58.52,Default,,0,0,0,,Мынау, мынау, сіз... ағай, у...
Dialogue: 0,0:10:58.52,0:11:01.89,Default,,0,0,0,,Ұры, ұры, неше рет кию керек➡
Dialogue: 0,0:11:01.89,0:11:04.23,Default,,0,0,0,,Қалауыңызша жылжытыңыз➡
Dialogue: 0,0:11:04.23,0:11:07.30,Default,,0,0,0,,Мынау мынау мынау...
Dialogue: 0,0:11:24.58,0:11:27.75,Default,,0,0,0,,<Осы аяқ киімге рахмет? ＞
Dialogue: 0,0:11:45.83,0:11:48.20,Default,,0,0,0,,<Мен оны ешкімге бермеймін! ＞
Dialogue: 0,0:11:52.27,0:11:54.58,Default,,0,0,0,,Ах
Dialogue: 0,0:11:59.38,0:12:01.32,Default,,0,0,0,,Бұл
Dialogue: 0,0:12:01.32,0:12:03.32,Default,,0,0,0,,Көп әңгіме... Людо!
Dialogue: 0,0:12:03.32,0:12:05.92,Default,,0,0,0,,Немен айналыстың?
Dialogue: 0,0:12:05.92,0:12:08.59,Default,,0,0,0,,Мен қазір сөйлесіп тұрған әйел➡
Dialogue: 0,0:12:08.59,0:12:11.59,Default,,0,0,0,,Сізге қажет ақпарат
Dialogue: 0,0:12:11.59,0:12:13.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:15.43,0:12:19.77,Default,,0,0,0,,Неліктен бұлай➡
Dialogue: 0,0:12:19.77,0:12:22.27,Default,,0,0,0,,Неліктен менің адамдық қаруым➡
Dialogue: 0,0:12:22.27,0:12:24.94,Default,,0,0,0,,Сіз маған жауап беріп жатырсыз ба? ➡
Dialogue: 0,0:12:24.94,0:12:27.01,Default,,0,0,0,,Мүмкін емес➡
Dialogue: 0,0:12:27.01,0:12:31.68,Default,,0,0,0,,Адам ағзаларымен тек иелері айналысуы керек.
Dialogue: 0,0:12:32.78,0:12:35.45,Default,,0,0,0,,Менен басқа неге?
Dialogue: 0,0:12:35.45,0:12:37.45,Default,,0,0,0,,О... Ха
Dialogue: 0,0:12:37.45,0:12:41.29,Default,,0,0,0,,Ағаңның емес болғандықтан емес пе?
Dialogue: 0,0:12:41.29,0:12:43.29,Default,,0,0,0,,(тұз)
Dialogue: 0,0:12:43.29,0:12:45.96,Default,,0,0,0,,Адамның мүшесі дегеніміз не?
Dialogue: 0,0:12:45.96,0:12:48.30,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:12:48.30,0:12:52.63,Default,,0,0,0,,Бұл аяқ киім Ammo-да жақсырақ көрінеді.
Dialogue: 0,0:12:52.63,0:12:55.70,Default,,0,0,0,,Сонымен қатар, егер сізде осы аяқ киім болса
Dialogue: 0,0:12:55.70,0:12:58.31,Default,,0,0,0,,Менің жүрегім толды➡
Dialogue: 0,0:12:58.31,0:13:02.91,Default,,0,0,0,,Жоғалған затты тапқандай➡
Dialogue: 0,0:13:02.91,0:13:05.91,Default,,0,0,0,,Батареяларды ескі ойыншықтарға салыңыз➡
Dialogue: 0,0:13:05.91,0:13:07.98,Default,,0,0,0,,Ақыры қозғала бастаған сияқты➡
Dialogue: 0,0:13:07.98,0:13:10.59,Default,,0,0,0,,Міне, осындай сезім➡
Dialogue: 0,0:13:10.59,0:13:12.92,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:13:12.92,0:13:15.42,Default,,0,0,0,,Осылайша
Dialogue: 0,0:13:15.42,0:13:17.89,Default,,0,0,0,,Амо оны алғаны дұрыс па?
Dialogue: 0,0:13:19.26,0:13:22.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:22.26,0:13:24.77,Default,,0,0,0,,Охохохохохо
Dialogue: 0,0:13:24.77,0:13:26.83,Default,,0,0,0,,Көрдіңіз бе.
Dialogue: 0,0:13:26.83,0:13:29.84,Default,,0,0,0,,Сіз басқалардың заттарын ала алмайсыз, солай ма? ➡
Dialogue: 0,0:13:29.84,0:13:32.61,Default,,0,0,0,,Тесік түсінбеуі мүмкін➡
Dialogue: 0,0:13:32.61,0:13:35.44,Default,,0,0,0,,Бұл адам болудың негізі екенін түсінесің бе?
Dialogue: 0,0:13:35.44,0:13:37.95,Default,,0,0,0,,Не... не айтып тұрсың?
Dialogue: 0,0:13:37.95,0:13:39.95,Default,,0,0,0,,Ағай...
Dialogue: 0,0:13:39.95,0:13:43.42,Default,,0,0,0,,Адамдардан ұрлаған көп заттарды осында әкелдің.
Dialogue: 0,0:13:44.45,0:13:48.46,Default,,0,0,0,,Ал Амо оны ала ма деп сұрап жатыр.
Dialogue: 0,0:13:48.46,0:13:50.46,Default,,0,0,0,,Дәлірек айтсақ, Амо.
Dialogue: 0,0:13:50.46,0:13:53.53,Default,,0,0,0,,Сенің періштеге ұқсайтының танылды.
Dialogue: 0,0:13:53.53,0:13:55.96,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:55.96,0:13:59.30,Default,,0,0,0,,Не болды? Амо~ Хаа...
Dialogue: 0,0:13:59.30,0:14:03.24,Default,,0,0,0,,Бүгін неге мені сонша ести алмайсың?
Dialogue: 0,0:14:03.24,0:14:06.07,Default,,0,0,0,,Бұл маған көбірек тәртіпті болу керек дегенді білдіре ме?
Dialogue: 0,0:14:06.07,0:14:09.91,Default,,0,0,0,,Жақсы… Жақсы…
Dialogue: 0,0:14:09.91,0:14:12.75,Default,,0,0,0,,Қазір Амон
Dialogue: 0,0:14:12.75,0:14:16.25,Default,,0,0,0,,Менің ішімде түрлі сезімдер көтеріліп жатыр.
Dialogue: 0,0:14:16.25,0:14:19.09,Default,,0,0,0,,Батылдық дегеніміз не?
Dialogue: 0,0:14:19.09,0:14:21.76,Default,,0,0,0,,Тітіркену деп аталатын нәрсе➡
Dialogue: 0,0:14:21.76,0:14:27.26,Default,,0,0,0,,Сондай-ақ, мен қазір жаман нәрселер туралы ойлаймын.
Dialogue: 0,0:14:27.26,0:14:29.73,Default,,0,0,0,,Бірақ
Dialogue: 0,0:14:31.93,0:14:35.27,Default,,0,0,0,,Бұл менің бірінші және соңғы өзімшілдігім.
Dialogue: 0,0:14:35.27,0:14:38.11,Default,,0,0,0,,Маған мына аяқ киімді беріңізші➡
Dialogue: 0,0:14:38.11,0:14:42.58,Default,,0,0,0,,Мен мұны шынымен қалаймын
Dialogue: 0,0:14:44.11,0:14:48.18,Default,,0,0,0,,Жоқ! ➡
Dialogue: 0,0:14:48.18,0:14:50.18,Default,,0,0,0,,Мені қайта-қайта айтуға мәжбүрлеме➡
Dialogue: 0,0:14:50.18,0:14:53.45,Default,,0,0,0,,Бұл менікі, тек менікі➡
Dialogue: 0,0:14:53.45,0:14:57.53,Default,,0,0,0,,Уау, мені бұл алмасуға қанша рет мәжбүрлемексің➡
Dialogue: 0,0:14:57.53,0:14:59.53,Default,,0,0,0,,Бұл өте қиын➡
Dialogue: 0,0:14:59.53,0:15:01.46,Default,,0,0,0,,Тез жіберіңіз
Dialogue: 0,0:15:01.46,0:15:03.90,Default,,0,0,0,,Қараңдар! Тездетіңіз
Dialogue: 0,0:15:03.90,0:15:06.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:06.57,0:15:09.40,Default,,0,0,0,,Не? Не!
Dialogue: 0,0:15:09.40,0:15:11.41,Default,,0,0,0,,Мен осыны көп сұраймын.
Dialogue: 0,0:15:11.41,0:15:14.08,Default,,0,0,0,,Неге мені тыңдамайсың? Ах...
Dialogue: 0,0:15:14.08,0:15:16.41,Default,,0,0,0,,Сіз Амоны жақсы көресіз, солай ма?
Dialogue: 0,0:15:16.41,0:15:18.41,Default,,0,0,0,,Аххххх
Dialogue: 0,0:15:18.41,0:15:20.92,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:15:20.92,0:15:23.28,Default,,0,0,0,,Ууууууууууу нуах
Dialogue: 0,0:15:25.59,0:15:28.26,Default,,0,0,0,,Аххххх
Dialogue: 0,0:15:31.93,0:15:34.10,Default,,0,0,0,,Ах! Уф
Dialogue: 0,0:15:36.76,0:15:39.03,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:15:41.27,0:15:43.24,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:15:47.78,0:15:49.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:52.85,0:15:57.62,Default,,0,0,0,,Ахаха иә
Dialogue: 0,0:15:57.62,0:16:02.62,Default,,0,0,0,,Ум, хахахахаха хехе
Dialogue: 0,0:16:02.62,0:16:07.23,Default,,0,0,0,,Иә? Неліктен бұл болды?
Dialogue: 0,0:16:07.23,0:16:11.90,Default,,0,0,0,,Иә? Ағаңызбен өміріңіз қандай болды?
Dialogue: 0,0:16:11.90,0:16:14.97,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:16:14.97,0:16:19.44,Default,,0,0,0,,Мама ағай мен Амоның кездесуіне неліктен рұқсат берді?
Dialogue: 0,0:16:21.24,0:16:23.74,Default,,0,0,0,,Ха! ➡
Dialogue: 0,0:16:23.74,0:16:27.22,Default,,0,0,0,,А, жоқ, бұл дұрыс емес.
Dialogue: 0,0:16:29.82,0:16:32.49,Default,,0,0,0,,Оқ біледі
Dialogue: 0,0:16:34.42,0:16:37.09,Default,,0,0,0,,Сүйікті болу
Dialogue: 0,0:16:39.09,0:16:41.06,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:16:42.10,0:16:45.43,Default,,0,0,0,,Ағам алғашқы махаббаты жақсы еді➡
Dialogue: 0,0:16:45.43,0:16:47.80,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:17:10.89,0:17:15.90,Default,,0,0,0,,Міне осылай періште қайтып келді➡
Dialogue: 0,0:17:15.90,0:17:18.87,Default,,0,0,0,,Бір адам кем болды.
Dialogue: 0,0:17:23.91,0:17:27.24,Default,,0,0,0,,Кенеттен басталған жеке әңгімеде➡
Dialogue: 0,0:17:27.24,0:17:29.91,Default,,0,0,0,,Мен ешқашан періште шығады деп күтпедім.
Dialogue: 0,0:17:29.91,0:17:33.58,Default,,0,0,0,,Амо-чан, қиын болды.
Dialogue: 0,0:17:33.58,0:17:36.42,Default,,0,0,0,,Періштелер шынайы емес➡
Dialogue: 0,0:17:36.42,0:17:38.42,Default,,0,0,0,,Аспан әлемі туралы айтасыз ба?
Dialogue: 0,0:17:38.42,0:17:40.92,Default,,0,0,0,,Қанат өсіретін беруші емес пе?
Dialogue: 0,0:17:40.92,0:17:44.93,Default,,0,0,0,,Білмеймін, ол әдемі ертегідегі ойшыл➡
Dialogue: 0,0:17:44.93,0:17:46.93,Default,,0,0,0,,адасу мүмкіндігі
Dialogue: 0,0:17:46.93,0:17:48.93,Default,,0,0,0,,Бұл әдіс.
Dialogue: 0,0:17:48.93,0:17:51.60,Default,,0,0,0,,Сіз бұл шекарадан қалай өттіңіз?
Dialogue: 0,0:17:51.60,0:17:54.27,Default,,0,0,0,,Иә...қанатпен ұшады ма?
Dialogue: 0,0:17:54.27,0:17:57.77,Default,,0,0,0,,Е, сонда әлгі періште қайда қонды?
Dialogue: 0,0:17:57.77,0:18:01.61,Default,,0,0,0,,Иә... көкжиекте жоғалып кетті.
Dialogue: 0,0:18:01.61,0:18:03.61,Default,,0,0,0,,Мен ештеңе түсінбеймін
Dialogue: 0,0:18:03.61,0:18:07.45,Default,,0,0,0,,Жас ханым, ол періште қашан оралды?
Dialogue: 0,0:18:07.45,0:18:10.28,Default,,0,0,0,,Бір ай бұрын
Dialogue: 0,0:18:10.28,0:18:12.95,Default,,0,0,0,,Бір ай.
Dialogue: 0,0:18:12.95,0:18:15.96,Default,,0,0,0,,Бұл Людо төменгі әлемге келген кездегідей.
Dialogue: 0,0:18:15.96,0:18:17.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:23.97,0:18:27.03,Default,,0,0,0,,Меніңше, ол фильмнің атауы еді, иә?
Dialogue: 0,0:18:27.03,0:18:29.80,Default,,0,0,0,,Бұл ол
Dialogue: 0,0:18:31.31,0:18:34.64,Default,,0,0,0,,Эй, түсіндім.
Dialogue: 0,0:18:34.64,0:18:37.48,Default,,0,0,0,,Мен төменгі әлемге келдім.
Dialogue: 0,0:18:37.48,0:18:40.82,Default,,0,0,0,,Ал олар бұрынғы дуэт пе?
Dialogue: 0,0:18:40.82,0:18:42.78,Default,,0,0,0,,Иә
Dialogue: 0,0:18:44.82,0:18:49.32,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:19:15.28,0:19:17.35,Default,,0,0,0,,Хе хе хе
Dialogue: 0,0:19:17.35,0:19:19.79,Default,,0,0,0,,Сен де, иә?
Dialogue: 0,0:19:19.79,0:19:23.12,Default,,0,0,0,,Сіз де
Dialogue: 0,0:19:23.12,0:19:27.13,Default,,0,0,0,,Сол қолғап сізді адамға айналдырды, солай ма?
Dialogue: 0,0:19:27.13,0:19:29.46,Default,,0,0,0,,Мен бұл елбалықтардың істейтініне сенімдімін.
Dialogue: 0,0:19:29.46,0:19:32.30,Default,,0,0,0,,Сіз жетіспейтін адамдармен үйлесімдісіз бе?➡
Dialogue: 0,0:19:32.30,0:19:37.81,Default,,0,0,0,,Ішіне көп нәрсе салмайынша, үлкен тесікті толтыру мүмкін емес➡
Dialogue: 0,0:19:37.81,0:19:41.31,Default,,0,0,0,,Үйректер қалдырған тесікті толтыра алатын нәрсе➡
Dialogue: 0,0:19:41.31,0:19:43.81,Default,,0,0,0,,Бұған бір нәрсе бар➡
Dialogue: 0,0:19:43.81,0:19:46.31,Default,,0,0,0,,Мен жыланбалықты қайтардым➡
Dialogue: 0,0:19:46.31,0:19:49.82,Default,,0,0,0,,Адам сезінуге тиісті эмоциялар
Dialogue: 0,0:19:49.82,0:19:52.49,Default,,0,0,0,,Бірақ, адам болған соң➡
Dialogue: 0,0:19:52.49,0:19:55.66,Default,,0,0,0,,Мен көп нәрсені дерлік түсіндім.
Dialogue: 0,0:19:56.99,0:20:00.10,Default,,0,0,0,,Осы уақытқа дейін нағашы деген немене болдыңыз?
Dialogue: 0,0:20:00.10,0:20:06.43,Default,,0,0,0,,Жалғыздық өте жалғыз➡
Dialogue: 0,0:20:06.43,0:20:09.94,Default,,0,0,0,,Біреумен бірге болғым келеді, керек болғым келеді
Dialogue: 0,0:20:09.94,0:20:11.94,Default,,0,0,0,,(жыланбалық гүлдерді жұтады)
Dialogue: 0,0:20:11.94,0:20:15.91,Default,,0,0,0,,Бірақ мен бұл бақтан кетуге қорқамын
Dialogue: 0,0:20:17.45,0:20:21.28,Default,,0,0,0,,Сондықтан мен сенің келеріңді күттім➡
Dialogue: 0,0:20:21.28,0:20:26.12,Default,,0,0,0,,Бақшаға келген адамдармен қарым-қатынаста болуға тырысты➡
Dialogue: 0,0:20:26.12,0:20:29.62,Default,,0,0,0,,Бірақ жақсы болмады➡
Dialogue: 0,0:20:29.62,0:20:31.59,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:32.63,0:20:35.96,Default,,0,0,0,,Людо Амодан кешірім сұрауға келді, солай ма?
Dialogue: 0,0:20:35.96,0:20:38.63,Default,,0,0,0,,А...айтудың қажеті жоқ➡
Dialogue: 0,0:20:38.63,0:20:40.70,Default,,0,0,0,,Бұл оқ-дәріге де қатысты.
Dialogue: 0,0:20:40.70,0:20:43.70,Default,,0,0,0,,Жоқ, бұл жай ғана Амо емес.
Dialogue: 0,0:20:43.70,0:20:46.14,Default,,0,0,0,,Бәрі де солай ма?
Dialogue: 0,0:20:46.14,0:20:50.21,Default,,0,0,0,,Қолымды қалай көтеру керектігін білемін➡
Dialogue: 0,0:20:50.21,0:20:54.98,Default,,0,0,0,,Сондықтан бұл дүние ешқашан өзгермейді.
Dialogue: 0,0:20:57.15,0:20:59.32,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:21:01.32,0:21:04.19,Default,,0,0,0,,Адамдармен қарым-қатынас жасау
Dialogue: 0,0:21:05.59,0:21:10.10,Default,,0,0,0,,Бірге қол созуды үйренейік.
Dialogue: 0,0:21:10.10,0:21:12.93,Default,,0,0,0,,Мен де түсінбеймін.
Dialogue: 0,0:21:12.93,0:21:15.90,Default,,0,0,0,,Мен бірге оқығым келеді
Dialogue: 0,0:21:17.44,0:21:19.44,Default,,0,0,0,,Ха…➡
Dialogue: 0,0:21:19.44,0:21:22.41,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:21:30.28,0:21:33.29,Default,,0,0,0,,Бармайтыныңызға сенімдісіз бе? Иә➡
Dialogue: 0,0:21:33.29,0:21:37.29,Default,,0,0,0,,Мен бұл жерде басымды сәл тазартқым келеді.
Dialogue: 0,0:21:37.29,0:21:40.86,Default,,0,0,0,,Бірақ анда-санда сөйлесейік, Людо.
Dialogue: 0,0:21:42.80,0:21:44.80,Default,,0,0,0,,Кейде
Dialogue: 0,0:21:44.80,0:21:47.87,Default,,0,0,0,,Ал, кеттік. Мен тағы келемін, Амо-чан.
Dialogue: 0,0:21:47.87,0:21:49.84,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:21:51.87,0:21:53.84,Default,,0,0,0,,Иә
Dialogue: 0,0:21:55.31,0:21:57.28,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:22:06.32,0:22:09.49,Default,,0,0,0,,Мен шекарадан қалай өту керектігін білмедім, бірақ
Dialogue: 0,0:22:09.49,0:22:11.76,Default,,0,0,0,,Егін болған жоқ па?
Dialogue: 0,0:22:11.76,0:22:15.60,Default,,0,0,0,,Шекарадан өте алатын періште немесе бір нәрсе бар.
Dialogue: 0,0:22:15.60,0:22:19.60,Default,,0,0,0,,Людо қолғабының белгісімен бірдей адам құрылғысы.
Dialogue: 0,0:22:19.60,0:22:21.94,Default,,0,0,0,,Тролльдер айтқан сериал қандай?
Dialogue: 0,0:22:21.94,0:22:25.01,Default,,0,0,0,,Мүмкін ол аяқ киімдер кірген шығар?
Dialogue: 0,0:22:25.01,0:22:27.01,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:22:50.30,0:22:53.13,Default,,0,0,0,,(есік жабылады)
Dialogue: 0,0:22:53.13,0:22:56.80,Default,,0,0,0,,Хэхе, кездескенше?
Dialogue: 0,0:22:56.80,0:22:59.81,Default,,0,0,0,,Келесі жолы түнде қалуыңызға тілектеспін.
Dialogue: 0,0:22:59.81,0:23:04.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:05.58,0:23:07.65,Default,,0,0,0,,Кім? ➡
Dialogue: 0,0:23:07.65,0:23:09.65,Default,,0,0,0,,Не... а, жоқ! ➡
Dialogue: 0,0:23:09.65,0:23:12.42,Default,,0,0,0,,Сіз не істеп жатырсыз? Эй➡
Dialogue: 0,0:23:12.42,0:23:15.09,Default,,0,0,0,,Қайтарыңыз...➡
Dialogue: 0,0:23:15.09,0:23:17.86,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:23:23.16,0:23:26.77,Default,,0,0,0,,Шөлге арналған жинақтар~➡
Dialogue: 0,0:23:26.77,0:23:31.54,Default,,0,0,0,,Бірақ, мен жақсы өнім алдым деп ойлаймын.
Dialogue: 0,0:23:47.62,0:23:50.29,Default,,0,0,0,,Ол қозғалады ма?
Dialogue: 0,0:23:51.79,0:23:56.79,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
