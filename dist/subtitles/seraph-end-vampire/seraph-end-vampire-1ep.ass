Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:58.87,0:01:00.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:00.83,0:01:02.81,Default,,0,0,0,,Ах
Dialogue: 0,0:01:02.81,0:01:04.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:05.81,0:01:08.81,Default,,0,0,0,,Kya Wow
Dialogue: 0,0:01:55.81,0:01:57.81,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:02:01.82,0:02:03.82,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:02:03.82,0:02:05.82,Default,,0,0,0,,Хаа хааа
Dialogue: 0,0:02:08.83,0:02:10.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:11.83,0:02:13.83,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:02:16.82,0:02:18.82,Default,,0,0,0,,Ескерту
Dialogue: 0,0:02:18.82,0:02:20.82,Default,,0,0,0,,Ақымақ адамдардың қолымен
Dialogue: 0,0:02:20.82,0:02:23.83,Default,,0,0,0,,Өлімге әкелетін вирус тарады
Dialogue: 0,0:02:23.83,0:02:26.83,Default,,0,0,0,,Өкінішке орай, адамзат жойылады.
Dialogue: 0,0:02:28.83,0:02:30.82,Default,,0,0,0,,Ах
Dialogue: 0,0:02:30.82,0:02:32.82,Default,,0,0,0,,Директор Мика
Dialogue: 0,0:02:32.82,0:02:34.82,Default,,0,0,0,,Ю Чан бәріне қарады.
Dialogue: 0,0:02:35.82,0:02:37.82,Default,,0,0,0,,Ұстаз ұстаз!
Dialogue: 0,0:02:37.82,0:02:39.83,Default,,0,0,0,,Га
Dialogue: 0,0:02:39.83,0:02:41.83,Default,,0,0,0,,Бірақ вирус үлкен аға...
Dialogue: 0,0:02:41.83,0:02:44.83,Default,,0,0,0,,Біз оның 13 жасқа толмаған адамдарға жұқтыра алмайтынын білеміз.
Dialogue: 0,0:02:44.83,0:02:47.82,Default,,0,0,0,,Демек, біз үшінші ұрпақпыз.
Dialogue: 0,0:02:47.82,0:02:49.82,Default,,0,0,0,,Тікелей Крул Тепесінің қол астындағы әскерлер
Dialogue: 0,0:02:49.82,0:02:53.82,Default,,0,0,0,,Бұдан былай бұл аймақтағы балаларды қорғауды бастаймыз.
Dialogue: 0,0:02:54.82,0:02:56.82,Default,,0,0,0,,Ха! Уф...
Dialogue: 0,0:04:10.77,0:04:13.77,Default,,0,0,0,,Келесі Юичиро Хякуя
Dialogue: 0,0:04:17.77,0:04:19.77,Default,,0,0,0,,Келесі
Dialogue: 0,0:04:20.78,0:04:22.78,Default,,0,0,0,,Микаэла Хякуя
Dialogue: 0,0:04:39.78,0:04:41.78,Default,,0,0,0,,Уф
Dialogue: 0,0:05:02.77,0:05:04.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:04.77,0:05:07.77,Default,,0,0,0,,Uh... aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!
Dialogue: 0,0:05:08.77,0:05:10.77,Default,,0,0,0,,Тағы да ішпейсің бе? Мен денемді сындырамын
Dialogue: 0,0:05:11.78,0:05:13.78,Default,,0,0,0,,Сіз оны іше аласыз ба? Бұл өте ауыр.
Dialogue: 0,0:05:14.78,0:05:17.78,Default,,0,0,0,,Күрсіну... Ю-Чан - дәмді адам.
Dialogue: 0,0:05:17.78,0:05:19.78,Default,,0,0,0,,Менің айтқанымды орындамау керек.
Dialogue: 0,0:05:21.77,0:05:24.77,Default,,0,0,0,,Менің ойымша, бұл соншалықты жаман емес.
Dialogue: 0,0:05:24.77,0:05:28.78,Default,,0,0,0,,Сіз байсалдысыз ба? Сізді бұл жерде өлтіруге болмайды.
Dialogue: 0,0:05:28.78,0:05:30.78,Default,,0,0,0,,Ең бастысы, мен отбасыммен бірге тұра аламын.
Dialogue: 0,0:05:32.78,0:05:35.78,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,0:05:35.78,0:05:38.77,Default,,0,0,0,,Мен енді мал емеспін...
Dialogue: 0,0:05:38.77,0:05:40.77,Default,,0,0,0,,Ю-чан да түсінеді, солай ма?
Dialogue: 0,0:05:40.77,0:05:43.77,Default,,0,0,0,,Мен қыңыр болсам да, бұл туралы ештеңе істей алмаймын
Dialogue: 0,0:05:51.78,0:05:53.77,Default,,0,0,0,,Эй! Ах...
Dialogue: 0,0:05:53.77,0:05:55.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:55.77,0:05:57.77,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:06:00.78,0:06:02.78,Default,,0,0,0,,Ю-чан! Жоқ!
Dialogue: 0,0:06:02.78,0:06:06.78,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:06:06.78,0:06:11.77,Default,,0,0,0,,Кешірім сұраңыз! Кешіріңіз! мм...
Dialogue: 0,0:06:11.77,0:06:13.77,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:06:13.77,0:06:16.78,Default,,0,0,0,,Ол соншалықты ақымақ және ақымақ, сондықтан...
Dialogue: 0,0:06:16.78,0:06:19.78,Default,,0,0,0,,Мені кешіре гөр! Тоқта, Мика!
Dialogue: 0,0:06:19.78,0:06:22.78,Default,,0,0,0,,Бұл жігітті ұшырып жіберген менмін...
Dialogue: 0,0:06:22.78,0:06:24.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:26.79,0:06:28.79,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:33.78,0:06:36.78,Default,,0,0,0,,Ух...гохогохо
Dialogue: 0,0:06:41.78,0:06:43.79,Default,,0,0,0,,Ол дворян ба?
Dialogue: 0,0:06:43.79,0:06:45.77,Default,,0,0,0,,Ферид мырза!
Dialogue: 0,0:06:45.77,0:06:47.77,Default,,0,0,0,,Йо Мика-кун
Dialogue: 0,0:06:47.77,0:06:50.78,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұл ештеңе емес
Dialogue: 0,0:06:50.78,0:06:52.78,Default,,0,0,0,,Менің отбасым дұрыс емес әрекет жасады.
Dialogue: 0,0:06:52.78,0:06:55.78,Default,,0,0,0,,Саған да қиналып жатыр ғой, солай емес пе?
Dialogue: 0,0:06:56.78,0:07:00.79,Default,,0,0,0,,Одан да... Бүгін кешке сен де менің сарайыма келесің бе?
Dialogue: 0,0:07:00.79,0:07:03.79,Default,,0,0,0,,Өтінемін, сен жақсы қызсың.
Dialogue: 0,0:07:04.77,0:07:07.77,Default,,0,0,0,,Қаныңыз дәмді, сондықтан қабыл алыңыз.
Dialogue: 0,0:07:08.78,0:07:11.78,Default,,0,0,0,,Қызық, ол бала да бүгін келе ме?
Dialogue: 0,0:07:11.78,0:07:14.78,Default,,0,0,0,,​​Иә? Баратын түрі жоқ... Ұялшақ.
Dialogue: 0,0:07:14.78,0:07:18.78,Default,,0,0,0,,Тағы да солай ма? Бұл ұят
Dialogue: 0,0:07:23.78,0:07:25.78,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:30.78,0:07:32.78,Default,,0,0,0,,Неліктен кешірім сұрадыңыз?
Dialogue: 0,0:07:32.78,0:07:35.79,Default,,0,0,0,,Ол жігітті ұшырып жіберген мен едім.
Dialogue: 0,0:07:35.79,0:07:37.77,Default,,0,0,0,,Иә, мен ақымақ нәрсе айттым.
Dialogue: 0,0:07:37.77,0:07:41.78,Default,,0,0,0,,Білесіз бе, адамдар вампирлерден күшті болуы мүмкін емес.
Dialogue: 0,0:07:41.78,0:07:43.78,Default,,0,0,0,,Сіз тырыспайынша түсінбейсіз.
Dialogue: 0,0:07:43.78,0:07:46.78,Default,,0,0,0,,Жоқ, жоқ, сіз түсінесіз.
Dialogue: 0,0:07:46.78,0:07:48.78,Default,,0,0,0,,Күрсін... Дәлірек айтқанда, Ю-чан.
Dialogue: 0,0:07:48.78,0:07:50.79,Default,,0,0,0,,Өзіңізді қатты итермеңіз, жарай ма?
Dialogue: 0,0:07:50.79,0:07:53.79,Default,,0,0,0,,Бұл дәл қазір өте қауіпті болды.
Dialogue: 0,0:07:55.77,0:07:58.78,Default,,0,0,0,,Сіз қандай дворяндарды білесіз?
Dialogue: 0,0:07:58.78,0:08:00.78,Default,,0,0,0,,Шағымдарыңыз бар ма?
Dialogue: 0,0:08:00.78,0:08:03.78,Default,,0,0,0,,Егер сіз қан тапсырсаңыз, Ферид мырза сізге кез келген нәрсені береді.
Dialogue: 0,0:08:03.78,0:08:05.78,Default,,0,0,0,,Дәмді тағамдарды да жеуге болады.
Dialogue: 0,0:08:05.78,0:08:09.78,Default,,0,0,0,,Өйткені мұнда өмір сүру үшін миды дұрыс пайдалану керек.
Dialogue: 0,0:08:10.79,0:08:12.79,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:08:13.78,0:08:16.78,Default,,0,0,0,,Ю-чан... Ю-чан да бірдеңені қалайды...
Dialogue: 0,0:08:16.78,0:08:18.78,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:19.78,0:08:21.78,Default,,0,0,0,,Фу
Dialogue: 0,0:08:28.77,0:08:31.77,Default,,0,0,0,,Эй, мен тағы да осында болдым.
Dialogue: 0,0:08:32.78,0:08:34.78,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:35.78,0:08:37.78,Default,,0,0,0,,Мика сенімен бірге емес пе?
Dialogue: 0,0:08:37.78,0:08:39.78,Default,,0,0,0,,Біз бірге емеспіз, ол жігіт.
Dialogue: 0,0:08:39.78,0:08:42.79,Default,,0,0,0,,Иә? Неге ашуланасың?
Dialogue: 0,0:08:42.79,0:08:45.79,Default,,0,0,0,,Сен өте шулысың, маған жақындама.
Dialogue: 0,0:08:45.79,0:08:48.78,Default,,0,0,0,,Жақсы, біз бәріміз бір отбасымыз.
Dialogue: 0,0:08:48.78,0:08:50.78,Default,,0,0,0,,Менің отбасым жоқ.
Dialogue: 0,0:08:50.78,0:08:52.78,Default,,0,0,0,,Міне біз!
Dialogue: 0,0:08:52.78,0:08:55.78,Default,,0,0,0,,Хякуя балалар үйіндегі барлығы бір отбасы.
Dialogue: 0,0:08:55.78,0:08:57.78,Default,,0,0,0,,Директор айтты
Dialogue: 0,0:08:58.79,0:09:00.79,Default,,0,0,0,,Күрсін... Сен ақымақсың ба?
Dialogue: 0,0:09:00.79,0:09:02.79,Default,,0,0,0,,Иә, барлығы.
Dialogue: 0,0:09:02.79,0:09:05.78,Default,,0,0,0,,Бүгін бізге отбасының тағы бір жаңа мүшесі қосылды.
Dialogue: 0,0:09:05.78,0:09:09.78,Default,,0,0,0,,Бұл Юичиро-кун. Өтінемін, маған мейірімді болыңыз.
Dialogue: 0,0:09:09.78,0:09:11.78,Default,,0,0,0,,Уа!
Dialogue: 0,0:09:13.79,0:09:15.79,Default,,0,0,0,,Сәлем Ю-чан
Dialogue: 0,0:09:17.79,0:09:19.79,Default,,0,0,0,,Мен Михаэламын
Dialogue: 0,0:09:19.79,0:09:21.78,Default,,0,0,0,,Дәл сен сияқты мен де жалғыз болдым.
Dialogue: 0,0:09:21.78,0:09:23.78,Default,,0,0,0,,Қазір мұнда менің көп отбасым бар.
Dialogue: 0,0:09:23.78,0:09:26.78,Default,,0,0,0,,Ал бүгін, сен және сенің отбасың... Боқ болмаңдар.
Dialogue: 0,0:09:26.78,0:09:28.78,Default,,0,0,0,,Отбасы дегеніміз не? иә?
Dialogue: 0,0:09:28.78,0:09:33.79,Default,,0,0,0,,Мен... өз әкем мені өлтіре жаздағаннан кейін келдім.
Dialogue: 0,0:09:33.79,0:09:38.78,Default,,0,0,0,,Анам... шайтанның баласымын деп маған айғайлап жатты.
Dialogue: 0,0:09:38.78,0:09:40.78,Default,,0,0,0,,Соңында ол өз-өзіне қол жұмсады.
Dialogue: 0,0:09:40.78,0:09:42.78,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:09:42.78,0:09:44.78,Default,,0,0,0,,Мен үшін отбасым жоқ... Иә?
Dialogue: 0,0:09:44.78,0:09:46.78,Default,,0,0,0,,Бұл қиын болды, солай емес пе?
Dialogue: 0,0:09:46.78,0:09:49.78,Default,,0,0,0,,Бірақ бүгіннен бастап біз сенің отбасыңбыз.
Dialogue: 0,0:09:56.78,0:09:58.78,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:09:59.78,0:10:03.78,Default,,0,0,0,,Барлығы Ю Чанның кешкі ас ішуін күтіп отыр.
Dialogue: 0,0:10:06.79,0:10:08.79,Default,,0,0,0,,Айналма жолмен жүрсең жақсы емес.
Dialogue: 0,0:10:15.78,0:10:19.78,Default,,0,0,0,,Ю-чан! Ю-нии-чан, кешігіп қалдың!
Dialogue: 0,0:10:20.79,0:10:22.79,Default,,0,0,0,,Ооооооооооооооооооооооооооооооооо!
Dialogue: 0,0:10:22.79,0:10:25.79,Default,,0,0,0,,Эй, бүгін карри.
Dialogue: 0,0:10:25.79,0:10:28.79,Default,,0,0,0,,Ақан маған карри дайындап береді.
Dialogue: 0,0:10:28.79,0:10:30.79,Default,,0,0,0,,​​Карри?
Dialogue: 0,0:10:32.78,0:10:35.78,Default,,0,0,0,,Мен мұны қалай істей аламын? Сіз таң қалдыңыз ба?
Dialogue: 0,0:10:36.78,0:10:38.78,Default,,0,0,0,,Мика оны маған ертерек әкелген.
Dialogue: 0,0:10:39.79,0:10:42.79,Default,,0,0,0,,Мен мұндай тойды бірінші рет өткізіп отырмын, сондықтан қолдарым шырылдады.
Dialogue: 0,0:10:43.79,0:10:45.79,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:10:54.84,0:10:56.84,Default,,0,0,0,,Уау... дәмді
Dialogue: 0,0:11:03.83,0:11:06.83,Default,,0,0,0,,Ю-нии-чан, не болды? Тамақ ішпейсің бе?
Dialogue: 0,0:11:06.83,0:11:09.83,Default,,0,0,0,,Иә... Бұл сәбіз. Сәбіз болды!
Dialogue: 0,0:11:09.83,0:11:12.84,Default,,0,0,0,,Білесің бе, бүгін сенің туған күнің сияқты.
Dialogue: 0,0:11:12.84,0:11:14.84,Default,,0,0,0,,Бұл менің де туған күнім.
Dialogue: 0,0:11:14.84,0:11:18.83,Default,,0,0,0,,Сен қусың, мен де, мен де!
Dialogue: 0,0:11:18.83,0:11:23.83,Default,,0,0,0,,Міне, бүгін барлығының туған күні!
Dialogue: 0,0:11:23.83,0:11:26.83,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:11:27.84,0:11:30.84,Default,,0,0,0,,Мен Мика-нииге алғыс айтуым керек!
Dialogue: 0,0:11:30.84,0:11:32.84,Default,,0,0,0,,Мика-нии қайда кетті?
Dialogue: 0,0:11:32.84,0:11:34.84,Default,,0,0,0,,Неге ол жерде емессің?
Dialogue: 0,0:11:34.84,0:11:37.83,Default,,0,0,0,,Ю-ни-чан, Мика-ни ше?
Dialogue: 0,0:11:37.83,0:11:40.83,Default,,0,0,0,,А... Мика осында.
Dialogue: 0,0:11:44.84,0:11:49.84,Default,,0,0,0,,Тайчи алды! Содан кейін Тайчидің карриі тәркіленеді.
Dialogue: 0,0:11:49.84,0:11:51.84,Default,,0,0,0,,Иә... Ахаха
Dialogue: 0,0:11:51.84,0:11:55.84,Default,,0,0,0,,Менің каррим... Ахахаха
Dialogue: 0,0:12:22.84,0:12:25.84,Default,,0,0,0,,Эй, мен оралдым, Ю-чан.
Dialogue: 0,0:12:26.84,0:12:28.84,Default,,0,0,0,,Ахсо
Dialogue: 0,0:12:29.83,0:12:31.83,Default,,0,0,0,,Қайта қош келдіңіз демейсіз бе?
Dialogue: 0,0:12:31.83,0:12:34.84,Default,,0,0,0,,Қалай болғанда да, мен сіздің карри сыбағаңызды жедім.
Dialogue: 0,0:12:34.84,0:12:36.84,Default,,0,0,0,,Өтірікші! Бұл өтірік
Dialogue: 0,0:12:36.84,0:12:38.84,Default,,0,0,0,,Барлық гейктер бақытты болды.
Dialogue: 0,0:12:38.84,0:12:40.84,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:40.84,0:12:44.83,Default,,0,0,0,,...және? Сіз бұл карри үшін не істедіңіз?
Dialogue: 0,0:12:44.83,0:12:49.83,Default,,0,0,0,,…Шынымды айтсам, бұл жолы мен қанымды сатамын.
Dialogue: 0,0:12:49.83,0:12:53.84,Default,,0,0,0,,Ю-чанның қанының дәмі нашар және сатылмайды.
Dialogue: 0,0:12:53.84,0:12:56.84,Default,,0,0,0,,Өтірік, Ю Чан жақсы.
Dialogue: 0,0:12:56.84,0:12:59.84,Default,,0,0,0,,Ол вампирлерді ұшырып жібереді, солай ма?
Dialogue: 0,0:12:59.84,0:13:01.83,Default,,0,0,0,,Оған дейін мен... Ақымақ болма!
Dialogue: 0,0:13:01.83,0:13:04.83,Default,,0,0,0,,Әр нәрсеге өз бетіңізше кіріспеңіз.
Dialogue: 0,0:13:04.83,0:13:08.84,Default,,0,0,0,,Мен де... Мен де ақымақ емеспін.
Dialogue: 0,0:13:08.84,0:13:10.84,Default,,0,0,0,,Вампирді жеңу...!
Dialogue: 0,0:13:10.84,0:13:12.84,Default,,0,0,0,,Одан артық ештеңе жоқ.
Dialogue: 0,0:13:12.84,0:13:16.84,Default,,0,0,0,,Ю-чанның сөзі: Бұл балалар сенеді.
Dialogue: 0,0:13:16.84,0:13:19.83,Default,,0,0,0,,Біз вампирлерді жеңе аламыз, біз жеңілмейміз.
Dialogue: 0,0:13:19.83,0:13:22.83,Default,,0,0,0,,Ю-чанның сөздері қайталанады...
Dialogue: 0,0:13:24.84,0:13:26.84,Default,,0,0,0,,Жүр, карри жейміз.
Dialogue: 0,0:13:29.84,0:13:32.84,Default,,0,0,0,,Иә, сіз бәрібір оны жеген жоқсыз, сондықтан сізге қажет емес.
Dialogue: 0,0:13:32.84,0:13:36.84,Default,,0,0,0,,Бұл сенікі, жоқ!
Dialogue: 0,0:13:38.83,0:13:40.84,Default,,0,0,0,,Бұл сұрау емес, бұйрық.
Dialogue: 0,0:13:40.84,0:13:42.84,Default,,0,0,0,,Неліктен тапсырыстарыңыз...
Dialogue: 0,0:13:43.84,0:13:45.84,Default,,0,0,0,,Қаңтар! Өйткені Ю Чан
Dialogue: 0,0:13:45.84,0:13:48.84,Default,,0,0,0,,Енді біз вампирлермен күресуіміз керек.
Dialogue: 0,0:13:48.84,0:13:51.85,Default,,0,0,0,,Қарның ашса, күресуге болмайды.
Dialogue: 0,0:13:51.85,0:13:53.83,Default,,0,0,0,,Сіз...
Dialogue: 0,0:13:53.83,0:13:56.83,Default,,0,0,0,,Бірақ бұл соншалықты үлкен мәміле емес.
Dialogue: 0,0:13:56.83,0:13:59.84,Default,,0,0,0,,Жажан! Бұл қаланың картасы!
Dialogue: 0,0:13:59.84,0:14:02.84,Default,,0,0,0,,Шығуға дейін барады.
Dialogue: 0,0:14:02.84,0:14:05.84,Default,,0,0,0,,Сен... сол асылдансың ба?
Dialogue: 0,0:14:08.85,0:14:11.83,Default,,0,0,0,,​​Феридтің үйі кең.
Dialogue: 0,0:14:11.83,0:14:13.83,Default,,0,0,0,,Менің ойымша, оны табу үшін біраз уақыт қажет болды.
Dialogue: 0,0:14:14.84,0:14:17.84,Default,,0,0,0,,Мен қанымды вампирге тегін сорғызуға лайық емеспін.
Dialogue: 0,0:14:17.84,0:14:19.84,Default,,0,0,0,,Бұл Майкла
Dialogue: 0,0:14:19.84,0:14:22.84,Default,,0,0,0,,Бұл бүгін аяқталады.
Dialogue: 0,0:14:22.84,0:14:24.84,Default,,0,0,0,,Екеуміз бірге қашайық
Dialogue: 0,0:14:26.85,0:14:30.84,Default,,0,0,0,,Жарайды, жарайды, бәрі бұрыннан жоспарланған.
Dialogue: 0,0:14:30.84,0:14:32.84,Default,,0,0,0,,Михаэла-самаға қалдырыңыз!
Dialogue: 0,0:14:32.84,0:14:34.84,Default,,0,0,0,,Бірақ вирустар туралы не деуге болады?
Dialogue: 0,0:14:34.84,0:14:36.84,Default,,0,0,0,,Сыртта өлім әлемі...
Dialogue: 0,0:14:37.84,0:14:40.85,Default,,0,0,0,,Мен оның 13 жасқа толмағандарға жұқтырмайтынына сенімдімін.
Dialogue: 0,0:14:40.85,0:14:42.85,Default,,0,0,0,,Қазір неше жастамыз?
Dialogue: 0,0:14:42.85,0:14:44.85,Default,,0,0,0,,Сіз 12 жастасыз, солай ма?
Dialogue: 0,0:14:44.85,0:14:46.83,Default,,0,0,0,,Қалған жылы ойланып көрейік
Dialogue: 0,0:14:46.83,0:14:48.84,Default,,0,0,0,,Егер екеуміз болсак
Dialogue: 0,0:14:48.84,0:14:50.84,Default,,0,0,0,,Хякуя балалар үйінің отбасы жиналған кезде
Dialogue: 0,0:14:50.84,0:14:53.84,Default,,0,0,0,,Кез келген нәрсенің қалай болатынына сенімдімін!
Dialogue: 0,0:14:53.84,0:14:57.85,Default,,0,0,0,,Жоспарлы ма, әлде жоспардан тыс па білмеймін.
Dialogue: 0,0:14:57.85,0:14:59.85,Default,,0,0,0,,Өзіңіз шешіңіз
Dialogue: 0,0:14:59.85,0:15:01.85,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:02.85,0:15:04.85,Default,,0,0,0,,Сіз әлі ояусыз ба?
Dialogue: 0,0:15:05.84,0:15:07.84,Default,,0,0,0,,Мика, қош келдіңіз
Dialogue: 0,0:15:07.84,0:15:11.84,Default,,0,0,0,,Ю-чан мен үшін карри жеді.
Dialogue: 0,0:15:13.85,0:15:16.85,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:15:16.85,0:15:19.85,Default,,0,0,0,,Иә, кеттік, Акане-чан, барлығын оят.
Dialogue: 0,0:15:19.85,0:15:21.85,Default,,0,0,0,,Не?
Dialogue: 0,0:15:25.84,0:15:27.84,Default,,0,0,0,,Бұл дүниемен қош айт
Dialogue: 0,0:15:33.85,0:15:35.85,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:56.84,0:15:58.84,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:16:05.85,0:16:08.85,Default,,0,0,0,,Эй Мика-нии, қайда бара жатырсың? Маған қараңғы жерлер ұнамайды...
Dialogue: 0,0:16:08.85,0:16:11.85,Default,,0,0,0,,Түнде шығу жақсы емес.
Dialogue: 0,0:16:11.85,0:16:15.84,Default,,0,0,0,,Жарайды, жарайды, бұл дүниемен қоштасып жатырмыз.
Dialogue: 0,0:16:15.84,0:16:17.84,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:16:18.84,0:16:22.85,Default,,0,0,0,,Қош бол, қайда барасың? Бұл...
Dialogue: 0,0:16:22.85,0:16:24.85,Default,,0,0,0,,Бастапқы әлеміңізге оралыңыз
Dialogue: 0,0:16:24.85,0:16:27.85,Default,,0,0,0,,Сонда күн сайын карри жеуге болады.
Dialogue: 0,0:16:27.85,0:16:30.85,Default,,0,0,0,,Шынымен бе? Сіз шынымен күнде карри жейсіз бе?
Dialogue: 0,0:16:31.84,0:16:34.84,Default,,0,0,0,,Сонымен, гамбургерлер туралы не деуге болады? иә? Шш!
Dialogue: 0,0:16:57.85,0:16:59.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:11.85,0:17:13.85,Default,,0,0,0,,Егер сіз осы жерден өтсеңіз, сіз сырттасыз.
Dialogue: 0,0:17:13.85,0:17:15.85,Default,,0,0,0,,Жарайды, жақындап қалдық.
Dialogue: 0,0:17:15.85,0:17:17.85,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:17:18.85,0:17:20.86,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:20.86,0:17:22.86,Default,,0,0,0,,О
Dialogue: 0,0:17:38.86,0:17:41.86,Default,,0,0,0,,Ахан мен сені күттім...
Dialogue: 0,0:17:43.84,0:17:45.84,Default,,0,0,0,,Бейшара кішкентай қозылар
Dialogue: 0,0:17:48.85,0:17:50.85,Default,,0,0,0,,Иә, бұл бет
Dialogue: 0,0:17:50.85,0:17:53.85,Default,,0,0,0,,Үміт күтпеген жерден ғайып болған кездегі адамның жүзі
Dialogue: 0,0:17:53.85,0:17:56.85,Default,,0,0,0,,Сондықтан мен бұл ойынды ойнауды тоқтата алмаймын.
Dialogue: 0,0:17:57.84,0:17:59.84,Default,,0,0,0,,Ойнату...? Ха!
Dialogue: 0,0:18:04.85,0:18:06.85,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:06.85,0:18:08.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:09.85,0:18:11.85,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:18:14.84,0:18:17.85,Default,,0,0,0,,О, жоқ... ол әлдеқашан өлді
Dialogue: 0,0:18:17.85,0:18:19.85,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:19.85,0:18:21.85,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:23.85,0:18:25.85,Default,,0,0,0,,Ах! иә?
Dialogue: 0,0:18:25.85,0:18:27.86,Default,,0,0,0,,Бұл менің мылтығым емес пе?
Dialogue: 0,0:18:27.86,0:18:30.84,Default,,0,0,0,,Картаны ғана емес, мылтықты да алдыңыз ба?
Dialogue: 0,0:18:30.84,0:18:34.85,Default,,0,0,0,,Жақсы, сізде әлі де қарсы тұруға күш бар.
Dialogue: 0,0:18:34.85,0:18:37.85,Default,,0,0,0,,Ал, мен саған тағы бір үміт берейін.
Dialogue: 0,0:18:37.85,0:18:39.85,Default,,0,0,0,,Негізінде бұл карта шынайы.
Dialogue: 0,0:18:39.85,0:18:43.85,Default,,0,0,0,,Егер сіз сол жолда тіке жүгірсеңіз, бастапқы әлеміңізге оралуға болады.
Dialogue: 0,0:18:43.85,0:18:46.85,Default,,0,0,0,,​​Егер сіз сыртқа шықсаңыз, мен сізді оңай қуа алмаймын.
Dialogue: 0,0:18:47.84,0:18:49.84,Default,,0,0,0,,Үміт пен үмітсіздіктің арасы
Dialogue: 0,0:18:49.84,0:18:52.85,Default,,0,0,0,,Қалай жылайсыңдар деп ойлаймын
Dialogue: 0,0:18:52.85,0:18:54.85,Default,,0,0,0,,Қаш!
Dialogue: 0,0:18:54.85,0:18:56.85,Default,,0,0,0,,Жүгір! Апыр-ай!
Dialogue: 0,0:18:56.85,0:18:58.85,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:18:58.85,0:19:00.86,Default,,0,0,0,,Мен бұл туралы айттым ба?
Dialogue: 0,0:19:00.86,0:19:02.86,Default,,0,0,0,,Мен сені тоқтатамын!
Dialogue: 0,0:19:05.84,0:19:07.84,Default,,0,0,0,,Эй, сен келгеннен бері бәрі осылай болып тұр, иә?
Dialogue: 0,0:19:08.85,0:19:10.85,Default,,0,0,0,,Тоқтатыңыз...
Dialogue: 0,0:19:11.85,0:19:14.85,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:17.86,0:19:20.86,Default,,0,0,0,,Әй... Ақан!
Dialogue: 0,0:19:20.86,0:19:23.86,Default,,0,0,0,,Үмітсіз жүздеріңді көргім келеді
Dialogue: 0,0:19:31.85,0:19:34.86,Default,,0,0,0,,Ұмытпа, Ю-чан...
Dialogue: 0,0:19:34.86,0:19:37.86,Default,,0,0,0,,Біз отбасымыз
Dialogue: 0,0:19:39.84,0:19:41.85,Default,,0,0,0,,Ах... Эй!
Dialogue: 0,0:19:41.85,0:19:43.85,Default,,0,0,0,,Аха Михаэла-кун
Dialogue: 0,0:19:43.85,0:19:46.85,Default,,0,0,0,,Қаныңыз дәмді болды.
Dialogue: 0,0:19:46.85,0:19:48.85,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:19:48.85,0:19:50.85,Default,,0,0,0,,Әй! Ах...
Dialogue: 0,0:19:54.86,0:19:57.86,Default,,0,0,0,,Ю…чан…қашыңыз…
Dialogue: 0,0:19:59.85,0:20:01.85,Default,,0,0,0,,Өл
Dialogue: 0,0:20:03.85,0:20:07.85,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:20:08.86,0:20:11.86,Default,,0,0,0,,Мика! Сәлем Мика!
Dialogue: 0,0:20:13.86,0:20:15.85,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:20:15.85,0:20:18.85,Default,,0,0,0,,Бар, Ю-чан... Ақымақ болма!
Dialogue: 0,0:20:18.85,0:20:21.85,Default,,0,0,0,,Сен де менімен барасың! бірге...
Dialogue: 0,0:20:21.85,0:20:24.85,Default,,0,0,0,,Бізді ысырап етпе
Dialogue: 0,0:20:25.86,0:20:27.86,Default,,0,0,0,,Маған ұнамайды! Мен оны ұнатпаймын!
Dialogue: 0,0:20:30.86,0:20:33.86,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:20:36.85,0:20:39.85,Default,,0,0,0,,Менің отбасым...
Dialogue: 0,0:20:39.85,0:20:42.85,Default,,0,0,0,,Ақырында... Мен оны алдым.
Dialogue: 0,0:20:44.86,0:20:46.86,Default,,0,0,0,,Артында бірдеңе қалдырыңыз
Dialogue: 0,0:20:47.86,0:20:49.86,Default,,0,0,0,,Әй
Dialogue: 0,0:20:53.85,0:20:56.85,Default,,0,0,0,,Тез жүр! ақымақ!
Dialogue: 0,0:21:04.86,0:21:06.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:07.85,0:21:10.85,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:21:11.85,0:21:15.85,Default,,0,0,0,,Ю-чан алғаш рет "отбасы" дейді...
Dialogue: 0,0:21:17.86,0:21:21.86,Default,,0,0,0,,Уаааааааааааааааааааа!
Dialogue: 0,0:21:21.86,0:21:25.86,Default,,0,0,0,,Ух ха ха ха ха...
Dialogue: 0,0:21:28.85,0:21:30.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:30.86,0:21:33.86,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:21:33.86,0:21:37.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:37.86,0:21:39.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:43.85,0:21:45.85,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:21:58.85,0:22:00.85,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:22:00.85,0:22:02.85,Default,,0,0,0,,Болжағандай.
Dialogue: 0,0:22:02.85,0:22:07.85,Default,,0,0,0,,Жапонияны жойып жіберген Хякуя тәжірибелік алаңынан бір нысан пайда болды.
Dialogue: 0,0:22:09.86,0:22:11.86,Default,,0,0,0,,Бала…
Dialogue: 0,0:22:11.86,0:22:15.86,Default,,0,0,0,,Мен сені вампирлерді жою үшін пайдаланамын.
Dialogue: 0,0:22:18.85,0:22:20.85,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:22:23.86,0:22:25.86,Default,,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,0:22:29.80,0:22:32.80,Default,,0,0,0,,Егер мен вампирлерді жоя алсам
Dialogue: 0,0:22:34.30,0:22:39.30,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
