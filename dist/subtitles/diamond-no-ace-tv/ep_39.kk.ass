Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.50,0:00:37.10,Default,,0,0,0,,《Каваками: Иә, менің рөлім қосылу.》
Dialogue: 0,0:00:40.29,0:00:44.73,Default,,0,0,0,,《Каваками: Осы матчта соңына дейін барыңызды беріңіз→
Dialogue: 0,0:00:44.73,0:00:47.53,Default,,0,0,0,,Танба-санмен байланысу》
Dialogue: 0,0:00:51.09,0:00:53.49,Default,,0,0,0,,《Каваками: Танба-санның жазы→
Dialogue: 0,0:00:53.49,0:00:56.26,Default,,0,0,0,,Бұлай аяқталуына жол бере алмаймын→
Dialogue: 0,0:00:56.26,0:00:59.18,Default,,0,0,0,,Мен бармаймын! ! 》
Dialogue: 0,0:00:59.18,0:01:01.48,Default,,0,0,0,,《Миюки: Бойы жақсы》
Dialogue: 0,0:01:04.43,0:01:07.39,Default,,0,0,0,,《Қарғыс атсын, үшінші базаны күштеп тартып алды》
Dialogue: 0,0:01:07.39,0:01:09.89,Default,,0,0,0,,Уақытында үлгере алмаймын Допты бірінші!
Dialogue: 0,0:01:13.44,0:01:17.08,Default,,0,0,0,,Батереяның фокусы!
Dialogue: 0,0:01:17.08,0:01:19.80,Default,,0,0,0,,Жүгірушілер үшін алаңдамаңыз.
Dialogue: 0,0:01:19.80,0:01:22.69,Default,,0,0,0,,Бір-бірден шығарып алайық.
Dialogue: 0,0:01:22.69,0:01:25.96,Default,,0,0,0,,тағы 5 нәтиже!
Dialogue: 0,0:01:25.96,0:01:27.94,Default,,0,0,0,,Эйджун-кун.
Dialogue: 0,0:01:27.94,0:01:30.63,Default,,0,0,0,,Менің ойымша, Каваками-сенпай сізге қатты соққы береді→
Dialogue: 0,0:01:30.63,0:01:33.63,Default,,0,0,0,,Сөмкедегі баршаңызға рахмет!
Dialogue: 0,0:01:33.63,0:01:37.13,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:37.13,0:01:39.45,Default,,0,0,0,,《Директор иә деді, бірақ→
Dialogue: 0,0:01:39.45,0:01:42.30,Default,,0,0,0,,Бұл қазіргі үрдісті тудырған →
Dialogue: 0,0:01:42.30,0:01:44.47,Default,,0,0,0,,Мақсатымнан.
Dialogue: 0,0:01:44.47,0:01:46.84,Default,,0,0,0,,Үйіндіден түскен соң өзіме →
Dialogue: 0,0:01:46.84,0:01:49.44,Default,,0,0,0,,Менің қолымнан келетіні – көңіл көтеру.
Dialogue: 0,0:01:56.14,0:02:00.29,Default,,0,0,0,,Мен мұндамын ба?
Dialogue: 0,0:02:00.29,0:02:06.26,Default,,0,0,0,,[Баяндамашы] №6 Құмыраны Санада.
Dialogue: 0,0:02:06.26,0:02:10.33,Default,,0,0,0,,Өте ыстық.
Dialogue: 0,0:02:10.33,0:02:13.42,Default,,0,0,0,,《Менікі: Актерлерге арналған актерлер》
Dialogue: 0,0:02:13.42,0:02:19.84,Default,,0,0,0,,[Баяндамашы] №8 Каваками мырзаның орнына...
Dialogue: 0,0:02:19.84,0:02:26.44,Default,,0,0,0,,[Сөйлеуші] Құмыраны Тамба-кун №8 Құмыраны Тамба-кун.
Dialogue: 0,0:05:14.13,0:05:18.95,Default,,0,0,0,,[Спикер] Seido High School Біз сізге ойыншылардың ауыстырылғаны туралы хабарлаймыз.
Dialogue: 0,0:05:18.95,0:05:25.26,Default,,0,0,0,,[Баяндамашы] №8 Құмыраны Тамба-кун Каваками-кунның орнына.
Dialogue: 0,0:05:25.26,0:05:30.00,Default,,0,0,0,,[Баяндамашы] №8 Құмыраны Тамба-кун.
Dialogue: 0,0:05:30.00,0:05:33.60,Default,,0,0,0,,《Бұл адам Сейдоның Эйсі》
Dialogue: 0,0:05:38.29,0:05:42.80,Default,,0,0,0,,8-ші иннингтің жоғарғы жағы, 2 шығу, 1-ші және 3-ші негіз, 1 соққы, байланыстырылған.
Dialogue: 0,0:05:42.80,0:05:45.61,Default,,0,0,0,,Сонымен қатар, бірінші негізде кері жүгіруші бар.
Dialogue: 0,0:05:45.61,0:05:49.08,Default,,0,0,0,,Міне, ақырында Эйс пайда болады.
Dialogue: 0,0:05:49.08,0:05:57.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:57.96,0:06:02.36,Default,,0,0,0,,Мен шыдай алмаймын Ей, бұл көріністегі эйстердің кездесуі.
Dialogue: 0,0:06:02.36,0:06:05.97,Default,,0,0,0,,《Ойыннан бәрінен де осы адам ләззат алады》
Dialogue: 0,0:06:05.97,0:06:09.27,Default,,0,0,0,,Танба мырза, кешіріңіз...
Dialogue: 0,0:06:09.27,0:06:14.34,Default,,0,0,0,,Фуруя, Савамура және Каваками.
Dialogue: 0,0:06:14.34,0:06:17.94,Default,,0,0,0,,Сіздің питчингіңіз мені қаншалықты шабыттандырды.
Dialogue: 0,0:06:21.62,0:06:27.12,Default,,0,0,0,,Маған үш сезіміңді де сеніп тапсырасың ба?
Dialogue: 0,0:06:30.63,0:06:33.43,Default,,0,0,0,,《Тамба-сан…》
Dialogue: 0,0:06:39.27,0:06:41.95,Default,,0,0,0,,Нори! Мен оны осылай лақтырдым!
Dialogue: 0,0:06:41.95,0:06:44.59,Default,,0,0,0,,Қалғанын Тамбаға қалдырыңыз!
Dialogue: 0,0:06:44.59,0:06:46.74,Default,,0,0,0,,Әдемі қадам.
Dialogue: 0,0:06:46.74,0:06:49.65,Default,,0,0,0,,Сіз шыдамдылықпен айттыңыз.
Dialogue: 0,0:06:49.65,0:06:53.15,Default,,0,0,0,,Суық шай өтінемін, Еңбектеріңіз үшін рахмет!
Dialogue: 0,0:06:55.20,0:06:57.47,Default,,0,0,0,,Соңында...
Dialogue: 0,0:06:57.47,0:07:01.77,Default,,0,0,0,,Сіз бұл мүшелермен бірге жерге жеттіңіз.
Dialogue: 0,0:07:06.30,0:07:08.96,Default,,0,0,0,,Терең тыныс алыңыз. Терең тыныс ал!
Dialogue: 0,0:07:08.96,0:07:12.92,Default,,0,0,0,,Басы Мен оны ұстай аламын ба? Өйткені бұл пайдалы сияқты.
Dialogue: 0,0:07:12.92,0:07:16.46,Default,,0,0,0,,Хяхаха~! Мен де істей аламын ба?
Dialogue: 0,0:07:16.46,0:07:20.31,Default,,0,0,0,,Мен де. (Тамба) Ей, тоқта!
Dialogue: 0,0:07:20.31,0:07:24.31,Default,,0,0,0,,《Күшімді алып кеткенің үшін рахмет》
Dialogue: 0,0:07:28.13,0:07:32.04,Default,,0,0,0,,((Мияучи: Тамбаның бұқадағы жағдайы мүлде жаман емес еді.
Dialogue: 0,0:07:32.04,0:07:35.34,Default,,0,0,0,,Түзу күшке ие болды))
Dialogue: 0,0:07:35.34,0:07:37.34,Default,,0,0,0,,《Мия-сан…》
Dialogue: 0,0:07:40.08,0:07:44.25,Default,,0,0,0,,Бірінші қадам Қамқорлық жасайық.
Dialogue: 0,0:07:44.25,0:07:48.47,Default,,0,0,0,,Якушидің соққылары бірінші алаңнан қатты соқты.
Dialogue: 0,0:07:48.47,0:07:50.82,Default,,0,0,0,,Ах.
Dialogue: 0,0:07:50.82,0:07:53.38,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:07:53.38,0:07:56.10,Default,,0,0,0,,Бірінші қадам, Санада.
Dialogue: 0,0:07:56.10,0:07:58.46,Default,,0,0,0,,Неге екенін білмеймін, бірақ ол жақтағы эйс осы жазда болады→
Dialogue: 0,0:07:58.46,0:08:00.52,Default,,0,0,0,,Бірінші қорған.
Dialogue: 0,0:08:00.52,0:08:02.58,Default,,0,0,0,,Ал 1-ші және 3-ші негіздегі жүгірушілер.
Dialogue: 0,0:08:02.58,0:08:06.29,Default,,0,0,0,,Бұл жағдайда қобалжыма Құмыра сауығып кетпейді.
Dialogue: 0,0:08:06.29,0:08:09.78,Default,,0,0,0,,Мен болсам, мен сені ұруым мүмкін еді.
Dialogue: 0,0:08:09.78,0:08:11.74,Default,,0,0,0,,Сөз жоқ.
Dialogue: 0,0:08:11.74,0:08:13.96,Default,,0,0,0,,Өз жағдайыңызды білу→
Dialogue: 0,0:08:13.96,0:08:16.95,Default,,0,0,0,,Сіз бірінші қадамда соққы алғыңыз келеді.
Dialogue: 0,0:08:16.95,0:08:19.45,Default,,0,0,0,,Осыны мақсат етіңіз.
Dialogue: 0,0:08:22.30,0:08:24.96,Default,,0,0,0,,Санада-сенпай! а?
Dialogue: 0,0:08:24.96,0:08:27.33,Default,,0,0,0,,Доп соққанда, мұны істе!
Dialogue: 0,0:08:27.33,0:08:30.93,Default,,0,0,0,,Келгенде солай болады! Мен мүлде түсінбеймін.
Dialogue: 0,0:08:30.93,0:08:34.30,Default,,0,0,0,,8-ші иннингтің жоғарғы жағы, бір соққының кері айналуы →
Dialogue: 0,0:08:34.30,0:08:37.69,Default,,0,0,0,,Сол жақтағы эйс қамыр ма? (Канамару) Соққымен шығады →
Dialogue: 0,0:08:37.69,0:08:39.72,Default,,0,0,0,,Бір шешім қабылдаңыз, Танба мырза!
Dialogue: 0,0:08:39.72,0:08:43.13,Default,,0,0,0,,≪Тамба! ≪Ace ақырында Сейдода да пайда болады.
Dialogue: 0,0:08:43.13,0:08:45.76,Default,,0,0,0,,≪Және бұл эйстердің кездесуі!
Dialogue: 0,0:08:45.76,0:08:49.65,Default,,0,0,0,,Тамбаның бірінші қадамына назар аударылады.
Dialogue: 0,0:08:49.65,0:08:52.28,Default,,0,0,0,,Әй, бұқада бәрі жақсы жүріп жатса да→
Dialogue: 0,0:08:52.28,0:08:55.59,Default,,0,0,0,,Қапшы мен жүгіруші ойыны басқа деңгейде.
Dialogue: 0,0:08:55.59,0:08:59.01,Default,,0,0,0,,Ең жаманы - өзіңізді қалай сезінетініңіз→
Dialogue: 0,0:08:59.01,0:09:02.95,Default,,0,0,0,,Түсінбестен теру.
Dialogue: 0,0:09:02.95,0:09:05.78,Default,,0,0,0,,Орташа….
Dialogue: 0,0:09:05.78,0:09:09.89,Default,,0,0,0,,《Манака: Үніңді жап, Коичиро.
Dialogue: 0,0:09:09.89,0:09:13.69,Default,,0,0,0,,Команданың жеңісі сіздің ойынға байланысты.
Dialogue: 0,0:09:17.79,0:09:21.16,Default,,0,0,0,,《Бірінші іргедегі жүгіруші тек оны бақылап отыруы керек.
Dialogue: 0,0:09:21.16,0:09:23.42,Default,,0,0,0,,Тек қамырға назар аударыңыз》
Dialogue: 0,0:09:23.42,0:09:25.42,Default,,0,0,0,,Санада! Барынша қатты тербеліңіз!
Dialogue: 0,0:09:25.42,0:09:27.62,Default,,0,0,0,,Мен тіпті үйге барамын!
Dialogue: 0,0:09:27.62,0:09:30.62,Default,,0,0,0,,Егер сіз оны осында ұрсаңыз, ол өте ыстық болады!
Dialogue: 0,0:09:34.14,0:09:37.61,Default,,0,0,0,,О! ! Мен сені қорғаймын.
Dialogue: 0,0:09:37.61,0:09:41.42,Default,,0,0,0,,Танба мырза! (Масуко) Маған соғуға рұқсат етіңіз!
Dialogue: 0,0:09:41.42,0:09:45.64,Default,,0,0,0,,Раа~! ! Бұраңыз, Ола! !
Dialogue: 0,0:09:45.64,0:09:49.59,Default,,0,0,0,,《Алғашқы қадам түзу.
Dialogue: 0,0:09:49.59,0:09:51.96,Default,,0,0,0,,Шарға айналуға болады.
Dialogue: 0,0:09:51.96,0:09:54.93,Default,,0,0,0,,Күшті доп! 》
Dialogue: 0,0:09:54.93,0:09:58.13,Default,,0,0,0,,Тамба! Шығарыңыз.
Dialogue: 0,0:09:58.13,0:10:02.57,Default,,0,0,0,,《Өкінетін допты лақтырма, Тамба》
Dialogue: 0,0:10:02.57,0:10:05.07,Default,,0,0,0,,Фокус! шоғырлану! шоғырлану!
Dialogue: 0,0:10:12.26,0:10:14.62,Default,,0,0,0,,《Жарайды.
Dialogue: 0,0:10:14.62,0:10:19.29,Default,,0,0,0,,Митта мен қамырдың бетін анық көруге болады.
Dialogue: 0,0:10:19.29,0:10:22.16,Default,,0,0,0,,Жарайды》
Dialogue: 0,0:10:22.16,0:10:24.91,Default,,0,0,0,,((Исашики: Сен ақымақ!
Dialogue: 0,0:10:24.91,0:10:28.41,Default,,0,0,0,,Допты абайсызда лақтырсаң, ұстап алады!
Dialogue: 0,0:10:28.41,0:10:32.28,Default,,0,0,0,,Келесі - 1-ші және 3-ші негіз, ешқандай шығусыз))
Dialogue: 0,0:10:32.28,0:10:36.66,Default,,0,0,0,,《Оларға...
Dialogue: 0,0:10:36.66,0:10:39.32,Default,,0,0,0,,Сол жігіттермен салыстырғанда...》
Dialogue: 0,0:10:39.32,0:10:41.82,Default,,0,0,0,,《Менікі: Бірінші қадам қалай кіреді? 》
Dialogue: 0,0:10:45.60,0:10:48.33,Default,,0,0,0,,《Артқа доп! ? 》
Dialogue: 0,0:10:48.33,0:10:50.63,Default,,0,0,0,,Мені ұр!
Dialogue: 0,0:11:04.78,0:11:07.65,Default,,0,0,0,,Уау! Керемет доп!
Dialogue: 0,0:11:07.65,0:11:11.26,Default,,0,0,0,,Цк... Мен сені тоқтата алмадым ба?
Dialogue: 0,0:11:11.26,0:11:15.29,Default,,0,0,0,,《Қарғыс атсын... доп мен ойлағаннан да күшті》
Dialogue: 0,0:11:15.29,0:11:18.98,Default,,0,0,0,,《Сабақ басқаша болғанымен, мен Мия-санның кеңесін орындадым→
Dialogue: 0,0:11:18.98,0:11:22.98,Default,,0,0,0,,Доптың күші болды. Егер бұл...》
Dialogue: 0,0:11:26.84,0:11:30.64,Default,,0,0,0,,《Бұл адамның шешуші добы – тігінен бөлінген қисық》
Dialogue: 0,0:11:35.81,0:11:37.81,Default,,0,0,0,,Фуши!
Dialogue: 0,0:11:39.97,0:11:41.94,Default,,0,0,0,,≪Фол!
Dialogue: 0,0:11:41.94,0:11:44.79,Default,,0,0,0,,Сіз екі түзу қадаммен кірдіңіз бе?
Dialogue: 0,0:11:44.79,0:11:48.48,Default,,0,0,0,,Доп мен орнатқан жерге бармайды, бірақ жүгіріп келе жатқан сияқты.
Dialogue: 0,0:11:48.48,0:11:50.48,Default,,0,0,0,,Ах.
Dialogue: 0,0:11:53.90,0:11:57.50,Default,,0,0,0,,Басқа нәрсе - бұл қисық дәлдігі, ол Тамбамен синоним болып табылады.
Dialogue: 0,0:12:03.26,0:12:07.65,Default,,0,0,0,,《Допты көрсетіп қана қоймай, шешім қабылдап жатқандай кейіп танытыңыз》
Dialogue: 0,0:12:07.65,0:12:11.62,Default,,0,0,0,,《Жоқ, қисық жақында келуі мүмкін》
Dialogue: 0,0:12:11.62,0:12:16.00,Default,,0,0,0,,《Оны қатты ойлама, Санада.
Dialogue: 0,0:12:16.00,0:12:19.80,Default,,0,0,0,,Сезіммен соққы! Ақыл-ойды қолданыңыз! 》
Dialogue: 0,0:13:24.41,0:13:29.63,Default,,0,0,0,,《Менікі: Ойынның 8-ші иннингі болды, айырмашылық бар болғаны 1 ұпай.
Dialogue: 0,0:13:29.63,0:13:33.77,Default,,0,0,0,,Үшінші топтағы жүгіруші қайтып келсе, ұпай тең.
Dialogue: 0,0:13:33.77,0:13:38.50,Default,,0,0,0,,Қате Доп Доп Жабайы қадам Маңызды емес.
Dialogue: 0,0:13:38.50,0:13:42.60,Default,,0,0,0,,Бір ойын ойынды қатты өзгерте алады》
Dialogue: 0,0:13:51.43,0:13:54.82,Default,,0,0,0,,《Оны қатты ойлама, Санада.
Dialogue: 0,0:13:54.82,0:13:59.29,Default,,0,0,0,,Ақылмен ұру керек! Ақыл-ойды қолданыңыз! 》
Dialogue: 0,0:13:59.29,0:14:02.16,Default,,0,0,0,,Мен сені қуып келемін, Танба-сан!
Dialogue: 0,0:14:02.16,0:14:04.16,Default,,0,0,0,,Келесіні шешіңіз!
Dialogue: 0,0:14:08.13,0:14:10.27,Default,,0,0,0,,Нәтижелерге алаңдамаңыз!
Dialogue: 0,0:14:10.27,0:14:12.37,Default,,0,0,0,,Барынша қатты тербеліңіз! Шунпей!
Dialogue: 0,0:14:21.46,0:14:23.46,Default,,0,0,0,,Фуши!
Dialogue: 0,0:14:27.64,0:14:29.81,Default,,0,0,0,,《Райнчи: Мен артқа кеттім! 》
Dialogue: 0,0:14:29.81,0:14:48.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:53.80,0:14:56.47,Default,,0,0,0,,《Шынымен, ол адам...》
Dialogue: 0,0:14:56.47,0:15:00.60,Default,,0,0,0,,Уау... Мен оны тоқтаттым!
Dialogue: 0,0:15:00.60,0:15:03.29,Default,,0,0,0,,Енді оң қолыңызбен! ?
Dialogue: 0,0:15:03.29,0:15:06.44,Default,,0,0,0,,Егер мен кері бұрылып кетсем, бұл галстук болар еді.
Dialogue: 0,0:15:06.44,0:15:09.59,Default,,0,0,0,,Мен оны тоқтаттым! Жақсы аялдама!
Dialogue: 0,0:15:09.59,0:15:11.61,Default,,0,0,0,,Миюки-сенпай.
Dialogue: 0,0:15:11.61,0:15:16.77,Default,,0,0,0,,``Денемнің уақытында үлгере алмайтынын көріп, мен бірден оң қолымды создым.
Dialogue: 0,0:15:16.77,0:15:19.77,Default,,0,0,0,,Әлгі аулаушының жігері бар.
Dialogue: 0,0:15:23.48,0:15:25.83,Default,,0,0,0,,《Бару...》
Dialogue: 0,0:15:25.83,0:15:28.46,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:15:28.46,0:15:31.12,Default,,0,0,0,,Сіз күш салып жатырсыз, Танба-сан!
Dialogue: 0,0:15:31.12,0:15:33.22,Default,,0,0,0,,Демалыңыз Демалыңыз!
Dialogue: 0,0:15:36.00,0:15:38.26,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:15:38.26,0:15:42.44,Default,,0,0,0,,Танба ең сенімді қисық...
Dialogue: 0,0:15:42.44,0:15:44.74,Default,,0,0,0,,Күтілгендей жағдай әлі де...
Dialogue: 0,0:15:50.14,0:15:54.11,Default,,0,0,0,,((Не болды, Тамба!? Жақсырақ доп лақтыр!
Dialogue: 0,0:15:54.11,0:15:57.81,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:15:57.81,0:16:00.80,Default,,0,0,0,,Не істеу керек? Ол қазірдің өзінде көтеріле ме?
Dialogue: 0,0:16:00.80,0:16:04.63,Default,,0,0,0,,Жоқ, тағы бір раунд, тағы бір раунд, өтінемін.
Dialogue: 0,0:16:04.63,0:16:08.05,Default,,0,0,0,,Балалар, оны жайына қалдырыңдар.
Dialogue: 0,0:16:08.05,0:16:11.65,Default,,0,0,0,,Сіздің жағдайыңызға әлі де көңіліңіз толмай ма? ))
Dialogue: 0,0:16:15.79,0:16:18.76,Default,,0,0,0,,Мұны ол жақсы біледі.
Dialogue: 0,0:16:18.76,0:16:20.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.80,0:16:22.83,Default,,0,0,0,,Өйткені адамның өзі → біледі
Dialogue: 0,0:16:22.83,0:16:24.93,Default,,0,0,0,,Оны қорғанның үстіне қойды.
Dialogue: 0,0:16:27.94,0:16:32.48,Default,,0,0,0,,《Санада: Доп менің саусағыма ілініп қалды.
Dialogue: 0,0:16:32.48,0:16:36.55,Default,,0,0,0,,Осындай бір соққыдан кейін қисық допты лақтыру қиын болады→
Dialogue: 0,0:16:36.55,0:16:40.30,Default,,0,0,0,,Өйткені, бұл кісінің өзі қобалжыған.
Dialogue: 0,0:16:40.30,0:16:51.65,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:51.65,0:16:54.75,Default,,0,0,0,,《Тамба: Жарайды... лақтыруға асықпа》
Dialogue: 0,0:16:59.75,0:17:01.76,Default,,0,0,0,,О! !
Dialogue: 0,0:17:01.76,0:17:03.76,Default,,0,0,0,,《Тамба: Барлығы артымызда》
Dialogue: 0,0:17:03.76,0:17:11.42,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:11.42,0:17:14.30,Default,,0,0,0,,《Қазір өзіме...
Dialogue: 0,0:17:14.30,0:17:17.94,Default,,0,0,0,,Егер мен қазір қолымнан келгенді істесем...》
Dialogue: 0,0:17:17.94,0:17:19.94,Default,,0,0,0,,Буши.
Dialogue: 0,0:17:32.62,0:17:35.29,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:17:35.29,0:17:37.96,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:37.96,0:17:40.31,Default,,0,0,0,,Ах! !
Dialogue: 0,0:17:40.31,0:17:51.01,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:51.01,0:17:54.79,Default,,0,0,0,,Уау, Сейдоның эйзы Танба мырза күткендей!
Dialogue: 0,0:17:54.79,0:17:58.15,Default,,0,0,0,,Эй, мен бір ұпай айырмашылығын сақтап қалдым!
Dialogue: 0,0:17:58.15,0:18:00.75,Default,,0,0,0,,Қатарынан екі қисық шар →
Dialogue: 0,0:18:00.75,0:18:04.60,Default,,0,0,0,,Мен оны бір соққыдан кейін лақтырамын деп ойламадым.
Dialogue: 0,0:18:04.60,0:18:07.97,Default,,0,0,0,,Миюки де батыл жетекшілік етті.
Dialogue: 0,0:18:07.97,0:18:11.14,Default,,0,0,0,,《Уақыт дұрыс болды →
Dialogue: 0,0:18:11.14,0:18:14.91,Default,,0,0,0,,Бұл бір соққыдан жасалған қимыл болды, бірақ мен қолдарымды дұрыс сермеп алдым.
Dialogue: 0,0:18:14.91,0:18:20.45,Default,,0,0,0,,Бұл мен басқа жерден таба алатын ең жақсы доп болды, Танба мырза.
Dialogue: 0,0:18:20.45,0:18:23.62,Default,,0,0,0,,Керемет питч. Танба мырза.
Dialogue: 0,0:18:23.62,0:18:26.49,Default,,0,0,0,,Керемет доп Тамба! (Масуко) Угара.
Dialogue: 0,0:18:26.49,0:18:29.54,Default,,0,0,0,,Танба мырза….
Dialogue: 0,0:18:29.54,0:18:32.75,Default,,0,0,0,,《Фуруя: Оның кезегі емес еді...》
Dialogue: 0,0:18:32.75,0:18:35.80,Default,,0,0,0,,《Әрине, бақылауда өзгерістер бар→
Dialogue: 0,0:18:35.80,0:18:38.42,Default,,0,0,0,,Жағдайы жақсы емес.
Dialogue: 0,0:18:38.42,0:18:42.12,Default,,0,0,0,,Бірақ мен оның мінсіз емес екенін білемін→
Dialogue: 0,0:18:42.12,0:18:47.91,Default,,0,0,0,,Ешбір жамандықты ойламай, қайта ашыла алдым.
Dialogue: 0,0:18:47.91,0:18:50.92,Default,,0,0,0,,Якушидің шабуылына бір айналым қалды.
Dialogue: 0,0:18:50.92,0:18:53.33,Default,,0,0,0,,Бұл жолы біз → галстукқа жете алмадық
Dialogue: 0,0:18:53.33,0:18:55.37,Default,,0,0,0,,Бұл ауыр болуы керек.
Dialogue: 0,0:18:55.37,0:18:59.09,Default,,0,0,0,,А, бұл зиян өте үлкен.
Dialogue: 0,0:18:59.09,0:19:01.84,Default,,0,0,0,,Seido 4 құмыра эстафетасының алдында →
Dialogue: 0,0:19:01.84,0:19:05.14,Default,,0,0,0,,Ақыр соңында, мен ешқашан жетекшілік ете алмадым.
Dialogue: 0,0:19:14.42,0:19:18.64,Default,,0,0,0,,[Баяндамашы] №2 Риосуке Коминато.
Dialogue: 0,0:19:18.64,0:19:24.78,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:24.78,0:19:27.44,Default,,0,0,0,,Дараша! !
Dialogue: 0,0:19:27.44,0:19:54.10,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:54.10,0:19:56.30,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:56.30,0:19:59.18,Default,,0,0,0,,Ой, 8-ші нүкте!
Dialogue: 0,0:19:59.18,0:20:01.48,Default,,0,0,0,,Үздіксіз уақтылылық.
Dialogue: 0,0:20:04.76,0:20:09.46,Default,,0,0,0,,Санада мырза, сіз Сейдоның соққылар тізімін осы уақытқа дейін бір ұпайға дейін жеткіздіңіз...
Dialogue: 0,0:20:09.46,0:20:12.25,Default,,0,0,0,,Хмм, сіз ақыры ұсталдыңыз.
Dialogue: 0,0:20:12.25,0:20:14.25,Default,,0,0,0,,Бұл үш нүктелік айырмашылық.
Dialogue: 0,0:20:14.25,0:20:18.47,Default,,0,0,0,,Бұл Тамбаға арналған қосымша.
Dialogue: 0,0:20:18.47,0:20:21.34,Default,,0,0,0,,《Оның соққы күші де айтарлықтай төмендеді.
Dialogue: 0,0:20:21.34,0:20:25.74,Default,,0,0,0,,Осы арқылы мен тағы 2-3 ұпай ала аламын...
Dialogue: 0,0:20:25.74,0:20:29.13,Default,,0,0,0,,Фуруя: Дәл сол құмыра.
Dialogue: 0,0:20:29.13,0:20:31.18,Default,,0,0,0,,Сіз соңғы соққыны беруіңіз керек.
Dialogue: 0,0:20:31.18,0:20:34.78,Default,,0,0,0,,[Баяндамашы] № 7, Фуруя мырзадан шықты.
Dialogue: 0,0:20:38.64,0:20:41.49,Default,,0,0,0,,Шунпей, күте тұр!
Dialogue: 0,0:20:41.49,0:20:43.43,Default,,0,0,0,,Соғуға рұқсат етейік!
Dialogue: 0,0:20:43.43,0:20:45.63,Default,,0,0,0,,1-ден 1 шықты!
Dialogue: 0,0:20:45.63,0:20:47.80,Default,,0,0,0,,≪Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:20:47.80,0:20:49.80,Default,,0,0,0,,≪Әлі бір иннинг қалды!
Dialogue: 0,0:20:49.80,0:20:52.12,Default,,0,0,0,,≪Санада! ≪Шунпей!
Dialogue: 0,0:20:52.12,0:20:54.49,Default,,0,0,0,,≪Жарайды, кеттік! <<Тұрыңыз!
Dialogue: 0,0:20:54.49,0:20:57.94,Default,,0,0,0,,Ұпай айырмашылығы үлкен болса да, дауыстар әлі де естіледі.
Dialogue: 0,0:20:57.94,0:21:01.63,Default,,0,0,0,,Якуши ойыннан бас тартқан жоқ.
Dialogue: 0,0:21:01.63,0:21:03.77,Default,,0,0,0,,《Әлі біткен жоқ》
Dialogue: 0,0:21:03.77,0:21:06.77,Default,,0,0,0,,《Бізде тағы бір шабуыл бар》
Dialogue: 0,0:21:10.47,0:21:14.51,Default,,0,0,0,,《Егер мен оған соққы кезегін берсем...
Dialogue: 0,0:21:14.51,0:21:16.81,Default,,0,0,0,,Оған! 》
Dialogue: 0,0:21:19.33,0:21:23.83,Default,,0,0,0,,Жалғасы Фуруя! Тағы бір үйге жүгірейік!
Dialogue: 0,0:21:27.31,0:21:29.84,Default,,0,0,0,,1 курс өкілі!
Dialogue: 0,0:21:29.84,0:21:32.76,Default,,0,0,0,,Тәтті шарлар бар, белсенді бол!
Dialogue: 0,0:21:32.76,0:21:41.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:41.34,0:21:43.34,Default,,0,0,0,,Қысқа!
Dialogue: 0,0:21:46.14,0:21:49.58,Default,,0,0,0,,≪Өт!
Dialogue: 0,0:21:49.58,0:21:52.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:52.63,0:21:54.67,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:21:54.67,0:21:58.29,Default,,0,0,0,,Шунпей күткендей, бұл оқты ешкім тигізе алмайды!
Dialogue: 0,0:21:58.29,0:22:00.61,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:22:00.61,0:22:03.29,Default,,0,0,0,,Керемет Санада-сенпай!
Dialogue: 0,0:22:03.29,0:22:07.16,Default,,0,0,0,,《Оңай шешім қабылдауыма жол берме》
Dialogue: 0,0:22:07.16,0:22:10.95,Default,,0,0,0,,Ұпайлар айырмасы 3 ұпай. Тек соңғы раунд қалды.
Dialogue: 0,0:22:10.95,0:22:15.62,Default,,0,0,0,,Якушидің соққы сызығы қандай шабуылды көрсетеді?→
Dialogue: 0,0:22:15.62,0:22:17.79,Default,,0,0,0,,Мен соңына дейін түсінбеймін.
Dialogue: 0,0:22:17.79,0:22:21.43,Default,,0,0,0,,≪Санада! ≪Жарайсың!
Dialogue: 0,0:22:21.43,0:22:24.43,Default,,0,0,0,,《Шіркін, мен тағы да кептелдім》
Dialogue: 0,0:22:24.43,0:22:27.58,Default,,0,0,0,,Ашық қалдыру кезінде қайта пайда болу мүмкіндігі →
Dialogue: 0,0:22:27.58,0:22:31.45,Default,,0,0,0,,Ол сырт алаңда қорғаныста да ойнауы керек.
Dialogue: 0,0:22:31.45,0:22:36.42,Default,,0,0,0,,Фуруяның шаршауы жиналып қалған болуы мүмкін.
Dialogue: 0,0:22:36.42,0:22:39.81,Default,,0,0,0,,Кадота: Иықтарың дайын ба?
Dialogue: 0,0:22:39.81,0:22:42.60,Default,,0,0,0,,9-шы иннинг Сіз оны сол жақ алаңға қойдыңыз.
Dialogue: 0,0:22:42.60,0:22:44.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:44.58,0:22:46.62,Default,,0,0,0,,Қорған….
Dialogue: 0,0:22:46.62,0:22:49.59,Default,,0,0,0,,Өтінемін, өзіңді сыпайы түрде түсір, Фуруя.
Dialogue: 0,0:22:49.59,0:22:53.41,Default,,0,0,0,,《1 иннинг солға, ағынды өзгертетін қателер→
Dialogue: 0,0:22:53.41,0:22:57.31,Default,,0,0,0,,Мен одан барынша аулақ болғым келеді. Сырт қорғаушы Кадотаны қосу арқылы →
Dialogue: 0,0:22:57.31,0:22:59.85,Default,,0,0,0,,Қорғаныс уайымдары жойылса да →
Dialogue: 0,0:22:59.85,0:23:04.97,Default,,0,0,0,,Осымен Тамбадан басқа барлық құмыралар орындыққа кетті.
Dialogue: 0,0:23:04.97,0:23:07.49,Default,,0,0,0,,Тамба.
Dialogue: 0,0:23:07.49,0:23:10.99,Default,,0,0,0,,Ұпайлар айырмасы 3 ұпай.
Dialogue: 0,0:23:10.99,0:23:13.09,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:23:17.30,0:23:19.30,Default,,0,0,0,,Бұл дәл қазір шешілді, солай емес пе?
Dialogue: 0,0:23:19.30,0:23:21.30,Default,,0,0,0,,Сен бейбақ.
Dialogue: 0,0:23:21.30,0:23:23.72,Default,,0,0,0,,Иә, бұл Эйске ұқсайды.
Dialogue: 0,0:23:23.72,0:23:27.13,Default,,0,0,0,,Ұзақ уақыттан кейін қорғанды ​​тамашалаңыз.
Dialogue: 0,0:23:27.13,0:23:30.13,Default,,0,0,0,,Қайта айқайлаңыз, хаха!
Dialogue: 0,0:23:30.13,0:23:32.60,Default,,0,0,0,,Маған соғуға рұқсат етіңіз.
Dialogue: 0,0:23:32.60,0:23:35.10,Default,,0,0,0,,Бір-бірден барайық.
Dialogue: 0,0:23:39.19,0:23:44.46,Default,,0,0,0,,Кеттік! Эй!
Dialogue: 0,0:23:44.46,0:23:49.46,Default,,0,0,0,,тағы 3 қорытынды Соңғы бөлім Барлығыңызға рахмет!
Dialogue: 0,0:23:49.46,0:23:51.47,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:23:51.47,0:23:54.64,Default,,0,0,0,,Тамба! Танба-сан!
Dialogue: 0,0:23:54.64,0:23:58.52,Default,,0,0,0,,Танба мырза! (Сачико) Мен шешемін!
Dialogue: 0,0:23:58.52,0:24:00.43,Default,,0,0,0,,Кеттік, Тамба!
Dialogue: 0,0:24:00.43,0:24:02.43,Default,,0,0,0,,Тамба-сан, өтінемін!
Dialogue: 0,0:24:02.43,0:24:04.41,Default,,0,0,0,,≪Тамба-сан!
Dialogue: 0,0:24:04.41,0:24:08.28,Default,,0,0,0,,≪Бір-бірден алайық!
Dialogue: 0,0:24:08.28,0:24:11.95,Default,,0,0,0,,Үш ұпай айырмашылығы бар ма?
Dialogue: 0,0:24:11.95,0:24:15.66,Default,,0,0,0,,Бұл жағдайды өзгерту үшін дұрыс нүкте айырмашылығы емес пе?
Dialogue: 0,0:24:15.66,0:24:18.26,Default,,0,0,0,,Көрермендерге де ұнайды деп ойлаймын, солай ма?
Dialogue: 0,0:24:21.60,0:24:26.15,Default,,0,0,0,,Соққы реті №7-ден басталады ма?
Dialogue: 0,0:24:26.15,0:24:29.20,Default,,0,0,0,,Әзірге мен бірнеше жүгірушілерді жинап, Раиичиге жіберуім керек.
Dialogue: 0,0:24:29.20,0:24:34.13,Default,,0,0,0,,Барлығыңыз Райчиге жіберсеңіз, бірдеңе болады деп ойлайсыз, солай ма?
Dialogue: 0,0:24:34.13,0:24:39.68,Default,,0,0,0,,Мен бұл матчта жеңілемін деп ешқашан ойламадым.
Dialogue: 0,0:24:39.68,0:24:45.48,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:46.98,0:24:52.98,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory