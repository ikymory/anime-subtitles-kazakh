Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.28,0:00:35.38,Default,,0,0,0,,Әлі жоқ! Ол ұстаушының артына бұрылды!
Dialogue: 0,0:00:37.58,0:00:39.58,Default,,0,0,0,,Жүгіріп өт!
Dialogue: 0,0:00:41.98,0:00:44.59,Default,,0,0,0,,≪Қауіпсіз!
Dialogue: 0,0:00:44.59,0:00:48.09,Default,,0,0,0,,≪Уау! Бірінші жүгіруші келді!
Dialogue: 0,0:00:50.14,0:00:52.21,Default,,0,0,0,,Бұл жай ғана әткеншек.
Dialogue: 0,0:00:52.21,0:00:54.75,Default,,0,0,0,,《Эйджун: Мына дауыс кім?
Dialogue: 0,0:00:54.75,0:00:59.40,Default,,0,0,0,,Егер бұл дауыс болмаса... Мен оны дер кезінде орындамас едім.
Dialogue: 0,0:00:59.40,0:01:02.22,Default,,0,0,0,,Бұл жігіт сол жерде болды ма?
Dialogue: 0,0:01:02.22,0:01:04.22,Default,,0,0,0,,Мен байқамадым.
Dialogue: 0,0:03:48.20,0:03:50.61,Default,,0,0,0,,Кешіріңіз, жүгіруші жібергеніме менің кінәм болды.
Dialogue: 0,0:03:50.61,0:03:52.64,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:03:52.64,0:03:54.59,Default,,0,0,0,,Мен бір жылда бір ұпайды да орындамаймын.
Dialogue: 0,0:03:54.59,0:03:57.08,Default,,0,0,0,,Ал тағы бір жылда →
Dialogue: 0,0:03:57.08,0:04:00.40,Default,,0,0,0,,Ол сияқты рухы бар адам жоқ сияқты.
Dialogue: 0,0:04:00.40,0:04:04.20,Default,,0,0,0,,Вахахаха, жүгірейік!
Dialogue: 0,0:04:07.31,0:04:10.73,Default,,0,0,0,,Сасасаса….
Dialogue: 0,0:04:10.73,0:04:12.73,Default,,0,0,0,,Ой!
Dialogue: 0,0:04:14.76,0:04:19.20,Default,,0,0,0,,Хехе, олай етпе. Күтілгендей, тексеру добы да беделді спецификация болып табылады.
Dialogue: 0,0:04:19.20,0:04:21.25,Default,,0,0,0,,Өте жылдам!
Dialogue: 0,0:04:21.25,0:04:23.56,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:04:23.56,0:04:25.92,Default,,0,0,0,,Ku….
Dialogue: 0,0:04:25.92,0:04:29.98,Default,,0,0,0,,《Мен базаны ұрлауға тырысамын, бірақ мүмкіндік жоқ》
Dialogue: 0,0:04:29.98,0:04:32.20,Default,,0,0,0,,Хаха, бұл мүлдем жақсы емес.
Dialogue: 0,0:04:32.20,0:04:34.58,Default,,0,0,0,,Жүйрікті алға жылжытуға мүмкіндік жоқ →
Dialogue: 0,0:04:34.58,0:04:37.87,Default,,0,0,0,,Мен ұпай жинауға деген құштарлықты көре алмаймын.
Dialogue: 0,0:04:37.87,0:04:40.54,Default,,0,0,0,,Мұнда ештеңеге қол қоятын директор жоқ →
Dialogue: 0,0:04:40.54,0:04:43.63,Default,,0,0,0,,Сіз жаңа ғана ауыстырған құмырадан уақытты ала аласыз ба?
Dialogue: 0,0:04:43.63,0:04:46.13,Default,,0,0,0,,Қазір базаға кіруге кеш.
Dialogue: 0,0:04:49.20,0:04:52.45,Default,,0,0,0,,Ах, қатарынан екі сызу.
Dialogue: 0,0:04:52.45,0:04:54.45,Default,,0,0,0,,Осындай тамаша жүйрік болу босқа.
Dialogue: 0,0:04:56.37,0:04:59.91,Default,,0,0,0,,Кешіріңіз, енді менің кезегім емес →
Dialogue: 0,0:04:59.91,0:05:02.24,Default,,0,0,0,,Жаттығуды алдымен өз бетімнен бастай аламын ба?
Dialogue: 0,0:05:02.24,0:05:04.74,Default,,0,0,0,,Ей, біз әлі ойынның ортасындамыз!
Dialogue: 0,0:05:07.27,0:05:10.59,Default,,0,0,0,,Хмм директор, жақсысың ба?
Dialogue: 0,0:05:10.59,0:05:15.24,Default,,0,0,0,,Маған бәрібір, бәрібір ойын осы кезде бітті.
Dialogue: 0,0:05:15.24,0:05:17.38,Default,,0,0,0,,Жалғастырудың қажеті жоқ.
Dialogue: 0,0:05:17.38,0:05:22.28,Default,,0,0,0,,Амансың ба? Сен құбыжық. Мен оны соңына дейін көрмедім.
Dialogue: 0,0:05:22.28,0:05:24.58,Default,,0,0,0,,Бәрі бітті.
Dialogue: 0,0:05:24.58,0:05:27.59,Default,,0,0,0,,Берілме! Бейсбол екі шығудан басталады!
Dialogue: 0,0:05:27.59,0:05:31.41,Default,,0,0,0,,Команданы өз бетімен жеңіске жеткізуге жеткілікті→
Dialogue: 0,0:05:31.41,0:05:33.54,Default,,0,0,0,,Бейсбол оңай емес.
Dialogue: 0,0:05:33.54,0:05:35.74,Default,,0,0,0,,Қарғыс атсын, әлгі жігіт.
Dialogue: 0,0:05:35.74,0:05:39.41,Default,,0,0,0,,Егер мен бірінші командаға түсе алсам, ойын маңызды болмай ма?
Dialogue: 0,0:05:39.41,0:05:41.37,Default,,0,0,0,,Тіпті бізде осындай сәйкестік бар→
Dialogue: 0,0:05:41.37,0:05:45.09,Default,,0,0,0,,Осыны тез бітірулеріңізді қалаймын.
Dialogue: 0,0:05:45.09,0:05:49.04,Default,,0,0,0,,Балалар, мұнда не үшін келдіңдер?
Dialogue: 0,0:05:49.04,0:05:52.09,Default,,0,0,0,,Біз қалаған нәрсе - нәтиже.
Dialogue: 0,0:05:52.09,0:05:55.75,Default,,0,0,0,,Кіші мектептегі жетістіктің пайдасы жоқ →
Dialogue: 0,0:05:55.75,0:05:58.62,Default,,0,0,0,,Осыны түсінетін кез келген жоқ па?
Dialogue: 0,0:05:58.62,0:06:02.42,Default,,0,0,0,,А? Егер сіз мұны істегіңіз келмесе, мені өзгертіңіз.
Dialogue: 0,0:06:02.42,0:06:05.06,Default,,0,0,0,,Уф….
Dialogue: 0,0:06:05.06,0:06:08.93,Default,,0,0,0,,Кешіріңіз, мүшелерді ауыстырыңыз!
Dialogue: 0,0:06:08.93,0:06:11.08,Default,,0,0,0,,Мені шымшып ұр.
Dialogue: 0,0:06:11.08,0:06:13.08,Default,,0,0,0,,Сіз Фурутаға еліктейсіз бе?
Dialogue: 0,0:06:13.08,0:06:17.24,Default,,0,0,0,,Үйге орта жолда баратындар бар, рұқсатсыз шымшып ұратындар бар→
Dialogue: 0,0:06:17.24,0:06:19.71,Default,,0,0,0,,Биылғы жыл аласапыран болды.
Dialogue: 0,0:06:19.71,0:06:22.54,Default,,0,0,0,,Рұқсатсыз не істеп жатырсың? Оның үстіне, бұл→
Dialogue: 0,0:06:22.54,0:06:25.24,Default,,0,0,0,,Бұл ағаш жарғанат!
Dialogue: 0,0:06:25.24,0:06:28.38,Default,,0,0,0,,Тағы бір қызық нәрсе шықты.
Dialogue: 0,0:06:28.38,0:06:30.92,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:06:30.92,0:06:35.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:35.07,0:06:37.44,Default,,0,0,0,,≪белгі?
Dialogue: 0,0:06:37.44,0:06:40.41,Default,,0,0,0,,Олар оған қол қоюды қашан шешті?
Dialogue: 0,0:06:40.41,0:06:42.54,Default,,0,0,0,,《Олай болуы мүмкін емес.
Dialogue: 0,0:06:42.54,0:06:45.08,Default,,0,0,0,,Құмыра сәл болса да ұқса →
Dialogue: 0,0:06:45.08,0:06:47.45,Default,,0,0,0,,Бұл біздікі.》
Dialogue: 0,0:06:47.45,0:06:52.75,Default,,0,0,0,,Иә! ? Бұл не! Қандай белгі? Өтінемін, мені тыңдаңыз! Эй! !
Dialogue: 0,0:06:52.75,0:06:54.92,Default,,0,0,0,,《А... қираған...》
Dialogue: 0,0:06:54.92,0:06:58.31,Default,,0,0,0,,≪Ха ха ха! Сізге не керек еді? Сол жігіт.
Dialogue: 0,0:06:58.31,0:07:00.25,Default,,0,0,0,,≪Сәйкестендіріңіз! (күлкі)
Dialogue: 0,0:07:00.25,0:07:03.70,Default,,0,0,0,,《Хм, мен түзу баратын шығармын...》
Dialogue: 0,0:07:03.70,0:07:08.70,Default,,0,0,0,,Мен міндетті түрде үйге қайтамын! Екеуміз бір ұпай жинайық!
Dialogue: 0,0:07:08.70,0:07:12.57,Default,,0,0,0,,≪Кенеттен алынған ескерту? Бұл кім?
Dialogue: 0,0:07:12.57,0:07:16.71,Default,,0,0,0,,≪Сіз тым болашаққа ұмтыласыз. Ол да ақымақ па?
Dialogue: 0,0:07:16.71,0:07:19.05,Default,,0,0,0,,Хахаха... хахахаха!
Dialogue: 0,0:07:19.05,0:07:23.90,Default,,0,0,0,,≪Na! Үйге қайтайық? Оның дене бітімі алыс қашықтыққа шабатындай емес.
Dialogue: 0,0:07:23.90,0:07:27.92,Default,,0,0,0,,≪Егер сіз жарғанатты соншалықты қысқа ұстасаңыз, сіз курсқа жете алмайсыз.
Dialogue: 0,0:07:27.92,0:07:30.43,Default,,0,0,0,,Сіз кімсіз? Сол қыз... қабілет сынағы кезінде →
Dialogue: 0,0:07:30.43,0:07:34.71,Default,,0,0,0,,Бұл байқалды ма? (Рахмет) Йоко кіші орта мектебінен, Канагава префектурасынан →
Dialogue: 0,0:07:34.71,0:07:37.42,Default,,0,0,0,,Коминатохару қаласы.
Dialogue: 0,0:07:37.42,0:07:40.92,Default,,0,0,0,,《Не көздеп отырсың... Алдымен бір допты сыртқа жіберіп ал →
Dialogue: 0,0:07:40.92,0:07:42.92,Default,,0,0,0,,Күтейік, көрейік...》
Dialogue: 0,0:07:42.92,0:07:46.07,Default,,0,0,0,,Кіші орта мектептегі жалпы соққы көрсеткіші: 60%, 35%.
Dialogue: 0,0:07:46.07,0:07:49.54,Default,,0,0,0,,Не! 60%! ?
Dialogue: 0,0:07:49.54,0:07:52.34,Default,,0,0,0,,《Сіз жарғанақты тым ұзақ ұстадыңыз! 》
Dialogue: 0,0:07:55.08,0:07:58.65,Default,,0,0,0,,《Әзірше белгісіз қарсыласқа қарсы шығу.
Dialogue: 0,0:07:58.65,0:08:02.75,Default,,0,0,0,,Одан оңай көздейтін доп жоқ.》
Dialogue: 0,0:08:04.79,0:08:07.36,Default,,0,0,0,,《Сабақтан тыс бағытты мақсат ет! ? 》
Dialogue: 0,0:08:07.36,0:08:09.75,Default,,0,0,0,,≪Соңғы минутта жарық сызығы! Егер ол кірсе, бұл ұзақ хит болады! !
Dialogue: 0,0:08:09.75,0:08:12.22,Default,,0,0,0,,Әділ! 《Бұл жігіт→
Dialogue: 0,0:08:12.22,0:08:14.74,Default,,0,0,0,,Сіз допты соққанға дейін бастадыңыз! 》
Dialogue: 0,0:08:14.74,0:08:17.42,Default,,0,0,0,,Асығыңыз! Екінші базадағы жүгіруші бұрылды!
Dialogue: 0,0:08:17.42,0:08:20.78,Default,,0,0,0,,Жыл сайын кем дегенде бір ұпай жасай аласыз ба? !
Dialogue: 0,0:08:20.78,0:08:23.25,Default,,0,0,0,,≪Үшінші база да тепті!
Dialogue: 0,0:08:23.25,0:08:25.40,Default,,0,0,0,,≪Мен перронға асығамын! !
Dialogue: 0,0:08:25.40,0:08:27.37,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:08:27.37,0:08:30.42,Default,,0,0,0,,《Менің достарым маған тырысып, гол соғу керектігін айтты!
Dialogue: 0,0:08:30.42,0:08:33.36,Default,,0,0,0,,Міндетті түрде өзгертіңіз! ! 》
Dialogue: 0,0:08:33.36,0:08:35.44,Default,,0,0,0,,Бұл сұмдық! Оны уақытында жасамаңыз!
Dialogue: 0,0:08:35.44,0:08:39.44,Default,,0,0,0,,Мен сені үрлеймін! О! !
Dialogue: 0,0:08:45.22,0:08:47.25,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:08:47.25,0:08:49.86,Default,,0,0,0,,О, бірінші жыл ақыры бір ұпайды қайтарды!
Dialogue: 0,0:08:49.86,0:08:52.74,Default,,0,0,0,,Оны соққан ғажап болды, бірақ жүгірген жүйрік те керемет! !
Dialogue: 0,0:08:52.74,0:08:55.41,Default,,0,0,0,,Иә! !
Dialogue: 0,0:08:55.41,0:08:58.70,Default,,0,0,0,,Жарайсың! Әлгі бейбақ! !
Dialogue: 0,0:08:58.70,0:09:04.09,Default,,0,0,0,,Хаха хаа ха... Мен жасадым...
Dialogue: 0,0:09:04.09,0:09:06.74,Default,,0,0,0,,《Уақыт міндетті түрде аяқталды.
Dialogue: 0,0:09:06.74,0:09:08.86,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:09:08.86,0:09:12.91,Default,,0,0,0,,Оған қол тигізбек болған Митттен жалтарып, денесін күшпен бұрап жіберді→
Dialogue: 0,0:09:12.91,0:09:16.53,Default,,0,0,0,,Негізге жетті》
Dialogue: 0,0:09:16.53,0:09:18.75,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:09:18.75,0:09:21.20,Default,,0,0,0,,《Осындай күйден өз денеңді бұрап шығара аласың ба? ?
Dialogue: 0,0:09:21.20,0:09:24.41,Default,,0,0,0,,Егер шатассаң, иығың мен белің ауырады.
Dialogue: 0,0:09:24.41,0:09:29.58,Default,,0,0,0,,Хаха... Ол шынымен де перронға қайтып кетті.
Dialogue: 0,0:09:29.58,0:09:32.43,Default,,0,0,0,,Мен 1 ұпай алдым! Ойын осы жерден басталады.
Dialogue: 0,0:09:32.43,0:09:34.53,Default,,0,0,0,,Уа, ау...
Dialogue: 0,0:09:34.53,0:09:37.03,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:09:40.59,0:09:42.91,Default,,0,0,0,,Режиссер Шынында да осы эпизодта→
Dialogue: 0,0:09:42.91,0:09:45.26,Default,,0,0,0,,Сіз матчты аяқтағыңыз келе ме?
Dialogue: 0,0:09:45.26,0:09:47.33,Default,,0,0,0,,Жалғастыруға рұқсат етіңіз!
Dialogue: 0,0:09:47.33,0:09:51.75,Default,,0,0,0,,Мен бірінші курсымды ұпаймен аяқтай алмаймын!
Dialogue: 0,0:09:51.75,0:09:54.37,Default,,0,0,0,,Екі топ қатарға тұрады!
Dialogue: 0,0:09:54.37,0:09:57.79,Default,,0,0,0,,Не? Немесе директор...
Dialogue: 0,0:09:57.79,0:10:01.08,Default,,0,0,0,,Міне. Мен мұны жалғастырсам да →
Dialogue: 0,0:10:01.08,0:10:03.30,Default,,0,0,0,,Нүктелік айырмашылық тек қана кеңейеді.
Dialogue: 0,0:10:03.30,0:10:05.30,Default,,0,0,0,,Не!
Dialogue: 0,0:10:10.09,0:10:12.09,Default,,0,0,0,,《Бұзақ…》
Dialogue: 0,0:10:14.44,0:10:16.54,Default,,0,0,0,,Дегенмен→
Dialogue: 0,0:10:16.54,0:10:19.48,Default,,0,0,0,,Бұл ойынды барлығы бір жыл бойы жалғастырғысы келсе→
Dialogue: 0,0:10:19.48,0:10:23.08,Default,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:10:25.27,0:10:27.37,Default,,0,0,0,,Ей! Естисің бе!? Польнареф!?
Dialogue: 0,0:10:30.42,0:10:34.79,Default,,0,0,0,,Не! Осылай аяқталуы мүмкін бе? ?
Dialogue: 0,0:10:34.79,0:10:38.45,Default,,0,0,0,,Мұндай мүмкіндіктің қашан келетінін ешқашан білмейсіз!
Dialogue: 0,0:10:38.45,0:10:42.75,Default,,0,0,0,,Бар күшіңді жұмсадым деп мақтанышпен айта алмайсың ба?
Dialogue: 0,0:10:45.22,0:10:47.29,Default,,0,0,0,,Шулы...
Dialogue: 0,0:10:47.29,0:10:50.09,Default,,0,0,0,,Әткеншектеп, қаша жөнелген жігіттің бастық болғаны ғой!
Dialogue: 0,0:10:52.06,0:10:56.08,Default,,0,0,0,,Дұрыс...Теме толқығандықтан ұпай айырмасы кеңейді.
Dialogue: 0,0:10:56.08,0:10:58.58,Default,,0,0,0,,Біз тек таңданамыз →
Dialogue: 0,0:10:58.58,0:11:01.20,Default,,0,0,0,,Біз бұл бейсбол клубына жиналмадық!
Dialogue: 0,0:11:01.20,0:11:03.24,Default,,0,0,0,,Көңілсіз қалдым!
Dialogue: 0,0:11:03.24,0:11:06.89,Default,,0,0,0,,Неліктен Теме біраз уақыт бұрын басшылық етті?
Dialogue: 0,0:11:06.89,0:11:09.74,Default,,0,0,0,,Мен сенен басқа ештеңені жоғалтқым келмейді!
Dialogue: 0,0:11:09.74,0:11:13.30,Default,,0,0,0,,Күні кешеге дейін шәкірт болған жігіт капитан болмасын!
Dialogue: 0,0:11:13.30,0:11:15.37,Default,,0,0,0,,Жоқ! ?
Dialogue: 0,0:11:15.37,0:11:17.70,Default,,0,0,0,,Әлде сен мені жек көресің бе?
Dialogue: 0,0:11:17.70,0:11:22.37,Default,,0,0,0,,Бұл адамдарда мақтаныш бар.
Dialogue: 0,0:11:22.37,0:11:26.26,Default,,0,0,0,,Хахаха... Әлі де күшті боласың ғой, солай ма? Бір жыл болды.
Dialogue: 0,0:11:26.26,0:11:29.41,Default,,0,0,0,,Жалғастыруға рұқсат етіңіз директор, өтінемін!
Dialogue: 0,0:11:29.41,0:11:31.88,Default,,0,0,0,,Өтінемін, директор! өтінемін!
Dialogue: 0,0:11:31.88,0:11:34.24,Default,,0,0,0,,Маған жалғастыруға рұқсат етіңіз! өтінемін!
Dialogue: 0,0:11:34.24,0:11:38.12,Default,,0,0,0,,Неге сенде әуелден сонша рух болды→
Dialogue: 0,0:11:38.12,0:11:42.72,Default,,0,0,0,,Жерде тұруға болмайды. Келесі орта мектепте бейсбол болмайды.
Dialogue: 0,0:11:47.92,0:11:50.05,Default,,0,0,0,,Бала.
Dialogue: 0,0:11:50.05,0:11:54.44,Default,,0,0,0,,Осы уақыттан бастап сіз құмырасыз. Қазір қорғанға барыңыз.
Dialogue: 0,0:11:54.44,0:11:57.91,Default,,0,0,0,,Не? Бірінші курс құмыра бәрін сынап көрді.
Dialogue: 0,0:11:57.91,0:12:01.30,Default,,0,0,0,,Егер ойынды жалғастырғың келсе, лақтыру керек.
Dialogue: 0,0:12:01.30,0:12:03.58,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:12:03.58,0:12:06.23,Default,,0,0,0,,Қандай формада болса да, жауынгерлік рухсыз жыл→
Dialogue: 0,0:12:06.23,0:12:08.59,Default,,0,0,0,,Маған түрткі болған адам Савамура болды.
Dialogue: 0,0:12:08.59,0:12:11.62,Default,,0,0,0,,Сіз мүмкіндікке лайықсыз.
Dialogue: 0,0:12:11.62,0:12:15.53,Default,,0,0,0,,Директор да жәй жын емес.
Dialogue: 0,0:12:15.53,0:12:18.25,Default,,0,0,0,,Әй, әй, бұл не!
Dialogue: 0,0:12:18.25,0:12:21.62,Default,,0,0,0,,Сәлем! 1-курстағы қарсыласқа қарсы бұл ойын қандай?
Dialogue: 0,0:12:21.62,0:12:23.54,Default,,0,0,0,,200 ұпай алғыңыз келе ме?
Dialogue: 0,0:12:23.54,0:12:26.25,Default,,0,0,0,,Хяхаха! Маусым: 200 ұпай мүмкін емес.
Dialogue: 0,0:12:26.25,0:12:29.87,Default,,0,0,0,,Бұл өте ұят матч. Бұл аянышты.
Dialogue: 0,0:12:29.87,0:12:32.24,Default,,0,0,0,,Мені ауыстырыңыз! Мен шығамын!
Dialogue: 0,0:12:32.24,0:12:37.22,Default,,0,0,0,,Джун-сан, бұл ақылға сыйымсыз. Көп салмақ түсіргеннен кейін.
Dialogue: 0,0:12:37.22,0:12:41.60,Default,,0,0,0,,《Бұл адамдар өшіп тұрса да қозғалды ма? 》
Dialogue: 0,0:12:41.60,0:12:43.64,Default,,0,0,0,,Тыныш және бақылаңыз, маусым.
Dialogue: 0,0:12:43.64,0:12:48.26,Default,,0,0,0,,Міне, сіз сүйетін Азума мырзаны ұрып-соққан адам.
Dialogue: 0,0:12:48.26,0:12:50.30,Default,,0,0,0,,Сіз оны көрмедіңіз.
Dialogue: 0,0:12:50.30,0:12:52.60,Default,,0,0,0,,Не? Әлгі жігіт!
Dialogue: 0,0:12:56.55,0:13:00.55,Default,,0,0,0,,《Ой... мен сол қорғандамын...》
Dialogue: 0,0:13:06.26,0:13:09.90,Default,,0,0,0,,Соңында, Такашима мырзаның сүйікті →
Dialogue: 0,0:13:09.90,0:13:12.50,Default,,0,0,0,,Қорғанды ​​аласың ба?
Dialogue: 0,0:13:17.94,0:13:22.24,Default,,0,0,0,,《Мына жігіттер үнемі қарап тұрады.
Dialogue: 0,0:13:22.24,0:13:26.84,Default,,0,0,0,,Сіз тым қиын нәрсеге ешқашан еліктей алмайсыз.
Dialogue: 0,0:13:29.27,0:13:31.27,Default,,0,0,0,,《Кеттік, бәріміз! 》
Dialogue: 0,0:15:03.24,0:15:05.23,Default,,0,0,0,,Әй, сіз дауыстың қандай түрін айтасыз?
Dialogue: 0,0:15:05.23,0:15:07.62,Default,,0,0,0,,Ол сондай үлкен болды.
Dialogue: 0,0:15:07.62,0:15:10.89,Default,,0,0,0,,Егер сен жарты жолда ойнасаң, мен сені кешірмеймін.
Dialogue: 0,0:15:10.89,0:15:13.57,Default,,0,0,0,,Хехе... Уайымдама.
Dialogue: 0,0:15:13.57,0:15:17.98,Default,,0,0,0,,Мен жүгіре алмаймын немесе жасыра алмаймын! Жер шарының дәл ортасында!
Dialogue: 0,0:15:17.98,0:15:19.86,Default,,0,0,0,,Не! ?
Dialogue: 0,0:15:19.86,0:15:21.91,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын, қалғаны үшін рахмет!
Dialogue: 0,0:15:21.91,0:15:23.90,Default,,0,0,0,,Да-ха-ха!
Dialogue: 0,0:15:23.90,0:15:26.90,Default,,0,0,0,,А... мына жігіт, анау...
Dialogue: 0,0:15:26.90,0:15:30.57,Default,,0,0,0,,Сен ақымақсың ба? (Канамару) Бұл ақымақтық.
Dialogue: 0,0:15:30.57,0:15:34.24,Default,,0,0,0,,Ойна! Хехе.
Dialogue: 0,0:15:34.24,0:15:36.88,Default,,0,0,0,,《Сіз қатты жиналыс жасап жатырсыз.
Dialogue: 0,0:15:36.88,0:15:39.31,Default,,0,0,0,,Бүкіл жер шарының ортасында?
Dialogue: 0,0:15:39.31,0:15:42.61,Default,,0,0,0,,Егер бұл блеф болмаса, сіз жындысыз.
Dialogue: 0,0:15:46.22,0:15:49.57,Default,,0,0,0,,Ах! ? Не... Доман...
Dialogue: 0,0:15:49.57,0:15:51.89,Default,,0,0,0,,Оны жалама!
Dialogue: 0,0:15:51.89,0:15:53.88,Default,,0,0,0,,≪Кенеттен үйге жүгіру! ?
Dialogue: 0,0:15:53.88,0:15:55.91,Default,,0,0,0,,Әрине!
Dialogue: 0,0:15:55.91,0:15:59.87,Default,,0,0,0,,Мұндай жылдамдық үш жылға созылуы мүмкін емес ...
Dialogue: 0,0:15:59.87,0:16:01.90,Default,,0,0,0,,Не! ?
Dialogue: 0,0:16:01.90,0:16:04.22,Default,,0,0,0,,Сәлем! Жақсы қалды!
Dialogue: 0,0:16:04.22,0:16:08.24,Default,,0,0,0,,Хаха, мен қатты қорғадым. Маған қорғаныс жағы көмектесті.
Dialogue: 0,0:16:08.24,0:16:11.25,Default,,0,0,0,,Осымен, оның соғылуы тек уақыт мәселесі.
Dialogue: 0,0:16:11.25,0:16:14.23,Default,,0,0,0,,3 жылдан кейін жинап алсаңыз, дәл солай түзу болады.
Dialogue: 0,0:16:14.23,0:16:17.54,Default,,0,0,0,,《Аа... Тура соғылатын болды.
Dialogue: 0,0:16:17.54,0:16:20.26,Default,,0,0,0,,Бұл жігіттің доптық қасиетін байқамасаңыз →
Dialogue: 0,0:16:20.26,0:16:23.26,Default,,0,0,0,,Сіз ауырсынуды көресіз, солай ма? 》
Dialogue: 0,0:16:25.24,0:16:27.25,Default,,0,0,0,,Жақсы үшінші!
Dialogue: 0,0:16:27.25,0:16:29.73,Default,,0,0,0,,О~ Бұл қолғапта.
Dialogue: 0,0:16:29.73,0:16:32.08,Default,,0,0,0,,Керемет. Бар болғаны екі қадаммен екі шығу.
Dialogue: 0,0:16:32.08,0:16:34.05,Default,,0,0,0,,Бұл қосулы!
Dialogue: 0,0:16:34.05,0:16:36.05,Default,,0,0,0,,Бір жылдық монах...
Dialogue: 0,0:16:38.09,0:16:41.58,Default,,0,0,0,,《Оқиға үш рет өтпейді.》
Dialogue: 0,0:16:41.58,0:16:44.28,Default,,0,0,0,,Не…?
Dialogue: 0,0:16:44.28,0:16:47.08,Default,,0,0,0,,≪Мен кептеліп қалдым! ≪Бірақ жақсы жер болып шықты! !
Dialogue: 0,0:16:50.39,0:16:52.69,Default,,0,0,0,,Екінші мен оны ұстадым!
Dialogue: 0,0:16:57.58,0:16:59.54,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:16:59.54,0:17:03.03,Default,,0,0,0,,Уау, мен қазір өзімді қысып тұрғандай сезінемін.
Dialogue: 0,0:17:03.03,0:17:06.12,Default,,0,0,0,,Жақсы секунд! Жақсы секунд!
Dialogue: 0,0:17:06.12,0:17:08.72,Default,,0,0,0,,Екіншісін орындайық.
Dialogue: 0,0:17:11.04,0:17:13.07,Default,,0,0,0,,Біз оны 0 ұпайға дейін сақтадық! !
Dialogue: 0,0:17:13.07,0:17:15.08,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:17:15.08,0:17:17.08,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:17:17.08,0:17:19.05,Default,,0,0,0,,Бір жыл бойы жақсарған соң не істейсіз?
Dialogue: 0,0:17:19.05,0:17:21.03,Default,,0,0,0,,Нашар….
Dialogue: 0,0:17:21.03,0:17:24.25,Default,,0,0,0,,《Мен атудан өтіп кеткендей емеспін. Мен оны тамаша түсіруім керек еді...→
Dialogue: 0,0:17:24.25,0:17:26.25,Default,,0,0,0,,Бұл не доп...?
Dialogue: 0,0:17:29.24,0:17:32.41,Default,,0,0,0,,Қамыршының қолында өзгеретін қозғалыстағы доп па?
Dialogue: 0,0:17:32.41,0:17:34.41,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:17:34.41,0:17:37.25,Default,,0,0,0,,《Тэцу-сан күткендей, байқадың ба...》
Dialogue: 0,0:17:37.25,0:17:40.74,Default,,0,0,0,,Бұл доп әлі жабайы болып жатыр.
Dialogue: 0,0:17:40.74,0:17:42.75,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:17:42.75,0:17:45.74,Default,,0,0,0,,Сәлем! Ойын әлі аяқталған жоқ!
Dialogue: 0,0:17:45.74,0:17:47.78,Default,,0,0,0,,Алдымен, негізге алайық!
Dialogue: 0,0:17:47.78,0:17:49.91,Default,,0,0,0,,Сондықтан сіз басшылық етпеуіңіз керек!
Dialogue: 0,0:17:49.91,0:17:53.05,Default,,0,0,0,,Хахаха дауысым енді шыға бастады. Бір жыл болды.
Dialogue: 0,0:17:53.05,0:17:56.75,Default,,0,0,0,,Қорғаныс жақсы ойнаса, бүкіл команданың көңілі көтеріледі.
Dialogue: 0,0:17:56.75,0:17:59.09,Default,,0,0,0,,Басынан басқа команда сияқты.
Dialogue: 0,0:17:59.09,0:18:01.91,Default,,0,0,0,,Бұл құмыра Савамура-кун болды ма?
Dialogue: 0,0:18:01.91,0:18:04.41,Default,,0,0,0,,Оның құмарлығы өте жақсы.
Dialogue: 0,0:18:04.41,0:18:09.75,Default,,0,0,0,,Иә, бірақ бұл менің назарымды аударған жалғыз нәрсе емес.
Dialogue: 0,0:18:09.75,0:18:11.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:13.75,0:18:17.56,Default,,0,0,0,,Мен жасөспірімдер арасындағы жергілікті турнирге кездейсоқ бардым...→
Dialogue: 0,0:18:17.56,0:18:23.76,Default,,0,0,0,,Шынымды айтсам, ол оқыған орта мектеп өнерпаздардан құралған команда болатын.
Dialogue: 0,0:18:23.76,0:18:28.90,Default,,0,0,0,,Ұстаушының түсірген допы... Маңызды жағдайдағы досының қателігі...→
Dialogue: 0,0:18:28.90,0:18:34.04,Default,,0,0,0,,Кәдімгі құмыра ойыннан баяғыда бас тартуына себеп болатын шымшулар қатары.
Dialogue: 0,0:18:34.04,0:18:37.89,Default,,0,0,0,,Дегенмен, өз одақтастарының қателіктеріне алаңдамай→
Dialogue: 0,0:18:37.89,0:18:42.23,Default,,0,0,0,,Оның табанды ойыны команданы алға жетелейді→
Dialogue: 0,0:18:42.23,0:18:44.83,Default,,0,0,0,,Мен нағыз эйсті көргендей сезінемін.
Dialogue: 0,0:18:46.92,0:18:48.87,Default,,0,0,0,,Маған бір соққы беріңізші! !
Dialogue: 0,0:18:48.87,0:18:50.86,Default,,0,0,0,,Сіз оны міндетті түрде жеңе аласыз!
Dialogue: 0,0:18:50.86,0:18:52.89,Default,,0,0,0,,Қатты шабуыл жасайық! !
Dialogue: 0,0:18:52.89,0:18:55.53,Default,,0,0,0,,<< Барынша қатты шайқаңыз! !
Dialogue: 0,0:18:55.53,0:18:58.08,Default,,0,0,0,,((Фуруя: Өте жаман...
Dialogue: 0,0:18:58.08,0:19:01.55,Default,,0,0,0,,Мен сенің допыңды тоқтата алмаймын.
Dialogue: 0,0:19:01.55,0:19:03.53,Default,,0,0,0,,Бұл құбыжық, солай ма?
Dialogue: 0,0:19:03.53,0:19:07.39,Default,,0,0,0,,Ей, ол бізден нені қалайды?
Dialogue: 0,0:19:07.39,0:19:09.57,Default,,0,0,0,,Кешіріңіз Фуруя...
Dialogue: 0,0:19:09.57,0:19:13.28,Default,,0,0,0,,Менің жоғары сынып оқушыларым сенімен бейсбол ойнағысы келмейді...→
Dialogue: 0,0:19:13.28,0:19:15.38,Default,,0,0,0,,Кешіріңіз...))
Dialogue: 0,0:19:19.72,0:19:22.09,Default,,0,0,0,,Шығар! ≪Ұят.
Dialogue: 0,0:19:22.09,0:19:24.54,Default,,0,0,0,,Жарайды, мен соға бастадым.
Dialogue: 0,0:19:24.54,0:19:26.79,Default,,0,0,0,,Бұл мүлде жұмыс істемейді.
Dialogue: 0,0:19:26.79,0:19:29.79,Default,,0,0,0,,Мен оны бұл жолы да жақсы ұстаймын. (1-сынып) О!
Dialogue: 0,0:19:37.80,0:19:39.72,Default,,0,0,0,,((Курамочи: Бұл адам кеше қате жіберді→
Dialogue: 0,0:19:39.72,0:19:43.74,Default,,0,0,0,,Әңгімелесу Мен бұған тыйым саламын.
Dialogue: 0,0:19:43.74,0:19:49.58,Default,,0,0,0,,Мен бір ғана қате жібергеннен кейін әдеттегі тізімнен шығарылдым))
Dialogue: 0,0:19:49.58,0:19:53.58,Default,,0,0,0,,《Масуко Сенпай》
Dialogue: 0,0:19:53.58,0:19:57.07,Default,,0,0,0,,Савамура-чан.
Dialogue: 0,0:19:57.07,0:20:01.09,Default,,0,0,0,,Мен міндетті түрде әдеттегідей қайтамын.
Dialogue: 0,0:20:01.09,0:20:03.73,Default,,0,0,0,,Бар күшіңізбен келіңіз!
Dialogue: 0,0:20:03.73,0:20:05.71,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,0:20:05.71,0:20:08.58,Default,,0,0,0,,Хяхаха~ Қандай қызық! Бөлменің көрсетілімі?
Dialogue: 0,0:20:08.58,0:20:11.44,Default,,0,0,0,,Масуко-санның осы уақытқа дейінгі өнері туралы не ойлайсыз?
Dialogue: 0,0:20:11.44,0:20:14.71,Default,,0,0,0,,Ол керемет жұмыс істейді, 3 хит және 6 RBI→
Dialogue: 0,0:20:14.71,0:20:18.11,Default,,0,0,0,,Ол бірінші командаға көтерілуге толық ынталы.
Dialogue: 0,0:20:18.11,0:20:21.88,Default,,0,0,0,,Мүмкін ол адам Савамураның доп сапасын білетін шығар.
Dialogue: 0,0:20:21.88,0:20:25.88,Default,,0,0,0,,Осы матчта Савамураның қабілетін көресіз.
Dialogue: 0,0:20:29.07,0:20:33.74,Default,,0,0,0,,《Уау... Бұл жігіт бүгін қатты соғып жатыр.
Dialogue: 0,0:20:33.74,0:20:37.41,Default,,0,0,0,,Күтілгендей, дәл ортасында болу нәтиже бермейді.
Dialogue: 0,0:20:37.41,0:20:39.55,Default,,0,0,0,,Күтіңіз, күтіңіз, күтіңіз!
Dialogue: 0,0:20:39.55,0:20:42.08,Default,,0,0,0,,Жоқ, бұл кісі де! ? 》
Dialogue: 0,0:20:42.08,0:20:45.97,Default,,0,0,0,,Хахахаха... Тек тікелей бәсекелестік бар!
Dialogue: 0,0:20:45.97,0:20:48.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:52.21,0:20:56.66,Default,,0,0,0,,Ортадағы тік ұстағыш соқты ма?
Dialogue: 0,0:20:56.66,0:20:59.28,Default,,0,0,0,,Нашар.
Dialogue: 0,0:20:59.28,0:21:03.08,Default,,0,0,0,,《Ол не деген доп? Доп менің қолымда қозғалып бара жатқандай болды.
Dialogue: 0,0:21:05.04,0:21:09.54,Default,,0,0,0,,Хмм.
Dialogue: 0,0:21:09.54,0:21:13.58,Default,,0,0,0,,Таяқшаны қысқа және қамыр қорабының алдыңғы жағында ұстаңыз ба?
Dialogue: 0,0:21:13.58,0:21:16.22,Default,,0,0,0,,(Норияки) Онда Үндістанмен қоштасу уақыты келді
Dialogue: 0,0:21:16.22,0:21:20.87,Default,,0,0,0,,《Күткендей, Масуко-сенпай, сіз Савамураның дыбыс деңгейінің сапасын білесіз.
Dialogue: 0,0:21:20.87,0:21:22.92,Default,,0,0,0,,Әткеншекті ықшамдаңыз→
Dialogue: 0,0:21:22.92,0:21:26.92,Default,,0,0,0,,Доп қозғалмай тұрып, допты соғу стратегиясы ма?
Dialogue: 0,0:21:29.41,0:21:31.73,Default,,0,0,0,,《Hehe….
Dialogue: 0,0:21:31.73,0:21:35.29,Default,,0,0,0,,Бұл шиеленіс.
Dialogue: 0,0:21:35.29,0:21:37.89,Default,,0,0,0,,Кешіріңіз》
Dialogue: 0,0:21:39.89,0:21:42.86,Default,,0,0,0,,Бұзушылық!
Dialogue: 0,0:21:42.86,0:21:47.25,Default,,0,0,0,,Бұрынғы №5 күткендей, сен интернетті құртпақшысың ба, анау бейбақ?
Dialogue: 0,0:21:47.25,0:21:50.60,Default,,0,0,0,,Таяқшаны қысқа ұстау маңызды емес.
Dialogue: 0,0:21:50.60,0:21:52.70,Default,,0,0,0,,Фу.
Dialogue: 0,0:21:52.70,0:21:54.96,Default,,0,0,0,,《Енді не істеуіміз керек, Савамура?
Dialogue: 0,0:21:54.96,0:21:58.96,Default,,0,0,0,,Бұл мені төмен деп сынауға келген Азума-саннан бөлек.
Dialogue: 0,0:22:01.88,0:22:05.08,Default,,0,0,0,,《Осы қателіктен бері үш апта.
Dialogue: 0,0:22:05.08,0:22:08.54,Default,,0,0,0,,Мен өзімді ешқашан мұндай ақымақ сезінген емеспін.
Dialogue: 0,0:22:08.54,0:22:10.59,Default,,0,0,0,,((Бұл не пьеса?
Dialogue: 0,0:22:10.59,0:22:13.89,Default,,0,0,0,,Сіз алаңға шығып жатқанда соғу туралы ойладыңыз.
Dialogue: 0,0:22:13.89,0:22:15.88,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:22:15.88,0:22:17.90,Default,,0,0,0,,Жарғанаттың жанында әрқашан бір адам болады.
Dialogue: 0,0:22:17.90,0:22:21.53,Default,,0,0,0,,Бірақ қорғанысты тоғыз адам қорғай алады!
Dialogue: 0,0:22:21.53,0:22:26.24,Default,,0,0,0,,Өзіңіздің ұсақ сезімдеріңізбен ұжымға қиындық туғызбаңыз.
Dialogue: 0,0:22:26.24,0:22:29.91,Default,,0,0,0,,Екінші әскермен басыңды суыт))
Dialogue: 0,0:22:29.91,0:22:32.71,Default,,0,0,0,,《Бір қатені қайталама》
Dialogue: 0,0:22:34.95,0:22:38.75,Default,,0,0,0,,《Тек осы сәтте барынша тырысыңыз! 》
Dialogue: 0,0:22:47.38,0:22:49.69,Default,,0,0,0,,《Доп жоқ, екі соққы!
Dialogue: 0,0:22:49.69,0:22:52.26,Default,,0,0,0,,Санақта артықшылығымыз бар.
Dialogue: 0,0:22:52.26,0:22:54.26,Default,,0,0,0,,Теория бойынша мен бір допты өткізіп алдым...》
Dialogue: 0,0:22:58.44,0:23:00.54,Default,,0,0,0,,《Тағы кездескенше~! 》
Dialogue: 0,0:23:00.54,0:23:03.29,Default,,0,0,0,,Бұл жерден қашсаң Эйс бола алмайсың!
Dialogue: 0,0:23:03.29,0:23:06.39,Default,,0,0,0,,《Мен енді білмеймін! Оны қалауыңызша сындырыңыз! 》
Dialogue: 0,0:23:09.90,0:23:11.87,Default,,0,0,0,,《Есте сақта.
Dialogue: 0,0:23:11.87,0:23:14.09,Default,,0,0,0,,Сол кездегі сезім!
Dialogue: 0,0:23:14.09,0:23:16.95,Default,,0,0,0,,Мына қолғаптарды есте сақта! 》
Dialogue: 0,0:23:16.95,0:23:19.02,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:23:19.02,0:23:21.02,Default,,0,0,0,,《Кеттік! 》
Dialogue: 0,0:23:34.41,0:23:37.34,Default,,0,0,0,,Бұл бар! (қуаныш)
Dialogue: 0,0:23:37.34,0:23:39.69,Default,,0,0,0,,Үйге жүгіру! Қазір жалықтысың ба?
Dialogue: 0,0:23:39.69,0:23:42.36,Default,,0,0,0,,А, сен оны күштеп алып кеттің!
Dialogue: 0,0:23:42.36,0:23:44.75,Default,,0,0,0,,《Егер ұпайлар сәл төмендесе →
Dialogue: 0,0:23:44.75,0:23:49.04,Default,,0,0,0,,Таяқ жеген мен болдым.
Dialogue: 0,0:23:49.04,0:23:53.99,Default,,0,0,0,,Бұл жақсы доп болды, Савамура-чан.
Dialogue: 0,0:23:53.99,0:23:56.38,Default,,0,0,0,,Сізде толық қуат жоқ.
Dialogue: 0,0:23:56.38,0:24:00.40,Default,,0,0,0,,Бұл құмыраны да зақымдаған болуы керек.
Dialogue: 0,0:24:00.40,0:24:04.82,Default,,0,0,0,,《Тамаша соқты.
Dialogue: 0,0:24:04.82,0:24:08.42,Default,,0,0,0,,Мен оған қолымдағының бәрін лақтырған жеңген доп.
Dialogue: 0,0:24:08.42,0:24:13.24,Default,,0,0,0,,Бұл күш пен күштің шайқасы.
Dialogue: 0,0:24:13.24,0:24:18.04,Default,,0,0,0,,Бұл елдегі жоғары сыныптағы орта мектеп бейсболы! 》
Dialogue: 0,0:24:20.05,0:24:22.35,Default,,0,0,0,,《Хаха, керемет...》
Dialogue: 0,0:24:25.59,0:24:28.06,Default,,0,0,0,,《Мен көбірек лақтырғым келеді!
Dialogue: 0,0:24:28.06,0:24:30.66,Default,,0,0,0,,Барған сайын! 》
Dialogue: 0,0:24:33.13,0:24:35.13,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:24:37.39,0:24:40.77,Default,,0,0,0,,Әлгі бала күліп тұр.
Dialogue: 0,0:24:40.77,0:24:45.71,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:45.71,0:24:48.91,Default,,0,0,0,,Шаа! Мен өзімді қалпына келтіремін!
Dialogue: 0,0:24:48.91,0:24:51.88,Default,,0,0,0,,Ол мүлдем жауап бермейді!
Dialogue: 0,0:24:51.88,0:24:54.59,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:24:54.59,0:24:57.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:57.07,0:25:00.24,Default,,0,0,0,,Әрине, бұл бетпе-бет шайқас!
Dialogue: 0,0:25:00.24,0:25:02.61,Default,,0,0,0,,Уау, мен мұны білдім!
Dialogue: 0,0:25:02.61,0:25:06.41,Default,,0,0,0,,《Соққаннан кейін де көздерің жарқырап тұрады...
Dialogue: 0,0:25:06.41,0:25:11.21,Default,,0,0,0,,Бейсболды жаңа ғана үйренген бала сияқты.
Dialogue: 0,0:25:12.71,0:25:18.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory