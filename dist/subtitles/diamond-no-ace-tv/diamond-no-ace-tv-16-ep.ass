Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.83,0:00:38.83,Default,,0,0,0,,Не болды? Бәрі бітті ме, Юки?
Dialogue: 0,0:00:41.87,0:00:43.87,Default,,0,0,0,,Бір доп….
Dialogue: 0,0:00:53.78,0:00:59.24,Default,,0,0,0,,Тағы бір доп беріңізші.
Dialogue: 0,0:00:59.24,0:01:01.84,Default,,0,0,0,,Бақылау.
Dialogue: 0,0:01:08.81,0:01:11.81,Default,,0,0,0,,Ура~!
Dialogue: 0,0:01:14.47,0:01:18.09,Default,,0,0,0,,《Эйджун: Керемет... Ертеңгі сол адамдарға》
Dialogue: 0,0:01:18.09,0:01:21.14,Default,,0,0,0,,《Фуруя: маған арқамды қорғауың керек》
Dialogue: 0,0:01:21.14,0:01:23.51,Default,,0,0,0,,Қазір де дірілдеп тұрсыз ба?
Dialogue: 0,0:01:23.51,0:01:28.43,Default,,0,0,0,,Билігі жоқтардың әрекеттен басқа амалы жоқ.
Dialogue: 0,0:01:28.43,0:01:31.49,Default,,0,0,0,,((Рйосуке: Бұл жер сіз ойлағаннан да көп →
Dialogue: 0,0:01:31.49,0:01:34.14,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:01:34.14,0:01:37.74,Default,,0,0,0,,Сізді ауыстырғысы келетіндер көп))
Dialogue: 0,0:01:41.48,0:01:44.83,Default,,0,0,0,,Мм... мен де шайқасам болады ма?
Dialogue: 0,0:01:44.83,0:01:47.15,Default,,0,0,0,,Иә? Сен ақымақсың ба?
Dialogue: 0,0:01:47.15,0:01:49.50,Default,,0,0,0,,Сізге көп күш салудың қажеті жоқ!
Dialogue: 0,0:01:49.50,0:01:52.54,Default,,0,0,0,,Өтінемін. (Маэзоно) Сондықтан тым мотивация бермеңіз!
Dialogue: 0,0:01:52.54,0:01:55.14,Default,,0,0,0,,Уау, ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:01:55.14,0:01:57.11,Default,,0,0,0,,Менің әткеншегіме сүйсінсеңіз болғаны.
Dialogue: 0,0:01:57.11,0:01:59.48,Default,,0,0,0,,Оның үстіне ертең матч болады.
Dialogue: 0,0:01:59.48,0:02:01.45,Default,,0,0,0,,Бәрібір менің кезегім емес.
Dialogue: 0,0:02:01.45,0:02:03.45,Default,,0,0,0,,Идиот! Соншалықты әлсіз болма!
Dialogue: 0,0:04:50.44,0:04:54.14,Default,,0,0,0,,Директор Мацумото, бүгін келгеніңізге көп рахмет→
Dialogue: 0,0:04:54.14,0:04:56.14,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:04:56.14,0:04:59.11,Default,,0,0,0,,Жаз жақындап қалды, ендеше жақсы матч жасайық.
Dialogue: 0,0:04:59.11,0:05:01.81,Default,,0,0,0,,Иә, сәйкестік пе?
Dialogue: 0,0:05:01.81,0:05:05.47,Default,,0,0,0,,Оның орнына, бастапқы позиция бір жылға арналған ба?
Dialogue: 0,0:05:05.47,0:05:08.84,Default,,0,0,0,,Жазға дейін түзетулер болатын шығар→
Dialogue: 0,0:05:08.84,0:05:11.47,Default,,0,0,0,,Сіз әртүрлі нәрселерді көргіңіз келетінін түсінемін.
Dialogue: 0,0:05:11.47,0:05:16.51,Default,,0,0,0,,Бірақ мен Кирюге бірінші курс студентін тастаймын деп ойламаймын...
Dialogue: 0,0:05:16.51,0:05:20.18,Default,,0,0,0,,Менің ойымша, ол болашағы зор құмыра.
Dialogue: 0,0:05:20.18,0:05:26.18,Default,,0,0,0,,Немесе сол аймақтағы бірде-бір орта мектеп білмейтін құпия қару болуы мүмкін бе?
Dialogue: 0,0:05:30.46,0:05:36.18,Default,,0,0,0,,Қалай болғанда да, бұл маған да ұнайды.
Dialogue: 0,0:05:36.18,0:05:39.18,Default,,0,0,0,,Рахмет! Шаааассу!
Dialogue: 0,0:05:44.81,0:05:47.11,Default,,0,0,0,,Гунну…. (Мияучи) Хмф!
Dialogue: 0,0:05:54.13,0:05:57.77,Default,,0,0,0,,((Фуруя, бүгін мүмкіндігінше қатты соққы ал.
Dialogue: 0,0:05:57.77,0:05:59.80,Default,,0,0,0,,Не? Мен де оқу-жаттығу жиынынан шаршадым →
Dialogue: 0,0:05:59.80,0:06:01.82,Default,,0,0,0,,Нәтижелерді іздемеңіз.
Dialogue: 0,0:06:01.82,0:06:07.43,Default,,0,0,0,,《Ұрылып жатыр ма? Бұл адам не туралы айтып жатыр? 》
Dialogue: 0,0:06:07.43,0:06:10.13,Default,,0,0,0,,Сізге екі апта бойы ештеңе лақтыруға тыйым салынады.
Dialogue: 0,0:06:10.13,0:06:12.77,Default,,0,0,0,,Екінші команданың жерінде жүгіру))
Dialogue: 0,0:06:12.77,0:06:17.47,Default,,0,0,0,,《Мен екі аптадан астам уақыттан бері төбеде ойнамадым.》
Dialogue: 0,0:06:17.47,0:06:19.42,Default,,0,0,0,,Ойна!
Dialogue: 0,0:06:19.42,0:06:21.51,Default,,0,0,0,,《Ешкімнің мені ұруына жол бермеймін》
Dialogue: 0,0:06:21.51,0:06:24.51,Default,,0,0,0,,《Миюки: Жарайды...》
Dialogue: 0,0:06:26.83,0:06:28.78,Default,,0,0,0,,Не болды! Сіз әлі қорқасыз ба?
Dialogue: 0,0:06:28.78,0:06:30.80,Default,,0,0,0,,Соққың келсе де, мен сонда боламын!
Dialogue: 0,0:06:30.80,0:06:33.77,Default,,0,0,0,,Ал, енді мені ауыстыр! Кола!
Dialogue: 0,0:06:33.77,0:06:37.88,Default,,0,0,0,,《Мен қорықпаймын және ауыстырғым келмейді》
Dialogue: 0,0:06:37.88,0:06:41.13,Default,,0,0,0,,《Рахмет: Былтырғы Кошиен жазғы екінші мектеп →
Dialogue: 0,0:06:41.13,0:06:43.78,Default,,0,0,0,,Осака Кирю орта мектебі.
Dialogue: 0,0:06:43.78,0:06:47.20,Default,,0,0,0,,Клуб мүшелерінің арқа бұлшықеттерінің орташа күші 180 кг-нан асады→
Dialogue: 0,0:06:47.20,0:06:50.77,Default,,0,0,0,,Оның құдіреті елдегі ең жақсы деп айтылады.
Dialogue: 0,0:06:50.77,0:06:55.91,Default,,0,0,0,,Жаттығу кезінде жинақталған шаршау және тіке матч стилі.
Dialogue: 0,0:06:55.91,0:07:00.51,Default,,0,0,0,,Дәл қазір Фуруя үшін қиын матч болатын сияқты》
Dialogue: 0,0:07:10.79,0:07:14.21,Default,,0,0,0,,
Dialogue: 0,0:07:14.21,0:07:16.21,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:23.42,0:07:25.47,Default,,0,0,0,,Доп.
Dialogue: 0,0:07:25.47,0:07:27.49,Default,,0,0,0,,Уау, экструзия.
Dialogue: 0,0:07:27.49,0:07:29.76,Default,,0,0,0,,Бұл құмыраның жағдайы өте нашар.
Dialogue: 0,0:07:29.76,0:07:31.85,Default,,0,0,0,,≪Бұл үшінші нүкте ме?
Dialogue: 0,0:07:31.85,0:07:35.85,Default,,0,0,0,,≪Олай болса да, ол биік допқа ешкім тиіспейді.
Dialogue: 0,0:07:39.87,0:07:43.47,Default,,0,0,0,,《Қарғыс атсын... доп мүлде жүгірмейді》
Dialogue: 0,0:07:43.47,0:07:47.53,Default,,0,0,0,,《Не істеп жатырсың, бейбақ?》
Dialogue: 0,0:07:47.53,0:07:50.43,Default,,0,0,0,,Қалай? Сол бірінші жылғы доп.
Dialogue: 0,0:07:50.43,0:07:52.47,Default,,0,0,0,,Оның жылдамдығы болса да →
Dialogue: 0,0:07:52.47,0:07:54.45,Default,,0,0,0,,Соққы мен доп анық →
Dialogue: 0,0:07:54.45,0:07:57.47,Default,,0,0,0,,Бұл допты соғу қиын емес. Стратегия оңай.
Dialogue: 0,0:07:57.47,0:08:01.43,Default,,0,0,0,,《Дұрыс есімде болсам, олар қазір оқу-жаттығу жиынында екенін айтты.》
Dialogue: 0,0:08:01.43,0:08:04.81,Default,,0,0,0,,Басқа адам өзін жақсы сезінбейді деп айтудан қорықпа.
Dialogue: 0,0:08:04.81,0:08:07.47,Default,,0,0,0,,Есін жоғалтқанша теріңіз. (Ойыншылар) Иә!
Dialogue: 0,0:08:07.47,0:08:11.44,Default,,0,0,0,,《Мен сені білемін, Катаока-хан.
Dialogue: 0,0:08:11.44,0:08:17.16,Default,,0,0,0,,Қадірлі балаң қалпына келмесе де.
Dialogue: 0,0:08:17.16,0:08:21.11,Default,,0,0,0,,Қанша шаршаса да, Фуруяның соншалықты жаман екеніне сене алар емеспін.
Dialogue: 0,0:08:21.11,0:08:23.30,Default,,0,0,0,,Кейінірек Соққы пайда болғанға дейін →
Dialogue: 0,0:08:23.30,0:08:25.68,Default,,0,0,0,,Оны ауыстырған дұрыс емес пе?
Dialogue: 0,0:08:25.68,0:08:28.85,Default,,0,0,0,,Фуруя 5 ретпен шектелген.
Dialogue: 0,0:08:28.85,0:08:30.85,Default,,0,0,0,,Немесе... Директор!
Dialogue: 0,0:08:36.88,0:08:41.77,Default,,0,0,0,,((Катаока: Ертеңгі матч, сіз бірінші курстың екі студентін қалай басқарасыз?
Dialogue: 0,0:08:41.77,0:08:46.67,Default,,0,0,0,,Әзірге Фуруя доптың күшін пайдаланып, қатты итеруді көздеп отыр.
Dialogue: 0,0:08:46.67,0:08:49.11,Default,,0,0,0,,Ммм, Миюки ше?
Dialogue: 0,0:08:49.11,0:08:53.31,Default,,0,0,0,,Фуруя жетекшілік етуге ерекше ниеті жоқ.
Dialogue: 0,0:08:53.31,0:08:56.81,Default,,0,0,0,,Мен шаршадым, ертең мен шынымен бос емеспін.
Dialogue: 0,0:08:56.81,0:08:58.77,Default,,0,0,0,,Не! ?
Dialogue: 0,0:08:58.77,0:09:01.32,Default,,0,0,0,,Қазір ол жігіт питчинг жинап жатыр, т.б.→
Dialogue: 0,0:09:01.32,0:09:03.29,Default,,0,0,0,,Бұл менің басымда жоқ.
Dialogue: 0,0:09:03.29,0:09:06.98,Default,,0,0,0,,Енді доптың күші азайып бара жатыр, бақылаудың маңыздылығы→
Dialogue: 0,0:09:06.98,0:09:09.43,Default,,0,0,0,,Мен мұны өзіңіз үшін есте сақтауыңызды сұраймын.
Dialogue: 0,0:09:09.43,0:09:11.65,Default,,0,0,0,,Жын...
Dialogue: 0,0:09:11.65,0:09:16.82,Default,,0,0,0,,Хмм, ертең Миюки. Сіз алыңыз.
Dialogue: 0,0:09:16.82,0:09:19.15,Default,,0,0,0,,Қарсылас - бұл Осака Кирю.
Dialogue: 0,0:09:19.15,0:09:23.34,Default,,0,0,0,,Менің ойымша, бұл қиын матч болады, бірақ сендер маған қосыласыңдар ма?
Dialogue: 0,0:09:23.34,0:09:25.64,Default,,0,0,0,,Иә! ))
Dialogue: 0,0:09:28.95,0:09:30.98,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:09:30.98,0:09:33.47,Default,,0,0,0,,Рио-сан!
Dialogue: 0,0:09:33.47,0:09:36.27,Default,,0,0,0,,Хяха~!
Dialogue: 0,0:09:36.27,0:09:38.31,Default,,0,0,0,,≪Ал... мен тоқтадым!
Dialogue: 0,0:09:38.31,0:09:40.43,Default,,0,0,0,,≪Ортаның алдындағы соққы бойынша екі есе ойнау! ?
Dialogue: 0,0:09:40.43,0:09:42.48,Default,,0,0,0,,≪Бұл не үшін қолға түсті?
Dialogue: 0,0:09:42.48,0:09:46.38,Default,,0,0,0,,Және... ұшып кетті! Мен жай ғана жекпе-жек ойынының фанаты емеспін.
Dialogue: 0,0:09:46.38,0:09:48.27,Default,,0,0,0,,Курамочи-сенпай!
Dialogue: 0,0:09:48.27,0:09:52.20,Default,,0,0,0,,Керемет Рио-сан! (Кадота) Бұл Ниюума ең күшті!
Dialogue: 0,0:09:52.20,0:09:56.94,Default,,0,0,0,,《Уау...шаршасаң да, неге олай қозғаласың...》
Dialogue: 0,0:09:56.94,0:09:59.48,Default,,0,0,0,,А, менің денем ауыр.
Dialogue: 0,0:09:59.48,0:10:01.85,Default,,0,0,0,,Барлығына бірдей.
Dialogue: 0,0:10:01.85,0:10:03.77,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:10:03.77,0:10:06.48,Default,,0,0,0,,Хаха.
Dialogue: 0,0:10:06.48,0:10:10.96,Default,,0,0,0,,Бак мені құтқарды.
Dialogue: 0,0:10:10.96,0:10:13.47,Default,,0,0,0,,Жақсы, егер бүгін жақсы жүрсең →
Dialogue: 0,0:10:13.47,0:10:17.33,Default,,0,0,0,,Егер сіз оны 10 ұпайға дейін сақтай алсаңыз, сіз жақсы орындадыңыз.
Dialogue: 0,0:10:17.33,0:10:22.63,Default,,0,0,0,,Мен бұдан былай істемеймін.
Dialogue: 0,0:10:25.32,0:10:28.14,Default,,0,0,0,,Уау, бірдеңе шығып жатыр!
Dialogue: 0,0:10:28.14,0:10:33.28,Default,,0,0,0,,《Хе-е, мына жігіт қорғанға ренжіген жоқ.
Dialogue: 0,0:10:33.28,0:10:37.48,Default,,0,0,0,,Бірақ допты қаншалықты күштеп алсаңыз, соғұрлым ол аз жүгіреді.
Dialogue: 0,0:10:37.48,0:10:41.35,Default,,0,0,0,,Енді сіз үшін нағыз сынақ келеді.
Dialogue: 0,0:10:41.35,0:10:43.47,Default,,0,0,0,,《Өкінішті...》
Dialogue: 0,0:10:43.47,0:10:48.81,Default,,0,0,0,,《Пупупу... Енді қашан мойынсұнатын боласың?》
Dialogue: 0,0:10:48.81,0:10:51.45,Default,,0,0,0,,Матч кезінде неге күлесің?
Dialogue: 0,0:10:51.45,0:10:54.98,Default,,0,0,0,,Крис-сенпай сияқты дұрыс басқар!
Dialogue: 0,0:10:54.98,0:10:57.62,Default,,0,0,0,,Жоқ... неге сонша ашуланасың!
Dialogue: 0,0:10:57.62,0:10:59.64,Default,,0,0,0,,Мені дәл қазір ауыстырамын деп айтпадың ба?
Dialogue: 0,0:10:59.64,0:11:01.66,Default,,0,0,0,,Иә, әрине!
Dialogue: 0,0:11:01.66,0:11:06.28,Default,,0,0,0,,《Крис: Аа…. Менің кезегім болмаса, көңілім қалар еді.
Dialogue: 0,0:11:06.28,0:11:14.47,Default,,0,0,0,,Бірақ менің орнымда болған Фуруя соққыға жығылса да өзімді жаман сезінемін... иә?
Dialogue: 0,0:11:14.47,0:11:16.59,Default,,0,0,0,,Эй, қазір өзгергің келе ме?
Dialogue: 0,0:11:16.59,0:11:19.32,Default,,0,0,0,,Мені назардан тыс қалдырмаңыз!
Dialogue: 0,0:11:19.32,0:11:22.31,Default,,0,0,0,,Сіз сүлгіні қолданасыз ба?
Dialogue: 0,0:11:22.31,0:11:24.76,Default,,0,0,0,,《Крис: Савамураның Фуруя туралы айтып жатқаны осы ғана→
Dialogue: 0,0:11:24.76,0:11:27.06,Default,,0,0,0,,》
Dialogue: 0,0:11:41.33,0:11:44.83,Default,,0,0,0,,《Ой, мына кісінің көзі нашар》
Dialogue: 0,0:11:47.85,0:11:50.85,Default,,0,0,0,,...
Dialogue: 0,0:11:52.86,0:11:55.48,Default,,0,0,0,,《Менің ойымша...》
Dialogue: 0,0:11:55.48,0:11:59.01,Default,,0,0,0,,Не? Қазірдің өзінде бар!
Dialogue: 0,0:11:59.01,0:12:01.53,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:12:01.53,0:12:03.48,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:12:03.48,0:12:06.60,Default,,0,0,0,,...
Dialogue: 0,0:12:06.60,0:12:09.94,Default,,0,0,0,,Не, ол не істеді?
Dialogue: 0,0:12:09.94,0:12:14.15,Default,,0,0,0,,～ １
Dialogue: 0,0:12:14.15,0:12:20.13,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:20.13,0:12:23.19,Default,,0,0,0,,《Таката: Бұл… жеткіліксіз…》
Dialogue: 0,0:12:23.19,0:12:25.11,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:25.11,0:12:27.33,Default,,0,0,0,,Доп! Алдыңғы!
Dialogue: 0,0:12:27.33,0:12:31.95,Default,,0,0,0,,Цк…. ≪Ей, эй, дәл қазір қанша допты бұздың?
Dialogue: 0,0:12:31.95,0:12:33.97,Default,,0,0,0,,≪１０
Dialogue: 0,0:12:33.97,0:12:36.35,Default,,0,0,0,,《
Dialogue: 0,0:12:36.35,0:12:38.79,Default,,0,0,0,,Мұндағылардың бәрі денелерін қозғалтпайды→
Dialogue: 0,0:12:38.79,0:12:41.89,Default,,0,0,0,,Біз сол жақтағы құмыраны да шаршатып жіберуіміз керек.
Dialogue: 0,0:12:44.19,0:12:46.61,Default,,0,0,0,,Дараша~!
Dialogue: 0,0:12:46.61,0:12:49.35,Default,,0,0,0,,Уау….
Dialogue: 0,0:12:49.35,0:12:51.45,Default,,0,0,0,,Nga! Бұл жерден кет!
Dialogue: 0,0:12:53.45,0:12:55.47,Default,,0,0,0,,《 》
Dialogue: 0,0:12:55.47,0:12:59.66,Default,,0,0,0,,Толық серуендеу кезінде дәл оңға соғыңыз.
Dialogue: 0,0:12:59.66,0:13:01.99,Default,,0,0,0,,Бұл Джун мен Зононың айырмашылығы.
Dialogue: 0,0:13:01.99,0:13:04.06,Default,,0,0,0,,Джакаашии!
Dialogue: 0,0:13:04.06,0:13:08.12,Default,,0,0,0,,Хмм, бізде ерекше ойыншылар бар, бірақ→
Dialogue: 0,0:13:08.12,0:13:12.49,Default,,0,0,0,,Мен күткендей, Сейдо спортшыларының барлығы ауыр сияқты.
Dialogue: 0,0:13:12.49,0:13:16.44,Default,,0,0,0,,Керісінше, бұл бізге ыңғайлы.
Dialogue: 0,0:13:16.44,0:13:18.79,Default,,0,0,0,,Бұл экспедицияда көп →
Dialogue: 0,0:13:18.79,0:13:21.39,Default,,0,0,0,,Сенімімді арттырып, үйге қайтуға рұқсат етіңіз.
Dialogue: 0,0:13:24.43,0:13:28.45,Default,,0,0,0,,А...
Dialogue: 0,0:13:28.45,0:13:31.19,Default,,0,0,0,,Сәлем! Сахна қойылды!
Dialogue: 0,0:13:31.19,0:13:33.69,Default,,0,0,0,,Мені ұр! (Сайто) Тецу!
Dialogue: 0,0:13:38.35,0:13:40.35,Default,,0,0,0,,Хмм….
Dialogue: 0,0:13:48.49,0:13:52.59,Default,,0,0,0,,Кел, кел, кел! Уақытында сол жақ далалық қоршауға тура соққы!
Dialogue: 0,0:13:52.59,0:13:55.15,Default,,0,0,0,,Тецу күткендей, сіз маған сене аласыз!
Dialogue: 0,0:13:55.15,0:13:59.12,Default,,0,0,0,,《Жоқ... бұл жігіт басқа санатта.
Dialogue: 0,0:13:59.12,0:14:01.92,Default,,0,0,0,,Дұрыс жарыссаң, жарайды! 》
Dialogue: 0,0:14:07.01,0:14:10.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:13.43,0:14:15.50,Default,,0,0,0,,Техникалық колледжде күтіп тұрған сиқыршыларды мүмкіндігінше үнсіз жойып жібергім келеді.
Dialogue: 0,0:14:15.50,0:14:18.59,Default,,0,0,0,,Әй, неткен ысырап! Бұл жолы бір ғана ұпай!
Dialogue: 0,0:14:18.59,0:14:20.64,Default,,0,0,0,,Бірақ қандай құдірет!
Dialogue: 0,0:14:20.64,0:14:23.49,Default,,0,0,0,,Құмыра шыбынының мұндай биікке ұшып кеткенін көрмедім.
Dialogue: 0,0:14:23.49,0:14:28.35,Default,,0,0,0,,Әдеттегідей, ол қисық доптарға қарсы әлсіз. Бұл дұрыс.
Dialogue: 0,0:14:28.35,0:14:30.95,Default,,0,0,0,,《Масуко-сенпай қатты итеріп жатыр...》
Dialogue: 0,0:14:34.14,0:14:38.01,Default,,0,0,0,,《Мен енді ештеңе істемеймін! 》
Dialogue: 0,0:14:38.01,0:14:40.69,Default,,0,0,0,,《Сіз де қатты итеріп жатырсыз.
Dialogue: 0,0:14:40.69,0:14:43.49,Default,,0,0,0,,Онда Кирюді басу мүмкін емес.
Dialogue: 0,0:16:19.44,0:16:22.88,Default,,0,0,0,,Хахаха...!
Dialogue: 0,0:16:22.88,0:16:25.63,Default,,0,0,0,,Кешіріңіз! Кеш!
Dialogue: 0,0:16:25.63,0:16:30.30,Default,,0,0,0,,Мен таспа сатып алуды ұмытып кетіппін, ал қайтып барсам, арпа шайының қорабын ұмытып кетіппін →
Dialogue: 0,0:16:30.30,0:16:32.97,Default,,0,0,0,,Сол кезде тасталған мысық пайда болды...
Dialogue: 0,0:16:32.97,0:16:35.31,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:16:35.31,0:16:38.64,Default,,0,0,0,,Доп алға!
Dialogue: 0,0:16:38.64,0:16:41.31,Default,,0,0,0,,《Өтірік! ? 》
Dialogue: 0,0:16:41.31,0:16:46.77,Default,,0,0,0,,4 иннингте 11 жүгіруге рұқсат етілген... Бұл Фуруя-кун ма?
Dialogue: 0,0:16:46.77,0:16:51.97,Default,,0,0,0,,≪Бұл не! Мұның бәрі құмыраның өзін-өзі жоюы емес пе?
Dialogue: 0,0:16:51.97,0:16:56.26,Default,,0,0,0,,≪Мен Кирюге қарсы қандай матч болатынын көру үшін осында келдім.
Dialogue: 0,0:16:56.26,0:16:58.31,Default,,0,0,0,,Енді мені ренжітпеңіз!
Dialogue: 0,0:16:58.31,0:17:00.31,Default,,0,0,0,,Үйге қайтайық!
Dialogue: 0,0:17:00.31,0:17:03.80,Default,,0,0,0,,Біз Сейдоны бұлай көргіміз келмейді!
Dialogue: 0,0:17:03.80,0:17:06.27,Default,,0,0,0,,Кирюдің соққылар құрамы күткендей.
Dialogue: 0,0:17:06.27,0:17:09.29,Default,,0,0,0,,Тұрақсыз басқару үшін →
Dialogue: 0,0:17:09.29,0:17:12.91,Default,,0,0,0,,Мен оны жақсылап шайқамаймын. Қанша шар?
Dialogue: 0,0:17:12.91,0:17:17.21,Default,,0,0,0,,4-ші иннингтің ортасында ол 100-ден астам алаңды лақтырды.
Dialogue: 0,0:17:19.62,0:17:22.62,Default,,0,0,0,,<U.A. орта мектебі, Батырлар курсы>
Dialogue: 0,0:17:25.16,0:17:27.16,Default,,0,0,0,,Менің иығым қалыптасып үлгерді!
Dialogue: 0,0:17:27.16,0:17:29.48,Default,,0,0,0,,Оны өзіме лақтырамын, Грасан...!
Dialogue: 0,0:17:29.48,0:17:32.46,Default,,0,0,0,,Жоқ, директор! Кола!
Dialogue: 0,0:17:32.46,0:17:35.77,Default,,0,0,0,,Сіз 6-шы иннингтен бастайсыз. Тыныш және қараңыз.
Dialogue: 0,0:17:35.77,0:17:39.30,Default,,0,0,0,,Мен оны көре алмаймын! Мен сондай қуаныштымын!
Dialogue: 0,0:17:39.30,0:17:41.96,Default,,0,0,0,,Бұл жиіркенішті, Катаока-хан.
Dialogue: 0,0:17:41.96,0:17:44.33,Default,,0,0,0,,Менің ойымша, қандай да бір мақсат бар.→
Dialogue: 0,0:17:44.33,0:17:48.26,Default,,0,0,0,,Егер мұны жасасаңыз, ойыншы жойылады.
Dialogue: 0,0:17:48.26,0:17:51.45,Default,,0,0,0,,Оның үстіне алаңшылар құмыраны тым көп елемейді.
Dialogue: 0,0:17:51.45,0:17:54.19,Default,,0,0,0,,Менімен сөйлесуге ешкімнің батылы бармайды.
Dialogue: 0,0:17:54.19,0:17:57.29,Default,,0,0,0,,Бұл менің әлгі құмыра үшін жаным ашиды.
Dialogue: 0,0:18:16.26,0:18:19.16,Default,,0,0,0,,Сіз шынымен керемет жігітсіз.
Dialogue: 0,0:18:19.16,0:18:21.45,Default,,0,0,0,,Осы көп төрт шарды жасау кезінде→
Dialogue: 0,0:18:21.45,0:18:24.03,Default,,0,0,0,,Әр қадамда соққыға барыңыз→
Dialogue: 0,0:18:24.03,0:18:26.63,Default,,0,0,0,,Жұмсақ допты лақтырмақ емес.
Dialogue: 0,0:18:32.52,0:18:34.52,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:39.51,0:18:42.81,Default,,0,0,0,,《Жоқ, бұл сөзсіз шегінде》
Dialogue: 0,0:18:47.84,0:18:49.84,Default,,0,0,0,,Миюки-сенпай….
Dialogue: 0,0:18:52.13,0:18:55.63,Default,,0,0,0,,Ұпай алудан қалай аулақ болуға болады?
Dialogue: 0,0:18:58.77,0:19:02.95,Default,,0,0,0,,Менің көңілім қалды, бірақ мен бүгін допты лақтыра алмаймын.
Dialogue: 0,0:19:02.95,0:19:08.48,Default,,0,0,0,,Бірақ мен бұлай қорғаннан түскім келмейді.
Dialogue: 0,0:19:08.48,0:19:11.15,Default,,0,0,0,,Бір кеңес.
Dialogue: 0,0:19:11.15,0:19:13.50,Default,,0,0,0,,《Бұл жігіт...
Dialogue: 0,0:19:13.50,0:19:18.82,Default,,0,0,0,,Шектеу шегінде болса да, менің көзім мүлде өлген жоқ.
Dialogue: 0,0:19:18.82,0:19:22.46,Default,,0,0,0,,Оның үстіне ішімдегі өкінішті → басып қалдым
Dialogue: 0,0:19:22.46,0:19:25.43,Default,,0,0,0,,Ол менен кеңес сұрады》
Dialogue: 0,0:19:25.43,0:19:28.36,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:19:28.36,0:19:31.27,Default,,0,0,0,,《Оның көзқарасы әлі де керемет》
Dialogue: 0,0:19:31.27,0:19:36.30,Default,,0,0,0,,Хе... Хе хе хе!
Dialogue: 0,0:19:36.30,0:19:38.44,Default,,0,0,0,,《Мен сенімдімін》
Dialogue: 0,0:19:38.44,0:19:40.54,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:19:40.54,0:19:43.54,Default,,0,0,0,,《Бұл жігітте ace құралы бар! 》
Dialogue: 0,0:19:47.30,0:19:49.43,Default,,0,0,0,,Не?
Dialogue: 0,0:19:49.43,0:19:52.14,Default,,0,0,0,,《Неге күлесің? 》
Dialogue: 0,0:19:52.14,0:19:57.26,Default,,0,0,0,,Жарайсың ба? Фуруя: сабырмен ойлан.
Dialogue: 0,0:19:57.26,0:19:59.98,Default,,0,0,0,,Осы уақытқа дейін жеті соққы жасалды.
Dialogue: 0,0:19:59.98,0:20:04.87,Default,,0,0,0,,Жіберілген ұпайлардың көпшілігі сіздің төрт доптан алынды, солай емес пе?
Dialogue: 0,0:20:04.87,0:20:08.97,Default,,0,0,0,,Сонда да Тецу-сан мен Джун-сан ештеңе айтқан жоқ →
Dialogue: 0,0:20:08.97,0:20:13.81,Default,,0,0,0,,Неге екенін білесіз бе? Міне, сіз →
Dialogue: 0,0:20:13.81,0:20:16.48,Default,,0,0,0,,Ол адамдар маған сенеді!
Dialogue: 0,0:20:16.48,0:20:18.48,Default,,0,0,0,,《Аа...》
Dialogue: 0,0:20:28.81,0:20:32.68,Default,,0,0,0,,《Ал, кешегі жиналыста басынан шешілді.》
Dialogue: 0,0:20:32.68,0:20:37.31,Default,,0,0,0,,《Оған төзе алатынымның шегі бар! Миюки! 》
Dialogue: 0,0:20:37.31,0:20:42.44,Default,,0,0,0,,Құмыраның жұмысы тек соққы алу емес.
Dialogue: 0,0:20:42.44,0:20:46.19,Default,,0,0,0,,Лақтырғанда арқаға көбірек сену керек.
Dialogue: 0,0:20:46.19,0:20:49.79,Default,,0,0,0,,Осымен.
Dialogue: 0,0:20:54.45,0:20:57.05,Default,,0,0,0,,Бұдан былай менің қолғаптарымды мұқият бақылаңыз.
Dialogue: 0,0:21:06.58,0:21:09.18,Default,,0,0,0,,Сенім….
Dialogue: 0,0:21:17.30,0:21:21.26,Default,,0,0,0,,((Сен өте тітіркендіргішсің, мен енді сенімен араласқым келмейді!
Dialogue: 0,0:21:21.26,0:21:23.86,Default,,0,0,0,,Мына суықта не айтып тұрсың?
Dialogue: 0,0:21:23.86,0:21:26.16,Default,,0,0,0,,≪Егер бейсбол ойнағыңыз келсе, оны басқа жерде жасаңыз!
Dialogue: 0,0:21:31.27,0:21:35.82,Default,,0,0,0,,≪Ей, әлгі құбыжық жалғыз жаттығу жасап жатқан сияқты.
Dialogue: 0,0:21:35.82,0:21:40.12,Default,,0,0,0,,<<Қой, енді бізге қатысы жоқ))
Dialogue: 0,0:21:51.81,0:21:54.48,Default,,0,0,0,,Сәлем Фуруя Корра! Сіз ояусыз ба? ?
Dialogue: 0,0:21:54.48,0:21:56.48,Default,,0,0,0,,Жауап беріңіз! а! ?
Dialogue: 0,0:21:56.48,0:22:00.43,Default,,0,0,0,,Не болды? Ол қазірдің өзінде шегінде! Ол ауыстырылады ма? Ол ауыстырылады ма? ?
Dialogue: 0,0:22:00.43,0:22:04.53,Default,,0,0,0,,Аузыңды жап, Савамура. Ха, Крис-сенпай!
Dialogue: 0,0:22:07.19,0:22:15.19,Default,,0,0,0,,《Иә, бұл жер ол жерден басқаша...》
Dialogue: 0,0:22:21.95,0:22:24.87,Default,,0,0,0,,《Қызық болып барады!
Dialogue: 0,0:22:24.87,0:22:27.81,Default,,0,0,0,,Енді нағыз доп.》
Dialogue: 0,0:22:27.81,0:22:32.80,Default,,0,0,0,,((Миюки: Құмыраның жұмысы тек соққы алу емес.
Dialogue: 0,0:22:32.80,0:22:37.47,Default,,0,0,0,,Тек сөмкеге көбірек сеніп, лақтыру керек))
Dialogue: 0,0:22:37.47,0:22:42.51,Default,,0,0,0,,《Иә, тек сол қолғапқа сеніңіз→
Dialogue: 0,0:22:42.51,0:22:47.51,Default,,0,0,0,,Тек лақтырыңыз. Сол қолғап...》
Dialogue: 0,0:22:57.49,0:22:59.46,Default,,0,0,0,,Орталық!
Dialogue: 0,0:22:59.46,0:23:01.53,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:23:01.53,0:23:03.83,Default,,0,0,0,,Тексеру Жарайды!
Dialogue: 0,0:23:06.96,0:23:09.03,Default,,0,0,0,,Жүр!
Dialogue: 0,0:23:09.03,0:23:12.47,Default,,0,0,0,,Ооо, өл!
Dialogue: 0,0:23:12.47,0:23:14.47,Default,,0,0,0,,
Dialogue: 0,0:23:16.84,0:23:19.59,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:23:19.59,0:23:22.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:23:22.11,0:23:25.20,Default,,0,0,0,,Уау, Исаски-сенпай!
Dialogue: 0,0:23:25.20,0:23:27.80,Default,,0,0,0,,Ол жай ғана сыпайы аға емес!
Dialogue: 0,0:23:30.10,0:23:32.17,Default,,0,0,0,,Жақсы Джун-сан.
Dialogue: 0,0:23:32.17,0:23:34.47,Default,,0,0,0,,Бір жарылыс сенімдірек.
Dialogue: 0,0:23:34.47,0:23:37.18,Default,,0,0,0,,Шулы! Сәлем Фуруя!
Dialogue: 0,0:23:37.18,0:23:40.18,Default,,0,0,0,,Эй, сен үй қақпағын ұмытып кетіпсің!
Dialogue: 0,0:23:42.13,0:23:47.02,Default,,0,0,0,,Егер менің лақтырғаным рельстен шығып кетсе, сен не істер едің?
Dialogue: 0,0:23:47.02,0:23:51.82,Default,,0,0,0,,Бейсболды жалғыз ойнама... ақымақ.
Dialogue: 0,0:24:00.47,0:24:03.10,Default,,0,0,0,,Сен сол орталыққа тәтті қарадың.
Dialogue: 0,0:24:03.10,0:24:06.64,Default,,0,0,0,,Неліктен сіз бірінші қадамға жетуге тырысасыз?
Dialogue: 0,0:24:06.64,0:24:09.04,Default,,0,0,0,,Менің ойымша, стратегия екі соққыға дейін күту.
Dialogue: 0,0:24:09.04,0:24:11.53,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:24:11.53,0:24:14.83,Default,,0,0,0,,Қолым бетіме жақындап қалғаны сонша, қолымды ұстамай қалдым.
Dialogue: 0,0:24:16.77,0:24:21.14,Default,,0,0,0,,Фуруя Сіз түсіндіңіз бе?
Dialogue: 0,0:24:21.14,0:24:24.81,Default,,0,0,0,,Егер сіз көп күш қолдансаңыз да, доп ешқашан жүгірмейді.
Dialogue: 0,0:24:24.81,0:24:27.79,Default,,0,0,0,,Сізге осындай жылдам допты құмыраға не қажет →
Dialogue: 0,0:24:27.79,0:24:32.00,Default,,0,0,0,,Бұл жылдамдық пен бақылау туралы.
Dialogue: 0,0:24:32.00,0:24:39.10,Default,,0,0,0,,Айтпақшы... Мен басқа біреуге ұпай алғым келеді.
Dialogue: 0,0:24:44.93,0:24:46.98,Default,,0,0,0,,Таа құмыра жерлендіруші! ?
Dialogue: 0,0:24:46.98,0:24:49.43,Default,,0,0,0,,Жалқау….
Dialogue: 0,0:24:49.43,0:24:53.47,Default,,0,0,0,,2-ші ат-бат, соққы жоқ...
Dialogue: 0,0:24:53.47,0:24:55.46,Default,,0,0,0,,Әлгі ақымақ...
Dialogue: 0,0:24:55.46,0:24:59.09,Default,,0,0,0,,Егер жүгіруші болса, Миюки басқа адам болар еді.
Dialogue: 0,0:24:59.09,0:25:01.55,Default,,0,0,0,,Бұл тым біркелкі емес.
Dialogue: 0,0:25:01.55,0:25:03.43,Default,,0,0,0,,Фуруя өзінің шегіне жетті→
Dialogue: 0,0:25:03.43,0:25:05.77,Default,,0,0,0,,Бұл көзілдірікті ұстағыш сенімсіз→
Dialogue: 0,0:25:05.77,0:25:08.47,Default,,0,0,0,,Менің кетуден басқа амалым жоқ! (Курамочи) Савамура!
Dialogue: 0,0:25:08.47,0:25:10.52,Default,,0,0,0,,Жоқ, бірақ! Ауызыңды жап. Бірақ!
Dialogue: 0,0:25:10.52,0:25:15.52,Default,,0,0,0,,Тыныш отырайық, Эйджун-кун. Көктемге дейін!
Dialogue: 0,0:25:17.02,0:25:23.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory