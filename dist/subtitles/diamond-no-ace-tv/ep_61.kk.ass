Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,20:23:02.65,20:23:04.95,Default,,0,0,0,,Керемет доп, соңғы доп!
Dialogue: 0,20:23:09.67,20:23:11.66,Default,,0,0,0,,《Вакана: Эйджун…》
Dialogue: 0,20:23:11.66,20:23:15.01,Default,,0,0,0,,Мен бұл жігіттің соңына дейін тұрады деп ойламаппын.
Dialogue: 0,20:23:15.01,20:23:17.66,Default,,0,0,0,,Қорықпайтын адамның түрі→
Dialogue: 0,20:23:17.66,20:23:20.00,Default,,0,0,0,,Олар матчты оңай шешеді.
Dialogue: 0,20:23:20.00,20:23:22.84,Default,,0,0,0,,Ах. (Ничишо) 1 санына қосылатын 9 саннан...
Dialogue: 0,20:23:22.84,20:23:25.34,Default,,0,0,0,,Егер жүгіруші шықса, сіз білмейсіз.
Dialogue: 0,20:23:25.34,20:23:29.29,Default,,0,0,0,,Осы жерден шешіңіз, қарғыс атқыр! Чикусо! !
Dialogue: 0,20:23:29.29,20:23:32.36,Default,,0,0,0,,Күтілгендей, бұл Савамура-кун болды.
Dialogue: 0,20:23:32.36,20:23:34.45,Default,,0,0,0,,Өйткені оның импульсі бар.
Dialogue: 0,20:23:34.45,20:23:39.22,Default,,0,0,0,,Дегенмен, тіпті бір жүгіруші пайда болса, мен оны Каваками-кунмен байланыстыруды жоспарлап жатқанына сенімдімін.
Dialogue: 0,20:23:39.22,20:23:43.02,Default,,0,0,0,,Сол жақ қорғаушы Фуруяны түсіріп, қорғанысты күшейтті.
Dialogue: 0,20:23:44.96,20:23:46.99,Default,,0,0,0,,Әй, қолда.
Dialogue: 0,20:23:46.99,20:23:50.51,Default,,0,0,0,,Сейдо бар күшін →-ге салады
Dialogue: 0,20:23:50.51,20:23:53.81,Default,,0,0,0,,Мен осы бір мәселеге тоқталғым келеді.
Dialogue: 0,20:23:56.85,20:23:58.82,Default,,0,0,0,,Наримия Іш киімді ауыстырсам ба?
Dialogue: 0,20:23:58.82,20:24:00.92,Default,,0,0,0,,Қажет емес.
Dialogue: 0,20:24:14.84,20:24:18.51,Default,,0,0,0,,Сіз қалай ойлайсыз? Жеңіс бейнесі нығая түсті ме?
Dialogue: 0,20:24:18.51,20:24:20.46,Default,,0,0,0,,Иә!
Dialogue: 0,20:24:20.46,20:24:24.33,Default,,0,0,0,,Бұл бір жылдық құмыра туралы ақпарат аз →
Dialogue: 0,20:24:24.33,20:24:26.67,Default,,0,0,0,,Бұл мен ойлағаннан да қызық болуы мүмкін →
Dialogue: 0,20:24:26.67,20:24:29.84,Default,,0,0,0,,Бұл, әрине, қолдары мен аяқтары жоқ доп емес.
Dialogue: 0,20:24:29.84,20:24:33.17,Default,,0,0,0,,Асықпай, шабуыл жасамасаң, міндетті түрде шүберек аласың.
Dialogue: 0,20:24:33.17,20:24:37.13,Default,,0,0,0,,Ал егер сіз Кавакамиге тежеуші ретінде сенсеңіз→
Dialogue: 0,20:24:37.13,20:24:40.00,Default,,0,0,0,,Бұл ағынның жоғары жағында болуы мүмкін.
Dialogue: 0,20:24:40.00,20:24:42.48,Default,,0,0,0,,Мұны істемеу → дегенді білдіреді
Dialogue: 0,20:24:42.48,20:24:45.58,Default,,0,0,0,,Ауыстыруға байланысты қандай да бір қобалжу бар.
Dialogue: 0,20:24:48.00,20:24:50.31,Default,,0,0,0,,Тыңда, маған 2 ұпай керек емес.
Dialogue: 0,20:24:50.31,20:24:52.31,Default,,0,0,0,,Бір ұпай жеткілікті.
Dialogue: 0,20:24:54.71,20:24:58.01,Default,,0,0,0,,Овертаймға кетсе, біз міндетті түрде жеңеміз.
Dialogue: 0,20:27:41.01,20:27:47.63,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,20:27:47.63,20:27:52.19,Default,,0,0,0,,[Майк] Екінші рет қатарынан жеңіске жеткен жаз, өткен жылғы чемпионның табандылығы мен мақтанышы.
Dialogue: 0,20:27:52.19,20:27:56.14,Default,,0,0,0,,[Майк] 9-шы иннингтің төменгі бөлігі Инаги Джицугёның соңғы шабуылы.
Dialogue: 0,20:27:56.14,20:27:59.05,Default,,0,0,0,,[Майк] Жарғанат – Йабе, екінші жыл шымшу.
Dialogue: 0,20:27:59.05,20:28:01.16,Default,,0,0,0,,Тыныш!
Dialogue: 0,20:28:01.16,20:28:03.30,Default,,0,0,0,,Солақай соққының орнына Фуджикава→
Dialogue: 0,20:28:03.30,20:28:05.34,Default,,0,0,0,,Сіз оң қолды ұрып әкелдіңіз.
Dialogue: 0,20:28:05.34,20:28:10.12,Default,,0,0,0,,《Миюки: Егер есімде дұрыс болса, бұл жігіт іштей ұратын.
Dialogue: 0,20:28:10.12,20:28:13.84,Default,,0,0,0,,Сізге күшті соққы болуы мүмкін →
Dialogue: 0,20:28:13.84,20:28:16.01,Default,,0,0,0,,Масуко Сенпай》
Dialogue: 0,20:28:16.01,20:28:27.06,Default,,0,0,0,,♪♪~
Dialogue: 0,20:28:27.06,20:28:32.33,Default,,0,0,0,,Бірінші қадамға мұқият болыңыз... Бірінші соққыға төрт доп беру - ең нашар...
Dialogue: 0,20:28:32.33,20:28:35.83,Default,,0,0,0,,Yabe Бірінші қадамнан бастайық! (Хирай) Барынша қатты жүр!
Dialogue: 0,20:28:35.83,20:28:39.97,Default,,0,0,0,,((Кунитомо: Маған 2 ұпай керек емес. 1 ұпай жақсы.
Dialogue: 0,20:28:39.97,20:28:43.91,Default,,0,0,0,,Овертаймға кетсе, міндетті түрде жеңеміз))
Dialogue: 0,20:28:43.91,20:28:45.91,Default,,0,0,0,,Раа!
Dialogue: 0,20:28:48.38,20:28:50.48,Default,,0,0,0,,《Мүлдем қосылыңыз》
Dialogue: 0,20:28:54.97,20:28:59.46,Default,,0,0,0,,《Біз бұлай аяқталатын команда емеспіз.
Dialogue: 0,20:28:59.46,20:29:01.56,Default,,0,0,0,,Мұның аяқталуына жол бермеңіз! 》
Dialogue: 0,20:29:08.03,20:29:10.18,Default,,0,0,0,,Қауіпсіздік! (Миюки) Үшінші!
Dialogue: 0,20:29:10.18,20:29:16.26,Default,,0,0,0,,《Мен өз пішініме мән бермеймін. Мен базаға жеткенше...
Dialogue: 0,20:29:16.26,20:29:18.26,Default,,0,0,0,,Егер сіз оны артқы жағына қоссаңыз...》
Dialogue: 0,20:29:30.17,20:29:33.17,Default,,0,0,0,,Ябе Бұл ұят.
Dialogue: 0,20:29:33.17,20:29:35.16,Default,,0,0,0,,Бұзушылық!
Dialogue: 0,20:29:35.16,20:29:38.65,Default,,0,0,0,,≪Жақсы, Ябе! Чикусо!
Dialogue: 0,20:29:38.65,20:29:40.65,Default,,0,0,0,,≪ Керемет Фей Йабе!
Dialogue: 0,20:29:47.99,20:29:52.01,Default,,0,0,0,,Раа!
Dialogue: 0,20:29:52.01,20:29:55.35,Default,,0,0,0,,《Иә, бұл ойын.
Dialogue: 0,20:29:55.35,20:29:58.46,Default,,0,0,0,,Жеңіс немесе жеңіліс →
Dialogue: 0,20:29:58.46,20:30:00.80,Default,,0,0,0,,Қатты бәсеке》
Dialogue: 0,20:30:00.80,20:30:06.51,Default,,0,0,0,,♪♪~
Dialogue: 0,20:30:06.51,20:30:11.11,Default,,0,0,0,,《Тірі қалудың жалғыз жолы – қарсыласыңды жеңу》
Dialogue: 0,20:30:15.38,20:30:17.68,Default,,0,0,0,,《Жеңілмеу》
Dialogue: 0,20:30:23.06,20:30:27.36,Default,,0,0,0,,《Сезімдеріңнен ешқашан бас тартпа! 》
Dialogue: 0,20:30:34.18,20:30:36.18,Default,,0,0,0,,Көктем!
Dialogue: 0,20:30:38.34,20:30:41.22,Default,,0,0,0,,《Харуичи: Жіңішке секіру, алға шығасың ба?→
Dialogue: 0,20:30:41.22,20:30:43.56,Default,,0,0,0,,Күтуім керек пе?
Dialogue: 0,20:30:43.56,20:30:46.56,Default,,0,0,0,,《Күтпе, асығыс! 》
Dialogue: 0,20:30:49.05,20:30:51.15,Default,,0,0,0,,♬~
Dialogue: 0,20:30:54.84,20:30:57.71,Default,,0,0,0,,Шығар! (қуаныш)
Dialogue: 0,20:30:57.71,20:31:07.38,Default,,0,0,0,,♪♪~
Dialogue: 0,20:31:07.38,20:31:09.50,Default,,0,0,0,,Жарайды, мен бірінші шайырды алдым!
Dialogue: 0,20:31:09.50,20:31:11.49,Default,,0,0,0,,Екіншісін жасайық!
Dialogue: 0,20:31:11.49,20:31:14.01,Default,,0,0,0,,Бұл мені әлдеқайда жақсы сезінеді.
Dialogue: 0,20:31:14.01,20:31:18.29,Default,,0,0,0,,Иә, соғу қиын болды, бірақ мен оны жақсы ұстадым.
Dialogue: 0,20:31:18.29,20:31:20.65,Default,,0,0,0,,1 шықты! 1 шықты!
Dialogue: 0,20:31:20.65,20:31:23.00,Default,,0,0,0,,1-ден 1 шықты!
Dialogue: 0,20:31:23.00,20:31:25.64,Default,,0,0,0,,1 шықты! (Исашики) 1 шықты!
Dialogue: 0,20:31:25.64,20:31:27.67,Default,,0,0,0,,1 шықты!
Dialogue: 0,20:31:27.67,20:31:31.16,Default,,0,0,0,,《Барлығы: тағы 2 шығу》
Dialogue: 0,20:31:31.16,20:31:34.98,Default,,0,0,0,,[Майк] Осы кезде соққы реті бірінші нөмірге оралады, орталық Карлос Камия.
Dialogue: 0,20:31:34.98,20:31:38.18,Default,,0,0,0,,[Майк] Инамидің мақтан тұтатын №1 және №2 комбинациясы ойынды шеше ме?
Dialogue: 0,20:31:38.18,20:31:41.17,Default,,0,0,0,,[Майк] Әлде мен мүмкіндіктерді кеңейтіп, кек қайтаруым керек пе?
Dialogue: 0,20:31:41.17,20:31:44.27,Default,,0,0,0,,《Карлос: Қандай құпия қару》
Dialogue: 0,20:31:50.84,20:31:53.96,Default,,0,0,0,,《Карлос: Сіз Йабиді өлтірдіңіз бе?
Dialogue: 0,20:31:53.96,20:31:57.17,Default,,0,0,0,,Бірақ мен беріле алмаймын.
Dialogue: 0,20:31:57.17,20:32:00.55,Default,,0,0,0,,Кошиен - біз ымыраға келмейтін жалғыз жер.
Dialogue: 0,20:32:00.55,20:32:04.96,Default,,0,0,0,,Мен қалыпты орта мектеп өмірінен әлдеқашан бас тарттым.
Dialogue: 0,20:32:04.96,20:32:11.13,Default,,0,0,0,,Бейсболға арналған өмір.
Dialogue: 0,20:32:11.13,20:32:15.03,Default,,0,0,0,,Осы уақытқа дейін жеткен болсам, мен жеңгім келеді.
Dialogue: 0,20:32:15.03,20:32:18.03,Default,,0,0,0,,Мен нәтиже алғым келеді》
Dialogue: 0,20:32:21.34,20:32:27.81,Default,,0,0,0,,♪♪~
Dialogue: 0,20:32:27.81,20:32:30.17,Default,,0,0,0,,《Бұл жігіт...》
Dialogue: 0,20:32:30.17,20:32:32.55,Default,,0,0,0,,Базаны жабады! ?
Dialogue: 0,20:32:32.55,20:32:35.12,Default,,0,0,0,,Сіз өлі доптың жолды бөгеуге дайынсыз ба?
Dialogue: 0,20:32:35.12,20:32:38.01,Default,,0,0,0,,Бірақ базаны сонша жабатын болсаңыз→
Dialogue: 0,20:32:38.01,20:32:40.34,Default,,0,0,0,,Курста соғуға болмайды.
Dialogue: 0,20:32:40.34,20:32:43.50,Default,,0,0,0,,Бұл да дірілдеп тұр. Шайқаңыз ба?
Dialogue: 0,20:32:43.50,20:32:46.18,Default,,0,0,0,,Бұл төрт доп немесе өлі доп →
Dialogue: 0,20:32:46.18,20:32:49.54,Default,,0,0,0,,Өзін қалай көрсетсе де, негізге алуға тырысу →
Dialogue: 0,20:32:49.54,20:32:53.34,Default,,0,0,0,,Патшаның құмарлығы.
Dialogue: 0,20:32:53.34,20:32:55.79,Default,,0,0,0,,Жүрегімде азғантай бір толқу болса →
Dialogue: 0,20:32:55.79,20:32:59.33,Default,,0,0,0,,Мен сонда барамын.
Dialogue: 0,20:32:59.33,20:33:02.97,Default,,0,0,0,,《Одан жақсы құтылу біз үшін мүмкін емес.
Dialogue: 0,20:33:02.97,20:33:06.40,Default,,0,0,0,,Ал орта мектептің бейсбол төрешілері →
Dialogue: 0,20:33:06.40,20:33:08.82,Default,,0,0,0,,Егер қамыр әдейі қашпаса →
Dialogue: 0,20:33:08.82,20:33:10.82,Default,,0,0,0,,Ол санауды қабылдайды》
Dialogue: 0,20:33:13.48,20:33:16.48,Default,,0,0,0,,《Қатал шабуыл жасаймыз!
Dialogue: 0,20:33:16.48,20:33:18.48,Default,,0,0,0,,Сіз оны лақтыра аласыз! 》
Dialogue: 0,20:33:22.55,20:33:25.65,Default,,0,0,0,,《Миюки: Савамураға шабуыл》
Dialogue: 0,20:33:28.66,20:33:33.40,Default,,0,0,0,,《Миюки: қашпа. Сезімдеріңізді көрсетіңіз.
Dialogue: 0,20:33:33.40,20:33:35.70,Default,,0,0,0,,Бұл сіздің қаруыңыз》
Dialogue: 0,20:33:39.02,20:33:41.70,Default,,0,0,0,,[Майк] Бірінші қадам, төмен және допты жіберіп алу.
Dialogue: 0,20:33:41.70,20:33:44.80,Default,,0,0,0,,Жарайды, доп келді!
Dialogue: 0,20:33:47.98,20:33:51.18,Default,,0,0,0,,《Макихара: Савамураға шабуыл》
Dialogue: 0,20:33:51.18,20:33:54.03,Default,,0,0,0,,《Харуно: Савамура-кун…》
Dialogue: 0,20:33:54.03,20:33:56.82,Default,,0,0,0,,《Маэзоно/Канамару: Шабуыл, Савамура! 》
Dialogue: 0,20:33:56.82,20:33:59.92,Default,,0,0,0,,Жүр! !
Dialogue: 0,20:34:03.71,20:34:06.01,Default,,0,0,0,,《Миюки: Тәтті...! 》
Dialogue: 0,20:34:17.54,20:34:20.14,Default,,0,0,0,,Бұзушылық!
Dialogue: 0,20:34:22.33,20:34:25.13,Default,,0,0,0,,《Мен әлі артта қалдым...》
Dialogue: 0,20:34:28.25,20:34:33.34,Default,,0,0,0,,Курста лақтыру қиын сияқты. (Орта) Қарсылас 1-ші топтың жүйрік командасы.
Dialogue: 0,20:34:33.34,20:34:36.91,Default,,0,0,0,,Мен өлі допты → негізінде ойнағым келмейді
Dialogue: 0,20:34:36.91,20:34:41.41,Default,,0,0,0,,Сондай-ақ тоғыз рет қорғанның үстінде болу қысымы болады.
Dialogue: 0,20:34:46.07,20:34:48.29,Default,,0,0,0,,《Жарайды.
Dialogue: 0,20:34:48.29,20:34:50.62,Default,,0,0,0,,Доп келе жатыр, Савамура! 》
Dialogue: 0,20:34:50.62,20:34:54.34,Default,,0,0,0,,《Ол жерде шошып тұрған қорқау емес...
Dialogue: 0,20:34:54.34,20:34:58.34,Default,,0,0,0,,Тәтті болса... Мен аламын! 》
Dialogue: 0,20:35:07.87,20:35:10.47,Default,,0,0,0,,《Қандай мақсатта...》
Dialogue: 0,20:35:13.65,20:35:16.65,Default,,0,0,0,,《Осы жағдайға қалай жетті...》
Dialogue: 0,20:35:19.54,20:35:24.01,Default,,0,0,0,,《Мен Кошиеннің қандай екенін білмеймін→
Dialogue: 0,20:35:24.01,20:35:27.21,Default,,0,0,0,,Осы жерден қашып кетсеңіз →
Dialogue: 0,20:35:27.21,20:35:32.21,Default,,0,0,0,,Мен енді төбеде тұра алмайтындай сезінемін.
Dialogue: 0,20:35:34.40,20:35:37.20,Default,,0,0,0,,《Сіз қаша аласыз ба? 》
Dialogue: 0,20:35:46.18,20:35:49.28,Default,,0,0,0,,Уау! (3 адам) Тыныш! !
Dialogue: 0,20:36:02.66,20:36:05.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,20:36:05.56,20:36:29.79,Default,,0,0,0,,♪♪~
Dialogue: 0,20:36:29.79,20:36:32.84,Default,,0,0,0,,《Тағы бір шықты...》
Dialogue: 0,20:36:32.84,20:36:38.83,Default,,0,0,0,,《Сабақ жұмсақ болды, бірақ оның қолдары тербеліп тұр, допқа күші бар.
Dialogue: 0,20:36:38.83,20:36:40.83,Default,,0,0,0,,Егер бұл...》
Dialogue: 0,20:36:44.20,20:36:48.00,Default,,0,0,0,,Қатаң... одан да қатаң...
Dialogue: 0,20:37:50.00,20:37:52.30,Default,,0,0,0,,[Радио] 9-шы иннингтің төменгі бөлігі, 2 шығу, жүгірушілер жоқ.
Dialogue: 0,20:37:52.30,20:37:55.84,Default,,0,0,0,,[Радио] Сейдо ақыры өткен жылғы чемпион Инаги Джицугёны бұрыштан қағып алды.
Dialogue: 0,20:37:55.84,20:37:59.80,Default,,0,0,0,,Тағы біреуі шықты! Кошиен бір ғана шықты!
Dialogue: 0,20:37:59.80,20:38:11.67,Default,,0,0,0,,Тағы бір, тағы бір, тағы бір...
Dialogue: 0,20:38:11.67,20:38:16.00,Default,,0,0,0,,≪Шешіңіз, Сейдо! ≪Сейдо!
Dialogue: 0,20:38:16.00,20:38:17.96,Default,,0,0,0,,Тағы бір нәрсе!
Dialogue: 0,20:38:17.96,20:38:21.88,Default,,0,0,0,,Әлі жоқ! Берілме! ! ≪Кеттік!
Dialogue: 0,20:38:21.88,20:38:31.64,Default,,0,0,0,,Тағы бір, тағы бір, тағы бір...
Dialogue: 0,20:38:31.64,20:38:33.66,Default,,0,0,0,,《Курамочи: Мен бара аламын...》
Dialogue: 0,20:38:33.66,20:38:37.00,Default,,0,0,0,,《Сақай: Біз...》 《Тамба: Жеңеміз! 》
Dialogue: 0,20:38:37.00,20:38:40.62,Default,,0,0,0,,《Мүлдем мүмкін! 》
Dialogue: 0,20:38:40.62,20:38:46.84,Default,,0,0,0,,《Сейдо Тоғыз: Мына сахнада тұр! 》
Dialogue: 0,20:38:46.84,20:38:51.81,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,20:38:51.81,20:38:53.83,Default,,0,0,0,,Кеттік, Ширакава!
Dialogue: 0,20:38:53.83,20:39:00.66,Default,,0,0,0,,Тағы бір, тағы бір, тағы бір...
Dialogue: 0,20:39:00.66,20:39:03.01,Default,,0,0,0,,《Осыған да сүйене отырып...
Dialogue: 0,20:39:03.01,20:39:07.35,Default,,0,0,0,,Ол абай болу керек ұрғыш, бірақ ол бір рет атпайды.
Dialogue: 0,20:39:07.35,20:39:13.34,Default,,0,0,0,,Савамураның добы күшке ие және ол осы жерде гол соға алса жақсы болар еді.
Dialogue: 0,20:39:13.34,20:39:16.94,Default,,0,0,0,,Сабақ тәтті және жақсы. Өз дағдыларыңызды көрсетіңіз! 》
Dialogue: 0,20:39:27.03,20:39:29.97,Default,,0,0,0,,《Сезімдерімнен жеңілемін бе...》
Dialogue: 0,20:39:29.97,20:39:33.04,Default,,0,0,0,,≪Савамура! ≪Шешіңіз! ≪Ширакава-кун!
Dialogue: 0,20:39:33.04,20:39:36.04,Default,,0,0,0,,《Осы жерден қашып құтыла аламыз ба? 》
Dialogue: 0,20:39:40.53,20:39:46.39,Default,,0,0,0,,Тағы бір нәрсе! (Қыздар) Тағы бір нәрсе!
Dialogue: 0,20:39:46.39,20:39:48.39,Default,,0,0,0,,《Қатаң...》
Dialogue: 0,20:39:50.82,20:39:53.21,Default,,0,0,0,,《Қаттырақ! 》
Dialogue: 0,20:39:53.21,20:39:58.31,Default,,0,0,0,,Тағы бір нәрсе Тағы бір нәрсе!
Dialogue: 0,20:40:01.68,20:40:03.68,Default,,0,0,0,,《Толығырақ…》
Dialogue: 0,20:40:07.54,20:40:09.54,Default,,0,0,0,,《Толығырақ! 》
Dialogue: 0,20:40:53.25,20:40:57.34,Default,,0,0,0,,Хэхехе….
Dialogue: 0,20:40:57.34,20:41:03.31,Default,,0,0,0,,Уау! !
Dialogue: 0,20:41:03.31,20:41:08.50,Default,,0,0,0,,[Майк] Де... Өлі доп! !
Dialogue: 0,20:41:08.50,20:41:22.97,Default,,0,0,0,,♪♪~
Dialogue: 0,20:41:22.97,20:41:26.49,Default,,0,0,0,,[Сөйлеуші] Ширакава басына доптың тиюіне байланысты→
Dialogue: 0,20:41:26.49,20:41:29.69,Default,,0,0,0,,Ол қазір орындыққа оралды және емделуде.
Dialogue: 0,20:41:29.69,20:41:33.13,Default,,0,0,0,,[Спикер] Матч жалғасқанша біраз күтіңіз.
Dialogue: 0,20:41:33.13,20:41:35.46,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,20:41:35.46,20:41:38.35,Default,,0,0,0,,Мен бірден тұрдым, бірақ бұл менің басым болды.
Dialogue: 0,20:41:38.35,20:41:41.47,Default,,0,0,0,,Бұл жағдайда Ширакаваға уақытша сапарға рұқсат етіледі, солай ма?
Dialogue: 0,20:41:41.47,20:41:45.82,Default,,0,0,0,,Аа, алдыңғы бұрылыстағы шабақ жүгірушіге айналады.
Dialogue: 0,20:41:45.82,20:41:49.92,Default,,0,0,0,,Алдыңғы ат-баттағы қамыр... Болды!
Dialogue: 0,20:41:51.96,20:41:53.96,Default,,0,0,0,,Бұл Карлос.
Dialogue: 0,20:41:53.96,20:41:55.96,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,20:41:55.96,20:41:59.02,Default,,0,0,0,,Жарайды, ол менің дулығама қатты тиді.
Dialogue: 0,20:41:59.02,20:42:01.84,Default,,0,0,0,,Әй, бір демалып ал.
Dialogue: 0,20:42:01.84,20:42:05.97,Default,,0,0,0,,《Қорықпайтын жыл деп ойладым→
Dialogue: 0,20:42:05.97,20:42:10.01,Default,,0,0,0,,Сіз қатты қысымды сезінген сияқтысыз.
Dialogue: 0,20:42:10.01,20:42:12.90,Default,,0,0,0,,Ол қысымды сезбейтін сияқты →
Dialogue: 0,20:42:12.90,20:42:17.02,Default,,0,0,0,,Сенің жай ғана ақымақ емес екеніңе қуаныштымын》
Dialogue: 0,20:42:17.02,20:42:19.29,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,20:42:19.29,20:42:22.62,Default,,0,0,0,,Негізді жауып тұрған көп қамыр болды.
Dialogue: 0,20:42:22.62,20:42:24.84,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,20:42:24.84,20:42:28.25,Default,,0,0,0,,Хяхаха! Шабуылдың салдары шығар, уайымдамаңыз!
Dialogue: 0,20:42:28.25,20:42:32.05,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,20:42:34.67,20:42:37.31,Default,,0,0,0,,《Эйджун-кун…》
Dialogue: 0,20:42:37.31,20:42:40.88,Default,,0,0,0,,《Мен жүйрікті жібергеніме өкінбеймін.
Dialogue: 0,20:42:40.88,20:42:43.98,Default,,0,0,0,,Соғудың ең нашар жері》
Dialogue: 0,20:42:48.63,20:42:50.67,Default,,0,0,0,,Каваками!
Dialogue: 0,20:42:50.67,20:43:01.00,Default,,0,0,0,,♪♪~
Dialogue: 0,20:43:01.00,20:43:03.35,Default,,0,0,0,,Савамура.
Dialogue: 0,20:43:03.35,20:43:08.02,Default,,0,0,0,,Соңына дейін қашпай, жақсы шабуыл жасадың.
Dialogue: 0,20:43:08.02,20:43:11.01,Default,,0,0,0,,Мен сізді қатты құрметтеймін.
Dialogue: 0,20:43:11.01,20:43:14.01,Default,,0,0,0,,Сіз жақсы айттыңыз.
Dialogue: 0,20:43:24.00,20:43:26.97,Default,,0,0,0,,《Мықтымын десем де, бар болғаны бір жыл болды.
Dialogue: 0,20:43:26.97,20:43:30.99,Default,,0,0,0,,Оның үстіне, бұл Кошиеннің соңғы иннингі болды.
Dialogue: 0,20:43:30.99,20:43:34.05,Default,,0,0,0,,Қысымды сезінбеу мүмкін емес.
Dialogue: 0,20:43:34.05,20:43:37.05,Default,,0,0,0,,Бұл Савамура болса, мүмкін...》
Dialogue: 0,20:43:40.04,20:43:45.34,Default,,0,0,0,,《Миюки: Біз білмей тұрып, бәрі осылай ойлайтын.》
Dialogue: 0,20:43:47.98,20:43:51.10,Default,,0,0,0,,[Майк] Сейдо орта мектебі Құмыраны осы жерде ауыстырған.
Dialogue: 0,20:43:51.10,20:43:53.70,Default,,0,0,0,,[Майк] 4-ші ойыншы Каваками қорғанға жіберіледі.
Dialogue: 0,20:43:57.97,20:43:59.97,Default,,0,0,0,,《Каваками: Савамура…》
Dialogue: 0,20:44:03.66,20:44:05.66,Default,,0,0,0,,Мен де қашпаймын.
Dialogue: 0,20:44:05.66,20:44:08.66,Default,,0,0,0,,Мен де сен сияқты шабуыл жасаймын.
Dialogue: 0,20:44:28.67,20:44:31.00,Default,,0,0,0,,Савамура! Сіз оны жақсы лақтырдыңыз!
Dialogue: 0,20:44:31.00,20:44:34.34,Default,,0,0,0,,Қалғанын Кавакамиге қалдырыңыз! Уайымдама!
Dialogue: 0,20:44:34.34,20:44:36.68,Default,,0,0,0,,Жарайсың! Сіз үшін!
Dialogue: 0,20:44:36.68,20:44:41.63,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,20:44:41.63,20:44:44.38,Default,,0,0,0,,Савамура….
Dialogue: 0,20:44:44.38,20:44:46.68,Default,,0,0,0,,Әдемі қадам.
Dialogue: 0,20:44:52.36,20:44:54.71,Default,,0,0,0,,Тағы бір шықты.
Dialogue: 0,20:44:54.71,20:44:57.71,Default,,0,0,0,,Каваками оны қатайтсын.
Dialogue: 0,20:44:59.63,20:45:02.35,Default,,0,0,0,,Жарайды соңғы!
Dialogue: 0,20:45:02.35,20:45:04.95,Default,,0,0,0,,《Осы жерден соққы сызығы тазартылады.
Dialogue: 0,20:45:04.95,20:45:09.32,Default,,0,0,0,,Сонымен қатар, Карлос уақытша жүгіруші.
Dialogue: 0,20:45:09.32,20:45:12.66,Default,,0,0,0,,Ойын тағы бір шығумен аяқталады.
Dialogue: 0,20:45:12.66,20:45:17.33,Default,,0,0,0,,Инами мұндай жағдайда ренжітетін команда емес.
Dialogue: 0,20:45:17.33,20:45:21.04,Default,,0,0,0,,Бірақ егер сіз базаны ұрлауды шешсеңіз→
Dialogue: 0,20:45:21.04,20:45:24.34,Default,,0,0,0,,Бір ғана соққымен тең түсу мүмкіндігі бар.
Dialogue: 0,20:45:27.96,20:45:30.33,Default,,0,0,0,,《Үрейленбе.
Dialogue: 0,20:45:30.33,20:45:32.97,Default,,0,0,0,,Бұл бізді бұрылыста ұстап тұрған адам.
Dialogue: 0,20:45:32.97,20:45:35.00,Default,,0,0,0,,Шайқас!
Dialogue: 0,20:45:35.00,20:45:38.00,Default,,0,0,0,,Тек біреуін шығаруға назар аударыңыз.
Dialogue: 0,20:45:38.00,20:45:40.97,Default,,0,0,0,,[Майк] 9-шы иннингтің төменгі бөлігі, 2 шығу, 1-ші негізде жүгіруші.
Dialogue: 0,20:45:40.97,20:45:42.98,Default,,0,0,0,,[Майк] Жарғанатта №3 Йошизава болды.
Dialogue: 0,20:45:42.98,20:45:44.98,Default,,0,0,0,,Ой!
Dialogue: 0,20:45:44.98,20:45:47.66,Default,,0,0,0,,Нори! Осы жерден шешеміз!
Dialogue: 0,20:45:47.66,20:45:50.33,Default,,0,0,0,,Нори! (Канамару) Каваками-сенпай!
Dialogue: 0,20:45:50.33,20:45:53.37,Default,,0,0,0,,Қамырға назар аударыңыз! Оған соғуға рұқсат етіңіз!
Dialogue: 0,20:45:53.37,20:45:55.37,Default,,0,0,0,,Бір адам, бір өлтіру!
Dialogue: 0,20:46:02.68,20:46:04.68,Default,,0,0,0,,Егер қорғасын соншалықты үлкен болса→
Dialogue: 0,20:46:04.68,20:46:07.33,Default,,0,0,0,,Жүгірушілер туралы алаңдайтыныңызға сенімдімін.
Dialogue: 0,20:46:07.33,20:46:11.70,Default,,0,0,0,,А... жарайды, мен оны іске қоса алмаймын.
Dialogue: 0,20:46:11.70,20:46:15.66,Default,,0,0,0,,《Соңында төрт құмыраның бәрі қорғанды ​​алды ма?
Dialogue: 0,20:46:15.66,20:46:20.06,Default,,0,0,0,,Ойынның соңына дейін құмыраны ауыстыру.
Dialogue: 0,20:46:20.06,20:46:22.36,Default,,0,0,0,,Бұл қай жолмен жүреді...》
Dialogue: 0,20:46:25.00,20:46:29.62,Default,,0,0,0,,((Крис: Тыңдаңыз, қиналған кезде позитивті болыңыз.
Dialogue: 0,20:46:29.62,20:46:31.64,Default,,0,0,0,,Екі негіз бос болса →
Dialogue: 0,20:46:31.64,20:46:34.71,Default,,0,0,0,,Екі адамды серуендетіп жіберсеңіз де, үшінші адамды алып кете аласыз.
Dialogue: 0,20:46:34.71,20:46:38.71,Default,,0,0,0,,Басқаша айтқанда, үш ойыншы да біреуін алуы керек))
Dialogue: 0,20:46:40.73,20:46:44.33,Default,,0,0,0,,《Жарайды... мен айналамдағы дауыстарды жақсы естимін》
Dialogue: 0,20:46:46.67,20:46:48.67,Default,,0,0,0,,《Каваками: Өте жақсы ойын...》
Dialogue: 0,20:46:52.71,20:46:56.31,Default,,0,0,0,,《Мен матчқа қатысқым келмейді десем өтірік айтқан болар едім》
Dialogue: 0,20:47:04.64,20:47:07.39,Default,,0,0,0,,《Бір ғана шығу болса да→
Dialogue: 0,20:47:07.39,20:47:09.99,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасағым келеді》
Dialogue: 0,20:47:11.49,20:47:17.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory