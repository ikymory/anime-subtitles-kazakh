Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.12,0:00:36.92,Default,,0,0,0,,Ұпай алудан қалай аулақ бола аламын?
Dialogue: 0,0:00:39.41,0:00:42.40,Default,,0,0,0,,Бір кеңес.
Dialogue: 0,0:00:42.40,0:00:48.00,Default,,0,0,0,,《Миюки: Бұл жігіттің көзі өлген жоқ, оның шегін айтпағанда.》
Dialogue: 0,0:03:33.12,0:03:35.62,Default,,0,0,0,,(Допты соғу дыбысы)
Dialogue: 0,0:03:38.72,0:03:42.11,Default,,0,0,0,,≪Жақсы үй. ≪ Керемет алаң!
Dialogue: 0,0:03:42.11,0:03:44.90,Default,,0,0,0,,《Миюки: Кирюдің эйси Хироми Тейт?
Dialogue: 0,0:03:44.90,0:03:48.05,Default,,0,0,0,,Ойын барысында доптың күші артады.
Dialogue: 0,0:03:48.05,0:03:50.54,Default,,0,0,0,,Егер солай болса, ол өте жақсы құмыра》
Dialogue: 0,0:03:50.54,0:03:53.96,Default,,0,0,0,,《Үй: Тозақ сияқты жүгіру.
Dialogue: 0,0:03:53.96,0:03:56.86,Default,,0,0,0,,Тозақ лақтыру.
Dialogue: 0,0:03:56.86,0:03:59.08,Default,,0,0,0,,Тозақ сияқты салмақ.
Dialogue: 0,0:03:59.08,0:04:04.87,Default,,0,0,0,,Көптеген тозақ жаттығулары...
Dialogue: 0,0:04:04.87,0:04:07.74,Default,,0,0,0,,Барлық нәтижелерді түкіруге қабілетті→
Dialogue: 0,0:04:07.74,0:04:09.87,Default,,0,0,0,,Бұл кезең...
Dialogue: 0,0:04:09.87,0:04:13.69,Default,,0,0,0,,Өйткені ойын қызық! 》
Dialogue: 0,0:04:13.69,0:04:17.40,Default,,0,0,0,,Неге күліп тұрсың! ?
Dialogue: 0,0:04:17.40,0:04:20.25,Default,,0,0,0,,шықты! Үйдің қорқынышты жымиған жүзі.
Dialogue: 0,0:04:20.25,0:04:23.94,Default,,0,0,0,,Ол дәл қазір есінен танып жатыр.
Dialogue: 0,0:04:23.94,0:04:26.04,Default,,0,0,0,,Хэхехе….
Dialogue: 0,0:04:28.24,0:04:30.23,Default,,0,0,0,,≪ Strike Batter out.
Dialogue: 0,0:04:30.23,0:04:33.40,Default,,0,0,0,,Әй, үшеуі де шегінеді.
Dialogue: 0,0:04:33.40,0:04:36.40,Default,,0,0,0,,Иә! Менің кетуден басқа амалым жоқ.
Dialogue: 0,0:04:36.40,0:04:38.40,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:04:40.70,0:04:43.41,Default,,0,0,0,,《Миюки: әзірге эйс және екі RBI бар №4.
Dialogue: 0,0:04:43.41,0:04:47.58,Default,,0,0,0,,Ол шынымен де осы ұжымның тірегі.
Dialogue: 0,0:04:47.58,0:04:49.95,Default,,0,0,0,,Сәлем Фуруя.
Dialogue: 0,0:04:49.95,0:04:51.98,Default,,0,0,0,,Доп лақтырылмай тұрғанда →
Dialogue: 0,0:04:51.98,0:04:55.58,Default,,0,0,0,,Саусақтардың арасында ұстайық дедім.
Dialogue: 0,0:04:55.58,0:04:58.38,Default,,0,0,0,,Соғудың уақыты келді, бірақ лақтырып көріңіз.
Dialogue: 0,0:05:03.78,0:05:05.88,Default,,0,0,0,,Colla Cola….
Dialogue: 0,0:05:15.54,0:05:19.58,Default,,0,0,0,,Төрт доптан бас тарт, бір жасар бала.
Dialogue: 0,0:05:19.58,0:05:25.38,Default,,0,0,0,,《Хаха, бұл жігітке ойын қатты ұнайды》
Dialogue: 0,0:05:25.38,0:05:27.37,Default,,0,0,0,,Хехе….
Dialogue: 0,0:05:27.37,0:05:29.62,Default,,0,0,0,,《Миюки: Бұл өте қорқынышты.
Dialogue: 0,0:05:29.62,0:05:33.62,Default,,0,0,0,,Бірақ менің де осыдан ләззат алатын кез келді.》
Dialogue: 0,0:05:36.38,0:05:39.48,Default,,0,0,0,,《Уайымдама, мен сені ешқашан шайқамаймын》
Dialogue: 0,0:05:44.23,0:05:46.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:50.52,0:05:52.74,Default,,0,0,0,,
Dialogue: 0,0:05:52.74,0:05:55.13,Default,,0,0,0,,≪Ереуіл!
Dialogue: 0,0:05:55.13,0:05:58.03,Default,,0,0,0,,Ей, қанша соққы болса да →
Dialogue: 0,0:05:58.03,0:06:00.88,Default,,0,0,0,,Баяу доп жоқ.
Dialogue: 0,0:06:00.88,0:06:05.18,Default,,0,0,0,,Ол бәрібір екі соққыға теңселмейді.
Dialogue: 0,0:06:07.44,0:06:09.94,Default,,0,0,0,,《Бұл жігіт...》
Dialogue: 0,0:06:14.55,0:06:18.85,Default,,0,0,0,,《Мацумото: Камахен Бучикатаре》
Dialogue: 0,0:06:21.25,0:06:23.91,Default,,0,0,0,,《Бұл адам ұжымның тірегі→
Dialogue: 0,0:06:23.91,0:06:26.26,Default,,0,0,0,,Мен міндетті түрде шығып кеткім келеді.
Dialogue: 0,0:06:26.26,0:06:29.83,Default,,0,0,0,,Бұл шанышқы жай ғана шоу шары.
Dialogue: 0,0:06:29.83,0:06:33.90,Default,,0,0,0,,Осы аймақты басып, матчтың ағынын өзгерту үшін күшіңізді пайдаланыңыз! 》
Dialogue: 0,0:06:33.90,0:06:41.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:41.11,0:06:43.11,Default,,0,0,0,,《Кел, кел, кел, кел...》
Dialogue: 0,0:06:45.69,0:06:47.73,Default,,0,0,0,,《Тура! 》
Dialogue: 0,0:06:47.73,0:06:49.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:06.03,0:07:10.10,Default,,0,0,0,,Бұл не доп?
Dialogue: 0,0:07:10.10,0:07:12.40,Default,,0,0,0,,Түзу... батып кетті ме?
Dialogue: 0,0:07:12.40,0:07:17.06,Default,,0,0,0,,Түсінбедім... Бірақ Миюки бұрылып кеткенде →
Dialogue: 0,0:07:17.06,0:07:19.08,Default,,0,0,0,,Мен оны бірінші рет көрдім!
Dialogue: 0,0:07:19.08,0:07:21.03,Default,,0,0,0,,Ха ха ха ха.
Dialogue: 0,0:07:21.03,0:07:24.73,Default,,0,0,0,,《Күтілгендей, сіз мұны бірінші көзқараста ұстай алмайсыз.
Dialogue: 0,0:07:24.73,0:07:26.74,Default,,0,0,0,,Жылдам болғанымен→
Dialogue: 0,0:07:26.74,0:07:30.14,Default,,0,0,0,,Қамырдың қолында өзгеруге бейім.
Dialogue: 0,0:07:30.14,0:07:33.76,Default,,0,0,0,,Шанышқыдан гөрі сол шарға көбірек ұқсайды ма?
Dialogue: 0,0:07:33.76,0:07:40.10,Default,,0,0,0,,Бөлінген саусақты фастбол 20 ғасырдағы соңғы сиқырлы доп болды.
Dialogue: 0,0:07:40.10,0:07:45.70,Default,,0,0,0,,Әлгі бейбақ... сырғып кетеді деп қорқып, оны терең итермедің ғой, солай ма? 》
Dialogue: 0,0:07:47.69,0:07:51.41,Default,,0,0,0,,《Бірақ... бұл қуанышты қате есептеу.
Dialogue: 0,0:07:51.41,0:07:56.83,Default,,0,0,0,,Күткендей, бұл адамның күлкісі жоғалып кетті.
Dialogue: 0,0:07:56.83,0:07:59.07,Default,,0,0,0,,Жоқ, Миюкидің жігіті→
Dialogue: 0,0:07:59.07,0:08:02.74,Default,,0,0,0,,Нақты кездесу кезінде сіз оған қисық допты лақтыруға рұқсат бердіңіз бе? ?
Dialogue: 0,0:08:02.74,0:08:06.69,Default,,0,0,0,,Мүмкін солай шығар, өйткені Миюки оны ұстай алмайды.
Dialogue: 0,0:08:06.69,0:08:10.75,Default,,0,0,0,,Бұл ақылсыз! Ол не ойлап отыр?
Dialogue: 0,0:08:10.75,0:08:15.80,Default,,0,0,0,,《Крис: Мүлдем... Бірінен соң бірі қатты нәрсе.
Dialogue: 0,0:08:15.80,0:08:19.41,Default,,0,0,0,,Нақты ұрыста бақылаудың маңыздылығын біліңіз→
Dialogue: 0,0:08:19.41,0:08:21.42,Default,,0,0,0,,Оның үстіне Фуруяның күші→
Dialogue: 0,0:08:21.42,0:08:24.44,Default,,0,0,0,,Сіз одан барынша пайда алуға тырысып жатырсыз.
Dialogue: 0,0:08:24.44,0:08:29.37,Default,,0,0,0,,Миюки жаттығу матчының мағынасын толық түсінеді》
Dialogue: 0,0:08:29.37,0:08:31.38,Default,,0,0,0,,《Әзірше қамыр ренжісе→
Dialogue: 0,0:08:31.38,0:08:34.12,Default,,0,0,0,,Қалғаны оңай.
Dialogue: 0,0:08:34.12,0:08:37.42,Default,,0,0,0,,Өзіңіздің сүйікті допыңызбен төмен түсіңіз! 》
Dialogue: 0,0:08:44.40,0:08:46.77,Default,,0,0,0,,《Крис: Толқын өзгерді! 》
Dialogue: 0,0:08:46.77,0:08:49.08,Default,,0,0,0,,Керемет! (Сақай) Жақсы доп.
Dialogue: 0,0:08:49.08,0:08:51.42,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:51.42,0:08:53.46,Default,,0,0,0,,Бұл күннің ең жақсы добы болды.
Dialogue: 0,0:08:53.46,0:08:56.08,Default,,0,0,0,,Сенде осындай доп болса, неге лақтырмасқа!
Dialogue: 0,0:08:56.08,0:08:58.69,Default,,0,0,0,,Жомарт болма!
Dialogue: 0,0:08:58.69,0:09:02.45,Default,,0,0,0,,Жақсы шығарма. (Курамочи) Сен істейсің, бейбақ!
Dialogue: 0,0:09:02.45,0:09:04.45,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:07.04,0:09:10.09,Default,,0,0,0,,《Бұл қалай сезінеді?
Dialogue: 0,0:09:10.09,0:09:13.44,Default,,0,0,0,,Достарыңыздың шын жүректен көрсеткен қолдауы қандай?
Dialogue: 0,0:09:13.44,0:09:17.70,Default,,0,0,0,,Теріңді төге аласың ба, жоқ па, енді өзіңе байланысты.
Dialogue: 0,0:09:17.70,0:09:19.73,Default,,0,0,0,,Иә, лақтыр!
Dialogue: 0,0:09:19.73,0:09:22.70,Default,,0,0,0,,Ах... Хаха, сіз қарапайым адам емессіз ғой →
Dialogue: 0,0:09:22.70,0:09:28.07,Default,,0,0,0,,Фуруя-кун... Мен мұндай шанышқыны бұрын-соңды көрген емеспін.
Dialogue: 0,0:09:28.07,0:09:31.69,Default,,0,0,0,,Бір жыл бойы біреуге қатты қызықпа.
Dialogue: 0,0:09:31.69,0:09:37.43,Default,,0,0,0,,Сен біздің эйссің, ертең дәлелде.
Dialogue: 0,0:09:37.43,0:09:41.03,Default,,0,0,0,,Хмм. 《Тамба: Мияучи…》
Dialogue: 0,0:09:44.04,0:09:47.03,Default,,0,0,0,,Әй, өмірге қайта оралдың!
Dialogue: 0,0:09:47.03,0:09:49.04,Default,,0,0,0,,Бұл эпизод тамаша болды!
Dialogue: 0,0:09:49.04,0:09:51.03,Default,,0,0,0,,《Мен...
Dialogue: 0,0:09:51.03,0:09:53.40,Default,,0,0,0,,Катаока-хан неге саған ғашық болады?
Dialogue: 0,0:09:53.40,0:09:56.77,Default,,0,0,0,,Ол біріншіден мүлдем басқа адам.
Dialogue: 0,0:09:56.77,0:10:02.36,Default,,0,0,0,,Бұл кісі шынымен де солай ма?
Dialogue: 0,0:10:02.36,0:10:04.41,Default,,0,0,0,,《Бұл жігіт бәрібір керемет》
Dialogue: 0,0:10:04.41,0:10:06.70,Default,,0,0,0,,Савамура.
Dialogue: 0,0:10:06.70,0:10:09.10,Default,,0,0,0,,Фуруяның жарғанатты кезегі аяқталғанда, сіз келесідесіз.
Dialogue: 0,0:10:09.10,0:10:11.37,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:10:11.37,0:10:15.09,Default,,0,0,0,,бұл... Иә! Дегенмен оны ауыстырудың қажеті жоқ.
Dialogue: 0,0:10:15.09,0:10:18.44,Default,,0,0,0,,Шулы! Бұл ақылсыз болса да!
Dialogue: 0,0:10:18.44,0:10:22.06,Default,,0,0,0,,Тез шығыңыз!
Dialogue: 0,0:10:22.06,0:10:24.75,Default,,0,0,0,,《Қарғыс атсын. Әзірше тынышталыңыз.
Dialogue: 0,0:10:24.75,0:10:27.12,Default,,0,0,0,,Бұл оның бірінші командада бірінші рет шығуы.
Dialogue: 0,0:10:27.12,0:10:29.10,Default,,0,0,0,,Сіз оны ешқашан шатастыра алмайсыз.
Dialogue: 0,0:10:29.10,0:10:32.10,Default,,0,0,0,,Ол ақырында командадағы алғашқы дебютін жасайды. Уф! ?
Dialogue: 0,0:10:34.41,0:10:37.41,Default,,0,0,0,,Ей, сенде біртүрлі өрнек бар.
Dialogue: 0,0:10:37.41,0:10:39.45,Default,,0,0,0,,Сіз қобалжыған шығарсыз?
Dialogue: 0,0:10:39.45,0:10:41.45,Default,,0,0,0,,Ба... сен ақымақ!
Dialogue: 0,0:10:50.36,0:10:52.37,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:10:52.37,0:10:54.36,Default,,0,0,0,,≪Уау, осында!
Dialogue: 0,0:10:54.36,0:10:57.80,Default,,0,0,0,,≪Қандай алыс атылды. Ол орталықтың артындағы допқа тиді.
Dialogue: 0,0:10:57.80,0:10:59.73,Default,,0,0,0,,Хо... үйге жүгіру!
Dialogue: 0,0:10:59.73,0:11:04.17,Default,,0,0,0,,Хаха, әлгі бейбақ шығып кетіп, ренжіді→
Dialogue: 0,0:11:04.17,0:11:06.17,Default,,0,0,0,,Аяқтау соққысы.
Dialogue: 0,0:11:08.41,0:11:11.38,Default,,0,0,0,,Холл!
Dialogue: 0,0:11:11.38,0:11:14.06,Default,,0,0,0,,Бұл бүкіл ел бойынша.
Dialogue: 0,0:11:14.06,0:11:17.45,Default,,0,0,0,,Әлемде әлі де қызықты адамдар бар.
Dialogue: 0,0:11:17.45,0:11:20.07,Default,,0,0,0,,Менің ойымша, сіз экспедицияға келгеніңізге қуаныштысыз, солай ма?
Dialogue: 0,0:11:20.07,0:11:22.04,Default,,0,0,0,,Дұрыс, сарай!
Dialogue: 0,0:11:22.04,0:11:25.09,Default,,0,0,0,,Дәл осы біз күткен даму емес пе?
Dialogue: 0,0:11:25.09,0:11:27.73,Default,,0,0,0,,Оны өз жолыңызға лақтырыңыз.
Dialogue: 0,0:11:27.73,0:11:29.73,Default,,0,0,0,,Көңілді болайық!
Dialogue: 0,0:11:29.73,0:11:33.40,Default,,0,0,0,,Мына жігіттердің бәрі айтыңдар!
Dialogue: 0,0:11:33.40,0:11:38.39,Default,,0,0,0,,≪Тэйт-сенпай! Бұл күлкі өте әдемі!
Dialogue: 0,0:11:38.39,0:11:41.07,Default,,0,0,0,,...
Dialogue: 0,0:11:41.07,0:11:46.04,Default,,0,0,0,,Сіз бір дауыспен ойыншыны орнынан тұрғыздыңыз ба?
Dialogue: 0,0:11:46.04,0:11:49.40,Default,,0,0,0,,Сонша қыңыр болма, Савамура.
Dialogue: 0,0:11:49.40,0:11:51.40,Default,,0,0,0,,Ондай болма!
Dialogue: 0,0:11:51.40,0:11:53.37,Default,,0,0,0,,Бұл арам сөз...
Dialogue: 0,0:11:53.37,0:11:56.69,Default,,0,0,0,,Маған сіздің дауысыңызды тексеруге рұқсат етіңіз, содан кейін оны бір сәтке алуға рұқсат етіңіз.
Dialogue: 0,0:11:56.69,0:11:58.74,Default,,0,0,0,,Ой... жұқа!
Dialogue: 0,0:11:58.74,0:12:04.74,Default,,0,0,0,,Бірақ... содан бері мен сізбен батарея ретінде бірінші рет бірігіп отырмын.
Dialogue: 0,0:12:07.80,0:12:12.10,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:12:16.02,0:12:21.03,Default,,0,0,0,,《Ол сенімді жүзге не бар...?
Dialogue: 0,0:12:21.03,0:12:25.03,Default,,0,0,0,,Менің ойымша, бұл сіздің алғашқы әсеріңіз болды》
Dialogue: 0,0:12:25.03,0:12:27.74,Default,,0,0,0,,...
Dialogue: 0,0:12:27.74,0:12:31.07,Default,,0,0,0,,Доптардың бәрі биік, сондықтан бұл ойын емес.
Dialogue: 0,0:12:31.07,0:12:33.41,Default,,0,0,0,,→
Dialogue: 0,0:12:33.41,0:12:36.75,Default,,0,0,0,,Менің қолым бұрынғыдан кеш шығып жатыр.
Dialogue: 0,0:12:36.75,0:12:39.08,Default,,0,0,0,,→
Dialogue: 0,0:12:39.08,0:12:42.40,Default,,0,0,0,,Оны жерге ұрғандай лақтырып көріңіз.
Dialogue: 0,0:12:42.40,0:12:44.40,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:12:44.40,0:12:48.37,Default,,0,0,0,,《   》
Dialogue: 0,0:12:48.37,0:12:51.37,Default,,0,0,0,,О? Кезектесіп жатырсыз ба?
Dialogue: 0,0:12:55.48,0:12:58.08,Default,,0,0,0,,Қане, көңіл көтерейік.
Dialogue: 0,0:14:30.08,0:14:33.05,Default,,0,0,0,,Ойыншыларды ауыстырыңыз.
Dialogue: 0,0:14:33.05,0:14:36.68,Default,,0,0,0,,...
Dialogue: 0,0:14:36.68,0:14:38.72,Default,,0,0,0,,Әй! ?
Dialogue: 0,0:14:38.72,0:14:43.12,Default,,0,0,0,,《  》
Dialogue: 0,0:14:43.12,0:14:47.08,Default,,0,0,0,,...
Dialogue: 0,0:14:47.08,0:14:50.08,Default,,0,0,0,,...
Dialogue: 0,0:14:50.08,0:14:52.50,Default,,0,0,0,,Осыны ескере отырып, қорғанысқа өтіңіз.
Dialogue: 0,0:14:52.50,0:14:55.07,Default,,0,0,0,,Сол жақ….
Dialogue: 0,0:14:55.07,0:14:58.69,Default,,0,0,0,,《 →
Dialogue: 0,0:14:58.69,0:15:02.41,Default,,0,0,0,,→
Dialogue: 0,0:15:02.41,0:15:06.95,Default,,0,0,0,,…》
Dialogue: 0,0:15:06.95,0:15:09.75,Default,,0,0,0,,Савамура: Сен... Ха, иә!
Dialogue: 0,0:15:14.97,0:15:18.36,Default,,0,0,0,,Бар күшіңізді салып, лақтырыңыз. Міне бітті! ?
Dialogue: 0,0:15:18.36,0:15:21.41,Default,,0,0,0,,Хяхаха! Күтулер төмен! Ана жерде! !
Dialogue: 0,0:15:21.41,0:15:23.90,Default,,0,0,0,,Айтпа! !
Dialogue: 0,0:15:23.90,0:15:28.25,Default,,0,0,0,,...
Dialogue: 0,0:15:28.25,0:15:31.74,Default,,0,0,0,,...
Dialogue: 0,0:15:31.74,0:15:35.74,Default,,0,0,0,,...
Dialogue: 0,0:15:38.24,0:15:41.90,Default,,0,0,0,,Енді барайық.
Dialogue: 0,0:15:41.90,0:15:44.75,Default,,0,0,0,,Тынш! !
Dialogue: 0,0:15:44.75,0:15:48.17,Default,,0,0,0,,...
Dialogue: 0,0:15:48.17,0:15:50.77,Default,,0,0,0,,Хяхаха! Мен кенеттен шайнап жатырмын.
Dialogue: 0,0:15:54.91,0:15:58.06,Default,,0,0,0,,((Жазғы финалдарда да осындай кездесулер болады.
Dialogue: 0,0:15:58.06,0:16:01.55,Default,,0,0,0,,Осыны ескере отырып, қорғанысқа көшіңіз))
Dialogue: 0,0:16:01.55,0:16:04.24,Default,,0,0,0,,《Фуруя: мен сені кез келген уақытта ауыстыра аламын...》
Dialogue: 0,0:16:04.24,0:16:07.41,Default,,0,0,0,,《Сен істейсің, Катаока-хан….
Dialogue: 0,0:16:07.41,0:16:12.81,Default,,0,0,0,,Біз бірінші курс құмырасының тәжірибе серіктесіміз.》
Dialogue: 0,0:16:12.81,0:16:15.45,Default,,0,0,0,,Ойна!
Dialogue: 0,0:16:15.45,0:16:19.05,Default,,0,0,0,,《Накай: Қандай алаңды лақтырсам да, бірінші қадамнан бастаймын...》
Dialogue: 0,0:16:21.74,0:16:24.24,Default,,0,0,0,,《Кел! 》
Dialogue: 0,0:16:24.24,0:16:31.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:31.53,0:16:34.07,Default,,0,0,0,,《Жерде→
Dialogue: 0,0:16:34.07,0:16:38.47,Default,,0,0,0,,Шабу! 》
Dialogue: 0,0:16:38.47,0:16:40.54,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:16:40.54,0:16:45.24,Default,,0,0,0,,《Cola cora... Осы тәтті допты өткізіп алсам не істеуім керек? 》
Dialogue: 0,0:16:45.24,0:16:48.45,Default,,0,0,0,,《Не болды...
Dialogue: 0,0:16:48.45,0:16:53.95,Default,,0,0,0,,Бұл жігіттің пішінімен мен доптың қайдан шыққанын көре алмадым...》
Dialogue: 0,0:17:01.86,0:17:04.58,Default,,0,0,0,,((Катаока: Миюки. Иә.
Dialogue: 0,0:17:04.58,0:17:08.53,Default,,0,0,0,,Ертеңгі ойынға жетекшілік етуді сізге қалдырамын.
Dialogue: 0,0:17:08.53,0:17:13.05,Default,,0,0,0,,Қозғалыстың әлсіздігі - ет ұшы кең металл жарғанақ.
Dialogue: 0,0:17:13.05,0:17:17.53,Default,,0,0,0,,Егер Кирю өзінің күшті соққылар тобымен мақтанса, Савамураның күшін қалай өлшеуге болады →
Dialogue: 0,0:17:17.53,0:17:20.58,Default,,0,0,0,,Ол тамаша сәйкестік болар еді.
Dialogue: 0,0:17:20.58,0:17:23.70,Default,,0,0,0,,Тәтті допты көздегенің мүлдем маңызды емес.
Dialogue: 0,0:17:23.70,0:17:26.05,Default,,0,0,0,,Басқа адамға қимыл жасауға мүмкіндік беріңіз.
Dialogue: 0,0:17:26.05,0:17:30.04,Default,,0,0,0,,Хаха, керісінше, қиын.
Dialogue: 0,0:17:30.04,0:17:35.34,Default,,0,0,0,,Бірақ бұл ұлттық деңгейде Кирю үшін жұмыс істесе...
Dialogue: 0,0:17:39.23,0:17:41.90,Default,,0,0,0,,Осымен.
Dialogue: 0,0:17:41.90,0:17:46.40,Default,,0,0,0,,Ертеңгі питчингке байланысты, мен оны осы жазда қолданамын ба, жоқ па →
Dialogue: 0,0:17:46.40,0:17:49.09,Default,,0,0,0,,Бағалау))
Dialogue: 0,0:17:49.09,0:17:53.39,Default,,0,0,0,,《Қазір, содан кейін сезіну...》
Dialogue: 0,0:17:57.05,0:17:59.73,Default,,0,0,0,,《Хахаха…》
Dialogue: 0,0:17:59.73,0:18:03.37,Default,,0,0,0,,《Ереуіл алды деп қуанатын уақыт емес.''
Dialogue: 0,0:18:03.37,0:18:05.69,Default,,0,0,0,,Савамура.
Dialogue: 0,0:18:05.69,0:18:12.25,Default,,0,0,0,,Бұл бірінші команда үшін соңғы емтихан.
Dialogue: 0,0:18:12.25,0:18:16.05,Default,,0,0,0,,《Оны жерге қағып! 》
Dialogue: 0,0:18:20.07,0:18:23.58,Default,,0,0,0,,《Қарғыс атсын... Әлі кешіктің! ? 》
Dialogue: 0,0:18:23.58,0:18:27.75,Default,,0,0,0,,Жарайсыңдар! Мен түсіремін!
Dialogue: 0,0:18:27.75,0:18:29.73,Default,,0,0,0,,《Е! ? 》
Dialogue: 0,0:18:29.73,0:18:32.13,Default,,0,0,0,,Жарайды, жарықтың алдынан ұр.
Dialogue: 0,0:18:32.13,0:18:36.04,Default,,0,0,0,,Жалғастыр, Мұрат! (Мұрата) Оши!
Dialogue: 0,0:18:36.04,0:18:39.52,Default,,0,0,0,,《Мен жеңдім деп ойладым...》
Dialogue: 0,0:18:39.52,0:18:41.53,Default,,0,0,0,,《Доп жоғары.
Dialogue: 0,0:18:41.53,0:18:45.28,Default,,0,0,0,,Тәтті курс алсаң, зорлықпен алып кетеді.
Dialogue: 0,0:18:45.28,0:18:49.78,Default,,0,0,0,,《Сау бол, Мұрат. Доп мен күткеннен де күшті》
Dialogue: 0,0:18:56.31,0:19:01.91,Default,,0,0,0,,《Сені оған Крис-сенпай ұрды, солай ма? Бұл жақсы мүмкіндік, сондықтан оны көріңіз.
Dialogue: 0,0:19:01.91,0:19:04.18,Default,,0,0,0,,《А...》
Dialogue: 0,0:19:04.18,0:19:11.91,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:11.91,0:19:14.88,Default,,0,0,0,,《Оңтүстікпін десең де, қарсыласың бір жаста ғана.
Dialogue: 0,0:19:14.88,0:19:18.03,Default,,0,0,0,,Мүмкіндік болса, келуге болады.
Dialogue: 0,0:19:18.03,0:19:26.91,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:26.91,0:19:29.88,Default,,0,0,0,,《Менің аяғым ішінде, мен бара аламын》
Dialogue: 0,0:19:29.88,0:19:33.19,Default,,0,0,0,,Вахахаха! Бұл мені ұстады!
Dialogue: 0,0:19:33.19,0:19:35.90,Default,,0,0,0,,Е! ?
Dialogue: 0,0:19:35.90,0:19:41.20,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл Крис ағаның бірінші базаны басқаруды тікелей үйретуі!
Dialogue: 0,0:19:47.44,0:19:49.38,Default,,0,0,0,,Жоқ! Екінші базадағы жүгіруші!
Dialogue: 0,0:19:49.38,0:19:51.58,Default,,0,0,0,,Иә! ? Неліктен?
Dialogue: 0,0:19:51.58,0:19:55.73,Default,,0,0,0,,Бұл тамаша тоқтады, ал қозғалыстар тізбегі тамаша болған болуы керек ...
Dialogue: 0,0:19:55.73,0:19:59.62,Default,,0,0,0,,Оның аяқтары толығымен айқастырылған. Кім көрсе де, бұл балк.
Dialogue: 0,0:19:59.62,0:20:01.66,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:20:01.66,0:20:05.06,Default,,0,0,0,,Эй, эй, сен сол бір жылды қалай тексеру керектігін білмейсің бе?
Dialogue: 0,0:20:05.06,0:20:09.53,Default,,0,0,0,,《Крис-сенпайдың бетіне балшық жағып алдым...》
Dialogue: 0,0:20:09.53,0:20:12.73,Default,,0,0,0,,Кешіріңіз, менің есте сақтау қабілетім нашар.
Dialogue: 0,0:20:12.73,0:20:15.19,Default,,0,0,0,,А, мен білемін.
Dialogue: 0,0:20:15.19,0:20:19.57,Default,,0,0,0,,《Хахаха, көңілін қалдырмайтын адам》
Dialogue: 0,0:20:19.57,0:20:23.21,Default,,0,0,0,,Савамура.
Dialogue: 0,0:20:23.21,0:20:26.36,Default,,0,0,0,,Оны ауыстырыңыз. Мен қамырға назар аударамын.
Dialogue: 0,0:20:26.36,0:20:29.90,Default,,0,0,0,,《Сонымен қатар курста》
Dialogue: 0,0:20:29.90,0:20:33.54,Default,,0,0,0,,《Тәтті шарды күшпен алып кетеді.
Dialogue: 0,0:20:33.54,0:20:38.06,Default,,0,0,0,,Төмен курс Оны осында лақтырып көріңіз》
Dialogue: 0,0:20:38.06,0:20:44.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:44.88,0:20:48.75,Default,,0,0,0,,《Жоқ... доп тағы да тым жоғары》
Dialogue: 0,0:20:48.75,0:20:51.31,Default,,0,0,0,,《Не... Мына жігіттің добы қандай?
Dialogue: 0,0:20:51.31,0:20:53.81,Default,,0,0,0,,Мен дереккөзді мүлдем көре алмадым》
Dialogue: 0,0:20:56.19,0:20:58.41,Default,,0,0,0,,《Осында》
Dialogue: 0,0:20:58.41,0:21:01.80,Default,,0,0,0,,《Миюкидің жігіті, сіз курсқа толығымен шабуыл жасайсыз ба?
Dialogue: 0,0:21:01.80,0:21:05.40,Default,,0,0,0,,Өзіңді бір жерге тастау үшін батылдық керек.
Dialogue: 0,0:21:05.40,0:21:08.07,Default,,0,0,0,,Савамура үшін тұрақсыз басқару →
Dialogue: 0,0:21:08.07,0:21:10.87,Default,,0,0,0,,Бұл екі есе қысымды курс.》
Dialogue: 0,0:21:15.06,0:21:17.07,Default,,0,0,0,,《Әлі тәтті! 》
Dialogue: 0,0:21:17.07,0:21:19.10,Default,,0,0,0,,Қысқа!
Dialogue: 0,0:21:19.10,0:21:21.24,Default,,0,0,0,,《Енді қандай жауап...》
Dialogue: 0,0:21:21.24,0:21:23.69,Default,,0,0,0,,Цк, ең жағымсыз хит!
Dialogue: 0,0:21:23.69,0:21:25.77,Default,,0,0,0,,≪О, мен оны лақтыра алмаймын!
Dialogue: 0,0:21:25.77,0:21:27.78,Default,,0,0,0,,≪Осыдан ешбір шығу жоқ. Бірінші және үшінші негіз.
Dialogue: 0,0:21:27.78,0:21:30.41,Default,,0,0,0,,≪Мына құмыра кенет шымшып қалған жоқ па?
Dialogue: 0,0:21:30.41,0:21:32.43,Default,,0,0,0,,≪Бозарып кеткен сияқтысың.
Dialogue: 0,0:21:32.43,0:21:34.70,Default,,0,0,0,,≪Мен балк ауырады деп ойладым!
Dialogue: 0,0:21:34.70,0:21:39.15,Default,,0,0,0,,А... ол жерде жоқ. Бұл хит болды!
Dialogue: 0,0:21:39.15,0:21:41.04,Default,,0,0,0,,Соққыға өзгеріс жоқ.
Dialogue: 0,0:21:41.04,0:21:43.02,Default,,0,0,0,,Өйткені сіз әрқашан жарғанатты тербетесіз→
Dialogue: 0,0:21:43.02,0:21:45.06,Default,,0,0,0,,Сол жерге ұшыңыз.
Dialogue: 0,0:21:45.06,0:21:50.05,Default,,0,0,0,,《Ұпай жинауды жалғастырамыз ба, әлде шыдаймыз ба?
Dialogue: 0,0:21:50.05,0:21:52.90,Default,,0,0,0,,Бұл сіздің шынайы құндылығыңыз сыналатын сахна...》
Dialogue: 0,0:21:52.90,0:21:55.75,Default,,0,0,0,,Қамқорларға назар аударайық, Савамура.
Dialogue: 0,0:21:55.75,0:21:58.39,Default,,0,0,0,,Соғып алайын, үйде өлтіремін! !
Dialogue: 0,0:21:58.39,0:22:01.08,Default,,0,0,0,,Мен ереуіл күтпеймін.
Dialogue: 0,0:22:01.08,0:22:04.06,Default,,0,0,0,,Иә, өтінемін! !
Dialogue: 0,0:22:04.06,0:22:07.66,Default,,0,0,0,,Өте сыпайы. Менен басқа...
Dialogue: 0,0:22:10.40,0:22:13.86,Default,,0,0,0,,《Мацумото: Ішкі алаң – бір нүктеге дайындалған аралық қорғаныс...
Dialogue: 0,0:22:13.86,0:22:17.74,Default,,0,0,0,,Ал, мен басқа жақтан кем дегенде біреуін көргім келеді.
Dialogue: 0,0:22:17.74,0:22:22.15,Default,,0,0,0,,Бірінші жүгіруші Мұрата бірінші алаңнан шығады.
Dialogue: 0,0:22:22.15,0:22:26.75,Default,,0,0,0,,Егер сізге тәтті шымылдық келсе, Асано соғуы керек.
Dialogue: 0,0:22:26.75,0:22:30.57,Default,,0,0,0,,Үшінші негізгі жүгіруші Накай жағдайға байланысты оралуы мүмкін.
Dialogue: 0,0:22:30.57,0:22:34.98,Default,,0,0,0,,Қарсы тұрған құмыраны сол балк анық шайқады.
Dialogue: 0,0:22:34.98,0:22:38.08,Default,,0,0,0,,Мен сізге тынышталуға уақыт бермеймін.
Dialogue: 0,0:22:43.40,0:22:46.87,Default,,0,0,0,,《Жүгіріп жатырсың ба? Сіз жүгіре аласыз ба? 》
Dialogue: 0,0:22:46.87,0:22:50.89,Default,,0,0,0,,《Тыныштал, Эйджун-кун...》
Dialogue: 0,0:22:50.89,0:22:52.88,Default,,0,0,0,,((Крис: Тыңда, Савамура.
Dialogue: 0,0:22:52.88,0:22:56.43,Default,,0,0,0,,Тексерудің мақсаты шығу емес.
Dialogue: 0,0:22:56.43,0:22:58.73,Default,,0,0,0,,Жүйріктің үлкен алға шығуына жол бермеу →
Dialogue: 0,0:22:58.73,0:23:01.40,Default,,0,0,0,,Бұл сізге жақсы бастауға көмектесу үшін бар.
Dialogue: 0,0:23:01.40,0:23:04.57,Default,,0,0,0,,Бірінші негізде жүгірушіге қараған оңтүстік табан...))
Dialogue: 0,0:23:04.57,0:23:07.56,Default,,0,0,0,,《Бірінші көзқарас》
Dialogue: 0,0:23:07.56,0:23:10.86,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:23:10.86,0:23:14.72,Default,,0,0,0,,《Тексеремін деген желеумен...》
Dialogue: 0,0:23:14.72,0:23:16.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:16.75,0:23:18.82,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:23:18.82,0:23:20.82,Default,,0,0,0,,《Тәтті! 》
Dialogue: 0,0:23:22.72,0:23:24.72,Default,,0,0,0,,《Кеттік! 》
Dialogue: 0,0:23:38.07,0:23:42.03,Default,,0,0,0,,《Аа... Қолғаптағы доп...
Dialogue: 0,0:23:42.03,0:23:48.42,Default,,0,0,0,,Ол тұтқынға түсті... Иә? Осыдан кейін... не істеуім керек...
Dialogue: 0,0:23:48.42,0:23:51.09,Default,,0,0,0,,Дұрыс, Үшінші жүгіруші! ! 》
Dialogue: 0,0:23:51.09,0:23:54.19,Default,,0,0,0,,Савамура доп екінші, сіз оны ала аласыз! !
Dialogue: 0,0:23:58.23,0:24:00.21,Default,,0,0,0,,Хаха!
Dialogue: 0,0:24:00.21,0:24:02.23,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:24:02.23,0:24:04.23,Default,,0,0,0,,≪Ей, түсін! !
Dialogue: 0,0:24:04.23,0:24:06.20,Default,,0,0,0,,≪Үшінші жүгіруші қозғала алмады.
Dialogue: 0,0:24:06.20,0:24:09.09,Default,,0,0,0,,≪Соны істеу керек, әлгі жігіт Савамура шақырды.
Dialogue: 0,0:24:09.09,0:24:12.46,Default,,0,0,0,,Хяхахаха... Тез есіңе түсірдің бе?
Dialogue: 0,0:24:12.46,0:24:14.73,Default,,0,0,0,,Өте ыстық болды.
Dialogue: 0,0:24:14.73,0:24:18.11,Default,,0,0,0,,Ха, мұның бәрі Крис-сенпайдың ілімі. Міне, барасың.
Dialogue: 0,0:24:18.11,0:24:21.73,Default,,0,0,0,,《Ол дәл ортасында таяқша болды》
Dialogue: 0,0:24:21.73,0:24:26.40,Default,,0,0,0,,《Не... мына құмыра не болып жатыр...?
Dialogue: 0,0:24:26.40,0:24:30.06,Default,,0,0,0,,Басқара алмасаң да, жылдам допты лақтыра алмайсың! ! 》
Dialogue: 0,0:24:30.06,0:24:34.08,Default,,0,0,0,,Немесе... Директор: Сіздің шынайы болмысыңыз көрініп тұр! !
Dialogue: 0,0:24:34.08,0:24:39.23,Default,,0,0,0,,《Мен үшінші негізде жүгірушінің болғанын ұмытпадым, бұл тексеру...
Dialogue: 0,0:24:39.23,0:24:42.87,Default,,0,0,0,,Менің ойымша, бұл бейсаналық, бірақ бұл Савамураның тамаша пьесасы...》
Dialogue: 0,0:24:42.87,0:24:46.41,Default,,0,0,0,,《Хехехе... Мен бұл жігіт темпераменттірек болады деп ойладым →
Dialogue: 0,0:24:46.41,0:24:48.39,Default,,0,0,0,,Сіз таңқаларлық сабырлысыз, солай емес пе?
Dialogue: 0,0:24:48.39,0:24:51.58,Default,,0,0,0,,Мүмкін, мен әрқашан әлсіз командамен күресіп жүргендіктен шығар→
Dialogue: 0,0:24:51.58,0:24:53.57,Default,,0,0,0,,Сіз шымшуға үйрендіңіз бе? 》
Dialogue: 0,0:24:53.57,0:24:57.05,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:57.05,0:25:01.24,Default,,0,0,0,,《Миюки: Таку, менің атым Савамура, менің атым Фуруя, бұл балалар шынымен...
Dialogue: 0,0:25:01.24,0:25:03.21,Default,,0,0,0,,Бұл сізді қызықтырады》
Dialogue: 0,0:25:03.21,0:25:10.13,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:10.13,0:25:14.13,Default,,0,0,0,,Саған қатты соғуға рұқсат бергенің үшін көп рахмет!
Dialogue: 0,0:25:15.63,0:25:21.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory