Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,21:11:27.12,21:11:29.12,Default,,0,0,0,,Кеттік! Шайқау.
Dialogue: 0,21:11:37.13,21:11:39.20,Default,,0,0,0,,Жақсы, жақсы доп!
Dialogue: 0,21:11:39.20,21:11:42.80,Default,,0,0,0,,Наисбо Фуруя. (Маэзоно) 2 шықты!
Dialogue: 0,21:11:44.78,21:11:48.70,Default,,0,0,0,,Енді сіздің соққы беру мүмкіндігіңіз. Бұл пирог өте қызықсыз.
Dialogue: 0,21:11:48.70,21:11:51.76,Default,,0,0,0,,《Фуруя: Мен шаршаған жоқпын! 》
Dialogue: 0,21:11:51.76,21:11:54.73,Default,,0,0,0,,Канемару. (Канамару) А... иә.
Dialogue: 0,21:11:54.73,21:11:58.58,Default,,0,0,0,,Савамураға оны дұрыс мұздатуды айт.
Dialogue: 0,21:11:58.58,21:12:03.74,Default,,0,0,0,,Эй, мен саған салқындатқыш қорап әкелдім.
Dialogue: 0,21:12:03.74,21:12:07.71,Default,,0,0,0,,Қалғанын өзіңіз жасаңыз.
Dialogue: 0,21:12:07.71,21:12:12.91,Default,,0,0,0,,《Ол орындыққа оралғаннан бері...
Dialogue: 0,21:12:12.91,21:12:15.77,Default,,0,0,0,,Савамура соншалықты жаман ба?
Dialogue: 0,21:12:15.77,21:12:18.72,Default,,0,0,0,,Бұл сіздің жазғы демалыстан кейінгі бірінші рет емес пе? 》
Dialogue: 0,21:12:18.72,21:12:22.74,Default,,0,0,0,,((Жабайы қадам! Жарайды, үшінші нүкте.
Dialogue: 0,21:12:22.74,21:12:24.72,Default,,0,0,0,,Бұл эпизод мүлде керісінше!
Dialogue: 0,21:12:24.72,21:12:27.79,Default,,0,0,0,,Әй, қашуға жүгір!
Dialogue: 0,21:12:27.79,21:12:30.09,Default,,0,0,0,,Миюки!
Dialogue: 0,21:15:12.07,21:15:15.06,Default,,0,0,0,,Савамураның жағдайы қандай?
Dialogue: 0,21:15:15.06,21:15:17.25,Default,,0,0,0,,Доптың күші бар →
Dialogue: 0,21:15:17.25,21:15:20.25,Default,,0,0,0,,Оның да сезімі маған қарай жылжи бастады...
Dialogue: 0,21:15:20.25,21:15:24.87,Default,,0,0,0,,Тек осы сәйкестік емес, соңғы кездегі →
Dialogue: 0,21:15:24.87,21:15:29.09,Default,,0,0,0,,Мен ішкі курсқа шабуыл жасай алмадым және көптеген доптарды алып жаттым...
Dialogue: 0,21:15:29.09,21:15:32.75,Default,,0,0,0,,Оның қаншалықты хабардар екенін білмеймін, бірақ→
Dialogue: 0,21:15:32.75,21:15:36.75,Default,,0,0,0,,Егер финалда өлі доп әсер еткен болса...
Dialogue: 0,21:15:40.45,21:15:42.45,Default,,0,0,0,,Фуруя!
Dialogue: 0,21:15:45.37,21:15:47.46,Default,,0,0,0,,《Эйджун: Е! ? 》
Dialogue: 0,21:15:47.46,21:15:51.46,Default,,0,0,0,,Савамура: Өзгеріс уақыты келді.
Dialogue: 0,21:15:56.04,21:15:58.75,Default,,0,0,0,,《Очиай: Менің ойымша, оған көмектесу мүмкін емес.
Dialogue: 0,21:15:58.75,21:16:01.87,Default,,0,0,0,,Бұл үрдісті оңай өзгерту мүмкін емес》
Dialogue: 0,21:16:01.87,21:16:04.08,Default,,0,0,0,,Сіз Фуруяға жеттіңіз бе?
Dialogue: 0,21:16:04.08,21:16:09.25,Default,,0,0,0,,Каваками алдыңғы ойында ойнады, сондықтан дәл қазір ең тұрақтысы →
Dialogue: 0,21:16:09.25,21:16:11.22,Default,,0,0,0,,Өйткені бұл Фуруя.
Dialogue: 0,21:16:11.22,21:16:14.95,Default,,0,0,0,,《Бір минут күте тұрыңыз...
Dialogue: 0,21:16:14.95,21:16:18.05,Default,,0,0,0,,Әлі бірде-біреуі шыққан жоқ...》
Dialogue: 0,21:16:20.11,21:16:22.41,Default,,0,0,0,,《Көктем қаласы: Эйджун-кун…》
Dialogue: 0,21:16:24.36,21:16:29.89,Default,,0,0,0,,《Осылай жалғастырсам... Төбеден осылай түссем...》
Dialogue: 0,21:16:29.89,21:16:39.46,Default,,0,0,0,,♪♪~
Dialogue: 0,21:16:39.46,21:16:42.58,Default,,0,0,0,,Доп….
Dialogue: 0,21:16:42.58,21:16:45.68,Default,,0,0,0,,Қорғанға екі құмыра керек емес.
Dialogue: 0,21:16:48.14,21:16:51.39,Default,,0,0,0,,Мен бұл көңілсіз екенін білемін, бірақ... Ха!
Dialogue: 0,21:16:51.39,21:16:56.08,Default,,0,0,0,,Хахаха! Жарайды... бұл дұрыс.
Dialogue: 0,21:16:56.08,21:16:59.00,Default,,0,0,0,,Егер бірдеңе шықпай 3 ұпай қойылса →
Dialogue: 0,21:16:59.00,21:17:01.80,Default,,0,0,0,,Сіз ауыстыруға лайықсыз!
Dialogue: 0,21:17:10.41,21:17:16.10,Default,,0,0,0,,Пи... Төбенің үстінде шымшып тұрғаным жаман.
Dialogue: 0,21:17:16.10,21:17:18.10,Default,,0,0,0,,Қалғанын жасаймын! ))
Dialogue: 0,21:17:21.45,21:17:28.05,Default,,0,0,0,,《Жоқ, түспе, қорғаннан түспе...》
Dialogue: 0,21:17:36.07,21:17:43.91,Default,,0,0,0,,《Аа, бұл сезім ол кездегідей...
Dialogue: 0,21:17:43.91,21:17:51.08,Default,,0,0,0,,Қорған алыста, Барған сайын алыстап барады...
Dialogue: 0,21:17:51.08,21:17:53.72,Default,,0,0,0,,Сол сезім...
Dialogue: 0,21:17:53.72,21:17:56.61,Default,,0,0,0,,Енді ешқашан...
Dialogue: 0,21:17:56.61,21:18:00.73,Default,,0,0,0,,Мен енді ол жерде тұра алмайтындай болдым.
Dialogue: 0,21:18:00.73,21:18:08.90,Default,,0,0,0,,Сол кезде... Осы жерден түссем, мен...》
Dialogue: 0,21:18:08.90,21:18:24.75,Default,,0,0,0,,♪♪~
Dialogue: 0,21:18:24.75,21:18:28.39,Default,,0,0,0,,Шаа! 20 қатарынан жеңіс! !
Dialogue: 0,21:18:28.39,21:18:30.57,Default,,0,0,0,,Мақсат орындалды!
Dialogue: 0,21:18:30.57,21:18:32.71,Default,,0,0,0,,Біз ең мықтымыз!
Dialogue: 0,21:18:32.71,21:18:36.75,Default,,0,0,0,,Әлі де бастаушы! Бастапқы құмыраның жақсы соққысы үлкен фактор болды! !
Dialogue: 0,21:18:36.75,21:18:39.23,Default,,0,0,0,,Жақсы жігіт Санада! Жақсы бөлік Санада! !
Dialogue: 0,21:18:39.23,21:18:42.53,Default,,0,0,0,,Санада Керемет! (Мишима) Мені де мақтаңыз!
Dialogue: 0,21:18:42.53,21:18:45.59,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,21:18:45.59,21:18:47.92,Default,,0,0,0,,Мен әртүрлі мәселелерді таптым→
Dialogue: 0,21:18:47.92,21:18:53.26,Default,,0,0,0,,Жемісті матч болды. (Тодороки) Жоқ, жоқ, қош келдіңіз.
Dialogue: 0,21:18:53.26,21:18:59.08,Default,,0,0,0,,《Егін жоқ... Жәй ғана жаттығу матч деп айта аласыз ба? 》
Dialogue: 0,21:18:59.08,21:19:01.92,Default,,0,0,0,,Сонда да Фуруя деген қыз→
Dialogue: 0,21:19:01.92,21:19:04.74,Default,,0,0,0,,Ақшаның иісі өткір.
Dialogue: 0,21:19:04.74,21:19:06.69,Default,,0,0,0,,Кәсіби бейсбол командалары қазірдің өзінде бізге →
Dialogue: 0,21:19:06.69,21:19:09.66,Default,,0,0,0,,Біреу жоқ па? Ол бала сөзсіз →
Dialogue: 0,21:19:09.66,21:19:13.60,Default,,0,0,0,,Ол кәсіби ойыншы болу үшін дамуы керек ойыншы болуы мүмкін.
Dialogue: 0,21:19:13.60,21:19:16.95,Default,,0,0,0,,Бірақ 4 саны да бар...
Dialogue: 0,21:19:16.95,21:19:22.26,Default,,0,0,0,,Иә! ? Жоқ, солай ма? Бұл менің ұлым, бірақ иә!
Dialogue: 0,21:19:22.26,21:19:26.40,Default,,0,0,0,,Маңыздысы адам ретінде қалай өскеніңіз.
Dialogue: 0,21:19:26.40,21:19:29.92,Default,,0,0,0,,Сайтқа жауаптылар ретінде біз ең жақсымыз →
Dialogue: 0,21:19:29.92,21:19:32.08,Default,,0,0,0,,Бұл абай болу керек.
Dialogue: 0,21:19:32.08,21:19:36.22,Default,,0,0,0,,Фуруя жалғыз ойыншы емес.
Dialogue: 0,21:19:36.22,21:19:38.74,Default,,0,0,0,,Хаха... Дұрыс айтасыз.
Dialogue: 0,21:19:38.74,21:19:42.23,Default,,0,0,0,,Жоқ, жоқ, ол тәрбиеші ғой, гейки директор!
Dialogue: 0,21:19:42.23,21:19:45.41,Default,,0,0,0,,《Бұл қызық емес》
Dialogue: 0,21:19:45.41,21:19:49.42,Default,,0,0,0,,Мен жай ғана жалдамалы директормын. Егер нәтиже болмаса →
Dialogue: 0,21:19:49.42,21:19:52.52,Default,,0,0,0,,Өйткені сіздің басыңыз ұшып кетеді. Хахахаха!
Dialogue: 0,21:19:52.52,21:19:55.26,Default,,0,0,0,,《Очиай: Бұл кісіде де солай шығар》
Dialogue: 0,21:19:55.26,21:19:59.13,Default,,0,0,0,,Сонымен, жаз бола ма, көктем ме? Немесе →
Dialogue: 0,21:19:59.13,21:20:02.75,Default,,0,0,0,,Күзге таяп қалды... Ресми матчта соқтығысқанда →
Dialogue: 0,21:20:02.75,21:20:06.59,Default,,0,0,0,,Бір-бірімізбен барынша күресейік!
Dialogue: 0,21:20:06.59,21:20:10.21,Default,,0,0,0,,Кеттік! иә!
Dialogue: 0,21:20:10.21,21:20:13.93,Default,,0,0,0,,Бәрі бітті ме? (Санада) Иә, бітті.
Dialogue: 0,21:20:13.93,21:20:18.40,Default,,0,0,0,,《Эйс пен №4 команданың ортасында мықтап тұр...
Dialogue: 0,21:20:18.40,21:20:22.92,Default,,0,0,0,,Осындай күшті командамен ресми ойындарда мүмкіндігінше көп ойнаңыз →
Dialogue: 0,21:20:22.92,21:20:25.24,Default,,0,0,0,,Мен сенімен кездескім келмейді...》
Dialogue: 0,21:20:25.24,21:20:30.69,Default,,0,0,0,,Соңында Каваками де Якушидің тазалауын тоқтата алмады.
Dialogue: 0,21:20:30.69,21:20:34.25,Default,,0,0,0,,Бұл ұят, өйткені Фуруя өте жақсы болды...
Dialogue: 0,21:20:34.25,21:20:37.87,Default,,0,0,0,,Бұл туралы айтатын болсақ, соққылар сызығы да Санаданың бақылауында болды→
Dialogue: 0,21:20:37.87,21:20:42.09,Default,,0,0,0,,Сенімсіз... Өткен жылмен салыстырғанда мүлдем жоқ.
Dialogue: 0,21:20:42.09,21:20:45.61,Default,,0,0,0,,Бірақ блоктың алдын ала кезеңі екі аптадан кейін өтеді →
Dialogue: 0,21:20:45.61,21:20:50.71,Default,,0,0,0,,Финал бір айдан кейін өтеді. Біз оны қысқа мерзімде қалпына келтіре аламыз ба?
Dialogue: 0,21:20:59.40,21:21:02.31,Default,,0,0,0,,Бұл толық жеңіліс.
Dialogue: 0,21:21:02.31,21:21:07.41,Default,,0,0,0,,Бұл сіздің қазіргі қабілетіңіз. Бұл бүкіл команданың күші.
Dialogue: 0,21:21:09.46,21:21:13.04,Default,,0,0,0,,《Ота: Ах~ Мына атмосфера... Ақыр соңында, осы матч→
Dialogue: 0,21:21:13.04,21:21:15.20,Default,,0,0,0,,Мен оны қабылдамауым керек еді...》
Dialogue: 0,21:21:15.20,21:21:20.41,Default,,0,0,0,,Соғу! Әсіресе екінші курс студенттері! Жарғанатта позитив жеткіліксіз! !
Dialogue: 0,21:21:20.41,21:21:23.86,Default,,0,0,0,,Ол командалық соққыға өте саналы болуы мүмкін→
Dialogue: 0,21:21:23.86,21:21:27.75,Default,,0,0,0,,Егер бұл өз қолыңызбен тербелуді жасай алмайтыныңызды білдірсе, онда ешқандай мән жоқ.
Dialogue: 0,21:21:27.75,21:21:31.65,Default,,0,0,0,,Осы жазғы демалыста мен сендерге емін-еркін ойнауға мүмкіндік бердім →
Dialogue: 0,21:21:31.65,21:21:35.37,Default,,0,0,0,,Егер сіз өз күшіңізді іс жүзінде көрсете алсаңыз, нәтиже шығаруға жеткілікті болады→
Dialogue: 0,21:21:35.37,21:21:38.91,Default,,0,0,0,,Себебі мен үлкен үміт күттім. Сіздің соққыңыз қазіргідей →
Dialogue: 0,21:21:38.91,21:21:41.83,Default,,0,0,0,,Мен сене алмаймын.
Dialogue: 0,21:21:41.83,21:21:47.25,Default,,0,0,0,,Соққы реті және тұрақты соққы реті бекітілмеген. 1-ші немесе 2-ші курсына қарамастан →
Dialogue: 0,21:21:47.25,21:21:52.41,Default,,0,0,0,,Біз жақсы формадағы ойыншыларды қолданамыз, сондықтан бәрі мұны есте ұстауы керек.
Dialogue: 0,21:21:52.41,21:21:56.04,Default,,0,0,0,,Бүгін созылыңыз және бұзылыңыз! иә!
Dialogue: 0,21:21:56.04,21:22:00.78,Default,,0,0,0,,Миюки Каваками... Савамура.
Dialogue: 0,21:22:00.78,21:22:03.28,Default,,0,0,0,,Балалар, осында қалуларың керек.
Dialogue: 0,21:22:06.87,21:22:11.31,Default,,0,0,0,,Бүгінгі питтинг Сіз қалай ойлайсыз? Савамура.
Dialogue: 0,21:22:11.31,21:22:15.88,Default,,0,0,0,,Иә... Миюки-сенпай ұстаған жері →
Dialogue: 0,21:22:15.88,21:22:19.07,Default,,0,0,0,,Мүлдем лақтырылған жоқ.
Dialogue: 0,21:22:19.07,21:22:22.10,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,21:22:22.10,21:22:26.20,Default,,0,0,0,,Сіз оны курсқа толығымен тастай алмайсыз деп ойлайсыз ба?
Dialogue: 0,21:22:29.91,21:22:34.33,Default,,0,0,0,,Иә.
Dialogue: 0,21:22:34.33,21:22:37.05,Default,,0,0,0,,Финалда оның отставкаға кетуіне әкелген өлі доп.
Dialogue: 0,21:22:37.05,21:22:40.74,Default,,0,0,0,,Санасыз дене курсы бойынша лақтырады →
Dialogue: 0,21:22:40.74,21:22:44.39,Default,,0,0,0,,Бәлкім, қорқатын шығарсың.
Dialogue: 0,21:22:44.39,21:22:46.99,Default,,0,0,0,,《Ochiai: Ips?》
Dialogue: 0,21:22:52.08,21:22:55.72,Default,,0,0,0,,《Маңызды жағдайда орын алған қателік немесе өлі доптан кейін→
Dialogue: 0,21:22:55.72,21:22:58.41,Default,,0,0,0,,Осы уақытқа дейін қарапайым болып келген пьеса →
Dialogue: 0,21:22:58.41,21:23:00.43,Default,,0,0,0,,Бұлай істеу мүмкін емес.
Dialogue: 0,21:23:00.43,21:23:03.38,Default,,0,0,0,,Себептердің көпшілігі психикалық →
Dialogue: 0,21:23:03.38,21:23:08.12,Default,,0,0,0,,Егер ол yips болса, күзгі турнирге күш ретінде →
Dialogue: 0,21:23:08.12,21:23:10.42,Default,,0,0,0,,Мен мұны мүлдем күтпеймін》
Dialogue: 0,21:23:14.39,21:23:16.78,Default,,0,0,0,,Савамура.
Dialogue: 0,21:23:16.78,21:23:18.86,Default,,0,0,0,,Ертеңнен бастап сізде басқа мәзір болады.
Dialogue: 0,21:23:18.86,21:23:21.08,Default,,0,0,0,,Допты мүлде ұстамаңыз.
Dialogue: 0,21:23:21.08,21:23:24.98,Default,,0,0,0,,Төменгі денені негізінен жүгіру арқылы жаттықтырыңыз.
Dialogue: 0,21:23:24.98,21:23:27.37,Default,,0,0,0,,《Иә?
Dialogue: 0,21:23:27.37,21:23:31.92,Default,,0,0,0,,Жарыс келе жатыр, бірақ мен жалғыз менмін бөлек ас мәзірі бар ма? Бұл...》
Dialogue: 0,21:23:31.92,21:23:34.89,Default,,0,0,0,,Каваками соққыға жығылды, бірақ →
Dialogue: 0,21:23:34.89,21:23:37.71,Default,,0,0,0,,Төмен дыбыс Бұл жаман болған жоқ.
Dialogue: 0,21:23:37.71,21:23:40.70,Default,,0,0,0,,Турнирге дейін жақсылап бейімделуді ұмытпаңыз.
Dialogue: 0,21:23:40.70,21:23:42.70,Default,,0,0,0,,Иә!
Dialogue: 0,21:23:42.70,21:23:47.41,Default,,0,0,0,,《Мен көремін, көремін. Егер сіз бұл туралы жаман айтқан болсаңыз, онда...
Dialogue: 0,21:23:47.41,21:23:53.38,Default,,0,0,0,,Күшсіз...
Dialogue: 0,21:23:53.38,21:23:57.75,Default,,0,0,0,,Қазіргі уақытта біздің ұпай жинайтын күшіміз алдыңғы командаға қарағанда әлдеқайда төмен.
Dialogue: 0,21:23:57.75,21:24:00.75,Default,,0,0,0,,Бұл кезде қорғаныс маңызды.
Dialogue: 0,21:24:00.75,21:24:03.87,Default,,0,0,0,,Ойыншылар аз ұпай айырмашылығымен құтыла алатын ойындар көбірек болуы мүмкін.
Dialogue: 0,21:24:03.87,21:24:06.58,Default,,0,0,0,,Фуруя қаншалықты жақсы болса да →
Dialogue: 0,21:24:06.58,21:24:10.08,Default,,0,0,0,,Менде матчты жалғыз шешуге әлі шыдамым жетпейді.
Dialogue: 0,21:24:10.08,21:24:16.08,Default,,0,0,0,,Күзгі турнирде жеңіске жету үшін бізге сіздің көмегіңіз қажет.
Dialogue: 0,21:25:19.03,21:25:22.45,Default,,0,0,0,,Иә? Савамура бүгін сонда болды ма?
Dialogue: 0,21:25:22.45,21:25:25.85,Default,,0,0,0,,Әлгі жігіт үнемі В жағында жүгіріп жүрді.
Dialogue: 0,21:25:25.85,21:25:28.71,Default,,0,0,0,,Неліктен? Кешегі пенальти?
Dialogue: 0,21:25:28.71,21:25:31.08,Default,,0,0,0,,Шын мәнінде...
Dialogue: 0,21:25:31.08,21:25:33.43,Default,,0,0,0,,Өтірік! Савамура иә?
Dialogue: 0,21:25:33.43,21:25:39.92,Default,,0,0,0,,Мен орта мектепте оқып жүргенімде сонда болдым. Енді бірінші лақтыра алмайтын жігіт.
Dialogue: 0,21:25:39.92,21:25:42.92,Default,,0,0,0,,Тоджо жігіт, бұл құмыраға қайта оралу мүмкіндігі емес пе?
Dialogue: 0,21:25:42.92,21:25:47.53,Default,,0,0,0,,Сен ақымақсың ба? Мұндай кездейсоқ сезімдермен алаңшы болуға ауыспаңыз.
Dialogue: 0,21:25:47.53,21:25:53.58,Default,,0,0,0,,Сол оқиға туралы көбірек айтып бере аласыз ба? Канамару.
Dialogue: 0,21:25:53.58,21:25:56.03,Default,,0,0,0,,Крис Сенпай.
Dialogue: 0,21:25:56.03,21:25:59.64,Default,,0,0,0,,Якуши мен Сейдо жаттығу матчында?
Dialogue: 0,21:25:59.64,21:26:04.59,Default,,0,0,0,,Ах, есеп 7-ден 2-ге дейін. Якуши жеңу үшін арттан келген сияқты.
Dialogue: 0,21:26:04.59,21:26:07.53,Default,,0,0,0,,Ақыдайдың алдында осындай жақсы карта?
Dialogue: 0,21:26:07.53,21:26:11.75,Default,,0,0,0,,Мен оны өз көзіммен көргім келеді. (Менікі) Мен де.
Dialogue: 0,21:26:11.75,21:26:14.22,Default,,0,0,0,,Ал жеңімпаз...
Dialogue: 0,21:26:14.22,21:26:16.54,Default,,0,0,0,,Бір бағаны жіберіп алу деген нені білдіреді →
Dialogue: 0,21:26:16.54,21:26:19.36,Default,,0,0,0,,Алдыңғы команда толығымен өзгереді.
Dialogue: 0,21:26:19.36,21:26:24.03,Default,,0,0,0,,Мүмкін бұл ұпай екі команданың қазіргі жағдайын білдіруі мүмкін.
Dialogue: 0,21:26:24.03,21:26:29.08,Default,,0,0,0,,Якушидің негізгі мүшелері сол күйінде қалатыны рас→
Dialogue: 0,21:26:29.08,21:26:32.75,Default,,0,0,0,,Жазғы демалыста қанша команда құра аласыз→
Dialogue: 0,21:26:32.75,21:26:35.86,Default,,0,0,0,,Бұл әр мектепке берілетін ортақ тапсырма.
Dialogue: 0,21:26:35.86,21:26:38.91,Default,,0,0,0,,Ах.
Dialogue: 0,21:26:38.91,21:26:40.91,Default,,0,0,0,,
Dialogue: 0,21:26:40.91,21:26:43.03,Default,,0,0,0,,О, қандай керемет адам!
Dialogue: 0,21:26:43.03,21:26:46.28,Default,,0,0,0,,《Ал осы жаз →
Dialogue: 0,21:26:46.28,21:26:50.28,Default,,0,0,0,,Қаншалықты жақсы команда болса да, ол ерекшелік емес.
Dialogue: 0,21:26:54.23,21:26:57.41,Default,,0,0,0,,Жазғы каникулдың аяқталуына аз ғана қалған болса да→
Dialogue: 0,21:26:57.41,21:27:00.90,Default,,0,0,0,,Үшінші сынып оқушылары практикаға қалыпты түрде қатысады.
Dialogue: 0,21:27:00.90,21:27:04.10,Default,,0,0,0,,Кейбір ойыншылар Жапония-АҚШ достық бейсбол командасының мүшелері ретінде таңдалды →
Dialogue: 0,21:27:04.10,21:27:07.37,Default,,0,0,0,,Ұлттық атлетикалық кездесу қыркүйек айының соңынан бастап өтеді.
Dialogue: 0,21:27:07.37,21:27:10.39,Default,,0,0,0,,Кошиенде неғұрлым белсенді болсаңыз →
Dialogue: 0,21:27:10.39,21:27:13.58,Default,,0,0,0,,Үшінші курс студенттері зейнетке шығу үшін ұзағырақ күтуге тура келеді.
Dialogue: 0,21:27:13.58,21:27:18.20,Default,,0,0,0,,Галереялар саны таңқаларлық және екінші орын алған команда күткендей.
Dialogue: 0,21:27:18.20,21:27:22.24,Default,,0,0,0,,《Кошиеннен кейін 10 күннен кейін де солай ма?
Dialogue: 0,21:27:22.24,21:27:25.24,Default,,0,0,0,,Жазғы демалыстың көп бөлігін Кошиенде өткізді →
Dialogue: 0,21:27:25.24,21:27:28.04,Default,,0,0,0,,Ел мақтауын алған ұжымның ғана дәмін тататын дәм→
Dialogue: 0,21:27:28.04,21:27:30.58,Default,,0,0,0,,Жұмыстың орындалу және орындалу сезімі.
Dialogue: 0,21:27:30.58,21:27:34.73,Default,,0,0,0,,Екінші жағынан, жаңа команданы бастау сөзсіз кешіктіріледі.
Dialogue: 0,21:27:34.73,21:27:37.64,Default,,0,0,0,,А... Харада-кун, енді жақсы ма?
Dialogue: 0,21:27:37.64,21:27:39.67,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,21:27:39.67,21:27:43.06,Default,,0,0,0,,Кошиенде жақсы жұмыс Қазір біраз тынышталдыңыз ба?
Dialogue: 0,21:27:43.06,21:27:45.08,Default,,0,0,0,,Ммм, дәмді екен.
Dialogue: 0,21:27:45.08,21:27:48.70,Default,,0,0,0,,Харада-куннан билік алу үшін біраз қысым болуы керек→
Dialogue: 0,21:27:48.70,21:27:50.73,Default,,0,0,0,,Жаңа капитан тағайындалды ма?
Dialogue: 0,21:27:50.73,21:27:54.25,Default,,0,0,0,,Иә, жаттықтырушы да, ойыншылар да →
Dialogue: 0,21:27:54.25,21:27:56.89,Default,,0,0,0,,Бірауыздан бұл Фуку-чан.
Dialogue: 0,21:27:56.89,21:27:59.77,Default,,0,0,0,,《Фуку-чан деген кім? 》
Dialogue: 0,21:27:59.77,21:28:02.41,Default,,0,0,0,,Ол Кошиендегі орындықта да болмады→
Dialogue: 0,21:28:02.41,21:28:05.41,Default,,0,0,0,,Мен өзімнің жаңа командамның тұрақты мүшесі бола алмаймын деп ойлаймын.
Dialogue: 0,21:28:05.41,21:28:10.07,Default,,0,0,0,,Дегенмен, ол жауапкершілікті ең күшті сезінеді және ұжымдағы ең байыпты адам→
Dialogue: 0,21:28:10.07,21:28:14.21,Default,,0,0,0,,Ол жерді күтіп-баптауды соңына дейін жасайтын жігіт.
Dialogue: 0,21:28:14.21,21:28:16.24,Default,,0,0,0,,Нарумия да оған қарайды.
Dialogue: 0,21:28:16.24,21:28:19.11,Default,,0,0,0,,《Күтпеген таңдау...》
Dialogue: 0,21:28:19.11,21:28:21.06,Default,,0,0,0,,Е! ?
Dialogue: 0,21:28:21.06,21:28:24.47,Default,,0,0,0,,Ах... Эй, Карлос, киіміңді жерге түсірме!
Dialogue: 0,21:28:24.47,21:28:27.37,Default,,0,0,0,,Кеше доп домалады...
Dialogue: 0,21:28:27.37,21:28:31.11,Default,,0,0,0,,Күні кеше екі... Дұрыс жинай алмайтындар үшін →
Dialogue: 0,21:28:31.11,21:28:33.11,Default,,0,0,0,,Сен тозаққа баруың керек.
Dialogue: 0,21:28:35.36,21:28:38.06,Default,,0,0,0,,Эй, мені тура сүйме!
Dialogue: 0,21:28:38.06,21:28:40.43,Default,,0,0,0,,Сіз тым көп ішкенсіз!
Dialogue: 0,21:28:40.43,21:28:44.59,Default,,0,0,0,,Ішкі құрамда капитандық мінезді ешкім болмағандықтан...
Dialogue: 0,21:28:44.59,21:28:47.07,Default,,0,0,0,,Мен...
Dialogue: 0,21:28:47.07,21:28:50.61,Default,,0,0,0,,Иә? Айтпақшы, Наримия-кун ше?
Dialogue: 0,21:28:50.61,21:28:53.58,Default,,0,0,0,,Ең аз кооператив сияқты...
Dialogue: 0,21:28:53.58,21:28:55.53,Default,,0,0,0,,Мүмкін бұл бұқа шығар.
Dialogue: 0,21:28:55.53,21:28:58.73,Default,,0,0,0,,Не? Күзге дайын болыңыз! ?
Dialogue: 0,21:28:58.73,21:29:01.74,Default,,0,0,0,,Жоқ, жоқ, мен Қошиеннен қайттым→
Dialogue: 0,21:29:01.74,21:29:04.21,Default,,0,0,0,,Мен сізге дұрыс лақтыруға рұқсат бермеймін.
Dialogue: 0,21:29:04.21,21:29:08.58,Default,,0,0,0,,Жаттықтырушы сонымен қатар ұлттық саясатта тек үшінші курс студенттерінің дерлік жарысатынын айтады.
Dialogue: 0,21:29:08.58,21:29:12.06,Default,,0,0,0,,Кошиеннен әбден шаршаған болуы керек →
Dialogue: 0,21:29:12.06,21:29:14.52,Default,,0,0,0,,Оның әлі көп жолы бар →
Dialogue: 0,21:29:14.52,21:29:17.57,Default,,0,0,0,,Ол шайқау керек құмыра.
Dialogue: 0,21:29:17.57,21:29:19.94,Default,,0,0,0,,Just that kind of guy.
Dialogue: 0,21:29:19.94,21:29:23.74,Default,,0,0,0,,Менің ойымша, ол қазір өгізде бос емес шығар.
Dialogue: 0,21:29:27.08,21:29:29.03,Default,,0,0,0,,Жақсы доп!
Dialogue: 0,21:29:29.03,21:29:31.48,Default,,0,0,0,,Доп Енді бұл доп!
Dialogue: 0,21:29:31.48,21:29:33.57,Default,,0,0,0,,Сәл төмен Өкінішке орай.
Dialogue: 0,21:29:33.57,21:29:37.61,Default,,0,0,0,,Өтінемін, мен лақтырмаймын деп жолыма түспеші, Нару-сан.
Dialogue: 0,21:29:37.61,21:29:40.66,Default,,0,0,0,,Жарайды, мен сені мазалаған жоқпын!
Dialogue: 0,21:29:40.66,21:29:43.03,Default,,0,0,0,,No, I'm your senior!
Dialogue: 0,21:29:43.03,21:29:45.08,Default,,0,0,0,,Өтінемін, өзімшіл болмаңыз!
Dialogue: 0,21:29:45.08,21:29:48.03,Default,,0,0,0,,Не? Мен өзімшілмін деген аға аға емес пе?
Dialogue: 0,21:29:48.03,21:29:50.07,Default,,0,0,0,,What exactly does it mean to be a senior? !
Dialogue: 0,21:29:50.07,21:29:52.42,Default,,0,0,0,,Wow, you're so involved. Осы уақытқа дейін →
Dialogue: 0,21:29:52.42,21:29:55.02,Default,,0,0,0,,Мияби жоғалып кеткен соң тізгінді өз қолыма алдым→
Dialogue: 0,21:29:55.02,21:29:57.08,Default,,0,0,0,,Do whatever you want!
Dialogue: 0,21:29:57.08,21:30:00.04,Default,,0,0,0,,Even I am really anxious.
Dialogue: 0,21:30:00.04,21:30:02.08,Default,,0,0,0,,More and more Naru's balls→
Dialogue: 0,21:30:02.08,21:30:04.10,Default,,0,0,0,,Мен оны қабылдасам жақсы болар еді деп ойладым.
Dialogue: 0,21:30:04.10,21:30:06.08,Default,,0,0,0,,Жарайды Жарайды.
Dialogue: 0,21:30:06.08,21:30:08.68,Default,,0,0,0,,Мен оны сіз орнатқан жерге лақтырамын!
Dialogue: 0,21:30:11.54,21:30:14.06,Default,,0,0,0,,《It's just a wall...》
Dialogue: 0,21:30:14.06,21:30:16.43,Default,,0,0,0,,Сіздің жүзіңіздегі көңілі толмаушылық қандай?
Dialogue: 0,21:30:16.43,21:30:18.46,Default,,0,0,0,,Мына жігіт ештеңе түсінбейтін сияқты!
Dialogue: 0,21:30:18.46,21:30:20.90,Default,,0,0,0,,I don't really think that way!
Dialogue: 0,21:30:20.90,21:30:23.03,Default,,0,0,0,,《Өткір...》
Dialogue: 0,21:30:23.03,21:30:25.74,Default,,0,0,0,,Don't worry, it's here →
Dialogue: 0,21:30:25.74,21:30:31.91,Default,,0,0,0,,Мен кенеттен Мияби-санның орнын басамын деп ойламаймын.
Dialogue: 0,21:30:31.91,21:30:35.55,Default,,0,0,0,,Жоқ, олай десең, керісінше...
Dialogue: 0,21:30:35.55,21:30:41.12,Default,,0,0,0,,I just have no intention of losing.
Dialogue: 0,21:30:41.12,21:30:43.62,Default,,0,0,0,,Until I saw the view at the top.
Dialogue: 0,21:30:50.36,21:30:53.28,Default,,0,0,0,,Мен саған айтамын, мен өзімшілмін. иә.
Dialogue: 0,21:30:53.28,21:30:55.58,Default,,0,0,0,,I'll shake my head at the sign too.
Dialogue: 0,21:30:55.58,21:30:57.54,Default,,0,0,0,,Мен білемін.
Dialogue: 0,21:30:57.54,21:30:59.57,Default,,0,0,0,,I receive so many fan letters.
Dialogue: 0,21:30:59.57,21:31:01.71,Default,,0,0,0,,Е! ? Иә….
Dialogue: 0,21:31:01.71,21:31:04.74,Default,,0,0,0,,Бұл жай ғана әңгіме →
Dialogue: 0,21:31:04.74,21:31:09.18,Default,,0,0,0,,Кеше үрмелі аспаптар үйірмесінің бірінші курс студенті маған...
Dialogue: 0,21:31:09.18,21:31:11.18,Default,,0,0,0,,What are you talking about!
Dialogue: 0,21:31:13.38,21:31:16.04,Default,,0,0,0,,Жақында күзгі блоктың алдын ала дайындықтары келеді.
Dialogue: 0,21:31:16.04,21:31:19.06,Default,,0,0,0,,Үшінші курс студенттері қыркүйек айының ортасында Ұлттық атлетикалық кездесуде зейнеткерлікке шығады.
Dialogue: 0,21:31:19.06,21:31:22.98,Default,,0,0,0,,Қазан айында финал тағы да өтеді.
Dialogue: 0,21:31:22.98,21:31:24.86,Default,,0,0,0,,While following this schedule→
Dialogue: 0,21:31:24.86,21:31:28.08,Default,,0,0,0,,I have to build a team →
Dialogue: 0,21:31:28.08,21:31:32.49,Default,,0,0,0,,Жеңіске жеткен команда үшін де қиын.
Dialogue: 0,21:31:32.49,21:31:36.06,Default,,0,0,0,,Дегенмен, бұл да тек жеңген команданың қолынан келетін тәжірибе.
Dialogue: 0,21:31:36.06,21:31:38.61,Default,,0,0,0,,Осының бәрі→
Dialogue: 0,21:31:38.61,21:31:42.53,Default,,0,0,0,,I guess it means getting to know Koshien.
Dialogue: 0,21:31:42.53,21:31:46.58,Default,,0,0,0,,<Менікі: Іріктеу кезеңінің бірінші кезеңінде жеңілген команда да →
Dialogue: 0,21:31:46.58,21:31:49.90,Default,,0,0,0,,Кошиен финалына өткен командалар →
Dialogue: 0,21:31:49.90,21:31:56.20,Default,,0,0,0,,Жазғы демалысымызды өткізгеннен кейін, біз сол бастапқы сызыққа оралдық>
Dialogue: 0,21:32:05.09,21:32:09.09,Default,,0,0,0,,О, бейсбол клубы, жазғы демалыста көп жұмыс істедің бе?
Dialogue: 0,21:32:09.09,21:32:11.23,Default,,0,0,0,,Ой.
Dialogue: 0,21:32:11.23,21:32:13.53,Default,,0,0,0,,Кошиен шынымен көңілін қалдырды.
Dialogue: 0,21:32:13.53,21:32:15.86,Default,,0,0,0,,Трибунадағылардың бәрі де жылап жатты.
Dialogue: 0,21:32:15.86,21:32:20.20,Default,,0,0,0,,Біреу менің өнерім оны Кошиен матчынан да қызықты етті деп айтты.
Dialogue: 0,21:32:20.20,21:32:22.20,Default,,0,0,0,,《Қашан айтып тұрсың?
Dialogue: 0,21:32:22.20,21:32:25.57,Default,,0,0,0,,Мен келесіге бара жатырмын.
Dialogue: 0,21:32:25.57,21:32:29.93,Default,,0,0,0,,That guy was amazing, Sawamura!
Dialogue: 0,21:32:29.93,21:32:33.03,Default,,0,0,0,,Ол оны мақтанышпен Цзингуға қорғанға лақтырды.
Dialogue: 0,21:32:33.03,21:32:35.25,Default,,0,0,0,,He was barking a lot. With that guy in class →
Dialogue: 0,21:32:35.25,21:32:37.24,Default,,0,0,0,,Тым көп бос орындар.
Dialogue: 0,21:32:37.24,21:32:41.21,Default,,0,0,0,,Мектепке алғаш түскенімде ол осы сыныпта мәлімдеме жасады.
Dialogue: 0,21:32:41.21,21:32:47.91,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,21:32:47.91,21:32:50.38,Default,,0,0,0,,Сол кезде сыныпта күлкі болды→
Dialogue: 0,21:32:50.38,21:32:52.68,Default,,0,0,0,,Can't you really become an ace?
Dialogue: 0,21:32:56.75,21:33:01.66,Default,,0,0,0,,Иә? Мен біртүрлі нәрсе айттым ба? (Канамару) Жоқ.
Dialogue: 0,21:33:01.66,21:33:04.40,Default,,0,0,0,,Сәлем, Харуно!
Dialogue: 0,21:33:04.40,21:33:07.85,Default,,0,0,0,,Савамура: Жазғы демалыста бірдеңе болды ма?
Dialogue: 0,21:33:07.85,21:33:10.35,Default,,0,0,0,,Hasn't the atmosphere changed somehow?
Dialogue: 0,21:33:13.59,21:33:15.96,Default,,0,0,0,,Сондай көлеңкелі сезім болды ма?
Dialogue: 0,21:33:15.96,21:33:18.53,Default,,0,0,0,,And read some books.
Dialogue: 0,21:33:18.53,21:33:22.75,Default,,0,0,0,,Бұл бес сақина кітабы. Miyamoto Musashi just before his death →
Dialogue: 0,21:33:22.75,21:33:26.20,Default,,0,0,0,,Менің тәрбием мен қылыштарым туралы жазылған әскери тактика туралы кітап.
Dialogue: 0,21:33:26.20,21:33:30.41,Default,,0,0,0,,Мусаши! ? Не, Савамура, сен самурай болғың келе ме? Ха!
Dialogue: 0,21:33:30.41,21:33:34.03,Default,,0,0,0,,Бірақ көлеңкелі Савамура да болуы мүмкін.
Dialogue: 0,21:33:34.03,21:33:38.95,Default,,0,0,0,,《Харуно: Өмір бойы жеңілмеген адамнан бірдеңе алмақшысың ба? 》
Dialogue: 0,21:33:38.95,21:33:41.75,Default,,0,0,0,,《Жаңа семестр басталады→
Dialogue: 0,21:33:41.75,21:33:45.42,Default,,0,0,0,,Тіпті қазірдің өзінде блоктық лотерея → жақындап қалды
Dialogue: 0,21:33:45.42,21:33:48.42,Default,,0,0,0,,Савамураның басқа мәзірі жалғасын тапты》
Dialogue: 0,21:33:56.58,21:34:00.74,Default,,0,0,0,,《Бұл жолы ең күшті клан кітабы》
Dialogue: 0,21:34:00.74,21:34:04.27,Default,,0,0,0,,((мен түсінемін, әрине.
Dialogue: 0,21:34:04.27,21:34:07.74,Default,,0,0,0,,Қамырдан қорықпаңыз және ішкі курсқа шабуыл жасаңыз →
Dialogue: 0,21:34:07.74,21:34:09.91,Default,,0,0,0,,Бұл оның ойыны болды.
Dialogue: 0,21:34:09.91,21:34:13.71,Default,,0,0,0,,Бұл бір үлкен қаруды жоғалтқанмен бірдей.
Dialogue: 0,21:34:15.75,21:34:21.04,Default,,0,0,0,,Егер бұл yips болса, бұл сөзсіз мәселе.
Dialogue: 0,21:34:21.04,21:34:25.08,Default,,0,0,0,,Бірақ сіз жазғы демалыста басқа жаттығу ойындарында да ойнадыңыз, солай ма?
Dialogue: 0,21:34:25.08,21:34:28.38,Default,,0,0,0,,Ah, yes. If so →
Dialogue: 0,21:34:28.38,21:34:32.38,Default,,0,0,0,,Бәлкім, айналаңыздағылар оны онша байыппен қабылдамағаны дұрыс шығар.
Dialogue: 0,21:34:32.38,21:34:35.90,Default,,0,0,0,,А... неге Савамурамен сөйлеспейсің?
Dialogue: 0,21:34:35.90,21:34:41.24,Default,,0,0,0,,Бұл құлдырауды үлкен секіріске айналдыратыныңызға сенемін.
Dialogue: 0,21:34:41.24,21:34:44.84,Default,,0,0,0,,Ол сондай жігіт))
Dialogue: 0,21:34:50.54,21:34:53.96,Default,,0,0,0,,《Бұл басқаларды уайымдайтын уақыт емес!
Dialogue: 0,21:34:53.96,21:34:56.96,Default,,0,0,0,,Команданың қазіргі жағдайы мен үшін де мүмкіндік.
Dialogue: 0,21:35:12.57,21:35:17.17,Default,,0,0,0,,《Турнир жақындап қалды, мен өзім не істеп жатырмын?》
Dialogue: 0,21:35:19.45,21:35:23.45,Default,,0,0,0,,《Егер мен біреуін шығара алмасам, неден бастау керек?》
Dialogue: 0,21:35:26.22,21:35:28.82,Default,,0,0,0,,《What is Ace》
Dialogue: 0,21:35:30.94,21:35:33.24,Default,,0,0,0,,《Dammit...》
Dialogue: 0,21:35:35.76,21:35:39.06,Default,,0,0,0,,《I am weak》
Dialogue: 0,21:35:40.56,21:35:46.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory