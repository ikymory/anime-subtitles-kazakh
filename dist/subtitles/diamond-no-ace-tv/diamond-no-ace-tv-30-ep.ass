Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.17,0:00:35.69,Default,,0,0,0,,Келесі көктемнен →
Dialogue: 0,0:00:35.69,0:00:41.19,Default,,0,0,0,,Ол орта мектеп бейсболына қатысу құқығынан айырылады.
Dialogue: 0,0:00:45.51,0:00:51.11,Default,,0,0,0,,Қарсыластың орындығына бұқа алаңынан қысым жасау.
Dialogue: 0,0:00:54.19,0:00:56.19,Default,,0,0,0,,Тамба….
Dialogue: 0,0:01:02.00,0:01:05.10,Default,,0,0,0,,Эйс... бұқада.
Dialogue: 0,0:03:49.13,0:03:51.13,Default,,0,0,0,,Фуши!
Dialogue: 0,0:03:55.30,0:04:00.12,Default,,0,0,0,,Бұл өтірік шығар. Эйс мұнда...
Dialogue: 0,0:04:00.12,0:04:04.51,Default,,0,0,0,,Мүмкін сіз басынан бастап екінші жартыжылдықта жарысуды жоспарлаған боларсыз →
Dialogue: 0,0:04:04.51,0:04:07.15,Default,,0,0,0,,Ол сақталды ма?
Dialogue: 0,0:04:07.15,0:04:09.60,Default,,0,0,0,,《Жоқ, олай болуы мүмкін емес...
Dialogue: 0,0:04:09.60,0:04:13.72,Default,,0,0,0,,Бастапқы құмыраны төртінші иннингте құмыраны қалдыру →
Dialogue: 0,0:04:13.72,0:04:17.79,Default,,0,0,0,,Мен ондағы орындықтың да мұны күтпегеніне сенімдімін.
Dialogue: 0,0:04:17.79,0:04:21.48,Default,,0,0,0,,Одан да есептелмегені → болды
Dialogue: 0,0:04:21.48,0:04:26.65,Default,,0,0,0,,Таңбаланбаған бірінші курстағы оңтүстік пау...》
Dialogue: 0,0:04:26.65,0:04:29.30,Default,,0,0,0,,Уау! !
Dialogue: 0,0:04:29.30,0:04:31.30,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:04:34.17,0:04:37.44,Default,,0,0,0,,≪Өт!
Dialogue: 0,0:04:37.44,0:04:39.81,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:04:39.81,0:04:48.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:48.77,0:04:52.71,Default,,0,0,0,,Екіден екі шықты! (Күними) Кеттік, Шун!
Dialogue: 0,0:04:52.71,0:04:54.71,Default,,0,0,0,,Батер фокусы!
Dialogue: 0,0:04:56.61,0:04:58.63,Default,,0,0,0,,《Секигучи: Бірінші допты өткізіп алдың ба? 》
Dialogue: 0,0:04:58.63,0:05:01.13,Default,,0,0,0,,《Доп ойнауға болмайды》
Dialogue: 0,0:05:01.13,0:05:07.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:07.29,0:05:09.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:09.33,0:05:12.20,Default,,0,0,0,,Ереуіл! Қамырды тастаңыз!
Dialogue: 0,0:05:12.20,0:05:14.60,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:14.60,0:05:28.48,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:28.48,0:05:31.18,Default,,0,0,0,,Біріншіден, бірінші қамыр! (Исашики) Савамура Бар!
Dialogue: 0,0:05:31.18,0:05:33.18,Default,,0,0,0,,Мен сені ұрайын!
Dialogue: 0,0:05:38.44,0:05:42.13,Default,,0,0,0,,《Миюки: Курс сәл жұмсақ болса жақсы. Жақсы қарқынмен кел.''
Dialogue: 0,0:05:42.13,0:05:44.43,Default,,0,0,0,,Ойлануға уақыт бермеңіз.
Dialogue: 0,0:05:48.63,0:05:50.63,Default,,0,0,0,,≪Өт!
Dialogue: 0,0:05:50.63,0:05:52.97,Default,,0,0,0,,А, екеуі шықты!
Dialogue: 0,0:05:52.97,0:05:57.47,Default,,0,0,0,,Мұнда әлі екі негізгі құмыра күтіп тұр.
Dialogue: 0,0:06:00.53,0:06:02.83,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:06:04.78,0:06:11.80,Default,,0,0,0,,《Аққу: Тағы бір нүкте... Тағы бір нүкте шексіз алыс》
Dialogue: 0,0:06:11.80,0:06:14.16,Default,,0,0,0,,≪Осы жолы да үшеуі де шегінді ме?
Dialogue: 0,0:06:14.16,0:06:17.06,Default,,0,0,0,,≪Неге мен бұл допты соға алмаймын?
Dialogue: 0,0:06:17.06,0:06:19.80,Default,,0,0,0,,Ол тек түзу лақтырады.
Dialogue: 0,0:06:19.80,0:06:22.97,Default,,0,0,0,,Бірақ бұл жақсы қарқынмен жақсы қадам.
Dialogue: 0,0:06:22.97,0:06:25.60,Default,,0,0,0,,≪Бұл ақымақ көрінеді.
Dialogue: 0,0:06:25.60,0:06:28.99,Default,,0,0,0,,≪Бірінші курс құмырасының аты кім болды?
Dialogue: 0,0:06:28.99,0:06:34.11,Default,,0,0,0,,≪Савамура... Эйджун Савамура!
Dialogue: 0,0:06:34.11,0:06:37.13,Default,,0,0,0,,≪Бұл жігіт керемет.
Dialogue: 0,0:06:37.13,0:06:40.02,Default,,0,0,0,,Савамура-кун, сен сондай дарынды болдың ба?
Dialogue: 0,0:06:40.02,0:06:42.82,Default,,0,0,0,,Савамура-кун керемет!
Dialogue: 0,0:06:44.79,0:06:47.66,Default,,0,0,0,,Керемет доп. Керемет алаң.
Dialogue: 0,0:06:47.66,0:06:55.27,Default,,0,0,0,,《Ой, Сейдоның екі алыбы мені мақтайды...》
Dialogue: 0,0:06:55.27,0:06:57.60,Default,,0,0,0,,Мені мақтады! !
Dialogue: 0,0:06:57.60,0:07:01.80,Default,,0,0,0,,Мен сені мақтамаймын, өйткені сен оңай алшақтайсың.
Dialogue: 0,0:07:01.80,0:07:06.93,Default,,0,0,0,,Балалар бұл ойынды овертаймға дейін ойнайсыңдар ма?
Dialogue: 0,0:07:06.93,0:07:10.36,Default,,0,0,0,,Егер сіз ұлттық үстемдікке шындап ұмтылсаңыз →
Dialogue: 0,0:07:10.36,0:07:15.36,Default,,0,0,0,,Қалған иннингтер үшін мүмкіндігінше көп ұпай жинаңыз.
Dialogue: 0,0:07:19.01,0:07:21.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:21.77,0:07:27.20,Default,,0,0,0,,[Спикер] Seido High School Біз сізге ойыншылардың ауыстырылғаны туралы хабарлаймыз.
Dialogue: 0,0:07:27.20,0:07:30.82,Default,,0,0,0,,[Баяндамашы] No8, Сақай мырзаның орнына→
Dialogue: 0,0:07:30.82,0:07:36.12,Default,,0,0,0,,Шымшушы Харуичи Коминато.
Dialogue: 0,0:07:36.12,0:07:40.64,Default,,0,0,0,,《Төменгі дәрежелі соққылар тізбегі үшін шымшу... Менің ойымша, ойын жоспарда》
Dialogue: 0,0:07:40.64,0:07:43.65,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:07:43.65,0:07:45.93,Default,,0,0,0,,Көктем! о.
Dialogue: 0,0:07:45.93,0:07:50.49,Default,,0,0,0,,Себебі мен сенің артыңдамын. Жабайы жүр!
Dialogue: 0,0:07:50.49,0:07:52.96,Default,,0,0,0,,Дахахаха….
Dialogue: 0,0:07:52.96,0:07:55.46,Default,,0,0,0,,Бұл мен бұрын айтқан жол.
Dialogue: 0,0:07:59.16,0:08:03.45,Default,,0,0,0,,((Рйосуке: Матч кезінде Савамураның қарсыласына қарап қалмаңыз →
Dialogue: 0,0:08:03.45,0:08:05.49,Default,,0,0,0,,Өзіңізді де дайындаңыз.
Dialogue: 0,0:08:05.49,0:08:09.17,Default,,0,0,0,,Менеджер - жақсы ойнайтын ойыншыларды пайдаланатын адам.))
Dialogue: 0,0:08:09.17,0:08:13.47,Default,,0,0,0,,《Ағам айтқандай, шынымен де менің кезегім келді.》
Dialogue: 0,0:08:17.26,0:08:20.72,Default,,0,0,0,,《Бұл жігіт базаны жапты...
Dialogue: 0,0:08:20.72,0:08:24.94,Default,,0,0,0,,Сіз соққыға жығылсаңыз да, базаға түсуді жоспарлап отырсыз ба?
Dialogue: 0,0:08:24.94,0:08:27.49,Default,,0,0,0,,Бұл дұрыс емес сияқты, інім.
Dialogue: 0,0:08:27.49,0:08:31.26,Default,,0,0,0,,Мен өз сезімімді онша көп көрсететін адам емеспін.
Dialogue: 0,0:08:31.26,0:08:33.63,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:33.63,0:08:37.97,Default,,0,0,0,,《Бірақ... жерде тұрғанда→
Dialogue: 0,0:08:37.97,0:08:42.37,Default,,0,0,0,,Ол мен өз бетімше ойламайтын идеяларды ұсынады.
Dialogue: 0,0:08:42.37,0:08:46.87,Default,,0,0,0,,Сіз бірдеңені мақсат етіп отырсыз, Харуичи》
Dialogue: 0,0:08:48.81,0:08:54.20,Default,,0,0,0,,《Металл жарғанаттар негізгі ағым болып табылатын орта мектеп бейсболында неге ағаш таяқты қолданбасқа?
Dialogue: 0,0:08:54.20,0:08:57.65,Default,,0,0,0,,Сіз өзіңіздің ет қабілетіңізге өте сенімді сияқтысыз.
Dialogue: 0,0:08:57.65,0:09:02.78,Default,,0,0,0,,Бірақ... бұл ұстаныммен қалай әрекет ету керек!
Dialogue: 0,0:09:02.78,0:09:06.63,Default,,0,0,0,,Тізені мақсат етіңіз! 》
Dialogue: 0,0:09:06.63,0:09:10.98,Default,,0,0,0,,《Аяғыңды аш! Бұл жігіттің мақсаты әу бастан еді...
Dialogue: 0,0:09:10.98,0:09:13.89,Default,,0,0,0,,Әрине! ? 》
Dialogue: 0,0:09:13.89,0:09:17.69,Default,,0,0,0,,《Бұл пайдасыз! Сіз бұл бағытқа қалай жетсеңіз де, бұл тек фолға әкеледі...》
Dialogue: 0,0:09:21.31,0:09:23.95,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:23.95,0:09:26.78,Default,,0,0,0,,Сәлем! Сол жақтағы бірінші қадам!
Dialogue: 0,0:09:26.78,0:09:30.35,Default,,0,0,0,,《Сол жақтағы бағыт! ? 》
Dialogue: 0,0:09:30.35,0:09:33.12,Default,,0,0,0,,Найбачи көктемі!
Dialogue: 0,0:09:33.12,0:09:37.81,Default,,0,0,0,,《Егер Ян өз бақылауына сенімді болса, ол міндетті түрде ішкі бағытқа шабуыл жасайды.
Dialogue: 0,0:09:37.81,0:09:40.18,Default,,0,0,0,,Сіздің мақсатыңыз осы болды ма?
Dialogue: 0,0:09:40.18,0:09:43.48,Default,,0,0,0,,Бұл жігіттің ақыл-парасаты мол.
Dialogue: 0,0:09:43.48,0:09:46.90,Default,,0,0,0,,≪О! Ол ыңғайсызданып, жұдырығын қағып жатыр.
Dialogue: 0,0:09:46.90,0:09:49.27,Default,,0,0,0,,≪Бетіңіз ашық қызыл, солай емес пе?
Dialogue: 0,0:09:49.27,0:09:52.64,Default,,0,0,0,,《Бұл шынымен қиын.
Dialogue: 0,0:09:52.64,0:09:57.45,Default,,0,0,0,,Осындай інісінің болуы》
Dialogue: 0,0:09:57.45,0:10:00.37,Default,,0,0,0,,Уау! Ол көктемде жалғасады!
Dialogue: 0,0:10:00.37,0:10:02.67,Default,,0,0,0,,Мұнда жарылыс болып жатыр!
Dialogue: 0,0:10:05.00,0:10:07.00,Default,,0,0,0,,《Не! ? 》
Dialogue: 0,0:10:08.99,0:10:13.28,Default,,0,0,0,,《Мен... Бант! ? 》
Dialogue: 0,0:10:13.28,0:10:16.82,Default,,0,0,0,,О, керемет! (Канамару) Тығыз сызықта.
Dialogue: 0,0:10:16.82,0:10:19.95,Default,,0,0,0,,Бант неге соншалықты жақсы? ?
Dialogue: 0,0:10:19.95,0:10:21.97,Default,,0,0,0,,≪Жақсы, қолөнерші!
Dialogue: 0,0:10:21.97,0:10:24.14,Default,,0,0,0,,≪Сейдо өзенінің фазасы!
Dialogue: 0,0:10:24.14,0:10:27.11,Default,,0,0,0,,《Хмм~ Неге соғуыма рұқсат бермейсің?》
Dialogue: 0,0:10:27.11,0:10:32.70,Default,,0,0,0,,《Тх, мен одан бетер ренжіттім, бұл жігіт өзінің бауыздап тұрғанын өзі де түсінбейді! 》
Dialogue: 0,0:10:32.70,0:10:34.80,Default,,0,0,0,,Курамочи.
Dialogue: 0,0:10:37.94,0:10:40.97,Default,,0,0,0,,Шун: Сіз біреуін шығардыңыз.
Dialogue: 0,0:10:40.97,0:10:43.13,Default,,0,0,0,,Уа.
Dialogue: 0,0:10:43.13,0:10:57.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:57.82,0:11:01.48,Default,,0,0,0,,Барлығы қатып қалды, сондықтан дауыстап айтайық.
Dialogue: 0,0:11:01.48,0:11:04.45,Default,,0,0,0,,Курамочи Сізге үлкеннің қажеті жоқ!
Dialogue: 0,0:11:04.45,0:11:06.47,Default,,0,0,0,,Қосылайық!
Dialogue: 0,0:11:06.47,0:11:09.77,Default,,0,0,0,,≪Оны соғуға рұқсат етіңіздер! ≪Шуншин!
Dialogue: 0,0:11:09.77,0:11:12.97,Default,,0,0,0,,7-ші иннингтің төменгі бөлігі, бір шығу, 2-ші негіз.
Dialogue: 0,0:11:12.97,0:11:16.48,Default,,0,0,0,,Бұл жолы жеңіске жету мүмкіндігі...
Dialogue: 0,0:11:16.48,0:11:18.59,Default,,0,0,0,,Курамочи Сенпай.
Dialogue: 0,0:11:18.59,0:11:23.20,Default,,0,0,0,,《Сыпайылық: Мен оны осы уақытқа дейін тамаша басқара алдым, бірақ...''
Dialogue: 0,0:11:23.20,0:11:26.20,Default,,0,0,0,,Мен сенен сұрайтын кез келді, Курамочи-кун.
Dialogue: 0,0:11:29.14,0:11:32.86,Default,,0,0,0,,((Тыңдаңыз, осы соңғы кезеңде қарсыластың қорғанысы да →
Dialogue: 0,0:11:32.86,0:11:35.16,Default,,0,0,0,,Оған үлкен қысым болуы керек.
Dialogue: 0,0:11:37.11,0:11:40.15,Default,,0,0,0,,Ешқашан шыбынға соқпаңыз.
Dialogue: 0,0:11:40.15,0:11:43.47,Default,,0,0,0,,Оңға қарай соғыңыз! ))
Dialogue: 0,0:11:43.47,0:11:46.44,Default,,0,0,0,,《Цусима: Қарғыс атсын, ол сыртқы допты зорлап жіберді...
Dialogue: 0,0:11:46.44,0:11:48.47,Default,,0,0,0,,Үшінші негіз мүмкін емес! 》
Dialogue: 0,0:11:48.47,0:11:50.48,Default,,0,0,0,,≪Міне, келді! ≪Курамочи!
Dialogue: 0,0:11:50.48,0:11:54.08,Default,,0,0,0,,《Уау, тез! Асықпасақ, біз де уақытында жетеміз...》
Dialogue: 0,0:11:56.65,0:12:01.10,Default,,0,0,0,,≪Уау, мен оны төгіп алдым! ≪Акекавадағы қате!
Dialogue: 0,0:12:01.10,0:12:03.19,Default,,0,0,0,,≪Курамочи осында!
Dialogue: 0,0:12:03.19,0:12:07.13,Default,,0,0,0,,≪Бұл өте жылдам, Курамочи. ≪1-ші және 3-ші базаның біреуі!
Dialogue: 0,0:12:07.13,0:12:09.15,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:12:09.15,0:12:13.15,Default,,0,0,0,,Бұл көріністің көптеген мүмкін жағдайлары бар.
Dialogue: 0,0:12:13.15,0:12:17.45,Default,,0,0,0,,Мен Сейдо жағы қандай шабуыл жасайды деп ойлаймын.
Dialogue: 0,0:12:17.45,0:12:21.45,Default,,0,0,0,,4-ші иннингте Ян сығуға тосқауыл қойды.
Dialogue: 0,0:12:24.53,0:12:29.03,Default,,0,0,0,,《Мына жігіт жетекшілік ете алмайды... Жүгіргің келмей ме? 》
Dialogue: 0,0:12:33.02,0:12:35.52,Default,,0,0,0,,《Қорғасынсыз жүгіру》 (Ян) Лақтырмаңыз!
Dialogue: 0,0:12:38.77,0:12:42.16,Default,,0,0,0,,Әй, судан шыққан балықтай!
Dialogue: 0,0:12:42.16,0:12:44.31,Default,,0,0,0,,Жемісін тапқан гепардтай!
Dialogue: 0,0:12:44.31,0:12:47.52,Default,,0,0,0,,Сыр тапқан тышқан сияқты! Сондай-ақ...
Dialogue: 0,0:12:47.52,0:12:49.52,Default,,0,0,0,,Сіз оны жақсы айтуға тырысып жатырсыз.
Dialogue: 0,0:12:51.49,0:12:55.49,Default,,0,0,0,,《Бұл жақсы. Бірінші базада серуендегеннің орнына →
Dialogue: 0,0:12:55.49,0:12:58.19,Default,,0,0,0,,Осылайша сіз жеңіске шоғырлана аласыз...》
Dialogue: 0,0:12:58.19,0:13:03.19,Default,,0,0,0,,Теюка уақыты! Қорғанға жиналайық.
Dialogue: 0,0:13:05.77,0:13:09.12,Default,,0,0,0,,Бейшара Шун. Өйткені мен асығыс болып, қателік жібердім...
Dialogue: 0,0:13:09.12,0:13:11.49,Default,,0,0,0,,Бұл туралы алаңдамаңыз. (Хашимото) Барлығы не →
Dialogue: 0,0:13:11.49,0:13:14.11,Default,,0,0,0,,Қиын болып барады. Осы уақытқа жеткенде →
Dialogue: 0,0:13:14.11,0:13:16.83,Default,,0,0,0,,Бізге тек жарысу керек. Аш болайық!
Dialogue: 0,0:13:16.83,0:13:18.83,Default,,0,0,0,,Ааа….
Dialogue: 0,0:13:23.54,0:13:27.14,Default,,0,0,0,,Мен Бакке сеніп, лақтырамын. (Секигучи) А?
Dialogue: 0,0:13:32.50,0:13:35.10,Default,,0,0,0,,Шу Шун….
Dialogue: 0,0:13:35.10,0:13:40.04,Default,,0,0,0,,《Осында соғып, ойынды шеше аламын ба?→
Dialogue: 0,0:13:40.04,0:13:44.14,Default,,0,0,0,,Әлде мен өз мүмкіндігімді күтуім керек пе...》
Dialogue: 0,0:13:48.51,0:13:52.15,Default,,0,0,0,,《Соңғы минуттық шиеленіс сезімі - бұл →
Dialogue: 0,0:13:52.15,0:13:55.13,Default,,0,0,0,,Бұл бейсболдың нағыз толқуы деп ойламайсыз ба? 》
Dialogue: 0,0:13:55.13,0:13:57.13,Default,,0,0,0,,Ойна!
Dialogue: 0,0:14:01.47,0:14:03.53,Default,,0,0,0,,《Шуншин…》
Dialogue: 0,0:14:03.53,0:14:06.13,Default,,0,0,0,,《Шун…》
Dialogue: 0,0:14:08.83,0:14:11.43,Default,,0,0,0,,《Ол...》
Dialogue: 0,0:14:21.18,0:14:23.18,Default,,0,0,0,,《Қысыңыз! ? 》
Dialogue: 0,0:15:55.12,0:16:05.26,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:05.26,0:16:07.86,Default,,0,0,0,,《Қысыңыз! 》
Dialogue: 0,0:16:12.45,0:16:14.52,Default,,0,0,0,,жойылды! ?
Dialogue: 0,0:16:14.52,0:16:16.62,Default,,0,0,0,,《Мені ұста, Секигучи! 》
Dialogue: 0,0:16:21.65,0:16:23.65,Default,,0,0,0,,《Үлкен аға...》
Dialogue: 0,0:16:27.34,0:16:30.64,Default,,0,0,0,,《А, мынаны тап...》
Dialogue: 0,0:16:36.48,0:16:39.18,Default,,0,0,0,,Иә, иә! (Сачико) Уша~!
Dialogue: 0,0:16:39.18,0:16:42.48,Default,,0,0,0,,《Мені соқтым... Шүкір! 》
Dialogue: 0,0:16:47.44,0:16:50.68,Default,,0,0,0,,Үйге қайт! Үшінші негізде жүгіруші айналып жатыр!
Dialogue: 0,0:16:50.68,0:16:54.68,Default,,0,0,0,,《Сіз байсалдысыз ба... Бір қысып 2 ұпай алуға болады!? 》
Dialogue: 0,0:16:59.77,0:17:03.47,Default,,0,0,0,,≪Қауіпсіз!
Dialogue: 0,0:17:03.47,0:17:05.46,Default,,0,0,0,,≪Kya~! Екінші нүкте.
Dialogue: 0,0:17:05.46,0:17:07.43,Default,,0,0,0,,≪Не? Жоғары жылдамдықты сырғанау!
Dialogue: 0,0:17:07.43,0:17:10.01,Default,,0,0,0,,≪Ол аяқ фол болып табылады.
Dialogue: 0,0:17:10.01,0:17:12.31,Default,,0,0,0,,Секигучи доп екінші!
Dialogue: 0,0:17:14.53,0:17:18.94,Default,,0,0,0,,≪Жақсы жүгіру! ≪Рё-сан тамаша жүгірді!
Dialogue: 0,0:17:18.94,0:17:22.84,Default,,0,0,0,,《Ақылмен бірінен соң бірі》
Dialogue: 0,0:17:22.84,0:17:26.81,Default,,0,0,0,,Вахаха! Сіз қалай ойлайсыз? Бұл менің №1 және 2 комбинациясы.
Dialogue: 0,0:17:26.81,0:17:29.28,Default,,0,0,0,,Вахаха.... Жақсы жүгіру.
Dialogue: 0,0:17:29.28,0:17:33.65,Default,,0,0,0,,Қайтадан қош келдіңіз. Апыр-ай! Жапонияда көктем бірінші орында.
Dialogue: 0,0:17:33.65,0:17:35.65,Default,,0,0,0,,Аа….
Dialogue: 0,0:17:35.65,0:17:37.64,Default,,0,0,0,,Керемет жүгіру Курамочи.
Dialogue: 0,0:17:37.64,0:17:39.84,Default,,0,0,0,,Ол қатеге байланысты базада болды.
Dialogue: 0,0:17:39.84,0:17:41.84,Default,,0,0,0,,Бұл ішкі хит!
Dialogue: 0,0:17:44.11,0:17:47.35,Default,,0,0,0,,《Ян: Кез келген биіктікке бейімделетін соққы техникасы →
Dialogue: 0,0:17:47.35,0:17:51.15,Default,,0,0,0,,Бірыңғай шабуыл базасы жүгіру》
Dialogue: 0,0:17:54.81,0:17:59.14,Default,,0,0,0,,《Бұл Жапониядағы бейсбол деңгейі》
Dialogue: 0,0:17:59.14,0:18:01.78,Default,,0,0,0,,Сен ақымақ.
Dialogue: 0,0:18:01.78,0:18:05.30,Default,,0,0,0,,Әлі біткен жоқ.
Dialogue: 0,0:18:05.30,0:18:08.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:08.80,0:18:21.32,Default,,0,0,0,,Сейдо Сейдо Сейдо….
Dialogue: 0,0:18:21.32,0:18:24.80,Default,,0,0,0,,Өйткені, қосымша нүкте - Сейдо.
Dialogue: 0,0:18:24.80,0:18:26.79,Default,,0,0,0,,Тамба мен Кавакамиді сақтаңыз→
Dialogue: 0,0:18:26.79,0:18:29.09,Default,,0,0,0,,2 иннинг қалды.
Dialogue: 0,0:18:29.09,0:18:34.31,Default,,0,0,0,,Акекаваның дәлдік машинасы да жақсы лақтырды...
Dialogue: 0,0:18:34.31,0:18:37.82,Default,,0,0,0,,Бұл соңы.
Dialogue: 0,0:18:37.82,0:18:46.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:46.64,0:18:49.50,Default,,0,0,0,,Сен соғуға болады, Секигучи. Домалаңыз!
Dialogue: 0,0:18:49.50,0:18:51.65,Default,,0,0,0,,Алда әлі көп нәрсе бар.
Dialogue: 0,0:18:51.65,0:18:54.13,Default,,0,0,0,,Жақсы доп, Нори-сенпай.
Dialogue: 0,0:18:54.13,0:18:56.44,Default,,0,0,0,,Соқсын. Екі шықты.
Dialogue: 0,0:18:56.44,0:19:00.64,Default,,0,0,0,,Өтінемін, Каваками, біздің эйс.
Dialogue: 0,0:19:00.64,0:19:02.62,Default,,0,0,0,,《Нүктелік айырмашылық бар.
Dialogue: 0,0:19:02.62,0:19:07.15,Default,,0,0,0,,Кавакамидің соңына дейін питчингіңізді ұстаныңыз
Dialogue: 0,0:19:07.15,0:19:09.47,Default,,0,0,0,,Уф.
Dialogue: 0,0:19:09.47,0:19:12.33,Default,,0,0,0,,《Танба мырза қорғанға оралғанша→
Dialogue: 0,0:19:12.33,0:19:14.64,Default,,0,0,0,,Оны толығымен басыңыз.
Dialogue: 0,0:19:14.64,0:19:17.61,Default,,0,0,0,,Кез келген қарсылас! 》
Dialogue: 0,0:19:17.61,0:19:24.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:24.33,0:19:26.30,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:19:26.30,0:19:28.97,Default,,0,0,0,,Жақсы, Каваками. Керемет доп!
Dialogue: 0,0:19:28.97,0:19:32.27,Default,,0,0,0,,Нори-сенпай жақсы доп! Ұстамдылық Эйс!
Dialogue: 0,0:19:34.91,0:19:37.16,Default,,0,0,0,,《Себебі мен оны басынан дайындадым→
Dialogue: 0,0:19:37.16,0:19:39.51,Default,,0,0,0,,Ашуым түсіп қала ма деп уайымдадым→
Dialogue: 0,0:19:39.51,0:19:45.12,Default,,0,0,0,,Бұл жігіт ақыры жеңілдетуші болып үйренген.
Dialogue: 0,0:19:45.12,0:19:47.32,Default,,0,0,0,,Уф.
Dialogue: 0,0:19:47.32,0:19:50.21,Default,,0,0,0,,《Жарайды, соңына дейін осылай болыңыз》
Dialogue: 0,0:19:50.21,0:19:54.31,Default,,0,0,0,,Сабыр ет, Секигучи. Допқа мұқият қараңыз.
Dialogue: 0,0:19:54.31,0:19:59.48,Default,,0,0,0,,《Екі шығу, 2-база, Ян әдейі алды, бірақ→
Dialogue: 0,0:19:59.48,0:20:03.99,Default,,0,0,0,,Акекавада қорқынышты соққылар жоқ.
Dialogue: 0,0:20:03.99,0:20:06.79,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:06.79,0:20:10.46,Default,,0,0,0,,Ей, жылама! Ойын әлі аяқталған жоқ.
Dialogue: 0,0:20:10.46,0:20:14.51,Default,,0,0,0,,Соңына дейін берілме. Айтыңызшы!
Dialogue: 0,0:20:14.51,0:20:17.11,Default,,0,0,0,,《Сыртқа шығатын сырғытпа》
Dialogue: 0,0:20:21.14,0:20:24.64,Default,,0,0,0,,《Мына жігіт шешеді! Нори! 》
Dialogue: 0,0:20:24.64,0:20:31.35,Default,,0,0,0,,《Оның әлі біткенін қаламаймын.
Dialogue: 0,0:20:31.35,0:20:35.35,Default,,0,0,0,,Үйдегідей аулақ жүр...》
Dialogue: 0,0:20:42.64,0:20:46.65,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:20:46.65,0:20:49.13,Default,,0,0,0,,Рақмет. Ал отбасың ше?
Dialogue: 0,0:20:49.13,0:20:51.13,Default,,0,0,0,,Жарайсыңдар! Нори-сенпай!
Dialogue: 0,0:20:53.82,0:20:56.61,Default,,0,0,0,,Такако-сенпай жеңді мен жеңдім!
Dialogue: 0,0:20:56.61,0:20:59.26,Default,,0,0,0,,Иә! Ша~!
Dialogue: 0,0:20:59.26,0:21:05.78,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:05.78,0:21:08.88,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:21:11.20,0:21:17.50,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:23.77,0:21:25.77,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:21:25.77,0:21:29.47,Default,,0,0,0,,Енді сапқа тұрыңдар! Мақтанышпен сапқа тұрайық.
Dialogue: 0,0:21:29.47,0:21:33.29,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:33.29,0:21:38.98,Default,,0,0,0,,7-ші иннингте, 1 және 2 сандары жұмыс істеген кезде, Сейдоның соққылар тізбегі ақыры жарылып кетті.
Dialogue: 0,0:21:38.98,0:21:44.97,Default,,0,0,0,,7-ден 2-ге... Соңында бұл Сейдоның толық жеңісі болды...
Dialogue: 0,0:21:44.97,0:21:50.14,Default,,0,0,0,,Керемет ойын! 《Менікі: Әрине, топырақтың беріктігінде айырмашылық болды.
Dialogue: 0,0:21:50.14,0:21:53.35,Default,,0,0,0,,Бірақ Сейдо жағы үшін маңыздысы → болды
Dialogue: 0,0:21:53.35,0:21:58.85,Default,,0,0,0,,Бірінші курстың екі студенті жеті рет ойын құрды...》
Dialogue: 0,0:22:05.44,0:22:08.64,Default,,0,0,0,,7-ден 2-ге дейін Сейдо! Рақмет сізге! !
Dialogue: 0,0:22:08.64,0:22:10.68,Default,,0,0,0,,Мен жасадым! !
Dialogue: 0,0:22:10.68,0:22:15.48,Default,,0,0,0,,(ойынның соңындағы сирена)
Dialogue: 0,0:22:23.61,0:22:26.45,Default,,0,0,0,,Ян Шуншин.
Dialogue: 0,0:22:26.45,0:22:31.15,Default,,0,0,0,,Сізбен жарысу қызық болды. Келесі жылы кездескенше.
Dialogue: 0,0:22:31.15,0:22:33.80,Default,,0,0,0,,Хун.
Dialogue: 0,0:22:33.80,0:22:36.10,Default,,0,0,0,,《Келесі жылы...》
Dialogue: 0,0:22:39.47,0:22:43.36,Default,,0,0,0,,Мойынды жуып, күт.
Dialogue: 0,0:22:43.36,0:22:46.10,Default,,0,0,0,,《Фуруя: ол сөздерді қайда айттың...》
Dialogue: 0,0:22:46.10,0:22:49.02,Default,,0,0,0,,Мен мұны әлі орындадым деп ойламаймын!
Dialogue: 0,0:22:49.02,0:22:51.62,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:22:53.97,0:22:57.86,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:22:57.86,0:23:01.78,Default,,0,0,0,,Мен саған соңына дейін көмектесе алмадым...
Dialogue: 0,0:23:01.78,0:23:06.70,Default,,0,0,0,,Біз үш жылдан кейін зейнетке шығамыз, сондықтан мағынасы бар.→
Dialogue: 0,0:23:06.70,0:23:10.59,Default,,0,0,0,,Сіз...
Dialogue: 0,0:23:10.59,0:23:13.48,Default,,0,0,0,,≪Жақсы ойын!
Dialogue: 0,0:23:13.48,0:23:15.81,Default,,0,0,0,,(шапалақтау)
Dialogue: 0,0:23:15.81,0:23:18.16,Default,,0,0,0,,Балалар сендер жақсы жұмыс жасадыңдар!
Dialogue: 0,0:23:18.16,0:23:20.47,Default,,0,0,0,,Кеудеңді жоғары ұста, Акекава!
Dialogue: 0,0:23:20.47,0:23:22.45,Default,,0,0,0,,Бұл жақсы сәйкестік болды!
Dialogue: 0,0:23:22.45,0:23:24.84,Default,,0,0,0,,Акикава - ең жақсы! Мен жасырын→
Dialogue: 0,0:23:24.84,0:23:27.61,Default,,0,0,0,,Мен саған құмар болдым. ≪Аа, сен де.
Dialogue: 0,0:23:27.61,0:23:32.51,Default,,0,0,0,,≪Жарайсыңдар балалар! ≪ Керемет алаң!
Dialogue: 0,0:23:32.51,0:23:35.50,Default,,0,0,0,,≪Mr. Ян! ≪Келесі жылы бар күшіңізді салыңыз.
Dialogue: 0,0:23:35.50,0:23:39.50,Default,,0,0,0,,≪Мен оны асыға күтемін, Шуншин! ≪Шуншин!
Dialogue: 0,0:23:41.95,0:23:48.31,Default,,0,0,0,,《… соңына дейін→
Dialogue: 0,0:23:48.31,0:23:53.22,Default,,0,0,0,,Маған бейсбол ойнаған ұнады...
Dialogue: 0,0:23:53.22,0:23:56.10,Default,,0,0,0,,Мен өкінбеймін...》
Dialogue: 0,0:23:56.10,0:24:10.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:10.82,0:24:13.10,Default,,0,0,0,,《Өкінішті...》
Dialogue: 0,0:24:13.10,0:24:21.98,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:21.98,0:24:25.33,Default,,0,0,0,,Әлі күз бар.
Dialogue: 0,0:24:25.33,0:24:28.47,Default,,0,0,0,,Ал Сенбатсу...
Dialogue: 0,0:24:28.47,0:24:33.04,Default,,0,0,0,,《Огата: Иә... Бұл соңы емес, Шуншин.
Dialogue: 0,0:24:33.04,0:24:35.64,Default,,0,0,0,,Бұл соңы емес...》
Dialogue: 0,0:24:40.26,0:24:43.20,Default,,0,0,0,,Сейдо! (Хосоямада) Тецу-сан!
Dialogue: 0,0:24:43.20,0:24:45.22,Default,,0,0,0,,≪Mr. Катаока!
Dialogue: 0,0:24:45.22,0:24:47.12,Default,,0,0,0,,Осы жылы Қошиенге барайық!
Dialogue: 0,0:24:47.12,0:24:49.47,Default,,0,0,0,,Балалар, бара беріңдер! Мен тағы келемін!
Dialogue: 0,0:24:49.47,0:24:51.52,Default,,0,0,0,,Вахахахаха!
Dialogue: 0,0:24:51.52,0:24:54.01,Default,,0,0,0,,Алаңдама, Савамура!
Dialogue: 0,0:24:54.01,0:24:56.11,Default,,0,0,0,,Бұл кездейсоқтық!
Dialogue: 0,0:24:59.95,0:25:03.15,Default,,0,0,0,,Қолдауыңыз үшін рахмет!
Dialogue: 0,0:25:03.15,0:25:06.14,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:25:06.14,0:25:09.84,Default,,0,0,0,,<Сейдо Акикаваға қарсы, 7-ден 2-ге дейін.
Dialogue: 0,0:25:09.84,0:25:13.14,Default,,0,0,0,,Сеидо орта мектебі 8-ші орынға көтеріледі
Dialogue: 0,0:25:14.64,0:25:20.64,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory