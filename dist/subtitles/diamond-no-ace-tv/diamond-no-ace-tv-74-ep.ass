Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,3:52:31.39,3:52:35.36,Default,,0,0,0,,Маған қалдырыңыз! Эй!
Dialogue: 0,3:52:35.36,3:52:38.21,Default,,0,0,0,,1 шықты, Тамба! (Рйосуке) Мен жасаймын, жақсы жігіт.
Dialogue: 0,3:52:38.21,3:52:40.25,Default,,0,0,0,,Уга!
Dialogue: 0,3:52:40.25,3:52:42.59,Default,,0,0,0,,《Тамба: Жарайды! Мен Фуруяны жеңдім! 》
Dialogue: 0,3:52:42.59,3:52:45.70,Default,,0,0,0,,Уф!
Dialogue: 0,3:52:45.70,3:52:48.62,Default,,0,0,0,,Zono Сіз келесі шайқассыз!
Dialogue: 0,3:52:48.62,3:52:51.62,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,3:52:54.71,3:52:59.29,Default,,0,0,0,,《Маэзоно: Бұл не...?
Dialogue: 0,3:52:59.29,3:53:01.39,Default,,0,0,0,,Мені мүлде тыңдама! 》
Dialogue: 0,3:55:50.39,3:55:53.28,Default,,0,0,0,,Гетто? Қандай ысырап.
Dialogue: 0,3:55:53.28,3:55:56.83,Default,,0,0,0,,Шығынсыз жүйрік 1-2 жыл босқа кетті!
Dialogue: 0,3:55:56.83,3:55:58.90,Default,,0,0,0,,Бұйырғандай, ақымақ!
Dialogue: 0,3:55:58.90,3:56:00.93,Default,,0,0,0,,Сіз шынымен ұпай алғыңыз келе ме? ?
Dialogue: 0,3:56:00.93,3:56:02.97,Default,,0,0,0,,Мен сізді қорғау үшін ешқандай қысым сезінбеймін.
Dialogue: 0,3:56:02.97,3:56:05.24,Default,,0,0,0,,Шынында да.
Dialogue: 0,3:56:05.24,3:56:07.54,Default,,0,0,0,,Енді басқа адамға да оңай!
Dialogue: 0,3:56:09.74,3:56:13.40,Default,,0,0,0,,Ештеңені қайтаруға мүмкіндік жоқ. Бұл тым қарапайым.
Dialogue: 0,3:56:13.40,3:56:15.40,Default,,0,0,0,,Миюки.
Dialogue: 0,3:56:19.42,3:56:22.05,Default,,0,0,0,,Сіз тыңдадыңыз ба?
Dialogue: 0,3:56:22.05,3:56:24.55,Default,,0,0,0,,Қый!
Dialogue: 0,3:56:32.68,3:56:35.40,Default,,0,0,0,,Не істеп жатырсың! Тез қорғанысқа шығыңыз!
Dialogue: 0,3:56:35.40,3:56:37.90,Default,,0,0,0,,Иә, мен бірден барамын!
Dialogue: 0,3:56:40.07,3:56:42.21,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,3:56:42.21,3:56:46.91,Default,,0,0,0,,Сіз оны оңай қабылдадыңыз.
Dialogue: 0,3:56:46.91,3:56:49.37,Default,,0,0,0,,Сіз шынымен білесіз бе?
Dialogue: 0,3:56:49.37,3:56:52.03,Default,,0,0,0,,ше? Сен не айтып тұрсың?
Dialogue: 0,3:56:52.03,3:56:56.47,Default,,0,0,0,,ОБ емес жаттықтырушы келгеннен бері мен осындай нәрсе болуы мүмкін деп ойладым →
Dialogue: 0,3:56:56.47,3:56:59.56,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,3:56:59.56,3:57:03.66,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,3:57:05.76,3:57:08.37,Default,,0,0,0,,《Фуруя: Ол солай болды...》
Dialogue: 0,3:57:08.37,3:57:11.80,Default,,0,0,0,,Әйтеуір, бұл әңгіме кейінірек.
Dialogue: 0,3:57:11.80,3:57:14.39,Default,,0,0,0,,Енді ойынға назар аударайық.
Dialogue: 0,3:57:14.39,3:57:16.89,Default,,0,0,0,,Менің ағаларым да келді.
Dialogue: 0,3:57:23.60,3:57:26.20,Default,,0,0,0,,《Маэзоно: Күзгі турнирде...》
Dialogue: 0,3:57:26.20,3:57:29.71,Default,,0,0,0,,《Курамочи: Директор жұмыстан кетіп жатыр ма? 》
Dialogue: 0,3:57:29.71,3:57:32.62,Default,,0,0,0,,《Хигаса: Ендеше, менің ағаларым...》
Dialogue: 0,3:57:32.62,3:57:36.12,Default,,0,0,0,,《Хакушю: Ол тіпті жаттықтырушы үшін зейнеткерлікке шығу кездесуін кейінге қалдырды...》
Dialogue: 0,3:57:38.86,3:57:43.62,Default,,0,0,0,,《Маэзоно: Біз қазір не істей аламыз? ? 》
Dialogue: 0,3:57:43.62,3:57:47.72,Default,,0,0,0,,《Курамочи: Мен үлкендерге және директорға қалай жауап беруім керек? 》
Dialogue: 0,3:57:53.36,3:57:56.43,Default,,0,0,0,,Мұндай нәрсе жиі кездеседі ме? Канамару.
Dialogue: 0,3:57:56.43,3:58:00.72,Default,,0,0,0,,Бұл сіз сұрайтын нәрсе емес.
Dialogue: 0,3:58:00.72,3:58:06.18,Default,,0,0,0,,Әсіресе Кошиен, менің мақсатым баратын мықты мектеп.
Dialogue: 0,3:58:06.18,3:58:08.36,Default,,0,0,0,,Кеш болды. кешіріңіз.
Dialogue: 0,3:58:08.36,3:58:13.03,Default,,0,0,0,,《Шынымды айтсам, бар болғаны бір жастамыз→
Dialogue: 0,3:58:13.03,3:58:16.75,Default,,0,0,0,,Мен бұл оқиғаға не айтарымды білмеймін.
Dialogue: 0,3:58:16.75,3:58:21.67,Default,,0,0,0,,Бірақ мен мұны айта аламын.
Dialogue: 0,3:58:21.67,3:58:24.08,Default,,0,0,0,,Мен...》
Dialogue: 0,3:58:24.08,3:58:27.06,Default,,0,0,0,,《Мен...》
Dialogue: 0,3:58:27.06,3:58:30.86,Default,,0,0,0,,《Эйджун/Фуруя: Мені бұл адам әлі таныған жоқ! 》
Dialogue: 0,3:58:34.92,3:58:38.04,Default,,0,0,0,,Жарайды! соңғы!
Dialogue: 0,3:58:38.04,3:58:42.71,Default,,0,0,0,,((Юки: Қиындыққа тап болған кезде оны бетіне көрсетпе.
Dialogue: 0,3:58:42.71,3:58:45.70,Default,,0,0,0,,Капитан адасып қалса, топ шайқалады.
Dialogue: 0,3:58:45.70,3:58:52.05,Default,,0,0,0,,Сіздің айтқаныңыз бен істегеніңіздің барлығын әріптестеріңіз бақылап отырады.
Dialogue: 0,3:58:52.05,3:58:54.99,Default,,0,0,0,,Мұны ешқашан ұмытпаңыз.
Dialogue: 0,3:58:54.99,3:58:58.09,Default,,0,0,0,,Командаңыз үшін жетекші болыңыз! ))
Dialogue: 0,3:59:04.70,3:59:06.74,Default,,0,0,0,,Жүр, кеттік!
Dialogue: 0,3:59:06.74,3:59:09.71,Default,,0,0,0,,Барлығы жартылай ұйықтап жатқан →
Dialogue: 0,3:59:09.71,3:59:11.74,Default,,0,0,0,,Оян, Сақай!
Dialogue: 0,3:59:11.74,3:59:13.84,Default,,0,0,0,,О!
Dialogue: 0,3:59:13.84,3:59:17.38,Default,,0,0,0,,Әсіресе бұл құмыра, ол туралы айтуға тұрарлықтай даусыз!
Dialogue: 0,3:59:17.38,3:59:19.75,Default,,0,0,0,,Оны тез сүйреп түсірейік!
Dialogue: 0,3:59:19.75,3:59:23.39,Default,,0,0,0,,Хаха, бұл негізгі ойыншылармен зейнетке шығу матчы болса да →
Dialogue: 0,3:59:23.39,3:59:25.74,Default,,0,0,0,,Үшінші сынып оқушыларының дауысы көбірек.
Dialogue: 0,3:59:25.74,3:59:28.59,Default,,0,0,0,,Енді қайсысы белсенді екенін білмеймін.
Dialogue: 0,3:59:28.59,3:59:30.94,Default,,0,0,0,,Оны ұсақтаңыз, бірақ!
Dialogue: 0,3:59:30.94,3:59:33.51,Default,,0,0,0,,Қансай диалектісі Бұл мүмкін емес.
Dialogue: 0,3:59:33.51,3:59:36.03,Default,,0,0,0,,Фуруя!
Dialogue: 0,3:59:36.03,3:59:40.12,Default,,0,0,0,,Енді болашақ туралы ойлаудың қажеті жоқ. Бар күшіңізбен жүріңіз!
Dialogue: 0,3:59:40.12,3:59:42.04,Default,,0,0,0,,Аа...
Dialogue: 0,3:59:42.04,3:59:45.54,Default,,0,0,0,,Бұл адамдар келісімді оңай бұзуға мүмкіндік бермейді →
Dialogue: 0,3:59:45.54,3:59:48.09,Default,,0,0,0,,Температура туралы алаңдаудан гөрі →
Dialogue: 0,3:59:48.09,3:59:51.21,Default,,0,0,0,,Сізде қазір бар күшіңізді пайдаланудан басқа амалыңыз жоқ.
Dialogue: 0,3:59:51.21,3:59:54.38,Default,,0,0,0,,Ей, сен болашақты ойлама...
Dialogue: 0,3:59:54.38,3:59:57.30,Default,,0,0,0,,《Бұрынғыға мүлдем қарама-қайшы...》
Dialogue: 0,3:59:57.30,4:00:01.60,Default,,0,0,0,,Хи хи... Қарттарды күшпен түсірейік!
Dialogue: 0,4:00:07.20,4:00:10.97,Default,,0,0,0,,Біз бетпе-бет жарысудан ләззат аламыз →
Dialogue: 0,4:00:10.97,4:00:14.27,Default,,0,0,0,,Доп ұшқанда, Сәлем айт, Бак!
Dialogue: 0,4:00:16.39,4:00:20.09,Default,,0,0,0,,Қандай нұсқаулар! Фуруя үлкен мәміле болады!
Dialogue: 0,4:00:20.09,4:00:22.49,Default,,0,0,0,,Сонда сенің анау тентектен еш айырмашылығың жоқ!
Dialogue: 0,4:00:22.49,4:00:24.43,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,4:00:24.43,4:00:27.88,Default,,0,0,0,,Капитан сияқты дәлірек және тапқыр нұсқауларды іздейміз!
Dialogue: 0,4:00:27.88,4:00:30.39,Default,,0,0,0,,Жақсы жұмыс, Миюки!
Dialogue: 0,4:00:30.39,4:00:32.77,Default,,0,0,0,,Егер сіз оны тікелей қабылдасаңыз!
Dialogue: 0,4:00:32.77,4:00:36.16,Default,,0,0,0,,Қайталанған төрт доппен өзін-өзі жоюға болмайды!
Dialogue: 0,4:00:36.16,4:00:49.76,Default,,0,0,0,,♪♪~
Dialogue: 0,4:00:53.48,4:00:56.71,Default,,0,0,0,,《Бұл ақымақ》
Dialogue: 0,4:00:56.71,4:00:58.75,Default,,0,0,0,,Қатарынан екі соққы!
Dialogue: 0,4:00:58.75,4:01:00.70,Default,,0,0,0,,Бұл жолы үшеуміз шапалақтаймыз!
Dialogue: 0,4:01:00.70,4:01:04.05,Default,,0,0,0,,А... Бұл Фуруяның бастапқы добы ма?
Dialogue: 0,4:01:04.05,4:01:06.76,Default,,0,0,0,,Хамф! Қызық болып барады.
Dialogue: 0,4:01:06.76,4:01:08.71,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,4:01:08.71,4:01:10.74,Default,,0,0,0,,Олардың барлығы дерлік дәл ортасында!
Dialogue: 0,4:01:10.74,4:01:12.73,Default,,0,0,0,,Фуруя Аураңызды алып тастаңыз!
Dialogue: 0,4:01:12.73,4:01:15.38,Default,,0,0,0,,Осылай питтингті жалғастыра беруге ешқандай мүмкіндік жоқ, солай ма?
Dialogue: 0,4:01:15.38,4:01:17.87,Default,,0,0,0,,Мынау мұны жасайды. а?
Dialogue: 0,4:01:17.87,4:01:20.80,Default,,0,0,0,,Бұл ең жақсы соққылар тізбегіне қарсы жұмыс істей алмайды!
Dialogue: 0,4:01:20.80,4:01:23.12,Default,,0,0,0,,Тым абайсыз... (Миюки) Хаха. сурет?
Dialogue: 0,4:01:23.12,4:01:25.62,Default,,0,0,0,,Бірақ жанып кетеді, солай ма?
Dialogue: 0,4:01:30.38,4:01:33.93,Default,,0,0,0,,Режиссердің әңгімесін естіп ренжігеніңізді түсіндім →
Dialogue: 0,4:01:33.93,4:01:37.55,Default,,0,0,0,,Біз қазір матч ойнап жатырмыз.
Dialogue: 0,4:01:37.55,4:01:39.55,Default,,0,0,0,,Кеттік!
Dialogue: 0,4:01:39.55,4:01:42.26,Default,,0,0,0,,Менің үлкендерім шындап күресіп жатыр.
Dialogue: 0,4:01:42.26,4:01:46.21,Default,,0,0,0,,Егер біз, ойыншылар, ойынмен жауап бермесек, не істейміз?
Dialogue: 0,4:01:46.21,4:01:57.92,Default,,0,0,0,,♪♪~
Dialogue: 0,4:01:57.92,4:02:00.04,Default,,0,0,0,,2 шықты!
Dialogue: 0,4:02:00.04,4:02:04.48,Default,,0,0,0,,Бүгін Танба-санды жеңу өте қиын болады деп ойлаймын.
Dialogue: 0,4:02:04.48,4:02:08.25,Default,,0,0,0,,Сізді бұрышқа итеріп жібергенше, өз мақсаттарыңызға назар аударыңыз және белсенді болыңыз.
Dialogue: 0,4:02:08.25,4:02:10.37,Default,,0,0,0,,((Тым қатты ойламаңыз.
Dialogue: 0,4:02:10.37,4:02:13.92,Default,,0,0,0,,Бізге қолымыздан келгенін істеу керек))
Dialogue: 0,4:02:13.92,4:02:17.69,Default,,0,0,0,,Егер сіз жүгіруші алсаңыз, мүмкіндігіңізді арттыру үшін оларды қосуды ұмытпаңыз.
Dialogue: 0,4:02:17.69,4:02:21.41,Default,,0,0,0,,Әрқашан директордың айтқанын орындаңыз.
Dialogue: 0,4:02:21.41,4:02:23.41,Default,,0,0,0,,Фуши!
Dialogue: 0,4:02:25.55,4:02:27.70,Default,,0,0,0,,Ереуіл! Қамырды тастаңыз!
Dialogue: 0,4:02:27.70,4:02:29.92,Default,,0,0,0,,Уау! !
Dialogue: 0,4:02:29.92,4:02:32.27,Default,,0,0,0,,Одан қалмау үшін, ол да шығып кетті.
Dialogue: 0,4:02:32.27,4:02:35.41,Default,,0,0,0,,Тамба кіші жасөспірімдерге қарсы жақсы өнер көрсетеді.
Dialogue: 0,4:02:35.41,4:02:39.21,Default,,0,0,0,,Ақымақ! Неліктен жазғы турнирде мұны жасай алмаймыз?
Dialogue: 0,4:02:39.21,4:02:41.22,Default,,0,0,0,,Сіз маңызды сәтке түсіп қалдыңыз!
Dialogue: 0,4:02:41.22,4:02:44.75,Default,,0,0,0,,Мен де дәл қазір осылай ойладым! Қарғыс атсын!
Dialogue: 0,4:02:44.75,4:02:46.89,Default,,0,0,0,,Бұл тек үш рет болды.
Dialogue: 0,4:02:46.89,4:02:50.43,Default,,0,0,0,,Ауыстыру. Мен баяу шабуыл жасаймын.
Dialogue: 0,4:02:50.43,4:02:57.08,Default,,0,0,0,,♪♪~
Dialogue: 0,4:02:57.08,4:02:59.08,Default,,0,0,0,,Фуруя жүгіруші!
Dialogue: 0,4:03:03.59,4:03:07.63,Default,,0,0,0,,《Күтілгендей, сіз жүгірушілерге мән бермейсіз》
Dialogue: 0,4:03:07.63,4:03:12.13,Default,,0,0,0,,《Сіз байсалдысыз ба... Бұл Тецу мырзамен бетпе-бет шайқас емес пе?》
Dialogue: 0,4:03:14.73,4:03:16.79,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,4:03:16.79,4:03:20.76,Default,,0,0,0,,Тецу! Фуруя жүр!
Dialogue: 0,4:03:20.76,4:03:26.06,Default,,0,0,0,,《Тодорокиге тиген доп төмен түссе тамаша болар еді! 》
Dialogue: 0,4:03:28.05,4:03:30.05,Default,,0,0,0,,Жүгіруші!
Dialogue: 0,4:03:37.26,4:03:42.53,Default,,0,0,0,,Уау! Мен Тецуды ұрып тастадым! ?
Dialogue: 0,4:03:42.53,4:03:45.05,Default,,0,0,0,,Шынымен, Фуруя! ? Жоқ, бұл кездейсоқтық!
Dialogue: 0,4:03:45.05,4:03:47.47,Default,,0,0,0,,Tsk! Әдемі төмен →
Dialogue: 0,4:03:47.47,4:03:49.72,Default,,0,0,0,,Бүгінгі ең жақсы доп емес пе? (Секи) Жоқ!
Dialogue: 0,4:03:49.72,4:03:52.12,Default,,0,0,0,,Фуруя бесінші рет соққыға жығылды.
Dialogue: 0,4:03:52.12,4:03:56.06,Default,,0,0,0,,Ахаха! Әлгі жігіттің моторы екінші реттен бастап толық газбен жұмыс істеп тұрды.
Dialogue: 0,4:03:56.06,4:04:01.53,Default,,0,0,0,,《Бұл бір сәт болды, бірақ бөліну дұрыс болмады》
Dialogue: 0,4:04:01.53,4:04:05.60,Default,,0,0,0,,《Қосқаныңызға шүкір.
Dialogue: 0,4:04:05.60,4:04:10.04,Default,,0,0,0,,Егер сіз қате қимыл жасасаңыз, төрт доптың кесірінен өзіңізді жоюыңыз мүмкін. Бұл жағдайда.
Dialogue: 0,4:04:10.04,4:04:13.07,Default,,0,0,0,,Жарайды, бұл жолы біз бірінші қамырдан бастаймыз.
Dialogue: 0,4:04:13.07,4:04:16.55,Default,,0,0,0,,Кеттік, Курамочи! (Ота) Даусымды таба бастағаныма бір-екі жыл болды.
Dialogue: 0,4:04:16.55,4:04:20.20,Default,,0,0,0,,Фуруяның питчингі командаға қуат берді.
Dialogue: 0,4:04:20.20,4:04:23.70,Default,,0,0,0,,《Сондықтан ол өте жақсы құмыра...》
Dialogue: 0,4:04:23.70,4:04:25.89,Default,,0,0,0,,Савамура Каваками.
Dialogue: 0,4:04:25.89,4:04:28.41,Default,,0,0,0,,Кез келген уақытта баруға дайын болыңыз.
Dialogue: 0,4:04:28.41,4:04:30.88,Default,,0,0,0,,《Ауыстыру? 》
Dialogue: 0,4:04:30.88,4:04:32.88,Default,,0,0,0,,Ооо... Мен дайынмын.
Dialogue: 0,4:04:32.88,4:04:36.47,Default,,0,0,0,,Қазір жасаңыз! Әлі ерте.
Dialogue: 0,4:04:36.47,4:04:40.04,Default,,0,0,0,,Мен мұндай соққының толқуынан ләззат ала алмаймын.
Dialogue: 0,4:04:40.04,4:04:44.74,Default,,0,0,0,,Эй, мен Кавакамиді түсінемін, бірақ Савамура да...
Dialogue: 0,4:04:44.74,4:04:47.53,Default,,0,0,0,,Дөңмай Дөңмай.
Dialogue: 0,4:04:47.53,4:04:50.88,Default,,0,0,0,,Жақсы жұмыс, жақсы жұмыс!
Dialogue: 0,4:04:50.88,4:04:56.03,Default,,0,0,0,,О, мен сенің оны бастан өткергеніңді қалаймын.
Dialogue: 0,4:04:56.03,4:04:59.60,Default,,0,0,0,,Алда болатын шайқас туралы ойлау...
Dialogue: 0,4:04:59.60,4:05:01.62,Default,,0,0,0,,Әй?
Dialogue: 0,4:05:01.62,4:05:04.71,Default,,0,0,0,,《Осы жазғы демалыс→
Dialogue: 0,4:05:04.71,4:05:07.38,Default,,0,0,0,,Іс жақсы жүрмейді→
Dialogue: 0,4:05:07.38,4:05:12.22,Default,,0,0,0,,Шынымды айтсам, менің күдігім мен уайымым одан сайын арта берді...
Dialogue: 0,4:05:12.22,4:05:18.24,Default,,0,0,0,,Бірақ бұл жолы мен қатты таң қалдым.
Dialogue: 0,4:05:18.24,4:05:22.04,Default,,0,0,0,,Күзгі университетті алайық.
Dialogue: 0,4:05:24.43,4:05:26.70,Default,,0,0,0,,Ой, кенет...
Dialogue: 0,4:05:26.70,4:05:30.12,Default,,0,0,0,,Комбинация әлі шешілген жоқ→
Dialogue: 0,4:05:30.12,4:05:33.17,Default,,0,0,0,,Мен сізге көбірек қысым жасауым мүмкін →
Dialogue: 0,4:05:33.17,4:05:39.47,Default,,0,0,0,,Күзгі университетте жеңіске жетсек, біз жеңімпаз боламыз!
Dialogue: 0,4:05:46.43,4:05:48.72,Default,,0,0,0,,Директордың кесірінен бе?→
Dialogue: 0,4:05:48.72,4:05:53.21,Default,,0,0,0,,Бұл мектеп жағдайына байланысты ма? Толық ақпаратты білмеймін →
Dialogue: 0,4:05:53.21,4:05:57.30,Default,,0,0,0,,Бізді жалғыз қалдырып, Кошиенге баруды ұйғарды →
Dialogue: 0,4:05:57.30,4:05:59.40,Default,,0,0,0,,Команда кете алмайды, солай ма?
Dialogue: 0,4:07:39.40,4:07:41.38,Default,,0,0,0,,Жарайды, міне келдік!
Dialogue: 0,4:07:41.38,4:07:43.39,Default,,0,0,0,,Курамочи Керемет соққы!
Dialogue: 0,4:07:43.39,4:07:46.59,Default,,0,0,0,,《Тск, анау бейбақ...》
Dialogue: 0,4:07:46.59,4:07:49.52,Default,,0,0,0,,Келіңіздер, осы мүмкіндікті пайдаланып көрейік!
Dialogue: 0,4:07:49.52,4:07:53.40,Default,,0,0,0,,((Біз өзімізді артта қалдырып, Кошиенге баруды шештік →
Dialogue: 0,4:07:53.40,4:07:55.36,Default,,0,0,0,,Команда кете алмайды, солай ма? ))
Dialogue: 0,4:07:55.36,4:07:58.03,Default,,0,0,0,,《Асо: Ю, жеңді...》
Dialogue: 0,4:07:58.03,4:08:01.14,Default,,0,0,0,,《Бұл оңай...》
Dialogue: 0,4:08:01.14,4:08:04.14,Default,,0,0,0,,《Кошиен...》
Dialogue: 0,4:08:06.06,4:08:08.13,Default,,0,0,0,,Болат!
Dialogue: 0,4:08:08.13,4:08:10.73,Default,,0,0,0,,《Мен сонша ұстамдылық жасасам да, мынау! 》
Dialogue: 0,4:08:13.38,4:08:16.37,Default,,0,0,0,,《Бұдан бас тартпа!
Dialogue: 0,4:08:16.37,4:08:24.06,Default,,0,0,0,,Сол сахнада тұру қандай тік және тар...
Dialogue: 0,4:08:24.06,4:08:27.75,Default,,0,0,0,,Бұл айтылғандай тәтті емес.
Dialogue: 0,4:08:27.75,4:08:30.75,Default,,0,0,0,,Сіз мұны білуіңіз керек! 》
Dialogue: 0,4:08:33.13,4:08:35.07,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,4:08:35.07,4:08:37.21,Default,,0,0,0,,Базаны ұрлау сәтті болды!
Dialogue: 0,4:08:37.21,4:08:39.21,Default,,0,0,0,,О, басынан.
Dialogue: 0,4:08:39.21,4:08:41.29,Default,,0,0,0,,А... бұл ыстық, Курамочи!
Dialogue: 0,4:08:41.29,4:08:44.79,Default,,0,0,0,,《Мына аяқтар пайдалы...》
Dialogue: 0,4:08:50.04,4:08:54.49,Default,,0,0,0,,《Қарғыс атсын, мен Миюкидің айла-амалына түсіп қалған сияқтымын→
Dialogue: 0,4:08:54.49,4:08:56.88,Default,,0,0,0,,Бұл тітіркендіргіш...
Dialogue: 0,4:08:56.88,4:09:01.40,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ! Біз мұны істеуіміз керек! 》
Dialogue: 0,4:09:01.40,4:09:03.80,Default,,0,0,0,,Коминато Жалғастырайық!
Dialogue: 0,4:09:03.80,4:09:08.55,Default,,0,0,0,,((Харуичи: екі ағайынды Кошиенге барудың бірінші және соңғы мүмкіндігі.
Dialogue: 0,4:09:08.55,4:09:11.42,Default,,0,0,0,,Мен міндетті түрде Кошиенге барғым келеді))
Dialogue: 0,4:09:11.42,4:09:15.73,Default,,0,0,0,,《Харуичи: Екі ағайынды сол сахнаға шықты...
Dialogue: 0,4:09:15.73,4:09:19.03,Default,,0,0,0,,Бұл арман орындалмаса да》
Dialogue: 0,4:09:22.68,4:09:27.18,Default,,0,0,0,,《Мен саған қамқор боламын! 》
Dialogue: 0,4:09:33.73,4:09:37.47,Default,,0,0,0,,О, мен оны ұстадым!
Dialogue: 0,4:09:37.47,4:09:40.07,Default,,0,0,0,,《Қауіпті》
Dialogue: 0,4:09:43.61,4:09:47.61,Default,,0,0,0,,《Оны жеңемін деп ойладың ба? Бұл соншалықты тәтті емес》
Dialogue: 0,4:09:51.25,4:09:53.55,Default,,0,0,0,,1-ден 1 шықты!
Dialogue: 0,4:09:57.07,4:09:59.55,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,4:09:59.55,4:10:01.94,Default,,0,0,0,,Қабылданбаған соққы!
Dialogue: 0,4:10:01.94,4:10:04.01,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,4:10:04.01,4:10:07.38,Default,,0,0,0,,2 тамаша Тамба!
Dialogue: 0,4:10:07.38,4:10:10.90,Default,,0,0,0,,Бұл жақсы курс, сондықтан мен оған көмектесе алмаймын →
Dialogue: 0,4:10:10.90,4:10:15.04,Default,,0,0,0,,Қане, жарғанақты терейік.
Dialogue: 0,4:10:15.04,4:10:17.54,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,4:10:17.54,4:10:24.13,Default,,0,0,0,,♪♪~
Dialogue: 0,4:10:24.13,4:10:28.23,Default,,0,0,0,,《Мен бүгін шынында да жүгіріп келе жатырмын》
Dialogue: 0,4:10:31.65,4:10:35.59,Default,,0,0,0,,((Мен таңғажайып қисық допты қаншалықты есте сақтауға тырыссам да →
Dialogue: 0,4:10:35.59,4:10:38.04,Default,,0,0,0,,Оны пайдаланған түзу.
Dialogue: 0,4:10:38.04,4:10:42.23,Default,,0,0,0,,Мұны ешқашан ұмытпаңыз))
Dialogue: 0,4:10:42.23,4:10:45.88,Default,,0,0,0,,《Мф, амалсыз күлдім.
Dialogue: 0,4:10:45.88,4:10:49.24,Default,,0,0,0,,Енді, ұятсыз кіші →
Dialogue: 0,4:10:49.24,4:10:53.07,Default,,0,0,0,,Осы жігітпен бітірейін бе?
Dialogue: 0,4:10:53.07,4:10:56.19,Default,,0,0,0,,Фуши!
Dialogue: 0,4:10:56.19,4:10:59.08,Default,,0,0,0,,((Миюки: түзу траекториямен →
Dialogue: 0,4:10:59.08,4:11:01.58,Default,,0,0,0,,Қамырдың қолына шөгу сияқты түседі))
Dialogue: 0,4:11:04.54,4:11:06.87,Default,,0,0,0,,《Шынымды айтсам, байқамайынша →
Dialogue: 0,4:11:06.87,4:11:10.54,Default,,0,0,0,,Доп бұлай керемет болады деп күтпедім, Танба-сан.
Dialogue: 0,4:11:10.54,4:11:15.28,Default,,0,0,0,,《Қарғыс атсын... Оқыдың ба?》
Dialogue: 0,4:11:15.28,4:11:17.38,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,4:11:20.55,4:11:22.55,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,4:11:22.55,4:11:25.69,Default,,0,0,0,,Тынш! Үйде!
Dialogue: 0,4:11:25.69,4:11:28.23,Default,,0,0,0,,No 4 Миюкидің уақытылылығы.
Dialogue: 0,4:11:28.23,4:11:31.41,Default,,0,0,0,,1 және 2 курс студенттері Қарсы шабуыл ақыры басталды.
Dialogue: 0,4:11:31.41,4:11:35.55,Default,,0,0,0,,Тыныш~ Матч осы жерден басталады!
Dialogue: 0,4:11:35.55,4:11:39.70,Default,,0,0,0,,Жалғастыр, Фуруя! Бар!
Dialogue: 0,4:11:39.70,4:11:41.79,Default,,0,0,0,,《Мені ұрғаның үшін рахмет.
Dialogue: 0,4:11:41.79,4:11:45.29,Default,,0,0,0,,Бұл сіз соқпайынша шешім қабылдай алмайтын көрініс.》
Dialogue: 0,4:11:49.23,4:11:51.93,Default,,0,0,0,,Бір ұпайды қайтарып аламын деп уайымдамаңыз!
Dialogue: 0,4:11:51.93,4:11:54.54,Default,,0,0,0,,Сенпай, менімен араласпа!
Dialogue: 0,4:11:54.54,4:12:08.42,Default,,0,0,0,,♪♪~
Dialogue: 0,4:12:08.42,4:12:10.54,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,4:12:10.54,4:12:13.20,Default,,0,0,0,,Жарайды! Сіз жақсы жердесіз, Коминато.
Dialogue: 0,4:12:13.20,4:12:17.58,Default,,0,0,0,,Тазалаудан бір ұпайға аман қалдыңыз ба?
Dialogue: 0,4:12:17.58,4:12:22.36,Default,,0,0,0,,Керемет доп Савамура! Біраз жылдамдықты азайтайық.
Dialogue: 0,4:12:22.36,4:12:26.23,Default,,0,0,0,,《Кезек маған келгенін білмеймін》
Dialogue: 0,4:12:26.23,4:12:28.25,Default,,0,0,0,,Иә.
Dialogue: 0,4:12:28.25,4:12:33.89,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,4:12:33.89,4:12:36.26,Default,,0,0,0,,Тынш! Мен жасаймын.
Dialogue: 0,4:12:36.26,4:12:38.21,Default,,0,0,0,,(Масуконың ішінің шұрылдаған дыбысы)
Dialogue: 0,4:12:38.21,4:12:45.05,Default,,0,0,0,,《Сол күні... Сол күннен бергі қорған.
Dialogue: 0,4:12:45.05,4:12:48.74,Default,,0,0,0,,Мен қазіргі адаммын...
Dialogue: 0,4:12:48.74,4:12:51.74,Default,,0,0,0,,Сіз өз командаңызға қаншалықты үлес қоса аласыз? 》
Dialogue: 0,4:12:55.21,4:12:59.05,Default,,0,0,0,,((Крис: Осы уақытқа дейін сіз тек шабуыл жасауға ғана назар аудардыңыз →
Dialogue: 0,4:12:59.05,4:13:02.35,Default,,0,0,0,,Бұл мен сенің ең көп алғың келген доп))
Dialogue: 0,4:13:05.41,4:13:09.38,Default,,0,0,0,,Аңға шығайық! (Кариба) Әлі лақтырып жатырсың ба? ?
Dialogue: 0,4:13:09.38,4:13:16.42,Default,,0,0,0,,♪♪~
Dialogue: 0,4:13:16.42,4:13:18.75,Default,,0,0,0,,Раа~!
Dialogue: 0,4:13:18.75,4:13:25.06,Default,,0,0,0,,♪♪~
Dialogue: 0,4:13:25.06,4:13:27.23,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,4:13:27.23,4:13:32.38,Default,,0,0,0,,♪♪~
Dialogue: 0,4:13:32.38,4:13:36.37,Default,,0,0,0,,Сәлем! Бар!
Dialogue: 0,4:13:36.37,4:13:39.54,Default,,0,0,0,,Oh~ 7-ші және 8-ші иннингтерде жүгіруге рұқсат етілмейді.
Dialogue: 0,4:13:39.54,4:13:41.88,Default,,0,0,0,,Каваками толығымен қайта жанданды ма?
Dialogue: 0,4:13:41.88,4:13:43.91,Default,,0,0,0,,《Жоқ, әлі жоқ.
Dialogue: 0,4:13:43.91,4:13:46.53,Default,,0,0,0,,Қорғаныстың көмектесетін жері көп.
Dialogue: 0,4:13:46.53,4:13:49.28,Default,,0,0,0,,Соңында Тецу-санға жүруге рұқсат берілді.
Dialogue: 0,4:13:49.28,4:13:54.78,Default,,0,0,0,,Төмен шабуыл мен қашудың арасында үлкен айырмашылық бар.
Dialogue: 0,4:13:59.36,4:14:03.38,Default,,0,0,0,,8 иннингтен кейін 1 ұпай айырмашылығы бар ма? Мен үш жыл бойы жолдасыммен жақсы жүрмін.
Dialogue: 0,4:14:03.38,4:14:07.25,Default,,0,0,0,,Фуруя мен Каваками бұл соққылар қатарын 3 ұпайға дейін ұстап тұр.
Dialogue: 0,4:14:07.25,4:14:09.90,Default,,0,0,0,,Бірақ мен оларды салыстырмаймын →
Dialogue: 0,4:14:09.90,4:14:13.00,Default,,0,0,0,,Бізде бұрынғы команда сияқты ұпай жинау мүмкіндігі жоқ.
Dialogue: 0,4:14:18.60,4:14:22.05,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,4:14:22.05,4:14:24.72,Default,,0,0,0,,Бұл үйге жүгіру болды! (Канамару) Міне!
Dialogue: 0,4:14:24.72,4:14:27.37,Default,,0,0,0,,Зоно-сенпайдың көптен күткен соққысы келді!
Dialogue: 0,4:14:27.37,4:14:30.54,Default,,0,0,0,,Уау! Your claws are sweet.
Dialogue: 0,4:14:30.54,4:14:33.38,Default,,0,0,0,,О!
Dialogue: 0,4:14:33.38,4:14:35.53,Default,,0,0,0,,Басс өте жылдам айналады!
Dialogue: 0,4:14:35.53,4:14:37.95,Default,,0,0,0,,Тыныштал, Зоно!
Dialogue: 0,4:14:37.95,4:14:40.70,Default,,0,0,0,,《Хмф... Ақыры дұрыс болып көрінетін нәрсені таптыңыз.
Dialogue: 0,4:14:40.70,4:14:43.69,Default,,0,0,0,,Қандай жағдай болмасын, тек оңды мақсат етпе →
Dialogue: 0,4:14:43.69,4:14:46.42,Default,,0,0,0,,Сізге тек дұрыс соққы беру керек.
Dialogue: 0,4:14:46.42,4:14:52.90,Default,,0,0,0,,Мендей емес, сен кәдімгі тартымшысың.
Dialogue: 0,4:14:52.90,4:14:56.00,Default,,0,0,0,,Оны соққан адам ең таң қалдырса керек!
Dialogue: 0,4:14:58.04,4:15:00.20,Default,,0,0,0,,Көз жасыңды құрғат!
Dialogue: 0,4:15:00.20,4:15:03.59,Default,,0,0,0,,Джара~! (Канамару) Жақсы соққы, Зоно-сенпай!
Dialogue: 0,4:15:03.59,4:15:08.03,Default,,0,0,0,,Галстук! Бірден жағдайды өзгертейік! Хаха!
Dialogue: 0,4:15:08.03,4:15:10.62,Default,,0,0,0,,Савамура!
Dialogue: 0,4:15:10.62,4:15:12.62,Default,,0,0,0,,Келесі жолы барайық.
Dialogue: 0,4:15:14.54,4:15:17.21,Default,,0,0,0,,Үйге жүгірген Зоно-сенпайға кезек келді.
Dialogue: 0,4:15:17.21,4:15:20.96,Default,,0,0,0,,Бұл жолы мен курсқа әрең дайындаламын.
Dialogue: 0,4:15:20.96,4:15:23.76,Default,,0,0,0,,Ауыстыру курсына назар аударайық.
Dialogue: 0,4:15:26.38,4:15:30.70,Default,,0,0,0,,(жүрек тондары)
Dialogue: 0,4:15:30.70,4:15:33.05,Default,,0,0,0,,Мен бір ғана нәрсені білгім келеді.
Dialogue: 0,4:15:33.05,4:15:38.55,Default,,0,0,0,,Сіз командаға дәл қазір қажет күшсіз бе.
Dialogue: 0,4:15:43.10,4:15:45.58,Default,,0,0,0,,3 өзгерту!
Dialogue: 0,4:15:45.58,4:15:48.18,Default,,0,0,0,,Менімен араласпа!
Dialogue: 0,4:15:50.81,4:15:54.31,Default,,0,0,0,,Енді... кеттік.
Dialogue: 0,4:15:58.03,4:16:00.25,Default,,0,0,0,,Савамура осында ма?
Dialogue: 0,4:16:00.25,4:16:02.65,Default,,0,0,0,,Ол құнды оңтүстік шылау болғанымен →
Dialogue: 0,4:16:02.65,4:16:06.95,Default,,0,0,0,,Өйткені Якушимен жаттығу матчын бұзған ол.
Dialogue: 0,4:16:08.97,4:16:10.97,Default,,0,0,0,,Крис.
Dialogue: 0,4:16:13.19,4:16:15.20,Default,,0,0,0,,Эйджун-кун, сені ұруға рұқсат ет!
Dialogue: 0,4:16:15.20,4:16:17.60,Default,,0,0,0,,Бірінші шайқау маңызды, Савамура!
Dialogue: 0,4:16:17.60,4:16:19.62,Default,,0,0,0,,Бірінші нәрсе!
Dialogue: 0,4:16:19.62,4:16:24.52,Default,,0,0,0,,《Тыныш... Мен бастапқыда қолынан ешнәрсе келетін құмыра емеспін.
Dialogue: 0,4:16:24.52,4:16:29.44,Default,,0,0,0,,Сіз жасай алатын нәрселердің шегі бар.
Dialogue: 0,4:16:29.44,4:16:34.80,Default,,0,0,0,,Бірақ... бұл сіз ештеңе істей алмайсыз дегенді білдірмейді! 》
Dialogue: 0,4:16:34.80,4:16:37.80,Default,,0,0,0,,Жаттықтырушы, ойыншыларды ауыстырыңыз.
Dialogue: 0,4:16:40.05,4:16:42.09,Default,,0,0,0,,Балалар, сендер де дайындалыңдар.
Dialogue: 0,4:16:42.09,4:16:44.94,Default,,0,0,0,,Әрине! Кез келген уақытта бара аласыз.
Dialogue: 0,4:16:44.94,4:16:50.55,Default,,0,0,0,,Өлтіретін қарулар бірінен соң бірі енгізіледі. Өзіңді дайында, Савамура!
Dialogue: 0,4:16:50.55,4:16:53.13,Default,,0,0,0,,Оны үрлеуге қымсынбаңыз.
Dialogue: 0,4:16:53.13,4:16:55.23,Default,,0,0,0,,О, рахмет.
Dialogue: 0,4:17:00.81,4:17:03.41,Default,,0,0,0,,Бұл шымшып ұрушы Крис, ақымақ!
Dialogue: 0,4:17:10.05,4:17:12.35,Default,,0,0,0,,《Крис Сенпай...》
Dialogue: 0,4:17:13.85,4:17:19.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory