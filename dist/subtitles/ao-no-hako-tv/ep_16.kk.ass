Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.04,0:00:04.92,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:05.54,0:00:07.25,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:07.34,0:00:09.34,Default,,0,0,0,,Сіз әдеттегідей ерте оянасыз.
Dialogue: 0,0:00:09.84,0:00:11.30,Default,,0,0,0,,Бүгін жаңа семестр басталады.
Dialogue: 0,0:00:11.38,0:00:13.47,Default,,0,0,0,,Керемет ұйқы
Dialogue: 0,0:00:13.55,0:00:14.43,Default,,0,0,0,,Осы жерде
Dialogue: 0,0:00:14.51,0:00:15.51,Default,,0,0,0,,Не!
Dialogue: 0,0:00:16.18,0:00:16.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:17.97,0:00:19.39,Default,,0,0,0,,Мануке позасы!
Dialogue: 0,0:00:22.35,0:00:23.44,Default,,0,0,0,,Теңізге барғаннан кейін
Dialogue: 0,0:00:24.02,0:00:27.31,Default,,0,0,0,,Чинацу-сенпай екеуміздің арамызда бірдеңе болды.
Dialogue: 0,0:00:27.40,0:00:28.94,Default,,0,0,0,,Мен оның жоғалып кеткенін сеземін
Dialogue: 0,0:00:29.52,0:00:33.03,Default,,0,0,0,,Әдеттегідей мен Чинацу-сенпайды жақсы көремін.
Dialogue: 0,0:00:33.53,0:00:35.99,Default,,0,0,0,,Чинацу-сенпай баскетболда көп жұмыс істейді.
Dialogue: 0,0:00:36.49,0:00:38.20,Default,,0,0,0,,Сондықтан біз бірге тұрамыз
Dialogue: 0,0:00:39.37,0:00:42.54,Default,,0,0,0,,Бірақ бұрынғыдан да анық...
Dialogue: 0,0:00:43.54,0:00:45.54,Default,,0,0,0,,♪~
Dialogue: 0,0:02:10.50,0:02:12.50,Default,,0,0,0,,~♪
Dialogue: 0,0:02:13.63,0:02:15.17,Default,,0,0,0,,Біздің сыныптағы көрсеткішіміз
Dialogue: 0,0:02:15.26,0:02:16.71,Default,,0,0,0,,Басты рөлдегі Хина Чоно
Dialogue: 0,0:02:16.80,0:02:19.55,Default,,0,0,0,,«Ақшақар» шешілді.
Dialogue: 0,0:02:19.63,0:02:21.43,Default,,0,0,0,,Ал, маған қалдырыңыз.
Dialogue: 0,0:02:22.01,0:02:23.81,Default,,0,0,0,,Кемеге мінгендей
Dialogue: 0,0:02:23.89,0:02:24.72,Default,,0,0,0,,Кеме?
Dialogue: 0,0:02:25.56,0:02:28.02,Default,,0,0,0,,Жолдарды есте сақтай аласыз ба?
Dialogue: 0,0:02:28.10,0:02:30.81,Default,,0,0,0,,Көпшіліктің алдына шығуға үйреніп қалған шығарсың.
Dialogue: 0,0:02:33.94,0:02:34.98,Default,,0,0,0,,Үлкен қуаныш
Dialogue: 0,0:02:35.48,0:02:36.82,Default,,0,0,0,,Өйткені сіз сынып өкілісіз.
Dialogue: 0,0:02:36.90,0:02:39.11,Default,,0,0,0,,Мені жақсы жүргізуіңізді сұраймын.
Dialogue: 0,0:02:39.20,0:02:42.07,Default,,0,0,0,,Мен сынып өкілі болсам да, мен жай жұмыспын.
Dialogue: 0,0:02:42.95,0:02:45.54,Default,,0,0,0,,Спектакльді режиссер Шимазаки мырза қояды.
Dialogue: 0,0:02:45.62,0:02:46.91,Default,,0,0,0,,Біз есімізді жоғалтқан болармыз, иә?
Dialogue: 0,0:02:47.00,0:02:48.62,Default,,0,0,0,,Оны Ниина-чанға қалдырмаңыз
Dialogue: 0,0:02:48.71,0:02:52.13,Default,,0,0,0,,Мәселе туындаса да, маған бәрі бір қалыпты өтуіне көз жеткізуіңіз керек.
Dialogue: 0,0:02:52.21,0:02:54.34,Default,,0,0,0,,Бұған дейін ешқандай қиындық тудырмаңыз.
Dialogue: 0,0:02:55.34,0:02:57.38,Default,,0,0,0,,Жарайды, мен де оны асыға күтемін.
Dialogue: 0,0:02:57.46,0:02:59.97,Default,,0,0,0,,Біз сізге барынша қолдау көрсетеміз.
Dialogue: 0,0:03:02.14,0:03:02.97,Default,,0,0,0,,Иноматалар
Dialogue: 0,0:03:04.14,0:03:05.85,Default,,0,0,0,,Бұл қатысушылар тізімінің басып шығарылған нұсқасы.
Dialogue: 0,0:03:05.93,0:03:08.02,Default,,0,0,0,,Сіз оны екінші курс студентіне бересіз бе?
Dialogue: 0,0:03:11.06,0:03:11.73,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:12.73,0:03:13.98,Default,,0,0,0,,Мен біраз уақытқа барамын.
Dialogue: 0,0:03:14.06,0:03:15.77,Default,,0,0,0,,Сіз көп жұмыс жасайсыз.
Dialogue: 0,0:03:16.27,0:03:18.74,Default,,0,0,0,,Менің ойымша, үй жұмыстарын орындау да дене күшін қалыптастырудың бір жолы.
Dialogue: 0,0:03:18.82,0:03:20.20,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:03:22.61,0:03:23.74,Default,,0,0,0,,Осымен
Dialogue: 0,0:03:24.28,0:03:26.83,Default,,0,0,0,,Мен Дайкиден сұрамадым.
Dialogue: 0,0:03:27.33,0:03:29.62,Default,,0,0,0,,Мойындау
Dialogue: 0,0:03:29.70,0:03:30.62,Default,,0,0,0,,Не!
Dialogue: 0,0:03:30.71,0:03:31.66,Default,,0,0,0,,Дауыс керемет!
Dialogue: 0,0:03:31.75,0:03:34.50,Default,,0,0,0,,Ах... сөйлеуге машық...
Dialogue: 0,0:03:35.00,0:03:35.75,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:37.75,0:03:41.76,Default,,0,0,0,,Дайки Чинацу-сенпайды ұнатады, тіпті олар бірге тұрады.
Dialogue: 0,0:03:41.84,0:03:43.93,Default,,0,0,0,,Сіз бос емессіз.
Dialogue: 0,0:03:44.01,0:03:45.80,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:03:45.89,0:03:46.89,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:47.97,0:03:49.14,Default,,0,0,0,,Жарайды, оған көмектесу мүмкін емес.
Dialogue: 0,0:03:49.22,0:03:50.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:50.52,0:03:53.52,Default,,0,0,0,,Мен сені сүйетінімді түсіндім.
Dialogue: 0,0:03:54.65,0:03:55.27,Default,,0,0,0,,Балапандар!
Dialogue: 0,0:03:55.98,0:03:57.27,Default,,0,0,0,,Хойхой!
Dialogue: 0,0:03:58.23,0:04:01.53,Default,,0,0,0,,Сонда да қиын, солай емес пе?
Dialogue: 0,0:04:04.11,0:04:05.24,Default,,0,0,0,,
Dialogue: 0,0:04:05.37,0:04:07.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:10.62,0:04:12.12,Default,,0,0,0,,Дайки-кун
Dialogue: 0,0:04:13.41,0:04:14.29,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:14.87,0:04:17.29,Default,,0,0,0,,Басылымды Сасаки-сенпайға тапсырыңыз
Dialogue: 0,0:04:17.79,0:04:21.59,Default,,0,0,0,,Дәл қазір барлығы мектеп фестиваліне дайындалып жатыр.
Dialogue: 0,0:04:22.09,0:04:23.55,Default,,0,0,0,,Саған берейін бе?
Dialogue: 0,0:04:23.63,0:04:24.97,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:26.01,0:04:26.93,Default,,0,0,0,,Кіре алмайсыз ба?
Dialogue: 0,0:04:27.01,0:04:29.72,Default,,0,0,0,,Ах... аа, кешіріңіз.
Dialogue: 0,0:04:30.22,0:04:32.68,Default,,0,0,0,,Екінші сыныптың кабинеттері күйзеліс тудырады.
Dialogue: 0,0:04:33.48,0:04:37.86,Default,,0,0,0,,Чинацу-сенпай, бұл жақсы орын. Артқы терезедегі орындық.
Dialogue: 0,0:04:37.94,0:04:40.11,Default,,0,0,0,,Бүгін ғана мен орын ауыстырдым.
Dialogue: 0,0:04:40.61,0:04:43.32,Default,,0,0,0,,Мен де жаңа семестрде сабағымды алдым.
Dialogue: 0,0:04:43.40,0:04:45.78,Default,,0,0,0,,Дайки-кун, сенің орның қайда?
Dialogue: 0,0:04:46.57,0:04:47.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:48.41,0:04:49.87,Default,,0,0,0,,Дәл осы жерде
Dialogue: 0,0:04:49.95,0:04:50.99,Default,,0,0,0,,Қандай ұят.
Dialogue: 0,0:04:51.08,0:04:52.70,Default,,0,0,0,,Өкіну дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:53.37,0:04:56.08,Default,,0,0,0,,Егер арасы бір жыл болса, біз бір-бірімізге отырар едік.
Dialogue: 0,0:04:59.50,0:05:02.67,Default,,0,0,0,,Өйткені Чинацу-сенпай бір жылдан кейін тумайды.
Dialogue: 0,0:05:03.17,0:05:05.55,Default,,0,0,0,,Сосын маған үй тапсырмасын көрсеттің.
Dialogue: 0,0:05:05.63,0:05:07.43,Default,,0,0,0,,Өзіңіз жасаңыз
Dialogue: 0,0:05:08.47,0:05:10.76,Default,,0,0,0,,Чинацу-сенпай, тіпті артқы орындықта.
Dialogue: 0,0:05:10.85,0:05:12.93,Default,,0,0,0,,Сабақ кезінде ұйықтамайтын сияқтысың.
Dialogue: 0,0:05:13.43,0:05:15.60,Default,,0,0,0,,Иә, мен ояумын.
Dialogue: 0,0:05:18.19,0:05:21.23,Default,,0,0,0,,Дайки-кун ұйықтап жатқан сияқты.
Dialogue: 0,0:05:21.82,0:05:26.03,Default,,0,0,0,,Сондықтан мен әр жолды болжап отырсам да, бұл мені оятпайды.
Dialogue: 0,0:05:26.11,0:05:28.41,Default,,0,0,0,,Келесі, Inomata
Dialogue: 0,0:05:28.49,0:05:29.24,Default,,0,0,0,,Иноматалар!
Dialogue: 0,0:05:29.32,0:05:30.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:30.33,0:05:31.33,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:31.83,0:05:34.16,Default,,0,0,0,,1 сұраққа жауап (3)
Dialogue: 0,0:05:34.25,0:05:36.00,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:05:38.58,0:05:40.29,Default,,0,0,0,,3/4 pi
Dialogue: 0,0:05:40.79,0:05:43.17,Default,,0,0,0,,Бұл дұрыс. Мұқият тыңдаңыз.
Dialogue: 0,0:05:43.67,0:05:44.67,Default,,0,0,0,,Иә
Dialogue: 0,0:05:45.97,0:05:46.97,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:05:49.05,0:05:50.09,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:03.98,0:06:06.40,Default,,0,0,0,,Дайки-кунның бағаны өткізіп жіберуден басқа амалы жоқ.
Dialogue: 0,0:06:06.49,0:06:07.90,Default,,0,0,0,,Қандай бос сөз.
Dialogue: 0,0:06:07.99,0:06:09.41,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:06:09.91,0:06:11.12,Default,,0,0,0,,Кано
Dialogue: 0,0:06:11.87,0:06:13.41,Default,,0,0,0,,Онда мен қайтамын.
Dialogue: 0,0:06:13.49,0:06:15.41,Default,,0,0,0,,Иә, мен саған беремін.
Dialogue: 0,0:06:16.41,0:06:18.87,Default,,0,0,0,,Мүмкін болса, мен қалаймын.
Dialogue: 0,0:06:20.04,0:06:22.92,Default,,0,0,0,,Бастапқыда біз әртүрлі сыныптарда оқыдық және үйірме жұмыстары әртүрлі болды.
Dialogue: 0,0:06:23.67,0:06:25.76,Default,,0,0,0,,Интернетті қарап шығыңыз
Dialogue: 0,0:06:28.72,0:06:31.59,Default,,0,0,0,,Тағы да, егер бірге тұрмасақ...
Dialogue: 0,0:06:31.68,0:06:34.06,Default,,0,0,0,,Менің ойымша, олардың бұған еш қатысы жоқ.
Dialogue: 0,0:06:35.06,0:06:36.06,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:06:37.02,0:06:38.02,Default,,0,0,0,,Біреу келе жатыр
Dialogue: 0,0:06:38.52,0:06:39.52,Default,,0,0,0,,Сізге қиындық тудырғаным үшін кешіріңіз.
Dialogue: 0,0:06:39.60,0:06:40.77,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:40.85,0:06:41.44,Default,,0,0,0,,Ах
Dialogue: 0,0:06:42.02,0:06:44.19,Default,,0,0,0,,Дайки-кун, біраз уақыт өтті.
Dialogue: 0,0:06:44.77,0:06:48.07,Default,,0,0,0,,Чинацу-сенпайдың анасы Жапонияға не үшін келді?
Dialogue: 0,0:06:48.65,0:06:51.03,Default,,0,0,0,,Менің атам құлап қалды.
Dialogue: 0,0:06:51.11,0:06:52.82,Default,,0,0,0,,Мен ұшаққа секірдім
Dialogue: 0,0:06:52.91,0:06:55.20,Default,,0,0,0,,Иә! Сенімен бәрі жақсы ма?
Dialogue: 0,0:06:55.28,0:07:00.29,Default,,0,0,0,,Жарақат өмірге қауіп төндірмейді, бірақ мен келесі айда ота жасауды жоспарлап отырмын.
Dialogue: 0,0:07:00.37,0:07:01.62,Default,,0,0,0,,Мұнда біраз уақыт
Dialogue: 0,0:07:01.71,0:07:03.84,Default,,0,0,0,,Мен айлық пәтер жалдап, сонда тұрғым келеді.
Dialogue: 0,0:07:03.92,0:07:05.34,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:05.84,0:07:06.59,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:07:07.21,0:07:11.18,Default,,0,0,0,,Чинацу-чан, сен біраз уақыт анаңмен бірге тұрасың.
Dialogue: 0,0:07:11.76,0:07:12.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:14.35,0:07:15.81,Default,,0,0,0,,Рахмет, Дайки-кун.
Dialogue: 0,0:07:16.39,0:07:19.06,Default,,0,0,0,,Менің багажымды алып жүруге көмектесіңізші.
Dialogue: 0,0:07:19.14,0:07:20.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:20.60,0:07:21.94,Default,,0,0,0,,Шынымен. Түскі асқа таяп қалды ғой, иә?
Dialogue: 0,0:07:22.02,0:07:24.06,Default,,0,0,0,,Ай сайынғы жақсы пәтер таптым
Dialogue: 0,0:07:24.15,0:07:25.57,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:07:25.65,0:07:30.03,Default,,0,0,0,,Күткендей, мен Иноматтар отбасына қарағанда мектептен алшақ боламын.
Dialogue: 0,0:07:30.11,0:07:33.49,Default,,0,0,0,,Атамның ота жасауына бір ай болса да.
Dialogue: 0,0:07:33.57,0:07:35.58,Default,,0,0,0,,Мен сені сағынамын
Dialogue: 0,0:07:35.66,0:07:37.41,Default,,0,0,0,,- (Юкико) Ей, үлкен қуаныш - (үлкен қуаныш) Иә?
Dialogue: 0,0:07:38.41,0:07:39.75,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:39.83,0:07:41.08,Default,,0,0,0,,Мен ұялып тұрмын
Dialogue: 0,0:07:41.16,0:07:41.83,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:42.67,0:07:44.83,Default,,0,0,0,,Мен алдымен көлікке қайтамын.
Dialogue: 0,0:07:45.33,0:07:48.17,Default,,0,0,0,,Дайки-кун, бұл кілт.
Dialogue: 0,0:07:48.25,0:07:50.63,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:07:50.72,0:07:53.38,Default,,0,0,0,,Жоқ, көп рахмет.
Dialogue: 0,0:07:53.89,0:07:55.09,Default,,0,0,0,,Үйірме жұмыстарының алдында
Dialogue: 0,0:07:55.80,0:07:58.56,Default,,0,0,0,,Әйел автобусы басқа мектепте жаттығу матчы болды ма?
Dialogue: 0,0:07:58.64,0:07:59.85,Default,,0,0,0,,Иә, Нишиода
Dialogue: 0,0:08:00.73,0:08:01.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:01.68,0:08:02.23,Default,,0,0,0,,Сонымен
Dialogue: 0,0:08:02.81,0:08:04.73,Default,,0,0,0,,Таңертеңгілік жаттығуда кездескенше.
Dialogue: 0,0:08:07.57,0:08:08.98,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:09.82,0:08:13.65,Default,,0,0,0,,Бірге тұру уақытша тоқтатылғанымен, арақашықтық қысқарды.
Dialogue: 0,0:08:13.74,0:08:15.87,Default,,0,0,0,,Тіпті таңғы жаттығуда сөйлеу
Dialogue: 0,0:08:16.49,0:08:17.74,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:08:18.78,0:08:21.33,Default,,0,0,0,,Иә? Ерте болды ма?
Dialogue: 0,0:08:22.58,0:08:24.46,Default,,0,0,0,,Үй алыс
Dialogue: 0,0:08:24.54,0:08:27.75,Default,,0,0,0,,Күткендей, бұрынғыдай болуы мүмкін емес... Ах.
Dialogue: 0,0:08:28.29,0:08:29.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:29.25,0:08:32.34,Default,,0,0,0,,Хм... Бұл сирек, Харю-сенпай.
Dialogue: 0,0:08:32.42,0:08:33.93,Default,,0,0,0,,Таңертең ерте осылай
Dialogue: 0,0:08:34.01,0:08:37.14,Default,,0,0,0,,Анам далаға кетіп бара жатыр деп мені оятты.
Dialogue: 0,0:08:37.22,0:08:39.10,Default,,0,0,0,,Менде жағымсыз сезім бар...
Dialogue: 0,0:08:39.18,0:08:41.89,Default,,0,0,0,,Ауа-райы жақсы. Мен сыртқа жүгіруім керек пе?
Dialogue: 0,0:08:41.97,0:08:43.52,Default,,0,0,0,,Таңертеңнен бері физикалық күш елесі!
Dialogue: 0,0:08:44.14,0:08:45.35,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:08:45.44,0:08:46.81,Default,,0,0,0,,Бір минут күтіңіз...
Dialogue: 0,0:08:46.90,0:08:49.77,Default,,0,0,0,,Жүгіру жақсы, бірақ неге бүгін ғана?
Dialogue: 0,0:08:52.36,0:08:53.57,Default,,0,0,0,,Хаа…
Dialogue: 0,0:08:54.53,0:08:57.24,Default,,0,0,0,,Ақыры Чинацу-сенпайды кездестіре алмадым.
Dialogue: 0,0:08:57.74,0:09:00.79,Default,,0,0,0,,Таңертең жүгіруге мәжбүр болу
Dialogue: 0,0:09:02.08,0:09:06.62,Default,,0,0,0,,Бірақ Чинацу-сенпайдың таңертең бірінші болып келмеуі ерекше.
Dialogue: 0,0:09:07.17,0:09:08.04,Default,,0,0,0,,Иноматалар
Dialogue: 0,0:09:08.96,0:09:11.05,Default,,0,0,0,,Мәдени фестиваль өкілдері жиналысы Кеттік
Dialogue: 0,0:09:12.13,0:09:14.67,Default,,0,0,0,,Сіз үйренбеген орта болуы мүмкін.
Dialogue: 0,0:09:15.17,0:09:17.76,Default,,0,0,0,,Үйіме келген соң орнымнан тұрып, әдеттегідей кеттім.
Dialogue: 0,0:09:18.76,0:09:21.18,Default,,0,0,0,,Сіз мектепке келмеген сияқтысыз, солай ма?
Dialogue: 0,0:09:21.26,0:09:23.02,Default,,0,0,0,,Егер суық тиіп қалсаңыз...
Dialogue: 0,0:09:27.48,0:09:28.44,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:29.90,0:09:33.03,Default,,0,0,0,,Спорт залында немесе мектепте кездейсоқ кездесіп қалмасақ.
Dialogue: 0,0:09:33.11,0:09:35.70,Default,,0,0,0,,Оның мектепке баратынын, бармайтынын да білмеймін.
Dialogue: 0,0:09:36.70,0:09:37.70,Default,,0,0,0,,Ах
Dialogue: 0,0:09:37.78,0:09:38.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:39.20,0:09:40.95,Default,,0,0,0,,- (Әйел) Кано-сан - (Чинацу) Иә.
Dialogue: 0,0:09:41.03,0:09:41.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:44.66,0:09:46.29,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:09:46.37,0:09:47.62,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:48.17,0:09:49.46,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,0:09:49.54,0:09:50.58,Default,,0,0,0,,Сонымен, жақсысың ба?
Dialogue: 0,0:09:53.88,0:09:55.09,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:09:56.22,0:09:57.34,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:09:58.01,0:10:00.30,Default,,0,0,0,,Сіз бұл туралы ештеңе істей алмаймын деп ойласаңыз да
Dialogue: 0,0:10:00.39,0:10:02.60,Default,,0,0,0,,Оған көмектесу мүмкін емес екенін білемін, бірақ
Dialogue: 0,0:10:03.10,0:10:04.39,Default,,0,0,0,,Келесі Үлкен қуаныш!
Dialogue: 0,0:10:04.47,0:10:05.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:06.81,0:10:07.60,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:10:08.23,0:10:10.65,Default,,0,0,0,,- (Автобустың әйел мүшесі А) Сәттілік! - (Автобустың әйел мүшесі В) 10 секунд қалды
Dialogue: 0,0:10:11.15,0:10:12.86,Default,,0,0,0,,- (Чинацу) Жекпе-жек! -(Автобустың әйел мүшесі C) Жақсы, жақсы.
Dialogue: 0,0:10:13.57,0:10:15.61,Default,,0,0,0,,Бұл Чинацу-сенпайдың қазіргі дауысы.
Dialogue: 0,0:10:16.24,0:10:18.78,Default,,0,0,0,,Біз бірге көшкенге дейін ойлап көрші.
Dialogue: 0,0:10:18.86,0:10:20.99,Default,,0,0,0,,Осындай бірдеңе мені қуантты.
Dialogue: 0,0:10:25.29,0:10:28.83,Default,,0,0,0,,Әй, кел, аяқта.
Dialogue: 0,0:10:29.33,0:10:30.71,Default,,0,0,0,,Тағы сәл ғана!
Dialogue: 0,0:10:30.79,0:10:32.63,Default,,0,0,0,,10 9…
Dialogue: 0,0:10:33.54,0:10:35.71,Default,,0,0,0,,- (Юаса) 8... - (Үлкен қуаныш) Түсіндім, тазалаймын.
Dialogue: 0,0:10:36.21,0:10:38.05,Default,,0,0,0,,Иә? Әйел автобусы ше?
Dialogue: 0,0:10:38.13,0:10:39.13,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:10:39.22,0:10:40.76,Default,,0,0,0,,Ах! Мен білмей тұрып!
Dialogue: 0,0:10:41.72,0:10:42.68,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:43.22,0:10:46.60,Default,,0,0,0,,Кетер алдында сені тағы бір көргім келді.
Dialogue: 0,0:10:47.81,0:10:49.60,Default,,0,0,0,,Мен қатты шаршадым.
Dialogue: 0,0:10:49.69,0:10:53.65,Default,,0,0,0,,Таңертең асық, мектеп фестиваліне дайындал, сосын үйірме жұмыстарын орында
Dialogue: 0,0:10:54.44,0:10:57.65,Default,,0,0,0,,Харю-сенпай ертең де ерте тұра ма?
Dialogue: 0,0:10:58.65,0:11:01.66,Default,,0,0,0,,Үйге келген соң жабдықты жалға алу шартын жазуым керек.
Dialogue: 0,0:11:02.24,0:11:06.74,Default,,0,0,0,,Бірақ үйге келсем, Чинацу-сенпай жоқ екен.
Dialogue: 0,0:11:07.79,0:11:09.66,Default,,0,0,0,,Бір ай?
Dialogue: 0,0:11:10.79,0:11:13.17,Default,,0,0,0,,Ертеңнен бастап көбірек сөйлесейік.
Dialogue: 0,0:11:13.25,0:11:17.84,Default,,0,0,0,,Дұрыс, егер сіз бірге тұрмасаңыз, қалыпты сөйлесуде ешқандай проблема болмауы керек!
Dialogue: 0,0:11:18.76,0:11:20.47,Default,,0,0,0,,Және бір күні...
Dialogue: 0,0:11:21.97,0:11:24.64,Default,,0,0,0,,Бұл қалыпты жағдайға айналатын күн келеді.
Dialogue: 0,0:11:29.60,0:11:30.68,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:11:30.77,0:11:32.69,Default,,0,0,0,,- (Чинацу) Қайтадан қош келдіңіз - (қуанып) Ех!
Dialogue: 0,0:11:32.77,0:11:34.19,Default,,0,0,0,,Неліктен үйде?
Dialogue: 0,0:11:34.77,0:11:37.23,Default,,0,0,0,,Сіз осында тұрғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:11:37.32,0:11:38.69,Default,,0,0,0,,Бүгіннен бастап пәтерде...
Dialogue: 0,0:11:38.78,0:11:40.82,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым...
Dialogue: 0,0:11:41.32,0:11:42.45,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:42.53,0:11:45.41,Default,,0,0,0,,Олай болса мен Дайки-кунға бірдеңе айтқым келеді.
Dialogue: 0,0:11:46.53,0:11:48.58,Default,,0,0,0,,Таңертеңгілік жаттығу Сіз келмедіңіз, солай ма?
Dialogue: 0,0:11:48.66,0:11:50.96,Default,,0,0,0,,Мен бардым! Ах...
Dialogue: 0,0:11:51.54,0:11:54.00,Default,,0,0,0,,Жай ғана Харю-сенпаймен жүгіріп келе жатырмын
Dialogue: 0,0:11:54.50,0:11:55.84,Default,,0,0,0,,Харю-кун?
Dialogue: 0,0:11:55.92,0:11:58.42,Default,,0,0,0,,Шындығында ол жерде болмаған Чинацу-сенпай еді.
Dialogue: 0,0:11:58.50,0:12:00.84,Default,,0,0,0,,Мен қате пойызға отырдым
Dialogue: 0,0:12:01.59,0:12:02.43,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:12:02.51,0:12:03.34,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:12:04.18,0:12:06.85,Default,,0,0,0,,Мен станциядан қысқа жүгірдім.
Dialogue: 0,0:12:06.93,0:12:07.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:20.73,0:12:23.65,Default,,0,0,0,,Өйткені, қашықтық өзгерді.
Dialogue: 0,0:12:24.49,0:12:27.16,Default,,0,0,0,,Ал, ертең таңғы жаттығу.
Dialogue: 0,0:12:27.66,0:12:28.49,Default,,0,0,0,,Иә
Dialogue: 0,0:12:30.91,0:12:34.17,Default,,0,0,0,,Сұлу қыз, сыйлық берейік.
Dialogue: 0,0:12:34.79,0:12:37.38,Default,,0,0,0,,Уау! Әдемі алма!
Dialogue: 0,0:12:37.46,0:12:42.09,Default,,0,0,0,,Ол қызыл және жылтыр, ал бөкселері терең ойыс.
Dialogue: 0,0:12:42.17,0:12:45.43,Default,,0,0,0,,Бұл алманың қант мөлшері 15 градустан асуы мүмкін!
Dialogue: 0,0:12:45.51,0:12:48.14,Default,,0,0,0,,Дұрыс, солай ма?
Dialogue: 0,0:12:48.22,0:12:50.22,Default,,0,0,0,,Хош иісі жұмсақ...
Dialogue: 0,0:12:50.85,0:12:53.18,Default,,0,0,0,,О... кешіріңіз.
Dialogue: 0,0:12:53.27,0:12:55.44,Default,,0,0,0,,Жоқ, бұл жақсы сезінеді.
Dialogue: 0,0:12:55.52,0:12:57.31,Default,,0,0,0,,Осы қысқа мерзімге жеткілікті
Dialogue: 0,0:12:58.23,0:13:00.86,Default,,0,0,0,,Мен күткеннен де жақсы көрінеді, Хина.
Dialogue: 0,0:13:00.94,0:13:03.15,Default,,0,0,0,,Сценарийдің орналасуы маған қызық.
Dialogue: 0,0:13:03.65,0:13:06.57,Default,,0,0,0,,Халық алдында ерекшелене білу де талант.
Dialogue: 0,0:13:06.66,0:13:08.07,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:08.78,0:13:11.33,Default,,0,0,0,,Тадаши жасаған костюмдерді асыға күтетін сияқтымыз.
Dialogue: 0,0:13:11.41,0:13:15.04,Default,,0,0,0,,Адамдарды өздеріне қажет жағдайға қойғанда
Dialogue: 0,0:13:15.12,0:13:17.04,Default,,0,0,0,,Ол да өсе алады.
Dialogue: 0,0:13:17.54,0:13:19.84,Default,,0,0,0,,Ағаның шүберектері немесе басқалары
Dialogue: 0,0:13:21.13,0:13:23.46,Default,,0,0,0,,Ең бастысы, әркім өз міндетін атқарады.
Dialogue: 0,0:13:24.13,0:13:26.34,Default,,0,0,0,,Б қоймасының кілті біреуде бар ма?
Dialogue: 0,0:13:27.09,0:13:29.35,Default,,0,0,0,,Бұл жағдайда Танигучиде бұрынырақ болған.
Dialogue: 0,0:13:29.43,0:13:32.01,Default,,0,0,0,,Эй, сенде қалған гумте бар ма? Жоғалып кете жаздады
Dialogue: 0,0:13:32.10,0:13:33.02,Default,,0,0,0,,Мен оны сатып аламын.
Dialogue: 0,0:13:33.10,0:13:35.43,Default,,0,0,0,,Маған қанша парта керек?
Dialogue: 0,0:13:35.52,0:13:36.10,Default,,0,0,0,,Сегіз
Dialogue: 0,0:13:36.19,0:13:39.69,Default,,0,0,0,,Әй, қауіпсіздікті растау жиналысы өткелі жатыр.
Dialogue: 0,0:13:39.77,0:13:41.11,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:13:41.19,0:13:43.40,Default,,0,0,0,,Кешіріңіз! Құрметпен
Dialogue: 0,0:13:44.53,0:13:46.86,Default,,0,0,0,,Inomata-kun таңқаларлық сенімді.
Dialogue: 0,0:13:47.45,0:13:50.87,Default,,0,0,0,,Ол дереу әрекет етеді, сөйлесуге оңай және көмектеседі.
Dialogue: 0,0:13:54.45,0:13:56.37,Default,,0,0,0,,Эвакуация жолын тексеріңіз
Dialogue: 0,0:13:57.21,0:14:00.88,Default,,0,0,0,,Мен гумте мен майлы қаламсап алайын деп жатырмын.
Dialogue: 0,0:14:02.63,0:14:03.42,Default,,0,0,0,,Ах
Dialogue: 0,0:14:03.92,0:14:05.34,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:05.42,0:14:06.26,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:06.34,0:14:09.39,Default,,0,0,0,,Мен мұны бүгін таңғы жаттығуда айттым.
Dialogue: 0,0:14:10.55,0:14:13.51,Default,,0,0,0,,Чинацу-сенпай «Қайырлы таң» дегенде
Dialogue: 0,0:14:14.06,0:14:14.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:16.02,0:14:18.94,Default,,0,0,0,,Чинацу-сенпайдың сыныбы кофеханада болды ма?
Dialogue: 0,0:14:19.02,0:14:19.85,Default,,0,0,0,,Иә
Dialogue: 0,0:14:19.94,0:14:22.40,Default,,0,0,0,,Даяшылардың костюмдері әсем безендірілген.
Dialogue: 0,0:14:23.48,0:14:25.23,Default,,0,0,0,,Даяшы…
Dialogue: 0,0:14:25.32,0:14:26.94,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:14:27.99,0:14:29.03,Default,,0,0,0,,Мен оны көргім келеді
Dialogue: 0,0:14:29.11,0:14:32.37,Default,,0,0,0,,Басқа адамдарға қалай осылай қызмет ете аласың!
Dialogue: 0,0:14:32.45,0:14:35.37,Default,,0,0,0,,Өйткені мен сынып өкілімін.
Dialogue: 0,0:14:35.45,0:14:37.41,Default,,0,0,0,,Мен тұтынушыларға қызмет көрсетуді жоспарламаймын.
Dialogue: 0,0:14:37.50,0:14:38.33,Default,,0,0,0,,Не!
Dialogue: 0,0:14:38.87,0:14:40.67,Default,,0,0,0,,Жоқ, мен оны көргім келді.
Dialogue: 0,0:14:41.21,0:14:44.25,Default,,0,0,0,,Дайки-кунның сыныбы «Ақшақар» ма?
Dialogue: 0,0:14:44.34,0:14:45.88,Default,,0,0,0,,Чоно мырза басты кейіпкер
Dialogue: 0,0:14:45.96,0:14:46.84,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:14:47.34,0:14:50.80,Default,,0,0,0,,Мен де пьесада көрінбеймін, өйткені мен бәрін қарауға жауаптымын.
Dialogue: 0,0:14:50.89,0:14:54.05,Default,,0,0,0,,Әй, мен оны ханзаданың рөлін ойнап жатыр деп ойладым.
Dialogue: 0,0:14:54.14,0:14:56.77,Default,,0,0,0,,Жоқ! Мен үшін бұл мүмкін емес
Dialogue: 0,0:14:56.85,0:14:59.31,Default,,0,0,0,,Ханзада рөлін ұзын бойлы қыз...
Dialogue: 0,0:14:59.39,0:15:01.40,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:15:01.90,0:15:03.86,Default,,0,0,0,,Үлкен қуаныш
Dialogue: 0,0:15:03.94,0:15:05.69,Default,,0,0,0,,Мұғалім іздейді...
Dialogue: 0,0:15:05.77,0:15:08.19,Default,,0,0,0,,А, сәлем
Dialogue: 0,0:15:08.78,0:15:09.95,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:10.45,0:15:12.07,Default,,0,0,0,,Олай болса сәттілік.
Dialogue: 0,0:15:12.16,0:15:13.20,Default,,0,0,0,,Чинацу-сенпай да
Dialogue: 0,0:15:16.54,0:15:17.54,Default,,0,0,0,,не болды?
Dialogue: 0,0:15:17.62,0:15:19.71,Default,,0,0,0,,Менің ойымша, бізде керек-жарақтар жеткіліксіз...
Dialogue: 0,0:15:19.79,0:15:21.67,Default,,0,0,0,,Мынау да
Dialogue: 0,0:15:21.75,0:15:23.04,Default,,0,0,0,,Өте көп!
Dialogue: 0,0:15:24.34,0:15:27.09,Default,,0,0,0,,Чинацу, монша бос.
Dialogue: 0,0:15:27.67,0:15:28.96,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:29.05,0:15:30.88,Default,,0,0,0,,Коюки-сан, сен мұны білдің, солай ма?
Dialogue: 0,0:15:30.97,0:15:32.89,Default,,0,0,0,,Маған Құмай-күн ұнайды
Dialogue: 0,0:15:33.39,0:15:35.97,Default,,0,0,0,,Сонда да екеуміз Сендайға іссапарға бардық!
Dialogue: 0,0:15:36.56,0:15:38.72,Default,,0,0,0,,Бұл жұмыс, сондықтан менде басқа амал жоқ...
Dialogue: 0,0:15:38.81,0:15:40.98,Default,,0,0,0,,Мен мұны білемін!
Dialogue: 0,0:15:41.06,0:15:42.81,Default,,0,0,0,,Мәселе бұл емес
Dialogue: 0,0:15:42.90,0:15:45.23,Default,,0,0,0,,Мен Коюки-санның көзқарасын айтып отырмын!
Dialogue: 0,0:15:45.31,0:15:47.61,Default,,0,0,0,,Сен айлакер әйелсің, Коюки-сан.
Dialogue: 0,0:15:47.69,0:15:48.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:48.53,0:15:51.78,Default,,0,0,0,,Біреу сізге жұмыс әкелсе, ештеңе айта алмайсыз.
Dialogue: 0,0:15:51.86,0:15:55.41,Default,,0,0,0,,Өзіңізді үнемі ойшыл етіп ұстанатыныңызға сенімдімін.
Dialogue: 0,0:15:56.24,0:15:58.58,Default,,0,0,0,,Егер сіз оны шынымен қызықтырсаңыз
Dialogue: 0,0:15:58.66,0:16:01.12,Default,,0,0,0,,Қалағаныңызша қашықтықты жасауға болады.
Dialogue: 0,0:16:01.21,0:16:05.17,Default,,0,0,0,,Махаббаттың даму жолы адамға байланысты әр түрлі болады.
Dialogue: 0,0:16:05.25,0:16:08.75,Default,,0,0,0,,Осыншама шыдамсыз болу айлакер сияқты.
Dialogue: 0,0:16:09.63,0:16:11.38,Default,,0,0,0,,Эй, сен солай ойлайсың ба?
Dialogue: 0,0:16:12.76,0:16:13.63,Default,,0,0,0,,Иә
Dialogue: 0,0:16:15.18,0:16:18.47,Default,,0,0,0,,Анам кәдесый ретінде сатып алған үйрек.
Dialogue: 0,0:16:20.39,0:16:23.39,Default,,0,0,0,,Мен қу адаммын.
Dialogue: 0,0:16:24.48,0:16:28.73,Default,,0,0,0,,Мен Чоно-санның Дайки-кунды ұнататынын білемін.
Dialogue: 0,0:16:30.03,0:16:31.61,Default,,0,0,0,,Мен бір жерге барғым келеді
Dialogue: 0,0:16:32.32,0:16:33.78,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:16:34.78,0:16:37.32,Default,,0,0,0,,Сіз осындай бірдеңе айтқаныңызға сенімдімін.
Dialogue: 0,0:16:37.41,0:16:39.87,Default,,0,0,0,,Чоно-санның көзқарасы бойынша маған ұнамайды.
Dialogue: 0,0:16:42.75,0:16:43.37,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:45.37,0:16:46.04,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:16:49.38,0:16:52.88,Default,,0,0,0,,Мен сені әлі кездеспейтініңді естідім.
Dialogue: 0,0:17:00.14,0:17:01.85,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:02.35,0:17:03.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:06.52,0:17:07.31,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:17:08.52,0:17:11.73,Default,,0,0,0,,Біреуге арқа сүйегің келген кезде...
Dialogue: 0,0:17:13.90,0:17:15.70,Default,,0,0,0,,- (Бала С) Иномата-кун - (Бала D) Иномата
Dialogue: 0,0:17:15.78,0:17:17.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:17.28,0:17:20.20,Default,,0,0,0,,Менің мысықтан алғым келетіні осы.
Dialogue: 0,0:17:20.28,0:17:22.70,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:22.79,0:17:25.21,Default,,0,0,0,,Кеш болды...
Dialogue: 0,0:17:25.29,0:17:28.83,Default,,0,0,0,,Мен шаршадым. Мен қазір дубль ойнаймын.
Dialogue: 0,0:17:30.34,0:17:32.34,Default,,0,0,0,,Су ішкен соң қосыламын.
Dialogue: 0,0:17:33.21,0:17:33.96,Default,,0,0,0,,Buha!
Dialogue: 0,0:17:34.76,0:17:36.59,Default,,0,0,0,,Мен білемін, бірақ мен бос емеспін.
Dialogue: 0,0:17:37.09,0:17:41.47,Default,,0,0,0,,Мен үйірме жұмыстарына уақытымды қысқартқым келмейді, бірақ мен мектеп фестиваліне дайындалуым керек.
Dialogue: 0,0:17:42.06,0:17:44.81,Default,,0,0,0,,Дайки Мен оның қаншалықты қиын екенін түсінемін.
Dialogue: 0,0:17:44.89,0:17:46.14,Default,,0,0,0,,Нишида Сенпай
Dialogue: 0,0:17:46.23,0:17:49.86,Default,,0,0,0,,Уақыт шектеулі және ешқашан қайтып келмейді.
Dialogue: 0,0:17:50.44,0:17:53.65,Default,,0,0,0,,Бірақ рөл берілгеннен кейін,
Dialogue: 0,0:17:53.73,0:17:57.32,Default,,0,0,0,,Біз осы шектеулілік аясында күресуіміз керек.
Dialogue: 0,0:17:58.07,0:17:59.36,Default,,0,0,0,,сөзсіз Лорд Дэмиан болары анық.
Dialogue: 0,0:17:59.99,0:18:02.12,Default,,0,0,0,,Ал менің рөлім
Dialogue: 0,0:18:02.20,0:18:05.75,Default,,0,0,0,,Сіз жасай алатын ең жақсы нәрсе - мұндай жасөспірімдерді дайындауға қатысу.
Dialogue: 0,0:18:07.00,0:18:09.96,Default,,0,0,0,,Нишида Сенпай...
Dialogue: 0,0:18:10.04,0:18:10.75,Default,,0,0,0,,Директор!
Dialogue: 0,0:18:11.42,0:18:12.67,Default,,0,0,0,,Нишида жігіті
Dialogue: 0,0:18:12.75,0:18:15.67,Default,,0,0,0,,Сіз жақсы әрекет етесіз, өйткені сіз оны ауыстырып, менеджер болдыңыз.
Dialogue: 0,0:18:16.17,0:18:18.51,Default,,0,0,0,,Кәдімгі тектіліктің сауда нүктесі болса да
Dialogue: 0,0:18:19.01,0:18:20.09,Default,,0,0,0,,Сәттілік директордың орынбасары
Dialogue: 0,0:18:20.18,0:18:21.01,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:18:21.10,0:18:23.89,Default,,0,0,0,,Бұл кім? Менің айтқаным Нох ауа райы болды.
Dialogue: 0,0:18:23.97,0:18:25.60,Default,,0,0,0,,Мінезі өрескел!
Dialogue: 0,0:18:27.14,0:18:29.90,Default,,0,0,0,,- (Қозылған) Шынтақтан тағы - (Кіші) Осылай...?
Dialogue: 0,0:18:29.98,0:18:33.69,Default,,0,0,0,,Мен көремін. Рахмет, Иномата-сенпай!
Dialogue: 0,0:18:33.77,0:18:34.90,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:18:35.48,0:18:36.65,Default,,0,0,0,,Inomata Senpai
Dialogue: 0,0:18:37.40,0:18:38.40,Default,,0,0,0,,Не?
Dialogue: 0,0:18:38.99,0:18:40.20,Default,,0,0,0,,Кіші мектеп оқушысы?
Dialogue: 0,0:18:40.28,0:18:43.24,Default,,0,0,0,,Кіші орта мектептің 1 курсының бас үйірмесінің баласы ойнау туралы сұрақ қойды.
Dialogue: 0,0:18:43.33,0:18:45.54,Default,,0,0,0,,Бұл орта және жоғары мектептің күші.
Dialogue: 0,0:18:45.62,0:18:47.12,Default,,0,0,0,,Inomata Senpai
Dialogue: 0,0:18:47.20,0:18:48.79,Default,,0,0,0,,Сізге не ұнайды?
Dialogue: 0,0:18:49.29,0:18:53.09,Default,,0,0,0,,Жоқ, Дайки-кун, мен сені ағаға ұқсайды деп ойладым.
Dialogue: 0,0:18:53.59,0:18:56.13,Default,,0,0,0,,Мен орта мектептің бірінші курсында әлі қысқамын.
Dialogue: 0,0:18:56.21,0:19:00.05,Default,,0,0,0,,Дайки-кун да сондай ұзын болатын.
Dialogue: 0,0:19:00.13,0:19:01.93,Default,,0,0,0,,Өткенді білмейсің, солай ма?
Dialogue: 0,0:19:02.55,0:19:03.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:03.18,0:19:04.93,Default,,0,0,0,,Не, түзу бет пе?
Dialogue: 0,0:19:05.01,0:19:08.06,Default,,0,0,0,,Ал менің бойым әлі өсіп жатыр.
Dialogue: 0,0:19:08.14,0:19:10.98,Default,,0,0,0,,Болашақта бұл туралы көп болады.
Dialogue: 0,0:19:11.06,0:19:14.94,Default,,0,0,0,,Қулық! Мен өсуді тоқтаттым
Dialogue: 0,0:19:15.02,0:19:16.82,Default,,0,0,0,,Бұл ер адамдар үшін артықшылық.
Dialogue: 0,0:19:17.32,0:19:18.99,Default,,0,0,0,,Мен сені ары қарай тарта беремін.
Dialogue: 0,0:19:19.49,0:19:20.40,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:22.03,0:19:22.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:27.58,0:19:29.71,Default,,0,0,0,,Бұл сома дұрыс.
Dialogue: 0,0:19:29.79,0:19:31.83,Default,,0,0,0,,А... иә
Dialogue: 0,0:19:32.50,0:19:34.33,Default,,0,0,0,,Немесе осыншама
Dialogue: 0,0:19:34.42,0:19:36.96,Default,,0,0,0,,Менің бойым тоқтап қалды, солай емес пе?
Dialogue: 0,0:19:37.05,0:19:38.17,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:19:38.26,0:19:40.26,Default,,0,0,0,,Ахаха емес...
Dialogue: 0,0:19:41.34,0:19:44.85,Default,,0,0,0,,Қазір жүзіміз жақын екені рас, бірақ
Dialogue: 0,0:19:45.35,0:19:48.10,Default,,0,0,0,,Ер адам ретінде мен аздап өскім келеді.
Dialogue: 0,0:19:49.02,0:19:53.44,Default,,0,0,0,,Жеті ергежейлі: «Абайлаңыз...
Dialogue: 0,0:19:54.10,0:19:55.44,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:19:55.94,0:20:00.65,Default,,0,0,0,,«Ешқашан ешкімге есік ашпаңыз», солай ма?
Dialogue: 0,0:20:00.74,0:20:01.99,Default,,0,0,0,,Жақсы есімде.
Dialogue: 0,0:20:02.57,0:20:04.78,Default,,0,0,0,,Жұмыс істеп жатқанда мен жаттығуды тыңдаймын.
Dialogue: 0,0:20:04.87,0:20:07.16,Default,,0,0,0,,Тадаши де актер ретінде көрінсе екен.
Dialogue: 0,0:20:07.66,0:20:10.29,Default,,0,0,0,,Мен мұндай романтикаға жақсы емеспін.
Dialogue: 0,0:20:10.37,0:20:12.00,Default,,0,0,0,,А-а... Мен мұны жақсы білмеймін.
Dialogue: 0,0:20:12.58,0:20:15.38,Default,,0,0,0,,Батыр қыз – жолы болмаған немесе қиыншылық көрген адам.
Dialogue: 0,0:20:15.46,0:20:16.71,Default,,0,0,0,,Мен саған түсіністікпен қарай аламын
Dialogue: 0,0:20:17.21,0:20:21.51,Default,,0,0,0,,Мен қалқымалы ханзадамен байлау идеясын қабылдай алмаймын.
Dialogue: 0,0:20:24.09,0:20:25.64,Default,,0,0,0,,Әйелдер тұрғысынан таңқаларлық
Dialogue: 0,0:20:26.43,0:20:29.01,Default,,0,0,0,,Ойланып қарасам, ол туралы естімеппін.
Dialogue: 0,0:20:29.10,0:20:30.85,Default,,0,0,0,,Сізге Тадаши ұнай ма?
Dialogue: 0,0:20:30.93,0:20:32.43,Default,,0,0,0,,Тыңдау дегенді қалай түсінесіңдер?
Dialogue: 0,0:20:32.52,0:20:36.44,Default,,0,0,0,,Ол маған үнемі сырттан пікір айтады, бірақ ол өзі туралы не ойлайды екен деп ойлаймын.
Dialogue: 0,0:20:36.94,0:20:37.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:43.70,0:20:44.91,Default,,0,0,0,,Ол қазір жоқ.
Dialogue: 0,0:20:44.99,0:20:45.70,Default,,0,0,0,,Қазір ше?
Dialogue: 0,0:20:46.20,0:20:49.03,Default,,0,0,0,,Ол кісінің жігіті болғаны үшін мен бас тарттым.
Dialogue: 0,0:20:49.12,0:20:49.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:50.54,0:20:51.62,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:20:51.70,0:20:52.41,Default,,0,0,0,,Бөлек
Dialogue: 0,0:20:54.79,0:20:56.79,Default,,0,0,0,,Сондықтан басқаларға сезімі барларға.
Dialogue: 0,0:20:56.88,0:20:58.29,Default,,0,0,0,,Чоно мырза маған соқтығысты.
Dialogue: 0,0:20:58.38,0:21:00.75,Default,,0,0,0,,-(Май) Мені аяп тұрсың ба -(Хина) Аяйсың ба?
Dialogue: 0,0:21:02.51,0:21:03.88,Default,,0,0,0,,Менің ойымша, бұл тамаша.
Dialogue: 0,0:21:08.01,0:21:10.22,Default,,0,0,0,,Дегенмен, Дайки менің досым.
Dialogue: 0,0:21:10.31,0:21:13.77,Default,,0,0,0,,Чоно-санға ерекше қолдау көрсету ойымда жоқ.
Dialogue: 0,0:21:13.85,0:21:15.60,Default,,0,0,0,,Иықтарыңызды сол жерде ұстаңыз!
Dialogue: 0,0:21:15.69,0:21:17.90,Default,,0,0,0,,Жоқ, бұл әбігерге түскен сияқты.
Dialogue: 0,0:21:17.98,0:21:19.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:19.90,0:21:21.78,Default,,0,0,0,,-де сізге ұнаған адам кім болды?
Dialogue: 0,0:21:21.86,0:21:23.15,Default,,0,0,0,,Ешқашан айтпа
Dialogue: 0,0:21:23.24,0:21:24.70,Default,,0,0,0,,Мен білетін қыз?
Dialogue: 0,0:21:24.78,0:21:25.90,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:21:28.32,0:21:30.91,Default,,0,0,0,,Ақшақар болсам да, бас тарттым.
Dialogue: 0,0:21:30.99,0:21:32.20,Default,,0,0,0,,Көшірме жасаңыз
Dialogue: 0,0:21:33.54,0:21:35.37,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:35.46,0:21:36.37,Default,,0,0,0,,Ах
Dialogue: 0,0:21:37.46,0:21:38.96,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:39.04,0:21:40.29,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:41.09,0:21:42.17,Default,,0,0,0,,Көшіру машинасы?
Dialogue: 0,0:21:42.25,0:21:44.26,Default,,0,0,0,,Аа, оны баяу қабылдаған дұрыс.
Dialogue: 0,0:21:44.84,0:21:47.97,Default,,0,0,0,,Сіздің жоғары сынып кофеханаға барады, солай ма?
Dialogue: 0,0:21:48.05,0:21:48.64,Default,,0,0,0,,Иә
Dialogue: 0,0:21:49.34,0:21:51.10,Default,,0,0,0,,Дайки айтты
Dialogue: 0,0:21:55.14,0:21:56.52,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:21:58.48,0:22:01.57,Default,,0,0,0,,Мен Дайкиге мойындадым.
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.37,0:23:35.37,Default,,0,0,0,,~♪
Dialogue: 0,0:23:36.87,0:23:42.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory