Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:09.76,Default,,0,0,0,,(балапанның айқайы)
Dialogue: 0,0:00:10.63,0:00:12.88,Default,,0,0,0,,Адамдар осылай жылайды
Dialogue: 0,0:00:12.97,0:00:14.30,Default,,0,0,0,,бәлкім, осы ғана шығар
Dialogue: 0,0:00:16.14,0:00:18.56,Default,,0,0,0,,Бұл мен қажетсіз нәрсені істегендіктен.
Dialogue: 0,0:00:22.77,0:00:25.27,Default,,0,0,0,,Спортзалда қосалқы орын бар сияқты.
Dialogue: 0,0:00:25.35,0:00:26.56,Default,,0,0,0,,Оны маған әкеле аласыз ба?
Dialogue: 0,0:00:27.94,0:00:30.53,Default,,0,0,0,,Мен сені жалғыз қалдыруым керек.
Dialogue: 0,0:00:32.32,0:00:35.91,Default,,0,0,0,,Осындай уақытта мен не айтуым керек?
Dialogue: 0,0:00:37.87,0:00:41.08,Default,,0,0,0,,Маған жақсырақ біреу бар десе
Dialogue: 0,0:00:41.16,0:00:43.33,Default,,0,0,0,,Жарайды, мені әкелу керек деп ойлаймын.
Dialogue: 0,0:00:44.04,0:00:45.96,Default,,0,0,0,,Бұл қиын, солай емес пе?
Dialogue: 0,0:00:46.46,0:00:49.96,Default,,0,0,0,,Менің сезімімді түсінесің бе? Менің ойлағаным осы сияқты
Dialogue: 0,0:00:54.26,0:00:58.22,Default,,0,0,0,,Ал мен жүрек соғысының не екенін білмеймін.
Dialogue: 0,0:01:00.56,0:01:02.39,Default,,0,0,0,,Ешқандай сөз шықпайды
Dialogue: 0,0:01:04.85,0:01:06.02,Default,,0,0,0,,(винилді ысқылау дыбысы)
Dialogue: 0,0:01:13.11,0:01:15.15,Default,,0,0,0,,Тіндердің туралануы?
Dialogue: 0,0:01:16.24,0:01:18.03,Default,,0,0,0,,Қызық, ол шашлыктан кірлене ме?
Dialogue: 0,0:01:18.12,0:01:19.41,Default,,0,0,0,,Менде олар көп болды.
Dialogue: 0,0:01:19.91,0:01:21.12,Default,,0,0,0,,Менеджер
Dialogue: 0,0:01:21.70,0:01:23.12,Default,,0,0,0,,Қаласаңыз, пайдаланыңыз
Dialogue: 0,0:01:25.12,0:01:26.37,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:33.38,0:01:35.17,Default,,0,0,0,,Сіз қалағаныңызша жылай аласыз.
Dialogue: 0,0:01:36.22,0:01:37.05,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:38.84,0:01:40.93,Default,,0,0,0,,Саған қатты ұнады, солай ма?
Dialogue: 0,0:01:41.56,0:01:42.39,Default,,0,0,0,,Иә
Dialogue: 0,0:01:47.06,0:01:47.81,Default,,0,0,0,,Иә
Dialogue: 0,0:01:52.57,0:01:56.61,Default,,0,0,0,,Қызық, Инота адамдар оны осылай ойлайтынын біледі ме?
Dialogue: 0,0:01:58.91,0:02:01.62,Default,,0,0,0,,Маған мойындаған адамдардың кейбірі
Dialogue: 0,0:02:02.12,0:02:04.04,Default,,0,0,0,,Кейбір адамдар маған осылай ғашық болды
Dialogue: 0,0:02:04.12,0:02:05.50,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:02:10.67,0:02:13.00,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:02:21.60,0:02:23.60,Default,,0,0,0,,Мен бұл қиын екенін білемін.
Dialogue: 0,0:02:25.64,0:02:29.60,Default,,0,0,0,,Біреуді қатты жақсы көретініңді қызғанамын
Dialogue: 0,0:02:33.82,0:02:35.82,Default,,0,0,0,,♪~
Dialogue: 0,0:04:00.49,0:04:02.49,Default,,0,0,0,,~♪
Dialogue: 0,0:04:03.57,0:04:05.91,Default,,0,0,0,,Қайту автобусы 17:00-де.
Dialogue: 0,0:04:05.99,0:04:07.87,Default,,0,0,0,,Мен оған дейін ойын ойнаймын.
Dialogue: 0,0:04:07.95,0:04:10.66,Default,,0,0,0,,Алдымен заттарыңызды жинаңыз
Dialogue: 0,0:04:11.37,0:04:12.92,Default,,0,0,0,,Бұл сүйкімді үлгі
Dialogue: 0,0:04:13.00,0:04:14.17,Default,,0,0,0,,Бұл менің әпкемдікі
Dialogue: 0,0:04:15.29,0:04:15.92,Default,,0,0,0,,Ах
Dialogue: 0,0:04:21.76,0:04:25.22,Default,,0,0,0,,Мен бірінші жаттығу залына барамын.
Dialogue: 0,0:04:25.72,0:04:27.80,Default,,0,0,0,,30 минутта жаттығу.
Dialogue: 0,0:04:27.89,0:04:29.31,Default,,0,0,0,,Мен қызмет етуді үйренгім келеді
Dialogue: 0,0:04:29.81,0:04:30.72,Default,,0,0,0,,Иә
Dialogue: 0,0:04:43.78,0:04:44.78,Default,,0,0,0,,(Қызмет көрсету дыбысы)
Dialogue: 0,0:04:57.29,0:04:58.63,Default,,0,0,0,,Қате емес
Dialogue: 0,0:04:59.13,0:05:01.46,Default,,0,0,0,,Түсіндірмеу қиынырақ.
Dialogue: 0,0:05:04.63,0:05:06.97,Default,,0,0,0,,Мен жақсы дедім!
Dialogue: 0,0:05:07.97,0:05:08.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:11.31,0:05:12.22,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:05:15.27,0:05:15.98,Default,,0,0,0,,Хмм!
Dialogue: 0,0:05:17.94,0:05:18.90,Default,,0,0,0,,В
Dialogue: 0,0:05:18.98,0:05:19.73,Default,,0,0,0,,Ах
Dialogue: 0,0:05:20.32,0:05:23.49,Default,,0,0,0,,Тіпті соңғы күннің өзінде жағдай бәсеңдемейтін сияқты.
Dialogue: 0,0:05:24.82,0:05:27.53,Default,,0,0,0,,Егер сіз осындай нәрсеге ренжіп қалсаңыз, сіз жеңе алмайсыз.
Dialogue: 0,0:05:27.61,0:05:30.08,Default,,0,0,0,,Керемет
Dialogue: 0,0:05:31.08,0:05:31.74,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:05:32.83,0:05:34.87,Default,,0,0,0,,Мен сіріңке сұрайын ба?
Dialogue: 0,0:05:38.83,0:05:40.17,Default,,0,0,0,,Барлығын ұнатыңыз
Dialogue: 0,0:05:40.25,0:05:41.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:46.09,0:05:49.18,Default,,0,0,0,,Тадаши: Өтінемін, Нисиданы оята аласыз ба?
Dialogue: 0,0:05:49.26,0:05:50.01,Default,,0,0,0,,Иә
Dialogue: 0,0:05:54.73,0:05:57.19,Default,,0,0,0,,Мен қажет емес нәрсе жасадым.
Dialogue: 0,0:05:57.27,0:06:00.06,Default,,0,0,0,,Ондай нәрсе болады деп ойламаппын.
Dialogue: 0,0:06:01.61,0:06:03.03,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:06:03.11,0:06:04.03,Default,,0,0,0,,Ах
Dialogue: 0,0:06:05.15,0:06:06.53,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:06.61,0:06:09.57,Default,,0,0,0,,Оның Касахара-кунға қатысы жоқ.
Dialogue: 0,0:06:09.66,0:06:12.87,Default,,0,0,0,,Көзілдірікті сөндірмеңіз
Dialogue: 0,0:06:21.00,0:06:22.38,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:06:23.13,0:06:24.96,Default,,0,0,0,,Дайки мен Чоно-сан ше?
Dialogue: 0,0:06:26.38,0:06:27.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:28.68,0:06:30.59,Default,,0,0,0,,Do you know?
Dialogue: 0,0:06:32.97,0:06:35.06,Default,,0,0,0,,Күтілгендей, солай болды.
Dialogue: 0,0:06:35.77,0:06:38.14,Default,,0,0,0,,Мен кешеден бері біртүрлі болып жүрмін.
Dialogue: 0,0:06:40.35,0:06:43.32,Default,,0,0,0,,Көремін, үлкен қуаныш, - деп жауап бердім.
Dialogue: 0,0:06:49.70,0:06:50.82,Default,,0,0,0,,8-4
Dialogue: 0,0:06:52.24,0:06:54.41,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:54.49,0:06:55.08,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:06:55.95,0:06:58.58,Default,,0,0,0,,Бұл жолмен қош айт, ақымақ.
Dialogue: 0,0:06:59.08,0:07:01.00,Default,,0,0,0,,Соңғы жаттығу Қолымыздан келгенді жасайық
Dialogue: 0,0:07:08.17,0:07:10.76,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:07:12.93,0:07:15.43,Default,,0,0,0,,Біріншіден, өзіңе ұнайтын адамның болуы нені білдіреді?
Dialogue: 0,0:07:15.51,0:07:16.85,Default,,0,0,0,,Оны бірінші рет естіп тұрмын.
Dialogue: 0,0:07:16.93,0:07:18.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:18.68,0:07:20.06,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:07:21.56,0:07:24.36,Default,,0,0,0,,Мені қатты жақсы көретін қыздың бар екеніне сене алар емеспін
Dialogue: 0,0:07:25.40,0:07:26.69,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:07:28.99,0:07:31.49,Default,,0,0,0,,Егер сізді мүлде қызықтырмаса, мен түсінемін.
Dialogue: 0,0:07:31.99,0:07:35.74,Default,,0,0,0,,Екеуміз дос ретінде жақсы араласатынбыз, сонда неге болмайды?
Dialogue: 0,0:07:36.24,0:07:38.95,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:07:40.41,0:07:43.13,Default,,0,0,0,,Мен мұны айтсам Чоно мырза ашуланатын шығар.
Dialogue: 0,0:07:43.75,0:07:44.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:45.79,0:07:49.55,Default,,0,0,0,,Дос болған кезде жақсы араласатын сияқты едік.
Dialogue: 0,0:07:49.63,0:07:50.38,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:07:50.47,0:07:51.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.34,0:07:54.14,Default,,0,0,0,,Менің де үлкен қуанышқа ұмтылуға бейімім бар.
Dialogue: 0,0:07:54.22,0:07:56.39,Default,,0,0,0,,Ол қуғанға үйренбеген сияқты.
Dialogue: 0,0:07:57.06,0:08:01.27,Default,,0,0,0,,Дос ретінде не маңызды, ал махаббат қарым-қатынасында не маңызды
Dialogue: 0,0:08:01.35,0:08:03.19,Default,,0,0,0,,Өйткені, бұл басқаша, солай емес пе?
Dialogue: 0,0:08:06.19,0:08:07.44,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:08:09.32,0:08:10.90,Default,,0,0,0,,Осындай жеңіл сөздермен...\NСіз тек
Dialogue: 0,0:08:11.53,0:08:12.99,Default,,0,0,0,,айта аласыз
Dialogue: 0,0:08:13.49,0:08:15.99,Default,,0,0,0,,Қанша алыс жүрсек те, біз әлі де даладамыз
Dialogue: 0,0:08:17.16,0:08:18.66,Default,,0,0,0,,Оны Дайки шешті.
Dialogue: 0,0:08:20.75,0:08:22.16,Default,,0,0,0,,Тікелей №...
Dialogue: 0,0:08:22.25,0:08:23.42,Default,,0,0,0,,Крест
Dialogue: 0,0:08:29.76,0:08:31.34,Default,,0,0,0,,13-6
Dialogue: 0,0:08:32.97,0:08:35.18,Default,,0,0,0,,Олар маған гол соғуға мүлде рұқсат бермейді.
Dialogue: 0,0:08:36.01,0:08:38.81,Default,,0,0,0,,Соңғы кездері мен сені ойын ойнамайды деп ойладым.
Dialogue: 0,0:08:38.89,0:08:39.68,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:08:42.02,0:08:43.69,Default,,0,0,0,,Қайтадан күшейе түсу
Dialogue: 0,0:08:43.77,0:08:44.69,Default,,0,0,0,,Мен қуып жеткім келеді
Dialogue: 0,0:08:44.77,0:08:45.69,Default,,0,0,0,,Әлі белгісіз — менде бар.
Dialogue: 0,0:08:46.56,0:08:48.44,Default,,0,0,0,,Харю-сенпай күшейсе
Dialogue: 0,0:08:48.52,0:08:50.44,Default,,0,0,0,,Мен де жақсырақ істей алуым керек.
Dialogue: 0,0:08:50.53,0:08:51.44,Default,,0,0,0,,Қосымша
Dialogue: 0,0:08:52.53,0:08:53.78,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:08:56.45,0:08:57.45,Default,,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:08:57.53,0:08:59.16,Default,,0,0,0,,Бұл дәл сен күткендей.
Dialogue: 0,0:08:59.66,0:09:01.37,Default,,0,0,0,,Сізге үлкен рахмет~
Dialogue: 0,0:09:01.45,0:09:02.45,Default,,0,0,0,,Не!
Dialogue: 0,0:09:03.12,0:09:04.46,Default,,0,0,0,,Тағы бір ойын!
Dialogue: 0,0:09:04.54,0:09:06.46,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:09:06.54,0:09:07.79,Default,,0,0,0,,Соңы
Dialogue: 0,0:09:08.29,0:09:11.76,Default,,0,0,0,,Жаттығудың соңғы күні, мен шаршадым.
Dialogue: 0,0:09:13.51,0:09:14.97,Default,,0,0,0,,Жеңіңіз және жүгіріңіз
Dialogue: 0,0:09:18.39,0:09:19.14,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:21.31,0:09:23.81,Default,,0,0,0,,Мен шынымды айтамын
Dialogue: 0,0:09:25.06,0:09:28.48,Default,,0,0,0,,Саған қарсы ойнауға қорықтым.
Dialogue: 0,0:09:29.06,0:09:30.07,Default,,0,0,0,,А...
Dialogue: 0,0:09:31.32,0:09:32.99,Default,,0,0,0,,Харю-сенпай
Dialogue: 0,0:09:33.07,0:09:34.95,Default,,0,0,0,,Бұл ақсақ.
Dialogue: 0,0:09:36.82,0:09:39.74,Default,,0,0,0,,Соңында мен Хиодо мырзаны жеңе алмадым.
Dialogue: 0,0:09:40.33,0:09:42.45,Default,,0,0,0,,Өйткені мен рұқсатсыз зейнетке шығуды шештім.
Dialogue: 0,0:09:44.00,0:09:47.46,Default,,0,0,0,,Бұл жаттығу кездесуі болса да, мен бірінші курс студенті Юса-куннан жеңіліп қалдым.
Dialogue: 0,0:09:47.96,0:09:50.50,Default,,0,0,0,,Оның үстіне Дайкиге жеңіліп қалсаңыз
Dialogue: 0,0:09:50.59,0:09:53.42,Default,,0,0,0,,Күткендей, мен де өз сенімімді жоғалтып ала жаздадым.
Dialogue: 0,0:09:56.47,0:09:58.43,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:09:58.93,0:09:59.89,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:01.18,0:10:03.89,Default,,0,0,0,,Ойнағанымызға қуаныштымын.
Dialogue: 0,0:10:04.52,0:10:07.31,Default,,0,0,0,,Мәңгілік қашып кету аяныштырақ болар еді.
Dialogue: 0,0:10:07.98,0:10:10.06,Default,,0,0,0,,Сіз жоғалтудан қорқасыз ба?
Dialogue: 0,0:10:10.15,0:10:12.73,Default,,0,0,0,,Жеңіл намысым жыртылды.
Dialogue: 0,0:10:13.90,0:10:16.15,Default,,0,0,0,,Мұның бәрін қабылдаңыз.
Dialogue: 0,0:10:16.24,0:10:19.99,Default,,0,0,0,,Шайнап, ет пен қанға айналдырып, алға қарай жорғала.
Dialogue: 0,0:10:20.99,0:10:24.41,Default,,0,0,0,,Өйткені бұл күш деп ойлаймын
Dialogue: 0,0:10:34.51,0:10:36.17,Default,,0,0,0,,Барлығы күшті.
Dialogue: 0,0:10:37.05,0:10:39.80,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сен де.
Dialogue: 0,0:11:06.58,0:11:08.25,Default,,0,0,0,,-(Үлкен қуаныш) Чинацу-сенпай -(Чинацу) Иә?
Dialogue: 0,0:11:08.33,0:11:11.58,Default,,0,0,0,,Қош келдіңіз, Дайки-кун.
Dialogue: 0,0:11:11.67,0:11:13.50,Default,,0,0,0,,Чинацу-сенпай да солай емес пе?
Dialogue: 0,0:11:14.00,0:11:14.92,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:11:15.42,0:11:16.51,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:11:17.21,0:11:18.26,Default,,0,0,0,,Қызық екен
Dialogue: 0,0:11:23.22,0:11:24.56,Default,,0,0,0,,Чинацу Сенпай
Dialogue: 0,0:11:24.64,0:11:25.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:25.85,0:11:29.35,Default,,0,0,0,,Келесі мереке, бір жерге бірге барғыңыз келе ме?
Dialogue: 0,0:11:41.36,0:11:42.49,Default,,0,0,0,,Қайда?
Dialogue: 0,0:11:42.57,0:11:43.28,Default,,0,0,0,,Не!
Dialogue: 0,0:11:43.37,0:11:45.37,Default,,0,0,0,,Біз қайда баруымыз керек?
Dialogue: 0,0:11:45.45,0:11:47.87,Default,,0,0,0,,Ойын-сауық саябақтары тым айқын.
Dialogue: 0,0:11:47.95,0:11:50.00,Default,,0,0,0,,Мен бұрын аквариумға барғанмын.
Dialogue: 0,0:11:50.08,0:11:52.62,Default,,0,0,0,,Тағы не... аа, шоппинг?
Dialogue: 0,0:11:52.71,0:11:54.29,Default,,0,0,0,,Мен соңғы уақытта нені қалаймын...
Dialogue: 0,0:11:54.88,0:11:57.80,Default,,0,0,0,,Джерси! Мен футболка сатып алғым келеді
Dialogue: 0,0:11:57.88,0:12:00.80,Default,,0,0,0,,Ол оқу-жаттығу жиынында құлап қалды, сондықтан мен жаңасын сатып алуды шештім.
Dialogue: 0,0:12:00.88,0:12:01.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:02.34,0:12:03.39,Default,,0,0,0,,Мен артынан келіп, оның көзі мен аузын жауып, «Сізді екінші Кира болуы мүмкін деген күдікпен қамауға аламыз» дедім.
Dialogue: 0,0:12:03.89,0:12:05.93,Default,,0,0,0,,Жейде дегеніміз не?
Dialogue: 0,0:12:06.01,0:12:08.06,Default,,0,0,0,,Тым сексуалды
Dialogue: 0,0:12:08.14,0:12:09.27,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:09.77,0:12:10.85,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:10.93,0:12:14.81,Default,,0,0,0,,Оның орнына мен барғым келетін кафе бар.
Dialogue: 0,0:12:14.90,0:12:15.81,Default,,0,0,0,,Барсам болады ма?
Dialogue: 0,0:12:15.90,0:12:16.61,Default,,0,0,0,,А...
Dialogue: 0,0:12:17.11,0:12:18.57,Default,,0,0,0,,А... иә, әрине.
Dialogue: 0,0:12:19.19,0:12:20.15,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:12:22.03,0:12:25.78,Default,,0,0,0,,Келесі сенбі жақсы болар ма еді? Бұл таңғы жаттығу болды, солай ма?
Dialogue: 0,0:12:25.87,0:12:26.58,Default,,0,0,0,,Иә
Dialogue: 0,0:12:27.16,0:12:29.08,Default,,0,0,0,,Содан кейін келесі сенбі
Dialogue: 0,0:12:34.17,0:12:35.42,Default,,0,0,0,,(төсекке құлау дыбысы)
Dialogue: 0,0:12:39.17,0:12:40.59,Default,,0,0,0,,Бұл кездесу!
Dialogue: 0,0:12:42.17,0:12:44.09,Default,,0,0,0,,Жейде сатып алу үшін.
Dialogue: 0,0:12:44.18,0:12:47.60,Default,,0,0,0,,Аквариум Бұл менің теңізден кейінгі бірінші саяхатым.
Dialogue: 0,0:12:47.68,0:12:51.60,Default,,0,0,0,,Оның үстіне, Чинацу-сенпай да бұған өте ынталы көрінді.
Dialogue: 0,0:12:52.10,0:12:54.14,Default,,0,0,0,,Міне, көп жұмыс істеу керек.
Dialogue: 0,0:12:54.23,0:12:55.60,Default,,0,0,0,,Маған мінезіңді көрсет!
Dialogue: 0,0:12:58.32,0:13:01.61,Default,,0,0,0,,Бұл сіздің мойындау мүмкіндігіңіз.
Dialogue: 0,0:13:23.26,0:13:25.13,Default,,0,0,0,,Хиначи, ойынға барайық!
Dialogue: 0,0:13:25.22,0:13:26.39,Default,,0,0,0,,Не!
Dialogue: 0,0:13:26.47,0:13:27.85,Default,,0,0,0,,Бұдан былай?
Dialogue: 0,0:13:27.93,0:13:30.68,Default,,0,0,0,,3 түн 4 күн аскет болдым.
Dialogue: 0,0:13:30.76,0:13:32.39,Default,,0,0,0,,Маған қатты ойнау керек
Dialogue: 0,0:13:32.47,0:13:33.89,Default,,0,0,0,,Бірақ багаж...
Dialogue: 0,0:13:33.98,0:13:35.89,Default,,0,0,0,,Оны шкафта қалдырыңыз.
Dialogue: 0,0:13:36.56,0:13:40.65,Default,,0,0,0,,Қиын кездеріңізде, ең дұрысы - ойлауға аз уақыт жұмсау.
Dialogue: 0,0:13:40.73,0:13:41.40,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:13:41.98,0:13:43.61,Default,,0,0,0,,Ол басқаша емес пе?
Dialogue: 0,0:13:43.69,0:13:45.90,Default,,0,0,0,,Сізге ләззат алу керек, солай ма?
Dialogue: 0,0:13:45.99,0:13:48.87,Default,,0,0,0,,Ах, Хиначи, қызыл ерін саған жақсы көрінеді.
Dialogue: 0,0:13:48.95,0:13:50.91,Default,,0,0,0,,Негізі мен оны ешқашан салған емеспін.
Dialogue: 0,0:13:51.58,0:13:53.16,Default,,0,0,0,,Ал, келесі жолы барайық.
Dialogue: 0,0:13:53.25,0:13:54.45,Default,,0,0,0,,Иә
Dialogue: 0,0:13:56.25,0:13:58.79,Default,,0,0,0,,Хоккей Келесі хоккей.
Dialogue: 0,0:13:58.88,0:14:00.67,Default,,0,0,0,,Мен мұны ешқашан жасаған емеспін.
Dialogue: 0,0:14:00.75,0:14:03.71,Default,,0,0,0,,Е, менің өмірімнің 20%-ы шығын.
Dialogue: 0,0:14:03.80,0:14:05.17,Default,,0,0,0,,20%...
Dialogue: 0,0:14:06.09,0:14:08.93,Default,,0,0,0,,Айтпақшы, Хагеннің жаңа жұмысы 50%-дан асады.
Dialogue: 0,0:14:09.01,0:14:11.47,Default,,0,0,0,,Мен не істеуім керек? Мен 70% жоғалттым.
Dialogue: 0,0:14:11.56,0:14:13.27,Default,,0,0,0,,20% жинап алайық!
Dialogue: 0,0:14:13.35,0:14:14.18,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:14.27,0:14:15.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:15.39,0:14:16.19,Default,,0,0,0,,(ұпайлар)
Dialogue: 0,0:14:16.27,0:14:18.10,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:14:18.19,0:14:20.19,Default,,0,0,0,,Менің көңіл көтергіңіз келмейді, солай ма?
Dialogue: 0,0:14:21.77,0:14:22.69,Default,,0,0,0,,Га
Dialogue: 0,0:14:22.77,0:14:23.69,Default,,0,0,0,,Ахаха
Dialogue: 0,0:14:24.28,0:14:25.07,Default,,0,0,0,,Эй!
Dialogue: 0,0:14:25.15,0:14:26.70,Default,,0,0,0,,(ұпайлар)
Dialogue: 0,0:14:26.78,0:14:28.57,Default,,0,0,0,,Жеңімпаз!
Dialogue: 0,0:14:28.66,0:14:30.45,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:30.53,0:14:32.28,Default,,0,0,0,,(Қайталанған барабан соғу дыбысы)
Dialogue: 0,0:14:32.37,0:14:33.45,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:14:33.54,0:14:34.58,Default,,0,0,0,,Жүр! Бар!
Dialogue: 0,0:14:34.66,0:14:35.95,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:14:37.29,0:14:38.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:38.79,0:14:40.71,Default,,0,0,0,,Хмм!
Dialogue: 0,0:14:40.79,0:14:42.38,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:42.46,0:14:44.71,Default,,0,0,0,,Өзіңізді сәл жақсы сезінген сияқтысыз.
Dialogue: 0,0:14:44.80,0:14:47.42,Default,,0,0,0,,Бүгінгі күнді көңілді өткізейік
Dialogue: 0,0:14:47.93,0:14:49.59,Default,,0,0,0,,Бұл ирис емес пе?
Dialogue: 0,0:14:49.68,0:14:52.51,Default,,0,0,0,,Қандай таныстар? Бұл сүйкімді
Dialogue: 0,0:14:52.60,0:14:53.72,Default,,0,0,0,,Бұрынғы қыз
Dialogue: 0,0:14:54.31,0:14:55.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:56.18,0:14:59.23,Default,,0,0,0,,Не деген ысырап, менімен неге ажырастың?
Dialogue: 0,0:14:59.31,0:15:01.48,Default,,0,0,0,,Е, жоқ, солай.
Dialogue: 0,0:15:01.56,0:15:04.23,Default,,0,0,0,,Негізі өзімшіл?
Dialogue: 0,0:15:04.90,0:15:08.03,Default,,0,0,0,,Дүкен қызметкерлеріне деген көзқарас әрқашан сондай тітіркендіргіш.
Dialogue: 0,0:15:08.11,0:15:10.99,Default,,0,0,0,,M өлшемі мен L өлшемі туралы нақты айтыңыз.
Dialogue: 0,0:15:11.74,0:15:14.54,Default,,0,0,0,,Мен жайбарақат араласа аламыз деп ойладым.
Dialogue: 0,0:15:16.41,0:15:19.83,Default,,0,0,0,,Ол епсіз, бірақ мен оны жақсы адам сияқты деп ойладым.
Dialogue: 0,0:15:20.37,0:15:23.00,Default,,0,0,0,,Бұл мен күткеннен басқаша болды.
Dialogue: 0,0:15:23.09,0:15:25.42,Default,,0,0,0,,Менің көретін көзім болмады.
Dialogue: 0,0:15:25.92,0:15:26.76,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:27.63,0:15:30.26,Default,,0,0,0,,Менен басқа ешкіммен ұзаққа бармады.
Dialogue: 0,0:15:31.30,0:15:33.85,Default,,0,0,0,,Әпкеңнің әдемі жігіті бар.
Dialogue: 0,0:15:33.93,0:15:37.14,Default,,0,0,0,,Біраз жанашырлық пен осы сияқты нәрселерді үйренейік ...
Dialogue: 0,0:15:37.22,0:15:37.89,Default,,0,0,0,,(Танжиро) Барлығы жақсы болады. Бұл адам ешкімді өлтірген жоқ.
Dialogue: 0,0:15:37.98,0:15:41.52,Default,,0,0,0,,Егер сіз шешім қабылдамасаңыз, сіз өзіңізді қорғай алмайсыз.
Dialogue: 0,0:15:41.60,0:15:42.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:42.69,0:15:44.02,Default,,0,0,0,,Егер сіз айтқыңыз келсе
Dialogue: 0,0:15:44.65,0:15:46.53,Default,,0,0,0,,Көретін көзің жоқ.
Dialogue: 0,0:15:47.61,0:15:51.20,Default,,0,0,0,,Менің ақыл-есі дұрыс, бірақ оны шайқау біртүрлі.
Dialogue: 0,0:15:51.28,0:15:53.53,Default,,0,0,0,,Егер сіз басқа адам қателеседі деп ойласаңыз
Dialogue: 0,0:15:53.62,0:15:57.79,Default,,0,0,0,,Мен де өзімді жақсы көремін деп ойлаған кездерім
Dialogue: 0,0:15:58.75,0:16:01.00,Default,,0,0,0,,Өйткені сізге зиян тигізбеу керек
Dialogue: 0,0:16:02.37,0:16:03.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:05.29,0:16:09.01,Default,,0,0,0,,Келесі жолы алдыма шыққанда, мен сенің арқаңды ағызамын!
Dialogue: 0,0:16:09.09,0:16:09.80,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:10.72,0:16:11.80,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:11.88,0:16:15.05,Default,,0,0,0,,Жоқ, Хиначи жаман емес.
Dialogue: 0,0:16:16.22,0:16:17.85,Default,,0,0,0,,Бұл жерде ештеңе жоқ
Dialogue: 0,0:16:29.32,0:16:30.24,Default,,0,0,0,,Ах
Dialogue: 0,0:16:40.33,0:16:41.12,Default,,0,0,0,,Уау
Dialogue: 0,0:16:41.21,0:16:42.92,Default,,0,0,0,,О, кешіріңіз~
Dialogue: 0,0:16:43.00,0:16:45.21,Default,,0,0,0,,Менеджер Енді әдейі...
Dialogue: 0,0:16:45.29,0:16:48.05,Default,,0,0,0,,Мұны қоймаға апара аласыз ба?
Dialogue: 0,0:16:48.55,0:16:49.34,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:50.84,0:16:54.30,Default,,0,0,0,,Мм... оқу-жаттығу жиынынан бері бір нәрсеге ашуландыңыз ба?
Dialogue: 0,0:16:54.80,0:16:56.26,Default,,0,0,0,,Егер мен бірдеңе жасасам...
Dialogue: 0,0:16:57.22,0:16:58.76,Default,,0,0,0,,Ерекше ештеңе жоқ
Dialogue: 0,0:16:58.85,0:17:00.60,Default,,0,0,0,,Иә, бар.
Dialogue: 0,0:17:01.89,0:17:02.77,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:17:05.98,0:17:07.48,Default,,0,0,0,,Чоно мырза жылап отырды.
Dialogue: 0,0:17:07.56,0:17:08.27,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:10.98,0:17:11.78,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:17:12.36,0:17:13.53,Default,,0,0,0,,Және бумен пісірілген тәтті картоп.
Dialogue: 0,0:17:14.24,0:17:18.62,Default,,0,0,0,,Мен сен ойлағаннан 100 есе көп зардап шеккен шығармын, Иномата.
Dialogue: 0,0:17:19.12,0:17:21.62,Default,,0,0,0,,Әлі де жақсы болып көріну...
Dialogue: 0,0:17:25.87,0:17:27.33,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:17:27.84,0:17:32.05,Default,,0,0,0,,Мен Хинаның қазіргі күйінде онымен сөйлесе алмаймын.
Dialogue: 0,0:17:33.05,0:17:35.51,Default,,0,0,0,,Мен өз ойымды айттым деп ойладым.
Dialogue: 0,0:17:35.59,0:17:37.85,Default,,0,0,0,,Балапандар тағы не істейді?
Dialogue: 0,0:17:37.93,0:17:39.56,Default,,0,0,0,,Менің қолымнан келетіні – күту.
Dialogue: 0,0:17:40.35,0:17:44.18,Default,,0,0,0,,Мен өзімнің ең жақын досым болғым келетін сияқты бірдеңе де айта алмаймын.
Dialogue: 0,0:17:45.98,0:17:49.27,Default,,0,0,0,,Өз сөзіммен айтсам, бұл маңызды деп ойлаймын.
Dialogue: 0,0:17:50.32,0:17:52.57,Default,,0,0,0,,Бірақ... не?
Dialogue: 0,0:17:54.70,0:17:56.24,Default,,0,0,0,,Мен үшін күткендей
Dialogue: 0,0:17:56.32,0:17:59.28,Default,,0,0,0,,Хиначи сияқты қызға қалай қарайтыныңды түсінбеймін.
Dialogue: 0,0:18:01.16,0:18:04.83,Default,,0,0,0,,Сізге ұнайтын адамдар шынымен соншалықты тартымды ма?
Dialogue: 0,0:18:05.41,0:18:06.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:08.75,0:18:11.46,Default,,0,0,0,,Ей, жаттығуды бастайық.
Dialogue: 0,0:18:11.55,0:18:12.46,Default,,0,0,0,,Иә
Dialogue: 0,0:18:14.30,0:18:16.13,Default,,0,0,0,,Бұл қандай сұрақ?
Dialogue: 0,0:18:16.93,0:18:18.34,Default,,0,0,0,,Егер сіз «иә» десеңіз
Dialogue: 0,0:18:19.18,0:18:21.26,Default,,0,0,0,,Балапандар ондай емес сияқты.
Dialogue: 0,0:18:30.73,0:18:31.36,Default,,0,0,0,,Ах
Dialogue: 0,0:18:31.44,0:18:32.61,Default,,0,0,0,,Не?
Dialogue: 0,0:18:32.69,0:18:33.86,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:18:35.49,0:18:39.36,Default,,0,0,0,,Менің ойымша, сіз бәрібір қажетсіз нәрсені қайта жасауды ойлап жатырсыз.
Dialogue: 0,0:18:39.95,0:18:41.87,Default,,0,0,0,,Иә Жұлдыз беті
Dialogue: 0,0:18:43.79,0:18:45.62,Default,,0,0,0,,Сырт қорғаушы екенім рас.
Dialogue: 0,0:18:46.25,0:18:48.21,Default,,0,0,0,,Себебі мен сені осылай көрдім
Dialogue: 0,0:18:48.29,0:18:50.63,Default,,0,0,0,,Өйткені мен оған қарап, «неге?» деп ойладым.
Dialogue: 0,0:18:51.38,0:18:53.92,Default,,0,0,0,,Мен өз ойымды анық айтайын.
Dialogue: 0,0:18:54.00,0:18:55.59,Default,,0,0,0,,Өйткені бұл менмін
Dialogue: 0,0:18:55.67,0:18:56.63,Default,,0,0,0,,Бұл біраз кінәлі сезім емес пе?
Dialogue: 0,0:18:57.22,0:18:59.30,Default,,0,0,0,,Мен басқа адамның қандай екенін білмеймін
Dialogue: 0,0:18:59.38,0:19:01.64,Default,,0,0,0,,Оны қалай түсіндіру керектігін адамның өз еркіне қалдырамын.
Dialogue: 0,0:19:04.06,0:19:06.35,Default,,0,0,0,,Расында да менеджерге рахмет
Dialogue: 0,0:19:06.43,0:19:08.98,Default,,0,0,0,,Чоно мырзаның құтқарылған бөлігі болуы керек.
Dialogue: 0,0:19:10.06,0:19:12.48,Default,,0,0,0,,Ондай адам болса да
Dialogue: 0,0:19:13.48,0:19:14.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:17.15,0:19:19.53,Default,,0,0,0,,Жоғарыдан келе жатқан сияқты.
Dialogue: 0,0:19:19.61,0:19:21.24,Default,,0,0,0,,Бірінші рет айтылды
Dialogue: 0,0:19:21.32,0:19:21.91,Default,,0,0,0,,А...
Dialogue: 0,0:19:24.79,0:19:25.83,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:26.41,0:19:29.33,Default,,0,0,0,,Усамими-чан, мен мектеп фестивалінде жасаған
Dialogue: 0,0:19:30.25,0:19:32.04,Default,,0,0,0,,Көруді қараңғылау арқылы
Dialogue: 0,0:19:32.13,0:19:34.67,Default,,0,0,0,,Оның концентрацияны арттыратын механизмі бар.
Dialogue: 0,0:19:35.88,0:19:38.88,Default,,0,0,0,,Жарайды, Хина, мен сенен оны кейінге қалдыруыңды өтінемін.
Dialogue: 0,0:19:41.47,0:19:42.09,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:49.85,0:19:52.48,Default,,0,0,0,,Мен гимназияны жарғым келеді
Dialogue: 0,0:19:53.19,0:19:56.86,Default,,0,0,0,,Мен үйірме жұмыстарынан мені тастап кеткендіктен ғана демалыс алғым келмейді.
Dialogue: 0,0:19:57.94,0:20:01.86,Default,,0,0,0,,Дайки мен Чинацу-сенпаймен бір кеңістікте болу
Dialogue: 0,0:20:03.03,0:20:04.66,Default,,0,0,0,,Тыныс алу қиын
Dialogue: 0,0:20:11.96,0:20:14.00,Default,,0,0,0,,Тадаши Сіз менің смартфонымды білмейсіз бе?
Dialogue: 0,0:20:14.08,0:20:15.88,Default,,0,0,0,,Сіз оны ертерек орындыққа қойдыңыз.
Dialogue: 0,0:20:16.59,0:20:18.96,Default,,0,0,0,,А, атта, рахмет
Dialogue: 0,0:20:19.05,0:20:20.80,Default,,0,0,0,,Эй, Дайки, біз тамақ жейміз...
Dialogue: 0,0:20:20.88,0:20:21.88,Default,,0,0,0,,Кешіріңіз, менің бір ісім бар.
Dialogue: 0,0:20:22.72,0:20:24.14,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:20:25.35,0:20:28.14,Default,,0,0,0,,Саған не болды, асығыссың ба?
Dialogue: 0,0:20:28.22,0:20:30.06,Default,,0,0,0,,Бұл күн, солай ма?
Dialogue: 0,0:20:30.14,0:20:31.14,Default,,0,0,0,,Не!
Dialogue: 0,0:20:31.23,0:20:33.40,Default,,0,0,0,,Мен жай ғана қалжыңдап тұрмын.
Dialogue: 0,0:20:33.48,0:20:34.73,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:20:34.81,0:20:37.40,Default,,0,0,0,,Тек оған, мұндай сатқындық...
Dialogue: 0,0:20:38.23,0:20:39.86,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,0:20:39.94,0:20:43.32,Default,,0,0,0,,Жоқ, мен оны тікелей өз аузынан естімедім.
Dialogue: 0,0:20:43.41,0:20:45.32,Default,,0,0,0,,Сонда қарсы жақ кім...
Dialogue: 0,0:20:45.41,0:20:46.33,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:20:46.41,0:20:47.58,Default,,0,0,0,,Хаха
Dialogue: 0,0:20:48.74,0:20:52.08,Default,,0,0,0,,Мен бұл қашанға дейін болып жатыр деп ойладым.
Dialogue: 0,0:20:53.33,0:20:56.00,Default,,0,0,0,,Жүгіріп жүргенде оған көбірек ұқсайды.
Dialogue: 0,0:20:57.75,0:20:59.76,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:21:02.93,0:21:05.18,Default,,0,0,0,,Гүлзардың алдында Гүлзарда...
Dialogue: 0,0:21:05.26,0:21:06.18,Default,,0,0,0,,Ах
Dialogue: 0,0:21:08.10,0:21:09.81,Default,,0,0,0,,Мына бала сүйкімді емес пе?
Dialogue: 0,0:21:17.48,0:21:18.98,Default,,0,0,0,,Нені қарадыңыз?
Dialogue: 0,0:21:19.53,0:21:21.28,Default,,0,0,0,,Ум...
Dialogue: 0,0:21:21.36,0:21:24.70,Default,,0,0,0,,Бүгін бұлттар жылдам қозғалады.
Dialogue: 0,0:21:53.56,0:21:55.56,Default,,0,0,0,,♪~
Dialogue: 0,0:23:20.52,0:23:22.52,Default,,0,0,0,,~♪
Dialogue: 0,0:23:24.02,0:23:30.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory