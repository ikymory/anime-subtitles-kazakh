Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:03.54,Default,,0,0,0,,♪~
Dialogue: 0,0:01:28.25,0:01:30.25,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.46,0:01:32.42,Default,,0,0,0,,Бүгіннен бастап
Dialogue: 0,0:01:32.50,0:01:34.76,Default,,0,0,0,,Көптеген мектептер жазғы демалыста
Dialogue: 0,0:01:34.84,0:01:35.80,Default,,0,0,0,,Тиісінше...
Dialogue: 0,0:01:36.88,0:01:37.80,Default,,0,0,0,,Ах
Dialogue: 0,0:01:38.43,0:01:39.93,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:40.51,0:01:43.43,Default,,0,0,0,,Жалғыз қалғанымыз өкінішті.
Dialogue: 0,0:01:43.52,0:01:45.18,Default,,0,0,0,,Менің кетуім табиғи емес.
Dialogue: 0,0:01:45.98,0:01:47.44,Default,,0,0,0,,Хё пушистый?
Dialogue: 0,0:01:48.10,0:01:48.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:49.35,0:01:50.61,Default,,0,0,0,,Үлпілдек?
Dialogue: 0,0:01:50.69,0:01:51.69,Default,,0,0,0,,Ах~
Dialogue: 0,0:01:52.86,0:01:54.65,Default,,0,0,0,,(шайлау дыбысы)
Dialogue: 0,0:01:56.24,0:01:59.16,Default,,0,0,0,,Бүгінгі клубтың қызметі? Біркелкі киім сирек кездеседі
Dialogue: 0,0:01:59.24,0:02:00.45,Default,,0,0,0,,А-а... иә.
Dialogue: 0,0:02:01.32,0:02:03.74,Default,,0,0,0,,Бірақ түстен кейін бәріміз кітапханаға бардық.
Dialogue: 0,0:02:03.83,0:02:05.62,Default,,0,0,0,,Жазғы демалыста үй тапсырмасын орындау туралы ойланып жатырсыз ба?
Dialogue: 0,0:02:06.12,0:02:07.29,Default,,0,0,0,,Сондықтан біз форма киеміз
Dialogue: 0,0:02:07.79,0:02:09.96,Default,,0,0,0,,Түсіндім, бұл жақсы.
Dialogue: 0,0:02:10.92,0:02:12.96,Default,,0,0,0,,Мүмкін мен де көшіруім керек.
Dialogue: 0,0:02:14.25,0:02:16.01,Default,,0,0,0,,Олай болса сәттілік.
Dialogue: 0,0:02:16.92,0:02:17.55,Default,,0,0,0,,Иә
Dialogue: 0,0:02:20.64,0:02:22.68,Default,,0,0,0,,Өте қалыпты
Dialogue: 0,0:02:26.56,0:02:28.06,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:02:28.56,0:02:31.06,Default,,0,0,0,,Сіз бұл туралы ұмыта аласыз.
Dialogue: 0,0:02:32.06,0:02:34.86,Default,,0,0,0,,Бұның қайталануына жол берме
Dialogue: 0,0:02:34.94,0:02:35.98,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:02:36.57,0:02:38.99,Default,,0,0,0,,Бұрынғыдан өзгеріс жоқ
Dialogue: 0,0:02:46.08,0:02:48.33,Default,,0,0,0,,Spi~ Spi~
Dialogue: 0,0:02:48.41,0:02:49.50,Default,,0,0,0,,Хина, ұйықтама
Dialogue: 0,0:02:49.58,0:02:51.46,Default,,0,0,0,,Хмм, мен ұйықтамаймын.
Dialogue: 0,0:02:51.54,0:02:54.63,Default,,0,0,0,,Енді бәріміз біргеміз, ойымызды жинақтайық.
Dialogue: 0,0:02:54.71,0:02:59.01,Default,,0,0,0,,Бірақ сіз ұйықтап жатқанда, сіздің миыңыз естеліктеріңізді реттейді...
Dialogue: 0,0:02:59.09,0:03:00.26,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:03:00.34,0:03:03.72,Default,,0,0,0,,Өйткені сандарға қарасаң да түсінбейсің.
Dialogue: 0,0:03:03.80,0:03:05.26,Default,,0,0,0,,Мен ешқашан мұндай нәрсені үйренген емеспін.
Dialogue: 0,0:03:05.35,0:03:06.89,Default,,0,0,0,,Мен үйрендім
Dialogue: 0,0:03:06.97,0:03:09.85,Default,,0,0,0,,Тек оны х орнына қойыңыз
Dialogue: 0,0:03:10.35,0:03:11.02,Default,,0,0,0,,Тапсырма?
Dialogue: 0,0:03:11.10,0:03:14.15,Default,,0,0,0,,Итоның жігіті ақыры шабуылға шықты.
Dialogue: 0,0:03:14.23,0:03:17.11,Default,,0,0,0,,Мен әрқашан Чоно-санды жақсы деп айтатынмын.
Dialogue: 0,0:03:18.28,0:03:20.24,Default,,0,0,0,,Жазғы демалысқа байланысты мен сені көре алмаймын.
Dialogue: 0,0:03:20.32,0:03:23.78,Default,,0,0,0,,Бүгін сіздің мүмкіндігіңіз, сондықтан біз байланыс ақпаратын алмасуымыз керек.
Dialogue: 0,0:03:23.87,0:03:25.74,Default,,0,0,0,,Күрсін! Ах... аа...
Dialogue: 0,0:03:25.83,0:03:26.78,Default,,0,0,0,,Үй тапсырмасын орында
Dialogue: 0,0:03:28.24,0:03:30.29,Default,,0,0,0,,Мен оны осы уақытқа дейін байқамадым.
Dialogue: 0,0:03:30.96,0:03:34.08,Default,,0,0,0,,Барлығы да білмей ғашық болады.
Dialogue: 0,0:03:42.43,0:03:44.14,Default,,0,0,0,,Неге әлсіреп тұрсың?
Dialogue: 0,0:03:44.22,0:03:47.31,Default,,0,0,0,,Мен ерінбеймін, таусылдым.
Dialogue: 0,0:03:48.18,0:03:49.89,Default,,0,0,0,,Жай ғана ұйықтама
Dialogue: 0,0:03:50.89,0:03:52.85,Default,,0,0,0,,Мен де сонда отырмын.
Dialogue: 0,0:03:52.94,0:03:55.31,Default,,0,0,0,,Сіз осында болмасаңыз, іше алмайсыз.
Dialogue: 0,0:03:56.31,0:03:58.27,Default,,0,0,0,,А, ол дақ қалды~
Dialogue: 0,0:03:58.36,0:04:02.07,Default,,0,0,0,,Ах! Келесі аптада отшашу болады!
Dialogue: 0,0:04:02.15,0:04:04.57,Default,,0,0,0,,Ой, бәріміз кеттік
Dialogue: 0,0:04:05.20,0:04:06.53,Default,,0,0,0,,Сасаки-кун, мені шақыр!
Dialogue: 0,0:04:06.62,0:04:07.83,Default,,0,0,0,,Аха, жақсы!
Dialogue: 0,0:04:07.91,0:04:11.75,Default,,0,0,0,,Бұл ностальгиялық. Мектептің 1-курсында оқып жүргенде бардық.
Dialogue: 0,0:04:12.25,0:04:14.37,Default,,0,0,0,,Сайджо-кун, жетекшілік ет.
Dialogue: 0,0:04:14.87,0:04:16.71,Default,,0,0,0,,Ол қазір не істеп жатыр?
Dialogue: 0,0:04:17.50,0:04:19.25,Default,,0,0,0,,Мен үшінші орта мектепте оқып, топта ойнадым.
Dialogue: 0,0:04:19.34,0:04:21.21,Default,,0,0,0,,Уау-ау
Dialogue: 0,0:04:21.30,0:04:24.22,Default,,0,0,0,,Дәл осы кезде мен Хинамен сөйлесе бастадым.
Dialogue: 0,0:04:25.51,0:04:26.84,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:28.76,0:04:31.22,Default,,0,0,0,,Келесі аптада отшашу фестивалі бар!
Dialogue: 0,0:04:31.89,0:04:34.64,Default,,0,0,0,,Орта мектепте бір сыныпта оқыдық.
Dialogue: 0,0:04:34.73,0:04:36.23,Default,,0,0,0,,Бәріміз кеттік!
Dialogue: 0,0:04:36.94,0:04:38.23,Default,,0,0,0,,Хина не істейді?
Dialogue: 0,0:04:39.02,0:04:40.90,Default,,0,0,0,,Мен алма кәмпит жегім келеді
Dialogue: 0,0:04:40.98,0:04:42.82,Default,,0,0,0,,Сіз барғыңыз келе ме?
Dialogue: 0,0:04:42.90,0:04:45.03,Default,,0,0,0,,Бірақ тәжірибе жоқ па?
Dialogue: 0,0:04:46.66,0:04:47.70,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:47.78,0:04:49.41,Default,,0,0,0,,Сағат 6-да аяқталады.
Dialogue: 0,0:04:49.49,0:04:52.25,Default,,0,0,0,,Мынандай болмаса, кәмпит алма жей алмаймын.
Dialogue: 0,0:04:52.33,0:04:54.25,Default,,0,0,0,,Ендеше, бара жатқандар, қол көтеріңдер!
Dialogue: 0,0:04:54.33,0:04:55.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:55.83,0:04:57.33,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:04:57.83,0:05:00.50,Default,,0,0,0,,Ах... Кешіріңіз, Иномата-кун.
Dialogue: 0,0:05:01.09,0:05:02.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:02.13,0:05:03.34,Default,,0,0,0,,Кофе жасау, яғни
Dialogue: 0,0:05:03.88,0:05:05.17,Default,,0,0,0,,Уайымдама, Чоно-сан.
Dialogue: 0,0:05:06.38,0:05:08.68,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:08.76,0:05:10.01,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:05:10.10,0:05:12.93,Default,,0,0,0,,Бұл өте қызық.
Dialogue: 0,0:05:24.61,0:05:26.53,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:05:27.11,0:05:30.03,Default,,0,0,0,,Кеш болды. Неге бүгін ғана...
Dialogue: 0,0:05:30.83,0:05:32.37,Default,,0,0,0,,Басталғалы жатыр
Dialogue: 0,0:05:32.45,0:05:33.54,Default,,0,0,0,,(отшашудың дыбысы)
Dialogue: 0,0:05:38.62,0:05:41.79,Default,,0,0,0,,А... басталды.
Dialogue: 0,0:05:44.51,0:05:46.80,Default,,0,0,0,,Қалай болғанда да, мен бәрін табуым керек.
Dialogue: 0,0:05:50.26,0:05:53.56,Default,,0,0,0,,Өтірік! Мен оны асыға күттім!
Dialogue: 0,0:05:58.48,0:06:00.10,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:06:00.19,0:06:04.07,Default,,0,0,0,,Гимнастикадан нәтиже алу үшін бір нәрсеге шыдау керек.
Dialogue: 0,0:06:04.98,0:06:07.82,Default,,0,0,0,,Барлығымен кездесіп, тамақ сататын дүңгіршектерді аралау
Dialogue: 0,0:06:08.57,0:06:10.82,Default,,0,0,0,,Сондай-ақ кәмпит алма
Dialogue: 0,0:06:11.45,0:06:12.49,Default,,0,0,0,,Сабыр...
Dialogue: 0,0:06:16.54,0:06:17.46,Default,,0,0,0,,Хой
Dialogue: 0,0:06:18.08,0:06:18.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:21.29,0:06:23.38,Default,,0,0,0,,Мен жүргенде маған бірдеңе сатып алуды өтінді.
Dialogue: 0,0:06:23.46,0:06:25.34,Default,,0,0,0,,Мен оны соңғысы болғандықтан сатып алдым.
Dialogue: 0,0:06:25.84,0:06:27.22,Default,,0,0,0,,Бұл субтитрлер JOJO's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles Group бірлесіп дайындады
Dialogue: 0,0:06:28.17,0:06:30.22,Default,,0,0,0,,Бірақ неліктен кәмпит алмалары туралы?
Dialogue: 0,0:06:30.72,0:06:32.68,Default,,0,0,0,,Сенің осылай аққаныңды көрсем ғой.
Dialogue: 0,0:06:32.76,0:06:34.76,Default,,0,0,0,,Жоқ! Сіз оны көрдіңіз бе?
Dialogue: 0,0:06:35.26,0:06:37.68,Default,,0,0,0,,Мен мұндай қызды бірінші рет көруім еді.
Dialogue: 0,0:06:37.77,0:06:40.23,Default,,0,0,0,,О, тоқтат!
Dialogue: 0,0:06:40.81,0:06:41.90,Default,,0,0,0,,Сол жерден
Dialogue: 0,0:06:41.98,0:06:44.94,Default,,0,0,0,,Хина маған зорлық көрсете бастады
Dialogue: 0,0:06:45.02,0:06:45.82,Default,,0,0,0,,Не!
Dialogue: 0,0:06:46.94,0:06:50.49,Default,,0,0,0,,Бірақ мен орта мектептің бірінші курсынан бастап үйірме жұмыстарына қатыса алмадым.
Dialogue: 0,0:06:50.99,0:06:52.82,Default,,0,0,0,,Бұл қызықты болды.
Dialogue: 0,0:06:55.87,0:06:56.83,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:57.37,0:06:58.83,Default,,0,0,0,,Ал, қайтайық.
Dialogue: 0,0:07:00.54,0:07:01.83,Default,,0,0,0,,Тағы барайық
Dialogue: 0,0:07:03.00,0:07:03.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:06.75,0:07:08.84,Default,,0,0,0,,Осы жылы бірге барайық.
Dialogue: 0,0:07:11.18,0:07:12.34,Default,,0,0,0,,Отшашуды көрсету
Dialogue: 0,0:07:16.76,0:07:18.77,Default,,0,0,0,,Отшашу фестиваліне барайық
Dialogue: 0,0:07:24.98,0:07:25.86,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:26.69,0:07:27.69,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:07:28.23,0:07:29.65,Default,,0,0,0,,Иноматалар
Dialogue: 0,0:07:30.15,0:07:31.40,Default,,0,0,0,,Телефон келді.
Dialogue: 0,0:07:31.49,0:07:33.28,Default,,0,0,0,,Бу-бу-шулы
Dialogue: 0,0:07:33.36,0:07:35.87,Default,,0,0,0,,О, рахмет, кешіріңіз.
Dialogue: 0,0:07:37.54,0:07:38.91,Default,,0,0,0,,Ал, келесі жолы мен егжей-тегжейлі түсіндіремін.
Dialogue: 0,0:07:39.95,0:07:40.91,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:42.12,0:07:43.92,Default,,0,0,0,,-Олай болса қайтеміз?-(Балапан) Иә.
Dialogue: 0,0:07:46.79,0:07:49.26,Default,,0,0,0,,Қараңдаршы, бұл отшашу.
Dialogue: 0,0:07:49.34,0:07:51.30,Default,,0,0,0,,Не істеу керек? Биыл барасың ба?
Dialogue: 0,0:07:51.38,0:07:51.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.88,0:07:56.39,Default,,0,0,0,,Кешіріңіз, мен басқа біреумен баруға уәде бердім.
Dialogue: 0,0:07:57.26,0:07:58.93,Default,,0,0,0,,Хаха~
Dialogue: 0,0:07:59.64,0:08:01.06,Default,,0,0,0,,Сіз кездесудесіз бе?
Dialogue: 0,0:08:01.14,0:08:02.39,Default,,0,0,0,,Уф... жоқ!
Dialogue: 0,0:08:02.48,0:08:05.94,Default,,0,0,0,,Отшашуды екі адаммен, ер мен әйелмен кездесу ретінде жасаңыз.
Dialogue: 0,0:08:06.02,0:08:08.11,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:08.19,0:08:10.40,Default,,0,0,0,,Арғы жағы жай ғана дос.
Dialogue: 0,0:08:12.49,0:08:13.95,Default,,0,0,0,,Сізге ұнайды деп үміттенемін
Dialogue: 0,0:08:16.99,0:08:18.20,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:19.66,0:08:21.29,Default,,0,0,0,,Сізді ертерек бөлгенім үшін кешіріңіз.
Dialogue: 0,0:08:21.37,0:08:23.00,Default,,0,0,0,,Әй, үлкен қуаныш деген не?
Dialogue: 0,0:08:23.08,0:08:24.04,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:08:28.54,0:08:31.96,Default,,0,0,0,,Чинацу-чанның Интер-Хайгіне 3 апта қалды ма?
Dialogue: 0,0:08:32.97,0:08:34.55,Default,,0,0,0,,Сіз қалай ойлайсыз? Қалыңыз қалай?
Dialogue: 0,0:08:35.05,0:08:35.97,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:08:36.68,0:08:39.26,Default,,0,0,0,,Бірдеңе керек болса маған хабарлаңыз.
Dialogue: 0,0:08:39.35,0:08:40.93,Default,,0,0,0,,Сіз неше түн қаласыз?
Dialogue: 0,0:08:41.43,0:08:43.35,Default,,0,0,0,,Жазсаңыз, сатып аламын.
Dialogue: 0,0:08:43.98,0:08:45.35,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:46.94,0:08:50.23,Default,,0,0,0,,Келесі демалыста отшашу фестивалі болады.
Dialogue: 0,0:08:50.73,0:08:52.03,Default,,0,0,0,,Чинацу-чан, барасың ба?
Dialogue: 0,0:08:52.11,0:08:53.78,Default,,0,0,0,,Келіңіздер, жылдам қарап шығайық
Dialogue: 0,0:08:53.86,0:08:55.11,Default,,0,0,0,,Юкатаны шығаруым керек пе?
Dialogue: 0,0:08:57.45,0:08:59.41,Default,,0,0,0,,Адамдар қашықтықты сезінеді
Dialogue: 0,0:08:59.49,0:09:01.37,Default,,0,0,0,,Мен үй тапсырмасының қалған бөлігін орындадым!
Dialogue: 0,0:09:01.95,0:09:04.00,Default,,0,0,0,,Бұл қандай қызықты тақырып?
Dialogue: 0,0:09:04.50,0:09:06.79,Default,,0,0,0,,Ескі, бірақ сүйкімді...
Dialogue: 0,0:09:06.87,0:09:08.50,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:09:08.58,0:09:09.75,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:10.96,0:09:12.51,Default,,0,0,0,,Daiki-мен не істеу керек?
Dialogue: 0,0:09:13.46,0:09:15.26,Default,,0,0,0,,Сіз биылғы отшашу фестиваліне барасыз ба?
Dialogue: 0,0:09:16.09,0:09:17.51,Default,,0,0,0,,Мен де барлығымен бірге барамын.
Dialogue: 0,0:09:18.01,0:09:19.60,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:09:20.35,0:09:23.02,Default,,0,0,0,,Ойланып қарашы, тағы кім барады?
Dialogue: 0,0:09:23.52,0:09:26.02,Default,,0,0,0,,Тадашимен сөйлессем жақсы болар еді.
Dialogue: 0,0:09:26.85,0:09:29.52,Default,,0,0,0,,Хинаның жетекші болуы сирек.
Dialogue: 0,0:09:30.06,0:09:31.32,Default,,0,0,0,,Олай болса, аналар
Dialogue: 0,0:09:31.40,0:09:33.90,Default,,0,0,0,,Йокой мырзаның үйіне барып, оны көруім керек пе?
Dialogue: 0,0:09:33.99,0:09:35.78,Default,,0,0,0,,Өте жақсы орын!
Dialogue: 0,0:09:35.86,0:09:37.78,Default,,0,0,0,,Алкоголь дайындаңыз
Dialogue: 0,0:09:37.86,0:09:39.03,Default,,0,0,0,,Ересек Зурии!
Dialogue: 0,0:09:39.12,0:09:40.49,Default,,0,0,0,,Өйткені сен ересексің!
Dialogue: 0,0:09:40.57,0:09:42.03,Default,,0,0,0,,Тіпті біз алкогольсіз сусындарды жақсы көреміз...
Dialogue: 0,0:09:52.50,0:09:53.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:57.13,0:09:59.30,Default,,0,0,0,,Бұл жақсы тәжірибе болды.
Dialogue: 0,0:09:59.80,0:10:01.05,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:10:01.14,0:10:04.06,Default,,0,0,0,,Харю-сенпай қайтадан жақсарып келеді.
Dialogue: 0,0:10:04.77,0:10:08.64,Default,,0,0,0,,Осылай жалғастыра берсек, қуып жетудің орнына, алшақтық одан әрі кеңейеді.
Dialogue: 0,0:10:08.73,0:10:09.65,Default,,0,0,0,,Үлкен қуаныш
Dialogue: 0,0:10:09.73,0:10:12.98,Default,,0,0,0,,Бұл не? Жеңілгендерді шақыру үшін бе?
Dialogue: 0,0:10:13.07,0:10:15.11,Default,,0,0,0,,Иә, ұрыспаңыз.
Dialogue: 0,0:10:15.19,0:10:16.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:16.99,0:10:20.07,Default,,0,0,0,,31 Менің жоғары сыныптың университет тәжірибесінде
Dialogue: 0,0:10:20.16,0:10:22.70,Default,,0,0,0,,Маған қатысуды сұрады.
Dialogue: 0,0:10:23.20,0:10:24.08,Default,,0,0,0,,Дайки де келе ме?
Dialogue: 0,0:10:24.74,0:10:26.08,Default,,0,0,0,,Университет?
Dialogue: 0,0:10:26.66,0:10:29.33,Default,,0,0,0,,Менің ойымша, бұл қиын, өйткені деңгей өте жоғары.
Dialogue: 0,0:10:29.92,0:10:30.88,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:10:35.21,0:10:35.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:43.85,0:10:44.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:44.76,0:10:46.60,Default,,0,0,0,,Не, өзің күліп тұрсың ба?
Dialogue: 0,0:10:46.68,0:10:49.94,Default,,0,0,0,,Балапандар! Оны әдеттегідей айт!
Dialogue: 0,0:10:50.02,0:10:52.61,Default,,0,0,0,,Мен сенің күлімдеген жүзіңді айнадан көрдім.
Dialogue: 0,0:10:52.69,0:10:55.48,Default,,0,0,0,,Қуанып, күліп тұрсың.
Dialogue: 0,0:10:55.57,0:10:56.78,Default,,0,0,0,,Сіз алданғансыз ба?
Dialogue: 0,0:10:56.86,0:10:58.03,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:58.53,0:10:59.70,Default,,0,0,0,,Мен сені жібермеймін
Dialogue: 0,0:10:59.78,0:11:03.45,Default,,0,0,0,,Мені университет студенттерімен тәжірибеге шақырды, сондықтан мен оны асыға күтемін.
Dialogue: 0,0:11:03.53,0:11:04.37,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:05.37,0:11:07.91,Default,,0,0,0,,Барлығының Интерхайғы да жақындап қалды.
Dialogue: 0,0:11:08.00,0:11:10.12,Default,,0,0,0,,Осындай мүмкіндіктерді бағалай білу керек.
Dialogue: 0,0:11:10.79,0:11:15.09,Default,,0,0,0,,Бұл жаттығуға арналған отшашу күні, бірақ мен уақытында сонда боламын.
Dialogue: 0,0:11:15.17,0:11:18.63,Default,,0,0,0,,Жарайды, бәрібір жаттығуым бар.
Dialogue: 0,0:11:19.97,0:11:21.13,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:11:22.05,0:11:26.35,Default,,0,0,0,,Азық-түлік дүңгіршектеріндегі Якисоба дәмді, бәрі оттың күші туралы.
Dialogue: 0,0:11:26.43,0:11:28.14,Default,,0,0,0,,Гүлдердің үстіндегі Данго?
Dialogue: 0,0:11:28.64,0:11:31.64,Default,,0,0,0,,Ойланып қарашы, отшашу фестиваліне тағы кім келеді?
Dialogue: 0,0:11:31.73,0:11:32.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:33.27,0:11:34.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:34.73,0:11:35.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:35.73,0:11:40.78,Default,,0,0,0,,А... Мен оны шақыруды мүлдем ұмытып кетіппін. Эххех
Dialogue: 0,0:11:40.86,0:11:41.74,Default,,0,0,0,,Эй
Dialogue: 0,0:11:41.82,0:11:44.16,Default,,0,0,0,,Дайки Тадаши, мені шақырыңыз.
Dialogue: 0,0:11:44.24,0:11:46.58,Default,,0,0,0,,Мен де бірдеңе айтайын.
Dialogue: 0,0:11:46.66,0:11:48.16,Default,,0,0,0,,Мен оны сұрадым!
Dialogue: 0,0:11:50.50,0:11:52.16,Default,,0,0,0,,Не? Әзірге
Dialogue: 0,0:11:59.63,0:12:01.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:04.26,0:12:06.76,Default,,0,0,0,,Мен сізді жақсы шақыра алмадым.
Dialogue: 0,0:12:07.97,0:12:09.18,Default,,0,0,0,,Отшашуды көрсету?
Dialogue: 0,0:12:09.27,0:12:10.89,Default,,0,0,0,,Баруға болады, бірақ
Dialogue: 0,0:12:11.39,0:12:14.31,Default,,0,0,0,,Олай болса, кеттік. Сағат 6-да кездесеміз.
Dialogue: 0,0:12:14.40,0:12:18.86,Default,,0,0,0,,Бірақ мен сол күні Харью-сенпаймен университеттің практикалық сабағына баратыныма өте қуаныштымын...
Dialogue: 0,0:12:18.94,0:12:21.19,Default,,0,0,0,,Жарайды, өйткені сіз уақытында келесіз
Dialogue: 0,0:12:21.78,0:12:24.99,Default,,0,0,0,,Бір күнде екі үлкен жоспарды қою
Dialogue: 0,0:12:25.07,0:12:26.53,Default,,0,0,0,,Белсенді жігіт
Dialogue: 0,0:12:26.62,0:12:27.99,Default,,0,0,0,,Бұл жай ғана кездейсоқтық
Dialogue: 0,0:12:28.08,0:12:29.45,Default,,0,0,0,,Мен екеуіне де барғым келеді.
Dialogue: 0,0:12:30.41,0:12:32.87,Default,,0,0,0,,Отшашуға тағы кім келеді?
Dialogue: 0,0:12:33.37,0:12:34.21,Default,,0,0,0,,Балапандар т.б.
Dialogue: 0,0:12:35.29,0:12:37.21,Default,,0,0,0,,Оны бірінші болып Хина айтты.
Dialogue: 0,0:12:37.29,0:12:39.88,Default,,0,0,0,,Мен мүшелерді жинауды ұмытып кеткен сияқтымын.
Dialogue: 0,0:12:39.96,0:12:42.30,Default,,0,0,0,,Маған Тадашиді шақыруды өтінді.
Dialogue: 0,0:12:42.80,0:12:46.22,Default,,0,0,0,,Чоно-сан екеуімен бірге барғысы келді.
Dialogue: 0,0:12:46.84,0:12:48.72,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:12:48.80,0:12:53.18,Default,,0,0,0,,Тіпті оларды отшашуға шақырудың өзі үлкен жетістік болар еді.
Dialogue: 0,0:12:54.19,0:12:57.10,Default,,0,0,0,,Егер сіз соншалықты алысқа барсаңыз, оны анық айтуыңыз керек еді.
Dialogue: 0,0:12:57.77,0:12:59.69,Default,,0,0,0,,Шынымен ебедейсіз
Dialogue: 0,0:13:00.69,0:13:05.11,Default,,0,0,0,,Е! Сіз жергілікті қызбен отшашу фестиваліне баруға уәде бердіңіз бе?
Dialogue: 0,0:13:05.20,0:13:08.12,Default,,0,0,0,,Балапандар басқалармен бірге бірінші барады.
Dialogue: 0,0:13:08.20,0:13:09.66,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:13:09.74,0:13:13.45,Default,,0,0,0,,Менімен бара алмағаныңызға өкініп, біраз уақыт бөліңіз...
Dialogue: 0,0:13:13.54,0:13:14.37,Default,,0,0,0,,Мазасыздық
Dialogue: 0,0:13:15.41,0:13:19.67,Default,,0,0,0,,Уәде берген адамға не болды? Жарайды алдыңыз ба?
Dialogue: 0,0:13:20.17,0:13:21.38,Default,,0,0,0,,Мен сенімен барамын.
Dialogue: 0,0:13:22.00,0:13:24.76,Default,,0,0,0,,Бірақ олар бәрі бірге деп ойлаған сияқты.
Dialogue: 0,0:13:25.26,0:13:28.39,Default,,0,0,0,,Мен сені тағы шақырсам ше? Олар екі адам жақсы дейді.
Dialogue: 0,0:13:29.47,0:13:30.39,Default,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,0:13:31.26,0:13:35.14,Default,,0,0,0,,Мен сені менімен бірге жүр десем, бар күшімді сарп еттім.
Dialogue: 0,0:13:35.23,0:13:39.23,Default,,0,0,0,,Бас тартсаң, бәрі бұзылады.
Dialogue: 0,0:13:40.61,0:13:41.48,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:42.61,0:13:44.94,Default,,0,0,0,,Өйткені біз жақсы дос болуда нашармыз.
Dialogue: 0,0:13:45.03,0:13:45.99,Default,,0,0,0,,«Бірдеңе»?
Dialogue: 0,0:13:46.07,0:13:49.57,Default,,0,0,0,,Сонымен, сіз ең жақын досыңыз ретінде кім туралы айтып отырсыз?
Dialogue: 0,0:13:49.66,0:13:52.03,Default,,0,0,0,,Мен оны жасыруға тырыстым.
Dialogue: 0,0:13:54.16,0:13:56.00,Default,,0,0,0,,Бұл отшашу.
Dialogue: 0,0:13:56.50,0:13:57.37,Default,,0,0,0,,Иә
Dialogue: 0,0:13:57.46,0:14:01.04,Default,,0,0,0,,Әзірге Марико, Санато және Акари келеді.
Dialogue: 0,0:14:01.13,0:14:02.25,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:14:04.09,0:14:06.34,Default,,0,0,0,,Не істеу керек? Жігіттерді де шақырасыз ба?
Dialogue: 0,0:14:06.92,0:14:10.84,Default,,0,0,0,,Мүмкін романтикалық сезімдер пайда болады.
Dialogue: 0,0:14:11.39,0:14:13.22,Default,,0,0,0,,Шатасып қалғанда қалқан ретінде де қызмет ете алады.
Dialogue: 0,0:14:14.14,0:14:15.60,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:15.68,0:14:17.60,Default,,0,0,0,,Тек қыз болған дұрыс емес пе?
Dialogue: 0,0:14:18.60,0:14:21.48,Default,,0,0,0,,Адамдар көп болса, орын табу қиын болады.
Dialogue: 0,0:14:21.98,0:14:24.69,Default,,0,0,0,,Әрине, онда тек қыздар ше?
Dialogue: 0,0:14:24.78,0:14:26.49,Default,,0,0,0,,Ал қазір
Dialogue: 0,0:14:26.57,0:14:29.28,Default,,0,0,0,,Менің ойымша, бұл дұрыс.
Dialogue: 0,0:14:34.70,0:14:35.58,Default,,0,0,0,,Үлкен қуаныш
Dialogue: 0,0:14:36.16,0:14:37.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:38.04,0:14:39.50,Default,,0,0,0,,Сен қауырсын алуға келдің бе?
Dialogue: 0,0:14:40.00,0:14:41.79,Default,,0,0,0,,Ол тез тозады
Dialogue: 0,0:14:41.88,0:14:44.96,Default,,0,0,0,,Жазғы каникулда жаттығу ұзақ.
Dialogue: 0,0:14:45.67,0:14:47.42,Default,,0,0,0,,Жарақат алудан сақ болыңыз.
Dialogue: 0,0:14:47.92,0:14:49.72,Default,,0,0,0,,Жоғары аралық Себебі жақын
Dialogue: 0,0:14:49.80,0:14:51.05,Default,,0,0,0,,Иә
Dialogue: 0,0:14:51.55,0:14:55.22,Default,,0,0,0,,Енді отшашу деп аталатын сыйлық бар.
Dialogue: 0,0:14:56.10,0:14:57.89,Default,,0,0,0,,Айтпақшы, Тадаши де бара алады.
Dialogue: 0,0:14:57.98,0:15:00.02,Default,,0,0,0,,Шынымен бе? Жақсы
Dialogue: 0,0:15:00.10,0:15:02.73,Default,,0,0,0,,Балапандар ше? Кім ұсталды?
Dialogue: 0,0:15:03.36,0:15:05.73,Default,,0,0,0,,Әр адамның достары көп...
Dialogue: 0,0:15:05.82,0:15:09.24,Default,,0,0,0,,Хаха, бұл таныс мүше ғой.
Dialogue: 0,0:15:12.62,0:15:14.70,Default,,0,0,0,,Сәлем, Даики Хаса
Dialogue: 0,0:15:15.20,0:15:17.49,Default,,0,0,0,,Шынацу-сенпаймен бірге барғың келді ме?
Dialogue: 0,0:15:21.42,0:15:22.33,Default,,0,0,0,,Мен бара алмаймын.
Dialogue: 0,0:15:23.33,0:15:26.30,Default,,0,0,0,,Біріншіден, адамдар көп болатын отшашуға барыңыз.
Dialogue: 0,0:15:26.38,0:15:28.71,Default,,0,0,0,,Біреу көрсе жаман болар еді, солай ма?
Dialogue: 0,0:15:28.80,0:15:32.47,Default,,0,0,0,,Мен сізді шақырсам да, сізді 100% қабылдамаған болар еді.
Dialogue: 0,0:15:32.55,0:15:36.31,Default,,0,0,0,,Жақын болу жақсы емес деді ме?
Dialogue: 0,0:15:36.85,0:15:39.60,Default,,0,0,0,,Жаман нәрселерді еске түсіреді.
Dialogue: 0,0:15:40.73,0:15:44.73,Default,,0,0,0,,Менің ойымша, соңғы бірнеше айда мен үлкендермен жақсы достар таптым.
Dialogue: 0,0:15:45.23,0:15:47.52,Default,,0,0,0,,Мен саған жақындағым келді.
Dialogue: 0,0:15:48.78,0:15:51.78,Default,,0,0,0,,Бірақ мен ғана солай ойладым.
Dialogue: 0,0:15:53.03,0:15:55.78,Default,,0,0,0,,Чинацу-сенпайға қиындық туғызу үшін мен қанша жүруім керек?
Dialogue: 0,0:15:55.87,0:15:56.87,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:57.37,0:16:01.54,Default,,0,0,0,,Бір қателік жасасаң, Чинацу-сенпай сені жек көреді.
Dialogue: 0,0:16:02.12,0:16:06.29,Default,,0,0,0,,Қайта толқыған жалғыз мен сияқты сезіну қорқынышты
Dialogue: 0,0:16:08.63,0:16:14.39,Default,,0,0,0,,Оның үстіне жақындаған сайын қорқыныш күшейе түседі.
Dialogue: 0,0:16:17.47,0:16:18.72,Default,,0,0,0,,Сол жерден кетеміз бе?
Dialogue: 0,0:16:19.22,0:16:19.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.39,0:16:21.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:26.06,0:16:26.81,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:26.90,0:16:28.57,Default,,0,0,0,,Міне!
Dialogue: 0,0:16:28.65,0:16:31.03,Default,,0,0,0,,Соңында, толық ауқымды зорлық-зомбылық ...
Dialogue: 0,0:16:31.11,0:16:32.57,Default,,0,0,0,,Үлкен қуаныш емес сияқты
Dialogue: 0,0:16:33.40,0:16:35.82,Default,,0,0,0,,Сізге ұнайтын адамға қиындық тудырғыңыз келмейді.
Dialogue: 0,0:16:36.41,0:16:38.91,Default,,0,0,0,,Сіз басқа адаммен қарым-қатынасты бұзғыңыз келмейді.
Dialogue: 0,0:16:38.99,0:16:43.16,Default,,0,0,0,,Мен түсінемін, мұндай нәрселер туралы ойлау және оларға әрекет ету қорқынышты.
Dialogue: 0,0:16:43.66,0:16:48.67,Default,,0,0,0,,Қорықсаңыз да, басқаларды қалай ойласаңыз, өзіңізге де қамқор болыңыз.
Dialogue: 0,0:16:49.17,0:16:52.38,Default,,0,0,0,,Мен позитивті бола алатыныма өте қуаныштымын...
Dialogue: 0,0:16:54.13,0:16:55.84,Default,,0,0,0,,Немесе… немесе…
Dialogue: 0,0:16:56.59,0:16:58.93,Default,,0,0,0,,Бұл керемет жер.
Dialogue: 0,0:17:00.81,0:17:03.35,Default,,0,0,0,,Жасырыну немесе қашу - ақсақ!
Dialogue: 0,0:17:03.43,0:17:04.48,Default,,0,0,0,,Ба-ка!
Dialogue: 0,0:17:04.56,0:17:05.85,Default,,0,0,0,,Алға!
Dialogue: 0,0:17:09.73,0:17:11.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:12.11,0:17:14.95,Default,,0,0,0,,Мен мұндай бетті бірінші рет көруім.
Dialogue: 0,0:17:19.03,0:17:20.45,Default,,0,0,0,,Daiki осында
Dialogue: 0,0:17:25.04,0:17:25.96,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:26.96,0:17:27.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:29.54,0:17:31.13,Default,,0,0,0,,Хиодо мырза?
Dialogue: 0,0:17:31.88,0:17:33.17,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:17:33.67,0:17:38.55,Default,,0,0,0,,Ол келесі жылы осы университетке барады, сондықтан ол анда-санда практикаға қатысатын сияқты.
Dialogue: 0,0:17:38.64,0:17:39.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:49.56,0:17:52.44,Default,,0,0,0,,Хаа... қатты...
Dialogue: 0,0:17:52.52,0:17:54.49,Default,,0,0,0,,Әдеттегі тәжірибеден басқа деңгей
Dialogue: 0,0:17:55.57,0:17:58.36,Default,,0,0,0,,Тіпті Харю-сенпай мұңайып көрінеді.
Dialogue: 0,0:17:59.78,0:18:01.58,Default,,0,0,0,,Иә? Сен ондасың ба?
Dialogue: 0,0:18:01.66,0:18:02.83,Default,,0,0,0,,Маған солай қарашы
Dialogue: 0,0:18:03.33,0:18:04.75,Default,,0,0,0,,Мен аузымды қойдым, бірақ...
Dialogue: 0,0:18:04.83,0:18:05.83,Default,,0,0,0,,Жоқ, жақсы!
Dialogue: 0,0:18:06.41,0:18:07.33,Default,,0,0,0,,№.
Dialogue: 0,0:18:07.41,0:18:08.92,Default,,0,0,0,,Таңқаларлық мейірімді ме?
Dialogue: 0,0:18:09.00,0:18:12.00,Default,,0,0,0,,Сен, қолың жетпесе, шыдайтын әдетің бар.
Dialogue: 0,0:18:12.59,0:18:13.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:13.71,0:18:17.05,Default,,0,0,0,,Мен соқтырмас бұрын оң жақ шынтағымды тарттым.
Dialogue: 0,0:18:17.97,0:18:20.39,Default,,0,0,0,,Тек соққы кезінде көбірек демалыңыз
Dialogue: 0,0:18:20.89,0:18:22.14,Default,,0,0,0,,- (қуанып) Осылай ма? -(Хёудоу) Дұрыс.
Dialogue: 0,0:18:22.64,0:18:26.10,Default,,0,0,0,,Білектер: жұмсақ болыңыз және күшке емес, бұрышқа назар аударыңыз.
Dialogue: 0,0:18:27.48,0:18:29.27,Default,,0,0,0,,Сіз қауырсынды көтере аласыз ба?
Dialogue: 0,0:18:29.81,0:18:31.02,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:36.57,0:18:37.99,Default,,0,0,0,,Өте жақсы екен!
Dialogue: 0,0:18:38.49,0:18:39.78,Default,,0,0,0,,Керемет кадр
Dialogue: 0,0:18:41.32,0:18:44.79,Default,,0,0,0,,Егер мен допты қазіргідей соға алсам, Юсадан көбірек ұпай алуым мүмкін еді.
Dialogue: 0,0:18:45.37,0:18:46.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:48.37,0:18:51.79,Default,,0,0,0,,Менде жұпта жақсы соққылар болды.
Dialogue: 0,0:18:51.88,0:18:54.46,Default,,0,0,0,,Жалғыздықтағы қозғалыстар қатаң.
Dialogue: 0,0:18:54.55,0:18:56.46,Default,,0,0,0,,Айналаңдап, тек қорғаныста болу
Dialogue: 0,0:18:56.55,0:18:58.17,Default,,0,0,0,,Бұл өкінішті болды.
Dialogue: 0,0:18:58.92,0:19:02.30,Default,,0,0,0,,Осылай жалғастыра берсем, келесі жылы өтетін Интер орта мектебіне 2 орын аламын.
Dialogue: 0,0:19:03.60,0:19:06.81,Default,,0,0,0,,Менің ойымша, бұл Харю мен Юса болуды шешті, сіз қалай ойлайсыз?
Dialogue: 0,0:19:08.02,0:19:10.02,Default,,0,0,0,,Мен мұны не үшін сұраймын?
Dialogue: 0,0:19:12.40,0:19:13.69,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:19:14.57,0:19:16.69,Default,,0,0,0,,Және оны түсіну оңайырақ
Dialogue: 0,0:19:17.86,0:19:20.78,Default,,0,0,0,,Менің тәжірибелік әріптесім ретінде әрқашан Харю-сенпай бар.
Dialogue: 0,0:19:20.86,0:19:22.45,Default,,0,0,0,,Мақсаттың болуы
Dialogue: 0,0:19:23.37,0:19:26.33,Default,,0,0,0,,Өткен күні мен Юсамен көңілсіз жағдайға тап болдым.
Dialogue: 0,0:19:26.41,0:19:28.33,Default,,0,0,0,,Себебі мен кек алғым келді
Dialogue: 0,0:19:29.25,0:19:31.67,Default,,0,0,0,,Қай жерді көздеу керектігін нақты білген дұрыс.
Dialogue: 0,0:19:31.75,0:19:33.33,Default,,0,0,0,,Жақсы және түсінуге оңай
Dialogue: 0,0:19:33.88,0:19:36.34,Default,,0,0,0,,Дәл қазір мен екеуіңе мүлдем тең келе алмаймын.
Dialogue: 0,0:19:38.21,0:19:40.09,Default,,0,0,0,,Мен біреудің артынан қуған кезде көп жұмыс істейтін адаммын.
Dialogue: 0,0:19:44.43,0:19:46.85,Default,,0,0,0,,Кенеттен соққы жасамаңыз
Dialogue: 0,0:19:46.93,0:19:48.06,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:19:48.14,0:19:49.35,Default,,0,0,0,,Мен оны келесіде жүктеймін!
Dialogue: 0,0:19:49.43,0:19:52.94,Default,,0,0,0,,Дегенмен, бұл өте қиын деп ойлаймын.
Dialogue: 0,0:19:53.48,0:19:54.56,Default,,0,0,0,,Қуғандар
Dialogue: 0,0:19:54.65,0:19:57.36,Default,,0,0,0,,Мен озып келемін, өйткені мен ерінбей еңбек етуді білемін.
Dialogue: 0,0:19:57.94,0:19:59.36,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:20:00.65,0:20:04.66,Default,,0,0,0,,Маған алыстан соққан доп жеңісті ұрлайтын даму ұнайды.
Dialogue: 0,0:20:07.45,0:20:09.87,Default,,0,0,0,,Уау... у...
Dialogue: 0,0:20:12.00,0:20:13.83,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:20:13.92,0:20:15.42,Default,,0,0,0,,Біздің қолжазбалар бөлімінің қызметкерлері
Dialogue: 0,0:20:16.13,0:20:17.25,Default,,0,0,0,,Хиодо мырза ше?
Dialogue: 0,0:20:17.34,0:20:18.63,Default,,0,0,0,,Мен қазірдің өзінде үйдемін
Dialogue: 0,0:20:20.26,0:20:22.84,Default,,0,0,0,,Келесіде Интер-Хайда кездесеміз бе?
Dialogue: 0,0:20:24.30,0:20:26.47,Default,,0,0,0,,Үлкен қуаныш Енді не істейсіз?
Dialogue: 0,0:20:26.55,0:20:29.14,Default,,0,0,0,,Сағат 6-да Тадаши және оның достарымен кездесу.
Dialogue: 0,0:20:29.89,0:20:30.72,Default,,0,0,0,,А…?
Dialogue: 0,0:20:32.23,0:20:33.39,Default,,0,0,0,,Қызба?
Dialogue: 0,0:20:33.48,0:20:34.65,Default,,0,0,0,,Нича
Dialogue: 0,0:20:34.73,0:20:35.90,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:20:41.24,0:20:42.24,Default,,0,0,0,,А...
Dialogue: 0,0:20:43.24,0:20:45.16,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:20:46.74,0:20:51.70,Default,,0,0,0,,Сабыр ет, сабыр ет, екеуің үйге бірге бардыңдар.
Dialogue: 0,0:20:51.79,0:20:52.66,Default,,0,0,0,,А…?
Dialogue: 0,0:20:59.00,0:21:00.92,Default,,0,0,0,,Ғажайып адамдар
Dialogue: 0,0:21:01.96,0:21:04.38,Default,,0,0,0,,Балапандарға қосыла аламын ба?
Dialogue: 0,0:21:05.51,0:21:06.34,Default,,0,0,0,,А…?
Dialogue: 0,0:21:08.47,0:21:09.93,Default,,0,0,0,,Гудагуда?
Dialogue: 0,0:21:10.81,0:21:13.18,Default,,0,0,0,,Хина оның да жаттығуы барын айтты.
Dialogue: 0,0:21:15.60,0:21:16.27,Default,,0,0,0,,Ах
Dialogue: 0,0:21:19.19,0:21:20.94,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:21:22.23,0:21:23.44,Default,,0,0,0,,Хаа…
Dialogue: 0,0:21:24.03,0:21:25.45,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:21:26.24,0:21:29.24,Default,,0,0,0,,Біз бірдей нәрсеге ұмтылсақ та, бұл жай ғана бір жақты көше емес.
Dialogue: 0,0:21:29.32,0:21:31.70,Default,,0,0,0,,Махаббат Будқа қарағанда қиын.
Dialogue: 0,0:21:33.20,0:21:36.21,Default,,0,0,0,,Айтпақшы, маған Хина ұнады.
Dialogue: 0,0:21:38.00,0:21:39.21,Default,,0,0,0,,Мен оны сатып алуым керек пе?
Dialogue: 0,0:21:39.79,0:21:42.09,Default,,0,0,0,,Майдо Рахмет
Dialogue: 0,0:21:42.75,0:21:44.72,Default,,0,0,0,,Маған бересің бе?
Dialogue: 0,0:21:45.30,0:21:47.80,Default,,0,0,0,,Мен дұрыс төлеймін... Ах.
Dialogue: 0,0:21:54.35,0:21:55.31,Default,,0,0,0,,Не?
Dialogue: 0,0:21:56.69,0:21:57.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:58.77,0:21:59.73,Default,,0,0,0,,Ал...
Dialogue: 0,0:22:01.11,0:22:02.65,Default,,0,0,0,,300 иен
Dialogue: 0,0:22:03.82,0:22:04.65,Default,,0,0,0,,Иә
Dialogue: 0,0:22:06.32,0:22:08.32,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.41,0:23:35.41,Default,,0,0,0,,~♪
Dialogue: 0,0:23:36.91,0:23:42.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory