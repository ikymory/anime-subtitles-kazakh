Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.67,0:00:09.94,Default,,0000,0000,0000,,Тайки
Dialogue: 0,0:00:02.67,0:00:09.94,Default,,0000,0000,0000,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:00:12.18,0:00:14.15,Default,,0000,0000,0000,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:00:15.25,0:00:17.22,Default,,0000,0000,0000,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:00:21.52,0:00:23.99,Default,,0000,0000,0000,,<Мен үшін күнде таңертең>
Dialogue: 0,0:00:25.86,0:00:28.33,Default,,0000,0000,0000,,<Бірінші кездескім келетін адам бар>
Dialogue: 0,0:00:30.53,0:00:35.60,Default,,0000,0000,0000,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:00:35.60,0:00:37.57,Default,,0000,0000,0000,,<Мен танысқым келетін адам>
Dialogue: 0,0:00:40.21,0:00:42.28,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:00:44.54,0:00:47.05,Default,,0000,0000,0000,,Жарайды! ?
Dialogue: 0,0:00:47.05,0:00:49.55,Default,,0000,0000,0000,,Менде бәрі жақсы
Dialogue: 0,0:00:47.05,0:00:49.55,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:00:49.55,0:00:51.82,Default,,0000,0000,0000,,Шынтақпен пас беруге жаттықтыру
Dialogue: 0,0:00:53.05,0:00:55.02,Default,,0000,0000,0000,,Маған көрсет
Dialogue: 0,0:00:56.06,0:00:58.56,Default,,0000,0000,0000,,Ол қызылға айналады
Dialogue: 0,0:00:58.56,0:01:01.16,Default,,0000,0000,0000,,Ауырған шығар, иә?
Dialogue: 0,0:01:01.16,0:01:03.50,Default,,0000,0000,0000,,Бұл өте жақсы!
Dialogue: 0,0:01:03.50,0:01:06.67,Default,,0000,0000,0000,,Бірақ... иә
Dialogue: 0,0:01:07.57,0:01:09.54,Default,,0000,0000,0000,,Қарсы неге? Бүгін таңертең сен жақсылап көмектесіп жүрдің ғой, иә?
Dialogue: 0,0:01:12.01,0:01:14.47,Default,,0000,0000,0000,,<Қалтадан тәттілер>
Dialogue: 0,0:01:15.68,0:01:20.01,Default,,0000,0000,0000,,Өтінемін, мені кешіріңіз.
Dialogue: 0,0:01:20.01,0:01:24.18,Default,,0000,0000,0000,,<Ха! Мен сені кешіремін! ＞
Dialogue: 0,0:01:26.52,0:01:29.19,Default,,0000,0000,0000,,<Менің Эймей кіші және жоғары мектебім>
Dialogue: 0,0:01:29.19,0:01:32.16,Default,,0000,0000,0000,,<Орта және жоғары сыныптардың спорт түрлерінен мықты мектепте>
Dialogue: 0,0:01:33.19,0:01:36.03,Default,,0000,0000,0000,,<Кіші орта мектептегі үйірме жұмыстарынан зейнетке шыққаннан кейін>
Dialogue: 0,0:01:36.03,0:01:39.70,Default,,0000,0000,0000,,<Орта мектептің бас үйірмесі тәжірибесіне арналған
Dialogue: 0,0:01:36.03,0:01:39.70,Default,,0000,0000,0000,,Мен қатысамын＞
Dialogue: 0,0:01:40.87,0:01:44.37,Default,,0000,0000,0000,,<олардың ішінде
Dialogue: 0,0:01:40.87,0:01:44.37,Default,,0000,0000,0000,,Таңертең мен өз бетіммен жаттықтым＞
Dialogue: 0,0:01:44.37,0:01:48.71,Default,,0000,0000,0000,,<Бәрінен ертерек келейік.
Dialogue: 0,0:01:44.37,0:01:48.71,Default,,0000,0000,0000,,Мен ойлаймын>
Dialogue: 0,0:01:48.71,0:01:52.78,Default,,0000,0000,0000,,<Әрқашан бірінші болатын адам
Dialogue: 0,0:01:48.71,0:01:52.78,Default,,0000,0000,0000,,Бұл әйел автобусындағы Чинацу-сенпай болды＞
Dialogue: 0,0:01:54.71,0:01:57.55,Default,,0000,0000,0000,,<Ауа әлі салқын спорт залында>
Dialogue: 0,0:01:57.55,0:02:00.02,Default,,0000,0000,0000,,＜Бір ойлы
Dialogue: 0,0:01:57.55,0:02:00.02,Default,,0000,0000,0000,,Атуға жаттығу＞
Dialogue: 0,0:02:01.15,0:02:04.22,Default,,0000,0000,0000,,<Чинацу-сенпай туралы>
Dialogue: 0,0:02:04.22,0:02:06.19,Default,,0000,0000,0000,,<Маған ұнайды>
Dialogue: 0,0:02:12.00,0:02:21.47,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:05.35,0:04:07.31,Default,,0000,0000,0000,,⚟Жүгір!
Dialogue: 0,0:04:16.29,0:04:19.63,Default,,0000,0000,0000,,Аа, үйленсек екен.
Dialogue: 0,0:04:19.63,0:04:22.30,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,0:04:19.63,0:04:22.30,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:04:19.63,0:04:22.30,Default,,0000,0000,0000,,Боу, суық!
Dialogue: 0,0:04:22.30,0:04:24.80,Default,,0000,0000,0000,,Кенет үйленді ме?
Dialogue: 0,0:04:24.80,0:04:28.87,Default,,0000,0000,0000,,Себебі мен таңертең тұрған бойда
Dialogue: 0,0:04:24.80,0:04:28.87,Default,,0000,0000,0000,,Ағаның бетін көруге болады.
Dialogue: 0,0:04:28.87,0:04:31.47,Default,,0000,0000,0000,,Бұл керемет
Dialogue: 0,0:04:31.47,0:04:34.14,Default,,0000,0000,0000,,Ең алдымен танысу мүмкін емес.
Dialogue: 0,0:04:35.54,0:04:39.55,Default,,0000,0000,0000,,Чинацу-сенпай
Dialogue: 0,0:04:35.54,0:04:39.55,Default,,0000,0000,0000,,Баскетбол клубының келесі Эйсі➡
Dialogue: 0,0:04:39.55,0:04:44.15,Default,,0000,0000,0000,,Тек қабілеттілік емес
Dialogue: 0,0:04:39.55,0:04:44.15,Default,,0000,0000,0000,,Тұлға да, жұлдыздық сапа да➡
Dialogue: 0,0:04:44.15,0:04:47.49,Default,,0000,0000,0000,,Мектеп ішінде немесе сыртында
Dialogue: 0,0:04:44.15,0:04:47.49,Default,,0000,0000,0000,,Ол танымал адам.
Dialogue: 0,0:04:47.49,0:04:52.33,Default,,0000,0000,0000,,Екінші жағынан, сіз
Dialogue: 0,0:04:47.49,0:04:52.33,Default,,0000,0000,0000,,Будтың бағалары өте жақсы.
Dialogue: 0,0:04:52.33,0:04:54.83,Default,,0000,0000,0000,,Танымалдығы туралы сөз жоқ
Dialogue: 0,0:04:54.83,0:04:57.33,Default,,0000,0000,0000,,Орта мектеп тәжірибесіне арналған
Dialogue: 0,0:04:54.83,0:04:57.33,Default,,0000,0000,0000,,Мен қатысамын.
Dialogue: 0,0:04:57.33,0:04:59.50,Default,,0000,0000,0000,,Астыңғы жағы
Dialogue: 0,0:05:01.77,0:05:05.84,Default,,0000,0000,0000,,Мысалы,
Dialogue: 0,0:05:01.77,0:05:05.84,Default,,0000,0000,0000,,Чинацу-сенпай Тұқым мектебінде➡
Dialogue: 0,0:05:05.84,0:05:08.78,Default,,0000,0000,0000,,Сіз бірінші раундта жеңілдіңіз➡
Dialogue: 0,0:05:08.78,0:05:11.61,Default,,0000,0000,0000,,Деңгейлер тым әртүрлі.
Dialogue: 0,0:05:11.61,0:05:16.28,Default,,0000,0000,0000,,Таңертеңгілік жаттығуда сөйлесу ғана...
Dialogue: 0,0:05:11.61,0:05:16.28,Default,,0000,0000,0000,,Байланыс нүктесі бар!
Dialogue: 0,0:05:16.28,0:05:20.12,Default,,0000,0000,0000,,Менің анам
Dialogue: 0,0:05:16.28,0:05:20.12,Default,,0000,0000,0000,,Менің баскетбол клубым OG
Dialogue: 0,0:05:20.12,0:05:23.62,Default,,0000,0000,0000,,Көптеген жекеменшік мектептер бар.
Dialogue: 0,0:05:20.12,0:05:23.62,Default,,0000,0000,0000,,Сіздің ата-анаңыздың оқу орны қандай?
Dialogue: 0,0:05:23.62,0:05:26.09,Default,,0000,0000,0000,,Мен Тадаши не айтып тұрғанын түсіндім.
Dialogue: 0,0:05:27.63,0:05:31.63,Default,,0000,0000,0000,,Байқау керек
Dialogue: 0,0:05:27.63,0:05:31.63,Default,,0000,0000,0000,,Сіз ешқашан жеңе алмайсыз
Dialogue: 0,0:05:31.63,0:05:36.14,Default,,0000,0000,0000,,Күшті мектептермен күрес
Dialogue: 0,0:05:31.63,0:05:36.14,Default,,0000,0000,0000,,Бұл қызық.
Dialogue: 0,0:05:36.14,0:05:40.64,Default,,0000,0000,0000,,Сонда кем дегенде
Dialogue: 0,0:05:36.14,0:05:40.64,Default,,0000,0000,0000,,Екінші турға өтуді мақсат ету.
Dialogue: 0,0:05:40.64,0:05:45.71,Default,,0000,0000,0000,,Сіздің есіміңіз есіңізде ме?
Dialogue: 0,0:05:40.64,0:05:45.71,Default,,0000,0000,0000,,Байланыс ақпараты және т.б.
Dialogue: 0,0:05:45.71,0:05:48.58,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:05:45.71,0:05:48.58,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:05:45.71,0:05:48.58,Default,,0000,0000,0000,,Хина
Dialogue: 0,0:05:49.65,0:05:53.65,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:49.65,0:05:53.65,Default,,0000,0000,0000,,Сәлемдесу Сәлемдесу ~
Dialogue: 0,0:05:53.65,0:05:55.66,Default,,0000,0000,0000,,Бастауыш сынып оқушылары!
Dialogue: 0,0:05:55.66,0:05:59.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:05:55.66,0:05:59.99,Default,,0000,0000,0000,,Дәл сіз сияқты мен де осы көктемнен бастап орта мектеп оқушысы боламын!
Dialogue: 0,0:05:59.99,0:06:04.00,Default,,0000,0000,0000,,Биіктігі де
Dialogue: 0,0:05:59.99,0:06:04.00,Default,,0000,0000,0000,,Бастауыш сыныпта оқып жүрген кезімнен бойым 7 см өсті.
Dialogue: 0,0:06:04.00,0:06:07.43,Default,,0000,0000,0000,,Сонда да 150-ге жуық.
Dialogue: 0,0:06:07.43,0:06:11.44,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:06:07.43,0:06:11.44,Default,,0000,0000,0000,,Бойым 170 см болмаса да.
Dialogue: 0,0:06:11.44,0:06:13.51,Default,,0000,0000,0000,,Ол өсе бастады!
Dialogue: 0,0:06:13.51,0:06:15.58,Default,,0000,0000,0000,,<Екеуі де бастауыш сынып оқушылары>
Dialogue: 0,0:06:19.11,0:06:21.45,Default,,0000,0000,0000,,-де? Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:06:21.45,0:06:23.72,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:06:25.79,0:06:29.86,Default,,0000,0000,0000,,Анықтама үшін.
Dialogue: 0,0:06:25.79,0:06:29.86,Default,,0000,0000,0000,,Қыздар...
Dialogue: 0,0:06:29.86,0:06:32.79,Default,,0000,0000,0000,,Мені бақытты ететін нәрсе...
Dialogue: 0,0:06:32.79,0:06:36.30,Default,,0000,0000,0000,,Не? Қойбана~?
Dialogue: 0,0:06:36.30,0:06:39.37,Default,,0000,0000,0000,,Егер солай болса, маған қалдырыңыз!
Dialogue: 0,0:06:39.37,0:06:42.14,Default,,0000,0000,0000,,Ең алдымен жалқау болма.
Dialogue: 0,0:06:42.14,0:06:46.21,Default,,0000,0000,0000,,Менің қолымнан келеді.
Dialogue: 0,0:06:42.14,0:06:46.21,Default,,0000,0000,0000,,Сенуге болатын адамды жасаңыз
Dialogue: 0,0:06:46.21,0:06:50.21,Default,,0000,0000,0000,,Және ең бастысы!
Dialogue: 0,0:06:50.21,0:06:52.38,Default,,0000,0000,0000,,Физикалық сұлулық
Dialogue: 0,0:07:09.76,0:07:12.43,Default,,0000,0000,0000,,<Хинадан сұрағаным қате болды>
Dialogue: 0,0:07:12.43,0:07:14.70,Default,,0000,0000,0000,,<Ол тым талғампаз>
Dialogue: 0,0:07:22.78,0:07:25.14,Default,,0000,0000,0000,,<Сіз оны әлі ашқан жоқсыз ба?>
Dialogue: 0,0:07:34.79,0:07:37.79,Default,,0000,0000,0000,,<Жарайды, қазір! ＞
Dialogue: 0,0:07:37.79,0:07:40.13,Default,,0000,0000,0000,,<Сөйлесу мүмкіндігі! ＞
Dialogue: 0,0:07:40.13,0:07:44.46,Default,,0000,0000,0000,,(Үлкен қуаныш жүрек соғысы)
Dialogue: 0,0:07:44.46,0:07:48.23,Default,,0000,0000,0000,,<Біріншіден, өзін-өзі таныстыру... га
Dialogue: 0,0:07:44.46,0:07:48.23,Default,,0000,0000,0000,,Тым кенет >
Dialogue: 0,0:07:49.30,0:07:54.64,Default,,0000,0000,0000,,<Кешегі тәттілер үшін рахмет...
Dialogue: 0,0:07:49.30,0:07:54.64,Default,,0000,0000,0000,,Мен әлі тамақ жеген жоқпын＞
Dialogue: 0,0:07:54.64,0:07:57.91,Default,,0000,0000,0000,,<Иә!
Dialogue: 0,0:07:54.64,0:07:57.91,Default,,0000,0000,0000,,Сіз не оқып жатырсыз?＞
Dialogue: 0,0:08:07.49,0:08:09.46,Default,,0000,0000,0000,,<Үндетпе>
Dialogue: 0,0:08:10.49,0:08:13.16,Default,,0000,0000,0000,,
Dialogue: 0,0:08:13.16,0:08:16.66,Default,,0000,0000,0000,,Бұл! Бұл
Dialogue: 0,0:08:13.16,0:08:16.66,Default,,0000,0000,0000,,Қаласаңыз пайдаланыңыз.
Dialogue: 0,0:08:16.66,0:08:19.00,Default,,0000,0000,0000,,Мен оны жудым.
Dialogue: 0,0:08:19.00,0:08:22.00,Default,,0000,0000,0000,,А...
Dialogue: 0,0:08:19.00,0:08:22.00,Default,,0000,0000,0000,,Және
Dialogue: 0,0:08:22.00,0:08:24.00,Default,,0000,0000,0000,,Жылы шай
Dialogue: 0,0:08:24.00,0:08:28.01,Default,,0000,0000,0000,,Бұл су бөтелкесінің жылуды сақтайтын әсері бар.
Dialogue: 0,0:08:24.00,0:08:28.01,Default,,0000,0000,0000,,Сондай-ақ, қолғаптар және
Dialogue: 0,0:08:28.01,0:08:31.48,Default,,0000,0000,0000,,Каир! Сіз оны шайқасаңыз жылы болады ...
Dialogue: 0,0:08:35.85,0:08:40.22,Default,,0000,0000,0000,,<Мен қашып кеттім! ＞
Dialogue: 0,0:08:41.19,0:08:43.16,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:08:44.19,0:08:46.69,Default,,0000,0000,0000,,Не...?
Dialogue: 0,0:08:46.69,0:08:49.70,Default,,0000,0000,0000,,Сізде туған күніңізді растайтын құжат бар ма?
Dialogue: 0,0:08:46.69,0:08:49.70,Default,,0000,0000,0000,,Сіз маған не әкеле аласыз деп ойлаймын.
Dialogue: 0,0:08:49.70,0:08:52.37,Default,,0000,0000,0000,,А...
Dialogue: 0,0:08:52.37,0:08:55.03,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:08:55.03,0:08:57.00,Default,,0000,0000,0000,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:08:58.10,0:09:01.64,Default,,0000,0000,0000,,Мазалағаныңызға рахмет.
Dialogue: 0,0:08:58.10,0:09:01.64,Default,,0000,0000,0000,,Біраздан соң—
Dialogue: 0,0:09:01.64,0:09:03.64,Default,,0000,0000,0000,,<Мен күлдім...>
Dialogue: 0,0:09:03.64,0:09:05.71,Default,,0000,0000,0000,,
Dialogue: 0,0:09:07.31,0:09:10.65,Default,,0000,0000,0000,,<Ah…>
Dialogue: 0,0:09:07.31,0:09:10.65,Default,,0000,0000,0000,,Себебі менде бәрі жақсы
Dialogue: 0,0:09:10.65,0:09:12.62,Default,,0000,0000,0000,,Жылы ұстаңыз
Dialogue: 0,0:09:16.72,0:09:18.99,Default,,0000,0000,0000,,<Осындай бірдеңе...>
Dialogue: 0,0:09:18.99,0:09:23.66,Default,,0000,0000,0000,,<Жаңа үйленгендер
Dialogue: 0,0:09:18.99,0:09:23.66,Default,,0000,0000,0000,,Ол галстук таққан сияқты>
Dialogue: 0,0:09:24.83,0:09:27.20,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:09:24.83,0:09:27.20,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:09:28.33,0:09:30.67,Default,,0000,0000,0000,,<Мен де бұл туралы кеше ойладым>
Dialogue: 0,0:09:30.67,0:09:35.01,Default,,0000,0000,0000,,<Чынацу-сенпай деген кім?
Dialogue: 0,0:09:30.67,0:09:35.01,Default,,0000,0000,0000,,Ол дене температурасы төмен адам＞
Dialogue: 0,0:09:35.01,0:09:37.08,Default,,0000,0000,0000,,Дайын
Dialogue: 0,0:09:37.08,0:09:40.35,Default,,0000,0000,0000,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,0:09:37.08,0:09:40.35,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:09:40.35,0:09:44.02,Default,,0000,0000,0000,,Суық тигізбеу
Dialogue: 0,0:09:40.35,0:09:44.02,Default,,0000,0000,0000,,Taiki Inomata
Dialogue: 0,0:09:44.02,0:09:46.69,Default,,0000,0000,0000,,Неліктен аты...
Dialogue: 0,0:09:46.69,0:09:49.26,Default,,0000,0000,0000,,Енді неге?
Dialogue: 0,0:09:51.19,0:09:53.53,Default,,0000,0000,0000,,<Мүмкін, бұрын білген шығармын...>
Dialogue: 0,0:09:53.53,0:09:56.03,Default,,0000,0000,0000,,Сіз жақсы анасыз.
Dialogue: 0,0:09:56.03,0:09:58.53,Default,,0000,0000,0000,,<Ана? ＞
Dialogue: 0,0:09:58.53,0:10:00.47,Default,,0000,0000,0000,,＜Ха! ＞
Dialogue: 0,0:10:00.47,0:10:02.44,Default,,0000,0000,0000,,＜Бірақ мені атыммен шақырыңыз...＞
Dialogue: 0,0:10:04.54,0:10:09.51,Default,,0000,0000,0000,,<Бұл өте ұят! ＞
Dialogue: 0,0:10:23.32,0:10:25.39,Default,,0000,0000,0000,,⚟Үзіліс!
Dialogue: 0,0:10:25.39,0:10:29.06,Default,,0000,0000,0000,,Дайки, шүберекті сулаңыз.
Dialogue: 0,0:10:25.39,0:10:29.06,Default,,0000,0000,0000,,Usu!
Dialogue: 0,0:10:32.33,0:10:36.00,Default,,0000,0000,0000,,<Қандай болса да
Dialogue: 0,0:10:32.33,0:10:36.00,Default,,0000,0000,0000,,Менің есімім есте қалды＞
Dialogue: 0,0:10:36.00,0:10:38.17,Default,,0000,0000,0000,,《Тайки иномата》
Dialogue: 0,0:10:39.34,0:10:43.41,Default,,0000,0000,0000,,<Шақырылған адам
Dialogue: 0,0:10:39.34,0:10:43.41,Default,,0000,0000,0000,,Деструктивті күш мен күткеннен де күшті болды>
Dialogue: 0,0:10:43.41,0:10:45.38,Default,,0000,0000,0000,,Эхе~
Dialogue: 0,0:10:48.01,0:10:52.08,Default,,0000,0000,0000,,<Әйтеуір, бұл
Dialogue: 0,0:10:48.01,0:10:52.08,Default,,0000,0000,0000,,Екінші турға өттік>
Dialogue: 0,0:10:52.08,0:10:54.69,Default,,0000,0000,0000,,<Келесі 3-тур>
Dialogue: 0,0:10:54.69,0:10:57.66,Default,,0000,0000,0000,,<Байланыс ақпаратын сұраңыз! ＞
Dialogue: 0,0:11:04.46,0:11:09.14,Default,,0000,0000,0000,,<Әйел автобус директоры мен Чинацу-сенпай? ＞
Dialogue: 0,0:11:09.14,0:11:12.14,Default,,0000,0000,0000,,Сіз не қарап тұрсыз?
Dialogue: 0,0:11:09.14,0:11:12.14,Default,,0000,0000,0000,,Балапандар!
Dialogue: 0,0:11:12.14,0:11:14.41,Default,,0000,0000,0000,,Басқа нәрсе...
Dialogue: 0,0:11:17.64,0:11:19.98,Default,,0000,0000,0000,,Үмітіңізді тым жоғары қоймаңыз
Dialogue: 0,0:11:19.98,0:11:22.48,Default,,0000,0000,0000,,<Сіз айтасыз>
Dialogue: 0,0:11:22.48,0:11:27.32,Default,,0000,0000,0000,,Бұл жай ғана маңызды болып көрінеді.
Dialogue: 0,0:11:22.48,0:11:27.32,Default,,0000,0000,0000,,Мен жай ғана қарап тұрдым.
Dialogue: 0,0:11:27.32,0:11:29.66,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:11:29.66,0:11:33.66,Default,,0000,0000,0000,,Мен, өткен күні, әлгі аға
Dialogue: 0,0:11:29.66,0:11:33.66,Default,,0000,0000,0000,,Мен сені бір адаммен жүргеніңді көрдім.
Dialogue: 0,0:11:33.66,0:11:35.63,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:11:37.50,0:11:39.47,Default,,0000,0000,0000,,Қолдану~
Dialogue: 0,0:11:41.00,0:11:43.67,Default,,0000,0000,0000,,<Мына жігіт~! ＞
Dialogue: 0,0:11:56.85,0:11:58.82,Default,,0000,0000,0000,,⚟Жақсы жұмыс~
Dialogue: 0,0:12:00.85,0:12:04.02,Default,,0000,0000,0000,,Жақсы жұмыс~
Dialogue: 0,0:12:00.85,0:12:04.02,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:04.92,0:12:09.86,Default,,0000,0000,0000,,<Аа, мен орамалды спортзалда ұмытып кетіппін>
Dialogue: 0,0:12:09.86,0:12:12.63,Default,,0000,0000,0000,,Не? жоғалған зат?
Dialogue: 0,0:12:09.86,0:12:12.63,Default,,0000,0000,0000,,О, мен бірінші үйге барайын...
Dialogue: 0,0:12:12.63,0:12:14.60,Default,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:12:17.64,0:12:20.21,Default,,0000,0000,0000,,<Құдайға шүкір, әлі ашық>
Dialogue: 0,0:12:29.48,0:12:32.65,Default,,0000,0000,0000,,<Мен тағы да таң қалдым...>
Dialogue: 0,0:12:33.99,0:12:36.32,Default,,0000,0000,0000,,Taiki Inomata
Dialogue: 0,0:12:36.32,0:12:39.33,Default,,0000,0000,0000,,<Атын дұрыс есімде сақтаймын>
Dialogue: 0,0:12:39.33,0:12:41.83,Default,,0000,0000,0000,,Сіз әлі де жаттығудасыз ба?
Dialogue: 0,0:12:41.83,0:12:45.16,Default,,0000,0000,0000,,Үйірме жұмыстары кезінде ойнау
Dialogue: 0,0:12:41.83,0:12:45.16,Default,,0000,0000,0000,,Мен қанағаттанбаймын
Dialogue: 0,0:12:45.16,0:12:47.83,Default,,0000,0000,0000,,Артық жұмыс
Dialogue: 0,0:12:45.16,0:12:47.83,Default,,0000,0000,0000,,Мұнда неге келдің?
Dialogue: 0,0:12:47.83,0:12:49.84,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:12:49.84,0:12:53.71,Default,,0000,0000,0000,,Қазір де аз
Dialogue: 0,0:12:49.84,0:12:53.71,Default,,0000,0000,0000,,Допқа қол тигізгіңіз келеді, солай ма?
Dialogue: 0,0:12:54.84,0:12:57.71,Default,,0000,0000,0000,,<Шынымен
Dialogue: 0,0:12:54.84,0:12:57.71,Default,,0000,0000,0000,,Менің ойымша, сізге баскетбол ұнайды.＞
Dialogue: 0,0:13:00.51,0:13:02.48,Default,,0000,0000,0000,,<Мен сенің көріп тұрғаныңды білемін...>
Dialogue: 0,0:13:03.52,0:13:06.69,Default,,0000,0000,0000,,1-ге 1 жасайық!
Dialogue: 0,0:13:03.52,0:13:06.69,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:09.52,0:13:11.52,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:11.52,0:13:13.49,Default,,0000,0000,0000,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:13:14.53,0:13:19.30,Default,,0000,0000,0000,,Күрсін! Ха ха...
Dialogue: 0,0:13:19.30,0:13:21.30,Default,,0000,0000,0000,,Кішкене үзіліс жасайық ба?
Dialogue: 0,0:13:21.30,0:13:24.14,Default,,0000,0000,0000,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:13:24.14,0:13:26.47,Default,,0000,0000,0000,,<Өкінішті! ＞
Dialogue: 0,0:13:26.47,0:13:30.48,Default,,0000,0000,0000,,Бірақ басс бөлігінен күткендей
Dialogue: 0,0:13:26.47,0:13:30.48,Default,,0000,0000,0000,,Ол жақсы қозғалады.
Dialogue: 0,0:13:30.48,0:13:35.48,Default,,0000,0000,0000,,Менің анам баскетбол командасында болды.
Dialogue: 0,0:13:30.48,0:13:35.48,Default,,0000,0000,0000,,Кейде біз бірге жұмыс істейміз.
Dialogue: 0,0:13:35.48,0:13:37.48,Default,,0000,0000,0000,,Мен сенімен біргемін.
Dialogue: 0,0:13:37.48,0:13:39.82,Default,,0000,0000,0000,,Менің анам да баскетбол командасында.
Dialogue: 0,0:13:39.82,0:13:44.32,Default,,0000,0000,0000,,Шағын автобусқа кірер алдында
Dialogue: 0,0:13:39.82,0:13:44.32,Default,,0000,0000,0000,,Біз бірге баскетбол ойнадық, солай ма?
Dialogue: 0,0:13:44.32,0:13:47.39,Default,,0000,0000,0000,,<Ортақ қасиет: Тағдыр! ＞
Dialogue: 0,0:13:47.39,0:13:50.33,Default,,0000,0000,0000,,Баскетбол ойнайық деген не?
Dialogue: 0,0:13:47.39,0:13:50.33,Default,,0000,0000,0000,,Сіз олай ойламадыңыз ба?
Dialogue: 0,0:13:50.33,0:13:53.40,Default,,0000,0000,0000,,《Уау! 》
Dialogue: 0,0:13:50.33,0:13:53.40,Default,,0000,0000,0000,,《Өту》
Dialogue: 0,0:13:53.40,0:13:58.67,Default,,0000,0000,0000,,Мен өзімді командалық ойынға қатыспадым деп ойлаймын.
Dialogue: 0,0:13:53.40,0:13:58.67,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:13:58.67,0:14:02.17,Default,,0000,0000,0000,,Оның үстіне маған ұнайды.
Dialogue: 0,0:14:02.17,0:14:05.18,Default,,0000,0000,0000,,Будтың ауласында жалғыз тұру
Dialogue: 0,0:14:05.18,0:14:08.55,Default,,0000,0000,0000,,Толық жауапкершілік
Dialogue: 0,0:14:05.18,0:14:08.55,Default,,0000,0000,0000,,Маған ауыр тиетіндей сезім
Dialogue: 0,0:14:09.95,0:14:14.29,Default,,0000,0000,0000,,Жеңіңіз немесе жеңіліңіз
Dialogue: 0,0:14:09.95,0:14:14.29,Default,,0000,0000,0000,,Маған рахмет, бұл менің кінәм.
Dialogue: 0,0:14:14.29,0:14:17.29,Default,,0000,0000,0000,,Бұл шиеленіс көңілді
Dialogue: 0,0:14:17.29,0:14:19.66,Default,,0000,0000,0000,,Бұл мазохисттік
Dialogue: 0,0:14:21.63,0:14:23.63,Default,,0000,0000,0000,,Бірақ мен қанағаттандым.
Dialogue: 0,0:14:23.63,0:14:26.20,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:14:23.63,0:14:26.20,Default,,0000,0000,0000,,Ол өте қатты жаттығады.
Dialogue: 0,0:14:28.70,0:14:30.97,Default,,0000,0000,0000,,Тіпті ағам айтса да
Dialogue: 0,0:14:30.97,0:14:33.04,Default,,0000,0000,0000,,Мен сені мақтауға қиналсам да.
Dialogue: 0,0:14:33.04,0:14:35.04,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:14:35.04,0:14:40.81,Default,,0000,0000,0000,,Чинацу Сенпай Кіші мектепті бітіргеннен кейінгі күні
Dialogue: 0,0:14:35.04,0:14:40.81,Default,,0000,0000,0000,,Сіз жаттығу жасаған жоқсыз ба?
Dialogue: 0,0:14:40.81,0:14:44.78,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:40.81,0:14:44.78,Default,,0000,0000,0000,,Осыдан бір жарым жыл бұрын.
Dialogue: 0,0:14:45.88,0:14:48.82,Default,,0000,0000,0000,,Сол күні үйірме жұмыстары жабылды.
Dialogue: 0,0:14:48.82,0:14:50.89,Default,,0000,0000,0000,,Ішінара үйге жақын тұратындықтан.
Dialogue: 0,0:14:50.89,0:14:55.49,Default,,0000,0000,0000,,Заттарды тастау үшін
Dialogue: 0,0:14:50.89,0:14:55.49,Default,,0000,0000,0000,,Мен мектепке кездейсоқ келдім.
Dialogue: 0,0:14:55.49,0:14:57.46,Default,,0000,0000,0000,,Содан кейін...
Dialogue: 0,0:15:09.94,0:15:15.61,Default,,0000,0000,0000,,Содан кейін, соңғы минутта
Dialogue: 0,0:15:09.94,0:15:15.61,Default,,0000,0000,0000,,Елге бара алмайсың деп естідім.
Dialogue: 0,0:15:15.61,0:15:18.45,Default,,0000,0000,0000,,Көп
Dialogue: 0,0:15:15.61,0:15:18.45,Default,,0000,0000,0000,,Менің ойымша, бұл көңілсіз болды.
Dialogue: 0,0:15:18.45,0:15:23.79,Default,,0000,0000,0000,,Мен өкінгенім сонша.
Dialogue: 0,0:15:18.45,0:15:23.79,Default,,0000,0000,0000,,Мен барынша тырыстым деп ойлаймын.
Dialogue: 0,0:15:23.79,0:15:26.96,Default,,0000,0000,0000,,Жоспар
Dialogue: 0,0:15:23.79,0:15:26.96,Default,,0000,0000,0000,,Осыншама еңбек ете алсам ғой
Dialogue: 0,0:15:29.30,0:15:33.13,Default,,0000,0000,0000,,<Енді ойлап қарасам
Dialogue: 0,0:15:29.30,0:15:33.13,Default,,0000,0000,0000,,Мен ағамды ұнатамын деп ойладым>
Dialogue: 0,0:15:33.13,0:15:35.20,Default,,0000,0000,0000,,<Мүмкін сол кезден>
Dialogue: 0,0:15:40.64,0:15:42.61,Default,,0000,0000,0000,,<Иә? ＞
Dialogue: 0,0:15:44.71,0:15:46.68,Default,,0000,0000,0000,,Мен ұмытып қалдым
Dialogue: 0,0:15:49.65,0:15:53.65,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:15:49.65,0:15:53.65,Default,,0000,0000,0000,,Балалар, тезірек үйге қайтыңдар.
Dialogue: 0,0:15:53.65,0:15:57.32,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:15:53.65,0:15:57.32,Default,,0000,0000,0000,,Оны тазалап көрейік
Dialogue: 0,0:15:57.32,0:16:01.69,Default,,0000,0000,0000,,＜Мен таң қалдым.
Dialogue: 0,0:15:57.32,0:16:01.69,Default,,0000,0000,0000,,Бір сәт ол жылап жатыр деп ойладым...＞
Dialogue: 0,0:16:15.84,0:16:17.81,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:16:19.51,0:16:21.48,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:16:26.85,0:16:29.32,Default,,0000,0000,0000,,<Жаттығудан кейін болғандықтан ба? ＞
Dialogue: 0,0:16:31.36,0:16:35.73,Default,,0000,0000,0000,,<Ағаның қолдары
Dialogue: 0,0:16:31.36,0:16:35.73,Default,,0000,0000,0000,,Бұрынғыдан жылырақ сезіледі＞
Dialogue: 0,0:16:49.38,0:16:52.71,Default,,0000,0000,0000,,Бүгін бүкіл ел бойынша
Dialogue: 0,0:16:49.38,0:16:52.71,Default,,0000,0000,0000,,Болжам ашық аспанға арналған.
Dialogue: 0,0:16:52.71,0:16:56.38,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:16:52.71,0:16:56.38,Default,,0000,0000,0000,,Қайырлы таң, түскі қорап сонда.
Dialogue: 0,0:16:56.38,0:16:58.38,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:16:58.38,0:17:00.39,Default,,0000,0000,0000,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:16:58.38,0:17:00.39,Default,,0000,0000,0000,,Сіз футболка кимейсіз бе?
Dialogue: 0,0:17:00.39,0:17:02.45,Default,,0000,0000,0000,,Жоқ, жылы.
Dialogue: 0,0:17:02.45,0:17:06.23,Default,,0000,0000,0000,,Мен оны жууға қиналсам да
Dialogue: 0,0:17:02.45,0:17:06.23,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:17:09.83,0:17:11.83,Default,,0000,0000,0000,,<Чинацу-сенпай! ＞
Dialogue: 0,0:17:11.83,0:17:15.83,Default,,0000,0000,0000,,Сіз бұл баланы білесіз бе?
Dialogue: 0,0:17:11.83,0:17:15.83,Default,,0000,0000,0000,,Білмеймін! ?
Dialogue: 0,0:17:15.83,0:17:21.91,Default,,0000,0000,0000,,Шындығында, Чинацудың анасы
Dialogue: 0,0:17:15.83,0:17:21.91,Default,,0000,0000,0000,,Екеуміз командалас болдық.
Dialogue: 0,0:17:21.91,0:17:25.84,Default,,0000,0000,0000,,Э…?—
Dialogue: 0,0:17:21.91,0:17:25.84,Default,,0000,0000,0000,,Не, қатты сөйлейсің бе?
Dialogue: 0,0:17:25.84,0:17:27.85,Default,,0000,0000,0000,,Бөлек
Dialogue: 0,0:17:27.85,0:17:30.52,Default,,0000,0000,0000,,<Байланыс нүктелері өте көп! ＞
Dialogue: 0,0:17:31.52,0:17:34.19,Default,,0000,0000,0000,,(Үлкен қуаныш анасы)
Dialogue: 0,0:17:31.52,0:17:34.19,Default,,0000,0000,0000,,Біз анда-санда хабарласып тұрдық.
Dialogue: 0,0:17:34.19,0:17:38.86,Default,,0000,0000,0000,,Чинацу-чан өте керемет
Dialogue: 0,0:17:34.19,0:17:38.86,Default,,0000,0000,0000,,Мен мұндай болады деп ешқашан ойламадым.
Dialogue: 0,0:17:38.86,0:17:43.23,Default,,0000,0000,0000,,Бірақ бұл ұят.
Dialogue: 0,0:17:38.86,0:17:43.23,Default,,0000,0000,0000,,Шетелге ауыстыру
Dialogue: 0,0:17:49.94,0:17:54.61,Default,,0000,0000,0000,,Наурыздың ортасында көшіп бара жатқаныңызды естідім.
Dialogue: 0,0:17:49.94,0:17:54.61,Default,,0000,0000,0000,,Мен сені сағындым~
Dialogue: 0,0:17:57.54,0:17:59.71,Default,,0000,0000,0000,,<Енді ойлап қарасам...>
Dialogue: 0,0:18:02.88,0:18:05.32,Default,,0000,0000,0000,,Үлкен қуаныш! ?
Dialogue: 0,0:18:05.32,0:18:07.99,Default,,0000,0000,0000,,<Орын ауыстыру? шетелде? ＞
Dialogue: 0,0:18:07.99,0:18:10.99,Default,,0000,0000,0000,,<Бұл не? Бұл не! ＞
Dialogue: 0,0:18:10.99,0:18:14.96,Default,,0000,0000,0000,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:18:16.33,0:18:19.00,Default,,0000,0000,0000,,<Шынымен
Dialogue: 0,0:18:16.33,0:18:19.00,Default,,0000,0000,0000,,Бұл жақсы ма? ＞
Dialogue: 0,0:18:20.17,0:18:23.24,Default,,0000,0000,0000,,<Күн сайын таңертең бірінші кел>
Dialogue: 0,0:18:23.24,0:18:26.00,Default,,0000,0000,0000,,<Басқалардан көбірек жаттығыңыз>
Dialogue: 0,0:18:26.00,0:18:29.98,Default,,0000,0000,0000,,<Осылай
Dialogue: 0,0:18:26.00,0:18:29.98,Default,,0000,0000,0000,,Менде өкініш бар болса да＞
Dialogue: 0,0:18:31.08,0:18:34.51,Default,,0000,0000,0000,,<Сол да сезім
Dialogue: 0,0:18:31.08,0:18:34.51,Default,,0000,0000,0000,,Осы уақытқа дейінгі күш-жігер＞
Dialogue: 0,0:18:34.51,0:18:38.02,Default,,0000,0000,0000,,<Барлық мақсаттар! ＞
Dialogue: 0,0:18:38.02,0:18:40.69,Default,,0000,0000,0000,,<Мен оны осында қалдыра алмаймын ба? ＞
Dialogue: 0,0:18:48.36,0:18:53.37,Default,,0000,0000,0000,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:18:53.37,0:18:56.87,Default,,0000,0000,0000,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:18:56.87,0:19:00.87,Default,,0000,0000,0000,,Иномата-кун, не болды?
Dialogue: 0,0:19:00.87,0:19:05.24,Default,,0000,0000,0000,,Чинацу Сенпай
Dialogue: 0,0:19:00.87,0:19:05.24,Default,,0000,0000,0000,,Жоғары аралық өтінемін!
Dialogue: 0,0:19:06.88,0:19:10.82,Default,,0000,0000,0000,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:19:06.88,0:19:10.82,Default,,0000,0000,0000,,Мен оны Чинацу-сенпайдан үйрендім.
Dialogue: 0,0:19:10.82,0:19:14.15,Default,,0000,0000,0000,,Мақсатқа қарай
Dialogue: 0,0:19:10.82,0:19:14.15,Default,,0000,0000,0000,,Күн сайын күш салыңыз
Dialogue: 0,0:19:14.15,0:19:18.12,Default,,0000,0000,0000,,Тіпті жеңіліп қалсаңыз да
Dialogue: 0,0:19:14.15,0:19:18.12,Default,,0000,0000,0000,,Алға күтіңіз
Dialogue: 0,0:19:19.16,0:19:22.83,Default,,0000,0000,0000,,Сондықтан берілмеңіз
Dialogue: 0,0:19:22.83,0:19:27.90,Default,,0000,0000,0000,,Ата-ананың ауысуы
Dialogue: 0,0:19:22.83,0:19:27.90,Default,,0000,0000,0000,,Өзіңізден басқа себептермен шетелге шығу
Dialogue: 0,0:19:27.90,0:19:29.90,Default,,0000,0000,0000,,Солай ма...
Dialogue: 0,0:19:27.90,0:19:29.90,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:19:29.90,0:19:32.67,Default,,0000,0000,0000,,Мен шетелге шықпаймын.
Dialogue: 0,0:19:33.84,0:19:36.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:36.17,0:19:39.18,Default,,0000,0000,0000,,<Мм, о...>
Dialogue: 0,0:19:39.18,0:19:42.18,Default,,0000,0000,0000,,Нақтырақ айтсақ
Dialogue: 0,0:19:39.18,0:19:42.18,Default,,0000,0000,0000,,Менің отбасым барады, бірақ
Dialogue: 0,0:19:42.18,0:19:46.25,Default,,0000,0000,0000,,Мен досымның үйіне бардым
Dialogue: 0,0:19:42.18,0:19:46.25,Default,,0000,0000,0000,,Маған сонда тұруды өтінді.
Dialogue: 0,0:19:46.25,0:19:49.25,Default,,0000,0000,0000,,<Бұл мен емес...>
Dialogue: 0,0:19:49.25,0:19:51.72,Default,,0000,0000,0000,,<Қашып кет! ? ＞
Dialogue: 0,0:19:53.19,0:19:56.46,Default,,0000,0000,0000,,жақсы.
Dialogue: 0,0:19:53.19,0:19:56.46,Default,,0000,0000,0000,,Мен қатты уайымдадым.
Dialogue: 0,0:19:58.20,0:20:02.03,Default,,0000,0000,0000,,Отбасыңызды тастап кету
Dialogue: 0,0:19:58.20,0:20:02.03,Default,,0000,0000,0000,,Мен өзімді жалғыз сезінемін
Dialogue: 0,0:20:02.03,0:20:05.47,Default,,0000,0000,0000,,Бірақ орта мектептің үйірме жұмыстары
Dialogue: 0,0:20:05.47,0:20:10.14,Default,,0000,0000,0000,,Мен зейнеткерлікке шыққанда не болды?
Dialogue: 0,0:20:05.47,0:20:10.14,Default,,0000,0000,0000,,Менің есте сақтауға мүмкіндігім бар
Dialogue: 0,0:20:10.14,0:20:13.41,Default,,0000,0000,0000,,Мен бүкіл елге барғым келді.
Dialogue: 0,0:20:14.48,0:20:16.75,Default,,0000,0000,0000,,Мен бас тартқым келмейді
Dialogue: 0,0:20:22.32,0:20:25.16,Default,,0000,0000,0000,,Сізге рахмет
Dialogue: 0,0:20:25.16,0:20:28.13,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:20:25.16,0:20:28.13,Default,,0000,0000,0000,,Taiki Inomata
Dialogue: 0,0:20:33.00,0:20:35.97,Default,,0000,0000,0000,,Менде ештеңе жоқ...
Dialogue: 0,0:20:38.34,0:20:40.51,Default,,0000,0000,0000,,1-ден 1-ге қайта ойнаймыз!
Dialogue: 0,0:20:45.01,0:20:48.28,Default,,0000,0000,0000,,Келесі жолы да Буд жасайық.
Dialogue: 0,0:20:45.01,0:20:48.28,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:21:03.70,0:21:08.70,Default,,0000,0000,0000,,＜Мен бейберекетпін.
Dialogue: 0,0:21:03.70,0:21:08.70,Default,,0000,0000,0000,,Ұят болатын нәрсе айтыңыз ба? ＞
Dialogue: 0,0:21:08.70,0:21:11.37,Default,,0000,0000,0000,,Ах! Ах!
Dialogue: 0,0:21:14.64,0:21:16.61,Default,,0000,0000,0000,,Күрсін...
Dialogue: 0,0:21:18.14,0:21:20.91,Default,,0000,0000,0000,,Бүгін жексенбі болғанына қуаныштымын.
Dialogue: 0,0:21:25.82,0:21:29.69,Default,,0000,0000,0000,,<Бүгін менің тарихымда бірінші рет>
Dialogue: 0,0:21:30.89,0:21:33.36,Default,,0000,0000,0000,,<Мен Чинацу-сенпаймен кездескім келеді...>
Dialogue: 0,0:21:36.83,0:21:38.83,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:21:38.83,0:21:41.50,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:41.50,0:21:45.27,Default,,0000,0000,0000,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:21:41.50,0:21:45.27,Default,,0000,0000,0000,,Чинацу-сенпай менің үйімде! ?
Dialogue: 0,0:21:47.17,0:21:49.84,Default,,0000,0000,0000,,О, зор қуаныш, ояусың.
Dialogue: 0,0:21:47.17,0:21:49.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:49.84,0:21:52.84,Default,,0000,0000,0000,,Қараңызшы, бұл туралы бұрын да айтқанбыз➡
Dialogue: 0,0:21:52.84,0:21:56.52,Default,,0000,0000,0000,,Бұл Чинацу Кано
Dialogue: 0,0:21:56.52,0:21:59.85,Default,,0000,0000,0000,,Көктемнен
Dialogue: 0,0:21:56.52,0:21:59.85,Default,,0000,0000,0000,,Өйткені мен өз үйімде тұруды шештім.
Dialogue: 0,0:21:59.85,0:22:02.92,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:21:59.85,0:22:02.92,Default,,0000,0000,0000,,Бұл өте пайдалы.
Dialogue: 0,0:22:02.92,0:22:06.02,Default,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:22:02.92,0:22:06.02,Default,,0000,0000,0000,,Бұрынғы әріптес емес
Dialogue: 0,0:22:06.02,0:22:09.03,Default,,0000,0000,0000,,(Дайкидің анасы, Чинацудың анасы)
Dialogue: 0,0:22:06.02,0:22:09.03,Default,,0000,0000,0000,,Біз Эймейміз!
Dialogue: 0,0:22:09.03,0:22:14.00,Default,,0000,0000,0000,,<Не болса да~! ＞
Dialogue: 0,0:22:15.30,0:22:32.18,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:33.68,0:22:39.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory