Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.80,0:00:13.26,Default,,0,0,0,,Мені ұрма
Dialogue: 0,0:00:14.47,0:00:15.76,Default,,0,0,0,,дұрысырақ
Dialogue: 0,0:00:16.26,0:00:17.30,Default,,0,0,0,,Мен оны көтеремін
Dialogue: 0,0:00:17.39,0:00:18.43,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:32.40,0:00:33.57,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:34.07,0:00:35.41,Default,,0,0,0,,Ол аяқталды.
Dialogue: 0,0:00:37.53,0:00:39.53,Default,,0,0,0,,♪~
Dialogue: 0,0:02:04.45,0:02:06.45,Default,,0,0,0,,~♪
Dialogue: 0,0:02:12.17,0:02:14.42,Default,,0,0,0,,Маған бір күн бұрын айтсаң қиын болар еді.
Dialogue: 0,0:02:14.50,0:02:17.01,Default,,0,0,0,,Иномат, өтінемін
Dialogue: 0,0:02:17.72,0:02:18.51,Default,,0,0,0,,Бар болғаны 10 минут
Dialogue: 0,0:02:18.59,0:02:21.64,Default,,0,0,0,,Шоуды ерте бастасаңыз жақсы болар еді.
Dialogue: 0,0:02:22.30,0:02:24.89,Default,,0,0,0,,Памфлетте қате бар.
Dialogue: 0,0:02:25.52,0:02:30.14,Default,,0,0,0,,1-В 15:30-да басталады.
Dialogue: 0,0:02:30.65,0:02:32.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:33.31,0:02:34.61,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:02:34.69,0:02:35.94,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:02:36.53,0:02:38.53,Default,,0,0,0,,Мұқият тексеріңіз.
Dialogue: 0,0:02:38.61,0:02:40.53,Default,,0,0,0,,10 минутыңызды не нәрсеге жұмсағыңыз келеді?
Dialogue: 0,0:02:45.37,0:02:49.33,Default,,0,0,0,,Бұл асықты да мектеп мерекесіне бір күн қалғандай сезінеді.
Dialogue: 0,0:02:52.92,0:02:53.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:57.92,0:02:58.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:59.42,0:03:02.89,Default,,0,0,0,,Ертең Кано мырзаны шақырмайсыз ба?
Dialogue: 0,0:03:02.97,0:03:04.85,Default,,0,0,0,,Күшпен шешілген болуы керек.
Dialogue: 0,0:03:04.93,0:03:07.02,Default,,0,0,0,,Мен сенің қарсыласың емеспін.
Dialogue: 0,0:03:07.52,0:03:09.60,Default,,0,0,0,,Бастау үшін бос емес сияқтысыз.
Dialogue: 0,0:03:09.68,0:03:13.15,Default,,0,0,0,,Дұрыс, мен қарап отырмын және бұл жеткілікті.
Dialogue: 0,0:03:13.23,0:03:13.90,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:13.98,0:03:15.48,Default,,0,0,0,,Сол шеңбердің ішіне кіріңіз~
Dialogue: 0,0:03:15.57,0:03:16.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:20.40,0:03:21.86,Default,,0,0,0,,О, үлкен қуаныш
Dialogue: 0,0:03:22.86,0:03:25.33,Default,,0,0,0,,Сіз сыныпқа кіруге дайынсыз ба?
Dialogue: 0,0:03:25.41,0:03:26.41,Default,,0,0,0,,Дайын ба?
Dialogue: 0,0:03:26.49,0:03:28.37,Default,,0,0,0,,Оны көргенде таң қаласың
Dialogue: 0,0:03:28.45,0:03:31.16,Default,,0,0,0,,Мүмкін ол тағы да тіректерді сындырған шығар...
Dialogue: 0,0:03:31.25,0:03:32.54,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:03:32.62,0:03:33.88,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:33.96,0:03:36.13,Default,,0,0,0,,Уау, сондай сүйкімді...
Dialogue: 0,0:03:42.88,0:03:43.47,Default,,0,0,0,,Ах
Dialogue: 0,0:03:44.59,0:03:45.26,Default,,0,0,0,,О
Dialogue: 0,0:03:46.47,0:03:48.68,Default,,0,0,0,,Ең жақсы аяқтау емес
Dialogue: 0,0:03:48.77,0:03:50.39,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:50.48,0:03:52.14,Default,,0,0,0,,Мен уақытында үлгердім.
Dialogue: 0,0:03:52.64,0:03:54.98,Default,,0,0,0,,Көшбасшы, сіз де бірдеңе айтыңызшы.
Dialogue: 0,0:03:55.06,0:03:55.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:55.73,0:03:57.61,Default,,0,0,0,,Ах... мм...
Dialogue: 0,0:03:58.69,0:04:00.15,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:04:00.82,0:04:02.28,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:04:04.24,0:04:07.20,Default,,0,0,0,,Иә! Шашыңызды бұрайық
Dialogue: 0,0:04:10.45,0:04:12.66,Default,,0,0,0,,Мен сені мақтайсың деп ойладым.
Dialogue: 0,0:04:13.67,0:04:15.42,Default,,0,0,0,,Қашпасаң да... Ах
Dialogue: 0,0:04:19.00,0:04:21.67,Default,,0,0,0,,Ол көрсете алатын нәрсенің шегі болды ма?
Dialogue: 0,0:04:23.34,0:04:27.93,Default,,0,0,0,,Менің ойымша, Inomata да мүлдем ессіз.
Dialogue: 0,0:04:28.01,0:04:29.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:30.81,0:04:31.43,Default,,0,0,0,,болды
Dialogue: 0,0:04:32.43,0:04:35.90,Default,,0,0,0,,Мектеп фестивалінде бұл туралы бірдеңе болуы мүмкін.
Dialogue: 0,0:05:16.23,0:05:17.98,Default,,0,0,0,,Иә? Бұл өтірік.
Dialogue: 0,0:05:18.90,0:05:20.48,Default,,0,0,0,,Бүгін мектеп мерекесі, солай ма?
Dialogue: 0,0:05:21.07,0:05:22.94,Default,,0,0,0,,Неге жейде киіп жүрсің?
Dialogue: 0,0:05:24.28,0:05:26.78,Default,,0,0,0,,Өйткені мектеп мейрамына гимназияны пайдалана алмаймыз.
Dialogue: 0,0:05:27.49,0:05:28.99,Default,,0,0,0,,Мен жүгіруді ойладым.
Dialogue: 0,0:05:29.74,0:05:30.70,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:05:30.78,0:05:33.91,Default,,0,0,0,,(есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:05:34.00,0:05:36.58,Default,,0,0,0,,Мен бүгін демалсам ғой.
Dialogue: 0,0:05:37.08,0:05:39.50,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:06:00.06,0:06:01.44,Default,,0,0,0,,Чинацу Сенпай
Dialogue: 0,0:06:02.90,0:06:04.32,Default,,0,0,0,,Дайки-кун
Dialogue: 0,0:06:04.40,0:06:05.82,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:06.32,0:06:08.61,Default,,0,0,0,,Таңғы жаттығу, өйткені мен жаттығу залын пайдалана алмаймын
Dialogue: 0,0:06:10.03,0:06:12.12,Default,,0,0,0,,Бүгін демалсам екен.
Dialogue: 0,0:06:15.45,0:06:17.00,Default,,0,0,0,,Тіпті Дайки-кун
Dialogue: 0,0:06:18.66,0:06:22.13,Default,,0,0,0,,Өткен ойыннан мотивацияға толы болдым.
Dialogue: 0,0:06:22.63,0:06:23.75,Default,,0,0,0,,Мен де
Dialogue: 0,0:06:23.84,0:06:27.51,Default,,0,0,0,,Сені осылай көрсем, шабыттанамын.
Dialogue: 0,0:06:28.09,0:06:28.80,Default,,0,0,0,,А...
Dialogue: 0,0:06:34.06,0:06:35.01,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:06:35.85,0:06:37.89,Default,,0,0,0,,Сіз ешқашан қуып жете алмайсыз, солай ма?
Dialogue: 0,0:06:38.43,0:06:41.44,Default,,0,0,0,,Чинацу-сенпай, көбірек айналма жолдармен жүріңіз.
Dialogue: 0,0:06:42.40,0:06:44.52,Default,,0,0,0,,Мен айналма жолдарды көп аламын.
Dialogue: 0,0:06:44.61,0:06:45.73,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:06:46.23,0:06:49.03,Default,,0,0,0,,Мидағы баскетбол 100% емес пе?
Dialogue: 0,0:06:50.78,0:06:52.70,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:06:58.00,0:06:59.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:02.38,0:07:03.75,Default,,0,0,0,,Өйткені мен баскетболшымын.
Dialogue: 0,0:07:04.50,0:07:08.30,Default,,0,0,0,,Айтпақшы, өткен күні ойнаған топ
Dialogue: 0,0:07:08.38,0:07:09.76,Default,,0,0,0,,2 курс тобы
Dialogue: 0,0:07:09.84,0:07:10.72,Default,,0,0,0,,Иә
Dialogue: 0,0:07:11.59,0:07:14.26,Default,,0,0,0,,Сағат 14:00-ден бастап жанды қойылым болады.
Dialogue: 0,0:07:14.35,0:07:16.10,Default,,0,0,0,,Оны бірге көрейік
Dialogue: 0,0:07:17.35,0:07:18.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:21.73,0:07:23.44,Default,,0,0,0,,Сіз бос емессіз бе?
Dialogue: 0,0:07:23.52,0:07:24.98,Default,,0,0,0,,Жоқ, мен барамын.
Dialogue: 0,0:07:25.57,0:07:26.52,Default,,0,0,0,,Жақсы
Dialogue: 0,0:07:27.02,0:07:30.99,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:07:31.57,0:07:34.07,Default,,0,0,0,,А, мен тезірек кетуім керек.
Dialogue: 0,0:07:39.25,0:07:41.41,Default,,0,0,0,,Содан кейін сағат 14:00-де өтетін жерде
Dialogue: 0,0:07:42.00,0:07:42.87,Default,,0,0,0,,Иә
Dialogue: 0,0:07:45.46,0:07:46.46,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:48.09,0:07:50.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:53.09,0:07:56.68,Default,,0,0,0,,Бұдан былай Эймей фестивалі өтеді.
Dialogue: 0,0:07:59.77,0:08:02.69,Default,,0,0,0,,Жеңдер! Өлімге әкелетін көбелектің сақинасы!
Dialogue: 0,0:08:02.77,0:08:03.44,Default,,0,0,0,,Білегім мен қолым аман қалғаны, бәлкім,
Dialogue: 0,0:08:05.86,0:08:08.32,Default,,0,0,0,,-(Балалар) Ах... -(Е оқушы) Өте жаман.
Dialogue: 0,0:08:08.90,0:08:10.82,Default,,0,0,0,,- (балапан) Тағы бір рет! -(Е студент) Ух...
Dialogue: 0,0:08:10.90,0:08:14.86,Default,,0,0,0,,Көңілді отырсың, қобалжымайсың ба?
Dialogue: 0,0:08:14.95,0:08:18.41,Default,,0,0,0,,Көңіл көтеруің қобалжығандықтан емес пе?
Dialogue: 0,0:08:21.12,0:08:23.62,Default,,0,0,0,,Сонымен қатар, спектакль 15:30-да басталады.
Dialogue: 0,0:08:24.17,0:08:28.34,Default,,0,0,0,,Егер мен сағат 15.00-де дайындалуым керек болса, мен оған дейін көңіл көтеруім керек.
Dialogue: 0,0:08:28.42,0:08:29.34,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:30.46,0:08:33.38,Default,,0,0,0,,Мен қазір патрульге шығуым керек.
Dialogue: 0,0:08:33.47,0:08:35.01,Default,,0,0,0,,Daiki не істеп жатыр?
Dialogue: 0,0:08:35.09,0:08:39.10,Default,,0,0,0,,Әзірше Шоға және басқаларға барайық, сосын...
Dialogue: 0,0:08:41.81,0:08:44.10,Default,,0,0,0,,Содан кейін сағат 14:00-де өтетін жерде.
Dialogue: 0,0:08:44.19,0:08:45.56,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:46.23,0:08:47.86,Default,,0,0,0,,Сенпай Гарамика
Dialogue: 0,0:08:49.23,0:08:50.82,Default,,0,0,0,,- (Кай) жа - (үлкен қуаныш) Оу
Dialogue: 0,0:08:52.61,0:08:55.07,Default,,0,0,0,,Бұл арман сияқты.
Dialogue: 0,0:08:55.15,0:08:58.32,Default,,0,0,0,,Чинацу-сенпайдың мені концертке шақырғанына сене алар емеспін.
Dialogue: 0,0:09:00.62,0:09:01.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.79,0:09:02.62,Default,,0,0,0,,Ах
Dialogue: 0,0:09:09.17,0:09:10.38,Default,,0,0,0,,Киши-кун
Dialogue: 0,0:09:11.17,0:09:13.92,Default,,0,0,0,,Иномат үлкен қуаныш! Мен естідім
Dialogue: 0,0:09:14.01,0:09:15.76,Default,,0,0,0,,Юса-кунды жеңген сияқтысың.
Dialogue: 0,0:09:15.84,0:09:16.88,Default,,0,0,0,,Бұл оқиға?
Dialogue: 0,0:09:16.97,0:09:18.89,Default,,0,0,0,,Менімен де жарыс!
Dialogue: 0,0:09:18.97,0:09:21.14,Default,,0,0,0,,Жоқ... енді мектеп мерекесі
Dialogue: 0,0:09:21.22,0:09:22.14,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:09:22.72,0:09:25.10,Default,,0,0,0,,Мені Чинацу-санның сыныбына апарыңыз.
Dialogue: 0,0:09:25.18,0:09:26.14,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:09:26.23,0:09:27.73,Default,,0,0,0,,Не?
Dialogue: 0,0:09:27.81,0:09:31.36,Default,,0,0,0,,Сіздің кесіріңізден мен сізге байланыс ақпаратымды да бере алмадым.
Dialogue: 0,0:09:31.86,0:09:33.94,Default,,0,0,0,,Себебі біз жеңіліп қалдық!
Dialogue: 0,0:09:34.03,0:09:36.70,Default,,0,0,0,,Қай уақытта болса да, қазір тоғыз болды ғой!
Dialogue: 0,0:09:37.36,0:09:40.66,Default,,0,0,0,,О, бұл ерекше комбинация.
Dialogue: 0,0:09:42.16,0:09:44.66,Default,,0,0,0,,Харю-сенпай мен... Хана Кой-сан
Dialogue: 0,0:09:51.25,0:09:53.80,Default,,0,0,0,,Неге сонша ренжідің?
Dialogue: 0,0:09:53.88,0:09:55.05,Default,,0,0,0,,Ханакой-нисан
Dialogue: 0,0:09:55.13,0:09:58.76,Default,,0,0,0,,Бұл жігіт мені 2-Б-ге бағыттамайды.
Dialogue: 0,0:09:58.84,0:09:59.68,Default,,0,0,0,,Не-сан?\NЕгер бұл
Dialogue: 0,0:10:00.26,0:10:01.93,Default,,0,0,0,,болса, мен сол жерге барғым келеді.
Dialogue: 0,0:10:02.01,0:10:03.18,Default,,0,0,0,,Егер сіз маған еретін болсаңыз?
Dialogue: 0,0:10:03.26,0:10:04.31,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:10:04.81,0:10:05.68,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:10:07.02,0:10:09.69,Default,,0,0,0,,Сақ болыңыз, себебі бұл өте тітіркендіргіш.
Dialogue: 0,0:10:10.27,0:10:11.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:23.66,0:10:24.79,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:10:28.79,0:10:30.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:30.58,0:10:31.96,Default,,0,0,0,,Мен сізге дәл қазір қоңырау шаламын.
Dialogue: 0,0:10:32.04,0:10:34.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:35.59,0:10:36.80,Default,,0,0,0,,Чинацу
Dialogue: 0,0:10:36.88,0:10:37.97,Default,,0,0,0,,Иә
Dialogue: 0,0:10:38.67,0:10:40.18,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:10:45.35,0:10:46.81,Default,,0,0,0,,Гах... аа...
Dialogue: 0,0:10:46.89,0:10:48.23,Default,,0,0,0,,Киши-кун!
Dialogue: 0,0:10:48.81,0:10:52.23,Default,,0,0,0,,Сіз... жақсы тұра аласыз.
Dialogue: 0,0:10:53.02,0:10:56.48,Default,,0,0,0,,Тіпті мен шетте тұрмын.
Dialogue: 0,0:10:56.57,0:10:59.11,Default,,0,0,0,,Бұл өте сүйкімді!
Dialogue: 0,0:11:00.74,0:11:02.37,Default,,0,0,0,,Олар қызық балалар.
Dialogue: 0,0:11:02.45,0:11:03.49,Default,,0,0,0,,Жас
Dialogue: 0,0:11:06.20,0:11:07.95,Default,,0,0,0,,Тосын шабуыл
Dialogue: 0,0:11:08.04,0:11:10.87,Default,,0,0,0,,Даяшы болып жұмыс істемеймін дедіңіз.
Dialogue: 0,0:11:12.08,0:11:14.92,Default,,0,0,0,,Мен ағамды осылай көргеніме қуаныштымын.
Dialogue: 0,0:11:15.42,0:11:16.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:17.63,0:11:18.51,Default,,0,0,0,,Сәлем, сен
Dialogue: 0,0:11:19.38,0:11:22.34,Default,,0,0,0,,Сенің жігітің бар ма? Маған байланыс ақпаратыңызды айтыңыз
Dialogue: 0,0:11:22.84,0:11:24.01,Default,,0,0,0,,А...
Dialogue: 0,0:11:24.10,0:11:25.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:25.10,0:11:25.85,Default,,0,0,0,,(үстелді түрту дыбысы)
Dialogue: 0,0:11:26.35,0:11:29.85,Default,,0,0,0,,Бұл дүкеннің түрі емес.
Dialogue: 0,0:11:29.93,0:11:30.77,Default,,0,0,0,,Нагиса!
Dialogue: 0,0:11:32.10,0:11:34.77,Default,,0,0,0,,Өтінемін, оған тиіспейсіз бе?
Dialogue: 0,0:11:35.56,0:11:38.48,Default,,0,0,0,,Біз жай ғана тыныс аламыз
Dialogue: 0,0:11:38.57,0:11:41.82,Default,,0,0,0,,Ең жақсы серіктестер: су және балық
Dialogue: 0,0:11:41.90,0:11:45.28,Default,,0,0,0,,Олар «ананы ал» деп сөйлесетін ерлі-зайыптылар сияқты.
Dialogue: 0,0:11:45.37,0:11:46.53,Default,,0,0,0,,Нағиса...
Dialogue: 0,0:11:47.58,0:11:50.29,Default,,0,0,0,,Мені қорғайтын адам бар екеніне қуаныштымын.
Dialogue: 0,0:11:50.37,0:11:52.29,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:11:52.37,0:11:53.33,Default,,0,0,0,,А...
Dialogue: 0,0:11:53.83,0:11:56.54,Default,,0,0,0,,Жігіт... аа...
Dialogue: 0,0:11:57.67,0:11:59.46,Default,,0,0,0,,Жоқ, ол әйел автобуста...
Dialogue: 0,0:11:59.55,0:12:01.80,Default,,0,0,0,,Жүрегі ауырғаннан кейін ғана ішіңіз
Dialogue: 0,0:12:01.88,0:12:03.09,Default,,0,0,0,,Жүр, ішіп ал.
Dialogue: 0,0:12:03.18,0:12:04.80,Default,,0,0,0,,Сіз ақша табуға тырысасыз ба?
Dialogue: 0,0:12:04.89,0:12:06.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:06.39,0:12:09.01,Default,,0,0,0,,Мен оны білдім.
Dialogue: 0,0:12:09.10,0:12:10.06,Default,,0,0,0,,Неге массың?
Dialogue: 0,0:12:11.10,0:12:14.35,Default,,0,0,0,,Біздің кездесуіміз қанша тағдырлы болса да,
Dialogue: 0,0:12:14.44,0:12:17.69,Default,,0,0,0,,Бірлік болу үшін тым алыспыз...
Dialogue: 0,0:12:18.19,0:12:19.07,Default,,0,0,0,,Тағдыр?
Dialogue: 0,0:12:19.15,0:12:22.07,Default,,0,0,0,,Бірақ мына күлкіге қараңызшы.
Dialogue: 0,0:12:24.16,0:12:27.74,Default,,0,0,0,,Мен Чинацудың бақытты болғанын қалаймын.
Dialogue: 0,0:12:27.83,0:12:28.83,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:12:28.91,0:12:30.49,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:31.62,0:12:33.08,Default,,0,0,0,,Бұл жақсы сусын.
Dialogue: 0,0:12:35.37,0:12:39.09,Default,,0,0,0,,Бақытты болып көрінгенде жаныңда болғым келеді.
Dialogue: 0,0:12:40.17,0:12:40.84,Default,,0,0,0,,Ах
Dialogue: 0,0:12:40.92,0:12:43.34,Default,,0,0,0,,Ей, еңбегіңе рахмет.
Dialogue: 0,0:12:43.42,0:12:45.09,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:12:45.18,0:12:47.80,Default,,0,0,0,,Қызметші формасы Мен оған табынамын деп ойладым.
Dialogue: 0,0:12:47.89,0:12:49.10,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:12:50.47,0:12:52.52,Default,,0,0,0,,Қосу Мен әкелемін.
Dialogue: 0,0:12:53.39,0:12:54.35,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:12:55.14,0:12:58.11,Default,,0,0,0,,Мен сағат 14.00-де басталатын сән көрсетілімін көргім келеді.
Dialogue: 0,0:12:58.61,0:13:00.11,Default,,0,0,0,,Ей, бірге барайық.
Dialogue: 0,0:13:00.19,0:13:02.69,Default,,0,0,0,,Иә? 14:00...
Dialogue: 0,0:13:04.65,0:13:07.07,Default,,0,0,0,,Кешіріңіз, менің жоспарларым бар.
Dialogue: 0,0:13:11.79,0:13:13.41,Default,,0,0,0,,Сосын сендермен...
Dialogue: 0,0:13:13.50,0:13:16.58,Default,,0,0,0,,Ах! Мен досымның үйіне баруым керек!
Dialogue: 0,0:13:16.67,0:13:17.92,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:13:18.00,0:13:18.75,Default,,0,0,0,,Ой!
Dialogue: 0,0:13:18.83,0:13:20.13,Default,,0,0,0,,Оны артта қалдырмаңыз!
Dialogue: 0,0:13:29.47,0:13:32.26,Default,,0,0,0,,Мәдени мерекелер көңілді өтеді.
Dialogue: 0,0:13:56.12,0:13:58.42,Default,,0,0,0,,Чинацу-сенпай, кешігіп қалдыңыз.
Dialogue: 0,0:13:59.38,0:14:02.88,Default,,0,0,0,,Ах! Мүмкін орын ішінде шығар?
Dialogue: 0,0:14:06.47,0:14:09.30,Default,,0,0,0,,Сәлеметсіз бе, бұл Самойед.
Dialogue: 0,0:14:09.39,0:14:11.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:11.14,0:14:13.81,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:14:14.43,0:14:15.47,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:16.89,0:14:20.19,Default,,0,0,0,,Уау, бұл қызықты.
Dialogue: 0,0:14:20.27,0:14:22.15,Default,,0,0,0,,Бірге көңіл көтерейік!
Dialogue: 0,0:14:22.23,0:14:23.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:24.02,0:14:26.19,Default,,0,0,0,,Біраз адам бар.
Dialogue: 0,0:14:28.36,0:14:31.57,Default,,0,0,0,,Иә? Бұл менің қателігім емес.
Dialogue: 0,0:14:32.37,0:14:34.16,Default,,0,0,0,,Жоқ, мен айттым.
Dialogue: 0,0:14:34.66,0:14:36.66,Default,,0,0,0,,-(Вокал) Бірінші ән... -(Қуанышты) Бірақ
Dialogue: 0,0:14:36.75,0:14:37.96,Default,,0,0,0,,«Нагиса»
Dialogue: 0,0:14:38.04,0:14:40.08,Default,,0,0,0,,Бұл елес десе де
Dialogue: 0,0:14:41.54,0:14:42.84,Default,,0,0,0,,Мүмкін мен таң қалмаспын.
Dialogue: 0,0:14:48.72,0:14:51.34,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:52.01,0:14:55.51,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,0:14:58.43,0:15:00.85,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:15:01.81,0:15:03.11,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:15:06.86,0:15:09.11,Default,,0,0,0,,Келесі ауысым келмеді.
Dialogue: 0,0:15:09.70,0:15:10.53,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:11.24,0:15:13.24,Default,,0,0,0,,Енді тыңдаңыз.
Dialogue: 0,0:15:13.32,0:15:14.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:14.33,0:15:15.58,Default,,0,0,0,,Ертерек барайық!
Dialogue: 0,0:15:19.08,0:15:20.37,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:22.17,0:15:23.88,Default,,0,0,0,,Бұл иллюзия емес еді
Dialogue: 0,0:15:30.22,0:15:33.89,Default,,0,0,0,,♪ Үнемі сыбырласып қалжыңдап
Dialogue: 0,0:15:33.97,0:15:34.97,Default,,0,0,0,,♪ Байланысқа сенді
Dialogue: 0,0:15:35.05,0:15:37.93,Default,,0,0,0,,Тікелей шоуды бірінші рет көріп тұрмын, бірақ керемет.
Dialogue: 0,0:15:38.02,0:15:42.19,Default,,0,0,0,,♪ Шөл алыстай көрінсе де
Dialogue: 0,0:15:42.27,0:15:44.31,Default,,0,0,0,,Дыбыс естігеннен кейін есту қабілетіңіз өшіп қалды ма?
Dialogue: 0,0:15:45.81,0:15:49.65,Default,,0,0,0,,♪ Бұл 6-шы магнитудалы жұлдыз
Dialogue: 0,0:15:49.74,0:15:53.16,Default,,0,0,0,,♪ Ойланбай ғашық болдым
Dialogue: 0,0:15:54.20,0:15:55.82,Default,,0,0,0,,Өте керемет!
Dialogue: 0,0:15:57.66,0:15:59.12,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:15:59.20,0:15:59.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:03.62,0:16:05.08,Default,,0,0,0,,«Иә!»…
Dialogue: 0,0:16:05.17,0:16:06.17,Default,,0,0,0,,«Иә!»
Dialogue: 0,0:16:09.88,0:16:13.59,Default,,0,0,0,,Бәлкім, мен тым өзімді-өзім санайтын шығармын
Dialogue: 0,0:16:15.09,0:16:17.18,Default,,0,0,0,,Мен бұл жағдайдан үлкен үміт күтемін.
Dialogue: 0,0:16:20.47,0:16:27.19,Default,,0,0,0,,♪ Жұмсақ күндер толқын дыбысымен боялады
Dialogue: 0,0:16:28.23,0:16:35.03,Default,,0,0,0,,♪ Иллюзия, оянба
Dialogue: 0,0:16:47.04,0:16:49.80,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:49.88,0:16:51.21,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:52.84,0:16:55.47,Default,,0,0,0,,Келесі ән «Blues Drive»
Dialogue: 0,0:16:55.97,0:16:57.72,Default,,0,0,0,,Әй, бұл ән!
Dialogue: 0,0:16:58.22,0:16:59.51,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:16:59.60,0:17:03.64,Default,,0,0,0,,Маған да ұнайды, бірақ маған Ханакой ұнайды.
Dialogue: 0,0:17:04.14,0:17:07.02,Default,,0,0,0,,Харю-кунмен төбелескенде тыңдайтыныңды естимін.
Dialogue: 0,0:17:07.10,0:17:10.11,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:17:11.65,0:17:12.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:14.28,0:17:18.32,Default,,0,0,0,,Чинацу-сенпай, сен мені бүгін неге шақырдың?
Dialogue: 0,0:17:19.12,0:17:21.54,Default,,0,0,0,,♪ Бау шешіліп жатыр
Dialogue: 0,0:17:22.16,0:17:23.95,Default,,0,0,0,,Сіз естіген жоқсыз ба?
Dialogue: 0,0:17:24.71,0:17:25.87,Default,,0,0,0,,Елемеуіңізді өтінемін
Dialogue: 0,0:17:28.38,0:17:31.46,Default,,0,0,0,,Шақыратын басқа ешкім жоқ шығар.
Dialogue: 0,0:17:31.55,0:17:34.30,Default,,0,0,0,,Хана Кой сән көрсетілімін көргісі келетінін айтты.
Dialogue: 0,0:17:37.89,0:17:39.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:39.34,0:17:43.06,Default,,0,0,0,,♪ Дірілдеген ән дауысымен және ашық қызыл Stratocaster
Dialogue: 0,0:17:43.14,0:17:45.10,Default,,0,0,0,,- (Чинацу) Бұл... - (Қуанып) Иә?
Dialogue: 0,0:17:46.14,0:17:47.14,Default,,0,0,0,,Бірдеңе айт...
Dialogue: 0,0:17:49.15,0:17:49.90,Default,,0,0,0,,Не!
Dialogue: 0,0:17:51.90,0:17:57.36,Default,,0,0,0,,♪ Мен салған арманның басы
Dialogue: 0,0:17:57.45,0:17:58.74,Default,,0,0,0,,Жаңа ғана не айттыңыз?
Dialogue: 0,0:17:58.82,0:17:59.82,Default,,0,0,0,,Не!
Dialogue: 0,0:18:00.41,0:18:03.33,Default,,0,0,0,,Кешіріңіз, дыбыс тым қатты.
Dialogue: 0,0:18:04.24,0:18:07.33,Default,,0,0,0,,♪ Мен сені қазір де күттім
Dialogue: 0,0:18:07.41,0:18:09.00,Default,,0,0,0,,♪ Толып кету
Dialogue: 0,0:18:09.08,0:18:15.76,Default,,0,0,0,,♪ Аяқ киімнің ілулі сөресі, күнге күйген екі бетімде
Dialogue: 0,0:18:15.84,0:18:19.72,Default,,0,0,0,,♪ Күн жарқырайды
Dialogue: 0,0:18:21.93,0:18:27.64,Default,,0,0,0,,♪ Суреттегідей күліп тұрдың
Dialogue: 0,0:18:27.73,0:18:30.40,Default,,0,0,0,,Бұл не? Мен қызықпын.
Dialogue: 0,0:18:33.36,0:18:38.24,Default,,0,0,0,,♪ Бұл сөзсіз
Dialogue: 0,0:18:42.20,0:18:43.70,Default,,0,0,0,,Көңілді болды.
Dialogue: 0,0:18:43.78,0:18:46.37,Default,,0,0,0,,Жанды дыбыс күшті, солай емес пе?
Dialogue: 0,0:18:46.95,0:18:49.12,Default,,0,0,0,,Сонымен, мен бұрын айтқаным туралы ...
Dialogue: 0,0:18:49.87,0:18:53.63,Default,,0,0,0,,Дайки-кунның сыныбына арналған қойылым 15:30-да басталады.
Dialogue: 0,0:18:54.21,0:18:55.09,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:55.17,0:18:57.13,Default,,0,0,0,,Сіз естімеймін деп жүре бересіз бе?
Dialogue: 0,0:18:57.92,0:19:00.05,Default,,0,0,0,,Мен ортадан орын аламын.
Dialogue: 0,0:19:00.13,0:19:01.93,Default,,0,0,0,,Мен ол жерде болмаймын.
Dialogue: 0,0:19:03.97,0:19:07.89,Default,,0,0,0,,Көрінбесе де, бұл сіз дайындық кезеңінде көп жұмыс істеген нәрсе.
Dialogue: 0,0:19:12.86,0:19:15.86,Default,,0,0,0,,Қайта келгеніңізге рахмет.
Dialogue: 0,0:19:15.94,0:19:16.73,Default,,0,0,0,,Иә
Dialogue: 0,0:19:24.45,0:19:25.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:26.24,0:19:29.08,Default,,0,0,0,,Мәдени мерекелер көңілді!
Dialogue: 0,0:19:29.75,0:19:32.42,Default,,0,0,0,,Тек қызықты оқиғалар болады
Dialogue: 0,0:19:32.50,0:19:35.17,Default,,0,0,0,,Менің ағаммен тікелей эфирде шоу көру
Dialogue: 0,0:19:48.72,0:19:51.18,Default,,0,0,0,,Егер сіз жанып тұрған шамды көрсеңіз
Dialogue: 0,0:19:51.27,0:19:53.31,Default,,0,0,0,,Бүгін есімде
Dialogue: 0,0:19:54.06,0:19:55.52,Default,,0,0,0,,- (Нишида) Үлкен қуаныш - (Үлкен қуаныш) Иә?
Dialogue: 0,0:19:56.11,0:19:57.27,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:19:57.86,0:19:59.15,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:19:59.23,0:20:01.28,Default,,0,0,0,,Күте тұрыңыз! Менің қазір бос уақытым бар!
Dialogue: 0,0:20:01.36,0:20:04.78,Default,,0,0,0,,Нишида-сенпай, не істеп жатырсың?
Dialogue: 0,0:20:04.87,0:20:07.78,Default,,0,0,0,,Мен көріп тұрғандай көріпкелмін.
Dialogue: 0,0:20:07.87,0:20:10.87,Default,,0,0,0,,Дәлірек айтсақ, біз сыныпта штамп митингісін өткіздік.
Dialogue: 0,0:20:10.95,0:20:12.62,Default,,0,0,0,,Мөртаңба қызметкері
Dialogue: 0,0:20:12.71,0:20:16.17,Default,,0,0,0,,Сондай-ақ құбыжықтардан, сайқымазақтардан және т.б. маркаларды алуға болады.
Dialogue: 0,0:20:16.25,0:20:17.54,Default,,0,0,0,,Жүлдеге ие болыңыз
Dialogue: 0,0:20:18.05,0:20:20.13,Default,,0,0,0,,- (Нишида) Қатысқыңыз келе ме? - (қуанып) Жоқ...
Dialogue: 0,0:20:21.97,0:20:23.76,Default,,0,0,0,,Мен сенің байлығыңды сен бар кезде айтамын.
Dialogue: 0,0:20:24.64,0:20:25.80,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:20:26.72,0:20:28.31,Default,,0,0,0,,Өйткені әже талантты
Dialogue: 0,0:20:28.89,0:20:29.60,Default,,0,0,0,,Не!
Dialogue: 0,0:20:30.39,0:20:33.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:44.15,0:20:45.57,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:46.32,0:20:47.82,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:20:47.91,0:20:49.03,Default,,0,0,0,,Жақында сізге келеді
Dialogue: 0,0:20:49.12,0:20:52.83,Default,,0,0,0,,Сізді керемет сынақ күтіп тұр!
Dialogue: 0,0:20:52.91,0:20:54.00,Default,,0,0,0,,Сынақ?
Dialogue: 0,0:20:54.08,0:20:56.17,Default,,0,0,0,,көріпкел!
Dialogue: 0,0:20:57.17,0:21:00.59,Default,,0,0,0,,Айтқанын істеп, әмиянымды таптым!
Dialogue: 0,0:21:00.67,0:21:02.71,Default,,0,0,0,,Менің бұрынғы жігітім хабарласты!
Dialogue: 0,0:21:02.80,0:21:04.59,Default,,0,0,0,,Менің ажырасқан ағам!
Dialogue: 0,0:21:04.68,0:21:08.22,Default,,0,0,0,,Иә, иә, солай ма?
Dialogue: 0,0:21:08.30,0:21:09.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:11.06,0:21:12.10,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:21:12.68,0:21:15.10,Default,,0,0,0,,Бұлай болуы мүмкін емес!
Dialogue: 0,0:21:15.85,0:21:18.69,Default,,0,0,0,,«Таңғажайып сынақ» тым анық емес.
Dialogue: 0,0:21:19.69,0:21:21.19,Default,,0,0,0,,Қалағаныңды айт...
Dialogue: 0,0:21:22.94,0:21:24.36,Default,,0,0,0,,Не!
Dialogue: 0,0:21:25.40,0:21:28.12,Default,,0,0,0,,Ханзада рөліндегі Минамияма мырза ауруханада жатыр ма?
Dialogue: 0,0:21:28.78,0:21:31.03,Default,,0,0,0,,3-D САСКЕ ойнады
Dialogue: 0,0:21:31.12,0:21:34.12,Default,,0,0,0,,Мақсатқа жетер екпінмен құлап, аяғыммен жалғастырдым...
Dialogue: 0,0:21:35.33,0:21:37.54,Default,,0,0,0,,Не істеуім керек, князь...
Dialogue: 0,0:21:37.62,0:21:39.08,Default,,0,0,0,,Біреу алмастырады...
Dialogue: 0,0:21:39.17,0:21:41.88,Default,,0,0,0,,Бақытымызға орай, жолдар онша көп емес.
Dialogue: 0,0:21:42.46,0:21:44.21,Default,,0,0,0,,Қолдар Кім бос?
Dialogue: 0,0:21:44.30,0:21:45.88,Default,,0,0,0,,Барлығы далада ойнап жүр.
Dialogue: 0,0:21:45.97,0:21:49.93,Default,,0,0,0,,Мұндағы адамдар не орындаушы, не сахна артында жұмыс істейді...
Dialogue: 0,0:21:50.01,0:21:52.47,Default,,0,0,0,,А... Маған да жарықтандыруға көмек керек.
Dialogue: 0,0:21:54.93,0:21:55.64,Default,,0,0,0,,Ах
Dialogue: 0,0:21:55.73,0:21:57.89,Default,,0,0,0,,Иә? Эх...
Dialogue: 0,0:21:58.98,0:21:59.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:01.69,0:22:02.48,Default,,0,0,0,,Не!
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.57,0:23:35.58,Default,,0,0,0,,~♪
