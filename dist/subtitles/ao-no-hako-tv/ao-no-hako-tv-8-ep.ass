Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.67,0:00:05.17,Default,,0,0,0,,Харюдан келген Дайки
Dialogue: 0,0:00:05.25,0:00:07.63,Default,,0,0,0,,Мен 1 ойында жеңдім.
Dialogue: 0,0:00:11.09,0:00:13.68,Default,,0,0,0,,Менімен кездескенше жеңілме
Dialogue: 0,0:00:14.26,0:00:15.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:15.84,0:00:16.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:26.56,0:00:30.07,Default,,0,0,0,,Мен жақсы күресе аламын ба?
Dialogue: 0,0:00:32.57,0:00:34.57,Default,,0,0,0,,♪~
Dialogue: 0,0:01:59.66,0:02:01.49,Default,,0,0,0,,~♪
Dialogue: 0,0:02:06.54,0:02:09.96,Default,,0,0,0,,(Смартфон дабылының дыбысы)
Dialogue: 0,0:02:10.71,0:02:13.96,Default,,0,0,0,,(Смартфон дабылының дыбысы)
Dialogue: 0,0:02:17.80,0:02:18.97,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:25.93,0:02:26.98,Default,,0,0,0,,Кеттік
Dialogue: 0,0:02:27.06,0:02:30.77,Default,,0,0,0,,(Радиогимнастика музыкасы)
Dialogue: 0,0:02:32.86,0:02:34.15,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:34.23,0:02:35.65,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:37.03,0:02:37.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:39.03,0:02:43.28,Default,,0,0,0,,(Радиогимнастика музыкасы)
Dialogue: 0,0:02:43.37,0:02:44.99,Default,,0,0,0,,Бұл сау.
Dialogue: 0,0:02:45.08,0:02:47.29,Default,,0,0,0,,Қайырлы таң, Чинацу-сенпай.
Dialogue: 0,0:02:48.20,0:02:50.33,Default,,0,0,0,,Мен бір орында тұра алмайтын сияқтымын.
Dialogue: 0,0:02:50.83,0:02:52.29,Default,,0,0,0,,Көбірек қобалжыңыз
Dialogue: 0,0:02:52.38,0:02:54.71,Default,,0,0,0,,Мен қатты болады деп ойладым.
Dialogue: 0,0:02:55.63,0:02:58.55,Default,,0,0,0,,Ақыры күн жеткенде мен оны асыға күттім.
Dialogue: 0,0:02:59.97,0:03:01.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:03.64,0:03:06.14,Default,,0,0,0,,- (Чинацу) Мен де істеймін - (қуанып) А.
Dialogue: 0,0:03:19.69,0:03:20.74,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:03:21.24,0:03:23.20,Default,,0,0,0,,Бүгін біз жұптық ойын ойнаймыз ба?
Dialogue: 0,0:03:23.28,0:03:25.53,Default,,0,0,0,,А, иә, бойдақтар ертең.
Dialogue: 0,0:03:29.37,0:03:31.87,Default,,0,0,0,,Орта мектепке қанша адам бара алады?
Dialogue: 0,0:03:31.96,0:03:35.00,Default,,0,0,0,,Бір жұп топ, екі жалғыз ойыншы
Dialogue: 0,0:03:35.08,0:03:36.75,Default,,0,0,0,,Бұл тар жол.
Dialogue: 0,0:03:36.84,0:03:38.76,Default,,0,0,0,,Осылай десең, сен ағасың.
Dialogue: 0,0:03:38.84,0:03:41.42,Default,,0,0,0,,Өйткені баскетбол – командалық ойын.
Dialogue: 0,0:03:41.51,0:03:44.47,Default,,0,0,0,,Бірақ мен Кагохара орта мектебі күшті деп естідім.
Dialogue: 0,0:03:44.55,0:03:47.43,Default,,0,0,0,,Иә, мен жеңуім керек, өйткені мен финалда жеңемін.
Dialogue: 0,0:03:47.93,0:03:49.77,Default,,0,0,0,,Финал ертең, солай ма?
Dialogue: 0,0:03:50.56,0:03:52.69,Default,,0,0,0,,Иә, ертең
Dialogue: 0,0:03:54.65,0:03:56.23,Default,,0,0,0,,Қазірдің өзінде ертең
Dialogue: 0,0:04:01.82,0:04:03.86,Default,,0,0,0,,Ым... Чинацу-сенпай
Dialogue: 0,0:04:03.95,0:04:07.03,Default,,0,0,0,,Ертеңнен кейін саған бір сұрақ қойсам болады ма?
Dialogue: 0,0:04:08.16,0:04:11.20,Default,,0,0,0,,Мен мұның шын мәнісін білгім келеді.
Dialogue: 0,0:04:12.91,0:04:14.21,Default,,0,0,0,,Қазір емес пе?
Dialogue: 0,0:04:14.29,0:04:15.17,Default,,0,0,0,,Иә
Dialogue: 0,0:04:15.25,0:04:16.42,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:16.50,0:04:18.92,Default,,0,0,0,,Оның орнына қазір сізге сұрақ қоя аламын ба?
Dialogue: 0,0:04:19.00,0:04:19.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:19.84,0:04:22.80,Default,,0,0,0,,Топ клубында қолдау айқайлары бар ма?
Dialogue: 0,0:04:23.38,0:04:24.97,Default,,0,0,0,,«Иппон»?
Dialogue: 0,0:04:25.05,0:04:27.60,Default,,0,0,0,,«Бір бөтелке» мен көремін.
Dialogue: 0,0:04:30.01,0:04:31.72,Default,,0,0,0,,Үлкен қуаныш!
Dialogue: 0,0:04:32.35,0:04:33.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.81,0:04:35.81,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:39.48,0:04:41.78,Default,,0,0,0,,Радио жаттығулары сергітеді.
Dialogue: 0,0:04:42.28,0:04:45.86,Default,,0,0,0,,Неліктен бұл адам жүрекке зиянды әрекет жасады?
Dialogue: 0,0:05:05.84,0:05:08.01,Default,,0,0,0,,Жоқ, бар!
Dialogue: 0,0:05:08.09,0:05:12.22,Default,,0,0,0,,Маусым айының ортасы, бұл аптап ыстық жазды қорқынышты етеді.
Dialogue: 0,0:05:12.31,0:05:14.02,Default,,0,0,0,,Мен тіпті терезені аша алмаймын.
Dialogue: 0,0:05:15.98,0:05:17.52,Default,,0,0,0,,Бірақ бұл атмосфера да
Dialogue: 0,0:05:18.90,0:05:22.53,Default,,0,0,0,,Турнир сияқты сезіледі, сондықтан бұл жаман емес шығар.
Dialogue: 0,0:05:29.20,0:05:31.53,Default,,0,0,0,,Олай болса, барамыз ба?
Dialogue: 0,0:05:33.41,0:05:34.54,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:05:36.00,0:05:37.12,Default,,0,0,0,,Неге сен де келмейсің?
Dialogue: 0,0:05:41.13,0:05:42.55,Default,,0,0,0,,Осы жерде ме?
Dialogue: 0,0:05:43.38,0:05:45.17,Default,,0,0,0,,Сіз матчты көруге келдіңіз бе?
Dialogue: 0,0:05:45.67,0:05:47.01,Default,,0,0,0,,But whose?
Dialogue: 0,0:05:47.72,0:05:50.55,Default,,0,0,0,,21 сәйкестік нөміріне қоңырау шалу
Dialogue: 0,0:05:50.64,0:05:54.68,Default,,0,0,0,,Сачигава орта мектебі Хиодо-кун Татейама-кун
Dialogue: 0,0:05:54.77,0:05:56.10,Default,,0,0,0,,Гиодо жұбы
Dialogue: 0,0:05:56.18,0:05:57.94,Default,,0,0,0,,Аура әртүрлі.
Dialogue: 0,0:05:58.02,0:05:59.06,Default,,0,0,0,,Деке…
Dialogue: 0,0:05:59.15,0:06:03.52,Default,,0,0,0,,Хиодо, Харю-сенпай толығымен жеңілді.
Dialogue: 0,0:06:07.40,0:06:10.03,Default,,0,0,0,,Әй, қолөнерші емес пе?
Dialogue: 0,0:06:10.11,0:06:11.82,Default,,0,0,0,,Сіз жеңілу үшін келдіңіз бе?
Dialogue: 0,0:06:12.66,0:06:14.08,Default,,0,0,0,,Хиодо мырза
Dialogue: 0,0:06:14.16,0:06:16.83,Default,,0,0,0,,Ұрланған олжаны қайтарыңыз.
Dialogue: 0,0:06:17.62,0:06:19.71,Default,,0,0,0,,Мен оны басшылыққа қайтардым.
Dialogue: 0,0:06:20.21,0:06:22.34,Default,,0,0,0,,Мен оны жеткізе алмаймын.
Dialogue: 0,0:06:22.42,0:06:24.67,Default,,0,0,0,,Хиодо Дайын бол.
Dialogue: 0,0:06:25.92,0:06:29.76,Default,,0,0,0,,Егер сіз оны көруге келген болсаңыз, кейбір сақтық шаралары туралы ойлануыңыз керек.
Dialogue: 0,0:06:39.98,0:06:42.31,Default,,0,0,0,,Күтілгендей, бұл үлкен сенімділік.
Dialogue: 0,0:06:42.40,0:06:44.61,Default,,0,0,0,,Бұл шынымен таңқаларлық.
Dialogue: 0,0:06:45.90,0:06:48.65,Default,,0,0,0,,Мен тек қисық доптарды ойнай аламын.
Dialogue: 0,0:06:49.20,0:06:52.70,Default,,0,0,0,,Хиодо мырза қисық допты да, жылдам допты да соға алатын адам.
Dialogue: 0,0:06:53.91,0:06:56.70,Default,,0,0,0,,Ойындардағыдай қабілет мәндері болса
Dialogue: 0,0:06:57.20,0:06:59.87,Default,,0,0,0,,Технологиялық сезім физикалық
Dialogue: 0,0:06:59.96,0:07:01.12,Default,,0,0,0,,Жылдамдық
Dialogue: 0,0:07:02.46,0:07:05.63,Default,,0,0,0,,Барлық қабілеттер теңдестірілген және тұрақты.
Dialogue: 0,0:07:06.46,0:07:08.21,Default,,0,0,0,,Сол адам туралы.
Dialogue: 0,0:07:15.47,0:07:17.81,Default,,0,0,0,,Ой, басқа деңгей
Dialogue: 0,0:07:17.89,0:07:20.39,Default,,0,0,0,,Мұндай нәрсе менің күресуге деген жігерімді жоғалтады.
Dialogue: 0,0:07:21.44,0:07:23.27,Default,,0,0,0,,Бұл балалардың жолы болмады.
Dialogue: 0,0:07:23.77,0:07:26.23,Default,,0,0,0,,Егер мен қалыпты ойнаған болсам, мен көбірек ұтар едім.
Dialogue: 0,0:07:26.73,0:07:29.90,Default,,0,0,0,,Қалғаны – қанша ұпай алуға болатыны туралы ойын.
Dialogue: 0,0:07:29.99,0:07:32.66,Default,,0,0,0,,Ол болашақ олимпиадашы болуы мүмкін.
Dialogue: 0,0:07:32.74,0:07:34.20,Default,,0,0,0,,Бұл ескерткіш болады.
Dialogue: 0,0:07:35.28,0:07:35.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:35.99,0:07:38.33,Default,,0,0,0,,Уау, соны соғасың ба?
Dialogue: 0,0:07:38.83,0:07:40.71,Default,,0,0,0,,Мен болсам, мен мұны басқаша істейтін едім.
Dialogue: 0,0:07:41.21,0:07:43.42,Default,,0,0,0,,Әй, неткен ысырап, қалқып тұр.
Dialogue: 0,0:07:44.42,0:07:47.17,Default,,0,0,0,,Мен дәл қазір айқышты соғып кетсем не болар еді деп ойлаймын.
Dialogue: 0,0:07:47.67,0:07:49.42,Default,,0,0,0,,Мен мұны істегеніңізді қалаймын.
Dialogue: 0,0:07:50.09,0:07:51.09,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:54.51,0:07:57.01,Default,,0,0,0,,Айтуға оңай.
Dialogue: 0,0:07:57.10,0:07:57.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:58.72,0:08:00.77,Default,,0,0,0,,Мен өзімнің мықты екенімді түсіндім.
Dialogue: 0,0:08:00.85,0:08:01.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.02,0:08:03.27,Default,,0,0,0,,Мен оны жүктеп салуым керек пе?
Dialogue: 0,0:08:03.35,0:08:04.31,Default,,0,0,0,,Иә
Dialogue: 0,0:08:04.40,0:08:06.98,Default,,0,0,0,,Содан кейін Нишидаға қоңырау шалып, бейнеге түсіруді сұраңыз.
Dialogue: 0,0:08:07.48,0:08:10.69,Default,,0,0,0,,Нишида-сенпай жеңілгеннен кейін күйзеліске түсті.
Dialogue: 0,0:08:12.32,0:08:14.74,Default,,0,0,0,,Сәйкестік нөмірі 28
Dialogue: 0,0:08:21.08,0:08:21.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:27.13,0:08:28.79,Default,,0,0,0,,Мен әмиянымды жоғалтып алдым.
Dialogue: 0,0:08:29.30,0:08:33.72,Default,,0,0,0,,А, сен маған айтуың керек, ұйықтап жатсаң да, абай болма.
Dialogue: 0,0:08:34.51,0:08:35.97,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:37.72,0:08:38.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:42.81,0:08:43.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:44.23,0:08:46.48,Default,,0,0,0,,Қалтамнан әмиян түсті.
Dialogue: 0,0:08:46.56,0:08:48.73,Default,,0,0,0,,Э? О, иә.
Dialogue: 0,0:08:50.32,0:08:51.98,Default,,0,0,0,,Бұл мейірімді
Dialogue: 0,0:08:52.07,0:08:53.19,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:53.28,0:08:55.36,Default,,0,0,0,,- (Харю) Дайки Кеттік - (Дайки) Иә!
Dialogue: 0,0:08:56.61,0:08:57.57,Default,,0,0,0,,Олай болса
Dialogue: 0,0:08:57.66,0:08:58.49,Default,,0,0,0,,О
Dialogue: 0,0:09:00.99,0:09:03.25,Default,,0,0,0,,Мейірімді адам болған.
Dialogue: 0,0:09:04.29,0:09:05.41,Default,,0,0,0,,болды
Dialogue: 0,0:09:05.50,0:09:07.50,Default,,0,0,0,,Юса, тағы да осындай жерде жат.
Dialogue: 0,0:09:07.58,0:09:09.00,Default,,0,0,0,,Директор, мен сізге қоңырау шалдым.
Dialogue: 0,0:09:09.09,0:09:10.75,Default,,0,0,0,,О...
Dialogue: 0,0:09:10.84,0:09:12.34,Default,,0,0,0,,Төтенше тоқтау! Жүгір!
Dialogue: 0,0:09:14.38,0:09:18.76,Default,,0,0,0,,Бірақ мейірімді адамдар Будқа жарамайды.
Dialogue: 0,0:09:25.31,0:09:28.65,Default,,0,0,0,,Юса! Гутте не істеп жүрсің?
Dialogue: 0,0:09:28.73,0:09:31.19,Default,,0,0,0,,Мен Хиодо-сан мен оның достарын олардың матчында қолдаймын.
Dialogue: 0,0:09:31.27,0:09:32.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:32.61,0:09:33.90,Default,,0,0,0,,Мазалама
Dialogue: 0,0:09:33.99,0:09:37.03,Default,,0,0,0,,Сіз сондай-ақ үлкендеріңіздің ойынын тамашалап, аздап үйренуіңіз керек.
Dialogue: 0,0:09:38.45,0:09:39.53,Default,,0,0,0,,Мен істеймін
Dialogue: 0,0:09:39.62,0:09:42.08,Default,,0,0,0,,Оның үстіне бұл Эймейдің Харю-кунға қарсы матч.
Dialogue: 0,0:09:42.16,0:09:43.37,Default,,0,0,0,,Қызықты көрінеді.
Dialogue: 0,0:09:47.50,0:09:49.17,Default,,0,0,0,,Қазір ойын қандай?
Dialogue: 0,0:09:49.25,0:09:51.54,Default,,0,0,0,,1-ойын 16-дан 9-ға дейін
Dialogue: 0,0:09:51.63,0:09:53.80,Default,,0,0,0,,Осы қарқынмен біз оңай жеңеміз деп ойлаймын.
Dialogue: 0,0:09:54.67,0:09:56.55,Default,,0,0,0,,Ұят болды, Харюкун.
Dialogue: 0,0:09:57.05,0:09:59.22,Default,,0,0,0,,Ресми матч: Хиодо мырзаға толық жеңіліс болды ма?
Dialogue: 0,0:09:59.30,0:10:00.80,Default,,0,0,0,,Қандай мағына?
Dialogue: 0,0:10:01.76,0:10:04.06,Default,,0,0,0,,Менің үйіме келсеңіз, мен Хиодо мырзамен бірге боламын.
Dialogue: 0,0:10:04.14,0:10:05.73,Default,,0,0,0,,Мен бүкіл елге барар едім
Dialogue: 0,0:10:09.40,0:10:11.56,Default,,0,0,0,,Оның үстіне қазіргі жұп бір жаста.
Dialogue: 0,0:10:12.61,0:10:14.57,Default,,0,0,0,,Екі есе дерлік көп ұпай жоғалтты
Dialogue: 0,0:10:15.48,0:10:17.82,Default,,0,0,0,,Айырмашылық нүкте айырмашылығы сияқты үлкен емес деп ойлаймын.
Dialogue: 0,0:10:17.90,0:10:18.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:18.99,0:10:21.53,Default,,0,0,0,,Ойынның өзі жаман емес.
Dialogue: 0,0:10:21.62,0:10:23.16,Default,,0,0,0,,Митинг жалғасуда
Dialogue: 0,0:10:24.16,0:10:26.16,Default,,0,0,0,,Тек шешуші соққы ғана қалды.
Dialogue: 0,0:10:26.66,0:10:27.54,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:27.62,0:10:28.83,Default,,0,0,0,,Уа, мен оны қайтардым!
Dialogue: 0,0:10:28.91,0:10:30.83,Default,,0,0,0,,Маған одан әрі шабуыл жасалса да
Dialogue: 0,0:10:30.92,0:10:32.96,Default,,0,0,0,,Харю-кун істерді жақсы шешеді.
Dialogue: 0,0:10:34.46,0:10:36.59,Default,,0,0,0,,- (Харюу) Жақсы, үлкен қуаныш - (үлкен қуаныш) Иә!
Dialogue: 0,0:10:37.17,0:10:38.59,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:10:38.67,0:10:40.09,Default,,0,0,0,,Керемет инеші!
Dialogue: 0,0:10:40.97,0:10:43.85,Default,,0,0,0,,Сол жылы өте табанды болғаныңыз рас.
Dialogue: 0,0:10:43.93,0:10:47.85,Default,,0,0,0,,Дәлдігі төмен болса да, ол міндетті түрде торды кесіп өтеді.
Dialogue: 0,0:10:47.93,0:10:49.85,Default,,0,0,0,,Харю оның соңынан ерді.
Dialogue: 0,0:10:51.94,0:10:53.36,Default,,0,0,0,,О, жақсы инеші!
Dialogue: 0,0:10:54.44,0:10:56.11,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:11:01.20,0:11:02.03,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:15.84,0:11:16.63,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:11:17.42,0:11:18.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:19.22,0:11:21.97,Default,,0,0,0,,Қандай ұят! Бір ойын жеңілді
Dialogue: 0,0:11:22.47,0:11:24.35,Default,,0,0,0,,Дөңмай Донмай!
Dialogue: 0,0:11:25.55,0:11:26.81,Default,,0,0,0,,Пальто ауыстыру
Dialogue: 0,0:11:29.98,0:11:32.98,Default,,0,0,0,,Шүкір, қуып жеттім.
Dialogue: 0,0:11:33.06,0:11:35.40,Default,,0,0,0,,Мен қазір шешім қабылдауым керек.
Dialogue: 0,0:11:36.98,0:11:37.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:37.69,0:11:39.07,Default,,0,0,0,,Ауыстыру
Dialogue: 0,0:11:39.15,0:11:40.99,Default,,0,0,0,,Мен екінші ойынды аламын.
Dialogue: 0,0:11:41.49,0:11:42.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:44.99,0:11:46.62,Default,,0,0,0,,Әй, қандай ұят.
Dialogue: 0,0:11:46.70,0:11:48.66,Default,,0,0,0,,Бұл өте жақсы соққы болды.
Dialogue: 0,0:11:49.45,0:11:51.25,Default,,0,0,0,,Екінші ойындағыдай соғып алсам
Dialogue: 0,0:11:51.33,0:11:53.46,Default,,0,0,0,,Бұл жақсырақ сәйкестік болуы мүмкін.
Dialogue: 0,0:12:00.59,0:12:01.67,Default,,0,0,0,,(алдыңғы есіктің ашылу дыбысы)
Dialogue: 0,0:12:01.76,0:12:03.84,Default,,0,0,0,,- (Юкико) О - (Чинацу) Мен үйдемін
Dialogue: 0,0:12:03.93,0:12:05.68,Default,,0,0,0,,Чинацу-чан, қош келдіңіз
Dialogue: 0,0:12:05.76,0:12:07.56,Default,,0,0,0,,Финалға өтуіңізбен құттықтаймыз
Dialogue: 0,0:12:07.64,0:12:09.47,Default,,0,0,0,,Ертеңгі финалда сәттілік.
Dialogue: 0,0:12:09.56,0:12:10.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:10.85,0:12:12.98,Default,,0,0,0,,Мен біраз уақытқа дүкенге барамын.
Dialogue: 0,0:12:13.06,0:12:13.69,Default,,0,0,0,,Ум...
Dialogue: 0,0:12:14.27,0:12:16.65,Default,,0,0,0,,Бүгін Дайки-кун...
Dialogue: 0,0:12:19.19,0:12:20.61,Default,,0,0,0,,Мен жеңілген сияқтымын
Dialogue: 0,0:12:20.69,0:12:22.70,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:24.45,0:12:26.78,Default,,0,0,0,,Дайки-кун…
Dialogue: 0,0:12:35.21,0:12:36.83,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:12:40.59,0:12:42.72,Default,,0,0,0,,Мен бірінші курс студентімін.
Dialogue: 0,0:12:43.22,0:12:45.05,Default,,0,0,0,,Бойдақтар бар.
Dialogue: 0,0:12:46.39,0:12:49.60,Default,,0,0,0,,Менің ойымша, бұл жайлылық басқаша.
Dialogue: 0,0:12:50.81,0:12:51.93,Default,,0,0,0,,Тек...
Dialogue: 0,0:12:53.68,0:12:54.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:55.48,0:12:56.31,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:58.27,0:12:59.77,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:13:00.27,0:13:02.90,Default,,0,0,0,,Сен артыңа қарайтын адам емессің.
Dialogue: 0,0:13:17.92,0:13:19.00,Default,,0,0,0,,Үлкен қуаныш
Dialogue: 0,0:13:19.50,0:13:20.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:21.59,0:13:24.80,Default,,0,0,0,,Ондай жерде жатсаң, ертең жаңғырық.
Dialogue: 0,0:13:25.42,0:13:26.09,Default,,0,0,0,,Иә
Dialogue: 0,0:13:28.22,0:13:31.60,Default,,0,0,0,,Енді Чинацу-сенпай түс көріп жатты.
Dialogue: 0,0:13:31.68,0:13:32.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:36.44,0:13:37.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:40.90,0:13:43.61,Default,,0,0,0,,Тіпті әріптердің де күші бар
Dialogue: 0,0:13:50.12,0:13:51.03,Default,,0,0,0,,Жарайды, үлкен қуаныш.
Dialogue: 0,0:13:52.33,0:13:54.25,Default,,0,0,0,,Менімен кездесу финалда.
Dialogue: 0,0:13:54.33,0:13:55.54,Default,,0,0,0,,Бұған дейін сіз
Dialogue: 0,0:13:55.62,0:13:58.42,Default,,0,0,0,,Мен жартылай финалда Хиодо мырзаны жеңуім керек.
Dialogue: 0,0:13:59.75,0:14:01.17,Default,,0,0,0,,Мен қоссайыста жеңіліп қалсам да...
Dialogue: 0,0:14:01.25,0:14:02.38,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:03.46,0:14:05.71,Default,,0,0,0,,Мен бар күшіммен жеңіске жетуге тырысамын
Dialogue: 0,0:14:06.47,0:14:07.88,Default,,0,0,0,,Бірінші тур
Dialogue: 0,0:14:08.93,0:14:10.59,Default,,0,0,0,,Қос ойында жеңілу
Dialogue: 0,0:14:10.68,0:14:14.35,Default,,0,0,0,,Мен оны Хиодо-санмен соғысқаннан кейін әлсірейді деп ойладым.
Dialogue: 0,0:14:15.22,0:14:16.64,Default,,0,0,0,,Қуанған сияқты.
Dialogue: 0,0:14:23.32,0:14:24.44,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:14:25.15,0:14:27.65,Default,,0,0,0,,Қарсылас елде биік тұрған мықты қарсылас болса да
Dialogue: 0,0:14:28.65,0:14:30.61,Default,,0,0,0,,Табандылық пен тістеу
Dialogue: 0,0:14:30.70,0:14:32.07,Default,,0,0,0,,Соңына дейін бар күшіңізді салыңыз
Dialogue: 0,0:14:33.70,0:14:37.91,Default,,0,0,0,,Чинацу-сенпайдың да осылай төбелесетініне сенімдімін.
Dialogue: 0,0:14:39.16,0:14:40.17,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:50.13,0:14:50.84,Default,,0,0,0,,В
Dialogue: 0,0:14:52.72,0:14:53.85,Default,,0,0,0,,Ойын
Dialogue: 0,0:14:54.43,0:14:57.77,Default,,0,0,0,,21-11 21-13
Dialogue: 0,0:14:58.93,0:15:01.77,Default,,0,0,0,,Сачигава орта мектебі Юса-кун
Dialogue: 0,0:15:08.57,0:15:12.45,Default,,0,0,0,,21-11 21-13 ойындар
Dialogue: 0,0:15:12.95,0:15:15.78,Default,,0,0,0,,Сачигава орта мектебі Юса-кун
Dialogue: 0,0:15:20.21,0:15:21.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:22.33,0:15:23.46,Default,,0,0,0,,Бітті ме?
Dialogue: 0,0:15:29.09,0:15:30.47,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:35.35,0:15:36.93,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:38.27,0:15:40.31,Default,,0,0,0,,Жеңімпаз, қол қойыңыз
Dialogue: 0,0:15:41.98,0:15:43.85,Default,,0,0,0,,Кейіпкерлер лас...
Dialogue: 0,0:15:48.61,0:15:53.24,Default,,0,0,0,,Аа, жеңілсек, төрелік етуіміз керек.
Dialogue: 0,0:15:57.58,0:15:58.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:59.54,0:16:00.83,Default,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:16:01.33,0:16:02.46,Default,,0,0,0,,Чоно мырза
Dialogue: 0,0:16:02.54,0:16:03.92,Default,,0,0,0,,Көркем гимнастика үйірмесі
Dialogue: 0,0:16:04.00,0:16:08.00,Default,,0,0,0,,Эй, Тадаши, әлі ойнайтын ойын бар, солай ма?
Dialogue: 0,0:16:08.09,0:16:10.17,Default,,0,0,0,,Әрбір блок үшін дөрекі күш сияқты
Dialogue: 0,0:16:10.26,0:16:12.63,Default,,0,0,0,,Үлкен қуаныш, қозғалтқыш әлі іске қосылмады.
Dialogue: 0,0:16:12.72,0:16:14.26,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:16:14.76,0:16:18.51,Default,,0,0,0,,Бірақ үлкен қуаныш, мен бар күшімді салдым.
Dialogue: 0,0:16:18.60,0:16:20.52,Default,,0,0,0,,Ойыншы болсаңыз, түсінесіз.
Dialogue: 0,0:16:21.52,0:16:23.14,Default,,0,0,0,,Турнир өткінші
Dialogue: 0,0:16:23.64,0:16:26.77,Default,,0,0,0,,Ойынды ойнай аласыз ба, жоқ па, бұл сіздің қабілетіңізге байланысты.
Dialogue: 0,0:16:27.27,0:16:31.03,Default,,0,0,0,,Сіз көп жұмыс істегендіктен бағаланбайсыз. Сіз көп жұмыс істегендіктен бағаланбайсыз.
Dialogue: 0,0:16:33.07,0:16:34.82,Default,,0,0,0,,Бұл спорт, солай ма?
Dialogue: 0,0:16:50.13,0:16:52.21,Default,,0,0,0,,Маған айқайлаңыз
Dialogue: 0,0:16:53.47,0:16:56.22,Default,,0,0,0,,Дарума-сан құлап қалса да, сен солай істейсің бе?
Dialogue: 0,0:16:58.18,0:17:01.14,Default,,0,0,0,,Мен ондай балалық әрекеттерге бармаймын.
Dialogue: 0,0:17:01.22,0:17:02.77,Default,,0,0,0,,Сіз мұны әрқашан жасайсыз, солай ма?
Dialogue: 0,0:17:02.85,0:17:05.19,Default,,0,0,0,,Бұлай айту дұрыс па?
Dialogue: 0,0:17:05.27,0:17:07.35,Default,,0,0,0,,Мен сенімен бірге алып келген болсам да.
Dialogue: 0,0:17:07.44,0:17:10.69,Default,,0,0,0,,Аа, сен мені шынымен бенто жасадың ба?
Dialogue: 0,0:17:13.28,0:17:14.11,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:14.19,0:17:17.82,Default,,0,0,0,,Мен солай ойладым, бірақ бұл тым көп әурешілік, сондықтан мен дүкеннен тәттілерді сатып алдым.
Dialogue: 0,0:17:17.91,0:17:19.45,Default,,0,0,0,,А, мен аман қалдым.
Dialogue: 0,0:17:19.53,0:17:21.12,Default,,0,0,0,,Жан тыныштығымен жеуге болады
Dialogue: 0,0:17:21.20,0:17:22.79,Default,,0,0,0,,Мен бірдеңе айттым ба?
Dialogue: 0,0:17:22.87,0:17:23.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:24.29,0:17:26.12,Default,,0,0,0,,Мен өзімді бақытты сезінемін
Dialogue: 0,0:17:28.71,0:17:31.46,Default,,0,0,0,,Оны әкелу үшін жолыңыздан шығып кеткеніңіз үшін кешіріңіз.
Dialogue: 0,0:17:33.21,0:17:34.76,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:17:43.14,0:17:45.64,Default,,0,0,0,,Адалдық, бұл менің қабілетім
Dialogue: 0,0:17:45.73,0:17:49.15,Default,,0,0,0,,Мен кейде Орта аралық мектеп қиын деп ойлайтынмын.
Dialogue: 0,0:17:49.65,0:17:52.19,Default,,0,0,0,,Мақсаттарыңыз жоғары болған сайын, көп еңбектенесіз.
Dialogue: 0,0:17:52.27,0:17:52.98,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:54.28,0:17:55.78,Default,,0,0,0,,Мақсатқа қарай
Dialogue: 0,0:17:55.86,0:17:58.49,Default,,0,0,0,,Қалай болғанда да, мен мұны істеуден басқа амалым жоқ сияқты сезінемін.
Dialogue: 0,0:17:59.49,0:18:02.08,Default,,0,0,0,,Менің ойымша, мен шынымен де жақсардым.
Dialogue: 0,0:18:02.58,0:18:05.00,Default,,0,0,0,,Мен Харю-сенпайды жеңгенімде.
Dialogue: 0,0:18:05.50,0:18:07.79,Default,,0,0,0,,Менің ойымша, мен шынымен де Inter-High-ке бара аламын деп ойлаймын.
Dialogue: 0,0:18:07.87,0:18:09.17,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:18:10.46,0:18:16.13,Default,,0,0,0,,Мүмкін бұл өзімді көре алмайтынымды білдіретін шығар.
Dialogue: 0,0:18:19.47,0:18:21.89,Default,,0,0,0,,Бұл дәмді. Мен оны келесі жолы сатып аламын.
Dialogue: 0,0:18:24.26,0:18:27.35,Default,,0,0,0,,Дәл солай, тек алға қара.
Dialogue: 0,0:18:27.43,0:18:32.02,Default,,0,0,0,,Даиджоның жақсы жағы - ол өте көп жұмыс істейді.
Dialogue: 0,0:18:38.28,0:18:40.53,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:45.29,0:18:49.21,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:18:50.33,0:18:53.21,Default,,0,0,0,,Өйткені, биылғы жеңімпаз Сачикава болады.
Dialogue: 0,0:18:53.75,0:18:56.46,Default,,0,0,0,,Хиодо-кун тым күшті болды.
Dialogue: 0,0:18:58.55,0:19:00.59,Default,,0,0,0,,Харю-кун да жақсы күресті.
Dialogue: 0,0:19:00.68,0:19:03.55,Default,,0,0,0,,Мен екінші курста орта мектеп аралық оқуға қатысуды шештім.
Dialogue: 0,0:19:03.64,0:19:07.22,Default,,0,0,0,,Хиодо келесі жылы зейнеткерлікке шыққанда, ол жоғарыда болады.
Dialogue: 0,0:19:07.31,0:19:11.60,Default,,0,0,0,,Бірақ келесі жылы Сачигавадан келген Юсаны асыға күтуге болады.
Dialogue: 0,0:19:11.69,0:19:15.73,Default,,0,0,0,,Осы турнирде Хиододан жеңіліп қалсам да, мен өте жақсы кездесу өткіздім.
Dialogue: 0,0:19:16.53,0:19:18.74,Default,,0,0,0,,Мен болашаққа үмітпен қараймын.
Dialogue: 0,0:19:25.83,0:19:26.83,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:34.46,0:19:35.25,Default,,0,0,0,,Ойын
Dialogue: 0,0:19:35.84,0:19:39.21,Default,,0,0,0,,Жеңімпаз: Сачигава орта мектебінен келген Хиодо
Dialogue: 0,0:19:39.30,0:19:42.43,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:19:45.85,0:19:48.97,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:57.86,0:20:02.36,Default,,0,0,0,,Мен сені Интер-Хайда құртамын...
Dialogue: 0,0:20:02.86,0:20:05.28,Default,,0,0,0,,Ол екінші орын алса да, сол бет
Dialogue: 0,0:20:05.37,0:20:07.41,Default,,0,0,0,,Менің ойымша, сіз Хиодо мырзадан жеңілгеніңізге өкінетін шығарсыз.
Dialogue: 0,0:20:07.49,0:20:08.54,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:08.62,0:20:10.37,Default,,0,0,0,,Жүр, тамақ ішейік!
Dialogue: 0,0:20:10.87,0:20:12.79,Default,,0,0,0,,Бұл үлкен қуаныш па?
Dialogue: 0,0:20:13.29,0:20:15.79,Default,,0,0,0,,Мен сені өзіммен бірге алып кетуді шештім...
Dialogue: 0,0:20:15.88,0:20:17.34,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:20:17.42,0:20:19.05,Default,,0,0,0,,Ол бұрын ойысқан болуы керек.
Dialogue: 0,0:20:19.63,0:20:21.38,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:28.22,0:20:30.56,Default,,0,0,0,,Мен мәңгілік күйзелісте қала алмаймын.
Dialogue: 0,0:20:30.64,0:20:33.31,Default,,0,0,0,,Ауысып, қатты жаттығу жасайық
Dialogue: 0,0:20:34.10,0:20:36.31,Default,,0,0,0,,Әрекет етуді үйреніңіз
Dialogue: 0,0:20:37.65,0:20:39.65,Default,,0,0,0,,Ал келесі жылы бар күшімізді салайық
Dialogue: 0,0:20:41.53,0:20:43.57,Default,,0,0,0,,Ол тек бірінші курс студенті.
Dialogue: 0,0:20:43.65,0:20:46.45,Default,,0,0,0,,Тағы екі мүмкіндік бар.
Dialogue: 0,0:20:48.62,0:20:50.91,Default,,0,0,0,,Чинацу-сенпай болмаса да...
Dialogue: 0,0:20:54.67,0:20:57.79,Default,,0,0,0,,Ей, сен қатты тырысып жатырсың.
Dialogue: 0,0:20:57.88,0:20:58.59,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:20:59.17,0:21:01.92,Default,,0,0,0,,Мен де бақыттымын
Dialogue: 0,0:21:02.01,0:21:04.59,Default,,0,0,0,,Хаа... Мен сені қатты жақсы көремін
Dialogue: 0,0:21:04.68,0:21:06.97,Default,,0,0,0,,Мен Интер-Хайға дейін күшейуім керек.
Dialogue: 0,0:21:07.05,0:21:08.47,Default,,0,0,0,,Бүгін бізде мереке бар.
Dialogue: 0,0:21:08.55,0:21:10.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:11.39,0:21:12.60,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:14.35,0:21:16.94,Default,,0,0,0,,Чинацу-сенпай Мен Интер-Хайға баруды шештім.
Dialogue: 0,0:21:17.44,0:21:18.73,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:21:19.23,0:21:20.44,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:21.44,0:21:24.65,Default,,0,0,0,,Керемет, Керемет
Dialogue: 0,0:21:24.74,0:21:26.78,Default,,0,0,0,,Мен сенің айтқаныңды орындаймын.
Dialogue: 0,0:21:27.28,0:21:28.91,Default,,0,0,0,,Тым салқын
Dialogue: 0,0:21:34.50,0:21:35.62,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:21:38.00,0:21:39.13,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:21:39.96,0:21:41.92,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:21:42.00,0:21:43.13,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:21:46.97,0:21:48.01,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:21:57.73,0:21:59.27,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.37,0:23:35.37,Default,,0,0,0,,~♪
Dialogue: 0,0:23:36.87,0:23:42.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory