Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.46,0:00:04.83,Default,,0,0,0,,Күндізгі ауысымда кешігіп қалдым.
Dialogue: 0,0:00:04.92,0:00:07.29,Default,,0,0,0,,Аккун, сен әлі ойнайсың ба?
Dialogue: 0,0:00:08.42,0:00:09.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:09.34,0:00:11.30,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:11.88,0:00:13.17,Default,,0,0,0,,- Ұсталды! -Уау
Dialogue: 0,0:00:13.26,0:00:15.89,Default,,0,0,0,,Бұл сексуалды әйел кім?
Dialogue: 0,0:00:15.97,0:00:18.72,Default,,0,0,0,,Мен Ауа отбасын тойтардым деп ойлаған кезде
Dialogue: 0,0:00:18.81,0:00:21.35,Default,,0,0,0,,Жаман әйел тағы да ұстады...
Dialogue: 0,0:00:21.43,0:00:24.69,Default,,0,0,0,,Ей, эротикалық әйел, не істеп жатырсың!
Dialogue: 0,0:00:24.77,0:00:28.65,Default,,0,0,0,,Футаба, сізді таныстыруға рұқсат етіңіз. Бұл адам Идатен.
Dialogue: 0,0:00:28.73,0:00:29.86,Default,,0,0,0,,Лорд Идатен?
Dialogue: 0,0:00:29.94,0:00:32.24,Default,,0,0,0,,- Аяқ тым жылдам! -Тамаша, керемет!
Dialogue: 0,0:00:32.32,0:00:33.70,Default,,0,0,0,,Кейдоро өте күшті...
Dialogue: 0,0:00:33.78,0:00:35.28,Default,,0,0,0,,Аккун, үндеме!
Dialogue: 0,0:00:35.36,0:00:39.37,Default,,0,0,0,,Мынау шотакон эротикалық әйел, Дорокеймен ұрыс!
Dialogue: 0,0:00:39.45,0:00:41.37,Default,,0,0,0,,Шота? Эротикалық?
Dialogue: 0,0:00:41.45,0:00:43.71,Default,,0,0,0,,-Бұл Кейдоро, солай ма? -Аккун, үндеме.
Dialogue: 0,0:00:43.79,0:00:46.08,Default,,0,0,0,,Енді мұны істейсіз бе? Неге жасамайсың?
Dialogue: 0,0:00:46.17,0:00:49.71,Default,,0,0,0,,Жарайды, мен сені бірден ұстаймын.
Dialogue: 0,0:00:49.79,0:00:51.17,Default,,0,0,0,,Барк!
Dialogue: 0,0:00:51.25,0:00:52.55,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:00:52.63,0:00:55.51,Default,,0,0,0,,Ал, бастайық!
Dialogue: 0,0:00:55.59,0:00:58.47,Default,,0,0,0,,(Рику күледі)
Dialogue: 0,0:00:58.55,0:00:59.80,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:01:01.35,0:01:02.72,Default,,0,0,0,,- Хи хи хи... - Уф...
Dialogue: 0,0:01:02.81,0:01:04.18,Default,,0,0,0,,Футаба!
Dialogue: 0,0:01:04.27,0:01:05.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:07.69,0:01:10.61,Default,,0,0,0,,Сіз өте жақсы жұмыс істеп жатырсыз.
Dialogue: 0,0:01:10.69,0:01:12.32,Default,,0,0,0,,Эротикалық әйелдер де
Dialogue: 0,0:01:12.40,0:01:14.74,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:14.82,0:01:15.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:16.74,0:01:20.12,Default,,0,0,0,,Мен Рику Таманаха Рикумын.
Dialogue: 0,0:01:25.25,0:01:27.75,Default,,0,0,0,,Мен Футабамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:01:27.83,0:01:30.71,Default,,0,0,0,,Иә! Танысқаныма қуаныштымын Футабачин
Dialogue: 0,0:01:31.38,0:01:33.80,Default,,0,0,0,,Ах-чанның жігіті бар!
Dialogue: 0,0:01:33.88,0:01:37.05,Default,,0,0,0,,Сен Ақкунмен және басқалармен ойнадың ба?
Dialogue: 0,0:01:37.13,0:01:38.26,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:38.34,0:01:40.14,Default,,0,0,0,,- Иә? - Аха патша!
Dialogue: 0,0:01:40.22,0:01:41.39,Default,,0,0,0,,Келдің!
Dialogue: 0,0:01:41.47,0:01:43.64,Default,,0,0,0,,Ендеше бірге ойнайық
Dialogue: 0,0:01:43.72,0:01:45.39,Default,,0,0,0,,-Сіз таныссыз ба? -Иә
Dialogue: 0,0:01:46.02,0:01:48.10,Default,,0,0,0,,Тама-чан да.
Dialogue: 0,0:01:48.19,0:01:50.61,Default,,0,0,0,,Уау... Иә!
Dialogue: 0,0:01:50.69,0:01:53.57,Default,,0,0,0,,(дауыс ойнату)
Dialogue: 0,0:01:55.99,0:01:58.15,Default,,0,0,0,,-Аккун мен ұстадым! -Уау
Dialogue: 0,0:01:58.24,0:02:01.62,Default,,0,0,0,,Бұл эротикалық әйелдің жауы ғой!
Dialogue: 0,0:02:02.99,0:02:08.00,Default,,0,0,0,,♪～
Dialogue: 0,0:03:27.66,0:03:31.66,Default,,0,0,0,,～♪
Dialogue: 0,0:03:33.00,0:03:34.38,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:34.96,0:03:37.09,Default,,0,0,0,,Бүгін тағы кезекшілікте болдым, сондықтан кешігіп қалдым.
Dialogue: 0,0:03:37.17,0:03:39.55,Default,,0,0,0,,Аккун, сен әлі осындасың ба?
Dialogue: 0,0:03:40.67,0:03:41.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:43.59,0:03:47.22,Default,,0,0,0,,Бұл жолы күмән жоқ
Dialogue: 0,0:03:47.31,0:03:51.56,Default,,0,0,0,,Авамен мен ақыры Аккунға қолымды қойдым.
Dialogue: 0,0:03:52.56,0:03:54.94,Default,,0,0,0,,Аваны өзіңізбен бірге алыңыз!
Dialogue: 0,0:03:55.02,0:03:56.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:56.31,0:03:59.57,Default,,0,0,0,,Мм... сен Авамен бірге емессің бе?
Dialogue: 0,0:03:59.65,0:04:02.90,Default,,0,0,0,,Сіз Рейна-ниді де танисыз ба?
Dialogue: 0,0:04:02.99,0:04:05.53,Default,,0,0,0,,Е... иә, жақсы
Dialogue: 0,0:04:06.12,0:04:10.04,Default,,0,0,0,,Бұл сіз Ава екеуіңіз ағайынды екенсіздер ме?
Dialogue: 0,0:04:10.12,0:04:12.16,Default,,0,0,0,,Иә, олар ағайынды!
Dialogue: 0,0:04:12.25,0:04:15.12,Default,,0,0,0,,Футаба, бұл адам Ура Хаусу.
Dialogue: 0,0:04:15.21,0:04:16.75,Default,,0,0,0,,Ураха патшасы?
Dialogue: 0,0:04:16.83,0:04:19.67,Default,,0,0,0,,Аха патшаның тағы бір тұлғасының болуы!
Dialogue: 0,0:04:19.75,0:04:21.71,Default,,0,0,0,,Сонымен олардың статусы бірдей!
Dialogue: 0,0:04:21.80,0:04:26.68,Default,,0,0,0,,Сонымен қатар, палуба өте күшті болды, сондықтан мен оны палубаға қарауды тапсырдым.
Dialogue: 0,0:04:26.76,0:04:30.14,Default,,0,0,0,,А... Бұл үшін рахмет.
Dialogue: 0,0:04:30.22,0:04:32.43,Default,,0,0,0,,Сіздің атыңыз Футаба-чан?
Dialogue: 0,0:04:33.14,0:04:34.23,Default,,0,0,0,,Бірге ойнайық!
Dialogue: 0,0:04:34.31,0:04:35.14,Default,,0,0,0,,А...
Dialogue: 0,0:04:36.27,0:04:37.94,Default,,0,0,0,,Маған бәрібір, бірақ
Dialogue: 0,0:04:38.02,0:04:42.11,Default,,0,0,0,,Шынымен бе? Алақай! Футаба-чанға рахмет
Dialogue: 0,0:04:42.19,0:04:45.53,Default,,0,0,0,,Мына бала қатты келеді
Dialogue: 0,0:04:45.61,0:04:48.24,Default,,0,0,0,,Мен мұндай азғыруларға қарсы тұра алмаймын...
Dialogue: 0,0:04:48.32,0:04:49.83,Default,,0,0,0,,Сіз не ойнайсыз?
Dialogue: 0,0:04:49.91,0:04:51.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:51.16,0:04:53.04,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:04:53.12,0:04:55.87,Default,,0,0,0,,Егер сіз оны ұстай алсаңыз, оны ұстап көріңіз.
Dialogue: 0,0:04:55.96,0:04:56.83,Default,,0,0,0,,Қақпақ…
Dialogue: 0,0:04:56.92,0:04:58.50,Default,,0,0,0,,Ұстадым!
Dialogue: 0,0:04:58.58,0:05:01.17,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:05:02.01,0:05:05.01,Default,,0,0,0,,Бұл қызық болды.
Dialogue: 0,0:05:05.09,0:05:06.88,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:05:07.76,0:05:08.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:08.68,0:05:11.60,Default,,0,0,0,,Рейна-ни Райду-ни!
Dialogue: 0,0:05:11.68,0:05:13.18,Default,,0,0,0,,Патша Аха!
Dialogue: 0,0:05:13.27,0:05:16.19,Default,,0,0,0,,Мен Футаба-чан мен Аккунмен ойнадым.
Dialogue: 0,0:05:17.69,0:05:22.73,Default,,0,0,0,,Екеуіңе де ағаммен ойнағандарыңа рахмет.
Dialogue: 0,0:05:22.82,0:05:24.44,Default,,0,0,0,,Әй... інім бе?
Dialogue: 0,0:05:24.53,0:05:27.32,Default,,0,0,0,,Сіз ұл болдыңыз ба?
Dialogue: 0,0:05:27.41,0:05:29.03,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:05:29.12,0:05:30.58,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:30.66,0:05:32.49,Default,,0,0,0,,Не?
Dialogue: 0,0:05:32.58,0:05:34.50,Default,,0,0,0,,Сонда Аккун жақсы болады.
Dialogue: 0,0:05:34.58,0:05:36.46,Default,,0,0,0,,Бүгінгі күн үшін рахмет.
Dialogue: 0,0:05:36.54,0:05:37.92,Default,,0,0,0,,Тығыз!
Dialogue: 0,0:05:38.00,0:05:39.96,Default,,0,0,0,,Қайтадан ойнайық
Dialogue: 0,0:05:40.04,0:05:42.17,Default,,0,0,0,,Е... иә, әрине.
Dialogue: 0,0:05:43.92,0:05:46.59,Default,,0,0,0,,Аккун, қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:05:46.67,0:05:48.38,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:05:49.09,0:05:50.60,Default,,0,0,0,,Ава Торен
Dialogue: 0,0:05:51.18,0:05:52.56,Default,,0,0,0,,Өйткені, бұл жау!
Dialogue: 0,0:05:55.18,0:05:58.06,Default,,0,0,0,,Сіз... Король, кетіңіз!
Dialogue: 0,0:05:58.90,0:06:00.31,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:06:00.40,0:06:02.77,Default,,0,0,0,,Жарайды, жақсы, қалайсың?
Dialogue: 0,0:06:02.86,0:06:04.53,Default,,0,0,0,,Аха патша...
Dialogue: 0,0:06:04.61,0:06:06.40,Default,,0,0,0,,Аха патша?
Dialogue: 0,0:06:06.99,0:06:08.36,Default,,0,0,0,,Бұрынғыдан да көп...
Dialogue: 0,0:06:08.45,0:06:10.16,Default,,0,0,0,,Бүгін қысым күшті!
Dialogue: 0,0:06:10.24,0:06:12.41,Default,,0,0,0,,Төтенше жиналыс~!
Dialogue: 0,0:06:12.49,0:06:14.45,Default,,0,0,0,,Төраға, мынау несі...
Dialogue: 0,0:06:14.54,0:06:15.37,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:06:15.45,0:06:16.95,Default,,0,0,0,,Мм, мен...
Dialogue: 0,0:06:17.04,0:06:18.54,Default,,0,0,0,,Кешіріңіз, мен жиналыстамын.
Dialogue: 0,0:06:18.62,0:06:19.46,Default,,0,0,0,,Иә
Dialogue: 0,0:06:20.50,0:06:22.92,Default,,0,0,0,,Күткеніңіз үшін рахмет, Синха патша!
Dialogue: 0,0:06:23.00,0:06:25.76,Default,,0,0,0,,Синха патша? Жоқ, мен...
Dialogue: 0,0:06:25.84,0:06:27.26,Default,,0,0,0,,Мен айтпай-ақ түсінемін.
Dialogue: 0,0:06:27.34,0:06:31.22,Default,,0,0,0,,Оның қалыпты сыртқы түрі ұйымның кішірейтілген түрі.
Dialogue: 0,0:06:31.30,0:06:33.14,Default,,0,0,0,,Енді сіздің шынайы формаңыз!
Dialogue: 0,0:06:33.22,0:06:36.64,Default,,0,0,0,,Бұл балалар Рейна айтқан бастауыш сынып оқушылары.
Dialogue: 0,0:06:37.43,0:06:38.27,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:06:38.35,0:06:40.27,Default,,0,0,0,,Күте тұрыңыз, Синха патша!
Dialogue: 0,0:06:40.35,0:06:43.98,Default,,0,0,0,,Бізге скейтборд тебуді үйретіңізші!
Dialogue: 0,0:06:44.07,0:06:45.27,Default,,0,0,0,,Скейтбординг?
Dialogue: 0,0:06:45.36,0:06:47.57,Default,,0,0,0,,Иә, мен жақсы міне алмаймын...
Dialogue: 0,0:06:47.65,0:06:51.91,Default,,0,0,0,,Бұл Рейнаның бетін сақтап қалу үшін қолыңнан келмейтін нәрсе.
Dialogue: 0,0:06:52.62,0:06:55.45,Default,,0,0,0,,Тек... сәл ғана.
Dialogue: 0,0:06:55.54,0:06:57.12,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:07:02.29,0:07:03.46,Default,,0,0,0,,Сонымен
Dialogue: 0,0:07:04.75,0:07:06.34,Default,,0,0,0,,(Эруганың құлаған дыбысы)
Dialogue: 0,0:07:08.92,0:07:12.30,Default,,0,0,0,,...Кенеттен мінсең, мынандай болады.
Dialogue: 0,0:07:12.39,0:07:16.01,Default,,0,0,0,,Алдымен тепе-теңдікті сақтау үшін тұтқадан ұстаңыз.
Dialogue: 0,0:07:16.10,0:07:17.39,Default,,0,0,0,,Және…
Dialogue: 0,0:07:18.56,0:07:20.18,Default,,0,0,0,,(Эруганың құлаған дыбысы)
Dialogue: 0,0:07:23.44,0:07:26.32,Default,,0,0,0,,Бұлай кенеттен жүру қауіпті.
Dialogue: 0,0:07:28.86,0:07:31.95,Default,,0,0,0,,Алдымен мініп-түсуді жаттықтырудан бастаңыз.
Dialogue: 0,0:07:32.03,0:07:35.62,Default,,0,0,0,,Шыдамсыз болмаңыз. Баяу жаттығыңыз.
Dialogue: 0,0:07:35.70,0:07:36.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:37.49,0:07:39.95,Default,,0,0,0,,Мен сізге келесі жолы айтамын.
Dialogue: 0,0:07:40.04,0:07:41.71,Default,,0,0,0,,Оған дейін бар күшіңізді салыңыз.
Dialogue: 0,0:07:41.79,0:07:44.04,Default,,0,0,0,,Иә, Синха патша!
Dialogue: 0,0:07:44.13,0:07:45.67,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:07:50.26,0:07:51.51,Default,,0,0,0,,Я...
Dialogue: 0,0:07:51.59,0:07:53.18,Default,,0,0,0,,Тағы бір сәтсіздік
Dialogue: 0,0:07:53.26,0:07:56.68,Default,,0,0,0,,Мен Рейнаның орнындамын ғой...
Dialogue: 0,0:07:58.51,0:07:59.47,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:59.56,0:08:03.35,Default,,0,0,0,,Мен Рейнаның беделін түсірмеу үшін оның орнын алуым керек.
Dialogue: 0,0:08:03.44,0:08:04.40,Default,,0,0,0,,Әлсіреп қалма — жолды бөгеп тұрсың.
Dialogue: 0,0:08:04.48,0:08:07.40,Default,,0,0,0,,Скейтбордингті бастадыңыз ба?
Dialogue: 0,0:08:07.48,0:08:09.44,Default,,0,0,0,,Ал... иә
Dialogue: 0,0:08:09.53,0:08:11.65,Default,,0,0,0,,Жаттығу Сізге көмектесе аламын ба?
Dialogue: 0,0:08:11.74,0:08:14.24,Default,,0,0,0,,Ренге де көмектесейік! Бірге жасайық!
Dialogue: 0,0:08:16.28,0:08:18.20,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:24.00,0:08:25.21,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:08:26.08,0:08:27.71,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:08:33.84,0:08:34.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:39.68,0:08:43.31,Default,,0,0,0,,Уф... Ақыры аздап атқа мініп кеттім.
Dialogue: 0,0:08:43.39,0:08:45.06,Default,,0,0,0,,Синха патша!
Dialogue: 0,0:08:45.65,0:08:47.81,Default,,0,0,0,,Келесі жолы маған бесікті үйретіңізші!
Dialogue: 0,0:08:51.82,0:08:56.70,Default,,0,0,0,,Ақкүн сияқты ұлдардың арасында бесікке бөлеу деген бар сияқты.
Dialogue: 0,0:08:56.78,0:08:59.20,Default,,0,0,0,,Бесік болса, менің де қолымнан келеді.
Dialogue: 0,0:08:59.78,0:09:01.99,Default,,0,0,0,,Ақкүнге өнеріңді көрсет
Dialogue: 0,0:09:02.08,0:09:04.46,Default,,0,0,0,,Өйткені «Маған айт» деп айту керек.
Dialogue: 0,0:09:10.54,0:09:11.67,Default,,0,0,0,,Дегенмен, Шусамару…
Dialogue: 0,0:09:11.75,0:09:15.55,Default,,0,0,0,,Авамен бірге мен Аккунды тағы да елестетемін...
Dialogue: 0,0:09:15.63,0:09:17.93,Default,,0,0,0,,Өйткені, сен жаусың!
Dialogue: 0,0:09:18.01,0:09:20.47,Default,,0,0,0,,Аваны өзіңізбен бірге алыңыз!
Dialogue: 0,0:09:21.39,0:09:23.22,Default,,0,0,0,,Эй, сен ше?
Dialogue: 0,0:09:23.89,0:09:26.44,Default,,0,0,0,,Бұл адам Аваның қасында емес.
Dialogue: 0,0:09:26.52,0:09:30.44,Default,,0,0,0,,Оның үстіне бұл тыныш атмосфера...
Dialogue: 0,0:09:31.02,0:09:33.40,Default,,0,0,0,,Жалған Рейна, айбатты жау!
Dialogue: 0,0:09:33.48,0:09:37.61,Default,,0,0,0,,Футаба: Сен де Шинха патшадан сабақ алуға келдің бе?
Dialogue: 0,0:09:37.70,0:09:40.53,Default,,0,0,0,,Ал, олай емес...
Dialogue: 0,0:09:41.49,0:09:44.00,Default,,0,0,0,,Бұл бала да Рейнаның досы
Dialogue: 0,0:09:44.08,0:09:44.66,Default,,0,0,0,,Онда сен мұнда не үшін келдің?
Dialogue: 0,0:09:44.66,0:09:45.66,Default,,0,0,0,,Онда сен мұнда не үшін келдің?
Dialogue: 0,0:09:44.66,0:09:45.66,Default,,0,0,0,,Мен шынымен де көп адамдарды білемін...
Dialogue: 0,0:09:45.66,0:09:45.75,Default,,0,0,0,,Мен шынымен де көп адамдарды білемін...
Dialogue: 0,0:09:45.75,0:09:46.75,Default,,0,0,0,,Мен шынымен де көп адамдарды білемін...
Dialogue: 0,0:09:45.75,0:09:46.75,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:09:46.75,0:09:46.83,Default,,0,0,0,,Мен шынымен де көп адамдарды білемін...
Dialogue: 0,0:09:46.83,0:09:47.37,Default,,0,0,0,,Мен шынымен де көп адамдарды білемін...
Dialogue: 0,0:09:46.83,0:09:47.37,Default,,0,0,0,,Мен сені бесікке салуға келдім.
Dialogue: 0,0:09:47.37,0:09:48.67,Default,,0,0,0,,Мен сені бесікке бөлейін деп келдім.
Dialogue: 0,0:09:48.67,0:09:49.25,Default,,0,0,0,,Мен жаңа ғана сені бесікке бөлейін деп келдім.
Dialogue: 0,0:09:48.67,0:09:49.25,Default,,0,0,0,,Мен де айтайын ба?
Dialogue: 0,0:09:49.25,0:09:50.75,Default,,0,0,0,,Мен де айтайын ба?
Dialogue: 0,0:09:54.34,0:09:57.22,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:09:57.30,0:09:58.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:03.51,0:10:04.85,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:10:04.93,0:10:06.64,Default,,0,0,0,,Күрделі…
Dialogue: 0,0:10:06.73,0:10:07.94,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:08.02,0:10:09.90,Default,,0,0,0,,Сіз кеше...
Dialogue: 0,0:10:09.98,0:10:12.27,Default,,0,0,0,,Не... ол не үшін?
Dialogue: 0,0:10:13.94,0:10:16.15,Default,,0,0,0,,Егер мұны осы жерде орындасаңыз
Dialogue: 0,0:10:16.24,0:10:17.32,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:17.40,0:10:19.70,Default,,0,0,0,,Мен ештеңе сұраған жоқпын!
Dialogue: 0,0:10:19.78,0:10:20.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.32,0:10:22.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:23.03,0:10:26.37,Default,,0,0,0,,Әй... ақыры маған айтыңызшы.
Dialogue: 0,0:10:27.71,0:10:28.71,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:10:29.67,0:10:32.63,Default,,0,0,0,,Осылайша...
Dialogue: 0,0:10:32.71,0:10:33.54,Default,,0,0,0,,Иә
Dialogue: 0,0:10:36.17,0:10:37.17,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:10:38.09,0:10:39.59,Default,,0,0,0,,Дайын!
Dialogue: 0,0:10:41.18,0:10:44.43,Default,,0,0,0,,Сіз одан да қиын істер жасай аласыз.
Dialogue: 0,0:10:45.06,0:10:46.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:48.68,0:10:49.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:51.10,0:10:52.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:54.27,0:10:55.94,Default,,0,0,0,,-Ух -Уау!
Dialogue: 0,0:10:56.73,0:10:58.78,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:59.57,0:11:01.57,Default,,0,0,0,,-Хухун -Ох~
Dialogue: 0,0:11:07.16,0:11:09.75,Default,,0,0,0,,Сәл ерте, бірақ сен осындасың ба?
Dialogue: 0,0:11:10.71,0:11:11.71,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:11:11.79,0:11:15.17,Default,,0,0,0,,Сіз... жаттығып жатырсыз ба?
Dialogue: 0,0:11:15.92,0:11:17.25,Default,,0,0,0,,Футаба-сан
Dialogue: 0,0:11:17.34,0:11:21.68,Default,,0,0,0,,Иә, әлі есте қалатын дүниелер көп.
Dialogue: 0,0:11:21.76,0:11:22.72,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:11:23.30,0:11:24.72,Default,,0,0,0,,Эй, жалған Рейна
Dialogue: 0,0:11:25.55,0:11:27.47,Default,,0,0,0,,Маған атыңды айтатын кез келді.
Dialogue: 0,0:11:27.56,0:11:28.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.48,0:11:33.35,Default,,0,0,0,,Кешіріңіз, көңілім қалған болуы керек.
Dialogue: 0,0:11:33.44,0:11:34.36,Default,,0,0,0,,Не?
Dialogue: 0,0:11:35.23,0:11:36.86,Default,,0,0,0,,Мен әпкемнің...
Dialogue: 0,0:11:37.48,0:11:40.36,Default,,0,0,0,,Мен Рейнаның орнын толтыра алмадым.
Dialogue: 0,0:11:40.44,0:11:42.03,Default,,0,0,0,,Ауыстыру?
Dialogue: 0,0:11:42.11,0:11:43.11,Default,,0,0,0,,Иә
Dialogue: 0,0:11:43.20,0:11:46.28,Default,,0,0,0,,Сіз мұны істей алмайтыныңызға сенімдімін.
Dialogue: 0,0:11:46.87,0:11:50.37,Default,,0,0,0,,Рейна, Рейна, сен сенсің.
Dialogue: 0,0:11:53.71,0:11:56.38,Default,,0,0,0,,Мен Рейнаның орнын толтырушы емеспін.
Dialogue: 0,0:11:56.46,0:11:58.63,Default,,0,0,0,,Мен сенің досыңмын
Dialogue: 0,0:11:58.71,0:11:59.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:59.92,0:12:02.51,Default,,0,0,0,,Маған атыңызды айтыңыз.
Dialogue: 0,0:12:02.59,0:12:05.59,Default,,0,0,0,,Ах... мен Ава Ренмін
Dialogue: 0,0:12:05.68,0:12:07.10,Default,,0,0,0,,Мені Еру деп атаңыз
Dialogue: 0,0:12:07.68,0:12:09.56,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:12:11.35,0:12:15.31,Default,,0,0,0,,Бол... Мен біртүрлі ештеңе айтқым келмейді...
Dialogue: 0,0:12:15.40,0:12:17.52,Default,,0,0,0,,Хе, рахмет
Dialogue: 0,0:12:17.61,0:12:18.65,Default,,0,0,0,,Және...
Dialogue: 0,0:12:18.73,0:12:20.74,Default,,0,0,0,,-Сәлем! -(Эру/Футаба) Ах...
Dialogue: 0,0:12:20.82,0:12:22.45,Default,,0,0,0,,Король Шинха!
Dialogue: 0,0:12:23.03,0:12:25.16,Default,,0,0,0,,Бүгін маған арқанмен секіруді үйретіңізші!
Dialogue: 0,0:12:25.74,0:12:27.49,Default,,0,0,0,,Әй, Футаба!
Dialogue: 0,0:12:27.58,0:12:30.04,Default,,0,0,0,,Синха патшамен жеке жаттығу?
Dialogue: 0,0:12:30.12,0:12:31.25,Default,,0,0,0,,Мен де, өтінемін!
Dialogue: 0,0:12:31.33,0:12:32.62,Default,,0,0,0,,-Мен де! -Мен де!
Dialogue: 0,0:12:33.21,0:12:36.50,Default,,0,0,0,,Мен ғана емес, бәрі де солай ойлайды.
Dialogue: 0,0:12:37.92,0:12:40.84,Default,,0,0,0,,Олай болса бәріміз арқанмен секірейік.
Dialogue: 0,0:12:40.92,0:12:41.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:42.72,0:12:43.76,Default,,0,0,0,,Миссия үшін,
Dialogue: 0,0:12:43.84,0:12:46.72,Default,,0,0,0,,Кенеттен арқанмен секіру қауіпті.
Dialogue: 0,0:12:47.60,0:12:48.55,Default,,0,0,0,,Ах
Dialogue: 0,0:12:51.02,0:12:52.98,Default,,0,0,0,,Ава Ренеру…
Dialogue: 0,0:12:53.06,0:12:54.89,Default,,0,0,0,,Ол жау!
Dialogue: 0,0:13:01.23,0:13:03.94,Default,,0,0,0,,Қайырлы таң, түсіндім.
Dialogue: 0,0:13:04.03,0:13:06.07,Default,,0,0,0,,Қайырлы таң Рен
Dialogue: 0,0:13:07.95,0:13:10.33,Default,,0,0,0,,Қайырлы таң Рейна
Dialogue: 0,0:13:10.41,0:13:12.16,Default,,0,0,0,,Екеуіңізге қайырлы таң.
Dialogue: 0,0:13:12.24,0:13:13.45,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:13.54,0:13:14.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:17.21,0:13:20.09,Default,,0,0,0,,Таңертеңнен бері осындай тамаша...
Dialogue: 0,0:13:20.17,0:13:23.55,Default,,0,0,0,,Сіз түскі ас қорапшасын жасап жатсаңыз, бәрібір.
Dialogue: 0,0:13:24.13,0:13:25.13,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:13:26.34,0:13:28.97,Default,,0,0,0,,Мен Реннің киімін шығардым.
Dialogue: 0,0:13:29.68,0:13:32.43,Default,,0,0,0,,Ерудің формасы да үтіктелген.
Dialogue: 0,0:13:33.18,0:13:35.39,Default,,0,0,0,,Рахмет, бірақ...
Dialogue: 0,0:13:35.48,0:13:37.10,Default,,0,0,0,,Ах... Еру
Dialogue: 0,0:13:39.98,0:13:41.82,Default,,0,0,0,,Ұйықтау әдеті
Dialogue: 0,0:13:42.57,0:13:44.28,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:13:44.86,0:13:46.74,Default,,0,0,0,,Мен де кірпішті жөндей аламын.
Dialogue: 0,0:13:46.82,0:13:47.70,Default,,0,0,0,,Иә
Dialogue: 0,0:13:48.32,0:13:51.45,Default,,0,0,0,,Рейна, сен әрқашан кереметсің.
Dialogue: 0,0:13:51.53,0:13:52.41,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:52.49,0:13:55.58,Default,,0,0,0,,Дұрыс, сізде перзенттік қасиет жоқ па?
Dialogue: 0,0:13:55.66,0:13:57.21,Default,,0,0,0,,Ей, перзенттік имандылық?
Dialogue: 0,0:13:58.62,0:13:59.67,Default,,0,0,0,,Бұл сәл ақымақтық емес пе?
Dialogue: 0,0:14:00.25,0:14:03.42,Default,,0,0,0,,Рейнаға менің тәуелсіз екенімді көрсетіңіз
Dialogue: 0,0:14:03.50,0:14:05.67,Default,,0,0,0,,Менің әпкемді бөлуге мүмкіндік
Dialogue: 0,0:14:06.26,0:14:08.76,Default,,0,0,0,,Иә, мен сізге әрқашан қарыздармын.
Dialogue: 0,0:14:08.84,0:14:10.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:14.14,0:14:17.56,Default,,0,0,0,,Олай болса... мұнда неге келдің?
Dialogue: 0,0:14:17.64,0:14:19.44,Default,,0,0,0,,Мен сізге қоңырау шалдым.
Dialogue: 0,0:14:19.52,0:14:23.11,Default,,0,0,0,,Райдо нені ұнатады?
Dialogue: 0,0:14:23.19,0:14:25.78,Default,,0,0,0,,Мен рахмет ретінде жақсы нәрсе білемін деп ойладым.
Dialogue: 0,0:14:25.86,0:14:28.32,Default,,0,0,0,,Бұл екі адам Ахарен мырзаға жасырын айтып жатыр.
Dialogue: 0,0:14:28.40,0:14:30.74,Default,,0,0,0,,Сіз өзіңіздің күнделікті алғысыңыз туралы ойлайсыз ба?
Dialogue: 0,0:14:30.82,0:14:32.66,Default,,0,0,0,,Үй меңгерушісі
Dialogue: 0,0:14:33.24,0:14:34.62,Default,,0,0,0,,Қан заңы
Dialogue: 0,0:14:34.70,0:14:37.54,Default,,0,0,0,,Еуропалық мафиялар отбасына қосылғанда немен алмасады—
Dialogue: 0,0:14:37.62,0:14:39.50,Default,,0,0,0,,Пентито деп аталатын салт
Dialogue: 0,0:14:39.58,0:14:42.42,Default,,0,0,0,,Оны бұзу ауыр жазаға әкеледі.
Dialogue: 0,0:14:42.50,0:14:44.34,Default,,0,0,0,,Оны бұзған Ахарен мырза
Dialogue: 0,0:14:44.42,0:14:47.51,Default,,0,0,0,,Мен отбасымнан алғыс алуға тырысамын.
Dialogue: 0,0:14:47.59,0:14:51.22,Default,,0,0,0,,Жоқ, бұл жай ғана отбасылық оқиға.
Dialogue: 0,0:14:51.30,0:14:55.56,Default,,0,0,0,,Сіз сияқты бейтаныс адамдар көп араласпайды деп үміттенемін.
Dialogue: 0,0:14:56.14,0:15:00.69,Default,,0,0,0,,орындамасам, мен Рейнаға тәуелсіз екенімді көрсете алмаймын.
Dialogue: 0,0:15:00.77,0:15:02.31,Default,,0,0,0,,Қалай... Сабыр етіңіз.
Dialogue: 0,0:15:02.40,0:15:04.52,Default,,0,0,0,,Қазірдің өзінде! Мен жете алмаймын
Dialogue: 0,0:15:04.61,0:15:06.19,Default,,0,0,0,,Ынтымақтастық болғаны дұрыс
Dialogue: 0,0:15:06.28,0:15:08.99,Default,,0,0,0,,Сіз Рейна-ниді бақытты ететін нәрсені жасай аласыз!
Dialogue: 0,0:15:11.11,0:15:13.95,Default,,0,0,0,,Иә... түсіндім.
Dialogue: 0,0:15:18.20,0:15:21.21,Default,,0,0,0,,Маған сатып алуға көмектескеніңіз үшін рахмет.
Dialogue: 0,0:15:21.29,0:15:23.88,Default,,0,0,0,,Ауыр, сондықтан мен оны үйіме жақын алып жүремін.
Dialogue: 0,0:15:24.67,0:15:26.67,Default,,0,0,0,,Оған жақындамайды.
Dialogue: 0,0:15:26.75,0:15:28.42,Default,,0,0,0,,Қазір үйге бара аласыз.
Dialogue: 0,0:15:28.51,0:15:30.55,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:15:30.63,0:15:32.13,Default,,0,0,0,,Бұл өте керемет!
Dialogue: 0,0:15:32.22,0:15:35.43,Default,,0,0,0,,Ниини маған әкелемін деді!
Dialogue: 0,0:15:35.51,0:15:37.26,Default,,0,0,0,,Жоқ, бәрі жақсы, Ренкун.
Dialogue: 0,0:15:37.35,0:15:38.89,Default,,0,0,0,,- Бірақ! -Апыр-ай!
Dialogue: 0,0:15:38.97,0:15:40.35,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,0:15:40.94,0:15:42.81,Default,,0,0,0,,Бірақ олай емес!
Dialogue: 0,0:15:42.90,0:15:45.90,Default,,0,0,0,,Әйтеуір, біраздан бері біртүрлі болды.
Dialogue: 0,0:15:45.98,0:15:49.11,Default,,0,0,0,,Мен басқа көмек сұрай алмаймын...
Dialogue: 0,0:15:49.19,0:15:50.07,Default,,0,0,0,,Реми мұнда әрдайым мен үшін терезені ашады, білесің бе.
Dialogue: 0,0:15:51.61,0:15:52.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:56.24,0:16:00.00,Default,,0,0,0,,Мен енді оған тоймаймын. Рен, мен үйге барамын!
Dialogue: 0,0:16:00.08,0:16:02.58,Default,,0,0,0,,Эй Рен, сен үйге өзің бара аласың ба?
Dialogue: 0,0:16:02.67,0:16:04.71,Default,,0,0,0,,Мен үйге бара аламын!
Dialogue: 0,0:16:11.42,0:16:13.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:14.76,0:16:18.31,Default,,0,0,0,,Мен сені қызғанамын
Dialogue: 0,0:16:19.10,0:16:21.27,Default,,0,0,0,,Саған, Рейнаның бірінші нөмірі
Dialogue: 0,0:16:21.85,0:16:26.48,Default,,0,0,0,,Мен не істесем де, мен Рейнаның бірінші нөмірі бола алмаймын.
Dialogue: 0,0:16:27.44,0:16:28.57,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:16:31.28,0:16:34.66,Default,,0,0,0,,Еру-санның мені алмастыра алмайтыны рас.
Dialogue: 0,0:16:35.41,0:16:37.78,Default,,0,0,0,,Мен де Еру-санның орнын баса алмаймын.
Dialogue: 0,0:16:39.95,0:16:42.25,Default,,0,0,0,,Бұрынғыдай...
Dialogue: 0,0:16:43.46,0:16:46.83,Default,,0,0,0,,Рейна, Рейна, сен сенсің.
Dialogue: 0,0:16:47.42,0:16:49.80,Default,,0,0,0,,Мен Рейнаның орнын толтырушы емеспін.
Dialogue: 0,0:16:50.42,0:16:52.21,Default,,0,0,0,,Мен сенің досыңмын
Dialogue: 0,0:16:52.80,0:16:56.09,Default,,0,0,0,,Мен білуім керек еді, бірақ мен оны қайтадан жасадым.
Dialogue: 0,0:16:56.76,0:16:59.97,Default,,0,0,0,,Осындай нәрселер мені өте тәуелсіз сезінді.
Dialogue: 0,0:17:00.56,0:17:04.64,Default,,0,0,0,,Рейна апасын тастап кете алмағанына мен кінәлі емеспін.
Dialogue: 0,0:17:05.52,0:17:06.94,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:07.02,0:17:08.90,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:17:12.99,0:17:13.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.90,0:17:17.45,Default,,0,0,0,,Е... Рен сен менімен емессің бе?
Dialogue: 0,0:17:17.53,0:17:20.12,Default,,0,0,0,,- Иә? -Мен әлі оралған жоқпын.
Dialogue: 0,0:17:20.20,0:17:21.29,Default,,0,0,0,,Телефон туралы не деуге болады?
Dialogue: 0,0:17:21.37,0:17:23.25,Default,,0,0,0,,Қуат қосылмаған
Dialogue: 0,0:17:23.33,0:17:25.46,Default,,0,0,0,,Үйден қашып кеттіңіз бе?
Dialogue: 0,0:17:25.54,0:17:28.79,Default,,0,0,0,,Мен... Бұл менің кінәм...
Dialogue: 0,0:17:28.88,0:17:30.21,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:17:30.29,0:17:32.84,Default,,0,0,0,,Мен әлі үйден қашуды шешкен жоқпын.
Dialogue: 0,0:17:32.92,0:17:35.63,Default,,0,0,0,,Мүмкін менің үйге барғым келмейтін шығар.
Dialogue: 0,0:17:35.72,0:17:38.93,Default,,0,0,0,,Әр адамның бос уақытты қажет ететін кездері болады.
Dialogue: 0,0:17:39.55,0:17:41.35,Default,,0,0,0,,Неге тағы біраз күтпейсіз?
Dialogue: 0,0:17:41.89,0:17:43.31,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:17:44.43,0:17:45.43,Default,,0,0,0,,Иә
Dialogue: 0,0:17:45.93,0:17:47.31,Default,,0,0,0,,Рейна...
Dialogue: 0,0:17:48.15,0:17:49.52,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:54.57,0:17:55.69,Default,,0,0,0,,Ах
Dialogue: 0,0:17:57.57,0:17:59.45,Default,,0,0,0,,О, інім
Dialogue: 0,0:17:59.53,0:18:02.28,Default,,0,0,0,,Жалғыз жүруге кеш емес пе?
Dialogue: 0,0:18:02.37,0:18:03.74,Default,,0,0,0,,Ха! Амал жоқ...
Dialogue: 0,0:18:04.33,0:18:05.45,Default,,0,0,0,,Суық тигізесің.
Dialogue: 0,0:18:06.37,0:18:10.42,Default,,0,0,0,,Егер сіз оны үйге апарсаңыз, Аха-чанның ұнамдылығын арттыруға мүмкіндігіңіз бар.
Dialogue: 0,0:18:10.50,0:18:11.75,Default,,0,0,0,,Сәлем, бауырым...
Dialogue: 0,0:18:11.84,0:18:13.88,Default,,0,0,0,,Ах! Жоқ, күте тұрыңыз
Dialogue: 0,0:18:13.96,0:18:15.92,Default,,0,0,0,,Егер сіз менімен кенеттен сөйлессеңіз...
Dialogue: 0,0:18:16.01,0:18:18.76,Default,,0,0,0,,Бастауыш сынып оқушысы байқаусызда байланысқа түсіп, бірден жарияланды!
Dialogue: 0,0:18:20.80,0:18:23.76,Default,,0,0,0,,Не істеуім керек... Мен оны жай қалдыратын шығармын.
Dialogue: 0,0:18:23.85,0:18:25.43,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:18:26.10,0:18:27.39,Default,,0,0,0,,Мен бұған тоймаймын.
Dialogue: 0,0:18:27.48,0:18:30.40,Default,,0,0,0,,Неге сонша ренжідіңіз?
Dialogue: 0,0:18:32.19,0:18:34.48,Default,,0,0,0,,Маған тезірек үйге бару керек.
Dialogue: 0,0:18:34.57,0:18:36.28,Default,,0,0,0,,Барлығы уайымдауы мүмкін...
Dialogue: 0,0:18:37.36,0:18:38.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.28,0:18:39.74,Default,,0,0,0,,Рикунее?
Dialogue: 0,0:18:39.82,0:18:40.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:41.74,0:18:44.62,Default,,0,0,0,,Әй... Әй, неткен кездейсоқтық.
Dialogue: 0,0:18:44.70,0:18:48.58,Default,,0,0,0,,Ри...Рикуни...
Dialogue: 0,0:18:48.66,0:18:52.29,Default,,0,0,0,,Иә! Эй... Мен әлі ештеңе істеген жоқпын.
Dialogue: 0,0:18:53.59,0:18:55.09,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:18:55.67,0:18:57.63,Default,,0,0,0,,Сәлем, Такаюки...
Dialogue: 0,0:18:57.71,0:18:59.42,Default,,0,0,0,,Бірақ ол жұмыс істемейді.
Dialogue: 0,0:18:59.51,0:19:02.05,Default,,0,0,0,,Райду Ниинини, осындай көзқараспен...
Dialogue: 0,0:19:02.14,0:19:05.51,Default,,0,0,0,,Қандай кеңес берерімді білмеймін.
Dialogue: 0,0:19:05.60,0:19:07.02,Default,,0,0,0,,Бірақ мен таң қалдым.
Dialogue: 0,0:19:07.10,0:19:08.85,Default,,0,0,0,,Аха-чанның бауырлары
Dialogue: 0,0:19:08.93,0:19:11.60,Default,,0,0,0,,Мен үш адам емес, екі адам деп ойладым.
Dialogue: 0,0:19:12.19,0:19:15.07,Default,,0,0,0,,Үш адам орнына екі...
Dialogue: 0,0:19:17.15,0:19:19.15,Default,,0,0,0,,Бұл мүмкін емес деп ойлаймын.
Dialogue: 0,0:19:19.24,0:19:22.03,Default,,0,0,0,,Мүмкін ол мұны екеуміз ғана жасағымыз келген шығар.
Dialogue: 0,0:19:22.11,0:19:22.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:23.07,0:19:27.49,Default,,0,0,0,,Олай болса, мен жаман нәрсе жасадым.
Dialogue: 0,0:19:27.58,0:19:31.25,Default,,0,0,0,,Олай болса, дұрыс кешірім сұрау керек деп ойлаймын.
Dialogue: 0,0:19:32.12,0:19:34.59,Default,,0,0,0,,Бұл біраз батылдықты қажет етеді.
Dialogue: 0,0:19:35.17,0:19:37.17,Default,,0,0,0,,Менің ойымша, Ренкун мұны істей алады.
Dialogue: 0,0:19:37.25,0:19:38.34,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:19:38.42,0:19:40.17,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:40.88,0:19:42.09,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:19:42.18,0:19:44.26,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:44.97,0:19:46.22,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:19:46.81,0:19:49.06,Default,,0,0,0,,Онда мен үйге баруым керек.
Dialogue: 0,0:19:49.14,0:19:50.18,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:19:50.27,0:19:52.14,Default,,0,0,0,,Мен таң қалдым~
Dialogue: 0,0:19:52.23,0:19:55.65,Default,,0,0,0,,Қарым-қатынас дағдысы Елес бастауыш сынып оқушысының тері епті~
Dialogue: 0,0:19:56.23,0:19:59.15,Default,,0,0,0,,Қолыңнан келгенін істе, інім.
Dialogue: 0,0:20:05.53,0:20:06.37,Default,,0,0,0,,Ах
Dialogue: 0,0:20:10.91,0:20:11.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:11.83,0:20:13.75,Default,,0,0,0,,(Реннің жылағаны)
Dialogue: 0,0:20:13.83,0:20:16.04,Default,,0,0,0,,Кешіріңіз, мен көмектесе алмаймын.
Dialogue: 0,0:20:16.13,0:20:18.55,Default,,0,0,0,,Не сезіп тұрғанымды білмеймін
Dialogue: 0,0:20:18.63,0:20:20.34,Default,,0,0,0,,Уун Рен
Dialogue: 0,0:20:20.92,0:20:22.97,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:20:23.05,0:20:27.10,Default,,0,0,0,,Рен Рейна үшін Райду мырзаны шақырды.
Dialogue: 0,0:20:27.18,0:20:29.72,Default,,0,0,0,,Бірақ ей, бұл перзенттік имандылық.
Dialogue: 0,0:20:29.81,0:20:31.77,Default,,0,0,0,,Біз бірге орындауымыз керек.
Dialogue: 0,0:20:31.85,0:20:32.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:32.77,0:20:35.65,Default,,0,0,0,,Менің сүйікті Рейна-ни үшін
Dialogue: 0,0:20:35.73,0:20:39.23,Default,,0,0,0,,Иә, менің сүйікті Рейна үшін.
Dialogue: 0,0:20:52.58,0:20:54.12,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:20:54.21,0:20:56.21,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:21:01.34,0:21:02.55,Default,,0,0,0,,Дәмді
Dialogue: 0,0:21:02.63,0:21:06.80,Default,,0,0,0,,Мынаның ішінде менің сүйікті картопым бар.
Dialogue: 0,0:21:07.43,0:21:08.26,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:09.55,0:21:12.72,Default,,0,0,0,,Бұл да менің сүйікті тәттім.
Dialogue: 0,0:21:12.81,0:21:15.69,Default,,0,0,0,,Жұмыртқаларды кірпішпен пісірді.
Dialogue: 0,0:21:15.77,0:21:17.40,Default,,0,0,0,,Сіз жақсы жұмыс істедіңіз.
Dialogue: 0,0:21:17.98,0:21:19.31,Default,,0,0,0,,Сіз қалай ойлайсыз? Рейна
Dialogue: 0,0:21:19.40,0:21:22.57,Default,,0,0,0,,Біз көп нәрсені өзіміз жасай аламыз.
Dialogue: 0,0:21:22.65,0:21:26.03,Default,,0,0,0,,Сондықтан мен Рейнаның әпкесінен аулақ болғанын қалаймын.
Dialogue: 0,0:21:26.11,0:21:27.82,Default,,0,0,0,,Әпке кетіп қалды ма?
Dialogue: 0,0:21:30.37,0:21:32.37,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:21:32.45,0:21:35.25,Default,,0,0,0,,Мен әлі де көп нәрсе істеуім керек екенін түсіндім.
Dialogue: 0,0:21:35.33,0:21:39.71,Default,,0,0,0,,Сондықтан мен Рейнаға арқа сүйей беремін.
Dialogue: 0,0:21:40.71,0:21:43.92,Default,,0,0,0,,Рейнамо, бізге көбірек сенім артыңыз.
Dialogue: 0,0:21:44.51,0:21:45.88,Default,,0,0,0,,Иә
Dialogue: 0,0:21:51.43,0:21:55.06,Default,,0,0,0,,Рахмет, мен екеуіңді жақсы көремін.
Dialogue: 0,0:21:55.14,0:21:59.23,Default,,0,0,0,,Жарайды... әрине, біз отбасымыз.
Dialogue: 0,0:21:59.31,0:22:00.31,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:22:04.57,0:22:05.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:05.74,0:22:09.95,Default,,0,0,0,,Маған перзент болғандықтан, бұл да саған сый.
Dialogue: 0,0:22:10.53,0:22:11.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:12.78,0:22:15.00,Default,,0,0,0,,Бұл ауырады~
Dialogue: 0,0:22:16.04,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:40.96,0:23:45.96,Default,,0,0,0,,～♪
