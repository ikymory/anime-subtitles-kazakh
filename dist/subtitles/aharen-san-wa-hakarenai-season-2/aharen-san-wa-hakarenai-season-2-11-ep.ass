Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.54,0:00:06.63,Default,,0,0,0,,Ертең сынып мектеп фестивалінде өнер көрсетеді.
Dialogue: 0,0:00:06.71,0:00:09.84,Default,,0,0,0,,Мен не істеу керектігін шешемін, сондықтан бұл туралы ойлануларыңызды қалаймын.
Dialogue: 0,0:00:09.92,0:00:10.92,Default,,0,0,0,,Иә
Dialogue: 0,0:00:12.97,0:00:14.63,Default,,0,0,0,,Мәдени фестиваль...
Dialogue: 0,0:00:15.64,0:00:16.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:16.55,0:00:18.89,Default,,0,0,0,,Ah алмасу күнделігі
Dialogue: 0,0:00:18.97,0:00:20.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:22.14,0:00:25.31,Default,,0,0,0,,Мен мансап сауалнамасын келесі аптада жіберемін.
Dialogue: 0,0:00:25.40,0:00:26.40,Default,,0,0,0,,Иә
Dialogue: 0,0:00:27.23,0:00:32.15,Default,,0,0,0,,Райду-кунның болашаққа деген арманы бар ма?
Dialogue: 0,0:00:32.24,0:00:37.37,Default,,0,0,0,,Мен Ахарен мырзаны бақылап, қолдағым келеді.
Dialogue: 0,0:00:37.99,0:00:40.20,Default,,0,0,0,,Бұл менің болашақтағы арманым
Dialogue: 0,0:00:42.41,0:00:43.29,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:00:43.37,0:00:45.54,Default,,0,0,0,,Мен бақыттымын, бірақ...
Dialogue: 0,0:00:45.62,0:00:49.75,Default,,0,0,0,,Бар болғаны... Райду-кун.
Dialogue: 0,0:00:49.84,0:00:52.26,Default,,0,0,0,,Бұл маған көмектесу туралы емес.
Dialogue: 0,0:00:52.34,0:00:54.92,Default,,0,0,0,,Райду-кунның арманы
Dialogue: 0,0:00:56.80,0:00:58.34,Default,,0,0,0,,Маған қызық, бұл қандай екен
Dialogue: 0,0:00:59.51,0:01:00.93,Default,,0,0,0,,Менің арманым...
Dialogue: 0,0:01:02.39,0:01:03.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:03.98,0:01:08.98,Default,,0,0,0,,♪～
Dialogue: 0,0:02:28.64,0:02:32.65,Default,,0,0,0,,～♪
Dialogue: 0,0:02:38.44,0:02:41.45,Default,,0,0,0,,Менің жалғыз арманым қандай?
Dialogue: 0,0:02:42.32,0:02:43.16,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:43.24,0:02:45.37,Default,,0,0,0,,Мықты бол, Райду
Dialogue: 0,0:02:45.95,0:02:47.75,Default,,0,0,0,,Өзіңді жоғалтпа
Dialogue: 0,0:02:47.83,0:02:49.75,Default,,0,0,0,,Жолыңнан адасқанда...
Dialogue: 0,0:02:50.33,0:02:52.08,Default,,0,0,0,,Негіздерге оралу
Dialogue: 0,0:02:53.38,0:02:54.46,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:02:55.34,0:03:00.18,Default,,0,0,0,,Бала күнгі армандарыма көз жүгіртіп, менде сол армандардың бар-жоғын білгім келеді.
Dialogue: 0,0:03:00.26,0:03:01.80,Default,,0,0,0,,Ынтымақтастық жасайсыз ба?
Dialogue: 0,0:03:01.89,0:03:02.84,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:03.43,0:03:04.47,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:07.18,0:03:09.02,Default,,0,0,0,,Біріншіден, торт дүкені
Dialogue: 0,0:03:09.10,0:03:10.94,Default,,0,0,0,,Осыны жариялау...
Dialogue: 0,0:03:11.64,0:03:13.15,Default,,0,0,0,,Аяқталды!
Dialogue: 0,0:03:13.23,0:03:14.73,Default,,0,0,0,,Жарайды, келесі.
Dialogue: 0,0:03:14.81,0:03:15.98,Default,,0,0,0,,Иә
Dialogue: 0,0:03:19.82,0:03:21.65,Default,,0,0,0,,Алдымен тартымды кейіпкер жасаңыз
Dialogue: 0,0:03:24.03,0:03:25.62,Default,,0,0,0,,Сүйкімді кейіпкер
Dialogue: 0,0:03:27.95,0:03:29.83,Default,,0,0,0,,-Келесі! -Иә
Dialogue: 0,0:03:39.84,0:03:43.22,Default,,0,0,0,,Мен не істесем де, ол жұмыс істемейді
Dialogue: 0,0:03:44.47,0:03:46.30,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:03:46.39,0:03:47.68,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:03:49.06,0:03:50.93,Default,,0,0,0,,Мен оны байқадым.
Dialogue: 0,0:03:51.02,0:03:54.60,Default,,0,0,0,,Мен ештеңесі жоқ адам едім.
Dialogue: 0,0:03:55.94,0:03:58.57,Default,,0,0,0,,Райду-кунда көп нәрсе бар.
Dialogue: 0,0:03:59.44,0:04:04.07,Default,,0,0,0,,Бейнелеу өнерінің мұғалімі болуға не түрткі болды?
Dialogue: 0,0:04:04.16,0:04:06.53,Default,,0,0,0,,Райду-кунға рахмет
Dialogue: 0,0:04:06.62,0:04:07.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:08.58,0:04:13.33,Default,,0,0,0,,Райду-кун маған әрқашан мейірімді және қамқор болды.
Dialogue: 0,0:04:13.41,0:04:15.04,Default,,0,0,0,,Мен көп нәрсені білемін
Dialogue: 0,0:04:15.12,0:04:19.34,Default,,0,0,0,,Олар маған мейірімділікпен үйретіп, көмектесті.
Dialogue: 0,0:04:19.42,0:04:21.71,Default,,0,0,0,,Мен туралы солай ойладың.
Dialogue: 0,0:04:22.30,0:04:27.18,Default,,0,0,0,,Мен Райду-кун сияқты мұғалім болғым келді.
Dialogue: 0,0:04:28.81,0:04:32.39,Default,,0,0,0,,Мен Райду-куннан көп нәрсе аламын.
Dialogue: 0,0:04:32.48,0:04:36.31,Default,,0,0,0,,Сондықтан көп уайымдаудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:04:36.40,0:04:37.81,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:37.90,0:04:40.61,Default,,0,0,0,,Дұрыс, асығудың қажеті жоқ.
Dialogue: 0,0:04:43.15,0:04:46.41,Default,,0,0,0,,Мәдени фестиваль қойылымдары
Dialogue: 0,0:04:46.49,0:04:48.78,Default,,0,0,0,,Қазір фотогендік дәмхана
Dialogue: 0,0:04:48.87,0:04:51.24,Default,,0,0,0,,Мәдени мерекені асыға күтемін
Dialogue: 0,0:04:51.33,0:04:52.25,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:52.33,0:04:55.21,Default,,0,0,0,,Енді мен кімнің бастық болатынын шешкім келеді.
Dialogue: 0,0:04:55.29,0:04:59.71,Default,,0,0,0,,Ал, ең алдымен тәттілер мен тағамдар жасай алатын адам.
Dialogue: 0,0:05:00.88,0:05:03.80,Default,,0,0,0,,Келесі Костюм жасай алатын адамдар т.б.
Dialogue: 0,0:05:04.88,0:05:07.97,Default,,0,0,0,,Маңдайшаларды, ішкі безендіруді және т.б. жасай алатын адамдар.
Dialogue: 0,0:05:09.26,0:05:12.22,Default,,0,0,0,,Ахарен мырза, сіз бәрін жасай аласыз, солай ма?
Dialogue: 0,0:05:12.31,0:05:14.39,Default,,0,0,0,,Менің аспаздық шеберлігім кәсіби деңгейде.
Dialogue: 0,0:05:14.48,0:05:18.94,Default,,0,0,0,,Бірақ мен бәрін Ахарен мырзаға тапсыра алмаймын.
Dialogue: 0,0:05:19.02,0:05:20.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:20.11,0:05:20.94,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:05:21.02,0:05:22.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:22.19,0:05:24.19,Default,,0,0,0,,Ахарен мырза директор ретінде
Dialogue: 0,0:05:24.28,0:05:27.07,Default,,0,0,0,,Жалпы команданы қабылдау туралы не айтасыз?
Dialogue: 0,0:05:29.12,0:05:33.04,Default,,0,0,0,,Бұл... Мен директормын.
Dialogue: 0,0:05:33.12,0:05:35.00,Default,,0,0,0,,Барлығына да жаман.
Dialogue: 0,0:05:35.58,0:05:38.50,Default,,0,0,0,,Ахарен мырза болашақта мұғалім болғысы келсе.
Dialogue: 0,0:05:38.58,0:05:41.21,Default,,0,0,0,,Бұл керемет тәжірибе болатынына сенімдімін.
Dialogue: 0,0:05:41.79,0:05:43.30,Default,,0,0,0,,Менің ойымша, бұл да жақсы.
Dialogue: 0,0:05:44.76,0:05:48.47,Default,,0,0,0,,Адамдарды ынталандыру басқаларды үйретуге де жетелейді
Dialogue: 0,0:05:48.55,0:05:51.26,Default,,0,0,0,,Қолыңнан келсе, байқап көр деп ойлаймын.
Dialogue: 0,0:05:51.35,0:05:53.97,Default,,0,0,0,,Егер сіз мұны істегіңіз келсе, көріңіз.
Dialogue: 0,0:05:54.06,0:05:57.19,Default,,0,0,0,,Біз өзіміз үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:05:57.27,0:05:59.94,Default,,0,0,0,,Барлығы... бірақ
Dialogue: 0,0:06:00.02,0:06:02.40,Default,,0,0,0,,Маңыздысы сіздің сезіміңіз.
Dialogue: 0,0:06:02.48,0:06:04.86,Default,,0,0,0,,Ахарен мырза, сіз не істегіңіз келеді?
Dialogue: 0,0:06:06.24,0:06:07.90,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:11.12,0:06:13.03,Default,,0,0,0,,Директор Мен мұны істегім келеді
Dialogue: 0,0:06:13.12,0:06:14.66,Default,,0,0,0,,Тергеуіміз қажет нәрселер бар… біртіндеп шешеміз
Dialogue: 0,0:06:14.74,0:06:15.75,Default,,0,0,0,,Бұл шешілді.
Dialogue: 0,0:06:15.83,0:06:18.46,Default,,0,0,0,,Қолдау көрсетуді бізге қалдырыңыз
Dialogue: 0,0:06:32.35,0:06:34.64,Default,,0,0,0,,Ахарен мырза қолынан келгенін жасап жатыр.
Dialogue: 0,0:06:34.72,0:06:38.10,Default,,0,0,0,,Бұл тәжірибе менің мұғалім болу арманыма жетелейтіні сөзсіз.
Dialogue: 0,0:06:38.18,0:06:41.23,Default,,0,0,0,,Бұл шағын, бірақ сенімді бірінші қадам.
Dialogue: 0,0:06:41.85,0:06:46.03,Default,,0,0,0,,Бірақ, екінші жағынан, мен қандай болғым келеді?
Dialogue: 0,0:06:49.28,0:06:52.32,Default,,0,0,0,,(шегенің соғылған дыбысы)
Dialogue: 0,0:06:53.83,0:06:54.66,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:54.74,0:06:56.62,Default,,0,0,0,,-Қайырлы таң... -(1-оқушы қыз) Ахарен ханым
Dialogue: 0,0:06:56.70,0:06:59.50,Default,,0,0,0,,Осы парақшадағы шағым туралы не ойлайсыз?
Dialogue: 0,0:07:00.00,0:07:01.33,Default,,0,0,0,,Менің ойымша, бұл жақсы
Dialogue: 0,0:07:01.42,0:07:04.38,Default,,0,0,0,,Ахарен мырза, бұл түс туралы не ойлайсыз?
Dialogue: 0,0:07:04.46,0:07:06.55,Default,,0,0,0,,Кішкене жарқыраған дұрыс емес пе?
Dialogue: 0,0:07:06.63,0:07:09.01,Default,,0,0,0,,Иә, бұл жақсы деп ойлаймын.
Dialogue: 0,0:07:10.68,0:07:13.22,Default,,0,0,0,,Ахарен мырза, бұл туралы не ойлайсыз?
Dialogue: 0,0:07:13.30,0:07:14.89,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:07:25.40,0:07:26.32,Default,,0,0,0,,(таймердің аяқталу дыбысы)
Dialogue: 0,0:07:26.40,0:07:28.78,Default,,0,0,0,,Уау! Ол дұрыс дайындалды
Dialogue: 0,0:07:28.86,0:07:31.90,Default,,0,0,0,,Уау~ Бұл дәмді көрінеді!
Dialogue: 0,0:07:31.99,0:07:33.78,Default,,0,0,0,,Әдемі және шебер
Dialogue: 0,0:07:34.82,0:07:36.45,Default,,0,0,0,,Ахарен мырза күткендей
Dialogue: 0,0:07:36.53,0:07:39.50,Default,,0,0,0,,Сіз басқаларға үйретуді тез меңгересіз.
Dialogue: 0,0:07:39.58,0:07:43.17,Default,,0,0,0,,Рейна-чан, мен саған көмектесетін бірдеңе бар ма?
Dialogue: 0,0:07:43.25,0:07:47.21,Default,,0,0,0,,Кафенің безендірілуі әлі де көзге түседі...
Dialogue: 0,0:07:47.30,0:07:49.34,Default,,0,0,0,,Олай болса, үйде тәттілер жеп алайық.
Dialogue: 0,0:07:49.42,0:07:50.67,Default,,0,0,0,,Бәріміз бірге жасайық
Dialogue: 0,0:07:51.47,0:07:52.80,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:52.88,0:07:54.39,Default,,0,0,0,,... жарайды ма?
Dialogue: 0,0:07:54.47,0:07:56.39,Default,,0,0,0,,Нағыз әйелдер кеші
Dialogue: 0,0:07:56.47,0:07:58.93,Default,,0,0,0,,Досыңыздың үйінде қыздар түнін өткізесіз бе?
Dialogue: 0,0:07:59.02,0:08:02.60,Default,,0,0,0,,Бұл бірінші және соңғы рет, қайталанбауы мүмкін.
Dialogue: 0,0:08:05.15,0:08:08.15,Default,,0,0,0,,Енді ойлап отырсам, жақында Ахарен-сан мен Райду-кун
Dialogue: 0,0:08:08.23,0:08:10.03,Default,,0,0,0,,Сіз көп сөйлемейсіз, солай ма?
Dialogue: 0,0:08:10.11,0:08:12.95,Default,,0,0,0,,Сен... ұрысып қалдың ба?
Dialogue: 0,0:08:13.03,0:08:14.28,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:14.36,0:08:18.49,Default,,0,0,0,,Ахарен мырза, сіз бос емессіз, уақыт табу қиын.
Dialogue: 0,0:08:19.20,0:08:20.45,Default,,0,0,0,,Иә
Dialogue: 0,0:08:20.54,0:08:24.87,Default,,0,0,0,,Бірақ мектептегі фестиваль аяқталғаннан кейін бәрі бұрынғы қалпына келеді.
Dialogue: 0,0:08:24.96,0:08:25.79,Default,,0,0,0,,Иә
Dialogue: 0,0:08:26.83,0:08:28.21,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:33.55,0:08:35.84,Default,,0,0,0,,Менің ойымша, сен бүгін де Ахарен-санмен үйге бармайсың.
Dialogue: 0,0:08:36.43,0:08:37.80,Default,,0,0,0,,Бұл сирек емес пе?
Dialogue: 0,0:08:37.89,0:08:40.26,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:08:40.35,0:08:42.18,Default,,0,0,0,,Жалғыз емессің бе?
Dialogue: 0,0:08:42.27,0:08:46.65,Default,,0,0,0,,Ахарен мырза қашаннан бері менің жүрегімнің ортасында болды.
Dialogue: 0,0:08:46.73,0:08:49.82,Default,,0,0,0,,Соңғы кездері мен мұны жай ғана істеу жеткіліксіз деп ойлайтынмын.
Dialogue: 0,0:08:49.90,0:08:52.65,Default,,0,0,0,,Сәл алыста, мысалы, жолда...
Dialogue: 0,0:08:53.36,0:08:55.91,Default,,0,0,0,,Мен не істегім келетінін тапқым келді.
Dialogue: 0,0:08:55.99,0:08:57.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:57.20,0:08:59.87,Default,,0,0,0,,Бірақ менің ойымша, кетуге өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:08:59.95,0:09:03.12,Default,,0,0,0,,Ахарен мырзаға жақын болу және одан жақсы әсер алу
Dialogue: 0,0:09:03.20,0:09:06.58,Default,,0,0,0,,Менің ойымша, Райдуға өз армандарын табу тән.
Dialogue: 0,0:09:06.67,0:09:10.04,Default,,0,0,0,,Түсіндім... бұл да рас.
Dialogue: 0,0:09:10.13,0:09:11.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:19.01,0:09:20.43,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:09:20.51,0:09:23.64,Default,,0,0,0,,Мен сияқты болғың келетінін айттың.
Dialogue: 0,0:09:23.72,0:09:24.85,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:35.49,0:09:40.12,Default,,0,0,0,,Мен саған қазір бере алмаймын, себебі сен бос емес сияқтысың және бұл жүк.
Dialogue: 0,0:09:51.96,0:09:53.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:08.10,0:10:10.06,Default,,0,0,0,,Ертең мәдени фестиваль
Dialogue: 0,0:10:10.65,0:10:13.11,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:10:13.19,0:10:14.90,Default,,0,0,0,,Егер ол оны өзінің Қабілетімен көтерсе, бастаманы өз қолына алады
Dialogue: 0,0:10:14.98,0:10:19.53,Default,,0,0,0,,Түнгі мектепте достарымен мектеп фестиваліне дайындық...
Dialogue: 0,0:10:20.16,0:10:21.99,Default,,0,0,0,,Өте қызық
Dialogue: 0,0:10:22.07,0:10:24.66,Default,,0,0,0,,Дайындық өмір бойы жалғасады
Dialogue: 0,0:10:24.74,0:10:26.37,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:26.45,0:10:31.33,Default,,0,0,0,,Не? Бұл біткеннен кейін мен оқуым керек.
Dialogue: 0,0:10:32.92,0:10:36.71,Default,,0,0,0,,Бұл соңы сияқты.
Dialogue: 0,0:10:37.30,0:10:39.05,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:39.13,0:10:42.64,Default,,0,0,0,,Аяқтама, дайындал...
Dialogue: 0,0:10:42.72,0:10:44.51,Default,,0,0,0,,-Мм... -(Рику/Сато) Иә?
Dialogue: 0,0:10:45.10,0:10:47.73,Default,,0,0,0,,Демек, ертең.
Dialogue: 0,0:10:47.81,0:10:53.19,Default,,0,0,0,,Мен барлығына бір нәрсе көргім келеді, бұл жақсы ма?
Dialogue: 0,0:10:53.27,0:10:54.77,Default,,0,0,0,,О, оны асыға күт!
Dialogue: 0,0:10:54.86,0:10:56.48,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:10:57.78,0:10:59.45,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:02.99,0:11:03.87,Default,,0,0,0,,Дайын
Dialogue: 0,0:11:04.45,0:11:06.83,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:11:06.91,0:11:09.37,Default,,0,0,0,,Иә, бұл жақсы емес пе?
Dialogue: 0,0:11:09.46,0:11:10.29,Default,,0,0,0,,Иә
Dialogue: 0,0:11:10.37,0:11:12.83,Default,,0,0,0,,Енді бәрі дайын.
Dialogue: 0,0:11:12.92,0:11:16.09,Default,,0,0,0,,Бәрі бітті
Dialogue: 0,0:11:16.17,0:11:18.01,Default,,0,0,0,,Бітті...
Dialogue: 0,0:11:18.09,0:11:20.01,Default,,0,0,0,,Ол әлі басталған жоқ!
Dialogue: 0,0:11:20.09,0:11:21.63,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:21.72,0:11:23.09,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:23.18,0:11:26.14,Default,,0,0,0,,Мен сенімен суретке түскім келеді
Dialogue: 0,0:11:26.22,0:11:28.39,Default,,0,0,0,,Лайк қой, суретке түсейік
Dialogue: 0,0:11:29.31,0:11:31.19,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:11:31.27,0:11:32.35,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:11:33.23,0:11:35.69,Default,,0,0,0,,Олай болса мен мұғалімге айтамын.
Dialogue: 0,0:11:35.77,0:11:37.86,Default,,0,0,0,,Барлығы үйлеріне қайтуға дайындалып жатыр.
Dialogue: 0,0:11:38.69,0:11:40.32,Default,,0,0,0,,- (Ишикава) О, күте тұрыңыз - (Сато) Иә?
Dialogue: 0,0:11:40.40,0:11:43.53,Default,,0,0,0,,Түнде мектепті аралап көрейік
Dialogue: 0,0:11:43.61,0:11:45.66,Default,,0,0,0,,Түнгі мектеп...
Dialogue: 0,0:11:45.74,0:11:47.24,Default,,0,0,0,,Барлау?
Dialogue: 0,0:11:47.33,0:11:50.71,Default,,0,0,0,,Болды... Тезірек үйге баруым керек.
Dialogue: 0,0:11:50.79,0:11:52.83,Default,,0,0,0,,Бірақ, аз болса да...
Dialogue: 0,0:11:52.92,0:11:54.79,Default,,0,0,0,,Бұл бұта да болмауы мүмкін
Dialogue: 0,0:11:54.88,0:11:58.21,Default,,0,0,0,,Аяқтамаңыз, тағы біраз...
Dialogue: 0,0:11:58.30,0:11:59.46,Default,,0,0,0,,Содан кейін шешім қабылданады.
Dialogue: 0,0:11:59.55,0:12:02.80,Default,,0,0,0,,Не? О, күт
Dialogue: 0,0:12:16.65,0:12:18.27,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:12:22.53,0:12:26.37,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:12:27.45,0:12:30.04,Default,,0,0,0,,Жарайды, уақытында келдің.
Dialogue: 0,0:12:32.37,0:12:35.37,Default,,0,0,0,,Осындай уақытта... Мен ұйықтауым керек.
Dialogue: 0,0:12:43.26,0:12:45.59,Default,,0,0,0,,Мектеп фестивалі Мен бар күшімді саламын
Dialogue: 0,0:12:45.68,0:12:52.22,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:12:55.56,0:12:57.81,Default,,0,0,0,,Бүгін мектеп мерекесі
Dialogue: 0,0:12:57.90,0:12:59.86,Default,,0,0,0,,Сіз жақсы дайындалған болуыңыз керек.
Dialogue: 0,0:12:59.94,0:13:00.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:00.94,0:13:02.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:02.49,0:13:03.57,Default,,0,0,0,,Ишикава?
Dialogue: 0,0:13:03.65,0:13:06.45,Default,,0,0,0,,Мен сізді таң қалдырмақ болдым, бірақ сіз білдіңіз~
Dialogue: 0,0:13:06.53,0:13:08.32,Default,,0,0,0,,Мектеп мерекесінде бар күшімізді салайық
Dialogue: 0,0:13:08.41,0:13:10.70,Default,,0,0,0,,Сонда да сізде жақсы интуиция бар.
Dialogue: 0,0:13:10.78,0:13:13.54,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:13:14.12,0:13:15.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:22.30,0:13:23.13,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:23.21,0:13:24.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:24.42,0:13:25.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:25.88,0:13:26.80,Default,,0,0,0,,Райду-кун!
Dialogue: 0,0:13:26.88,0:13:28.76,Default,,0,0,0,,Ахарен мырза, сіз білмейсіз бе?
Dialogue: 0,0:13:28.84,0:13:30.35,Default,,0,0,0,,А...
Dialogue: 0,0:13:30.43,0:13:33.56,Default,,0,0,0,,Мен Ахарен мырзаны кездестірмедім, не болды?
Dialogue: 0,0:13:33.64,0:13:35.98,Default,,0,0,0,,Ахарен мырза, ертерек келуіңіз керек еді.
Dialogue: 0,0:13:36.06,0:13:37.69,Default,,0,0,0,,Бұл әлі жоқ.
Dialogue: 0,0:13:37.77,0:13:40.02,Default,,0,0,0,,Менің контактіме жауап болмады.
Dialogue: 0,0:13:40.11,0:13:42.27,Default,,0,0,0,,Мүмкін мен ұйықтап қалған шығармын.
Dialogue: 0,0:13:42.36,0:13:43.69,Default,,0,0,0,,Жоқ, маған таңертең үйден шықтым деп қоңырау шалды.
Dialogue: 0,0:13:43.69,0:13:44.74,Default,,0,0,0,,Жоқ, маған таңертең үйден шықтым деп қоңырау шалды (түрту дыбысы)
Dialogue: 0,0:13:44.74,0:13:47.28,Default,,0,0,0,,Жоқ, маған таңертең үйден шықтым деп қоңырау шалды.
Dialogue: 0,0:13:47.36,0:13:48.70,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:13:49.28,0:13:52.24,Default,,0,0,0,,Мүмкін Ахарен мырза...
Dialogue: 0,0:13:59.96,0:14:01.50,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:14:01.59,0:14:04.30,Default,,0,0,0,,Менде дәлел жоқ, бірақ менде сезім бар
Dialogue: 0,0:14:04.38,0:14:05.76,Default,,0,0,0,,Бірақ егер...
Dialogue: 0,0:14:05.84,0:14:09.22,Default,,0,0,0,,Егер Ахарен мырза өз еркімен келмесе.
Dialogue: 0,0:14:09.30,0:14:12.51,Default,,0,0,0,,Мүмкін оны біраз уақытқа қалдырған дұрыс шығар.
Dialogue: 0,0:14:12.60,0:14:14.68,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:14:15.77,0:14:18.02,Default,,0,0,0,,Қиындық болған жоқ па?
Dialogue: 0,0:14:18.10,0:14:21.52,Default,,0,0,0,,Ал сен келсең қуанар едім.
Dialogue: 0,0:14:21.61,0:14:22.77,Default,,0,0,0,,Ишикава…
Dialogue: 0,0:14:22.86,0:14:25.94,Default,,0,0,0,,Дұрыс, мені тез алып кетіңізші.
Dialogue: 0,0:14:26.03,0:14:28.24,Default,,0,0,0,,Дұрыс жауапты білмесеңіз
Dialogue: 0,0:14:28.32,0:14:31.12,Default,,0,0,0,,Неге орындағыңыз келетін нәрсеге басымдық бермеске?
Dialogue: 0,0:14:31.20,0:14:35.04,Default,,0,0,0,,Мен не істегім келеді...
Dialogue: 0,0:14:37.62,0:14:38.87,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:14:39.58,0:14:41.13,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:14:43.04,0:14:44.04,Default,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,0:14:44.92,0:14:46.92,Default,,0,0,0,,Гамба! Raidou Fight! жалғастыра бер!
Dialogue: 0,0:14:56.27,0:14:57.77,Default,,0,0,0,,А...
Dialogue: 0,0:15:02.52,0:15:04.52,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:15:06.36,0:15:09.70,Default,,0,0,0,,Рейна, шаршаған жоқсың ба?
Dialogue: 0,0:15:09.78,0:15:11.41,Default,,0,0,0,,Мен уайымдап тұрмын
Dialogue: 0,0:15:11.49,0:15:14.83,Default,,0,0,0,,Бүгін автобуспен жүрген дұрыс емес пе?
Dialogue: 0,0:15:14.91,0:15:15.99,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:16.62,0:15:17.75,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:15:31.26,0:15:34.68,Default,,0,0,0,,(Рейнаның ұйықтап жатқан тынысы)
Dialogue: 0,0:15:38.18,0:15:42.85,Default,,0,0,0,,Мен пойыздан қалып қойдым, смартфонымның батареясы таусылды.
Dialogue: 0,0:15:42.94,0:15:46.32,Default,,0,0,0,,Келесі автобус алыста
Dialogue: 0,0:15:46.90,0:15:49.90,Default,,0,0,0,,Мектеп фестивалі басталып та кетті.
Dialogue: 0,0:15:50.74,0:15:53.24,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:15:53.74,0:15:56.62,Default,,0,0,0,,Осындай жағдайлар орын алса, бәрі таң қалады.
Dialogue: 0,0:15:57.20,0:15:58.45,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:16:01.66,0:16:03.08,Default,,0,0,0,,Неге...
Dialogue: 0,0:16:03.17,0:16:05.71,Default,,0,0,0,,Райду-кун, сен осындасың ба?
Dialogue: 0,0:16:07.38,0:16:11.01,Default,,0,0,0,,Таңертең мен Ахарен мырзаның автобусының жанынан өткендей болдым.
Dialogue: 0,0:16:12.63,0:16:15.59,Default,,0,0,0,,Ахарен мырзаны ешкім кінәлап жатқан жоқ.
Dialogue: 0,0:16:17.26,0:16:18.60,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:16:18.68,0:16:21.31,Default,,0,0,0,,Барлық дайындықтары үшін Ахарен мырзаға рахмет.
Dialogue: 0,0:16:21.39,0:16:23.10,Default,,0,0,0,,Мен бастай алатын сияқтымын.
Dialogue: 0,0:16:23.19,0:16:25.06,Default,,0,0,0,,Сондықтан бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:16:26.52,0:16:28.27,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:16:28.94,0:16:34.91,Default,,0,0,0,,Олай болса, қайтып келмесем де жарайды деп ойлаймын.
Dialogue: 0,0:16:36.20,0:16:39.33,Default,,0,0,0,,Ахарен мырза қайтқысы келмесе
Dialogue: 0,0:16:39.41,0:16:41.12,Default,,0,0,0,,Мен сенімен мәңгі бірге боламын
Dialogue: 0,0:16:41.20,0:16:42.37,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:42.45,0:16:43.71,Default,,0,0,0,,(Ұялы телефон қоңырау үні)
Dialogue: 0,0:16:43.71,0:16:45.83,Default,,0,0,0,,(Ұялы телефон қоңырау үні)
Dialogue: 0,0:16:43.71,0:16:45.83,Default,,0,0,0,,Мен әркімнің дауысы бір рет естілуін қалаймын.
Dialogue: 0,0:16:46.50,0:16:48.29,Default,,0,0,0,,О, Ахарен мырза
Dialogue: 0,0:16:48.38,0:16:50.84,Default,,0,0,0,,Рахмет, Рейна-чан
Dialogue: 0,0:16:50.92,0:16:52.67,Default,,0,0,0,,Аман-есен оралуыңызды өтінемін.
Dialogue: 0,0:16:52.76,0:16:55.26,Default,,0,0,0,,Оны баяу қабылдаған дұрыс. Мен сені күтетін боламын!
Dialogue: 0,0:16:55.84,0:16:58.22,Default,,0,0,0,,Ахарен мырза өзін кінәлі сезінбейді деп ойлаймын.
Dialogue: 0,0:16:58.30,0:16:59.51,Default,,0,0,0,,Өйткені ештеңе жоқ
Dialogue: 0,0:16:59.60,0:17:01.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:01.81,0:17:04.77,Default,,0,0,0,,Ахарен мырза дәл сол жерде.
Dialogue: 0,0:17:04.85,0:17:07.69,Default,,0,0,0,,Мен айналамдағы адамдарға жақсы әсер еттім деп ойлаймын.
Dialogue: 0,0:17:08.27,0:17:11.57,Default,,0,0,0,,Мен соншалықты керемет емеспін
Dialogue: 0,0:17:11.65,0:17:12.90,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:17:12.99,0:17:17.24,Default,,0,0,0,,Менің де кешірім сұрауым бар, Райду-кун.
Dialogue: 0,0:17:17.32,0:17:18.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:18.57,0:17:21.37,Default,,0,0,0,,Кешіріңіз, мен тазалауым керек.
Dialogue: 0,0:17:21.45,0:17:24.62,Default,,0,0,0,,Алмасу күнделігі түсіп қалды
Dialogue: 0,0:17:24.71,0:17:26.37,Default,,0,0,0,,Мен біраз көрдім...
Dialogue: 0,0:17:26.46,0:17:28.08,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:28.71,0:17:30.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:33.42,0:17:35.01,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:17:35.09,0:17:37.55,Default,,0,0,0,,Мен сияқты болғың келетінін айттың.
Dialogue: 0,0:17:38.43,0:17:39.47,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:17:41.72,0:17:43.77,Default,,0,0,0,,Мен Ахарен-сан сияқты болғым келеді
Dialogue: 0,0:17:45.23,0:17:48.65,Default,,0,0,0,,зерделі және білімді
Dialogue: 0,0:17:50.73,0:17:52.36,Default,,0,0,0,,Еңбекқор
Dialogue: 0,0:17:54.49,0:17:55.36,Default,,0,0,0,,Түрі
Dialogue: 0,0:17:57.74,0:17:59.78,Default,,0,0,0,,Өзгелерге қамқор болу
Dialogue: 0,0:18:01.45,0:18:03.66,Default,,0,0,0,,Айналадағылардың құрметіне ие
Dialogue: 0,0:18:09.25,0:18:13.34,Default,,0,0,0,,Мен Ахарен мырзаға ұқсағым келді.
Dialogue: 0,0:18:14.21,0:18:15.96,Default,,0,0,0,,Райду-кун...
Dialogue: 0,0:18:17.17,0:18:20.30,Default,,0,0,0,,Мен болашақты әлі білмеймін.
Dialogue: 0,0:18:20.39,0:18:24.35,Default,,0,0,0,,Бірақ, кем дегенде, алдағы күндерде бар күшімді саламын.
Dialogue: 0,0:18:24.43,0:18:28.98,Default,,0,0,0,,Бұл біз үшін тек осы уақытта ғана жасалуы мүмкін маңызды тәжірибе болады.
Dialogue: 0,0:18:29.65,0:18:30.98,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:31.77,0:18:35.82,Default,,0,0,0,,Енді мен Ахарен-санның қасындамын.
Dialogue: 0,0:18:35.90,0:18:38.53,Default,,0,0,0,,Мен мектеп фестивалін барлығымен аяқтағым келеді.
Dialogue: 0,0:18:47.70,0:18:49.50,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:18:53.67,0:18:56.09,Default,,0,0,0,,Мен де, Райду-кун...
Dialogue: 0,0:18:56.63,0:18:59.05,Default,,0,0,0,,Мен барлығымен мектеп фестивалін өткізгім келеді.
Dialogue: 0,0:19:00.13,0:19:01.76,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:19:02.64,0:19:03.68,Default,,0,0,0,,Иә
Dialogue: 0,0:19:05.31,0:19:08.02,Default,,0,0,0,,Олай болса қайта жиналайық.
Dialogue: 0,0:19:08.10,0:19:09.10,Default,,0,0,0,,Иә
Dialogue: 0,0:19:13.52,0:19:16.32,Default,,0,0,0,,Душ бөлмесі болғаны жақсы.
Dialogue: 0,0:19:16.40,0:19:19.24,Default,,0,0,0,,Мен ауыстыратын киім әкелгеніме қуаныштымын.
Dialogue: 0,0:19:20.49,0:19:22.41,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:19:23.07,0:19:24.07,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:19:26.54,0:19:28.50,Default,,0,0,0,,Біз дұрыс аша алған сияқтымыз.
Dialogue: 0,0:19:29.12,0:19:30.83,Default,,0,0,0,,Ахарен-санға рахмет.
Dialogue: 0,0:19:30.91,0:19:33.88,Default,,0,0,0,,Иә... Жақсы.
Dialogue: 0,0:19:34.38,0:19:35.79,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:35.88,0:19:38.67,Default,,0,0,0,,А, автобус жақында келеді.
Dialogue: 0,0:19:44.55,0:19:45.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:49.73,0:19:51.35,Default,,0,0,0,,О...
Dialogue: 0,0:20:02.40,0:20:04.20,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:30.97,0:20:34.27,Default,,0,0,0,,Мен қазір үзіліс жасай аламын ба?
Dialogue: 0,0:20:34.35,0:20:36.31,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:20:36.40,0:20:37.86,Default,,0,0,0,,Сабыр етіңіз
Dialogue: 0,0:20:38.52,0:20:41.57,Default,,0,0,0,,Барлығыңыз, маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:20:41.65,0:20:44.57,Default,,0,0,0,,Мен саған кеше не көрсеткім келді
Dialogue: 0,0:20:45.49,0:20:46.74,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:20:46.82,0:20:48.28,Default,,0,0,0,,Оны асыға күтемін~
Dialogue: 0,0:20:48.37,0:20:50.12,Default,,0,0,0,,Өнер бөлмесі?
Dialogue: 0,0:20:50.70,0:20:52.25,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:52.83,0:20:54.21,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:54.29,0:20:56.46,Default,,0,0,0,,Ахареннің шығармалары
Dialogue: 0,0:20:56.54,0:20:59.80,Default,,0,0,0,,Мен сурет көрмесіне орын жалдадым.
Dialogue: 0,0:20:59.88,0:21:02.21,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:21:02.30,0:21:05.09,Default,,0,0,0,,Өйткені мен осындай нәрсені көргім келді
Dialogue: 0,0:21:05.18,0:21:06.93,Default,,0,0,0,,Иә, бұл жақсы деп ойлаймын.
Dialogue: 0,0:21:07.01,0:21:12.14,Default,,0,0,0,,Міне, мен бәрін көргім келеді.
Dialogue: 0,0:21:13.52,0:21:14.69,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:18.19,0:21:20.61,Default,,0,0,0,,Біздің деректі фильм?
Dialogue: 0,0:21:20.69,0:21:22.69,Default,,0,0,0,,Өзіңіз суретке түсіріңіз
Dialogue: 0,0:21:22.78,0:21:26.86,Default,,0,0,0,,Барлығынан алынған фотосуреттер мен бейнелер
Dialogue: 0,0:21:26.95,0:21:29.87,Default,,0,0,0,,Жалғау арқылы жасалған
Dialogue: 0,0:21:37.87,0:21:42.21,Default,,0,0,0,,Енді бәріміз әр түрлі жолға түссек те
Dialogue: 0,0:21:42.75,0:21:47.97,Default,,0,0,0,,Себебі мен осында екенімізді артта қалдырғым келді.
Dialogue: 0,0:21:48.59,0:21:51.22,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:21:52.06,0:21:54.64,Default,,0,0,0,,Қазірден бастап әлем қалай өзгерсе де
Dialogue: 0,0:21:54.73,0:21:58.06,Default,,0,0,0,,Біздің осында болғанымыз анық.
Dialogue: 0,0:21:59.35,0:22:00.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:22:16.04,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:40.96,0:23:45.96,Default,,0,0,0,,～♪
