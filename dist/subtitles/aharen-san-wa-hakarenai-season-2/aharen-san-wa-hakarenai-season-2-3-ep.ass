Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.75,0:00:09.38,Default,,0,0,0,,Спорт мерекесіне де аз қалды.
Dialogue: 0,0:00:09.46,0:00:10.30,Default,,0,0,0,,Иә
Dialogue: 0,0:00:11.88,0:00:15.47,Default,,0,0,0,,А... а...
Dialogue: 0,0:00:15.55,0:00:17.51,Default,,0,0,0,,Қарсы болмасаңыз, көмектесе аламын ба?
Dialogue: 0,0:00:17.60,0:00:19.97,Default,,0,0,0,,О, бұл пайдалы.
Dialogue: 0,0:00:20.56,0:00:21.77,Default,,0,0,0,,Hmph (жыртылған дыбыс)
Dialogue: 0,0:00:22.68,0:00:24.27,Default,,0,0,0,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:00:26.69,0:00:28.98,Default,,0,0,0,,Райду-кун керемет
Dialogue: 0,0:00:29.07,0:00:30.90,Default,,0,0,0,,Біз әлі Кира туралы бірде-бір із тапқан жоқпыз,
Dialogue: 0,0:00:39.20,0:00:40.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:41.04,0:00:46.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:05.70,0:02:09.71,Default,,0,0,0,,～♪
Dialogue: 0,0:02:17.05,0:02:17.88,Default,,0,0,0,,Raidou…
Dialogue: 0,0:02:19.93,0:02:23.81,Default,,0,0,0,,(Студент қыздардың сөйлейтін дыбыстары)
Dialogue: 0,0:02:23.89,0:02:28.23,Default,,0,0,0,,Мм, Ахарен мырза, сіз әдеттегідей бір жағына отыра алмайсыз.
Dialogue: 0,0:02:28.31,0:02:29.81,Default,,0,0,0,,- Мм - түсіндім.
Dialogue: 0,0:02:30.60,0:02:33.77,Default,,0,0,0,,Ахарен мырза кенет менің артымнан келе бастады.
Dialogue: 0,0:02:34.57,0:02:37.49,Default,,0,0,0,,Бұл солай аталады.
Dialogue: 0,0:02:38.19,0:02:39.70,Default,,0,0,0,,Артқа
Dialogue: 0,0:02:39.78,0:02:42.07,Default,,0,0,0,,Басқаларға көмектесу арқылы тұлға ретінде өсіңіз
Dialogue: 0,0:02:42.16,0:02:44.91,Default,,0,0,0,,Қосу қабілетім артты, арқам кеңейді.
Dialogue: 0,0:02:44.99,0:02:46.37,Default,,0,0,0,,Мен оны жақыннан сезгім келеді
Dialogue: 0,0:02:46.95,0:02:48.83,Default,,0,0,0,,Сол сезімнің көрінісі.
Dialogue: 0,0:02:49.41,0:02:51.75,Default,,0,0,0,,Мен бұл сезімге опасыздық жасай алмаймын
Dialogue: 0,0:02:51.83,0:02:54.63,Default,,0,0,0,,Басқаларға көмектесуден тартынбаңыз және көмектесуді жалғастырыңыз.
Dialogue: 0,0:02:54.71,0:02:58.17,Default,,0,0,0,,Салбырап кетпеу үшін бөкселеріңізді жоғары қарай өсіріңіз.
Dialogue: 0,0:02:58.26,0:03:00.59,Default,,0,0,0,,Үлкен арқаңызды көрсетіңіз
Dialogue: 0,0:03:05.93,0:03:08.06,Default,,0,0,0,,Жарайды... ой...
Dialogue: 0,0:03:08.14,0:03:09.52,Default,,0,0,0,,Көмектесейік
Dialogue: 0,0:03:19.78,0:03:21.36,Default,,0,0,0,,Біреу асығыңыз!
Dialogue: 0,0:03:21.45,0:03:22.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:25.03,0:03:27.41,Default,,0,0,0,,Маған секірген атты қалдырыңыз.
Dialogue: 0,0:03:27.49,0:03:29.62,Default,,0,0,0,,Хо ё фу...
Dialogue: 0,0:03:29.70,0:03:30.71,Default,,0,0,0,,Га
Dialogue: 0,0:03:36.00,0:03:36.84,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:03:43.26,0:03:44.22,Default,,0,0,0,,Га
Dialogue: 0,0:03:53.65,0:03:56.02,Default,,0,0,0,,Бүгін төбеде ешкім жоқ.
Dialogue: 0,0:03:58.78,0:04:00.65,Default,,0,0,0,,Мұнда ешкім жоқ…
Dialogue: 0,0:04:00.74,0:04:01.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:04.20,0:04:05.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:07.08,0:04:08.12,Default,,0,0,0,,Ахарен мырза?
Dialogue: 0,0:04:08.20,0:04:09.04,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:11.75,0:04:14.71,Default,,0,0,0,,Ахарен мырза кенет есегін айналдырып жібергендей.
Dialogue: 0,0:04:14.79,0:04:16.33,Default,,0,0,0,,Менің есегіме ұмтылу
Dialogue: 0,0:04:16.42,0:04:17.25,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:17.96,0:04:19.34,Default,,0,0,0,,Қақпалы қалам
Dialogue: 0,0:04:19.42,0:04:22.59,Default,,0,0,0,,Өзіңді ойламай, басқаларға көмектесу жанқиярлыққа әкеледі.
Dialogue: 0,0:04:22.67,0:04:25.13,Default,,0,0,0,,Ахарен мырза бізді бұған қарсы ескертуге тырысады.
Dialogue: 0,0:04:25.22,0:04:26.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:26.64,0:04:29.01,Default,,0,0,0,,Қақпалы қаламды ұстау күйі
Dialogue: 0,0:04:29.10,0:04:30.89,Default,,0,0,0,,Қалай құтылуға болады...
Dialogue: 0,0:04:31.56,0:04:33.39,Default,,0,0,0,,Жоқ, мен бас тартамын.
Dialogue: 0,0:04:33.48,0:04:35.60,Default,,0,0,0,,Менде кішкентай бөксе тесігі бар
Dialogue: 0,0:04:35.69,0:04:39.19,Default,,0,0,0,,Мен Ахарен мырзаға мені білмей бөксемді сүртуге рұқсат еттім.
Dialogue: 0,0:04:39.27,0:04:41.82,Default,,0,0,0,,Мен жазаны қабылдаймын.
Dialogue: 0,0:04:43.86,0:04:44.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:56.67,0:04:57.67,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:58.29,0:04:59.84,Default,,0,0,0,,Рахмет сізге Ахарен мырза
Dialogue: 0,0:04:59.92,0:05:00.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.84,0:05:03.21,Default,,0,0,0,,Қиындыққа тап болған Ахарен мырзаға қарап
Dialogue: 0,0:05:03.30,0:05:06.22,Default,,0,0,0,,Мен өзімнің асығыс әрекеттеріме өкінемін.
Dialogue: 0,0:05:06.30,0:05:10.56,Default,,0,0,0,,Менде әлі жасыл бөкселер бар, бірақ бұдан былай өзімді жоғары бағалаймын.
Dialogue: 0,0:05:10.64,0:05:13.43,Default,,0,0,0,,Ахарен мырзаға жақсы көңіл бөліңіз.
Dialogue: 0,0:05:13.52,0:05:14.89,Default,,0,0,0,,Мен өзімді дайындаймын
Dialogue: 0,0:05:14.98,0:05:17.10,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:05:17.19,0:05:18.44,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:05:20.48,0:05:22.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:22.15,0:05:23.36,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,0:05:23.44,0:05:24.78,Default,,0,0,0,,Ахарен мырза?
Dialogue: 0,0:05:27.70,0:05:28.53,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:05:28.61,0:05:31.83,Default,,0,0,0,,(Оқушылар ауыр тыныс алады)
Dialogue: 0,0:05:37.54,0:05:39.67,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:05:40.54,0:05:41.38,Default,,0,0,0,,О...
Dialogue: 0,0:05:44.01,0:05:44.84,Default,,0,0,0,,Ах
Dialogue: 0,0:05:49.14,0:05:52.01,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:53.31,0:05:54.97,Default,,0,0,0,,шыға алмадым...
Dialogue: 0,0:05:55.68,0:05:57.94,Default,,0,0,0,,Барлық эстафета сыныптық жарыстың тірегі болып табылады
Dialogue: 0,0:05:58.02,0:06:00.52,Default,,0,0,0,,Ишикава, бұл өзіңе байланысты.
Dialogue: 0,0:06:01.27,0:06:03.44,Default,,0,0,0,,Таманаха-сан да жылдам болды.
Dialogue: 0,0:06:03.52,0:06:04.69,Default,,0,0,0,,Иә
Dialogue: 0,0:06:04.78,0:06:07.45,Default,,0,0,0,,Мен көп жаттығып, бар күшімді салдым.
Dialogue: 0,0:06:07.53,0:06:10.78,Default,,0,0,0,,Жылдам болсаң, сыныбыңда танымал боласың.
Dialogue: 0,0:06:10.87,0:06:11.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:13.83,0:06:16.25,Default,,0,0,0,,Ахарен мырза дірілдеп тұр.
Dialogue: 0,0:06:16.79,0:06:18.37,Default,,0,0,0,,Мен бұны күтпедім...
Dialogue: 0,0:06:18.46,0:06:19.50,Default,,0,0,0,,Ашу?
Dialogue: 0,0:06:19.58,0:06:21.29,Default,,0,0,0,,Зәкірдің жоғалуына байланысты
Dialogue: 0,0:06:21.38,0:06:24.71,Default,,0,0,0,,Мен өз-өзіме лайық емеспін деп ренжідім.
Dialogue: 0,0:06:24.80,0:06:26.63,Default,,0,0,0,,Жоқ, Ахарен мырза
Dialogue: 0,0:06:26.71,0:06:28.76,Default,,0,0,0,,Мен өзімнің аяғыма сенімді болғаныма сене алар емеспін.
Dialogue: 0,0:06:28.84,0:06:29.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:29.76,0:06:32.64,Default,,0,0,0,,Мен эстафетада жақсы емеспін
Dialogue: 0,0:06:33.55,0:06:35.31,Default,,0,0,0,,Өйткені мен баяумын
Dialogue: 0,0:06:35.97,0:06:40.39,Default,,0,0,0,,Бұл аздап қорқынышты, өйткені ол барлығына қиындық тудырады.
Dialogue: 0,0:06:40.48,0:06:41.81,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:06:41.90,0:06:45.86,Default,,0,0,0,,Біреу кешігіп қалса да, ешкім бұл жайсыздық деп ойламайды.
Dialogue: 0,0:06:45.94,0:06:47.82,Default,,0,0,0,,Дұрыс, Ахарен мырза.
Dialogue: 0,0:06:47.90,0:06:51.16,Default,,0,0,0,,Мен, Оширо мырза және Таманаха мырза да осындамыз.
Dialogue: 0,0:06:51.24,0:06:52.95,Default,,0,0,0,,Уайымдайтын ештеңе жоқ
Dialogue: 0,0:06:53.03,0:06:55.08,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:06:55.16,0:06:58.29,Default,,0,0,0,,Аха-чан, егер Рику осында болса, ол міндетті түрде бірінші болады.
Dialogue: 0,0:06:59.08,0:07:00.08,Default,,0,0,0,,Иә
Dialogue: 0,0:07:03.08,0:07:06.21,Default,,0,0,0,,үшін маған бәрі жақсы деді, бірақ
Dialogue: 0,0:07:06.30,0:07:09.72,Default,,0,0,0,,Мен мүмкіндігінше жылдам болғым келеді, сондықтан маған айтыңыз.
Dialogue: 0,0:07:09.80,0:07:11.05,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:07:11.13,0:07:13.09,Default,,0,0,0,,Дегенмен, мерзім қысқа.
Dialogue: 0,0:07:13.18,0:07:15.14,Default,,0,0,0,,Алдымен таяқшаны беруге жаттығып алайық.
Dialogue: 0,0:07:15.22,0:07:16.06,Default,,0,0,0,,Иә
Dialogue: 0,0:07:16.14,0:07:17.39,Default,,0,0,0,,Жеткізу үшін
Dialogue: 0,0:07:17.47,0:07:19.68,Default,,0,0,0,,Кеңінен үстеме және болып бөлінеді
Dialogue: 0,0:07:19.77,0:07:21.02,Default,,0,0,0,,Қол асты бар.
Dialogue: 0,0:07:21.60,0:07:23.15,Default,,0,0,0,,Бұл тәжірибені қажет етеді.
Dialogue: 0,0:07:23.23,0:07:27.44,Default,,0,0,0,,Мен астынан өтуді ұсынғым келеді, өйткені таяқшаны түсіру қиын және оны жылдамдату оңай.
Dialogue: 0,0:07:28.53,0:07:31.65,Default,,0,0,0,,Сонымен, таяқшаны Ахарен мырзаға беретін адам.
Dialogue: 0,0:07:31.74,0:07:35.91,Default,,0,0,0,,Ахарен мырза өзі беріп жатқан адаммен бірге жаттығу жасауды ұйғарды.
Dialogue: 0,0:07:35.99,0:07:39.12,Default,,0,0,0,,Тағы бір маңызды нәрсе - аяқтарыңызды қалай жылдамдатуға болады.
Dialogue: 0,0:07:39.20,0:07:43.33,Default,,0,0,0,,Сондай-ақ қысқа уақыт ішінде тиімді болатын кейбір жаттығулар бар.
Dialogue: 0,0:07:43.42,0:07:47.30,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:07:47.38,0:07:48.92,Default,,0,0,0,,Біріншіден, қалып
Dialogue: 0,0:07:49.01,0:07:51.84,Default,,0,0,0,,Арқаңызды тік ұстап жүгіруге тырысыңыз
Dialogue: 0,0:07:51.92,0:07:53.51,Default,,0,0,0,,Қолды сермеу
Dialogue: 0,0:07:53.59,0:07:56.26,Default,,0,0,0,,Шынтақтарды 90 градусқа бүгіп, күшті тербеліңіз
Dialogue: 0,0:07:57.31,0:08:00.31,Default,,0,0,0,,Саусақтарыңызды жоғары көтеру үшін аяқтарыңызбен жүгіріңіз.
Dialogue: 0,0:08:02.77,0:08:05.98,Default,,0,0,0,,Осы тармақтарды негізге ала отырып, жаттығуды жалғастырайық
Dialogue: 0,0:08:06.06,0:08:06.90,Default,,0,0,0,,Иә
Dialogue: 0,0:08:32.38,0:08:36.01,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:08:39.97,0:08:41.47,Default,,0,0,0,,Бұл керемет, Ахарен мырза.
Dialogue: 0,0:08:42.23,0:08:44.19,Default,,0,0,0,,Уақыт айтарлықтай жаңартылды.
Dialogue: 0,0:08:45.06,0:08:46.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:48.31,0:08:49.65,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:08:50.23,0:08:53.61,Default,,0,0,0,,Күте тұрыңыз... Ахарен мырза, бұл өте ауыр...
Dialogue: 0,0:08:53.69,0:08:55.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:55.28,0:08:57.07,Default,,0,0,0,,Бірақ мен бақыттымын
Dialogue: 0,0:08:57.16,0:09:02.54,Default,,0,0,0,,Райду-кунның арқасында мен бірінші рет жүгіру қызық болғандай сезіндім.
Dialogue: 0,0:09:03.12,0:09:04.25,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:04.83,0:09:06.21,Default,,0,0,0,,Иә
Dialogue: 0,0:09:06.29,0:09:09.13,Default,,0,0,0,,Себебі Ахарен мырза көп жұмыс істеді.
Dialogue: 0,0:09:09.21,0:09:10.92,Default,,0,0,0,,Осы қарқынмен бар күшімізді салайық.
Dialogue: 0,0:09:11.00,0:09:12.17,Default,,0,0,0,,Иә
Dialogue: 0,0:09:12.26,0:09:13.71,Default,,0,0,0,,Ахарен-сан Райду-кун!
Dialogue: 0,0:09:14.38,0:09:16.88,Default,,0,0,0,,Қатты! Ишикава-кун...
Dialogue: 0,0:09:16.97,0:09:18.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:21.35,0:09:24.81,Default,,0,0,0,,Кешіріңіз, мен мұны клуб іс-әрекетінде жасадым.
Dialogue: 0,0:09:24.89,0:09:26.69,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:09:26.77,0:09:28.98,Default,,0,0,0,,Оны аздап бұрағанда ғана сынбайды.
Dialogue: 0,0:09:29.06,0:09:31.90,Default,,0,0,0,,Бір аптаға жуық демалсаңыз жазылып кетеді.
Dialogue: 0,0:09:31.98,0:09:33.82,Default,,0,0,0,,Бір апта...
Dialogue: 0,0:09:33.90,0:09:36.07,Default,,0,0,0,,Спорт мерекесі осы аптада.
Dialogue: 0,0:09:36.15,0:09:39.41,Default,,0,0,0,,Аа, кешіріңіз... Мен жүгіре алмаймын.
Dialogue: 0,0:09:39.49,0:09:42.79,Default,,0,0,0,,-ға келгенде, реле қиын болады.
Dialogue: 0,0:09:44.16,0:09:45.37,Default,,0,0,0,,Ум...
Dialogue: 0,0:09:46.16,0:09:49.33,Default,,0,0,0,,Спорт мерекесінен үзіліс аламын ба?
Dialogue: 0,0:09:49.42,0:09:53.34,Default,,0,0,0,,Онда маған басқа біреу жүгіре алады.
Dialogue: 0,0:09:53.42,0:09:57.84,Default,,0,0,0,,Өйткені, мен ең баяумын...
Dialogue: 0,0:09:57.93,0:09:59.47,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:09:59.55,0:10:03.31,Default,,0,0,0,,Кім баяу немесе тітіркендіргіш екенін ойлаудың қажеті жоқ.
Dialogue: 0,0:10:03.39,0:10:09.31,Default,,0,0,0,,Бірақ мен өзімнің кесірімнен жеңіліп қалудан қорқамын...
Dialogue: 0,0:10:09.40,0:10:11.02,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:10:11.11,0:10:12.57,Default,,0,0,0,,Жеңілсем де
Dialogue: 0,0:10:12.65,0:10:14.15,Default,,0,0,0,,Ахарен мырзаны ешкім кінәламайды.
Dialogue: 0,0:10:14.23,0:10:16.36,Default,,0,0,0,,Менің ойымша, бұл жайсыздық емес.
Dialogue: 0,0:10:16.44,0:10:17.57,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:17.65,0:10:21.03,Default,,0,0,0,,Егер біреу қысылып қалса, біз бір-бірімізге көмектесуіміз керек.
Dialogue: 0,0:10:21.12,0:10:23.33,Default,,0,0,0,,Жеңілсең де ешкім кінәлі емес
Dialogue: 0,0:10:23.41,0:10:26.50,Default,,0,0,0,,Балалар, мені жақсы етіп көрсете алмайсыңдар.
Dialogue: 0,0:10:26.58,0:10:29.00,Default,,0,0,0,,Ишикава, дұрыс емделу керек!
Dialogue: 0,0:10:29.58,0:10:32.50,Default,,0,0,0,,үшін... Рахмет
Dialogue: 0,0:10:32.59,0:10:34.46,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:10:34.55,0:10:38.05,Default,,0,0,0,,Бірақ алмастырғыш якорь туралы не деуге болады?
Dialogue: 0,0:10:38.13,0:10:40.63,Default,,0,0,0,,Мен бұл туралы ойладым ...
Dialogue: 0,0:10:41.39,0:10:44.39,Default,,0,0,0,,Райду, сен мен үшін жүгіре аласың ба?
Dialogue: 0,0:10:45.14,0:10:46.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:08.25,0:11:09.08,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:12.46,0:11:13.29,Default,,0,0,0,,Хамф!
Dialogue: 0,0:11:14.59,0:11:16.38,Default,,0,0,0,,Келесі іс-шара екінші курс студенттеріне арналған.
Dialogue: 0,0:11:16.46,0:11:18.34,Default,,0,0,0,,Сынып сайысы, барлығы эстафета
Dialogue: 0,0:11:19.42,0:11:21.13,Default,,0,0,0,,Орнына тұру
Dialogue: 0,0:11:22.09,0:11:23.30,Default,,0,0,0,,Дайындау…
Dialogue: 0,0:11:23.39,0:11:24.39,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:11:29.52,0:11:31.39,Default,,0,0,0,,(Оқушылар қолдау көрсету)
Dialogue: 0,0:11:32.73,0:11:33.81,Default,,0,0,0,,Олай болса, Райду.
Dialogue: 0,0:11:33.90,0:11:36.32,Default,,0,0,0,,Мен өзіме якорь сұрадым.
Dialogue: 0,0:11:36.40,0:11:37.23,Default,,0,0,0,,О
Dialogue: 0,0:11:37.32,0:11:40.19,Default,,0,0,0,,Мен жұмыс тәртібін қайта қарауым керек.
Dialogue: 0,0:11:45.20,0:11:48.79,Default,,0,0,0,,үшінна менің бір ұсынысым бар.
Dialogue: 0,0:11:49.45,0:11:51.41,Default,,0,0,0,,В тобының үшінші жүйрігі Таманаха
Dialogue: 0,0:11:51.50,0:11:53.92,Default,,0,0,0,,Алдымдағы үш адамды бірден басып оздым!
Dialogue: 0,0:11:54.00,0:11:55.79,Default,,0,0,0,,Осымен В тобы 3-орынға көтерілді!
Dialogue: 0,0:11:55.88,0:11:57.71,Default,,0,0,0,,Таманаха-сан, мен мұны бір демде өте аламын деп ойлаймын.
Dialogue: 0,0:11:57.80,0:11:59.67,Default,,0,0,0,,Жақын арада эстафета беріледі.
Dialogue: 0,0:12:00.26,0:12:01.63,Default,,0,0,0,,Аха-чан!
Dialogue: 0,0:12:05.05,0:12:06.22,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:07.05,0:12:08.10,Default,,0,0,0,,Матадава
Dialogue: 0,0:12:08.18,0:12:09.64,Default,,0,0,0,,Не?
Dialogue: 0,0:12:09.72,0:12:11.10,Default,,0,0,0,,Осы уақытқа дейін В тобы
Dialogue: 0,0:12:11.18,0:12:14.52,Default,,0,0,0,,үшін таяқшаны астынан паспен бірге береді.
Dialogue: 0,0:12:14.60,0:12:16.61,Default,,0,0,0,,Әрі тегіс
Dialogue: 0,0:12:16.69,0:12:19.53,Default,,0,0,0,,Ол көп жаттығу жасаған болуы керек.
Dialogue: 0,0:12:19.61,0:12:21.49,Default,,0,0,0,,Таяқша жақсы жұмыс істейді.
Dialogue: 0,0:12:21.57,0:12:23.45,Default,,0,0,0,,Сәттілік Ахарен-сан
Dialogue: 0,0:12:24.03,0:12:26.49,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:12:26.57,0:12:27.41,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:28.20,0:12:29.91,Default,,0,0,0,,Осылай жаттығу жасайық
Dialogue: 0,0:12:30.49,0:12:32.96,Default,,0,0,0,,Рахмет сізге Райду-кун
Dialogue: 0,0:12:33.46,0:12:36.88,Default,,0,0,0,,Спорт мерекесінде үзіліс жасау сияқты ештеңе айтпаймын.
Dialogue: 0,0:12:37.46,0:12:40.63,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:12:50.60,0:12:51.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:55.52,0:12:59.52,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:13:02.86,0:13:04.36,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:13:04.45,0:13:08.24,Default,,0,0,0,,Ешкім... ешкім қашып құтылмады.
Dialogue: 0,0:13:08.82,0:13:09.83,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:11.04,0:13:15.29,Default,,0,0,0,,Ешкім...ешкім мені басып озған жоқ
Dialogue: 0,0:13:15.87,0:13:17.25,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.08,0:13:19.71,Default,,0,0,0,,Енді соңғы кезең.
Dialogue: 0,0:13:19.79,0:13:21.67,Default,,0,0,0,,Зәкірге тағы бір адам
Dialogue: 0,0:13:21.75,0:13:24.63,Default,,0,0,0,,Ой, В сыныбынан келген Оширо мырза, сіз жылдамсыз!
Dialogue: 0,0:13:24.72,0:13:27.59,Default,,0,0,0,,В тобы 2 орынға көтерілді!
Dialogue: 0,0:13:28.72,0:13:30.10,Default,,0,0,0,,Шынында да солай ма…
Dialogue: 0,0:13:30.85,0:13:32.06,Default,,0,0,0,,Шығу мүмкін емес
Dialogue: 0,0:13:36.10,0:13:38.48,Default,,0,0,0,,Эстафета соңында Анкорға берілді!
Dialogue: 0,0:13:38.56,0:13:41.15,Default,,0,0,0,,Бірінші орын А тобы, В тобын қуып келеді!
Dialogue: 0,0:13:41.23,0:13:42.48,Default,,0,0,0,,Райду-кун...
Dialogue: 0,0:13:42.57,0:13:46.36,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:13:46.45,0:13:48.82,Default,,0,0,0,,Күтілгендей, якорь жылдам.
Dialogue: 0,0:13:49.70,0:13:51.95,Default,,0,0,0,,Бірлескендердің барлығына
Dialogue: 0,0:13:52.62,0:13:55.96,Default,,0,0,0,,Маған сеніп, сеніп тапсырған Ишикава үшін.
Dialogue: 0,0:13:56.54,0:13:57.92,Default,,0,0,0,,Мен көп жұмыс істедім -
Dialogue: 0,0:13:58.50,0:14:00.21,Default,,0,0,0,,Ахарен мырза үшін
Dialogue: 0,0:14:00.88,0:14:01.75,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:01.84,0:14:03.71,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,0:14:04.30,0:14:05.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:05.26,0:14:06.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:06.97,0:14:07.84,Default,,0,0,0,,Мен жоғалтқым келеді...
Dialogue: 0,0:14:10.09,0:14:11.26,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:14:11.35,0:14:12.60,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:14:13.26,0:14:15.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:15.22,0:14:19.23,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:14:23.40,0:14:26.65,Default,,0,0,0,,Уау... мен жасадым! Керемет!
Dialogue: 0,0:14:28.70,0:14:31.24,Default,,0,0,0,,Құттықтаймыз Момо-чан
Dialogue: 0,0:14:31.32,0:14:33.58,Default,,0,0,0,,Бұл туралы барлығына айтыңыз.
Dialogue: 0,0:14:34.58,0:14:38.21,Default,,0,0,0,,Қазір барсам, соны көрсететініне сенімдімін.
Dialogue: 0,0:14:38.29,0:14:40.54,Default,,0,0,0,,Бұл жерге бармағаныңыз дұрыс...
Dialogue: 0,0:14:40.62,0:14:41.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:41.63,0:14:44.38,Default,,0,0,0,,Эй... Эй, Мия-чан-сенси.
Dialogue: 0,0:14:45.84,0:14:48.67,Default,,0,0,0,,Момохара мырза жасады!
Dialogue: 0,0:14:49.26,0:14:53.14,Default,,0,0,0,,Спорт мерекесінен кейін... Ахаре!
Dialogue: 0,0:14:53.22,0:14:54.35,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:14:54.43,0:14:55.64,Default,,0,0,0,,Момо-чан!
Dialogue: 0,0:14:58.73,0:15:00.10,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:00.10,0:15:02.06,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:00.10,0:15:02.06,Default,,0,0,0,,- (Оширо) Ишикава-кун - (Ишиква) Иә?
Dialogue: 0,0:15:03.52,0:15:05.52,Default,,0,0,0,,Өйткені мен сені төбеде көрдім
Dialogue: 0,0:15:06.11,0:15:08.40,Default,,0,0,0,,Райду тамаша жұмыс жасады.
Dialogue: 0,0:15:08.90,0:15:12.32,Default,,0,0,0,,Ол мен күткен нәрсені істегенде орындайтын жігіт.
Dialogue: 0,0:15:13.28,0:15:14.49,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:15:15.41,0:15:19.96,Default,,0,0,0,,Мен де зәкір ретінде бірінші орынды жеңіп алып, қаншалықты салқын екенімді көрсеткім келді.
Dialogue: 0,0:15:21.08,0:15:23.08,Default,,0,0,0,,Бұл ең маңызды кезде
Dialogue: 0,0:15:23.67,0:15:25.04,Default,,0,0,0,,Салқын емес
Dialogue: 0,0:15:25.13,0:15:27.76,Default,,0,0,0,,Мен… Ишикава-кун
Dialogue: 0,0:15:28.71,0:15:30.42,Default,,0,0,0,,Бұл керемет емес.
Dialogue: 0,0:15:30.92,0:15:32.72,Default,,0,0,0,,Мен қарап отырдым
Dialogue: 0,0:15:32.89,0:15:35.72,Default,,0,0,0,,Үйірме жұмыстары аяқталғаннан кейін де мен жүгіремін.
Dialogue: 0,0:15:35.80,0:15:38.81,Default,,0,0,0,,Ача, көрдің бе?
Dialogue: 0,0:15:38.89,0:15:41.52,Default,,0,0,0,,Егер сіз жарақат алсаңыз, сізде бала болмайды.
Dialogue: 0,0:15:41.60,0:15:43.19,Default,,0,0,0,,А, бұл ұят.
Dialogue: 0,0:15:43.27,0:15:45.19,Default,,0,0,0,,Мен ұялмаймын
Dialogue: 0,0:15:45.94,0:15:50.11,Default,,0,0,0,,Мен айтсам да, ол ештеңе істемеуі мүмкін.
Dialogue: 0,0:15:52.78,0:15:53.61,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:54.57,0:15:57.08,Default,,0,0,0,,Жоқ рахмет.
Dialogue: 0,0:16:00.62,0:16:02.75,Default,,0,0,0,,Ол шеңберге сыйып кету қиын...
Dialogue: 0,0:16:02.83,0:16:06.13,Default,,0,0,0,,Осы спорт мерекесінде кенеттен бір нәрсе жиналды.
Dialogue: 0,0:16:06.21,0:16:08.71,Default,,0,0,0,,Мен араласу одан да қиындай түскендей сезінемін.
Dialogue: 0,0:16:09.34,0:16:11.63,Default,,0,0,0,,Ишикава-кун жарақат алып, ауруханада жатыр.
Dialogue: 0,0:16:11.72,0:16:13.38,Default,,0,0,0,,- (Ер оқушы 2) Не? -(3-ші ер оқушы) Кеттік!
Dialogue: 0,0:16:15.55,0:16:16.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:16.51,0:16:19.64,Default,,0,0,0,,Иә? Таманаха мырза келді.
Dialogue: 0,0:16:19.72,0:16:21.98,Default,,0,0,0,,Сіз сонша жақын болдыңыз ба?
Dialogue: 0,0:16:22.85,0:16:24.35,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:24.60,0:16:25.44,Default,,0,0,0,,Сол күннен кейін сыныптағы атмосфера өзгерді.
Dialogue: 0,0:16:25.44,0:16:28.52,Default,,0,0,0,,Сол күннен кейін сыныптағы атмосфера өзгерді.
Dialogue: 0,0:16:25.44,0:16:28.52,Default,,0,0,0,,Васшои Васшои…
Dialogue: 0,0:16:29.44,0:16:32.99,Default,,0,0,0,,Рику Мен бұл сабақта жақсы оқи аламын ба деп ойлаймын...
Dialogue: 0,0:16:33.07,0:16:35.95,Default,,0,0,0,,Мұндай ойлау - жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:16:36.45,0:16:40.20,Default,,0,0,0,,Бар болуы керек! Рикудан басқа сыныпқа кірмейтін адамдар бар.
Dialogue: 0,0:16:40.29,0:16:42.29,Default,,0,0,0,,- (Ишикава) Таманаха-сан - Ах...
Dialogue: 0,0:16:42.37,0:16:45.04,Default,,0,0,0,,Жақсы жұмыс 1 орын Жақсы жұмыс
Dialogue: 0,0:16:45.12,0:16:47.75,Default,,0,0,0,,Иә... Бұл да жақсы жұмыс.
Dialogue: 0,0:16:48.46,0:16:50.71,Default,,0,0,0,,Мен бұл жігіттің есімі...
Dialogue: 0,0:16:51.88,0:16:54.59,Default,,0,0,0,,Мен сізге барлық сынып мүшелерінің тізімін жіберемін.
Dialogue: 0,0:16:54.68,0:16:55.93,Default,,0,0,0,,Исикава-кун
Dialogue: 0,0:16:56.01,0:17:01.56,Default,,0,0,0,,Иә? Ишикава-кун, жараланып, ауруханаға жіберілген Ишикава-кун ба?
Dialogue: 0,0:17:01.64,0:17:06.52,Default,,0,0,0,,Сенімен кездесуге келмегеніме мені кінәлау үшін шынымен сөйлестің бе?
Dialogue: 0,0:17:06.60,0:17:10.36,Default,,0,0,0,,Осындай жақсы қарым-қатынас қабілеті бар адамға жау болған кезде...
Dialogue: 0,0:17:10.44,0:17:11.28,Default,,0,0,0,,Таманаха
Dialogue: 0,0:17:11.36,0:17:12.32,Default,,0,0,0,,(реттелген дыбыс)
Dialogue: 0,0:17:12.40,0:17:13.24,Default,,0,0,0,,Меніңше...
Dialogue: 0,0:17:13.32,0:17:15.57,Default,,0,0,0,,Уау, бұл қорқынышты.
Dialogue: 0,0:17:15.65,0:17:17.57,Default,,0,0,0,,Жаман қауесет тарату
Dialogue: 0,0:17:17.66,0:17:20.45,Default,,0,0,0,,үшінна тез тарады.
Dialogue: 0,0:17:20.53,0:17:23.83,Default,,0,0,0,,Бір күнде сыныпта шеттетілген адам болды...
Dialogue: 0,0:17:23.91,0:17:25.66,Default,,0,0,0,,Таманаха мырза?
Dialogue: 0,0:17:26.17,0:17:27.54,Default,,0,0,0,,Кешіріңіз, Ишикава-кун.
Dialogue: 0,0:17:28.13,0:17:30.17,Default,,0,0,0,,Мен сізге қонаққа баруым керек...
Dialogue: 0,0:17:30.25,0:17:32.42,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:17:32.50,0:17:35.51,Default,,0,0,0,,Хабты пайдалануды тоқтатыңыз.
Dialogue: 0,0:17:35.59,0:17:37.09,Default,,0,0,0,,Жанашырлық?
Dialogue: 0,0:17:35.59,0:17:37.09,Default,,0,0,0,,(Рику жылайды)
Dialogue: 0,0:17:37.09,0:17:37.18,Default,,0,0,0,,(Рикудың айқайы)
Dialogue: 0,0:17:37.18,0:17:39.97,Default,,0,0,0,,(Рику жылайды)
Dialogue: 0,0:17:37.18,0:17:39.97,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:17:40.05,0:17:42.01,Default,,0,0,0,,-Шынымен бе? -(Ишикава) Иә.
Dialogue: 0,0:17:42.10,0:17:45.52,Default,,0,0,0,,Одан да, Таманаха-сан, сен жылдам едің.
Dialogue: 0,0:17:45.60,0:17:47.60,Default,,0,0,0,,3 адамды сабау керемет болды.
Dialogue: 0,0:17:47.69,0:17:50.15,Default,,0,0,0,,Сіз оны көрдіңіз бе? Рику туралы
Dialogue: 0,0:17:50.23,0:17:51.65,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:17:52.61,0:17:53.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:54.28,0:17:55.90,Default,,0,0,0,,Ишикава-кун…
Dialogue: 0,0:17:55.99,0:17:58.61,Default,,0,0,0,,Ол сондай жақсы адам еді!
Dialogue: 0,0:17:58.70,0:18:00.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:04.04,0:18:07.33,Default,,0,0,0,,Менің қымбат өтемдік демалыс күнім аяқталуға жақын.
Dialogue: 0,0:18:07.96,0:18:12.09,Default,,0,0,0,,Жалқау қыз болмау үшін сыртқа шыққан жақсы, бірақ
Dialogue: 0,0:18:12.17,0:18:15.21,Default,,0,0,0,,Бұл жерде ерекше ештеңе жоқ сияқты.
Dialogue: 0,0:18:16.22,0:18:17.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:17.13,0:18:18.88,Default,,0,0,0,,Аха-чан?
Dialogue: 0,0:18:18.97,0:18:20.80,Default,,0,0,0,,Бұл мүмкіндік
Dialogue: 0,0:18:20.89,0:18:24.01,Default,,0,0,0,,Ах-чан, сен не істеп жатырсың?
Dialogue: 0,0:18:24.10,0:18:29.02,Default,,0,0,0,,Мм... Сенің әпкең қайсысы?
Dialogue: 0,0:18:29.10,0:18:30.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:30.60,0:18:33.02,Default,,0,0,0,,Не, бұл не?
Dialogue: 0,0:18:33.11,0:18:36.69,Default,,0,0,0,,А-а, мұқият қарасаң, бірдеңе әдеттегіден басқаша көрінеді, Ах-чан.
Dialogue: 0,0:18:36.78,0:18:40.32,Default,,0,0,0,,Бұл дұрыс емес адам болуы мүмкін бе?
Dialogue: 0,0:18:40.41,0:18:43.03,Default,,0,0,0,,Ах... кешіріңіз... бұл...
Dialogue: 0,0:18:43.12,0:18:44.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:44.58,0:18:49.33,Default,,0,0,0,,Жақында басқа мектепке ауысқан бастауыш сыныптағы сыныптасы.
Dialogue: 0,0:18:49.41,0:18:50.33,Default,,0,0,0,,Рикусан!
Dialogue: 0,0:18:50.42,0:18:51.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:51.33,0:18:54.63,Default,,0,0,0,,Сіз Рикуды қайдан білесіз?
Dialogue: 0,0:18:54.71,0:18:57.21,Default,,0,0,0,,Мен Рейнаниден сұрадым.
Dialogue: 0,0:18:57.30,0:18:58.97,Default,,0,0,0,,Рейна, солай ма?
Dialogue: 0,0:18:59.05,0:19:01.68,Default,,0,0,0,,Мен Норен ағаммын.
Dialogue: 0,0:19:01.76,0:19:02.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:04.93,0:19:07.18,Default,,0,0,0,,Бұл шынымен жақсы ма? жартысында
Dialogue: 0,0:19:07.27,0:19:10.52,Default,,0,0,0,,Иә, біреуін жесең, қарын тоқ болады.
Dialogue: 0,0:19:10.60,0:19:12.94,Default,,0,0,0,,Мен күрішті жей алмаймын.
Dialogue: 0,0:19:13.02,0:19:15.90,Default,,0,0,0,,Мен Рикуне-ниді кездестіргеніме өте қуаныштымын.
Dialogue: 0,0:19:15.98,0:19:17.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:17.32,0:19:19.86,Default,,0,0,0,,Мен де ініммен жақсы дос болдым.
Dialogue: 0,0:19:19.95,0:19:22.36,Default,,0,0,0,,Осылай жүре берсек, ақыры...
Dialogue: 0,0:19:22.45,0:19:24.70,Default,,0,0,0,,Бүкіл отбасымен араласу үшін!
Dialogue: 0,0:19:24.78,0:19:27.74,Default,,0,0,0,,Аха-чанмен қарым-қатынасыңыз күшейе түседі.
Dialogue: 0,0:19:27.83,0:19:28.79,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:19:28.87,0:19:31.71,Default,,0,0,0,,Әй, бауырым, уайымың бар ма?
Dialogue: 0,0:19:31.79,0:19:34.38,Default,,0,0,0,,Әпкең сізбен ақылдасады.
Dialogue: 0,0:19:34.46,0:19:36.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:36.46,0:19:40.47,Default,,0,0,0,,Бастауыш сынып оқушыларының уайымдары оңай шешіледі.
Dialogue: 0,0:19:40.97,0:19:42.18,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:19:42.26,0:19:46.22,Default,,0,0,0,,Бір күні біздің мектепке шетелден ауысып келген бір бала болды.
Dialogue: 0,0:19:46.31,0:19:50.52,Default,,0,0,0,,Менің жапон тілім әлі онша жақсы емес, сондықтан мен басқалармен тіл табыса алмаймын.
Dialogue: 0,0:19:50.60,0:19:51.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:52.06,0:19:55.19,Default,,0,0,0,,Өткенде мен оған футбол ойнауды өтіндім.
Dialogue: 0,0:19:55.27,0:19:58.57,Default,,0,0,0,,Сіз бірге көңіл көтерген сияқтысыз...
Dialogue: 0,0:19:59.86,0:20:02.11,Default,,0,0,0,,Сізді шақырғаным дұрыс па?
Dialogue: 0,0:20:02.20,0:20:05.12,Default,,0,0,0,,Мүмкін мен футбол ойнағым келмеді
Dialogue: 0,0:20:05.20,0:20:09.58,Default,,0,0,0,,Кіші іні эпизодының қарым-қатынас қабілеті жоғары
Dialogue: 0,0:20:09.66,0:20:13.37,Default,,0,0,0,,Ал... жарайды, бұл уақыт пен жағдайға байланысты.
Dialogue: 0,0:20:13.46,0:20:14.92,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:20:15.67,0:20:18.17,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:20:18.25,0:20:21.51,Default,,0,0,0,,Келесі жолы мен сенің уайымыңды тыңдаймын.
Dialogue: 0,0:20:21.59,0:20:22.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:22.59,0:20:24.22,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:20:24.30,0:20:26.68,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:20:28.35,0:20:31.98,Default,,0,0,0,,Рикуне Менің достарым жоқ
Dialogue: 0,0:20:32.81,0:20:35.85,Default,,0,0,0,,Жоқ, бар, бірақ бар.
Dialogue: 0,0:20:35.94,0:20:38.77,Default,,0,0,0,,Қиындық тудырып, ұнатпай қалудан қорқамын.
Dialogue: 0,0:20:38.86,0:20:41.19,Default,,0,0,0,,Қобалжыйсың, ұстайсың.
Dialogue: 0,0:20:41.78,0:20:45.49,Default,,0,0,0,,Дос болғым келеді, бірақ не істерімді білмеймін...
Dialogue: 0,0:20:45.57,0:20:46.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:46.49,0:20:48.45,Default,,0,0,0,,Не туралы айтып тұрсың, Рику?
Dialogue: 0,0:20:48.53,0:20:51.37,Default,,0,0,0,,Бастауыш сынып оқушыларымен олардың маңызды мәселелері туралы сөйлесу...
Dialogue: 0,0:20:51.45,0:20:54.16,Default,,0,0,0,,Хмм, бұл...
Dialogue: 0,0:20:54.25,0:20:58.92,Default,,0,0,0,,Қиындық тудырудан қорықсаң, тіл табысу қиын.
Dialogue: 0,0:20:59.00,0:21:02.42,Default,,0,0,0,,Мен де қызық емеспін, сондықтан өзіңізді ашыңыз.
Dialogue: 0,0:21:02.51,0:21:05.30,Default,,0,0,0,,Қиындық туғызғанымыз үшін бір-бірімізді кешіруді үйренуіміз керек.
Dialogue: 0,0:21:05.38,0:21:08.14,Default,,0,0,0,,Менің ойымша, біз шынымен тіл табыса алмаймыз.
Dialogue: 0,0:21:08.22,0:21:11.81,Default,,0,0,0,,Сонда екеуміз де өзімізді еркін сезіндік.
Dialogue: 0,0:21:11.89,0:21:14.60,Default,,0,0,0,,Менің ойымша, біз жақсы дос бола аламыз.
Dialogue: 0,0:21:15.77,0:21:19.02,Default,,0,0,0,,Бұл жігіт екінші өмірінде ме?
Dialogue: 0,0:21:19.65,0:21:23.24,Default,,0,0,0,,А, мен түсіндім. Менде де сол проблема.
Dialogue: 0,0:21:23.32,0:21:25.90,Default,,0,0,0,,Эй, сен мені түсіндірдің.
Dialogue: 0,0:21:25.99,0:21:27.11,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:21:27.20,0:21:28.20,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:21:28.28,0:21:29.53,Default,,0,0,0,,Рен
Dialogue: 0,0:21:29.62,0:21:31.24,Default,,0,0,0,,Рейна-ни!
Dialogue: 0,0:21:31.33,0:21:33.12,Default,,0,0,0,,Бұл Тама-чан
Dialogue: 0,0:21:33.20,0:21:35.87,Default,,0,0,0,,Білесің бе, білесің, ғажап!
Dialogue: 0,0:21:35.96,0:21:39.17,Default,,0,0,0,,Мен Рикуне-ниден өз уайымым туралы сөйлесуін өтіндім.
Dialogue: 0,0:21:39.25,0:21:40.84,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:21:40.92,0:21:42.21,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:43.59,0:21:46.97,Default,,0,0,0,,Олай болса, мен де сенен толғандыратын мәселелер туралы сұрағым келеді.
Dialogue: 0,0:21:47.55,0:21:49.76,Default,,0,0,0,,Аха-чанның мәселесі?
Dialogue: 0,0:21:49.85,0:21:51.56,Default,,0,0,0,,Мұндай таңдау
Dialogue: 0,0:21:51.64,0:21:53.97,Default,,0,0,0,,Жігітіңізбен махаббат қиындықтары
Dialogue: 0,0:21:54.64,0:21:58.19,Default,,0,0,0,,Махаббатта тәжірибесі жоқ Рику үшін бұл тым ауыр жүк!
Dialogue: 0,0:21:58.27,0:21:59.69,Default,,0,0,0,,Жақында менің шашым...
Dialogue: 0,0:21:59.77,0:22:00.94,Default,,0,0,0,,Н... Жоқ, бұл біз оны қуып жетуіміз керек емес дегенді білдірмейді!
Dialogue: 0,0:22:01.02,0:22:03.90,Default,,0,0,0,,Сұрақтарыңыз болса, жабықпыз!
Dialogue: 0,0:22:06.36,0:22:08.66,Default,,0,0,0,,Рен Көңілді болды ма?
Dialogue: 0,0:22:08.74,0:22:11.99,Default,,0,0,0,,Иә! Рикуни жақсы адам еді.
Dialogue: 0,0:22:12.08,0:22:15.29,Default,,0,0,0,,-Бұл жақсы. -Апыр-ай!
Dialogue: 0,0:22:16.04,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:40.96,0:23:45.96,Default,,0,0,0,,～♪
