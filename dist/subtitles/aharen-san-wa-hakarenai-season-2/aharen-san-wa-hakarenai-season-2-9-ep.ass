Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.92,0:00:09.34,Default,,0,0,0,,Қайта жанымдағы орындық.
Dialogue: 0,0:00:10.63,0:00:12.67,Default,,0,0,0,,Сіз үшінші курс студенті болсаңыз да, танысқаныма қуаныштымын
Dialogue: 0,0:00:12.76,0:00:14.30,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:00:14.38,0:00:17.68,Default,,0,0,0,,Оширо мырза, сізді осы жылы тағы көреміз деп үміттенеміз.
Dialogue: 0,0:00:17.76,0:00:19.85,Default,,0,0,0,,Сіздің сынып мұғалімі қандай адам?
Dialogue: 0,0:00:19.93,0:00:20.89,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:19.93,0:00:20.89,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:20.89,0:00:20.97,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:20.97,0:00:23.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:23.60,0:00:25.06,Default,,0,0,0,,Эй, міне.
Dialogue: 0,0:00:27.27,0:00:30.40,Default,,0,0,0,,Үй бөлмесі уақытында басталады
Dialogue: 0,0:00:31.65,0:00:33.36,Default,,0,0,0,,Барлығыңызбен танысқаныма қуаныштымын.
Dialogue: 0,0:00:33.45,0:00:36.36,Default,,0,0,0,,Мен 3-сыныптың 1-сыныбына сынып жетекшісі боламын.
Dialogue: 0,0:00:36.45,0:00:37.37,Default,,0,0,0,,Хейан тауы
Dialogue: 0,0:00:38.12,0:00:41.83,Default,,0,0,0,,Бірінші мектеп Бірінші оқушы
Dialogue: 0,0:00:41.91,0:00:43.46,Default,,0,0,0,,Мен қобалжыдым
Dialogue: 0,0:00:43.54,0:00:44.37,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:44.46,0:00:46.92,Default,,0,0,0,,Сіздің арманыңыз сіздікі!
Dialogue: 0,0:00:47.00,0:00:50.63,Default,,0,0,0,,Менің бала кезімдегі арманым мұғалім болу еді.
Dialogue: 0,0:00:51.55,0:00:54.22,Default,,0,0,0,,Барлығы, мен бұл сабаққа қатысып жатырмын.
Dialogue: 0,0:00:54.84,0:00:57.84,Default,,0,0,0,,Мен құмарлық пен махаббатқа толы сынып болғым келеді!
Dialogue: 0,0:00:58.72,0:01:00.39,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:01:01.06,0:01:06.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:25.72,0:02:29.73,Default,,0,0,0,,～♪
Dialogue: 0,0:02:33.23,0:02:35.86,Default,,0,0,0,,Райду-кун Ахарен-кун
Dialogue: 0,0:02:36.44,0:02:41.32,Default,,0,0,0,,Мен Момохара-сенпайдан естідім, екеуіңнің қызығатын адамсыңдар.
Dialogue: 0,0:02:41.41,0:02:44.49,Default,,0,0,0,,Екеуінің бір-біріне деген өшпенділігі күшті сияқты.
Dialogue: 0,0:02:44.58,0:02:47.16,Default,,0,0,0,,Менің ойымша бұл нені білдіреді...
Dialogue: 0,0:02:48.08,0:02:48.91,Default,,0,0,0,,Қарын нан
Dialogue: 0,0:02:49.00,0:02:52.79,Default,,0,0,0,,Бұл күшті соққы Момохара-сенпайға кері әсер қалдырды.
Dialogue: 0,0:02:52.88,0:02:55.09,Default,,0,0,0,,Ол мені жиі қан құсады.
Dialogue: 0,0:02:55.17,0:02:58.92,Default,,0,0,0,,Мұғалімге қол көтергені қандай жаман оқушы!
Dialogue: 0,0:02:59.01,0:03:01.18,Default,,0,0,0,,Ендеше, кітапты асқазанға дұрыстап сал.
Dialogue: 0,0:03:01.26,0:03:03.05,Default,,0,0,0,,Іштің майлануының алдын алу шараларын қолдандым.
Dialogue: 0,0:03:03.14,0:03:05.85,Default,,0,0,0,,Неғұрлым нашар болса, соғұрлым оқыту сауапты болады.
Dialogue: 0,0:03:05.93,0:03:07.77,Default,,0,0,0,,Жүр, суланайық.
Dialogue: 0,0:03:07.85,0:03:11.10,Default,,0,0,0,,Жоқ! Ахарен-кун Райду-кун
Dialogue: 0,0:03:11.19,0:03:12.69,Default,,0,0,0,,Қ... Қандай...
Dialogue: 0,0:03:12.77,0:03:14.56,Default,,0,0,0,,Мазасыз сынып?
Dialogue: 0,0:03:15.23,0:03:17.69,Default,,0,0,0,,Сіз өзіңіздің жаңа позицияңызды арандатып жатырсыз ба?
Dialogue: 0,0:03:17.78,0:03:19.15,Default,,0,0,0,,Осындай кезде...
Dialogue: 0,0:03:19.24,0:03:21.36,Default,,0,0,0,,Оқу жоспары бойынша нұсқаулар!
Dialogue: 0,0:03:21.45,0:03:25.33,Default,,0,0,0,,Бұл кітапта осындай жағдайлардан қалай шығу керектігі туралы ақпарат болуы керек.
Dialogue: 0,0:03:27.49,0:03:28.70,Default,,0,0,0,,Тізімде жоқ
Dialogue: 0,0:03:28.79,0:03:31.54,Default,,0,0,0,,Болды... Кенет тығырыққа тіреледі.
Dialogue: 0,0:03:31.62,0:03:34.42,Default,,0,0,0,,Мен мұғалім құқығынан айырылдым.
Dialogue: 0,0:03:34.50,0:03:37.21,Default,,0,0,0,,Ахарен-сан мұғалім, менің алдымда Хигакунның арқасында.
Dialogue: 0,0:03:37.30,0:03:39.42,Default,,0,0,0,,Мен тақтаны көрмей тұрған сияқтымын.
Dialogue: 0,0:03:39.51,0:03:40.97,Default,,0,0,0,,Дұрыс, Райду.
Dialogue: 0,0:03:41.05,0:03:41.88,Default,,0,0,0,,О
Dialogue: 0,0:03:41.97,0:03:44.34,Default,,0,0,0,,Ха! Рахмет Ишикава-кун
Dialogue: 0,0:03:44.43,0:03:46.85,Default,,0,0,0,,Мен сізге келесі сынақта 50 000 ұпай беремін.
Dialogue: 0,0:03:46.93,0:03:49.97,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:03:50.06,0:03:53.31,Default,,0,0,0,,Менің ойымша, біз отыру тәртібін қайта қарауымыз керек.
Dialogue: 0,0:03:53.39,0:03:55.31,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:03:55.40,0:03:58.15,Default,,0,0,0,,Жарайды, барлығымыз орындарымызды ауыстырайық.
Dialogue: 0,0:04:00.99,0:04:02.90,Default,,0,0,0,,Қайта жанымдағы орындық.
Dialogue: 0,0:04:02.99,0:04:03.99,Default,,0,0,0,,Иә
Dialogue: 0,0:04:04.70,0:04:06.32,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:04:06.41,0:04:08.66,Default,,0,0,0,,(кружканы қою дыбысы)
Dialogue: 0,0:04:08.74,0:04:12.25,Default,,0,0,0,,Фаха! Бірінші күні мен шаршадым!
Dialogue: 0,0:04:12.33,0:04:14.58,Default,,0,0,0,,Жақсы жұмыс...
Dialogue: 0,0:04:15.29,0:04:19.34,Default,,0,0,0,,Мен енді қолымнан келе ме деп уайымдаймын.
Dialogue: 0,0:04:19.42,0:04:21.17,Default,,0,0,0,,Оқушылар маған көмектесетін сияқты.
Dialogue: 0,0:04:21.26,0:04:23.09,Default,,0,0,0,,Сіз мұғалім ретінде құқығыңыздан айырылдыңыз, солай ма?
Dialogue: 0,0:04:23.17,0:04:24.38,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:04:24.47,0:04:25.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:25.39,0:04:28.10,Default,,0,0,0,,Басқаларға сенбеу - өзін-өзі қамтамасыз етпеу.
Dialogue: 0,0:04:28.18,0:04:30.77,Default,,0,0,0,,Басқаларға жақсы сенім артқанда ғана толыққанды адам бола аласыз.
Dialogue: 0,0:04:30.85,0:04:34.02,Default,,0,0,0,,Сондықтан сіз маған және менің оқушыларыма сене аласыз.
Dialogue: 0,0:04:34.10,0:04:36.85,Default,,0,0,0,,Біркелкі сабақтар оқушылардың ынтымақтастығына байланысты.
Dialogue: 0,0:04:36.94,0:04:39.07,Default,,0,0,0,,Мен осы өмірді он жылдан астам уақыт бойы кешіп келемін
Dialogue: 0,0:04:39.15,0:04:41.40,Default,,0,0,0,,...Менің ойымша...
Dialogue: 0,0:04:41.48,0:04:43.44,Default,,0,0,0,,Қазірдің өзінде~ Момо-чан, сен көп ішіп алдың.
Dialogue: 0,0:04:43.53,0:04:45.53,Default,,0,0,0,,Салқын болса да
Dialogue: 0,0:04:45.61,0:04:47.12,Default,,0,0,0,,Бірақ бәрібір мен
Dialogue: 0,0:04:47.20,0:04:51.16,Default,,0,0,0,,Мен Райду-кун мен Ахарен-кунның қарым-қатынасын түсінбеймін...
Dialogue: 0,0:04:51.24,0:04:52.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:55.29,0:04:57.08,Default,,0,0,0,,Өсек болса, сол екеуі
Dialogue: 0,0:04:57.17,0:04:58.54,Default,,0,0,0,,Осындай уақытта...
Dialogue: 0,0:04:59.84,0:05:01.00,Default,,0,0,0,,Мен сен осы тасты жарып өте алмайсың деп ойладым…
Dialogue: 0,0:05:01.09,0:05:03.01,Default,,0,0,0,,Осындай уақытта орта мектеп оқушысы...
Dialogue: 0,0:05:03.09,0:05:05.43,Default,,0,0,0,,Мен өзімді аздап жаман нәрсе істеп жатқандай сезінуім керек.
Dialogue: 0,0:05:06.01,0:05:08.51,Default,,0,0,0,,Бұрын-соңды болмаған түнгі кездесу
Dialogue: 0,0:05:09.10,0:05:11.31,Default,,0,0,0,,Әдепсіз түнде кездесу
Dialogue: 0,0:05:11.39,0:05:13.02,Default,,0,0,0,,Кьяа Момо-чан!
Dialogue: 0,0:05:13.10,0:05:14.77,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:05:14.85,0:05:17.48,Default,,0,0,0,,Мен бұған сене алмадым!
Dialogue: 0,0:05:18.44,0:05:20.40,Default,,0,0,0,,соншалықты алыс болғанымен?
Dialogue: 0,0:05:20.48,0:05:23.07,Default,,0,0,0,,Момо-чан, әрқашан осылай.
Dialogue: 0,0:05:23.15,0:05:26.07,Default,,0,0,0,,Физикалық тұрғыдан әлсіз болсам да, мен ішімдікті жақсы көремін...
Dialogue: 0,0:05:26.86,0:05:29.03,Default,,0,0,0,,Әй, сәл жат.
Dialogue: 0,0:05:31.58,0:05:33.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:31.58,0:05:33.20,Default,,0,0,0,,(Хейан тауының жүрек соғысы)
Dialogue: 0,0:05:33.20,0:05:33.79,Default,,0,0,0,,(Хейан тауының жүрек соғысы)
Dialogue: 0,0:05:33.79,0:05:36.16,Default,,0,0,0,,(Хейан тауының жүрек соғысы)
Dialogue: 0,0:05:33.79,0:05:36.16,Default,,0,0,0,,Мен туралы бірдеңе...
Dialogue: 0,0:05:36.25,0:05:38.17,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 0,0:05:38.96,0:05:41.29,Default,,0,0,0,,Менің кеудем ауырады...
Dialogue: 0,0:05:41.38,0:05:42.63,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:42.71,0:05:44.13,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:05:44.21,0:05:46.84,Default,,0,0,0,,Менің де көңілім қалды!
Dialogue: 0,0:05:46.92,0:05:49.14,Default,,0,0,0,,О, Құдайым...
Dialogue: 0,0:05:49.93,0:05:51.55,Default,,0,0,0,,Хэянцан-чанға дейін?
Dialogue: 0,0:05:53.60,0:05:55.81,Default,,0,0,0,,Сәлеметсіз бе, Хэянзан мырза
Dialogue: 0,0:05:55.89,0:05:57.27,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:05:58.27,0:06:01.81,Default,,0,0,0,,Мұғалім болу бос емес, бірақ пайдалы.
Dialogue: 0,0:06:01.90,0:06:03.61,Default,,0,0,0,,Біздің мақсатымыз...
Dialogue: 0,0:06:04.19,0:06:06.07,Default,,0,0,0,,Сенімді мұғалім
Dialogue: 0,0:06:07.15,0:06:09.86,Default,,0,0,0,,Мұғалім, мен бір нәрсені түсінбеймін.
Dialogue: 0,0:06:09.95,0:06:12.58,Default,,0,0,0,,Иә, кез келген нәрседе маған сеніңіз.
Dialogue: 0,0:06:12.66,0:06:14.41,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:14.49,0:06:17.37,Default,,0,0,0,,Ахарен-кун толығымен өзгерді ме?
Dialogue: 0,0:06:17.46,0:06:19.08,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,0:06:19.17,0:06:22.50,Default,,0,0,0,,Тәжірибе үстелі ретінде пайдаланылғаннан кейін осылай көрінесіз бе?
Dialogue: 0,0:06:22.59,0:06:24.67,Default,,0,0,0,,Ахарен-санның денесі керілген кезде
Dialogue: 0,0:06:24.75,0:06:27.80,Default,,0,0,0,,Шатасып қалдым, не істеуім керек?
Dialogue: 0,0:06:28.51,0:06:31.64,Default,,0,0,0,,Қабырғалар бұрынғыдан да ашық
Dialogue: 0,0:06:31.72,0:06:33.35,Default,,0,0,0,,Онымен қалай күресуге болады
Dialogue: 0,0:06:33.43,0:06:36.10,Default,,0,0,0,,Осы студенттік нұсқаулықта...
Dialogue: 0,0:06:38.06,0:06:41.52,Default,,0,0,0,,Бұл тізімде жоқ!
Dialogue: 0,0:06:41.60,0:06:43.23,Default,,0,0,0,,Ах, мен емделдім.
Dialogue: 0,0:06:43.31,0:06:46.03,Default,,0,0,0,,Созылу жақсы сезінді
Dialogue: 0,0:06:47.19,0:06:48.99,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:49.07,0:06:52.03,Default,,0,0,0,,Мен өзімді білмеймін
Dialogue: 0,0:06:52.12,0:06:53.28,Default,,0,0,0,,Хиранзан Сенсей
Dialogue: 0,0:06:54.28,0:06:56.41,Default,,0,0,0,,Момохара Сенпай
Dialogue: 0,0:06:58.45,0:07:02.29,Default,,0,0,0,,(Хейанзан тауларының ауыр тыныс алуы)
Dialogue: 0,0:07:03.33,0:07:06.75,Default,,0,0,0,,Денені мезгіл-мезгіл қозғалту маңызды.
Dialogue: 0,0:07:06.84,0:07:08.26,Default,,0,0,0,,Иә, Сенпай
Dialogue: 0,0:07:08.84,0:07:11.13,Default,,0,0,0,,Неліктен мен де жүгіремін?
Dialogue: 0,0:07:11.22,0:07:14.55,Default,,0,0,0,,Мия-чан да денесін қозғалтуы керек.
Dialogue: 0,0:07:14.64,0:07:16.93,Default,,0,0,0,,Мен дене шынықтыру пәнінің мұғалімі болсам да!
Dialogue: 0,0:07:17.81,0:07:20.14,Default,,0,0,0,,Бұл әлі де қиын
Dialogue: 0,0:07:20.81,0:07:22.60,Default,,0,0,0,,Сондай кездерде, ойланбастан
Dialogue: 0,0:07:22.69,0:07:25.31,Default,,0,0,0,,Тек аяғыңызды алға қоя беріңіз.
Dialogue: 0,0:07:25.40,0:07:27.07,Default,,0,0,0,,Сонда ол ұзағырақ болады
Dialogue: 0,0:07:27.15,0:07:30.24,Default,,0,0,0,,Мен әрқашан Хейан тауы туралы тым көп ойлайтын сияқтымын.
Dialogue: 0,0:07:30.32,0:07:33.07,Default,,0,0,0,,Кейде ештеңе туралы ойламау маңызды.
Dialogue: 0,0:07:33.74,0:07:35.28,Default,,0,0,0,,Сіздер жазды қалай өткізіп жатырсыздар?
Dialogue: 0,0:07:35.37,0:07:39.04,Default,,0,0,0,,Өйткені мен әдетте ештеңе туралы ойламаймын.
Dialogue: 0,0:07:39.12,0:07:40.62,Default,,0,0,0,,Мен тоқтай аламын ба?
Dialogue: 0,0:07:40.71,0:07:42.25,Default,,0,0,0,,Жоқ, жалғастырыңыз.
Dialogue: 0,0:07:42.33,0:07:43.88,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:45.25,0:07:48.30,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:07:48.38,0:07:51.05,Default,,0,0,0,,Жарайсыңдар, жақсы жұмыс жасадыңдар.
Dialogue: 0,0:07:53.13,0:07:54.76,Default,,0,0,0,,Хейан тауы
Dialogue: 0,0:07:55.34,0:07:57.26,Default,,0,0,0,,Әртүрлі нәрселер туралы ойлану жақсы.
Dialogue: 0,0:07:57.35,0:08:00.31,Default,,0,0,0,,Бірақ көп ойлану жақсы емес
Dialogue: 0,0:08:00.39,0:08:02.94,Default,,0,0,0,,Қиындыққа тап болсаң, мен бірдеңе істеймін.
Dialogue: 0,0:08:03.52,0:08:06.40,Default,,0,0,0,,Кейде оқушыларды денеңмен ұру керек.
Dialogue: 0,0:08:06.48,0:08:07.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:08.27,0:08:10.19,Default,,0,0,0,,Мен қазір аң-таң болғандай сезінемін...
Dialogue: 0,0:08:10.28,0:08:11.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.19,0:08:13.11,Default,,0,0,0,,Сәлеметсіз бе, мұғалім
Dialogue: 0,0:08:13.20,0:08:15.28,Default,,0,0,0,,Оширо-кун, қандай кездейсоқтық.
Dialogue: 0,0:08:15.36,0:08:16.95,Default,,0,0,0,,Сіз де осы жаттығу залындасыз ба?
Dialogue: 0,0:08:17.03,0:08:19.29,Default,,0,0,0,,Иә, мен сонда барамын.
Dialogue: 0,0:08:19.37,0:08:20.24,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:08:20.33,0:08:23.16,Default,,0,0,0,,Шетелге дайындалып жатырсыз ба?
Dialogue: 0,0:08:23.25,0:08:25.08,Default,,0,0,0,,Иә... жақсы
Dialogue: 0,0:08:26.92,0:08:28.42,Default,,0,0,0,,Оширо мырза
Dialogue: 0,0:08:29.38,0:08:32.26,Default,,0,0,0,,Сіз матч ұйымдастыра аласыз ба?
Dialogue: 0,0:08:38.10,0:08:39.14,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:08:39.22,0:08:40.47,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:08:41.31,0:08:42.43,Default,,0,0,0,,Әй
Dialogue: 0,0:08:42.52,0:08:43.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:44.98,0:08:45.81,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:46.73,0:08:47.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:47.77,0:08:48.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:49.19,0:08:50.82,Default,,0,0,0,,Керемет сенпай
Dialogue: 0,0:08:50.90,0:08:53.65,Default,,0,0,0,,Мен бұл соққының бәрін қайтардым.
Dialogue: 0,0:08:53.74,0:08:55.57,Default,,0,0,0,,Бұл күнделікті өмірде
Dialogue: 0,0:08:55.66,0:08:58.78,Default,,0,0,0,,Таңдануды қайтару арқылы білдім.
Dialogue: 0,0:08:58.87,0:09:00.79,Default,,0,0,0,,Қоян Париж!
Dialogue: 0,0:09:00.87,0:09:03.87,Default,,0,0,0,,Оширо-сан, сен әлі абдырап тұрған сияқтысың.
Dialogue: 0,0:09:03.96,0:09:07.58,Default,,0,0,0,,Мені жалғыз жеңе алмасаң, шетел әлі алыс!
Dialogue: 0,0:09:07.67,0:09:09.96,Default,,0,0,0,,Ах! Түсінемін, Сенпай
Dialogue: 0,0:09:10.04,0:09:12.55,Default,,0,0,0,,Бұл тәжірибелік оқыту.
Dialogue: 0,0:09:12.63,0:09:14.42,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:09:14.51,0:09:15.84,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:15.93,0:09:16.76,Default,,0,0,0,,Ах
Dialogue: 0,0:09:16.84,0:09:19.22,Default,,0,0,0,,Бос орын Аға жеңеді!
Dialogue: 0,0:09:19.30,0:09:21.31,Default,,0,0,0,,Оширо мырза!
Dialogue: 0,0:09:21.89,0:09:23.39,Default,,0,0,0,,Таманаха-сан!
Dialogue: 0,0:09:23.47,0:09:24.64,Default,,0,0,0,,Жақында...
Dialogue: 0,0:09:25.35,0:09:27.44,Default,,0,0,0,,Екеуміз көптен бірге болдық.
Dialogue: 0,0:09:28.60,0:09:30.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:30.19,0:09:34.44,Default,,0,0,0,,Оширо мырзаның екіталайлығы достары туралы ойлағандықтан болды.
Dialogue: 0,0:09:35.19,0:09:38.53,Default,,0,0,0,,Жақын достан алыс...
Dialogue: 0,0:09:38.61,0:09:40.28,Default,,0,0,0,,Жоғарғы жолды білу
Dialogue: 0,0:09:40.37,0:09:41.78,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:09:41.87,0:09:44.45,Default,,0,0,0,,Оширо мырза жеңеді.
Dialogue: 0,0:09:46.58,0:09:49.00,Default,,0,0,0,,Сенпай, жақсысың ба?
Dialogue: 0,0:09:49.08,0:09:50.88,Default,,0,0,0,,Оширо мырза
Dialogue: 0,0:09:50.96,0:09:54.17,Default,,0,0,0,,Сенің зардап шекпегеніңе қуаныштымын!
Dialogue: 0,0:09:55.05,0:09:57.80,Default,,0,0,0,,Уф! Менің кеудем қайтадан ауырады ...
Dialogue: 0,0:09:57.88,0:09:58.80,Default,,0,0,0,,Бұл екі...
Dialogue: 0,0:09:58.88,0:10:00.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:00.47,0:10:02.10,Default,,0,0,0,,Шабуыл...
Dialogue: 0,0:10:02.18,0:10:03.10,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:10:03.85,0:10:05.47,Default,,0,0,0,,Сіз де бұған таң қалдыңыз ба?
Dialogue: 0,0:10:05.56,0:10:08.19,Default,,0,0,0,,Басқаша айтқанда, Хабардар - жоғалып кететін соққы!
Dialogue: 0,0:10:08.27,0:10:10.69,Default,,0,0,0,,Соқыр жерден соққы тигенше байқамайсың.
Dialogue: 0,0:10:10.77,0:10:12.65,Default,,0,0,0,,Мен жоғалып кеткендей болдым
Dialogue: 0,0:10:12.73,0:10:15.28,Default,,0,0,0,,А-а, сен маған шабуыл жасайсың деп ойлау үшін...
Dialogue: 0,0:10:15.36,0:10:17.78,Default,,0,0,0,,Менің ішімде кітап жоқ еді.
Dialogue: 0,0:10:17.86,0:10:19.49,Default,,0,0,0,,Мистер Хайанзан да?
Dialogue: 0,0:10:26.25,0:10:28.37,Default,,0,0,0,,Олай болса кіріңіз.
Dialogue: 0,0:10:29.67,0:10:30.71,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:32.50,0:10:35.71,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:10:35.80,0:10:37.13,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:37.21,0:10:39.09,Default,,0,0,0,,Мицуки Оширо
Dialogue: 0,0:10:39.18,0:10:41.34,Default,,0,0,0,,Бұл бала да қызық адам
Dialogue: 0,0:10:41.43,0:10:44.51,Default,,0,0,0,,Райду-кун Ахарен-куннан жақсы...
Dialogue: 0,0:10:44.60,0:10:45.47,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:45.56,0:10:46.56,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:48.77,0:10:50.27,Default,,0,0,0,,Жауынгерлік фракция
Dialogue: 0,0:10:50.85,0:10:54.48,Default,,0,0,0,,Бүгін мен әдеттегіден екі есе көп кітап әкелдім.
Dialogue: 0,0:10:54.57,0:10:56.90,Default,,0,0,0,,Енді жарысайық
Dialogue: 0,0:10:56.98,0:10:58.44,Default,,0,0,0,,Бірінші, Оширо-кун
Dialogue: 0,0:10:58.53,0:11:00.82,Default,,0,0,0,,Сіз қалаған мансап жолы.
Dialogue: 0,0:11:00.91,0:11:04.41,Default,,0,0,0,,Шетелде сұлулық мектебінде оқу дұрыс па?
Dialogue: 0,0:11:05.45,0:11:06.66,Default,,0,0,0,,Иә
Dialogue: 0,0:11:06.74,0:11:07.95,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:11:08.70,0:11:10.66,Default,,0,0,0,,Сіз уайымдап тұрған сияқтысыз.
Dialogue: 0,0:11:10.75,0:11:13.58,Default,,0,0,0,,Мұғалімге бірдеңе айтқың келеді.
Dialogue: 0,0:11:13.67,0:11:16.05,Default,,0,0,0,,Мазасыздық?
Dialogue: 0,0:11:16.13,0:11:18.30,Default,,0,0,0,,Мм... мен оны білдім.
Dialogue: 0,0:11:18.38,0:11:21.80,Default,,0,0,0,,Спортпен айналысу үшін шетелде оқыған дұрыс па?
Dialogue: 0,0:11:21.88,0:11:23.72,Default,,0,0,0,,Әрине, Оширо-кун
Dialogue: 0,0:11:23.80,0:11:27.97,Default,,0,0,0,,Біз университеттерден және басқа мекемелерден спорттық ұсыныстар мен шәкіртақыға шақырулар аламыз.
Dialogue: 0,0:11:28.06,0:11:30.27,Default,,0,0,0,,Күшті спортшылар туралы да айтылады.
Dialogue: 0,0:11:30.35,0:11:34.02,Default,,0,0,0,,Егер біз осы жолмен жүрсек, мен мектепті мақтан етер едім.
Dialogue: 0,0:11:34.65,0:11:37.98,Default,,0,0,0,,Бірақ сіздің армандарыңыз сіздікі.
Dialogue: 0,0:11:38.07,0:11:41.95,Default,,0,0,0,,Оширо-кун ең көп істегісі келетін нәрсені істеуі керек.
Dialogue: 0,0:11:42.03,0:11:45.91,Default,,0,0,0,,Мен не істегім келеді...
Dialogue: 0,0:11:48.70,0:11:49.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:53.92,0:11:57.09,Default,,0,0,0,,Мен көремін. Бұл Оширо-кун...
Dialogue: 0,0:11:57.17,0:12:00.30,Default,,0,0,0,,Иә, мен мұны ең қатты қалаймын.
Dialogue: 0,0:12:01.17,0:12:02.51,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:03.09,0:12:06.72,Default,,0,0,0,,Мен оны ұялшақ бала деп ойладым, бірақ ол өте сенімді.
Dialogue: 0,0:12:06.80,0:12:09.68,Default,,0,0,0,,Бұл да менің жақсы достарымның арқасында деп ойлаймын.
Dialogue: 0,0:12:10.56,0:12:11.98,Default,,0,0,0,,Шетелдіктер алыс
Dialogue: 0,0:12:12.06,0:12:15.44,Default,,0,0,0,,Сізді отбасыңыз бен достарыңыздан бөлек тұруға алаңдатуыңыз мүмкін.
Dialogue: 0,0:12:15.52,0:12:18.94,Default,,0,0,0,,Бірақ кету қоштасу емес.
Dialogue: 0,0:12:19.02,0:12:20.94,Default,,0,0,0,,Алыстан да достар
Dialogue: 0,0:12:21.03,0:12:22.82,Default,,0,0,0,,Өтінемін, мені бақылаңыз.
Dialogue: 0,0:12:25.20,0:12:26.45,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:26.53,0:12:29.20,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:12:31.91,0:12:34.12,Default,,0,0,0,,Момохара-сенпай, солай ма?
Dialogue: 0,0:12:34.12,0:12:35.33,Default,,0,0,0,,Момохара-сенпай, солай ма?
Dialogue: 0,0:12:34.12,0:12:35.33,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:35.33,0:12:35.42,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:35.42,0:12:36.25,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:35.42,0:12:36.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:36.33,0:12:39.00,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:12:39.71,0:12:40.67,Default,,0,0,0,,'Бұл не?'
Dialogue: 0,0:12:41.71,0:12:46.68,Default,,0,0,0,,Мен барлық ақымақ физикалық шабуылдарды блоктай алуым керек.
Dialogue: 0,0:12:46.76,0:12:48.89,Default,,0,0,0,,Түсіндім! Aare дегеніміз не...
Dialogue: 0,0:12:49.47,0:12:51.27,Default,,0,0,0,,Баяу әсер ететін у
Dialogue: 0,0:12:51.35,0:12:53.02,Default,,0,0,0,,Мүмкіндікті пайдаланып, уды қосыңыз
Dialogue: 0,0:12:53.10,0:12:56.15,Default,,0,0,0,,Мен мұны түсінген кезде, тым кеш болды...
Dialogue: 0,0:12:56.73,0:12:59.98,Default,,0,0,0,,Мен оны физикалық адам деп ойладым, бірақ ол шынымен де ақылды.
Dialogue: 0,0:13:00.07,0:13:03.19,Default,,0,0,0,,Бірақ мен мұнда құлай алмаймын...
Dialogue: 0,0:13:03.28,0:13:06.41,Default,,0,0,0,,Мұғалім, келесі менің кезегім...
Dialogue: 0,0:13:06.49,0:13:09.33,Default,,0,0,0,,Уау, мұғалім!
Dialogue: 0,0:13:10.49,0:13:15.54,Default,,0,0,0,,(Ошироның ауыр тыныс алуы)
Dialogue: 0,0:13:17.83,0:13:20.92,Default,,0,0,0,,Уф… жүгіру аяқталды.
Dialogue: 0,0:13:27.18,0:13:29.30,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:13:32.35,0:13:34.73,Default,,0,0,0,,Қайырлы таң Ахарен-сан
Dialogue: 0,0:13:38.48,0:13:39.77,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:39.86,0:13:41.44,Default,,0,0,0,,Иә, қайырлы таң.
Dialogue: 0,0:13:41.65,0:13:42.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:43.57,0:13:45.86,Default,,0,0,0,,Бұл кісі өлтіру!
Dialogue: 0,0:13:45.95,0:13:47.78,Default,,0,0,0,,Жер бетінде кім...
Dialogue: 0,0:13:50.12,0:13:51.24,Default,,0,0,0,,- (Оширо) Уау! -Сәлем!
Dialogue: 0,0:13:51.33,0:13:53.62,Default,,0,0,0,,Рейна-чан Райду-кун Қайырлы таң
Dialogue: 0,0:13:53.70,0:13:56.00,Default,,0,0,0,,О... Қайырлы таң, Оширо мырза.
Dialogue: 0,0:13:56.08,0:13:57.62,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:57.71,0:14:00.46,Default,,0,0,0,,Райду-кун, мен қатты таң қалдым.
Dialogue: 0,0:14:00.54,0:14:03.34,Default,,0,0,0,,Өйткені мен өте зор өлтіру ниетін сезіндім.
Dialogue: 0,0:14:03.42,0:14:06.47,Default,,0,0,0,,Не? Мен әсіресе өлтіруші емеспін.
Dialogue: 0,0:14:08.38,0:14:09.39,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:10.51,0:14:11.35,Default,,0,0,0,,Оширо мырза!
Dialogue: 0,0:14:12.01,0:14:15.60,Default,,0,0,0,,Мен оны тоқтатуға тырыстым, бірақ әрекет етуге әлі кеш емес пе?
Dialogue: 0,0:14:15.68,0:14:18.06,Default,,0,0,0,,Мүмкін ол әлсіреген шығар?
Dialogue: 0,0:14:18.64,0:14:19.98,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:14:20.15,0:14:21.48,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:14:21.56,0:14:22.44,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:22.52,0:14:24.94,Default,,0,0,0,,Бір! Ойын аяқталды
Dialogue: 0,0:14:25.03,0:14:25.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:25.94,0:14:28.11,Default,,0,0,0,,Біз өткен жылы финалда бір-бірімізбен ойнадық—
Dialogue: 0,0:14:28.20,0:14:29.49,Default,,0,0,0,,Арагаки мырза
Dialogue: 0,0:14:29.57,0:14:30.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:30.99,0:14:32.53,Default,,0,0,0,,Өткен жылы сізден жеңіліс
Dialogue: 0,0:14:32.62,0:14:35.45,Default,,0,0,0,,Мен қатты жаттығу жасадым.
Dialogue: 0,0:14:35.54,0:14:39.04,Default,,0,0,0,,Бірақ сіз биылғы турнирге қатысқан жоқсыз.
Dialogue: 0,0:14:39.12,0:14:39.96,Default,,0,0,0,,Бұл қандай да бір «Гя●ган» ба?!
Dialogue: 0,0:14:40.04,0:14:42.84,Default,,0,0,0,,Сіз каратэні тастадыңыз ба?
Dialogue: 0,0:14:42.92,0:14:44.00,Default,,0,0,0,,Сіз тастадыңыз ба?
Dialogue: 0,0:14:44.09,0:14:47.92,Default,,0,0,0,,Жоқ, мен шынымен де ұстанғым келетін жолды шештім.
Dialogue: 0,0:14:48.01,0:14:52.05,Default,,0,0,0,,Мен... Сіздің көздеген жолыңыз осы ма? Каратэден басқа?
Dialogue: 0,0:14:52.14,0:14:55.14,Default,,0,0,0,,Ойлап қарасам, басқа спорт түрлерімен де айналысқансың.
Dialogue: 0,0:14:55.22,0:14:56.27,Default,,0,0,0,,Не болды!
Dialogue: 0,0:14:56.35,0:14:59.18,Default,,0,0,0,,Бокс? Кендо ма?
Dialogue: 0,0:14:59.27,0:15:00.85,Default,,0,0,0,,Көремін, жүзіп жатырмын!
Dialogue: 0,0:15:00.94,0:15:03.56,Default,,0,0,0,,Жоқ, бұл спорт емес.
Dialogue: 0,0:15:03.65,0:15:05.98,Default,,0,0,0,,Бұл спорт емес пе?
Dialogue: 0,0:15:06.07,0:15:07.99,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:15:08.07,0:15:11.53,Default,,0,0,0,,Осындай таланты мен бақытты дене бітіміне қарамастан,
Dialogue: 0,0:15:11.61,0:15:14.03,Default,,0,0,0,,Мен басқа нәрселерді істей алатыныма сене алмаймын ...
Dialogue: 0,0:15:14.62,0:15:17.49,Default,,0,0,0,,Уф... бұл қулық.
Dialogue: 0,0:15:17.58,0:15:21.75,Default,,0,0,0,,Күшті бола тұра, каратэден қалай бас тартасың?
Dialogue: 0,0:15:21.83,0:15:25.00,Default,,0,0,0,,Менде бар нәрсе осы... менде бар нәрсе осы.
Dialogue: 0,0:15:25.09,0:15:28.13,Default,,0,0,0,,Сенімен күресу, Сенімен менің мақсатым.
Dialogue: 0,0:15:28.21,0:15:32.34,Default,,0,0,0,,Мен тек каратэмен айналыстым, сонда менің орным не болады?
Dialogue: 0,0:15:32.93,0:15:34.18,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:15:34.26,0:15:35.30,Default,,0,0,0,,Оширо!
Dialogue: 0,0:15:35.39,0:15:36.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:36.89,0:15:40.98,Default,,0,0,0,,Сіз оны тоқтатқыңыз келсе де, бәрінен жалтарасыз ба?
Dialogue: 0,0:15:41.06,0:15:42.85,Default,,0,0,0,,Сен мықтысың ғой
Dialogue: 0,0:15:42.94,0:15:44.15,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:15:44.23,0:15:45.77,Default,,0,0,0,,Менімен күрес!
Dialogue: 0,0:15:45.86,0:15:48.03,Default,,0,0,0,,Мен жеңсем, сен...
Dialogue: 0,0:15:49.82,0:15:51.36,Default,,0,0,0,,Сіз күте тұрыңыз.
Dialogue: 0,0:15:51.45,0:15:52.86,Default,,0,0,0,,Тағы Оширо-сан болса...
Dialogue: 0,0:15:52.95,0:15:54.20,Default,,0,0,0,,Сыртта болыңыз!
Dialogue: 0,0:15:54.28,0:15:55.12,Default,,0,0,0,,Иә
Dialogue: 0,0:15:55.20,0:15:56.74,Default,,0,0,0,,Егер мен жеңсем...
Dialogue: 0,0:15:56.83,0:16:00.62,Default,,0,0,0,,А, жоқ, мен жеңсем, бұл менің күштірек екенін білдіреді.
Dialogue: 0,0:16:00.70,0:16:03.50,Default,,0,0,0,,Енді әлсіреген саған пайда жоқ.
Dialogue: 0,0:16:03.58,0:16:06.09,Default,,0,0,0,,Мм... дұрыс!
Dialogue: 0,0:16:06.17,0:16:08.21,Default,,0,0,0,,Егер сіз осы матчта жеңіске жетсеңіз
Dialogue: 0,0:16:08.30,0:16:10.46,Default,,0,0,0,,Мен саған каратэмен айналысуға рұқсат етемін!
Dialogue: 0,0:16:11.97,0:16:13.63,Default,,0,0,0,,Неге әдейі ұтылмасқа?
Dialogue: 0,0:16:13.72,0:16:15.09,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:16:15.18,0:16:17.22,Default,,0,0,0,,Екеуіңізге де рахмет.
Dialogue: 0,0:16:17.30,0:16:18.43,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:16:19.56,0:16:22.43,Default,,0,0,0,,Екеуін таң қалдырып, балағат сөздер айту.
Dialogue: 0,0:16:22.52,0:16:24.90,Default,,0,0,0,,Өйткені мен сені ешқашан кешірмеймін
Dialogue: 0,0:16:26.48,0:16:29.11,Default,,0,0,0,,Әдейі жеңілу мүмкін емес, солай ма?
Dialogue: 0,0:16:30.07,0:16:31.57,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:16:31.65,0:16:33.45,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:16:33.53,0:16:35.16,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:16:35.91,0:16:36.74,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:16:36.82,0:16:38.37,Default,,0,0,0,,- (Арагаки) Иә! -(Оширо) А?
Dialogue: 0,0:16:38.45,0:16:40.41,Default,,0,0,0,,(дыбыстарды біріктіру)
Dialogue: 0,0:16:40.49,0:16:42.08,Default,,0,0,0,,О... Оширо мырза...
Dialogue: 0,0:16:42.16,0:16:43.79,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:43.87,0:16:47.46,Default,,0,0,0,,Не болды, Оширо? Бұлай емес!
Dialogue: 0,0:16:47.54,0:16:51.42,Default,,0,0,0,,Осы жылдамдықпен мен жеңемін. Бұл жақсы ма?
Dialogue: 0,0:16:51.51,0:16:52.97,Default,,0,0,0,,Иә?Күте тұрыңыз
Dialogue: 0,0:16:53.05,0:16:56.72,Default,,0,0,0,,Мен жеңсем, каратэден бас тартып, қалағаныңды істей аласың...
Dialogue: 0,0:16:56.80,0:16:59.35,Default,,0,0,0,,Басқаша айтқанда, сіз жеңіліске жарайсыз ба?
Dialogue: 0,0:16:59.43,0:17:02.56,Default,,0,0,0,,Түсіндім! Сіз әдейі жеңіліп қаласыз ба?
Dialogue: 0,0:17:02.64,0:17:04.02,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:17:05.60,0:17:06.98,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:17:07.06,0:17:09.44,Default,,0,0,0,,Мен әдейі жеңілемін деген ниетім жоқ.
Dialogue: 0,0:17:09.52,0:17:12.15,Default,,0,0,0,,Сіз күшейесіз
Dialogue: 0,0:17:12.23,0:17:16.11,Default,,0,0,0,,Ахаха, түсіндім, білдім!
Dialogue: 0,0:17:16.20,0:17:17.03,Default,,0,0,0,,Иә
Dialogue: 0,0:17:17.11,0:17:20.87,Default,,0,0,0,,Ал мен басқа жолды таңдадым.
Dialogue: 0,0:17:20.95,0:17:22.83,Default,,0,0,0,,Сізге де рахмет
Dialogue: 0,0:17:23.58,0:17:24.91,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:17:25.00,0:17:27.12,Default,,0,0,0,,Өткен жылы мен сенімен ұрысқан кезде
Dialogue: 0,0:17:27.88,0:17:29.88,Default,,0,0,0,,Әйтеуір жеңіп шықтым, бірақ
Dialogue: 0,0:17:29.96,0:17:33.38,Default,,0,0,0,,Жас кезіңізден әлдеқайда күшті едіңіз.
Dialogue: 0,0:17:33.46,0:17:35.67,Default,,0,0,0,,Бірақ соңғы бірнеше жылда И
Dialogue: 0,0:17:35.76,0:17:39.85,Default,,0,0,0,,Қанша жаттығу жасасам да, үлгерімім баяу болды, өзімді шегіне жеткендей сезіндім.
Dialogue: 0,0:17:39.93,0:17:44.14,Default,,0,0,0,,Пайдалы болар деп басқа спорт түрлерінен бағымды сынап көрдім.
Dialogue: 0,0:17:44.22,0:17:46.19,Default,,0,0,0,,Нәтиже өзгерген жоқ.
Dialogue: 0,0:17:46.27,0:17:47.56,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:47.64,0:17:50.86,Default,,0,0,0,,Сіз сияқты нағыз дарынды адамдарға.
Dialogue: 0,0:17:50.94,0:17:54.15,Default,,0,0,0,,Келесі кездескенімізде мен жеңе алмаймын деп ойладым.
Dialogue: 0,0:17:54.23,0:17:55.90,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:55.99,0:17:58.57,Default,,0,0,0,,Онда менің кінәм!
Dialogue: 0,0:17:58.66,0:18:00.62,Default,,0,0,0,,Міне, сен
Dialogue: 0,0:18:00.70,0:18:03.12,Default,,0,0,0,,Бұл жай ғана... қашу!
Dialogue: 0,0:18:03.20,0:18:04.62,Default,,0,0,0,,Қашып кетпеу
Dialogue: 0,0:18:04.70,0:18:07.96,Default,,0,0,0,,Мен тек өзіме ұнайтын нәрседен бас тартпаймын
Dialogue: 0,0:18:08.04,0:18:10.08,Default,,0,0,0,,Мен арманыма жетуді шештім!
Dialogue: 0,0:18:12.09,0:18:13.55,Default,,0,0,0,,Бұл арман ба?
Dialogue: 0,0:18:13.63,0:18:18.30,Default,,0,0,0,,Менің арманым финалда сенімен тағы жұдырықтасу еді!
Dialogue: 0,0:18:18.38,0:18:20.26,Default,,0,0,0,,Бұдан былай қарсылас ретінде
Dialogue: 0,0:18:20.34,0:18:22.81,Default,,0,0,0,,Жарысқа қатысу менің арманым еді!
Dialogue: 0,0:18:22.89,0:18:23.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:25.81,0:18:26.93,Default,,0,0,0,,Арман...
Dialogue: 0,0:18:27.56,0:18:30.40,Default,,0,0,0,,Енді... жынды болсаң жақсы емес.
Dialogue: 0,0:18:30.48,0:18:34.32,Default,,0,0,0,,Сен маған ұқсамай сүйкімдісің, сондықтан мен сені таза ұстауым керек.
Dialogue: 0,0:18:35.23,0:18:36.24,Default,,0,0,0,,Иә
Dialogue: 0,0:18:44.49,0:18:46.16,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:18:47.04,0:18:50.83,Default,,0,0,0,,Менің ойымша, Оширо-сан да сүйкімді.
Dialogue: 0,0:18:51.42,0:18:52.46,Default,,0,0,0,,(Осироның жүрек соғысы)
Dialogue: 0,0:18:53.59,0:18:55.92,Default,,0,0,0,,Әй, досым берді.
Dialogue: 0,0:18:56.00,0:18:58.88,Default,,0,0,0,,Ал... Мен сізге рахмет айтқым келді.
Dialogue: 0,0:18:59.47,0:19:03.60,Default,,0,0,0,,Маған шашымды ретке келтіруді үйреткеніңізді қалаймын.
Dialogue: 0,0:19:03.68,0:19:05.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:07.35,0:19:10.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:10.10,0:19:11.85,Default,,0,0,0,,Не болды? Рейна-чан
Dialogue: 0,0:19:12.48,0:19:15.32,Default,,0,0,0,,Жаңа ғана құладым.
Dialogue: 0,0:19:17.32,0:19:20.11,Default,,0,0,0,,Re... Рейна-чан, у...
Dialogue: 0,0:19:20.20,0:19:23.07,Default,,0,0,0,,Шашыңызды жөндеп берейін!
Dialogue: 0,0:19:23.16,0:19:25.03,Default,,0,0,0,,(щетка дыбысы)
Dialogue: 0,0:19:27.58,0:19:29.71,Default,,0,0,0,,Не...қалай ойлайсың?
Dialogue: 0,0:19:32.50,0:19:36.50,Default,,0,0,0,,Рахмет, Оширо мырза, өте сүйкімді
Dialogue: 0,0:19:37.71,0:19:41.09,Default,,0,0,0,,До... Додо... Жарайсың.
Dialogue: 0,0:19:41.18,0:19:43.05,Default,,0,0,0,,Ах~ Рейна-чан
Dialogue: 0,0:19:43.14,0:19:44.80,Default,,0,0,0,,Бұл шаш сүйкімді
Dialogue: 0,0:19:44.89,0:19:46.93,Default,,0,0,0,,Оширо мырзаға мұны сіз үшін жасадыңыз ба?
Dialogue: 0,0:19:47.01,0:19:49.85,Default,,0,0,0,,Керемет! Сенің де сүйкімді болғаныңды қалаймын
Dialogue: 0,0:19:49.93,0:19:50.77,Default,,0,0,0,,Хэм (Субару) Ааах!
Dialogue: 0,0:19:53.31,0:19:54.94,Default,,0,0,0,,- (Оширо) Ха! -(Арагаки) Иә.
Dialogue: 0,0:19:56.02,0:19:58.03,Default,,0,0,0,,Иә, солай болды.
Dialogue: 0,0:19:58.11,0:19:59.11,Default,,0,0,0,,Иә
Dialogue: 0,0:19:59.19,0:20:02.24,Default,,0,0,0,,Сонымен, мен өскенде...
Dialogue: 0,0:20:02.32,0:20:03.32,Default,,0,0,0,,Ахаха
Dialogue: 0,0:20:03.41,0:20:05.91,Default,,0,0,0,,Мицуки-чан да шаштараз болуды мақсат ете ме?
Dialogue: 0,0:20:05.99,0:20:09.70,Default,,0,0,0,,Арманыңызды тапқаныңызға қуаныштымын, мама!
Dialogue: 0,0:20:09.79,0:20:13.67,Default,,0,0,0,,Би... Шаштараз болу арманым ба, білмеймін.
Dialogue: 0,0:20:13.75,0:20:15.83,Default,,0,0,0,,Бұл триггер ме?
Dialogue: 0,0:20:15.92,0:20:18.00,Default,,0,0,0,,Бірақ егер сіз арманыңызды мақсат етсеңіз...
Dialogue: 0,0:20:18.88,0:20:20.09,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:20:21.38,0:20:22.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:22.88,0:20:25.59,Default,,0,0,0,,Өз армандарыңды басқаларға сеніп тапсырма
Dialogue: 0,0:20:26.85,0:20:29.64,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:20:29.72,0:20:32.81,Default,,0,0,0,,Сіздің арманыңыз сіздікі!
Dialogue: 0,0:20:34.90,0:20:37.02,Default,,0,0,0,,О...
Dialogue: 0,0:20:37.11,0:20:39.61,Default,,0,0,0,,Ал... мен жеңілдім.
Dialogue: 0,0:20:39.69,0:20:41.82,Default,,0,0,0,,Оширо мырза, сіз жеңдіңіз, солай ма?
Dialogue: 0,0:20:41.90,0:20:42.74,Default,,0,0,0,,Иә
Dialogue: 0,0:20:42.82,0:20:46.07,Default,,0,0,0,,Қарғыс атқыр... бәрібір күшті ғой, солай емес пе?
Dialogue: 0,0:20:46.16,0:20:49.08,Default,,0,0,0,,Бұл сіз абдырап қалдыңыз.
Dialogue: 0,0:20:49.16,0:20:53.33,Default,,0,0,0,,Ал мен каратэні тастаймын деп айтпаймын.
Dialogue: 0,0:20:53.41,0:20:55.29,Default,,0,0,0,,Мен сені тіпті жек көрмеймін.
Dialogue: 0,0:20:55.37,0:20:57.17,Default,,0,0,0,,Оны неге жұмсағанымды мүлде есіме түсіре алмаймын
Dialogue: 0,0:20:57.25,0:20:58.38,Default,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:20:58.46,0:21:00.50,Default,,0,0,0,,Жаттығуды жалғастыруды жоспарлап отырмын.
Dialogue: 0,0:21:00.59,0:21:04.26,Default,,0,0,0,,Иә! Жаттығу жасайық!
Dialogue: 0,0:21:04.34,0:21:06.05,Default,,0,0,0,,Мен келесі жолы жеңемін!
Dialogue: 0,0:21:06.64,0:21:07.72,Default,,0,0,0,,Арагаки мырза
Dialogue: 0,0:21:09.76,0:21:11.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:11.22,0:21:13.52,Default,,0,0,0,,Сіздің арқаңызда мен өзімді сергек сезінемін.
Dialogue: 0,0:21:13.60,0:21:15.60,Default,,0,0,0,,О! Қайта кездескенше
Dialogue: 0,0:21:17.81,0:21:18.81,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:21:19.48,0:21:22.15,Default,,0,0,0,,Хмм... (құлап жатқан дыбыс)
Dialogue: 0,0:21:23.74,0:21:24.74,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:25.45,0:21:28.07,Default,,0,0,0,,Жақсы жұмыс, Оширо-сан
Dialogue: 0,0:21:28.16,0:21:29.83,Default,,0,0,0,,Мен шашыңды жөндеймін
Dialogue: 0,0:21:29.91,0:21:31.74,Default,,0,0,0,,Ререре... Рейна-чан
Dialogue: 0,0:21:31.83,0:21:34.37,Default,,0,0,0,,Ал... Мен мұны өзім істей аламын.
Dialogue: 0,0:21:35.83,0:21:38.29,Default,,0,0,0,,Армандарымды орындасам
Dialogue: 0,0:21:38.38,0:21:41.96,Default,,0,0,0,,Бір күні Рейнаның үйлену тойында
Dialogue: 0,0:21:42.46,0:21:45.01,Default,,0,0,0,,Мен сенің шашыңды жасап берейін.
Dialogue: 0,0:21:47.55,0:21:51.05,Default,,0,0,0,,Мм... иә, танысқаныма қуаныштымын.
Dialogue: 0,0:21:52.89,0:21:54.81,Default,,0,0,0,,Ал, енді сыныпқа барайық.
Dialogue: 0,0:21:54.89,0:21:55.73,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:55.81,0:21:56.81,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:21:56.81,0:21:57.39,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:21:56.81,0:21:57.39,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:21:57.39,0:21:57.48,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:21:57.48,0:21:58.77,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:21:57.48,0:21:58.77,Default,,0,0,0,,Мицуки Оширо.
Dialogue: 0,0:21:59.98,0:22:01.48,Default,,0,0,0,,Мен турнир үшін кек алу үшін келдім!
Dialogue: 0,0:22:01.57,0:22:03.23,Default,,0,0,0,,- (Боксшы) Жекпе-жек! -(Дзюдошы) Мен бірінші барамын.
Dialogue: 0,0:22:03.32,0:22:05.24,Default,,0,0,0,,- (Жүзуші) Күн жылы! - (Семсерлесу ойыншысы) Ачикиё!
Dialogue: 0,0:22:05.32,0:22:07.11,Default,,0,0,0,,- (дзюдошы) Менімен күрес! -(Боксшы) Мен біріншімін.
Dialogue: 0,0:22:07.20,0:22:08.32,Default,,0,0,0,,- (Кендо ойыншысы) Бұл менмін! - (Жүзуші) Бұл Аки!
Dialogue: 0,0:22:08.41,0:22:11.53,Default,,0,0,0,,Мен үшін бұл мүмкін емес!
Dialogue: 0,0:22:12.24,0:22:14.45,Default,,0,0,0,,Оширо мырза өте танымал
Dialogue: 0,0:22:14.54,0:22:15.95,Default,,0,0,0,,Иә
Dialogue: 0,0:22:16.04,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:40.96,0:23:45.96,Default,,0,0,0,,～♪
