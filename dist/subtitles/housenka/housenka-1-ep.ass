Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.67,0:00:14.47,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:00:16.01,0:00:21.31,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:00:22.98,0:00:27.31,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:00:29.61,0:00:33.70,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:00:45.25,0:00:50.92,Default,,0,0,0,,А... Ууу... Ууу... Иә...
Dialogue: 0,0:00:51.00,0:00:53.13,Default,,0,0,0,,Я...
Dialogue: 0,0:00:53.21,0:00:55.93,Default,,0,0,0,,Бұл сұмдық өмір болды.
Dialogue: 0,0:00:59.26,0:01:03.52,Default,,0,0,0,,Әй, өмір дегенді өмір дейсің.
Dialogue: 0,0:01:03.60,0:01:07.10,Default,,0,0,0,,Біздің өмір туралы ойлауымыз өмір деп атайтынымыздан өзгеше.
Dialogue: 0,0:01:08.77,0:01:12.94,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:01:13.03,0:01:14.53,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:01:22.45,0:01:25.04,Default,,0,0,0,,Үлкен өзгеріс...
Dialogue: 0,0:01:29.00,0:01:30.09,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:38.38,0:01:40.60,Default,,0,0,0,,Ахаха Осы жерден?
Dialogue: 0,0:01:42.06,0:01:45.14,Default,,0,0,0,,Үлкен кері айналу? Мені күлдірмеңіз
Dialogue: 0,0:01:49.81,0:01:54.36,Default,,0,0,0,,Сіздің келген күніңіз жақсы есімде.
Dialogue: 0,0:02:11.92,0:02:13.42,Default,,0,0,0,,Сіз ұйықтадыңыз ба?
Dialogue: 0,0:02:14.46,0:02:16.55,Default,,0,0,0,,Қатты дыбыс шығармаңыз
Dialogue: 0,0:02:17.51,0:02:19.72,Default,,0,0,0,,Ұйықтап кетсем де
Dialogue: 0,0:02:20.43,0:02:21.68,Default,,0,0,0,,Сот…
Dialogue: 0,0:02:22.80,0:02:27.18,Default,,0,0,0,,Сәбилер не жылайды, не ұйықтайды.
Dialogue: 0,0:02:29.98,0:02:33.65,Default,,0,0,0,,Маған Акутсу-сан ұқсас.
Dialogue: 0,0:02:37.78,0:02:39.78,Default,,0,0,0,,Сіз жыламайсыз.
Dialogue: 0,0:02:41.57,0:02:42.62,Default,,0,0,0,,Мен ұйықтап жатсам да
Dialogue: 0,0:02:44.33,0:02:46.37,Default,,0,0,0,,Сіз жылап жатқан сияқтысыз.
Dialogue: 0,0:02:51.08,0:02:55.04,Default,,0,0,0,,Мына сандалдар жаңбырдан дымқыл, сондықтан жай ғана көтерілме.
Dialogue: 0,0:02:55.13,0:02:57.34,Default,,0,0,0,,Бұл сіздің жаңа үйіңіз.
Dialogue: 0,0:03:00.18,0:03:02.09,Default,,0,0,0,,- (Акутсу) Нана - (Нана) Иә?
Dialogue: 0,0:03:02.80,0:03:04.85,Default,,0,0,0,,Бұл гүл қалай аталады?
Dialogue: 0,0:03:06.26,0:03:07.43,Default,,0,0,0,,Хауснка
Dialogue: 0,0:03:10.27,0:03:12.85,Default,,0,0,0,,Бұл хаузенка ма?
Dialogue: 0,0:03:12.94,0:03:17.61,Default,,0,0,0,,Жоғарыдан қарасаң, жапырақ көп екен.
Dialogue: 0,0:03:17.69,0:03:22.03,Default,,0,0,0,,Мұқият қарасаң, әдемі гүлдер көрінеді.
Dialogue: 0,0:03:22.11,0:03:24.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.83,0:03:27.99,Default,,0,0,0,,Маған қарама, Барса.
Dialogue: 0,0:03:28.08,0:03:30.25,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:30.75,0:03:35.59,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:03:40.13,0:03:41.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:45.68,0:03:47.06,Default,,0,0,0,,Хехе...
Dialogue: 0,0:03:51.43,0:03:52.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:04.11,0:04:05.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:13.87,0:04:15.25,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:04:15.96,0:04:16.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:18.50,0:04:19.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:21.42,0:04:22.59,Default,,0,0,0,,Гүлдер
Dialogue: 0,0:04:23.59,0:04:26.01,Default,,0,0,0,,Барка Барка
Dialogue: 0,0:04:28.14,0:04:29.35,Default,,0,0,0,,Богеах...
Dialogue: 0,0:04:29.43,0:04:30.43,Default,,0,0,0,,Ах
Dialogue: 0,0:04:31.39,0:04:34.02,Default,,0,0,0,,Нгяа... гяаа...
Dialogue: 0,0:04:34.10,0:04:35.69,Default,,0,0,0,,Мен мұны ашамын...
Dialogue: 0,0:04:52.75,0:04:54.75,Default,,0,0,0,,♪～
Dialogue: 0,0:05:00.75,0:05:02.34,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:05:34.62,0:05:36.21,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:05:36.29,0:05:38.04,Default,,0,0,0,,- (Кониши) Ах! -(Хаяшида) А...
Dialogue: 0,0:06:29.59,0:06:32.01,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:06:32.10,0:06:33.51,Default,,0,0,0,,Аха…
Dialogue: 0,0:06:34.35,0:06:35.18,Default,,0,0,0,,Мен осындамын...
Dialogue: 0,0:06:35.26,0:06:37.73,Default,,0,0,0,,Гаххахаха
Dialogue: 0,0:07:35.32,0:07:37.37,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:07:35.32,0:07:37.37,Default,,0,0,0,,～♪
Dialogue: 0,0:07:37.91,0:07:42.21,Default,,0,0,0,,Содан бері сөйлесіп жүрсің бе?
Dialogue: 0,0:07:43.21,0:07:45.38,Default,,0,0,0,,Біз бүкіл уақыт бойы сөйлестік.
Dialogue: 0,0:07:46.09,0:07:49.38,Default,,0,0,0,,Неліктен мен оны қазір ести аламын?
Dialogue: 0,0:07:50.26,0:07:53.18,Default,,0,0,0,,Жаңа туған нәресте немесе өліп жатқан адам сияқты естіледі.
Dialogue: 0,0:07:53.26,0:07:56.51,Default,,0,0,0,,Оны нәресте де естуі мүмкін.
Dialogue: 0,0:07:56.60,0:07:58.93,Default,,0,0,0,,Хмм, сен Кенсуке дедің бе?
Dialogue: 0,0:07:59.72,0:08:02.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:02.35,0:08:04.69,Default,,0,0,0,,Сен де жақсы орындадың.
Dialogue: 0,0:08:04.77,0:08:08.44,Default,,0,0,0,,Жаңа ғана барда танысқан әйелді қалай асырап ала аласыз?
Dialogue: 0,0:08:09.03,0:08:12.90,Default,,0,0,0,,Мен сені алып кетейін деп тұрған жоқпын, келуіңді сұраймын.
Dialogue: 0,0:08:12.99,0:08:14.86,Default,,0,0,0,,Әр адамның баласы?
Dialogue: 0,0:08:14.95,0:08:20.87,Default,,0,0,0,,Біз кездескен кезде мен ана құрсағында болдым, сондықтан оған көмектесу мүмкін емес.
Dialogue: 0,0:08:20.95,0:08:23.16,Default,,0,0,0,,Өсімдіктердің тіршілік ету стратегиясы бойынша
Dialogue: 0,0:08:23.25,0:08:24.96,Default,,0,0,0,,Мен оны түсінбеймін.
Dialogue: 0,0:08:25.04,0:08:27.21,Default,,0,0,0,,Өйткені біз топырақ үшін жарысамыз.
Dialogue: 0,0:08:27.29,0:08:29.88,Default,,0,0,0,,Сырттан келетіндерге орын жоқ.
Dialogue: 0,0:08:30.96,0:08:35.09,Default,,0,0,0,,Нананың барар жері болмады.
Dialogue: 0,0:08:35.18,0:08:36.93,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:08:37.76,0:08:42.77,Default,,0,0,0,,Жанқиярлық пен альтруизм бізге тек азық-түлік, солай ма?
Dialogue: 0,0:08:42.85,0:08:47.40,Default,,0,0,0,,Оның мағынасы жоқ, маған шындықты айт.
Dialogue: 0,0:08:49.65,0:08:52.65,Default,,0,0,0,,Ха... Маған ұнады.
Dialogue: 0,0:08:52.74,0:08:54.74,Default,,0,0,0,,Сонда мен түсінемін.
Dialogue: 0,0:08:55.28,0:08:59.83,Default,,0,0,0,,Мен жай ғана сенімен болғым келді.
Dialogue: 0,0:08:59.91,0:09:02.12,Default,,0,0,0,,Сіз оларға бұл туралы айттыңыз ба?
Dialogue: 0,0:09:02.20,0:09:05.16,Default,,0,0,0,,Ха... ол жерде болмады.
Dialogue: 0,0:09:05.25,0:09:06.75,Default,,0,0,0,,Ең нашар
Dialogue: 0,0:09:39.78,0:09:41.87,Default,,0,0,0,,-Маған тиіспе - (Нана) Маған тиіспе
Dialogue: 0,0:09:41.95,0:09:43.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:45.41,0:09:46.46,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:47.75,0:09:49.33,Default,,0,0,0,,Оған қол тигізбеңіз
Dialogue: 0,0:09:49.42,0:09:53.09,Default,,0,0,0,,Табиғаттан келген нәрсені табиғатқа қалдыру керек.
Dialogue: 0,0:09:53.71,0:09:55.80,Default,,0,0,0,,Бұл Құдайдың патшалығы
Dialogue: 0,0:09:59.18,0:10:01.85,Default,,0,0,0,,Сіз қиын нәрселерді айтасыз.
Dialogue: 0,0:10:02.89,0:10:05.10,Default,,0,0,0,,9-шы иннингтің төменгі жағы, 2 шығу, жүгірушілер жоқ
Dialogue: 0,0:10:05.18,0:10:07.44,Default,,0,0,0,,Бір ғана адам қалды, ойын аяқталды.
Dialogue: 0,0:10:07.52,0:10:09.48,Default,,0,0,0,,Питчер басын шайқап, бірінші қадамды лақтырды.
Dialogue: 0,0:10:09.56,0:10:10.73,Default,,0,0,0,,Мен соқтым!
Dialogue: 0,0:10:11.73,0:10:14.94,Default,,0,0,0,,Мен тамақ әзірлей алсам, неаполитан жегім келеді.
Dialogue: 0,0:10:15.86,0:10:17.07,Default,,0,0,0,,О
Dialogue: 0,0:10:17.15,0:10:21.87,Default,,0,0,0,,Пышақтар мен табалар... Сатып алатын заттар өте көп.
Dialogue: 0,0:10:26.25,0:10:27.41,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:10:28.37,0:10:30.12,Default,,0,0,0,,Бүгін не істедің?
Dialogue: 0,0:10:30.21,0:10:32.71,Default,,0,0,0,,- (Акутсу) Мен жаяу келдім - (Нана) Тағы?
Dialogue: 0,0:10:32.79,0:10:34.59,Default,,0,0,0,,Жақында аяқталатын сияқты.
Dialogue: 0,0:10:35.80,0:10:38.22,Default,,0,0,0,,Тек сатып алыңыз.
Dialogue: 0,0:10:38.30,0:10:42.35,Default,,0,0,0,,Тадатака Ино баяғыда осындай әрекет жасады.
Dialogue: 0,0:10:42.89,0:10:44.51,Default,,0,0,0,,Бұл ысырап, солай емес пе?
Dialogue: 0,0:10:45.31,0:10:48.23,Default,,0,0,0,,Оның үстіне мен сатып алған картадан айта алмаймын.
Dialogue: 0,0:10:48.81,0:10:51.15,Default,,0,0,0,,Бұл жерде қоқыс өңдейтін дүкен бар ма?
Dialogue: 0,0:10:51.23,0:10:52.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.36,0:10:54.61,Default,,0,0,0,,Келесіде балалар арбасын көрейік.
Dialogue: 0,0:10:55.78,0:10:57.86,Default,,0,0,0,,Сіз оны арзанға сатып ала аласыз
Dialogue: 0,0:10:57.94,0:11:00.99,Default,,0,0,0,,Бұл жердегі соққышы - жарақаттан оралған Кизаки.
Dialogue: 0,0:11:01.07,0:11:05.70,Default,,0,0,0,,Канай Нишиокада қосылым жасайды және негіздер жүктелді. Егер сіз бір соққы алсаңыз, бұл кері қайтару және бұл қоштасу!
Dialogue: 0,0:11:05.79,0:11:09.83,Default,,0,0,0,,Дәлірек айтсақ, Акутсу мырза, қалай дәл осылай жаза аласыз?
Dialogue: 0,0:11:10.79,0:11:13.21,Default,,0,0,0,,Менің басымда графикалық қағаз бар
Dialogue: 0,0:11:14.50,0:11:16.09,Default,,0,0,0,,Иә
Dialogue: 0,0:11:17.76,0:11:20.55,Default,,0,0,0,,Демек, бұл үлкен мәселе емес.
Dialogue: 0,0:11:20.63,0:11:25.05,Default,,0,0,0,,Бұл үлкен мәселе. Мен оның ақша табуын қалаймын.
Dialogue: 0,0:11:25.14,0:11:26.14,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:28.60,0:11:31.06,Default,,0,0,0,,- (Нана) Хехехе... - (Акутсу) Жүгімізді реттеп алайық...
Dialogue: 0,0:11:31.14,0:11:34.31,Default,,0,0,0,,Бұл маусым - Ахиллес сіңірінің жарылғаннан кейінгі оралу.
Dialogue: 0,0:11:34.40,0:11:36.57,Default,,0,0,0,,Сіз оны ұра аласыз ба?
Dialogue: 0,0:11:36.65,0:11:38.53,Default,,0,0,0,,Мен де баяғыда жарақат алғанмын...
Dialogue: 0,0:11:38.61,0:11:39.44,Default,,0,0,0,,(Пиллинг дыбысы)
Dialogue: 0,0:11:40.07,0:11:41.45,Default,,0,0,0,,(Микротолқынды пеш қоңырауының дыбысы)
Dialogue: 0,0:11:42.32,0:11:43.70,Default,,0,0,0,,Фалько…
Dialogue: 0,0:11:43.78,0:11:44.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.24,0:11:48.08,Default,,0,0,0,,Бір нәрсеге ұқсайды...
Dialogue: 0,0:11:49.08,0:11:50.79,Default,,0,0,0,,Қайтадан қоңырау шалыңыз
Dialogue: 0,0:11:53.75,0:11:55.21,Default,,0,0,0,,Фалько…
Dialogue: 0,0:11:56.96,0:11:57.80,Default,,0,0,0,,(Пиллинг дыбысы)
Dialogue: 0,0:11:57.88,0:11:59.63,Default,,0,0,0,,(Микротолқынды пеш қоңырауының дыбысы)
Dialogue: 0,0:12:03.05,0:12:05.22,Default,,0,0,0,,О, солай.
Dialogue: 0,0:12:05.30,0:12:06.97,Default,,0,0,0,,Фукумотоны басу
Dialogue: 0,0:12:07.05,0:12:09.60,Default,,0,0,0,,Алдымен, заңсыз адаммен тікелей соққы беріңіз!
Dialogue: 0,0:12:09.68,0:12:11.39,Default,,0,0,0,,Уақыт кешіктірілді.
Dialogue: 0,0:12:11.48,0:12:13.31,Default,,0,0,0,,...
Dialogue: 0,0:12:13.31,0:12:14.73,Default,,0,0,0,,...
Dialogue: 0,0:12:13.31,0:12:14.73,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:14.81,0:12:18.15,Default,,0,0,0,,♪ Бобобон Бонбо Бон Бон
Dialogue: 0,0:12:18.15,0:12:18.98,Default,,0,0,0,,♪ Бобобон Бонбо Бон Бон
Dialogue: 0,0:12:18.15,0:12:18.98,Default,,0,0,0,,(Пиллинг дыбысы)
Dialogue: 0,0:12:19.07,0:12:20.61,Default,,0,0,0,,♪ Бобобон Бон
Dialogue: 0,0:12:20.61,0:12:21.44,Default,,0,0,0,,♪ Бобобон Бон
Dialogue: 0,0:12:20.61,0:12:21.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:21.53,0:12:23.53,Default,,0,0,0,,♪ Бобобон Бон
Dialogue: 0,0:12:23.61,0:12:25.87,Default,,0,0,0,,♪ Бобо Бон Бон
Dialogue: 0,0:12:23.61,0:12:25.87,Default,,0,0,0,,(Микротолқынды пеш қоңырауының дыбысы)
Dialogue: 0,0:12:25.95,0:12:27.37,Default,,0,0,0,,♪ Бобобон Бон
Dialogue: 0,0:12:25.95,0:12:27.37,Default,,0,0,0,,(Микротолқынды пеш қоңырауының дыбысы)
Dialogue: 0,0:12:28.33,0:12:29.79,Default,,0,0,0,,Мен соқтым!
Dialogue: 0,0:12:30.37,0:12:34.21,Default,,0,0,0,,...
Dialogue: 0,0:12:30.37,0:12:34.21,Default,,0,0,0,,♪ Лулу Лулу Лу
Dialogue: 0,0:12:34.29,0:12:35.54,Default,,0,0,0,,♪ Бобобон
