Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.50,0:00:09.00,Default,,0,0,0,,Гуу!
Dialogue: 0,0:00:10.83,0:00:15.29,Default,,0,0,0,,О! Ой...
Dialogue: 0,0:00:16.12,0:00:18.87,Default,,0,0,0,,Бұл патшаның назарын аударады! Жақсы құтылыңыз!
Dialogue: 0,0:00:19.58,0:00:21.91,Default,,0,0,0,,Түсіндім! Мен жерге бара жатырмын
Dialogue: 0,0:00:22.00,0:00:22.87,Default,,0,0,0,,Ана!
Dialogue: 0,0:00:22.95,0:00:23.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:25.20,0:00:26.45,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:00:38.04,0:00:40.04,Default,,0,0,0,,♪～
Dialogue: 0,0:01:58.12,0:01:58.29,Default,,0,0,0,,～♪
Dialogue: 0,0:01:58.29,0:02:00.12,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:01:58.29,0:02:00.12,Default,,0,0,0,,～♪
Dialogue: 0,0:02:00.12,0:02:03.16,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:10.70,0:02:13.75,Default,,0,0,0,,Сөзсіз! Бұл жынның мысалы.
Dialogue: 0,0:02:14.29,0:02:15.95,Default,,0,0,0,,Түсіру тобы қазір қайда?
Dialogue: 0,0:02:17.04,0:02:20.50,Default,,0,0,0,,Мен бірегей жын сынағын алатыныма сенімдімін.
Dialogue: 0,0:02:20.58,0:02:22.50,Default,,0,0,0,,Сіз Африкаға кеткен болуыңыз керек, солай ма?
Dialogue: 0,0:02:23.16,0:02:24.79,Default,,0,0,0,,Мен жақында Жапонияға оралдым.
Dialogue: 0,0:02:26.58,0:02:27.91,Default,,0,0,0,,Сұрайық
Dialogue: 0,0:02:28.70,0:02:32.41,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:32.50,0:02:34.95,Default,,0,0,0,,Сізге біраз уақыт демалыс алу керек, солай ма?
Dialogue: 0,0:02:35.04,0:02:38.58,Default,,0,0,0,,Кешіріңіз, төраға іздеген жын пайда болды.
Dialogue: 0,0:02:39.08,0:02:40.29,Default,,0,0,0,,Хо
Dialogue: 0,0:02:41.50,0:02:42.54,Default,,0,0,0,,«Сақтаушы жын»\NОл
Dialogue: 0,0:02:42.62,0:02:43.83,Default,,0,0,0,,деп аталады.
Dialogue: 0,0:02:43.91,0:02:45.16,Default,,0,0,0,,Жаға сақталады
Dialogue: 0,0:02:45.25,0:02:47.29,Default,,0,0,0,,Бақылауды жоғалту мүмкіндігі
Dialogue: 0,0:02:48.00,0:02:48.79,Default,,0,0,0,,Ниа, бізге тез арада мұндадан кету керек.
Dialogue: 0,0:02:48.87,0:02:51.54,Default,,0,0,0,,Біз кірістірілген біріктіру түріндегі жағаларды ұсынамыз
Dialogue: 0,0:02:52.70,0:02:54.12,Default,,0,0,0,,Сіз мені ұстай аласыз ба?
Dialogue: 0,0:02:56.16,0:02:57.91,Default,,0,0,0,,Бұл менің жұмысым
Dialogue: 0,0:03:00.83,0:03:04.00,Default,,0,0,0,,Қағаз жын! Қайшы шайтанды алып жүріңіз!
Dialogue: 0,0:03:05.62,0:03:06.95,Default,,0,0,0,,Пар.
Dialogue: 0,0:03:07.54,0:03:09.33,Default,,0,0,0,,Пар! (Патша) О?
Dialogue: 0,0:03:09.41,0:03:11.08,Default,,0,0,0,,Чоки Чоки Чоки...
Dialogue: 0,0:03:11.58,0:03:13.58,Default,,0,0,0,,Чоки Чоки... (Патша) Ооооо...
Dialogue: 0,0:03:14.29,0:03:15.12,Default,,0,0,0,,Шоқы!
Dialogue: 0,0:03:17.91,0:03:22.70,Default,,0,0,0,,О? Апыр-ай!
Dialogue: 0,0:03:24.66,0:03:27.95,Default,,0,0,0,,Па… па па!
Dialogue: 0,0:03:32.00,0:03:35.37,Default,,0,0,0,,Арх! Уф... (Патша) О? О~
Dialogue: 0,0:03:36.12,0:03:37.79,Default,,0,0,0,,Арх! Гррр...
Dialogue: 0,0:03:40.33,0:03:41.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:41.62,0:03:42.58,Default,,0,0,0,,Пар!
Dialogue: 0,0:03:43.08,0:03:45.58,Default,,0,0,0,,Паа паа!
Dialogue: 0,0:03:49.58,0:03:50.58,Default,,0,0,0,,Уау
Dialogue: 0,0:03:51.37,0:03:53.20,Default,,0,0,0,,Біз жерге жеттік!
Dialogue: 0,0:03:55.95,0:03:57.00,Default,,0,0,0,,Момока!
Dialogue: 0,0:03:58.41,0:03:59.62,Default,,0,0,0,,Кенто-кун! Ана!
Dialogue: 0,0:04:00.29,0:04:01.50,Default,,0,0,0,,Каэде-сан!
Dialogue: 0,0:04:02.50,0:04:03.58,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:04:03.66,0:04:04.41,Default,,0,0,0,,Момока…
Dialogue: 0,0:04:04.50,0:04:06.87,Default,,0,0,0,,Ооо~ (Кенто) Ах, бұл қауіпті.
Dialogue: 0,0:04:06.95,0:04:08.54,Default,,0,0,0,,Тезірек әрі қарай жүрейік.
Dialogue: 0,0:04:09.04,0:04:11.00,Default,,0,0,0,,Ей, анау... (Патша) Ооо
Dialogue: 0,0:04:11.58,0:04:14.04,Default,,0,0,0,,Ооо
Dialogue: 0,0:04:16.83,0:04:19.79,Default,,0,0,0,,Цк... мына жігіт жынды екен!
Dialogue: 0,0:04:22.25,0:04:23.25,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:23.83,0:04:25.04,Default,,0,0,0,,үшінң жүгіріңдер!
Dialogue: 0,0:04:29.75,0:04:30.95,Default,,0,0,0,,Igis! Иги!
Dialogue: 0,0:04:35.29,0:04:38.12,Default,,0,0,0,,Ооо
Dialogue: 0,0:04:38.20,0:04:38.95,Default,,0,0,0,,Уау
Dialogue: 0,0:04:39.04,0:04:40.12,Default,,0,0,0,,Сіз!
Dialogue: 0,0:04:46.70,0:04:48.95,Default,,0,0,0,,Ой...
Dialogue: 0,0:04:49.04,0:04:49.91,Default,,0,0,0,,Игіз…
Dialogue: 0,0:04:50.50,0:04:52.12,Default,,0,0,0,,А... Кенто-кун?
Dialogue: 0,0:04:52.75,0:04:53.95,Default,,0,0,0,,Кенто-кун!
Dialogue: 0,0:04:57.04,0:04:59.54,Default,,0,0,0,,Ооо
Dialogue: 0,0:05:03.45,0:05:05.29,Default,,0,0,0,,(Құлаған қоқыс дыбысы)
Dialogue: 0,0:05:05.37,0:05:06.83,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:05:09.12,0:05:10.62,Default,,0,0,0,,Igi! Джиджи…
Dialogue: 0,0:05:11.45,0:05:12.79,Default,,0,0,0,,А... сен
Dialogue: 0,0:05:13.29,0:05:15.37,Default,,0,0,0,,Сіз? Ахх!
Dialogue: 0,0:05:15.45,0:05:17.66,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:05:17.75,0:05:18.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:19.62,0:05:21.33,Default,,0,0,0,,Ой...
Dialogue: 0,0:05:24.95,0:05:27.33,Default,,0,0,0,,Сіз осы бейненің провайдерісіз бе?
Dialogue: 0,0:05:28.00,0:05:29.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:30.20,0:05:33.58,Default,,0,0,0,,Сіз оны көрдіңіз бе? Бұл жігіт патшамен соғысады
Dialogue: 0,0:05:34.25,0:05:37.20,Default,,0,0,0,,Көрдім Ол алғашында кішкентай болды.
Dialogue: 0,0:05:37.29,0:05:39.83,Default,,0,0,0,,Мен бұл қарапайым жын деп ойладым.
Dialogue: 0,0:05:40.45,0:05:44.54,Default,,0,0,0,,Бірақ бұл... қалыпты емес.
Dialogue: 0,0:05:54.04,0:05:55.00,Default,,0,0,0,,Кенто-кун!
Dialogue: 0,0:06:06.00,0:06:07.00,Default,,0,0,0,,А?
Dialogue: 0,0:06:10.83,0:06:11.83,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:12.62,0:06:15.12,Default,,0,0,0,,Ах! Наа!
Dialogue: 0,0:06:15.62,0:06:18.95,Default,,0,0,0,,Сіз! тесік~! Эй...
Dialogue: 0,0:06:19.54,0:06:21.79,Default,,0,0,0,,Ооо
Dialogue: 0,0:06:22.37,0:06:23.50,Default,,0,0,0,,Телефон қоңырау шалуда! Телефон...
Dialogue: 0,0:06:24.33,0:06:28.87,Default,,0,0,0,,Ооо...
Dialogue: 0,0:06:32.50,0:06:34.87,Default,,0,0,0,,Оххх
Dialogue: 0,0:06:35.83,0:06:38.33,Default,,0,0,0,,Ооо!
Dialogue: 0,0:06:38.95,0:06:39.70,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:39.70,0:06:41.91,Default,,0,0,0,,(Аннаның жүрек соғысы)
Dialogue: 0,0:06:39.70,0:06:41.91,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:41.91,0:06:42.95,Default,,0,0,0,,(Аннаның жүрек соғысы)
Dialogue: 0,0:06:46.00,0:06:49.45,Default,,0,0,0,,Ооо!
Dialogue: 0,0:06:49.54,0:06:51.91,Default,,0,0,0,,Ооо... Наааа!
Dialogue: 0,0:06:52.00,0:06:54.41,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:06:54.91,0:06:57.37,Default,,0,0,0,,Уф... Түсіндім!
Dialogue: 0,0:06:58.50,0:07:00.70,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:07:01.37,0:07:02.58,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:02.66,0:07:04.79,Default,,0,0,0,,Вааа! Эй...!
Dialogue: 0,0:07:05.62,0:07:09.04,Default,,0,0,0,,Уау! Вуууу…
Dialogue: 0,0:07:11.91,0:07:13.45,Default,,0,0,0,,Ой...
Dialogue: 0,0:07:14.41,0:07:17.08,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:07:19.33,0:07:21.45,Default,,0,0,0,,Ооо...
Dialogue: 0,0:07:21.54,0:07:24.33,Default,,0,0,0,,Гуруруруру…
Dialogue: 0,0:07:27.75,0:07:31.45,Default,,0,0,0,,Ваа!
Dialogue: 0,0:07:31.54,0:07:33.95,Default,,0,0,0,,Оххх...!
Dialogue: 0,0:07:36.37,0:07:38.25,Default,,0,0,0,,Ооо?
Dialogue: 0,0:07:52.75,0:07:56.87,Default,,0,0,0,,Ваа...!
Dialogue: 0,0:07:56.95,0:07:58.66,Default,,0,0,0,,Ой...
Dialogue: 0,0:08:02.66,0:08:05.45,Default,,0,0,0,,Оххх...!
Dialogue: 0,0:08:06.45,0:08:08.95,Default,,0,0,0,,Ой...
Dialogue: 0,0:08:09.04,0:08:10.37,Default,,0,0,0,,Сонымен... керемет...
Dialogue: 0,0:08:14.16,0:08:16.04,Default,,0,0,0,,Вау Вау! Гуа!
Dialogue: 0,0:08:21.00,0:08:25.37,Default,,0,0,0,,Ваа!
Dialogue: 0,0:08:25.45,0:08:26.79,Default,,0,0,0,,Ой...
Dialogue: 0,0:08:30.95,0:08:32.00,Default,,0,0,0,,Igigi?
Dialogue: 0,0:08:32.50,0:08:34.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:08:36.54,0:08:41.66,Default,,0,0,0,,Ваа!
Dialogue: 0,0:08:44.54,0:08:46.20,Default,,0,0,0,,Бірдеңе дұрыс емес...!
Dialogue: 0,0:08:46.29,0:08:51.41,Default,,0,0,0,,Ваа! Ва!
Dialogue: 0,0:08:53.16,0:08:56.12,Default,,0,0,0,,Ваа!
Dialogue: 0,0:09:06.83,0:09:08.25,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:09:12.50,0:09:13.20,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:13.29,0:09:14.79,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:09:15.29,0:09:16.45,Default,,0,0,0,,Момока!
Dialogue: 0,0:09:35.75,0:09:38.54,Default,,0,0,0,,Уф... ауырады...
Dialogue: 0,0:09:41.79,0:09:42.58,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:09:43.79,0:09:45.75,Default,,0,0,0,,Ана? қайда?
Dialogue: 0,0:09:47.87,0:09:49.75,Default,,0,0,0,,А... Ана!
Dialogue: 0,0:10:00.29,0:10:02.04,Default,,0,0,0,,Ана! Ана!
Dialogue: 0,0:10:04.91,0:10:06.87,Default,,0,0,0,,А... не істеуім керек!
Dialogue: 0,0:10:09.50,0:10:11.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:11.79,0:10:15.83,Default,,0,0,0,,(Кентоның тыныс алу дыбысы)
Dialogue: 0,0:10:18.91,0:10:19.87,Default,,0,0,0,,А?
Dialogue: 0,0:10:19.95,0:10:21.41,Default,,0,0,0,,Ах! (Кенто) Оян!
Dialogue: 0,0:10:21.50,0:10:24.16,Default,,0,0,0,,Анна Жақсысың деп үміттенемін! О, менің!
Dialogue: 0,0:10:24.83,0:10:27.45,Default,,0,0,0,,Сәлем! Ах!
Dialogue: 0,0:10:29.12,0:10:32.66,Default,,0,0,0,,Сен уайымдап жүрсің, Анна...
Dialogue: 0,0:10:33.41,0:10:37.41,Default,,0,0,0,,Қалай болғанда да, Анна соншалықты арық болып кетуі мүмкін.
Dialogue: 0,0:10:37.50,0:10:39.79,Default,,0,0,0,,Момока Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:10:39.87,0:10:42.16,Default,,0,0,0,,Иә, көмектесті ме?
Dialogue: 0,0:10:42.66,0:10:45.04,Default,,0,0,0,,Солай сияқты (Кенто) Рахмет, бәрібір.
Dialogue: 0,0:10:45.12,0:10:46.16,Default,,0,0,0,,А?
Dialogue: 0,0:10:46.25,0:10:48.41,Default,,0,0,0,,Ана, бүгін кешке не жегің келеді? тесік!
Dialogue: 0,0:10:48.50,0:10:50.12,Default,,0,0,0,,Сәлем! Нана Нана
Dialogue: 0,0:10:50.20,0:10:52.95,Default,,0,0,0,,Чикува жасауым керек пе? Эй! Не?
Dialogue: 0,0:10:53.45,0:10:55.75,Default,,0,0,0,,Сіз! Ах!
Dialogue: 0,0:10:55.83,0:10:56.87,Default,,0,0,0,,Кенто-кун
Dialogue: 0,0:10:57.37,0:10:59.41,Default,,0,0,0,,Каэде-сан, патша ше?
Dialogue: 0,0:11:00.58,0:11:02.12,Default,,0,0,0,,Анна оны жойды.
Dialogue: 0,0:11:02.20,0:11:02.87,Default,,0,0,0,,Анна?
Dialogue: 0,0:11:03.79,0:11:04.95,Default,,0,0,0,,А?
Dialogue: 0,0:11:05.04,0:11:06.45,Default,,0,0,0,,Менің есімде ештеңе жоқ
Dialogue: 0,0:11:07.04,0:11:08.12,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:19.37,0:11:22.12,Default,,0,0,0,,Ол сақтаушы жын.
Dialogue: 0,0:11:22.20,0:11:25.87,Default,,0,0,0,,Жүлде қоры өсті, 200 миллион иен!
Dialogue: 0,0:11:25.95,0:11:29.08,Default,,0,0,0,,Оны ұстау мүмкін емес. Сіз патшаны жеңдіңіз, солай ма?
Dialogue: 0,0:11:29.66,0:11:34.16,Default,,0,0,0,,Ақпарат беру арқылы аз ғана ақша алуға болатын сияқты.
Dialogue: 0,0:11:34.25,0:11:37.37,Default,,0,0,0,,Сіз бұған шыдайсыз ба? Ах...
Dialogue: 0,0:11:38.54,0:11:40.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:40.20,0:11:41.04,Default,,0,0,0,,Сіз!
Dialogue: 0,0:11:49.41,0:11:50.50,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:11:52.00,0:11:54.41,Default,,0,0,0,,Бірақ мен сізге алғыс айтпаймын!
Dialogue: 0,0:11:54.50,0:11:56.29,Default,,0,0,0,,Жындар – жау!
Dialogue: 0,0:11:57.12,0:11:59.58,Default,,0,0,0,,Сіз шынымен де адал емессіз, солай ма?
Dialogue: 0,0:12:00.16,0:12:03.25,Default,,0,0,0,,Не? Неге күлесің? А? Эй.
Dialogue: 0,0:12:03.33,0:12:06.66,Default,,0,0,0,,Өйткені... (Момока) Жақсы емес пе? Қазірдің өзінде...
Dialogue: 0,0:12:09.70,0:12:11.83,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,0:12:12.58,0:12:14.66,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:12:16.75,0:12:20.54,Default,,0,0,0,,Нысанаға әрекет еткен әйел Каэде Ходжо болды.
Dialogue: 0,0:12:21.04,0:12:21.95,Default,,0,0,0,,Эмилия бүкіл түн бойы мұнда болды ма?
Dialogue: 0,0:12:22.04,0:12:25.33,Default,,0,0,0,,А, сен мені осылай атадың. Сіз мені танисыз ба?
Dialogue: 0,0:12:25.87,0:12:28.66,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:12:38.70,0:12:41.41,Default,,0,0,0,,Киото
Dialogue: 0,0:12:43.16,0:12:46.83,Default,,0,0,0,,Бұл жерде ескі ғимараттар қалды.
Dialogue: 0,0:12:46.91,0:12:49.20,Default,,0,0,0,,Олардың көпшілігі басқа жерге көшірілді.
Dialogue: 0,0:12:50.08,0:12:51.37,Default,,0,0,0,,Көшіру дегеніміз не?
Dialogue: 0,0:12:51.95,0:12:53.04,Default,,0,0,0,,Мен әкелдім
Dialogue: 0,0:12:53.54,0:12:54.70,Default,,0,0,0,,Жын апатынан кейін
Dialogue: 0,0:12:54.79,0:12:57.79,Default,,0,0,0,,Ескі ғимараттарды сақтау қиынға соқты.
Dialogue: 0,0:12:59.54,0:13:02.33,Default,,0,0,0,,Мен оларды қорғауға оңай қауіпсіз жерге жинадым.
Dialogue: 0,0:13:10.95,0:13:12.87,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:13:16.58,0:13:18.29,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:13:18.87,0:13:19.87,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:23.04,0:13:25.41,Default,,0,0,0,,Ходжо мырза сізге көп рахмет.
Dialogue: 0,0:13:26.04,0:13:28.04,Default,,0,0,0,,Сюитті дереу дайындаңыз.
Dialogue: 0,0:13:28.12,0:13:29.70,Default,,0,0,0,,Қалыпты бөлме жақсы.
Dialogue: 0,0:13:30.20,0:13:31.62,Default,,0,0,0,,2 бөлме
Dialogue: 0,0:13:32.12,0:13:33.37,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:13:38.50,0:13:40.04,Default,,0,0,0,,Кешкі асқа кездесейік
Dialogue: 0,0:13:40.54,0:13:43.08,Default,,0,0,0,,Мейрамхананың қабатында пісірілген тофу дүкені бар.
Dialogue: 0,0:13:43.16,0:13:45.04,Default,,0,0,0,,Сол жерде кешкі сағат 17:00-де кездесіңіз.
Dialogue: 0,0:13:47.41,0:13:50.87,Default,,0,0,0,,Бұл менің нөмірім. Егер сізге бірдеңе керек болса, маған хабарласыңыз.
Dialogue: 0,0:13:51.45,0:13:53.00,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:13:57.41,0:14:00.54,Default,,0,0,0,,Мм! Біраз уақыттан кейін бірінші төсек!
Dialogue: 0,0:14:00.62,0:14:03.08,Default,,0,0,0,,Ах! О құдайым-ай
Dialogue: 0,0:14:06.62,0:14:09.37,Default,,0,0,0,,Сәлеметсіз бе (Ичиноза) А... А, Каэде-сенпай?
Dialogue: 0,0:14:09.45,0:14:12.20,Default,,0,0,0,,Эй, бейбітшілік агенттіктері «қойма жындарына» айналды
Dialogue: 0,0:14:12.29,0:14:14.20,Default,,0,0,0,,Сіз желіде сыйлық бар екенін білесіз бе?
Dialogue: 0,0:14:14.29,0:14:16.95,Default,,0,0,0,,Ах~ Иә, иә, бұл жерде де қауесеттер бар.
Dialogue: 0,0:14:17.04,0:14:18.58,Default,,0,0,0,,Мен себебін білгім келеді.
Dialogue: 0,0:14:18.66,0:14:22.54,Default,,0,0,0,,Хмм, бірақ... Мен ақпаратты бөгде адамдарға бере алмаймын...
Dialogue: 0,0:14:22.62,0:14:24.70,Default,,0,0,0,,Сіз маған бөтен адам сияқты қарайсыз ба?
Dialogue: 0,0:14:24.79,0:14:27.29,Default,,0,0,0,,Ах... түсіндім. Мен түссіндім!
Dialogue: 0,0:14:27.79,0:14:30.58,Default,,0,0,0,,Бұл «қойма жын» аздап...
Dialogue: 0,0:14:30.66,0:14:32.62,Default,,0,0,0,,Жоқ, бұл өте қауіпті.
Dialogue: 0,0:14:32.70,0:14:35.04,Default,,0,0,0,,Хосифудзиманың 18 жыл бұрын жоғалып кеткен оқиғасы
Dialogue: 0,0:14:35.87,0:14:37.04,Default,,0,0,0,,Бұған да не себеп болды
Dialogue: 0,0:14:37.12,0:14:39.50,Default,,0,0,0,,Сақтаушы жын туралы қауесеттер бар...
Dialogue: 0,0:14:40.00,0:14:42.37,Default,,0,0,0,,Хошифурудзиманың жоғалу оқиғасы...
Dialogue: 0,0:14:43.37,0:14:45.79,Default,,0,0,0,,Аререр? А... Жақында кесіп аламын.
Dialogue: 0,0:14:47.00,0:14:50.37,Default,,0,0,0,,Ичиноза мырза, сіз Америкаға жетекшілік еттіңіз.
Dialogue: 0,0:14:51.29,0:14:53.79,Default,,0,0,0,,Жақында болған төбелестің себебі неде?
Dialogue: 0,0:14:53.87,0:14:55.50,Default,,0,0,0,,Сіз оны қадағалай алдыңыз ба?
Dialogue: 0,0:14:55.58,0:14:58.58,Default,,0,0,0,,Иә, қазір бүкіл топ деректер жинауда.
Dialogue: 0,0:14:58.66,0:15:01.33,Default,,0,0,0,,Мен жақын арада бірдеңе хабарлай аламын деп үміттенемін...
Dialogue: 0,0:15:15.70,0:15:17.70,Default,,0,0,0,,Уау! таңқаларлық!
Dialogue: 0,0:15:24.58,0:15:27.25,Default,,0,0,0,,Коконое-сан, мен Киотоны көріп тұрмын.
Dialogue: 0,0:15:28.25,0:15:29.08,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:29.87,0:15:31.16,Default,,0,0,0,,Сіз не оқып жатырсыз?
Dialogue: 0,0:15:32.37,0:15:33.45,Default,,0,0,0,,Бұл роман.
Dialogue: 0,0:15:34.12,0:15:35.50,Default,,0,0,0,,Мен жиі мас болмаймын.
Dialogue: 0,0:15:36.75,0:15:37.87,Default,,0,0,0,,Оған үйреніп кетесің.
Dialogue: 0,0:15:38.83,0:15:42.75,Default,,0,0,0,,Қарияның көп жылдар бойы қуған адамы осы ма?
Dialogue: 0,0:15:44.20,0:15:47.83,Default,,0,0,0,,Яги: Мына үлкен қонақүйді көріп тұрсың ба?
Dialogue: 0,0:15:48.58,0:15:50.20,Default,,0,0,0,,Сол жерге барыңыз.
Dialogue: 0,0:15:50.29,0:15:50.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:51.70,0:15:56.33,Default,,0,0,0,,Бірнеше сағат бұрын онда Ходжо Каэденің картасы қолданылған.
Dialogue: 0,0:15:56.41,0:15:59.37,Default,,0,0,0,,Каэде Ходжо? Ол төрағаның немересі ме?
Dialogue: 0,0:15:59.95,0:16:03.58,Default,,0,0,0,,А, ол нысанамен жұмыс істеп жатқан сияқты.
Dialogue: 0,0:16:13.12,0:16:14.91,Default,,0,0,0,,«Жұлдызды аралдың жоғалуы»
Dialogue: 0,0:16:15.70,0:16:18.08,Default,,0,0,0,,«2000 арал із-түзсіз жоғалды»
Dialogue: 0,0:16:18.16,0:16:21.54,Default,,0,0,0,,«Жоғалғандар арасында Ходжо Зайбацумен туыстары бар»…
Dialogue: 0,0:16:29.04,0:16:30.29,Default,,0,0,0,,Igigi?
Dialogue: 0,0:16:32.41,0:16:35.45,Default,,0,0,0,,Бұл менің анам.
Dialogue: 0,0:16:36.25,0:16:38.87,Default,,0,0,0,,18 жыл бұрын Жынның жаңа түрін зерттеу
Dialogue: 0,0:16:38.95,0:16:40.79,Default,,0,0,0,,Мен Хошифуру аралында болдым.
Dialogue: 0,0:16:43.45,0:16:45.25,Default,,0,0,0,,Бір түнде арал жоғалып кетті.
Dialogue: 0,0:16:51.00,0:16:53.25,Default,,0,0,0,,Аралдықтармен бірге менің анам да
Dialogue: 0,0:16:55.20,0:16:58.50,Default,,0,0,0,,Жұлдыздар аралы жындардың кесірінен жоғалып кетті.
Dialogue: 0,0:16:58.58,0:17:00.04,Default,,0,0,0,,Ата ойланып қалды
Dialogue: 0,0:17:03.00,0:17:07.25,Default,,0,0,0,,Тергеу жүргізу үшін құрылған ұйым «бейбітшілік ұйымы» болып табылады.
Dialogue: 0,0:17:08.41,0:17:11.70,Default,,0,0,0,,Атам әлі де жындарды жек көреді
Dialogue: 0,0:17:12.33,0:17:13.79,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:17:13.87,0:17:15.29,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:17:19.37,0:17:20.95,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:21.04,0:17:21.83,Default,,0,0,0,,Igi?
Dialogue: 0,0:17:25.91,0:17:30.00,Default,,0,0,0,,Мм, пісірілген тофу дүкені, пісірілген тофу дүкені...
Dialogue: 0,0:17:30.50,0:17:31.75,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:17:31.83,0:17:32.50,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:17:33.16,0:17:34.58,Default,,0,0,0,,Ал оны өзгерте алмасам…
Dialogue: 0,0:17:41.25,0:17:43.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:43.54,0:17:45.91,Default,,0,0,0,,Мен ұйықтап жатырмын.
Dialogue: 0,0:17:48.70,0:17:51.66,Default,,0,0,0,,Ходжо мырза, сізбен бірге біреу келді.
Dialogue: 0,0:17:55.66,0:17:58.12,Default,,0,0,0,,Күткеніңізге рахмет, Каэде-сан.
Dialogue: 0,0:18:00.20,0:18:01.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:02.37,0:18:04.37,Default,,0,0,0,,(Кендоның есінеу)
Dialogue: 0,0:18:04.45,0:18:05.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:05.91,0:18:09.70,Default,,0,0,0,,Hyupi~
Dialogue: 0,0:18:13.29,0:18:14.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:16.95,0:18:18.29,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:18:20.41,0:18:21.70,Default,,0,0,0,,Бұл да жұмыс.
Dialogue: 0,0:18:22.20,0:18:22.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:23.00,0:18:24.70,Default,,0,0,0,,Қауіпті материалдарды өңдеуге ұқсас
Dialogue: 0,0:18:27.54,0:18:31.20,Default,,0,0,0,,Сақтау демоны, оны жинауға рұқсат етіңіз.
Dialogue: 0,0:18:31.29,0:18:33.41,Default,,0,0,0,,А, а... Анна...
Dialogue: 0,0:18:35.41,0:18:37.62,Default,,0,0,0,,Қайырлы түн балам
Dialogue: 0,0:18:38.54,0:18:41.33,Default,,0,0,0,,Хуупи мен үйге бара жатырмын (Хупи) Хуупи~
Dialogue: 0,0:18:41.41,0:18:42.70,Default,,0,0,0,,Ал... күте тұрыңыз
Dialogue: 0,0:18:43.62,0:18:46.16,Default,,0,0,0,,Аннаны өзіңізбен бірге алып кетпеңіз...
Dialogue: 0,0:18:50.37,0:18:52.37,Default,,0,0,0,,♪～
Dialogue: 0,0:21:14.54,0:21:16.54,Default,,0,0,0,,～♪
