Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.58,0:00:08.58,Default,,0,0,0,,(Қыздың күлкісі)
Dialogue: 0,0:00:13.33,0:00:16.08,Default,,0,0,0,,Уау әдемі
Dialogue: 0,0:00:43.75,0:00:45.75,Default,,0,0,0,,♪～
Dialogue: 0,0:02:03.83,0:02:04.00,Default,,0,0,0,,～♪
Dialogue: 0,0:02:04.00,0:02:05.83,Default,,0,0,0,,～♪
Dialogue: 0,0:02:04.00,0:02:05.83,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:05.83,0:02:08.87,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:08.95,0:02:11.54,Default,,0,0,0,,Бұл Хакатадағы шығын жағдайы
Dialogue: 0,0:02:11.62,0:02:13.50,Default,,0,0,0,,Далалық есептерге сәйкес
Dialogue: 0,0:02:13.58,0:02:16.45,Default,,0,0,0,,Көптеген адамдар із-түзсіз жоғалған сияқты.
Dialogue: 0,0:02:16.54,0:02:18.45,Default,,0,0,0,,〈Премьер-министр Хакатаға барады〉
Dialogue: 0,0:02:18.54,0:02:20.41,Default,,0,0,0,,<Апатты аймақ ретінде белгіленген>
Dialogue: 0,0:02:20.50,0:02:22.70,Default,,0,0,0,,<Ең жоғары деңгейдегі шабуылға дайын болыңыз⸺>
Dialogue: 0,0:02:22.79,0:02:24.54,Default,,0,0,0,,<Қорғаныс министрлігіне тапсырма берді>
Dialogue: 0,0:02:24.62,0:02:27.58,Default,,0,0,0,,Жындарды жойып, Жерді қайтарып алыңыз
Dialogue: 0,0:02:27.66,0:02:28.83,Default,,0,0,0,,Жындарды жойыңыз...
Dialogue: 0,0:02:28.91,0:02:30.91,Default,,0,0,0,,Жындар – таза емес жандар. ``Бұл дүниенің соңы ма?''
Dialogue: 0,0:02:30.91,0:02:31.79,Default,,0,0,0,,«Бұл дүниенің ақыры ма?»
Dialogue: 0,0:02:36.54,0:02:38.16,Default,,0,0,0,,Басқарылатын зымыран жұмыс істемейді
Dialogue: 0,0:02:38.25,0:02:42.54,Default,,0,0,0,,3-ші 6-шы және 11-ші блоктармен байланыс үзілді.
Dialogue: 0,0:02:42.62,0:02:45.41,Default,,0,0,0,,Мақсат Шығысқа қарай бет алды.
Dialogue: 0,0:02:47.75,0:02:49.58,Default,,0,0,0,,Уа, қаш!
Dialogue: 0,0:02:55.95,0:02:57.33,Default,,0,0,0,,Адамгершілік
Dialogue: 0,0:02:57.41,0:03:00.91,Default,,0,0,0,,Біз жындар не үшін пайда болғанымызды білесіз бе?
Dialogue: 0,0:03:02.08,0:03:05.54,Default,,0,0,0,,Ядролық полигонда Жер тозаққа қосылды
Dialogue: 0,0:03:07.04,0:03:10.41,Default,,0,0,0,,Біз тозақпен ластанған құм түйіріміз.
Dialogue: 0,0:03:28.87,0:03:31.66,Default,,0,0,0,,Біз тозақпен ластанған құм түйіріміз
Dialogue: 0,0:03:32.33,0:03:37.33,Default,,0,0,0,,Өсіп келе жатқан адамзат баласын тәртіпке келтіру үшін Құдай жіберген болуы керек.
Dialogue: 0,0:03:40.25,0:03:43.25,Default,,0,0,0,,Сіз бізден инстинктивті түрде қорқасыз.
Dialogue: 0,0:03:43.83,0:03:45.12,Default,,0,0,0,,Бас тартылған нәрсе болды
Dialogue: 0,0:03:45.79,0:03:49.54,Default,,0,0,0,,Өйткені біз ақырзаманға әкелетін өзіміз екенімізді сезіндік.
Dialogue: 0,0:03:50.58,0:03:53.83,Default,,0,0,0,,Енді дұға ет, мейірім сұра.
Dialogue: 0,0:04:06.66,0:04:08.16,Default,,0,0,0,,Әлемнің түкпір-түкпіріндегі елдер
Dialogue: 0,0:04:08.25,0:04:10.62,Default,,0,0,0,,Жапон үкіметіне алаңдаушылық білдіру
Dialogue: 0,0:04:11.54,0:04:14.79,Default,,0,0,0,,Біздің қаруымыз оған ештеңе істей алмайды.
Dialogue: 0,0:04:14.87,0:04:18.37,Default,,0,0,0,,Бейбітшілік агенттіктерінің технологиясымен бірдеңе істей аламыз ба?
Dialogue: 0,0:04:19.33,0:04:22.33,Default,,0,0,0,,Оның сыртқы түрі есептелмеген.
Dialogue: 0,0:04:22.91,0:04:28.66,Default,,0,0,0,,Америка бір кездері оны ядролық қуатпен жойып үлгерді.
Dialogue: 0,0:04:29.29,0:04:31.87,Default,,0,0,0,,Менің де дәл солай істеуден басқа амалым жоқ.
Dialogue: 0,0:04:31.95,0:04:33.08,Default,,0,0,0,,А...
Dialogue: 0,0:04:33.58,0:04:37.08,Default,,0,0,0,,Халықты құтқарудан басқа амалымыз жоқ.
Dialogue: 0,0:04:37.66,0:04:40.54,Default,,0,0,0,,Кеш болмай тұрып шешім қабылда
Dialogue: 0,0:04:47.87,0:04:50.12,Default,,0,0,0,,Премьер-министрге кеңес беру
Dialogue: 0,0:04:51.41,0:04:54.91,Default,,0,0,0,,Жапония құрбандық шалуы керек
Dialogue: 0,0:04:58.87,0:05:02.25,Default,,0,0,0,,Сол жын дүниежүзілік соғысқа ұқсайды.
Dialogue: 0,0:05:02.33,0:05:04.08,Default,,0,0,0,,Олай десеңіз ше?
Dialogue: 0,0:05:04.16,0:05:06.29,Default,,0,0,0,,Енді бұл жерден тез кетуіміз керек.
Dialogue: 0,0:05:06.37,0:05:08.41,Default,,0,0,0,,Сіз! Ах!
Dialogue: 0,0:05:08.50,0:05:10.29,Default,,0,0,0,,Саған жақсы, Кентокун.
Dialogue: 0,0:05:10.79,0:05:12.41,Default,,0,0,0,,Баяу тұрыңыз
Dialogue: 0,0:05:13.62,0:05:16.50,Default,,0,0,0,,Каэде-сан, мен...
Dialogue: 0,0:05:17.12,0:05:19.91,Default,,0,0,0,,Жер бетінде не бар? Бұл қайда?
Dialogue: 0,0:05:20.50,0:05:24.62,Default,,0,0,0,,Қалпына келтіру жын Кентоның жын бөлшектерін өсіреді.
Dialogue: 0,0:05:24.70,0:05:26.20,Default,,0,0,0,,Мен оны басымнан шығарып алдым.
Dialogue: 0,0:05:26.87,0:05:29.37,Default,,0,0,0,,Сонда бұл бала саған туды
Dialogue: 0,0:05:30.37,0:05:31.20,Default,,0,0,0,,Чумимин
Dialogue: 0,0:05:31.29,0:05:35.20,Default,,0,0,0,,Менен туған ба? Сондай сүйкімді
Dialogue: 0,0:05:35.29,0:05:35.95,Default,,0,0,0,,Чуми?
Dialogue: 0,0:05:36.70,0:05:37.66,Default,,0,0,0,,Кирико ше?
Dialogue: 0,0:05:38.25,0:05:42.12,Default,,0,0,0,,Олар Пандемониумды қалпына келтірді және қазір Хакатаны жойып жатыр.
Dialogue: 0,0:05:43.16,0:05:46.29,Default,,0,0,0,,Біз қаланы көшіру үшін шерудеміз.
Dialogue: 0,0:05:46.37,0:05:47.58,Default,,0,0,0,,Чуми?
Dialogue: 0,0:05:52.29,0:05:54.79,Default,,0,0,0,,Бұл менің кінәм... солай ма?
Dialogue: 0,0:05:55.41,0:05:57.87,Default,,0,0,0,,Әркім зардап шеккенде қиын.
Dialogue: 0,0:05:57.95,0:05:59.75,Default,,0,0,0,,Бұл Кентокунның кінәсі емес.
Dialogue: 0,0:05:59.83,0:06:01.79,Default,,0,0,0,,Сол жын кінәлі
Dialogue: 0,0:06:01.87,0:06:02.54,Default,,0,0,0,,Чика
Dialogue: 0,0:06:05.08,0:06:07.41,Default,,0,0,0,,Қорғаныс министрлігі АҚШ-пен ынтымақтасады.
Dialogue: 0,0:06:07.50,0:06:10.54,Default,,0,0,0,,Пандемонияны жою үшін ядролық қуатты пайдалану туралы шешім қабылдады.
Dialogue: 0,0:06:11.04,0:06:13.16,Default,,0,0,0,,Яги, тезірек тікұшақ алаңына бар.
Dialogue: 0,0:06:13.25,0:06:14.08,Default,,0,0,0,,Иә
Dialogue: 0,0:06:17.87,0:06:20.33,Default,,0,0,0,,Үкімет Хакатаны құрбан етуді жоспарлап отыр ма?
Dialogue: 0,0:06:20.83,0:06:23.62,Default,,0,0,0,,Бәлкім, зиян одан әрі тарамай тұрып.
Dialogue: 0,0:06:23.70,0:06:26.33,Default,,0,0,0,,Бұл жындыны жеңудің жалғыз жолы.
Dialogue: 0,0:06:26.83,0:06:30.45,Default,,0,0,0,,Олай болса басқа адамдарға тікұшақ алаңына баруды айту керек.
Dialogue: 0,0:06:31.04,0:06:33.70,Default,,0,0,0,,Өкінішке орай, бізде қосалқы тікұшақ жоқ.
Dialogue: 0,0:06:34.20,0:06:35.25,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:06:35.75,0:06:37.29,Default,,0,0,0,,100 км радиусы
Dialogue: 0,0:06:38.00,0:06:40.37,Default,,0,0,0,,Оның ішіндегі тіршілік жойылады.
Dialogue: 0,0:06:46.20,0:06:48.70,Default,,0,0,0,,Адамдар кетті.
Dialogue: 0,0:06:49.20,0:06:53.04,Default,,0,0,0,,Біз бұрынғыдай ядролық қуатқа сүйенеміз бе?
Dialogue: 0,0:06:54.54,0:06:57.04,Default,,0,0,0,,Бірақ бұрынғыдай емес, бұл жолы...
Dialogue: 0,0:06:58.20,0:07:01.58,Default,,0,0,0,,Пандемониум алдымен Токионы жояды.
Dialogue: 0,0:07:08.16,0:07:10.54,Default,,0,0,0,,Не болды? неге тоқтатылды?
Dialogue: 0,0:07:10.62,0:07:13.37,Default,,0,0,0,,Сіз не істеп жатырсыз? Сіз шабуылды тоқтаттыңыз ба?
Dialogue: 0,0:07:14.04,0:07:17.20,Default,,0,0,0,,Одан да үлкен деструктивті сәуле шығару
Dialogue: 0,0:07:17.95,0:07:20.79,Default,,0,0,0,,Ол энергияны сақтауы мүмкін.
Dialogue: 0,0:07:21.37,0:07:23.12,Default,,0,0,0,,Оның мақсаты қандай?
Dialogue: 0,0:07:25.87,0:07:26.87,Default,,0,0,0,,Токио?
Dialogue: 0,0:07:27.37,0:07:29.50,Default,,0,0,0,,Біздің уақытымыз жоқ
Dialogue: 0,0:07:29.58,0:07:32.58,Default,,0,0,0,,Ядролық зымырандарды ұшыру жеделдетілгенін қалаймын.
Dialogue: 0,0:07:55.12,0:07:58.45,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:08:00.16,0:08:02.04,Default,,0,0,0,,Яги мырза, көлікті тоқтатыңыз!
Dialogue: 0,0:08:02.12,0:08:03.95,Default,,0,0,0,,Ана екеуміз көмектесуге барамыз.
Dialogue: 0,0:08:04.04,0:08:06.41,Default,,0,0,0,,В... Біртүрлі әзілдер жарайды!
Dialogue: 0,0:08:06.91,0:08:09.16,Default,,0,0,0,,Ядролық зымырандар құлап жатыр!
Dialogue: 0,0:08:16.75,0:08:19.58,Default,,0,0,0,,Анна Көпірді қолдау үшін бірдеңе әкел!
Dialogue: 0,0:08:19.66,0:08:20.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:21.04,0:08:22.75,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:08:23.54,0:08:25.29,Default,,0,0,0,,...
Dialogue: 0,0:08:25.79,0:08:27.54,Default,,0,0,0,,Igi! Игиги...
Dialogue: 0,0:08:27.62,0:08:29.58,Default,,0,0,0,,Осы жерден эвакуациялаңыз! Жүгір!
Dialogue: 0,0:08:31.20,0:08:32.58,Default,,0,0,0,,Ах! (Коноэ) Иә!
Dialogue: 0,0:08:35.70,0:08:37.33,Default,,0,0,0,,Чумимин?
Dialogue: 0,0:08:38.16,0:08:38.83,Default,,0,0,0,,Гуа!
Dialogue: 0,0:08:39.79,0:08:42.58,Default,,0,0,0,,(Ерлер мен әйелдердің айқайы)
Dialogue: 0,0:08:42.66,0:08:43.95,Default,,0,0,0,,Мұнда кел, асығыңыз!
Dialogue: 0,0:08:44.79,0:08:46.25,Default,,0,0,0,,Сіз зардап шеккен жоқсыз, солай ма?
Dialogue: 0,0:08:49.45,0:08:51.12,Default,,0,0,0,,Бұл қиын! тесік!
Dialogue: 0,0:08:52.45,0:08:54.95,Default,,0,0,0,,Чумимин
Dialogue: 0,0:08:56.66,0:08:58.41,Default,,0,0,0,,Кя! (Анашым) О!
Dialogue: 0,0:09:03.00,0:09:04.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:04.20,0:09:07.16,Default,,0,0,0,,Чумимин
Dialogue: 0,0:09:08.91,0:09:12.83,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:20.16,0:09:21.20,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:26.08,0:09:27.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:41.08,0:09:43.33,Default,,0,0,0,,Әй, жын! (Әйел) Бұл өтірік емес пе?
Dialogue: 0,0:09:43.41,0:09:45.00,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:09:45.08,0:09:47.54,Default,,0,0,0,,Жындар көп... (Ер адам) Рахмет.
Dialogue: 0,0:09:49.12,0:09:52.29,Default,,0,0,0,,Жындар адамдарға қалай көмектеседі?
Dialogue: 0,0:09:53.91,0:09:55.66,Default,,0,0,0,,Чумимин
Dialogue: 0,0:09:58.58,0:10:01.29,Default,,0,0,0,,Коконое-сан, мен Хакатаға қайтамын.
Dialogue: 0,0:10:01.37,0:10:03.83,Default,,0,0,0,,Не? Бұл өте ақылсыз!
Dialogue: 0,0:10:03.91,0:10:06.91,Default,,0,0,0,,Мүмкін мен және мына Чумимин болсам
Dialogue: 0,0:10:07.00,0:10:09.16,Default,,0,0,0,,Мүмкін мен Кирико-санмен сөйлесетін шығармын.
Dialogue: 0,0:10:09.25,0:10:11.95,Default,,0,0,0,,Өтінемін, мен бәріне міндетті түрде көмектесемін!
Dialogue: 0,0:10:13.04,0:10:15.50,Default,,0,0,0,,Мен атаға өтініш айтамын.
Dialogue: 0,0:10:15.58,0:10:17.62,Default,,0,0,0,,Уақытты аз да болса бәсеңдету
Dialogue: 0,0:10:19.04,0:10:19.87,Default,,0,0,0,,Төраға!
Dialogue: 0,0:10:27.08,0:10:31.70,Default,,0,0,0,,Командир, зымырандық шабуылды уақытша тоқтатуыңызды өтінемін!
Dialogue: 0,0:10:31.79,0:10:35.29,Default,,0,0,0,,тым кеш. үшін мақұлданды.
Dialogue: 0,0:10:35.37,0:10:38.91,Default,,0,0,0,,Жоқ! Немерем әлі сонда!
Dialogue: 0,0:10:41.91,0:10:45.25,Default,,0,0,0,,Кешіріңіз, бірақ сіз осылай дедіңіз.
Dialogue: 0,0:10:45.33,0:10:48.79,Default,,0,0,0,,Халықты құтқарудан басқа амалымыз жоқ.
Dialogue: 0,0:11:07.62,0:11:08.50,Default,,0,0,0,,Сіз!
Dialogue: 0,0:11:10.33,0:11:12.58,Default,,0,0,0,,Чумимин
Dialogue: 0,0:11:13.33,0:11:14.50,Default,,0,0,0,,Кирико-сан
Dialogue: 0,0:11:14.58,0:11:16.04,Default,,0,0,0,,Кирико мырза...
Dialogue: 0,0:11:16.66,0:11:19.79,Default,,0,0,0,,Бұл сезім... сен бе, Кенто?
Dialogue: 0,0:11:20.29,0:11:23.04,Default,,0,0,0,,Кирико мырза, тоқтаңыз.
Dialogue: 0,0:11:23.12,0:11:25.62,Default,,0,0,0,,Кенто-кун, мен оны тастамаймын.
Dialogue: 0,0:11:26.37,0:11:28.33,Default,,0,0,0,,Бұл менің рөлім.
Dialogue: 0,0:11:28.41,0:11:30.83,Default,,0,0,0,,Мен және Анна ынтымақтастықта болдық
Dialogue: 0,0:11:30.91,0:11:34.37,Default,,0,0,0,,Біз адамдар мен жындар бірге өмір сүретін әлемді жасаймыз.
Dialogue: 0,0:11:34.45,0:11:35.87,Default,,0,0,0,,Әр адамның әлемінде!
Dialogue: 0,0:11:35.95,0:11:37.66,Default,,0,0,0,,Қазірдің өзінде кеш
Dialogue: 0,0:11:38.16,0:11:40.54,Default,,0,0,0,,Жындар адамдарға сене алмайды
Dialogue: 0,0:11:42.08,0:11:45.12,Default,,0,0,0,,Біз көрген жараны емдеуге амал жоқ.
Dialogue: 0,0:11:45.95,0:11:49.83,Default,,0,0,0,,Егер сіз Анна екеуіңіз әлі де адамдар жағында болсаңыздар.
Dialogue: 0,0:11:50.62,0:11:53.45,Default,,0,0,0,,Балалар, сендерді де осы жерде өлтірейік.
Dialogue: 0,0:11:53.54,0:11:54.45,Default,,0,0,0,,Уау
Dialogue: 0,0:12:08.58,0:12:11.70,Default,,0,0,0,,Үмітіңді үзбе, Кирико-сан
Dialogue: 0,0:12:12.33,0:12:14.91,Default,,0,0,0,,Мен сені ерекше түрде сағындырдым.
Dialogue: 0,0:12:15.70,0:12:17.41,Default,,0,0,0,,Енді мейірімділік жоқ
Dialogue: 0,0:12:28.70,0:12:30.41,Default,,0,0,0,,Енді түсіндің, солай ма?
Dialogue: 0,0:12:30.50,0:12:33.20,Default,,0,0,0,,Адамдар қаншалықты ұсқынсыз?
Dialogue: 0,0:12:34.45,0:12:37.58,Default,,0,0,0,,Өйткені, аман қалғымыз келсе
Dialogue: 0,0:12:37.66,0:12:40.37,Default,,0,0,0,,Басқа тіршілік иелерінің есебінен де аман қалу
Dialogue: 0,0:12:42.20,0:12:46.37,Default,,0,0,0,,Мен адамзаттың ядролық қаруды қолдануын тозаққа апаратын есікке айналдырамын.
Dialogue: 0,0:12:47.50,0:12:49.79,Default,,0,0,0,,Қош бол Кентокун
Dialogue: 0,0:12:50.50,0:12:53.37,Default,,0,0,0,,Мен енді ештеңе жоғалтқым келмейді
Dialogue: 0,0:12:54.12,0:12:56.66,Default,,0,0,0,,үшін, тезірек бұл жерден қашыңдар!
Dialogue: 0,0:12:56.75,0:12:59.54,Default,,0,0,0,,Мен Аннаға ядролық зымыранды сақтауға беремін!
Dialogue: 0,0:13:05.83,0:13:07.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:10.29,0:13:12.95,Default,,0,0,0,,Бұл менің кінәм болды
Dialogue: 0,0:13:20.16,0:13:22.54,Default,,0,0,0,,Ешкім қашпайды, солай ма?
Dialogue: 0,0:13:23.50,0:13:26.29,Default,,0,0,0,,Бұл жай ғана жалақыға сәйкес келмейді.
Dialogue: 0,0:13:27.08,0:13:29.08,Default,,0,0,0,,Хаха
Dialogue: 0,0:13:40.45,0:13:44.87,Default,,0,0,0,,Мүмкін бүгін менің Аннамен саяхатымның соңы шығар.
Dialogue: 0,0:13:45.54,0:13:47.04,Default,,0,0,0,,Рахмет, Ана
Dialogue: 0,0:13:47.54,0:13:51.12,Default,,0,0,0,,Аннаның арқасында менде көптеген қуанышты естеліктер қалды.
Dialogue: 0,0:13:51.20,0:13:52.54,Default,,0,0,0,,Ана (Өсімдік жын) Чуми
Dialogue: 0,0:13:53.75,0:13:55.58,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,0:13:56.20,0:13:59.45,Default,,0,0,0,,үшінның менімен бірге болғанын қалаймын.
Dialogue: 0,0:14:00.79,0:14:01.79,Default,,0,0,0,,Чуми?
Dialogue: 0,0:14:02.87,0:14:05.33,Default,,0,0,0,,Бұл бір отбасы сияқты, солай емес пе?
Dialogue: 0,0:14:07.04,0:14:08.70,Default,,0,0,0,,Чумимин
Dialogue: 0,0:14:16.95,0:14:18.04,Default,,0,0,0,,Чуми…
Dialogue: 0,0:14:30.50,0:14:31.83,Default,,0,0,0,,Керемет
Dialogue: 0,0:14:55.83,0:14:58.12,Default,,0,0,0,,Хмм...? бұл!
Dialogue: 0,0:14:58.75,0:15:00.20,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:05.75,0:15:12.75,Default,,0,0,0,,(Каору ән айтып жатыр)
Dialogue: 0,0:15:22.83,0:15:26.50,Default,,0,0,0,,Шибазуке қосылған Кенто Якисоба дайын.
Dialogue: 0,0:15:26.58,0:15:27.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:33.58,0:15:37.04,Default,,0,0,0,,Баяу тамақтаныңыз, бұл сізге ұнайды.
Dialogue: 0,0:15:37.83,0:15:43.04,Default,,0,0,0,,Иә! Мен біраз бұрын шынымен ұзақ армандадым.
Dialogue: 0,0:15:43.12,0:15:46.12,Default,,0,0,0,,Мен Жынмен бірге саяхаттаймын!
Dialogue: 0,0:15:46.66,0:15:47.50,Default,,0,0,0,,Жын?
Dialogue: 0,0:15:47.58,0:15:51.08,Default,,0,0,0,,Иә! Бұл өте сүйкімді
Dialogue: 0,0:15:51.16,0:15:52.91,Default,,0,0,0,,Сақтау мүмкіндігі бар
Dialogue: 0,0:15:53.00,0:15:55.87,Default,,0,0,0,,Алдымен тірі заттарды сақтай алмайсыз.
Dialogue: 0,0:15:55.95,0:15:59.45,Default,,0,0,0,,Көбірек қуат шыққан сайын, аты...
Dialogue: 0,0:16:01.12,0:16:02.04,Default,,0,0,0,,Анна…
Dialogue: 0,0:16:27.91,0:16:29.50,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:16:30.25,0:16:34.12,Default,,0,0,0,,Осы уақытқа дейін саяхаттау қиын болса керек.
Dialogue: 0,0:16:38.04,0:16:39.33,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:16:39.87,0:16:42.33,Default,,0,0,0,,Мен оны әлі кішкентай деп ойладым
Dialogue: 0,0:16:42.41,0:16:44.04,Default,,0,0,0,,Мықты бала болғаның үшін рахмет.
Dialogue: 0,0:16:44.95,0:16:47.83,Default,,0,0,0,,Анашым, мен мақтанамын.
Dialogue: 0,0:16:50.29,0:16:53.75,Default,,0,0,0,,Мен анамды өмірге қайтарғым келді.
Dialogue: 0,0:16:57.33,0:16:58.62,Default,,0,0,0,,Жетеді
Dialogue: 0,0:16:59.50,0:17:02.58,Default,,0,0,0,,Әйтеуір бір күні қоштасуға тура келді.
Dialogue: 0,0:17:03.58,0:17:06.33,Default,,0,0,0,,Бұл сәл жылдамырақ.
Dialogue: 0,0:17:07.70,0:17:11.33,Default,,0,0,0,,Өлген адамды тірілтетін ешкім жоқ
Dialogue: 0,0:17:12.04,0:17:13.50,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:17:14.70,0:17:19.33,Default,,0,0,0,,Егер біз мұны істей алсақ, адамдар асыға күтпес еді, солай ма?
Dialogue: 0,0:17:19.41,0:17:24.91,Default,,0,0,0,,Бірақ мен анаммен көбірек уақыт өткізгім келді!
Dialogue: 0,0:17:32.12,0:17:33.16,Default,,0,0,0,,Кенто
Dialogue: 0,0:17:34.04,0:17:37.41,Default,,0,0,0,,Мен әрқашан сенің ішіңдемін
Dialogue: 0,0:17:45.08,0:17:48.04,Default,,0,0,0,,Мен сізді жақсы көремін анашым
Dialogue: 0,0:17:48.54,0:17:52.00,Default,,0,0,0,,Анам да Кентоны жақсы көреді.
Dialogue: 0,0:17:59.70,0:18:00.75,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:18:05.33,0:18:06.37,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:18:29.75,0:18:33.87,Default,,0,0,0,,Кенто-кун! Бұл Аннаның сақтау орны ма?
Dialogue: 0,0:18:39.33,0:18:41.25,Default,,0,0,0,,Бұл...! неге?
Dialogue: 0,0:18:49.91,0:18:52.54,Default,,0,0,0,,Арх! Қарғыс атқыр...
Dialogue: 0,0:18:58.54,0:18:59.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:00.95,0:19:02.00,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:19:03.33,0:19:06.75,Default,,0,0,0,,Мен сені ренжіте алмайтын сияқтымын.
Dialogue: 0,0:19:08.66,0:19:09.79,Default,,0,0,0,,Кирико-сан
Dialogue: 0,0:19:09.87,0:19:12.16,Default,,0,0,0,,Ұрысты доғарыңыз.
Dialogue: 0,0:19:13.16,0:19:14.20,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:19:14.29,0:19:17.91,Default,,0,0,0,,Жындар мен адамдар тіл табыса алатын әлем құру.
Dialogue: 0,0:19:18.00,0:19:19.45,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:19:19.54,0:19:21.62,Default,,0,0,0,,Сіз шынымен де мұны істей аламын деп ойлайсыз ба?
Dialogue: 0,0:19:22.12,0:19:24.25,Default,,0,0,0,,Кирико бас тартты
Dialogue: 0,0:19:24.75,0:19:28.04,Default,,0,0,0,,Өйткені мен әлемді өзгертуге болатынына сенемін.
Dialogue: 0,0:19:31.95,0:19:34.54,Default,,0,0,0,,Қарасам... таза екен.
Dialogue: 0,0:19:35.62,0:19:38.29,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:19:39.08,0:19:40.58,Default,,0,0,0,,Бұл менің жоғалтуым
Dialogue: 0,0:19:41.20,0:19:42.91,Default,,0,0,0,,Мен саған бәс тігемін
Dialogue: 0,0:19:43.62,0:19:47.04,Default,,0,0,0,,Қолымнан келмесе, бір күні қайтамын.
Dialogue: 0,0:19:50.25,0:19:52.37,Default,,0,0,0,,Менің соңғы өтінішім бар.
Dialogue: 0,0:19:53.87,0:19:59.41,Default,,0,0,0,,Мына баланың естелігін үйге апарып, бір жерге жерлеуіңді қалаймын.
Dialogue: 0,0:20:15.95,0:20:17.33,Default,,0,0,0,,Игиги... (Кэде) Не?
Dialogue: 0,0:20:20.45,0:20:21.87,Default,,0,0,0,,Чумимин (Кэде) Кенто-кун!
Dialogue: 0,0:20:21.95,0:20:22.79,Default,,0,0,0,,Igi
Dialogue: 0,0:20:22.87,0:20:25.16,Default,,0,0,0,,Чуми Чу Чу Чумин
Dialogue: 0,0:20:25.79,0:20:28.66,Default,,0,0,0,,Мені осында Анна әкелді
Dialogue: 0,0:20:28.75,0:20:30.70,Default,,0,0,0,,үшінн осы жерден шығару үшін.
Dialogue: 0,0:20:55.41,0:20:56.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:58.62,0:20:59.62,Default,,0,0,0,,Бір минут күтіңіз...
Dialogue: 0,0:21:02.83,0:21:04.91,Default,,0,0,0,,Ана, тез бірге барайық.
Dialogue: 0,0:21:06.79,0:21:07.70,Default,,0,0,0,,Ана?
Dialogue: 0,0:21:11.70,0:21:12.83,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:21:13.87,0:21:16.08,Default,,0,0,0,,Ана! Ана!
Dialogue: 0,0:21:16.62,0:21:19.12,Default,,0,0,0,,Үйге бірге қайтайық, Ана!
Dialogue: 0,0:21:20.29,0:21:23.29,Default,,0,0,0,,Ана!
Dialogue: 0,0:21:23.37,0:21:24.58,Default,,0,0,0,,Чумин
Dialogue: 0,0:21:28.00,0:21:29.20,Default,,0,0,0,,Кенто-кун
Dialogue: 0,0:21:35.04,0:21:35.75,Default,,0,0,0,,Анна?
Dialogue: 0,0:21:35.83,0:21:36.45,Default,,0,0,0,,Чуми…
Dialogue: 0,0:21:36.54,0:21:37.58,Default,,0,0,0,,Ана!
Dialogue: 0,0:22:05.87,0:22:07.29,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:22:08.08,0:22:11.25,Default,,0,0,0,,Аннадағы Жұлдызды аралды кім көрді?
Dialogue: 0,0:22:12.45,0:22:13.29,Default,,0,0,0,,Иә
Dialogue: 0,0:22:13.79,0:22:17.41,Default,,0,0,0,,Сондықтан әр адамның жеке сақтау орны болмайды.
Dialogue: 0,0:22:17.50,0:22:19.04,Default,,0,0,0,,Ортақ
Dialogue: 0,0:22:19.66,0:22:21.95,Default,,0,0,0,,Егер Анна ынтымақтаса
Dialogue: 0,0:22:22.04,0:22:25.12,Default,,0,0,0,,Аралды құтқару мүмкіндігі
Dialogue: 0,0:22:26.16,0:22:27.87,Default,,0,0,0,,Менің анам да
Dialogue: 0,0:22:27.95,0:22:31.16,Default,,0,0,0,,Мүмкін біз көмектесеміз.
Dialogue: 0,0:22:33.29,0:22:34.41,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:35.04,0:22:39.87,Default,,0,0,0,,Мен ұзақ уақыт бойы жек көрушіліктен жынды өлтірмек болдым, бірақ...
Dialogue: 0,0:22:40.45,0:22:44.41,Default,,0,0,0,,Негізі мен сізден ынтымақтастық туралы сұрауым керек еді.
Dialogue: 0,0:22:45.91,0:22:48.54,Default,,0,0,0,,Бейбітшілік институттарының болашағын құру
Dialogue: 0,0:22:49.12,0:22:53.20,Default,,0,0,0,,Бұл Каэде және басқалар сияқты жас ұрпақ шығар.
Dialogue: 0,0:22:54.00,0:22:55.33,Default,,0,0,0,,Оны айтудың пайдасы жоқ қой?
Dialogue: 0,0:23:09.08,0:23:10.87,Default,,0,0,0,,Мен және Аннаның саяхаты үшін
Dialogue: 0,0:23:10.95,0:23:13.41,Default,,0,0,0,,Неше түрлі оқиғалар болды.
Dialogue: 0,0:23:19.70,0:23:21.83,Default,,0,0,0,,Әртүрлі адамдар мен жындармен кездесу
Dialogue: 0,0:23:22.41,0:23:23.91,Default,,0,0,0,,Дос болу...
Dialogue: 0,0:23:24.95,0:23:26.33,Default,,0,0,0,,Ұрыс...
Dialogue: 0,0:23:30.54,0:23:33.54,Default,,0,0,0,,Осының бәрін бастан кешіргеннен кейін мен мұны түсіндім
Dialogue: 0,0:23:34.33,0:23:38.62,Default,,0,0,0,,Дүниедегі ең қорқынышты нәрсе адам да, жын да емес.
Dialogue: 0,0:23:43.62,0:23:47.70,Default,,0,0,0,,Жүрегімдегі қараңғылық бар сұлулығын өшіреді.
Dialogue: 0,0:23:52.41,0:23:55.25,Default,,0,0,0,,Өйткені ең ауыр жағдайды бастан кешіргеннен кейін
Dialogue: 0,0:23:55.79,0:23:59.79,Default,,0,0,0,,Бәріміз бірге жұмыс істеуіміз керек
Dialogue: 0,0:24:00.41,0:24:03.20,Default,,0,0,0,,Адамдар мен жындар арасындағы өшпенділікті жою
Dialogue: 0,0:24:03.79,0:24:08.37,Default,,0,0,0,,Қараңғылықтан бұрынғы сұлу жүрегімді қайтарғым келеді.
Dialogue: 0,0:24:09.41,0:24:10.95,Default,,0,0,0,,Рахмет
Dialogue: 0,0:24:11.54,0:24:12.62,Default,,0,0,0,,Кенто Тачибана
Dialogue: 0,0:24:51.20,0:24:52.20,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:24:54.25,0:24:56.33,Default,,0,0,0,,Мен әлі күшті емеспін
Dialogue: 0,0:24:58.91,0:25:03.45,Default,,0,0,0,,Мен анам соңғы сәттерінде айтқан күшті балаға айналған жоқпын.
Dialogue: 0,0:25:04.95,0:25:07.08,Default,,0,0,0,,Сондықтан мен анамды көргім келеді.
Dialogue: 0,0:25:07.91,0:25:09.29,Default,,0,0,0,,Мен де Аннамен кездескім келеді.
Dialogue: 0,0:25:18.79,0:25:20.12,Default,,0,0,0,,Сіз!
Dialogue: 0,0:25:37.54,0:25:39.54,Default,,0,0,0,,♪～
Dialogue: 0,0:28:01.70,0:28:03.70,Default,,0,0,0,,～♪
