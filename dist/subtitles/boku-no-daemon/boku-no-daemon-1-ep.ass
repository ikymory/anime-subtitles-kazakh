Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.83,0:00:23.04,Default,,0,0,0,,Уф
Dialogue: 0,0:00:23.12,0:00:24.70,Default,,0,0,0,,Не?
Dialogue: 0,0:00:25.79,0:00:26.79,Default,,0,0,0,,Ана
Dialogue: 0,0:00:33.79,0:00:35.62,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:00:46.00,0:00:48.00,Default,,0,0,0,,♪～
Dialogue: 0,0:02:06.25,0:02:06.66,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:06.66,0:02:08.66,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:06.66,0:02:08.66,Default,,0,0,0,,～♪
Dialogue: 0,0:02:08.66,0:02:11.12,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:12.29,0:02:14.95,Default,,0,0,0,,Бір күні мен шөпте қалдым
Dialogue: 0,0:02:15.04,0:02:18.58,Default,,0,0,0,,Мен бұлыңғыр қызыл болып жарқыраған құм түйірін таптым.
Dialogue: 0,0:02:18.66,0:02:19.58,Default,,0,0,0,,Ядролық апаттан кейінгі Токио
Dialogue: 0,0:02:19.58,0:02:21.08,Default,,0,0,0,,Ядролық апаттан кейінгі Токио Демон бөлшектері
Dialogue: 0,0:02:21.08,0:02:22.08,Default,,0,0,0,,Ядролық апаттан кейінгі Токио
Dialogue: 0,0:02:22.66,0:02:25.95,Default,,0,0,0,,Мен оны үйге апарып, бақылауды жөн көрдім.
Dialogue: 0,0:02:26.66,0:02:29.79,Default,,0,0,0,,Күніне 3 мм-ге өседі.
Dialogue: 0,0:02:29.87,0:02:32.12,Default,,0,0,0,,Жүрек болып соға бастады.
Dialogue: 0,0:02:32.95,0:02:35.16,Default,,0,0,0,,Ол шамамен 10 см жеткенде
Dialogue: 0,0:02:35.25,0:02:37.91,Default,,0,0,0,,Мен төрт аяқты жын болдым, сосын...
Dialogue: 0,0:02:38.00,0:02:41.00,Default,,0,0,0,,Бір минут күте тұрыңыз, Кенто-кун.
Dialogue: 0,0:02:41.08,0:02:44.50,Default,,0,0,0,,Менің ойымша, сіз бұл жыннан дұрыс құтылдыңыз ба?
Dialogue: 0,0:02:44.58,0:02:46.70,Default,,0,0,0,,Жоқ, мен осындамын.
Dialogue: 0,0:02:46.79,0:02:47.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:48.00,0:02:50.54,Default,,0,0,0,,Қараңдаршы, менің атым Ана.
Dialogue: 0,0:02:50.62,0:02:52.95,Default,,0,0,0,,Бұл Анна, себебі ол "Анаа" деп жылайды
Dialogue: 0,0:02:53.04,0:02:53.87,Default,,0,0,0,,Анааа
Dialogue: 0,0:02:53.95,0:02:56.20,Default,,0,0,0,,Ой, бұл не? (Сыныптасы) Бұл жиіркенішті.
Dialogue: 0,0:02:56.29,0:02:57.12,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:02:57.20,0:02:59.62,Default,,0,0,0,,Кенто-кун! Оны тастаңыз!
Dialogue: 0,0:02:59.70,0:03:02.08,Default,,0,0,0,,(Соңғы қоңырау)
Dialogue: 0,0:03:10.58,0:03:13.37,Default,,0,0,0,,Сегіз миллион құдай бізді тастамайды.
Dialogue: 0,0:03:14.20,0:03:15.70,Default,,0,0,0,,Әрқашан құтқарылу бар
Dialogue: 0,0:03:16.50,0:03:20.50,Default,,0,0,0,,үшінңыз тоқтап, мені тыңдаңыздар.
Dialogue: 0,0:03:21.54,0:03:24.04,Default,,0,0,0,,Біздің қолымызда әсем жер
Dialogue: 0,0:03:24.12,0:03:26.29,Default,,0,0,0,,Біз оны қайтаруымыз керек.
Dialogue: 0,0:03:29.29,0:03:31.62,Default,,0,0,0,,Бұл шықты! Сен бейбақ!
Dialogue: 0,0:03:33.00,0:03:35.25,Default,,0,0,0,,Өте сүйкімді болса да
Dialogue: 0,0:03:35.33,0:03:38.20,Default,,0,0,0,,Неліктен жындарды жек көреді?
Dialogue: 0,0:03:38.29,0:03:39.41,Default,,0,0,0,,Сәлем Кенто
Dialogue: 0,0:03:39.50,0:03:40.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:40.29,0:03:41.87,Default,,0,0,0,,Жынды шығар
Dialogue: 0,0:03:41.95,0:03:43.50,Default,,0,0,0,,Әкем айтты
Dialogue: 0,0:03:43.58,0:03:46.66,Default,,0,0,0,,«Егер сіз жын тапсаңыз, оны өлтіруіңіз керек».
Dialogue: 0,0:03:46.75,0:03:49.50,Default,,0,0,0,,Олардан құтылыңыз. Егер олар көбейсе, не істейсіз?
Dialogue: 0,0:03:49.58,0:03:53.04,Default,,0,0,0,,Сіз Аннаны өлтіре алмайсыз!
Dialogue: 0,0:03:53.12,0:03:54.70,Default,,0,0,0,,Тоқтаңдар, балалар.
Dialogue: 0,0:03:55.20,0:03:56.37,Default,,0,0,0,,Сіз оны жек көресіз, солай ма?
Dialogue: 0,0:03:56.45,0:03:57.45,Default,,0,0,0,,Сәлем әпке
Dialogue: 0,0:03:57.54,0:04:00.33,Default,,0,0,0,,Мына жігіт жын балаларын тәрбиелеп отыр.
Dialogue: 0,0:04:00.41,0:04:02.87,Default,,0,0,0,,Жын? Бұл рас па?
Dialogue: 0,0:04:02.95,0:04:04.04,Default,,0,0,0,,Ум...
Dialogue: 0,0:04:04.58,0:04:05.58,Default,,0,0,0,,Анааа
Dialogue: 0,0:04:12.95,0:04:14.25,Default,,0,0,0,,Лас!
Dialogue: 0,0:04:14.75,0:04:17.83,Default,,0,0,0,,Маған берші! Жүр, асығыңыз!
Dialogue: 0,0:04:20.58,0:04:21.62,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:04:22.87,0:04:25.20,Default,,0,0,0,,Жынның бөлшегі қимылсыз
Dialogue: 0,0:04:25.29,0:04:27.70,Default,,0,0,0,,Ядролық полигон шөлінен жел соғу
Dialogue: 0,0:04:28.20,0:04:29.91,Default,,0,0,0,,Дүние жүзіне шашыраңқы
Dialogue: 0,0:04:30.54,0:04:34.66,Default,,0,0,0,,Олардың жұтып қойғаны – жын.
Dialogue: 0,0:04:35.16,0:04:37.00,Default,,0,0,0,,Адамзат жындарға қарсы
Dialogue: 0,0:04:37.08,0:04:41.62,Default,,0,0,0,,Сіздің жан дүниеңіздің негізгі бөлігінен тыйым салынған эмоциялар бар сияқты.
Dialogue: 0,0:04:41.70,0:04:45.20,Default,,0,0,0,,Немесе бұл жындарға деген өшпенділік шығар.
Dialogue: 0,0:04:45.29,0:04:48.45,Default,,0,0,0,,Бұл сенің адам екендігіңнің дәлелі деуге болады.
Dialogue: 0,0:04:50.54,0:04:51.45,Default,,0,0,0,,«Бейбітшілік ұйымы»
Dialogue: 0,0:04:52.04,0:04:53.45,Default,,0,0,0,,Жирену?
Dialogue: 0,0:04:53.54,0:04:57.00,Default,,0,0,0,,Менің балам Демон мені жақсы көреді...
Dialogue: 0,0:04:57.08,0:04:59.54,Default,,0,0,0,,Кенто-кун? Жын ба?
Dialogue: 0,0:04:59.62,0:05:03.33,Default,,0,0,0,,Өз бетінше іздену барысында бақылау күнделігін жүргіздім.
Dialogue: 0,0:05:03.41,0:05:04.58,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:05:05.16,0:05:07.12,Default,,0,0,0,,Менің балам өзгерді.
Dialogue: 0,0:05:07.62,0:05:09.00,Default,,0,0,0,,Бірақ бұл жақсы.
Dialogue: 0,0:05:09.08,0:05:10.70,Default,,0,0,0,,Ондағы екі адам
Dialogue: 0,0:05:10.79,0:05:11.95,Default,,0,0,0,,Иә
Dialogue: 0,0:05:20.16,0:05:21.95,Default,,0,0,0,,...
Dialogue: 0,0:05:22.04,0:05:23.33,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:05:24.16,0:05:26.04,Default,,0,0,0,,Сіз аш болуыңыз керек.
Dialogue: 0,0:05:31.16,0:05:34.70,Default,,0,0,0,,Презентация Бұл қалай болды? Бүгін болды, солай ма?
Dialogue: 0,0:05:34.79,0:05:36.95,Default,,0,0,0,,үшін таң қалды.
Dialogue: 0,0:05:37.54,0:05:39.33,Default,,0,0,0,,(Танжиро) Ал, баста! (Үшеуі) Бар күшіңді сал!
Dialogue: 0,0:05:40.91,0:05:41.91,Default,,0,0,0,,Иә
Dialogue: 0,0:05:43.87,0:05:48.25,Default,,0,0,0,,Ааа, өте сүйкімді, көзім шығып кете жаздады
Dialogue: 0,0:05:49.41,0:05:51.79,Default,,0,0,0,,Тұсаукесер аяқталды, бірақ
Dialogue: 0,0:05:52.29,0:05:55.12,Default,,0,0,0,,Неге Аннаны табиғатқа жібермейсің?
Dialogue: 0,0:05:55.62,0:05:58.04,Default,,0,0,0,,Сіз оны бұдан былай сақтауды жоспарлайсыз ба?
Dialogue: 0,0:05:58.12,0:05:59.87,Default,,0,0,0,,Иә, жоқ па?
Dialogue: 0,0:06:05.37,0:06:07.25,Default,,0,0,0,,(Кентоның күлкісі)
Dialogue: 0,0:06:08.45,0:06:09.91,Default,,0,0,0,,Оны сақтаған дұрыс.
Dialogue: 0,0:06:10.00,0:06:11.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:11.58,0:06:13.79,Default,,0,0,0,,Анна Біз бірге боламыз!
Dialogue: 0,0:06:14.29,0:06:15.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:19.00,0:06:21.12,Default,,0,0,0,,Аха Ана!
Dialogue: 0,0:06:19.00,0:06:21.12,Default,,0,0,0,,3 айдан кейін
Dialogue: 0,0:06:21.12,0:06:21.20,Default,,0,0,0,,3 айдан кейін
Dialogue: 0,0:06:21.20,0:06:21.54,Default,,0,0,0,,О, ау!
Dialogue: 0,0:06:21.20,0:06:21.54,Default,,0,0,0,,3 айдан кейін
Dialogue: 0,0:06:21.54,0:06:23.20,Default,,0,0,0,,О, ау!
Dialogue: 0,0:06:23.29,0:06:25.08,Default,,0,0,0,,Ана на на на
Dialogue: 0,0:06:38.45,0:06:39.62,Default,,0,0,0,,Demon пайдаланушысы
Dialogue: 0,0:06:40.12,0:06:41.62,Default,,0,0,0,,Қала тұрғыны жалдаған
Dialogue: 0,0:06:41.70,0:06:44.87,Default,,0,0,0,,Менің ойымша, олар тым көбейген жын-шайтандардың санын азайтуға тырысады.
Dialogue: 0,0:06:44.95,0:06:45.83,Default,,0,0,0,,А?
Dialogue: 0,0:06:46.41,0:06:49.79,Default,,0,0,0,,Қараңдаршы, әлгі жындар жаға киіп алған, солай ма?
Dialogue: 0,0:06:50.41,0:06:52.91,Default,,0,0,0,,Ол өзіне бағыну үшін электр энергиясын жібереді.
Dialogue: 0,0:06:53.54,0:06:54.95,Default,,0,0,0,,Бірақ мен әлі біраз уақыт үйге оралмаймын.
Dialogue: 0,0:06:55.04,0:06:56.58,Default,,0,0,0,,Бұл сіздің жазаңыз! Жеңдер!
Dialogue: 0,0:06:56.66,0:06:57.45,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,0:06:57.54,0:06:58.83,Default,,0,0,0,,Ах! О, менің!
Dialogue: 0,0:07:01.87,0:07:02.70,Default,,0,0,0,,Ана
Dialogue: 0,0:07:03.20,0:07:06.08,Default,,0,0,0,,Шүкір, мына жігіттің мойыны сынған!
Dialogue: 0,0:07:06.58,0:07:09.04,Default,,0,0,0,,Жағаң да сынған сияқты.
Dialogue: 0,0:07:09.12,0:07:11.87,Default,,0,0,0,,Твит жазбаңыз, мен оны тастаймын ба?
Dialogue: 0,0:07:12.58,0:07:14.95,Default,,0,0,0,,Үйге қайтайық. Біз өлтірдік.
Dialogue: 0,0:07:15.54,0:07:17.00,Default,,0,0,0,,Сұраныс орындалды
Dialogue: 0,0:07:35.29,0:07:37.33,Default,,0,0,0,,Анна Бұл...
Dialogue: 0,0:07:37.83,0:07:39.25,Default,,0,0,0,,Анааа
Dialogue: 0,0:07:39.33,0:07:40.45,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:07:40.95,0:07:43.37,Default,,0,0,0,,Ол сынғандықтан, электр тогы өтпейді.
Dialogue: 0,0:07:43.45,0:07:45.79,Default,,0,0,0,,Бұл мені адасқан жын деп қателесті.
Dialogue: 0,0:07:45.87,0:07:47.91,Default,,0,0,0,,Жойылып кетем деп уайымдаудың қажеті жоқ.
Dialogue: 0,0:07:48.62,0:07:49.54,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:08:04.54,0:08:06.70,Default,,0,0,0,,Мен кейде Demon Battle де көремін.
Dialogue: 0,0:08:06.79,0:08:09.20,Default,,0,0,0,,Чикуваны жақсы көресің, солай емес пе?
Dialogue: 0,0:08:09.70,0:08:10.91,Default,,0,0,0,,Ана
Dialogue: 0,0:08:11.00,0:08:15.66,Default,,0,0,0,,Ха, Аннаның керемет сүйкімділігі туралы бәріне қалай білуге ​​болады?
Dialogue: 0,0:08:15.75,0:08:17.50,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:08:18.04,0:08:20.70,Default,,0,0,0,,Жын пайдаланушы болу туралы не айтасыз?
Dialogue: 0,0:08:20.79,0:08:23.29,Default,,0,0,0,,Сіз білесіз бе? Жынның ішінде
Dialogue: 0,0:08:23.37,0:08:25.54,Default,,0,0,0,,Құдіреті күшті бала бар.
Dialogue: 0,0:08:26.04,0:08:28.87,Default,,0,0,0,,Уақытты кері айналдыра алатын жын бар деген қауесет бар.
Dialogue: 0,0:08:28.95,0:08:30.83,Default,,0,0,0,,Ол Кюсю аймағында болса керек.
Dialogue: 0,0:08:31.33,0:08:33.33,Default,,0,0,0,,Сынған кофе шыныаяқының уақыты
Dialogue: 0,0:08:33.41,0:08:34.75,Default,,0,0,0,,Ол оны артқа айналдырып, бұрынғы қалпында қалпына келтіретінін айтты.
Dialogue: 0,0:08:34.75,0:08:35.79,Default,,0,0,0,,Ол оны артқа айналдырып, бұрынғы қалпына келтіретінін айтты.
Dialogue: 0,0:08:34.75,0:08:35.79,Default,,0,0,0,,Солтүстік Америкаға шабуыл жасалды
Dialogue: 0,0:08:35.79,0:08:35.87,Default,,0,0,0,,Ол оны артқа айналдырып, бұрынғы қалпына келтіремін деді.
Dialogue: 0,0:08:35.87,0:08:36.16,Default,,0,0,0,,Оны артқа айналдырып, бұрынғы қалпына келтіремін деді.
Dialogue: 0,0:08:35.87,0:08:36.16,Default,,0,0,0,,Жындар тудырған топтық шабуылға байланысты.
Dialogue: 0,0:08:36.16,0:08:38.41,Default,,0,0,0,,Жындар тудырған жаппай шабуылға байланысты.
Dialogue: 0,0:08:38.50,0:08:39.58,Default,,0,0,0,,Бірнеше қалалар
Dialogue: 0,0:08:39.66,0:08:41.83,Default,,0,0,0,,Біз апатты жағдайда тұрмыз.
Dialogue: 0,0:08:41.91,0:08:43.62,Default,,0,0,0,,Осының нәтижесінде дүниежүзілік шаруашылық
Dialogue: 0,0:08:43.70,0:08:44.70,Default,,0,0,0,,Теріс өсім күтілуде
Dialogue: 0,0:08:44.70,0:08:45.62,Default,,0,0,0,,Мама, соя соусын ал.
Dialogue: 0,0:08:44.70,0:08:45.62,Default,,0,0,0,,Теріс өсім күтілуде
Dialogue: 0,0:08:45.62,0:08:45.70,Default,,0,0,0,,Мама, соя соусын ал.
Dialogue: 0,0:08:45.70,0:08:46.75,Default,,0,0,0,,Мама, соя соусын ал.
Dialogue: 0,0:08:45.70,0:08:46.75,Default,,0,0,0,,Болашақта айтарлықтай қалпына келтіру күтілмейді.
Dialogue: 0,0:08:46.75,0:08:48.29,Default,,0,0,0,,Болашақта айтарлықтай қалпына келтіруді күтуге болмайды.
Dialogue: 0,0:08:48.37,0:08:49.41,Default,,0,0,0,,Екі рет секіру ме? Әзілдеп тұрсың ғой.
Dialogue: 0,0:08:48.37,0:08:49.41,Default,,0,0,0,,Қосымша көріністер
Dialogue: 0,0:08:49.41,0:08:49.70,Default,,0,0,0,,Қосымша көріністер
Dialogue: 0,0:08:50.12,0:08:52.37,Default,,0,0,0,,Иә? Ол кетті
Dialogue: 0,0:08:53.25,0:08:54.25,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:08:55.50,0:08:57.87,Default,,0,0,0,,Ана, сен сүйкімдісің
Dialogue: 0,0:08:57.95,0:09:00.50,Default,,0,0,0,,Тамақ ішу кезінде үстелде тұруға болмайды.
Dialogue: 0,0:09:02.04,0:09:03.37,Default,,0,0,0,,Иә
Dialogue: 0,0:09:10.41,0:09:12.33,Default,,0,0,0,,Бұны қайда сақтадың?
Dialogue: 0,0:09:13.12,0:09:14.33,Default,,0,0,0,,Ах… Мен оларды бір сәтке де ұмытқан емеспін.
Dialogue: 0,0:09:14.41,0:09:15.41,Default,,0,0,0,,Эй!
Dialogue: 0,0:09:16.00,0:09:17.25,Default,,0,0,0,,Ол шықты.
Dialogue: 0,0:09:18.04,0:09:20.25,Default,,0,0,0,,Анна, сен...
Dialogue: 0,0:09:50.95,0:09:51.91,Default,,0,0,0,,Дайын!
Dialogue: 0,0:09:52.00,0:09:52.66,Default,,0,0,0,,Сіз!
Dialogue: 0,0:09:53.62,0:09:54.58,Default,,0,0,0,,Вамуу сияқты біреу үшін де —
Dialogue: 0,0:09:55.12,0:09:55.33,Default,,0,0,0,,Керемет! тесік!
Dialogue: 0,0:09:55.33,0:09:56.41,Default,,0,0,0,,Керемет! тесік!
Dialogue: 0,0:09:55.33,0:09:56.41,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:56.50,0:09:58.70,Default,,0,0,0,,Наа на на на (Кенто) Ана, мен сені құрметтеймін.
Dialogue: 0,0:09:56.50,0:09:58.70,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:58.70,0:09:59.83,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:01.16,0:10:04.12,Default,,0,0,0,,Анна, маринадталған көкөністермен қуырылған кеспе беріңіз!
Dialogue: 0,0:10:04.20,0:10:05.25,Default,,0,0,0,,Сіз!
Dialogue: 0,0:10:06.08,0:10:08.12,Default,,0,0,0,,Әлі де жылы!
Dialogue: 0,0:10:09.20,0:10:10.79,Default,,0,0,0,,Сіз неге таң қалдыңыз?
Dialogue: 0,0:10:11.45,0:10:13.75,Default,,0,0,0,,Бұл 3 күн бұрынғы қуырылған кеспе!
Dialogue: 0,0:10:13.83,0:10:16.41,Default,,0,0,0,,Мен оны жаңадан өшірдім.
Dialogue: 0,0:10:16.50,0:10:18.45,Default,,0,0,0,,Ол жылы болады!
Dialogue: 0,0:10:18.54,0:10:20.33,Default,,0,0,0,,Жаңадан жасалған ба?
Dialogue: 0,0:10:21.20,0:10:23.08,Default,,0,0,0,,Бұл уақыт өткен жоқ дегенді білдіре ме?
Dialogue: 0,0:10:24.54,0:10:25.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:27.54,0:10:31.12,Default,,0,0,0,,Осының барлығының жарамдылық мерзімі аяқталуға жақын.
Dialogue: 0,0:10:31.20,0:10:32.29,Default,,0,0,0,,Оны сақтауға болады ма?
Dialogue: 0,0:10:32.37,0:10:34.20,Default,,0,0,0,,Анам…
Dialogue: 0,0:10:34.29,0:10:34.91,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:10:35.00,0:10:36.25,Default,,0,0,0,,Иә? (Кенто) Иә?
Dialogue: 0,0:10:36.33,0:10:37.33,Default,,0,0,0,,Иә
Dialogue: 0,0:10:42.66,0:10:44.50,Default,,0,0,0,,Әй, әпке?
Dialogue: 0,0:10:44.58,0:10:46.16,Default,,0,0,0,,Тачибана мырза
Dialogue: 0,0:10:46.25,0:10:49.29,Default,,0,0,0,,Мен сені көруге келдім, өйткені мен сенімен бірдеңе туралы сөйлескім келді.
Dialogue: 0,0:10:49.87,0:10:51.70,Default,,0,0,0,,Хмм... бұл не?
Dialogue: 0,0:10:53.25,0:10:56.58,Default,,0,0,0,,Үйде жын ұстайсың.
Dialogue: 0,0:10:57.20,0:10:59.95,Default,,0,0,0,,Төрт аяқ Барлық денеде көздер
Dialogue: 0,0:11:00.45,0:11:01.41,Default,,0,0,0,,Жын…
Dialogue: 0,0:11:01.50,0:11:04.20,Default,,0,0,0,,Жындар – лас тіршілік иелері
Dialogue: 0,0:11:04.29,0:11:06.79,Default,,0,0,0,,Үй жануарларын ұстау күпірлік.
Dialogue: 0,0:11:06.87,0:11:10.41,Default,,0,0,0,,Оны тапсыр, мен оны кәдеге жаратамын.
Dialogue: 0,0:11:11.12,0:11:14.41,Default,,0,0,0,,Мм... бұл таңқаларлық пайдалы.
Dialogue: 0,0:11:14.95,0:11:16.62,Default,,0,0,0,,Сақтау күші бар
Dialogue: 0,0:11:16.70,0:11:19.95,Default,,0,0,0,,Қалған тағам бірнеше күн бойы бұзылмай сақталады...
Dialogue: 0,0:11:23.33,0:11:26.00,Default,,0,0,0,,Бұл қорқынышты, мен білемін.
Dialogue: 0,0:11:26.08,0:11:27.37,Default,,0,0,0,,Сіздің балаңыз-
Dialogue: 0,0:11:27.45,0:11:30.04,Default,,0,0,0,,Ол жын бөлшектерімен ластанған, солай ма?
Dialogue: 0,0:11:30.54,0:11:31.87,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:11:31.95,0:11:35.00,Default,,0,0,0,,Мен көп өмір сүрмейтін шығармын. Бұл да Құдайдың жазасы ма?
Dialogue: 0,0:11:35.08,0:11:36.25,Default,,0,0,0,,Қайтуыңызды өтінемін!
Dialogue: 0,0:11:36.33,0:11:37.33,Default,,0,0,0,,Күтіңіз... күтіңіз...
Dialogue: 0,0:11:57.70,0:12:01.33,Default,,0,0,0,,Бұл күйде хирургиялық алып тастау мүмкін емес
Dialogue: 0,0:12:01.41,0:12:04.20,Default,,0,0,0,,Мен оған үнемі бетперде кигізетінмін.
Dialogue: 0,0:12:04.29,0:12:06.04,Default,,0,0,0,,Бұл жай ғана сәттілік
Dialogue: 0,0:12:06.54,0:12:08.37,Default,,0,0,0,,Бұл жын бөлшек
Dialogue: 0,0:12:08.45,0:12:12.08,Default,,0,0,0,,Күндердің күнінде қандай да бір себептермен олар өсіп, жұмыртқадан шығады.
Dialogue: 0,0:12:12.58,0:12:15.50,Default,,0,0,0,,Сол кезде бұл бала...
Dialogue: 0,0:12:15.58,0:12:18.62,Default,,0,0,0,,Бірақ ауру дамымайтын жағдайлар бар.
Dialogue: 0,0:12:18.70,0:12:20.20,Default,,0,0,0,,Қара, Шизуку.
Dialogue: 0,0:12:20.29,0:12:22.79,Default,,0,0,0,,Ересек жасқа дейін өмір сүру мүмкіндігі қандай?
Dialogue: 0,0:12:22.87,0:12:24.70,Default,,0,0,0,,Менің ойымша, өте аз...
Dialogue: 0,0:12:26.29,0:12:27.29,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:28.58,0:12:33.04,Default,,0,0,0,,Мен құтқарылатыныма сенемін.
Dialogue: 0,0:12:34.08,0:12:36.41,Default,,0,0,0,,«Бейбітшілік институттары»
Dialogue: 0,0:12:41.20,0:12:42.20,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:12:42.29,0:12:45.25,Default,,0,0,0,,Көрдіңіз бе, мен тіпті жын қолданушы емеспін.
Dialogue: 0,0:12:45.33,0:12:47.75,Default,,0,0,0,,Жын ұстайтын үй бар ма?
Dialogue: 0,0:12:47.83,0:12:49.83,Default,,0,0,0,,Сіз бұл туралы бірдеңе істей аласыз ба?
Dialogue: 0,0:12:50.66,0:12:52.16,Default,,0,0,0,,Жынның түрі?
Dialogue: 0,0:12:52.83,0:12:56.41,Default,,0,0,0,,Төрт аяқ, бүкіл денеде көз және...
Dialogue: 0,0:12:57.08,0:13:00.33,Default,,0,0,0,,Мен сенің заттарды сақтау қабілетің бар деп айтқаныңды естідім.
Dialogue: 0,0:13:00.41,0:13:02.62,Default,,0,0,0,,Сақтау мүмкіндігі, солай ма?
Dialogue: 0,0:13:03.12,0:13:04.87,Default,,0,0,0,,Сонымен нақты зияндар қандай?
Dialogue: 0,0:13:05.45,0:13:06.50,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:13:07.04,0:13:09.62,Default,,0,0,0,,Жарайды, ол кісінің мекен-жайы қандай?
Dialogue: 0,0:13:10.16,0:13:10.54,Default,,0,0,0,,〝Байланысты файлдар мен кілт сөздерді іздеу〞
Dialogue: 0,0:13:10.54,0:13:12.41,Default,,0,0,0,,Ақпарат үшін рахмет
Dialogue: 0,0:13:10.54,0:13:12.41,Default,,0,0,0,,〝Байланысты файлдар мен кілт сөздерді іздеу〞
Dialogue: 0,0:13:12.41,0:13:14.08,Default,,0,0,0,,〝Байланысты файлдар мен кілт сөздерді іздеу〞
Dialogue: 0,0:13:14.16,0:13:15.91,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:13:14.16,0:13:15.91,Default,,0,0,0,,``Ақпаратты жедел анықтау''
Dialogue: 0,0:13:15.91,0:13:16.00,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:13:16.00,0:13:16.41,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:13:16.00,0:13:16.41,Default,,0,0,0,,``Тез арада хабарлау және тиісті тараптарды шақыру''
Dialogue: 0,0:13:16.41,0:13:17.91,Default,,0,0,0,,``Тез арада есеп беру және тиісті тараптарды шақыру''
Dialogue: 0,0:13:19.29,0:13:22.58,Default,,0,0,0,,А, түсіндім. Бұл қайда?
Dialogue: 0,0:13:23.79,0:13:26.54,Default,,0,0,0,,Токионың шығыс аймағы
Dialogue: 0,0:13:28.29,0:13:30.54,Default,,0,0,0,,Түсіру тобын жіберіңіз
Dialogue: 0,0:13:32.12,0:13:33.66,Default,,0,0,0,,Жапонияда емес пе?
Dialogue: 0,0:13:35.37,0:13:38.20,Default,,0,0,0,,Жарайды, мен саған қалдырамын.
Dialogue: 0,0:13:39.54,0:13:41.12,Default,,0,0,0,,Өмір немесе өлім маңызды емес.
Dialogue: 0,0:14:01.37,0:14:03.04,Default,,0,0,0,,Касс спред
Dialogue: 0,0:14:03.12,0:14:05.50,Default,,0,0,0,,Бір нәрсе! Аяғымда бірдеңе бар!
Dialogue: 0,0:14:06.75,0:14:09.00,Default,,0,0,0,,Бұл менің әмияным, солай ма?
Dialogue: 0,0:14:10.58,0:14:13.70,Default,,0,0,0,,Каспер, мына жігітті жоғары көтер.
Dialogue: 0,0:14:14.95,0:14:17.00,Default,,0,0,0,,(Өтіп бара жатқандардың айқайы)
Dialogue: 0,0:14:17.08,0:14:18.33,Default,,0,0,0,,Капасу
Dialogue: 0,0:14:18.91,0:14:21.91,Default,,0,0,0,,Кім сізді көрінбейтін етіп жаратты?
Dialogue: 0,0:14:23.45,0:14:24.66,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:25.58,0:14:27.08,Default,,0,0,0,,Сіз айқай естідіңіз бе?
Dialogue: 0,0:14:27.58,0:14:29.04,Default,,0,0,0,,Каспер, мені өшір
Dialogue: 0,0:14:29.12,0:14:30.00,Default,,0,0,0,,СПА~
Dialogue: 0,0:14:30.08,0:14:30.91,Default,,0,0,0,,(Өтіп бара жатқандардың айқайы)
Dialogue: 0,0:14:33.91,0:14:36.54,Default,,0,0,0,,Қандай сүйкімді
Dialogue: 0,0:14:36.62,0:14:38.41,Default,,0,0,0,,Мен оны үйде сақтай аламын ба?
Dialogue: 0,0:14:38.95,0:14:42.54,Default,,0,0,0,,Мына қызға қарап якисоба жегім келеді.
Dialogue: 0,0:14:42.62,0:14:43.41,Default,,0,0,0,,Ана
Dialogue: 0,0:14:43.50,0:14:46.95,Default,,0,0,0,,Аа, әрине Анна әлдеқайда сүйкімді.
Dialogue: 0,0:14:47.45,0:14:50.62,Default,,0,0,0,,Енді мен сендерге Анна туралы 100 сүйкімді нәрсе айтып беремін.
Dialogue: 0,0:14:50.70,0:14:52.79,Default,,0,0,0,,Әуелі көзім толып кетті...
Dialogue: 0,0:14:52.87,0:14:53.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:54.25,0:14:56.91,Default,,0,0,0,,Сіз өзіңізбен бірге тағы бір қорқыныштысын алып келе жатырсыз.
Dialogue: 0,0:14:57.45,0:14:59.41,Default,,0,0,0,,Бұл нәрсені қалдырыңыз.
Dialogue: 0,0:14:59.50,0:15:01.00,Default,,0,0,0,,Мен нысананы алғым келді.
Dialogue: 0,0:15:02.54,0:15:05.33,Default,,0,0,0,,Маған ұнамайды. Мен оны саған бермеймін.
Dialogue: 0,0:15:05.41,0:15:06.91,Default,,0,0,0,,Ол менің досым.
Dialogue: 0,0:15:07.00,0:15:07.66,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:15:08.54,0:15:11.41,Default,,0,0,0,,(Бұзақтың күлкісі)
Dialogue: 0,0:15:11.50,0:15:12.62,Default,,0,0,0,,Бұл қызық!
Dialogue: 0,0:15:13.20,0:15:15.83,Default,,0,0,0,,Өйткені менің адами достарым жоқ
Dialogue: 0,0:15:15.91,0:15:19.66,Default,,0,0,0,,Айтпақшы, жындар менің достарым!
Dialogue: 0,0:15:20.54,0:15:22.70,Default,,0,0,0,,Маған адам достары керек емес
Dialogue: 0,0:15:22.79,0:15:23.54,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:23.62,0:15:26.58,Default,,0,0,0,,Егер менде Анна болса, маған басқа достар керек емес!
Dialogue: 0,0:15:26.66,0:15:27.75,Default,,0,0,0,,(металл құлаған дыбыс)
Dialogue: 0,0:15:27.83,0:15:28.83,Default,,0,0,0,,Не?
Dialogue: 0,0:15:30.66,0:15:33.16,Default,,0,0,0,,(шинаның үйкеліс шуы және қозғалтқыш шуы)
Dialogue: 0,0:15:33.25,0:15:34.41,Default,,0,0,0,,Сіз!
Dialogue: 0,0:15:35.54,0:15:37.16,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:15:40.95,0:15:42.79,Default,,0,0,0,,Гехохокохо
Dialogue: 0,0:15:43.62,0:15:45.62,Default,,0,0,0,,Жер бетінде не?
Dialogue: 0,0:15:46.25,0:15:49.29,Default,,0,0,0,,Жүк көлігі кенет пайда болды ма?
Dialogue: 0,0:15:49.37,0:15:50.45,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:15:51.16,0:15:54.20,Default,,0,0,0,,Мен бұл жігітті жарқыраған түрде өлтіруді ойладым.
Dialogue: 0,0:15:54.70,0:15:57.08,Default,,0,0,0,,Мен мұны соңғы сәтте түсіндім
Dialogue: 0,0:15:57.16,0:15:59.04,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:59.54,0:16:00.70,Default,,0,0,0,,Сыйлықты аңшы
Dialogue: 0,0:16:03.91,0:16:06.45,Default,,0,0,0,,Маған сол жерде жынды беріңіз.
Dialogue: 0,0:16:07.04,0:16:08.16,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:16:08.25,0:16:10.70,Default,,0,0,0,,Әй, жақсысыңдар ма, балалар!
Dialogue: 0,0:16:10.79,0:16:12.37,Default,,0,0,0,,Балалар жарақат алды ма?
Dialogue: 0,0:16:13.12,0:16:14.50,Default,,0,0,0,,Бұл ненің иісі?
Dialogue: 0,0:16:14.58,0:16:16.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:16.75,0:16:17.58,Default,,0,0,0,,Қаш!
Dialogue: 0,0:16:20.16,0:16:21.37,Default,,0,0,0,,Мені қу, Каспер!
Dialogue: 0,0:16:21.45,0:16:23.25,Default,,0,0,0,,Кяаспаа
Dialogue: 0,0:16:25.00,0:16:29.37,Default,,0,0,0,,(сирена дыбысы)
Dialogue: 0,0:16:29.45,0:16:30.75,Default,,0,0,0,,«Оның аман-есен жетуін қамтамасыз етші.»
Dialogue: 0,0:16:30.83,0:16:32.79,Default,,0,0,0,,Жүк көлігі саябаққа соқтығысты.
Dialogue: 0,0:16:32.87,0:16:34.41,Default,,0,0,0,,Балаларға жақын
Dialogue: 0,0:16:35.54,0:16:36.58,Default,,0,0,0,,Кенто!
Dialogue: 0,0:16:36.66,0:16:39.91,Default,,0,0,0,,Эй, біреу маған тамақ әкеліп берші.
Dialogue: 0,0:16:44.79,0:16:47.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:48.00,0:16:49.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:50.91,0:16:52.50,Default,,0,0,0,,Ана! О, менің!
Dialogue: 0,0:16:58.62,0:16:59.62,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:17:00.83,0:17:03.25,Default,,0,0,0,,(Құсанағи күлкі)
Dialogue: 0,0:17:03.33,0:17:05.45,Default,,0,0,0,,Кьяасупа~ (Құсанаги) Хехехехе
Dialogue: 0,0:17:10.95,0:17:13.29,Default,,0,0,0,,Жай тұрмай, тез қимылда!
Dialogue: 0,0:17:15.37,0:17:16.62,Default,,0,0,0,,Сіз! (Кенто) Уау!
Dialogue: 0,0:17:19.87,0:17:21.95,Default,,0,0,0,,Уау~
Dialogue: 0,0:17:23.58,0:17:25.83,Default,,0,0,0,,Уф, уф
Dialogue: 0,0:17:27.20,0:17:28.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:28.75,0:17:30.62,Default,,0,0,0,,Жоқ! Уау
Dialogue: 0,0:17:30.70,0:17:32.25,Default,,0,0,0,,Қат! Бұл не!
Dialogue: 0,0:17:34.00,0:17:36.70,Default,,0,0,0,,...
Dialogue: 0,0:17:41.04,0:17:43.33,Default,,0,0,0,,Бұл Кентоның сыныптасы еді...
Dialogue: 0,0:17:43.41,0:17:45.33,Default,,0,0,0,,Сіз жын бар баласыз ба?
Dialogue: 0,0:17:45.41,0:17:47.29,Default,,0,0,0,,Иә, мен дәл қазір сонда болдым.
Dialogue: 0,0:17:47.37,0:17:49.25,Default,,0,0,0,,Бала мен ересек ер адам
Dialogue: 0,0:17:49.33,0:17:51.00,Default,,0,0,0,,Мен арғы бетке шықтым.
Dialogue: 0,0:17:51.08,0:17:53.29,Default,,0,0,0,,Баланы қуып келе жатқандай болды.
Dialogue: 0,0:17:58.29,0:18:02.25,Default,,0,0,0,,Кяаспаа~
Dialogue: 0,0:18:02.33,0:18:04.04,Default,,0,0,0,,Барлық жолмен өлтіріңіз
Dialogue: 0,0:18:04.12,0:18:06.54,Default,,0,0,0,,...
Dialogue: 0,0:18:07.45,0:18:10.79,Default,,0,0,0,,Каспер абай бол (Каспер) Кя? Spa...
Dialogue: 0,0:18:14.33,0:18:16.20,Default,,0,0,0,,Әлгі шіркін жын
Dialogue: 0,0:18:16.29,0:18:18.45,Default,,0,0,0,,Бұл сіз қолданатын нәрсе ме?
Dialogue: 0,0:18:18.54,0:18:20.33,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,0:18:21.00,0:18:23.12,Default,,0,0,0,,Демек, бұл жын пайдаланушы.
Dialogue: 0,0:18:23.20,0:18:26.75,Default,,0,0,0,,Бұл лас жұмыс. О, менің жүрегім айнады.
Dialogue: 0,0:18:27.37,0:18:30.79,Default,,0,0,0,,Мен құбыжықтардың көмегінсіз өмір сүре алмаймын.
Dialogue: 0,0:18:30.87,0:18:34.70,Default,,0,0,0,,Сіз лайықты жұмыс таба алмайсыз. Сіз төменгі жағындасыз.
Dialogue: 0,0:18:35.83,0:18:36.91,Default,,0,0,0,,Әпке
Dialogue: 0,0:18:37.62,0:18:41.33,Default,,0,0,0,,Сіздің сәніңіз де өте батыл.
Dialogue: 0,0:18:42.66,0:18:47.00,Default,,0,0,0,,Не? сурет? Жоқ...! Мен, қашан?
Dialogue: 0,0:18:47.08,0:18:48.00,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:18:48.79,0:18:50.00,Default,,0,0,0,,Менің бетім!
Dialogue: 0,0:18:50.66,0:18:52.66,Default,,0,0,0,,Кяаа!
Dialogue: 0,0:18:57.41,0:19:00.33,Default,,0,0,0,,Ол жын қолданушы болды.
Dialogue: 0,0:19:00.41,0:19:03.95,Default,,0,0,0,,Қасында болған жын, Шатырларымен ұстаған жын.
Dialogue: 0,0:19:04.04,0:19:05.33,Default,,0,0,0,,Мөлдір етіп жасауға болады
Dialogue: 0,0:19:08.20,0:19:11.20,Default,,0,0,0,,Бірақ бұл әдемі жын еді.
Dialogue: 0,0:19:11.29,0:19:12.79,Default,,0,0,0,,Су йоканына ұқсайды
Dialogue: 0,0:19:13.83,0:19:15.37,Default,,0,0,0,,Сіз де солай ойлайсыз ба?
Dialogue: 0,0:19:15.45,0:19:16.20,Default,,0,0,0,,Сіз!
Dialogue: 0,0:19:16.29,0:19:19.45,Default,,0,0,0,,Бірақ ол неге Аннаны нысанаға алып отыр?
Dialogue: 0,0:19:19.54,0:19:22.50,Default,,0,0,0,,Сіз өзіңізді байлық аңшымын дедіңіз.
Dialogue: 0,0:19:22.58,0:19:23.08,Default,,0,0,0,,Анааа
Dialogue: 0,0:19:23.70,0:19:26.04,Default,,0,0,0,,Бұл туралы полицияға хабарлауым керек пе?
Dialogue: 0,0:19:26.12,0:19:29.25,Default,,0,0,0,,Ах...бірақ жындарды қорғайтын заң жоқ...
Dialogue: 0,0:19:29.75,0:19:30.62,Default,,0,0,0,,Сіз!
Dialogue: 0,0:19:39.58,0:19:41.08,Default,,0,0,0,,Паа~ Паа!
Dialogue: 0,0:19:41.91,0:19:44.66,Default,,0,0,0,,Фухахахаха
Dialogue: 0,0:19:44.75,0:19:46.70,Default,,0,0,0,,Оны барған сайын мөлдір ету
Dialogue: 0,0:19:46.79,0:19:50.37,Default,,0,0,0,,Қайда тығылсаң да, көресің!
Dialogue: 0,0:19:52.00,0:19:54.54,Default,,0,0,0,,...
Dialogue: 0,0:19:57.12,0:19:58.62,Default,,0,0,0,,(Гран Торино) Өкінішті. Мұндай ұсақ-түйекке тіпті реакция бере алмасаң—
Dialogue: 0,0:19:59.16,0:20:02.33,Default,,0,0,0,,Мен таптым. Сіз оны сонда таптыңыз ба?
Dialogue: 0,0:20:04.75,0:20:06.33,Default,,0,0,0,,Бұл қауіпті! Қанекей жүгірейік!
Dialogue: 0,0:20:12.79,0:20:15.20,Default,,0,0,0,,Тұйыққа тірелген сияқты.
Dialogue: 0,0:20:17.62,0:20:19.16,Default,,0,0,0,,Мен саған Аннаны бермеймін!
Dialogue: 0,0:20:19.75,0:20:21.45,Default,,0,0,0,,Ол ұрланғанға дейін
Dialogue: 0,0:20:21.54,0:20:23.00,Default,,0,0,0,,Каспер, мені өшір
Dialogue: 0,0:20:23.08,0:20:23.91,Default,,0,0,0,,Каспап
Dialogue: 0,0:20:24.62,0:20:29.33,Default,,0,0,0,,(Құсанагидің ізі)
Dialogue: 0,0:20:34.08,0:20:35.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:35.16,0:20:38.37,Default,,0,0,0,,(Құсанагидің ізі)
Dialogue: 0,0:20:38.45,0:20:39.54,Default,,0,0,0,,Бұл туралы не деуге болады!
Dialogue: 0,0:20:40.12,0:20:41.00,Default,,0,0,0,,Ta!
Dialogue: 0,0:20:41.08,0:20:43.66,Default,,0,0,0,,Ақымақ болма! Бұл көйлек қымбат болды!
Dialogue: 0,0:20:49.41,0:20:50.41,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:20:57.50,0:20:58.79,Default,,0,0,0,,Анана Анана!
Dialogue: 0,0:21:01.41,0:21:02.75,Default,,0,0,0,,Ана (Кендо) Ана!
Dialogue: 0,0:21:10.29,0:21:10.95,Default,,0,0,0,,Уау
Dialogue: 0,0:21:16.95,0:21:19.04,Default,,0,0,0,,О? Қайда бардың?
Dialogue: 0,0:21:19.12,0:21:20.79,Default,,0,0,0,,Сіз!
Dialogue: 0,0:21:20.87,0:21:21.95,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:21:22.04,0:21:22.87,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:22.95,0:21:23.83,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:24.70,0:21:26.54,Default,,0,0,0,,Қат! Каспер!
Dialogue: 0,0:21:26.62,0:21:28.41,Default,,0,0,0,,Касс таралу~
Dialogue: 0,0:21:36.54,0:21:40.41,Default,,0,0,0,,Қат! Қат! Қат! Қат!
Dialogue: 0,0:21:40.50,0:21:41.54,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:41.62,0:21:43.50,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:21:45.37,0:21:46.41,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:21:46.91,0:21:49.00,Default,,0,0,0,,Каспер босатылды.
Dialogue: 0,0:21:51.95,0:21:54.95,Default,,0,0,0,,Ана...қаш!
Dialogue: 0,0:21:55.04,0:21:55.83,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:21:55.91,0:21:57.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:57.20,0:21:59.70,Default,,0,0,0,,Сізге нұсқау берілгенімен неге қашпайсыз?
Dialogue: 0,0:22:00.25,0:22:03.12,Default,,0,0,0,,Жарайды, мен мұны аяқтаймын!
Dialogue: 0,0:22:04.70,0:22:05.54,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:08.62,0:22:10.16,Default,,0,0,0,,Әй, қайтар!
Dialogue: 0,0:22:10.79,0:22:11.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:12.83,0:22:15.91,Default,,0,0,0,,Каха... Бұл... На...
Dialogue: 0,0:22:16.62,0:22:17.54,Default,,0,0,0,,Бұрынғыдан да күшті болып кетті
Dialogue: 0,0:22:24.20,0:22:25.83,Default,,0,0,0,,Пааа
Dialogue: 0,0:22:27.66,0:22:28.50,Default,,0,0,0,,Па?
Dialogue: 0,0:22:29.70,0:22:31.12,Default,,0,0,0,,Жағаны шешіңіз
Dialogue: 0,0:22:31.20,0:22:33.16,Default,,0,0,0,,Spaa Spaa? (Кенто) Сіз қашуыңыз керек.
Dialogue: 0,0:22:33.83,0:22:37.25,Default,,0,0,0,,Жағаңды шешсең, жұрт сені адасқан жын деп ойлайды.
Dialogue: 0,0:22:37.75,0:22:39.00,Default,,0,0,0,,Қашып кеткен жөн
Dialogue: 0,0:22:39.50,0:22:42.45,Default,,0,0,0,,Осы жерде қалсаң, жойылып кетуің мүмкін.
Dialogue: 0,0:22:42.54,0:22:43.87,Default,,0,0,0,,Жарайды (Каспер) Паа Паа
Dialogue: 0,0:22:43.95,0:22:45.62,Default,,0,0,0,,Енді сіз боссыз
Dialogue: 0,0:22:45.70,0:22:46.83,Default,,0,0,0,,Spaa
Dialogue: 0,0:22:46.91,0:22:48.08,Default,,0,0,0,,Кенто!
Dialogue: 0,0:22:48.16,0:22:49.16,Default,,0,0,0,,Ана?
Dialogue: 0,0:22:50.95,0:22:51.87,Default,,0,0,0,,Кенто!
Dialogue: 0,0:22:53.12,0:22:54.62,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:22:54.70,0:22:57.16,Default,,0,0,0,,Мен оны іздедім! Мен уайымдадым!
Dialogue: 0,0:22:57.25,0:22:59.20,Default,,0,0,0,,Сіз жүк көлігі апаты болған жерде болдыңыз, солай ма?
Dialogue: 0,0:22:59.29,0:23:00.50,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:23:01.41,0:23:03.87,Default,,0,0,0,,Қатты! Мен жедел жәрдем шақыруым керек!
Dialogue: 0,0:23:04.37,0:23:08.33,Default,,0,0,0,,Оның орнына полиция шақырыңыз, ол адам сізге шабуыл жасады.
Dialogue: 0,0:23:08.41,0:23:10.83,Default,,0,0,0,,Маған шабуыл жасадыңыз ба? Неліктен?
Dialogue: 0,0:23:12.58,0:23:13.95,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:23:20.25,0:23:21.50,Default,,0,0,0,,Ана?
Dialogue: 0,0:23:23.45,0:23:26.41,Default,,0,0,0,,Кенто Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:23:26.91,0:23:27.75,Default,,0,0,0,,Иә
Dialogue: 0,0:23:28.25,0:23:31.16,Default,,0,0,0,,Иә, бұл жақсы...
Dialogue: 0,0:23:33.25,0:23:35.83,Default,,0,0,0,,Фухаха… Гехоггехо
Dialogue: 0,0:23:37.75,0:23:38.58,Default,,0,0,0,,Касс…
Dialogue: 0,0:23:39.08,0:23:43.91,Default,,0,0,0,,Эй, сен не істеп жатырсың? Біз дос емеспіз бе?
Dialogue: 0,0:23:44.62,0:23:47.33,Default,,0,0,0,,Кяаспаа!
Dialogue: 0,0:23:47.41,0:23:48.50,Default,,0,0,0,,Осы дүкеннен қанша адам ғайып болды екен?
Dialogue: 0,0:23:49.66,0:23:51.62,Default,,0,0,0,,Ана... Анашым!
Dialogue: 0,0:23:57.54,0:23:59.00,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:24:01.20,0:24:05.16,Default,,0,0,0,,(сағаттың секунд тілінің дыбысы)
Dialogue: 0,0:24:19.16,0:24:21.79,Default,,0,0,0,,(Кентоның айқайы)
Dialogue: 0,0:24:42.04,0:24:42.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:42.75,0:24:45.50,Default,,0,0,0,,(сағаттың секунд тілінің дыбысы)
Dialogue: 0,0:24:55.04,0:24:57.75,Default,,0,0,0,,(Стартқы қоңырау)
Dialogue: 0,0:25:18.91,0:25:22.12,Default,,0,0,0,,Сен, алдыңда ештеңе жоқ.
Dialogue: 0,0:25:22.20,0:25:23.41,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:25:23.50,0:25:24.95,Default,,0,0,0,,Кюсю аймағы
Dialogue: 0,0:25:25.04,0:25:27.91,Default,,0,0,0,,Кюсю? Ол өте алыс
Dialogue: 0,0:25:28.00,0:25:31.25,Default,,0,0,0,,Егер сіз осы бағытта жүрсеңіз, сонда жетесіз.
Dialogue: 0,0:25:31.33,0:25:33.83,Default,,0,0,0,,Менің кетуім керек.
Dialogue: 0,0:25:33.91,0:25:35.25,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:25:35.33,0:25:36.20,Default,,0,0,0,,Бұл...
Dialogue: 0,0:25:38.16,0:25:42.08,Default,,0,0,0,,Ана... анаңды қоя салшы.
Dialogue: 0,0:25:43.70,0:25:45.87,Default,,0,0,0,,Тірі объектілерді сақтау мүмкін емес.
Dialogue: 0,0:25:46.66,0:25:50.25,Default,,0,0,0,,Бірақ бүгінгі ана оны сақтай алатын шығар.
Dialogue: 0,0:25:51.62,0:25:53.62,Default,,0,0,0,,Мен мұны өсек-аяң арқылы естідім.
Dialogue: 0,0:25:54.12,0:25:55.66,Default,,0,0,0,,Кюсю аймағында
Dialogue: 0,0:25:55.75,0:25:58.08,Default,,0,0,0,,Уақытты кері айналдыра алатын жын бар.
Dialogue: 0,0:25:59.16,0:26:02.41,Default,,0,0,0,,Анаңызды алып, уақытын кері қайтарыңыз.
Dialogue: 0,0:26:02.91,0:26:05.87,Default,,0,0,0,,Біз сізді өмірге қайтара аламыз!
Dialogue: 0,0:26:06.58,0:26:08.16,Default,,0,0,0,,Анна өтінемін!
Dialogue: 0,0:26:30.25,0:26:31.25,Default,,0,0,0,,№
Dialogue: 0,0:26:34.25,0:26:36.83,Default,,0,0,0,,Қалай болғанда да, бұл одан әрі қауіпті.
Dialogue: 0,0:26:36.91,0:26:38.91,Default,,0,0,0,,Бала үйіне баруы керек
Dialogue: 0,0:26:39.00,0:26:40.12,Default,,0,0,0,,Жарайды, демалып, қуаттарымызды қалпына келтірейік
Dialogue: 0,0:26:44.54,0:26:45.12,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:26:45.20,0:26:45.70,Default,,0,0,0,,Сіз!
Dialogue: 0,0:26:54.00,0:26:56.00,Default,,0,0,0,,♪～
Dialogue: 0,0:29:18.33,0:29:20.33,Default,,0,0,0,,～♪
