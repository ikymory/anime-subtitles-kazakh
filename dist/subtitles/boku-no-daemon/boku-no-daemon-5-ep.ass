Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.29,0:00:14.79,Default,,0,0,0,,Нагоя
Dialogue: 0,0:00:14.87,0:00:21.83,Default,,0,0,0,,Ооооо
Dialogue: 0,0:00:31.95,0:00:33.95,Default,,0,0,0,,♪～
Dialogue: 0,0:01:51.95,0:01:52.20,Default,,0,0,0,,～♪
Dialogue: 0,0:01:52.20,0:01:54.04,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:01:52.20,0:01:54.04,Default,,0,0,0,,～♪
Dialogue: 0,0:01:54.04,0:01:57.08,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:01:58.54,0:02:00.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:00.54,0:02:04.29,Default,,0,0,0,,Тыңда, Анна, осы жерден құласаң, ұтыласың.
Dialogue: 0,0:02:04.37,0:02:06.91,Default,,0,0,0,,Астында қорқынышты елестер көп... Ахаха
Dialogue: 0,0:02:07.00,0:02:09.66,Default,,0,0,0,,Анна~ Эй, эй, эй!
Dialogue: 0,0:02:09.75,0:02:11.54,Default,,0,0,0,,Жақында емес пе? (Кэде) Бұл біртүрлі.
Dialogue: 0,0:02:11.62,0:02:14.70,Default,,0,0,0,,Аннаның жағасы жоқ, ол неге қашпайды?
Dialogue: 0,0:02:16.66,0:02:18.62,Default,,0,0,0,,Өйткені біз жақсы доспыз! тесік!
Dialogue: 0,0:02:19.75,0:02:22.83,Default,,0,0,0,,Игиске де жаға киюдің қажеті жоқ, жарайды.
Dialogue: 0,0:02:22.91,0:02:24.54,Default,,0,0,0,,Шешейін бе, Игис?
Dialogue: 0,0:02:24.62,0:02:26.25,Default,,0,0,0,,Е...! Эй...
Dialogue: 0,0:02:26.33,0:02:27.50,Default,,0,0,0,,Igi… Gi…
Dialogue: 0,0:02:28.70,0:02:29.75,Default,,0,0,0,,Igi!
Dialogue: 0,0:02:29.83,0:02:31.79,Default,,0,0,0,,Сізге ұнады ма? Иги
Dialogue: 0,0:02:32.37,0:02:34.45,Default,,0,0,0,,Мұндай нәрсе де бар.
Dialogue: 0,0:02:37.75,0:02:40.83,Default,,0,0,0,,Igi! Жиіііі!
Dialogue: 0,0:02:40.91,0:02:42.91,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:02:44.87,0:02:46.20,Default,,0,0,0,,Бірдеңе ұшып барады!
Dialogue: 0,0:02:49.20,0:02:50.41,Default,,0,0,0,,Түтін?
Dialogue: 0,0:02:56.58,0:02:58.00,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:03:05.29,0:03:09.54,Default,,0,0,0,,(Ұшу кезіндегі ескерту дыбысы)
Dialogue: 0,0:03:09.62,0:03:11.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:11.33,0:03:13.04,Default,,0,0,0,,Амансың ба? Момока
Dialogue: 0,0:03:13.12,0:03:14.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:15.79,0:03:17.08,Default,,0,0,0,,Менің аяғым...
Dialogue: 0,0:03:20.83,0:03:23.54,Default,,0,0,0,,А... жоқ!
Dialogue: 0,0:03:24.29,0:03:25.50,Default,,0,0,0,,Сабыр ет!
Dialogue: 0,0:03:27.79,0:03:29.12,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:29.62,0:03:31.58,Default,,0,0,0,,О, маған көмектес!
Dialogue: 0,0:03:37.91,0:03:38.95,Default,,0,0,0,,Кім?
Dialogue: 0,0:03:39.70,0:03:41.33,Default,,0,0,0,,Сәлем! демон!
Dialogue: 0,0:03:42.00,0:03:44.95,Default,,0,0,0,,Маған күшіңді бер! Менің қызым қозғала алмайды!
Dialogue: 0,0:03:48.58,0:03:49.87,Default,,0,0,0,,Неліктен апат?
Dialogue: 0,0:03:51.62,0:03:53.66,Default,,0,0,0,,Шар тәрізді жындар тобы.
Dialogue: 0,0:03:54.33,0:03:57.79,Default,,0,0,0,,Ұшқыш мұны кеш түсініп, көлікке соқтығысты.
Dialogue: 0,0:04:02.50,0:04:04.45,Default,,0,0,0,,Кенто-кун, мынаны алып тастай аласың ба?
Dialogue: 0,0:04:04.54,0:04:07.16,Default,,0,0,0,,Сіз мұны істей аласыз ба, Анна, өтінемін?
Dialogue: 0,0:04:07.25,0:04:08.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:10.95,0:04:11.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:12.45,0:04:13.08,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:04:13.16,0:04:13.87,Default,,0,0,0,,Не?
Dialogue: 0,0:04:14.37,0:04:15.54,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:04:20.83,0:04:21.83,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:04:30.33,0:04:31.79,Default,,0,0,0,,Уау
Dialogue: 0,0:04:34.87,0:04:38.62,Default,,0,0,0,,(Автокөлік дабылы мен сырнай)
Dialogue: 0,0:04:41.00,0:04:42.83,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:04:46.54,0:04:49.79,Default,,0,0,0,,О! Оу!
Dialogue: 0,0:04:53.41,0:04:55.16,Default,,0,0,0,,Ооооооооо!
Dialogue: 0,0:04:57.87,0:05:00.20,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:05:00.29,0:05:02.04,Default,,0,0,0,,(Көлік дабылының дыбысы)
Dialogue: 0,0:05:02.87,0:05:05.58,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:05:07.41,0:05:09.54,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:11.62,0:05:13.95,Default,,0,0,0,,Керемет! Бұл алып құбыжық!
Dialogue: 0,0:05:15.50,0:05:19.00,Default,,0,0,0,,Оххх
Dialogue: 0,0:05:23.12,0:05:26.00,Default,,0,0,0,,Бұл... мутантты өрмекші жын ба?
Dialogue: 0,0:05:27.08,0:05:28.66,Default,,0,0,0,,Теңізді ластайтын ешқандай ірі қалалар жоқ—
Dialogue: 0,0:05:28.75,0:05:31.70,Default,,0,0,0,,«Патша» Мен оны осылай атағанына сенімдімін.
Dialogue: 0,0:05:32.41,0:05:35.04,Default,,0,0,0,,Ооооооооооооо~
Dialogue: 0,0:05:43.58,0:05:45.08,Default,,0,0,0,,Ой...
Dialogue: 0,0:05:53.66,0:05:55.50,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:55.58,0:06:00.16,Default,,0,0,0,,Ооо~уууу~
Dialogue: 0,0:06:00.25,0:06:01.50,Default,,0,0,0,,Ай!
Dialogue: 0,0:06:02.00,0:06:02.83,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:06:03.33,0:06:04.95,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:06:07.66,0:06:09.95,Default,,0,0,0,,Оххх
Dialogue: 0,0:06:10.04,0:06:11.37,Default,,0,0,0,,Ах (Рейджи) Уау...
Dialogue: 0,0:06:11.45,0:06:12.45,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:06:12.54,0:06:13.16,Default,,0,0,0,,Igis!
Dialogue: 0,0:06:13.25,0:06:14.70,Default,,0,0,0,,Папа!
Dialogue: 0,0:06:14.79,0:06:16.20,Default,,0,0,0,,Уау! Игиги!
Dialogue: 0,0:06:17.75,0:06:19.75,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:06:25.04,0:06:27.91,Default,,0,0,0,,Әке! (Кенто) Жарайды, Игис мені қорғады.
Dialogue: 0,0:06:31.58,0:06:34.50,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:06:35.83,0:06:39.41,Default,,0,0,0,,Ой...
Dialogue: 0,0:06:42.04,0:06:44.16,Default,,0,0,0,,Гехо гехо
Dialogue: 0,0:06:50.20,0:06:51.29,Default,,0,0,0,,Момока…
Dialogue: 0,0:06:58.29,0:07:02.00,Default,,0,0,0,,(Патшаның ізі)
Dialogue: 0,0:07:13.91,0:07:15.79,Default,,0,0,0,,(Момоканың айқайы)
Dialogue: 0,0:07:23.45,0:07:26.00,Default,,0,0,0,,Бұл жыланбалықтан жасалған дәмді пирог
Dialogue: 0,0:07:26.08,0:07:28.45,Default,,0,0,0,,Мен оны бір күні тоқтаған қаладан сатып алдым.
Dialogue: 0,0:07:28.95,0:07:31.29,Default,,0,0,0,,Мен Кенто Тачибанамын. Сен ше?
Dialogue: 0,0:07:31.95,0:07:35.00,Default,,0,0,0,,Момока Амияға тәттілер керек емес
Dialogue: 0,0:07:35.62,0:07:38.45,Default,,0,0,0,,Мына жынды аулақ ұста! қорқынышты
Dialogue: 0,0:07:38.54,0:07:39.62,Default,,0,0,0,,Мен қызық...
Dialogue: 0,0:07:39.70,0:07:41.87,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:07:42.50,0:07:45.12,Default,,0,0,0,,Мен жындарды жек көремін! Бұл жау!
Dialogue: 0,0:07:46.20,0:07:48.04,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:07:48.62,0:07:51.62,Default,,0,0,0,,Дегенмен, бұл өте үлкен.
Dialogue: 0,0:07:51.70,0:07:53.66,Default,,0,0,0,,Мен мұндай баланың бар екеніне сене алмаймын
Dialogue: 0,0:07:54.20,0:07:57.58,Default,,0,0,0,,Папа патшаның ерекше тұлға екенін айтты.
Dialogue: 0,0:07:58.08,0:08:01.75,Default,,0,0,0,,Ол басқа жындарды жеп өсті.
Dialogue: 0,0:08:02.25,0:08:03.66,Default,,0,0,0,,Өрмекші жын
Dialogue: 0,0:08:03.75,0:08:06.45,Default,,0,0,0,,Менің өзіме ұнайтын нәрселерді сақтайтын әдетім бар.
Dialogue: 0,0:08:06.95,0:08:11.00,Default,,0,0,0,,Король Нагояны жойғаннан кейін қамалға ғашық болды.
Dialogue: 0,0:08:11.08,0:08:14.45,Default,,0,0,0,,Оны арқасына салып, денесінің бір бөлігіне айналдырды.
Dialogue: 0,0:08:24.16,0:08:25.41,Default,,0,0,0,,Бұл жанды.
Dialogue: 0,0:08:27.62,0:08:29.70,Default,,0,0,0,,Нагояда өмір сүрген адамдар
Dialogue: 0,0:08:29.79,0:08:32.12,Default,,0,0,0,,Осы жерді паналап, қоныстанған деседі.
Dialogue: 0,0:08:32.20,0:08:34.58,Default,,0,0,0,,Шин-Нагоя
Dialogue: 0,0:08:41.62,0:08:44.54,Default,,0,0,0,,Демон пайдаланушылар гильдиясының Шин-Нагоя филиалы
Dialogue: 0,0:08:44.62,0:08:47.16,Default,,0,0,0,,Мына кісінің қызы және менің серігім
Dialogue: 0,0:08:47.25,0:08:48.83,Default,,0,0,0,,Патша алып кеткен
Dialogue: 0,0:08:49.54,0:08:50.75,Default,,0,0,0,,Патшаға?
Dialogue: 0,0:08:50.83,0:08:53.95,Default,,0,0,0,,Мен құтқару үшін уақытша топ алғым келеді.
Dialogue: 0,0:08:54.04,0:08:56.87,Default,,0,0,0,,Сұраңыз, мен сізге кез келген соманы төлеймін!
Dialogue: 0,0:09:04.25,0:09:07.41,Default,,0,0,0,,Тамақ ішкен жақсы. Сіздің денеңіз ұзаққа созылмайды.
Dialogue: 0,0:09:07.50,0:09:09.45,Default,,0,0,0,,Игги!
Dialogue: 0,0:09:18.16,0:09:20.20,Default,,0,0,0,,Үлкен сыйлық
Dialogue: 0,0:09:20.29,0:09:23.12,Default,,0,0,0,,Кешіріңіз, сіздің кәсібіңіз қандай?
Dialogue: 0,0:09:23.20,0:09:24.50,Default,,0,0,0,,Мен дәрігермін.
Dialogue: 0,0:09:25.12,0:09:27.95,Default,,0,0,0,,Тойота-Ситиде маған шұғыл ота жасалды.
Dialogue: 0,0:09:28.04,0:09:29.58,Default,,0,0,0,,Қайтар жолда болды.
Dialogue: 0,0:09:30.33,0:09:32.87,Default,,0,0,0,,Мен мұндай нәрсе болады деп күтпедім...
Dialogue: 0,0:09:37.58,0:09:41.37,Default,,0,0,0,,Ооооооооооо
Dialogue: 0,0:09:50.33,0:09:52.25,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:09:57.50,0:09:59.87,Default,,0,0,0,,Ооооооооооооооо
Dialogue: 0,0:10:02.16,0:10:04.83,Default,,0,0,0,,Ооооооооооо
Dialogue: 0,0:10:05.45,0:10:10.75,Default,,0,0,0,,О~ О~
Dialogue: 0,0:10:12.37,0:10:14.54,Default,,0,0,0,,Үлкен өрмекші торы!
Dialogue: 0,0:10:14.62,0:10:16.87,Default,,0,0,0,,Сіз жинаған нәрселеріңізді көрсетіп жатырсыз.
Dialogue: 0,0:10:16.95,0:10:18.08,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:18.16,0:10:20.25,Default,,0,0,0,,Сәлем! Маған жақындама!
Dialogue: 0,0:10:20.33,0:10:21.08,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:21.66,0:10:22.50,Default,,0,0,0,,Ана!
Dialogue: 0,0:10:23.08,0:10:26.62,Default,,0,0,0,,Бұл не? Ол жағасын да кимейді. Бұл қауіпті!
Dialogue: 0,0:10:26.70,0:10:29.33,Default,,0,0,0,,Жарайды! Анна тыныш
Dialogue: 0,0:10:30.00,0:10:33.95,Default,,0,0,0,,Мен жындарды жек көремін! Мен оны бір күні жоямын!
Dialogue: 0,0:10:35.62,0:10:37.83,Default,,0,0,0,,Неге мұндай қорқынышты сөздер айтасың?
Dialogue: 0,0:10:37.91,0:10:39.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:39.70,0:10:42.25,Default,,0,0,0,,Себебі анамды жын өлтірді!
Dialogue: 0,0:10:42.79,0:10:43.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:59.04,0:11:00.45,Default,,0,0,0,,Ұйықтау мүмкін емес пе?
Dialogue: 0,0:11:01.12,0:11:02.12,Default,,0,0,0,,Иә
Dialogue: 0,0:11:02.83,0:11:05.75,Default,,0,0,0,,Менімен Demon пайдаланушылар гильдиясы хабарласты.
Dialogue: 0,0:11:06.45,0:11:09.91,Default,,0,0,0,,Өтінішті көрген бірнеше адам өтініш білдірген сияқты.
Dialogue: 0,0:11:11.83,0:11:14.75,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:11:15.62,0:11:18.62,Default,,0,0,0,,А... жоқ, мен Кентокунға көмектесуім керек.
Dialogue: 0,0:11:19.54,0:11:21.50,Default,,0,0,0,,Себебі мен араластым.
Dialogue: 0,0:11:22.79,0:11:25.29,Default,,0,0,0,,Әлгі бала... бетіндегі көгерген
Dialogue: 0,0:11:25.79,0:11:28.95,Default,,0,0,0,,Демония бөлшектерінің ластануы орын алып жатқан сияқты.
Dialogue: 0,0:11:29.66,0:11:30.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:31.00,0:11:32.16,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:11:32.87,0:11:35.79,Default,,0,0,0,,Менің әйелімде дәл осындай таңба болған...
Dialogue: 0,0:11:38.25,0:11:41.25,Default,,0,0,0,,Демон бөлшектері дүние жүзіне тарады
Dialogue: 0,0:11:41.75,0:11:45.20,Default,,0,0,0,,Сирек жағдайларда ол денеге кіріп, сонда қалуы мүмкін.
Dialogue: 0,0:11:46.00,0:11:49.08,Default,,0,0,0,,Бұл кезде айналадағы ұлпалар ластанады.
Dialogue: 0,0:11:49.16,0:11:50.58,Default,,0,0,0,,Түсін өзгертеді.
Dialogue: 0,0:11:51.50,0:11:55.33,Default,,0,0,0,,Менің әйелімнің жағдайында ол оның жүрек жасушаларына жабысты.
Dialogue: 0,0:11:55.41,0:11:58.50,Default,,0,0,0,,Жалғыз шешім органды трансплантациялау болды.
Dialogue: 0,0:11:59.83,0:12:02.29,Default,,0,0,0,,Бірақ инкубация басталды...
Dialogue: 0,0:12:02.37,0:12:03.66,Default,,0,0,0,,Ах... уау
Dialogue: 0,0:12:03.75,0:12:06.33,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,0:12:26.91,0:12:28.75,Default,,0,0,0,,Сосын Кентокун да...
Dialogue: 0,0:12:30.16,0:12:33.08,Default,,0,0,0,,Демон бөлшектері сіздің басыңызда
Dialogue: 0,0:12:33.16,0:12:36.91,Default,,0,0,0,,Егер ол жұмыртқадан шықса, ол тірі қалмайды.
Dialogue: 0,0:12:40.58,0:12:41.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:48.25,0:12:50.12,Default,,0,0,0,,Сәлем! Оян!
Dialogue: 0,0:12:51.08,0:12:52.37,Default,,0,0,0,,А?
Dialogue: 0,0:12:54.66,0:12:56.25,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:13:01.79,0:13:04.41,Default,,0,0,0,,Бұл мифтік әлем сияқты
Dialogue: 0,0:13:07.16,0:13:08.54,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:09.20,0:13:11.25,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:13:11.33,0:13:12.45,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:12.54,0:13:15.79,Default,,0,0,0,,Нана Нана Ана! (Кенто) Біріншіден, өрмекші торы арқылы
Dialogue: 0,0:13:15.87,0:13:17.41,Default,,0,0,0,,Көпқабатты үйге көшу
Dialogue: 0,0:13:17.91,0:13:21.00,Default,,0,0,0,,Ана Ана На (Кендо) Баспалдақта жерге бас
Dialogue: 0,0:13:21.08,0:13:23.12,Default,,0,0,0,,Иә, бұл жақсы!
Dialogue: 0,0:13:26.20,0:13:29.45,Default,,0,0,0,,Күте тұрыңыз! Оның не айтып тұрғанын түсінесің бе?
Dialogue: 0,0:13:29.54,0:13:30.37,Default,,0,0,0,,Сіз!
Dialogue: 0,0:13:31.25,0:13:33.54,Default,,0,0,0,,Ойланып көрейін, әйтеуір
Dialogue: 0,0:13:35.37,0:13:37.08,Default,,0,0,0,,Сіз өзгердіңіз...
Dialogue: 0,0:13:47.37,0:13:49.79,Default,,0,0,0,,Әй, бұл қымбат!
Dialogue: 0,0:13:50.50,0:13:53.58,Default,,0,0,0,,Әй, бұл сенің анаң туралы...
Dialogue: 0,0:13:53.66,0:13:54.62,Default,,0,0,0,,Не?
Dialogue: 0,0:13:54.70,0:13:56.50,Default,,0,0,0,,Жын өлтірді ме?
Dialogue: 0,0:13:56.58,0:13:59.75,Default,,0,0,0,,Сондықтан жындар менің жауым!
Dialogue: 0,0:14:01.70,0:14:03.95,Default,,0,0,0,,Менің де анам жоқ.
Dialogue: 0,0:14:04.04,0:14:05.08,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:14:07.29,0:14:08.04,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:14:09.08,0:14:12.04,Default,,0,0,0,,Мен сені өмірге қайтару үшін саяхаттап жүрмін.
Dialogue: 0,0:14:12.79,0:14:13.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:14.70,0:14:17.75,Default,,0,0,0,,Өлген адамдар қайта тірілмейді!
Dialogue: 0,0:14:18.54,0:14:21.70,Default,,0,0,0,,Мен мұны істей аламын, әйтпесе...
Dialogue: 0,0:14:22.20,0:14:23.41,Default,,0,0,0,,Өтірік
Dialogue: 0,0:14:43.95,0:14:46.54,Default,,0,0,0,,Бұл клиент Рейдзи Амия.
Dialogue: 0,0:14:46.62,0:14:48.16,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:14:49.91,0:14:52.79,Default,,0,0,0,,А, менде бос уақыт болды.
Dialogue: 0,0:14:54.70,0:14:56.62,Default,,0,0,0,,Өтемақы тартымды
Dialogue: 0,0:14:57.12,0:14:59.62,Default,,0,0,0,,Қызыңыздың жағдайы жақсы деп үміттенемін.
Dialogue: 0,0:15:00.62,0:15:03.20,Default,,0,0,0,,Олар әдетте осы қалада кештер өткізеді.
Dialogue: 0,0:15:03.29,0:15:04.87,Default,,0,0,0,,Белсенді
Dialogue: 0,0:15:06.00,0:15:08.08,Default,,0,0,0,,Жүр, көлікке отыр.
Dialogue: 0,0:15:09.91,0:15:11.83,Default,,0,0,0,,Сіз көлік жүргізесіз бе?
Dialogue: 0,0:15:12.54,0:15:14.58,Default,,0,0,0,,Маған да көмектесулеріңізді қалаймын.
Dialogue: 0,0:15:15.41,0:15:17.83,Default,,0,0,0,,Иә, мен сұрадым.
Dialogue: 0,0:15:17.91,0:15:21.50,Default,,0,0,0,,Рақмет. Кешіріңіз.
Dialogue: 0,0:15:43.00,0:15:45.00,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:15:45.08,0:15:46.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:48.08,0:15:49.62,Default,,0,0,0,,Мен өз шегіме жеттім...
Dialogue: 0,0:15:49.70,0:15:51.79,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:15:51.87,0:15:52.87,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:53.75,0:15:55.37,Default,,0,0,0,,Сол жерде демалайық.
Dialogue: 0,0:16:09.12,0:16:10.45,Default,,0,0,0,,Иә~
Dialogue: 0,0:16:10.54,0:16:13.83,Default,,0,0,0,,Мен не істей аламын? жабысқақ
Dialogue: 0,0:16:13.91,0:16:16.29,Default,,0,0,0,,Мен оны сақтау арқылы өшіре аламын ба, Ана?
Dialogue: 0,0:16:16.37,0:16:17.37,Default,,0,0,0,,Сіз!
Dialogue: 0,0:16:18.04,0:16:21.29,Default,,0,0,0,,Ах! Жақсы сезінеді! Осы аймақ туралы да айтсаңыз
Dialogue: 0,0:16:21.37,0:16:22.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:23.37,0:16:25.37,Default,,0,0,0,,Бұл аймақ та!
Dialogue: 0,0:16:26.12,0:16:27.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:27.83,0:16:29.16,Default,,0,0,0,,Көбірек өшіріңіз!
Dialogue: 0,0:16:29.25,0:16:31.00,Default,,0,0,0,,Сіз! тесік!
Dialogue: 0,0:16:31.08,0:16:32.95,Default,,0,0,0,,О~ (Момока) Ахаха!
Dialogue: 0,0:16:40.04,0:16:40.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:42.33,0:16:44.95,Default,,0,0,0,,Сіз өзіңізді күйзеліске ұшыратасыз ба?
Dialogue: 0,0:16:46.50,0:16:48.41,Default,,0,0,0,,Бұл қауіпті! Құлайды!
Dialogue: 0,0:16:52.62,0:16:53.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:56.08,0:16:57.08,Default,,0,0,0,,(велосипед қоңырауы)
Dialogue: 0,0:16:57.70,0:16:58.91,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:16:59.75,0:17:01.70,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:17:02.29,0:17:02.91,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:17:03.00,0:17:05.25,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:17:09.75,0:17:13.87,Default,,0,0,0,,Қызым, сен патшаның жинағына тиген жоқсың деп үміттенемін.
Dialogue: 0,0:17:13.95,0:17:15.54,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:17:15.62,0:17:17.25,Default,,0,0,0,,Өрмекші жын
Dialogue: 0,0:17:17.33,0:17:20.33,Default,,0,0,0,,Сіз жинаған заттар жойылса немесе алынса не болады?
Dialogue: 0,0:17:20.41,0:17:22.12,Default,,0,0,0,,Қатты ашуланыңыз
Dialogue: 0,0:17:22.20,0:17:26.25,Default,,0,0,0,,О? Ооооооо...
Dialogue: 0,0:17:26.33,0:17:28.33,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:17:28.41,0:17:29.54,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:17:29.62,0:17:33.45,Default,,0,0,0,,О? Ооооооооо
Dialogue: 0,0:17:34.29,0:17:36.37,Default,,0,0,0,,Бұл менің кінәм емес, солай ма?
Dialogue: 0,0:17:37.66,0:17:40.83,Default,,0,0,0,,Ооооооооо...
Dialogue: 0,0:17:42.16,0:17:43.25,Default,,0,0,0,,О...
Dialogue: 0,0:17:44.16,0:17:46.50,Default,,0,0,0,,Ооо...
Dialogue: 0,0:17:46.58,0:17:47.87,Default,,0,0,0,,(Қамалдың құлаған дыбысы)
Dialogue: 0,0:17:47.95,0:17:48.95,Default,,0,0,0,,Мүмкін, мен кенеттен үйленуге ұсыныс жасағандықтан шығар—
Dialogue: 0,0:17:51.04,0:17:54.91,Default,,0,0,0,,Ооооооооо!
Dialogue: 0,0:17:57.79,0:18:00.87,Default,,0,0,0,,Егер бұл менің кінәм болмаса!
Dialogue: 0,0:18:00.95,0:18:02.00,Default,,0,0,0,,Сіз!
Dialogue: 0,0:18:02.66,0:18:04.54,Default,,0,0,0,,Ооооооооо!
Dialogue: 0,0:18:04.62,0:18:06.25,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:18:07.50,0:18:11.37,Default,,0,0,0,,Кя~!
Dialogue: 0,0:18:11.45,0:18:12.75,Default,,0,0,0,,Секір!
Dialogue: 0,0:18:13.79,0:18:14.62,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:18:16.58,0:18:17.37,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:18:17.45,0:18:20.66,Default,,0,0,0,,Мен өрмекшілерді жек көремін! Бұл ақымақ бетке не болды?
Dialogue: 0,0:18:21.16,0:18:21.91,Default,,0,0,0,,О
Dialogue: 0,0:18:22.00,0:18:24.00,Default,,0,0,0,,Ооо
Dialogue: 0,0:18:25.00,0:18:28.75,Default,,0,0,0,,Ооо! (Кенто) Уау! Мен сені естимін
Dialogue: 0,0:18:29.66,0:18:31.04,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:18:32.79,0:18:36.54,Default,,0,0,0,,Кя! (Патша) Ооооооооооо~
Dialogue: 0,0:18:41.33,0:18:42.45,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:43.25,0:18:44.83,Default,,0,0,0,,Хирта, бара аласың ба?
Dialogue: 0,0:18:45.33,0:18:46.00,Default,,0,0,0,,О
Dialogue: 0,0:18:53.00,0:18:58.12,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:18:58.20,0:18:59.37,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:02.41,0:19:04.50,Default,,0,0,0,,Оххх
Dialogue: 0,0:19:07.75,0:19:08.95,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:19:13.25,0:19:14.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:17.50,0:19:21.54,Default,,0,0,0,,Ооооооооо~
Dialogue: 0,0:19:26.91,0:19:30.45,Default,,0,0,0,,Ооооооооооооо
Dialogue: 0,0:19:30.54,0:19:32.04,Default,,0,0,0,,Ооо!
Dialogue: 0,0:19:33.12,0:19:34.08,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:34.16,0:19:35.29,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:19:37.12,0:19:37.91,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:38.00,0:19:39.91,Default,,0,0,0,,Бұл не! (Патша) Ооо
Dialogue: 0,0:19:40.00,0:19:41.79,Default,,0,0,0,,Уф... Мен қозғала алмаймын!
Dialogue: 0,0:19:41.87,0:19:43.41,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:19:43.50,0:19:44.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:44.91,0:19:45.91,Default,,0,0,0,,О! тесік!
Dialogue: 0,0:19:56.62,0:19:59.62,Default,,0,0,0,,О? О~
Dialogue: 0,0:19:59.70,0:20:02.29,Default,,0,0,0,,Қайтадан жасаңыз! (Тас жын) Уф...
Dialogue: 0,0:20:08.62,0:20:11.79,Default,,0,0,0,,Чоки Чоки Чоки...
Dialogue: 0,0:20:13.50,0:20:15.41,Default,,0,0,0,,Чоки Чоки Чоки...
Dialogue: 0,0:20:15.50,0:20:17.58,Default,,0,0,0,,Бірдеңе келді ме? О, менің!
Dialogue: 0,0:20:17.66,0:20:20.00,Default,,0,0,0,,Кенто-кун Момока-чан! Сенімен бәрі жақсы ма?
Dialogue: 0,0:20:20.50,0:20:21.70,Default,,0,0,0,,Каэде-сан!
Dialogue: 0,0:20:22.54,0:20:24.54,Default,,0,0,0,,Бұл патшаның назарын аударады!
Dialogue: 0,0:20:24.62,0:20:25.91,Default,,0,0,0,,Жақсылап қашыңыз!
Dialogue: 0,0:20:28.75,0:20:32.54,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:20:34.66,0:20:36.91,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:20:41.00,0:20:43.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:05.16,0:23:07.16,Default,,0,0,0,,～♪
