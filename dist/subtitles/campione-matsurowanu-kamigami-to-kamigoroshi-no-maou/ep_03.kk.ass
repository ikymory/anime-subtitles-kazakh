Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.45,0:00:05.54,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:06.58,0:00:07.17,Default,,0,0,0,,(тарақ тістерінің сынған дыбысы)
Dialogue: 0,0:00:07.29,0:00:08.17,Default,,0,0,0,,​​О?
Dialogue: 0,0:00:11.13,0:00:11.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:14.76,0:00:15.89,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:17.05,0:00:18.05,Default,,0,0,0,,Амакасу-сан
Dialogue: 0,0:00:18.89,0:00:20.93,Default,,0,0,0,,Мүмкін басқа нәрсе бар ма?
Dialogue: 0,0:00:21.18,0:00:22.98,Default,,0,0,0,,Химе Мико күткендей
Dialogue: 0,0:00:23.64,0:00:27.31,Default,,0,0,0,,Шын мәнінде, бұрын-соңды болмаған апат тез жақындап келеді.
Dialogue: 0,0:00:27.44,0:00:28.36,Default,,0,0,0,,Апат?
Dialogue: 0,0:00:28.86,0:00:32.44,Default,,0,0,0,,Иә, шын мәнінде, Году Кусанаги қайтадан қатысты.
Dialogue: 0,0:00:33.49,0:00:34.45,Default,,0,0,0,,Құсанағы мырза?
Dialogue: 0,0:00:37.53,0:00:39.53,Default,,0,0,0,,Мен мұндай болады деп ешқашан ойламадым.
Dialogue: 0,0:00:39.91,0:00:40.45,Default,,0,0,0,,Иә
Dialogue: 0,0:00:41.29,0:00:44.04,Default,,0,0,0,,Мүмкін болса, көмегіңізге риза болар едім.
Dialogue: 0,0:00:44.37,0:00:46.50,Default,,0,0,0,,Бірақ Құсанағы мырза...
Dialogue: 0,0:00:46.62,0:00:49.21,Default,,0,0,0,,«Мен мұндай нәрсемен ешнәрсе істегім келмейді».
Dialogue: 0,0:00:49.71,0:00:52.80,Default,,0,0,0,,Иә, растаңыз.
Dialogue: 0,0:00:54.01,0:00:55.51,Default,,0,0,0,,Ендеше бір-біріне жабыспаңдар (Юри) иә?
Dialogue: 0,0:00:55.76,0:00:58.09,Default,,0,0,0,,Біз бірге болашаққа уәде берген екі адамбыз.
Dialogue: 0,0:00:58.51,0:01:00.22,Default,,0,0,0,,Әрине, бұл көп.
Dialogue: 0,0:01:00.64,0:01:03.77,Default,,0,0,0,,Демек, сіз бұл уәдені бергеніңіз есіңізде жоқ дейсіз.
Dialogue: 0,0:01:04.06,0:01:04.73,Default,,0,0,0,,Уау
Dialogue: 0,0:01:05.23,0:01:07.94,Default,,0,0,0,,Қашанға дейін мұндай өтірік айтып жүре бересің?
Dialogue: 0,0:01:08.19,0:01:10.61,Default,,0,0,0,,Сол жолды дәл сол күйінде қайтарыңыз
Dialogue: 0,0:01:11.11,0:01:11.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:21.03,0:01:22.04,Default,,0,0,0,,Жабу
Dialogue: 0,0:01:22.74,0:01:24.29,Default,,0,0,0,,Жылан әлі осында
Dialogue: 0,0:01:26.37,0:01:28.25,Default,,0,0,0,,Менің іздегенім - Горгонеон
Dialogue: 0,0:01:28.71,0:01:29.92,Default,,0,0,0,,Ежелгі жылан
Dialogue: 0,0:01:30.59,0:01:34.05,Default,,0,0,0,,Ханшайым ханымның сапарына бағыт-бағдар берсеңіз екен.
Dialogue: 0,0:01:35.30,0:01:38.09,Default,,0,0,0,,Қараңғылық, жер және көктегі даналық
Dialogue: 0,0:01:38.97,0:01:40.80,Default,,0,0,0,,Маған қайта беріңіз
Dialogue: 0,0:01:46.43,0:01:48.90,Default,,0,0,0,,Году Кусанаги - Кампион
Dialogue: 0,0:01:49.73,0:01:53.94,Default,,0,0,0,,Кампион дегеніміз не? Құдайды сәтті өлтірген адамға берілетін атақ.
Dialogue: 0,0:01:54.32,0:01:55.78,Default,,0,0,0,,Патшалардың патшасы
Dialogue: 0,0:01:56.49,0:01:59.16,Default,,0,0,0,,Ол жын патша, оны ешкім басқара алмайды.
Dialogue: 0,0:01:59.70,0:02:02.66,Default,,0,0,0,,Бұл оқиға Кампион атанған бала туралы...
Dialogue: 0,0:02:02.83,0:02:05.70,Default,,0,0,0,,Бұл оны қоршап алған қыздардың оқиғасы.
Dialogue: 0,0:02:06.41,0:02:09.41,Default,,0,0,0,,♪～
Dialogue: 0,0:03:31.83,0:03:34.83,Default,,0,0,0,,～♪
Dialogue: 0,0:03:38.55,0:03:39.13,Default,,0,0,0,,Ах
Dialogue: 0,0:03:40.34,0:03:42.84,Default,,0,0,0,,Ол шынымен әдемі, солай емес пе?
Dialogue: 0,0:03:42.97,0:03:44.59,Default,,0,0,0,,Сіз Италиядан келдіңіз, солай ма?
Dialogue: 0,0:03:44.97,0:03:47.60,Default,,0,0,0,,Асыл тұқымнан шыққан деген өсек.
Dialogue: 0,0:03:47.85,0:03:49.93,Default,,0,0,0,,Міне, сондықтан сіз өзіңізді әдемі ұстайсыз.
Dialogue: 0,0:03:50.39,0:03:51.60,Default,,0,0,0,,Хехе, түсіндім.
Dialogue: 0,0:03:52.31,0:03:53.77,Default,,0,0,0,,Туберия
Dialogue: 0,0:03:53.94,0:03:54.56,Default,,0,0,0,,Ах~
Dialogue: 0,0:03:54.69,0:03:56.11,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:57.02,0:03:59.78,Default,,0,0,0,,Не болды, Годо? Қайғылы жүзбен
Dialogue: 0,0:04:00.07,0:04:02.86,Default,,0,0,0,,Жоқ, мен оны танымал деп ойладым.
Dialogue: 0,0:04:03.20,0:04:06.53,Default,,0,0,0,,Әдемі гүлге ағылған көбелектер мен аралар сияқты.
Dialogue: 0,0:04:07.03,0:04:09.74,Default,,0,0,0,,Қайда барсаңыз да, бұл табиғи түрде болады.
Dialogue: 0,0:04:10.04,0:04:11.12,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:04:11.29,0:04:14.12,Default,,0,0,0,,Адамдар мені үнемі жек көретіндей сезінемін.
Dialogue: 0,0:04:14.29,0:04:16.21,Default,,0,0,0,,Бұл Эриканың жігіті ме?
Dialogue: 0,0:04:16.50,0:04:18.04,Default,,0,0,0,,Бұл мүлдем пропорционалды емес.
Dialogue: 0,0:04:18.29,0:04:19.34,Default,,0,0,0,,Шынында да
Dialogue: 0,0:04:19.50,0:04:21.76,Default,,0,0,0,,А, у... бұл... иә?
Dialogue: 0,0:04:21.88,0:04:22.51,Default,,0,0,0,,Хмф!
Dialogue: 0,0:04:24.18,0:04:24.97,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:04:25.22,0:04:29.51,Default,,0,0,0,,Уайымдама, менің Году өмірінде болғаным жеткілікті.
Dialogue: 0,0:04:29.81,0:04:32.73,Default,,0,0,0,,Бұлай айтуға сенімділік қайдан келеді?
Dialogue: 0,0:04:33.23,0:04:35.48,Default,,0,0,0,,Бұл сенімділік емес, бұл шындық.
Dialogue: 0,0:04:35.90,0:04:38.52,Default,,0,0,0,,Годуды барлық достары тастап кетсе ше...
Dialogue: 0,0:04:38.82,0:04:41.78,Default,,0,0,0,,Мен отбасымнан оқшауланып, жалғыз болсам да...
Dialogue: 0,0:04:41.99,0:04:43.90,Default,,0,0,0,,Мен осында болғанша, сен бақытты боласың
Dialogue: 0,0:04:44.40,0:04:47.45,Default,,0,0,0,,Бір күні менің сөздерімнің мағынасын түсінерсің
Dialogue: 0,0:04:47.82,0:04:48.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:50.41,0:04:51.33,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:04:51.79,0:04:53.96,Default,,0,0,0,,Бұл күн сайын жалғасады ма?
Dialogue: 0,0:04:55.00,0:04:55.58,Default,,0,0,0,,Ах
Dialogue: 0,0:04:56.17,0:04:58.17,Default,,0,0,0,,Әй, Мария, қайырлы таң.
Dialogue: 0,0:05:00.04,0:05:01.63,Default,,0,0,0,,Ах, у... (Құдай) Иә?
Dialogue: 0,0:05:01.75,0:05:03.34,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:03.63,0:05:06.72,Default,,0,0,0,,Біраз уақыттан кейін босата аласыз ба?
Dialogue: 0,0:05:07.18,0:05:10.51,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:05:10.64,0:05:11.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:11.76,0:05:14.52,Default,,0,0,0,,Эрика шынында да табанды.
Dialogue: 0,0:05:15.18,0:05:16.56,Default,,0,0,0,,Ах Мария
Dialogue: 0,0:05:17.02,0:05:19.02,Default,,0,0,0,,Кешіріңіз, мен сәл кешігіп қалдым.
Dialogue: 0,0:05:19.48,0:05:21.44,Default,,0,0,0,,А, жоқ, бұл сенсің.
Dialogue: 0,0:05:21.57,0:05:25.61,Default,,0,0,0,,Патшаға көптеген өтініштер. Мен өте өкініштімін.
Dialogue: 0,0:05:25.78,0:05:28.95,Default,,0,0,0,,Жоқ, мен саған бұлай істеуді доғар деп айттым.
Dialogue: 0,0:05:29.49,0:05:32.66,Default,,0,0,0,,Мен патшалармен де, құдайлармен де істегім келмейді.
Dialogue: 0,0:05:33.08,0:05:34.16,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:34.41,0:05:38.37,Default,,0,0,0,,Иә, мен де Эрикаға айтып тұрмын, бірақ ол табанды.
Dialogue: 0,0:05:39.04,0:05:39.88,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:40.46,0:05:41.38,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:41.79,0:05:42.55,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:42.96,0:05:45.30,Default,,0,0,0,,Негізі Амакасу мырза тағы да менен сұрады.
Dialogue: 0,0:05:45.84,0:05:47.68,Default,,0,0,0,,«Кусанаги-сан, Горгонеион-»
Dialogue: 0,0:05:47.80,0:05:50.18,Default,,0,0,0,,«Жапонияға әкелінгені туралы ақпарат бар...»
Dialogue: 0,0:05:50.30,0:05:51.64,Default,,0,0,0,,«Растауыңызды қалаймын»
Dialogue: 0,0:05:51.97,0:05:53.85,Default,,0,0,0,,Голго... Бұл не?
Dialogue: 0,0:05:54.35,0:05:57.44,Default,,0,0,0,,Дүниеге апат әкелетін қасиетті құрал.
Dialogue: 0,0:05:58.06,0:05:58.81,Default,,0,0,0,,Төсек жабдықтары?
Dialogue: 0,0:05:59.48,0:06:00.31,Default,,0,0,0,,Жастық?
Dialogue: 0,0:06:01.48,0:06:03.73,Default,,0,0,0,,Неліктен жастық осында пайда болады?
Dialogue: 0,0:06:03.94,0:06:05.61,Default,,0,0,0,,Жоқ... бұлыңғыр болды.
Dialogue: 0,0:06:06.32,0:06:07.11,Default,,0,0,0,,Бұлыңғыр ма?
Dialogue: 0,0:06:07.53,0:06:09.74,Default,,0,0,0,,Ха! Мұқият тыңдаңыз
Dialogue: 0,0:06:09.91,0:06:10.82,Default,,0,0,0,,Окабе?
Dialogue: 0,0:06:11.41,0:06:12.62,Default,,0,0,0,,Қасиетті құрал деген осы емес пе?
Dialogue: 0,0:06:12.99,0:06:15.04,Default,,0,0,0,,Тас тақталар, сиқырлы кітаптар, т.б.
Dialogue: 0,0:06:15.66,0:06:20.17,Default,,0,0,0,,Ештеңе етпейді, мен атамның тас тақтайшасына қатты қиналдым.
Dialogue: 0,0:06:20.75,0:06:22.17,Default,,0,0,0,,Мен өзіммен бірге ештеңе алып келген жоқпын.
Dialogue: 0,0:06:22.38,0:06:23.50,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:23.88,0:06:25.21,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:06:25.67,0:06:26.84,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:27.13,0:06:29.63,Default,,0,0,0,,Бірақ бұл «Дарго нәрсе» деген не?
Dialogue: 0,0:06:30.09,0:06:31.51,Default,,0,0,0,,Горгонеион
Dialogue: 0,0:06:32.01,0:06:34.18,Default,,0,0,0,,Мен оны ешқашан көрген емеспін ...
Dialogue: 0,0:06:34.39,0:06:37.39,Default,,0,0,0,,Ол медаль сияқты пішінде болған сияқты...
Dialogue: 0,0:06:37.56,0:06:38.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:38.39,0:06:40.44,Default,,0,0,0,,Алдыңғы жағында жылан сызылған...
Dialogue: 0,0:06:40.85,0:06:41.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:41.85,0:06:45.78,Default,,0,0,0,,Оның тастан жасалғанын ескерсек, салмағы...
Dialogue: 0,0:06:46.69,0:06:47.74,Default,,0,0,0,,Иә, осыншама...
Dialogue: 0,0:06:49.15,0:06:50.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:50.70,0:06:53.95,Default,,0,0,0,,Жоқ, Эрика оны Римге барғанымда берді.
Dialogue: 0,0:06:54.20,0:06:54.95,Default,,0,0,0,,Құсанағы мырза... (Годоу) Қараңызшы.
Dialogue: 0,0:06:55.12,0:06:58.50,Default,,0,0,0,,Бұл бірдеңені еске алу болса керек, бірақ шағын...
Dialogue: 0,0:06:58.91,0:06:59.96,Default,,0,0,0,,Құсанағы мырза
Dialogue: 0,0:07:00.33,0:07:03.58,Default,,0,0,0,,Жоқ, мен сиқырлы нәрсені сезіндім, бірақ...
Dialogue: 0,0:07:03.75,0:07:06.96,Default,,0,0,0,,Бұл Эрика маған берген нәрсе, сондықтан бұл қалыпты жағдай деп ойлаймын.
Dialogue: 0,0:07:07.21,0:07:07.88,Default,,0,0,0,,Олар ештеңе білмейміз дейді.
Dialogue: 0,0:07:08.01,0:07:08.59,Default,,0,0,0,,Уф
Dialogue: 0,0:07:08.71,0:07:11.43,Default,,0,0,0,,Сіз ''Патша боламын деп уайымдамаңыз'' дедіңіз.
Dialogue: 0,0:07:11.55,0:07:12.80,Default,,0,0,0,,Сіз мұны айттыңыз, солай ма?
Dialogue: 0,0:07:13.22,0:07:14.22,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:07:15.10,0:07:17.60,Default,,0,0,0,,Сіз айналаңызға тым немқұрайлы қарайсыз!
Dialogue: 0,0:07:17.81,0:07:18.39,Default,,0,0,0,,Ах... (Юри) Сен...
Dialogue: 0,0:07:18.52,0:07:21.35,Default,,0,0,0,,Жамандықсыз жын патша болған ол.
Dialogue: 0,0:07:21.94,0:07:25.77,Default,,0,0,0,,Әрбір әрекеттің қоршаған ортаға әсері...
Dialogue: 0,0:07:25.90,0:07:27.61,Default,,0,0,0,,Біліңіз және араласпаңыз.
Dialogue: 0,0:07:27.94,0:07:30.24,Default,,0,0,0,,Сіздің кішкентай қателіктеріңіз бен қыңырлықтарыңыз...
Dialogue: 0,0:07:30.36,0:07:33.70,Default,,0,0,0,,Бұл әлемді жоюы мүмкін ...
Dialogue: 0,0:07:34.07,0:07:37.37,Default,,0,0,0,,Осыны есте сақтаңыз!
Dialogue: 0,0:07:37.74,0:07:38.33,Default,,0,0,0,,Мария
Dialogue: 0,0:07:38.91,0:07:41.16,Default,,0,0,0,,Сіз ақылдысыз ба, әлде ашулысыз ба?
Dialogue: 0,0:07:41.33,0:07:42.67,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:07:42.83,0:07:45.00,Default,,0,0,0,,Ах... Әйтеуір... (Құдай) Иә.
Dialogue: 0,0:07:46.04,0:07:47.75,Default,,0,0,0,,Бұл өте ауыр жағдай.
Dialogue: 0,0:07:48.21,0:07:51.97,Default,,0,0,0,,Бұл Жапония пайғамбарлық орынға айналуы мүмкін.
Dialogue: 0,0:07:52.47,0:07:53.18,Default,,0,0,0,,Пайғамбарлық?
Dialogue: 0,0:07:55.47,0:07:58.35,Default,,0,0,0,,«Ол құдай өзінің шынайы келбетін қалпына келтіргенде...»
Dialogue: 0,0:07:58.85,0:08:01.77,Default,,0,0,0,,«Жұлдызсыз түн барлық аспанды қамтиды».
Dialogue: 0,0:08:02.23,0:08:04.94,Default,,0,0,0,,«Әлемді жер асты әлеміне апарады».
Dialogue: 0,0:08:05.52,0:08:06.77,Default,,0,0,0,,Мұндай пайғамбарлық...
Dialogue: 0,0:08:07.52,0:08:08.11,Default,,0,0,0,,Ах
Dialogue: 0,0:08:08.82,0:08:11.82,Default,,0,0,0,,Ханшайым Алиса пайғамбарлық етті
Dialogue: 0,0:08:13.24,0:08:18.37,Default,,0,0,0,,Аспандағы ең жоғары дәрежеге жеткен оның пайғамбарлығы ешқашан орындалмаған делінеді.
Dialogue: 0,0:08:19.70,0:08:21.37,Default,,0,0,0,,Горгонейон – жылан
Dialogue: 0,0:08:21.62,0:08:23.96,Default,,0,0,0,,Горгон құдайының бейнесі.
Dialogue: 0,0:08:25.12,0:08:28.34,Default,,0,0,0,,Ежелгі құдайы қорқынышты жынға айналдырады дейді.
Dialogue: 0,0:08:28.46,0:08:30.00,Default,,0,0,0,,А, жарайды... күте тұрыңыз.
Dialogue: 0,0:08:30.46,0:08:32.59,Default,,0,0,0,,Олай болса, оны жай ғана жойып жіберген дұрыс емес пе?
Dialogue: 0,0:08:32.80,0:08:33.72,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:08:34.38,0:08:36.39,Default,,0,0,0,,Күшті сиқырмен қорғалған
Dialogue: 0,0:08:36.80,0:08:38.64,Default,,0,0,0,,Менің қолымнан келетіні - мөрмен жабу.
Dialogue: 0,0:08:39.22,0:08:42.43,Default,,0,0,0,,Бұл да көп уақыт пен сиқырды қажет етеді.
Dialogue: 0,0:08:42.68,0:08:43.52,Default,,0,0,0,,сондықтан кенеттен үйімнен айырылып қалсам, біраз қиын болар еді.
Dialogue: 0,0:08:43.64,0:08:44.73,Default,,0,0,0,,О? (Құдай) Эрика
Dialogue: 0,0:08:45.14,0:08:48.06,Default,,0,0,0,,Сіз Годуға көп нәрсені үйреткен сияқтысыз.
Dialogue: 0,0:08:48.52,0:08:49.23,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:08:49.82,0:08:52.99,Default,,0,0,0,,Бірақ Годуды жақсы көру де, оны ойыншық ретінде пайдалану да...
Dialogue: 0,0:08:53.44,0:08:56.07,Default,,0,0,0,,Бұл тек осы қызыл шайтанға (Диаволо Россо) берілген артықшылық.
Dialogue: 0,0:08:56.74,0:08:58.37,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:58.53,0:09:02.91,Default,,0,0,0,,Итальяндық сиқыршылардың бұл елді апатқа ұшыратуға құқығы болмауы керек.
Dialogue: 0,0:09:03.16,0:09:08.38,Default,,0,0,0,,Мен бұл жағдайды жаңа патша Году Кусанагиге ғана сеніп тапсырдым.
Dialogue: 0,0:09:08.67,0:09:09.42,Default,,0,0,0,,Міне
Dialogue: 0,0:09:10.04,0:09:11.59,Default,,0,0,0,,Жауапсыз...
Dialogue: 0,0:09:12.34,0:09:16.43,Default,,0,0,0,,Егер пайғамбарлық рас болса, оған кім қарсы тұра алады?
Dialogue: 0,0:09:16.84,0:09:19.55,Default,,0,0,0,,Бір ғана патша бар, Кампион.
Dialogue: 0,0:09:20.43,0:09:22.06,Default,,0,0,0,,Барлығы патшаға байланысты.
Dialogue: 0,0:09:22.77,0:09:23.31,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:09:23.68,0:09:25.77,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:09:26.69,0:09:28.23,Default,,0,0,0,,Мен одан да көп ақпарат алғым келеді.
Dialogue: 0,0:09:28.35,0:09:28.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:29.31,0:09:32.78,Default,,0,0,0,,Горгонейоннан бірдеңе көре алатыныңызды көруге тырысасыз ба?
Dialogue: 0,0:09:33.53,0:09:35.53,Default,,0,0,0,,Сіз кенеттен осындай бірдеңе айтса да...
Dialogue: 0,0:09:35.65,0:09:36.24,Default,,0,0,0,,Ах
Dialogue: 0,0:09:36.82,0:09:39.20,Default,,0,0,0,,Жаһандық апат жақындап қалды.
Dialogue: 0,0:09:39.37,0:09:40.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:42.95,0:09:46.54,Default,,0,0,0,,Терісін қайта-қайта төгіп, қайта қалпына келетін жылан өлместіктің белгісі.
Dialogue: 0,0:09:47.62,0:09:50.21,Default,,0,0,0,,Жердің берекесін де, өлімін де бақылау
Dialogue: 0,0:09:51.04,0:09:53.75,Default,,0,0,0,,Ұлы ана шежіресіне байланыстылар
Dialogue: 0,0:09:54.88,0:09:55.46,Default,,0,0,0,,Түн…
Dialogue: 0,0:09:56.01,0:09:56.84,Default,,0,0,0,,Түннің көзі
Dialogue: 0,0:09:57.72,0:09:59.34,Default,,0,0,0,,Күміс шашы бар құдай
Dialogue: 0,0:10:00.05,0:10:02.05,Default,,0,0,0,,Дәрежесі мен жасынан айырылған -
Dialogue: 0,0:10:02.76,0:10:05.52,Default,,0,0,0,,Жас, соншалықты жетілмеген.
Dialogue: 0,0:10:06.14,0:10:07.02,Default,,0,0,0,,Аты...
Dialogue: 0,0:10:07.85,0:10:08.44,Default,,0,0,0,,Афина
Dialogue: 0,0:10:10.31,0:10:10.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:15.40,0:10:15.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:16.90,0:10:18.82,Default,,0,0,0,,Бұл мен күткеннен әлдеқайда жылдам болды.
Dialogue: 0,0:10:19.07,0:10:21.03,Default,,0,0,0,,Оны жасауға бола ма? Қандай тоқтау
Dialogue: 0,0:10:21.41,0:10:23.83,Default,,0,0,0,,Оны жай қалдырсақ, дүние жойылады.
Dialogue: 0,0:10:25.29,0:10:25.83,Default,,0,0,0,,Годоу
Dialogue: 0,0:10:27.58,0:10:29.37,Default,,0,0,0,,Ұш, Герместің етігі!
Dialogue: 0,0:10:32.71,0:10:34.05,Default,,0,0,0,,Ха (Году) Уф
Dialogue: 0,0:10:39.59,0:10:40.18,Default,,0,0,0,,Мұнда
Dialogue: 0,0:10:43.80,0:10:46.89,Default,,0,0,0,,Сіздің қарсыласыңыз Зевстің қызы, сондықтан дайын болыңыз.
Dialogue: 0,0:10:47.27,0:10:48.18,Default,,0,0,0,,Уф (Году) Эрика
Dialogue: 0,0:10:48.98,0:10:49.56,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:51.73,0:10:52.44,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:10:54.11,0:10:55.78,Default,,0,0,0,,Біраз болды, құдай өлтіруші.
Dialogue: 0,0:10:56.36,0:10:58.53,Default,,0,0,0,,Мен сізді қайтадан көргеніме қуаныштымын.
Dialogue: 0,0:10:59.57,0:11:00.66,Default,,0,0,0,,Сіз болдыңыз ба?
Dialogue: 0,0:11:00.78,0:11:01.36,Default,,0,0,0,,​​О?
Dialogue: 0,0:11:02.07,0:11:04.78,Default,,0,0,0,,Варава – Афина есімінің иесі құдай.
Dialogue: 0,0:11:05.20,0:11:08.37,Default,,0,0,0,,Құдалық өлтіруші жолдасым, атыңды естігім келеді.
Dialogue: 0,0:11:09.46,0:11:12.71,Default,,0,0,0,,Бұдан былай біз ежелгі жыланмен бетпе-бет келеміз.
Dialogue: 0,0:11:13.13,0:11:15.29,Default,,0,0,0,,Менің сенімен ұрысуға ешқандай себеп жоқ.
Dialogue: 0,0:11:15.92,0:11:18.34,Default,,0,0,0,,Сен Горгонейонды алып кеттің.
Dialogue: 0,0:11:19.13,0:11:21.22,Default,,0,0,0,,Жыланды сабаннан аулақ ұстаған —
Dialogue: 0,0:11:21.59,0:11:23.72,Default,,0,0,0,,Кім болсаң да, сен бізге жаусың.
Dialogue: 0,0:11:24.14,0:11:25.47,Default,,0,0,0,,Енді оны атаңыз.
Dialogue: 0,0:11:26.35,0:11:28.14,Default,,0,0,0,,Бұл Году Кусанаги.
Dialogue: 0,0:11:28.89,0:11:29.98,Default,,0,0,0,,Году Кусанаги
Dialogue: 0,0:11:30.60,0:11:31.60,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:11:32.31,0:11:34.61,Default,,0,0,0,,Горгонеон туралы не деуге болады?
Dialogue: 0,0:11:35.15,0:11:36.86,Default,,0,0,0,,Бұл сіздің қолыңызда емес сияқты.
Dialogue: 0,0:11:37.02,0:11:37.61,Default,,0,0,0,,​​О?
Dialogue: 0,0:11:37.78,0:11:40.53,Default,,0,0,0,,Болжалды орынды күткендей сезетін сияқтысыз.
Dialogue: 0,0:11:43.78,0:11:44.99,Default,,0,0,0,,Куоре ди Леоне!
Dialogue: 0,0:11:46.95,0:11:48.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:52.12,0:11:52.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:53.50,0:11:55.84,Default,,0,0,0,,Иә? Біртүрлі құдай өлтіруші
Dialogue: 0,0:11:56.71,0:11:59.96,Default,,0,0,0,,Жерлестерімнен алған күш әлі аз болса керек.
Dialogue: 0,0:12:00.46,0:12:06.14,Default,,0,0,0,,Бірақ Афинаны Афинаға айналдыратын тапқырлық сенің қауіпті екеніңді айтады.
Dialogue: 0,0:12:06.72,0:12:09.10,Default,,0,0,0,,Егер солай болса, сен бас тартып, үйге барасың ба?
Dialogue: 0,0:12:09.39,0:12:15.27,Default,,0,0,0,,Тәңірлер мен құдай өлтірушілер арасындағы күрес нәтижесіз, бір-бірін бітпес ренжітетіні рас.
Dialogue: 0,0:12:16.11,0:12:20.11,Default,,0,0,0,,Дау-дамай емес, келісім арқылы мәселені шешуге тырысқан дұрыс.
Dialogue: 0,0:12:20.65,0:12:21.61,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,0:12:22.07,0:12:22.65,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:23.32,0:12:24.91,Default,,0,0,0,,Үнсіз
Dialogue: 0,0:12:25.95,0:12:26.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:27.66,0:12:28.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:28.74,0:12:29.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:30.33,0:12:30.91,Default,,0,0,0,,Құдай!
Dialogue: 0,0:12:31.25,0:12:31.83,Default,,0,0,0,,​​О?
Dialogue: 0,0:12:33.54,0:12:34.25,Default,,0,0,0,,Уф...осылай ма?
Dialogue: 0,0:12:34.87,0:12:35.96,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:12:36.21,0:12:37.71,Default,,0,0,0,,Уф... Кешіріңіз.
Dialogue: 0,0:12:38.21,0:12:40.96,Default,,0,0,0,,Сіз құдай өлтірушіге жақсы адамсыз.
Dialogue: 0,0:12:41.55,0:12:43.30,Default,,0,0,0,,Күрескер болғандықтан, бұл қиын...
Dialogue: 0,0:12:43.92,0:12:45.89,Default,,0,0,0,,Патша үшін ақымақтық
Dialogue: 0,0:12:47.05,0:12:47.64,Default,,0,0,0,,Oh?
Dialogue: 0,0:12:48.18,0:12:51.64,Default,,0,0,0,,Бұл болашақ батырдың сауыты деуге болады.
Dialogue: 0,0:12:52.06,0:12:53.81,Default,,0,0,0,,Соңын көргім келді
Dialogue: 0,0:12:54.39,0:12:55.60,Default,,0,0,0,,Кешір мені (Құдай)... Не?
Dialogue: 0,0:12:55.73,0:12:56.31,Default,,0,0,0,,Уф
Dialogue: 0,0:12:56.65,0:12:57.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:57.94,0:12:58.65,Default,,0,0,0,,Құдай!
Dialogue: 0,0:12:59.06,0:12:59.65,Default,,0,0,0,,Ой…
Dialogue: 0,0:13:00.23,0:13:01.48,Default,,0,0,0,,Ұф… Ха…
Dialogue: 0,0:13:01.73,0:13:02.32,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:13:03.94,0:13:04.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:05.07,0:13:05.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:11.04,0:13:11.83,Default,,0,0,0,,Уф
Dialogue: 0,0:13:13.08,0:13:14.16,Default,,0,0,0,,(сілекей дірілдеген дыбыс)
Dialogue: 0,0:13:16.12,0:13:18.38,Default,,0,0,0,,Менің іздегенім Горгонеон
Dialogue: 0,0:13:19.00,0:13:23.84,Default,,0,0,0,,Қараңғы дүниенің тереңдігіне, жер асты әлемінің суық шөл даласына аттаныңыз.
Dialogue: 0,0:13:24.05,0:13:24.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:24.92,0:13:26.51,Default,,0,0,0,,Ой-а-а...
Dialogue: 0,0:13:26.84,0:13:31.10,Default,,0,0,0,,Вараваның өлімінің рухын алғаннан кейін де өз еркіңізді қалай сақтай аласыз?
Dialogue: 0,0:13:31.26,0:13:31.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.97,0:13:32.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:33.10,0:13:33.68,Default,,0,0,0,,Құдайым!
Dialogue: 0,0:13:34.27,0:13:35.68,Default,,0,0,0,,Эли...
Dialogue: 0,0:13:36.19,0:13:37.19,Default,,0,0,0,,Қаш...
Dialogue: 0,0:13:37.60,0:13:38.35,Default,,0,0,0,,Құдай!
Dialogue: 0,0:13:38.48,0:13:42.44,Default,,0,0,0,,Енді сол мәйітті кесіп алайық.
Dialogue: 0,0:13:43.32,0:13:45.57,Default,,0,0,0,,Мазасыз күш қолдануды болдырмау
Dialogue: 0,0:13:45.99,0:13:47.40,Default,,0,0,0,,Мен байқадым... Уф.
Dialogue: 0,0:13:47.99,0:13:49.03,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:13:53.79,0:13:54.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:55.04,0:13:59.54,Default,,0,0,0,,Болат арыстан, қайғы мен ашу сөзін саған тапсырамын.
Dialogue: 0,0:13:59.92,0:14:04.00,Default,,0,0,0,,Соңғы кезеңдегі қасиетті қанға шомылыңыз және Лонгинустың қасиетті найзасын ашыңыз!
Dialogue: 0,0:14:10.30,0:14:14.85,Default,,0,0,0,,Герместің тіпті құдай өлтіруші емес шәкірті оған қарсы соғыспақ па?
Dialogue: 0,0:14:15.64,0:14:16.60,Default,,0,0,0,,Афина құдайы
Dialogue: 0,0:14:17.23,0:14:20.19,Default,,0,0,0,,Эрика Бранделли, Году Кусанагидің рыцары...
Dialogue: 0,0:14:20.31,0:14:23.32,Default,,0,0,0,,Қылышыммен Жаратқанды қорғаймын.
Dialogue: 0,0:14:30.70,0:14:32.58,Default,,0,0,0,,Хмм... біз қазірдің өзінде хабарласып жатырмыз.
Dialogue: 0,0:14:34.99,0:14:37.16,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:14:38.29,0:14:40.17,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:14:41.21,0:14:43.79,Default,,0,0,0,,Иеміз үшін жаныңды бересің бе?
Dialogue: 0,0:14:44.42,0:14:46.09,Default,,0,0,0,,Уф... Мен рыцарьмын
Dialogue: 0,0:14:46.26,0:14:47.30,Default,,0,0,0,,Мен де соны қалаймын!
Dialogue: 0,0:14:48.84,0:14:49.76,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:49.93,0:14:52.01,Default,,0,0,0,,Қылышыңды сабанға сілтейтін кездер болады.
Dialogue: 0,0:14:52.14,0:14:53.51,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:14:54.89,0:14:56.10,Default,,0,0,0,,Герместің етігі!
Dialogue: 0,0:14:58.18,0:14:59.60,Default,,0,0,0,,Ұф… Ха…
Dialogue: 0,0:14:59.73,0:15:02.06,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:15:03.86,0:15:07.03,Default,,0,0,0,,Біреудің қолынан жараланғаныма көп болды.
Dialogue: 0,0:15:07.61,0:15:10.11,Default,,0,0,0,,Лонгинус найзасының қарғысы сонда тұрады.
Dialogue: 0,0:15:10.53,0:15:13.78,Default,,0,0,0,,Бұдан Афина да аман қалмайды.
Dialogue: 0,0:15:13.95,0:15:14.83,Default,,0,0,0,,Иә
Dialogue: 0,0:15:15.24,0:15:17.12,Default,,0,0,0,,Бірақ ұят, адам баласы.
Dialogue: 0,0:15:17.45,0:15:18.04,Default,,0,0,0,,(жалау дыбысы)
Dialogue: 0,0:15:18.83,0:15:20.83,Default,,0,0,0,,Біз өлтіруші құдайды адал етуіміз керек.
Dialogue: 0,0:15:21.29,0:15:25.50,Default,,0,0,0,,Сүйікті балам ретінде мен сені ерекше қорғаймын.
Dialogue: 0,0:15:25.67,0:15:26.50,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:15:27.05,0:15:28.30,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:15:28.46,0:15:29.05,Default,,0,0,0,,ақымақ
Dialogue: 0,0:15:32.05,0:15:32.84,Default,,0,0,0,,Бұл өтірік пе?
Dialogue: 0,0:15:33.26,0:15:34.68,Default,,0,0,0,,Қызыл кресттің сынасы
Dialogue: 0,0:15:35.05,0:15:37.39,Default,,0,0,0,,Айдаһар қабыршақтарын жыртып, ішегін ойып ал!
Dialogue: 0,0:15:43.02,0:15:44.31,Default,,0,0,0,,Барлығы таусылды ма?
Dialogue: 0,0:15:44.69,0:15:45.27,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:15:50.24,0:15:50.82,Default,,0,0,0,,Хо
Dialogue: 0,0:15:51.36,0:15:52.99,Default,,0,0,0,,Өте күрделі еліктеу
Dialogue: 0,0:15:58.04,0:16:01.04,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:16:01.75,0:16:02.41,Default,,0,0,0,,​​О?
Dialogue: 0,0:16:03.04,0:16:05.67,Default,,0,0,0,,Лилиана, сен Жапонияға не үшін келдің?
Dialogue: 0,0:16:06.42,0:16:07.88,Default,,0,0,0,,Маған Горгонеионды беріңіз.
Dialogue: 0,0:16:08.00,0:16:08.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:08.92,0:16:10.01,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:16:10.46,0:16:12.93,Default,,0,0,0,,Бұл қазір мөрленуі керек.
Dialogue: 0,0:16:13.43,0:16:14.13,Default,,0,0,0,,Пломба?
Dialogue: 0,0:16:14.59,0:16:16.35,Default,,0,0,0,,Иә, мен уәде бердім.
Dialogue: 0,0:16:17.05,0:16:19.64,Default,,0,0,0,,Эрика мен басқалары Афинаны ұстап тұрғанда...
Dialogue: 0,0:16:19.85,0:16:21.18,Default,,0,0,0,,Мен оны мөрлеген кезде
Dialogue: 0,0:16:21.77,0:16:25.19,Default,,0,0,0,,Сендей мөр Құдайға жете алмайды.
Dialogue: 0,0:16:25.35,0:16:27.90,Default,,0,0,0,,Бұл әлі де орындалуы керек
Dialogue: 0,0:16:28.48,0:16:29.19,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:29.82,0:16:32.44,Default,,0,0,0,,Ондай жағдайда оны күшпен алып кетіңіз.
Dialogue: 0,0:16:33.78,0:16:34.99,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:16:35.16,0:16:35.91,Default,,0,0,0,,Мініңіз
Dialogue: 0,0:16:36.12,0:16:36.78,Default,,0,0,0,,Амакасу мырза
Dialogue: 0,0:16:37.24,0:16:37.95,Default,,0,0,0,,Юри Мария!
Dialogue: 0,0:16:39.20,0:16:41.16,Default,,0,0,0,,Oh?
Dialogue: 0,0:16:42.71,0:16:44.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:45.29,0:16:47.46,Default,,0,0,0,,Жарайды, мен оны уақытында орындағаныма қуаныштымын.
Dialogue: 0,0:16:47.96,0:16:51.05,Default,,0,0,0,,Мен мұның тез төтенше жағдайға айналады деп күткен жоқпын.
Dialogue: 0,0:16:51.88,0:16:53.55,Default,,0,0,0,,Горгонеон туралы не деуге болады?
Dialogue: 0,0:16:54.30,0:16:55.80,Default,,0,0,0,,осында
Dialogue: 0,0:16:57.05,0:16:58.35,Default,,0,0,0,,Лилиана…
Dialogue: 0,0:17:02.64,0:17:04.02,Default,,0,0,0,,Қой?
Dialogue: 0,0:17:04.56,0:17:08.69,Default,,0,0,0,,Түсіндім, маған Афина өлім рухын сіңірді...
Dialogue: 0,0:17:10.86,0:17:11.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:12.19,0:17:13.15,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:17:13.74,0:17:14.40,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:17:15.32,0:17:17.82,Default,,0,0,0,,Түсіндім, ол қайтадан өлді ме?
Dialogue: 0,0:17:18.70,0:17:19.32,Default,,0,0,0,,Уақыт қанша?
Dialogue: 0,0:17:19.66,0:17:21.95,Default,,0,0,0,,Әлі кеш, жаңа рекорд.
Dialogue: 0,0:17:22.49,0:17:24.16,Default,,0,0,0,,Мен екі жарым сағатта ояндым.
Dialogue: 0,0:17:24.83,0:17:28.42,Default,,0,0,0,,Қошқардың құдіреті бірте-бірте өзінікіне айналып бара жатқандай.
Dialogue: 0,0:17:28.92,0:17:31.34,Default,,0,0,0,,Бұл өте қуанышты оқиға емес.
Dialogue: 0,0:17:32.34,0:17:34.05,Default,,0,0,0,,А... жаман.
Dialogue: 0,0:17:34.67,0:17:35.55,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:17:35.84,0:17:36.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:36.76,0:17:39.97,Default,,0,0,0,,Бойжеткен болса да, терісінің ауыруына жол бересің.
Dialogue: 0,0:17:40.55,0:17:42.01,Default,,0,0,0,,Хе, рахмет
Dialogue: 0,0:17:42.18,0:17:46.31,Default,,0,0,0,,Бірақ мен оны сөзіңізбен емес, іс-әрекетіңізбен көрсеткеніңізді қалаймын.
Dialogue: 0,0:17:46.56,0:17:48.23,Default,,0,0,0,,Не? Жоқ, күте тұрыңыз
Dialogue: 0,0:17:48.35,0:17:51.77,Default,,0,0,0,,Бірақ бұл саябақ, сондықтан біреу қарап тұрған болуы мүмкін.
Dialogue: 0,0:17:52.19,0:17:54.53,Default,,0,0,0,,Дәлірек айтқанда, бұл ұстаным...
Dialogue: 0,0:17:54.69,0:17:57.03,Default,,0,0,0,,Жоқ, жоқ, тыныш бол.
Dialogue: 0,0:17:57.15,0:17:58.28,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:17:58.82,0:18:00.03,Default,,0,0,0,,Олай болса көшеміз бе?
Dialogue: 0,0:18:00.32,0:18:02.49,Default,,0,0,0,,Менің бөлмемдегі төсекте
Dialogue: 0,0:18:02.70,0:18:05.95,Default,,0,0,0,,Ха, бұлай айтатын уақыт емес.
Dialogue: 0,0:18:06.54,0:18:08.50,Default,,0,0,0,,Иә, өкінішке орай.
Dialogue: 0,0:18:09.71,0:18:10.38,Default,,0,0,0,,Афина ше?
Dialogue: 0,0:18:11.09,0:18:11.79,Default,,0,0,0,,Мүмкін-
Dialogue: 0,0:18:12.54,0:18:14.84,Default,,0,0,0,,Олар Горгонеионды қуып қозғалуы керек.
Dialogue: 0,0:18:15.21,0:18:17.88,Default,,0,0,0,,Оны тапқанша көп уақыт кетпейді.
Dialogue: 0,0:18:18.26,0:18:19.64,Default,,0,0,0,,Әй, Мария...
Dialogue: 0,0:18:19.89,0:18:21.10,Default,,0,0,0,,Ах, менде бәрі жақсы. (Құдай) Ах... Ах.
Dialogue: 0,0:18:21.26,0:18:23.81,Default,,0,0,0,,Бұл балаға кішкене көмекші керек.
Dialogue: 0,0:18:24.22,0:18:27.10,Default,,0,0,0,,Ол өте қиын және қиын бала.
Dialogue: 0,0:18:27.27,0:18:28.27,Default,,0,0,0,,Көмекші?
Dialogue: 0,0:18:28.81,0:18:32.15,Default,,0,0,0,,Қазір ең маңыздысы Горгонеон.
Dialogue: 0,0:18:32.90,0:18:35.15,Default,,0,0,0,,Афина оны міндетті түрде алады.
Dialogue: 0,0:18:35.40,0:18:36.99,Default,,0,0,0,,Енді бұл сөзсіз.
Dialogue: 0,0:18:37.24,0:18:39.07,Default,,0,0,0,,Бұл туралы не істеуім керек?
Dialogue: 0,0:18:39.40,0:18:41.28,Default,,0,0,0,,Екі жол қалды (Году), иә?
Dialogue: 0,0:18:41.87,0:18:44.16,Default,,0,0,0,,Афина өзінің шынайы келбетін қалпына келтіреді
Dialogue: 0,0:18:44.54,0:18:47.54,Default,,0,0,0,,Саусақтарыңызды аузыңызға салып, дүниенің соңын көріп тұрсыз ба?
Dialogue: 0,0:18:48.41,0:18:51.67,Default,,0,0,0,,Оған қарсы тұруға күші бар адам табыла ма?
Dialogue: 0,0:18:53.42,0:18:56.42,Default,,0,0,0,,Таңдау сенікі, Годоу.
Dialogue: 0,0:18:57.05,0:18:57.63,Default,,0,0,0,,Иә
Dialogue: 0,0:18:58.09,0:18:58.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:59.26,0:19:01.64,Default,,0,0,0,,Түбінде бәрі сен қалағандай болады...
Dialogue: 0,0:19:01.76,0:19:03.85,Default,,0,0,0,,Мен бұл болып жатқандай әсер қалдырмаймын.
Dialogue: 0,0:19:04.14,0:19:05.51,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:19:05.76,0:19:07.06,Default,,0,0,0,,Сіз патшасыз
Dialogue: 0,0:19:07.81,0:19:10.73,Default,,0,0,0,,Патшаны әрқашан еріксіз жол күтеді.
Dialogue: 0,0:19:10.94,0:19:12.19,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:19:13.44,0:19:14.19,Default,,0,0,0,,Бұл да дұрыс па?
Dialogue: 0,0:19:15.19,0:19:15.73,Default,,0,0,0,,Иә
Dialogue: 0,0:19:16.23,0:19:17.86,Default,,0,0,0,,Басқа амал жоқ па?
Dialogue: 0,0:19:18.44,0:19:22.66,Default,,0,0,0,,Менде Құдай туралы білім бар болса, мен алтын қылышты қолдана аламын, солай ма?
Dialogue: 0,0:19:22.87,0:19:26.87,Default,,0,0,0,,Бұл дұрыс, бірақ Афина туралы білім өте кең.
Dialogue: 0,0:19:27.37,0:19:31.12,Default,,0,0,0,,Сөзбен жеткізгім келсе, кем дегенде 100 күн керек еді.
Dialogue: 0,0:19:32.33,0:19:33.21,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:19:33.63,0:19:35.34,Default,,0,0,0,,Бірақ анық айтайын.
Dialogue: 0,0:19:36.04,0:19:38.55,Default,,0,0,0,,Бұл тек төтенше жағдай.
Dialogue: 0,0:19:38.71,0:19:40.30,Default,,0,0,0,,...
Dialogue: 0,0:19:40.88,0:19:42.72,Default,,0,0,0,,...
Dialogue: 0,0:19:44.14,0:19:46.64,Default,,0,0,0,,Сонымен... Құдайдың билігін ескере отырып...
Dialogue: 0,0:19:46.85,0:19:49.60,Default,,0,0,0,,Неліктен мұндай күрделі шарттар бар?
Dialogue: 0,0:19:49.81,0:19:52.56,Default,,0,0,0,,Уақыт жылдам өтіп жатыр.
Dialogue: 0,0:19:53.31,0:19:53.90,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:19:55.31,0:19:57.94,Default,,0,0,0,,Маған Афина туралы білетіндердің барлығын айтыңыз.
Dialogue: 0,0:19:59.23,0:20:01.53,Default,,0,0,0,,Қалауыңызша, тақсыр.
Dialogue: 0,0:20:02.32,0:20:04.36,Default,,0,0,0,,―
Dialogue: 0,0:20:04.91,0:20:06.99,Default,,0,0,0,,Біздің сиқыршылардың патшасы
Dialogue: 0,0:20:07.53,0:20:08.54,Default,,0,0,0,,Егер солай десеңіз...
Dialogue: 0,0:20:08.70,0:20:09.83,Default,,0,0,0,,...
Dialogue: 0,0:20:10.29,0:20:10.91,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:20:11.29,0:20:13.12,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:20:13.50,0:20:14.21,Default,,0,0,0,,Уау
Dialogue: 0,0:20:14.37,0:20:17.84,Default,,0,0,0,,Соңғы кездері маған өте суық қарады, сондықтан бұл өте қызық.
Dialogue: 0,0:20:18.30,0:20:22.26,Default,,0,0,0,,Году маған суық болса да, Афина мені сүйді...
Dialogue: 0,0:20:22.84,0:20:24.26,Default,,0,0,0,,...
Dialogue: 0,0:20:24.76,0:20:26.39,Default,,0,0,0,,Сондықтан бұл форс-мажорлық жағдай болды...
Dialogue: 0,0:20:26.51,0:20:28.35,Default,,0,0,0,,...
Dialogue: 0,0:20:28.85,0:20:31.60,Default,,0,0,0,,Ондай кезде аузыңды жауып тыңдасаң болғаны.
Dialogue: 0,0:20:32.02,0:20:33.94,Default,,0,0,0,,...
Dialogue: 0,0:20:34.14,0:20:34.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:35.85,0:20:36.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:41.32,0:20:42.53,Default,,0,0,0,,Горгонеион – бұл-
Dialogue: 0,0:20:42.65,0:20:45.57,Default,,0,0,0,,Грек мифологиясындағы Медузаның ұқсастығы
Dialogue: 0,0:20:46.07,0:20:49.45,Default,,0,0,0,,Батыр Персей өлтірген жылан құбыжық.
Dialogue: 0,0:20:50.37,0:20:50.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:51.37,0:20:53.25,Default,,0,0,0,,Ол жерге тіліңді салма...
Dialogue: 0,0:20:53.37,0:20:56.21,Default,,0,0,0,,Сөйлеу рухын осылай жеткізу жылдамырақ.
Dialogue: 0,0:20:56.54,0:20:57.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:57.50,0:20:59.63,Default,,0,0,0,,Афинаның әкесі – бас құдай Зевс
Dialogue: 0,0:21:00.00,0:21:02.01,Default,,0,0,0,,Ана – Метис, даналық құдайы
Dialogue: 0,0:21:02.38,0:21:06.34,Default,,0,0,0,,Негізінде, Метис пен Медуза бір мағыналы сөздер.
Dialogue: 0,0:21:06.97,0:21:08.47,Default,,0,0,0,,Оның мағынасы «даналық»
Dialogue: 0,0:21:09.81,0:21:13.85,Default,,0,0,0,,Афинаға Медузаның басы, анасымен аттас жылан бейнеленген.
Dialogue: 0,0:21:14.52,0:21:18.56,Default,,0,0,0,,Бұл бас Афинаның қалқанына айналады және әрқашан оның жанында болады.
Dialogue: 0,0:21:19.31,0:21:22.32,Default,,0,0,0,,Медуза, былайша айтқанда, Афинаның анасының алтер-эгосы.
Dialogue: 0,0:21:23.24,0:21:25.90,Default,,0,0,0,,Афинаның да бір кездері жылан құдайы болғанының дәлелі
Dialogue: 0,0:21:26.28,0:21:27.32,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:21:27.95,0:21:31.83,Default,,0,0,0,,Мифологияда кездесетін жылан - жердің жемістілігін басқаратын құдай.
Dialogue: 0,0:21:32.24,0:21:34.87,Default,,0,0,0,,Басқаша айтқанда, ол Жер-ана құдайының бейнесі.
Dialogue: 0,0:21:35.21,0:21:35.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:36.04,0:21:36.62,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:21:36.75,0:21:38.92,Default,,0,0,0,,Не болды? Мен әлі жолдамын
Dialogue: 0,0:21:39.42,0:21:40.79,Default,,0,0,0,,Қараңдаршы, не?
Dialogue: 0,0:21:43.88,0:21:44.80,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:47.55,0:21:49.85,Default,,0,0,0,,Афина қозғала бастады ма?
Dialogue: 0,0:21:51.93,0:21:53.89,Default,,0,0,0,,Менің іздегенім – Горгонеон
Dialogue: 0,0:21:54.39,0:21:58.10,Default,,0,0,0,,Бүгін түнде Афина ежелгі жыланды қайтармайды.
