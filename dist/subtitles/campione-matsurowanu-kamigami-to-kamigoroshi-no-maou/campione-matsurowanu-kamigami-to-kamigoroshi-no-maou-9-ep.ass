Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.08,0:00:02.46,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:00:03.92,0:00:05.96,Default,,0,0,0,,Құсанаги... Году
Dialogue: 0,0:00:08.92,0:00:11.05,Default,,0,0,0,,Құдай өлтіруші міндетті түрде жеңілді.
Dialogue: 0,0:00:11.26,0:00:13.34,Default,,0,0,0,,...бұл алаңдаушылық
Dialogue: 0,0:00:13.88,0:00:15.14,Default,,0,0,0,,Мен оны лақтыра алмаймын
Dialogue: 0,0:00:15.30,0:00:18.64,Default,,0,0,0,,Иә! Мәйітті қорламақшысың ба?
Dialogue: 0,0:00:20.43,0:00:21.06,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:21.93,0:00:22.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:25.77,0:00:27.90,Default,,0,0,0,,Хун, Афина деп те аталуы мүмкін біреу...
Dialogue: 0,0:00:28.11,0:00:30.07,Default,,0,0,0,,Бұл аздап дөрекі мінез-құлық емес пе?
Dialogue: 0,0:00:30.23,0:00:32.74,Default,,0,0,0,,Сағынба, жылан өлтіретін болат.
Dialogue: 0,0:00:32.99,0:00:34.90,Default,,0,0,0,,А... ол жабайы олжа.
Dialogue: 0,0:00:35.41,0:00:36.91,Default,,0,0,0,,Мен саған мұны істемеймін
Dialogue: 0,0:00:37.78,0:00:40.58,Default,,0,0,0,,Басқаша айтқанда, бұл құдай өлтіруші әлі тірі және жақсы ма?
Dialogue: 0,0:00:40.79,0:00:41.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:41.79,0:00:42.58,Default,,0,0,0,,Иә
Dialogue: 0,0:00:42.79,0:00:47.42,Default,,0,0,0,,Оның үстіне құлаған соң қызығырақ болады.
Dialogue: 0,0:00:48.38,0:00:49.92,Default,,0,0,0,,Хмф, ау.
Dialogue: 0,0:00:50.13,0:00:53.01,Default,,0,0,0,,Сіз бұлай айтқанда, менің айтқанымнан қайтудан басқа амалым жоқ.
Dialogue: 0,0:00:53.47,0:00:56.09,Default,,0,0,0,,Құдай өлтіруші мен менің жараларым жазыла бастағанда...
Dialogue: 0,0:00:56.30,0:00:58.68,Default,,0,0,0,,Бір-бірімізді жаңа ұрыс даласында кездестірдік делік.
Dialogue: 0,0:00:59.01,0:01:01.68,Default,,0,0,0,,Содан кейін сіздің кезегіңіз.
Dialogue: 0,0:01:02.02,0:01:02.68,Default,,0,0,0,,Иә
Dialogue: 0,0:01:03.18,0:01:04.60,Default,,0,0,0,,Олай болса, қош бол!
Dialogue: 0,0:01:04.77,0:01:07.10,Default,,0,0,0,,(аттың кинелеген дыбысы)
Dialogue: 0,0:01:10.19,0:01:13.78,Default,,0,0,0,,Қызым, Году Құсанагиге айт.
Dialogue: 0,0:01:14.11,0:01:16.28,Default,,0,0,0,,«Мен ешқашан артта қалуыма жол бермеймін».
Dialogue: 0,0:01:16.45,0:01:20.08,Default,,0,0,0,,«Сені жеңетін жалғыз адам – мына сабан адам».
Dialogue: 0,0:01:20.66,0:01:21.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:25.29,0:01:28.29,Default,,0,0,0,,♪～
Dialogue: 0,0:02:50.62,0:02:53.63,Default,,0,0,0,,～♪
Dialogue: 0,0:02:59.59,0:03:00.38,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:03:00.59,0:03:02.05,Default,,0,0,0,,Yaho~ Godou
Dialogue: 0,0:03:02.93,0:03:05.05,Default,,0,0,0,,Пандора мырза... солай ма?
Dialogue: 0,0:03:05.26,0:03:06.97,Default,,0,0,0,,Сіз мені «Анашым» деп атай аласыз.
Dialogue: 0,0:03:07.22,0:03:10.31,Default,,0,0,0,,Бұл өмір мен өлместіктің арасындағы шекара екеніне сенімдімін.
Dialogue: 0,0:03:10.48,0:03:12.73,Default,,0,0,0,,Ол жанды түрде өтеді.
Dialogue: 0,0:03:12.90,0:03:14.90,Default,,0,0,0,,Хмм... жарайды, солай.
Dialogue: 0,0:03:15.23,0:03:19.03,Default,,0,0,0,,Мен өлтірер алдында қошқардың инкарнациясын пайдалануым керек еді.
Dialogue: 0,0:03:19.40,0:03:20.65,Default,,0,0,0,,О, мен білмедім бе?
Dialogue: 0,0:03:20.82,0:03:23.24,Default,,0,0,0,,Дұрыс, өлген соң қайта тірілесің.
Dialogue: 0,0:03:23.41,0:03:27.08,Default,,0,0,0,,Ой... ол жәй өліп жатқан жоқ, шынында да өлді.
Dialogue: 0,0:03:27.33,0:03:30.08,Default,,0,0,0,,Ал, мен саған жақсы нәрсе айтайын!
Dialogue: 0,0:03:30.29,0:03:33.92,Default,,0,0,0,,Дегенмен, мен мұнда естігенімнің көбін ұмытамын.
Dialogue: 0,0:03:34.08,0:03:36.09,Default,,0,0,0,,Мұны сұраудың қажеті жоқ ...
Dialogue: 0,0:03:34.08,0:03:36.09,Default,,0,0,0,,(Пандораның күлкісі)
Dialogue: 0,0:03:36.29,0:03:40.09,Default,,0,0,0,,Шындығында, жаман нәрсе болатын сияқты.
Dialogue: 0,0:03:40.30,0:03:41.26,Default,,0,0,0,,Жаман нәрсе ме?
Dialogue: 0,0:03:41.55,0:03:45.68,Default,,0,0,0,,Болат құдайы бар Персей - жыландарды өлтіретін батыр.
Dialogue: 0,0:03:45.93,0:03:50.02,Default,,0,0,0,,Жылан болатты жеңе алмайды, бірақ...
Dialogue: 0,0:03:50.14,0:03:52.35,Default,,0,0,0,,А, бұл сезім...
Dialogue: 0,0:03:52.52,0:03:54.77,Default,,0,0,0,,Түсіндім, қайта тіріледі ме?
Dialogue: 0,0:03:54.94,0:03:55.52,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:03:55.81,0:03:57.44,Default,,0,0,0,,Тек жеңілме
Dialogue: 0,0:03:57.65,0:03:59.44,Default,,0,0,0,,Қыздырайық!
Dialogue: 0,0:03:59.61,0:04:01.74,Default,,0,0,0,,...Бұл адам спортшы.
Dialogue: 0,0:04:04.36,0:04:05.95,Default,,0,0,0,,Ха! Году Кусанаги
Dialogue: 0,0:04:06.37,0:04:08.24,Default,,0,0,0,,Лилиана...
Dialogue: 0,0:04:08.79,0:04:11.91,Default,,0,0,0,,Ах... міне...
Dialogue: 0,0:04:12.12,0:04:14.79,Default,,0,0,0,,Қола Қара Крест Неаполь тармағы.
Dialogue: 0,0:04:15.00,0:04:16.79,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:04:15.00,0:04:16.79,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:17.29,0:04:21.88,Default,,0,0,0,,Мен Персейден жеңілдім деп ойладым, бірақ кейін денем өздігінен жазыла бастады...
Dialogue: 0,0:04:22.05,0:04:23.80,Default,,0,0,0,,Мен өмірге оңай оралдым...
Dialogue: 0,0:04:24.47,0:04:27.14,Default,,0,0,0,,Өтінемін, тым болмаса өлмес бұрын маған түсіндіріп берші.
Dialogue: 0,0:04:27.35,0:04:29.81,Default,,0,0,0,,Жоқ, менің бұған уақытым жоқ.
Dialogue: 0,0:04:29.97,0:04:33.56,Default,,0,0,0,,Патшаның қабілеті – уақыт бойынша бірдеңе істеу!
Dialogue: 0,0:04:33.73,0:04:34.98,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:04:35.19,0:04:38.48,Default,,0,0,0,,Ха! Әй... патшаны менсінбейсің ғой.
Dialogue: 0,0:04:38.69,0:04:42.32,Default,,0,0,0,,Ашуыңды бассам, ашуыңды басу үшін қолымнан келгеннің бәрін істеймін.
Dialogue: 0,0:04:42.53,0:04:44.32,Default,,0,0,0,,Мен ерекше ашуланбаймын.
Dialogue: 0,0:04:44.49,0:04:47.24,Default,,0,0,0,,Біріншіден жеңілгенім кінәлі.
Dialogue: 0,0:04:47.49,0:04:50.33,Default,,0,0,0,,Жоқ, мен саған сол жолы айттым...
Dialogue: 0,0:04:50.49,0:04:52.66,Default,,0,0,0,,Ерніңді ұсынсаң да...
Dialogue: 0,0:04:52.91,0:04:55.33,Default,,0,0,0,,А... Түсінемін, бұл маңызды емес.
Dialogue: 0,0:04:55.71,0:04:58.17,Default,,0,0,0,,Өйткені, бұл тек жапондық догжеза...
Dialogue: 0,0:04:58.33,0:04:59.50,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:04:59.67,0:05:01.67,Default,,0,0,0,,Сонымен... Харакири ше?
Dialogue: 0,0:05:01.88,0:05:02.96,Default,,0,0,0,,Бұл да басқа!
Dialogue: 0,0:05:03.13,0:05:05.17,Default,,0,0,0,,Дұрыс, Лилиана.
Dialogue: 0,0:05:05.38,0:05:06.26,Default,,0,0,0,,Ах
Dialogue: 0,0:05:06.68,0:05:08.01,Default,,0,0,0,,Ка... Карен?
Dialogue: 0,0:05:08.18,0:05:11.85,Default,,0,0,0,,Мен сіздің жүзіңізбен аудиторияға ие болғаныма өте қуаныштымын.
Dialogue: 0,0:05:12.06,0:05:16.48,Default,,0,0,0,,Менің атым Карен Янкловский, қола қара кресттің бақсы шәкірті.
Dialogue: 0,0:05:16.73,0:05:18.19,Default,,0,0,0,,О, сәлем, а...
Dialogue: 0,0:05:18.77,0:05:20.82,Default,,0,0,0,,Лилиана-сама түні бойы...
Dialogue: 0,0:05:20.98,0:05:23.86,Default,,0,0,0,,Құсанағы-самаға қамқор болды.
Dialogue: 0,0:05:24.03,0:05:26.53,Default,,0,0,0,,Мен көрдім. Рахмет, Лилиана.
Dialogue: 0,0:05:26.74,0:05:28.99,Default,,0,0,0,,Ал... мен күткенімді орындадым.
Dialogue: 0,0:05:29.24,0:05:31.87,Default,,0,0,0,,Уху, Лилиана-сама...
Dialogue: 0,0:05:32.08,0:05:35.20,Default,,0,0,0,,Құсанағи мырзаның іздегені басқа нәрсе.
Dialogue: 0,0:05:35.37,0:05:35.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:36.71,0:05:39.04,Default,,0,0,0,,Неліктен Құсанаги мырза осында?
Dialogue: 0,0:05:39.25,0:05:43.71,Default,,0,0,0,,Негізі мен мұны жақын досым Арианнадан естідім.
Dialogue: 0,0:05:44.01,0:05:46.22,Default,,0,0,0,,Әлгі жын қыздан?
Dialogue: 0,0:05:46.47,0:05:49.55,Default,,0,0,0,,Иә, Құсанаги-сама - Эрика-сама және басқа адам...
Dialogue: 0,0:05:49.72,0:05:52.72,Default,,0,0,0,,Юрий Мария есімді жапондық әйелдің сүйемелдеуімен...
Dialogue: 0,0:05:52.89,0:05:54.97,Default,,0,0,0,,Мен демалыста болдым.
Dialogue: 0,0:05:55.14,0:05:56.06,Default,,0,0,0,,Ха (Құдай) Ах...
Dialogue: 0,0:05:56.23,0:06:00.06,Default,,0,0,0,,Сардиниядан келген жергілікті әйелі Лукрезия Зола қосылды...
Dialogue: 0,0:06:00.23,0:06:02.15,Default,,0,0,0,,Таңертең және кешке керемет оргия...
Dialogue: 0,0:06:02.32,0:06:05.07,Default,,0,0,0,,Аа... кешіріңіз, мен сәл артық айттым.
Dialogue: 0,0:06:05.23,0:06:07.90,Default,,0,0,0,,Ха! Қандай бұзылған өмір...
Dialogue: 0,0:06:08.07,0:06:10.66,Default,,0,0,0,,Ерика ғана емес, атақты бақсы мен Юри Мария...
Dialogue: 0,0:06:10.78,0:06:11.41,Default,,0,0,0,,Негізсіз
Dialogue: 0,0:06:11.62,0:06:14.33,Default,,0,0,0,,Ақырында біз әлемдегі барлық сұлу ханшайымдарды аулаймыз.
Dialogue: 0,0:06:14.49,0:06:18.08,Default,,0,0,0,,Шампанмен толтырылған ваннада ет орманы тоғанын тамашалау...
Dialogue: 0,0:06:18.25,0:06:19.75,Default,,0,0,0,,Қандай құлдыраған! (Құдай) Иә...
Dialogue: 0,0:06:20.25,0:06:23.54,Default,,0,0,0,,Ондай адам Лилианадан не тілейді...
Dialogue: 0,0:06:24.09,0:06:25.09,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:06:25.30,0:06:26.26,Default,,0,0,0,,Ha
Dialogue: 0,0:06:26.92,0:06:29.43,Default,,0,0,0,,Ка... Карен-сан...
Dialogue: 0,0:06:29.59,0:06:31.39,Default,,0,0,0,,Хмм... Иә!
Dialogue: 0,0:06:31.64,0:06:34.01,Default,,0,0,0,,О...ұмытпа, патша.
Dialogue: 0,0:06:34.18,0:06:37.02,Default,,0,0,0,,Бұл... Мен асып кетсем де...
Dialogue: 0,0:06:37.18,0:06:39.02,Default,,0,0,0,,Бұл... менің жүрегімде!
Dialogue: 0,0:06:39.19,0:06:40.10,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:06:40.31,0:06:43.44,Default,,0,0,0,,Жарайсың! Бұл Ди Морто Бене, Лилиана!
Dialogue: 0,0:06:43.82,0:06:46.23,Default,,0,0,0,,Сәлем! Күтіңіз... күтіңіз...
Dialogue: 0,0:06:46.40,0:06:50.36,Default,,0,0,0,,Е... а... мені тыңдаңызшы!
Dialogue: 0,0:06:50.53,0:06:52.37,Default,,0,0,0,,(балықшыларға арналған итальян)
Dialogue: 0,0:06:52.57,0:06:54.78,Default,,0,0,0,,Кеме де қозғалмайтын сияқты.
Dialogue: 0,0:06:55.12,0:06:56.45,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:06:56.62,0:06:57.62,Default,,0,0,0,,Күн ыстық
Dialogue: 0,0:06:57.79,0:07:00.37,Default,,0,0,0,,Барлығы кенеттен жарамсыз болып қалды.
Dialogue: 0,0:07:01.12,0:07:05.63,Default,,0,0,0,,Году қандай да бір себептермен Неапольде болып, Мацурованукамиге қарсы соғысып, жеңіліске ұшырады.
Dialogue: 0,0:07:05.80,0:07:09.47,Default,,0,0,0,,Сол хабардан кейін тіпті ұялы телефоным да жарамсыз болып қалды.
Dialogue: 0,0:07:09.67,0:07:10.63,Default,,0,0,0,,Бұл ауырады.
Dialogue: 0,0:07:10.80,0:07:12.93,Default,,0,0,0,,Году-сан жақсы ма?
Dialogue: 0,0:07:13.47,0:07:16.31,Default,,0,0,0,,Сіз өлтірілгендіктен өлудің сүйкімді ештеңесі жоқ.
Dialogue: 0,0:07:17.01,0:07:21.14,Default,,0,0,0,,Әзірге бұл аралдан не болса да кетудің жолын табайық.
Dialogue: 0,0:07:22.48,0:07:24.23,Default,,0,0,0,,(Телефон қоңыраулары шырылдамайды)
Dialogue: 0,0:07:24.48,0:07:26.98,Default,,0,0,0,,Эрика және басқалармен байланыса алмайсыз ба?
Dialogue: 0,0:07:27.15,0:07:29.24,Default,,0,0,0,,Сіз не істейсіз? Лилиана-сама
Dialogue: 0,0:07:29.57,0:07:32.57,Default,,0,0,0,,Уф... тесігі бар болса, мен кіргім келеді.
Dialogue: 0,0:07:32.99,0:07:34.66,Default,,0,0,0,,А... түсініспеушілік шешілді, сондықтан көп уайымдамаңыз.
Dialogue: 0,0:07:34.66,0:07:35.83,Default,,0,0,0,,А... түсініспеушілік шешілді, сондықтан көп уайымдамаңыз.
Dialogue: 0,0:07:34.66,0:07:35.83,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:07:35.83,0:07:36.83,Default,,0,0,0,,А... түсініспеушілік шешілді, сондықтан көп уайымдамаңыз.
Dialogue: 0,0:07:37.03,0:07:39.50,Default,,0,0,0,,әлі тірі жүргеніміз ғажайып сияқты.
Dialogue: 0,0:07:39.70,0:07:42.92,Default,,0,0,0,,Бұрын мен бұл туралы айттым ... ұят.
Dialogue: 0,0:07:43.17,0:07:44.67,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:44.83,0:07:47.34,Default,,0,0,0,,Сіз бұрын қол жетімді емес болып көрінетінсіз.
Dialogue: 0,0:07:47.50,0:07:49.34,Default,,0,0,0,,―
Dialogue: 0,0:07:49.51,0:07:52.09,Default,,0,0,0,,Ол қарапайым қызға ұқсайды және онымен оңай сөйлеседі.
Dialogue: 0,0:07:52.34,0:07:55.34,Default,,0,0,0,,Ах... Қалай болғанда да, қазір маңыздысы...
Dialogue: 0,0:07:55.51,0:07:57.68,Default,,0,0,0,,Персейді қалай жеңуге болады!
Dialogue: 0,0:07:57.85,0:07:59.18,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:07:59.39,0:08:00.85,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:08:01.06,0:08:01.77,Default,,0,0,0,,(Құдайдың жөтелі)
Dialogue: 0,0:08:02.56,0:08:05.77,Default,,0,0,0,,Ол менің Урсулагна билігіме мөр басады.
Dialogue: 0,0:08:06.19,0:08:08.19,Default,,0,0,0,,Мен құпияны анықтауым керек
Dialogue: 0,0:08:08.69,0:08:09.78,Default,,0,0,0,,Персей деген кім?
Dialogue: 0,0:08:09.94,0:08:12.70,Default,,0,0,0,,«Парсыдан келген біреу» дегенді білдіреді.
Dialogue: 0,0:08:12.86,0:08:13.70,Default,,0,0,0,,Персия?
Dialogue: 0,0:08:13.86,0:08:16.87,Default,,0,0,0,,Сонда ол Урсуланьямен бір елдің құдайы ма?
Dialogue: 0,0:08:17.07,0:08:21.04,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл парсы тек шығысты көрсетеді.
Dialogue: 0,0:08:21.41,0:08:26.04,Default,,0,0,0,,«Шығыстың адамы» деп аударылуы керек екендігі дәлелденген теория.
Dialogue: 0,0:08:26.21,0:08:28.54,Default,,0,0,0,,Хмм, ол жоғалды.
Dialogue: 0,0:08:28.88,0:08:31.21,Default,,0,0,0,,Осындай уақытта Эрика мен басқалары осында болса ғой...
Dialogue: 0,0:08:31.55,0:08:32.55,Default,,0,0,0,,Эрика?
Dialogue: 0,0:08:33.92,0:08:35.89,Default,,0,0,0,,...
Dialogue: 0,0:08:36.09,0:08:39.47,Default,,0,0,0,,Ұйымда аздап күрделі оқиға бар.
Dialogue: 0,0:08:39.64,0:08:40.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:40.39,0:08:40.43,Default,,0,0,0,,Дұрыс, балконнан бұл қаланың көрінісі...
Dialogue: 0,0:08:40.43,0:08:43.31,Default,,0,0,0,,Дұрыс, балконнан бұл қаланың көрінісі...
Dialogue: 0,0:08:40.43,0:08:43.31,Default,,0,0,0,,А... Әй, эй...
Dialogue: 0,0:08:43.48,0:08:44.89,Default,,0,0,0,,Бұл өте бір нәрсе~
Dialogue: 0,0:08:45.06,0:08:45.27,Default,,0,0,0,,А, а... Жарайды, а...
Dialogue: 0,0:08:45.27,0:08:46.56,Default,,0,0,0,,А-а... Жарайды, а...
Dialogue: 0,0:08:45.27,0:08:46.56,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:46.56,0:08:46.98,Default,,0,0,0,,…  …
Dialogue: 0,0:08:48.65,0:08:49.57,Default,,0,0,0,,Карен?
Dialogue: 0,0:08:50.48,0:08:52.32,Default,,0,0,0,,...
Dialogue: 0,0:08:52.65,0:08:53.74,Default,,0,0,0,,Не айтып тұрсың?
Dialogue: 0,0:08:53.95,0:08:54.90,Default,,0,0,0,,Әрине-
Dialogue: 0,0:08:55.07,0:08:58.49,Default,,0,0,0,,Лилиана-сама Құсанағы-саманың жүрегін жаулайды деген сөз.
Dialogue: 0,0:08:58.66,0:09:00.08,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:09:00.24,0:09:01.33,Default,,0,0,0,,…
Dialogue: 0,0:09:02.08,0:09:03.66,Default,,0,0,0,,Сіз сенімдісіз бе? Лилиана-сама
Dialogue: 0,0:09:03.83,0:09:08.92,Default,,0,0,0,,Біз, қола қара крест пен қызыл қола қара крест, әрқашан бір-бірімізбен жарысып келген қарсыласпыз.
Dialogue: 0,0:09:09.29,0:09:12.09,Default,,0,0,0,,Алайда Эрика-сама жын патшасының ықыласына ие болғаннан бері...
Dialogue: 0,0:09:12.30,0:09:14.76,Default,,0,0,0,,Бұл қуат балансы бұзылуға жақын.
Dialogue: 0,0:09:14.92,0:09:15.59,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:15.76,0:09:17.59,Default,,0,0,0,,Бір жерде кімсің?
Dialogue: 0,0:09:17.80,0:09:19.43,Default,,0,0,0,,Маркиз Вобанды үш жарым сызықпен ұрыңыз...
Dialogue: 0,0:09:19.60,0:09:20.26,Default,,0,0,0,,Уф
Dialogue: 0,0:09:20.47,0:09:23.02,Default,,0,0,0,,Мен сэр Сальваторды басқара алмадым.
Dialogue: 0,0:09:23.18,0:09:23.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:24.31,0:09:27.10,Default,,0,0,0,,Қазір Эрика-самасыз жақсы уақыт.
Dialogue: 0,0:09:27.31,0:09:30.61,Default,,0,0,0,,Егер Лилиана-сама Құсанаги-саманың бірінші рыцары болса...
Dialogue: 0,0:09:30.82,0:09:34.69,Default,,0,0,0,,Бұл қола және қара кресттің үлкен дамуына әкеледі.
Dialogue: 0,0:09:34.86,0:09:38.45,Default,,0,0,0,,Қола қара крест үшін? Бірақ...
Dialogue: 0,0:09:38.78,0:09:40.62,Default,,0,0,0,,Бұл тағдыр деп ойламайсың ба?
Dialogue: 0,0:09:40.83,0:09:43.45,Default,,0,0,0,,А... Тағдыр ма?
Dialogue: 0,0:09:43.79,0:09:45.29,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:45.79,0:09:48.04,Default,,0,0,0,,Ах... ааа...
Dialogue: 0,0:09:48.50,0:09:50.13,Default,,0,0,0,,Бұл кең әлем
Dialogue: 0,0:09:50.29,0:09:52.63,Default,,0,0,0,,Неапольде кездейсоқ кездескен еркек пен әйел...
Dialogue: 0,0:09:52.84,0:09:55.30,Default,,0,0,0,,Алып жауларды жеңу үшін қолды біріктіріңіз
Dialogue: 0,0:09:55.63,0:09:56.47,Default,,0,0,0,,Фуфуфуфуфу… аа…
Dialogue: 0,0:09:56.63,0:10:00.30,Default,,0,0,0,,Оларды «тағдырдың екі адамы» демесек, басқа не дейміз?
Dialogue: 0,0:10:00.47,0:10:01.80,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:10:02.05,0:10:03.06,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:03.22,0:10:04.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:04.72,0:10:07.23,Default,,0,0,0,,Жарайды... бос сөзді осыған қалдырайық.
Dialogue: 0,0:10:07.39,0:10:08.48,Default,,0,0,0,,Мен... Біраз демаламын.
Dialogue: 0,0:10:08.48,0:10:09.48,Default,,0,0,0,,Мен... Біраз демаламын.
Dialogue: 0,0:10:08.48,0:10:09.48,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:10:09.48,0:10:10.15,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:10:10.27,0:10:11.23,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:10:11.86,0:10:13.77,Default,,0,0,0,,Уау, мінекей.
Dialogue: 0,0:10:14.48,0:10:17.24,Default,,0,0,0,,Уау~ Бұл керемет көрініс.
Dialogue: 0,0:10:18.82,0:10:19.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.41,0:10:23.74,Default,,0,0,0,,Хмм... итальянша?
Dialogue: 0,0:10:25.33,0:10:27.66,Default,,0,0,0,,Мен Кампион болғаннан бері...
Dialogue: 0,0:10:27.87,0:10:30.58,Default,,0,0,0,,Кез келген елдің тілі енді ыңғайсыз емес.
Dialogue: 0,0:10:31.50,0:10:32.63,Default,,0,0,0,,Жібер!
Dialogue: 0,0:10:32.96,0:10:34.42,Default,,0,0,0,,Мен сені жек көремін
Dialogue: 0,0:10:34.84,0:10:37.34,Default,,0,0,0,,Хмф, онда маған неге келдің?
Dialogue: 0,0:10:37.59,0:10:40.01,Default,,0,0,0,,Мен сені білемін...
Dialogue: 0,0:10:40.18,0:10:42.68,Default,,0,0,0,,Уф, ха! А... жоқ
Dialogue: 0,0:10:42.85,0:10:43.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:44.10,0:10:46.68,Default,,0,0,0,,Мен сені жібермеймін, сен менікісің
Dialogue: 0,0:10:46.89,0:10:48.52,Default,,0,0,0,,Хмм, ах…
Dialogue: 0,0:10:50.19,0:10:51.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:51.90,0:10:53.61,Default,,0,0,0,,Бұл өз бетінше жазылған роман ба?
Dialogue: 0,0:10:54.19,0:10:55.27,Default,,0,0,0,,Нақты кім?
Dialogue: 0,0:10:55.94,0:10:57.36,Default,,0,0,0,,Қозғалма (Құдай) Уф!
Dialogue: 0,0:10:57.53,0:10:59.28,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:10:59.45,0:11:00.49,Default,,0,0,0,,Сол дауыс…
Dialogue: 0,0:11:01.20,0:11:04.45,Default,,0,0,0,,Әй, сен менің сырымды білдің.
Dialogue: 0,0:11:05.03,0:11:07.54,Default,,0,0,0,,Бұлай болса, мен де сені өлтіремін, өлемін!
Dialogue: 0,0:11:07.87,0:11:09.37,Default,,0,0,0,,Уа, тыныштал!
Dialogue: 0,0:11:09.54,0:11:11.37,Default,,0,0,0,,Бұл Лилиананыкі ме?
Dialogue: 0,0:11:11.58,0:11:15.63,Default,,0,0,0,,Еңбектен жараланған жүрегімді тыныштандыратын құпия хобби.
Dialogue: 0,0:11:15.84,0:11:16.46,Default,,0,0,0,,Ал дегенмен!
Dialogue: 0,0:11:16.63,0:11:18.88,Default,,0,0,0,,Ах... ой! Уф
Dialogue: 0,0:11:19.09,0:11:20.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:20.26,0:11:23.89,Default,,0,0,0,,«Тағдыр» деген тәтті әңгімеге құлап қала жаздадым.
Dialogue: 0,0:11:24.05,0:11:26.26,Default,,0,0,0,,Әй, эй... Лилиана!
Dialogue: 0,0:11:27.31,0:11:28.72,Default,,0,0,0,,Жара жазылса керек?
Dialogue: 0,0:11:28.89,0:11:29.56,Default,,0,0,0,,Ах
Dialogue: 0,0:11:32.60,0:11:35.23,Default,,0,0,0,,Ол әлі де қыңыр адам.
Dialogue: 0,0:11:38.73,0:11:40.40,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:11:40.61,0:11:41.90,Default,,0,0,0,,Не?
Dialogue: 0,0:11:42.32,0:11:46.08,Default,,0,0,0,,Персей менің күшімді қалай жоя алады?
Dialogue: 0,0:11:46.28,0:11:47.87,Default,,0,0,0,,Себебі сен мені ұрысқа сүйреп апардың...
Dialogue: 0,0:11:48.20,0:11:50.41,Default,,0,0,0,,Маған осыншама көп нәрсені айтып берсеңіз жақсы болар еді.
Dialogue: 0,0:11:50.58,0:11:53.04,Default,,0,0,0,,Хмм... Сіз қалай жауап бердіңіз.
Dialogue: 0,0:11:54.13,0:11:56.75,Default,,0,0,0,,Бұл жерде шыншылдықпен сабақ беру қызық емес.
Dialogue: 0,0:11:57.17,0:11:59.00,Default,,0,0,0,,Жеңілсем жақсы ма? а…
Dialogue: 0,0:11:59.17,0:12:02.55,Default,,0,0,0,,Енді сіз табиғи жауыңызбен күресуіңіз керек.
Dialogue: 0,0:12:03.63,0:12:06.22,Default,,0,0,0,,Мына кісінің жүзі осындай...
Dialogue: 0,0:12:06.68,0:12:10.18,Default,,0,0,0,,Хехехе-Олай қорқытпа.
Dialogue: 0,0:12:10.56,0:12:12.77,Default,,0,0,0,,Жарайды, сұрақтарға жауап берейік.
Dialogue: 0,0:12:13.19,0:12:13.77,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:14.48,0:12:15.27,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:12:16.19,0:12:19.07,Default,,0,0,0,,Оның орнына мен сенен бір тілегіңді орындауыңды өтінемін.
Dialogue: 0,0:12:19.44,0:12:20.61,Default,,0,0,0,,(Кондуктор) Сен, сол жерде тұр! Ей! Қауіпті!
Dialogue: 0,0:12:20.94,0:12:22.28,Default,,0,0,0,,Түсіндім, сонда...
Dialogue: 0,0:12:22.49,0:12:23.61,Default,,0,0,0,,Әрине жоқ.
Dialogue: 0,0:12:23.78,0:12:24.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:24.66,0:12:26.45,Default,,0,0,0,,Адамзатты қорғайтын патша...
Dialogue: 0,0:12:26.62,0:12:29.29,Default,,0,0,0,,Менің мұндай ұсынысты қабылдауға мүмкіндігім жоқ!
Dialogue: 0,0:12:30.79,0:12:33.12,Default,,0,0,0,,Қызықсыз, қызығушылық жоғалтты
Dialogue: 0,0:12:33.66,0:12:35.58,Default,,0,0,0,,Егер сіз ойыңызды өзгертсеңіз, қайтып келіңіз.
Dialogue: 0,0:12:38.13,0:12:42.13,Default,,0,0,0,,Неліктен бас тарттыңыз? Бұл тамаша мүмкіндік болды.
Dialogue: 0,0:12:42.88,0:12:43.80,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:12:44.34,0:12:46.93,Default,,0,0,0,,Қалыпты жағдайда өзін дұрыс ұста.
Dialogue: 0,0:12:47.14,0:12:49.81,Default,,0,0,0,,Шынымен келгенде, бұл өте өрескел.
Dialogue: 0,0:12:50.43,0:12:52.56,Default,,0,0,0,,Маған не болды?
Dialogue: 0,0:12:52.98,0:12:54.64,Default,,0,0,0,,Афинамен мәмілеңізді мұқият ойластырыңыз...
Dialogue: 0,0:12:54.81,0:12:56.27,Default,,0,0,0,,Мацуровану Құдайына қарсы -
Dialogue: 0,0:12:56.44,0:12:59.15,Default,,0,0,0,,Байқамай берілген кепіл өлімге әкеледі.
Dialogue: 0,0:12:59.69,0:13:01.48,Default,,0,0,0,,Егер бұл Афина сияқты құдай болса...
Dialogue: 0,0:13:01.65,0:13:03.82,Default,,0,0,0,,Кампион да ерекшелік емес!
Dialogue: 0,0:13:04.15,0:13:06.07,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:06.66,0:13:09.12,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:13:09.28,0:13:10.78,Default,,0,0,0,,Иә? (Құдай) Сіз ертерек құтқарылдыңыз.
Dialogue: 0,0:13:10.95,0:13:14.50,Default,,0,0,0,,А... рыцарь патшаға оғаш нәрсе айтты.
Dialogue: 0,0:13:14.87,0:13:17.08,Default,,0,0,0,,Найзағай императоры сияқты патшаның барлық қаһары менде...
Dialogue: 0,0:13:17.25,0:13:19.63,Default,,0,0,0,,Сіз мұны шынымен тоқтатуыңыз керек.
Dialogue: 0,0:13:20.09,0:13:22.42,Default,,0,0,0,,Мен онша үлкен адам емеспін.
Dialogue: 0,0:13:22.59,0:13:24.84,Default,,0,0,0,,Ку… Году Кусанаги
Dialogue: 0,0:13:25.26,0:13:27.68,Default,,0,0,0,,Иә? Лилиана-сан!
Dialogue: 0,0:13:28.39,0:13:31.60,Default,,0,0,0,,Неліктен менің жасаған істерім әрқашан кері нәтиже береді?
Dialogue: 0,0:13:31.76,0:13:32.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:32.06,0:13:32.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:32.06,0:13:32.64,Default,,0,0,0,,Егер бұл Эрика болса...
Dialogue: 0,0:13:32.64,0:13:33.35,Default,,0,0,0,,Егер бұл Эрика болса...
Dialogue: 0,0:13:33.56,0:13:35.85,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:13:36.10,0:13:39.36,Default,,0,0,0,,Оның үстіне, менің ұят хоббиім де бұрын белгілі болды...
Dialogue: 0,0:13:39.77,0:13:43.03,Default,,0,0,0,,Шынымен... Мен... Уф...
Dialogue: 0,0:13:43.23,0:13:45.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:45.36,0:13:47.36,Default,,0,0,0,,Лилиана-сан, кеттік.
Dialogue: 0,0:13:47.53,0:13:49.53,Default,,0,0,0,,Аа... ааа
Dialogue: 0,0:13:53.08,0:13:54.54,Default,,0,0,0,,Иә, Лилиана.
Dialogue: 0,0:13:54.91,0:13:57.12,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:13:58.54,0:13:59.54,Default,,0,0,0,,Дәмді
Dialogue: 0,0:13:59.75,0:14:01.79,Default,,0,0,0,,Көңіл-күйіңіз көтерілген сияқты.
Dialogue: 0,0:14:02.09,0:14:04.05,Default,,0,0,0,,Маған бала сияқты қарама
Dialogue: 0,0:14:04.21,0:14:06.55,Default,,0,0,0,,Ахаха кешіріңіз кешіріңіз
Dialogue: 0,0:14:06.72,0:14:07.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:08.76,0:14:11.22,Default,,0,0,0,,Маған неге көңіл бөлесің?
Dialogue: 0,0:14:11.76,0:14:12.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:12.89,0:14:16.56,Default,,0,0,0,,Мені ренжітуі табиғи емес пе?
Dialogue: 0,0:14:16.73,0:14:18.39,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:14:18.81,0:14:21.90,Default,,0,0,0,,Мен патша болсам да, жалғыз өзім ештеңе істей алмаймын.
Dialogue: 0,0:14:22.57,0:14:25.40,Default,,0,0,0,,Осылайша Лилиана, Эрика және Мария да...
Dialogue: 0,0:14:25.57,0:14:28.07,Default,,0,0,0,,Менде бәрі жақсы, себебі маған көмек келіп жатыр.
Dialogue: 0,0:14:28.90,0:14:31.66,Default,,0,0,0,,Мен де бәріне қамқор болғым келеді.
Dialogue: 0,0:14:31.95,0:14:33.08,Default,,0,0,0,,Міне
Dialogue: 0,0:14:33.62,0:14:34.66,Default,,0,0,0,,Ах... ха
Dialogue: 0,0:14:34.91,0:14:37.87,Default,,0,0,0,,Ха, сондықтан... айналаңыздағыларға қамқорлық.
Dialogue: 0,0:14:38.29,0:14:40.67,Default,,0,0,0,,Мұны тіпті шайқаста есте сақтағаныңызды қалаймын.
Dialogue: 0,0:14:40.83,0:14:43.00,Default,,0,0,0,,А-а... Ауырған жеріңді ұрамын.
Dialogue: 0,0:14:43.25,0:14:44.42,Default,,0,0,0,,(Году/Лилиананың күлкісі)
Dialogue: 0,0:14:44.75,0:14:46.92,Default,,0,0,0,,Жүр, уақытымыз жоқ.
Dialogue: 0,0:14:47.13,0:14:50.26,Default,,0,0,0,,Қалай болғанда да, Персейге қарсы тұрудың жолдарын қарастырайық.
Dialogue: 0,0:14:50.80,0:14:52.55,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,0:14:52.89,0:14:53.47,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:14:54.26,0:14:55.26,Default,,0,0,0,,Ах, дұрыс
Dialogue: 0,0:14:55.60,0:14:58.93,Default,,0,0,0,,Романдарды хобби ретінде жазуда ұят ештеңе жоқ.
Dialogue: 0,0:14:59.14,0:15:01.77,Default,,0,0,0,,Менің ойымша, мұндай нәрсе өте керемет.
Dialogue: 0,0:15:02.44,0:15:04.19,Default,,0,0,0,,Жоқ! Не...
Dialogue: 0,0:15:04.48,0:15:06.61,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:06.78,0:15:08.74,Default,,0,0,0,,А, а... ә?
Dialogue: 0,0:15:08.90,0:15:09.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:14.16,0:15:17.04,Default,,0,0,0,,Ендеше, бүгін кеште ләззат алыңыз.
Dialogue: 0,0:15:17.20,0:15:18.29,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:15:24.96,0:15:25.92,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:30.63,0:15:31.43,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:15:31.88,0:15:32.55,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:33.14,0:15:36.89,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:15:37.14,0:15:38.64,Default,,0,0,0,,Ух... Уау (әйел) Ах!
Dialogue: 0,0:15:39.02,0:15:39.89,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:40.06,0:15:42.48,Default,,0,0,0,,Қазірдің өзінде! (Ер) Фуфуфуфуфу
Dialogue: 0,0:15:43.73,0:15:46.40,Default,,0,0,0,,Қай қала сізге көбірек әсер қалдырды?
Dialogue: 0,0:15:48.36,0:15:49.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:49.65,0:15:51.61,Default,,0,0,0,,На... Наполи.
Dialogue: 0,0:15:52.66,0:15:54.24,Default,,0,0,0,,А... иә...
Dialogue: 0,0:15:54.41,0:15:56.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:58.87,0:16:01.83,Default,,0,0,0,,Осындай уақытта мен не жазып отырмын?
Dialogue: 0,0:16:03.37,0:16:04.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:04.67,0:16:07.34,Default,,0,0,0,,Мендік бол, Лилиана.
Dialogue: 0,0:16:07.54,0:16:08.67,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:16:09.00,0:16:12.01,Default,,0,0,0,,Иә, одан да байыпты қарсылық көрсетіп көріңіз.
Dialogue: 0,0:16:12.38,0:16:15.18,Default,,0,0,0,,Неліктен? Қарап тұрғанның өзі маған қатты әсер етеді...
Dialogue: 0,0:16:16.01,0:16:17.35,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,0:16:18.22,0:16:19.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:20.10,0:16:20.85,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:21.06,0:16:22.35,Default,,0,0,0,,Не… не болды? Лилиана-сан
Dialogue: 0,0:16:22.56,0:16:23.35,Default,,0,0,0,,Га?
Dialogue: 0,0:16:23.73,0:16:26.36,Default,,0,0,0,,Жоқ... Жоқ, бұл ештеңе емес.
Dialogue: 0,0:16:26.52,0:16:28.69,Default,,0,0,0,,А... бұл мүлде дұрыс емес.
Dialogue: 0,0:16:30.36,0:16:32.61,Default,,0,0,0,,Году-чанның уақыты келді!
Dialogue: 0,0:16:33.03,0:16:35.03,Default,,0,0,0,,Ерте тұрмасаң, кешігесің.
Dialogue: 0,0:16:35.20,0:16:36.32,Default,,0,0,0,,Хм~
Dialogue: 0,0:16:36.66,0:16:38.53,Default,,0,0,0,,Мені сүйсең, мен оянамын
Dialogue: 0,0:16:38.87,0:16:39.95,Default,,0,0,0,,Поцелу?
Dialogue: 0,0:16:40.41,0:16:44.04,Default,,0,0,0,,Жарайды, Году-чан, менің амалым жоқ.
Dialogue: 0,0:16:44.46,0:16:45.37,Default,,0,0,0,,Хм~
Dialogue: 0,0:16:45.58,0:16:46.33,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:16:46.54,0:16:48.54,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:48.92,0:16:50.55,Default,,0,0,0,,Мм... Лилиана?
Dialogue: 0,0:16:50.75,0:16:51.88,Default,,0,0,0,,Иә? иә
Dialogue: 0,0:16:52.46,0:16:56.55,Default,,0,0,0,,А... жарайды, мен Перселлді міндетті түрде жеңемін.
Dialogue: 0,0:16:56.97,0:16:58.97,Default,,0,0,0,,Сондықтан өзіңізді көп кінәламаңыз
Dialogue: 0,0:16:59.30,0:17:01.06,Default,,0,0,0,,Сенің Беттимен қандай қарым-қатынасың бар екен деп ойлаймын
Dialogue: 0,0:17:01.93,0:17:03.56,Default,,0,0,0,,Ах! иә
Dialogue: 0,0:17:04.27,0:17:07.48,Default,,0,0,0,,Кешіріңіз, шамалы жел соғып тұр.
Dialogue: 0,0:17:07.65,0:17:09.06,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:17:10.15,0:17:10.73,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:11.61,0:17:14.40,Default,,0,0,0,,Мен не туралы айтып отырмын?
Dialogue: 0,0:17:15.24,0:17:16.24,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:18.78,0:17:22.66,Default,,0,0,0,,Мен жалбыздан шай дайындадым. Біраз алайық. өтінемін
Dialogue: 0,0:17:22.95,0:17:25.04,Default,,0,0,0,,Ах, рахмет...
Dialogue: 0,0:17:25.66,0:17:27.17,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:17:27.46,0:17:31.25,Default,,0,0,0,,Бұл не... бұл... менің денем... жансыз...
Dialogue: 0,0:17:31.42,0:17:33.42,Default,,0,0,0,,Өйткені, ауызша қабылданса...
Dialogue: 0,0:17:33.59,0:17:35.76,Default,,0,0,0,,Magic Campione-де де жұмыс істейді.
Dialogue: 0,0:17:36.09,0:17:38.93,Default,,0,0,0,,Уф Лилиана...
Dialogue: 0,0:17:39.14,0:17:40.68,Default,,0,0,0,,Біраз уақыт үзіліс жасаңыз.
Dialogue: 0,0:17:41.01,0:17:41.76,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:17:41.97,0:17:43.77,Default,,0,0,0,,Мен мұны бұрын айттым...
Dialogue: 0,0:17:43.97,0:17:45.93,Default,,0,0,0,,Афинамен мәміле жаман емес.
Dialogue: 0,0:17:46.69,0:17:48.94,Default,,0,0,0,,Егер сіздің сауда чипіңіз сіз болмасаңыз
Dialogue: 0,0:17:49.10,0:17:49.69,Default,,0,0,0,,А...
Dialogue: 0,0:17:50.11,0:17:52.44,Default,,0,0,0,,Мен міндетті түрде Персей туралы ақпаратты қайтарамын.
Dialogue: 0,0:17:52.65,0:17:54.11,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:55.28,0:17:56.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:56.99,0:17:58.28,Default,,0,0,0,,Хахаха
Dialogue: 0,0:17:58.61,0:17:59.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:00.45,0:18:01.28,Default,,0,0,0,,Фуфу
Dialogue: 0,0:18:03.16,0:18:05.12,Default,,0,0,0,,Уф, айналаңа абай бол.
Dialogue: 0,0:18:09.21,0:18:10.29,Default,,0,0,0,,Афина құдайы
Dialogue: 0,0:18:10.79,0:18:12.54,Default,,0,0,0,,Мен саған дұға етемін
Dialogue: 0,0:18:13.13,0:18:15.80,Default,,0,0,0,,Персей құдайында қандай логика болды?
Dialogue: 0,0:18:15.96,0:18:16.97,Default,,0,0,0,,Году Кусанагидің беделі...
Dialogue: 0,0:18:17.17,0:18:19.80,Default,,0,0,0,,Мен сізге бұл үшін төлеуге болатын баға бар екенін айттым.
Dialogue: 0,0:18:20.14,0:18:23.39,Default,,0,0,0,,Сіздің орныңызда күресетін Году Кусанагиге...
Dialogue: 0,0:18:23.56,0:18:25.47,Default,,0,0,0,,Оны сыйлық ретінде қабылдаңыз.
Dialogue: 0,0:18:25.68,0:18:29.65,Default,,0,0,0,,Сонда мен әлгі бұзық адамды өлтірсем болғаны.
Dialogue: 0,0:18:29.81,0:18:30.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:30.81,0:18:33.15,Default,,0,0,0,,Әй, бұл да құдайдың келісімі.
Dialogue: 0,0:18:33.73,0:18:38.07,Default,,0,0,0,,Енді ежелгі Шығыс қожайындарымен қалай бетпе-бет келуіміз керек?
Dialogue: 0,0:18:38.24,0:18:39.74,Default,,0,0,0,,Году Кусанаги
Dialogue: 0,0:18:39.91,0:18:42.16,Default,,0,0,0,,Көне Шығыс шебері...
Dialogue: 0,0:18:43.08,0:18:45.16,Default,,0,0,0,,Жарқыраған сары жарық
Dialogue: 0,0:18:45.83,0:18:47.08,Default,,0,0,0,,Күннің фрагменті
Dialogue: 0,0:18:47.50,0:18:49.00,Default,,0,0,0,,Күн сәулесі
Dialogue: 0,0:18:49.54,0:18:50.29,Default,,0,0,0,,Ha
Dialogue: 0,0:18:50.83,0:18:52.00,Default,,0,0,0,,А... иә?
Dialogue: 0,0:18:52.71,0:18:55.17,Default,,0,0,0,,Сөз рухынан аян алдың ба?
Dialogue: 0,0:18:55.71,0:18:59.17,Default,,0,0,0,,Енді мен оны оған қайтаруым керек пе?
Dialogue: 0,0:18:59.38,0:19:00.47,Default,,0,0,0,,Ах
Dialogue: 0,0:19:01.51,0:19:03.51,Default,,0,0,0,,Ха...
Dialogue: 0,0:19:05.26,0:19:06.10,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:19:06.52,0:19:07.35,Default,,0,0,0,,Уф
Dialogue: 0,0:19:10.23,0:19:11.52,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:19:12.02,0:19:14.82,Default,,0,0,0,,Өзімізді сыйламағанымыз үшін құдайдың жазасын аламыз ба?
Dialogue: 0,0:19:15.90,0:19:18.03,Default,,0,0,0,,Ах! (Құдай) Оны қалдырыңыз.
Dialogue: 0,0:19:18.78,0:19:21.45,Default,,0,0,0,,(Құдайдың ауыр тыныс алуы)
Dialogue: 0,0:19:22.03,0:19:23.70,Default,,0,0,0,,Году Кусанаги Неліктен?
Dialogue: 0,0:19:24.03,0:19:27.20,Default,,0,0,0,,Оны жіберіңіз, мен келісімді аламын.
Dialogue: 0,0:19:27.37,0:19:30.16,Default,,0,0,0,,А... Әлі кеш, Году Құсанаги
Dialogue: 0,0:19:30.54,0:19:33.88,Default,,0,0,0,,Егер шағымыңыз болса, мен сізге тағы да ұрысамын.
Dialogue: 0,0:19:34.17,0:19:38.71,Default,,0,0,0,,Бірақ таусылған денеммен Персейді жеңе аламын ба деп ойлаймын?
Dialogue: 0,0:19:38.96,0:19:40.22,Default,,0,0,0,,Көп емес, бірақ… міне.
Dialogue: 0,0:19:40.76,0:19:42.72,Default,,0,0,0,,Хмм... солай болуы керек.
Dialogue: 0,0:19:43.39,0:19:45.22,Default,,0,0,0,,Мен сізге тағы бір нәрсені үйретуге рұқсат етіңіз.
Dialogue: 0,0:19:45.39,0:19:45.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:46.10,0:19:49.47,Default,,0,0,0,,Оны Шығыстың күн құдайымен не байланыстырды?
Dialogue: 0,0:19:49.64,0:19:52.56,Default,,0,0,0,,Сіздің ізашарларыңыз, Империя халқы.
Dialogue: 0,0:19:52.73,0:19:54.40,Default,,0,0,0,,Ха империясы?
Dialogue: 0,0:19:54.61,0:19:56.40,Default,,0,0,0,,Демек, бұл грек құдайы емес.
Dialogue: 0,0:19:56.61,0:19:57.57,Default,,0,0,0,,Сенің әрекетің тым балалық… немесе жай ғана қысқа көзді.
Dialogue: 0,0:19:57.73,0:19:59.57,Default,,0,0,0,,Хаха бұл жақсы...
Dialogue: 0,0:19:59.90,0:20:00.99,Default,,0,0,0,,Әй, Құсанағы...
Dialogue: 0,0:20:03.32,0:20:03.91,Default,,0,0,0,,Ах
Dialogue: 0,0:20:04.24,0:20:07.74,Default,,0,0,0,,Келесі жолы мен сені шайқас аяқталғаннан кейін көремін.
Dialogue: 0,0:20:08.12,0:20:10.25,Default,,0,0,0,,Мен саған берген уәдемді ешқашан ұмытпаймын
Dialogue: 0,0:20:10.62,0:20:11.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:12.12,0:20:13.42,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:20:13.87,0:20:14.88,Default,,0,0,0,,Спидвегон, мен мұнда келдім —
Dialogue: 0,0:20:17.25,0:20:19.05,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:20:19.59,0:20:21.59,Default,,0,0,0,,Хаха, бұл сәл артық болды...
Dialogue: 0,0:20:21.76,0:20:23.76,Default,,0,0,0,,Не... аа!
Dialogue: 0,0:20:24.47,0:20:25.05,Default,,0,0,0,,​​О?
Dialogue: 0,0:20:25.39,0:20:27.05,Default,,0,0,0,,(Құдайдың ұйқысы)
Dialogue: 0,0:20:27.47,0:20:28.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:29.10,0:20:29.85,Default,,0,0,0,,Фуфу
Dialogue: 0,0:20:35.10,0:20:36.06,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:20:36.31,0:20:39.78,Default,,0,0,0,,Хеллионның сиқырлы күші мені осы уақытқа дейін ұшырды.
Dialogue: 0,0:20:39.98,0:20:42.53,Default,,0,0,0,,Бірақ сонда сендер сонда боласыңдар, солай ма?
Dialogue: 0,0:20:43.11,0:20:46.45,Default,,0,0,0,,Году жалғыз қалса да, ол бәрібір Құдаймен айналысады.
Dialogue: 0,0:20:46.82,0:20:48.20,Default,,0,0,0,,OK аяқталды
Dialogue: 0,0:20:48.49,0:20:50.79,Default,,0,0,0,,Өте жаман. Ол жігіт шынымен ақылынан адасып бара жатыр.
Dialogue: 0,0:20:50.95,0:20:53.25,Default,,0,0,0,,Мұның бәрі сіздің қолыңыздан болды, солай емес пе?
Dialogue: 0,0:20:53.41,0:20:54.46,Default,,0,0,0,,Нфуфу~
Dialogue: 0,0:20:54.79,0:20:58.13,Default,,0,0,0,,Не... сіз не ойлап отырсыз, сэр Сальваторе?
Dialogue: 0,0:20:58.29,0:20:59.96,Default,,0,0,0,,Құсанағы мырзаға барамыз...
Dialogue: 0,0:21:00.17,0:21:01.96,Default,,0,0,0,,Сен кетсең ұят болар еді.
Dialogue: 0,0:21:02.13,0:21:03.72,Default,,0,0,0,,Сенің көмегің болса...
Dialogue: 0,0:21:03.88,0:21:05.88,Default,,0,0,0,,Бұл Году деңгейін көтермейді, солай ма?
Dialogue: 0,0:21:06.80,0:21:08.39,Default,,0,0,0,,Сонымен, аздаған өкілеттікпен...
Dialogue: 0,0:21:09.05,0:21:12.10,Default,,0,0,0,,Бұл аймақтың өркениет деңгейі төмендеді.
Dialogue: 0,0:21:12.81,0:21:14.48,Default,,0,0,0,,Қандай ақымақтық...
Dialogue: 0,0:21:14.64,0:21:16.73,Default,,0,0,0,,Ал, келесі кезек сенде.
Dialogue: 0,0:21:16.90,0:21:18.98,Default,,0,0,0,,Ха... күте тұрыңыз!
Dialogue: 0,0:21:19.15,0:21:21.07,Default,,0,0,0,,Патша болсаң, соған лайықсың...
Dialogue: 0,0:21:21.23,0:21:22.15,Default,,0,0,0,,Жарайды, ауырмайды.
Dialogue: 0,0:21:22.36,0:21:24.99,Default,,0,0,0,,Кэмпион күткендей.
Dialogue: 0,0:21:25.15,0:21:26.15,Default,,0,0,0,,Жоқ, ә...
Dialogue: 0,0:21:26.32,0:21:29.41,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:21:29.74,0:21:33.16,Default,,0,0,0,,Хмм, жарайды, сал мүлдем кетті.
Dialogue: 0,0:21:33.37,0:21:36.00,Default,,0,0,0,,Бұл шынымен де ақымақтық Кампион.
Dialogue: 0,0:21:36.21,0:21:38.42,Default,,0,0,0,,Сиыр мен жылқы да жарты күн қозғала алмайды.
Dialogue: 0,0:21:38.58,0:21:40.34,Default,,0,0,0,,Маған ол затты ішуге мәжбүрлеме.
Dialogue: 0,0:21:41.09,0:21:42.34,Default,,0,0,0,,Ах... (Құдай) Ха.
Dialogue: 0,0:21:45.72,0:21:48.64,Default,,0,0,0,,Жараларың жазылып кеткен сияқты, жас құдай өлтіруші.
Dialogue: 0,0:21:48.80,0:21:49.34,Default,,0,0,0,,Ах
Dialogue: 0,0:21:49.72,0:21:51.76,Default,,0,0,0,,Мен де әйтеуір сауығып кеттім.
Dialogue: 0,0:21:51.93,0:21:53.85,Default,,0,0,0,,Бүгінгі түнде ай әдемі
Dialogue: 0,0:21:54.22,0:21:55.02,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:55.23,0:21:58.35,Default,,0,0,0,,Осы жердегі ең көрнекті жерде тағы кездескенше!
Dialogue: 0,0:22:00.23,0:22:03.23,Default,,0,0,0,,♪～
Dialogue: 0,0:23:26.27,0:23:29.28,Default,,0,0,0,,～♪
