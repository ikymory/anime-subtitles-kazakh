Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.18,0:00:16.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:16.34,0:00:19.68,Default,,0,0,0,,Мацумура! Мацумура!
Dialogue: 0,0:00:21.98,0:00:24.10,Default,,0,0,0,,Уф Мацумура!
Dialogue: 0,0:00:24.31,0:00:25.60,Default,,0,0,0,,(Мацумураның ыңырануы)
Dialogue: 0,0:00:25.98,0:00:27.94,Default,,0,0,0,,Мацумура!
Dialogue: 0,0:00:28.94,0:00:31.40,Default,,0,0,0,,Қарғыс атсын, мені жібер!
Dialogue: 0,0:00:31.53,0:00:32.15,Default,,0,0,0,,Гуах
Dialogue: 0,0:00:32.94,0:00:34.15,Default,,0,0,0,,Ахххх
Dialogue: 0,0:00:34.28,0:00:35.74,Default,,0,0,0,,Фудзита... (Фудзита) Ах.
Dialogue: 0,0:00:35.86,0:00:37.24,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:00:37.37,0:00:39.53,Default,,0,0,0,,Сенің аузыңда басқа біреу бар.
Dialogue: 0,0:00:46.25,0:00:48.54,Default,,0,0,0,,Сіз басқасыз (Мацумура) Иә?
Dialogue: 0,0:00:48.88,0:00:52.76,Default,,0,0,0,,Кууууууууууууууу!
Dialogue: 0,0:00:55.38,0:00:56.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:56.26,0:00:58.22,Default,,0,0,0,,А... бұл жұмыс істемей ме?
Dialogue: 0,0:00:59.39,0:01:01.18,Default,,0,0,0,,Гияаааааааааааааааааааа
Dialogue: 0,0:01:03.93,0:01:05.31,Default,,0,0,0,,Гухаа
Dialogue: 0,0:01:08.52,0:01:09.40,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:01:09.86,0:01:12.65,Default,,0,0,0,,Еееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:01:13.03,0:01:14.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:14.28,0:01:17.03,Default,,0,0,0,,Не айтып тұрғаныңды білмеймін, Қайман.
Dialogue: 0,0:01:17.66,0:01:19.03,Default,,0,0,0,,Бухаха
Dialogue: 0,0:01:21.03,0:01:22.12,Default,,0,0,0,,Эй (Мацумура) Ах.
Dialogue: 0,0:01:22.74,0:01:24.50,Default,,0,0,0,,Ішіндегі жігіт не деді?
Dialogue: 0,0:01:24.79,0:01:28.50,Default,,0,0,0,,Не? «Сен басқасың»
Dialogue: 0,0:01:30.29,0:01:34.26,Default,,0,0,0,,Түсіндім, иә... сонда.
Dialogue: 0,0:01:37.18,0:01:38.01,Default,,0,0,0,,Артық емес
Dialogue: 0,0:01:50.73,0:01:52.15,Default,,0,0,0,,Уф, Никайдо! Хаха
Dialogue: 0,0:01:55.99,0:01:58.32,Default,,0,0,0,,Қарғыс атсын! Мен қашып құтылдым
Dialogue: 0,0:01:58.49,0:02:01.07,Default,,0,0,0,,Қат! Мен күзетімді түсірдім
Dialogue: 0,0:02:01.20,0:02:04.41,Default,,0,0,0,,Мен ақымақпын, ақымақпын, ақымақпын...
Dialogue: 0,0:02:04.54,0:02:06.25,Default,,0,0,0,,Ал, сабыр ет.
Dialogue: 0,0:02:06.37,0:02:07.41,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:02:07.87,0:02:11.92,Default,,0,0,0,,Бірақ мен олардың есікті ашқанын бірінші рет көріп тұрмын.
Dialogue: 0,0:02:15.13,0:02:15.92,Default,,0,0,0,,О
Dialogue: 0,0:02:24.01,0:02:29.02,Default,,0,0,0,,♪~
Dialogue: 0,0:03:47.81,0:03:52.81,Default,,0,0,0,,~♪
Dialogue: 0,0:04:06.12,0:04:06.95,Default,,0,0,0,,Уф
Dialogue: 0,0:04:07.08,0:04:12.96,Default,,0,0,0,,(Жәндіктер сиқыршысының гуілдеуі)
Dialogue: 0,0:04:13.75,0:04:18.17,Default,,0,0,0,,Бұл есіктің ар жағында сиқыршылар әлемі бар.
Dialogue: 0,0:04:18.75,0:04:21.42,Default,,0,0,0,,Олар сиқырмен есік жасады...
Dialogue: 0,0:04:21.67,0:04:26.14,Default,,0,0,0,,Біз тұратын «Холл» қалашығы мен олардың әлемін байланыстыру
Dialogue: 0,0:04:45.49,0:04:49.58,Default,,0,0,0,,Аа, бүгін ең жаман күн болды.
Dialogue: 0,0:04:49.70,0:04:51.37,Default,,0,0,0,,Көңіл көтеру
Dialogue: 0,0:04:51.62,0:04:55.16,Default,,0,0,0,,Менің мейрамханамдағы сүйікті шисо жапырақ гиозасы.
Dialogue: 0,0:04:55.29,0:04:56.58,Default,,0,0,0,,Мен оны саған жасап беремін.
Dialogue: 0,0:04:56.71,0:04:58.13,Default,,0,0,0,,Ах~
Dialogue: 0,0:04:58.50,0:05:02.26,Default,,0,0,0,,Ал олар жаттығуға залға келеді.
Dialogue: 0,0:05:03.13,0:05:07.01,Default,,0,0,0,,Оларды оқыту үшін пайдаланылған адамдар саны қайтадан өсті.
Dialogue: 0,0:05:07.72,0:05:13.43,Default,,0,0,0,,Цк, сиқырдың әсерінен бүкіл тесік бұрмаланған.
Dialogue: 0,0:05:30.20,0:05:32.29,Default,,0,0,0,,Иә? Кайман не болды?
Dialogue: 0,0:05:32.74,0:05:34.95,Default,,0,0,0,,Сіз тағы да осы аллеяға қарап тұрсыз ба?
Dialogue: 0,0:05:35.33,0:05:36.41,Default,,0,0,0,,О
Dialogue: 0,0:05:36.62,0:05:40.25,Default,,0,0,0,,Мен бұл жолды жадымнан айырылар алдында көрдім.
Dialogue: 0,0:05:40.38,0:05:42.05,Default,,0,0,0,,Өйткені бұл соңғы көрініс
Dialogue: 0,0:05:43.38,0:05:46.55,Default,,0,0,0,,Ол кезде бұл аллеядағы адам кім болды?
Dialogue: 0,0:05:47.55,0:05:51.55,Default,,0,0,0,,Мен іздеп жүрген адам менің басымды осылай жасады.
Dialogue: 0,0:05:52.31,0:05:53.97,Default,,0,0,0,,Сіз сиқыршысыз ба?
Dialogue: 0,0:05:54.81,0:05:57.77,Default,,0,0,0,,Менің аузымдағы адам өзім бе?
Dialogue: 0,0:05:58.19,0:06:00.94,Default,,0,0,0,,Бұл менің шынайы пішінім ме?
Dialogue: 0,0:06:02.19,0:06:04.36,Default,,0,0,0,,А, тамақ ішейік.
Dialogue: 0,0:06:05.40,0:06:06.49,Default,,0,0,0,,О
Dialogue: 0,0:06:10.53,0:06:12.74,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:06:14.79,0:06:17.75,Default,,0,0,0,,...Мен қатты аштым.
Dialogue: 0,0:06:17.87,0:06:23.00,Default,,0,0,0,,Бірақ мен тағы бір балық бітірмейінше үйге бара алмаймын.
Dialogue: 0,0:06:24.00,0:06:26.01,Default,,0,0,0,,Аа, енді жоқ.
Dialogue: 0,0:06:26.51,0:06:30.84,Default,,0,0,0,,Никайдо, маған тез тамақтануға рұқсат етіңіз.
Dialogue: 0,0:06:31.68,0:06:32.76,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:06:33.18,0:06:34.14,Default,,0,0,0,,Ой
Dialogue: 0,0:06:34.26,0:06:36.89,Default,,0,0,0,,Оххх
Dialogue: 0,0:06:38.27,0:06:40.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:41.27,0:06:43.98,Default,,0,0,0,,Уми~ Ахаха дөңес
Dialogue: 0,0:06:44.48,0:06:49.57,Default,,0,0,0,,Күте тұрыңыз, шебер, мен оны ертең міндетті түрде табамын.
Dialogue: 0,0:07:04.38,0:07:08.26,Default,,0,0,0,,Енді жұмыртқаны қайта туылу үмітіне қойыңыз.
Dialogue: 0,0:07:11.26,0:07:14.05,Default,,0,0,0,,Мацумура… Кешіріңіз.
Dialogue: 0,0:07:21.35,0:07:23.31,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:23.44,0:07:25.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:25.27,0:07:27.40,Default,,0,0,0,,Смоук мырза, бір сәт қарсы боласыз ба?
Dialogue: 0,0:07:27.73,0:07:31.78,Default,,0,0,0,,Фудзита Мацумура қайтыс болған сияқты...
Dialogue: 0,0:07:33.36,0:07:37.03,Default,,0,0,0,,Залдағы жігіттер мені ұрады деп ойламаппын...
Dialogue: 0,0:07:38.12,0:07:40.41,Default,,0,0,0,,Бұл шындық болуы мүмкін емес, солай ма?
Dialogue: 0,0:07:40.83,0:07:42.87,Default,,0,0,0,,Жоқ, бұл рас.
Dialogue: 0,0:07:43.00,0:07:45.25,Default,,0,0,0,,Жерлеу рәсімі жақында ғана аяқталды.
Dialogue: 0,0:07:46.67,0:07:50.13,Default,,0,0,0,,Сіз жерлеуге арналған аяқ киіміңізбен қайда барасыз?
Dialogue: 0,0:07:50.47,0:07:51.97,Default,,0,0,0,,Кінәлілер – қос адам.
Dialogue: 0,0:07:52.09,0:07:56.39,Default,,0,0,0,,Бірі – әйел, екіншісі – кесіртке басы үлкен кісі.
Dialogue: 0,0:07:56.51,0:07:59.89,Default,,0,0,0,,Неге екені белгісіз, сиқыр ол адамға әсер етпеді.
Dialogue: 0,0:08:00.14,0:08:04.06,Default,,0,0,0,,Эй, ол әлдеқашан басқа бір сиқырдың астында қалған шығар.
Dialogue: 0,0:08:04.40,0:08:08.65,Default,,0,0,0,,Сонымен қатар, саусақтарыңыз сынса, сиқырды пайдалана алмайсыз.
Dialogue: 0,0:08:09.28,0:08:13.70,Default,,0,0,0,,Сиқыр жұмыс істемесе, сіз де істей алмайсыз, солай ма?
Dialogue: 0,0:08:14.78,0:08:16.53,Default,,0,0,0,,Себебі менде бір идея бар
Dialogue: 0,0:08:17.28,0:08:21.33,Default,,0,0,0,,Зал... жүректі елжірететін жер екен.
Dialogue: 0,0:08:25.88,0:08:28.04,Default,,0,0,0,,Йо Никайдо ах
Dialogue: 0,0:08:29.96,0:08:31.67,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:31.80,0:08:33.51,Default,,0,0,0,,Никайдо!
Dialogue: 0,0:08:34.05,0:08:37.14,Default,,0,0,0,,Қайман Ондай жерде не істеп жүрсің?
Dialogue: 0,0:08:37.26,0:08:39.14,Default,,0,0,0,,Хехе, бұл толық емес жұмыс күні.
Dialogue: 0,0:08:41.77,0:08:44.52,Default,,0,0,0,,Бұл жәбірленушілер бөлімі емес пе?
Dialogue: 0,0:08:44.98,0:08:48.86,Default,,0,0,0,,Мен емделушіден шебер туралы ақпаратты аламын деп ойладым.
Dialogue: 0,0:08:49.19,0:08:51.03,Default,,0,0,0,,Қазір ешкім жоқ
Dialogue: 0,0:08:51.57,0:08:54.32,Default,,0,0,0,,Менің ойымша, олар жаттығуды тоқтатты.
Dialogue: 0,0:08:54.45,0:08:58.53,Default,,0,0,0,,Біз бірнеше адамды өлтірдік, сондықтан олар да сақ болған шығар.
Dialogue: 0,0:08:58.66,0:09:01.45,Default,,0,0,0,,Сиқыршылар келмесе...
Dialogue: 0,0:09:01.58,0:09:03.75,Default,,0,0,0,,Мен осылай мәңгі қала берем бе?
Dialogue: 0,0:09:03.75,0:09:04.21,Default,,0,0,0,,Мен осылай мәңгі қала берем бе?
Dialogue: 0,0:09:03.75,0:09:04.21,Default,,0,0,0,,Иә
Dialogue: 0,0:09:04.21,0:09:04.33,Default,,0,0,0,,Иә
Dialogue: 0,0:09:04.33,0:09:04.91,Default,,0,0,0,,Иә
Dialogue: 0,0:09:04.33,0:09:04.91,Default,,0,0,0,,Ааа~ Кайман!
Dialogue: 0,0:09:04.91,0:09:05.92,Default,,0,0,0,,Ааа~ Кайман!
Dialogue: 0,0:09:06.04,0:09:08.50,Default,,0,0,0,,Сіз не істеп жатырсыз? Апаттық жағдай
Dialogue: 0,0:09:08.63,0:09:09.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:13.92,0:09:17.89,Default,,0,0,0,,Мутацияға ұшыраған бөліктерге қарағанда, бұл бір шебердің жұмысы сияқты.
Dialogue: 0,0:09:18.01,0:09:21.47,Default,,0,0,0,,О? Бұл шынымен жаман сиқыр.
Dialogue: 0,0:09:21.60,0:09:25.10,Default,,0,0,0,,Бұл жігіт мені жасаған жігіттен ерекше екені сөзсіз.
Dialogue: 0,0:09:25.23,0:09:26.69,Default,,0,0,0,,Ах, көңілім қалды.
Dialogue: 0,0:09:27.35,0:09:31.19,Default,,0,0,0,,Бұл қате болуы керек пе? мағынасыз нәрсе жасау
Dialogue: 0,0:09:31.32,0:09:35.07,Default,,0,0,0,,Мутацияға ұшыраған бөліктің алдында қан ұйып жатыр... Уау.
Dialogue: 0,0:09:35.53,0:09:37.82,Default,,0,0,0,,Қайманды жұлқылау!
Dialogue: 0,0:09:38.11,0:09:40.83,Default,,0,0,0,,Әй, сен ол етті не үшін пайдаланасың?
Dialogue: 0,0:09:40.95,0:09:41.91,Default,,0,0,0,,Бұл чашу
Dialogue: 0,0:09:42.03,0:09:44.70,Default,,0,0,0,,Шар сиу! Ақымақ, жұмыс!
Dialogue: 0,0:09:48.62,0:09:49.71,Default,,0,0,0,,Никайдо!
Dialogue: 0,0:09:50.00,0:09:54.01,Default,,0,0,0,,Мен жұмыстан кейін дүкенге барамын. Өтінемін, мені құтқарыңызшы.
Dialogue: 0,0:09:54.13,0:09:55.42,Default,,0,0,0,,Субару-кун?
Dialogue: 0,0:09:55.55,0:09:58.09,Default,,0,0,0,,Қарамашы, Итата... Уау.
Dialogue: 0,0:09:59.09,0:10:01.85,Default,,0,0,0,,Никайдоның «Аш қателік» дүкені
Dialogue: 0,0:10:01.97,0:10:04.81,Default,,0,0,0,,Ол залдың ортасынан алыс жерде орналасты.
Dialogue: 0,0:10:05.81,0:10:07.60,Default,,0,0,0,,Сол аллеяның жанында
Dialogue: 0,0:10:08.60,0:10:12.57,Default,,0,0,0,,Бұл аймақ сиқыршылардың жиі келетіндігімен танымал.
Dialogue: 0,0:10:12.98,0:10:14.78,Default,,0,0,0,,Сондықтан тұтынушылар аз.
Dialogue: 0,0:10:15.48,0:10:17.36,Default,,0,0,0,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:10:18.20,0:10:21.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.78,0:10:25.41,Default,,0,0,0,,Маған тамақ беріңізші...
Dialogue: 0,0:10:25.54,0:10:26.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:28.33,0:10:29.37,Default,,0,0,0,,А... (Жәндіктер шебері) Қайта толтыр!
Dialogue: 0,0:10:29.71,0:10:33.38,Default,,0,0,0,,Бұл дүкеннің жақсы аты бар. Бұны ұнатамын.
Dialogue: 0,0:10:33.50,0:10:35.25,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:10:35.59,0:10:39.47,Default,,0,0,0,,Бірақ жақсы тамақтанба, сен қайман сияқты жақсысың.
Dialogue: 0,0:10:39.59,0:10:40.76,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:10:41.01,0:10:44.06,Default,,0,0,0,,Сіз, бұл аймақ қауіпті аймақ.
Dialogue: 0,0:10:44.18,0:10:46.72,Default,,0,0,0,,Біз қайдамыз? Мен сені үйге апарып беремін
Dialogue: 0,0:10:47.60,0:10:51.90,Default,,0,0,0,,Қазіргі кезде адамды жәндікке айналдыратын сиқыршылар бар.
Dialogue: 0,0:10:52.02,0:10:57.53,Default,,0,0,0,,Я, жәбірленушіні жаңа көрдім, хаха, жоқ, бұл тағы да...
Dialogue: 0,0:10:57.90,0:11:02.03,Default,,0,0,0,,Бұл өте жаман Ахахха
Dialogue: 0,0:11:03.49,0:11:04.91,Default,,0,0,0,,Нашар орындалды ма?
Dialogue: 0,0:11:05.03,0:11:09.41,Default,,0,0,0,,Әй, бұл мен көрген ең жаман сұмдық.
Dialogue: 0,0:11:09.71,0:11:13.42,Default,,0,0,0,,Мен сондай бейшара сиқыр жасаған адамның жүзін көргім келеді.
Dialogue: 0,0:11:13.54,0:11:15.25,Default,,0,0,0,,Ахаха
Dialogue: 0,0:11:15.67,0:11:16.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:17.63,0:11:19.42,Default,,0,0,0,,Не-чан ах
Dialogue: 0,0:11:20.67,0:11:22.13,Default,,0,0,0,,Ол осылай көрінеді
Dialogue: 0,0:11:22.59,0:11:24.14,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:11:27.93,0:11:30.85,Default,,0,0,0,,Өту жоқ дегеніңіз не?
Dialogue: 0,0:11:30.98,0:11:34.48,Default,,0,0,0,,Залға кіру уақытша жабылды.
Dialogue: 0,0:11:34.61,0:11:38.48,Default,,0,0,0,,Бұл жерден кету де, қайтып оралу да мүмкін емес.
Dialogue: 0,0:11:38.61,0:11:40.19,Default,,0,0,0,,Міне! (Есік күзетшісі) Фудзита мырзаға-
Dialogue: 0,0:11:40.32,0:11:42.91,Default,,0,0,0,,Бізге бастықтан хабарлама келді.
Dialogue: 0,0:11:43.03,0:11:44.32,Default,,0,0,0,,Смоук мырзадан?
Dialogue: 0,0:11:44.87,0:11:48.62,Default,,0,0,0,,Фудзита Қазір ең бірінші не істеу керек?
Dialogue: 0,0:11:48.74,0:11:52.54,Default,,0,0,0,,Мацумураның орнына жаңа серіктес табыңыз.
Dialogue: 0,0:11:53.08,0:11:56.17,Default,,0,0,0,,Бірақ мен мұны да ойладым.
Dialogue: 0,0:11:56.59,0:11:59.34,Default,,0,0,0,,Жау - сиқыры оған әсер етпейтін қиын қарсылас.
Dialogue: 0,0:11:59.80,0:12:01.51,Default,,0,0,0,,Менің зерттеуім бойынша--
Dialogue: 0,0:12:01.63,0:12:05.85,Default,,0,0,0,,Залға барып хабарсыз кеткен оннан астам адам бар.
Dialogue: 0,0:12:06.26,0:12:08.64,Default,,0,0,0,,Бұл олардың ісі шығар.
Dialogue: 0,0:12:09.56,0:12:11.85,Default,,0,0,0,,Сен анау кесірткеге сиқырладың...
Dialogue: 0,0:12:11.98,0:12:14.85,Default,,0,0,0,,Мені тауып алып кел.
Dialogue: 0,0:12:16.15,0:12:18.90,Default,,0,0,0,,Оған жасалған сиқыр ерекше.
Dialogue: 0,0:12:19.02,0:12:19.98,Default,,0,0,0,,Ах
Dialogue: 0,0:12:20.32,0:12:23.99,Default,,0,0,0,,Менің атымды айтсаң бәрібір, мені тауып ал.
Dialogue: 0,0:12:24.70,0:12:27.24,Default,,0,0,0,,Сізде идея бар дедіңіз...
Dialogue: 0,0:12:27.78,0:12:30.24,Default,,0,0,0,,Менің ойымша, ол бәрібір мылтық қолдануды жоспарлаған.
Dialogue: 0,0:12:31.20,0:12:33.00,Default,,0,0,0,,Маған қарама!
Dialogue: 0,0:12:33.12,0:12:34.92,Default,,0,0,0,,Мен сиқыршы болсам да
Dialogue: 0,0:12:35.04,0:12:37.63,Default,,0,0,0,,Егер сіз мақтанышсыз бірдеңе жасасаңыз...
Dialogue: 0,0:12:37.75,0:12:41.01,Default,,0,0,0,,Мен сені өлтіремін, жарайды.
Dialogue: 0,0:12:42.67,0:12:44.01,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:44.76,0:12:48.14,Default,,0,0,0,,Хахахахаха... (Есік нөмірі) Әй?
Dialogue: 0,0:12:48.55,0:12:52.18,Default,,0,0,0,,Хехехе Смоук мырзаның қозғалғанына сенбеймін.
Dialogue: 0,0:12:52.31,0:12:55.90,Default,,0,0,0,,Осылайша Мацумураның жауы міндетті түрде жеңіледі.
Dialogue: 0,0:12:56.35,0:12:58.15,Default,,0,0,0,,Күте тұр, қарғыс атқыр кесіртке.
Dialogue: 0,0:12:58.65,0:13:02.61,Default,,0,0,0,,Ке, бұл дәрігер сағаттық жалақысы төмен арзан коньки.
Dialogue: 0,0:13:02.74,0:13:04.15,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:04.86,0:13:06.24,Default,,0,0,0,,Ха~а
Dialogue: 0,0:13:06.36,0:13:10.66,Default,,0,0,0,,Сергіту үшін бір ыдыс гиоза мен чашу балығын ішейік.
Dialogue: 0,0:13:11.41,0:13:15.54,Default,,0,0,0,,Иә, мен де кәдімгі сыраға тапсырыс беремін.
Dialogue: 0,0:13:16.00,0:13:18.08,Default,,0,0,0,,Сәлем, қош келдіңіз, тұтынушы.
Dialogue: 0,0:13:18.21,0:13:19.92,Default,,0,0,0,,Сіз дәл уақытында келдіңіз.
Dialogue: 0,0:13:20.04,0:13:23.30,Default,,0,0,0,,Сәлден кейін бұл жігіттің бүкіл денесі жәндікке айналады.
Dialogue: 0,0:13:23.55,0:13:25.55,Default,,0,0,0,,Гахаааааа
Dialogue: 0,0:13:25.67,0:13:27.80,Default,,0,0,0,,(Никаидоның жөтелі)
Dialogue: 0,0:13:27.93,0:13:31.47,Default,,0,0,0,,Ха~ Не деген тәртіпсіздік, Никайдо.
Dialogue: 0,0:13:31.60,0:13:34.14,Default,,0,0,0,,Ах! Сіз менің гиозаны жедіңіз!
Dialogue: 0,0:13:34.27,0:13:36.85,Default,,0,0,0,,Уайымдама, мен қазір үйге барамын.
Dialogue: 0,0:13:36.98,0:13:39.23,Default,,0,0,0,,Себебі мен практикалық квотаға қол жеткіздім.
Dialogue: 0,0:13:40.52,0:13:41.98,Default,,0,0,0,,Эй, сен сондай жамансың (Жәндіктер шебері) А?
Dialogue: 0,0:13:42.44,0:13:44.99,Default,,0,0,0,,Ауруханадағы үш адам да сен кінәлі.
Dialogue: 0,0:13:45.32,0:13:48.24,Default,,0,0,0,,Соншалықты жаман...?
Dialogue: 0,0:13:48.82,0:13:50.37,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:13:50.49,0:13:53.04,Default,,0,0,0,,Жүр, оларды өлтіріп, сол үш адамның сиқырын сындыр...
Dialogue: 0,0:13:53.16,0:13:55.29,Default,,0,0,0,,Ауруханадан сыйақы алу
Dialogue: 0,0:13:55.83,0:13:58.87,Default,,0,0,0,,Шулы! Қате болыңыз!
Dialogue: 0,0:14:00.75,0:14:03.71,Default,,0,0,0,,Иә? Эх, аа
Dialogue: 0,0:14:04.67,0:14:07.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:07.47,0:14:09.05,Default,,0,0,0,,Сиқыр жұмыс істемейді
Dialogue: 0,0:14:09.43,0:14:11.43,Default,,0,0,0,,Әйтеуір, мен қазір қашуым керек.
Dialogue: 0,0:14:11.72,0:14:13.81,Default,,0,0,0,,Хихьяххёхё
Dialogue: 0,0:14:13.93,0:14:17.43,Default,,0,0,0,,Ааааааааа!
Dialogue: 0,0:14:17.56,0:14:19.94,Default,,0,0,0,,А? Бұл не деген айқай?
Dialogue: 0,0:14:22.40,0:14:23.44,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:14:33.78,0:14:36.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:39.37,0:14:40.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.79,0:14:41.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:45.17,0:14:46.09,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:14:46.63,0:14:49.13,Default,,0,0,0,,Ішіндегі жігіт не деді?
Dialogue: 0,0:14:49.26,0:14:51.76,Default,,0,0,0,,Әлі кеш пе?
Dialogue: 0,0:14:52.68,0:14:56.72,Default,,0,0,0,,Құдай-ау, тығырыққа тірелді деп ойлап, сақамды жібердім.
Dialogue: 0,0:14:58.02,0:15:00.48,Default,,0,0,0,,Ол мүлде ебедейсіз.
Dialogue: 0,0:15:00.60,0:15:04.48,Default,,0,0,0,,Мен саған көмектескендіктен, неге бүгін кешке мені емдемейсің?
Dialogue: 0,0:15:04.61,0:15:08.24,Default,,0,0,0,,Мен ешқашан ештеңеге ақша төлеген емеспін.
Dialogue: 0,0:15:13.32,0:15:14.49,Default,,0,0,0,,Ах
Dialogue: 0,0:15:14.70,0:15:18.87,Default,,0,0,0,,Ол барлық дерлік шебердің деректерін қамтиды.
Dialogue: 0,0:15:20.54,0:15:23.50,Default,,0,0,0,,Олардың ішінде кімде-кім болса да күдікті болып көрінсе...
Dialogue: 0,0:15:23.63,0:15:25.25,Default,,0,0,0,,Мені өзіңізге әкеліңіз
Dialogue: 0,0:15:25.67,0:15:27.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:27.55,0:15:29.59,Default,,0,0,0,,Иә! рақмет сізге!
Dialogue: 0,0:15:30.47,0:15:34.47,Default,,0,0,0,,Хуаааааааааааааааааааааааааа
Dialogue: 0,0:15:34.60,0:15:36.81,Default,,0,0,0,,Уф
Dialogue: 0,0:15:37.10,0:15:38.56,Default,,0,0,0,,Иә
Dialogue: 0,0:15:39.31,0:15:41.23,Default,,0,0,0,,О-о
Dialogue: 0,0:15:41.48,0:15:44.98,Default,,0,0,0,,Ах! Бүгін сол суретке түскен күн еді.
Dialogue: 0,0:15:46.07,0:15:47.65,Default,,0,0,0,,Оссу Никайдо
Dialogue: 0,0:15:47.78,0:15:49.36,Default,,0,0,0,,Ио, ет тоқаш жегің келе ме?
Dialogue: 0,0:15:49.49,0:15:50.99,Default,,0,0,0,,А, же, же
Dialogue: 0,0:15:52.20,0:15:55.41,Default,,0,0,0,,Аузымдағы адамды жақсы суретке түсіре аламын ба деп ойлаймын
Dialogue: 0,0:15:55.53,0:15:57.74,Default,,0,0,0,,Мен жай көзбен ештеңе көре алмадым.
Dialogue: 0,0:15:58.12,0:16:01.83,Default,,0,0,0,,Бірақ камера рухани нәрселерді түсіреді, солай ма?
Dialogue: 0,0:16:01.96,0:16:05.17,Default,,0,0,0,,Жоқ, бұл рух емес, бұл сиқыр.
Dialogue: 0,0:16:06.38,0:16:09.88,Default,,0,0,0,,Ол сондай әдемі, егер Никайдо оған ғашық болып қалса, мен не істеуім керек?
Dialogue: 0,0:16:10.80,0:16:12.34,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:16:13.84,0:16:15.09,Default,,0,0,0,,Тек болжамға сүйеніп осындай қауіпті тәуекелге бара аламыз ба?
Dialogue: 0,0:16:17.14,0:16:19.26,Default,,0,0,0,,Есімі «Ебісу»
Dialogue: 0,0:16:19.68,0:16:21.39,Default,,0,0,0,,Иә? Күте тұрыңыз, бұл жігіт
Dialogue: 0,0:16:27.19,0:16:31.11,Default,,0,0,0,,Иә! Бір күні ғана ол залда біздің қасымыздан өтті.
Dialogue: 0,0:16:32.65,0:16:34.66,Default,,0,0,0,,Жарайды, бірден қарайық.
Dialogue: 0,0:16:34.78,0:16:38.08,Default,,0,0,0,,Уау~ Мен қатты толқып тұрмын~
Dialogue: 0,0:16:38.41,0:16:40.62,Default,,0,0,0,,Әй, Қайман?
Dialogue: 0,0:16:40.74,0:16:42.66,Default,,0,0,0,,Қараңызшы, иә?
Dialogue: 0,0:16:43.50,0:16:44.96,Default,,0,0,0,,Бұл олардың есігі.
Dialogue: 0,0:16:45.62,0:16:47.04,Default,,0,0,0,,Ол жоғалады, күте тұрыңыз.
Dialogue: 0,0:16:48.29,0:16:50.05,Default,,0,0,0,,Артында біреу бар ма?
Dialogue: 0,0:16:50.67,0:16:53.55,Default,,0,0,0,,Қанша тырыссам да есік ашылмайды.
Dialogue: 0,0:16:53.67,0:16:57.51,Default,,0,0,0,,Бір қызығы, бұл күндері достарымның ешқайсысын залдан әрең көрмеймін.
Dialogue: 0,0:16:57.64,0:16:59.72,Default,,0,0,0,,Онда бірдеңе болды ма?
Dialogue: 0,0:17:00.14,0:17:02.35,Default,,0,0,0,,Сиқыршы сияқты
Dialogue: 0,0:17:02.47,0:17:03.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:03.73,0:17:08.23,Default,,0,0,0,,Сол қаңқаны басынан тістеп алайыншы.
Dialogue: 0,0:17:17.11,0:17:18.07,Default,,0,0,0,,Уф
Dialogue: 0,0:17:18.74,0:17:19.66,Default,,0,0,0,,Бухе
Dialogue: 0,0:17:27.54,0:17:30.79,Default,,0,0,0,,Хм, уф, кел, бетіңді көрсет.
Dialogue: 0,0:17:34.17,0:17:34.88,Default,,0,0,0,,Не!
Dialogue: 0,0:17:35.76,0:17:36.88,Default,,0,0,0,,Ух... хе.
Dialogue: 0,0:17:37.63,0:17:40.93,Default,,0,0,0,,Әй... әйел! ? болды ма?
Dialogue: 0,0:17:41.18,0:17:43.02,Default,,0,0,0,,Біз не істеуіміз керек? кайман
Dialogue: 0,0:17:43.14,0:17:46.52,Default,,0,0,0,,Иә, мен не істеуім керек...
Dialogue: 0,0:17:46.64,0:17:48.15,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:17:48.85,0:17:51.11,Default,,0,0,0,,(Эбисудың үрейлі дауысы)
Dialogue: 0,0:17:51.48,0:17:52.61,Default,,0,0,0,,Құт
Dialogue: 0,0:17:53.03,0:17:55.99,Default,,0,0,0,,Қат! Саған бәрібір?
Dialogue: 0,0:17:56.11,0:17:58.03,Default,,0,0,0,,Ооо!
Dialogue: 0,0:18:01.12,0:18:05.41,Default,,0,0,0,,Ух... у... ха
Dialogue: 0,0:18:07.75,0:18:10.13,Default,,0,0,0,,Біреу... бар ма?
Dialogue: 0,0:18:13.63,0:18:14.51,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,0:18:15.88,0:18:16.88,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:19.18,0:18:19.89,Default,,0,0,0,,Га
Dialogue: 0,0:18:20.05,0:18:21.51,Default,,0,0,0,,Уфф
Dialogue: 0,0:18:21.89,0:18:22.43,Default,,0,0,0,,Уф
Dialogue: 0,0:18:23.01,0:18:24.43,Default,,0,0,0,,Гууууууук
Dialogue: 0,0:18:24.56,0:18:26.52,Default,,0,0,0,,Нгаааа...
Dialogue: 0,0:18:26.64,0:18:29.44,Default,,0,0,0,,Ммм! Апыр-ай!
Dialogue: 0,0:18:29.56,0:18:31.61,Default,,0,0,0,,Ууууууууууу~
Dialogue: 0,0:18:34.02,0:18:36.32,Default,,0,0,0,,Уау уау
Dialogue: 0,0:18:38.95,0:18:40.66,Default,,0,0,0,,Эй, ол жабық!
Dialogue: 0,0:18:41.37,0:18:43.78,Default,,0,0,0,,Жылы…
Dialogue: 0,0:18:44.79,0:18:46.66,Default,,0,0,0,,Бұл жақын қоңырау болды.
Dialogue: 0,0:18:47.04,0:18:49.87,Default,,0,0,0,,А... Фудзита-сама (Фудзита) А?
Dialogue: 0,0:18:54.71,0:18:55.55,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,0:18:59.38,0:19:03.10,Default,,0,0,0,,Мен... Кәдімгі сұрақты қоя алмадым.
Dialogue: 0,0:19:03.93,0:19:04.93,Default,,0,0,0,,О
Dialogue: 0,0:19:06.01,0:19:09.94,Default,,0,0,0,,Аа, дұрыс... Фотоға қарайық. Фото қандай?
Dialogue: 0,0:19:10.27,0:19:11.31,Default,,0,0,0,,О
Dialogue: 0,0:19:17.28,0:19:18.61,Default,,0,0,0,,Қуыс табылды
Dialogue: 0,0:19:18.74,0:19:20.07,Default,,0,0,0,,Қарғыс атсын! Уау
Dialogue: 0,0:19:20.20,0:19:22.57,Default,,0,0,0,,Егер бұл орын алса, бұл өте өкінішті!
Dialogue: 0,0:19:28.04,0:19:31.67,Default,,0,0,0,,(Кайманның дауысы)
Dialogue: 0,0:19:40.88,0:19:42.76,Default,,0,0,0,,Амансың ба? кайман
Dialogue: 0,0:19:42.89,0:19:45.60,Default,,0,0,0,,Ішіп отырып құсу сирек.
Dialogue: 0,0:19:45.72,0:19:49.22,Default,,0,0,0,,Ей, бірдеңе дұрыс емес.
Dialogue: 0,0:19:49.35,0:19:51.06,Default,,0,0,0,,Бір нәрсе... уф
Dialogue: 0,0:19:51.19,0:19:55.11,Default,,0,0,0,,Гуаааааааааа!
Dialogue: 0,0:19:55.23,0:19:56.48,Default,,0,0,0,,Әй, Кайман! ?
Dialogue: 0,0:19:56.86,0:20:01.45,Default,,0,0,0,,(Кайманның ыңырсыуы)
Dialogue: 0,0:20:09.08,0:20:10.00,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:20:10.12,0:20:11.37,Default,,0,0,0,,Эй, Кайман!
Dialogue: 0,0:20:17.00,0:20:19.88,Default,,0,0,0,,О, сен...
Dialogue: 0,0:20:24.38,0:20:25.64,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:20:29.22,0:20:30.56,Default,,0,0,0,,Га
Dialogue: 0,0:20:35.73,0:20:40.82,Default,,0,0,0,,Шүкір, бұл тағы бір арман ғой, о...
Dialogue: 0,0:20:41.94,0:20:46.03,Default,,0,0,0,,Қобалжыған түс күнде түнде осылай болады, сондықтан қорқыныш мүлде жоқ.
Dialogue: 0,0:20:47.53,0:20:51.20,Default,,0,0,0,,Түсімде көрінген адам менің шынайы келбетім ме?
Dialogue: 0,0:20:51.75,0:20:53.87,Default,,0,0,0,,Маған сиқырлаған
Dialogue: 0,0:20:54.41,0:20:56.17,Default,,0,0,0,,Немесе басқа…
Dialogue: 0,0:20:56.46,0:20:58.34,Default,,0,0,0,,Әй, жастықта тікен бар!
Dialogue: 0,0:20:58.46,0:20:59.29,Default,,0,0,0,,Ішек
Dialogue: 0,0:20:59.42,0:21:01.34,Default,,0,0,0,,Гах (қайшы көз) Аххх
Dialogue: 0,0:21:01.96,0:21:02.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:02.97,0:21:05.55,Default,,0,0,0,,Теяааааааааааааааааааааааааа
Dialogue: 0,0:21:10.60,0:21:12.64,Default,,0,0,0,,Нана~цу!
Dialogue: 0,0:21:15.27,0:21:16.23,Default,,0,0,0,,Иә
Dialogue: 0,0:21:17.52,0:21:20.36,Default,,0,0,0,,Сіз қанша қарттарды жинадыңыз?
Dialogue: 0,0:21:21.23,0:21:26.24,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:21:27.45,0:21:29.37,Default,,0,0,0,,Балалар сендер емес-
Dialogue: 0,0:21:30.12,0:21:33.12,Default,,0,0,0,,Мен бүгін өлуді жоспарлаған жоқпын.
Dialogue: 0,0:21:33.58,0:21:37.25,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:21:38.42,0:21:41.25,Default,,0,0,0,,Бірақ бұл сұмдық ой...
Dialogue: 0,0:21:41.67,0:21:44.17,Default,,0,0,0,,Қымбат өмірімді ұстаған
Dialogue: 0,0:21:44.34,0:21:48.18,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:21:48.47,0:21:50.64,Default,,0,0,0,,Әлгі ақымақтар...
Dialogue: 0,0:21:51.01,0:21:53.60,Default,,0,0,0,,Өлме!
Dialogue: 0,0:21:56.02,0:22:01.02,Default,,0,0,0,,♪~
Dialogue: 0,0:23:18.64,0:23:23.65,Default,,0,0,0,,~♪
Dialogue: 0,0:23:33.91,0:23:35.95,Default,,0,0,0,,Жын 2-ден не үйренуге болады
Dialogue: 0,0:23:36.08,0:23:38.62,Default,,0,0,0,,Әлі де хаос
Dialogue: 0,0:23:40.12,0:23:46.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory