Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.29,0:00:16.96,Default,,0,0,0,,<Мен көптен бері абдырап қалдым>
Dialogue: 0,0:00:16.96,0:00:21.13,Default,,0,0,0,,Ойланып қарасаңыз, үйірме жұмыстарында не істейсіз?
Dialogue: 0,0:00:21.13,0:00:24.64,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:00:24.64,0:00:29.51,Default,,0,0,0,,Оркестр... Мен барып тексерейін деп ойладым.
Dialogue: 0,0:00:29.51,0:00:34.65,Default,,0,0,0,,Сіз соншалықты пассивті болсаңыз да, сіздің көңіл-күйіңіз қалай өзгерді?
Dialogue: 0,0:00:34.65,0:00:36.85,Default,,0,0,0,,Бөлек….
Dialogue: 0,0:00:38.45,0:00:43.66,Default,,0,0,0,,Мен жай ғана оркестрге қарағым келді.
Dialogue: 0,0:00:47.16,0:00:51.36,Default,,0,0,0,,<Мен скрипкамен қайта бетпе-бет келуді шештім...>
Dialogue: 0,0:00:56.47,0:01:01.97,Default,,0,0,0,,<Мен болашақта не істегім келетінін нақты түсінбедім>
Dialogue: 0,0:01:03.78,0:01:09.28,Default,,0,0,0,,Не? (Чика Йонезава) Сен! Мен оны Саэки-кунмен ойнай аламын ба деп ойлаймын.
Dialogue: 0,0:01:09.28,0:01:11.28,Default,,0,0,0,,Иә...! ?
Dialogue: 0,0:01:13.29,0:01:16.96,Default,,0,0,0,,<Мен...➡
Dialogue: 0,0:01:16.96,0:01:19.96,Default,,0,0,0,,Сіз қандай болғыңыз келеді? ＞
Dialogue: 0,0:01:22.76,0:01:52.86,Default,,0,0,0,,♬～
Dialogue: 0,0:01:52.86,0:02:02.77,Default,,0,0,0,,♬～
Dialogue: 0,0:02:02.77,0:02:11.48,Default,,0,0,0,,♬～
Dialogue: 0,0:02:14.78,0:02:22.59,Default,,0,0,0,,♬～
Dialogue: 0,0:02:26.29,0:02:29.80,Default,,0,0,0,,♬～
Dialogue: 0,0:02:29.80,0:02:32.63,Default,,0,0,0,,♬～
Dialogue: 0,0:02:32.63,0:02:43.64,Default,,0,0,0,,♬～
Dialogue: 0,0:02:43.64,0:02:51.35,Default,,0,0,0,,♬～
Dialogue: 0,0:02:54.65,0:02:58.16,Default,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,0:02:58.16,0:03:00.96,Default,,0,0,0,,Танысқаныма қуаныштымын, Аоно-кун.
Dialogue: 0,0:03:02.60,0:03:04.90,Default,,0,0,0,,Танысқаныма қуаныштымын...
Dialogue: 0,0:03:06.47,0:03:12.17,Default,,0,0,0,,<Көп адамның алдында ойнамағаныма көп болды...>
Dialogue: 0,0:03:14.27,0:03:17.58,Default,,0,0,0,,<Орта мектептің бірінші курсынан бастап...>
Dialogue: 0,0:03:24.42,0:03:26.62,Default,,0,0,0,,<Жарайды...! ＞
Dialogue: 0,0:03:29.29,0:03:32.49,Default,,0,0,0,,Эх, Саэки мен Аоно! ?
Dialogue: 0,0:03:34.63,0:03:39.80,Default,,0,0,0,,<Бұл жігіттің қандай спектакль ойнайтынын білмеймін...➡
Dialogue: 0,0:03:39.80,0:03:43.60,Default,,0,0,0,,Сәйкес келсе, жарайды...>
Dialogue: 0,0:03:48.98,0:04:01.39,Default,,0,0,0,,♬～
Dialogue: 0,0:04:01.39,0:04:06.23,Default,,0,0,0,,<Бұл жігіт... ол өте жақсы. ➡
Dialogue: 0,0:04:06.23,0:04:10.60,Default,,0,0,0,,Музыкалық партитураны ұқыпты және сенімді түрде сипау. ➡
Dialogue: 0,0:04:10.60,0:04:13.90,Default,,0,0,0,,Жарайды, мен осыған сәйкес келе аламын>
Dialogue: 0,0:04:15.47,0:04:17.47,Default,,0,0,0,,<Күлдіңіз бе...? ＞
Dialogue: 0,0:04:17.47,0:04:21.61,Default,,0,0,0,,♬～
Dialogue: 0,0:04:24.11,0:04:27.15,Default,,0,0,0,,<Ах! Қарғыс атқыр... дыбыстар сәйкес келмейді! ➡
Dialogue: 0,0:04:27.15,0:04:29.92,Default,,0,0,0,,Сіз қарқынды өзгерттіңіз! ➡
Dialogue: 0,0:04:29.92,0:04:34.82,Default,,0,0,0,,Бұл жігіт менімен келіспейді! ? Мен саған ешқашан қарамадым...! ➡
Dialogue: 0,0:04:34.82,0:04:40.13,Default,,0,0,0,,Менің тірлігім сенің көз алдында жоқ дейсің бе... Ей, бейбақ! ＞
Dialogue: 0,0:04:40.13,0:04:43.63,Default,,0,0,0,,Эй, бұл Вивалдиді кім ойнайды?
Dialogue: 0,0:04:43.63,0:04:47.97,Default,,0,0,0,,Мен ұсыныс бойынша бір жылға түскен сияқтымын.
Dialogue: 0,0:04:47.97,0:04:51.84,Default,,0,0,0,,Саэки-кунның өз орны бар.
Dialogue: 0,0:04:51.84,0:04:55.64,Default,,0,0,0,,Аоно-кун да жақсы ойнай алады...
Dialogue: 0,0:04:55.64,0:05:02.45,Default,,0,0,0,,♬～
Dialogue: 0,0:05:02.45,0:05:06.59,Default,,0,0,0,,Неліктен? Ол жігіт мүлде ойнай алмайды...
Dialogue: 0,0:05:06.59,0:05:10.76,Default,,0,0,0,,Екі адамның тынысы бірдей болмағандықтан ойнау қиын емес пе?
Dialogue: 0,0:05:10.76,0:05:14.26,Default,,0,0,0,,<Қарғыс атсын! Спектакльдер мүлдем сәйкес келмейді! ➡
Dialogue: 0,0:05:14.26,0:05:17.76,Default,,0,0,0,,Мен сенімен тіл табысуға тырысамын...➡
Dialogue: 0,0:05:17.76,0:05:22.27,Default,,0,0,0,,Менің бар болуым мүлде жоққа шығарылды! Ойнау өте қиын! ➡
Dialogue: 0,0:05:22.27,0:05:26.61,Default,,0,0,0,,Жарыста бірінші орын алған адамның бұлай ойнауы мүмкін емес. ➡
Dialogue: 0,0:05:26.61,0:05:31.81,Default,,0,0,0,,Бұл дыбыс... мені ашуландырғаны анық! ＞
Dialogue: 0,0:05:34.11,0:05:39.29,Default,,0,0,0,,<Өте жақсы. Егер сіз қаласаңыз...! ＞
Dialogue: 0,0:05:39.29,0:05:58.14,Default,,0,0,0,,♬～
Dialogue: 0,0:05:58.14,0:06:00.57,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:06:00.57,0:06:04.24,Default,,0,0,0,,Бұл төбелес сияқты.
Dialogue: 0,0:06:04.24,0:06:07.08,Default,,0,0,0,,♬～
Dialogue: 0,0:06:07.08,0:06:10.58,Default,,0,0,0,,<Бір-бірімізге берілу ниетіміз жоқ! ➡
Dialogue: 0,0:06:10.58,0:06:15.45,Default,,0,0,0,,Бұл жасырын қойылым. Бірақ...＞
Dialogue: 0,0:06:15.45,0:06:18.26,Default,,0,0,0,,♬～
Dialogue: 0,0:06:18.26,0:06:20.19,Default,,0,0,0,,<Көңілді>
Dialogue: 0,0:06:20.19,0:06:23.10,Default,,0,0,0,,♬～
Dialogue: 0,0:06:23.10,0:06:25.30,Default,,0,0,0,,Біз жындан жаңа мәлімет алдық.
Dialogue: 0,0:06:26.93,0:06:29.97,Default,,0,0,0,,Балалар, қанша уақыт ойнайсыңдар?
Dialogue: 0,0:06:29.97,0:06:32.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:32.10,0:06:36.28,Default,,0,0,0,,＜Жоқ... Мен ренжідім де, ойнадым...＞
Dialogue: 0,0:06:36.28,0:06:38.28,Default,,0,0,0,,Аоно-кун.
Dialogue: 0,0:06:39.95,0:06:43.28,Default,,0,0,0,,Сіздің орындауыңыз өте жақсы болды.
Dialogue: 0,0:06:43.28,0:06:46.62,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:06:46.62,0:06:50.29,Default,,0,0,0,,Саэки-кун да шаршады. үй….
Dialogue: 0,0:06:50.29,0:07:00.93,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:07:00.93,0:07:05.74,Default,,0,0,0,,Мен қатты шошып кеттім! Бұл таңқаларлық болды.
Dialogue: 0,0:07:05.74,0:07:09.07,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:07:09.07,0:07:11.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:11.01,0:07:17.75,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:07:17.75,0:07:21.25,Default,,0,0,0,,＜Кенеттен пайда болған оқиға орнында➡
Dialogue: 0,0:07:21.25,0:07:25.12,Default,,0,0,0,,Мен қандай бет жасау керектігін білмеймін➡
Dialogue: 0,0:07:25.12,0:07:27.93,Default,,0,0,0,,Төмен қарады>
Dialogue: 0,0:07:27.93,0:07:33.40,Default,,0,0,0,,♬～
Dialogue: 0,0:07:33.40,0:07:36.27,Default,,0,0,0,,күрсіну…. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:07:36.27,0:07:39.17,Default,,0,0,0,,А... иә.
Dialogue: 0,0:07:39.17,0:07:44.01,Default,,0,0,0,,＜Мен сенен мұндай бақытты болады деп күтпеп едім...＞
Dialogue: 0,0:07:44.01,0:07:46.98,Default,,0,0,0,,Ах! Ақыры есіме түсті!
Dialogue: 0,0:07:46.98,0:07:49.28,Default,,0,0,0,,№1 елде! ➡
Dialogue: 0,0:07:49.28,0:07:54.62,Default,,0,0,0,,Мен сені бұрын бір жерден көрдім деп ойладым, бірақ сен Хаджиме Аоно екенсің! ➡
Dialogue: 0,0:07:54.62,0:07:57.66,Default,,0,0,0,,Мен оны жасөспірімдер арасындағы жарыста көрдім!
Dialogue: 0,0:07:59.79,0:08:02.23,Default,,0,0,0,,Кім? Атақты?
Dialogue: 0,0:08:02.23,0:08:09.00,Default,,0,0,0,,Аоно? Сіз бозарған сияқтысыз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:08:09.00,0:08:12.37,Default,,0,0,0,,Рюджин Аоно. ➡
Dialogue: 0,0:08:12.37,0:08:16.24,Default,,0,0,0,,Атақты кәсіби скрипкашы бар ғой, солай ма?
Dialogue: 0,0:08:16.24,0:08:18.24,Default,,0,0,0,,Сол бала.
Dialogue: 0,0:08:20.11,0:08:23.12,Default,,0,0,0,,Бұл өте жақсы екені таңқаларлық емес!
Dialogue: 0,0:08:23.12,0:08:27.59,Default,,0,0,0,,Одан гөрі келесі қойылымды бастайық.
Dialogue: 0,0:08:27.59,0:08:31.39,Default,,0,0,0,,Бірақ мен оны теледидардан көрдім➡
Dialogue: 0,0:08:31.39,0:08:36.60,Default,,0,0,0,,Мен скрипкашының...➡ екеніне сенімдімін
Dialogue: 0,0:08:36.60,0:08:39.93,Default,,0,0,0,,Сіздің қарым-қатынасыңыз болған жоқ па?
Dialogue: 0,0:08:39.93,0:08:46.11,Default,,0,0,0,,♬～
Dialogue: 0,0:08:46.11,0:08:50.41,Default,,0,0,0,,Сен маған әкең туралы әңгіме айтып бере аласың ба?
Dialogue: 0,0:08:53.41,0:08:56.62,Default,,0,0,0,,Бұрын менен мектеп қақпасында Аоно туралы сұраған болатын.
Dialogue: 0,0:08:56.62,0:08:58.55,Default,,0,0,0,,Мен де!
Dialogue: 0,0:08:58.55,0:09:09.56,Default,,0,0,0,,♬～
Dialogue: 0,0:09:09.56,0:09:12.46,Default,,0,0,0,,<Ах...➡
Dialogue: 0,0:09:12.46,0:09:16.77,Default,,0,0,0,,Бұл тағы да...>
Dialogue: 0,0:09:18.90,0:09:20.84,Default,,0,0,0,,Ха... иә...!
Dialogue: 0,0:09:20.84,0:09:23.14,Default,,0,0,0,,Төмен Төменге қарамаңыз.
Dialogue: 0,0:09:26.25,0:09:28.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:28.58,0:09:31.48,Default,,0,0,0,,Иә, тек осымен сөйлесу керек!
Dialogue: 0,0:09:31.48,0:09:37.49,Default,,0,0,0,,Мм... онда оны ойнауды басқа біреуден сұрауым керек шығар.
Dialogue: 0,0:09:39.59,0:09:42.59,Default,,0,0,0,,Онда сен барсың!
Dialogue: 0,0:09:45.10,0:09:48.00,Default,,0,0,0,,Мұқият қараңыз!
Dialogue: 0,0:09:48.00,0:09:50.97,Default,,0,0,0,,Аа...
Dialogue: 0,0:09:50.97,0:09:54.77,Default,,0,0,0,,Сіздің атыңыз кім? Бұл Акина.
Dialogue: 0,0:09:54.77,0:09:59.28,Default,,0,0,0,,Сіз скрипкада қанша уақыт ойнайсыз? Жарты жыл болды.
Dialogue: 0,0:09:59.28,0:10:05.15,Default,,0,0,0,,Жарты жыл... Хм, сізде ойнайтын ән бар ма?
Dialogue: 0,0:10:05.15,0:10:10.62,Default,,0,0,0,,«Canon» өтінемін! Жарайды! сен ше?
Dialogue: 0,0:10:10.62,0:10:13.43,Default,,0,0,0,,«Canon» жақсы.
Dialogue: 0,0:10:13.43,0:10:19.73,Default,,0,0,0,,Әй... Бұрынғы айтқаныңыз рас па? Бұл рас. Апта сайынғы журналдың қолында болды.
Dialogue: 0,0:10:22.97,0:10:25.87,Default,,0,0,0,,Аоно-кун….
Dialogue: 0,0:10:25.87,0:10:31.18,Default,,0,0,0,,<Қарғыс атсын... Мен бұл жерден жоғалып кеткім келеді...>
Dialogue: 0,0:10:38.98,0:10:50.16,Default,,0,0,0,,♬～
Dialogue: 0,0:10:50.16,0:10:52.10,Default,,0,0,0,,<Аа...? ＞
Dialogue: 0,0:10:52.10,0:10:55.03,Default,,0,0,0,,♬～
Dialogue: 0,0:10:55.03,0:10:59.84,Default,,0,0,0,,<Ол қалай жақсы ойнады? ＞
Dialogue: 0,0:10:59.84,0:11:03.41,Default,,0,0,0,,♬～
Dialogue: 0,0:11:03.41,0:11:05.94,Default,,0,0,0,,＜Бір кезде...＞
Dialogue: 0,0:11:05.94,0:11:12.42,Default,,0,0,0,,♬～
Dialogue: 0,0:11:12.42,0:11:17.96,Default,,0,0,0,,Себебі мен орта мектепке барып, скрипкада ойнағым келді.
Dialogue: 0,0:11:17.96,0:11:20.79,Default,,0,0,0,,Қазіргі жағымсыз нәрседен көп➡
Dialogue: 0,0:11:20.79,0:11:25.13,Default,,0,0,0,,Мен болашақта қызықты нәрселер туралы ойлана бастадым!
Dialogue: 0,0:11:25.13,0:11:35.64,Default,,0,0,0,,♬～
Dialogue: 0,0:11:35.64,0:11:40.31,Default,,0,0,0,,<Бұл түсініксіз және қауіпті...>
Dialogue: 0,0:11:40.31,0:11:45.18,Default,,0,0,0,,♬～
Dialogue: 0,0:11:45.18,0:11:49.99,Default,,0,0,0,,<Тыңдасам жүрегім лүпілдеген қойылым...>
Dialogue: 0,0:11:49.99,0:11:54.16,Default,,0,0,0,,♬～
Dialogue: 0,0:11:54.16,0:11:57.66,Default,,0,0,0,,<Бірақ мен...➡
Dialogue: 0,0:11:57.66,0:12:02.94,Default,,0,0,0,,Мына жігіттің үні мені құтқарды...>
Dialogue: 0,0:12:02.94,0:12:14.95,Default,,0,0,0,,♬～
Dialogue: 0,0:12:23.29,0:12:27.63,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:12:27.63,0:12:31.96,Default,,0,0,0,,Ха! Мен қатты қобалжыдым!
Dialogue: 0,0:12:31.96,0:12:34.87,Default,,0,0,0,,Еңбектеріңіз үшін рахмет. Бұл өте жақсы ойнады.
Dialogue: 0,0:12:34.87,0:12:37.64,Default,,0,0,0,,Мен әлі де толқудамын!
Dialogue: 0,0:12:37.64,0:12:40.44,Default,,0,0,0,,Қалай болды? Менің орындауым!
Dialogue: 0,0:12:42.14,0:12:46.01,Default,,0,0,0,,Иә... жақсы емес пе?
Dialogue: 0,0:12:46.01,0:12:49.31,Default,,0,0,0,,Дұрыс! Менімен бірге жаттығыңыз➡
Dialogue: 0,0:12:49.31,0:12:52.12,Default,,0,0,0,,Мүмкін сенің кесіріңнен шығар!
Dialogue: 0,0:12:54.65,0:12:58.86,Default,,0,0,0,,Шынымен де... Бұл сенің күшің.
Dialogue: 0,0:13:00.39,0:13:04.26,Default,,0,0,0,,Ал, енді кім ойнайды?
Dialogue: 0,0:13:04.26,0:13:09.94,Default,,0,0,0,,<Содан кейін бірінші сынып оқушылары әрқайсысы өз қабілеттерін көрсетті➡
Dialogue: 0,0:13:09.94,0:13:14.41,Default,,0,0,0,,Шартты түрде тиісінше бірінші және екінші болып анықталды>
Dialogue: 0,0:13:14.41,0:13:20.78,Default,,0,0,0,,♬～
Dialogue: 0,0:13:20.78,0:13:25.58,Default,,0,0,0,,<Мына бала... өте жақсы.>
Dialogue: 0,0:13:27.29,0:13:30.49,Default,,0,0,0,,Иә, солай. Рақмет сізге.
Dialogue: 0,0:13:34.96,0:13:39.10,Default,,0,0,0,,Сонымен, біз бірінші курс студенттерін бөліктерге бөлуді аяқтадық➡
Dialogue: 0,0:13:39.10,0:13:43.30,Default,,0,0,0,,Қалған уақыт 2-ші және 3-ші сынып оқушыларының жаттығуын бақылауға жұмсалады.
Dialogue: 0,0:13:50.98,0:13:54.01,Default,,0,0,0,,Мен үлкендердің өнерін асыға күтемін.
Dialogue: 0,0:13:54.01,0:13:56.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:58.65,0:14:04.76,Default,,0,0,0,,<Бұл Харада мырза, Үтірде үшінші курста оқитын...? ＞
Dialogue: 0,0:14:04.76,0:14:10.10,Default,,0,0,0,,♬～
Dialogue: 0,0:14:10.10,0:14:14.30,Default,,0,0,0,,<Сол қойылымды бүгін жақыннан тыңдай аламын ба...>
Dialogue: 0,0:14:19.81,0:14:24.28,Default,,0,0,0,,Қайда бара жатырсың? Артқы жағында көбірек.
Dialogue: 0,0:14:24.28,0:14:28.95,Default,,0,0,0,,<Бұрын болған оқиғаға байланысты мен көп назар аудармайтыныма көз жеткізуім керек...>
Dialogue: 0,0:14:28.95,0:14:30.88,Default,,0,0,0,,Ио Аоно!
Dialogue: 0,0:14:30.88,0:14:32.82,Default,,0,0,0,,<Гах...>
Dialogue: 0,0:14:32.82,0:14:38.42,Default,,0,0,0,,Дәл қазір қойылым керемет болды! Сен сондай керемет жігітсің!
Dialogue: 0,0:14:38.42,0:14:43.63,Default,,0,0,0,,Енді ішекті ансамбльдерді жаттықтыруды бастайық.
Dialogue: 0,0:14:43.63,0:14:47.97,Default,,0,0,0,,Бұрын мен сіздің бірінші курс студенттеріңіздің өнерін тыңдай алдым➡
Dialogue: 0,0:14:47.97,0:14:53.44,Default,,0,0,0,,Келесі жолы 2 және 3 курс студенттерінің өнерін тыңдайсыздар деп ойлаймын. ➡
Dialogue: 0,0:14:53.44,0:14:58.94,Default,,0,0,0,,Біз күнделікті кезекті концертке жаттығу жасаймыз.
Dialogue: 0,0:15:00.58,0:15:04.92,Default,,0,0,0,,Оркестр әр жазда тұрақты концерттер өткізеді➡
Dialogue: 0,0:15:04.92,0:15:07.25,Default,,0,0,0,,Бұл үлкен концерт. ➡
Dialogue: 0,0:15:07.25,0:15:12.76,Default,,0,0,0,,Үйірмеге бірінші курс студенттері қосылғанда, бұл тұрақты спектакль сіздің алғашқы спектакльіңіз болады➡
Dialogue: 0,0:15:12.76,0:15:18.40,Default,,0,0,0,,Біз болашақта осы мақсатқа жету үшін бірге жұмыс істей аламыз деп үміттенемін.
Dialogue: 0,0:15:18.40,0:15:22.77,Default,,0,0,0,,Олай болса, келесі кезекті қойылымымызды Вивалдиден бастайық.
Dialogue: 0,0:15:22.77,0:15:26.41,Default,,0,0,0,,Иә! Бұл екеуіңіз бірге ойнағандарыңыз!
Dialogue: 0,0:15:26.41,0:15:30.78,Default,,0,0,0,,Осыдан біраз уақыт бұрын, онда бірінші курсымда маған керемет қойылым көрсетілді➡
Dialogue: 0,0:15:30.78,0:15:33.68,Default,,0,0,0,,Бұл жолы біз оған қайта оралуымыз керек!
Dialogue: 0,0:15:33.68,0:15:37.55,Default,,0,0,0,,Өтінемін~ Харада-кун! (мүшелердің күлкілері)
Dialogue: 0,0:15:37.55,0:15:42.12,Default,,0,0,0,,Эй, эй... маған біртүрлі қысым жасама.
Dialogue: 0,0:15:42.12,0:15:47.63,Default,,0,0,0,,<Оркестрдің ішекті аспаптар ансамблін бірінші рет тыңдамаңыз...>
Dialogue: 0,0:15:47.63,0:15:51.50,Default,,0,0,0,,Оны Харада мырза ойнайды, Саэки. Иә.
Dialogue: 0,0:15:51.50,0:15:54.30,Default,,0,0,0,,Бұл адам атақты ма?
Dialogue: 0,0:15:54.30,0:15:57.64,Default,,0,0,0,,Аоно шынымен ештеңе білмейді.
Dialogue: 0,0:15:57.64,0:15:59.94,Default,,0,0,0,,Харада мырза….
Dialogue: 0,0:16:02.47,0:16:04.91,Default,,0,0,0,,Саэки?
Dialogue: 0,0:16:04.91,0:16:07.41,Default,,0,0,0,,Тек тыңдаңыз, сонда түсінесіз.
Dialogue: 0,0:16:09.25,0:16:12.25,Default,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,0:16:18.92,0:16:24.43,Default,,0,0,0,,<Олар қандай спектакль көрсетеді...>
Dialogue: 0,0:16:31.27,0:16:39.14,Default,,0,0,0,,♬～
Dialogue: 0,0:16:39.14,0:16:43.62,Default,,0,0,0,,<Уау... Әркімнің санасы мен үні➡
Dialogue: 0,0:16:43.62,0:16:46.95,Default,,0,0,0,,Олар табиғи түрде үтірге жиналады...>
Dialogue: 0,0:16:46.95,0:16:57.96,Default,,0,0,0,,♬～
Dialogue: 0,0:16:57.96,0:17:00.93,Default,,0,0,0,,Барлығы Харада-санның садағына қарап тұр.
Dialogue: 0,0:17:00.93,0:17:02.93,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:02.93,0:17:15.45,Default,,0,0,0,,♬～
Dialogue: 0,0:17:15.45,0:17:19.25,Default,,0,0,0,,<Үтір иілу немесе дене қимылдары арқылы қойылады➡
Dialogue: 0,0:17:19.25,0:17:22.92,Default,,0,0,0,,Сіз бұйрықты қабылдаймын дейсіз...➡
Dialogue: 0,0:17:22.92,0:17:25.26,Default,,0,0,0,,…＞
Dialogue: 0,0:17:25.26,0:17:30.76,Default,,0,0,0,,♬～
Dialogue: 0,0:17:30.76,0:17:33.67,Default,,0,0,0,,<Дыбыспен билегендей>
Dialogue: 0,0:17:33.67,0:17:41.41,Default,,0,0,0,,♬～
Dialogue: 0,0:17:41.41,0:17:45.11,Default,,0,0,0,,Әдеттегідей, оны ойнау сізге ұнайтын сияқты...
Dialogue: 0,0:17:46.78,0:17:49.41,Default,,0,0,0,,<Тамаша…. ➡
Dialogue: 0,0:17:49.41,0:17:54.62,Default,,0,0,0,,Дыбысты да, ойнатқышты да...➡
Dialogue: 0,0:17:54.62,0:17:59.49,Default,,0,0,0,,Тіпті тыңдаушының жүрегі➡
Dialogue: 0,0:17:59.49,0:18:05.56,Default,,0,0,0,,Орынның бәрі бір болып, билей бастайды...>
Dialogue: 0,0:18:05.56,0:18:09.73,Default,,0,0,0,,♬～
Dialogue: 0,0:18:09.73,0:18:13.57,Default,,0,0,0,,＜Бұл мен... Мен. ➡
Dialogue: 0,0:18:13.57,0:18:18.74,Default,,0,0,0,,Бір әнді орындасақ та, ол мүлдем басқаша болды...>
Dialogue: 0,0:18:18.74,0:18:24.55,Default,,0,0,0,,♬～
Dialogue: 0,0:18:24.55,0:18:27.92,Default,,0,0,0,,<Біздің үлкендеріміздің қойылымдары осыны айтады. ➡
Dialogue: 0,0:18:27.92,0:18:33.73,Default,,0,0,0,,Дыбыстарды сәйкестендіру деген осы...＞
Dialogue: 0,0:18:43.47,0:18:47.27,Default,,0,0,0,,бұл...
Dialogue: 0,0:18:47.27,0:18:49.47,Default,,0,0,0,,Уф.
Dialogue: 0,0:18:51.14,0:18:53.61,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:53.61,0:18:57.62,Default,,0,0,0,,Иә! Бұл жақсы спектакль болды!
Dialogue: 0,0:18:59.28,0:19:02.55,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:02.55,0:19:07.89,Default,,0,0,0,,Бұл қорқынышты... Мен Харада-сенпайдың скрипкашысы болғым келеді!
Dialogue: 0,0:19:07.89,0:19:10.73,Default,,0,0,0,,Harada Magic шықты.
Dialogue: 0,0:19:10.73,0:19:14.23,Default,,0,0,0,,Енді біз 10 әйел мүше ала аламыз!
Dialogue: 0,0:19:14.23,0:19:18.74,Default,,0,0,0,,Енді 2-ші және 3-ші сынып оқушылары, өз бөліктерін жаттықтыруға оралыңыз.
Dialogue: 0,0:19:18.74,0:19:20.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:22.37,0:19:27.58,Default,,0,0,0,,Күрсін, ол кісі ғажап.
Dialogue: 0,0:19:27.58,0:19:30.88,Default,,0,0,0,,Не? Сіз конча аласыз, солай ма?
Dialogue: 0,0:19:33.39,0:19:35.59,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:39.26,0:19:43.93,Default,,0,0,0,,<Сол күннен бастап мен қайда ойнауды мақсат етуім керек?➡
Dialogue: 0,0:19:43.93,0:19:48.77,Default,,0,0,0,,Мен түсінбедім. Бірақ...＞
Dialogue: 0,0:19:48.77,0:19:53.94,Default,,0,0,0,,Олай болса...бірінші курс студенттері, әзірше осы жерден аяқтайық➡
Dialogue: 0,0:19:53.94,0:19:57.81,Default,,0,0,0,,Осыдан кейін мен адамдарға бұл жерді еркін аралауға мүмкіндік беремін деп ойлаймын.
Dialogue: 0,0:19:57.81,0:20:00.11,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:20:00.11,0:20:06.62,Default,,0,0,0,,♬～
Dialogue: 0,0:20:06.62,0:20:11.29,Default,,0,0,0,,<Қайда баруым керек?➡
Dialogue: 0,0:20:11.29,0:20:15.49,Default,,0,0,0,,Мен қалай болғанда да түсінгендей сезінемін>
Dialogue: 0,0:20:36.31,0:20:39.52,Default,,0,0,0,,Осыншама ұзақ па?
Dialogue: 0,0:20:41.19,0:20:45.82,Default,,0,0,0,,Үлкендердің өнері керемет болды. Иә.
Dialogue: 0,0:20:45.82,0:20:51.33,Default,,0,0,0,,Бірлік сезімінің қандай да бір түрі? Мен бір нәрсені сезіндім... Мен келісемін.
Dialogue: 0,0:20:51.33,0:20:54.67,Default,,0,0,0,,Осыдан кейін үлкендер жаттығуды жалғастыратын сияқты.
Dialogue: 0,0:20:54.67,0:20:59.97,Default,,0,0,0,,Шынымен! ? Клубтық іс-шаралар өте кеш тұрады.
Dialogue: 0,0:21:05.78,0:21:08.41,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:21:08.41,0:21:12.95,Default,,0,0,0,,Иә! Жоқ... Бәрі де! Иә?
Dialogue: 0,0:21:12.95,0:21:15.62,Default,,0,0,0,,Бұл қосылатын есеп! а...!
Dialogue: 0,0:21:15.62,0:21:18.42,Default,,0,0,0,,Сіз оркестрге қосылуды шештіңіз!
Dialogue: 0,0:21:18.42,0:21:20.36,Default,,0,0,0,,Шынымен! ? Эй.
Dialogue: 0,0:21:20.36,0:21:23.80,Default,,0,0,0,,Жоқ, бұл... маған бұрын берілген...
Dialogue: 0,0:21:23.80,0:21:27.63,Default,,0,0,0,,Байқауда бірге болған жігіттермен ән айтқаныма сене алар емеспін. ➡
Dialogue: 0,0:21:27.63,0:21:30.30,Default,,0,0,0,,Рицуко-чан да осында. Эй! Рұқсатсыз...
Dialogue: 0,0:21:30.30,0:21:34.97,Default,,0,0,0,,Шынымды айтсам, не істеп жатырсың? Саған әлі ешкім кір деген жоқ!
Dialogue: 0,0:21:34.97,0:21:37.68,Default,,0,0,0,,Неге қосылмайсыз?
Dialogue: 0,0:21:39.31,0:21:44.82,Default,,0,0,0,,Бұрын сізбен ойнау өте қызықты болды.
Dialogue: 0,0:21:44.82,0:21:48.99,Default,,0,0,0,,Мен сенімен тағы да ойнасам, қуанар едім.
Dialogue: 0,0:21:48.99,0:21:54.33,Default,,0,0,0,,♬～
Dialogue: 0,0:21:54.33,0:21:58.66,Default,,0,0,0,,Уау~ Сайкидің бұлай айтуы сирек.
Dialogue: 0,0:21:58.66,0:22:01.57,Default,,0,0,0,,Қараңдар, мен сені шақырып жатырмын.
Dialogue: 0,0:22:01.57,0:22:05.47,Default,,0,0,0,,Біз не істеуіміз керек? Шынымен емес...
Dialogue: 0,0:22:05.47,0:22:07.77,Default,,0,0,0,,Бұл соншалықты ұйықтап жатыр!
Dialogue: 0,0:22:07.77,0:22:10.28,Default,,0,0,0,,Ах... эй! Хару! қалам!
Dialogue: 0,0:22:10.28,0:22:12.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:12.61,0:22:15.28,Default,,0,0,0,,Сен не істеп жүрсің!
Dialogue: 0,0:22:15.28,0:22:17.28,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:20.95,0:22:24.62,Default,,0,0,0,,Енді оны тапсыру ғана қалды, солай ма?
Dialogue: 0,0:22:24.62,0:22:32.80,Default,,0,0,0,,♬～
Dialogue: 0,0:22:32.80,0:22:37.14,Default,,0,0,0,,Эй, мүшелік туралы хабарламаны алғаннан кейін оны қазір жіберуге болады, солай ма? Иә.
Dialogue: 0,0:22:37.14,0:22:40.17,Default,,0,0,0,,Мен де тапсырамын, бірге барайық.
Dialogue: 0,0:22:40.17,0:22:45.01,Default,,0,0,0,,А... дұрыс! Ертең өз скрипкаңызды әкеліңіз.
Dialogue: 0,0:22:45.01,0:22:57.52,Default,,0,0,0,,♬～
Dialogue: 0,0:22:57.52,0:22:59.52,Default,,0,0,0,,Иә.
Dialogue: 0,0:22:59.52,0:23:08.83,Default,,0,0,0,,♬～
Dialogue: 0,0:23:10.60,0:23:13.40,Default,,0,0,0,,♬～
Dialogue: 0,0:23:13.40,0:23:18.78,Default,,0,0,0,,♬ «Бұл басталып жатыр, бәріміз осындамыз».
Dialogue: 0,0:23:18.78,0:23:23.28,Default,,0,0,0,,♬ «Мен бұл енді ешқашан болмайтын әлем сияқты сезінемін».
Dialogue: 0,0:23:23.28,0:23:33.99,Default,,0,0,0,,♬～
Dialogue: 0,0:23:33.99,0:23:39.43,Default,,0,0,0,,♬ «Мен кеңсе тауарлары мен сағаттарды кезектесіп қараймын».
Dialogue: 0,0:23:39.43,0:23:44.80,Default,,0,0,0,,♬ «Ескертпе жолдар бірден персонал белгісіне ауысады»
Dialogue: 0,0:23:44.80,0:23:49.67,Default,,0,0,0,,♬ «Күн аспанды бір сәтке бұлтқа қалдырады».
Dialogue: 0,0:23:49.67,0:23:55.31,Default,,0,0,0,,♬ «Мұңды скрипка граффити»
Dialogue: 0,0:23:55.31,0:24:04.59,Default,,0,0,0,,♬ «Мектептен кейінгі барлық байланыссыз дыбыстар тыныштандырады».
Dialogue: 0,0:24:04.59,0:24:07.49,Default,,0,0,0,,♬～
Dialogue: 0,0:24:07.49,0:24:12.93,Default,,0,0,0,,♬ «Бұл басталып жатыр, бәріміз осындамыз».
Dialogue: 0,0:24:12.93,0:24:17.77,Default,,0,0,0,,♬ «Мен бұл енді ешқашан болмайтын әлем сияқты сезінемін».
Dialogue: 0,0:24:17.77,0:24:23.41,Default,,0,0,0,,♬ "Мен көбірек ойнағым келеді. Мен көбірек ойнағым келеді."
Dialogue: 0,0:24:23.41,0:24:27.95,Default,,0,0,0,,♬ «Бір реттік шексіз музыка»
Dialogue: 0,0:24:27.95,0:24:30.28,Default,,0,0,0,,♬ «Маған бұл дыбыс ұнайды»
Dialogue: 0,0:24:30.28,0:24:39.09,Default,,0,0,0,,♬～
Dialogue: 0,0:24:40.79,0:24:57.31,Default,,0,0,0,,♬～
