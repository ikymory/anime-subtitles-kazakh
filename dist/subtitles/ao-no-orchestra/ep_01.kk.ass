Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.15,0:00:07.02,Default,,0,0,0,,Тек төрт жол...
Dialogue: 0,0:00:07.02,0:00:11.66,Default,,0,0,0,,Сол жерден дыбыс шықты➡
Dialogue: 0,0:00:11.66,0:00:15.29,Default,,0,0,0,,Ол мені ұстап алды, жібермейді...
Dialogue: 0,0:00:15.29,0:00:25.04,Default,,0,0,0,,♬～
Dialogue: 0,0:00:25.04,0:00:27.51,Default,,0,0,0,,Уау.
Dialogue: 0,0:00:27.51,0:00:35.85,Default,,0,0,0,,♬～
Dialogue: 0,0:00:35.85,0:00:37.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:37.78,0:00:43.52,Default,,0,0,0,,♬～
Dialogue: 0,0:00:43.52,0:00:45.86,Default,,0,0,0,,Қазір де...
Dialogue: 0,0:00:45.86,0:00:48.69,Default,,0,0,0,,♬～
Dialogue: 0,0:00:48.69,0:00:51.73,Default,,0,0,0,,Кейде есіме түседі...
Dialogue: 0,0:00:51.73,0:00:57.40,Default,,0,0,0,,♬～
Dialogue: 0,0:00:57.40,0:01:02.81,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:01:02.81,0:01:08.48,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:01:08.48,0:01:13.79,Default,,0,0,0,,Мен дыбысты жақсы көрген күндер туралы...
Dialogue: 0,0:01:16.66,0:01:47.02,Default,,0,0,0,,♬～
Dialogue: 0,0:01:47.02,0:01:56.73,Default,,0,0,0,,♬～
Dialogue: 0,0:01:56.73,0:02:05.44,Default,,0,0,0,,♬～
Dialogue: 0,0:02:08.81,0:02:16.62,Default,,0,0,0,,♬～
Dialogue: 0,0:02:20.29,0:02:23.82,Default,,0,0,0,,♬～
Dialogue: 0,0:02:23.82,0:02:26.66,Default,,0,0,0,,♬～
Dialogue: 0,0:02:26.66,0:02:37.37,Default,,0,0,0,,♬～
Dialogue: 0,0:02:37.37,0:02:45.18,Default,,0,0,0,,♬～
Dialogue: 0,0:02:57.02,0:02:59.32,Default,,0,0,0,,өту! (доптың соғу дыбысы)
Dialogue: 0,0:03:01.99,0:03:05.26,Default,,0,0,0,,Ах…. ау. Иә.
Dialogue: 0,0:03:05.26,0:03:07.80,Default,,0,0,0,,Амансың ба? Сіз мұны әдейі жасайсыз ба?
Dialogue: 0,0:03:07.80,0:03:10.84,Default,,0,0,0,,Чигеё. ...Менің айтайын дегенім осы.
Dialogue: 0,0:03:10.84,0:03:12.97,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:03:12.97,0:03:17.28,Default,,0,0,0,,Амансың ба? Аоно. Денсаулық бөлмесіне барыңыз. иә.
Dialogue: 0,0:03:18.84,0:03:23.05,Default,,0,0,0,,<Мен кішкентай кезімнен спортпен нашар болдым>
Dialogue: 0,0:03:26.99,0:03:32.79,Default,,0,0,0,,<Мен бейсбол, баскетбол және доджбол ойнаймын➡
Dialogue: 0,0:03:32.79,0:03:36.16,Default,,0,0,0,,Мен мұны ешқашан жасаған емеспін>
Dialogue: 0,0:03:36.16,0:03:41.83,Default,,0,0,0,,Мүлдем жоқ! Саусақтар - скрипкашының өмірі.
Dialogue: 0,0:03:41.83,0:03:46.14,Default,,0,0,0,,<Жарайды, бұл жақсы болды.>
Dialogue: 0,0:03:48.17,0:03:51.51,Default,,0,0,0,,<Маған ұнамады...>
Dialogue: 0,0:03:51.51,0:03:58.52,Default,,0,0,0,,♬～
Dialogue: 0,0:04:02.45,0:04:04.39,Default,,0,0,0,,⚟ (шулау)
Dialogue: 0,0:04:04.39,0:04:06.79,Default,,0,0,0,,Ах. ⚟(мырылдау)
Dialogue: 0,0:04:06.79,0:04:09.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:09.03,0:04:14.13,Default,,0,0,0,,⚟(гуілдеу)
Dialogue: 0,0:04:14.13,0:04:16.13,Default,,0,0,0,,О...
Dialogue: 0,0:04:16.13,0:04:18.14,Default,,0,0,0,,⚟ (шулау)
Dialogue: 0,0:04:27.98,0:04:29.98,Default,,0,0,0,,Әлде бұл жыныстық сипаттағы қорлау үшін сылтау ма?
Dialogue: 0,0:04:39.16,0:04:42.86,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:04:48.17,0:04:50.10,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:04:50.10,0:04:52.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:54.04,0:04:56.04,Default,,0,0,0,,Анашым!
Dialogue: 0,0:04:57.84,0:05:00.11,Default,,0,0,0,,Анашым, не болды? ?
Dialogue: 0,0:05:00.11,0:05:02.78,Default,,0,0,0,,Шықты... Шықты!
Dialogue: 0,0:05:02.78,0:05:05.25,Default,,0,0,0,,Адамзаттың жауы! Не?
Dialogue: 0,0:05:05.25,0:05:09.12,Default,,0,0,0,,Бір болса, олардың саны 100. Олар адамзаттың жаулары!
Dialogue: 0,0:05:09.12,0:05:11.82,Default,,0,0,0,,Бұл не? Тарақан?
Dialogue: 0,0:05:13.63,0:05:16.46,Default,,0,0,0,,Ол сол бөлмеге жүгірді!
Dialogue: 0,0:05:16.46,0:05:19.13,Default,,0,0,0,,Асығыңыз! иә? Күте тұрыңыз... бір сәт...
Dialogue: 0,0:05:19.13,0:05:21.80,Default,,0,0,0,,<Бұл бөлме➡
Dialogue: 0,0:05:21.80,0:05:24.64,Default,,0,0,0,,Ашылмаған бөлме…＞
Dialogue: 0,0:05:24.64,0:05:36.15,Default,,0,0,0,,♬～
Dialogue: 0,0:05:36.15,0:05:39.82,Default,,0,0,0,,Эй, сен сонда болдың ба? менде сен барсың?
Dialogue: 0,0:05:39.82,0:05:44.69,Default,,0,0,0,,<Күтілгендей, осы бөлмеде➡
Dialogue: 0,0:05:44.69,0:05:48.49,Default,,0,0,0,,Мен кіргім келмеді...>
Dialogue: 0,0:05:48.49,0:05:51.53,Default,,0,0,0,,Ах! Ол сонда болды! Ол сонда болды! ана жерде! Мына жаққа қара!
Dialogue: 0,0:05:51.53,0:05:55.00,Default,,0,0,0,,Е, қайда! ? Фортепиано астында!
Dialogue: 0,0:05:55.00,0:05:58.67,Default,,0,0,0,,(спрей дыбысы)
Dialogue: 0,0:05:58.67,0:06:00.61,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:06:00.61,0:06:04.94,Default,,0,0,0,,Рахмет, Хаджиме. Анашым, сіз тым көп шу шығарып жатырсыз...
Dialogue: 0,0:06:04.94,0:06:09.78,Default,,0,0,0,,Оны кейінірек алыңыз. Түсіндім... Хехе....
Dialogue: 0,0:06:09.78,0:06:12.68,Default,,0,0,0,,Бірақ ол әлі жұмыс істемейді...
Dialogue: 0,0:06:12.68,0:06:17.46,Default,,0,0,0,,Тазалаудан кейін де бұл бөлмеде темекінің иісі кетпейді...
Dialogue: 0,0:06:17.46,0:06:20.46,Default,,0,0,0,,Ал, мен кешкі ас әзірлеймін.
Dialogue: 0,0:06:27.13,0:06:31.97,Default,,0,0,0,,＜Бұл бөлмеден темекінің иісі шығады➡
Dialogue: 0,0:06:31.97,0:06:35.67,Default,,0,0,0,,Скрипка үні бойыма сіңіп кеткен>
Dialogue: 0,0:06:37.78,0:06:40.48,Default,,0,0,0,,Бір жыл болды...
Dialogue: 0,0:06:42.48,0:06:47.79,Default,,0,0,0,,<Өмірімнің ең көп уақытын өткізген жер...>
Dialogue: 0,0:07:05.10,0:07:07.81,Default,,0,0,0,,<Мен ұйықтай алмаймын...>
Dialogue: 0,0:07:09.61,0:07:12.64,Default,,0,0,0,,<Сіз сол бөлмеге кіргеніңіз үшін бе...? ＞
Dialogue: 0,0:07:12.64,0:07:14.78,Default,,0,0,0,,♬~ (Рюджиннің скрипка орындауы) Уау!
Dialogue: 0,0:07:14.78,0:07:19.12,Default,,0,0,0,,Керемет таңқаларлық! Әкемнің дыбысын қалай шығарамын? ?
Dialogue: 0,0:07:19.12,0:07:21.45,Default,,0,0,0,,♬～
Dialogue: 0,0:07:21.45,0:07:23.79,Default,,0,0,0,,<Менің әкем...>
Dialogue: 0,0:07:23.79,0:07:27.96,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:07:27.96,0:07:32.13,Default,,0,0,0,,<Ол кәсіби скрипкашы болған. ➡
Dialogue: 0,0:07:32.13,0:07:37.94,Default,,0,0,0,,Мен скрипканы және әкем ойнайтын дыбысты жақсы көретінмін...>
Dialogue: 0,0:07:37.94,0:07:42.84,Default,,0,0,0,,♬～ (Юджиннің скрипка орындауы)
Dialogue: 0,0:07:42.84,0:07:45.48,Default,,0,0,0,,Боқ...
Dialogue: 0,0:07:45.48,0:07:49.28,Default,,0,0,0,,♬～ (Юджиннің скрипка орындауы)
Dialogue: 0,0:07:49.28,0:07:54.49,Default,,0,0,0,,＜Қазір де сол дыбыс құлағыма қадалып тұр...＞
Dialogue: 0,0:07:54.49,0:07:56.42,Default,,0,0,0,,♬~ (Юджиннің скрипка орындауы)
Dialogue: 0,0:07:56.42,0:08:03.23,Default,,0,0,0,,<Мен... әлгі «дыбысқа» құмармын...>
Dialogue: 0,0:08:09.97,0:08:14.24,Default,,0,0,0,,Күлсін... ПЭ бүгін де.
Dialogue: 0,0:08:14.24,0:08:18.11,Default,,0,0,0,,Әй, эй, ол бүгін келетін сияқты. Шынайы! ?
Dialogue: 0,0:08:18.11,0:08:21.78,Default,,0,0,0,,Сіз әлі де медбикенің кеңсесінде NEETсіз бе?
Dialogue: 0,0:08:21.78,0:08:24.12,Default,,0,0,0,,<Аурухана...>
Dialogue: 0,0:08:24.12,0:08:27.95,Default,,0,0,0,,Ано! Иә? А... иә.
Dialogue: 0,0:08:27.95,0:08:32.46,Default,,0,0,0,,Мансап бөлмесіндегі түскі үзіліс. иә? Неліктен?
Dialogue: 0,0:08:32.46,0:08:38.16,Default,,0,0,0,,Неліктен? Бұл мансап кеңесі екеніне сенімдімін. Келуді ұмытпаңыз!
Dialogue: 0,0:08:41.17,0:08:43.17,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:08:44.97,0:08:48.64,Default,,0,0,0,,<Курс...? ➡
Dialogue: 0,0:08:48.64,0:08:51.98,Default,,0,0,0,,Бұл ауыртпалық...＞
Dialogue: 0,0:08:51.98,0:09:13.16,Default,,0,0,0,,⚟(Скрипка дыбысы)
Dialogue: 0,0:09:15.20,0:09:17.70,Default,,0,0,0,,Бұл менің қиялым ғана ма...?
Dialogue: 0,0:09:19.44,0:09:23.11,Default,,0,0,0,,<Галлюцинация жаман емес пе?>
Dialogue: 0,0:09:33.45,0:09:39.32,Default,,0,0,0,,Сіз таңдаған мектепті әлі шешпеген жалғыз адамсыз.
Dialogue: 0,0:09:39.32,0:09:44.13,Default,,0,0,0,,Аоно, орта мектепті бітіргеннен кейін не істегіңіз келетіні жоқ па?
Dialogue: 0,0:09:44.13,0:09:47.00,Default,,0,0,0,,Атап айтқанда.
Dialogue: 0,0:09:47.00,0:09:52.47,Default,,0,0,0,,Хигасико Сіз баратыныңызды айттыңыз. Неліктен оны кенеттен өзгерту керек?
Dialogue: 0,0:09:52.47,0:09:57.28,Default,,0,0,0,,Сато-кунды сонда ұсынғанын естідім...
Dialogue: 0,0:09:57.28,0:09:59.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:00.98,0:10:05.82,Default,,0,0,0,,♬～
Dialogue: 0,0:10:05.82,0:10:11.62,Default,,0,0,0,,<Мені ешкім танымайтын жерге>
Dialogue: 0,0:10:14.53,0:10:19.30,Default,,0,0,0,,Мүмкін болса, мен ешкімді танымайтын орта мектепке барғым келеді.
Dialogue: 0,0:10:19.30,0:10:23.84,Default,,0,0,0,,Түсінемін, сенің мұны істегің келеді, бірақ...
Dialogue: 0,0:10:23.84,0:10:28.51,Default,,0,0,0,,Сізге артықшылық беруге мүмкіндігіңіз жоқ деп ойлаймын. Уф...
Dialogue: 0,0:10:28.51,0:10:33.18,Default,,0,0,0,,Біртүрлі... Соңғы кездері өте қатты оқып жүрмін.
Dialogue: 0,0:10:33.18,0:10:36.51,Default,,0,0,0,,«Жақында», солай ма? Не оқып жатыр?➡
Dialogue: 0,0:10:36.51,0:10:41.69,Default,,0,0,0,,Тынбай еңбек етпесең, нәтиже шықпайды. ➡
Dialogue: 0,0:10:41.69,0:10:45.52,Default,,0,0,0,,Скрипканы көп жаттықтырдыңыз➡
Dialogue: 0,0:10:45.52,0:10:48.86,Default,,0,0,0,,Сіз қаншалықты ойнай алатын болдыңыз, солай емес пе?
Dialogue: 0,0:10:48.86,0:10:55.63,Default,,0,0,0,,Мен сені музыкамен айналысамын деп ойладым.
Dialogue: 0,0:10:55.63,0:10:59.87,Default,,0,0,0,,<Мұғалімнің көңілі қалған жүзіне қарап➡
Dialogue: 0,0:10:59.87,0:11:04.08,Default,,0,0,0,,Менің жүрегім аздап ауырады...＞
Dialogue: 0,0:11:05.68,0:11:11.52,Default,,0,0,0,,<Мен орта мектептің 1-курсында оқып жүрген кезімдегі жарыс. Мен сол кезде қатты таң қалдым. ➡
Dialogue: 0,0:11:11.52,0:11:17.46,Default,,0,0,0,,Осы уақытқа дейін менің сынып жетекшім келмеді>
Dialogue: 0,0:11:17.46,0:11:20.83,Default,,0,0,0,,Мемлекеттік орта мектеп жақсы ма?
Dialogue: 0,0:11:20.83,0:11:24.66,Default,,0,0,0,,Мен анама көп салмақ салғым келмейді.
Dialogue: 0,0:11:24.66,0:11:30.54,Default,,0,0,0,,Хмм…. Соған қарамастан мен алыстағы мектепке барғым келеді.
Dialogue: 0,0:11:30.54,0:11:34.84,Default,,0,0,0,,Мен өзімшіл екенімді білемін...
Dialogue: 0,0:11:34.84,0:11:38.68,Default,,0,0,0,,Білесің бе, Аоно, сен ойлағаннан да көп➡
Dialogue: 0,0:11:38.68,0:11:42.85,Default,,0,0,0,,Айналаңыздағылар сізге жау емес деп ойлаймын.
Dialogue: 0,0:11:42.85,0:11:46.52,Default,,0,0,0,,Тіпті менің сыныбымдағы жігіттер. Мен түссіндім.
Dialogue: 0,0:11:46.52,0:11:52.32,Default,,0,0,0,,♬～
Dialogue: 0,0:11:52.32,0:11:54.33,Default,,0,0,0,,Хмм….
Dialogue: 0,0:11:57.16,0:12:00.06,Default,,0,0,0,,Сәлем, Аоно. Бұл мен➡
Dialogue: 0,0:12:00.06,0:12:03.27,Default,,0,0,0,,Мен сізге ұсынғым келетін мектеп бар. ➡
Dialogue: 0,0:12:03.27,0:12:06.14,Default,,0,0,0,,Жақсы…. ⚟(Скрипка дыбысы)
Dialogue: 0,0:12:06.14,0:12:09.04,Default,,0,0,0,,<Тағы да! ＞Осында.
Dialogue: 0,0:12:09.04,0:12:12.28,Default,,0,0,0,,Мұғалім, сіз скрипканы естисіз! ?
Dialogue: 0,0:12:12.28,0:12:16.81,Default,,0,0,0,,⚟ (Скрипка дыбысы) Әй, анау Ақине жігіт➡
Dialogue: 0,0:12:16.81,0:12:19.72,Default,,0,0,0,,Мен медбикенің бөлмесінде ойнауды қойып, соншалықты көп айтсам да...
Dialogue: 0,0:12:19.72,0:12:22.29,Default,,0,0,0,,А... Не айтып тұрсың?
Dialogue: 0,0:12:24.99,0:12:27.49,Default,,0,0,0,,Қалғаны сабақтан кейін болады.
Dialogue: 0,0:12:27.49,0:12:31.36,Default,,0,0,0,,Не? Скрипканың нақты тұлғасы қандай? ау.
Dialogue: 0,0:12:31.36,0:12:34.67,Default,,0,0,0,,Иә? Сіз қызықсыз ба?
Dialogue: 0,0:12:34.67,0:12:39.30,Default,,0,0,0,,Аоно скрипкада ойнауды қойған жоқ па?
Dialogue: 0,0:12:39.30,0:12:41.31,Default,,0,0,0,,Ой...!
Dialogue: 0,0:12:43.01,0:12:46.01,Default,,0,0,0,,<Маған бәрібір! ＞
Dialogue: 0,0:12:48.88,0:12:55.02,Default,,0,0,0,,<Акине деген кім? Біздің мектепте ішекті аспаптар үйірмесі жоқ...>
Dialogue: 0,0:12:55.02,0:13:00.56,Default,,0,0,0,,♬～
Dialogue: 0,0:13:00.56,0:13:05.26,Default,,0,0,0,,<Ол дыбыс ақсап еді...>
Dialogue: 0,0:13:18.64,0:13:22.95,Default,,0,0,0,,<Көліктің ішін толтырған шайырдың иісі>
Dialogue: 0,0:13:24.98,0:13:28.02,Default,,0,0,0,,<Әкенің дауысы. ➡
Dialogue: 0,0:13:28.02,0:13:31.66,Default,,0,0,0,,Әкенің күлкісі. ➡
Dialogue: 0,0:13:31.66,0:13:36.16,Default,,0,0,0,,Бәрі де жүрегім айныды.
Dialogue: 0,0:13:37.83,0:13:40.13,Default,,0,0,0,,Хаджиме.
Dialogue: 0,0:13:41.70,0:13:45.17,Default,,0,0,0,,Сіз скрипкашысыз. ➡
Dialogue: 0,0:13:45.17,0:13:48.87,Default,,0,0,0,,Скрипкада өліп бара жатқандай ойнай бер.
Dialogue: 0,0:13:50.51,0:13:52.51,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:14:07.93,0:14:10.63,Default,,0,0,0,,Әке...
Dialogue: 0,0:14:14.27,0:14:17.64,Default,,0,0,0,,Бозарып кеткен сияқтысың, Хаджиме.
Dialogue: 0,0:14:17.64,0:14:20.97,Default,,0,0,0,,Сіз кеш тұрдыңыз, солай емес пе?
Dialogue: 0,0:14:20.97,0:14:23.27,Default,,0,0,0,,Хмм….
Dialogue: 0,0:14:23.27,0:14:28.48,Default,,0,0,0,,<Соңында таңға дейін ұйықтай алмадым...>
Dialogue: 0,0:14:31.15,0:14:34.65,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:14:34.65,0:14:39.49,Default,,0,0,0,,Ана. Ол бөлме ашық.
Dialogue: 0,0:14:39.49,0:14:45.50,Default,,0,0,0,,Желдету, желдету. Құралға зақым келмейтініне көз жеткізу үшін біз мұны бұрын жасадық.
Dialogue: 0,0:14:47.23,0:14:50.84,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:14:50.84,0:14:56.31,Default,,0,0,0,,Мен оны бәрібір қолданбаймын. Не, сіз оны енді қолданбайсыз ба?
Dialogue: 0,0:14:56.31,0:14:59.11,Default,,0,0,0,,Сіз оны қолданбайсыз, солай ма?
Dialogue: 0,0:15:01.15,0:15:03.61,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:03.61,0:15:06.32,Default,,0,0,0,,Менің ұйықтайтын әдетім бар!
Dialogue: 0,0:15:08.79,0:15:11.59,Default,,0,0,0,,Flashback (Аононың анасы) Сіз оны қолданбайсыз ба?
Dialogue: 0,0:15:14.96,0:15:20.16,Default,,0,0,0,,<Сол бөлме... Құлыптаулы болса ғой>
Dialogue: 0,0:15:22.13,0:15:26.94,Default,,0,0,0,,<Сол бөлмеде барлығын құлыптау үшін>
Dialogue: 0,0:15:30.81,0:15:34.68,Default,,0,0,0,,<Анам не қиналады...➡
Dialogue: 0,0:15:34.68,0:15:39.48,Default,,0,0,0,,Қайта есімде қалмас үшін＞
Dialogue: 0,0:15:41.29,0:15:47.99,Default,,0,0,0,,<Анамды ол сияқты ренжітпеймін>
Dialogue: 0,0:15:53.03,0:15:56.87,Default,,0,0,0,,Еске алу Өлемін деген ниетпен скрипкада ойнай бер.
Dialogue: 0,0:15:56.87,0:16:02.37,Default,,0,0,0,,<Сол күні әкем айтқан кезде шештім>
Dialogue: 0,0:16:04.11,0:16:07.81,Default,,0,0,0,,<Мен енді скрипкада ойнамаймын...>
Dialogue: 0,0:16:09.61,0:16:12.12,Default,,0,0,0,,(шардың соқтығысуы және құлау дыбысы)
Dialogue: 0,0:16:12.12,0:16:15.62,Default,,0,0,0,,Аоно! Эй, жақсысың ба! ?
Dialogue: 0,0:16:15.62,0:16:19.12,Default,,0,0,0,,<Мен қатты ашуландым... ➡
Dialogue: 0,0:16:19.12,0:16:22.96,Default,,0,0,0,,Жаттығу жасай алмайтын өзіммен...➡
Dialogue: 0,0:16:22.96,0:16:28.47,Default,,0,0,0,,Мен өзімді скрипкаға мәңгілікке құмар сезінемін...＞
Dialogue: 0,0:16:33.27,0:16:37.64,Default,,0,0,0,,Дене шынықтыру сабағында құлап қалдым. ➡
Dialogue: 0,0:16:37.64,0:16:43.45,Default,,0,0,0,,Сіз де басыңызды ұрған сияқтысыз, маған біраз ұйықтауға рұқсат етіңіз.
Dialogue: 0,0:16:43.45,0:16:52.26,Default,,0,0,0,,♬～
Dialogue: 0,0:17:00.87,0:17:04.10,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:04.10,0:17:07.77,Default,,0,0,0,,Иә? Мұғалім жоқ па?
Dialogue: 0,0:17:07.77,0:17:10.77,Default,,0,0,0,,Такеда Сенсэй!
Dialogue: 0,0:17:13.11,0:17:17.45,Default,,0,0,0,,Не? Ол әлі келген жоқ...?
Dialogue: 0,0:17:17.45,0:17:24.26,Default,,0,0,0,,Ал... Арнайы оқуымның нәтижесін тыңдауға рұқсат етемін деп ойладым.
Dialogue: 0,0:17:30.46,0:17:36.80,Default,,0,0,0,,♬～
Dialogue: 0,0:17:36.80,0:17:41.47,Default,,0,0,0,,<Жоқ, жоқ, бұл дұрыс емес... ➡
Dialogue: 0,0:17:41.47,0:17:44.98,Default,,0,0,0,,А... Мен дыбысты тағы да сағындым! ➡
Dialogue: 0,0:17:44.98,0:17:47.88,Default,,0,0,0,,Әй, эй, маған тынығып берші. ➡
Dialogue: 0,0:17:47.88,0:17:50.85,Default,,0,0,0,,Сонда бұл скрипканың айқайы. ➡
Dialogue: 0,0:17:50.85,0:17:56.59,Default,,0,0,0,,Сіз жаныңыздағы жіпке тиіп тұрсыз ба? Қажетсіз дыбыстар өте көп. ➡
Dialogue: 0,0:17:56.59,0:18:02.09,Default,,0,0,0,,Әй... Оны қандай адам ойнап жүр екен...＞
Dialogue: 0,0:18:03.76,0:18:05.70,Default,,0,0,0,,<Мен! ? ＞
Dialogue: 0,0:18:05.70,0:18:13.77,Default,,0,0,0,,♬～(скрипка)
Dialogue: 0,0:18:13.77,0:18:16.07,Default,,0,0,0,,Уау….
Dialogue: 0,0:18:34.79,0:18:36.83,Default,,0,0,0,,Хентай!
Dialogue: 0,0:18:36.83,0:18:39.13,Default,,0,0,0,,Иә? ең нашар!
Dialogue: 0,0:18:39.13,0:18:42.13,Default,,0,0,0,,Сіз төсекте тығылып, мені үнемі бақылап отырдыңыз! ?
Dialogue: 0,0:18:42.13,0:18:46.80,Default,,0,0,0,,Ха! ? Чигеё! Мен төсекте ұйықтап жатыр едім!
Dialogue: 0,0:18:46.80,0:18:50.98,Default,,0,0,0,,Онда неге мұрыннан қан кетіп жатыр? ? иә?
Dialogue: 0,0:18:50.98,0:18:53.48,Default,,0,0,0,,А... О, жоқ!
Dialogue: 0,0:18:53.48,0:18:56.38,Default,,0,0,0,,Сіз бәрібір эротикалық нәрселер туралы ойлаған болуыңыз керек! ?
Dialogue: 0,0:18:56.38,0:18:58.68,Default,,0,0,0,,Бұл шынымен қорқынышты!
Dialogue: 0,0:19:00.28,0:19:03.92,Default,,0,0,0,,<Дыбыстың шын тұлғасы қандай?>
Dialogue: 0,0:19:03.92,0:19:06.82,Default,,0,0,0,,Неге қарап тұрсың?
Dialogue: 0,0:19:06.82,0:19:10.09,Default,,0,0,0,,<Қатысу қиын болатын сияқты.>
Dialogue: 0,0:19:10.09,0:19:13.76,Default,,0,0,0,,Мен саған қарамаймын➡
Dialogue: 0,0:19:13.76,0:19:17.10,Default,,0,0,0,,Бұл мұрыннан қан кету баскетбол ойнап жүрген доптың соғылуынан болды.
Dialogue: 0,0:19:17.10,0:19:19.44,Default,,0,0,0,,Дасса.
Dialogue: 0,0:19:19.44,0:19:21.77,Default,,0,0,0,,Сіз білесіз...
Dialogue: 0,0:19:21.77,0:19:26.11,Default,,0,0,0,,Мен сенің ақымақ ойыныңа таң қалдым!
Dialogue: 0,0:19:26.11,0:19:29.45,Default,,0,0,0,,Иә? Сен немен жамансың? ? Сен сондай жамансың!
Dialogue: 0,0:19:29.45,0:19:33.95,Default,,0,0,0,,Дұрысы, бұл жай ғана проблема емес! Біріншіден, бұл шегелер!
Dialogue: 0,0:19:33.95,0:19:38.12,Default,,0,0,0,,Мына сиқырлы тырнақтарың басқа жіптерге тиіп тұр!
Dialogue: 0,0:19:38.12,0:19:42.83,Default,,0,0,0,,Скрипкада бұлай ойнауға болмайды!
Dialogue: 0,0:19:44.46,0:19:48.27,Default,,0,0,0,,<Неге сонша ашуланасың? Мен...>
Dialogue: 0,0:19:50.13,0:19:54.97,Default,,0,0,0,,<Олай дейтінім, бұл жігіт неге мұндай жерде ойнап жүр...>
Dialogue: 0,0:19:54.97,0:19:58.28,Default,,0,0,0,,Эй, сен ояусың ба?
Dialogue: 0,0:19:58.28,0:20:01.65,Default,,0,0,0,,Ах…. Мен басымды соқтым. Сенімен бәрі жақсы ма? ➡
Dialogue: 0,0:20:01.65,0:20:04.48,Default,,0,0,0,,Мен уайымдадым. Ах, ммм...
Dialogue: 0,0:20:04.48,0:20:07.38,Default,,0,0,0,,Әй, менде бір соққы бар.
Dialogue: 0,0:20:07.38,0:20:10.29,Default,,0,0,0,,Мұғалім, сіз кешігіп келесіз!
Dialogue: 0,0:20:10.29,0:20:15.16,Default,,0,0,0,,Әй, Акине. Сіз мұнда скрипкада ойнадыңыз ба?
Dialogue: 0,0:20:15.16,0:20:17.16,Default,,0,0,0,,Акине?
Dialogue: 0,0:20:17.16,0:20:20.83,Default,,0,0,0,,Рицуко Акине. Мен оларға шәкірт оқыту арқылы қамқорлық жасаймын.
Dialogue: 0,0:20:20.83,0:20:23.50,Default,,0,0,0,,Маған мүлдем қарамайды!
Dialogue: 0,0:20:23.50,0:20:27.00,Default,,0,0,0,,Сен менің қасымда сыныптасың, сондықтан менің бетімді білетін шығарсың, солай ма?
Dialogue: 0,0:20:27.00,0:20:29.91,Default,,0,0,0,,<Осындай адам болды ма? ＞
Dialogue: 0,0:20:29.91,0:20:34.18,Default,,0,0,0,,Такеда мырза, сіз бүгін маған скрипка үйрететін боласыз, солай ма?
Dialogue: 0,0:20:34.18,0:20:36.51,Default,,0,0,0,,А, бұл туралы ...
Dialogue: 0,0:20:36.51,0:20:38.45,Default,,0,0,0,,Иә! ? ау.
Dialogue: 0,0:20:38.45,0:20:42.39,Default,,0,0,0,,Мұғалім, сіз скрипкада ойнай аласыз! ? Бұл менің скрипкам.
Dialogue: 0,0:20:42.39,0:20:46.02,Default,,0,0,0,,Не? иә? Мен саған айтпадым ба?
Dialogue: 0,0:20:46.02,0:20:50.53,Default,,0,0,0,,Мен орта мектепте оқып жүргенімде оркестр үйірмесіне қатысатынмын.
Dialogue: 0,0:20:50.53,0:20:54.87,Default,,0,0,0,,Оркестр бөлімі? Азаматтық оркестр ме?
Dialogue: 0,0:20:54.87,0:20:59.70,Default,,0,0,0,,Бұл мектеп үйірмесі. Жоғары сынып оқушыларынан құралған оркестр.
Dialogue: 0,0:20:59.70,0:21:04.27,Default,,0,0,0,,Мен ностальгия сезінемін... 20 жыл бұрын болса да➡
Dialogue: 0,0:21:04.27,0:21:09.11,Default,,0,0,0,,Сол күндердің дыбыстары әлі есімде. ➡
Dialogue: 0,0:21:09.11,0:21:12.15,Default,,0,0,0,,Аононың оркестрлік тәжірибесі бар ма? ➡
Dialogue: 0,0:21:12.15,0:21:18.16,Default,,0,0,0,,Көптеген дыбыстардың қосылатын сәті шынымен жақсы сезінеді.
Dialogue: 0,0:21:18.16,0:21:23.83,Default,,0,0,0,,<Орта мектеп оркестрі...>
Dialogue: 0,0:21:23.83,0:21:26.73,Default,,0,0,0,,Мен 2-ші скрипкамын➡
Dialogue: 0,0:21:26.73,0:21:30.30,Default,,0,0,0,,Бұл мен сол кезде қолданатын скрипка.
Dialogue: 0,0:21:30.30,0:21:34.67,Default,,0,0,0,,Толық емес уақыт жұмыс істеп, лайықты нәрсе сатып алыңыз.
Dialogue: 0,0:21:34.67,0:21:37.17,Default,,0,0,0,,Мен білмедім...
Dialogue: 0,0:21:37.17,0:21:40.08,Default,,0,0,0,,Қазір бұл жігіт жалдауда.
Dialogue: 0,0:21:40.08,0:21:44.05,Default,,0,0,0,,Ол менің алма-матерімнің оркестр клубында скрипкада ойнағысы келетінін айтты.
Dialogue: 0,0:21:44.05,0:21:46.88,Default,,0,0,0,,Мұғалім: Сіз тым таза сөйлейсіз.
Dialogue: 0,0:21:46.88,0:21:49.75,Default,,0,0,0,,<Оркестр...? ➡
Dialogue: 0,0:21:49.75,0:21:52.72,Default,,0,0,0,,Кішкентай кезімнен соло болдым➡
Dialogue: 0,0:21:52.72,0:21:55.56,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін...>
Dialogue: 0,0:21:55.56,0:21:59.43,Default,,0,0,0,,Айтпақшы, сэр. Бұл мұрыннан қан кету не?
Dialogue: 0,0:21:59.43,0:22:02.80,Default,,0,0,0,,Мына жігіт маған қарап тұрды.
Dialogue: 0,0:22:02.80,0:22:04.74,Default,,0,0,0,,Не!
Dialogue: 0,0:22:04.74,0:22:08.14,Default,,0,0,0,,Бұл Хаджиме Аоно. Ол сенің мұғалімің.
Dialogue: 0,0:22:08.14,0:22:10.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:10.14,0:22:13.81,Default,,0,0,0,,Аоно менің сенен бір жақсылығым бар.
Dialogue: 0,0:22:13.81,0:22:15.75,Default,,0,0,0,,Иә….
Dialogue: 0,0:22:15.75,0:22:19.05,Default,,0,0,0,,Сіз Акинеге скрипкада ойнауды үйрете аласыз ба?
Dialogue: 0,0:22:20.68,0:22:24.29,Default,,0,0,0,,Иә! ? Ха! ? Не... неге мен мұндай нәрсені істеймін!? ?
Dialogue: 0,0:22:24.29,0:22:26.99,Default,,0,0,0,,Әй, мұғалім, не айтып тұрсың! ? Кенеттен!
Dialogue: 0,0:22:26.99,0:22:29.03,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін!
Dialogue: 0,0:22:29.03,0:22:33.16,Default,,0,0,0,,Жарайды! Бұл жігіттің скрипканы жақсы меңгергені сонша, оның не айтқысы келгенін де білмеймін.
Dialogue: 0,0:22:33.16,0:22:37.84,Default,,0,0,0,,Мәселе бұл емес! Неге мен бұл жігіттен үйренуім керек?
Dialogue: 0,0:22:37.84,0:22:42.31,Default,,0,0,0,,Егер Аоно жұмысты қабылдаса, мен оның спорттық көрсеткіштеріне байыппен қараймын.
Dialogue: 0,0:22:42.31,0:22:45.68,Default,,0,0,0,,Иә! ? (Такеда мырза) Акине мені тыңдау керек➡
Dialogue: 0,0:22:45.68,0:22:49.51,Default,,0,0,0,,Мен саған скрипкамды бермеймін. Не!
Dialogue: 0,0:22:49.51,0:22:53.85,Default,,0,0,0,,<Сол жігіт кенеттен скрипканы ұстап алды➡
Dialogue: 0,0:22:53.85,0:22:56.55,Default,,0,0,0,,Менің алдымда көрінді>
Dialogue: 0,0:22:58.19,0:23:01.63,Default,,0,0,0,,<Рицуко Акине…. ➡
Dialogue: 0,0:23:01.63,0:23:07.43,Default,,0,0,0,,Мен онымен осылай таныстым>
Dialogue: 0,0:23:10.33,0:23:13.24,Default,,0,0,0,,♬～
Dialogue: 0,0:23:13.24,0:23:18.64,Default,,0,0,0,,♬ "Бұл басталып жатыр. Біз бәріміз осындамыз."
Dialogue: 0,0:23:18.64,0:23:23.15,Default,,0,0,0,,♬ «Мен бұл енді ешқашан болмайтын әлем сияқты сезінемін».
Dialogue: 0,0:23:23.15,0:23:33.86,Default,,0,0,0,,♬～
Dialogue: 0,0:23:33.86,0:23:39.30,Default,,0,0,0,,♬ «Мен кеңсе тауарлары мен сағаттарды кезектесіп қараймын».
Dialogue: 0,0:23:39.30,0:23:44.67,Default,,0,0,0,,♬ «Дәптер жолдары бірден персонал белгісіне ауысады»
Dialogue: 0,0:23:44.67,0:23:49.54,Default,,0,0,0,,♬ «Күн аспанды бір сәтке бұлтқа қалдырады».
Dialogue: 0,0:23:49.54,0:23:55.18,Default,,0,0,0,,♬ «Мұңды скрипка граффити»
Dialogue: 0,0:23:55.18,0:24:04.45,Default,,0,0,0,,♬ «Мектептен кейінгі барлық байланыссыз дыбыстар тыныштандырады».
Dialogue: 0,0:24:04.45,0:24:07.36,Default,,0,0,0,,♬～
Dialogue: 0,0:24:07.36,0:24:12.80,Default,,0,0,0,,♬ «Бұл басталып жатыр, бәріміз осындамыз».
Dialogue: 0,0:24:12.80,0:24:17.63,Default,,0,0,0,,♬ «Мен бұл енді ешқашан болмайтын әлем сияқты сезінемін».
Dialogue: 0,0:24:17.63,0:24:23.27,Default,,0,0,0,,♬ "Мен көбірек ойнағым келеді. Мен көбірек ойнағым келеді."
Dialogue: 0,0:24:23.27,0:24:27.81,Default,,0,0,0,,♬ «Бір реттік шексіз музыка»
Dialogue: 0,0:24:27.81,0:24:30.15,Default,,0,0,0,,♬ «Маған бұл дыбыс ұнайды»
Dialogue: 0,0:24:30.15,0:24:38.96,Default,,0,0,0,,♬～
Dialogue: 0,0:24:40.66,0:24:57.17,Default,,0,0,0,,♬～
