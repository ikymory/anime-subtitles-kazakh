Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.58,0:00:15.61,Default,,0,0,0,,Гррр…
Dialogue: 0,0:00:19.45,0:00:21.32,Default,,0,0,0,,Маған өз қабілеттерімді көрсетейін
Dialogue: 0,0:00:22.62,0:00:23.39,Default,,0,0,0,,Аполлон!
Dialogue: 0,0:00:27.09,0:00:29.06,Default,,0,0,0,,Әрине, үдеткіш
Dialogue: 0,0:00:29.19,0:00:32.56,Default,,0,0,0,,Бұл денені қоршап тұрған жоғары қызба пердесі 3000 градус.
Dialogue: 0,0:00:32.66,0:00:35.73,Default,,0,0,0,,Алақаннан 6000 градус жоғары жылу толқыны
Dialogue: 0,0:00:38.07,0:00:40.74,Default,,0,0,0,,саусақ ұшынан 8000 градус лазер
Dialogue: 0,0:00:43.44,0:00:44.67,Default,,0,0,0,,Енді сіздің кезегіңіз.
Dialogue: 0,0:00:47.61,0:00:50.11,Default,,0,0,0,,Бұл тек үдеткіш емес, солай ма?
Dialogue: 0,0:00:50.65,0:00:53.11,Default,,0,0,0,,Оның тағы қандай өкілеттіктері бар?
Dialogue: 0,0:00:53.45,0:00:54.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:56.15,0:00:57.52,Default,,0,0,0,,００９…
Dialogue: 0,0:00:57.79,0:01:00.32,Default,,0,0,0,,Қалғаны Қалғаны...
Dialogue: 0,0:01:01.36,0:01:02.62,Default,,0,0,0,,Тек батылдық!
Dialogue: 0,0:01:17.77,0:01:22.28,Default,,0,0,0,,Үлкен аға Акира үлкен аға
Dialogue: 0,0:01:22.51,0:01:25.25,Default,,0,0,0,,Сакан тірі ме?
Dialogue: 0,0:01:26.41,0:01:27.15,Default,,0,0,0,,Са-чан!
Dialogue: 0,0:01:27.28,0:01:31.25,Default,,0,0,0,,Мен өлдім мен өлдім
Dialogue: 0,0:01:31.45,0:01:32.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:32.75,0:01:35.32,Default,,0,0,0,,Егер сізде адамдардан асып түсетін күштер болса ше?
Dialogue: 0,0:01:35.42,0:01:37.33,Default,,0,0,0,,Құдай немесе шайтан болудан басқа амалың жоқ.
Dialogue: 0,0:01:39.83,0:01:43.63,Default,,0,0,0,,Осы бейнеге лайық құдай, құдай боламын.
Dialogue: 0,0:01:43.73,0:01:45.27,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:01:50.57,0:01:53.14,Default,,0,0,0,,Қараңызшы, сіз қарсылық көрсетесіз, солай ма?
Dialogue: 0,0:01:53.37,0:01:55.68,Default,,0,0,0,,Сондықтан күресуден басқа амалымыз жоқ
Dialogue: 0,0:01:55.81,0:01:56.68,Default,,0,0,0,,Құт
Dialogue: 0,0:02:00.82,0:02:03.49,Default,,0,0,0,,009… Аполлон…
Dialogue: 0,0:02:05.39,0:02:07.59,Default,,0,0,0,,Мен өлдім.
Dialogue: 0,0:02:07.69,0:02:11.73,Default,,0,0,0,,Мен енді анаммен және әкеммен бірге тұра алмаймын...
Dialogue: 0,0:02:12.63,0:02:14.30,Default,,0,0,0,,Сачан...
Dialogue: 0,0:02:14.43,0:02:17.70,Default,,0,0,0,,Уф, ауырып тұр...
Dialogue: 0,0:02:17.80,0:02:19.77,Default,,0,0,0,,Өлілердің ызаға толы үні
Dialogue: 0,0:02:20.44,0:02:21.50,Default,,0,0,0,,Тозақтың дауысы!
Dialogue: 0,0:02:30.81,0:02:34.25,Default,,0,0,0,,Какакака…
Dialogue: 0,0:02:34.58,0:02:35.92,Default,,0,0,0,,Джинмен!
Dialogue: 0,0:02:36.22,0:02:38.65,Default,,0,0,0,,Сізге ұнады ма? Келіңіздер...
Dialogue: 0,0:02:40.22,0:02:42.66,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:02:45.83,0:02:47.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:48.46,0:02:51.17,Default,,0,0,0,,Мені жеген мұң...
Dialogue: 0,0:02:51.40,0:02:55.57,Default,,0,0,0,,Мені жеген өшпенділік қабықшада пайда болады.
Dialogue: 0,0:02:55.67,0:02:57.87,Default,,0,0,0,,Акира-оний-чан!
Dialogue: 0,0:02:58.67,0:03:00.58,Default,,0,0,0,,Сендер жындарсыңдар
Dialogue: 0,0:03:00.68,0:03:03.21,Default,,0,0,0,,Мен ешқашан жек көрушілікті сезінген емеспін.
Dialogue: 0,0:03:03.71,0:03:08.32,Default,,0,0,0,,Сюй Цзиньмэнь мырза!
Dialogue: 0,0:03:15.52,0:03:18.63,Default,,0,0,0,,Бұл күрес қанша уақытқа созылуы керек?
Dialogue: 0,0:03:18.76,0:03:19.83,Default,,0,0,0,,Соңы бар
Dialogue: 0,0:03:20.36,0:03:23.83,Default,,0,0,0,,Соғысты жалғастырып, аман қалғандар «құдайға» айналуы керек.
Dialogue: 0,0:03:24.87,0:03:27.64,Default,,0,0,0,,Адамдар «Құдайға» мұқтаж болды
Dialogue: 0,0:03:28.20,0:03:31.51,Default,,0,0,0,,Дүние соғыс тарихынан қашып құтыла алмайды.
Dialogue: 0,0:03:31.64,0:03:34.31,Default,,0,0,0,,Қара елес мұны дәлелдейді.
Dialogue: 0,0:03:34.68,0:03:37.58,Default,,0,0,0,,Егер сіз «адам» да, «құдай» да болуға тырыспасаңыз
Dialogue: 0,0:03:37.68,0:03:39.61,Default,,0,0,0,,Сіз жай ғана қоқыссыз
Dialogue: 0,0:03:40.45,0:03:41.25,Default,,0,0,0,,Кеш болды!
Dialogue: 0,0:03:44.32,0:03:46.52,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:03:46.65,0:03:49.79,Default,,0,0,0,,Қуырылған еттің иісі керемет.
Dialogue: 0,0:03:50.29,0:03:53.80,Default,,0,0,0,,Мен де өз қабығыма жүзіңді қосамын.
Dialogue: 0,0:03:54.63,0:03:55.96,Default,,0,0,0,,Какака…
Dialogue: 0,0:03:56.26,0:03:59.50,Default,,0,0,0,,Ештеңеге қарсы тұру мүмкін емес.
Dialogue: 0,0:03:59.67,0:04:01.87,Default,,0,0,0,,Менің ойымша, сіз қарсы тұра алмайсыз.
Dialogue: 0,0:04:01.97,0:04:03.40,Default,,0,0,0,,Мұны жасамаңыз.
Dialogue: 0,0:04:04.64,0:04:09.41,Default,,0,0,0,,Мен сол бала көрген азаптың 1/1000 бөлігін де бастан өткеруім керек.
Dialogue: 0,0:04:09.68,0:04:11.95,Default,,0,0,0,,Мен өзімді кешіре алмадым!
Dialogue: 0,0:04:13.35,0:04:15.95,Default,,0,0,0,,Уууу!
Dialogue: 0,0:04:19.65,0:04:21.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:22.52,0:04:25.83,Default,,0,0,0,,Бұл жігіттер тірі адамдар сияқты.
Dialogue: 0,0:04:25.93,0:04:28.70,Default,,0,0,0,,Сіздің әлі де өз санаңыз бар.
Dialogue: 0,0:04:28.96,0:04:30.43,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:04:30.57,0:04:33.43,Default,,0,0,0,,Какакака... Не болды?
Dialogue: 0,0:04:33.57,0:04:34.74,Default,,0,0,0,,Сіз қоңырау шалмайсыз ба?
Dialogue: 0,0:04:39.04,0:04:40.98,Default,,0,0,0,,Егер күресуден басқа амалымыз болмаса
Dialogue: 0,0:04:41.81,0:04:43.04,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:04:43.44,0:04:46.78,Default,,0,0,0,,Ұрысты аяқтау үшін шайқас жынына айнал
Dialogue: 0,0:04:47.48,0:04:49.95,Default,,0,0,0,,Онда мен сені тозаққа жіберемін.
Dialogue: 0,0:04:54.79,0:04:55.59,Default,,0,0,0,,Елена!
Dialogue: 0,0:04:55.92,0:04:59.89,Default,,0,0,0,,Апа, жіберіңіз, апа, денеңіз...
Dialogue: 0,0:05:00.30,0:05:03.43,Default,,0,0,0,,Аполлон Тірі қалсақ та
Dialogue: 0,0:05:03.53,0:05:05.40,Default,,0,0,0,,Шайқас тарихы ешқашан аяқталмайды
Dialogue: 0,0:05:06.00,0:05:09.47,Default,,0,0,0,,Бірақ егер бұл 009 болса, бір күні
Dialogue: 0,0:05:10.37,0:05:11.07,Default,,0,0,0,,Елена…
Dialogue: 0,0:05:11.47,0:05:15.34,Default,,0,0,0,,Біз құдайға айналып, осы дүниені басқарамыз...
Dialogue: 0,0:05:16.58,0:05:20.48,Default,,0,0,0,,Аполлон, сіз бұрыннан білуіңіз керек.
Dialogue: 0,0:05:21.32,0:05:22.75,Default,,0,0,0,,Апа
Dialogue: 0,0:05:25.59,0:05:27.99,Default,,0,0,0,,Елена!
Dialogue: 0,0:05:32.96,0:05:35.73,Default,,0,0,0,,Ібілісті же!
Dialogue: 0,0:05:35.96,0:05:36.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:37.03,0:05:39.60,Default,,0,0,0,,Бауырым, мына жігітті өлтір.
Dialogue: 0,0:05:39.73,0:05:42.90,Default,,0,0,0,,Мен өлдім мен өлдім
Dialogue: 0,0:05:58.62,0:06:00.66,Default,,0,0,0,,Тоқтатыңыз, тоқтатыңыз.
Dialogue: 0,0:06:00.86,0:06:04.06,Default,,0,0,0,,Қабықты жұлып алсаң, бәрі өледі. Жақсы?
Dialogue: 0,0:06:04.53,0:06:07.76,Default,,0,0,0,,Бірақ сен де өлесің, солай ма?
Dialogue: 0,0:06:07.93,0:06:09.50,Default,,0,0,0,,Қайда барсаң да, қашып құтылуға жібермеймін!
Dialogue: 0,0:06:30.62,0:06:36.06,Default,,0,0,0,,（♪）
Dialogue: 0,0:08:17.73,0:08:19.66,Default,,0,0,0,,Ешқандай шатасу жоқ сияқты.
Dialogue: 0,0:08:19.79,0:08:23.20,Default,,0,0,0,,Ей, денемізді сәл қозғалтайық. Бізге қосылыңыз.
Dialogue: 0,0:08:23.66,0:08:24.80,Default,,0,0,0,,Хой но Хойт
Dialogue: 0,0:08:25.13,0:08:27.27,Default,,0,0,0,,Сіз көбірек дәмді нәрселер жасай аласыз.
Dialogue: 0,0:08:27.57,0:08:31.17,Default,,0,0,0,,А, жақсы иіс шығады. Бұл дәмді көрінеді.
Dialogue: 0,0:08:31.27,0:08:32.21,Default,,0,0,0,,Мен оны алып кетемін
Dialogue: 0,0:08:32.61,0:08:33.81,Default,,0,0,0,,Мен де саған көмектесемін.
Dialogue: 0,0:08:34.01,0:08:35.94,Default,,0,0,0,,Негізінен қара елес
Dialogue: 0,0:08:36.04,0:08:37.81,Default,,0,0,0,,Бірдеңе болса да
Dialogue: 0,0:08:37.95,0:08:41.08,Default,,0,0,0,,Жаңалықтарда көрсетілген ебедейсіз әрекеттерді жасамаңыз.
Dialogue: 0,0:08:41.75,0:08:45.69,Default,,0,0,0,,Бұл шынымен шулы. Тек үндемеңіз және газетті оқыңыз.
Dialogue: 0,0:08:48.02,0:08:49.86,Default,,0,0,0,,Ғұн, газет деген не?
Dialogue: 0,0:08:49.96,0:08:53.13,Default,,0,0,0,,Үлкендерге ыңғайлы мақалалар ғана шығады.
Dialogue: 0,0:08:57.57,0:08:59.17,Default,,0,0,0,,Аруақтармен әңгімелесу?
Dialogue: 0,0:08:59.67,0:09:00.94,Default,,0,0,0,,Тамақтың уақыты келді
Dialogue: 0,0:09:01.14,0:09:01.94,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:05.24,0:09:06.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:08.11,0:09:08.94,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:09.31,0:09:12.98,Default,,0,0,0,,Жел мен жердің рухтары бізге ескертеді...
Dialogue: 0,0:09:13.78,0:09:15.92,Default,,0,0,0,,Бұл соншалықты тыныш емес.
Dialogue: 0,0:09:19.99,0:09:20.72,Default,,0,0,0,,Иван?
Dialogue: 0,0:09:21.99,0:09:24.86,Default,,0,0,0,,Әй, әлі оянатын уақыт емес.
Dialogue: 0,0:09:25.06,0:09:26.86,Default,,0,0,0,,Ескерту Ескерту!
Dialogue: 0,0:09:27.60,0:09:28.66,Default,,0,0,0,,Шайтан келе жатыр!
Dialogue: 0,0:09:29.86,0:09:30.87,Default,,0,0,0,,Ібіліс?
Dialogue: 0,0:09:42.14,0:09:43.28,Default,,0,0,0,,Оны алыңыз!
Dialogue: 0,0:09:44.28,0:09:45.08,Default,,0,0,0,,Ұры!
Dialogue: 0,0:09:46.05,0:09:48.78,Default,,0,0,0,,Жұлып алу? Мен сені ұстаймын, Акира-кун.
Dialogue: 0,0:09:49.02,0:09:50.79,Default,,0,0,0,,Эй, Мики-чан, мені жайына қалдыр.
Dialogue: 0,0:09:52.69,0:09:53.62,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:57.93,0:09:59.03,Default,,0,0,0,,Алға!
Dialogue: 0,0:09:59.16,0:10:00.93,Default,,0,0,0,,Ақымақ болайық!
Dialogue: 0,0:10:01.36,0:10:02.96,Default,,0,0,0,,Ұрлаған нәрсені қайтарыңыз
Dialogue: 0,0:10:03.30,0:10:05.63,Default,,0,0,0,,Әй, мен сені әйел деп ойладым!
Dialogue: 0,0:10:10.17,0:10:12.07,Default,,0,0,0,,Маған жалап жібердің.
Dialogue: 0,0:10:14.61,0:10:15.38,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:10:16.74,0:10:18.65,Default,,0,0,0,,Мұқият қарасаң, ессіз.
Dialogue: 0,0:10:18.78,0:10:20.15,Default,,0,0,0,,Мен сені сүйемін
Dialogue: 0,0:10:20.25,0:10:22.28,Default,,0,0,0,,Жасайық хи-хи...
Dialogue: 0,0:10:22.62,0:10:24.02,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:10:26.69,0:10:29.19,Default,,0,0,0,,Әй, менің қолым ұйып қалды.
Dialogue: 0,0:10:29.36,0:10:30.79,Default,,0,0,0,,Әй, ақымақ, тоқтат!
Dialogue: 0,0:10:33.76,0:10:34.26,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:10:34.36,0:10:35.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:37.16,0:10:39.27,Default,,0,0,0,,Кешіріңіз~ Менің күшім жоқ.
Dialogue: 0,0:10:39.37,0:10:41.40,Default,,0,0,0,,Есіңізде болсын!
Dialogue: 0,0:10:43.37,0:10:44.07,Default,,0,0,0,,Иә
Dialogue: 0,0:10:44.21,0:10:45.41,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:46.07,0:10:47.34,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:10:47.64,0:10:51.28,Default,,0,0,0,,Сіз өзіңізге қауіп төндіресіз.
Dialogue: 0,0:10:59.09,0:11:02.22,Default,,0,0,0,,Мен әлі күнге дейін мұндай ақпаратты таба алмаймын.
Dialogue: 0,0:11:02.36,0:11:03.39,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:11:04.09,0:11:08.96,Default,,0,0,0,,Иван жарты айлық ұйқысынан бір сәт оянып, маған ескерту жасады.
Dialogue: 0,0:11:10.36,0:11:12.03,Default,,0,0,0,,Менің ойымша, бұл аса қауіпті емес.
Dialogue: 0,0:11:12.43,0:11:14.80,Default,,0,0,0,,Аруақтың хабары да болды.
Dialogue: 0,0:11:14.90,0:11:15.44,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:16.30,0:11:18.21,Default,,0,0,0,,Альберто және басқалары да тергеуде
Dialogue: 0,0:11:18.81,0:11:21.24,Default,,0,0,0,,Мұнда мүмкіндігінше көп ақпарат жинайық.
Dialogue: 0,0:11:21.41,0:11:22.24,Default,,0,0,0,,Иә
Dialogue: 0,0:11:29.98,0:11:31.79,Default,,0,0,0,,Бұл Ева Мария Палларес.
Dialogue: 0,0:11:31.99,0:11:33.39,Default,,0,0,0,,Уау, өте әдемі
Dialogue: 0,0:11:33.72,0:11:34.32,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:11:34.96,0:11:36.89,Default,,0,0,0,,Бүгіннен бастап жағдай қызғылт.
Dialogue: 0,0:11:37.02,0:11:39.06,Default,,0,0,0,,Менің орным Макимура-санның қасында.
Dialogue: 0,0:11:39.16,0:11:41.03,Default,,0,0,0,,Иә, мұнда
Dialogue: 0,0:11:43.40,0:11:46.17,Default,,0,0,0,,Мен Мики Макимурамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:11:49.77,0:11:51.17,Default,,0,0,0,,Оқулықтарыңыз бар ма?
Dialogue: 0,0:11:51.74,0:11:53.34,Default,,0,0,0,,Бір күні тозаққа түсіп кетермін.
Dialogue: 0,0:11:53.91,0:11:57.85,Default,,0,0,0,,А, олай емес, Ева-чан терезенің жанында.
Dialogue: 0,0:11:57.95,0:11:59.18,Default,,0,0,0,,А... иә
Dialogue: 0,0:12:01.42,0:12:03.75,Default,,0,0,0,,Мына жерде ақымақтар бар.
Dialogue: 0,0:12:03.88,0:12:05.29,Default,,0,0,0,,Акира-кун деп айтыңыз.
Dialogue: 0,0:12:05.42,0:12:07.89,Default,,0,0,0,,Бұл туралы уайымдамаңыз, өйткені сіз әдеттегі жалқаусыз.
Dialogue: 0,0:12:11.29,0:12:11.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:12.29,0:12:13.23,Default,,0,0,0,,Аньяро
Dialogue: 0,0:12:13.33,0:12:16.46,Default,,0,0,0,,Мен де бүгін бірінші кезеңнен бастап сабақты жіберемін!
Dialogue: 0,0:12:18.00,0:12:21.30,Default,,0,0,0,,Ой, кешіріңіз, қорқудың қажеті жоқ.
Dialogue: 0,0:12:23.20,0:12:24.84,Default,,0,0,0,,Мен мұны қайтадан жасадым
Dialogue: 0,0:12:28.48,0:12:31.11,Default,,0,0,0,,Мені шайтан десең де...
Dialogue: 0,0:12:31.45,0:12:34.45,Default,,0,0,0,,Егер олар Жапонияға көшсе
Dialogue: 0,0:12:35.05,0:12:39.22,Default,,0,0,0,,Фронт-компания, трансұлттық компания, кейбір қадамдар жасауы керек.
Dialogue: 0,0:12:39.52,0:12:42.29,Default,,0,0,0,,Егер басқа оқиға орын алса
Dialogue: 0,0:12:42.39,0:12:45.26,Default,,0,0,0,,Олар көп адам жиналатын жерлерді нысанаға алуы мүмкін.
Dialogue: 0,0:12:45.86,0:12:49.36,Default,,0,0,0,,Алдымен Франсуа екеуміз бірнеше орынды қысқарттық.
Dialogue: 0,0:12:49.76,0:12:51.30,Default,,0,0,0,,Сол жерден көріңіз.
Dialogue: 0,0:12:51.40,0:12:52.23,Default,,0,0,0,,Иә
Dialogue: 0,0:12:59.81,0:13:02.84,Default,,0,0,0,,Қара елес, сен қайдасың?
Dialogue: 0,0:13:09.48,0:13:13.82,Default,,0,0,0,,Экономикалық тұрғыдан бұл шын мәнінде «Ібіліс мұнарасы».
Dialogue: 0,0:13:16.22,0:13:18.86,Default,,0,0,0,,Хехехе... Бұл өте керемет емес пе?
Dialogue: 0,0:13:19.09,0:13:21.83,Default,,0,0,0,,Мен де бұған өте жақсымын, солай ма?
Dialogue: 0,0:13:21.96,0:13:23.56,Default,,0,0,0,,Мен оны дұрыстап қарадым.
Dialogue: 0,0:13:24.50,0:13:26.87,Default,,0,0,0,,Жиль де Рейстің көк сақал аңызы т.б.
Dialogue: 0,0:13:26.97,0:13:29.17,Default,,0,0,0,,Влад Тепес қаңқасы туралы аңыз
Dialogue: 0,0:13:29.94,0:13:32.11,Default,,0,0,0,,Енді интернеттегі қалалық аңыз бетінде.
Dialogue: 0,0:13:32.24,0:13:34.28,Default,,0,0,0,,Бұл біраз әбігерге түседі.
Dialogue: 0,0:13:34.41,0:13:37.31,Default,,0,0,0,,Сіз шайтанды немесе хайуан адамды көрдіңіз дедіңіз.
Dialogue: 0,0:13:37.85,0:13:41.05,Default,,0,0,0,,Сол оқиға туралы аздап айтып бере аласыз ба?
Dialogue: 0,0:13:41.15,0:13:41.88,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:51.83,0:13:54.13,Default,,0,0,0,,Қалайсың? Осы күндеріңіз қалай?
Dialogue: 0,0:13:54.53,0:13:59.00,Default,,0,0,0,,Қауіпті көрінетін кейбір шетелдік капитал бірдеңені көздеп отыр.
Dialogue: 0,0:13:59.13,0:14:02.07,Default,,0,0,0,,Егер солай болса, маған хабарлай аласыз ба?
Dialogue: 0,0:14:03.87,0:14:04.91,Default,,0,0,0,,Ықылық…
Dialogue: 0,0:14:08.01,0:14:10.31,Default,,0,0,0,,Әзірге солай.
Dialogue: 0,0:14:10.41,0:14:11.88,Default,,0,0,0,,Бұл өтірік болуы мүмкін, бірақ
Dialogue: 0,0:14:12.38,0:14:14.28,Default,,0,0,0,,Бұл ұқсас.
Dialogue: 0,0:14:14.45,0:14:17.02,Default,,0,0,0,,Түсіндім, сұрай беремін.
Dialogue: 0,0:14:17.55,0:14:18.42,Default,,0,0,0,,Ықылық…
Dialogue: 0,0:14:19.19,0:14:19.92,Default,,0,0,0,,Керемет?
Dialogue: 0,0:14:20.12,0:14:22.99,Default,,0,0,0,,О, маған массаж жасама, жас досым.
Dialogue: 0,0:14:23.16,0:14:27.26,Default,,0,0,0,,Мейірімді Пюнма сізге міндетті түрде иығын береді.
Dialogue: 0,0:14:27.53,0:14:28.50,Default,,0,0,0,,Ықылық!
Dialogue: 0,0:14:28.60,0:14:29.93,Default,,0,0,0,,Мен бармаймын.
Dialogue: 0,0:14:31.17,0:14:33.27,Default,,0,0,0,,Бұл шайтан туралы қалалық аңыз ба?
Dialogue: 0,0:14:33.90,0:14:37.17,Default,,0,0,0,,Франсуа Оны басқа ақпаратпен тексеріп көрейік
Dialogue: 0,0:14:37.27,0:14:38.01,Default,,0,0,0,,Иә
Dialogue: 0,0:14:38.21,0:14:43.11,Default,,0,0,0,,Мен интернетте барлығынан ақпаратты және байланыс тарихын іздеуге тырыстым.
Dialogue: 0,0:14:43.24,0:14:45.95,Default,,0,0,0,,Бұл жерде «шайтан» сөзі қолданылған.
Dialogue: 0,0:14:46.38,0:14:48.45,Default,,0,0,0,,Ол осы жерде шоғырланған.
Dialogue: 0,0:14:49.02,0:14:51.22,Default,,0,0,0,,Полицияның дерекқорына кіру
Dialogue: 0,0:14:51.45,0:14:54.59,Default,,0,0,0,,Жын құбыжықтарын көргендерін қорытындылау
Dialogue: 0,0:14:56.12,0:14:56.89,Default,,0,0,0,,Осыншама ма?
Dialogue: 0,0:14:56.99,0:14:58.26,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:14:58.36,0:15:00.66,Default,,0,0,0,,Осы ақпаратқа пропорционалды
Dialogue: 0,0:15:00.96,0:15:03.36,Default,,0,0,0,,Бұл жерде із-түзсіз жоғалғандар саны артып келеді.
Dialogue: 0,0:15:03.66,0:15:05.00,Default,,0,0,0,,Франсуа
Dialogue: 0,0:15:05.10,0:15:08.07,Default,,0,0,0,,Осы аумақтың бейнебақылау камерасының түсірілімін көре аламын ба?
Dialogue: 0,0:15:08.20,0:15:08.97,Default,,0,0,0,,Иә
Dialogue: 0,0:15:11.07,0:15:12.54,Default,,0,0,0,,Бұл үлкен сан.
Dialogue: 0,0:15:12.94,0:15:16.68,Default,,0,0,0,,Көру орны мен уақытына байланысты іздеуді қысқартыңыз.
Dialogue: 0,0:15:23.45,0:15:24.15,Default,,0,0,0,,Бұл адамдардың ризашылық сезімі жоқ; тек әртүрлі талап қояды
Dialogue: 0,0:15:24.25,0:15:25.05,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:15:25.15,0:15:25.92,Default,,0,0,0,,Иә
Dialogue: 0,0:15:26.02,0:15:26.99,Default,,0,0,0,,Гү… гүг… Дұрыс.
Dialogue: 0,0:15:27.49,0:15:28.36,Default,,0,0,0,,Тоқтаңыз.
Dialogue: 0,0:15:28.49,0:15:29.26,Default,,0,0,0,,Иә
Dialogue: 0,0:15:31.93,0:15:33.06,Default,,0,0,0,,Бұл шайтан.
Dialogue: 0,0:15:33.26,0:15:35.56,Default,,0,0,0,,Бұл нағыз Әл
Dialogue: 0,0:15:36.10,0:15:39.00,Default,,0,0,0,,Жындар Олимпиада құдайларынан кейін тұр ма?
Dialogue: 0,0:15:40.30,0:15:43.14,Default,,0,0,0,,Бұл аумақ ағаштар теңізінің дәл қасында.
Dialogue: 0,0:15:43.50,0:15:44.51,Default,,0,0,0,,Қара елес
Dialogue: 0,0:15:44.61,0:15:47.51,Default,,0,0,0,,Олар киборгтың жаңа түрімен тәжірибе жасап жатқан болуы мүмкін.
Dialogue: 0,0:15:48.11,0:15:49.24,Default,,0,0,0,,Мен оны қарастырамын.
Dialogue: 0,0:15:49.51,0:15:53.01,Default,,0,0,0,,Мен де барамын. Мен оны қадағалай алатыныма сенімдімін.
Dialogue: 0,0:15:53.41,0:15:54.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:56.42,0:15:59.09,Default,,0,0,0,,Жын сол орманды жамылғы ретінде пайдаланады.
Dialogue: 0,0:15:59.19,0:16:00.72,Default,,0,0,0,,Олар өз ықпалын кеңейтуге тырысатын сияқты.
Dialogue: 0,0:16:03.36,0:16:07.46,Default,,0,0,0,,Басқаша айтқанда, бұл орман біздің аң аулайтын жеріміз де болуы мүмкін.
Dialogue: 0,0:16:07.56,0:16:09.00,Default,,0,0,0,,Аңшылық алқап?
Dialogue: 0,0:16:09.56,0:16:12.13,Default,,0,0,0,,Қарашы, анау, анау, Акира-кун.
Dialogue: 0,0:16:13.00,0:16:13.40,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:19.44,0:16:20.31,Default,,0,0,0,,...
Dialogue: 0,0:16:20.64,0:16:24.28,Default,,0,0,0,,Бұл Ева Чан, бүгін біздің сыныпқа келген ауыспалы студент.
Dialogue: 0,0:16:24.51,0:16:26.68,Default,,0,0,0,,Акира-кунға да жақсылық көрсетіңізші.
Dialogue: 0,0:16:27.41,0:16:29.68,Default,,0,0,0,,Мен Евамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:16:31.39,0:16:32.25,Default,,0,0,0,,Жауап беріңіз!
Dialogue: 0,0:16:32.35,0:16:33.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:33.39,0:16:35.36,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:16:38.16,0:16:42.16,Default,,0,0,0,,Аа, дұрыс. Мен бүгін Рионың үйінде боламын, сондықтан маған кешкі ас қажет емес.
Dialogue: 0,0:16:42.26,0:16:43.66,Default,,0,0,0,,Тағы да?
Dialogue: 0,0:16:44.10,0:16:48.44,Default,,0,0,0,,Мен ол кісіні ұнатпаймын, өйткені ол маған суық болып көрінеді.
Dialogue: 0,0:16:49.17,0:16:50.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:50.14,0:16:51.31,Default,,0,0,0,,Не... не?
Dialogue: 0,0:16:51.41,0:16:52.47,Default,,0,0,0,,Күдікті...
Dialogue: 0,0:16:52.57,0:16:54.24,Default,,0,0,0,,Не ойлап отырсың, ақымақ?
Dialogue: 0,0:16:54.34,0:16:56.44,Default,,0,0,0,,Нихихихи әзіл әзіл
Dialogue: 0,0:16:56.64,0:16:58.41,Default,,0,0,0,,Ауырды, Мики-чан.
Dialogue: 0,0:16:58.55,0:17:01.78,Default,,0,0,0,,Егер сіз келесі жолы әлсіресеңіз, мен сізге енді түскі ас дайындамаймын.
Dialogue: 0,0:17:02.12,0:17:03.38,Default,,0,0,0,,Бұл мәселе
Dialogue: 0,0:17:03.48,0:17:05.45,Default,,0,0,0,,Ита-тат, ауырып тұр!
Dialogue: 0,0:17:10.22,0:17:11.43,Default,,0,0,0,,Джо мен Франсуаза
Dialogue: 0,0:17:11.53,0:17:13.49,Default,,0,0,0,,Жаңа тұтынушыға барасыз ба?
Dialogue: 0,0:17:13.66,0:17:15.06,Default,,0,0,0,,Олардың тәрбиесіне байланысты
Dialogue: 0,0:17:15.53,0:17:16.30,Default,,0,0,0,,Ұлы туралы ше?
Dialogue: 0,0:17:17.53,0:17:18.56,Default,,0,0,0,,Мен оны тастап кеттім.
Dialogue: 0,0:17:18.67,0:17:22.20,Default,,0,0,0,,Уи о~ Шайтанның азғырғанындай
Dialogue: 0,0:17:22.30,0:17:25.07,Default,,0,0,0,,Браунның тегіс тамағы арқылы
Dialogue: 0,0:17:28.41,0:17:30.34,Default,,0,0,0,,Сізді де аңдыды ма?
Dialogue: 0,0:17:31.11,0:17:32.38,Default,,0,0,0,,3-3...
Dialogue: 0,0:17:32.48,0:17:34.82,Default,,0,0,0,,Міне, шайтан келді.
Dialogue: 0,0:17:54.44,0:17:57.44,Default,,0,0,0,,Күн батады, аңшылық басталады.
Dialogue: 0,0:18:08.72,0:18:10.12,Default,,0,0,0,,Отоиши?
Dialogue: 0,0:18:19.66,0:18:21.13,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:18:25.87,0:18:29.54,Default,,0,0,0,,Сіздің мерекеңіз мен үшін демалыс күні.
Dialogue: 0,0:18:35.48,0:18:36.58,Default,,0,0,0,,Гү…
Dialogue: 0,0:18:36.68,0:18:39.38,Default,,0,0,0,,Uuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu] уууууууууууууууууууууууууу] as as as as as as as as as as as as as as as assine ass
Dialogue: 0,0:18:42.78,0:18:45.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:46.32,0:18:50.32,Default,,0,0,0,,Денелеріңізді бізге ұсыныңыз.
Dialogue: 0,0:18:50.42,0:18:51.49,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:19:06.77,0:19:07.64,Default,,0,0,0,,Джо
Dialogue: 0,0:19:07.74,0:19:08.68,Default,,0,0,0,,Франсуа?
Dialogue: 0,0:19:08.84,0:19:11.91,Default,,0,0,0,,Айқай... көптің айғайы
Dialogue: 0,0:19:12.45,0:19:13.41,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:30.60,0:19:32.50,Default,,0,0,0,,Пазузу келе жатыр
Dialogue: 0,0:19:32.60,0:19:35.24,Default,,0,0,0,,Иә, мен де Атун сияқты жақсы емеспін.
Dialogue: 0,0:19:35.34,0:19:39.74,Default,,0,0,0,,Оның байланысы бар. Мен сіздің келісіміңізге ризамын.
Dialogue: 0,0:19:41.54,0:19:44.68,Default,,0,0,0,,Қалғандары Атун мырзаға барады.
Dialogue: 0,0:19:49.22,0:19:50.25,Default,,0,0,0,,Хехе...
Dialogue: 0,0:19:51.19,0:19:52.62,Default,,0,0,0,,Амон, келдің бе?
Dialogue: 0,0:19:53.25,0:19:54.62,Default,,0,0,0,,Амон емес
Dialogue: 0,0:19:55.29,0:19:59.23,Default,,0,0,0,,Мен Ібілісмін, сені жындарды аулайтын адаммын!
Dialogue: 0,0:19:59.96,0:20:02.26,Default,,0,0,0,,Жын? Ібілісші?
Dialogue: 0,0:20:02.86,0:20:04.63,Default,,0,0,0,,Иван айтып отырған шайтан?
Dialogue: 0,0:20:05.70,0:20:07.37,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:20:10.24,0:20:11.24,Default,,0,0,0,,Тс!
Dialogue: 0,0:20:17.51,0:20:20.38,Default,,0,0,0,,Жасырынбақ ойынын аяқтайтын кез келді.
Dialogue: 0,0:20:20.65,0:20:22.68,Default,,0,0,0,,Сіз мұны бірдеңе болғандықтан әкелдіңіз, солай ма?
Dialogue: 0,0:20:22.82,0:20:24.38,Default,,0,0,0,,Мен болжаймын ба?
Dialogue: 0,0:20:24.52,0:20:27.25,Default,,0,0,0,,Қара елестің өлтірушісі?
Dialogue: 0,0:20:27.52,0:20:29.66,Default,,0,0,0,,Әр жолы қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:20:31.99,0:20:33.59,Default,,0,0,0,,ұсақ ұрлық жасап, соққы беріп қашып кету қылмыстарын жасап, полиция көлігінің терезелерін сындыратын
Dialogue: 0,0:20:33.76,0:20:36.90,Default,,0,0,0,,Мен Мифос Киборгты жеңдім.
Dialogue: 0,0:20:40.83,0:20:42.44,Default,,0,0,0,,Бұл пайда болды!
Dialogue: 0,0:20:48.64,0:20:51.45,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:53.78,0:20:56.38,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:20:58.95,0:20:59.75,Default,,0,0,0,,００９
Dialogue: 0,0:21:00.42,0:21:01.82,Default,,0,0,0,,Үш реакция бар.
Dialogue: 0,0:21:02.29,0:21:04.49,Default,,0,0,0,,Олардың екеуі шыңдалған жауынгерлер сияқты.
Dialogue: 0,0:21:04.63,0:21:06.79,Default,,0,0,0,,Өткен деректерге сәйкестік жоқ.
Dialogue: 0,0:21:07.63,0:21:11.33,Default,,0,0,0,,Екіншісі адам, мүмкін Қара елес ғалымы.
Dialogue: 0,0:21:11.97,0:21:15.47,Default,,0,0,0,,Мүмкін олар екі денені шайқастыру арқылы ұрыс деректерін жинап жатқан шығар...
Dialogue: 0,0:21:15.74,0:21:16.60,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:21:22.64,0:21:26.78,Default,,0,0,0,,Адамдардың санасындағы шайтанның бейнесі сияқты!
Dialogue: 0,0:21:28.78,0:21:30.62,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:21:54.61,0:21:59.61,Default,,0,0,0,,Не болды? Жындар нәсілінің ең ұлы қаһарманы Амон пішінсіз.
Dialogue: 0,0:21:59.75,0:22:03.92,Default,,0,0,0,,Тәртіп жоқ! Мен Амон емеспін, мен Ібілісмін.
Dialogue: 0,0:22:24.50,0:22:25.54,Default,,0,0,0,,Мин!
Dialogue: 0,0:22:26.71,0:22:27.87,Default,,0,0,0,,Уф
Dialogue: 0,0:22:32.05,0:22:33.05,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:22:33.88,0:22:34.92,Default,,0,0,0,,Қара елес!
Dialogue: 0,0:22:41.82,0:22:42.86,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:22:43.79,0:22:44.56,Default,,0,0,0,,Ол жоғалды...
Dialogue: 0,0:22:44.83,0:22:48.40,Default,,0,0,0,,көремін. Машинамен біріктірілген жын.
Dialogue: 0,0:22:48.83,0:22:52.13,Default,,0,0,0,,Мен бұл мүмкіндік туралы ойламаған сияқтымын.
Dialogue: 0,0:22:52.70,0:22:54.07,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:23:04.04,0:23:04.81,Default,,0,0,0,,Ібіліс…
Dialogue: 0,0:23:07.81,0:23:08.92,Default,,0,0,0,,үдеткіш!
Dialogue: 0,0:23:12.69,0:23:14.09,Default,,0,0,0,,Жылдам қозғалысты қалай елемеуге болады...
Dialogue: 0,0:23:18.09,0:23:19.56,Default,,0,0,0,,Сіз инстинкт арқылы жалтарып жатырсыз ба?
Dialogue: 0,0:23:23.13,0:23:24.56,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:23:24.63,0:23:25.43,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:23:25.63,0:23:27.47,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:23:27.57,0:23:29.90,Default,,0,0,0,,Уф
Dialogue: 0,0:23:30.94,0:23:32.04,Default,,0,0,0,,Супер мылтық...
Dialogue: 0,0:23:55.56,0:23:56.93,Default,,0,0,0,,009 күресіп жатыр...
Dialogue: 0,0:24:10.81,0:24:12.15,Default,,0,0,0,,Шектегіш жоғалды...
Dialogue: 0,0:24:12.88,0:24:16.05,Default,,0,0,0,,Не болды? Ол кенет ұйқылы-ояу соққыны лақтырды
Dialogue: 0,0:24:17.45,0:24:20.02,Default,,0,0,0,,Сіз не жоспарлап отырсыз, Қара елес?
Dialogue: 0,0:24:21.69,0:24:23.19,Default,,0,0,0,,Иә? Жын емес пе?
Dialogue: 0,0:24:25.16,0:24:28.63,Default,,0,0,0,,Жарайды, жын болмасаң да, осы қабілетің болса болғаны.
Dialogue: 0,0:24:28.76,0:24:31.00,Default,,0,0,0,,Ақырында бірдей қауіпке айналады
Dialogue: 0,0:24:31.67,0:24:34.94,Default,,0,0,0,,Мүмкіндігінше оны ұсақтаңыз. Міне бітті.
Dialogue: 0,0:24:35.90,0:24:37.64,Default,,0,0,0,,Уууу!
Dialogue: 0,0:24:37.77,0:24:38.74,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:24:44.78,0:24:45.65,Default,,0,0,0,,００９！
Dialogue: 0,0:25:02.10,0:25:02.83,Default,,0,0,0,,Мин!
Dialogue: 0,0:25:04.73,0:25:05.27,Default,,0,0,0,,Джо…
Dialogue: 0,0:25:06.00,0:25:08.03,Default,,0,0,0,,Джо!
Dialogue: 0,0:25:11.61,0:25:16.64,Default,,0,0,0,,（♪）
Dialogue: 0,0:25:18.14,0:25:24.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory