Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0000,0000,0000,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0000,0000,0000,,

Dialogue: 0,0:00:01.01,0:00:05.02,JPDB,,0000,0000,0000,,Мен мұны істеймін. Мен бүгін бұл мәселені жеңемін.
Dialogue: 0,0:00:05.39,0:00:07.63,JPDB,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасай аламын. Мен оны істей аламын.
Dialogue: 0,0:00:11.55,0:00:15.03,JPDB,,0000,0000,0000,,Бұл жабысқақ балық иісі және жылылық
Dialogue: 0,0:00:15.48,0:00:19.28,JPDB,,0000,0000,0000,,Неліктен адамдар мұндай нәрсені дәмді дейді?
Dialogue: 0,0:00:19.58,0:00:21.69,JPDB,,0000,0000,0000,,Эй, мына жерде менің помпоным бар...
Dialogue: 0,0:00:24.10,0:00:24.97,JPDB,,0000,0000,0000,,Ол жоғалды.
Dialogue: 0,0:00:25.07,0:00:26.46,JPDB,,0000,0000,0000,,Бұл таңқаларлық, Деко-чан
Dialogue: 0,0:00:26.46,0:00:29.72,JPDB,,0000,0000,0000,,Мен мұны істедім. Мен бәрін іштім.
Dialogue: 0,0:00:29.87,0:00:31.66,JPDB,,0000,0000,0000,,Сіз мүлде ішпейтін шығарсыз.
Dialogue: 0,0:00:31.86,0:00:33.42,JPDB,,0000,0000,0000,,Бұл жалған Морисама шықты
Dialogue: 0,0:00:34.94,0:00:40.95,JPDB,,0000,0000,0000,,Сүтті жеңген бұл Декомори келесі жылы осы уақытта сізге жоғарыдан қарайтын болады.
Dialogue: 0,0:00:41.40,0:00:44.26,JPDB,,0000,0000,0000,,Егер сәждеге баратын болсаң, қазір.
Dialogue: 0,0:00:46.12,0:00:47.07,JPDB,,0000,0000,0000,,Ол тамшылап тұр
Dialogue: 0,0:00:48.09,0:00:52.86,JPDB,,0000,0000,0000,,Математика пәнінің мұғалімі менің бағаларым өте нашар болғандықтан мені шығарып салды.
Dialogue: 0,0:00:53.26,0:00:55.47,JPDB,,0000,0000,0000,,Өйткені олар клубқа рұқсат берді.
Dialogue: 0,0:00:55.99,0:00:59.94,JPDB,,0000,0000,0000,,Кешіріңіз, басқа әлемнің нөлдік базалық жүйесі менің денемнен кетпейді.
Dialogue: 0,0:01:01.21,0:01:05.86,JPDB,,0000,0000,0000,,Бірақ жыл ортасындағы емтиханда 2 ұпай алу мүмкін емес деп ойлаймын.
Dialogue: 0,0:01:06.65,0:01:07.10,JPDB,,0000,0000,0000,,Екі ұпай
Dialogue: 0,0:01:08.62,0:01:10.16,JPDB,,0000,0000,0000,,Нана-чан, бұл қорқынышты.
Dialogue: 0,0:01:10.31,0:01:13.29,JPDB,,0000,0000,0000,,Кешіріңіз, мен абайсызда аузым сырғып кетті.
Dialogue: 0,0:01:13.56,0:01:15.10,JPDB,,0000,0000,0000,,Мен немқұрайлы емеспін.
Dialogue: 0,0:01:15.78,0:01:19.93,JPDB,,0000,0000,0000,,Басқа пәндер жақсы, тек математикадан барынша тырысыңыз.
Dialogue: 0,0:01:20.05,0:01:22.14,JPDB,,0000,0000,0000,,Маған қалдырыңыз, мен ертеңнен бастап салмақты боламын
Dialogue: 0,0:01:22.46,0:01:23.06,JPDB,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:01:23.33,0:01:24.10,JPDB,,0000,0000,0000,,Қорықпа.
Dialogue: 0,0:01:24.50,0:01:29.57,JPDB,,0000,0000,0000,,Олай болса, қорытынды емтиханнан қызыл баға алсаңыз, клуб таратылады.
Dialogue: 0,0:01:30.17,0:01:35.68,JPDB,,0000,0000,0000,,Мен математика мұғаліміне айтамын. Рикка-чанның мотивацияланғанына қуаныштымын.
Dialogue: 0,0:01:37.03,0:01:38.04,JPDB,,0000,0000,0000,,Уф! Босат! Мені босат!
Dialogue: 0,0:01:39.24,0:01:39.78,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:01:40.31,0:01:40.73,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:01:41.45,0:01:43.66,JPDB,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:00:00.00,0:00:00.00,JPDB,,0000,0000,0000,,Бондаж…Кросс (Қатты зерттеу)
Dialogue: 0,0:03:24.67,0:03:28.84,JPDB,,0000,0000,0000,,Клуб іс-шараларына мүлдем бара алмағаныма сен кінәлісің.
Dialogue: 0,0:03:29.19,0:03:33.74,JPDB,,0000,0000,0000,,Жалған мори жазы күткендей, ол шіріген сүттің иісіне ұқсайды.
Dialogue: 0,0:03:34.29,0:03:36.23,JPDB,,0000,0000,0000,,О, рас, сасық...
Dialogue: 0,0:03:37.87,0:03:39.58,JPDB,,0000,0000,0000,,Мен аға болсам да
Dialogue: 0,0:03:39.68,0:03:42.07,JPDB,,0000,0000,0000,,Одан кейін аға сияқты әрекет ет.
Dialogue: 0,0:03:42.07,0:03:42.89,JPDB,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:03:43.19,0:03:47.39,JPDB,,0000,0000,0000,,Ұстаз, мен күте алмадым. Қызметкерлер бөлмесінде не болды?
Dialogue: 0,0:03:47.88,0:03:48.98,JPDB,,0000,0000,0000,,Төтенше жағдайдың жариялануы
Dialogue: 0,0:03:49.35,0:03:50.89,JPDB,,0000,0000,0000,,А, көк өрнек
Dialogue: 0,0:03:50.94,0:03:52.48,JPDB,,0000,0000,0000,,Істі қиындатпаңыз
Dialogue: 0,0:03:57.13,0:04:01.50,JPDB,,0000,0000,0000,,Эй... BGM де жақсы
Dialogue: 0,0:04:02.35,0:04:04.73,JPDB,,0000,0000,0000,,Эй, бұл не болды?
Dialogue: 0,0:04:06.60,0:04:07.42,JPDB,,0000,0000,0000,,Сүттің иісі бар.
Dialogue: 0,0:04:07.69,0:04:09.18,JPDB,,0000,0000,0000,,Жарайды, сөйлес.
Dialogue: 0,0:04:10.95,0:04:11.62,JPDB,,0000,0000,0000,,Математика?
Dialogue: 0,0:04:12.19,0:04:16.49,JPDB,,0000,0000,0000,,Аа, келесі тоқсанның соңында қызыл ұпай алсам, бұл жерді таратамын.
Dialogue: 0,0:04:18.25,0:04:21.31,JPDB,,0000,0000,0000,,Бұл жаман нәрсе емес. Олар бәрібір белсенді емес.
Dialogue: 0,0:04:21.31,0:04:27.45,JPDB,,0000,0000,0000,,Жоқ, бұл қымбат ұйықтау клубы. Мен жастығыма көбірек уақыт бөлуім керек.
Dialogue: 0,0:04:28.00,0:04:28.77,JPDB,,0000,0000,0000,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:04:29.29,0:04:29.79,JPDB,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:04:31.65,0:04:34.81,JPDB,,0000,0000,0000,,Жастық шағыңды өзіңмен өткіз.
Dialogue: 0,0:04:35.45,0:04:40.00,JPDB,,0000,0000,0000,,Морисама-чан көрінгеннен гөрі томпақ.
Dialogue: 0,0:04:42.49,0:04:44.08,JPDB,,0000,0000,0000,,​​Бұл жігіт ақымақ.
Dialogue: 0,0:04:44.08,0:04:45.89,JPDB,,0000,0000,0000,,Мен сенің мұны айтқаныңды қаламаймын.
Dialogue: 0,0:04:46.12,0:04:49.57,JPDB,,0000,0000,0000,,Міне, солай болды, сондықтан бұл жігіттер мерзімнің соңына дейін тыныш болады...
Dialogue: 0,0:04:50.57,0:04:51.81,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:52.26,0:04:53.52,JPDB,,0000,0000,0000,,Жауапты шығару
Dialogue: 0,0:04:56.58,0:05:02.79,JPDB,,0000,0000,0000,,Бұл дүниедегі ақыл, даналық және ақылды рухтар осында жиналып, менің бұйрықтарымды орындаңдар.
Dialogue: 0,0:05:06.22,0:05:08.29,JPDB,,0000,0000,0000,,Бұл әлі де бар ма?
Dialogue: 0,0:05:08.71,0:05:10.45,JPDB,,0000,0000,0000,,Декомори Жақсы уақыт
Dialogue: 0,0:05:12.64,0:05:14.45,JPDB,,0000,0000,0000,,Сонымен, жауап
Dialogue: 0,0:05:14.82,0:05:16.81,JPDB,,0000,0000,0000,,Шамамен сексен екі...
Dialogue: 0,0:05:16.99,0:05:19.84,JPDB,,0000,0000,0000,,Сіз болжап отырсыз ба? Сіз бұл жерде де қателесесіз.
Dialogue: 0,0:05:20.46,0:05:22.65,JPDB,,0000,0000,0000,,Шешімі дұрыс болса да, мұнда көбейту
Dialogue: 0,0:05:23.10,0:05:25.39,JPDB,,0000,0000,0000,,Жетпіс төрт, аздап күшті қарсылас
Dialogue: 0,0:05:26.68,0:05:31.05,JPDB,,0000,0000,0000,,47 соншалықты күшті емес, бірақ басқа түстегі 74 күшті.
Dialogue: 0,0:05:32.00,0:05:35.25,JPDB,,0000,0000,0000,,Менің ойымша, бұл жігіт мұндай сиқырды қолданатын сияқты.
Dialogue: 0,0:05:36.02,0:05:41.57,JPDB,,0000,0000,0000,,Мен түсінемін. Жетінші кезеңнің қиындығы соңғы кезеңге қарағанда көп. Деңгейді көтеру міндетті болып табылады.
Dialogue: 0,0:05:42.06,0:05:46.88,JPDB,,0000,0000,0000,,Мен 7856 жаста өзін патша сияқты сезінетініне сенімдімін.
Dialogue: 0,0:05:47.43,0:05:49.64,JPDB,,0000,0000,0000,,Оны еңсеру – соңғы кезең, тоғызыншы кезең.
Dialogue: 0,0:05:50.81,0:05:52.78,JPDB,,0000,0000,0000,,9763 жылғы бірінші нысан
Dialogue: 0,0:05:53.82,0:05:55.81,JPDB,,0000,0000,0000,,9872 жылғы екінші түрі
Dialogue: 0,0:05:56.70,0:06:00.01,JPDB,,0000,0000,0000,,Ал 9981 жылдың соңғы түріне
Dialogue: 0,0:06:01.47,0:06:02.67,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:03.81,0:06:07.74,JPDB,,0000,0000,0000,,Қалай болғанда да, біз осы абайсыз қателерді азайта алсақ.
Dialogue: 0,0:06:07.04,0:06:09.15,JPDB,,0000,0000,0000,,Жарайды, мына жігітке ат қояйық.
Dialogue: 0,0:06:09.63,0:06:11.37,JPDB,,0000,0000,0000,,Шичизо «зұлым сайқымазақ» ма?
Dialogue: 0,0:06:11.42,0:06:13.53,JPDB,,0000,0000,0000,,Кішкентай шабаққа ұқсайтын атау жақсырақ болар еді.
Dialogue: 0,0:06:13.70,0:06:15.09,JPDB,,0000,0000,0000,,Сондықтан оны тоқтат.
Dialogue: 0,0:06:18.45,0:06:20.09,JPDB,,0000,0000,0000,,Зұлым патшаның Шинганының бұйрығымен
Dialogue: 0,0:06:20.69,0:06:27.02,JPDB,,0000,0000,0000,,Жаныңызды, етіңізді және сүйегіңізді жинаңыз және математика емтиханында қызыл баға алудан аулақ болыңыз.
Dialogue: 0,0:06:27.45,0:06:27.92,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:06:28.44,0:06:29.88,JPDB,,0000,0000,0000,,Сіз кенеттен Құдайға үміт артасыз ба?
Dialogue: 0,0:06:30.35,0:06:33.69,JPDB,,0000,0000,0000,,Мен мұны сұраған жоқпын, зұлым патшаның Шинғанынан бұйырдым.
Dialogue: 0,0:06:33.93,0:06:34.38,JPDB,,0000,0000,0000,,болып табылады
Dialogue: 0,0:06:36.99,0:06:38.68,JPDB,,0000,0000,0000,,Тоқта, жазаланасың.
Dialogue: 0,0:06:39.13,0:06:41.27,JPDB,,0000,0000,0000,,Сіз бастауыш сынып оқушысы шығарсыз.
Dialogue: 0,0:06:41.71,0:06:43.45,JPDB,,0000,0000,0000,,Неге біз бірге дұға етпейміз?
Dialogue: 0,0:06:43.80,0:06:48.08,JPDB,,0000,0000,0000,,Декомори қожайынның қызметшісі және оның табиғи жұмысы - шайқаста көмектесу.
Dialogue: 0,0:06:48.65,0:06:51.01,JPDB,,0000,0000,0000,,Оның орнына өзіңіздің қабылдау емтиханыңыз туралы алаңдаңыз.
Dialogue: 0,0:06:52.95,0:06:56.33,JPDB,,0000,0000,0000,,Сіздің орта мектебіңізге ұсыныстар қазірдің өзінде шешілді.
Dialogue: 0,0:06:57.20,0:07:00.30,JPDB,,0000,0000,0000,,Сіз? Қиялдарыңызды қалдырыңыз.
Dialogue: 0,0:07:00.30,0:07:04.83,JPDB,,0000,0000,0000,,Өтірік емес, Деко-чан, мен сенің бағаларың өз сыныбыңда жоғары деп естідім.
Dialogue: 0,0:07:05.22,0:07:08.51,JPDB,,0000,0000,0000,,Өтірік, бұл жігіт өз сыныбының жоғарысы.
Dialogue: 0,0:07:12.08,0:07:12.98,JPDB,,0000,0000,0000,,Бірдеңе
Dialogue: 0,0:07:13.38,0:07:14.35,JPDB,,0000,0000,0000,,Қате
Dialogue: 0,0:07:15.29,0:07:19.62,JPDB,,0000,0000,0000,,Әсіресе математикада оқушылар орта мектеп курсын аяқтап үлгерді.
Dialogue: 0,0:07:19.79,0:07:22.50,JPDB,,0000,0000,0000,,Орта мектептегі проблемаларға келетін болсақ, бұл бір түйір торт.
Dialogue: 0,0:07:22.92,0:07:25.03,JPDB,,0000,0000,0000,,Шынымен бе? Сонымен, бұл мәселе
Dialogue: 0,0:07:25.13,0:07:30.03,JPDB,,0000,0000,0000,,Мен көремін. Жауабы минус 8 дәрежесіне x3.
Dialogue: 0,0:07:32.42,0:07:33.01,JPDB,,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:07:33.46,0:07:38.50,JPDB,,0000,0000,0000,,Бұл негіздердің негіздері. Сіз мұны істей алмаймын деп айтасыз ба?
Dialogue: 0,0:07:38.50,0:07:42.83,JPDB,,0000,0000,0000,,Масса... академиялық қабілетіңізбен емтихан тапсыратыныңызға сене алмаймын.
Dialogue: 0,0:07:43.55,0:07:46.98,JPDB,,0000,0000,0000,,Ұстаз күткендей, сіз жасырын күшіңізді пайдаландыңыз.
Dialogue: 0,0:07:48.72,0:07:50.41,JPDB,,0000,0000,0000,,​​Мен аяғыма тұра алмайтындай сезінемін.
Dialogue: 0,0:07:50.98,0:07:54.36,JPDB,,0000,0000,0000,,Смартфондарға келетін болсақ, бұл 300% зиян сияқты.
Dialogue: 0,0:07:57.07,0:07:59.51,JPDB,,0000,0000,0000,,Мен қызыл нүктеден қалай да аулақ бола аламын деп үміттенемін.
Dialogue: 0,0:07:59.83,0:08:01.25,JPDB,,0000,0000,0000,,Түптеп келгенде бұл Құдайға байланысты.
Dialogue: 0,0:08:02.39,0:08:03.61,JPDB,,0000,0000,0000,,Жарайды, Рикка-чан.
Dialogue: 0,0:08:04.13,0:08:05.89,JPDB,,0000,0000,0000,,О, Хисатами, қандай да бір жоспар бар.
Dialogue: 0,0:08:06.49,0:08:12.60,JPDB,,0000,0000,0000,,Опцияларды таппай қалсаңыз, мен сізге сүйікті қарындашымды беремін.
Dialogue: 0,0:08:13.87,0:08:16.01,JPDB,,0000,0000,0000,,1-сұрақ: А бұрышының бұрышы неге тең?
Dialogue: 0,0:08:23.79,0:08:25.01,JPDB,,0000,0000,0000,,4 Жауап
Dialogue: 0,0:08:25.40,0:08:25.80,JPDB,,0000,0000,0000,,Үш
Dialogue: 0,0:08:27.12,0:08:30.20,JPDB,,0000,0000,0000,,Өтінемін, Рикка-чан қызыл дақтан аулақ болсын.
Dialogue: 0,0:08:30.38,0:08:32.16,JPDB,,0000,0000,0000,,Бұл жігіттер жақсы емес.
Dialogue: 0,0:08:32.99,0:08:33.76,JPDB,,0000,0000,0000,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:08:35.02,0:08:35.76,JPDB,,0000,0000,0000,,Жұмыс?
Dialogue: 0,0:08:36.22,0:08:39.55,JPDB,,0000,0000,0000,,Иә, біздің бірлестік әлі күнге дейін клуб болып саналады.
Dialogue: 0,0:08:40.29,0:08:43.08,JPDB,,0000,0000,0000,,Кампус иерархиясының төменгі жағында орналасқан
Dialogue: 0,0:08:43.65,0:08:46.01,JPDB,,0000,0000,0000,,Мен мектепке үлес қосып, қызмет етемін.
Dialogue: 0,0:08:46.21,0:08:49.07,JPDB,,0000,0000,0000,,Пайдалы болу – біздің шынайы қалауымыз, өмір сүру себебіміз
Dialogue: 0,0:08:49.07,0:08:50.03,JPDB,,0000,0000,0000,,Оқыма, оқыма
Dialogue: 0,0:08:50.18,0:08:52.52,JPDB,,0000,0000,0000,,Сонымен, сіздің жұмысыңыз бар ма?
Dialogue: 0,0:08:52.77,0:08:57.84,JPDB,,0000,0000,0000,,Иә, бұл мұғалімдерді ``Ой, бұл клуб болса жақсы болар еді'' деп ойлайтын жұмыс.
Dialogue: 0,0:08:58.54,0:09:01.02,JPDB,,0000,0000,0000,,Бұл жігіт шынымен де оқығысы келмейді.
Dialogue: 0,0:09:01.67,0:09:04.30,JPDB,,0000,0000,0000,,Иә, бар
Dialogue: 0,0:09:04.57,0:09:05.25,JPDB,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:09:05.54,0:09:08.35,JPDB,,0000,0000,0000,,Бұл өте қиын жұмыс. Сенімен бәрі жақсы ма?
Dialogue: 0,0:09:08.53,0:09:10.27,JPDB,,0000,0000,0000,,Жарайды, Юта осында.
Dialogue: 0,0:09:10.59,0:09:11.04,JPDB,,0000,0000,0000,,Эй
Dialogue: 0,0:09:12.20,0:09:16.90,JPDB,,0000,0000,0000,,Ал, кеттік. «Мжолнир Аксель».
Dialogue: 0,0:09:17.30,0:09:18.37,JPDB,,0000,0000,0000,,Түсіндіруге рұқсат етіңіз
Dialogue: 0,0:09:18.69,0:09:21.82,JPDB,,0000,0000,0000,,“Mjolnir Accel” дегеніміз не? Ол төменгі дене нервтеріне сиқырлы қуатты зарядтай алады.
Dialogue: 0,0:09:21.82,0:09:25.55,JPDB,,0000,0000,0000,,Құю арқылы спорттық қабілетін қалыпты деңгейден 3,88 есеге дейін арттырады
Dialogue: 0,0:09:25.68,0:09:28.76,JPDB,,0000,0000,0000,,Бұл жоғары жылдамдықты қозғалысқа мүмкіндік беретін техника.
Dialogue: 0,0:09:30.72,0:09:35.07,JPDB,,0000,0000,0000,,Бұл жеделдету күші дыбыс жылдамдығына барады.
Dialogue: 0,0:09:35.74,0:09:40.39,JPDB,,0000,0000,0000,,Ол соқтығысқан сияқты көрінеді, бірақ соңғы минутта тоқтайды.
Dialogue: 0,0:09:40.39,0:09:43.20,JPDB,,0000,0000,0000,,Жүр, тез істе.
Dialogue: 0,0:09:43.89,0:09:47.25,JPDB,,0000,0000,0000,,Негізінде мені неге сүйреп шығару керек?
Dialogue: 0,0:09:47.80,0:09:50.03,JPDB,,0000,0000,0000,,Нана-чан барлық мүшелердің қатысқанын айтады.
Dialogue: 0,0:09:50.75,0:09:53.07,JPDB,,0000,0000,0000,,Мүше болғаным есімде жоқ.
Dialogue: 0,0:09:56.12,0:09:57.32,JPDB,,0000,0000,0000,,Сіз клубқа қосылуға өтініш берген болуыңыз керек.
Dialogue: 0,0:09:57.69,0:10:00.52,JPDB,,0000,0000,0000,,Мен жай ғана сол орта мектеп діни қызметкерімен байланысуға тырыстым.
Dialogue: 0,0:10:00.94,0:10:02.73,JPDB,,0000,0000,0000,,Мен жай ғана черлидермін
Dialogue: 0,0:10:03.33,0:10:04.97,JPDB,,0000,0000,0000,,Кешіріңіз, менің қолым тайып кетті.
Dialogue: 0,0:10:07.13,0:10:10.31,JPDB,,0000,0000,0000,,Бірақ черлидинг клубындағы үлкендер сонша шулы.
Dialogue: 0,0:10:10.61,0:10:13.27,JPDB,,0000,0000,0000,,Барудан шаршап бара жатқаныңызды айттыңыз.
Dialogue: 0,0:10:13.27,0:10:15.33,JPDB,,0000,0000,0000,,Неге бассейнге жастық әкелдің?
Dialogue: 0,0:10:15.68,0:10:16.43,JPDB,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:10:17.02,0:10:18.43,JPDB,,0000,0000,0000,,Ах, ол тек телефон арқылы сөйлескенін айтты.
Dialogue: 0,0:10:19.16,0:10:22.02,JPDB,,0000,0000,0000,,Маған онша қызық болмады.
Dialogue: 0,0:10:22.49,0:10:24.02,JPDB,,0000,0000,0000,,Сонда неге кірдің?
Dialogue: 0,0:10:24.58,0:10:27.91,JPDB,,0000,0000,0000,,Сынып мүшесі және черлидер Чуунибиоға қарама-қарсы болады.
Dialogue: 0,0:10:28.43,0:10:30.59,JPDB,,0000,0000,0000,,Менің ойымша, бұл кейіпкерді өзгертудің ең жақсы жолы.
Dialogue: 0,0:10:30.87,0:10:34.99,JPDB,,0000,0000,0000,,Оны неге сонша өзгерткіңіз келеді? Chuunibyo қызық сияқты.
Dialogue: 0,0:10:34.99,0:10:36.26,JPDB,,0000,0000,0000,,Қызық емес
Dialogue: 0,0:10:36.54,0:10:37.53,JPDB,,0000,0000,0000,,Неге?
Dialogue: 0,0:10:37.53,0:10:38.67,JPDB,,0000,0000,0000,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:10:39.10,0:10:41.16,JPDB,,0000,0000,0000,,Бұл өмірдің соңы.
Dialogue: 0,0:10:41.43,0:10:44.07,JPDB,,0000,0000,0000,,Бұл әшкереленген ұят сияқты.
Dialogue: 0,0:10:44.19,0:10:46.05,JPDB,,0000,0000,0000,,Мен мұнымен толықтай келісемін.
Dialogue: 0,0:10:46.58,0:10:51.87,JPDB,,0000,0000,0000,,​​Мен солай деп ойлаймын, бірақ Рикка-чан мен басқалары қатты итеріп жатқан жоқ сияқты.
Dialogue: 0,0:10:54.45,0:10:56.79,JPDB,,0000,0000,0000,,Неге бұлай айтып ұйықтауға тырысып жатырсың?
Dialogue: 0,0:10:57.11,0:10:59.97,JPDB,,0000,0000,0000,,Саған да жұмыс істеу керек, жүр.
Dialogue: 0,0:10:58.31,0:10:59.97,JPDB,,0000,0000,0000,,«Шварцкаттер»
Dialogue: 0,0:11:03.70,0:11:07.06,JPDB,,0000,0000,0000,,Ге〇долба Ге〇долбаны нысанаға алады
Dialogue: 0,0:11:09.07,0:11:13.24,JPDB,,0000,0000,0000,,Мен сенің сол шіріген жүрегіңді жуамын, екіжүзді.
Dialogue: 0,0:11:13.79,0:11:15.63,JPDB,,0000,0000,0000,,Жоғалу, жоғалу.
Dialogue: 0,0:11:16.25,0:11:20.58,JPDB,,0000,0000,0000,,Сен, алданып қалма.
Dialogue: 0,0:11:21.97,0:11:25.45,JPDB,,0000,0000,0000,,Бұл «Жаратылыс» ескі мен жаңаның арасындағы жекпе-жек пе?
Dialogue: 0,0:11:25.52,0:11:27.26,JPDB,,0000,0000,0000,,Неге мен түсінбейтін нәрсені айтып тұрсың?
Dialogue: 0,0:11:27.49,0:11:29.20,JPDB,,0000,0000,0000,,Жарайды, шлангты төмен түсіріңіз.
Dialogue: 0,0:11:29.20,0:11:30.69,JPDB,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:11:31.91,0:11:34.07,JPDB,,0000,0000,0000,,Маған қалдыр, Декомори, мен саған күшімді беремін.
Dialogue: 0,0:11:35.24,0:11:36.07,JPDB,,0000,0000,0000,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:11:36.51,0:11:38.15,JPDB,,0000,0000,0000,,Evileye Shoot
Dialogue: 0,0:11:38.57,0:11:41.08,JPDB,,0000,0000,0000,,Менің күшім толып жатыр
Dialogue: 0,0:11:42.30,0:11:47.07,JPDB,,0000,0000,0000,,Күшпен бірге бол, одан аулақ бол, одан аулақ бол, одан аулақ бол.
Dialogue: 0,0:11:49.38,0:11:53.96,JPDB,,0000,0000,0000,,Мен бассейнде үш сағат бойы мүлде тазаламай ойнадым.
Dialogue: 0,0:11:54.10,0:11:55.72,JPDB,,0000,0000,0000,,Жоқ, олай емес...
Dialogue: 0,0:11:56.49,0:12:01.56,JPDB,,0000,0000,0000,,Бірақ дене шынықтыру пәнінің мұғалімі менің мүлде әдемі көрінбегеніме ашуланды.
Dialogue: 0,0:12:02.31,0:12:06.01,JPDB,,0000,0000,0000,,Бірақ тазалық міндетін мойнына алған қоғамның беделі көтерілген болуы керек.
Dialogue: 0,0:12:07.87,0:12:10.21,JPDB,,0000,0000,0000,,Өкінішке орай, бәрі басқаша болды.
Dialogue: 0,0:12:11.35,0:12:16.00,JPDB,,0000,0000,0000,,Математика пәнінің мұғалімі бұл туралы естігенде, ол: ``Тек қызыл баға алу жеткіліксіз'' деді.
Dialogue: 0,0:12:16.60,0:12:19.38,JPDB,,0000,0000,0000,,«Маған кем дегенде орташа балл алуыңыз керек».
Dialogue: 0,0:12:20.72,0:12:21.82,JPDB,,0000,0000,0000,,Орташа балл…
Dialogue: 0,0:12:22.64,0:12:23.68,JPDB,,0000,0000,0000,,Уф! Босат! Мені босат!
Dialogue: 0,0:12:24.95,0:12:25.60,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:12:26.22,0:12:26.69,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:12:27.61,0:12:29.94,JPDB,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:12:38.67,0:12:41.25,JPDB,,0000,0000,0000,,Бұл менің ағам.
Dialogue: 0,0:12:41.73,0:12:42.99,JPDB,,0000,0000,0000,,Рикка-чанның орнында
Dialogue: 0,0:12:45.75,0:12:49.18,JPDB,,0000,0000,0000,,Сізге не қызық? Қарап көрейін бе?
Dialogue: 0,0:12:49.63,0:12:52.02,JPDB,,0000,0000,0000,,Неге, маған бәрібір.
Dialogue: 0,0:12:52.16,0:12:54.48,JPDB,,0000,0000,0000,,Неліктен жасөспірім ұлдар мен қыздар?
Dialogue: 0,0:12:54.72,0:12:59.62,JPDB,,0000,0000,0000,,Егер жағдай осылай жалғаса берсе, Кузуханың інісі, мен бұл ұры мысықтың қолына түсемін деген ойым жоқ.
Dialogue: 0,0:13:00.04,0:13:03.57,JPDB,,0000,0000,0000,,Енді осылай айтсам, әкем маған ашуланады.
Dialogue: 0,0:13:03.77,0:13:08.69,JPDB,,0000,0000,0000,,Мен Джакартаға жаңа ғана қоңырау шалдым, олар: "Әй, кел, қара. Кел, қара" деді.
Dialogue: 0,0:13:08.97,0:13:10.69,JPDB,,0000,0000,0000,,Бұл жұп дәл
Dialogue: 0,0:13:12.10,0:13:15.30,JPDB,,0000,0000,0000,,Мен сенен тағы сұраймын. Сіз оқуды шындап жоспарлап отырсыз.
Dialogue: 0,0:13:15.95,0:13:16.62,JPDB,,0000,0000,0000,,Әрине
Dialogue: 0,0:13:17.34,0:13:20.25,JPDB,,0000,0000,0000,,Сізге айтайын, менің орта мектебімде ауытқу көрсеткіші жоғары.
Dialogue: 0,0:13:20.55,0:13:23.83,JPDB,,0000,0000,0000,,Орташа балл алғың келсе, көп оқымайынша үлгере алмайсың.
Dialogue: 0,0:13:24.40,0:13:25.25,JPDB,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:13:26.09,0:13:27.48,JPDB,,0000,0000,0000,,Жарайды, онда мен саған айтамын.
Dialogue: 0,0:13:28.25,0:13:29.67,JPDB,,0000,0000,0000,,Негізгі мәселеден бастайық.
Dialogue: 0,0:13:30.22,0:13:35.09,JPDB,,0000,0000,0000,,Екі сүйекті шайқаңыз және айналдырылған сандардың қосындысы 3 болу ықтималдығын табыңыз. Сіз мұны істей аласыз ба?
Dialogue: 0,0:13:35.49,0:13:36.03,JPDB,,0000,0000,0000,,Капипа
Dialogue: 0,0:13:36.73,0:13:39.78,JPDB,,0000,0000,0000,,Солай бола тұра, бұл әлі де тәртіпсіздік.
Dialogue: 0,0:13:40.28,0:13:41.65,JPDB,,0000,0000,0000,,Сәл жинап болған соң
Dialogue: 0,0:13:43.26,0:13:44.01,JPDB,,0000,0000,0000,,Менің жеңуімнің себебі…
Dialogue: 0,0:13:44.58,0:13:44.86,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:45.23,0:13:48.96,JPDB,,0000,0000,0000,,Мен сүйекті лақтырған адамның сезімін ойласам, түсінемін деп ойлап, оны тарттым.
Dialogue: 0,0:13:49.38,0:13:53.26,JPDB,,0000,0000,0000,,Бірақ мен елестеткеннен де көп, мен бұл жігіттің не ойлап жатқанын білмеймін.
Dialogue: 0,0:13:54.27,0:13:56.91,JPDB,,0000,0000,0000,,Демек, бұл сіздің шынайы күшіңіз.
Dialogue: 0,0:13:57.36,0:14:00.21,JPDB,,0000,0000,0000,,Жоқ, мен әлі байыпты болған жоқпын.
Dialogue: 0,0:14:00.41,0:14:01.36,JPDB,,0000,0000,0000,,Сіз жай ғана айтқыңыз келеді.
Dialogue: 0,0:14:01.83,0:14:05.29,JPDB,,0000,0000,0000,,Бұған көмектесу мүмкін емес, сондықтан оны сәл ертерек жасайық.
Dialogue: 0,0:14:06.28,0:14:08.34,JPDB,,0000,0000,0000,,Оған дейін бәрін жасайсың ба?
Dialogue: 0,0:14:08.81,0:14:12.37,JPDB,,0000,0000,0000,,Алтын ереже - түсінгеніңізден бастап, осындай әрекеттерді ретімен орындау.
Dialogue: 0,0:14:14.63,0:14:15.03,JPDB,,0000,0000,0000,,Қазір
Dialogue: 0,0:14:15.20,0:14:15.48,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:16.84,0:14:17.69,JPDB,,0000,0000,0000,,​​Мұнда ешкім жоқ.
Dialogue: 0,0:14:17.69,0:14:18.23,JPDB,,0000,0000,0000,,Жоқ, болды.
Dialogue: 0,0:14:20.82,0:14:21.76,JPDB,,0000,0000,0000,,Юта қауіпті
Dialogue: 0,0:14:22.56,0:14:23.76,JPDB,,0000,0000,0000,,және эволюцияның соңғы сатысына жете отырып, мінсіз жаратылыстарға айналамыз.
Dialogue: 0,0:14:25.39,0:14:28.62,JPDB,,0000,0000,0000,,Юута Токи: Сегіз санында қандай сиқырлы күш бар?
Dialogue: 0,0:14:28.62,0:14:29.82,JPDB,,0000,0000,0000,,Мен тіпті ол қолға түспеймін.
Dialogue: 0,0:14:30.06,0:14:30.56,JPDB,,0000,0000,0000,,Чи
Dialogue: 0,0:14:31.23,0:14:32.87,JPDB,,0000,0000,0000,,Сіз дәл қазір "чи" деп айтқаныңыз анық.
Dialogue: 0,0:14:33.94,0:14:34.54,JPDB,,0000,0000,0000,,Отыру
Dialogue: 0,0:14:36.33,0:14:38.42,JPDB,,0000,0000,0000,,Сіз жай ғана байсалды екеніңізді айттыңыз.
Dialogue: 0,0:14:39.04,0:14:39.56,JPDB,,0000,0000,0000,,Шынайы
Dialogue: 0,0:14:40.23,0:14:42.91,JPDB,,0000,0000,0000,,Мен мұны шындап істейтінімді айттым, сондықтан маған хабарлаңыз.
Dialogue: 0,0:14:43.41,0:14:43.96,JPDB,,0000,0000,0000,,деді
Dialogue: 0,0:14:45.03,0:14:49.40,JPDB,,0000,0000,0000,,Бірақ математика нашар. Мен олардың не ойлайтынын білмеймін.
Dialogue: 0,0:14:50.00,0:14:53.88,JPDB,,0000,0000,0000,,Жалпы айтқанда, сүйек алу ықтималдығын білудің қандай пайдасы бар?
Dialogue: 0,0:14:54.07,0:14:55.19,JPDB,,0000,0000,0000,,Кенеттен шындықты айтпа
Dialogue: 0,0:14:56.91,0:14:58.62,JPDB,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:14:59.27,0:15:00.62,JPDB,,0000,0000,0000,,Мінез бұзылған.
Dialogue: 0,0:15:01.70,0:15:02.65,JPDB,,0000,0000,0000,,Ал, әзірге.
Dialogue: 0,0:15:02.95,0:15:03.64,JPDB,,0000,0000,0000,,Үзіліс үшін
Dialogue: 0,0:15:05.03,0:15:06.00,JPDB,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:15:06.00,0:15:07.15,JPDB,,0000,0000,0000,,Жұмысты аяқтаған кезде байсалды болыңыз
Dialogue: 0,0:15:08.04,0:15:09.15,JPDB,,0000,0000,0000,,Өзіңізді шаймен де сыйлаңыз.
Dialogue: 0,0:15:13.51,0:15:14.03,JPDB,,0000,0000,0000,,Таку
Dialogue: 0,0:15:17.39,0:15:19.30,JPDB,,0000,0000,0000,,Әпке, сіз әлі үйге келген жоқсыз.
Dialogue: 0,0:15:19.72,0:15:24.10,JPDB,,0000,0000,0000,,Иә, Юта не ішеді? Юта?
Dialogue: 0,0:15:24.10,0:15:25.99,JPDB,,0000,0000,0000,,Не болса да.
Dialogue: 0,0:15:27.50,0:15:30.26,JPDB,,0000,0000,0000,,Докудами шайы Нони шырыны Кабаноана шайы
Dialogue: 0,0:15:30.39,0:15:31.53,JPDB,,0000,0000,0000,,Бұл қандай құрам?
Dialogue: 0,0:15:34.14,0:15:38.26,JPDB,,0000,0000,0000,,Суға салмасаң, кір жабысып қалады. Жуғыш затты қарызға алмаңыз.
Dialogue: 0,0:15:41.10,0:15:42.07,JPDB,,0000,0000,0000,,Не үшін жуу?
Dialogue: 0,0:15:42.37,0:15:47.61,JPDB,,0000,0000,0000,,Неге екенін білмеймін, бірақ мен кірмін, басқа шаруам жоқ.
Dialogue: 0,0:15:49.77,0:15:50.99,JPDB,,0000,0000,0000,,Бұл ұстаным қандай?
Dialogue: 0,0:15:52.03,0:15:52.99,JPDB,,0000,0000,0000,,Рахмет
Dialogue: 0,0:15:54.44,0:15:57.00,JPDB,,0000,0000,0000,,Не, рахмет айтуға ұялдыңыз ба?
Dialogue: 0,0:15:58.87,0:16:00.63,JPDB,,0000,0000,0000,,Тоқта, не?
Dialogue: 0,0:16:01.28,0:16:02.15,JPDB,,0000,0000,0000,,Діни қызметкерден
Dialogue: 0,0:16:02.97,0:16:04.09,JPDB,,0000,0000,0000,,Тука-сан?
Dialogue: 0,0:16:06.15,0:16:06.95,JPDB,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:16:07.62,0:16:10.35,JPDB,,0000,0000,0000,,Қалыпты сиқырлы күш Сиқырды басқару бюросында өлшенді.
Dialogue: 0,0:16:10.58,0:16:11.35,JPDB,,0000,0000,0000,,Өтірік айту жақсы
Dialogue: 0,0:16:12.02,0:16:14.87,JPDB,,0000,0000,0000,,Мен үйге әрқашан кеш қайтамын.
Dialogue: 0,0:16:15.40,0:16:16.09,JPDB,,0000,0000,0000,,Әрқашан солай ма?
Dialogue: 0,0:16:16.84,0:16:18.78,JPDB,,0000,0000,0000,,Әр жұмыс күні дерлік
Dialogue: 0,0:16:24.32,0:16:27.05,JPDB,,0000,0000,0000,,Мен Ютаның "Электро протокол кодын" естіген жоқпын
Dialogue: 0,0:16:27.70,0:16:28.69,JPDB,,0000,0000,0000,,Электрондық пошта мекенжайы?
Dialogue: 0,0:16:28.99,0:16:32.92,JPDB,,0000,0000,0000,,Бұл дұрыс, мүмкіндігінше тезірек инфрақұрылым қызыл күні байланысы.
Dialogue: 0,0:16:33.54,0:16:34.44,JPDB,,0000,0000,0000,,Инфрақызыл?
Dialogue: 0,0:16:34.78,0:16:35.55,JPDB,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:16:37.22,0:16:37.89,JPDB,,0000,0000,0000,,Мен оны саған жіберемін
Dialogue: 0,0:16:41.99,0:16:43.76,JPDB,,0000,0000,0000,,Ютаның коды керемет
Dialogue: 0,0:16:43.95,0:16:47.14,JPDB,,0000,0000,0000,,О? Керемет, қарапайым емес...
Dialogue: 0,0:16:49.12,0:16:51.53,JPDB,,0000,0000,0000,,Кіші мектептегідей жоғалып кетті
Dialogue: 0,0:16:51.53,0:16:53.87,JPDB,,0000,0000,0000,,«Құдай экссеед фрея магна»
Dialogue: 0,0:16:53.87,0:16:58.12,JPDB,,0000,0000,0000,,Тоқта, қатты айтпа. Мен оны бірден өзгертемін. Сәл күте тұрыңыз.
Dialogue: 0,0:16:58.25,0:17:01.97,JPDB,,0000,0000,0000,,Жоқ, менікі қалыпты, мұны өзгертіңіз
Dialogue: 0,0:17:02.77,0:17:05.28,JPDB,,0000,0000,0000,,Иә, Юта, менің кодымды көрсетіңіз.
Dialogue: 0,0:17:05.63,0:17:06.00,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:06.32,0:17:08.16,JPDB,,0000,0000,0000,,Юта жақсы нәрсе ойлап табуы керек.
Dialogue: 0,0:17:08.76,0:17:11.47,JPDB,,0000,0000,0000,,О, жоқ, мен қазір жеткілікті алысқа бара аламын деп ойлаймын.
Dialogue: 0,0:17:12.79,0:17:14.45,JPDB,,0000,0000,0000,,Содан кейін Юта кодын пайдаланыңыз
Dialogue: 0,0:17:14.45,0:17:18.05,JPDB,,0000,0000,0000,,Бұл жақсы емес. Әлде мен оны өзгертуім керек пе?
Dialogue: 0,0:17:18.38,0:17:18.92,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:17:19.45,0:17:24.89,JPDB,,0000,0000,0000,,Қараңызшы, егер сіз оны өзгерткіңіз келсе, орта мектептегі достарыңызбен және отбасыңызбен байланысуыңыз керек.
Dialogue: 0,0:17:25.51,0:17:26.23,JPDB,,0000,0000,0000,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:17:26.78,0:17:28.97,JPDB,,0000,0000,0000,,Егер сіз діни қызметкер мен Декомориге айтсаңыз
Dialogue: 0,0:17:29.91,0:17:30.68,JPDB,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:17:31.48,0:17:35.75,JPDB,,0000,0000,0000,,Қазіргі кеңістікте мені танитын жалғыз мен ғана.
Dialogue: 0,0:17:43.83,0:17:45.87,JPDB,,0000,0000,0000,,Бірақ егер Юта маған айтса
Dialogue: 0,0:17:46.76,0:17:49.37,JPDB,,0000,0000,0000,,Мен Юта, Нибутани және Хисамиге де сабақ беремін.
Dialogue: 0,0:17:55.19,0:17:55.81,JPDB,,0000,0000,0000,,Бір сәт осында кел.
Dialogue: 0,0:17:56.03,0:17:57.81,JPDB,,0000,0000,0000,,Эх, Хокудами шайы...
Dialogue: 0,0:17:59.68,0:18:01.72,JPDB,,0000,0000,0000,,Емтихан болатын күнге дейін сені шындап оқытамын
Dialogue: 0,0:18:02.44,0:18:03.89,JPDB,,0000,0000,0000,,Сондықтан сіз де бар күшіңізді салуыңыз керек.
Dialogue: 0,0:18:04.58,0:18:05.08,JPDB,,0000,0000,0000,,Юта…
Dialogue: 0,0:18:06.74,0:18:08.38,JPDB,,0000,0000,0000,,Бұл сіз жасаған клуб болуы керек.
Dialogue: 0,0:18:09.13,0:18:09.48,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:18:10.55,0:18:17.75,JPDB,,0000,0000,0000,,Егер сіз орташа баллдан асып кетсеңіз, мен сізге ұнайтын «хаттама кодын» шығарамын.
Dialogue: 0,0:18:20.29,0:18:20.79,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:18:26.48,0:18:27.50,JPDB,,0000,0000,0000,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:18:27.50,0:18:29.41,JPDB,,0000,0000,0000,,Неге... мұнда неге келдің?
Dialogue: 0,0:18:29.68,0:18:34.18,JPDB,,0000,0000,0000,,Үйге келсем, сендер назар аудармастан сабақ оқып жатсыңдар.
Dialogue: 0,0:18:34.48,0:18:35.97,JPDB,,0000,0000,0000,,Мазасыздық деп ойлап шықтым.
Dialogue: 0,0:18:37.02,0:18:38.28,JPDB,,0000,0000,0000,,Иә, мен оны жаза алдым.
Dialogue: 0,0:18:40.27,0:18:41.66,JPDB,,0000,0000,0000,,Бұл сенің соңың.
Dialogue: 0,0:18:45.24,0:18:47.43,JPDB,,0000,0000,0000,,Мен ол балаларды өсіремін.
Dialogue: 0,0:18:50.01,0:18:52.95,JPDB,,0000,0000,0000,,Балаңызды айына бір рет көремін деген уәдені ұмытпаңыз.
Dialogue: 0,0:18:53.20,0:18:55.98,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз? Юмеха, сен де не істеп жатырсың?
Dialogue: 0,0:18:56.23,0:18:59.73,JPDB,,0000,0000,0000,,Жоқ, жай ғана кездейсоқ оқиғада шындық жоқ.
Dialogue: 0,0:18:59.83,0:19:00.70,JPDB,,0000,0000,0000,,Тым көп
Dialogue: 0,0:19:01.22,0:19:02.70,JPDB,,0000,0000,0000,,Мәселе бар ма?
Dialogue: 0,0:19:03.41,0:19:03.93,JPDB,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:19:04.26,0:19:07.81,JPDB,,0000,0000,0000,,Ал, мен үйге баруым керек пе?
Dialogue: 0,0:19:08.51,0:19:11.22,JPDB,,0000,0000,0000,,Ол өз үстелінде ұйықтай бастады, сондықтан мен оны төсекке жатқыздым.
Dialogue: 0,0:19:11.66,0:19:14.45,JPDB,,0000,0000,0000,,Түсінемін, мен қызғанамын.
Dialogue: 0,0:19:15.17,0:19:15.37,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:21.73,0:19:22.85,JPDB,,0000,0000,0000,,Бір аптадан кейін
Dialogue: 0,0:19:24.02,0:19:26.87,JPDB,,0000,0000,0000,,Егер сіз бұл мәселені шеше алсаңыз, мен сізге ұнайтын сағызды ойнатамын.
Dialogue: 0,0:19:28.56,0:19:29.58,JPDB,,0000,0000,0000,,Сиқырлы қуатты арттыру
Dialogue: 0,0:19:32.47,0:19:36.22,JPDB,,0000,0000,0000,,Мен алдап жүріп Рикканы оқуға түсіріп алдым және әйтеуір емтиханға түстім.
Dialogue: 0,0:19:37.09,0:19:41.86,JPDB,,0000,0000,0000,,Енді математика емтиханын бастайық. Қоңырау естілгенше қарамаңыз.
Dialogue: 0,0:19:44.00,0:19:47.38,JPDB,,0000,0000,0000,,Мен көре аламын, көремін
Dialogue: 0,0:19:48.27,0:19:50.19,JPDB,,0000,0000,0000,,бастайық
Dialogue: 0,0:19:52.17,0:19:54.31,JPDB,,0000,0000,0000,,Мен көремін… Мен көремін…
Dialogue: 0,0:19:59.61,0:20:02.07,JPDB,,0000,0000,0000,,Жарылсын, шын, жарылсын, синапс
Dialogue: 0,0:20:02.79,0:20:05.89,JPDB,,0000,0000,0000,,Бұл әлемді қуу
Dialogue: 0,0:20:07.09,0:20:13.38,JPDB,,0000,0000,0000,,Мен оны сонда көре аламын, мен де оны көре аламын
Dialogue: 0,0:20:14.39,0:20:20.11,JPDB,,0000,0000,0000,,Мен іздеген нұр, жауап, жауап...
Dialogue: 0,0:20:25.33,0:20:26.00,JPDB,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:20:29.16,0:20:30.23,JPDB,,0000,0000,0000,,Және бірнеше күннен кейін
Dialogue: 0,0:20:31.64,0:20:35.15,JPDB,,0000,0000,0000,,Мен өзімді елеусіз қалдырдым.
Dialogue: 0,0:20:39.85,0:20:40.47,JPDB,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:20:41.93,0:20:47.85,JPDB,,0000,0000,0000,,Бұл жолы барлығы нашар болды. Орташа балл 50 ұпайды құрады. Қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:20:51.18,0:20:51.58,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:56.75,0:20:57.99,JPDB,,0000,0000,0000,,Қандай күш!
Dialogue: 0,0:20:58.46,0:21:00.15,JPDB,,0000,0000,0000,,Ара-тұра тыныш жүріңіз.
Dialogue: 0,0:21:01.02,0:21:05.02,JPDB,,0000,0000,0000,,​​Дұрыс, Юта менің «протокол кодын» ұмытып қалды.
Dialogue: 0,0:21:06.04,0:21:06.89,JPDB,,0000,0000,0000,,Е, сен не туралы айтып тұрсың?
Dialogue: 0,0:21:09.72,0:21:11.71,JPDB,,0000,0000,0000,,Мен жай ғана қалжыңдап тұрмын. Мен бұл туралы ойладым.
Dialogue: 0,0:21:12.45,0:21:13.62,JPDB,,0000,0000,0000,,Бүгінгі күн ерекше.
Dialogue: 0,0:21:18.94,0:21:23.46,JPDB,,0000,0000,0000,,Зұлым патшаның шынайы көзі пайдаланушысы, мен сіздің күш-жігеріңіз бен жетістіктеріңізді осы жолы мадақтағым келеді.
Dialogue: 0,0:21:23.69,0:21:27.19,JPDB,,0000,0000,0000,,Мен, Қараңғы жалынның шебері, қараңғылықтың күшін жинаймын.
Dialogue: 0,0:21:27.34,0:21:29.48,JPDB,,0000,0000,0000,,Біз сізге сәйкес кодты жасадық.
Dialogue: 0,0:21:29.95,0:21:31.91,JPDB,,0000,0000,0000,,Жүрегіңе штамп ойып ал
Dialogue: 0,0:21:33.33,0:21:36.54,JPDB,,0000,0000,0000,,«Протокол коды» ойылған
Dialogue: 0,0:21:42.38,0:21:45.31,JPDB,,0000,0000,0000,,«Black Raison Detre»
Dialogue: 0,0:21:45.76,0:21:48.14,JPDB,,0000,0000,0000,,Шын мәні - «қараның өмір сүру себебі»
Dialogue: 0,0:21:48.49,0:21:50.28,JPDB,,0000,0000,0000,,Бұл сізге дұрыс код болуы мүмкін.
Dialogue: 0,0:21:50.63,0:21:53.04,JPDB,,0000,0000,0000,,Салқын салқын Юта
Dialogue: 0,0:21:54.31,0:21:54.98,JPDB,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:21:55.38,0:21:57.81,JPDB,,0000,0000,0000,,Мен мұны қанша уақыттан бері істеп жүрмін?
Dialogue: 0,0:21:59.33,0:22:01.69,JPDB,,0000,0000,0000,,Сәл күте тұрыңыз...
Dialogue: 0,0:01:58.53,0:02:02.50,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:02:02.73,0:02:09.29,JPOP,,0000,0000,0000,karaoke,Маған таң қалдырмас бұрын сіз не ойладыңыз?
Dialogue: 0,0:02:09.51,0:02:13.54,JPOP,,0000,0000,0000,karaoke,Маған қараңдаршы еріндері
Dialogue: 0,0:02:13.76,0:02:19.08,JPOP,,0000,0000,0000,karaoke,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:02:19.43,0:02:24.78,JPOP,,0000,0000,0000,karaoke,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:02:25.27,0:02:30.69,JPOP,,0000,0000,0000,karaoke,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:02:31.39,0:02:36.23,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарсылықсыз тартылатын махаббат
Dialogue: 0,0:02:36.58,0:02:41.05,JPOP,,0000,0000,0000,karaoke,Ол әлдеқашан басталған болатын
Dialogue: 0,0:02:42.07,0:02:44.43,JPOP,,0000,0000,0000,karaoke,Мен көптеген армандарды көрдім
Dialogue: 0,0:02:44.46,0:02:48.34,JPOP,,0000,0000,0000,karaoke,Оянсам да сені көргім келеді.
Dialogue: 0,0:02:48.34,0:02:50.55,JPOP,,0000,0000,0000,karaoke,Сіз мұны жасадыңыз
Dialogue: 0,0:02:50.55,0:02:52.96,JPOP,,0000,0000,0000,karaoke,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:02:52.96,0:02:58.53,JPOP,,0000,0000,0000,karaoke,Жүрегіміз секіріп бара жатқандай, қайда барайық
Dialogue: 0,0:02:58.53,0:03:01.14,JPOP,,0000,0000,0000,karaoke,Идеалдар, адасулар және шындық
Dialogue: 0,0:03:01.26,0:03:03.77,JPOP,,0000,0000,0000,karaoke,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:03:04.00,0:03:09.12,JPOP,,0000,0000,0000,karaoke,Жаңа әлемге
Dialogue: 0,0:01:58.53,0:02:02.50,ZWOP,,0000,0000,0000,karaoke,Сіз екі көзбен осы сәттесіз
Dialogue: 0,0:02:02.75,0:02:09.29,ZWOP,,0000,0000,0000,karaoke,Қозғалмас бұрын қаланың қай жерінде екеніңізді көре аласыз.
Dialogue: 0,0:02:09.51,0:02:13.54,ZWOP,,0000,0000,0000,karaoke,Менің тұмсығыма қара
Dialogue: 0,0:02:13.76,0:02:19.08,ZWOP,,0000,0000,0000,karaoke,Жиналыстың сұрағы `` Мен мұны істегім келеді '' Сондай-ақ, үндемеңіз.
Dialogue: 0,0:02:19.43,0:02:24.78,ZWOP,,0000,0000,0000,karaoke,Моңғолияның өз бетінше сөйлесуі
Dialogue: 0,0:02:25.27,0:02:30.69,ZWOP,,0000,0000,0000,karaoke,Қайта оқудың қажеті жоқ.
Dialogue: 0,0:02:31.39,0:02:36.23,ZWOP,,0000,0000,0000,karaoke,Өзара тартымдылық махаббат
Dialogue: 0,0:02:36.58,0:02:41.05,ZWOP,,0000,0000,0000,karaoke,Жаңа ғана басталды
Dialogue: 0,0:02:42.07,0:02:44.43,ZWOP,,0000,0000,0000,karaoke,Шектеусіз әдемі армандар
Dialogue: 0,0:02:44.46,0:02:48.34,ZWOP,,0000,0000,0000,karaoke,Бұл түстен оянғаннан кейін де оны көру керек.
Dialogue: 0,0:02:48.34,0:02:50.55,ZWOP,,0000,0000,0000,karaoke,Капитал зиянды
Dialogue: 0,0:02:50.55,0:02:52.96,ZWOP,,0000,0000,0000,karaoke,Махаббат - махаббаттың шынайы табиғаты.
Dialogue: 0,0:02:52.96,0:02:58.53,ZWOP,,0000,0000,0000,karaoke,Будданың ішкі сезімдері оның кетуінің нәтижесі.
Dialogue: 0,0:02:58.53,0:03:01.14,ZWOP,,0000,0000,0000,karaoke,Күмән жоқ - идеал, адасушылық - шындық
Dialogue: 0,0:03:01.26,0:03:03.77,ZWOP,,0000,0000,0000,karaoke,Барлық астаналар сіздің кезегіңізде келді.
Dialogue: 0,0:03:04.00,0:03:09.12,ZWOP,,0000,0000,0000,karaoke,Жаңа дүниеден шығу
Dialogue: 0,0:01:58.53,0:02:02.50,JPOP,,0000,0000,0000,fx,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:02:02.73,0:02:09.29,JPOP,,0000,0000,0000,fx,Маған таң қалдырмас бұрын не ойладыңыз?
Dialogue: 0,0:02:09.51,0:02:13.54,JPOP,,0000,0000,0000,fx,Маған қарашы еріндері
Dialogue: 0,0:02:13.76,0:02:19.08,JPOP,,0000,0000,0000,fx,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:02:19.43,0:02:24.78,JPOP,,0000,0000,0000,fx,Алаяқтықтан кейінгі монолог
Dialogue: 0,0:02:25.27,0:02:30.69,JPOP,,0000,0000,0000,fx,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:02:31.39,0:02:36.23,JPOP,,0000,0000,0000,fx,Сізді бір-біріңізге тартатын махаббат
Dialogue: 0,0:02:36.58,0:02:41.05,JPOP,,0000,0000,0000,fx,Ол әлдеқашан басталған болатын
Dialogue: 0,0:02:42.07,0:02:44.43,JPOP,,0000,0000,0000,fx,Менің көп арманым болды
Dialogue: 0,0:02:44.46,0:02:48.34,JPOP,,0000,0000,0000,fx,Оянсам да сені көргім келеді.
Dialogue: 0,0:02:48.34,0:02:50.55,JPOP,,0000,0000,0000,fx,Сіз мұны жасадыңыз
Dialogue: 0,0:02:50.55,0:02:52.96,JPOP,,0000,0000,0000,fx,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:02:52.96,0:02:58.53,JPOP,,0000,0000,0000,fx,Бізді секіртетін жүрекке ерейік
Dialogue: 0,0:02:58.53,0:03:01.14,JPOP,,0000,0000,0000,fx,Идеалдар, адасулар және шындық
