Dialogue: 0,0:22:16.78,0:22:19.29,JPED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:22:19.29,0:22:21.06,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:32.19,0:22:34.70,JPED,,0000,0000,0000,,Түсініспеушілік ұят па?
Dialogue: 0,0:22:34.70,0:22:37.03,JPED,,0000,0000,0000,,Адалдық ауыртады.
Dialogue: 0,0:22:37.36,0:22:39.92,JPED,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:22:39.92,0:22:42.35,JPED,,0000,0000,0000,,Мен ненің дұрыс екенін білмеймін
Dialogue: 0,0:22:42.55,0:22:45.16,JPED,,0000,0000,0000,,Әдеттегідей ағып жатқан күнделікті өмірде
Dialogue: 0,0:22:45.28,0:22:47.62,JPED,,0000,0000,0000,,Мен өзімді соған үйренуге мәжбүр еттім.
Dialogue: 0,0:22:47.62,0:22:50.25,JPED,,0000,0000,0000,,Суға батқан тұлға және қан
Dialogue: 0,0:22:50.45,0:22:52.67,JPED,,0000,0000,0000,,Шайнаңыз, ішіңіз, түкіріңіз және сындырыңыз
Dialogue: 0,0:22:52.67,0:22:57.09,JPED,,0000,0000,0000,,Мені осылай түсінгеніңізді қалаймын
Dialogue: 0,0:22:57.36,0:23:02.66,JPED,,0000,0000,0000,,Мен бірдеңе айтқым келеді, бірақ айта алмаймын.
Dialogue: 0,0:23:02.66,0:23:07.45,JPED,,0000,0000,0000,,Неге ешкім түсінбейді?
Dialogue: 0,0:23:07.68,0:23:12.62,JPED,,0000,0000,0000,,Ойлану сән-салтанат па? Солай ма?
Dialogue: 0,0:23:12.62,0:23:17.79,JPED,,0000,0000,0000,,Эмоциялық күн - бұл
Dialogue: 0,0:23:18.04,0:23:20.73,JPED,,0000,0000,0000,,Тым көп қызу
Dialogue: 0,0:23:20.73,0:23:23.01,JPED,,0000,0000,0000,,Менің ойымша, бұл қандай да бір жолмен жүзеге асады
Dialogue: 0,0:23:23.16,0:23:28.08,JPED,,0000,0000,0000,,Айқайлағым келеді
Dialogue: 0,0:23:28.08,0:23:34.00,JPED,,0000,0000,0000,,ТҮСІКТІЛІКТІ іздеп жатыр
Dialogue: 0,0:23:34.27,0:23:36.76,JPED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:23:36.76,0:23:39.29,JPED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,JPED,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:23:41.85,0:23:43.85,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:16.78,0:22:19.29,ZWED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:22:19.29,0:22:21.06,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:22:32.19,0:22:34.70,ZWED,,0000,0000,0000,,Мен аудиториядан алған әсерге ұяламын.
Dialogue: 0,0:22:34.70,0:22:37.03,ZWED,,0000,0000,0000,,Жұртшылықтың алған әсерлеріне шынайы шолу
Dialogue: 0,0:22:37.36,0:22:39.92,ZWED,,0000,0000,0000,,Бұған күмән жоқ
Dialogue: 0,0:22:39.92,0:22:42.35,ZWED,,0000,0000,0000,,Белгісіз байлығымды түзететініме сенімдімін.
Dialogue: 0,0:22:42.55,0:22:45.16,ZWED,,0000,0000,0000,,Өзін-өзі анықтауды зерттеу
Dialogue: 0,0:22:45.28,0:22:47.62,ZWED,,0000,0000,0000,,Ичитоу Фуканнан келген Хико
Dialogue: 0,0:22:47.62,0:22:50.25,ZWED,,0000,0000,0000,,Шогунның толық эго және қан
Dialogue: 0,0:22:50.45,0:22:52.67,ZWED,,0000,0000,0000,,Шайнау, жұту, түкіру, ойнау
Dialogue: 0,0:22:52.67,0:22:57.09,ZWED,,0000,0000,0000,,Сіз мұны түсінесіз деп үміттенемін.
Dialogue: 0,0:22:57.36,0:23:02.66,ZWED,,0000,0000,0000,,Күтпеген ойлар ашылуы мүмкін.
Dialogue: 0,0:23:02.66,0:23:07.45,ZWED,,0000,0000,0000,,Мен адам қалмағанын түсінемін.
Dialogue: 0,0:23:07.68,0:23:12.62,ZWED,,0000,0000,0000,,Егер сізді түсінгіңіз келсе, солай етіңіз.
Dialogue: 0,0:23:12.62,0:23:17.79,ZWED,,0000,0000,0000,,Бұл жақсы сезінетін күн
Dialogue: 0,0:23:18.04,0:23:20.73,ZWED,,0000,0000,0000,,Радиациялық жылу сыйымдылығы
Dialogue: 0,0:23:20.73,0:23:23.01,ZWED,,0000,0000,0000,,Өзін ләззатқа ұшырататын теріс қылықтар
Dialogue: 0,0:23:23.16,0:23:28.08,ZWED,,0000,0000,0000,,Заңсыз шектеу кенеттен шабуыл жасауға шақырады
Dialogue: 0,0:23:28.08,0:23:34.00,ZWED,,0000,0000,0000,,ТҰРҒЫНДАР
Dialogue: 0,0:23:34.27,0:23:36.76,ZWED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:23:36.76,0:23:39.29,ZWED,,0000,0000,0000,,МЕНІҢ ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,ZWED,,0000,0000,0000,,Қажетсіз кедергі
Dialogue: 0,0:23:41.85,0:23:43.85,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:03:13.92,0:03:23.93,ZZ信息,,0000,0000,0000,,Бұл субтитрлер топтамасы субтитрлер тобында көрсетіледі және көбірек қытай, жапон және қытай субтитрлері алмасу үшін қолжетімді. www.kamigami.org
Dialogue: 0,0:03:13.92,0:03:23.93,ZZ信息,,0000,0000,0000,,...
Dialogue: 0,0:03:23.93,0:03:29.89,ZWBT,,0000,0000,0000,,Жинақталған…Крест (Шигешиге Манабу)
Dialogue: 0,0:05:50.45,0:05:52.95,ZZ1,,0000,0000,0000,,9-дан 7-ге дейінгі әңгімелер
Dialogue: 0,0:05:53.70,0:05:56.20,ZZ1,,0000,0000,0000,,9-дан 8 сөзге дейінгі әңгімелер
Dialogue: 0,0:22:04.09,0:22:06.09,ZZ2,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:23:54.82,0:23:59.86,ZZ3,,0000,0000,0000,,Шиможикан Канаме
Dialogue: 0,0:23:54.82,0:23:59.86,ZZ4,,0000,0000,0000,,- -
Dialogue: 0,0:00:01.01,0:00:05.02,ZWDB,,0000,0000,0000,,Қазір кейбір нәрселерді жеңу керек.
Dialogue: 0,0:00:05.39,0:00:07.63,ZWDB,,0000,0000,0000,,Каю Ногё Ногё
Dialogue: 0,0:00:11.55,0:00:15.03,ZWDB,,0000,0000,0000,,Тұтқыр дәм мен сәл жылы ауыздың түрлі түрлері
Dialogue: 0,0:00:15.48,0:00:19.28,ZWDB,,0000,0000,0000,,Шығыс пен Батыс помещиктерінің кездесулері туралы мәліметтер
Dialogue: 0,0:00:19.58,0:00:21.69,ZWDB,,0000,0000,0000,,Менің оқиғам: мен жақын жерде допты көрдім.
Dialogue: 0,0:00:24.10,0:00:24.97,ZWDB,,0000,0000,0000,,Уши…өлді
Dialogue: 0,0:00:25.07,0:00:26.46,ZWDB,,0000,0000,0000,,Кішкентай дөңес
Dialogue: 0,0:00:26.46,0:00:29.72,ZWDB,,0000,0000,0000,,Мен келдім, бір бөтелке сиыр етін ішіп біттім.
Dialogue: 0,0:00:29.87,0:00:31.66,ZWDB,,0000,0000,0000,,Толық қолжетімсіз
Dialogue: 0,0:00:31.86,0:00:33.42,ZWDB,,0000,0000,0000,,Сыртқы түрі: Adventure Forest Adult
Dialogue: 0,0:00:34.94,0:00:40.95,ZWDB,,0000,0000,0000,,Біз сиырлардың дөңес қорғанысын жеңіп, келесі жылы жағдайдың шыңына жеттік.
Dialogue: 0,0:00:41.40,0:00:44.26,ZWDB,,0000,0000,0000,,Тізерлеп тұрып, қазір менімен сөйлесіңіз.
Dialogue: 0,0:00:46.12,0:00:47.07,ZWDB,,0000,0000,0000,,Ушигарю аяқталды
Dialogue: 0,0:00:48.09,0:00:52.86,ZWDB,,0000,0000,0000,,Бұл жетістіктің табысына қол жеткізілді.
Dialogue: 0,0:00:53.26,0:00:55.47,ZWDB,,0000,0000,0000,,Бұл клубты ратификациялауымның себебі.
Dialogue: 0,0:00:55.99,0:00:59.94,ZWDB,,0000,0000,0000,,Құшағы жеткілікті, әлемді өзінше пайдаланатын нөлдік жүйенің әсері
Dialogue: 0,0:01:01.21,0:01:05.86,ZWDB,,0000,0000,0000,,Дегенмен, орта мектеп кезінде де оқу мүмкін емес.
Dialogue: 0,0:01:06.65,0:01:07.10,ZWDB,,0000,0000,0000,,Екі минут…
Dialogue: 0,0:01:08.62,0:01:10.16,ZWDB,,0000,0000,0000,,Кішкентай жеті күн өтті
Dialogue: 0,0:01:10.31,0:01:13.29,ZWDB,,0000,0000,0000,,Оны қабылдаңыз
Dialogue: 0,0:01:13.56,0:01:15.10,ZWDB,,0000,0000,0000,,Ұялмаңыз
Dialogue: 0,0:01:15.78,0:01:19.93,ZWDB,,0000,0000,0000,,Математикадан басқа пәндер үшін көп күш салуым керек.
Dialogue: 0,0:01:20.05,0:01:22.14,ZWDB,,0000,0000,0000,,Мейтеннің ашылуының шығу тегі
Dialogue: 0,0:01:22.46,0:01:23.06,ZWDB,,0000,0000,0000,,Рас па?
Dialogue: 0,0:01:23.33,0:01:24.10,ZWDB,,0000,0000,0000,,Қажетсіз абайсыздық
Dialogue: 0,0:01:24.50,0:01:29.57,ZWDB,,0000,0000,0000,,Нанё қызметінің соңында клуб математикадан емтиханнан сүрінген соң таратылды.
Dialogue: 0,0:01:30.17,0:01:35.68,ZWDB,,0000,0000,0000,,Мен алдымен математика мұғалімінің түсіндірмесін қалдырдым.
Dialogue: 0,0:01:37.03,0:01:38.04,ZWDB,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:01:39.24,0:01:39.78,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:01:40.31,0:01:40.73,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:01:41.45,0:01:43.66,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:00:00.00,0:00:00.00,ZWDB,,0000,0000,0000,,Біріктірілген...Крест (Шигешіге Манабу)
Dialogue: 0,0:03:24.67,0:03:28.84,ZWDB,,0000,0000,0000,,Шындық, балалы болу мүмкін емес және компанияның қызметі аяқталды.
Dialogue: 0,0:03:29.19,0:03:33.74,ZWDB,,0000,0000,0000,,Сиыр дәмінің дәмі ересек адамның әртүрлі сипаттарға ие болуы.
Dialogue: 0,0:03:34.29,0:03:36.23,ZWDB,,0000,0000,0000,,Нағыз иіс
Dialogue: 0,0:03:37.87,0:03:39.58,ZWDB,,0000,0000,0000,,Мен сізге үйрете аламын...
Dialogue: 0,0:03:39.68,0:03:42.07,ZWDB,,0000,0000,0000,,Менің белгілі бір зерттеу нүктесі бар.
Dialogue: 0,0:03:42.07,0:03:42.89,ZWDB,,0000,0000,0000,,Йоши Оя
Dialogue: 0,0:03:43.19,0:03:47.39,ZWDB,,0000,0000,0000,,Магистр – оқытушылар құрамының мүшесі.
Dialogue: 0,0:03:47.88,0:03:48.98,ZWDB,,0000,0000,0000,,Төтенше жағдайдың жариялануы
Dialogue: 0,0:03:49.35,0:03:50.89,ZWDB,,0000,0000,0000,,Жол көгілдір полиция
Dialogue: 0,0:03:50.94,0:03:52.48,ZWDB,,0000,0000,0000,,Оны алудың тағы бір жолы
Dialogue: 0,0:03:57.13,0:04:01.50,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:04:02.35,0:04:04.73,ZWDB,,0000,0000,0000,,Менің оқиғам мүлдем жиіркенішті.
Dialogue: 0,0:04:06.60,0:04:07.42,ZWDB,,0000,0000,0000,,Козо Умата сиыр етінің дәмі
Dialogue: 0,0:04:07.69,0:04:09.18,ZWDB,,0000,0000,0000,,Жақсы жаңалық
Dialogue: 0,0:04:10.95,0:04:11.62,ZWDB,,0000,0000,0000,,Математика?
Dialogue: 0,0:04:12.19,0:04:16.49,ZWDB,,0000,0000,0000,,Егер сіз қорытынды емтиханды тапсыра алмасаңыз, емтиханды қайта тапсыруыңыз қажет. Клубтың таратылуы
Dialogue: 0,0:04:18.25,0:04:21.31,ZWDB,,0000,0000,0000,,Маған ұнамайды, маған ұнамайды, маған ұнамайды, маған ұнамайды.
Dialogue: 0,0:04:21.31,0:04:27.45,ZWDB,,0000,0000,0000,,Нака Фудо Бұл жастардың ұйықтау бөлімінің көбірек ноталары бар ұйықтау бөлігі.
Dialogue: 0,0:04:28.00,0:04:28.77,ZWDB,,0000,0000,0000,,Ұйықтап қалды
Dialogue: 0,0:04:29.29,0:04:29.79,ZWDB,,0000,0000,0000,,Сондай-ақ рұқсат етіңіз
Dialogue: 0,0:04:31.65,0:04:34.81,ZWDB,,0000,0000,0000,,Жастық шағыңды өзің қалдыруың керек.
Dialogue: 0,0:04:35.45,0:04:40.00,ZWDB,,0000,0000,0000,,Комори ересек
Dialogue: 0,0:04:42.49,0:04:44.08,ZWDB,,0000,0000,0000,,Накея
Dialogue: 0,0:04:44.08,0:04:45.89,ZWDB,,0000,0000,0000,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:04:46.12,0:04:49.57,ZWDB,,0000,0000,0000,,Қазіргі жағдай қазіргі жағдаймен дерлік бірдей.
Dialogue: 0,0:04:50.57,0:04:51.81,ZWDB,,0000,0000,0000,,Сен құрғақсың
Dialogue: 0,0:04:52.26,0:04:53.52,ZWDB,,0000,0000,0000,,Мен генералдың жауабын басшылыққа ала алдым.
Dialogue: 0,0:04:56.58,0:05:02.79,ZWDB,,0000,0000,0000,,Бұл дүние ақиқатының, хикметтің және интеллектуалдық рухтың бұйрығы.
Dialogue: 0,0:05:06.22,0:05:08.29,ZWDB,,0000,0000,0000,,Әңгімені тыңдаңыз
Dialogue: 0,0:05:08.71,0:05:10.45,ZWDB,,0000,0000,0000,,Декомори уақытты жақсы меңгереді.
Dialogue: 0,0:05:12.64,0:05:14.45,ZWDB,,0000,0000,0000,,Наня Жауабы - Цзиюань
Dialogue: 0,0:05:14.82,0:05:16.81,ZWDB,,0000,0000,0000,,Сексен екі...сол және оң
Dialogue: 0,0:05:16.99,0:05:19.84,ZWDB,,0000,0000,0000,,Түпнұсқа әңгіме - бұл жабайы.
Dialogue: 0,0:05:20.46,0:05:22.65,ZWDB,,0000,0000,0000,,Теңдеулерді шешу әдісі қарапайым.
Dialogue: 0,0:05:23.10,0:05:25.39,ZWDB,,0000,0000,0000,,7-ден 4-ке дейін қол алысу
Dialogue: 0,0:05:26.68,0:05:31.05,ZWDB,,0000,0000,0000,,4-тен 7-ге дейін сөйлесу қажет емес, бірақ 4-тен 7-ге дейінгі сөйлесулерді алу қиын.
Dialogue: 0,0:05:32.00,0:05:35.25,ZWDB,,0000,0000,0000,,Кескінді сезіну: «Бұл отбасылық үй мен өмір кеші үшін сиқырлы трюк».
Dialogue: 0,0:05:36.02,0:05:41.57,ZWDB,,0000,0000,0000,,Мен жетінші қатардамын, ал қиындығы соңғы қатарда.
Dialogue: 0,0:05:42.06,0:05:46.88,ZWDB,,0000,0000,0000,,​​7856 категорияның нақты бейнесі - патшаның фигурасы.
Dialogue: 0,0:05:47.43,0:05:49.64,ZWDB,,0000,0000,0000,,Серпілістен кейін соңғы тоғызыншы жол
Dialogue: 0,0:05:50.81,0:05:52.78,ZWDB,,0000,0000,0000,,7963 бірінші нысаны
Dialogue: 0,0:05:53.82,0:05:55.81,ZWDB,,0000,0000,0000,,9872 жылғы екінші түрі
Dialogue: 0,0:05:56.70,0:06:00.01,ZWDB,,0000,0000,0000,,Бұл 9981 жылдың соңғы түрі.
Dialogue: 0,0:06:01.47,0:06:02.67,ZWDB,,0000,0000,0000,,Сіз құрғақсыз.
Dialogue: 0,0:06:03.81,0:06:07.74,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:06:07.04,0:06:09.15,ZWDB,,0000,0000,0000,,Отау басталғалы бері аты-жөні
Dialogue: 0,0:06:09.63,0:06:11.37,ZWDB,,0000,0000,0000,,「」
Dialogue: 0,0:06:11.42,0:06:13.53,ZWDB,,0000,0000,0000,,Балықтың аты мен атауына жақсы шолу.
Dialogue: 0,0:06:13.70,0:06:15.09,ZWDB,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:06:18.45,0:06:20.09,ZWDB,,0000,0000,0000,,Зұлым патшаның көзінің әйгілі бұйрығы
Dialogue: 0,0:06:20.69,0:06:27.02,ZWDB,,0000,0000,0000,,Менің жанымды, денемді және сүйектерді иемдену нәтижесінде менің тағдырым қашып, математика емтиханымнан сәтсіздікке ұшырады.
Dialogue: 0,0:06:27.45,0:06:27.92,ZWDB,,0000,0000,0000,,…Бұл болатын жер
Dialogue: 0,0:06:28.44,0:06:29.88,ZWDB,,0000,0000,0000,,Кюджин Ясуюкидің кенеттен келуі
Dialogue: 0,0:06:30.35,0:06:33.69,ZWDB,,0000,0000,0000,,«Іздеу» болмыстың жоқтығы Бұл зұлым патшаның шын көздің атын қалдыру туралы бұйрығы.
Dialogue: 0,0:06:33.93,0:06:34.38,ZWDB,,0000,0000,0000,,Бұл орын болуы керек
Dialogue: 0,0:06:36.99,0:06:38.68,ZWDB,,0000,0000,0000,,Сумиттің аспанмен кездесуі
Dialogue: 0,0:06:39.13,0:06:41.27,ZWDB,,0000,0000,0000,,Әңгіме сіздің бірінші орта мектептен шыққан.
Dialogue: 0,0:06:41.71,0:06:43.45,ZWDB,,0000,0000,0000,,Кикурай храмына бару
Dialogue: 0,0:06:43.80,0:06:48.08,ZWDB,,0000,0000,0000,,Дөңес қарауыл – қожайынның қызметшісі, ал шайқаста тірек – қисынды орын.
Dialogue: 0,0:06:48.65,0:06:51.01,ZWDB,,0000,0000,0000,,Өзіндік рефлексия - өзін-өзі тексеру
Dialogue: 0,0:06:52.95,0:06:56.33,ZWDB,,0000,0000,0000,,Мен сақтандырылған орта мектепке жіберілдім.
Dialogue: 0,0:06:57.20,0:07:00.30,ZWDB,,0000,0000,0000,,Сіз осындасыз ба? Менің жеке тұлғам сияқты адасу
Dialogue: 0,0:07:00.30,0:07:04.83,ZWDB,,0000,0000,0000,,Кішкентай дөңес жоқ.
Dialogue: 0,0:07:05.22,0:07:08.51,ZWDB,,0000,0000,0000,,Алдымен бұл отбасы болуы мүмкін бе?
Dialogue: 0,0:07:12.08,0:07:12.98,ZWDB,,0000,0000,0000,,Белгілі мәндер
Dialogue: 0,0:07:13.38,0:07:14.35,ZWDB,,0000,0000,0000,,Толқу
Dialogue: 0,0:07:15.29,0:07:19.62,ZWDB,,0000,0000,0000,,Атап айтқанда, бұл мен бітірген бірінші математика курсы.
Dialogue: 0,0:07:19.79,0:07:22.50,ZWDB,,0000,0000,0000,,Нәтижесінде, мақсат жоғары сынып оқушысы болу.
Dialogue: 0,0:07:22.92,0:07:25.03,ZWDB,,0000,0000,0000,,Рас па? Суреттегі нақты мәселелер тізімі
Dialogue: 0,0:07:25.13,0:07:30.03,ZWDB,,0000,0000,0000,,Жауап X-тің үш өлшемді әдісі 8
Dialogue: 0,0:07:32.42,0:07:33.01,ZWDB,,0000,0000,0000,,Жауап аяқталды
Dialogue: 0,0:07:33.46,0:07:38.50,ZWDB,,0000,0000,0000,,Қазіргі мәселе - негізгі құрылым.
Dialogue: 0,0:07:38.50,0:07:42.83,ZWDB,,0000,0000,0000,,Шебер… Оқып, оқып жүрген орта мектеп оқушысы
Dialogue: 0,0:07:43.55,0:07:46.98,ZWDB,,0000,0000,0000,,Мен қожайын емеспін.
Dialogue: 0,0:07:48.72,0:07:50.41,ZWDB,,0000,0000,0000,,Түсінгеніңізге рахмет.
Dialogue: 0,0:07:50.98,0:07:54.36,ZWDB,,0000,0000,0000,,Хирохито құрылған кезде болған ұлы жұлдыз соғысы туралы әңгіме.
Dialogue: 0,0:07:57.07,0:07:59.51,ZWDB,,0000,0000,0000,,Мен сені қорғай аламын
Dialogue: 0,0:07:59.83,0:08:01.25,ZWDB,,0000,0000,0000,,Ақырында Юуто Джимбо мұны талап етеді.
Dialogue: 0,0:08:02.39,0:08:03.61,ZWDB,,0000,0000,0000,,Өлген отбасының Роккакуы
Dialogue: 0,0:08:04.13,0:08:05.89,ZWDB,,0000,0000,0000,,Кумин Юджидің стратегиясы
Dialogue: 0,0:08:06.49,0:08:12.60,ZWDB,,0000,0000,0000,,Сіз таңдаған уақытта құралды қай жерде пайдалануды таңдайсыз?
Dialogue: 0,0:08:13.87,0:08:16.01,ZWDB,,0000,0000,0000,,1-сұрақ: А бұрышының бұрышы қанша?
Dialogue: 0,0:08:23.79,0:08:25.01,ZWDB,,0000,0000,0000,,4. Жауап кілті...
Dialogue: 0,0:08:25.40,0:08:25.80,ZWDB,,0000,0000,0000,,Үш
Dialogue: 0,0:08:27.12,0:08:30.20,ZWDB,,0000,0000,0000,,Хосуке Рикка белгілі бір біліктілік талабы
Dialogue: 0,0:08:30.38,0:08:32.16,ZWDB,,0000,0000,0000,,Бұл отбасының өлімі құтқарылды.
Dialogue: 0,0:08:32.99,0:08:33.76,ZWDB,,0000,0000,0000,,Жағдайлар шатастырады...
Dialogue: 0,0:08:35.02,0:08:35.76,ZWDB,,0000,0000,0000,,Қолөнер?
Dialogue: 0,0:08:36.22,0:08:39.55,ZWDB,,0000,0000,0000,,Біз әлі де жай ғана клубпыз.
Dialogue: 0,0:08:40.29,0:08:43.08,ZWDB,,0000,0000,0000,,Орта мектептің төменгі деңгейінің төменгі деңгейі
Dialogue: 0,0:08:43.65,0:08:46.01,ZWDB,,0000,0000,0000,,Мектеп формасының үлесі
Dialogue: 0,0:08:46.21,0:08:49.07,ZWDB,,0000,0000,0000,,Бұл менің шынайы ниетім және бар болу себебім.
Dialogue: 0,0:08:49.07,0:08:50.03,ZWDB,,0000,0000,0000,,Бөлек шағын қағаз мақала
Dialogue: 0,0:08:50.18,0:08:52.52,ZWDB,,0000,0000,0000,,Бұл туралы сіздің пікіріңіз қандай?
Dialogue: 0,0:08:52.77,0:08:57.84,ZWDB,,0000,0000,0000,,Мен әртүрлі клубтар туралы ойлаймын.
Dialogue: 0,0:08:58.54,0:09:01.02,ZWDB,,0000,0000,0000,,Үйге қарап, қаланы ұмытпа.
Dialogue: 0,0:09:01.67,0:09:04.30,ZWDB,,0000,0000,0000,,Менің ойларым бар және солай.
Dialogue: 0,0:09:04.57,0:09:05.25,ZWDB,,0000,0000,0000,,Рас па?
Dialogue: 0,0:09:05.54,0:09:08.35,ZWDB,,0000,0000,0000,,Ұлы адамның келуі
Dialogue: 0,0:09:08.53,0:09:10.27,ZWDB,,0000,0000,0000,,Ютай Зай
Dialogue: 0,0:09:10.59,0:09:11.04,ZWDB,,0000,0000,0000,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,0:09:12.20,0:09:16.90,ZWDB,,0000,0000,0000,,Нана ``Райджин акселерациясы''
Dialogue: 0,0:09:17.30,0:09:18.37,ZWDB,,0000,0000,0000,,Төмендегі түсініктемені оқыңыз.
Dialogue: 0,0:09:18.69,0:09:21.82,ZWDB,,0000,0000,0000,,«Найзағай құдайының үдеуі» — генералдың сиқырлы күш инъекциясы және дене Құдайы Руридің төменгі жартысы.
Dialogue: 0,0:09:21.82,0:09:25.55,ZWDB,,0000,0000,0000,,Сиқырлы қуат инъекциясы қалыпты жағдайда қозғалу мүмкіндігін 3,88 есе арттырады.
Dialogue: 0,0:09:25.68,0:09:28.76,ZWDB,,0000,0000,0000,,Шынайы жоғары жылдамдықты қозғалыс дағдылары
Dialogue: 0,0:09:30.72,0:09:35.07,ZWDB,,0000,0000,0000,,Күшті жеделдету күші Үдеу 2 Дыбыс жылдамдығына тікелей үдеу 2
Dialogue: 0,0:09:35.74,0:09:40.39,ZWDB,,0000,0000,0000,,«Кайё Шоджо» композициясы 1000 дана уақытта басылады.
Dialogue: 0,0:09:40.39,0:09:43.20,ZWDB,,0000,0000,0000,,Сәттілік, сәттілік
Dialogue: 0,0:09:43.89,0:09:47.25,ZWDB,,0000,0000,0000,,Мен мұнда келгенде қолым бос емес.
Dialogue: 0,0:09:47.80,0:09:50.03,ZWDB,,0000,0000,0000,,Жеті негізгі тармаққа байланысты барлық қызметкерлер
Dialogue: 0,0:09:50.75,0:09:53.07,ZWDB,,0000,0000,0000,,Мен үлгерімімді жаза алмаймын.
Dialogue: 0,0:09:56.12,0:09:57.32,ZWDB,,0000,0000,0000,,Егер сіз клубқа қосылуға келіспесеңіз, өтініш формасын толтырыңыз.
Dialogue: 0,0:09:57.69,0:10:00.52,ZWDB,,0000,0000,0000,,Гана Кашиваның жалғыз ойы - ол орта мектептің императорымен байланыста болды.
Dialogue: 0,0:10:00.94,0:10:02.73,ZWDB,,0000,0000,0000,,Оқиға толығымен менікі.
Dialogue: 0,0:10:03.33,0:10:04.97,ZWDB,,0000,0000,0000,,Ryoichi Tename
Dialogue: 0,0:10:07.13,0:10:10.31,ZWDB,,0000,0000,0000,,Дегенмен, сіз бұл туралы жақында айттыңыз.
Dialogue: 0,0:10:10.61,0:10:13.27,ZWDB,,0000,0000,0000,,Жақында мен астанадан шықтым
Dialogue: 0,0:10:13.27,0:10:15.33,ZWDB,,0000,0000,0000,,Балалар кеші, жастық басы және жүзу тоғанының келуі
Dialogue: 0,0:10:15.68,0:10:16.43,ZWDB,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:10:17.02,0:10:18.43,ZWDB,,0000,0000,0000,,Менің басымнан өткен оқиғалар
Dialogue: 0,0:10:19.16,0:10:22.02,ZWDB,,0000,0000,0000,,Оқиғасыз
Dialogue: 0,0:10:22.49,0:10:24.02,ZWDB,,0000,0000,0000,,Тізімге қосымша
Dialogue: 0,0:10:24.58,0:10:27.91,ZWDB,,0000,0000,0000,,Мен топ басшысымын және штаб бастығымын.
Dialogue: 0,0:10:28.43,0:10:30.59,ZWDB,,0000,0000,0000,,Менің ойларымды өзгерту керек.
Dialogue: 0,0:10:30.87,0:10:34.99,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:10:34.99,0:10:36.26,ZWDB,,0000,0000,0000,,Талантты және талантты
Dialogue: 0,0:10:36.54,0:10:37.53,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:10:37.53,0:10:38.67,ZWDB,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:10:39.10,0:10:41.16,ZWDB,,0000,0000,0000,,Менің өмірімнің маңызды сәті
Dialogue: 0,0:10:41.43,0:10:44.07,ZWDB,,0000,0000,0000,,Тәжірибелерінен ұялатын адамдардың естеліктерінің жинағы.
Dialogue: 0,0:10:44.19,0:10:46.05,ZWDB,,0000,0000,0000,,Мен сізбен келісемін
Dialogue: 0,0:10:46.58,0:10:51.87,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:10:54.45,0:10:56.79,ZWDB,,0000,0000,0000,,Өзін-өзі айыптау
Dialogue: 0,0:10:57.11,0:10:59.97,ZWDB,,0000,0000,0000,,Юйяның жақсы жағы және құрғақ өмірі
Dialogue: 0,0:10:58.31,0:10:59.97,ZWDB,,0000,0000,0000,,«Лак қара темір табан»
Dialogue: 0,0:11:03.70,0:11:07.06,ZWDB,,0000,0000,0000,,Атыс сызығы
Dialogue: 0,0:11:09.07,0:11:13.24,ZWDB,,0000,0000,0000,,Сен жақсы адамсың, жуынуға келдің.
Dialogue: 0,0:11:13.79,0:11:15.63,ZWDB,,0000,0000,0000,,Жоғалу, жоғалу, көлеңкесі жоқ, жоғалу
Dialogue: 0,0:11:16.25,0:11:20.58,ZWDB,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:11:21.97,0:11:25.45,ZWDB,,0000,0000,0000,,Бұл «Дүниежүзілік тарихтың» ескі және жаңа нұсқасы
Dialogue: 0,0:11:25.52,0:11:27.26,ZWDB,,0000,0000,0000,,Сен мұнда өз есіміңнің шығысы мен батысындасың.
Dialogue: 0,0:11:27.49,0:11:29.20,ZWDB,,0000,0000,0000,,Сәттілік, су құбырын шығару
Dialogue: 0,0:11:29.20,0:11:30.69,ZWDB,,0000,0000,0000,,Накафугёя
Dialogue: 0,0:11:31.91,0:11:34.07,ZWDB,,0000,0000,0000,,Дөңес қарауылдың күші, Ғарайсүке, бір білектің күші
Dialogue: 0,0:11:35.24,0:11:36.07,ZWDB,,0000,0000,0000,,Мастер
Dialogue: 0,0:11:36.51,0:11:38.15,ZWDB,,0000,0000,0000,,Көзге түсіру
Dialogue: 0,0:11:38.57,0:11:41.08,ZWDB,,0000,0000,0000,,Бүкіл дененің толықтық қабілеті
Dialogue: 0,0:11:42.30,0:11:47.07,ZWDB,,0000,0000,0000,,Құзіреттілік және өзіндік өмір сүру, жағымды даму, жағымды даму, жағымды даму
Dialogue: 0,0:11:49.38,0:11:53.96,ZWDB,,0000,0000,0000,,Сіз қалаға бір нүктеге жеттіңіз, сондықтан тоғанда жүзгеннен кейін үш сағат өтті.
Dialogue: 0,0:11:54.10,0:11:55.72,ZWDB,,0000,0000,0000,,Мен олай ойламаймын...
Dialogue: 0,0:11:56.49,0:12:01.56,ZWDB,,0000,0000,0000,,Дегенмен, бұл ескі дене шынықтыру мұғалімінің жергілікті әңгімесі ``Жүзу тоғанында бір нүкте, қала жоғалып, аспан төмендейді''.
Dialogue: 0,0:12:02.31,0:12:06.01,ZWDB,,0000,0000,0000,,Дегенмен, мен компаниядан кеткеніме сенімдімін.
Dialogue: 0,0:12:07.87,0:12:10.21,ZWDB,,0000,0000,0000,,Нәтиже реакцияның басы болды.
Dialogue: 0,0:12:11.35,0:12:16.00,ZWDB,,0000,0000,0000,,Бұл шараға математика пәнінің мұғалімі келді.
Dialogue: 0,0:12:16.60,0:12:19.38,ZWDB,,0000,0000,0000,,Орташа сомаға жету үшін ең аз қажет
Dialogue: 0,0:12:20.72,0:12:21.82,ZWDB,,0000,0000,0000,,Орташа...
Dialogue: 0,0:12:22.64,0:12:23.68,ZWDB,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:12:24.95,0:12:25.60,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:12:26.22,0:12:26.69,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:12:27.61,0:12:29.94,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:12:38.67,0:12:41.25,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:12:41.73,0:12:42.99,ZWDB,,0000,0000,0000,,Риккаясато
Dialogue: 0,0:12:45.75,0:12:49.18,ZWDB,,0000,0000,0000,,Мен сені осында көргім келеді.
Dialogue: 0,0:12:49.63,0:12:52.02,ZWDB,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:12:52.16,0:12:54.48,ZWDB,,0000,0000,0000,,Бұл жасөспірім еркек пен әйел.
Dialogue: 0,0:12:54.72,0:12:59.62,ZWDB,,0000,0000,0000,,Мен оны қайта көре алмаймын.
Dialogue: 0,0:13:00.04,0:13:03.57,ZWDB,,0000,0000,0000,,Талантты жоғалтқаны шындық.
Dialogue: 0,0:13:03.77,0:13:08.69,ZWDB,,0000,0000,0000,,Маған телефон соғылғанда, әкем: «Мен кеткенде, мен оған қарап, кетіп қалдым», - деді.
Dialogue: 0,0:13:08.97,0:13:10.69,ZWDB,,0000,0000,0000,,Шындығында, ерлі-зайыптылар белгісіз жолмен саяхаттауды жақсы көреді.
Dialogue: 0,0:13:12.10,0:13:15.30,ZWDB,,0000,0000,0000,,Мен бірінші сұрақты қайта қойдым.
Dialogue: 0,0:13:15.95,0:13:16.62,ZWDB,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:13:17.34,0:13:20.25,ZWDB,,0000,0000,0000,,Алдын ала Clear My School Deviation High School
Dialogue: 0,0:13:20.55,0:13:23.83,ZWDB,,0000,0000,0000,,Әңгіменің орташа бөлігі туралы ойға қол жеткізілмейді.
Dialogue: 0,0:13:24.40,0:13:25.25,ZWDB,,0000,0000,0000,,Түсінемін
Dialogue: 0,0:13:26.09,0:13:27.48,ZWDB,,0000,0000,0000,,Жақсы жұмыс
Dialogue: 0,0:13:28.25,0:13:29.67,ZWDB,,0000,0000,0000,,Негізгі сұрақтың басталуы
Dialogue: 0,0:13:30.22,0:13:35.09,ZWDB,,0000,0000,0000,,Екі кесек сүйек, ізделетін ұпай санының қосындысы, үш өлшемді жуықтау.
Dialogue: 0,0:13:35.49,0:13:36.03,ZWDB,,0000,0000,0000,,Рё Тайцуги
Dialogue: 0,0:13:36.73,0:13:39.78,ZWDB,,0000,0000,0000,,Менімен сөйлескенде, сен қиындыққа тап боласың.
Dialogue: 0,0:13:40.28,0:13:41.65,ZWDB,,0000,0000,0000,,Аздап ұйымдастырылған классификация
Dialogue: 0,0:13:43.26,0:13:44.01,ZWDB,,0000,0000,0000,,Фукунен
Dialogue: 0,0:13:44.58,0:13:44.86,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:13:45.23,0:13:48.96,ZWDB,,0000,0000,0000,,Мен кім туралы ойлайтынымды білмеймін, бірақ мәселе мен мәселені шеше аламын.
Dialogue: 0,0:13:49.38,0:13:53.26,ZWDB,,0000,0000,0000,,Дегенмен, мен ойға толығымен берілгенмін, бірақ онымен ойнағым келмейді.
Dialogue: 0,0:13:54.27,0:13:56.91,ZWDB,,0000,0000,0000,,Бұл сіздің тәжірибеңізден үйренгеніңіз де болды.
Dialogue: 0,0:13:57.36,0:14:00.21,ZWDB,,0000,0000,0000,,Мен шын шығу тегі туралы білмеймін.
Dialogue: 0,0:14:00.41,0:14:01.36,ZWDB,,0000,0000,0000,,Сөз тіркесін ойлайтын жалғыз сенсің.
Dialogue: 0,0:14:01.83,0:14:05.29,ZWDB,,0000,0000,0000,,Шынайы жою әдісі: Бір ұпайдан тұратын мазмұн Сабақтың басталуы
Dialogue: 0,0:14:06.28,0:14:08.34,ZWDB,,0000,0000,0000,,Бірінші беттегі мазмұн басынан басталады.
Dialogue: 0,0:14:08.81,0:14:12.37,ZWDB,,0000,0000,0000,,Шығыс және Батыс аймақтарындағы математика
Dialogue: 0,0:14:14.63,0:14:15.03,ZWDB,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:14:15.20,0:14:15.48,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:14:16.84,0:14:17.69,ZWDB,,0000,0000,0000,,Ол жерде адам тұрмайды.
Dialogue: 0,0:14:17.69,0:14:18.23,ZWDB,,0000,0000,0000,,Сөзсіз дарынды және адамдық
Dialogue: 0,0:14:20.82,0:14:21.76,ZWDB,,0000,0000,0000,,Юта қаупі
Dialogue: 0,0:14:22.56,0:14:23.76,ZWDB,,0000,0000,0000,,Мен партияның мүшесімін
Dialogue: 0,0:14:25.39,0:14:28.62,ZWDB,,0000,0000,0000,,Ютамен сөйлесіңіз Сіз ``8`' санын білесіз және санның сиқырлы күшін оқисыз.
Dialogue: 0,0:14:28.62,0:14:29.82,ZWDB,,0000,0000,0000,,Наятака Мен не істерімді білмеймін
Dialogue: 0,0:14:30.06,0:14:30.56,ZWDB,,0000,0000,0000,,Бізге асығыс керек.
Dialogue: 0,0:14:31.23,0:14:32.87,ZWDB,,0000,0000,0000,,``Қиық'' жазылған соң, данышпандық анық.
Dialogue: 0,0:14:33.94,0:14:34.54,ZWDB,,0000,0000,0000,,Отыру
Dialogue: 0,0:14:36.33,0:14:38.42,ZWDB,,0000,0000,0000,,Егер сіз дарынды адам болсаңыз, мұның рас екенін түсініңіз.
Dialogue: 0,0:14:39.04,0:14:39.56,ZWDB,,0000,0000,0000,,Мен бұл шындыққа сенемін.
Dialogue: 0,0:14:40.23,0:14:42.91,ZWDB,,0000,0000,0000,,Менің ілімдерім туралы не ойлайсыз?
Dialogue: 0,0:14:43.41,0:14:43.96,ZWDB,,0000,0000,0000,,Бұл менің айтқаным.
Dialogue: 0,0:14:45.03,0:14:49.40,ZWDB,,0000,0000,0000,,Дегенмен, бұл тек математикалық қателік.
Dialogue: 0,0:14:50.00,0:14:53.88,ZWDB,,0000,0000,0000,,Есептің басынан кейін белгілі бір нүктелер санының пайда болуының болжалды ықтималдығы
Dialogue: 0,0:14:54.07,0:14:55.19,ZWDB,,0000,0000,0000,,Тағы бір кенет түсініктеме
Dialogue: 0,0:14:56.91,0:14:58.62,ZWDB,,0000,0000,0000,,Мен сенімен кездескім келмейді
Dialogue: 0,0:14:59.27,0:15:00.62,ZWDB,,0000,0000,0000,,Күйреудің басы мен соңы
Dialogue: 0,0:15:01.70,0:15:02.65,ZWDB,,0000,0000,0000,,Қайда бару керек…
Dialogue: 0,0:15:02.95,0:15:03.64,ZWDB,,0000,0000,0000,,Демалыңыз!
Dialogue: 0,0:15:05.03,0:15:06.00,ZWDB,,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,0:15:06.00,0:15:07.15,ZWDB,,0000,0000,0000,,Аяқталған демалыс және шынайы оқу
Dialogue: 0,0:15:08.04,0:15:09.15,ZWDB,,0000,0000,0000,,Шай ішу
Dialogue: 0,0:15:13.51,0:15:14.03,ZWDB,,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:15:17.39,0:15:19.30,ZWDB,,0000,0000,0000,,Әпкең бір рет қайтыс болды.
Dialogue: 0,0:15:19.72,0:15:24.10,ZWDB,,0000,0000,0000,,Юта?
Dialogue: 0,0:15:24.10,0:15:25.99,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:15:27.50,0:15:30.26,ZWDB,,0000,0000,0000,,Араши саңырауқұлақ шайы Арпа саңырауқұлақ сорпасы
Dialogue: 0,0:15:30.39,0:15:31.53,ZWDB,,0000,0000,0000,,Бұл сіздің үйіңізде бар кішкентай және біртүрлі шай.
Dialogue: 0,0:15:34.14,0:15:38.26,ZWDB,,0000,0000,0000,,Жақын арада шығарылмайтын су көпіршіктері мен көпіршіктері туралы әңгіме.
Dialogue: 0,0:15:41.10,0:15:42.07,ZWDB,,0000,0000,0000,,Жариялаған
Dialogue: 0,0:15:42.37,0:15:47.61,ZWDB,,0000,0000,0000,,Бұл оқиғаның оқиғасы, бірақ басқа нәрселер бар.
Dialogue: 0,0:15:49.77,0:15:50.99,ZWDB,,0000,0000,0000,,Киімдерді кептіру керек.
Dialogue: 0,0:15:52.03,0:15:52.99,ZWDB,,0000,0000,0000,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:15:54.44,0:15:57.00,ZWDB,,0000,0000,0000,,Қарама-қарсы тұлғаның бастапқы мағынасынан келген зияннан ұяламын.
Dialogue: 0,0:15:58.87,0:16:00.63,ZWDB,,0000,0000,0000,,Бұл тегін аялдама.
Dialogue: 0,0:16:01.28,0:16:02.15,ZWDB,,0000,0000,0000,,Мен «ғалыммын»
Dialogue: 0,0:16:02.97,0:16:04.09,ZWDB,,0000,0000,0000,,Тоқа апа…
Dialogue: 0,0:16:06.15,0:16:06.95,ZWDB,,0000,0000,0000,,Әңгімені оқығаннан кейін
Dialogue: 0,0:16:07.62,0:16:10.35,ZWDB,,0000,0000,0000,,Сиқырлы басқару бюросының ішкі өлшемдері ерекше сиқырлы күшке жетті.
Dialogue: 0,0:16:10.58,0:16:11.35,ZWDB,,0000,0000,0000,,Үзіліс аяқталды
Dialogue: 0,0:16:12.02,0:16:14.87,ZWDB,,0000,0000,0000,,Оқиға соңғы түнге дейін барады.
Dialogue: 0,0:16:15.40,0:16:16.09,ZWDB,,0000,0000,0000,,Дәл сол әрекетті жалғастыру
Dialogue: 0,0:16:16.84,0:16:18.78,ZWDB,,0000,0000,0000,,Ақыр заманды есептемегенде, ол аспанның сыртқы астанасы болып табылады.
Dialogue: 0,0:16:24.32,0:16:27.05,ZWDB,,0000,0000,0000,,Юта Ширандоның «Электро протокол коды».
Dialogue: 0,0:16:27.70,0:16:28.69,ZWDB,,0000,0000,0000,,Бұл Хакочи орналасқан жер.
Dialogue: 0,0:16:28.99,0:16:32.92,ZWDB,,0000,0000,0000,,「Infrared data communication」
Dialogue: 0,0:16:33.54,0:16:34.44,ZWDB,,0000,0000,0000,,Бұл қызыл сызық.
Dialogue: 0,0:16:34.78,0:16:35.55,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:16:37.22,0:16:37.89,ZWDB,,0000,0000,0000,,Мен дүниеден өттім.
Dialogue: 0,0:16:41.99,0:16:43.76,ZWDB,,0000,0000,0000,,Юта коды
Dialogue: 0,0:16:43.95,0:16:47.14,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:16:49.12,0:16:51.53,ZWDB,,0000,0000,0000,,Қорап қалдырылғанда, ол бірінші рет орта мектепте пайдаланылады.
Dialogue: 0,0:16:51.53,0:16:53.87,ZWDB,,0000,0000,0000,,«Құдай экссеед фрея магна»
Dialogue: 0,0:16:53.87,0:16:58.12,ZWDB,,0000,0000,0000,,Жақсы оқу, басқа аударма және т.б.
Dialogue: 0,0:16:58.25,0:17:01.97,ZWDB,,0000,0000,0000,,Қате мінез-құлық Талапты өзгерту - менің атым.
Dialogue: 0,0:17:02.77,0:17:05.28,ZWDB,,0000,0000,0000,,Юта бұдан былай мен бір кодты ойладым.
Dialogue: 0,0:17:05.63,0:17:06.00,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:17:06.32,0:17:08.16,ZWDB,,0000,0000,0000,,Ютаның сөздері анық, бірақ мен өмір сүретін жақсы жерді ойлай алмаймын.
Dialogue: 0,0:17:08.76,0:17:11.47,ZWDB,,0000,0000,0000,,​​Қазіргі жағдай мені қанағаттандырмайды.
Dialogue: 0,0:17:12.79,0:17:14.45,ZWDB,,0000,0000,0000,,Юта Нагаджоның Хакоджи сайты
Dialogue: 0,0:17:14.45,0:17:18.05,ZWDB,,0000,0000,0000,,Naka delinquency Сізбен сөйлесу
Dialogue: 0,0:17:18.38,0:17:18.92,ZWDB,,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:17:19.45,0:17:24.89,ZWDB,,0000,0000,0000,,Сіздің ойларыңыз туралы ойлар, қайта қарауды қажет ететін оқиғалар, білуіңіз керек нәрселер, орта мектептегі достар, отбасы мүшелері және достар.
Dialogue: 0,0:17:25.51,0:17:26.23,ZWDB,,0000,0000,0000,,Дайынсың ба? Алтыға бес қанша?
Dialogue: 0,0:17:26.78,0:17:28.97,ZWDB,,0000,0000,0000,,Мен сізге бақылаушыны басқара алатынымды хабарлауым керек.
Dialogue: 0,0:17:29.91,0:17:30.68,ZWDB,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:17:31.48,0:17:35.75,ZWDB,,0000,0000,0000,,Мен қазір ғарыштамын, бірақ мен өзімнің бар екендігімді білемін.
Dialogue: 0,0:17:43.83,0:17:45.87,ZWDB,,0000,0000,0000,,Дегенмен, Юта криптографиялық әңгіме туралы ойлайды.
Dialogue: 0,0:17:46.76,0:17:49.37,ZWDB,,0000,0000,0000,,Нана Гая-кай жер туралы есеп беру, Ютака Нибутани, Юкумин
Dialogue: 0,0:17:55.19,0:17:55.81,ZWDB,,0000,0000,0000,,Иккушита
Dialogue: 0,0:17:56.03,0:17:57.81,ZWDB,,0000,0000,0000,,Алайда, балық табақшасы өлді...
Dialogue: 0,0:17:59.68,0:18:01.72,ZWDB,,0000,0000,0000,,Оны қолданбас бұрын, қаладағы мәтінді оқып шығыңыз.
Dialogue: 0,0:18:02.44,0:18:03.89,ZWDB,,0000,0000,0000,,Осыған байланысты сіз де осы аймақты зерттеуге бар күшіңізді сала аласыз.
Dialogue: 0,0:18:04.58,0:18:05.08,ZWDB,,0000,0000,0000,,Юта…
Dialogue: 0,0:18:06.74,0:18:08.38,ZWDB,,0000,0000,0000,,Белгіленген клубтың болуы жақсы идея емес.
Dialogue: 0,0:18:09.13,0:18:09.48,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:18:10.55,0:18:17.75,ZWDB,,0000,0000,0000,,Әңгіменің орташа бөлігінен қалай өттіңіз? Сіз естігіңіз келетін протокол кодын енгізіңіз.
Dialogue: 0,0:18:20.29,0:18:20.79,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:18:26.48,0:18:27.50,ZWDB,,0000,0000,0000,,Түн ортасында күрсіну
Dialogue: 0,0:18:27.50,0:18:29.41,ZWDB,,0000,0000,0000,,Міне, сіз...
Dialogue: 0,0:18:29.68,0:18:34.18,ZWDB,,0000,0000,0000,,Үйіме оралған соң, жүрегім қай жерде, не істегім келеді деп қарадым.
Dialogue: 0,0:18:34.48,0:18:35.97,ZWDB,,0000,0000,0000,,Содан бері мен сені көруге келдім.
Dialogue: 0,0:18:37.02,0:18:38.28,ZWDB,,0000,0000,0000,,Жақсы сурет
Dialogue: 0,0:18:40.27,0:18:41.66,ZWDB,,0000,0000,0000,,Мен мұны тоқтату үшін келдім.
Dialogue: 0,0:18:45.24,0:18:47.43,ZWDB,,0000,0000,0000,,Балаларыммен жақсы кездесу өткіземін.
Dialogue: 0,0:18:50.01,0:18:52.95,ZWDB,,0000,0000,0000,,Балаңызды ай сайын көруге бір өлшемді уәде беруді ұмытпаңыз.
Dialogue: 0,0:18:53.20,0:18:55.98,ZWDB,,0000,0000,0000,,Түсімде сен осындасың.
Dialogue: 0,0:18:56.23,0:18:59.73,ZWDB,,0000,0000,0000,,Сіз оны көре аласыз.
Dialogue: 0,0:18:59.83,0:19:00.70,ZWDB,,0000,0000,0000,,Енді шындық күшті
Dialogue: 0,0:19:01.22,0:19:02.70,ZWDB,,0000,0000,0000,,Жақсы уақыт өткізіңіз
Dialogue: 0,0:19:03.41,0:19:03.93,ZWDB,,0000,0000,0000,,Өлім…
Dialogue: 0,0:19:04.26,0:19:07.81,ZWDB,,0000,0000,0000,,Ная, мен үйден шықтым.
Dialogue: 0,0:19:08.51,0:19:11.22,ZWDB,,0000,0000,0000,,Мен ұйықтап жатқанда ұйықтап қалдым.
Dialogue: 0,0:19:11.66,0:19:14.45,ZWDB,,0000,0000,0000,,Мен сізді қатты таң қалдырамын
Dialogue: 0,0:19:15.17,0:19:15.37,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:19:21.73,0:19:22.85,ZWDB,,0000,0000,0000,,Зәйнадан кейінгі бір сапар
Dialogue: 0,0:19:24.02,0:19:26.87,ZWDB,,0000,0000,0000,,Азаттық жолы туралы әңгіме.
Dialogue: 0,0:19:28.56,0:19:29.58,ZWDB,,0000,0000,0000,,Сиқырлы қуат!
Dialogue: 0,0:19:32.47,0:19:36.22,ZWDB,,0000,0000,0000,,Сурет түсірілгеннен кейін желім салынған жер зерттеліп, алты гүлді зерттеу аяқталды.
Dialogue: 0,0:19:37.09,0:19:41.86,ZWDB,,0000,0000,0000,,Нана Математиканы оқудың негізгі негіздері басталды
Dialogue: 0,0:19:44.00,0:19:47.38,ZWDB,,0000,0000,0000,,Noh көрінісі Noh көрінісі
Dialogue: 0,0:19:48.27,0:19:50.19,ZWDB,,0000,0000,0000,,Нана Бегин
Dialogue: 0,0:19:52.17,0:19:54.31,ZWDB,,0000,0000,0000,,Ноқан… Ноқан…
Dialogue: 0,0:19:59.61,0:20:02.07,ZWDB,,0000,0000,0000,,Жарылғыш соңғы шындық, қаһарлы соңғы құдайлық байланыс
Dialogue: 0,0:20:02.79,0:20:05.89,ZWDB,,0000,0000,0000,,General World Exorcist
Dialogue: 0,0:20:07.09,0:20:13.38,ZWDB,,0000,0000,0000,,Жұмыста мен не істей алатынымды көремін.
Dialogue: 0,0:20:14.39,0:20:20.11,ZWDB,,0000,0000,0000,,Гашооисо но Хикари Жауап Жауап Нокан…
Dialogue: 0,0:20:25.33,0:20:26.00,ZWDB,,0000,0000,0000,,Сайкай…
Dialogue: 0,0:20:29.16,0:20:30.23,ZWDB,,0000,0000,0000,,Императордан кейін
Dialogue: 0,0:20:31.64,0:20:35.15,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:20:39.85,0:20:40.47,ZWDB,,0000,0000,0000,,Тәртіпсіз мінез-құлық мүлдем жоқ
Dialogue: 0,0:20:41.93,0:20:47.85,ZWDB,,0000,0000,0000,,Келесі үлкен отбасы қолайсыз болып саналады, орташа сома бар болғаны 50 минутты құрайды және талап етілетін күш жақсы.
Dialogue: 0,0:20:51.18,0:20:51.58,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:20:56.75,0:20:57.99,ZWDB,,0000,0000,0000,,Қуатты қуат
Dialogue: 0,0:20:58.46,0:21:00.15,ZWDB,,0000,0000,0000,,Гаясу филиалының маршруты
Dialogue: 0,0:21:01.02,0:21:05.02,ZWDB,,0000,0000,0000,,Мен айырмашылықты ұмытып кеттім, Юта, мен жаңа код ойладым.
Dialogue: 0,0:21:06.04,0:21:06.89,ZWDB,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:21:09.72,0:21:11.71,ZWDB,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:12.45,0:21:13.62,ZWDB,,0000,0000,0000,,Tadaari Genius арнайы шығарылымы
Dialogue: 0,0:21:18.94,0:21:23.46,ZWDB,,0000,0000,0000,,Evil King Serious User: Келесі марапат сіздің күш-жігеріңіз бен шабуылыңыз үшін.
Dialogue: 0,0:21:23.69,0:21:27.19,ZWDB,,0000,0000,0000,,Мен, Қараңғы жалын манипуляторы, қараңғылықтың күшін біріктіремін.
Dialogue: 0,0:21:27.34,0:21:29.48,ZWDB,,0000,0000,0000,,Бір адамды жасаңыз және сізге симметриялы қорап сайтын беріңіз
Dialogue: 0,0:21:29.95,0:21:31.91,ZWDB,,0000,0000,0000,,Генералдың аты сенің жүрегіңде
Dialogue: 0,0:21:33.33,0:21:36.54,ZWDB,,0000,0000,0000,,«протокол коды» ойылған
Dialogue: 0,0:21:42.38,0:21:45.31,ZWDB,,0000,0000,0000,,«Black Raison Detre»
Dialogue: 0,0:21:45.76,0:21:48.14,ZWDB,,0000,0000,0000,,Бұл жердің шынайылығы «өмір сүрудің қараңғы себебі» болып табылады.
Dialogue: 0,0:21:48.49,0:21:50.28,ZWDB,,0000,0000,0000,,Мұнда сіз өзіңіздің жанашырлықтарыңызды таба аласыз.
Dialogue: 0,0:21:50.63,0:21:53.04,ZWDB,,0000,0000,0000,,Юта Кодзима
Dialogue: 0,0:21:54.31,0:21:54.98,ZWDB,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:21:55.38,0:21:57.81,ZWDB,,0000,0000,0000,,Қашан не болатыны туралы сөйлесейік
Dialogue: 0,0:21:59.33,0:22:01.69,ZWDB,,0000,0000,0000,,Токичи Горо