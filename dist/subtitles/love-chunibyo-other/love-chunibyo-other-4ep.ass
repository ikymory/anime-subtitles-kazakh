Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0000,0000,0000,,
Dialogue: 0,0:22:09.37,0:22:13.02,Default,,0000,0000,0000,,

Dialogue: 0,0:00:11.45,0:00:13.59,JPDB,,0000,0000,0000,,Мен білмеймін. Мен мүлде түсінбеймін.
Dialogue: 0,0:00:14.88,0:00:19.06,JPDB,,0000,0000,0000,,Мен Нибутанидің сол жұмбақ клубқа неліктен қосылғанын білмеймін.
Dialogue: 0,0:00:19.98,0:00:22.07,JPDB,,0000,0000,0000,,"1-ші сүйкімді қыздар чемпионатының" жеңімпазы
Dialogue: 0,0:00:22.44,0:00:24.75,JPDB,,0000,0000,0000,,Нибутани - сыныптағы ең танымал бала.
Dialogue: 0,0:00:25.40,0:00:26.32,JPDB,,0000,0000,0000,,Мен бұл нені білдіретінін түсінбеймін.
Dialogue: 0,0:00:27.43,0:00:31.98,JPDB,,0000,0000,0000,,Сіз шынымен сиқырға қызығасыз ба? Немесе ұйықтауға қызығасыз ба?
Dialogue: 0,0:00:33.05,0:00:36.88,JPDB,,0000,0000,0000,,Немесе жоқ, шынымен.
Dialogue: 0,0:00:38.52,0:00:40.73,JPDB,,0000,0000,0000,,Неге қосылғың келді?
Dialogue: 0,0:00:41.38,0:00:46.70,JPDB,,0000,0000,0000,,Кешіріңіз, мен сізді ұйықтауға соншалықты қызықтырғаныңыз жоқ па деп ойламаймын...
Dialogue: 0,0:00:47.27,0:00:48.19,JPDB,,0000,0000,0000,,Білгіңіз келе ме?
Dialogue: 0,0:00:50.45,0:00:51.39,JPDB,,0000,0000,0000,,Ух...иә
Dialogue: 0,0:00:53.06,0:00:57.11,JPDB,,0000,0000,0000,,Бұл біреудің түтіккендігінен.
Dialogue: 0,0:00:57.56,0:01:01.86,JPDB,,0000,0000,0000,,Жоқ, жоқ, күте тұр, күте тұр, күте тұр, осындай қысқаша қорытындымен қателес.
Dialogue: 0,0:01:02.13,0:01:07.42,JPDB,,0000,0000,0000,,Дүние жүзіндегі ерлер халқының 80%-ы ауыр қорлауды бастан өткерген болуы керек.
Dialogue: 0,0:01:09.31,0:01:11.13,JPDB,,0000,0000,0000,,Тағы да сабырмен ойланайық
Dialogue: 0,0:01:14.81,0:01:15.97,JPDB,,0000,0000,0000,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:01:27.26,0:01:30.59,JPDB,,0000,0000,0000,,Соңында мен Риккадағы сол клубқа қосылдым.
Dialogue: 0,0:01:28.50,0:01:30.61,JPDB,,0000,0000,0000,,Тоғашы, кеңшілік көп емес пе?
Dialogue: 0,0:01:30.81,0:01:31.81,JPDB,,0000,0000,0000,,Жоқ, ммм.
Dialogue: 0,0:01:32.13,0:01:35.24,JPDB,,0000,0000,0000,,Сізде ойнауға уақыт жоқ. Концентрат. Концентрат.
Dialogue: 0,0:01:35.39,0:01:36.11,JPDB,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:01:31.53,0:01:35.21,JPDB,,0000,0000,0000,,Әрине, мен chuunibyou сағындым немесе бұл бөлікте қандай да бір тартымдылық бар емес.
Dialogue: 0,0:01:36.26,0:01:38.91,JPDB,,0000,0000,0000,,Мен бұл сөздерді жалғыз қалдыра алмадым.
Dialogue: 0,0:01:39.71,0:01:45.18,JPDB,,0000,0000,0000,,Мен Тогаши-кунның клубына қосылу туралы ойладым, сондықтан мен жай ғана қосылуға өтініш бердім.
Dialogue: 0,0:01:46.79,0:01:50.00,JPDB,,0000,0000,0000,,Тоғаши-күн осылай деді...
Dialogue: 0,0:03:35.01,0:03:36.67,JPDB,,0000,0000,0000,,Нибутаниге келмегеніңізге сене алар емеспін.
Dialogue: 0,0:03:38.66,0:03:39.13,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:03:40.20,0:03:42.96,JPDB,,0000,0000,0000,,Қараңғы жалын шебері шақырылған сияқты.
Dialogue: 0,0:03:43.11,0:03:48.38,JPDB,,0000,0000,0000,,Күтілгендей, «Сатурнус сиқырлы алаңы» күшті және жаңа нәрселерді бірінен соң бірі шақырады.
Dialogue: 0,0:03:48.88,0:03:54.37,JPDB,,0000,0000,0000,,Эй, бұл не? Бұл еденде не жазылған?
Dialogue: 0,0:03:55.09,0:03:58.64,JPDB,,0000,0000,0000,,Сіз сиқырлы шеңберлер туралы білмейтін ақымақсыз ба?
Dialogue: 0,0:03:59.17,0:04:03.29,JPDB,,0000,0000,0000,,Мен сиқырлы шеңбер туралы білемін, бірақ мен едендегі жұмысты неге орындағаныңызды сұраймын.
Dialogue: 0,0:04:03.76,0:04:07.14,JPDB,,0000,0000,0000,,Сабақ үстінде сенбілік өткізетінімізді айтқан болуым керек.
Dialogue: 0,0:04:07.37,0:04:10.65,JPDB,,0000,0000,0000,,Иә, құрбандықтар толығымен дайын.
Dialogue: 0,0:04:11.74,0:04:13.93,JPDB,,0000,0000,0000,,Непентес дәмді
Dialogue: 0,0:04:14.30,0:04:17.26,JPDB,,0000,0000,0000,,Білесің бе, менің айтайын дегенім, мысықтарды мектепке әкелме.
Dialogue: 0,0:04:17.46,0:04:22.53,JPDB,,0000,0000,0000,,Бұл топ көрінбейтін шекара сызығын табу үшін құрылған. Химера қажет.
Dialogue: 0,0:04:22.65,0:04:27.28,JPDB,,0000,0000,0000,,Ұстаз, бұл құрбандықтың орнына мен жаңа нәрсе шақырамын.
Dialogue: 0,0:04:27.53,0:04:28.67,JPDB,,0000,0000,0000,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:04:29.74,0:04:33.39,JPDB,,0000,0000,0000,,Зұлым патша Шинганның атынан мен сізді шақырамын.
Dialogue: 0,0:04:33.69,0:04:40.08,JPDB,,0000,0000,0000,,Сенің атың — қараңғылықтан шыққан өлтіруші, қаны да, еті де, сүйегі де пішінсіз.
Dialogue: 0,0:04:44.03,0:04:45.42,JPDB,,0000,0000,0000,,Мен жалғастырамын
Dialogue: 0,0:04:45.92,0:04:47.76,JPDB,,0000,0000,0000,,Неліктен бұл айла-амалдардың бәрін жасадыңыз?
Dialogue: 0,0:04:47.98,0:04:51.68,JPDB,,0000,0000,0000,,Ұстаз, бұл қазіргі бұрыш. Қайта барайық.
Dialogue: 0,0:04:54.67,0:04:56.51,JPDB,,0000,0000,0000,,Мастер өте жақсы
Dialogue: 0,0:04:56.70,0:04:57.82,JPDB,,0000,0000,0000,,Сіз де Декомори ойнайсыз ба?
Dialogue: 0,0:04:57.82,0:05:00.01,JPDB,,0000,0000,0000,,Мен мұны істеймін. Мен мұны істеймін.
Dialogue: 0,0:05:01.45,0:05:05.58,JPDB,,0000,0000,0000,,Ымырттан күңгірт нәрсе, қан ағынынан қызылырақ нәрсе
Dialogue: 0,0:05:12.11,0:05:15.67,JPDB,,0000,0000,0000,,Біздер бірдей жойылып кетпесін! сүйреу
Dialogue: 0,0:05:20.81,0:05:23.92,JPDB,,0000,0000,0000,,Бұл не? Сен не істеп жатырсың?
Dialogue: 0,0:05:24.34,0:05:26.53,JPDB,,0000,0000,0000,,Ұстаз күткендей, мен түсінемін.
Dialogue: 0,0:05:26.63,0:05:27.18,JPDB,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:05:28.19,0:05:30.51,JPDB,,0000,0000,0000,,Мен оны жек көремін, мен мұны істей алмаймын.
Dialogue: 0,0:05:31.00,0:05:31.90,JPDB,,0000,0000,0000,,Оны тазалаңыз.
Dialogue: 0,0:05:33.71,0:05:37.12,JPDB,,0000,0000,0000,,​​Өзің шақырғанның оны пайдалануы қорлық.
Dialogue: 0,0:05:37.27,0:05:38.98,JPDB,,0000,0000,0000,,Dark Flame Master күткендей
Dialogue: 0,0:05:39.35,0:05:41.76,JPDB,,0000,0000,0000,,Көп сөйлеме, тез тазала.
Dialogue: 0,0:05:42.06,0:05:43.76,JPDB,,0000,0000,0000,,Міне, Хоқа-сенпай да оянып кетті.
Dialogue: 0,0:05:43.93,0:05:46.04,JPDB,,0000,0000,0000,,Моссен мүгі ащы.
Dialogue: 0,0:05:46.49,0:05:48.03,JPDB,,0000,0000,0000,,Сіз не туралы армандайсыз?
Dialogue: 0,0:05:50.59,0:05:51.56,JPDB,,0000,0000,0000,,Сәлем
Dialogue: 0,0:05:51.88,0:05:53.10,JPDB,,0000,0000,0000,,Ни...Нибутани
Dialogue: 0,0:05:53.32,0:05:57.45,JPDB,,0000,0000,0000,,Клубқа қосылғаныма өкінемін, бірақ шерменделер клубы бос емес болғандықтан ұзақ уақыт келе алмадым.
Dialogue: 0,0:05:57.62,0:06:02.00,JPDB,,0000,0000,0000,,Көзге көрінбейтін шекараны іздеу тұрақты түрде жүріп жатқанына сенімді болыңыз.
Dialogue: 0,0:06:02.19,0:06:03.91,JPDB,,0000,0000,0000,,Көрінбейтін... не?
Dialogue: 0,0:06:04.88,0:06:06.15,JPDB,,0000,0000,0000,,Сіз... бұл туралы алаңдамаңыз.
Dialogue: 0,0:06:06.42,0:06:06.82,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:06:08.26,0:06:09.30,JPDB,,0000,0000,0000,,О, бұл не?
Dialogue: 0,0:06:10.92,0:06:12.14,JPDB,,0000,0000,0000,,Не... бұл ештеңе емес.
Dialogue: 0,0:06:14.32,0:06:15.89,JPDB,,0000,0000,0000,,Бұл сиқырлы шеңбер болуы мүмкін бе?
Dialogue: 0,0:06:16.19,0:06:18.90,JPDB,,0000,0000,0000,,Олай болса, мен маңызды сиқырлы зерттеулер жүргіземін.
Dialogue: 0,0:06:18.90,0:06:20.71,JPDB,,0000,0000,0000,,Жоқ, жоқ, жоқ, бұл әзіл, әзіл
Dialogue: 0,0:06:21.31,0:06:25.01,JPDB,,0000,0000,0000,,Біздің қауымдастықтың мақсаты – көрінбейтін шекараны ашу.
Dialogue: 0,0:06:25.28,0:06:29.19,JPDB,,0000,0000,0000,,Ол үшін «Зұлым патша шынайы көз» және «Мжолнир балғасы» қолданылады.
Dialogue: 0,0:06:29.56,0:06:33.19,JPDB,,0000,0000,0000,,«Қара жалын шеберінің» бірлескен күшімен
Dialogue: 0,0:06:33.36,0:06:37.31,JPDB,,0000,0000,0000,,Біраз күте тұрыңыз, сондықтан айтпаңыз деп айттым.
Dialogue: 0,0:06:37.41,0:06:41.19,JPDB,,0000,0000,0000,,Не сыбырлап тұрсың? Қараңғы жалын шебері
Dialogue: 0,0:06:42.31,0:06:45.24,JPDB,,0000,0000,0000,,Неге үндемейсің? Қараңғы жалын шебері
Dialogue: 0,0:06:45.44,0:06:46.78,JPDB,,0000,0000,0000,,Сіз мұны әдейі істеп жатқан болуыңыз керек.
Dialogue: 0,0:06:46.91,0:06:49.99,JPDB,,0000,0000,0000,,Бұл не? Қараңғы жалын шебері
Dialogue: 0,0:06:52.18,0:06:53.79,JPDB,,0000,0000,0000,,Қараңғы жалын шебері
Dialogue: 0,0:06:54.34,0:06:56.35,JPDB,,0000,0000,0000,,Оны ашыңыз, ашыңыз.
Dialogue: 0,0:06:56.65,0:06:57.42,JPDB,,0000,0000,0000,,Та-да!
Dialogue: 0,0:06:57.42,0:07:00.28,JPDB,,0000,0000,0000,,Уайымдама, тез үйреніп кетесің.
Dialogue: 0,0:07:00.35,0:07:04.43,JPDB,,0000,0000,0000,,А, бұл кедергі параллель әлеммен байланысты болуы мүмкін.
Dialogue: 0,0:07:04.93,0:07:05.55,JPDB,,0000,0000,0000,,Көрдің бе?
Dialogue: 0,0:07:07.71,0:07:09.60,JPDB,,0000,0000,0000,,Эй, не?
Dialogue: 0,0:07:10.39,0:07:14.55,JPDB,,0000,0000,0000,,7 мамыр Хока-сан Мен клуб мүшесімін және екінші курс студентімін, бірақ менің хоббиім ұйықтау.
Dialogue: 0,0:07:15.14,0:07:17.88,JPDB,,0000,0000,0000,,Қараңызшы, топтың аты «нап» деп тұр.
Dialogue: 0,0:07:18.05,0:07:21.75,JPDB,,0000,0000,0000,,Ойланып қарасақ... Сонымен Тоғашы-күн де ​​ұйқы іздейді.
Dialogue: 0,0:07:22.18,0:07:24.64,JPDB,,0000,0000,0000,,А, жоқ, мәселе бұл емес.
Dialogue: 0,0:07:24.74,0:07:26.23,JPDB,,0000,0000,0000,,Онда неге бұл бөлік?
Dialogue: 0,0:07:26.35,0:07:30.50,JPDB,,0000,0000,0000,,О, жоқ, бұл... у... Нюдани неге мұндай?
Dialogue: 0,0:07:31.87,0:07:35.75,JPDB,,0000,0000,0000,,Тогаши-кунның себебін айту қазірдің өзінде қиын.
Dialogue: 0,0:07:36.07,0:07:40.42,JPDB,,0000,0000,0000,,Уау... бұл шын мәнінде мағыналы жол, бірақ ол әлі де шындық.
Dialogue: 0,0:07:41.11,0:07:41.93,JPDB,,0000,0000,0000,,Маған біртіндеп орал
Dialogue: 0,0:07:42.66,0:07:43.65,JPDB,,0000,0000,0000,,Жоспар былай:
Dialogue: 0,0:07:43.97,0:07:48.97,JPDB,,0000,0000,0000,,Бұл мабиногионнан алынған жеті түсті қолжазба. Ол кетті. Мен оны осы шкафта қалдырдым.
Dialogue: 0,0:07:49.14,0:07:52.65,JPDB,,0000,0000,0000,,«Мабиногион» О, бұл менің өткен күні болған файл ба?
Dialogue: 0,0:07:53.37,0:07:55.46,JPDB,,0000,0000,0000,,Мүмкін параллель әлемде...
Dialogue: 0,0:07:56.80,0:08:00.77,JPDB,,0000,0000,0000,,Уайымдамаңыз, бұл менің үйімде. Мен оны басқа күні тазалап жүрдім.
Dialogue: 0,0:08:00.77,0:08:02.39,JPDB,,0000,0000,0000,,Мен оны қателесіп үйге әкелген сияқтымын.
Dialogue: 0,0:08:03.46,0:08:07.43,JPDB,,0000,0000,0000,,Мен оны қайтарамын. Мен оны қазір қайтарамын.
Dialogue: 0,0:08:07.43,0:08:09.27,JPDB,,0000,0000,0000,,Жарайды, жарайды, мен саған әкелемін.
Dialogue: 0,0:08:09.27,0:08:14.79,JPDB,,0000,0000,0000,,Мен оны қайтарамын, мен оны қайтарамын, мен оны қазірдің өзінде қайтарамын.
Dialogue: 0,0:08:16.18,0:08:17.80,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:18.69,0:08:21.63,JPDB,,0000,0000,0000,,Чир клубының жаттығуы басталғалы жатыр, сондықтан мен барамын.
Dialogue: 0,0:08:21.78,0:08:22.77,JPDB,,0000,0000,0000,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:08:23.12,0:08:25.16,JPDB,,0000,0000,0000,,Эй, Тогаши-кун, бір сәт қарсы боласың ба?
Dialogue: 0,0:08:25.33,0:08:25.55,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:27.02,0:08:27.84,JPDB,,0000,0000,0000,,Жексенбі?
Dialogue: 0,0:08:28.14,0:08:32.21,JPDB,,0000,0000,0000,,Иә, егер сіз бос емес болсаңыз, мұны әрқашан жасай аласыз. Эй, жақсы ма?
Dialogue: 0,0:08:32.49,0:08:35.89,JPDB,,0000,0000,0000,,​​Жоқ, бірақ бізде де жоқ, неге кенеттен?
Dialogue: 0,0:08:36.44,0:08:41.34,JPDB,,0000,0000,0000,,Неге екенін білмеймін, мен жай ғана сенімен сөйлескім келді.
Dialogue: 0,0:08:46.23,0:08:47.52,JPDB,,0000,0000,0000,,Қаншалықты оғаш болса да
Dialogue: 0,0:08:48.20,0:08:52.30,JPDB,,0000,0000,0000,,Параметрлерді арттырмасам да немесе ерекше оқиғалардың орын алуына себепші болмасам да.
Dialogue: 0,0:08:52.37,0:08:56.50,JPDB,,0000,0000,0000,,Мұндай оқиға әдетте жаман аяқталуды білдіреді.
Dialogue: 0,0:08:57.52,0:08:58.83,JPDB,,0000,0000,0000,,Бірақ бұл шындық
Dialogue: 0,0:08:59.28,0:09:00.90,JPDB,,0000,0000,0000,,Маған оқиғаны айтып берді.
Dialogue: 0,0:09:01.99,0:09:03.06,JPDB,,0000,0000,0000,,Сіз сонда қанша уақыт болдыңыз?
Dialogue: 0,0:09:03.21,0:09:07.48,JPDB,,0000,0000,0000,,Мен іздедім, бірақ, өкінішке орай, көрінбейтін шекара сызығы туралы ақпарат жоқ.
Dialogue: 0,0:09:07.73,0:09:09.82,JPDB,,0000,0000,0000,,Кітап болып шықты.
Dialogue: 0,0:09:18.00,0:09:19.79,JPDB,,0000,0000,0000,,Сіз адам әлемімен уландыңыз ба?
Dialogue: 0,0:09:20.18,0:09:21.57,JPDB,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:09:22.72,0:09:24.33,JPDB,,0000,0000,0000,,Сонда бұл мен кінәлімін бе?
Dialogue: 0,0:09:25.13,0:09:27.91,JPDB,,0000,0000,0000,,Жоқ, Dark Flame Master мұны жасамауы керек.
Dialogue: 0,0:09:27.99,0:09:33.53,JPDB,,0000,0000,0000,,Иә? Жарайды, алдағы жексенбіге жоспарыңыз бар ма?
Dialogue: 0,0:09:33.93,0:09:38.40,JPDB,,0000,0000,0000,,Жексенбі Өкінішке орай, ақпараттың ағып кетуіне байланысты ешқандай жоспар жасалмады...
Dialogue: 0,0:09:38.40,0:09:39.79,JPDB,,0000,0000,0000,,Жалғастырыңыз және жауап беріңіз.
Dialogue: 0,0:09:40.51,0:09:41.83,JPDB,,0000,0000,0000,,Әсіресе шешілмеген
Dialogue: 0,0:09:42.25,0:09:43.99,JPDB,,0000,0000,0000,,Ақыр аяғында, қашан
Dialogue: 0,0:09:45.63,0:09:46.55,JPDB,,0000,0000,0000,,Керемет көрініс
Dialogue: 0,0:09:46.85,0:09:51.35,JPDB,,0000,0000,0000,,Менің ойымша, бұл Нибутани сияқты...
Dialogue: 0,0:09:51.77,0:09:52.24,JPDB,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:52.97,0:09:54.06,JPDB,,0000,0000,0000,,Менің таңдауым жоқ
Dialogue: 0,0:09:54.23,0:09:56.50,JPDB,,0000,0000,0000,,Эй, Рикка, мен саған жақсы нәрсе көрсетемін.
Dialogue: 0,0:09:57.27,0:09:57.91,JPDB,,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:09:58.91,0:10:02.01,JPDB,,0000,0000,0000,,Бұл мен орта мектепте оқып жүргенімде ашқан басқа әлемге бару жолы.
Dialogue: 0,0:10:02.01,0:10:02.41,JPDB,,0000,0000,0000,,Не!
Dialogue: 0,0:10:02.71,0:10:05.57,JPDB,,0000,0000,0000,,Қараңызшы, бұл сәл алыс, бірақ егер сіз осыны ұстансаңыз
Dialogue: 0,0:10:05.74,0:10:08.67,JPDB,,0000,0000,0000,,Біз бұл дүние мен басқа әлемді байланыстыратын ерекшелікке жете аламыз.
Dialogue: 0,0:10:09.57,0:10:11.26,JPDB,,0000,0000,0000,,Сіз қалай ойлайсыз? Сізге қызық емес пе?
Dialogue: 0,0:10:11.48,0:10:12.38,JPDB,,0000,0000,0000,,Ерекшелік
Dialogue: 0,0:10:15.01,0:10:19.61,JPDB,,0000,0000,0000,,«Түскі сағат төртте о дүние мен бұл дүниенің екінші қолдары бір-біріне сәйкес келеді».
Dialogue: 0,0:10:19.96,0:10:20.70,JPDB,,0000,0000,0000,,«Сол кезде
Dialogue: 0,0:10:20.70,0:10:25.15,JPDB,,0000,0000,0000,,Көлеңке станциядан 13-ші жоғары вольтты мұнараны көрсететін жерге барсаңыз».
Dialogue: 0,0:10:25.75,0:10:27.76,JPDB,,0000,0000,0000,,Төрт сағат қалды, асығайық.
Dialogue: 0,0:10:28.01,0:10:32.88,JPDB,,0000,0000,0000,,Ах! Бұл қызықты. Декомори да басқа әлемде карри жегісі келеді.
Dialogue: 0,0:10:33.03,0:10:35.59,JPDB,,0000,0000,0000,,Қараңғылық дәптері соншалықты пайдалы болады деп ешқашан күткен жоқпын.
Dialogue: 0,0:10:49.58,0:10:50.38,JPDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:10:53.34,0:10:55.15,JPDB,,0000,0000,0000,,Менің жастық шағым басталады
Dialogue: 0,0:11:07.13,0:11:08.25,JPDB,,0000,0000,0000,,Мен оны таза ұстаймын.
Dialogue: 0,0:11:08.37,0:11:09.54,JPDB,,0000,0000,0000,,Менің ойымша, солай.
Dialogue: 0,0:11:10.24,0:11:12.05,JPDB,,0000,0000,0000,,Тоғашының бауырлары бар ма?
Dialogue: 0,0:11:12.30,0:11:17.02,JPDB,,0000,0000,0000,,Иә, менің екі қарындасым бар. Әй, бірақ бүгін екеуі анаммен бірге шықты.
Dialogue: 0,0:11:17.49,0:11:19.28,JPDB,,0000,0000,0000,,Сонда бұл жай ғана Тоғаши-кун.
Dialogue: 0,0:11:19.63,0:11:21.47,JPDB,,0000,0000,0000,,Иә, мен түнге дейін жалғызбын
Dialogue: 0,0:11:22.74,0:11:25.40,JPDB,,0000,0000,0000,,Жоқ...Мен бұлай айтқым келмейді.
Dialogue: 0,0:11:25.50,0:11:26.17,JPDB,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:11:26.39,0:11:29.67,JPDB,,0000,0000,0000,,Жоқ, ой... мен саған шай әкелемін.
Dialogue: 0,0:11:29.82,0:11:32.43,JPDB,,0000,0000,0000,,Иә, уайымдамаңыз.
Dialogue: 0,0:11:38.60,0:11:42.50,JPDB,,0000,0000,0000,,Уақыт жоқ. Бірақ біз бұл жерде өзімізден озып кете алмаймыз.
Dialogue: 0,0:11:43.09,0:11:46.08,JPDB,,0000,0000,0000,,Мен орта мектепте оқып жүргенімдей, мен жалғыз өзім толқу болдым.
Dialogue: 0,0:11:46.70,0:11:49.33,JPDB,,0000,0000,0000,,Алдыңғы өмірімде болған кездесуді және болашақта сіз туралы ойлау
Dialogue: 0,0:11:49.63,0:11:52.19,JPDB,,0000,0000,0000,,Осы электрондық поштаны сізде бар сиқырлы күшпен жіберіңіз.
Dialogue: 0,0:11:52.56,0:11:54.23,JPDB,,0000,0000,0000,,Сізді мәңгі сүйемін
Dialogue: 0,0:11:54.43,0:11:57.01,JPDB,,0000,0000,0000,,Өл, өл, өл, ол кезде мен
Dialogue: 0,0:11:59.18,0:12:01.14,JPDB,,0000,0000,0000,,Бұл не, менің бөлмем?
Dialogue: 0,0:12:01.78,0:12:02.73,JPDB,,0000,0000,0000,,Бірдеңе болды...
Dialogue: 0,0:12:05.44,0:12:06.90,JPDB,,0000,0000,0000,,Тоғаши-кун, не болды?
Dialogue: 0,0:12:09.24,0:12:10.19,JPDB,,0000,0000,0000,,Ум
Dialogue: 0,0:12:16.04,0:12:17.02,JPDB,,0000,0000,0000,,​​Эй... мен саған шай әкелемін.
Dialogue: 0,0:12:17.12,0:12:19.08,JPDB,,0000,0000,0000,,Иә, уайымдамаңыз.
Dialogue: 0,0:12:21.62,0:12:22.89,JPDB,,0000,0000,0000,,Бұл не болды?
Dialogue: 0,0:12:27.53,0:12:29.85,JPDB,,0000,0000,0000,,Ол қазірдің өзінде қайда?
Dialogue: 0,0:12:29.94,0:12:31.51,JPDB,,0000,0000,0000,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:12:31.96,0:12:36.73,JPDB,,0000,0000,0000,,Бұл қай жерде? Мүмкін осында шығар?
Dialogue: 0,0:12:36.73,0:12:41.53,JPDB,,0000,0000,0000,,Күт, күт, күт... Бұл жақсы емес.
Dialogue: 0,0:12:42.42,0:12:43.42,JPDB,,0000,0000,0000,,Ити
Dialogue: 0,0:12:44.04,0:12:44.81,JPDB,,0000,0000,0000,,Ол қайда?
Dialogue: 0,0:12:45.33,0:12:46.30,JPDB,,0000,0000,0000,,Не
Dialogue: 0,0:12:46.40,0:12:48.59,JPDB,,0000,0000,0000,,Бұл ақымақ мабиногионға ие болды.
Dialogue: 0,0:12:48.96,0:12:49.48,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:12:49.48,0:12:50.20,JPDB,,0000,0000,0000,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:12:51.29,0:12:56.27,JPDB,,0000,0000,0000,,Ум, мен сенімдімін. Бұл өте ауыр.
Dialogue: 0,0:12:59.05,0:12:59.89,JPDB,,0000,0000,0000,,Қ-не?
Dialogue: 0,0:13:03.22,0:13:10.16,JPDB,,0000,0000,0000,,«Есімді жоғалтып алсам да, мен бұл дүниеде 500 жыл өмір сүрген нағыз сиқыршымын.
Dialogue: 0,0:13:10.58,0:13:15.48,JPDB,,0000,0000,0000,,Рухтың жетелеуімен жазып отырған әңгімем. Дұрыс, менің атым Морисама.
Dialogue: 0,0:13:15.48,0:13:19.63,JPDB,,0000,0000,0000,,Тоқта, мен мұны естігім келмейді.
Dialogue: 0,0:13:19.63,0:13:25.22,JPDB,,0000,0000,0000,,«Менің ойымша, бұл дүниеде ақ дүние де, қара да дүние бар екенін бәріңіз де білесіздер.
Dialogue: 0,0:13:25.27,0:13:27.85,JPDB,,0000,0000,0000,,Ұят, ұят, ұят...
Dialogue: 0,0:13:27.85,0:13:29.12,JPDB,,0000,0000,0000,,Бұл реакция
Dialogue: 0,0:13:30.04,0:13:38.69,JPDB,,0000,0000,0000,,Күте тұрыңыз, Нибутани Морика Морика Морика Мори Жаз… Мори Жазы
Dialogue: 0,0:13:42.57,0:13:47.04,JPDB,,0000,0000,0000,,Бұл біртүрлі сөйлем. Мұны кім жазған деп ойлаймын.
Dialogue: 0,0:13:47.89,0:13:50.80,JPDB,,0000,0000,0000,,Не? Мынадай нәрсе ме? Мынадай нәрсе
Dialogue: 0,0:13:53.06,0:13:55.62,JPDB,,0000,0000,0000,,Нибутани Сіз...
Dialogue: 0,0:13:57.73,0:13:59.57,JPDB,,0000,0000,0000,,Қазір кеңістік-уақыт есігін ашыңыз
Dialogue: 0,0:13:59.87,0:14:01.04,JPDB,,0000,0000,0000,,Жарайсың Ұстаз
Dialogue: 0,0:14:01.16,0:14:02.80,JPDB,,0000,0000,0000,,Бұл өте қауіпті жұмыс.
Dialogue: 0,0:14:03.02,0:14:04.27,JPDB,,0000,0000,0000,,Мен оны білемін.
Dialogue: 0,0:14:04.74,0:14:09.36,JPDB,,0000,0000,0000,,Ендеше бастайық... "Schwarzzechs Prototype Mk-II"
Dialogue: 0,0:14:09.36,0:14:10.48,JPDB,,0000,0000,0000,,Тоқта
Dialogue: 0,0:14:12.97,0:14:13.86,JPDB,,0000,0000,0000,,2-эпизод: Буггарати келеді
Dialogue: 0,0:14:14.08,0:14:18.73,JPDB,,0000,0000,0000,,Бұл мені күлдіреді, тіпті мен барлық интернет журналдарымды өшіріп, өшіріп тастауым керек еді.
Dialogue: 0,0:14:19.40,0:14:21.81,JPDB,,0000,0000,0000,,Мен оны басып шығарып, қасымда ұстаймын деп ешқашан ойламадым.
Dialogue: 0,0:14:22.46,0:14:25.96,JPDB,,0000,0000,0000,,Аа, жоқ, бірақ Нибутанидің осындай нәрсе жазғанына таң қалдым.
Dialogue: 0,0:14:26.11,0:14:29.00,JPDB,,0000,0000,0000,,Мен сол орта мектептен бірде-бір оқушы болмаған орта мектепті таңдауға тырыстым.
Dialogue: 0,0:14:29.42,0:14:33.74,JPDB,,0000,0000,0000,,Мен барлық қараңғылықты өшіріп, жаңа бастама жасадым.
Dialogue: 0,0:14:34.22,0:14:36.83,JPDB,,0000,0000,0000,,Жарайды ма? Біреуге айтсаң, мен сені өлгенше қарғаймын.
Dialogue: 0,0:14:37.20,0:14:38.69,JPDB,,0000,0000,0000,,Кейіпкер тым көп өзгеретін шығар.
Dialogue: 0,0:14:39.04,0:14:40.88,JPDB,,0000,0000,0000,,Мен... білемін, айтпаймын.
Dialogue: 0,0:14:41.27,0:14:44.90,JPDB,,0000,0000,0000,,Сіз маған қанша уақыт жұмсайсыз, орта мектеп оқушысы?
Dialogue: 0,0:14:45.85,0:14:49.45,JPDB,,0000,0000,0000,,Кездейсоқ, сіз бүгін сөйлесетін бірдеңе бар деп айттыңыз ба?
Dialogue: 0,0:14:49.77,0:14:51.89,JPDB,,0000,0000,0000,,Әңгіме? Бұл мүмкін емес
Dialogue: 0,0:14:52.19,0:14:53.13,JPDB,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:14:53.55,0:14:55.94,JPDB,,0000,0000,0000,,Содан кейін мен клубқа қосылдым.
Dialogue: 0,0:14:56.11,0:14:58.85,JPDB,,0000,0000,0000,,Бұл файлдың бар болуын өшіру үшін шығар
Dialogue: 0,0:14:59.44,0:15:02.05,JPDB,,0000,0000,0000,,Мұндай клубқа қосылудың басқа себебі бар ма?
Dialogue: 0,0:15:02.50,0:15:04.05,JPDB,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:15:04.74,0:15:07.62,JPDB,,0000,0000,0000,,Бірақ енді мен ақыры өткеннен құтыла аламын.
Dialogue: 0,0:15:09.81,0:15:13.98,JPDB,,0000,0000,0000,,Қандай қызба! Ол 250 000 градус Цельсийден асып кеткен болуы керек.
Dialogue: 0,0:15:13.98,0:15:17.04,JPDB,,0000,0000,0000,,Декомори, менің әнім біткенше шыда.
Dialogue: 0,0:15:17.44,0:15:18.90,JPDB,,0000,0000,0000,,Балалар, қайтып келдіңіздер ме?
Dialogue: 0,0:15:20.22,0:15:24.35,JPDB,,0000,0000,0000,,Өкінішке орай, бұлтты болғандықтан ерекшелікті анықтау мүмкін болмады.
Dialogue: 0,0:15:24.64,0:15:28.37,JPDB,,0000,0000,0000,,Мен осында келгендіктен Мабиногионды алуға келдім.
Dialogue: 0,0:15:28.37,0:15:30.01,JPDB,,0000,0000,0000,,О, ә, ә...
Dialogue: 0,0:15:30.01,0:15:32.80,JPDB,,0000,0000,0000,,Енді мен оны тез қайтарамын. Бұл қайда?
Dialogue: 0,0:15:33.12,0:15:33.59,JPDB,,0000,0000,0000,,Міне, осы жерде.
Dialogue: 0,0:15:35.36,0:15:37.15,JPDB,,0000,0000,0000,,Ол толығымен күлге айналды.
Dialogue: 0,0:15:37.82,0:15:42.81,JPDB,,0000,0000,0000,,​​Өкінішке орай, қазір барлық жазбалар мәңгілікке жоғалды.
Dialogue: 0,0:15:42.81,0:15:47.31,JPDB,,0000,0000,0000,,Не, не, мұндай нәрсе?
Dialogue: 0,0:15:47.31,0:15:48.93,JPDB,,0000,0000,0000,,Эй, жақсысың ба?
Dialogue: 0,0:15:50.17,0:15:52.11,JPDB,,0000,0000,0000,,Декомори маңызды...
Dialogue: 0,0:15:56.63,0:15:57.06,JPDB,,0000,0000,0000,,Геф
Dialogue: 0,0:15:57.45,0:15:58.10,JPDB,,0000,0000,0000,,Геф
Dialogue: 0,0:15:58.72,0:16:02.32,JPDB,,0000,0000,0000,,Гефугефугефуфуфуфуфу
Dialogue: 0,0:16:02.72,0:16:03.94,JPDB,,0000,0000,0000,,Ал Декомори?
Dialogue: 0,0:16:04.14,0:16:05.94,JPDB,,0000,0000,0000,,Гефуфуфуфуфу
Dialogue: 0,0:16:05.94,0:16:10.90,JPDB,,0000,0000,0000,,Уайымдамаңыз, мен мұндай жағдай орын алған жағдайда көшірме жасадым.
Dialogue: 0,0:16:11.89,0:16:14.35,JPDB,,0000,0000,0000,,Морисамер – ұлы тіршілік иесі.
Dialogue: 0,0:16:14.83,0:16:18.18,JPDB,,0000,0000,0000,,Сұрақ ұяшығына жазылған параллель дүниелер туралы сұраққа жауап
Dialogue: 0,0:16:18.28,0:16:22.08,JPDB,,0000,0000,0000,,Ол қожайынымен жауап берген ұлы сиқыршы.
Dialogue: 0,0:16:23.33,0:16:27.35,JPDB,,0000,0000,0000,,Бұл сөздер қауіпті деп танылды және мемлекеттік органдар оларды алып тастады.
Dialogue: 0,0:16:27.35,0:16:30.04,JPDB,,0000,0000,0000,,Декомори міндетті түрде мұрагер болады...
Dialogue: 0,0:16:30.36,0:16:33.32,JPDB,,0000,0000,0000,,Мен оны өзім жойдым, себебі мен бұдан былай шыдай алмадым.
Dialogue: 0,0:16:33.66,0:16:35.11,JPDB,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:16:35.43,0:16:39.03,JPDB,,0000,0000,0000,,«Мори жазы», ​​жарай ма? Мен соны жаздым
Dialogue: 0,0:16:39.28,0:16:41.94,JPDB,,0000,0000,0000,,Бір жыл бұрын мен сіздің сұрағыңызға жауап бердім.
Dialogue: 0,0:16:42.12,0:16:45.50,JPDB,,0000,0000,0000,,Енді ''Мабиногион''ыңызды жазған адамға беріңіз.
Dialogue: 0,0:16:46.17,0:16:50.86,JPDB,,0000,0000,0000,,Ақымақ болма. Сіз сияқты шіріген қарапайым адамның морисамер болуы мүмкін емес.
Dialogue: 0,0:16:50.86,0:16:53.00,JPDB,,0000,0000,0000,,Шіріген қарапайым адам кім?
Dialogue: 0,0:16:53.00,0:16:54.12,JPDB,,0000,0000,0000,,Эй Нибутани
Dialogue: 0,0:16:55.91,0:16:57.40,JPDB,,0000,0000,0000,,Қандай тас бас.
Dialogue: 0,0:16:57.40,0:16:59.56,JPDB,,0000,0000,0000,,Бұл өзімді Морисама деп атағаным үшін жазалауым.
Dialogue: 0,0:16:59.84,0:17:01.08,JPDB,,0000,0000,0000,,Бұл шынайы.
Dialogue: 0,0:17:01.38,0:17:06.50,JPDB,,0000,0000,0000,,Бұл есімді енді ешқашан айтпа, мен сенің өміріңді аяймын.
Dialogue: 0,0:17:06.62,0:17:07.76,JPDB,,0000,0000,0000,,Декомори ауыр
Dialogue: 0,0:17:08.11,0:17:11.05,JPDB,,0000,0000,0000,,Содан кейін Мастер Декомори тез кетеді.
Dialogue: 0,0:17:14.25,0:17:16.49,JPDB,,0000,0000,0000,,Сол орта мектеп оқушысы, мұны есте сақта.
Dialogue: 0,0:17:17.68,0:17:23.60,JPDB,,0000,0000,0000,,Көк пен жердің рухтары, маған баталарыңмен қуат бер.
Dialogue: 0,0:17:24.62,0:17:29.84,JPDB,,0000,0000,0000,,Санае Декомориге бақытсыздық келуі мүмкін.
Dialogue: 0,0:17:28.27,0:17:30.03,JPDB,,0000,0000,0000,,Сол Нибутани
Dialogue: 0,0:17:30.90,0:17:34.04,JPDB,,0000,0000,0000,,Жүз рет қатарынан айтпайынша, ол жұмыс істемейді.
Dialogue: 0,0:17:34.56,0:17:36.42,JPDB,,0000,0000,0000,,Жоқ, қарсы емессіз деп үміттенемін.
Dialogue: 0,0:17:36.89,0:17:39.01,JPDB,,0000,0000,0000,,Ол бұрынғы күйіне оралған жоқ па?
Dialogue: 0,0:17:40.27,0:17:43.43,JPDB,,0000,0000,0000,,Мен бейсаналық түрде chuunibyou тағы да зардап шектім.
Dialogue: 0,0:17:44.00,0:17:46.16,JPDB,,0000,0000,0000,,Иә, мен ол кезде болдым.
Dialogue: 0,0:17:48.82,0:17:51.01,JPDB,,0000,0000,0000,,Аруақтар тағы да сыбырлайды
Dialogue: 0,0:17:51.51,0:17:55.86,JPDB,,0000,0000,0000,,Өл, өл, ол кезде мен, өл, өл.
Dialogue: 0,0:17:54.47,0:17:56.55,JPDB,,0000,0000,0000,,Тоқта, Нибутани, жерде күнә жоқ.
Dialogue: 0,0:17:57.27,0:18:01.70,JPDB,,0000,0000,0000,,Бірақ мен сіздің сезіміңізді түсінемін, өйткені мен де кіші мектеп оқушысы болдым.
Dialogue: 0,0:18:02.15,0:18:02.49,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:02.97,0:18:06.94,JPDB,,0000,0000,0000,,Ойындарды немесе аниме көргенде тым сіңіп кететін бір бөлігім бар.
Dialogue: 0,0:18:07.34,0:18:10.72,JPDB,,0000,0000,0000,,Мен өзімді сол кейіпкер ретінде көрсеттім және менде қараңғы күштер бар деп ойладым.
Dialogue: 0,0:18:12.24,0:18:14.82,JPDB,,0000,0000,0000,,«Қара жалын шебері»
Dialogue: 0,0:18:15.12,0:18:19.20,JPDB,,0000,0000,0000,,Дұрыс, суық.
Dialogue: 0,0:18:20.31,0:18:22.40,JPDB,,0000,0000,0000,,Оның үстіне ол бала қайда тұрады?
Dialogue: 0,0:18:22.82,0:18:25.43,JPDB,,0000,0000,0000,,Жоқ, менің ойымша, Рикка білетін шығар.
Dialogue: 0,0:18:25.81,0:18:26.35,JPDB,,0000,0000,0000,,Сіз қоңырау шалдыңыз ба?
Dialogue: 0,0:18:27.75,0:18:29.01,JPDB,,0000,0000,0000,,Айтайын дегенім, сіз әлі де сондасыз ба?
Dialogue: 0,0:18:29.83,0:18:34.88,JPDB,,0000,0000,0000,,​​Декомори менің қасымда Морисамаға ант берді деп айтудың қажеті жоқ.
Dialogue: 0,0:18:35.57,0:18:39.20,JPDB,,0000,0000,0000,,Мабиногионның сансыз көшірмелері бар шығар.
Dialogue: 0,0:18:39.82,0:18:40.62,JPDB,,0000,0000,0000,,Бұл өтірік болар еді
Dialogue: 0,0:18:41.14,0:18:44.37,JPDB,,0000,0000,0000,,Нағыз Морисамерден басқа ешкімге жүрегімді ашпаймын.
Dialogue: 0,0:18:44.77,0:18:47.23,JPDB,,0000,0000,0000,,Дегенмен, бұл біздің қолымыздан ештеңе келмейді дегенді білдірмейді
Dialogue: 0,0:18:48.20,0:18:48.50,JPDB,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:18:48.90,0:18:49.89,JPDB,,0000,0000,0000,,Жоқ бірақ
Dialogue: 0,0:18:50.34,0:18:53.94,JPDB,,0000,0000,0000,,Айтыңызшы, менің орта мектептегі мансабыма қауіп төніп тұр.
Dialogue: 0,0:18:56.90,0:18:57.47,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:19:05.57,0:19:06.72,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:07.31,0:19:09.97,JPDB,,0000,0000,0000,,Күшіңді сынап көрейін
Dialogue: 0,0:19:10.59,0:19:12.53,JPDB,,0000,0000,0000,,Сіз де ешқашан үйренбейтін адамсыз.
Dialogue: 0,0:19:13.08,0:19:16.19,JPDB,,0000,0000,0000,,Қазір сондай күшті болатын кез.
Dialogue: 0,0:19:24.91,0:19:26.65,JPDB,,0000,0000,0000,,Олар мұны аздап жасайтын сияқты.
Dialogue: 0,0:19:27.25,0:19:29.68,JPDB,,0000,0000,0000,,Әрине, Тоғашының айтқаны сияқты.
Dialogue: 0,0:19:30.40,0:19:33.36,JPDB,,0000,0000,0000,,Басқаша айтқанда, ол алданған Чуунибио әлемінде.
Dialogue: 0,0:19:33.63,0:19:36.04,JPDB,,0000,0000,0000,,Сізге тек Нибутаниді керемет жігіт деп санау керек.
Dialogue: 0,0:19:43.25,0:19:45.81,JPDB,,0000,0000,0000,,«Синапсты» жарып жіберейік, нақты
Dialogue: 0,0:19:46.31,0:19:49.14,JPDB,,0000,0000,0000,,«Бұл әлемді қуу»
Dialogue: 0,0:19:56.87,0:19:58.36,JPDB,,0000,0000,0000,,Кеттік, Накабо.
Dialogue: 0,0:20:03.46,0:20:05.20,JPDB,,0000,0000,0000,,Олар мұны аздап жасайтын сияқты.
Dialogue: 0,0:20:10.24,0:20:12.85,JPDB,,0000,0000,0000,,«Мжолнир торнадо»
Dialogue: 0,0:20:19.96,0:20:21.55,JPDB,,0000,0000,0000,,«Жан Брунак»
Dialogue: 0,0:20:29.01,0:20:32.51,JPDB,,0000,0000,0000,,Қанша тырыссаң да пайдасы жоқ. Сіз Морисамер емессіз.
Dialogue: 0,0:20:32.69,0:20:34.25,JPDB,,0000,0000,0000,,Сондықтан мен
Dialogue: 0,0:20:34.45,0:20:38.06,JPDB,,0000,0000,0000,,Морисамер махаббаттың бәрі екенін айтты.
Dialogue: 0,0:20:38.73,0:20:41.68,JPDB,,0000,0000,0000,,Рухтарды көру үшін дұрыс жүрек керек.
Dialogue: 0,0:20:42.16,0:20:45.14,JPDB,,0000,0000,0000,,Дүниедегі жалғыз сиқыршы бүгінгі күнге дейін сақталған.
Dialogue: 0,0:20:45.36,0:20:49.34,JPDB,,0000,0000,0000,,Барлық қайғы мен бослықты көтеріп, мен өмір сүремін ...
Dialogue: 0,0:20:49.34,0:20:53.02,JPDB,,0000,0000,0000,,Жоқ, қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:20:53.89,0:20:58.44,JPDB,,0000,0000,0000,,Күткендей, Морисаманың сөздері сол шіріген жүректі тазартады.
Dialogue: 0,0:20:58.61,0:20:59.73,JPDB,,0000,0000,0000,,Бұл жалған
Dialogue: 0,0:20:59.90,0:21:03.83,JPDB,,0000,0000,0000,,Естігім келмейді, есіме түсірме
Dialogue: 0,0:21:05.20,0:21:08.58,JPDB,,0000,0000,0000,,Өйткені, бұрынғы чуунибиоу Геншинді сынаса да, жақсылық болмас еді.
Dialogue: 0,0:21:08.92,0:21:13.12,JPDB,,0000,0000,0000,,Дайкоку-сан
Dialogue: 0,0:21:15.98,0:21:17.52,JPDB,,0000,0000,0000,,Иә, өтінемін
Dialogue: 0,0:21:17.72,0:21:18.20,JPDB,,0000,0000,0000,,Сәлем
Dialogue: 0,0:21:18.77,0:21:20.98,JPDB,,0000,0000,0000,,Ақырында мен қалуды шештім
Dialogue: 0,0:21:21.25,0:21:24.04,JPDB,,0000,0000,0000,,Ол өз мақсатын орындамайынша.
Dialogue: 0,0:21:25.38,0:21:30.05,JPDB,,0000,0000,0000,,Егер сен сондай болсаң, мен саған №5 мүшесі бар жастық беремін, ұйқы клубының дәлелі.
Dialogue: 0,0:21:30.37,0:21:31.24,JPDB,,0000,0000,0000,,Енді ол менікі
Dialogue: 0,0:21:33.65,0:21:34.33,JPDB,,0000,0000,0000,,Накабо
Dialogue: 0,0:21:34.90,0:21:36.61,JPDB,,0000,0000,0000,,Бұл не, жалған Морисама?
Dialogue: 0,0:21:36.71,0:21:40.56,JPDB,,0000,0000,0000,,Морисама деп айтпаңыз, сіз өте кішкентайсыз, бірақ сіз өте бастықсыз.
Dialogue: 0,0:21:40.96,0:21:43.92,JPDB,,0000,0000,0000,,Жаңа ғана не айттыңыз? Кішкентай емес.
Dialogue: 0,0:21:43.92,0:21:45.41,JPDB,,0000,0000,0000,,Қалай қарасаң да кішкентай.
Dialogue: 0,0:21:45.51,0:21:47.47,JPDB,,0000,0000,0000,,Ол үлкенірек болайын деп тұр
Dialogue: 0,0:21:48.32,0:21:49.78,JPDB,,0000,0000,0000,,Сіз қамқорсыз.
Dialogue: 0,0:21:50.03,0:21:53.31,JPDB,,0000,0000,0000,,Мабиногионды берсең, бойыңның қалай өсетінін көрсетемін.
Dialogue: 0,0:21:53.74,0:21:56.50,JPDB,,0000,0000,0000,,Шірік жалған Морисама деген кім?
Dialogue: 0,0:21:56.67,0:21:58.19,JPDB,,0000,0000,0000,,Морисама деп айтпаңыз
Dialogue: 0,0:21:58.19,0:21:59.03,JPDB,,0000,0000,0000,,Бұл шулы
Dialogue: 0,0:21:59.13,0:21:59.95,JPDB,,0000,0000,0000,,Бірдеңе жасаңыз
Dialogue: 0,0:22:00.32,0:22:01.22,JPDB,,0000,0000,0000,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:22:02.11,0:22:03.08,JPDB,,0000,0000,0000,,Сіз...
Dialogue: 0,0:22:06.41,0:22:07.68,JPDB,,0000,0000,0000,,Эй, не?
Dialogue: 0,0:22:09.37,0:22:13.02,JPDB,,0000,0000,0000,,Сіз қазірдің өзінде не істеп жатырсыз?
Dialogue: 0,0:02:05.58,0:02:09.55,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарап біраз уақыт өткен соң
Dialogue: 0,0:02:09.78,0:02:16.34,JPOP,,0000,0000,0000,karaoke,Сіз оны бұрмастан бұрын не ойладыңыз деп ойлаймын.
Dialogue: 0,0:02:16.56,0:02:20.59,JPOP,,0000,0000,0000,karaoke,Маған қарашы еріндерім
Dialogue: 0,0:02:20.81,0:02:26.13,JPOP,,0000,0000,0000,karaoke,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:02:26.48,0:02:31.83,JPOP,,0000,0000,0000,karaoke,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:02:32.32,0:02:37.74,JPOP,,0000,0000,0000,karaoke,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:02:38.44,0:02:43.28,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарсылықсыз тартылатын махаббат
Dialogue: 0,0:02:43.63,0:02:48.10,JPOP,,0000,0000,0000,karaoke,Ол әлдеқашан басталған болатын
Dialogue: 0,0:02:49.12,0:02:51.48,JPOP,,0000,0000,0000,karaoke,Менің көп арманым болды
Dialogue: 0,0:02:51.51,0:02:55.39,JPOP,,0000,0000,0000,karaoke,Оянсам да сені көргім келеді.
Dialogue: 0,0:02:55.39,0:02:57.60,JPOP,,0000,0000,0000,karaoke,Сіз мұны жасадыңыз
Dialogue: 0,0:02:57.60,0:03:00.01,JPOP,,0000,0000,0000,karaoke,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:03:00.01,0:03:05.58,JPOP,,0000,0000,0000,karaoke,Бізді секіртетін жүрекке ерейік
Dialogue: 0,0:03:05.58,0:03:08.19,JPOP,,0000,0000,0000,karaoke,Идеалдар, адасулар және шындық
Dialogue: 0,0:03:08.31,0:03:10.82,JPOP,,0000,0000,0000,karaoke,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:03:11.05,0:03:16.17,JPOP,,0000,0000,0000,karaoke,Жаңа әлемге
Dialogue: 0,0:02:05.58,0:02:09.55,JPOP,,0000,0000,0000,fx,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:02:09.78,0:02:16.34,JPOP,,0000,0000,0000,fx,Маған таң қалдырмас бұрын сіз не ойладыңыз?
Dialogue: 0,0:02:16.56,0:02:20.59,JPOP,,0000,0000,0000,fx,Маған қарашы еріндері
Dialogue: 0,0:02:20.81,0:02:26.13,JPOP,,0000,0000,0000,fx,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:02:26.48,0:02:31.83,JPOP,,0000,0000,0000,fx,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:02:32.32,0:02:37.74,JPOP,,0000,0000,0000,fx,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:02:38.44,0:02:43.28,JPOP,,0000,0000,0000,fx,Сізді бір-біріңізге тартатын махаббат
Dialogue: 0,0:02:43.63,0:02:48.10,JPOP,,0000,0000,0000,fx,Ол әлдеқашан басталған болатын
Dialogue: 0,0:02:49.12,0:02:51.48,JPOP,,0000,0000,0000,fx,Менің көп арманым болды
Dialogue: 0,0:02:51.51,0:02:55.39,JPOP,,0000,0000,0000,fx,Оянсам да, сені көргім келеді.
Dialogue: 0,0:02:55.39,0:02:57.60,JPOP,,0000,0000,0000,fx,Сіз мұны жасадыңыз
Dialogue: 0,0:02:57.60,0:03:00.01,JPOP,,0000,0000,0000,fx,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:03:00.01,0:03:05.58,JPOP,,0000,0000,0000,fx,Жүрегіміз секіріп бара жатқандай, қайда барайық
Dialogue: 0,0:03:05.58,0:03:08.19,JPOP,,0000,0000,0000,fx,Идеалдар, адасулар және шындық
Dialogue: 0,0:03:08.31,0:03:10.82,JPOP,,0000,0000,0000,fx,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:03:11.05,0:03:16.17,JPOP,,0000,0000,0000,fx,Жаңа әлемге
Dialogue: 0,0:02:05.58,0:02:09.55,ZWOP,,0000,0000,0000,fx,Сіз екі көзбен осы сәттесіз
Dialogue: 0,0:02:09.80,0:02:16.34,ZWOP,,0000,0000,0000,fx,Қозғалмас бұрын қайда екеніңізді көре аласыз.
Dialogue: 0,0:02:16.56,0:02:20.59,ZWOP,,0000,0000,0000,fx,Менің тұмсығыма қара
Dialogue: 0,0:02:20.81,0:02:26.13,ZWOP,,0000,0000,0000,fx,Жиналыстың сұрағы `` Мен мұны істегім келеді '' Сондай-ақ, үндемеңіз.
Dialogue: 0,0:02:26.48,0:02:31.83,ZWOP,,0000,0000,0000,fx,Моңғолияның өз бетімен сөйлесуі
Dialogue: 0,0:02:32.32,0:02:37.74,ZWOP,,0000,0000,0000,fx,Қуат қайтадан қажет емес.
Dialogue: 0,0:02:38.44,0:02:43.28,ZWOP,,0000,0000,0000,fx,Өзара тартымдылық махаббат
Dialogue: 0,0:02:43.63,0:02:48.10,ZWOP,,0000,0000,0000,fx,Жаңа ғана басталды
Dialogue: 0,0:02:49.12,0:02:51.48,ZWOP,,0000,0000,0000,fx,Шектеусіз әдемі армандар
Dialogue: 0,0:02:51.51,0:02:55.39,ZWOP,,0000,0000,0000,fx,Бұл түстен оянғаннан кейін де оны көру керек.
Dialogue: 0,0:02:55.39,0:02:57.60,ZWOP,,0000,0000,0000,fx,Капитал зиянды
Dialogue: 0,0:02:57.60,0:03:00.01,ZWOP,,0000,0000,0000,fx,Махаббат - махаббаттың шынайы табиғаты.
Dialogue: 0,0:03:00.01,0:03:05.58,ZWOP,,0000,0000,0000,fx,Будда мен баланың ішкі ойлары секіріп кетеді.
Dialogue: 0,0:03:05.58,0:03:08.19,ZWOP,,0000,0000,0000,fx,Күмән жоқ - идеал, адасушылық - шындық
Dialogue: 0,0:03:08.31,0:03:10.82,ZWOP,,0000,0000,0000,fx,Барлық астаналар сіздің кезегіңізде келді.
Dialogue: 0,0:03:11.05,0:03:16.17,ZWOP,,0000,0000,0000,fx,Жаңа әлемге шығу
Dialogue: 0,0:03:20.97,0:03:30.93,ZZ信息,,0000,0000,0000,,Бұл субтитрлер топтамасы субтитрлер тобында көрсетіледі және көбірек қытай, жапон және қытай субтитрлері алмасу үшін қолжетімді. www.kamigami.org
Dialogue: 0,0:03:20.97,0:03:30.93,ZZ信息,,0000,0000,0000,,...
Dialogue: 0,0:03:32.64,0:03:38.65,ZWBT,,0000,0000,0000,,Қайғылы... Қараңғы дүние
Dialogue: 0,0:22:16.78,0:22:19.29,JPED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:22:19.29,0:22:21.06,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:32.19,0:22:34.70,JPED,,0000,0000,0000,,Түсініспеушілік ұят па?
Dialogue: 0,0:22:34.70,0:22:37.03,JPED,,0000,0000,0000,,Адалдық зиян келтіреді.
Dialogue: 0,0:22:37.36,0:22:39.92,JPED,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:22:39.92,0:22:42.35,JPED,,0000,0000,0000,,Мен ненің дұрыс екенін білмеймін.
Dialogue: 0,0:22:42.55,0:22:45.16,JPED,,0000,0000,0000,,Әдеттегідей ағып жатқан күнделікті өмірде
Dialogue: 0,0:22:45.28,0:22:47.62,JPED,,0000,0000,0000,,Мен өзімді соған үйренуге мәжбүр еттім.
Dialogue: 0,0:22:47.62,0:22:50.25,JPED,,0000,0000,0000,,Суға батқан тұлға және қан
Dialogue: 0,0:22:50.45,0:22:52.67,JPED,,0000,0000,0000,,Шайнаңыз, ішіңіз, түкіріңіз және сындырыңыз
Dialogue: 0,0:22:52.67,0:22:57.09,JPED,,0000,0000,0000,,Мені осылай түсінгеніңізді қалаймын
Dialogue: 0,0:22:57.36,0:23:02.66,JPED,,0000,0000,0000,,Айтқым келеді, бірақ айта алмаймын.
Dialogue: 0,0:23:02.66,0:23:07.45,JPED,,0000,0000,0000,,Неге ешкім түсінбейді?
Dialogue: 0,0:23:07.68,0:23:12.62,JPED,,0000,0000,0000,,Бұл туралы ойлану сән-салтанат па? Солай ма?
Dialogue: 0,0:23:12.62,0:23:17.79,JPED,,0000,0000,0000,,Эмоциялық күн
Dialogue: 0,0:23:18.04,0:23:20.73,JPED,,0000,0000,0000,,Тым көп қызу
Dialogue: 0,0:23:20.73,0:23:23.01,JPED,,0000,0000,0000,,Бұл қандай да бір жолмен шешілетін сияқты
Dialogue: 0,0:23:23.16,0:23:28.08,JPED,,0000,0000,0000,,Айқайлағым келеді
Dialogue: 0,0:23:28.08,0:23:34.00,JPED,,0000,0000,0000,,ТҮСІКТІЛІКТІ іздеп жатыр
Dialogue: 0,0:23:34.27,0:23:36.76,JPED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:23:36.76,0:23:39.29,JPED,,0000,0000,0000,,МЕНІҢ ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,JPED,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:23:41.85,0:23:43.85,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:16.78,0:22:19.29,ZWED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:22:19.29,0:22:21.06,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:22:32.19,0:22:34.70,ZWED,,0000,0000,0000,,Жиналыста мен ұялдым
Dialogue: 0,0:22:34.70,0:22:37.03,ZWED,,0000,0000,0000,,Ашық шолу
Dialogue: 0,0:22:37.36,0:22:39.92,ZWED,,0000,0000,0000,,Оған күмән жоқ
Dialogue: 0,0:22:39.92,0:22:42.35,ZWED,,0000,0000,0000,,Белгісіз кірісімді түзететініме сенімдімін.
Dialogue: 0,0:22:42.55,0:22:45.16,ZWED,,0000,0000,0000,,Өзін-өзі анықтауды зерттеңіз
Dialogue: 0,0:22:45.28,0:22:47.62,ZWED,,0000,0000,0000,,Ичитоу Фуканнан келген Хико
Dialogue: 0,0:22:47.62,0:22:50.25,ZWED,,0000,0000,0000,,Қолбасшының эго мен қаны
Dialogue: 0,0:22:50.45,0:22:52.67,ZWED,,0000,0000,0000,,Шайнау, жылау, түкіру, ойнау
Dialogue: 0,0:22:52.67,0:22:57.09,ZWED,,0000,0000,0000,,Сіз мұны түсінесіз деп үміттенемін.
Dialogue: 0,0:22:57.36,0:23:02.66,ZWED,,0000,0000,0000,,Күтпеген ойлар ашылуы мүмкін.
Dialogue: 0,0:23:02.66,0:23:07.45,ZWED,,0000,0000,0000,,Мен адам қалмағанын түсінемін.
Dialogue: 0,0:23:07.68,0:23:12.62,ZWED,,0000,0000,0000,,Егер сізді түсінгіңіз келсе, солай етіңіз.
Dialogue: 0,0:23:12.62,0:23:17.79,ZWED,,0000,0000,0000,,Бұл эмоционалды күн
Dialogue: 0,0:23:18.04,0:23:20.73,ZWED,,0000,0000,0000,,Радиациялық жылу сыйымдылығы
Dialogue: 0,0:23:20.73,0:23:23.01,ZWED,,0000,0000,0000,,Өзін рахатқа ұшырататын теріс қылықтар
Dialogue: 0,0:23:23.16,0:23:28.08,ZWED,,0000,0000,0000,,Айқайлауға құмарлықты заңсыз шектеу
Dialogue: 0,0:23:28.08,0:23:34.00,ZWED,,0000,0000,0000,,ТҰРҒЫНДАР
Dialogue: 0,0:23:34.27,0:23:36.76,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,ZWED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,ZWED,,0000,0000,0000,,Қажетсіз кедергілер
Dialogue: 0,0:23:41.85,0:23:43.85,ZWED,,0000,0000,0000,,Қараған жерің – тұратын жерің.
Dialogue: 0,0:00:11.45,0:00:13.59,ZWDB,,0000,0000,0000,,Толығымен сынған
Dialogue: 0,0:00:14.88,0:00:19.06,ZWDB,,0000,0000,0000,,Мен Нюя-кайға қосылғаннан бері бұл оғаш клубтан көңілім қалды.
Dialogue: 0,0:00:19.98,0:00:22.07,ZWDB,,0000,0000,0000,,Наззай «Махаббат туралы алғашқы хабарлама, әйелдер өмірі» Накайоши
Dialogue: 0,0:00:22.44,0:00:24.75,ZWDB,,0000,0000,0000,,Нибутани, командадағы біртүрлі мінезі бар адам
Dialogue: 0,0:00:25.40,0:00:26.32,ZWDB,,0000,0000,0000,,Софуцу
Dialogue: 0,0:00:27.43,0:00:31.98,ZWDB,,0000,0000,0000,,Егер сізде бар сиқырды білмесеңіз, көңіл көтеруге болады.
Dialogue: 0,0:00:33.05,0:00:36.88,ZWDB,,0000,0000,0000,,Сондай-ақ, кейбір адамдар мұны дұрыс емес деп айтады.
Dialogue: 0,0:00:38.52,0:00:40.73,ZWDB,,0000,0000,0000,,Аты? Біздің компанияға қосылғыңыз келе ме деп сұраңыз.
Dialogue: 0,0:00:41.38,0:00:46.70,ZWDB,,0000,0000,0000,,Оны қабылдаңыз.
Dialogue: 0,0:00:47.27,0:00:48.19,ZWDB,,0000,0000,0000,,Сочи Доун
Dialogue: 0,0:00:50.45,0:00:51.39,ZWDB,,0000,0000,0000,,Иә...
Dialogue: 0,0:00:53.06,0:00:57.11,ZWDB,,0000,0000,0000,,Себебі, белгілі бір тұлға
Dialogue: 0,0:00:57.56,0:01:01.86,ZWDB,,0000,0000,0000,,Тең емес, тең емес, төмен, төмен, төмен, төмен, төмен, төмен, төмен, төмен, төмен, төмен, төмен, төмен, төмен, төмен, төмен;
Dialogue: 0,0:01:02.13,0:01:07.42,ZWDB,,0000,0000,0000,,Нәтижесінде планетадағы адамдардың жалпы саны жер бетіндегі ерлер халқының 80%-ына жетті.
Dialogue: 0,0:01:09.31,0:01:11.13,ZWDB,,0000,0000,0000,,Тыныш ойланып
Dialogue: 0,0:01:14.81,0:01:15.97,ZWDB,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:01:27.26,0:01:30.59,ZWDB,,0000,0000,0000,,Нәтижесінде мен Рикка клубына қосылдым.
Dialogue: 0,0:01:28.50,0:01:30.61,ZWDB,,0000,0000,0000,,Тоғаши-күн, жоғары қарап, кеудеңді көр
Dialogue: 0,0:01:30.81,0:01:31.81,ZWDB,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:01:32.13,0:01:35.24,ZWDB,,0000,0000,0000,,Мен өлгенде, мен өз назарымды шоғырландырамын.
Dialogue: 0,0:01:35.39,0:01:36.11,ZWDB,,0000,0000,0000,,Кешір мені.
Dialogue: 0,0:01:31.53,0:01:35.21,ZWDB,,0000,0000,0000,,Әрине, бұл аурудың себебі компанияның тартымдылығымен байланысты емес.
Dialogue: 0,0:01:36.26,0:01:38.91,ZWDB,,0000,0000,0000,,Бұл жай ғана осында.
Dialogue: 0,0:01:39.71,0:01:45.18,ZWDB,,0000,0000,0000,,Тогаши-кунның клубына қосылыңыз.
Dialogue: 0,0:01:46.79,0:01:50.00,ZWDB,,0000,0000,0000,,Растау: “Тогаши-кун…”
Dialogue: 0,0:03:35.01,0:03:36.67,ZWDB,,0000,0000,0000,,Нибутани келгеннен кейін
Dialogue: 0,0:03:38.66,0:03:39.13,ZWDB,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:03:40.20,0:03:42.96,ZWDB,,0000,0000,0000,,«Қара жалын манипуляторы» шақырылған адамға ұқсас.
Dialogue: 0,0:03:43.11,0:03:48.38,ZWDB,,0000,0000,0000,,「」
Dialogue: 0,0:03:48.88,0:03:54.37,ZWDB,,0000,0000,0000,,Мұнымен не айтқың келеді? Оны тақтаға салуға болады.
Dialogue: 0,0:03:55.09,0:03:58.64,ZWDB,,0000,0000,0000,,Егер сиқырлы жерде болсаңыз, бізбен кездесе алмайсыз.
Dialogue: 0,0:03:59.17,0:04:03.29,ZWDB,,0000,0000,0000,,Сиқырлы жетістік Мен негізгі тақтадағы суретте, Шығыс пен Батыста бармын.
Dialogue: 0,0:04:03.76,0:04:07.14,ZWDB,,0000,0000,0000,,Менде сенбі күнгі храмдар қоғамы кезінде білгендерімнің жазбасы бар.
Dialogue: 0,0:04:07.37,0:04:10.65,ZWDB,,0000,0000,0000,,Фестивальге дайындық аяқталды және аяқталды.
Dialogue: 0,0:04:11.74,0:04:13.93,ZWDB,,0000,0000,0000,,Қабан шөптің дәмі
Dialogue: 0,0:04:14.30,0:04:17.26,ZWDB,,0000,0000,0000,,Мысықтың мектепке баратын сапары туралы сөйлесейік
Dialogue: 0,0:04:17.46,0:04:22.53,ZWDB,,0000,0000,0000,,Бұл құрылымды көру мүмкін емес, бірақ шекаралар орнатылған.
Dialogue: 0,0:04:22.65,0:04:27.28,ZWDB,,0000,0000,0000,,Иесі: Жаңа Шығыс/Батыс келу
Dialogue: 0,0:04:27.53,0:04:28.67,ZWDB,,0000,0000,0000,,Түсінемін
Dialogue: 0,0:04:29.74,0:04:33.39,ZWDB,,0000,0000,0000,,Мен сені зұлым патшаның шынайы көзі деп атаймын.
Dialogue: 0,0:04:33.69,0:04:40.08,ZWDB,,0000,0000,0000,,Сенің атың, қара түнектен шыққан өлтіруші, сенің қаның, етің, сүйегің, бәрі бос.
Dialogue: 0,0:04:44.03,0:04:45.42,ZWDB,,0000,0000,0000,,Мәліметтер
Dialogue: 0,0:04:45.92,0:04:47.76,ZWDB,,0000,0000,0000,,Шығыс пен Батыс қаланы тамашалау
Dialogue: 0,0:04:47.98,0:04:51.68,ZWDB,,0000,0000,0000,,Қожайынның пайдалы келбеті қайтадан бірінші болып келеді.
Dialogue: 0,0:04:54.67,0:04:56.51,ZWDB,,0000,0000,0000,,Мастер Хаоден
Dialogue: 0,0:04:56.70,0:04:57.82,ZWDB,,0000,0000,0000,,Мория Деко оны сынап көру үшін келеді
Dialogue: 0,0:04:57.82,0:05:00.01,ZWDB,,0000,0000,0000,,Канаме Деко Мория сотқа жүгінуді талап етті
Dialogue: 0,0:05:01.45,0:05:05.58,ZWDB,,0000,0000,0000,,Ымырт пен қараңғылық, қанның қаны және қызаруы
Dialogue: 0,0:05:12.11,0:05:15.67,ZWDB,,0000,0000,0000,,Кешкі жер айдаһарды жоюға кепілдік береді
Dialogue: 0,0:05:20.81,0:05:23.92,ZWDB,,0000,0000,0000,,Оны айтқанда, сен осындасың.
Dialogue: 0,0:05:24.34,0:05:26.53,ZWDB,,0000,0000,0000,,Мен өзімнің қожайыным емеспін.
Dialogue: 0,0:05:26.63,0:05:27.18,ZWDB,,0000,0000,0000,,Әрине
Dialogue: 0,0:05:28.19,0:05:30.51,ZWDB,,0000,0000,0000,,Қалың шаршылар тегін
Dialogue: 0,0:05:31.00,0:05:31.90,ZWDB,,0000,0000,0000,,Жылдам соққы
Dialogue: 0,0:05:33.71,0:05:37.12,ZWDB,,0000,0000,0000,,Шақырылған Шығыс пен Батыс елшілері нағыз қорлық болды.
Dialogue: 0,0:05:37.27,0:05:38.98,ZWDB,,0000,0000,0000,,Футоси – «Қара жалын манипуляторы»
Dialogue: 0,0:05:39.35,0:05:41.76,ZWDB,,0000,0000,0000,,Басқа сөздер
Dialogue: 0,0:05:42.06,0:05:43.76,ZWDB,,0000,0000,0000,,Гакуя Хока Гакуяның жақсы туылуы
Dialogue: 0,0:05:43.93,0:05:46.04,ZWDB,,0000,0000,0000,,Соя қырыққабатын ұнатады және ұнатпайды
Dialogue: 0,0:05:46.49,0:05:48.03,ZWDB,,0000,0000,0000,,Ешқашан болмаған арман
Dialogue: 0,0:05:50.59,0:05:51.56,ZWDB,,0000,0000,0000,,Йоши Хаяками
Dialogue: 0,0:05:51.88,0:05:53.10,ZWDB,,0000,0000,0000,,Ни…Нюя Догаку
Dialogue: 0,0:05:53.32,0:05:57.45,ZWDB,,0000,0000,0000,,Біраз уақыт күтіп, компанияға қосылу.
Dialogue: 0,0:05:57.62,0:06:02.00,ZWDB,,0000,0000,0000,,Ойсыздық, көру мүмкін емес шекаралық іздеу, тура алға баратын жер
Dialogue: 0,0:06:02.19,0:06:03.91,ZWDB,,0000,0000,0000,,Көрінбейді...
Dialogue: 0,0:06:04.88,0:06:06.15,ZWDB,,0000,0000,0000,,Қажетсіздік...дайынсыздық
Dialogue: 0,0:06:06.42,0:06:06.82,ZWDB,,0000,0000,0000,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:06:08.26,0:06:09.30,ZWDB,,0000,0000,0000,,Бұл кітап.
Dialogue: 0,0:06:10.92,0:06:12.14,ZWDB,,0000,0000,0000,,Ол... астана емес.
Dialogue: 0,0:06:14.32,0:06:15.89,ZWDB,,0000,0000,0000,,Бұл сиқыр ма?
Dialogue: 0,0:06:16.19,0:06:18.90,ZWDB,,0000,0000,0000,,Наня, сіз жерді зерттеудің жалғыз шынайы сиқыршысысыз.
Dialogue: 0,0:06:18.90,0:06:20.71,ZWDB,,0000,0000,0000,,Бұл жай ғана ойыншық болғаны емес.
Dialogue: 0,0:06:21.31,0:06:25.01,ZWDB,,0000,0000,0000,,Біздің компанияны құру мақсаты - көрінбейтін шекара.
Dialogue: 0,0:06:25.28,0:06:29.19,ZWDB,,0000,0000,0000,,「」 「」
Dialogue: 0,0:06:29.56,0:06:33.19,ZWDB,,0000,0000,0000,,Бұдан әрі «Қара жалын манипуляторы» концентрлік ынтымақтастық...
Dialogue: 0,0:06:33.36,0:06:37.31,ZWDB,,0000,0000,0000,,т.б. т.б.. Менің атым басқа есім.
Dialogue: 0,0:06:37.41,0:06:41.19,ZWDB,,0000,0000,0000,,“Қара жалын манипуляторы”
Dialogue: 0,0:06:42.31,0:06:45.24,ZWDB,,0000,0000,0000,,「」
Dialogue: 0,0:06:45.44,0:06:46.78,ZWDB,,0000,0000,0000,,Сіз қасақанасыз.
Dialogue: 0,0:06:46.91,0:06:49.99,ZWDB,,0000,0000,0000,,Шитака ниеті «Қара жалын манипуляторы»
Dialogue: 0,0:06:52.18,0:06:53.79,ZWDB,,0000,0000,0000,,«Қара жалын манипуляторы»!
Dialogue: 0,0:06:54.34,0:06:56.35,ZWDB,,0000,0000,0000,,Қақпаны ұстау оңай, ашу оңай
Dialogue: 0,0:06:56.65,0:06:57.42,ZWDB,,0000,0000,0000,,Бұл серия бірінші рет өтті.
Dialogue: 0,0:06:57.42,0:07:00.28,ZWDB,,0000,0000,0000,,Қарсылықтың қажетсіз мағынасы
Dialogue: 0,0:07:00.35,0:07:04.43,ZWDB,,0000,0000,0000,,Бұл параллель дүниелердің параллель әлемі.
Dialogue: 0,0:07:04.93,0:07:05.55,ZWDB,,0000,0000,0000,,Менің кіріспе
Dialogue: 0,0:07:07.71,0:07:09.60,ZWDB,,0000,0000,0000,,Мен білгім келеді
Dialogue: 0,0:07:10.39,0:07:14.55,ZWDB,,0000,0000,0000,,Екінші курста 7 мамыр.
Dialogue: 0,0:07:15.14,0:07:17.88,ZWDB,,0000,0000,0000,,Бұл компанияның тегі li, ол «наусей» дегенді білдіреді.
Dialogue: 0,0:07:18.05,0:07:21.75,ZWDB,,0000,0000,0000,,Сенің мұнда келгеніңе сенімдімін... Натогаши Кимия демалуға келді.
Dialogue: 0,0:07:22.18,0:07:24.64,ZWDB,,0000,0000,0000,,Бұл олай емес.
Dialogue: 0,0:07:24.74,0:07:26.23,ZWDB,,0000,0000,0000,,Бұл жерден мұнда қайда бару керек
Dialogue: 0,0:07:26.35,0:07:30.50,ZWDB,,0000,0000,0000,,На…на мұның себебі.
Dialogue: 0,0:07:31.87,0:07:35.75,ZWDB,,0000,0000,0000,,Уақыт келді... Тоғашы-күн шындыққа жетеді.
Dialogue: 0,0:07:36.07,0:07:40.42,ZWDB,,0000,0000,0000,,Бұл сөйлемнің мағынасы осы.
Dialogue: 0,0:07:41.11,0:07:41.93,ZWDB,,0000,0000,0000,,4-бөлім: Астаң әлеміне кіріспе
Dialogue: 0,0:07:42.66,0:07:43.65,ZWDB,,0000,0000,0000,,Бұл келесі қадам.
Dialogue: 0,0:07:43.97,0:07:48.97,ZWDB,,0000,0000,0000,,``Мабиногион'' Жеті түсті қолжазба кітап көрінген жоқ.
Dialogue: 0,0:07:49.14,0:07:52.65,ZWDB,,0000,0000,0000,,«Мабиногион»? Бұл мен оқымас бұрын оқыған кітап.
Dialogue: 0,0:07:53.37,0:07:55.46,ZWDB,,0000,0000,0000,,Параллель дүниенің өтуі аяқталды.
Dialogue: 0,0:07:56.80,0:08:00.77,ZWDB,,0000,0000,0000,,Мен басқа жерде және туған жерімде болған кезім.
Dialogue: 0,0:08:00.77,0:08:02.39,ZWDB,,0000,0000,0000,,Жақсы бейне ұялшақ емес.
Dialogue: 0,0:08:03.46,0:08:07.43,ZWDB,,0000,0000,0000,,Мен қазір ат үстіндемін.
Dialogue: 0,0:08:07.43,0:08:09.27,ZWDB,,0000,0000,0000,,Мен сені кездестіргенде, мен сені таныдым.
Dialogue: 0,0:08:09.27,0:08:14.79,ZWDB,,0000,0000,0000,,Бұл шындық.
Dialogue: 0,0:08:16.18,0:08:17.80,ZWDB,,0000,0000,0000,,Сіз әлі де осындасыз.
Dialogue: 0,0:08:18.69,0:08:21.63,ZWDB,,0000,0000,0000,,Мен командаға жаттығуды бірінші болып бастадым.
Dialogue: 0,0:08:21.78,0:08:22.77,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:08:23.12,0:08:25.16,ZWDB,,0000,0000,0000,,Тоғашы мырза осында біраз болды.
Dialogue: 0,0:08:25.33,0:08:25.55,ZWDB,,0000,0000,0000,,Аты?
Dialogue: 0,0:08:27.02,0:08:27.84,ZWDB,,0000,0000,0000,,Жұлдызды кезең аспан?
Dialogue: 0,0:08:28.14,0:08:32.21,ZWDB,,0000,0000,0000,,Басқа уақытта қаншалықты бос емессіз?
Dialogue: 0,0:08:32.49,0:08:35.89,ZWDB,,0000,0000,0000,,​​Бұл менің ниетім емес, бірақ бұл ерекше, немесе кенет ойыма келеді.
Dialogue: 0,0:08:36.44,0:08:41.34,ZWDB,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:46.23,0:08:47.52,ZWDB,,0000,0000,0000,,Сіз көре алатын біртүрлі құбыжық
Dialogue: 0,0:08:48.20,0:08:52.30,ZWDB,,0000,0000,0000,,Бұрын хабарланған ерекше оқиға
Dialogue: 0,0:08:52.37,0:08:56.50,ZWDB,,0000,0000,0000,,Бұрын ойнап келген әртүрлі театрлар әдетте қалалық трагедия орындары ретінде барады.
Dialogue: 0,0:08:57.52,0:08:58.83,ZWDB,,0000,0000,0000,,Бұл шынайы әлем
Dialogue: 0,0:08:59.28,0:09:00.90,ZWDB,,0000,0000,0000,,Жағдайға байланысты астанаға да жеттік.
Dialogue: 0,0:09:01.99,0:09:03.06,ZWDB,,0000,0000,0000,,Сіз қашан бастадыңыз?
Dialogue: 0,0:09:03.21,0:09:07.48,ZWDB,,0000,0000,0000,,Іздеу байқаусызда жүріп жатқанымен көрінбейтін шекара сызығының өзара әрекеттесуі туралы ақпарат өте өкінішті.
Dialogue: 0,0:09:07.73,0:09:09.82,ZWDB,,0000,0000,0000,,Қазіргі уақытта тек бір кітап бар
Dialogue: 0,0:09:18.00,0:09:19.79,ZWDB,,0000,0000,0000,,Сіздің рухани дүниеңізді улау аяқталды.
Dialogue: 0,0:09:20.18,0:09:21.57,ZWDB,,0000,0000,0000,,Төтенше жағдайды күту
Dialogue: 0,0:09:22.72,0:09:24.33,ZWDB,,0000,0000,0000,,Менімен сөйлес.
Dialogue: 0,0:09:25.13,0:09:27.91,ZWDB,,0000,0000,0000,,«Қара жалын манипуляторын» көру мүмкін емес.
Dialogue: 0,0:09:27.99,0:09:33.53,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:09:33.93,0:09:38.40,ZWDB,,0000,0000,0000,,Жұлдыздық кезең жәннәт, одан құтыла алмайсың, одан құтыла алмайсың.
Dialogue: 0,0:09:38.40,0:09:39.79,ZWDB,,0000,0000,0000,,Менің жауабым басқа.
Dialogue: 0,0:09:40.51,0:09:41.83,ZWDB,,0000,0000,0000,,Қолжетімді емес немесе арнайы тіркелгі
Dialogue: 0,0:09:42.25,0:09:43.99,ZWDB,,0000,0000,0000,,Бұл НАСА-ның оқиғасы…
Dialogue: 0,0:09:45.63,0:09:46.55,ZWDB,,0000,0000,0000,,Макото Секкей
Dialogue: 0,0:09:46.85,0:09:51.35,ZWDB,,0000,0000,0000,,Міне, мен осы жерден келдім.
Dialogue: 0,0:09:51.77,0:09:52.24,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:09:52.97,0:09:54.06,ZWDB,,0000,0000,0000,,Жою заңы
Dialogue: 0,0:09:54.23,0:09:56.50,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:09:57.27,0:09:57.91,ZWDB,,0000,0000,0000,,Жақсы Шығыс?
Dialogue: 0,0:09:58.91,0:10:02.01,ZWDB,,0000,0000,0000,,Бұл мен орта мектепте оқып жүрген кезімде басқа әлемдік әдіс.
Dialogue: 0,0:10:02.01,0:10:02.41,ZWDB,,0000,0000,0000,,ол ешқашан да жақсы ана болған жоқ
Dialogue: 0,0:10:02.71,0:10:05.57,ZWDB,,0000,0000,0000,,Ол алыс, бірақ бұл жай ғана бағыт мәселесі.
Dialogue: 0,0:10:05.74,0:10:08.67,ZWDB,,0000,0000,0000,,Дүние әлемге қосылған кезде болашаққа жетудің ерекше нүктесі
Dialogue: 0,0:10:09.57,0:10:11.26,ZWDB,,0000,0000,0000,,Маған ұнамайды, мен қатты толқып тұрмын
Dialogue: 0,0:10:11.48,0:10:12.38,ZWDB,,0000,0000,0000,,Арнайы нүктелер…
Dialogue: 0,0:10:15.01,0:10:19.61,ZWDB,,0000,0000,0000,,«Таңғы төрт нүкте, әлем әлемі мен әлемнің екінші генералдарының қосындысы»
Dialogue: 0,0:10:19.96,0:10:20.70,ZWDB,,0000,0000,0000,,«Мен сонда болған кезде
Dialogue: 0,0:10:20.70,0:10:25.15,ZWDB,,0000,0000,0000,,Алдыңғы вокзалдағы жергілікті станциялар саны бойынша 13-ші жоғары жылдамдықты электр кабелі...''
Dialogue: 0,0:10:25.75,0:10:27.76,ZWDB,,0000,0000,0000,,Төрт шағын сағат бар.
Dialogue: 0,0:10:28.01,0:10:32.88,ZWDB,,0000,0000,0000,,Апыр-ай! Жақсы қимыл, дөңес күзет, Ойым басқа дүниеде, ішіп-жеп
Dialogue: 0,0:10:33.03,0:10:35.59,ZWDB,,0000,0000,0000,,Ойлану негізгі қара құпия жазбалар кітабына жетті және басты кейіпкер өте бос болды.
Dialogue: 0,0:10:40.03,0:10:41.36,ZJ2,,0000,0000,0000,,«Сіз вокзалға келдіңіз».
Dialogue: 0,0:10:49.58,0:10:50.38,ZWDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:10:53.34,0:10:55.15,ZWDB,,0000,0000,0000,,Жастық шағымның басталуы
Dialogue: 0,0:11:07.13,0:11:08.25,ZWDB,,0000,0000,0000,,Жертөлеге құрмет
Dialogue: 0,0:11:08.37,0:11:09.54,ZWDB,,0000,0000,0000,,Бұл... мен осындамын.
Dialogue: 0,0:11:10.24,0:11:12.05,ZWDB,,0000,0000,0000,,Тогаши Кимиари бауырлар
Dialogue: 0,0:11:12.30,0:11:17.02,ZWDB,,0000,0000,0000,,Иә, әпкем екеуміз астанадан бірінші болып кеттік.
Dialogue: 0,0:11:17.49,0:11:19.28,ZWDB,,0000,0000,0000,,Тогаши-кун қазір осында.
Dialogue: 0,0:11:19.63,0:11:21.47,ZWDB,,0000,0000,0000,,Иә! Келесі түнге дейін мен өткеннің астанасымын.
Dialogue: 0,0:11:22.74,0:11:25.40,ZWDB,,0000,0000,0000,,Жоқ... дұрыс емес
Dialogue: 0,0:11:25.50,0:11:26.17,ZWDB,,0000,0000,0000,,Сіздің ниетіңіз қандай?
Dialogue: 0,0:11:26.39,0:11:29.67,ZWDB,,0000,0000,0000,,Фуфу Нанаги Гарочича
Dialogue: 0,0:11:29.82,0:11:32.43,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:11:38.60,0:11:42.50,ZWDB,,0000,0000,0000,,Айырмашылық жойылды, бірақ бұл мүмкін емес миссия болды.
Dialogue: 0,0:11:43.09,0:11:46.08,ZWDB,,0000,0000,0000,,Мүмкін еместік бейнесі: өз мүддесінің бастауы
Dialogue: 0,0:11:46.70,0:11:49.33,ZWDB,,0000,0000,0000,,``Бұрынғы өмірге оралу және болашақта бір мезгілде өзара түсіністікке ие болу.
Dialogue: 0,0:11:49.63,0:11:52.19,ZWDB,,0000,0000,0000,,Маған сиқырлы күш құйылды.
Dialogue: 0,0:11:52.56,0:11:54.23,ZWDB,,0000,0000,0000,,сені мәңгі сүйемін»
Dialogue: 0,0:11:54.43,0:11:57.01,ZWDB,,0000,0000,0000,,Мен белгілі бір уақытта қайтыс болдым.
Dialogue: 0,0:11:59.18,0:12:01.14,ZWDB,,0000,0000,0000,,Дауыстың дыбысы - менің бөлмемнен шыққан дауыс.
Dialogue: 0,0:12:01.78,0:12:02.73,ZWDB,,0000,0000,0000,,Әңгімені оқығаннан кейін
Dialogue: 0,0:12:05.44,0:12:06.90,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:12:09.24,0:12:10.19,ZWDB,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:12:16.04,0:12:17.02,ZWDB,,0000,0000,0000,,Мен... Гакарио көпіршікті шай
Dialogue: 0,0:12:17.12,0:12:19.08,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:12:21.62,0:12:22.89,ZWDB,,0000,0000,0000,,Өйткені ешкім сатқынды құтқармайды.
Dialogue: 0,0:12:27.53,0:12:29.85,ZWDB,,0000,0000,0000,,Шындығында, ол толығымен жетті.
Dialogue: 0,0:12:29.94,0:12:31.51,ZWDB,,0000,0000,0000,,және т.б.
Dialogue: 0,0:12:31.96,0:12:36.73,ZWDB,,0000,0000,0000,,Мен бұл жерден кете алмаймын.
Dialogue: 0,0:12:36.73,0:12:41.53,ZWDB,,0000,0000,0000,,т.б., т.б. рұқсат етілмейді!
Dialogue: 0,0:12:42.42,0:12:43.42,ZWDB,,0000,0000,0000,,Керіскерлер тобы
Dialogue: 0,0:12:44.04,0:12:44.81,ZWDB,,0000,0000,0000,,Марио Зкро
Dialogue: 0,0:12:45.33,0:12:46.30,ZWDB,,0000,0000,0000,,Джиензайюри
Dialogue: 0,0:12:46.40,0:12:48.59,ZWDB,,0000,0000,0000,,``Мабиногион'', ол Накасеге қосылған
Dialogue: 0,0:12:48.96,0:12:49.48,ZWDB,,0000,0000,0000,,Негізгі бөлік немесе қажетті бөлік
Dialogue: 0,0:12:49.48,0:12:50.20,ZWDB,,0000,0000,0000,,Кайто Кога
Dialogue: 0,0:12:51.29,0:12:56.27,ZWDB,,0000,0000,0000,,Жауапты адам бар... Шынымен маңызды адам бар.
Dialogue: 0,0:12:59.05,0:12:59.89,ZWDB,,0000,0000,0000,,Басшы сатқындарды міндетті түрде түбірімен жояды…
Dialogue: 0,0:13:03.22,0:13:10.16,ZWDB,,0000,0000,0000,,``Мен есте сақтау қабілетімнен айырылдым, бірақ мен 500 жыл бойы тірімін, енді мен әлемдегі ең ұлы сиқыршымын.''
Dialogue: 0,0:13:10.58,0:13:15.48,ZWDB,,0000,0000,0000,,Бұл мен жазған рухты басшылыққа алған жердің даму тарихы.
Dialogue: 0,0:13:15.48,0:13:19.63,ZWDB,,0000,0000,0000,,Кайстопге Гафусо Минасай
Dialogue: 0,0:13:19.63,0:13:25.22,ZWDB,,0000,0000,0000,,«Дүние осылайша лакталған қара әлем және таза ақ әлем болып екіге бөлінеді.
Dialogue: 0,0:13:25.27,0:13:27.85,ZWDB,,0000,0000,0000,,Жақсы адамдар жақсы адамдар жақсы адамдар
Dialogue: 0,0:13:27.85,0:13:29.12,ZWDB,,0000,0000,0000,,Бұл көтеріліс
Dialogue: 0,0:13:30.04,0:13:38.69,ZWDB,,0000,0000,0000,,және т.б. Нибутани Мори Жазғы Мори Жазы… Ересек Мори!
Dialogue: 0,0:13:42.57,0:13:47.04,ZWDB,,0000,0000,0000,,Бұл мақала қызық оқиға.
Dialogue: 0,0:13:47.89,0:13:50.80,ZWDB,,0000,0000,0000,,Шығыс Батыстың бұл түрі Шығыс Батыстың бұл түрі
Dialogue: 0,0:13:53.06,0:13:55.62,ZWDB,,0000,0000,0000,,Сіз Нибутани…
Dialogue: 0,0:13:57.73,0:13:59.57,ZWDB,,0000,0000,0000,,Мен осы жерден келгенде қазір ашық тұрған есік
Dialogue: 0,0:13:59.87,0:14:01.04,ZWDB,,0000,0000,0000,,жарайды, шебер
Dialogue: 0,0:14:01.16,0:14:02.80,ZWDB,,0000,0000,0000,,Бұл өте қауіпті мінез-құлық.
Dialogue: 0,0:14:03.02,0:14:04.27,ZWDB,,0000,0000,0000,,Өзімшілдік
Dialogue: 0,0:14:04.74,0:14:09.36,ZWDB,,0000,0000,0000,,Нагаоның басы… “Schwarz Sechs Prototype Mark Ⅱ”
Dialogue: 0,0:14:09.36,0:14:10.48,ZWDB,,0000,0000,0000,,Еркін аялдама
Dialogue: 0,0:14:12.97,0:14:13.86,ZWDB,,0000,0000,0000,,На...на
Dialogue: 0,0:14:14.08,0:14:18.73,ZWDB,,0000,0000,0000,,Жиналыста күлдім, Күні ашық, анық өтті.
Dialogue: 0,0:14:19.40,0:14:21.81,ZWDB,,0000,0000,0000,,Басқарылатын мөр ешқандай адасушылықсыз аяқталды.
Dialogue: 0,0:14:22.46,0:14:25.96,ZWDB,,0000,0000,0000,,Мен Нибутани университетінің студенті болғанға дейін бұл туралы ойлаған жоқпын.
Dialogue: 0,0:14:26.11,0:14:29.00,ZWDB,,0000,0000,0000,,Арнайы іріктеу кезеңіне дейін бір мектеп жиналысына қатыспаған жоғары сынып оқушылары
Dialogue: 0,0:14:29.42,0:14:33.74,ZWDB,,0000,0000,0000,,Шона Курокунидің барлық тарихы ұмытылып, жаңа өмірдің басталуы
Dialogue: 0,0:14:34.22,0:14:36.83,ZWDB,,0000,0000,0000,,Жұмыс орныма қатысты сұрақтарыңыз болса, маған хабарлаңыз.
Dialogue: 0,0:14:37.20,0:14:38.69,ZWDB,,0000,0000,0000,,Үлкен жеңілдік алу үшін сыртқы түріңізді өзгерттіңіз.
Dialogue: 0,0:14:39.04,0:14:40.88,ZWDB,,0000,0000,0000,,Білім...Чидорио Мен білмеймін.
Dialogue: 0,0:14:41.27,0:14:44.90,ZWDB,,0000,0000,0000,,Орта мектептегі гоблиннің шынайы оқиғасы.
Dialogue: 0,0:14:45.85,0:14:49.45,ZWDB,,0000,0000,0000,,Айтпас бұрын не айтасың?
Dialogue: 0,0:14:49.77,0:14:51.89,ZWDB,,0000,0000,0000,,Сіз сөйледіңіз бе? Жеуге болады
Dialogue: 0,0:14:52.19,0:14:53.13,ZWDB,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:14:53.55,0:14:55.94,ZWDB,,0000,0000,0000,,Нана...Нана да клубқа қосылды, себебі...
Dialogue: 0,0:14:56.11,0:14:58.85,ZWDB,,0000,0000,0000,,Кітаптың бар-жоғы өшіп қалғаны өкінішті.
Dialogue: 0,0:14:59.44,0:15:02.05,ZWDB,,0000,0000,0000,,Басқа клубтарға қосылу себептері
Dialogue: 0,0:15:02.50,0:15:04.05,ZWDB,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:15:04.74,0:15:07.62,ZWDB,,0000,0000,0000,,Өткенде мен бейнені бұрын шығара алдым.
Dialogue: 0,0:15:09.81,0:15:13.98,ZWDB,,0000,0000,0000,,Жақсы болатын жылу мөлшері... 25 000 градусқа жететіндей күшті.
Dialogue: 0,0:15:13.98,0:15:17.04,ZWDB,,0000,0000,0000,,Декомори: құдайларды жырлау аяқталғанға дейін
Dialogue: 0,0:15:17.44,0:15:18.90,ZWDB,,0000,0000,0000,,Сіз сәтті оралдыңыз.
Dialogue: 0,0:15:20.22,0:15:24.35,ZWDB,,0000,0000,0000,,Аспанның жоғалуына байланысты көріне алмаудың ерекше нүктесі
Dialogue: 0,0:15:24.64,0:15:28.37,ZWDB,,0000,0000,0000,,Мен «Мабиногионды» бірінші рет оқып отырмын.
Dialogue: 0,0:15:28.37,0:15:30.01,ZWDB,,0000,0000,0000,,Аты...Нана
Dialogue: 0,0:15:30.01,0:15:32.80,ZWDB,,0000,0000,0000,,Жақсы нүкте.
Dialogue: 0,0:15:33.12,0:15:33.59,ZWDB,,0000,0000,0000,,Фури
Dialogue: 0,0:15:35.36,0:15:37.15,ZWDB,,0000,0000,0000,,Тек жылуды алыңыз
Dialogue: 0,0:15:37.82,0:15:42.81,ZWDB,,0000,0000,0000,,Нағыз өкініш Жазба біржола жоғалып кетті
Dialogue: 0,0:15:42.81,0:15:47.31,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:15:47.31,0:15:48.93,ZWDB,,0000,0000,0000,,Өлім оқиғасы
Dialogue: 0,0:15:50.17,0:15:52.11,ZWDB,,0000,0000,0000,,Сақтау керек ең маңызды нәрсе…
Dialogue: 0,0:15:56.63,0:15:57.06,ZWDB,,0000,0000,0000,,Ука
Dialogue: 0,0:15:57.45,0:15:58.10,ZWDB,,0000,0000,0000,,Қоңырау?
Dialogue: 0,0:15:58.72,0:16:02.32,ZWDB,,0000,0000,0000,,У-Ко-Ко-Ко-Ко-Ко-Ко
Dialogue: 0,0:16:02.72,0:16:03.94,ZWDB,,0000,0000,0000,,Дөңес... Дөңес қорғағыш?
Dialogue: 0,0:16:04.14,0:16:05.94,ZWDB,,0000,0000,0000,,Ука-коу-ка
Dialogue: 0,0:16:05.94,0:16:10.90,ZWDB,,0000,0000,0000,,Кездесудің мән-жайына алаңдаудың қажеті жоқ, сондықтан мен жақсы орын таптым.
Dialogue: 0,0:16:11.89,0:16:14.35,ZWDB,,0000,0000,0000,,Мори Дайто - керемет тұлға
Dialogue: 0,0:16:14.83,0:16:18.18,ZWDB,,0000,0000,0000,,Мен өз сұрағыма жауап бердім.
Dialogue: 0,0:16:18.28,0:16:22.08,ZWDB,,0000,0000,0000,,Параллельді әлемдік мәселедегі ұлы сиқыршы
Dialogue: 0,0:16:23.33,0:16:27.35,ZWDB,,0000,0000,0000,,Елдің техникасы қауіпті аймақтан шығарылды.
Dialogue: 0,0:16:27.35,0:16:30.04,ZWDB,,0000,0000,0000,,Дегенмен, дөңес протектордың мұрагері туралы мәліметтер нақты ...
Dialogue: 0,0:16:30.36,0:16:33.32,ZWDB,,0000,0000,0000,,Мен өзімді-өзім құртуға бейім болғандықтан, мен оны қабылдай алмаймын.
Dialogue: 0,0:16:33.66,0:16:35.11,ZWDB,,0000,0000,0000,,Брошьтан гөрі, ол жігіт алдымен қозғалмалы орындыққа шабуыл жасайды
Dialogue: 0,0:16:35.43,0:16:39.03,ZWDB,,0000,0000,0000,,Мен Мори Отононың суретін түсірдім.
Dialogue: 0,0:16:39.28,0:16:41.94,ZWDB,,0000,0000,0000,,Жауап аздап проблема болды, бірақ бұл бір жыл бұрын мен болдым.
Dialogue: 0,0:16:42.12,0:16:45.50,ZWDB,,0000,0000,0000,,``Мабиногионның'' түпнұсқа авторы
Dialogue: 0,0:16:46.17,0:16:50.86,ZWDB,,0000,0000,0000,,Мұны айтудың тағы бір жолы – зиялы емес көпшіліктің бейнесін оқу.
Dialogue: 0,0:16:50.86,0:16:53.00,ZWDB,,0000,0000,0000,,Сен надан қарапайым адамсың
Dialogue: 0,0:16:53.00,0:16:54.12,ZWDB,,0000,0000,0000,,Дугаку Нибутани
Dialogue: 0,0:16:55.91,0:16:57.40,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:16:57.40,0:16:59.56,ZWDB,,0000,0000,0000,,Бұл менің өзімнің күпірлігім.
Dialogue: 0,0:16:59.84,0:17:01.08,ZWDB,,0000,0000,0000,,Мен нағыз ересек адаммын
Dialogue: 0,0:17:01.38,0:17:06.50,ZWDB,,0000,0000,0000,,Сіздің атыңызды қайта оқудың қажеті жоқ.
Dialogue: 0,0:17:06.62,0:17:07.76,ZWDB,,0000,0000,0000,,Декомори шындық
Dialogue: 0,0:17:08.11,0:17:11.05,ZWDB,,0000,0000,0000,,Нанао шеберінің отставкаға кетуі аяқталды
Dialogue: 0,0:17:14.25,0:17:16.49,ZWDB,,0000,0000,0000,,Нана орта мектебінің гоблинін мен жаздым
Dialogue: 0,0:17:17.68,0:17:23.60,ZWDB,,0000,0000,0000,,Дүниенің рухтары үшін аспан мен жерде бар нығметтер және біздегі күш.
Dialogue: 0,0:17:24.62,0:17:29.84,ZWDB,,0000,0000,0000,,Санае Декоками, бақытсыз ұрпақ Санае Декоками, бақытсыз ұрпақ
Dialogue: 0,0:17:28.27,0:17:30.03,ZWDB,,0000,0000,0000,,Дугаку Нюя
Dialogue: 0,0:17:30.90,0:17:34.04,ZWDB,,0000,0000,0000,,Бұл жүз өлшемді тиімді мысал.
Dialogue: 0,0:17:34.56,0:17:36.42,ZWDB,,0000,0000,0000,,Сіз жоқпын деп қалай айттыңыз?
Dialogue: 0,0:17:36.89,0:17:39.01,ZWDB,,0000,0000,0000,,Мен қатысуға дейін белгілі бір кезең болды.
Dialogue: 0,0:17:40.27,0:17:43.43,ZWDB,,0000,0000,0000,,Белгісіз белгісіз бос орын
Dialogue: 0,0:17:44.00,0:17:46.16,ZWDB,,0000,0000,0000,,Сол кезде И
Dialogue: 0,0:17:48.82,0:17:51.01,ZWDB,,0000,0000,0000,,Сөздің мәні де төмен тілдің басы.
Dialogue: 0,0:17:51.51,0:17:55.86,ZWDB,,0000,0000,0000,,Мен дүниеден өттім.
Dialogue: 0,0:17:54.47,0:17:56.55,ZWDB,,0000,0000,0000,,​​Еркін аялдама астында, Нибутани, жер жазықсыз.
Dialogue: 0,0:17:57.27,0:18:01.70,ZWDB,,0000,0000,0000,,Мен сіздің сезімдеріңізді түсінбеймін, бірақ мен орта мектептің пациентімін.
Dialogue: 0,0:18:02.15,0:18:02.49,ZWDB,,0000,0000,0000,,Аты?
Dialogue: 0,0:18:02.97,0:18:06.94,ZWDB,,0000,0000,0000,,Мен ойынды көру үшін ойынға кіргенде адасып қалдым.
Dialogue: 0,0:18:07.34,0:18:10.72,ZWDB,,0000,0000,0000,,Өзін-өзі жүзеге асыруды елестету және өзінің қараңғы қабілеттерін жүзеге асыру.
Dialogue: 0,0:18:12.24,0:18:14.82,ZWDB,,0000,0000,0000,,Әңгімені ``Қара жалын манипуляторы'' жазған.
Dialogue: 0,0:18:15.12,0:18:19.20,ZWDB,,0000,0000,0000,,суық ауа райы
Dialogue: 0,0:18:20.31,0:18:22.40,ZWDB,,0000,0000,0000,,Хики Насаидың есебінде Гананың балалары Ририде тұрады.
Dialogue: 0,0:18:22.82,0:18:25.43,ZWDB,,0000,0000,0000,,Мен таза және анық емеспін.
Dialogue: 0,0:18:25.81,0:18:26.35,ZWDB,,0000,0000,0000,,Сіз маған қоңырау шалыңыз
Dialogue: 0,0:18:27.75,0:18:29.01,ZWDB,,0000,0000,0000,,Сіз қайдасыз?
Dialogue: 0,0:18:29.83,0:18:34.88,ZWDB,,0000,0000,0000,,Әңгіме де өлі.
Dialogue: 0,0:18:35.57,0:18:39.20,ZWDB,,0000,0000,0000,,«Мабиногион» көшірмесі
Dialogue: 0,0:18:39.82,0:18:40.62,ZWDB,,0000,0000,0000,,Енді Полпо өлген соң, Буггарати әрекетке көшуі керек.
Dialogue: 0,0:18:41.14,0:18:44.37,ZWDB,,0000,0000,0000,,Декомори Фуаи Мукай Мори Ересектерге арналған ашық есік
Dialogue: 0,0:18:44.77,0:18:47.23,ZWDB,,0000,0000,0000,,Бұлай істеу мүмкін емес.
Dialogue: 0,0:18:48.20,0:18:48.50,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:18:48.90,0:18:49.89,ZWDB,,0000,0000,0000,,Жетексіз...
Dialogue: 0,0:18:50.34,0:18:53.94,ZWDB,,0000,0000,0000,,Менің орта және орта мектептегі өмірім
Dialogue: 0,0:18:56.90,0:18:57.47,ZWDB,,0000,0000,0000,,Нанаку —...
Dialogue: 0,0:19:05.57,0:19:06.72,ZWDB,,0000,0000,0000,,Тағы да
Dialogue: 0,0:19:07.31,0:19:09.97,ZWDB,,0000,0000,0000,,Сізде практикалық қабілет бар екенін көріп тұрмын.
Dialogue: 0,0:19:10.59,0:19:12.53,ZWDB,,0000,0000,0000,,Шындық - Шираничи үйден сабақ алады
Dialogue: 0,0:19:13.08,0:19:16.19,ZWDB,,0000,0000,0000,,Сіз қазіргідей күштісіз.
Dialogue: 0,0:19:24.91,0:19:26.65,ZWDB,,0000,0000,0000,,Бір ұпайлық өнімділікке қараңыз
Dialogue: 0,0:19:27.25,0:19:29.68,ZWDB,,0000,0000,0000,,Тоғаши-кунның әңгімесі анық
Dialogue: 0,0:19:30.40,0:19:33.36,ZWDB,,0000,0000,0000,,Бұл сондай-ақ алдамшы кіші әлемдік ауылдың тарихы
Dialogue: 0,0:19:33.63,0:19:36.04,ZWDB,,0000,0000,0000,,Нибутаниде оқудың зиянын көруге болады.
Dialogue: 0,0:19:43.25,0:19:45.81,ZWDB,,0000,0000,0000,,Жарылғыш бөліктің шындығы
Dialogue: 0,0:19:46.31,0:19:49.14,ZWDB,,0000,0000,0000,,(Sho World Exorcist)
Dialogue: 0,0:19:56.87,0:19:58.36,ZWDB,,0000,0000,0000,,Ryoya Kaname Junior High School Goblin
Dialogue: 0,0:20:03.46,0:20:05.20,ZWDB,,0000,0000,0000,,Бір ұпайлық өнімділікке қараңыз
Dialogue: 0,0:20:10.24,0:20:12.85,ZWDB,,0000,0000,0000,,«Найзағай Құдайдың Айдаһар кітабы»
Dialogue: 0,0:20:19.96,0:20:21.55,ZWDB,,0000,0000,0000,,«Найзағай рухы»
Dialogue: 0,0:20:29.01,0:20:32.51,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:20:32.69,0:20:34.25,ZWDB,,0000,0000,0000,,Сізге айтайын…
Dialogue: 0,0:20:34.45,0:20:38.06,ZWDB,,0000,0000,0000,,Морика ересектерге арналған әңгіме «Махаббат - бұл махаббат туралы»
Dialogue: 0,0:20:38.73,0:20:41.68,ZWDB,,0000,0000,0000,,Түйін: Адал, таза жан.
Dialogue: 0,0:20:42.16,0:20:45.14,ZWDB,,0000,0000,0000,,Дүниедегі тірі қалған жалғыз сиқыршы
Dialogue: 0,0:20:45.36,0:20:49.34,ZWDB,,0000,0000,0000,,Иеленудің азабы мен бостығы, Мен әлі тірімін...
Dialogue: 0,0:20:49.34,0:20:53.02,ZWDB,,0000,0000,0000,,Қажет емес! Тағы бір сөз
Dialogue: 0,0:20:53.89,0:20:58.44,ZWDB,,0000,0000,0000,,Үлкендердің тілі мүлде бұзылған санаға айналғаны рас.
Dialogue: 0,0:20:58.61,0:20:59.73,ZWDB,,0000,0000,0000,,Сатып алуыңыз
Dialogue: 0,0:20:59.90,0:21:03.83,ZWDB,,0000,0000,0000,,Мен бұл туралы ойлағым келмейді, бұл туралы ойлаудың қажеті жоқ.
Dialogue: 0,0:21:05.20,0:21:08.58,ZWDB,,0000,0000,0000,,Бастапқы Чуунибиу пациенті Чуунибиу пациентінің қазіргі рөлі емес.
Dialogue: 0,0:21:08.92,0:21:13.12,ZWDB,,0000,0000,0000,,Қажетсіз қайта оқу
Dialogue: 0,0:21:15.98,0:21:17.52,ZWDB,,0000,0000,0000,,Толқу
Dialogue: 0,0:21:17.72,0:21:18.20,ZWDB,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:21:18.77,0:21:20.98,ZWDB,,0000,0000,0000,,Нәтижесінде компания осында қалуға шешім қабылдады.
Dialogue: 0,0:21:21.25,0:21:24.04,ZWDB,,0000,0000,0000,,Біз мақсатымыздың дәл алдында тұрмыз.
Dialogue: 0,0:21:25.38,0:21:30.05,ZWDB,,0000,0000,0000,,Ұйқы клубының табысты мүшелерін растау.
Dialogue: 0,0:21:30.37,0:21:31.24,ZWDB,,0000,0000,0000,,Бұл маған қажет емес
Dialogue: 0,0:21:33.65,0:21:34.33,ZWDB,,0000,0000,0000,,Кіші орта мектеп Гоблин
Dialogue: 0,0:21:34.90,0:21:36.61,ZWDB,,0000,0000,0000,,Бұл ормандағы ересек адамның оқиғасы
Dialogue: 0,0:21:36.71,0:21:40.56,ZWDB,,0000,0000,0000,,Ормандағы ересектерден бөлек айғайлау.
Dialogue: 0,0:21:40.96,0:21:43.92,ZWDB,,0000,0000,0000,,Мен талантты емеспін, бірақ менде кішкентай кемшілік бар.
Dialogue: 0,0:21:43.92,0:21:45.41,ZWDB,,0000,0000,0000,,Кішкентай ақауларды көре аласыз.
Dialogue: 0,0:21:45.51,0:21:47.47,ZWDB,,0000,0000,0000,,Одан кейін бұл көп уақыт бұрын болды.
Dialogue: 0,0:21:48.32,0:21:49.78,ZWDB,,0000,0000,0000,,Осы жерде кездескенше
Dialogue: 0,0:21:50.03,0:21:53.31,ZWDB,,0000,0000,0000,,``Mabinogion'' көмегімен қалай байланысуға болады
Dialogue: 0,0:21:53.74,0:21:56.50,ZWDB,,0000,0000,0000,,Өздерін қорлайтын адаммен кім кездесе алады?
Dialogue: 0,0:21:56.67,0:21:58.19,ZWDB,,0000,0000,0000,,Елорда үлкендер үшін басқа айқай.
Dialogue: 0,0:21:58.19,0:21:59.03,ZWDB,,0000,0000,0000,,Бастықты құлатып, осылайша оның зор есірткі табысын өз пайдасына иелену үшін
Dialogue: 0,0:21:59.13,0:21:59.95,ZWDB,,0000,0000,0000,,Ләззат алу нүктесі
Dialogue: 0,0:22:00.32,0:22:01.22,ZWDB,,0000,0000,0000,,Түсінемін
Dialogue: 0,0:22:02.11,0:22:03.08,ZWDB,,0000,0000,0000,,Сізді алып кеткен адам...
Dialogue: 0,0:22:06.41,0:22:07.68,ZWDB,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:22:09.37,0:22:13.02,ZWDB,,0000,0000,0000,,Шындық мынада, сіз сонда боласыз.
Dialogue: 0,0:00:01.89,0:00:03.52,ZJ,,0000,0000,0000,,...
Dialogue: 0,0:01:17.93,0:01:20.55,ZJ1,,0000,0000,0000,,Демалыс күніне арналған ғибадатхана қоғамының қанды мөрі аймақтағы аймаққа қойылды.
Dialogue: 0,0:23:45.35,0:23:51.35,Default,,0,0,0,,{\\an8\\fs18\\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\\NБарлық құқықтары қорғалған • github.com/ikymory
