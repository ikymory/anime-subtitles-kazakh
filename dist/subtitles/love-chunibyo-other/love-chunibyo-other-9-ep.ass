Dialogue: 0,0:22:16.78,0:22:19.29,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:32.19,0:22:34.70,JPED,,0000,0000,0000,,Түсініспеушілік ұят па?
Dialogue: 0,0:22:34.70,0:22:37.03,JPED,,0000,0000,0000,,Адалдық зиян келтіреді.
Dialogue: 0,0:22:37.36,0:22:39.92,JPED,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:22:39.92,0:22:42.35,JPED,,0000,0000,0000,,Мен ненің дұрыс екенін білмеймін.
Dialogue: 0,0:22:42.55,0:22:45.16,JPED,,0000,0000,0000,,Әдеттегідей ағып жатқан күнделікті өмірде
Dialogue: 0,0:22:45.28,0:22:47.62,JPED,,0000,0000,0000,,Мен өзімді соған үйренуге мәжбүр еттім.
Dialogue: 0,0:22:47.62,0:22:50.25,JPED,,0000,0000,0000,,Суға батқан тұлға және қан
Dialogue: 0,0:22:50.45,0:22:52.67,JPED,,0000,0000,0000,,Шайнаңыз, ішіңіз, түкіріңіз және сындырыңыз
Dialogue: 0,0:22:52.67,0:22:57.09,JPED,,0000,0000,0000,,Мені осылай түсінгеніңізді қалаймын
Dialogue: 0,0:22:57.36,0:23:02.66,JPED,,0000,0000,0000,,Айтқым келеді, бірақ айта алмаймын.
Dialogue: 0,0:23:02.66,0:23:07.45,JPED,,0000,0000,0000,,Неге ешкім түсінбейді?
Dialogue: 0,0:23:07.68,0:23:12.62,JPED,,0000,0000,0000,,Бұл туралы ойлану сән-салтанат па? Солай ма?
Dialogue: 0,0:23:12.62,0:23:17.79,JPED,,0000,0000,0000,,Эмоциялық күн
Dialogue: 0,0:23:18.04,0:23:20.73,JPED,,0000,0000,0000,,Тым көп қызу
Dialogue: 0,0:23:20.73,0:23:23.01,JPED,,0000,0000,0000,,Бұл қандай да бір жолмен шешілетін сияқты
Dialogue: 0,0:23:23.16,0:23:28.08,JPED,,0000,0000,0000,,Айқайлағым келеді
Dialogue: 0,0:23:28.08,0:23:34.00,JPED,,0000,0000,0000,,ТҮСІКТІЛІКТІ іздеп жатыр
Dialogue: 0,0:23:34.27,0:23:36.76,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,JPED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,JPED,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:23:41.85,0:23:43.85,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:16.78,0:22:19.29,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,ZWED,,0000,0000,0000,,Қараған жерің – тұратын жерің.
Dialogue: 0,0:22:32.19,0:22:34.70,ZWED,,0000,0000,0000,,Жиналыста мен ұялдым
Dialogue: 0,0:22:34.70,0:22:37.03,ZWED,,0000,0000,0000,,Ашық шолу
Dialogue: 0,0:22:37.36,0:22:39.92,ZWED,,0000,0000,0000,,Оған күмән жоқ
Dialogue: 0,0:22:39.92,0:22:42.35,ZWED,,0000,0000,0000,,Белгісіз кірісімді түзететініме сенімдімін.
Dialogue: 0,0:22:42.55,0:22:45.16,ZWED,,0000,0000,0000,,Өзін-өзі анықтауды зерттеңіз
Dialogue: 0,0:22:45.28,0:22:47.62,ZWED,,0000,0000,0000,,Ичитоу Фуканнан келген Хико
Dialogue: 0,0:22:47.62,0:22:50.25,ZWED,,0000,0000,0000,,Қолбасшының эго мен қаны
Dialogue: 0,0:22:50.45,0:22:52.67,ZWED,,0000,0000,0000,,Шайнау, жылау, түкіру, ойнау
Dialogue: 0,0:22:52.67,0:22:57.09,ZWED,,0000,0000,0000,,Сіз мұны түсінесіз деп үміттенемін.
Dialogue: 0,0:22:57.36,0:23:02.66,ZWED,,0000,0000,0000,,Күтпеген ойлар ашылуы мүмкін.
Dialogue: 0,0:23:02.66,0:23:07.45,ZWED,,0000,0000,0000,,Мен адам қалмағанын түсінемін.
Dialogue: 0,0:23:07.68,0:23:12.62,ZWED,,0000,0000,0000,,Егер сізді түсінгіңіз келсе, солай етіңіз.
Dialogue: 0,0:23:12.62,0:23:17.79,ZWED,,0000,0000,0000,,Бұл эмоционалды күн
Dialogue: 0,0:23:18.04,0:23:20.73,ZWED,,0000,0000,0000,,Радиациялық жылу сыйымдылығы
Dialogue: 0,0:23:20.73,0:23:23.01,ZWED,,0000,0000,0000,,Өзін рахатқа ұшырататын теріс қылықтар
Dialogue: 0,0:23:23.16,0:23:28.08,ZWED,,0000,0000,0000,,Айқайлауға құмарлықты заңсыз шектеу
Dialogue: 0,0:23:28.08,0:23:34.00,ZWED,,0000,0000,0000,,ТҰРҒЫНДАР
Dialogue: 0,0:23:34.27,0:23:36.76,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,ZWED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,ZWED,,0000,0000,0000,,Қажетсіз кедергілер
Dialogue: 0,0:23:41.85,0:23:43.85,ZWED,,0000,0000,0000,,Қараған жерің – тұратын жерің.
Dialogue: 0,0:02:55.94,0:03:05.95,ZZ信息,,0000,0000,0000,,Бұл субтитрлер топтамасы субтитрлер тобында көрсетіледі және көбірек қытай, жапон және қытай субтитрлері алмасу үшін қолжетімді. www.kamigami.org
Dialogue: 0,0:02:55.94,0:03:05.95,ZZ信息,,0000,0000,0000,,JustiN
Dialogue: 0,0:03:12.58,0:03:18.59,ZWBT,,0000,0000,0000,,Хаотикалық... Зан Лянның алғашқы махаббаты
Dialogue: 0,0:03:25.85,0:03:27.14,ZWZJ,,0000,0000,0000,,Мектеп фестивалінің қойылымдары кітабы
Dialogue: 0,0:03:25.97,0:03:27.14,ZWZJ,,0000,0000,0000,,Джау Шинган VS Шиккуро Реенши
Dialogue: 0,0:03:26.35,0:03:27.14,ZWZJ,,0000,0000,0000,,Режиссері Морика Нибутани
Dialogue: 0,0:11:20.07,0:11:23.07,ZWZJ2,,0000,0000,0000,,Маэгуру храмы
Dialogue: 0,0:00:00.67,0:00:04.72,ZWDB,,0000,0000,0000,,Мектеп фестивалі мен үшін мектепке бару үшін қолайлы уақыт.
Dialogue: 0,0:00:05.49,0:00:10.14,ZWDB,,0000,0000,0000,,Аспан осында қалады.
Dialogue: 0,0:00:10.66,0:00:13.91,ZWDB,,0000,0000,0000,,Қайта алға жылжу түбегейлі мүмкін емес.
Dialogue: 0,0:00:10.66,0:00:12.87,ZWDB,,0000,0000,0000,,Кенеттен кенеттен шабуыл пайда болады
Dialogue: 0,0:00:12.87,0:00:14.91,ZWDB,,0000,0000,0000,,Йинана Иэясу Лала клубынан кетеді.
Dialogue: 0,0:00:15.03,0:00:17.12,ZWDB,,0000,0000,0000,,Компанияның жетістіктерін қарап шығыңыз және компанияның атауын қараңыз.
Dialogue: 0,0:00:17.32,0:00:23.36,ZWDB,,0000,0000,0000,,«Нибутани Догаку Таййакурё, мен ғибадатхананың жаңа әлеуметтік тарихын көру үшін болдым».
Dialogue: 0,0:00:23.56,0:00:25.62,ZWDB,,0000,0000,0000,,Содан бері сіз музыкалық клубтың қызметін аяқтадыңыз.
Dialogue: 0,0:00:26.44,0:00:30.84,ZWDB,,0000,0000,0000,,Қазіргі уақытта қарастырылатын маңызды нәрсе - бірінші қарау және қалада шығарылған басқа нәрселер.
Dialogue: 0,0:00:31.53,0:00:36.08,ZWDB,,0000,0000,0000,,Жағдайға байланысты біздің компанияның мектеп фестивалінде өнер көрсетуінің себебі осы.
Dialogue: 0,0:00:37.05,0:00:38.39,ZWDB,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:00:38.39,0:00:42.97,ZWDB,,0000,0000,0000,,Сіз бұл ұйымның иесісіз.
Dialogue: 0,0:00:42.97,0:00:46.27,ZWDB,,0000,0000,0000,,Басқалармен бәсекелесу және басқа ұйымдастырушылық әрекеттер
Dialogue: 0,0:00:46.27,0:00:49.08,ZWDB,,0000,0000,0000,,Қайта оқу: Біздің бастапқы құрылымымыз қандай?
Dialogue: 0,0:00:49.36,0:00:53.31,ZWDB,,0000,0000,0000,,Мияко Мейшо Даичи әлемді тастап, басқа адамға қосылды.
Dialogue: 0,0:00:53.83,0:00:57.86,ZWDB,,0000,0000,0000,,Дегенмен, сынып жабық болды және оны басқа компаниялар басып алды.
Dialogue: 0,0:00:57.98,0:01:00.69,ZWDB,,0000,0000,0000,,Сұхбат алушының позициясы да жабылды.
Dialogue: 0,0:01:01.11,0:01:04.09,ZWDB,,0000,0000,0000,,Қош келмейсіз, өйткені сізді қабылдамайды.
Dialogue: 0,0:01:05.63,0:01:07.35,ZWDB,,0000,0000,0000,,Жақсы уақыт өткізіңіз
Dialogue: 0,0:01:09.31,0:01:13.02,ZWDB,,0000,0000,0000,,Әрине, болашақ хикаясының тарихы басталды.
Dialogue: 0,0:01:13.24,0:01:14.93,ZWDB,,0000,0000,0000,,Жақсы күту
Dialogue: 0,0:01:14.93,0:01:19.03,ZWDB,,0000,0000,0000,,Мин және Мин астанасының екінші семестрінің аяқталуы аяқталды.
Dialogue: 0,0:01:19.55,0:01:24.10,ZWDB,,0000,0000,0000,,Алайда, мен қызып тұрғандықтан, мен бұл жерге деген сүйіспеншілігімді жоғалттым.
Dialogue: 0,0:03:09.56,0:03:10.33,ZWDB,,0000,0000,0000,,Көшедегі спектакль?
Dialogue: 0,0:03:10.55,0:03:10.83,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:03:11.35,0:03:15.42,ZWDB,,0000,0000,0000,,Мен телефондамын және оны қарап жатырмын.
Dialogue: 0,0:03:15.82,0:03:18.78,ZWDB,,0000,0000,0000,,Бұдан кейін қаладағы барлық ірі үй иелері кенеттен осы санаттағы әндерді айта бастады.
Dialogue: 0,0:03:19.18,0:03:24.79,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:03:25.39,0:03:26.58,ZWDB,,0000,0000,0000,,Осымен.
Dialogue: 0,0:03:27.53,0:03:29.76,ZWDB,,0000,0000,0000,,Менің бұрынғы ойларым орындауды талап етті.
Dialogue: 0,0:03:30.14,0:03:33.27,ZWDB,,0000,0000,0000,,Көріп отырғаныңыздай, бұл ең танымал шайқас категориясы.
Dialogue: 0,0:03:33.82,0:03:34.56,ZWDB,,0000,0000,0000,,Қайдасың, Жороно? Апачай?
Dialogue: 0,0:03:34.76,0:03:36.03,ZWDB,,0000,0000,0000,,Ойынды ойнаған кезде ойынды кез келген уақытта ойнай аласыз.
Dialogue: 0,0:03:36.03,0:03:40.53,ZWDB,,0000,0000,0000,,Мори Дайто талантын жоғалтты.
Dialogue: 0,0:03:40.53,0:03:44.25,ZWDB,,0000,0000,0000,,Мен қорқақпын және орта мектептегі мансабымды аяқтаған кезде қайтыс болдым.
Dialogue: 0,0:03:44.53,0:03:46.52,ZWDB,,0000,0000,0000,,Мен ерте жұмыс істеуге дайын емеспін.
Dialogue: 0,0:03:47.11,0:03:53.62,ZWDB,,0000,0000,0000,,2. Кішкентай құс, лак қара жалын елшісі, өзінің шынайы қалпында.
Dialogue: 0,0:03:53.70,0:03:57.48,ZWDB,,0000,0000,0000,,Бірдей жүру жылдамдығы 100% Менің күйеуім сол серуенді аяқтады
Dialogue: 0,0:04:04.49,0:04:05.31,ZWDB,,0000,0000,0000,,Кешірілетін қажеттілік
Dialogue: 0,0:04:07.32,0:04:09.63,ZWDB,,0000,0000,0000,,Шебердің кетуі керек...
Dialogue: 0,0:04:10.40,0:04:12.09,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:04:13.11,0:04:16.54,ZWDB,,0000,0000,0000,,Содан бері мен жақында дүниеден өтіп, қайта бастадым.
Dialogue: 0,0:04:16.86,0:04:17.43,ZWDB,,0000,0000,0000,,Есептеу
Dialogue: 0,0:04:18.50,0:04:22.03,ZWDB,,0000,0000,0000,,Себеп анық емес, бірақ үй иесі кеткеннен кейін ол кетіп қалды.
Dialogue: 0,0:04:22.70,0:04:23.25,ZWDB,,0000,0000,0000,,Қайқан
Dialogue: 0,0:04:23.72,0:04:24.19,ZWDB,,0000,0000,0000,,Қайқан
Dialogue: 0,0:04:24.54,0:04:25.24,ZWDB,,0000,0000,0000,,Қайқан
Dialogue: 0,0:04:25.56,0:04:26.11,ZWDB,,0000,0000,0000,,Қайқан
Dialogue: 0,0:04:28.15,0:04:30.04,ZWDB,,0000,0000,0000,,Гуан Ран…
Dialogue: 0,0:04:30.04,0:04:32.25,ZWDB,,0000,0000,0000,,Капитал жоқ екені рас.
Dialogue: 0,0:04:32.55,0:04:35.80,ZWDB,,0000,0000,0000,,Өкінішке орай, мен өз үйімде бір түн тұрдым, бірақ әлі өлген жоқпын.
Dialogue: 0,0:04:35.93,0:04:40.13,ZWDB,,0000,0000,0000,,Сіз сонда болған кезде өлдіңіз бе? Бір түнде әр адам өзіне бір ән айтады.
Dialogue: 0,0:04:40.13,0:04:42.98,ZWDB,,0000,0000,0000,,Дөңестікті қорғау менің міндетім.
Dialogue: 0,0:04:43.16,0:04:46.49,ZWDB,,0000,0000,0000,,Шебер мен шебердің бірлескен әрекеті.
Dialogue: 0,0:04:46.99,0:04:49.05,ZWDB,,0000,0000,0000,,Оқуға оңай.
Dialogue: 0,0:04:49.60,0:04:53.27,ZWDB,,0000,0000,0000,,«Көрінбейтін шекара сызығы» келе ме?
Dialogue: 0,0:04:53.65,0:04:55.81,ZWDB,,0000,0000,0000,,Шығыс пен батысқа сапар шегу керек.
Dialogue: 0,0:04:56.11,0:04:57.62,ZWDB,,0000,0000,0000,,Орнымнан тұрып кетіп қалдым.
Dialogue: 0,0:05:01.15,0:05:02.57,ZWDB,,0000,0000,0000,,Сен екеуміз бірге жүреміз.
Dialogue: 0,0:05:03.81,0:05:05.50,ZWDB,,0000,0000,0000,,Мен ешқандай сыртқы мәселелерден хабардар емеспін.
Dialogue: 0,0:05:06.45,0:05:07.89,ZWDB,,0000,0000,0000,,Рикканың әкесі қайтыс болғанына күмән жоқ.
Dialogue: 0,0:05:08.48,0:05:11.96,ZWDB,,0000,0000,0000,,Алты гүлге дейін не болды, бірақ он гүл.
Dialogue: 0,0:05:13.28,0:05:14.55,ZWDB,,0000,0000,0000,,Бұл өткендегі Рокка оқиғасы.
Dialogue: 0,0:05:18.75,0:05:20.37,ZWDB,,0000,0000,0000,,Мұнда болғаныңыз дұрыс.
Dialogue: 0,0:05:21.43,0:05:23.32,ZWDB,,0000,0000,0000,,Гоге
Dialogue: 0,0:05:26.73,0:05:28.12,ZWDB,,0000,0000,0000,,Нагадан шығу қақпасы аяқталды
Dialogue: 0,0:05:28.57,0:05:30.58,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:05:30.68,0:05:33.81,ZWDB,,0000,0000,0000,,Заң әлі келген жоқ.
Dialogue: 0,0:05:34.66,0:05:37.04,ZWDB,,0000,0000,0000,,Мен мұнда біраз уақыт болдым
Dialogue: 0,0:05:37.91,0:05:42.56,ZWDB,,0000,0000,0000,,Шекара сызығының шекарасында, мен қайда қараймын, қайда қараймын, қайда қараймын, қайда қараймын,
Dialogue: 0,0:05:43.48,0:05:45.84,ZWDB,,0000,0000,0000,,Бұл шындық.
Dialogue: 0,0:05:57.82,0:05:59.04,ZWDB,,0000,0000,0000,,Қашып кетуге тіпті ойлама. Осы жолы мен сенің басыңды шағып тастаймын
Dialogue: 0,0:06:01.23,0:06:03.71,ZWDB,,0000,0000,0000,,Еденнің астыңғы қабатының асты
Dialogue: 0,0:06:04.46,0:06:07.12,ZWDB,,0000,0000,0000,,Мен орта және орта мектепте оқығандықтан гимнастиканы таңдадым.
Dialogue: 0,0:06:07.74,0:06:09.20,ZWDB,,0000,0000,0000,,Мен табысқа жеттім және менің денем икемді және икемді, бірақ маған ұнайды.
Dialogue: 0,0:06:09.75,0:06:10.89,ZWDB,,0000,0000,0000,,Бұл мен үшін қызықты кітап
Dialogue: 0,0:06:18.33,0:06:19.67,ZWDB,,0000,0000,0000,,Қуаныштың бастапқы түрінің шығу тегі
Dialogue: 0,0:06:22.70,0:06:23.54,ZWDB,,0000,0000,0000,,Келесі кездескенше.
Dialogue: 0,0:06:23.97,0:06:25.31,ZWDB,,0000,0000,0000,,Қорғауды қамтамасыз ету қажет емес.
Dialogue: 0,0:06:25.73,0:06:28.32,ZWDB,,0000,0000,0000,,Жағдайлар жинақталған
Dialogue: 0,0:06:30.65,0:06:34.68,ZWDB,,0000,0000,0000,,Zena Ie Маған бұл туралы айтуға рұқсат жоқ, бірақ бұл туралы айтуға рұқсат жоқ.
Dialogue: 0,0:06:35.00,0:06:39.28,ZWDB,,0000,0000,0000,,Дегенмен, ағымдағы мәзір де қолжетімді және түнгі тағам негізгі болып табылады.
Dialogue: 0,0:06:40.02,0:06:40.69,ZWDB,,0000,0000,0000,,Нааньяжу?
Dialogue: 0,0:06:42.51,0:06:43.85,ZWDB,,0000,0000,0000,,Нәтижесінде, бұл ескі отбасы мүшелерінің дүниеге келуіне байланысты
Dialogue: 0,0:06:44.20,0:06:46.21,ZWDB,,0000,0000,0000,,Мен де оны бағалаймын.
Dialogue: 0,0:06:47.31,0:06:48.32,ZWDB,,0000,0000,0000,,Сіз кітапты оқыдыңыз ба?
Dialogue: 0,0:06:49.24,0:06:49.74,ZWDB,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:06:51.46,0:06:52.03,ZWDB,,0000,0000,0000,,Бұл баратын жер
Dialogue: 0,0:06:57.00,0:06:58.44,ZWDB,,0000,0000,0000,,Кенеттен ол жұмысын тоқтатты
Dialogue: 0,0:06:58.81,0:07:01.82,ZWDB,,0000,0000,0000,,Сіз өлдіңіз, демек сіздің өміріңізде бір нүкте бар.
Dialogue: 0,0:07:02.22,0:07:04.90,ZWDB,,0000,0000,0000,,Мин Мин алты гүлдің алғашқы туылуы.
Dialogue: 0,0:07:05.18,0:07:06.82,ZWDB,,0000,0000,0000,,Суретті оқу міндетті емес.
Dialogue: 0,0:07:07.64,0:07:10.17,ZWDB,,0000,0000,0000,,Мен жұмыстан шыға алмадым.
Dialogue: 0,0:07:16.48,0:07:17.83,ZWDB,,0000,0000,0000,,Осы саладағы нақты проблемалар
Dialogue: 0,0:07:19.52,0:07:21.73,ZWDB,,0000,0000,0000,,Жұмысты тоқтатқандағы апамның бейнесі осындай.
Dialogue: 0,0:07:22.32,0:07:23.94,ZWDB,,0000,0000,0000,,Кемел ниет
Dialogue: 0,0:07:24.26,0:07:24.91,ZWDB,,0000,0000,0000,,Нағыз күш
Dialogue: 0,0:07:26.45,0:07:28.64,ZWDB,,0000,0000,0000,,Менің айтқаным мен көргенім
Dialogue: 0,0:07:37.56,0:07:38.26,ZWDB,,0000,0000,0000,,Қазірге дейін
Dialogue: 0,0:07:38.75,0:07:42.71,ZWDB,,0000,0000,0000,,Бұл ескі жер орналасқан жер.
Dialogue: 0,0:07:45.79,0:07:46.41,ZWDB,,0000,0000,0000,,Сізге кекештену керек
Dialogue: 0,0:07:50.46,0:07:54.36,ZWDB,,0000,0000,0000,,Мен өзім оқуым керек...
Dialogue: 0,0:08:00.15,0:08:02.51,ZWDB,,0000,0000,0000,,Ұйықтауға болатын барлық орындар
Dialogue: 0,0:08:02.89,0:08:03.78,ZWDB,,0000,0000,0000,,Шираниду
Dialogue: 0,0:08:04.28,0:08:05.79,ZWDB,,0000,0000,0000,,Кездесулердің әртүрлі түрлері бар.
Dialogue: 0,0:08:11.46,0:08:13.28,ZWDB,,0000,0000,0000,,Хоука Хоука
Dialogue: 0,0:08:15.56,0:08:16.71,ZWDB,,0000,0000,0000,,Корокухана
Dialogue: 0,0:08:16.85,0:08:19.46,ZWDB,,0000,0000,0000,,Сәтсіздіктен кейін бұл кеңістікті құрудың нәтижесі.
Dialogue: 0,0:08:20.63,0:08:21.33,ZWDB,,0000,0000,0000,,Әңгімелесу?
Dialogue: 0,0:08:22.30,0:08:25.08,ZWDB,,0000,0000,0000,,Мен тек аспанда ұйықтағым келеді.
Dialogue: 0,0:08:25.65,0:08:31.72,ZWDB,,0000,0000,0000,,Бүкіл қала ғарыштық шатасудан туындаған ерекше ауытқулардан туындаған.
Dialogue: 0,0:08:32.71,0:08:38.10,ZWDB,,0000,0000,0000,,Ютаның астанама келгеніне еш күмән жоқ.
Dialogue: 0,0:08:40.17,0:08:41.58,ZWDB,,0000,0000,0000,,Тогаши Дугаку және басқалар...
Dialogue: 0,0:08:42.21,0:08:47.82,ZWDB,,0000,0000,0000,,Жаман музыканың ерекше тұсы – ол жергілікті жерді басқаруды бақылай алмайды.
Dialogue: 0,0:08:48.47,0:08:52.89,ZWDB,,0000,0000,0000,,Юта өзінің белгілі бір санатқа жататынын растайды.
Dialogue: 0,0:08:53.44,0:08:55.93,ZWDB,,0000,0000,0000,,Тағы бір жақсы адамның бейнесі де өліп, өзгерді.
Dialogue: 0,0:08:56.32,0:08:58.83,ZWDB,,0000,0000,0000,,Қарапайым адамдарда заң деген мүлдем жоқ.
Dialogue: 0,0:08:59.40,0:09:03.08,ZWDB,,0000,0000,0000,,Дегенмен, зұлым патшаның шынайы көздері туып, бүлік шығарғаны расталды.
Dialogue: 0,0:09:05.22,0:09:06.04,ZWDB,,0000,0000,0000,,Өлім оқиғасы
Dialogue: 0,0:09:06.44,0:09:10.61,ZWDB,,0000,0000,0000,,Қазіргі уақытта оқуға қарсылық жағдайы ағзаға үлкен әсер етеді.
Dialogue: 0,0:09:11.09,0:09:15.49,ZWDB,,0000,0000,0000,,Ikki Хошо Иккидің қалалық сезімді қан бейнесі негізінен бүкіл дененің ағып жатқан тесіктері болып табылады.
Dialogue: 0,0:09:15.71,0:09:16.43,ZWDB,,0000,0000,0000,,Аты?
Dialogue: 0,0:09:17.05,0:09:21.15,ZWDB,,0000,0000,0000,,Бұл Ютаға жақындау үшін ерекше жағдай.
Dialogue: 0,0:09:21.80,0:09:23.41,ZWDB,,0000,0000,0000,,Осыған байланысты мен басқаларға деген құрметімді жоғалттым.
Dialogue: 0,0:09:23.94,0:09:24.38,ZWDB,,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:09:25.92,0:09:28.31,ZWDB,,0000,0000,0000,,Алайда қазір Ютаның көздеріне қауіп төніп тұр.
Dialogue: 0,0:09:28.68,0:09:31.02,ZWDB,,0000,0000,0000,,Бір көзге қарап, екіншісіне қараңыз, сонда жердің шығысы мен батысы жақсы бейнеленген.
Dialogue: 0,0:09:31.89,0:09:33.53,ZWDB,,0000,0000,0000,,Мен өз денемнің дәл қасындамын
Dialogue: 0,0:09:34.18,0:09:37.56,ZWDB,,0000,0000,0000,,Бүкіл қала ерекше әртүрлі нүкте әсер етеді.
Dialogue: 0,0:09:38.13,0:09:39.94,ZWDB,,0000,0000,0000,,Дегенмен, жақсы дағды болуы шарт.
Dialogue: 0,0:09:40.39,0:09:46.75,ZWDB,,0000,0000,0000,,Бастапқыда мен өз еркімді жоюға ерекше құштарлықпен туғанмын.
Dialogue: 0,0:09:47.80,0:09:50.55,ZWDB,,0000,0000,0000,,Енді мен оны көргенімде, мен әрекет етпедім.
Dialogue: 0,0:09:51.03,0:09:54.03,ZWDB,,0000,0000,0000,,Әскери күш қолдану қажет екені анық.
Dialogue: 0,0:09:54.90,0:09:57.09,ZWDB,,0000,0000,0000,,Оқиғаны растау.
Dialogue: 0,0:09:57.64,0:09:59.68,ZWDB,,0000,0000,0000,,Дөңес қорғаушы – қожайынның қызметшісі
Dialogue: 0,0:09:59.90,0:10:01.57,ZWDB,,0000,0000,0000,,``Рагнарок'' — танылмаған тұлғаның құдайдың ымырттығы.
Dialogue: 0,0:10:01.69,0:10:03.28,ZWDB,,0000,0000,0000,,Қаланың қожайыны қаланы бірінші болып жаулап алады.
Dialogue: 0,0:10:04.32,0:10:05.67,ZWDB,,0000,0000,0000,,Мен үшін алаңдамаңыз
Dialogue: 0,0:10:05.82,0:10:08.47,ZWDB,,0000,0000,0000,,Бұл келісім-шарттың иесі үшін кері миссия.
Dialogue: 0,0:10:08.47,0:10:11.81,ZWDB,,0000,0000,0000,,Шағын дөңес оқыту жолы Бұл мәселе
Dialogue: 0,0:10:13.22,0:10:16.68,ZWDB,,0000,0000,0000,,Бұл сізге бару керек жер.
Dialogue: 0,0:10:16.83,0:10:20.33,ZWDB,,0000,0000,0000,,Осыдан кейін мен ауылға барып, ауылға бардым.
Dialogue: 0,0:10:21.13,0:10:25.60,ZWDB,,0000,0000,0000,,Ойланбай қолданылған сиқыр
Dialogue: 0,0:10:26.22,0:10:26.97,ZWDB,,0000,0000,0000,,Кездейсоқ мінез-құлық
Dialogue: 0,0:10:27.41,0:10:29.73,ZWDB,,0000,0000,0000,,Түнгі екінші ай
Dialogue: 0,0:10:30.27,0:10:31.51,ZWDB,,0000,0000,0000,,Тағдыр
Dialogue: 0,0:10:31.69,0:10:32.83,ZWDB,,0000,0000,0000,,Кішкентай дөңес
Dialogue: 0,0:10:33.28,0:10:33.60,ZWDB,,0000,0000,0000,,Кел, кел, кел!
Dialogue: 0,0:10:34.25,0:10:36.61,ZWDB,,0000,0000,0000,,Мен әңгіменің екі бөлігін де түсінемін, бірақ түсіну мүмкін емес.
Dialogue: 0,0:10:36.76,0:10:38.50,ZWDB,,0000,0000,0000,,Шынайы жойылу заңы
Dialogue: 0,0:10:38.80,0:10:41.36,ZWDB,,0000,0000,0000,,Кішкентай дөңес, оң және теріс әсер
Dialogue: 0,0:10:42.57,0:10:45.73,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:10:46.58,0:10:48.47,ZWDB,,0000,0000,0000,,Өйткені бұл кеш айдың түні
Dialogue: 0,0:10:50.88,0:10:51.77,ZWDB,,0000,0000,0000,,Жақсы дрифтинг рио
Dialogue: 0,0:10:52.19,0:10:54.70,ZWDB,,0000,0000,0000,,Қажетсіз өзгерістер жиі кездеседі.
Dialogue: 0,0:10:58.01,0:11:01.76,ZWDB,,0000,0000,0000,,Алдын ала ақпарат анық және нақты.
Dialogue: 0,0:11:02.13,0:11:03.45,ZWDB,,0000,0000,0000,,Гачидо тәрізді
Dialogue: 0,0:11:04.99,0:11:07.03,ZWDB,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:11:07.93,0:11:11.21,ZWDB,,0000,0000,0000,,Біздің презентация мазмұны қалаған коммерциялық көлемге негізделген.
Dialogue: 0,0:11:12.03,0:11:13.10,ZWDB,,0000,0000,0000,,Исшики Догакуку
Dialogue: 0,0:11:13.57,0:11:15.93,ZWDB,,0000,0000,0000,,Біздің компанияның орналасқан жерін растаңыз.
Dialogue: 0,0:11:16.53,0:11:17.57,ZWDB,,0000,0000,0000,,Youdu және т.б.
Dialogue: 0,0:11:25.99,0:11:28.01,ZWDB,,0000,0000,0000,,Зайнори Рикка
Dialogue: 0,0:11:33.05,0:11:34.49,ZWDB,,0000,0000,0000,,Қаланы айналып өту үшін бірдеңе істей аламын ба?
Dialogue: 0,0:11:36.16,0:11:36.76,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:11:37.23,0:11:37.60,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:11:39.76,0:11:40.29,ZWDB,,0000,0000,0000,,Кешір
Dialogue: 0,0:11:41.06,0:11:43.99,ZWDB,,0000,0000,0000,,Оқығыңыз келетін нақты уақытты таңдаңыз.
Dialogue: 0,0:11:45.95,0:11:47.02,ZWDB,,0000,0000,0000,,Мен сені жеңгім келеді.
Dialogue: 0,0:11:47.49,0:11:47.74,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:11:50.33,0:11:52.86,ZWDB,,0000,0000,0000,,Арнайы нүктелерді бекіту
Dialogue: 0,0:11:53.51,0:11:54.63,ZWDB,,0000,0000,0000,,Дәл осы дәлелдер бар болғандықтан
Dialogue: 0,0:11:55.00,0:12:00.22,ZWDB,,0000,0000,0000,,Ютаның қолы мен аяғы қазір Ақпаратты басқару бюросында.
Dialogue: 0,0:12:00.57,0:12:02.22,ZWDB,,0000,0000,0000,,Нені білуім керек
Dialogue: 0,0:12:02.22,0:12:02.65,ZWDB,,0000,0000,0000,,Мастер
Dialogue: 0,0:12:03.92,0:12:06.71,ZWDB,,0000,0000,0000,,Жарылғыш бөліктің шындығы
Dialogue: 0,0:12:07.18,0:12:09.69,ZWDB,,0000,0000,0000,,Жалпы дүниеден қуылған
Dialogue: 0,0:12:17.12,0:12:17.42,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:12:17.72,0:12:20.30,ZWDB,,0000,0000,0000,,Шебер жұмысқа шақырылып қойған.
Dialogue: 0,0:12:20.40,0:12:21.02,ZWDB,,0000,0000,0000,,Декомори
Dialogue: 0,0:12:21.27,0:12:21.92,ZWDB,,0000,0000,0000,,Мастер
Dialogue: 0,0:12:24.58,0:12:26.76,ZWDB,,0000,0000,0000,,Не істерімді білмеймін, бірақ оны кім бітіре алады?
Dialogue: 0,0:12:27.09,0:12:27.93,ZWDB,,0000,0000,0000,,Мен Риккамын
Dialogue: 0,0:12:28.20,0:12:29.31,ZWDB,,0000,0000,0000,,Мен дөңес қорғаушымын.
Dialogue: 0,0:12:29.47,0:12:30.49,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:12:30.49,0:12:31.88,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:12:37.80,0:12:38.49,ZWDB,,0000,0000,0000,,Бұл жақсы идея емес.
Dialogue: 0,0:12:39.89,0:12:42.22,ZWDB,,0000,0000,0000,,Бұл әннің шындығы ғана
Dialogue: 0,0:12:42.79,0:12:44.73,ZWDB,,0000,0000,0000,,Ауыстыру және құтқару
Dialogue: 0,0:12:45.78,0:12:47.32,ZWDB,,0000,0000,0000,,Касурё Козо Корена
Dialogue: 0,0:12:48.93,0:12:54.10,ZWDB,,0000,0000,0000,,Шындық, мен бұл туралы ешқашан ойламадым.
Dialogue: 0,0:12:56.07,0:12:56.36,ZWDB,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:13:06.68,0:13:07.35,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:13:08.37,0:13:10.46,ZWDB,,0000,0000,0000,,Na аффирмациясы - махаббат махаббаты
Dialogue: 0,0:13:11.03,0:13:11.77,ZWDB,,0000,0000,0000,,Махаббат
Dialogue: 0,0:13:12.32,0:13:12.62,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:13:36.48,0:13:39.01,ZWDB,,0000,0000,0000,,Тоғашы студенттің туған күні құтты болсын
Dialogue: 0,0:13:49.35,0:13:54.97,ZWDB,,0000,0000,0000,,Қорқаудың қажеті жоқ.
Dialogue: 0,0:13:55.67,0:13:58.90,ZWDB,,0000,0000,0000,,Нәтижесінде, қазіргі мектеп ауданы кеше түнде мектепке келді.
Dialogue: 0,0:14:00.26,0:14:01.93,ZWDB,,0000,0000,0000,,Гайяның толқуы келді.
Dialogue: 0,0:14:02.33,0:14:04.76,ZWDB,,0000,0000,0000,,Жағдайды шешудің уақыты келді.
Dialogue: 0,0:14:05.09,0:14:07.03,ZWDB,,0000,0000,0000,,Сіз елдегі жалғыз адамсыз.
Dialogue: 0,0:14:07.22,0:14:09.54,ZWDB,,0000,0000,0000,,Мен сізбен сөйлескім келеді. Бұл орта мектеп және орта мектеп фестивалі.
Dialogue: 0,0:14:09.96,0:14:12.89,ZWDB,,0000,0000,0000,,Мен қалыпты уақытта өз өміріммен не істерімді білмеймін.
Dialogue: 0,0:14:12.99,0:14:15.50,ZWDB,,0000,0000,0000,,Лақап аты «Махаббат хаосы» банкеті
Dialogue: 0,0:14:16.05,0:14:18.38,ZWDB,,0000,0000,0000,,Мектеп мерекесінің соңында мектеп түні фестивалінің соңында
Dialogue: 0,0:14:18.73,0:14:19.48,ZWDB,,0000,0000,0000,,Түстен кейінгі фестиваль?
Dialogue: 0,0:14:19.87,0:14:25.17,ZWDB,,0000,0000,0000,,Мәйім Майым
Dialogue: 0,0:14:25.17,0:14:26.71,ZWDB,,0000,0000,0000,,Чидо Рио Чидо Рио
Dialogue: 0,0:14:30.04,0:14:33.20,ZWDB,,0000,0000,0000,,Өз ойыңызды толығымен көру
Dialogue: 0,0:14:41.95,0:14:42.67,ZWDB,,0000,0000,0000,,Дугаку Которю
Dialogue: 0,0:14:43.86,0:14:44.67,ZWDB,,0000,0000,0000,,Нибутани
Dialogue: 0,0:14:45.50,0:14:47.02,ZWDB,,0000,0000,0000,,Сізбен шағын әңгімем бар.
Dialogue: 0,0:14:48.78,0:14:49.90,ZWDB,,0000,0000,0000,,Зеканю Тогаши Догаку
Dialogue: 0,0:14:56.56,0:14:57.60,ZWDB,,0000,0000,0000,,Кайжуит
Dialogue: 0,0:14:57.98,0:14:58.52,ZWDB,,0000,0000,0000,,Сүйіспеншілік пе?
Dialogue: 0,0:14:58.52,0:15:03.59,ZWDB,,0000,0000,0000,,Сіз Тоғашымен бірдей студентсіз.
Dialogue: 0,0:15:06.33,0:15:07.15,ZWDB,,0000,0000,0000,,Шынымен сәттілік
Dialogue: 0,0:15:15.45,0:15:17.81,ZWDB,,0000,0000,0000,,Кішкентай құспен оқудан кейінгі өліміңіз туралы әңгіме
Dialogue: 0,0:15:18.53,0:15:20.00,ZWDB,,0000,0000,0000,,Зұлым патшаның шынайы көздері ең күшті
Dialogue: 0,0:15:20.49,0:15:23.55,ZWDB,,0000,0000,0000,,Соңында ең жоғары сапалы келісімшарт жасалды.
Dialogue: 0,0:15:24.52,0:15:27.38,ZWDB,,0000,0000,0000,,«Ғашықтар» үшін әртүрлі ресми келісім-шарттар
Dialogue: 0,0:15:27.53,0:15:30.68,ZWDB,,0000,0000,0000,,Қатоғаши сол мектепте оқып жүргенде бірінші болып мектепке тіке секірді.
Dialogue: 0,0:15:31.53,0:15:35.75,ZWDB,,0000,0000,0000,,Үйге оралғаннан кейін өлдіңіз бе? «Екі адамнан бастау» санаты
Dialogue: 0,0:15:36.08,0:15:37.64,ZWDB,,0000,0000,0000,,Біреу сүйіп тұр.
Dialogue: 0,0:15:40.15,0:15:45.82,ZWDB,,0000,0000,0000,,Әйтсе де, шын көзі бар зұлым патшаның күші... Алайда олай емес...
Dialogue: 0,0:15:46.91,0:15:50.44,ZWDB,,0000,0000,0000,,2 курстың ортасында шынайы махаббат хикаясы араласып, нәтижесі мүлде басқаша болады.
Dialogue: 0,0:15:53.75,0:15:55.34,ZWDB,,0000,0000,0000,,Керіскерлер тобы
Dialogue: 0,0:15:55.76,0:15:56.88,ZWDB,,0000,0000,0000,,«Шварц қалқаны»
Dialogue: 0,0:15:58.62,0:16:00.58,ZWDB,,0000,0000,0000,,Бұл жұмыс істемейтін психикалық шабуыл капиталы.
Dialogue: 0,0:16:02.97,0:16:10.13,ZWDB,,0000,0000,0000,,Рикка, мен, мен, мен, мен, мен, мен, мен, сіздің келген уақытыңыз, мен сізді көріп тұрмын және мен сымнан тура секіремін.
Dialogue: 0,0:16:11.49,0:16:12.17,ZWDB,,0000,0000,0000,,Көңілді
Dialogue: 0,0:16:13.01,0:16:15.02,ZWDB,,0000,0000,0000,,Ешқандай құтылу немесе шешім жоқ.
Dialogue: 0,0:16:19.17,0:16:24.27,ZWDB,,0000,0000,0000,,Егер сіз басқалармен кездеспесеңіз, орындауыңызды ратификациялауға болады ма?
Dialogue: 0,0:16:24.57,0:16:25.54,ZWDB,,0000,0000,0000,,Шынайы оқиға
Dialogue: 0,0:16:26.01,0:16:26.88,ZWDB,,0000,0000,0000,,Тек қате…
Dialogue: 0,0:16:26.88,0:16:30.88,ZWDB,,0000,0000,0000,,Мен сізге барлық бос жұмысыңызға көмектесу үшін келдім.
Dialogue: 0,0:16:31.35,0:16:32.50,ZWDB,,0000,0000,0000,,Шын мән
Dialogue: 0,0:16:32.97,0:16:33.49,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:34.73,0:16:37.22,ZWDB,,0000,0000,0000,,Ойлану екі адамның өтіп бара жатқаны сияқты
Dialogue: 0,0:16:38.04,0:16:38.44,ZWDB,,0000,0000,0000,,Растау
Dialogue: 0,0:16:39.08,0:16:41.52,ZWDB,,0000,0000,0000,,Нана Исшики Догакува Хока Гакуджи...
Dialogue: 0,0:16:41.52,0:16:41.89,ZWDB,,0000,0000,0000,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:16:41.89,0:16:44.35,ZWDB,,0000,0000,0000,,Жарық қорғайтын перде астындағы жарықтан қорғайтын перде саны
Dialogue: 0,0:16:44.65,0:16:45.50,ZWDB,,0000,0000,0000,,Түсінемін
Dialogue: 0,0:16:45.84,0:16:50.39,ZWDB,,0000,0000,0000,,Бұдан кейін Тогаши Догакува бастауыш мектебі мен Кішкентай құс Дугаку ойнайды.
Dialogue: 0,0:16:50.66,0:16:52.45,ZWDB,,0000,0000,0000,,Келесі жолы сіз пәрменге келесіз
Dialogue: 0,0:16:52.90,0:16:54.74,ZWDB,,0000,0000,0000,,Бір нәрсе дұрыс емес.
Dialogue: 0,0:16:54.91,0:16:55.49,ZWDB,,0000,0000,0000,,Түсінемін
Dialogue: 0,0:16:55.71,0:17:00.93,ZWDB,,0000,0000,0000,,Ұстаз? шебер!
Dialogue: 0,0:17:00.93,0:17:02.72,ZWDB,,0000,0000,0000,,Сіз біздің компанияның мүшесі емессіз.
Dialogue: 0,0:17:02.72,0:17:04.41,ZWDB,,0000,0000,0000,,Хобога Какобога
Dialogue: 0,0:17:09.90,0:17:11.54,ZWDB,,0000,0000,0000,,Осында келгенімді қаласаңыз, бұл кішкентай нәрсе.
Dialogue: 0,0:17:12.06,0:17:14.65,ZWDB,,0000,0000,0000,,Екі адамның бірге ән айтуына қолайлы уақыт.
Dialogue: 0,0:17:15.54,0:17:17.63,ZWDB,,0000,0000,0000,,«Сіз оны бағалай аласыз».
Dialogue: 0,0:17:20.96,0:17:22.75,ZWDB,,0000,0000,0000,,Ю…Юу…Юта
Dialogue: 0,0:17:26.63,0:17:31.90,ZWDB,,0000,0000,0000,,Менің... Юта менің зұлым патшамның шынайы көздеріне ие болды.
Dialogue: 0,0:17:35.05,0:17:39.25,ZWDB,,0000,0000,0000,,Зұлым патшаның шын көзі менмін.
Dialogue: 0,0:17:39.60,0:17:41.77,ZWDB,,0000,0000,0000,,Бұл да зұлым патшаның шын көзі...
Dialogue: 0,0:17:41.96,0:17:43.28,ZWDB,,0000,0000,0000,,Сіз жеті сегіз жылдық әңгімеде осындасыз.
Dialogue: 0,0:17:43.65,0:17:46.11,ZWDB,,0000,0000,0000,,Кішкентай қолдануға арналған Кана хайкусы
Dialogue: 0,0:17:46.34,0:17:47.56,ZWDB,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:17:48.58,0:17:51.09,ZWDB,,0000,0000,0000,,Исшики және т.б.
Dialogue: 0,0:17:51.66,0:17:52.60,ZWDB,,0000,0000,0000,,Басқалар…
Dialogue: 0,0:17:52.60,0:17:57.77,ZWDB,,0000,0000,0000,,Кетейін, кетейін, кетейін
Dialogue: 0,0:17:54.29,0:17:58.67,ZWDB,,0000,0000,0000,,Басқа музыка бөлімінің алдыңғы бөлігі... оны тыңдау үшін қажет.
Dialogue: 0,0:17:58.99,0:18:00.41,ZWDB,,0000,0000,0000,,Жерді қадағалап отыруға барынша тырысыңыз
Dialogue: 0,0:18:01.05,0:18:03.66,ZWDB,,0000,0000,0000,,Сіз менің астанамды ұмытып, орта мектепте оқисыз.
Dialogue: 0,0:18:04.18,0:18:07.46,ZWDB,,0000,0000,0000,,Бұл жазбаша қолдануға болмайтын сөз тіркесі.
Dialogue: 0,0:18:08.73,0:18:10.22,ZWDB,,0000,0000,0000,,Коуджау Шинган Кишо
Dialogue: 0,0:18:10.79,0:18:12.06,ZWDB,,0000,0000,0000,,Кездесу үшін қажет емес.
Dialogue: 0,0:18:12.96,0:18:16.54,ZWDB,,0000,0000,0000,,Орныңнан кеткенде, өзіңе қамқор боласың.
Dialogue: 0,0:18:18.75,0:18:21.61,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:18:23.64,0:18:25.68,ZWDB,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:18:26.01,0:18:30.63,ZWDB,,0000,0000,0000,,Мен ұзақ уақыттың ортасында болғанымнан бері ұзақ уақыт болды.
Dialogue: 0,0:18:30.88,0:18:31.47,ZWDB,,0000,0000,0000,,Сіз білгіңіз келеді
Dialogue: 0,0:18:31.85,0:18:35.33,ZWDB,,0000,0000,0000,,Адам кенеттен оянғанда, содан кейін адамды көргенде
Dialogue: 0,0:18:38.53,0:18:39.28,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:18:39.60,0:18:41.81,ZWDB,,0000,0000,0000,,Жақсы ауру... сен құрғақсың.
Dialogue: 0,0:18:42.28,0:18:44.17,ZWDB,,0000,0000,0000,,Юта, сен жүз рет бұзылдың
Dialogue: 0,0:18:49.96,0:18:51.23,ZWDB,,0000,0000,0000,,Бейнеленген биіктік
Dialogue: 0,0:18:51.65,0:18:58.54,ZWDB,,0000,0000,0000,,Пердені құшақтап, талантты келесі кездесуге әкел.
Dialogue: 0,0:18:59.11,0:19:02.24,ZWDB,,0000,0000,0000,,Дегенмен, бұл «көпірді ілудің» ең тиімді әдісі.
Dialogue: 0,0:19:02.94,0:19:05.80,ZWDB,,0000,0000,0000,,Аздап таң қалу сезімі бар жерде болу сезімі. Екі адамның жалғыз жазған әңгімесі.
Dialogue: 0,0:19:05.97,0:19:07.51,ZWDB,,0000,0000,0000,,Тікелей хабаршының өзімшілдік сезімі
Dialogue: 0,0:19:07.51,0:19:10.25,ZWDB,,0000,0000,0000,,Табиғат әлемін екі адамның түсінуі және түсінуі
Dialogue: 0,0:19:10.84,0:19:13.40,ZWDB,,0000,0000,0000,,Түсінгеніңізге рахмет.
Dialogue: 0,0:19:24.41,0:19:25.21,ZWDB,,0000,0000,0000,,Қалқымалы адам
Dialogue: 0,0:19:30.08,0:19:32.64,ZWDB,,0000,0000,0000,,Сіз туралы біртүрлі нәрсе
Dialogue: 0,0:19:35.22,0:19:40.17,ZWDB,,0000,0000,0000,,Осыған байланысты мен әкем мен әкеме не болғанын білмеймін.
Dialogue: 0,0:19:42.28,0:19:48.05,ZWDB,,0000,0000,0000,,Дегенмен, мен бұл мәселені жақсы түсінемін.
Dialogue: 0,0:19:49.96,0:19:53.64,ZWDB,,0000,0000,0000,,Сөздеріңіздің шекарасын көре алмайсыз.
Dialogue: 0,0:19:53.91,0:19:57.07,ZWDB,,0000,0000,0000,,Менен бұрын сен болмашы адамсың.
Dialogue: 0,0:20:02.17,0:20:04.88,ZWDB,,0000,0000,0000,,Өйткені аспанның құдіретін көру мүмкін емес
Dialogue: 0,0:20:05.72,0:20:07.48,ZWDB,,0000,0000,0000,,Аспанның қызыл-қызыл және қызыл түсінің ретімен өзгеретін керемет көрінісі.
Dialogue: 0,0:20:09.13,0:20:11.78,ZWDB,,0000,0000,0000,,Отты шарға ұқсайтын күн жоғалғаннан кейін қараңғылықтың бір бөлігі пайда болады
Dialogue: 0,0:20:12.26,0:20:13.95,ZWDB,,0000,0000,0000,,Толық ойлар мен әсерлер
Dialogue: 0,0:20:15.64,0:20:19.14,ZWDB,,0000,0000,0000,,Мен сипаттауға келмейтін шекара сызығын ғана көре аламын.
Dialogue: 0,0:20:22.25,0:20:22.94,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:20:30.60,0:20:31.42,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:20:31.84,0:20:32.46,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:20:43.60,0:20:44.14,ZWDB,,0000,0000,0000,,Бұл елдің контрбарлау қызметін талқандау оңай емес.
Dialogue: 0,0:20:46.23,0:20:49.96,ZWDB,,0000,0000,0000,,Үш мұнарадағы жағдайды айтуға болады.
Dialogue: 0,0:20:52.30,0:20:52.84,ZWDB,,0000,0000,0000,,Тога
Dialogue: 0,0:21:00.50,0:21:03.11,ZWDB,,0000,0000,0000,,Оқыңыз Оны оқыңыз
Dialogue: 0,0:21:10.74,0:21:12.08,ZWDB,,0000,0000,0000,,Жабу аяқталды.
Dialogue: 0,0:21:16.41,0:21:21.18,ZWDB,,0000,0000,0000,,Chuchurai Chuchurai Kaimatsu ашылуы
Dialogue: 0,0:21:33.85,0:21:38.20,ZWDB,,0000,0000,0000,,Юта Юта Юта...
Dialogue: 0,0:21:47.47,0:21:48.07,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:21:48.62,0:21:50.68,ZWDB,,0000,0000,0000,,Мен...
Dialogue: 0,0:22:11.18,0:22:11.73,ZWDB,,0000,0000,0000,,Рикка
