Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0000,0000,0000,,
Dialogue: 0,0:00:05.00,0:00:07.00,ZWZJ2,,0000,0000,0000,,

Dialogue: 0,0:00:04.82,0:00:06.06,JPDB,,0000,0000,0000,,Ыстық, солай емес пе?
Dialogue: 0,0:00:06.88,0:00:07.33,JPDB,,0000,0000,0000,,О
Dialogue: 0,0:00:08.10,0:00:09.12,JPDB,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:00:15.03,0:00:17.02,JPDB,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:00:17.24,0:00:21.59,JPDB,,0000,0000,0000,,Не қарап тұрсыз? Бірақ сіз жиі осындай киіммен келесіз.
Dialogue: 0,0:00:21.94,0:00:23.51,JPDB,,0000,0000,0000,,Showa пұттары?
Dialogue: 0,0:00:24.70,0:00:29.62,JPDB,,0000,0000,0000,,Баркер: Күмін сенпай сендей емес, заманның ықпалына түспеген адал адам.
Dialogue: 0,0:00:30.64,0:00:32.70,JPDB,,0000,0000,0000,,Бастауыш сынып оқушылары не дейді?
Dialogue: 0,0:00:34.99,0:00:36.28,JPDB,,0000,0000,0000,,Бастауыш сынып оқушыларына айтпа
Dialogue: 0,0:00:37.13,0:00:39.59,JPDB,,0000,0000,0000,,Исшики-кун, сен бастауыш сынып оқушысы сияқтысың.
Dialogue: 0,0:00:42.89,0:00:46.42,JPDB,,0000,0000,0000,,Күшті күн сәулесі мен гамма сәулелері Декомориге шабуыл жасайды
Dialogue: 0,0:00:47.57,0:00:52.98,JPDB,,0000,0000,0000,,"Dark Limited Shield" орнатылған
Dialogue: 0,0:00:53.51,0:00:56.76,JPDB,,0000,0000,0000,,Бұл енді кіші мектеп оқушысының ауруы емес, бастауыш сынып оқушысының ауруы...
Dialogue: 0,0:00:57.38,0:00:59.22,JPDB,,0000,0000,0000,,Жалған мырза, бірдеңе айттыңыз ба?
Dialogue: 0,0:00:59.77,0:01:01.46,JPDB,,0000,0000,0000,,Жоқ...Мен ештеңе айтқан жоқпын.
Dialogue: 0,0:01:01.46,0:01:06.28,JPDB,,0000,0000,0000,,Бұл шынымен Өлім бе? Ол басы қырылған жігітпен араласып кеткендей болды.
Dialogue: 0,0:01:06.46,0:01:07.55,JPDB,,0000,0000,0000,,Монах деген кім?
Dialogue: 0,0:01:07.55,0:01:09.02,JPDB,,0000,0000,0000,,Бастауыш сынып оқушылары үнсіз
Dialogue: 0,0:01:10.26,0:01:15.63,JPDB,,0000,0000,0000,,Риккамен бірге келгеніңді қалаймын. Сен маған керексің.
Dialogue: 0,0:01:15.80,0:01:17.63,JPDB,,0000,0000,0000,,Battle Death Fake-sama
Dialogue: 0,0:01:17.63,0:01:20.42,JPDB,,0000,0000,0000,,Не, егер сен мұны істеуге дайын болсаң, мен де істеймін.
Dialogue: 0,0:01:20.42,0:01:21.37,JPDB,,0000,0000,0000,,Мен сені елемеймін бе?
Dialogue: 0,0:01:21.37,0:01:22.91,JPDB,,0000,0000,0000,,Екеуіңізге де сәттілік
Dialogue: 0,0:01:17.69,0:01:21.69,JPDB,,0000,0000,0000,,Жаз келді Жазғы демалыс келді
Dialogue: 0,0:03:05.01,0:03:06.45,JPDB,,0000,0000,0000,,Сіз кенеттен қозғалыс ауруын сезінесіз бе?
Dialogue: 0,0:03:06.80,0:03:09.04,JPDB,,0000,0000,0000,,Сондықтан сіз бастауыш сынып оқушысымын дейсіз.
Dialogue: 0,0:03:09.66,0:03:10.78,JPDB,,0000,0000,0000,,Ух...шулы...
Dialogue: 0,0:03:12.99,0:03:15.25,JPDB,,0000,0000,0000,,Алысқа қара, алыста жасыл
Dialogue: 0,0:03:15.82,0:03:21.21,JPDB,,0000,0000,0000,,Шулы өлім Бұл мен «Мабиногион» сөзін көрген сәт.
Dialogue: 0,0:03:21.21,0:03:24.12,JPDB,,0000,0000,0000,,Өлім «Жүрек...» құбыжығын қуып шығарады.
Dialogue: 0,0:03:26.01,0:03:26.91,JPDB,,0000,0000,0000,,Бұл кері нәтиже береді.
Dialogue: 0,0:03:27.53,0:03:30.04,JPDB,,0000,0000,0000,,Нибутани дәретханасы Бұл жерде, мен сұраймын.
Dialogue: 0,0:03:30.31,0:03:32.04,JPDB,,0000,0000,0000,,Неге мен?
Dialogue: 0,0:03:32.45,0:03:35.28,JPDB,,0000,0000,0000,,Менімен ер адам кірсе, біртүрлі болар еді.
Dialogue: 0,0:03:36.43,0:03:39.98,JPDB,,0000,0000,0000,,Мен жалған көмекке сенбеймін
Dialogue: 0,0:03:42.49,0:03:44.11,JPDB,,0000,0000,0000,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:03:44.25,0:03:45.87,JPDB,,0000,0000,0000,,Маған тиіспе...
Dialogue: 0,0:03:47.24,0:03:49.10,JPDB,,0000,0000,0000,,Бұл аз ғана уақыт, сондықтан шыдамды болыңыз.
Dialogue: 0,0:03:49.90,0:03:54.52,JPDB,,0000,0000,0000,,Өлім алдында тұрғанда дұшпаннан құтқарылу – салқын өлім.
Dialogue: 0,0:03:54.64,0:03:58.15,JPDB,,0000,0000,0000,,Исшики сөйлемейді, сізге де аздап көмек керек.
Dialogue: 0,0:03:58.92,0:03:59.51,JPDB,,0000,0000,0000,,Исшики?
Dialogue: 0,0:04:04.46,0:04:06.13,JPDB,,0000,0000,0000,,Ах Куроко
Dialogue: 0,0:04:11.00,0:04:13.68,JPDB,,0000,0000,0000,,Мен сенің қайда қарап тұрғаныңды көріп тұрмын, жүр.
Dialogue: 0,0:04:13.95,0:04:14.78,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:04:15.15,0:04:16.59,JPDB,,0000,0000,0000,,Бұл сәл көбірек
Dialogue: 0,0:04:25.16,0:04:27.92,JPDB,,0000,0000,0000,,Сәлем Рикка
Dialogue: 0,0:04:31.87,0:04:32.35,JPDB,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:35.95,0:04:40.62,JPDB,,0000,0000,0000,,Реакция алыңыз. Мүмкін сізде де қозғалыс ауруы бар шығар?
Dialogue: 0,0:04:41.59,0:04:43.83,JPDB,,0000,0000,0000,,Менде бәрі жақсы, мен дайындықтан өттім.
Dialogue: 0,0:04:44.62,0:04:45.83,JPDB,,0000,0000,0000,,Онда неге үндемейсің?
Dialogue: 0,0:04:49.77,0:04:51.16,JPDB,,0000,0000,0000,,Мен уайымдап тұрмын.
Dialogue: 0,0:04:52.26,0:04:53.30,JPDB,,0000,0000,0000,,Сіз ояндыңыз ба?
Dialogue: 0,0:04:54.74,0:04:57.03,JPDB,,0000,0000,0000,,Бірдеңе болды, Рикка-чан
Dialogue: 0,0:04:57.30,0:04:59.03,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:05:07.52,0:05:11.89,JPDB,,0000,0000,0000,,Әлем «Мжолнир торнадосын» айналдыратын өлім
Dialogue: 0,0:05:11.89,0:05:13.60,JPDB,,0000,0000,0000,,Сіз маған үндемеңіз деп жатырсыз.
Dialogue: 0,0:05:13.98,0:05:17.48,JPDB,,0000,0000,0000,,Неліктен мен зиян шегуім керек?
Dialogue: 0,0:05:17.48,0:05:20.81,JPDB,,0000,0000,0000,,Сынып өкілі күткендей, сіз шынымен қамқорсыз.
Dialogue: 0,0:05:21.11,0:05:23.10,JPDB,,0000,0000,0000,,Сіз оны көргіңіз келмейтін шығар.
Dialogue: 0,0:05:23.84,0:05:26.50,JPDB,,0000,0000,0000,,Бәлкім, сіз оны алдыңыз және оны кері қайтардыңыз.
Dialogue: 0,0:05:30.21,0:05:32.54,JPDB,,0000,0000,0000,,Одан да жақсы, балам.
Dialogue: 0,0:05:32.82,0:05:33.09,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:34.11,0:05:36.37,JPDB,,0000,0000,0000,,Которию-сан мені шақырды, солай ма?
Dialogue: 0,0:05:36.74,0:05:39.55,JPDB,,0000,0000,0000,,Мен үйге бара жатырмын, сондықтан қонаққа келгіңіз келе ме деп сұрадым.
Dialogue: 0,0:05:40.37,0:05:43.31,JPDB,,0000,0000,0000,,Сен мені өзіңе еруге мәжбүрледің.
Dialogue: 0,0:05:43.50,0:05:45.69,JPDB,,0000,0000,0000,,Мүмкін мұнда бірдеңе бар шығар?
Dialogue: 0,0:05:46.31,0:05:47.11,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:05:47.53,0:05:49.05,JPDB,,0000,0000,0000,,Қараңызшы, бұл жиі болады.
Dialogue: 0,0:05:49.22,0:05:54.37,JPDB,,0000,0000,0000,,Жігітім екеуміз әртүрлі орта мектептерде орта мектепте оқыдық, және біз алыс қашықтықтағы қарым-қатынаста болдық.
Dialogue: 0,0:05:55.21,0:05:55.93,JPDB,,0000,0000,0000,,Бұл пандемия ма?
Dialogue: 0,0:05:56.28,0:05:59.59,JPDB,,0000,0000,0000,,Шураба - күшті тосқауыл сиқыры Өлім
Dialogue: 0,0:05:59.59,0:06:01.20,JPDB,,0000,0000,0000,,Аузыңды жабу керек.
Dialogue: 0,0:06:02.27,0:06:04.01,JPDB,,0000,0000,0000,,Сүйіспеншілік…?
Dialogue: 0,0:06:07.69,0:06:10.72,JPDB,,0000,0000,0000,,Мен зұлым патша Шинганға ант етемін
Dialogue: 0,0:06:12.01,0:06:12.68,JPDB,,0000,0000,0000,,Кеше болған жайтқа әлі де алаңдайсың ба?
Dialogue: 0,0:06:13.38,0:06:14.30,JPDB,,0000,0000,0000,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:06:16.46,0:06:17.18,JPDB,,0000,0000,0000,,Бұл адам кім?
Dialogue: 0,0:06:18.28,0:06:20.41,JPDB,,0000,0000,0000,,Тока-сан Рикканың үлкен әпкесі
Dialogue: 0,0:06:23.97,0:06:24.61,JPDB,,0000,0000,0000,,Маған орнатылған тыңшылық құрылғыдан басқа, осы бөлмеде ештеңе жоқ
Dialogue: 0,0:06:35.80,0:06:37.49,JPDB,,0000,0000,0000,,Бұл үлкен үй.
Dialogue: 0,0:06:39.40,0:06:41.81,JPDB,,0000,0000,0000,,Которию-сан бай ма?
Dialogue: 0,0:06:43.23,0:06:45.69,JPDB,,0000,0000,0000,,Мен алыс жерлерге жиі бардым.
Dialogue: 0,0:06:46.04,0:06:50.76,JPDB,,0000,0000,0000,,Жоқ, мен әрқашан Котори-санға қарыздармын.
Dialogue: 0,0:06:50.76,0:06:54.84,JPDB,,0000,0000,0000,,Мұндай шақыруды қабылдау сізді қатты мазалады ма?
Dialogue: 0,0:06:55.31,0:07:01.17,JPDB,,0000,0000,0000,,Жоқ. Рикка әлі қарақшыларды ойнап жүр ме? Өйткені ол танымал
Dialogue: 0,0:07:02.66,0:07:04.85,JPDB,,0000,0000,0000,,Мен жағдай біршама жақсарды деп ойладым.
Dialogue: 0,0:07:05.30,0:07:05.85,JPDB,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:07:06.34,0:07:10.67,JPDB,,0000,0000,0000,,Әже, барлығына арналған қара қоңыр сұйықтық
Dialogue: 0,0:07:11.69,0:07:12.13,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:07:12.38,0:07:15.24,JPDB,,0000,0000,0000,,Эй, эй Рикка
Dialogue: 0,0:07:16.63,0:07:20.66,JPDB,,0000,0000,0000,,Бұл қызықсыз, бірақ көмегіңіз үшін рахмет.
Dialogue: 0,0:07:20.91,0:07:24.44,JPDB,,0000,0000,0000,,Ой, кешіріңіз, уайымдамаңыз.
Dialogue: 0,0:07:24.93,0:07:26.65,JPDB,,0000,0000,0000,,Сабыр етіңіз.
Dialogue: 0,0:07:27.15,0:07:28.66,JPDB,,0000,0000,0000,,Рахмет
Dialogue: 0,0:07:29.36,0:07:32.64,JPDB,,0000,0000,0000,,Сіз кемпірге ұқсайсыз.
Dialogue: 0,0:07:32.84,0:07:33.38,JPDB,,0000,0000,0000,,Шулы
Dialogue: 0,0:07:40.17,0:07:41.74,JPDB,,0000,0000,0000,,Содан кейін кезекте тұрғандарды жақсылап ұрып, ақшаларын тартып алады
Dialogue: 0,0:07:40.94,0:07:42.48,JPDB,,0000,0000,0000,,Үлкен ит
Dialogue: 0,0:07:42.85,0:07:45.29,JPDB,,0000,0000,0000,,Бұл... бұл аңызға айналған жын жыртқыш Өлім бе?
Dialogue: 0,0:07:45.61,0:07:47.78,JPDB,,0000,0000,0000,,Nice Death Жеңіс өлім
Dialogue: 0,0:07:47.78,0:07:48.20,JPDB,,0000,0000,0000,,No
Dialogue: 0,0:07:56.10,0:07:56.57,JPDB,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:08:03.04,0:08:05.17,JPDB,,0000,0000,0000,,Меніңше, бізде мұнда көп жүк жоқ.
Dialogue: 0,0:08:10.32,0:08:10.86,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:08:12.90,0:08:15.39,JPDB,,0000,0000,0000,,Көрінбейтін шекараның екінші жағымен байланысыңыз
Dialogue: 0,0:08:16.31,0:08:19.71,JPDB,,0000,0000,0000,,Оны қайдан таптың? Дәл солай.
Dialogue: 0,0:08:20.36,0:08:24.83,JPDB,,0000,0000,0000,,Мен оны бір жыл бұрын тапқан қазіргі базама тасымалдау туралы ойладым.
Dialogue: 0,0:08:25.26,0:08:26.83,JPDB,,0000,0000,0000,,Діни әйел қабылдамады
Dialogue: 0,0:08:27.29,0:08:28.06,JPDB,,0000,0000,0000,,Келесі, мына жігіт
Dialogue: 0,0:08:31.37,0:08:32.09,JPDB,,0000,0000,0000,,Не болды?
Dialogue: 0,0:08:33.66,0:08:34.30,JPDB,,0000,0000,0000,,Не
Dialogue: 0,0:08:36.37,0:08:39.47,JPDB,,0000,0000,0000,,Иә, егер сіз солай айтсаңыз.
Dialogue: 0,0:08:41.16,0:08:44.79,JPDB,,0000,0000,0000,,Мен бұл аймақта бар екенін сезіп тұрған сияқтымын, бірақ бұл не?
Dialogue: 0,0:08:47.08,0:08:49.86,JPDB,,0000,0000,0000,,Бұл бірінші кезекте менің базам емес.
Dialogue: 0,0:08:50.21,0:08:52.97,JPDB,,0000,0000,0000,,Керісінше, Әкімшілік бюросының штаб-пәтері орналасқан жау базасы
Dialogue: 0,0:08:53.69,0:08:56.82,JPDB,,0000,0000,0000,,Екі жыл бұрын мені осында әкелді.
Dialogue: 0,0:08:57.71,0:08:58.39,JPDB,,0000,0000,0000,,Екі жыл бұрын?
Dialogue: 0,0:08:59.26,0:09:01.02,JPDB,,0000,0000,0000,,Қарапайым болып көрінетін сарай
Dialogue: 0,0:09:01.47,0:09:06.66,JPDB,,0000,0000,0000,,Дегенмен, бұл жерде көрінбейтін шекара сызығының болуын жоққа шығаратын тосқауыл бар.
Dialogue: 0,0:09:07.36,0:09:11.68,JPDB,,0000,0000,0000,,Психикалық шабуыл мен жүктеме артты, сондықтан мен қашып кеттім
Dialogue: 0,0:09:12.80,0:09:15.71,JPDB,,0000,0000,0000,,Мен сенімді емеспін, бірақ бірдеңе болды.
Dialogue: 0,0:09:17.05,0:09:23.02,JPDB,,0000,0000,0000,,Джаоу Шинганның күші бұл кедергіні бұзу үшін қажет болды.
Dialogue: 0,0:09:25.78,0:09:26.37,JPDB,,0000,0000,0000,,Ирука
Dialogue: 0,0:09:29.73,0:09:30.17,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:09:31.57,0:09:33.06,JPDB,,0000,0000,0000,,Биыл барамын ба деп ойлаймын.
Dialogue: 0,0:09:39.22,0:09:41.04,JPDB,,0000,0000,0000,,Жүктеріңізді осында қалдырыңыз.
Dialogue: 0,0:09:42.60,0:09:45.73,JPDB,,0000,0000,0000,,Ал сенің досың жағаға барады.
Dialogue: 0,0:09:46.78,0:09:49.49,JPDB,,0000,0000,0000,,Достарыңыз туралы көп уайымдамаңыз
Dialogue: 0,0:09:54.71,0:09:57.27,JPDB,,0000,0000,0000,,Морисама-чан, күткендей, бөлінеді
Dialogue: 0,0:09:57.69,0:10:01.61,JPDB,,0000,0000,0000,,Бұл не туралы? Сіздің купальникіңіз ақ па?
Dialogue: 0,0:10:02.19,0:10:05.94,JPDB,,0000,0000,0000,,Жоқ, бұл менде жалғыз... Менің ойымша, бұл маған сәйкес келеді...
Dialogue: 0,0:10:05.94,0:10:07.65,JPDB,,0000,0000,0000,,Керемет
Dialogue: 0,0:10:07.65,0:10:08.50,JPDB,,0000,0000,0000,,Рахмет
Dialogue: 0,0:10:15.01,0:10:16.78,JPDB,,0000,0000,0000,,Тітіркендіргіш
Dialogue: 0,0:10:18.62,0:10:22.22,JPDB,,0000,0000,0000,,О, жоқ, менің көзімде теңіз суы бар.
Dialogue: 0,0:10:27.26,0:10:30.22,JPDB,,0000,0000,0000,,Кракен құбыжық осы теңізде жасырынып жүр.
Dialogue: 0,0:10:30.47,0:10:34.35,JPDB,,0000,0000,0000,,Қазір бұл су астындағы жауынгерлік костюмнің күшін сынайтын уақыт.
Dialogue: 0,0:10:34.62,0:10:36.51,JPDB,,0000,0000,0000,,Маған қара, Өлім
Dialogue: 0,0:10:39.34,0:10:44.51,JPDB,,0000,0000,0000,,Егер сіз сол сиқырлы костюмді кисеңіз, сіз тіпті теңіз астында да әдеттегіден 3,88 есе жылдам қозғала аласыз.
Dialogue: 0,0:10:44.74,0:10:46.25,JPDB,,0000,0000,0000,,Ыстық, ыстық, ыстық...
Dialogue: 0,0:10:46.25,0:10:47.99,JPDB,,0000,0000,0000,,3,88 рет қозғала алады
Dialogue: 0,0:10:50.03,0:10:51.67,JPDB,,0000,0000,0000,,Жүр, кел, тез жүр.
Dialogue: 0,0:10:49.76,0:10:51.00,JPDB,,0000,0000,0000,,Ыстық, ыстық, ыстық...
Dialogue: 0,0:10:52.14,0:10:54.03,JPDB,,0000,0000,0000,,Өлім есімде
Dialogue: 0,0:10:54.93,0:10:55.87,JPDB,,0000,0000,0000,,Бұл, әрине, жылдам.
Dialogue: 0,0:10:57.21,0:11:01.02,JPDB,,0000,0000,0000,,Біз де жүзіп алайық Күмін-сенпай... Ұйықтап жатыр!
Dialogue: 0,0:11:01.46,0:11:04.30,JPDB,,0000,0000,0000,,Сен әрең сөйлейсің ғой.
Dialogue: 0,0:11:05.94,0:11:06.56,JPDB,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:08.65,0:11:10.24,JPDB,,0000,0000,0000,,Өлім Керперосқа барыңыз
Dialogue: 0,0:11:12.10,0:11:16.05,JPDB,,0000,0000,0000,,Күте тұрыңыз... неге оны тыңдайсыз?
Dialogue: 0,0:11:17.07,0:11:19.16,JPDB,,0000,0000,0000,,Есіңізде болсын.
Dialogue: 0,0:11:20.28,0:11:23.31,JPDB,,0000,0000,0000,,Эй, сен неге менің соңымнан жүрсің? Тоқта.
Dialogue: 0,0:11:19.56,0:11:20.08,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:11:24.75,0:11:25.87,JPDB,,0000,0000,0000,,Келісімді пайдаланбай-ақ мені одақтасың қыла аласың деп ойладың ғой?
Dialogue: 0,0:11:31.84,0:11:32.98,JPDB,,0000,0000,0000,,Бұл ешқандай мағынасы жоқ еді.
Dialogue: 0,0:11:37.10,0:11:39.37,JPDB,,0000,0000,0000,,Юта асығыңыз
Dialogue: 0,0:11:42.00,0:11:43.14,JPDB,,0000,0000,0000,,Ақыры қылмыскер автобустан секіріп түсіп, көлік астында қалыпты.
Dialogue: 0,0:11:43.79,0:11:45.58,JPDB,,0000,0000,0000,,Радзвейхерблау
Dialogue: 0,0:11:46.08,0:11:47.34,JPDB,,0000,0000,0000,,Маған ат маңызды емес
Dialogue: 0,0:11:48.36,0:11:51.99,JPDB,,0000,0000,0000,,Біз көзге көрінбейтін шекара сызығының жинақтау нүктесіне қарай бет аламыз.
Dialogue: 0,0:11:52.86,0:11:53.96,JPDB,,0000,0000,0000,,Бұл киімде ме?
Dialogue: 0,0:11:54.88,0:11:59.47,JPDB,,0000,0000,0000,,Камуфляждың бұл деңгейі діни қызметкердің бақылауынан құтылу үшін қажет.
Dialogue: 0,0:12:04.32,0:12:05.17,JPDB,,0000,0000,0000,,Ақыр соңында?
Dialogue: 0,0:12:08.74,0:12:10.56,JPDB,,0000,0000,0000,,Келісімді пайдаланбай-ақ мені одақтасың қыла аласың деп ойладың ғой?
Dialogue: 0,0:12:11.75,0:12:14.93,JPDB,,0000,0000,0000,,Ақыр соңында осылай болады ма? Юта Тогаши
Dialogue: 0,0:12:15.78,0:12:16.23,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:12:16.90,0:12:17.44,JPDB,,0000,0000,0000,,Бірге болыңыз
Dialogue: 0,0:12:18.36,0:12:19.06,JPDB,,0000,0000,0000,,Дайынсың ба? Алтыға бес қанша?
Dialogue: 0,0:12:21.00,0:12:24.10,JPDB,,0000,0000,0000,,Ол... әкесінің орнында.
Dialogue: 0,0:12:25.62,0:12:25.87,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:37.72,0:12:42.17,JPDB,,0000,0000,0000,,Бүкіл денесі ауыратын өлім Қасиетті нұрға ұшыраған өлім
Dialogue: 0,0:12:42.97,0:12:46.03,JPDB,,0000,0000,0000,,Мен тіпті жылуды қолданбай-ақ осылай көңілді жүрмін.
Dialogue: 0,0:12:47.14,0:12:50.90,JPDB,,0000,0000,0000,,Бірақ мөр мінсіз болды
Dialogue: 0,0:12:51.54,0:12:53.06,JPDB,,0000,0000,0000,,Уау, суық
Dialogue: 0,0:12:53.53,0:12:56.36,JPDB,,0000,0000,0000,,Иә, мұны әркім жеуі керек.
Dialogue: 0,0:12:58.85,0:12:59.67,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:12:59.84,0:13:00.94,JPDB,,0000,0000,0000,,Бұл тамаша болар еді
Dialogue: 0,0:13:04.02,0:13:04.96,JPDB,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:13:17.47,0:13:18.71,JPDB,,0000,0000,0000,,Небәрі үш жыл
Dialogue: 0,0:13:22.16,0:13:27.31,JPDB,,0000,0000,0000,,Ол кішкентай болғандықтан, әкесі Риккаға айтпауды өтінді.
Dialogue: 0,0:13:28.72,0:13:32.85,JPDB,,0000,0000,0000,,Сондықтан Рикка үшін әкесінің өлімі кенеттен болды.
Dialogue: 0,0:13:33.47,0:13:34.89,JPDB,,0000,0000,0000,,Ешбір ескертусіз
Dialogue: 0,0:13:36.13,0:13:39.86,JPDB,,0000,0000,0000,,Мүмкін сондықтан да ол әлі күнге дейін әкесінің өлімін мойындаудан бас тартады.
Dialogue: 0,0:13:41.38,0:13:43.29,JPDB,,0000,0000,0000,,Мұнда келуден қыңырлықпен бас тартты
Dialogue: 0,0:13:43.44,0:13:44.83,JPDB,,0000,0000,0000,,Мама тез
Dialogue: 0,0:13:45.38,0:13:46.27,JPDB,,0000,0000,0000,,(Тодороки) Оған өз қалауынша сол күшті босатуға жол беру қауіпті
Dialogue: 0,0:13:47.49,0:13:50.72,JPDB,,0000,0000,0000,,Ол мені және Рикканы әкемнің ата-анасының үйіне қалдырып, кетіп қалды.
Dialogue: 0,0:13:53.31,0:13:58.40,JPDB,,0000,0000,0000,,Атамның мінезі байсалды, ол Рикканы бұлай қабылдай алмайды.
Dialogue: 0,0:14:00.19,0:14:06.38,JPDB,,0000,0000,0000,,Мен де жұмыс үшін осы жерден кетуге тура келді, екі жылдан кейін де солай.
Dialogue: 0,0:14:14.68,0:14:19.05,JPDB,,0000,0000,0000,,Мен көрінбейтін шекараны табуым керек
Dialogue: 0,0:14:20.00,0:14:25.27,JPDB,,0000,0000,0000,,Джаоу Шинганның күші бұл кедергіні бұзу үшін қажет болды.
Dialogue: 0,0:14:34.39,0:14:35.83,JPDB,,0000,0000,0000,,Бұл… (Бакуго) Э?
Dialogue: 0,0:14:37.84,0:14:40.50,JPDB,,0000,0000,0000,,Осының бәрін Тоқа-сан жасады ма?
Dialogue: 0,0:14:40.95,0:14:42.47,JPDB,,0000,0000,0000,,Ақыр аяғында бұл жұмыс.
Dialogue: 0,0:14:42.84,0:14:47.19,JPDB,,0000,0000,0000,,Дұрыс, Которию-санның бентосы әрқашан сәнді болды.
Dialogue: 0,0:14:47.51,0:14:50.42,JPDB,,0000,0000,0000,,Аа, сыныпта өсек болды.
Dialogue: 0,0:14:50.77,0:14:55.34,JPDB,,0000,0000,0000,,Бірақ мен Рикка-чанды сол мейрамханада жұмыс істегені үшін қызғанамын.
Dialogue: 0,0:14:56.58,0:14:57.35,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:14:57.98,0:15:00.54,JPDB,,0000,0000,0000,,Тез тамақтанып алайық. Итадакимасу
Dialogue: 0,0:15:00.83,0:15:02.54,JPDB,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:15:05.61,0:15:07.25,JPDB,,0000,0000,0000,,Бұл өлім сырмен бе?
Dialogue: 0,0:15:07.52,0:15:09.58,JPDB,,0000,0000,0000,,Деко-чан, ірімшік те жақсы емес.
Dialogue: 0,0:15:09.93,0:15:13.83,JPDB,,0000,0000,0000,,Шіріген шүберек сияқты иісі бар нәрсені кім жейді?
Dialogue: 0,0:15:14.31,0:15:18.53,JPDB,,0000,0000,0000,,Бастапқыда сүт – өлім. Кеудесі шірігендер – өлім. Ең жаман өлім – өлім.
Dialogue: 0,0:15:18.53,0:15:18.95,JPDB,,0000,0000,0000,,Тамақ іш
Dialogue: 0,0:15:21.66,0:15:22.23,JPDB,,0000,0000,0000,,Тамақ іш
Dialogue: 0,0:15:23.10,0:15:24.47,JPDB,,0000,0000,0000,,Чи Чи Чи…
Dialogue: 0,0:15:24.84,0:15:25.56,JPDB,,0000,0000,0000,,Тамақ іш
Dialogue: 0,0:15:26.36,0:15:26.86,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:15:28.07,0:15:29.59,JPDB,,0000,0000,0000,,Бұл керемет, Деко-чан
Dialogue: 0,0:15:30.09,0:15:32.62,JPDB,,0000,0000,0000,,Күткендей, Ұстаз діни әйелден қорқады.
Dialogue: 0,0:15:32.75,0:15:34.46,JPDB,,0000,0000,0000,,Өлімнің керемет көру қабілеті бар
Dialogue: 0,0:15:35.95,0:15:38.19,JPDB,,0000,0000,0000,,Бұған қарағанда, Рикка-чан
Dialogue: 0,0:15:39.86,0:15:40.80,JPDB,,0000,0000,0000,,Мен қарап көрейін.
Dialogue: 0,0:15:43.41,0:15:44.35,JPDB,,0000,0000,0000,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:15:44.63,0:15:47.98,JPDB,,0000,0000,0000,,Жоқ, жақсы
Dialogue: 0,0:15:51.84,0:15:52.36,JPDB,,0000,0000,0000,,Ирука
Dialogue: 0,0:16:00.36,0:16:01.28,JPDB,,0000,0000,0000,,Құпия сөз
Dialogue: 0,0:16:02.85,0:16:04.56,JPDB,,0000,0000,0000,,Джау Шинген ең күшті
Dialogue: 0,0:16:07.47,0:16:08.04,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:16:08.04,0:16:09.06,JPDB,,0000,0000,0000,,Бұл дұрыс емес пе?
Dialogue: 0,0:16:09.58,0:16:12.66,JPDB,,0000,0000,0000,,Шамасы, оған діни қызметкердің ақыл-ойы шабуыл жасады.
Dialogue: 0,0:16:13.26,0:16:14.90,JPDB,,0000,0000,0000,,Юта Юта емес
Dialogue: 0,0:16:15.99,0:16:17.53,JPDB,,0000,0000,0000,,Сіз солай ойладыңыз ба?
Dialogue: 0,0:16:18.63,0:16:21.86,JPDB,,0000,0000,0000,,Уайымдамаңыз, бұл бұрынғы қараңғы жалын шебері.
Dialogue: 0,0:16:24.32,0:16:27.67,JPDB,,0000,0000,0000,,Жарайды ма? Маған көрінбейтін шекара сызығын іздеудің қажеті жоқ.
Dialogue: 0,0:16:41.62,0:16:42.29,JPDB,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:16:46.76,0:16:47.78,JPDB,,0000,0000,0000,,Өтірік айтсам не істеуім керек?
Dialogue: 0,0:16:48.30,0:16:52.65,JPDB,,0000,0000,0000,,Өйткені... анам, әпкем, атам және әжем...
Dialogue: 0,0:16:53.85,0:16:55.09,JPDB,,0000,0000,0000,,Демек, бұл мен болуым керек.
Dialogue: 0,0:16:56.23,0:17:01.43,JPDB,,0000,0000,0000,,Юута... Үлкен әпке... Діни әйел міндетті түрде күзетте.
Dialogue: 0,0:17:01.87,0:17:03.51,JPDB,,0000,0000,0000,,Шығу оңай емес.
Dialogue: 0,0:17:04.11,0:17:05.20,JPDB,,0000,0000,0000,,Олай болса, мен тоқтауым керек пе?
Dialogue: 0,0:17:08.36,0:17:08.83,JPDB,,0000,0000,0000,,Қашан барасың?
Dialogue: 0,0:17:10.90,0:17:12.06,JPDB,,0000,0000,0000,,Қазір!
Dialogue: 0,0:17:13.16,0:17:13.63,JPDB,,0000,0000,0000,,Енді?
Dialogue: 0,0:17:14.30,0:17:15.42,JPDB,,0000,0000,0000,,Иә, қазір
Dialogue: 0,0:17:21.66,0:17:25.01,JPDB,,0000,0000,0000,,Сол ағашқа көшкенде, ағаштың артына тығылуы үшін оң жаққа түс.
Dialogue: 0,0:17:25.76,0:17:26.90,JPDB,,0000,0000,0000,,Менің аяқ киімім жоқ.
Dialogue: 0,0:17:27.40,0:17:29.01,JPDB,,0000,0000,0000,,Бұл жақсы, өйткені менде бар.
Dialogue: 0,0:17:29.44,0:17:29.93,JPDB,,0000,0000,0000,,Эй
Dialogue: 0,0:17:33.17,0:17:34.01,JPDB,,0000,0000,0000,,Қандай дыбыс
Dialogue: 0,0:17:34.31,0:17:35.08,JPDB,,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:17:37.69,0:17:38.53,JPDB,,0000,0000,0000,,Кесе?
Dialogue: 0,0:17:39.01,0:17:39.60,JPDB,,0000,0000,0000,,…Өлім
Dialogue: 0,0:17:40.27,0:17:41.09,JPDB,,0000,0000,0000,,Бұл қажет болды ма?
Dialogue: 0,0:17:42.31,0:17:43.26,JPDB,,0000,0000,0000,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:17:43.43,0:17:44.62,JPDB,,0000,0000,0000,,Тоқа-сан күткендей
Dialogue: 0,0:17:53.52,0:17:57.62,JPDB,,0000,0000,0000,,Мен сенен маған қол ұшын береріңді күтпедім. Мұнымен не айтқың келеді?
Dialogue: 0,0:17:58.12,0:18:00.11,JPDB,,0000,0000,0000,,Мен мұны өзім де түсінбеймін.
Dialogue: 0,0:18:00.28,0:18:02.15,JPDB,,0000,0000,0000,,Әй, бұл қазір өте жақсы.
Dialogue: 0,0:18:02.52,0:18:03.71,JPDB,,0000,0000,0000,,Жарайды, үндеме.
Dialogue: 0,0:18:04.36,0:18:08.06,JPDB,,0000,0000,0000,,Өйткені, сен қауіптісің.
Dialogue: 0,0:18:08.78,0:18:09.30,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:18:20.86,0:18:27.05,JPDB,,0000,0000,0000,,Рокка, кел, кел, Рокка, ұш.
Dialogue: 0,0:18:41.61,0:18:42.51,JPDB,,0000,0000,0000,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:18:42.86,0:18:47.21,JPDB,,0000,0000,0000,,Жарайды. Мен сені Радзвейхерблаудың жасырынған жеріне апарамын.
Dialogue: 0,0:18:47.73,0:18:49.02,JPDB,,0000,0000,0000,,Қосымша заттар
Dialogue: 0,0:18:53.27,0:18:54.36,JPDB,,0000,0000,0000,,Мен қаншалықты алыс жүруім керек?
Dialogue: 0,0:18:54.86,0:18:56.13,JPDB,,0000,0000,0000,,Шамамен 10 шақырым қалды
Dialogue: 0,0:18:56.38,0:18:58.14,JPDB,,0000,0000,0000,,О, соншалықты алыс па?
Dialogue: 0,0:18:58.66,0:19:02.76,JPDB,,0000,0000,0000,,Уайымдамаңыз, Dark Flame Master - ең күшті.
Dialogue: 0,0:19:03.31,0:19:04.01,JPDB,,0000,0000,0000,,Ең күшті?
Dialogue: 0,0:19:04.41,0:19:09.48,JPDB,,0000,0000,0000,,Иә, бұл ең күшті болды. Қараңғы жалын шебері ең күшті болды.
Dialogue: 0,0:19:10.49,0:19:12.33,JPDB,,0000,0000,0000,,Айтпаңдар деп айтқаным сондықтан болар.
Dialogue: 0,0:19:13.90,0:19:14.79,JPDB,,0000,0000,0000,,Мен тездетемін.
Dialogue: 0,0:19:15.96,0:19:18.07,JPDB,,0000,0000,0000,,Бірақ нағыз мықтысы - Джау Шинган
Dialogue: 0,0:19:18.70,0:19:19.37,JPDB,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:19:22.15,0:19:26.35,JPDB,,0000,0000,0000,,Ақырында Рикка-чан мен Тогаши-кун қайтып келмеді.
Dialogue: 0,0:19:26.90,0:19:28.86,JPDB,,0000,0000,0000,,Тоқа-сан да бір жаққа кеткен.
Dialogue: 0,0:19:29.33,0:19:32.66,JPDB,,0000,0000,0000,,Бір-екі кедергі болмай қоймайды.
Dialogue: 0,0:19:32.91,0:19:34.35,JPDB,,0000,0000,0000,,Бұл қандай мүгедектік?
Dialogue: 0,0:19:35.62,0:19:37.61,JPDB,,0000,0000,0000,,Эй, бұл Деко-чан.
Dialogue: 0,0:19:38.55,0:19:41.51,JPDB,,0000,0000,0000,,Бірақ бұл тек уақыт мәселесі деп ойлаймын
Dialogue: 0,0:19:41.81,0:19:42.71,JPDB,,0000,0000,0000,,Не
Dialogue: 0,0:19:42.90,0:19:44.00,JPDB,,0000,0000,0000,,Өлім дегеніміз не?
Dialogue: 0,0:19:44.12,0:19:45.02,JPDB,,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:19:47.33,0:19:49.02,JPDB,,0000,0000,0000,,Кумин Сенпай
Dialogue: 0,0:19:50.58,0:19:52.50,JPDB,,0000,0000,0000,,Сіз оны көрдіңіз бе? үш жыл бұрын
Dialogue: 0,0:19:54.96,0:20:00.00,JPDB,,0000,0000,0000,,Иә, мен әкемді жоғалып кеткен түні көрдім.
Dialogue: 0,0:20:03.16,0:20:08.73,JPDB,,0000,0000,0000,,Мен әкемді шекарадан тыс жерде көрдім
Dialogue: 0,0:20:15.26,0:20:20.98,JPDB,,0000,0000,0000,,Мен оны көрдім...Сондықтан мен әлі де осындамын
Dialogue: 0,0:20:22.00,0:20:26.77,JPDB,,0000,0000,0000,,Шекараның ар жағынан маған қарап
Dialogue: 0,0:20:27.96,0:20:31.97,JPDB,,0000,0000,0000,,Мен бұған келісе алмадым немесе жоққа шығара алмадым.
Dialogue: 0,0:20:33.23,0:20:33.56,JPDB,,0000,0000,0000,,Тек...
Dialogue: 0,0:20:34.28,0:20:34.87,JPDB,,0000,0000,0000,,Тоқта
Dialogue: 0,0:20:38.01,0:20:38.68,JPDB,,0000,0000,0000,,Сіз келдіңіз бе?
Dialogue: 0,0:20:39.37,0:20:44.34,JPDB,,0000,0000,0000,,Иә, менің база әкеммен және басқалармен бірге болған жерім.
Dialogue: 0,0:21:25.35,0:21:32.59,JPDB,,0000,0000,0000,,Бұл шындық. Әкем кетті. Қазір.
Dialogue: 0,0:21:56.55,0:22:01.71,JPDB,,0000,0000,0000,,Жарылсын, шын, жарылсын, синапс
Dialogue: 0,0:22:07.01,0:22:10.86,JPDB,,0000,0000,0000,,Бұл дүниені қуу
Dialogue: 0,0:01:37.53,0:01:41.50,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:01:41.73,0:01:48.29,JPOP,,0000,0000,0000,karaoke,Маған таң қалдырмас бұрын не ойладыңыз?
Dialogue: 0,0:01:48.51,0:01:52.54,JPOP,,0000,0000,0000,karaoke,Маған қарашы еріндері
Dialogue: 0,0:01:52.76,0:01:58.08,JPOP,,0000,0000,0000,karaoke,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:01:58.43,0:02:03.78,JPOP,,0000,0000,0000,karaoke,Алаяқтықтан кейінгі монолог
Dialogue: 0,0:02:04.27,0:02:09.69,JPOP,,0000,0000,0000,karaoke,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:02:10.39,0:02:15.23,JPOP,,0000,0000,0000,karaoke,Сізді бір-біріңізге тартатын махаббат
Dialogue: 0,0:02:15.58,0:02:20.05,JPOP,,0000,0000,0000,karaoke,Ол әлдеқашан басталған болатын
Dialogue: 0,0:02:21.07,0:02:23.43,JPOP,,0000,0000,0000,karaoke,Менің көп арманым болды
Dialogue: 0,0:02:23.46,0:02:27.34,JPOP,,0000,0000,0000,karaoke,Оянсам да сені көргім келеді.
Dialogue: 0,0:02:27.34,0:02:29.55,JPOP,,0000,0000,0000,karaoke,Сіз мұны жасадыңыз
Dialogue: 0,0:02:29.55,0:02:31.96,JPOP,,0000,0000,0000,karaoke,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:02:31.96,0:02:37.53,JPOP,,0000,0000,0000,karaoke,Бізді секіртетін жүрекке ерейік
Dialogue: 0,0:02:37.53,0:02:40.14,JPOP,,0000,0000,0000,karaoke,Идеалдар, адасулар және шындық
Dialogue: 0,0:02:40.26,0:02:42.77,JPOP,,0000,0000,0000,karaoke,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:02:43.00,0:02:48.12,JPOP,,0000,0000,0000,karaoke,Жаңа әлемге
