Dialogue: 0,0:00:00.00,0:00:05.00,JPIN,,0000,0000,0000,,

Dialogue: 0,0:00:04.59,0:00:07.13,JPDB,,0000,0000,0000,,Мен бір қызды бірінші рет құшақтадым
Dialogue: 0,0:00:08.42,0:00:11.48,JPDB,,0000,0000,0000,,Жұмсақ жанасуда аздап қызу бар.
Dialogue: 0,0:00:12.87,0:00:15.65,JPDB,,0000,0000,0000,,Мен оған тым көп күш салсам, ол бұзылады деп қорықтым.
Dialogue: 0,0:00:16.20,0:00:19.65,JPDB,,0000,0000,0000,,Бұл жерде әлсіз және қайғылы нәрсе бар
Dialogue: 0,0:00:22.24,0:00:23.06,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:00:23.88,0:00:24.65,JPDB,,0000,0000,0000,,Рикка?
Dialogue: 0,0:00:26.94,0:00:29.15,JPDB,,0000,0000,0000,,Ұмыту, ұмыту, ұмыту...
Dialogue: 0,0:00:26.94,0:00:29.15,JPDB,,0000,0000,0000,,Ауырады, ауырады, ауырады...
Dialogue: 0,0:02:18.08,0:02:22.46,JPDB,,0000,0000,0000,,Барлық оқушылар 20:00-ге дейін мектептен шығуы керек. ең соңғы.
Dialogue: 0,0:02:23.48,0:02:29.05,JPDB,,0000,0000,0000,,Қайталап айтамын: Барлық оқушылар 20:00-ге дейін мектептен шығуы керек. ең соңғы.
Dialogue: 0,0:00:00.00,0:00:00.00,JPDB,,0000,0000,0000,,Біздің ханымның түскі ас қорабы (Пандора қорабы)
Dialogue: 0,0:02:27.58,0:02:28.25,JPDB,,0000,0000,0000,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:02:31.66,0:02:36.00,JPDB,,0000,0000,0000,,Осы қараңғылықпен бірге жын түні де жақындағаны рас па?
Dialogue: 0,0:02:37.84,0:02:38.54,JPDB,,0000,0000,0000,,Хе-хе. Ей, ойын ойнайық.
Dialogue: 0,0:02:48.71,0:02:50.99,JPDB,,0000,0000,0000,,Уақыт тоқтаған шығар?
Dialogue: 0,0:02:54.84,0:02:57.06,JPDB,,0000,0000,0000,,Бұл олай емес сияқты.
Dialogue: 0,0:03:05.63,0:03:06.23,JPDB,,0000,0000,0000,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:03:08.56,0:03:10.03,JPDB,,0000,0000,0000,,Мастер
Dialogue: 0,0:03:11.37,0:03:14.43,JPDB,,0000,0000,0000,,Бұл Мастер Декомори болса ше?
Dialogue: 0,0:03:19.65,0:03:22.88,JPDB,,0000,0000,0000,,Ұстаз, мұны істемеңіз. Декомори - қожайынның қызметшісі.
Dialogue: 0,0:03:23.13,0:03:26.06,JPDB,,0000,0000,0000,,Сізде мұндай сезім болмауы керек.
Dialogue: 0,0:03:26.73,0:03:28.75,JPDB,,0000,0000,0000,,Жоқ, бірақ әрине
Dialogue: 0,0:03:29.29,0:03:33.54,JPDB,,0000,0000,0000,,Тыйым көп болса, соғұрлым өршіп кететіні өмір шындығы.
Dialogue: 0,0:03:42.24,0:03:43.06,JPDB,,0000,0000,0000,,Хе-хе. Ей, ойын ойнайық.
Dialogue: 0,0:03:44.48,0:03:46.47,JPDB,,0000,0000,0000,,Мен Ютаны құшақтадым
Dialogue: 0,0:03:47.73,0:03:48.73,JPDB,,0000,0000,0000,,Маған Юта ұнайды
Dialogue: 0,0:03:49.40,0:03:50.54,JPDB,,0000,0000,0000,,Хе-хе. Ей, ойын ойнайық.
Dialogue: 0,0:03:52.06,0:03:54.20,JPDB,,0000,0000,0000,,Сәлем, сіз жалған шеберсіз.
Dialogue: 0,0:03:54.44,0:03:57.13,JPDB,,0000,0000,0000,,Морисамадан кейін шебердің жалғанына дейін
Dialogue: 0,0:03:58.79,0:03:59.51,JPDB,,0000,0000,0000,,Шынайы
Dialogue: 0,0:04:00.91,0:04:03.19,JPDB,,0000,0000,0000,,Бұл дегеніміз...
Dialogue: 0,0:04:04.49,0:04:10.75,JPDB,,0000,0000,0000,,Ұстаз қараңғы жалын шеберіне ғашық па?
Dialogue: 0,0:04:11.44,0:04:11.74,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:04:16.07,0:04:20.54,JPDB,,0000,0000,0000,,Мастер Декоморидің баратын жері бар, сондықтан ол кетеді.
Dialogue: 0,0:04:20.67,0:04:21.39,JPDB,,0000,0000,0000,,Декомори
Dialogue: 0,0:04:21.39,0:04:23.62,JPDB,,0000,0000,0000,,Қызметші ретінде өлімді тоқтатпаңыз
Dialogue: 0,0:04:23.77,0:04:27.77,JPDB,,0000,0000,0000,,Қожайынының жүрегін ұрлағандар үшін қараңғылық...
Dialogue: 0,0:04:28.54,0:04:29.44,JPDB,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:04:38.51,0:04:41.67,JPDB,,0000,0000,0000,,Шебер қараңғы жалын шебері болды.
Dialogue: 0,0:04:41.92,0:04:45.42,JPDB,,0000,0000,0000,,Өлім Джау Шингенді осы уақытқа дейін қорғай алғанын айтты.
Dialogue: 0,0:04:47.68,0:04:49.45,JPDB,,0000,0000,0000,,Мен де Dark Flame Master екеніне сенімдімін.
Dialogue: 0,0:04:49.79,0:04:52.65,JPDB,,0000,0000,0000,,Бұл күшті сезім Ажалға жеткізілсе керек.
Dialogue: 0,0:04:52.85,0:04:53.57,JPDB,,0000,0000,0000,,Менің ойымша, солай
Dialogue: 0,0:04:54.27,0:04:56.85,JPDB,,0000,0000,0000,,Мен қожайынға екі жылдан сәл астам уақыт қызмет етіп келемін.
Dialogue: 0,0:04:57.60,0:05:01.30,JPDB,,0000,0000,0000,,Қызметші Қожайынның бәрін көре алады.
Dialogue: 0,0:05:01.75,0:05:02.50,JPDB,,0000,0000,0000,,Декомори
Dialogue: 0,0:05:03.54,0:05:08.56,JPDB,,0000,0000,0000,,Уайымдаудың қажеті жоқ, бәрібір. Джау Шинган - ең күшті өлім.
Dialogue: 0,0:05:09.16,0:05:10.85,JPDB,,0000,0000,0000,,Барлығы міндетті түрде орындалады.
Dialogue: 0,0:05:12.29,0:05:12.59,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:05:17.38,0:05:19.00,JPDB,,0000,0000,0000,,Содан кейін, Которию-санмен ...
Dialogue: 0,0:05:19.57,0:05:21.61,JPDB,,0000,0000,0000,,А, мен не істеуім керек?
Dialogue: 0,0:05:22.06,0:05:22.70,JPDB,,0000,0000,0000,,Не
Dialogue: 0,0:05:23.55,0:05:26.63,JPDB,,0000,0000,0000,,Саған мойындауым керек пе?
Dialogue: 0,0:05:27.10,0:05:29.34,JPDB,,0000,0000,0000,,Сізге Которию-сан ұнайтын шығар.
Dialogue: 0,0:05:29.83,0:05:30.38,JPDB,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:05:31.97,0:05:34.21,JPDB,,0000,0000,0000,,Бірақ бұл оның стилі жақсы немесе сүйкімді болғандықтан емес.
Dialogue: 0,0:05:35.08,0:05:38.11,JPDB,,0000,0000,0000,,Ол chuunibyou және мен оған шынымен көмектесе алмаймын.
Dialogue: 0,0:05:38.51,0:05:40.62,JPDB,,0000,0000,0000,,​​Бірақ бұл тек орта мектеп ауруы емес.
Dialogue: 0,0:05:41.14,0:05:45.00,JPDB,,0000,0000,0000,,Мен бұл туралы алаңдадым, мен оны аядым және ...
Dialogue: 0,0:05:45.79,0:05:49.37,JPDB,,0000,0000,0000,,Аа, жоқ, бірақ мен аяу дегенім жоқ.
Dialogue: 0,0:05:49.37,0:05:54.07,JPDB,,0000,0000,0000,,Айтпа, айтпа, біреуге ғашық болудың себебі жоқ.
Dialogue: 0,0:05:55.01,0:05:55.86,JPDB,,0000,0000,0000,,Сіз айтасыз.
Dialogue: 0,0:05:56.73,0:05:57.42,JPDB,,0000,0000,0000,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:05:58.62,0:05:59.34,JPDB,,0000,0000,0000,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:06:06.92,0:06:08.21,JPDB,,0000,0000,0000,,Бұл жиіркенішті. Бұл жиіркенішті.
Dialogue: 0,0:06:08.33,0:06:11.32,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз? Біреу менімен ақылдасу үшін қиындық көрді.
Dialogue: 0,0:06:11.69,0:06:13.53,JPDB,,0000,0000,0000,,Менімен ешкім ақылдасқысы келмеді.
Dialogue: 0,0:06:13.73,0:06:17.28,JPDB,,0000,0000,0000,,Менің ойымша, бұл сіз айтпасаңыз, сабақта маңызды емес нәрселерді айтып жатқаныңызды айтқаныңыз үшін.
Dialogue: 0,0:06:17.53,0:06:17.93,JPDB,,0000,0000,0000,,Техе
Dialogue: 0,0:06:18.55,0:06:20.09,JPDB,,0000,0000,0000,,Сіз бәрібір бақыттысыз.
Dialogue: 0,0:06:20.69,0:06:25.28,JPDB,,0000,0000,0000,,Которию-сан туралы айтатын болсақ, оның «Сүйкімді қыздар чемпионатында» төртінші орынға шығу мүмкіндігі бар.
Dialogue: 0,0:06:26.13,0:06:27.12,JPDB,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:06:27.12,0:06:28.02,JPDB,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:06:28.86,0:06:31.17,JPDB,,0000,0000,0000,,Мұндай нәрсе Бір күні мұндай нәрсе болады
Dialogue: 0,0:06:31.82,0:06:33.04,JPDB,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:06:34.58,0:06:40.32,JPDB,,0000,0000,0000,,Юта: Өкінішке орай, менің физикалық байланыста тәжірибем жоқ.
Dialogue: 0,0:06:41.54,0:06:44.00,JPDB,,0000,0000,0000,,Өкінішке орай, мен де емеспін.
Dialogue: 0,0:06:44.30,0:06:47.21,JPDB,,0000,0000,0000,,О, бұл не? Бұл не? Сен ақымақсың ба, әлде ақымақсың ба?
Dialogue: 0,0:06:47.88,0:06:51.83,JPDB,,0000,0000,0000,,Олай болса, мен де біреуін шешетін шығармын.
Dialogue: 0,0:06:56.13,0:06:57.07,JPDB,,0000,0000,0000,,Кумин Сенпай
Dialogue: 0,0:06:57.52,0:06:58.29,JPDB,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:58.69,0:07:03.06,JPDB,,0000,0000,0000,,Кешке менімен бірге келіңіз.
Dialogue: 0,0:07:03.76,0:07:04.48,JPDB,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:07:04.65,0:07:05.52,JPDB,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:07:05.52,0:07:06.57,JPDB,,0000,0000,0000,,Катто
Dialogue: 0,0:07:07.49,0:07:10.79,JPDB,,0000,0000,0000,,Неге маған үш тиындық ойын көрсетуің керек?
Dialogue: 0,0:07:10.99,0:07:14.20,JPDB,,0000,0000,0000,,Бұл пьеса емес. Неге сондасың?
Dialogue: 0,0:07:14.64,0:07:19.86,JPDB,,0000,0000,0000,,Ертеңгі қойылым үшін жаттығу керек пе? Тогаши-кун мен Котори-сан ше?
Dialogue: 0,0:07:19.99,0:07:22.20,JPDB,,0000,0000,0000,,Бұл туралы айтпа
Dialogue: 0,0:07:22.82,0:07:27.82,JPDB,,0000,0000,0000,,Декоморидің көңіл-күйі қазір нашар, Өлім күресуде.
Dialogue: 0,0:07:28.24,0:07:31.45,JPDB,,0000,0000,0000,,Менің мұндай нәрселерге уақытым жоқ. Мен бұл екеуін алғым келеді...
Dialogue: 0,0:07:31.45,0:07:34.18,JPDB,,0000,0000,0000,,Екеуміз бірге қайттық.
Dialogue: 0,0:07:34.18,0:07:34.45,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:35.32,0:07:41.71,JPDB,,0000,0000,0000,,Дэйс Қараңғы жалын шеберінің оған айтатын маңызды бір нәрсесі бар екенін айтты.
Dialogue: 0,0:07:47.92,0:07:48.40,JPDB,,0000,0000,0000,,Эй
Dialogue: 0,0:08:02.29,0:08:07.16,JPDB,,0000,0000,0000,,Менің келісімім бойынша өсиеттерімді тыңда, Менің өсиетімді тыңда
Dialogue: 0,0:08:07.73,0:08:10.07,JPDB,,0000,0000,0000,,Менің келісімімді орындап, бұйрықтарымды тыңда.
Dialogue: 0,0:08:10.39,0:08:11.19,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:08:11.76,0:08:15.51,JPDB,,0000,0000,0000,,Сиқырлы тас: Тілектер орындалады. Декомориден алынды.
Dialogue: 0,0:08:15.94,0:08:16.58,JPDB,,0000,0000,0000,,Қалайсыз ба?
Dialogue: 0,0:08:20.66,0:08:22.15,JPDB,,0000,0000,0000,,Сізге тілегімнің не екенін айта алмаймын.
Dialogue: 0,0:08:22.32,0:08:24.11,JPDB,,0000,0000,0000,,Жоқ, ешкім тыңдамайды.
Dialogue: 0,0:08:30.43,0:08:32.86,JPDB,,0000,0000,0000,,Мен оны тастадым. Аа, жылы.
Dialogue: 0,0:08:33.53,0:08:36.39,JPDB,,0000,0000,0000,,Сиқырлы тас күшті тілектердің арқасында жылу шығарады.
Dialogue: 0,0:08:36.99,0:08:38.83,JPDB,,0000,0000,0000,,Басқаша айтқанда... жоқ
Dialogue: 0,0:08:42.28,0:08:43.18,JPDB,,0000,0000,0000,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:08:57.09,0:08:58.61,JPDB,,0000,0000,0000,,Жаңбыр жауып тұр...
Dialogue: 0,0:08:59.33,0:08:59.63,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:09:00.85,0:09:03.46,JPDB,,0000,0000,0000,,Сіз қолшатыр алып жүрдіңіз...
Dialogue: 0,0:09:04.95,0:09:05.72,JPDB,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:09:05.87,0:09:09.20,JPDB,,0000,0000,0000,,О, дұрыс.
Dialogue: 0,0:09:09.92,0:09:11.81,JPDB,,0000,0000,0000,,Жоқ, мен де.
Dialogue: 0,0:09:12.30,0:09:17.10,JPDB,,0000,0000,0000,,Ютаның құпиясы туралы маңызды оқиға
Dialogue: 0,0:09:17.80,0:09:24.71,JPDB,,0000,0000,0000,,Иә, түсінемін. Негізі менің де айтарым бар... бірақ бұл жерде емес.
Dialogue: 0,0:09:34.50,0:09:36.44,JPDB,,0000,0000,0000,,Біз мұндай нәрселерді қалдыра алмаймыз.
Dialogue: 0,0:09:40.12,0:09:40.66,JPDB,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:09:42.23,0:09:42.53,JPDB,,0000,0000,0000,,Иә...
Dialogue: 0,0:09:43.84,0:09:44.54,JPDB,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:09:49.66,0:09:52.49,JPDB,,0000,0000,0000,,А, Шварцсехтің прототипі MkⅡ
Dialogue: 0,0:09:52.82,0:09:54.43,JPDB,,0000,0000,0000,,Тегіс шықпаңыз Толық аты
Dialogue: 0,0:09:55.58,0:09:56.22,JPDB,,0000,0000,0000,,Келісімді пайдаланбай-ақ мені одақтасың қыла аласың деп ойладың ғой?
Dialogue: 0,0:10:00.12,0:10:02.71,JPDB,,0000,0000,0000,,Түбінің өзенге жақын болмағаны жақсы.
Dialogue: 0,0:10:06.71,0:10:07.13,JPDB,,0000,0000,0000,,Не болды?
Dialogue: 0,0:10:07.95,0:10:12.97,JPDB,,0000,0000,0000,,Жарық, жарық жұмыс істеп тұр
Dialogue: 0,0:10:27.89,0:10:28.43,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:10:29.03,0:10:30.84,JPDB,,0000,0000,0000,,Маған Юта ұнайды
Dialogue: 0,0:10:30.84,0:10:31.44,JPDB,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:10:38.32,0:10:42.15,JPDB,,0000,0000,0000,,Маған Юта ұнайды
Dialogue: 0,0:10:44.64,0:10:47.45,JPDB,,0000,0000,0000,,А, күте тұрыңыз, мен бірінші баратын шығармын.
Dialogue: 0,0:10:47.74,0:10:52.91,JPDB,,0000,0000,0000,,Жоқ, зұлым патша Шинган мен бірінші боламын деп шешті.
Dialogue: 0,0:10:53.71,0:10:55.72,JPDB,,0000,0000,0000,,Мен қараңғы жалынның шеберімін деп ойлаймын
Dialogue: 0,0:11:00.10,0:11:01.79,JPDB,,0000,0000,0000,,Джау Шинген ең күшті
Dialogue: 0,0:11:04.94,0:11:10.98,JPDB,,0000,0000,0000,,Аа, басқа ештеңе жоқ. Мен бұл туралы ойладым, сондықтан айтайын.
Dialogue: 0,0:11:11.88,0:11:12.28,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:11:14.49,0:11:19.09,JPDB,,0000,0000,0000,,Қараңғылық оты құшағына алғандар. Қараңғы жалын иесі мен оның сүйіктісі...
Dialogue: 0,0:11:22.91,0:11:24.60,JPDB,,0000,0000,0000,,Тоқта, бәрібір...
Dialogue: 0,0:11:24.60,0:11:27.64,JPDB,,0000,0000,0000,,Юта жалғастырды
Dialogue: 0,0:11:33.38,0:11:40.16,JPDB,,0000,0000,0000,,Қараңғылық жалыны құшағына алғандар Қараңғы жалын иесімен ғашықтар келісімін жасайды.
Dialogue: 0,0:11:43.79,0:11:44.31,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:11:51.67,0:11:54.25,JPDB,,0000,0000,0000,,Мұндай нәрсе әдетте жүректі сыздатады емес пе?
Dialogue: 0,0:11:57.31,0:11:58.48,JPDB,,0000,0000,0000,,Сіз ұятсыз ба?
Dialogue: 0,0:11:58.55,0:11:58.98,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:12:00.54,0:12:01.36,JPDB,,0000,0000,0000,,Сонымен, қолдарыңыз ше?
Dialogue: 0,0:12:05.64,0:12:06.46,JPDB,,0000,0000,0000,,Қызғылт саусаққа арналған
Dialogue: 0,0:12:07.38,0:12:08.99,JPDB,,0000,0000,0000,,Кішкентай саусақ.
Dialogue: 0,0:12:09.66,0:12:09.99,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:12:21.74,0:12:22.39,JPDB,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:12:22.39,0:12:23.81,JPDB,,0000,0000,0000,,Үлкен аға, кешігіп қалдыңыз.
Dialogue: 0,0:12:23.81,0:12:24.68,JPDB,,0000,0000,0000,,Кешіріңіз Кузуха
Dialogue: 0,0:12:25.15,0:12:27.41,JPDB,,0000,0000,0000,,Талапкердің жауапкерге деген сүйіспеншілігі бар ма?
Dialogue: 0,0:12:27.76,0:12:33.05,JPDB,,0000,0000,0000,,Жоқ, мен сотталушымен мүмкіндігінше тезірек ажырасқым келеді.
Dialogue: 0,0:12:33.15,0:12:34.27,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:35.14,0:12:35.88,JPDB,,0000,0000,0000,,Менің бір оқиғам бар.
Dialogue: 0,0:12:55.17,0:12:57.86,JPDB,,0000,0000,0000,,Дәм қайтадан төмендеді.
Dialogue: 0,0:13:01.86,0:13:03.52,JPDB,,0000,0000,0000,,Үйде жаман болған жоқ па?
Dialogue: 0,0:13:03.99,0:13:06.01,JPDB,,0000,0000,0000,,Мен Рикканың мені тыңдауына мүмкіндік бере алмаймын.
Dialogue: 0,0:13:08.39,0:13:12.10,JPDB,,0000,0000,0000,,Бұл Италиядағы бас кеңседен болды. Мені оқуға шақырды.
Dialogue: 0,0:13:12.82,0:13:13.86,JPDB,,0000,0000,0000,,Бас тартуға ешқандай себеп жоқ
Dialogue: 0,0:13:14.68,0:13:16.67,JPDB,,0000,0000,0000,,Ол нағыз ғажайып адам еді.
Dialogue: 0,0:13:17.17,0:13:18.24,JPDB,,0000,0000,0000,,Сізде күмән болды ма?
Dialogue: 0,0:13:18.39,0:13:19.18,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:13:20.85,0:13:21.47,JPDB,,0000,0000,0000,,Мен сізбен кездескім келеді
Dialogue: 0,0:13:22.19,0:13:24.90,JPDB,,0000,0000,0000,,Бірақ бұл жақсы емес пе? Рикка да сенімдімін...
Dialogue: 0,0:13:28.13,0:13:32.20,JPDB,,0000,0000,0000,,Білесің бе, мен оған жалғыз тұруға рұқсат бере алмаймын.
Dialogue: 0,0:13:33.02,0:13:37.70,JPDB,,0000,0000,0000,,Сондықтан анам оның орнына менімен тұруды шешті.
Dialogue: 0,0:13:38.54,0:13:39.83,JPDB,,0000,0000,0000,,Рикканың анасы?
Dialogue: 0,0:13:40.83,0:13:41.35,JPDB,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:41.72,0:13:42.52,JPDB,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:13:43.31,0:13:45.45,JPDB,,0000,0000,0000,,Бұл жақсы болады деп ойлайсыз ба?
Dialogue: 0,0:13:49.90,0:13:54.00,JPDB,,0000,0000,0000,,Рикка анасын жек көрмейді, солай ма? Бұл жағдайда...
Dialogue: 0,0:13:54.00,0:13:59.37,JPDB,,0000,0000,0000,,Ана... Анам Риккамен бірнеше рет сөйлесуге тырысты.
Dialogue: 0,0:14:00.19,0:14:03.92,JPDB,,0000,0000,0000,,Ол сондай-ақ Риккаға әкесі туралы айтпағаны үшін кешірім сұрады.
Dialogue: 0,0:14:05.14,0:14:05.56,JPDB,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:14:10.73,0:14:12.49,JPDB,,0000,0000,0000,,Не болды, Тоқа-сан?
Dialogue: 0,0:14:12.94,0:14:14.73,JPDB,,0000,0000,0000,,Өтінемін, бірдеңе жасаңыз.
Dialogue: 0,0:14:15.00,0:14:15.25,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:16.05,0:14:20.10,JPDB,,0000,0000,0000,,Айтсаң, тыңдайтынына сенімдімін. «Әдепті бол» десеңіз,
Dialogue: 0,0:14:24.30,0:14:25.81,JPDB,,0000,0000,0000,,Рикка жеткілікті лайықты
Dialogue: 0,0:14:27.06,0:14:30.66,JPDB,,0000,0000,0000,,Менің ойымша, көз патч оның өзін қорғауға арналған сауыт түрі.
Dialogue: 0,0:14:32.03,0:14:35.16,JPDB,,0000,0000,0000,,Рикканың бәрін білетініне сенімдімін.
Dialogue: 0,0:14:36.08,0:14:39.86,JPDB,,0000,0000,0000,,Бірақ мен бұл туралы ештеңе істей алмайтын сияқтымын және сондықтан мен мұны істеп жатырмын.
Dialogue: 0,0:14:40.88,0:14:43.81,JPDB,,0000,0000,0000,,Осы кейіпке ену арқылы ол өзін қорғайды.
Dialogue: 0,0:14:44.31,0:14:44.80,JPDB,,0000,0000,0000,,Не
Dialogue: 0,0:14:45.47,0:14:46.22,JPDB,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:14:47.39,0:14:50.37,JPDB,,0000,0000,0000,,​​Бірақ мен оның ешқашан болмаған нәрсе болғанын қаламаймын.
Dialogue: 0,0:14:51.44,0:14:55.64,JPDB,,0000,0000,0000,,Тоқа-сан мен шешеңді тыңдап, бәрін жұтып қойсаң, бәрі бітеді.
Dialogue: 0,0:14:56.29,0:14:57.18,JPDB,,0000,0000,0000,,Маған бұл ұнамайды.
Dialogue: 0,0:14:57.88,0:15:02.70,JPDB,,0000,0000,0000,,Оның аяқталуында не дұрыс емес? Шекара сызығы немесе Джау Шинган жоқ.
Dialogue: 0,0:15:04.07,0:15:05.78,JPDB,,0000,0000,0000,,Әкемді қанша іздесем де таба алмаймын.
Dialogue: 0,0:15:06.53,0:15:07.12,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:15:07.74,0:15:10.50,JPDB,,0000,0000,0000,,Оның айтқанын растау арқылы не шешіледі?
Dialogue: 0,0:15:11.45,0:15:14.43,JPDB,,0000,0000,0000,,Ол ешқашан қалаған нәрсені ала алмайды.
Dialogue: 0,0:15:15.32,0:15:16.00,JPDB,,0000,0000,0000,,Бірақ…
Dialogue: 0,0:15:16.82,0:15:21.69,JPDB,,0000,0000,0000,,Мұны растау жауапсыздық.
Dialogue: 0,0:15:37.39,0:15:41.12,JPDB,,0000,0000,0000,,Иә, бір ірімшік картоп. Сатып алғаныңыз үшін рахмет.
Dialogue: 0,0:15:42.91,0:15:44.43,JPDB,,0000,0000,0000,,Бұл өте танымал.
Dialogue: 0,0:15:45.42,0:15:50.12,JPDB,,0000,0000,0000,,Анау жігіттер, өздерің көріп тұрсыңдар, бірақ ішіндегісі қыздар арасындағы беймаза қарым-қатынас.
Dialogue: 0,0:15:50.12,0:15:51.96,JPDB,,0000,0000,0000,,Сондықтан мен мотивацияны жоғалттым, солай ма?
Dialogue: 0,0:15:52.21,0:15:56.58,JPDB,,0000,0000,0000,,А, ол сыр картоп сияқты, сырты қытырлақ, іші былдыр.
Dialogue: 0,0:15:56.58,0:15:58.15,JPDB,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:58.32,0:16:00.48,JPDB,,0000,0000,0000,,Которию-сан мен Тогаши-кун ше?
Dialogue: 0,0:16:00.83,0:16:02.12,JPDB,,0000,0000,0000,,Ол киім ауыстырғалы жатқанын айтты.
Dialogue: 0,0:16:02.67,0:16:05.65,JPDB,,0000,0000,0000,,Тездетіңіз. Қараңыз.
Dialogue: 0,0:16:05.83,0:16:08.84,JPDB,,0000,0000,0000,,Мен өнімділігіммен барлық тұтынушыларды ұрлап кетемін.
Dialogue: 0,0:16:09.63,0:16:11.05,JPDB,,0000,0000,0000,,Морисамажан
Dialogue: 0,0:16:11.20,0:16:12.41,JPDB,,0000,0000,0000,,Морисама дейді...
Dialogue: 0,0:16:13.14,0:16:14.87,JPDB,,0000,0000,0000,,Сато және Сузуки
Dialogue: 0,0:16:15.17,0:16:20.12,JPDB,,0000,0000,0000,,Оссу орта мектебінің оқушысы Биыл 716 жаста?
Dialogue: 0,0:16:20.64,0:16:22.06,JPDB,,0000,0000,0000,,Сіз әлі де кесірткелерді ұстап жатырсыз ба?
Dialogue: 0,0:16:23.72,0:16:28.57,JPDB,,0000,0000,0000,,Тіпті Сатоның ерні күлгін түсті және ауру көрінді.
Dialogue: 0,0:16:29.59,0:16:32.45,JPDB,,0000,0000,0000,,Эй, Сато, мен осылай істеп жүргенмін.
Dialogue: 0,0:16:33.29,0:16:36.72,JPDB,,0000,0000,0000,,Сузуки де пері тапқанын айтты.
Dialogue: 0,0:16:37.32,0:16:38.19,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:16:38.44,0:16:39.73,JPDB,,0000,0000,0000,,Ертегі дегеніміз не?
Dialogue: 0,0:16:40.60,0:16:45.87,JPDB,,0000,0000,0000,,Бұл қауіпті, себебі сіз ненің кері қайтып келетінін білмейсіз.
Dialogue: 0,0:16:46.37,0:16:52.78,JPDB,,0000,0000,0000,,Кешегі... Кешегі қаулы әлі шешілмеген.
Dialogue: 0,0:16:53.47,0:16:58.52,JPDB,,0000,0000,0000,,Бүгін Өлім балғасының күшін төрт есе арттырды.
Dialogue: 0,0:17:00.63,0:17:01.68,JPDB,,0000,0000,0000,,Ауыр өлім
Dialogue: 0,0:17:01.85,0:17:03.71,JPDB,,0000,0000,0000,,Сен шынымен ақымақсың.
Dialogue: 0,0:17:08.11,0:17:11.14,JPDB,,0000,0000,0000,,Оны растау арқылы не шешіледі?
Dialogue: 0,0:17:12.41,0:17:17.46,JPDB,,0000,0000,0000,,Мұны растау жауапсыздық болар еді.
Dialogue: 0,0:17:22.30,0:17:24.69,JPDB,,0000,0000,0000,,Юта жақсы көрінеді
Dialogue: 0,0:17:24.69,0:17:25.83,JPDB,,0000,0000,0000,,Көздерің жарқырап кетпесін
Dialogue: 0,0:17:26.21,0:17:31.13,JPDB,,0000,0000,0000,,Техника: «Қараңғылық жалынының құшағында жоғалып кету». Юта, мен жасап көрейін.
Dialogue: 0,0:17:31.80,0:17:32.32,JPDB,,0000,0000,0000,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:17:32.64,0:17:33.96,JPDB,,0000,0000,0000,,Осыдан кейін бірден жасайсыз ба?
Dialogue: 0,0:17:34.66,0:17:36.12,JPDB,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:17:38.01,0:17:39.93,JPDB,,0000,0000,0000,,«Қараңғылық жалынының құшағында жоғалып кет».
Dialogue: 0,0:17:40.45,0:17:41.89,JPDB,,0000,0000,0000,,Қуат мүлде жоқ
Dialogue: 0,0:17:42.29,0:17:44.32,JPDB,,0000,0000,0000,,Мұндай нәрсенің күші бар ма?
Dialogue: 0,0:17:44.70,0:17:49.52,JPDB,,0000,0000,0000,,Жоқ, аяқтарыңызды жайыңыз, тізеңізді түсіріңіз және жарғанат аулаңыздың шетінде қалқып тұрсын.
Dialogue: 0,0:17:50.07,0:17:50.94,JPDB,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:17:52.20,0:17:54.39,JPDB,,0000,0000,0000,,«Қараңғылық жалынында жоғалып кету»
Dialogue: 0,0:17:55.16,0:17:55.76,JPDB,,0000,0000,0000,,Алайда, оның жоғалып кеткеніне төрт ай болды
Dialogue: 0,0:17:56.43,0:17:57.37,JPDB,,0000,0000,0000,,Келесі жолы бірге
Dialogue: 0,0:18:05.72,0:18:09.01,JPDB,,0000,0000,0000,,Миссия басталғалы тұр. Әркім өз орындарында.
Dialogue: 0,0:18:09.38,0:18:12.06,JPDB,,0000,0000,0000,,А, мен бұған онша құмар емеспін.
Dialogue: 0,0:18:15.32,0:18:15.54,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:18:16.34,0:18:17.85,JPDB,,0000,0000,0000,,Иә? не
Dialogue: 0,0:18:19.89,0:18:20.66,JPDB,,0000,0000,0000,,Ештеңе
Dialogue: 0,0:18:23.35,0:18:23.97,JPDB,,0000,0000,0000,,Кішкентай саусақ
Dialogue: 0,0:18:39.85,0:18:40.32,JPDB,,0000,0000,0000,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,0:18:40.92,0:18:41.34,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:18:41.79,0:18:45.59,JPDB,,0000,0000,0000,,Рикка Которию деген балаңыз бар ма?
Dialogue: 0,0:18:46.91,0:18:47.58,JPDB,,0000,0000,0000,,Бұл адам...
Dialogue: 0,0:18:49.07,0:18:51.33,JPDB,,0000,0000,0000,,Мен қазір басқа жердемін.
Dialogue: 0,0:18:51.80,0:18:55.01,JPDB,,0000,0000,0000,,Мен түсінемін, содан кейін бұл
Dialogue: 0,0:18:57.17,0:18:57.69,JPDB,,0000,0000,0000,,Ум...
Dialogue: 0,0:18:58.44,0:19:01.35,JPDB,,0000,0000,0000,,Жарайды, мен үйге қайтайын.
Dialogue: 0,0:19:02.19,0:19:07.49,JPDB,,0000,0000,0000,,Өйткені, ол мені әлі көргісі келмейтін шығар.
Dialogue: 0,0:19:19.47,0:19:20.73,JPDB,,0000,0000,0000,,Менің ойымша, бұл жауапсыздық.
Dialogue: 0,0:19:23.54,0:19:24.04,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:19:26.03,0:19:28.36,JPDB,,0000,0000,0000,,Неліктен мұндай жерде сонша қаңырап қалдың?
Dialogue: 0,0:19:28.79,0:19:30.68,JPDB,,0000,0000,0000,,Қазір бастайық
Dialogue: 0,0:19:31.22,0:19:34.01,JPDB,,0000,0000,0000,,Дәл қазір келушілер көп.
Dialogue: 0,0:19:36.47,0:19:36.91,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:19:38.93,0:19:41.19,JPDB,,0000,0000,0000,,Көз патчын алып тастаңыз
Dialogue: 0,0:19:50.01,0:19:55.90,JPDB,,0000,0000,0000,,Енді жыл сайынғы бір ату орындау байқауы басталды. Серуендеу рұқсат етіледі.
Dialogue: 0,0:19:58.29,0:20:02.04,JPDB,,0000,0000,0000,,Онымен қазір ойнауды бастайық. Бірінші адам өтінемін.
Dialogue: 0,0:20:02.29,0:20:06.59,JPDB,,0000,0000,0000,,Ичибан 2 сынып 3 сынып Харута Джинно Мен директордың орынбасарына еліктеймін
Dialogue: 0,0:20:07.09,0:20:09.03,JPDB,,0000,0000,0000,,Бітті ме? Өнімділік
Dialogue: 0,0:20:09.45,0:20:12.33,JPDB,,0000,0000,0000,,Иә, мен және сол орта мектеп оны басқардық.
Dialogue: 0,0:20:13.40,0:20:15.64,JPDB,,0000,0000,0000,,Ол мені шынымен ұрады.
Dialogue: 0,0:20:16.83,0:20:17.55,JPDB,,0000,0000,0000,,Ято-сама!
Dialogue: 0,0:20:20.98,0:20:24.36,JPDB,,0000,0000,0000,,Сенің бұлай айтатыныңа таң қалдым.
Dialogue: 0,0:20:25.98,0:20:26.87,JPDB,,0000,0000,0000,,Түскі ас қорабы
Dialogue: 0,0:20:29.43,0:20:34.15,JPDB,,0000,0000,0000,,Бұл әлі де аздап жылы және өте ауыр.
Dialogue: 0,0:20:35.40,0:20:38.50,JPDB,,0000,0000,0000,,Бұл жинақталған. Ол қапталған.
Dialogue: 0,0:20:39.47,0:20:40.32,JPDB,,0000,0000,0000,,Сүйіспеншілік пе?
Dialogue: 0,0:20:40.96,0:20:41.63,JPDB,,0000,0000,0000,,Шындық
Dialogue: 0,0:20:42.26,0:20:45.98,JPDB,,0000,0000,0000,,2-сынып, 4-сынып, Макото Исшики жылайды
Dialogue: 0,0:20:48.17,0:20:52.62,JPDB,,0000,0000,0000,,7 мамыр, Күмин-сенпай, менімен бірге шықшы.
Dialogue: 0,0:20:53.34,0:20:54.51,JPDB,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:20:54.98,0:20:56.51,JPDB,,0000,0000,0000,,Және мырза Kotoriyu
Dialogue: 0,0:21:00.10,0:21:00.85,JPDB,,0000,0000,0000,,Мен оны іздеймін
Dialogue: 0,0:21:02.51,0:21:06.29,JPDB,,0000,0000,0000,,Тоғаши мырза, бұл жақсы нәрсе деп ойлаймын.
Dialogue: 0,0:21:06.56,0:21:10.04,JPDB,,0000,0000,0000,,Рахмет
Dialogue: 0,0:00:00.00,0:00:00.00,JPDB,,0000,0000,0000,,Енді келесі қадам секіру. 3 саны, өтінемін.
Dialogue: 0,0:21:10.04,0:21:13.95,JPDB,,0000,0000,0000,,1 курс 4 сынып Рикка Которию ән айтады
Dialogue: 0,0:21:20.46,0:21:21.70,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:18.57,0:21:29.03,JPDB,,0000,0000,0000,,Түнгі жұлдыздарға қара
Dialogue: 0,0:21:29.88,0:21:40.07,JPDB,,0000,0000,0000,,Кішкентай жұлдыз, кішкентай шам
Dialogue: 0,0:21:34.15,0:21:37.48,JPDB,,0000,0000,0000,,Бұл менің әкем жақсы көретін ән.
Dialogue: 0,0:21:40.79,0:21:51.25,JPDB,,0000,0000,0000,,Кішкентай бақыт туралы жырлау
Dialogue: 0,0:23:27.88,0:23:30.94,JPDB,,0000,0000,0000,,Иә, бұл 1-курстың 4-сынып оқушысы Рикка Которию болатын.
Dialogue: 0,0:23:27.88,0:23:28.63,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:23:31.56,0:23:33.23,JPDB,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:23:33.75,0:23:36.56,JPDB,,0000,0000,0000,,Бұл әнде қандай да бір естеліктер бар ма?
Dialogue: 0,0:00:50.53,0:00:54.50,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:00:54.73,0:01:01.29,JPOP,,0000,0000,0000,karaoke,Маған таң қалдырмас бұрын сіз не ойладыңыз?
Dialogue: 0,0:01:01.51,0:01:05.54,JPOP,,0000,0000,0000,karaoke,Маған қарашы еріндері
Dialogue: 0,0:01:05.76,0:01:11.08,JPOP,,0000,0000,0000,karaoke,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:01:11.43,0:01:16.78,JPOP,,0000,0000,0000,karaoke,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:01:17.27,0:01:22.69,JPOP,,0000,0000,0000,karaoke,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:01:23.39,0:01:28.23,JPOP,,0000,0000,0000,karaoke,Сізді бір-біріңізге тартатын махаббат
Dialogue: 0,0:01:28.58,0:01:33.05,JPOP,,0000,0000,0000,karaoke,Ол әлдеқашан басталған болатын
Dialogue: 0,0:01:34.07,0:01:36.43,JPOP,,0000,0000,0000,karaoke,Менің көп арманым болды
Dialogue: 0,0:01:36.46,0:01:40.34,JPOP,,0000,0000,0000,karaoke,Оянсам да, сені көргім келеді.
Dialogue: 0,0:01:40.34,0:01:42.55,JPOP,,0000,0000,0000,karaoke,Сіз мұны жасадыңыз
Dialogue: 0,0:01:42.55,0:01:44.96,JPOP,,0000,0000,0000,karaoke,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:01:44.96,0:01:50.53,JPOP,,0000,0000,0000,karaoke,Жүрегіміз секіріп бара жатқандай, қайда барайық
Dialogue: 0,0:01:50.53,0:01:53.14,JPOP,,0000,0000,0000,karaoke,Идеалдар, адасулар және шындық
Dialogue: 0,0:01:53.26,0:01:55.77,JPOP,,0000,0000,0000,karaoke,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:01:56.00,0:02:01.12,JPOP,,0000,0000,0000,karaoke,Жаңа әлемге
Dialogue: 0,0:00:50.53,0:00:54.50,ZWOP,,0000,0000,0000,karaoke,Сіз екі көзбен осы сәттесіз
Dialogue: 0,0:00:54.75,0:01:01.29,ZWOP,,0000,0000,0000,karaoke,Қозғалмас бұрын қайда екеніңізді көре аласыз.
Dialogue: 0,0:01:01.51,0:01:05.54,ZWOP,,0000,0000,0000,karaoke,Менің тұмсығыма қара
Dialogue: 0,0:01:05.76,0:01:11.08,ZWOP,,0000,0000,0000,karaoke,Жиналыстың сұрағы `` Мен мұны істегім келеді '' Сондай-ақ, үндемеңіз.
Dialogue: 0,0:01:11.43,0:01:16.78,ZWOP,,0000,0000,0000,karaoke,Моңғолияның өз бетімен сөйлесуі
Dialogue: 0,0:01:17.27,0:01:22.69,ZWOP,,0000,0000,0000,karaoke,Қуат қайтадан қажет емес.
Dialogue: 0,0:01:23.39,0:01:28.23,ZWOP,,0000,0000,0000,karaoke,Өзара тартымдылық махаббат
Dialogue: 0,0:01:28.58,0:01:33.05,ZWOP,,0000,0000,0000,karaoke,Жаңа ғана басталды
Dialogue: 0,0:01:34.07,0:01:36.43,ZWOP,,0000,0000,0000,karaoke,Шектеусіз әдемі армандар
Dialogue: 0,0:01:36.46,0:01:40.34,ZWOP,,0000,0000,0000,karaoke,Бұл түстен оянғаннан кейін де оны көру керек.
Dialogue: 0,0:01:40.34,0:01:42.55,ZWOP,,0000,0000,0000,karaoke,Капитал зиянды
Dialogue: 0,0:01:42.55,0:01:44.96,ZWOP,,0000,0000,0000,karaoke,Махаббат - махаббаттың шынайы табиғаты.
Dialogue: 0,0:01:44.96,0:01:50.53,ZWOP,,0000,0000,0000,karaoke,Будда мен баланың ішкі ойлары секіріп кетеді.
Dialogue: 0,0:01:50.53,0:01:53.14,ZWOP,,0000,0000,0000,karaoke,Күмән жоқ - идеал, адасушылық - шындық
Dialogue: 0,0:01:53.26,0:01:55.77,ZWOP,,0000,0000,0000,karaoke,Барлық астаналар сіздің кезегіңізде келді.
Dialogue: 0,0:01:56.00,0:02:01.12,ZWOP,,0000,0000,0000,karaoke,Жаңа әлемге шығу
