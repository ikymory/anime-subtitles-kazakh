Dialogue: 0,0:21:57.69,0:22:00.20,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:00.20,0:22:01.97,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:13.10,0:22:15.61,JPED,,0000,0000,0000,,Түсініспеушілік ұят па?
Dialogue: 0,0:22:15.61,0:22:17.94,JPED,,0000,0000,0000,,Адалдық зиян келтіреді.
Dialogue: 0,0:22:18.27,0:22:20.83,JPED,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:22:20.83,0:22:23.26,JPED,,0000,0000,0000,,Мен ненің дұрыс екенін білмеймін.
Dialogue: 0,0:22:23.46,0:22:26.07,JPED,,0000,0000,0000,,Әдеттегідей ағып жатқан күнделікті өмірде
Dialogue: 0,0:22:26.19,0:22:28.53,JPED,,0000,0000,0000,,Мен өзімді соған үйренуге мәжбүр еттім.
Dialogue: 0,0:22:28.53,0:22:31.16,JPED,,0000,0000,0000,,Суға батқан тұлға және қан
Dialogue: 0,0:22:31.36,0:22:33.58,JPED,,0000,0000,0000,,Шайнаңыз, ішіңіз, түкіріңіз және сындырыңыз
Dialogue: 0,0:22:33.58,0:22:38.00,JPED,,0000,0000,0000,,Мені осылай түсінгеніңізді қалаймын
Dialogue: 0,0:22:38.27,0:22:43.57,JPED,,0000,0000,0000,,Айтқым келеді, бірақ айта алмаймын.
Dialogue: 0,0:22:43.57,0:22:48.36,JPED,,0000,0000,0000,,Неге ешкім түсінбейді?
Dialogue: 0,0:22:48.59,0:22:53.53,JPED,,0000,0000,0000,,Бұл туралы ойлану сән-салтанат па? Солай ма?
Dialogue: 0,0:22:53.53,0:22:58.70,JPED,,0000,0000,0000,,Эмоциялық күн
Dialogue: 0,0:22:58.95,0:23:01.64,JPED,,0000,0000,0000,,Тым көп қызу
Dialogue: 0,0:23:01.64,0:23:03.92,JPED,,0000,0000,0000,,Бұл қандай да бір жолмен шешілетін сияқты
Dialogue: 0,0:23:04.07,0:23:08.99,JPED,,0000,0000,0000,,Айқайлағым келеді
Dialogue: 0,0:23:08.99,0:23:14.91,JPED,,0000,0000,0000,,ТҮСІКТІЛІКТІ іздеп жатыр
Dialogue: 0,0:23:15.18,0:23:17.67,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:17.67,0:23:20.20,JPED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:20.20,0:23:22.76,JPED,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:23:22.76,0:23:24.76,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:21:57.69,0:22:00.20,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:00.20,0:22:01.97,ZWED,,0000,0000,0000,,Қараған жерің – тұратын жерің.
Dialogue: 0,0:22:13.10,0:22:15.61,ZWED,,0000,0000,0000,,Жиналыста мен ұялдым
Dialogue: 0,0:22:15.61,0:22:17.94,ZWED,,0000,0000,0000,,Ашық шолу
Dialogue: 0,0:22:18.27,0:22:20.83,ZWED,,0000,0000,0000,,Оған күмән жоқ
Dialogue: 0,0:22:20.83,0:22:23.26,ZWED,,0000,0000,0000,,Белгісіз кірісімді түзететініме сенімдімін.
Dialogue: 0,0:22:23.46,0:22:26.07,ZWED,,0000,0000,0000,,Өзін-өзі анықтауды зерттеңіз
Dialogue: 0,0:22:26.19,0:22:28.53,ZWED,,0000,0000,0000,,Ичитоу Фуканнан келген Хико
Dialogue: 0,0:22:28.53,0:22:31.16,ZWED,,0000,0000,0000,,Қолбасшының эго мен қаны
Dialogue: 0,0:22:31.36,0:22:33.58,ZWED,,0000,0000,0000,,Шайнау, жылау, түкіру, ойнау
Dialogue: 0,0:22:33.58,0:22:38.00,ZWED,,0000,0000,0000,,Сіз мұны түсінесіз деп үміттенемін.
Dialogue: 0,0:22:38.27,0:22:43.57,ZWED,,0000,0000,0000,,Күтпеген ойлар ашылуы мүмкін.
Dialogue: 0,0:22:43.57,0:22:48.36,ZWED,,0000,0000,0000,,Мен адам қалмағанын түсінемін.
Dialogue: 0,0:22:48.59,0:22:53.53,ZWED,,0000,0000,0000,,Егер сізді түсінгіңіз келсе, солай етіңіз.
Dialogue: 0,0:22:53.53,0:22:58.70,ZWED,,0000,0000,0000,,Бұл эмоционалды күн
Dialogue: 0,0:22:58.95,0:23:01.64,ZWED,,0000,0000,0000,,Радиациялық жылу сыйымдылығы
Dialogue: 0,0:23:01.64,0:23:03.92,ZWED,,0000,0000,0000,,Өзін рахатқа ұшырататын теріс қылықтар
Dialogue: 0,0:23:04.07,0:23:08.99,ZWED,,0000,0000,0000,,Айқайлауға құмарлықты заңсыз шектеу
Dialogue: 0,0:23:08.99,0:23:14.91,ZWED,,0000,0000,0000,,ТҰРҒЫНДАР
Dialogue: 0,0:23:15.18,0:23:17.67,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:17.67,0:23:20.20,ZWED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:20.20,0:23:22.76,ZWED,,0000,0000,0000,,Қажетсіз кедергілер
Dialogue: 0,0:23:22.76,0:23:24.76,ZWED,,0000,0000,0000,,Қараған жерің – тұратын жерің.
Dialogue: 0,0:02:05.97,0:02:15.94,ZZ信息,,0000,0000,0000,,Бұл субтитрлер топтамасы субтитрлер тобында көрсетіледі және көбірек қытай, жапон және қытай субтитрлері алмасу үшін қолжетімді. www.kamigami.org
Dialogue: 0,0:02:05.97,0:02:15.94,ZZ信息,,0000,0000,0000,,JustiN
Dialogue: 0,0:02:20.91,0:02:26.91,ZWBT,,0000,0000,0000,,Аналық... ыңғайлы жәшік
Dialogue: 0,0:10:27.31,0:10:30.42,JPIN,,0000,0000,0000,,Артқа бұрылып, ештеңе айтпа
Dialogue: 0,0:10:30.42,0:10:32.81,JPIN,,0000,0000,0000,,Мен не айтуым керек?
Dialogue: 0,0:10:33.03,0:10:36.16,JPIN,,0000,0000,0000,,Саған ғашық болуым үшін ешқандай себеп жоқ
Dialogue: 0,0:10:36.29,0:10:39.44,JPIN,,0000,0000,0000,,Ымыртқа қарай ояну, сылтаулар толы
Dialogue: 0,0:10:39.44,0:10:42.48,JPIN,,0000,0000,0000,,Метеорит жауын көріп отырғанда
Dialogue: 0,0:10:42.48,0:10:45.51,JPIN,,0000,0000,0000,,Жарқыраған дыбыс бар сияқты
Dialogue: 0,0:10:45.51,0:10:48.59,JPIN,,0000,0000,0000,,Мұндай кенеттен пайда болуы
Dialogue: 0,0:10:48.59,0:10:51.42,JPIN,,0000,0000,0000,,Мен сенімен кездескеніме куә болып отырмын
Dialogue: 0,0:10:51.99,0:10:56.67,JPIN,,0000,0000,0000,,Махаббат бөліктері енді бір
Dialogue: 0,0:10:57.26,0:11:03.05,JPIN,,0000,0000,0000,,Тіпті арзан нәрселер жүзеге асса да
Dialogue: 0,0:11:03.38,0:11:09.02,JPIN,,0000,0000,0000,,Ол сізге жетпеуі мүмкін
Dialogue: 0,0:11:09.14,0:11:14.96,JPIN,,0000,0000,0000,,Бірақ ештеңе айтпағанда
Dialogue: 0,0:11:15.31,0:11:19.76,JPIN,,0000,0000,0000,,Ол жоғалып кетуі мүмкін
Dialogue: 0,0:11:19.76,0:11:21.99,JPIN,,0000,0000,0000,,Сол жұлдыз сияқты
Dialogue: 0,0:11:21.99,0:11:27.01,JPIN,,0000,0000,0000,,Мен дәл қазір осында ұстап тұрғаным
Dialogue: 0,0:11:27.11,0:11:33.25,JPIN,,0000,0000,0000,,Мен сені қалай күлдіремін?
Dialogue: 0,0:11:33.25,0:11:39.54,JPIN,,0000,0000,0000,,Аспанды біріктіріп, шоқжұлдыз түзгім келеді.
Dialogue: 0,0:11:39.54,0:11:45.90,JPIN,,0000,0000,0000,,Осы саусақпен
Dialogue: 0,0:11:54.83,0:11:58.45,JPIN,,0000,0000,0000,,Артқа емес
Dialogue: 0,0:11:58.45,0:12:00.64,JPIN,,0000,0000,0000,,Маған қара
Dialogue: 0,0:12:00.96,0:12:10.61,JPIN,,0000,0000,0000,,Ал мен сенің жаныңда жүргім келеді
Dialogue: 0,0:10:27.31,0:10:30.42,ZWIN,,0000,0000,0000,,Арқаңызда бір сөз қалдырмаңыз
Dialogue: 0,0:10:30.42,0:10:32.81,ZWIN,,0000,0000,0000,,Күш-жігерге әбден лайық
Dialogue: 0,0:10:33.03,0:10:36.16,ZWIN,,0000,0000,0000,,Мин Мин Хикунның сұранысқа ие болмауының себептері
Dialogue: 0,0:10:36.29,0:10:39.44,ZWIN,,0000,0000,0000,,Ымырт ұйқысынан оянғанда
Dialogue: 0,0:10:39.44,0:10:42.48,ZWIN,,0000,0000,0000,,Аспанда метеорлық жауын пайда болған кезде
Dialogue: 0,0:10:42.48,0:10:45.51,ZWIN,,0000,0000,0000,,Көктегі дауыстың дыбысы
Dialogue: 0,0:10:45.51,0:10:48.59,ZWIN,,0000,0000,0000,,Нака Шун дереу сұлулық
Dialogue: 0,0:10:48.59,0:10:51.42,ZWIN,,0000,0000,0000,,Кездескен кезде көріскенше
Dialogue: 0,0:10:51.99,0:10:56.67,ZWIN,,0000,0000,0000,,Қазір махаббаттың махаббат хикаясы
Dialogue: 0,0:10:57.26,0:11:03.05,ZWIN,,0000,0000,0000,,Бұл шындықтағы үміттің шамалы болмауы туралы әңгіме.
Dialogue: 0,0:11:03.38,0:11:09.02,ZWIN,,0000,0000,0000,,Сіздің де бұған рұқсатыңыз жоқ.
Dialogue: 0,0:11:09.14,0:11:14.96,ZWIN,,0000,0000,0000,,Дегенмен, оқиғаның оқиғасы
Dialogue: 0,0:11:15.31,0:11:19.76,ZWIN,,0000,0000,0000,,Енді мені қалай ұстайсың?
Dialogue: 0,0:11:19.76,0:11:21.99,ZWIN,,0000,0000,0000,,Өтіп бара жатқан аққан жұлдыз
Dialogue: 0,0:11:21.99,0:11:27.01,ZWIN,,0000,0000,0000,,Менің денем жоғалып кетті, мен оны көрмеймін
Dialogue: 0,0:11:27.11,0:11:33.25,ZWIN,,0000,0000,0000,,Менімен танысуға және күлімсіреуіңізді көрсетуге қош келдіңіз
Dialogue: 0,0:11:33.25,0:11:39.54,ZWIN,,0000,0000,0000,,Шабыт алу үшін саусақ ұштары
Dialogue: 0,0:11:39.54,0:11:45.90,ZWIN,,0000,0000,0000,,Аспанда қалқып жүрген шоқжұлдыз
Dialogue: 0,0:11:54.83,0:11:58.45,ZWIN,,0000,0000,0000,,Қажетсіз қайталану
Dialogue: 0,0:11:58.45,0:12:00.64,ZWIN,,0000,0000,0000,,...
Dialogue: 0,0:12:00.96,0:12:10.61,ZWIN,,0000,0000,0000,,Осыдан кейін мен сені тікелей қасымдасың және менің алдымдасың деп ойладым.
Dialogue: 0,0:00:04.59,0:00:07.13,ZWDB,,0000,0000,0000,,Бірінші сурет: Нагасаки мен Хирочиде тұратын қыз.
Dialogue: 0,0:00:08.42,0:00:11.48,ZWDB,,0000,0000,0000,,Физикалық түрде сезілетін шамалы жылу
Dialogue: 0,0:00:12.87,0:00:15.65,ZWDB,,0000,0000,0000,,Будданың қайта пайдалану күші аздап, оның денесі бұзылған.
Dialogue: 0,0:00:16.20,0:00:19.65,ZWDB,,0000,0000,0000,,Нана әлсіз және кішкентай, Нана өте әлсіз
Dialogue: 0,0:00:22.24,0:00:23.06,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:00:23.88,0:00:24.65,ZWDB,,0000,0000,0000,,Рикка…
Dialogue: 0,0:00:26.94,0:00:29.15,ZWDB,,0000,0000,0000,,Ұмыту оңай...
Dialogue: 0,0:00:26.94,0:00:29.15,ZWDB,,0000,0000,0000,,Ауырған өлім, азапты өлім, азапты өлім...
Dialogue: 0,0:02:18.08,0:02:22.46,ZWDB,,0000,0000,0000,,Ескерту: Барлық оқушылар кештің соңына дейін мектепке баруы керек.
Dialogue: 0,0:02:23.48,0:02:29.05,ZWDB,,0000,0000,0000,,Бірінші кезең: Барлық оқушылар түннің соңына дейін мектепке баруы керек.
Dialogue: 0,0:00:00.00,0:00:00.00,ZWDB,,0000,0000,0000,,Аналық... ыңғайлы жәшік
Dialogue: 0,0:02:27.58,0:02:28.25,ZWDB,,0000,0000,0000,,Мастер
Dialogue: 0,0:02:31.66,0:02:36.00,ZWDB,,0000,0000,0000,,Қара жолдың қара түні аяқталды.
Dialogue: 0,0:02:37.84,0:02:38.54,ZWDB,,0000,0000,0000,,Ұстаз?
Dialogue: 0,0:02:48.71,0:02:50.99,ZWDB,,0000,0000,0000,,Уақыт өте келе тоқырауға ұшырады.
Dialogue: 0,0:02:54.84,0:02:57.06,ZWDB,,0000,0000,0000,,Бұл ұқсас
Dialogue: 0,0:03:05.63,0:03:06.23,ZWDB,,0000,0000,0000,,Мастер
Dialogue: 0,0:03:08.56,0:03:10.03,ZWDB,,0000,0000,0000,,Қожа осында.
Dialogue: 0,0:03:11.37,0:03:14.43,ZWDB,,0000,0000,0000,,Туннельдің шебері - Морига…
Dialogue: 0,0:03:19.65,0:03:22.88,ZWDB,,0000,0000,0000,,Қожайын – қожайынның қызметшісі.
Dialogue: 0,0:03:23.13,0:03:26.06,ZWDB,,0000,0000,0000,,Менде шебер ретінде әртүрлі сезімдер бар.
Dialogue: 0,0:03:26.73,0:03:28.75,ZWDB,,0000,0000,0000,,Әрине, бұл қате болды
Dialogue: 0,0:03:29.29,0:03:33.54,ZWDB,,0000,0000,0000,,Қазіргі уақытта әлемде Шығыс пен Батыстағы адамдарға тырысуға деген құштарлығын басу және жоюға тыйым салынған.
Dialogue: 0,0:03:42.24,0:03:43.06,ZWDB,,0000,0000,0000,,Ұстаз?
Dialogue: 0,0:03:44.48,0:03:46.47,ZWDB,,0000,0000,0000,,Мен Юта Ютаны ұстаймын.
Dialogue: 0,0:03:47.73,0:03:48.73,ZWDB,,0000,0000,0000,,Юта Гакиджо
Dialogue: 0,0:03:49.40,0:03:50.54,ZWDB,,0000,0000,0000,,Ұстаз?
Dialogue: 0,0:03:52.06,0:03:54.20,ZWDB,,0000,0000,0000,,Бұл сауда-саттық.
Dialogue: 0,0:03:54.44,0:03:57.13,ZWDB,,0000,0000,0000,,Ормандағы шытырман оқиғадан кейін шебердің шытырман оқиғасы аяқталды.
Dialogue: 0,0:03:58.79,0:03:59.51,ZWDB,,0000,0000,0000,,Мен алты жасар қызбын.
Dialogue: 0,0:04:00.91,0:04:03.19,ZWDB,,0000,0000,0000,,На... бұл да түсініктеме
Dialogue: 0,0:04:04.49,0:04:10.75,ZWDB,,0000,0000,0000,,Шебер бақытты... лак қара жалын елшісі?
Dialogue: 0,0:04:11.44,0:04:11.74,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:16.07,0:04:20.54,ZWDB,,0000,0000,0000,,Master Convex Guard қазір аймаққа мұқтаж, бірінші іске қосу аяқталды
Dialogue: 0,0:04:20.67,0:04:21.39,ZWDB,,0000,0000,0000,,Декомори
Dialogue: 0,0:04:21.39,0:04:23.62,ZWDB,,0000,0000,0000,,Менің жұмысымның қажетсіз алдын алу
Dialogue: 0,0:04:23.77,0:04:27.77,ZWDB,,0000,0000,0000,,Қожайынның психикалық үйі менің үйімді тастап кеткен жері...
Dialogue: 0,0:04:28.54,0:04:29.44,ZWDB,,0000,0000,0000,,Мен уақытты жақсы өткізгім келеді
Dialogue: 0,0:04:38.51,0:04:41.67,ZWDB,,0000,0000,0000,,Басты кейіпкердің оқиғасы лакталған қара жалын елшісінің болуына байланысты.
Dialogue: 0,0:04:41.92,0:04:45.42,ZWDB,,0000,0000,0000,,Патшаның шын көзі дәл қазір.
Dialogue: 0,0:04:47.68,0:04:49.45,ZWDB,,0000,0000,0000,,Шынайы сезімдер
Dialogue: 0,0:04:49.79,0:04:52.65,ZWDB,,0000,0000,0000,,Лак-қара жалынның өкілі, ақырында, аяқтау сезімін алды.
Dialogue: 0,0:04:52.85,0:04:53.57,ZWDB,,0000,0000,0000,,Зена Того
Dialogue: 0,0:04:54.27,0:04:56.85,ZWDB,,0000,0000,0000,,Дөңес қорғаушы Мен самурай ретінде қызмет еттім және менің шеберім ұзақ жылдар бойы бір ұпайды аяқтады.
Dialogue: 0,0:04:57.60,0:05:01.30,ZWDB,,0000,0000,0000,,Жұмыс біткен кезде шебердің жұмысы аяқталады.
Dialogue: 0,0:05:01.75,0:05:02.50,ZWDB,,0000,0000,0000,,Декомори
Dialogue: 0,0:05:03.54,0:05:08.56,ZWDB,,0000,0000,0000,,Қажетсіз қамқорлық, зұлым патшаның шынайы көздері ең күшті
Dialogue: 0,0:05:09.16,0:05:10.85,ZWDB,,0000,0000,0000,,Белгілі бір уақыт мөлшері
Dialogue: 0,0:05:12.29,0:05:12.59,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:05:17.38,0:05:19.00,ZWDB,,0000,0000,0000,,Сіз де кішкентай құс оқушысысыз...
Dialogue: 0,0:05:19.57,0:05:21.61,ZWDB,,0000,0000,0000,,Менің айтқым келгені осы.
Dialogue: 0,0:05:22.06,0:05:22.70,ZWDB,,0000,0000,0000,,Сіз нұсқап отырсыз
Dialogue: 0,0:05:23.55,0:05:26.63,ZWDB,,0000,0000,0000,,Ұстазымның кеткенін мойындауды салыстыру
Dialogue: 0,0:05:27.10,0:05:29.34,ZWDB,,0000,0000,0000,,Кішкентай құсты ойнауға қуаныштысың.
Dialogue: 0,0:05:29.83,0:05:30.38,ZWDB,,0000,0000,0000,,Сондай-ақ қолжетімді
Dialogue: 0,0:05:31.97,0:05:34.21,ZWDB,,0000,0000,0000,,Бұл жақсы емес, жақсы емес, өйткені бұл жақсы нәрсе, бұл сіз ұзақ уақыт бойы сүйетін нәрсе.
Dialogue: 0,0:05:35.08,0:05:38.11,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:05:38.51,0:05:40.62,ZWDB,,0000,0000,0000,,Дегенмен, әлем әлемі әлі кішкентай орта мектептегі қиял емес.
Dialogue: 0,0:05:41.14,0:05:45.00,ZWDB,,0000,0000,0000,,Бұл әдемі жер және...
Dialogue: 0,0:05:45.79,0:05:49.37,ZWDB,,0000,0000,0000,,Кешіріңіз, бірақ мен сізге жанашырлық танытпайтын себебім үшін кешіріңіз.
Dialogue: 0,0:05:49.37,0:05:54.07,ZWDB,,0000,0000,0000,,Қажетсіз түсіндірме Нерексіз түсіндірме Нерексіз түсіндіру
Dialogue: 0,0:05:55.01,0:05:55.86,ZWDB,,0000,0000,0000,,Сіз туралы тағы бір оқиға
Dialogue: 0,0:05:56.73,0:05:57.42,ZWDB,,0000,0000,0000,,Каюя
Dialogue: 0,0:05:58.62,0:05:59.34,ZWDB,,0000,0000,0000,,Сен де сондайсың
Dialogue: 0,0:06:06.92,0:06:08.21,ZWDB,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:06:08.33,0:06:11.32,ZWDB,,0000,0000,0000,,Үйде қалғың келсе, отбасыңның көңілін қалдыр.
Dialogue: 0,0:06:11.69,0:06:13.53,ZWDB,,0000,0000,0000,,Мен сіздің бизнесіңізбен не істеу керектігін білмеймін.
Dialogue: 0,0:06:13.73,0:06:17.28,ZWDB,,0000,0000,0000,,Нәтижесі анық емес екені анық емес.
Dialogue: 0,0:06:17.53,0:06:17.93,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:06:18.55,0:06:20.09,ZWDB,,0000,0000,0000,,Жолың болмағаны рас.
Dialogue: 0,0:06:20.69,0:06:25.28,ZWDB,,0000,0000,0000,,``Сүйікті қыздың өмірін таңдау'' кішкентай құспен бір мектепте.
Dialogue: 0,0:06:26.13,0:06:27.12,ZWDB,,0000,0000,0000,,Заттардың түрлері
Dialogue: 0,0:06:27.12,0:06:28.02,ZWDB,,0000,0000,0000,,Қандай нәрсе?
Dialogue: 0,0:06:28.86,0:06:31.17,ZWDB,,0000,0000,0000,,Заттардың түрлері…
Dialogue: 0,0:06:31.82,0:06:33.04,ZWDB,,0000,0000,0000,,Қандай нәрсе?
Dialogue: 0,0:06:34.58,0:06:40.32,ZWDB,,0000,0000,0000,,Ютаның әртүрлі физикалық контактілер тәжірибесі.
Dialogue: 0,0:06:41.54,0:06:44.00,ZWDB,,0000,0000,0000,,Бұл бірінші рет.
Dialogue: 0,0:06:44.30,0:06:47.21,ZWDB,,0000,0000,0000,,​​Сіз мейрамханадасыз.
Dialogue: 0,0:06:47.88,0:06:51.83,ZWDB,,0000,0000,0000,,Гайя Нанадан кету туралы шешім қабылдаудың сапалы қадамдары
Dialogue: 0,0:06:56.13,0:06:57.07,ZWDB,,0000,0000,0000,,Манабу Инака
Dialogue: 0,0:06:57.52,0:06:58.29,ZWDB,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:06:58.69,0:07:03.06,ZWDB,,0000,0000,0000,,Наката мен Ичива қатысқан кештен кейінгі фестиваль
Dialogue: 0,0:07:03.76,0:07:04.48,ZWDB,,0000,0000,0000,,Жақсы дәм
Dialogue: 0,0:07:04.65,0:07:05.52,ZWDB,,0000,0000,0000,,Шынайы оқиға
Dialogue: 0,0:07:05.52,0:07:06.57,ZWDB,,0000,0000,0000,,Тоқта
Dialogue: 0,0:07:07.49,0:07:10.79,ZWDB,,0000,0000,0000,,Егер сіз оны алмасаңыз, сіз мұны істеп жатқандай әрекет ете алмайсыз.
Dialogue: 0,0:07:10.99,0:07:14.20,ZWDB,,0000,0000,0000,,Егер сіз талантты болмасаңыз, әрекет етуіңіз керек.
Dialogue: 0,0:07:14.64,0:07:19.86,ZWDB,,0000,0000,0000,,Мейтеннің өнімділігі бірінші жаттығу сессиясы үшін қажет.
Dialogue: 0,0:07:19.99,0:07:22.20,ZWDB,,0000,0000,0000,,Басқалар үшін қажетсіз мәселелер
Dialogue: 0,0:07:22.82,0:07:27.82,ZWDB,,0000,0000,0000,,Менің қазіргі көңіл-күйім анық.
Dialogue: 0,0:07:28.24,0:07:31.45,ZWDB,,0000,0000,0000,,Аспанда жүру қабілетімнен айырылдым.
Dialogue: 0,0:07:31.45,0:07:34.18,ZWDB,,0000,0000,0000,,Қалғандары тағы бір рет кетіп қалды
Dialogue: 0,0:07:34.18,0:07:34.45,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:07:35.32,0:07:41.71,ZWDB,,0000,0000,0000,,Лак қара жалын елшісінің негізгі оқиғасы.
Dialogue: 0,0:07:47.92,0:07:48.40,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:08:02.29,0:08:07.16,ZWDB,,0000,0000,0000,,Сәйкестік пактісі, Паго но Микото Сәйкестік пактісі, Паго но Микото
Dialogue: 0,0:08:07.73,0:08:10.07,ZWDB,,0000,0000,0000,,Сәйкестік келісімі: Pago no Mikoto
Dialogue: 0,0:08:10.39,0:08:11.19,ZWDB,,0000,0000,0000,,Накореджия
Dialogue: 0,0:08:11.76,0:08:15.51,ZWDB,,0000,0000,0000,,Бұл сиқырлы бағыттаушы тас және сіз оны шынымен көре аласыз.
Dialogue: 0,0:08:15.94,0:08:16.58,ZWDB,,0000,0000,0000,,Қалау?
Dialogue: 0,0:08:20.66,0:08:22.15,ZWDB,,0000,0000,0000,,Қалаған мазмұнға рұқсат етілмейді.
Dialogue: 0,0:08:22.32,0:08:24.11,ZWDB,,0000,0000,0000,,Менің де сұрағым бар...
Dialogue: 0,0:08:30.43,0:08:32.86,ZWDB,,0000,0000,0000,,Бұл жақсы және жылы
Dialogue: 0,0:08:33.53,0:08:36.39,ZWDB,,0000,0000,0000,,Сиқырлы тастың рұқсатымен Макиши тілегінен кейінгі кездесудің қызуы
Dialogue: 0,0:08:36.99,0:08:38.83,ZWDB,,0000,0000,0000,,Бұл да рас... тәртіпсіздік!
Dialogue: 0,0:08:42.28,0:08:43.18,ZWDB,,0000,0000,0000,,Бұл шынымен де өте, «өте» жақсы жас
Dialogue: 0,0:08:57.09,0:08:58.61,ZWDB,,0000,0000,0000,,Жаңбыр жауады...Рё
Dialogue: 0,0:08:59.33,0:08:59.63,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:09:00.85,0:09:03.46,ZWDB,,0000,0000,0000,,Түсіндіңіз... 3
Dialogue: 0,0:09:04.95,0:09:05.72,ZWDB,,0000,0000,0000,,Әңгімелеу
Dialogue: 0,0:09:05.87,0:09:09.20,ZWDB,,0000,0000,0000,,Бұл да аты.
Dialogue: 0,0:09:09.92,0:09:11.81,ZWDB,,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,0:09:12.30,0:09:17.10,ZWDB,,0000,0000,0000,,Бұл ең құпия және ең маңызды оқиға
Dialogue: 0,0:09:17.80,0:09:24.71,ZWDB,,0000,0000,0000,,… …
Dialogue: 0,0:09:34.50,0:09:36.44,ZWDB,,0000,0000,0000,,Бұл тікелей өту
Dialogue: 0,0:09:40.12,0:09:40.66,ZWDB,,0000,0000,0000,,Напаку
Dialogue: 0,0:09:42.23,0:09:42.53,ZWDB,,0000,0000,0000,,Иә...
Dialogue: 0,0:09:43.84,0:09:44.54,ZWDB,,0000,0000,0000,,Менің сөздерім
Dialogue: 0,0:09:49.66,0:09:52.49,ZWDB,,0000,0000,0000,,“Schwarz Sechs Prototype Mark ||”
Dialogue: 0,0:09:52.82,0:09:54.43,ZWDB,,0000,0000,0000,,Түрлі атаулардың толық атауы рас, ауыздан қашуға болады.
Dialogue: 0,0:09:55.58,0:09:56.22,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:10:00.12,0:10:02.71,ZWDB,,0000,0000,0000,,Уақыты келгенде мен өзеннен шықтым.
Dialogue: 0,0:10:06.71,0:10:07.13,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:10:07.95,0:10:12.97,ZWDB,,0000,0000,0000,,Жарық
Dialogue: 0,0:10:27.89,0:10:28.43,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:10:29.03,0:10:30.84,ZWDB,,0000,0000,0000,,Юта Гакки
Dialogue: 0,0:10:30.84,0:10:31.44,ZWDB,,0000,0000,0000,,Шыны! ?
Dialogue: 0,0:10:38.32,0:10:42.15,ZWDB,,0000,0000,0000,,Юта Гакикин
Dialogue: 0,0:10:44.64,0:10:47.45,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:10:47.74,0:10:52.91,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:10:53.71,0:10:55.72,ZWDB,,0000,0000,0000,,Мен лак қара отты елшімін
Dialogue: 0,0:11:00.10,0:11:01.79,ZWDB,,0000,0000,0000,,Зұлым патшаның шынайы көздері ең күшті
Dialogue: 0,0:11:04.94,0:11:10.98,ZWDB,,0000,0000,0000,,Қаншалықты дарынды екенімді білмегенімді білу жақсы болды.
Dialogue: 0,0:11:11.88,0:11:12.28,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:11:14.49,0:11:19.09,ZWDB,,0000,0000,0000,,Денемді қара жалын өртеп, ғашық...
Dialogue: 0,0:11:22.91,0:11:24.60,ZWDB,,0000,0000,0000,,Есептеуді аяқтағаннан кейін мен...
Dialogue: 0,0:11:24.60,0:11:27.64,ZWDB,,0000,0000,0000,,Юта Кейджи
Dialogue: 0,0:11:33.38,0:11:40.16,ZWDB,,0000,0000,0000,,Денемді қара жалын күйдірді, Ғашықтың келісімі қара жалын елшісімен бітеді.
Dialogue: 0,0:11:43.79,0:11:44.31,ZWDB,,0000,0000,0000,,Түсінемін
Dialogue: 0,0:11:51.67,0:11:54.25,ZWDB,,0000,0000,0000,,Бұл жалпы жағдай емес.
Dialogue: 0,0:11:57.31,0:11:58.48,ZWDB,,0000,0000,0000,,Керемет жаңалық
Dialogue: 0,0:11:58.55,0:11:58.98,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:12:00.54,0:12:01.36,ZWDB,,0000,0000,0000,,На Канаме Тецу
Dialogue: 0,0:12:05.64,0:12:06.46,ZWDB,,0000,0000,0000,,Аз ғана саусақпен сөйлесу
Dialogue: 0,0:12:07.38,0:12:08.99,ZWDB,,0000,0000,0000,,Нана Тадаши Пинки саусақ
Dialogue: 0,0:12:09.66,0:12:09.99,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:12:21.74,0:12:22.39,ZWDB,,0000,0000,0000,,Мен тағы келдім
Dialogue: 0,0:12:22.39,0:12:23.81,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:12:23.81,0:12:24.68,ZWDB,,0000,0000,0000,,Хоко камфора
Dialogue: 0,0:12:25.15,0:12:27.41,ZWDB,,0000,0000,0000,,Талапкер және жауапкер
Dialogue: 0,0:12:27.76,0:12:33.05,ZWDB,,0000,0000,0000,,Кек болмау, бар болмау және басқа да бөлінулер
Dialogue: 0,0:12:33.15,0:12:34.27,ZWDB,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:12:35.14,0:12:35.88,ZWDB,,0000,0000,0000,,Менің сізбен әңгімем бар
Dialogue: 0,0:12:55.17,0:12:57.86,ZWDB,,0000,0000,0000,,Бұл дүкеннің шығыс және батыс талғамдары да әртүрлі.
Dialogue: 0,0:13:01.86,0:13:03.52,ZWDB,,0000,0000,0000,,Тілдің дұрыс емес әрекеті
Dialogue: 0,0:13:03.99,0:13:06.01,ZWDB,,0000,0000,0000,,Мен Рокканың мағынасын түсіне алмаймын.
Dialogue: 0,0:13:08.39,0:13:12.10,ZWDB,,0000,0000,0000,,Мен дүкенге барып, мейрамханаға бардым.
Dialogue: 0,0:13:12.82,0:13:13.86,ZWDB,,0000,0000,0000,,Себеп қажет емес.
Dialogue: 0,0:13:14.68,0:13:16.67,ZWDB,,0000,0000,0000,,Бастапқы он гүлдің зиянды әрекеті
Dialogue: 0,0:13:17.17,0:13:18.24,ZWDB,,0000,0000,0000,,Алдыңда мен саған күмәнданамын.
Dialogue: 0,0:13:18.39,0:13:19.18,ZWDB,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:13:20.85,0:13:21.47,ZWDB,,0000,0000,0000,,Күнтізбе
Dialogue: 0,0:13:22.19,0:13:24.90,ZWDB,,0000,0000,0000,,Мен мұны істегім келмейді, бірақ маған Рокка Йошицүне ұнайды...
Dialogue: 0,0:13:28.13,0:13:32.20,ZWDB,,0000,0000,0000,,Үйде тұратын адамның атын білу мүмкін емес.
Dialogue: 0,0:13:33.02,0:13:37.70,ZWDB,,0000,0000,0000,,Сондықтан мен оны ойлап, осында тұрдым.
Dialogue: 0,0:13:38.54,0:13:39.83,ZWDB,,0000,0000,0000,,Сіз алты гүл туралы айтып отырсыз ба?
Dialogue: 0,0:13:40.83,0:13:41.35,ZWDB,,0000,0000,0000,,Оны ләззат ала аласыз
Dialogue: 0,0:13:41.72,0:13:42.52,ZWDB,,0000,0000,0000,,Мен не көріп тұрмын?
Dialogue: 0,0:13:43.31,0:13:45.45,ZWDB,,0000,0000,0000,,Бұл сізге жақсы ма?
Dialogue: 0,0:13:49.90,0:13:54.00,ZWDB,,0000,0000,0000,,Алты гүл әлі өзгерген жоқ...
Dialogue: 0,0:13:54.00,0:13:59.37,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:14:00.19,0:14:03.92,ZWDB,,0000,0000,0000,,Бұрын менің басымнан өткен жалғыз нәрсе – дүниеден озған әкем.
Dialogue: 0,0:14:05.14,0:14:05.56,ZWDB,,0000,0000,0000,,Енді олар жай ғана кішігірім бандиттер тобы
Dialogue: 0,0:14:10.73,0:14:12.49,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:14:12.94,0:14:14.73,ZWDB,,0000,0000,0000,,Ойлау әрекеті
Dialogue: 0,0:14:15.00,0:14:15.25,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:14:16.05,0:14:20.10,ZWDB,,0000,0000,0000,,Егер сізде белгілі бір кездесу болса, келесіні мұқият оқып шығыңыз.
Dialogue: 0,0:14:24.30,0:14:25.81,ZWDB,,0000,0000,0000,,Алты гүлдің толық қорытындысы
Dialogue: 0,0:14:27.06,0:14:30.66,ZWDB,,0000,0000,0000,,Менің көргенім - өзімнің сауыт-сайманым.
Dialogue: 0,0:14:32.03,0:14:35.16,ZWDB,,0000,0000,0000,,Rokukaen растау айқын меншік жағдайлары
Dialogue: 0,0:14:36.08,0:14:39.86,ZWDB,,0000,0000,0000,,Бұл жай ғана табиғи емес сезім, сондықтан оған тұрарлық емес.
Dialogue: 0,0:14:40.88,0:14:43.81,ZWDB,,0000,0000,0000,,Таңдалған мүсін – таңдалғанның өмірі.
Dialogue: 0,0:14:44.31,0:14:44.80,ZWDB,,0000,0000,0000,,Қорғаныс киім
Dialogue: 0,0:14:45.47,0:14:46.22,ZWDB,,0000,0000,0000,,Мен кінәсізмін
Dialogue: 0,0:14:47.39,0:14:50.37,ZWDB,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:14:51.44,0:14:55.64,ZWDB,,0000,0000,0000,,Он гүлді алған жеріңіз туралы әңгімеден кейін мен бәрін қабылдадым.
Dialogue: 0,0:14:56.29,0:14:57.18,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:14:57.88,0:15:02.70,ZWDB,,0000,0000,0000,,Зұлым патшаның шынайы көздерінің мәні жоқ.
Dialogue: 0,0:15:04.07,0:15:05.78,ZWDB,,0000,0000,0000,,Оны қайта көру мүмкін емес.
Dialogue: 0,0:15:06.53,0:15:07.12,ZWDB,,0000,0000,0000,,Осы дискідегі ақпарат Неапольде пойызға мініп жатқан кезде жазылды.
Dialogue: 0,0:15:07.74,0:15:10.50,ZWDB,,0000,0000,0000,,Бекіту сұрағына қандай жауап береді?
Dialogue: 0,0:15:11.45,0:15:14.43,ZWDB,,0000,0000,0000,,​​Шығыс пен Батысты қайдан таба аламын?
Dialogue: 0,0:15:15.32,0:15:16.00,ZWDB,,0000,0000,0000,,Енді олар жай ғана кішігірім бандиттер тобы
Dialogue: 0,0:15:16.82,0:15:21.69,ZWDB,,0000,0000,0000,,Сіз бұған жауапты емессіз.
Dialogue: 0,0:15:37.39,0:15:41.12,ZWDB,,0000,0000,0000,,Жақсы таңдау
Dialogue: 0,0:15:42.91,0:15:44.43,ZWDB,,0000,0000,0000,,Жақсы қабылдау
Dialogue: 0,0:15:45.42,0:15:50.12,ZWDB,,0000,0000,0000,,Қазір қай жерде екеніңізді көрсететін тағы бір көрініс - әйел жолда келе жатқан кезде.
Dialogue: 0,0:15:50.12,0:15:51.96,ZWDB,,0000,0000,0000,,Мен тағы да таң қалдым да, кетіп қалдым.
Dialogue: 0,0:15:52.21,0:15:56.58,ZWDB,,0000,0000,0000,,Онда осылай делінген.
Dialogue: 0,0:15:56.58,0:15:58.15,ZWDB,,0000,0000,0000,,Өз жұмысыңызды тыңдай аласыз.
Dialogue: 0,0:15:58.32,0:16:00.48,ZWDB,,0000,0000,0000,,Әңгіменің шығу тегі Kotoryu Dougakuwa Togashi Dougaku 3
Dialogue: 0,0:16:00.83,0:16:02.12,ZWDB,,0000,0000,0000,,Бұл киім ауыстыру.
Dialogue: 0,0:16:02.67,0:16:05.65,ZWDB,,0000,0000,0000,,Жақсы нүкте.
Dialogue: 0,0:16:05.83,0:16:08.84,ZWDB,,0000,0000,0000,,Саған арналған қойылымды көргенде, қонағың жат елден келе жатқанын көрдім.
Dialogue: 0,0:16:09.63,0:16:11.05,ZWDB,,0000,0000,0000,,Бұл Мори ересек адамы
Dialogue: 0,0:16:11.20,0:16:12.41,ZWDB,,0000,0000,0000,,Ересектер үшін тағы бір айқай...
Dialogue: 0,0:16:13.14,0:16:14.87,ZWDB,,0000,0000,0000,,Сузуки Сато
Dialogue: 0,0:16:15.17,0:16:20.12,ZWDB,,0000,0000,0000,,716 жаста, осы жылы орта мектептегі өнер көрсеткеннен кейін бірінші рет қаралды ма?
Dialogue: 0,0:16:20.64,0:16:22.06,ZWDB,,0000,0000,0000,,Сізде қазір кесіртке бар ма?
Dialogue: 0,0:16:23.72,0:16:28.57,ZWDB,,0000,0000,0000,,Сатоның ерні - бұйра, күлгін киім және ауру бала.
Dialogue: 0,0:16:29.59,0:16:32.45,ZWDB,,0000,0000,0000,,Сато және оның отбасы туралы әңгіме
Dialogue: 0,0:16:33.29,0:16:36.72,ZWDB,,0000,0000,0000,,Бұрын «Мен перімін» деген дұрыс емес деп айтылды.
Dialogue: 0,0:16:37.32,0:16:38.19,ZWDB,,0000,0000,0000,,Нада бұл...
Dialogue: 0,0:16:38.44,0:16:39.73,ZWDB,,0000,0000,0000,,Пері оқиғасы...
Dialogue: 0,0:16:40.60,0:16:45.87,ZWDB,,0000,0000,0000,,Chuunibyou қара тарихының өзара аудармасы шынымен қауіпті, мүлдем заңсыз `` экспозициялық кездесу '' бар, бірақ ішкі сот радиацияға ұшырады.
Dialogue: 0,0:16:46.37,0:16:52.78,ZWDB,,0000,0000,0000,,Кеше... Кеше байлығымнан айырылып, жеңдім.
Dialogue: 0,0:16:53.47,0:16:58.52,ZWDB,,0000,0000,0000,,Қазір менде қоңырауды ұстау күші төрт есе артық.
Dialogue: 0,0:17:00.63,0:17:01.68,ZWDB,,0000,0000,0000,,Ауыр... өлі
Dialogue: 0,0:17:01.85,0:17:03.71,ZWDB,,0000,0000,0000,,Сен нағыз адамсың.
Dialogue: 0,0:17:08.11,0:17:11.14,ZWDB,,0000,0000,0000,,Бекіту сұрағы қандай жауап береді?
Dialogue: 0,0:17:12.41,0:17:17.46,ZWDB,,0000,0000,0000,,Сіз бұған жауапты емессіз.
Dialogue: 0,0:17:22.30,0:17:24.69,ZWDB,,0000,0000,0000,,Юта Косуке
Dialogue: 0,0:17:24.69,0:17:25.83,ZWDB,,0000,0000,0000,,Көздің нұры
Dialogue: 0,0:17:26.21,0:17:31.13,ZWDB,,0000,0000,0000,,Ютаның «Қараңғыда жалын ұстап жоғалуы».
Dialogue: 0,0:17:31.80,0:17:32.32,ZWDB,,0000,0000,0000,,Ешқандай талант қажет емес
Dialogue: 0,0:17:32.64,0:17:33.96,ZWDB,,0000,0000,0000,,Бірдей функцияны орындау міндетті емес.
Dialogue: 0,0:17:34.66,0:17:36.12,ZWDB,,0000,0000,0000,,Мен осылай дедім.
Dialogue: 0,0:17:38.01,0:17:39.93,ZWDB,,0000,0000,0000,,«Қараңғыда ұсталған кезде жоғалып кетті...»
Dialogue: 0,0:17:40.45,0:17:41.89,ZWDB,,0000,0000,0000,,Қол жетпес күштің тамаша сезімі
Dialogue: 0,0:17:42.29,0:17:44.32,ZWDB,,0000,0000,0000,,Бұл жердің шығысы мен батысында ешқандай күш те, күш те жоқ.
Dialogue: 0,0:17:44.70,0:17:49.52,ZWDB,,0000,0000,0000,,Тәртіпсіздік, жамбасын ашу қажет, аздап жала жабу;
Dialogue: 0,0:17:50.07,0:17:50.94,ZWDB,,0000,0000,0000,,Чидо Рио Чидо Рио
Dialogue: 0,0:17:52.20,0:17:54.39,ZWDB,,0000,0000,0000,,«Қараңғыда ұсталып, жоғалып кетті!»
Dialogue: 0,0:17:55.16,0:17:55.76,ZWDB,,0000,0000,0000,,Тағы бір соққы
Dialogue: 0,0:17:56.43,0:17:57.37,ZWDB,,0000,0000,0000,,Жақыннан жасалған көлеңке
Dialogue: 0,0:18:05.72,0:18:09.01,ZWDB,,0000,0000,0000,,Әр адам өз ұстанымына жетті.
Dialogue: 0,0:18:09.38,0:18:12.06,ZWDB,,0000,0000,0000,,Не істеу керектігін білу мүмкін емес.
Dialogue: 0,0:18:15.32,0:18:15.54,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:18:16.34,0:18:17.85,ZWDB,,0000,0000,0000,,Иә? Мен одан шаршадым
Dialogue: 0,0:18:19.89,0:18:20.66,ZWDB,,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:18:23.35,0:18:23.97,ZWDB,,0000,0000,0000,,Кішкентай бас бармақ
Dialogue: 0,0:18:39.85,0:18:40.32,ZWDB,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:18:40.92,0:18:41.34,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:18:41.79,0:18:45.59,ZWDB,,0000,0000,0000,,Рикка мектебіне студенттік саяхат
Dialogue: 0,0:18:46.91,0:18:47.58,ZWDB,,0000,0000,0000,,Бұл адам…
Dialogue: 0,0:18:49.07,0:18:51.33,ZWDB,,0000,0000,0000,,Қазір қайдасың?
Dialogue: 0,0:18:51.80,0:18:55.01,ZWDB,,0000,0000,0000,,Мен бұл жолды қайда аламын?
Dialogue: 0,0:18:57.17,0:18:57.69,ZWDB,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:18:58.44,0:19:01.35,ZWDB,,0000,0000,0000,,Мен дүниеден өттім.
Dialogue: 0,0:19:02.19,0:19:07.49,ZWDB,,0000,0000,0000,,Менің балам қазір тірі, бірақ мен олай ойламаймын.
Dialogue: 0,0:19:19.47,0:19:20.73,ZWDB,,0000,0000,0000,,Бұл менің жауапкершілігім.
Dialogue: 0,0:19:23.54,0:19:24.04,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:19:26.03,0:19:28.36,ZWDB,,0000,0000,0000,,Сіз қайдасыз?
Dialogue: 0,0:19:28.79,0:19:30.68,ZWDB,,0000,0000,0000,,Орындауды бастауға дайындық
Dialogue: 0,0:19:31.22,0:19:34.01,ZWDB,,0000,0000,0000,,Қазіргі уақытта келушілер көп.
Dialogue: 0,0:19:36.47,0:19:36.91,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:19:38.93,0:19:41.19,ZWDB,,0000,0000,0000,,Шегірткелерді жою
Dialogue: 0,0:19:50.01,0:19:55.90,ZWDB,,0000,0000,0000,,Жыл сайынғы таланттар көрмесі бірден басталады және қатысушылар жыл сайынғы таланттар көрмесіне де қатысады.
Dialogue: 0,0:19:58.29,0:20:02.04,ZWDB,,0000,0000,0000,,Бірінші жүлделі қатысушы
Dialogue: 0,0:20:02.29,0:20:06.59,ZWDB,,0000,0000,0000,,№ 1, 2-сынып, 3-сынып, Харута Джинно, Жапониядағы негізгі өнер мектебінің көптен оқитын студенті.
Dialogue: 0,0:20:07.09,0:20:09.03,ZWDB,,0000,0000,0000,,Өнімділік қорытындысы
Dialogue: 0,0:20:09.45,0:20:12.33,ZWDB,,0000,0000,0000,,Мен орта мектептің бала кезінен бастадым.
Dialogue: 0,0:20:13.40,0:20:15.64,ZWDB,,0000,0000,0000,,Шындығында, Ная елден кеткенде, бұл нақты нәрсе.
Dialogue: 0,0:20:16.83,0:20:17.55,ZWDB,,0000,0000,0000,,Кешір
Dialogue: 0,0:20:20.98,0:20:24.36,ZWDB,,0000,0000,0000,,Қазіргі жағдайыңыз қандай?
Dialogue: 0,0:20:25.98,0:20:26.87,ZWDB,,0000,0000,0000,,Жеке жәрдемақы
Dialogue: 0,0:20:29.43,0:20:34.15,ZWDB,,0000,0000,0000,,Жылудың шамалы мөлшері бар, бірақ температура өте аз.
Dialogue: 0,0:20:35.40,0:20:38.50,ZWDB,,0000,0000,0000,,Кескін сонда, жер осы аймақпен жабылған.
Dialogue: 0,0:20:39.47,0:20:40.32,ZWDB,,0000,0000,0000,,Міне, ақпарат
Dialogue: 0,0:20:40.96,0:20:41.63,ZWDB,,0000,0000,0000,,Шындық
Dialogue: 0,0:20:42.26,0:20:45.98,ZWDB,,0000,0000,0000,,No2 1-сынып 4-топ Исшики кан гайодайкан
Dialogue: 0,0:20:48.17,0:20:52.62,ZWDB,,0000,0000,0000,,Мамырдың 7-ші күні Гакушю Гакуэ екеуміз бір-бірімізді кездестірдік.
Dialogue: 0,0:20:53.34,0:20:54.51,ZWDB,,0000,0000,0000,,Кешір мені.
Dialogue: 0,0:20:54.98,0:20:56.51,ZWDB,,0000,0000,0000,,Нана кішкентай құс
Dialogue: 0,0:21:00.10,0:21:00.85,ZWDB,,0000,0000,0000,,Мен кеттім
Dialogue: 0,0:21:02.51,0:21:06.29,ZWDB,,0000,0000,0000,,Тогаши-кун, менің Тоғашымен жақсы тәжірибем бар.
Dialogue: 0,0:21:06.56,0:21:10.04,ZWDB,,0000,0000,0000,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:00:00.00,0:00:00.00,ZWDB,,0000,0000,0000,,Қазіргі уақытта №3 қатысушы
Dialogue: 0,0:21:10.04,0:21:13.95,ZWDB,,0000,0000,0000,,Мен бір жастағы төрт сыныптың кішкентай құсы Ю Риккамын, маған әнді орындау керек
Dialogue: 0,0:21:20.46,0:21:21.70,ZWDB,,0000,0000,0000,,Накая
Dialogue: 0,0:21:18.57,0:21:29.03,ZWDB,,0000,0000,0000,,Түнде аспандағы жұлдыздар
Dialogue: 0,0:21:29.88,0:21:40.07,ZWDB,,0000,0000,0000,,Кішкентай жұлдыздан шыққан кішкентай жарық шоғы
Dialogue: 0,0:21:34.15,0:21:37.48,ZWDB,,0000,0000,0000,,Әкемнің алдында мені қуантқан ән осы.
Dialogue: 0,0:21:40.79,0:21:51.25,ZWDB,,0000,0000,0000,,Ән айтудағы минуттық бақыт
Dialogue: 0,0:23:27.88,0:23:30.94,ZWDB,,0000,0000,0000,,Бұл 1-курс 4-ші топтың кішкентай құстар мен 6 гүлінің қойылымы.
Dialogue: 0,0:23:27.88,0:23:28.63,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:23:31.56,0:23:33.23,ZWDB,,0000,0000,0000,,Өте ризашылық білдіру
Dialogue: 0,0:23:33.75,0:23:36.56,ZWDB,,0000,0000,0000,,Кури Кури мен Кимоно туралы естеліктер
Dialogue: 0,0:23:38.06,0:23:44.06,Default,,0,0,0,,{\\an8\\fs18\\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\\NБарлық құқықтары қорғалған • github.com/ikymory
