Dialogue: 0,0:00:16.06,0:00:21.06,Default,,0000,0000,0000,,
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0000,0000,0000,,

Dialogue: 0,0:00:01.98,0:00:02.98,JPDB,,0000,0000,0000,,Менің қарным ашты
Dialogue: 0,0:00:03.65,0:00:05.39,JPDB,,0000,0000,0000,,Мен сатып алу бөліміне бара жатырмын.
Dialogue: 0,0:00:05.89,0:00:07.00,JPDB,,0000,0000,0000,,Мен бірінші тамақтанып жатырмын.
Dialogue: 0,0:00:08.15,0:00:10.31,JPDB,,0000,0000,0000,,Орта мектеп басталғаннан кейін шамамен бір ай өткен соң
Dialogue: 0,0:00:10.98,0:00:11.53,JPDB,,0000,0000,0000,,Бұл сүйкімді
Dialogue: 0,0:00:11.53,0:00:16.47,JPDB,,0000,0000,0000,,Сыныпта үстемдік еткен алаңдаушылық пен ыңғайсыз шиеленіс бірте-бірте жойылды.
Dialogue: 0,0:00:17.47,0:00:21.77,JPDB,,0000,0000,0000,,Әрбір оқушы сыныпта өзін жайлы сезінетін орын тапты.
Dialogue: 0,0:00:22.41,0:00:25.17,JPDB,,0000,0000,0000,,Сыныптастарынан алшақтық сезімін ала бастау
Dialogue: 0,0:00:26.66,0:00:31.46,JPDB,,0000,0000,0000,,Бұл жігіт Chuunibyou-ның қараңғы жағына қадам басатыны анық.
Dialogue: 0,0:00:32.55,0:00:35.88,JPDB,,0000,0000,0000,,Которию-сан, сіздің түскі қорап әрқашан үлкен.
Dialogue: 0,0:00:36.88,0:00:42.15,JPDB,,0000,0000,0000,,Ұрыс үшін жеткілікті қорлар қажет; сиқырлы күш әлсіресе, өмірге қауіп төнеді.
Dialogue: 0,0:00:45.01,0:00:46.55,JPDB,,0000,0000,0000,,Мен ол кезде тым бұрын болғанмын.
Dialogue: 0,0:00:47.49,0:00:52.76,JPDB,,0000,0000,0000,,Біз шайқаста болғандықтан, тез тамақтануымыз керек.
Dialogue: 0,0:00:54.65,0:00:56.84,JPDB,,0000,0000,0000,,Сол кезде мені ұрды
Dialogue: 0,0:00:58.03,0:00:59.20,JPDB,,0000,0000,0000,,Қандай керемет бенто
Dialogue: 0,0:01:00.14,0:01:04.42,JPDB,,0000,0000,0000,,Біз шайқаста болғандықтан, міндетті түрде тамақтануымыз керек.
Dialogue: 0,0:01:04.72,0:01:05.88,JPDB,,0000,0000,0000,,Бір нәрсені айтпаңыз
Dialogue: 0,0:01:06.98,0:01:08.15,JPDB,,0000,0000,0000,,Сіз оны орындадыңыз ба?
Dialogue: 0,0:01:08.69,0:01:09.64,JPDB,,0000,0000,0000,,Діни қызметкер
Dialogue: 0,0:01:11.33,0:01:14.61,JPDB,,0000,0000,0000,,Тука-сан, сыртқы түріне қарамастан, ол жақсы аспаз.
Dialogue: 0,0:01:15.10,0:01:18.06,JPDB,,0000,0000,0000,,Эй, мен саған айтамын, бұл көрінгендей емес.
Dialogue: 0,0:01:18.41,0:01:19.53,JPDB,,0000,0000,0000,,Маған айтудың қажеті жоқ.
Dialogue: 0,0:01:23.01,0:01:29.45,JPDB,,0000,0000,0000,,Өзінің шынайы болмысын жасыру үшін діни қызметкер шынайы әлемде аспаз болып жұмыс істейді.
Dialogue: 0,0:01:31.16,0:01:33.74,JPDB,,0000,0000,0000,,Осындай біреу жасаған бенто керемет болар еді...
Dialogue: 0,0:01:34.86,0:01:39.14,JPDB,,0000,0000,0000,,Қызыл жемістер сиқырды төмендетеді, бұл әсіресе қауіпті.
Dialogue: 0,0:01:39.81,0:01:41.45,JPDB,,0000,0000,0000,,Демек, бұл сізге ұнамайды ма?
Dialogue: 0,0:01:41.65,0:01:44.48,JPDB,,0000,0000,0000,,Әсіресе бұл жасыл елел бөлігі ең нашар.
Dialogue: 0,0:01:45.30,0:01:49.35,JPDB,,0000,0000,0000,,Бұны жеу құбыжық жұмыртқасы шығар.
Dialogue: 0,0:01:49.95,0:01:51.44,JPDB,,0000,0000,0000,,Томат фермерлерінен кешірім сұраңыз
Dialogue: 0,0:01:53.38,0:01:55.39,JPDB,,0000,0000,0000,,Күріш бөлігінде эрозия бар.
Dialogue: 0,0:02:00.41,0:02:02.87,JPDB,,0000,0000,0000,,Оған көмектесу мүмкін емес, мен оны жеймін.
Dialogue: 0,0:02:08.74,0:02:09.66,JPDB,,0000,0000,0000,,Ой, аралы тен
Dialogue: 0,0:02:16.62,0:02:19.97,JPDB,,0000,0000,0000,,Бұл шын мәнінде менің айтып тұрғаным емес.
Dialogue: 0,0:02:27.31,0:02:28.08,JPDB,,0000,0000,0000,,өлім
Dialogue: 0,0:04:09.70,0:04:11.97,JPDB,,0000,0000,0000,,Келесі кезекте каратэ клубының үлгі биі.
Dialogue: 0,0:04:13.56,0:04:16.56,JPDB,,0000,0000,0000,,Йойо, Юта не істейді? Клубтық іс-шаралар
Dialogue: 0,0:04:17.71,0:04:19.80,JPDB,,0000,0000,0000,,Қалай болғанда да сіз барлық жердесіз
Dialogue: 0,0:04:20.39,0:04:23.18,JPDB,,0000,0000,0000,,Мен басынан бері жеңіл музыка клубында болдым.
Dialogue: 0,0:04:24.57,0:04:26.28,JPDB,,0000,0000,0000,,Сізге музыка ұнады.
Dialogue: 0,0:04:26.38,0:04:30.81,JPDB,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Музыканы жақсы көретін, жеңіл музыка үйірмесіне қатысатын жігіт қайда?
Dialogue: 0,0:04:31.58,0:04:35.28,JPDB,,0000,0000,0000,,Рок не үшін қажет? Электр гитара не үшін керек?
Dialogue: 0,0:04:36.08,0:04:40.65,JPDB,,0000,0000,0000,,Иә, мен танымал болдым. Менің ойымша, бұл әйелдер арасында танымал болу.
Dialogue: 0,0:04:40.92,0:04:45.47,JPDB,,0000,0000,0000,,Бұл көп теріс пікір. Әлде менде танымал емес деген комплекс бар деуім керек пе?
Dialogue: 0,0:04:46.07,0:04:47.04,JPDB,,0000,0000,0000,,Дамасшай
Dialogue: 0,0:04:47.04,0:04:47.66,JPDB,,0000,0000,0000,,Өте ыстық...
Dialogue: 0,0:04:47.88,0:04:51.66,JPDB,,0000,0000,0000,,Мен орта мектептегі бейсбол командасының қырылған басынан құтылып, осы уақытқа дейін жеттім.
Dialogue: 0,0:04:52.16,0:04:54.86,JPDB,,0000,0000,0000,,Екі айдан кейін менің иығымда гитара, оң қолымда дос қызым бар.
Dialogue: 0,0:04:55.14,0:04:59.04,JPDB,,0000,0000,0000,,Мен сол жақта мені таң қалдыратын тағы бір қызды көріп тұрмын.
Dialogue: 0,0:04:59.66,0:05:01.50,JPDB,,0000,0000,0000,,Клуб қызметі?
Dialogue: 0,0:05:11.44,0:05:16.04,JPDB,,0000,0000,0000,,​​«Аяқтағаннан кейін кездесу нүктесі: өлі жапырақтардың қабір белгісіне, Рикка».
Dialogue: 0,0:05:19.05,0:05:21.73,JPDB,,0000,0000,0000,,«Мен білмеймін».
Dialogue: 0,0:05:36.72,0:05:38.73,JPDB,,0000,0000,0000,,Сіз қандай мойындауды күтіп отырсыз?
Dialogue: 0,0:05:40.20,0:05:41.32,JPDB,,0000,0000,0000,,Оны қару ретінде қолдануға болатын сияқты
Dialogue: 0,0:05:43.73,0:05:45.47,JPDB,,0000,0000,0000,,Мұның мәні неде?
Dialogue: 0,0:05:46.54,0:05:50.86,JPDB,,0000,0000,0000,,Уақыт шектеулі, сондықтан мені тыңдауларыңызды қалаймын, өйткені мен сізге тікелей айтқым келеді.
Dialogue: 0,0:05:51.38,0:05:54.51,JPDB,,0000,0000,0000,,Біз осы мектепте базамызды құрғымыз келеді.
Dialogue: 0,0:05:55.16,0:05:55.86,JPDB,,0000,0000,0000,,Негіз?
Dialogue: 0,0:05:56.48,0:05:58.91,JPDB,,0000,0000,0000,,Мен жаңа клуб құруды ойлап жүрмін.
Dialogue: 0,0:06:03.24,0:06:07.71,JPDB,,0000,0000,0000,,Бұл шындыққа жанаспайтыны сонша, мен оны түсіне алмадым. Сіз мұны қайталай аласыз ба?
Dialogue: 0,0:06:08.26,0:06:09.45,JPDB,,0000,0000,0000,,Петеробиа Банисте
Dialogue: 0,0:06:10.69,0:06:14.17,JPDB,,0000,0000,0000,,Кешіріңіз, мен параллель дүниедегі сөздерді қолдандым.
Dialogue: 0,0:06:14.17,0:06:18.42,JPDB,,0000,0000,0000,,Бұл дүниенің жазуымен айна жазу қатынасы бар тіл...
Dialogue: 0,0:06:18.50,0:06:21.51,JPDB,,0000,0000,0000,,Мен ақымақ түсініктемелерге қарсы емеспін. Сіз не айттыңыз?
Dialogue: 0,0:06:21.83,0:06:26.23,JPDB,,0000,0000,0000,,Біз осы мектепте өзіміздің іс-әрекетіміздің негізі ретінде клуб құрамыз.
Dialogue: 0,0:06:29.04,0:06:30.55,JPDB,,0000,0000,0000,,Бұл атау
Dialogue: 0,0:06:31.20,0:06:35.57,JPDB,,0000,0000,0000,,«Қиыр Шығыс сиқырлы қоғамы»
Dialogue: 0,0:06:40.40,0:06:41.29,JPDB,,0000,0000,0000,,Мұнда Он екі Құбыжық Айдың тек Төменгі Айлары ғана жиналған
Dialogue: 0,0:06:46.63,0:06:47.13,JPDB,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:06:47.35,0:06:48.77,JPDB,,0000,0000,0000,,Қалыпты тоқтаңыз.
Dialogue: 0,0:06:49.02,0:06:51.26,JPDB,,0000,0000,0000,,Әзірге атыңызды осында қойыңыз.
Dialogue: 0,0:06:53.42,0:06:54.49,JPDB,,0000,0000,0000,,Мен оны жазамын деп ойлайсыз ба?
Dialogue: 0,0:06:55.58,0:07:04.68,JPDB,,0000,0000,0000,,Мен көремін. Менің таңдауым жоқ. Мен менеджердің орынбасары бола аламын. Юта менеджер болуы керек.
Dialogue: 0,0:07:05.05,0:07:09.67,JPDB,,0000,0000,0000,,Бұл емес. Ол жерге сыйатын басқа біреу бар ма?
Dialogue: 0,0:07:10.39,0:07:11.67,JPDB,,0000,0000,0000,,Онда уайымдамаңыз
Dialogue: 0,0:07:16.76,0:07:20.46,JPDB,,0000,0000,0000,,Неге ешкім қызық емес
Dialogue: 0,0:07:20.76,0:07:21.73,JPDB,,0000,0000,0000,,Әрине.
Dialogue: 0,0:07:23.19,0:07:29.83,JPDB,,0000,0000,0000,,Шекара бақылау бюросындағы сиқыршылар диверсия жасап жатыр деп ойлауымыз керек пе?
Dialogue: 0,0:07:30.08,0:07:33.11,JPDB,,0000,0000,0000,,Тоқта, адамдар сенен қашып жатыр.
Dialogue: 0,0:07:35.03,0:07:36.47,JPDB,,0000,0000,0000,,Бұл бір нәрсе
Dialogue: 0,0:07:39.30,0:07:41.24,JPDB,,0000,0000,0000,,Юта мұны маған қалдырыңыз
Dialogue: 0,0:07:41.54,0:07:42.73,JPDB,,0000,0000,0000,,Тым ұялшақ шығар
Dialogue: 0,0:07:43.55,0:07:44.37,JPDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:07:45.14,0:07:47.33,JPDB,,0000,0000,0000,,Менің Джау Шингансенім бойынша
Dialogue: 0,0:07:47.70,0:07:48.60,JPDB,,0000,0000,0000,,«Зұлым патша»?
Dialogue: 0,0:07:49.32,0:07:52.05,JPDB,,0000,0000,0000,,Мен сенен жағымсыз сезім сезіндім
Dialogue: 0,0:07:53.79,0:07:56.20,JPDB,,0000,0000,0000,,Бізге оны қуу үшін қараңғылықтың күші керек.
Dialogue: 0,0:07:56.80,0:08:01.02,JPDB,,0000,0000,0000,,Осы «Қиыр Шығыс сиқырлы қоғамына» қосылды және «Джау Шинген» күшімен...
Dialogue: 0,0:08:01.74,0:08:04.20,JPDB,,0000,0000,0000,,Ол толығымен шықты. Қандай айла?
Dialogue: 0,0:08:05.12,0:08:09.08,JPDB,,0000,0000,0000,,Кешіріңіз. Мұның бәрі ақымақтық. Мен шынымен кешірім сұраймын.
Dialogue: 0,0:08:10.54,0:08:13.95,JPDB,,0000,0000,0000,,Таку Сенпай
Dialogue: 0,0:08:15.81,0:08:17.23,JPDB,,0000,0000,0000,,Қандай кездейсоқтық.
Dialogue: 0,0:08:18.22,0:08:19.14,JPDB,,0000,0000,0000,,«Ұйқы клубы»?
Dialogue: 0,0:08:19.61,0:08:25.53,JPDB,,0000,0000,0000,,Иә, сізді қызықтырады ма? Ұйықтау жақсы. Бұл қызық.
Dialogue: 0,0:08:25.88,0:08:28.44,JPDB,,0000,0000,0000,,Жоқ, мені ерекше қызықтырмайды...
Dialogue: 0,0:08:30.20,0:08:34.43,JPDB,,0000,0000,0000,,Барлығы да сондай. Өткен жылы да жасауға тырыстым.
Dialogue: 0,0:08:34.82,0:08:37.88,JPDB,,0000,0000,0000,,Неге екені белгісіз, адамдар жиналмайды.
Dialogue: 0,0:08:38.18,0:08:39.02,JPDB,,0000,0000,0000,,Менің жастығым
Dialogue: 0,0:08:40.69,0:08:45.04,JPDB,,0000,0000,0000,,Иә, бүгін күн ашық, сондықтан көктемнің шуақты күніне арналған жастық.
Dialogue: 0,0:08:45.56,0:08:48.22,JPDB,,0000,0000,0000,,Осы арқылы мен шабындықтарды армандаймын.
Dialogue: 0,0:08:49.46,0:08:50.22,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:08:56.12,0:08:58.71,JPDB,,0000,0000,0000,,Адамдардың маған жақындауы қиындап кеткен сияқты.
Dialogue: 0,0:08:59.88,0:09:01.99,JPDB,,0000,0000,0000,,Барлығы жасыл
Dialogue: 0,0:09:02.98,0:09:05.05,JPDB,,0000,0000,0000,,Сіз шынымен қарап тұрсыз ба? шалғындық арман
Dialogue: 0,0:09:06.56,0:09:10.79,JPDB,,0000,0000,0000,,Жағдайдың жақсармауының себебі мұндағы сиқырлы коэффициентке байланысты.
Dialogue: 0,0:09:10.79,0:09:11.38,JPDB,,0000,0000,0000,,Нибутани…
Dialogue: 0,0:09:12.38,0:09:13.67,JPDB,,0000,0000,0000,,Мен біраз уақытқа ваннаға барамын.
Dialogue: 0,0:09:15.78,0:09:18.24,JPDB,,0000,0000,0000,,Бұл көрініс, бұл сөзсіз
Dialogue: 0,0:09:19.51,0:09:21.15,JPDB,,0000,0000,0000,,Барлығыңыз, өзіңізді қатты итермеуге тырысыңыз.
Dialogue: 0,0:09:21.43,0:09:21.75,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:09:22.27,0:09:24.18,JPDB,,0000,0000,0000,,Келдің бе? Мен сені келер деп ойладым.
Dialogue: 0,0:09:24.38,0:09:25.68,JPDB,,0000,0000,0000,,Неге мұндасың?
Dialogue: 0,0:09:26.27,0:09:32.04,JPDB,,0000,0000,0000,,Морика Нибутани черлидинг клубына сынақ мерзіміне қосылады. Ол мұндай сирек кездесетін оқиғаны өткізіп жіберуі мүмкін бе?
Dialogue: 0,0:09:32.46,0:09:36.26,JPDB,,0000,0000,0000,,Қараңдаршы, бізді көруге кездейсоқ келген сыныптағы бала мен бала.
Dialogue: 0,0:09:38.33,0:09:40.27,JPDB,,0000,0000,0000,,Нибутани танымал, солай емес пе?
Dialogue: 0,0:09:40.49,0:09:46.78,JPDB,,0000,0000,0000,,Әрине, сыныптағы барлық ұлдар «Сүйкімді қыздар чемпионатында» бірінші орынға дауыс берді.
Dialogue: 0,0:09:47.42,0:09:48.59,JPDB,,0000,0000,0000,,Бірінші нөмір... иә?
Dialogue: 0,0:09:54.08,0:09:55.10,JPDB,,0000,0000,0000,,Жоқ, сен
Dialogue: 0,0:09:55.75,0:10:00.02,JPDB,,0000,0000,0000,,Жоқ, жоқ, бұл шындық болуы мүмкін емес. Көзіміз түйісіп қалды.
Dialogue: 0,0:10:01.37,0:10:04.42,JPDB,,0000,0000,0000,,Которию-сан да, бұл бақыт.
Dialogue: 0,0:10:05.02,0:10:06.26,JPDB,,0000,0000,0000,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,0:10:07.06,0:10:12.58,JPDB,,0000,0000,0000,,Мен оның черлидер ретінде секіргісі келетінін естідім.
Dialogue: 0,0:10:13.02,0:10:16.50,JPDB,,0000,0000,0000,,Егер мен жаңа студент екенімді айтсам, маған тырысуға рұқсат бересіз бе?
Dialogue: 0,0:10:16.90,0:10:18.22,JPDB,,0000,0000,0000,,Бұл шынымен жақсы ма?
Dialogue: 0,0:10:19.04,0:10:21.70,JPDB,,0000,0000,0000,,Көрінбейтін шекара үшін шайқаста
Dialogue: 0,0:10:21.70,0:10:26.25,JPDB,,0000,0000,0000,,Ол сол дүниеде бірнеше мың метр биіктікте ұшып жүрген.
Dialogue: 0,0:10:26.47,0:10:27.19,JPDB,,0000,0000,0000,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:10:27.39,0:10:29.03,JPDB,,0000,0000,0000,,Бұл бала не айтып тұр?
Dialogue: 0,0:10:29.03,0:10:34.37,JPDB,,0000,0000,0000,,Енді... қалай секіреміз? Бұл жұмыс істемейтін сияқты ма?
Dialogue: 0,0:10:35.86,0:10:36.81,JPDB,,0000,0000,0000,,Капипа
Dialogue: 0,0:10:43.64,0:10:44.69,JPDB,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:10:44.99,0:10:46.82,JPDB,,0000,0000,0000,,Иә... Менің қолымнан келеді.
Dialogue: 0,0:10:47.17,0:10:48.19,JPDB,,0000,0000,0000,,Жылап жатқан жоқсың ба?
Dialogue: 0,0:10:49.51,0:10:50.35,JPDB,,0000,0000,0000,,Капипа
Dialogue: 0,0:10:50.45,0:10:51.40,JPDB,,0000,0000,0000,,Өте жаман
Dialogue: 0,0:10:53.81,0:10:57.46,JPDB,,0000,0000,0000,,Бұл жерден өтуіне жол бермеңіз. Менің толқындарымды же.
Dialogue: 0,0:10:57.61,0:10:58.61,JPDB,,0000,0000,0000,,Бұл драма клубы.
Dialogue: 0,0:11:03.03,0:11:07.70,JPDB,,0000,0000,0000,,10 жыл бойы көрмеген анамның жағдайы ауыр. Өтінемін, оны сонда апарыңыз.
Dialogue: 0,0:11:07.85,0:11:09.09,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:11:09.52,0:11:10.76,JPDB,,0000,0000,0000,,"Этюд" деңіз
Dialogue: 0,0:11:11.31,0:11:14.71,JPDB,,0000,0000,0000,,Актерлік шеберлік аясын кеңейту үшін импровизациялық театр тәжірибесі.
Dialogue: 0,0:11:15.16,0:11:22.02,JPDB,,0000,0000,0000,,Бұл жалғыз көпір. Ені бір адамға ғана жететін жалғыз көпірдің екі жағынан да адамдар келе жатыр.
Dialogue: 0,0:11:22.56,0:11:26.37,JPDB,,0000,0000,0000,,Сонымен, жарнамалау арқылы сіз басқа адамға жол беруге тырысасыз.
Dialogue: 0,0:11:27.11,0:11:29.18,JPDB,,0000,0000,0000,,Қарсыласыңызды жалтарып жібере алсаңыз, жеңесіз.
Dialogue: 0,0:11:30.94,0:11:34.27,JPDB,,0000,0000,0000,,Осы жерден өткің келсе, бармай тұрып мені жең.
Dialogue: 0,0:11:35.14,0:11:36.23,JPDB,,0000,0000,0000,,Мен саған айтқан жоқпын
Dialogue: 0,0:11:38.42,0:11:39.04,JPDB,,0000,0000,0000,,Оны қолданып көргіңіз келе ме?
Dialogue: 0,0:11:40.11,0:11:42.35,JPDB,,0000,0000,0000,,Кешіріңіз, оны маған бере аласыз ба?
Dialogue: 0,0:11:42.87,0:11:45.90,JPDB,,0000,0000,0000,,Егер асықпасақ, ол мінген ұшақ жоқ болады.
Dialogue: 0,0:11:46.13,0:11:50.00,JPDB,,0000,0000,0000,,Егер мен қазір өз сезімімді білдірмесем, ақыры бір-бірімізден айырылып қаламыз.
Dialogue: 0,0:11:50.33,0:11:51.82,JPDB,,0000,0000,0000,,Қоқыс
Dialogue: 0,0:11:58.65,0:12:00.47,JPDB,,0000,0000,0000,,Бұл аю, тез қаш.
Dialogue: 0,0:12:00.91,0:12:04.42,JPDB,,0000,0000,0000,,Оны осы «Зұлым лорд Шинганмен» жеңейік.
Dialogue: 0,0:12:05.69,0:12:06.31,JPDB,,0000,0000,0000,,Ум...
Dialogue: 0,0:12:07.18,0:12:12.12,JPDB,,0000,0000,0000,,«Шварцсех прототипі Mk-II»
Dialogue: 0,0:12:15.70,0:12:18.66,JPDB,,0000,0000,0000,,Осы жерден өтсең, мені жең.
Dialogue: 0,0:12:18.71,0:12:21.17,JPDB,,0000,0000,0000,,“Қараңғы заттың жалыны”
Dialogue: 0,0:12:23.18,0:12:24.33,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:12:25.10,0:12:28.53,JPDB,,0000,0000,0000,,Мен мұндай жерде жарық бар екеніне сене алмадым.
Dialogue: 0,0:12:29.55,0:12:31.01,JPDB,,0000,0000,0000,,Одан аулақ болайын ба?
Dialogue: 0,0:12:33.97,0:12:34.74,JPDB,,0000,0000,0000,,Эй...
Dialogue: 0,0:12:39.99,0:12:40.56,JPDB,,0000,0000,0000,,Серпіліс
Dialogue: 0,0:12:40.78,0:12:41.18,JPDB,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:12:42.99,0:12:45.65,JPDB,,0000,0000,0000,,Мен басқа бөлімдерге қарағанда жақсы екенімді баса көрсетуге тырыстым.
Dialogue: 0,0:12:46.00,0:12:47.81,JPDB,,0000,0000,0000,,Адамдар жиналмайды
Dialogue: 0,0:12:48.19,0:12:48.76,JPDB,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:12:49.43,0:12:50.37,JPDB,,0000,0000,0000,,Әрине
Dialogue: 0,0:12:50.72,0:12:53.71,JPDB,,0000,0000,0000,,Менде солай атаудан басқа амалым қалмады.
Dialogue: 0,0:12:54.50,0:12:56.69,JPDB,,0000,0000,0000,,Рикка-сан, сенің мақсатың бар ма?
Dialogue: 0,0:12:57.01,0:13:02.78,JPDB,,0000,0000,0000,,Бұл менмін. Ватиканның сиқырлы қоғамының бұйрығымен кардинал алға жылжыды.
Dialogue: 0,0:13:03.03,0:13:05.86,JPDB,,0000,0000,0000,,Жағдай нашарласа, дереу бізге хабарласыңыз.
Dialogue: 0,0:13:05.98,0:13:08.84,JPDB,,0000,0000,0000,,Сіз жай ғана untarakantara анық айттыңыз.
Dialogue: 0,0:13:09.71,0:13:11.18,JPDB,,0000,0000,0000,,Ертең бізге қосылыңыз
Dialogue: 0,0:13:11.60,0:13:13.27,JPDB,,0000,0000,0000,,Менде тек жаман сезім бар
Dialogue: 0,0:13:27.41,0:13:28.58,JPDB,,0000,0000,0000,,Мен кенеттен кешірім сұраймын.
Dialogue: 0,0:13:28.87,0:13:31.11,JPDB,,0000,0000,0000,,Не болды? Әңгіме қандай?
Dialogue: 0,0:13:31.51,0:13:34.57,JPDB,,0000,0000,0000,,Мен мұны тек бір рет айтамын, себебі бұл ұят.
Dialogue: 0,0:13:35.14,0:13:38.12,JPDB,,0000,0000,0000,,Мен Тогаши-кун туралы ойлаймын...
Dialogue: 0,0:13:38.49,0:13:39.39,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:13:41.20,0:13:46.22,JPDB,,0000,0000,0000,,Мен...о...жақсы көремін!
Dialogue: 0,0:13:48.24,0:13:53.85,JPDB,,0000,0000,0000,,Бұл қытық Бұл қытық Мен түсіндім мен түсінемін
Dialogue: 0,0:13:55.47,0:13:59.44,JPDB,,0000,0000,0000,,Ақырында оралған сияқтысыз, Қараңғы жалын шебері.
Dialogue: 0,0:14:01.21,0:14:02.23,JPDB,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:14:03.25,0:14:07.62,JPDB,,0000,0000,0000,,Біреудің атын сұраған кезде, оның өзі айтқанша күтіңіз.
Dialogue: 0,0:14:07.62,0:14:11.18,JPDB,,0000,0000,0000,,Өлім айтасың, Өзін Өлім деп атайтын Өлім.
Dialogue: 0,0:14:11.18,0:14:11.82,JPDB,,0000,0000,0000,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:14:11.82,0:14:13.82,JPDB,,0000,0000,0000,,Бұған дейін шешіңіз.
Dialogue: 0,0:14:14.66,0:14:19.00,JPDB,,0000,0000,0000,,Рикка Коториюдің бірінші қызметшісі, «Зұлым патша шынайы көзді» пайдаланушы
Dialogue: 0,0:14:19.20,0:14:24.55,JPDB,,0000,0000,0000,,“Myrnir Hammer” Sanae Dekomori пайдаланушысы осы жерде ұсынылады
Dialogue: 0,0:14:26.06,0:14:26.81,JPDB,,0000,0000,0000,,Үйге қайт
Dialogue: 0,0:14:26.98,0:14:28.81,JPDB,,0000,0000,0000,,Бұл менің қызметшім
Dialogue: 0,0:14:29.19,0:14:33.35,JPDB,,0000,0000,0000,,Ютаның санасын басқару бюросының сиқыры тоздырды.
Dialogue: 0,0:14:34.07,0:14:37.10,JPDB,,0000,0000,0000,,Мен кейде оғаш әрекет жасаймын, бірақ мені кешіріңіз.
Dialogue: 0,0:14:37.35,0:14:41.30,JPDB,,0000,0000,0000,,Солай ма? Сізде кәдімгі адамның шірік көздері бар екені сөзсіз.
Dialogue: 0,0:14:41.65,0:14:43.01,JPDB,,0000,0000,0000,,Бәрібір сені атып тастауым керек пе?
Dialogue: 0,0:14:43.26,0:14:46.62,JPDB,,0000,0000,0000,,Жүрегіңді тазартамын.
Dialogue: 0,0:14:46.62,0:14:51.32,JPDB,,0000,0000,0000,,«Мирнир торнадо»
Dialogue: 0,0:14:56.91,0:14:57.93,JPDB,,0000,0000,0000,,Мен қозғала алмаймын
Dialogue: 0,0:14:58.30,0:15:01.60,JPDB,,0000,0000,0000,,Ақымақ, бұл жігіт шын.
Dialogue: 0,0:15:02.55,0:15:05.08,JPDB,,0000,0000,0000,,Сонымен параллель әлем
Dialogue: 0,0:15:05.43,0:15:08.17,JPDB,,0000,0000,0000,,Соғыс күшейе түскен сайын,
Dialogue: 0,0:15:08.39,0:15:12.49,JPDB,,0000,0000,0000,,Декомори да мүмкіндігінше шайқасқа қатысып жатырмын деп ойлады.
Dialogue: 0,0:15:12.89,0:15:14.98,JPDB,,0000,0000,0000,,Жол бойы келгенім үшін кешірім сұраймын.
Dialogue: 0,0:15:15.27,0:15:19.23,JPDB,,0000,0000,0000,,Дегенмен, бұл көрінбейтін шекараларды ашу үшін де маңызды.
Dialogue: 0,0:15:19.80,0:15:22.68,JPDB,,0000,0000,0000,,Тыңдашы, екеуміз бірге болсақ, бізде мына ақымақ әңгіме болады...
Dialogue: 0,0:15:23.80,0:15:26.21,JPDB,,0000,0000,0000,,Сіз менің орта мектебім үшін сол формадасыз ба?
Dialogue: 0,0:15:27.68,0:15:31.08,JPDB,,0000,0000,0000,,«Екінші балалар» мен «Үшінші балалар» бір жылғы.
Dialogue: 0,0:15:31.73,0:15:33.34,JPDB,,0000,0000,0000,,Неліктен сонша бақытты көрінесіз?
Dialogue: 0,0:15:33.89,0:15:38.56,JPDB,,0000,0000,0000,,Мен Декомориді екі жыл бұрын Электр мұхитында кездестірдім.
Dialogue: 0,0:15:39.08,0:15:43.06,JPDB,,0000,0000,0000,,Ол менің бұрынғы өмірдегі қызметшім болып шықты.
Dialogue: 0,0:15:43.16,0:15:45.40,JPDB,,0000,0000,0000,,Мәселе мынада, біз желіде кездестік.
Dialogue: 0,0:15:45.52,0:15:50.05,JPDB,,0000,0000,0000,,Мен Декомориден өзімнің "Қиыр Шығыс сиқырлы ұйықтау қоғамына" қосылуын сұраймын.
Dialogue: 0,0:15:50.79,0:15:55.61,JPDB,,0000,0000,0000,,Қазір төрт мүше бар, ал клубты құру үшін қажет бесінші адам
Dialogue: 0,0:15:57.25,0:15:58.65,JPDB,,0000,0000,0000,,Олар мұны мойындамайды.
Dialogue: 0,0:15:58.94,0:16:02.77,JPDB,,0000,0000,0000,,Сабақтан кейін Химераға мектепке келіп, базаны бекітіңіз.
Dialogue: 0,0:16:05.83,0:16:11.05,JPDB,,0000,0000,0000,,Күтілгендей, мысықтарды клуб мүшелері ретінде қабылдауға болмайды.
Dialogue: 0,0:16:11.89,0:16:16.12,JPDB,,0000,0000,0000,,​​Дегенмен, химера менің қызметшім, Декомамо сияқты.
Dialogue: 0,0:16:16.61,0:16:19.30,JPDB,,0000,0000,0000,,Демек, Өлім Декомори сияқты өлім
Dialogue: 0,0:16:19.47,0:16:20.34,JPDB,,0000,0000,0000,,Оны жоққа шығарыңыз.
Dialogue: 0,0:16:20.91,0:16:24.02,JPDB,,0000,0000,0000,,Менде басқа біреумен жұмыс істейтінін қалаймын.
Dialogue: 0,0:16:24.52,0:16:28.99,JPDB,,0000,0000,0000,,Шын мәнінде, көзге көрінбейтін, бірақ сізбен ынтымақтасатын рух бар.
Dialogue: 0,0:16:30.36,0:16:30.99,JPDB,,0000,0000,0000,,Әрине
Dialogue: 0,0:16:31.78,0:16:32.74,JPDB,,0000,0000,0000,,Бұл рас
Dialogue: 0,0:16:33.14,0:16:35.18,JPDB,,0000,0000,0000,,Үлкендеріңізбен де атқа мінбеңіздер.
Dialogue: 0,0:16:35.55,0:16:39.13,JPDB,,0000,0000,0000,,Ал шын мәнінде менің ішімде басқа бір тұлға бар.
Dialogue: 0,0:16:39.63,0:16:40.10,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:40.70,0:16:42.10,JPDB,,0000,0000,0000,,Күте тұрыңыз, ол шыққалы тұр.
Dialogue: 0,0:16:43.73,0:16:49.89,JPDB,,0000,0000,0000,,Сізбен танысқаныма қуаныштымын, Кэтрин, бұл баланың ішіндегі басқа тұлға.
Dialogue: 0,0:16:50.19,0:16:51.56,JPDB,,0000,0000,0000,,Мен үйге бара жатырмын
Dialogue: 0,0:16:52.48,0:16:55.96,JPDB,,0000,0000,0000,,Ғажайып Кэтрин қайдан шыққан?
Dialogue: 0,0:16:56.03,0:16:57.52,JPDB,,0000,0000,0000,,Нана-чан, сен басқарасың ба?
Dialogue: 0,0:16:57.90,0:17:01.33,JPDB,,0000,0000,0000,,Бастапқыда 18 ғасырда Англияда дүниеге келген
Dialogue: 0,0:17:02.99,0:17:03.76,JPDB,,0000,0000,0000,,Сәлем
Dialogue: 0,0:17:03.76,0:17:04.58,JPDB,,0000,0000,0000,,Үлкендерге
Dialogue: 0,0:17:04.58,0:17:05.80,JPDB,,0000,0000,0000,,Танысқаныма қуаныштымын
Dialogue: 0,0:17:06.89,0:17:10.10,JPDB,,0000,0000,0000,,Рикка туралы не ойлайсыз?
Dialogue: 0,0:17:11.32,0:17:12.51,JPDB,,0000,0000,0000,,Шығып бара жатырсың ба?
Dialogue: 0,0:17:13.21,0:17:15.22,JPDB,,0000,0000,0000,,Рикка туралы не ойлайсыз?
Dialogue: 0,0:17:18.82,0:17:19.52,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:17:23.70,0:17:25.34,JPDB,,0000,0000,0000,,Ni…Жапон тілінде жарайды
Dialogue: 0,0:17:25.54,0:17:28.52,JPDB,,0000,0000,0000,,Сізге ағылшын тілінде сөйлесу оңай, солай ма?
Dialogue: 0,0:17:30.68,0:17:36.69,JPDB,,0000,0000,0000,,Көздер, көздер, көздер... кетті.
Dialogue: 0,0:17:37.27,0:17:40.77,JPDB,,0000,0000,0000,,Сонда мен клуб мүшесі ретінде танылмаймын деп ойлаймын.
Dialogue: 0,0:17:40.97,0:17:43.68,JPDB,,0000,0000,0000,,Нана-чан өзін табиғи деп көрсетеді, бірақ таңқаларлықтай стратег
Dialogue: 0,0:17:44.85,0:17:46.41,JPDB,,0000,0000,0000,,Бірақ мен сені аяймын.
Dialogue: 0,0:17:48.85,0:17:50.02,JPDB,,0000,0000,0000,,Мұнда өлім
Dialogue: 0,0:17:50.12,0:17:54.09,JPDB,,0000,0000,0000,,Сиқырлы реакция жоқ, бірақ мимика мүмкіндігін жоққа шығаруға болмайды. Абайлаңыз
Dialogue: 0,0:17:54.91,0:17:56.53,JPDB,,0000,0000,0000,,Өлім кім біледі
Dialogue: 0,0:18:00.51,0:18:07.51,JPDB,,0000,0000,0000,,Нанасе-сенсей өте мейірімді. Егер сіз осы жерді тазаласаңыз, олар сізді клуб мүшесі ретінде таниды.
Dialogue: 0,0:18:07.71,0:18:12.46,JPDB,,0000,0000,0000,,Түсінемін, мен оларды жай ғана жақсы пайдаланып жатқандай сезінемін.
Dialogue: 0,0:18:15.54,0:18:19.72,JPDB,,0000,0000,0000,,Мен сенің шебер болуға лайық екеніңді тағы бір рет тексеремін.
Dialogue: 0,0:18:20.11,0:18:23.59,JPDB,,0000,0000,0000,,Рикка Которию жоқ, «Джау Шинген»
Dialogue: 0,0:18:23.99,0:18:28.69,JPDB,,0000,0000,0000,,Түсінікті. Егер олай болмаса, мен сенің қызметшің бола алмаймын.
Dialogue: 0,0:18:29.61,0:18:30.43,JPDB,,0000,0000,0000,,Оқ жаудыр!
Dialogue: 0,0:18:36.25,0:18:37.26,JPDB,,0000,0000,0000,,Explode Real
Dialogue: 0,0:18:37.66,0:18:39.13,JPDB,,0000,0000,0000,,«Синапсты» ойнайық
Dialogue: 0,0:18:43.03,0:18:46.29,JPDB,,0000,0000,0000,,«Бұл әлемді қуу»
Dialogue: 0,0:18:53.30,0:18:54.12,JPDB,,0000,0000,0000,,Ику өлімі
Dialogue: 0,0:18:56.10,0:18:58.27,JPDB,,0000,0000,0000,,«Lunatic Mulnir Crusher»
Dialogue: 0,0:19:16.88,0:19:17.92,JPDB,,0000,0000,0000,,«Сот Люцифер»
Dialogue: 0,0:19:24.09,0:19:25.85,JPDB,,0000,0000,0000,,«Мәңгілік Саламандр Зи»
Dialogue: 0,0:19:29.58,0:19:31.22,JPDB,,0000,0000,0000,,«Патша революциясы»
Dialogue: 0,0:19:31.22,0:19:32.74,JPDB,,0000,0000,0000,,«Лаплас сфералық жаңбыр»
Dialogue: 0,0:19:37.29,0:19:39.33,JPDB,,0000,0000,0000,,Балалар, өз іс-әрекеттеріңді жинаңдар.
Dialogue: 0,0:19:40.15,0:19:43.77,JPDB,,0000,0000,0000,,Бұл көп уақытты алды. Осылай лас болды ма?
Dialogue: 0,0:19:44.10,0:19:46.11,JPDB,,0000,0000,0000,,Жоқ, әртүрлі нәрселер бар.
Dialogue: 0,0:19:46.68,0:19:51.55,JPDB,,0000,0000,0000,,Шынымен бе? Олай болса, сіз қолыңыздан келгеннің бәрін жасағандықтан, мен сізді клубтың мүшесі ретінде ұсынғым келеді.
Dialogue: 0,0:19:53.22,0:19:53.91,JPDB,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:19:54.06,0:19:55.06,JPDB,,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:19:55.23,0:19:57.06,JPDB,,0000,0000,0000,,Бұл менің көптен күткен ұйқы клубым.
Dialogue: 0,0:19:57.42,0:19:59.88,JPDB,,0000,0000,0000,,Үйірме бөлмесі үшін біз тазартылған сыныпты пайдаландық.
Dialogue: 0,0:20:00.20,0:20:00.63,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:20:01.57,0:20:04.73,JPDB,,0000,0000,0000,,Енді клубқа көтерілу үшін бар күшіңізді салыңыз.
Dialogue: 0,0:20:06.32,0:20:09.82,JPDB,,0000,0000,0000,,Іс-шаралар ертең басталады, сондықтан дайындықтарыңызды назардан тыс қалдырмаңыз.
Dialogue: 0,0:20:10.07,0:20:11.56,JPDB,,0000,0000,0000,,Ха, менің қожайыным
Dialogue: 0,0:20:12.31,0:20:12.93,JPDB,,0000,0000,0000,,Ютамо
Dialogue: 0,0:20:15.41,0:20:17.50,JPDB,,0000,0000,0000,,Мен кіру туралы ешқашан ештеңе айтқан жоқпын.
Dialogue: 0,0:20:19.12,0:20:23.27,JPDB,,0000,0000,0000,,Өтірік Тогаши-кун, сен мені алдаған шығарсың.
Dialogue: 0,0:20:23.47,0:20:27.27,JPDB,,0000,0000,0000,,Сенпай: Сіздің атыңыз Роккаға жақындап келеді.
Dialogue: 0,0:20:29.36,0:20:31.15,JPDB,,0000,0000,0000,,Неге сонша депрессияға түстің?
Dialogue: 0,0:20:33.86,0:20:35.92,JPDB,,0000,0000,0000,,Неге сен маған сонша құмарсың?
Dialogue: 0,0:20:36.91,0:20:39.67,JPDB,,0000,0000,0000,,Жарайды, уайымдама.
Dialogue: 0,0:20:40.02,0:20:47.15,JPDB,,0000,0000,0000,,Мабиногиннің жеті түсті қолжазбасына сәйкес, Қараңғы жалынды қолданушы зұлым патша Шинганның тілектерін орындайды.
Dialogue: 0,0:20:47.35,0:20:49.04,JPDB,,0000,0000,0000,,Бұл не оғаш кітап?
Dialogue: 0,0:20:49.22,0:20:55.20,JPDB,,0000,0000,0000,,Сиқыршы Морисаманың Декомори «Электр мұхитынан» тапқан кітабы.
Dialogue: 0,0:20:55.43,0:20:59.01,JPDB,,0000,0000,0000,,Бұл дүниедегі барлық құбылыстар туралы жазылған кітап
Dialogue: 0,0:21:00.10,0:21:01.62,JPDB,,0000,0000,0000,,Күдікті болыңыз
Dialogue: 0,0:21:03.08,0:21:04.33,JPDB,,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:21:04.48,0:21:07.68,JPDB,,0000,0000,0000,,Осы арқылы сіз бәрін түсіне аласыз.
Dialogue: 0,0:21:17.97,0:21:19.66,JPDB,,0000,0000,0000,,Сіз толқығаныңызға сенімдімін.
Dialogue: 0,0:21:20.16,0:21:23.71,JPDB,,0000,0000,0000,,Келіңіздер, егер сіз мұны жасасаңыз, ешқандай қиындық болмайды.
Dialogue: 0,0:21:24.14,0:21:26.47,JPDB,,0000,0000,0000,,Жарайды, шыдамсыз болмаңыз
Dialogue: 0,0:21:27.57,0:21:30.05,JPDB,,0000,0000,0000,,Мен сізді бейтаныс клубқа кіргеніңізді естідім.
Dialogue: 0,0:21:30.40,0:21:32.46,JPDB,,0000,0000,0000,,Ол жерде жоқ екені сөзсіз.
Dialogue: 0,0:21:32.86,0:21:35.32,JPDB,,0000,0000,0000,,иә? Бірақ бұл «Қиыр Шығыс» болса ше?
Dialogue: 0,0:21:35.52,0:21:38.90,JPDB,,0000,0000,0000,,Сол себепті кірген жоқпын, кіруге де ниетім жоқ.
Dialogue: 0,0:21:37.41,0:21:38.50,JPDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:21:42.70,0:21:43.37,JPDB,,0000,0000,0000,,Қарсы боласыз ба?
Dialogue: 0,0:21:43.52,0:21:44.64,JPDB,,0000,0000,0000,,Қ-не?
Dialogue: 0,0:21:44.84,0:21:50.23,JPDB,,0000,0000,0000,,Мен Тогаши-кунның клубына қосылу туралы ойладым, сондықтан мен жай ғана қосылуға өтініш бердім.
Dialogue: 0,0:21:50.88,0:21:52.69,JPDB,,0000,0000,0000,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:21:52.94,0:21:58.36,JPDB,,0000,0000,0000,,Мен өз ризашылығымды білдіру үшін клубтың атауын ойладым.
Dialogue: 0,0:21:59.78,0:22:05.24,JPDB,,0000,0000,0000,,«Қиыр Шығыс сиқырлы ұйқы қоғамының жазы»?
Dialogue: 0,0:22:11.04,0:22:12.95,JPDB,,0000,0000,0000,,Бұл өтірік... солай емес пе?
Dialogue: 0,0:02:43.59,0:02:47.56,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:02:47.79,0:02:54.35,JPOP,,0000,0000,0000,karaoke,Маған таң қалдырмас бұрын сіз не ойладыңыз?
Dialogue: 0,0:02:54.57,0:02:58.60,JPOP,,0000,0000,0000,karaoke,Маған қарашы еріндерім
Dialogue: 0,0:02:58.82,0:03:04.14,JPOP,,0000,0000,0000,karaoke,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:03:04.49,0:03:09.84,JPOP,,0000,0000,0000,karaoke,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:03:10.33,0:03:15.75,JPOP,,0000,0000,0000,karaoke,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:03:16.45,0:03:21.29,JPOP,,0000,0000,0000,karaoke,Сізді бір-біріңізге тартатын махаббат
Dialogue: 0,0:03:21.64,0:03:26.11,JPOP,,0000,0000,0000,karaoke,Ол әлдеқашан басталған болатын
Dialogue: 0,0:03:27.13,0:03:29.49,JPOP,,0000,0000,0000,karaoke,Менің арманым көп болды
Dialogue: 0,0:03:29.52,0:03:33.40,JPOP,,0000,0000,0000,karaoke,Мен ояу болсам да сені көргім келеді
Dialogue: 0,0:03:33.40,0:03:35.61,JPOP,,0000,0000,0000,karaoke,сен оны жүзеге асырдың
Dialogue: 0,0:03:35.61,0:03:38.02,JPOP,,0000,0000,0000,karaoke,Махаббат сараңдық
Dialogue: 0,0:03:38.02,0:03:43.59,JPOP,,0000,0000,0000,karaoke,Секірейін деп тұрған жүрегіміздің жолымен жүрейік
Dialogue: 0,0:03:43.59,0:03:46.20,JPOP,,0000,0000,0000,karaoke,Идеалдар, адасулар және шындық
Dialogue: 0,0:03:46.32,0:03:48.83,JPOP,,0000,0000,0000,karaoke,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:03:49.06,0:03:54.18,JPOP,,0000,0000,0000,karaoke,Жаңа әлемге
Dialogue: 0,0:02:43.59,0:02:47.56,JPOP,,0000,0000,0000,fx,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:02:47.79,0:02:54.35,JPOP,,0000,0000,0000,fx,Сіз оны бұрмастан бұрын не ойладыңыз деп ойлаймын.
Dialogue: 0,0:02:54.57,0:02:58.60,JPOP,,0000,0000,0000,fx,Маған қарашы еріндері
Dialogue: 0,0:02:58.82,0:03:04.14,JPOP,,0000,0000,0000,fx,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:03:04.49,0:03:09.84,JPOP,,0000,0000,0000,fx,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:03:10.33,0:03:15.75,JPOP,,0000,0000,0000,fx,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:03:16.45,0:03:21.29,JPOP,,0000,0000,0000,fx,Бір-біріне қарсылықсыз тартылатын махаббат
Dialogue: 0,0:03:21.64,0:03:26.11,JPOP,,0000,0000,0000,fx,Ол әлдеқашан басталған болатын
Dialogue: 0,0:03:27.13,0:03:29.49,JPOP,,0000,0000,0000,fx,Мен көп армандадым
Dialogue: 0,0:03:29.52,0:03:33.40,JPOP,,0000,0000,0000,fx,Оянсам да, сені көргім келеді.
Dialogue: 0,0:03:33.40,0:03:35.61,JPOP,,0000,0000,0000,fx,Сіз мұны жасадыңыз
Dialogue: 0,0:03:35.61,0:03:38.02,JPOP,,0000,0000,0000,fx,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:03:38.02,0:03:43.59,JPOP,,0000,0000,0000,fx,Бізді секіртетін жүрекке ерейік
Dialogue: 0,0:03:43.59,0:03:46.20,JPOP,,0000,0000,0000,fx,Идеалдар, адасушылықтар және шындық
Dialogue: 0,0:03:46.32,0:03:48.83,JPOP,,0000,0000,0000,fx,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:03:49.06,0:03:54.18,JPOP,,0000,0000,0000,fx,Жаңа әлемге
Dialogue: 0,0:02:43.59,0:02:47.56,ZWOP,,0000,0000,0000,fx,Сіз екі көзбен осы сәттесіз
Dialogue: 0,0:02:47.81,0:02:54.35,ZWOP,,0000,0000,0000,fx,Қозғалмас бұрын, сіз қаланың қай жерде екеніңізді көре аласыз.
Dialogue: 0,0:02:54.57,0:02:58.60,ZWOP,,0000,0000,0000,fx,Менің тұмсығыма қара
Dialogue: 0,0:02:58.82,0:03:04.14,ZWOP,,0000,0000,0000,fx,Жиналыстың сұрағы `` Мен мұны істегім келеді '' Сондай-ақ, үндемеңіз.
Dialogue: 0,0:03:04.49,0:03:09.84,ZWOP,,0000,0000,0000,fx,Моңғолияның өз бетімен сөйлесуі
Dialogue: 0,0:03:10.33,0:03:15.75,ZWOP,,0000,0000,0000,fx,Әңгімені қайта оқудың қажеті жоқ.
Dialogue: 0,0:03:16.45,0:03:21.29,ZWOP,,0000,0000,0000,fx,Өзара тартымдылық махаббат
Dialogue: 0,0:03:21.64,0:03:26.11,ZWOP,,0000,0000,0000,fx,Жаңа ғана басталды
Dialogue: 0,0:03:27.13,0:03:29.49,ZWOP,,0000,0000,0000,fx,Шектеусіз әдемі армандар
Dialogue: 0,0:03:29.52,0:03:33.40,ZWOP,,0000,0000,0000,fx,Бұл түстен оянғаннан кейін де оны көру керек.
Dialogue: 0,0:03:33.40,0:03:35.61,ZWOP,,0000,0000,0000,fx,Капитал зиянды
Dialogue: 0,0:03:35.61,0:03:38.02,ZWOP,,0000,0000,0000,fx,Махаббат - махаббаттың шынайы табиғаты.
Dialogue: 0,0:03:38.02,0:03:43.59,ZWOP,,0000,0000,0000,fx,Будда мен баланың ішкі ойлары секіріп кетеді.
Dialogue: 0,0:03:43.59,0:03:46.20,ZWOP,,0000,0000,0000,fx,Күмән жоқ - идеал, адасушылық - шындық
Dialogue: 0,0:03:46.32,0:03:48.83,ZWOP,,0000,0000,0000,fx,Барлық астаналар сіздің кезегіңізге келді.
Dialogue: 0,0:03:49.06,0:03:54.18,ZWOP,,0000,0000,0000,fx,Дүниедегі жаңа келу
Dialogue: 0,0:22:16.78,0:22:19.29,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:32.19,0:22:34.70,JPED,,0000,0000,0000,,Түсініспеушілік ұят па?
Dialogue: 0,0:22:34.70,0:22:37.03,JPED,,0000,0000,0000,,Адалдық зиян келтіреді.
Dialogue: 0,0:22:37.36,0:22:39.92,JPED,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:22:39.92,0:22:42.35,JPED,,0000,0000,0000,,Мен ненің дұрыс екенін білмеймін
Dialogue: 0,0:22:42.55,0:22:45.16,JPED,,0000,0000,0000,,Әдеттегідей ағып жатқан күнделікті өмірде
Dialogue: 0,0:22:45.28,0:22:47.62,JPED,,0000,0000,0000,,Мен өзімді соған үйренуге мәжбүр еттім.
Dialogue: 0,0:22:47.62,0:22:50.25,JPED,,0000,0000,0000,,Суға батқан тұлға және қан
Dialogue: 0,0:22:50.45,0:22:52.67,JPED,,0000,0000,0000,,Шайнаңыз, ішіңіз, түкіріңіз және сындырыңыз
Dialogue: 0,0:22:52.67,0:22:57.09,JPED,,0000,0000,0000,,Мені осылай түсінгеніңізді қалаймын
Dialogue: 0,0:22:57.36,0:23:02.66,JPED,,0000,0000,0000,,Мен бірдеңе айтқым келеді, бірақ айта алмаймын.
Dialogue: 0,0:23:02.66,0:23:07.45,JPED,,0000,0000,0000,,Неге ешкім түсінбейді?
Dialogue: 0,0:23:07.68,0:23:12.62,JPED,,0000,0000,0000,,Ойлану сән-салтанат па? Солай ма?
Dialogue: 0,0:23:12.62,0:23:17.79,JPED,,0000,0000,0000,,Эмоциялық күн - бұл
Dialogue: 0,0:23:18.04,0:23:20.73,JPED,,0000,0000,0000,,Тым көп қызу
Dialogue: 0,0:23:20.73,0:23:23.01,JPED,,0000,0000,0000,,Менің ойымша, бұл қандай да бір жолмен жүзеге асады
Dialogue: 0,0:23:23.16,0:23:28.08,JPED,,0000,0000,0000,,Айқайлағым келеді
Dialogue: 0,0:23:28.08,0:23:34.00,JPED,,0000,0000,0000,,ТҮСІКТІЛІКТІ іздеп жатыр
Dialogue: 0,0:23:34.27,0:23:36.76,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,JPED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,JPED,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:23:41.85,0:23:43.85,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:16.78,0:22:19.29,ZWED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:22:19.29,0:22:21.06,ZWED,,0000,0000,0000,,Қараған жерің – тұратын жерің.
Dialogue: 0,0:22:32.19,0:22:34.70,ZWED,,0000,0000,0000,,Қате түсініктер адамдардың ұят сезімін тудырды.
Dialogue: 0,0:22:34.70,0:22:37.03,ZWED,,0000,0000,0000,,​​Шынымды айтсам, адамдардың дәл осылай сезінуі қиын.
Dialogue: 0,0:22:37.36,0:22:39.92,ZWED,,0000,0000,0000,,Әрине, бұл басқа адамның әңгімесі
Dialogue: 0,0:22:39.92,0:22:42.35,ZWED,,0000,0000,0000,,Мен түсініксізмін және нақтымын.
Dialogue: 0,0:22:42.55,0:22:45.16,ZWED,,0000,0000,0000,,Өзін-өзі бекітуді зерттеу
Dialogue: 0,0:22:45.28,0:22:47.62,ZWED,,0000,0000,0000,,Мүлдем өзгермейтін күн
Dialogue: 0,0:22:47.62,0:22:50.25,ZWED,,0000,0000,0000,,Өзіне зиян келтіретін қан
Dialogue: 0,0:22:50.45,0:22:52.67,ZWED,,0000,0000,0000,,Шайнау, жұту, түкіру, ойнау
Dialogue: 0,0:22:52.67,0:22:57.09,ZWED,,0000,0000,0000,,Сіз мені түсінесіз деп үміттенемін.
Dialogue: 0,0:22:57.36,0:23:02.66,ZWED,,0000,0000,0000,,Үнсіз ойлар әлемге және Нұ ашуға келеді
Dialogue: 0,0:23:02.66,0:23:07.45,ZWED,,0000,0000,0000,,Мен адам екенімді түсінемін.
Dialogue: 0,0:23:07.68,0:23:12.62,ZWED,,0000,0000,0000,,Түсінікті болғың келсе, түсін.
Dialogue: 0,0:23:12.62,0:23:17.79,ZWED,,0000,0000,0000,,Эмоциялық іскерлік күн
Dialogue: 0,0:23:18.04,0:23:20.73,ZWED,,0000,0000,0000,,Жылудың шамадан тыс мөлшері
Dialogue: 0,0:23:20.73,0:23:23.01,ZWED,,0000,0000,0000,,Мен ләззат алуым керек және жаман мінез-құлық алуым керек.
Dialogue: 0,0:23:23.16,0:23:28.08,ZWED,,0000,0000,0000,,Заңсыз тежеу ойлары мен айқайлау шақырулары
Dialogue: 0,0:23:28.08,0:23:34.00,ZWED,,0000,0000,0000,,ТҰРҒЫНДАР
Dialogue: 0,0:23:34.27,0:23:36.76,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,ZWED,,0000,0000,0000,,МЕНІҢ ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,ZWED,,0000,0000,0000,,Қажетсіз тежелу
Dialogue: 0,0:23:41.85,0:23:43.85,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:03:58.96,0:04:08.93,ZZ信息,,0000,0000,0000,,Бұл субтитрлер сериясы субтитрлер жиынтығы ретінде көрсетіледі және айырбастауға көбірек қытай, жапон және қытай субтитрлері қолжетімді. www.kamigami.org
Dialogue: 0,0:03:58.96,0:04:08.93,ZZ信息,,0000,0000,0000,,...
Dialogue: 0,0:05:29.97,0:05:36.02,ZWBT,,0000,0000,0000,,Бірегей егіз құйрық
Dialogue: 0,0:00:01.98,0:00:02.98,ZWDB,,0000,0000,0000,,Мен ашпын.
Dialogue: 0,0:00:03.65,0:00:05.39,ZWDB,,0000,0000,0000,,Гарё Ичиге шағын бөлім
Dialogue: 0,0:00:05.89,0:00:07.00,ZWDB,,0000,0000,0000,,Мен бірінші болып бастадым.
Dialogue: 0,0:00:08.15,0:00:10.31,ZWDB,,0000,0000,0000,,Орта мектеп өмірін бастағаннан кейін бір ай
Dialogue: 0,0:00:10.98,0:00:11.53,ZWDB,,0000,0000,0000,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:00:11.53,0:00:16.47,ZWDB,,0000,0000,0000,,Күннің ортасында алаңдаушылық, шиеленіс сезімі жоғалады.
Dialogue: 0,0:00:17.47,0:00:21.77,ZWDB,,0000,0000,0000,,Үй иесі өз жұмысына өзі жауапты.
Dialogue: 0,0:00:22.41,0:00:25.17,ZWDB,,0000,0000,0000,,Оқушылар арасындағы қашықтықты сезіну азая бастайды.
Dialogue: 0,0:00:26.66,0:00:31.46,ZWDB,,0000,0000,0000,,Бұл мектепті еш күмәнсіз таныстыру.
Dialogue: 0,0:00:32.55,0:00:35.88,ZWDB,,0000,0000,0000,,Кішкентай құс үшін қолайлылық мөлшері бірдей.
Dialogue: 0,0:00:36.88,0:00:42.15,ZWDB,,0000,0000,0000,,Жауынгерлік сұранысқа байланысты сиқырлы күш азайып, өмірге қауіп төнеді.
Dialogue: 0,0:00:45.01,0:00:46.55,ZWDB,,0000,0000,0000,,Бұл менің уақытым, бірақ бұл менің уақытым.
Dialogue: 0,0:00:47.49,0:00:52.76,ZWDB,,0000,0000,0000,,Соғыс кезінде жерден азық-түлікті тез алу керек.
Dialogue: 0,0:00:54.65,0:00:56.84,ZWDB,,0000,0000,0000,,Сөздің шын мағынасында өзін-өзі шағымдану сәті
Dialogue: 0,0:00:58.03,0:00:59.20,ZWDB,,0000,0000,0000,,Сәттілік пен байлық
Dialogue: 0,0:01:00.14,0:01:04.42,ZWDB,,0000,0000,0000,,Ұрыста жүргенде жақсы жерден тамақ алу керек.
Dialogue: 0,0:01:04.72,0:01:05.88,ZWDB,,0000,0000,0000,,Әртүрлі сөздер мен бір сөздер
Dialogue: 0,0:01:06.98,0:01:08.15,ZWDB,,0000,0000,0000,,Бұл сізге ыңғайлы.
Dialogue: 0,0:01:08.69,0:01:09.64,ZWDB,,0000,0000,0000,,“Сенрижин”
Dialogue: 0,0:01:11.33,0:01:14.61,ZWDB,,0000,0000,0000,,Ол он гүл, ол шынымен көзге көрінбейді және оның ас әзірлеуі зиянды.
Dialogue: 0,0:01:15.10,0:01:18.06,ZWDB,,0000,0000,0000,,«Көрінбейтін тұлға»… Менің кездесуім жарияланды.
Dialogue: 0,0:01:18.41,0:01:19.53,ZWDB,,0000,0000,0000,,Мұндай түрді қолданбау туралы ескерту
Dialogue: 0,0:01:23.01,0:01:29.45,ZWDB,,0000,0000,0000,,``Аспаздың мансабы'' қазір нақты әлемде.
Dialogue: 0,0:01:31.16,0:01:33.74,ZWDB,,0000,0000,0000,,Наша тұлғасы болып табылатын адамның жайлы әңгімесі Аффирмация...
Dialogue: 0,0:01:34.86,0:01:39.14,ZWDB,,0000,0000,0000,,Қызыл жемістер қоғамы сиқырлы қуатты төмендетеді. Әртүрлі ерекше қауіп
Dialogue: 0,0:01:39.81,0:01:41.45,ZWDB,,0000,0000,0000,,Мен бұған риза емеспін.
Dialogue: 0,0:01:41.65,0:01:44.48,ZWDB,,0000,0000,0000,,Әсіресе, бұл дәннің ең жасыл бөлігі.
Dialogue: 0,0:01:45.30,0:01:49.35,ZWDB,,0000,0000,0000,,Мен Шығыс пен Батыстағы адамдардың аффирмациясының ауытқуынан қорқамын.
Dialogue: 0,0:01:49.95,0:01:51.44,ZWDB,,0000,0000,0000,,Батыс құрмаларының жағымды алуан түрі
Dialogue: 0,0:01:53.38,0:01:55.39,ZWDB,,0000,0000,0000,,Жартылай күріш басып алуының пайда болуы
Dialogue: 0,0:02:00.41,0:02:02.87,ZWDB,,0000,0000,0000,,Шынайы жою әдісі
Dialogue: 0,0:02:08.74,0:02:09.66,ZWDB,,0000,0000,0000,,Бұл жол...
Dialogue: 0,0:02:16.62,0:02:19.97,ZWDB,,0000,0000,0000,,Бұл сіз ойлағандай емес.
Dialogue: 0,0:02:27.31,0:02:28.08,ZWDB,,0000,0000,0000,,өлім
Dialogue: 0,0:04:09.70,0:04:11.97,ZWDB,,0000,0000,0000,,Жақында каратэ клубының жекпе-жек өнерінің көрсетілімі болады.
Dialogue: 0,0:04:13.56,0:04:16.56,ZWDB,,0000,0000,0000,,Юта Какеру компаниясының іс-шараларын есептеу жоспары
Dialogue: 0,0:04:17.71,0:04:19.80,ZWDB,,0000,0000,0000,,Сіз жоғалтқан компанияны қараңыз.
Dialogue: 0,0:04:20.39,0:04:23.18,ZWDB,,0000,0000,0000,,Мен алғаш бастаған кезде бір ғана жоспарым бар.
Dialogue: 0,0:04:24.57,0:04:26.28,ZWDB,,0000,0000,0000,,Қуанышыңның үні
Dialogue: 0,0:04:26.38,0:04:30.81,ZWDB,,0000,0000,0000,,Музыка тыңдап жатсаңыз, музыкалық клубқа қосылыңыз.
Dialogue: 0,0:04:31.58,0:04:35.28,ZWDB,,0000,0000,0000,,Бұл қандай болмыс?
Dialogue: 0,0:04:36.08,0:04:40.65,ZWDB,,0000,0000,0000,,Бұл бүкіл қаланың шығысы мен батысы.
Dialogue: 0,0:04:40.92,0:04:45.47,ZWDB,,0000,0000,0000,,Сіз терең түсінуге біржақты көзқарастасыз.
Dialogue: 0,0:04:46.07,0:04:47.04,ZWDB,,0000,0000,0000,,Жабық тұмсық
Dialogue: 0,0:04:47.04,0:04:47.66,ZWDB,,0000,0000,0000,,Ауырсыну...
Dialogue: 0,0:04:47.88,0:04:51.66,ZWDB,,0000,0000,0000,,Мен орта мектепте оқып жүргенімде бейсбол клубына қалай келгенім туралы оқиға.
Dialogue: 0,0:04:52.16,0:04:54.86,ZWDB,,0000,0000,0000,,Екі ай бұрын мен иығымды ауыстырдым және менің оң қолымды бір әйел досым тағып жүрді.
Dialogue: 0,0:04:55.14,0:04:59.04,ZWDB,,0000,0000,0000,,Сол жақта менің таңданыстағы тағы бір студент қыздың бейнесі көрінеді.
Dialogue: 0,0:04:59.66,0:05:01.50,ZWDB,,0000,0000,0000,,Компанияның қызметі... Жақсы ауырсыну
Dialogue: 0,0:05:11.44,0:05:16.04,ZWDB,,0000,0000,0000,,«Біз некеге тұрғанға дейін және одан кейін кездескен жер, кептірілген жапырақтардың құлпытасы, Рокка»
Dialogue: 0,0:05:19.05,0:05:21.73,ZWDB,,0000,0000,0000,,«Нагай аймағы Газай Ширандо 3»
Dialogue: 0,0:05:36.72,0:05:38.73,ZWDB,,0000,0000,0000,,Сен Ганджи мүсінін мойындау және өзімшілдік
Dialogue: 0,0:05:40.20,0:05:41.32,ZWDB,,0000,0000,0000,,Мұны ұқсас қару ретінде пайдалануға болады.
Dialogue: 0,0:05:43.73,0:05:45.47,ZWDB,,0000,0000,0000,,Бұның мүлде қатесі жоқ
Dialogue: 0,0:05:46.54,0:05:50.86,ZWDB,,0000,0000,0000,,Уақыт шектеулі, мен қылышты тікелей қолданғым келеді.
Dialogue: 0,0:05:51.38,0:05:54.51,ZWDB,,0000,0000,0000,,Менің қазіргі мектеп орным және менің көзқарасым
Dialogue: 0,0:05:55.16,0:05:55.86,ZWDB,,0000,0000,0000,,Бекітілген нүкте?
Dialogue: 0,0:05:56.48,0:05:58.91,ZWDB,,0000,0000,0000,,Менің жаңа компаниям
Dialogue: 0,0:06:03.24,0:06:07.71,ZWDB,,0000,0000,0000,,Котаның шындықтан қашуы және Ноны түсінуі, Ноны қайта тексеру, 1-бөлім
Dialogue: 0,0:06:08.26,0:06:09.45,ZWDB,,0000,0000,0000,,Петеро арқылы ванисте
Dialogue: 0,0:06:10.69,0:06:14.17,ZWDB,,0000,0000,0000,,Параллель әлем тілін қабылдаңыз
Dialogue: 0,0:06:14.17,0:06:18.42,ZWDB,,0000,0000,0000,,Бұл дүние кейіпкерлерінің тілі.
Dialogue: 0,0:06:18.50,0:06:21.51,ZWDB,,0000,0000,0000,,Бұл тегін түсініктеме.
Dialogue: 0,0:06:21.83,0:06:26.23,ZWDB,,0000,0000,0000,,Біздің қазіргі мектеп орны, компания ғимараты және біздің іс-шараларымыз.
Dialogue: 0,0:06:29.04,0:06:30.55,ZWDB,,0000,0000,0000,,Тегі осында
Dialogue: 0,0:06:31.20,0:06:35.57,ZWDB,,0000,0000,0000,,«Кантумаша»
Dialogue: 0,0:06:40.40,0:06:41.29,ZWDB,,0000,0000,0000,,Рахмет
Dialogue: 0,0:06:46.63,0:06:47.13,ZWDB,,0000,0000,0000,,Уолтер Эванс (59)
Dialogue: 0,0:06:47.35,0:06:48.77,ZWDB,,0000,0000,0000,,Біліксіздікке арналған қалыпты әдіс
Dialogue: 0,0:06:49.02,0:06:51.26,ZWDB,,0000,0000,0000,,Йосиюки Сензайкуришаның аты
Dialogue: 0,0:06:53.42,0:06:54.49,ZWDB,,0000,0000,0000,,Сіз менің кездесуімнің көшірмесін ала аласыз
Dialogue: 0,0:06:55.58,0:07:04.68,ZWDB,,0000,0000,0000,,Бөлім бастығының орынбасары болатыным анық.
Dialogue: 0,0:07:05.05,0:07:09.67,ZWDB,,0000,0000,0000,,Мен жоқпын, бірақ менде қайта емтихан тапсыру жиналысы бар, басқалары да қосылды.
Dialogue: 0,0:07:10.39,0:07:11.67,ZWDB,,0000,0000,0000,,Нафутаншин
Dialogue: 0,0:07:16.76,0:07:20.46,ZWDB,,0000,0000,0000,,Taiki Kairyo өлген астана кім?
Dialogue: 0,0:07:20.76,0:07:21.73,ZWDB,,0000,0000,0000,,Назерихо, әрине
Dialogue: 0,0:07:23.19,0:07:29.83,ZWDB,,0000,0000,0000,,Әрине, шекара сызығын басқару бюросының сиқырлы шебері араласу үшін осында.
Dialogue: 0,0:07:30.08,0:07:33.11,ZWDB,,0000,0000,0000,,Үй иесі астанадан қашып кеткен тағы бір кез
Dialogue: 0,0:07:35.03,0:07:36.47,ZWDB,,0000,0000,0000,,Нананың тәжірибесі
Dialogue: 0,0:07:39.30,0:07:41.24,ZWDB,,0000,0000,0000,,Юта сізбен байланысады
Dialogue: 0,0:07:41.54,0:07:42.73,ZWDB,,0000,0000,0000,,Өміріңді аяқтағаннан кейін
Dialogue: 0,0:07:43.55,0:07:44.37,ZWDB,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:07:45.14,0:07:47.33,ZWDB,,0000,0000,0000,,Нетоганың "Джау Шинган"
Dialogue: 0,0:07:47.70,0:07:48.60,ZWDB,,0000,0000,0000,,«Зұлым патша»?
Dialogue: 0,0:07:49.32,0:07:52.05,ZWDB,,0000,0000,0000,,Жанжалды тынысты көргенде
Dialogue: 0,0:07:53.79,0:07:56.20,ZWDB,,0000,0000,0000,,Жоюдың талап етілетін түсіндірмесі, қара қабілеті бар көмек қажет
Dialogue: 0,0:07:56.80,0:08:01.02,ZWDB,,0000,0000,0000,,Біз '' Douhou Magic Company ''-ға қосылғанда, бізде '' Джау Шинган '' күші бар...
Dialogue: 0,0:08:01.74,0:08:04.20,ZWDB,,0000,0000,0000,,Аналогиялық әдіс мерзімі өтіп кеткен
Dialogue: 0,0:08:05.12,0:08:09.08,ZWDB,,0000,0000,0000,,Құшағына ал, өзіңдей өнерлі бол.
Dialogue: 0,0:08:10.54,0:08:13.95,ZWDB,,0000,0000,0000,,Бұл рас па... Гакуджи?
Dialogue: 0,0:08:15.81,0:08:17.23,ZWDB,,0000,0000,0000,,Нағыз шеберлік
Dialogue: 0,0:08:18.22,0:08:19.14,ZWDB,,0000,0000,0000,,«Госуша»?
Dialogue: 0,0:08:19.61,0:08:25.53,ZWDB,,0000,0000,0000,,Ұйықтау жақсы идея.
Dialogue: 0,0:08:25.88,0:08:28.44,ZWDB,,0000,0000,0000,,Қызық емес...
Dialogue: 0,0:08:30.20,0:08:34.43,ZWDB,,0000,0000,0000,,Компания өткен жылы салынған және оны бастапқыда жалға беруші жобалаған.
Dialogue: 0,0:08:34.82,0:08:37.88,ZWDB,,0000,0000,0000,,Алайда Ширазуми Мичиру астанаға қосылды.
Dialogue: 0,0:08:38.18,0:08:39.02,ZWDB,,0000,0000,0000,,Зуишимакурато
Dialogue: 0,0:08:40.69,0:08:45.04,ZWDB,,0000,0000,0000,,Қазір күн ашық болғандықтан, көктемнің шуақты күні.
Dialogue: 0,0:08:45.56,0:08:48.22,ZWDB,,0000,0000,0000,,Бұл жер туралы менімен сөйлесіп, шабындыққа жетуді армандай аласыз.
Dialogue: 0,0:08:49.46,0:08:50.22,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:08:56.12,0:08:58.71,ZWDB,,0000,0000,0000,,Менің мұнда келген әртүрлі адамдар бар.
Dialogue: 0,0:08:59.88,0:09:01.99,ZWDB,,0000,0000,0000,,Шексіз жасыл түс!
Dialogue: 0,0:09:02.98,0:09:05.05,ZWDB,,0000,0000,0000,,Шын арман жайлауларға жетеді
Dialogue: 0,0:09:06.56,0:09:10.79,ZWDB,,0000,0000,0000,,Мұның себебі сериядағы сиқырлы қуат жүйесіне байланысты.
Dialogue: 0,0:09:10.79,0:09:11.38,ZWDB,,0000,0000,0000,,Нибутани…
Dialogue: 0,0:09:12.38,0:09:13.67,ZWDB,,0000,0000,0000,,Гарашита кір жуатын бөлме
Dialogue: 0,0:09:15.78,0:09:18.24,ZWDB,,0000,0000,0000,,Naso костюмінің өлімін растау
Dialogue: 0,0:09:19.51,0:09:21.15,ZWDB,,0000,0000,0000,,Үй иесінің қажетсіз зерттеуі
Dialogue: 0,0:09:21.43,0:09:21.75,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:09:22.27,0:09:24.18,ZWDB,,0000,0000,0000,,Келіңіз және мені көріңіз.
Dialogue: 0,0:09:24.38,0:09:25.68,ZWDB,,0000,0000,0000,,Сіз қайдасыз?
Dialogue: 0,0:09:26.27,0:09:32.04,ZWDB,,0000,0000,0000,,L.A.A.-дағы Нюя Морика мүшесіне қатысты сирек оқиға.
Dialogue: 0,0:09:32.46,0:09:36.26,ZWDB,,0000,0000,0000,,Сіз кездейсоқ кейбір ерлердің костюмдерін көріп, олардың киім кигенін көрдіңіз.
Dialogue: 0,0:09:38.33,0:09:40.27,ZWDB,,0000,0000,0000,,Нибутани Догакушуй қабылдауы
Dialogue: 0,0:09:40.49,0:09:46.78,ZWDB,,0000,0000,0000,,Әрине, бұл барлық ер студенттер дауыс беретін «сүйкімді студент қыздың кәсіпорнындағы» бірінші атау.
Dialogue: 0,0:09:47.42,0:09:48.59,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:09:54.08,0:09:55.10,ZWDB,,0000,0000,0000,,Сіз кездеспеуіңіз керек…
Dialogue: 0,0:09:55.75,0:10:00.02,ZWDB,,0000,0000,0000,,Сызықты кездейсоқ көру мүмкін емес.
Dialogue: 0,0:10:01.37,0:10:04.42,ZWDB,,0000,0000,0000,,Кішкентай құс та денеге енген оқушы.
Dialogue: 0,0:10:05.02,0:10:06.26,ZWDB,,0000,0000,0000,,Наказаки жұмыртқасы
Dialogue: 0,0:10:07.06,0:10:12.58,ZWDB,,0000,0000,0000,,「」
Dialogue: 0,0:10:13.02,0:10:16.50,ZWDB,,0000,0000,0000,,Қайта туылдым деп қалай айтамын?
Dialogue: 0,0:10:16.90,0:10:18.22,ZWDB,,0000,0000,0000,,Нағыз сәтсіздік
Dialogue: 0,0:10:19.04,0:10:21.70,ZWDB,,0000,0000,0000,,Шекара алдында көрінбейтін шайқаста
Dialogue: 0,0:10:21.70,0:10:26.25,ZWDB,,0000,0000,0000,,Мен қазір әлемнен мыңдаған метр биіктікте ұшып жүрмін.
Dialogue: 0,0:10:26.47,0:10:27.19,ZWDB,,0000,0000,0000,,Сұрақтар қойылмаған
Dialogue: 0,0:10:27.39,0:10:29.03,ZWDB,,0000,0000,0000,,Нананың баласы сыныпта
Dialogue: 0,0:10:29.03,0:10:34.37,ZWDB,,0000,0000,0000,,Білмеймін... Не істерімді білмеймін.
Dialogue: 0,0:10:35.86,0:10:36.81,ZWDB,,0000,0000,0000,,Кана Исшо
Dialogue: 0,0:10:43.64,0:10:44.69,ZWDB,,0000,0000,0000,,Өлім оқиғасы
Dialogue: 0,0:10:44.99,0:10:46.82,ZWDB,,0000,0000,0000,,Кішкентай...Сакана Исшо
Dialogue: 0,0:10:47.17,0:10:48.19,ZWDB,,0000,0000,0000,,Жылау жоқ
Dialogue: 0,0:10:49.51,0:10:50.35,ZWDB,,0000,0000,0000,,Кана Исшо
Dialogue: 0,0:10:50.45,0:10:51.40,ZWDB,,0000,0000,0000,,Мен жеткілікті талантты емеспін
Dialogue: 0,0:10:53.81,0:10:57.46,ZWDB,,0000,0000,0000,,Мен сізбен кездескім келмейді, бірақ қаншалықты алысқа барарыңызды білмеймін.
Dialogue: 0,0:10:57.61,0:10:58.61,ZWDB,,0000,0000,0000,,Бұл компанияның атауы
Dialogue: 0,0:11:03.03,0:11:07.70,ZWDB,,0000,0000,0000,,Мен 10 жыл болдым.
Dialogue: 0,0:11:07.85,0:11:09.09,ZWDB,,0000,0000,0000,,Осымен.
Dialogue: 0,0:11:09.52,0:11:10.76,ZWDB,,0000,0000,0000,,「etude」（）
Dialogue: 0,0:11:11.31,0:11:14.71,ZWDB,,0000,0000,0000,,Бұл жоғары сапалы өнімділік және бірден орындалатын өнімділік.
Dialogue: 0,0:11:15.16,0:11:22.02,ZWDB,,0000,0000,0000,,Бұл жалғыз ағаш көпір.
Dialogue: 0,0:11:22.56,0:11:26.37,ZWDB,,0000,0000,0000,,Осыдан кейін сіз бағыттың бағытын бірден түсіне аласыз.
Dialogue: 0,0:11:27.11,0:11:29.18,ZWDB,,0000,0000,0000,,Оқу нұсқауларын оқыңыз
Dialogue: 0,0:11:30.94,0:11:34.27,ZWDB,,0000,0000,0000,,Қайта кеткенде қайда барғаным туралы ойлар мен әңгімелер
Dialogue: 0,0:11:35.14,0:11:36.23,ZWDB,,0000,0000,0000,,Бұл сіз оны айтқыңыз келгендіктен емес.
Dialogue: 0,0:11:38.42,0:11:39.04,ZWDB,,0000,0000,0000,,Міндетті шолу
Dialogue: 0,0:11:40.11,0:11:42.35,ZWDB,,0000,0000,0000,,Жағымсыз ниеттер
Dialogue: 0,0:11:42.87,0:11:45.90,ZWDB,,0000,0000,0000,,Қолайсыздық нүктесін талқылау Ұшуды бастау үшін қажет басқа отырған ұшақтар
Dialogue: 0,0:11:46.13,0:11:50.00,ZWDB,,0000,0000,0000,,Жағымсыз тұстардан хабардар болыңыз.
Dialogue: 0,0:11:50.33,0:11:51.82,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:11:58.65,0:12:00.47,ZWDB,,0000,0000,0000,,Арикума оңай қашу
Dialogue: 0,0:12:00.91,0:12:04.42,ZWDB,,0000,0000,0000,,Мен үшін «Джау Шинган» оқуын оқыңыз.
Dialogue: 0,0:12:05.69,0:12:06.31,ZWDB,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:12:07.18,0:12:12.12,ZWDB,,0000,0000,0000,,“Schwarz Sechs Prototype Mark 2”
Dialogue: 0,0:12:15.70,0:12:18.66,ZWDB,,0000,0000,0000,,Өткен оқиға туралы ойлар: Мені жеңудегі алғашқы әрекетім
Dialogue: 0,0:12:18.71,0:12:21.17,ZWDB,,0000,0000,0000,,“Қараңғы заттың жалыны”
Dialogue: 0,0:12:23.18,0:12:24.33,ZWDB,,0000,0000,0000,,Бір ұпай жоғалды
Dialogue: 0,0:12:25.10,0:12:28.53,ZWDB,,0000,0000,0000,,Мен сонда болғанымда, мені жергілікті қауымдастыққа шақырды, мен жеңіл атрибутты отбасының мүшесі болдым ...
Dialogue: 0,0:12:29.55,0:12:31.01,ZWDB,,0000,0000,0000,,Сіз оны оқи аласыз.
Dialogue: 0,0:12:33.97,0:12:34.74,ZWDB,,0000,0000,0000,,Не болып жатыр? «Реквием» кенеттен осы жаққа шабуыл жасап келеді
Dialogue: 0,0:12:39.99,0:12:40.56,ZWDB,,0000,0000,0000,,Серпіліс
Dialogue: 0,0:12:40.78,0:12:41.18,ZWDB,,0000,0000,0000,,Сен дүниеден өттің
Dialogue: 0,0:12:42.99,0:12:45.65,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:12:46.00,0:12:47.81,ZWDB,,0000,0000,0000,,Марқұмның келген жерінің аты
Dialogue: 0,0:12:48.19,0:12:48.76,ZWDB,,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:12:49.43,0:12:50.37,ZWDB,,0000,0000,0000,,Назерихо, әрине
Dialogue: 0,0:12:50.72,0:12:53.71,ZWDB,,0000,0000,0000,,Өлім заңы жойылды.
Dialogue: 0,0:12:54.50,0:12:56.69,ZWDB,,0000,0000,0000,,Рокка Догаку Сәйкес адамдарды таңдау
Dialogue: 0,0:12:57.01,0:13:02.78,ZWDB,,0000,0000,0000,,Бұл менің «Қызыл халатты епископты» ашу қозғалысы, будда дінінің пайда болу тәртібі.
Dialogue: 0,0:13:03.03,0:13:05.86,ZWDB,,0000,0000,0000,,Қазіргі уақытта Нагаокада Нагаокада пайда болу жағдайы
Dialogue: 0,0:13:05.98,0:13:08.84,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:13:09.71,0:13:11.18,ZWDB,,0000,0000,0000,,Мейтен кездесуі
Dialogue: 0,0:13:11.60,0:13:13.27,ZWDB,,0000,0000,0000,,Жағымсыз сезімнің түрі
Dialogue: 0,0:13:27.41,0:13:28.58,ZWDB,,0000,0000,0000,,Сіз кенет айқайладыңыз.
Dialogue: 0,0:13:28.87,0:13:31.11,ZWDB,,0000,0000,0000,,Мен мұны айтқым келеді.
Dialogue: 0,0:13:31.51,0:13:34.57,ZWDB,,0000,0000,0000,,Осыған байланысты мен оны бір рет айтамын.
Dialogue: 0,0:13:35.14,0:13:38.12,ZWDB,,0000,0000,0000,,Мен Тогаши-кунмын...
Dialogue: 0,0:13:38.49,0:13:39.39,ZWDB,,0000,0000,0000,,Тога?
Dialogue: 0,0:13:41.20,0:13:46.22,ZWDB,,0000,0000,0000,,L o v e Love
Dialogue: 0,0:13:48.24,0:13:53.85,ZWDB,,0000,0000,0000,,Қышыма, Қышыма, Жақсы Қышыма, Жақсы Қышыма, Жақсы Қышыма
Dialogue: 0,0:13:55.47,0:13:59.44,ZWDB,,0000,0000,0000,,Бұл дүниенің соңында лак қара жалын елшісі
Dialogue: 0,0:14:01.21,0:14:02.23,ZWDB,,0000,0000,0000,,Брошьтан гөрі, ол жігіт алдымен қозғалмалы орындыққа шабуыл жасайды
Dialogue: 0,0:14:03.25,0:14:07.62,ZWDB,,0000,0000,0000,,Басқа адамның тегі мен тегі
Dialogue: 0,0:14:07.62,0:14:11.18,ZWDB,,0000,0000,0000,,Мен абдырап қалдым.
Dialogue: 0,0:14:11.18,0:14:11.82,ZWDB,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:14:11.82,0:14:13.82,ZWDB,,0000,0000,0000,,Мен оны оқымас бұрын оны аштым.
Dialogue: 0,0:14:14.66,0:14:19.00,ZWDB,,0000,0000,0000,,Мен «Зұлым патшаның шынайы көзі» операторымын және мен Рикка Которуның бірінші қызметшісімін.
Dialogue: 0,0:14:19.20,0:14:24.55,ZWDB,,0000,0000,0000,,Санае Декомори, «Найзағай Құдайдың үні» контроллері
Dialogue: 0,0:14:26.06,0:14:26.81,ZWDB,,0000,0000,0000,,Рин Кай
Dialogue: 0,0:14:26.98,0:14:28.81,ZWDB,,0000,0000,0000,,Бұл менің жұмысым
Dialogue: 0,0:14:29.19,0:14:33.35,ZWDB,,0000,0000,0000,,Юутаның психикалық жүйесін басқарылатын станцияның сиқыры басып алды
Dialogue: 0,0:14:34.07,0:14:37.10,ZWDB,,0000,0000,0000,,Күтпеген жерден кейбір оғаш мінез-құлық басқа уақытта орын алды.
Dialogue: 0,0:14:37.35,0:14:41.30,ZWDB,,0000,0000,0000,,Әңгіменің бастауы осы.
Dialogue: 0,0:14:41.65,0:14:43.01,ZWDB,,0000,0000,0000,,Мен міндетті түрде ашамын.
Dialogue: 0,0:14:43.26,0:14:46.62,ZWDB,,0000,0000,0000,,Мен дөңес қорғаушымын, мен саған ризамын.
Dialogue: 0,0:14:46.62,0:14:51.32,ZWDB,,0000,0000,0000,,«Найзағай Құдайдың Айдаһар кітабы»
Dialogue: 0,0:14:56.91,0:14:57.93,ZWDB,,0000,0000,0000,,Аяқталмаған
Dialogue: 0,0:14:58.30,0:15:01.60,ZWDB,,0000,0000,0000,,Бұл шынайы және шынайы ойын.
Dialogue: 0,0:15:02.55,0:15:05.08,ZWDB,,0000,0000,0000,,Параллель әлем
Dialogue: 0,0:15:05.43,0:15:08.17,ZWDB,,0000,0000,0000,,Үздіксіз өзгеріс және қарқындылықтың одан әрі артуы
Dialogue: 0,0:15:08.39,0:15:12.49,ZWDB,,0000,0000,0000,,Декомори Гамотояның есептеулері таусылды…
Dialogue: 0,0:15:12.89,0:15:14.98,ZWDB,,0000,0000,0000,,Мұнда келуге арнайы рұқсат
Dialogue: 0,0:15:15.27,0:15:19.23,ZWDB,,0000,0000,0000,,Дегенмен, шекара сызығының көрінбеуі маңызды.
Dialogue: 0,0:15:19.80,0:15:22.68,ZWDB,,0000,0000,0000,,Келген кезде қосымша мәліметтер алу үшін бізге хабарласыңыз…
Dialogue: 0,0:15:23.80,0:15:26.21,ZWDB,,0000,0000,0000,,Сіздің мектеп формасы... бұл менің мектепке бірінші рет келуім.
Dialogue: 0,0:15:27.68,0:15:31.08,ZWDB,,0000,0000,0000,,Мен 2 курс студентімін және 3 курс студентімін.
Dialogue: 0,0:15:31.73,0:15:33.34,ZWDB,,0000,0000,0000,,Сіз қатты толқып тұрсыз
Dialogue: 0,0:15:33.89,0:15:38.56,ZWDB,,0000,0000,0000,,Шамамен екі жыл бұрын мен «Электр мұхиты» әлемінде өмір сүрдім.
Dialogue: 0,0:15:39.08,0:15:43.06,ZWDB,,0000,0000,0000,,Бұрынғы өмірімнің басы менікі болған екен.
Dialogue: 0,0:15:43.16,0:15:45.40,ZWDB,,0000,0000,0000,,Бұл жерде де айта кеткен жөн.
Dialogue: 0,0:15:45.52,0:15:50.05,ZWDB,,0000,0000,0000,,「」
Dialogue: 0,0:15:50.79,0:15:55.61,ZWDB,,0000,0000,0000,,Бұл компанияда төрт қызметкер бар, содан кейін компанияның жаңа бас кеңсесіне бесінші адам қажет...
Dialogue: 0,0:15:57.25,0:15:58.65,ZWDB,,0000,0000,0000,,Қарт келісе алмайды
Dialogue: 0,0:15:58.94,0:16:02.77,ZWDB,,0000,0000,0000,,Мектептен кейін мен мектепке келіп, өз көзқарасымды білдім.
Dialogue: 0,0:16:05.83,0:16:11.05,ZWDB,,0000,0000,0000,,Мысықтың компанияның мүшесі екенін түсіну керек.
Dialogue: 0,0:16:11.89,0:16:16.12,ZWDB,,0000,0000,0000,,Дегенмен, дөңес қамқоршының болуы жапондықтармен бірдей.
Dialogue: 0,0:16:16.61,0:16:19.30,ZWDB,,0000,0000,0000,,Бұл мен үшін жұмбақ
Dialogue: 0,0:16:19.47,0:16:20.34,ZWDB,,0000,0000,0000,,Мен өзімді инсульттан бас тартамын
Dialogue: 0,0:16:20.91,0:16:24.02,ZWDB,,0000,0000,0000,,Соның салдарынан бір адамның өлімі мәселесі қайта көтерілді.
Dialogue: 0,0:16:24.52,0:16:28.99,ZWDB,,0000,0000,0000,,Бұл рас, бірақ оны көру мүмкін емес.
Dialogue: 0,0:16:30.36,0:16:30.99,ZWDB,,0000,0000,0000,,Растау
Dialogue: 0,0:16:31.78,0:16:32.74,ZWDB,,0000,0000,0000,,Шынайы фигура
Dialogue: 0,0:16:33.14,0:16:35.18,ZWDB,,0000,0000,0000,,Сізге мектепке барудың қажеті жоқ.
Dialogue: 0,0:16:35.55,0:16:39.13,ZWDB,,0000,0000,0000,,Дегенмен, менің денемде басқа мінез бар.
Dialogue: 0,0:16:39.63,0:16:40.10,ZWDB,,0000,0000,0000,,Аты?
Dialogue: 0,0:16:40.70,0:16:42.10,ZWDB,,0000,0000,0000,,Тойшысының екінші тұлғасы пайда болды
Dialogue: 0,0:16:43.73,0:16:49.89,ZWDB,,0000,0000,0000,,Мені көрсең, мен баламын, мен баламын.
Dialogue: 0,0:16:50.19,0:16:51.56,ZWDB,,0000,0000,0000,,Мен өз кезегімді аяқтадым.
Dialogue: 0,0:16:52.48,0:16:55.96,ZWDB,,0000,0000,0000,,Ел халқының пайдасы мен зияны.
Dialogue: 0,0:16:56.03,0:16:57.52,ZWDB,,0000,0000,0000,,Жетінші жылдың бірінші күні
Dialogue: 0,0:16:57.90,0:17:01.33,ZWDB,,0000,0000,0000,,Мен бастапқыда 18-ші буын британдық адаммын.
Dialogue: 0,0:17:02.99,0:17:03.76,ZWDB,,0000,0000,0000,,Сәлем
Dialogue: 0,0:17:03.76,0:17:04.58,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:17:04.58,0:17:05.80,ZWDB,,0000,0000,0000,,Осы жерде кездескенше
Dialogue: 0,0:17:06.89,0:17:10.10,ZWDB,,0000,0000,0000,,Сіз алты гүлден ләззат ала аласыз
Dialogue: 0,0:17:11.32,0:17:12.51,ZWDB,,0000,0000,0000,,Бірінші қайта оқу…
Dialogue: 0,0:17:13.21,0:17:15.22,ZWDB,,0000,0000,0000,,Сіз алты гүлден ләззат ала аласыз
Dialogue: 0,0:17:18.82,0:17:19.52,ZWDB,,0000,0000,0000,,Иә
Dialogue: 0,0:17:23.70,0:17:25.34,ZWDB,,0000,0000,0000,,Қолданылуы… Жапон тілі қол жетімді.
Dialogue: 0,0:17:25.54,0:17:28.52,ZWDB,,0000,0000,0000,,Өлеңді оқығанда пайдаланған ағылшын тілін өзгертіңіз.
Dialogue: 0,0:17:30.68,0:17:36.69,ZWDB,,0000,0000,0000,,Менің...көзім...екінші болмысым жоғалып кетті.
Dialogue: 0,0:17:37.27,0:17:40.77,ZWDB,,0000,0000,0000,,Наня отбасы мүшелерінің бірі
Dialogue: 0,0:17:40.97,0:17:43.68,ZWDB,,0000,0000,0000,,Бастауыш 7 Бет – бұл бірінші субтабиғи идиоттың коды.
Dialogue: 0,0:17:44.85,0:17:46.41,ZWDB,,0000,0000,0000,,Дегенмен, мұны істеуге болады.
Dialogue: 0,0:17:48.85,0:17:50.02,ZWDB,,0000,0000,0000,,Бұл баратын жер
Dialogue: 0,0:17:50.12,0:17:54.09,ZWDB,,0000,0000,0000,,Сиқырдың қабылданбау мүмкіндігі бар, бірақ жау да шет қалмайды, сондықтан сақ болыңыз.
Dialogue: 0,0:17:54.91,0:17:56.53,ZWDB,,0000,0000,0000,,Рио Чидо
Dialogue: 0,0:18:00.51,0:18:07.51,ZWDB,,0000,0000,0000,,Жеті ойыншы қарт нағыз фаворит.
Dialogue: 0,0:18:07.71,0:18:12.46,ZWDB,,0000,0000,0000,,Иә, бірақ мен сені көре алмаймын.
Dialogue: 0,0:18:15.54,0:18:19.72,ZWDB,,0000,0000,0000,,Егер сіз әріптес болсаңыз және сіздің шеберіңіз осында болса, қайта тексеріңіз.
Dialogue: 0,0:18:20.11,0:18:23.59,ZWDB,,0000,0000,0000,,Кішкентай құс Ю Рикка Фукоу «Зұлым патша шынайы көз»
Dialogue: 0,0:18:23.99,0:18:28.69,ZWDB,,0000,0000,0000,,Бұл заңды емес екені анық.
Dialogue: 0,0:18:29.61,0:18:30.43,ZWDB,,0000,0000,0000,,Келесі жолы
Dialogue: 0,0:18:36.25,0:18:37.26,ZWDB,,0000,0000,0000,,Жарылыс нақты
Dialogue: 0,0:18:37.66,0:18:39.13,ZWDB,,0000,0000,0000,,Үлкен байланыс Құдайдың байланысы
Dialogue: 0,0:18:43.03,0:18:46.29,ZWDB,,0000,0000,0000,,(Sho World Exorcist)
Dialogue: 0,0:18:53.30,0:18:54.12,ZWDB,,0000,0000,0000,,«Қызымды қорғауға келгеніңе рахмет, Буггарати.
Dialogue: 0,0:18:56.10,0:18:58.27,ZWDB,,0000,0000,0000,,«Найзағай Құдайдың күші»
Dialogue: 0,0:19:16.88,0:19:17.92,ZWDB,,0000,0000,0000,,«Розаи Хоу но Кобан»
Dialogue: 0,0:19:24.09,0:19:25.85,ZWDB,,0000,0000,0000,,«Эйжока кесіртке қалқаны»
Dialogue: 0,0:19:29.58,0:19:31.22,ZWDB,,0000,0000,0000,,«Императорлық спираль»
Dialogue: 0,0:19:31.22,0:19:32.74,ZWDB,,0000,0000,0000,,“Lapu Lasis Rotation”
Dialogue: 0,0:19:37.29,0:19:39.33,ZWDB,,0000,0000,0000,,Сен дүниеден өттің
Dialogue: 0,0:19:40.15,0:19:43.77,ZWDB,,0000,0000,0000,,Гүлдер ұзақ уақытқа жақсы.
Dialogue: 0,0:19:44.10,0:19:46.11,ZWDB,,0000,0000,0000,,Көп нәрсе болды...
Dialogue: 0,0:19:46.68,0:19:51.55,ZWDB,,0000,0000,0000,,Сіз бе? Елордаға баруға күш салып үлгердіңіз.
Dialogue: 0,0:19:53.22,0:19:53.91,ZWDB,,0000,0000,0000,,Шынайы оқиға
Dialogue: 0,0:19:54.06,0:19:55.06,ZWDB,,0000,0000,0000,,Аняның үйіне қош келдіңіз
Dialogue: 0,0:19:55.23,0:19:57.06,ZWDB,,0000,0000,0000,,Қиын кезеңдегі ұйықтау рәсімінің соңы аяқталды.
Dialogue: 0,0:19:57.42,0:19:59.88,ZWDB,,0000,0000,0000,,Компания қызметінің кеңсесінде жұмыс істейтіндер үшін оқу сабағынан кейін
Dialogue: 0,0:20:00.20,0:20:00.63,ZWDB,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:20:01.57,0:20:04.73,ZWDB,,0000,0000,0000,,Егер сізде белсенді клуб болса, тырысыңыз.
Dialogue: 0,0:20:06.32,0:20:09.82,ZWDB,,0000,0000,0000,,Корпоративтік қызметті бастаңыз және тілегіңізге дайындалыңыз.
Dialogue: 0,0:20:10.07,0:20:11.56,ZWDB,,0000,0000,0000,,Қожайыныма мойынсұну
Dialogue: 0,0:20:12.31,0:20:12.93,ZWDB,,0000,0000,0000,,Юта Язе
Dialogue: 0,0:20:15.41,0:20:17.50,ZWDB,,0000,0000,0000,,Өлеңнің кіріспесі туралы өлең жаздым.
Dialogue: 0,0:20:19.12,0:20:23.27,ZWDB,,0000,0000,0000,,Достар энциклопедиясы
Dialogue: 0,0:20:23.47,0:20:27.27,ZWDB,,0000,0000,0000,,мырза.
Dialogue: 0,0:20:29.36,0:20:31.15,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:20:33.86,0:20:35.92,ZWDB,,0000,0000,0000,,Егер сіз қонғыңыз келсе, бізге қосылыңыз.
Dialogue: 0,0:20:36.91,0:20:39.67,ZWDB,,0000,0000,0000,,Фуканкей Футаншин
Dialogue: 0,0:20:40.02,0:20:47.15,ZWDB,,0000,0000,0000,,«Мабиногионның» бұл кітабында лакпен қара жалын елшісінің формасы және зұлым патшаның бұйрықтары суреттелген.
Dialogue: 0,0:20:47.35,0:20:49.04,ZWDB,,0000,0000,0000,,Намотоның оғаш оқиғасы біртүрлі оқиға туралы әңгіме
Dialogue: 0,0:20:49.22,0:20:55.20,ZWDB,,0000,0000,0000,,Міне, мен «Электр мұхитында», сиқыршы Мори Жаздың фотокітабы.
Dialogue: 0,0:20:55.43,0:20:59.01,ZWDB,,0000,0000,0000,,Дүниедегі барлық нәрселердің жазбалары
Dialogue: 0,0:21:00.10,0:21:01.62,ZWDB,,0000,0000,0000,,Хаокэнг кітабы
Dialogue: 0,0:21:03.08,0:21:04.33,ZWDB,,0000,0000,0000,,Зақым келтірілді
Dialogue: 0,0:21:04.48,0:21:07.68,ZWDB,,0000,0000,0000,,Бұған рұқсат етілгені анық.
Dialogue: 0,0:21:17.97,0:21:19.66,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:21:20.16,0:21:23.71,ZWDB,,0000,0000,0000,,Менде талант жоқ, бірақ мен оған оңай кіре алмаймын.
Dialogue: 0,0:21:24.14,0:21:26.47,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:21:27.57,0:21:30.05,ZWDB,,0000,0000,0000,,Оқиғаның шығу тегі Сіз біртүрлі клубқа қосылдыңыз
Dialogue: 0,0:21:30.40,0:21:32.46,ZWDB,,0000,0000,0000,,Мүлдем тегін
Dialogue: 0,0:21:32.86,0:21:35.32,ZWDB,,0000,0000,0000,,「」
Dialogue: 0,0:21:35.52,0:21:38.90,ZWDB,,0000,0000,0000,,Менің жоспарым - мен қалаға қосылдым және қалай қосылатынымды білмеймін.
Dialogue: 0,0:21:37.41,0:21:38.50,ZWDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:21:42.70,0:21:43.37,ZWDB,,0000,0000,0000,,Но Учикиоу Ичигоу
Dialogue: 0,0:21:43.52,0:21:44.64,ZWDB,,0000,0000,0000,,Басшы сатқындарды міндетті түрде түбірімен жояды…
Dialogue: 0,0:21:44.84,0:21:50.23,ZWDB,,0000,0000,0000,,Мен Тогаши-кунның клубына қосылғым келеді.
Dialogue: 0,0:21:50.88,0:21:52.69,ZWDB,,0000,0000,0000,,Аты? Кездесудің жоқтығы рас
Dialogue: 0,0:21:52.94,0:21:58.36,ZWDB,,0000,0000,0000,,Бұл дұрыс және компания атауы қайта қаралды.
Dialogue: 0,0:21:59.78,0:22:05.24,ZWDB,,0000,0000,0000,,「」
Dialogue: 0,0:22:11.04,0:22:12.95,ZWDB,,0000,0000,0000,,Бұл рас...
