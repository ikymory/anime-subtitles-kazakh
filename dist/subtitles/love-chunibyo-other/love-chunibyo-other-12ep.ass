Dialogue: 0,0:22:16.78,0:22:19.29,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:32.19,0:22:34.70,JPED,,0000,0000,0000,,Түсініспеушілік ұят па?
Dialogue: 0,0:22:34.70,0:22:37.03,JPED,,0000,0000,0000,,Адалдық зиян келтіреді.
Dialogue: 0,0:22:37.36,0:22:39.92,JPED,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:22:39.92,0:22:42.35,JPED,,0000,0000,0000,,Мен ненің дұрыс екенін білмеймін.
Dialogue: 0,0:22:42.55,0:22:45.16,JPED,,0000,0000,0000,,Әдеттегідей ағып жатқан күнделікті өмірде
Dialogue: 0,0:22:45.28,0:22:47.62,JPED,,0000,0000,0000,,Мен өзімді соған үйренуге мәжбүр еттім.
Dialogue: 0,0:22:47.62,0:22:50.25,JPED,,0000,0000,0000,,Суға батқан тұлға және қан
Dialogue: 0,0:22:50.45,0:22:52.67,JPED,,0000,0000,0000,,Шайнаңыз, ішіңіз, түкіріңіз және сындырыңыз
Dialogue: 0,0:22:52.67,0:22:57.09,JPED,,0000,0000,0000,,Мені осылай түсінгеніңізді қалаймын
Dialogue: 0,0:22:57.36,0:23:02.66,JPED,,0000,0000,0000,,Айтқым келеді, бірақ айта алмаймын.
Dialogue: 0,0:23:02.66,0:23:07.45,JPED,,0000,0000,0000,,Неге ешкім түсінбейді?
Dialogue: 0,0:23:07.68,0:23:12.62,JPED,,0000,0000,0000,,Бұл туралы ойлану сән-салтанат па? Солай ма?
Dialogue: 0,0:23:12.62,0:23:17.79,JPED,,0000,0000,0000,,Эмоциялық күн
Dialogue: 0,0:23:18.04,0:23:20.73,JPED,,0000,0000,0000,,Тым көп қызу
Dialogue: 0,0:23:20.73,0:23:23.01,JPED,,0000,0000,0000,,Бұл қандай да бір жолмен шешілетін сияқты
Dialogue: 0,0:23:23.16,0:23:28.08,JPED,,0000,0000,0000,,Айқайлағым келеді
Dialogue: 0,0:23:28.08,0:23:34.00,JPED,,0000,0000,0000,,ТҮСІКТІЛІКТІ іздеп жатыр
Dialogue: 0,0:23:34.27,0:23:36.76,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,JPED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,JPED,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:23:41.85,0:23:43.85,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:16.78,0:22:19.29,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,ZWED,,0000,0000,0000,,Қараған жерің – тұратын жерің.
Dialogue: 0,0:22:32.19,0:22:34.70,ZWED,,0000,0000,0000,,Жиналыста мен ұялдым
Dialogue: 0,0:22:34.70,0:22:37.03,ZWED,,0000,0000,0000,,Ашық шолу
Dialogue: 0,0:22:37.36,0:22:39.92,ZWED,,0000,0000,0000,,Оған күмән жоқ
Dialogue: 0,0:22:39.92,0:22:42.35,ZWED,,0000,0000,0000,,Белгісіз кірісімді түзететініме сенімдімін.
Dialogue: 0,0:22:42.55,0:22:45.16,ZWED,,0000,0000,0000,,Өзін-өзі анықтауды зерттеңіз
Dialogue: 0,0:22:45.28,0:22:47.62,ZWED,,0000,0000,0000,,Ичитоу Фуканнан келген Хико
Dialogue: 0,0:22:47.62,0:22:50.25,ZWED,,0000,0000,0000,,Қолбасшының эго мен қаны
Dialogue: 0,0:22:50.45,0:22:52.67,ZWED,,0000,0000,0000,,Шайнау, жылау, түкіру, ойнау
Dialogue: 0,0:22:52.67,0:22:57.09,ZWED,,0000,0000,0000,,Сіз мұны түсінесіз деп үміттенемін.
Dialogue: 0,0:22:57.36,0:23:02.66,ZWED,,0000,0000,0000,,Күтпеген ойлар ашылуы мүмкін.
Dialogue: 0,0:23:02.66,0:23:07.45,ZWED,,0000,0000,0000,,Мен адам қалмағанын түсінемін.
Dialogue: 0,0:23:07.68,0:23:12.62,ZWED,,0000,0000,0000,,Егер сізді түсінгіңіз келсе, солай етіңіз.
Dialogue: 0,0:23:12.62,0:23:17.79,ZWED,,0000,0000,0000,,Бұл эмоционалды күн
Dialogue: 0,0:23:18.04,0:23:20.73,ZWED,,0000,0000,0000,,Радиациялық жылу сыйымдылығы
Dialogue: 0,0:23:20.73,0:23:23.01,ZWED,,0000,0000,0000,,Өзін рахатқа ұшырататын теріс қылықтар
Dialogue: 0,0:23:23.16,0:23:28.08,ZWED,,0000,0000,0000,,Айқайлауға құмарлықты заңсыз шектеу
Dialogue: 0,0:23:28.08,0:23:34.00,ZWED,,0000,0000,0000,,ТҰРҒЫНДАР
Dialogue: 0,0:23:34.27,0:23:36.76,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,ZWED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,ZWED,,0000,0000,0000,,Қажетсіз кедергілер
Dialogue: 0,0:23:41.85,0:23:43.85,ZWED,,0000,0000,0000,,Қараған жерің – тұратын жерің.
Dialogue: 0,0:02:21.95,0:02:31.96,ZZ信息,,0000,0000,0000,,Бұл субтитрлер топтамасы субтитрлер тобында көрсетіледі және көбірек қытай, жапон және қытай субтитрлері алмасу үшін қолжетімді. www.kamigami.org
Dialogue: 0,0:02:21.95,0:02:31.96,ZZ信息,,0000,0000,0000,,JustiN
Dialogue: 0,0:02:36.71,0:02:42.64,ZWBT,,0000,0000,0000,,Соңғы әрекет)
Dialogue: 0,0:09:34.34,0:09:36.01,ZWZJ,,0000,0000,0000,,«Әлбетте»
Dialogue: 0,0:09:40.93,0:09:42.01,ZWZJ2,,0000,0000,0000,,«Менің батыл досым Юта»
Dialogue: 0,0:00:05.34,0:00:05.91,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:00:07.10,0:00:09.04,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:00:10.36,0:00:13.76,ZWDB,,0000,0000,0000,,Бұл экранды түртудің соңғы мүмкіндігі.
Dialogue: 0,0:00:14.73,0:00:15.70,ZWDB,,0000,0000,0000,,Басқа мысалдар
Dialogue: 0,0:00:18.29,0:00:18.71,ZWDB,,0000,0000,0000,,Өлім оқиғасы
Dialogue: 0,0:00:19.56,0:00:20.85,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:00:32.75,0:00:33.47,ZWDB,,0000,0000,0000,,Хаобинг суық
Dialogue: 0,0:00:36.95,0:00:37.92,ZWDB,,0000,0000,0000,,Ичиге Ичигоның құлпытасы
Dialogue: 0,0:00:44.01,0:00:47.24,ZWDB,,0000,0000,0000,,Кенеттен сәнден шығып кеткен оқиға туралы әңгіме.
Dialogue: 0,0:00:50.10,0:00:50.80,ZWDB,,0000,0000,0000,,Диан және басқалар…
Dialogue: 0,0:00:00.00,0:00:00.00,ZWDB,,0000,0000,0000,,Соңғы әрекет
Dialogue: 0,0:02:36.38,0:02:37.42,ZWDB,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:02:38.07,0:02:40.55,ZWDB,,0000,0000,0000,,Мен сізден хабар алдым.
Dialogue: 0,0:02:41.40,0:02:41.85,ZWDB,,0000,0000,0000,,Рио Чидо
Dialogue: 0,0:02:48.66,0:02:51.54,ZWDB,,0000,0000,0000,,Гато анық
Dialogue: 0,0:02:53.38,0:02:54.55,ZWDB,,0000,0000,0000,,Менің талантты болуым өте қажет.
Dialogue: 0,0:02:59.99,0:03:02.30,ZWDB,,0000,0000,0000,,Рикка Зайну Рикка
Dialogue: 0,0:03:12.29,0:03:13.39,ZWDB,,0000,0000,0000,,Мен тамақ ішуге келдім.
Dialogue: 0,0:03:18.83,0:03:21.61,ZWDB,,0000,0000,0000,,Кішкентай құспен сабақ оқығың келе ме? Мен бұл жүйеге тәуелдімін.
Dialogue: 0,0:03:22.13,0:03:24.89,ZWDB,,0000,0000,0000,,Тоғашыны зерттеудің жолы бар ма?
Dialogue: 0,0:03:25.54,0:03:27.20,ZWDB,,0000,0000,0000,,Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:03:27.35,0:03:30.51,ZWDB,,0000,0000,0000,,Куәлік оң.
Dialogue: 0,0:03:37.82,0:03:38.34,ZWDB,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:03:40.92,0:03:41.32,ZWDB,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:03:42.22,0:03:46.86,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:03:48.58,0:03:49.22,ZWDB,,0000,0000,0000,,Сәттілік...
Dialogue: 0,0:03:49.95,0:03:54.37,ZWDB,,0000,0000,0000,,Кейшин? Қара көктің ақ-қара тамырын оқығанда
Dialogue: 0,0:03:54.94,0:03:56.48,ZWDB,,0000,0000,0000,,Шығыс пен батыстағы халық жиналысы
Dialogue: 0,0:03:56.78,0:03:59.29,ZWDB,,0000,0000,0000,,Мен бұл туралы айтып жатырмын, мен бұл туралы айтып отырмын.
Dialogue: 0,0:03:59.66,0:04:03.91,ZWDB,,0000,0000,0000,,Бұл адамның менің сезімім бар және екі құйрығы бар.
Dialogue: 0,0:04:04.39,0:04:04.98,ZWDB,,0000,0000,0000,,Гакучо
Dialogue: 0,0:04:05.70,0:04:06.72,ZWDB,,0000,0000,0000,,Маған айқайлаңдар
Dialogue: 0,0:04:06.72,0:04:07.74,ZWDB,,0000,0000,0000,,Гакучо Каюу
Dialogue: 0,0:04:07.92,0:04:11.47,ZWDB,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:04:11.57,0:04:13.47,ZWDB,,0000,0000,0000,,Гакучо Гакучо
Dialogue: 0,0:04:13.66,0:04:15.72,ZWDB,,0000,0000,0000,,Әйел өз өмірін өзі ұстай алады. 46
Dialogue: 0,0:04:15.72,0:04:17.56,ZWDB,,0000,0000,0000,,Спектакльдің орындалуы
Dialogue: 0,0:04:21.34,0:04:23.97,ZWDB,,0000,0000,0000,,Әңгіме кенеттен аяқталды.
Dialogue: 0,0:04:27.50,0:04:30.56,ZWDB,,0000,0000,0000,,​​Нанодан кейін мен бұл туралы ойладым.
Dialogue: 0,0:04:31.25,0:04:34.39,ZWDB,,0000,0000,0000,,Шебер…фудзи гуаню кішкентай құс ойыны
Dialogue: 0,0:04:34.71,0:04:36.39,ZWDB,,0000,0000,0000,,Ұзақ студенттің әңгімесі
Dialogue: 0,0:04:38.71,0:04:42.19,ZWDB,,0000,0000,0000,,Юта Манабу Манабу Инака Манабу
Dialogue: 0,0:04:43.23,0:04:44.85,ZWDB,,0000,0000,0000,,Әңгімелесу Бұл сұлу қыз кім?
Dialogue: 0,0:04:47.91,0:04:48.35,ZWDB,,0000,0000,0000,,Медбике
Dialogue: 0,0:04:50.14,0:04:52.83,ZWDB,,0000,0000,0000,,7 мамырда студенттің көзі жұмылды
Dialogue: 0,0:04:53.47,0:04:55.01,ZWDB,,0000,0000,0000,,Буггарати? Меніңше, ол Неаполитандық бандит болған, иә?
Dialogue: 0,0:04:56.65,0:04:57.82,ZWDB,,0000,0000,0000,,Суық тиген соң
Dialogue: 0,0:04:58.34,0:04:59.69,ZWDB,,0000,0000,0000,,Бұл шабыттандыратын әңгіменің жақсы мысалы ғана.
Dialogue: 0,0:05:01.13,0:05:03.54,ZWDB,,0000,0000,0000,,Біраз уақыттан кейін бірінші рет.
Dialogue: 0,0:05:07.49,0:05:08.11,ZWDB,,0000,0000,0000,,Накореджия
Dialogue: 0,0:05:10.80,0:05:11.44,ZWDB,,0000,0000,0000,,Сочи Доу?
Dialogue: 0,0:05:12.04,0:05:13.36,ZWDB,,0000,0000,0000,,Бөлшек емес…
Dialogue: 0,0:05:13.73,0:05:14.65,ZWDB,,0000,0000,0000,,Манабу Инака
Dialogue: 0,0:05:15.27,0:05:19.47,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:05:19.89,0:05:20.74,ZWDB,,0000,0000,0000,,Сіздің атыңыз басқа
Dialogue: 0,0:05:20.49,0:05:22.18,ZWDB,,0000,0000,0000,,Ауырған... ауыратын оқиға
Dialogue: 0,0:05:23.17,0:05:23.75,ZWDB,,0000,0000,0000,,Өлім?
Dialogue: 0,0:05:24.37,0:05:26.43,ZWDB,,0000,0000,0000,,Мен кіші мектеп оқушысымын.
Dialogue: 0,0:05:26.75,0:05:27.90,ZWDB,,0000,0000,0000,,Ағымдағы таланттарға назар аудару
Dialogue: 0,0:05:28.17,0:05:31.80,ZWDB,,0000,0000,0000,,Лак-қара елшінің келуі
Dialogue: 0,0:05:32.27,0:05:33.26,ZWDB,,0000,0000,0000,,Қажет емес ат/ат шығуы
Dialogue: 0,0:05:34.38,0:05:35.97,ZWDB,,0000,0000,0000,,Менің көзім назар аударуды қажет етеді
Dialogue: 0,0:05:35.97,0:05:36.59,ZWDB,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:05:37.07,0:05:40.22,ZWDB,,0000,0000,0000,,Қажетсіз аударма
Dialogue: 0,0:05:40.94,0:05:44.65,ZWDB,,0000,0000,0000,,Әңгімелесу
Dialogue: 0,0:05:45.62,0:05:50.07,ZWDB,,0000,0000,0000,,Бұлай емес, бірақ зұлым патшаның шынайы көздері қабылданады.
Dialogue: 0,0:05:50.46,0:05:51.13,ZWDB,,0000,0000,0000,,Растау?
Dialogue: 0,0:05:51.81,0:05:58.27,ZWDB,,0000,0000,0000,,Мен осында болған айсыз түннің түнінде зұлым патша Шинган Шоджи иемденген қара күш аяқталды.
Dialogue: 0,0:05:59.09,0:06:01.77,ZWDB,,0000,0000,0000,,Мен де Зұлым Патшаның шынайы мұрагерімін.
Dialogue: 0,0:06:02.00,0:06:04.58,ZWDB,,0000,0000,0000,,Шығыста немесе Батыста жұмыс істеуді қажет етпей кетуге келісемін.
Dialogue: 0,0:06:05.20,0:06:06.82,ZWDB,,0000,0000,0000,,Накафуджио
Dialogue: 0,0:06:07.74,0:06:10.65,ZWDB,,0000,0000,0000,,Зұлым патшаның шынайы көздері ақыры жоғалды
Dialogue: 0,0:06:12.16,0:06:14.60,ZWDB,,0000,0000,0000,,Лак қара мен жалынның хабаршысы бар.
Dialogue: 0,0:06:17.83,0:06:19.00,ZWDB,,0000,0000,0000,,Бұл Рокка Нагаконың әңгімесі.
Dialogue: 0,0:06:19.77,0:06:20.06,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:06:23.30,0:06:25.83,ZWDB,,0000,0000,0000,,Сезімталдық жақсы.
Dialogue: 0,0:06:26.20,0:06:28.17,ZWDB,,0000,0000,0000,,Сен маған тиесілісің.
Dialogue: 0,0:06:29.53,0:06:31.10,ZWDB,,0000,0000,0000,,1-ші ретті жинақ
Dialogue: 0,0:06:31.99,0:06:36.57,ZWDB,,0000,0000,0000,,Бұл компания қызметінің егжей-тегжейлері.
Dialogue: 0,0:06:38.46,0:06:40.54,ZWDB,,0000,0000,0000,,Әңгіменің шығу тегі
Dialogue: 0,0:06:41.19,0:06:43.01,ZWDB,,0000,0000,0000,,Қайын енесі
Dialogue: 0,0:06:43.88,0:06:44.60,ZWDB,,0000,0000,0000,,Мен де ондай нәрсені түсінемін
Dialogue: 0,0:06:45.52,0:06:46.01,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:06:47.65,0:06:50.71,ZWDB,,0000,0000,0000,,Кафедра меңгерушісі өте құмар, оқуда белсенді студент.
Dialogue: 0,0:06:51.60,0:06:54.99,ZWDB,,0000,0000,0000,,Міне: «Егер мен мұнда келсем, мен Шығыс пен Батысты жасай алар едім».
Dialogue: 0,0:06:55.68,0:06:59.01,ZWDB,,0000,0000,0000,,Ю ``Жаңа дәуірдің мүмкіндіктері''
Dialogue: 0,0:06:59.68,0:07:01.45,ZWDB,,0000,0000,0000,,Адамдардың түрі көп.
Dialogue: 0,0:07:01.99,0:07:04.50,ZWDB,,0000,0000,0000,,Қолайсыз.
Dialogue: 0,0:07:05.15,0:07:10.77,ZWDB,,0000,0000,0000,,Бұл біраз бұрын болған оқиға.
Dialogue: 0,0:07:11.41,0:07:12.77,ZWDB,,0000,0000,0000,,Нақан орта мектептің екінші жылы
Dialogue: 0,0:07:16.78,0:07:19.44,ZWDB,,0000,0000,0000,,Тіпті орта мектепте
Dialogue: 0,0:07:19.99,0:07:25.16,ZWDB,,0000,0000,0000,,Өзінің бейнесі басқаларға ұқсамайды.
Dialogue: 0,0:07:26.28,0:07:28.99,ZWDB,,0000,0000,0000,,Дүние жүзіндегі басқа астаналар
Dialogue: 0,0:07:30.23,0:07:33.41,ZWDB,,0000,0000,0000,,Сосокан Тогаши Догаку Вагато Ю кіші орта мектебі Кіші орта мектебі
Dialogue: 0,0:07:33.78,0:07:37.59,ZWDB,,0000,0000,0000,,Қазіргі уақытта орта мектепте оқитын қарапайым орта мектеп оқушысы.
Dialogue: 0,0:07:38.06,0:07:38.63,ZWDB,,0000,0000,0000,,Есептеу
Dialogue: 0,0:07:39.42,0:07:43.87,ZWDB,,0000,0000,0000,,Мен теңізде екенімді растаудан басқа ештеңе істей алмаған қарапайым орта және кіші мектеп оқушысымын.
Dialogue: 0,0:07:44.00,0:07:47.23,ZWDB,,0000,0000,0000,,Осыдан кейін мен өз ойымды қорытындыладым.
Dialogue: 0,0:07:47.92,0:07:48.97,ZWDB,,0000,0000,0000,,Сіз оны толығымен елестете аласыз.
Dialogue: 0,0:07:49.42,0:07:55.31,ZWDB,,0000,0000,0000,,Бұл жай ғана өлім мәселесі.
Dialogue: 0,0:07:58.06,0:07:58.81,ZWDB,,0000,0000,0000,,Терең тереңдік
Dialogue: 0,0:08:00.60,0:08:03.06,ZWDB,,0000,0000,0000,,Тоғашы да дәл солай үйренді.
Dialogue: 0,0:08:04.35,0:08:06.29,ZWDB,,0000,0000,0000,,Мен жұмысымды аяқтадым.
Dialogue: 0,0:08:06.64,0:08:07.14,ZWDB,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:08:07.63,0:08:09.87,ZWDB,,0000,0000,0000,,Оның себебі, сыртқы түрі бұрынғыға ұқсайды.
Dialogue: 0,0:08:10.07,0:08:11.76,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:08:15.86,0:08:19.24,ZWDB,,0000,0000,0000,,Сол мектепте болмаған кішкентай құстың әңгімесін тыңдаңыз.
Dialogue: 0,0:08:19.84,0:08:21.43,ZWDB,,0000,0000,0000,,Ол сондай-ақ «жоқ» болып табылады.
Dialogue: 0,0:08:22.55,0:08:23.94,ZWDB,,0000,0000,0000,,Әңгімелесу Мен де жалғыздықтан айырылдым
Dialogue: 0,0:08:24.11,0:08:28.88,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:08:37.31,0:08:39.77,ZWDB,,0000,0000,0000,,Рикка Рикка
Dialogue: 0,0:08:40.54,0:08:42.08,ZWDB,,0000,0000,0000,,Бұл мүлдем тұрарлық.
Dialogue: 0,0:08:43.37,0:08:44.74,ZWDB,,0000,0000,0000,,Бұл кездесуге кіріспе емес.
Dialogue: 0,0:08:45.36,0:08:46.65,ZWDB,,0000,0000,0000,,Мен бұл туралы айтқым келмейді, бірақ мен оны бірінші рет тастаймын.
Dialogue: 0,0:08:49.51,0:08:51.58,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:08:52.10,0:08:54.01,ZWDB,,0000,0000,0000,,Пойыз жарты жолда тоқтады.
Dialogue: 0,0:08:54.43,0:08:55.06,ZWDB,,0000,0000,0000,,Бұл баратын жер
Dialogue: 0,0:09:00.08,0:09:00.57,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:09:03.33,0:09:06.99,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:09:07.88,0:09:10.69,ZWDB,,0000,0000,0000,,Мен сендермен кездескенде жеңілденетінімді хабарлаймын.
Dialogue: 0,0:09:12.30,0:09:15.19,ZWDB,,0000,0000,0000,,Сондықтан менің ойларым әрқашан ең жақсы таңдау болып табылады.
Dialogue: 0,0:09:16.48,0:09:18.02,ZWDB,,0000,0000,0000,,Ютая осыны ойлап отыр
Dialogue: 0,0:09:20.08,0:09:23.91,ZWDB,,0000,0000,0000,,Нәтижесінде барлығы мен жаратылған.
Dialogue: 0,0:09:25.05,0:09:26.20,ZWDB,,0000,0000,0000,,Кірпіктердің жойылғанына күмән жоқ.
Dialogue: 0,0:09:27.24,0:09:28.98,ZWDB,,0000,0000,0000,,Егер сіз орта мектепте оқитын болсаңыз, шыдамды болыңыз.
Dialogue: 0,0:09:31.86,0:09:32.29,ZWDB,,0000,0000,0000,,Астана – мен…
Dialogue: 0,0:09:44.74,0:09:47.50,ZWDB,,0000,0000,0000,,Бұл қара лак...
Dialogue: 0,0:09:52.24,0:09:53.94,ZWDB,,0000,0000,0000,,«Мөрді алған кезде
Dialogue: 0,0:09:54.51,0:09:57.51,ZWDB,,0000,0000,0000,,Лакты қара қалдыру қажет емес.
Dialogue: 0,0:09:58.43,0:10:03.85,ZWDB,,0000,0000,0000,,2012 жылы бүкіл әлем толқындық жалпы жиналыстың жойылуымен жабылды.
Dialogue: 0,0:10:04.35,0:10:06.46,ZWDB,,0000,0000,0000,,Психикалық толқындарыңыз өзгерсе, сіз осал болмайсыз.
Dialogue: 0,0:10:08.10,0:10:10.74,ZWDB,,0000,0000,0000,,Осының арқасында сіз бүкіл қаланы толығымен басқара аласыз және бастапқы мүмкіндікті аша аласыз.
Dialogue: 0,0:10:11.38,0:10:16.73,ZWDB,,0000,0000,0000,,Көз алдында тұрған ақымақ қарапайым адам.
Dialogue: 0,0:10:18.09,0:10:20.60,ZWDB,,0000,0000,0000,,Мен қазіргі жағдайға жауаптымын.
Dialogue: 0,0:10:21.30,0:10:22.67,ZWDB,,0000,0000,0000,,Бұл конверттің көшірмесі.
Dialogue: 0,0:10:24.43,0:10:28.68,ZWDB,,0000,0000,0000,,Лак Қара жалын Елшісі Алданудың қажеті жоқ Сізде күшті сома бар
Dialogue: 0,0:10:29.38,0:10:32.48,ZWDB,,0000,0000,0000,,Сіз қараңғылықтың қара патшасысыз - зұлым патшаның қатысуы.
Dialogue: 0,0:10:33.98,0:10:36.93,ZWDB,,0000,0000,0000,,Сіз бірегей және тәуелсізсіз».
Dialogue: 0,0:10:38.72,0:10:41.33,ZWDB,,0000,0000,0000,,Бұл кіші мектептің екінші жылынан кейінгі өз-өзіне ықпал еткен сенім.
Dialogue: 0,0:10:43.22,0:10:45.51,ZWDB,,0000,0000,0000,,Бұл суретке ұқсас.
Dialogue: 0,0:10:54.18,0:10:59.05,ZWDB,,0000,0000,0000,,Қарапайым адамның жанында ойнайтын күш жоқ.
Dialogue: 0,0:11:00.64,0:11:00.94,ZWDB,,0000,0000,0000,,7-ші эпизод: Секси тапанша дебют жасайды – Бірінші бөлім
Dialogue: 0,0:11:09.02,0:11:09.67,ZWDB,,0000,0000,0000,,Артқа
Dialogue: 0,0:11:11.95,0:11:13.02,ZWDB,,0000,0000,0000,,Нашу өлім заңы
Dialogue: 0,0:11:13.99,0:11:16.87,ZWDB,,0000,0000,0000,,Жалға алсаңыз, қаланы тастап кете аласыз.
Dialogue: 0,0:11:17.82,0:11:18.87,ZWDB,,0000,0000,0000,,Гакёги Рокка Кайрай
Dialogue: 0,0:11:19.48,0:11:22.66,ZWDB,,0000,0000,0000,,Кішкентай құс оқушысы...
Dialogue: 0,0:11:28.60,0:11:32.26,ZWDB,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:11:32.98,0:11:35.79,ZWDB,,0000,0000,0000,,Мен өз отбасым туралы не ойлаймын?
Dialogue: 0,0:11:37.58,0:11:39.89,ZWDB,,0000,0000,0000,,Мен...
Dialogue: 0,0:11:44.29,0:11:44.56,ZWDB,,0000,0000,0000,,Уолтер Эванс (59)
Dialogue: 0,0:11:50.60,0:11:56.47,ZWDB,,0000,0000,0000,,​​Лак қара жалынның өкілі Мен зұлым патшаның шынайы көзінің екінші ұрпағымын.
Dialogue: 0,0:12:09.84,0:12:11.78,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:12:13.42,0:12:13.96,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:12:22.39,0:12:24.03,ZWDB,,0000,0000,0000,,Мүлдем шындыққа жанаспайды
Dialogue: 0,0:12:24.87,0:12:27.16,ZWDB,,0000,0000,0000,,Күтпеген жағдайларға байланысты өзгерістер
Dialogue: 0,0:12:28.23,0:12:30.84,ZWDB,,0000,0000,0000,,In front of the father who arrived directly after the past life
Dialogue: 0,0:12:32.41,0:12:34.54,ZWDB,,0000,0000,0000,,It was a good outcome for the disease to be cured.
Dialogue: 0,0:12:40.81,0:12:41.38,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:12:42.72,0:12:45.11,ZWDB,,0000,0000,0000,,Мен...
Dialogue: 0,0:12:51.77,0:12:54.58,ZWDB,,0000,0000,0000,,Мен кеңседе жүргенде Юутамен таныстым.
Dialogue: 0,0:12:56.56,0:12:58.00,ZWDB,,0000,0000,0000,,Біз Роккаға жеттік пе?
Dialogue: 0,0:12:58.58,0:13:04.99,ZWDB,,0000,0000,0000,,Rikka... The evil king's true eyes were two years ago.
Dialogue: 0,0:13:05.96,0:13:08.05,ZWDB,,0000,0000,0000,,Үйіңізге келгенде
Dialogue: 0,0:13:08.99,0:13:09.69,ZWDB,,0000,0000,0000,,Тасымалдау үйі?
Dialogue: 0,0:13:10.08,0:13:13.86,ZWDB,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:14.66,0:13:16.20,ZWDB,,0000,0000,0000,,Нагатоның жергілікті қызметкерлері
Dialogue: 0,0:13:21.19,0:13:23.93,ZWDB,,0000,0000,0000,,Заңды жағдайлар да бар.
Dialogue: 0,0:13:24.62,0:13:25.34,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:13:35.58,0:13:39.98,ZWDB,,0000,0000,0000,,Ауырды... Ауырды. Бұл рас.
Dialogue: 0,0:13:46.22,0:13:47.49,ZWDB,,0000,0000,0000,,Ауаның өзгеруі және жабысқақтығы
Dialogue: 0,0:13:48.31,0:13:50.37,ZWDB,,0000,0000,0000,,Тұрақты жұмысқа жақын
Dialogue: 0,0:13:51.22,0:13:53.43,ZWDB,,0000,0000,0000,,After Nano, you will be able to see the heavenly capital and study with Togashi. 16
Dialogue: 0,0:13:54.08,0:13:57.48,ZWDB,,0000,0000,0000,,Сіз мұнда жұмыстасыз
Dialogue: 0,0:13:59.64,0:14:02.50,ZWDB,,0000,0000,0000,,Бұл соңы... Бұл кім?
Dialogue: 0,0:14:03.82,0:14:05.06,ZWDB,,0000,0000,0000,,Онда кім бар?
Dialogue: 0,0:14:05.63,0:14:07.32,ZWDB,,0000,0000,0000,,Алты гүл
Dialogue: 0,0:14:07.77,0:14:10.26,ZWDB,,0000,0000,0000,,It is possible to understand the actual situation and imagine it.
Dialogue: 0,0:14:10.90,0:14:15.20,ZWDB,,0000,0000,0000,,Өзін-өзі басу сезімдері
Dialogue: 0,0:14:15.48,0:14:17.66,ZWDB,,0000,0000,0000,,Нагатадағы Тогаши-кун
Dialogue: 0,0:14:32.13,0:14:33.15,ZWDB,,0000,0000,0000,,Бұл ниет.
Dialogue: 0,0:14:35.01,0:14:37.97,ZWDB,,0000,0000,0000,,It is also true that Chuunibyou is in the middle school...
Dialogue: 0,0:14:40.50,0:14:43.68,ZWDB,,0000,0000,0000,,Rikka is a child who suffered from two diseases in middle school.
Dialogue: 0,0:14:44.58,0:14:49.77,ZWDB,,0000,0000,0000,,Please pay attention to Togashi-kun, a girl who is admired and has a fantastic ability and ability.
Dialogue: 0,0:14:50.64,0:14:55.29,ZWDB,,0000,0000,0000,,Адамның қабілетін тарту
Dialogue: 0,0:14:56.68,0:14:58.40,ZWDB,,0000,0000,0000,,Тоғашы-күн бақытты адам.
Dialogue: 0,0:14:59.62,0:15:02.20,ZWDB,,0000,0000,0000,,Тоғаши-кунның пікірлерді оқи білуі
Dialogue: 0,0:15:03.64,0:15:08.69,ZWDB,,0000,0000,0000,,Рокукаеничичото Ичичоичото
Dialogue: 0,0:15:11.50,0:15:12.02,ZWDB,,0000,0000,0000,,Ичичото…
Dialogue: 0,0:15:20.77,0:15:26.83,ZWDB,,0000,0000,0000,,Рикка!
Dialogue: 0,0:15:28.67,0:15:29.12,ZWDB,,0000,0000,0000,,Юта?
Dialogue: 0,0:15:41.55,0:15:43.01,ZWDB,,0000,0000,0000,,Токуакисуирё
Dialogue: 0,0:16:09.51,0:16:10.13,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:16:12.69,0:16:13.81,ZWDB,,0000,0000,0000,,Мен Ютамын
Dialogue: 0,0:16:24.10,0:16:24.89,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:16:25.61,0:16:29.17,ZWDB,,0000,0000,0000,,Кішкентай құс Ю Рикка Фукоу Джау Шинган
Dialogue: 0,0:16:30.23,0:16:31.92,ZWDB,,0000,0000,0000,,Шығыс пен Батыс туралы не ойлайсыз?
Dialogue: 0,0:16:32.92,0:16:33.49,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:16:44.67,0:16:48.43,ZWDB,,0000,0000,0000,,Ваганың соңғы келісімшарты
Dialogue: 0,0:16:50.32,0:16:52.18,ZWDB,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:16:52.50,0:16:54.12,ZWDB,,0000,0000,0000,,Сізбен бірге жұмыртқа араласады
Dialogue: 0,0:16:54.12,0:16:54.89,ZWDB,,0000,0000,0000,,Мелони
Dialogue: 0,0:16:56.68,0:16:57.43,ZWDB,,0000,0000,0000,,Рикка Гарай
Dialogue: 0,0:16:58.42,0:16:58.87,ZWDB,,0000,0000,0000,,Қателік
Dialogue: 0,0:16:59.31,0:17:00.93,ZWDB,,0000,0000,0000,,Әлемді аралау керек
Dialogue: 0,0:17:01.28,0:17:04.93,ZWDB,,0000,0000,0000,,Мен көтеріліп, шынайы әлемді өзгертемін.
Dialogue: 0,0:17:08.49,0:17:09.21,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:17:11.77,0:17:12.31,ZWDB,,0000,0000,0000,,Қарт әйел
Dialogue: 0,0:17:12.31,0:17:13.01,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:17:14.65,0:17:15.17,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:17:15.35,0:17:15.92,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:17:22.93,0:17:23.52,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:17:29.86,0:17:32.02,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:17:32.52,0:17:33.22,ZWDB,,0000,0000,0000,,Бұл кездесу
Dialogue: 0,0:17:33.39,0:17:36.57,ZWDB,,0000,0000,0000,,~
Dialogue: 0,0:17:38.58,0:17:40.62,ZWDB,,0000,0000,0000,,Жақсы нүкте комбинациясы
Dialogue: 0,0:17:41.22,0:17:42.66,ZWDB,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:17:44.35,0:17:45.89,ZWDB,,0000,0000,0000,,Сені тағы да көрейін
Dialogue: 0,0:17:45.99,0:17:47.13,ZWDB,,0000,0000,0000,,~
Dialogue: 0,0:17:47.13,0:17:48.87,ZWDB,,0000,0000,0000,,т.б.
Dialogue: 0,0:17:49.32,0:17:51.48,ZWDB,,0000,0000,0000,,Бұл менің себебім емес.
Dialogue: 0,0:17:52.20,0:17:53.20,ZWDB,,0000,0000,0000,,Насаи әулетінің қонақ бөлмесі
Dialogue: 0,0:17:53.40,0:17:55.24,ZWDB,,0000,0000,0000,,Жылдам жүгіріңіз
Dialogue: 0,0:17:55.48,0:17:56.03,ZWDB,,0000,0000,0000,,Сіз
Dialogue: 0,0:17:56.65,0:17:59.34,ZWDB,,0000,0000,0000,,Мен шағын көлікте отырмын.
Dialogue: 0,0:18:00.46,0:18:00.80,ZWDB,,0000,0000,0000,,Неаполь, таңғы 11:26
Dialogue: 0,0:18:04.36,0:18:06.52,ZWDB,,0000,0000,0000,,Біз және т.б.
Dialogue: 0,0:18:12.56,0:18:13.21,ZWDB,,0000,0000,0000,,Аяқтарды тартқыш аяқталды
Dialogue: 0,0:18:13.83,0:18:14.47,ZWDB,,0000,0000,0000,,Сіз осындасыз ба?
Dialogue: 0,0:18:15.12,0:18:20.96,ZWDB,,0000,0000,0000,,Тыныштық – лакталған қара елшінің күші.
Dialogue: 0,0:18:28.62,0:18:29.49,ZWDB,,0000,0000,0000,,Жарық
Dialogue: 0,0:18:30.28,0:18:31.13,ZWDB,,0000,0000,0000,,Жақсы дрифтинг рио
Dialogue: 0,0:18:34.56,0:18:38.90,ZWDB,,0000,0000,0000,,Кемедегі фонардан түсетін жарық дәл осы.
Dialogue: 0,0:18:42.48,0:18:43.03,ZWDB,,0000,0000,0000,,Төмен келе жатқан көлік
Dialogue: 0,0:18:48.27,0:18:49.64,ZWDB,,0000,0000,0000,,Бұл қараңғы күш
Dialogue: 0,0:18:54.02,0:18:57.45,ZWDB,,0000,0000,0000,,Жарылғыш бөліктің шындығы
Dialogue: 0,0:18:59.66,0:19:08.31,ZWDB,,0000,0000,0000,,Жалпы дүниеден қуылған
Dialogue: 0,0:19:18.87,0:19:19.57,ZWDB,,0000,0000,0000,,Юта…
Dialogue: 0,0:19:21.83,0:19:23.29,ZWDB,,0000,0000,0000,,Шекара сызығын көру мүмкін емес
Dialogue: 0,0:19:24.41,0:19:25.80,ZWDB,,0000,0000,0000,,Жарық сәулесінің дұрыс екенін ескеріңіз.
Dialogue: 0,0:19:27.97,0:19:30.68,ZWDB,,0000,0000,0000,,Қандай ойларыңыз бар?
Dialogue: 0,0:19:31.89,0:19:33.78,ZWDB,,0000,0000,0000,,Тікелей, заңсыз адамның ойы
Dialogue: 0,0:19:39.60,0:19:40.64,ZWDB,,0000,0000,0000,,Мәңгілік соңы
Dialogue: 0,0:19:49.96,0:19:51.16,ZWDB,,0000,0000,0000,,Мәңгі
Dialogue: 0,0:20:02.32,0:20:03.68,ZWDB,,0000,0000,0000,,Мәңгілік соңы
Dialogue: 0,0:20:27.62,0:20:30.62,ZWDB,,0000,0000,0000,,Қала тіліндегі орта мектеп оқушысы кім?
Dialogue: 0,0:20:31.64,0:20:35.25,ZWDB,,0000,0000,0000,,Еске алу қайталанып, естеліктер теңіз астында жойылды.
Dialogue: 0,0:20:37.14,0:20:42.68,ZWDB,,0000,0000,0000,,Дегенмен, бұрын менің жеке мінез-құлқым басқаша болды және менің шынайы болмысым жоғалып кетті.
Dialogue: 0,0:20:44.07,0:20:47.40,ZWDB,,0000,0000,0000,,Өзін-өзі адастыратын өзін-өзі бақылау
Dialogue: 0,0:20:47.82,0:20:52.77,ZWDB,,0000,0000,0000,,Мендік қозғалысының түсін орнатқаннан кейін адамның өзін толық түсінуіне қол жеткізіледі, бұл адамның өз түсінің өзін.
Dialogue: 0,0:20:56.62,0:21:01.32,ZWDB,,0000,0000,0000,,Бір сәтте армандар әлемі кенеттен өзгереді.
Dialogue: 0,0:21:01.84,0:21:07.51,ZWDB,,0000,0000,0000,,Алыс болашақты елестету, теңіз астында жоқ құмарлық махаббат хикаясы
Dialogue: 0,0:21:09.65,0:21:15.04,ZWDB,,0000,0000,0000,,Туылғаннан өлгенге дейін өміріміздегі барлығымыз тікелей жауаптымыз.
Dialogue: 0,0:21:15.66,0:21:17.37,ZWDB,,0000,0000,0000,,Үздіксіз көп қабатты
Dialogue: 0,0:21:18.07,0:21:21.45,ZWDB,,0000,0000,0000,,Киімді киюде аздап қиындық бар, бірақ оған қараған адам оны көреді және жақсы көреді.
Dialogue: 0,0:21:22.17,0:21:25.13,ZWDB,,0000,0000,0000,,Эго-саналы атақты «ауру»
Dialogue: 0,0:21:26.37,0:21:29.90,ZWDB,,0000,0000,0000,,Заңсыздықтан аулақ болатын эгоизм
Dialogue: 0,0:21:31.17,0:21:35.62,ZWDB,,0000,0000,0000,,Қалада әр адамның өмірі қалыпты екені рас.
Dialogue: 0,0:21:53.56,0:21:54.46,ZWDB,,0000,0000,0000,,Керемет...
Dialogue: 0,0:22:03.78,0:22:05.96,ZWDB,,0000,0000,0000,,Менің көзім назар аударуды қажет етеді
Dialogue: 0,0:22:08.55,0:22:11.81,ZWDB,,0000,0000,0000,,Дегенмен, орта мектеп ауруының нәтижесі адамдарға түсіну қиын.