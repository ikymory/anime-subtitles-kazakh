Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0000,0000,0000,,
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0000,0000,0000,,

Dialogue: 0,0:00:05.34,0:00:05.91,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:00:07.10,0:00:09.04,JPDB,,0000,0000,0000,,Анам әкеммен қоштасуымды өтінді.
Dialogue: 0,0:00:10.36,0:00:13.76,JPDB,,0000,0000,0000,,Бұл сіздің марқұмға қол тигізудің соңғы мүмкіндігі.
Dialogue: 0,0:00:14.73,0:00:15.70,JPDB,,0000,0000,0000,,Маған түртіңіз
Dialogue: 0,0:00:18.29,0:00:18.71,JPDB,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:00:19.56,0:00:20.85,JPDB,,0000,0000,0000,,Иә, бәрібір
Dialogue: 0,0:00:32.75,0:00:33.47,JPDB,,0000,0000,0000,,Салқын.
Dialogue: 0,0:00:36.95,0:00:37.92,JPDB,,0000,0000,0000,,Оны жуыңыз.
Dialogue: 0,0:00:44.01,0:00:47.24,JPDB,,0000,0000,0000,,Егер сіз кенеттен үстіме бірдеңе қойсаңыз, әкем суық дейді.
Dialogue: 0,0:00:50.10,0:00:50.80,JPDB,,0000,0000,0000,,Әкем...
Dialogue: 0,0:00:00.00,0:00:00.00,JPDB,,0000,0000,0000,,Мәңгілік келісім
Dialogue: 0,0:02:36.38,0:02:37.42,JPDB,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:02:38.07,0:02:40.55,JPDB,,0000,0000,0000,,Маған хат келді, сондықтан оны үстелімнің үстіне қалдырдым.
Dialogue: 0,0:02:41.40,0:02:41.85,JPDB,,0000,0000,0000,,Ах
Dialogue: 0,0:02:48.66,0:02:51.54,JPDB,,0000,0000,0000,,Мен білемін, Өлім.
Dialogue: 0,0:02:53.38,0:02:54.55,JPDB,,0000,0000,0000,,Мен не істеуім керек еді?
Dialogue: 0,0:02:59.99,0:03:02.30,JPDB,,0000,0000,0000,,Рокка бар ма? Рокка
Dialogue: 0,0:03:12.29,0:03:13.39,JPDB,,0000,0000,0000,,Сіз ақымақсыз ба?
Dialogue: 0,0:03:18.83,0:03:21.61,JPDB,,0000,0000,0000,,Которию мырза? Мен ерекше ештеңе естіген жоқпын.
Dialogue: 0,0:03:22.13,0:03:24.89,JPDB,,0000,0000,0000,,Тоғаши-кун төбелесіп қалды ма?
Dialogue: 0,0:03:25.54,0:03:27.20,JPDB,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:03:27.35,0:03:30.51,JPDB,,0000,0000,0000,,Өтірік, мен ұрысып қалдық деп ойлаймын.
Dialogue: 0,0:03:37.82,0:03:38.34,JPDB,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:03:40.92,0:03:41.32,JPDB,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:03:42.22,0:03:46.86,JPDB,,0000,0000,0000,,Маған ұнамайды, Сенпай, мен Декоморимін, мен Санае Декоморимін.
Dialogue: 0,0:03:48.58,0:03:49.22,JPDB,,0000,0000,0000,,Бұл жиіркенішті
Dialogue: 0,0:03:49.95,0:03:54.37,JPDB,,0000,0000,0000,,Бұл жиіркенішті ме? Мүмкін сіз қара ағаштың тамырын жеген шығарсыз?
Dialogue: 0,0:03:54.94,0:03:56.48,JPDB,,0000,0000,0000,,Мұны кім жейді?
Dialogue: 0,0:03:56.78,0:03:59.29,JPDB,,0000,0000,0000,,Бұл сенсің. Бұл қандай шаш?
Dialogue: 0,0:03:59.66,0:04:03.91,JPDB,,0000,0000,0000,,Жоқ, мен қос құйрықты да балалық деп ойладым.
Dialogue: 0,0:04:04.39,0:04:04.98,JPDB,,0000,0000,0000,,Аға
Dialogue: 0,0:04:05.70,0:04:06.72,JPDB,,0000,0000,0000,,Мені сенпай деп атама.
Dialogue: 0,0:04:06.72,0:04:07.74,JPDB,,0000,0000,0000,,Бұл Сенпай Гамба.
Dialogue: 0,0:04:07.92,0:04:11.47,JPDB,,0000,0000,0000,,Тоқта. Сіз бұлай сөйлегенде біртүрлі сезінесіз.
Dialogue: 0,0:04:11.57,0:04:13.47,JPDB,,0000,0000,0000,,Мені жіберіңізші, Сенпай.
Dialogue: 0,0:04:13.66,0:04:15.72,JPDB,,0000,0000,0000,,Шаш – әйелдің өмірі.
Dialogue: 0,0:04:15.72,0:04:17.56,JPDB,,0000,0000,0000,,Оны жеңіл ұстаңыз, т.б.
Dialogue: 0,0:04:21.34,0:04:23.97,JPDB,,0000,0000,0000,,Менің ойымша, бұл тым кенеттен болды. Не болды?
Dialogue: 0,0:04:27.50,0:04:30.56,JPDB,,0000,0000,0000,,Жоқ, содан бері мен бұл туралы көп ойладым.
Dialogue: 0,0:04:31.25,0:04:34.39,JPDB,,0000,0000,0000,,Ұстаз... Жоқ, мен Көтори-сенпайды айтып отырмын.
Dialogue: 0,0:04:34.71,0:04:36.39,JPDB,,0000,0000,0000,,Менің ағамның айтқаны
Dialogue: 0,0:04:38.71,0:04:42.19,JPDB,,0000,0000,0000,,Юта Сенпай Кумин Сенпай
Dialogue: 0,0:04:43.23,0:04:44.85,JPDB,,0000,0000,0000,,Мынау қандай сұлу қыз?
Dialogue: 0,0:04:47.91,0:04:48.35,JPDB,,0000,0000,0000,,Қара…
Dialogue: 0,0:04:50.14,0:04:52.83,JPDB,,0000,0000,0000,,Ей, 7 мамыр Сенпай, көзіңе не болды?
Dialogue: 0,0:04:53.47,0:04:55.01,JPDB,,0000,0000,0000,,Жоқ, менде бәрі жақсы.
Dialogue: 0,0:04:56.65,0:04:57.82,JPDB,,0000,0000,0000,,Мүмкін суық тиген шығар?
Dialogue: 0,0:04:58.34,0:04:59.69,JPDB,,0000,0000,0000,,Бұл жай ғана суық деп үміттенемін.
Dialogue: 0,0:05:01.13,0:05:03.54,JPDB,,0000,0000,0000,,Жарайды, мынаны ғана іш.
Dialogue: 0,0:05:07.49,0:05:08.11,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:05:10.80,0:05:11.44,JPDB,,0000,0000,0000,,Білгіңіз келе ме?
Dialogue: 0,0:05:12.04,0:05:13.36,JPDB,,0000,0000,0000,,Жоқ, ммм.
Dialogue: 0,0:05:13.73,0:05:14.65,JPDB,,0000,0000,0000,,Кумин Сенпай
Dialogue: 0,0:05:15.27,0:05:19.47,JPDB,,0000,0000,0000,,Әй, бұл киімде не болды? Бұл ұят.
Dialogue: 0,0:05:19.89,0:05:20.74,JPDB,,0000,0000,0000,,Сіз айтасыз.
Dialogue: 0,0:05:20.49,0:05:22.18,JPDB,,0000,0000,0000,,Бұл ауырады.
Dialogue: 0,0:05:23.17,0:05:23.75,JPDB,,0000,0000,0000,,Өлім?
Dialogue: 0,0:05:24.37,0:05:26.43,JPDB,,0000,0000,0000,,Бұл жігіт орта мектеп оқушысы ма?
Dialogue: 0,0:05:26.75,0:05:27.90,JPDB,,0000,0000,0000,,​​Жаңа ғана байқадыңыз ба?
Dialogue: 0,0:05:28.17,0:05:31.80,JPDB,,0000,0000,0000,,Қараңғы жалын шебері, келдің бе?
Dialogue: 0,0:05:32.27,0:05:33.26,JPDB,,0000,0000,0000,,Өтінемін, айтпа
Dialogue: 0,0:05:34.38,0:05:35.97,JPDB,,0000,0000,0000,,Менің көзімді көріп тұрсың ба?
Dialogue: 0,0:05:35.97,0:05:36.59,JPDB,,0000,0000,0000,,Жоқ, бәрі жақсы.
Dialogue: 0,0:05:37.07,0:05:40.22,JPDB,,0000,0000,0000,,Иә? олай айтпа
Dialogue: 0,0:05:40.94,0:05:44.65,JPDB,,0000,0000,0000,,Жоқ, одан да маңыздысы, сен неге Риккаға еліктейсің?
Dialogue: 0,0:05:45.62,0:05:50.07,JPDB,,0000,0000,0000,,Бұл еліктеу емес, ол Джау Шингеннен қалған.
Dialogue: 0,0:05:50.46,0:05:51.13,JPDB,,0000,0000,0000,,Дәстүр?
Dialogue: 0,0:05:51.81,0:05:58.27,JPDB,,0000,0000,0000,,Иә, сол айсыз түнде ол өзінің бар қара күшін маған сеніп тапсырды.
Dialogue: 0,0:05:59.09,0:06:01.77,JPDB,,0000,0000,0000,,Басқаша айтқанда, мен Зұлым патша Шинганның мұрагерімін.
Dialogue: 0,0:06:02.00,0:06:04.58,JPDB,,0000,0000,0000,,Бұл жақсы, сізге мұндай нәрсені мұрагер етудің қажеті жоқ.
Dialogue: 0,0:06:05.20,0:06:06.82,JPDB,,0000,0000,0000,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:06:07.74,0:06:10.65,JPDB,,0000,0000,0000,,Джау Шинген өмірін жалғастыруы керек.
Dialogue: 0,0:06:12.16,0:06:14.60,JPDB,,0000,0000,0000,,Қараңғы жалын шебері бар болғанша
Dialogue: 0,0:06:17.83,0:06:19.00,JPDB,,0000,0000,0000,,Рикка осылай деді ме?
Dialogue: 0,0:06:19.77,0:06:20.06,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:06:23.30,0:06:25.83,JPDB,,0000,0000,0000,,Бұл керемет...
Dialogue: 0,0:06:26.20,0:06:28.17,JPDB,,0000,0000,0000,,Ақыр соңында сіз қайсысысыз?
Dialogue: 0,0:06:29.53,0:06:31.10,JPDB,,0000,0000,0000,,Барлығы бір әрекетте шешілді.
Dialogue: 0,0:06:31.99,0:06:36.57,JPDB,,0000,0000,0000,,Ойланып қарасаңыз, олар ештеңе істеп жатқан сияқты емес.
Dialogue: 0,0:06:38.46,0:06:40.54,JPDB,,0000,0000,0000,,Айтпақшы, драма үйірмесі қалай болды?
Dialogue: 0,0:06:41.19,0:06:43.01,JPDB,,0000,0000,0000,,Мен бардым, әйтпесе.
Dialogue: 0,0:06:43.88,0:06:44.60,JPDB,,0000,0000,0000,,Бірақ
Dialogue: 0,0:06:45.52,0:06:46.01,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:06:47.65,0:06:50.71,JPDB,,0000,0000,0000,,Менеджер өте қызық аға.
Dialogue: 0,0:06:51.60,0:06:54.99,JPDB,,0000,0000,0000,,«Тек өзіміз жасай алатын нәрсені жасайық».
Dialogue: 0,0:06:55.68,0:06:59.01,JPDB,,0000,0000,0000,,«Бұл жаңа дәуірдің мүмкіндігі».
Dialogue: 0,0:06:59.68,0:07:01.45,JPDB,,0000,0000,0000,,А, міне, сен барсың. Мұндай нәрсе.
Dialogue: 0,0:07:01.99,0:07:04.50,JPDB,,0000,0000,0000,,Жоқ, мен қызу болғаныма қарсы емеспін.
Dialogue: 0,0:07:05.15,0:07:10.77,JPDB,,0000,0000,0000,,Жарайды, бірақ мен оны тыңдағанда, мен өзімді ''Уа, мен орта мектепте оқимын'' деп ойлаймын.
Dialogue: 0,0:07:11.41,0:07:12.77,JPDB,,0000,0000,0000,,Бұл Чунибиоу ма?
Dialogue: 0,0:07:16.78,0:07:19.44,JPDB,,0000,0000,0000,,Бұл chuunibyou-дан өзгеше болуы мүмкін.
Dialogue: 0,0:07:19.99,0:07:25.16,JPDB,,0000,0000,0000,,Мен өзімді ерекше сезінемін, өйткені мен басқа адамдардан ерекшеленетінімді түсінетін жалғыз адаммын.
Dialogue: 0,0:07:26.28,0:07:28.99,JPDB,,0000,0000,0000,,Мен мұндай нәрсенің тұзағына түскендей сезінемін.
Dialogue: 0,0:07:30.23,0:07:33.41,JPDB,,0000,0000,0000,,Қараңызшы, Тоғаши-кун екеуміз де орта мектепті бітірдік.
Dialogue: 0,0:07:33.78,0:07:37.59,JPDB,,0000,0000,0000,,Сіз орта мектепте оқып жүргенде қарапайым орта мектеп оқушысы боламын деп ойламадыңыз ба?
Dialogue: 0,0:07:38.06,0:07:38.63,JPDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:07:39.42,0:07:43.87,JPDB,,0000,0000,0000,,Бірақ соған қарамастан, сізде қарапайым орта мектеп оқушысының бейнесі бар екеніне сенімдімін.
Dialogue: 0,0:07:44.00,0:07:47.23,JPDB,,0000,0000,0000,,Мен оны өзім жасадым және оның тұзағына түсіп қалдым.
Dialogue: 0,0:07:47.92,0:07:48.97,JPDB,,0000,0000,0000,,Не айтқыңыз келеді?
Dialogue: 0,0:07:49.42,0:07:55.31,JPDB,,0000,0000,0000,,Тек ақыр соңында адамдар үнемі бір нәрсемен ауырады.
Dialogue: 0,0:07:58.06,0:07:58.81,JPDB,,0000,0000,0000,,Бұл терең.
Dialogue: 0,0:08:00.60,0:08:03.06,JPDB,,0000,0000,0000,,Таяз, Тоғашы.
Dialogue: 0,0:08:04.35,0:08:06.29,JPDB,,0000,0000,0000,,А, жарайды, мен мұны істеймін.
Dialogue: 0,0:08:06.64,0:08:07.14,JPDB,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,0:08:07.63,0:08:09.87,JPDB,,0000,0000,0000,,Өйткені мен ыдыстарды қайтадан сындырғалы жатырмын.
Dialogue: 0,0:08:10.07,0:08:11.76,JPDB,,0000,0000,0000,,Иә? Соншама?
Dialogue: 0,0:08:15.86,0:08:19.24,JPDB,,0000,0000,0000,,Мен Которию-сан кеткеннен кейін өзіңізді жалғыз сезінетініңізді білемін.
Dialogue: 0,0:08:19.84,0:08:21.43,JPDB,,0000,0000,0000,,Менің ойымша, ол мүлде кеткен жоқ.
Dialogue: 0,0:08:22.55,0:08:23.94,JPDB,,0000,0000,0000,,Мен жалғыз емеспін деп ойлаймын.
Dialogue: 0,0:08:24.11,0:08:28.88,JPDB,,0000,0000,0000,,О, мен білмеймін. Тасымалдаушылар кешке келді.
Dialogue: 0,0:08:37.31,0:08:39.77,JPDB,,0000,0000,0000,,Рикка Рикка
Dialogue: 0,0:08:40.54,0:08:42.08,JPDB,,0000,0000,0000,,Ақымақ болма, неге?
Dialogue: 0,0:08:43.37,0:08:44.74,JPDB,,0000,0000,0000,,Сіз қайтып келемін дедіңіз.
Dialogue: 0,0:08:45.36,0:08:46.65,JPDB,,0000,0000,0000,,Ол жерге біраз уақытқа ғана баратынын айтты.
Dialogue: 0,0:08:49.51,0:08:51.58,JPDB,,0000,0000,0000,,Енді бұл мүмкін емес.
Dialogue: 0,0:08:52.10,0:08:54.01,JPDB,,0000,0000,0000,,Пойыз жолда таусылады.
Dialogue: 0,0:08:54.43,0:08:55.06,JPDB,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:09:00.08,0:09:00.57,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:09:03.33,0:09:06.99,JPDB,,0000,0000,0000,,​​Анам, атам және әжем де бақытты көрінеді.
Dialogue: 0,0:09:07.88,0:09:10.69,JPDB,,0000,0000,0000,,Мен мұны істеймін дегенімде қатты жеңілдендім.
Dialogue: 0,0:09:12.30,0:09:15.19,JPDB,,0000,0000,0000,,Сондықтан бұл ең жақсы нәрсе деп ойлаймын.
Dialogue: 0,0:09:16.48,0:09:18.02,JPDB,,0000,0000,0000,,Юта да солай ойлайды.
Dialogue: 0,0:09:20.08,0:09:23.91,JPDB,,0000,0000,0000,,Түсінемін, бәрі маған қатысты.
Dialogue: 0,0:09:25.05,0:09:26.20,JPDB,,0000,0000,0000,,Мен саған көзді алып тастауды айттым.
Dialogue: 0,0:09:27.24,0:09:28.98,JPDB,,0000,0000,0000,,Мен саған орта мектепті бітір дедім.
Dialogue: 0,0:09:31.86,0:09:32.29,JPDB,,0000,0000,0000,,Э-э… Зеницу-сан
Dialogue: 0,0:09:44.74,0:09:47.50,JPDB,,0000,0000,0000,,Бұл Dark Flay...
Dialogue: 0,0:09:52.24,0:09:53.94,JPDB,,0000,0000,0000,,«Сіз бұл хатты оқыған кезде
Dialogue: 0,0:09:54.51,0:09:57.51,JPDB,,0000,0000,0000,,Сіз енді қараңғы жалынның шебері болмауыңыз мүмкін.
Dialogue: 0,0:09:58.43,0:10:03.85,JPDB,,0000,0000,0000,,2012: Майялардың пайғамбарлығына сәйкес, әлемді қамтитын жойылу толқыны бәрін жұтады.
Dialogue: 0,0:10:04.35,0:10:06.46,JPDB,,0000,0000,0000,,Себебі, ол рухани тербелістерді әлсіретеді.
Dialogue: 0,0:10:08.10,0:10:10.74,JPDB,,0000,0000,0000,,Сіз бәрін ойланып, бас тартасыз.
Dialogue: 0,0:10:11.38,0:10:16.73,JPDB,,0000,0000,0000,,Сіз өзіңіздің алдыңызда көргеннен ләззат алатын ақымақ қарапайым адамға айналған шығарсыз.
Dialogue: 0,0:10:18.09,0:10:20.60,JPDB,,0000,0000,0000,,Мен дәл қазір осындай қатысуды сезінемін.
Dialogue: 0,0:10:21.30,0:10:22.67,JPDB,,0000,0000,0000,,Мен бұл хатты жаздым
Dialogue: 0,0:10:24.43,0:10:28.68,JPDB,,0000,0000,0000,,Қараңғы жалын шебері, алданбаңыз, сізде күш бар.
Dialogue: 0,0:10:29.38,0:10:32.48,JPDB,,0000,0000,0000,,Сіз зұлым патша таңдаған қараңғылықтың патшасысыз.
Dialogue: 0,0:10:33.98,0:10:36.93,JPDB,,0000,0000,0000,,Сен ешкім емессің, сен ерекшесің».
Dialogue: 0,0:10:38.72,0:10:41.33,JPDB,,0000,0000,0000,,Екінші сыныпта оқып жүргенімде, мен оны екі жылдан кейін өзіме тапсырдым.
Dialogue: 0,0:10:43.22,0:10:45.51,JPDB,,0000,0000,0000,,Бұл ақымақтық емес пе?
Dialogue: 0,0:10:54.18,0:10:59.05,JPDB,,0000,0000,0000,,Жергілікті аркададан алған тиындарыңыздың күші мүлдем жоқ.
Dialogue: 0,0:11:00.64,0:11:00.94,JPDB,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:11:09.02,0:11:09.67,JPDB,,0000,0000,0000,,Сахна артында?
Dialogue: 0,0:11:11.95,0:11:13.02,JPDB,,0000,0000,0000,,Құдай-ай, тым беткей екен
Dialogue: 0,0:11:13.99,0:11:16.87,JPDB,,0000,0000,0000,,Маған бәрібір, бірақ осы сағатта қайда бара жатырсың?
Dialogue: 0,0:11:17.82,0:11:18.87,JPDB,,0000,0000,0000,,Мен Рикканы алып кетейін.
Dialogue: 0,0:11:19.48,0:11:22.66,JPDB,,0000,0000,0000,,Которию-сан... Не, сен?
Dialogue: 0,0:11:28.60,0:11:32.26,JPDB,,0000,0000,0000,,Иә, жоқ, мен оған айтқым келген нәрсе болды
Dialogue: 0,0:11:32.98,0:11:35.79,JPDB,,0000,0000,0000,,Бұл менің сендер үшін істегім келген нәрсе емес.
Dialogue: 0,0:11:37.58,0:11:39.89,JPDB,,0000,0000,0000,,Мен...
Dialogue: 0,0:11:44.29,0:11:44.56,JPDB,,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:11:50.60,0:11:56.47,JPDB,,0000,0000,0000,,Қараңғы жалын шебері, менің сізге осы екінші ұрпақ зұлым патша Шинганнан хабарым бар.
Dialogue: 0,0:12:09.84,0:12:11.78,JPDB,,0000,0000,0000,,Әй, әкем қайтыс болды.
Dialogue: 0,0:12:13.42,0:12:13.96,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:12:22.39,0:12:24.03,JPDB,,0000,0000,0000,,Мен мұны мүлдем сезбедім.
Dialogue: 0,0:12:24.87,0:12:27.16,JPDB,,0000,0000,0000,,Менің жүрегім шыдамады
Dialogue: 0,0:12:28.23,0:12:30.84,JPDB,,0000,0000,0000,,Өйткені мен тез сауығып кетемін деп ойладым.
Dialogue: 0,0:12:32.41,0:12:34.54,JPDB,,0000,0000,0000,,Таң атқанша әкем қайтыс болды.
Dialogue: 0,0:12:40.81,0:12:41.38,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:12:42.72,0:12:45.11,JPDB,,0000,0000,0000,,Мен...
Dialogue: 0,0:12:51.77,0:12:54.58,JPDB,,0000,0000,0000,,Сол кезде мен Ютамен таныстым.
Dialogue: 0,0:12:56.56,0:12:58.00,JPDB,,0000,0000,0000,,Менде Рикка бар
Dialogue: 0,0:12:58.58,0:13:04.99,JPDB,,0000,0000,0000,,Иә, Рикка-чан... жоқ, Джау Шинган сені екі жыл бұрын кездестірді.
Dialogue: 0,0:13:05.96,0:13:08.05,JPDB,,0000,0000,0000,,Мен діни қызметкерге келгенде
Dialogue: 0,0:13:08.99,0:13:09.69,JPDB,,0000,0000,0000,,Көшіп жатырсыз ба?
Dialogue: 0,0:13:10.08,0:13:13.86,JPDB,,0000,0000,0000,,А, мен атаммен оның үйінде тұра аламын.
Dialogue: 0,0:13:14.66,0:13:16.20,JPDB,,0000,0000,0000,,Сонда біздің үй
Dialogue: 0,0:13:21.19,0:13:23.93,JPDB,,0000,0000,0000,,Дұрыс, оған көмектесу мүмкін емес.
Dialogue: 0,0:13:24.62,0:13:25.34,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:13:35.58,0:13:39.98,JPDB,,0000,0000,0000,,Әй, ауырады... Ауырады, ауырады.
Dialogue: 0,0:13:46.22,0:13:47.49,JPDB,,0000,0000,0000,,Ауа жабысқақ.
Dialogue: 0,0:13:48.31,0:13:50.37,JPDB,,0000,0000,0000,,Бұл жақын жерде
Dialogue: 0,0:13:51.22,0:13:53.43,JPDB,,0000,0000,0000,,Содан кейін мен оны күн сайын көрдім.
Dialogue: 0,0:13:54.08,0:13:57.48,JPDB,,0000,0000,0000,,Не, сен сондасың ба?
Dialogue: 0,0:13:59.64,0:14:02.50,JPDB,,0000,0000,0000,,Ақырында, бұл. Бұл кім?
Dialogue: 0,0:14:03.82,0:14:05.06,JPDB,,0000,0000,0000,,Біреудің бақылауында болу
Dialogue: 0,0:14:05.63,0:14:07.32,JPDB,,0000,0000,0000,,Рикка-чан осылай ойлады.
Dialogue: 0,0:14:07.77,0:14:10.26,JPDB,,0000,0000,0000,,Бұлай ойлаудың өзі керемет.
Dialogue: 0,0:14:10.90,0:14:15.20,JPDB,,0000,0000,0000,,Сезімімді басып, сенің айтқаныңды тыңдаудан гөрі.
Dialogue: 0,0:14:15.48,0:14:17.66,JPDB,,0000,0000,0000,,Мен бұл шынымен адал және керемет деп ойладым.
Dialogue: 0,0:14:32.13,0:14:33.15,JPDB,,0000,0000,0000,,Сонда бұл не?
Dialogue: 0,0:14:35.01,0:14:37.97,JPDB,,0000,0000,0000,,Бұл жігіт, оның орта мектеп ауруы
Dialogue: 0,0:14:40.50,0:14:43.68,JPDB,,0000,0000,0000,,Рикка-чан — Чуунибиоудан құтқарылған қыз.
Dialogue: 0,0:14:44.58,0:14:49.77,JPDB,,0000,0000,0000,,Тоғашыға қарап, Чуунибиоға және оның сезімінің күштілігіне сүйсінген қыз.
Dialogue: 0,0:14:50.64,0:14:55.29,JPDB,,0000,0000,0000,,Сенің құдіретіңе қызығып, құдіретіңе еліктеуге тырысқан қыз.
Dialogue: 0,0:14:56.68,0:14:58.40,JPDB,,0000,0000,0000,,Сондықтан бұл Тоғашы-күн болды.
Dialogue: 0,0:14:59.62,0:15:02.20,JPDB,,0000,0000,0000,,Бұл Тоғаши-күн болуы керек еді.
Dialogue: 0,0:15:03.64,0:15:08.69,JPDB,,0000,0000,0000,,Рикка-чан әрқашан болды
Dialogue: 0,0:15:11.50,0:15:12.02,JPDB,,0000,0000,0000,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:15:20.77,0:15:26.83,JPDB,,0000,0000,0000,,Рикка!
Dialogue: 0,0:15:28.67,0:15:29.12,JPDB,,0000,0000,0000,,Юта?
Dialogue: 0,0:15:41.55,0:15:43.01,JPDB,,0000,0000,0000,,Мен саған су беруім керек
Dialogue: 0,0:16:09.51,0:16:10.13,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:16:12.69,0:16:13.81,JPDB,,0000,0000,0000,,Юта емес
Dialogue: 0,0:16:24.10,0:16:24.89,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:16:25.61,0:16:29.17,JPDB,,0000,0000,0000,,Рикка Которию жоқ, Джау Шинген
Dialogue: 0,0:16:30.23,0:16:31.92,JPDB,,0000,0000,0000,,Мен сізге бір нәрсе көрсеткім келеді
Dialogue: 0,0:16:32.92,0:16:33.49,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:16:44.67,0:16:48.43,JPDB,,0000,0000,0000,,Менімен келісімшартқа отырыңыз
Dialogue: 0,0:16:50.32,0:16:52.18,JPDB,,0000,0000,0000,,Ұры кім?
Dialogue: 0,0:16:52.50,0:16:54.12,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:54.12,0:16:54.89,JPDB,,0000,0000,0000,,Ұсыныс
Dialogue: 0,0:16:56.68,0:16:57.43,JPDB,,0000,0000,0000,,Рикка келіңіз
Dialogue: 0,0:16:58.42,0:16:58.87,JPDB,,0000,0000,0000,,Бірақ
Dialogue: 0,0:16:59.31,0:17:00.93,JPDB,,0000,0000,0000,,Біз қызықсыз шындыққа ораламыз ба?
Dialogue: 0,0:17:01.28,0:17:04.93,JPDB,,0000,0000,0000,,Немесе менімен шындықты өзгерткіңіз келмейді ме?
Dialogue: 0,0:17:08.49,0:17:09.21,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:17:11.77,0:17:12.31,JPDB,,0000,0000,0000,,Оның мотивациясы тек әділет сезімі болды
Dialogue: 0,0:17:12.31,0:17:13.01,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:17:14.65,0:17:15.17,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:17:15.35,0:17:15.92,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:17:22.93,0:17:23.52,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:17:29.86,0:17:32.02,JPDB,,0000,0000,0000,,Эй, эй балалар
Dialogue: 0,0:17:32.52,0:17:33.22,JPDB,,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:17:33.39,0:17:36.57,JPDB,,0000,0000,0000,,Кя Молестер Кя
Dialogue: 0,0:17:38.58,0:17:40.62,JPDB,,0000,0000,0000,,Бұл қылмыскердің рөлі Қылмыскердің рөлі
Dialogue: 0,0:17:41.22,0:17:42.66,JPDB,,0000,0000,0000,,Е, мен
Dialogue: 0,0:17:44.35,0:17:45.89,JPDB,,0000,0000,0000,,Сізге сәл ғана тиюге рұқсат етіңіз.
Dialogue: 0,0:17:45.99,0:17:47.13,JPDB,,0000,0000,0000,,Ик!
Dialogue: 0,0:17:47.13,0:17:48.87,JPDB,,0000,0000,0000,,Ей, күт, қозғалма.
Dialogue: 0,0:17:49.32,0:17:51.48,JPDB,,0000,0000,0000,,А, жоқ, мұның астарында мән-жайлар бар.
Dialogue: 0,0:17:52.20,0:17:53.20,JPDB,,0000,0000,0000,,Неліктен олар
Dialogue: 0,0:17:53.40,0:17:55.24,JPDB,,0000,0000,0000,,Жүр, тезірек барайық.
Dialogue: 0,0:17:55.48,0:17:56.03,JPDB,,0000,0000,0000,,Балалар
Dialogue: 0,0:17:56.65,0:17:59.34,JPDB,,0000,0000,0000,,Мені сонда Деко-чанчи көлігімен әкелді.
Dialogue: 0,0:18:00.46,0:18:00.80,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:18:04.36,0:18:06.52,JPDB,,0000,0000,0000,,Эй, күте тұрыңыз.
Dialogue: 0,0:18:12.56,0:18:13.21,JPDB,,0000,0000,0000,,Аяқ құрысулары
Dialogue: 0,0:18:13.83,0:18:14.47,JPDB,,0000,0000,0000,,Ауыстыру керек пе?
Dialogue: 0,0:18:15.12,0:18:20.96,JPDB,,0000,0000,0000,,Уайымдамаңыз, егер сізде Қараңғы жалын шеберінің күші болса, бұл сізде бар.
Dialogue: 0,0:18:28.62,0:18:29.49,JPDB,,0000,0000,0000,,Жарық
Dialogue: 0,0:18:30.28,0:18:31.13,JPDB,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:18:34.56,0:18:38.90,JPDB,,0000,0000,0000,,Бірақ бұл кеменің жарығы ғана
Dialogue: 0,0:18:42.48,0:18:43.03,JPDB,,0000,0000,0000,,Түсіңіз.
Dialogue: 0,0:18:48.27,0:18:49.64,JPDB,,0000,0000,0000,,Бұл қараңғылықтың күші.
Dialogue: 0,0:18:54.02,0:18:57.45,JPDB,,0000,0000,0000,,Жарылсын, шын, жарылсын, синапс
Dialogue: 0,0:18:59.66,0:19:08.31,JPDB,,0000,0000,0000,,Бұл әлемді қуу
Dialogue: 0,0:19:18.87,0:19:19.57,JPDB,,0000,0000,0000,,Юта…
Dialogue: 0,0:19:21.83,0:19:23.29,JPDB,,0000,0000,0000,,Бұл көрінбейтін шекара сызығы.
Dialogue: 0,0:19:24.41,0:19:25.80,JPDB,,0000,0000,0000,,Ол нұр саған қарап тұр
Dialogue: 0,0:19:27.97,0:19:30.68,JPDB,,0000,0000,0000,,Маған не ойлайтыныңызды айтыңыз
Dialogue: 0,0:19:31.89,0:19:33.78,JPDB,,0000,0000,0000,,Көптен бері айта алмай жүрген сезімдеріңіз
Dialogue: 0,0:19:39.60,0:19:40.64,JPDB,,0000,0000,0000,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:19:49.96,0:19:51.16,JPDB,,0000,0000,0000,,Қош бол папа
Dialogue: 0,0:20:02.32,0:20:03.68,JPDB,,0000,0000,0000,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:20:27.62,0:20:30.62,JPDB,,0000,0000,0000,,Барлығы chuunibyou ұят екенін айтады.
Dialogue: 0,0:20:31.64,0:20:35.25,JPDB,,0000,0000,0000,,Қайта есіме түсіргім келмейді, өшіргім келеді.
Dialogue: 0,0:20:37.14,0:20:42.68,JPDB,,0000,0000,0000,,​​Бірақ мен шынымен де сол кездегі адам боламын ба?
Dialogue: 0,0:20:44.07,0:20:47.40,JPDB,,0000,0000,0000,,Мені біреу бақылап жатыр деген адасушылық бар.
Dialogue: 0,0:20:47.82,0:20:52.77,JPDB,,0000,0000,0000,,Мен өз мінезімді белгілеп, сол кездегі адам болдым
Dialogue: 0,0:20:56.62,0:21:01.32,JPDB,,0000,0000,0000,,Адамдар кейде алдамшы мәлімдемелер жасайды және кенеттен өзгеретін әлемді армандайды.
Dialogue: 0,0:21:01.84,0:21:07.51,JPDB,,0000,0000,0000,,Алыс болашақты елестету және менің басымда жоқ ұлы махаббатты елестету
Dialogue: 0,0:21:09.65,0:21:15.04,JPDB,,0000,0000,0000,,Ол туғаннан өлгенге дейін адамдардың ішінде мәңгі қайталанады.
Dialogue: 0,0:21:15.66,0:21:17.37,JPDB,,0000,0000,0000,,Үздіксіз қайталанады
Dialogue: 0,0:21:18.07,0:21:21.45,JPDB,,0000,0000,0000,,Қайғылы, ұят және сүйкімді
Dialogue: 0,0:21:22.17,0:21:25.13,JPDB,,0000,0000,0000,,Гипер-өзіндік сана деп аталатын ауру
Dialogue: 0,0:21:26.37,0:21:29.90,JPDB,,0000,0000,0000,,Еріксіз жұмыс өзін шақырды
Dialogue: 0,0:21:31.17,0:21:35.62,JPDB,,0000,0000,0000,,Иә, адамдар өмір бойы chuunibyou ауруынан зардап шегеді.
Dialogue: 0,0:21:53.56,0:21:54.46,JPDB,,0000,0000,0000,,Денемде болмасам да, әлі де заттарды ұстай аламын ғой, иә?
Dialogue: 0,0:22:03.78,0:22:05.96,JPDB,,0000,0000,0000,,Менің көзімді көріп тұрсың ба?
Dialogue: 0,0:22:08.55,0:22:11.81,JPDB,,0000,0000,0000,,Бірақ chuunibyou әлі де ұят.
Dialogue: 0,0:01:06.60,0:01:10.57,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:01:10.80,0:01:17.36,JPOP,,0000,0000,0000,karaoke,Маған таң қалдырмас бұрын сіз не ойладыңыз?
Dialogue: 0,0:01:17.58,0:01:21.61,JPOP,,0000,0000,0000,karaoke,Маған қарашы еріндері
Dialogue: 0,0:01:21.83,0:01:27.15,JPOP,,0000,0000,0000,karaoke,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:01:27.50,0:01:32.85,JPOP,,0000,0000,0000,karaoke,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:01:33.34,0:01:38.76,JPOP,,0000,0000,0000,karaoke,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:01:39.46,0:01:44.30,JPOP,,0000,0000,0000,karaoke,Сізді бір-біріңізге тартатын махаббат
Dialogue: 0,0:01:44.65,0:01:49.12,JPOP,,0000,0000,0000,karaoke,Ол әлдеқашан басталған болатын
Dialogue: 0,0:01:50.14,0:01:52.50,JPOP,,0000,0000,0000,karaoke,Менің көп арманым болды
Dialogue: 0,0:01:52.53,0:01:56.41,JPOP,,0000,0000,0000,karaoke,Оянсам да, сені көргім келеді.
Dialogue: 0,0:01:56.41,0:01:58.62,JPOP,,0000,0000,0000,karaoke,Сіз мұны жасадыңыз
Dialogue: 0,0:01:58.62,0:02:01.03,JPOP,,0000,0000,0000,karaoke,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:02:01.03,0:02:06.60,JPOP,,0000,0000,0000,karaoke,Жүрегіміз секіріп бара жатқандай, қайда барайық
Dialogue: 0,0:02:06.60,0:02:09.21,JPOP,,0000,0000,0000,karaoke,Идеалдар, адасулар және шындық
Dialogue: 0,0:02:09.33,0:02:11.84,JPOP,,0000,0000,0000,karaoke,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:02:12.07,0:02:17.19,JPOP,,0000,0000,0000,karaoke,Жаңа әлемге
Dialogue: 0,0:01:06.60,0:01:10.57,ZWOP,,0000,0000,0000,karaoke,Сіз екі көзбен осы сәттесіз
Dialogue: 0,0:01:10.82,0:01:17.36,ZWOP,,0000,0000,0000,karaoke,Қозғалмас бұрын қайда екеніңізді көре аласыз.
Dialogue: 0,0:01:17.58,0:01:21.61,ZWOP,,0000,0000,0000,karaoke,Менің тұмсығыма қара
Dialogue: 0,0:01:21.83,0:01:27.15,ZWOP,,0000,0000,0000,karaoke,Жиналыстың сұрағы `` Мен мұны істегім келеді '' Сондай-ақ, үндемеңіз.
Dialogue: 0,0:01:27.50,0:01:32.85,ZWOP,,0000,0000,0000,karaoke,Моңғолияның өз бетімен сөйлесуі
Dialogue: 0,0:01:33.34,0:01:38.76,ZWOP,,0000,0000,0000,karaoke,Қуат қайтадан қажет емес.
Dialogue: 0,0:01:39.46,0:01:44.30,ZWOP,,0000,0000,0000,karaoke,Өзара тартымдылық махаббат
Dialogue: 0,0:01:44.65,0:01:49.12,ZWOP,,0000,0000,0000,karaoke,Жаңа ғана басталды
Dialogue: 0,0:01:50.14,0:01:52.50,ZWOP,,0000,0000,0000,karaoke,Шектеусіз әдемі армандар
Dialogue: 0,0:01:52.53,0:01:56.41,ZWOP,,0000,0000,0000,karaoke,Бұл түстен оянғаннан кейін де оны көру керек.
Dialogue: 0,0:01:56.41,0:01:58.62,ZWOP,,0000,0000,0000,karaoke,Капитал зиянды
Dialogue: 0,0:01:58.62,0:02:01.03,ZWOP,,0000,0000,0000,karaoke,Махаббат - махаббаттың шынайы табиғаты.
Dialogue: 0,0:02:01.03,0:02:06.60,ZWOP,,0000,0000,0000,karaoke,Будда мен баланың ішкі ойлары секіріп кетеді.
Dialogue: 0,0:02:06.60,0:02:09.21,ZWOP,,0000,0000,0000,karaoke,Күмән жоқ - идеал, адасушылық - шындық
Dialogue: 0,0:02:09.33,0:02:11.84,ZWOP,,0000,0000,0000,karaoke,Барлық астаналар сіздің кезегіңізде келді.
Dialogue: 0,0:02:12.07,0:02:17.19,ZWOP,,0000,0000,0000,karaoke,Жаңа әлемге шығу
