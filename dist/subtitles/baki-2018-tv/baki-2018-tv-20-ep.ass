Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,‎NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.38,0:00:17.39,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:33.92,0:01:39.93,Default,,0,0,0,,〜♪
Dialogue: 0,0:02:05.08,0:02:09.96,Default,,0,0,0,,‎(Кунимацу) ...Е, сырттан қарасаң, бұл сиқырлы амал сияқты.
Dialogue: 0,0:02:11.00,0:02:12.21,Default,,0,0,0,,‎(Токугава) Ах~
Dialogue: 0,0:02:12.88,0:02:14.63,Default,,0,0,0,,‎(Кунимацу) Ухьяхьяхья (Токугава) Ум...
Dialogue: 0,0:02:14.80,0:02:18.22,Default,,0,0,0,,‎(Токугава) Бұл мен жоғарыда айтқан улы айла...
Dialogue: 0,0:02:21.47,0:02:22.30,Default,,0,0,0,,‎
Dialogue: 0,0:02:24.06,0:02:25.22,Default,,0,0,0,,Сіз...
Dialogue: 0,0:02:25.39,0:02:28.89,Default,,0,0,0,,Сіз осы жаста қастандық жоспарлап отырсыз ба?
Dialogue: 0,0:02:29.27,0:02:32.73,Default,,0,0,0,,‎Жоқ, жоқ, жоқ, жоқ, жоқ, мүмкін емес
Dialogue: 0,0:02:34.40,0:02:38.28,Default,,0,0,0,,‎Сіз бұл туралы сөйлессеңіз де, мұны істеу мүмкін емес.
Dialogue: 0,0:02:38.82,0:02:42.12,Default,,0,0,0,,‎Бірақ жай ғана сұрау уақытты жоғалту.
Dialogue: 0,0:02:45.45,0:02:48.41,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:03:00.09,0:03:03.60,Default,,0,0,0,,‎(Куниматсу) Дәл өлшенген дәрілер
Dialogue: 0,0:03:03.85,0:03:08.10,Default,,0,0,0,,‎Табиғи улы жәндіктер мен улы өсімдіктер.
Dialogue: 0,0:03:12.10,0:03:17.36,Default,,0,0,0,,‎Оны дұрыстап араластырып, құмға қосыңыз.
Dialogue: 0,0:03:17.53,0:03:18.65,Default,,0,0,0,,‎(Токугава) Құмда...
Dialogue: 0,0:03:27.91,0:03:30.79,Default,,0,0,0,,‎(Куниматсу) Мұны бірнеше рет қайталасаңыз
Dialogue: 0,0:03:30.96,0:03:33.29,Default,,0,0,0,,‎Улы құм толық.
Dialogue: 0,0:03:33.46,0:03:34.92,Default,,0,0,0,,‎(Токугава) Докса…
Dialogue: 0,0:03:47.06,0:03:51.18,Default,,0,0,0,,‎(Токугава) Бірақ егер сіз мұны таңертеңнен кешке дейін жасасаңыз...
Dialogue: 0,0:03:51.35,0:03:55.31,Default,,0,0,0,,‎Бұл уланған сияқты.
Dialogue: 0,0:03:58.94,0:04:02.32,Default,,0,0,0,,‎Аха~ Уды залалсыздандыру үшін
Dialogue: 0,0:04:02.61,0:04:05.20,Default,,0,0,0,,‎Сеняку? солай ма?
Dialogue: 0,0:04:05.95,0:04:08.03,Default,,0,0,0,,Улы құм және жуғыш зат
Dialogue: 0,0:04:08.20,0:04:11.25,Default,,0,0,0,,Мұны күн ішінде әр 7 минут сайын орындаңыз.
Dialogue: 0,0:04:11.37,0:04:15.46,Default,,0,0,0,,‎Түнде әр 9 минут сайын қайталаңыз Қайталаңыз
Dialogue: 0,0:04:15.63,0:04:20.30,Default,,0,0,0,,‎Бұл кудо жаттығуларының ең ауыр бөлігі.
Dialogue: 0,0:04:20.46,0:04:22.09,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,0:04:22.97,0:04:24.18,Default,,0,0,0,,Мен ауырсынуды көтере алмаймын
Dialogue: 0,0:04:24.34,0:04:28.60,Default,,0,0,0,,‎Тіпті білегін кесіп тастайтындар бар.
Dialogue: 0,0:04:29.14,0:04:30.72,Default,,0,0,0,,5-ші күнді енгізу
Dialogue: 0,0:04:30.89,0:04:34.56,Default,,0,0,0,,‎Тері тәтті картоптың түсіне айнала бастайды
Dialogue: 0,0:04:50.79,0:04:54.25,Default,,0,0,0,,‎(Кунимацу) Уытты Гонг аяқталды.
Dialogue: 0,0:04:55.21,0:04:56.12,Default,,0,0,0,,Мм...
Dialogue: 0,0:04:56.29,0:05:00.38,Default,,0,0,0,,‎Егер сіз улы қолыңызбен адамды ұрсаңыз...
Dialogue: 0,0:05:00.71,0:05:02.51,Default,,0,0,0,,‎Ет шіріп кетеді.
Dialogue: 0,0:05:02.96,0:05:05.38,Default,,0,0,0,,Шірік...?
Dialogue: 0,0:05:05.76,0:05:08.26,Default,,0,0,0,,‎Сүйек кемігі де зардап шегеді.
Dialogue: 0,0:05:08.76,0:05:09.64,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:09.89,0:05:12.14,Default,,0,0,0,,‎Ах~ мен өлемін
Dialogue: 0,0:05:12.56,0:05:15.27,Default,,0,0,0,,Өлім... сен
Dialogue: 0,0:05:15.56,0:05:17.10,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:05:18.19,0:05:20.77,Default,,0,0,0,,Өйткені біз кісі өлтірушіміз
Dialogue: 0,0:05:21.15,0:05:23.61,Default,,0,0,0,,‎Ухяхяхяхя…
Dialogue: 0,0:05:24.32,0:05:26.11,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:05:32.29,0:05:33.79,Default,,0,0,0,,‎(бағыныңқы) еш жерде жоқ.
Dialogue: 0,0:05:34.16,0:05:36.71,Default,,0,0,0,,‎(бағыныңқы) Не... Сіз нені айтып тұрсыз?
Dialogue: 0,0:05:37.12,0:05:38.83,Default,,0,0,0,,‎(Сонода) Бұл лагерь
Dialogue: 0,0:05:39.00,0:05:43.50,Default,,0,0,0,,Қараусыз қалған лифт сынақ мұнарасының үстіне салынған
Dialogue: 0,0:05:44.01,0:05:45.47,Default,,0,0,0,,‎Арнайы лагерьлер және
Dialogue: 0,0:05:45.63,0:05:49.30,Default,,0,0,0,,‎Лифт сынақ мұнараларын байланыстыратын өтпе жолдар немесе есіктер жоқ.
Dialogue: 0,0:05:49.72,0:05:51.47,Default,,0,0,0,,‎Тікұшақты пайдаланудан басқа
Dialogue: 0,0:05:51.64,0:05:54.52,Default,,0,0,0,,‎Осында кіруге немесе осы жерден шығуға болады
Dialogue: 0,0:05:54.68,0:05:56.27,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:05:56.52,0:05:58.27,Default,,0,0,0,,‎(Бағыныңқылар) Ah...
Dialogue: 0,0:05:59.48,0:06:03.78,Default,,0,0,0,,(Сонода) Егер солай болса, менің ойыма бір ғана нәрсе келеді.
Dialogue: 0,0:06:04.69,0:06:07.74,Default,,0,0,0,,‎150 метрден астам бетон қабырға
Dialogue: 0,0:06:07.90,0:06:09.61,Default,,0,0,0,,Сіз төмендеді дейсіз бе...
Dialogue: 0,0:06:10.41,0:06:14.24,Default,,0,0,0,,‎Бұл адам саусақтарының күшін ғана пайдаланды.
Dialogue: 0,0:06:14.91,0:06:16.08,Default,,0,0,0,,‎(Сикорский) Хуху…
Dialogue: 0,0:06:17.29,0:06:18.62,Default,,0,0,0,,‎(Сонода) Ақымақ!
Dialogue: 0,0:06:26.17,0:06:28.09,Default,,0,0,0,,‎(Коузуэ) Хмм...
Dialogue: 0,0:06:31.18,0:06:37.18,Default,,0,0,0,,‎(жүрек соғу дыбысы)
Dialogue: 0,0:06:40.02,0:06:42.52,Default,,0,0,0,,Бұл күн келді!
Dialogue: 0,0:06:42.77,0:06:44.65,Default,,0,0,0,,Жыныстық қатынас күні!
Dialogue: 0,0:06:47.78,0:06:49.90,Default,,0,0,0,,‎Козуэнің… көздері…
Dialogue: 0,0:06:50.20,0:06:52.16,Default,,0,0,0,,‎Көз жас... Олар әдемі!
Dialogue: 0,0:06:54.78,0:06:57.62,Default,,0,0,0,,‎(2 адам) ха ха ха ха ха ха
Dialogue: 0,0:06:58.58,0:07:00.37,Default,,0,0,0,,‎Қалай... сүйкімді!
Dialogue: 0,0:07:01.17,0:07:02.88,Default,,0,0,0,,‎(2 адам) Ммм... Ммм...
Dialogue: 0,0:07:03.58,0:07:04.84,Default,,0,0,0,,‎ Жалғастыру…
Dialogue: 0,0:07:05.17,0:07:07.38,Default,,0,0,0,,‎Толығырақ... алға!
Dialogue: 0,0:07:16.31,0:07:17.52,Default,,0,0,0,,Жылы…
Dialogue: 0,0:07:18.14,0:07:20.89,Default,,0,0,0,,‎Қозуенің қолымыз тимеген терісінен
Dialogue: 0,0:07:21.39,0:07:23.23,Default,,0,0,0,,Сіздің дене қызуыңыз көтеріледі
Dialogue: 0,0:07:24.86,0:07:25.98,Default,,0,0,0,,Олардың мен адамзаттың күш арасындағы алшақтық аса үлкен еді,
Dialogue: 0,0:07:26.15,0:07:27.02,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:07:27.40,0:07:29.36,Default,,0,0,0,,Мен оны бір-бірімізден алшақ болсақ та сеземін
Dialogue: 0,0:07:30.40,0:07:32.20,Default,,0,0,0,,Бакидің дене температурасы
Dialogue: 0,0:07:33.61,0:07:36.53,Default,,0,0,0,,‎(Козуэ) Үлкен иық... Қол...
Dialogue: 0,0:07:36.91,0:07:38.79,Default,,0,0,0,,‎Оның қалыңдығы сонша, сіз оны ұстай алмайсыз
Dialogue: 0,0:07:38.91,0:07:40.54,Default,,0,0,0,,‎Аа... уф
Dialogue: 0,0:07:41.08,0:07:43.29,Default,,0,0,0,,Керемет! сезіну!
Dialogue: 0,0:07:44.21,0:07:46.54,Default,,0,0,0,,Тіпті саусақ іздерінің кедір-бұдыры
Dialogue: 0,0:07:47.25,0:07:49.92,Default,,0,0,0,,‎Сізге тиіп тұрған жерлер иықтарыңыз бен қолдарыңыз болса да
Dialogue: 0,0:07:50.09,0:07:52.30,Default,,0,0,0,,‎Отырғыңыз келеді.
Dialogue: 0,0:07:53.68,0:07:56.22,Default,,0,0,0,,Мен оны қазір дұрыстап ұстауым керек.
Dialogue: 0,0:07:56.68,0:07:58.47,Default,,0,0,0,,‎Бұл жеңіледі!
Dialogue: 0,0:07:59.06,0:08:00.93,Default,,0,0,0,,Мен бір орында тұра алмаймын!
Dialogue: 0,0:08:02.06,0:08:03.94,Default,,0,0,0,,‎Бұл... ұрыс сияқты!
Dialogue: 0,0:08:04.85,0:08:06.44,Default,,0,0,0,,‎Жұмсақ
Dialogue: 0,0:08:06.98,0:08:09.90,Default,,0,0,0,,‎Бұл еркектікінен мүлде бөлек...
Dialogue: 0,0:08:10.07,0:08:10.94,Default,,0,0,0,,‎Хмм!
Dialogue: 0,0:08:20.79,0:08:24.71,Default,,0,0,0,,(Әңгімелеу) Адам ағзасын ұтымды түрде жоюға ғана шоғырланған.
Dialogue: 0,0:08:24.87,0:08:26.75,Default,,0,0,0,,‎Он және жыл
Dialogue: 0,0:08:27.92,0:08:31.17,Default,,0,0,0,,‎17 жаста жыныстық ақпаратсыз
Dialogue: 0,0:08:31.96,0:08:33.72,Default,,0,0,0,,‎Себебі бізде ақпарат жоқ
Dialogue: 0,0:08:34.05,0:08:35.59,Default,,0,0,0,,‎Инстинкт
Dialogue: 0,0:08:37.60,0:08:39.22,Default,,0,0,0,,‎Инстинктивтік себеп
Dialogue: 0,0:08:39.93,0:08:41.27,Default,,0,0,0,,Таза
Dialogue: 0,0:08:43.18,0:08:44.73,Default,,0,0,0,,‎Таза Сондықтан
Dialogue: 0,0:08:45.39,0:08:46.85,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:08:47.65,0:08:48.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:50.36,0:08:51.32,Default,,0,0,0,,‎Баки-кун!
Dialogue: 0,0:08:51.48,0:08:54.65,Default,,0,0,0,,‎ Ұқсас... ұрыс пен секс!
Dialogue: 0,0:08:54.90,0:08:57.74,Default,,0,0,0,,‎Төбелес пен жыныстық қатынас... бірдей!
Dialogue: 0,0:08:59.99,0:09:02.45,Default,,0,0,0,,‎Төбелес кезінде зиян келтіру және
Dialogue: 0,0:09:02.62,0:09:05.37,Default,,0,0,0,,‎Жыныстық қатынас арқылы ләззат беру деген нені білдіреді?
Dialogue: 0,0:09:05.54,0:09:07.08,Default,,0,0,0,,‎Бір монетаның екі жағы!
Dialogue: 0,0:09:07.63,0:09:08.88,Default,,0,0,0,,Ұрыс дегеніміз не?
Dialogue: 0,0:09:09.04,0:09:11.25,Default,,0,0,0,,‎Сіз басқа адамның істегенін қаламайтын нәрсе —
Dialogue: 0,0:09:11.71,0:09:14.01,Default,,0,0,0,,Сіз жек көретін нәрсені жасаңыз
Dialogue: 0,0:09:14.97,0:09:16.38,Default,,0,0,0,,Керісінше!
Dialogue: 0,0:09:16.72,0:09:17.64,Default,,0,0,0,,Жыныстық қатынас дегеніміз не?
Dialogue: 0,0:09:18.55,0:09:22.39,Default,,0,0,0,,‎Басқа адам сізден қалаған нәрсені, сіз қалаған уақытта істеңіз
Dialogue: 0,0:09:23.81,0:09:25.89,Default,,0,0,0,,Зақым келтіріңіз!
Dialogue: 0,0:09:28.69,0:09:30.65,Default,,0,0,0,,Зақым келтіріңіз!
Dialogue: 0,0:09:37.32,0:09:39.70,Default,,0,0,0,,‎Ха ха ха ха
Dialogue: 0,0:09:40.95,0:09:43.24,Default,,0,0,0,,‎Ха ха ха ха
Dialogue: 0,0:09:44.04,0:09:47.54,Default,,0,0,0,,‎Куузэ... Мен қазірдің өзінде
Dialogue: 0,0:09:55.09,0:09:55.92,Default,,0,0,0,,‎Ха...
Dialogue: 0,0:09:56.47,0:09:58.88,Default,,0,0,0,,Түсіндім! Kozue ішінде!
Dialogue: 0,0:09:59.05,0:10:01.47,Default,,0,0,0,,‎(Козуэ) Мен бармын! Менің ішімде!
Dialogue: 0,0:10:01.64,0:10:03.68,Default,,0,0,0,,Мені ұстаңыз!
Dialogue: 0,0:10:05.39,0:10:07.18,Default,,0,0,0,,‎Бұл өте жақсы!
Dialogue: 0,0:10:07.81,0:10:09.19,Default,,0,0,0,,Басқа ештеңе жоқ!
Dialogue: 0,0:10:27.33,0:10:28.58,Default,,0,0,0,,‎(Әңгімелеу) Стипендия—
Dialogue: 0,0:10:29.75,0:10:31.33,Default,,0,0,0,,Көп рет байланыс
Dialogue: 0,0:10:32.84,0:10:35.21,Default,,0,0,0,,‎Көп және көп рет
Dialogue: 0,0:10:36.38,0:10:38.17,Default,,0,0,0,,Жақында, бірнеше рет
Dialogue: 0,0:10:39.01,0:10:40.38,Default,,0,0,0,,Қанша түн?
Dialogue: 0,0:10:41.05,0:10:42.39,Default,,0,0,0,,‎Мен сені көрмеген кезде
Dialogue: 0,0:10:44.81,0:10:48.48,Default,,0,0,0,,‎Қалаудың бұлдырлығы із-түзсіз жоғалады
Dialogue: 0,0:10:50.19,0:10:51.44,Default,,0,0,0,,Мөлдір
Dialogue: 0,0:10:51.90,0:10:54.36,Default,,0,0,0,,‎Тек бір-біріне беретіндер
Dialogue: 0,0:10:56.23,0:10:57.23,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:10:58.74,0:11:02.11,Default,,0,0,0,,‎(Янаги) Біраз уақыт болды, Баки-сан.
Dialogue: 0,0:11:02.78,0:11:03.87,Default,,0,0,0,,‎(Kouzue) Иә? Ах...
Dialogue: 0,0:11:04.62,0:11:07.66,Default,,0,0,0,,‎(Янаги) Өкінішті, сен шаршадың.
Dialogue: 0,0:11:07.83,0:11:10.12,Default,,0,0,0,,Мен сенімен танысқым келді
Dialogue: 0,0:11:10.87,0:11:12.12,Default,,0,0,0,,‎Янаги-сан
Dialogue: 0,0:11:12.50,0:11:14.92,Default,,0,0,0,,‎Бұл сендерге әдемі.
Dialogue: 0,0:11:15.09,0:11:16.13,Default,,0,0,0,,‎(Янаги) Әдемі?
Dialogue: 0,0:11:17.00,0:11:20.01,Default,,0,0,0,,Осылайша, мен көшеге шықпас бұрын
Dialogue: 0,0:11:20.34,0:11:23.22,Default,,0,0,0,,‎Шабуыл жасау мүмкіндігі көп болуы керек еді.
Dialogue: 0,0:11:23.80,0:11:26.31,Default,,0,0,0,,Мен артық сатылғым келмейді.
Dialogue: 0,0:11:26.47,0:11:28.89,Default,,0,0,0,,‎Мен қазір осылай шақырамын.
Dialogue: 0,0:11:29.06,0:11:32.44,Default,,0,0,0,,Мен дәл уақыт деп ойладым.
Dialogue: 0,0:11:32.85,0:11:33.77,Default,,0,0,0,,Және...
Dialogue: 0,0:11:33.98,0:11:34.81,Default,,0,0,0,,‎(Козуэ) бұл...
Dialogue: 0,0:11:34.98,0:11:38.36,Default,,0,0,0,,‎(Янаги) Бұрынғыдан ерекшеленетіндей сезім болды.
Dialogue: 0,0:11:39.24,0:11:40.65,Default,,0,0,0,,‎Янаги-сан
Dialogue: 0,0:11:40.82,0:11:43.95,Default,,0,0,0,,‎Мен де дәл сіз көрген жағдайдамын.
Dialogue: 0,0:11:44.12,0:11:46.53,Default,,0,0,0,,Келесі жолы кездесу болмайды...
Dialogue: 0,0:11:46.99,0:11:49.50,Default,,0,0,0,,Бұл жақсы болмайды
Dialogue: 0,0:11:49.83,0:11:51.29,Default,,0,0,0,,Бала
Dialogue: 0,0:11:54.50,0:11:55.33,Default,,0,0,0,,‎(Янаги) Ха!
Dialogue: 0,0:11:56.29,0:11:58.38,Default,,0,0,0,,Жақын жерде бос жер бар
Dialogue: 0,0:11:58.63,0:12:00.92,Default,,0,0,0,,Олай болса ақ пен қараны қосайық.
Dialogue: 0,0:12:01.22,0:12:02.97,Default,,0,0,0,,‎О... О!
Dialogue: 0,0:12:03.88,0:12:05.93,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:12:07.30,0:12:08.93,Default,,0,0,0,,‎(Янаги) Орнату мүмкін емес
Dialogue: 0,0:12:09.35,0:12:11.77,Default,,0,0,0,,‎Осындай балалық тәтті болды
Dialogue: 0,0:12:11.93,0:12:14.69,Default,,0,0,0,,‎Ол мүлдем жоғалып кетті.
Dialogue: 0,0:12:23.32,0:12:27.45,Default,,0,0,0,,‎Сен жақсы қыз тауып алдың, Баки-сан.
Dialogue: 0,0:12:28.41,0:12:30.20,Default,,0,0,0,,Сүйіктім
Dialogue: 0,0:12:33.79,0:12:35.88,Default,,0,0,0,,‎Баки... сен
Dialogue: 0,0:12:36.38,0:12:38.59,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:12:38.75,0:12:39.84,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:40.46,0:12:41.84,Default,,0,0,0,,Мен де жасаймын!
Dialogue: 0,0:12:42.26,0:12:43.22,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:12:44.72,0:12:45.55,Default,,0,0,0,,‎F…
Dialogue: 0,0:12:46.09,0:12:48.05,Default,,0,0,0,,‎Аа... Ха...
Dialogue: 0,0:12:49.18,0:12:50.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:50.85,0:12:52.98,Default,,0,0,0,,Мен сізден қауіпті бола ма деп сұраймын.
Dialogue: 0,0:12:54.60,0:12:55.44,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:55.60,0:12:56.44,Default,,0,0,0,,‎(Янаги) Асығыңыз!
Dialogue: 0,0:12:56.90,0:12:57.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:57.90,0:12:59.11,Default,,0,0,0,,‎(Янаги) Уау!
Dialogue: 0,0:12:59.48,0:13:00.61,Default,,0,0,0,,Үзіліс...
Dialogue: 0,0:13:01.78,0:13:04.03,Default,,0,0,0,,‎G... Уау!
Dialogue: 0,0:13:04.53,0:13:06.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:07.49,0:13:08.32,Default,,0,0,0,,‎Тайя!
Dialogue: 0,0:13:08.87,0:13:11.24,Default,,0,0,0,,‎(Янаги) Нуоо!
Dialogue: 0,0:13:12.87,0:13:13.70,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:14.54,0:13:15.50,Default,,0,0,0,,‎K… Бару…
Dialogue: 0,0:13:16.42,0:13:17.46,Default,,0,0,0,,‎Ғажайып…
Dialogue: 0,0:13:22.55,0:13:24.76,Default,,0,0,0,,‎Уф... Уф...
Dialogue: 0,0:13:26.38,0:13:27.76,Default,,0,0,0,,Гах!
Dialogue: 0,0:13:29.14,0:13:31.64,Default,,0,0,0,,‎Сен мықтысың... Баки-сан
Dialogue: 0,0:13:34.35,0:13:36.64,Default,,0,0,0,,‎Нағыз күшті
Dialogue: 0,0:13:37.23,0:13:38.40,Default,,0,0,0,,Қамшылау?
Dialogue: 0,0:13:38.81,0:13:40.56,Default,,0,0,0,,‎(Кунимацу) Бұл қамшы.
Dialogue: 0,0:13:40.73,0:13:45.15,Default,,0,0,0,,‎(Токугава) Қамшы... Бұл дегеніміз...
Dialogue: 0,0:13:45.32,0:13:46.65,Default,,0,0,0,,‎(Кунимацу) Дұрыс.
Dialogue: 0,0:13:47.24,0:13:49.95,Default,,0,0,0,,‎Қамшы - бұл әркім қолдануы керек нәрсе...
Dialogue: 0,0:13:50.12,0:13:54.12,Default,,0,0,0,,‎Мен мұны аттың бөксесін ұрудан басқа нәрсе деп ойламаймын.
Dialogue: 0,0:13:54.29,0:13:55.79,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:56.37,0:13:59.58,Default,,0,0,0,,Сіз керемет қарусыз.
Dialogue: 0,0:13:59.75,0:14:02.67,Default,,0,0,0,,‎Ах~ Қамшы...?
Dialogue: 0,0:14:03.42,0:14:08.43,Default,,0,0,0,,(Кунимацу) Таяу Шығыста қамшымен ұру жазасы әлі де сақталған.
Dialogue: 0,0:14:08.84,0:14:13.72,Default,,0,0,0,,Соққылардың саны жазаның ауырлығына қарай анықталады.
Dialogue: 0,0:14:13.89,0:14:16.93,Default,,0,0,0,,‎Бұл толық ысырап
Dialogue: 0,0:14:17.52,0:14:19.02,Default,,0,0,0,,‎(Токугава) Бұл ысырап
Dialogue: 0,0:14:19.19,0:14:22.19,Default,,0,0,0,,‎Бекітілген рет санына жеткенге дейін...
Dialogue: 0,0:14:22.36,0:14:23.32,Default,,0,0,0,,Өйткені сен өлесің
Dialogue: 0,0:14:23.48,0:14:24.57,Default,,0,0,0,,‎Уххххххххххх...
Dialogue: 0,0:14:24.78,0:14:27.07,Default,,0,0,0,,‎(Токугава) Хэ-хэ-хэ...
Dialogue: 0,0:14:27.44,0:14:31.32,Default,,0,0,0,,Ол есеңгіреп қайтыс болды. Ол қатты қиналған.
Dialogue: 0,0:14:32.16,0:14:36.20,Default,,0,0,0,,‎Артқы бет алдыңғы бетінен бірнеше есе күшті деп айтылады
Dialogue: 0,0:14:36.37,0:14:39.71,Default,,0,0,0,,Арқаға және бөкселерге бағыттаңыз.
Dialogue: 0,0:14:39.96,0:14:44.21,Default,,0,0,0,,‎Тіпті сіздің маңызды ұпайларыңыз болып табылмайтын аймақтарды соғуға қарамастан.
Dialogue: 0,0:14:44.42,0:14:46.09,Default,,0,0,0,,‎10 реттен көп
Dialogue: 0,0:14:46.71,0:14:48.59,Default,,0,0,0,,‎Егер ол нашарлап кетсе, ол бірнеше рет болады...
Dialogue: 0,0:14:48.76,0:14:49.59,Default,,0,0,0,,‎(Токугава) Ммм
Dialogue: 0,0:14:50.09,0:14:52.09,Default,,0,0,0,,Өлімге апару
Dialogue: 0,0:14:52.47,0:14:54.14,Default,,0,0,0,,‎(Янаги) Уф...
Dialogue: 0,0:14:54.64,0:14:56.10,Default,,0,0,0,,‎Баки-сан…
Dialogue: 0,0:14:58.64,0:15:01.48,Default,,0,0,0,,Ауырсыну мүмкін бе?
Dialogue: 0,0:15:02.02,0:15:04.77,Default,,0,0,0,,‎Бұл қатты ауырады~
Dialogue: 0,0:15:04.98,0:15:07.99,Default,,0,0,0,,Менің денем өлімді таңдайды
Dialogue: 0,0:15:08.61,0:15:09.45,Default,,0,0,0,,‎
Dialogue: 0,0:15:09.61,0:15:11.99,Default,,0,0,0,,(Кунимацу) Сіз оны елестете аласыз ба?
Dialogue: 0,0:15:12.41,0:15:16.49,Default,,0,0,0,,‎Қанша бақытты болсаң да, алда ұзақ өмір
Dialogue: 0,0:15:16.66,0:15:21.04,Default,,0,0,0,,‎Оны бірнеше рет жоюға болатыны соншалық...
Dialogue: 0,0:15:21.62,0:15:22.79,Default,,0,0,0,,Ауырсыну
Dialogue: 0,0:15:24.17,0:15:25.38,Default,,0,0,0,,Мен бұған жақсы емеспін
Dialogue: 0,0:15:26.21,0:15:27.38,Default,,0,0,0,,Ауырды
Dialogue: 0,0:15:27.88,0:15:30.88,Default,,0,0,0,,Бұл ұят болар еді.
Dialogue: 0,0:15:32.01,0:15:35.43,Default,,0,0,0,,‎Бұл техника... ауырады.
Dialogue: 0,0:15:38.02,0:15:38.85,Default,,0,0,0,,‎(Токугава) О!
Dialogue: 0,0:15:39.02,0:15:42.65,Default,,0,0,0,,‎(Куниматсу) және... жақсы, ол әлсіз.
Dialogue: 0,0:15:43.10,0:15:50.11,Default,,0,0,0,,‎Иықтан тыс сүйектер жоқ деп елестететін сұйықтық
Dialogue: 0,0:15:50.28,0:15:52.15,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:52.49,0:15:54.78,Default,,0,0,0,,Қолдың бәрі су
Dialogue: 0,0:15:54.95,0:15:57.41,Default,,0,0,0,,Ауыр сұйықтық деп есептелген
Dialogue: 0,0:15:57.95,0:16:00.16,Default,,0,0,0,,Шайқаңыз! шайқау! шайқау!
Dialogue: 0,0:16:00.54,0:16:02.71,Default,,0,0,0,,О!
Dialogue: 0,0:16:03.25,0:16:07.59,Default,,0,0,0,,‎(Кунимацу) Сіз Янаги сияқты жақсы болмауыңыз мүмкін, бірақ сіз осы сияқты жақсысыз...
Dialogue: 0,0:16:07.75,0:16:09.38,Default,,0,0,0,,‎Ухяхяхяхя…
Dialogue: 0,0:16:09.55,0:16:13.93,Default,,0,0,0,,‎Рюко Янаги көбірек қолдануға болады, солай ма?
Dialogue: 0,0:16:16.85,0:16:20.14,Default,,0,0,0,,Бұл енді адамның қолы емес.
Dialogue: 0,0:16:20.31,0:16:21.89,Default,,0,0,0,,‎Егер мен оны сипаттау керек болсам
Dialogue: 0,0:16:22.06,0:16:23.69,Default,,0,0,0,,Меркурий қамшы!
Dialogue: 0,0:16:29.07,0:16:30.48,Default,,0,0,0,,‎(Кузуэ) Менің қолым жоғалып кетті...
Dialogue: 0,0:16:41.37,0:16:42.20,Default,,0,0,0,,‎(Янаги) Каа!
Dialogue: 0,0:16:43.83,0:16:44.67,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:50.42,0:16:51.55,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:52.63,0:16:53.47,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:16:54.51,0:16:56.97,Default,,0,0,0,,Бұл ауыруы керек.
Dialogue: 0,0:16:59.68,0:17:00.85,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:17:07.73,0:17:08.61,Default,,0,0,0,,Кух!
Dialogue: 0,0:17:09.98,0:17:11.11,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:17:11.57,0:17:14.82,Default,,0,0,0,,‎Қайдан алсаң да, ауырсыну бірдей
Dialogue: 0,0:17:15.70,0:17:18.49,Default,,0,0,0,,(Токугава) Үйретілген дене жұмыс істемейді
Dialogue: 0,0:17:19.58,0:17:20.62,Default,,0,0,0,,Иә
Dialogue: 0,0:17:20.87,0:17:25.87,Default,,0,0,0,,Адам ағзасы жаттығу арқылы күрт күшейетіні рас.
Dialogue: 0,0:17:26.37,0:17:30.34,Default,,0,0,0,,‎Осындай мысалдарды көрсететін демонстрациялар бар.
Dialogue: 0,0:17:30.75,0:17:31.80,Default,,0,0,0,,Алайда
Dialogue: 0,0:17:31.96,0:17:36.76,Default,,0,0,0,,‎Тіпті жақсы дайындалған бұлшықеттердің сауыты төтеп бере алмайтын соққы
Dialogue: 0,0:17:37.26,0:17:38.80,Default,,0,0,0,,Ух...
Dialogue: 0,0:17:39.72,0:17:40.76,Default,,0,0,0,,‎Nuf…
Dialogue: 0,0:17:41.06,0:17:42.51,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:17:42.72,0:17:44.85,Default,,0,0,0,,Теріге соққы
Dialogue: 0,0:17:45.02,0:17:48.56,Default,,0,0,0,,‎Оны қарапайым тілмен жеткізіңіз: Эй, бұл Харите.
Dialogue: 0,0:17:48.73,0:17:51.65,Default,,0,0,0,,‎Қамшылаудың нағыз табиғаты – шапалақ!
Dialogue: 0,0:17:52.27,0:17:54.78,Default,,0,0,0,,‎Әрине, ұрудың азабы
Dialogue: 0,0:17:54.94,0:17:59.91,Default,,0,0,0,,‎Әйелдердің жаттықтырылған денесі мен жұмсақ терісін ажырату.
Dialogue: 0,0:18:00.07,0:18:03.41,Default,,0,0,0,,‎Ал шабуылдың қай жерде екені маңызды емес
Dialogue: 0,0:18:04.12,0:18:05.25,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:18:05.41,0:18:09.67,Default,,0,0,0,,‎Егер шабуыл нысанасы бүкіл денені жабатын тері болса
Dialogue: 0,0:18:09.83,0:18:14.17,Default,,0,0,0,,‎Қайда соқсаңыз да, бәрі маңызды нүкте.
Dialogue: 0,0:18:17.22,0:18:18.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:19.47,0:18:21.01,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:18:21.43,0:18:23.06,Default,,0,0,0,,‎Бұл қамшы.
Dialogue: 0,0:18:23.22,0:18:24.06,Default,,0,0,0,,‎(Янаги) Уф!
Dialogue: 0,0:18:24.97,0:18:26.56,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:18:27.18,0:18:30.56,Default,,0,0,0,,‎Әкем мені баяғыда оқытқан
Dialogue: 0,0:18:31.44,0:18:33.61,Default,,0,0,0,,Сіз оны қолдануға болады дейсіз бе?
Dialogue: 0,0:18:33.82,0:18:35.78,Default,,0,0,0,,‎Сен де қамшы алғың келе ме?
Dialogue: 0,0:18:36.49,0:18:39.28,Default,,0,0,0,,‎Әкем осылай түсіндірді.
Dialogue: 0,0:18:40.20,0:18:43.33,Default,,0,0,0,,Өйткені, бұл әйелдер мен балаларға арналған өзін-өзі қорғау әдісі.
Dialogue: 0,0:18:43.78,0:18:47.54,Default,,0,0,0,,Бұл ересек адам қолданатын нәрсе емес...
Dialogue: 0,0:18:47.79,0:18:48.91,Default,,0,0,0,,‎(Янаги) Уф...
Dialogue: 0,0:18:49.16,0:18:50.08,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:50.75,0:18:52.71,Default,,0,0,0,,‎Бұл мен көп нәрсені үйрендім.
Dialogue: 0,0:18:53.54,0:18:56.46,Default,,0,0,0,,‎Мен оны пайдаланып көремін деп ойлаймын. Біраз уақыт өтті.
Dialogue: 0,0:18:57.17,0:18:59.88,Default,,0,0,0,,Мен сенімдімін... осылай...
Dialogue: 0,0:19:00.05,0:19:04.22,Default,,0,0,0,,‎Денедегі сұйықтықтар... Сурет
Dialogue: 0,0:19:04.68,0:19:05.97,Default,,0,0,0,,‎(Янаги) О!
Dialogue: 0,0:19:07.64,0:19:09.60,Default,,0,0,0,,‎Ой, ау
Dialogue: 0,0:19:10.35,0:19:11.19,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:11.35,0:19:12.23,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:19:12.35,0:19:13.19,Default,,0,0,0,,‎(Янаги) О...!
Dialogue: 0,0:19:14.02,0:19:15.98,Default,,0,0,0,,‎Ааааааааааааааааааааааа
Dialogue: 0,0:19:16.44,0:19:17.99,Default,,0,0,0,,бұл... уф
Dialogue: 0,0:19:18.44,0:19:19.99,Default,,0,0,0,,‎Коооо
Dialogue: 0,0:19:20.15,0:19:23.45,Default,,0,0,0,,‎Ааа!
Dialogue: 0,0:19:24.62,0:19:25.70,Default,,0,0,0,,‎Ах а
Dialogue: 0,0:19:25.87,0:19:27.04,Default,,0,0,0,,Уау
Dialogue: 0,0:19:27.24,0:19:29.50,Default,,0,0,0,,‎(Янаги) Ах... Ах~аа
Dialogue: 0,0:19:30.04,0:19:32.50,Default,,0,0,0,,Сізге қараудың қажеті жоқ...
Dialogue: 0,0:19:33.25,0:19:34.50,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:35.00,0:19:38.01,Default,,0,0,0,,Ауырды, сенде махаббат жоқ.
Dialogue: 0,0:19:38.30,0:19:39.46,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:19:40.22,0:19:42.01,Default,,0,0,0,,‎Угугу…
Dialogue: 0,0:19:42.51,0:19:44.76,Default,,0,0,0,,‎Болды, аяқтаймыз.
Dialogue: 0,0:19:46.01,0:19:47.01,Default,,0,0,0,,‎(Янаги) Уау!
Dialogue: 0,0:19:47.51,0:19:48.77,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:19:49.43,0:19:51.27,Default,,0,0,0,,‎Ааа!
Dialogue: 0,0:19:52.94,0:19:55.86,Default,,0,0,0,,‎Ух... аа аа
Dialogue: 0,0:20:00.74,0:20:01.78,Default,,0,0,0,,‎(Козуэ) Май...
Dialogue: 0,0:20:02.28,0:20:03.11,Default,,0,0,0,,‎(Янаги) Хмм!
Dialogue: 0,0:20:04.07,0:20:05.28,Default,,0,0,0,,‎Уау!
Dialogue: 0,0:20:08.66,0:20:09.49,Default,,0,0,0,,‎Нуа!
Dialogue: 0,0:20:11.16,0:20:15.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:16.04,0:20:18.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:20.13,0:20:23.22,Default,,0,0,0,,‎Аа... аа аа
Dialogue: 0,0:20:24.76,0:20:26.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:28.35,0:20:29.56,Default,,0,0,0,,‎Күтілгендей
Dialogue: 0,0:20:29.85,0:20:31.06,Default,,0,0,0,,‎(Янаги) Уау
Dialogue: 0,0:20:31.27,0:20:32.56,Default,,0,0,0,,‎ (буындардың шерткен дыбысы)
Dialogue: 0,0:20:33.48,0:20:36.10,Default,,0,0,0,,Қол-аяғым сұйық...
Dialogue: 0,0:20:36.31,0:20:39.27,Default,,0,0,0,,Қаншалықты әлсіз елестетсеңіз де,
Dialogue: 0,0:20:39.44,0:20:40.57,Default,,0,0,0,,Адам денесі дегеніміз не?
Dialogue: 0,0:20:40.69,0:20:43.90,Default,,0,0,0,,Көмекке келмейтін буын бар.
Dialogue: 0,0:20:44.53,0:20:45.95,Default,,0,0,0,,Уау! Мен оны бүктеймін
Dialogue: 0,0:20:46.87,0:20:47.70,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:20:48.87,0:20:50.12,Default,,0,0,0,,Ах! Қауіпті!
Dialogue: 0,0:20:50.33,0:20:51.16,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:20:57.83,0:20:58.67,Default,,0,0,0,,О!
Dialogue: 0,0:20:59.42,0:21:00.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:00.63,0:21:02.01,Default,,0,0,0,,А...
Dialogue: 0,0:21:02.34,0:21:05.68,Default,,0,0,0,,‎(Сикорский) А...
Dialogue: 0,0:21:06.64,0:21:08.18,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:21:08.55,0:21:11.14,Default,,0,0,0,,Мен сенімен әлі бітіскен жоқпын.
Dialogue: 0,0:21:11.77,0:21:14.02,Default,,0,0,0,,Сіз ауруханада қала алмайсыз ба?
Dialogue: 0,0:21:17.02,0:21:17.85,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:18.61,0:21:19.44,Default,,0,0,0,,‎Nuo!
Dialogue: 0,0:21:19.86,0:21:22.48,Default,,0,0,0,,‎Хмм... Бұл біртүрлі.
Dialogue: 0,0:21:22.69,0:21:23.99,Default,,0,0,0,,‎Бет кесілмеген
Dialogue: 0,0:21:27.74,0:21:30.83,Default,,0,0,0,,Мойынды соққан бағытта айналдырды.
Dialogue: 0,0:21:31.41,0:21:32.83,Default,,0,0,0,,Мен жұдырықтасуға тым баяумын
Dialogue: 0,0:21:33.00,0:21:34.29,Default,,0,0,0,,Мен оны қолданып көрдім.
Dialogue: 0,0:21:34.62,0:21:36.37,Default,,0,0,0,,А... а...
Dialogue: 0,0:21:39.29,0:21:42.34,Default,,0,0,0,,Дәл қазір өзіңізді қалай сезінесіз.
Dialogue: 0,0:21:42.50,0:21:44.88,Default,,0,0,0,,Ол бұрынғы бала емес.
Dialogue: 0,0:21:45.51,0:21:46.34,Default,,0,0,0,,Хмм!
Dialogue: 0,0:21:47.47,0:21:51.64,Default,,0,0,0,,Бұл әрқайсымыз үшін тым көп.
Dialogue: 0,0:21:53.77,0:21:55.35,Default,,0,0,0,,2-1
Dialogue: 0,0:21:59.27,0:22:05.28,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:23:22.31,0:23:28.32,Default,,0,0,0,,‎〜♪
