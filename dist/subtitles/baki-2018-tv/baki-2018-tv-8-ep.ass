Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.80,0:00:17.80,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.21,0:01:40.22,Default,,0,0,0,,~♪
Dialogue: 0,0:01:53.36,0:01:54.94,Default,,0,0,0,,Жылдам әңгіме...
Dialogue: 0,0:01:56.69,0:02:00.24,Default,,0,0,0,,Мен ештеңе істей алмай жеңілдім.
Dialogue: 0,0:02:00.74,0:02:03.33,Default,,0,0,0,,Оның үстіне екі адам қажет.
Dialogue: 0,0:02:03.95,0:02:05.79,Default,,0,0,0,,Ммм
Dialogue: 0,0:02:06.87,0:02:08.21,Default,,0,0,0,,Ойын алаңындағы төбелесте
Dialogue: 0,0:02:08.91,0:02:14.59,Default,,0,0,0,,Әуесқойлардың жекпе-жек туралы мақтанышына жекпе-жек кәсіпқойы таң қалды
Dialogue: 0,0:02:15.34,0:02:18.72,Default,,0,0,0,,Хаха~ Бұл қарапайым әңгіме, бірақ
Dialogue: 0,0:02:19.13,0:02:22.55,Default,,0,0,0,,Ол жарыс ережелерімен қорғалады, жердегі спортшылар —
Dialogue: 0,0:02:22.68,0:02:26.68,Default,,0,0,0,,Сондықтан мені жекпе-жекке әуесқой деуге болады.
Dialogue: 0,0:02:26.81,0:02:28.89,Default,,0,0,0,,Не болуы мүмкін
Dialogue: 0,0:02:29.69,0:02:32.81,Default,,0,0,0,,Жалаң қол шайқаста жер бетінде бірінші орын алғанымды мақтан тұтамын.
Dialogue: 0,0:02:32.94,0:02:34.90,Default,,0,0,0,,Жер асты аренасы жауынгері
Dialogue: 0,0:02:35.02,0:02:38.90,Default,,0,0,0,,Баки-кун – ең биік шың...
Dialogue: 0,0:02:40.61,0:02:45.41,Default,,0,0,0,,Олар жер бетіндегі жас жекпе-жек шеберлеріне қаншалықты ұқсас?
Dialogue: 0,0:02:45.54,0:02:47.50,Default,,0,0,0,,Фуууууууууууууууууууууу
Dialogue: 0,0:02:48.50,0:02:50.46,Default,,0,0,0,,Сәйкестік жүйесінің кемшіліктері
Dialogue: 0,0:02:50.79,0:02:52.83,Default,,0,0,0,,Ойын қаншалықты үлкен болса да,
Dialogue: 0,0:02:52.96,0:02:55.67,Default,,0,0,0,,Егер жекпе-жек өнерінің бастауларына қайта оралсақ
Dialogue: 0,0:02:55.80,0:02:57.30,Default,,0,0,0,,Шынайы баратын жер
Dialogue: 0,0:02:57.42,0:03:01.97,Default,,0,0,0,,Бұл, әрине, сіз назарда болатын жарыс алаңы емес!
Dialogue: 0,0:03:02.26,0:03:04.05,Default,,0,0,0,,Күнделікті өмірде
Dialogue: 0,0:03:04.18,0:03:09.02,Default,,0,0,0,,Нақты әрекет - ешкім білместен орын алуы мүмкін әділетсіз зорлық-зомбылықты басу.
Dialogue: 0,0:03:09.56,0:03:12.94,Default,,0,0,0,,Қандай тану, қандай мақтау болсын
Dialogue: 0,0:03:13.06,0:03:17.03,Default,,0,0,0,,Ұрыста есін жоғалтқан күрескерді түкке тұрғысыз деуге болады.
Dialogue: 0,0:03:18.19,0:03:19.15,Default,,0,0,0,,Иә? а...?
Dialogue: 0,0:03:19.49,0:03:20.65,Default,,0,0,0,,Уф
Dialogue: 0,0:03:21.15,0:03:24.16,Default,,0,0,0,,Көрінген нәрсені қайталау
Dialogue: 0,0:03:24.28,0:03:26.41,Default,,0,0,0,,Хмм... Ки!
Dialogue: 0,0:03:28.54,0:03:29.91,Default,,0,0,0,,Ха! (Соло) О?
Dialogue: 0,0:03:30.08,0:03:31.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.41,0:03:33.67,Default,,0,0,0,,Жібер, сені!
Dialogue: 0,0:03:34.79,0:03:35.63,Default,,0,0,0,,Уф
Dialogue: 0,0:03:35.79,0:03:37.38,Default,,0,0,0,,(Токугаваның айқайы)
Dialogue: 0,0:03:37.75,0:03:40.76,Default,,0,0,0,,Қыран ең көп зардап шегетін адам!
Dialogue: 0,0:03:41.09,0:03:41.93,Default,,0,0,0,,Сізден!
Dialogue: 0,0:03:42.47,0:03:43.43,Default,,0,0,0,,Сіздерден!
Dialogue: 0,0:03:44.14,0:03:46.18,Default,,0,0,0,,Бәрінен де артық!
Dialogue: 0,0:03:48.60,0:03:49.60,Default,,0,0,0,,Қап…
Dialogue: 0,0:03:50.39,0:03:55.36,Default,,0,0,0,,Мен басқалардан гөрі жерасты аренасында ең мықты жауынгерге сендім.
Dialogue: 0,0:03:56.06,0:04:01.61,Default,,0,0,0,,Баки, Доппо, Ханаяма, Шибукава, Рецу!
Dialogue: 0,0:04:02.15,0:04:05.87,Default,,0,0,0,,Оған басқалардан артық сенген мен едім!
Dialogue: 0,0:04:06.32,0:04:12.00,Default,,0,0,0,,Менің өкінішімді бәріңіз түсінесіздер ме?
Dialogue: 0,0:04:13.00,0:04:15.12,Default,,0,0,0,,Иә? Қайда барасың, Баки?
Dialogue: 0,0:04:18.21,0:04:20.67,Default,,0,0,0,,Ата... Кешіріңіз.
Dialogue: 0,0:04:21.63,0:04:23.42,Default,,0,0,0,,Атам дұрыс айтады
Dialogue: 0,0:04:27.30,0:04:30.14,Default,,0,0,0,,Қайырлы кеш мырзалар
Dialogue: 0,0:04:35.85,0:04:37.65,Default,,0,0,0,,Барлығы формада
Dialogue: 0,0:04:37.86,0:04:39.02,Default,,0,0,0,,Ммм
Dialogue: 0,0:04:39.48,0:04:40.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:40.90,0:04:42.03,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:42.49,0:04:43.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:44.03,0:04:46.91,Default,,0,0,0,,О... күзетші...
Dialogue: 0,0:04:47.99,0:04:50.87,Default,,0,0,0,,Сіз сол пайдасыз адамдар туралы айтып отырсыз ба?
Dialogue: 0,0:04:56.50,0:04:58.63,Default,,0,0,0,,Сізге бензин ұнайды ма?
Dialogue: 0,0:05:02.59,0:05:04.47,Default,,0,0,0,,Мен оны іздедім~
Dialogue: 0,0:05:12.18,0:05:13.06,Default,,0,0,0,,Хмм!
Dialogue: 0,0:05:13.43,0:05:14.27,Default,,0,0,0,,Ах
Dialogue: 0,0:05:15.18,0:05:16.02,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:22.03,0:05:23.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:24.24,0:05:26.32,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:05:32.37,0:05:34.66,Default,,0,0,0,,Сізге бензин ұнайды ма?
Dialogue: 0,0:05:35.37,0:05:36.21,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:37.42,0:05:38.25,Default,,0,0,0,,Әй
Dialogue: 0,0:05:38.46,0:05:39.71,Default,,0,0,0,,Тория! Ха!
Dialogue: 0,0:05:45.13,0:05:47.05,Default,,0,0,0,,Иә
Dialogue: 0,0:05:48.93,0:05:51.26,Default,,0,0,0,,Бұл бөлімде көп нәрсе бар.
Dialogue: 0,0:05:51.68,0:05:53.10,Default,,0,0,0,,Катцуми…
Dialogue: 0,0:05:53.97,0:05:54.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:56.23,0:05:58.94,Default,,0,0,0,,Басқа адам сияқты
Dialogue: 0,0:05:59.85,0:06:01.77,Default,,0,0,0,,Мен көп нәрсені білдім
Dialogue: 0,0:06:02.48,0:06:03.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:03.52,0:06:04.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:05.32,0:06:06.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:06.78,0:06:07.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:07.82,0:06:09.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:10.11,0:06:14.04,Default,,0,0,0,,Түсінбедім... Матчтар мен спектакльдер
Dialogue: 0,0:06:16.58,0:06:20.04,Default,,0,0,0,,Ол каратэ спортшысы болса да, каратэ маманы емес еді.
Dialogue: 0,0:06:21.63,0:06:24.05,Default,,0,0,0,,Маған соны үйреткен саған
Dialogue: 0,0:06:24.17,0:06:25.80,Default,,0,0,0,,Рахмет айтқым келеді
Dialogue: 0,0:06:27.38,0:06:28.22,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:06:28.88,0:06:29.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:31.59,0:06:35.60,Default,,0,0,0,,Егер сіз осы жерде от жағысаңыз, сіз енді каратэмен айналыспайсыз.
Dialogue: 0,0:06:38.81,0:06:40.10,Default,,0,0,0,,Және…
Dialogue: 0,0:06:41.27,0:06:42.31,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:43.06,0:06:43.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:44.65,0:06:45.73,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:46.48,0:06:47.74,Default,,0,0,0,,(Рей) Уу-хуу! (Эмма) Уау!
Dialogue: 0,0:06:48.24,0:06:50.74,Default,,0,0,0,,Каратэші болмасаң, жарайды!
Dialogue: 0,0:06:53.62,0:06:55.49,Default,,0,0,0,,(жалынды дыбыс)
Dialogue: 0,0:06:55.62,0:06:56.99,Default,,0,0,0,,
Dialogue: 0,0:06:57.12,0:06:57.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:58.12,0:07:03.00,Default,,0,0,0,,Уау! Ой...
Dialogue: 0,0:07:03.13,0:07:05.00,Default,,0,0,0,,О... О!
Dialogue: 0,0:07:05.13,0:07:07.00,Default,,0,0,0,,Сәлем әке
Dialogue: 0,0:07:07.13,0:07:09.01,Default,,0,0,0,,(Дорианның ыңырсыуы)
Dialogue: 0,0:07:09.88,0:07:12.05,Default,,0,0,0,,Мен қателестім бе?
Dialogue: 0,0:07:12.26,0:07:16.01,Default,,0,0,0,,(Дорианның ыңырсыуы)
Dialogue: 0,0:07:16.72,0:07:17.97,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:07:18.43,0:07:19.52,Default,,0,0,0,,Ммм
Dialogue: 0,0:07:20.44,0:07:21.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:26.86,0:07:29.11,Default,,0,0,0,,Сіз қателесе алмайсыз.
Dialogue: 0,0:07:29.53,0:07:30.86,Default,,0,0,0,,Такешидің шынайы сезімдері
Dialogue: 0,0:07:30.99,0:07:33.91,Default,,0,0,0,,Бұл жауды айқын жеңу туралы емес.
Dialogue: 0,0:07:34.03,0:07:36.87,Default,,0,0,0,,Ұсқынсыз болса да жеңу
Dialogue: 0,0:07:37.33,0:07:41.25,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:07:41.75,0:07:43.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:44.46,0:07:48.71,Default,,0,0,0,,Жеңіске жетпесек, сөйлей де алмаймыз.
Dialogue: 0,0:07:49.38,0:07:53.55,Default,,0,0,0,,Түсіндім, тағы бірдеңе айтқың келген сияқты.
Dialogue: 0,0:07:53.93,0:07:56.22,Default,,0,0,0,,Кел, эстетикалық сезім.
Dialogue: 0,0:07:56.43,0:07:57.81,Default,,0,0,0,,сұлулық мағынасы
Dialogue: 0,0:07:57.93,0:07:59.06,Default,,0,0,0,,Білім
Dialogue: 0,0:07:59.47,0:08:02.06,Default,,0,0,0,,Бұл қаруды дайындама дегенді білдіреді.
Dialogue: 0,0:08:02.89,0:08:03.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.77,0:08:09.23,Default,,0,0,0,,Тіпті тегін болса да каратэші
Dialogue: 0,0:08:09.36,0:08:12.74,Default,,0,0,0,,Мен үнемі төбелесуге жаттығамын.
Dialogue: 0,0:08:13.07,0:08:15.91,Default,,0,0,0,,Адамдарды ұрып-соғуға уақыт бөліңіз
Dialogue: 0,0:08:16.41,0:08:19.83,Default,,0,0,0,,Шынын айту керек, бұл сізге тосын шабуыл.
Dialogue: 0,0:08:20.33,0:08:23.87,Default,,0,0,0,,Біз қару-жарақпен жабдықталғанбыз.
Dialogue: 0,0:08:24.17,0:08:27.50,Default,,0,0,0,,Сондықтан өзіңізбен бірге заттарды алып жүруге болмайды.
Dialogue: 0,0:08:27.75,0:08:30.09,Default,,0,0,0,,Менің қолымда кездейсоқ болған сөмке
Dialogue: 0,0:08:30.88,0:08:33.09,Default,,0,0,0,,Қалтамда желдеткіш болды.
Dialogue: 0,0:08:33.97,0:08:36.09,Default,,0,0,0,,Мен кездейсоқ тағып алған белбеу
Dialogue: 0,0:08:36.68,0:08:38.60,Default,,0,0,0,,Мен кездейсоқ киген аяқ киім
Dialogue: 0,0:08:38.89,0:08:42.14,Default,,0,0,0,,Сонымен қатар, қарсыластың қолында өлтіру қаруы
Dialogue: 0,0:08:42.39,0:08:46.23,Default,,0,0,0,,Егер маған оны пайдалануға рұқсат етілсе, ол осылай болар ма еді?
Dialogue: 0,0:08:46.40,0:08:49.73,Default,,0,0,0,,Егер маған сызық сызу керек болса, ол сол болар еді.
Dialogue: 0,0:08:50.98,0:08:55.53,Default,,0,0,0,,Бір уыс құм немесе қарындаш болса да.
Dialogue: 0,0:08:56.03,0:09:01.54,Default,,0,0,0,,Жекпе-жек алдында қолыңды алсаң, жекпе-жек шеберінің намысын тоздырады.
Dialogue: 0,0:09:03.66,0:09:04.62,Default,,0,0,0,,Өте жақсы екен. Хахаха.
Dialogue: 0,0:09:06.67,0:09:09.63,Default,,0,0,0,,Бұл барбекюмен не істеуім керек?
Dialogue: 0,0:09:09.92,0:09:12.96,Default,,0,0,0,,Бұл жедел жәрдем ме?
Dialogue: 0,0:09:13.42,0:09:15.80,Default,,0,0,0,,Бұл өте қауіпті жағдай...
Dialogue: 0,0:09:18.55,0:09:19.47,Default,,0,0,0,,Хмм?
Dialogue: 0,0:09:21.60,0:09:22.43,Default,,0,0,0,,Үзіліс!
Dialogue: 0,0:09:24.10,0:09:25.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:25.89,0:09:26.94,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:09:27.14,0:09:28.02,Default,,0,0,0,,Хмм?
Dialogue: 0,0:09:34.57,0:09:39.70,Default,,0,0,0,,(тыныс ұстау дыбысы)
Dialogue: 0,0:09:40.32,0:09:42.70,Default,,0,0,0,,Буха~!
Dialogue: 0,0:09:42.83,0:09:45.96,Default,,0,0,0,,(қатты жөтел ұстамасы)
Dialogue: 0,0:09:46.21,0:09:49.71,Default,,0,0,0,,Маған әзірше темекі керек емес.
Dialogue: 0,0:09:50.38,0:09:51.21,Default,,0,0,0,,Хо…
Dialogue: 0,0:09:51.88,0:09:52.71,Default,,0,0,0,,О...
Dialogue: 0,0:09:52.88,0:09:54.59,Default,,0,0,0,,сенің жапон мектеп формаңның —
Dialogue: 0,0:09:54.96,0:09:56.72,Default,,0,0,0,,Арх! Ал...
Dialogue: 0,0:09:58.30,0:10:01.72,Default,,0,0,0,,Сіздің серіктесіңіз Рецу-кун немесе Доппо-сан ба?
Dialogue: 0,0:10:03.39,0:10:04.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.93,0:10:09.27,Default,,0,0,0,,Әрине, менмін. Мен саған көп қарыздармын.
Dialogue: 0,0:10:09.60,0:10:12.15,Default,,0,0,0,,Бұған дейін сәл уақытыңызды бөле аласыз ба?
Dialogue: 0,0:10:12.61,0:10:16.24,Default,,0,0,0,,Негізі менің қожайыным бұл іске араласқысы келеді.
Dialogue: 0,0:10:17.03,0:10:18.49,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:19.53,0:10:21.70,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:10:25.04,0:10:25.91,Default,,0,0,0,,Гобусата
Dialogue: 0,0:10:29.67,0:10:32.92,Default,,0,0,0,,Практикалық каратэ Шиншинкайға қатысы
Dialogue: 0,0:10:33.42,0:10:37.97,Default,,0,0,0,,Доджода жаттығудан гөрі төбелес арқылы жаттығуды ұнататын өте практикалық жауынгер.
Dialogue: 0,0:10:38.34,0:10:39.43,Default,,0,0,0,,Като!
Dialogue: 0,0:10:40.51,0:10:41.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:42.01,0:10:44.31,Default,,0,0,0,,Қолыңда не болды?
Dialogue: 0,0:10:44.60,0:10:47.48,Default,,0,0,0,,Мынау? Хахахаха!
Dialogue: 0,0:10:48.23,0:10:49.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:50.39,0:10:51.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.02,0:10:52.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.98,0:10:55.73,Default,,0,0,0,,Сен жасаған сияқтысың, шетелдік.
Dialogue: 0,0:10:56.19,0:10:57.03,Default,,0,0,0,,Ой!
Dialogue: 0,0:10:57.53,0:10:58.69,Default,,0,0,0,,Адамның ортасы!
Dialogue: 0,0:11:01.61,0:11:04.78,Default,,0,0,0,,Сіз не істегеніңізді түсінесіз бе?
Dialogue: 0,0:11:04.91,0:11:06.99,Default,,0,0,0,,Дориан мырза?
Dialogue: 0,0:11:07.75,0:11:08.95,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,0:11:09.41,0:11:12.50,Default,,0,0,0,,Директор Доппо Гучидің жұдырығы қандай?
Dialogue: 0,0:11:12.63,0:11:14.34,Default,,0,0,0,,Алмаздан да қатты
Dialogue: 0,0:11:14.46,0:11:17.46,Default,,0,0,0,,Ол гауһар тастардан қымбат.
Dialogue: 0,0:11:18.67,0:11:19.55,Default,,0,0,0,,Қаа!
Dialogue: 0,0:11:20.05,0:11:22.09,Default,,0,0,0,,Ал...
Dialogue: 0,0:11:22.76,0:11:23.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:24.47,0:11:26.10,Default,,0,0,0,,Мен еш өкінбеймін.
Dialogue: 0,0:11:26.85,0:11:28.60,Default,,0,0,0,,Тыңдайтын құлағың болмаса
Dialogue: 0,0:11:29.39,0:11:30.23,Default,,0,0,0,,Ха
Dialogue: 0,0:11:30.35,0:11:32.35,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:11:32.94,0:11:33.90,Default,,0,0,0,,Иә
Dialogue: 0,0:11:34.98,0:11:35.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:35.98,0:11:36.82,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:11:36.98,0:11:37.82,Default,,0,0,0,,Хмм!
Dialogue: 0,0:11:46.74,0:11:47.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:48.20,0:11:49.20,Default,,0,0,0,,Ах! (Токугава) Уау!
Dialogue: 0,0:11:49.37,0:11:50.20,Default,,0,0,0,,О!
Dialogue: 0,0:11:50.66,0:11:53.21,Default,,0,0,0,,Като, сен...
Dialogue: 0,0:11:53.79,0:11:55.46,Default,,0,0,0,,О, бұл ма?
Dialogue: 0,0:11:56.29,0:11:57.46,Default,,0,0,0,,Уф
Dialogue: 0,0:11:58.17,0:12:02.26,Default,,0,0,0,,Бұл сақинаның тек жартысын ғана жабатын резеңке түтік.
Dialogue: 0,0:12:02.55,0:12:04.72,Default,,0,0,0,,Бас бармақ пен кішкентай саусаққа, осылайша
Dialogue: 0,0:12:05.51,0:12:08.22,Default,,0,0,0,,Жақсы нәрсені ұстау үшін бос уақытты пайдаланыңыз
Dialogue: 0,0:12:08.35,0:12:11.14,Default,,0,0,0,,Бұл жай ғана құлақ немесе мұрын болса, бұл оңай.
Dialogue: 0,0:12:12.52,0:12:16.61,Default,,0,0,0,,Мен балық аулағанды жақсы көремін, менде қармақ болды...
Dialogue: 0,0:12:16.73,0:12:17.73,Default,,0,0,0,,нашар ма?
Dialogue: 0,0:12:18.77,0:12:22.07,Default,,0,0,0,,Бұл сіздің қожайыныңыз ба? Катцуми
Dialogue: 0,0:12:24.86,0:12:25.91,Default,,0,0,0,,Осы сияқты нәрселер
Dialogue: 0,0:12:26.03,0:12:28.95,Default,,0,0,0,,Тәкаппарлық пен қадір-қасиетке тыйым салынбаған
Dialogue: 0,0:12:29.08,0:12:32.33,Default,,0,0,0,,Бір сәт ойланбастан бірден орындаңыз
Dialogue: 0,0:12:33.21,0:12:35.25,Default,,0,0,0,,Бұл адамның нақты шайқастағы ойлауы
Dialogue: 0,0:12:35.37,0:12:37.84,Default,,0,0,0,,Сізден гөрі әке
Dialogue: 0,0:12:38.04,0:12:40.05,Default,,0,0,0,,Тәңірлік!
Dialogue: 0,0:12:45.13,0:12:47.93,Default,,0,0,0,,Бұл екеумізге де жақсы мүмкіндік.
Dialogue: 0,0:12:48.10,0:12:49.81,Default,,0,0,0,,Үйрену
Dialogue: 0,0:12:50.89,0:12:53.52,Default,,0,0,0,,Шиншинкайдың мәні неде?
Dialogue: 0,0:12:54.19,0:12:55.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:55.14,0:12:57.52,Default,,0,0,0,,Міне, бұл!
Dialogue: 0,0:13:00.52,0:13:02.23,Default,,0,0,0,,Хехехе
Dialogue: 0,0:13:05.11,0:13:06.07,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:07.03,0:13:07.87,Default,,0,0,0,,Хмм!
Dialogue: 0,0:13:08.45,0:13:11.95,Default,,0,0,0,,Құйрығы толығымен оранған қарсыласқа тосын шабуыл
Dialogue: 0,0:13:12.20,0:13:13.87,Default,,0,0,0,,Әке, сіз осындай нәрсе жасайсыз ба?
Dialogue: 0,0:13:14.46,0:13:17.58,Default,,0,0,0,,Әй, ойын аяқталды.
Dialogue: 0,0:13:17.71,0:13:21.13,Default,,0,0,0,,Кацуми-санның мақтауына ашулансам ше?
Dialogue: 0,0:13:21.25,0:13:23.38,Default,,0,0,0,,Сәл арзан емес пе, директор?
Dialogue: 0,0:13:26.05,0:13:26.88,Default,,0,0,0,,О!
Dialogue: 0,0:13:27.01,0:13:27.89,Default,,0,0,0,,Ах! (Като) Уф!
Dialogue: 0,0:13:28.18,0:13:29.01,Default,,0,0,0,,О!
Dialogue: 0,0:13:29.68,0:13:31.81,Default,,0,0,0,,О! (Ретсу) Ха...
Dialogue: 0,0:13:32.47,0:13:33.31,Default,,0,0,0,,Уф
Dialogue: 0,0:13:34.14,0:13:35.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:35.73,0:13:37.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:38.94,0:13:40.23,Default,,0,0,0,,Фортепиано сымы?
Dialogue: 0,0:13:43.28,0:13:45.28,Default,,0,0,0,,Гууууууууууу~
Dialogue: 0,0:13:45.40,0:13:46.78,Default,,0,0,0,,Уау... Ару!
Dialogue: 0,0:13:47.86,0:13:48.70,Default,,0,0,0,,Ай!
Dialogue: 0,0:13:49.78,0:13:50.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:51.16,0:13:51.99,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:52.91,0:13:54.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:55.37,0:13:56.75,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:00.71,0:14:02.13,Default,,0,0,0,,А…?
Dialogue: 0,0:14:07.13,0:14:07.97,Default,,0,0,0,,Ха
Dialogue: 0,0:14:08.55,0:14:10.47,Default,,0,0,0,,Сіз түсінесіз бе?
Dialogue: 0,0:14:11.30,0:14:15.72,Default,,0,0,0,,Көріп отырғаныңыздай, әуе операциясы аяқ-қолды қаруға айналдырады.
Dialogue: 0,0:14:16.39,0:14:18.89,Default,,0,0,0,,Бұл керемет ұзақ уақытты алды
Dialogue: 0,0:14:19.02,0:14:24.07,Default,,0,0,0,,Сіз, батыстық, ешқашан түсіне алмайтын табандылықпен.
Dialogue: 0,0:14:24.19,0:14:26.53,Default,,0,0,0,,Оқу күндерінен өту
Dialogue: 0,0:14:26.99,0:14:29.74,Default,,0,0,0,,Жұдырық ақыры доғал қаруға айналады.
Dialogue: 0,0:14:29.91,0:14:33.53,Default,,0,0,0,,Сонымен қатар, ол өткір болады.
Dialogue: 0,0:14:35.33,0:14:37.20,Default,,0,0,0,,Соңында...
Dialogue: 0,0:14:37.71,0:14:39.71,Default,,0,0,0,,Пышаққа айналдырыңыз
Dialogue: 0,0:14:42.75,0:14:47.30,Default,,0,0,0,,Диаметрі 4 мкм, керілуі 200 кг арамид талшығы.
Dialogue: 0,0:14:47.42,0:14:49.88,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:14:51.84,0:14:52.68,Default,,0,0,0,,Га
Dialogue: 0,0:14:53.18,0:14:54.01,Default,,0,0,0,,О... О!
Dialogue: 0,0:14:54.85,0:14:58.27,Default,,0,0,0,,Каратэден («танг» деп айтылады) бос каратэге дейін
Dialogue: 0,0:14:58.81,0:15:02.27,Default,,0,0,0,,Қолда ештеңе болмау жолы
Dialogue: 0,0:15:02.61,0:15:04.52,Default,,0,0,0,,Сондықтан бұл «каратэ»
Dialogue: 0,0:15:05.44,0:15:08.44,Default,,0,0,0,,Ақырында, сізге Тегусты да алып жүрудің қажеті болмайды.
Dialogue: 0,0:15:09.07,0:15:10.03,Default,,0,0,0,,Хмм!
Dialogue: 0,0:15:10.74,0:15:12.53,Default,,0,0,0,,А... аа~!
Dialogue: 0,0:15:13.24,0:15:15.28,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:15:15.49,0:15:17.54,Default,,0,0,0,,Күрсін
Dialogue: 0,0:15:17.66,0:15:19.54,Default,,0,0,0,,Ах... уф
Dialogue: 0,0:15:19.66,0:15:21.17,Default,,0,0,0,,
Dialogue: 0,0:15:21.67,0:15:23.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:23.92,0:15:26.05,Default,,0,0,0,,О!
Dialogue: 0,0:15:30.47,0:15:34.43,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:37.85,0:15:40.56,Default,,0,0,0,,
Dialogue: 0,0:15:40.68,0:15:46.69,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:15:48.44,0:15:51.82,Default,,0,0,0,,Ой, бүркітті біреу лақтырып жіберді.
Dialogue: 0,0:15:52.49,0:15:54.95,Default,,0,0,0,,Гранатаның түйреуіш ұшты деп ойлаған кезде
Dialogue: 0,0:15:55.07,0:15:57.87,Default,,0,0,0,,Аулаға лақтырылды
Dialogue: 0,0:15:57.99,0:15:58.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:59.83,0:16:02.33,Default,,0,0,0,,Сонымен... қауіпсіз...
Dialogue: 0,0:16:05.04,0:16:08.34,Default,,0,0,0,,Басқа адамдар, соның ішінде қылмыскер қайда?
Dialogue: 0,0:16:08.80,0:16:13.34,Default,,0,0,0,,Қанша естігім келсе де, түсінгенімде ол жерде ешкім жоқ.
Dialogue: 0,0:16:13.63,0:16:18.35,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:16:24.23,0:16:27.86,Default,,0,0,0,,(Өтіп бара жатқан адамдардың шуы)
Dialogue: 0,0:16:46.50,0:16:49.88,Default,,0,0,0,,(Ағып жатқан судың дыбысы)
Dialogue: 0,0:16:50.38,0:16:51.92,Default,,0,0,0,,Я~
Dialogue: 0,0:16:52.55,0:16:53.88,Default,,0,0,0,,Иә? көк?
Dialogue: 0,0:16:56.34,0:16:57.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:58.22,0:16:59.89,Default,,0,0,0,,Суби Бәсен! Ах... Уау!
Dialogue: 0,0:17:00.51,0:17:02.14,Default,,0,0,0,,А... аа (өтіп бара жатқандар) Әй?
Dialogue: 0,0:17:25.87,0:17:26.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:27.46,0:17:28.29,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:17:30.25,0:17:33.17,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:17:40.35,0:17:41.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:44.35,0:17:45.18,Default,,0,0,0,,Хмм!
Dialogue: 0,0:17:48.15,0:17:49.65,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:50.40,0:17:51.23,Default,,0,0,0,,Уф
Dialogue: 0,0:17:55.40,0:17:56.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:27.73,0:18:28.81,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:18:34.53,0:18:35.36,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:50.62,0:18:52.08,Default,,0,0,0,,(шу)
Dialogue: 0,0:18:53.17,0:18:54.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:56.55,0:18:58.92,Default,,0,0,0,,Микке~
Dialogue: 0,0:19:06.60,0:19:10.39,Default,,0,0,0,,Сенің қуғаныңды білу азап.
Dialogue: 0,0:19:11.94,0:19:12.94,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:19:15.73,0:19:17.90,Default,,0,0,0,,Көңіліңізді қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:19:18.32,0:19:20.28,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:19:25.62,0:19:28.37,Default,,0,0,0,,Маған жеңіліс сыйлау, т.б.
Dialogue: 0,0:19:28.50,0:19:29.91,Default,,0,0,0,,өте өте
Dialogue: 0,0:19:30.41,0:19:31.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:35.67,0:19:37.42,Default,,0,0,0,,Бұлай лақтырмаңыз.
Dialogue: 0,0:19:46.64,0:19:50.18,Default,,0,0,0,,Бұл жақсы табылған.
Dialogue: 0,0:19:50.73,0:19:53.19,Default,,0,0,0,,Бұл жасырынатын орынның схемасы.
Dialogue: 0,0:19:53.65,0:19:54.69,Default,,0,0,0,,Хмм!
Dialogue: 0,0:19:55.98,0:19:58.19,Default,,0,0,0,,50 жылдан астам уақыт бұрын
Dialogue: 0,0:19:59.32,0:20:00.94,Default,,0,0,0,,Мен мұны қолдандым
Dialogue: 0,0:20:01.53,0:20:03.66,Default,,0,0,0,,Ха... соғыс?
Dialogue: 0,0:20:04.78,0:20:07.78,Default,,0,0,0,,Бұл жапондық әскери нысан болды.
Dialogue: 0,0:20:08.12,0:20:10.58,Default,,0,0,0,,Соғыстан кейін АҚШ әскері қолданды
Dialogue: 0,0:20:11.21,0:20:14.58,Default,,0,0,0,,Бұл менің жасөспірім кезімде болатын.
Dialogue: 0,0:20:15.21,0:20:18.13,Default,,0,0,0,,Ол екінші сыныпты жауынгер болды.
Dialogue: 0,0:20:19.13,0:20:21.22,Default,,0,0,0,,Өмірде осындай үлкен ағаға
Dialogue: 0,0:20:21.97,0:20:24.80,Default,,0,0,0,,Мен саған бірдеңе беруім керек...
Dialogue: 0,0:20:24.97,0:20:25.80,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:27.60,0:20:29.31,Default,,0,0,0,,Не... уф!
Dialogue: 0,0:20:29.77,0:20:30.68,Default,,0,0,0,,Хмф! (Като) Ах!
Dialogue: 0,0:20:31.39,0:20:32.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:33.44,0:20:34.27,Default,,0,0,0,,Гухе
Dialogue: 0,0:20:38.94,0:20:40.44,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:41.61,0:20:43.95,Default,,0,0,0,,H... Қытайдың жауынгерлік өнері?
Dialogue: 0,0:20:45.61,0:20:46.45,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:47.12,0:20:47.95,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:48.58,0:20:49.41,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:51.95,0:20:53.37,Default,,0,0,0,,(Бос бөтелкенің сынған дыбысы)
Dialogue: 0,0:20:59.38,0:21:03.72,Default,,0,0,0,,Егер сіз Токугава сарайында көрген менің қабілетіме сенсеңіз.
Dialogue: 0,0:21:04.34,0:21:06.80,Default,,0,0,0,,Мен сені аяймын
Dialogue: 0,0:21:07.55,0:21:09.22,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:19.90,0:21:21.23,Default,,0,0,0,,Май
Dialogue: 0,0:21:21.73,0:21:23.19,Default,,0,0,0,,О...
Dialogue: 0,0:21:25.90,0:21:29.37,Default,,0,0,0,,Көптеген шебер ойыншылармен күресу
Dialogue: 0,0:21:29.78,0:21:32.74,Default,,0,0,0,,Жеңілмесем де, аман қалмаймын.
Dialogue: 0,0:21:36.87,0:21:37.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:38.25,0:21:41.96,Default,,0,0,0,,Өз қабілетін жасыру еліктеу де
Dialogue: 0,0:21:42.09,0:21:46.26,Default,,0,0,0,,Тәтті жеңілістің рахатын көру үшін де керек.
Dialogue: 0,0:21:46.80,0:21:49.76,Default,,0,0,0,,Бұл 1900 жылдардың басы болатын
Dialogue: 0,0:21:49.89,0:21:52.76,Default,,0,0,0,,Америкада тыйым салынғанға дейін ойлап табылған
Dialogue: 0,0:21:53.72,0:21:56.35,Default,,0,0,0,,Аль Капоне әлі де бұзақы болған кезде
Dialogue: 0,0:21:56.48,0:22:00.27,Default,,0,0,0,,Бандалар өз қарсыластарын толығымен жеңу үшін
Dialogue: 0,0:22:00.40,0:22:02.36,Default,,0,0,0,,Жекпе-жек әдісі құрылды
Dialogue: 0,0:22:04.15,0:22:05.78,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:22:07.11,0:22:09.36,Default,,0,0,0,,Кісі өлтіру қаруы аяқталды
Dialogue: 0,0:22:10.32,0:22:12.12,Default,,0,0,0,,Сен де маған еліктеп ал.
Dialogue: 0,0:22:12.99,0:22:15.29,Default,,0,0,0,,Толық есеп айырысуды қаласаңыз
Dialogue: 0,0:22:17.12,0:22:18.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:21.25,0:22:27.26,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:45.09,0:23:51.09,Default,,0,0,0,,~♪
Dialogue: 0,0:23:52.59,0:23:58.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory