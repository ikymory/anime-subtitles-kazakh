Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:12.01,0:00:18.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.35,0:01:42.18,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:42.31,0:01:44.02,Default,,0,0,0,,Не? (Адам) Газ?
Dialogue: 0,0:01:44.14,0:01:46.94,Default,,0,0,0,,Қандай дыбыс? (Еркек) Мылтық сияқты емес пе еді?
Dialogue: 0,0:01:50.19,0:01:52.32,Default,,0,0,0,,Отшашу... мүмкін бе?
Dialogue: 0,0:01:53.40,0:01:54.36,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:01:56.28,0:01:57.11,Default,,0,0,0,,Ах
Dialogue: 0,0:01:57.57,0:02:01.20,Default,,0,0,0,,(будың көтерілу дыбысы)
Dialogue: 0,0:02:02.62,0:02:04.45,Default,,0,0,0,,(қанның ағу дыбысы)
Dialogue: 0,0:02:04.95,0:02:06.45,Default,,0,0,0,,(Төккен тердің дыбысы)
Dialogue: 0,0:02:09.33,0:02:11.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:17.88,0:02:20.43,Default,,0,0,0,,Сонда да... мұны істегіңіз келе ме?
Dialogue: 0,0:02:20.97,0:02:22.93,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:02:24.35,0:02:25.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:25.72,0:02:26.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:30.23,0:02:32.23,Default,,0,0,0,,Уф
Dialogue: 0,0:02:32.36,0:02:34.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:41.91,0:02:42.91,Default,,0,0,0,,Қандай ұят!
Dialogue: 0,0:02:43.03,0:02:43.87,Default,,0,0,0,,Уф
Dialogue: 0,0:02:44.03,0:02:48.37,Default,,0,0,0,,Менің оқтарымның ұрланғаны туралы қалай хабарлауым керек?
Dialogue: 0,0:02:48.71,0:02:50.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:50.67,0:02:51.83,Default,,0,0,0,,Басшы!
Dialogue: 0,0:02:52.13,0:02:54.13,Default,,0,0,0,,Мм... сипаттамалар...
Dialogue: 0,0:02:54.54,0:02:55.88,Default,,0,0,0,,Қайтып келдіңіз бе?
Dialogue: 0,0:02:57.30,0:02:58.38,Default,,0,0,0,,Дәлірек айтқанда...
Dialogue: 0,0:03:05.01,0:03:07.97,Default,,0,0,0,,
Dialogue: 0,0:03:09.10,0:03:11.27,Default,,0,0,0,,Ей, бұл кәдесый.
Dialogue: 0,0:03:12.98,0:03:15.02,Default,,0,0,0,,бұл... Каору Ханаяма
Dialogue: 0,0:03:19.19,0:03:20.86,Default,,0,0,0,,Гүлдер... таулар?
Dialogue: 0,0:03:22.07,0:03:27.20,Default,,0,0,0,,Ұрланған оқтар Ханаямаға қарсы қолданылған болуы мүмкін бе?
Dialogue: 0,0:03:30.41,0:03:31.46,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:03:32.21,0:03:36.42,Default,,0,0,0,,Емдеу жақсы ма? Мені супер VIP ретінде қабылдайды.
Dialogue: 0,0:03:37.50,0:03:38.34,Default,,0,0,0,,Хун
Dialogue: 0,0:03:39.63,0:03:40.72,Default,,0,0,0,,Маған жіберіңіз!
Dialogue: 0,0:03:40.84,0:03:41.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:42.18,0:03:43.80,Default,,0,0,0,,Катахира Бұл көлік!
Dialogue: 0,0:03:44.39,0:03:45.68,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:55.06,0:03:56.02,Default,,0,0,0,,Ханаяма
Dialogue: 0,0:03:59.07,0:04:01.19,Default,,0,0,0,,Менің қарызым көп.
Dialogue: 0,0:04:08.66,0:04:09.79,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:04:09.95,0:04:11.08,Default,,0,0,0,,Кету
Dialogue: 0,0:04:13.92,0:04:15.54,Default,,0,0,0,,Ах… олар ақылды да, сүйкімді де көрінеді, иә, Аня?
Dialogue: 0,0:04:18.00,0:04:19.00,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:04:19.13,0:04:19.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:21.59,0:04:25.93,Default,,0,0,0,,Офицер Цунео Катахира, 34 жаста, ол жүргізуші болды.
Dialogue: 0,0:04:26.39,0:04:29.18,Default,,0,0,0,,Осы кездегі жағдайды ол былай сипаттайды.
Dialogue: 0,0:04:30.56,0:04:32.64,Default,,0,0,0,,Сіз бұл оқиғаны айтқыңыз келді ме?
Dialogue: 0,0:04:32.77,0:04:35.40,Default,,0,0,0,,Иә, бәрі есімде.
Dialogue: 0,0:04:35.69,0:04:38.48,Default,,0,0,0,,Егжей-тегжейлі, жаңа ғана болған сияқты.
Dialogue: 0,0:04:38.69,0:04:40.82,Default,,0,0,0,,Мен сені ұмыта алмаймын.
Dialogue: 0,0:04:41.57,0:04:44.32,Default,,0,0,0,,Каору Ханаяма көлікке қанша уақытта отырады?
Dialogue: 0,0:04:44.78,0:04:49.08,Default,,0,0,0,,Жоқ, шынында да, 2-3 минуттай уақыт кетеді... Иә.
Dialogue: 0,0:04:49.45,0:04:50.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:50.41,0:04:54.12,Default,,0,0,0,,Сонымен, одан кейін Speck пайдаланған бірқатар құралдар бар.
Dialogue: 0,0:04:54.25,0:04:57.04,Default,,0,0,0,,Бұл оның 2-3 минут ішінде сатып алынғанын білдіреді.
Dialogue: 0,0:04:57.17,0:04:59.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:00.00,0:05:02.59,Default,,0,0,0,,Иә, бұл оқиға себеп болды.
Dialogue: 0,0:05:02.88,0:05:05.34,Default,,0,0,0,,Мен өз басым келісемін.
Dialogue: 0,0:05:05.68,0:05:07.84,Default,,0,0,0,,Ерекше болған жағдайда.
Dialogue: 0,0:05:08.22,0:05:11.72,Default,,0,0,0,,Полиция қызметкерлеріне де пулемет алып жүруге рұқсат етілсін.
Dialogue: 0,0:05:12.43,0:05:13.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:13.60,0:05:15.27,Default,,0,0,0,,Ngh!
Dialogue: 0,0:05:17.27,0:05:18.73,Default,,0,0,0,,Иә аударылды
Dialogue: 0,0:05:19.44,0:05:20.82,Default,,0,0,0,,Жоқ, барлығы бірден.
Dialogue: 0,0:05:20.98,0:05:23.23,Default,,0,0,0,,Осылай, бірден Горон сияқты сезіледі.
Dialogue: 0,0:05:30.20,0:05:32.29,Default,,0,0,0,,Өте тәтті
Dialogue: 0,0:05:32.66,0:05:34.41,Default,,0,0,0,,Бұл әлі ұл
Dialogue: 0,0:05:35.66,0:05:39.21,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:40.13,0:05:42.96,Default,,0,0,0,,Бірден осылай итерсең
Dialogue: 0,0:05:43.09,0:05:46.42,Default,,0,0,0,,Сіз жеңуіңіз әбден мүмкін еді.
Dialogue: 0,0:05:52.18,0:05:54.56,Default,,0,0,0,,Хун хұн һұх хун♪
Dialogue: 0,0:05:59.44,0:06:00.27,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:01.40,0:06:04.03,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:04.69,0:06:06.19,Default,,0,0,0,,Ал мына бағана бар.
Dialogue: 0,0:06:08.91,0:06:10.53,Default,,0,0,0,,Ұрыс емес
Dialogue: 0,0:06:12.70,0:06:14.83,Default,,0,0,0,,Бірін-бірі өлтіріп жатыр.
Dialogue: 0,0:06:15.41,0:06:17.04,Default,,0,0,0,,Міне, балам.
Dialogue: 0,0:06:17.54,0:06:21.17,Default,,0,0,0,,Төбелес сияқты тәтті дүние емес.
Dialogue: 0,0:06:22.09,0:06:25.84,Default,,0,0,0,,Мен сияқты әлемде өмір сүретін адамдарға
Dialogue: 0,0:06:26.30,0:06:27.84,Default,,0,0,0,,Ойын дегеніміз не?
Dialogue: 0,0:06:28.34,0:06:29.18,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:06:29.30,0:06:30.47,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:31.84,0:06:32.68,Default,,0,0,0,,Уф
Dialogue: 0,0:06:34.01,0:06:34.97,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:06:38.98,0:06:43.73,Default,,0,0,0,,Сен екеуміз өміріміз үшін күресіп, бәрін қатерге тіктік.
Dialogue: 0,0:06:46.44,0:06:50.74,Default,,0,0,0,,Тосын шабуыл, айлалы шабуыл, қару қолдану
Dialogue: 0,0:06:51.03,0:06:52.91,Default,,0,0,0,,Бәрі жақсы
Dialogue: 0,0:06:54.24,0:06:57.83,Default,,0,0,0,,Мен осындай кеңістік құрдым.
Dialogue: 0,0:06:58.12,0:07:02.67,Default,,0,0,0,,Асфальт пен сіздің басыңыздың арасында шамамен 10 сантиметр...
Dialogue: 0,0:07:03.67,0:07:07.59,Default,,0,0,0,,Бұл кейде каратэ сынақтары үшін қолданылатын трюк.
Dialogue: 0,0:07:08.46,0:07:12.51,Default,,0,0,0,,Төмендегі тас пен анвилдің арасында кішкене бос орын қалдырыңыз.
Dialogue: 0,0:07:13.14,0:07:16.39,Default,,0,0,0,,Осылай ұрсаң, оны әуесқой да сындырады.
Dialogue: 0,0:07:17.22,0:07:20.39,Default,,0,0,0,,Өйткені, темірмен ұрып жатырсың.
Dialogue: 0,0:07:21.73,0:07:25.65,Default,,0,0,0,,Бірақ бұл асфальт пен адамның миымен жасалған.
Dialogue: 0,0:07:26.11,0:07:26.94,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:27.07,0:07:28.23,Default,,0,0,0,,Бұл керемет дыбыс шығарды.
Dialogue: 0,0:07:28.61,0:07:31.99,Default,,0,0,0,,Сіз гусяны немесе дочаны айтасыз ба? Хаха
Dialogue: 0,0:07:33.91,0:07:35.78,Default,,0,0,0,,Сәлем! Хахаха
Dialogue: 0,0:07:36.08,0:07:37.79,Default,,0,0,0,,Ха! Сәлем!
Dialogue: 0,0:07:39.79,0:07:40.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:40.75,0:07:43.21,Default,,0,0,0,,Сіз өзіңізді өлтіремін деп ойладыңыз ба?
Dialogue: 0,0:07:43.83,0:07:45.38,Default,,0,0,0,,Ханаяма ше?
Dialogue: 0,0:07:45.84,0:07:46.75,Default,,0,0,0,,Хаа~
Dialogue: 0,0:07:47.84,0:07:49.34,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:07:49.59,0:07:52.05,Default,,0,0,0,,Балалар, сендер түсінбейсіңдер ғой.
Dialogue: 0,0:07:52.34,0:07:54.68,Default,,0,0,0,,“Каору Ханаяма” есімді адам
Dialogue: 0,0:07:55.05,0:07:57.22,Default,,0,0,0,,Жарайды, сен сондайсың.
Dialogue: 0,0:07:57.35,0:07:59.81,Default,,0,0,0,,Әдетте жарыс болады.
Dialogue: 0,0:07:59.93,0:08:01.02,Default,,0,0,0,,«Қалыпты»
Dialogue: 0,0:08:01.14,0:08:02.56,Default,,0,0,0,,Хи хи~
Dialogue: 0,0:08:02.89,0:08:06.44,Default,,0,0,0,,Бірақ бұл Каору Ханаяманың әңгімесі, солай емес пе?
Dialogue: 0,0:08:14.28,0:08:15.11,Default,,0,0,0,,Ах
Dialogue: 0,0:08:16.03,0:08:17.62,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:08:18.99,0:08:19.83,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:24.12,0:08:24.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:25.37,0:08:28.09,Default,,0,0,0,,Менің бетімнен атып алдың.
Dialogue: 0,0:08:28.42,0:08:30.38,Default,,0,0,0,,Бұл қазірдің өзінде тәртіпсіздік.
Dialogue: 0,0:08:31.13,0:08:32.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:32.76,0:08:33.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:34.22,0:08:37.72,Default,,0,0,0,,Бұл атқа міну, иә, баланың төбелесіндей.
Dialogue: 0,0:08:38.14,0:08:41.47,Default,,0,0,0,,Ерекшеліктер тарапынан да біраз қарсылық болған сияқты.
Dialogue: 0,0:08:42.10,0:08:44.23,Default,,0,0,0,,Ал, қалғаны қорқынышты.
Dialogue: 0,0:08:44.48,0:08:45.65,Default,,0,0,0,,аңғал
Dialogue: 0,0:08:45.77,0:08:47.27,Default,,0,0,0,,Сынақты бөлу трюк…
Dialogue: 0,0:08:47.40,0:08:50.23,Default,,0,0,0,,Енді мен өлтіретін адаммын.
Dialogue: 0,0:08:50.94,0:08:52.69,Default,,0,0,0,,Өйткені мен полиция қызметкерімін.
Dialogue: 0,0:08:52.82,0:08:57.07,Default,,0,0,0,,Әрине, мен төбелесші Каору Ханаяма туралы аңызды естідім.
Dialogue: 0,0:08:57.20,0:09:00.12,Default,,0,0,0,,Бірақ бұл сіз көрген немесе естіген нәрсе емес.
Dialogue: 0,0:09:00.45,0:09:02.12,Default,,0,0,0,,Жын сияқты...
Dialogue: 0,0:09:03.12,0:09:05.54,Default,,0,0,0,,Мен полиция қызметкері ретінде осыны айтамын.
Dialogue: 0,0:09:05.67,0:09:09.17,Default,,0,0,0,,Ер адам ретінде мен сізге аздап сүйсінемін.
Dialogue: 0,0:09:10.09,0:09:11.80,Default,,0,0,0,,Керемет
Dialogue: 0,0:09:12.05,0:09:15.38,Default,,0,0,0,,Меніңше, сенің төбелесуге өте шебер екеніңді таң қалдырады.
Dialogue: 0,0:09:15.88,0:09:20.56,Default,,0,0,0,,Полиция қызметкері болсаң да, бұл тек еркектік инстинкт, хаха.
Dialogue: 0,0:09:21.31,0:09:22.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:22.27,0:09:24.27,Default,,0,0,0,,Сен мені неше рет ұрдың?
Dialogue: 0,0:09:24.98,0:09:29.06,Default,,0,0,0,,Жоқ, шайқас аяқталуға жақын қалды.
Dialogue: 0,0:09:30.94,0:09:33.65,Default,,0,0,0,,Ерекшеліктер біртүрлі нәрсе жасады.
Dialogue: 0,0:09:34.57,0:09:37.28,Default,,0,0,0,,«Көз байланған». Сол қолыңызды осылай пайдаланыңыз...
Dialogue: 0,0:09:38.20,0:09:40.24,Default,,0,0,0,,Бар болғаны 1-2 секунд уақыт
Dialogue: 0,0:09:40.37,0:09:43.83,Default,,0,0,0,,Дәл осы кезде Ханаяманың соққысы тоқтады.
Dialogue: 0,0:09:44.70,0:09:47.16,Default,,0,0,0,,Мен не болғанын бірден білдім.
Dialogue: 0,0:09:47.33,0:09:48.83,Default,,0,0,0,,Біз полиция қызметкерлері білеміз
Dialogue: 0,0:09:48.96,0:09:51.84,Default,,0,0,0,,Бұл әлемдегі ең күшті жарық.
Dialogue: 0,0:09:53.21,0:09:55.34,Default,,0,0,0,,Сіз де білуіңіз мүмкін
Dialogue: 0,0:09:55.51,0:09:57.63,Default,,0,0,0,,Автобус ұрлау оқиғасында да қолданылған.
Dialogue: 0,0:09:57.76,0:10:01.39,Default,,0,0,0,,Бұл жарық пен дыбыспен қылмыскерлерді залалсыздандыратын бомба.
Dialogue: 0,0:10:01.85,0:10:02.68,Default,,0,0,0,,Ресми түрде
Dialogue: 0,0:10:02.81,0:10:06.43,Default,,0,0,0,,Сіз таңғажайып граната сияқты нәрсені айтасыз ба?
Dialogue: 0,0:10:06.56,0:10:09.69,Default,,0,0,0,,Оны кейде граната деп те атайды, бірақ иә.
Dialogue: 0,0:10:09.98,0:10:13.15,Default,,0,0,0,,Бір сәтте қатты жарық пен дыбыс шығаратын бомба.
Dialogue: 0,0:10:14.11,0:10:18.70,Default,,0,0,0,,Адамдар сол жарық пен дыбыстың әсеріне ұшыраған сәтте олар мүлде қауқарсыз болып қалады.
Dialogue: 0,0:10:18.86,0:10:21.16,Default,,0,0,0,,Мен тіпті ойлай да алмаймын.
Dialogue: 0,0:10:21.66,0:10:24.41,Default,,0,0,0,,Пышақ бар ма, мылтық бар ма
Dialogue: 0,0:10:24.91,0:10:27.50,Default,,0,0,0,,Сол жарық түскенде адамдар қандай әрекеттер жасайды?
Dialogue: 0,0:10:27.62,0:10:29.25,Default,,0,0,0,,Бір ғана.
Dialogue: 0,0:10:29.79,0:10:31.29,Default,,0,0,0,,«бүгілу»
Dialogue: 0,0:10:32.42,0:10:34.59,Default,,0,0,0,,Әрине, бұл жағдайда солай болды.
Dialogue: 0,0:10:34.75,0:10:37.47,Default,,0,0,0,,Бұл барлық жастағы ерлер мен әйелдерге арналған инстинкт.
Dialogue: 0,0:10:38.42,0:10:41.43,Default,,0,0,0,,Бірақ бұл Каору Ханаяма деп ойлаймын.
Dialogue: 0,0:10:41.76,0:10:43.18,Default,,0,0,0,,Мен тұрмын.
Dialogue: 0,0:10:43.51,0:10:46.43,Default,,0,0,0,,Жоқ, ол мүлде селт етпейтін сияқты.
Dialogue: 0,0:10:47.64,0:10:49.85,Default,,0,0,0,,Бірақ оның көзі көрмеген шығар.
Dialogue: 0,0:10:49.98,0:10:51.81,Default,,0,0,0,,Мен бағаны өткізіп алдым.
Dialogue: 0,0:10:54.19,0:10:56.32,Default,,0,0,0,,Қаруды қолдануға басымдық беретін техникалық сипаттамалар
Dialogue: 0,0:10:56.94,0:10:59.03,Default,,0,0,0,,Менің ойымша, ол бұрышта қалды.
Dialogue: 0,0:10:59.65,0:11:03.12,Default,,0,0,0,,Соңғы және ең сенімді қару
Dialogue: 0,0:11:03.28,0:11:05.95,Default,,0,0,0,,Қолданғаным өз денем болды.
Dialogue: 0,0:11:06.66,0:11:09.54,Default,,0,0,0,,Жұмыс үшін дзюдомен де айналысамыз.
Dialogue: 0,0:11:09.66,0:11:11.08,Default,,0,0,0,,Менің білетінім осы ғана
Dialogue: 0,0:11:11.21,0:11:15.00,Default,,0,0,0,,Толық анықталған жалаңаш тарылтудан мүлде құтылу мүмкін емес.
Dialogue: 0,0:11:15.50,0:11:16.92,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:11:17.05,0:11:20.05,Default,,0,0,0,,Менің ойымша, қашуға жол жоқ деп айту керек.
Dialogue: 0,0:11:20.17,0:11:21.55,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:11:21.68,0:11:24.93,Default,,0,0,0,,Мен мұнда «техника» сөзін әдейі қолдандым.
Dialogue: 0,0:11:25.47,0:11:27.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:27.72,0:11:29.43,Default,,0,0,0,,Бұл қулық емес
Dialogue: 0,0:11:30.39,0:11:34.19,Default,,0,0,0,,Ханаяманың ұстау күшін ұстағыш динамометрмен өлшеу мүмкін емес.
Dialogue: 0,0:11:34.98,0:11:38.78,Default,,0,0,0,,Ойын карталарының бір бөлігін жұлып алу деп аталады.
Dialogue: 0,0:11:39.15,0:11:42.36,Default,,0,0,0,,Бұл Трамп па? Бұл Кастелла емес.
Dialogue: 0,0:11:43.07,0:11:46.78,Default,,0,0,0,,Мен жарылғыш күшті туа біткен нәрсе деп естідім.
Dialogue: 0,0:11:46.91,0:11:50.54,Default,,0,0,0,,Құдай таңғажайып сыйлықтар береді.
Dialogue: 0,0:11:52.00,0:11:56.17,Default,,0,0,0,,Біз, полиция, Ханаяма туралы көптен бері айтып келеміз.
Dialogue: 0,0:11:56.29,0:11:58.88,Default,,0,0,0,,Бір ауыздан қалған анекдот бар.
Dialogue: 0,0:11:59.21,0:12:00.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:00.17,0:12:01.34,Default,,0,0,0,,Алайда, осы жағдайда біз әлі де кісі өлтірулердің қалай жасалып жатқанын білмейміз.
Dialogue: 0,0:12:01.47,0:12:04.14,Default,,0,0,0,,Жасөспірімдер арасында жартылай орта салмақта әлем чемпионы болды
Dialogue: 0,0:12:04.26,0:12:06.26,Default,,0,0,0,,Юрий Чаковский
Dialogue: 0,0:12:06.55,0:12:09.18,Default,,0,0,0,,Иә, дұрыс, мен ауыр салмаққа көштім.
Dialogue: 0,0:12:09.31,0:12:12.85,Default,,0,0,0,,Бұл рейтингке кірер алдында кенеттен зейнетке шыққан ойыншы.
Dialogue: 0,0:12:13.48,0:12:16.23,Default,,0,0,0,,Ол жоспарланған матчты бастағалы жатыр еді.
Dialogue: 0,0:12:16.36,0:12:20.03,Default,,0,0,0,,Оған біреу шабуыл жасап, жарақаттап, кейін зейнеткерлікке шықты.
Dialogue: 0,0:12:20.15,0:12:22.90,Default,,0,0,0,,Бұл ресми түрде жариялануы керек еді.
Dialogue: 0,0:12:23.40,0:12:27.12,Default,,0,0,0,,Негізі Юрийді ауруханаға жеткізген санитарлар
Dialogue: 0,0:12:27.24,0:12:29.33,Default,,0,0,0,,Ол анық сөйлейді.
Dialogue: 0,0:12:29.74,0:12:33.04,Default,,0,0,0,,«Юридің қолы жарылған».
Dialogue: 0,0:12:34.00,0:12:36.21,Default,,0,0,0,,Иә, сен таптың.
Dialogue: 0,0:12:36.33,0:12:39.80,Default,,0,0,0,,Шабуылдаушы Каору Ханаяма болды.
Dialogue: 0,0:12:39.92,0:12:40.80,Default,,0,0,0,,(жарылғыш)
Dialogue: 0,0:12:41.38,0:12:42.97,Default,,0,0,0,,Ханаяма үшін,
Dialogue: 0,0:12:43.09,0:12:46.30,Default,,0,0,0,,Тіпті ауыр салмақтағы боксшының соққысымен салыстыруға болады.
Dialogue: 0,0:12:46.43,0:12:50.01,Default,,0,0,0,,Менің ойымша, сіз оларды бір рет ұстасаңыз, бәрі бірдей.
Dialogue: 0,0:12:51.10,0:12:51.93,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:12:52.10,0:12:54.52,Default,,0,0,0,,Сіздің ерекше ұстаған күшіңіз өзі үшін айтсын
Dialogue: 0,0:12:54.64,0:12:57.31,Default,,0,0,0,,Ер адамның қолын жаншу.
Dialogue: 0,0:12:57.44,0:12:59.23,Default,,0,0,0,,Менің ойымша, сіз оны «техника» деп атай алмайсыз.
Dialogue: 0,0:12:59.48,0:13:01.61,Default,,0,0,0,,Бұл шабуыл деп аталады ма?
Dialogue: 0,0:13:01.73,0:13:03.19,Default,,0,0,0,,Мен бұл туралы кейінірек естідім.
Dialogue: 0,0:13:03.65,0:13:07.49,Default,,0,0,0,,Спек те не болып жатқанын түсінбеген сияқты.
Dialogue: 0,0:13:10.33,0:13:11.49,Default,,0,0,0,,Сәлем~!
Dialogue: 0,0:13:11.62,0:13:13.66,Default,,0,0,0,,Бұл өте ауыр болса керек.
Dialogue: 0,0:13:13.79,0:13:17.25,Default,,0,0,0,,Мұндай ұстау күшімен сіз ішкі жамбасыңызды қысуға болады.
Dialogue: 0,0:13:17.92,0:13:20.75,Default,,0,0,0,,Иә, мұны да «техника» деп атауға болмайды.
Dialogue: 0,0:13:22.59,0:13:23.42,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:23.55,0:13:24.63,Default,,0,0,0,,Бұл құлақ болды.
Dialogue: 0,0:13:24.76,0:13:27.59,Default,,0,0,0,,Тамырға жету үшін ортаңғы саусағын пайдаланды.
Dialogue: 0,0:13:27.80,0:13:29.97,Default,,0,0,0,,Ол миға жеткен болуы мүмкін.
Dialogue: 0,0:13:31.01,0:13:34.98,Default,,0,0,0,,Бірақ сонда да Ханаяманың шабуылын тоқтату мүмкін болмады.
Dialogue: 0,0:13:35.27,0:13:36.39,Default,,0,0,0,,О...
Dialogue: 0,0:13:36.52,0:13:40.19,Default,,0,0,0,,Бұл менің тамағым. Менің ойымша, бұл үшін ота жасау жақсы идея емес.
Dialogue: 0,0:13:40.31,0:13:42.48,Default,,0,0,0,,Шамасы, ол толығымен жойылған.
Dialogue: 0,0:13:45.11,0:13:46.78,Default,,0,0,0,,Ол тұрған сияқты.
Dialogue: 0,0:13:47.86,0:13:51.24,Default,,0,0,0,,Иә, мен оның екі тізесіне оқ тигеніне сенімдімін.
Dialogue: 0,0:13:51.95,0:13:56.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:56.37,0:13:59.75,Default,,0,0,0,,Бұл Каору Ханаяма.
Dialogue: 0,0:14:00.33,0:14:05.26,Default,,0,0,0,,(Ханаяманың айқайы)
Dialogue: 0,0:14:11.39,0:14:12.97,Default,,0,0,0,,(электрокардиограмма дыбысы)
Dialogue: 0,0:14:14.31,0:14:16.89,Default,,0,0,0,,Оны қалай түсіндіруіміз керек?
Dialogue: 0,0:14:17.14,0:14:19.14,Default,,0,0,0,,Мұнда әкелінген кезде
Dialogue: 0,0:14:19.27,0:14:22.27,Default,,0,0,0,,Көптеген бағалаулар шамамен 50 жаста.
Dialogue: 0,0:14:22.40,0:14:24.90,Default,,0,0,0,,Бірақ фактілер туралы не деуге болады?
Dialogue: 0,0:14:25.36,0:14:28.15,Default,,0,0,0,,Нақты жасы 97 жаста
Dialogue: 0,0:14:29.32,0:14:33.12,Default,,0,0,0,,Бірнеше күннің ішінде ол көзге көрінетіндей нашарлай бастады.
Dialogue: 0,0:14:33.41,0:14:38.54,Default,,0,0,0,,Бір аптадан аз уақыт ішінде менің сыртқы түрім нақты жасыма сәйкес келеді.
Dialogue: 0,0:14:39.33,0:14:40.17,Default,,0,0,0,,Директор
Dialogue: 0,0:14:40.79,0:14:42.50,Default,,0,0,0,,Медицинаның бүкіл тарихын алып қарасақ та
Dialogue: 0,0:14:42.71,0:14:45.46,Default,,0,0,0,,Бұл бұрын-соңды болмаған нәрсе ме?
Dialogue: 0,0:14:46.42,0:14:49.13,Default,,0,0,0,,Хмм... жоқ шығар.
Dialogue: 0,0:14:49.26,0:14:52.55,Default,,0,0,0,,Бұдан артық экстремалды мысалдар жоқ шығар.
Dialogue: 0,0:14:53.60,0:14:56.06,Default,,0,0,0,,Ресми жазба болмаса да...
Dialogue: 0,0:14:56.72,0:14:57.60,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:15:00.35,0:15:03.77,Default,,0,0,0,,1976 Калифорния жағалауында
Dialogue: 0,0:15:04.48,0:15:07.36,Default,,0,0,0,,Қазына іздеушісі Джек Ли Бионде
Dialogue: 0,0:15:07.53,0:15:10.70,Default,,0,0,0,,30 жылдан астам іздегеннен кейін суға батқан кемені тапты
Dialogue: 0,0:15:12.11,0:15:15.99,Default,,0,0,0,,1844 жылы суға батқан бұл кеменің аты
Dialogue: 0,0:15:16.12,0:15:17.58,Default,,0,0,0,,Әулие Кран
Dialogue: 0,0:15:18.04,0:15:19.91,Default,,0,0,0,,Бұл британдық жүк кемесі болды.
Dialogue: 0,0:15:21.08,0:15:25.92,Default,,0,0,0,,Құтқарылған алтын монеталар, күміс монеталар, зергерлік бұйымдар және антикварлық заттар
Dialogue: 0,0:15:26.05,0:15:27.46,Default,,0,0,0,,200-ден астам қорап
Dialogue: 0,0:15:27.84,0:15:30.93,Default,,0,0,0,,Нарық құны 70 миллиард иеннен асты.
Dialogue: 0,0:15:32.64,0:15:36.39,Default,,0,0,0,,Бионданың сөздері сол кездегі газеттерде жазылған.
Dialogue: 0,0:15:37.35,0:15:41.89,Default,,0,0,0,,«Мен қазынаны көрген сәтте мен эякуляция жасадым!»
Dialogue: 0,0:15:43.60,0:15:45.69,Default,,0,0,0,,Ол кезде бұл жаман әзіл болатын
Dialogue: 0,0:15:45.81,0:15:48.19,Default,,0,0,0,,Сұхбат күлді, бірақ
Dialogue: 0,0:15:48.48,0:15:52.36,Default,,0,0,0,,Бірден кейін оның сөздері әдеттен тыс сенімділікке ие болады.
Dialogue: 0,0:15:54.03,0:15:56.53,Default,,0,0,0,,Бионда қайтыс болды.
Dialogue: 0,0:15:58.37,0:16:02.67,Default,,0,0,0,,Әңгімені естіген әрбір адам алғашында қылмысты елестетеді.
Dialogue: 0,0:16:03.29,0:16:07.88,Default,,0,0,0,,Өйткені, бұл ондаған миллиард қазынасы бар адамның кенеттен қайтыс болуы.
Dialogue: 0,0:16:09.00,0:16:11.63,Default,,0,0,0,,Бірақ ішке кірген тілшілердің көзінше
Dialogue: 0,0:16:11.76,0:16:14.59,Default,,0,0,0,,Бионданың өлімінің себебін бір топ дәрігерлер жариялады.
Dialogue: 0,0:16:15.59,0:16:18.06,Default,,0,0,0,,Бұл «қарттық» болды!
Dialogue: 0,0:16:19.97,0:16:22.94,Default,,0,0,0,,Бұл қазынаның табылғанына 14-ші күн болды.
Dialogue: 0,0:16:23.39,0:16:25.81,Default,,0,0,0,,Қатысқандардың бәрі таң қалды.
Dialogue: 0,0:16:27.48,0:16:31.78,Default,,0,0,0,,Тіпті 20 жыл отасқан әйелім Белинда да сенгісі келмеді.
Dialogue: 0,0:16:33.61,0:16:38.08,Default,,0,0,0,,Кейінірек жеке куәлік негізінде таңғаларлық факт анықталды.
Dialogue: 0,0:16:38.20,0:16:40.49,Default,,0,0,0,,Дүние жүзіне саяхат жасайды
Dialogue: 0,0:16:41.75,0:16:45.37,Default,,0,0,0,,Дені сау орта жастағы бұл адам әрқашан теңізді жақсы көреді.
Dialogue: 0,0:16:46.13,0:16:48.34,Default,,0,0,0,,Джек Ли Биондының нақты жасы
Dialogue: 0,0:16:48.46,0:16:50.71,Default,,0,0,0,,Іс жүзінде 88 жаста
Dialogue: 0,0:16:52.59,0:16:55.22,Default,,0,0,0,,Бірақ бұл тек бейресми
Dialogue: 0,0:16:55.59,0:16:58.93,Default,,0,0,0,,Мұны жай әзіл деп түсініңіз.
Dialogue: 0,0:16:59.47,0:17:03.43,Default,,0,0,0,,Бірақ... бірақ бұл рас, солай емес пе? Директор
Dialogue: 0,0:17:03.98,0:17:06.48,Default,,0,0,0,,Көптен күткен арманыңа жеткенде
Dialogue: 0,0:17:06.69,0:17:10.19,Default,,0,0,0,,Осы уақытқа дейін мені қолдап келген энергияны жоғалттым.
Dialogue: 0,0:17:11.07,0:17:14.95,Default,,0,0,0,,Сіз бұл құбылысты осылай ойлаудан басқа түсіндіре аласыз ба?
Dialogue: 0,0:17:15.07,0:17:17.74,Default,,0,0,0,,Бірақ... Бірақ бұл адам
Dialogue: 0,0:17:17.86,0:17:20.37,Default,,0,0,0,,Олар жеңіліп, осында әкелінді?
Dialogue: 0,0:17:23.58,0:17:29.46,Default,,0,0,0,,(электрокардиограмма дыбысы)
Dialogue: 0,0:17:29.75,0:17:30.88,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:17:31.05,0:17:33.46,Default,,0,0,0,,(Студент дауыстары)
Dialogue: 0,0:17:42.81,0:17:44.14,Default,,0,0,0,,
Dialogue: 0,0:17:44.27,0:17:45.60,Default,,0,0,0,,Ұйқың келіп тұр ма, Баки?
Dialogue: 0,0:17:45.73,0:17:47.23,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:17:48.40,0:17:50.65,Default,,0,0,0,,Тек аты ғана жазылады
Dialogue: 0,0:17:50.77,0:17:52.73,Default,,0,0,0,,Бұл көп еркіндік емес пе?
Dialogue: 0,0:17:54.03,0:17:59.28,Default,,0,0,0,,Мен Накамура мырзадан оның дене дайындығы бойынша тесттен тамаша балл алғанын естідім бе?
Dialogue: 0,0:18:00.12,0:18:03.74,Default,,0,0,0,,Мектепті тастап, Олимпиадаға қатысу керек пе?
Dialogue: 0,0:18:03.87,0:18:05.50,Default,,0,0,0,,Қарамаңдар!
Dialogue: 0,0:18:06.41,0:18:07.25,Default,,0,0,0,,Сәлем Баки
Dialogue: 0,0:18:08.00,0:18:11.75,Default,,0,0,0,,Бұл мектеп ғимаратын қандай күш салды деп ойлайсыңдар?
Dialogue: 0,0:18:13.46,0:18:14.30,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:18:14.88,0:18:15.76,Default,,0,0,0,,Уф
Dialogue: 0,0:18:16.05,0:18:18.88,Default,,0,0,0,,Бұл жерде күш бар! Бұл жерде күш!
Dialogue: 0,0:18:19.76,0:18:21.26,Default,,0,0,0,,Тыңда, Баки.
Dialogue: 0,0:18:21.55,0:18:23.35,Default,,0,0,0,,Бұл дүниедегі барлық нәрсе
Dialogue: 0,0:18:23.47,0:18:27.52,Default,,0,0,0,,Бұлшық еттің күшімен емес, мидың күшімен қозғалады.
Dialogue: 0,0:18:27.94,0:18:30.77,Default,,0,0,0,,Қаншалықты жылдам жүгіре алсаңыз да
Dialogue: 0,0:18:30.90,0:18:33.23,Default,,0,0,0,,Мотоциклдермен бәсекеге түсе алмайды
Dialogue: 0,0:18:33.57,0:18:36.28,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:18:36.99,0:18:39.61,Default,,0,0,0,,Қанша мықты болсаң да,
Dialogue: 0,0:18:39.74,0:18:41.41,Default,,0,0,0,,1 вагонды көтеру мүмкін емес
Dialogue: 0,0:18:41.53,0:18:43.28,Default,,0,0,0,,Ол көтерілмейді.
Dialogue: 0,0:18:43.70,0:18:45.41,Default,,0,0,0,,Қанша жүзе алсаң да
Dialogue: 0,0:18:45.54,0:18:49.25,Default,,0,0,0,,Күшті қайықтың 1/10 жылдамдығына да жете алмайды.
Dialogue: 0,0:18:49.37,0:18:51.04,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,0:18:51.46,0:18:53.09,Default,,0,0,0,,Қанша секірсең де
Dialogue: 0,0:18:53.21,0:18:55.75,Default,,0,0,0,,Дельтапланға еліктей алмайсыз.
Dialogue: 0,0:18:55.92,0:18:57.30,Default,,0,0,0,,Ұшпа
Dialogue: 0,0:18:57.51,0:18:59.17,Default,,0,0,0,,Жоқ, Баки?
Dialogue: 0,0:18:59.88,0:19:03.18,Default,,0,0,0,,Бірақ мен аңды жеңетін адам болсам
Dialogue: 0,0:19:03.30,0:19:04.81,Default,,0,0,0,,Мен кейбір адамдарды білемін.
Dialogue: 0,0:19:05.39,0:19:08.43,Default,,0,0,0,,Бұл зат қайда?
Dialogue: 0,0:19:09.52,0:19:12.52,Default,,0,0,0,,Мұғалімнің маңайында ондай адамдар жоқ.
Dialogue: 0,0:19:12.90,0:19:15.32,Default,,0,0,0,,Бұл сіздің әкеңіз бе?
Dialogue: 0,0:19:15.82,0:19:18.82,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:19:20.78,0:19:21.82,Default,,0,0,0,,Мысалы
Dialogue: 0,0:19:22.70,0:19:23.95,Default,,0,0,0,,Уилбур Болт
Dialogue: 0,0:19:24.07,0:19:27.45,Default,,0,0,0,,Осы жердің шетінен шамам келгенше жүгірсем де
Dialogue: 0,0:19:27.58,0:19:31.33,Default,,0,0,0,,Сіз екінші қабаттағы бұл сыныпқа секіре алмайсыз.
Dialogue: 0,0:19:32.12,0:19:34.42,Default,,0,0,0,,Тіпті Болт баспалдақпен жүруі керек...
Dialogue: 0,0:19:34.54,0:19:36.67,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,0:19:37.42,0:19:39.34,Default,,0,0,0,,Өте қулық.
Dialogue: 0,0:19:40.47,0:19:45.22,Default,,0,0,0,,Ал адам даналығы одан да жоғары.
Dialogue: 0,0:19:47.47,0:19:48.72,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:19:52.06,0:19:53.65,Default,,0,0,0,,
Dialogue: 0,0:19:58.69,0:20:00.40,Default,,0,0,0,,Бізге ілесіп жүруді қойып, тезірек кетші!
Dialogue: 0,0:20:05.07,0:20:09.49,Default,,0,0,0,,Мен сізге мұғалімнің ескертуін жерден көрдім.
Dialogue: 0,0:20:10.00,0:20:13.71,Default,,0,0,0,,Уақытым аз болғандықтан, мен жай ғана сыныпқа кірдім.
Dialogue: 0,0:20:13.83,0:20:14.67,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:20:15.08,0:20:15.92,Default,,0,0,0,,Уау~
Dialogue: 0,0:20:16.34,0:20:17.79,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:20:18.96,0:20:21.26,Default,,0,0,0,,Мен мұның дөрекі екенін білемін.
Dialogue: 0,0:20:27.55,0:20:29.18,Default,,0,0,0,,Дойл мырза
Dialogue: 0,0:20:29.35,0:20:30.18,Default,,0,0,0,,​​О?
Dialogue: 0,0:20:32.89,0:20:33.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:34.02,0:20:37.94,Default,,0,0,0,,Мүмкіндік бар!
Dialogue: 0,0:20:40.11,0:20:46.11,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:03.15,0:22:09.16,Default,,0,0,0,,~♪
Dialogue: 0,0:22:10.66,0:22:16.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory