Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,‎NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.51,0:00:17.51,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:34.51,0:01:40.51,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:41.89,0:01:42.93,Default,,0,0,0,,‎Хмм.
Dialogue: 0,0:01:43.06,0:01:44.18,Default,,0,0,0,,‎Су~
Dialogue: 0,0:01:45.85,0:01:46.68,Default,,0,0,0,,Хмф!
Dialogue: 0,0:01:46.98,0:01:47.81,Default,,0,0,0,,‎(Сикорский) Гуах!
Dialogue: 0,0:01:50.27,0:01:51.48,Default,,0,0,0,,‎(Өтіп бара жатқандардың айқайы)
Dialogue: 0,0:01:51.61,0:01:52.57,Default,,0,0,0,,‎(Әйел) Кя~
Dialogue: 0,0:01:54.15,0:01:57.57,Default,,0,0,0,,Сіз бұл жолы көтеріле алмайсыз.
Dialogue: 0,0:01:57.70,0:02:01.32,Default,,0,0,0,,‎(Полиция көлігінің сиренасы)
Dialogue: 0,0:02:02.49,0:02:03.33,Default,,0,0,0,,Сора…
Dialogue: 0,0:02:04.95,0:02:06.58,Default,,0,0,0,,Сикорский.
Dialogue: 0,0:02:08.46,0:02:10.58,Default,,0,0,0,,‎(Ер) Не? Не? (Еркек) Менің қолым семіз!
Dialogue: 0,0:02:10.71,0:02:14.34,Default,,0,0,0,,‎Ұялмаңыз, үйге апарыңыз.
Dialogue: 0,0:02:14.63,0:02:15.51,Default,,0,0,0,,‎(Сонода) Хмм.
Dialogue: 0,0:02:15.63,0:02:18.34,Default,,0,0,0,,‎Жұмыс... ерте.
Dialogue: 0,0:02:18.76,0:02:19.59,Default,,0,0,0,,Ух
Dialogue: 0,0:02:20.76,0:02:22.97,Default,,0,0,0,,‎Екі адам қалды (Сонода) Ах...
Dialogue: 0,0:02:25.68,0:02:31.06,Default,,0,0,0,,(Сонода) Сізге қарамастан, біз бар күшімізді саламыз.
Dialogue: 0,0:02:32.02,0:02:35.02,Default,,0,0,0,,‎Жоқ, киінуге болады.
Dialogue: 0,0:02:35.15,0:02:40.20,Default,,0,0,0,,‎Сіз сыра ішіп, менің қоңырауымды күте аласыз.
Dialogue: 0,0:02:40.86,0:02:41.70,Default,,0,0,0,,‎(Сонода) Хун…
Dialogue: 0,0:02:42.28,0:02:44.20,Default,,0,0,0,,Сіз бұлай деп те айта алмайсыз.
Dialogue: 0,0:02:44.91,0:02:47.95,Default,,0,0,0,,О, мен де саған рахмет айтуым керек.
Dialogue: 0,0:02:48.45,0:02:51.46,Default,,0,0,0,,‎Бұл менің жұмысымды жеңілдетті.
Dialogue: 0,0:02:58.38,0:02:59.47,Default,,0,0,0,,Күшті
Dialogue: 0,0:03:00.13,0:03:03.85,Default,,0,0,0,,Бұл жекпе-жек қимылы емес.
Dialogue: 0,0:03:05.14,0:03:07.72,Default,,0,0,0,,‎Мұндай денеге ие болу үшін не жеу керек?
Dialogue: 0,0:03:08.35,0:03:09.18,Default,,0,0,0,,‎Хехе
Dialogue: 0,0:03:09.77,0:03:10.60,Default,,0,0,0,,‎Фу
Dialogue: 0,0:03:11.02,0:03:11.85,Default,,0,0,0,,Уф
Dialogue: 0,0:03:14.36,0:03:15.94,Default,,0,0,0,,Бұл ақымақ сұрақ.
Dialogue: 0,0:03:16.07,0:03:16.90,Default,,0,0,0,,А?
Dialogue: 0,0:03:18.48,0:03:23.32,Default,,0,0,0,,‎ Адамдарды күшті ететін махаббаттан басқа нәрсе бар ма?
Dialogue: 0,0:03:36.04,0:03:42.84,Default,,0,0,0,,‎(Пернетақтаның соғу дыбысы)
Dialogue: 0,0:03:46.26,0:03:47.10,Default,,0,0,0,,‎(нұқыңыз)
Dialogue: 0,0:03:54.69,0:03:55.52,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:55.69,0:03:56.52,Default,,0,0,0,,А...
Dialogue: 0,0:04:03.70,0:04:06.07,Default,,0,0,0,,‎Фу~
Dialogue: 0,0:04:06.70,0:04:07.83,Default,,0,0,0,,‎
Dialogue: 0,0:04:08.12,0:04:09.24,Default,,0,0,0,,Кіріңіз
Dialogue: 0,0:04:10.66,0:04:11.79,Default,,0,0,0,,‎(полиция қызметкері) Кешіріңіз.
Dialogue: 0,0:04:18.50,0:04:20.42,Default,,0,0,0,,Мен саған кофе әкелдім.
Dialogue: 0,0:04:27.64,0:04:28.47,Default,,0,0,0,,‎Хмм
Dialogue: 0,0:04:31.06,0:04:34.23,Default,,0,0,0,,‎Хмм! көк тау
Dialogue: 0,0:04:34.52,0:04:35.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:36.77,0:04:40.82,Default,,0,0,0,,‎(Полиция әйелі) Уау~ Қорқынышты бет, қорқынышты адам
Dialogue: 0,0:04:41.11,0:04:43.53,Default,,0,0,0,,‎(Полиция әйел) Менің ойымша, ол Токионың бір жерінде жасырынып жүр.
Dialogue: 0,0:04:44.49,0:04:48.20,Default,,0,0,0,,‎Аа... Бұл таңқаларлық жақын болуы мүмкін.
Dialogue: 0,0:04:49.08,0:04:50.20,Default,,0,0,0,,Менің артымда болыңыз
Dialogue: 0,0:04:50.33,0:04:51.16,Default,,0,0,0,,На!
Dialogue: 0,0:04:51.29,0:04:52.12,Default,,0,0,0,,А...
Dialogue: 0,0:04:52.83,0:04:55.79,Default,,0,0,0,,‎Сәлеметсіз бе, шынжырсыз мырза
Dialogue: 0,0:04:55.92,0:04:56.75,Default,,0,0,0,,‎Хмм!
Dialogue: 0,0:05:01.96,0:05:03.09,Default,,0,0,0,,Гах!
Dialogue: 0,0:05:04.30,0:05:05.13,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:06.18,0:05:07.01,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:05:09.18,0:05:11.31,Default,,0,0,0,,‎Олива мырзадан сұраңыз
Dialogue: 0,0:05:12.27,0:05:16.06,Default,,0,0,0,,Гектор Дойл қазір елордалық полиция департаментінде.
Dialogue: 0,0:05:16.56,0:05:19.19,Default,,0,0,0,,Сіз қамауға алындыңыз ба?
Dialogue: 0,0:05:19.73,0:05:21.48,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:05:24.03,0:05:25.36,Default,,0,0,0,,‎Олива печеньесі
Dialogue: 0,0:05:26.53,0:05:28.16,Default,,0,0,0,,мырза. Шынжырсыз
Dialogue: 0,0:05:28.66,0:05:32.91,Default,,0,0,0,,‎Сен жалғыз адам емессің, байлауға болмайды.
Dialogue: 0,0:05:38.71,0:05:40.00,Default,,0,0,0,,‎Хмм.
Dialogue: 0,0:05:44.34,0:05:45.72,Default,,0,0,0,,‎Хаа~
Dialogue: 0,0:05:50.43,0:05:52.01,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:05:53.68,0:05:58.23,Default,,0,0,0,,Сіз өте жақсы көріндіңіз.
Dialogue: 0,0:06:02.36,0:06:03.19,Default,,0,0,0,,Енді...
Dialogue: 0,0:06:04.03,0:06:06.24,Default,,0,0,0,,‎Ешқандай кедергі жоқ!
Dialogue: 0,0:06:06.99,0:06:07.82,Default,,0,0,0,,‎Фу
Dialogue: 0,0:06:09.11,0:06:12.70,Default,,0,0,0,,‎Жоқ, мен бақыттымын.
Dialogue: 0,0:06:13.70,0:06:20.08,Default,,0,0,0,,Штаттарда менің алдымда тұруға батылы бар күшті адамдар жоқ.
Dialogue: 0,0:06:20.50,0:06:23.71,Default,,0,0,0,,Баяғыда кеткен
Dialogue: 0,0:06:24.88,0:06:26.88,Default,,0,0,0,,Қан тоқтады ма?
Dialogue: 0,0:06:27.38,0:06:31.18,Default,,0,0,0,,‎Хаха, адреналин бөлініп жатыр.
Dialogue: 0,0:06:31.68,0:06:33.47,Default,,0,0,0,,Жауынгерлік рухқа толы
Dialogue: 0,0:06:39.56,0:06:40.98,Default,,0,0,0,,‎Бастайық
Dialogue: 0,0:06:45.23,0:06:46.48,Default,,0,0,0,,Иә... иә?
Dialogue: 0,0:06:49.28,0:06:50.28,Default,,0,0,0,,О...
Dialogue: 0,0:06:50.74,0:06:51.61,Default,,0,0,0,,А...
Dialogue: 0,0:06:52.78,0:06:58.45,Default,,0,0,0,,‎Мүмкін, бұлшық еттің күлкілі мөлшеріне байланысты, оның күшіне енуі әдеттегіден бірнеше есе ұзағырақ болуы мүмкін.
Dialogue: 0,0:06:58.62,0:06:59.87,Default,,0,0,0,,‎Хаа~
Dialogue: 0,0:07:01.46,0:07:04.92,Default,,0,0,0,,‎Ұйықтататын дәрі шынтақтың ұшына қойылады.
Dialogue: 0,0:07:06.13,0:07:09.13,Default,,0,0,0,,‎Біз өлім жазасына кесілген тұтқындарды өлім жазасына кесу күні жазамыз
Dialogue: 0,0:07:09.76,0:07:14.76,Default,,0,0,0,,‎Бұл сіз өлім қорқынышын жеңілдету үшін жасырын түрде қабылдайтын нәрсе.
Dialogue: 0,0:07:16.60,0:07:18.14,Default,,0,0,0,,‎Кимен эффектісі
Dialogue: 0,0:07:18.64,0:07:20.14,Default,,0,0,0,,‎Аа... уф
Dialogue: 0,0:07:20.81,0:07:22.15,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:07:32.82,0:07:34.16,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:07:35.91,0:07:37.03,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:07:38.20,0:07:40.41,Default,,0,0,0,,Мен ояндым
Dialogue: 0,0:07:46.04,0:07:46.88,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:47.50,0:07:48.55,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:50.01,0:07:50.88,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:07:56.01,0:07:56.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:57.64,0:07:58.93,Default,,0,0,0,,‎Гах~
Dialogue: 0,0:08:00.10,0:08:00.93,Default,,0,0,0,,‎(құлап түскен дыбыс)
Dialogue: 0,0:08:01.10,0:08:02.35,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:08:08.27,0:08:09.11,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:11.03,0:08:11.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:13.36,0:08:14.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:14.32,0:08:15.20,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:08:15.36,0:08:16.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:18.95,0:08:20.70,Default,,0,0,0,,‎Бір қолмен айналдыру
Dialogue: 0,0:08:20.83,0:08:23.41,Default,,0,0,0,,Менің салмағым 80 кг-нан жоғары!
Dialogue: 0,0:08:24.62,0:08:25.46,Default,,0,0,0,,‎Nuo~
Dialogue: 0,0:08:28.29,0:08:29.25,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:08:29.46,0:08:30.30,Default,,0,0,0,,Гах!
Dialogue: 0,0:08:30.55,0:08:31.46,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:08:32.88,0:08:34.38,Default,,0,0,0,,‎ (жердің гуілдеген дыбысы)
Dialogue: 0,0:08:34.51,0:08:36.43,Default,,0,0,0,,‎(Офицер А) Не? (Офицер Б) Жер сілкінісі болды ма?
Dialogue: 0,0:08:36.55,0:08:37.51,Default,,0,0,0,,‎(Офицер С) Иә?
Dialogue: 0,0:08:37.85,0:08:39.72,Default,,0,0,0,,‎Ах... а...
Dialogue: 0,0:08:40.31,0:08:42.18,Default,,0,0,0,,‎(Офицер А) Бұл керемет дыбыс болды.
Dialogue: 0,0:08:42.43,0:08:44.27,Default,,0,0,0,,‎(Офицер В) Менің ойымша, бұл осыдан басталады.
Dialogue: 0,0:08:48.31,0:08:50.19,Default,,0,0,0,,‎(Офицер А) Кешіріңіз, мырза.
Dialogue: 0,0:08:50.73,0:08:52.11,Default,,0,0,0,,‎(Офицер В) Не болды?
Dialogue: 0,0:08:52.57,0:08:57.74,Default,,0,0,0,,‎ Аа, кешіріңіз, мен кездейсоқ орындықты құлатып алдым.
Dialogue: 0,0:08:59.24,0:09:00.12,Default,,0,0,0,,Кафедра?
Dialogue: 0,0:09:00.24,0:09:01.66,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:09:02.12,0:09:03.75,Default,,0,0,0,,‎(Офицер С) Оны ашамыз ба?
Dialogue: 0,0:09:04.16,0:09:08.71,Default,,0,0,0,,‎ Жоқ, жоқ, өтінемін, ашпаңыз, хаха, бұл маңызды.
Dialogue: 0,0:09:09.21,0:09:11.34,Default,,0,0,0,,‎(Офицер С) А... а.
Dialogue: 0,0:09:11.50,0:09:12.76,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:09:14.88,0:09:16.51,Default,,0,0,0,,‎Un! о қымбаттым…
Dialogue: 0,0:09:17.22,0:09:19.76,Default,,0,0,0,,Келесі жолы бірдеңе болған жағдайда
Dialogue: 0,0:09:20.26,0:09:21.39,Default,,0,0,0,,‎(Офицер В) Жақсысың ба?
Dialogue: 0,0:09:24.31,0:09:27.14,Default,,0,0,0,,‎Уһ, сен кеттің.
Dialogue: 0,0:09:30.48,0:09:35.65,Default,,0,0,0,,Мазасыздық жойылғаннан кейін, Дойл мырзаға сұрақ қойыңыз.
Dialogue: 0,0:09:36.36,0:09:40.91,Default,,0,0,0,,‎Полиция кетіп қалды. Бұл жағдайда сіз үшін...
Dialogue: 0,0:09:41.37,0:09:46.66,Default,,0,0,0,,Ол құтқарылды ма? Ол құтқарылмады ма?
Dialogue: 0,0:09:46.91,0:09:47.75,Default,,0,0,0,,‎Аа… ха ха ха…
Dialogue: 0,0:09:48.83,0:09:49.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:50.21,0:09:51.04,Default,,0,0,0,,Ух...
Dialogue: 0,0:09:53.34,0:09:54.84,Default,,0,0,0,,Ух...
Dialogue: 0,0:09:55.63,0:09:57.05,Default,,0,0,0,,А...
Dialogue: 0,0:09:58.93,0:09:59.93,Default,,0,0,0,,Шамасы
Dialogue: 0,0:10:01.89,0:10:03.31,Default,,0,0,0,,Соңғысы сияқты...
Dialogue: 0,0:10:03.47,0:10:04.31,Default,,0,0,0,,Гах!
Dialogue: 0,0:10:05.73,0:10:06.56,Default,,0,0,0,,‎Жағада…
Dialogue: 0,0:10:07.06,0:10:08.06,Default,,0,0,0,,Ұстара!
Dialogue: 0,0:10:08.69,0:10:09.52,Default,,0,0,0,,Ей!
Dialogue: 0,0:10:09.65,0:10:10.48,Default,,0,0,0,,‎Фугат
Dialogue: 0,0:10:10.61,0:10:11.44,Default,,0,0,0,,Ей!
Dialogue: 0,0:10:12.36,0:10:13.77,Default,,0,0,0,,Гах!
Dialogue: 0,0:10:14.61,0:10:15.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:18.24,0:10:19.07,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:20.20,0:10:23.91,Default,,0,0,0,,‎D… I… Le
Dialogue: 0,0:10:26.00,0:10:26.83,Default,,0,0,0,,Хаха
Dialogue: 0,0:10:32.29,0:10:33.13,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:10:34.09,0:10:35.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:37.80,0:10:38.63,Default,,0,0,0,,‎Ei…
Dialogue: 0,0:10:40.76,0:10:41.59,Default,,0,0,0,,‎Un…
Dialogue: 0,0:10:42.09,0:10:43.47,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:10:43.80,0:10:44.64,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:10:46.56,0:10:47.39,Default,,0,0,0,,Тезек
Dialogue: 0,0:10:48.52,0:10:49.35,Default,,0,0,0,,‎Ku…
Dialogue: 0,0:10:51.85,0:10:54.48,Default,,0,0,0,,‎(Сонода) Сенсей, жаттығу кезінде кешіріңіз.
Dialogue: 0,0:10:54.61,0:10:56.90,Default,,0,0,0,,‎(Шибукава) Маған бәрібір маған бәрібір
Dialogue: 0,0:10:57.86,0:10:59.90,Default,,0,0,0,,‎(Сонода) Толық қамқорлық.
Dialogue: 0,0:11:02.03,0:11:03.12,Default,,0,0,0,,‎(Сонода) Хмм.
Dialogue: 0,0:11:05.37,0:11:06.58,Default,,0,0,0,,‎(Шибукава) Хоу
Dialogue: 0,0:11:15.09,0:11:16.30,Default,,0,0,0,,‎Оливер…
Dialogue: 0,0:11:17.51,0:11:18.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:18.46,0:11:20.80,Default,,0,0,0,,Иә! Сонода
Dialogue: 0,0:11:21.55,0:11:24.43,Default,,0,0,0,,‎Әй... Әй, анау бет
Dialogue: 0,0:11:27.31,0:11:28.14,Default,,0,0,0,,А...
Dialogue: 0,0:11:34.06,0:11:34.94,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:11:42.07,0:11:46.95,Default,,0,0,0,,Мен сізге қанағаттанарлық түсініктеме беремін. Шынжырды босатыңыз!
Dialogue: 0,0:11:47.49,0:11:50.70,Default,,0,0,0,,‎Хмм, мені тыңда, Сонода.
Dialogue: 0,0:11:50.83,0:11:55.71,Default,,0,0,0,,‎Сіздің полицей қызыңыздың білімі қандай болды?
Dialogue: 0,0:11:56.42,0:11:58.21,Default,,0,0,0,,Әйел... Полиция?
Dialogue: 0,0:11:58.63,0:12:00.38,Default,,0,0,0,,‎Бұл «аздап»
Dialogue: 0,0:12:00.51,0:12:04.22,Default,,0,0,0,,‎Егер мен сәл ғана ілгерілейтін болсам...
Dialogue: 0,0:12:04.59,0:12:08.72,Default,,0,0,0,,‎Мен сені ұрамын, мен сені тепемін, мен сені кесемін, мен сені пышақтаймын.
Dialogue: 0,0:12:09.22,0:12:11.98,Default,,0,0,0,,‎"Мен сені пышақтаймын"... сен
Dialogue: 0,0:12:12.18,0:12:14.48,Default,,0,0,0,,‎Хмм, қараңыз.
Dialogue: 0,0:12:16.98,0:12:20.23,Default,,0,0,0,,Жарай ма?
Dialogue: 0,0:12:20.78,0:12:24.70,Default,,0,0,0,,‎Жоқ, менің бұлшық еттерім әлемдегі ең қалың.
Dialogue: 0,0:12:24.82,0:12:30.24,Default,,0,0,0,,‎Осындай кішкентай пышақпен сіз өте, өте ішкі мүшелерге жете алмайсыз...
Dialogue: 0,0:12:30.70,0:12:31.75,Default,,0,0,0,,‎Фу~
Dialogue: 0,0:12:32.66,0:12:34.42,Default,,0,0,0,,‎Хахахаха~
Dialogue: 0,0:12:35.29,0:12:38.17,Default,,0,0,0,,Және полиция қызметкері
Dialogue: 0,0:12:38.29,0:12:43.09,Default,,0,0,0,,Менің ойымша, сіз бұл жерде «тексеру тесігінен қашу» дегенді білдіресіз.
Dialogue: 0,0:12:43.67,0:12:47.18,Default,,0,0,0,,‎Уау, түсіндің, Сонода.
Dialogue: 0,0:12:47.43,0:12:48.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:48.47,0:12:50.14,Default,,0,0,0,,мырза. Шибукава?
Dialogue: 0,0:12:50.26,0:12:51.10,Default,,0,0,0,,На
Dialogue: 0,0:12:52.39,0:12:55.27,Default,,0,0,0,,Сіз білесіз бе? Шибукава мырза
Dialogue: 0,0:12:56.06,0:12:58.19,Default,,0,0,0,,Гоки Шибукава
Dialogue: 0,0:12:58.31,0:13:04.49,Default,,0,0,0,,«Айки» жұмбақ күшіне негізделген Шибукава-рю джиу-джитсу шебері
Dialogue: 0,0:13:04.95,0:13:11.79,Default,,0,0,0,,Қазіргі уақытта елордалық полиция департаментінің ресми тақырыптарына және қамауға алу әдістеріне қатысты нұсқауларға жауапты.
Dialogue: 0,0:13:12.08,0:13:12.91,Default,,0,0,0,,Ух...
Dialogue: 0,0:13:13.04,0:13:15.04,Default,,0,0,0,,Сіз оны қайдан іздедіңіз?
Dialogue: 0,0:13:15.71,0:13:16.54,Default,,0,0,0,,‎Фу
Dialogue: 0,0:13:17.37,0:13:20.04,Default,,0,0,0,,Айтпақшы... Шибукава мұғалім
Dialogue: 0,0:13:20.42,0:13:21.55,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:13:22.84,0:13:27.84,Default,,0,0,0,,Шибукава стиліне физикалық күшпен қарсы тұру мүмкін емес сияқты.
Dialogue: 0,0:13:28.39,0:13:31.47,Default,,0,0,0,,Менің күшім жетеді ме?
Dialogue: 0,0:13:32.22,0:13:33.47,Default,,0,0,0,,‎Олива!
Dialogue: 0,0:13:34.52,0:13:35.68,Default,,0,0,0,,‎Иә~
Dialogue: 0,0:13:35.81,0:13:36.64,Default,,0,0,0,,Ех!
Dialogue: 0,0:13:37.73,0:13:41.57,Default,,0,0,0,,‎Байқап көр, семіз жігіт.
Dialogue: 0,0:13:42.27,0:13:43.19,Default,,0,0,0,,Ух
Dialogue: 0,0:13:44.49,0:13:50.24,Default,,0,0,0,,‎Жоқ...м...Сенің шеберлігіңе күмәнім жоқ.
Dialogue: 0,0:13:50.37,0:13:54.29,Default,,0,0,0,,Оның бір қарағанда семіз болып көрінетін денесі шын мәнінде бұлшық ет...
Dialogue: 0,0:13:54.41,0:13:56.66,Default,,0,0,0,,(Шибукава) Дәл солай (Сонода) Ия...
Dialogue: 0,0:13:57.29,0:14:01.34,Default,,0,0,0,,‎Қызыл ет пен ақ ет бір нәрсе.
Dialogue: 0,0:14:01.79,0:14:02.63,Default,,0,0,0,,‎Муфф
Dialogue: 0,0:14:03.75,0:14:05.34,Default,,0,0,0,,‎wahahahaha
Dialogue: 0,0:14:05.80,0:14:07.59,Default,,0,0,0,,‎Хахахаха
Dialogue: 0,0:14:08.47,0:14:10.39,Default,,0,0,0,,Бұл менің жоғалтуым.
Dialogue: 0,0:14:11.64,0:14:13.10,Default,,0,0,0,,‎(Сонода) Haa~ Күтілгендей.
Dialogue: 0,0:14:13.35,0:14:15.60,Default,,0,0,0,,‎Гоки~ Шибукава~
Dialogue: 0,0:14:18.60,0:14:19.44,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:14:20.02,0:14:20.85,Default,,0,0,0,,‎Хмм!
Dialogue: 0,0:14:24.07,0:14:24.90,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:14:25.03,0:14:25.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:27.32,0:14:28.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:28.53,0:14:29.36,Default,,0,0,0,,А...
Dialogue: 0,0:14:29.53,0:14:30.36,Default,,0,0,0,,Гах!
Dialogue: 0,0:14:32.53,0:14:33.37,Default,,0,0,0,,‎Гуа…
Dialogue: 0,0:14:33.53,0:14:35.16,Default,,0,0,0,,‎А... аа...
Dialogue: 0,0:14:36.04,0:14:36.87,Default,,0,0,0,,А...
Dialogue: 0,0:14:37.54,0:14:38.62,Default,,0,0,0,,‎(Сонода) О...
Dialogue: 0,0:14:39.54,0:14:41.88,Default,,0,0,0,,‎Аа~ Сонода мырза?
Dialogue: 0,0:14:42.46,0:14:47.26,Default,,0,0,0,,Әзірше оны алып кетейік, солай ма? бұл адам
Dialogue: 0,0:14:48.30,0:14:50.72,Default,,0,0,0,,‎Хахаха… Күткендей
Dialogue: 0,0:14:51.14,0:14:54.64,Default,,0,0,0,,‎Бұл… бұл… «Айки»
Dialogue: 0,0:14:55.14,0:14:57.27,Default,,0,0,0,,‎(Шибукава) Бұл! Угья~!
Dialogue: 0,0:14:57.43,0:15:01.77,Default,,0,0,0,,‎(Ағып жатқан судың дыбысы)
Dialogue: 0,0:15:04.82,0:15:06.11,Default,,0,0,0,,‎Ха~
Dialogue: 0,0:15:06.94,0:15:12.78,Default,,0,0,0,,‎(Ағып жатқан судың дыбысы)
Dialogue: 0,0:15:16.83,0:15:18.37,Default,,0,0,0,,‎ Шынжырдан босату…
Dialogue: 0,0:15:25.79,0:15:28.51,Default,,0,0,0,,‎Ол талантты кім...
Dialogue: 0,0:15:35.85,0:15:41.85,Default,,0,0,0,,‎(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:15:41.98,0:15:42.98,Default,,0,0,0,,‎(мүйіз)
Dialogue: 0,0:15:44.77,0:15:47.19,Default,,0,0,0,,‎(Жақындаған көліктің дыбысы)
Dialogue: 0,0:16:01.37,0:16:05.67,Default,,0,0,0,,(Бастық) Алғашында бәрі, тіпті мен де солай болды.
Dialogue: 0,0:16:05.96,0:16:07.25,Default,,0,0,0,,‎(Бағыныңқы) Ах (Бастық) Жас кезімде
Dialogue: 0,0:16:07.38,0:16:09.84,Default,,0,0,0,,‎Көп рет сәтсіздікке ұшыраған дұрыс.
Dialogue: 0,0:16:09.96,0:16:10.80,Default,,0,0,0,,‎(бағыныңқы) Ах, а...
Dialogue: 0,0:16:10.92,0:16:11.76,Default,,0,0,0,,‎(Бастық) Иә?
Dialogue: 0,0:16:11.97,0:16:14.43,Default,,0,0,0,,‎Эй, тыңдап тұрсың ба? Эй!
Dialogue: 0,0:16:14.84,0:16:15.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:16.43,0:16:17.39,Default,,0,0,0,,Ех!
Dialogue: 0,0:16:17.51,0:16:19.72,Default,,0,0,0,,‎(Көлік ішіндегі шулы дауыс)
Dialogue: 0,0:16:32.78,0:16:34.24,Default,,0,0,0,,О!
Dialogue: 0,0:16:34.53,0:16:35.74,Default,,0,0,0,,‎Жоқ~!
Dialogue: 0,0:16:36.03,0:16:37.99,Default,,0,0,0,,‎Түсінікті~
Dialogue: 0,0:16:38.28,0:16:42.00,Default,,0,0,0,,‎Жүріңіз ~ Мен тыныш боламын
Dialogue: 0,0:16:42.41,0:16:45.00,Default,,0,0,0,,‎Маған көбірек мейірімді болыңыз.
Dialogue: 0,0:16:45.29,0:16:47.00,Default,,0,0,0,,‎Хахахаха
Dialogue: 0,0:16:47.92,0:16:49.13,Default,,0,0,0,,‎Хаа~
Dialogue: 0,0:16:50.30,0:16:51.51,Default,,0,0,0,,‎(Ойыншы) Уф! (Ойыншы) Сей!
Dialogue: 0,0:16:52.38,0:16:53.72,Default,,0,0,0,,‎(Ойыншы) Жүр! (Ойыншы) Ха!
Dialogue: 0,0:16:56.39,0:16:59.01,Default,,0,0,0,,О! Дзюдо
Dialogue: 0,0:16:59.76,0:17:01.89,Default,,0,0,0,,Сен де солай істейсің бе? мырза
Dialogue: 0,0:17:02.02,0:17:04.27,Default,,0,0,0,,‎Жоқ, мен мұны ешқашан жасаған емеспін.
Dialogue: 0,0:17:05.10,0:17:10.65,Default,,0,0,0,,‎Бірақ мен алатын болсам, мен бүгін алтын медаль ұтып алар едім.
Dialogue: 0,0:17:10.90,0:17:11.73,Default,,0,0,0,,Хмм!
Dialogue: 0,0:17:13.28,0:17:14.65,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:15.36,0:17:18.78,Default,,0,0,0,,Мұнда олимпиадалық деңгейдегі адамдар көп.
Dialogue: 0,0:17:19.58,0:17:21.41,Default,,0,0,0,,Бұл жақсы мүмкіндік.
Dialogue: 0,0:17:21.91,0:17:22.79,Default,,0,0,0,,Хо
Dialogue: 0,0:17:24.08,0:17:28.42,Default,,0,0,0,,(Ойыншылардың ынта дауыстары)
Dialogue: 0,0:17:31.09,0:17:34.17,Default,,0,0,0,,мырза. Олива дзюдомен айналысқысы келеді.
Dialogue: 0,0:17:35.47,0:17:36.30,Default,,0,0,0,,(Ойыншы) Уф (ойыншы) Ах...
Dialogue: 0,0:17:39.09,0:17:42.26,Default,,0,0,0,,‎Хахахаха (Сонода) Біреу маған ги қарызға береді.
Dialogue: 0,0:17:42.77,0:17:47.52,Default,,0,0,0,,‎Сонода-кун, бұл жігіт кінәлі.
Dialogue: 0,0:17:47.73,0:17:51.07,Default,,0,0,0,,Мен жаңа ғана барлық әйел полицейлердің қауіпсіз екенін растадым.
Dialogue: 0,0:17:51.82,0:17:54.44,Default,,0,0,0,,Зақым туралы хабарланбайынша, жақсы.
Dialogue: 0,0:17:54.57,0:17:55.94,Default,,0,0,0,,‎(Шибукава) Хаа~
Dialogue: 0,0:17:56.11,0:17:57.45,Default,,0,0,0,,‎(Сонода) Ең бастысы
Dialogue: 0,0:17:58.07,0:18:02.58,Default,,0,0,0,,‎Оның дзюдо түрімен айналысатыны маған қызық емес.
Dialogue: 0,0:18:04.20,0:18:05.58,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:18:08.54,0:18:13.09,Default,,0,0,0,,‎ Sonoda Бұл... тым кішкентай.
Dialogue: 0,0:18:13.75,0:18:17.09,Default,,0,0,0,,‎
Dialogue: 0,0:18:19.51,0:18:20.89,Default,,0,0,0,,‎Тығыз~
Dialogue: 0,0:18:21.68,0:18:24.60,Default,,0,0,0,,Бұл ең үлкен нәрсе.
Dialogue: 0,0:18:24.77,0:18:25.60,Default,,0,0,0,,нәжіс
Dialogue: 0,0:18:26.48,0:18:27.31,Default,,0,0,0,,нәжіс
Dialogue: 0,0:18:28.73,0:18:32.11,Default,,0,0,0,,О! Бұл жақсы
Dialogue: 0,0:18:33.11,0:18:36.82,Default,,0,0,0,,‎(Спортшы А) Дзюдоның формасы... жыртыла ма?
Dialogue: 0,0:18:37.61,0:18:42.74,Default,,0,0,0,,Әзірше мен шамамен 5-ші данды алып, үйге баруым керек.
Dialogue: 0,0:18:43.12,0:18:44.37,Default,,0,0,0,,‎
Dialogue: 0,0:18:44.49,0:18:45.74,Default,,0,0,0,,‎(А ойыншысы) Иә?
Dialogue: 0,0:18:46.16,0:18:47.04,Default,,0,0,0,,‎(В ойыншысы) Хаха...
Dialogue: 0,0:18:47.16,0:18:48.75,Default,,0,0,0,,‎(А ойыншысы) Бұл жақсы болуы мүмкін.
Dialogue: 0,0:18:48.96,0:18:50.58,Default,,0,0,0,,‎Ғұн ғұн ғұн
Dialogue: 0,0:18:50.71,0:18:51.75,Default,,0,0,0,,‎(Ойыншылардың күлкісі)
Dialogue: 0,0:18:52.67,0:18:55.42,Default,,0,0,0,,‎(В ойыншысы) Сонода Шихан Иә, мен осылай айтып тұрмын...
Dialogue: 0,0:18:55.55,0:18:56.38,Default,,0,0,0,,‎(Сонода) Хмм...
Dialogue: 0,0:18:56.80,0:18:58.01,Default,,0,0,0,,Кохон!
Dialogue: 0,0:18:58.38,0:19:00.26,Default,,0,0,0,,‎Мм...мырза.
Dialogue: 0,0:19:01.05,0:19:06.27,Default,,0,0,0,,‎Өкінішке орай, мен бүгін 5-ден ала алмаймын.
Dialogue: 0,0:19:07.89,0:19:09.10,Default,,0,0,0,,Не?
Dialogue: 0,0:19:09.23,0:19:12.77,Default,,0,0,0,,‎Мен қолымнан келгеннің бәрін жасаймын, бар күшімді саламын
Dialogue: 0,0:19:13.52,0:19:16.94,Default,,0,0,0,,Дзюдодан қара белбеу олай емес.
Dialogue: 0,0:19:17.65,0:19:21.03,Default,,0,0,0,,‎Оны ресми тест арқылы алуға болады.
Dialogue: 0,0:19:22.11,0:19:25.53,Default,,0,0,0,,‎Бұл тек күш туралы емес, бұл шеберлік пен рухқа қатысты.
Dialogue: 0,0:19:26.16,0:19:30.08,Default,,0,0,0,,‎Барлығы бағаланады және оны бірінші рет орауыңызға рұқсат етіледі.
Dialogue: 0,0:19:33.21,0:19:35.54,Default,,0,0,0,,‎«Қаттылықты жұмсақтықпен басқару»
Dialogue: 0,0:19:35.84,0:19:39.51,Default,,0,0,0,,‎Дзюдода бұлшық ет массасын ғана жеңу мүмкін емес.
Dialogue: 0,0:19:39.72,0:19:45.05,Default,,0,0,0,,Дзюдо уақытты, техниканың өткірлігін және қарсыласпен мәмілені талап етеді.
Dialogue: 0,0:19:45.51,0:19:47.35,Default,,0,0,0,,‎Кенеттен 5-ші дан айтыңыз т.б.
Dialogue: 0,0:19:47.47,0:19:48.31,Default,,0,0,0,,‎(Ойыншылардың күлкісі)
Dialogue: 0,0:19:48.89,0:19:52.81,Default,,0,0,0,,‎Жарайды, бірақ... аздап болсаң жақсы болар еді.
Dialogue: 0,0:19:52.94,0:19:55.81,Default,,0,0,0,,‎(Ойыншылардың күлкісі)
Dialogue: 0,0:19:58.98,0:19:59.82,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:20:00.99,0:20:01.82,Default,,0,0,0,,‎Хахан~н
Dialogue: 0,0:20:05.57,0:20:07.83,Default,,0,0,0,,Топтасайық.
Dialogue: 0,0:20:10.66,0:20:11.87,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:20:12.25,0:20:14.83,Default,,0,0,0,,‎(Ойыншылардың күлкісі)
Dialogue: 0,0:20:19.05,0:20:21.59,Default,,0,0,0,,‎Жоқ, жоқ, олай емес.
Dialogue: 0,0:20:22.88,0:20:23.72,Default,,0,0,0,,Ух...
Dialogue: 0,0:20:23.88,0:20:24.72,Default,,0,0,0,,‎Ей!
Dialogue: 0,0:20:26.68,0:20:27.72,Default,,0,0,0,,‎(Ойыншы) О!
Dialogue: 0,0:20:29.56,0:20:31.73,Default,,0,0,0,,‎(Ойыншылар) О?
Dialogue: 0,0:20:36.06,0:20:37.36,Default,,0,0,0,,‎(Ойыншы) Бұл... бұл жігіт.
Dialogue: 0,0:20:37.69,0:20:38.73,Default,,0,0,0,,Ух...
Dialogue: 0,0:20:40.90,0:20:41.74,Default,,0,0,0,,‎Ku…
Dialogue: 0,0:20:43.28,0:20:45.28,Default,,0,0,0,,‎… қуат…
Dialogue: 0,0:20:46.70,0:20:48.49,Default,,0,0,0,,Тек күшпен...
Dialogue: 0,0:20:50.95,0:20:51.91,Default,,0,0,0,,О, жоқ...
Dialogue: 0,0:20:54.67,0:20:57.50,Default,,0,0,0,,‎
Dialogue: 0,0:20:57.67,0:20:58.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:59.42,0:21:00.50,Default,,0,0,0,,‎Куку куку
Dialogue: 0,0:21:00.67,0:21:01.51,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:21:02.21,0:21:03.22,Default,,0,0,0,,О!
Dialogue: 0,0:21:04.68,0:21:06.26,Default,,0,0,0,,‎(Ойыншылар) Ах...
Dialogue: 0,0:21:09.68,0:21:10.51,Default,,0,0,0,,‎Hmph
Dialogue: 0,0:21:11.22,0:21:13.68,Default,,0,0,0,,‎Аа... Бұл техника ма?
Dialogue: 0,0:21:13.89,0:21:17.77,Default,,0,0,0,,‎Хаа һаа…
Dialogue: 0,0:21:18.52,0:21:19.69,Default,,0,0,0,,‎Фу~
Dialogue: 0,0:21:19.82,0:21:20.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.02,0:21:24.28,Default,,0,0,0,,‎
Dialogue: 0,0:21:24.82,0:21:27.11,Default,,0,0,0,,Иә? Соңы?
Dialogue: 0,0:21:32.41,0:21:34.54,Default,,0,0,0,,‎(аяқ дыбысына жақындау)
Dialogue: 0,0:21:40.42,0:21:44.38,Default,,0,0,0,,‎(Сонода) Таварая, елордалық полиция департаментіндегі ең үлкен адам
Dialogue: 0,0:21:45.42,0:21:50.35,Default,,0,0,0,,‎Үлкен және кіші жарыстарда жеңімпаз және екінші орын алған тәжірибе.
Dialogue: 0,0:21:53.93,0:21:55.73,Default,,0,0,0,,‎(Таварая) Мұқият...
Dialogue: 0,0:21:56.02,0:21:57.06,Default,,0,0,0,,Хмф! Ха!
Dialogue: 0,0:21:57.19,0:21:58.02,Default,,0,0,0,,Ех!
Dialogue: 0,0:21:58.44,0:21:59.27,Default,,0,0,0,,‎(Таварая) Уау!
Dialogue: 0,0:22:00.06,0:22:02.32,Default,,0,0,0,,О!
Dialogue: 0,0:22:06.03,0:22:07.32,Default,,0,0,0,,Сонода
Dialogue: 0,0:22:07.49,0:22:09.32,Default,,0,0,0,,‎(Таварая) Уау~ Егер мен бәрін жеңсем
Dialogue: 0,0:22:09.95,0:22:13.33,Default,,0,0,0,,‎Маған қара белбеуді беріңіз~
Dialogue: 0,0:22:13.45,0:22:14.83,Default,,0,0,0,,‎(Шибукава) Ах~аа...
Dialogue: 0,0:22:15.00,0:22:18.62,Default,,0,0,0,,(Таварая айқайлайды) О, жоқ!
