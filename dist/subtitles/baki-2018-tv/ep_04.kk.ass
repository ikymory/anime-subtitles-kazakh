Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:12.01,0:00:18.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,~♪
Dialogue: 0,0:01:47.27,0:01:49.94,Default,,0,0,0,,Практикалық каратэ Шиншинкай негізін қалаушы
Dialogue: 0,0:01:50.52,0:01:52.52,Default,,0,0,0,,Соғыс құдайының лақап аты бар
Dialogue: 0,0:01:52.94,0:01:56.15,Default,,0,0,0,,Қазіргі уақытта Шиншинкайдан тыс жерде жаттығуда
Dialogue: 0,0:01:59.57,0:02:02.49,Default,,0,0,0,,15 жасында ол Ханаяма-гуми бастық атағын алды.
Dialogue: 0,0:02:02.91,0:02:03.91,Default,,0,0,0,,Қарусыз
Dialogue: 0,0:02:04.33,0:02:08.91,Default,,0,0,0,,Жаттығудан бас тартуға сенетін Жапониядағы ең жақсы төбелесші
Dialogue: 0,0:02:15.30,0:02:20.68,Default,,0,0,0,,Осы колизейде, отыз сегіз жекпе-жек шебері.
Dialogue: 0,0:02:20.76,0:02:23.56,Default,,0,0,0,,Турнир өткізілуде
Dialogue: 0,0:02:23.64,0:02:25.72,Default,,0,0,0,,Мүмкін дәл қазір
Dialogue: 0,0:02:25.81,0:02:29.94,Default,,0,0,0,,Жер бетінде өткізуге болатын жекпе-жек турнирі ретінде
Dialogue: 0,0:02:30.02,0:02:32.52,Default,,0,0,0,,Мазмұны Екі деңгей де
Dialogue: 0,0:02:32.61,0:02:35.65,Default,,0,0,0,,Ең үлкен, ең соңғы
Dialogue: 0,0:02:35.73,0:02:41.03,Default,,0,0,0,,Мен оның тарихтағы ең жақсысы болғанын мақтан тұтамын.
Dialogue: 0,0:02:41.36,0:02:44.95,Default,,0,0,0,,Нәтиже Турнирді кім жеңді
Dialogue: 0,0:02:45.29,0:02:49.96,Default,,0,0,0,,Мен осындамын, бар болғаны 17 жаста, Баки Ханма.
Dialogue: 0,0:02:53.96,0:02:54.79,Default,,0,0,0,,Ах
Dialogue: 0,0:02:55.21,0:02:59.09,Default,,0,0,0,,Бірақ бесеуің сол турнирге қатысасыңдар.
Dialogue: 0,0:02:59.17,0:03:02.18,Default,,0,0,0,,Сізде қандай құндылықтар бар?
Dialogue: 0,0:03:02.26,0:03:03.97,Default,,0,0,0,,Қорқынышты, мен өзімді еркін сезінбеймін.
Dialogue: 0,0:03:04.51,0:03:05.97,Default,,0,0,0,,Сикорский мырза
Dialogue: 0,0:03:06.51,0:03:07.93,Default,,0,0,0,,Жаңа айттыңыз
Dialogue: 0,0:03:08.02,0:03:10.94,Default,,0,0,0,,«Сәйкестік – бұл жай ғана сынақ».
Dialogue: 0,0:03:11.02,0:03:14.11,Default,,0,0,0,,«Алдағы қойылымға дайындық»
Dialogue: 0,0:03:14.19,0:03:15.65,Default,,0,0,0,,Мен осылай дедім.
Dialogue: 0,0:03:16.27,0:03:17.82,Default,,0,0,0,,Мұндағы бес адам
Dialogue: 0,0:03:17.90,0:03:21.91,Default,,0,0,0,,Жеңімпаздан бесінші орынға дейінгі ретпен таңдалғандар емес.
Dialogue: 0,0:03:22.11,0:03:24.82,Default,,0,0,0,,Бәсекелестіктен гөрі жаттығу
Dialogue: 0,0:03:24.91,0:03:28.24,Default,,0,0,0,,Сикорский мырза, нақты нәрсе.
Dialogue: 0,0:03:28.58,0:03:34.25,Default,,0,0,0,,Күнделікті өмірде қашан және қашан болатынын болжау мүмкін емес.
Dialogue: 0,0:03:34.33,0:03:39.05,Default,,0,0,0,,Дәл осындай тосын шайқастарда сіз өз күштеріңізді көрсете аласыз.
Dialogue: 0,0:03:39.13,0:03:43.43,Default,,0,0,0,,Мен осындай бес адамды таңдадым деп ойладым.
Dialogue: 0,0:03:44.39,0:03:46.35,Default,,0,0,0,,Хабарлама бойынша
Dialogue: 0,0:03:46.43,0:03:51.43,Default,,0,0,0,,Бәрің де жеңілуден үміттеніп тұрған сияқтысыңдар.
Dialogue: 0,0:03:51.60,0:03:54.52,Default,,0,0,0,,Мұндағы бес адамның кез келгені
Dialogue: 0,0:03:54.60,0:03:59.44,Default,,0,0,0,,Оның сізге қалағаныңызды беруге күші жетеді.
Dialogue: 0,0:03:59.78,0:04:01.40,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:01.57,0:04:02.45,Default,,0,0,0,,Мм... (Токугава) Иә?
Dialogue: 0,0:04:03.07,0:04:04.82,Default,,0,0,0,,Сен нені айтып тұрсың?
Dialogue: 0,0:04:05.03,0:04:08.20,Default,,0,0,0,,Тәжірибе, күнделікті өмір сияқты нәрселер туралы айтады.
Dialogue: 0,0:04:08.45,0:04:10.25,Default,,0,0,0,,Біз қашан ұрысты бастадық?
Dialogue: 0,0:04:10.33,0:04:11.16,Default,,0,0,0,,Жалпы…
Dialogue: 0,0:04:11.25,0:04:13.46,Default,,0,0,0,,Осы жерден бастайсыз ба?
Dialogue: 0,0:04:13.83,0:04:19.34,Default,,0,0,0,,Ойын алаңының орнына қалыпты өмір сүру кеңістігі болғаны дұрыс емес пе?
Dialogue: 0,0:04:19.46,0:04:21.97,Default,,0,0,0,,Қайнаған суы бар ас үй.
Dialogue: 0,0:04:22.30,0:04:23.72,Default,,0,0,0,,Сіз мұны қашан жасайсыз?
Dialogue: 0,0:04:23.88,0:04:26.26,Default,,0,0,0,,Кез келген уақытта, тіпті қазір де.
Dialogue: 0,0:04:26.68,0:04:27.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:28.10,0:04:29.10,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:30.27,0:04:31.64,Default,,0,0,0,,Ережелер…
Dialogue: 0,0:04:31.81,0:04:34.77,Default,,0,0,0,,Бұл маңызды емес, солай ма? Ережелер қандай?
Dialogue: 0,0:04:34.94,0:04:37.27,Default,,0,0,0,,Бұл бес адам кім?
Dialogue: 0,0:04:37.36,0:04:39.61,Default,,0,0,0,,Осы бес адамның біреуін көздеңіз.
Dialogue: 0,0:04:39.98,0:04:42.11,Default,,0,0,0,,Әрине, керісінше де болуы мүмкін.
Dialogue: 0,0:04:42.49,0:04:46.11,Default,,0,0,0,,Орын жоқ, уақыт жоқ, ереже жоқ, боқ жоқ
Dialogue: 0,0:04:46.45,0:04:49.12,Default,,0,0,0,,Тамақтың уақыты келді ме, әлде төсекке жата ма,
Dialogue: 0,0:04:49.45,0:04:52.12,Default,,0,0,0,,Әйелді ұстасам да, шағымым жоқ.
Dialogue: 0,0:04:52.79,0:04:55.12,Default,,0,0,0,,Бүгін осы жерден бастауға болады.
Dialogue: 0,0:04:55.50,0:04:58.25,Default,,0,0,0,,Оны іс жүзінде қолдану деген осы.
Dialogue: 0,0:04:59.17,0:05:01.42,Default,,0,0,0,,Бес мүшенің кез келгені
Dialogue: 0,0:05:01.50,0:05:06.63,Default,,0,0,0,,Егер сіз екінші жақтағы 5 адамның кез келгенін нысанаға алсаңыз.
Dialogue: 0,0:05:07.01,0:05:10.01,Default,,0,0,0,,Кез келген жағдайда... қазірдің өзінде?
Dialogue: 0,0:05:10.43,0:05:12.47,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:05:12.77,0:05:15.81,Default,,0,0,0,,Басталып жатыр!
Dialogue: 0,0:05:17.52,0:05:19.15,Default,,0,0,0,,Орналасу еркіндігі
Dialogue: 0,0:05:19.23,0:05:20.82,Default,,0,0,0,,Бос уақыт
Dialogue: 0,0:05:20.90,0:05:22.57,Default,,0,0,0,,Қарсыластың еркіндігі
Dialogue: 0,0:05:22.82,0:05:24.61,Default,,0,0,0,,Ереже Жоқ
Dialogue: 0,0:05:25.32,0:05:27.16,Default,,0,0,0,,Хуа~
Dialogue: 0,0:05:27.28,0:05:32.12,Default,,0,0,0,,Ата, мен үйге бара жатырмын. Мен ертең ертемін.
Dialogue: 0,0:05:32.33,0:05:33.16,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:05:33.49,0:05:35.00,Default,,0,0,0,,Оның қолына қара!
Dialogue: 0,0:05:35.25,0:05:36.37,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:36.91,0:05:38.58,Default,,0,0,0,,Осы жаққа қара.
Dialogue: 0,0:05:38.67,0:05:43.42,Default,,0,0,0,,Матч басталған соң тарағыңыз келе ме?
Dialogue: 0,0:05:43.59,0:05:44.84,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:05:52.51,0:05:56.43,Default,,0,0,0,,Мен осы бес тамаша адамның ешқайсысымен жыныстық қатынасқа түсуге қарсы емеспін.
Dialogue: 0,0:05:57.10,0:06:00.27,Default,,0,0,0,,Барлығы жеп қойса жақсы болар еді.
Dialogue: 0,0:06:04.15,0:06:06.44,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:06:06.94,0:06:10.45,Default,,0,0,0,,Қайтқаның рас.
Dialogue: 0,0:06:11.24,0:06:13.95,Default,,0,0,0,,Фактілер сол күйінде…
Dialogue: 0,0:06:14.08,0:06:14.95,Default,,0,0,0,,
Dialogue: 0,0:06:15.04,0:06:17.41,Default,,0,0,0,,Менің хабарлаудан басқа амалым жоқ!
Dialogue: 0,0:06:19.25,0:06:21.46,Default,,0,0,0,,Мен оны көзіммен көрдім.
Dialogue: 0,0:06:22.25,0:06:23.96,Default,,0,0,0,,Мен жыртылып қалдым
Dialogue: 0,0:06:24.05,0:06:25.84,Default,,0,0,0,,Өте үлкен!
Dialogue: 0,0:06:26.59,0:06:28.72,Default,,0,0,0,,Сен маған ғашықсың
Dialogue: 0,0:06:29.18,0:06:33.18,Default,,0,0,0,,Кешіріңіз, маған дереу қоңырау шалыңыз.
Dialogue: 0,0:06:34.35,0:06:37.73,Default,,0,0,0,,Шамасы, штабта үлкен төбелес болды.
Dialogue: 0,0:06:37.81,0:06:39.27,Default,,0,0,0,,Неден бастау керек?
Dialogue: 0,0:06:39.35,0:06:41.98,Default,,0,0,0,,Ой, ол қазірдің өзінде басталды.
Dialogue: 0,0:06:47.15,0:06:47.99,Default,,0,0,0,,Рецу?
Dialogue: 0,0:06:48.24,0:06:50.40,Default,,0,0,0,,Хехе, бұл үзінді...
Dialogue: 0,0:06:51.11,0:06:53.57,Default,,0,0,0,,Хахаха мен көрдім!
Dialogue: 0,0:06:53.66,0:06:56.49,Default,,0,0,0,,Сен де бір кесек шайнадың.
Dialogue: 0,0:06:57.33,0:07:00.50,Default,,0,0,0,,Бұл жерден бастауға ешқандай себеп жоқ.
Dialogue: 0,0:07:05.25,0:07:06.50,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:07:07.59,0:07:08.42,Default,,0,0,0,,Фугу!
Dialogue: 0,0:07:12.09,0:07:13.47,Default,,0,0,0,,Иә? (Өтіп бара жатқандар) Ах!
Dialogue: 0,0:07:13.64,0:07:14.80,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:07:17.47,0:07:18.31,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:22.19,0:07:23.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:25.19,0:07:27.28,Default,,0,0,0,,Бұл ұрыс. Апыр-ай!
Dialogue: 0,0:07:27.40,0:07:28.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:30.07,0:07:33.78,Default,,0,0,0,,Кешіріңіз, Рецу, мен мұны бірінші істеуім керек еді.
Dialogue: 0,0:07:34.28,0:07:35.12,Default,,0,0,0,,Хун
Dialogue: 0,0:07:35.91,0:07:36.74,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:07:37.87,0:07:39.79,Default,,0,0,0,,Сот ~
Dialogue: 0,0:07:39.91,0:07:40.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:42.00,0:07:43.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:44.00,0:07:45.84,Default,,0,0,0,,Ах! (Өтіп бара жатқан адамдардың шуы)
Dialogue: 0,0:07:47.25,0:07:48.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:51.17,0:07:53.38,Default,,0,0,0,,Каа~
Dialogue: 0,0:07:56.72,0:08:00.56,Default,,0,0,0,,Ма ваши қабылдауы... тамаша!
Dialogue: 0,0:08:01.52,0:08:02.77,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:08:03.27,0:08:07.27,Default,,0,0,0,,Ол барлық Uke техникасының элементтерін қамтиды.
Dialogue: 0,0:08:08.40,0:08:10.28,Default,,0,0,0,,Бұл Уке техникасының шыңы.
Dialogue: 0,0:08:10.86,0:08:15.28,Default,,0,0,0,,Маған жебе, мылтық немесе от шашыратқыш әкеліңіз.
Dialogue: 0,0:08:17.16,0:08:18.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:22.79,0:08:24.62,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:08:25.63,0:08:26.67,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:08:27.38,0:08:29.92,Default,,0,0,0,,Бұл жақсы соққы болды~
Dialogue: 0,0:08:30.09,0:08:32.30,Default,,0,0,0,,Дәл осы жерде
Dialogue: 0,0:08:32.88,0:08:33.80,Default,,0,0,0,,Жылдам
Dialogue: 0,0:08:34.13,0:08:35.30,Default,,0,0,0,,Жылдам
Dialogue: 0,0:08:35.59,0:08:37.64,Default,,0,0,0,,Қытырлақ па?
Dialogue: 0,0:08:38.22,0:08:40.81,Default,,0,0,0,,Бұл жақсы кеседі.
Dialogue: 0,0:08:41.64,0:08:45.31,Default,,0,0,0,,-мен не істейсіз? Қайтадан жасаймыз ба?
Dialogue: 0,0:08:45.48,0:08:46.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:55.11,0:08:58.24,Default,,0,0,0,,Хехе, бұл сен бе? Мен президенттің бетін кесіп алдым
Dialogue: 0,0:08:58.66,0:08:59.49,Default,,0,0,0,,Ах~
Dialogue: 0,0:08:59.58,0:09:01.24,Default,,0,0,0,,Сіз өлім жазасына кесілген тұтқынсыз ба?
Dialogue: 0,0:09:01.58,0:09:03.75,Default,,0,0,0,,Мен күлемін~
Dialogue: 0,0:09:04.41,0:09:06.17,Default,,0,0,0,,Йотто!
Dialogue: 0,0:09:06.29,0:09:07.33,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:09:07.54,0:09:09.00,Default,,0,0,0,,Сәлем! (Сикорский) Арх!
Dialogue: 0,0:09:09.17,0:09:10.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:10.21,0:09:12.51,Default,,0,0,0,,Ах... Гуха!
Dialogue: 0,0:09:12.67,0:09:14.01,Default,,0,0,0,,Ача~ Моро!
Dialogue: 0,0:09:14.55,0:09:15.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:18.14,0:09:21.51,Default,,0,0,0,,Өмірдің мәні жеңіліс болған сияқты.
Dialogue: 0,0:09:21.64,0:09:24.52,Default,,0,0,0,,Бұл оңай орындалды.
Dialogue: 0,0:09:27.19,0:09:28.56,Default,,0,0,0,,(Кәмпит шарларының домалату дыбысы)
Dialogue: 0,0:09:31.57,0:09:36.03,Default,,0,0,0,,Әзірше оны дохжоға апарайық...
Dialogue: 0,0:09:37.82,0:09:40.70,Default,,0,0,0,,Оны қайнату немесе грильде пісіру маңызды емес.
Dialogue: 0,0:09:40.78,0:09:42.91,Default,,0,0,0,,Бұл президенттің бостандығы, солай ма?
Dialogue: 0,0:09:43.20,0:09:44.33,Default,,0,0,0,,Тасымалдау
Dialogue: 0,0:09:45.00,0:09:47.29,Default,,0,0,0,,Сәлем! Маған көлік әкел
Dialogue: 0,0:09:48.58,0:09:49.54,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:58.09,0:09:58.93,Default,,0,0,0,,Жалғыз!
Dialogue: 0,0:09:59.22,0:10:00.05,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:10:01.60,0:10:02.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:04.14,0:10:04.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.07,0:10:14.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:14.48,0:10:16.86,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:17.19,0:10:19.11,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:19.20,0:10:21.45,Default,,0,0,0,,(өтіп бара жатқан адамдардың шуы)
Dialogue: 0,0:10:21.53,0:10:23.87,Default,,0,0,0,,(орамалы дыбыс)
Dialogue: 0,0:10:23.99,0:10:26.87,Default,,0,0,0,,Маған талшықтарды пайдалануға рұқсат етілді.
Dialogue: 0,0:10:27.20,0:10:28.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:29.17,0:10:31.46,Default,,0,0,0,,Тарих пайда болғаннан бері адамзат
Dialogue: 0,0:10:31.58,0:10:35.34,Default,,0,0,0,,артық болуға ұмтылу
Dialogue: 0,0:10:35.42,0:10:38.63,Default,,0,0,0,,Нәтижелер шығарылды. Біз осы күнге дейін ілгерілеп келеміз
Dialogue: 0,0:10:38.80,0:10:39.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:39.88,0:10:42.80,Default,,0,0,0,,Күшті және жылдамырақ
Dialogue: 0,0:10:42.97,0:10:45.68,Default,,0,0,0,,Ауыр шақпақ
Dialogue: 0,0:10:45.77,0:10:49.64,Default,,0,0,0,,Үлкенірек кішірек
Dialogue: 0,0:10:50.90,0:10:53.90,Default,,0,0,0,,Ал бұл талшықтан ғылым нені қалайды
Dialogue: 0,0:10:54.86,0:10:57.49,Default,,0,0,0,,Оны жіңішке және көру қиынырақ ету
Dialogue: 0,0:10:57.61,0:11:00.74,Default,,0,0,0,,Мықтырақ және сыну ықтималдығы аз
Dialogue: 0,0:11:01.57,0:11:05.03,Default,,0,0,0,,Жіңішке және берік талшықтар туралы соңғы мәліметтер
Dialogue: 0,0:11:05.12,0:11:07.83,Default,,0,0,0,,Ғалым нені алады
Dialogue: 0,0:11:08.00,0:11:10.87,Default,,0,0,0,,Сиқыршылардың болатыны белгілі
Dialogue: 0,0:11:11.62,0:11:14.21,Default,,0,0,0,,Бұл фактілерге қайшы келеді
Dialogue: 0,0:11:14.54,0:11:17.13,Default,,0,0,0,,Шындық мынада, біз, заңсыздықтар,
Dialogue: 0,0:11:17.46,0:11:19.51,Default,,0,0,0,,Сиқыршыдан көп бұрын
Dialogue: 0,0:11:19.59,0:11:23.43,Default,,0,0,0,,Ғалымдармен қара мәміле жасады.
Dialogue: 0,0:11:24.05,0:11:24.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:24.97,0:11:28.60,Default,,0,0,0,,Бір метр он мыңдаған доллар тұрады.
Dialogue: 0,0:11:29.56,0:11:31.85,Default,,0,0,0,,Техниканың қазіргі жағдайы
Dialogue: 0,0:11:31.94,0:11:36.44,Default,,0,0,0,,Осы арамид талшығы мен титанды агломерациялау арқылы жасалған шедевр.
Dialogue: 0,0:11:37.15,0:11:39.32,Default,,0,0,0,,Ғарышкердің өмір жолы
Dialogue: 0,0:11:39.40,0:11:43.11,Default,,0,0,0,,Бұл шедевр оқ өткізбейтін жилет ретінде қолданылған
Dialogue: 0,0:11:43.57,0:11:46.58,Default,,0,0,0,,4/1000 1 миллиметр
Dialogue: 0,0:11:46.66,0:11:48.79,Default,,0,0,0,,Іс жүзінде 4 микрон
Dialogue: 0,0:11:48.87,0:11:52.46,Default,,0,0,0,,Кернеу 200 килограммға жетті.
Dialogue: 0,0:11:53.17,0:11:56.71,Default,,0,0,0,,Гучи мырзаның тізімінде ілулі тұрған сызық мынау
Dialogue: 0,0:11:56.79,0:12:01.55,Default,,0,0,0,,Өрмекшінің торындай сезім болмаған шығар.
Dialogue: 0,0:12:02.26,0:12:03.43,Default,,0,0,0,,Сол кезде!
Dialogue: 0,0:12:04.14,0:12:05.93,Default,,0,0,0,,Сол кезде?
Dialogue: 0,0:12:07.18,0:12:11.23,Default,,0,0,0,,Ол мені оңай тепкілейді деп ойладым.
Dialogue: 0,0:12:13.81,0:12:16.44,Default,,0,0,0,,Хаа~ Маған ұнамайды.
Dialogue: 0,0:12:16.52,0:12:20.28,Default,,0,0,0,,Бұл күндері тіпті жекпе-жек шеберлері де ғылыммен айналысуға мәжбүр.
Dialogue: 0,0:12:20.36,0:12:21.61,Default,,0,0,0,,Сәлем, Рецу.
Dialogue: 0,0:12:22.40,0:12:24.11,Default,,0,0,0,,Өйткені есіктің арғы жағында жалаңаш қыз тұр.
Dialogue: 0,0:12:24.91,0:12:27.58,Default,,0,0,0,,Жоғарғы қолдың ішкі жағынан өтетін артерияны қысу
Dialogue: 0,0:12:27.66,0:12:30.91,Default,,0,0,0,,Қан кету сәтті тоқтатылды.
Dialogue: 0,0:12:31.41,0:12:35.00,Default,,0,0,0,,Әлі де жалғастырғыңыз келе ме? гроссмейстер
Dialogue: 0,0:12:35.29,0:12:36.58,Default,,0,0,0,,Фу~
Dialogue: 0,0:12:36.79,0:12:40.13,Default,,0,0,0,,Баяғыда мен кантемен айналысу қиын болды.
Dialogue: 0,0:12:42.63,0:12:47.14,Default,,0,0,0,,Мен қолымды байлаған бамбуктан кесіп алдым, бірақ ол қайтадан ауырады.
Dialogue: 0,0:12:47.85,0:12:51.14,Default,,0,0,0,,Мен қанша рет қайталанатын орыннан шығып, сындым?
Dialogue: 0,0:12:53.64,0:12:56.65,Default,,0,0,0,,Саусақтардың бәрі жойылса жақсы болар еді.
Dialogue: 0,0:12:56.81,0:13:00.15,Default,,0,0,0,,Егер сіз мұны істесеңіз, оған бар жүрегіңізді салуға болады ...
Dialogue: 0,0:13:00.86,0:13:01.69,Default,,0,0,0,,Фугу!
Dialogue: 0,0:13:03.32,0:13:04.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:05.32,0:13:06.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:07.82,0:13:10.53,Default,,0,0,0,,Менің арманым орындалды
Dialogue: 0,0:13:12.04,0:13:15.16,Default,,0,0,0,,Уау! (Өтіп бара жатқан) Мен оны бос қолыммен ұрдым!
Dialogue: 0,0:13:15.50,0:13:17.04,Default,,0,0,0,,Полиция шақырыңыз!
Dialogue: 0,0:13:18.17,0:13:19.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:19.34,0:13:20.17,Default,,0,0,0,,​​О?
Dialogue: 0,0:13:21.75,0:13:23.92,Default,,0,0,0,,Таз адамдар болмайды! (Өтіп бара жатқан адам) Қайда бардың?
Dialogue: 0,0:13:24.01,0:13:25.26,Default,,0,0,0,,Жоғалып кетті
Dialogue: 0,0:13:25.93,0:13:29.55,Default,,0,0,0,,Хаха... хахахаха!
Dialogue: 0,0:13:29.76,0:13:32.60,Default,,0,0,0,,Қандай керемет!
Dialogue: 0,0:13:34.23,0:13:39.69,Default,,0,0,0,,(арқан сықырлайды)
Dialogue: 0,0:13:40.36,0:13:43.03,Default,,0,0,0,,Ху~ Бұл үлкен мәселе.
Dialogue: 0,0:13:44.03,0:13:47.70,Default,,0,0,0,,Әдетте, егер сіз әуесқой болсаңыз, жай ғана арқанға ілініп кету сүйектің сынуына әкеледі.
Dialogue: 0,0:13:48.16,0:13:50.45,Default,,0,0,0,,Мен жаттығып жатырмын.
Dialogue: 0,0:13:50.62,0:13:51.45,Default,,0,0,0,,Аму
Dialogue: 0,0:13:51.53,0:13:53.29,Default,,0,0,0,,Сіз не істейсіз? президент
Dialogue: 0,0:13:58.37,0:13:59.21,Default,,0,0,0,,Уф
Dialogue: 0,0:13:59.46,0:14:02.75,Default,,0,0,0,,Осындай жағдайларда өлім жазасына кесілген тұтқын болған жақсы.
Dialogue: 0,0:14:02.84,0:14:05.21,Default,,0,0,0,,Ең сорақысы, өлтіруге болмайды.
Dialogue: 0,0:14:09.68,0:14:10.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:13.35,0:14:15.98,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:14:16.64,0:14:17.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:18.64,0:14:20.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:26.61,0:14:27.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:33.66,0:14:35.33,Default,,0,0,0,,Мынау енот ит!
Dialogue: 0,0:14:35.83,0:14:38.50,Default,,0,0,0,,Сіз қашаннан бері актер болып жүрсіз?
Dialogue: 0,0:14:39.79,0:14:40.62,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:42.75,0:14:43.59,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:46.71,0:14:47.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:47.72,0:14:49.59,Default,,0,0,0,,Бұл оқ өткізбейтін.
Dialogue: 0,0:14:50.22,0:14:51.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:51.72,0:14:52.76,Default,,0,0,0,,Сооо~ Иә!
Dialogue: 0,0:14:53.39,0:14:54.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:55.56,0:14:56.39,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:58.10,0:14:58.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:08.49,0:15:09.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:11.53,0:15:13.32,Default,,0,0,0,,Гах...
Dialogue: 0,0:15:14.53,0:15:15.37,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:16.79,0:15:17.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:17.95,0:15:19.08,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:19.71,0:15:20.66,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:15:21.79,0:15:22.63,Default,,0,0,0,,Ах
Dialogue: 0,0:15:23.83,0:15:24.84,Default,,0,0,0,,О!
Dialogue: 0,0:15:25.42,0:15:26.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.80,0:15:29.63,Default,,0,0,0,,Иә
Dialogue: 0,0:15:33.30,0:15:35.43,Default,,0,0,0,,Бұл менің жоғалтуым.
Dialogue: 0,0:15:36.06,0:15:37.01,Default,,0,0,0,,Хаха
Dialogue: 0,0:15:38.77,0:15:41.19,Default,,0,0,0,,(лақтыру дыбысы)
Dialogue: 0,0:15:42.27,0:15:43.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:44.27,0:15:46.15,Default,,0,0,0,,Хаа~ Хаа~
Dialogue: 0,0:15:46.90,0:15:48.65,Default,,0,0,0,,Шығыстағы бұл поза
Dialogue: 0,0:15:49.74,0:15:52.49,Default,,0,0,0,,100% берілу дегенді білдіреді
Dialogue: 0,0:15:53.07,0:15:55.66,Default,,0,0,0,,Do Ge The
Dialogue: 0,0:15:55.91,0:15:57.49,Default,,0,0,0,,Иә! Догеза!
Dialogue: 0,0:15:57.58,0:16:00.00,Default,,0,0,0,,Жеңілістегі ең жақсының ең жақсысы!
Dialogue: 0,0:16:00.08,0:16:00.91,Default,,0,0,0,,Ммм
Dialogue: 0,0:16:01.21,0:16:02.79,Default,,0,0,0,,Сіз жеңдіңіз.
Dialogue: 0,0:16:02.87,0:16:05.54,Default,,0,0,0,,Сіздің жылдамдығыңыз Сіздің күшіңіз
Dialogue: 0,0:16:05.63,0:16:06.92,Default,,0,0,0,,Сіздің төзімділігіңіз
Dialogue: 0,0:16:07.25,0:16:10.63,Default,,0,0,0,,Мен жеңе алатын ештеңе жоқ!
Dialogue: 0,0:16:11.05,0:16:13.13,Default,,0,0,0,,Жәндіктердің жақсы екенін бәрі біледі.
Dialogue: 0,0:16:13.38,0:16:17.51,Default,,0,0,0,,Міне! Мені сағынба!
Dialogue: 0,0:16:20.39,0:16:21.23,Default,,0,0,0,,​​О?
Dialogue: 0,0:16:22.10,0:16:23.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:29.57,0:16:32.36,Default,,0,0,0,,Жер астында... ұйықтап жатыр ма?
Dialogue: 0,0:16:33.36,0:16:35.95,Default,,0,0,0,,Тек өзім туралы~
Dialogue: 0,0:16:36.03,0:16:39.66,Default,,0,0,0,,Жауластарым үшін кек алу ойым жоқ.
Dialogue: 0,0:16:39.83,0:16:40.66,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:40.79,0:16:41.62,Default,,0,0,0,,О!
Dialogue: 0,0:16:42.16,0:16:43.83,Default,,0,0,0,,Хмф! (Игари) Гуаа!
Dialogue: 0,0:16:45.62,0:16:46.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:50.13,0:16:53.55,Default,,0,0,0,,Ух... Хаа Хаа...
Dialogue: 0,0:16:53.63,0:16:54.47,Default,,0,0,0,,Хаа~
Dialogue: 0,0:16:56.68,0:16:59.97,Default,,0,0,0,,Мен сені абайсызда ұстау үшін бәрін істеймін.
Dialogue: 0,0:17:00.47,0:17:04.06,Default,,0,0,0,,Ешкім қарамаса, менің құлағымды да жалайсың.
Dialogue: 0,0:17:04.14,0:17:04.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:07.10,0:17:08.02,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:12.57,0:17:13.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:15.78,0:17:18.95,Default,,0,0,0,,Құбыжықтың терісін жұлып аламын.
Dialogue: 0,0:17:19.28,0:17:21.99,Default,,0,0,0,,Эй, эй...
Dialogue: 0,0:17:22.54,0:17:24.00,Default,,0,0,0,,Жарайды~
Dialogue: 0,0:17:24.71,0:17:27.00,Default,,0,0,0,,Менен жасырсаң да!
Dialogue: 0,0:17:29.17,0:17:31.50,Default,,0,0,0,,Гуах!
Dialogue: 0,0:17:31.67,0:17:33.51,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:17:34.21,0:17:35.72,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:42.43,0:17:43.27,Default,,0,0,0,,Хмф!
Dialogue: 0,0:17:43.64,0:17:44.48,Default,,0,0,0,,Ой…
Dialogue: 0,0:17:46.64,0:17:48.19,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:17:48.35,0:17:49.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:49.27,0:17:53.19,Default,,0,0,0,,(Сикорскийдің біртүрлі дауысы)
Dialogue: 0,0:18:02.41,0:18:06.62,Default,,0,0,0,,Ахаха, шын болмысыңды көрсетпей тұрып ажырасып кеттің бе?
Dialogue: 0,0:18:09.58,0:18:10.83,Default,,0,0,0,,Фу~
Dialogue: 0,0:18:13.88,0:18:16.01,Default,,0,0,0,,Хаа~
Dialogue: 0,0:18:16.38,0:18:17.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:18.63,0:18:20.14,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:18:21.05,0:18:22.10,Default,,0,0,0,,Ой~
Dialogue: 0,0:18:28.81,0:18:30.85,Default,,0,0,0,,
Dialogue: 0,0:18:53.21,0:18:55.46,Default,,0,0,0,,Бақи пансионатының иесінің қызы.
Dialogue: 0,0:18:55.92,0:18:57.88,Default,,0,0,0,,Бір орта мектепте оқитын жоғары сынып қыздары
Dialogue: 0,0:18:58.92,0:19:00.76,Default,,0,0,0,,Баки ең үлкен турнирге қатысады
Dialogue: 0,0:19:00.84,0:19:02.80,Default,,0,0,0,,Мен қатысқанымды білемін.
Dialogue: 0,0:19:05.14,0:19:06.31,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:19:07.10,0:19:07.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:08.10,0:19:10.64,Default,,0,0,0,,Баки-кун бұл күн екенін айтты.
Dialogue: 0,0:19:11.23,0:19:14.02,Default,,0,0,0,,Біреуді шақыру қиын.
Dialogue: 0,0:19:14.11,0:19:16.15,Default,,0,0,0,,Бір-бірлеріңмен көрші тұрсаңдар.
Dialogue: 0,0:19:16.65,0:19:20.36,Default,,0,0,0,,Бұл мені бұрын шақырғыңыз келгенін білдіре ме?
Dialogue: 0,0:19:21.49,0:19:24.58,Default,,0,0,0,,Иә... Мен бұл туралы біраздан бері ойладым.
Dialogue: 0,0:19:25.16,0:19:26.29,Default,,0,0,0,,Ұзақ уақыт бойы
Dialogue: 0,0:19:26.49,0:19:27.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:28.58,0:19:29.41,Default,,0,0,0,,Иә
Dialogue: 0,0:19:31.67,0:19:33.13,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:19:33.38,0:19:34.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:37.13,0:19:40.67,Default,,0,0,0,,Күресу және ұнату
Dialogue: 0,0:19:41.80,0:19:44.26,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:19:44.64,0:19:46.85,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,0:19:46.93,0:19:50.10,Default,,0,0,0,,Неліктен адамдар маған қоңырау шалса, мен оларды елемеймін?
Dialogue: 0,0:19:50.18,0:19:52.10,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:52.48,0:19:56.90,Default,,0,0,0,,Қалада серуендеп жүрген жастарға арналған сауалнаманы толтыра аласыз ба?
Dialogue: 0,0:19:57.07,0:19:57.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.98,0:20:01.90,Default,,0,0,0,,Эй, ол әдемі мачо.
Dialogue: 0,0:20:03.20,0:20:05.62,Default,,0,0,0,,Қарияның әмиянының мазмұны
Dialogue: 0,0:20:05.70,0:20:08.91,Default,,0,0,0,,Қарсы болмасаңыз, маған хабарлаңыз.
Dialogue: 0,0:20:09.62,0:20:12.41,Default,,0,0,0,,Қарсы болмасаңыз, маған хабарлаңыз.
Dialogue: 0,0:20:16.88,0:20:17.92,Default,,0,0,0,,Күте тұрыңыз... не?
Dialogue: 0,0:20:19.50,0:20:20.34,Default,,0,0,0,,...!
Dialogue: 0,0:20:24.18,0:20:26.68,Default,,0,0,0,,Мен өтемін, жарай ма?
Dialogue: 0,0:20:26.85,0:20:28.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:28.56,0:20:29.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:30.27,0:20:32.64,Default,,0,0,0,,«Шындығында, Уэноға бір ғана пойызбен жетуге болады»
Dialogue: 0,0:20:33.81,0:20:34.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:35.06,0:20:35.90,Default,,0,0,0,,Уау~
Dialogue: 0,0:20:41.57,0:20:42.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:42.82,0:20:44.32,Default,,0,0,0,,Фу~
Dialogue: 0,0:20:47.28,0:20:48.16,Default,,0,0,0,,Иә
Dialogue: 0,0:20:52.08,0:20:53.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:38.58,0:21:39.42,Default,,0,0,0,,Ах... Жарайды!
Dialogue: 0,0:21:40.63,0:21:41.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:42.55,0:21:43.55,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:21:43.63,0:21:45.47,Default,,0,0,0,,А, кешіріңіз!
Dialogue: 0,0:21:45.76,0:21:47.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:47.63,0:21:48.47,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:49.22,0:21:50.05,Default,,0,0,0,,Ах
Dialogue: 0,0:22:17.46,0:22:19.33,Default,,0,0,0,,Ihi~
Dialogue: 0,0:22:21.00,0:22:27.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:44.54,0:23:50.55,Default,,0,0,0,,~♪
Dialogue: 0,0:23:52.05,0:23:58.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory