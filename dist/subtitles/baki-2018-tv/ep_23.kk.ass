Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,‎NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.51,0:00:17.51,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:34.21,0:01:40.22,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:43.39,0:01:44.43,Default,,0,0,0,,‎(Сикорский) Уг~
Dialogue: 0,0:01:44.77,0:01:46.48,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:01:46.64,0:01:48.44,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:01:51.61,0:01:52.44,Default,,0,0,0,,‎Фу
Dialogue: 0,0:01:55.11,0:01:55.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:57.11,0:01:57.95,Default,,0,0,0,,‎Хмм!
Dialogue: 0,0:01:59.61,0:02:00.45,Default,,0,0,0,,‎Ку~!
Dialogue: 0,0:02:01.07,0:02:01.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:03.08,0:02:03.91,Default,,0,0,0,,Ей!
Dialogue: 0,0:02:04.04,0:02:04.87,Default,,0,0,0,,Ей!
Dialogue: 0,0:02:05.58,0:02:06.41,Default,,0,0,0,,Ей!
Dialogue: 0,0:02:06.54,0:02:07.37,Default,,0,0,0,,Гах!
Dialogue: 0,0:02:10.88,0:02:12.71,Default,,0,0,0,,‎Гах~
Dialogue: 0,0:02:12.92,0:02:15.17,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:02:16.01,0:02:17.72,Default,,0,0,0,,‎(Көрермендер) Ой! осы жерге ұшып
Dialogue: 0,0:02:19.18,0:02:20.97,Default,,0,0,0,,(Ер аудитория) Бұл қоршаған ортаны бұзу сияқты (Әйел аудитория)
Dialogue: 0,0:02:21.22,0:02:22.47,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:02:26.64,0:02:27.48,Default,,0,0,0,,Уф
Dialogue: 0,0:02:27.89,0:02:28.73,Default,,0,0,0,,А
Dialogue: 0,0:02:31.27,0:02:32.98,Default,,0,0,0,,‎Ах... а...
Dialogue: 0,0:02:33.15,0:02:34.73,Default,,0,0,0,,‎Хаа хааа...
Dialogue: 0,0:02:34.86,0:02:36.99,Default,,0,0,0,,‎Ах... а
Dialogue: 0,0:02:38.24,0:02:39.07,Default,,0,0,0,,‎Хаа~
Dialogue: 0,0:02:40.20,0:02:41.70,Default,,0,0,0,,Мен жақсы тер төктім.
Dialogue: 0,0:02:41.82,0:02:42.66,Default,,0,0,0,,‎(Сикорский)!
Dialogue: 0,0:02:43.66,0:02:47.00,Default,,0,0,0,,‎(Көрермендердің шуы)
Dialogue: 0,0:02:47.16,0:02:49.25,Default,,0,0,0,,«Қоршаған ортаны пайдаланумен күрес туралы заң»
Dialogue: 0,0:02:50.62,0:02:52.50,Default,,0,0,0,,Енді нақты мәміле келді
Dialogue: 0,0:02:57.63,0:02:58.76,Default,,0,0,0,,‎(Көрермендер) Уау~
Dialogue: 0,0:02:58.92,0:03:01.80,Default,,0,0,0,,‎(Көрермендердің шуы)
Dialogue: 0,0:03:01.93,0:03:03.26,Default,,0,0,0,,А...
Dialogue: 0,0:03:03.43,0:03:08.52,Default,,0,0,0,,‎(Көрермендердің шуы)
Dialogue: 0,0:03:08.93,0:03:10.94,Default,,0,0,0,,‎(Аудитория) Не? Таңғажайып шаң
Dialogue: 0,0:03:11.06,0:03:13.52,Default,,0,0,0,,‎(Аудитория) Құмда ойнау! (Әйел аудитория мүшесі) Сіз кәмелетке толмағансыз ба?
Dialogue: 0,0:03:16.02,0:03:16.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:17.19,0:03:24.20,Default,,0,0,0,,‎(Көрермендердің шуы)
Dialogue: 0,0:03:25.20,0:03:27.04,Default,,0,0,0,,‎(Аудитория) Ах! (Әйел аудитория мүшесі) Ах...
Dialogue: 0,0:03:30.25,0:03:31.54,Default,,0,0,0,,‎(Сикорский) №
Dialogue: 0,0:03:32.08,0:03:33.33,Default,,0,0,0,,Бұл жоғалды.
Dialogue: 0,0:03:34.54,0:03:35.54,Default,,0,0,0,,А...
Dialogue: 0,0:03:35.71,0:03:36.54,Default,,0,0,0,,‎(Сикорский) Шынымен...
Dialogue: 0,0:03:38.09,0:03:39.05,Default,,0,0,0,,Еш жерде
Dialogue: 0,0:03:40.80,0:03:42.05,Default,,0,0,0,,‎Ух (Сикорский) Ах.
Dialogue: 0,0:03:42.22,0:03:43.05,Default,,0,0,0,,А
Dialogue: 0,0:03:46.05,0:03:46.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:50.27,0:03:51.56,Default,,0,0,0,,‎Ба-ка
Dialogue: 0,0:03:51.94,0:03:52.77,Default,,0,0,0,,…
Dialogue: 0,0:03:52.89,0:03:54.10,Default,,0,0,0,,Бұл жалған.
Dialogue: 0,0:03:55.98,0:03:57.32,Default,,0,0,0,,‎Ах ха...
Dialogue: 0,0:03:57.57,0:03:58.94,Default,,0,0,0,,‎(Көрермендер) Бұл камуфляж.
Dialogue: 0,0:03:59.11,0:04:01.57,Default,,0,0,0,,‎(Көрермендер) Ол денесін шаң басып, бүркемелейді.
Dialogue: 0,0:04:03.45,0:04:04.28,Default,,0,0,0,,Уф
Dialogue: 0,0:04:05.20,0:04:06.03,Default,,0,0,0,,А
Dialogue: 0,0:04:07.70,0:04:08.58,Default,,0,0,0,,‎(Көрермендер) қайтадан жоғалып кетті.
Dialogue: 0,0:04:09.08,0:04:10.87,Default,,0,0,0,,Көрінбейтін адам сияқты
Dialogue: 0,0:04:14.67,0:04:15.50,Default,,0,0,0,,‎K…
Dialogue: 0,0:04:17.00,0:04:17.84,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:04:18.75,0:04:19.59,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:04:22.63,0:04:23.47,Default,,0,0,0,,‎Уф... уф
Dialogue: 0,0:04:24.63,0:04:27.30,Default,,0,0,0,,‎(Көрермендер) Камуфляж мен шаңның түтін экранынан мен оны мүлдем көре алмаймын.
Dialogue: 0,0:04:27.43,0:04:29.10,Default,,0,0,0,,‎(Көрермендер) Сіз осылай жасыра аласыз ба?
Dialogue: 0,0:04:30.77,0:04:31.60,Default,,0,0,0,,‎(Сикорский) Ха…
Dialogue: 0,0:04:31.93,0:04:33.10,Default,,0,0,0,,Неге жасыру керек!
Dialogue: 0,0:04:33.73,0:04:36.10,Default,,0,0,0,,‎Неге ер адам сияқты күресуге тырыспайсың?
Dialogue: 0,0:04:39.40,0:04:40.23,Default,,0,0,0,,‎Уга~
Dialogue: 0,0:04:41.40,0:04:42.24,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:04:44.49,0:04:45.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:49.66,0:04:50.54,Default,,0,0,0,,‎(Көрермендер) О~
Dialogue: 0,0:04:50.66,0:04:52.62,Default,,0,0,0,,‎(Аудитория) Уау! Ол шықты! (Әйел аудитория мүшесі) Бұл қашан болды?
Dialogue: 0,0:04:53.08,0:04:55.00,Default,,0,0,0,,«Адам сияқты күрес»?
Dialogue: 0,0:04:55.12,0:04:56.62,Default,,0,0,0,,Мен оны жиі айтамын, бұл жігіт.
Dialogue: 0,0:04:57.08,0:04:58.58,Default,,0,0,0,,‎Аа... Уф
Dialogue: 0,0:04:59.38,0:05:02.80,Default,,0,0,0,,‎Екеуміз қазір мұнда не істеп жатырмыз?
Dialogue: 0,0:05:02.92,0:05:04.47,Default,,0,0,0,,‎Ресей халқы
Dialogue: 0,0:05:04.88,0:05:06.63,Default,,0,0,0,,А...
Dialogue: 0,0:05:07.09,0:05:08.34,Default,,0,0,0,,Күрес
Dialogue: 0,0:05:09.05,0:05:10.31,Default,,0,0,0,,‎Хе, иә...
Dialogue: 0,0:05:10.47,0:05:13.14,Default,,0,0,0,,Бұл күрес болуы керек, бірақ...
Dialogue: 0,0:05:19.23,0:05:20.65,Default,,0,0,0,,Ұрыс емес
Dialogue: 0,0:05:21.48,0:05:22.65,Default,,0,0,0,,‎Ах... а
Dialogue: 0,0:05:23.32,0:05:24.32,Default,,0,0,0,,‎(Токугава)...
Dialogue: 0,0:05:25.78,0:05:27.24,Default,,0,0,0,,Тірі қалу
Dialogue: 0,0:05:28.45,0:05:30.66,Default,,0,0,0,,мырза. Чикор және Гая
Dialogue: 0,0:05:31.20,0:05:34.41,Default,,0,0,0,,Барлық тіршілікті жұмылдырған аман қалған
Dialogue: 0,0:05:35.04,0:05:36.91,Default,,0,0,0,,‎Аа...хаха
Dialogue: 0,0:05:38.08,0:05:38.92,Default,,0,0,0,,‎Фу
Dialogue: 0,0:05:40.04,0:05:41.63,Default,,0,0,0,,Уф... тағы да...
Dialogue: 0,0:05:41.92,0:05:42.92,Default,,0,0,0,,‎Сикор? (Сикорский) Уф.
Dialogue: 0,0:05:44.51,0:05:45.67,Default,,0,0,0,,‎K…
Dialogue: 0,0:05:46.63,0:05:48.63,Default,,0,0,0,,Сізге қарсы зорлық-зомбылық...
Dialogue: 0,0:05:48.89,0:05:51.93,Default,,0,0,0,,‎Нағыз қорқыныш сыйын берейік
Dialogue: 0,0:05:53.10,0:05:56.93,Default,,0,0,0,,‎(Қатты желдің дыбысы)
Dialogue: 0,0:06:04.32,0:06:05.15,Default,,0,0,0,,‎(Янаги) ғұн
Dialogue: 0,0:06:06.57,0:06:08.45,Default,,0,0,0,,‎Ескі еліктеу...
Dialogue: 0,0:06:10.82,0:06:16.20,Default,,0,0,0,,‎(Янаги) Бұл сақ адамның мәселені шешуге арналған күтпеген ұсынысы.
Dialogue: 0,0:06:18.37,0:06:21.96,Default,,0,0,0,,‎(Шибукава) «Жауынгерлік дос Янаги Рюкоден»
Dialogue: 0,0:06:23.29,0:06:26.05,Default,,0,0,0,,‎«Сізбен ұзақ қарым-қатынас үшін»
Dialogue: 0,0:06:26.17,0:06:28.22,Default,,0,0,0,,‎«Мен оны шешкім келеді»
Dialogue: 0,0:06:29.13,0:06:30.72,Default,,0,0,0,,‎«Сіздің қатысуыңызды сұраймын...»
Dialogue: 0,0:06:31.51,0:06:32.35,Default,,0,0,0,,‎(Шибукава) Ах.
Dialogue: 0,0:06:33.18,0:06:34.01,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:06:35.22,0:06:36.52,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:41.77,0:06:46.65,Default,,0,0,0,,(Шибукава) Янагиден басқа жеңілісім сол кезде болды!
Dialogue: 0,0:06:48.99,0:06:51.24,Default,,0,0,0,,‎(Әңгімелеу) Турнирдің максималды жартылай финалы
Dialogue: 0,0:06:51.57,0:06:55.24,Default,,0,0,0,,Шибукава Джек Хаммермен жекпе-жекке бара жатқанда не көрді
Dialogue: 0,0:06:57.37,0:07:00.58,Default,,0,0,0,,Бұл менің жолымды жауып тастаған елес қақпасы болды.
Dialogue: 0,0:07:00.75,0:07:03.13,Default,,0,0,0,,Тіпті осындай нәрсе шығады
Dialogue: 0,0:07:06.84,0:07:08.71,Default,,0,0,0,,‎(Әңгімелеу) Содан кейін барыңыз—
Dialogue: 0,0:07:09.26,0:07:13.01,Default,,0,0,0,,Шибукаваның жеңілгенін хабарлағандай көрінді.
Dialogue: 0,0:07:13.76,0:07:14.89,Default,,0,0,0,,Дәл...
Dialogue: 0,0:07:15.51,0:07:18.93,Default,,0,0,0,,‎Бұл жерде тағы да сол елес.
Dialogue: 0,0:07:23.60,0:07:25.52,Default,,0,0,0,,‎(Шибукава) Неге мұндай уақытта?
Dialogue: 0,0:07:29.74,0:07:30.57,Default,,0,0,0,,‎Ах...
Dialogue: 0,0:07:30.70,0:07:32.11,Default,,0,0,0,,Үйретейік
Dialogue: 0,0:07:32.74,0:07:34.95,Default,,0,0,0,,‎Зорлық-зомбылықтан нағыз қорқыныш
Dialogue: 0,0:07:38.91,0:07:39.75,Default,,0,0,0,,Ух...
Dialogue: 0,0:07:41.62,0:07:46.00,Default,,0,0,0,,‎(Токугава) Нағыз зорлық-зомбылықтан қорқу?
Dialogue: 0,0:07:47.59,0:07:50.92,Default,,0,0,0,,‎(Сикорский) Сіз оны көре алуыңыз керек, әрине...
Dialogue: 0,0:07:51.38,0:07:53.97,Default,,0,0,0,,‎Сенімді бол... Сенімді бол...
Dialogue: 0,0:07:54.09,0:07:55.34,Default,,0,0,0,,Сенімді болыңыз!
Dialogue: 0,0:07:58.35,0:07:59.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:01.23,0:08:02.06,Default,,0,0,0,,ng…
Dialogue: 0,0:08:02.19,0:08:03.44,Default,,0,0,0,,‎(Сикорский) Мен оны көрмеймін!
Dialogue: 0,0:08:04.06,0:08:04.94,Default,,0,0,0,,‎Ах... а
Dialogue: 0,0:08:05.94,0:08:06.94,Default,,0,0,0,,‎(Сикорский) көрінбейтін
Dialogue: 0,0:08:07.69,0:08:08.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:08.82,0:08:09.65,Default,,0,0,0,,‎K…
Dialogue: 0,0:08:10.69,0:08:11.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:12.70,0:08:15.91,Default,,0,0,0,,‎(Сикорский) Сіз қалай күресесіз?
Dialogue: 0,0:08:17.12,0:08:17.95,Default,,0,0,0,,‎Хехе
Dialogue: 0,0:08:18.12,0:08:18.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:21.58,0:08:24.46,Default,,0,0,0,,‎(Сикорский) Неліктен? Неге шабуыл жасамасқа?
Dialogue: 0,0:08:25.42,0:08:26.46,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:08:26.58,0:08:27.42,Default,,0,0,0,,Уау
Dialogue: 0,0:08:27.67,0:08:28.50,Default,,0,0,0,,Ей!
Dialogue: 0,0:08:29.67,0:08:30.51,Default,,0,0,0,,Ғұн
Dialogue: 0,0:08:30.88,0:08:31.71,Default,,0,0,0,,Уф
Dialogue: 0,0:08:31.84,0:08:33.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:34.01,0:08:35.68,Default,,0,0,0,,Хабар (Сикорский) Ах.
Dialogue: 0,0:08:37.01,0:08:42.48,Default,,0,0,0,,‎ Бұл «Мен сені кез келген уақытта өлтіре аламын» деген хабарлама.
Dialogue: 0,0:08:45.65,0:08:46.48,Default,,0,0,0,,‎(Шибукава) Ах!
Dialogue: 0,0:08:47.23,0:08:50.02,Default,,0,0,0,,‎(Микошиба) Түсінесіз бе?
Dialogue: 0,0:08:51.82,0:08:53.49,Default,,0,0,0,,‎(Микошишиба) Шибукава Хан?
Dialogue: 0,0:08:54.24,0:08:58.12,Default,,0,0,0,,(Әңгімелеу) Кихеи Микошиба, Гошинрю Айкидзюджуцудың негізін қалаушы
Dialogue: 0,0:09:01.54,0:09:04.08,Default,,0,0,0,,«Күресу және жеңу» деген ұғым жоқ.
Dialogue: 0,0:09:04.21,0:09:08.75,Default,,0,0,0,,‎Жеке жекпе-жек бойынша, жетілмеген және жетілмеген
Dialogue: 0,0:09:09.88,0:09:12.51,Default,,0,0,0,,‎Сен қазір жақсысың.
Dialogue: 0,0:09:12.63,0:09:13.46,Default,,0,0,0,,‎(Шибукава) Иә
Dialogue: 0,0:09:14.84,0:09:17.80,Default,,0,0,0,,Сіз жеңе алмайтын жауға жақындай алмайсыз.
Dialogue: 0,0:09:18.18,0:09:23.77,Default,,0,0,0,,Барсаң да, ол кісінің қабілеті сенен артық болса,
Dialogue: 0,0:09:23.89,0:09:26.77,Default,,0,0,0,,Сіз ол жерге жете алмайсыз.
Dialogue: 0,0:09:29.15,0:09:30.40,Default,,0,0,0,,‎(Шибукава) Содан кейін...
Dialogue: 0,0:09:32.78,0:09:34.40,Default,,0,0,0,,Бұл иллюзия...
Dialogue: 0,0:09:36.95,0:09:38.07,Default,,0,0,0,,Тек...
Dialogue: 0,0:09:40.74,0:09:45.00,Default,,0,0,0,,‎Осыдан әрі бізді қаншалықты қауіп күтіп тұр?
Dialogue: 0,0:09:48.46,0:09:54.38,Default,,0,0,0,,‎(Қатты желдің дыбысы)
Dialogue: 0,0:09:54.92,0:09:57.01,Default,,0,0,0,,Қайда және кіммен?
Dialogue: 0,0:10:00.09,0:10:04.64,Default,,0,0,0,,‎(Мотобу) Сорегараши Изо Мотобу есімді адам
Dialogue: 0,0:10:05.31,0:10:08.10,Default,,0,0,0,,‎(Әңгімелеу) Motobu-ryu практикалық джиу-джитсу қолданушысы
