Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:12.17,0:00:18.18,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.01,0:01:40.01,Default,,0,0,0,,~♪
Dialogue: 0,0:01:50.81,0:01:52.90,Default,,0,0,0,,Мен Доппо Орочи мырзамен танысқым келеді
Dialogue: 0,0:01:55.74,0:01:59.91,Default,,0,0,0,,Бәрі жақсы, тек аяқ киіміңді шеш, ақ адам.
Dialogue: 0,0:02:05.04,0:02:06.91,Default,,0,0,0,,Бұл дөрекі
Dialogue: 0,0:02:10.79,0:02:11.79,Default,,0,0,0,,Уа... Ах!
Dialogue: 0,0:02:13.71,0:02:14.96,Default,,0,0,0,,Аһ!
Dialogue: 0,0:02:16.38,0:02:17.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:22.97,0:02:26.10,Default,,0,0,0,,Кешіріңіз, кешіріңіз, жақсысыз ба?
Dialogue: 0,0:02:26.77,0:02:27.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:28.48,0:02:29.85,Default,,0,0,0,,Өте жақсы екен. Хахаха.
Dialogue: 0,0:02:30.73,0:02:31.56,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:31.69,0:02:32.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:33.86,0:02:34.69,Default,,0,0,0,,Хмф!
Dialogue: 0,0:02:36.82,0:02:38.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:38.78,0:02:42.70,Default,,0,0,0,,Неге сонша қауіпті нәрсе киіп жүрсіз?
Dialogue: 0,0:02:42.87,0:02:44.66,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:02:45.41,0:02:46.58,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:02:47.00,0:02:47.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:52.96,0:02:56.59,Default,,0,0,0,,Мынау... мынау!
Dialogue: 0,0:02:57.84,0:02:59.09,Default,,0,0,0,,Шарлатан!
Dialogue: 0,0:02:59.76,0:03:01.18,Default,,0,0,0,,Орта сызықтағы үздіксіз шабуыл!
Dialogue: 0,0:03:01.43,0:03:02.34,Default,,0,0,0,,Бірақ қызық емес пе?
Dialogue: 0,0:03:03.26,0:03:04.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:05.47,0:03:07.43,Default,,0,0,0,,Бұл соңы ма?
Dialogue: 0,0:03:08.35,0:03:09.35,Default,,0,0,0,,Гах...
Dialogue: 0,0:03:10.27,0:03:11.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:11.27,0:03:14.15,Default,,0,0,0,,Рецу-сенсэй басқан еден тақталары!
Dialogue: 0,0:03:15.19,0:03:16.23,Default,,0,0,0,,Мұғалімнің орынбасары!
Dialogue: 0,0:03:16.36,0:03:17.28,Default,,0,0,0,,Катцуми мырза!
Dialogue: 0,0:03:18.82,0:03:19.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:20.28,0:03:24.28,Default,,0,0,0,,Сол баланың қожайыны Доппо Орочи болса.
Dialogue: 0,0:03:24.45,0:03:26.24,Default,,0,0,0,,Күтуге болады
Dialogue: 0,0:03:29.33,0:03:32.54,Default,,0,0,0,,Үйге аман-есен ораламын деп ойлайсыз ба?
Dialogue: 0,0:03:33.63,0:03:35.54,Default,,0,0,0,,Доджоның ортасына оралу.
Dialogue: 0,0:03:38.21,0:03:39.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:39.67,0:03:40.88,Default,,0,0,0,,
Dialogue: 0,0:03:41.22,0:03:43.55,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:44.30,0:03:45.47,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:45.85,0:03:49.72,Default,,0,0,0,,А... рахмет~
Dialogue: 0,0:03:50.60,0:03:51.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:52.10,0:03:54.90,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:57.11,0:03:57.94,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:04:03.36,0:04:04.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:04.78,0:04:05.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:09.74,0:04:11.70,Default,,0,0,0,,Рецу-сенсэй оны алдымен орнатты
Dialogue: 0,0:04:11.79,0:04:16.08,Default,,0,0,0,,Жоқ, мүмкін...
Dialogue: 0,0:04:17.54,0:04:18.38,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:18.92,0:04:20.88,Default,,0,0,0,,(Джозефтің ауыр демі)
Dialogue: 0,0:04:21.84,0:04:25.13,Default,,0,0,0,,Жақсы шайқас, тамаша жауынгер болды.
Dialogue: 0,0:04:25.76,0:04:26.89,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:04:27.97,0:04:32.14,Default,,0,0,0,,Сіз мұндағылардың жаттықтырушысы сияқтысыз.
Dialogue: 0,0:04:34.14,0:04:37.44,Default,,0,0,0,,Жау аумағындағы шайқастарды ақылды деп атауға болмайды.
Dialogue: 0,0:04:42.69,0:04:44.78,Default,,0,0,0,,Оны өзгертейік.
Dialogue: 0,0:04:45.61,0:04:48.78,Default,,0,0,0,,Мен сізді тағы да көруге асығамын.
Dialogue: 0,0:04:49.95,0:04:51.08,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:04:54.41,0:04:55.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:55.92,0:04:56.75,Default,,0,0,0,,Нһ!
Dialogue: 0,0:04:57.00,0:04:59.13,Default,,0,0,0,,Ах! (Мүше) Сәлем... Өрт!
Dialogue: 0,0:04:59.21,0:05:00.63,Default,,0,0,0,,
Dialogue: 0,0:05:00.96,0:05:02.51,Default,,0,0,0,,О, ол мұнда жоқ.
Dialogue: 0,0:05:02.59,0:05:03.59,Default,,0,0,0,,Өрт сөндіргіш~!
Dialogue: 0,0:05:03.67,0:05:05.13,Default,,0,0,0,,Ақымақ! Мені қу!
Dialogue: 0,0:05:05.34,0:05:09.14,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:05:09.30,0:05:10.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:13.93,0:05:15.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:18.98,0:05:19.94,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:05:20.02,0:05:21.86,Default,,0,0,0,,Жиналу~!
Dialogue: 0,0:05:22.69,0:05:26.95,Default,,0,0,0,,Өткен сабақта айтқанымдай, дене дайындығына тест тапсырыңыз.
Dialogue: 0,0:05:27.03,0:05:28.61,Default,,0,0,0,,Иә! (Бала) Катари
Dialogue: 0,0:05:29.28,0:05:32.08,Default,,0,0,0,,100 метрге жүгіру Софтбол лақтыру
Dialogue: 0,0:05:32.16,0:05:36.62,Default,,0,0,0,,Ұзындыққа секіру, тартылу және 1500 метрге жүгіру.
Dialogue: 0,0:05:37.33,0:05:39.04,Default,,0,0,0,,Бұл жігіт байсалды.
Dialogue: 0,0:05:39.21,0:05:40.96,Default,,0,0,0,,Сонымен қатар, Yoshida Productions Яиді Yotsuba-ның талисманы ретінде насихаттап жатыр.
Dialogue: 0,0:05:42.05,0:05:43.38,Default,,0,0,0,,Мен бұл туралы ойлаған кезде...
Dialogue: 0,0:05:43.55,0:05:44.38,Default,,0,0,0,,
Dialogue: 0,0:05:44.88,0:05:48.89,Default,,0,0,0,,Бұл менің өмірімде бірінші рет дене дайындығымды өлшеуге тура келді.
Dialogue: 0,0:05:49.59,0:05:51.89,Default,,0,0,0,,Неге шорт кимейсің, Бақи!
Dialogue: 0,0:05:54.47,0:05:56.18,Default,,0,0,0,,Осы уақытқа дейін?
Dialogue: 0,0:05:56.73,0:05:57.85,Default,,0,0,0,,Орналасқан жері туралы!
Dialogue: 0,0:05:57.94,0:05:59.48,Default,,0,0,0,,Иә? бұл сияқты?
Dialogue: 0,0:05:59.56,0:06:00.69,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:01.06,0:06:01.90,Default,,0,0,0,,
Dialogue: 0,0:06:02.57,0:06:03.40,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:04.53,0:06:06.78,Default,,0,0,0,,Баки, жүгір!
Dialogue: 0,0:06:10.07,0:06:11.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:13.74,0:06:14.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:18.37,0:06:19.79,Default,,0,0,0,,Сіз не істеп жатырсыз? Сіз
Dialogue: 0,0:06:19.87,0:06:22.00,Default,,0,0,0,,Не болып жатыр? Бұл не?
Dialogue: 0,0:06:22.09,0:06:22.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:23.46,0:06:27.42,Default,,0,0,0,,Бұл тесік! Бұл тесік! Жер бос болды ма?
Dialogue: 0,0:06:27.55,0:06:29.93,Default,,0,0,0,,Сіз роликтерді пайдаланасыз ба? жеңіл атлетика клубы
Dialogue: 0,0:06:30.80,0:06:32.97,Default,,0,0,0,,Бұл аңыздың басы болды
Dialogue: 0,0:06:37.18,0:06:38.02,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:40.81,0:06:42.11,Default,,0,0,0,,Жоғары! Жоғары!
Dialogue: 0,0:06:42.27,0:06:43.98,Default,,0,0,0,,Бұл бір соққы емес пе?
Dialogue: 0,0:06:44.61,0:06:46.28,Default,,0,0,0,,Жоғары
Dialogue: 0,0:06:46.44,0:06:48.49,Default,,0,0,0,,Жоғалып кететін сияқты
Dialogue: 0,0:06:53.70,0:06:55.49,Default,,0,0,0,,21 метр
Dialogue: 0,0:06:55.58,0:06:58.00,Default,,0,0,0,,Жоқ, бұл Ван Бэнг!
Dialogue: 0,0:06:58.08,0:06:59.75,Default,,0,0,0,,Ең төменгі рекорд!
Dialogue: 0,0:07:01.83,0:07:03.71,Default,,0,0,0,,Тоқта, не істеуіміз керек?
Dialogue: 0,0:07:03.79,0:07:06.75,Default,,0,0,0,,Ұзындыққа секіру болса да! Секірейік
Dialogue: 0,0:07:07.17,0:07:08.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:08.17,0:07:09.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:13.93,0:07:15.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:16.68,0:07:18.85,Default,,0,0,0,,Бұдан басқа не істеуім керек?
Dialogue: 0,0:07:19.06,0:07:22.23,Default,,0,0,0,,Құм жәшігіне кірмесеңіз, оны өлшей алмайсыз!
Dialogue: 0,0:07:22.52,0:07:24.77,Default,,0,0,0,,Бірақ бұл таңқаларлық емес пе?
Dialogue: 0,0:07:24.90,0:07:25.94,Default,,0,0,0,,Мен мұны айта аламын
Dialogue: 0,0:07:26.11,0:07:29.15,Default,,0,0,0,,Құм жәшігінен жүгірусіз секіру қалыпты жағдай ма?
Dialogue: 0,0:07:29.86,0:07:31.78,Default,,0,0,0,,Uh... ah!
Dialogue: 0,0:07:32.16,0:07:33.20,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:33.28,0:07:34.16,Default,,0,0,0,,Иә келесі!
Dialogue: 0,0:07:34.53,0:07:37.91,Default,,0,0,0,,15 тамаша ұпай бұл жігіттер үшін өте қорқынышты.
Dialogue: 0,0:07:38.54,0:07:40.16,Default,,0,0,0,,Сіз мұны істей аласыз ба? 15 рет
Dialogue: 0,0:07:40.33,0:07:42.08,Default,,0,0,0,,Соған ұқсайды ма?
Dialogue: 0,0:07:42.21,0:07:43.71,Default,,0,0,0,,Сіз мұны жасадыңыз ба? ол
Dialogue: 0,0:07:44.04,0:07:46.50,Default,,0,0,0,,Сонымен, солай көрінеді!
Dialogue: 0,0:07:46.59,0:07:47.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:47.96,0:07:50.26,Default,,0,0,0,,Рұқсатсыз түстің, Бақи.
Dialogue: 0,0:07:50.76,0:07:53.43,Default,,0,0,0,,Мен мұны 15 рет жасадым.
Dialogue: 0,0:07:53.93,0:07:54.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:55.68,0:07:58.18,Default,,0,0,0,,Кім санады? сіздің тартуларыңыз
Dialogue: 0,0:07:58.51,0:08:00.73,Default,,0,0,0,,Жоқ, кім...
Dialogue: 0,0:08:01.68,0:08:03.31,Default,,0,0,0,,Көрдіңіз бе? Балалар сендер
Dialogue: 0,0:08:03.39,0:08:05.65,Default,,0,0,0,,Жоқ, ілулі тұрған.
Dialogue: 0,0:08:05.73,0:08:08.40,Default,,0,0,0,,Оны 15 рет қайталауға қалай болады?
Dialogue: 0,0:08:08.73,0:08:10.69,Default,,0,0,0,,Қараңыз! Қайтадан байқап көріңіз!
Dialogue: 0,0:08:18.28,0:08:19.24,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:21.37,0:08:23.33,Default,,0,0,0,,(темір тордың сықырлаған дыбысы)
Dialogue: 0,0:08:24.58,0:08:26.17,Default,,0,0,0,,
Dialogue: 0,0:08:26.88,0:08:27.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:33.30,0:08:35.43,Default,,0,0,0,,Бұл туралы уайымдамаңыз~
Dialogue: 0,0:08:35.84,0:08:37.68,Default,,0,0,0,,Сіз қандайсыз!
Dialogue: 0,0:08:37.76,0:08:41.93,Default,,0,0,0,,Темір торларды сындырамын, құмсалғышты кесемін, жерді қазып аламын.
Dialogue: 0,0:08:42.27,0:08:45.35,Default,,0,0,0,,Тіпті бір нәрсе дұрыс орындалмады.
Dialogue: 0,0:08:46.56,0:08:50.40,Default,,0,0,0,,Бақидың дене күшін әлі өлшеу мүмкін емес
Dialogue: 0,0:08:51.57,0:08:53.86,Default,,0,0,0,,Толықтай стандартқа сай емес
Dialogue: 0,0:08:55.36,0:08:57.95,Default,,0,0,0,,Келесі 1500 метр
Dialogue: 0,0:08:58.91,0:09:00.54,Default,,0,0,0,,Мен сенің ойыңды жаралаймын!
Dialogue: 0,0:09:07.00,0:09:07.88,Default,,0,0,0,,Ханма
Dialogue: 0,0:09:10.63,0:09:13.38,Default,,0,0,0,,Осылай жалғастырсаңыз, алға жылжи алмайсыз.
Dialogue: 0,0:09:14.13,0:09:15.47,Default,,0,0,0,,Біз не істеуіміз керек? Сіз
Dialogue: 0,0:09:15.55,0:09:16.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:16.68,0:09:20.10,Default,,0,0,0,,Хахаха сен ақымақсың.
Dialogue: 0,0:09:21.81,0:09:22.64,Default,,0,0,0,,Ум...
Dialogue: 0,0:09:23.02,0:09:23.85,Default,,0,0,0,,​​О?
Dialogue: 0,0:09:25.23,0:09:28.40,Default,,0,0,0,,1500 метрге жеткен әлемдік рекорд қандай?
Dialogue: 0,0:09:28.65,0:09:30.40,Default,,0,0,0,,О~
Dialogue: 0,0:09:30.94,0:09:32.48,Default,,0,0,0,,Үзіліс!
Dialogue: 0,0:09:32.61,0:09:34.07,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:09:34.15,0:09:36.40,Default,,0,0,0,,Мұны естігенде не істейсің?
Dialogue: 0,0:09:37.24,0:09:38.45,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:09:41.53,0:09:44.37,Default,,0,0,0,,3 минут 26 секунд Байқағыңыз келе ме?
Dialogue: 0,0:09:44.45,0:09:47.16,Default,,0,0,0,,Жоқ! Тамаша, тамаша!
Dialogue: 0,0:09:47.87,0:09:50.54,Default,,0,0,0,,Мен бұл рекордты жаңартамын
Dialogue: 0,0:09:50.96,0:09:54.17,Default,,0,0,0,,Маған барлық оқиғаларды өткізуге рұқсат бере аласыз ба?
Dialogue: 0,0:09:54.34,0:09:56.17,Default,,0,0,0,,О~
Dialogue: 0,0:09:56.34,0:09:57.68,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:05.02,0:10:08.94,Default,,0,0,0,,Мен сізге барлық пәндерден ғана емес, барлық пәндерден толық баға беремін.
Dialogue: 0,0:10:09.40,0:10:10.94,Default,,0,0,0,,Құттықтаймыз Баки
Dialogue: 0,0:10:11.02,0:10:12.44,Default,,0,0,0,,Мен де тырысамын
Dialogue: 0,0:10:13.73,0:10:16.53,Default,,0,0,0,,Жарайды, басында сапқа тұр.
Dialogue: 0,0:10:16.65,0:10:18.45,Default,,0,0,0,,3 минут 26 секунд
Dialogue: 0,0:10:18.86,0:10:20.95,Default,,0,0,0,,Хаа... Жақсы.
Dialogue: 0,0:10:26.79,0:10:27.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:28.16,0:10:30.46,Default,,0,0,0,,О... Эй (Бала) Ой?
Dialogue: 0,0:10:33.29,0:10:34.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:35.17,0:10:36.92,Default,,0,0,0,,Бұлшық еттердің қандай түріне жатады?
Dialogue: 0,0:10:37.30,0:10:39.22,Default,,0,0,0,,Сіз дәрі қабылдайсыз ба?
Dialogue: 0,0:10:40.22,0:10:41.22,Default,,0,0,0,,О~
Dialogue: 0,0:10:47.60,0:10:50.98,Default,,0,0,0,,8 7 6 5…
Dialogue: 0,0:10:51.65,0:10:55.48,Default,,0,0,0,,4 3 2 1!
Dialogue: 0,0:10:56.11,0:10:57.61,Default,,0,0,0,,(дыбыстық сигнал)
Dialogue: 0,0:11:00.91,0:11:01.86,Default,,0,0,0,,Куха
Dialogue: 0,0:11:10.71,0:11:13.71,Default,,0,0,0,,Иә? Мен бір айналымды қате санадым ба?
Dialogue: 0,0:11:14.71,0:11:17.71,Default,,0,0,0,,Бұл 400 әлемдік рекордқа тең емес пе?
Dialogue: 0,0:11:25.26,0:11:28.52,Default,,0,0,0,,Егер... қателеспесем
Dialogue: 0,0:11:29.43,0:11:30.68,Default,,0,0,0,,Бұл жазба...
Dialogue: 0,0:11:32.60,0:11:35.31,Default,,0,0,0,,800 әлемдік рекордты жаңарту!
Dialogue: 0,0:11:39.03,0:11:39.86,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:40.65,0:11:42.41,Default,,0,0,0,,Менің бұлшық еттерім қызып барады.
Dialogue: 0,0:11:44.82,0:11:47.03,Default,,0,0,0,,Жылдамдық артып жатыр ма?
Dialogue: 0,0:11:49.91,0:11:53.79,Default,,0,0,0,,Бұл 1000 метрден жоғары болды
Dialogue: 0,0:11:54.38,0:11:56.13,Default,,0,0,0,,Куу... Кууу
Dialogue: 0,0:12:00.38,0:12:01.63,Default,,0,0,0,,Бұлшықет спазмы?
Dialogue: 0,0:12:02.30,0:12:03.55,Default,,0,0,0,,Жылдам емес
Dialogue: 0,0:12:04.09,0:12:08.26,Default,,0,0,0,,Күшті болу үшін күндіз-түні жол жұмыстарын жүргізетін бала.
Dialogue: 0,0:12:09.31,0:12:12.73,Default,,0,0,0,,Жүкті елестету кезінде үнемі жүгіру әдеті
Dialogue: 0,0:12:12.81,0:12:14.77,Default,,0,0,0,,Соңында бұлшық еттерге басылады
Dialogue: 0,0:12:15.98,0:12:19.73,Default,,0,0,0,,Бүгін Бақи бұлшық еттерін елестеткен...
Dialogue: 0,0:12:26.99,0:12:28.28,Default,,0,0,0,,Бұл болды!
Dialogue: 0,0:12:31.58,0:12:33.79,Default,,0,0,0,,Гол (Ұлдар) Баки Донкецу!
Dialogue: 0,0:12:34.83,0:12:37.29,Default,,0,0,0,,Жарайды, тарата аласыз.
Dialogue: 0,0:12:37.75,0:12:39.34,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:12:39.42,0:12:41.80,Default,,0,0,0,,Бірінші тайм Сіз тым алыс өттіңіз.
Dialogue: 0,0:12:42.05,0:12:43.30,Default,,0,0,0,,Баки сәтсіз аяқталды!
Dialogue: 0,0:12:44.51,0:12:46.97,Default,,0,0,0,,Жоқ, мен өттім.
Dialogue: 0,0:12:47.47,0:12:50.31,Default,,0,0,0,,Мен жалғыз қалдым ба?
Dialogue: 0,0:12:50.89,0:12:53.31,Default,,0,0,0,,Менің күшім жоқ шығар.
Dialogue: 0,0:12:55.39,0:12:58.23,Default,,0,0,0,,(ит есінейді)
Dialogue: 0,0:13:01.82,0:13:03.15,Default,,0,0,0,,Аму
Dialogue: 0,0:13:12.45,0:13:14.54,Default,,0,0,0,,(Бір уақытта ішу дыбысы)
Dialogue: 0,0:13:14.62,0:13:16.33,Default,,0,0,0,,Дұрыс тамақтаныңыз
Dialogue: 0,0:13:16.96,0:13:17.83,Default,,0,0,0,,Гуха~
Dialogue: 0,0:13:18.25,0:13:22.00,Default,,0,0,0,,Тәбетінің ерекше болуымен қатар, ол өзін гурман деп те атайды.
Dialogue: 0,0:13:22.09,0:13:23.55,Default,,0,0,0,,Бұл ақша тұрады.
Dialogue: 0,0:13:26.09,0:13:27.34,Default,,0,0,0,,Кәсіби күрес әлеміндегі харизма
Dialogue: 0,0:13:28.47,0:13:33.18,Default,,0,0,0,,Ол ең мықты турнирдің үшінші раундында Бакимен кездесті, бірақ жеңілді.
Dialogue: 0,0:13:34.23,0:13:37.10,Default,,0,0,0,,Сенде жақсы ойыншық бар, Игари.
Dialogue: 0,0:13:37.60,0:13:39.61,Default,,0,0,0,,Сізде темекі бар ма? Төраға
Dialogue: 0,0:13:40.31,0:13:41.27,Default,,0,0,0,,Сора
Dialogue: 0,0:13:48.45,0:13:49.87,Default,,0,0,0,,Бірінші! О!
Dialogue: 0,0:13:50.49,0:13:54.37,Default,,0,0,0,,Бұрынғы әлемнің бірінші нөмірі дзюдошы үшін сіз этикетті білмейсіз.
Dialogue: 0,0:13:54.66,0:13:56.08,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:13:56.16,0:13:58.42,Default,,0,0,0,,Жастар тәкаппар
Dialogue: 0,0:13:58.50,0:14:00.83,Default,,0,0,0,,Күш – тәкаппарлық
Dialogue: 0,0:14:01.75,0:14:04.34,Default,,0,0,0,,Жоғалтып, шаң басқан күнге дейін...
Dialogue: 0,0:14:04.42,0:14:05.38,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:14:06.05,0:14:07.88,Default,,0,0,0,,Ойын қашан болады? Қарт адам
Dialogue: 0,0:14:08.43,0:14:11.39,Default,,0,0,0,,Мұны қашан орындағыңыз келеді? Татеока мырза
Dialogue: 0,0:14:12.01,0:14:17.35,Default,,0,0,0,,Егер менде сақина, қаламақы және серіктес болса, мен оны кез келген уақытта жасаймын.
Dialogue: 0,0:14:17.56,0:14:19.23,Default,,0,0,0,,Тіпті осында және қазір
Dialogue: 0,0:14:19.81,0:14:22.40,Default,,0,0,0,,Сізге тек Йо-Идонмен араласу жеткілікті.
Dialogue: 0,0:14:22.77,0:14:26.90,Default,,0,0,0,,Менің орнымда матч үшін сыйлық жоқ екенін білуіңіз керек.
Dialogue: 0,0:14:27.44,0:14:30.61,Default,,0,0,0,,Сіз ойнаған турнир әйгілі.
Dialogue: 0,0:14:30.99,0:14:34.99,Default,,0,0,0,,Енді сол жертөледе сіріңкенің болуы - мәртебе.
Dialogue: 0,0:14:35.24,0:14:37.41,Default,,0,0,0,,Төлем кейінірек келеді.
Dialogue: 0,0:14:38.21,0:14:41.17,Default,,0,0,0,,Әуесқойлар өте көп.
Dialogue: 0,0:14:41.67,0:14:44.34,Default,,0,0,0,,Бұл «Игари-изм», дұрыс па?
Dialogue: 0,0:14:44.55,0:14:45.67,Default,,0,0,0,,Сәлем, төраға.
Dialogue: 0,0:14:46.84,0:14:47.67,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:54.22,0:14:55.68,Default,,0,0,0,,Бұл Йо-Идон.
Dialogue: 0,0:14:57.77,0:14:58.93,Default,,0,0,0,,Қызық!
Dialogue: 0,0:14:59.31,0:15:00.14,Default,,0,0,0,,Нһ!
Dialogue: 0,0:15:01.35,0:15:02.19,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:05.36,0:15:06.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:06.36,0:15:07.19,Default,,0,0,0,,О...
Dialogue: 0,0:15:08.07,0:15:09.45,Default,,0,0,0,,Иә! Ха...
Dialogue: 0,0:15:09.57,0:15:10.57,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:12.36,0:15:13.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:16.12,0:15:17.45,Default,,0,0,0,,Уау! (Токугава) Жоқ!
Dialogue: 0,0:15:27.42,0:15:32.22,Default,,0,0,0,,Тек Йо-Идонда жүгіре алатындарды жекпе-жек шеберлері деп атауға болмайды.
Dialogue: 0,0:15:32.51,0:15:37.01,Default,,0,0,0,,Аты айтып тұрғандай, матч репетициядан басқа ештеңе емес.
Dialogue: 0,0:15:37.72,0:15:40.27,Default,,0,0,0,,Репетиция - қанша рет сынап көрсең де репетиция.
Dialogue: 0,0:15:41.35,0:15:42.65,Default,,0,0,0,,Өндірісте жоқ
Dialogue: 0,0:15:43.73,0:15:44.77,Default,,0,0,0,,Кю Жедел жәрдем!
Dialogue: 0,0:15:45.36,0:15:46.77,Default,,0,0,0,,Барлығы осында.
Dialogue: 0,0:15:47.36,0:15:49.28,Default,,0,0,0,,Сіз Сикорскийсіз.
Dialogue: 0,0:15:49.99,0:15:52.28,Default,,0,0,0,,Орын ауыстырып, сөйлесейік пе?
Dialogue: 0,0:15:53.24,0:15:54.87,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:15:56.45,0:15:58.29,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:15:58.37,0:15:59.79,Default,,0,0,0,,Бұл ауыр, абай болыңыз.
Dialogue: 0,0:16:01.16,0:16:02.04,Default,,0,0,0,,Бұл алғаш рет.
Dialogue: 0,0:16:07.38,0:16:08.42,Default,,0,0,0,,Хмм!
Dialogue: 0,0:16:10.01,0:16:11.01,Default,,0,0,0,,Ах (Сикорский) О~
Dialogue: 0,0:16:11.47,0:16:13.93,Default,,0,0,0,,Вахаха, бұл тамаша соққы.
Dialogue: 0,0:16:14.47,0:16:16.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:16.35,0:16:17.18,Default,,0,0,0,,Жоғары…
Dialogue: 0,0:16:18.39,0:16:19.22,Default,,0,0,0,,Хаа~
Dialogue: 0,0:16:20.31,0:16:22.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:22.48,0:16:25.60,Default,,0,0,0,,А, анау қызметші...
Dialogue: 0,0:16:25.90,0:16:27.19,Default,,0,0,0,,Қызметші
Dialogue: 0,0:16:27.27,0:16:28.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:28.40,0:16:29.65,Default,,0,0,0,,О, ә?
Dialogue: 0,0:16:30.36,0:16:31.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:32.65,0:16:34.28,Default,,0,0,0,,Шикорус…
Dialogue: 0,0:16:34.70,0:16:37.87,Default,,0,0,0,,Бүгін маған не істегеніңді ешқашан ұмытпа...
Dialogue: 0,0:16:38.03,0:16:38.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:41.50,0:16:43.37,Default,,0,0,0,,Уау~
Dialogue: 0,0:16:51.13,0:16:52.01,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:52.42,0:16:53.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:01.89,0:17:04.81,Default,,0,0,0,,Сәлем, штаб! Полицияға хабарласыңыз
Dialogue: 0,0:17:05.31,0:17:06.60,Default,,0,0,0,,О...
Dialogue: 0,0:17:08.40,0:17:11.36,Default,,0,0,0,,Аудитория жоқ, гонг жоқ
Dialogue: 0,0:17:11.44,0:17:13.82,Default,,0,0,0,,Кәсіби балуандар нәзік болады.
Dialogue: 0,0:17:20.12,0:17:23.08,Default,,0,0,0,,Хехе, маған айтылмаған жерге дейін.
Dialogue: 0,0:17:23.75,0:17:25.66,Default,,0,0,0,,Менде жақсы сезім бар
Dialogue: 0,0:17:29.38,0:17:32.17,Default,,0,0,0,,Ешқандай спецификация жоқ... Қайтадан ерекшеліктер жоқ!
Dialogue: 0,0:17:33.55,0:17:35.72,Default,,0,0,0,,Жер бетінде қалай?
Dialogue: 0,0:17:40.51,0:17:43.39,Default,,0,0,0,,Уау... Мм...
Dialogue: 0,0:17:43.52,0:17:44.68,Default,,0,0,0,,Иіс сезбе
Dialogue: 0,0:17:45.35,0:17:48.19,Default,,0,0,0,,Бұл әлі кеуіп үлгермеген қанның иісі.
Dialogue: 0,0:17:49.02,0:17:53.19,Default,,0,0,0,,Токугаваның қаны бірнеше күн бұрынғы ұрықтың қозғалысын үйретеді
Dialogue: 0,0:17:53.28,0:17:56.20,Default,,0,0,0,,Жауап бүгін түнде болуы керек.
Dialogue: 0,0:17:56.95,0:18:00.70,Default,,0,0,0,,Күшті адам іздесең... Мықты адам іздесең, бұл жер ғана.
Dialogue: 0,0:18:00.82,0:18:02.45,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:02.87,0:18:03.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:03.95,0:18:07.71,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:08.50,0:18:09.71,Default,,0,0,0,,О!
Dialogue: 0,0:18:11.92,0:18:16.22,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:16.59,0:18:18.22,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:18:21.47,0:18:22.30,Default,,0,0,0,,Иә
Dialogue: 0,0:18:24.22,0:18:25.35,Default,,0,0,0,,Фуфу~н
Dialogue: 0,0:18:30.44,0:18:31.73,Default,,0,0,0,,Сіз қоңырау шалдыңыз ба?
Dialogue: 0,0:18:32.23,0:18:34.48,Default,,0,0,0,,Жоқ, бұл бүркіт емес.
Dialogue: 0,0:18:34.61,0:18:35.94,Default,,0,0,0,,Оларды кім шақырды
Dialogue: 0,0:18:36.03,0:18:39.74,Default,,0,0,0,,Осы алаңның топырағына сіңген қанның көп мөлшері.
Dialogue: 0,0:18:40.32,0:18:42.66,Default,,0,0,0,,Олардың қаны!
Dialogue: 0,0:18:56.55,0:18:58.42,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:18:59.22,0:19:01.76,Default,,0,0,0,,Мен сізге бірден сұрақ қойғым келеді.
Dialogue: 0,0:19:06.43,0:19:08.27,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:19:08.73,0:19:12.52,Default,,0,0,0,,Бұл сұрақты... бізге қойыңыз?
Dialogue: 0,0:19:12.69,0:19:16.28,Default,,0,0,0,,Дегенмен, мен үшін бұл төрт адам бірінші рет кездесті.
Dialogue: 0,0:19:16.82,0:19:19.15,Default,,0,0,0,,Қайдан сұрауға құқығыңыз бар?
Dialogue: 0,0:19:19.95,0:19:23.16,Default,,0,0,0,,Бұл колизей маған тиесілі.
Dialogue: 0,0:19:23.57,0:19:27.16,Default,,0,0,0,,Сонда біз шекара бұзушылармыз.
Dialogue: 0,0:19:27.54,0:19:30.41,Default,,0,0,0,,Мен сұраққа жауап беруім керек деп ойлаймын.
Dialogue: 0,0:19:30.87,0:19:32.92,Default,,0,0,0,,Маған хабарлаңыз.
Dialogue: 0,0:19:33.25,0:19:37.92,Default,,0,0,0,,Сіз мені осында әкелдіңіз, дәлірек айтсақ, мен сіздің шақыруыңызды қабылдадым.
Dialogue: 0,0:19:38.38,0:19:42.09,Default,,0,0,0,,Емдейтін жерді іздеуді жалғастыра бергеннен кейін мен оны таптым ...
Dialogue: 0,0:19:42.30,0:19:44.43,Default,,0,0,0,,Мен айта аламын
Dialogue: 0,0:19:44.72,0:19:49.43,Default,,0,0,0,,Иіс... мүмкін? Мұндағы иіс қызықтырады
Dialogue: 0,0:19:49.77,0:19:53.94,Default,,0,0,0,,Бұл жерді Жапонияда тұратын кез келген адам біледі.
Dialogue: 0,0:19:54.69,0:19:57.77,Default,,0,0,0,,Конкурсқа қатысушы емес Мононофумен кездесу
Dialogue: 0,0:19:58.07,0:19:59.61,Default,,0,0,0,,Қалауымша...
Dialogue: 0,0:20:00.32,0:20:01.78,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:01.86,0:20:05.37,Default,,0,0,0,,Балалар сендерде шынымен керемет жасушалар бар.
Dialogue: 0,0:20:05.45,0:20:08.83,Default,,0,0,0,,Жеңілісті марапат ретінде берейік
Dialogue: 0,0:20:09.62,0:20:11.58,Default,,0,0,0,,Ихихихихи (Токугава) Ух...
Dialogue: 0,0:20:12.33,0:20:14.67,Default,,0,0,0,,Маған сыйлық берсең де
Dialogue: 0,0:20:14.75,0:20:17.71,Default,,0,0,0,,Мұнда тамаша адамдар көп.
Dialogue: 0,0:20:20.42,0:20:22.22,Default,,0,0,0,,О~ Эй, эй...
Dialogue: 0,0:20:27.26,0:20:28.85,Default,,0,0,0,,А... Тоқта!
Dialogue: 0,0:20:29.47,0:20:31.06,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:31.56,0:20:32.60,Default,,0,0,0,,Джикча~н
Dialogue: 0,0:20:32.73,0:20:33.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.90,0:20:36.10,Default,,0,0,0,,Баки!
Dialogue: 0,0:20:38.02,0:20:42.19,Default,,0,0,0,,Ум, тапсырманы ерте бітіре аласыз ба?
Dialogue: 0,0:20:42.36,0:20:43.86,Default,,0,0,0,,Менде ертең сабақ бар.
Dialogue: 0,0:20:45.03,0:20:45.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:46.53,0:20:47.37,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:20:47.45,0:20:48.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:50.58,0:20:52.00,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:20:52.08,0:20:55.12,Default,,0,0,0,,Сол жерге тапсырма жіберіңіз.
Dialogue: 0,0:20:55.83,0:20:56.88,Default,,0,0,0,,Жалғыз!
Dialogue: 0,0:20:57.75,0:20:59.38,Default,,0,0,0,,Мен оларды бәрібір жинадым.
Dialogue: 0,0:21:00.59,0:21:01.88,Default,,0,0,0,,Тал!
Dialogue: 0,0:21:10.01,0:21:16.02,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:33.06,0:22:39.06,Default,,0,0,0,,~♪
