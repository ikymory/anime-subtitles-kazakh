Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,‎NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.51,0:00:17.51,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:42.31,0:01:44.35,Default,,0,0,0,,‎Бұл жақсы!
Dialogue: 0,0:01:44.47,0:01:46.18,Default,,0,0,0,,‎(Таварая) Оооо~
Dialogue: 0,0:01:46.48,0:01:48.94,Default,,0,0,0,,Сәлем, Сонода.
Dialogue: 0,0:01:49.19,0:01:53.78,Default,,0,0,0,,‎Егер сіз бәрін жеңсеңіз, Қара белбеуді ұтасыз!
Dialogue: 0,0:01:53.94,0:01:56.82,Default,,0,0,0,,‎Ке~ Ах!
Dialogue: 0,0:01:57.49,0:01:59.41,Default,,0,0,0,,‎(Таварая) Бір қол!
Dialogue: 0,0:02:00.16,0:02:03.20,Default,,0,0,0,,‎(Ойыншы) Уф (ойыншы) бір қолмен 130км...
Dialogue: 0,0:02:03.37,0:02:04.95,Default,,0,0,0,,‎Ниу~!
Dialogue: 0,0:02:07.58,0:02:08.46,Default,,0,0,0,,Тая! (Таварая) Уф
Dialogue: 0,0:02:12.59,0:02:13.42,Default,,0,0,0,,‎Фу~
Dialogue: 0,0:02:14.38,0:02:15.96,Default,,0,0,0,,‎(Таварая) Ооо, аа...
Dialogue: 0,0:02:16.09,0:02:18.22,Default,,0,0,0,,‎
Dialogue: 0,0:02:18.38,0:02:20.22,Default,,0,0,0,,Сәлем, Сонода!
Dialogue: 0,0:02:20.55,0:02:22.72,Default,,0,0,0,,Бұл керемет туынды болды, солай емес пе?
Dialogue: 0,0:02:23.43,0:02:24.93,Default,,0,0,0,,‎(Сонода) Уф...
Dialogue: 0,0:02:25.06,0:02:28.39,Default,,0,0,0,,Жоқ! Енді біреу ғана емес!
Dialogue: 0,0:02:28.52,0:02:30.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:30.65,0:02:34.98,Default,,0,0,0,,‎Эй, сен сенімдісің бе? «Бұл бір кітап емес»...
Dialogue: 0,0:02:35.44,0:02:39.99,Default,,0,0,0,,‎Қолыңызды жіберген кезде сіз басқа адамды басқаруды жоғалттыңыз.
Dialogue: 0,0:02:40.41,0:02:44.37,Default,,0,0,0,,‎Сонымен қатар, дзюдоның арқадан құлау принципі!
Dialogue: 0,0:02:44.91,0:02:45.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:48.71,0:02:50.33,Default,,0,0,0,,Мен түсіндім...
Dialogue: 0,0:02:51.25,0:02:54.42,Default,,0,0,0,,мырза. Тағы да Таварая!
Dialogue: 0,0:02:54.54,0:02:55.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:55.55,0:02:57.71,Default,,0,0,0,,‎Ах...
Dialogue: 0,0:02:58.30,0:03:01.18,Default,,0,0,0,,‎(Ойыншы) Сақтығыңызды төмендетпеңіз! (Ойыншы) Ауырлық центріңізді төмендетіңіз!
Dialogue: 0,0:03:01.72,0:03:04.01,Default,,0,0,0,,‎Фуу…
Dialogue: 0,0:03:05.68,0:03:06.51,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:03:08.02,0:03:10.31,Default,,0,0,0,,Уф Сейя!
Dialogue: 0,0:03:11.39,0:03:12.48,Default,,0,0,0,,Ух...
Dialogue: 0,0:03:22.32,0:03:26.03,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:03:26.49,0:03:27.79,Default,,0,0,0,,‎(Таварая) Уау!
Dialogue: 0,0:03:30.04,0:03:31.66,Default,,0,0,0,,‎
Dialogue: 0,0:03:31.96,0:03:33.17,Default,,0,0,0,,А...
Dialogue: 0,0:03:35.75,0:03:36.92,Default,,0,0,0,,‎Hehehe
Dialogue: 0,0:03:39.30,0:03:41.34,Default,,0,0,0,,Бір...
Dialogue: 0,0:03:41.55,0:03:43.68,Default,,0,0,0,,‎Хмф хехехе
Dialogue: 0,0:03:44.47,0:03:45.35,Default,,0,0,0,,‎(Ойыншы) Уф...
Dialogue: 0,0:03:45.97,0:03:47.64,Default,,0,0,0,,‎Хмм.
Dialogue: 0,0:03:48.14,0:03:49.31,Default,,0,0,0,,‎(Сонода) Басталуы!
Dialogue: 0,0:03:49.68,0:03:50.60,Default,,0,0,0,,‎(Ойыншы) Сәлем!
Dialogue: 0,0:03:52.85,0:03:53.98,Default,,0,0,0,,‎Хохо…
Dialogue: 0,0:03:57.02,0:03:58.19,Default,,0,0,0,,Тыш! (Ойыншы) Уау
Dialogue: 0,0:04:02.40,0:04:03.82,Default,,0,0,0,,‎(Сонода) Келесі!
Dialogue: 0,0:04:03.95,0:04:05.32,Default,,0,0,0,,‎(Сонода) Келесі!
Dialogue: 0,0:04:05.45,0:04:07.37,Default,,0,0,0,,‎(‎Шибукава‎) Haa~
Dialogue: 0,0:04:07.49,0:04:08.33,Default,,0,0,0,,‎(Сонода) Келесі!
Dialogue: 0,0:04:08.45,0:04:09.29,Default,,0,0,0,,‎(ойыншы) бұл...
Dialogue: 0,0:04:09.41,0:04:11.16,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:04:11.45,0:04:17.17,Default,,0,0,0,,Иә, Сонода мырза, маған кем дегенде қара белбеу беріңізші.
Dialogue: 0,0:04:17.84,0:04:18.67,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:20.38,0:04:23.17,Default,,0,0,0,,‎(Ойыншы) Ух... Эй, Сонода.
Dialogue: 0,0:04:24.63,0:04:26.22,Default,,0,0,0,,Уау! (Ойыншы) Ух...
Dialogue: 0,0:04:27.43,0:04:28.26,Default,,0,0,0,,А...
Dialogue: 0,0:04:29.39,0:04:33.56,Default,,0,0,0,,‎ Қара белбеу алу үшін қанша адам лақтыруым керек?
Dialogue: 0,0:04:34.02,0:04:36.31,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,0:04:36.44,0:04:38.11,Default,,0,0,0,,‎Маған берсең де
Dialogue: 0,0:04:39.07,0:04:40.86,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:04:41.40,0:04:43.15,Default,,0,0,0,,‎Хмм~ Ах!
Dialogue: 0,0:04:43.57,0:04:45.91,Default,,0,0,0,,‎Уау~ Ой...
Dialogue: 0,0:04:48.57,0:04:49.41,Default,,0,0,0,,Ух...
Dialogue: 0,0:04:49.78,0:04:52.04,Default,,0,0,0,,‎Сен қалай ойлайсың, Сонода?
Dialogue: 0,0:04:52.16,0:04:55.67,Default,,0,0,0,,Әрі қарай жалғастырудың қажеті жоқ деп ойлаймын?
Dialogue: 0,0:04:58.08,0:05:00.17,Default,,0,0,0,,‎Ni ni hi
Dialogue: 0,0:05:03.26,0:05:06.80,Default,,0,0,0,,‎Аа... ақымақтар!
Dialogue: 0,0:05:08.14,0:05:09.30,Default,,0,0,0,,‎(Шибукава) Сәлем!
Dialogue: 0,0:05:10.81,0:05:13.31,Default,,0,0,0,,Мен келесісін күтемін.
Dialogue: 0,0:05:13.93,0:05:15.27,Default,,0,0,0,,‎(Ойыншы) Шибукава Сенсей?
Dialogue: 0,0:05:16.06,0:05:17.48,Default,,0,0,0,,‎(Ойыншылар) О!
Dialogue: 0,0:05:18.02,0:05:19.06,Default,,0,0,0,,‎(Ойыншы) Мотивацияңыз бар ма?
Dialogue: 0,0:05:20.36,0:05:21.57,Default,,0,0,0,,‎Hehehehe
Dialogue: 0,0:05:22.15,0:05:23.94,Default,,0,0,0,,‎Сен киіміңді қашан ауыстырдың?
Dialogue: 0,0:05:24.24,0:05:28.32,Default,,0,0,0,,‎Мен жаңа ғана хакамамды шешіп алдым ха ха ха ха ха ха
Dialogue: 0,0:05:28.78,0:05:29.78,Default,,0,0,0,,А...
Dialogue: 0,0:05:32.12,0:05:34.41,Default,,0,0,0,,Сіз дзюдомен айналысып көрдіңіз бе?
Dialogue: 0,0:05:34.66,0:05:37.12,Default,,0,0,0,,(Шибукава) Ваша бастапқыда сол жерден шыққан.
Dialogue: 0,0:05:37.54,0:05:40.13,Default,,0,0,0,,Бұл соғысқа дейінгі оқиға.
Dialogue: 0,0:05:40.50,0:05:43.17,Default,,0,0,0,,‎Мм… Ммм.
Dialogue: 0,0:05:43.63,0:05:45.67,Default,,0,0,0,,Рақмет саған Джи-сан!
Dialogue: 0,0:05:46.13,0:05:48.26,Default,,0,0,0,,Бұл тамаша даму.
Dialogue: 0,0:05:48.63,0:05:49.93,Default,,0,0,0,,А...
Dialogue: 0,0:05:59.73,0:06:01.81,Default,,0,0,0,,Оны алу оңай емес, солай ма?
Dialogue: 0,0:06:05.57,0:06:07.15,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:06:14.12,0:06:16.00,Default,,0,0,0,,‎
Dialogue: 0,0:06:16.29,0:06:17.75,Default,,0,0,0,,‎(Ойыншы) Керемет! (Сонода) Ах...
Dialogue: 0,0:06:18.50,0:06:19.33,Default,,0,0,0,,‎Tch…
Dialogue: 0,0:06:22.71,0:06:26.26,Default,,0,0,0,,‎Сонода! Қара белбеуден бас тартты
Dialogue: 0,0:06:26.51,0:06:27.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:30.80,0:06:32.51,Default,,0,0,0,,Неге кенеттен тағы?
Dialogue: 0,0:06:33.35,0:06:34.47,Default,,0,0,0,,Қарау
Dialogue: 0,0:06:34.76,0:06:38.52,Default,,0,0,0,,‎
Dialogue: 0,0:06:39.27,0:06:41.81,Default,,0,0,0,,Мен тізімнен шығарылдым.
Dialogue: 0,0:06:45.78,0:06:46.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:49.74,0:06:51.03,Default,,0,0,0,,‎Na…
Dialogue: 0,0:06:51.53,0:06:52.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.53,0:06:57.29,Default,,0,0,0,,Алыңыз! Гоки Шибукава мақұлдаған
Dialogue: 0,0:07:09.97,0:07:11.34,Default,,0,0,0,,‎(қозу) Хуо~ Каа!
Dialogue: 0,0:07:29.40,0:07:32.66,Default,,0,0,0,,Slashing Karate Ho-ryu қолданушысы
Dialogue: 0,0:07:33.78,0:07:35.37,Default,,0,0,0,,‎Жер астындағы аренадағы жауынгер
Dialogue: 0,0:07:36.24,0:07:40.29,Default,,0,0,0,,Нервтерді кесу үшін «жіпті кесу» әдісін қолданыңыз
Dialogue: 0,0:07:40.83,0:07:42.54,Default,,0,0,0,,‎(Студент) Ууууууу...
Dialogue: 0,0:07:49.63,0:07:50.47,Default,,0,0,0,,Уф
Dialogue: 0,0:07:53.47,0:07:55.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:55.80,0:07:59.72,Default,,0,0,0,,‎
Dialogue: 0,0:08:01.27,0:08:02.52,Default,,0,0,0,,(қол шапалақтау)
Dialogue: 0,0:08:02.64,0:08:05.90,Default,,0,0,0,,‎(Кацуми) Таңғажайып... Жоқ, өте керемет!
Dialogue: 0,0:08:06.44,0:08:07.77,Default,,0,0,0,,Балалар, көрдіңдер ме?
Dialogue: 0,0:08:08.48,0:08:10.23,Default,,0,0,0,,‎Адам қолы
Dialogue: 0,0:08:10.36,0:08:15.28,Default,,0,0,0,,Сіз жаттықтырсаңыз, доғал аспапқа, тіпті балғаға да айналатынын білесіз.
Dialogue: 0,0:08:15.66,0:08:18.49,Default,,0,0,0,,‎Бірақ пышақ туралы не деуге болады!
Dialogue: 0,0:08:18.78,0:08:23.58,Default,,0,0,0,,‎Бұл дөңгелек нысанды жүз ретінде де, ұстара ретінде де пайдалануға болады.
Dialogue: 0,0:08:24.42,0:08:28.46,Default,,0,0,0,,‎Менің ойымша, сен кем дегенде екі тері аршып алғансың, Қошо-сан.
Dialogue: 0,0:08:29.25,0:08:30.92,Default,,0,0,0,,‎Қосқыңыз келсе
Dialogue: 0,0:08:31.76,0:08:35.51,Default,,0,0,0,,Тебу, муай-тай және каратэ/кенпоны салыстыру
Dialogue: 0,0:08:35.64,0:08:39.81,Default,,0,0,0,,‎Ең маңызды белгі - аяқ-қолдың ұштары.
Dialogue: 0,0:08:40.43,0:08:44.85,Default,,0,0,0,,Басқаша айтқанда, білезіктен тобыққа дейін өзгерістерді ойлап табу арқылы
Dialogue: 0,0:08:45.31,0:08:47.52,Default,,0,0,0,,‎Шексіз мүмкіндіктер
Dialogue: 0,0:08:47.81,0:08:48.86,Default,,0,0,0,,кеңейтілген
Dialogue: 0,0:08:49.44,0:08:53.03,Default,,0,0,0,,‎(Кацуми) Арнайы жаттықтырушы! Мен саған оқуға рұқсат беремін
Dialogue: 0,0:08:53.44,0:08:54.78,Default,,0,0,0,,‎Түзеңіз!
Dialogue: 0,0:08:56.95,0:08:59.41,Default,,0,0,0,,‎(Барлығы) Рахмет!
Dialogue: 0,0:09:01.79,0:09:05.62,Default,,0,0,0,,‎ (Коушо) Мен өтемақы сұрамаймын, бірақ...
Dialogue: 0,0:09:06.58,0:09:10.84,Default,,0,0,0,,‎Қайда екеніңізді маған хабарлаңыз. Сізге керегі осы ғана.
Dialogue: 0,0:09:11.59,0:09:12.84,Default,,0,0,0,,‎(Кацуми) Мен таң қалдым.
Dialogue: 0,0:09:13.76,0:09:17.43,Default,,0,0,0,,‎Мен Кошо мырзаның бұл іске араласқысы келетініне сене алар емеспін.
Dialogue: 0,0:09:18.39,0:09:21.68,Default,,0,0,0,,Арена жауынгері өлім қатарындағы тұтқынға қарсы
Dialogue: 0,0:09:22.52,0:09:26.60,Default,,0,0,0,,‎Бұл топтан шығарылғаны қорлық болды, бірақ
Dialogue: 0,0:09:27.10,0:09:30.15,Default,,0,0,0,,Турнирде ес-түссіз ұсталғаным рас.
Dialogue: 0,0:09:30.27,0:09:33.57,Default,,0,0,0,,Мен келісемін, бірақ...
Dialogue: 0,0:09:33.86,0:09:37.70,Default,,0,0,0,,‎Дәл қазір мен Кайуды жеңе аламын!
Dialogue: 0,0:09:38.20,0:09:43.62,Default,,0,0,0,,‎(Кацуми) Мен оның әрбір қимылын тәулігіне 24 сағат білемін.
Dialogue: 0,0:09:44.95,0:09:48.08,Default,,0,0,0,,‎Бөлме нөмірі – 701
Dialogue: 0,0:09:53.13,0:09:57.17,Default,,0,0,0,,‎Менде кездесу жоқ, бірақ бұл жақсы, солай ма?
Dialogue: 0,0:10:32.42,0:10:36.01,Default,,0,0,0,,‎Бұл күшті қару екені сөзсіз, бірақ
Dialogue: 0,0:10:36.42,0:10:41.01,Default,,0,0,0,,‎Осындай дене күнделікті өмірді қолайсыз етпей ме?
Dialogue: 0,0:10:42.89,0:10:44.85,Default,,0,0,0,,АҚШ армиясының полковнигі
Dialogue: 0,0:10:45.22,0:10:48.02,Default,,0,0,0,,Юдзиро Ханма - ескі дос.
Dialogue: 0,0:10:51.60,0:10:55.19,Default,,0,0,0,,‎ Бұл қолға орнатылған қосқыш бар.
Dialogue: 0,0:10:55.86,0:11:00.61,Default,,0,0,0,,‎Ішкі қару саусақпен жұмыс істемейінше іске қосылмайды.
Dialogue: 0,0:11:02.49,0:11:05.66,Default,,0,0,0,,‎Мені таң қалдыратын нәрсе
Dialogue: 0,0:11:05.79,0:11:09.66,Default,,0,0,0,,‎Бұл адамның күш іздеуге құмарлығы.
Dialogue: 0,0:11:10.08,0:11:14.54,Default,,0,0,0,,‎Бұл кәсіпқой сиқыршылар әлеміндегі қарапайым түсінік.
Dialogue: 0,0:11:15.75,0:11:18.80,Default,,0,0,0,,Алақаныңызды үстел үстіндегі стақанға қойыңыз.
Dialogue: 0,0:11:19.01,0:11:21.76,Default,,0,0,0,,Стақанға сыраны әп-сәтте толтырыңыз
Dialogue: 0,0:11:23.68,0:11:25.39,Default,,0,0,0,,Құбыр тәрізді саусақтар
Dialogue: 0,0:11:25.93,0:11:29.68,Default,,0,0,0,,‎Егер сіз темекі шегу сияқты қайта-қайта дем алсаңыз,
Dialogue: 0,0:11:30.77,0:11:33.90,Default,,0,0,0,,Оның аузынан кенет түтін шығып кетті.
Dialogue: 0,0:11:34.06,0:11:36.98,Default,,0,0,0,,‎Хмм, мен де көрдім.
Dialogue: 0,0:11:37.73,0:11:38.98,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:11:39.44,0:11:43.49,Default,,0,0,0,,Мұның бәрі денеден өткен құбыр ғана.
Dialogue: 0,0:11:43.74,0:11:44.82,Default,,0,0,0,,Құбыр?
Dialogue: 0,0:11:45.66,0:11:46.95,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:11:47.24,0:11:50.62,Default,,0,0,0,,‎ Иә, бұл, әрине, ақылға қонымды емес.
Dialogue: 0,0:11:50.75,0:11:53.00,Default,,0,0,0,,Менің ойымша, онша алысқа бару мүмкін емес.
Dialogue: 0,0:11:53.33,0:11:55.50,Default,,0,0,0,,‎Сондықтан мұны істеу керек
Dialogue: 0,0:11:56.84,0:11:59.46,Default,,0,0,0,,‎Шын мәнінде үлкен ақша салды
Dialogue: 0,0:11:59.63,0:12:03.76,Default,,0,0,0,,‎Ота жасап, түтікшені денеге көміңіз
Dialogue: 0,0:12:04.93,0:12:05.89,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:12:06.68,0:12:09.43,Default,,0,0,0,,Бұл таңқаларлық емес.
Dialogue: 0,0:12:11.06,0:12:14.73,Default,,0,0,0,,‎Жүрек буындары Тыныс алу жүйесі
Dialogue: 0,0:12:15.19,0:12:18.02,Default,,0,0,0,,Ішкі ағзаларында осы артефактілер бар қарапайым адамдар
Dialogue: 0,0:12:18.77,0:12:21.78,Default,,0,0,0,,Шындығында, олар көп, солай емес пе?
Dialogue: 0,0:12:23.49,0:12:26.28,Default,,0,0,0,,‎Ах~ түсіндім.
Dialogue: 0,0:12:27.20,0:12:30.74,Default,,0,0,0,,‎Одан да мен қуған бұзақымын.
Dialogue: 0,0:12:30.87,0:12:33.46,Default,,0,0,0,,‎Егер сіз операция арқылы күш жинай алсаңыз
Dialogue: 0,0:12:33.58,0:12:36.21,Default,,0,0,0,,‎Кез келген сома...
Dialogue: 0,0:12:39.80,0:12:40.63,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:49.43,0:12:50.97,Default,,0,0,0,,О!
Dialogue: 0,0:12:51.77,0:12:54.10,Default,,0,0,0,,‎Алда әлі алда тағы да трюктар бар сияқты.
Dialogue: 0,0:12:54.23,0:12:55.64,Default,,0,0,0,,‎
Dialogue: 0,0:12:55.77,0:12:57.35,Default,,0,0,0,,Мен кетемін
Dialogue: 0,0:12:58.27,0:12:59.11,Default,,0,0,0,,‎(есіктің ашылған дыбысы)
Dialogue: 0,0:13:03.44,0:13:04.57,Default,,0,0,0,,Сіз...
Dialogue: 0,0:13:06.49,0:13:07.32,Default,,0,0,0,,Уау
Dialogue: 0,0:13:11.74,0:13:13.00,Default,,0,0,0,,‎(көтеру) алаңдату
Dialogue: 0,0:13:17.63,0:13:21.84,Default,,0,0,0,,‎Жер асты аренасы Тиісті жауынгер Кошо Хо
Dialogue: 0,0:13:24.22,0:13:27.05,Default,,0,0,0,,Сіз жеңілгенді білгіңіз келеді, солай емес пе?
Dialogue: 0,0:13:28.76,0:13:29.85,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:13:31.22,0:13:35.14,Default,,0,0,0,,‎Бұл сәйкестік емес. Бұл ақымақтық болды.
Dialogue: 0,0:13:35.60,0:13:39.15,Default,,0,0,0,,Жау алдыма келгенше отыра алмаймын.
Dialogue: 0,0:13:46.61,0:13:47.49,Default,,0,0,0,,‎Hmph
Dialogue: 0,0:13:49.87,0:13:51.87,Default,,0,0,0,,‎Гах гах...
Dialogue: 0,0:13:54.91,0:13:55.75,Default,,0,0,0,,‎Уау…
Dialogue: 0,0:13:56.00,0:13:59.92,Default,,0,0,0,,‎(ыңылдап)
Dialogue: 0,0:14:03.30,0:14:05.17,Default,,0,0,0,,‎(қозу) Фу~
Dialogue: 0,0:14:07.26,0:14:10.43,Default,,0,0,0,,‎(қатты тыныс алу)
Dialogue: 0,0:14:28.11,0:14:30.16,Default,,0,0,0,,‎ Ешқашан сақтығыңызды төмендетпеңіз
Dialogue: 0,0:14:31.57,0:14:34.91,Default,,0,0,0,,‎Өлімге жақын зиян келтіру кезінде
Dialogue: 0,0:14:43.21,0:14:44.42,Default,,0,0,0,,Өлім қаруы!
Dialogue: 0,0:14:51.01,0:14:51.84,Default,,0,0,0,,‎Nu…
Dialogue: 0,0:14:52.51,0:14:53.35,Default,,0,0,0,,Ға!
Dialogue: 0,0:14:57.64,0:14:59.98,Default,,0,0,0,,‎Гаха…
Dialogue: 0,0:15:00.39,0:15:04.52,Default,,0,0,0,,‎Олар көздеп жатыр... Бір нүктені көздейді.
Dialogue: 0,0:15:06.23,0:15:08.28,Default,,0,0,0,,‎(ыңылдап)
Dialogue: 0,0:15:08.40,0:15:09.86,Default,,0,0,0,,‎(Кошо) Осылай істей бер.
Dialogue: 0,0:15:10.45,0:15:13.32,Default,,0,0,0,,‎Сен тұра бергенше мен сені жеңемін.
Dialogue: 0,0:15:20.00,0:15:21.50,Default,,0,0,0,,‎(Коузуэ) Алыста...
Dialogue: 0,0:15:23.83,0:15:25.50,Default,,0,0,0,,Маған да қара!
Dialogue: 0,0:15:25.79,0:15:26.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:28.80,0:15:30.88,Default,,0,0,0,,Бір секіруге де жол берме.
Dialogue: 0,0:15:33.30,0:15:34.14,Default,,0,0,0,,нәжіс
Dialogue: 0,0:15:36.14,0:15:37.93,Default,,0,0,0,,‎Неге ашуланбайсың?
Dialogue: 0,0:15:41.81,0:15:43.90,Default,,0,0,0,,‎Менде де солай болды.
Dialogue: 0,0:15:47.27,0:15:48.23,Default,,0,0,0,,‎(аяқ дыбысына жақындау)
Dialogue: 0,0:15:49.15,0:15:49.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:56.78,0:15:58.37,Default,,0,0,0,,мырза. Ханаяма…
Dialogue: 0,0:16:00.54,0:16:01.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:10.97,0:16:13.05,Default,,0,0,0,,‎(Ханаяма) Сол қызды қалайсың ба?
Dialogue: 0,0:16:14.84,0:16:18.39,Default,,0,0,0,,‎Әлде әйелді қалайсыз ба?
Dialogue: 0,0:16:20.98,0:16:21.85,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:16:23.60,0:16:24.44,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:16:29.32,0:16:33.28,Default,,0,0,0,,‎Бұл нені білдіреді? Мен сенің не айтып тұрғаныңды түсінбеймін.
Dialogue: 0,0:16:35.70,0:16:40.66,Default,,0,0,0,,‎(Ханаяма) Егер мен ол қыз болмасам, қарсы болмасаңыз.
Dialogue: 0,0:16:41.87,0:16:43.25,Default,,0,0,0,,Тым жылдам сөйлеңіз
Dialogue: 0,0:16:44.54,0:16:47.17,Default,,0,0,0,,‎Егер мен әйел болсам, мен сені қалағанымша асыраушы едім.
Dialogue: 0,0:16:51.59,0:16:53.80,Default,,0,0,0,,‎Әдемі және алуан түрлі
Dialogue: 0,0:16:56.64,0:16:57.72,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:17:00.43,0:17:01.27,Default,,0,0,0,,Гоку
Dialogue: 0,0:17:05.77,0:17:08.06,Default,,0,0,0,,‎Жақсы, әдемі гүлдер...
Dialogue: 0,0:17:08.19,0:17:09.31,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:17:15.49,0:17:18.78,Default,,0,0,0,,‎Соны айту үшін келдің бе? Олай болса...
Dialogue: 0,0:17:20.28,0:17:22.49,Default,,0,0,0,,‎Артық ештеңе айтпаған дұрыс
Dialogue: 0,0:17:23.58,0:17:26.83,Default,,0,0,0,,(Ханаяма) Түсіндім. Оның алдында жауап беру қиын...
Dialogue: 0,0:17:30.13,0:17:31.00,Default,,0,0,0,,Ға!
Dialogue: 0,0:17:41.93,0:17:44.35,Default,,0,0,0,,Өте жақсы, Ханаяма.
Dialogue: 0,0:17:47.94,0:17:49.10,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:17:53.61,0:17:54.44,Default,,0,0,0,,‎(соққы дыбысы)
Dialogue: 0,0:17:55.11,0:17:57.61,Default,,0,0,0,,‎Какка…
Dialogue: 0,0:18:04.33,0:18:08.79,Default,,0,0,0,,‎ (Коушо) Каратэмен шұғылданушы ретінде мен ешқашан құлаған қарсыласқа шабуыл жасамаймын.
Dialogue: 0,0:18:08.92,0:18:13.00,Default,,0,0,0,,Қайта-қайта тұрғанша, мені жеңе бер
Dialogue: 0,0:18:13.71,0:18:17.13,Default,,0,0,0,,‎Бірақ... бұл енді біткен сияқты.
Dialogue: 0,0:18:23.31,0:18:28.31,Default,,0,0,0,,Сіздің денеңіздің енді қарсы тұруға күші жоқ.
Dialogue: 0,0:18:28.48,0:18:32.61,Default,,0,0,0,,‎(ыңылдап)
Dialogue: 0,0:18:32.73,0:18:37.03,Default,,0,0,0,,‎(Кошо) Құпия қару пышақ па? Бұл жарылғыш зат па?
Dialogue: 0,0:18:38.36,0:18:39.91,Default,,0,0,0,,‎ Ауқым
Dialogue: 0,0:18:40.36,0:18:43.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:50.58,0:18:51.58,Default,,0,0,0,,‎(Қолдану) А-а...
Dialogue: 0,0:18:53.46,0:18:54.29,Default,,0,0,0,,А
Dialogue: 0,0:18:56.63,0:18:58.38,Default,,0,0,0,,‎Фу~
Dialogue: 0,0:19:00.55,0:19:01.39,Default,,0,0,0,,Бұл…
Dialogue: 0,0:19:13.73,0:19:14.98,Default,,0,0,0,,‎Куузэ…
Dialogue: 0,0:19:16.57,0:19:17.57,Default,,0,0,0,,Біреуі жоқ.
Dialogue: 0,0:19:18.32,0:19:19.15,Default,,0,0,0,,‎Мм.
Dialogue: 0,0:19:20.03,0:19:20.86,Default,,0,0,0,,А...
Dialogue: 0,0:19:21.24,0:19:26.74,Default,,0,0,0,,Әзірше мен еш жерден табылмаймын.
Dialogue: 0,0:19:29.37,0:19:30.21,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:19:32.79,0:19:34.08,Default,,0,0,0,,Бұл дөрекі.
Dialogue: 0,0:19:34.71,0:19:37.55,Default,,0,0,0,,Сүйіктіңнің алдында мұндай әңгіме
Dialogue: 0,0:19:41.05,0:19:43.05,Default,,0,0,0,,Мені төмендетпеңіз
Dialogue: 0,0:19:46.22,0:19:47.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:48.39,0:19:49.77,Default,,0,0,0,,Әрқашан солай.
Dialogue: 0,0:19:51.94,0:19:53.35,Default,,0,0,0,,‎«Күшті бол»
Dialogue: 0,0:19:55.52,0:19:56.69,Default,,0,0,0,,‎«Жеңіс»
Dialogue: 0,0:19:58.65,0:20:00.03,Default,,0,0,0,,‎«Мен жеңіле алмаймын.»
Dialogue: 0,0:20:01.90,0:20:05.03,Default,,0,0,0,,Әйелдер әрқашан
Dialogue: 0,0:20:08.20,0:20:10.16,Default,,0,0,0,,‎Әрқашан циклден тыс!
Dialogue: 0,0:20:11.79,0:20:14.33,Default,,0,0,0,,Сізді өлтіретін боласыз! Шынайы!
Dialogue: 0,0:20:18.05,0:20:20.63,Default,,0,0,0,,Мен енді жеңіле алмаймын
Dialogue: 0,0:20:21.38,0:20:22.22,Default,,0,0,0,,А
Dialogue: 0,0:20:23.26,0:20:24.09,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:20:25.14,0:20:29.43,Default,,0,0,0,,‎Ең күшті болуға ұмтылу инстинкті тек белгілі
Dialogue: 0,0:20:34.69,0:20:37.44,Default,,0,0,0,,‎Сүйіктіммен салыстырғанда, мен ең күшті екенімді сене алар емеспін
Dialogue: 0,0:20:38.94,0:20:39.86,Default,,0,0,0,,А...
Dialogue: 0,0:20:48.74,0:20:52.37,Default,,0,0,0,,‎(Ханаяма) Баки Бұл шешуші сәт.
Dialogue: 0,0:20:53.91,0:20:55.46,Default,,0,0,0,,‎Ол қызбен серуендегің келе ме?
Dialogue: 0,0:20:58.84,0:21:00.25,Default,,0,0,0,,Бұл сіздің мәселеңіз.
Dialogue: 0,0:21:02.13,0:21:04.05,Default,,0,0,0,,Бұл менің проблемам.
Dialogue: 0,0:21:06.13,0:21:06.97,Default,,0,0,0,,Гоку
Dialogue: 0,0:21:12.72,0:21:14.06,Default,,0,0,0,,‎(Ханаяма) Дұрыс.
Dialogue: 0,0:21:15.69,0:21:18.40,Default,,0,0,0,,‎Екі адам бірге шешім қабылдауы керек.
Dialogue: 0,0:21:20.82,0:21:22.61,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:21:25.49,0:21:26.91,Default,,0,0,0,,‎(Қолдану) Ах, а...
Dialogue: 0,0:21:27.74,0:21:29.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:31.62,0:21:33.58,Default,,0,0,0,,Ух...
Dialogue: 0,0:21:34.37,0:21:36.75,Default,,0,0,0,,‎(қозу) Ууууууу...
Dialogue: 0,0:21:39.29,0:21:41.50,Default,,0,0,0,,Уау! (иектің қозғалу дыбысы)
Dialogue: 0,0:21:41.96,0:21:44.51,Default,,0,0,0,,Мен шығып кеткен иекті қойдым!
Dialogue: 0,0:21:53.68,0:21:55.77,Default,,0,0,0,,Сіз мұны істегіңіз келе ме?
Dialogue: 0,0:22:18.62,0:22:20.25,Default,,0,0,0,,Мен оны шығардым...
Dialogue: 0,0:22:21.08,0:22:27.09,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:22:28.59,0:22:34.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory