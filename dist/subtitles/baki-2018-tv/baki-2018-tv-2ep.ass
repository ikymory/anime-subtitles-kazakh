Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:12.01,0:00:18.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.01,0:01:40.01,Default,,0,0,0,,~♪
Dialogue: 0,0:01:44.64,0:01:46.31,Default,,0,0,0,,Синхрондылық
Dialogue: 0,0:01:46.98,0:01:49.69,Default,,0,0,0,,Өлім жазасына кесілген бес тұтқын
Dialogue: 0,0:01:49.77,0:01:52.98,Default,,0,0,0,,Сол сөздерді қалдырып, Токиоға бет алдым.
Dialogue: 0,0:01:53.36,0:01:54.23,Default,,0,0,0,,Баки
Dialogue: 0,0:01:55.49,0:01:57.24,Default,,0,0,0,,Мағынасын біл!
Dialogue: 0,0:02:01.57,0:02:02.53,Default,,0,0,0,,Хаа~
Dialogue: 0,0:02:05.75,0:02:06.58,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:06.66,0:02:07.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:08.25,0:02:10.50,Default,,0,0,0,,Сіз не үшін келесіз? Токиоға
Dialogue: 0,0:02:10.63,0:02:13.00,Default,,0,0,0,,Тіпті түрмеден қашып кетті... Эй.
Dialogue: 0,0:02:13.92,0:02:15.76,Default,,0,0,0,,«Мен жеңілгенді білгім келеді»?
Dialogue: 0,0:02:17.13,0:02:19.26,Default,,0,0,0,,Білесің бе, Баки?
Dialogue: 0,0:02:19.55,0:02:21.55,Default,,0,0,0,,Екі тарап та түрмеде.
Dialogue: 0,0:02:21.64,0:02:26.14,Default,,0,0,0,,10-нан астам адамның өліміне себепкер болған мықтылардың мықтысы
Dialogue: 0,0:02:26.22,0:02:27.77,Default,,0,0,0,,Бұл нені білдіретінін түсінесіз бе?
Dialogue: 0,0:02:29.94,0:02:34.23,Default,,0,0,0,,Оларға адамдарды өлтіру үшін қару қажет емес.
Dialogue: 0,0:02:34.32,0:02:37.78,Default,,0,0,0,,Бұл олардың барлығы жекпе-жек шебері екенін білдіреді!
Dialogue: 0,0:02:38.44,0:02:40.03,Default,,0,0,0,,А, онда...
Dialogue: 0,0:02:40.24,0:02:43.95,Default,,0,0,0,,Дұрыс! Бұл сені көруге келемін дегенді білдіреді.
Dialogue: 0,0:02:44.03,0:02:45.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:46.24,0:02:48.00,Default,,0,0,0,,Қысқасы
Dialogue: 0,0:02:48.41,0:02:52.38,Default,,0,0,0,,Жер асты ареналарында негізделген «Сырттағы» жекпе-жек өнері
Dialogue: 0,0:02:52.46,0:02:54.00,Default,,0,0,0,,Қылмыс әлемі…
Dialogue: 0,0:02:54.09,0:02:58.21,Default,,0,0,0,,Қараңғы жағы деп аталатынға негізделген «Құпия» жекпе-жек
Dialogue: 0,0:02:59.09,0:03:00.68,Default,,0,0,0,,Алдыңғы және артқы жағы!
Dialogue: 0,0:03:00.76,0:03:01.63,Default,,0,0,0,,Айтуға тура келсе
Dialogue: 0,0:03:01.72,0:03:05.97,Default,,0,0,0,,Бұл ақ жекпе-жек өнері мен қара жекпе-жек өнері арасындағы жан-жақты соғыс!
Dialogue: 0,0:03:09.39,0:03:10.64,Default,,0,0,0,,Ата
Dialogue: 0,0:03:11.48,0:03:12.85,Default,,0,0,0,,Бұл тым көп күш.
Dialogue: 0,0:03:12.94,0:03:14.98,Default,,0,0,0,,Иә! Бұл табиғи
Dialogue: 0,0:03:15.11,0:03:17.98,Default,,0,0,0,,(жүгіру)
Dialogue: 0,0:03:18.19,0:03:19.99,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:20.36,0:03:21.49,Default,,0,0,0,,Ах! (Өтіп бара жатқан В) Ой!
Dialogue: 0,0:03:21.86,0:03:23.16,Default,,0,0,0,,Робинсон
Dialogue: 0,0:03:23.36,0:03:25.33,Default,,0,0,0,,Бұл Роб Робинсон, соққышы.
Dialogue: 0,0:03:32.50,0:03:33.33,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:35.46,0:03:36.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:46.72,0:03:48.43,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:03:48.77,0:03:51.27,Default,,0,0,0,,Маған көшедегі төбелесті сатуға қалай дәтің бар?
Dialogue: 0,0:03:51.98,0:03:53.39,Default,,0,0,0,,Алыс болыңыз!
Dialogue: 0,0:03:53.56,0:03:55.81,Default,,0,0,0,,Әуесқойды ұруға болмайды.
Dialogue: 0,0:03:59.07,0:04:01.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:03.03,0:04:04.32,Default,,0,0,0,,Мені өлтіру керек пе?
Dialogue: 0,0:04:04.45,0:04:05.28,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:08.41,0:04:10.04,Default,,0,0,0,,Жағадағы ұстара?
Dialogue: 0,0:04:16.00,0:04:17.29,Default,,0,0,0,,Металл?
Dialogue: 0,0:04:21.76,0:04:24.88,Default,,0,0,0,,Өйткені бұл спорт.
Dialogue: 0,0:04:26.76,0:04:27.93,Default,,0,0,0,,Бұл солай емес пе?
Dialogue: 0,0:04:28.72,0:04:30.77,Default,,0,0,0,,Хоора хоора
Dialogue: 0,0:04:32.31,0:04:33.98,Default,,0,0,0,,Пышақ туралы не деуге болады?
Dialogue: 0,0:04:34.06,0:04:35.94,Default,,0,0,0,,Оң жақта
Dialogue: 0,0:04:36.35,0:04:37.23,Default,,0,0,0,,Ей! (Жаман A) Уау!
Dialogue: 0,0:04:37.31,0:04:38.69,Default,,0,0,0,,Иә? Жоқ
Dialogue: 0,0:04:39.73,0:04:41.90,Default,,0,0,0,,Уау... (Харашима) Бұл менің сол қолым еді~
Dialogue: 0,0:04:43.57,0:04:46.99,Default,,0,0,0,,Сонда қайда? Сол Бакикун
Dialogue: 0,0:04:47.07,0:04:51.16,Default,,0,0,0,,Уау... Бұл керемет, Харашима мырза!
Dialogue: 0,0:04:53.79,0:04:55.37,Default,,0,0,0,,Әй... (Жаман В) Иә?
Dialogue: 0,0:04:56.87,0:05:00.38,Default,,0,0,0,,Қозғалмаңыз~ Басыңыз ұшып кетеді.
Dialogue: 0,0:05:07.26,0:05:08.59,Default,,0,0,0,,Ооо~аа
Dialogue: 0,0:05:11.39,0:05:13.81,Default,,0,0,0,,О~
Dialogue: 0,0:05:14.77,0:05:18.02,Default,,0,0,0,,Ақымақ, жалаң қолыңмен ұрыссың.
Dialogue: 0,0:05:18.44,0:05:20.19,Default,,0,0,0,,Дәл сіз айтқандай.
Dialogue: 0,0:05:20.27,0:05:23.57,Default,,0,0,0,,Онда барамыз ба? Баки-чан және мынау
Dialogue: 0,0:05:28.66,0:05:29.74,Default,,0,0,0,,О...
Dialogue: 0,0:05:29.82,0:05:31.49,Default,,0,0,0,,Қысқасы
Dialogue: 0,0:05:32.74,0:05:35.16,Default,,0,0,0,,Менде сені кесіп тастауға батылым бар.
Dialogue: 0,0:05:35.25,0:05:37.12,Default,,0,0,0,,Бұл бар-жоғы туралы.
Dialogue: 0,0:05:37.71,0:05:38.54,Default,,0,0,0,,Эй
Dialogue: 0,0:05:38.92,0:05:42.42,Default,,0,0,0,,Басыңды шайқағаның рас
Dialogue: 0,0:05:43.05,0:05:45.13,Default,,0,0,0,,Жеңіске жетуге бел байладым.
Dialogue: 0,0:05:45.21,0:05:47.30,Default,,0,0,0,,Ұрыс дегеніміз не?
Dialogue: 0,0:05:48.01,0:05:49.55,Default,,0,0,0,,Маған жол көрсетіңізші.
Dialogue: 0,0:05:50.05,0:05:52.81,Default,,0,0,0,,Күшті күшті Бақи баласы
Dialogue: 0,0:05:53.60,0:05:54.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:55.31,0:05:57.56,Default,,0,0,0,,Маған қарызға бере аласыз ба?
Dialogue: 0,0:05:58.39,0:06:01.02,Default,,0,0,0,,Ол маған отыруымды айтты.
Dialogue: 0,0:06:01.11,0:06:04.28,Default,,0,0,0,,Иә, олай десеңіз де бәрібір.
Dialogue: 0,0:06:04.90,0:06:06.53,Default,,0,0,0,,…және қатты күл. Содан кейін
Dialogue: 0,0:06:06.61,0:06:08.03,Default,,0,0,0,,Маған Цура қарызға бер!
Dialogue: 0,0:06:09.99,0:06:10.82,Default,,0,0,0,,Иә
Dialogue: 0,0:06:11.41,0:06:12.37,Default,,0,0,0,,Хаа~
Dialogue: 0,0:06:13.79,0:06:14.62,Default,,0,0,0,,О
Dialogue: 0,0:06:14.74,0:06:16.29,Default,,0,0,0,,(Гибс сықырлайды)
Dialogue: 0,0:06:17.87,0:06:18.71,Default,,0,0,0,,Не!
Dialogue: 0,0:06:20.17,0:06:22.00,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:06:22.38,0:06:24.00,Default,,0,0,0,,Кут хи хи...
Dialogue: 0,0:06:27.59,0:06:30.89,Default,,0,0,0,,Эй, сен әдемісің.
Dialogue: 0,0:06:30.97,0:06:32.55,Default,,0,0,0,,Дене бітімі кішкентай болғанымен
Dialogue: 0,0:06:32.64,0:06:34.26,Default,,0,0,0,,Иә, бұл күшті.
Dialogue: 0,0:06:34.35,0:06:35.97,Default,,0,0,0,,Ең жақсы жалаң қолдар болса.
Dialogue: 0,0:06:36.43,0:06:39.48,Default,,0,0,0,,Баки~! Ең алдымен, догеза!
Dialogue: 0,0:06:40.35,0:06:41.19,Default,,0,0,0,,Иә
Dialogue: 0,0:06:41.56,0:06:44.69,Default,,0,0,0,,Ой, бұл күлкілі ме? Теме!
Dialogue: 0,0:06:46.61,0:06:49.49,Default,,0,0,0,,Кенеттен мылтық атуға болмайды.
Dialogue: 0,0:06:49.57,0:06:51.66,Default,,0,0,0,,Сәлем, бүгінгі жастар
Dialogue: 0,0:06:51.74,0:06:54.20,Default,,0,0,0,,Ұрыстың қызығынан ләззат алма.
Dialogue: 0,0:07:00.83,0:07:03.88,Default,,0,0,0,,Иә? Бұл жігіт мені шынымен өлтіргісі келеді.
Dialogue: 0,0:07:05.04,0:07:06.13,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:07:07.51,0:07:08.38,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:07:09.38,0:07:10.47,Default,,0,0,0,,Міне.
Dialogue: 0,0:07:11.68,0:07:12.51,Default,,0,0,0,,Ах
Dialogue: 0,0:07:13.89,0:07:14.93,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:07:18.14,0:07:20.73,Default,,0,0,0,,Сені пышақпен кесуге батылым жетсе де
Dialogue: 0,0:07:20.81,0:07:22.98,Default,,0,0,0,,Бетіңізді жаншып алуға дайынсыз ба?
Dialogue: 0,0:07:23.23,0:07:24.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:26.27,0:07:27.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:27.90,0:07:31.36,Default,,0,0,0,,Сіз бұл салмақтарды пошта арқылы саттыңыз, солай ма?
Dialogue: 0,0:07:31.90,0:07:33.11,Default,,0,0,0,,Мм... Куу~!
Dialogue: 0,0:07:34.12,0:07:34.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:37.49,0:07:39.41,Default,,0,0,0,,Кел, ойнайық.
Dialogue: 0,0:07:40.12,0:07:42.42,Default,,0,0,0,,Куу~! Нгг...
Dialogue: 0,0:07:45.00,0:07:45.84,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:51.26,0:07:52.09,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:52.34,0:07:53.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:54.01,0:07:56.30,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:07:57.47,0:07:58.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:59.39,0:08:02.52,Default,,0,0,0,,Қараңдар~ Көп уақыт өтті.
Dialogue: 0,0:08:08.23,0:08:09.44,Default,,0,0,0,,Сіз өте әдемісіз. Хмм…
Dialogue: 0,0:08:09.69,0:08:10.82,Default,,0,0,0,,Гуса~!
Dialogue: 0,0:08:11.07,0:08:12.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:12.95,0:08:13.78,Default,,0,0,0,,Иә
Dialogue: 0,0:08:18.33,0:08:20.04,Default,,0,0,0,,Сонымен не керек?
Dialogue: 0,0:08:20.45,0:08:21.29,Default,,0,0,0,,Ах
Dialogue: 0,0:08:21.95,0:08:23.96,Default,,0,0,0,,Біз не істейміз? Ханма!
Dialogue: 0,0:08:24.04,0:08:26.71,Default,,0,0,0,,Егер бұл орын алса, сіз не істейсіз?
Dialogue: 0,0:08:30.71,0:08:31.67,Default,,0,0,0,,Дуриан
Dialogue: 0,0:08:32.47,0:08:33.80,Default,,0,0,0,,Сикорский
Dialogue: 0,0:08:34.63,0:08:35.68,Default,,0,0,0,,Дойл
Dialogue: 0,0:08:36.43,0:08:37.68,Default,,0,0,0,,Техникалық сипаттамалар
Dialogue: 0,0:08:38.51,0:08:40.31,Default,,0,0,0,,Рюко Янаги
Dialogue: 0,0:08:40.64,0:08:46.52,Default,,0,0,0,,Бір уақытта бес адам, оның ішінде бір жапондық қашып кетті.
Dialogue: 0,0:08:46.94,0:08:50.65,Default,,0,0,0,,Қазіргі уақытта бұл бес адамның арасында ешқандай қарым-қатынас табылған жоқ.
Dialogue: 0,0:08:50.98,0:08:52.32,Default,,0,0,0,,Бірақ біртүрлі
Dialogue: 0,0:08:52.82,0:08:57.49,Default,,0,0,0,,Олардың бесеуі де Токиоға қонуды меңзеп жатыр...
Dialogue: 0,0:08:57.74,0:08:58.91,Default,,0,0,0,,Сиқыршы культішілер.
Dialogue: 0,0:09:00.08,0:09:00.91,Default,,0,0,0,,Бас инспектор
Dialogue: 0,0:09:00.99,0:09:01.91,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:03.62,0:09:05.33,Default,,0,0,0,,Иә? Не!
Dialogue: 0,0:09:05.79,0:09:07.50,Default,,0,0,0,,Бас кеңсе Жауап беріңізші! Штаб!
Dialogue: 0,0:09:07.58,0:09:09.67,Default,,0,0,0,,Сен оны жалаң қолыңмен қираттың ба?
Dialogue: 0,0:09:09.75,0:09:13.01,Default,,0,0,0,,Бұл қатты жылдамдықпен самосвалға соқтығысқан сияқты...
Dialogue: 0,0:09:13.09,0:09:15.84,Default,,0,0,0,,Куәгерлердің айтуынша, кінәлі батыстық болған.
Dialogue: 0,0:09:16.22,0:09:19.93,Default,,0,0,0,,Жоқ, мен оны анық көрмедім.
Dialogue: 0,0:09:20.01,0:09:22.60,Default,,0,0,0,,Олардың кейбіреулері туралы не деуге болады? Сізде ұқсас бет бар ма?
Dialogue: 0,0:09:22.68,0:09:23.52,Default,,0,0,0,,Ах
Dialogue: 0,0:09:24.68,0:09:25.69,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:26.35,0:09:29.69,Default,,0,0,0,,Сәлем! Мұндай жағдайда не істеуім керек?
Dialogue: 0,0:09:29.77,0:09:31.27,Default,,0,0,0,,Айт!
Dialogue: 0,0:09:32.73,0:09:33.78,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:09:34.15,0:09:37.61,Default,,0,0,0,,Жарайсыңдар! Сонымен не істеуіміз керек?
Dialogue: 0,0:09:37.78,0:09:40.28,Default,,0,0,0,,Өлім жазасына кесілген бес тұтқын Токиоға бет алды
Dialogue: 0,0:09:41.66,0:09:44.12,Default,,0,0,0,,Сонда сіз 1-ші нөмірсіз бе?
Dialogue: 0,0:09:45.12,0:09:45.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:47.87,0:09:48.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:49.13,0:09:50.71,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:09:52.63,0:09:54.71,Default,,0,0,0,,Оны маған беріңіз
Dialogue: 0,0:09:54.96,0:09:55.80,Default,,0,0,0,,Гррр…
Dialogue: 0,0:09:56.76,0:10:00.39,Default,,0,0,0,,Мен үшін мағынасы жоқ жалғыз нәрсе - бұл
Dialogue: 0,0:10:00.47,0:10:02.01,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:10:02.93,0:10:04.22,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:10:05.02,0:10:06.89,Default,,0,0,0,,Автоматпен де жеңе алмайсың
Dialogue: 0,0:10:14.36,0:10:15.23,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:15.53,0:10:16.74,Default,,0,0,0,,Фу~
Dialogue: 0,0:10:17.40,0:10:18.24,Default,,0,0,0,,Ах
Dialogue: 0,0:10:18.70,0:10:20.24,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:25.95,0:10:27.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:28.66,0:10:32.84,Default,,0,0,0,,Токиода ең күшті адам бар деп естідім.
Dialogue: 0,0:10:34.92,0:10:39.34,Default,,0,0,0,,Бұл 17 жастағы бала екен.
Dialogue: 0,0:10:41.01,0:10:42.85,Default,,0,0,0,,Баки Хамма
Dialogue: 0,0:10:43.80,0:10:45.10,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:10:45.60,0:10:50.10,Default,,0,0,0,,Мен үшін жеңіліс бар болса,
Dialogue: 0,0:10:51.98,0:10:53.11,Default,,0,0,0,,Қол алысу
Dialogue: 0,0:10:57.78,0:10:58.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:00.70,0:11:04.08,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:11:04.78,0:11:07.37,Default,,0,0,0,,Оны тастамаңыз
Dialogue: 0,0:11:07.45,0:11:10.33,Default,,0,0,0,,Бұл сіздің сүйікті адамыңыздың қолы!
Dialogue: 0,0:11:10.87,0:11:14.88,Default,,0,0,0,,Сүйген адамның қолын түсірмеу керек.
Dialogue: 0,0:11:14.96,0:11:16.84,Default,,0,0,0,,Нухахахаха!
Dialogue: 0,0:11:20.80,0:11:21.84,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:22.89,0:11:25.26,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:25.47,0:11:26.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:29.02,0:11:31.56,Default,,0,0,0,,Бұл сүйген адамның қолы.
Dialogue: 0,0:11:32.06,0:11:33.65,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:11:33.85,0:11:35.65,Default,,0,0,0,,Бетіңізді уқалаңыз
Dialogue: 0,0:11:36.44,0:11:38.78,Default,,0,0,0,,Сіз жылап жатқаныңызға сенімдімін!
Dialogue: 0,0:11:39.24,0:11:41.49,Default,,0,0,0,,Мен үлгере алмаймын
Dialogue: 0,0:11:43.61,0:11:46.95,Default,,0,0,0,,Сәлем? Хахахахаха
Dialogue: 0,0:11:47.49,0:11:49.83,Default,,0,0,0,,Вахахахаха!
Dialogue: 0,0:11:50.45,0:11:51.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:51.66,0:11:52.71,Default,,0,0,0,,Сәлем! (Әйел) А...
Dialogue: 0,0:11:54.42,0:11:55.92,Default,,0,0,0,,Нфуфу
Dialogue: 0,0:11:56.29,0:11:57.21,Default,,0,0,0,,Мен күлдім!
Dialogue: 0,0:11:57.29,0:11:58.92,Default,,0,0,0,,Полиция... полиция шақырыңыз!
Dialogue: 0,0:12:01.72,0:12:04.43,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:12:04.55,0:12:06.93,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:12:08.81,0:12:10.10,Default,,0,0,0,,Ерекшеліктер.
Dialogue: 0,0:12:10.18,0:12:12.39,Default,,0,0,0,,Штаб-пәтер! Өтінемін жауап беріңіз
Dialogue: 0,0:12:12.48,0:12:15.69,Default,,0,0,0,,Қазір Спектің өзі деп есептелген адам ұсталды.
Dialogue: 0,0:12:15.90,0:12:17.06,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:12:17.15,0:12:17.98,Default,,0,0,0,,Иә
Dialogue: 0,0:12:18.07,0:12:19.90,Default,,0,0,0,,Инспектор: Бұл сіздің білегіңіз!
Dialogue: 0,0:12:19.98,0:12:22.15,Default,,0,0,0,,Бұл шабуылға ұшыраған офицер Канедаға тиесілі сияқты.
Dialogue: 0,0:12:22.57,0:12:23.40,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:23.61,0:12:24.53,Default,,0,0,0,,Иә
Dialogue: 0,0:12:26.78,0:12:28.49,Default,,0,0,0,,Баки Хамма
Dialogue: 0,0:12:28.58,0:12:29.62,Default,,0,0,0,,Не... (Офицер Б) Қозғалма!
Dialogue: 0,0:12:30.08,0:12:34.17,Default,,0,0,0,,Бүгін бұл жай ғана сәлемдесу болды.
Dialogue: 0,0:12:34.25,0:12:36.63,Default,,0,0,0,,Мен от жағамын! (Офицер Д) Сен, кет!
Dialogue: 0,0:12:38.00,0:12:39.13,Default,,0,0,0,,Бұл сезім...
Dialogue: 0,0:12:39.96,0:12:42.38,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:12:43.17,0:12:46.22,Default,,0,0,0,,Енді нағыз қол алысу уақыты келді.
Dialogue: 0,0:12:53.14,0:12:56.40,Default,,0,0,0,,Менің көңілімді қалдырма
Dialogue: 0,0:12:57.06,0:12:58.06,Default,,0,0,0,,(Джунпей) Бірінші (One) фильмнің басты кейіпкерінің немересі, екінші (Two) фильмнің кінәлісінің немересі—
Dialogue: 0,0:12:58.61,0:13:00.77,Default,,0,0,0,,О, және...
Dialogue: 0,0:13:05.61,0:13:08.28,Default,,0,0,0,,Фухахахаха!
Dialogue: 0,0:13:09.49,0:13:11.04,Default,,0,0,0,,Көріскенше, балам
Dialogue: 0,0:13:12.37,0:13:14.21,Default,,0,0,0,,Дәл сол жігіт сияқты.
Dialogue: 0,0:13:15.04,0:13:18.33,Default,,0,0,0,,Күдіктінің ерекшеліктері кеңесшіні өлтіргеннен кейін.
Dialogue: 0,0:13:18.42,0:13:21.55,Default,,0,0,0,,Теңіздің 200 метр астындағы сүңгуір қайықтан қашып кеткен
Dialogue: 0,0:13:21.67,0:13:25.72,Default,,0,0,0,,Жағалау сызығының бес күзетшісін өлтіріп, қашып кеткен.
Dialogue: 0,0:13:26.01,0:13:27.43,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:13:27.51,0:13:30.68,Default,,0,0,0,,Өлім жазасына кесілген бес адам Токиоға неліктен барды деген сұрақ туындайды?
Dialogue: 0,0:13:30.85,0:13:33.56,Default,,0,0,0,,10 жылдан астам оқшауланған туысы жоқ адамдар
Dialogue: 0,0:13:33.64,0:13:36.39,Default,,0,0,0,,Бір күні мен кенеттен ерік бірлігін көрдім.
Dialogue: 0,0:13:36.48,0:13:37.90,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:13:38.10,0:13:41.27,Default,,0,0,0,,Қалай болғанда да, елордалық полиция департаменті ФБР-дан көмек сұрады.
Dialogue: 0,0:13:41.36,0:13:43.65,Default,,0,0,0,,Біз бұл төтенше жағдайға әрекет етудеміз.
Dialogue: 0,0:13:44.69,0:13:46.32,Default,,0,0,0,,Жер бетінде не болады?
Dialogue: 0,0:13:46.99,0:13:49.70,Default,,0,0,0,,Мотохаши мырза, Токио қалалық полиция департаментінің бірінші тергеу бөлімінің бұрынғы бастығы
Dialogue: 0,0:13:49.78,0:13:52.08,Default,,0,0,0,,Сіз нені елестете аласыз?
Dialogue: 0,0:13:52.33,0:13:53.16,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:53.58,0:13:56.66,Default,,0,0,0,,Өлім жазасына кесілген бес адамның ниетін білмесек.
Dialogue: 0,0:13:56.79,0:13:58.75,Default,,0,0,0,,Нақты айта алмаймын, бірақ
Dialogue: 0,0:13:59.00,0:14:01.88,Default,,0,0,0,,Жапон полициясының дағдарысты басқару қабілеті өте жақсы.
Dialogue: 0,0:14:02.67,0:14:04.92,Default,,0,0,0,,ФБР зорлық-зомбылық жасаған қылмыскерлерге қарсы шаралар...
Dialogue: 0,0:14:05.01,0:14:08.84,Default,,0,0,0,,Хе, 100 жыл кетсе де түсінбейсің.
Dialogue: 0,0:14:08.93,0:14:10.89,Default,,0,0,0,,Бұл ФБР сияқты.
Dialogue: 0,0:14:14.56,0:14:18.60,Default,,0,0,0,,Бақидың әкесі «Тарихтағы ең күшті жаратылыс»
Dialogue: 0,0:14:18.94,0:14:22.48,Default,,0,0,0,,Жалаң қолмен әскерді жоюға жеткілікті жауынгерлік күшке ие.
Dialogue: 0,0:14:23.57,0:14:28.65,Default,,0,0,0,,Дүние жүзіндегі жекпе-жек шеберлері, саясаткерлер және әскерилер қорқады
Dialogue: 0,0:14:30.03,0:14:33.74,Default,,0,0,0,,Осылай қайта кездесетінімізге сене алар емеспін
Dialogue: 0,0:14:34.24,0:14:37.29,Default,,0,0,0,,Қалай болғанда да, келгеніңізге рахмет.
Dialogue: 0,0:14:37.91,0:14:39.16,Default,,0,0,0,,Янаги мырза
Dialogue: 0,0:14:44.00,0:14:46.09,Default,,0,0,0,,Сіз жалқау көрінесіз, Шибукава.
Dialogue: 0,0:14:47.30,0:14:49.01,Default,,0,0,0,,Енді тартымды емес
Dialogue: 0,0:14:50.30,0:14:54.35,Default,,0,0,0,,Сіз жеңілдіңіз, бұл жақында болды.
Dialogue: 0,0:14:55.60,0:14:57.68,Default,,0,0,0,,Мен сені осылай көргім келеді
Dialogue: 0,0:14:58.98,0:15:01.85,Default,,0,0,0,,Соңғы соққыны мен сол кезде беруім керек еді.
Dialogue: 0,0:15:02.15,0:15:04.86,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:15:05.61,0:15:07.86,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:15:12.78,0:15:15.41,Default,,0,0,0,,Шибукава-рю джиу-джитсудың негізін салушы
Dialogue: 0,0:15:16.08,0:15:17.37,Default,,0,0,0,,70 жастан жоғары
Dialogue: 0,0:15:18.20,0:15:22.37,Default,,0,0,0,,Бойы кішкентай болса да, Айки деп аталатын әдісті толық пайдаланады.
Dialogue: 0,0:15:22.46,0:15:26.38,Default,,0,0,0,,Ең мықтыны да тастай алатын тірі аңыз.
Dialogue: 0,0:15:28.80,0:15:30.72,Default,,0,0,0,,Сәлем Янаги-сан
Dialogue: 0,0:15:33.01,0:15:36.76,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет кездесеміз бе?
Dialogue: 0,0:15:37.10,0:15:39.89,Default,,0,0,0,,(Вилоудың күлкісі)
Dialogue: 0,0:15:41.64,0:15:46.52,Default,,0,0,0,,Жекпе-жек шеберлерінің тәтті болғаны сонша, олар еріп кете жаздады.
Dialogue: 0,0:15:46.77,0:15:48.86,Default,,0,0,0,,Қатысқыңыз келсе
Dialogue: 0,0:15:49.94,0:15:52.36,Default,,0,0,0,,Үндемей істесең жақсы.
Dialogue: 0,0:15:52.82,0:15:53.86,Default,,0,0,0,,Осылай!
Dialogue: 0,0:15:54.78,0:15:56.08,Default,,0,0,0,,Душ қабылдау керек пе? Соқты ма?
Dialogue: 0,0:15:57.95,0:15:59.50,Default,,0,0,0,,Иә? Өту?
Dialogue: 0,0:16:05.92,0:16:07.80,Default,,0,0,0,,Бұл менің екінші жеңілісім.
Dialogue: 0,0:16:07.92,0:16:09.80,Default,,0,0,0,,Жоқ, үшінші рет пе?
Dialogue: 0,0:16:14.84,0:16:16.30,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:16:17.51,0:16:18.89,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:16:19.81,0:16:23.06,Default,,0,0,0,,Тамағы жылы, ауасы жылы.
Dialogue: 0,0:16:23.48,0:16:26.77,Default,,0,0,0,,Мен оны біраз уақытқа негіз ретінде пайдалана аламын ба?
Dialogue: 0,0:16:27.11,0:16:28.98,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:16:30.44,0:16:34.82,Default,,0,0,0,,Тек... бізде тамақ аз.
Dialogue: 0,0:16:37.70,0:16:39.20,Default,,0,0,0,,Төтенше
Dialogue: 0,0:16:39.49,0:16:42.12,Default,,0,0,0,,Өткен деректер мүлдем қолданылмайды
Dialogue: 0,0:16:42.20,0:16:45.00,Default,,0,0,0,,Барлығы бұл туралы толық біледі деп үміттенемін.
Dialogue: 0,0:16:45.96,0:16:47.29,Default,,0,0,0,,Оны адам деп санамаңыз.
Dialogue: 0,0:16:47.38,0:16:50.30,Default,,0,0,0,,Біз бұрыннан байланысқан кез келген басқа түрінен айырмашылығы.
Dialogue: 0,0:16:50.38,0:16:54.01,Default,,0,0,0,,Өзіңіздің қарсыласыңыз ретінде жоғары ақылды құбыжықты елестетіп көріңіз.
Dialogue: 0,0:16:54.47,0:16:56.59,Default,,0,0,0,,Елордалық полиция департаментінің беделіне қауіп төніп тұр.
Dialogue: 0,0:16:56.68,0:16:59.76,Default,,0,0,0,,Құжатты жіберу аяқталғанға дейін
Dialogue: 0,0:17:00.51,0:17:03.98,Default,,0,0,0,,Тасымалдау: қауіпсіздікті қалыпты деңгейден үш есеге дейін арттырыңыз!
Dialogue: 0,0:17:04.77,0:17:06.73,Default,,0,0,0,,Тарту!
Dialogue: 0,0:17:08.06,0:17:09.06,Default,,0,0,0,,Басшы!
Dialogue: 0,0:17:09.61,0:17:11.23,Default,,0,0,0,,Келесі аптадағы ойынға дайындық
Dialogue: 0,0:17:11.32,0:17:13.19,Default,,0,0,0,,Мен бірнеше сабақ алғым келеді.
Dialogue: 0,0:17:14.24,0:17:17.61,Default,,0,0,0,,Егер сізді біреу жаттықтырса, сіз кенеттен күшейесіз...
Dialogue: 0,0:17:17.70,0:17:22.16,Default,,0,0,0,,Дзюдо ондай емес, бірақ бір нәрсені айтайын.
Dialogue: 0,0:17:22.62,0:17:26.08,Default,,0,0,0,,Жеңіске жете алмайтыныңды білсең, тым болмаса оның жаралануына жол бер.
Dialogue: 0,0:17:26.17,0:17:27.04,Default,,0,0,0,,О...
Dialogue: 0,0:17:29.33,0:17:33.80,Default,,0,0,0,,Бұзық болса да, ертеңге апарады.
Dialogue: 0,0:17:35.80,0:17:36.84,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:36.93,0:17:39.64,Default,,0,0,0,,Сен құбыжықсың, хахаха
Dialogue: 0,0:17:44.81,0:17:45.64,Default,,0,0,0,,Фу~
Dialogue: 0,0:17:46.52,0:17:48.19,Default,,0,0,0,,Spec (судың ағып жатқан дыбысы)
Dialogue: 0,0:17:48.48,0:17:49.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:50.73,0:17:51.61,Default,,0,0,0,,Ах
Dialogue: 0,0:17:54.61,0:17:55.82,Default,,0,0,0,,A-la-la-
Dialogue: 0,0:17:55.90,0:17:57.91,Default,,0,0,0,,Sp… спецификациялар
Dialogue: 0,0:17:59.32,0:18:00.16,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:18:00.62,0:18:03.37,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:03.83,0:18:05.29,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:18:05.54,0:18:08.37,Default,,0,0,0,,Барлығы дәретхананы пайдаланады.
Dialogue: 0,0:18:08.87,0:18:10.58,Default,,0,0,0,,Оның орнына, қараңыз.
Dialogue: 0,0:18:11.38,0:18:12.88,Default,,0,0,0,,Қытайдың буға пісірілген тоқаштары
Dialogue: 0,0:18:13.09,0:18:16.13,Default,,0,0,0,,Бұл жақын маңдағы супермаркетте болды.
Dialogue: 0,0:18:16.88,0:18:18.88,Default,,0,0,0,,Әлі де жылы~
Dialogue: 0,0:18:19.13,0:18:20.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:21.01,0:18:21.85,Default,,0,0,0,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,0:18:24.89,0:18:25.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:26.56,0:18:32.48,Default,,0,0,0,,Ей, адамдардың мейірімін мейіріммен қабылдау керек.
Dialogue: 0,0:18:32.56,0:18:34.53,Default,,0,0,0,,Хмм? Бұл кім? Мен оны танымаймын.
Dialogue: 0,0:18:35.23,0:18:37.11,Default,,0,0,0,,(Дабыл қоңырауы)
Dialogue: 0,0:18:37.65,0:18:39.20,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:39.28,0:18:42.62,Default,,0,0,0,,Нақты қашан? Мен бір дыбысты ести алмадым
Dialogue: 0,0:18:43.62,0:18:44.83,Default,,0,0,0,,Штабқа хабарласыңыз!
Dialogue: 0,0:18:44.91,0:18:46.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:47.45,0:18:48.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:48.37,0:18:53.09,Default,,0,0,0,,Олай емес~ Балалар, біреудің бөлмесіне рұқсатсыз кірдіңдер.
Dialogue: 0,0:18:54.38,0:18:57.42,Default,,0,0,0,,Ешқайда кетпеңіз
Dialogue: 0,0:18:57.55,0:18:59.80,Default,,0,0,0,,Жүр, шық.
Dialogue: 0,0:19:03.43,0:19:05.06,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:19:05.14,0:19:08.52,Default,,0,0,0,,Сіз жай ғана клиенттерді ала алмайсыз, солай ма? Қытай шелпектері...
Dialogue: 0,0:19:08.60,0:19:09.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.23,0:19:12.44,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:19:16.73,0:19:18.90,Default,,0,0,0,,Алланың алдында тағзым! (барабан дыбысы)
Dialogue: 0,0:19:20.03,0:19:21.95,Default,,0,0,0,,Бір-біріңді сыйлаңдар! (барабан дыбысы)
Dialogue: 0,0:19:23.12,0:19:23.95,Default,,0,0,0,,Дайын
Dialogue: 0,0:19:28.62,0:19:29.45,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:19:30.12,0:19:30.96,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:19:35.71,0:19:38.51,Default,,0,0,0,,Практикалық каратэ Шиншинкай негізін қалаушы
Dialogue: 0,0:19:38.84,0:19:40.47,Default,,0,0,0,,Доппо Гучидің асырап алған баласы
Dialogue: 0,0:19:41.22,0:19:44.51,Default,,0,0,0,,Ол қазір Допподан Шиншинкайды алды және оның басшысы.
Dialogue: 0,0:19:45.97,0:19:48.68,Default,,0,0,0,,«Каратэ әлемінің өлімге әкелетін қаруы» ретінде сипатталған дарынды адам
Dialogue: 0,0:19:53.10,0:19:54.69,Default,,0,0,0,,Қытай Кемпо тарихында
Dialogue: 0,0:19:55.11,0:19:57.69,Default,,0,0,0,,«Нөмір бірінші талантқа» ие деген данышпан
Dialogue: 0,0:19:59.07,0:20:00.57,Default,,0,0,0,,Максималды турнирлерде
Dialogue: 0,0:20:00.65,0:20:04.24,Default,,0,0,0,,Чемпион Бақиды жеңілістің шегіне жеткізді.
Dialogue: 0,0:20:13.50,0:20:15.21,Default,,0,0,0,,
Dialogue: 0,0:20:18.84,0:20:19.67,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:20:22.38,0:20:23.22,Default,,0,0,0,,Фу~
Dialogue: 0,0:20:28.22,0:20:29.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:34.44,0:20:35.69,Default,,0,0,0,,Мен сені күттім, Батыр. ➡
Dialogue: 0,0:20:40.23,0:20:41.32,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:20:44.82,0:20:45.66,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:20:47.87,0:20:48.95,Default,,0,0,0,,(Еден тақтасының сынған дыбысы)
Dialogue: 0,0:20:49.45,0:20:50.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:51.66,0:20:52.50,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:20:55.71,0:20:56.71,Default,,0,0,0,,3 минут
Dialogue: 0,0:20:57.54,0:20:58.67,Default,,0,0,0,,Ой
Dialogue: 0,0:20:59.29,0:21:00.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.21,0:21:03.72,Default,,0,0,0,,
Dialogue: 0,0:21:03.92,0:21:07.72,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:21:08.72,0:21:11.85,Default,,0,0,0,,Менің ойымша, мұны бәрі естіген.
Dialogue: 0,0:21:12.68,0:21:15.73,Default,,0,0,0,,Мен бұл адаммен бетпе-бет келіп, жеңіліп қалдым.
Dialogue: 0,0:21:16.85,0:21:18.48,Default,,0,0,0,,Бір соққыда
Dialogue: 0,0:21:19.31,0:21:21.94,Default,,0,0,0,,Әкесі Доппо Гучи
Dialogue: 0,0:21:22.19,0:21:25.90,Default,,0,0,0,,Қазіргі каратэ көне жекпе-жек өнерінен артта қалған сияқты.
Dialogue: 0,0:21:25.99,0:21:29.87,Default,,0,0,0,,Оқытуға жарамсыз және өзін қуып шығарды.
Dialogue: 0,0:21:29.95,0:21:32.37,Default,,0,0,0,,Мен Шиншинкайды осында қалдырдым.
Dialogue: 0,0:21:32.49,0:21:35.58,Default,,0,0,0,,Менің ойымша, каратэде жауап басқаша.
Dialogue: 0,0:21:36.42,0:21:39.13,Default,,0,0,0,,Қытайдың 4000 жылдығын көшіру
Dialogue: 0,0:21:39.42,0:21:42.55,Default,,0,0,0,,Сондықтан мен Каиу мырзаны шақыруды жөн көрдім.
Dialogue: 0,0:21:43.55,0:21:45.05,Default,,0,0,0,,4000 жыл
Dialogue: 0,0:21:45.80,0:21:50.26,Default,,0,0,0,,Қытайлықтар жұдырықтай ежелден Джомон дәуірінде жаттығады.
Dialogue: 0,0:21:50.85,0:21:52.43,Default,,0,0,0,,Сене аласыз ба?
Dialogue: 0,0:21:52.60,0:21:55.68,Default,,0,0,0,,Канто жазығының көп бөлігі теңіз астында болған уақыттан бері
Dialogue: 0,0:21:55.77,0:21:58.27,Default,,0,0,0,,Менің бар істегенім – адамдарды өлтіру.
Dialogue: 0,0:21:58.94,0:22:00.73,Default,,0,0,0,,Болашақта Шиншинкай болады
Dialogue: 0,0:22:00.81,0:22:03.78,Default,,0,0,0,,Қытайдың жекпе-жек өнерінің талғамын толығымен енгізген
Dialogue: 0,0:22:03.86,0:22:07.28,Default,,0,0,0,,Нағыз заманауи каратэмен мүмкіндігінше тезірек аяқтаңыз
Dialogue: 0,0:22:07.95,0:22:10.28,Default,,0,0,0,,Бұл менің каратэ туралы ойым!
Dialogue: 0,0:22:11.03,0:22:12.28,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:22:12.62,0:22:13.70,Default,,0,0,0,,Иә? (Кацуми) Ах
Dialogue: 0,0:22:14.95,0:22:19.33,Default,,0,0,0,,Мен Доппо Гучи мырзамен танысқым келеді...
Dialogue: 0,0:22:21.04,0:22:27.05,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:43.96,0:23:49.97,Default,,0,0,0,,~♪
Dialogue: 0,0:23:51.47,0:23:57.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory