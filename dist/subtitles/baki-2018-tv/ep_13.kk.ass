Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.76,0:00:17.76,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,~♪
Dialogue: 0,0:01:44.14,0:01:47.19,Default,,0,0,0,,Біраз уақыт тыныш болыңыз
Dialogue: 0,0:01:47.64,0:01:49.35,Default,,0,0,0,,Мен айта аламын.
Dialogue: 0,0:01:49.48,0:01:53.11,Default,,0,0,0,,Айқайласаң, анаң өледі.
Dialogue: 0,0:01:53.61,0:01:58.11,Default,,0,0,0,,Ал мен үшін бұл мүмкін
Dialogue: 0,0:01:59.41,0:02:01.37,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:02:01.87,0:02:05.62,Default,,0,0,0,,Егер айта алсаңыз, жай ғана көзіңізді тыныш жабыңыз.
Dialogue: 0,0:02:07.50,0:02:08.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:10.75,0:02:13.25,Default,,0,0,0,,Хмм... жақсы қыз.
Dialogue: 0,0:02:14.05,0:02:18.47,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:02:19.59,0:02:20.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:20.89,0:02:24.10,Default,,0,0,0,,Бірінші кездескен кездегі сөздеріңіз
Dialogue: 0,0:02:24.47,0:02:26.77,Default,,0,0,0,,Мен бұған сенемін.
Dialogue: 0,0:02:27.48,0:02:30.35,Default,,0,0,0,,Егер мен айқайласам, мені өлтіріңіз
Dialogue: 0,0:02:30.81,0:02:33.23,Default,,0,0,0,,Мен де анамды өлтіремін.
Dialogue: 0,0:02:33.77,0:02:35.36,Default,,0,0,0,,Сіздің өрнек
Dialogue: 0,0:02:35.57,0:02:37.53,Default,,0,0,0,,Сіздің фигураңыз
Dialogue: 0,0:02:37.99,0:02:40.32,Default,,0,0,0,,Мен оларға мұның ешқайсысы өтірік емес екенін айтамын.
Dialogue: 0,0:02:41.82,0:02:42.87,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:02:44.28,0:02:46.74,Default,,0,0,0,,Сенімді
Dialogue: 0,0:02:47.20,0:02:50.62,Default,,0,0,0,,Хахан, осыған бәс тігу керек пе?
Dialogue: 0,0:02:50.79,0:02:51.92,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:53.17,0:02:54.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:56.67,0:02:58.26,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:02:58.42,0:02:59.26,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:02:59.47,0:03:00.30,Default,,0,0,0,,Баки-кун!
Dialogue: 0,0:03:00.55,0:03:03.18,Default,,0,0,0,,Мен қашан өлетінімді білмеймін!
Dialogue: 0,0:03:04.05,0:03:05.68,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:03:05.81,0:03:06.68,Default,,0,0,0,,Теңізді ластайтын ешқандай ірі қалалар жоқ—
Dialogue: 0,0:03:07.93,0:03:09.23,Default,,0,0,0,,Шық!
Dialogue: 0,0:03:10.35,0:03:11.19,Default,,0,0,0,,Козуэ!
Dialogue: 0,0:03:11.44,0:03:13.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:14.02,0:03:17.15,Default,,0,0,0,,Сіздің войеризм хоббиіңіз болды ма?
Dialogue: 0,0:03:17.32,0:03:21.15,Default,,0,0,0,,Ааа... аа аа
Dialogue: 0,0:03:22.03,0:03:26.20,Default,,0,0,0,,Мен сені ең күшті адам деп естідім, сондықтан мен сені қуып жүрдім.
Dialogue: 0,0:03:28.24,0:03:29.20,Default,,0,0,0,,А...?
Dialogue: 0,0:03:29.54,0:03:32.21,Default,,0,0,0,,Бірақ шындық туралы не деуге болады?
Dialogue: 0,0:03:32.37,0:03:33.21,Default,,0,0,0,,Бұхаа!
Dialogue: 0,0:03:33.92,0:03:35.59,Default,,0,0,0,,Ей! (Сикорский) Уф!
Dialogue: 0,0:03:38.50,0:03:40.55,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:03:42.09,0:03:42.97,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:03:43.13,0:03:44.68,Default,,0,0,0,,Ал Джоэстар ұрпақтарына келсек—
Dialogue: 0,0:03:44.97,0:03:48.39,Default,,0,0,0,,Мен кіруге болмайтын аумаққа қадам бастым.
Dialogue: 0,0:03:48.97,0:03:50.18,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:03:51.27,0:03:52.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:53.02,0:03:54.65,Default,,0,0,0,,Ах... Уф.
Dialogue: 0,0:03:55.06,0:03:55.90,Default,,0,0,0,,Ех… Ах…
Dialogue: 0,0:03:58.07,0:04:00.44,Default,,0,0,0,,Ух... ааа...
Dialogue: 0,0:04:01.82,0:04:03.32,Default,,0,0,0,,Тағы бірнеше сату автоматын орната алмайсың ба?
Dialogue: 0,0:04:03.57,0:04:04.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:05.53,0:04:06.37,Default,,0,0,0,,Хмф!
Dialogue: 0,0:04:07.33,0:04:08.24,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:04:08.79,0:04:09.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:11.96,0:04:14.12,Default,,0,0,0,,Барлығы осында шешілді.
Dialogue: 0,0:04:14.29,0:04:15.42,Default,,0,0,0,,Баки-кун
Dialogue: 0,0:04:15.67,0:04:16.79,Default,,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,0:04:17.17,0:04:18.50,Default,,0,0,0,,Бірден аяқтаңыз
Dialogue: 0,0:04:21.38,0:04:22.42,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:25.68,0:04:26.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:26.68,0:04:27.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:29.85,0:04:31.47,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:04:33.14,0:04:33.98,Default,,0,0,0,,Ха...
Dialogue: 0,0:04:37.15,0:04:37.98,Default,,0,0,0,,Тей!
Dialogue: 0,0:04:41.28,0:04:42.28,Default,,0,0,0,,Апай!
Dialogue: 0,0:04:42.82,0:04:43.74,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:04:43.90,0:04:44.95,Default,,0,0,0,,Апай!
Dialogue: 0,0:04:46.20,0:04:47.74,Default,,0,0,0,,Мені ұрлап кетті...
Dialogue: 0,0:04:48.53,0:04:49.70,Default,,0,0,0,,Козуэ…
Dialogue: 0,0:04:49.87,0:04:50.70,Default,,0,0,0,,Га
Dialogue: 0,0:04:53.33,0:04:54.79,Default,,0,0,0,,Нухахаха
Dialogue: 0,0:04:55.21,0:04:59.46,Default,,0,0,0,,«Кіруге болмайтын аумақ»?
Dialogue: 0,0:04:59.79,0:05:02.84,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:05:04.34,0:05:06.88,Default,,0,0,0,,Мені күлдіреді
Dialogue: 0,0:05:07.43,0:05:11.18,Default,,0,0,0,,Ол чемпион болса да, бәрібір бала.
Dialogue: 0,0:05:11.35,0:05:16.64,Default,,0,0,0,,Бірақ егер сол адам—
Dialogue: 0,0:05:19.11,0:05:21.32,Default,,0,0,0,,Жапония қалалық полиция департаменті
Dialogue: 0,0:05:22.48,0:05:23.57,Default,,0,0,0,,қазір осында
Dialogue: 0,0:05:23.74,0:05:28.87,Default,,0,0,0,,Қиыр шығыстағы арал мемлекетіне қонған ең күшті өлім жазасына кесілген тұтқындармен күресу үшін.
Dialogue: 0,0:05:29.12,0:05:31.83,Default,,0,0,0,,Алты адам жиналды.
Dialogue: 0,0:05:33.49,0:05:37.96,Default,,0,0,0,,Жапония қалалық полиция департаментінің бастығы Морио Сонода
Dialogue: 0,0:05:38.71,0:05:42.30,Default,,0,0,0,,Хиденобу Наго, елордалық полиция департаменті бас инспекторының орынбасары
Dialogue: 0,0:05:44.09,0:05:48.97,Default,,0,0,0,,Джон Спенсер, Америка Құрама Штаттарының Бас прокурорының орынбасары
Dialogue: 0,0:05:50.14,0:05:53.89,Default,,0,0,0,,ФБР директоры Барт Аллен
Dialogue: 0,0:05:55.06,0:05:59.10,Default,,0,0,0,,Джулиус Нортон, Британ Корольдігі сотының төрағасы
Dialogue: 0,0:06:00.56,0:06:05.82,Default,,0,0,0,,Ресей Республикасы КГБ бұрынғы қызметкері Валентин Соколов
Dialogue: 0,0:06:07.82,0:06:10.62,Default,,0,0,0,,Қазіргі уақытта екі адам қамауға алынды.
Dialogue: 0,0:06:10.78,0:06:13.49,Default,,0,0,0,,Сіз мұны қолыңыздағы құжаттармен растадыңыз деп ойлаймын.
Dialogue: 0,0:06:14.66,0:06:20.29,Default,,0,0,0,,Қазіргі уақытта елордалық полиция департаменті қалған үш адамды қамауға алу үшін қолдан келгеннің бәрін жасауда.
Dialogue: 0,0:06:20.67,0:06:24.63,Default,,0,0,0,,Елордалық полиция департаменті әлемдегі тұтқындаулардың ең жоғары деңгейімен мақтана алады.
Dialogue: 0,0:06:24.80,0:06:26.46,Default,,0,0,0,,Осы мәселеге қатысты
Dialogue: 0,0:06:26.63,0:06:30.51,Default,,0,0,0,,Қазіргі жағдай - біз қажетсіз нәрселерге уақыт жоғалтуды жалғастырамыз.
Dialogue: 0,0:06:31.51,0:06:35.01,Default,,0,0,0,,Материкке қонғаннан кейін 6 құрбан болды.
Dialogue: 0,0:06:36.02,0:06:40.35,Default,,0,0,0,,Мен сенен қашуға рұқсат бергені үшін жауапкершілікті алуды сұрамаймын.
Dialogue: 0,0:06:41.02,0:06:44.02,Default,,0,0,0,,Бізге көмектесіңізші!
Dialogue: 0,0:06:47.57,0:06:48.53,Default,,0,0,0,,Жапонияда
Dialogue: 0,0:06:49.40,0:06:54.03,Default,,0,0,0,,«Уды умен тайдыр» деген сөз бар.
Dialogue: 0,0:06:54.95,0:06:56.04,Default,,0,0,0,,Директор Барт
Dialogue: 0,0:06:56.20,0:06:57.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:58.41,0:07:02.96,Default,,0,0,0,,Мен Аризона түрмесінде қиыншылыққа тап болған кейбір тұтқындар бар екенін естідім.
Dialogue: 0,0:07:03.13,0:07:04.17,Default,,0,0,0,,Е...
Dialogue: 0,0:07:05.09,0:07:06.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:07.88,0:07:08.71,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:09.84,0:07:14.10,Default,,0,0,0,,Тұтқын кезінде сіз түрмеден еркін шыға аласыз.
Dialogue: 0,0:07:14.55,0:07:18.72,Default,,0,0,0,,Іс жүзінде оның бақылауы тәулігіне 24 сағатты құрайды.
Dialogue: 0,0:07:18.89,0:07:22.10,Default,,0,0,0,,Барлау спутниктеріне сенуден басқа амалымыз жоқ.
Dialogue: 0,0:07:22.77,0:07:24.19,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:07:24.77,0:07:28.53,Default,,0,0,0,,Оның үстіне түрмедегі өміріне қарасаң...
Dialogue: 0,0:07:28.69,0:07:30.11,Default,,0,0,0,,Соколов мырза!
Dialogue: 0,0:07:30.86,0:07:32.57,Default,,0,0,0,,Біз Америка Құрама Штаттарының ұятымыз.
Dialogue: 0,0:07:32.74,0:07:35.12,Default,,0,0,0,,Сіз жақсы білетін сияқтысыз.
Dialogue: 0,0:07:35.78,0:07:39.33,Default,,0,0,0,,Ал сіз айтқыңыз келген нәрсе
Dialogue: 0,0:07:39.50,0:07:42.71,Default,,0,0,0,,Сиқырлы оқ әсері болуы мүмкін
Dialogue: 0,0:07:43.21,0:07:47.75,Default,,0,0,0,,Алайда полиция қылмыскерлерден сұрайды...
Dialogue: 0,0:07:47.92,0:07:51.63,Default,,0,0,0,,Қандай жағдай болмасын, мұндай жағдай қалай болды...
Dialogue: 0,0:07:52.05,0:07:56.10,Default,,0,0,0,,(Жеу дыбысы)
Dialogue: 0,0:07:57.01,0:08:00.56,Default,,0,0,0,,Енді сіз мұны мойындадыңыз
Dialogue: 0,0:08:00.81,0:08:02.85,Default,,0,0,0,,Сиқырлы оқ әсері және
Dialogue: 0,0:08:03.60,0:08:06.86,Default,,0,0,0,,Сырт келбетке көңіл бөлетін кез келді ме?
Dialogue: 0,0:08:07.02,0:08:08.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:08.69,0:08:11.40,Default,,0,0,0,,Сіз бұл құбыжықты танымайсыз.
Dialogue: 0,0:08:11.90,0:08:13.15,Default,,0,0,0,,Мына құбыжық...
Dialogue: 0,0:08:13.32,0:08:14.66,Default,,0,0,0,,Олива!
Dialogue: 0,0:08:15.62,0:08:16.78,Default,,0,0,0,,Олива?
Dialogue: 0,0:08:17.28,0:08:20.95,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:08:22.00,0:08:24.92,Default,,0,0,0,,Уф... О, құдай!
Dialogue: 0,0:08:27.29,0:08:30.55,Default,,0,0,0,,Жер бетінде не болады?
Dialogue: 0,0:08:32.72,0:08:35.09,Default,,0,0,0,,«Сіз түсінетін боларсыз, бұл бейбітшілік келісіміне қол қою рәсімі —»
Dialogue: 0,0:08:42.93,0:08:45.65,Default,,0,0,0,,Мен мұны бірден білдім, Сонода мырза.
Dialogue: 0,0:08:46.69,0:08:48.15,Default,,0,0,0,,Сіз Майклсыз ба?
Dialogue: 0,0:08:48.94,0:08:52.94,Default,,0,0,0,,Майкл Холлс, Аризона штатындағы түрме бастығы.
Dialogue: 0,0:08:54.11,0:08:55.40,Default,,0,0,0,,Қонақ үйде душ қабылдау
Dialogue: 0,0:08:55.57,0:08:57.99,Default,,0,0,0,,Мен де сыраны араластырғым келетін шығар.
Dialogue: 0,0:08:58.95,0:09:02.16,Default,,0,0,0,,Менімен сайтқа баруыңызды қалаймын.
Dialogue: 0,0:09:03.00,0:09:05.21,Default,,0,0,0,,Мен мұнда көрікті жерлерді аралау үшін келген жоқпын.
Dialogue: 0,0:09:05.50,0:09:07.17,Default,,0,0,0,,Мазасыздық пайдасыз.
Dialogue: 0,0:09:12.88,0:09:16.18,Default,,0,0,0,,Мен американдықтардың артық жұмыс уақытын жек көретінін естідім.
Dialogue: 0,0:09:16.84,0:09:18.68,Default,,0,0,0,,Сіз еңбекқорсыз.
Dialogue: 0,0:09:20.18,0:09:23.27,Default,,0,0,0,,Мұны түсіну қиын болуы мүмкін, бірақ
Dialogue: 0,0:09:23.52,0:09:27.23,Default,,0,0,0,,Бүгін түнде артық жұмыс істеу Олива мырзаның бұйрығы.
Dialogue: 0,0:09:27.40,0:09:28.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:29.23,0:09:32.69,Default,,0,0,0,,Менің келе жатқанымды білесің бе?
Dialogue: 0,0:09:33.11,0:09:36.24,Default,,0,0,0,,Сіз білмейтін ештеңе жоқ, мырза.
Dialogue: 0,0:09:36.49,0:09:37.66,Default,,0,0,0,,Е...
Dialogue: 0,0:09:38.49,0:09:40.74,Default,,0,0,0,,Сіз шынымен тұтқынсыз ба?
Dialogue: 0,0:09:41.74,0:09:43.95,Default,,0,0,0,,Мемлекеттер бойынша
Dialogue: 0,0:09:52.34,0:09:53.38,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:09:53.75,0:09:54.92,Default,,0,0,0,,күннен қорғайтын көзілдірік
Dialogue: 0,0:09:55.38,0:09:56.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:02.68,0:10:04.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:07.85,0:10:09.27,Default,,0,0,0,,Тиістілігі және аты
Dialogue: 0,0:10:09.90,0:10:11.40,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:10:11.56,0:10:13.77,Default,,0,0,0,,Бұл дұрыс түрме емес пе?
Dialogue: 0,0:10:14.57,0:10:17.03,Default,,0,0,0,,Кем дегенде қазір
Dialogue: 0,0:10:20.45,0:10:21.78,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:26.00,0:10:29.29,Default,,0,0,0,,Мұнда ер адам емін-еркін келіп-кетеді...
Dialogue: 0,0:10:36.96,0:10:39.80,Default,,0,0,0,,Бұл қандай құбыжық?
Dialogue: 0,0:10:46.27,0:10:50.39,Default,,0,0,0,,Кез келген жерден табуға болатын өте қарапайым түрме сахнасы
Dialogue: 0,0:10:53.15,0:10:54.07,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:10:55.32,0:10:57.57,Default,,0,0,0,,Бұл жерден жалғыз сенсің.
Dialogue: 0,0:10:57.94,0:10:58.78,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:00.15,0:11:02.57,Default,,0,0,0,,Міне, мистер.
Dialogue: 0,0:11:16.25,0:11:17.67,Default,,0,0,0,,Салқын
Dialogue: 0,0:11:18.59,0:11:19.97,Default,,0,0,0,,Кондиционер жұмыс істеп тұр.
Dialogue: 0,0:11:22.01,0:11:24.97,Default,,0,0,0,,Сен сол есіктің артында тұрсың ба?
Dialogue: 0,0:11:26.47,0:11:27.97,Default,,0,0,0,,Қымбат көрінетін кілем
Dialogue: 0,0:11:29.06,0:11:32.48,Default,,0,0,0,,Мен түсінбеймін, бірақ шедеврге ұқсайтын картиналар мен мүсіндер
Dialogue: 0,0:11:34.36,0:11:36.61,Default,,0,0,0,,Олива мырзаның хоббиі ме?
Dialogue: 0,0:11:43.16,0:11:44.41,Default,,0,0,0,,Фу~
Dialogue: 0,0:11:44.57,0:11:45.41,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:48.16,0:11:50.00,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:11:50.96,0:11:52.83,Default,,0,0,0,,Жапон тілінде?
Dialogue: 0,0:11:57.50,0:11:59.09,Default,,0,0,0,,Барлық жол
Dialogue: 0,0:11:59.26,0:12:01.80,Default,,0,0,0,,Келуіңізге қош келдіңіз.
Dialogue: 0,0:12:02.01,0:12:04.01,Default,,0,0,0,,Бас инспектор Сонода
Dialogue: 0,0:12:05.59,0:12:07.01,Default,,0,0,0,,Семіздік?
Dialogue: 0,0:12:09.14,0:12:11.48,Default,,0,0,0,,Жоқ! семіз емес
Dialogue: 0,0:12:12.31,0:12:17.27,Default,,0,0,0,,Жақсы сығылған және керемет үлкен бұлшықеттер!
Dialogue: 0,0:12:18.15,0:12:18.98,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:12:21.24,0:12:22.90,Default,,0,0,0,,Бұл Олива.
Dialogue: 0,0:12:23.82,0:12:26.28,Default,,0,0,0,,Ертең жақсы болар еді.
Dialogue: 0,0:12:26.45,0:12:28.41,Default,,0,0,0,,Мен шыдамсызмын
Dialogue: 0,0:12:29.41,0:12:31.91,Default,,0,0,0,,Сіз жапон тілінде жақсы сөйлейсіз.
Dialogue: 0,0:12:32.29,0:12:33.71,Default,,0,0,0,,Хмм...хехехе
Dialogue: 0,0:12:36.13,0:12:37.42,Default,,0,0,0,,Бұл адам...
Dialogue: 0,0:12:38.21,0:12:41.92,Default,,0,0,0,,Мұшо мен Шабаның арасына емін-еркін келіп-кететін тұтқындар...
Dialogue: 0,0:12:42.59,0:12:47.09,Default,,0,0,0,,Шампан суық. Сіз сыраны қалайсыз ба?
Dialogue: 0,0:12:47.60,0:12:49.43,Default,,0,0,0,,Жапон тіліндегі нұсқасы да бар.
Dialogue: 0,0:12:49.93,0:12:51.93,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:12:55.31,0:12:58.48,Default,,0,0,0,,Бұл арзан, бірақ өте керемет.
Dialogue: 0,0:12:58.65,0:13:00.77,Default,,0,0,0,,Егер сотталушы ішсе ше?
Dialogue: 0,0:13:03.86,0:13:05.45,Default,,0,0,0,,А... а...
Dialogue: 0,0:13:05.61,0:13:07.95,Default,,0,0,0,,Ммммм~
Dialogue: 0,0:13:15.66,0:13:17.46,Default,,0,0,0,,Хаа~
Dialogue: 0,0:13:18.21,0:13:21.25,Default,,0,0,0,,Сигаралар? Түрмедегі...
Dialogue: 0,0:13:22.30,0:13:24.92,Default,,0,0,0,,Күте тұрыңыз, Сонода-кун
Dialogue: 0,0:13:25.09,0:13:27.84,Default,,0,0,0,,Көбінесе менің атым неліктен?
Dialogue: 0,0:13:28.89,0:13:31.01,Default,,0,0,0,,Бұл бөлменің сән-салтанаты
Dialogue: 0,0:13:32.26,0:13:34.93,Default,,0,0,0,,Қонақ үй люкс сияқты
Dialogue: 0,0:13:38.15,0:13:40.40,Default,,0,0,0,,Жай демалыңыз
Dialogue: 0,0:13:41.23,0:13:42.61,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:44.24,0:13:47.28,Default,,0,0,0,,Бұл қол күлкілі қалың.
Dialogue: 0,0:13:47.45,0:13:50.03,Default,,0,0,0,,Әйелдің белі де емес
Dialogue: 0,0:13:51.08,0:13:53.99,Default,,0,0,0,,Сұрақтарыңыз көп сияқты.
Dialogue: 0,0:13:55.20,0:13:58.00,Default,,0,0,0,,Мен не сұрауым керек?
Dialogue: 0,0:13:59.04,0:14:02.04,Default,,0,0,0,,Неліктен жалғыз мен боспын?
Dialogue: 0,0:14:02.92,0:14:05.05,Default,,0,0,0,,Естігім келеді... Естігім келеді.
Dialogue: 0,0:14:05.76,0:14:09.55,Default,,0,0,0,,Өйткені мен жақсы аңшымын
Dialogue: 0,0:14:10.05,0:14:11.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:11.60,0:14:12.56,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:14:13.14,0:14:18.06,Default,,0,0,0,,Мен кез келген қылмыскерді ұстай аламын.
Dialogue: 0,0:14:18.81,0:14:24.07,Default,,0,0,0,,Тұтқындардың көпшілігі Аризона штатындағы түзеу мекемесінде
Dialogue: 0,0:14:24.23,0:14:26.99,Default,,0,0,0,,Мен оны түсірдім.
Dialogue: 0,0:14:27.61,0:14:31.07,Default,,0,0,0,,Мен мұны ақымақтық деп айтқым келеді...
Dialogue: 0,0:14:31.41,0:14:34.49,Default,,0,0,0,,Мен өзімнің VIP екенімді көрсетуге шыдамаймын.
Dialogue: 0,0:14:35.12,0:14:37.50,Default,,0,0,0,,Мені қамауда ұстаудың орнына
Dialogue: 0,0:14:37.66,0:14:39.50,Default,,0,0,0,,Аңшы ретінде пайдалану
Dialogue: 0,0:14:39.83,0:14:42.42,Default,,0,0,0,,Бұл әлдеқайда дана
Dialogue: 0,0:14:42.59,0:14:44.84,Default,,0,0,0,,Дәлелденген
Dialogue: 0,0:14:45.09,0:14:46.88,Default,,0,0,0,,Неліктен түсіру керек?
Dialogue: 0,0:14:47.05,0:14:49.47,Default,,0,0,0,,Бірдеңе болса, қылмыскерлер
Dialogue: 0,0:14:49.63,0:14:51.80,Default,,0,0,0,,Бұл сіздің тарапыңызда болуы керек емес пе?
Dialogue: 0,0:14:51.97,0:14:55.51,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:14:56.02,0:14:57.93,Default,,0,0,0,,Ке... ұялы телефон?
Dialogue: 0,0:14:58.10,0:14:58.93,Default,,0,0,0,,
Dialogue: 0,0:14:59.14,0:15:00.31,Default,,0,0,0,,Не?
Dialogue: 0,0:15:00.81,0:15:03.48,Default,,0,0,0,,Бұны тұтқын деп санауға бола ма?
Dialogue: 0,0:15:04.57,0:15:06.53,Default,,0,0,0,,Сонода қуаныңыз
Dialogue: 0,0:15:06.82,0:15:08.94,Default,,0,0,0,,Оқиға орын алды.
Dialogue: 0,0:15:09.53,0:15:10.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:16.62,0:15:17.95,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:15:18.12,0:15:20.37,Default,,0,0,0,,Иә, тікелей оқиға орнына барыңыз.
Dialogue: 0,0:15:20.54,0:15:21.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:22.08,0:15:24.08,Default,,0,0,0,,Бұл... бұл?
Dialogue: 0,0:15:25.79,0:15:27.30,Default,,0,0,0,,Олива мырза!
Dialogue: 0,0:15:29.21,0:15:30.05,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:15:31.13,0:15:32.13,Default,,0,0,0,,О
Dialogue: 0,0:15:33.43,0:15:35.85,Default,,0,0,0,,Тұтқын: Мен оны сурет саламын деп қорқыттым.
Dialogue: 0,0:15:36.01,0:15:38.06,Default,,0,0,0,,Олар өте ұқсас, солай емес пе?
Dialogue: 0,0:15:38.56,0:15:42.52,Default,,0,0,0,,Мен оның шаштарын сәл өсірдім.
Dialogue: 0,0:15:43.02,0:15:48.15,Default,,0,0,0,,Түрме қабырғасындағы тұтқынның алып портреті?
Dialogue: 0,0:15:48.32,0:15:50.07,Default,,0,0,0,,Хэхе... хаха...
Dialogue: 0,0:16:01.87,0:16:03.62,Default,,0,0,0,,Жоқ, жай кездейсоқтық.
Dialogue: 0,0:16:08.50,0:16:11.67,Default,,0,0,0,,Жер бетінде не болып жатыр?
Dialogue: 0,0:16:12.26,0:16:14.01,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:16:14.18,0:16:17.64,Default,,0,0,0,,Менің ойымша, кем дегенде 15 құрбан бар.
Dialogue: 0,0:16:17.81,0:16:19.26,Default,,0,0,0,,Зардап шеккендердің көпшілігі болды
Dialogue: 0,0:16:19.43,0:16:21.98,Default,,0,0,0,,Бірінші қабаттағы вестибюльде жарылыс болғаны осы.
Dialogue: 0,0:16:22.56,0:16:23.81,Default,,0,0,0,,Қанша кінәлі?
Dialogue: 0,0:16:24.27,0:16:25.81,Default,,0,0,0,,А... Мен жалғызбын.
Dialogue: 0,0:16:25.98,0:16:27.69,Default,,0,0,0,,Бір адам ше?
Dialogue: 0,0:16:27.86,0:16:31.65,Default,,0,0,0,,Сонда бұл ғимаратты өз қолыңызға алдыңыз ба?
Dialogue: 0,0:16:32.15,0:16:36.03,Default,,0,0,0,,Бұл мұқият жоспармен бекітілген әрекет сияқты...
Dialogue: 0,0:16:38.28,0:16:39.33,Default,,0,0,0,,Қару туралы не деуге болады?
Dialogue: 0,0:16:39.49,0:16:43.29,Default,,0,0,0,,Мүмкін жарылғыш заттар, атыс қаруы, пышақ және т.б.
Dialogue: 0,0:16:43.66,0:16:45.29,Default,,0,0,0,,Тірі қалғандар кімдер?
Dialogue: 0,0:16:45.46,0:16:49.13,Default,,0,0,0,,Жоғарғы қабатта 20-дан астам адам үйқамақта отырған көрінеді.
Dialogue: 0,0:16:49.29,0:16:52.13,Default,,0,0,0,,Қашып кетуге әрекеттенгендердің барлығы...
Dialogue: 0,0:16:52.42,0:16:54.47,Default,,0,0,0,,Ол өлтірілді ме?
Dialogue: 0,0:16:54.63,0:16:56.51,Default,,0,0,0,,Меніңше...
Dialogue: 0,0:16:57.14,0:16:58.30,Default,,0,0,0,,Қандай талаптар қойылады?
Dialogue: 0,0:16:58.64,0:17:00.01,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:17:00.26,0:17:02.18,Default,,0,0,0,,Маған әкел...
Dialogue: 0,0:17:02.85,0:17:05.19,Default,,0,0,0,,Меніңше, сіз осылай айтып отырсыз.
Dialogue: 0,0:17:05.35,0:17:07.19,Default,,0,0,0,,Олива мырза!
Dialogue: 0,0:17:07.52,0:17:10.06,Default,,0,0,0,,Ки… сіз қатысыңыз ба?
Dialogue: 0,0:17:10.23,0:17:11.23,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:11.40,0:17:14.19,Default,,0,0,0,,А... Әй, қайда барасың?
Dialogue: 0,0:17:16.91,0:17:19.82,Default,,0,0,0,,Қазір үйге бара аласыз.
Dialogue: 0,0:17:19.99,0:17:21.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:45.14,0:17:47.73,Default,,0,0,0,,Мен сізді сағындым, Олива мырза.
Dialogue: 0,0:17:53.61,0:17:55.40,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:17:56.70,0:18:01.24,Default,,0,0,0,,Нью-Йорк штатының бұрынғы полиция қызметкері Джефф Марксон.
Dialogue: 0,0:18:02.79,0:18:05.29,Default,,0,0,0,,24 жыл бұрын жаз
Dialogue: 0,0:18:05.79,0:18:07.96,Default,,0,0,0,,7-ші авеню Манхэттен
Dialogue: 0,0:18:09.58,0:18:16.05,Default,,0,0,0,,Ол кезде мен хиппилермен жасырын жұмыс күнімен айналысатынмын.
Dialogue: 0,0:18:16.38,0:18:18.26,Default,,0,0,0,,Бір күні солай
Dialogue: 0,0:18:19.34,0:18:21.76,Default,,0,0,0,,Сен менің артымда тұрсың
Dialogue: 0,0:18:23.39,0:18:26.77,Default,,0,0,0,,Сен менің ессіз жекпе-жек өнерімді келекелейсің
Dialogue: 0,0:18:27.27,0:18:29.77,Default,,0,0,0,,Қорқынышты жою
Dialogue: 0,0:18:30.40,0:18:31.77,Default,,0,0,0,,Бетті бұзу
Dialogue: 0,0:18:32.52,0:18:33.77,Default,,0,0,0,,Қолды жою
Dialogue: 0,0:18:34.27,0:18:35.78,Default,,0,0,0,,Аяқтарды бұзу
Dialogue: 0,0:18:36.40,0:18:41.37,Default,,0,0,0,,Адам ағзасы өлімнен әрең құтылады.
Dialogue: 0,0:18:43.74,0:18:48.29,Default,,0,0,0,,Сол күннен кейінгі өмірімді елестете аласыз ба?
Dialogue: 0,0:18:48.79,0:18:49.83,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:51.38,0:18:54.71,Default,,0,0,0,,Дұрыс мүшелер жоқ
Dialogue: 0,0:18:56.00,0:18:58.30,Default,,0,0,0,,Мен сенімен танысқым келді
Dialogue: 0,0:18:58.88,0:19:02.30,Default,,0,0,0,,Мен көптен бері дайындалдым.
Dialogue: 0,0:19:05.01,0:19:08.31,Default,,0,0,0,,Бүгін Осы күнге
Dialogue: 0,0:19:10.02,0:19:12.40,Default,,0,0,0,,Көшбасшылықты алмағанына өкінемін
Dialogue: 0,0:19:13.11,0:19:17.32,Default,,0,0,0,,Сол кезде мені өлтіруіңіз керек еді.
Dialogue: 0,0:19:18.82,0:19:20.32,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:23.37,0:19:25.33,Default,,0,0,0,,Қандай үлкен түсінбеушілік.
Dialogue: 0,0:19:26.24,0:19:29.75,Default,,0,0,0,,20 жылдан астам бұрын бөшкелерге құйылған шарап
Dialogue: 0,0:19:29.96,0:19:34.33,Default,,0,0,0,,Мен оны тығындап, стаканға құйып жіберейін деп тұрғандай.
Dialogue: 0,0:19:35.04,0:19:38.34,Default,,0,0,0,,Мен бақыттымын, қызық... нихи
Dialogue: 0,0:19:38.67,0:19:40.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:42.22,0:19:45.01,Default,,0,0,0,,Алдымен киген нәрсені шешіңіз.
Dialogue: 0,0:19:45.30,0:19:47.35,Default,,0,0,0,,Жоғары және төмен, бәрі.
Dialogue: 0,0:19:48.22,0:19:49.52,Default,,0,0,0,,Хмм? Хмм...
Dialogue: 0,0:20:03.91,0:20:06.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:06.20,0:20:09.87,Default,,0,0,0,,Қарапайым полицейдің үміті үзілді.
Dialogue: 0,0:20:12.83,0:20:14.37,Default,,0,0,0,,ұсақ ұрлық жасап, соққы беріп қашып кету қылмыстарын жасап, полиция көлігінің терезелерін сындыратын
Dialogue: 0,0:20:14.79,0:20:16.88,Default,,0,0,0,,Мен бүгін түнді күттім
Dialogue: 0,0:20:17.63,0:20:20.55,Default,,0,0,0,,Бас қосқанымызға қуанайық
Dialogue: 0,0:20:20.71,0:20:21.88,Default,,0,0,0,,Джефф
Dialogue: 0,0:20:22.13,0:20:24.84,Default,,0,0,0,,Мм... мм...
Dialogue: 0,0:20:25.05,0:20:31.43,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:20:32.64,0:20:34.14,Default,,0,0,0,,(тамшылаған қан дыбысы)
Dialogue: 0,0:20:38.52,0:20:40.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:41.40,0:20:43.53,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:20:43.70,0:20:45.24,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,0:20:46.28,0:20:48.16,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:20:48.66,0:20:51.12,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:20:56.17,0:20:58.59,Default,,0,0,0,,Мылтық тым кішкентай
Dialogue: 0,0:20:58.75,0:21:00.59,Default,,0,0,0,,Сәлем Джефф
Dialogue: 0,0:21:01.26,0:21:03.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:03.80,0:21:07.18,Default,,0,0,0,,Сіз мені шолақ мылтықпен ала алмайсыз.
Dialogue: 0,0:21:08.05,0:21:12.68,Default,,0,0,0,,Ірі аңдарды мылтықпен түсіре алмайсың.
Dialogue: 0,0:21:14.89,0:21:16.69,Default,,0,0,0,,Мен оны білдім
Dialogue: 0,0:21:17.56,0:21:19.11,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:21:19.27,0:21:21.61,Default,,0,0,0,,Келесіге дайын сияқтысыз.
Dialogue: 0,0:21:26.45,0:21:30.70,Default,,0,0,0,,Енді сіз осында болсаңыз, бұл күту емес.
Dialogue: 0,0:21:37.04,0:21:40.21,Default,,0,0,0,,Қаха! Самурай қылыш дегеніміз не?
Dialogue: 0,0:21:40.67,0:21:42.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:45.76,0:21:47.47,Default,,0,0,0,,Бұл осылай жұмыс істеуі мүмкін...
Dialogue: 0,0:21:48.72,0:21:49.97,Default,,0,0,0,,Мен оны білдім!
Dialogue: 0,0:21:51.64,0:21:52.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:53.06,0:21:54.47,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:55.39,0:21:58.98,Default,,0,0,0,,Жүректі табақпен жабыңыз.
Dialogue: 0,0:21:59.40,0:22:00.48,Default,,0,0,0,,Охххх
Dialogue: 0,0:22:01.40,0:22:02.98,Default,,0,0,0,,Қашу мүмкін емес!
Dialogue: 0,0:22:03.90,0:22:05.69,Default,,0,0,0,,Сіз қызықсыз
Dialogue: 0,0:22:06.24,0:22:07.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:08.11,0:22:09.99,Default,,0,0,0,,Хмм! Ууууу!
Dialogue: 0,0:22:10.24,0:22:12.49,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:22:14.62,0:22:16.16,Default,,0,0,0,,О!
Dialogue: 0,0:22:16.79,0:22:17.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:18.25,0:22:19.75,Default,,0,0,0,,Ақымақ! Хе-хе-хе! ➡
Dialogue: 0,0:22:21.00,0:22:27.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:44.04,0:23:50.05,Default,,0,0,0,,~♪
Dialogue: 0,0:23:51.55,0:23:57.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory