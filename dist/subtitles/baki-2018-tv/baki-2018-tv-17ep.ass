Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,‎NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.46,0:00:17.47,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:48.14,0:01:51.06,Default,,0,0,0,,‎ (Коушо) Оның денесінде күшті серіппесі бар.
Dialogue: 0,0:01:51.65,0:01:54.82,Default,,0,0,0,,‎Егер ол қашықтыққа жетсе, ол еш ойланбастан қаруын қолданады.
Dialogue: 0,0:02:00.45,0:02:01.57,Default,,0,0,0,,Уақыт бойынша...
Dialogue: 0,0:02:03.33,0:02:04.33,Default,,0,0,0,,Бұл бар!
Dialogue: 0,0:02:06.58,0:02:07.58,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:02:09.58,0:02:10.58,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:02:10.96,0:02:11.79,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:02:12.04,0:02:13.34,Default,,0,0,0,,Неге келмейсің?
Dialogue: 0,0:02:13.71,0:02:14.84,Default,,0,0,0,,‎Егер ол келсе, ол қозғалады
Dialogue: 0,0:02:15.00,0:02:15.84,Default,,0,0,0,,Дереу!
Dialogue: 0,0:02:16.13,0:02:17.17,Default,,0,0,0,,‎Сен не істеп жатырсың!
Dialogue: 0,0:02:17.38,0:02:18.63,Default,,0,0,0,,‎Неге қозғалмайсың!
Dialogue: 0,0:02:18.80,0:02:21.85,Default,,0,0,0,,‎Қанша жылдам қозғалсаңыз да, не пайдалансаңыз да
Dialogue: 0,0:02:22.01,0:02:24.31,Default,,0,0,0,,Жекпе-жек шебері ретінде мен бірінші келемін.
Dialogue: 0,0:02:24.72,0:02:25.60,Default,,0,0,0,,Қол?
Dialogue: 0,0:02:26.02,0:02:26.85,Default,,0,0,0,,Шынтақ?
Dialogue: 0,0:02:27.27,0:02:28.10,Default,,0,0,0,,Аяқ?
Dialogue: 0,0:02:28.52,0:02:29.35,Default,,0,0,0,,Тізе?
Dialogue: 0,0:02:30.52,0:02:31.35,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:02:33.52,0:02:35.15,Default,,0,0,0,,‎Чи!
Dialogue: 0,0:02:35.69,0:02:37.78,Default,,0,0,0,,‎(Жарылыс дыбысы)
Dialogue: 0,0:02:50.54,0:02:51.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:57.30,0:03:00.26,Default,,0,0,0,,‎Мұны ер жекпе-жек деп атауға бола ма?
Dialogue: 0,0:03:00.76,0:03:01.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:01.89,0:03:05.60,Default,,0,0,0,,Пышақтар, серіппелер және жарылғыш заттар
Dialogue: 0,0:03:06.97,0:03:09.23,Default,,0,0,0,,‎Бұл ұрыс емес!
Dialogue: 0,0:03:12.06,0:03:14.02,Default,,0,0,0,,Ұрыс...
Dialogue: 0,0:03:14.27,0:03:16.27,Default,,0,0,0,,Ұрыс дегеніміз не?
Dialogue: 0,0:03:16.86,0:03:17.86,Default,,0,0,0,,‎Уһ…
Dialogue: 0,0:03:18.19,0:03:19.03,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:19.44,0:03:22.03,Default,,0,0,0,,Айтыңызшы, ұрыс.
Dialogue: 0,0:03:24.24,0:03:27.04,Default,,0,0,0,,‎ Олай болса мен сізге сұрақ қоюға рұқсат етіңіз.
Dialogue: 0,0:03:27.83,0:03:30.75,Default,,0,0,0,,‎Егер мен сенімен осы жерде соғысатын болсам
Dialogue: 0,0:03:30.91,0:03:33.54,Default,,0,0,0,,Егер мен тапаншаны шығарсам ше?
Dialogue: 0,0:03:33.71,0:03:36.54,Default,,0,0,0,,Иә? Неге қолданбасқа?
Dialogue: 0,0:03:36.92,0:03:37.92,Default,,0,0,0,,На…
Dialogue: 0,0:03:38.42,0:03:42.13,Default,,0,0,0,,‎ Егер сізге жеңу үшін тапанша қажет болса, оны ойланбастан пайдалану керек.
Dialogue: 0,0:03:42.30,0:03:43.26,Default,,0,0,0,,Ух...
Dialogue: 0,0:03:43.55,0:03:45.76,Default,,0,0,0,,‎Сендер қателестіңдер.
Dialogue: 0,0:03:45.93,0:03:47.81,Default,,0,0,0,,Мен күрескер емеспін
Dialogue: 0,0:03:48.31,0:03:52.77,Default,,0,0,0,,Мен әлем чемпионы болуды немесе атақ-даңқ іздеуді мақсат етіп отырған жоқпын.
Dialogue: 0,0:03:53.19,0:03:56.11,Default,,0,0,0,,‎Мен білсем жақсы болар еді
Dialogue: 0,0:03:56.27,0:03:58.07,Default,,0,0,0,,Менің ең күшті
Dialogue: 0,0:03:58.69,0:04:01.53,Default,,0,0,0,,‎ Сіз үшін ең күштісі қайсысы?
Dialogue: 0,0:04:01.69,0:04:03.91,Default,,0,0,0,,Ешкімге жеңілме
Dialogue: 0,0:04:04.07,0:04:07.62,Default,,0,0,0,,‎Бірақ сіз жеңілгеніңізді білгіңіз келеді
Dialogue: 0,0:04:08.74,0:04:12.25,Default,,0,0,0,,Жеңілістен ләззат алудың ең жақсы жолы
Dialogue: 0,0:04:12.41,0:04:14.08,Default,,0,0,0,,Бар күш-жігерімді салған соң
Dialogue: 0,0:04:14.25,0:04:16.33,Default,,0,0,0,,Жеңістен айырылу
Dialogue: 0,0:04:16.75,0:04:18.04,Default,,0,0,0,,Алайда
Dialogue: 0,0:04:18.21,0:04:20.92,Default,,0,0,0,,Бұл да бүгін орындалмады.
Dialogue: 0,0:04:21.09,0:04:25.05,Default,,0,0,0,,‎Фуфуфуфуфуфу…
Dialogue: 0,0:04:25.97,0:04:28.35,Default,,0,0,0,,Боксшы шынымен тәтті
Dialogue: 0,0:04:29.60,0:04:32.68,Default,,0,0,0,,‎Егер менде ядролық зымыран болса
Dialogue: 0,0:04:32.85,0:04:35.60,Default,,0,0,0,,Мен сіз үшін қосқышты аударғым келеді.
Dialogue: 0,0:04:36.56,0:04:38.61,Default,,0,0,0,,Әрине, бұл да дұрыс.
Dialogue: 0,0:04:38.77,0:04:39.61,Default,,0,0,0,,Алайда
Dialogue: 0,0:04:40.65,0:04:44.95,Default,,0,0,0,,‎Егер мен аяқтамай-ақ қосқышты баса алсаңыз.
Dialogue: 0,0:04:45.70,0:04:49.74,Default,,0,0,0,,‎(ит үреді)
Dialogue: 0,0:04:55.25,0:04:57.96,Default,,0,0,0,,‎(Кокозуэ) Сүйіктіммен салыстырғанда, мен ең мықты екенімді сене алар емеспін.
Dialogue: 0,0:04:58.54,0:05:00.34,Default,,0,0,0,,Ең күштісі қандай?
Dialogue: 0,0:05:01.05,0:05:02.88,Default,,0,0,0,,Мен ғана білемін
Dialogue: 0,0:05:03.55,0:05:04.38,Default,,0,0,0,,‎(Кухун)
Dialogue: 0,0:05:05.30,0:05:06.13,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:06.43,0:05:08.01,Default,,0,0,0,,‎
Dialogue: 0,0:05:09.43,0:05:10.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:16.14,0:05:18.90,Default,,0,0,0,,Жоғары көтеріліңіз... жарай ма?
Dialogue: 0,0:05:31.49,0:05:33.04,Default,,0,0,0,,‎Баки-кун туралы
Dialogue: 0,0:05:35.58,0:05:38.79,Default,,0,0,0,,Мен Баки-кун туралы көптен бері ойлап жүрдім.
Dialogue: 0,0:05:42.50,0:05:44.67,Default,,0,0,0,,Менің ойыма басқа ештеңе келмейді
Dialogue: 0,0:05:45.80,0:05:47.84,Default,,0,0,0,,‎Тамақтанып отырсаңыз да
Dialogue: 0,0:05:48.01,0:05:49.43,Default,,0,0,0,,Кітап оқығанда да
Dialogue: 0,0:05:50.34,0:05:52.64,Default,,0,0,0,,‎Күлсең де, жыласаң да
Dialogue: 0,0:05:53.26,0:05:57.06,Default,,0,0,0,,‎Сен не істесең де, сенің басыңда әрқашан мен бармын...
Dialogue: 0,0:05:57.35,0:05:58.19,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:05:58.98,0:05:59.90,Default,,0,0,0,,Мен де
Dialogue: 0,0:06:00.06,0:06:00.90,Default,,0,0,0,,А...
Dialogue: 0,0:06:03.36,0:06:05.49,Default,,0,0,0,,Тіс ауруы сияқты
Dialogue: 0,0:06:05.65,0:06:07.95,Default,,0,0,0,,‎Мен не істесем де, Қозуэ жоғалмайды
Dialogue: 0,0:06:09.11,0:06:09.95,Default,,0,0,0,,‎Хмм.
Dialogue: 0,0:06:10.45,0:06:11.62,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:06:13.37,0:06:14.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:14.58,0:06:15.70,Default,,0,0,0,,‎Қайырлы түн, мен сені мазалап жатырмын.
Dialogue: 0,0:06:15.87,0:06:16.70,Default,,0,0,0,,Е...
Dialogue: 0,0:06:17.25,0:06:19.21,Default,,0,0,0,,‎(Кузуэ) Егер мен өзімнің сезімімді айтсам
Dialogue: 0,0:06:19.37,0:06:20.88,Default,,0,0,0,,Аздап тынышталды
Dialogue: 0,0:06:21.04,0:06:21.96,Default,,0,0,0,,Үйге барасың ба?
Dialogue: 0,0:06:24.13,0:06:24.96,Default,,0,0,0,,Мен тағы келемін
Dialogue: 0,0:06:26.13,0:06:26.96,Default,,0,0,0,,Иә
Dialogue: 0,0:06:28.30,0:06:29.22,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:06:29.80,0:06:30.97,Default,,0,0,0,,Түнде болыңыз.
Dialogue: 0,0:06:31.55,0:06:32.47,Default,,0,0,0,,‎(Коузуэ) Қайырлы түн
Dialogue: 0,0:06:32.64,0:06:34.22,Default,,0,0,0,,‎(есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:06:34.97,0:06:37.23,Default,,0,0,0,,‎(Алысқан аяқ дыбысы)
Dialogue: 0,0:06:38.89,0:06:40.23,Default,,0,0,0,,‎Түнде қалуыңызды өтінемін...
Dialogue: 0,0:06:46.03,0:06:47.15,Default,,0,0,0,,‎ Kozue…
Dialogue: 0,0:06:47.53,0:06:48.57,Default,,0,0,0,,‎Куузэ…
Dialogue: 0,0:06:48.90,0:06:50.45,Default,,0,0,0,,‎Коузуэ… Козуэ…
Dialogue: 0,0:06:50.61,0:06:51.45,Default,,0,0,0,,‎(есіктің ашылған дыбысы)
Dialogue: 0,0:06:51.61,0:06:52.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:52.82,0:06:54.53,Default,,0,0,0,,‎Сусабын жұпары
Dialogue: 0,0:06:54.87,0:06:55.74,Default,,0,0,0,,Коузуэ!
Dialogue: 0,0:06:55.99,0:06:58.12,Default,,0,0,0,,‎(Мата үйкелу дыбысы)
Dialogue: 0,0:06:58.41,0:07:00.75,Default,,0,0,0,,Сіз киіміңізді шешіп жатырсыз ба?
Dialogue: 0,0:07:03.42,0:07:06.17,Default,,0,0,0,,Козуэ жалаңаш...
Dialogue: 0,0:07:06.34,0:07:09.51,Default,,0,0,0,,‎Мүмкін ол менің төсегіме кіруге тырысып жатқан шығар.
Dialogue: 0,0:07:09.67,0:07:10.51,Default,,0,0,0,,Жалаңаш
Dialogue: 0,0:07:14.30,0:07:15.56,Default,,0,0,0,,Еңкейіп отыру...
Dialogue: 0,0:07:15.81,0:07:17.27,Default,,0,0,0,,‎Тыныс алу дыбысы жақындады
Dialogue: 0,0:07:19.35,0:07:20.48,Default,,0,0,0,,Келеді!
Dialogue: 0,0:07:21.35,0:07:23.77,Default,,0,0,0,,Міне осында!
Dialogue: 0,0:07:23.98,0:07:26.52,Default,,0,0,0,,‎(жүрек соғу дыбысы)
Dialogue: 0,0:07:26.77,0:07:29.15,Default,,0,0,0,,‎Бұл футонда!
Dialogue: 0,0:07:29.32,0:07:31.49,Default,,0,0,0,,‎Жақсы иіс...шампунь? Емдеу?
Dialogue: 0,0:07:31.65,0:07:33.91,Default,,0,0,0,,Қайсысы маңызды емес! Міне бітті!
Dialogue: 0,0:07:35.78,0:07:37.79,Default,,0,0,0,,Бұл теріңізге тиіп тұр!
Dialogue: 0,0:07:37.95,0:07:39.58,Default,,0,0,0,,‎Суық~
Dialogue: 0,0:07:39.75,0:07:40.79,Default,,0,0,0,,‎Тері жұмсақ
Dialogue: 0,0:07:40.96,0:07:42.29,Default,,0,0,0,,Іш киім? Толық жалаңаш емес
Dialogue: 0,0:07:42.46,0:07:44.17,Default,,0,0,0,,Оны шешуім керек пе?
Dialogue: 0,0:07:44.33,0:07:46.17,Default,,0,0,0,,‎(жүрек соғу дыбысы)
Dialogue: 0,0:07:46.34,0:07:48.59,Default,,0,0,0,,‎Жүректің соғуы... менікі! Қандай үлкен дыбыс
Dialogue: 0,0:07:48.75,0:07:50.01,Default,,0,0,0,,Бұл болып жатқаны анық.
Dialogue: 0,0:07:50.17,0:07:51.80,Default,,0,0,0,,‎Менің ойымша, сіз білесіз~
Dialogue: 0,0:07:51.97,0:07:54.22,Default,,0,0,0,,Сіздің көңіліңіз қалған сияқты.
Dialogue: 0,0:07:54.39,0:07:57.18,Default,,0,0,0,,‎Мен ояу болсам да, мен ештеңе істей алмаймын ...
Dialogue: 0,0:07:59.72,0:08:01.43,Default,,0,0,0,,‎(Козуэ) Мен білмедім...
Dialogue: 0,0:08:01.64,0:08:03.06,Default,,0,0,0,,Бұл үлкен ме?
Dialogue: 0,0:08:03.23,0:08:04.60,Default,,0,0,0,,‎Баки-кунның арқасы…
Dialogue: 0,0:08:05.31,0:08:06.48,Default,,0,0,0,,‎Жұмсақ
Dialogue: 0,0:08:06.65,0:08:07.69,Default,,0,0,0,,Бұлшықеттер…
Dialogue: 0,0:08:07.86,0:08:09.11,Default,,0,0,0,,Дәл әйел сияқты
Dialogue: 0,0:08:09.69,0:08:13.15,Default,,0,0,0,,‎Талай алыптарды жеңген болат дене
Dialogue: 0,0:08:13.32,0:08:14.86,Default,,0,0,0,,‎Сондай жұмсақ...
Dialogue: 0,0:08:15.66,0:08:18.62,Default,,0,0,0,,‎Сен кімдікісің... Баки-кун?
Dialogue: 0,0:08:19.45,0:08:20.95,Default,,0,0,0,,Сенің анаң?
Dialogue: 0,0:08:21.12,0:08:22.25,Default,,0,0,0,,Әке?
Dialogue: 0,0:08:22.41,0:08:23.75,Default,,0,0,0,,Қарсыластар?
Dialogue: 0,0:08:23.92,0:08:24.92,Default,,0,0,0,,Жау?
Dialogue: 0,0:08:25.96,0:08:27.63,Default,,0,0,0,,Енді бұл менікі
Dialogue: 0,0:08:28.79,0:08:29.63,Default,,0,0,0,,‎
Dialogue: 0,0:08:29.80,0:08:31.76,Default,,0,0,0,,‎ Бұл дыбыс та үлкен
Dialogue: 0,0:08:31.92,0:08:34.05,Default,,0,0,0,,Бұл дыбысты жұту!
Dialogue: 0,0:08:34.22,0:08:36.34,Default,,0,0,0,,‎Хмм! Мені құшақтап жатыр!
Dialogue: 0,0:08:36.51,0:08:38.47,Default,,0,0,0,,Сіздің ерніңіз иығыңызға тиіп тұр.
Dialogue: 0,0:08:38.80,0:08:39.64,Default,,0,0,0,,Поцелу
Dialogue: 0,0:08:39.81,0:08:40.64,Default,,0,0,0,,‎Табиғи емес
Dialogue: 0,0:08:40.81,0:08:43.85,Default,,0,0,0,,Мен байқамай ұйықтай беруім табиғи емес!
Dialogue: 0,0:08:44.10,0:08:46.19,Default,,0,0,0,,‎Мен мұны істеймін... Не?
Dialogue: 0,0:08:46.35,0:08:47.65,Default,,0,0,0,,‎Секс!
Dialogue: 0,0:08:50.82,0:08:51.65,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:09:00.99,0:09:01.83,Default,,0,0,0,,‎(Козуэ) Е...
Dialogue: 0,0:09:02.04,0:09:02.87,Default,,0,0,0,,‎Ха...!
Dialogue: 0,0:09:04.00,0:09:05.67,Default,,0,0,0,,Хобби өте нашар
Dialogue: 0,0:09:05.83,0:09:08.17,Default,,0,0,0,,‎Сен менің күйеуімнің ісін қарауға қалай дәтің бардың?
Dialogue: 0,0:09:08.58,0:09:09.42,Default,,0,0,0,,‎(Юдзиро) Аяқ…
Dialogue: 0,0:09:10.17,0:09:12.00,Default,,0,0,0,,&lrm; …
Dialogue: 0,0:09:12.67,0:09:14.30,Default,,0,0,0,,Қызықты бірдеңе айтыңыз
Dialogue: 0,0:09:14.92,0:09:18.80,Default,,0,0,0,,‎Сізді сынап, дірілдеген әйелге арқаңызды бұру «іс» деп аталады.
Dialogue: 0,0:09:19.47,0:09:22.31,Default,,0,0,0,,‎Биологиялық тарихтың басынан бері.
Dialogue: 0,0:09:22.56,0:09:23.47,Default,,0,0,0,,‎Ku…
Dialogue: 0,0:09:25.27,0:09:27.06,Default,,0,0,0,,‎(Юдзиро) Саған айтар сөзім бар.
Dialogue: 0,0:09:27.56,0:09:30.06,Default,,0,0,0,,‎Түстермен ойнайтын күндерде
Dialogue: 0,0:09:30.77,0:09:33.36,Default,,0,0,0,,Ей, надан әрі таяз адамдар
Dialogue: 0,0:09:33.53,0:09:36.15,Default,,0,0,0,,Сіз бәрін шешкіңіз келеді.
Dialogue: 0,0:09:36.36,0:09:39.78,Default,,0,0,0,,‎Улар да, дәрі де емес кәмпит сияқты кеңес
Dialogue: 0,0:09:39.95,0:09:41.08,Default,,0,0,0,,Қажетсіз күтім
Dialogue: 0,0:09:41.33,0:09:42.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.83,0:09:44.54,Default,,0,0,0,,Мүлдем тыңдамаңыз
Dialogue: 0,0:09:44.70,0:09:45.54,Default,,0,0,0,,бұл…
Dialogue: 0,0:09:45.71,0:09:46.54,Default,,0,0,0,,А...
Dialogue: 0,0:09:47.04,0:09:49.46,Default,,0,0,0,,‎Абстиненттің соңында жеткен мемлекет және т.б.
Dialogue: 0,0:09:49.63,0:09:51.09,Default,,0,0,0,,Тек белгілі нәрселер
Dialogue: 0,0:09:52.13,0:09:54.09,Default,,0,0,0,,‎Күшті болғың келсе, же!
Dialogue: 0,0:09:54.59,0:09:56.76,Default,,0,0,0,,Таңертең, түсте немесе түнде тамақтанбаңыз
Dialogue: 0,0:09:56.92,0:09:59.59,Default,,0,0,0,,Етті тамақ алдында немесе тамақтан кейін жеңіз.
Dialogue: 0,0:10:00.01,0:10:01.60,Default,,0,0,0,,Тойғанша тамақтаныңыз
Dialogue: 0,0:10:01.80,0:10:03.81,Default,,0,0,0,,‎Қанағаттанғанша тамақтаныңыз
Dialogue: 0,0:10:04.06,0:10:05.47,Default,,0,0,0,,‎Оны же, оны же...
Dialogue: 0,0:10:05.64,0:10:06.60,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:10:08.27,0:10:09.10,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:10:10.19,0:10:11.61,Default,,0,0,0,,Тоя Козуэ
Dialogue: 0,0:10:11.90,0:10:12.73,Default,,0,0,0,,бұл...
Dialogue: 0,0:10:13.82,0:10:15.65,Default,,0,0,0,,Өзіңізді жетілдіріңіз
Dialogue: 0,0:10:15.90,0:10:17.24,Default,,0,0,0,,Әйел ретінде
Dialogue: 0,0:10:17.57,0:10:18.61,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:10:18.90,0:10:23.20,Default,,0,0,0,,‎Таусылғанша тамақтандырсам да, мен әлі тоймайтын ұрғашымын.
Dialogue: 0,0:10:24.37,0:10:27.04,Default,,0,0,0,,Ашкөз әйел бол
Dialogue: 0,0:10:30.08,0:10:32.84,Default,,0,0,0,,Екеуіңізге батасын беремін.
Dialogue: 0,0:10:33.79,0:10:35.21,Default,,0,0,0,,‎(есік жабылған дыбыс)
Dialogue: 0,0:10:37.88,0:10:39.13,Default,,0,0,0,,‎(2 адам) А...
Dialogue: 0,0:10:40.55,0:10:41.89,Default,,0,0,0,,Жеңдер...
Dialogue: 0,0:10:46.31,0:10:48.14,Default,,0,0,0,,Жеу...?
Dialogue: 0,0:10:48.64,0:10:49.64,Default,,0,0,0,,Ух...
Dialogue: 0,0:10:55.48,0:10:56.44,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:10:57.94,0:10:59.40,Default,,0,0,0,,Сізбен жыныстық қатынасқа түсу
Dialogue: 0,0:10:59.90,0:11:00.74,Default,,0,0,0,,А...
Dialogue: 0,0:11:01.24,0:11:02.07,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:11:02.28,0:11:03.91,Default,,0,0,0,,‎Себебі сіз күштірек болғыңыз келе ме?
Dialogue: 0,0:11:04.08,0:11:04.91,Default,,0,0,0,,№.
Dialogue: 0,0:11:05.58,0:11:06.66,Default,,0,0,0,,‎Себебі мен қалаймын
Dialogue: 0,0:11:06.83,0:11:07.83,Default,,0,0,0,,Мен сенімен біргемін
Dialogue: 0,0:11:08.62,0:11:10.37,Default,,0,0,0,,Мен мұны тек Козуэмен ғана жасағым келеді.
Dialogue: 0,0:11:11.08,0:11:12.38,Default,,0,0,0,,Әке сөзі
Dialogue: 0,0:11:12.54,0:11:13.83,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:14.00,0:11:15.67,Default,,0,0,0,,‎Ал мұның оған еш қатысы жоқ.
Dialogue: 0,0:11:21.97,0:11:22.84,Default,,0,0,0,,‎Фу…
Dialogue: 0,0:11:24.60,0:11:25.68,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:26.06,0:11:26.97,Default,,0,0,0,,‎Келесі…
Dialogue: 0,0:11:27.56,0:11:29.48,Default,,0,0,0,,Келесі жолы кездесеміз
Dialogue: 0,0:11:29.89,0:11:31.19,Default,,0,0,0,,Мен сенімен боламын
Dialogue: 0,0:11:31.48,0:11:32.44,Default,,0,0,0,,А...
Dialogue: 0,0:11:37.36,0:11:38.19,Default,,0,0,0,,Иә
Dialogue: 0,0:11:38.69,0:11:39.53,Default,,0,0,0,,‎Фу…
Dialogue: 0,0:11:40.61,0:11:41.45,Default,,0,0,0,,‎Hehe…
Dialogue: 0,0:11:51.25,0:11:52.08,Default,,0,0,0,,‎(Ретсу) Әй...
Dialogue: 0,0:11:55.33,0:11:56.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:57.46,0:11:59.13,Default,,0,0,0,,‎(Ер) Ммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:11:59.30,0:12:00.80,Default,,0,0,0,,‎(Сатушы) Күткеніңізге рахмет.
Dialogue: 0,0:12:02.59,0:12:05.85,Default,,0,0,0,,‎(Ретсу) Қуырылған емізетін шошқаны өзіңіз жейсіз бе?
Dialogue: 0,0:12:07.18,0:12:08.47,Default,,0,0,0,,Үлкен…
Dialogue: 0,0:12:09.06,0:12:10.06,Default,,0,0,0,,‎2 метр…
Dialogue: 0,0:12:10.22,0:12:12.89,Default,,0,0,0,,‎No... 2 метр 10 сантиметр
Dialogue: 0,0:12:13.06,0:12:14.10,Default,,0,0,0,,‎Одан да көп…
Dialogue: 0,0:12:19.32,0:12:20.40,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:12:20.69,0:12:21.57,Default,,0,0,0,,Бос па?
Dialogue: 0,0:12:21.74,0:12:24.36,Default,,0,0,0,,Емізетін шошқаны небәрі 10 секундта қуырыңыз
Dialogue: 0,0:12:31.58,0:12:32.87,Default,,0,0,0,,‎Бұл не үшін?
Dialogue: 0,0:12:33.37,0:12:35.08,Default,,0,0,0,,‎(Ер адам) есімде.
Dialogue: 0,0:12:35.25,0:12:37.63,Default,,0,0,0,,Мен мұны бұрын бір жерден көрген бет деп ойладым.
Dialogue: 0,0:12:38.04,0:12:38.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:39.04,0:12:40.92,Default,,0,0,0,,‎(Ер адам) Бұл жер асты стадионы.
Dialogue: 0,0:12:41.26,0:12:42.80,Default,,0,0,0,,Турнир…
Dialogue: 0,0:12:43.22,0:12:44.51,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:12:44.68,0:12:46.55,Default,,0,0,0,,Қытай кемпосы
Dialogue: 0,0:12:46.72,0:12:48.14,Default,,0,0,0,,Рецу Кайоу
Dialogue: 0,0:12:49.51,0:12:50.35,Default,,0,0,0,,‎(Retsu) Сіз...
Dialogue: 0,0:12:51.43,0:12:52.89,Default,,0,0,0,,Джек Хаммер?
Dialogue: 0,0:12:53.10,0:12:54.39,Default,,0,0,0,,Хмм…
Dialogue: 0,0:12:56.60,0:12:58.90,Default,,0,0,0,,‎(Әңгімелеу) Канададан келген шұңқырлы жауынгер
Dialogue: 0,0:13:00.73,0:13:04.49,Default,,0,0,0,,Төтенше допинг және дәстүрлі емес жаттығулар арқылы
Dialogue: 0,0:13:04.65,0:13:07.45,Default,,0,0,0,,‎Түпкілікті денені алған адам
Dialogue: 0,0:13:07.87,0:13:10.91,Default,,0,0,0,,‎Және Юдзиро Ханманың ұлы.
Dialogue: 0,0:13:11.08,0:13:13.29,Default,,0,0,0,,Бақидың туған інісі
Dialogue: 0,0:13:17.50,0:13:19.17,Default,,0,0,0,,‎(Күзгі жапырақтар) Анаболикалық стероидтер
Dialogue: 0,0:13:20.25,0:13:22.42,Default,,0,0,0,,Өте жоғары тазалық
Dialogue: 0,0:13:24.30,0:13:28.51,Default,,0,0,0,,Қасиетті жекпе-жек матчтарында қолданылатын есірткілер...
Dialogue: 0,0:13:29.05,0:13:32.18,Default,,0,0,0,,‎Сен мені қандай қорқақ адам дейсің?
Dialogue: 0,0:13:33.14,0:13:34.10,Default,,0,0,0,,Джек
Dialogue: 0,0:13:34.27,0:13:35.94,Default,,0,0,0,,Мен финалдан шығып жатырмын.
Dialogue: 0,0:13:36.35,0:13:37.44,Default,,0,0,0,,‎Hmph
Dialogue: 0,0:13:41.36,0:13:42.19,Default,,0,0,0,,‎(Күзгі жапырақтар) Ах...
Dialogue: 0,0:13:42.82,0:13:44.19,Default,,0,0,0,,Уф
Dialogue: 0,0:13:44.78,0:13:47.07,Default,,0,0,0,,Енді дәрі тозды
Dialogue: 0,0:13:47.24,0:13:49.70,Default,,0,0,0,,‎Сен мені жеңе аламын деп ойлайсың ба?
Dialogue: 0,0:13:50.07,0:13:51.08,Default,,0,0,0,,Арғ!
Dialogue: 0,0:13:51.37,0:13:53.58,Default,,0,0,0,,‎Ух... аа...
Dialogue: 0,0:13:54.04,0:13:55.58,Default,,0,0,0,,О...
Dialogue: 0,0:13:55.96,0:13:58.46,Default,,0,0,0,,‎Екі қолыммен мен табиғи көрінемін...
Dialogue: 0,0:13:58.62,0:14:01.21,Default,,0,0,0,,Сіз ұтыла алмаймын деп ойлайсыз ба?
Dialogue: 0,0:14:01.79,0:14:03.25,Default,,0,0,0,,‎(Күзгі жапырақтар) О... Уф
Dialogue: 0,0:14:03.42,0:14:06.17,Default,,0,0,0,,‎Аа... аа... уф
Dialogue: 0,0:14:06.34,0:14:07.72,Default,,0,0,0,,‎Уф... Уф!
Dialogue: 0,0:14:08.43,0:14:10.47,Default,,0,0,0,,Қарғыс атсын... Ааа!
Dialogue: 0,0:14:10.76,0:14:11.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:13.64,0:14:16.23,Default,,0,0,0,,‎А... аа...
Dialogue: 0,0:14:18.52,0:14:20.73,Default,,0,0,0,,‎Куку… аа аа
Dialogue: 0,0:14:21.36,0:14:23.48,Default,,0,0,0,,‎Аа... ха ха!
Dialogue: 0,0:14:23.65,0:14:24.48,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:14:24.65,0:14:27.36,Default,,0,0,0,,‎Ха ха ха…
Dialogue: 0,0:14:30.20,0:14:31.37,Default,,0,0,0,,Джек!
Dialogue: 0,0:14:33.53,0:14:37.00,Default,,0,0,0,,Есірткі тек жасырын болғандықтан ғана ойнауға кедергі жасамайды!
Dialogue: 0,0:14:41.04,0:14:41.88,Default,,0,0,0,,Джек
Dialogue: 0,0:14:42.54,0:14:45.25,Default,,0,0,0,,Сіз келесі матчта міндетті түрде өлесіз
Dialogue: 0,0:14:45.84,0:14:46.92,Default,,0,0,0,,Бұл өтірік емес
Dialogue: 0,0:14:47.09,0:14:50.09,Default,,0,0,0,,Сіздің денеңіз қазірдің өзінде құлап жатыр.
Dialogue: 0,0:14:50.59,0:14:51.89,Default,,0,0,0,,‎Оны қазір сақтауға болады
Dialogue: 0,0:14:52.05,0:14:53.18,Default,,0,0,0,,Джек!
Dialogue: 0,0:14:59.10,0:15:01.02,Default,,0,0,0,,‎(Юдзиро) Бар күшіңізбен күресіңіз
Dialogue: 0,0:15:02.48,0:15:05.02,Default,,0,0,0,,‎Жер бетіндегі ең жақсы бауырластық шайқас
Dialogue: 0,0:15:14.24,0:15:15.28,Default,,0,0,0,,‎Аға
Dialogue: 0,0:15:16.37,0:15:17.58,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:18.66,0:15:20.29,Default,,0,0,0,,Мен солай сезіндім.
Dialogue: 0,0:15:21.46,0:15:22.79,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:15:26.13,0:15:27.09,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:15:27.25,0:15:29.55,Default,,0,0,0,,‎Ол денемен жақсы көтерілді.
Dialogue: 0,0:15:29.84,0:15:31.05,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:15:31.22,0:15:33.55,Default,,0,0,0,,Мен сені бар күшіммен талқандаймын
Dialogue: 0,0:15:34.05,0:15:35.89,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:15:36.35,0:15:37.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:37.47,0:15:38.31,Default,,0,0,0,,Мен де...
Dialogue: 0,0:15:40.18,0:15:41.31,Default,,0,0,0,,Мен де солай істеймін
Dialogue: 0,0:15:47.94,0:15:51.70,Default,,0,0,0,,‎Ағай, бұл соңғы техника.
Dialogue: 0,0:15:53.16,0:15:56.03,Default,,0,0,0,,‎Осы әдістемеден кейін мен...
Dialogue: 0,0:15:56.20,0:15:57.37,Default,,0,0,0,,құлау
Dialogue: 0,0:15:58.20,0:16:00.96,Default,,0,0,0,,‎Егер сіз сол кезде тұрған болсаңыз
Dialogue: 0,0:16:02.16,0:16:03.87,Default,,0,0,0,,Сіз жеңдіңіз!
Dialogue: 0,0:16:09.34,0:16:14.39,Default,,0,0,0,,‎(қуаныш)
Dialogue: 0,0:16:14.55,0:16:15.59,Default,,0,0,0,,Сіз...
Dialogue: 0,0:16:16.85,0:16:19.06,Default,,0,0,0,,‎Сен чемпионсың!
Dialogue: 0,0:16:22.89,0:16:24.23,Default,,0,0,0,,‎(Ретсу) Ол басқа адам емес пе?
Dialogue: 0,0:16:24.40,0:16:25.23,Default,,0,0,0,,&lrm;
Dialogue: 0,0:16:25.56,0:16:27.44,Default,,0,0,0,,‎Дене бітімі мүлдем басқа
Dialogue: 0,0:16:27.61,0:16:29.23,Default,,0,0,0,,Биіктігі бәрінен де жоғары
Dialogue: 0,0:16:29.69,0:16:30.53,Default,,0,0,0,,‎10 сантиметр…
Dialogue: 0,0:16:30.69,0:16:32.99,Default,,0,0,0,,‎Жоқ, 20 сантиметр?
Dialogue: 0,0:16:33.15,0:16:34.24,Default,,0,0,0,,Басқа адам?
Dialogue: 0,0:16:34.41,0:16:35.66,Default,,0,0,0,,Үшінші ағасы?
Dialogue: 0,0:16:35.95,0:16:37.99,Default,,0,0,0,,‎Бірақ сен мені білесің
Dialogue: 0,0:16:38.87,0:16:41.66,Default,,0,0,0,,‎Құпия... Табандары көтерілген аяқ киім?
Dialogue: 0,0:16:41.83,0:16:42.75,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:16:46.25,0:16:48.09,Default,,0,0,0,,‎(Әңгімелеу) Соққы жекпе-жек өнерінде
Dialogue: 0,0:16:48.25,0:16:50.50,Default,,0,0,0,,Бой маңызды фактор болып табылады
Dialogue: 0,0:16:53.17,0:16:55.55,Default,,0,0,0,,Кунг-фуды меңгерген Рецу Кайоу.
Dialogue: 0,0:16:55.72,0:16:58.72,Default,,0,0,0,,‎Биікті қате бағалауға ешқандай мүмкіндік жоқ.
Dialogue: 0,0:16:59.64,0:17:03.06,Default,,0,0,0,,‎Алайда кәмелеттік жасқа толған адамның бойы
Dialogue: 0,0:17:03.23,0:17:05.77,Default,,0,0,0,,‎Оның бұл дәрежеде өсуі мүмкін емес.
Dialogue: 0,0:17:06.15,0:17:08.73,Default,,0,0,0,,Бұл шынымен мүмкін бе?
Dialogue: 0,0:17:18.03,0:17:20.53,Default,,0,0,0,,‎(Әңгімелеу) Әлемдегі ең жақсы дәрігерлердің бірі
Dialogue: 0,0:17:20.66,0:17:24.54,Default,,0,0,0,,‎Медицина мен жекпе-жек өнерін біріктіретін әдіспен адам денесін жойыңыз.
Dialogue: 0,0:17:24.71,0:17:26.29,Default,,0,0,0,,Күшті жекпе-жек әртісі
Dialogue: 0,0:17:26.83,0:17:30.04,Default,,0,0,0,,Ол Субшо Хоның нағыз ағасы.
Dialogue: 0,0:17:30.92,0:17:33.26,Default,,0,0,0,,Бұл орынды шара емес пе?
Dialogue: 0,0:17:33.51,0:17:36.30,Default,,0,0,0,,‎Менің інім осы ауруханаға жеткізілді.
Dialogue: 0,0:17:36.63,0:17:38.72,Default,,0,0,0,,‎(Дәрігер) Жоқ, бұл мені қобалжытады.
Dialogue: 0,0:17:38.89,0:17:42.06,Default,,0,0,0,,‎Сіз өзіңіздің медициналық картаңызды нағыз доктор Хомен бірге көре аласыз
Dialogue: 0,0:17:45.60,0:17:48.56,Default,,0,0,0,,‎(Күзгі жапырақтар) Жарылғыш заттарды қолдану арқылы реттеу
Dialogue: 0,0:17:48.94,0:17:51.48,Default,,0,0,0,,‎Егер бұл жекпе-жек матчы болса
Dialogue: 0,0:17:51.65,0:17:54.19,Default,,0,0,0,,‎Бұл жақсы немесе жаман екенін шешу үшін талқылауды күтпеңіз
Dialogue: 0,0:17:54.32,0:17:55.53,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:56.74,0:17:59.11,Default,,0,0,0,,Субашоның өзі бұған кірісті.
Dialogue: 0,0:17:59.28,0:18:02.33,Default,,0,0,0,,‎Бұл сіріңке сияқты қарапайым нәрсе емес.
Dialogue: 0,0:18:03.49,0:18:04.33,Default,,0,0,0,,‎
Dialogue: 0,0:18:04.79,0:18:06.96,Default,,0,0,0,,‎(Даяшы А) Мен сүйек жеп жатырмын...
Dialogue: 0,0:18:07.29,0:18:08.58,Default,,0,0,0,,T-bone стейк
Dialogue: 0,0:18:08.75,0:18:09.83,Default,,0,0,0,,‎(Даяшы В) Профессионалды күрес?
Dialogue: 0,0:18:10.38,0:18:11.59,Default,,0,0,0,,‎(Күзгі жапырақтар) Қандай керемет...
Dialogue: 0,0:18:12.21,0:18:16.09,Default,,0,0,0,,‎Сүйекті ұзарту операциясының әсері соншалықты айқын болған мысал болды
Dialogue: 0,0:18:16.26,0:18:18.09,Default,,0,0,0,,Бұл әлемде бұрын-соңды болмаған оқиға болар еді.
Dialogue: 0,0:18:18.34,0:18:22.30,Default,,0,0,0,,‎Және бір жылдан аз уақыт ішінде 20 сантиметр
Dialogue: 0,0:18:22.47,0:18:25.10,Default,,0,0,0,,‎Спорттық қабілетін жоғалтпай
Dialogue: 0,0:18:25.35,0:18:26.48,Default,,0,0,0,,Керісінше...
Dialogue: 0,0:18:26.64,0:18:30.06,Default,,0,0,0,,‎Ол тіпті сіздің бойыңызға тура пропорционалды түрде созылған.
Dialogue: 0,0:18:31.77,0:18:32.86,Default,,0,0,0,,‎(Әңгімелеу) Сүйектің ұзаруы
Dialogue: 0,0:18:35.11,0:18:37.95,Default,,0,0,0,,‎Шемiршек өсiмiнiң бұзылуына байланысты бойы тоқтайды.
Dialogue: 0,0:18:38.11,0:18:40.49,Default,,0,0,0,,‎Ахондроплазиясы бар науқастар және
Dialogue: 0,0:18:41.45,0:18:42.66,Default,,0,0,0,,‎Ұсақталған сынық және т.б.
Dialogue: 0,0:18:42.83,0:18:45.99,Default,,0,0,0,,Сүйектің бір бөлігін жоғалтқан науқастарға орындалады
Dialogue: 0,0:18:47.12,0:18:50.62,Default,,0,0,0,,‎Бір айналу 1 мм. Бұл болтты реттеу арқылы жасалады.
Dialogue: 0,0:18:50.79,0:18:52.38,Default,,0,0,0,,Каллустың өсуі
Dialogue: 0,0:18:52.54,0:18:55.63,Default,,0,0,0,,өсу кезеңінде тәулігіне ‎1 мм
Dialogue: 0,0:18:55.80,0:18:57.21,Default,,0,0,0,,Ересек адам ретінде
Dialogue: 0,0:18:57.38,0:19:01.97,Default,,0,0,0,,‎Тәулігіне 0,25 мм-ден 0,5 мм-ге дейінгі жылдамдықпен
Dialogue: 0,0:19:02.80,0:19:07.47,Default,,0,0,0,,Ауыр жарақаттан зардап шеккен Джек Момиджиге сүйек ұзарту операциясын сұрайды.
Dialogue: 0,0:19:07.64,0:19:11.31,Default,,0,0,0,,‎Екі қол, екі аяқ, әрқайсысы 2 орын
Dialogue: 0,0:19:11.48,0:19:15.52,Default,,0,0,0,,‎8 жерден кесу арқылы ұзындықты ұзарту әбестік болды.
Dialogue: 0,0:19:17.78,0:19:20.11,Default,,0,0,0,,‎Бір ғана кеңейтім болса да
Dialogue: 0,0:19:20.28,0:19:23.03,Default,,0,0,0,,‎Мен әр түнде маған шабуыл жасайтын нәзік ауруға шыдай алмаймын.
Dialogue: 0,0:19:23.28,0:19:26.83,Default,,0,0,0,,Кейбір науқастар екінші операциядан бас тартса да.
Dialogue: 0,0:19:27.41,0:19:29.91,Default,,0,0,0,,Сол азаптың орнына үлкен биіктер...
Dialogue: 0,0:19:31.79,0:19:33.13,Default,,0,0,0,,Джек Ханма
Dialogue: 0,0:19:33.42,0:19:35.54,Default,,0,0,0,,‎Бұл сізге ғана тән идея.
Dialogue: 0,0:19:36.67,0:19:39.17,Default,,0,0,0,,‎Мені бауырластық қызықтырмайды, бірақ
Dialogue: 0,0:19:40.05,0:19:43.43,Default,,0,0,0,,Мен сенің жауыңның кекін аламын.
Dialogue: 0,0:19:55.11,0:19:55.94,Default,,0,0,0,,‎(Ретсу) Иә?
Dialogue: 0,0:19:56.69,0:19:57.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:00.07,0:20:00.90,Default,,0,0,0,,‎Na…
Dialogue: 0,0:20:01.57,0:20:02.99,Default,,0,0,0,,‎(Ретсу) Сіз не айтасыз?
Dialogue: 0,0:20:03.57,0:20:04.82,Default,,0,0,0,,‎(2 адам) Сәйкестік!
Dialogue: 0,0:20:05.62,0:20:07.78,Default,,0,0,0,,‎(Бала) Анам~ Маған қарап тұр ма?
Dialogue: 0,0:20:07.95,0:20:08.83,Default,,0,0,0,,‎(Ана) Тынш!
Dialogue: 0,0:20:09.58,0:20:11.50,Default,,0,0,0,,‎ Дүкеннен қайтып келе жатқан екі адам
Dialogue: 0,0:20:11.66,0:20:13.96,Default,,0,0,0,,‎(Ретсу) Сіз кездейсоқ кездесіп қалдық дегеніңіз бе?
Dialogue: 0,0:20:20.71,0:20:24.09,Default,,0,0,0,,‎Хехе... Осындай кездейсоқтықтар болады.
Dialogue: 0,0:20:24.68,0:20:26.26,Default,,0,0,0,,‎Біз кездестік, бірақ бұл соңғы рет болды
Dialogue: 0,0:20:26.43,0:20:29.97,Default,,0,0,0,,Бізге күресті бастауға уәде берілді.
Dialogue: 0,0:20:30.22,0:20:32.35,Default,,0,0,0,,Мұндай жерде мүмкін емес
Dialogue: 0,0:20:33.02,0:20:34.23,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:20:34.65,0:20:35.48,Default,,0,0,0,,А?
Dialogue: 0,0:20:35.77,0:20:37.06,Default,,0,0,0,,‎Ах... хехехе
Dialogue: 0,0:20:41.44,0:20:45.20,Default,,0,0,0,,‎Мен бұлай ажырасуға жол жоқ...
Dialogue: 0,0:20:45.32,0:20:48.74,Default,,0,0,0,,‎Алайда, дәл осы жерден қытырлақтарды бастауға болады.
Dialogue: 0,0:20:48.87,0:20:50.49,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:21:00.96,0:21:01.80,Default,,0,0,0,,‎Фу
Dialogue: 0,0:21:02.13,0:21:04.05,Default,,0,0,0,,‎Алкогольді алғыңыз келе ме?
Dialogue: 0,0:21:07.55,0:21:09.18,Default,,0,0,0,,‎(Бармен) Бұл Ардбек.
Dialogue: 0,0:21:12.06,0:21:13.43,Default,,0,0,0,,‎Тост...
Dialogue: 0,0:21:13.73,0:21:15.31,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:21:17.35,0:21:19.23,Default,,0,0,0,,‎Бұл менің елім үшін.
Dialogue: 0,0:21:19.48,0:21:21.40,Default,,0,0,0,,Белгілі бір дәмі бар шотланд
Dialogue: 0,0:21:21.65,0:21:23.69,Default,,0,0,0,,‎Оған үйренген сайын ол тәуелді болады.
Dialogue: 0,0:21:30.24,0:21:32.04,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:21:33.04,0:21:35.96,Default,,0,0,0,,Тіпті жекпе-жек шеберлері де дүкен аралайды.
Dialogue: 0,0:21:36.96,0:21:40.96,Default,,0,0,0,,‎Мен сіздің Субару Хоға қарсы жарылғыш зат қолданғаныңызды естідім.
Dialogue: 0,0:21:43.76,0:21:46.97,Default,,0,0,0,,‎Оның аты солай еді... Сол каратэші
Dialogue: 0,0:21:52.93,0:21:54.98,Default,,0,0,0,,Сіз бұл әділетсіз деп айтасыз ба?
Dialogue: 0,0:21:56.60,0:21:58.73,Default,,0,0,0,,Маған бәрібір!
Dialogue: 0,0:21:59.27,0:22:00.11,Default,,0,0,0,,А...
Dialogue: 0,0:22:00.73,0:22:01.77,Default,,0,0,0,,‎(Бармен) Ах...
Dialogue: 0,0:22:11.62,0:22:13.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:13.41,0:22:14.95,Default,,0,0,0,,‎О, иә... Эй!
Dialogue: 0,0:22:15.37,0:22:16.58,Default,,0,0,0,,Қарғыс атсын...!
Dialogue: 0,0:22:20.96,0:22:26.97,Default,,0,0,0,,‎♪〜
