Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.97,0:00:17.97,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,~♪
Dialogue: 0,0:01:43.31,0:01:44.97,Default,,0,0,0,,Жұмбақ шешілді
Dialogue: 0,0:01:45.31,0:01:46.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:49.60,0:01:50.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:51.65,0:01:54.23,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:01:58.53,0:01:59.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:02.49,0:02:04.79,Default,,0,0,0,,Ұлы жаттығу алаңынан секірген адам
Dialogue: 0,0:02:04.95,0:02:06.96,Default,,0,0,0,,40 жыл бұрын
Dialogue: 0,0:02:07.16,0:02:08.75,Default,,0,0,0,,(Аңқылдаған дыбыс)
Dialogue: 0,0:02:09.37,0:02:12.54,Default,,0,0,0,,Он жылдан кейін
Dialogue: 0,0:02:13.96,0:02:17.22,Default,,0,0,0,,Сол жерде ұлы данышпанның дүниеге келгені
Dialogue: 0,0:02:17.38,0:02:19.63,Default,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,0:02:20.72,0:02:24.56,Default,,0,0,0,,Кейінірек адам...
Dialogue: 0,0:02:25.22,0:02:28.43,Default,,0,0,0,,Теңіз патшасын да мұра етті
Dialogue: 0,0:02:30.69,0:02:31.86,Default,,0,0,0,,Рецу…
Dialogue: 0,0:02:34.82,0:02:38.32,Default,,0,0,0,,Мен сені Жапонияда кездестіремін деп ешқашан ойламадым.
Dialogue: 0,0:02:41.66,0:02:44.24,Default,,0,0,0,,Қайта ұрысуға тырысамыз ба?
Dialogue: 0,0:02:47.62,0:02:48.66,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:02:49.21,0:02:50.42,Default,,0,0,0,,Сіз...
Dialogue: 0,0:02:50.92,0:02:53.96,Default,,0,0,0,,Мен өлім жазасына лайық ауыр қылмыс жасасам да
Dialogue: 0,0:02:54.38,0:02:56.34,Default,,0,0,0,,Оқыту абсолютті
Dialogue: 0,0:02:58.17,0:03:02.59,Default,,0,0,0,,Біз Kenpo тәжірибешілеріне бір-бірімен бәсекелесуге рұқсат етілмейді.
Dialogue: 0,0:03:05.01,0:03:06.31,Default,,0,0,0,,Хун
Dialogue: 0,0:03:07.52,0:03:11.10,Default,,0,0,0,,Не... сендер сыныптассыңдар?
Dialogue: 0,0:03:17.48,0:03:18.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:19.82,0:03:22.45,Default,,0,0,0,,Жағдайды түсінуіңізді сұраймын.
Dialogue: 0,0:03:23.03,0:03:26.66,Default,,0,0,0,,Хаа... Маған бәрібір.
Dialogue: 0,0:03:26.87,0:03:29.20,Default,,0,0,0,,Бастапқыда сіз бөтен адам болдыңыз.
Dialogue: 0,0:03:29.45,0:03:33.42,Default,,0,0,0,,Кім істесе де, мен мұны істеуім керек.
Dialogue: 0,0:03:34.33,0:03:35.17,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:35.59,0:03:36.67,Default,,0,0,0,,Мұнда және мұнда
Dialogue: 0,0:03:37.25,0:03:38.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:38.76,0:03:40.55,Default,,0,0,0,,Шеберді бір жаққа қалдыру
Dialogue: 0,0:03:40.72,0:03:43.30,Default,,0,0,0,,«Егер мен мұны істесем,» маңызды емес.
Dialogue: 0,0:03:43.72,0:03:46.68,Default,,0,0,0,,Әке! Мен Шиншинкайдың өкілімін...
Dialogue: 0,0:03:46.85,0:03:48.68,Default,,0,0,0,,Бұл мен жасаған Шиншинкай!
Dialogue: 0,0:03:48.93,0:03:50.10,Default,,0,0,0,,О, менің...
Dialogue: 0,0:03:50.89,0:03:52.56,Default,,0,0,0,,Сіз тоқтаймын дедіңіз.
Dialogue: 0,0:03:52.73,0:03:53.69,Default,,0,0,0,,Және...
Dialogue: 0,0:03:54.98,0:03:59.36,Default,,0,0,0,,Тіпті каратэшінің өмірі де алынып тасталды.
Dialogue: 0,0:03:59.82,0:04:00.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.32,0:04:03.45,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:04:05.66,0:04:07.70,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:04:10.95,0:04:12.21,Default,,0,0,0,,Кайу-сан
Dialogue: 0,0:04:12.79,0:04:13.67,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:04:16.21,0:04:17.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:17.79,0:04:19.34,Default,,0,0,0,,♬~
Dialogue: 0,0:04:19.92,0:04:22.97,Default,,0,0,0,,Өйткені, бұл төбелес.
Dialogue: 0,0:04:23.88,0:04:25.34,Default,,0,0,0,,Сіз жалаңашсыз.
Dialogue: 0,0:04:27.47,0:04:28.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:35.40,0:04:36.23,Default,,0,0,0,,Ал Спидвагон мен басқалар
Dialogue: 0,0:04:37.52,0:04:38.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:45.24,0:04:47.49,Default,,0,0,0,,Ах... бұл стиль.
Dialogue: 0,0:04:48.16,0:04:52.20,Default,,0,0,0,,Доппо Гучи «Жолбарыс өлтіруші» ретінде де белгілі
Dialogue: 0,0:04:54.29,0:04:57.58,Default,,0,0,0,,20 жылдан астам уақыт бұрын, сол жертөледе.
Dialogue: 0,0:04:57.75,0:05:01.84,Default,,0,0,0,,2,5 метр және 260 кг Сібір жолбарысы
Dialogue: 0,0:05:02.26,0:05:04.30,Default,,0,0,0,,Бұл сіз ақымақтық жасағаныңыз үшін.
Dialogue: 0,0:05:05.72,0:05:09.18,Default,,0,0,0,,Сол анекдотты мен тек аңыз деп ойладым
Dialogue: 0,0:05:09.85,0:05:11.06,Default,,0,0,0,,Жолбарысты өлтір!
Dialogue: 0,0:05:11.22,0:05:13.27,Default,,0,0,0,,Бұл шынайы оқиға болды ма?
Dialogue: 0,0:05:14.27,0:05:20.36,Default,,0,0,0,,Сібір жолбарысы, құрып кету қаупі төнген ең үлкен мысық
Dialogue: 0,0:05:21.23,0:05:26.86,Default,,0,0,0,,Жануарларды қорғау ұйымдарының алдында Әлеуметтік тәрбие жөніндегі нұсқаушы лауазымы
Dialogue: 0,0:05:27.49,0:05:31.33,Default,,0,0,0,,Мен олай қатты сөйлей алмадым.
Dialogue: 0,0:05:31.49,0:05:32.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:32.45,0:05:35.58,Default,,0,0,0,,Бірақ бұл туралы айтпаудың ең үлкен себебі - Катцуми.
Dialogue: 0,0:05:37.04,0:05:39.88,Default,,0,0,0,,Маған ешкім сенбейді
Dialogue: 0,0:05:40.13,0:05:40.96,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:05:41.13,0:05:41.96,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:43.25,0:05:44.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:46.26,0:05:47.13,Default,,0,0,0,,Хмф! тістер!
Dialogue: 0,0:05:47.51,0:05:49.97,Default,,0,0,0,,Гуаа... Эй!
Dialogue: 0,0:05:51.26,0:05:52.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:53.81,0:05:55.60,Default,,0,0,0,,Қолымды жазып бергенімдегі жақсылығымды ұмытып қалдың ба…
Dialogue: 0,0:05:55.81,0:05:56.64,Default,,0,0,0,,Хмм!
Dialogue: 0,0:05:57.31,0:05:59.65,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:06:00.31,0:06:03.48,Default,,0,0,0,,Гуаааааааааааааааааааааааааа
Dialogue: 0,0:06:04.78,0:06:06.40,Default,,0,0,0,,Ка-ка-гуа…
Dialogue: 0,0:06:06.82,0:06:11.12,Default,,0,0,0,,Не? О? иә? H... сол қол?
Dialogue: 0,0:06:11.49,0:06:13.41,Default,,0,0,0,,Жақсы сезінеді~
Dialogue: 0,0:06:17.08,0:06:18.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:19.08,0:06:19.92,Default,,0,0,0,,Хмм!
Dialogue: 0,0:06:26.09,0:06:28.34,Default,,0,0,0,,Ой-ау
Dialogue: 0,0:06:28.97,0:06:33.05,Default,,0,0,0,,Дәріге шүкір.
Dialogue: 0,0:06:33.22,0:06:35.47,Default,,0,0,0,,(Қала қарбалас)
Dialogue: 0,0:06:35.64,0:06:37.93,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:47.61,0:06:53.62,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:06:54.83,0:06:55.79,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:06:55.95,0:06:56.95,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:57.79,0:06:58.79,Default,,0,0,0,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:06:59.29,0:07:02.13,Default,,0,0,0,,Кейбір ностальгиялық тұтынушылар да болды.
Dialogue: 0,0:07:03.17,0:07:07.46,Default,,0,0,0,,Жақын жерде екеніңізге қуаныштымын.
Dialogue: 0,0:07:08.92,0:07:10.38,Default,,0,0,0,,Ах... хмм
Dialogue: 0,0:07:15.64,0:07:20.02,Default,,0,0,0,,Бұл пышақ емес... Бұл фортепиано сымы шығар.
Dialogue: 0,0:07:21.19,0:07:24.02,Default,,0,0,0,,Уау~ ұшы ше?
Dialogue: 0,0:07:25.44,0:07:27.65,Default,,0,0,0,,Хехе... Қатып қалды ма?
Dialogue: 0,0:07:27.90,0:07:29.99,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:07:31.11,0:07:33.32,Default,,0,0,0,,Анестезия жоқ.
Dialogue: 0,0:07:35.24,0:07:36.74,Default,,0,0,0,,Мен тозақты көремін
Dialogue: 0,0:07:36.91,0:07:40.83,Default,,0,0,0,,Мен сізге тіс щеткаңызды үш күннен кейін пайдалануға рұқсат етемін.
Dialogue: 0,0:07:41.71,0:07:44.79,Default,,0,0,0,,Алдымен сүйектің қосылуынан бастайық.
Dialogue: 0,0:07:45.63,0:07:49.92,Default,,0,0,0,,Қан тамырлары, жүйкелер, бұлшықеттер...
Dialogue: 0,0:07:50.17,0:07:53.22,Default,,0,0,0,,Тері ретімен жалғау...
Dialogue: 0,0:07:54.01,0:07:57.05,Default,,0,0,0,,(Электрондық дыбысты бақылау)
Dialogue: 0,0:07:57.60,0:08:01.43,Default,,0,0,0,,Екінші қолқаны тігу...
Dialogue: 0,0:08:03.69,0:08:05.65,Default,,0,0,0,,Жарайды... және...
Dialogue: 0,0:08:06.86,0:08:10.49,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:08:15.20,0:08:16.99,Default,,0,0,0,,Фу~
Dialogue: 0,0:08:19.49,0:08:22.66,Default,,0,0,0,,Уа, ау, ау!
Dialogue: 0,0:08:22.96,0:08:27.00,Default,,0,0,0,,Мен оның қозғалып жатқанын көріп тұрмын.
Dialogue: 0,0:08:28.21,0:08:31.59,Default,,0,0,0,,Жақында адамды ұрып-соғатын сияқтымын.
Dialogue: 0,0:08:32.97,0:08:35.38,Default,,0,0,0,,Соққан адамдар...
Dialogue: 0,0:08:35.68,0:08:38.05,Default,,0,0,0,,3 аптадан кейін болуы мүмкін
Dialogue: 0,0:08:41.31,0:08:45.06,Default,,0,0,0,,Бұл өкінішті болды, Кайо мырза.
Dialogue: 0,0:08:50.11,0:08:51.94,Default,,0,0,0,,Ол қайта жанданды
Dialogue: 0,0:08:52.36,0:08:53.78,Default,,0,0,0,,О...
Dialogue: 0,0:08:58.62,0:09:03.54,Default,,0,0,0,,Егер сіз каратэмен айналысатын болсаңыз...
Dialogue: 0,0:09:14.88,0:09:19.80,Default,,0,0,0,,Мен үшін де Kenpo тәжірибешісі ретінде жауап беру қисынды болар еді.
Dialogue: 0,0:09:20.35,0:09:21.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:25.60,0:09:27.52,Default,,0,0,0,,Хаа... хахаха~!
Dialogue: 0,0:09:28.48,0:09:30.90,Default,,0,0,0,,Ио~ Куах!
Dialogue: 0,0:09:31.07,0:09:32.15,Default,,0,0,0,,Ой!
Dialogue: 0,0:09:33.86,0:09:36.36,Default,,0,0,0,,Бодхисаттва жұдырығы
Dialogue: 0,0:09:36.53,0:09:38.86,Default,,0,0,0,,Гах... Уау!
Dialogue: 0,0:09:39.41,0:09:41.20,Default,,0,0,0,,Ах... аа аа
Dialogue: 0,0:09:42.03,0:09:43.37,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:09:43.58,0:09:45.37,Default,,0,0,0,,Ооо
Dialogue: 0,0:09:46.12,0:09:46.96,Default,,0,0,0,,Гаха
Dialogue: 0,0:09:50.59,0:09:52.25,Default,,0,0,0,,Эй, міне, осы.
Dialogue: 0,0:09:52.42,0:09:55.21,Default,,0,0,0,,Нани «Кемпо дәрігері ретінде» маңызды
Dialogue: 0,0:09:55.67,0:09:56.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:59.68,0:10:00.93,Default,,0,0,0,,Қышқыл?
Dialogue: 0,0:10:02.18,0:10:03.22,Default,,0,0,0,,Уф
Dialogue: 0,0:10:04.68,0:10:05.52,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:08.48,0:10:09.77,Default,,0,0,0,,Келіңіздер! (жалғыз жүру) Ой
Dialogue: 0,0:10:09.94,0:10:10.77,Default,,0,0,0,,Тория
Dialogue: 0,0:10:10.94,0:10:12.02,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:10:13.19,0:10:14.03,Default,,0,0,0,,Нуо!
Dialogue: 0,0:10:16.44,0:10:17.28,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:10:19.36,0:10:20.49,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:26.66,0:10:28.04,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:33.92,0:10:37.26,Default,,0,0,0,,(Жалғыз терең тыныс алу)
Dialogue: 0,0:10:37.92,0:10:39.43,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:10:42.18,0:10:45.81,Default,,0,0,0,,(Қала қарбалас)
Dialogue: 0,0:10:52.81,0:10:53.65,Default,,0,0,0,,Эй
Dialogue: 0,0:10:53.86,0:10:54.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:59.28,0:11:01.53,Default,,0,0,0,,Recently...
Dialogue: 0,0:11:01.78,0:11:04.62,Default,,0,0,0,,Біз әрқашан біргеміз...
Dialogue: 0,0:11:05.79,0:11:06.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:08.83,0:11:09.87,Default,,0,0,0,,Uhu…
Dialogue: 0,0:11:15.63,0:11:16.84,Default,,0,0,0,,Сіз мені мазаладыңыз ба?
Dialogue: 0,0:11:17.09,0:11:18.38,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:11:20.76,0:11:24.22,Default,,0,0,0,,Күн сайын менімен бірге болғаныңыз үшін
Dialogue: 0,0:11:24.55,0:11:25.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:26.68,0:11:29.10,Default,,0,0,0,,Қызық, осыдан жалықтым ба?
Dialogue: 0,0:11:30.85,0:11:31.81,Default,,0,0,0,,Козуэ-чан ше?
Dialogue: 0,0:11:31.98,0:11:32.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:33.15,0:11:36.07,Default,,0,0,0,,Мен мұны ешқашан жалықтырмаймын деп ойлаймын.
Dialogue: 0,0:11:40.99,0:11:41.99,Default,,0,0,0,,Ха~
Dialogue: 0,0:11:42.78,0:11:44.20,Default,,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:11:44.57,0:11:46.16,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:11:47.08,0:11:51.75,Default,,0,0,0,,Мен сені қашан жек көретінімді білмеймін...
Dialogue: 0,0:11:52.00,0:11:52.83,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:53.79,0:11:56.21,Default,,0,0,0,,Мен білмей тұрып, мен саған ғашық болдым.
Dialogue: 0,0:11:57.42,0:11:58.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.47,0:12:06.47,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:07.51,0:12:10.02,Default,,0,0,0,,Жек көру деген нені білдіреді...
Dialogue: 0,0:12:10.27,0:12:11.39,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:12:26.62,0:12:30.37,Default,,0,0,0,,(өтіп бара жатқандар мысқылдайды)
Dialogue: 0,0:12:42.30,0:12:43.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:51.31,0:12:53.18,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:55.48,0:12:56.31,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:13:00.40,0:13:01.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:01.73,0:13:06.95,Default,,0,0,0,,…
Dialogue: 0,0:13:07.32,0:13:11.62,Default,,0,0,0,,Демімді ұзақ ұстасам... ауырар еді.
Dialogue: 0,0:13:14.04,0:13:14.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:16.25,0:13:17.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:19.46,0:13:20.46,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:25.13,0:13:26.30,Default,,0,0,0,,Үйге қайтайық?
Dialogue: 0,0:13:43.44,0:13:44.49,Default,,0,0,0,,Баки…
Dialogue: 0,0:13:44.69,0:13:46.78,Default,,0,0,0,,Түстерді білетін жасыңыз бар ма?
Dialogue: 0,0:13:50.45,0:13:53.12,Default,,0,0,0,,(Жалғыз терең тыныс алу)
Dialogue: 0,0:13:55.04,0:13:57.58,Default,,0,0,0,,Ю~ Ааа!
Dialogue: 0,0:13:58.29,0:13:59.12,Default,,0,0,0,,Пә!
Dialogue: 0,0:14:00.25,0:14:01.09,Default,,0,0,0,,Тей!
Dialogue: 0,0:14:02.38,0:14:03.38,Default,,0,0,0,,Хмм!
Dialogue: 0,0:14:05.09,0:14:06.34,Default,,0,0,0,,Нуах
Dialogue: 0,0:14:06.51,0:14:07.34,Default,,0,0,0,,Ой!
Dialogue: 0,0:14:07.63,0:14:08.47,Default,,0,0,0,,Уф
Dialogue: 0,0:14:10.26,0:14:11.10,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:11.97,0:14:13.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:18.06,0:14:19.69,Default,,0,0,0,,Сондай-ақ…
Dialogue: 0,0:14:20.77,0:14:23.36,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,0:14:24.15,0:14:28.20,Default,,0,0,0,,Егер сізді жоғарғы деңгейдегі Моро жеп кетсе, дереу қарсы шабуылға шығасыз ба?
Dialogue: 0,0:14:28.99,0:14:30.61,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:30.78,0:14:35.12,Default,,0,0,0,,Қаратэге барымды салған кездерім болады.
Dialogue: 0,0:14:35.54,0:14:36.87,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:14:38.12,0:14:41.67,Default,,0,0,0,,Сондықтан сен маған қарсы ешқашан жеңе алмайсың
Dialogue: 0,0:14:42.08,0:14:45.34,Default,,0,0,0,,Каратэге барын бергендерге т.б.
Dialogue: 0,0:14:45.67,0:14:48.97,Default,,0,0,0,,Менен асып түсе алмайсың
Dialogue: 0,0:14:49.30,0:14:50.55,Default,,0,0,0,,Хо…
Dialogue: 0,0:14:50.72,0:14:54.01,Default,,0,0,0,,Күлкілі сөздер айтасың, қария.
Dialogue: 0,0:15:04.15,0:15:05.27,Default,,0,0,0,,Өз баламды ешқашан қателеспес едім.
Dialogue: 0,0:15:05.44,0:15:08.44,Default,,0,0,0,,Сол жерге бұрылып, қойылым басталды.
Dialogue: 0,0:15:08.61,0:15:11.16,Default,,0,0,0,,Сіз маған ашуды көрсеткіңіз келе ме?
Dialogue: 0,0:15:13.03,0:15:14.66,Default,,0,0,0,,Не істеу керек
Dialogue: 0,0:15:14.83,0:15:17.16,Default,,0,0,0,,Сендердің әрқайсысың да көлеңкелі бейбақсыңдар.
Dialogue: 0,0:15:18.16,0:15:19.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:26.21,0:15:27.17,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:28.59,0:15:29.42,Default,,0,0,0,,О
Dialogue: 0,0:15:29.59,0:15:30.42,Default,,0,0,0,,А…?
Dialogue: 0,0:15:35.55,0:15:36.47,Default,,0,0,0,,Ой!
Dialogue: 0,0:15:40.02,0:15:42.44,Default,,0,0,0,,Бұл қандай сынақ, әке?
Dialogue: 0,0:15:43.02,0:15:44.36,Default,,0,0,0,,О...
Dialogue: 0,0:15:50.74,0:15:52.95,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:15:58.70,0:16:03.04,Default,,0,0,0,,Сүйікті ұлым екеумізді салыстырайық дегің келе ме?
Dialogue: 0,0:16:04.21,0:16:09.55,Default,,0,0,0,,Аты аңызға айналған Доппо Гучи жинаған сынақтың нәтижелері
Dialogue: 0,0:16:12.38,0:16:16.26,Default,,0,0,0,,Қайсысы өтеді?
Dialogue: 0,0:16:18.76,0:16:19.60,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:16:20.77,0:16:21.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:21.89,0:16:22.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:23.35,0:16:24.19,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:24.94,0:16:26.86,Default,,0,0,0,,Сізге бәрібір
Dialogue: 0,0:16:27.40,0:16:29.32,Default,,0,0,0,,Менен асып түсе алмайсың...
Dialogue: 0,0:16:29.48,0:16:30.32,Default,,0,0,0,,Нууууууууууууууууууууу
Dialogue: 0,0:16:31.44,0:16:32.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:33.99,0:16:36.20,Default,,0,0,0,,Сіз не ойлайсыз?
Dialogue: 0,0:16:38.53,0:16:41.66,Default,,0,0,0,,Кайоу дейтін жекпе-жек шебері болса да.
Dialogue: 0,0:16:41.83,0:16:44.00,Default,,0,0,0,,Оның мұндай нәзік болуы мүмкін емес.
Dialogue: 0,0:16:44.16,0:16:45.62,Default,,0,0,0,,Куо~
Dialogue: 0,0:16:45.79,0:16:48.13,Default,,0,0,0,,Мм! Қарғыс атсын... аа!
Dialogue: 0,0:16:48.29,0:16:49.29,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:50.71,0:16:56.72,Default,,0,0,0,,(Дорианның айқайы)
Dialogue: 0,0:16:58.10,0:17:00.22,Default,,0,0,0,,Кешір мені~
Dialogue: 0,0:17:01.56,0:17:02.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:02.85,0:17:06.85,Default,,0,0,0,,Ей, сен талантты бейбақсың.
Dialogue: 0,0:17:07.90,0:17:09.86,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:17:12.61,0:17:14.45,Default,,0,0,0,,Не істеп жатырсың, әке?
Dialogue: 0,0:17:14.61,0:17:15.45,Default,,0,0,0,,П
Dialogue: 0,0:17:15.61,0:17:19.78,Default,,0,0,0,,Әй... ей, әке, қайсысына қарап тұрсыз?
Dialogue: 0,0:17:20.03,0:17:23.37,Default,,0,0,0,,Әке! Мықты болыңыз, әке!
Dialogue: 0,0:17:23.62,0:17:25.12,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:17:26.17,0:17:27.67,Default,,0,0,0,,Хмм!
Dialogue: 0,0:17:28.33,0:17:29.84,Default,,0,0,0,,Мен сізді естімеймін
Dialogue: 0,0:17:30.00,0:17:32.92,Default,,0,0,0,,Құлағыма айқайласаң да
Dialogue: 0,0:17:34.17,0:17:37.47,Default,,0,0,0,,Гучи мырза төбелесіп жатыр.
Dialogue: 0,0:17:37.84,0:17:40.14,Default,,0,0,0,,Оның миы...
Dialogue: 0,0:17:43.10,0:17:47.48,Default,,0,0,0,,Қалағаныңды істе, менің виртуалды бейнесіммен
Dialogue: 0,0:17:47.64,0:17:50.36,Default,,0,0,0,,(Аспанды тепкен Доппо дыбысы)
Dialogue: 0,0:17:51.44,0:17:52.27,Default,,0,0,0,,Рецу!
Dialogue: 0,0:17:52.44,0:17:55.24,Default,,0,0,0,,Балалар сендер де солай істер едіңдер!
Dialogue: 0,0:17:55.53,0:17:57.40,Default,,0,0,0,,Қытай кемпосы емес
Dialogue: 0,0:17:57.99,0:18:00.62,Default,,0,0,0,,Гипноз болуы мүмкін
Dialogue: 0,0:18:02.74,0:18:03.83,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:05.37,0:18:07.29,Default,,0,0,0,,Мен айқын жеңгім келеді
Dialogue: 0,0:18:07.46,0:18:09.25,Default,,0,0,0,,Мен басымдықпен жеңгім келеді
Dialogue: 0,0:18:10.08,0:18:13.21,Default,,0,0,0,,Осыны қалайтын жауынгерлердің психологиялық әлсіз жақтарын пайдалану.
Dialogue: 0,0:18:13.38,0:18:14.67,Default,,0,0,0,,Зали орындаңыз
Dialogue: 0,0:18:15.71,0:18:17.51,Default,,0,0,0,,Операция кезіндегі жауынгер
Dialogue: 0,0:18:17.67,0:18:21.01,Default,,0,0,0,,«Мен істің осылай болғанын қалаймын» Оңай жаулар құру
Dialogue: 0,0:18:21.47,0:18:25.68,Default,,0,0,0,,Мен ойынның қалай өрбігенін қалайтынымды елестетемін.
Dialogue: 0,0:18:26.35,0:18:28.27,Default,,0,0,0,,Бірақ басқа адам
Dialogue: 0,0:18:28.44,0:18:29.48,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.06,0:18:31.48,Default,,0,0,0,,Маңызды емес…
Dialogue: 0,0:18:31.73,0:18:35.36,Default,,0,0,0,,Қарсыластың жай ғана ыңғайлы бейнесі
Dialogue: 0,0:18:36.24,0:18:39.70,Default,,0,0,0,,Гучи мырза қазір Дориан мырзаның техникасында.
Dialogue: 0,0:18:39.86,0:18:43.83,Default,,0,0,0,,Ол өзінің уақытша жауын өзі қалағандай жеңіп жатқан шығар.
Dialogue: 0,0:18:43.99,0:18:44.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:44.99,0:18:46.08,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:18:46.41,0:18:47.91,Default,,0,0,0,,О!
Dialogue: 0,0:18:48.58,0:18:49.83,Default,,0,0,0,,Миссия үшін,
Dialogue: 0,0:18:51.29,0:18:53.79,Default,,0,0,0,,Қатты күресу
Dialogue: 0,0:18:54.75,0:18:59.09,Default,,0,0,0,,Соғыс құдайы деп дәріптелген адамның өзі осылай көрінгенде сүйкімді.
Dialogue: 0,0:19:00.76,0:19:02.34,Default,,0,0,0,,Пердені түсірейік
Dialogue: 0,0:19:02.51,0:19:05.39,Default,,0,0,0,,Менің қазір көріп жатқан арманым...
Dialogue: 0,0:19:05.56,0:19:08.35,Default,,0,0,0,,Оны мәңгілік ету
Dialogue: 0,0:19:09.18,0:19:13.86,Default,,0,0,0,,Шексіз арман әлеміне барыңыз
Dialogue: 0,0:19:15.73,0:19:16.57,Default,,0,0,0,,Иә
Dialogue: 0,0:19:17.19,0:19:18.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:19.19,0:19:20.36,Default,,0,0,0,,Қой... Тория!
Dialogue: 0,0:19:20.95,0:19:22.95,Default,,0,0,0,,Ах! а!
Dialogue: 0,0:19:23.24,0:19:25.87,Default,,0,0,0,,О! (Соло) Ио!
Dialogue: 0,0:19:26.29,0:19:28.33,Default,,0,0,0,,О! Оу!
Dialogue: 0,0:19:28.83,0:19:29.79,Default,,0,0,0,,Гуа!
Dialogue: 0,0:19:30.00,0:19:31.83,Default,,0,0,0,,Ах... ха!
Dialogue: 0,0:19:32.00,0:19:34.92,Default,,0,0,0,,Ааа! Ах...
Dialogue: 0,0:19:35.84,0:19:37.75,Default,,0,0,0,,Бұл қажет емес пе...
Dialogue: 0,0:19:38.17,0:19:39.76,Default,,0,0,0,,Гипноз?
Dialogue: 0,0:19:40.13,0:19:41.13,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:41.84,0:19:43.09,Default,,0,0,0,,Шешілмеген
Dialogue: 0,0:19:45.05,0:19:46.81,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:19:48.52,0:19:50.48,Default,,0,0,0,,Шайқаста шыңдалған Гучи мырза
Dialogue: 0,0:19:50.64,0:19:53.02,Default,,0,0,0,,Күрес оңай емес, т.б.
Dialogue: 0,0:19:53.19,0:19:55.23,Default,,0,0,0,,Мен бәрін білемін.
Dialogue: 0,0:19:56.77,0:19:58.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:59.03,0:20:01.11,Default,,0,0,0,,Ұрыс – ыңғайсыз нәрсе.
Dialogue: 0,0:20:01.53,0:20:04.41,Default,,0,0,0,,Ұрыс - бұл сіздің жолыңыздан кетпейтін нәрсе.
Dialogue: 0,0:20:05.03,0:20:06.91,Default,,0,0,0,,Буджин Гуджи мырзаға...
Dialogue: 0,0:20:07.08,0:20:08.12,Default,,0,0,0,,Ой...
Dialogue: 0,0:20:08.29,0:20:10.20,Default,,0,0,0,,О! Хааааааа!
Dialogue: 0,0:20:10.37,0:20:12.04,Default,,0,0,0,,Бұл күрес!
Dialogue: 0,0:20:14.12,0:20:16.59,Default,,0,0,0,,Мен шешемін.
Dialogue: 0,0:20:17.21,0:20:19.42,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:20:22.55,0:20:24.93,Default,,0,0,0,,Ахх!
Dialogue: 0,0:20:25.09,0:20:25.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:29.85,0:20:32.64,Default,,0,0,0,,Бұл әдемі каратэ.
Dialogue: 0,0:20:33.10,0:20:36.73,Default,,0,0,0,,Сонда сіз әлі де гипноздасыз ба?
Dialogue: 0,0:20:42.69,0:20:44.95,Default,,0,0,0,,Техниканы шешейік
Dialogue: 0,0:20:45.57,0:20:46.41,Default,,0,0,0,,(Нан!)
Dialogue: 0,0:20:46.78,0:20:47.70,Default,,0,0,0,,Pup
Dialogue: 0,0:20:48.70,0:20:51.04,Default,,0,0,0,,О! Маваши Уке!
Dialogue: 0,0:20:52.75,0:20:53.71,Default,,0,0,0,,Ал Спидвагон мен басқалар
Dialogue: 0,0:20:54.21,0:20:55.42,Default,,0,0,0,,Хахан~н
Dialogue: 0,0:20:56.33,0:20:58.92,Default,,0,0,0,,Ештеңе өзгермеген сияқты.
Dialogue: 0,0:20:59.13,0:21:01.09,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:21:01.71,0:21:02.55,Default,,0,0,0,,Шаа! о!
Dialogue: 0,0:21:02.71,0:21:05.80,Default,,0,0,0,,Гучи мырзаның операция кезінде көретін иллюзия қозғалысы.
Dialogue: 0,0:21:05.97,0:21:09.35,Default,,0,0,0,,Нақты жаудың қозғалысында ешқандай айырмашылық болмаса
Dialogue: 0,0:21:09.51,0:21:10.97,Default,,0,0,0,,Өзгеріс мүмкін емес
Dialogue: 0,0:21:11.89,0:21:13.43,Default,,0,0,0,,Нақтырақ айтсақ...
Dialogue: 0,0:21:13.60,0:21:14.43,Default,,0,0,0,,Тей! Ха!
Dialogue: 0,0:21:14.60,0:21:15.73,Default,,0,0,0,,Гучи мырзаға арналған
Dialogue: 0,0:21:16.10,0:21:19.23,Default,,0,0,0,,Менің гипнозда болғанымды және т.б.
Dialogue: 0,0:21:19.69,0:21:22.40,Default,,0,0,0,,Бұл менің есімде жоқ дегенді білдіреді.
Dialogue: 0,0:21:22.86,0:21:24.11,Default,,0,0,0,,Гуа!
Dialogue: 0,0:21:24.70,0:21:25.53,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:21:25.70,0:21:29.45,Default,,0,0,0,,Мен Жапонияда Жауынгерлік Құдай бар деп естідім.
Dialogue: 0,0:21:29.95,0:21:33.33,Default,,0,0,0,,Сол темір жұдырық ағашты кеседі.
Dialogue: 0,0:21:33.50,0:21:35.87,Default,,0,0,0,,Жолбарысты өлтіру
Dialogue: 0,0:21:36.16,0:21:38.13,Default,,0,0,0,,Тырнақтар! Ол өткірленеді!
Dialogue: 0,0:21:39.17,0:21:41.34,Default,,0,0,0,,Егер сіз...
Dialogue: 0,0:21:41.63,0:21:43.01,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:21:43.42,0:21:44.34,Default,,0,0,0,,Сен өте шулысың! Жүйкеме тиіп барасың.
Dialogue: 0,0:21:44.51,0:21:47.01,Default,,0,0,0,,Егер сіз...
Dialogue: 0,0:21:48.18,0:21:49.01,Default,,0,0,0,,Арман...
Dialogue: 0,0:21:50.26,0:21:52.51,Default,,0,0,0,,Бұл орындалады ма?
Dialogue: 0,0:21:53.10,0:21:54.10,Default,,0,0,0,,Уау~
Dialogue: 0,0:21:55.27,0:21:56.10,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:58.77,0:22:01.65,Default,,0,0,0,,Мен осылай жасағаным жақсы болар еді.
Dialogue: 0,0:22:02.61,0:22:05.32,Default,,0,0,0,,Егер мен оны пайдалансам, мен жеңе алар едім.
Dialogue: 0,0:22:05.99,0:22:08.74,Default,,0,0,0,,Ешбір күмәнсіз
Dialogue: 0,0:22:08.91,0:22:10.66,Default,,0,0,0,,Бұлтты емес
Dialogue: 0,0:22:14.12,0:22:15.75,Default,,0,0,0,,Рас...
Dialogue: 0,0:22:17.37,0:22:20.88,Default,,0,0,0,,Бұл сізге жеңіліс сыйламай ма?
Dialogue: 0,0:22:21.04,0:22:27.05,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:44.08,0:23:50.09,Default,,0,0,0,,~♪
Dialogue: 0,0:23:51.59,0:23:57.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory