Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,‎NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.51,0:00:17.51,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:34.01,0:01:40.01,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:57.40,0:01:58.70,Default,,0,0,0,,‎(‎Коузуэ‎) Баки-кун!
Dialogue: 0,0:02:02.70,0:02:06.58,Default,,0,0,0,,‎Иә… Сіз мұны істегіңіз келе ме? Мен де...
Dialogue: 0,0:02:13.04,0:02:15.21,Default,,0,0,0,,Рахмет сізге Козуэ
Dialogue: 0,0:02:16.34,0:02:17.84,Default,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,0:02:18.05,0:02:19.09,Default,,0,0,0,,‎（‎Янаги‎） Уф...
Dialogue: 0,0:02:19.51,0:02:20.34,Default,,0,0,0,,‎(Сикорский) Ух...
Dialogue: 0,0:02:21.89,0:02:25.60,Default,,0,0,0,,‎Бірақ бұл екеуі мені жеңе алмайды.
Dialogue: 0,0:02:25.85,0:02:26.72,Default,,0,0,0,,‎K…
Dialogue: 0,0:02:27.18,0:02:28.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:29.14,0:02:31.90,Default,,0,0,0,,Бұл сенімділіктен гөрі болжам.
Dialogue: 0,0:02:33.36,0:02:34.36,Default,,0,0,0,,А...
Dialogue: 0,0:02:34.86,0:02:38.74,Default,,0,0,0,,Бұл болжамнан гөрі сенімдірек.
Dialogue: 0,0:02:41.32,0:02:45.37,Default,,0,0,0,,Бұл екеуінің қосылмағанына көп уақыт болды.
Dialogue: 0,0:02:46.83,0:02:49.25,Default,,0,0,0,,‎Бірақ екеуі алға жылжи алмайды.
Dialogue: 0,0:02:52.83,0:02:53.92,Default,,0,0,0,,‎(Сикорский) А...
Dialogue: 0,0:02:54.04,0:02:55.75,Default,,0,0,0,,Қараңызшы, бұл аудан.
Dialogue: 0,0:02:56.17,0:02:57.26,Default,,0,0,0,,О...
Dialogue: 0,0:02:57.67,0:02:58.51,Default,,0,0,0,,А...
Dialogue: 0,0:02:59.34,0:03:01.22,Default,,0,0,0,,Күтейік
Dialogue: 0,0:03:01.43,0:03:02.64,Default,,0,0,0,,Мен сені жаншып аламын ба?
Dialogue: 0,0:03:03.05,0:03:03.89,Default,,0,0,0,,‎(Сикорский) Уф
Dialogue: 0,0:03:06.64,0:03:07.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:09.68,0:03:10.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:11.69,0:03:12.52,Default,,0,0,0,,‎(Сикорский) Уау...
Dialogue: 0,0:03:12.98,0:03:14.52,Default,,0,0,0,,‎Гуа…
Dialogue: 0,0:03:14.98,0:03:16.48,Default,,0,0,0,,А...
Dialogue: 0,0:03:21.49,0:03:22.32,Default,,0,0,0,,тұрып
Dialogue: 0,0:03:24.49,0:03:25.33,Default,,0,0,0,,Ух...
Dialogue: 0,0:03:25.95,0:03:26.78,Default,,0,0,0,,‎Ug…
Dialogue: 0,0:03:27.29,0:03:29.79,Default,,0,0,0,,Тістеріңізді тістеңіз!
Dialogue: 0,0:03:30.21,0:03:31.16,Default,,0,0,0,,‎
Dialogue: 0,0:03:32.33,0:03:33.79,Default,,0,0,0,,Гах!
Dialogue: 0,0:03:34.46,0:03:35.38,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:03:37.25,0:03:38.42,Default,,0,0,0,,‎(2 адам) Ах!
Dialogue: 0,0:03:40.47,0:03:43.30,Default,,0,0,0,,‎Жеңілісті сыйлыққа бер ‎Бұл шындықтан алыс
Dialogue: 0,0:03:43.72,0:03:46.80,Default,,0,0,0,,‎Мені аяғыммен тұра алмай қалғанша ұр!
Dialogue: 0,0:03:53.14,0:03:54.23,Default,,0,0,0,,А...
Dialogue: 0,0:03:56.27,0:03:57.48,Default,,0,0,0,,Мен тым көп айтамын...
Dialogue: 0,0:03:58.65,0:04:01.44,Default,,0,0,0,,Артық айтпайсың ба?
Dialogue: 0,0:04:04.07,0:04:05.82,Default,,0,0,0,,‎Уау... бұл күшті.
Dialogue: 0,0:04:06.37,0:04:08.33,Default,,0,0,0,,‎Адамдар міндетті емес
Dialogue: 0,0:04:08.45,0:04:12.33,Default,,0,0,0,,‎Күнделікті жаттығудың өзі сізді күшті етпейді.
Dialogue: 0,0:04:13.16,0:04:15.08,Default,,0,0,0,,Бір ғана жеңіс
Dialogue: 0,0:04:15.63,0:04:18.09,Default,,0,0,0,,Бір ғана жеңіліс
Dialogue: 0,0:04:18.46,0:04:21.84,Default,,0,0,0,,‎Және бір ғана кездесу
Dialogue: 0,0:04:21.97,0:04:25.34,Default,,0,0,0,,Бұл адамды айтарлықтай күштірек ете алады.
Dialogue: 0,0:04:27.72,0:04:29.85,Default,,0,0,0,,Бірақ ше...
Dialogue: 0,0:04:32.43,0:04:36.02,Default,,0,0,0,,Сіз бірінші махаббатыңыздың соңында әйелді білесіз
Dialogue: 0,0:04:36.44,0:04:41.61,Default,,0,0,0,,Сіз керемет табиғаттан тыс күштерге ие болғандай сезінесіз.
Dialogue: 0,0:04:41.99,0:04:47.66,Default,,0,0,0,,Әр адам өз өмірінде басынан өткеретін оқиғалардың түрі.
Dialogue: 0,0:04:47.78,0:04:52.62,Default,,0,0,0,,Мен бұрынғыдан бірнеше есе күшті болдым...
Dialogue: 0,0:04:53.71,0:04:55.12,Default,,0,0,0,,‎(Янаги) ‎Ол неге жұмыс істемейді?
Dialogue: 0,0:04:56.04,0:04:56.87,Default,,0,0,0,,Арх!
Dialogue: 0,0:04:58.04,0:04:58.88,Default,,0,0,0,,Неге!
Dialogue: 0,0:05:03.76,0:05:09.01,Default,,0,0,0,,Сол кезде менің оң қолым оның денесінде қатты болды.
Dialogue: 0,0:05:09.18,0:05:10.01,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:05:18.86,0:05:20.27,Default,,0,0,0,,‎Ол неге жұмыс істемейді?
Dialogue: 0,0:05:20.86,0:05:23.19,Default,,0,0,0,,Тек осы адамға Неге?
Dialogue: 0,0:05:23.99,0:05:25.95,Default,,0,0,0,,‎У жұмыс істемейді!
Dialogue: 0,0:05:26.95,0:05:27.99,Default,,0,0,0,,Сіз кетпейсіз бе?
Dialogue: 0,0:05:30.20,0:05:31.03,Default,,0,0,0,,‎(Янаги) Хмф!
Dialogue: 0,0:05:31.49,0:05:32.33,Default,,0,0,0,,‎(Сикорский) Хмф!
Dialogue: 0,0:05:32.45,0:05:33.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:33.41,0:05:34.08,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:05:34.95,0:05:35.79,Default,,0,0,0,,Уау
Dialogue: 0,0:05:36.16,0:05:37.46,Default,,0,0,0,,Гах!
Dialogue: 0,0:05:37.96,0:05:39.29,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:39.46,0:05:40.29,Default,,0,0,0,,‎(Сикорский) Гуах
Dialogue: 0,0:05:40.92,0:05:41.79,Default,,0,0,0,,Гия
Dialogue: 0,0:05:42.46,0:05:43.30,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:44.13,0:05:45.30,Default,,0,0,0,,‎Ug…
Dialogue: 0,0:05:45.84,0:05:46.84,Default,,0,0,0,,‎Гаха…
Dialogue: 0,0:05:46.97,0:05:47.80,Default,,0,0,0,,А...
Dialogue: 0,0:05:48.34,0:05:49.97,Default,,0,0,0,,Тынш!
Dialogue: 0,0:05:50.97,0:05:51.80,Default,,0,0,0,,‎T…
Dialogue: 0,0:05:52.35,0:05:53.47,Default,,0,0,0,,Күшті...
Dialogue: 0,0:05:56.48,0:05:57.31,Default,,0,0,0,,А
Dialogue: 0,0:05:59.23,0:06:01.11,Default,,0,0,0,,бұл... ‎Ханаяма
Dialogue: 0,0:06:01.94,0:06:02.69,Default,,0,0,0,,А
Dialogue: 0,0:06:03.44,0:06:05.40,Default,,0,0,0,,Өткен күні кешіріңіз.
Dialogue: 0,0:06:07.45,0:06:08.82,Default,,0,0,0,,‎(Ханаяма) Мен оны жек көремін.
Dialogue: 0,0:06:09.32,0:06:10.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:10.74,0:06:13.53,Default,,0,0,0,,‎Мен өзімді қорғайтын әйел тапқаным үшін
Dialogue: 0,0:06:14.12,0:06:15.70,Default,,0,0,0,,Бұл өте өзгереді
Dialogue: 0,0:06:16.50,0:06:17.33,Default,,0,0,0,,А...
Dialogue: 0,0:06:18.41,0:06:19.71,Default,,0,0,0,,Сол Хан...
Dialogue: 0,0:06:20.50,0:06:22.79,Default,,0,0,0,,Жай серуендеңіз
Dialogue: 0,0:06:22.92,0:06:26.84,Default,,0,0,0,,Күшті болу үшін себеп табатыныңызға сенімдімін.
Dialogue: 0,0:06:27.30,0:06:29.97,Default,,0,0,0,,Мен енді жеңіле алмаймын...
Dialogue: 0,0:06:30.68,0:06:31.51,Default,,0,0,0,,А...
Dialogue: 0,0:06:32.51,0:06:33.35,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:06:34.68,0:06:38.73,Default,,0,0,0,,Ең күштіге ұмтылу инстинкті белгілі.
Dialogue: 0,0:06:44.11,0:06:46.78,Default,,0,0,0,,‎Мен сүйіктіммен салыстырғанда ең күшті екеніме сене алмаймын
Dialogue: 0,0:06:48.19,0:06:49.03,Default,,0,0,0,,А...
Dialogue: 0,0:06:57.33,0:06:58.75,Default,,0,0,0,,‎(Ханаяма) Сіз жеңдіңіз.
Dialogue: 0,0:07:00.87,0:07:01.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.58,0:07:04.96,Default,,0,0,0,,‎Ханаяма-сан осында болды.
Dialogue: 0,0:07:06.00,0:07:07.84,Default,,0,0,0,,‎(аяқ дыбысына жақындау)
Dialogue: 0,0:07:11.09,0:07:12.09,Default,,0,0,0,,(Ханаяма) Күшті Ена
Dialogue: 0,0:07:12.84,0:07:13.68,Default,,0,0,0,,‎Фу
Dialogue: 0,0:07:15.01,0:07:17.72,Default,,0,0,0,,Бір-бірін көрмей бірнеше күн болды
Dialogue: 0,0:07:18.22,0:07:21.85,Default,,0,0,0,,Адамдар өзгерді, Күшті болды.
Dialogue: 0,0:07:23.02,0:07:23.86,Default,,0,0,0,,‎Фу
Dialogue: 0,0:07:24.90,0:07:25.86,Default,,0,0,0,,Атап айтқанда...
Dialogue: 0,0:07:26.77,0:07:28.23,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:28.44,0:07:29.99,Default,,0,0,0,,‎Сен мықты болмасаң да
Dialogue: 0,0:07:30.45,0:07:31.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:32.20,0:07:35.24,Default,,0,0,0,,‎Өзіңізді және...
Dialogue: 0,0:07:36.37,0:07:37.66,Default,,0,0,0,,Тағы бір адам
Dialogue: 0,0:07:41.16,0:07:42.00,Default,,0,0,0,,‎Фу
Dialogue: 0,0:07:43.25,0:07:44.08,Default,,0,0,0,,‎Хехе
Dialogue: 0,0:07:45.42,0:07:46.25,Default,,0,0,0,,‎(Ханаяма) Эй, эй
Dialogue: 0,0:07:46.92,0:07:47.75,Default,,0,0,0,,‎Hehehe
Dialogue: 0,0:07:48.63,0:07:49.51,Default,,0,0,0,,‎(Ханаяма) кері
Dialogue: 0,0:07:50.17,0:07:51.01,Default,,0,0,0,,‎Фу
Dialogue: 0,0:07:52.30,0:07:53.51,Default,,0,0,0,,‎(2 адам) Уф...
Dialogue: 0,0:07:54.18,0:07:55.09,Default,,0,0,0,,Уф
Dialogue: 0,0:07:55.64,0:07:56.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:57.81,0:07:58.56,Default,,0,0,0,,‎(Сикорский) Уф
Dialogue: 0,0:07:58.76,0:07:59.60,Default,,0,0,0,,‎(Янаги) га…
Dialogue: 0,0:08:00.98,0:08:02.39,Default,,0,0,0,,‎(Сикорский) А...
Dialogue: 0,0:08:02.85,0:08:03.69,Default,,0,0,0,,‎(Янаги) га…
Dialogue: 0,0:08:05.40,0:08:06.23,Default,,0,0,0,,‎Га
Dialogue: 0,0:08:08.11,0:08:08.94,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:08:09.44,0:08:10.28,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:08:10.90,0:08:11.57,Default,,0,0,0,,‎(Kouzue) Иә?
Dialogue: 0,0:08:13.15,0:08:13.99,Default,,0,0,0,,А
Dialogue: 0,0:08:15.78,0:08:16.78,Default,,0,0,0,,Қаш
Dialogue: 0,0:08:17.41,0:08:18.49,Default,,0,0,0,,‎(2 адам) Ах!
Dialogue: 0,0:08:23.92,0:08:25.29,Default,,0,0,0,,Ол қашып кетті...
Dialogue: 0,0:08:27.46,0:08:28.34,Default,,0,0,0,,‎(Сикорский) А...
Dialogue: 0,0:08:30.00,0:08:31.26,Default,,0,0,0,,‎(2 адам) Мм!
Dialogue: 0,0:08:36.18,0:08:37.22,Default,,0,0,0,,‎(Ханаяма) Мұны істеме.
Dialogue: 0,0:08:39.56,0:08:40.60,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:08:45.56,0:08:46.90,Default,,0,0,0,,А...
Dialogue: 0,0:08:47.44,0:08:48.77,Default,,0,0,0,,Ух...
Dialogue: 0,0:08:49.36,0:08:52.19,Default,,0,0,0,,‎(жүгіру)
Dialogue: 0,0:08:53.03,0:08:53.95,Default,,0,0,0,,А...
Dialogue: 0,0:08:56.16,0:08:58.20,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:08:58.82,0:09:00.33,Default,,0,0,0,,Сізге жеңіске жетудің қажеті жоқ
Dialogue: 0,0:09:01.33,0:09:02.16,Default,,0,0,0,,А...
Dialogue: 0,0:09:04.08,0:09:05.54,Default,,0,0,0,,‎Оны қорғай алсаңыз, жақсы
Dialogue: 0,0:09:13.71,0:09:15.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:15.59,0:09:16.72,Default,,0,0,0,,О...
Dialogue: 0,0:09:18.22,0:09:19.39,Default,,0,0,0,,‎(Янаги) га…
Dialogue: 0,0:09:20.22,0:09:21.39,Default,,0,0,0,,‎(Сикорский) Фу…
Dialogue: 0,0:09:22.52,0:09:25.73,Default,,0,0,0,,(Янаги) Біз не істеп жатырмыз?
Dialogue: 0,0:09:26.35,0:09:28.81,Default,,0,0,0,,Мұндай қорлау
Dialogue: 0,0:09:31.69,0:09:37.11,Default,,0,0,0,,О!
Dialogue: 0,0:09:40.12,0:09:44.45,Default,,0,0,0,,‎(Бу ысқырығы)
Dialogue: 0,0:09:45.87,0:09:50.21,Default,,0,0,0,,‎(толқындар дыбысы)
Dialogue: 0,0:09:54.09,0:09:54.92,Default,,0,0,0,,‎Фу~
Dialogue: 0,0:09:55.09,0:09:55.88,Default,,0,0,0,,‎ (тұман)
Dialogue: 0,0:09:58.97,0:09:59.80,Default,,0,0,0,,‎(тұман)
Dialogue: 0,0:10:01.18,0:10:02.72,Default,,0,0,0,,Мен ризамын
Dialogue: 0,0:10:03.26,0:10:04.10,Default,,0,0,0,,‎(‎Кацуми‎) Иә
Dialogue: 0,0:10:07.35,0:10:09.44,Default,,0,0,0,,Уақыты да жақсы болды.
Dialogue: 0,0:10:10.40,0:10:13.98,Default,,0,0,0,,Менің бір шәкіртім маған туыс болып қалды.
Dialogue: 0,0:10:14.32,0:10:15.94,Default,,0,0,0,,‎Фу~
Dialogue: 0,0:10:17.82,0:10:19.45,Default,,0,0,0,,Еркелету
Dialogue: 0,0:10:22.66,0:10:24.45,Default,,0,0,0,,Таяу Шығыс?
Dialogue: 0,0:10:25.66,0:10:26.54,Default,,0,0,0,,‎(Кацуми) О
Dialogue: 0,0:10:27.41,0:10:29.96,Default,,0,0,0,,Келесі аптада Таяу Шығыс
Dialogue: 0,0:10:30.63,0:10:33.75,Default,,0,0,0,,‎(Бу ысқырығы)
Dialogue: 0,0:10:38.01,0:10:39.05,Default,,0,0,0,,Катцуми!
Dialogue: 0,0:10:39.84,0:10:41.22,Default,,0,0,0,,Тағы бір нәрсе...
Dialogue: 0,0:10:41.51,0:10:43.51,Default,,0,0,0,,Менің өзімшілдігімді тыңда
Dialogue: 0,0:10:46.14,0:10:48.77,Default,,0,0,0,,‎Сен маған каратэ үйрете аласың ба?
Dialogue: 0,0:10:49.23,0:10:50.06,Default,,0,0,0,,А...
Dialogue: 0,0:10:51.56,0:10:53.52,Default,,0,0,0,,Біреуі жеткілікті
Dialogue: 0,0:10:54.94,0:10:57.03,Default,,0,0,0,,‎Мен сізбен қосылғым келеді
Dialogue: 0,0:10:57.78,0:10:58.61,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:11:01.32,0:11:02.41,Default,,0,0,0,,‎(Кацуми) Уау!
Dialogue: 0,0:11:06.08,0:11:06.91,Default,,0,0,0,,‎Иә~
Dialogue: 0,0:11:08.87,0:11:09.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:12.71,0:11:13.88,Default,,0,0,0,,‎(ысқырық)
Dialogue: 0,0:11:14.96,0:11:16.50,Default,,0,0,0,,‎Сейкен
Dialogue: 0,0:11:17.38,0:11:20.17,Default,,0,0,0,,‎Сейкен
Dialogue: 0,0:11:32.14,0:11:33.19,Default,,0,0,0,,‎
Dialogue: 0,0:11:33.69,0:11:34.56,Default,,0,0,0,,О!
Dialogue: 0,0:11:35.52,0:11:36.36,Default,,0,0,0,,‎Хаа~
Dialogue: 0,0:11:37.57,0:11:40.57,Default,,0,0,0,,‎Мен күткендей, шыдай алмаймын.
Dialogue: 0,0:11:41.24,0:11:42.07,Default,,0,0,0,,‎Хаха…
Dialogue: 0,0:11:43.11,0:11:46.83,Default,,0,0,0,,Мұны күніне 100 рет, күн сайын жасаңыз.
Dialogue: 0,0:11:50.25,0:11:51.33,Default,,0,0,0,,Мен сені қорғаймын
Dialogue: 0,0:11:52.04,0:11:53.12,Default,,0,0,0,,Көз жеткізіңіз...
Dialogue: 0,0:11:56.00,0:11:56.84,Default,,0,0,0,,Бұл сигнал.
Dialogue: 0,0:12:10.10,0:12:14.85,Default,,0,0,0,,‎ (өткізгіштің сықырлаған дыбысы)
Dialogue: 0,0:12:16.11,0:12:17.19,Default,,0,0,0,,‎(Кацуми) До-ил!
Dialogue: 0,0:12:20.69,0:12:21.53,Default,,0,0,0,,Ей!
Dialogue: 0,0:12:32.20,0:12:33.58,Default,,0,0,0,,Аригато
Dialogue: 0,0:12:35.92,0:12:37.13,Default,,0,0,0,,‎(қозғалтқыш дыбысы)
Dialogue: 0,0:13:00.27,0:13:02.57,Default,,0,0,0,,Ұшуға 15 минут қалды
Dialogue: 0,0:13:02.99,0:13:03.82,Default,,0,0,0,,‎(Янаги) Фуфуфуфуфуфуфу
Dialogue: 0,0:13:03.94,0:13:04.78,Default,,0,0,0,,А
Dialogue: 0,0:13:05.53,0:13:06.53,Default,,0,0,0,,‎(Янаги) Мичаорен
Dialogue: 0,0:13:07.41,0:13:10.79,Default,,0,0,0,,‎Екі қызбен қоштасқандай.
Dialogue: 0,0:13:11.29,0:13:12.70,Default,,0,0,0,,Азғындық
Dialogue: 0,0:13:15.12,0:13:15.96,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:13:19.13,0:13:23.30,Default,,0,0,0,,‎(Янаги) ‎Жаудың артына кешігіп, бітімге келу
Dialogue: 0,0:13:25.93,0:13:27.30,Default,,0,0,0,,‎Ұят!
Dialogue: 0,0:13:28.22,0:13:29.55,Default,,0,0,0,,‎Hehehehe
Dialogue: 0,0:13:30.43,0:13:33.02,Default,,0,0,0,,‎Оны айту үшін өз жолыңыздан шығу.
Dialogue: 0,0:13:33.64,0:13:36.06,Default,,0,0,0,,Сіз таңқаларлық мейірімдісіз.
Dialogue: 0,0:13:43.53,0:13:45.07,Default,,0,0,0,,Санкциялар.
Dialogue: 0,0:13:49.82,0:13:50.66,Default,,0,0,0,,Тей!
Dialogue: 0,0:13:54.25,0:13:55.08,Default,,0,0,0,,А...
Dialogue: 0,0:13:56.41,0:13:57.25,Default,,0,0,0,,‎Ug…
Dialogue: 0,0:14:03.88,0:14:04.71,Default,,0,0,0,,А...
Dialogue: 0,0:14:10.14,0:14:11.89,Default,,0,0,0,,Көру жойылды
Dialogue: 0,0:14:13.26,0:14:16.10,Default,,0,0,0,,Неліктен мұндай жеңіл соққымен?
Dialogue: 0,0:14:17.35,0:14:18.31,Default,,0,0,0,,Қайсысы!
Dialogue: 0,0:14:19.14,0:14:20.27,Default,,0,0,0,,‎Қайдасың!
Dialogue: 0,0:14:21.52,0:14:22.36,Default,,0,0,0,,А...
Dialogue: 0,0:14:23.36,0:14:24.36,Default,,0,0,0,,‎Темекі!
Dialogue: 0,0:14:25.11,0:14:27.15,Default,,0,0,0,,‎Жабу…4 метр
Dialogue: 0,0:14:27.65,0:14:29.07,Default,,0,0,0,,‎Жоқ, 3 метр
Dialogue: 0,0:14:35.08,0:14:35.91,Default,,0,0,0,,Уф
Dialogue: 0,0:14:40.33,0:14:41.17,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:42.21,0:14:43.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:43.84,0:14:47.13,Default,,0,0,0,,Сізге қалай ұнайды? мырза Дойл
Dialogue: 0,0:14:47.88,0:14:51.14,Default,,0,0,0,,Өзіңіздің қалаған қара белбеуіңізді тағу қандай сезімде?
Dialogue: 0,0:14:51.30,0:14:53.64,Default,,0,0,0,,‎Ах... а...
Dialogue: 0,0:14:55.31,0:14:56.43,Default,,0,0,0,,‎ku…ku…
Dialogue: 0,0:14:56.72,0:14:58.14,Default,,0,0,0,,‎Куку… Куку~
Dialogue: 0,0:14:59.06,0:14:59.94,Default,,0,0,0,,Өйткені!
Dialogue: 0,0:15:01.77,0:15:02.61,Default,,0,0,0,,‎Gee…
Dialogue: 0,0:15:02.73,0:15:03.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:03.69,0:15:04.52,Default,,0,0,0,,Шаш!
Dialogue: 0,0:15:05.11,0:15:05.94,Default,,0,0,0,,‎Сая~!
Dialogue: 0,0:15:06.07,0:15:06.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:09.61,0:15:10.45,Default,,0,0,0,,А...
Dialogue: 0,0:15:14.07,0:15:15.41,Default,,0,0,0,,‎Уф... Уф
Dialogue: 0,0:15:15.58,0:15:17.41,Default,,0,0,0,,‎Гах... Ха...
Dialogue: 0,0:15:17.83,0:15:19.62,Default,,0,0,0,,‎Хмм... аа...
Dialogue: 0,0:15:22.08,0:15:24.08,Default,,0,0,0,,‎Хаа… Хаа…
Dialogue: 0,0:15:24.17,0:15:25.17,Default,,0,0,0,,А
Dialogue: 0,0:15:26.75,0:15:30.72,Default,,0,0,0,,‎Ертеде біздің Жапония елінде
Dialogue: 0,0:15:30.93,0:15:34.05,Default,,0,0,0,,Тәкаппарлығын тастаған самурайдың басын алды
Dialogue: 0,0:15:35.68,0:15:38.93,Default,,0,0,0,,Сіз де...
Dialogue: 0,0:15:39.52,0:15:41.39,Default,,0,0,0,,Мен мақтанышымды тастадым
Dialogue: 0,0:15:41.81,0:15:42.65,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:42.77,0:15:43.60,Default,,0,0,0,,Ух...
Dialogue: 0,0:15:48.61,0:15:49.44,Default,,0,0,0,,О!
Dialogue: 0,0:15:51.82,0:15:53.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:53.57,0:15:57.58,Default,,0,0,0,,‎(Янаги) ‎Ақымақ... қолыңызбен ауыр қылышты бөгеу сияқты.
Dialogue: 0,0:15:59.58,0:16:00.87,Default,,0,0,0,,‎Әйгілі қылыш...
Dialogue: 0,0:16:01.33,0:16:02.79,Default,,0,0,0,,‎(Янаги) ‎Бұл... бұл жігіт.
Dialogue: 0,0:16:04.08,0:16:05.71,Default,,0,0,0,,‎Қолдарыңыз үшін болат жақтау!
Dialogue: 0,0:16:06.13,0:16:06.96,Default,,0,0,0,,‎
Dialogue: 0,0:16:07.25,0:16:09.59,Default,,0,0,0,,‎Тч, қозғалма.
Dialogue: 0,0:16:09.71,0:16:11.88,Default,,0,0,0,,Сымдар үзілді ме?
Dialogue: 0,0:16:12.26,0:16:13.51,Default,,0,0,0,,Уф
Dialogue: 0,0:16:13.88,0:16:14.72,Default,,0,0,0,,‎Нон!
Dialogue: 0,0:16:16.39,0:16:17.47,Default,,0,0,0,,‎Одан да көп...
Dialogue: 0,0:16:20.14,0:16:21.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:22.69,0:16:24.02,Default,,0,0,0,,Менің көзім...
Dialogue: 0,0:16:25.31,0:16:27.27,Default,,0,0,0,,Көру мүмкін емес
Dialogue: 0,0:16:32.36,0:16:33.99,Default,,0,0,0,,‎Ку~!
Dialogue: 0,0:16:38.95,0:16:43.08,Default,,0,0,0,,‎(Кондордың айқайы)
Dialogue: 0,0:16:43.21,0:16:46.00,Default,,0,0,0,,(Әңгімелеу) Бірде Ресей батыры атанған
Dialogue: 0,0:16:46.13,0:16:49.67,Default,,0,0,0,,Александр Гален қазір ауруханада жатыр.
Dialogue: 0,0:16:50.75,0:16:54.17,Default,,0,0,0,,Денедегі жарақаттар жақсы жазылса да,
Dialogue: 0,0:16:54.34,0:16:55.47,Default,,0,0,0,,Алайда…
Dialogue: 0,0:17:02.56,0:17:03.39,Default,,0,0,0,,‎(Гален) О
Dialogue: 0,0:17:04.31,0:17:05.14,Default,,0,0,0,,А
Dialogue: 0,0:17:05.31,0:17:11.90,Default,,0,0,0,,‎(Желдің дыбысы)
Dialogue: 0,0:17:16.03,0:17:17.03,Default,,0,0,0,,‎(Гален) Сіз...
Dialogue: 0,0:17:18.07,0:17:18.91,Default,,0,0,0,,А
Dialogue: 0,0:17:19.41,0:17:20.87,Default,,0,0,0,,О... Әй!
Dialogue: 0,0:17:22.08,0:17:23.25,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:17:24.91,0:17:25.75,Default,,0,0,0,,‎(Сикорский) Хехе
Dialogue: 0,0:17:27.25,0:17:30.54,Default,,0,0,0,,‎Аа... Уф
Dialogue: 0,0:17:30.71,0:17:36.01,Default,,0,0,0,,‎(Әңгімелеу) Бірақ жүрегімдегі жаралар әлі жазылмады.
Dialogue: 0,0:17:36.13,0:17:37.68,Default,,0,0,0,,‎(Медбике) Га... Гарен мырза
Dialogue: 0,0:17:39.26,0:17:43.14,Default,,0,0,0,,(Әңгімелеу) Шамамен сол уақытта Ғарен осындай жағдайға мәжбүр болды.
Dialogue: 0,0:17:43.27,0:17:47.19,Default,,0,0,0,,Өлім жазасына кесілген Сикорский отырған түрмеде.
Dialogue: 0,0:17:47.81,0:17:50.56,Default,,0,0,0,,Белгілі бір тексеру орын алмақ болды.
Dialogue: 0,0:17:51.23,0:17:56.74,Default,,0,0,0,,(Тасқа өрмелеуші) Маған демалыс беріңізші. Біз маймыл немесе геккон емеспіз.
Dialogue: 0,0:17:57.95,0:17:59.74,Default,,0,0,0,,‎(Түрме бастығы) Енді менің сұрағым бар.
Dialogue: 0,0:18:00.37,0:18:03.45,Default,,0,0,0,,‎Мысалы, ешқандай құралдарды қолданбай
Dialogue: 0,0:18:04.24,0:18:08.92,Default,,0,0,0,,Егер мен осында өрмелейтін болсам, маған қандай қабілет керек еді?
Dialogue: 0,0:18:09.96,0:18:10.79,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:18:11.04,0:18:13.67,Default,,0,0,0,,‎Сен мұны істей аласың, бәрібір істей алмайсың.
Dialogue: 0,0:18:15.09,0:18:19.22,Default,,0,0,0,,Иә... Мен әлі де осындай көлемдегі жаңғақты ұстаймын.
Dialogue: 0,0:18:20.34,0:18:22.47,Default,,0,0,0,,Бір қысқаша әңгіме
Dialogue: 0,0:18:22.89,0:18:25.18,Default,,0,0,0,,‎Оқуды оңай аяқтай аласыз...
Dialogue: 0,0:18:25.31,0:18:28.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:28.69,0:18:30.73,Default,,0,0,0,,‎Бұл енді адам емес.
Dialogue: 0,0:18:30.85,0:18:32.73,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:18:35.94,0:18:37.15,Default,,0,0,0,,‎(Сикорский) Бұл кім?
Dialogue: 0,0:18:38.03,0:18:39.32,Default,,0,0,0,,‎Фуфуфу
Dialogue: 0,0:18:40.32,0:18:42.99,Default,,0,0,0,,Көп айтудың қажеті жоқ.
Dialogue: 0,0:18:43.83,0:18:47.25,Default,,0,0,0,,Ол сенің жауың.
Dialogue: 0,0:18:48.50,0:18:49.67,Default,,0,0,0,,‎(Сикорский) ‎Үлкен...
Dialogue: 0,0:18:51.21,0:18:52.50,Default,,0,0,0,,Ең...
Dialogue: 0,0:18:53.46,0:18:56.26,Default,,0,0,0,,‎Менің жағдайда, бұл сіз сияқты.
Dialogue: 0,0:18:56.38,0:18:59.76,Default,,0,0,0,,‎Мүмкін, дөрекі күрескер
Dialogue: 0,0:19:00.51,0:19:02.43,Default,,0,0,0,,Олай болса... мұны қайда істеуіміз керек?
Dialogue: 0,0:19:03.01,0:19:05.56,Default,,0,0,0,,‎Жапонияда полиция шулы.
Dialogue: 0,0:19:05.85,0:19:07.39,Default,,0,0,0,,Мен осылай екеніне сенімдімін...
Dialogue: 0,0:19:08.23,0:19:10.06,Default,,0,0,0,,(Сикорский) және күшті...
Dialogue: 0,0:19:10.94,0:19:12.40,Default,,0,0,0,,керемет
Dialogue: 0,0:19:19.90,0:19:21.41,Default,,0,0,0,,‎Дайын!
Dialogue: 0,0:19:22.16,0:19:23.16,Default,,0,0,0,,Хмф!
Dialogue: 0,0:19:23.32,0:19:24.16,Default,,0,0,0,,‎(Сикорский) Ух...
Dialogue: 0,0:19:25.03,0:19:25.87,Default,,0,0,0,,Ей!
Dialogue: 0,0:19:27.79,0:19:28.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:29.54,0:19:30.37,Default,,0,0,0,,Ға!
Dialogue: 0,0:19:30.83,0:19:31.67,Default,,0,0,0,,‎Гу…
Dialogue: 0,0:19:32.08,0:19:33.17,Default,,0,0,0,,Уф
Dialogue: 0,0:19:34.04,0:19:35.34,Default,,0,0,0,,‎Ho…
Dialogue: 0,0:19:41.80,0:19:47.18,Default,,0,0,0,,Менің саусақтарымның күші көп, бірақ мен қашанға дейін олай боламын...
Dialogue: 0,0:19:47.35,0:19:48.18,Default,,0,0,0,,Хмф!
Dialogue: 0,0:19:49.47,0:19:50.31,Default,,0,0,0,,Ей!
Dialogue: 0,0:19:50.48,0:19:51.31,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:19:54.98,0:19:55.81,Default,,0,0,0,,‎Хмм.
Dialogue: 0,0:19:56.48,0:19:57.32,Default,,0,0,0,,Ух...
Dialogue: 0,0:20:01.15,0:20:03.82,Default,,0,0,0,,‎Жарайды, түсіндім.
Dialogue: 0,0:20:04.78,0:20:06.33,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:20:08.74,0:20:09.58,Default,,0,0,0,,‎(Сикорский) Хмф!
Dialogue: 0,0:20:10.00,0:20:10.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:11.00,0:20:11.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:12.92,0:20:14.00,Default,,0,0,0,,‎Фухун
Dialogue: 0,0:20:14.12,0:20:15.33,Default,,0,0,0,,Хмф! (Сикорский) Уау!
Dialogue: 0,0:20:17.50,0:20:19.34,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:20:19.46,0:20:20.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:23.38,0:20:24.22,Default,,0,0,0,,‎(Сикорский) Уф!
Dialogue: 0,0:20:26.64,0:20:27.47,Default,,0,0,0,,‎(Сикорский) бұл...
Dialogue: 0,0:20:30.27,0:20:31.02,Default,,0,0,0,,Ух...
Dialogue: 0,0:20:34.65,0:20:35.65,Default,,0,0,0,,А...
Dialogue: 0,0:20:35.77,0:20:36.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:42.15,0:20:46.99,Default,,0,0,0,,(Ер) Жоқ, ұялы телефонымның батареясы таусылған.
Dialogue: 0,0:20:47.45,0:20:49.45,Default,,0,0,0,,‎Бірақ мен сенің дауысыңды естігім келмейді.
Dialogue: 0,0:20:49.58,0:20:50.62,Default,,0,0,0,,(Есіктің ашылған дыбысы) Ах...
Dialogue: 0,0:20:50.70,0:20:51.75,Default,,0,0,0,,(Телефон: Әйел) Өтірік
Dialogue: 0,0:20:53.58,0:20:54.79,Default,,0,0,0,,‎(Телефон: Әйел) ‎Сәлеметсіз бе?
Dialogue: 0,0:20:54.92,0:20:55.75,Default,,0,0,0,,‎(Ер) Ах...
Dialogue: 0,0:20:57.75,0:20:58.59,Default,,0,0,0,,‎Гах...
Dialogue: 0,0:21:04.47,0:21:07.26,Default,,0,0,0,,‎(Телефон: Әйел) ‎Шо-чан, не болды?
Dialogue: 0,0:21:08.05,0:21:10.14,Default,,0,0,0,,‎(Ер адам) Не... Не болды қызық...
Dialogue: 0,0:21:15.10,0:21:21.11,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:22:38.14,0:22:44.15,Default,,0,0,0,,‎〜♪
