Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.42,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:00:37.99,0:00:39.33,Default,,0,0,0,,Лиджер Барот
Dialogue: 0,0:00:41.66,0:00:43.91,Default,,0,0,0,,Джеральд Валькири
Dialogue: 0,0:00:44.50,0:00:45.21,Default,,0,0,0,,Иә
Dialogue: 0,0:00:45.71,0:00:48.54,Default,,0,0,0,,...
Dialogue: 0,0:00:49.59,0:00:52.42,Default,,0,0,0,,Аскин Кнуклевар
Dialogue: 0,0:00:53.09,0:00:54.01,Default,,0,0,0,,Иә
Dialogue: 0,0:00:54.63,0:00:56.89,Default,,0,0,0,,Және Урю
Dialogue: 0,0:01:00.89,0:01:06.35,Default,,0,0,0,,Біздің қасиетті жерімізге, Шынайы әлем сарайына (Ваалвельт) аяқ басқан өлім құдайлары
Dialogue: 0,0:01:06.44,0:01:08.77,Default,,0,0,0,,Жылы қарсы алыңыз
Dialogue: 0,0:01:10.15,0:01:13.28,Default,,0,0,0,,Олардың қанын кесеге құйыңыз
Dialogue: 0,0:01:13.36,0:01:17.16,Default,,0,0,0,,Осы шынайы дүниенің туған күнін тойлайық (Верт).
Dialogue: 0,0:01:17.24,0:01:18.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:23.50,0:01:25.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:50.96,0:02:52.96,Default,,0,0,0,,～♪
Dialogue: 0,0:02:54.21,0:02:55.46,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:02:55.55,0:02:59.34,Default,,0,0,0,,Бұл тағы да үлкен.
Dialogue: 0,0:02:59.42,0:03:04.30,Default,,0,0,0,,Құлыптар жауларыңызға күшіңізді көрсетуге арналған.
Dialogue: 0,0:03:04.39,0:03:06.85,Default,,0,0,0,,Үлкен болмаса, ол іске қосылмайды.
Dialogue: 0,0:03:06.93,0:03:09.35,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:09.43,0:03:13.10,Default,,0,0,0,,Не болса да, сен мені қатты шақырып жатырсың.
Dialogue: 0,0:03:13.19,0:03:16.36,Default,,0,0,0,,Сізді тым ұзақ күту дөрекі болар еді.
Dialogue: 0,0:03:17.19,0:03:18.36,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:18.44,0:03:20.40,Default,,0,0,0,,Мен сенімен араласуды жоспарлап отырмын
Dialogue: 0,0:03:20.49,0:03:22.61,Default,,0,0,0,,Менің нұсқау алу ниетім жоқ.
Dialogue: 0,0:03:23.11,0:03:25.07,Default,,0,0,0,,Осы жерден қоштасайық.
Dialogue: 0,0:03:25.16,0:03:26.37,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:03:26.87,0:03:30.33,Default,,0,0,0,,Олай болса, бәріміз кеттік!
Dialogue: 0,0:03:30.41,0:03:31.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:44.43,0:03:48.35,Default,,0,0,0,,Сіз мұны сездіңіз бе? үшінның реиацулары сол қамалға қарай жылжи бастады.
Dialogue: 0,0:03:48.93,0:03:50.27,Default,,0,0,0,,Біз де барамыз.
Dialogue: 0,0:03:50.35,0:03:51.27,Default,,0,0,0,,- (Иваваси/Чадо) О! -(Орихиме/Nelliel) Иә!
Dialogue: 0,0:03:52.10,0:03:52.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:53.35,0:03:54.19,Default,,0,0,0,,Хун
Dialogue: 0,0:04:01.19,0:04:02.74,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:04:05.32,0:04:06.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:06.32,0:04:09.37,Default,,0,0,0,,Капитан Нирука қайда кетті?
Dialogue: 0,0:04:09.45,0:04:09.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.79,0:04:13.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:23.30,0:04:24.47,Default,,0,0,0,,Алайда, біз оның қозғалысын тоқтата аламыз.
Dialogue: 0,0:04:24.55,0:04:28.51,Default,,0,0,0,,Қақпаны жапқаннан кейін орынды ауыстырып, оны ашыңыз
Dialogue: 0,0:04:28.60,0:04:33.23,Default,,0,0,0,,Тіпті Рух сарайында да жалғыз әрекет ету оңай.
Dialogue: 0,0:04:33.73,0:04:38.73,Default,,0,0,0,,Менің қазір кетіп қалғанымды байқаған боларсыз.
Dialogue: 0,0:04:38.82,0:04:42.99,Default,,0,0,0,,Әйтеуір, енді немқұрайлылықпен айналысудың қажеті жоқ.
Dialogue: 0,0:04:43.07,0:04:47.66,Default,,0,0,0,,Менің зерттеуімнің нәтижелерін өз қалауыңыз бойынша сынап көруіңізге болады.
Dialogue: 0,0:04:48.20,0:04:49.16,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:49.24,0:04:50.41,Default,,0,0,0,,Не!
Dialogue: 0,0:04:50.49,0:04:53.62,Default,,0,0,0,,За… Зараки! Неге мұндасың...
Dialogue: 0,0:04:53.71,0:04:58.13,Default,,0,0,0,,Жарайды, мен дәретханаға барсам, бәрі кетіп қалды.
Dialogue: 0,0:04:58.92,0:05:02.51,Default,,0,0,0,,Қақпаны қайта ашқаныңыз үшін рахмет.
Dialogue: 0,0:05:02.59,0:05:04.63,Default,,0,0,0,,Дұрыс, Ямада!
Dialogue: 0,0:05:05.13,0:05:06.01,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:06.09,0:05:09.60,Default,,0,0,0,,Неліктен мен дәл осы уақытта ваннаға бардым?
Dialogue: 0,0:05:09.68,0:05:12.39,Default,,0,0,0,,Бірақ дәретханаға барғаныңыз дұрыс болды.
Dialogue: 0,0:05:12.89,0:05:17.35,Default,,0,0,0,,Бөлек әрекет етсең, одақтастарыңды қысқарту үшін уайымдамайтыны рас.
Dialogue: 0,0:05:17.44,0:05:20.65,Default,,0,0,0,,Сіз қалағаныңызша зорлық көрсете аласыз.
Dialogue: 0,0:05:21.15,0:05:23.78,Default,,0,0,0,,Мені қателесіп кесіп алсаң,
Dialogue: 0,0:05:23.86,0:05:26.03,Default,,0,0,0,,Жарайды, мен өлмейтін шығармын.
Dialogue: 0,0:05:26.11,0:05:27.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:28.03,0:05:29.62,Default,,0,0,0,,Басқа әрекет бар екені рас болса
Dialogue: 0,0:05:29.70,0:05:33.66,Default,,0,0,0,,Шулы жәндіктерді көмуге де ыңғайлы.
Dialogue: 0,0:05:33.75,0:05:35.25,Default,,0,0,0,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,0:05:35.33,0:05:37.75,Default,,0,0,0,,Бұл кім деп ойлайсың?
Dialogue: 0,0:05:37.83,0:05:40.13,Default,,0,0,0,,Ах! Шынымен...
Dialogue: 0,0:05:40.21,0:05:43.30,Default,,0,0,0,,Мен ол кезде не үшін ваннаға бардым?
Dialogue: 0,0:05:43.38,0:05:45.63,Default,,0,0,0,,Иә, иә, жылама, жылама
Dialogue: 0,0:05:45.72,0:05:47.68,Default,,0,0,0,,Сіз қашаннан бері шағымданасыз?
Dialogue: 0,0:05:47.76,0:05:49.01,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:05:49.51,0:05:50.72,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:50.80,0:05:52.10,Default,,0,0,0,,Мен ештеңе ойламаймын
Dialogue: 0,0:05:52.60,0:05:54.52,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:05:54.60,0:05:56.18,Default,,0,0,0,,- (Иккаку) О! -(Ханатаро)...Иә!
Dialogue: 0,0:05:57.89,0:06:00.77,Default,,0,0,0,,Хун, мен де барамын, Нему.
Dialogue: 0,0:06:00.86,0:06:02.48,Default,,0,0,0,,Иә Маюри-сама
Dialogue: 0,0:06:08.32,0:06:12.66,Default,,0,0,0,,Мүмкін болса, мен Кучики-сан мен Ренжи-кунмен қосылғым келеді.
Dialogue: 0,0:06:12.74,0:06:13.74,Default,,0,0,0,,О
Dialogue: 0,0:06:13.83,0:06:18.29,Default,,0,0,0,,Бірақ мен тірек тұрғыза алмаймын, тіпті Mesenger God Machine-ті де пайдалана алмаймын.
Dialogue: 0,0:06:18.79,0:06:20.58,Default,,0,0,0,,Өзіміз күресуден басқа амалымыз жоқ.
Dialogue: 0,0:06:22.13,0:06:24.05,Default,,0,0,0,,Нысаналы жау бірдей
Dialogue: 0,0:06:24.55,0:06:26.26,Default,,0,0,0,,Мен сені кейінірек міндетті түрде кездестіремін.
Dialogue: 0,0:06:27.17,0:06:28.26,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:28.34,0:06:31.18,Default,,0,0,0,,Ха! Кездесудің қажеті бар ма?
Dialogue: 0,0:06:31.68,0:06:35.26,Default,,0,0,0,,Жануарлардың саны көбейген сайын қозғала алмайсың.
Dialogue: 0,0:06:35.35,0:06:37.18,Default,,0,0,0,,Тек пайдасыз мәйіттер болады.
Dialogue: 0,0:06:37.27,0:06:38.48,Default,,0,0,0,,Гриммжоу!
Dialogue: 0,0:06:38.56,0:06:40.06,Default,,0,0,0,,Бұл қоқыс
Dialogue: 0,0:06:40.14,0:06:41.69,Default,,0,0,0,,Мен бірінші барамын.
Dialogue: 0,0:06:42.19,0:06:43.52,Default,,0,0,0,,Күте тұрыңыз, мұнда не бар!
Dialogue: 0,0:06:45.65,0:06:49.45,Default,,0,0,0,,А... Бұл не? Куросаки Ичиго тобы?
Dialogue: 0,0:06:49.53,0:06:51.32,Default,,0,0,0,,Жол жоқ, жігітім.
Dialogue: 0,0:06:51.41,0:06:51.91,Default,,0,0,0,,Цукуёми-кун мен Каэрубүки-санға қандай сынақтар қойылған?
Dialogue: 0,0:06:52.95,0:06:54.74,Default,,0,0,0,,Не? Жоқ, күте тұрыңыз!
Dialogue: 0,0:06:54.83,0:06:56.45,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:57.54,0:07:00.67,Default,,0,0,0,,Қат! Кенет менің ішімнен бір қулық шықты.
Dialogue: 0,0:07:07.92,0:07:09.38,Default,,0,0,0,,Ешкім
Dialogue: 0,0:07:09.88,0:07:12.43,Default,,0,0,0,,Жау болудан алыс, адам баласы...
Dialogue: 0,0:07:12.51,0:07:13.64,Default,,0,0,0,,Нуу…
Dialogue: 0,0:07:13.72,0:07:16.01,Default,,0,0,0,,Тыңдаңдар, өлім құдайлары!
Dialogue: 0,0:07:16.10,0:07:17.89,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:07:17.97,0:07:21.19,Default,,0,0,0,,Бірден қоңырау шалыңыз!
Dialogue: 0,0:07:26.48,0:07:28.90,Default,,0,0,0,,Қаланың пішіні өзгерді, бірақ
Dialogue: 0,0:07:28.99,0:07:32.11,Default,,0,0,0,,Мен Күміс қамалға (Гилберн) жақындай алдым.
Dialogue: 0,0:07:32.20,0:07:33.78,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:07:34.45,0:07:36.78,Default,,0,0,0,,Өз қолымызбен шешеміз.
Dialogue: 0,0:07:36.87,0:07:38.62,Default,,0,0,0,,Юхбахқа
Dialogue: 0,0:07:39.12,0:07:39.79,Default,,0,0,0,,Және…
Dialogue: 0,0:07:42.37,0:07:44.00,Default,,0,0,0,,Хашвальдқа
Dialogue: 0,0:07:49.17,0:07:51.17,Default,,0,0,0,,Біріншіден, бір.
Dialogue: 0,0:07:51.67,0:07:54.72,Default,,0,0,0,,Гриммжоу, неге жаңа ғана секірдің!
Dialogue: 0,0:07:55.39,0:07:56.51,Default,,0,0,0,,Шулы
Dialogue: 0,0:07:57.01,0:08:00.14,Default,,0,0,0,,Аузыңды жап, Куросаки! Маған нұсқаулар беріңізші...
Dialogue: 0,0:08:05.31,0:08:06.23,Default,,0,0,0,,Сіз оның қашып кетуіне жол бердіңіз бе?
Dialogue: 0,0:08:06.31,0:08:07.73,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:08:08.23,0:08:08.86,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:08.94,0:08:10.23,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:10.32,0:08:12.86,Default,,0,0,0,,Мен күтсем және ол мені өлтірмесе, күтемін бе?
Dialogue: 0,0:08:12.95,0:08:15.20,Default,,0,0,0,,Мен сені өлтіремін деп айтпа.
Dialogue: 0,0:08:15.28,0:08:16.62,Default,,0,0,0,,Ах… Хах… Ах…
Dialogue: 0,0:08:16.70,0:08:20.62,Default,,0,0,0,,Егер Тем меннен әлсіз болса, Тем соның салдарынан өледі.
Dialogue: 0,0:08:20.70,0:08:23.37,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым! Сөзсіз күтпеңіз
Dialogue: 0,0:08:23.46,0:08:26.17,Default,,0,0,0,,Менің ойымша, олар төбелесуге келген.
Dialogue: 0,0:08:26.25,0:08:27.88,Default,,0,0,0,,Неге қашып бара жатырсың?
Dialogue: 0,0:08:28.46,0:08:32.26,Default,,0,0,0,,Мен ұрысуға келген жоқпын, сені өлтіруге келдім.
Dialogue: 0,0:08:32.34,0:08:35.01,Default,,0,0,0,,Оны жасырын түрде өлтіре алсаңыз жақсы!
Dialogue: 0,0:08:35.09,0:08:38.51,Default,,0,0,0,,Алдымен сен кімсің, кенет шықтың ба?
Dialogue: 0,0:08:39.01,0:08:41.93,Default,,0,0,0,,Мен? Мен Куросакидің жауымын
Dialogue: 0,0:08:42.02,0:08:45.60,Default,,0,0,0,,Шынайы ма? Сонда біз доспыз, солай ма?
Dialogue: 0,0:08:45.69,0:08:47.81,Default,,0,0,0,,Куросакиді бірге өлтірейік.
Dialogue: 0,0:08:48.40,0:08:50.78,Default,,0,0,0,,Сен сондай шулы бейбақсың.
Dialogue: 0,0:08:50.86,0:08:53.28,Default,,0,0,0,,Жетер, жүгіре бер!
Dialogue: 0,0:08:54.57,0:08:56.66,Default,,0,0,0,,Мен сені бірден қуып жетіп, өлтіремін!
Dialogue: 0,0:08:57.82,0:09:00.74,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:09:00.83,0:09:03.20,Default,,0,0,0,,(Ичиго мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:09:03.29,0:09:06.46,Default,,0,0,0,,Мен оны толығымен жоғалттым.
Dialogue: 0,0:09:07.08,0:09:11.05,Default,,0,0,0,,Мен мұндай жылдамдықпен кетеді деп ойламаппын.
Dialogue: 0,0:09:11.13,0:09:12.76,Default,,0,0,0,,Гриммжоу жігіті...
Dialogue: 0,0:09:12.84,0:09:14.67,Default,,0,0,0,,Әзірге бөлініп, ізденейік.
Dialogue: 0,0:09:14.76,0:09:15.97,Default,,0,0,0,,- (Орихиме) Иә - (Иваваси) О!
Dialogue: 0,0:09:19.26,0:09:22.89,Default,,0,0,0,,Фуу~ Әзірше кешіріңіз.
Dialogue: 0,0:09:22.97,0:09:27.19,Default,,0,0,0,,Ичиго Куросаки және басқалары, сондай-ақ сол жабайы регент жігіті.
Dialogue: 0,0:09:27.69,0:09:30.77,Default,,0,0,0,,Кафе-ау лайт ішіп, демалыңыз...
Dialogue: 0,0:09:30.86,0:09:31.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:33.82,0:09:35.03,Default,,0,0,0,,Маған қашуға рұқсат етіңіз!
Dialogue: 0,0:09:35.11,0:09:37.15,Default,,0,0,0,,Мені бір рет кешіріңіз.
Dialogue: 0,0:09:37.24,0:09:38.57,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:09:38.66,0:09:40.24,Default,,0,0,0,,Қараңдар, мен мұны істеймін.
Dialogue: 0,0:09:40.32,0:09:42.03,Default,,0,0,0,,Бұл сыйлық, қабыл алыңыздар.
Dialogue: 0,0:09:42.87,0:09:44.29,Default,,0,0,0,,Сыйлық?
Dialogue: 0,0:09:44.37,0:09:47.67,Default,,0,0,0,,Сіз осындай баяу шабуылға ұшырайсыз ба?
Dialogue: 0,0:09:48.54,0:09:50.67,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:09:52.04,0:09:53.75,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:09:54.96,0:09:59.34,Default,,0,0,0,,«Сыйлық доп» уланған допты білдіреді.
Dialogue: 0,0:09:59.43,0:10:01.22,Default,,0,0,0,,Кішкентай кезіңізде үйренбедіңіз бе?
Dialogue: 0,0:10:01.30,0:10:04.47,Default,,0,0,0,,«Сіз бейтаныс адамдардан нәрселерді қабылдамауыңыз керек».
Dialogue: 0,0:10:04.97,0:10:07.56,Default,,0,0,0,,Мен анамның бұйрығын орындай алмаймын
Dialogue: 0,0:10:07.64,0:10:09.65,Default,,0,0,0,,Сіз өлімшісіз.
Dialogue: 0,0:10:20.74,0:10:23.08,Default,,0,0,0,,Құрылым бірте-бірте ұйымдаспайды.
Dialogue: 0,0:10:23.58,0:10:24.62,Default,,0,0,0,,Жеке дене дайындығы
Dialogue: 0,0:10:25.12,0:10:28.87,Default,,0,0,0,,Рух сарайының жоғары концентрациялы рух ортасына бейімделу
Dialogue: 0,0:10:29.37,0:10:30.62,Default,,0,0,0,,Зақымдану дәрежесі
Dialogue: 0,0:10:31.13,0:10:34.50,Default,,0,0,0,,Осы факторлардың әсерінен табын бірте-бірте жойылады.
Dialogue: 0,0:10:35.80,0:10:36.63,Default,,0,0,0,,Және…
Dialogue: 0,0:10:37.13,0:10:38.63,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:10:39.72,0:10:41.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:45.81,0:10:47.52,Default,,0,0,0,,- (Омаэда) Хисаки! -(Киёне) Вице-капитан Хисаги!
Dialogue: 0,0:10:47.60,0:10:49.14,Default,,0,0,0,,Барлық тірі заттар
Dialogue: 0,0:10:49.23,0:10:51.77,Default,,0,0,0,,Үйірден адасқандар өледі.
Dialogue: 0,0:10:51.85,0:10:53.44,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:10:53.52,0:10:54.48,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:54.57,0:10:58.11,Default,,0,0,0,,Үйірден бірінен соң бірі бөлініп шықтық.
Dialogue: 0,0:10:58.19,0:10:58.69,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:11:00.45,0:11:01.28,Default,,0,0,0,,Не!
Dialogue: 0,0:11:03.32,0:11:04.12,Default,,0,0,0,,Гррр…
Dialogue: 0,0:11:04.62,0:11:06.04,Default,,0,0,0,,Сізді нысанаға алып жатырсыз!
Dialogue: 0,0:11:06.54,0:11:07.83,Default,,0,0,0,,Тоқтамаңыз, жалғастырыңыз!
Dialogue: 0,0:11:10.21,0:11:11.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:15.67,0:11:18.17,Default,,0,0,0,,Сіз әлі де қашып кете аламын деп ойлайсыз ба?
Dialogue: 0,0:11:20.38,0:11:21.88,Default,,0,0,0,,Бұл күнә
Dialogue: 0,0:11:28.39,0:11:29.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:35.02,0:11:36.82,Default,,0,0,0,,Бұл қайталау...
Dialogue: 0,0:11:48.41,0:11:49.66,Default,,0,0,0,,Айқай...
Dialogue: 0,0:11:55.84,0:11:57.09,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:59.34,0:12:01.51,Default,,0,0,0,,Йо, жойғыш (Квинси)
Dialogue: 0,0:12:14.77,0:12:17.98,Default,,0,0,0,,Мына плащ саған жарасады, солай емес пе?
Dialogue: 0,0:12:19.82,0:12:21.94,Default,,0,0,0,,Сенімді болу үшін мен тыңдаймын.
Dialogue: 0,0:12:22.03,0:12:25.36,Default,,0,0,0,,Сен маған жол көрсету үшін шыққан жоқсың ғой?
Dialogue: 0,0:12:25.99,0:12:30.12,Default,,0,0,0,,Шинигамидің осы нүктеден асқан болашағы жоқ.
Dialogue: 0,0:12:30.20,0:12:31.87,Default,,0,0,0,,Бұл жауап емес.
Dialogue: 0,0:12:32.46,0:12:36.71,Default,,0,0,0,,Рух Патшасын қабылдап, Мәртебелі толық билікке ие болды.
Dialogue: 0,0:12:37.21,0:12:40.46,Default,,0,0,0,,Оларды жеңе алмайсың дейді.
Dialogue: 0,0:12:41.21,0:12:43.34,Default,,0,0,0,,Сіз Рух Патшасын қабылдадыңыз ба?
Dialogue: 0,0:12:43.42,0:12:47.18,Default,,0,0,0,,Осы Варвелттен, Квинси...
Dialogue: 0,0:12:47.93,0:12:51.85,Default,,0,0,0,,Мәртебелі үшін жаңа дүние басталады.
Dialogue: 0,0:12:52.48,0:12:54.10,Default,,0,0,0,,Тағы бір нәрсе сұрайын.
Dialogue: 0,0:12:54.60,0:12:56.73,Default,,0,0,0,,Ичигомен кездескен жоқсың ба?
Dialogue: 0,0:12:57.86,0:12:59.15,Default,,0,0,0,,Өлтірілді
Dialogue: 0,0:13:00.07,0:13:04.28,Default,,0,0,0,,...Мен мұны істеуге ниеттендім, бірақ мен оның табандылығын қате бағаладым.
Dialogue: 0,0:13:05.70,0:13:07.74,Default,,0,0,0,,Келесі жолы міндетті түрде тоқтаңыз.
Dialogue: 0,0:13:07.82,0:13:11.29,Default,,0,0,0,,Дұрыс, мен өте жақсы түсіндім.
Dialogue: 0,0:13:12.33,0:13:15.16,Default,,0,0,0,,Сол сарай және Квинсидің бастығы
Dialogue: 0,0:13:15.25,0:13:16.96,Default,,0,0,0,,Мен сені құртамын!
Dialogue: 0,0:13:23.46,0:13:24.17,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:31.89,0:13:32.68,Default,,0,0,0,,Банкай
Dialogue: 0,0:13:39.81,0:13:41.77,Default,,0,0,0,,Суу Джабиомару
Dialogue: 0,0:13:42.90,0:13:44.78,Default,,0,0,0,,Жаңа Банкай?
Dialogue: 0,0:13:46.11,0:13:47.61,Default,,0,0,0,,Жылан тілін бұрмалаушы!
Dialogue: 0,0:13:51.87,0:13:52.74,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:13:55.83,0:13:56.79,Default,,0,0,0,,Орочи патша!
Dialogue: 0,0:13:57.54,0:13:58.17,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:00.58,0:14:04.21,Default,,0,0,0,,Әдеттегідей, сіз тек күшпен итермелей аласыз.
Dialogue: 0,0:14:08.47,0:14:09.59,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:14:19.48,0:14:20.15,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:22.31,0:14:24.19,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:31.28,0:14:32.28,Default,,0,0,0,,Жарық жаңбыр (Личт Реген)
Dialogue: 0,0:14:35.20,0:14:36.54,Default,,0,0,0,,Боку патша!
Dialogue: 0,0:14:51.22,0:14:52.93,Default,,0,0,0,,Маған қашып кетуге жол берме!
Dialogue: 0,0:15:06.15,0:15:07.19,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:07.78,0:15:08.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:12.07,0:15:12.91,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:15:16.87,0:15:17.83,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:15:27.42,0:15:30.22,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:15:31.13,0:15:31.97,Default,,0,0,0,,Ааах…
Dialogue: 0,0:15:35.39,0:15:38.77,Default,,0,0,0,,Суу Джабиомару Жаки Фанг Теппо!
Dialogue: 0,0:15:42.81,0:15:44.02,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:55.20,0:15:56.45,Default,,0,0,0,,Жоқ... Ни!
Dialogue: 0,0:15:58.70,0:16:01.71,Default,,0,0,0,,Күшті болған жалғыз өзің деп ойлайсың ба?
Dialogue: 0,0:16:04.12,0:16:04.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:31.32,0:16:32.78,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:16:41.79,0:16:42.71,Default,,0,0,0,,Бұл...!
Dialogue: 0,0:16:48.46,0:16:50.84,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:16:56.01,0:16:56.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:04.56,0:17:05.81,Default,,0,0,0,,Шохеи Тенсей
Dialogue: 0,0:17:10.32,0:17:11.44,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:13.11,0:17:16.16,Default,,0,0,0,,Осының көмегімен сіз Темені біраз уақытқа тоқтата аласыз.
Dialogue: 0,0:17:18.32,0:17:20.24,Default,,0,0,0,,20 секунд.
Dialogue: 0,0:17:23.87,0:17:25.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:27.75,0:17:30.00,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:30.50,0:17:34.63,Default,,0,0,0,,Хмм, ол ақыры пішінге келді.
Dialogue: 0,0:17:34.72,0:17:37.63,Default,,0,0,0,,Өзіңнің шын есіміңді атау деген осы.
Dialogue: 0,0:17:38.30,0:17:42.97,Default,,0,0,0,,Картоп қазіргідей пішінін сақтау үшін барын салуда.
Dialogue: 0,0:17:43.06,0:17:45.68,Default,,0,0,0,,Әдістер бір сәтте жоғалады
Dialogue: 0,0:17:46.19,0:17:51.15,Default,,0,0,0,,Джубиомаруға күштірек рейатсу қоймасаңыз, жауды жеңе алмайсыз.
Dialogue: 0,0:17:52.94,0:17:54.28,Default,,0,0,0,,Толығырақ...
Dialogue: 0,0:17:54.86,0:18:00.53,Default,,0,0,0,,Менің қазіргі күшіммен 20 секунд жеткілікті болуы керек.
Dialogue: 0,0:18:01.03,0:18:03.24,Default,,0,0,0,,Суу Джабиомару!
Dialogue: 0,0:18:07.79,0:18:10.42,Default,,0,0,0,,Жыланның қаңқасы ақырады!
Dialogue: 0,0:18:17.09,0:18:19.55,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:18:28.89,0:18:31.77,Default,,0,0,0,,Қалғандары төбелесіп тұрған жоқ па?
Dialogue: 0,0:18:31.86,0:18:36.53,Default,,0,0,0,,Hmph, сіз өзіңіздің реиатсуыңыздан ең кішкентай интеллектті сезе алмайтын шайқастар.
Dialogue: 0,0:18:36.61,0:18:38.15,Default,,0,0,0,,Бұл түкке тұрғысыз
Dialogue: 0,0:18:38.65,0:18:41.53,Default,,0,0,0,,А, сен олардың өкілі болдың.
Dialogue: 0,0:18:41.62,0:18:42.45,Default,,0,0,0,,Хо
Dialogue: 0,0:18:42.95,0:18:48.04,Default,,0,0,0,,Сонда менің ойымша, бізде шынымен де ақылды және қызықты жаулар бар.
Dialogue: 0,0:18:48.62,0:18:51.33,Default,,0,0,0,,Жолда кедергілер болмаса
Dialogue: 0,0:18:51.42,0:18:54.75,Default,,0,0,0,,Таққа басқалардан бұрын кім жетеді?
Dialogue: 0,0:18:55.42,0:18:59.97,Default,,0,0,0,,Әлде бір нәрсе ме? Жол шөптерін жегіңіз келе ме?
Dialogue: 0,0:19:03.68,0:19:04.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:05.31,0:19:10.56,Default,,0,0,0,,Сол үшін айттым ғой, солай ма? Куросакиді бірге өлтірейік.
Dialogue: 0,0:19:11.06,0:19:14.40,Default,,0,0,0,,Бәлкім олай істесең өлмес едің.
Dialogue: 0,0:19:14.48,0:19:16.23,Default,,0,0,0,,Шулы
Dialogue: 0,0:19:17.36,0:19:21.45,Default,,0,0,0,,Куросаки мен Теми де... Мен оларды өлтіремін.
Dialogue: 0,0:19:21.95,0:19:23.20,Default,,0,0,0,,Мен тіпті өмірімді сұраймын
Dialogue: 0,0:19:23.28,0:19:24.87,Default,,0,0,0,,Сүйкімді болса да
Dialogue: 0,0:19:24.95,0:19:27.87,Default,,0,0,0,,Сіз өте қауіптісіз.
Dialogue: 0,0:19:27.95,0:19:29.16,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:19:37.96,0:19:39.88,Default,,0,0,0,,Өзіңізді жаман сезінбеңіз
Dialogue: 0,0:19:51.52,0:19:54.90,Default,,0,0,0,,Толтырманың соншалықты босаң болуы Куросакидің әсерінен бе?
Dialogue: 0,0:19:55.56,0:19:56.69,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:19:57.90,0:19:59.74,Default,,0,0,0,,Склавера
Dialogue: 0,0:20:02.91,0:20:03.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:04.24,0:20:06.53,Default,,0,0,0,,Федерцвингер
Dialogue: 0,0:20:13.29,0:20:14.21,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:20:16.17,0:20:18.05,Default,,0,0,0,,Уф... ау!
Dialogue: 0,0:20:18.13,0:20:20.05,Default,,0,0,0,,О…
Dialogue: 0,0:20:20.13,0:20:22.80,Default,,0,0,0,,Ааа! Уф...
Dialogue: 0,0:20:23.38,0:20:25.14,Default,,0,0,0,,Федерцвингер
Dialogue: 0,0:20:25.22,0:20:27.55,Default,,0,0,0,,Ішінде құлыпталған барлық нәрседен
Dialogue: 0,0:20:27.64,0:20:29.56,Default,,0,0,0,,Рейацуды басып алу
Dialogue: 0,0:20:30.18,0:20:34.48,Default,,0,0,0,,Менің осы шектеулі кеңістікте рухани қысымды жою мүмкіндігім
Dialogue: 0,0:20:34.98,0:20:37.06,Default,,0,0,0,,Мен сенен бәрін тартып аламын
Dialogue: 0,0:20:37.15,0:20:38.65,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:20:39.78,0:20:42.03,Default,,0,0,0,,Егер Рейацу шегіне дейін жойылса
Dialogue: 0,0:20:42.53,0:20:45.95,Default,,0,0,0,,Банкай да, Шикай да күшін жоғалтады.
Dialogue: 0,0:20:50.99,0:20:51.95,Default,,0,0,0,,Гррр…
Dialogue: 0,0:20:54.29,0:20:57.38,Default,,0,0,0,,Сіздің Банкайыңыз осы жерде аяқталады.
Dialogue: 0,0:21:00.96,0:21:04.47,Default,,0,0,0,,Квинси Банкай туралы айтпауы керек.
Dialogue: 0,0:21:08.55,0:21:09.68,Default,,0,0,0,,Банкай!
Dialogue: 0,0:21:11.39,0:21:13.85,Default,,0,0,0,,Егіз патшалардың есімдері...
Dialogue: 0,0:21:14.35,0:21:17.31,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:21:19.11,0:21:20.98,Default,,0,0,0,,Патшаның аты...?
Dialogue: 0,0:21:23.24,0:21:24.82,Default,,0,0,0,,Сүйек зеңбірегі!
Dialogue: 0,0:21:32.95,0:21:33.91,Default,,0,0,0,,Гах...
Dialogue: 0,0:21:40.09,0:21:41.96,Default,,0,0,0,,Зиг мырза, сізді тұтқындап ұстаған 30 Зерттеу корпусының сарбаздары➡
Dialogue: 0,0:21:45.09,0:21:47.76,Default,,0,0,0,,Сіздің жеңілгеніңіздің үш себебі бар.
Dialogue: 0,0:21:49.68,0:21:53.27,Default,,0,0,0,,Сіз менің маңызды ойымды білмей алып тастадыңыз.
Dialogue: 0,0:21:54.27,0:21:57.27,Default,,0,0,0,,Менің күшімді білмедің
Dialogue: 0,0:21:58.77,0:22:02.36,Default,,0,0,0,,Ал сені, мен жек көремін...
Dialogue: 0,0:22:02.98,0:22:04.32,Default,,0,0,0,,Қылмыскер
Dialogue: 0,0:22:06.57,0:22:08.57,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.82,0:23:33.82,Default,,0,0,0,,～♪
Dialogue: 0,0:23:39.20,0:23:42.12,Default,,0,0,0,,Тек өзім
Dialogue: 0,0:23:42.62,0:23:44.84,Default,,0,0,0,,Өзіңнің Құдайың бол
Dialogue: 0,0:23:46.34,0:23:52.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
