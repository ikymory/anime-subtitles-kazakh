Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.79,0:00:03.58,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:00:07.34,0:00:09.13,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:00:09.21,0:00:12.30,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:00:12.38,0:00:13.30,Default,,0,0,0,,Gi…
Dialogue: 0,0:00:13.38,0:00:14.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:17.64,0:00:18.56,Default,,0,0,0,,Һм?
Dialogue: 0,0:00:19.14,0:00:20.14,Default,,0,0,0,,Қайда барсаң да, қашып құтылуға жібермеймін!
Dialogue: 0,0:00:20.22,0:00:21.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:21.18,0:00:21.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:21.93,0:00:22.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:23.81,0:00:25.65,Default,,0,0,0,,Бұл капитан Нируки.
Dialogue: 0,0:00:26.15,0:00:27.19,Default,,0,0,0,,Иә
Dialogue: 0,0:00:27.27,0:00:31.19,Default,,0,0,0,,Әңгіме сол адам туралы болғандықтан, менің ойымша, бұл дұрыс.
Dialogue: 0,0:00:31.28,0:00:32.69,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:33.28,0:00:35.36,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:00:35.45,0:00:38.41,Default,,0,0,0,,Мен рухани қысымның ауытқуын алыстан байқаймын.
Dialogue: 0,0:00:38.49,0:00:41.79,Default,,0,0,0,,Бұл сіздің айналаңыздағы рухани қысымның азайып бара жатқанын білдірсе керек.
Dialogue: 0,0:00:41.87,0:00:43.66,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:00:43.75,0:00:46.33,Default,,0,0,0,,Мен олардың қай жақтан көздеп жатқанын білмеймін.
Dialogue: 0,0:00:46.42,0:00:49.84,Default,,0,0,0,,Әйтсе де, жылдамдықты бәсеңдетсең, жаудың көңілі қалады.
Dialogue: 0,0:00:50.88,0:00:52.59,Default,,0,0,0,,Бұл қорқынышты болуы керек
Dialogue: 0,0:00:52.67,0:00:55.34,Default,,0,0,0,,Дұрыс, мен түсінемін.
Dialogue: 0,0:00:55.43,0:00:58.47,Default,,0,0,0,,Мен қайда нысанаға алғанымды білмесем де.
Dialogue: 0,0:00:58.55,0:01:02.85,Default,,0,0,0,,Менің достарым алыстан мергендіктен бірінен соң бірі жоғалып кетеді.
Dialogue: 0,0:01:02.93,0:01:06.35,Default,,0,0,0,,Мұндай нәрседен қорықпаған адам емделмейді.
Dialogue: 0,0:01:06.44,0:01:08.10,Default,,0,0,0,,Қалай болғанда да.
Dialogue: 0,0:01:08.61,0:01:13.28,Default,,0,0,0,,Қаншама құрбандық шалып, жаудың не істеп жатқанын білмей тұрғанда...
Dialogue: 0,0:01:13.36,0:01:16.28,Default,,0,0,0,,Топта сондай адам болса
Dialogue: 0,0:01:16.36,0:01:17.95,Default,,0,0,0,,Бұл ақымақ па...
Dialogue: 0,0:01:20.28,0:01:22.91,Default,,0,0,0,,Келесі қадамды жасау уақыты келді.
Dialogue: 0,0:01:23.75,0:01:25.54,Default,,0,0,0,,Ол тастап кету керек әлсіз адам.
Dialogue: 0,0:01:25.62,0:01:28.96,Default,,0,0,0,,Идиот! Егер тоқтап қалса, мен өз ойымды айтамын.
Dialogue: 0,0:01:29.46,0:01:30.09,Default,,0,0,0,,Табу...
Dialogue: 0,0:01:33.21,0:01:33.96,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:01:34.46,0:01:37.38,Default,,0,0,0,,Үйір қаншалықты әдемі басқарылғанымен,
Dialogue: 0,0:01:38.18,0:01:41.18,Default,,0,0,0,,Оны тек бір ақымақтың ақымақ ойы ғана түсіреді.
Dialogue: 0,0:01:41.68,0:01:43.89,Default,,0,0,0,,Мен мұндай топтарды көп көрдім.
Dialogue: 0,0:01:44.97,0:01:48.77,Default,,0,0,0,,Мен сендерді өлім құдайлары ондай емес деп ойлағым келді.
Dialogue: 0,0:01:49.35,0:01:50.23,Default,,0,0,0,,ал екіншісі – «бар күшіңді салу»!
Dialogue: 0,0:01:51.19,0:01:51.94,Default,,0,0,0,,Рума…
Dialogue: 0,0:01:52.90,0:01:54.15,Default,,0,0,0,,мырза…
Dialogue: 0,0:01:54.23,0:01:55.15,Default,,0,0,0,,Не?
Dialogue: 0,0:01:55.24,0:01:56.03,Default,,0,0,0,,Ол ұзақ фильм сияқты көрінді, сондықтан мен оны көруге үлгермедім.
Dialogue: 0,0:01:56.11,0:01:57.03,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,0:01:57.11,0:01:58.95,Default,,0,0,0,,Ронда!
Dialogue: 0,0:02:03.12,0:02:06.54,Default,,0,0,0,,Мен одан жақсы құтылдым. Бұл шынымен жылдам.
Dialogue: 0,0:02:07.08,0:02:08.04,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:02:08.12,0:02:10.08,Default,,0,0,0,,Мен қаруды алдым.
Dialogue: 0,0:02:10.58,0:02:12.29,Default,,0,0,0,,Келесі - өмір.
Dialogue: 0,0:02:15.51,0:02:17.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:42.93,0:03:44.93,Default,,0,0,0,,～♪
Dialogue: 0,0:03:47.51,0:03:49.18,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:49.27,0:03:52.81,Default,,0,0,0,,Сол қашықтықтан осы жерге дейін мен байқамай
Dialogue: 0,0:03:52.89,0:03:55.44,Default,,0,0,0,,Сіз бір сәтте қалай айналдырдыңыз?
Dialogue: 0,0:03:55.94,0:03:59.73,Default,,0,0,0,,Иә? Мүмкін сіз мұны ешқашан жасамаған шығарсыз?
Dialogue: 0,0:03:59.82,0:04:01.57,Default,,0,0,0,,Дарума-сан құлап қалды
Dialogue: 0,0:04:02.40,0:04:04.11,Default,,0,0,0,,Сіздің құлауыңызға не себеп болды?
Dialogue: 0,0:04:04.20,0:04:06.70,Default,,0,0,0,,А, менің ойымша, ол жоқ.
Dialogue: 0,0:04:07.20,0:04:10.87,Default,,0,0,0,,Жарайды, Аннигилаторлардың мәдениеті біздікінен бөлек сияқты.
Dialogue: 0,0:04:11.54,0:04:12.91,Default,,0,0,0,,Бұдан басқа
Dialogue: 0,0:04:13.00,0:04:16.33,Default,,0,0,0,,Сіз жасаған ісіңізге ілесе алу үшін қабілеттеріңізді арттырдыңыз.
Dialogue: 0,0:04:16.42,0:04:17.92,Default,,0,0,0,,Нанао-чан
Dialogue: 0,0:04:18.42,0:04:20.84,Default,,0,0,0,,Маған көп мақтаулар естілмейді.
Dialogue: 0,0:04:21.34,0:04:24.84,Default,,0,0,0,,Бұл жолы қауіпті, сондықтан бәріне барыңыз.
Dialogue: 0,0:04:24.93,0:04:26.09,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:04:26.18,0:04:29.56,Default,,0,0,0,,Жарайды, барлығына бірінші барсын деп айт.
Dialogue: 0,0:04:30.06,0:04:32.64,Default,,0,0,0,,Түсіндім, айтамын да қайтайын.
Dialogue: 0,0:04:33.89,0:04:34.60,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:04:35.73,0:04:39.27,Default,,0,0,0,,Мен қайтып келгенше өлсең, өліктің кеуде шашын қырамын.
Dialogue: 0,0:04:39.98,0:04:42.24,Default,,0,0,0,,Бұлай етпеңіз, сіз белгісіз болып қаласыз.
Dialogue: 0,0:04:44.86,0:04:45.70,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:04:45.78,0:04:49.41,Default,,0,0,0,,Сіздің айтқан сөздеріңіз Лиза-чанға ұқсай бастады.
Dialogue: 0,0:04:49.49,0:04:51.08,Default,,0,0,0,,Фарс аяқталды ма?
Dialogue: 0,0:04:51.16,0:04:53.08,Default,,0,0,0,,Бұл қорқынышты естіледі.
Dialogue: 0,0:04:53.16,0:04:58.17,Default,,0,0,0,,Міне, осы уақытқа дейінгі барлық шайқастарыңыз туралы ақпарат.
Dialogue: 0,0:04:58.25,0:05:00.34,Default,,0,0,0,,Сіздің Занпакуто қабілеттеріңіз қандай?
Dialogue: 0,0:05:00.42,0:05:03.59,Default,,0,0,0,,Бала ойынын шындыққа айналдыру
Dialogue: 0,0:05:04.42,0:05:06.84,Default,,0,0,0,,Бұл да «ойын» ма?
Dialogue: 0,0:05:06.93,0:05:07.72,Default,,0,0,0,,Иә
Dialogue: 0,0:05:07.80,0:05:10.01,Default,,0,0,0,,«Дарума-сан құлады»
Dialogue: 0,0:05:10.10,0:05:13.43,Default,,0,0,0,,Жынның көзін байлап, айқайлап бұрылады
Dialogue: 0,0:05:13.52,0:05:16.23,Default,,0,0,0,,Қозғалысқан адамды ұстайтын ойын.
Dialogue: 0,0:05:16.31,0:05:18.40,Default,,0,0,0,,Үш ереже бар.
Dialogue: 0,0:05:19.31,0:05:20.27,Default,,0,0,0,,Не дегенің? Маған түсіндірші!
Dialogue: 0,0:05:21.11,0:05:25.24,Default,,0,0,0,,Жын қатысушыларға көрінетін жерде болуы керек.
Dialogue: 0,0:05:26.28,0:05:27.11,Default,,0,0,0,,(Сувенир дүкенінің иесі) Онда бонус ретінде тегін гидпен экскурсия жасап берейін.
Dialogue: 0,0:05:27.99,0:05:32.49,Default,,0,0,0,,Қатысушылар жын олардың қозғалып жатқанын көрсе, жеңіледі.
Dialogue: 0,0:05:32.58,0:05:33.87,Default,,0,0,0,,Акихабарадан кет, түсіндің бе?!
Dialogue: 0,0:05:34.37,0:05:39.63,Default,,0,0,0,,Қатысушы жын оны көрмей тұрып, оған тиіссе, ол жеңеді.
Dialogue: 0,0:05:39.71,0:05:42.63,Default,,0,0,0,,көремін. Шоколад англ.
Dialogue: 0,0:05:42.71,0:05:45.55,Default,,0,0,0,,Маған ұқсас нәрсе бар ма?
Dialogue: 0,0:05:45.63,0:05:47.34,Default,,0,0,0,,Түсініктеменің жоғалуы
Dialogue: 0,0:05:47.43,0:05:49.84,Default,,0,0,0,,Сіз бұл ойынды ойнай бастағанда
Dialogue: 0,0:05:49.93,0:05:54.60,Default,,0,0,0,,Сіз әрқашан жынның реятсу шабуылдарын көре аласыз.
Dialogue: 0,0:05:55.22,0:05:58.35,Default,,0,0,0,,Жын сені көрмей тұрып, тиіс.
Dialogue: 0,0:05:58.44,0:06:02.86,Default,,0,0,0,,Сіз жын реятсу траекториясы бойынша ең қысқа қашықтықты жүре аласыз.
Dialogue: 0,0:06:03.69,0:06:07.24,Default,,0,0,0,,Осы уақытта жынның қимылсыз фигураның галлюцинациясы бар.
Dialogue: 0,0:06:07.32,0:06:08.99,Default,,0,0,0,,Міне, солай шығар.
Dialogue: 0,0:06:09.07,0:06:10.24,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:10.32,0:06:13.99,Default,,0,0,0,,Бұл сізге өте ыңғайлы ереже сияқты.
Dialogue: 0,0:06:14.08,0:06:17.12,Default,,0,0,0,,Егер біреу сіздің қозғалып жатқаныңызды көрсе, сіз жоғалғансыз.
Dialogue: 0,0:06:17.21,0:06:21.38,Default,,0,0,0,,Галлюцинацияны түсініп, сені тауып алсам ғой
Dialogue: 0,0:06:21.46,0:06:23.38,Default,,0,0,0,,Сен өлесің
Dialogue: 0,0:06:23.96,0:06:28.05,Default,,0,0,0,,Күтілгендей, сіз тез түсінесіз және пайдалы боласыз.
Dialogue: 0,0:06:28.13,0:06:29.72,Default,,0,0,0,,«Сақталған»?
Dialogue: 0,0:06:29.80,0:06:32.43,Default,,0,0,0,,Маған ережені үйреткенім қате болса керек.
Dialogue: 0,0:06:32.51,0:06:34.68,Default,,0,0,0,,Бұл ойынды енді пайдалану мүмкін емес.
Dialogue: 0,0:06:34.76,0:06:36.52,Default,,0,0,0,,Олай емес
Dialogue: 0,0:06:36.60,0:06:40.39,Default,,0,0,0,,Барлығы ережелерді білгеннен кейін, ойын уақыты келді, солай ма?
Dialogue: 0,0:06:41.56,0:06:42.65,Default,,0,0,0,,О, және...
Dialogue: 0,0:06:42.73,0:06:46.65,Default,,0,0,0,,Менің тұрған жерімді дәл қазір көрген фигура
Dialogue: 0,0:06:46.73,0:06:47.78,Default,,0,0,0,,Галлюцинация емес
Dialogue: 0,0:06:47.86,0:06:50.61,Default,,0,0,0,,Шындығында сен маған қарап тұрсың
Dialogue: 0,0:06:50.70,0:06:51.53,Default,,0,0,0,,(Баяндаушы) Цезарь не болып жатқанын мүлде түсінбеді.
Dialogue: 0,0:06:51.61,0:06:53.41,Default,,0,0,0,,Біз бейсаналық
Dialogue: 0,0:06:53.49,0:06:57.91,Default,,0,0,0,,Көру мен рухани сезімдерді бір уақытта қолдана отырып заттарды көру
Dialogue: 0,0:06:58.50,0:07:00.75,Default,,0,0,0,,Мен шайқасқа назар аударған кезде
Dialogue: 0,0:07:00.83,0:07:04.54,Default,,0,0,0,,Сіз басқаларды көзіңізбен емес, рухани сезімдеріңізбен көре бастайсыз.
Dialogue: 0,0:07:04.63,0:07:08.51,Default,,0,0,0,,Мұнда Рейатсудың өзі мен үшін қателеседі.
Dialogue: 0,0:07:08.59,0:07:11.93,Default,,0,0,0,,Мен оны қатты орап, сонда қалдырдым.
Dialogue: 0,0:07:12.01,0:07:15.18,Default,,0,0,0,,Бұл ақымақтық. Сіз мұндай нәрсені дұрыс түсінбеуіңіз мүмкін емес ...
Dialogue: 0,0:07:15.26,0:07:16.89,Default,,0,0,0,,- (Шунсуи) Сіз қателесесіз. - А?
Dialogue: 0,0:07:17.56,0:07:19.52,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:07:20.52,0:07:25.27,Default,,0,0,0,,Бұл Шунсуй Кьёраку, Готей 13 қолбасшысы.
Dialogue: 0,0:07:27.11,0:07:31.07,Default,,0,0,0,,«Алға». Бұл бас қолбасшының хабарламасы.
Dialogue: 0,0:07:31.15,0:07:33.57,Default,,0,0,0,,Жарайсыңдар! Хона, мені жалғыз қалдыр да кет.
Dialogue: 0,0:07:33.66,0:07:34.70,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:07:34.78,0:07:37.08,Default,,0,0,0,,Біз бәріміз капитан Киоракуға көмектесу үшін келдік...
Dialogue: 0,0:07:37.16,0:07:37.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:37.74,0:07:41.00,Default,,0,0,0,,Капитан! Сіз көмектеспейтініңізге сенімдісіз бе?
Dialogue: 0,0:07:41.08,0:07:43.62,Default,,0,0,0,,Бұл уақытқа байланысты жағдай.
Dialogue: 0,0:07:43.71,0:07:45.96,Default,,0,0,0,,Ал... бұл рас.
Dialogue: 0,0:07:46.46,0:07:47.50,Default,,0,0,0,,Мен сені тыңдаймын
Dialogue: 0,0:07:47.59,0:07:49.51,Default,,0,0,0,,Қалай ойлайсың, Нанао-чан?
Dialogue: 0,0:07:50.13,0:07:53.01,Default,,0,0,0,,Мен қайтып барамын, бәрің алға.
Dialogue: 0,0:07:53.09,0:07:56.30,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:07:57.14,0:07:59.77,Default,,0,0,0,,Үкітаке осында болса не айтар еді деп ойлайсың?
Dialogue: 0,0:08:02.14,0:08:04.27,Default,,0,0,0,,Егер Кёраку солай айтса, жарайды.
Dialogue: 0,0:08:04.77,0:08:06.15,Default,,0,0,0,,Оны сізге қалдырайық
Dialogue: 0,0:08:06.73,0:08:08.40,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:08:08.98,0:08:10.44,Default,,0,0,0,,Түсінсең, барамын.
Dialogue: 0,0:08:12.24,0:08:15.99,Default,,0,0,0,,Аа, бұл дұрыс. Тағы бір нәрсе.
Dialogue: 0,0:08:16.57,0:08:19.29,Default,,0,0,0,,Жалғыз қалғаны Генрюсай қарт болса да.
Dialogue: 0,0:08:19.37,0:08:22.00,Default,,0,0,0,,Ақыр соңында, сен алға деуің керек еді.
Dialogue: 0,0:08:25.21,0:08:27.59,Default,,0,0,0,,Мен сарбаздарымның өмірін қатерге тігуге дайынмын...
Dialogue: 0,0:08:28.67,0:08:31.01,Default,,0,0,0,,Капитанның жұмысы
Dialogue: 0,0:08:34.47,0:08:38.35,Default,,0,0,0,,Дарума-сан...
Dialogue: 0,0:08:39.97,0:08:40.85,Default,,0,0,0,,Міне осылай.
Dialogue: 0,0:08:40.93,0:08:44.23,Default,,0,0,0,,Мен саған айттым, сен енді бұл ойынды пайдалана алмайсың.
Dialogue: 0,0:08:44.31,0:08:45.10,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:49.69,0:08:50.40,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:51.65,0:08:53.19,Default,,0,0,0,,Оны оқымаңыз
Dialogue: 0,0:08:53.28,0:08:56.53,Default,,0,0,0,,Мен бірінші рет көлеңкелі жын-шайтаннан бірінші оқпен айналып өтуім.
Dialogue: 0,0:08:57.32,0:08:58.87,Default,,0,0,0,,Мен де солай айттым.
Dialogue: 0,0:08:58.95,0:09:02.70,Default,,0,0,0,,Мұнда сіз осы уақытқа дейінгі барлық шайқастарыңыз туралы ақпаратты таба аласыз.
Dialogue: 0,0:09:02.79,0:09:04.12,Default,,0,0,0,,Және…
Dialogue: 0,0:09:04.21,0:09:05.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:08.04,0:09:10.92,Default,,0,0,0,,Сізде бұл ақпарат жоқ.
Dialogue: 0,0:09:11.00,0:09:13.17,Default,,0,0,0,,Мен одан жалтардым деп ойладым.
Dialogue: 0,0:09:13.67,0:09:16.38,Default,,0,0,0,,Маған айтпағаныңыз әділетсіздік емес пе?
Dialogue: 0,0:09:17.01,0:09:19.72,Default,,0,0,0,,Мен тіпті әділ төбелескім де келмейді.
Dialogue: 0,0:09:19.80,0:09:22.97,Default,,0,0,0,,Мен саған айтсам әділ болмас деп ойлаймын.
Dialogue: 0,0:09:23.06,0:09:23.98,Default,,0,0,0,,Үйретейік
Dialogue: 0,0:09:25.35,0:09:27.31,Default,,0,0,0,,Жұлдызды крест рыцарлары (Sternritter) «X»
Dialogue: 0,0:09:27.40,0:09:29.94,Default,,0,0,0,,«Экксис» Лидье Баро
Dialogue: 0,0:09:30.44,0:09:32.53,Default,,0,0,0,,Менің күшім бәріне енеді
Dialogue: 0,0:09:32.61,0:09:36.70,Default,,0,0,0,,«Жалтару» ұғымына орын жоқ.
Dialogue: 0,0:09:36.78,0:09:37.57,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:43.20,0:09:44.45,Default,,0,0,0,,Сіз көлеңкені көрдіңіз бе?
Dialogue: 0,0:09:45.75,0:09:49.00,Default,,0,0,0,,Сіз одан қалай құтылдыңыз? Сіз сондай сияқтысыз, бірақ уайымдамаңыз.
Dialogue: 0,0:09:49.50,0:09:51.92,Default,,0,0,0,,Сіз айтқандай, жалтармаңыз.
Dialogue: 0,0:09:52.50,0:09:55.13,Default,,0,0,0,,Сіз жай ғана кейінгі суретті түсірдіңіз.
Dialogue: 0,0:09:55.63,0:09:57.72,Default,,0,0,0,,Ол «көлеңке жіберу» деп аталады.
Dialogue: 0,0:09:57.80,0:10:02.31,Default,,0,0,0,,Бұл сіз көлеңкеге қарқынды қарап, кейінгі кескінді басқа жерде көрсететін ойын.
Dialogue: 0,0:10:03.10,0:10:07.14,Default,,0,0,0,,Егер сіз оған өзіңіз сияқты рухани сезіммен қарасаңыз, кейінгі бейне күшті болып қалады.
Dialogue: 0,0:10:08.14,0:10:10.48,Default,,0,0,0,,Балалар ойынында не қорқынышты?
Dialogue: 0,0:10:10.56,0:10:15.07,Default,,0,0,0,,Ойынның қашан басталатынын білмеймін.
Dialogue: 0,0:10:15.82,0:10:20.66,Default,,0,0,0,,Қанша қызықсыз болсаң да, қолыңды тартып алсаң, бірінші томның соңы.
Dialogue: 0,0:10:21.16,0:10:23.49,Default,,0,0,0,,Өлгенше бірге боламыз
Dialogue: 0,0:10:23.58,0:10:26.25,Default,,0,0,0,,Сен де қолыңды тартып алдың.
Dialogue: 0,0:10:26.33,0:10:29.04,Default,,0,0,0,,Өлгенше ойнайық
Dialogue: 0,0:10:29.79,0:10:31.63,Default,,0,0,0,,Бұл абайсызда.
Dialogue: 0,0:10:31.71,0:10:33.92,Default,,0,0,0,,Сіз оны қылыштың шегінде деп ойладыңыз ба?
Dialogue: 0,0:10:34.00,0:10:35.42,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:10:35.50,0:10:36.67,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:10:36.76,0:10:38.17,Default,,0,0,0,,Сізді кесіп тастады.
Dialogue: 0,0:10:40.93,0:10:43.85,Default,,0,0,0,,Қолымды түгел кесіп тастаймын деп ойладым.
Dialogue: 0,0:10:43.93,0:10:46.06,Default,,0,0,0,,Мен тым алысқа бармаған сияқтымын.
Dialogue: 0,0:10:48.73,0:10:50.02,Default,,0,0,0,,А...
Dialogue: 0,0:10:50.10,0:10:51.65,Default,,0,0,0,,«Диаграмма»
Dialogue: 0,0:10:51.73,0:10:53.86,Default,,0,0,0,,Бұл мылтық менің садағым.
Dialogue: 0,0:10:54.36,0:10:56.53,Default,,0,0,0,,Мен оны рух балаларынан жасаймын.
Dialogue: 0,0:10:56.61,0:10:58.36,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:58.44,0:11:03.03,Default,,0,0,0,,Сондықтан мылтық ұңғы сынса да ұрысуға болады, сынса да қалпына келтіруге болады.
Dialogue: 0,0:11:03.66,0:11:04.41,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:11:04.91,0:11:06.87,Default,,0,0,0,,Сіз ережелерді ұмытып кеткенсіз.
Dialogue: 0,0:11:09.50,0:11:12.04,Default,,0,0,0,,Менен бір сәт болса да көзіңді ал
Dialogue: 0,0:11:12.12,0:11:14.63,Default,,0,0,0,,Көлеңкенің шеті де көзге түссе
Dialogue: 0,0:11:15.34,0:11:19.84,Default,,0,0,0,,Одан кейін көзіңе көрінгеннің бәрі менің көлеңкем.
Dialogue: 0,0:11:20.76,0:11:21.88,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:11:22.68,0:11:26.68,Default,,0,0,0,,Кішкентай кезімде бір көлеңке шебері артымнан еріп жүретін.
Dialogue: 0,0:11:27.60,0:11:30.10,Default,,0,0,0,,Қорыққаным сонша, басқа амалым қалмады
Dialogue: 0,0:11:30.18,0:11:30.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:38.48,0:11:40.70,Default,,0,0,0,,А... кетті.
Dialogue: 0,0:11:41.74,0:11:43.03,Default,,0,0,0,,Үшінші рет
Dialogue: 0,0:11:43.11,0:11:44.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:44.20,0:11:47.24,Default,,0,0,0,,Тек көзім ашық болғанша
Dialogue: 0,0:11:47.33,0:11:50.25,Default,,0,0,0,,Сіз Exaxis мәнін пайдалана аласыз.
Dialogue: 0,0:11:50.75,0:11:51.54,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:11:51.62,0:11:54.67,Default,,0,0,0,,Менің оқтарым денеңді тесіп өтеді.
Dialogue: 0,0:11:55.17,0:11:57.80,Default,,0,0,0,,Менің денем сенің қылышыңды тесіп өтеді
Dialogue: 0,0:11:57.88,0:12:02.88,Default,,0,0,0,,көремін. Екі көзімді ашсам, менің логика мағынасы жоқ.
Dialogue: 0,0:12:03.38,0:12:04.59,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:04.68,0:12:08.26,Default,,0,0,0,,Дәл қазір бұл дүниеде мені өлтіретін қару жоқ.
Dialogue: 0,0:12:08.35,0:12:12.60,Default,,0,0,0,,Ұрыста маған аз ғана сәт қауіп төнді.
Dialogue: 0,0:12:12.69,0:12:15.48,Default,,0,0,0,,Екі көзді ашуға рұқсат етілген
Dialogue: 0,0:12:15.56,0:12:20.36,Default,,0,0,0,,Көзімді ашық ұстасам, күнәһарларға әділетсіздік болар еді.
Dialogue: 0,0:12:20.44,0:12:21.99,Default,,0,0,0,,А, түсіндім.
Dialogue: 0,0:12:22.49,0:12:24.78,Default,,0,0,0,,Ал, неге тез көзіңді жұмбайсың?
Dialogue: 0,0:12:24.86,0:12:29.33,Default,,0,0,0,,Бірақ бір шайқаста көзіңді үш рет ашсаң ғана.
Dialogue: 0,0:12:29.41,0:12:33.25,Default,,0,0,0,,бастап көзді ашық ұстауға рұқсат етіледі.
Dialogue: 0,0:12:33.75,0:12:38.17,Default,,0,0,0,,Мен ұлы мәртебелі билікті алғаш рет берген жоқ етушімін (Квинси).
Dialogue: 0,0:12:38.25,0:12:40.42,Default,,0,0,0,,Мәртебелі туындысы
Dialogue: 0,0:12:40.50,0:12:42.80,Default,,0,0,0,,Құдайға ең жақын адам
Dialogue: 0,0:12:43.42,0:12:46.80,Default,,0,0,0,,Қызметшінің көзі үш рет ашылды.
Dialogue: 0,0:12:48.10,0:12:50.10,Default,,0,0,0,,Өйткені олай болмауы керек!
Dialogue: 0,0:13:05.28,0:13:06.28,Default,,0,0,0,,Құдайдың үкімі
Dialogue: 0,0:13:07.53,0:13:08.87,Default,,0,0,0,,Мен қозғала алмаймын...
Dialogue: 0,0:13:33.35,0:13:34.85,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:13:35.35,0:13:36.31,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:13:36.39,0:13:40.19,Default,,0,0,0,,Мен жақсы жүгіріп жүрсем де, бұл шраммен,
Dialogue: 0,0:13:40.27,0:13:43.78,Default,,0,0,0,,Шынымды айтсам, әп-сәтте өліп қалсам, оңайырақ болар еді.
Dialogue: 0,0:13:44.28,0:13:48.82,Default,,0,0,0,,Егер шын мықты болсаң, өлмек түгілі, есінен танып қалу да мүмкін емес.
Dialogue: 0,0:13:51.58,0:13:53.99,Default,,0,0,0,,Нанао-чан жоқта осылай айтсам да
Dialogue: 0,0:13:54.08,0:13:56.66,Default,,0,0,0,,Маған ешкім цукко бере алмайды ма?
Dialogue: 0,0:13:58.54,0:14:00.04,Default,,0,0,0,,Қауіпті Қауіпті
Dialogue: 0,0:14:02.29,0:14:05.67,Default,,0,0,0,,Мен сол жарамен жиі қашамын.
Dialogue: 0,0:14:06.17,0:14:07.47,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:14:09.05,0:14:09.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:10.51,0:14:12.68,Default,,0,0,0,,Сіз қашып құтыла аламын деп ойлайсыз ба?
Dialogue: 0,0:14:13.85,0:14:15.77,Default,,0,0,0,,Кешігуге уақыт жоқ
Dialogue: 0,0:14:15.85,0:14:18.52,Default,,0,0,0,,Мені өлтіретін қару жоқ десең де.
Dialogue: 0,0:14:19.69,0:14:20.77,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:14:21.86,0:14:24.23,Default,,0,0,0,,Kido's Blade туралы не деуге болады?
Dialogue: 0,0:14:24.32,0:14:27.86,Default,,0,0,0,,Жетпіс сегіз бұзылған жол Заңгер
Dialogue: 0,0:14:27.95,0:14:29.07,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:31.66,0:14:33.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:33.20,0:14:35.83,Default,,0,0,0,,Сондықтан сізге ұнамады.
Dialogue: 0,0:14:35.91,0:14:37.66,Default,,0,0,0,,Ичиго Куросаки
Dialogue: 0,0:14:38.16,0:14:41.63,Default,,0,0,0,,Сіз Рух Патшасының сарайында біраз уақыт болдыңыз, солай емес пе?
Dialogue: 0,0:14:42.13,0:14:43.50,Default,,0,0,0,,Мүмкін сол діни қызметкер
Dialogue: 0,0:14:43.59,0:14:46.67,Default,,0,0,0,,Сізді біртүрлі жаттығуларға немесе техникаға үйрету мүмкін емес пе еді?
Dialogue: 0,0:14:46.76,0:14:48.42,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:14:48.51,0:14:50.80,Default,,0,0,0,,Аа, солай деп ойлаймын.
Dialogue: 0,0:14:50.88,0:14:52.34,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:52.43,0:14:54.68,Default,,0,0,0,,Сіз рухани балаларға тәуелді бола алмайсыз.
Dialogue: 0,0:14:55.68,0:14:56.64,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:56.72,0:15:00.31,Default,,0,0,0,,Мұны білгеннен кейін дәмдеуішті ауыстырыңыз.
Dialogue: 0,0:15:00.39,0:15:02.40,Default,,0,0,0,,Сіз не туралы айтып жатырсыз?
Dialogue: 0,0:15:02.48,0:15:04.90,Default,,0,0,0,,Ештеңеге араласпа.
Dialogue: 0,0:15:05.40,0:15:07.90,Default,,0,0,0,,Сіз бұл өлімге әкелетін деп айтасыз ба?
Dialogue: 0,0:15:09.03,0:15:10.28,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:10.36,0:15:14.49,Default,,0,0,0,,Мен Киду да онша тиімді болмайды деп ойладым.
Dialogue: 0,0:15:14.58,0:15:16.54,Default,,0,0,0,,Зақымданбау деген нені білдіреді?
Dialogue: 0,0:15:16.62,0:15:19.54,Default,,0,0,0,,Бәрі ойдағыдай.
Dialogue: 0,0:15:19.62,0:15:23.38,Default,,0,0,0,,Мен Рух Патша сарайына алғаш келген аймаққа қашып кеттім.
Dialogue: 0,0:15:23.88,0:15:27.92,Default,,0,0,0,,Қызық, бәрі алысқа кетті ме?
Dialogue: 0,0:15:28.59,0:15:30.13,Default,,0,0,0,,Нанао-чан...
Dialogue: 0,0:15:30.22,0:15:32.84,Default,,0,0,0,,Ах... Мен сені осыған сүйреп апарсам кешір.
Dialogue: 0,0:15:36.43,0:15:40.60,Default,,0,0,0,,Сіздің келесі қадамыңыз қандай?
Dialogue: 0,0:15:42.65,0:15:44.02,Default,,0,0,0,,Банкай
Dialogue: 0,0:15:47.40,0:15:48.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:48.65,0:15:49.40,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:08.75,0:16:12.76,Default,,0,0,0,,Ханатенкёкоцу Каремацу Синдзю
Dialogue: 0,0:16:14.05,0:16:15.18,Default,,0,0,0,,Бұл қайталау...
Dialogue: 0,0:16:15.76,0:16:17.93,Default,,0,0,0,,Кёраку-сан...?
Dialogue: 0,0:16:26.06,0:16:28.48,Default,,0,0,0,,Бұл қандай сезім?
Dialogue: 0,0:16:33.32,0:16:35.99,Default,,0,0,0,,Ақыры өзіңнен шықтың ба?
Dialogue: 0,0:16:36.07,0:16:38.66,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:16:38.74,0:16:40.87,Default,,0,0,0,,Айтпақшы, мен сіздің ойыңызды тыңдай аламын ба?
Dialogue: 0,0:16:41.58,0:16:44.50,Default,,0,0,0,,Қазір әлем саған қалай көрінеді?
Dialogue: 0,0:16:46.63,0:16:50.46,Default,,0,0,0,,Сіз қараңғы, жалғыз және үмітсіз көрінесіз бе?
Dialogue: 0,0:16:50.96,0:16:54.34,Default,,0,0,0,,Мен көремін. Бұл сіздің қабілетіңіз бе?
Dialogue: 0,0:16:54.43,0:16:56.30,Default,,0,0,0,,Банкай деп аталады ма?
Dialogue: 0,0:16:56.39,0:16:58.60,Default,,0,0,0,,Ол Банкай деп аталады.
Dialogue: 0,0:16:58.68,0:17:02.60,Default,,0,0,0,,Дүние бұрынғыдан басқа түске боялғаны рас.
Dialogue: 0,0:17:02.68,0:17:05.39,Default,,0,0,0,,Үмітсіз - бұл асыра сілтеу.
Dialogue: 0,0:17:05.48,0:17:06.81,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:17:08.77,0:17:11.57,Default,,0,0,0,,Алланың елшісі үмітін үзбейді
Dialogue: 0,0:17:17.49,0:17:21.66,Default,,0,0,0,,Менде сіздің Банкай қабілеттеріңіз туралы ешқандай ақпарат жоқ.
Dialogue: 0,0:17:21.74,0:17:24.54,Default,,0,0,0,,Бір ақиқат бар
Dialogue: 0,0:17:25.16,0:17:28.79,Default,,0,0,0,,Қылыш иесі өлсе, Банқай жоғалады.
Dialogue: 0,0:17:28.88,0:17:29.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:30.00,0:17:31.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:31.75,0:17:33.67,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:17:34.34,0:17:38.43,Default,,0,0,0,,Бірінші қадам Тербеліс ақауларды бөлу
Dialogue: 0,0:17:39.18,0:17:41.64,Default,,0,0,0,,Басқа адамның денесіндегі жаралар
Dialogue: 0,0:17:41.72,0:17:44.98,Default,,0,0,0,,Бөліскендей, ол да менің денемде пайда болады
Dialogue: 0,0:17:45.89,0:17:46.60,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:46.69,0:17:49.02,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:17:49.10,0:17:52.07,Default,,0,0,0,,Ол жарадан ешқашан өле алмайсың.
Dialogue: 0,0:17:52.15,0:17:55.65,Default,,0,0,0,,Не деп тұрсың, не болып жатыр!
Dialogue: 0,0:17:55.74,0:17:58.91,Default,,0,0,0,,Айттым ғой, Банкай деп.
Dialogue: 0,0:18:00.45,0:18:03.54,Default,,0,0,0,,Ханатенкёкоцу Каремацу Синджу
Dialogue: 0,0:18:03.62,0:18:06.79,Default,,0,0,0,,Әзірге шымылдық арасындағы оқиға
Dialogue: 0,0:18:06.87,0:18:09.12,Default,,0,0,0,,Шымылдықтың ортасында тыныштық
Dialogue: 0,0:18:09.63,0:18:11.92,Default,,0,0,0,,Енді, екінші қатар.
Dialogue: 0,0:18:12.54,0:18:13.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:14.59,0:18:16.47,Default,,0,0,0,,Ұяттың төсегі
Dialogue: 0,0:18:16.55,0:18:19.93,Default,,0,0,0,,Біреуді ренжіткеніне өкінетін адам
Dialogue: 0,0:18:20.01,0:18:25.02,Default,,0,0,0,,Ұяттан төсекке құлап, жазылмас дертке шалдықтым.
Dialogue: 0,0:18:25.10,0:18:26.73,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:18:26.81,0:18:29.81,Default,,0,0,0,,Ареёареё және үшінші қадам
Dialogue: 0,0:18:37.44,0:18:38.99,Default,,0,0,0,,Дану-бучи
Dialogue: 0,0:18:40.20,0:18:42.03,Default,,0,0,0,,Белгілі болғандар
Dialogue: 0,0:18:42.12,0:18:44.79,Default,,0,0,0,,Бір-бірінің реиацулары таусылғанша
Dialogue: 0,0:18:44.87,0:18:47.54,Default,,0,0,0,,Өзіңді аққан суға таста
Dialogue: 0,0:18:49.12,0:18:49.87,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:54.42,0:18:57.30,Default,,0,0,0,,Бұл... ақымақ.
Dialogue: 0,0:18:58.34,0:19:02.34,Default,,0,0,0,,Қанша қанаттым, су беті тартыла береді
Dialogue: 0,0:19:02.43,0:19:06.31,Default,,0,0,0,,Бұл анық емес, біз өзімізді бердік.
Dialogue: 0,0:19:06.81,0:19:09.69,Default,,0,0,0,,Қанша қақасаң да, одан кейінгі мереке.
Dialogue: 0,0:19:10.73,0:19:13.69,Default,,0,0,0,,Бірақ, мен сенің сезіміңді түсінбеймін.
Dialogue: 0,0:19:14.27,0:19:16.65,Default,,0,0,0,,Өзіңізді суық суға тастаңыз
Dialogue: 0,0:19:16.73,0:19:19.32,Default,,0,0,0,,Кейде менің шешімім қатып қалады
Dialogue: 0,0:19:19.40,0:19:21.95,Default,,0,0,0,,Бірақ бұл сіздің өзімшілдігіңіз.
Dialogue: 0,0:19:22.03,0:19:24.28,Default,,0,0,0,,Оның шектен шығуының да шегі бар.
Dialogue: 0,0:19:24.78,0:19:27.37,Default,,0,0,0,,Ант берген адамның жауыздығы
Dialogue: 0,0:19:27.45,0:19:30.21,Default,,0,0,0,,Оны тастап өлмеу – әйелдің құмарлығы.
Dialogue: 0,0:19:31.71,0:19:32.92,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:19:33.75,0:19:35.21,Default,,0,0,0,,Созоса
Dialogue: 0,0:19:36.21,0:19:38.51,Default,,0,0,0,,Біраз болды, гүлдер.
Dialogue: 0,0:19:39.63,0:19:42.55,Default,,0,0,0,,«Гүлдер»? Бұл өте таныс
Dialogue: 0,0:19:43.05,0:19:47.76,Default,,0,0,0,,Менімен ғана ойнайтын шебер мені анда-санда қалай атайды екен.
Dialogue: 0,0:19:47.85,0:19:49.89,Default,,0,0,0,,Жарайды, олай айтпа.
Dialogue: 0,0:19:49.98,0:19:51.81,Default,,0,0,0,,Кешіріңіз, гүлдер
Dialogue: 0,0:19:53.06,0:19:56.11,Default,,0,0,0,,Мұқият қарасаңыз, кимоноңыз жыртылып қалыпты.
Dialogue: 0,0:19:56.73,0:20:00.99,Default,,0,0,0,,Сіз үнемі басқа әйелдердің кимоносын киіп жүргендіктен солай болады.
Dialogue: 0,0:20:01.07,0:20:02.20,Default,,0,0,0,,Ешқандай қиындық жоқ.
Dialogue: 0,0:20:02.99,0:20:05.16,Default,,0,0,0,,Сіз әдеттегідей дөрекісіз.
Dialogue: 0,0:20:05.24,0:20:08.29,Default,,0,0,0,,Жаратқанның қылышы, қанша арам болса да.
Dialogue: 0,0:20:08.37,0:20:10.54,Default,,0,0,0,,Өзіңізге ұнайтын және ұнатпайтын нәрселерді жұтып қойыңыз
Dialogue: 0,0:20:10.62,0:20:13.62,Default,,0,0,0,,Екеуміз ажырасуға ант еткен дос болдық.
Dialogue: 0,0:20:14.71,0:20:16.17,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:20:18.25,0:20:21.17,Default,,0,0,0,,Шайқас аяқталды деп ойлайсың ба?
Dialogue: 0,0:20:21.26,0:20:23.30,Default,,0,0,0,,Сіз мені өлтіре аласыз ба?
Dialogue: 0,0:20:25.26,0:20:29.72,Default,,0,0,0,,Сіз мені Шинигамидің Банкай сияқты нәрсемен өлтіре аламын деп ойлайсыз!
Dialogue: 0,0:20:31.56,0:20:34.27,Default,,0,0,0,,Әйелдің сезімі сондай қатыгез
Dialogue: 0,0:20:34.35,0:20:37.11,Default,,0,0,0,,Жылы адамға қарызға құлақ жоқ
Dialogue: 0,0:20:37.69,0:20:40.15,Default,,0,0,0,,Тамағымның түбінде жарқырап тұрған нәрсе
Dialogue: 0,0:20:40.65,0:20:43.49,Default,,0,0,0,,Өкініштен суланған ақ жіп
Dialogue: 0,0:20:44.36,0:20:46.91,Default,,0,0,0,,Ең болмаса қолыммен кесіп тастайын.
Dialogue: 0,0:20:47.41,0:20:50.08,Default,,0,0,0,,Шешілмеген жіптер қасіретпен шиеленіскен
Dialogue: 0,0:20:50.91,0:20:53.96,Default,,0,0,0,,Бұл соңғы кезең.
Dialogue: 0,0:21:00.13,0:21:03.80,Default,,0,0,0,,Жіп кесетін қайшы Қанға боялған тамақ
Dialogue: 0,0:21:09.18,0:21:10.18,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:29.20,0:21:30.37,Default,,0,0,0,,О...
Dialogue: 0,0:21:30.99,0:21:36.00,Default,,0,0,0,,Гүл тізгін жастықта тыныға алу үшін, Таманың Банкайы да жаман емес.
Dialogue: 0,0:21:37.04,0:21:38.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:38.21,0:21:40.04,Default,,0,0,0,,Маған үзіліс беріңіз.
Dialogue: 0,0:21:40.13,0:21:42.34,Default,,0,0,0,,Бұл мен енді көре алатын жалғыз нәрсе
Dialogue: 0,0:21:42.92,0:21:45.09,Default,,0,0,0,,Менімен бірге болу деген нені білдіреді?
Dialogue: 0,0:21:45.59,0:21:48.34,Default,,0,0,0,,Қылыш пен өлім құдайы екі бөлек нәрсе.
Dialogue: 0,0:21:48.43,0:21:49.51,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:50.18,0:21:53.56,Default,,0,0,0,,Қандай жағдай болмасын, жеңіс бәрінен де маңызды.
Dialogue: 0,0:21:53.64,0:21:57.06,Default,,0,0,0,,Уа, не болды? Мен бүгін шыншыл емеспін.
Dialogue: 0,0:21:57.14,0:21:59.10,Default,,0,0,0,,Жартылай өлген адам үндемейді.
Dialogue: 0,0:22:00.98,0:22:02.11,Default,,0,0,0,,Гүлдер
Dialogue: 0,0:22:03.19,0:22:04.11,Default,,0,0,0,,Мен...
Dialogue: 0,0:22:06.45,0:22:08.45,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.70,0:23:33.70,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.66,0:23:38.37,Default,,0,0,0,,Менің қолдарым сүйкімді
Dialogue: 0,0:23:38.45,0:23:39.96,Default,,0,0,0,,Қаңғыбас қолдар
Dialogue: 0,0:23:40.46,0:23:43.63,Default,,0,0,0,,Мені іздеп, алыстап бара жатыр
Dialogue: 0,0:23:44.38,0:23:46.96,Default,,0,0,0,,Біз жиналсақ, кетеміз, қолымды ал
Dialogue: 0,0:23:47.46,0:23:50.47,Default,,0,0,0,,Тартылып, басайық, Тарихтың ақыры
Dialogue: 0,0:23:51.97,0:23:57.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
