Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.50,Default,,0,0,0,,♪～
Dialogue: 0,0:01:28.50,0:01:30.50,Default,,0,0,0,,～♪
Dialogue: 0,0:01:36.09,0:01:38.93,Default,,0,0,0,,Мен сізге Zero Squad қаншалықты маңызды екенін көрсетемін.
Dialogue: 0,0:01:43.26,0:01:44.56,Default,,0,0,0,,Суицид?
Dialogue: 0,0:01:56.07,0:01:56.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:59.82,0:02:04.45,Default,,0,0,0,,Төрт адам да шыдай алмаса, бір адаммен не істей аламыз?
Dialogue: 0,0:02:04.54,0:02:07.50,Default,,0,0,0,,Қабілетіміз – жеңгеңді бұлғау ғана.
Dialogue: 0,0:02:07.58,0:02:10.50,Default,,0,0,0,,Аспан мен жердің үш әлемін тербету
Dialogue: 0,0:02:10.58,0:02:14.30,Default,,0,0,0,,Сондықтан біз өмірімізді біріктіреміз
Dialogue: 0,0:02:14.38,0:02:17.05,Default,,0,0,0,,Нағыз қылыш мөрмен жабылды
Dialogue: 0,0:02:18.05,0:02:21.89,Default,,0,0,0,,Ал енді үш өмірдің орнына
Dialogue: 0,0:02:21.97,0:02:25.35,Default,,0,0,0,,Қан антының мөрі бұзылды.
Dialogue: 0,0:02:26.68,0:02:28.43,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:02:30.60,0:02:31.98,Default,,0,0,0,,Банкай
Dialogue: 0,0:03:02.39,0:03:05.68,Default,,0,0,0,,Цудзи Цудзи
Dialogue: 0,0:03:06.18,0:03:07.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:08.14,0:03:10.14,Default,,0,0,0,,Бұл реиацу Сенжумару ма?
Dialogue: 0,0:03:10.23,0:03:11.56,Default,,0,0,0,,Банкай шығар
Dialogue: 0,0:03:11.64,0:03:13.44,Default,,0,0,0,,Ба... Банкай?
Dialogue: 0,0:03:13.52,0:03:14.61,Default,,0,0,0,,Мұндай қайталану...
Dialogue: 0,0:03:14.69,0:03:17.65,Default,,0,0,0,,Капитандардың Банкайынан да, мен оны сезбеймін.
Dialogue: 0,0:03:17.73,0:03:21.49,Default,,0,0,0,,Куросаки-кун, нөлдік отрядтың адамдары...
Dialogue: 0,0:03:21.57,0:03:25.28,Default,,0,0,0,,Аа, Иноуэ және басқалары ешқашан кездеспеген.
Dialogue: 0,0:03:26.20,0:03:30.29,Default,,0,0,0,,Занпакуто, бұл киім және жаңа күш.
Dialogue: 0,0:03:30.79,0:03:33.04,Default,,0,0,0,,Мен Zero Squad-дан үйренгенімнің бәрі
Dialogue: 0,0:03:33.71,0:03:36.54,Default,,0,0,0,,Олар бәрібір стандартсыз адамдар.
Dialogue: 0,0:03:36.63,0:03:41.13,Default,,0,0,0,,Егер сіз сондай ғажайып адамдар болсаңыз, сіз Квинси адамдарынан ұтыла алмайсыз.
Dialogue: 0,0:03:41.22,0:03:42.30,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:03:42.38,0:03:44.80,Default,,0,0,0,,Юхабахты және басқаларды жеңе берсең.
Dialogue: 0,0:03:44.89,0:03:46.68,Default,,0,0,0,,Құттықтаймыз! Құттықтаймыз!
Dialogue: 0,0:03:47.26,0:03:48.39,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:51.77,0:03:54.02,Default,,0,0,0,,Тонна Тонна
Dialogue: 0,0:03:54.52,0:03:57.19,Default,,0,0,0,,бастап
Dialogue: 0,0:03:57.98,0:03:58.69,Default,,0,0,0,,Тонна
Dialogue: 0,0:03:59.40,0:04:00.69,Default,,0,0,0,,бастап
Dialogue: 0,0:04:01.19,0:04:01.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:04.78,0:04:08.58,Default,,0,0,0,,...
Dialogue: 0,0:04:09.45,0:04:10.33,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:11.66,0:04:15.63,Default,,0,0,0,,Артқа қадала қарасаң, көзің шалады
Dialogue: 0,0:04:17.29,0:04:19.42,Default,,0,0,0,,Екі жақты шешім...
Dialogue: 0,0:04:19.50,0:04:22.84,Default,,0,0,0,,Әй, бұл не...
Dialogue: 0,0:04:22.92,0:04:25.13,Default,,0,0,0,,Пышақты сауыт
Dialogue: 0,0:04:26.30,0:04:27.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:30.77,0:04:31.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:31.39,0:04:36.19,Default,,0,0,0,,Тұратын ештеңе жоқ
Dialogue: 0,0:04:37.94,0:04:39.73,Default,,0,0,0,,Санрей Каба
Dialogue: 0,0:04:40.94,0:04:42.65,Default,,0,0,0,,Қара құмды ішек
Dialogue: 0,0:04:45.95,0:04:47.74,Default,,0,0,0,,Манипуляция жасайтын қол
Dialogue: 0,0:04:51.83,0:04:53.71,Default,,0,0,0,,өлімге әкелетін
Dialogue: 0,0:04:56.83,0:04:58.88,Default,,0,0,0,,Ширейкаба…
Dialogue: 0,0:04:58.96,0:05:01.67,Default,,0,0,0,,Хмм... бұл қызықсыз қулық.
Dialogue: 0,0:05:01.75,0:05:02.63,Default,,0,0,0,,Татакзан...
Dialogue: 0,0:05:03.84,0:05:04.63,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:04.72,0:05:07.05,Default,,0,0,0,,Мұздатылған төсек жабындары
Dialogue: 0,0:05:08.59,0:05:09.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:10.05,0:05:12.02,Default,,0,0,0,,Егер сіз бұзсаңыз, енді ешқашан болмайды.
Dialogue: 0,0:05:12.64,0:05:14.52,Default,,0,0,0,,Оянбайтын жер
Dialogue: 0,0:05:16.89,0:05:20.57,Default,,0,0,0,,Горейкаба өртенген алқап
Dialogue: 0,0:05:31.78,0:05:33.79,Default,,0,0,0,,Күл болғанша
Dialogue: 0,0:05:36.08,0:05:38.46,Default,,0,0,0,,Шығу жолы жоқ
Dialogue: 0,0:05:41.59,0:05:43.71,Default,,0,0,0,,Рокурейкаба
Dialogue: 0,0:05:43.80,0:05:45.80,Default,,0,0,0,,Қараңғы түннің жұлдызы
Dialogue: 0,0:05:52.31,0:05:54.18,Default,,0,0,0,,Ұстап алсаң, бітті
Dialogue: 0,0:06:01.36,0:06:03.19,Default,,0,0,0,,Өлім жұлдызы
Dialogue: 0,0:06:05.07,0:06:07.86,Default,,0,0,0,,Жаман балалар, маған тез қараңдар.
Dialogue: 0,0:06:08.99,0:06:11.66,Default,,0,0,0,,Хиомандан, реттеңіз
Dialogue: 0,0:06:12.16,0:06:14.20,Default,,0,0,0,,Бұл машинаны босатыңыз
Dialogue: 0,0:06:15.54,0:06:19.00,Default,,0,0,0,,Шиде Рокушоку Укибунки
Dialogue: 0,0:06:33.10,0:06:36.14,Default,,0,0,0,,Менің күшім «қара»
Dialogue: 0,0:06:37.27,0:06:40.14,Default,,0,0,0,,Бір әріпті шығарғаннан кейін
Dialogue: 0,0:06:40.23,0:06:42.52,Default,,0,0,0,,Грим Реапер де, Квинси де
Dialogue: 0,0:06:42.61,0:06:45.40,Default,,0,0,0,,Тірі немесе өліге қарамастан.
Dialogue: 0,0:06:45.98,0:06:48.53,Default,,0,0,0,,Бұл дүниедегі барлық қаралық...
Dialogue: 0,0:06:51.07,0:06:52.99,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:06:58.62,0:07:00.54,Default,,0,0,0,,Юхабах
Dialogue: 0,0:07:00.62,0:07:04.50,Default,,0,0,0,,Жоқ... Мен Юхабах едім.
Dialogue: 0,0:07:04.59,0:07:07.26,Default,,0,0,0,,Атын жоғалтудың өзі азап болса керек.
Dialogue: 0,0:07:07.76,0:07:10.05,Default,,0,0,0,,Кедейге мен...
Dialogue: 0,0:07:11.43,0:07:13.43,Default,,0,0,0,,Оған атау беріңіз
Dialogue: 0,0:07:14.30,0:07:17.93,Default,,0,0,0,,Шинучи Шира қылқалам бір кейіпкер
Dialogue: 0,0:07:18.68,0:07:23.56,Default,,0,0,0,,Қазіргі тілмен айтсақ, «Банқай» деп аталар еді.
Dialogue: 0,0:07:23.65,0:07:28.19,Default,,0,0,0,,Өйткені, бұл дүниеде Банкай болғанға дейін көп уақыт болды.
Dialogue: 0,0:07:28.28,0:07:32.16,Default,,0,0,0,,Бірінші дамыған Занпакуто
Dialogue: 0,0:07:32.74,0:07:36.33,Default,,0,0,0,,Бұл қылыш бір таңбамен толтырылған.
Dialogue: 0,0:07:36.41,0:07:39.95,Default,,0,0,0,,Жаңа есімді ойып жаза алады
Dialogue: 0,0:07:41.71,0:07:44.33,Default,,0,0,0,,Ал, көңіл күйлерің қалай?
Dialogue: 0,0:07:44.42,0:07:47.92,Default,,0,0,0,,Бір кездері Юхабах болған қара құмырсқа.
Dialogue: 0,0:07:48.00,0:07:53.13,Default,,0,0,0,,Менің күшім енді жерде жорғалаған қара құмырсқамен бірдей.
Dialogue: 0,0:07:53.22,0:07:56.30,Default,,0,0,0,,Нәзік, өткінші өмірге айналды.
Dialogue: 0,0:07:57.47,0:08:00.43,Default,,0,0,0,,Бұл... әзірге...
Dialogue: 0,0:08:00.52,0:08:03.48,Default,,0,0,0,,Иә, «әзірге»
Dialogue: 0,0:08:03.56,0:08:06.31,Default,,0,0,0,,Билікте үлкен айырмашылық болды.
Dialogue: 0,0:08:06.40,0:08:10.07,Default,,0,0,0,,Сонымен Оншидің тағдыры аяқталды.
Dialogue: 0,0:08:10.15,0:08:14.20,Default,,0,0,0,,Мен өлтірген Шинигамидің өмірімен танысу
Dialogue: 0,0:08:14.78,0:08:18.53,Default,,0,0,0,,Қара құмырсқадай езіліп өл!
Dialogue: 0,0:08:22.41,0:08:24.87,Default,,0,0,0,,Жәндіктер патшасы
Dialogue: 0,0:08:26.42,0:08:28.04,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:08:52.24,0:08:53.95,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:08:54.45,0:08:59.53,Default,,0,0,0,,Көзімді жұмған кезде соншалықты көп көретініме сене алар емеспін.
Dialogue: 0,0:09:07.00,0:09:07.54,Default,,0,0,0,,Ааах…
Dialogue: 0,0:09:07.63,0:09:08.13,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:09.84,0:09:13.55,Default,,0,0,0,,Онши... неге ол әлі өлген жоқ?
Dialogue: 0,0:09:14.17,0:09:16.59,Default,,0,0,0,,Ақымақ... әріптер...
Dialogue: 0,0:09:17.47,0:09:19.68,Default,,0,0,0,,Квинсидің мөрленген королі
Dialogue: 0,0:09:20.18,0:09:23.10,Default,,0,0,0,,900 жылдан кейін жүрек қайта соғады
Dialogue: 0,0:09:23.68,0:09:26.35,Default,,0,0,0,,90 жылдан кейін ес жидым.
Dialogue: 0,0:09:26.85,0:09:29.36,Default,,0,0,0,,9 жылдан кейін мен күш жинаймын.
Dialogue: 0,0:09:30.06,0:09:33.57,Default,,0,0,0,,Ұлы мәртебелі бейбіт уақытта көзін жұмып шайқасты.
Dialogue: 0,0:09:34.61,0:09:37.49,Default,,0,0,0,,Бұл жауды менсінбеу үшін жасалған жоқ.
Dialogue: 0,0:09:38.24,0:09:41.70,Default,,0,0,0,,Тоғыз жыл билік бітпей көзін ашсаң
Dialogue: 0,0:09:41.78,0:09:44.37,Default,,0,0,0,,Мәртебелі билігі бақылаудан шықты
Dialogue: 0,0:09:44.87,0:09:48.17,Default,,0,0,0,,Бірақ ұлы мәртебелі қазір көзін ашты.
Dialogue: 0,0:09:48.25,0:09:50.00,Default,,0,0,0,,Биліктің тоғыз жылы аяқталды.
Dialogue: 0,0:09:50.08,0:09:50.59,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,0:09:53.21,0:09:56.34,Default,,0,0,0,,Мәртебелі өзінің шынайы билігін қалпына келтірді.
Dialogue: 0,0:09:57.01,0:10:00.39,Default,,0,0,0,,Ұлы мәртебелілердің көзі болатынның бәрін көреді
Dialogue: 0,0:10:00.47,0:10:02.10,Default,,0,0,0,,Білуге болады
Dialogue: 0,0:10:02.89,0:10:03.51,Default,,0,0,0,,Және…
Dialogue: 0,0:10:05.14,0:10:09.48,Default,,0,0,0,,Сіз Ұлы Мәртебені оның танымал күшімен жеңе алмайсыз.
Dialogue: 0,0:10:10.06,0:10:11.52,Default,,0,0,0,,Қасиетті әріп «А»
Dialogue: 0,0:10:12.02,0:10:15.57,Default,,0,0,0,,Квинси патшасына лайық биліктің аты...
Dialogue: 0,0:10:17.45,0:10:19.74,Default,,0,0,0,,«Құдіретті Құдай»
Dialogue: 0,0:10:27.33,0:10:28.29,Default,,0,0,0,,Хо
Dialogue: 0,0:10:28.37,0:10:31.88,Default,,0,0,0,,Патшаның оянуымен билікке жеттіңіз бе?
Dialogue: 0,0:10:31.96,0:10:33.00,Default,,0,0,0,,Урю Ишида
Dialogue: 0,0:10:37.72,0:10:39.13,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:10:39.63,0:10:42.89,Default,,0,0,0,,Ұйқың келмесе, қабақтарыңды тігіп беремін.
Dialogue: 0,0:10:42.97,0:10:46.31,Default,,0,0,0,,Көріңіз, егер сіз оған жебеден тезірек жетсеңіз
Dialogue: 0,0:10:55.32,0:10:56.69,Default,,0,0,0,,Жарық жаңбыр (Личт Реген)
Dialogue: 0,0:11:03.78,0:11:07.04,Default,,0,0,0,,Қан шулап жатыр Урю Ишида
Dialogue: 0,0:11:07.12,0:11:09.29,Default,,0,0,0,,Одан енші алған көк қаным
Dialogue: 0,0:11:10.71,0:11:14.34,Default,,0,0,0,,Квинси нені мұра етеді?
Dialogue: 0,0:11:14.42,0:11:18.92,Default,,0,0,0,,Рух Патшасынан бас тартқандар артында не қалдырады?
Dialogue: 0,0:11:24.14,0:11:26.60,Default,,0,0,0,,Сендер, өлімді бұзатындар
Dialogue: 0,0:11:26.68,0:11:29.31,Default,,0,0,0,,Бұл жерде қан жойылады.
Dialogue: 0,0:11:29.39,0:11:29.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:35.86,0:11:36.77,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:36.86,0:11:37.53,Default,,0,0,0,,Иә
Dialogue: 0,0:11:38.65,0:11:39.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:46.03,0:11:46.70,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:56.46,0:11:58.09,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:11:58.59,0:12:03.88,Default,,0,0,0,,Маюриден айырмашылығы, Вараваның өлгендердің денесін илеу хоббиі жоқ.
Dialogue: 0,0:12:05.09,0:12:10.22,Default,,0,0,0,,Осы дүниеге зейнеткерлікке кетсем, өлуден аулақ болар едім.
Dialogue: 0,0:12:10.31,0:12:13.02,Default,,0,0,0,,Менің ұрысуға себеп бар
Dialogue: 0,0:12:13.10,0:12:15.15,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:12:23.86,0:12:26.74,Default,,0,0,0,,Мен неге өлмедім?
Dialogue: 0,0:12:26.82,0:12:30.79,Default,,0,0,0,,Неліктен сенің күшің меннен кетті?
Dialogue: 0,0:12:30.87,0:12:36.54,Default,,0,0,0,,Неліктен жеңілгеніңізді білгіңіз келе ме?
Dialogue: 0,0:12:36.63,0:12:39.30,Default,,0,0,0,,Мен жеңілемін бе?
Dialogue: 0,0:12:39.38,0:12:44.47,Default,,0,0,0,,Қара құмырсқаның атын алып тастау арқылы мен өзімді жақсы сезіндім.
Dialogue: 0,0:12:44.55,0:12:48.30,Default,,0,0,0,,Бір кездері Юхабах болған есімсіз адам.
Dialogue: 0,0:12:48.39,0:12:53.52,Default,,0,0,0,,Сен қара болсаң, мені қалай жеңесің?
Dialogue: 0,0:12:53.60,0:12:56.19,Default,,0,0,0,,Сіз оны білуіңіз мүмкін еді, бірақ ұмытып қалдыңыз ба?
Dialogue: 0,0:12:56.27,0:12:58.31,Default,,0,0,0,,Барлығы қара
Dialogue: 0,0:12:58.40,0:13:00.27,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:13:02.36,0:13:08.16,Default,,0,0,0,,♪ Ымырт
Dialogue: 0,0:13:08.24,0:13:14.16,Default,,0,0,0,,♪ Мәңгілік қараңғылық
Dialogue: 0,0:13:14.25,0:13:20.42,Default,,0,0,0,,♪ Бір сәт осында келіңіз.
Dialogue: 0,0:13:20.50,0:13:23.80,Default,,0,0,0,,♪ Бір сәтке бетіңізді көрсетіңіз
Dialogue: 0,0:13:23.88,0:13:27.18,Default,,0,0,0,,♪ Барып іш
Dialogue: 0,0:13:27.26,0:13:33.35,Default,,0,0,0,,♪ Ішсең, өмірің де ұшып кетеді.
Dialogue: 0,0:13:33.43,0:13:36.56,Default,,0,0,0,,♪ Тіпті өлім жолында
Dialogue: 0,0:13:36.64,0:13:43.65,Default,,0,0,0,,♪ Гүлдер гүлдейді
Dialogue: 0,0:13:46.40,0:13:48.57,Default,,0,0,0,,♪ Тісбасар қайда?
Dialogue: 0,0:13:48.66,0:13:50.28,Default,,0,0,0,,♪ Оны қара түске бояңыз
Dialogue: 0,0:13:50.37,0:13:52.16,Default,,0,0,0,,♪ Оны сегіз бөлікке бөліңіз
Dialogue: 0,0:13:52.24,0:13:54.54,Default,,0,0,0,,♪ Қатты қара жалынмен
Dialogue: 0,0:13:54.62,0:13:58.29,Default,,0,0,0,,♪ Грильде қара
Dialogue: 0,0:13:58.37,0:14:02.42,Default,,0,0,0,,♪ Барлығын жеп алайық
Dialogue: 0,0:14:02.50,0:14:06.30,Default,,0,0,0,,♪ Жегеннен кейін қалған таза ақ сүйектерімен
Dialogue: 0,0:14:06.38,0:14:10.68,Default,,0,0,0,,♪ Қабір белгісін орнатып, жоқтау айтайық.
Dialogue: 0,0:14:10.76,0:14:14.31,Default,,0,0,0,,♪ Онши енді ешқашан
Dialogue: 0,0:14:14.39,0:14:18.19,Default,,0,0,0,,♪ Тума
Dialogue: 0,0:14:18.27,0:14:22.82,Default,,0,0,0,,♪ Біздің құрбандық
Dialogue: 0,0:14:23.40,0:14:29.78,Default,,0,0,0,,♪ Бұған жол бермеңіз
Dialogue: 0,0:14:51.84,0:14:54.14,Default,,0,0,0,,Футен Тайсацурё!
Dialogue: 0,0:14:54.81,0:15:00.23,Default,,0,0,0,,100 жыл болашақта Soul Society 100 түнді ұрлау арқылы жасалған.
Dialogue: 0,0:15:00.31,0:15:03.36,Default,,0,0,0,,Оншиді жоқтап жатқан бір топ қабір тастары.
Dialogue: 0,0:15:04.06,0:15:06.65,Default,,0,0,0,,Ер адамның киген қарасын да бойына сіңіреді.
Dialogue: 0,0:15:06.73,0:15:10.11,Default,,0,0,0,,Қаның да, етің де, сүйегің де, бәрі де.
Dialogue: 0,0:15:10.20,0:15:13.16,Default,,0,0,0,,Оны қара жаншып, ештеңеге оралыңыз
Dialogue: 0,0:15:13.24,0:15:15.37,Default,,0,0,0,,Тіпті реинкарнацияға да жол берілмейді
Dialogue: 0,0:15:15.99,0:15:18.75,Default,,0,0,0,,Қара тозаққа түсу
Dialogue: 0,0:15:18.83,0:15:19.96,Default,,0,0,0,,Не!
Dialogue: 0,0:15:20.04,0:15:22.83,Default,,0,0,0,,Мен бәрін көре аламын дедім.
Dialogue: 0,0:15:23.50,0:15:29.09,Default,,0,0,0,,Менің күшімнен бұрын түсінуге немесе қарсы шараларға орын жоқ.
Dialogue: 0,0:15:29.17,0:15:32.55,Default,,0,0,0,,Менің көрген-білгенімнің бәрі
Dialogue: 0,0:15:32.64,0:15:35.35,Default,,0,0,0,,Менің алдымда дәрменсіз
Dialogue: 0,0:15:36.76,0:15:40.73,Default,,0,0,0,,Сіз мені әлі де жасырын деп ойлайсыз ба?
Dialogue: 0,0:15:41.23,0:15:43.48,Default,,0,0,0,,Менің атым Джухабах
Dialogue: 0,0:15:43.98,0:15:46.65,Default,,0,0,0,,Ол сенен бәрін тартып алады.
Dialogue: 0,0:15:58.83,0:16:02.62,Default,,0,0,0,,Бұл Жұлдызды Крест Рыцарларының (Sternritter) күші...
Dialogue: 0,0:16:07.71,0:16:09.59,Default,,0,0,0,,Сіз есіңізден шығып қалдыңыз ба?
Dialogue: 0,0:16:09.67,0:16:11.88,Default,,0,0,0,,Жаман Банкайдан құтыла алсаң...
Dialogue: 0,0:16:11.97,0:16:14.51,Default,,0,0,0,,Бұл біртүрлі сөздер айтатын Шинигами.
Dialogue: 0,0:16:15.01,0:16:17.89,Default,,0,0,0,,Қазіргі уақытта Банкай ұстаған адам...
Dialogue: 0,0:16:17.97,0:16:18.89,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:16:18.97,0:16:19.81,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:21.98,0:16:24.02,Default,,0,0,0,,Мен Урю Ишидамын
Dialogue: 0,0:16:24.56,0:16:28.65,Default,,0,0,0,,Квинсидің мақтанышы үшін мен сені құртамын.
Dialogue: 0,0:16:39.66,0:16:40.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:44.54,0:16:45.58,Default,,0,0,0,,Гррр…
Dialogue: 0,0:16:47.25,0:16:47.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:05.77,0:17:10.65,Default,,0,0,0,,Мен көргендей ол маған үш қадам қалғанда өлді.
Dialogue: 0,0:17:11.57,0:17:12.61,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:27.12,0:17:29.17,Default,,0,0,0,,Zero Squad құлады.
Dialogue: 0,0:17:30.00,0:17:32.42,Default,,0,0,0,,Мың жылдық дұғаларымыз
Dialogue: 0,0:17:32.50,0:17:35.05,Default,,0,0,0,,Сізді марапаттайтын уақыт келді.
Dialogue: 0,0:17:39.93,0:17:42.72,Default,,0,0,0,,Сіз келесіде құлайсыз.
Dialogue: 0,0:17:42.81,0:17:44.35,Default,,0,0,0,,Рух патшасы
Dialogue: 0,0:18:21.47,0:18:22.85,Default,,0,0,0,,Мың жыл
Dialogue: 0,0:18:27.18,0:18:31.44,Default,,0,0,0,,Жоғалту біздің Квинсидің жан дүниесінде сақталған
Dialogue: 0,0:18:36.11,0:18:39.91,Default,,0,0,0,,Қылмыскерді жоюға арналған қасиетті соғыс
Dialogue: 0,0:18:45.95,0:18:48.96,Default,,0,0,0,,Бұл сіздің өліміңізбен аяқталады.
Dialogue: 0,0:18:51.08,0:18:55.38,Default,,0,0,0,,Менің қадамдарымды естисіз бе?
Dialogue: 0,0:19:03.89,0:19:09.14,Default,,0,0,0,,Үш дүние патшасының қолына арналған қоңырау.
Dialogue: 0,0:19:10.44,0:19:12.44,Default,,0,0,0,,♪～
Dialogue: 0,0:20:35.90,0:20:37.90,Default,,0,0,0,,～♪
Dialogue: 0,0:20:41.15,0:20:42.44,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:48.24,0:20:49.45,Default,,0,0,0,,Тыныш
Dialogue: 0,0:20:50.04,0:20:51.37,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,0:20:51.45,0:20:53.21,Default,,0,0,0,,Шайқас аяқталды ма?
Dialogue: 0,0:20:53.29,0:20:54.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:54.37,0:20:56.46,Default,,0,0,0,,- (Орихиме) Ха! -(Йоричи) Бұл...
Dialogue: 0,0:20:56.54,0:20:58.29,Default,,0,0,0,,Бұл нөлдік топ па?
Dialogue: 0,0:20:58.38,0:21:00.42,Default,,0,0,0,,Ах, діни қызметкер.
Dialogue: 0,0:21:00.92,0:21:01.76,Default,,0,0,0,,Ичиго
Dialogue: 0,0:21:01.84,0:21:03.30,Default,,0,0,0,,А... Монах?
Dialogue: 0,0:21:03.38,0:21:06.18,Default,,0,0,0,,Ичиго... Аты...
Dialogue: 0,0:21:06.26,0:21:08.14,Default,,0,0,0,,- (Чадо) Не болды? -(Ичиго) Түсінбедім.
Dialogue: 0,0:21:08.64,0:21:10.47,Default,,0,0,0,,Маған атыммен қоңырау шалыңыз
Dialogue: 0,0:21:10.56,0:21:12.18,Default,,0,0,0,,Мен діни қызметкердің дауысын естимін
Dialogue: 0,0:21:12.27,0:21:12.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:12.89,0:21:16.35,Default,,0,0,0,,Менің атымды атаңыз, Ичиго.
Dialogue: 0,0:21:16.85,0:21:17.65,Default,,0,0,0,,Аты...
Dialogue: 0,0:21:19.61,0:21:21.15,Default,,0,0,0,,Хёшубу Ичибей
Dialogue: 0,0:21:22.11,0:21:22.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:30.78,0:21:31.95,Default,,0,0,0,,Аа...
Dialogue: 0,0:21:32.04,0:21:34.20,Default,,0,0,0,,Жоқ, рахмет.
Dialogue: 0,0:21:35.50,0:21:38.63,Default,,0,0,0,,Барлық күш атауда бар
Dialogue: 0,0:21:38.71,0:21:41.17,Default,,0,0,0,,Ер адам сенің атыңды шақыру арқылы
Dialogue: 0,0:21:41.25,0:21:44.46,Default,,0,0,0,,Өз күшіңіздің азын-аулағын алыңыз және алыңыз.
Dialogue: 0,0:21:44.55,0:21:46.43,Default,,0,0,0,,Сіз өз денеңізді емдедіңіз.
Dialogue: 0,0:21:46.51,0:21:47.93,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:21:48.01,0:21:49.47,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:21:49.55,0:21:52.81,Default,,0,0,0,,Менің және сіздің күшіңізбен бұл табиғи нәрсе.
Dialogue: 0,0:21:52.89,0:21:55.43,Default,,0,0,0,,Вахахахаха!
Dialogue: 0,0:21:57.14,0:22:00.36,Default,,0,0,0,,Ичиго, Джухабахты тоқтат.
Dialogue: 0,0:22:01.19,0:22:03.98,Default,,0,0,0,,Zero Squad олардан жеңілді.
Dialogue: 0,0:22:04.57,0:22:07.40,Default,,0,0,0,,Мен денемді қайтардым, бірақ
Dialogue: 0,0:22:07.49,0:22:10.62,Default,,0,0,0,,Күшіңіз қалпына келгенше күтсеңіз, уақытында үлгере алмайсыз.
Dialogue: 0,0:22:11.32,0:22:14.75,Default,,0,0,0,,Оны тоқтата алатын басқа ешкім жоқ.
Dialogue: 0,0:22:15.33,0:22:17.04,Default,,0,0,0,,Мен саған мені өлтір демеймін.
Dialogue: 0,0:22:17.12,0:22:18.83,Default,,0,0,0,,Тек тоқтаңыз.
Dialogue: 0,0:22:19.83,0:22:22.13,Default,,0,0,0,,Рух патшасы - әлемнің кілті.
Dialogue: 0,0:22:22.21,0:22:24.88,Default,,0,0,0,,Рух патша өлсе, бұл дүние де өледі.
Dialogue: 0,0:22:24.96,0:22:26.38,Default,,0,0,0,,Сондай-ақ ойдан шығарылған сфера
Dialogue: 0,0:22:26.47,0:22:28.26,Default,,0,0,0,,Сейрейтей де
Dialogue: 0,0:22:28.34,0:22:31.39,Default,,0,0,0,,Барлығы құлап, жоғалады
Dialogue: 0,0:22:32.18,0:22:35.52,Default,,0,0,0,,Бұл тапсырманы сізге тапсырғаным үшін кешірім сұраймын.
Dialogue: 0,0:22:36.73,0:22:40.15,Default,,0,0,0,,Рух патшасын қорғаңыз, Ичиго.
Dialogue: 0,0:22:41.56,0:22:42.44,Default,,0,0,0,,О
Dialogue: 0,0:23:07.34,0:23:10.76,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:23:14.14,0:23:16.60,Default,,0,0,0,,Қоштасу Рухы Патшасы
Dialogue: 0,0:23:26.36,0:23:28.53,Default,,0,0,0,,Болашаққа көзқарас
Dialogue: 0,0:23:30.20,0:23:32.07,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:23:39.00,0:23:41.83,Default,,0,0,0,,Қолдарға арналған қоңырау соғылады.
Dialogue: 0,0:23:42.83,0:23:44.88,Default,,0,0,0,,Қылышпен ұрған
Dialogue: 0,0:23:45.38,0:23:47.84,Default,,0,0,0,,Мен жерге құлағанша
Dialogue: 0,0:23:49.34,0:23:55.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
