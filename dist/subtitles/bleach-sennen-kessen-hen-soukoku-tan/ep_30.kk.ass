Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.38,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги
Dialogue: 0,0:00:07.46,0:00:09.59,Default,,0,0,0,,Көзіңнің қуатын аш
Dialogue: 0,0:00:09.67,0:00:11.92,Default,,0,0,0,,Жүрегімде Үзұмеші Көздің құдіреті
Dialogue: 0,0:00:12.01,0:00:14.43,Default,,0,0,0,,Менің түсінігімнен бас тартып, оны ашыңыз.
Dialogue: 0,0:00:14.51,0:00:16.68,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги
Dialogue: 0,0:00:16.76,0:00:18.43,Default,,0,0,0,,Көзіңнің қуатын аш
Dialogue: 0,0:00:23.77,0:00:28.11,Default,,0,0,0,,Лорд Мимихагидің күші менің өкпемді жеп жатты.
Dialogue: 0,0:00:28.65,0:00:32.07,Default,,0,0,0,,Сол күшті бүкіл дене мүшелеріне тарату рәсімі.
Dialogue: 0,0:00:32.15,0:00:33.65,Default,,0,0,0,,«Камикаке» деп аталады.
Dialogue: 0,0:00:35.24,0:00:38.99,Default,,0,0,0,,Менің барлық ішкі мүшелерім енді Мимихаги-самаға тиесілі.
Dialogue: 0,0:00:39.58,0:00:44.96,Default,,0,0,0,,Барлық мүшелерімді ұсына отырып, мен Мимихаги-саманың йориширосы болдым.
Dialogue: 0,0:00:45.71,0:00:49.46,Default,,0,0,0,,Мен қазір Рухани Патшаның оң қолымын.
Dialogue: 0,0:00:50.88,0:00:53.55,Default,,0,0,0,,Неліктен аман қалғанымды білгеннен бері
Dialogue: 0,0:00:54.05,0:00:56.47,Default,,0,0,0,,Мен бір күні келетін бұл күнді ойладым.
Dialogue: 0,0:00:57.64,0:01:02.10,Default,,0,0,0,,Бірде қолыма алған бұл өмір, Гетей үшін өлсем ғой.
Dialogue: 0,0:01:02.77,0:01:04.60,Default,,0,0,0,,Кешіріңіз, Куцуки.
Dialogue: 0,0:01:05.19,0:01:07.94,Default,,0,0,0,,Сіз мені үнемі жаман сезінесіз
Dialogue: 0,0:01:08.44,0:01:09.98,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:01:10.06,0:01:12.36,Default,,0,0,0,,Ұрыстың екі түрі бар.
Dialogue: 0,0:01:12.44,0:01:15.36,Default,,0,0,0,,Сіз Кучикиді білесіз.
Dialogue: 0,0:01:19.41,0:01:21.58,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:01:21.66,0:01:26.50,Default,,0,0,0,,Арх!
Dialogue: 0,0:01:36.09,0:01:39.26,Default,,0,0,0,,Жер асты дүмпулері... тоқтады.
Dialogue: 0,0:01:47.69,0:01:49.19,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:49.27,0:01:53.40,Default,,0,0,0,,Бұл менің көзіме көрінбейтін нәрсе
Dialogue: 0,0:01:54.57,0:01:58.53,Default,,0,0,0,,Сіз... сіз Рух Патшасысыз ба?
Dialogue: 0,0:01:58.61,0:01:59.49,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:01.37,0:02:05.29,Default,,0,0,0,,Рух патшасының оң қолы кедергі келтіреді деп ойлау.
Dialogue: 0,0:02:05.37,0:02:09.75,Default,,0,0,0,,Сіз өзіңіз қорғап жүрген жан қоғамына қосылдыңыз ба?
Dialogue: 0,0:02:10.25,0:02:13.42,Default,,0,0,0,,Жауап бер, Рух патшасы!
Dialogue: 0,0:02:22.51,0:02:24.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:49.93,0:03:51.94,Default,,0,0,0,,～♪
Dialogue: 0,0:03:54.65,0:03:58.44,Default,,0,0,0,,Рух патшасының сол қолы «алға қозғалысты» басқарады
Dialogue: 0,0:03:58.52,0:04:01.03,Default,,0,0,0,,Оң қол «тыныштықты» басқарады
Dialogue: 0,0:04:01.53,0:04:06.41,Default,,0,0,0,,Сонда сіз өмірдің қалдықтарын әрең сақтап қалдыңыз ба?
Dialogue: 0,0:04:07.08,0:04:07.58,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:04:13.92,0:04:19.17,Default,,0,0,0,,Маған өзің кедергі болады деп ойламадым.
Dialogue: 0,0:04:24.13,0:04:27.43,Default,,0,0,0,,Мына қара затты Рух патшасының қолы дейсіз бе?
Dialogue: 0,0:04:28.97,0:04:29.68,Default,,0,0,0,,Түсініксіз
Dialogue: 0,0:04:30.39,0:04:34.94,Default,,0,0,0,,Болашақты көретін адам неге оң қолымен кедергі жасайды?
Dialogue: 0,0:04:35.65,0:04:40.19,Default,,0,0,0,,Бұл Рух Патшасының еркі сонда тұрмайды дегенді білдіре ме?
Dialogue: 0,0:04:41.65,0:04:46.41,Default,,0,0,0,,Олай болса мен сені, оның ішінде оң қолыңды да сүртемін.
Dialogue: 0,0:04:47.20,0:04:48.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:48.74,0:04:52.41,Default,,0,0,0,,Ууу!
Dialogue: 0,0:05:00.04,0:05:02.80,Default,,0,0,0,,Сіз әлі де менің жолымды бөгеп тұрсыз ба?
Dialogue: 0,0:05:05.30,0:05:06.59,Default,,0,0,0,,Жарайсың Ичиго!
Dialogue: 0,0:05:13.39,0:05:15.73,Default,,0,0,0,,Бұл жігіт Рух Патшасына жабысып тұрғанда,
Dialogue: 0,0:05:15.81,0:05:18.31,Default,,0,0,0,,Жан қоғамы тұрақтанған сияқты.
Dialogue: 0,0:05:18.40,0:05:19.61,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:05:20.15,0:05:23.44,Default,,0,0,0,,Мен сені жаңа Рух Патшасы ретінде осы пішінде сақтаймын!
Dialogue: 0,0:05:23.53,0:05:24.61,Default,,0,0,0,,Йоруичи-сан!
Dialogue: 0,0:05:24.69,0:05:25.78,Default,,0,0,0,,Хааа~
Dialogue: 0,0:05:25.86,0:05:27.70,Default,,0,0,0,,Ичиго, ол жігітті қасыңа жолатпа.
Dialogue: 0,0:05:28.45,0:05:29.12,Default,,0,0,0,,О
Dialogue: 0,0:05:30.62,0:05:32.33,Default,,0,0,0,,Гецуга...
Dialogue: 0,0:05:33.16,0:05:33.66,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:35.71,0:05:37.12,Default,,0,0,0,,- (Садо) Ичиго! -(Орихиме) Куросаки-кун!
Dialogue: 0,0:05:40.71,0:05:41.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:41.71,0:05:43.09,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:43.80,0:05:45.13,Default,,0,0,0,,Бұл өкінішті болды.
Dialogue: 0,0:05:45.21,0:05:48.22,Default,,0,0,0,,Сіз көрген болашақ енді ешқашан келмейді.
Dialogue: 0,0:05:48.72,0:05:49.80,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:50.89,0:05:51.76,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:53.26,0:05:55.27,Default,,0,0,0,,Ичигоның жолынан кет
Dialogue: 0,0:05:55.77,0:05:57.19,Default,,0,0,0,,Мен мұндай нәрселерге әрдайым шебер болдым, көріп тұрсың ғой.
Dialogue: 0,0:05:57.69,0:06:00.44,Default,,0,0,0,,Мен сені тоқтатып, бәрін қорғаймын.
Dialogue: 0,0:06:00.52,0:06:03.44,Default,,0,0,0,,Неліктен «тоқта» дейміз?
Dialogue: 0,0:06:04.03,0:06:05.82,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:06:05.90,0:06:08.36,Default,,0,0,0,,Ол сенің жауың емес пе?
Dialogue: 0,0:06:08.45,0:06:08.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:09.03,0:06:11.99,Default,,0,0,0,,Анамды өлтірген адамға
Dialogue: 0,0:06:12.08,0:06:15.75,Default,,0,0,0,,Сіздің әлсіздігіңіз сол жерде «өлтіремін» деп айта алмайсыз.
Dialogue: 0,0:06:15.83,0:06:16.83,Default,,0,0,0,,Ичиго
Dialogue: 0,0:06:16.91,0:06:17.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:24.80,0:06:25.67,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:30.34,0:06:31.22,Default,,0,0,0,,Ишида…
Dialogue: 0,0:06:33.47,0:06:34.89,Default,,0,0,0,,Рух патшасы кетті!
Dialogue: 0,0:06:34.97,0:06:35.97,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:38.43,0:06:39.27,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:06:40.35,0:06:42.94,Default,,0,0,0,,Ишида: Бұл қандай еліктеу?
Dialogue: 0,0:06:44.15,0:06:45.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:45.57,0:06:46.15,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:46.90,0:06:47.40,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:00.33,0:07:01.87,Default,,0,0,0,,Тамақ ішейік
Dialogue: 0,0:07:02.38,0:07:04.42,Default,,0,0,0,,Бірінші шарды қабылдаған дене болды
Dialogue: 0,0:07:04.50,0:07:08.51,Default,,0,0,0,,Екінші шар оны бөліктерге бөледі!
Dialogue: 0,0:07:08.59,0:07:10.13,Default,,0,0,0,,Палункажас
Dialogue: 0,0:07:15.43,0:07:18.22,Default,,0,0,0,,Бұл қандай күш...
Dialogue: 0,0:07:19.64,0:07:20.64,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:07:22.15,0:07:23.27,Default,,0,0,0,,Йоруичи-сан!
Dialogue: 0,0:07:29.78,0:07:30.32,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:32.91,0:07:33.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:36.37,0:07:39.50,Default,,0,0,0,,Жарайсың Урю
Dialogue: 0,0:07:45.67,0:07:46.63,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:47.25,0:07:48.30,Default,,0,0,0,,- (Орихиме) Ах! - (Иваваси) О!
Dialogue: 0,0:07:52.30,0:07:53.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:00.77,0:08:03.85,Default,,0,0,0,,Мәртебелі, Куросакиге кедергі жасамаңыз.
Dialogue: 0,0:08:05.06,0:08:07.73,Default,,0,0,0,,Мен мұны еліктеу деп естідім.
Dialogue: 0,0:08:08.52,0:08:09.48,Default,,0,0,0,,Ишида!
Dialogue: 0,0:08:12.57,0:08:14.24,Default,,0,0,0,,Исида мырза...
Dialogue: 0,0:08:14.32,0:08:15.87,Default,,0,0,0,,Ишида…
Dialogue: 0,0:08:15.95,0:08:18.95,Default,,0,0,0,,Қозғалмаңдар, бәрің.
Dialogue: 0,0:08:20.04,0:08:22.58,Default,,0,0,0,,Егер сіз тұрған жерден сәл де болса қозғалсаңыз...
Dialogue: 0,0:08:23.37,0:08:24.12,Default,,0,0,0,,Түсіру
Dialogue: 0,0:08:27.67,0:08:28.29,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:29.05,0:08:30.55,Default,,0,0,0,,Мен түсіремін дедім.
Dialogue: 0,0:08:31.34,0:08:33.17,Default,,0,0,0,,Қалжыңдамаңыз.
Dialogue: 0,0:08:33.93,0:08:35.13,Default,,0,0,0,,Ишида!
Dialogue: 0,0:08:35.64,0:08:39.43,Default,,0,0,0,,Біздің мұнда не үшін келгенімізді білесің бе?
Dialogue: 0,0:08:39.51,0:08:41.14,Default,,0,0,0,,Мен тыңдадым.
Dialogue: 0,0:08:41.77,0:08:43.64,Default,,0,0,0,,Мәртебелін тоқтату үшін шығар.
Dialogue: 0,0:08:44.14,0:08:46.40,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат етпеймін деп жатырмын.
Dialogue: 0,0:08:46.48,0:08:48.65,Default,,0,0,0,,Мен Джухабахты тоқтатуым керек
Dialogue: 0,0:08:48.73,0:08:51.53,Default,,0,0,0,,Жан қоғамы, бұл әлем және қиял әлемі
Dialogue: 0,0:08:51.61,0:08:53.86,Default,,0,0,0,,үшін жоғалады!
Dialogue: 0,0:08:53.95,0:08:57.62,Default,,0,0,0,,Сіз бұл жерде білмей келдім деп ойлайсыз ба?
Dialogue: 0,0:08:57.70,0:08:58.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:00.45,0:09:01.91,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:09:02.79,0:09:05.08,Default,,0,0,0,,Біздің не үшін келгенімізді біліңіз
Dialogue: 0,0:09:05.71,0:09:07.67,Default,,0,0,0,,Ұрыстың себебін білу...
Dialogue: 0,0:09:08.83,0:09:12.17,Default,,0,0,0,,Неліктен сен әлі сондасың?
Dialogue: 0,0:09:13.21,0:09:14.59,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:09:15.88,0:09:18.97,Default,,0,0,0,,Өйткені мен Квинсимін
Dialogue: 0,0:09:22.10,0:09:24.10,Default,,0,0,0,,Мәртебелін тоқтатқыңыз келсе
Dialogue: 0,0:09:24.89,0:09:26.35,Default,,0,0,0,,Мені өлтір
Dialogue: 0,0:09:40.49,0:09:41.53,Default,,0,0,0,,Ишида…
Dialogue: 0,0:09:54.01,0:09:55.42,Default,,0,0,0,,Не?
Dialogue: 0,0:09:55.92,0:10:00.68,Default,,0,0,0,,Олар ұлы мәртебелілерді тоқтатуға келдік дейді, сондықтан олардың қандай үлкен әскері бар деп ойлаймын.
Dialogue: 0,0:10:00.76,0:10:03.43,Default,,0,0,0,,Не деген сұмдықтар.
Dialogue: 0,0:10:03.51,0:10:05.18,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:10:05.27,0:10:08.35,Default,,0,0,0,,Бізді бағалама, Икки Тоусен!
Dialogue: 0,0:10:08.44,0:10:11.11,Default,,0,0,0,,О, бұл қызық.
Dialogue: 0,0:10:11.19,0:10:14.32,Default,,0,0,0,,Кеттік, Чад, Орихиме-чан.
Dialogue: 0,0:10:14.40,0:10:15.32,Default,,0,0,0,,Иә
Dialogue: 0,0:10:17.57,0:10:19.03,Default,,0,0,0,,Қарғыс атсын! Ха!
Dialogue: 0,0:10:20.45,0:10:21.20,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:10:21.28,0:10:21.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:26.12,0:10:28.08,Default,,0,0,0,,Мына бансыз жігіт...
Dialogue: 0,0:10:28.58,0:10:29.42,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:32.04,0:10:33.34,Default,,0,0,0,,Жарық жаңбыр (Личт Реген)
Dialogue: 0,0:10:33.88,0:10:34.88,Default,,0,0,0,,Аһ!
Dialogue: 0,0:10:43.26,0:10:43.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:47.68,0:10:48.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:52.31,0:10:53.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:55.44,0:10:56.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:59.45,0:11:00.36,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:00.45,0:11:01.32,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:08.95,0:11:10.25,Default,,0,0,0,,Мен оны ұстадым.
Dialogue: 0,0:11:14.00,0:11:16.34,Default,,0,0,0,,Уайымдама, Ишида!
Dialogue: 0,0:11:18.34,0:11:19.92,Default,,0,0,0,,Қай ауыз сөйлейді?
Dialogue: 0,0:11:20.01,0:11:21.18,Default,,0,0,0,,(Баяндаушы) Цезарь не болып жатқанын мүлде түсінбеді.
Dialogue: 0,0:11:21.26,0:11:24.80,Default,,0,0,0,,Енді мені өлтіруіңіз мүмкін еді.
Dialogue: 0,0:11:24.89,0:11:26.64,Default,,0,0,0,,Мұны істеу мүмкін емес!
Dialogue: 0,0:11:26.72,0:11:27.68,Default,,0,0,0,,Сіз біздің...
Dialogue: 0,0:11:27.77,0:11:29.18,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:11:30.02,0:11:31.81,Default,,0,0,0,,Мен Куинсимін
Dialogue: 0,0:11:32.44,0:11:34.06,Default,,0,0,0,,үшін осы.
Dialogue: 0,0:11:34.15,0:11:36.02,Default,,0,0,0,,Ишида Сен...
Dialogue: 0,0:11:36.52,0:11:38.53,Default,,0,0,0,,Бұл дүниеде өлім құдайы жоқ...
Dialogue: 0,0:11:38.61,0:11:39.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:40.40,0:11:41.74,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:11:41.82,0:11:42.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:58.46,0:11:59.92,Default,,0,0,0,,Бұл менің...
Dialogue: 0,0:12:02.93,0:12:03.97,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:12:27.58,0:12:29.83,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:12:29.91,0:12:30.83,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:30.91,0:12:34.67,Default,,0,0,0,,Шутара шкаласының шекаралық инвазия дәрежесі тұрақсыз болды.
Dialogue: 0,0:12:35.17,0:12:37.00,Default,,0,0,0,,Мен оның бос екеніне сене алар емеспін ...
Dialogue: 0,0:12:37.08,0:12:39.88,Default,,0,0,0,,Жоқ, арттыруға немесе азайтуға жол берілмейді.
Dialogue: 0,0:12:40.38,0:12:41.88,Default,,0,0,0,,Олай болса, себебі неде?
Dialogue: 0,0:12:42.63,0:12:46.34,Default,,0,0,0,,Бұл үш дүниедегі жан тепе-теңдігі туралы емес.
Dialogue: 0,0:12:46.84,0:12:48.26,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:12:48.97,0:12:51.02,Default,,0,0,0,,Неге назар аудару керек...
Dialogue: 0,0:12:55.73,0:13:00.52,Default,,0,0,0,,Мен Рух патшасының оң қолы тыныштықты басқарады деп естідім.
Dialogue: 0,0:13:00.61,0:13:01.90,Default,,0,0,0,,Тыныштық…
Dialogue: 0,0:13:02.40,0:13:05.53,Default,,0,0,0,,Сіз бұл күш әлемді тоқтатып жатыр дейсіз бе?
Dialogue: 0,0:13:05.61,0:13:06.95,Default,,0,0,0,,Құдайдың көмегімен
Dialogue: 0,0:13:07.03,0:13:10.53,Default,,0,0,0,,Мен Мимихаги-сама деген нәрсемен ассимиляцияланған болсам да.
Dialogue: 0,0:13:10.62,0:13:14.54,Default,,0,0,0,,Сол күштің қайнар көзі Үкітаке-санның өмірі.
Dialogue: 0,0:13:15.46,0:13:19.38,Default,,0,0,0,,Егер мен Рух Патшасының орнына дүниені тұрақтандыратын болсам.
Dialogue: 0,0:13:19.46,0:13:21.80,Default,,0,0,0,,Өлшеусіз ауыртпалық
Dialogue: 0,0:13:25.42,0:13:26.47,Default,,0,0,0,,Асығу керек
Dialogue: 0,0:13:35.48,0:13:38.15,Default,,0,0,0,,Ишида Бұл көрініс...
Dialogue: 0,0:13:41.15,0:13:43.40,Default,,0,0,0,,Аннигилатордың мінсіздігі (Квинси Форстендиг)
Dialogue: 0,0:13:44.69,0:13:46.90,Default,,0,0,0,,Бұл менің жаңа күшім.
Dialogue: 0,0:14:02.92,0:14:03.42,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:04.00,0:14:04.51,Default,,0,0,0,,Ga!
Dialogue: 0,0:14:09.43,0:14:10.05,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:14:10.14,0:14:11.30,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:18.14,0:14:20.15,Default,,0,0,0,,Шиба стиліндегі Шака Сендан!
Dialogue: 0,0:14:20.73,0:14:22.86,Default,,0,0,0,,Шірік Банка!
Dialogue: 0,0:14:22.94,0:14:25.86,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:14:25.94,0:14:28.61,Default,,0,0,0,,Бұл бос сөз, өшіріп таста!
Dialogue: 0,0:14:31.20,0:14:32.03,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:33.24,0:14:36.91,Default,,0,0,0,,Бласо Изкиерда дель Диабло!
Dialogue: 0,0:14:39.83,0:14:42.88,Default,,0,0,0,,Ой, қорқынышты, қорқынышты
Dialogue: 0,0:14:42.96,0:14:45.00,Default,,0,0,0,,Бұл сынға ұшырады.
Dialogue: 0,0:14:45.50,0:14:49.76,Default,,0,0,0,,Қалай ойлайсыңдар, біз осы деңгейдегі шабуылдан жеңіле аламыз ба?
Dialogue: 0,0:14:49.84,0:14:51.43,Default,,0,0,0,,Бұл туралы ойламаңыз
Dialogue: 0,0:14:51.51,0:14:52.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:52.14,0:14:53.55,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:54.05,0:14:56.35,Default,,0,0,0,,Рекан Ишинами фанаты!
Dialogue: 0,0:15:04.32,0:15:06.57,Default,,0,0,0,,Хааа~
Dialogue: 0,0:15:06.65,0:15:09.19,Default,,0,0,0,,Менің үлкен жетістігімді көрдіңіз бе?
Dialogue: 0,0:15:09.28,0:15:10.20,Default,,0,0,0,,Иә
Dialogue: 0,0:15:10.28,0:15:11.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:12.45,0:15:15.87,Default,,0,0,0,,Ва~хахахаха!
Dialogue: 0,0:15:16.45,0:15:20.12,Default,,0,0,0,,Жақсы ойлағаның үшін мақтаймын...
Dialogue: 0,0:15:20.21,0:15:23.08,Default,,0,0,0,,Бірақ бұл сіздің толық күшіңіз болса
Dialogue: 0,0:15:23.17,0:15:25.04,Default,,0,0,0,,Бұл өлім, балалар.
Dialogue: 0,0:15:26.88,0:15:27.76,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:45.61,0:15:49.90,Default,,0,0,0,,Капитан Укитаке... әлі соғысуда.
Dialogue: 0,0:15:50.57,0:15:54.49,Default,,0,0,0,,Капитанға ештеңе істей алмайсыз ба?
Dialogue: 0,0:15:54.57,0:15:57.12,Default,,0,0,0,,Жоқ, капитан Укитаке, енді жоқ...
Dialogue: 0,0:16:17.05,0:16:17.85,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:26.02,0:16:27.90,Default,,0,0,0,,Сіз мені жеңе алмайсыз
Dialogue: 0,0:16:27.98,0:16:29.40,Default,,0,0,0,,Беріл, құла!
Dialogue: 0,0:16:29.48,0:16:31.11,Default,,0,0,0,,Шу!
Dialogue: 0,0:16:33.20,0:16:35.57,Default,,0,0,0,,Мен сенімді емеспін.
Dialogue: 0,0:16:36.87,0:16:39.95,Default,,0,0,0,,Мен сене алмаймын, өйткені сен Квинсисің.
Dialogue: 0,0:16:40.04,0:16:41.50,Default,,0,0,0,,Оны ешқашан мойындамаңыз!
Dialogue: 0,0:16:42.08,0:16:44.46,Default,,0,0,0,,Маған сіздің мақұлдауыңыз қажет емес
Dialogue: 0,0:16:44.54,0:16:46.88,Default,,0,0,0,,Сол үшін мені өлтіріп жатырсың ба?
Dialogue: 0,0:16:47.46,0:16:51.34,Default,,0,0,0,,Шебер Квинси мен Қасқыр бір-бірін түсінетінін айтты.
Dialogue: 0,0:16:51.84,0:16:55.38,Default,,0,0,0,,Мен де солай болуы мүмкін деп ойлағаныма сенімдімін.
Dialogue: 0,0:16:57.93,0:17:00.22,Default,,0,0,0,,Бірақ бұл қате болды.
Dialogue: 0,0:17:06.56,0:17:08.77,Default,,0,0,0,,Мың жыл бұрын басталған тағдыр
Dialogue: 0,0:17:09.65,0:17:13.90,Default,,0,0,0,,Квинсидің мөрленген патшасы алдағы уақытты күтуде.
Dialogue: 0,0:17:13.99,0:17:17.95,Default,,0,0,0,,Қалған Квинстерді Грим Реапер сойды.
Dialogue: 0,0:17:18.45,0:17:20.12,Default,,0,0,0,,Шебер де солай.
Dialogue: 0,0:17:20.70,0:17:24.37,Default,,0,0,0,,Қан төккен біз Квинсилерміз.
Dialogue: 0,0:17:24.46,0:17:28.63,Default,,0,0,0,,Менен бәрін тартып алған жанды кешіре алмаймын!
Dialogue: 0,0:17:32.25,0:17:34.88,Default,,0,0,0,,Ишида аааа!
Dialogue: 0,0:17:35.38,0:17:36.05,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:39.14,0:17:42.77,Default,,0,0,0,,Не болды, қоңырау шалмайсың ба?
Dialogue: 0,0:17:42.85,0:17:44.77,Default,,0,0,0,,Егер сіз қоңырау шалмасаңыз
Dialogue: 0,0:17:45.35,0:17:47.77,Default,,0,0,0,,Бірден бір-бірімізбен айналысайық.
Dialogue: 0,0:17:47.85,0:17:49.73,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:17:50.73,0:17:51.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:52.86,0:17:53.40,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,0:17:53.48,0:17:55.11,Default,,0,0,0,,- (Иваваси) Арх! -(Орихиме) Ах!
Dialogue: 0,0:17:55.74,0:17:58.91,Default,,0,0,0,,(Ичигоның ауыр тыныс алуы)
Dialogue: 0,0:17:59.53,0:18:01.03,Default,,0,0,0,,Мәселені шешейік
Dialogue: 0,0:18:01.53,0:18:02.66,Default,,0,0,0,,Ишида…
Dialogue: 0,0:18:03.45,0:18:05.91,Default,,0,0,0,,Менің шешімім осында.
Dialogue: 0,0:18:07.00,0:18:08.62,Default,,0,0,0,,Сіздің мақтанышыңыз...
Dialogue: 0,0:18:09.37,0:18:10.33,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:18:11.34,0:18:12.54,Default,,0,0,0,,Куросаки
Dialogue: 0,0:18:18.18,0:18:22.26,Default,,0,0,0,,...
Dialogue: 0,0:18:22.85,0:18:24.81,Default,,0,0,0,,Жұлдызды шаң (Sternenstaub)!
Dialogue: 0,0:18:30.44,0:18:31.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:46.08,0:18:48.08,Default,,0,0,0,,Сіз қаншалықты тәттісіз?
Dialogue: 0,0:18:50.71,0:18:53.13,Default,,0,0,0,,Сонда да мен...
Dialogue: 0,0:19:07.10,0:19:08.14,Default,,0,0,0,,Куросаки
Dialogue: 0,0:19:12.56,0:19:15.40,Default,,0,0,0,,Мен сізге ұлы мәртебелі мəртебені өлтіруге рұқсат бермеймін.
Dialogue: 0,0:19:18.61,0:19:19.65,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:30.96,0:19:31.96,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:19:44.72,0:19:46.85,Default,,0,0,0,,Иши… Да…
Dialogue: 0,0:19:57.27,0:20:00.90,Default,,0,0,0,,Ва~хахахаха!
Dialogue: 0,0:20:00.99,0:20:03.49,Default,,0,0,0,,Жақсы жұмыс, жаңа жігіт
Dialogue: 0,0:20:03.57,0:20:06.49,Default,,0,0,0,,Мен сізді танимын!
Dialogue: 0,0:20:15.58,0:20:17.59,Default,,0,0,0,,♪～
Dialogue: 0,0:21:41.04,0:21:43.05,Default,,0,0,0,,～♪
Dialogue: 0,0:21:51.81,0:21:54.02,Default,,0,0,0,,Рух патшасының оң қолы
Dialogue: 0,0:21:54.60,0:21:57.81,Default,,0,0,0,,Сіз мені бала ретінде қабылдауға тырысасыз ба?
Dialogue: 0,0:21:58.31,0:21:59.77,Default,,0,0,0,,аянышты
Dialogue: 0,0:22:04.28,0:22:08.66,Default,,0,0,0,,Болашақты көрсең де, күштің айырмашылығын көре алмайсың ба?
Dialogue: 0,0:22:09.78,0:22:13.41,Default,,0,0,0,,Сен қазір менен әлдеқайда төменсің.
Dialogue: 0,0:22:22.67,0:22:23.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:23.55,0:22:25.13,Default,,0,0,0,,Капитан Укитаке!
Dialogue: 0,0:22:27.55,0:22:29.09,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:22:29.97,0:22:32.55,Default,,0,0,0,,Сіздің рөліңіз аяқталды.
Dialogue: 0,0:22:33.51,0:22:37.06,Default,,0,0,0,,Квинси патшасы әлемді қайтарып алады
Dialogue: 0,0:22:37.64,0:22:40.19,Default,,0,0,0,,Және әлемді жасаңыз
Dialogue: 0,0:22:41.15,0:22:45.78,Default,,0,0,0,,үшінңызға ұсыныңыз
Dialogue: 0,0:23:02.92,0:23:05.55,Default,,0,0,0,,Рух патшасынан бәрін алыңыз
Dialogue: 0,0:23:08.22,0:23:12.64,Default,,0,0,0,,Дүниені қалай болса солай қайтарамын!
Dialogue: 0,0:23:37.33,0:23:39.66,Default,,0,0,0,,Әлсіздікті білмейтіндер
Dialogue: 0,0:23:40.33,0:23:42.58,Default,,0,0,0,,Шашырап, аспанға қара
Dialogue: 0,0:23:43.46,0:23:45.75,Default,,0,0,0,,Мен патшаның ұйқысын бұзғанша
Dialogue: 0,0:23:46.25,0:23:49.59,Default,,0,0,0,,Кіретін ештеңе жоқ аспан
Dialogue: 0,0:23:51.09,0:23:57.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
