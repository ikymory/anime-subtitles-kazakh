Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.71,0:00:08.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:08.50,0:00:11.42,Default,,0,0,0,,Бір бөтелке жеткілікті ме? Неліктен?
Dialogue: 0,0:00:12.38,0:00:15.39,Default,,0,0,0,,Екіншісін қалдырыңыз.
Dialogue: 0,0:00:19.18,0:00:22.48,Default,,0,0,0,,Қиялы бағыну кезінде қасымда болмасаң да
Dialogue: 0,0:00:22.98,0:00:26.98,Default,,0,0,0,,Бір нәрсенің болуы мені ынталандырады
Dialogue: 0,0:00:31.82,0:00:34.24,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:00:35.53,0:00:36.91,Default,,0,0,0,,Ау!
Dialogue: 0,0:00:36.99,0:00:37.95,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:00:38.66,0:00:41.75,Default,,0,0,0,,Үйге барып оқу керек, ақымақ!
Dialogue: 0,0:00:41.83,0:00:45.67,Default,,0,0,0,,Хехехехехехехехе
Dialogue: 0,0:00:49.25,0:00:51.67,Default,,0,0,0,,Үлкен аға, допқа айналып кеттің ғой.
Dialogue: 0,0:00:51.76,0:00:52.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:53.17,0:00:54.80,Default,,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:00:55.72,0:00:58.89,Default,,0,0,0,,Мен бұралып қалғандай көрінсем
Dialogue: 0,0:00:59.39,0:01:03.10,Default,,0,0,0,,Мейірімділігі осыдан болса керек.
Dialogue: 0,0:01:15.49,0:01:16.61,Default,,0,0,0,,Гүлдер
Dialogue: 0,0:01:17.41,0:01:18.49,Default,,0,0,0,,Мен...
Dialogue: 0,0:01:25.50,0:01:27.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:52.96,0:02:54.96,Default,,0,0,0,,～♪
Dialogue: 0,0:02:56.67,0:02:59.22,Default,,0,0,0,,Шунсуй-сан, өтінемін, тұршы.
Dialogue: 0,0:03:02.39,0:03:04.39,Default,,0,0,0,,Эй, оян.
Dialogue: 0,0:03:05.31,0:03:06.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:10.64,0:03:11.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:13.06,0:03:15.36,Default,,0,0,0,,Қайырлы таң қайын апа
Dialogue: 0,0:03:25.12,0:03:26.91,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:03:27.70,0:03:29.62,Default,,0,0,0,,Мен айттым ғой!
Dialogue: 0,0:03:30.46,0:03:37.00,Default,,0,0,0,,Құдайдың елшісі Шинигамидің Банкайындай адамды өлтіре алмайды деп ойлаймын!
Dialogue: 0,0:03:37.50,0:03:40.72,Default,,0,0,0,,Уууу!
Dialogue: 0,0:03:41.72,0:03:43.22,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:03:43.72,0:03:47.31,Default,,0,0,0,,Басыңды кессең де өлмейді деп ойламаппын.
Dialogue: 0,0:03:49.14,0:03:52.14,Default,,0,0,0,,Кешіріңіз... Рахмет.
Dialogue: 0,0:03:53.31,0:03:56.73,Default,,0,0,0,,Фу~фу~фу~
Dialogue: 0,0:03:58.48,0:03:59.48,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:00.15,0:04:03.99,Default,,0,0,0,,Бұл — үмітсіздік Шунсуй Кйораку
Dialogue: 0,0:04:04.74,0:04:06.28,Default,,0,0,0,,Қару сізді өлтірмейді
Dialogue: 0,0:04:06.37,0:04:09.70,Default,,0,0,0,,Реяцумен басыңнан айырылсаң да, бәрібір өлмейсің.
Dialogue: 0,0:04:10.29,0:04:14.50,Default,,0,0,0,,Күнәкар адам көргенде үміті үзіледі.
Dialogue: 0,0:04:15.29,0:04:18.34,Default,,0,0,0,,Мен өлмейтінмін, жеңілмейтінмін
Dialogue: 0,0:04:18.84,0:04:22.13,Default,,0,0,0,,Мен Құдайдың артықшылықты елшісімін
Dialogue: 0,0:04:22.22,0:04:24.80,Default,,0,0,0,,Барлық күнәкар адамдар
Dialogue: 0,0:04:24.88,0:04:28.39,Default,,0,0,0,,Сол Алла елшісінің алдында менің қолымнан ештеңе келмейді!
Dialogue: 0,0:04:43.99,0:04:44.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:45.70,0:04:47.32,Default,,0,0,0,,Сол мұнараның артында?
Dialogue: 0,0:04:47.82,0:04:52.45,Default,,0,0,0,,Менің үкімімнің нұрынан құтылуға әлі де күшіңіз бар ма?
Dialogue: 0,0:04:52.95,0:04:58.38,Default,,0,0,0,,Сол қара қарын таза нұрмен ойып шығарса да
Dialogue: 0,0:04:58.96,0:05:01.63,Default,,0,0,0,,Бас қолбасшы күткендей.
Dialogue: 0,0:05:02.13,0:05:04.01,Default,,0,0,0,,Бұл күнә
Dialogue: 0,0:05:04.09,0:05:07.51,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:05:09.05,0:05:10.39,Default,,0,0,0,,Созоса
Dialogue: 0,0:05:13.56,0:05:14.60,Default,,0,0,0,,Қашайық
Dialogue: 0,0:05:15.10,0:05:17.77,Default,,0,0,0,,Каремацу - жүрек талмасынан өлмейтін адам.
Dialogue: 0,0:05:18.27,0:05:20.77,Default,,0,0,0,,Мен енді ештеңе істей алмаймын
Dialogue: 0,0:05:21.52,0:05:23.65,Default,,0,0,0,,Иеміз жеткілікті түрде күресті
Dialogue: 0,0:05:24.15,0:05:26.61,Default,,0,0,0,,Есім мен тынысым кеткенше.
Dialogue: 0,0:05:27.99,0:05:31.49,Default,,0,0,0,,Бұл жерден қашып кетсе, Жаратқан Иені ешкім айыптамайды.
Dialogue: 0,0:05:32.20,0:05:35.00,Default,,0,0,0,,Енді ұйықтап алайық.
Dialogue: 0,0:05:35.66,0:05:38.33,Default,,0,0,0,,Осы арада мен сені көтеріп алып қашамын.
Dialogue: 0,0:05:44.55,0:05:47.09,Default,,0,0,0,,Шунсуй-сан, өтінемін, тұршы.
Dialogue: 0,0:05:48.13,0:05:49.39,Default,,0,0,0,,Ояныңыз
Dialogue: 0,0:05:50.26,0:05:53.18,Default,,0,0,0,,Ояныңыз, капитан!
Dialogue: 0,0:05:54.60,0:05:55.93,Default,,0,0,0,,Нанао-чан...
Dialogue: 0,0:05:56.93,0:05:59.10,Default,,0,0,0,,Жақсы нәрсе, мен ұстандым...
Dialogue: 0,0:06:00.27,0:06:01.61,Default,,0,0,0,,Сөйлесудің қажеті жоқ
Dialogue: 0,0:06:01.69,0:06:04.11,Default,,0,0,0,,Өтінемін, менің Занпакутоны шығарыңыз!
Dialogue: 0,0:06:06.94,0:06:09.78,Default,,0,0,0,,Жоғалуға уақыт жоқ. Асығыңыз!
Dialogue: 0,0:06:11.49,0:06:14.79,Default,,0,0,0,,Анаңа берген уәдеңді әзірге ұмыт!
Dialogue: 0,0:06:16.54,0:06:17.50,Default,,0,0,0,,Не?
Dialogue: 0,0:06:17.58,0:06:18.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:18.41,0:06:22.63,Default,,0,0,0,,Мен шу шығар деп ойладым, бірақ көмекші қайтып келді.
Dialogue: 0,0:06:22.71,0:06:28.63,Default,,0,0,0,,Капитан маған қашуға көмектессе де, сен өмірдің қадірін білмейсің.
Dialogue: 0,0:06:29.22,0:06:30.97,Default,,0,0,0,,Бұл күнә
Dialogue: 0,0:06:32.01,0:06:33.01,Default,,0,0,0,,ақылсыз
Dialogue: 0,0:06:37.35,0:06:39.10,Default,,0,0,0,,Сіз тағы да қашып кеттіңіз.
Dialogue: 0,0:06:39.19,0:06:43.48,Default,,0,0,0,,А... көзім құрғап қалды.
Dialogue: 0,0:06:43.56,0:06:49.15,Default,,0,0,0,,Күнәһарларға қарай берсем, көзім құрғайды!
Dialogue: 0,0:06:57.54,0:07:00.87,Default,,0,0,0,,Менің ойымша, сіз өз анаңызды байқадыңыз.
Dialogue: 0,0:07:02.50,0:07:03.21,Default,,0,0,0,,Иә
Dialogue: 0,0:07:04.46,0:07:05.75,Default,,0,0,0,,Мәңгі ме?
Dialogue: 0,0:07:06.71,0:07:07.46,Default,,0,0,0,,Иә
Dialogue: 0,0:07:08.84,0:07:12.51,Default,,0,0,0,,Амал жоқ...
Dialogue: 0,0:07:14.35,0:07:17.18,Default,,0,0,0,,Мен көмектесе алмаймын, мен оны қайтарамын.
Dialogue: 0,0:07:18.47,0:07:21.44,Default,,0,0,0,,Бұл сіздің Zanpakutou «Кьюкоцу»
Dialogue: 0,0:07:29.11,0:07:32.07,Default,,0,0,0,,Ол жоғалып кетті... Қайда тығылды?
Dialogue: 0,0:07:43.62,0:07:45.33,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:07:46.92,0:07:48.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:48.09,0:07:53.63,Default,,0,0,0,,Көлеңкелі жын осыншама уақыт көлеңкеде тұра ала ма?
Dialogue: 0,0:07:53.72,0:07:55.18,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:07:58.47,0:08:02.94,Default,,0,0,0,,Жердегі көлеңкені осылай өшірсек не болады?
Dialogue: 0,0:08:12.24,0:08:13.36,Default,,0,0,0,,Ақылсыз сүйектер?
Dialogue: 0,0:08:13.99,0:08:16.32,Default,,0,0,0,,Не... нені айтып тұрсыз?
Dialogue: 0,0:08:16.41,0:08:19.70,Default,,0,0,0,,Ханатен Киокотсудың Ханатен және Киокоцу болып екіге бөлінуі мынада.
Dialogue: 0,0:08:19.79,0:08:21.12,Default,,0,0,0,,Мен мұны білдім
Dialogue: 0,0:08:21.83,0:08:24.46,Default,,0,0,0,,Жынды сүйектер... менің Занпакутоым?
Dialogue: 0,0:08:24.96,0:08:26.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:26.63,0:08:30.13,Default,,0,0,0,,...Олай десем, сәл басқаша.
Dialogue: 0,0:08:30.84,0:08:36.59,Default,,0,0,0,,Бірақ Гүл Нанао-чанның Занпакутоны жасыру үшін жындыны дүниеге әкелді.
Dialogue: 0,0:08:37.09,0:08:39.39,Default,,0,0,0,,Нанаоның анасының өтініші бойынша.
Dialogue: 0,0:08:40.26,0:08:43.39,Default,,0,0,0,,Бұл... неге?
Dialogue: 0,0:08:45.39,0:08:48.15,Default,,0,0,0,,Исе тұқымдасы әйел текті.
Dialogue: 0,0:08:48.23,0:08:51.65,Default,,0,0,0,,Жазбаларға келетін болсақ, тек әйелдер туылған.
Dialogue: 0,0:08:51.73,0:08:55.20,Default,,0,0,0,,Сондықтан мен сырттан күйеу бала алдым.
Dialogue: 0,0:08:55.70,0:08:58.12,Default,,0,0,0,,Исе отбасына кірген әрбір ер адам
Dialogue: 0,0:08:58.20,0:09:01.24,Default,,0,0,0,,Исенің қарғысы ерте өлімге себепші болады деп айтылды.
Dialogue: 0,0:09:01.74,0:09:05.12,Default,,0,0,0,,Кейбіреулер мұны қарғыс деп санайды.
Dialogue: 0,0:09:05.62,0:09:07.79,Default,,0,0,0,,Ол олай ойламады.
Dialogue: 0,0:09:08.54,0:09:10.84,Default,,0,0,0,,Сол дәстүрді бұзғым келеді.
Dialogue: 0,0:09:11.34,0:09:14.92,Default,,0,0,0,,Мен Исе қандастығын тоқтатуға бел буып, сыртта үйлендім.
Dialogue: 0,0:09:15.63,0:09:20.26,Default,,0,0,0,,Бірақ ақырында оның күйеуі де көп ұзамай қайтыс болды.
Dialogue: 0,0:09:21.51,0:09:25.94,Default,,0,0,0,,Ол менің ағамның әйелі болатын.
Dialogue: 0,0:09:26.02,0:09:27.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:28.10,0:09:31.02,Default,,0,0,0,,Мен ағаммен тіл табыса алмадым.
Dialogue: 0,0:09:31.52,0:09:34.28,Default,,0,0,0,,Ол келгеннен бері атмосфера өзгерді.
Dialogue: 0,0:09:35.11,0:09:38.61,Default,,0,0,0,,Ағамның үйі әлдеқайда ыңғайлы болды.
Dialogue: 0,0:09:39.12,0:09:41.78,Default,,0,0,0,,Мен ойынға жиі шығамын.
Dialogue: 0,0:09:42.29,0:09:44.37,Default,,0,0,0,,Мен подъезде ұйықтап жатқанмын.
Dialogue: 0,0:09:48.71,0:09:49.79,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:09:50.50,0:09:51.96,Default,,0,0,0,,Менің ағам қайтыс болды
Dialogue: 0,0:09:54.21,0:09:56.97,Default,,0,0,0,,Оны Иседегі үйіне қайтарды.
Dialogue: 0,0:09:57.47,0:09:59.97,Default,,0,0,0,,Бұл асыл үйлерде жиі кездеседі.
Dialogue: 0,0:10:00.80,0:10:04.89,Default,,0,0,0,,Иә, ол шешім қабылдап, үйін тастап кетуі керек еді.
Dialogue: 0,0:10:04.97,0:10:07.77,Default,,0,0,0,,Ақырында үйден қашып құтыла алмадым.
Dialogue: 0,0:10:12.02,0:10:14.03,Default,,0,0,0,,Әйтеуір, Иседен келген әйел
Dialogue: 0,0:10:14.53,0:10:18.99,Default,,0,0,0,,Исенің үйінен де, Исенің қарғысынан да қашып құтыла алмайсың.
Dialogue: 0,0:10:20.45,0:10:22.20,Default,,0,0,0,,Мүмкін солай шығар
Dialogue: 0,0:10:22.28,0:10:25.29,Default,,0,0,0,,Бұл қылыштың кесірінен шығар.
Dialogue: 0,0:10:26.04,0:10:29.75,Default,,0,0,0,,Ол құрсағындағы қызына қамқор болады.
Dialogue: 0,0:10:29.83,0:10:32.42,Default,,0,0,0,,Қарғыстан құтылуға тырыстым.
Dialogue: 0,0:10:32.92,0:10:35.34,Default,,0,0,0,,Мен ол қылышты сенің қолыңда ұстаймын.
Dialogue: 0,0:10:35.84,0:10:39.26,Default,,0,0,0,,Жасырынбақ ойнағанды ​​ұнататын жынды адам оны маған жасырып қойды.
Dialogue: 0,0:10:52.23,0:10:56.03,Default,,0,0,0,,Сен осындай кішкентай көлеңкеден шыға аласың ба?
Dialogue: 0,0:10:58.24,0:10:59.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:01.57,0:11:02.82,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:11:03.57,0:11:06.79,Default,,0,0,0,,Капитан бұл қылышты маған бергісі келмейді.
Dialogue: 0,0:11:08.08,0:11:10.21,Default,,0,0,0,,Мен үшін бе?
Dialogue: 0,0:11:12.96,0:11:16.09,Default,,0,0,0,,Анам қарғысты өз еркімен тастауды шешкендей.
Dialogue: 0,0:11:17.34,0:11:21.34,Default,,0,0,0,,Мен де өз еркіммен қарғыс айтуды шештім.
Dialogue: 0,0:11:23.68,0:11:24.60,Default,,0,0,0,,Және...
Dialogue: 0,0:11:25.35,0:11:27.14,Default,,0,0,0,,Мен қарғысқа ұшырасам
Dialogue: 0,0:11:27.85,0:11:29.18,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:11:31.39,0:11:32.35,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:33.69,0:11:36.02,Default,,0,0,0,,Мен жақсы көретін адам, әрине
Dialogue: 0,0:11:36.52,0:11:38.73,Default,,0,0,0,,«Қарғыс айту ақымақтық».
Dialogue: 0,0:11:39.24,0:11:42.70,Default,,0,0,0,,Бұған біреу күлетін сияқты.
Dialogue: 0,0:11:47.91,0:11:50.54,Default,,0,0,0,,Жарайды, мен саған беремін.
Dialogue: 0,0:11:52.25,0:11:54.17,Default,,0,0,0,,Мен бұл қылышқа сенімдімін ...
Dialogue: 0,0:12:02.01,0:12:06.55,Default,,0,0,0,,О? Мұқият қарасаңыз, жалғыз лейтенант шықты.
Dialogue: 0,0:12:07.14,0:12:10.81,Default,,0,0,0,,Сіз тек лейтенантыңызбен менімен соғыспақшысыз ба?
Dialogue: 0,0:12:11.48,0:12:14.35,Default,,0,0,0,,Исе әулеті — діни қызметкерлер отбасы.
Dialogue: 0,0:12:14.85,0:12:18.90,Default,,0,0,0,,Фестивальдарға жауапты, жеке Занпакутосы жоқ
Dialogue: 0,0:12:18.98,0:12:22.70,Default,,0,0,0,,Отағасы ұрпақтан ұрпаққа бір Занпакутоны мұра етеді.
Dialogue: 0,0:12:23.70,0:12:27.20,Default,,0,0,0,,Бұл салт-дәстүрлерде қолданылатын жүзсіз қылыш.
Dialogue: 0,0:12:27.70,0:12:30.62,Default,,0,0,0,,Ол қылышпен біреуді шауып тастай алмайсың.
Dialogue: 0,0:12:31.25,0:12:34.96,Default,,0,0,0,,Құдайға қарсы тұрыңыз және Оның күшін алыңыз
Dialogue: 0,0:12:35.46,0:12:38.34,Default,,0,0,0,,Әр жаққа тарайтын құдіреті бар дейді.
Dialogue: 0,0:12:40.21,0:12:41.26,Default,,0,0,0,,Аты...
Dialogue: 0,0:12:42.30,0:12:45.13,Default,,0,0,0,,«Құдайдың қылыш/сегіз айна қылыш»
Dialogue: 0,0:12:46.93,0:12:50.22,Default,,0,0,0,,Иә? Бұл не қылыш?
Dialogue: 0,0:12:50.81,0:12:54.19,Default,,0,0,0,,Бұл өте дөрекі, жарқыраған қылыш.
Dialogue: 0,0:12:54.89,0:12:57.69,Default,,0,0,0,,Оның жарқырағандығы сонша, мен жүзді де көрмеймін
Dialogue: 0,0:12:58.27,0:12:59.94,Default,,0,0,0,,Бұл көз ауыртады.
Dialogue: 0,0:13:00.52,0:13:02.82,Default,,0,0,0,,Мен көремін. Жақсы.
Dialogue: 0,0:13:02.90,0:13:03.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:03.99,0:13:08.57,Default,,0,0,0,,Бұл қылыш Құдайға қарсы тұратын және Құдайдың құдіретін көрсететін қылыш.
Dialogue: 0,0:13:09.24,0:13:11.41,Default,,0,0,0,,Көзіңе жарқырап тұрса
Dialogue: 0,0:13:11.91,0:13:16.83,Default,,0,0,0,,Бұл сіз шығарған илаһи нұрды шағылыстырып жатқаныңызды білдіреді.
Dialogue: 0,0:13:16.92,0:13:18.88,Default,,0,0,0,,Хмм?
Dialogue: 0,0:13:18.96,0:13:22.05,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:13:22.13,0:13:25.22,Default,,0,0,0,,Құдай деп атағаныма ренжімеймін.
Dialogue: 0,0:13:29.93,0:13:32.81,Default,,0,0,0,,Мен сізге соншалықты маңызды нәрсе бере алмаймын.
Dialogue: 0,0:13:32.89,0:13:36.69,Default,,0,0,0,,Бұл тек Исе тұрғындарына әсер етеді.
Dialogue: 0,0:13:37.19,0:13:41.57,Default,,0,0,0,,Бұл сізге бақытсыздық әкелмейді.
Dialogue: 0,0:13:41.65,0:13:42.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:43.03,0:13:44.15,Default,,0,0,0,,Ise...
Dialogue: 0,0:13:44.65,0:13:47.82,Default,,0,0,0,,Менің үйімнен тыс жалғыз адам сенесің.
Dialogue: 0,0:13:48.41,0:13:49.78,Default,,0,0,0,,Неге мұны әкелдің?
Dialogue: 0,0:13:50.66,0:13:53.99,Default,,0,0,0,,Бірінші байқағаным шаш қыстырғышы болды.
Dialogue: 0,0:13:56.54,0:14:01.25,Default,,0,0,0,,Қараңызшы, бұл адам Готей 13 капитаны сияқты.
Dialogue: 0,0:14:01.75,0:14:03.88,Default,,0,0,0,,Адамның арқасында
Dialogue: 0,0:14:03.96,0:14:07.01,Default,,0,0,0,,Онда көзге көрінетін әйелдер кимоносы ілулі тұрған.
Dialogue: 0,0:14:08.01,0:14:10.05,Default,,0,0,0,,Үлгі әдеттегідей
Dialogue: 0,0:14:10.14,0:14:14.97,Default,,0,0,0,,Мен анамда осындай нәрсе бар деп ойладым.
Dialogue: 0,0:14:15.93,0:14:18.19,Default,,0,0,0,,Бірақ тек шаш қыстырғышы
Dialogue: 0,0:14:18.81,0:14:22.31,Default,,0,0,0,,Анамдікіне ұқсайтын сияқты.
Dialogue: 0,0:14:22.82,0:14:25.69,Default,,0,0,0,,О! Сіз бірінші командасыз ба?
Dialogue: 0,0:14:25.78,0:14:26.99,Default,,0,0,0,,Керемет
Dialogue: 0,0:14:27.07,0:14:28.86,Default,,0,0,0,,Иә! мен бесінші отряд
Dialogue: 0,0:14:28.95,0:14:31.20,Default,,0,0,0,,Вице-капитан Эйзен жақсы, солай емес пе?
Dialogue: 0,0:14:31.28,0:14:34.49,Default,,0,0,0,,Бірақ сол жақтағы капитан біртүрлі екен. Оның шашы ұзын.
Dialogue: 0,0:14:34.58,0:14:36.54,Default,,0,0,0,,Бұл сіздің хоббиіңіз туралы.
Dialogue: 0,0:14:36.62,0:14:37.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:38.54,0:14:40.21,Default,,0,0,0,,Сегізінші отряд?
Dialogue: 0,0:14:41.63,0:14:42.88,Default,,0,0,0,,Анасы қайтыс болғаннан кейін
Dialogue: 0,0:14:43.38,0:14:47.84,Default,,0,0,0,,Мені Иседен туысқанбыз деп, белгісіз қарт ерлі-зайыптылар қабылдады.
Dialogue: 0,0:14:48.42,0:14:51.43,Default,,0,0,0,,Олар мені қызындай жақсы көреді
Dialogue: 0,0:14:51.51,0:14:55.97,Default,,0,0,0,,Ол Готей 13 корпусына тағайындалғанына шынымен қуанышты болды.
Dialogue: 0,0:14:57.02,0:14:59.52,Default,,0,0,0,,Мен Мао рухани академиясына түстім
Dialogue: 0,0:14:59.60,0:15:01.35,Default,,0,0,0,,Таяз штрих берілген
Dialogue: 0,0:15:01.44,0:15:04.06,Default,,0,0,0,,Мен оны өзім жасай алмадым, бірақ...
Dialogue: 0,0:15:06.03,0:15:07.86,Default,,0,0,0,,Кидодағы дарындылығымен танылды
Dialogue: 0,0:15:07.94,0:15:11.53,Default,,0,0,0,,Мен әскерге қабылдау емтиханын ерте тапсыра алдым.
Dialogue: 0,0:15:12.11,0:15:14.16,Default,,0,0,0,,Менде Занпакуто жоқ
Dialogue: 0,0:15:14.24,0:15:16.37,Default,,0,0,0,,Егер бұл Кидошу болса, мүмкін бірдеңе істеуге болады.
Dialogue: 0,0:15:17.12,0:15:19.12,Default,,0,0,0,,Мен тапсырмаға өтініш бердім.
Dialogue: 0,0:15:19.87,0:15:23.29,Default,,0,0,0,,Белгілі бір себептермен мені 8-ші бөлімге тағайындады.
Dialogue: 0,0:15:23.88,0:15:28.05,Default,,0,0,0,,Сәлеметсіз бе, мен капитан Шунсуй Кёракумын.
Dialogue: 0,0:15:28.13,0:15:29.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:29.51,0:15:33.22,Default,,0,0,0,,Мен қыздарға мейірімдімін, уайымдама.
Dialogue: 0,0:15:33.72,0:15:35.76,Default,,0,0,0,,Ұл балаға бұл жеткілікті.
Dialogue: 0,0:15:35.85,0:15:37.35,Default,,0,0,0,,Иә~
Dialogue: 0,0:15:37.43,0:15:41.73,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:15:42.39,0:15:43.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:43.56,0:15:46.52,Default,,0,0,0,,Мен 8-ші отрядқа кіргеннен кейін сені көрдім.
Dialogue: 0,0:15:46.61,0:15:50.49,Default,,0,0,0,,Кимоносын ауыстырып, шаш қыстырғышын алды.
Dialogue: 0,0:15:50.99,0:15:53.45,Default,,0,0,0,,Сол кезде көзім жетті.
Dialogue: 0,0:15:54.74,0:15:57.03,Default,,0,0,0,,Қарасам, бұл адам.
Dialogue: 0,0:15:57.74,0:16:00.96,Default,,0,0,0,,Сол кезде анам маған бір маңызды нәрсені сеніп тапсырды.
Dialogue: 0,0:16:01.04,0:16:02.58,Default,,0,0,0,,Бұл адам болды.
Dialogue: 0,0:16:04.83,0:16:07.75,Default,,0,0,0,,Сен мені сол қылышпен шауып алмақсың ба?
Dialogue: 0,0:16:07.84,0:16:08.84,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:16:09.51,0:16:11.17,Default,,0,0,0,,Жақсы, кесіп көріңіз.
Dialogue: 0,0:16:11.76,0:16:14.76,Default,,0,0,0,,Мені кесетін қылыш жоқ...
Dialogue: 0,0:16:19.35,0:16:22.56,Default,,0,0,0,,Алдын алды! Мен күзетімді түсіруім керек еді.
Dialogue: 0,0:16:25.65,0:16:27.48,Default,,0,0,0,,Хаа~
Dialogue: 0,0:16:27.98,0:16:30.03,Default,,0,0,0,,Жүзі жоқ біртүрлі қылыш
Dialogue: 0,0:16:30.11,0:16:33.24,Default,,0,0,0,,Маған осындай қылышпен шабуыл жасауға қалай дәтің бар?
Dialogue: 0,0:16:33.32,0:16:35.57,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:16:35.66,0:16:38.20,Default,,0,0,0,,Денемді кесіп алу үшін...
Dialogue: 0,0:16:39.12,0:16:41.62,Default,,0,0,0,,Бірақ бұл сіз үшін соңы.
Dialogue: 0,0:16:43.79,0:16:49.00,Default,,0,0,0,,Сен мені дәл қазір бұл соққымен өлтіруің керек еді.
Dialogue: 0,0:16:49.50,0:16:52.92,Default,,0,0,0,,Құдайдың елшісі ешқашан сақтығын екінші рет түсірмейді!
Dialogue: 0,0:16:56.72,0:16:59.68,Default,,0,0,0,,Мен кінәлі деп ойладым...
Dialogue: 0,0:17:01.77,0:17:02.64,Default,,0,0,0,,Орындалу?
Dialogue: 0,0:17:02.73,0:17:03.93,Default,,0,0,0,,О
Dialogue: 0,0:17:04.02,0:17:08.56,Default,,0,0,0,,Қасиетті қазынадан айырылғаны үшін оны 46-бөлме сотқа әкелсе керек.
Dialogue: 0,0:17:09.19,0:17:11.61,Default,,0,0,0,,Өлім жазасын кеше орындаған сияқты.
Dialogue: 0,0:17:13.61,0:17:16.91,Default,,0,0,0,,Кешіріңіз, айтпағаныңыз жөн болар.
Dialogue: 0,0:17:16.99,0:17:20.03,Default,,0,0,0,,Ерте естігеніме қуаныштымын.
Dialogue: 0,0:17:20.53,0:17:21.54,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:24.79,0:17:26.04,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,0:17:30.54,0:17:31.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:37.43,0:17:42.06,Default,,0,0,0,,Әркім маған ең маңызды нәрсені сеніп тапсырып, дүниеден өтеді.
Dialogue: 0,0:17:43.27,0:17:45.73,Default,,0,0,0,,Ауыр нәрселерді ұнатпасам да.
Dialogue: 0,0:17:50.86,0:17:53.32,Default,,0,0,0,,Нанао-чан, мен.
Dialogue: 0,0:17:53.90,0:17:57.40,Default,,0,0,0,,Сол қылышты қайтадан ұстауға мәжбүр болғаныма өкінемін.
Dialogue: 0,0:17:59.07,0:18:02.99,Default,,0,0,0,,Нанао-чан, менің иығымды жеңілдетіңізші.
Dialogue: 0,0:18:05.58,0:18:09.00,Default,,0,0,0,,Мен сізді қорғауға рұқсат етіңіз
Dialogue: 0,0:18:13.84,0:18:16.17,Default,,0,0,0,,Кеттік, Нанао-чан
Dialogue: 0,0:18:25.60,0:18:26.39,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:26.48,0:18:28.31,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:18:33.19,0:18:34.73,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:18:36.86,0:18:39.24,Default,,0,0,0,,Қолына қылыш алып, соғысу
Dialogue: 0,0:18:40.16,0:18:42.07,Default,,0,0,0,,Мен оның соншалықты қорқынышты екеніне сене алмаймын
Dialogue: 0,0:18:44.45,0:18:45.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:47.45,0:18:50.50,Default,,0,0,0,,Мені... жаңа ғана жарылған жарық?
Dialogue: 0,0:18:51.50,0:18:56.00,Default,,0,0,0,,Ауырды... Кесілгені сонша.
Dialogue: 0,0:18:56.80,0:18:57.92,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:19:00.47,0:19:01.51,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:19:04.93,0:19:07.52,Default,,0,0,0,,Менің аяғым... қозғалмайды.
Dialogue: 0,0:19:13.15,0:19:13.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:17.99,0:19:19.36,Default,,0,0,0,,Капитан...
Dialogue: 0,0:19:28.87,0:19:29.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:33.83,0:19:35.42,Default,,0,0,0,,Ол шықты ма?
Dialogue: 0,0:19:36.00,0:19:37.38,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:19:37.46,0:19:40.42,Default,,0,0,0,,Қол астындағылардың артына қалай тығыла аласыз?
Dialogue: 0,0:19:40.51,0:19:42.68,Default,,0,0,0,,Нашар капитан
Dialogue: 0,0:19:43.18,0:19:45.30,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:19:48.52,0:19:51.19,Default,,0,0,0,,Құдайдың әнін тыңда және өл
Dialogue: 0,0:19:54.27,0:19:56.57,Default,,0,0,0,,Кеттік, Нанао-чан
Dialogue: 0,0:19:58.53,0:20:02.20,Default,,0,0,0,,Уайымдама, мен сені артыңнан қолдаймын.
Dialogue: 0,0:20:04.74,0:20:08.91,Default,,0,0,0,,А... Мен капитанның мейіріміне бөленгендей болып тұрмын.
Dialogue: 0,0:20:10.37,0:20:13.21,Default,,0,0,0,,Мен капитанды қолдаймын деген ниетпен қайттым.
Dialogue: 0,0:20:14.21,0:20:17.54,Default,,0,0,0,,Ақырында, мен қолдаймын.
Dialogue: 0,0:20:19.05,0:20:21.51,Default,,0,0,0,,Мен өзім де тұра алмаймын
Dialogue: 0,0:20:21.59,0:20:24.05,Default,,0,0,0,,Капитан мені үнемі қолдайды.
Dialogue: 0,0:20:29.56,0:20:31.10,Default,,0,0,0,,(тромпет дыбысы)
Dialogue: 0,0:20:31.18,0:20:32.60,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:39.40,0:20:40.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:52.08,0:20:54.00,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:20:55.04,0:21:00.75,Default,,0,0,0,,Құдайдың құдіретін қайтарады деді.
Dialogue: 0,0:21:01.25,0:21:02.67,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:03.17,0:21:06.80,Default,,0,0,0,,Құдайдың құдіретін тойтару үшін?
Dialogue: 0,0:21:07.30,0:21:08.80,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:21:09.30,0:21:10.18,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:10.26,0:21:11.93,Default,,0,0,0,,Бұл күнә
Dialogue: 0,0:21:29.28,0:21:30.24,Default,,0,0,0,,О...
Dialogue: 0,0:21:32.24,0:21:35.79,Default,,0,0,0,,Сен керемет жұмыс жасадың, Нанао-чан
Dialogue: 0,0:21:37.96,0:21:39.17,Default,,0,0,0,,Капитан...
Dialogue: 0,0:21:40.25,0:21:41.96,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:21:43.76,0:21:45.88,Default,,0,0,0,,Барлығын қуып шығамыз ба?
Dialogue: 0,0:21:46.63,0:21:47.80,Default,,0,0,0,,Және... және...
Dialogue: 0,0:21:48.68,0:21:49.47,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:21:50.80,0:21:52.10,Default,,0,0,0,,Хаа…
Dialogue: 0,0:21:53.14,0:21:54.22,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:22:00.19,0:22:04.53,Default,,0,0,0,,Бір дем алайық, сосын...
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.74,0:23:33.74,Default,,0,0,0,,～♪
Dialogue: 0,0:23:38.12,0:23:42.75,Default,,0,0,0,,Оқ, тырнақ, әскери штандар, қылыш,
Dialogue: 0,0:23:43.25,0:23:44.88,Default,,0,0,0,,Бес саусақ
Dialogue: 0,0:23:45.38,0:23:47.13,Default,,0,0,0,,Сізді күтуде
Dialogue: 0,0:23:48.63,0:23:54.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
