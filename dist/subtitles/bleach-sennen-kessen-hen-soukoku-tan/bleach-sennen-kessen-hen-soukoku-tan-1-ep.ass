Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:45.00,0:01:49.00,Default,,0,0,0,,Мен сізге Zero Squad қаншалықты маңызды екенін көрсетемін.
Dialogue: 0,0:01:52.34,0:01:54.34,Default,,0,0,0,,Суицид! ?
Dialogue: 0,0:01:54.34,0:02:08.96,Default,,0,0,0,,♪～
Dialogue: 0,0:02:08.96,0:02:13.63,Default,,0,0,0,,Төртеуміз де ештеңе істей алмасақ, жалғыз не істей аламыз?
Dialogue: 0,0:02:13.63,0:02:16.63,Default,,0,0,0,,Біздің қабілеттеріміз жеңгеңді бұлғау ғана➡
Dialogue: 0,0:02:16.63,0:02:19.47,Default,,0,0,0,,Аспан мен жердің үш әлемін тербетеді.
Dialogue: 0,0:02:19.47,0:02:23.31,Default,,0,0,0,,Сондықтан біздің өміріміз бір-бірімен байланысты➡
Dialogue: 0,0:02:23.31,0:02:26.64,Default,,0,0,0,,Нағыз қылыш мөрмен жабылды.
Dialogue: 0,0:02:26.64,0:02:35.65,Default,,0,0,0,,Ал енді үш жанның орнына қанды анттың мөрі шықты.
Dialogue: 0,0:02:35.65,0:02:37.65,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:02:39.66,0:02:41.66,Default,,0,0,0,,Банкай.
Dialogue: 0,0:02:41.66,0:03:10.95,Default,,0,0,0,,♪～
Dialogue: 0,0:03:10.95,0:03:15.12,Default,,0,0,0,,/.
Dialogue: 0,0:03:15.12,0:03:17.13,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:03:17.13,0:03:20.63,Default,,0,0,0,,Бұл реиацу Сенжумару ма? (Йоричи) Менің ойымша, бұл Банкай.
Dialogue: 0,0:03:20.63,0:03:22.63,Default,,0,0,0,,Ба... Банкай! ?
Dialogue: 0,0:03:22.63,0:03:25.13,Default,,0,0,0,,Рейацу осылай, тіпті капитандардың Банкайынан➡
Dialogue: 0,0:03:25.13,0:03:27.97,Default,,0,0,0,,Мен осылай сезіндім! (Орихиме) Куросаки-кун...
Dialogue: 0,0:03:27.97,0:03:32.47,Default,,0,0,0,,Squad Zero адамдары... Ах, Инуэ және басқалары➡
Dialogue: 0,0:03:32.47,0:03:34.64,Default,,0,0,0,,Мен сенімен ешқашан кездескен емеспін.
Dialogue: 0,0:03:34.64,0:03:39.65,Default,,0,0,0,,Занпакуто, бұл киім, жаңа күш...
Dialogue: 0,0:03:39.65,0:03:42.32,Default,,0,0,0,,Мен бәрін Zero Squad-тан үйрендім.
Dialogue: 0,0:03:42.32,0:03:45.65,Default,,0,0,0,,Олардың бәрі стандартсыз адамдар.
Dialogue: 0,0:03:45.65,0:03:50.16,Default,,0,0,0,,Егер сіз сондай ғажайып адамдар болсаңыз, Жою халқынан жеңілмессіз.
Dialogue: 0,0:03:50.16,0:03:53.66,Default,,0,0,0,,Кеттік! Юхабахты және басқаларды осылай жеңе аласыз деп үміттенемін➡
Dialogue: 0,0:03:53.66,0:03:57.37,Default,,0,0,0,,Құттықтаймыз! Құттықтаймыз! Бұл дұрыс...
Dialogue: 0,0:03:59.94,0:04:02.27,Default,,0,0,0,,Тонна….
Dialogue: 0,0:04:02.27,0:04:04.27,Default,,0,0,0,,Тонна.
Dialogue: 0,0:04:04.27,0:04:07.94,Default,,0,0,0,,Қарақарадан… тонна.
Dialogue: 0,0:04:07.94,0:04:09.95,Default,,0,0,0,,және т.б.
Dialogue: 0,0:04:13.78,0:04:17.99,Default,,0,0,0,,Бір миллион көз.
Dialogue: 0,0:04:20.62,0:04:26.29,Default,,0,0,0,,Артқа қадала қарасаң, көзің шалады. Гах...
Dialogue: 0,0:04:26.29,0:04:28.63,Default,,0,0,0,,Екі жақты шешім….
Dialogue: 0,0:04:28.63,0:04:31.97,Default,,0,0,0,,Ойой... Бұл не сұмдық...?
Dialogue: 0,0:04:31.97,0:04:34.27,Default,,0,0,0,,Пышақты сауыт.
Dialogue: 0,0:04:40.31,0:04:42.64,Default,,0,0,0,,Бірге тұрыңыз….
Dialogue: 0,0:04:42.64,0:04:46.31,Default,,0,0,0,,Ештеңе.
Dialogue: 0,0:04:46.31,0:04:49.99,Default,,0,0,0,,Санрей Каба….
Dialogue: 0,0:04:49.99,0:04:52.29,Default,,0,0,0,,Қара құм ішектер.
Dialogue: 0,0:04:54.32,0:04:57.03,Default,,0,0,0,,Қолды жылжытыңыз...
Dialogue: 0,0:05:00.93,0:05:03.23,Default,,0,0,0,,Өлім.
Dialogue: 0,0:05:05.27,0:05:08.94,Default,,0,0,0,,Ширейкаба…. Ха! ?
Dialogue: 0,0:05:08.94,0:05:12.24,Default,,0,0,0,,Бұл қызықсыз қулық. Соқыңыз және кесіңіз...
Dialogue: 0,0:05:14.28,0:05:17.45,Default,,0,0,0,,Мұздатылған төсек жабындары.
Dialogue: 0,0:05:17.45,0:05:19.45,Default,,0,0,0,,Уф… уф….
Dialogue: 0,0:05:19.45,0:05:23.55,Default,,0,0,0,,Кірсең, енді оянбайсың.
Dialogue: 0,0:05:25.95,0:05:29.56,Default,,0,0,0,,Горейкаба Өртенген өріс.
Dialogue: 0,0:05:40.80,0:05:43.00,Default,,0,0,0,,Күлге айналғанша...
Dialogue: 0,0:05:44.97,0:05:47.58,Default,,0,0,0,,Шығу жолы жоқ.
Dialogue: 0,0:05:50.31,0:05:52.98,Default,,0,0,0,,Рокурейкаба….
Dialogue: 0,0:05:52.98,0:05:55.48,Default,,0,0,0,,Қараңғы түннің жұлдызы.
Dialogue: 0,0:06:01.42,0:06:03.93,Default,,0,0,0,,Ұстап алсаң, бітті...
Dialogue: 0,0:06:09.93,0:06:12.77,Default,,0,0,0,,Өлім жұлдызы.
Dialogue: 0,0:06:12.77,0:06:17.27,Default,,0,0,0,,Жаман балалар, асығыңыздар.
Dialogue: 0,0:06:17.27,0:06:24.28,Default,,0,0,0,,Барлығы орнында болса, бұл оны босату мүмкіндігі.
Dialogue: 0,0:06:24.28,0:06:27.98,Default,,0,0,0,,Шиде Рокушоку Убунки.
Dialogue: 0,0:06:41.96,0:06:45.30,Default,,0,0,0,,Менің күшім қара.
Dialogue: 0,0:06:45.30,0:06:49.47,Default,,0,0,0,,Бір әріпті босатқаннан кейін➡
Dialogue: 0,0:06:49.47,0:06:54.98,Default,,0,0,0,,Шинигами және аннигиляция шеберлері, тірі және өлі, бұл маңызды емес➡
Dialogue: 0,0:06:54.98,0:06:59.48,Default,,0,0,0,,Бұл дүниедегі барлық қаралық...
Dialogue: 0,0:06:59.48,0:07:02.28,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,0:07:07.59,0:07:13.26,Default,,0,0,0,,Юхабах... Жоқ, мен бұрын Юхабах едім.
Dialogue: 0,0:07:13.26,0:07:16.26,Default,,0,0,0,,Атын жоғалтудың өзі азапты болуы керек.
Dialogue: 0,0:07:16.26,0:07:19.60,Default,,0,0,0,,Кедейге мен...
Dialogue: 0,0:07:19.60,0:07:22.60,Default,,0,0,0,,Оған ат берейік.
Dialogue: 0,0:07:22.60,0:07:27.61,Default,,0,0,0,,Шинучи Ширахуденің бір кейіпкері.
Dialogue: 0,0:07:27.61,0:07:32.95,Default,,0,0,0,,Қазіргі тілмен айтсақ, Банкай аталар еді.
Dialogue: 0,0:07:32.95,0:07:37.29,Default,,0,0,0,,Дүниеде Банкай туылғаннан көп бұрын➡
Dialogue: 0,0:07:37.29,0:07:41.29,Default,,0,0,0,,Бірінші дамыған Занпакуто.
Dialogue: 0,0:07:41.29,0:07:45.29,Default,,0,0,0,,Бұл қылыш бір таңбамен толтырылған➡
Dialogue: 0,0:07:45.29,0:07:50.30,Default,,0,0,0,,Жаңа есімді ойып жазуға болады.
Dialogue: 0,0:07:50.30,0:07:52.97,Default,,0,0,0,,Ал... өзіңізді қалай сезінесіз?
Dialogue: 0,0:07:52.97,0:07:57.31,Default,,0,0,0,,Бұрын Юхабах болған қара құмырсқа.
Dialogue: 0,0:07:57.31,0:08:01.91,Default,,0,0,0,,Менің күшім енді жерде жорғалап жүрген қара құмырсқамен тең➡
Dialogue: 0,0:08:01.91,0:08:05.58,Default,,0,0,0,,Өмір нәзік және өткінші болды.
Dialogue: 0,0:08:05.58,0:08:09.42,Default,,0,0,0,,Бұл... әзірге...
Dialogue: 0,0:08:09.42,0:08:12.09,Default,,0,0,0,,Иә, бәрі осы.
Dialogue: 0,0:08:12.09,0:08:15.42,Default,,0,0,0,,Осы уақытқа дейін қуат айырмашылығы болды.
Dialogue: 0,0:08:15.42,0:08:19.43,Default,,0,0,0,,Сонымен Оншидің тағдыры аяқталды.
Dialogue: 0,0:08:19.43,0:08:23.43,Default,,0,0,0,,Мен өлтірген Шинигамидің өмірімен танысу➡
Dialogue: 0,0:08:23.43,0:08:27.94,Default,,0,0,0,,Қара құмырсқадай езіліп өл!
Dialogue: 0,0:08:31.44,0:08:35.28,Default,,0,0,0,,Жәндіктер патшасы...
Dialogue: 0,0:08:35.28,0:08:37.28,Default,,0,0,0,,Қоштасу.
Dialogue: 0,0:08:37.28,0:08:51.99,Default,,0,0,0,,♪～
Dialogue: 0,0:09:00.90,0:09:03.41,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:09:03.41,0:09:08.91,Default,,0,0,0,,Мен көзім жұмылғанда соншалықты көп нәрсені көретініме сене алмаймын.
Dialogue: 0,0:09:16.75,0:09:18.75,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:18.75,0:09:23.26,Default,,0,0,0,,Онши... Неге ол әлі өлген жоқ?
Dialogue: 0,0:09:23.26,0:09:25.59,Default,,0,0,0,,Кейіпкерлер күлкілі.
Dialogue: 0,0:09:25.59,0:09:28.93,Default,,0,0,0,,Мөрмен жабылған жоюшы патша➡
Dialogue: 0,0:09:28.93,0:09:32.27,Default,,0,0,0,,900 жылдан кейін жүрек қайта соғады➡
Dialogue: 0,0:09:32.27,0:09:38.44,Default,,0,0,0,,90 жылдан кейін ақыл-ойды қайта жинайсың. 9 жылдан кейін күш-қуатыңызды қайта аласыз.
Dialogue: 0,0:09:38.44,0:09:42.61,Default,,0,0,0,,Ұлы мәртебелі бейбіт уақытта көзін жұмып шайқасты.
Dialogue: 0,0:09:42.61,0:09:46.45,Default,,0,0,0,,Бұл жауды құрметтемеуден жасалған жоқ.
Dialogue: 0,0:09:46.45,0:09:50.45,Default,,0,0,0,,Тоғыз жылдық билік бітпей жатып көзіңді ашсаң➡
Dialogue: 0,0:09:50.45,0:09:53.96,Default,,0,0,0,,Мәртебелі билігі бақылаудан шықты.
Dialogue: 0,0:09:53.96,0:09:56.79,Default,,0,0,0,,Бірақ ұлы мәртебелі қазір көзін ашты.
Dialogue: 0,0:09:56.79,0:09:59.59,Default,,0,0,0,,Биліктің тоғыз жылы аяқталды.
Dialogue: 0,0:10:01.96,0:10:05.63,Default,,0,0,0,,Мәртебелі өзінің шынайы билігін қалпына келтірді.
Dialogue: 0,0:10:05.63,0:10:11.47,Default,,0,0,0,,Мәртебелілердің көзі бұдан былай болатынның бәрін көреді.
Dialogue: 0,0:10:11.47,0:10:13.64,Default,,0,0,0,,Және….
Dialogue: 0,0:10:13.64,0:10:18.65,Default,,0,0,0,,Сіз Ұлы Мәртебені Ол белгілі құдіретпен жеңе алмайсыз.
Dialogue: 0,0:10:18.65,0:10:20.98,Default,,0,0,0,,Қасиетті әріп – А.
Dialogue: 0,0:10:20.98,0:10:25.32,Default,,0,0,0,,Жоюшылардың патшасына лайықты күштің аты...
Dialogue: 0,0:10:25.32,0:10:29.02,Default,,0,0,0,,Құдіреттілік.
Dialogue: 0,0:10:36.00,0:10:38.00,Default,,0,0,0,,О….
Dialogue: 0,0:10:38.00,0:10:42.30,Default,,0,0,0,,Урю Ишида патшаның оянуымен билікке ие болды ма?
Dialogue: 0,0:10:46.67,0:10:52.01,Default,,0,0,0,,Уайымдамаңыз. Ұйқың келмесе, қабақтарыңды тігіп беремін.
Dialogue: 0,0:10:52.01,0:10:55.32,Default,,0,0,0,,Байқап көріңіз. Ол саған жебеден де жылдам жетсе ғой.
Dialogue: 0,0:11:04.29,0:11:06.29,Default,,0,0,0,,Жарық жаңбыр.
Dialogue: 0,0:11:12.80,0:11:15.64,Default,,0,0,0,,Қан шулап жатыр Урю Ишида.
Dialogue: 0,0:11:15.64,0:11:19.64,Default,,0,0,0,,Одан енші алған көк қаным.
Dialogue: 0,0:11:19.64,0:11:23.48,Default,,0,0,0,,Картоп... Жоюшылар нені мұра етеді?
Dialogue: 0,0:11:23.48,0:11:27.98,Default,,0,0,0,,Рух Патшасынан бас тартқандар не қалдырды?
Dialogue: 0,0:11:33.32,0:11:38.63,Default,,0,0,0,,Өлгісі келмейтіндер...Осы жерде қанын жоямыз.
Dialogue: 0,0:11:46.00,0:11:48.00,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:05.62,0:12:09.62,Default,,0,0,0,,Уайымдамаңыз. Варава Маюриден өзгеше➡
Dialogue: 0,0:12:09.62,0:12:13.96,Default,,0,0,0,,Өлгендердің денесін илеудің хоббиі жоқ.
Dialogue: 0,0:12:13.96,0:12:19.30,Default,,0,0,0,,Осы дүниеде тығып қойсам не болды, бекер өлмес пе едім.
Dialogue: 0,0:12:19.30,0:12:22.30,Default,,0,0,0,,Менің ұрысуға себеп бар.
Dialogue: 0,0:12:22.30,0:12:24.61,Default,,0,0,0,,Аз ғана.
Dialogue: 0,0:12:32.31,0:12:35.48,Default,,0,0,0,,Мен неге өлмедім?
Dialogue: 0,0:12:35.48,0:12:39.99,Default,,0,0,0,,Неліктен сенің күшің менен меннен айырылды?
Dialogue: 0,0:12:39.99,0:12:45.66,Default,,0,0,0,,Неліктен жеңілгеніңізді білгіңіз келеді.
Dialogue: 0,0:12:45.66,0:12:48.33,Default,,0,0,0,,Мен жеңілемін бе?
Dialogue: 0,0:12:48.33,0:12:53.00,Default,,0,0,0,,Қара құмырсқаның атын айту арқылы мен өзімді жақсы сезіндім.
Dialogue: 0,0:12:53.00,0:12:57.34,Default,,0,0,0,,Бір кездері Юхабах болған есімсіз адам.
Dialogue: 0,0:12:57.34,0:13:02.44,Default,,0,0,0,,Сен қара болсаң, мені қалай жеңесің?
Dialogue: 0,0:13:02.44,0:13:07.45,Default,,0,0,0,,Білсеңіз де, ұмыттыңыз ба? Барлығы қара...
Dialogue: 0,0:13:07.45,0:13:09.55,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:13:11.62,0:13:17.63,Default,,0,0,0,,♪ «Йоия!»
Dialogue: 0,0:13:17.63,0:13:23.63,Default,,0,0,0,,♪ «Токоями»
Dialogue: 0,0:13:23.63,0:13:29.64,Default,,0,0,0,,♪ «Бір сәт осында кел».
Dialogue: 0,0:13:29.64,0:13:32.97,Default,,0,0,0,,♪ «Бетіңізді бір сәтке көрсетіңіз»
Dialogue: 0,0:13:32.97,0:13:36.31,Default,,0,0,0,,♪ «Барып іш».
Dialogue: 0,0:13:36.31,0:13:42.48,Default,,0,0,0,,♪ «Ішсең, өмірің зымырап өтеді».
Dialogue: 0,0:13:42.48,0:13:45.82,Default,,0,0,0,,♪ «Тіпті өлім жолында»
Dialogue: 0,0:13:45.82,0:13:53.63,Default,,0,0,0,,♪ «Гүлдер гүлдейді».
Dialogue: 0,0:13:55.66,0:13:59.00,Default,,0,0,0,,♪ "Тісбасар қайда? Қара түске боя."
Dialogue: 0,0:13:59.00,0:14:03.60,Default,,0,0,0,,♪ «Оны қараңғы жалынмен сегіз бөлікке бөліңіз».
Dialogue: 0,0:14:03.60,0:14:11.61,Default,,0,0,0,,♪ «Қара қуырып, оңай жейміз».
Dialogue: 0,0:14:11.61,0:14:19.62,Default,,0,0,0,,♪ «Қабір таңбасын орнатып, жегеннен кейін қалған таза ақ сүйектерді жоқтайық».
Dialogue: 0,0:14:19.62,0:14:27.63,Default,,0,0,0,,♪ «Сен енді ешқашан туылмайсың деп үміттенемін».
Dialogue: 0,0:14:27.63,0:14:39.34,Default,,0,0,0,,♪ «Бізге құрбан болма».
Dialogue: 0,0:15:00.60,0:15:03.60,Default,,0,0,0,,Футен Таиссурё.
Dialogue: 0,0:15:03.60,0:15:09.44,Default,,0,0,0,,100 жылдан кейін Soul Society-ден 100 түнді ұрлау арқылы жасалған➡
Dialogue: 0,0:15:09.44,0:15:12.94,Default,,0,0,0,,Оншиді жоқтап жатқан бейіт маркерлер тобы.
Dialogue: 0,0:15:12.94,0:15:19.28,Default,,0,0,0,,Киген қараң да сіңеді, қаның, етің, сүйегің бәрі➡
Dialogue: 0,0:15:19.28,0:15:24.62,Default,,0,0,0,,Оны қара жаншып, жоқтыққа оралу. Тіпті реинкарнацияға жол берілмейді.
Dialogue: 0,0:15:24.62,0:15:27.96,Default,,0,0,0,,Қараңғы тозаққа түсу.
Dialogue: 0,0:15:27.96,0:15:31.96,Default,,0,0,0,,Иә! ? Мен бәрін көремін деп ойладым.
Dialogue: 0,0:15:31.96,0:15:37.97,Default,,0,0,0,,Менің күшім алдында түсінуге немесе қарсы шараларға орын жоқ.
Dialogue: 0,0:15:37.97,0:15:44.47,Default,,0,0,0,,Көрген-түсінгенімнің бәрі менің алдымда дәрменсіз.
Dialogue: 0,0:15:44.47,0:15:46.47,Default,,0,0,0,,Хмф! Әлі де мен➡
Dialogue: 0,0:15:46.47,0:15:49.81,Default,,0,0,0,,Сіз өзіңізді есімсіз деп ойлайсыз ба?
Dialogue: 0,0:15:49.81,0:15:52.65,Default,,0,0,0,,Менің атым Джухабах.
Dialogue: 0,0:15:52.65,0:15:56.05,Default,,0,0,0,,Ол сенен бәрін тартып алады.
Dialogue: 0,0:16:07.93,0:16:11.93,Default,,0,0,0,,Бұл жұлдызды крест рыцарларының күші...
Dialogue: 0,0:16:16.77,0:16:21.11,Default,,0,0,0,,Сіз есіңізден шығып қалдыңыз ба? Жаман Банкайдан құтыла алсаң...
Dialogue: 0,0:16:21.11,0:16:23.61,Default,,0,0,0,,Бұл біртүрлі сөздер айтатын Шинигами.
Dialogue: 0,0:16:23.61,0:16:27.28,Default,,0,0,0,,Сіздің Банкайыңыз қазір ұстаған адам...
Dialogue: 0,0:16:27.28,0:16:29.28,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:16:31.29,0:16:33.29,Default,,0,0,0,,Менің атым Урю Ишида.
Dialogue: 0,0:16:33.29,0:16:37.63,Default,,0,0,0,,Жоюшының құрметіне мен сені құртамын.
Dialogue: 0,0:16:37.63,0:16:55.48,Default,,0,0,0,,♪～
Dialogue: 0,0:16:55.48,0:16:57.48,Default,,0,0,0,,«Ұшырып жібереді» дегенде, ол ауада ұша ма?
Dialogue: 0,0:16:57.48,0:17:14.10,Default,,0,0,0,,♪～
Dialogue: 0,0:17:14.10,0:17:20.00,Default,,0,0,0,,Мен көргенімдей, ол үш қадам жерде қайтыс болды.
Dialogue: 0,0:17:35.95,0:17:38.95,Default,,0,0,0,,Нөлдік жасақ құлады.
Dialogue: 0,0:17:38.95,0:17:41.62,Default,,0,0,0,,Мың жылдық дұғамыз➡
Dialogue: 0,0:17:41.62,0:17:44.33,Default,,0,0,0,,Сыйақы уақыты келді.
Dialogue: 0,0:17:48.96,0:17:53.97,Default,,0,0,0,,Әрі қарай, сен құлайсың, Рух патшасы.
Dialogue: 0,0:17:53.97,0:18:30.27,Default,,0,0,0,,♪～
Dialogue: 0,0:18:30.27,0:18:32.27,Default,,0,0,0,,Мың жыл...
Dialogue: 0,0:18:36.28,0:18:40.98,Default,,0,0,0,,Жоюшыларымыздың рухында жазылған жоғалту.
Dialogue: 0,0:18:45.12,0:18:49.32,Default,,0,0,0,,Қылмыскерді жою үшін қасиетті соғыс...
Dialogue: 0,0:18:54.30,0:18:58.30,Default,,0,0,0,,Бұл сіздің өліміңізбен аяқталады.
Dialogue: 0,0:19:00.23,0:19:04.24,Default,,0,0,0,,Менің қадамдарымды естисің бе?
Dialogue: 0,0:19:04.24,0:19:10.95,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:19:12.91,0:19:17.92,Default,,0,0,0,,Үш дүние патшасының қолына арналған қоңырау.
Dialogue: 0,0:20:57.02,0:21:00.29,Default,,0,0,0,,Тыныш... Не болып жатыр?
Dialogue: 0,0:21:00.29,0:21:02.96,Default,,0,0,0,,Шайқас аяқталды ма? Уф!
Dialogue: 0,0:21:02.96,0:21:05.29,Default,,0,0,0,,Ах! бұл….
Dialogue: 0,0:21:05.29,0:21:07.46,Default,,0,0,0,,Бұл нөлдік топ па?
Dialogue: 0,0:21:07.46,0:21:09.63,Default,,0,0,0,,Ах, діни қызметкер.
Dialogue: 0,0:21:09.63,0:21:12.63,Default,,0,0,0,,Ичиго…. Монах! ?
Dialogue: 0,0:21:12.63,0:21:16.14,Default,,0,0,0,,Ичиго... Аты... не болды?
Dialogue: 0,0:21:16.14,0:21:19.47,Default,,0,0,0,,Білмеймін... (аға басшы) Менің атыммен атаңыз.
Dialogue: 0,0:21:19.47,0:21:21.98,Default,,0,0,0,,Мен діни қызметкердің дауысын естимін.
Dialogue: 0,0:21:21.98,0:21:25.81,Default,,0,0,0,,Менің атымды атаңыз, Ичиго...
Dialogue: 0,0:21:25.81,0:21:27.82,Default,,0,0,0,,Аты….
Dialogue: 0,0:21:27.82,0:21:30.99,Default,,0,0,0,,Хёшубу Ичибей.
Dialogue: 0,0:21:30.99,0:21:32.99,Default,,0,0,0,,Кя!
Dialogue: 0,0:21:39.33,0:21:43.33,Default,,0,0,0,,Уф... Ал, рахмет!
Dialogue: 0,0:21:43.33,0:21:47.67,Default,,0,0,0,,Ах... Күштің бәрі атауда жатыр.
Dialogue: 0,0:21:47.67,0:21:50.34,Default,,0,0,0,,Ер адамның атыңызды шақыру арқылы➡
Dialogue: 0,0:21:50.34,0:21:53.17,Default,,0,0,0,,Өз күшіңізден аздап алыңыз➡
Dialogue: 0,0:21:53.17,0:21:57.18,Default,,0,0,0,,Сіз денеңізді түзеттіңіз. Бұл соншалықты тәртіпсіз.
Dialogue: 0,0:21:57.18,0:22:00.78,Default,,0,0,0,,Шынымен бе? Бізде сіз бен менің күшіміз болса➡
Dialogue: 0,0:22:00.78,0:22:04.62,Default,,0,0,0,,Әрине. Вахахаха!
Dialogue: 0,0:22:04.62,0:22:09.96,Default,,0,0,0,,Ичиго...Джухабахты тоқтат.
Dialogue: 0,0:22:09.96,0:22:13.63,Default,,0,0,0,,«Нөлдік отряд» олардан жеңілді. Қарғыс атқыр...
Dialogue: 0,0:22:13.63,0:22:16.46,Default,,0,0,0,,Мен денемді қайтардым, бірақ➡
Dialogue: 0,0:22:16.46,0:22:19.97,Default,,0,0,0,,Егер сіз қуатыңыздың қалпына келуін күтсеңіз, оны уақытында жасай алмайсыз.
Dialogue: 0,0:22:19.97,0:22:23.97,Default,,0,0,0,,Оны тоқтататын басқа ешкім жоқ.
Dialogue: 0,0:22:23.97,0:22:28.31,Default,,0,0,0,,Мен сенен мені өлтіруіңді сұрамаймын. Тек тоқта.
Dialogue: 0,0:22:28.31,0:22:31.65,Default,,0,0,0,,Рух патшасы - әлемнің кілті.
Dialogue: 0,0:22:31.65,0:22:37.48,Default,,0,0,0,,Рух Патшасы өлгенде, бұл әлем де, виртуалды әлем де, рух сарайы да➡
Dialogue: 0,0:22:37.48,0:22:40.65,Default,,0,0,0,,Барлығы құлап, жоғалады.
Dialogue: 0,0:22:40.65,0:22:44.66,Default,,0,0,0,,Бұл тапсырманы сізге тапсырғаным үшін кешірім сұраймын.
Dialogue: 0,0:22:44.66,0:22:49.66,Default,,0,0,0,,Рух патшасын қорғаңыз, Ичиго...
Dialogue: 0,0:22:49.66,0:22:52.07,Default,,0,0,0,,Ах.
Dialogue: 0,0:23:22.80,0:23:26.10,Default,,0,0,0,,Қош бол, рух патшасы.
Dialogue: 0,0:23:34.98,0:23:40.98,Default,,0,0,0,,Болашаққа үңілген әкем.
Dialogue: 0,0:23:42.48,0:23:48.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
