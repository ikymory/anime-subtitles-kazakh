Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:05.60,Default,,0,0,0,,Енді барлығың қолдарыңды алыңдар.
Dialogue: 0,0:00:10.01,0:00:12.34,Default,,0,0,0,,Сол моншақтағы Реиацу.
Dialogue: 0,0:00:12.34,0:00:14.34,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:29.36,0:00:32.69,Default,,0,0,0,,Иә? (дабыл дыбысы)
Dialogue: 0,0:00:32.69,0:00:36.20,Default,,0,0,0,,Уф! (Ақын) Не!
Dialogue: 0,0:00:36.20,0:00:39.03,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:00:39.03,0:00:41.04,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:00:46.21,0:00:50.05,Default,,0,0,0,,Уа, не! ? (Ренджи) Бұл не? ?
Dialogue: 0,0:00:50.05,0:00:53.55,Default,,0,0,0,,.Рухани сарайды қамтыған империяның көрінбейтін қала көрінісі➡
Dialogue: 0,0:00:53.55,0:00:56.55,Default,,0,0,0,,Ол қабыршақтайды...
Dialogue: 0,0:00:56.55,0:00:59.99,Default,,0,0,0,,Неге! Неліктен бұл болып жатыр? ?
Dialogue: 0,0:00:59.99,0:01:03.33,Default,,0,0,0,,Аннигиляторлар не істемекші? ?
Dialogue: 0,0:01:03.33,0:01:06.66,Default,,0,0,0,,Не істеп жатырсың! Бұл өте қатты жұмыс істейді➡
Dialogue: 0,0:01:06.66,0:01:10.17,Default,,0,0,0,,Біз ақыры қақпа жасай аламыз➡
Dialogue: 0,0:01:10.17,0:01:13.17,Default,,0,0,0,,Сан жау саған қанша жасады?
Dialogue: 0,0:01:20.18,0:01:22.51,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:01:22.51,0:01:25.01,Default,,0,0,0,,Біз қақпаны аяқтауға асығуымыз керек.
Dialogue: 0,0:03:08.65,0:03:10.65,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:03:15.66,0:03:17.66,Default,,0,0,0,,Сіз….
Dialogue: 0,0:03:17.66,0:03:21.33,Default,,0,0,0,,Эй, біраз уақыт болды, Куросаки.
Dialogue: 0,0:03:21.33,0:03:23.83,Default,,0,0,0,,Гриммжоу….
Dialogue: 0,0:03:27.84,0:03:32.34,Default,,0,0,0,,Неше жыл болды? Менімен бірге салған жараң жазылып кеткен сияқты.
Dialogue: 0,0:03:32.34,0:03:36.51,Default,,0,0,0,,Бұл хит. Сіз жақсы көрінесіз, солай емес пе?
Dialogue: 0,0:03:36.51,0:03:38.85,Default,,0,0,0,,Мен сені өлді деп ойладым ба?
Dialogue: 0,0:03:38.85,0:03:40.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:44.19,0:03:47.69,Default,,0,0,0,,Темиді өлтірмей өле аласың ба?
Dialogue: 0,0:03:47.69,0:03:49.86,Default,,0,0,0,,Мен көптен күттім.
Dialogue: 0,0:03:49.86,0:03:52.66,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:54.86,0:03:57.20,Default,,0,0,0,,Ичиго!
Dialogue: 0,0:03:57.20,0:04:00.64,Default,,0,0,0,,Жоқ! ? Мен сені сағындым, Ичиго!
Dialogue: 0,0:04:00.64,0:04:02.80,Default,,0,0,0,,Гохо, гохо, гохо!
Dialogue: 0,0:04:02.80,0:04:06.31,Default,,0,0,0,,Урахара мырза бала мен ересек адамның арасында еркін ауыса алады➡
Dialogue: 0,0:04:06.31,0:04:08.81,Default,,0,0,0,,Ол маған білезік жасады!
Dialogue: 0,0:04:08.81,0:04:12.65,Default,,0,0,0,,Енді мен Ичигоға дұрыс көмектесе аламын!
Dialogue: 0,0:04:12.65,0:04:14.82,Default,,0,0,0,,Жарайды, бұл білезік менде әлі бар болса➡
Dialogue: 0,0:04:14.82,0:04:17.49,Default,,0,0,0,,Бәлкім, балалық шаққа қайта оралмаспын!
Dialogue: 0,0:04:17.49,0:04:20.66,Default,,0,0,0,,Inoue. Мен қажетсіз нәрселерді жасай беремін➡
Dialogue: 0,0:04:20.66,0:04:23.16,Default,,0,0,0,,Сіз ойлайтын шығарсыз... (Орихиме) Ха!
Dialogue: 0,0:04:23.16,0:04:26.50,Default,,0,0,0,,Бұл дұрыс емес. Урахара-сан барын салып жатыр.
Dialogue: 0,0:04:26.50,0:04:29.00,Default,,0,0,0,,Жоқ... жоқ, Садо-кун, болды.
Dialogue: 0,0:04:29.00,0:04:31.83,Default,,0,0,0,,Мен мүлде олай ойламаймын.
Dialogue: 0,0:04:31.83,0:04:35.84,Default,,0,0,0,,Неллиэль Теми, не істеп жатырсың! Бұл ыңғайсыздық! Жолдан кет!
Dialogue: 0,0:04:35.84,0:04:42.18,Default,,0,0,0,,Бұл сызық. Ұрыстың ортасында ұрыс бастайтын болсаңыз, артта қалыңыз.
Dialogue: 0,0:04:42.18,0:04:45.68,Default,,0,0,0,,Біріншіден, ЖОҚ. Мен №3. Сіз үшін 6➡
Dialogue: 0,0:04:45.68,0:04:48.02,Default,,0,0,0,,Маған не істеу керектігін айтқаны есімде жоқ.
Dialogue: 0,0:04:48.02,0:04:52.85,Default,,0,0,0,,Бұл қоқыс. Қазір индиго бояуы, сандардың мағынасы бар ма?
Dialogue: 0,0:04:52.85,0:04:58.19,Default,,0,0,0,,Неге қазір қолданып көрмеске? Мен және Теми, қайсысы жақсы?
Dialogue: 0,0:04:58.19,0:05:01.13,Default,,0,0,0,,Күте тұрыңыз! Гриммжоу! 🔊Аа~ Аа~.
Dialogue: 0,0:05:01.13,0:05:05.13,Default,,0,0,0,,🔊Тоқта, тоқта! Сіз мұнда не істеп жүрсіз? Тек ақымақтар бар! ?
Dialogue: 0,0:05:05.13,0:05:07.47,Default,,0,0,0,,🔊Сіз мұнда ол үшін келген жоқсыз!
Dialogue: 0,0:05:07.47,0:05:09.97,Default,,0,0,0,,Хмм, бұл дауыс...
Dialogue: 0,0:05:09.97,0:05:13.48,Default,,0,0,0,,🔊Мен сені табамын, тез кіре аласың ба?
Dialogue: 0,0:05:13.48,0:05:16.31,Default,,0,0,0,,Бұл қорап, мүмкін емес ...
Dialogue: 0,0:05:16.31,0:05:18.98,Default,,0,0,0,,Тез кіріңдер деп жатырмын!
Dialogue: 0,0:05:18.98,0:05:20.98,Default,,0,0,0,,Рирука!
Dialogue: 0,0:05:20.98,0:05:23.82,Default,,0,0,0,,Мен де осындамын. Юкио!
Dialogue: 0,0:05:23.82,0:05:27.82,Default,,0,0,0,,Дәлірек айтқанда, өздеріңіз көріп отырғандай, бұл менің қабілетім.
Dialogue: 0,0:05:27.82,0:05:30.16,Default,,0,0,0,,Балалар сендер әлі тірі болдыңдар.
Dialogue: 0,0:05:30.16,0:05:33.16,Default,,0,0,0,,Оның орнына не үшін келдің?
Dialogue: 0,0:05:33.16,0:05:36.87,Default,,0,0,0,,Ал, қазір кіріңіз. Бұл әңгіме.
Dialogue: 0,0:05:40.50,0:05:44.01,Default,,0,0,0,,Енді қайсысын түсіндіргім келеді? Ичиго.
Dialogue: 0,0:05:44.01,0:05:46.01,Default,,0,0,0,,Барлығы!
Dialogue: 0,0:05:46.01,0:05:48.18,Default,,0,0,0,,Неліктен оның бір бөлігі ғана түсіндірілетін сияқты?
Dialogue: 0,0:05:48.18,0:05:50.68,Default,,0,0,0,,Барлығын түсіндір! Барлығы!
Dialogue: 0,0:05:50.68,0:05:53.18,Default,,0,0,0,,Бәрі жақсы!
Dialogue: 0,0:05:53.18,0:05:55.52,Default,,0,0,0,,Барлығы! Эй! ?
Dialogue: 0,0:05:55.52,0:05:58.35,Default,,0,0,0,,Біз ойдан шығарылған саладамыз...
Dialogue: 0,0:05:58.35,0:06:00.36,Default,,0,0,0,,Кешіріңіз. бұршақ пастасы! ?
Dialogue: 0,0:06:02.29,0:06:04.96,Default,,0,0,0,,Әй, сол кезде...
Dialogue: 0,0:06:04.96,0:06:07.80,Default,,0,0,0,,Соғыс күші көбірек болғаны дұрыс.
Dialogue: 0,0:06:07.80,0:06:10.80,Default,,0,0,0,,Алғашында ештеңе үйретпеген мен ғана шығармын➡
Dialogue: 0,0:06:10.80,0:06:13.13,Default,,0,0,0,,Бұл күлкілі! ? сөзсіз.
Dialogue: 0,0:06:13.13,0:06:16.30,Default,,0,0,0,,Міне, көптен бері бос емессің.
Dialogue: 0,0:06:16.30,0:06:19.64,Default,,0,0,0,,Мынау мазасыз бет не болды? Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:06:19.64,0:06:22.48,Default,,0,0,0,,Иә! ? Айтуға жақсы мүмкіндігім болды!
Dialogue: 0,0:06:22.48,0:06:24.48,Default,,0,0,0,,Мұнда келе жатқанда.
Dialogue: 0,0:06:24.48,0:06:26.65,Default,,0,0,0,,Ах.
Dialogue: 0,0:06:26.65,0:06:31.15,Default,,0,0,0,,Тосқауыл Жан әлемі мен осы әлемді байланыстырады. Сіз мұны түсінесіз бе?
Dialogue: 0,0:06:31.15,0:06:33.66,Default,,0,0,0,,Ах. Шлагбаумның айналасында ➡
Dialogue: 0,0:06:33.66,0:06:36.16,Default,,0,0,0,,Шоутани➡ деп аталатын әртүрлі өлшемдер
Dialogue: 0,0:06:36.16,0:06:39.16,Default,,0,0,0,,Адасып кеткен жандардың сырласатын жерлері бар➡
Dialogue: 0,0:06:39.16,0:06:44.00,Default,,0,0,0,,Барлық бос орындарды толтыру үшін қара қуыс бар.
Dialogue: 0,0:06:44.00,0:06:47.00,Default,,0,0,0,,Осы қара қуыстың ішінде рухани қысым тұрақсыз➡
Dialogue: 0,0:06:47.00,0:06:51.01,Default,,0,0,0,,Рухани қысым көрсетіп, тұғырды тік тұрғызбасақ➡
Dialogue: 0,0:06:51.01,0:06:53.51,Default,,0,0,0,,Мен тіпті тұра алмаймын.
Dialogue: 0,0:06:53.51,0:06:58.51,Default,,0,0,0,,Солардың ішінде мен айтқан жалғыз нәрсе - рух құрылымының айырмашылығына байланысты Шоутани➡
Dialogue: 0,0:06:58.51,0:07:02.78,Default,,0,0,0,,Неге екені белгісіз, ол рухани кеңістік ретінде өмір сүре береді.
Dialogue: 0,0:07:02.78,0:07:06.29,Default,,0,0,0,,Кисуке мұны толық пайдалануды ойлады.
Dialogue: 0,0:07:06.29,0:07:11.46,Default,,0,0,0,,Сондықтан мен оларды іздеп тауып, қайтардым.
Dialogue: 0,0:07:11.46,0:07:15.63,Default,,0,0,0,,Жарайды, қаласаң бірдеңе табасың деген қорқынышты.
Dialogue: 0,0:07:15.63,0:07:19.97,Default,,0,0,0,,Электр қуатын пайдалана отырып, кеңістікті еркін құру мүмкіндігі.
Dialogue: 0,0:07:19.97,0:07:23.81,Default,,0,0,0,,Бұл сәл басқаша. Жарайды, бірақ шын мәнінде емес.
Dialogue: 0,0:07:23.81,0:07:27.98,Default,,0,0,0,,Рируканың бүкіл кішкентай Шоутаниді қорапта тасымалдау мүмкіндігін пайдаланыңыз➡
Dialogue: 0,0:07:27.98,0:07:32.15,Default,,0,0,0,,Юкионың қабілеті оны бөлмеге және рельске айналдырды.
Dialogue: 0,0:07:32.15,0:07:35.82,Default,,0,0,0,,Ол енді ғана аяқталды.
Dialogue: 0,0:07:35.82,0:07:38.49,Default,,0,0,0,,Ал, мен басқан қазықты белгі ретінде пайдаланыңыз➡
Dialogue: 0,0:07:38.49,0:07:40.82,Default,,0,0,0,,Осы жерден Рух сарайына дейін аз ғана қашықтық➡
Dialogue: 0,0:07:40.82,0:07:43.49,Default,,0,0,0,,Тек қозғала алу.
Dialogue: 0,0:07:43.49,0:07:48.00,Default,,0,0,0,,Рейацуды босатпай жау аумағына басып кірудің артықшылығы зор.
Dialogue: 0,0:07:48.00,0:07:50.67,Default,,0,0,0,,Осы арқылы біз оларға шабуыл жасай аламыз.
Dialogue: 0,0:07:50.67,0:07:53.67,Default,,0,0,0,,Мен саған бірден шабуыл жасаймын, Ичиго.
Dialogue: 0,0:07:53.67,0:07:55.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:04.78,0:08:06.95,Default,,0,0,0,,Ей, бірдеңе дұрыс емес!
Dialogue: 0,0:08:06.95,0:08:09.12,Default,,0,0,0,,Салынғалы тұрған қақпа жоғалып кетті...
Dialogue: 0,0:08:09.12,0:08:11.29,Default,,0,0,0,,Не болып жатыр! ?
Dialogue: 0,0:08:11.29,0:08:13.96,Default,,0,0,0,,Reiatsu жеткіліксіз бе? (Хисаки) Не! ?
Dialogue: 0,0:08:13.96,0:08:17.79,Default,,0,0,0,,Ол капитандар арасында да ең көп Рейатсуға ие болды➡
Dialogue: 0,0:08:17.79,0:08:21.46,Default,,0,0,0,,Мүмкін капитан Укитакенің жоқтығы маған әсер етіп жатқан шығар...
Dialogue: 0,0:08:21.46,0:08:23.47,Default,,0,0,0,,Осы жылдамдықпен...
Dialogue: 0,0:08:25.47,0:08:27.64,Default,,0,0,0,,Іс осылай жалғаса берсе не істей аламыз?
Dialogue: 0,0:08:27.64,0:08:30.14,Default,,0,0,0,,Бұлай болып қалуы мүмкін емес.
Dialogue: 0,0:08:30.14,0:08:32.31,Default,,0,0,0,,Ядомару мырза….
Dialogue: 0,0:08:32.31,0:08:34.81,Default,,0,0,0,,Мен жаңа ғана өлім тұманын қойдым!
Dialogue: 0,0:08:34.81,0:08:37.81,Default,,0,0,0,,Біздің моншақтар, Хаё Ватари-сан, Кисуке!
Dialogue: 0,0:08:43.99,0:08:47.66,Default,,0,0,0,,Сандарға қарасаңыз, рейатсудың жоқтығы анық.
Dialogue: 0,0:08:47.66,0:08:51.86,Default,,0,0,0,,Неліктен Reiatsu күшейткішін қоспайсыз?
Dialogue: 0,0:08:58.50,0:09:02.44,Default,,0,0,0,,Егер сізде осындай нәрсе болса, маған хабарлаңыз.
Dialogue: 0,0:09:02.44,0:09:07.74,Default,,0,0,0,,Мен мұндай нәрсе болады деп ешқашан күткен емеспін.
Dialogue: 0,0:09:24.79,0:09:28.80,Default,,0,0,0,,Мен оны босқа өткізбеймін... Үкітаке.
Dialogue: 0,0:09:31.63,0:09:35.14,Default,,0,0,0,,Рух патшасының сарайына дейін жүріп, тосын шабуылды бастаңыз.
Dialogue: 0,0:09:35.14,0:09:37.97,Default,,0,0,0,,Рух Патшасын мөрлеуге әрекет жасағанда➡
Dialogue: 0,0:09:37.97,0:09:41.98,Default,,0,0,0,,Төменде қағылған қазық Рух Патшасының қасына қағылды.
Dialogue: 0,0:09:41.98,0:09:45.98,Default,,0,0,0,,Егер олар сонда қалса, сіздің алдыңыздан секіре алады.
Dialogue: 0,0:09:45.98,0:09:50.49,Default,,0,0,0,,Сіз бір сәттік саңылау алып, оған ең үлкен Гецугаңызды соғыңыз.
Dialogue: 0,0:09:50.49,0:09:55.32,Default,,0,0,0,,Ичиго, сен мұны істей аласың. Түсінді.
Dialogue: 0,0:09:55.32,0:09:59.49,Default,,0,0,0,,Басқалар кедергі келтірсе, біз жол ашамыз.
Dialogue: 0,0:09:59.49,0:10:01.50,Default,,0,0,0,,Кішкентай шабақтарды маған қалдырыңыз!
Dialogue: 0,0:10:01.50,0:10:03.50,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:10:03.50,0:10:08.50,Default,,0,0,0,,Мен СС қабілеттерін түсінемін, бірақ Юхабахтың қабілеттері қандай?
Dialogue: 0,0:10:08.50,0:10:11.34,Default,,0,0,0,,Мм... (2 адам) Иә?
Dialogue: 0,0:10:11.34,0:10:15.84,Default,,0,0,0,,Мен Ошо мырзадан бұл туралы көбірек сұрауым керек еді.
Dialogue: 0,0:10:15.84,0:10:17.85,Default,,0,0,0,,Тітіркендіргіш!
Dialogue: 0,0:10:17.85,0:10:20.35,Default,,0,0,0,,Оқиғаның сюжетін түсіне алмаймын.
Dialogue: 0,0:10:20.35,0:10:23.02,Default,,0,0,0,,Мен біраз мұңайып тұрмын, бірақ не істегенін ойлаңыз➡
Dialogue: 0,0:10:23.02,0:10:25.35,Default,,0,0,0,,Рұқсатсыз қара істерді доғар! ?
Dialogue: 0,0:10:25.35,0:10:29.86,Default,,0,0,0,,Мазасыздық, өйткені біз оған ілініп, қараңғы түсеміз.
Dialogue: 0,0:10:29.86,0:10:33.53,Default,,0,0,0,,Дұрыс. Рахмет, Рирука-чан.
Dialogue: 0,0:10:33.53,0:10:36.36,Default,,0,0,0,,Маған неге бұлай алғыс айтасың? Мен өзімді өте жаман сезінемін!
Dialogue: 0,0:10:36.36,0:10:38.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:38.37,0:10:41.87,Default,,0,0,0,,Ойланып қарашы, неге біздің жағымызды алдың?
Dialogue: 0,0:10:41.87,0:10:43.87,Default,,0,0,0,,Гриммжоу. О?
Dialogue: 0,0:10:43.87,0:10:48.04,Default,,0,0,0,,Кім сенің жаныңда? Ол қабілетсіз бейбақ.
Dialogue: 0,0:10:48.04,0:10:50.71,Default,,0,0,0,,Сол Юха Бахты бақылаусыз қалдырса ше➡
Dialogue: 0,0:10:50.71,0:10:52.88,Default,,0,0,0,,Елестетілген сфера жоқ.
Dialogue: 0,0:10:52.88,0:10:58.22,Default,,0,0,0,,Қиялдың шары кетсе, Темейді қайда өлтіремін?
Dialogue: 0,0:10:58.22,0:11:00.66,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:00.66,0:11:02.66,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:09.00,0:11:19.84,Default,,0,0,0,,♪～
Dialogue: 0,0:11:19.84,0:11:22.64,Default,,0,0,0,,Менің ұлдарым.
Dialogue: 0,0:11:27.68,0:11:29.85,Default,,0,0,0,,А... (Хашвальд) Не болды?
Dialogue: 0,0:11:29.85,0:11:32.19,Default,,0,0,0,,Ха! Сабыр ет, Кнуклевар.
Dialogue: 0,0:11:32.19,0:11:34.69,Default,,0,0,0,,《Не, не, не!? ?
Dialogue: 0,0:11:34.69,0:11:37.03,Default,,0,0,0,,Мынандай құбыжық болып кеткен ұлы мәртебеліге қараңызшы➡
Dialogue: 0,0:11:37.03,0:11:39.53,Default,,0,0,0,,Сен ештеңе сезбейсің бе, мына жігіт...?
Dialogue: 0,0:11:39.53,0:11:44.03,Default,,0,0,0,,Қорқынышты ма? Одан қорқудың қажеті жоқ.
Dialogue: 0,0:11:44.03,0:11:48.04,Default,,0,0,0,,Ақырында бұл суретті көруге үйренесіз.
Dialogue: 0,0:11:48.04,0:11:50.04,Default,,0,0,0,,А... бәрібір➡
Dialogue: 0,0:11:50.04,0:11:55.34,Default,,0,0,0,,Тым көп билікке ие болу деген осы ма?
Dialogue: 0,0:11:59.71,0:12:02.12,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:12:09.66,0:12:12.66,Default,,0,0,0,,Осы жерден құласаң, өлесің!
Dialogue: 0,0:12:12.66,0:12:15.66,Default,,0,0,0,,Сәлем! Сіз қаншалықты тынышсыз, Хашва...?
Dialogue: 0,0:12:21.84,0:12:24.64,Default,,0,0,0,,Сіз байсалдысыз ба... Әй?
Dialogue: 0,0:12:33.85,0:12:36.35,Default,,0,0,0,,Керемет күш.
Dialogue: 0,0:12:36.35,0:12:39.69,Default,,0,0,0,,Рух Патшасы қайтыс болғаннан кейін, одан кейінгі әлем Ұлы Мәртебелі биліктен айырылады➡
Dialogue: 0,0:12:39.69,0:12:41.86,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:12:41.86,0:12:45.19,Default,,0,0,0,,Маған жол көрсетіңізші... Мәртебелі.
Dialogue: 0,0:12:45.19,0:12:50.03,Default,,0,0,0,,Хашвальд Менің бірінші ұлым.
Dialogue: 0,0:12:50.03,0:12:54.04,Default,,0,0,0,,Менің артымда тұрып, менің қадамдарымды бақылаңыз.
Dialogue: 0,0:12:54.04,0:12:59.54,Default,,0,0,0,,Алдымен ұлтымызды қайта құрайық.
Dialogue: 0,0:12:59.54,0:13:14.56,Default,,0,0,0,,♪～
Dialogue: 0,0:13:23.50,0:13:26.17,Default,,0,0,0,,Уақыт келді. Дайынсыз ба?
Dialogue: 0,0:13:26.17,0:13:29.34,Default,,0,0,0,,Ах. (Юкио) Тек қауіпсіз болу үшін➡
Dialogue: 0,0:13:29.34,0:13:32.01,Default,,0,0,0,,Мен бұл жерден ешқашан қозғалмаймын.
Dialogue: 0,0:13:32.01,0:13:34.68,Default,,0,0,0,,Егер сіз бірдеңе жасағыңыз келсе, оны өзіңіз қалағандай жасаңыз. Не!
Dialogue: 0,0:13:34.68,0:13:38.85,Default,,0,0,0,,Сіз не айтып тұрсыз? Мен сенің кім екеніңді білмеймін!
Dialogue: 0,0:13:38.85,0:13:41.68,Default,,0,0,0,,Мен сенің кім екеніңді де білмеймін.
Dialogue: 0,0:13:41.68,0:13:45.19,Default,,0,0,0,,Біз бір-бірімізді ертерек таныстырдық.
Dialogue: 0,0:13:45.19,0:13:49.86,Default,,0,0,0,,Иваваси-кун өзін таныстырды, бірақ Юкио-кун оған мән бермеді.
Dialogue: 0,0:13:49.86,0:13:52.36,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ мен саған айтамын!
Dialogue: 0,0:13:52.36,0:13:56.36,Default,,0,0,0,,Шарасыз соғыссақ та, мұнда қозғала алмадық➡
Dialogue: 0,0:13:56.36,0:14:00.13,Default,,0,0,0,,Қандай келісім! Мен оған жаңа ғана түсіп қалдым.
Dialogue: 0,0:14:00.13,0:14:02.80,Default,,0,0,0,,Соншалықты үмітсіз болуға ешқандай себеп жоқ.
Dialogue: 0,0:14:02.80,0:14:05.97,Default,,0,0,0,,Міндеттемеден үмітсіз болу шарасыз болу дегенді білдірмейді!
Dialogue: 0,0:14:05.97,0:14:08.14,Default,,0,0,0,,Мен мұнда тығыламын ба, не істеймін➡ бәрібір
Dialogue: 0,0:14:08.14,0:14:12.65,Default,,0,0,0,,Жеңілсек, бұл қара құрдым да жоғалады!
Dialogue: 0,0:14:12.65,0:14:14.82,Default,,0,0,0,,Сіз ұтыласыз ба? Уф...
Dialogue: 0,0:14:14.82,0:14:16.82,Default,,0,0,0,,Тоқта, Иваваси. Ой...
Dialogue: 0,0:14:16.82,0:14:19.15,Default,,0,0,0,,Бұл сіздің жоғалтыңыз.
Dialogue: 0,0:14:19.15,0:14:22.16,Default,,0,0,0,,Юкио, осында қалшы.
Dialogue: 0,0:14:22.16,0:14:24.49,Default,,0,0,0,,Мен мұны біраздан бері айтқым келді.
Dialogue: 0,0:14:24.49,0:14:27.33,Default,,0,0,0,,Және Рирука. Сіз де қалуыңыз керек.
Dialogue: 0,0:14:27.33,0:14:29.33,Default,,0,0,0,,Ха! ?
Dialogue: 0,0:14:29.33,0:14:33.00,Default,,0,0,0,,Сіздің күшіңізбен алдағы шайқас тек қауіпті болады.
Dialogue: 0,0:14:33.00,0:14:35.50,Default,,0,0,0,,Қалыңыз. Сен не туралы айтып тұрсың? ? Жай әзіл...
Dialogue: 0,0:14:35.50,0:14:38.84,Default,,0,0,0,,Мен бірде Шоутаниге кірдім.
Dialogue: 0,0:14:38.84,0:14:41.01,Default,,0,0,0,,Маған тек сүйкімді нәрселер ұнайды.
Dialogue: 0,0:14:41.01,0:14:44.35,Default,,0,0,0,,Сіз тек өзіңізге ұнаған нәрсені қорапқа сала аласыз➡
Dialogue: 0,0:14:44.35,0:14:47.18,Default,,0,0,0,,Кавайи Кумо, не деген, Шоутани ➡
Dialogue: 0,0:14:47.18,0:14:49.68,Default,,0,0,0,,Сізді қорапқа салуға болмайды.
Dialogue: 0,0:14:49.68,0:14:52.69,Default,,0,0,0,,Сіз мұны біз үшін істеу үшін барын салдыңыз, солай ма?
Dialogue: 0,0:14:52.69,0:14:55.02,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:14:55.02,0:14:58.03,Default,,0,0,0,,Уф! Бебе...бебе, шынымен емес...
Dialogue: 0,0:14:58.03,0:15:02.63,Default,,0,0,0,,Сондықтан біз үшін тағы бір нәрсе жасауларыңызды қалаймын.
Dialogue: 0,0:15:02.63,0:15:04.80,Default,,0,0,0,,Осы жерде Юкиомен бірге болыңыз➡
Dialogue: 0,0:15:04.80,0:15:09.14,Default,,0,0,0,,Кез келген уақытта қашып құтыла алатынымызға көз жеткізіңіз.
Dialogue: 0,0:15:09.14,0:15:12.47,Default,,0,0,0,,Бетцуни….
Dialogue: 0,0:15:12.47,0:15:15.31,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:15:15.31,0:15:17.81,Default,,0,0,0,,Сәлем Ичиго. иә?
Dialogue: 0,0:15:17.81,0:15:20.48,Default,,0,0,0,,Сіз есейдіңіз.
Dialogue: 0,0:15:20.48,0:15:22.48,Default,,0,0,0,,Шынымен бе? Бұл қайда?
Dialogue: 0,0:15:24.49,0:15:26.99,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:15:26.99,0:15:30.09,Default,,0,0,0,,Алғашында солай болған.
Dialogue: 0,0:15:42.00,0:15:44.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:44.01,0:15:47.31,Default,,0,0,0,,Аяқталды.
Dialogue: 0,0:15:54.52,0:15:57.02,Default,,0,0,0,,Сіз келген сияқтысыз.
Dialogue: 0,0:15:57.02,0:15:59.12,Default,,0,0,0,,Кеттік. аа.
Dialogue: 0,0:16:02.12,0:16:04.13,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:16:10.63,0:16:14.80,Default,,0,0,0,,Енді осы қақпадан өтсеңіз, Рух патшасының сарайын табасыз.
Dialogue: 0,0:16:14.80,0:16:18.81,Default,,0,0,0,,Барлығыңызға рахмет. Мен келе жатырмын!
Dialogue: 0,0:16:18.81,0:16:21.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:21.31,0:16:24.65,Default,,0,0,0,,Қақпа ашылады. Дайынсыз ба?
Dialogue: 0,0:16:24.65,0:16:26.65,Default,,0,0,0,,О!
Dialogue: 0,0:16:36.99,0:16:38.99,Default,,0,0,0,,Бұл қай жер...?
Dialogue: 0,0:16:38.99,0:16:43.50,Default,,0,0,0,,Бұл Рух патшасының сарайы емес. Бұл қала пейзажы жоюшыларға тиесілі.
Dialogue: 0,0:16:43.50,0:16:46.60,Default,,0,0,0,,Эй, эй! Бұл қай жер?
Dialogue: 0,0:16:51.01,0:16:53.34,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:16:53.34,0:16:57.35,Default,,0,0,0,,Мен Рух патшасының сарайына қосылуым керек еді, сонда мен неге Жоюшының қаласына келдім!? ?
Dialogue: 0,0:16:57.35,0:16:59.68,Default,,0,0,0,,Қарғыс атсын! Не деген, Кисуке!
Dialogue: 0,0:16:59.68,0:17:01.78,Default,,0,0,0,,Сіз Рух патшасының сарайына келесіз бе?
Dialogue: 0,0:17:01.78,0:17:07.12,Default,,0,0,0,,Жоқ... Координаттар Рух сарайының дәл үстінде. Бұл Рух сарайы болуы керек.
Dialogue: 0,0:17:07.12,0:17:11.29,Default,,0,0,0,,Ақымақ... Мен қаққан қазық жерге жетпедің!
Dialogue: 0,0:17:11.29,0:17:13.29,Default,,0,0,0,,Не!
Dialogue: 0,0:17:19.80,0:17:21.97,Default,,0,0,0,,Ичиго.
Dialogue: 0,0:17:21.97,0:17:25.47,Default,,0,0,0,,Басқаша айтқанда, мен бұрын аруақтар сарайынан көтерген қала➡
Dialogue: 0,0:17:25.47,0:17:28.98,Default,,0,0,0,,Бұл олардың Рух патша сарайын қиратып, оны қайта салғанын білдірмейді ме?
Dialogue: 0,0:17:28.98,0:17:31.65,Default,,0,0,0,,Ақымақ! Дәл қазір не болды...
Dialogue: 0,0:17:31.65,0:17:36.48,Default,,0,0,0,,Сонымен... бұл сіз сонша күшке ие болдыңыз дегенді білдіреді.
Dialogue: 0,0:17:36.48,0:17:38.65,Default,,0,0,0,,Жау.
Dialogue: 0,0:17:38.65,0:17:40.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:40.99,0:17:43.32,Default,,0,0,0,,Тс!
Dialogue: 0,0:17:43.32,0:17:45.63,Default,,0,0,0,,Ичиго. иә?
Dialogue: 0,0:17:48.66,0:17:52.17,Default,,0,0,0,,Бұл жер сөзсіз Рух патшасының сарайы болса керек.
Dialogue: 0,0:17:54.50,0:18:01.11,Default,,0,0,0,,Сен, Юхабах, Рух патшасының сарайын өзіңдікіне айналдырдыңыз.
Dialogue: 0,0:18:01.11,0:18:05.45,Default,,0,0,0,,Қараңдаршы, қала пейзажының шеті шеңбер болса керек.
Dialogue: 0,0:18:05.45,0:18:08.12,Default,,0,0,0,,Бұл жер Рух патшасының сарайында орналасқан шығар➡
Dialogue: 0,0:18:08.12,0:18:10.79,Default,,0,0,0,,Бұл нөлдік виллалардың бірі.
Dialogue: 0,0:18:10.79,0:18:14.96,Default,,0,0,0,,Бірақ мен оның үстінде қалқып тұруы керек Рух патшасының сарайын таба алмаймын.
Dialogue: 0,0:18:14.96,0:18:17.12,Default,,0,0,0,,Бұл➡ дегенді білдіреді
Dialogue: 0,0:18:17.12,0:18:19.29,Default,,0,0,0,,Рух патшасының сарайы құлады және оның бәрі➡
Dialogue: 0,0:18:19.29,0:18:22.46,Default,,0,0,0,,Жау қолына түсті дейсіз бе?
Dialogue: 0,0:18:22.46,0:18:25.63,Default,,0,0,0,,Сонымен... солай болды...
Dialogue: 0,0:18:25.63,0:18:28.64,Default,,0,0,0,,Қара қуыста болғанымызға рахмет➡
Dialogue: 0,0:18:28.64,0:18:33.14,Default,,0,0,0,,Мен бұған араласудан аулақ болдым. Менің ойымша, мен оны сәттілік деп санауым керек.
Dialogue: 0,0:18:35.48,0:18:37.48,Default,,0,0,0,,Бұл Нисаманың Рейатсуы!
Dialogue: 0,0:18:37.48,0:18:41.48,Default,,0,0,0,,Бұл реиацу...Юширо. Ол кім?
Dialogue: 0,0:18:41.48,0:18:43.48,Default,,0,0,0,,Юсиро Шифуин.
Dialogue: 0,0:18:43.48,0:18:47.15,Default,,0,0,0,,Мен Шифуин әулетінен шығарылғаннан кейін Шифуин әулетінің басшысы болдым➡
Dialogue: 0,0:18:47.15,0:18:50.83,Default,,0,0,0,,Ол менің інім. Йоруичи-сан, сенің інің бар!
Dialogue: 0,0:18:50.83,0:18:53.33,Default,,0,0,0,,Мен оны бірінші рет естіп тұрмын! Неліктен бұл менің інім туралы➡
Dialogue: 0,0:18:53.33,0:18:58.00,Default,,0,0,0,,Мен сізді таныстыру үшін өз жолымнан шығудың қажеті жоқ. Сіз менің сүйіктімсіз бе?
Dialogue: 0,0:18:58.00,0:19:00.94,Default,,0,0,0,,Мен қазір сол жаққа бара жатырмын! Әпке!
Dialogue: 0,0:19:00.94,0:19:04.94,Default,,0,0,0,,Бұл! ? Ууууууууууууууууууууу!
Dialogue: 0,0:19:04.94,0:19:06.94,Default,,0,0,0,,Ба... сен ақымақ!
Dialogue: 0,0:19:06.94,0:19:09.61,Default,,0,0,0,,Не істеп жатырсың, Темее? Мен... кешіріңіз.
Dialogue: 0,0:19:09.61,0:19:12.28,Default,,0,0,0,,Неге екені белгісіз... Аяғымды таба алмадым.
Dialogue: 0,0:19:12.28,0:19:14.62,Default,,0,0,0,,Шамасы, осында➡
Dialogue: 0,0:19:14.62,0:19:17.62,Default,,0,0,0,,Рухани балалармен тірек болу қиын сияқты.
Dialogue: 0,0:19:17.62,0:19:19.62,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:19.62,0:19:21.79,Default,,0,0,0,,Оны ағам да сезетін шығар➡
Dialogue: 0,0:19:21.79,0:19:26.63,Default,,0,0,0,,Рух патшасы сарайының атмосферасын толтыратын рухтардың шоғырлануы өте жоғары.
Dialogue: 0,0:19:26.63,0:19:28.96,Default,,0,0,0,,Шынында да….
Dialogue: 0,0:19:28.96,0:19:31.13,Default,,0,0,0,,Бастапқыда осыншама рухани шоғырланумен➡
Dialogue: 0,0:19:31.13,0:19:33.47,Default,,0,0,0,,Тіреуіш тұрғызуға жол жоқ.
Dialogue: 0,0:19:33.47,0:19:36.80,Default,,0,0,0,,Олай болса орындалмайтын бір себеп бар.
Dialogue: 0,0:19:36.80,0:19:39.64,Default,,0,0,0,,Осы аймақтағы барлық рухтарға үстемдік жасау➡
Dialogue: 0,0:19:39.64,0:19:42.48,Default,,0,0,0,,Бұл тастаған тараптың бақылауында екенін білдіреді.
Dialogue: 0,0:19:42.48,0:19:48.48,Default,,0,0,0,,Шабуылдаушы тараптың жауға тиімсіз ұрыс алаңын дайындауы заңдылық.
Dialogue: 0,0:19:48.48,0:19:52.49,Default,,0,0,0,,Егер аннигилятордың мәні айналасындағы рухтарды манипуляциялау және пайдалану болса➡
Dialogue: 0,0:19:52.49,0:19:56.99,Default,,0,0,0,,Егер сіз көшбасшы болсаңыз, сіз осыншама нәтижеге қол жеткізе аласыз.
Dialogue: 0,0:19:56.99,0:20:00.10,Default,,0,0,0,,Егер ол Рух Патшасын өлтіруге лайық болса, одан да көп.
Dialogue: 0,0:20:00.10,0:20:04.67,Default,,0,0,0,,Расында да... Рух патша сарайына кірсеңіз де➡
Dialogue: 0,0:20:04.67,0:20:08.00,Default,,0,0,0,,Мен Рух Патшасының рухани қысымын мүлде сезбеймін.
Dialogue: 0,0:20:08.00,0:20:11.17,Default,,0,0,0,,Бұл Рух Патшасының өлтірілгенін білдіре ме?
Dialogue: 0,0:20:11.17,0:20:14.34,Default,,0,0,0,,жеткілікті. Алыста болса да➡
Dialogue: 0,0:20:14.34,0:20:17.51,Default,,0,0,0,,Бақытымызға орай, мен Ичиго мен оның достарының реиатсуын сезінемін➡
Dialogue: 0,0:20:17.51,0:20:21.52,Default,,0,0,0,,Алдыңғы топтың жойылмағаны жақсы жаңалық.
Dialogue: 0,0:20:21.52,0:20:24.35,Default,,0,0,0,,Рух патша жау қолынан өлсе➡
Dialogue: 0,0:20:24.35,0:20:28.19,Default,,0,0,0,,Жауды жеңіп, жаңа Рух патшасын таңдаңыз.
Dialogue: 0,0:20:28.19,0:20:33.36,Default,,0,0,0,,Егер Үкітаке қазір сөйлесе алатын болса, менің ойымша, ол осылай айтар еді.
Dialogue: 0,0:20:33.36,0:20:37.70,Default,,0,0,0,,Кеттік. Өйткені мен Ичиго-кунмен және басқалармен қосыла алмаймын➡
Dialogue: 0,0:20:37.70,0:20:40.53,Default,,0,0,0,,Жол бар жерге барудан басқа амал жоқ.
Dialogue: 0,0:20:40.53,0:20:45.21,Default,,0,0,0,,Біз, он үш Готей әскері, Готей үшін ілгерілей берейік.
Dialogue: 0,0:20:45.21,0:20:47.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:49.54,0:20:51.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:51.55,0:20:53.55,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:20:53.55,0:21:07.16,Default,,0,0,0,,♪～
Dialogue: 0,0:21:07.16,0:21:09.16,Default,,0,0,0,,Бұл не! ?
Dialogue: 0,0:21:09.16,0:21:13.83,Default,,0,0,0,,Ештеңе, ештеңе. Бұл жаудың штабы, солай ма?
Dialogue: 0,0:21:13.83,0:21:16.50,Default,,0,0,0,,Қашудан немесе жасырудан алыс➡
Dialogue: 0,0:21:16.50,0:21:20.01,Default,,0,0,0,,Тез кел деп тұрғандай.
Dialogue: 0,0:21:20.01,0:21:22.68,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:21:22.68,0:21:24.68,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:21:29.85,0:21:33.19,Default,,0,0,0,,Джухабах мырза. Ичиго Куросакидің кешімен➡
Dialogue: 0,0:21:33.19,0:21:37.86,Default,,0,0,0,,Шамамен бір уақытта он үш Готей корпусының бір партиясы басып кірген сияқты.
Dialogue: 0,0:21:37.86,0:21:41.03,Default,,0,0,0,,Бұл…. (Юхбах) Бұл шынайы дүние.
Dialogue: 0,0:21:41.03,0:21:45.87,Default,,0,0,0,,Бұл қамал ақырында жаңа әлемнің негізі болды➡
Dialogue: 0,0:21:45.87,0:21:49.04,Default,,0,0,0,,Бір ғана шынайы әлем➡
Dialogue: 0,0:21:49.04,0:21:53.21,Default,,0,0,0,,Ол «Нағыз әлем сарайы» деп аталады.
Dialogue: 0,0:21:53.21,0:21:55.21,Default,,0,0,0,,Содан кейін біз оларды соңғы сарбазға апарамыз➡
Dialogue: 0,0:21:55.21,0:21:57.21,Default,,0,0,0,,Оны жойып жіберейік.
Dialogue: 0,0:21:57.21,0:22:00.31,Default,,0,0,0,,Мәртебелі көрген болашаққа жету.
Dialogue: 0,0:22:00.31,0:22:03.82,Default,,0,0,0,,Бұл жаңа әлемнің негізі болады➡
Dialogue: 0,0:22:03.82,0:22:06.02,Default,,0,0,0,,Шынайы әлем сарайында.
Dialogue: 0,0:22:07.52,0:22:13.52,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
