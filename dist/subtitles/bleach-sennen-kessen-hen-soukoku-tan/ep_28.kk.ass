Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.75,0:00:03.67,Default,,0,0,0,,Қош бол, Рух патшасы
Dialogue: 0,0:00:04.17,0:00:06.42,Default,,0,0,0,,Болашаққа көзқарас
Dialogue: 0,0:00:08.00,0:00:09.42,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:00:45.46,0:00:46.92,Default,,0,0,0,,Сіз мені ести аласыз ба?
Dialogue: 0,0:00:47.50,0:00:50.92,Default,,0,0,0,,Ішкі жүрегімнің айқайы
Dialogue: 0,0:00:51.76,0:00:53.21,Default,,0,0,0,,Сіз мені ести аласыз ба?
Dialogue: 0,0:00:53.72,0:00:57.64,Default,,0,0,0,,Тастағандардың дауыстары
Dialogue: 0,0:01:09.86,0:01:10.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:13.99,0:01:14.94,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:01:29.21,0:01:31.21,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:01:33.71,0:01:35.97,Default,,0,0,0,,Бұл не дірілдеп тұр?
Dialogue: 0,0:01:36.05,0:01:38.59,Default,,0,0,0,,Білмеймін, мен оны ешқашан сезген емеспін...
Dialogue: 0,0:01:39.55,0:01:40.89,Default,,0,0,0,,Бұл жиіркенішті сезіледі.
Dialogue: 0,0:01:41.89,0:01:43.89,Default,,0,0,0,,Сіз сынаны шығардыңыз ба?
Dialogue: 0,0:01:43.97,0:01:46.68,Default,,0,0,0,,Үш дүниені біріктіретін сына
Dialogue: 0,0:01:47.48,0:01:50.61,Default,,0,0,0,,Балалар, не ойлап тұрсыңдар?
Dialogue: 0,0:01:51.65,0:01:53.73,Default,,0,0,0,,Дірілдеп тұр... дұрыс па?
Dialogue: 0,0:01:53.82,0:01:55.19,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:01:55.28,0:01:56.40,Default,,0,0,0,,Не болды!
Dialogue: 0,0:02:12.50,0:02:14.00,Default,,0,0,0,,Бұл діріл...
Dialogue: 0,0:02:14.92,0:02:15.92,Default,,0,0,0,,Сіз мені ести аласыз ба?
Dialogue: 0,0:02:16.71,0:02:19.88,Default,,0,0,0,,Жаңа дүниенің ізі
Dialogue: 0,0:02:20.47,0:02:25.47,Default,,0,0,0,,Мен бұл бітпейтін қорлықты аяқтаймын.
Dialogue: 0,0:02:30.10,0:02:33.36,Default,,0,0,0,,Юхабах мен сені тоқтату үшін келдім.
Dialogue: 0,0:02:34.40,0:02:35.78,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:02:35.86,0:02:38.07,Default,,0,0,0,,Ичиго Куросаки
Dialogue: 0,0:02:40.53,0:02:42.53,Default,,0,0,0,,♪～
Dialogue: 0,0:04:07.91,0:04:09.91,Default,,0,0,0,,～♪
Dialogue: 0,0:04:17.25,0:04:19.21,Default,,0,0,0,,Мен бәрін көре алдым
Dialogue: 0,0:04:19.71,0:04:24.05,Default,,0,0,0,,Менің ойымша, сіз Рух патшасын өлтірмеу үшін мені тоқтатуға келдіңіз.
Dialogue: 0,0:04:24.55,0:04:25.43,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:04:26.18,0:04:27.14,Default,,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:04:27.64,0:04:31.14,Default,,0,0,0,,Куросаки-кун, ол адамның көзінде бір нәрсе бар...
Dialogue: 0,0:04:31.64,0:04:33.56,Default,,0,0,0,,Бұл қандай көздер?
Dialogue: 0,0:04:34.27,0:04:37.36,Default,,0,0,0,,Бұл көз бәрін көретін көз
Dialogue: 0,0:04:37.44,0:04:40.73,Default,,0,0,0,,Нағыз Квинси туралы куәлік
Dialogue: 0,0:04:40.82,0:04:43.82,Default,,0,0,0,,Бәрі менің қолымда
Dialogue: 0,0:04:44.40,0:04:48.28,Default,,0,0,0,,Рух патшасының болашағы және сіздің де болашағыңыз.
Dialogue: 0,0:04:49.66,0:04:53.16,Default,,0,0,0,,Бұндай жағдайға жол бермеңіз Билік сол үшін
Dialogue: 0,0:04:53.25,0:04:56.21,Default,,0,0,0,,Екі Занпакутос?
Dialogue: 0,0:04:56.71,0:04:59.67,Default,,0,0,0,,Жарайды, көріңіз.
Dialogue: 0,0:04:59.75,0:05:02.96,Default,,0,0,0,,Сіз мені сол пышақпен тесе аласыз ба?
Dialogue: 0,0:05:03.05,0:05:05.43,Default,,0,0,0,,Ол қайтадан бұзыла ма?
Dialogue: 0,0:05:24.19,0:05:25.49,Default,,0,0,0,,Гецуга Теншо
Dialogue: 0,0:05:45.76,0:05:46.26,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:54.27,0:05:55.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:56.27,0:05:58.02,Default,,0,0,0,,Мен шатастырдым.
Dialogue: 0,0:05:58.56,0:05:59.98,Default,,0,0,0,,Ұлы киелі садақ (Санкт Бөген)
Dialogue: 0,0:06:00.06,0:06:00.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:12.45,0:06:12.95,Default,,0,0,0,,Һм?
Dialogue: 0,0:06:19.17,0:06:21.42,Default,,0,0,0,,Гецуга Теншо?
Dialogue: 0,0:06:23.00,0:06:26.01,Default,,0,0,0,,Түсіндім, бұл шебер нәрсе.
Dialogue: 0,0:06:27.55,0:06:28.67,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:37.93,0:06:38.60,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:49.90,0:06:51.86,Default,,0,0,0,,Не болды? Тек оны қабылдайсыз ба?
Dialogue: 0,0:06:51.95,0:06:56.49,Default,,0,0,0,,Бұл деңгейде қорқа бастағаннан кейін өлім ғана қалады.
Dialogue: 0,0:06:56.58,0:06:57.75,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:06:59.71,0:07:01.79,Default,,0,0,0,,Азап сақинасы (Квар Крейс)
Dialogue: 0,0:07:08.63,0:07:11.63,Default,,0,0,0,,Тағы да қараңғыда ұйықта, Ичиго
Dialogue: 0,0:07:16.39,0:07:17.35,Default,,0,0,0,,Һм?
Dialogue: 0,0:07:17.43,0:07:18.85,Default,,0,0,0,,Гецуга...
Dialogue: 0,0:07:18.93,0:07:21.48,Default,,0,0,0,,Ғибадатханаға табыну (Әулие Цвингер)!
Dialogue: 0,0:07:22.60,0:07:25.31,Default,,0,0,0,,Айқышқа шегелу!
Dialogue: 0,0:07:29.61,0:07:31.45,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:07:39.95,0:07:44.38,Default,,0,0,0,,Бұл... Куросаки-кунның жаңа билігі.
Dialogue: 0,0:07:57.89,0:08:00.64,Default,,0,0,0,,Бітті, Юхабах.
Dialogue: 0,0:08:03.19,0:08:04.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:05.15,0:08:10.99,Default,,0,0,0,,Мұндағы жаттығуларыңыз арқылы сіздің күшіңіз күшейген сияқты.
Dialogue: 0,0:08:11.07,0:08:15.28,Default,,0,0,0,,Нөлдік жасақтың басшылығымен тыйым салынған жолға аяқ басты.
Dialogue: 0,0:08:15.36,0:08:21.58,Default,,0,0,0,,Мәңгілік есте сақтау және түсіндіру арқылы бәрі жақсы.
Dialogue: 0,0:08:21.66,0:08:22.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:22.75,0:08:24.62,Default,,0,0,0,,Сіз неге...
Dialogue: 0,0:08:25.46,0:08:28.13,Default,,0,0,0,,Әлі де жеткіліксіз
Dialogue: 0,0:08:28.63,0:08:33.38,Default,,0,0,0,,Сізбен ұрыста мен әлі де...
Dialogue: 0,0:08:33.47,0:08:37.30,Default,,0,0,0,,Ештеңеге қарама, Ичиго.
Dialogue: 0,0:08:37.39,0:08:38.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:40.51,0:08:43.10,Default,,0,0,0,,Енді шайқас басталады
Dialogue: 0,0:08:44.31,0:08:45.69,Default,,0,0,0,,Мен де...
Dialogue: 0,0:08:48.19,0:08:51.44,Default,,0,0,0,,Алға қадам басайық.
Dialogue: 0,0:08:59.99,0:09:00.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:02.79,0:09:03.91,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:04.00,0:09:06.42,Default,,0,0,0,,Гецуга Теншо!
Dialogue: 0,0:09:11.25,0:09:12.30,Default,,0,0,0,,Көрінетін
Dialogue: 0,0:09:18.64,0:09:21.64,Default,,0,0,0,,Сіз жасайтын барлық нәрсе
Dialogue: 0,0:09:22.14,0:09:24.93,Default,,0,0,0,,Сіз оны көре алмайсыз.
Dialogue: 0,0:09:25.89,0:09:27.94,Default,,0,0,0,,Білу мүмкін емес пе?
Dialogue: 0,0:09:28.02,0:09:30.19,Default,,0,0,0,,Күш айырмашылығы
Dialogue: 0,0:09:31.90,0:09:36.45,Default,,0,0,0,,Сіз оны көргенде әлі де жүзіңізді көздейсіз бе?
Dialogue: 0,0:09:36.53,0:09:38.57,Default,,0,0,0,,ақымақ
Dialogue: 0,0:09:39.45,0:09:40.45,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:44.41,0:09:45.62,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:09:48.33,0:09:51.04,Default,,0,0,0,,Маған қанша жүзді көрсетсең, сонша жүз
Dialogue: 0,0:09:51.13,0:09:54.84,Default,,0,0,0,,Үмітсіз қаласың, Ичиго.
Dialogue: 0,0:09:55.67,0:09:56.97,Default,,0,0,0,,Мен сені жеңемін...
Dialogue: 0,0:09:57.05,0:09:59.93,Default,,0,0,0,,«Жеңілу және қорғау»?
Dialogue: 0,0:10:01.51,0:10:03.72,Default,,0,0,0,,Сен мені неше рет айтуға мәжбүрлейсің?
Dialogue: 0,0:10:03.81,0:10:07.10,Default,,0,0,0,,Сіздің болашағыңыз көз алдында
Dialogue: 0,0:10:12.90,0:10:13.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:31.63,0:10:32.84,Default,,0,0,0,,Шайқау тоқтамайды
Dialogue: 0,0:10:32.92,0:10:34.67,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:34.75,0:10:37.38,Default,,0,0,0,,Урахара бірдеңені ұғып алған болуы керек.
Dialogue: 0,0:10:37.47,0:10:39.09,Default,,0,0,0,,Мен Технологияларды дамыту бюросына бара жатырмын.
Dialogue: 0,0:10:39.18,0:10:40.43,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:10:40.51,0:10:41.22,Default,,0,0,0,,Осылай ма?
Dialogue: 0,0:10:41.30,0:10:42.68,Default,,0,0,0,,Осылай оян!
Dialogue: 0,0:10:43.97,0:10:45.68,Default,,0,0,0,,Қандай ұзақ дүмпу.
Dialogue: 0,0:10:45.77,0:10:48.85,Default,,0,0,0,,Қалған капитандар жақсы ма?
Dialogue: 0,0:10:48.93,0:10:52.77,Default,,0,0,0,,Сіз қауіпсіз болсаңыз, басқалардың да қауіпсіз екеніне сенімдімін.
Dialogue: 0,0:10:52.86,0:10:54.52,Default,,0,0,0,,Мен көремін. Бұл дұрыс.
Dialogue: 0,0:10:54.61,0:10:55.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:55.61,0:10:57.40,Default,,0,0,0,,Емдеу Жақсы орындалды
Dialogue: 0,0:10:57.49,0:10:58.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:58.65,0:11:01.24,Default,,0,0,0,,Улы тіліңді емдей алмаған сияқтымын.
Dialogue: 0,0:11:01.32,0:11:01.99,Default,,0,0,0,,Иә
Dialogue: 0,0:11:02.49,0:11:05.08,Default,,0,0,0,,Ха! Мен... кешіріңіз.
Dialogue: 0,0:11:05.16,0:11:06.74,Default,,0,0,0,,Бұл қалыпты емес діріл
Dialogue: 0,0:11:06.83,0:11:08.79,Default,,0,0,0,,Ал ауадағы өзгерістер
Dialogue: 0,0:11:09.29,0:11:11.25,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:11:11.33,0:11:14.09,Default,,0,0,0,,Ойланып қарасаң да, одан ештеңе шықпайды.
Dialogue: 0,0:11:14.17,0:11:16.38,Default,,0,0,0,,Бос сөз айтсаң, оны таста.
Dialogue: 0,0:11:16.46,0:11:17.46,Default,,0,0,0,,Хун
Dialogue: 0,0:11:17.55,0:11:19.55,Default,,0,0,0,,А, енді не істейсің?
Dialogue: 0,0:11:23.97,0:11:25.05,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:11:25.64,0:11:27.22,Default,,0,0,0,,Әлі өлме
Dialogue: 0,0:11:28.93,0:11:30.81,Default,,0,0,0,,Әлі өлме
Dialogue: 0,0:11:38.07,0:11:39.82,Default,,0,0,0,,Урахара-санның айтуынша,
Dialogue: 0,0:11:39.90,0:11:42.91,Default,,0,0,0,,Қақпа жасау үшін көп мөлшерде рейатсу қажет.
Dialogue: 0,0:11:42.99,0:11:44.24,Default,,0,0,0,,Мұнда тек есептеу құрылғысы...
Dialogue: 0,0:11:44.95,0:11:45.99,Default,,0,0,0,,Урахара мырза
Dialogue: 0,0:11:46.08,0:11:47.12,Default,,0,0,0,,Не?
Dialogue: 0,0:11:47.95,0:11:49.12,Default,,0,0,0,,Бұл шайқас
Dialogue: 0,0:11:49.20,0:11:53.87,Default,,0,0,0,,Мұның бәрі осыдан мың жыл бұрынғы Грим Реапер мен Квинси арасындағы қарым-қатынастан туындайды, солай емес пе?
Dialogue: 0,0:11:53.96,0:11:55.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:55.08,0:11:56.67,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:11:56.75,0:12:01.34,Default,,0,0,0,,Квинси Рух Корольінің сарайына «Қырық Орақты» жоймай шықты ма?
Dialogue: 0,0:12:07.81,0:12:09.97,Default,,0,0,0,,Сіз де көрген боларсыз.
Dialogue: 0,0:12:10.06,0:12:13.23,Default,,0,0,0,,Бір кездері болған мәңгілік әлем
Dialogue: 0,0:12:13.31,0:12:15.94,Default,,0,0,0,,Мәңгілікке қауіп төндіретін қараңғылық
Dialogue: 0,0:12:16.44,0:12:20.11,Default,,0,0,0,,Рух Патшасының қараңғылықтан қорғайтын күші.
Dialogue: 0,0:12:20.61,0:12:24.57,Default,,0,0,0,,Бірақ дүниені төңкеруге құдіреті барлар да
Dialogue: 0,0:12:24.66,0:12:28.24,Default,,0,0,0,,Әлемдегі тұрақтылық үшін пайдаланылды.
Dialogue: 0,0:12:28.33,0:12:31.12,Default,,0,0,0,,Үш әлемді де қараңыз
Dialogue: 0,0:12:31.20,0:12:34.42,Default,,0,0,0,,Мың жылды ілгері көзбен көру
Dialogue: 0,0:12:35.04,0:12:37.63,Default,,0,0,0,,Тіпті біздің Квинстердің бақытсыздығы
Dialogue: 0,0:12:38.63,0:12:42.30,Default,,0,0,0,,Рух патшасы Адонайдың көрегендігі болды.
Dialogue: 0,0:12:42.38,0:12:46.55,Default,,0,0,0,,Ол Квинсиді алдын ала көріп, тастап кетті.
Dialogue: 0,0:12:46.64,0:12:48.85,Default,,0,0,0,,Олар Квинси
Dialogue: 0,0:12:48.93,0:12:52.06,Default,,0,0,0,,Өйткені бұл дүниенің шеңберіне сыймайды
Dialogue: 0,0:12:52.14,0:12:55.06,Default,,0,0,0,,Мен екі рет құрдымға кете жаздадым.
Dialogue: 0,0:12:55.14,0:12:57.44,Default,,0,0,0,,Квинси патшасы
Dialogue: 0,0:12:57.52,0:13:00.82,Default,,0,0,0,,Рух Патшасының сарайына кіру арқылы не істегіңіз келеді?
Dialogue: 0,0:13:01.48,0:13:03.07,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:13:04.28,0:13:07.24,Default,,0,0,0,,Сондықтан мен жолды белгіледім
Dialogue: 0,0:13:07.74,0:13:09.58,Default,,0,0,0,,Әкемді өлтірді
Dialogue: 0,0:13:10.41,0:13:15.46,Default,,0,0,0,,Ал біз жаңа әлем жасаған кезде
Dialogue: 0,0:13:20.46,0:13:21.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:29.80,0:13:34.85,Default,,0,0,0,,Қылышыңды маған бағыттауға себеп бар ма?
Dialogue: 0,0:13:35.73,0:13:39.06,Default,,0,0,0,,Мен мұнда сені тоқтату үшін келдім.
Dialogue: 0,0:13:39.15,0:13:43.94,Default,,0,0,0,,Сізді тоқтатыңыз, Жан қоғамы, бұл әлем және қиял әлемі.
Dialogue: 0,0:13:44.03,0:13:46.15,Default,,0,0,0,,үшінн қорғау үшін!
Dialogue: 0,0:13:47.61,0:13:52.33,Default,,0,0,0,,Сізден ағып жатқан Квинси қаны Рух Патшасын кешіреді.
Dialogue: 0,0:13:54.33,0:13:55.12,Default,,0,0,0,,Һм?
Dialogue: 0,0:14:00.42,0:14:01.17,Default,,0,0,0,,Гецуга...
Dialogue: 0,0:14:02.50,0:14:05.67,Default,,0,0,0,,Кешіріңіз, адамдар.
Dialogue: 0,0:14:05.76,0:14:09.26,Default,,0,0,0,,Теншо!
Dialogue: 0,0:14:10.39,0:14:12.10,Default,,0,0,0,,Апыр-ай, жақсы болды. Сонымен, іс шешілді ғой?
Dialogue: 0,0:14:12.76,0:14:16.10,Default,,0,0,0,,Джухабахты өз бетімен жеңе алмайсың.
Dialogue: 0,0:14:16.73,0:14:18.77,Default,,0,0,0,,Картопқа алаңдамаңыз
Dialogue: 0,0:14:22.31,0:14:23.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:25.90,0:14:29.57,Default,,0,0,0,,Татулық деген осы.
Dialogue: 0,0:14:30.74,0:14:33.95,Default,,0,0,0,,Сәлем Джухабах!
Dialogue: 0,0:14:44.59,0:14:46.84,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:14:46.92,0:14:49.59,Default,,0,0,0,,Бұл Zero Squad шабуылға ұшырады дегенді білдірмейді, солай емес пе?
Dialogue: 0,0:14:49.68,0:14:50.84,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:14:50.93,0:14:54.43,Default,,0,0,0,,Десе де, рухани қысым Сейрейтейді де шайқайтындай күшті.
Dialogue: 0,0:14:54.51,0:14:57.06,Default,,0,0,0,,Мүмкін Zero Squad тобынан біреу шығар
Dialogue: 0,0:14:57.14,0:15:01.31,Default,,0,0,0,,Оның Bankai немесе соған ұқсас нәрсені пайдаланғанына күмән жоқ.
Dialogue: 0,0:15:01.40,0:15:05.11,Default,,0,0,0,,Сонымен, үздіксіз шайқау сол әсерге байланысты?
Dialogue: 0,0:15:05.19,0:15:06.90,Default,,0,0,0,,Бұл жақсы болар еді...
Dialogue: 0,0:15:06.98,0:15:09.11,Default,,0,0,0,,Мен мазасызданамын.
Dialogue: 0,0:15:09.78,0:15:12.16,Default,,0,0,0,,Ичиго мен басқаларға ештеңе болмайды деп үміттенемін...
Dialogue: 0,0:15:12.66,0:15:14.99,Default,,0,0,0,,Неге сонша ашулы көрінесің?
Dialogue: 0,0:15:15.08,0:15:18.91,Default,,0,0,0,,Қандай жағдай болмасын, олар Джухабахты тоқтатуға бел буады.
Dialogue: 0,0:15:19.00,0:15:20.54,Default,,0,0,0,,Мен Рух патша сарайына бардым.
Dialogue: 0,0:15:21.21,0:15:24.13,Default,,0,0,0,,Біз бұған сенуіміз керек.
Dialogue: 0,0:15:24.63,0:15:26.88,Default,,0,0,0,,Уайымдайтын ештеңе жоқ, солай ма?
Dialogue: 0,0:15:27.38,0:15:28.13,Default,,0,0,0,,Иә
Dialogue: 0,0:15:28.88,0:15:31.63,Default,,0,0,0,,Бұл сіздің айтқаныңыз жақсы, солай емес пе?
Dialogue: 0,0:15:31.72,0:15:32.51,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:15:33.01,0:15:35.30,Default,,0,0,0,,Иә? Мен үшін?
Dialogue: 0,0:15:35.39,0:15:39.18,Default,,0,0,0,,Ғылыми-зерттеу институтына ешкім айтпай-ақ келе алатын сияқты.
Dialogue: 0,0:15:41.48,0:15:45.06,Default,,0,0,0,,үшінңызға сәлем, біз сіздерді күттік.
Dialogue: 0,0:15:45.15,0:15:48.86,Default,,0,0,0,,Күтудің қажеті жоқ. Кездейсоқ нәрселерді қалдырмаңыз. Ақымақ.
Dialogue: 0,0:15:48.94,0:15:51.45,Default,,0,0,0,,Мен бұл орынды деп айтқан жоқпын.
Dialogue: 0,0:15:51.53,0:15:55.24,Default,,0,0,0,,Бізге қазірден бастап сіздің көмегіңіз керек болады.
Dialogue: 0,0:15:55.32,0:15:56.24,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:15:56.33,0:15:58.95,Default,,0,0,0,,Сіз бұл шайқаудың себебін білмейсіз бе?
Dialogue: 0,0:16:00.62,0:16:02.83,Default,,0,0,0,,Мен нақты білмеймін
Dialogue: 0,0:16:03.46,0:16:05.96,Default,,0,0,0,,Егер сіз бір нәрсені білсеңіз
Dialogue: 0,0:16:06.04,0:16:10.09,Default,,0,0,0,,Бұл Рух Патшасының аман қалуына қауіп төнген жер асты дүмпуі.
Dialogue: 0,0:16:10.67,0:16:13.22,Default,,0,0,0,,үшінн қорғау...?
Dialogue: 0,0:16:13.30,0:16:14.59,Default,,0,0,0,,Бұл менмендік.
Dialogue: 0,0:16:15.18,0:16:19.43,Default,,0,0,0,,Сіз мұны өзіңізден басқа ешкім жасай алмайды деп ойлайсыз ба?
Dialogue: 0,0:16:19.52,0:16:22.02,Default,,0,0,0,,Менен басқа біреудің қолынан келсе де
Dialogue: 0,0:16:22.69,0:16:26.02,Default,,0,0,0,,Менің мұны істемей қашып кетуіме себеп жоқ!
Dialogue: 0,0:16:26.61,0:16:30.07,Default,,0,0,0,,Жан қоғамын тұрақтандыру
Dialogue: 0,0:16:30.15,0:16:34.86,Default,,0,0,0,,Патшаның құрбандықтан басқа ештеңе емес екенін біле тұра, сіз әлі де қорғаныс үшін күресесіз бе?
Dialogue: 0,0:16:34.95,0:16:36.87,Default,,0,0,0,,Қалай сөйлеу керек
Dialogue: 0,0:16:38.08,0:16:39.91,Default,,0,0,0,,Сіздің арқаңызда олқылықтар көп.
Dialogue: 0,0:16:40.58,0:16:43.29,Default,,0,0,0,,Түртіп алсаң, жыртылады. Қозғалма.
Dialogue: 0,0:16:43.37,0:16:46.33,Default,,0,0,0,,Құдайдың қаруы Өрмекші торын жыртады
Dialogue: 0,0:16:54.22,0:16:56.47,Default,,0,0,0,,Мен бәрін көре алдым
Dialogue: 0,0:16:57.18,0:17:00.85,Default,,0,0,0,,Сіз діни қызметкермен кездесіп, қайта тірілесіз.
Dialogue: 0,0:17:00.93,0:17:05.48,Default,,0,0,0,,Мені осында көрінуге көндірді.
Dialogue: 0,0:17:05.56,0:17:09.86,Default,,0,0,0,,Сіз тым кеш келген шығарсыз
Dialogue: 0,0:17:09.94,0:17:10.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:16.53,0:17:17.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:21.29,0:17:23.87,Default,,0,0,0,,Түксіз қорлау
Dialogue: 0,0:17:24.58,0:17:26.29,Default,,0,0,0,,Енді аяқтайық
Dialogue: 0,0:17:26.79,0:17:29.25,Default,,0,0,0,,Қош бол, Рух патшасы
Dialogue: 0,0:17:29.75,0:17:32.67,Default,,0,0,0,,Бұл Рух Патшасы ма?
Dialogue: 0,0:17:33.34,0:17:36.68,Default,,0,0,0,,Рух патшасын өлтіргеніңізге сене алар емеспін!
Dialogue: 0,0:17:37.30,0:17:39.64,Default,,0,0,0,,Жоқ... ол әлі тірі.
Dialogue: 0,0:17:41.39,0:17:42.56,Default,,0,0,0,,Гах...!
Dialogue: 0,0:17:42.64,0:17:44.48,Default,,0,0,0,,- (Орихиме) Куросаки-кун! -(Чадо) Ичиго!
Dialogue: 0,0:17:44.98,0:17:46.19,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:17:46.69,0:17:48.81,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:17:48.90,0:17:51.27,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:17:52.36,0:17:54.65,Default,,0,0,0,,Сол қылышты қынынан шеш...
Dialogue: 0,0:17:54.74,0:17:58.41,Default,,0,0,0,,Кең ашық алаңда шын мәнінде өзін көрсетеді, иә?
Dialogue: 0,0:18:00.99,0:18:06.41,Default,,0,0,0,,Жан қоғамын өз қолыңызбен құртыңыз.
Dialogue: 0,0:18:07.21,0:18:09.25,Default,,0,0,0,,Уф... ау!
Dialogue: 0,0:18:10.46,0:18:11.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:11.38,0:18:13.63,Default,,0,0,0,,Мен оны көрдім, Ичиго.
Dialogue: 0,0:18:13.71,0:18:19.97,Default,,0,0,0,,Сіздің ішіңіздегі Квинси қаны Рух Патшасының болуына ешқашан жол бермейді.
Dialogue: 0,0:18:20.59,0:18:22.43,Default,,0,0,0,,Рұқсат етпеу керек
Dialogue: 0,0:18:22.51,0:18:24.43,Default,,0,0,0,,Рұқсат етпеу керек
Dialogue: 0,0:18:24.93,0:18:28.85,Default,,0,0,0,,Егер сіздің тамырыңызда Квинси қаны болса.
Dialogue: 0,0:18:29.35,0:18:32.27,Default,,0,0,0,,Сіз Рух Патшасын өлтіруіңіз керек!
Dialogue: 0,0:18:34.44,0:18:38.24,Default,,0,0,0,,Арх!
Dialogue: 0,0:19:05.72,0:19:08.48,Default,,0,0,0,,Жарайсың балам
Dialogue: 0,0:19:09.56,0:19:13.56,Default,,0,0,0,,Мен саған қылышымда тұратын рухани қысымды бердім.
Dialogue: 0,0:19:14.06,0:19:17.82,Default,,0,0,0,,Бұл күш сіздің қаныңызға шақырды.
Dialogue: 0,0:19:18.32,0:19:21.61,Default,,0,0,0,,Сіздің мінез-құлқыңыз Сіздің еркіңіз
Dialogue: 0,0:19:21.70,0:19:26.62,Default,,0,0,0,,Сен туралы бәрі менің еркіммен байланысты.
Dialogue: 0,0:19:27.62,0:19:31.33,Default,,0,0,0,,Рух патшасының мөрін қалай толығымен бұзуға болады
Dialogue: 0,0:19:31.42,0:19:38.01,Default,,0,0,0,,...
Dialogue: 0,0:19:38.51,0:19:44.26,Default,,0,0,0,,Маған керек едің, Құдіреттің бәрі бар.
Dialogue: 0,0:19:44.76,0:19:46.93,Default,,0,0,0,,Жоқ... сонда...
Dialogue: 0,0:19:48.47,0:19:52.19,Default,,0,0,0,,Сіз Шинигами ретінде ояндыңыз.
Dialogue: 0,0:19:52.27,0:19:54.94,Default,,0,0,0,,Ол да шынайы күшке ие болды.
Dialogue: 0,0:19:55.02,0:20:00.86,Default,,0,0,0,,Рух патшасының өмірі менің көз алдымда аяқталады.
Dialogue: 0,0:20:00.94,0:20:03.70,Default,,0,0,0,,Бұл оқиға үшін болды
Dialogue: 0,0:20:05.03,0:20:09.70,Default,,0,0,0,,Міне, мен көрген болашақ
Dialogue: 0,0:20:27.39,0:20:29.56,Default,,0,0,0,,(Азаматтардың дауыстары шошып кетті)
Dialogue: 0,0:20:29.64,0:20:31.06,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:32.35,0:20:33.81,Default,,0,0,0,,-Уау! - (Ушу) Уф!
Dialogue: 0,0:20:48.20,0:20:50.58,Default,,0,0,0,,Жер сілкінісінің ошағы туралы ақпарат жоқ.
Dialogue: 0,0:20:50.66,0:20:53.12,Default,,0,0,0,,Мұндай жер сілкінісі мүмкін емес, солай ма?
Dialogue: 0,0:20:53.21,0:20:54.71,Default,,0,0,0,,Біздің санамызға сәйкес
Dialogue: 0,0:20:54.79,0:20:55.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:56.42,0:20:58.00,Default,,0,0,0,,Мен бұған сенбеймін...
Dialogue: 0,0:21:04.17,0:21:05.13,Default,,0,0,0,,Ичиго…
Dialogue: 0,0:21:12.22,0:21:13.39,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:14.27,0:21:16.48,Default,,0,0,0,,Рух патшасы өлді!
Dialogue: 0,0:21:16.56,0:21:18.11,Default,,0,0,0,,Уақытында үлгермедің бе?
Dialogue: 0,0:21:18.19,0:21:20.90,Default,,0,0,0,,Бұл өтірік... Zero Squad не істеп жатыр?
Dialogue: 0,0:21:22.07,0:21:23.15,Default,,0,0,0,,Ичиго...
Dialogue: 0,0:21:23.24,0:21:25.07,Default,,0,0,0,,Ичигоға не болды?
Dialogue: 0,0:21:25.15,0:21:26.66,Default,,0,0,0,,Сабыр ет, ақымақ!
Dialogue: 0,0:21:27.32,0:21:31.49,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,0:21:32.87,0:21:36.54,Default,,0,0,0,,Осылай жалғаса беретіні анық, Сейрейтей...
Dialogue: 0,0:21:37.29,0:21:37.79,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:37.87,0:21:39.67,Default,,0,0,0,,Жан қоғамы да
Dialogue: 0,0:21:39.75,0:21:41.42,Default,,0,0,0,,Сондай-ақ Hueco Mundo
Dialogue: 0,0:21:41.50,0:21:43.17,Default,,0,0,0,,Тіпті бұл дүниеде де
Dialogue: 0,0:21:44.46,0:21:46.17,Default,,0,0,0,,Сөндіру
Dialogue: 0,0:21:53.35,0:21:56.31,Default,,0,0,0,,Кел, Ичиго.
Dialogue: 0,0:21:56.81,0:21:58.44,Default,,0,0,0,,Бірге тамашалайық
Dialogue: 0,0:22:00.27,0:22:05.19,Default,,0,0,0,,Жан қоғамының соңы
Dialogue: 0,0:22:06.53,0:22:08.53,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.99,0:23:33.99,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.62,0:23:39.41,Default,,0,0,0,,Мен бір кездері сен едім
Dialogue: 0,0:23:39.91,0:23:43.00,Default,,0,0,0,,Сен бір күні мен боласың
Dialogue: 0,0:23:43.75,0:23:46.09,Default,,0,0,0,,Кем дегенде сіздің арқаңызда
Dialogue: 0,0:23:46.59,0:23:49.17,Default,,0,0,0,,Өмірге жеңіл қаралсын
Dialogue: 0,0:23:50.67,0:23:56.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
