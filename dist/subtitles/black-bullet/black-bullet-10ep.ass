Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.21,0:00:05.54,Default,,0,0,0,,(секундомер сигналы)
Dialogue: 0,0:00:07.29,0:00:08.59,Default,,0,0,0,,Уақыт келді. Міне бітті.
Dialogue: 0,0:00:08.67,0:00:11.55,Default,,0,0,0,,Иә, жауаптарды арт жағынан жинаңыз.
Dialogue: 0,0:00:12.67,0:00:13.55,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:00:13.63,0:00:14.63,Default,,0,0,0,,мүмкін емес
Dialogue: 0,0:00:14.72,0:00:16.68,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:00:17.18,0:00:19.01,Default,,0,0,0,,Келесі жолы осы басып шығаруды өткізіңіз.
Dialogue: 0,0:00:24.48,0:00:27.94,Default,,0,0,0,,Ах, «болашақ армандар»?
Dialogue: 0,0:00:28.02,0:00:34.20,Default,,0,0,0,,♪～
Dialogue: 0,0:01:51.73,0:01:57.95,Default,,0,0,0,,～♪
Dialogue: 0,0:01:59.53,0:02:00.45,Default,,0,0,0,,Осылайша...
Dialogue: 0,0:02:01.07,0:02:03.79,Default,,0,0,0,,Монолит үш күнде құлап қалады.
Dialogue: 0,0:02:03.87,0:02:05.33,Default,,0,0,0,,Өтірік сияқты естіледі
Dialogue: 0,0:02:06.12,0:02:07.33,Default,,0,0,0,,Мен істеп жатырмын
Dialogue: 0,0:02:08.25,0:02:09.54,Default,,0,0,0,,Мацузаки мырза
Dialogue: 0,0:02:09.67,0:02:13.75,Default,,0,0,0,,Осындай қиын кезеңде де өз сыныбыңызды ашқаныңыз үшін рахмет.
Dialogue: 0,0:02:13.84,0:02:14.84,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:15.26,0:02:16.63,Default,,0,0,0,,Бөлек
Dialogue: 0,0:02:17.05,0:02:19.22,Default,,0,0,0,,Бұл әрекет сізді алаңдатады.
Dialogue: 0,0:02:19.63,0:02:21.93,Default,,0,0,0,,Бұл балаларға да солай.
Dialogue: 0,0:02:22.22,0:02:25.85,Default,,0,0,0,,Сондықтан мен сізге ризамын.
Dialogue: 0,0:02:27.10,0:02:28.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:28.31,0:02:29.60,Default,,0,0,0,,Уфуфу (Мацузаки) Фуфуфу
Dialogue: 0,0:02:29.77,0:02:31.23,Default,,0,0,0,,Орындалды! Рентаро
Dialogue: 0,0:02:32.90,0:02:34.07,Default,,0,0,0,,Оны білмейсің бе? Картаға қара!
Dialogue: 0,0:02:35.28,0:02:37.24,Default,,0,0,0,,``Кеңестің болашақ арманы қандай?''
Dialogue: 0,0:02:37.32,0:02:39.36,Default,,0,0,0,,«Рентароның әйелі болу»
Dialogue: 0,0:02:39.45,0:02:40.66,Default,,0,0,0,,«Күн сайын қалағаныңызша»
Dialogue: 0,0:02:40.74,0:02:41.91,Default,,0,0,0,,«То чутту»
Dialogue: 0,0:02:44.12,0:02:46.04,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:02:46.12,0:02:47.12,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:02:50.25,0:02:52.13,Default,,0,0,0,,«Менің болашақ армандарым»
Dialogue: 0,0:02:52.21,0:02:54.17,Default,,0,0,0,,«Ағаңның әйелі бол»
Dialogue: 0,0:02:54.25,0:02:55.55,Default,,0,0,0,,«Күн сайын қалағаныңызша»
Dialogue: 0,0:02:55.63,0:02:56.88,Default,,0,0,0,,«То чутту»
Dialogue: 0,0:03:00.26,0:03:01.63,Default,,0,0,0,,Балалар...
Dialogue: 0,0:03:01.72,0:03:04.30,Default,,0,0,0,,(секундомер сигналы)
Dialogue: 0,0:03:04.39,0:03:05.85,Default,,0,0,0,,Жарайды, уақыт келді.
Dialogue: 0,0:03:05.93,0:03:08.06,Default,,0,0,0,,Басып шығаруды арт жағынан бұраңыз (Энджу)!
Dialogue: 0,0:03:08.60,0:03:10.02,Default,,0,0,0,,Сәлем Рентаро!
Dialogue: 0,0:03:10.10,0:03:13.65,Default,,0,0,0,,Менің күңімнің ұсынысына не деп жауап бердіңіз?
Dialogue: 0,0:03:13.73,0:03:15.23,Default,,0,0,0,,Ұсыныс?
Dialogue: 0,0:03:15.52,0:03:18.23,Default,,0,0,0,,Жарайсыңдар, балалар орындарына оралыңдар.
Dialogue: 0,0:03:18.48,0:03:20.74,Default,,0,0,0,,Бүгінгі сабақ осында... Ах.
Dialogue: 0,0:03:25.16,0:03:28.24,Default,,0,0,0,,Кисара мырза, әмияныңызда қанша ақша бар?
Dialogue: 0,0:03:28.45,0:03:29.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:30.25,0:03:31.50,Default,,0,0,0,,(сыдырманың ашылу дыбысы)
Dialogue: 0,0:03:31.58,0:03:33.42,Default,,0,0,0,,Ал...
Dialogue: 0,0:03:35.00,0:03:36.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:38.34,0:03:41.13,Default,,0,0,0,,Жарайды, мен қазір әлеуметтік зерттеулер сабағына барамын.
Dialogue: 0,0:03:41.22,0:03:42.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:44.47,0:03:47.14,Default,,0,0,0,,Уау...
Dialogue: 0,0:03:49.60,0:03:53.02,Default,,0,0,0,,Уау, бұл таңқаларлық (Қыз) Өте жылдам
Dialogue: 0,0:04:00.40,0:04:02.82,Default,,0,0,0,,Бұл «регрессия жалыны» деп аталады.
Dialogue: 0,0:04:02.90,0:04:04.28,Default,,0,0,0,,Регрессия жалыны?
Dialogue: 0,0:04:05.16,0:04:07.99,Default,,0,0,0,,Токио аймағындағы Гастреямен үлкен шайқас...
Dialogue: 0,0:04:08.08,0:04:09.91,Default,,0,0,0,,Өткенде екі рет болған
Dialogue: 0,0:04:10.25,0:04:11.62,Default,,0,0,0,,Екінші рет
Dialogue: 0,0:04:11.70,0:04:14.96,Default,,0,0,0,,Дәл осы жерде «Кантоның екінші шайқасы» өтті.
Dialogue: 0,0:04:17.09,0:04:21.30,Default,,0,0,0,,Бұл қайтару жалыны, соғыстағы жеңіске ескерткіш ретінде...
Dialogue: 0,0:04:21.38,0:04:23.47,Default,,0,0,0,,Алдыңғы Гастрея соғысында қаза тапқан.
Dialogue: 0,0:04:23.55,0:04:25.55,Default,,0,0,0,,Барлық адамдарға арналған ескерткіш ретінде -
Dialogue: 0,0:04:25.64,0:04:27.26,Default,,0,0,0,,Оның екі мағынасы бар.
Dialogue: 0,0:04:28.26,0:04:30.43,Default,,0,0,0,,Сонымен, бұл Генан фестивалімен бірдей ме?
Dialogue: 0,0:04:30.52,0:04:32.14,Default,,0,0,0,,О, сен мені жақсы білесің.
Dialogue: 0,0:04:32.23,0:04:33.56,Default,,0,0,0,,Мен де білемін.
Dialogue: 0,0:04:33.64,0:04:37.27,Default,,0,0,0,,Анау аспан сондай жарқырап, әдемі, солай емес пе?
Dialogue: 0,0:04:37.36,0:04:39.36,Default,,0,0,0,,Бәріміз бірге шарды ұшырайық, солай ма?
Dialogue: 0,0:04:39.77,0:04:43.61,Default,,0,0,0,,Бұл Гастрея соғысында қаза тапқандарға арналған.
Dialogue: 0,0:04:43.70,0:04:46.49,Default,,0,0,0,,Көңіл айту мерекесі.
Dialogue: 0,0:04:46.57,0:04:50.29,Default,,0,0,0,,Айтпақшы, биылғы Генан фестивалі жақында келеді...
Dialogue: 0,0:04:52.83,0:04:57.29,Default,,0,0,0,,Рентаро Сенсей: Біз өлеміз бе?
Dialogue: 0,0:04:57.38,0:05:00.80,Default,,0,0,0,,Биылғы Генан фестивалін көре алмайсыз ба?
Dialogue: 0,0:05:04.22,0:05:05.38,Default,,0,0,0,,Идиот
Dialogue: 0,0:05:05.47,0:05:08.39,Default,,0,0,0,,Мен сені мұнда не үшін әкелгенімді білмейсің бе?
Dialogue: 0,0:05:08.51,0:05:12.72,Default,,0,0,0,,Регрессияның жалыны адамзаттың Гастреяны жеңгенінің дәлелі.
Dialogue: 0,0:05:13.06,0:05:15.98,Default,,0,0,0,,Монолит жойылса да, өзін-өзі қорғау күштері оны қорғайды.
Dialogue: 0,0:05:16.06,0:05:17.69,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:05:17.94,0:05:19.27,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:21.27,0:05:24.99,Default,,0,0,0,,Уайымдамаңыз, Кисара-сенсей екеуміз де азаматтық полиция қызметкеріміз.
Dialogue: 0,0:05:25.07,0:05:27.78,Default,,0,0,0,,Мен алдыңғы шепте соғысуым керек (Қисара) Иә.
Dialogue: 0,0:05:28.11,0:05:29.91,Default,,0,0,0,,Мұғалімдер де төбелесе ме?
Dialogue: 0,0:05:30.33,0:05:31.28,Default,,0,0,0,,О
Dialogue: 0,0:05:31.37,0:05:35.54,Default,,0,0,0,,Міне, мен сенің мұғалімің болдым.
Dialogue: 0,0:05:36.00,0:05:37.42,Default,,0,0,0,,Мен сені дұрыстап қорғаймын.
Dialogue: 0,0:05:37.75,0:05:39.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:39.92,0:05:42.42,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:42.55,0:05:43.71,Default,,0,0,0,,Барлығыңыз жиналыңыздар!
Dialogue: 0,0:05:43.80,0:05:45.55,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:46.59,0:05:50.55,Default,,0,0,0,,(Қыздар сөйлейді)
Dialogue: 0,0:05:54.72,0:05:56.31,Default,,0,0,0,,Мұғалім, мен өттім.
Dialogue: 0,0:05:56.68,0:05:57.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:59.85,0:06:02.98,Default,,0,0,0,,Бізге мұғалім ұнайды.
Dialogue: 0,0:06:03.11,0:06:06.36,Default,,0,0,0,,Мен неке шартымен кездескім келетін 5 адам бар.
Dialogue: 0,0:06:06.44,0:06:08.11,Default,,0,0,0,,Мен де солардың бірімін.
Dialogue: 0,0:06:08.20,0:06:09.82,Default,,0,0,0,,Мен де (қыз) Мен де
Dialogue: 0,0:06:09.99,0:06:11.32,Default,,0,0,0,,Не?
Dialogue: 0,0:06:11.41,0:06:12.28,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:19.33,0:06:20.67,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:06:21.21,0:06:22.88,Default,,0,0,0,,А...
Dialogue: 0,0:06:23.38,0:06:25.38,Default,,0,0,0,,Уау, аа, ой...
Dialogue: 0,0:06:27.38,0:06:28.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:28.51,0:06:33.26,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:35.10,0:06:36.31,Default,,0,0,0,,Хаха…
Dialogue: 0,0:06:38.85,0:06:42.02,Default,,0,0,0,,(Тамаки Катагиридің қорылдауы)
Dialogue: 0,0:06:48.15,0:06:49.28,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:57.54,0:07:00.87,Default,,0,0,0,,«Жақсы, өйткені өзін-өзі қорғау күштері бар»?
Dialogue: 0,0:07:01.96,0:07:03.79,Default,,0,0,0,,Бірақ егер олар...
Dialogue: 0,0:07:03.88,0:07:07.59,Default,,0,0,0,,Егер мен Альдебаранның күшін жете бағаламасам...
Dialogue: 0,0:07:08.92,0:07:10.97,Default,,0,0,0,,Сатоми-кун, ояусың ба?
Dialogue: 0,0:07:11.05,0:07:12.30,Default,,0,0,0,,Кисара мырза?
Dialogue: 0,0:07:16.26,0:07:19.06,Default,,0,0,0,,Қарсы болмасаңыз, аздап серуендейсіз бе?
Dialogue: 0,0:07:19.14,0:07:22.56,Default,,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,0:07:29.61,0:07:31.95,Default,,0,0,0,,Сатоми-кун, оны да түртіп көріңіз.
Dialogue: 0,0:07:35.53,0:07:39.08,Default,,0,0,0,,Бұл сұмдық, варан эрозиясы сұйықтығы.
Dialogue: 0,0:07:41.75,0:07:45.29,Default,,0,0,0,,Монолиттер блоктардан жасалған.
Dialogue: 0,0:07:45.50,0:07:48.59,Default,,0,0,0,,Барлығын бірден көлік ұшағында тасымалдау...
Dialogue: 0,0:07:48.67,0:07:50.30,Default,,0,0,0,,Сайтта қабаттау
Dialogue: 0,0:07:51.09,0:07:53.01,Default,,0,0,0,,100 метр
Dialogue: 0,0:07:53.13,0:07:56.26,Default,,0,0,0,,Егер блоктарды сол биіктікке дейін жинауға болатын болса...
Dialogue: 0,0:07:56.35,0:07:58.81,Default,,0,0,0,,Қалыпты Gastraea енді кірмейді.
Dialogue: 0,0:07:59.47,0:08:00.56,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:08:01.06,0:08:03.56,Default,,0,0,0,,Ең алдымен, сіз монолит салуға тырыссаңыз да...
Dialogue: 0,0:08:03.64,0:08:04.85,Default,,0,0,0,,Тағы да Альдебаранға...
Dialogue: 0,0:08:04.94,0:08:07.90,Default,,0,0,0,,Варан эрозиясы сұйықтығы енгізілгеннен кейін бәрі бітеді...
Dialogue: 0,0:08:08.36,0:08:10.53,Default,,0,0,0,,Жоқ, күте тұрыңыз, олай емес.
Dialogue: 0,0:08:10.65,0:08:12.11,Default,,0,0,0,,Неліктен Альдебаран?
Dialogue: 0,0:08:12.20,0:08:14.16,Default,,0,0,0,,Неліктен басқа монолиттерге шабуыл жасамайсыз?
Dialogue: 0,0:08:15.20,0:08:17.33,Default,,0,0,0,,Монолитке шабуыл жасағанда
Dialogue: 0,0:08:17.41,0:08:20.62,Default,,0,0,0,,Алдебаранның шыдамы таусылған ба деп ойлаймын.
Dialogue: 0,0:08:21.00,0:08:23.33,Default,,0,0,0,,Біраз уақыт үзіліс жасауға тура келетіні сонша.
Dialogue: 0,0:08:23.79,0:08:26.50,Default,,0,0,0,,Мүмкіндік нөлге тең емес...
Dialogue: 0,0:08:27.04,0:08:31.42,Default,,0,0,0,,Мәселе №32 монолитте деп ойлаймын.
Dialogue: 0,0:08:31.71,0:08:33.84,Default,,0,0,0,,А, солай...
Dialogue: 0,0:08:35.80,0:08:39.47,Default,,0,0,0,,Бұл рас, мен бұл туралы ойламаппын.
Dialogue: 0,0:08:39.72,0:08:41.27,Default,,0,0,0,,Жарайды, мен...
Dialogue: 0,0:08:41.35,0:08:44.64,Default,,0,0,0,,No32 монолит туралы білейік
Dialogue: 0,0:08:44.73,0:08:45.98,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:08:52.03,0:08:54.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:54.99,0:08:55.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:00.74,0:09:03.16,Default,,0,0,0,,Кисара мырза, сіз не істеп жатырсыз...
Dialogue: 0,0:09:04.29,0:09:06.83,Default,,0,0,0,,Менің де қасыма Сатоми-кун келсе ше?
Dialogue: 0,0:09:08.33,0:09:09.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.26,0:09:15.72,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:09:15.80,0:09:18.26,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:09:30.11,0:09:31.57,Default,,0,0,0,,Сатоми-кун (Рентаро) Уау
Dialogue: 0,0:09:31.65,0:09:32.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:32.73,0:09:37.07,Default,,0,0,0,,Бұлай айту дөрекі болуы мүмкін, бірақ
Dialogue: 0,0:09:37.32,0:09:40.37,Default,,0,0,0,,Мен қазір бақыттымын
Dialogue: 0,0:09:41.58,0:09:45.16,Default,,0,0,0,,Бізде Енджу-чан мен Тина-чан бар...
Dialogue: 0,0:09:45.25,0:09:47.62,Default,,0,0,0,,Сосын Сатоми-кун бар.
Dialogue: 0,0:09:47.71,0:09:49.29,Default,,0,0,0,,Бұл бір отбасы сияқты
Dialogue: 0,0:09:50.00,0:09:53.25,Default,,0,0,0,,Осының өзі мені қатты қуантады.
Dialogue: 0,0:09:55.26,0:09:56.59,Default,,0,0,0,,Кисара мырза?
Dialogue: 0,0:09:57.51,0:10:03.68,Default,,0,0,0,,Бірақ бір күні бұл бақыттың бітетінін түсінгенде...
Dialogue: 0,0:10:03.89,0:10:06.43,Default,,0,0,0,,Бұл өте қорқынышты
Dialogue: 0,0:10:08.14,0:10:10.27,Default,,0,0,0,,Мен Кисара мырзаны қорғаймын.
Dialogue: 0,0:10:10.65,0:10:15.74,Default,,0,0,0,,Енджу, Тина және мен ешқашан жоғалмаймыз.
Dialogue: 0,0:10:19.11,0:10:21.28,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:10:21.70,0:10:23.99,Default,,0,0,0,,Рахмет, Сатоми-кун
Dialogue: 0,0:10:29.37,0:10:31.25,Default,,0,0,0,,Бүгін аяқталуға жақын
Dialogue: 0,0:10:31.83,0:10:34.00,Default,,0,0,0,,８ ７…
Dialogue: 0,0:10:34.09,0:10:40.30,Default,,0,0,0,,６ ５ ４ ３ ２ １
Dialogue: 0,0:10:42.14,0:10:45.72,Default,,0,0,0,,Монолиттің құлауына екі күн қалды
Dialogue: 0,0:10:48.85,0:10:52.40,Default,,0,0,0,,Бүгін үкімет жариялаған жерасты баспанасы ашылды.
Dialogue: 0,0:10:52.48,0:10:55.52,Default,,0,0,0,,лотерея арқылы таңдалған Токио аймағының 30% азаматтары...
Dialogue: 0,0:10:55.82,0:10:57.78,Default,,0,0,0,,Эвакуация басталған сияқты.
Dialogue: 0,0:10:57.90,0:11:00.24,Default,,0,0,0,,Бірақ бұл эвакуация жоспары туралы...
Dialogue: 0,0:11:00.32,0:11:02.91,Default,,0,0,0,,Азаматтар өз күдіктерін білдірді және жоспарлаудағы кешігулер...
Dialogue: 0,0:11:02.99,0:11:04.53,Default,,0,0,0,,Хаха...
Dialogue: 0,0:11:10.96,0:11:12.50,Default,,0,0,0,,Әлі де күліп тұр
Dialogue: 0,0:11:12.58,0:11:14.21,Default,,0,0,0,,Қандай жиіркенішті бала.
Dialogue: 0,0:11:14.67,0:11:16.42,Default,,0,0,0,,Бірақ мен әлі біраз уақыт үйге оралмаймын.
Dialogue: 0,0:11:17.38,0:11:22.09,Default,,0,0,0,,Сол дауыс... Кешіріңіз, мен уәде бердім.
Dialogue: 0,0:11:22.18,0:11:24.22,Default,,0,0,0,,Бірақ мен шынымен...
Dialogue: 0,0:11:24.55,0:11:25.43,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:11:25.51,0:11:28.77,Default,,0,0,0,,Егер біз олардан құтылмасақ, олар қайтадан адамдарға шабуыл жасайды!
Dialogue: 0,0:11:28.85,0:11:30.06,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:11:30.81,0:11:32.02,Default,,0,0,0,,Азаматтық полиция.
Dialogue: 0,0:11:32.10,0:11:34.19,Default,,0,0,0,,Бұл балаға жақындауға тырысыңыз.
Dialogue: 0,0:11:34.27,0:11:36.27,Default,,0,0,0,,Бұл жолы қорқытудың орнына атыңыз
Dialogue: 0,0:11:36.52,0:11:40.61,Default,,0,0,0,,Уф... Полицейлер құбыжықтың жағында ма?
Dialogue: 0,0:11:44.03,0:11:45.28,Default,,0,0,0,,Я...
Dialogue: 0,0:11:47.28,0:11:48.24,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:11:48.33,0:11:50.00,Default,,0,0,0,,А... иә
Dialogue: 0,0:11:54.71,0:11:56.29,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:11:57.34,0:11:59.92,Default,,0,0,0,,Жақсы сияқты.
Dialogue: 0,0:12:01.30,0:12:02.97,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:12:03.05,0:12:04.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:04.59,0:12:08.39,Default,,0,0,0,,Полицейді мұңайттым.
Dialogue: 0,0:12:08.47,0:12:10.06,Default,,0,0,0,,Жарайды, осы барлық жанама дәлелдер үйіліп жатқанда, менде оны мойындаудан басқа амал қалмады деп ойлаймын.
Dialogue: 0,0:12:10.56,0:12:12.60,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:12.69,0:12:16.11,Default,,0,0,0,,Полицейдің даусы мен жүзі есімде.
Dialogue: 0,0:12:16.27,0:12:18.44,Default,,0,0,0,,Бұл менің сүйікті түрім.
Dialogue: 0,0:12:18.52,0:12:21.44,Default,,0,0,0,,Ақымақ, үйге тез қайт.
Dialogue: 0,0:12:21.61,0:12:23.32,Default,,0,0,0,,Енді бұл жерге келме
Dialogue: 0,0:12:29.74,0:12:30.83,Default,,0,0,0,,Рентаро!
Dialogue: 0,0:12:31.04,0:12:32.46,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:12:32.54,0:12:34.08,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:12:34.62,0:12:36.88,Default,,0,0,0,,Мектеп қалай өтті?
Dialogue: 0,0:12:36.96,0:12:38.71,Default,,0,0,0,,Бүгін де көңілді өтті
Dialogue: 0,0:12:38.79,0:12:39.96,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:40.17,0:12:43.38,Default,,0,0,0,,Өкінішті, Кисара-сан, оны маған қалдыр.
Dialogue: 0,0:12:43.76,0:12:45.13,Default,,0,0,0,,Хамф (Рентаро) Иә?
Dialogue: 0,0:12:45.22,0:12:46.14,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:12:46.68,0:12:48.85,Default,,0,0,0,,Менің ағам бүгін демалыста...
Dialogue: 0,0:12:48.93,0:12:52.02,Default,,0,0,0,,Президент Тендо бір күн мұғалім боламын дегенде...
Dialogue: 0,0:12:52.10,0:12:54.06,Default,,0,0,0,,Көп шуылдады...
Dialogue: 0,0:12:54.35,0:12:58.11,Default,,0,0,0,,Кисара сенси бәрібір танымал емес.
Dialogue: 0,0:12:58.19,0:13:01.90,Default,,0,0,0,,А, жоқ... Сіз маған ұнайсыз, Кисара мырза.
Dialogue: 0,0:13:02.07,0:13:04.61,Default,,0,0,0,,Хм... босаңсуды доғар.
Dialogue: 0,0:13:06.91,0:13:09.16,Default,,0,0,0,,Сәлем әпке
Dialogue: 0,0:13:09.24,0:13:10.95,Default,,0,0,0,,Әпкең жоқта
Dialogue: 0,0:13:11.04,0:13:14.46,Default,,0,0,0,,Мынаны әпкем үшін бір бейтаныс адам алып келді.
Dialogue: 0,0:13:14.54,0:13:15.83,Default,,0,0,0,,О, ерте.
Dialogue: 0,0:13:15.92,0:13:18.42,Default,,0,0,0,,Сіз зерттеуді аяқтадыңыз, рахмет.
Dialogue: 0,0:13:18.50,0:13:20.59,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:13:20.67,0:13:24.22,Default,,0,0,0,,Қараңдаршы, кеше мен айтқан No32 монолит туралы.
Dialogue: 0,0:13:24.67,0:13:27.22,Default,,0,0,0,,Мен бірден оны Twitter-ден іздеуін өтіндім.
Dialogue: 0,0:13:27.84,0:13:30.80,Default,,0,0,0,,Кисара мырза? Ол не дейді?
Dialogue: 0,0:13:31.97,0:13:33.47,Default,,0,0,0,,Ах... эй
Dialogue: 0,0:13:48.57,0:13:51.33,Default,,0,0,0,,Ха! Tendo Wako…
Dialogue: 0,0:13:51.83,0:13:53.33,Default,,0,0,0,,Вако-ниисан?
Dialogue: 0,0:13:55.04,0:13:56.33,Default,,0,0,0,,Кисара мырза...
Dialogue: 0,0:14:09.55,0:14:12.51,Default,,0,0,0,,Тез дайындал, Рентаро, кешігіп қалдың!
Dialogue: 0,0:14:12.60,0:14:13.43,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:14:13.97,0:14:16.64,Default,,0,0,0,,Толық демалысым болса да.
Dialogue: 0,0:14:16.77,0:14:19.44,Default,,0,0,0,,Неліктен мен қазір мектепке баруым керек?
Dialogue: 0,0:14:20.10,0:14:22.73,Default,,0,0,0,,Бұл сізді өкінбейтін сезінуге себеп болмай ма?
Dialogue: 0,0:14:22.90,0:14:26.78,Default,,0,0,0,,Мүмкін, бірақ мен кем дегенде сәлем айтуым керек.
Dialogue: 0,0:14:26.94,0:14:28.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:28.20,0:14:30.82,Default,,0,0,0,,Ең көбі ылғалданбау үшін абай болыңыз.
Dialogue: 0,0:14:33.74,0:14:35.58,Default,,0,0,0,,(Екі адам ұйықтап жатыр)
Dialogue: 0,0:14:36.54,0:14:39.83,Default,,0,0,0,,Ах... Қазір дайындал...
Dialogue: 0,0:14:40.33,0:14:41.38,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:41.71,0:14:44.59,Default,,0,0,0,,Кисара-санды кеше кешке дейін күткен шығарсың.
Dialogue: 0,0:14:45.17,0:14:46.84,Default,,0,0,0,,Кисара-сан оянғаннан кейін менімен бірге жүр.
Dialogue: 0,0:14:48.01,0:14:49.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:51.51,0:14:53.22,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:14:53.30,0:14:54.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:57.02,0:14:59.18,Default,,0,0,0,,Сіз не әкелдіңіз?
Dialogue: 0,0:14:59.27,0:15:03.19,Default,,0,0,0,,Бұл маған Рентаро әкелген «Тенчу қыздары» DVD дискісі.
Dialogue: 0,0:15:03.61,0:15:05.52,Default,,0,0,0,,Оған бәрінің ғашық болатынына сенімдімін.
Dialogue: 0,0:15:05.61,0:15:09.36,Default,,0,0,0,,Олай болса бәріміз Тенчу қыздарын ойнаймыз.
Dialogue: 0,0:15:09.45,0:15:10.70,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:12.74,0:15:18.16,Default,,0,0,0,,Рентаро, мұғалім болу қызық емес пе?
Dialogue: 0,0:15:18.25,0:15:20.08,Default,,0,0,0,,Жоқ, бұл қызық.
Dialogue: 0,0:15:20.58,0:15:21.58,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:21.92,0:15:25.34,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:15:25.59,0:15:30.59,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:15:30.67,0:15:31.68,Default,,0,0,0,,Ах
Dialogue: 0,0:15:31.80,0:15:33.84,Default,,0,0,0,,Рентаро Ересек адам келе жатыр.
Dialogue: 0,0:15:36.85,0:15:39.27,Default,,0,0,0,,Не болды? Рентаро
Dialogue: 0,0:15:40.73,0:15:41.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:45.52,0:15:47.02,Default,,0,0,0,,(сөмкенің құлаған дыбысы)
Dialogue: 0,0:15:47.90,0:15:49.82,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:15:50.57,0:15:51.78,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:06.29,0:16:08.63,Default,,0,0,0,,B...бомба?
Dialogue: 0,0:16:09.17,0:16:10.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:30.40,0:16:31.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:42.29,0:16:46.21,Default,,0,0,0,,Сөз жоқ, олардың барлығы менің шәкірттерім.
Dialogue: 0,0:16:48.96,0:16:51.21,Default,,0,0,0,,Миллей (полицей) Иә?
Dialogue: 0,0:16:52.09,0:16:55.34,Default,,0,0,0,,Аты-жөні. Бұл Милэй.
Dialogue: 0,0:16:56.14,0:16:57.59,Default,,0,0,0,,Көрші есік – Лука
Dialogue: 0,0:16:58.72,0:17:00.14,Default,,0,0,0,,Оның жанында...
Dialogue: 0,0:17:00.22,0:17:01.47,Default,,0,0,0,,Аты жақсы
Dialogue: 0,0:17:02.02,0:17:04.81,Default,,0,0,0,,Ғайша отбасылық тіркеуі жоқ «балалар».
Dialogue: 0,0:17:05.14,0:17:07.90,Default,,0,0,0,,Жеке басыңызды растай алатын болсаңыз, бұл жақсы.
Dialogue: 0,0:17:14.45,0:17:16.24,Default,,0,0,0,,Жібер! (Офицер) Эй!
Dialogue: 0,0:17:16.32,0:17:18.24,Default,,0,0,0,,Уф, сен мені жібер деп тұрсың!
Dialogue: 0,0:17:18.62,0:17:21.12,Default,,0,0,0,,Ха, Рентаро!
Dialogue: 0,0:17:23.79,0:17:26.79,Default,,0,0,0,,Неге келдің? Мен саған үйге қайт дедім
Dialogue: 0,0:17:26.87,0:17:29.54,Default,,0,0,0,,Мектеп ше?
Dialogue: 0,0:17:29.63,0:17:31.00,Default,,0,0,0,,Енді барудың қажеті жоқ
Dialogue: 0,0:17:31.09,0:17:33.13,Default,,0,0,0,,Ал... сонда
Dialogue: 0,0:17:33.21,0:17:36.47,Default,,0,0,0,,Бүгін жасай алмасаңыз, ертең таңертең кішкене болса да.
Dialogue: 0,0:17:37.34,0:17:38.47,Default,,0,0,0,,Энжу
Dialogue: 0,0:17:38.76,0:17:41.47,Default,,0,0,0,,Жоқ! Мен Миканмен танысқым келеді!
Dialogue: 0,0:17:41.56,0:17:43.39,Default,,0,0,0,,Мен Сасана-чанмен танысқым келеді!
Dialogue: 0,0:17:43.47,0:17:47.52,Default,,0,0,0,,«Тенчу қыздарын» көрсетемін деп уәде бердім.
Dialogue: 0,0:17:47.64,0:17:50.23,Default,,0,0,0,,Қараңыз! Мен оны дұрыс әкелдім!
Dialogue: 0,0:17:50.31,0:17:52.48,Default,,0,0,0,,Сонымен Рентаро...
Dialogue: 0,0:17:55.94,0:17:57.86,Default,,0,0,0,,Маған бір шымшым беріңізші.
Dialogue: 0,0:17:58.53,0:18:00.12,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:18:00.20,0:18:02.33,Default,,0,0,0,,Жоқ, Рентаро! (Officer) Don't get angry!
Dialogue: 0,0:18:02.79,0:18:03.66,Default,,0,0,0,,Рентаро!
Dialogue: 0,0:18:04.62,0:18:05.50,Default,,0,0,0,,Жібер!
Dialogue: 0,0:18:05.79,0:18:07.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:12.21,0:18:13.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:13.67,0:18:19.18,Default,,0,0,0,,(Энджудың жылаған дауысы)
Dialogue: 0,0:18:19.26,0:18:20.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:38.65,0:18:41.70,Default,,0,0,0,,Мм, мен мұғалім болғым келеді!
Dialogue: 0,0:18:41.87,0:18:45.04,Default,,0,0,0,,Тәттілер дүкені Мен тәттілер дүкені болғым келеді!
Dialogue: 0,0:18:45.45,0:18:48.16,Default,,0,0,0,,Мен сенің әйелің болғым келеді!
Dialogue: 0,0:18:48.66,0:18:52.58,Default,,0,0,0,,Мен гүл өсіруші болғым келеді.
Dialogue: 0,0:18:56.71,0:18:59.09,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:19:02.80,0:19:07.56,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:19:11.85,0:19:14.15,Default,,0,0,0,,Сатоми-кун, жақсысың ба?
Dialogue: 0,0:19:14.73,0:19:15.57,Default,,0,0,0,,Тина ше?
Dialogue: 0,0:19:16.40,0:19:20.15,Default,,0,0,0,,...
Dialogue: 0,0:19:20.70,0:19:21.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:22.91,0:19:24.41,Default,,0,0,0,,Сатоми-кун…
Dialogue: 0,0:19:24.95,0:19:27.58,Default,,0,0,0,,Бомбалардың өлімге қабілеттілігін арттыру үшін...
Dialogue: 0,0:19:27.66,0:19:30.12,Default,,0,0,0,,Олар варан кесектерімен толтырылған дейді.
Dialogue: 0,0:19:31.42,0:19:34.75,Default,,0,0,0,,...
Dialogue: 0,0:19:35.59,0:19:39.21,Default,,0,0,0,,...
Dialogue: 0,0:19:39.59,0:19:43.59,Default,,0,0,0,,…
Dialogue: 0,0:19:43.68,0:19:44.85,Default,,0,0,0,,Лорд Тен'эн, маған сол гүл жапырағын бересің бе?
Dialogue: 0,0:19:48.22,0:19:50.06,Default,,0,0,0,,Біз полициямыз
Dialogue: 0,0:19:50.14,0:19:52.27,Default,,0,0,0,,Әділдік жаса! Сатоми-кун
Dialogue: 0,0:19:52.35,0:19:53.98,Default,,0,0,0,,Әділет…
Dialogue: 0,0:19:54.10,0:19:57.57,Default,,0,0,0,,...
Dialogue: 0,0:19:57.65,0:19:58.61,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:19:58.69,0:20:00.11,Default,,0,0,0,,(Қыздың ән айту дауысы)
