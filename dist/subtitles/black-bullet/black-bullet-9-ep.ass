Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.54,0:00:05.83,Default,,0,0,0,,Жаман, сен шаршадың.
Dialogue: 0,0:00:05.92,0:00:06.79,Default,,0,0,0,,Жарайды
Dialogue: 0,0:00:07.71,0:00:09.55,Default,,0,0,0,,Доктор Мурото көп уақыт өтпейді
Dialogue: 0,0:00:09.63,0:00:11.67,Default,,0,0,0,,Мен сенімен кездесуім керек деп ойладым.
Dialogue: 0,0:00:12.38,0:00:16.64,Default,,0,0,0,,Барлық данышпандар сияқты ол да үлкен оғаш.
Dialogue: 0,0:00:16.72,0:00:18.81,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:00:18.89,0:00:19.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:21.43,0:00:22.98,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:00:24.14,0:00:25.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:25.23,0:00:27.27,Default,,0,0,0,,Сәлем мұғалім
Dialogue: 0,0:00:27.44,0:00:31.32,Default,,0,0,0,,Сен қайда бардың? Таку…
Dialogue: 0,0:00:33.61,0:00:35.32,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:36.07,0:00:37.82,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:00:37.91,0:00:41.20,Default,,0,0,0,,Уф аааа...
Dialogue: 0,0:00:41.37,0:00:43.54,Default,,0,0,0,,Жыл!
Dialogue: 0,0:00:44.04,0:00:50.21,Default,,0,0,0,,♪～
Dialogue: 0,0:02:07.75,0:02:13.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:16.71,0:02:19.38,Default,,0,0,0,,Жоқ, жоқ, сен мені құтқардың, Рентаро-кун.
Dialogue: 0,0:02:19.47,0:02:22.89,Default,,0,0,0,,Тамағым таусылып, өліп қала жаздадым.
Dialogue: 0,0:02:24.14,0:02:25.60,Default,,0,0,0,,Алайда кептірілген құрма
Dialogue: 0,0:02:25.68,0:02:30.48,Default,,0,0,0,,Балшық, тәтті целлюлоза менің аш асқазанымды тітіркендіреді және өте жағымсыз...
Dialogue: 0,0:02:30.56,0:02:31.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:32.02,0:02:33.69,Default,,0,0,0,,Рентаро-кун
Dialogue: 0,0:02:33.98,0:02:37.36,Default,,0,0,0,,Бұл ұзақ уақыт бойы проблема болады.
Dialogue: 0,0:02:37.44,0:02:39.40,Default,,0,0,0,,Мен сені ұрлаған жоқпын.
Dialogue: 0,0:02:39.95,0:02:42.87,Default,,0,0,0,,Менің ағам олай жасамас еді.
Dialogue: 0,0:02:43.24,0:02:44.12,Default,,0,0,0,,О, ау
Dialogue: 0,0:02:44.37,0:02:47.79,Default,,0,0,0,,Бір-бірінің жанынан өтіп бара жатқан кішкентай қыздың бөксесін 100 рет сипады.
Dialogue: 0,0:02:47.87,0:02:51.08,Default,,0,0,0,,Бастауыш мектепке кіріп, 1000 рет дәрет сынамаларын ұрлау
Dialogue: 0,0:02:51.17,0:02:53.67,Default,,0,0,0,,Ол бұзылған гроссмейстер.
Dialogue: 0,0:02:53.75,0:02:56.55,Default,,0,0,0,,Мен мұндай ұлы тұлғаның кім екенін білмеймін.
Dialogue: 0,0:02:56.63,0:02:58.26,Default,,0,0,0,,Дөрекілігіңіз үшін кешіріңіз...
Dialogue: 0,0:02:58.34,0:02:59.63,Default,,0,0,0,,Сенбеңіз!
Dialogue: 0,0:03:01.72,0:03:05.51,Default,,0,0,0,,Дұрыс, кеше ғана саған Акима-кун қонаққа келді.
Dialogue: 0,0:03:05.93,0:03:08.43,Default,,0,0,0,,А... Шома-нии?
Dialogue: 0,0:03:08.52,0:03:12.52,Default,,0,0,0,,Мен оның қазір жоқ екенін айтсам, ол мені тыңдамай кетіп қалды.
Dialogue: 0,0:03:13.15,0:03:15.15,Default,,0,0,0,,Ол бұрынғыдай.
Dialogue: 0,0:03:15.23,0:03:17.15,Default,,0,0,0,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,0:03:17.23,0:03:20.11,Default,,0,0,0,,Ах Шома Нагисава
Dialogue: 0,0:03:20.19,0:03:23.16,Default,,0,0,0,,Ол менің ағам және Тендо стиліндегі ұрыс техникасының ұлы.
Dialogue: 0,0:03:23.87,0:03:27.24,Default,,0,0,0,,Оның күшті болғаны сонша, аяғына жақындай да алмадым.
Dialogue: 0,0:03:27.37,0:03:30.66,Default,,0,0,0,,Бірақ бір күні мен кенет дожодан шықтым.
Dialogue: 0,0:03:32.08,0:03:33.67,Default,,0,0,0,,Сіз оны құрметтедіңіз бе?
Dialogue: 0,0:03:35.38,0:03:36.79,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:37.00,0:03:39.92,Default,,0,0,0,,Ол жоғалып кеткенде мен қатты қайғырдым.
Dialogue: 0,0:03:40.13,0:03:43.43,Default,,0,0,0,,Неге ештеңе айтпай кетіп қалдың?
Dialogue: 0,0:03:45.72,0:03:48.22,Default,,0,0,0,,Дәрігер, сізден сұрайын дегенім бар. (Суми) Иә?
Dialogue: 0,0:03:48.31,0:03:50.93,Default,,0,0,0,,Жақында мені қудалайды.
Dialogue: 0,0:03:51.94,0:03:53.14,Default,,0,0,0,,Бұл Эйн жігіті ме?
Dialogue: 0,0:03:53.60,0:03:57.40,Default,,0,0,0,,Бұлай болса, бәрі қиыншылыққа ұшырайды.
Dialogue: 0,0:03:57.90,0:04:03.24,Default,,0,0,0,,Менің ойымша, мен Tendo Private Security компаниясынан кетуім керек.
Dialogue: 0,0:04:04.16,0:04:04.99,Default,,0,0,0,,Сен ақымақсың (Рентаро) Идиот!
Dialogue: 0,0:04:05.32,0:04:06.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:06.78,0:04:11.75,Default,,0,0,0,,Кисара-сан, Енджу және мен сенің біз үшін уайымдайтындай әлсіз емеспіз!
Dialogue: 0,0:04:11.87,0:04:12.83,Default,,0,0,0,,Тина-чан
Dialogue: 0,0:04:12.91,0:04:15.50,Default,,0,0,0,,Рентаро-кунның айтқысы келетінінің тегін аудармасы.
Dialogue: 0,0:04:16.38,0:04:19.30,Default,,0,0,0,,Өйткені сіз кішкентай қыз гарем жобасының құнды мүшесісіз.
Dialogue: 0,0:04:19.38,0:04:21.51,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бере алмаймын.
Dialogue: 0,0:04:21.59,0:04:24.38,Default,,0,0,0,,Міне, осылай...
Dialogue: 0,0:04:24.93,0:04:27.39,Default,,0,0,0,,Бұл ойдан шығарылған әңгіме болуы керек!
Dialogue: 0,0:04:27.64,0:04:28.72,Default,,0,0,0,,Сәлем Тина
Dialogue: 0,0:04:29.89,0:04:31.89,Default,,0,0,0,,Бұл сенің бізді жек көруің емес пе?
Dialogue: 0,0:04:31.98,0:04:32.93,Default,,0,0,0,,Иә
Dialogue: 0,0:04:33.89,0:04:35.23,Default,,0,0,0,,Сонда ешқандай проблема жоқ, солай ма?
Dialogue: 0,0:04:35.31,0:04:36.31,Default,,0,0,0,,Ах
Dialogue: 0,0:04:36.69,0:04:39.82,Default,,0,0,0,,Уайымдама, мен де күшейемін.
Dialogue: 0,0:04:42.53,0:04:45.07,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:04:46.24,0:04:47.57,Default,,0,0,0,,Сен жақсы қыз емессің бе?
Dialogue: 0,0:04:48.78,0:04:51.70,Default,,0,0,0,,Негізі, сіз Енджу-чан мен Тина-чан туралы айтып отырсыз...
Dialogue: 0,0:04:51.79,0:04:53.75,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:53.91,0:04:56.58,Default,,0,0,0,,Менің ойымша, бұл сүйкімді.
Dialogue: 0,0:04:56.67,0:04:59.34,Default,,0,0,0,,Кейде кездейсоқ қимылдар мені шошытады.
Dialogue: 0,0:04:59.96,0:05:01.84,Default,,0,0,0,,Адал болу дұрыс.
Dialogue: 0,0:05:01.92,0:05:05.09,Default,,0,0,0,,Бірақ иығыңызға көп салмақ түсірмеңіз.
Dialogue: 0,0:05:06.26,0:05:10.97,Default,,0,0,0,,Олар ішкі эрозия жылдамдығының бұлтартпас бұғауларымен байланысты.
Dialogue: 0,0:05:11.60,0:05:13.77,Default,,0,0,0,,Олар бізден өзгеше.
Dialogue: 0,0:05:13.89,0:05:17.19,Default,,0,0,0,,Енджу сенен де, менден де айырмашылығы жоқ адам!
Dialogue: 0,0:05:17.27,0:05:20.98,Default,,0,0,0,,Бірақ солай ойлайтындар азшылықты құрайды.
Dialogue: 0,0:05:21.90,0:05:26.86,Default,,0,0,0,,Егер сіз әлемді осылай өзгерткіңіз келсе, саясаткер болуыңыз керек еді.
Dialogue: 0,0:05:27.86,0:05:30.91,Default,,0,0,0,,Әлемді өзгертудің жалғыз жолы жоқ.
Dialogue: 0,0:05:31.49,0:05:33.33,Default,,0,0,0,,Гастреадан қорқудың қажеті жоқ.
Dialogue: 0,0:05:33.41,0:05:36.29,Default,,0,0,0,,Кеңірек әлемді көру еркіндігі.
Dialogue: 0,0:05:36.75,0:05:39.63,Default,,0,0,0,,Енджу, мен мұны Тинаға бергім келеді.
Dialogue: 0,0:05:40.17,0:05:43.09,Default,,0,0,0,,Мен сені сол үшін өлтіремін! Барлық Gastrea!
Dialogue: 0,0:05:43.50,0:05:47.72,Default,,0,0,0,,Фухахаха... Түсіндім, солай болды.
Dialogue: 0,0:05:49.64,0:05:53.39,Default,,0,0,0,,Ақыр соңында, сен менен басқашасың.
Dialogue: 0,0:05:53.89,0:05:58.10,Default,,0,0,0,,Сіз бұл ғаламдағы ең әдемі нәрсенің не екенін білесіз бе?
Dialogue: 0,0:05:59.31,0:06:02.98,Default,,0,0,0,,Буддизм әлемінде оны лотос гүлі дейді.
Dialogue: 0,0:06:03.07,0:06:05.49,Default,,0,0,0,,Басқаша айтқанда, бұл сенсің, Рентаро-кун.
Dialogue: 0,0:06:06.65,0:06:09.07,Default,,0,0,0,,Жан дүниең әдемі
Dialogue: 0,0:06:09.78,0:06:12.66,Default,,0,0,0,,Сіз қазір қалайсыз, мен мұны сізге көрсеткенім дұрыс болар еді деп ойлаймын.
Dialogue: 0,0:06:14.83,0:06:17.16,Default,,0,0,0,,Сіз маған берген 5-ші деңгейлі кіру кілтімен
Dialogue: 0,0:06:17.25,0:06:18.79,Default,,0,0,0,,Бұл алынған деректер.
Dialogue: 0,0:06:19.33,0:06:21.17,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:06:22.17,0:06:25.42,Default,,0,0,0,,Қазіргі уақыттан бастап 2031 ж. Соңғы 20 жылда -
Dialogue: 0,0:06:25.51,0:06:27.42,Default,,0,0,0,,Бұл ретроспективті хронология.
Dialogue: 0,0:06:28.22,0:06:29.18,Default,,0,0,0,,Мұнда қараңыз
Dialogue: 0,0:06:29.72,0:06:31.97,Default,,0,0,0,,А, бұл біртүрлі.
Dialogue: 0,0:06:32.05,0:06:34.56,Default,,0,0,0,,Гастрея соғысының басынан аяғына дейінгі жазбалар...
Dialogue: 0,0:06:34.64,0:06:35.93,Default,,0,0,0,,Оны өртеп жіберу керек еді!
Dialogue: 0,0:06:36.64,0:06:39.94,Default,,0,0,0,,Оқулықта солай жазылған емес пе? Бірақ...
Dialogue: 0,0:06:42.52,0:06:43.48,Default,,0,0,0,,Га
Dialogue: 0,0:06:43.56,0:06:47.44,Default,,0,0,0,,Иә, бұл жерде біреу фактіні жасырып отыр.
Dialogue: 0,0:06:49.86,0:06:50.70,Default,,0,0,0,,Жеті жұлдыз...
Dialogue: 0,0:06:53.16,0:06:54.58,Default,,0,0,0,,Жеті жұлдыз мұрасы
Dialogue: 0,0:06:54.66,0:06:57.83,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:06:59.21,0:07:00.37,Default,,0,0,0,,Сәлеметсіз бе, Кисара-сан?
Dialogue: 0,0:07:00.75,0:07:03.08,Default,,0,0,0,,Сатоми-кун, сен жаңалықтарды көріп тұрсың ба?
Dialogue: 0,0:07:06.63,0:07:08.26,Default,,0,0,0,,Монолиттің ағару құбылысы ашылды!
Dialogue: 0,0:07:08.26,0:07:09.72,Default,,0,0,0,,Монолитті ағарту құбылысы ашылды!
Dialogue: 0,0:07:08.26,0:07:09.72,Default,,0,0,0,,Барлығыңыз, қараңыздаршы!
Dialogue: 0,0:07:09.80,0:07:11.47,Default,,0,0,0,,Бұл адам сенгісіз трагедия!
Dialogue: 0,0:07:11.55,0:07:11.97,Default,,0,0,0,,Әзірге ресми хабарландыру жоқ...
Dialogue: 0,0:07:11.97,0:07:13.30,Default,,0,0,0,,Әзірге ресми хабарландыру жоқ...
Dialogue: 0,0:07:11.97,0:07:13.30,Default,,0,0,0,,№32 монолит -
Dialogue: 0,0:07:13.55,0:07:15.85,Default,,0,0,0,,Мен енді оны жасыра алмайтын сияқтымын!
Dialogue: 0,0:07:13.55,0:07:15.85,Default,,0,0,0,,Түсі аппақ болып, пішіні бұзыла бастады.
Dialogue: 0,0:07:15.85,0:07:17.06,Default,,0,0,0,,Түсі аппақ болып, пішіні бұзыла бастады.
Dialogue: 0,0:07:17.14,0:07:17.68,Default,,0,0,0,,А, монолиттің айналасынан қара түтін көтерілді...
Dialogue: 0,0:07:17.68,0:07:19.18,Default,,0,0,0,,А, монолиттің айналасынан қара түтін көтерілді...
Dialogue: 0,0:07:17.68,0:07:19.18,Default,,0,0,0,,Бұл басталды, Сатоми-кун.
Dialogue: 0,0:07:19.18,0:07:20.23,Default,,0,0,0,,Аа, монолиттің айналасынан қара түтін көтерілді...
Dialogue: 0,0:07:20.31,0:07:21.44,Default,,0,0,0,,О
Dialogue: 0,0:07:20.31,0:07:21.44,Default,,0,0,0,,... сыртқы палатаның сыртында...
Dialogue: 0,0:07:22.52,0:07:25.61,Default,,0,0,0,,No32- монолиттің ағару құбылысын растағаннан кейін
Dialogue: 0,0:07:25.69,0:07:26.69,Default,,0,0,0,,Бүгін бір түннен кейін
Dialogue: 0,0:07:27.65,0:07:31.70,Default,,0,0,0,,Қасиетті резиденцияда Көктің Киелі Ұлының ресми конференциясы өтті.
Dialogue: 0,0:07:32.53,0:07:35.28,Default,,0,0,0,,Бүгін 1-ші күн болып есептеледі.
Dialogue: 0,0:07:35.37,0:07:36.95,Default,,0,0,0,,№32 монолит болып табылады
Dialogue: 0,0:07:37.91,0:07:40.12,Default,,0,0,0,,Ол 4 күннен кейін құлайды деп күтілуде.
Dialogue: 0,0:07:40.20,0:07:41.46,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:41.91,0:07:43.83,Default,,0,0,0,,Жаңа монолиттердің құрылысына қатысты
Dialogue: 0,0:07:43.92,0:07:45.50,Default,,0,0,0,,Не болады?
Dialogue: 0,0:07:45.96,0:07:48.17,Default,,0,0,0,,Тенші-сама әулие, бұл жолы не болды?
Dialogue: 0,0:07:48.25,0:07:51.47,Default,,0,0,0,,Бұл оның алдын ала белгілі болғанын білдіре ме?
Dialogue: 0,0:07:53.30,0:07:54.89,Default,,0,0,0,,Күшті ауыртпалықты көтеру-
Dialogue: 0,0:07:54.97,0:07:55.97,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:07:57.89,0:08:02.06,Default,,0,0,0,,Жер асты баспаналарына орналастыру үшін азаматтарды лотерея арқылы таңдау саясаты да бар.
Dialogue: 0,0:08:02.14,0:08:03.48,Default,,0,0,0,,Жақсы және жаман жақтары бар сияқты.
Dialogue: 0,0:08:04.35,0:08:07.52,Default,,0,0,0,,Қалған азаматтарды басқа жерге көшіруге болмайды ма?
Dialogue: 0,0:08:07.82,0:08:09.73,Default,,0,0,0,,Байлар көп ақша жинап қойған.
Dialogue: 0,0:08:09.82,0:08:12.24,Default,,0,0,0,,Олар барлық әуе билеттерін сатып алып жатыр дейді.
Dialogue: 0,0:08:12.90,0:08:16.70,Default,,0,0,0,,Қалғандары кісі өлтіргенше уақыт мәселесі.
Dialogue: 0,0:08:17.66,0:08:20.24,Default,,0,0,0,,Рентаро орындалды.
Dialogue: 0,0:08:20.54,0:08:22.58,Default,,0,0,0,,Шынымен, бұл шатыр ма?
Dialogue: 0,0:08:22.66,0:08:24.00,Default,,0,0,0,,Бұл шүберек
Dialogue: 0,0:08:24.25,0:08:26.04,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:08:26.13,0:08:28.79,Default,,0,0,0,,Адъювант ретінде ресми тіркелмеген болса...
Dialogue: 0,0:08:28.88,0:08:31.26,Default,,0,0,0,,Өзін-өзі қорғау күштерінің шатырларын қамтамасыз ету мүмкін емес.
Dialogue: 0,0:08:31.46,0:08:35.09,Default,,0,0,0,,Не болса да, мен бүгін тағы бір жұп табамын!
Dialogue: 0,0:08:35.18,0:08:38.85,Default,,0,0,0,,Кішкентай жерде мұндай бұзықпен ұйықтай алмаймын.
Dialogue: 0,0:08:38.93,0:08:39.81,Default,,0,0,0,,Я...
Dialogue: 0,0:08:40.64,0:08:44.31,Default,,0,0,0,,Кешіріңіз, мен де сізге қосылсам деп едім.
Dialogue: 0,0:08:44.85,0:08:48.69,Default,,0,0,0,,Ол үшін уайымдамаңыз, сізді шеніңізден айырады.
Dialogue: 0,0:08:48.77,0:08:50.78,Default,,0,0,0,,Уайымдама Тина
Dialogue: 0,0:08:50.86,0:08:53.90,Default,,0,0,0,,Бәйбіше таңғажайып серік алады
Dialogue: 0,0:08:53.99,0:08:56.57,Default,,0,0,0,,Бұл сіз ойлағандай қызық емес.
Dialogue: 0,0:08:57.03,0:08:59.83,Default,,0,0,0,,Сонда күң қыз көңілді болады!
Dialogue: 0,0:09:03.04,0:09:07.58,Default,,0,0,0,,Уау! Рентаро Асығыңыз, асығыңыз!
Dialogue: 0,0:09:08.25,0:09:10.55,Default,,0,0,0,,Қандай ұлы тұлға.
Dialogue: 0,0:09:10.63,0:09:13.05,Default,,0,0,0,,Бұл мереке сияқты.
Dialogue: 0,0:09:13.26,0:09:14.67,Default,,0,0,0,,Фестивальдар сіз туралы...
Dialogue: 0,0:09:14.76,0:09:17.09,Default,,0,0,0,,А, Рентаро, осындай нәрсе туралы не айтасыз?
Dialogue: 0,0:09:20.10,0:09:23.35,Default,,0,0,0,,Жоқ, оларды тоқтатайық. Қараңыз.
Dialogue: 0,0:09:24.27,0:09:26.35,Default,,0,0,0,,Бүкіл денесі сауытпен қапталған.
Dialogue: 0,0:09:26.44,0:09:29.11,Default,,0,0,0,,Мен мұны істеуге бейіммін, өйткені мен өлгім келмейді.
Dialogue: 0,0:09:29.36,0:09:31.77,Default,,0,0,0,,Гастреямен шайқаста өліммен аяқталды
Dialogue: 0,0:09:31.86,0:09:34.44,Default,,0,0,0,,Қорғаныс күшіңізді арттырудың орнына, өзіңізді жеңілдетіңіз.
Dialogue: 0,0:09:34.53,0:09:36.86,Default,,0,0,0,,Жылдамдықты сақтау ұтымдырақ емес пе?
Dialogue: 0,0:09:36.95,0:09:40.62,Default,,0,0,0,,Түсіндім, жеңіл киім кигені жақсырақ деп ойлаймын.
Dialogue: 0,0:09:41.45,0:09:44.29,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:44.37,0:09:46.08,Default,,0,0,0,,Оны таптым! (Рентаро) О
Dialogue: 0,0:09:49.88,0:09:51.21,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:09:51.29,0:09:53.13,Default,,0,0,0,,Уа, сәл күте тұрыңыз!
Dialogue: 0,0:09:55.51,0:09:59.39,Default,,0,0,0,,Ха, оны табу өте қиын.
Dialogue: 0,0:09:59.89,0:10:04.10,Default,,0,0,0,,Олардың көпшілігі басқа адъюванттарда бар.
Dialogue: 0,0:10:04.56,0:10:05.93,Default,,0,0,0,,Бүгін қайтеміз?
Dialogue: 0,0:10:06.98,0:10:08.14,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:08.31,0:10:09.77,Default,,0,0,0,,Ах
Dialogue: 0,0:10:18.95,0:10:20.66,Default,,0,0,0,,Енджуға (Енджу) қарама, уф...
Dialogue: 0,0:10:22.03,0:10:24.20,Default,,0,0,0,,Мұны азаматтық полиция жасаған болса керек.
Dialogue: 0,0:10:24.29,0:10:27.16,Default,,0,0,0,,Ақымақ! Мен қабілеттілік айырмашылығын түсінбеймін
Dialogue: 0,0:10:29.58,0:10:30.79,Default,,0,0,0,,Рентаро!
Dialogue: 0,0:10:31.46,0:10:33.25,Default,,0,0,0,,Бұл тамаша идея.
Dialogue: 0,0:10:33.71,0:10:34.80,Default,,0,0,0,,Айтуынша, ол жүріп өтіп, көзге көрінгеннің бәрін мөлдір етіп қояды.
Dialogue: 0,0:10:36.63,0:10:38.51,Default,,0,0,0,,Ұрыс! (Полиция) Эй, бұл не?
Dialogue: 0,0:10:38.84,0:10:42.22,Default,,0,0,0,,Кеттік, Рентаро, мұны істеген жігіт болуы мүмкін.
Dialogue: 0,0:10:42.30,0:10:43.30,Default,,0,0,0,,О
Dialogue: 0,0:10:52.69,0:10:54.40,Default,,0,0,0,,Ах... (Рентаро) Ах.
Dialogue: 0,0:10:57.82,0:10:58.65,Default,,0,0,0,,Ах
Dialogue: 0,0:11:00.20,0:11:03.41,Default,,0,0,0,,Бұл... Шома-нии ме?
Dialogue: 0,0:11:04.99,0:11:07.20,Default,,0,0,0,,Менің кім екенімді білесің бе?
Dialogue: 0,0:11:07.29,0:11:11.00,Default,,0,0,0,,Тонау және кісі өлтіру үшін өлім жазасына кесілген іздеуде жүрген адам
Dialogue: 0,0:11:11.08,0:11:13.67,Default,,0,0,0,,Кірпіш Найджел, бұл менмін.
Dialogue: 0,0:11:14.46,0:11:16.88,Default,,0,0,0,,Мен сені әлсіз деп айтпаймын.
Dialogue: 0,0:11:16.96,0:11:19.26,Default,,0,0,0,,Онда неге менің спиртімді іше алмайсың?
Dialogue: 0,0:11:19.80,0:11:22.01,Default,,0,0,0,,Маған ештеңе төлеуге ешқандай себеп жоқ.
Dialogue: 0,0:11:22.22,0:11:23.89,Default,,0,0,0,,Не?
Dialogue: 0,0:11:23.97,0:11:26.14,Default,,0,0,0,,(полицияның айқайы)
Dialogue: 0,0:11:26.56,0:11:28.77,Default,,0,0,0,,Неліктен ешкім байқамайды?
Dialogue: 0,0:11:28.85,0:11:31.89,Default,,0,0,0,,Бұл матчта қабілеттер тым өзгеше болуы мүмкін.
Dialogue: 0,0:11:32.40,0:11:36.02,Default,,0,0,0,,Тоқта, бұл даңқсыз, намыссыз шайқас.
Dialogue: 0,0:11:36.11,0:11:38.03,Default,,0,0,0,,Жеңсең де, жеңілсең де қызықсыз.
Dialogue: 0,0:11:38.15,0:11:40.11,Default,,0,0,0,,Шулы!
Dialogue: 0,0:11:44.66,0:11:45.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:48.79,0:11:50.37,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:11:50.79,0:11:54.50,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:12:06.80,0:12:08.47,Default,,0,0,0,,Гуааа...
Dialogue: 0,0:12:09.60,0:12:13.39,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:13.73,0:12:16.40,Default,,0,0,0,,Керемет! Бұл керемет, Рентаро!
Dialogue: 0,0:12:16.48,0:12:17.86,Default,,0,0,0,,А... Рентаро?
Dialogue: 0,0:12:18.69,0:12:22.36,Default,,0,0,0,,Бұрынғы техника Санджадама Кирин болды, солай ма?
Dialogue: 0,0:12:24.99,0:12:28.03,Default,,0,0,0,,Сен мүлде әлсіреген жоқсың, Шома-нии.
Dialogue: 0,0:12:28.41,0:12:30.66,Default,,0,0,0,,Біраз уақыт өтті, Сатоми.
Dialogue: 0,0:12:30.74,0:12:33.87,Default,,0,0,0,,Сенің жетістігің Мен желден естідім
Dialogue: 0,0:12:34.25,0:12:37.38,Default,,0,0,0,,Хмм, бір-біріңді танисыңдар ма? Рентаро
Dialogue: 0,0:12:38.29,0:12:40.21,Default,,0,0,0,,Енджумен таныстыруға рұқсат етіңіз
Dialogue: 0,0:12:40.50,0:12:44.18,Default,,0,0,0,,Тендо стиліндегі жекпе-жек техникасы 8-ші Дэн Шома Нагисава
Dialogue: 0,0:12:44.26,0:12:46.34,Default,,0,0,0,,Ол менің Тендо стиліндегі ағам.
Dialogue: 0,0:12:48.30,0:12:50.97,Default,,0,0,0,,Скорпионды жеңдің деген қауесетті естігеннен бері...
Dialogue: 0,0:12:51.06,0:12:54.89,Default,,0,0,0,,Мен әрқашан бір күні бірге төбелесу туралы ойладым.
Dialogue: 0,0:12:55.64,0:12:59.65,Default,,0,0,0,,Өзінің лайықсыз көрінісіне қарамастан, Тендо стиліндегі ұрыс техникасының 8-деңгейінің күші
Dialogue: 0,0:13:00.48,0:13:03.19,Default,,0,0,0,,Мені зұлым жоспарларыңызға қосыңыз.
Dialogue: 0,0:13:03.28,0:13:04.86,Default,,0,0,0,,Бұл сендіреді
Dialogue: 0,0:13:05.53,0:13:08.53,Default,,0,0,0,,Бірақ Шома-нии, сен неге жеке полиция қызметін басқарасың?
Dialogue: 0,0:13:09.87,0:13:13.66,Default,,0,0,0,,Неліктен сіз кенеттен доджоны тастадыңыз?
Dialogue: 0,0:13:15.50,0:13:19.17,Default,,0,0,0,,Мен ыдыс емес едім, болды.
Dialogue: 0,0:13:21.17,0:13:23.67,Default,,0,0,0,,Эй, мен сенен тағы бір нәрсе сұрасам болады ма?
Dialogue: 0,0:13:23.76,0:13:24.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:24.76,0:13:29.18,Default,,0,0,0,,Темір жолда өлтірілген жұптың денесі ағайынды Шомалардың ісі ме?
Dialogue: 0,0:13:29.51,0:13:30.80,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:31.68,0:13:34.02,Default,,0,0,0,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:13:34.23,0:13:35.68,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:13:36.35,0:13:37.94,Default,,0,0,0,,Мен әкелдім.
Dialogue: 0,0:13:38.02,0:13:40.19,Default,,0,0,0,,Дәл қазір!
Dialogue: 0,0:13:44.11,0:13:46.57,Default,,0,0,0,,Бұл Шома Нагисава. Өтінемін, маған қамқорлық жасаңыз.
Dialogue: 0,0:13:47.20,0:13:51.08,Default,,0,0,0,,Фу… Сақтандырғыш Мидори мен Ииимашу
Dialogue: 0,0:13:51.58,0:13:54.16,Default,,0,0,0,,Мысықтың бастамашысы үлгісі
Dialogue: 0,0:13:55.04,0:13:56.33,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:13:57.41,0:14:00.58,Default,,0,0,0,,Ал... Ерекше шеберлік – хош иісті болжау
Dialogue: 0,0:14:00.88,0:14:03.17,Default,,0,0,0,,Мырза, сіз сиқырды қолдана алмайсыз ба?
Dialogue: 0,0:14:03.25,0:14:04.80,Default,,0,0,0,,Ал... сиқырлы!?
Dialogue: 0,0:14:04.88,0:14:07.84,Default,,0,0,0,,Өйткені ол бақсылардың қалпақшасын киіп алған, солай емес пе?
Dialogue: 0,0:14:08.26,0:14:09.09,Default,,0,0,0,,Ах
Dialogue: 0,0:14:09.18,0:14:12.89,Default,,0,0,0,,Мидори Достарыңыздан ештеңе жасырмаңыз.
Dialogue: 0,0:14:18.19,0:14:19.52,Default,,0,0,0,,О
Dialogue: 0,0:14:19.73,0:14:22.27,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:14:23.15,0:14:25.82,Default,,0,0,0,,Осындай нәрсе бар ма? Рентаро
Dialogue: 0,0:14:25.90,0:14:29.36,Default,,0,0,0,,Ах, асқазан вирусының құрамындағы жануар факторы...
Dialogue: 0,0:14:29.45,0:14:32.53,Default,,0,0,0,,Ағзаға қатты әсер ететін жағдайлар бар деп естимін.
Dialogue: 0,0:14:33.49,0:14:35.62,Default,,0,0,0,,Тынш! Бұл 6 адам!
Dialogue: 0,0:14:35.70,0:14:38.37,Default,,0,0,0,,Сонымен, біздің көмекшіміз аяқталды.
Dialogue: 0,0:14:38.91,0:14:40.04,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:14:40.12,0:14:43.38,Default,,0,0,0,,Сатоми: Алтауымызбен жалғастырғың келе ме?
Dialogue: 0,0:14:44.80,0:14:50.13,Default,,0,0,0,,Маған 10 адамнан тұратын 5 топ керек.
Dialogue: 0,0:14:50.80,0:14:53.05,Default,,0,0,0,,Бұл шынымен қажет пе?
Dialogue: 0,0:14:53.14,0:14:55.81,Default,,0,0,0,,Мен жинай алатын адамдар санының шегі
Dialogue: 0,0:14:55.89,0:14:57.77,Default,,0,0,0,,Партияның соқыр жерлерін жоюға тырысқанда
Dialogue: 0,0:14:57.85,0:15:00.10,Default,,0,0,0,,Мүшелер саны бойынша ымыраға келу
Dialogue: 0,0:15:00.52,0:15:03.15,Default,,0,0,0,,Менің ойымша, бұл тек осының айналасында.
Dialogue: 0,0:15:03.23,0:15:05.98,Default,,0,0,0,,Хмм, тағы екі жұп қалды.
Dialogue: 0,0:15:06.07,0:15:08.24,Default,,0,0,0,,Тағы бір топ қалды (бәрі) А.
Dialogue: 0,0:15:12.78,0:15:14.62,Default,,0,0,0,,О! (Рентаро) Кисара мырза
Dialogue: 0,0:15:14.95,0:15:18.91,Default,,0,0,0,,Тендо-рю семсершінің промоутері Кисара Тендо
Dialogue: 0,0:15:19.00,0:15:22.12,Default,,0,0,0,,«КЕЛЕСІ» жетілдірілген мерген бастамашысы
Dialogue: 0,0:15:22.63,0:15:24.63,Default,,0,0,0,,Тина Спроут иә?
Dialogue: 0,0:15:25.00,0:15:26.38,Default,,0,0,0,,2 немесе одан да көп адам
Dialogue: 0,0:15:26.46,0:15:29.51,Default,,0,0,0,,Мен оны Рентаро Сатомидің адъювантына қосуыңызды қалаймын.
Dialogue: 0,0:15:29.59,0:15:31.13,Default,,0,0,0,,Мұнда ұсынылады
Dialogue: 0,0:15:31.38,0:15:35.26,Default,,0,0,0,,Күте тұрыңыз, Тинаны дәрежесінен айырады...
Dialogue: 0,0:15:35.35,0:15:38.22,Default,,0,0,0,,Егер солай болса, Қасиетті періштемен тікелей сөйлесіңіз.
Dialogue: 0,0:15:38.31,0:15:39.64,Default,,0,0,0,,Мен оны тоқтаттым.
Dialogue: 0,0:15:40.18,0:15:43.69,Default,,0,0,0,,Дәл қазір Токио аймағы жойылу алдында тұр.
Dialogue: 0,0:15:43.85,0:15:45.40,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:15:45.56,0:15:47.82,Default,,0,0,0,,Мен тіркеуді жаңа ғана аяқтадым.
Dialogue: 0,0:15:47.94,0:15:51.57,Default,,0,0,0,,Тина екеуміз 9200 санынан бастаймыз.
Dialogue: 0,0:15:51.95,0:15:55.24,Default,,0,0,0,,Бірақ менің қабілетім сәл жоғары болуы керек.
Dialogue: 0,0:15:55.45,0:15:57.58,Default,,0,0,0,,Біз одан құтыла аламыз ба?
Dialogue: 0,0:15:57.66,0:15:59.08,Default,,0,0,0,,Хехе…
Dialogue: 0,0:15:59.75,0:16:01.33,Default,,0,0,0,,Біраз уақыт болды, Кисара
Dialogue: 0,0:16:01.79,0:16:02.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:03.62,0:16:06.13,Default,,0,0,0,,Иә? Өтірік Акима-кун!?
Dialogue: 0,0:16:06.84,0:16:09.25,Default,,0,0,0,,Әпкең мен шәкіртіңді шақыру жаман ба?
Dialogue: 0,0:16:09.34,0:16:11.88,Default,,0,0,0,,Жақсы, біз бұрыннан доспыз.
Dialogue: 0,0:16:12.34,0:16:15.09,Default,,0,0,0,,Одан гөрі қайда болдың?
Dialogue: 0,0:16:15.18,0:16:17.14,Default,,0,0,0,,Одан гөрі, жүр!
Dialogue: 0,0:16:17.22,0:16:19.64,Default,,0,0,0,,Күте тұрыңыз... Эй, Сатоми-кун?
Dialogue: 0,0:16:19.97,0:16:22.18,Default,,0,0,0,,Богиня (Юзуки) Иә?
Dialogue: 0,0:16:22.27,0:16:24.10,Default,,0,0,0,,Міне менің құдайым!
Dialogue: 0,0:16:24.19,0:16:27.15,Default,,0,0,0,,Үлкен аға, жақсысың ба?
Dialogue: 0,0:16:27.61,0:16:29.90,Default,,0,0,0,,Денеңіз туралы аздап ойланыңыз!
Dialogue: 0,0:16:30.48,0:16:33.40,Default,,0,0,0,,Бұл диализдік ем болса, мен бүгін кеттім.
Dialogue: 0,0:16:33.49,0:16:37.28,Default,,0,0,0,,...
Dialogue: 0,0:16:37.62,0:16:38.83,Default,,0,0,0,,Мұндай бұйрықты қалай тыңдайсың...
Dialogue: 0,0:16:38.91,0:16:40.66,Default,,0,0,0,,Үлкен аға (Рентаро) Ах.
Dialogue: 0,0:16:41.58,0:16:44.67,Default,,0,0,0,,...
Dialogue: 0,0:16:44.79,0:16:47.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:47.84,0:16:50.67,Default,,0,0,0,,Әй, Таку!
Dialogue: 0,0:16:50.75,0:16:52.30,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:16:54.26,0:16:56.84,Default,,0,0,0,,Барлық полиция күштері сағат 1930-да
Dialogue: 0,0:16:56.93,0:17:01.35,Default,,0,0,0,,...
Dialogue: 0,0:17:03.89,0:17:05.98,Default,,0,0,0,,Бірге келгендеріңізге көп рахмет.
Dialogue: 0,0:17:06.27,0:17:09.27,Default,,0,0,0,,...
Dialogue: 0,0:17:09.98,0:17:13.94,Default,,0,0,0,,...
Dialogue: 0,0:17:14.11,0:17:17.78,Default,,0,0,0,,Мен бірге күрескенімді мақтан тұтамын.
Dialogue: 0,0:17:18.24,0:17:19.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:19.62,0:17:23.04,Default,,0,0,0,,275
Dialogue: 0,0:17:23.66,0:17:27.12,Default,,0,0,0,,...
Dialogue: 0,0:17:27.33,0:17:29.84,Default,,0,0,0,,―
Dialogue: 0,0:17:30.00,0:17:35.30,Default,,0,0,0,,々
Dialogue: 0,0:17:35.51,0:17:37.05,Default,,0,0,0,,...
Dialogue: 0,0:17:37.84,0:17:42.14,Default,,0,0,0,,々  ―
Dialogue: 0,0:17:42.39,0:17:46.60,Default,,0,0,0,,１
Dialogue: 0,0:17:46.69,0:17:50.19,Default,,0,0,0,,Бүгінгі тарихты жеңімпаздар құрды.
Dialogue: 0,0:17:50.27,0:17:53.57,Default,,0,0,0,,々
Dialogue: 0,0:17:54.53,0:17:56.32,Default,,0,0,0,,Мен оларды өлтіремін!
Dialogue: 0,0:17:56.40,0:17:58.32,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:17:58.66,0:18:03.08,Default,,0,0,0,,Қанішер полицейлер үшін өте тиімді сөз.
Dialogue: 0,0:18:03.16,0:18:06.58,Default,,0,0,0,,Әй, өсек айтқандай өткір сияқты.
Dialogue: 0,0:18:07.54,0:18:09.83,Default,,0,0,0,,32―
Dialogue: 0,0:18:10.21,0:18:13.21,Default,,0,0,0,,Гастреа корпусы мен өзін-өзі қорғау күштері бір-біріне жалт қарады.
Dialogue: 0,0:18:13.30,0:18:17.26,Default,,0,0,0,,Шайқас басталғаннан кейін біз өзін-өзі қорғау күштерінің өтініштерін орындаймыз.
Dialogue: 0,0:18:17.34,0:18:19.43,Default,,0,0,0,,...
Dialogue: 0,0:18:20.34,0:18:22.39,Default,,0,0,0,,...
Dialogue: 0,0:18:22.47,0:18:25.10,Default,,0,0,0,,Бұл мені шақырмайынша қол жетімді болмайтынын білдіре ме?
Dialogue: 0,0:18:25.77,0:18:28.23,Default,,0,0,0,,...
Dialogue: 0,0:18:28.56,0:18:30.73,Default,,0,0,0,,...
Dialogue: 0,0:18:30.81,0:18:33.19,Default,,0,0,0,,...
Dialogue: 0,0:18:33.27,0:18:35.94,Default,,0,0,0,,300
Dialogue: 0,0:18:36.19,0:18:37.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.07,0:18:39.82,Default,,0,0,0,,Хо, сен...
Dialogue: 0,0:18:40.49,0:18:42.57,Default,,0,0,0,,Бұл өзін-өзі қорғау күштері үшін тірек болғанымен.
Dialogue: 0,0:18:42.66,0:18:45.99,Default,,0,0,0,,Азаматтық полиция корпусы мен өзін-өзі қорғау күштері арасында тым үлкен қашықтық бар.
Dialogue: 0,0:18:46.08,0:18:47.33,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:18:47.45,0:18:51.29,Default,,0,0,0,,Біз жай ғана тылда лагерь құрып, күттік.
Dialogue: 0,0:18:51.38,0:18:52.84,Default,,0,0,0,,...
Dialogue: 0,0:18:53.50,0:18:56.30,Default,,0,0,0,,Олай болса, неге біз өз қатарымызды одан әрі төмендетпейміз?
Dialogue: 0,0:18:56.38,0:18:58.80,Default,,0,0,0,,“”
Dialogue: 0,0:18:58.88,0:19:01.30,Default,,0,0,0,,Жасынатын жерлер бар, бұл партизандық соғыс үшін тиімді.
Dialogue: 0,0:19:01.64,0:19:05.56,Default,,0,0,0,,Олай болса, біз өзін-өзі қорғау күштерінен қолдау сұрауларына дереу жауап бере алмаймыз.
Dialogue: 0,0:19:05.89,0:19:08.93,Default,,0,0,0,,Сіз шынымен де осындай нәрсе келеді деп ойлайсыз ба?
Dialogue: 0,0:19:09.39,0:19:10.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:16.23,0:19:17.99,Default,,0,0,0,,...
Dialogue: 0,0:19:18.90,0:19:20.53,Default,,0,0,0,,Мияу!
Dialogue: 0,0:19:21.53,0:19:23.41,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:19:23.49,0:19:26.03,Default,,0,0,0,,Оның да құйрығы бар-жоғын тексергім келді.
Dialogue: 0,0:19:26.54,0:19:28.54,Default,,0,0,0,,...
Dialogue: 0,0:19:28.62,0:19:30.96,Default,,0,0,0,,...
Dialogue: 0,0:19:31.04,0:19:33.79,Default,,0,0,0,,Оқиғасыз тарағанымыз жақсы болғанымен.
Dialogue: 0,0:19:34.21,0:19:37.92,Default,,0,0,0,,Сатоми-кун, маңызды біреуді көргенде, оны ұрмай тұра алмайсың ба?
Dialogue: 0,0:19:38.01,0:19:40.92,Default,,0,0,0,,Сіз жай ғана күмәніңізді жоюға тырыстыңыз.
Dialogue: 0,0:19:41.01,0:19:45.43,Default,,0,0,0,,Сіз шынымен бізбен бірге соғысуды жоспарлап отырсыз ба?
Dialogue: 0,0:19:45.68,0:19:48.06,Default,,0,0,0,,...
Dialogue: 0,0:19:49.35,0:19:50.60,Default,,0,0,0,,Кисара мырза
Dialogue: 0,0:19:50.89,0:19:54.06,Default,,0,0,0,,…
Dialogue: 0,0:19:56.57,0:19:59.82,Default,,0,0,0,,...
Dialogue: 0,0:20:00.24,0:20:02.20,Default,,0,0,0,,​​О... не?
Dialogue: 0,0:20:04.28,0:20:08.04,Default,,0,0,0,,Мен де, Сатоми-кунға қауіп төнгенде.
Dialogue: 0,0:20:08.20,0:20:11.79,Default,,0,0,0,,Мен жай ғана дұға етуді қаламаймын!
Dialogue: 0,0:20:12.75,0:20:14.37,Default,,0,0,0,,...
Dialogue: 0,0:20:14.50,0:20:18.05,Default,,0,0,0,,Кедергі болса, кесіп тастауға қарсы емеспін.
Dialogue: 0,0:20:18.63,0:20:22.22,Default,,0,0,0,,...
Dialogue: 0,0:20:22.80,0:20:25.05,Default,,0,0,0,,...
Dialogue: 0,0:20:25.59,0:20:26.93,Default,,0,0,0,,...
Dialogue: 0,0:20:27.26,0:20:30.93,Default,,0,0,0,,…
Dialogue: 0,0:20:34.94,0:20:36.10,Default,,0,0,0,,Ах
Dialogue: 0,0:20:36.19,0:20:39.36,Default,,0,0,0,,…  …
Dialogue: 0,0:20:40.32,0:20:41.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:43.32,0:20:44.57,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:46.99,0:20:48.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:51.50,0:20:54.79,Default,,0,0,0,,Ей, менің құдайым бол! (Рентаро) Иә?
Dialogue: 0,0:20:54.87,0:20:57.08,Default,,0,0,0,,―
Dialogue: 0,0:20:57.17,0:20:58.50,Default,,0,0,0,,Сіз Рентаронды азғырдыңыз!
Dialogue: 0,0:20:58.59,0:21:00.30,Default,,0,0,0,,…
Dialogue: 0,0:21:00.38,0:21:01.26,Default,,0,0,0,,Таза емес
Dialogue: 0,0:21:01.34,0:21:03.51,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:21:04.38,0:21:05.38,Default,,0,0,0,,Ах
Dialogue: 0,0:21:05.47,0:21:08.80,Default,,0,0,0,,...
Dialogue: 0,0:21:09.22,0:21:10.51,Default,,0,0,0,,...
Dialogue: 0,0:21:11.18,0:21:12.47,Default,,0,0,0,,Енджу Айхара
Dialogue: 0,0:21:13.23,0:21:14.89,Default,,0,0,0,,Тендо Кисара
Dialogue: 0,0:21:14.98,0:21:16.23,Default,,0,0,0,,Тина Спроут
Dialogue: 0,0:21:16.69,0:21:18.15,Default,,0,0,0,,Тамаки Катагири
Dialogue: 0,0:21:18.23,0:21:19.48,Default,,0,0,0,,Юдзуки Катагири
Dialogue: 0,0:21:20.40,0:21:21.82,Default,,0,0,0,,Шома Нагисава
Dialogue: 0,0:21:21.90,0:21:24.19,Default,,0,0,0,,Фу... Мен Мидори Фьюспін.
Dialogue: 0,0:21:25.57,0:21:26.66,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:21:26.91,0:21:29.99,Default,,0,0,0,,...
Dialogue: 0,0:21:30.62,0:21:34.20,Default,,0,0,0,,Монолит құлағаннан бастап ауыстырылатын монолиттің келуіне дейін 3 күн
Dialogue: 0,0:21:34.29,0:21:36.25,Default,,0,0,0,,Күшімізді біріктіріп, күресейік!
Dialogue: 0,0:21:36.54,0:21:39.04,Default,,0,0,0,,Бұл қазірдің өзінде асыра сілтеу
Dialogue: 0,0:21:39.13,0:21:41.30,Default,,0,0,0,,Менің өмірім сенікі
Dialogue: 0,0:21:41.80,0:21:46.30,Default,,0,0,0,,Rentaro Сізге берген қуатты абайсызда қолданбаңыз!
Dialogue: 0,0:21:46.80,0:21:48.01,Default,,0,0,0,,Рентаро! (Рентаро) Уау
Dialogue: 0,0:21:48.09,0:21:50.97,Default,,0,0,0,,Енді менің барлық достарым бар, бұл әхем!
Dialogue: 0,0:21:51.05,0:21:52.39,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:52.47,0:21:54.93,Default,,0,0,0,,Бұл Тенчу қыздарының үнемі айтатын әні.
Dialogue: 0,0:21:55.23,0:21:57.39,Default,,0,0,0,,Менімен бірге кәнизактар!
Dialogue: 0,0:21:57.48,0:21:59.19,Default,,0,0,0,,Мен жеңетініме сенімдімін!
Dialogue: 0,0:22:00.56,0:22:01.57,Default,,0,0,0,,О
Dialogue: 0,0:22:02.15,0:22:04.44,Default,,0,0,0,,Олай болса, бәріміз кеттік!
Dialogue: 0,0:22:04.53,0:22:05.69,Default,,0,0,0,,Иә...
Dialogue: 0,0:22:06.03,0:22:07.49,Default,,0,0,0,,О!
Dialogue: 0,0:22:07.57,0:22:08.45,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:22:08.99,0:22:13.24,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:22:20.00,0:22:25.01,Default,,0,0,0,,♪～
Dialogue: 0,0:23:24.82,0:23:29.24,Default,,0,0,0,,～♪
Dialogue: 0,0:23:31.57,0:23:32.95,Default,,0,0,0,,Бір күні мен сондай бақытты боламын.
Dialogue: 0,0:23:33.03,0:23:35.41,Default,,0,0,0,,Ақырзаманның келе жатқанын түсінгенде... (Энджу) Жібер!
Dialogue: 0,0:23:35.49,0:23:37.37,Default,,0,0,0,,Біз кімді қорғаймыз?
Dialogue: 0,0:23:37.45,0:23:40.91,Default,,0,0,0,,Кім үшін күресуім керек? Неге!
Dialogue: 0,0:23:42.41,0:23:48.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
