Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.87,0:00:05.54,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:06.00,0:00:08.96,Default,,0,0,0,,Ах... Рентаро
Dialogue: 0,0:00:09.96,0:00:11.26,Default,,0,0,0,,Біз де барайық!
Dialogue: 0,0:00:11.34,0:00:13.09,Default,,0,0,0,,Мен қала беремін
Dialogue: 0,0:00:15.39,0:00:17.68,Default,,0,0,0,,Мұны біреу тоқтатуы керек...
Dialogue: 0,0:00:17.76,0:00:20.52,Default,,0,0,0,,Жеңсең де, жеңілсең де жойыласың.
Dialogue: 0,0:00:21.73,0:00:23.27,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:00:23.35,0:00:25.40,Default,,0,0,0,,Саным аз болса, қашамын.
Dialogue: 0,0:00:25.94,0:00:28.11,Default,,0,0,0,,Бас менеджер, өтінемін.
Dialogue: 0,0:00:28.19,0:00:29.36,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:00:29.44,0:00:31.11,Default,,0,0,0,,Кеттік, Енджу! (Энджу) Иә.
Dialogue: 0,0:00:40.04,0:00:46.21,Default,,0,0,0,,♪～
Dialogue: 0,0:02:03.74,0:02:09.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:13.84,0:02:15.42,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:02:15.51,0:02:16.51,Default,,0,0,0,,О
Dialogue: 0,0:02:17.17,0:02:19.01,Default,,0,0,0,,Уау... Иә?
Dialogue: 0,0:02:19.09,0:02:20.93,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:02:22.51,0:02:23.72,Default,,0,0,0,,Hiii
Dialogue: 0,0:02:28.10,0:02:29.56,Default,,0,0,0,,(шу)
Dialogue: 0,0:02:31.40,0:02:35.07,Default,,0,0,0,,Қылыш... Менің қылышым...
Dialogue: 0,0:02:35.82,0:02:38.57,Default,,0,0,0,,Икума... Командир?
Dialogue: 0,0:02:39.03,0:02:41.82,Default,,0,0,0,,Менің қылышымды білмейсің бе?
Dialogue: 0,0:02:42.41,0:02:44.58,Default,,0,0,0,,Егер бұл...
Dialogue: 0,0:02:44.99,0:02:47.95,Default,,0,0,0,,Әлі де... ұрыс...
Dialogue: 0,0:02:48.37,0:02:49.91,Default,,0,0,0,,Ru... Уф
Dialogue: 0,0:02:50.25,0:02:51.50,Default,,0,0,0,,Ах
Dialogue: 0,0:02:52.58,0:02:54.21,Default,,0,0,0,,Әке, таң қалдырыңыз!
Dialogue: 0,0:02:54.54,0:02:55.38,Default,,0,0,0,,Ах
Dialogue: 0,0:02:55.55,0:02:57.88,Default,,0,0,0,,Ол шынымен де тірі болды.
Dialogue: 0,0:03:01.72,0:03:03.51,Default,,0,0,0,,Перде жақын
Dialogue: 0,0:03:03.93,0:03:07.10,Default,,0,0,0,,Мәселені шешейік, Сатоми-кун.
Dialogue: 0,0:03:07.89,0:03:09.10,Default,,0,0,0,,Маңайдағы полиция күштері -
Dialogue: 0,0:03:09.18,0:03:12.10,Default,,0,0,0,,Тіпті ең жақын жұп бір сағаттан астам уақыт алады.
Dialogue: 0,0:03:12.19,0:03:13.86,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:13.94,0:03:15.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:18.78,0:03:19.90,Default,,0,0,0,,Кисара
Dialogue: 0,0:03:20.36,0:03:22.16,Default,,0,0,0,,Мен сізге қоңырау шалдым.
Dialogue: 0,0:03:22.86,0:03:24.16,Default,,0,0,0,,Президент Тендо
Dialogue: 0,0:03:24.45,0:03:27.45,Default,,0,0,0,,Сатоми жұбының ұту көрсеткіші қандай деп ойлайсыз?
Dialogue: 0,0:03:28.08,0:03:30.16,Default,,0,0,0,,Менің үмітімді ескерсеңіз
Dialogue: 0,0:03:30.66,0:03:32.50,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:03:32.58,0:03:35.08,Default,,0,0,0,,Иә!? Екінші тарап «Жаңа адам құру жоспарынан».
Dialogue: 0,0:03:35.17,0:03:37.42,Default,,0,0,0,,Бұл аман қалу. Жеңуге мүмкіндік жоқ...
Dialogue: 0,0:03:37.50,0:03:38.55,Default,,0,0,0,,10 жыл бұрын…
Dialogue: 0,0:03:39.13,0:03:41.51,Default,,0,0,0,,Гастреа менің үйіме басып кірді.
Dialogue: 0,0:03:41.59,0:03:43.76,Default,,0,0,0,,Әкем мен шешемді жалмадым.
Dialogue: 0,0:03:44.26,0:03:45.80,Default,,0,0,0,,Сол кездегі күйзеліске байланысты...
Dialogue: 0,0:03:46.18,0:03:48.97,Default,,0,0,0,,Бүйрек қызметі дерлік тоқтады.
Dialogue: 0,0:03:49.56,0:03:53.02,Default,,0,0,0,,Сол кезде Рентаро Сатоми мені қорғады.
Dialogue: 0,0:03:53.10,0:03:55.31,Default,,0,0,0,,Оң қол Оң аяқ Сол көз
Dialogue: 0,0:03:56.06,0:03:57.82,Default,,0,0,0,,Гастреа ұрлаған
Dialogue: 0,0:03:58.32,0:04:01.95,Default,,0,0,0,,Ол 22-бөлімде өлім жазасына кесілді
Dialogue: 0,0:04:02.03,0:04:04.57,Default,,0,0,0,,Хирург – доктор Сумире Мурото
Dialogue: 0,0:04:05.07,0:04:06.82,Default,,0,0,0,,Сумире Мурото…
Dialogue: 0,0:04:07.03,0:04:08.74,Default,,0,0,0,,А... мүмкін емес!
Dialogue: 0,0:04:10.50,0:04:12.75,Default,,0,0,0,,Ісіңізді қайтара алмайсыз.
Dialogue: 0,0:04:13.62,0:04:15.04,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:04:15.12,0:04:18.13,Default,,0,0,0,,Өйткені біз кедергі жасап тұрмыз!
Dialogue: 0,0:04:18.96,0:04:20.88,Default,,0,0,0,,Екі жеңіліс
Dialogue: 0,0:04:20.96,0:04:22.84,Default,,0,0,0,,Барлық одақтастарды жойыңыз
Dialogue: 0,0:04:22.92,0:04:24.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:24.34,0:04:26.64,Default,,0,0,0,,Бұл күтпеген жағдай, бейбақ!
Dialogue: 0,0:04:27.30,0:04:28.64,Default,,0,0,0,,Сізді жойыңыз!
Dialogue: 0,0:04:29.14,0:04:30.43,Default,,0,0,0,,Хехе... (Саусақтардың сықырлаған дыбысы)
Dialogue: 0,0:04:31.14,0:04:33.73,Default,,0,0,0,,Тендо стиліндегі жекпе-жек техникасы №3!
Dialogue: 0,0:04:34.23,0:04:35.56,Default,,0,0,0,,қыш дөңгелегі кофуки
Dialogue: 0,0:04:37.94,0:04:38.86,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:04:39.02,0:04:41.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:41.40,0:04:42.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:42.61,0:04:45.78,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,0:04:48.03,0:04:49.12,Default,,0,0,0,,Уау
Dialogue: 0,0:04:50.95,0:04:54.12,Default,,0,0,0,,Максималды ауырсынуды жеңді!? Ах...
Dialogue: 0,0:05:03.26,0:05:05.68,Default,,0,0,0,,Бұл варан протезі ме!?
Dialogue: 0,0:05:06.01,0:05:07.39,Default,,0,0,0,,Жоқ, сен де!?
Dialogue: 0,0:05:07.93,0:05:10.14,Default,,0,0,0,,Мен де атымды қояйын, Қагетане.
Dialogue: 0,0:05:10.22,0:05:13.02,Default,,0,0,0,,Шығыс армиясының бұрынғы құрлықтағы өзін-өзі қорғау күштері
Dialogue: 0,0:05:13.10,0:05:15.31,Default,,0,0,0,,787 Механикаландырылған арнайы жасақ
Dialogue: 0,0:05:15.39,0:05:17.65,Default,,0,0,0,,Адамды құрудың жаңа жоспары
Dialogue: 0,0:05:18.06,0:05:19.40,Default,,0,0,0,,Рентаро Сатоми!
Dialogue: 0,0:05:19.86,0:05:21.32,Default,,0,0,0,,Басқа адам болды ма?
Dialogue: 0,0:05:21.40,0:05:24.15,Default,,0,0,0,,Гастрея соғысынан туған адам қарулары...
Dialogue: 0,0:05:24.53,0:05:26.32,Default,,0,0,0,,Coo... hehe
Dialogue: 0,0:05:26.40,0:05:28.78,Default,,0,0,0,,Хахаха... Уф!
Dialogue: 0,0:05:29.74,0:05:31.37,Default,,0,0,0,,Мен ауырдым
Dialogue: 0,0:05:31.83,0:05:33.58,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:05:33.79,0:05:36.00,Default,,0,0,0,,Өмір қандай тамаша!
Dialogue: 0,0:05:36.08,0:05:37.79,Default,,0,0,0,,Халлилуя!
Dialogue: 0,0:05:38.08,0:05:40.25,Default,,0,0,0,,Әкеңді қорлама!
Dialogue: 0,0:05:45.38,0:05:46.67,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:05:46.76,0:05:48.59,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:05:51.26,0:05:54.18,Default,,0,0,0,,Жылау содомия Ізгі хабарды айтады
Dialogue: 0,0:05:58.56,0:06:01.61,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:06:02.36,0:06:04.98,Default,,0,0,0,,Біз өлтіру үшін жаратылғанбыз
Dialogue: 0,0:06:05.57,0:06:07.99,Default,,0,0,0,,Егер Гастрея соғысы қайта басталса...
Dialogue: 0,0:06:08.07,0:06:11.28,Default,,0,0,0,,Біздің өмір сүруіміздің маңыздылығы дәлелденді
Dialogue: 0,0:06:11.45,0:06:14.70,Default,,0,0,0,,Жоқ, сэр, тек сол үшін!
Dialogue: 0,0:06:14.79,0:06:16.45,Default,,0,0,0,,Сіздің бастамаңыз...
Dialogue: 0,0:06:16.66,0:06:18.87,Default,,0,0,0,,Олардың қарғыс атқан балалар екені анықталғанда...
Dialogue: 0,0:06:18.96,0:06:21.29,Default,,0,0,0,,Айналаңыздағылардың реакциясы қандай болды?
Dialogue: 0,0:06:21.38,0:06:23.13,Default,,0,0,0,,Құтты болсын?
Dialogue: 0,0:06:23.21,0:06:26.80,Default,,0,0,0,,Жүрегіңді шексіз шаттық шайып кетті ме?
Dialogue: 0,0:06:27.01,0:06:30.76,Default,,0,0,0,,Олар қалаған дүние мен біз қалаған дүние басқа!
Dialogue: 0,0:06:31.43,0:06:34.01,Default,,0,0,0,,Біз таңдаулылармыз
Dialogue: 0,0:06:34.18,0:06:37.93,Default,,0,0,0,,Жүр, Рентаро Сатоми, менімен бірге жүр!
Dialogue: 0,0:06:38.39,0:06:41.27,Default,,0,0,0,,Біле берме, бейбақ!
Dialogue: 0,0:06:41.44,0:06:43.27,Default,,0,0,0,,Сіз айтып отырған болашақ
Dialogue: 0,0:06:43.36,0:06:44.94,Default,,0,0,0,,Мүлдем қабылданбайды!
Dialogue: 0,0:06:45.19,0:06:46.98,Default,,0,0,0,,Тория!
Dialogue: 0,0:06:47.69,0:06:48.95,Default,,0,0,0,,Уау
Dialogue: 0,0:06:49.53,0:06:51.07,Default,,0,0,0,,Фухаха... (Рентаро) Енджу!
Dialogue: 0,0:06:53.07,0:06:53.99,Default,,0,0,0,,Уф
Dialogue: 0,0:06:55.74,0:06:57.87,Default,,0,0,0,,Егер сіз мойынсұна алмасаңыз...
Dialogue: 0,0:06:57.95,0:06:59.04,Default,,0,0,0,,Ал енді—
Dialogue: 0,0:07:01.37,0:07:03.46,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:07:03.92,0:07:04.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:05.00,0:07:06.46,Default,,0,0,0,,Гах... (Энджу) Ах.
Dialogue: 0,0:07:09.13,0:07:10.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:11.43,0:07:13.47,Default,,0,0,0,,Бұл сіздің жоғалтыңыз.
Dialogue: 0,0:07:14.97,0:07:16.18,Default,,0,0,0,,Немесе бұл сәл қатігездік пе?
Dialogue: 0,0:07:16.81,0:07:17.97,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:07:20.94,0:07:23.27,Default,,0,0,0,,Уф... Энжу...
Dialogue: 0,0:07:24.31,0:07:27.98,Default,,0,0,0,,Рентаро! Менің күңімді жалғыз қалдырмаңыз!
Dialogue: 0,0:07:28.32,0:07:29.40,Default,,0,0,0,,Ха...
Dialogue: 0,0:07:30.24,0:07:32.49,Default,,0,0,0,,Кук кук…
Dialogue: 0,0:07:32.57,0:07:34.49,Default,,0,0,0,,AGV сынақ препараты -
Dialogue: 0,0:07:34.57,0:07:36.99,Default,,0,0,0,,Гастриавируспен түзілген
Dialogue: 0,0:07:37.83,0:07:41.25,Default,,0,0,0,,Ол адамға Gastrea сияқты қалпына келтіру қабілетін береді, бірақ...
Dialogue: 0,0:07:42.04,0:07:45.88,Default,,0,0,0,,Gastrea-ға айналу мүмкіндігі 20%
Dialogue: 0,0:07:46.84,0:07:48.63,Default,,0,0,0,,Мүмкін болса, оны қолданбаңыз.
Dialogue: 0,0:07:49.71,0:07:51.34,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,0:07:53.05,0:07:54.22,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:07:56.39,0:07:58.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:59.39,0:08:01.81,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:08:01.98,0:08:04.31,Default,,0,0,0,,(Рентароның ыңырануы)
Dialogue: 0,0:08:04.48,0:08:05.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:05.65,0:08:07.36,Default,,0,0,0,,Қайта... Рентаро!?
Dialogue: 0,0:08:08.27,0:08:09.82,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:11.11,0:08:15.11,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:15.20,0:08:16.03,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:16.12,0:08:21.04,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:21.12,0:08:24.37,Default,,0,0,0,,Сіз бәс тігуді ұтып алдыңыз.
Dialogue: 0,0:08:25.75,0:08:28.46,Default,,0,0,0,,Сатоми-кун, сен...
Dialogue: 0,0:08:31.17,0:08:34.97,Default,,0,0,0,,Тендо стиліндегі жауынгерлік техника Сюитен Иппекидің ұстанымы
Dialogue: 0,0:08:36.59,0:08:37.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:38.26,0:08:39.10,Default,,0,0,0,,Ах
Dialogue: 0,0:08:39.39,0:08:41.47,Default,,0,0,0,,Унрейби көлі тұқы тұқы
Dialogue: 0,0:08:45.52,0:08:47.10,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:08:50.36,0:08:52.03,Default,,0,0,0,,Аххххх...
Dialogue: 0,0:08:53.03,0:08:54.82,Default,,0,0,0,,Жасырын медитация/жылау
Dialogue: 0,0:08:55.99,0:08:58.32,Default,,0,0,0,,Мен... саған...
Dialogue: 0,0:08:59.74,0:09:01.45,Default,,0,0,0,,Мен жеңілемін бе...
Dialogue: 0,0:09:06.37,0:09:07.50,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:09:07.92,0:09:08.92,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:09:19.35,0:09:21.31,Default,,0,0,0,,Эбису Кагетане реакциясы Жоғалу!
Dialogue: 0,0:09:21.39,0:09:24.18,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:09:24.81,0:09:25.85,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:28.27,0:09:29.11,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:09:29.11,0:09:30.11,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:09:29.11,0:09:30.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:30.11,0:09:31.27,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:09:31.27,0:09:32.11,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:09:31.27,0:09:32.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:32.61,0:09:33.44,Default,,0,0,0,,Рентаро!
Dialogue: 0,0:09:35.90,0:09:37.07,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:09:37.32,0:09:38.57,Default,,0,0,0,,Папа!
Dialogue: 0,0:09:39.16,0:09:40.41,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:09:40.49,0:09:42.91,Default,,0,0,0,,Жоқ, папа! Ах...
Dialogue: 0,0:09:43.29,0:09:44.91,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:09:45.00,0:09:46.41,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:47.16,0:09:49.88,Default,,0,0,0,,Ол енді менің жауым емес
Dialogue: 0,0:09:49.96,0:09:50.42,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:09:50.42,0:09:51.92,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:09:50.42,0:09:51.92,Default,,0,0,0,,Иә? (Энджу) Ах.
Dialogue: 0,0:09:51.92,0:09:53.00,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:09:53.75,0:09:55.80,Default,,0,0,0,,Уәде бойынша жеңдім, Кисара мырза.
Dialogue: 0,0:09:56.34,0:09:58.22,Default,,0,0,0,,Иә, мен көрдім.
Dialogue: 0,0:09:58.55,0:09:59.97,Default,,0,0,0,,Бірақ, Сатоми-кун
Dialogue: 0,0:10:00.05,0:10:02.51,Default,,0,0,0,,Мен саған жаман жаңалық айтуым керек.
Dialogue: 0,0:10:03.56,0:10:06.31,Default,,0,0,0,,V кезең асқазан...
Dialogue: 0,0:10:06.68,0:10:08.56,Default,,0,0,0,,Ол пайда болды!
Dialogue: 0,0:10:13.65,0:10:17.90,Default,,0,0,0,,(Скорпионның ұрыс айқайы)
Dialogue: 0,0:10:23.53,0:10:27.33,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:10:43.10,0:10:46.14,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:10:47.22,0:10:49.64,Default,,0,0,0,,Мұның бәрі ... соңы ма?
Dialogue: 0,0:10:50.60,0:10:52.10,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:10:52.19,0:10:55.15,Default,,0,0,0,,Менің стратегиямды Сент-Тенши-сама мақұлдады.
Dialogue: 0,0:10:55.65,0:10:58.99,Default,,0,0,0,,Жауап сізден көрініп тұрғандай оңтүстік-шығыс бағытта.
Dialogue: 0,0:11:01.20,0:11:02.91,Default,,0,0,0,,Аспандағы баспалдақ…
Dialogue: 0,0:11:03.45,0:11:05.95,Default,,0,0,0,,Сен істейсің, Сатоми-кун.
Dialogue: 0,0:11:06.04,0:11:09.21,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:11:10.79,0:11:13.25,Default,,0,0,0,,Сызықтық суперэлектромагниттік проекциялық құрылғы
Dialogue: 0,0:11:13.33,0:11:15.21,Default,,0,0,0,,Аспан баспалдағы ретінде де белгілі
Dialogue: 0,0:11:20.93,0:11:23.22,Default,,0,0,0,,Диаметрі 800 мм немесе одан аз металл ұшатын заттар -
Dialogue: 0,0:11:23.76,0:11:27.22,Default,,0,0,0,,Жарықтандыру жылдамдығымен атылатын рельсті мылтық модулі
Dialogue: 0,0:11:30.73,0:11:34.52,Default,,0,0,0,,Егер сіз варан оғын сөзсіз жылдамдықпен атсаңыз...
Dialogue: 0,0:11:34.61,0:11:39.24,Default,,0,0,0,,Тіпті V сатысы Гастреа болса да, мен оны міндетті түрде жоя аламын!
Dialogue: 0,0:11:42.82,0:11:45.95,Default,,0,0,0,,Сызықтық суперэлектромагниттік проекциялық құрылғыны іске қосуды бастаңыз
Dialogue: 0,0:11:46.53,0:11:48.62,Default,,0,0,0,,Қуат көзі Аномалия жоқ
Dialogue: 0,0:11:48.70,0:11:51.87,Default,,0,0,0,,Сұйық гелийді сақтауға арналған Дьюар бөтелкесінде ешқандай ауытқулар жоқ.
Dialogue: 0,0:11:52.50,0:11:53.83,Default,,0,0,0,,Рахмет, Сатоми-кун
Dialogue: 0,0:11:53.92,0:11:57.13,Default,,0,0,0,,Іске қосудан кейінгі іске қосу реті осында орындалады.
Dialogue: 0,0:11:57.67,0:11:59.92,Default,,0,0,0,,Қарап тұру дұрыс па?
Dialogue: 0,0:12:00.01,0:12:02.13,Default,,0,0,0,,Жасай бер десең де, істей алмаймын.
Dialogue: 0,0:12:38.75,0:12:40.80,Default,,0,0,0,,Бұл V кезең ме?
Dialogue: 0,0:12:40.88,0:12:41.88,Default,,0,0,0,,О
Dialogue: 0,0:12:42.13,0:12:45.26,Default,,0,0,0,,...
Dialogue: 0,0:12:45.34,0:12:48.43,Default,,0,0,0,,Бұл бір кездері дүниені құрдымға апарған Гастреа.
Dialogue: 0,0:12:49.05,0:12:50.43,Default,,0,0,0,,Бұл жаман, Сатоми-кун!
Dialogue: 0,0:12:50.51,0:12:52.85,Default,,0,0,0,,Камерада ауытқуды көрсететін хабарлама бар!
Dialogue: 0,0:12:53.31,0:12:54.98,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:12:55.14,0:12:57.40,Default,,0,0,0,,Мүмкін варан броньды тесіп өтетін оқ...
Dialogue: 0,0:12:57.48,0:12:59.32,Default,,0,0,0,,Ол жүктелмеуі мүмкін!
Dialogue: 0,0:12:59.40,0:13:00.73,Default,,0,0,0,,Не?!
Dialogue: 0,0:13:02.32,0:13:05.61,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:13:07.41,0:13:09.78,Default,,0,0,0,,Шүкір, менде оқ жоқ!
Dialogue: 0,0:13:09.87,0:13:13.12,Default,,0,0,0,,Энергияны сақтау жүйесі Салқындатқыштың ағып кетуін тексеріңіз
Dialogue: 0,0:13:13.20,0:13:14.41,Default,,0,0,0,,Тәжірибені дереу тоқтатыңыз.
Dialogue: 0,0:13:14.41,0:13:15.37,Default,,0,0,0,,Тәжірибені дереу тоқтатыңыз.
Dialogue: 0,0:13:14.41,0:13:15.37,Default,,0,0,0,,Біз не істеуіміз керек, Рентаро?
Dialogue: 0,0:13:16.33,0:13:18.13,Default,,0,0,0,,Магнит өрісінің әсерінен-
Dialogue: 0,0:13:18.21,0:13:21.80,Default,,0,0,0,,Сатоми-кун... ол қашықтан енгізуді қабылдамайды!
Dialogue: 0,0:13:22.00,0:13:23.38,Default,,0,0,0,,Сатоми-кун!
Dialogue: 0,0:13:28.14,0:13:29.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:30.80,0:13:33.77,Default,,0,0,0,,Рентаро болмайды, мырзалар...
Dialogue: 0,0:13:34.60,0:13:36.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:36.48,0:13:37.98,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:38.06,0:13:40.15,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:13:41.11,0:13:43.07,Default,,0,0,0,,Оң қолымды оқ ретінде пайдалан
Dialogue: 0,0:13:45.28,0:13:47.74,Default,,0,0,0,,Егер бұл супер варан болса, ешқандай проблема болмауы керек!
Dialogue: 0,0:13:49.87,0:13:51.74,Default,,0,0,0,,Валандық тексеруді жүктеу
Dialogue: 0,0:13:52.45,0:13:54.04,Default,,0,0,0,,Өртті басқару Қайту мүмкін емес!
Dialogue: 0,0:13:54.75,0:13:57.71,Default,,0,0,0,,Басқару бөлмесінен қолмен атудан басқа ештеңе істеу мүмкін емес!
Dialogue: 0,0:13:57.79,0:13:59.21,Default,,0,0,0,,Сатоми-кун, сен мұны естідің бе?
Dialogue: 0,0:13:59.88,0:14:02.00,Default,,0,0,0,,Бұл жерден рельс мылтық атуға болмайды.
Dialogue: 0,0:14:02.09,0:14:03.71,Default,,0,0,0,,Өтінемін, орындаңыз!
Dialogue: 0,0:14:04.09,0:14:07.34,Default,,0,0,0,,А... сен әзілдеп тұрсың! Кисара мырза
Dialogue: 0,0:14:07.42,0:14:09.59,Default,,0,0,0,,Мен үшін бұл мүмкін емес! Кисара мырза!
Dialogue: 0,0:14:09.68,0:14:11.89,Default,,0,0,0,,Сатоми-кун, әлем... өтінемін...
Dialogue: 0,0:14:11.97,0:14:13.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:13.26,0:14:14.97,Default,,0,0,0,,Кисара мырза... Кисара мырза!
Dialogue: 0,0:14:15.93,0:14:18.19,Default,,0,0,0,,Қуатты толтыру 100%
Dialogue: 0,0:14:18.27,0:14:20.48,Default,,0,0,0,,Қолмен іске қосу жүйесін іске қосыңыз
Dialogue: 0,0:14:22.82,0:14:23.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:24.40,0:14:25.48,Default,,0,0,0,,Рентаро...
Dialogue: 0,0:14:26.07,0:14:27.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:39.08,0:14:41.75,Default,,0,0,0,,50 км қашықтықтағы нысанаға
Dialogue: 0,0:14:41.83,0:14:43.54,Default,,0,0,0,,Сіз қолмен болжап жатырсыз ба?
Dialogue: 0,0:14:44.55,0:14:45.55,Default,,0,0,0,,Сатоми-кун...
Dialogue: 0,0:14:46.42,0:14:47.55,Default,,0,0,0,,Сатоми мырза...
Dialogue: 0,0:14:52.47,0:14:55.22,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:15:04.69,0:15:05.52,Default,,0,0,0,,Гррр…
Dialogue: 0,0:15:06.28,0:15:07.65,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:07.82,0:15:10.36,Default,,0,0,0,,Менің қолымнан келмейді... Мен...
Dialogue: 0,0:15:11.49,0:15:14.12,Default,,0,0,0,,Рентароның кәнизаты бар
Dialogue: 0,0:15:14.87,0:15:17.83,Default,,0,0,0,,Егер сіз оны жойсаңыз, біз дайынбыз.
Dialogue: 0,0:15:17.91,0:15:19.79,Default,,0,0,0,,Мен жеңетініме сенімдімін
Dialogue: 0,0:15:19.87,0:15:21.96,Default,,0,0,0,,Оқ Токио аймағына бұрылды.
Dialogue: 0,0:15:22.04,0:15:24.25,Default,,0,0,0,,Бұл бұрын-соңды болмаған апатқа әкелуі мүмкін.
Dialogue: 0,0:15:25.04,0:15:28.01,Default,,0,0,0,,Бірақ Рентаро болжайды.
Dialogue: 0,0:15:29.34,0:15:30.55,Default,,0,0,0,,Энжу…
Dialogue: 0,0:15:35.89,0:15:38.68,Default,,0,0,0,,Әлемді тек Рентаро ғана құтқара алады
Dialogue: 0,0:15:38.89,0:15:42.19,Default,,0,0,0,,Рентародан басқа ешкім жоқ...
Dialogue: 0,0:15:51.07,0:15:55.16,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:15:56.20,0:15:59.20,Default,,0,0,0,,Енджу, мен сені ешқашан жоғалтқым келмейді.
Dialogue: 0,0:16:00.00,0:16:02.62,Default,,0,0,0,,Мұны ұсыныс ретінде түсіндіру дұрыс па?
Dialogue: 0,0:16:03.04,0:16:05.79,Default,,0,0,0,,Сен ақымақсың ба? Оны отбасы ретінде түсіндіріңіз.
Dialogue: 0,0:16:05.88,0:16:08.63,Default,,0,0,0,,10 жасар балаға махаббат туралы сөйлесуге жол бермеңіз.
Dialogue: 0,0:16:08.75,0:16:10.38,Default,,0,0,0,,Сіз енді қорықпайсыз, солай ма?
Dialogue: 0,0:16:10.46,0:16:11.51,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:13.26,0:16:15.68,Default,,0,0,0,,А, мен оны аяқтаймын.
Dialogue: 0,0:16:30.28,0:16:32.44,Default,,0,0,0,,Енджу... (Энджу) Ах.
Dialogue: 0,0:16:33.99,0:16:34.95,Default,,0,0,0,,Жүр!
Dialogue: 0,0:16:40.33,0:16:42.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:49.88,0:16:53.17,Default,,0,0,0,,(Скорпионның айқайы)
Dialogue: 0,0:17:25.66,0:17:27.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:47.94,0:17:49.69,Default,,0,0,0,,Неге қашып кетпедің?
Dialogue: 0,0:17:50.23,0:17:52.86,Default,,0,0,0,,Мен таптым...
Dialogue: 0,0:17:53.86,0:17:57.03,Default,,0,0,0,,Саны көп болса, қашамын дедің бе?
Dialogue: 0,0:17:57.24,0:18:00.37,Default,,0,0,0,,Сатоми мырза, бас менеджер ше?
Dialogue: 0,0:18:03.04,0:18:03.87,Default,,0,0,0,,Ал сендерге келсек, капитан Леви міндетті түрде
Dialogue: 0,0:18:09.88,0:18:11.00,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:12.38,0:18:15.63,Default,,0,0,0,,Сатоми мырза, мен...
Dialogue: 0,0:18:15.71,0:18:20.51,Default,,0,0,0,,Иә, сөзсіз эрозия деңгейі 50%-дан асады.
Dialogue: 0,0:18:21.68,0:18:25.27,Default,,0,0,0,,Маған да адам болып өлуге рұқсат етіңіз.
Dialogue: 0,0:18:25.72,0:18:29.06,Default,,0,0,0,,Менің бар екенімді растаған сен...
Dialogue: 0,0:18:29.27,0:18:31.31,Default,,0,0,0,,Мен сенің өлгеніңді қаламадым
Dialogue: 0,0:18:31.40,0:18:33.27,Default,,0,0,0,,Сондықтан мен бар күшімді салдым
Dialogue: 0,0:18:34.15,0:18:35.90,Default,,0,0,0,,Бұл қиын болды...
Dialogue: 0,0:18:36.03,0:18:39.07,Default,,0,0,0,,Мен тірі болғаныма қуаныштымын...
Dialogue: 0,0:18:39.82,0:18:42.70,Default,,0,0,0,,Менің кеудем қазір...
Dialogue: 0,0:18:42.83,0:18:44.91,Default,,0,0,0,,Мен ризашылыққа толымын
Dialogue: 0,0:18:45.37,0:18:47.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:57.63,0:19:01.97,Default,,0,0,0,,Эй, Сатоми-сан, сенің достарың көп емес пе?
Dialogue: 0,0:19:02.05,0:19:02.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:03.05,0:19:05.43,Default,,0,0,0,,Мен сенің досың боламын
Dialogue: 0,0:19:07.56,0:19:10.39,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:19:10.77,0:19:14.19,Default,,0,0,0,,Сен менің таптырмас досымсың
Dialogue: 0,0:19:15.86,0:19:17.32,Default,,0,0,0,,Сатоми мырза
Dialogue: 0,0:19:17.40,0:19:21.16,Default,,0,0,0,,Бұдан былай қараңғыда адасып қалсаң...
Dialogue: 0,0:19:21.24,0:19:24.37,Default,,0,0,0,,Жүрегіңіздегі компасты бақылаңыз
Dialogue: 0,0:19:24.74,0:19:26.45,Default,,0,0,0,,Жарыққа қарай...
Dialogue: 0,0:19:27.12,0:19:28.95,Default,,0,0,0,,Бұл дүние...
Dialogue: 0,0:19:29.50,0:19:31.04,Default,,0,0,0,,Мені құтқар...
Dialogue: 0,0:19:31.12,0:19:32.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:33.71,0:19:35.59,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:43.76,0:19:46.47,Default,,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,0:19:58.03,0:20:00.69,Default,,0,0,0,,Ақпарат Кагетанға ағып кетті
Dialogue: 0,0:20:00.78,0:20:04.28,Default,,0,0,0,,Қорғаныс министрі Хибиданың фракциясы бақылаудан шығып кеткені айтылады.
Dialogue: 0,0:20:04.36,0:20:08.49,Default,,0,0,0,,Хибики уақытша ұстау изоляторында асылып өлді.
Dialogue: 0,0:20:08.91,0:20:10.87,Default,,0,0,0,,Ол адам сіздің қол астыңыздағы адам!
Dialogue: 0,0:20:13.37,0:20:14.37,Default,,0,0,0,,Жаңа гастреа заңы
Dialogue: 0,0:20:15.50,0:20:17.46,Default,,0,0,0,,Қарғыс атқан балалардың әлеуметтік жағдайы
Dialogue: 0,0:20:17.54,0:20:19.67,Default,,0,0,0,,жақсартуға арналған заң жобасы
Dialogue: 0,0:20:19.76,0:20:23.22,Default,,0,0,0,,Бірақ сіз қатыгез нәсілшілсіз.
Dialogue: 0,0:20:23.72,0:20:27.43,Default,,0,0,0,,Оның қызы Кохина бұл терактіге өзінің қатысы бар екенін мәлімдеді.
Dialogue: 0,0:20:27.51,0:20:30.64,Default,,0,0,0,,Қарғыс атқан балалардың арасында өшпенділік тудыруға әрекеттенген
Dialogue: 0,0:20:31.31,0:20:33.56,Default,,0,0,0,,Жаңа асқазан заңын тоқтату -
Dialogue: 0,0:20:33.64,0:20:35.69,Default,,0,0,0,,Токио аймағында жаппай қырып-жоюға шақыру.
Dialogue: 0,0:20:35.77,0:20:39.15,Default,,0,0,0,,Ол тіпті V кезеңді шақыруға тырысты!
Dialogue: 0,0:20:40.23,0:20:42.57,Default,,0,0,0,,Неліктен ұмытылған...
Dialogue: 0,0:20:42.90,0:20:47.78,Default,,0,0,0,,10 жыл бұрын, әйелім, бүкіл халық қырылған күндер.
Dialogue: 0,0:20:48.16,0:20:50.33,Default,,0,0,0,,Аяқ-қолыңды, әке-шешеңді тартып алдым.
Dialogue: 0,0:20:50.41,0:20:53.66,Default,,0,0,0,,Сол жәндіктердің қаны бар балаларға...
Dialogue: 0,0:20:53.75,0:20:56.12,Default,,0,0,0,,Адам құқықтарын көрсетіңіз?
Dialogue: 0,0:20:56.75,0:20:58.13,Default,,0,0,0,,Олар сол
Dialogue: 0,0:20:58.21,0:21:01.42,Default,,0,0,0,,Бұл дүниеде бәрін құртатын шайтан.
Dialogue: 0,0:21:02.09,0:21:04.13,Default,,0,0,0,,Олар адам баласы
Dialogue: 0,0:21:04.59,0:21:07.43,Default,,0,0,0,,Мен... Рентаро Сатоми бұл...
Dialogue: 0,0:21:08.05,0:21:10.06,Default,,0,0,0,,Енджу Айхараға сеніңіз!
Dialogue: 0,0:21:10.89,0:21:13.52,Default,,0,0,0,,Жігіт саған телефон соқты...
Dialogue: 0,0:21:14.10,0:21:16.31,Default,,0,0,0,,Сен менің өмірімді сақтап қалдың.
Dialogue: 0,0:21:17.60,0:21:19.48,Default,,0,0,0,,Өлгің келмесе
Dialogue: 0,0:21:20.36,0:21:23.49,Default,,0,0,0,,Тікелей Рентаро
Dialogue: 0,0:21:24.74,0:21:26.99,Default,,0,0,0,,Үмітсіз көзіңді жұмғанда
Dialogue: 0,0:21:27.20,0:21:29.37,Default,,0,0,0,,Мен сол сөздерді есіме түсіру арқылы аман қалдым.
Dialogue: 0,0:21:29.99,0:21:32.12,Default,,0,0,0,,Осыдан 10 жыл бұрынғы сол күн туралы
Dialogue: 0,0:21:32.58,0:21:35.00,Default,,0,0,0,,Бір күн болса да ұмытқан емеспін.
Dialogue: 0,0:21:42.63,0:21:43.80,Default,,0,0,0,,Тенши-сама әулие
Dialogue: 0,0:21:44.26,0:21:46.30,Default,,0,0,0,,Сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:21:46.38,0:21:47.55,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:48.51,0:21:50.55,Default,,0,0,0,,Мен істің ішіне қарадым.
Dialogue: 0,0:21:50.64,0:21:51.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:54.93,0:21:56.60,Default,,0,0,0,,Сынған үш дөңгелек
Dialogue: 0,0:21:57.10,0:21:58.85,Default,,0,0,0,,Неліктен бұл Скорпион деп аталады?
Dialogue: 0,0:21:58.94,0:22:00.36,Default,,0,0,0,,Бұл катализатор болуы мүмкін еді!
Dialogue: 0,0:22:00.94,0:22:03.28,Default,,0,0,0,,Ең алдымен Gastrea дегеніміз не?
Dialogue: 0,0:22:03.36,0:22:05.49,Default,,0,0,0,,Айтыңызшы, қасиетті періште!
Dialogue: 0,0:22:06.49,0:22:07.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:08.41,0:22:10.16,Default,,0,0,0,,Мен сізге айта алмаймын.
Dialogue: 0,0:22:10.57,0:22:15.58,Default,,0,0,0,,♪～
Dialogue: 0,0:22:19.17,0:22:22.21,Default,,0,0,0,,Ах... Рентаро!
Dialogue: 0,0:22:24.59,0:22:26.76,Default,,0,0,0,,Оо~ Сіздің қолыңыз сауығып қалды ма?
Dialogue: 0,0:22:26.84,0:22:27.67,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:22:28.22,0:22:30.80,Default,,0,0,0,,Сумиреден күңге дейінгі эрозия жылдамдығы сынағының нәтижелері
Dialogue: 0,0:22:30.89,0:22:31.97,Default,,0,0,0,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:22:32.05,0:22:32.89,Default,,0,0,0,,О
Dialogue: 0,0:22:32.97,0:22:34.72,Default,,0,0,0,,24,9%
Dialogue: 0,0:22:35.10,0:22:36.52,Default,,0,0,0,,Не?
Dialogue: 0,0:22:36.60,0:22:39.39,Default,,0,0,0,,Көп нәрсе өзгерген жоқ.
Dialogue: 0,0:22:41.48,0:22:42.40,Default,,0,0,0,,Сатоми мырза...
Dialogue: 0,0:22:42.90,0:22:44.61,Default,,0,0,0,,Рейтинг жақсарса...
Dialogue: 0,0:22:44.69,0:22:47.40,Default,,0,0,0,,Полиция қызметкерлеріне артықшылықтар беріледі.
Dialogue: 0,0:22:47.86,0:22:49.70,Default,,0,0,0,,Псевдоклассты жетілдіру
Dialogue: 0,0:22:49.99,0:22:52.99,Default,,0,0,0,,ЖӘНЕ ҚҰПИЯ АҚПАРАТҚА ҚОЛДАНУ КІЛТТЕРІ
Dialogue: 0,0:22:53.74,0:22:55.12,Default,,0,0,0,,Сатоми мырза
Dialogue: 0,0:22:55.37,0:22:57.00,Default,,0,0,0,,Энджу-сан және иерархия-
Dialogue: 0,0:22:57.08,0:22:58.79,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:23:02.54,0:23:05.21,Default,,0,0,0,,Сонда сіз білесіз
Dialogue: 0,0:23:06.67,0:23:08.34,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:23:08.42,0:23:11.34,Default,,0,0,0,,Сіз не істеу үшін дүниеге келдіңіз?
Dialogue: 0,0:23:18.43,0:23:23.44,Default,,0,0,0,,～♪
Dialogue: 0,0:23:31.53,0:23:33.24,Default,,0,0,0,,Мен эскорт миссиясына өтініш алдым.
Dialogue: 0,0:23:33.24,0:23:34.45,Default,,0,0,0,,Мен эскорт миссиясы туралы өтініш алдым.
Dialogue: 0,0:23:33.24,0:23:34.45,Default,,0,0,0,,Рентаро Мен өзімді жағымсыз сезінемін.
Dialogue: 0,0:23:34.45,0:23:34.62,Default,,0,0,0,,Рентаро Мен өзімді жағымсыз сезінемін.
Dialogue: 0,0:23:34.62,0:23:35.91,Default,,0,0,0,,Рентаро Мен өзімді жағымсыз сезінемін.
Dialogue: 0,0:23:34.62,0:23:35.91,Default,,0,0,0,,Сіз кімсіз (Ұстаз)? Сіздің миссияңыз қандай?
Dialogue: 0,0:23:35.91,0:23:36.83,Default,,0,0,0,,Сіз кімсіз (Ұстаз)? Сіздің миссияңыз қандай?
Dialogue: 0,0:23:36.91,0:23:40.96,Default,,0,0,0,,Токио аймағының өкілі Сейтенконы жою.
Dialogue: 0,0:23:42.46,0:23:48.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
