Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:03.54,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:00:03.62,0:00:06.21,Default,,0,0,0,,Енджу?! Ах, жақсы...
Dialogue: 0,0:00:06.29,0:00:08.13,Default,,0,0,0,,Енді осында оралыңыз!
Dialogue: 0,0:00:08.21,0:00:09.38,Default,,0,0,0,,Стратегияңызды қайта қарастырыңыз!
Dialogue: 0,0:00:11.46,0:00:14.76,Default,,0,0,0,,Енджу? Не болды? Тек жауап бер!
Dialogue: 0,0:00:15.30,0:00:17.35,Default,,0,0,0,,Сәлем Енджу!
Dialogue: 0,0:00:21.31,0:00:23.69,Default,,0,0,0,,Тина...?
Dialogue: 0,0:00:31.11,0:00:32.69,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:33.40,0:00:34.95,Default,,0,0,0,,Энжу…
Dialogue: 0,0:00:35.03,0:00:41.20,Default,,0,0,0,,♪～
Dialogue: 0,0:01:58.74,0:02:04.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:05.54,0:02:07.46,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:02:20.22,0:02:21.89,Default,,0,0,0,,Енджу қауіпсіз бе?
Dialogue: 0,0:02:22.10,0:02:23.89,Default,,0,0,0,,Жақсы шығар.
Dialogue: 0,0:02:24.18,0:02:25.01,Default,,0,0,0,,Жақсы тіл табысайық, иә?
Dialogue: 0,0:02:25.68,0:02:28.43,Default,,0,0,0,,Анестезияның айтарлықтай мөлшері енгізілді.
Dialogue: 0,0:02:28.60,0:02:30.52,Default,,0,0,0,,Мен 2-де оянамын деп ойлаймын.
Dialogue: 0,0:02:31.31,0:02:32.65,Default,,0,0,0,,2-ші күн…
Dialogue: 0,0:02:35.78,0:02:36.78,Default,,0,0,0,,Сатоми-кун…
Dialogue: 0,0:02:40.61,0:02:42.16,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:02:42.24,0:02:44.41,Default,,0,0,0,,Мұның бәрі бітті ме?
Dialogue: 0,0:02:44.99,0:02:49.91,Default,,0,0,0,,Қасиетті періште мен президент Сайтакенің үшінші кездесуі өтеді.
Dialogue: 0,0:02:53.17,0:02:54.38,Default,,0,0,0,,Қашан?
Dialogue: 0,0:02:54.46,0:02:55.92,Default,,0,0,0,,Ертең кешкі сағат 8-ден бастап
Dialogue: 0,0:02:56.67,0:02:58.05,Default,,0,0,0,,Ертең...
Dialogue: 0,0:03:00.38,0:03:01.55,Default,,0,0,0,,Ах
Dialogue: 0,0:03:02.43,0:03:03.80,Default,,0,0,0,,Сатоми-кун
Dialogue: 0,0:03:04.85,0:03:06.31,Default,,0,0,0,,Адамның иісі...
Dialogue: 0,0:03:20.78,0:03:24.62,Default,,0,0,0,,Ғайшаны төрт жерден бір уақытта атып жатыр.
Dialogue: 0,0:03:24.70,0:03:29.00,Default,,0,0,0,,Осы орындардың үшеуінде қираған ауыр пулеметтер табылды.
Dialogue: 0,0:03:29.12,0:03:32.21,Default,,0,0,0,,Оған біртүрлі құрылғы қосылған сияқты.
Dialogue: 0,0:03:32.75,0:03:36.34,Default,,0,0,0,,Біз қазір Sima Heavy Industries компаниясынан бағалауды сұрап жатырмыз.
Dialogue: 0,0:03:40.51,0:03:44.01,Default,,0,0,0,,Енджу қаласа оңай өлтірілуі мүмкін еді.
Dialogue: 0,0:03:45.05,0:03:47.01,Default,,0,0,0,,Өткен күнгі полицей...
Dialogue: 0,0:03:48.01,0:03:51.64,Default,,0,0,0,,Тина мүмкіндігінше адамдарды өлтіруден аулақ па?
Dialogue: 0,0:03:54.52,0:03:55.98,Default,,0,0,0,,Уақыты келгенде айтамын.
Dialogue: 0,0:03:56.06,0:03:59.57,Default,,0,0,0,,Тинаның 98-ші орындағы рейтингі өзгермейді.
Dialogue: 0,0:03:59.90,0:04:01.69,Default,,0,0,0,,Кисара мырза өлтіріліп кете жаздады.
Dialogue: 0,0:04:01.78,0:04:03.53,Default,,0,0,0,,Мен де зардап шектім.
Dialogue: 0,0:04:03.61,0:04:06.66,Default,,0,0,0,,Ал Енджу да ұйықтай береді.
Dialogue: 0,0:04:07.24,0:04:10.83,Default,,0,0,0,,Ашығын айтқанда, бұл біз жеңе алатын қарсылас емес.
Dialogue: 0,0:04:12.87,0:04:15.17,Default,,0,0,0,,Бұл сұраудан бас тартқыңыз келе ме...
Dialogue: 0,0:04:18.21,0:04:19.05,Default,,0,0,0,,Уф
Dialogue: 0,0:04:19.71,0:04:23.55,Default,,0,0,0,,Жоқ, бұл жақсы емес, онда Тенші-сама әулие...
Dialogue: 0,0:04:26.59,0:04:28.39,Default,,0,0,0,,Сәлем Рентаро Сатоми
Dialogue: 0,0:04:29.60,0:04:32.18,Default,,0,0,0,,Үшінші отырыста шешім қабылданды
Dialogue: 0,0:04:33.10,0:04:34.44,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:04:35.06,0:04:37.98,Default,,0,0,0,,Біз сондай-ақ жаңа қауіпсіздік жоспарын жасадық.
Dialogue: 0,0:04:38.06,0:04:39.44,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:04:39.69,0:04:43.07,Default,,0,0,0,,Біз бастамашыдан айырылдық, сондықтан сіздің кезегіңіз емес.
Dialogue: 0,0:04:44.15,0:04:45.24,Default,,0,0,0,,Қарғыс атсын! (Хосваки) Гуаааа
Dialogue: 0,0:04:45.78,0:04:48.16,Default,,0,0,0,,Қазір жалған қауіпсіздік жоспарын жасаңыз!
Dialogue: 0,0:04:48.62,0:04:51.66,Default,,0,0,0,,Сіз әлі де эскорт ретінде жалғастыруды жоспарлайсыз ба?
Dialogue: 0,0:04:51.74,0:04:53.16,Default,,0,0,0,,Сұраныс жалғасуда
Dialogue: 0,0:04:53.75,0:04:55.67,Default,,0,0,0,,Мен әулие Тенші-саманы қорғаймын!
Dialogue: 0,0:04:56.25,0:04:57.25,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:58.63,0:05:02.01,Default,,0,0,0,,Сен-Тенши-саманың қасында болу шынымен жақсы ма?
Dialogue: 0,0:05:02.09,0:05:02.92,Default,,0,0,0,,Уф
Dialogue: 0,0:05:03.30,0:05:05.09,Default,,0,0,0,,Менімен жатпа
Dialogue: 0,0:05:05.17,0:05:08.64,Default,,0,0,0,,Ең дұрысы, жалған ақпарат таратыңыз.
Dialogue: 0,0:05:09.51,0:05:11.39,Default,,0,0,0,,Қалғанының бәрі
Dialogue: 0,0:05:11.72,0:05:13.56,Default,,0,0,0,,Мен онымен айналысамын!
Dialogue: 0,0:05:15.52,0:05:17.77,Default,,0,0,0,,(жәндіктердің қанаттарына ұқсайды)
Dialogue: 0,0:05:17.85,0:05:18.69,Default,,0,0,0,,Бұл дыбыс
Dialogue: 0,0:05:19.31,0:05:20.52,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:05:20.61,0:05:23.15,Default,,0,0,0,,Ойға негізделген интерфейс
Dialogue: 0,0:05:23.23,0:05:24.57,Default,,0,0,0,,Шенфилд
Dialogue: 0,0:05:24.99,0:05:28.45,Default,,0,0,0,,Бұл бит миға имплантацияланған нейрочиппен жұмыс істейді.
Dialogue: 0,0:05:28.53,0:05:29.87,Default,,0,0,0,,Бұл барлау ұшағы.
Dialogue: 0,0:05:30.16,0:05:33.41,Default,,0,0,0,,Нысаналы орын, температура, ылғалдылық -
Dialogue: 0,0:05:33.49,0:05:36.66,Default,,0,0,0,,Жел жылдамдығы сияқты ақпаратты жіберу
Dialogue: 0,0:05:38.58,0:05:40.59,Default,,0,0,0,,Мұғалім, бұл бит-
Dialogue: 0,0:05:40.67,0:05:43.05,Default,,0,0,0,,Бір уақытта қанша нәрсені басқара аласыз?
Dialogue: 0,0:05:43.13,0:05:44.71,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:05:46.72,0:05:48.80,Default,,0,0,0,,Сонымен, ақыры уақыт келді—
Dialogue: 0,0:05:48.89,0:05:50.22,Default,,0,0,0,,Тинаны жеңу
Dialogue: 0,0:05:50.30,0:05:52.43,Default,,0,0,0,,Қойшы.
Dialogue: 0,0:05:52.76,0:05:54.72,Default,,0,0,0,,100-ші дәрежедегілер
Dialogue: 0,0:05:54.81,0:05:59.44,Default,,0,0,0,,Олар жанын шайтанға сатқан құнсыз құбыжықтар.
Dialogue: 0,0:05:59.77,0:06:01.52,Default,,0,0,0,,Сонда да мен...
Dialogue: 0,0:06:04.15,0:06:05.57,Default,,0,0,0,,Рентаро-кун
Dialogue: 0,0:06:05.74,0:06:09.07,Default,,0,0,0,,Варанның неліктен қара екенін білесіз бе?
Dialogue: 0,0:06:09.16,0:06:10.03,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:10.11,0:06:12.99,Default,,0,0,0,,Өйткені менің өшпенділігім кристалданды.
Dialogue: 0,0:06:13.08,0:06:14.74,Default,,0,0,0,,Ғылыми емес
Dialogue: 0,0:06:15.50,0:06:18.62,Default,,0,0,0,,Өйткені, сен әрқашан турасың.
Dialogue: 0,0:06:19.50,0:06:22.96,Default,,0,0,0,,Мен мұны түсінгенде, мен оны түсіндім.
Dialogue: 0,0:06:23.21,0:06:27.13,Default,,0,0,0,,Жаным сенің өсуіңнен құтқарылды.
Dialogue: 0,0:06:27.88,0:06:30.09,Default,,0,0,0,,Сіздің болмысыңыз арқылы-
Dialogue: 0,0:06:30.18,0:06:33.05,Default,,0,0,0,,Әлеммен әлі де байланыста
Dialogue: 0,0:06:34.10,0:06:35.89,Default,,0,0,0,,Мұғалім – хикью.
Dialogue: 0,0:06:36.35,0:06:38.35,Default,,0,0,0,,Сосын... (Рентаро) Әлі де
Dialogue: 0,0:06:38.43,0:06:41.90,Default,,0,0,0,,Жоқ, сондықтан мен кетуім керек.
Dialogue: 0,0:06:42.73,0:06:44.27,Default,,0,0,0,,Мен дәлелдегім келеді
Dialogue: 0,0:06:44.69,0:06:48.90,Default,,0,0,0,,Мұғалім маған бұл қолдарды берді, олар біреуді құтқаруға арналғанын айтты.
Dialogue: 0,0:06:49.82,0:06:52.87,Default,,0,0,0,,Әулие Ангелді қорғаңыз және Тинаны жеңіңіз
Dialogue: 0,0:06:52.95,0:06:55.66,Default,,0,0,0,,Дәрежені көтеріп, бұл дүниенің сырын аш!
Dialogue: 0,0:06:56.29,0:06:58.08,Default,,0,0,0,,Сіз қаша алмайсыз!
Dialogue: 0,0:07:00.58,0:07:02.75,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:07:04.50,0:07:05.92,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:07:06.00,0:07:07.00,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:07:07.09,0:07:09.17,Default,,0,0,0,,Не? Сатоми-чан
Dialogue: 0,0:07:28.61,0:07:29.90,Default,,0,0,0,,Өтірік~
Dialogue: 0,0:07:30.36,0:07:33.53,Default,,0,0,0,,Наннан, Сатоми-чан керемет~
Dialogue: 0,0:07:34.16,0:07:36.03,Default,,0,0,0,,Варан протезінің екі жинағы
Dialogue: 0,0:07:36.12,0:07:37.79,Default,,0,0,0,,А? Кисара
Dialogue: 0,0:07:38.08,0:07:42.04,Default,,0,0,0,,Бұл Сатоми-кунның сол көзіне отырғызылған нәрсенің шынайы табиғаты.
Dialogue: 0,0:07:43.21,0:07:45.92,Default,,0,0,0,,Супербаланий қорытпасының сыртқы қабықшасының ішінде -
Dialogue: 0,0:07:46.09,0:07:49.01,Default,,0,0,0,,Графен транзисторлық сипаттамалары бар орталық процессормен жабдықталған.
Dialogue: 0,0:07:49.09,0:07:51.05,Default,,0,0,0,,Жоғары өнімді компьютерлердің арқасында...
Dialogue: 0,0:07:51.63,0:07:54.43,Default,,0,0,0,,Тіпті біздің ойларымыз да асып кеткен...
Dialogue: 0,0:07:54.64,0:07:56.60,Default,,0,0,0,,Сатоми-кун көріп тұрған дүние...
Dialogue: 0,0:07:56.68,0:07:59.02,Default,,0,0,0,,Уақыт өте баяу өтеді.
Dialogue: 0,0:08:02.60,0:08:03.90,Default,,0,0,0,,Уф! Ха...
Dialogue: 0,0:08:05.02,0:08:05.98,Default,,0,0,0,,Снайпер!?
Dialogue: 0,0:08:07.52,0:08:10.99,Default,,0,0,0,,Менің өмірім азапқа толы
Dialogue: 0,0:08:11.78,0:08:15.62,Default,,0,0,0,,Міне, қазір мен біраз уақыттан кейін бірінші рет өзімді бақытты сезінемін.
Dialogue: 0,0:08:24.54,0:08:27.96,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:29.50,0:08:31.21,Default,,0,0,0,,Сатоми-чан керемет!
Dialogue: 0,0:08:32.38,0:08:35.22,Default,,0,0,0,,Жауынгерлік қабілеті 2200%!
Dialogue: 0,0:08:35.89,0:08:36.34,Default,,0,0,0,,Мені ұста~ Сатоми-чан~
Dialogue: 0,0:08:36.34,0:08:37.72,Default,,0,0,0,,Мені ұста~ Сатоми-чан~
Dialogue: 0,0:08:36.34,0:08:37.72,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:37.80,0:08:39.64,Default,,0,0,0,,Сәлем! Сен не туралы айтып тұрсың?
Dialogue: 0,0:08:39.72,0:08:42.02,Default,,0,0,0,,О, Кисара, сен әлі осындасың ба?
Dialogue: 0,0:08:42.56,0:08:43.56,Default,,0,0,0,,Тоқылмаған
Dialogue: 0,0:08:43.64,0:08:45.35,Default,,0,0,0,,Тинаның болжамды саны қандай?
Dialogue: 0,0:08:45.44,0:08:47.65,Default,,0,0,0,,Не? Аа, дұрыс
Dialogue: 0,0:08:48.56,0:08:52.99,Default,,0,0,0,,Мен Енджу-чанды 8600% жеңдім...
Dialogue: 0,0:08:53.19,0:08:54.82,Default,,0,0,0,,Тіпті төмен бағалау
Dialogue: 0,0:08:54.90,0:08:57.78,Default,,0,0,0,,Бұл соманың 1,5 есесін қараған дұрыс болар еді.
Dialogue: 0,0:08:58.70,0:09:02.08,Default,,0,0,0,,12,900% артық
Dialogue: 0,0:09:03.79,0:09:07.63,Default,,0,0,0,,Үшінші қауіпсіздік жоспарын оқыдыңыз ба?
Dialogue: 0,0:09:07.71,0:09:08.54,Default,,0,0,0,,Иә
Dialogue: 0,0:09:09.25,0:09:12.05,Default,,0,0,0,,Бірақ бұл біртүрлі емес пе?
Dialogue: 0,0:09:12.17,0:09:13.67,Default,,0,0,0,,Маршруттағы бір орын
Dialogue: 0,0:09:13.76,0:09:17.55,Default,,0,0,0,,Мұнда сіз үшін арнайы жасалған сияқты тамаша мергендік нүктесі бар.
Dialogue: 0,0:09:17.64,0:09:19.47,Default,,0,0,0,,Тина Спроут
Dialogue: 0,0:09:19.64,0:09:22.56,Default,,0,0,0,,Өлтіруге бұйрық берген полиция қызметкері мен бастамашы...
Dialogue: 0,0:09:22.64,0:09:25.35,Default,,0,0,0,,Оның тірі екендігі туралы ақпарат алдым.
Dialogue: 0,0:09:25.43,0:09:28.90,Default,,0,0,0,,Ха... Мен соңғы соққыны өзім бердім деп ойладым.
Dialogue: 0,0:09:28.98,0:09:31.44,Default,,0,0,0,,Сіздің қожайыныңыз кім?
Dialogue: 0,0:09:31.52,0:09:34.07,Default,,0,0,0,,Бұл сізсіз, профессор Рэнд.
Dialogue: 0,0:09:34.40,0:09:36.53,Default,,0,0,0,,Сонда мен түсінемін.
Dialogue: 0,0:09:36.61,0:09:39.82,Default,,0,0,0,,Егер сіз жоғалтатын жағдайға тап болсаңыз...
Dialogue: 0,0:09:39.95,0:09:41.08,Default,,0,0,0,,Өзіңізді өлтіріңіз
Dialogue: 0,0:09:41.87,0:09:45.33,Default,,0,0,0,,Түсінген ұстаз
Dialogue: 0,0:09:52.42,0:09:54.38,Default,,0,0,0,,Келмеңіз.
Dialogue: 0,0:09:54.46,0:09:56.05,Default,,0,0,0,,Рентаро-сан...
Dialogue: 0,0:10:02.47,0:10:06.10,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:10:06.18,0:10:08.10,Default,,0,0,0,,Бұл ска орны болды ма?
Dialogue: 0,0:10:08.64,0:10:12.52,Default,,0,0,0,,Бірақ біз келіссөздердің қайда өтіп жатқанын білеміз.
Dialogue: 0,0:10:12.61,0:10:16.19,Default,,0,0,0,,Сейтенші шыққан жерді көздеуге болады.
Dialogue: 0,0:10:16.28,0:10:18.36,Default,,0,0,0,,Мен саған Тенши-саманы әулиені өлтіруге рұқсат бермеймін.
Dialogue: 0,0:10:19.03,0:10:20.91,Default,,0,0,0,,Сол ханшайымның иығында
Dialogue: 0,0:10:20.99,0:10:23.33,Default,,0,0,0,,Бұл елдің болашағына қауіп төніп тұр.
Dialogue: 0,0:10:23.78,0:10:26.16,Default,,0,0,0,,Егер мені шынымен өлтіргіңіз келсе...
Dialogue: 0,0:10:28.25,0:10:29.96,Default,,0,0,0,,Бармас бұрын мені өлтір!
Dialogue: 0,0:10:30.58,0:10:32.46,Default,,0,0,0,,Сен мені жеңе алмайсың
Dialogue: 0,0:10:32.96,0:10:34.96,Default,,0,0,0,,Көріп көрмейінше түсінбейсіз.
Dialogue: 0,0:10:35.50,0:10:39.13,Default,,0,0,0,,Жүр, мынаны шешейік, Тина!
Dialogue: 0,0:10:48.93,0:10:50.10,Default,,0,0,0,,Құмыраның дөңгелегі кабушики!
Dialogue: 0,0:10:57.19,0:10:58.32,Default,,0,0,0,,Осы қашықтықта...
Dialogue: 0,0:10:58.40,0:11:00.74,Default,,0,0,0,,Сіз мұрын жарқылын көргеннен кейін әрекет еттіңіз деп ойлаймын...
Dialogue: 0,0:11:02.41,0:11:03.37,Default,,0,0,0,,Уф
Dialogue: 0,0:11:09.33,0:11:11.42,Default,,0,0,0,,Уф... ха ха...
Dialogue: 0,0:11:15.54,0:11:18.34,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:11:18.42,0:11:19.51,Default,,0,0,0,,(биттік ұшатын дыбыс)
Dialogue: 0,0:11:19.51,0:11:20.34,Default,,0,0,0,,(биттік ұшатын дыбыс)
Dialogue: 0,0:11:19.51,0:11:20.34,Default,,0,0,0,,Ах
Dialogue: 0,0:11:20.34,0:11:23.43,Default,,0,0,0,,(биттік ұшатын дыбыс)
Dialogue: 0,0:11:26.68,0:11:29.10,Default,,0,0,0,,(ұшатын биттердің дыбысы)
Dialogue: 0,0:11:42.24,0:11:43.24,Default,,0,0,0,,Біріншіден, бір нәрсе.
Dialogue: 0,0:11:43.32,0:11:44.28,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:11:44.28,0:11:45.37,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:11:44.28,0:11:45.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:45.37,0:11:46.66,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:11:46.78,0:11:48.29,Default,,0,0,0,,Сатоми аман қалады ма?
Dialogue: 0,0:11:48.37,0:11:50.00,Default,,0,0,0,,Талдау нәтижелері шықты.
Dialogue: 0,0:11:50.29,0:11:52.58,Default,,0,0,0,,Талдау? Бұл пулемет пе?
Dialogue: 0,0:11:52.67,0:11:53.75,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:53.83,0:11:56.75,Default,,0,0,0,,Қалпына келтірілген пулеметке не жалғанған?
Dialogue: 0,0:11:56.84,0:11:59.00,Default,,0,0,0,,Мен қашықтан басқару модулін жасадым.
Dialogue: 0,0:11:59.51,0:12:01.63,Default,,0,0,0,,Түсіндім... Ах.
Dialogue: 0,0:11:59.51,0:12:01.63,Default,,0,0,0,,(биттік ұшатын дыбыс)
Dialogue: 0,0:12:01.63,0:12:03.13,Default,,0,0,0,,(биттік ұшатын дыбыс)
Dialogue: 0,0:12:03.13,0:12:04.72,Default,,0,0,0,,(биттік ұшатын дыбыс)
Dialogue: 0,0:12:03.13,0:12:04.72,Default,,0,0,0,,Нашар Миори! Толықтырылған!
Dialogue: 0,0:12:04.89,0:12:06.47,Default,,0,0,0,,Сатоми-чан, қаш!
Dialogue: 0,0:12:07.60,0:12:08.56,Default,,0,0,0,,Уф
Dialogue: 0,0:12:08.85,0:12:09.77,Default,,0,0,0,,Уф
Dialogue: 0,0:12:14.35,0:12:17.52,Default,,0,0,0,,Сатоми-чан, мен жіберген суретке қарашы.
Dialogue: 0,0:12:19.02,0:12:20.78,Default,,0,0,0,,Спутник арқылы расталған
Dialogue: 0,0:12:20.86,0:12:22.78,Default,,0,0,0,,Сатоми-чанды 5 жерде қоршау-
Dialogue: 0,0:12:22.86,0:12:25.36,Default,,0,0,0,,Материалға қарсы винтовка орнатылады.
Dialogue: 0,0:12:25.61,0:12:27.95,Default,,0,0,0,,Тина оны қашықтан өзі басқара ма?
Dialogue: 0,0:12:28.20,0:12:29.37,Default,,0,0,0,,Соя
Dialogue: 0,0:12:29.45,0:12:31.16,Default,,0,0,0,,Енджу осыдан жеңілді.
Dialogue: 0,0:12:31.95,0:12:34.00,Default,,0,0,0,,Ол бұл ғимаратта емес.
Dialogue: 0,0:12:34.08,0:12:37.67,Default,,0,0,0,,Жылу датчигі көрші ғимараттың жоғарғы қабатын анықтады!
Dialogue: 0,0:13:14.21,0:13:15.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:16.33,0:13:17.33,Default,,0,0,0,,Уау
Dialogue: 0,0:13:18.08,0:13:19.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:26.59,0:13:29.14,Default,,0,0,0,,Бұл үшінші
Dialogue: 0,0:13:32.43,0:13:37.44,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:40.23,0:13:41.15,Default,,0,0,0,,Ах
Dialogue: 0,0:13:48.74,0:13:49.66,Default,,0,0,0,,Тостаушы!
Dialogue: 0,0:13:58.92,0:14:00.67,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:14:10.47,0:14:11.80,Default,,0,0,0,,Астында жасырылған ба?
Dialogue: 0,0:14:11.89,0:14:15.22,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:14:15.39,0:14:16.35,Default,,0,0,0,,Не болды? тоқыма емес
Dialogue: 0,0:14:16.43,0:14:17.94,Default,,0,0,0,,Сау бол, Сатоми-чан
Dialogue: 0,0:14:18.02,0:14:18.85,Default,,0,0,0,,Мен жақынмын!
Dialogue: 0,0:14:20.52,0:14:21.86,Default,,0,0,0,,Қай қабатта!
Dialogue: 0,0:14:38.16,0:14:39.46,Default,,0,0,0,,Торахиро Тенсей!
Dialogue: 0,0:14:48.34,0:14:49.17,Default,,0,0,0,,Төртінші бірлік!?
Dialogue: 0,0:14:56.39,0:14:57.93,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:15:07.82,0:15:10.53,Default,,0,0,0,,Неге, Тина?
Dialogue: 0,0:15:11.07,0:15:13.20,Default,,0,0,0,,Неліктен біз адамдарды өлтіреміз?
Dialogue: 0,0:15:13.82,0:15:16.04,Default,,0,0,0,,Мұны істеуден басқа-
Dialogue: 0,0:15:16.29,0:15:18.91,Default,,0,0,0,,Өзінің бар болу себебін дәлелдей алмау
Dialogue: 0,0:15:20.16,0:15:22.96,Default,,0,0,0,,Бұл өкінішті, Тина.
Dialogue: 0,0:15:23.33,0:15:25.42,Default,,0,0,0,,Сіз қайғылысыз
Dialogue: 0,0:15:29.55,0:15:30.67,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:15:31.80,0:15:33.01,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:33.64,0:15:34.93,Default,,0,0,0,,Тым күшті
Dialogue: 0,0:15:37.06,0:15:39.43,Default,,0,0,0,,Қате... иә...
Dialogue: 0,0:15:40.23,0:15:44.69,Default,,0,0,0,,Өкінішке орай, артта қалдым...
Dialogue: 0,0:15:45.61,0:15:46.57,Default,,0,0,0,,Рентаро!
Dialogue: 0,0:15:50.15,0:15:51.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:51.20,0:15:53.61,Default,,0,0,0,,Уф... аа! Ах...
Dialogue: 0,0:15:55.91,0:15:57.91,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:15:58.24,0:15:59.37,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:16:00.33,0:16:03.58,Default,,0,0,0,,Мен үкі факторын көремін.
Dialogue: 0,0:16:04.08,0:16:05.46,Default,,0,0,0,,(Масато) Қандай күш! Жоқ, күте тұр—
Dialogue: 0,0:16:05.58,0:16:08.80,Default,,0,0,0,,Бұл сіз жасаған ғажайып па?
Dialogue: 0,0:16:09.42,0:16:10.38,Default,,0,0,0,,Энжу
Dialogue: 0,0:16:10.92,0:16:11.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:13.47,0:16:17.51,Default,,0,0,0,,Мен... Әлі де жеңіле алмаймын.
Dialogue: 0,0:16:17.89,0:16:19.26,Default,,0,0,0,,Енджу…
Dialogue: 0,0:16:19.56,0:16:21.10,Default,,0,0,0,,Кисара мырзаның...
Dialogue: 0,0:16:21.18,0:16:22.56,Default,,0,0,0,,Мұғалімнің...
Dialogue: 0,0:16:22.64,0:16:24.06,Default,,0,0,0,,Тоқылмаған…
Dialogue: 0,0:16:24.19,0:16:25.85,Default,,0,0,0,,Әулие Тенши…
Dialogue: 0,0:16:26.61,0:16:29.32,Default,,0,0,0,,Мен осындамын, үміт артып жатырмын!
Dialogue: 0,0:16:31.40,0:16:33.07,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:16:37.99,0:16:39.45,Default,,0,0,0,,Унрейби көлі тұқы тұқы!
Dialogue: 0,0:16:43.29,0:16:45.17,Default,,0,0,0,,Жоғарғы және төменгі гүлдер жоғалған
Dialogue: 0,0:16:45.25,0:16:47.38,Default,,0,0,0,,Барстоу!
Dialogue: 0,0:16:57.89,0:17:00.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:00.81,0:17:02.31,Default,,0,0,0,,Рентаро-сан
Dialogue: 0,0:17:02.77,0:17:05.35,Default,,0,0,0,,Оны аяқтаңыз.
Dialogue: 0,0:17:06.73,0:17:11.94,Default,,0,0,0,,Өйткені менің денем – технология массасы.
Dialogue: 0,0:17:12.61,0:17:15.49,Default,,0,0,0,,Басқа елде тұру...
Dialogue: 0,0:17:16.91,0:17:18.95,Default,,0,0,0,,Мен тұтқынға түсе алмаймын...
Dialogue: 0,0:17:25.66,0:17:28.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:29.25,0:17:31.63,Default,,0,0,0,,Сен Енджуға көмектестің
Dialogue: 0,0:17:32.34,0:17:34.09,Default,,0,0,0,,Мен мұны әрқашан айтқым келді
Dialogue: 0,0:17:34.63,0:17:36.47,Default,,0,0,0,,Тина рахмет
Dialogue: 0,0:17:38.93,0:17:40.55,Default,,0,0,0,,Рентаро-сан...
Dialogue: 0,0:17:43.89,0:17:45.27,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:17:45.35,0:17:46.56,Default,,0,0,0,,Сіздің емдеуіңіз-
Dialogue: 0,0:17:46.64,0:17:48.73,Default,,0,0,0,,Жағдайы нашарламау үшін мен сізбен бірге жұмыс істеймін.
Dialogue: 0,0:17:49.40,0:17:53.48,Default,,0,0,0,,Маған тек күресу ғана қалды...
Dialogue: 0,0:17:53.98,0:17:57.07,Default,,0,0,0,,Мен жеңілдім, бәрі де кетті.
Dialogue: 0,0:17:57.61,0:18:00.07,Default,,0,0,0,,Бұлай болмауы керек еді
Dialogue: 0,0:18:00.87,0:18:03.49,Default,,0,0,0,,Мен сізден жауапкершілікті алуыңызды сұраймын.
Dialogue: 0,0:18:03.83,0:18:04.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:05.54,0:18:06.46,Default,,0,0,0,,О
Dialogue: 0,0:18:08.54,0:18:09.58,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:13.88,0:18:15.80,Default,,0,0,0,,Тина!? Сәлем Тина!
Dialogue: 0,0:18:16.72,0:18:18.80,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:18:19.47,0:18:21.35,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:18:21.43,0:18:24.52,Default,,0,0,0,,Сейтенші-сама болса, аман-есен жеткізер едім.
Dialogue: 0,0:18:24.60,0:18:26.81,Default,,0,0,0,,Олар қазір келіссөздер жүргізіп жатқан шығар.
Dialogue: 0,0:18:27.14,0:18:28.64,Default,,0,0,0,,Одан да көп
Dialogue: 0,0:18:28.73,0:18:31.52,Default,,0,0,0,,Мен қоқысты сен үшін шығардым.
Dialogue: 0,0:18:31.61,0:18:33.32,Default,,0,0,0,,Алғыс айту туралы не айтасыз?
Dialogue: 0,0:18:33.61,0:18:35.65,Default,,0,0,0,,Мен сені өлтіремін! Уф...
Dialogue: 0,0:18:33.61,0:18:35.65,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:36.24,0:18:38.20,Default,,0,0,0,,Гах... жібер!
Dialogue: 0,0:18:38.28,0:18:39.66,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:18:39.74,0:18:42.57,Default,,0,0,0,,Иә? Егер бұл варан оқтары болмаса...
Dialogue: 0,0:18:42.66,0:18:44.58,Default,,0,0,0,,Өлу оңай емес
Dialogue: 0,0:18:45.04,0:18:46.20,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:18:46.29,0:18:49.58,Default,,0,0,0,,Бұл жігітті қанша қорғасын оқ өлтіреді деп ойлайсың?
Dialogue: 0,0:18:49.75,0:18:51.71,Default,,0,0,0,,Тоқта! Ховаки!
Dialogue: 0,0:18:51.79,0:18:53.92,Default,,0,0,0,,Боқ, мен сені өлтіремін!
Dialogue: 0,0:18:54.25,0:18:58.26,Default,,0,0,0,,Дұрыс, мен сол жүзді көргім келді, Рентаро Сатоми.
Dialogue: 0,0:18:58.34,0:18:59.68,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:59.84,0:19:01.18,Default,,0,0,0,,Бұл финал (Rentaro) Қарғыс атсын.
Dialogue: 0,0:19:01.26,0:19:03.64,Default,,0,0,0,,Фуфуфуфу... (Рентаро) Сәлем! Уф...
Dialogue: 0,0:19:04.72,0:19:06.47,Default,,0,0,0,,Міне! (үшін) Ах.
Dialogue: 0,0:19:08.98,0:19:11.65,Default,,0,0,0,,Қасиетті періште!? Неге мұндасың?
Dialogue: 0,0:19:12.15,0:19:16.07,Default,,0,0,0,,Сіздің пікіріңізді тыңдап, жиналыстан бас тарттым.
Dialogue: 0,0:19:16.15,0:19:18.99,Default,,0,0,0,,Ақымақ! Тек азаматтық полиция үшін!
Dialogue: 0,0:19:19.40,0:19:20.57,Default,,0,0,0,,Ішек
Dialogue: 0,0:19:20.65,0:19:23.20,Default,,0,0,0,,Сатоми-сан, маған айтыңызшы.
Dialogue: 0,0:19:24.03,0:19:26.66,Default,,0,0,0,,Сен менің өмірімді сақтап қалдың
Dialogue: 0,0:19:26.74,0:19:28.83,Default,,0,0,0,,Менен не қалайсың?
Dialogue: 0,0:19:32.42,0:19:33.96,Default,,0,0,0,,Мен күш алғым келеді
Dialogue: 0,0:19:34.67,0:19:37.21,Default,,0,0,0,,Мен қорғағым келетін нәрсені қорғау күші!
Dialogue: 0,0:19:39.51,0:19:40.72,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:19:42.09,0:19:44.60,Default,,0,0,0,,Токио аймағының мемлекет басшысының артықшылығы бойынша
Dialogue: 0,0:19:44.68,0:19:47.14,Default,,0,0,0,,Рентаро Сатомиді 300 санына көтеріңіз
Dialogue: 0,0:19:47.47,0:19:48.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:48.39,0:19:51.31,Default,,0,0,0,,Құпия ақпаратқа қол жеткізу кілті 5-деңгейде!
Dialogue: 0,0:19:51.39,0:19:54.48,Default,,0,0,0,,Басқаша айтқанда, ол 3-ші лейтенант Ховакидің бастығы.
Dialogue: 0,0:19:54.56,0:19:56.73,Default,,0,0,0,,Ех (Ховаки)...
Dialogue: 0,0:19:56.82,0:19:59.15,Default,,0,0,0,,Уф... Сәлем!
Dialogue: 0,0:20:01.20,0:20:03.36,Default,,0,0,0,,Келме!
Dialogue: 0,0:20:03.86,0:20:05.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:05.20,0:20:07.74,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:07.83,0:20:10.62,Default,,0,0,0,,Менің саусақтарым... саусақтарым!
Dialogue: 0,0:20:11.25,0:20:12.46,Default,,0,0,0,,«Бұрын ол жетімдер үйін басқарған».
Dialogue: 0,0:20:12.83,0:20:15.00,Default,,0,0,0,,Ал енді Тинаға жақындама!
Dialogue: 0,0:20:15.33,0:20:18.71,Default,,0,0,0,,Егер бас тартсаң, мен сені сатқындық үшін атып тастаймын!
Dialogue: 0,0:20:24.72,0:20:27.01,Default,,0,0,0,,Содан бері бір апта өтті.
Dialogue: 0,0:20:28.97,0:20:31.64,Default,,0,0,0,,Сайтаке отырыс ортасында жалғыз қалды...
Dialogue: 0,0:20:31.73,0:20:34.02,Default,,0,0,0,,Мен ашулы иығыммен Осакаға қайттым.
Dialogue: 0,0:20:34.65,0:20:39.15,Default,,0,0,0,,Сайтаке мен Рэндті байланыстыратын ешқандай дәлел табылмады.
Dialogue: 0,0:20:40.53,0:20:43.07,Default,,0,0,0,,Тина Сейтен-коның қамқорлығына алынады.
Dialogue: 0,0:20:43.15,0:20:44.78,Default,,0,0,0,,Қазіргі уақытта киелі резиденцияда үйқамақта...
Dialogue: 0,0:20:45.36,0:20:47.78,Default,,0,0,0,,Сұрау жалғасып жатқан сияқты.
Dialogue: 0,0:20:47.87,0:20:49.53,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:20:52.08,0:20:53.21,Default,,0,0,0,,Үміттенемін-
Dialogue: 0,0:20:53.37,0:20:57.17,Default,,0,0,0,,Оған берілген жаза жеңіл деп үміттенемін.
Dialogue: 0,0:20:58.42,0:21:00.84,Default,,0,0,0,,О, Сатоми-кун, кешігіп қалдың.
Dialogue: 0,0:21:00.92,0:21:01.88,Default,,0,0,0,,Рентаро!
Dialogue: 0,0:21:02.09,0:21:03.97,Default,,0,0,0,,Күтуден шаршадым! Эххе...
Dialogue: 0,0:21:04.05,0:21:05.43,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:21:05.51,0:21:07.89,Default,,0,0,0,,Ол сабақтан кейін бірден келді.
Dialogue: 0,0:21:08.68,0:21:10.97,Default,,0,0,0,,Сонымен не? Менімен сөйлес
Dialogue: 0,0:21:11.06,0:21:13.39,Default,,0,0,0,,Рентаро-сан, су ішіп алшы.
Dialogue: 0,0:21:13.77,0:21:16.31,Default,,0,0,0,,Ой, бұл өте жаман, Тина.
Dialogue: 0,0:21:18.73,0:21:19.56,Default,,0,0,0,,Тина!?
Dialogue: 0,0:21:20.15,0:21:21.44,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:21:21.53,0:21:24.32,Default,,0,0,0,,Уууу, мен сені жұмысқа алдым~
Dialogue: 0,0:21:24.70,0:21:25.95,Default,,0,0,0,,Жалданған!?
Dialogue: 0,0:21:26.03,0:21:29.66,Default,,0,0,0,,Өйткені босатылған күннің өзінде баратын үйің болмайды.
Dialogue: 0,0:21:30.12,0:21:31.66,Default,,0,0,0,,Мен сені аяймын, солай емес пе?
Dialogue: 0,0:21:31.74,0:21:34.41,Default,,0,0,0,,Ақыры, менің кәнизамның кішісі бар.
Dialogue: 0,0:21:34.83,0:21:36.25,Default,,0,0,0,,Я...
Dialogue: 0,0:21:36.33,0:21:38.71,Default,,0,0,0,,Екеуі де өліп қала жаздаса да.
Dialogue: 0,0:21:38.79,0:21:40.67,Default,,0,0,0,,Неге күле алмайсың?
Dialogue: 0,0:21:41.09,0:21:43.01,Default,,0,0,0,,Рентаро-сан
Dialogue: 0,0:21:43.09,0:21:43.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:44.51,0:21:46.93,Default,,0,0,0,,Бүгіннен бастап Tendo Private Security компаниясында
Dialogue: 0,0:21:47.01,0:21:49.30,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:21:49.39,0:21:51.18,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:21:52.81,0:21:54.14,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:54.22,0:21:56.94,Default,,0,0,0,,Мен не болатынын білмеймін.
Dialogue: 0,0:21:57.31,0:21:59.06,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:01.23,0:22:06.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:24.82,0:23:29.24,Default,,0,0,0,,～♪
Dialogue: 0,0:23:31.70,0:23:33.03,Default,,0,0,0,,Монолиттің құлауы?
Dialogue: 0,0:23:33.12,0:23:34.24,Default,,0,0,0,,Монолиттің сыртында...
Dialogue: 0,0:23:34.32,0:23:36.83,Default,,0,0,0,,Қазірдің өзінде 2000 гастреа жиналып жатыр.
Dialogue: 0,0:23:36.83,0:23:38.33,Default,,0,0,0,,Қазірдің өзінде 2000 гастреа жиналып жатыр.
Dialogue: 0,0:23:36.83,0:23:38.33,Default,,0,0,0,,Әй, бұзық Сатоми Рентаро!
Dialogue: 0,0:23:38.33,0:23:38.41,Default,,0,0,0,,Әй, бұзық Сатоми Рентаро!
Dialogue: 0,0:23:38.41,0:23:39.54,Default,,0,0,0,,Әй, бұзық Рентаро Сатоми!
Dialogue: 0,0:23:38.41,0:23:39.54,Default,,0,0,0,,Келіңіздер! Би билейік, балам!
Dialogue: 0,0:23:39.54,0:23:40.96,Default,,0,0,0,,Келіңіздер! Би билейік, балам!
Dialogue: 0,0:23:42.46,0:23:48.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
