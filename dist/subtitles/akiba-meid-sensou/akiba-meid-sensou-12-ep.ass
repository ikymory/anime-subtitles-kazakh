Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:46.43,0:00:47.59,Default,,0,0,0,,Эй, мұнда кел.
Dialogue: 0,0:00:48.16,0:00:48.67,Default,,0,0,0,,О
Dialogue: 0,0:00:49.26,0:00:52.16,Default,,0,0,0,,Наги-сама, Маннен Арашиконы өлтірген қызметші.
Dialogue: 0,0:00:52.45,0:00:54.39,Default,,0,0,0,,Оны інім ұстап алды.
Dialogue: 0,0:00:54.85,0:00:56.52,Default,,0,0,0,,Бұл қай дүкеннен?
Dialogue: 0,0:00:56.52,0:01:00.54,Default,,0,0,0,,Бұл Маннен Арашико түрмеден шыққаннан кейін бірден жойып жіберген Чуки Чуки Цуки-чанның күңі.
Dialogue: 0,0:01:01.05,0:01:03.22,Default,,0,0,0,,Сіз не істегеніңізді білесіз бе?
Dialogue: 0,0:01:03.22,0:01:05.09,Default,,0,0,0,,Мен хайуан емеспін
Dialogue: 0,0:01:05.30,0:01:06.68,Default,,0,0,0,,Тіпті аксолотль де емес
Dialogue: 0,0:01:06.87,0:01:08.80,Default,,0,0,0,,Мен ғарыштық қара қоянмын
Dialogue: 0,0:01:08.99,0:01:11.82,Default,,0,0,0,,Чукичукицуки-чан – менің жалғыз жерім
Dialogue: 0,0:01:12.10,0:01:13.29,Default,,0,0,0,,Қарсы алу?
Dialogue: 0,0:01:13.57,0:01:15.74,Default,,0,0,0,,Өкіл: Сен оны Қанда өзеніне батырғың келе ме?
Dialogue: 0,0:01:17.96,0:01:18.46,Default,,0,0,0,,Өкіл?
Dialogue: 0,0:01:19.00,0:01:21.18,Default,,0,0,0,,Қызметші-дәмхананы сонша қызықты ететін не?
Dialogue: 0,0:01:22.23,0:01:23.31,Default,,0,0,0,,Мені босат
Dialogue: 0,0:01:23.75,0:01:24.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:01:24.52,0:01:25.69,Default,,0,0,0,,Мені екі рет айтуға мәжбүрлеме
Dialogue: 0,0:01:26.35,0:01:26.85,Default,,0,0,0,,Иә
Dialogue: 0,0:01:28.53,0:01:31.53,Default,,0,0,0,,Қалай үрсең де, енді хайуансың.
Dialogue: 0,0:01:32.03,0:01:33.38,Default,,0,0,0,,Ерінбей еңбек ет
Dialogue: 0,0:01:33.87,0:01:35.95,Default,,0,0,0,,Жарайды, мен кеттім.
Dialogue: 0,0:01:38.72,0:01:41.53,Default,,0,0,0,,Егер бұл орын алса, оны мұқият орындайық.
Dialogue: 0,0:01:42.76,0:01:44.37,Default,,0,0,0,,Мұның бәрі соғыс
Dialogue: 0,0:01:56.13,0:01:57.02,Default,,0,0,0,,Қызметші
Dialogue: 0,0:01:57.26,0:01:59.99,Default,,0,0,0,,Олар бір салтанатты залды пайдаланбайды деп үміттенемін.
Dialogue: 0,0:01:59.99,0:02:01.98,Default,,0,0,0,,Ол тағы бір жекпе-жекте қайтыс болған шығар.
Dialogue: 0,0:02:02.35,0:02:05.07,Default,,0,0,0,,Шамасы, ол түрмеден бір жылға жетпей шыққан қызметші.
Dialogue: 0,0:02:05.07,0:02:06.42,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:02:06.65,0:02:10.24,Default,,0,0,0,,Тезірек Акибадан қызметші кафелер жойылса екен.
Dialogue: 0,0:02:10.24,0:02:12.09,Default,,0,0,0,,Полиция не істеп жатыр?
Dialogue: 0,0:02:12.09,0:02:13.57,Default,,0,0,0,,Дауысыңыз қатты.
Dialogue: 0,0:02:13.74,0:02:15.81,Default,,0,0,0,,Мен олардың не істерін білмеймін.
Dialogue: 0,0:02:17.01,0:02:19.30,Default,,0,0,0,,Баннен Арашико өлген сияқты.
Dialogue: 0,0:02:19.30,0:02:21.78,Default,,0,0,0,,Себебі шошқаның сыртқы түрі оны әдемі етеді.
Dialogue: 0,0:02:22.43,0:02:26.36,Default,,0,0,0,,36 жастағы қызметші өлген дәуірдің соңы сияқты.
Dialogue: 0,0:02:27.36,0:02:28.21,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:02:28.72,0:02:32.44,Default,,0,0,0,,Жақында басқа шошқалар да ілеседі, сондықтан сіз жалғыз қалмайсыз.
Dialogue: 0,0:02:32.56,0:02:36.40,Default,,0,0,0,,Акибаға шошқа етінен гөрі сиыр еті керек.
Dialogue: 0,0:02:36.81,0:02:37.64,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:02:37.86,0:02:38.41,Default,,0,0,0,,Сиыр
Dialogue: 0,0:02:46.14,0:02:48.42,Default,,0,0,0,,Арашиконы өлтірген күң қайда?
Dialogue: 0,0:02:48.64,0:02:50.31,Default,,0,0,0,,Сіз өте мұқиятсыз...
Dialogue: 0,0:02:52.33,0:02:53.73,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:02:53.93,0:02:55.28,Default,,0,0,0,,Білмейсің бе, шошқа.
Dialogue: 0,0:02:56.66,0:02:59.78,Default,,0,0,0,,Енді сиыр сияқты атау белгісін қоюға болады.
Dialogue: 0,0:03:00.63,0:03:02.77,Default,,0,0,0,,Енді мұрын сақинасын ашу керек пе?
Dialogue: 0,0:03:03.01,0:03:05.05,Default,,0,0,0,,Сондай-ақ... қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:03:05.05,0:03:07.02,Default,,0,0,0,,Сөйлесу Себебі сіз сөйлейсіз
Dialogue: 0,0:03:07.02,0:03:09.05,Default,,0,0,0,,Арашиконы кім өлтірді?
Dialogue: 0,0:03:09.05,0:03:11.90,Default,,0,0,0,,Сондай-ақ... Ол бұрынғы Чуки Чуки Цуки-чан қызметшісі.
Dialogue: 0,0:03:12.09,0:03:13.39,Default,,0,0,0,,Өкілдің нұсқауы?
Dialogue: 0,0:03:13.57,0:03:15.18,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:03:15.18,0:03:19.00,Default,,0,0,0,,Өкіл барлығын талқандау үшін сарбаздар мен қару-жарақ жинап жатыр.
Dialogue: 0,0:03:19.00,0:03:20.82,Default,,0,0,0,,Өкілдер қазір қайда?
Dialogue: 0,0:03:20.82,0:03:23.99,Default,,0,0,0,,Жарайды... мұндайды төменгі қызметші білуі мүмкін емес.
Dialogue: 0,0:03:25.27,0:03:26.76,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:03:28.16,0:03:29.95,Default,,0,0,0,,Аңдарға айт
Dialogue: 0,0:03:30.67,0:03:34.38,Default,,0,0,0,,Бейбіт Нагоми аза тұтқан қара шошқаға айналды.
Dialogue: 0,0:03:44.18,0:03:48.58,Default,,0,0,0,,Маған осында жұмыс істеген Узуко деген қызметші қыз туралы айтып беріңізші.
Dialogue: 0,0:03:49.26,0:03:50.54,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:03:51.57,0:03:52.63,Default,,0,0,0,,Мен асығыспын.
Dialogue: 0,0:03:52.97,0:03:54.92,Default,,0,0,0,,Өкілдің мекен-жайын айтыңызшы.
Dialogue: 0,0:03:55.60,0:03:57.24,Default,,0,0,0,,Сіз білуге ​​мүмкіндік жоқ.
Dialogue: 0,0:03:57.24,0:03:58.82,Default,,0,0,0,,Сонда сіздің үй мекенжайыңыз жақсы.
Dialogue: 0,0:03:58.82,0:04:00.78,Default,,0,0,0,,Сіз білмеймін деп жатырсыз.
Dialogue: 0,0:04:02.99,0:04:04.32,Default,,0,0,0,,Бұл Арасиконың мылтығы ме?
Dialogue: 0,0:04:09.29,0:04:12.05,Default,,0,0,0,,Өткенді қысқаша айтып берейін.
Dialogue: 0,0:04:13.38,0:04:15.06,Default,,0,0,0,,Жиырма жыл бұрын
Dialogue: 0,0:04:15.57,0:04:19.96,Default,,0,0,0,,Мичио есімді қызметші туыстары жоқ Узуконы алып кетті.
Dialogue: 0,0:04:20.81,0:04:24.79,Default,,0,0,0,,Кішкентай болса да, көзі бірдеңеге ашты.
Dialogue: 0,0:04:26.29,0:04:30.04,Default,,0,0,0,,Ол кезде Мичио да жекпе-жек қызметшісі болатын.
Dialogue: 0,0:04:30.04,0:04:32.51,Default,,0,0,0,,Ол Акихабарада атын шығарды.
Dialogue: 0,0:04:33.21,0:04:36.73,Default,,0,0,0,,Ол Узуконы өзінің мұрагері етіп көтеруге тырысты.
Dialogue: 0,0:04:37.89,0:04:41.59,Default,,0,0,0,,Арашико дүкенге қосылғаннан кейін Мичио өзгерді.
Dialogue: 0,0:04:42.47,0:04:45.76,Default,,0,0,0,,Менің ойымша, оның тазалығы Мичионы өзгертті.
Dialogue: 0,0:04:46.53,0:04:52.81,Default,,0,0,0,,Мичио қызметші кафенің бағытын зорлық-зомбылыққа сүйенбейтін қызметші кафеге өзгертті.
Dialogue: 0,0:04:53.54,0:04:58.70,Default,,0,0,0,,Алайда зорлық-зомбылықтан бас тартқан Мичиёны Узуко қабылдай алмады.
Dialogue: 0,0:05:11.62,0:05:12.31,Default,,0,0,0,,Менеджер
Dialogue: 0,0:05:16.18,0:05:19.95,Default,,0,0,0,,Ал Узуко Мичионы ұрып өлтірді.
Dialogue: 0,0:05:21.13,0:05:23.32,Default,,0,0,0,,Содан кейін Арашико да қайтыс болды.
Dialogue: 0,0:05:23.80,0:05:26.52,Default,,0,0,0,,Узуконың қайтатын жері жоқ.
Dialogue: 0,0:05:26.74,0:05:28.72,Default,,0,0,0,,Сондықтан мекенжайыңыз жоқ.
Dialogue: 0,0:05:28.95,0:05:30.14,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:05:31.27,0:05:35.15,Default,,0,0,0,,Мен күш іздеймін, өйткені мен жалғыздықтан басқалардан көбірек қорқамын.
Dialogue: 0,0:05:35.15,0:05:37.92,Default,,0,0,0,,Сол күш сені жалғыз етеді.
Dialogue: 0,0:05:38.94,0:05:40.97,Default,,0,0,0,,Ақымақ аң
Dialogue: 0,0:05:41.88,0:05:44.66,Default,,0,0,0,,Тамақ ішуге ниетің болмаса, неге кетпейсің?
Dialogue: 0,0:05:46.70,0:05:47.61,Default,,0,0,0,,Ожаашияшита
Dialogue: 0,0:05:47.79,0:05:48.55,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:05:58.54,0:06:00.55,Default,,0,0,0,,Нагоми, сен қайда болдың?
Dialogue: 0,0:06:01.01,0:06:02.69,Default,,0,0,0,,Сіз бұл киімді қанша уақыттан бері киіп жүрсіз?
Dialogue: 0,0:06:02.89,0:06:04.64,Default,,0,0,0,,Жерлеуге де қатыспасам да.
Dialogue: 0,0:06:04.89,0:06:05.47,Default,,0,0,0,,Эй
Dialogue: 0,0:06:06.52,0:06:07.40,Default,,0,0,0,,Нагоми-сан?
Dialogue: 0,0:06:08.24,0:06:08.88,Default,,0,0,0,,Кілт
Dialogue: 0,0:06:09.24,0:06:10.22,Default,,0,0,0,,Менеджердің өлімі
Dialogue: 0,0:06:18.12,0:06:19.53,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:06:19.53,0:06:21.15,Default,,0,0,0,,Аңдар шабуылдауда
Dialogue: 0,0:06:21.36,0:06:21.85,Default,,0,0,0,,Маджи
Dialogue: 0,0:06:22.33,0:06:23.51,Default,,0,0,0,,Қару қажет
Dialogue: 0,0:06:23.69,0:06:26.19,Default,,0,0,0,,Сондықтан мен дүкеннің ақшасын алуға дайынмын.
Dialogue: 0,0:06:26.19,0:06:27.57,Default,,0,0,0,,Менің уақытым жоқ.
Dialogue: 0,0:06:27.79,0:06:30.68,Default,,0,0,0,,Тез дайындалмасаң, қолыңнан ештеңе келмей өлтіріледі.
Dialogue: 0,0:06:31.63,0:06:32.71,Default,,0,0,0,,Тыныштық
Dialogue: 0,0:06:34.34,0:06:35.85,Default,,0,0,0,,Неге сонша сабырлысың?
Dialogue: 0,0:06:36.01,0:06:37.70,Default,,0,0,0,,Балалар, сендер қызметшісіңдер, солай ма?
Dialogue: 0,0:06:37.70,0:06:39.25,Default,,0,0,0,,Менің досымды өлтірді.
Dialogue: 0,0:06:39.25,0:06:42.65,Default,,0,0,0,,Жолдас өлтірілсе, кек алатын күң.
Dialogue: 0,0:06:42.65,0:06:43.57,Default,,0,0,0,,Зоя қаруы
Dialogue: 0,0:06:43.57,0:06:44.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:44.58,0:06:47.34,Default,,0,0,0,,Ақырғы өмірге мүмкіндігінше көбірек аң жібер
Dialogue: 0,0:06:47.34,0:06:50.40,Default,,0,0,0,,Мен күліп, Арашико-санды тозақта кездестіремін.
Dialogue: 0,0:07:14.30,0:07:14.99,Default,,0,0,0,,Нерула-чан
Dialogue: 0,0:07:16.61,0:07:19.69,Default,,0,0,0,,Мен өзгергенім үшін кешіріңіз.
Dialogue: 0,0:07:33.56,0:07:36.59,Default,,0,0,0,,Күні кеше мен шошқа жігіт Моға қарыз болдым.
Dialogue: 0,0:07:36.90,0:07:39.77,Default,,0,0,0,,Шошқа стилі сізді неге сонша қызықтырады?
Dialogue: 0,0:07:43.13,0:07:44.98,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:07:45.80,0:07:47.43,Default,,0,0,0,,Иә Қайта толтыру
Dialogue: 0,0:07:51.10,0:07:52.31,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:52.95,0:07:54.37,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:07:56.31,0:07:58.28,Default,,0,0,0,,Осыған көңіліңіз тола ма?
Dialogue: 0,0:08:00.23,0:08:01.53,Default,,0,0,0,,Сот қажет емес!
Dialogue: 0,0:08:02.32,0:08:03.00,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:08:04.61,0:08:06.79,Default,,0,0,0,,Қызметші деген осы ма?
Dialogue: 0,0:08:07.81,0:08:11.35,Default,,0,0,0,,Біреуді қорқыту, ұру немесе өлтіру қызық па?
Dialogue: 0,0:08:11.81,0:08:14.31,Default,,0,0,0,,үшінн қорқыту қызық па?
Dialogue: 0,0:08:15.13,0:08:16.18,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:08:16.72,0:08:18.32,Default,,0,0,0,,Қызметші деген не?
Dialogue: 0,0:08:18.63,0:08:20.57,Default,,0,0,0,,Эй, айтшы.
Dialogue: 0,0:08:20.57,0:08:22.68,Default,,0,0,0,,Таяқ жегені сонша, жынды болдым.
Dialogue: 0,0:08:23.24,0:08:24.73,Default,,0,0,0,,Мен сені қазір өлтіремін
Dialogue: 0,0:08:26.86,0:08:29.19,Default,,0,0,0,,Ей, қараушылар тым көп.
Dialogue: 0,0:08:29.58,0:08:30.17,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:08:31.46,0:08:32.49,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:08:34.99,0:08:37.01,Default,,0,0,0,,Менің өмір сүруіме санаулы ғана күн қалды.
Dialogue: 0,0:08:37.01,0:08:39.55,Default,,0,0,0,,Қашпа, сен қызметшісің.
Dialogue: 0,0:08:39.77,0:08:43.45,Default,,0,0,0,,Ей, көңілді көбірек өткізейік.
Dialogue: 0,0:09:08.41,0:09:10.77,Default,,0,0,0,,Осылай тозған болса, лақтырып тастауым керек еді.
Dialogue: 0,0:09:14.21,0:09:16.42,Default,,0,0,0,,Мен әдетте мұндай нәрселерді сақтамаймын.
Dialogue: 0,0:09:17.20,0:09:18.40,Default,,0,0,0,,Топырақ...
Dialogue: 0,0:09:18.90,0:09:20.46,Default,,0,0,0,,Бұл Кошиен емес.
Dialogue: 0,0:09:27.53,0:09:28.83,Default,,0,0,0,,Менің түрім қорқынышты
Dialogue: 0,0:09:42.44,0:09:46.67,Default,,0,0,0,,Шүкір, шошқаға кенет шабуыл жасасақ та, дер кезінде дайын болмаймыз.
Dialogue: 0,0:09:46.67,0:09:48.87,Default,,0,0,0,,Өкілдің шешіміне шағымдануға ниетіңіз бар ма?
Dialogue: 0,0:09:49.03,0:09:49.99,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:09:50.28,0:09:53.84,Default,,0,0,0,,Бірақ бұл күндері өкілдердің не ойлап жүргенін білмеймін.
Dialogue: 0,0:09:53.84,0:09:56.45,Default,,0,0,0,,Маннен Арашико түрмеден шыққаннан кейін жағдай өзгерді.
Dialogue: 0,0:09:56.64,0:10:00.10,Default,,0,0,0,,Шошқа қорасын оқшауладым деп ойлаған кезде, оны қайтадан біріктіріңіз.
Dialogue: 0,0:10:00.10,0:10:01.88,Default,,0,0,0,,Енді мен оны қайтадан жаншып алайын деп жатырмын
Dialogue: 0,0:10:02.20,0:10:03.73,Default,,0,0,0,,Мен үлгере алмаймын.
Dialogue: 0,0:10:03.73,0:10:07.34,Default,,0,0,0,,Ах, өкіл Нагидің дәуірі аяқталуы мүмкін.
Dialogue: 0,0:10:12.73,0:10:13.83,Default,,0,0,0,,Нагоми
Dialogue: 0,0:10:13.99,0:10:15.16,Default,,0,0,0,,Теме, қайда барасың...
Dialogue: 0,0:10:15.43,0:10:15.99,Default,,0,0,0,,Ома...
Dialogue: 0,0:10:15.99,0:10:17.14,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:10:18.58,0:10:20.81,Default,,0,0,0,,Нагоми Біз де күресеміз
Dialogue: 0,0:10:21.09,0:10:22.47,Default,,0,0,0,,Бұл Арашиконың Катакиі.
Dialogue: 0,0:10:22.57,0:10:24.51,Default,,0,0,0,,Жол бойымен мүмкіндігінше көп адам жүр.
Dialogue: 0,0:10:24.66,0:10:27.90,Default,,0,0,0,,Егер олар мұны қалайтын болса, сіз тек шешімді болуыңыз керек.
Dialogue: 0,0:10:29.24,0:10:29.78,Default,,0,0,0,,Нагоми?
Dialogue: 0,0:10:30.96,0:10:33.81,Default,,0,0,0,,Маған алғашында Арасико ұнамады.
Dialogue: 0,0:10:34.47,0:10:36.94,Default,,0,0,0,,Бұл мүлдем қызықты емес, менің көзім бақырайып кетті.
Dialogue: 0,0:10:37.39,0:10:38.81,Default,,0,0,0,,Біреуді кенеттен өлтіру
Dialogue: 0,0:10:39.90,0:10:44.17,Default,,0,0,0,,Бірақ Арашикомен қызметші болып жұмыс істеу өте қызықты болды.
Dialogue: 0,0:10:45.24,0:10:48.33,Default,,0,0,0,,Арашико-сан біз бәріміз бір отбасымыз деді.
Dialogue: 0,0:10:49.00,0:10:51.17,Default,,0,0,0,,Мен де бұл жерді жоғалтқым келмейді.
Dialogue: 0,0:10:51.36,0:10:53.65,Default,,0,0,0,,Бірақ аңдар шабуыл жасайды, солай ма?
Dialogue: 0,0:10:54.08,0:10:55.43,Default,,0,0,0,,Бір-бірімізді өлтіруден басқа амалымыз жоқ
Dialogue: 0,0:10:55.74,0:10:57.52,Default,,0,0,0,,Біз де хайуанбыз ғой.
Dialogue: 0,0:10:59.26,0:11:01.77,Default,,0,0,0,,Сіз қазір рахаттанып жатырсыз ба?
Dialogue: 0,0:11:04.54,0:11:06.77,Default,,0,0,0,,Сіздің күйеуіңіз Мо-мое ме?
Dialogue: 0,0:11:08.10,0:11:09.61,Default,,0,0,0,,Аузыңыздың бұрыштары көтерілді ме?
Dialogue: 0,0:11:10.89,0:11:12.23,Default,,0,0,0,,Ауыз бұрышы Шундесу
Dialogue: 0,0:11:12.68,0:11:14.48,Default,,0,0,0,,Бірақ қазір ештеңе істей алмаймыз.
Dialogue: 0,0:11:15.02,0:11:17.87,Default,,0,0,0,,Менің ойымша, сіз қызметші болғаныңыз үшін жасай алатын нәрселер бар.
Dialogue: 0,0:11:18.73,0:11:20.34,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:11:22.06,0:11:23.96,Default,,0,0,0,,Күңдер соғысын бастайық
Dialogue: 0,0:11:33.37,0:11:37.08,Default,,0,0,0,,Наги мырза, шошқаларды жоюды кейінге қалдыра аласыз ба?
Dialogue: 0,0:11:37.26,0:11:38.94,Default,,0,0,0,,Сатсудың тамыры әлі анықталған жоқ.
Dialogue: 0,0:11:38.94,0:11:40.54,Default,,0,0,0,,Қан көбірек ағып кетсе
Dialogue: 0,0:11:40.70,0:11:43.10,Default,,0,0,0,,Күңдердің едәуір бөлігі Мушоға барады.
Dialogue: 0,0:11:43.36,0:11:44.61,Default,,0,0,0,,Жоспарларға өзгерістер енгізілмейді
Dialogue: 0,0:11:44.95,0:11:47.48,Default,,0,0,0,,Наги-сама өзі келеді деп естідім.
Dialogue: 0,0:11:47.48,0:11:48.39,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:11:48.67,0:11:49.14,Default,,0,0,0,,О
Dialogue: 0,0:11:50.91,0:11:52.40,Default,,0,0,0,,Аю тілі оған қарсы.
Dialogue: 0,0:11:52.74,0:11:53.85,Default,,0,0,0,,Бірдеңе болған жағдайда...
Dialogue: 0,0:11:56.34,0:11:56.76,Default,,0,0,0,,Аю
Dialogue: 0,0:12:00.73,0:12:01.28,Default,,0,0,0,,Ай…
Dialogue: 0,0:12:01.74,0:12:03.81,Default,,0,0,0,,Му!
Dialogue: 0,0:12:10.15,0:12:13.18,Default,,0,0,0,,Маған мойынсұнбаған барлық күңдер өлсін.
Dialogue: 0,0:12:16.43,0:12:17.21,Default,,0,0,0,,Рамен мөлшері
Dialogue: 0,0:12:17.21,0:12:19.57,Default,,0,0,0,,Ясай Маши Маши Караме Маши Сарымсақ Оме
Dialogue: 0,0:12:19.57,0:12:20.05,Default,,0,0,0,,алты
Dialogue: 0,0:12:20.51,0:12:22.06,Default,,0,0,0,,Жоқ, жеті өтінемін.
Dialogue: 0,0:12:23.68,0:12:24.05,Default,,0,0,0,,О
Dialogue: 0,0:12:40.58,0:12:42.80,Default,,0,0,0,,Нагоми Аршиге де бер.
Dialogue: 0,0:12:43.16,0:12:44.40,Default,,0,0,0,,Маған да бер
Dialogue: 0,0:12:44.60,0:12:45.29,Default,,0,0,0,,Мен де
Dialogue: 0,0:12:46.00,0:12:47.35,Default,,0,0,0,,Маған да бер
Dialogue: 0,0:13:03.89,0:13:06.14,Default,,0,0,0,,Біраз уақыт болды, Узуко.
Dialogue: 0,0:13:07.66,0:13:09.48,Default,,0,0,0,,Арашико қайтыс болды
Dialogue: 0,0:13:09.69,0:13:10.32,Default,,0,0,0,,Ол...
Dialogue: 0,0:13:10.32,0:13:12.27,Default,,0,0,0,,Біз қазір шошқаларды қуып жібереміз.
Dialogue: 0,0:13:12.47,0:13:13.07,Default,,0,0,0,,Жоғалу
Dialogue: 0,0:13:13.55,0:13:17.29,Default,,0,0,0,,Арашико апалы-сіңлілі екеніңді айтты.
Dialogue: 0,0:13:17.93,0:13:18.80,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:13:19.51,0:13:22.76,Default,,0,0,0,,Негізі, Арашико екеуің менің раменімді тағы жейсіңдер...
Dialogue: 0,0:13:24.92,0:13:27.22,Default,,0,0,0,,Бұдан былай бұл – цукемендердің дәуірі.
Dialogue: 0,0:13:58.96,0:13:59.64,Default,,0,0,0,,У.А. орта мектебі, 1-курс А және Б сыныптары—
Dialogue: 0,0:14:04.13,0:14:06.33,Default,,0,0,0,,Шошқа қорасына қош келдіңіз.
Dialogue: 0,0:14:07.90,0:14:09.93,Default,,0,0,0,,Қаншама жас ханымдар бар
Dialogue: 0,0:14:09.93,0:14:11.73,Default,,0,0,0,,Юмэчи тосын сый
Dialogue: 0,0:14:11.73,0:14:14.55,Default,,0,0,0,,Арши және басқалары сүйкімді болғандықтан бәрі қобалжымайды.
Dialogue: 0,0:14:14.77,0:14:16.50,Default,,0,0,0,,Релакс Релакс
Dialogue: 0,0:14:16.66,0:14:19.52,Default,,0,0,0,,В кафе Тонтокотон всё горничные очень милые.
Dialogue: 0,0:14:19.52,0:14:20.51,Default,,0,0,0,,Қорқып қалмаңдар
Dialogue: 0,0:14:20.51,0:14:22.26,Default,,0,0,0,,Мен сені өлтіруге келдім.
Dialogue: 0,0:14:22.51,0:14:23.65,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:23.74,0:14:24.98,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:14:24.98,0:14:27.26,Default,,0,0,0,,Неге бармайсың, моенді толықтай алмайсың?
Dialogue: 0,0:14:27.26,0:14:28.24,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:14:28.24,0:14:31.23,Default,,0,0,0,,Бүгін Мо Мо Баккюнға қызмет көрсету күні
Dialogue: 0,0:14:31.35,0:14:33.78,Default,,0,0,0,,Чаканы әкелген жас келіншек
Dialogue: 0,0:14:33.78,0:14:35.94,Default,,0,0,0,,Барлық қызметтер тегін.
Dialogue: 0,0:14:36.12,0:14:37.14,Default,,0,0,0,,Өлтіру?
Dialogue: 0,0:14:38.28,0:14:39.44,Default,,0,0,0,,26 адам
Dialogue: 0,0:14:39.79,0:14:41.32,Default,,0,0,0,,Ақылды Бу
Dialogue: 0,0:14:42.16,0:14:43.71,Default,,0,0,0,,Балалар, отырыңдар.
Dialogue: 0,0:14:46.50,0:14:49.34,Default,,0,0,0,,Мұнда сүйкімді торайлар тұрады.
Dialogue: 0,0:14:49.34,0:14:51.08,Default,,0,0,0,,«Тонтокотон» кірпіш үйі
Dialogue: 0,0:14:51.32,0:14:54.73,Default,,0,0,0,,Әдемі ибериялық шошқаға айналу үшін және адамдар оны жейді.
Dialogue: 0,0:14:54.73,0:14:58.66,Default,,0,0,0,,Торайлар бүгін де ханымдарды күтіп отырды.
Dialogue: 0,0:14:58.66,0:14:59.99,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:14:59.99,0:15:00.52,Default,,0,0,0,,Идиот?
Dialogue: 0,0:15:00.85,0:15:03.01,Default,,0,0,0,,Бұл жылқы немесе киік емес.
Dialogue: 0,0:15:03.01,0:15:04.50,Default,,0,0,0,,Бұл шошқаның үйі.
Dialogue: 0,0:15:05.19,0:15:08.80,Default,,0,0,0,,Қымбатты Наги, сізді осы жерде қызметші болып істеген деп естідім.
Dialogue: 0,0:15:09.45,0:15:10.97,Default,,0,0,0,,Баяғыда.
Dialogue: 0,0:15:10.97,0:15:14.85,Default,,0,0,0,,Ханымдар, тапсырыстарыңызды қабылдауға қуаныштымыз.
Dialogue: 0,0:15:15.19,0:15:16.22,Default,,0,0,0,,Ұсынылады
Dialogue: 0,0:15:16.42,0:15:19.18,Default,,0,0,0,,Live Boo Ton Tokoton операция.
Dialogue: 0,0:15:19.48,0:15:21.14,Default,,0,0,0,,Оны әр адамға беріңіз.
Dialogue: 0,0:15:21.46,0:15:23.81,Default,,0,0,0,,Дегенмен, жанды орындау аяқталғаннан кейін барлығы өлтіріледі.
Dialogue: 0,0:15:24.08,0:15:26.02,Default,,0,0,0,,Мұрныңыз жақсы, жас ханым.
Dialogue: 0,0:15:26.77,0:15:28.86,Default,,0,0,0,,Енді Юмэчи бұл сусынды ішеді.
Dialogue: 0,0:15:28.86,0:15:30.93,Default,,0,0,0,,Бухиді өте дәмді ететін Бухи
Dialogue: 0,0:15:31.21,0:15:33.33,Default,,0,0,0,,Юмэчи "тонмое" дегенде
Dialogue: 0,0:15:33.33,0:15:34.87,Default,,0,0,0,,"бухихи" деңіз
Dialogue: 0,0:15:35.10,0:15:35.99,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:15:36.18,0:15:37.19,Default,,0,0,0,,Тонмо
Dialogue: 0,0:15:40.09,0:15:41.02,Default,,0,0,0,,Боу
Dialogue: 0,0:15:41.02,0:15:44.76,Default,,0,0,0,,Қызметші кафедегі ұялшақ адам бубуу
Dialogue: 0,0:15:45.23,0:15:46.78,Default,,0,0,0,,Әсіресе жас ханымдар
Dialogue: 0,0:15:46.78,0:15:48.34,Default,,0,0,0,,Будың түрі қорқынышты
Dialogue: 0,0:15:48.62,0:15:49.89,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:15:49.89,0:15:50.82,Default,,0,0,0,,Тоқта
Dialogue: 0,0:15:51.02,0:15:52.72,Default,,0,0,0,,Мен сені кейін өлтіремін
Dialogue: 0,0:15:53.04,0:15:54.48,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:55.12,0:15:57.85,Default,,0,0,0,,Адам болуды доғардың ба?
Dialogue: 0,0:15:58.40,0:15:59.73,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:15:59.92,0:16:01.02,Default,,0,0,0,,Тонмо
Dialogue: 0,0:16:01.02,0:16:02.23,Default,,0,0,0,,Бухихи
Dialogue: 0,0:16:02.23,0:16:03.25,Default,,0,0,0,,Токо Мое
Dialogue: 0,0:16:03.25,0:16:04.44,Default,,0,0,0,,Бухихи
Dialogue: 0,0:16:04.44,0:16:05.86,Default,,0,0,0,,Мұқият
Dialogue: 0,0:16:06.11,0:16:06.95,Default,,0,0,0,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:16:07.14,0:16:10.62,Default,,0,0,0,,Ханымдарға рахмет, Бу сусынының дәмі жақсырақ.
Dialogue: 0,0:16:13.07,0:16:15.29,Default,,0,0,0,,Неге сонша жақсысың, ақымақ?
Dialogue: 0,0:16:16.71,0:16:17.92,Default,,0,0,0,,Неге оны сонша қараңғы қылып жатырсың?
Dialogue: 0,0:16:18.19,0:16:19.53,Default,,0,0,0,,Темее хамета ка гора
Dialogue: 0,0:16:19.53,0:16:20.96,Default,,0,0,0,,Қалжыңдамаңыз.
Dialogue: 0,0:16:23.36,0:16:26.17,Default,,0,0,0,,Бүгінгі күн үшін барлығыңызға рахмет.
Dialogue: 0,0:16:27.72,0:16:32.22,Default,,0,0,0,,Бүгін бізге көп адам жиналғанына қуаныштымын Бу.
Dialogue: 0,0:16:32.22,0:16:34.38,Default,,0,0,0,,Біз өлтіру үшін келдік.
Dialogue: 0,0:16:34.38,0:16:35.43,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:16:36.33,0:16:39.69,Default,,0,0,0,,Бейбітшілік Нагоми Мен өмірімді желіде жырлаймын
Dialogue: 0,0:16:59.15,0:17:00.52,Default,,0,0,0,,Сіз палапара билейсіз бе?
Dialogue: 0,0:17:00.52,0:17:01.28,Default,,0,0,0,,Сіз не айтып жатырсыз?
Dialogue: 0,0:17:01.28,0:17:02.26,Default,,0,0,0,,Маған ақшамды қайтар
Dialogue: 0,0:17:12.89,0:17:14.73,Default,,0,0,0,,Ол өткір емес.
Dialogue: 0,0:17:16.28,0:17:17.39,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,0:17:17.78,0:17:19.14,Default,,0,0,0,,Сіз өткір емессіз.
Dialogue: 0,0:17:19.57,0:17:21.59,Default,,0,0,0,,Мен дәл қазір осылай кейіп танытып жатырмын.
Dialogue: 0,0:17:22.06,0:17:25.15,Default,,0,0,0,,көремін. Узуко-сан күткендей.
Dialogue: 0,0:17:25.56,0:17:29.53,Default,,0,0,0,,Мен де Узуко-сан сияқты тамаша қызметші болғым келеді.
Dialogue: 0,0:17:49.08,0:17:50.64,Default,,0,0,0,,үшінмыз кеттік
Dialogue: 0,0:18:55.34,0:18:56.18,Default,,0,0,0,,Наги-сама...
Dialogue: 0,0:19:00.74,0:19:02.09,Default,,0,0,0,,Мазаланбаңыз
Dialogue: 0,0:19:04.31,0:19:08.18,Default,,0,0,0,,Мен Ақибаға келгеннен бері көп нәрсе болды.
Dialogue: 0,0:19:09.25,0:19:11.26,Default,,0,0,0,,Қорқынышты қызметші өлетін бөлік
Dialogue: 0,0:19:11.82,0:19:14.54,Default,,0,0,0,,Сүйікті қызметшімнің өлгенін де көрдім.
Dialogue: 0,0:19:15.66,0:19:19.93,Default,,0,0,0,,Өлген күңдер үшін көп адамдар бірін-бірі өлтірді.
Dialogue: 0,0:19:22.17,0:19:25.35,Default,,0,0,0,,Бірақ бұл қызық емес деп ойлаймын.
Dialogue: 0,0:19:26.42,0:19:28.90,Default,,0,0,0,,Неге қызметші сені ұрды?
Dialogue: 0,0:19:29.37,0:19:31.42,Default,,0,0,0,,Сізге мылтық керек емес пе?
Dialogue: 0,0:19:31.88,0:19:34.17,Default,,0,0,0,,Егер сіз триггерді тартпасаңыз, сіз өлтіресіз.
Dialogue: 0,0:19:34.39,0:19:37.09,Default,,0,0,0,,Күш болмаса, Акихабарада өмір сүре алмайсың.
Dialogue: 0,0:19:37.31,0:19:39.41,Default,,0,0,0,,Қызметшіден алыңыз немесе алыңыз
Dialogue: 0,0:19:40.25,0:19:41.91,Default,,0,0,0,,Қызметші – күтуші.
Dialogue: 0,0:19:43.20,0:19:45.85,Default,,0,0,0,,Мұны мен сыйлайтын қызметші әйел айтты.
Dialogue: 0,0:19:46.93,0:19:51.38,Default,,0,0,0,,«Мен әрқашан қожайынымның үйінде боламын».
Dialogue: 0,0:19:54.95,0:19:57.13,Default,,0,0,0,,Қош келдіңіз, жас ханым.
Dialogue: 0,0:19:58.34,0:20:00.29,Default,,0,0,0,,Қайтадан қош келдіңіз бе?
Dialogue: 0,0:20:00.42,0:20:01.05,Default,,0,0,0,,О
Dialogue: 0,0:20:01.66,0:20:04.81,Default,,0,0,0,,Бүгіннен бастап бұл Узуконың үйі.
Dialogue: 0,0:20:09.70,0:20:11.65,Default,,0,0,0,,Әдемі нәрселерді назардан тыс қалдырмаңыз
Dialogue: 0,0:20:11.96,0:20:14.24,Default,,0,0,0,,Қанша жүрсең де, бір ғана қызметші бар
Dialogue: 0,0:20:14.58,0:20:19.53,Default,,0,0,0,,Жас ханым, өзіңізді жалғыз сезінсеңіз, қайта оралыңыз.
Dialogue: 0,0:20:19.90,0:20:22.85,Default,,0,0,0,,Біз сізді қыбырлатып, жігерлендіреміз.
Dialogue: 0,0:20:29.33,0:20:30.86,Default,,0,0,0,,Нагоми дедіңіз бе?
Dialogue: 0,0:20:31.32,0:20:31.87,Default,,0,0,0,,Иә
Dialogue: 0,0:20:32.63,0:20:36.72,Default,,0,0,0,,Сен Мичио-санға жақын да емес лас қызсың.
Dialogue: 0,0:20:37.94,0:20:40.72,Default,,0,0,0,,Сен Арасикоға ұқсайтын қызметшісің.
Dialogue: 0,0:20:41.43,0:20:42.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:43.08,0:20:44.41,Default,,0,0,0,,Мен құрметтімін, Боо.
Dialogue: 0,0:20:46.13,0:20:49.73,Default,,0,0,0,,Сізге ұнады ма, жас ханым?
Dialogue: 0,0:20:57.77,0:21:03.08,Default,,0,0,0,,Нагоми Нагоми…
Dialogue: 0,0:23:03.41,0:23:04.70,Default,,0,0,0,,Сіз білмейсіз.
Dialogue: 0,0:23:05.17,0:23:07.61,Default,,0,0,0,,Бұрын Акихабара да шулы болатын.
Dialogue: 0,0:23:07.61,0:23:08.94,Default,,0,0,0,,Атыс болды
Dialogue: 0,0:23:09.08,0:23:10.30,Default,,0,0,0,,Акихабарада атыс болды ма?
Dialogue: 0,0:23:10.41,0:23:11.33,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:23:11.33,0:23:13.24,Default,,0,0,0,,Сіз бұл туралы қазір ойлай да алмайсыз.
Dialogue: 0,0:23:13.24,0:23:13.92,Default,,0,0,0,,Иә
Dialogue: 0,0:23:18.24,0:23:20.11,Default,,0,0,0,,Айтпақшы, бұл дүкен не үшін?
Dialogue: 0,0:23:20.11,0:23:22.80,Default,,0,0,0,,Себебі сені қолдайтын адам бар.
Dialogue: 0,0:23:22.80,0:23:23.63,Default,,0,0,0,,Сіз оны ұсынасыз ба?
Dialogue: 0,0:23:23.63,0:23:24.86,Default,,0,0,0,,Ол қандай қызметші?
Dialogue: 0,0:23:24.86,0:23:26.54,Default,,0,0,0,,36 жастағы қызметші
Dialogue: 0,0:23:26.88,0:23:27.92,Default,,0,0,0,,36 жаста?
Dialogue: 0,0:23:28.36,0:23:28.72,Default,,0,0,0,,келді
Dialogue: 0,0:23:35.58,0:23:37.71,Default,,0,0,0,,Қош келдіңіз, ұстаз.
Dialogue: 0,0:16:48.11,0:16:49.49,Default,,0,0,0,,Мүлдем жарқыраған және сүйкімді!
Dialogue: 0,0:16:49.49,0:16:50.87,Default,,0,0,0,,Мені жарқырауға шақырыңыз!
Dialogue: 0,0:16:50.87,0:16:52.30,Default,,0,0,0,,Бұрын-соңды болмаған шоу уақыты!
Dialogue: 0,0:16:52.30,0:16:53.97,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:16:53.97,0:17:00.07,Default,,0,0,0,,Золушка оқиғасы осы жерден басталады
Dialogue: 0,0:17:01.92,0:17:07.39,Default,,0,0,0,,Сол шаршаған жүрекке сыйлық бергім келеді.
Dialogue: 0,0:17:07.39,0:17:12.89,Default,,0,0,0,,Күлкің де, жасың да жарқыраған көздерің. Өтінемін!
Dialogue: 0,0:17:29.73,0:17:32.50,Default,,0,0,0,,Қарама-қайшылық қоспасы THE Otomegokoro
Dialogue: 0,0:17:32.72,0:17:36.87,Default,,0,0,0,,Мен өзімшіл сияқтымын, кешіріңіз.
Dialogue: 0,0:17:44.78,0:17:48.97,Default,,0,0,0,,Болашақты жасаңыз!
Dialogue: 0,0:17:50.97,0:17:56.42,Default,,0,0,0,,Мен оны жүзеге асырғым келеді! Болашақ - бұл! Дегенмен әртүрлі нәрселер бар
Dialogue: 0,0:17:56.42,0:17:59.62,Default,,0,0,0,,Қазір кім болсаң да
Dialogue: 0,0:17:59.62,0:18:02.40,Default,,0,0,0,,Үйренбейінше білмейсің.
Dialogue: 0,0:18:02.40,0:18:04.98,Default,,0,0,0,,Бәрі жақсы болмаса, жақсы.
Dialogue: 0,0:18:04.98,0:18:08.22,Default,,0,0,0,,Мұқият, берік, дәл, бірақ күшті
Dialogue: 0,0:18:08.52,0:18:10.72,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:18:10.72,0:18:14.12,Default,,0,0,0,,Жарқыраған дүнием тасып
Dialogue: 0,0:18:16.41,0:18:17.93,Default,,0,0,0,,Қызықты және әсерлі
Dialogue: 0,0:18:17.93,0:18:19.46,Default,,0,0,0,,Күн сайын Bee Gee! О құдайым-ай!
Dialogue: 0,0:18:19.46,0:18:20.66,Default,,0,0,0,,Жарқыраған және қызықты
Dialogue: 0,0:18:20.66,0:18:22.24,Default,,0,0,0,,Сезім мәңгілік он жеті
Dialogue: 0,0:18:22.24,0:18:23.44,Default,,0,0,0,,Қызықты және әсерлі
Dialogue: 0,0:18:23.44,0:18:24.75,Default,,0,0,0,,Мазалағаным үшін кешіріңіз! Эйгё!
Dialogue: 0,0:18:24.75,0:18:26.17,Default,,0,0,0,,Жарқыраған және қызықты
Dialogue: 0,0:18:26.17,0:18:27.85,Default,,0,0,0,,Бәріне ғашық сұлу жүрек!
Dialogue: 0,0:18:27.85,0:18:29.88,Default,,0,0,0,,Көз қала
Dialogue: 0,0:23:39.21,0:23:45.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
