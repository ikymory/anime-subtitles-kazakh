Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.79,0:00:19.54,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:19.99,0:00:21.63,Default,,0,0,0,,Бұл қиын жұмыс болса керек.
Dialogue: 0,0:00:22.33,0:00:22.84,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:23.22,0:00:25.87,Default,,0,0,0,,Сондықтан менде ескертулер болды.
Dialogue: 0,0:00:26.21,0:00:27.94,Default,,0,0,0,,Бірден әрекетке енгізу
Dialogue: 0,0:00:28.35,0:00:29.72,Default,,0,0,0,,Жеңілдік кезеңі бір апта.
Dialogue: 0,0:00:29.95,0:00:30.70,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:02:04.58,0:02:07.36,Default,,0,0,0,,Миракуру шошқа етінен жасалған сорпа жиынтығы - тамаша нұсқа
Dialogue: 0,0:02:07.64,0:02:09.09,Default,,0,0,0,,Өтінішіңізге рахмет
Dialogue: 0,0:02:09.28,0:02:10.86,Default,,0,0,0,,Тез жүрейік
Dialogue: 0,0:02:11.13,0:02:12.98,Default,,0,0,0,,«Джунджо Буккоро Лорд KISS»
Dialogue: 0,0:02:14.92,0:02:18.03,Default,,0,0,0,,Омое-сама әсері керемет. Бұл өте гүлденген.
Dialogue: 0,0:02:18.51,0:02:20.59,Default,,0,0,0,,Күйеуіңізге кофеин инъекциясы
Dialogue: 0,0:02:20.96,0:02:22.75,Default,,0,0,0,,Шошқаға арналған інжу кофесі, бу.
Dialogue: 0,0:02:23.68,0:02:24.65,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:02:28.31,0:02:29.51,Default,,0,0,0,,Мен айтқандай істесең, сен оны жасай аласың.
Dialogue: 0,0:02:30.16,0:02:33.55,Default,,0,0,0,,Жоқ, шошқа маржанның қадірін білмейді.
Dialogue: 0,0:02:33.55,0:02:35.89,Default,,0,0,0,,Менің ойымша, бұл тым сыншылдық.
Dialogue: 0,0:02:36.30,0:02:38.64,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:02:39.26,0:02:40.07,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:40.79,0:02:42.89,Default,,0,0,0,,Бірақ бұл Арашико-санға жарасады деп ойлаймын.
Dialogue: 0,0:02:45.61,0:02:47.53,Default,,0,0,0,,Бұл жақсы сезіледі.
Dialogue: 0,0:02:47.64,0:02:49.82,Default,,0,0,0,,А, Арашиконы қолдайтын адам?
Dialogue: 0,0:02:50.17,0:02:51.97,Default,,0,0,0,,Екеуің бірге өте жақсы көрінесіңдер
Dialogue: 0,0:02:51.97,0:02:53.37,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:02:53.37,0:02:54.54,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:02:54.54,0:02:56.38,Default,,0,0,0,,Қазір қолыңыздан келгеннің бәрін жасайтын уақыт.
Dialogue: 0,0:02:56.38,0:02:59.26,Default,,0,0,0,,Бірақ Арашико әлі де толық тәртіпсіздікке ұқсамайды.
Dialogue: 0,0:02:59.26,0:03:02.14,Default,,0,0,0,,Қожайын мен қызметші арасындағы махаббатқа тыйым салынады.
Dialogue: 0,0:03:02.38,0:03:04.04,Default,,0,0,0,,Топ ережесін бұзсаңыз...
Dialogue: 0,0:03:04.22,0:03:05.42,Default,,0,0,0,,Оқшаулау ретінде қарастырылады
Dialogue: 0,0:03:05.68,0:03:07.98,Default,,0,0,0,,Ақиба тірі шығады деп ойламаймын.
Dialogue: 0,0:03:07.98,0:03:10.19,Default,,0,0,0,,Бірақ Арашико қашып құтыла алады.
Dialogue: 0,0:03:10.19,0:03:12.86,Default,,0,0,0,,Жоқ, егер күң ғашық болса, жеңіледі.
Dialogue: 0,0:03:12.86,0:03:14.52,Default,,0,0,0,,Арашико – қызметші.
Dialogue: 0,0:03:14.52,0:03:16.43,Default,,0,0,0,,Күңдер ғашық болмайды
Dialogue: 0,0:03:17.27,0:03:18.14,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:03:18.38,0:03:20.05,Default,,0,0,0,,Әңгіме: Хазумикури Десука
Dialogue: 0,0:03:20.62,0:03:22.14,Default,,0,0,0,,Сіз Суэхиро мырзаны айтасыз ба?
Dialogue: 0,0:03:22.43,0:03:24.00,Default,,0,0,0,,Есіміңіз есімде.
Dialogue: 0,0:03:24.20,0:03:24.91,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:03:24.91,0:03:26.19,Default,,0,0,0,,Сіз не туралы айттыңыз?
Dialogue: 0,0:03:26.55,0:03:29.56,Default,,0,0,0,,Демалыс күні онымен бірге шығуымды өтінді.
Dialogue: 0,0:03:30.58,0:03:31.06,Default,,0,0,0,,Мен бармаймын
Dialogue: 0,0:03:31.06,0:03:31.93,Default,,0,0,0,,Маджи
Dialogue: 0,0:03:31.93,0:03:33.30,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:33.64,0:03:35.01,Default,,0,0,0,,Жоқ, әлі жауап жоқ
Dialogue: 0,0:03:36.10,0:03:39.69,Default,,0,0,0,,Арашико Сенбі сағат 11. Біз вокзал алдында жиналып жатырмыз.
Dialogue: 0,0:03:39.69,0:03:41.37,Default,,0,0,0,,Жаңа ғана иә дедіңіз бе?
Dialogue: 0,0:03:41.37,0:03:43.46,Default,,0,0,0,,Бұл адам банк қызметкері.
Dialogue: 0,0:03:43.65,0:03:46.54,Default,,0,0,0,,Маған аздап көңілімді түсірсең, олар саған көп ақша береді.
Dialogue: 0,0:03:46.54,0:03:47.61,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:03:47.61,0:03:51.22,Default,,0,0,0,,Өйткені тек банкирлерде атташе істері бар.
Dialogue: 0,0:03:51.22,0:03:52.59,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:03:52.85,0:03:55.95,Default,,0,0,0,,Мен мұны өте жақсы айтқандықтан, Арашико да сәлем беруі керек.
Dialogue: 0,0:03:56.19,0:03:57.25,Default,,0,0,0,,Үйге кететін уақыт келді.
Dialogue: 0,0:03:57.70,0:03:58.20,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:04:00.87,0:04:03.41,Default,,0,0,0,,Менеджер, бұл қабылданбайды.
Dialogue: 0,0:04:03.41,0:04:07.39,Default,,0,0,0,,Бұл жақсы, өйткені кез келген мейрамхана кездесуге баруға жеткілікті.
Dialogue: 0,0:04:08.71,0:04:11.24,Default,,0,0,0,,Біз сізді тағы да күтеміз.
Dialogue: 0,0:04:16.99,0:04:19.02,Default,,0,0,0,,Сіз Арашиконы асыға күтесіз бе?
Dialogue: 0,0:04:19.33,0:04:20.33,Default,,0,0,0,,Бұл не
Dialogue: 0,0:04:20.44,0:04:21.31,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:04:21.82,0:04:23.14,Default,,0,0,0,,Бұл кездесу туралы.
Dialogue: 0,0:04:24.49,0:04:26.33,Default,,0,0,0,,Бұл қызық болуы мүмкін.
Dialogue: 0,0:04:27.33,0:04:31.26,Default,,0,0,0,,Кешіріңіз, мен Арашиконың бақытын қолдауым керек.
Dialogue: 0,0:04:31.84,0:04:32.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:33.13,0:04:37.74,Default,,0,0,0,,Мен қызметші болып жұмыс істей бастағаннан бері бақытты болуды ойламаппын.
Dialogue: 0,0:04:38.11,0:04:40.45,Default,,0,0,0,,Оның қызметшіге қатысы жоқ.
Dialogue: 0,0:04:40.73,0:04:45.34,Default,,0,0,0,,Бірақ Арасикомен бірге қызметші болғаныма қуанған кездерім болды.
Dialogue: 0,0:04:45.65,0:04:46.37,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:46.87,0:04:50.35,Default,,0,0,0,,Мен Арашико-санға кездесуіне көмектесемін.
Dialogue: 0,0:04:50.62,0:04:53.36,Default,,0,0,0,,Нагоми бір кездері кездескен бе?
Dialogue: 0,0:04:53.51,0:04:54.42,Default,,0,0,0,,Бар.
Dialogue: 0,0:04:56.01,0:04:58.35,Default,,0,0,0,,Жоқ, мен өтірік айттым.
Dialogue: 0,0:05:09.05,0:05:10.33,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:10.95,0:05:11.98,Default,,0,0,0,,Мен айтқандай істесең, сен оны жасай аласың.
Dialogue: 0,0:05:14.65,0:05:17.90,Default,,0,0,0,,Кешіріңіз, менің бүгін бір ісім бар.
Dialogue: 0,0:05:27.11,0:05:28.06,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:28.27,0:05:28.98,Default,,0,0,0,,Қайырлы таң...
Dialogue: 0,0:05:28.80,0:05:29.89,Default,,0,0,0,,Жай ғана осы жерді басыңыз
Dialogue: 0,0:05:30.73,0:05:34.24,Default,,0,0,0,,Білемін, жақсы әйелдер әмияндарын шығармайды.
Dialogue: 0,0:05:34.50,0:05:36.91,Default,,0,0,0,,Осылайша сіз өз құндылығыңызды арттырасыз
Dialogue: 0,0:05:37.08,0:05:38.60,Default,,0,0,0,,Мен әрқашан осылай істедім.
Dialogue: 0,0:05:38.73,0:05:41.83,Default,,0,0,0,,Өйткені, танысуға келгенде сыртқы келбетіңізге қарап тартымды болуыңыз керек.
Dialogue: 0,0:05:41.83,0:05:43.94,Default,,0,0,0,,Бұл ерекше күн ғой.
Dialogue: 0,0:05:44.35,0:05:47.29,Default,,0,0,0,,Бұл менің бабушкадан алған көйлегім.
Dialogue: 0,0:05:49.65,0:05:51.70,Default,,0,0,0,,О, бұл шынымен жақсы сезіледі
Dialogue: 0,0:05:51.70,0:05:53.48,Default,,0,0,0,,Ки... Бұл әдемі.
Dialogue: 0,0:05:53.71,0:05:56.15,Default,,0,0,0,,Арашико: Материал жаман емес.
Dialogue: 0,0:05:56.15,0:05:58.46,Default,,0,0,0,,Осымен Цура оңай сынбайды.
Dialogue: 0,0:05:58.66,0:05:59.93,Default,,0,0,0,,Әлгі Арашико-сан
Dialogue: 0,0:06:00.23,0:06:02.72,Default,,0,0,0,,Менің ойымша, қызметшілер де бақытты бола алады.
Dialogue: 0,0:06:03.97,0:06:05.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:05.72,0:06:07.59,Default,,0,0,0,,Бүгінгі күн көңілді өтті деп үміттенемін.
Dialogue: 0,0:06:08.96,0:06:11.15,Default,,0,0,0,,Біз бұлжымас шешімді жалғастырамыз.
Dialogue: 0,0:06:18.44,0:06:19.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:23.73,0:06:24.86,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:06:28.21,0:06:28.75,Default,,0,0,0,,...
Dialogue: 0,0:06:30.30,0:06:32.49,Default,,0,0,0,,Бақыт деген не?
Dialogue: 0,0:06:44.73,0:06:46.19,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:06:46.86,0:06:47.34,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:48.04,0:06:48.95,Default,,0,0,0,,(Барабан соғу дыбысы)
Dialogue: 0,0:06:52.24,0:06:53.73,Default,,0,0,0,,Бұл сізге өте жарасады.
Dialogue: 0,0:07:04.78,0:07:06.78,Default,,0,0,0,,Қош келдіңіз, қош келдіңіз.
Dialogue: 0,0:07:07.19,0:07:09.41,Default,,0,0,0,,Әйелінің кешкі асы ше?
Dialogue: 0,0:07:19.83,0:07:21.45,Default,,0,0,0,,Бұл Арашико-сан ба?
Dialogue: 0,0:07:22.09,0:07:23.05,Default,,0,0,0,,Бұл туралы өкінішпен хабарлаймыз
Dialogue: 0,0:07:25.02,0:07:26.61,Default,,0,0,0,,Арашико қалай сөйлейді
Dialogue: 0,0:07:26.95,0:07:29.05,Default,,0,0,0,,Алғаш естігенде таң қалдым.
Dialogue: 0,0:07:29.48,0:07:30.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:31.22,0:07:32.93,Default,,0,0,0,,Мен тек орынсыз нәрселерді айта аламын
Dialogue: 0,0:07:32.93,0:07:35.39,Default,,0,0,0,,Жоқ, маған сенің айтқаның ұнайды.
Dialogue: 0,0:08:30.34,0:08:32.08,Default,,0,0,0,,Сізге желдеткіш жылытқыштар ұнай ма?
Dialogue: 0,0:08:35.71,0:08:37.28,Default,,0,0,0,,Иә, маған ұнайды.
Dialogue: 0,0:08:37.66,0:08:39.59,Default,,0,0,0,,Бұл жақсы, солай емес пе? Желдеткіш жылытқыш
Dialogue: 0,0:08:40.02,0:08:41.77,Default,,0,0,0,,Менің бөлмемде де біреу бар.
Dialogue: 0,0:08:41.88,0:08:44.29,Default,,0,0,0,,Соңғы кездері өзімді мүлде жылы сезінбеймін.
Dialogue: 0,0:08:44.74,0:08:46.45,Default,,0,0,0,,Ол сынған жоқ па?
Dialogue: 0,0:08:47.76,0:08:48.88,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:08:49.54,0:08:50.79,Default,,0,0,0,,Котацу сатып алғыңыз келе ме?
Dialogue: 0,0:08:51.28,0:08:53.69,Default,,0,0,0,,Оны да қазанға салып, котацу астында жейміз.
Dialogue: 0,0:08:54.20,0:08:57.39,Default,,0,0,0,,Жылылығы сонша, мен ұйықтап кететін сияқтымын.
Dialogue: 0,0:08:57.62,0:08:59.29,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:08:59.70,0:09:01.03,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:09:05.79,0:09:08.04,Default,,0,0,0,,Мен біртүрлі нәрсе айттым ба?
Dialogue: 0,0:09:08.19,0:09:10.73,Default,,0,0,0,,Жоқ, біртүрлі менмін.
Dialogue: 0,0:09:11.25,0:09:14.49,Default,,0,0,0,,Неге екені белгісіз, мен Суэхиро-санмен жүргенде, менің жағым тәтті болады.
Dialogue: 0,0:09:16.99,0:09:17.64,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:09:19.09,0:09:20.86,Default,,0,0,0,,Сіз сәл әрі қарай жүргіңіз келе ме?
Dialogue: 0,0:09:23.37,0:09:25.93,Default,,0,0,0,,Негізі мен бүгін де жұмыс істеуді жоспарлап едім.
Dialogue: 0,0:09:26.69,0:09:28.53,Default,,0,0,0,,Мен көптен бері жұмыстан бос емеспін.
Dialogue: 0,0:09:28.96,0:09:31.46,Default,,0,0,0,,Мен өзімді ешқашан ойлаған емеспін.
Dialogue: 0,0:09:32.11,0:09:33.81,Default,,0,0,0,,Мен мұны істеуден басқа амалым жоқ деп ойладым.
Dialogue: 0,0:09:35.64,0:09:38.56,Default,,0,0,0,,Сол кезде мен Арашикомен таныстым.
Dialogue: 0,0:09:39.01,0:09:40.01,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:09:42.24,0:09:44.04,Default,,0,0,0,,Менің жүрегім тозды
Dialogue: 0,0:09:44.65,0:09:46.79,Default,,0,0,0,,Арашико маған тұруға орын берді.
Dialogue: 0,0:09:48.39,0:09:51.59,Default,,0,0,0,,Толық жүрсең, жұмысты ұмытасың.
Dialogue: 0,0:09:52.06,0:09:54.42,Default,,0,0,0,,Сөйлегенің мені жұбатты.
Dialogue: 0,0:09:55.58,0:09:58.06,Default,,0,0,0,,Арасиконың шыншыл және қарапайым келбеті
Dialogue: 0,0:09:58.79,0:10:01.59,Default,,0,0,0,,Мен мұны білмей тұрып, ол менің ойымды билей бастады.
Dialogue: 0,0:10:03.63,0:10:06.71,Default,,0,0,0,,Сондықтан мен саған тура айтамын, әшекейсіз.
Dialogue: 0,0:10:07.90,0:10:11.30,Default,,0,0,0,,Арашико-сан, екеуміз де Акихабарадан қашсақ ше?
Dialogue: 0,0:10:12.88,0:10:15.18,Default,,0,0,0,,Мен ертең түнгі пойызбен солтүстікке кетемін.
Dialogue: 0,0:10:15.67,0:10:17.72,Default,,0,0,0,,Мен оған дейін жауап алғым келеді.
Dialogue: 0,0:10:18.41,0:10:21.00,Default,,0,0,0,,Шұғыл нәрсе айтып тұрғаныңызды толық түсінемін.
Dialogue: 0,0:10:22.61,0:10:23.47,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:46.61,0:10:49.88,Default,,0,0,0,,Мен ертең кешкі сағат 21:00-де Денкиғай шыға берісінде күтемін.
Dialogue: 0,0:11:04.62,0:11:06.04,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:11:10.75,0:11:11.89,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:11:12.89,0:11:14.64,Default,,0,0,0,,Белгілі бір қызметші туралы әңгіме
Dialogue: 0,0:11:17.65,0:11:21.70,Default,,0,0,0,,Бірде Ақибаға қызметші болуды армандап келген бір қыз болыпты.
Dialogue: 0,0:11:23.12,0:11:27.29,Default,,0,0,0,,Мен қызметші атансам да, үй шаруасы ғана қалды.
Dialogue: 0,0:11:28.74,0:11:33.54,Default,,0,0,0,,Алайда, осылардың арасында оны қолдаған күйеу пайда болды.
Dialogue: 0,0:11:36.03,0:11:40.35,Default,,0,0,0,,Мен ақыры қызметші болып алға шықтым деп ойлаған кезде.
Dialogue: 0,0:11:41.57,0:11:43.28,Default,,0,0,0,,Маған үлкен жұмыс берілді.
Dialogue: 0,0:11:44.15,0:11:47.70,Default,,0,0,0,,Маған жаудың қызметшісі кафесінің басшысын іліп қоюды бұйырды.
Dialogue: 0,0:11:51.90,0:11:54.24,Default,,0,0,0,,Белгілі бір маршруттан ағып кеткендей
Dialogue: 0,0:11:54.52,0:11:57.80,Default,,0,0,0,,Сол күні мақсатты дүкен өте бос болды.
Dialogue: 0,0:12:01.66,0:12:04.97,Default,,0,0,0,,Ол триггерді тартты
Dialogue: 0,0:12:11.56,0:12:12.25,Default,,0,0,0,,Менеджер
Dialogue: 0,0:12:15.93,0:12:19.37,Default,,0,0,0,,Қорқыныштың арасында мен шарасыздан өзіме айттым
Dialogue: 0,0:12:19.98,0:12:21.24,Default,,0,0,0,,Енді сіз жоғары көтеріле аласыз
Dialogue: 0,0:12:21.57,0:12:24.52,Default,,0,0,0,,Сүйікті күйеуімді таптым.
Dialogue: 0,0:12:30.31,0:12:30.82,Default,,0,0,0,,Кім...
Dialogue: 0,0:12:33.79,0:12:35.78,Default,,0,0,0,,Бірақ шындық олай емес еді.
Dialogue: 0,0:12:36.70,0:12:38.66,Default,,0,0,0,,Ұстаз өтірік айтты
Dialogue: 0,0:12:39.34,0:12:40.87,Default,,0,0,0,,Ер адам жақындады
Dialogue: 0,0:12:41.22,0:12:43.34,Default,,0,0,0,,Пайдасыз болып қалған өзін өшіру
Dialogue: 0,0:12:44.07,0:12:45.32,Default,,0,0,0,,Мен айтқандай істесең, сен оны жасай аласың.
Dialogue: 0,0:12:45.80,0:12:47.34,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:12:50.01,0:12:52.80,Default,,0,0,0,,Мен басынан бастап қызметші бола алмаймын.
Dialogue: 0,0:12:53.09,0:12:54.92,Default,,0,0,0,,Ол бір рет қолданылатын болды.
Dialogue: 0,0:13:18.31,0:13:19.27,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:13:19.95,0:13:22.06,Default,,0,0,0,,Мен панда болғым келеді
Dialogue: 0,0:13:23.13,0:13:25.29,Default,,0,0,0,,Міне, осылай болды
Dialogue: 0,0:13:27.82,0:13:30.25,Default,,0,0,0,,Мен қыз шайханасынан Маннен Арашиконы білемін.
Dialogue: 0,0:13:30.67,0:13:33.25,Default,,0,0,0,,Дүкен менеджеріне шабуыл жасап, алдап кеттіңіз, солай ма?
Dialogue: 0,0:13:33.43,0:13:34.24,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:13:34.42,0:13:37.76,Default,,0,0,0,,Бұл дүкен зорлық-зомбылық жасамауға уәде берді, бірақ бәрі өтірік болды.
Dialogue: 0,0:13:41.34,0:13:45.57,Default,,0,0,0,,Менің уақытым тоқтап тұр, Акихабара өзгереді.
Dialogue: 0,0:13:54.71,0:13:57.16,Default,,0,0,0,,Қала тұрғындары да оны ұмытқанда
Dialogue: 0,0:13:59.03,0:13:59.82,Default,,0,0,0,,Мен тілеймін
Dialogue: 0,0:14:00.00,0:14:01.78,Default,,0,0,0,,№ 96 Маннен Арашико
Dialogue: 0,0:14:02.03,0:14:03.16,Default,,0,0,0,,Мен 35 жастамын
Dialogue: 0,0:14:04.17,0:14:05.86,Default,,0,0,0,,Арашико-сан пайда болды.
Dialogue: 0,0:14:06.58,0:14:09.91,Default,,0,0,0,,Мен сіздің дүкен менеджеріңізді өлтірмес бұрын
Dialogue: 0,0:14:11.33,0:14:14.82,Default,,0,0,0,,Суэхироның жақындаған себебі Арашико-санды өлтіру болды.
Dialogue: 0,0:14:15.52,0:14:17.06,Default,,0,0,0,,Менің ойымша, сізді біреу жұмыс істейді.
Dialogue: 0,0:14:18.05,0:14:19.71,Default,,0,0,0,,Сен бүгін бас тартқан сияқтысың.
Dialogue: 0,0:14:20.67,0:14:23.69,Default,,0,0,0,,Мұның бәрі өтірік екенін білемін.
Dialogue: 0,0:14:24.36,0:14:27.14,Default,,0,0,0,,Ол адам тек өз нысанасын жоюды ойлайды.
Dialogue: 0,0:14:28.32,0:14:30.80,Default,,0,0,0,,Сондықтан ертең барма
Dialogue: 0,0:14:31.13,0:14:33.28,Default,,0,0,0,,Барсаң, Хакодате төңірегінде өлтіріледі.
Dialogue: 0,0:14:39.68,0:14:40.35,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:14:41.24,0:14:44.62,Default,,0,0,0,,Сүйіктіңді алып кеткенім үшін кешір.
Dialogue: 0,0:14:45.31,0:14:48.15,Default,,0,0,0,,Тез арада айтпасаң, солай ойлаймын.
Dialogue: 0,0:14:48.51,0:14:49.72,Default,,0,0,0,,Көпке дейін айта алмадым
Dialogue: 0,0:14:57.56,0:14:59.71,Default,,0,0,0,,Осындай қорқақ панда болғаным үшін кешіріңіз...
Dialogue: 0,0:15:05.59,0:15:10.37,Default,,0,0,0,,үшінна көңілді болғанын айтыңыз.
Dialogue: 0,0:15:12.31,0:15:13.74,Default,,0,0,0,,Өмірден өтуіңізбен құттықтаймыз.
Dialogue: 0,0:15:17.99,0:15:19.07,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:15:19.22,0:15:20.44,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:15:20.44,0:15:21.07,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:15:21.07,0:15:22.01,Default,,0,0,0,,Сіз оны жай ғана шайнап көрдіңіз бе?
Dialogue: 0,0:15:22.01,0:15:22.79,Default,,0,0,0,,Мен панда көрдім
Dialogue: 0,0:15:23.21,0:15:24.11,Default,,0,0,0,,Аралау
Dialogue: 0,0:15:24.90,0:15:26.99,Default,,0,0,0,,Мен уақытты жақсы өткіздім
Dialogue: 0,0:15:27.64,0:15:31.09,Default,,0,0,0,,Түрлі шаралар жасағаныңыз үшін рахмет.
Dialogue: 0,0:15:31.58,0:15:32.53,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:32.53,0:15:34.41,Default,,0,0,0,,Қазір дүкен қауіпсіз.
Dialogue: 0,0:15:34.65,0:15:35.69,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:35.69,0:15:37.07,Default,,0,0,0,,Я, мен шыдай алмаймын.
Dialogue: 0,0:15:48.33,0:15:49.68,Default,,0,0,0,,Өмірден өтуіңізбен құттықтаймыз.
Dialogue: 0,0:15:55.32,0:15:59.21,Default,,0,0,0,,Окачимачи мырзаны Мичионы өлтіргені үшін кешіре алмаймын.
Dialogue: 0,0:15:59.71,0:16:02.22,Default,,0,0,0,,Онда неге мені өлтірмейсің?
Dialogue: 0,0:16:03.64,0:16:07.31,Default,,0,0,0,,Мүмкін Мичио мұны қаламайтын шығар.
Dialogue: 0,0:16:11.93,0:16:12.91,Default,,0,0,0,,Арашико-сан?
Dialogue: 0,0:16:13.95,0:16:15.33,Default,,0,0,0,,Мен ол үшін жауаптымын.
Dialogue: 0,0:16:15.50,0:16:16.35,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:16.67,0:16:18.98,Default,,0,0,0,,Өйткені сен менің қожайынымсың.
Dialogue: 0,0:16:23.55,0:16:25.30,Default,,0,0,0,,Бұл жинақ туралы не деуге болады?
Dialogue: 0,0:16:26.54,0:16:28.33,Default,,0,0,0,,Рахмет сізге Бу
Dialogue: 0,0:16:41.97,0:16:43.57,Default,,0,0,0,,Мен шомылдым
Dialogue: 0,0:16:48.20,0:16:50.74,Default,,0,0,0,,Бүгін Суэхиро мырза келмеді.
Dialogue: 0,0:16:51.53,0:16:52.53,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:55.61,0:16:59.93,Default,,0,0,0,,Суэхиро-сан мен Арашико-сан мен үшін тамаша адамдар.
Dialogue: 0,0:17:01.17,0:17:05.18,Default,,0,0,0,,Басында мен Суэхиро мырзадан қорқатынмын.
Dialogue: 0,0:17:05.73,0:17:10.72,Default,,0,0,0,,Бірақ, менің ойымша, ол Арашиконы алып кетеді деп қорықты.
Dialogue: 0,0:17:11.43,0:17:14.98,Default,,0,0,0,,Өліп кете жаздады, суға батып кете жаздады, бейсбол ойнап, жерге тізерлеп отырды
Dialogue: 0,0:17:15.54,0:17:18.31,Default,,0,0,0,,Сонда да мен Арашико-санмен осы уақытқа дейін жеттім.
Dialogue: 0,0:17:18.83,0:17:20.74,Default,,0,0,0,,Арашико-сан жоғалып кетсе ше?
Dialogue: 0,0:17:21.17,0:17:22.72,Default,,0,0,0,,Мен өзімді жалғыз сезінемін
Dialogue: 0,0:17:23.47,0:17:25.45,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:17:25.98,0:17:27.40,Default,,0,0,0,,Қоштасатын сәті келгенде де
Dialogue: 0,0:17:27.61,0:17:30.32,Default,,0,0,0,,Арашико күлімдеп бітірсін
Dialogue: 0,0:17:30.61,0:17:33.30,Default,,0,0,0,,Мен қазір бітіру кешіне жаттығамын.
Dialogue: 0,0:17:33.86,0:17:36.06,Default,,0,0,0,,Мен жыламаймын.
Dialogue: 0,0:17:38.63,0:17:40.58,Default,,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:17:40.92,0:17:42.99,Default,,0,0,0,,Ал... бұл дұрыс емес.
Dialogue: 0,0:17:43.38,0:17:44.90,Default,,0,0,0,,Нагоми-санға рахмет
Dialogue: 0,0:17:46.20,0:17:47.63,Default,,0,0,0,,Нагоми-сансыз
Dialogue: 0,0:17:48.02,0:17:52.42,Default,,0,0,0,,Мен кәдімгі бақыттың қандай болатынын ешқашан ойламаппын деп ойлаймын.
Dialogue: 0,0:17:56.29,0:17:56.90,Default,,0,0,0,,Шығу
Dialogue: 0,0:17:57.50,0:17:58.56,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:18:05.58,0:18:06.33,Default,,0,0,0,,Нагоми-сан
Dialogue: 0,0:18:07.17,0:18:09.33,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:18:35.65,0:18:37.20,Default,,0,0,0,,Өзіңізге қамқорлық жасаңыз
Dialogue: 0,0:18:56.03,0:18:58.08,Default,,0,0,0,,Кешіріңіз, мен қателік жібердім.
Dialogue: 0,0:18:58.22,0:18:59.22,Default,,0,0,0,,Біраз
Dialogue: 0,0:18:59.71,0:19:00.83,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:00.83,0:19:01.96,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:19:21.81,0:19:22.16,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:19:22.34,0:19:22.85,Default,,0,0,0,,Жазатайым оқиға?
Dialogue: 0,0:19:23.12,0:19:24.60,Default,,0,0,0,,Бұл керемет дыбыс шығарды.
Dialogue: 0,0:19:39.74,0:19:40.37,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:19:41.56,0:19:42.36,Default,,0,0,0,,Бұл панда
Dialogue: 0,0:19:44.71,0:19:46.98,Default,,0,0,0,,Дұрыс па, панда?
Dialogue: 0,0:19:47.17,0:19:50.41,Default,,0,0,0,,Мен Арасикоға қожайынын өлтіруге рұқсат бере алмаймын.
Dialogue: 0,0:20:02.05,0:20:04.93,Default,,0,0,0,,Біраз уақыт сөйлескіңіз келе ме?
Dialogue: 0,0:20:35.37,0:20:37.16,Default,,0,0,0,,Сіз күнәларыңызды өтеуге тырысасыз ба?
Dialogue: 0,0:20:39.36,0:20:41.05,Default,,0,0,0,,Сіз енді ештеңе айтпайсыз.
Dialogue: 0,0:20:41.81,0:20:43.92,Default,,0,0,0,,Мен бір нәрсені айта аламын ба?
Dialogue: 0,0:20:44.54,0:20:47.91,Default,,0,0,0,,15 жыл бұрын мені Мичионы өлтіруге мәжбүрлеген адам болды
Dialogue: 0,0:20:48.23,0:20:50.69,Default,,0,0,0,,Мен Кедамоландтың өкілі Наги болдым.
Dialogue: 0,0:20:51.70,0:20:53.76,Default,,0,0,0,,Бұл жолы нұсқаушы да болды
Dialogue: 0,0:20:55.17,0:20:55.95,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:22:47.17,0:22:47.89,Default,,0,0,0,,Не?
Dialogue: 0,0:22:48.18,0:22:49.90,Default,,0,0,0,,Баннен Арашико өлтірілмейді
Dialogue: 0,0:22:50.46,0:22:54.23,Default,,0,0,0,,Сіз оларға бұл топтың Тотокотоны талқандау ниеті екенін айтуыңыз керек еді.
Dialogue: 0,0:22:54.78,0:22:57.21,Default,,0,0,0,,Арашико Манненді өлтірмеу деген нені білдіреді?
Dialogue: 0,0:22:57.48,0:23:00.40,Default,,0,0,0,,Бұл Кедамоноленд тобын өз жауыңызға айналдыру дегенді білдіреді.
Dialogue: 0,0:23:00.75,0:23:02.37,Default,,0,0,0,,Еркін қабылдау.
Dialogue: 0,0:23:02.73,0:23:06.02,Default,,0,0,0,,Қандай жағдай болмасын, мен өз-өзіме қараймын.
Dialogue: 0,0:23:06.50,0:23:08.73,Default,,0,0,0,,Сіз шошқамен өз-өзіне қол жұмсауды жоспарлап отырсыз ба?
Dialogue: 0,0:23:09.11,0:23:10.28,Default,,0,0,0,,Бұл жақсы хобби.
Dialogue: 0,0:23:10.63,0:23:12.96,Default,,0,0,0,,Құнды білудің қажеті жоқ.
Dialogue: 0,0:23:14.46,0:23:20.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
