Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:20:50.10,0:20:52.40,Default,,0,0,0,,Бұл субтитрді бастапқыда Мэн Чая жасаған. Ол коммерциялық алмасу үшін қолданылады. Аудармасы: Таңғаларлық, Аққан жұлдыз, Плакат. Өңдеу: Ронни. Кеш кезең: MIR. Дамытушылық: Жел.
Dialogue: 0,0:01:01.34,0:01:02.21,Default,,0,0,0,,Менеджер
Dialogue: 0,0:03:32.82,0:03:33.63,Default,,0,0,0,,Мастер
Dialogue: 0,0:03:33.00,0:03:34.69,Default,,0,0,0,,100% жүн
Dialogue: 0,0:03:34.26,0:03:35.82,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:35.82,0:03:38.07,Default,,0,0,0,,Мына қызметші кафе ше?
Dialogue: 0,0:03:36.92,0:03:38.38,Default,,0,0,0,,Келіңіз және бізге қонаққа келіңіз
Dialogue: 0,0:03:38.07,0:03:40.87,Default,,0,0,0,,Ханымдар, жеңіл жүргіңіз келе ме?
Dialogue: 0,0:03:39.45,0:03:40.87,Default,,0,0,0,,Қош келдіңіз, Нян
Dialogue: 0,0:03:42.87,0:03:44.72,Default,,0,0,0,,Нағыз қызметші
Dialogue: 0,0:03:44.93,0:03:46.19,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:03:46.19,0:03:48.13,Default,,0,0,0,,үшін сүйкімді
Dialogue: 0,0:03:48.50,0:03:50.77,Default,,0,0,0,,Және көптеген адамдар
Dialogue: 0,0:03:50.77,0:03:53.74,Default,,0,0,0,,Мен шынымен де Акибаға келдім
Dialogue: 0,0:03:53.74,0:03:55.68,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:03:56.93,0:04:00.41,Default,,0,0,0,,Егер сіз бұл флайерді алып келсеңіз, оны тегін алуға болады.
Dialogue: 0,0:04:00.41,0:04:01.85,Default,,0,0,0,,Маған қонаққа келіңіз!
Dialogue: 0,0:04:02.62,0:04:04.01,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:04.29,0:04:05.61,Default,,0,0,0,,Мен міндетті түрде барамын.
Dialogue: 0,0:04:05.61,0:04:06.35,Default,,0,0,0,,Нян
Dialogue: 0,0:04:16.03,0:04:16.82,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:04:40.98,0:04:43.43,Default,,0,0,0,,Шошқа қорасына қош келдіңіз.
Dialogue: 0,0:04:43.64,0:04:45.49,Default,,0,0,0,,Кешіріңіз Boo, дәл қазір...
Dialogue: 0,0:04:45.49,0:04:47.16,Default,,0,0,0,,Мен емес.
Dialogue: 0,0:04:47.69,0:04:51.03,Default,,0,0,0,,Мен Нагоми Вахеимін, мен бүгіннен бастап саған қызметші ретінде қарайтын боламын.
Dialogue: 0,0:04:51.31,0:04:52.86,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:04:53.84,0:04:56.68,Default,,0,0,0,,Менеджер, бірдеңе келді.
Dialogue: 0,0:04:56.68,0:04:58.87,Default,,0,0,0,,О, сен жаңасың.
Dialogue: 0,0:04:59.16,0:04:59.79,Default,,0,0,0,,Иә
Dialogue: 0,0:05:00.00,0:05:02.26,Default,,0,0,0,,Алдымен киіміңді ауыстыр.
Dialogue: 0,0:05:15.80,0:05:17.02,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:28.59,0:05:30.60,Default,,0,0,0,,Жетілген атмосферасы бар қызметші
Dialogue: 0,0:05:31.26,0:05:34.28,Default,,0,0,0,,Ағадай сұлу адамның болғаны қандай керемет.
Dialogue: 0,0:05:35.14,0:05:36.40,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:53.42,0:05:55.47,Default,,0,0,0,,Қызғалдақ қызметші киімі
Dialogue: 0,0:05:56.17,0:05:57.61,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:05:58.30,0:05:58.92,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:59.27,0:06:00.27,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:06:02.64,0:06:05.12,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Нагоми Вахеимін.
Dialogue: 0,0:06:05.12,0:06:07.35,Default,,0,0,0,,Мен тұрақты жұмысшы болып жұмыс істеймін.
Dialogue: 0,0:06:07.53,0:06:09.02,Default,,0,0,0,,Мен 17 жастамын
Dialogue: 0,0:06:09.15,0:06:12.06,Default,,0,0,0,,Мен армандаған сүйкімді қызметші болу үшін.
Dialogue: 0,0:06:12.06,0:06:13.20,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:06:15.64,0:06:18.45,Default,,0,0,0,,Қазіргі уақытта қызметші болғысы келетіндер сирек.
Dialogue: 0,0:06:18.45,0:06:21.22,Default,,0,0,0,,Қолыңнан келеді, дәуір маңызды емес.
Dialogue: 0,0:06:21.22,0:06:23.00,Default,,0,0,0,,Жастар маңызды
Dialogue: 0,0:06:23.23,0:06:26.12,Default,,0,0,0,,Дәл қазір сезініп жатқан сезімдеріңізді бағалаңыз.
Dialogue: 0,0:06:26.34,0:06:26.97,Default,,0,0,0,,Иә
Dialogue: 0,0:06:28.77,0:06:30.45,Default,,0,0,0,,Ал, тағы бір жаңадан келген адам.
Dialogue: 0,0:06:34.94,0:06:35.87,Default,,0,0,0,,Мен тілеймін
Dialogue: 0,0:06:36.31,0:06:38.50,Default,,0,0,0,,№ 96 Маннен Арашико
Dialogue: 0,0:06:38.50,0:06:39.59,Default,,0,0,0,,Менің жасым 35-те
Dialogue: 0,0:06:40.62,0:06:42.86,Default,,0,0,0,,Бұл қызық, бірақ менің жасым 40-қа таяп қалды.
Dialogue: 0,0:06:42.86,0:06:45.68,Default,,0,0,0,,35 жаста жаңа қызметші менеджер
Dialogue: 0,0:06:45.68,0:06:48.21,Default,,0,0,0,,Сіз мұны істей аласыз. Жасы маңызды емес.
Dialogue: 0,0:06:48.36,0:06:51.47,Default,,0,0,0,,Мотивация болса, қайта-қайта жүруге болады.
Dialogue: 0,0:06:51.47,0:06:52.68,Default,,0,0,0,,Менің мотивациям бар
Dialogue: 0,0:06:53.15,0:06:54.28,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:06:55.69,0:06:59.04,Default,,0,0,0,,Олай болса, бүгіннен бастап осы көріністермен бар күшімізді салайық.
Dialogue: 0,0:06:59.57,0:07:02.44,Default,,0,0,0,,Кешіріңіз, бұл адам...
Dialogue: 0,0:07:03.26,0:07:05.07,Default,,0,0,0,,Окачимачи-сан.
Dialogue: 0,0:07:05.72,0:07:07.80,Default,,0,0,0,,Жарайды… Нан…
Dialogue: 0,0:07:07.80,0:07:09.34,Default,,0,0,0,,Пандалармен бірінші рет?
Dialogue: 0,0:07:09.99,0:07:10.70,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:10.70,0:07:11.79,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:07:12.49,0:07:15.56,Default,,0,0,0,,Ах, бұл Акихабараның қызметші кафесі.
Dialogue: 0,0:07:15.56,0:07:17.15,Default,,0,0,0,,Пандалар сияқты кейбіреулері бар.
Dialogue: 0,0:07:17.15,0:07:18.28,Default,,0,0,0,,Жоқ, сіз ол жерде емессіз.
Dialogue: 0,0:07:18.28,0:07:19.65,Default,,0,0,0,,Фушиги-чан сериясы
Dialogue: 0,0:07:19.65,0:07:21.02,Default,,0,0,0,,Бұл аяқталды.
Dialogue: 0,0:07:21.02,0:07:21.96,Default,,0,0,0,,Кейіпкерлерді құру?
Dialogue: 0,0:07:22.60,0:07:23.84,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:07:23.01,0:07:26.16,Default,,0,0,0,,Жақсы, жұмыс уақыты ақылсыз, сондықтан мен дүкенді ашамын.
Dialogue: 0,0:07:26.47,0:07:27.02,Default,,0,0,0,,Иә
Dialogue: 0,0:07:27.02,0:07:28.72,Default,,0,0,0,,Иә, және...
Dialogue: 0,0:07:29.79,0:07:32.44,Default,,0,0,0,,Жоғалып кетпейсіңдер ме балалар
Dialogue: 0,0:07:33.92,0:07:36.53,Default,,0,0,0,,Мен әрқашан қызметші болғым келетін
Dialogue: 0,0:07:36.53,0:07:38.02,Default,,0,0,0,,Өлсем деген ниетпен бар күшімді саламын.
Dialogue: 0,0:07:39.40,0:07:40.98,Default,,0,0,0,,Таң қалды Таң қалды
Dialogue: 0,0:07:41.24,0:07:44.65,Default,,0,0,0,,Бүгін де көп шеберлер келді.
Dialogue: 0,0:07:45.00,0:07:48.40,Default,,0,0,0,,Юмэчи бақытқа толы Бу
Dialogue: 0,0:07:52.02,0:07:54.62,Default,,0,0,0,,Мен де сондай болғым келеді.
Dialogue: 0,0:07:54.62,0:07:56.39,Default,,0,0,0,,Адам болуды тоқтатпасақ, мүмкін емес.
Dialogue: 0,0:07:56.82,0:07:58.72,Default,,0,0,0,,Өйткені бұл әлем дамып келеді
Dialogue: 0,0:08:01.50,0:08:03.06,Default,,0,0,0,,Адам болуды доғар...
Dialogue: 0,0:08:03.71,0:08:05.11,Default,,0,0,0,,Екі жаңадан келген
Dialogue: 0,0:08:05.11,0:08:07.70,Default,,0,0,0,,Қожайыныңыз сізге сусын ұсынсын.
Dialogue: 0,0:08:07.70,0:08:09.72,Default,,0,0,0,,Иә, мен ақылдымын.
Dialogue: 0,0:08:11.55,0:08:13.96,Default,,0,0,0,,Мо Мо Кюн
Dialogue: 0,0:08:15.85,0:08:17.67,Default,,0,0,0,,Бізге қосылыңыз.
Dialogue: 0,0:08:18.52,0:08:19.48,Default,,0,0,0,,Иә
Dialogue: 0,0:08:19.83,0:08:23.09,Default,,0,0,0,,Мо Мо Кюн
Dialogue: 0,0:08:24.36,0:08:27.52,Default,,0,0,0,,Ей, қартайайық.
Dialogue: 0,0:08:27.52,0:08:29.31,Default,,0,0,0,,Бұл Ageage болды.
Dialogue: 0,0:08:29.31,0:08:30.81,Default,,0,0,0,,Қосымша
Dialogue: 0,0:08:31.30,0:08:35.00,Default,,0,0,0,,Тон Мое Токо Мое Тон Токо Тон
Dialogue: 0,0:08:36.17,0:08:37.00,Default,,0,0,0,,...
Dialogue: 0,0:08:38.44,0:08:42.09,Default,,0,0,0,,Тон Мое Токо Мое Тон Токо Тон
Dialogue: 0,0:08:42.09,0:08:43.01,Default,,0,0,0,,Сіз ұялшақсыз ба?
Dialogue: 0,0:08:43.32,0:08:44.39,Default,,0,0,0,,Жоқ, Мижинмо
Dialogue: 0,0:08:48.05,0:08:51.27,Default,,0,0,0,,Жарайды, мен қызметші ретінде бірінші жұмысымды жасаймын.
Dialogue: 0,0:08:51.52,0:08:55.06,Default,,0,0,0,,Юмэчи-сан сияқты мен де адам болуды доғарамын.
Dialogue: 0,0:08:55.32,0:08:56.39,Default,,0,0,0,,Бухи
Dialogue: 0,0:08:57.52,0:08:59.49,Default,,0,0,0,,Мен Мо Мо орманынан келдім
Dialogue: 0,0:08:59.49,0:09:02.15,Default,,0,0,0,,Нагоми да Бу, ең жақсы қызметші
Dialogue: 0,0:09:02.37,0:09:04.78,Default,,0,0,0,,Менің жақсы көретін тағамым - желеңді.
Dialogue: 0,0:09:04.78,0:09:09.03,Default,,0,0,0,,Менің хоббиім Торғай досыммен сөйлесу.
Dialogue: 0,0:09:11.59,0:09:14.28,Default,,0,0,0,,Йоробухи өтінемін
Dialogue: 0,0:09:15.71,0:09:16.97,Default,,0,0,0,,Тонтоко
Dialogue: 0,0:09:16.97,0:09:17.56,Default,,0,0,0,,Эй
Dialogue: 0,0:09:17.77,0:09:18.40,Default,,0,0,0,,Бухи
Dialogue: 0,0:09:18.40,0:09:20.60,Default,,0,0,0,,Нұсқаулықты дұрыс оқуым керек пе?
Dialogue: 0,0:09:34.64,0:09:38.05,Default,,0,0,0,,Қош келдіңіз, ұстаз.
Dialogue: 0,0:09:38.05,0:09:41.37,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:09:43.76,0:09:45.62,Default,,0,0,0,,Мен бүгін кешірім сұраймын.
Dialogue: 0,0:09:45.84,0:09:47.87,Default,,0,0,0,,Бірақ мен қазірден бастап бар күшімді саламын.
Dialogue: 0,0:09:47.87,0:09:49.34,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:09:51.06,0:09:54.07,Default,,0,0,0,,Менің тұрақты адамдарымды мазаламаңыз.
Dialogue: 0,0:09:54.99,0:09:55.88,Default,,0,0,0,,Юмэчи-сан…
Dialogue: 0,0:09:57.61,0:09:58.40,Default,,0,0,0,,Иә
Dialogue: 0,0:09:59.92,0:10:02.07,Default,,0,0,0,,Мен арманымның күңі болдым
Dialogue: 0,0:10:02.87,0:10:04.69,Default,,0,0,0,,Көңілсіз күйге түсуге уақыт жоқ
Dialogue: 0,0:10:11.21,0:10:13.38,Default,,0,0,0,,Шошқа қорасына қош келдіңіз.
Dialogue: 0,0:10:14.23,0:10:15.26,Default,,0,0,0,,Нагоми
Dialogue: 0,0:10:16.17,0:10:19.02,Default,,0,0,0,,Қызметші кафесіне бірінші рет келіп тұрсыз ба?
Dialogue: 0,0:10:19.02,0:10:21.43,Default,,0,0,0,,Қобалжымаңыз, жарайды.
Dialogue: 0,0:10:21.43,0:10:24.58,Default,,0,0,0,,Негізі мен де бүгіннен бастап қызметші болдым.
Dialogue: 0,0:10:27.19,0:10:28.93,Default,,0,0,0,,Тонтон суға айналады.
Dialogue: 0,0:10:29.25,0:10:31.77,Default,,0,0,0,,Көп ішсең, торайға айналасың.
Dialogue: 0,0:10:31.77,0:10:32.69,Default,,0,0,0,,Абайлаңыз...
Dialogue: 0,0:10:33.93,0:10:35.57,Default,,0,0,0,,Көп ішсең, торайға айналасың...
Dialogue: 0,0:10:39.86,0:10:40.54,Default,,0,0,0,,Менеджер
Dialogue: 0,0:10:41.80,0:10:43.14,Default,,0,0,0,,Келсең де
Dialogue: 0,0:10:43.56,0:10:45.31,Default,,0,0,0,,Иә, қуаныштымын.
Dialogue: 0,0:10:45.93,0:10:49.59,Default,,0,0,0,,Менің ойымша, Охире-чанның мерзімі өтіп кетті.
Dialogue: 0,0:10:49.59,0:10:50.82,Default,,0,0,0,,Охире-чан?
Dialogue: 0,0:10:50.82,0:10:53.49,Default,,0,0,0,,Жоқ, Охире-чан...
Dialogue: 0,0:10:54.30,0:10:56.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:56.32,0:10:58.64,Default,,0,0,0,,Тағы сәл күте аласыз ба?
Dialogue: 0,0:11:01.10,0:11:04.53,Default,,0,0,0,,Сіз өз ұстанымыңызды түсінесіз бе?
Dialogue: 0,0:11:05.04,0:11:07.40,Default,,0,0,0,,Поркфуджо Акихабарада дүкен аша алады.
Dialogue: 0,0:11:07.74,0:11:10.39,Default,,0,0,0,,Бұл Кедамоноленд крупының бөлігі болғандықтан.
Dialogue: 0,0:11:11.00,0:11:13.18,Default,,0,0,0,,Сол шындықты ескере отырып
Dialogue: 0,0:11:13.18,0:11:15.66,Default,,0,0,0,,Мен мұндай мәлімдемелер жасай алмауым керек.
Dialogue: 0,0:11:15.66,0:11:18.16,Default,,0,0,0,,Иә, мен бұл туралы өте жақсы білемін.
Dialogue: 0,0:11:20.47,0:11:22.41,Default,,0,0,0,,Олай болса, Охире-чанды шығарыңыз.
Dialogue: 0,0:11:26.73,0:11:27.79,Default,,0,0,0,,Қолжетімсіз
Dialogue: 0,0:11:27.79,0:11:28.88,Default,,0,0,0,,Мен кетемін
Dialogue: 0,0:11:32.45,0:11:33.68,Default,,0,0,0,,Сонымен... ол шықпайды.
Dialogue: 0,0:11:33.68,0:11:35.00,Default,,0,0,0,,Оны бұраңыз
Dialogue: 0,0:11:39.36,0:11:40.76,Default,,0,0,0,,Жоқ, ол шықпайды.
Dialogue: 0,0:11:44.48,0:11:45.52,Default,,0,0,0,,Егер...
Dialogue: 0,0:11:45.73,0:11:47.64,Default,,0,0,0,,«Чуки Чуки Цуки-чан» ісі
Dialogue: 0,0:11:47.98,0:11:50.57,Default,,0,0,0,,Менің бұл қызметшіге рұқсат беруден басқа амалым жоқ.
Dialogue: 0,0:11:51.63,0:11:52.36,Default,,0,0,0,,Мен?
Dialogue: 0,0:11:52.36,0:11:54.34,Default,,0,0,0,,Хмм... бұл мүмкін емес.
Dialogue: 0,0:11:54.34,0:11:56.73,Default,,0,0,0,,Мен бүгін ғана қосылған жаңа қызметкермін...
Dialogue: 0,0:11:58.00,0:12:01.16,Default,,0,0,0,,Охире-чан, күтуге болады.
Dialogue: 0,0:12:01.26,0:12:04.37,Default,,0,0,0,,Нагоми Мен қазір біраз жұмыс істеуге барамын.
Dialogue: 0,0:12:05.33,0:12:07.50,Default,,0,0,0,,Иә, мен не болса да барымды саламын.
Dialogue: 0,0:12:09.53,0:12:11.24,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:11.63,0:12:15.26,Default,,0,0,0,,Мен Нагомидің Чукичукицуки-чанға барғанын қалаймын.
Dialogue: 0,0:12:15.42,0:12:17.05,Default,,0,0,0,,Чуки Чуки Цуки-чан?
Dialogue: 0,0:12:17.05,0:12:18.52,Default,,0,0,0,,Бұл қызметші кафе.
Dialogue: 0,0:12:18.52,0:12:21.72,Default,,0,0,0,,Біздің еншілес дүкендердің бәсекелестерімен байланысқан дүкендер
Dialogue: 0,0:12:22.91,0:12:25.85,Default,,0,0,0,,Мен сенің дүкенге барып мынаны беруіңді қалаймын.
Dialogue: 0,0:12:26.30,0:12:27.45,Default,,0,0,0,,Хат?
Dialogue: 0,0:12:29.91,0:12:31.73,Default,,0,0,0,,Ол келеді.
Dialogue: 0,0:12:31.89,0:12:32.51,Default,,0,0,0,,Иә
Dialogue: 0,0:12:32.73,0:12:34.73,Default,,0,0,0,,Жақсылық жасау үшін бар күшімді саламын.
Dialogue: 0,0:12:35.56,0:12:38.49,Default,,0,0,0,,Сізден мұны сұрағаным үшін кешіріңіз.
Dialogue: 0,0:12:38.68,0:12:40.10,Default,,0,0,0,,Бұл өте жаман.
Dialogue: 0,0:12:40.10,0:12:41.49,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:12:41.49,0:12:43.31,Default,,0,0,0,,Жоқ, оны маған қалдырыңыз.
Dialogue: 0,0:12:45.57,0:12:47.50,Default,,0,0,0,,Не болды, Арашико?
Dialogue: 0,0:12:47.79,0:12:49.97,Default,,0,0,0,,Маған қосылуға рұқсат етіңіз.
Dialogue: 0,0:12:51.04,0:12:54.33,Default,,0,0,0,,Жоқ, менің ойымша, Арасикоға бармаған дұрыс.
Dialogue: 0,0:12:54.33,0:12:55.50,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:57.15,0:12:58.34,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:58.57,0:13:01.21,Default,,0,0,0,,Бұл екі жаңа мүше үшін де жақсы тәжірибе болады.
Dialogue: 0,0:13:05.72,0:13:07.24,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:13:07.24,0:13:08.78,Default,,0,0,0,,Бірге барайық.
Dialogue: 0,0:13:09.99,0:13:13.11,Default,,0,0,0,,Барар алдында тым болмаса дәмді нәрсе жеп ал.
Dialogue: 0,0:13:13.28,0:13:15.76,Default,,0,0,0,,Мен төменде шошқа етінен жасалған раменді ұсынамын.
Dialogue: 0,0:13:16.82,0:13:18.02,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:13:18.70,0:13:20.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:29.96,0:13:32.75,Default,,0,0,0,,Кешіріңіз, бір соя сүті юба рамені.
Dialogue: 0,0:13:32.75,0:13:33.56,Default,,0,0,0,,Эй
Dialogue: 0,0:13:33.88,0:13:34.77,Default,,0,0,0,,Рамен
Dialogue: 0,0:13:34.95,0:13:38.34,Default,,0,0,0,,Ясай Маши Маши Караме Маши Абурамаши Сарымсақ Оме
Dialogue: 0,0:13:40.07,0:13:41.38,Default,,0,0,0,,Ол өзгермейді.
Dialogue: 0,0:13:44.27,0:13:48.37,Default,,0,0,0,,Юмэчидің тонтон сусыны шынымен дәмді.
Dialogue: 0,0:13:48.75,0:13:51.69,Default,,0,0,0,,Менің ойымша, Мое инъекциясы басқаша.
Dialogue: 0,0:13:52.25,0:13:55.75,Default,,0,0,0,,Мен де дүкенге қолымнан келгенше көмектескім келеді.
Dialogue: 0,0:13:56.68,0:14:01.69,Default,,0,0,0,,Сонда да Арашико 35 жаста және қызметші, бұл таңқаларлық.
Dialogue: 0,0:14:02.84,0:14:04.30,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:14:16.94,0:14:17.86,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:14:18.76,0:14:21.38,Default,,0,0,0,,Екеуінің қайтып кеткені осы ма?
Dialogue: 0,0:14:21.38,0:14:24.05,Default,,0,0,0,,Үйге келудің қажеті жоқ, мен жұмыс істей алмаймын.
Dialogue: 0,0:14:24.95,0:14:26.88,Default,,0,0,0,,Юмечи салқын
Dialogue: 0,0:14:26.88,0:14:29.63,Default,,0,0,0,,Ей, балалар сендер ғажайыпқа сенесіңдер ме?
Dialogue: 0,0:14:30.08,0:14:31.23,Default,,0,0,0,,Керемет?
Dialogue: 0,0:14:31.46,0:14:33.81,Default,,0,0,0,,Көріп тұрсыңдар ма?
Dialogue: 0,0:14:34.06,0:14:37.95,Default,,0,0,0,,Екеуі бірге күліп, қызметші болып істейтін болашақ бар.
Dialogue: 0,0:14:38.46,0:14:40.69,Default,,0,0,0,,Онда не үшін парақшалар жасап жатырсың?
Dialogue: 0,0:15:06.92,0:15:07.85,Default,,0,0,0,,Әдемі
Dialogue: 0,0:15:14.27,0:15:19.16,Default,,0,0,0,,Өтінемін № 96 Менің атым Тонтокотоннан Маннен Арашико.
Dialogue: 0,0:15:19.16,0:15:21.73,Default,,0,0,0,,Бұл Нагоми Вахай, мен саған ақша жіберуге келдім.
Dialogue: 0,0:15:24.77,0:15:26.14,Default,,0,0,0,,Мен оны тексеремін.
Dialogue: 0,0:15:26.34,0:15:27.33,Default,,0,0,0,,Сәл күте тұрыңыз, Пён.
Dialogue: 0,0:15:32.39,0:15:35.71,Default,,0,0,0,,Арашико-сан, тақырып Ай қояны.
Dialogue: 0,0:15:35.71,0:15:36.75,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:15:39.34,0:15:41.12,Default,,0,0,0,,Ішінде күтіңіз.
Dialogue: 0,0:15:44.76,0:15:48.14,Default,,0,0,0,,Жоқ, мені кешіріңіз.
Dialogue: 0,0:15:48.75,0:15:50.26,Default,,0,0,0,,Тезірек, жинап ал!
Dialogue: 0,0:15:57.76,0:15:59.18,Default,,0,0,0,,Наметонка?
Dialogue: 0,0:15:59.18,0:16:01.40,Default,,0,0,0,,Түбірден бастайық.
Dialogue: 0,0:16:02.39,0:16:04.74,Default,,0,0,0,,Жоооу
Dialogue: 0,0:16:05.02,0:16:08.24,Default,,0,0,0,,...
Dialogue: 0,0:16:08.80,0:16:11.93,Default,,0,0,0,,Жоооу
Dialogue: 0,0:16:14.49,0:16:16.79,Default,,0,0,0,,Сізді күттіргенім үшін кешіріңіз, жас ханым.
Dialogue: 0,0:16:17.17,0:16:19.00,Default,,0,0,0,,Сіздің бизнесіңіз қандай?
Dialogue: 0,0:16:19.43,0:16:21.55,Default,,0,0,0,,Жоқ, иә...
Dialogue: 0,0:16:21.81,0:16:23.50,Default,,0,0,0,,Мм, м...
Dialogue: 0,0:16:23.50,0:16:25.01,Default,,0,0,0,,Міне, міне... мынау
Dialogue: 0,0:16:37.61,0:16:38.82,Default,,0,0,0,,Оқыңыз
Dialogue: 0,0:16:39.02,0:16:40.02,Default,,0,0,0,,Пён
Dialogue: 0,0:16:43.68,0:16:46.46,Default,,0,0,0,,Антеннасы бар тарақандарға
Dialogue: 0,0:16:46.66,0:16:48.05,Default,,0,0,0,,Мен оны құртамын
Dialogue: 0,0:16:48.05,0:16:50.91,Default,,0,0,0,,Тонтокотон қызметшісі кафесінің барлығынан
Dialogue: 0,0:16:56.00,0:16:58.44,Default,,0,0,0,,Бұл неге ұқсайды?
Dialogue: 0,0:16:59.75,0:17:02.11,Default,,0,0,0,,Басыңа киетініңді.
Dialogue: 0,0:17:02.95,0:17:04.87,Default,,0,0,0,,Ми… құлақтар.
Dialogue: 0,0:17:04.87,0:17:06.02,Default,,0,0,0,,Қоян
Dialogue: 0,0:17:14.22,0:17:16.60,Default,,0,0,0,,Қалай қарасаң да қоян құлағы мен сары құйрығына ұқсайды.
Dialogue: 0,0:17:16.60,0:17:18.39,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:17:18.62,0:17:19.71,Default,,0,0,0,,Жоқ, бұл
Dialogue: 0,0:17:19.71,0:17:21.20,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:17:22.06,0:17:23.65,Default,,0,0,0,,Жыламаңыз
Dialogue: 0,0:17:23.65,0:17:25.03,Default,,0,0,0,,Сіз анық айта аласыз ба?
Dialogue: 0,0:17:25.03,0:17:26.40,Default,,0,0,0,,Мен... бұрыш...
Dialogue: 0,0:17:26.40,0:17:27.74,Default,,0,0,0,,Мен сізді естімеймін
Dialogue: 0,0:18:04.24,0:18:06.20,Default,,0,0,0,,Қағаз алжапқышы қалды
Dialogue: 0,0:18:06.70,0:18:07.82,Default,,0,0,0,,Ол лас
Dialogue: 0,0:18:08.22,0:18:10.42,Default,,0,0,0,,Бірақ қағаздан жасалған алжапқыш болғандықтан жақсы ма?
Dialogue: 0,0:18:10.74,0:18:12.09,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:13.75,0:18:15.11,Default,,0,0,0,,Мен сөйлеп тұрған жоқпын...
Dialogue: 0,0:18:15.11,0:18:15.97,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:18:22.44,0:18:24.00,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:18:24.00,0:18:26.20,Default,,0,0,0,,Тірі қайтып оралма
Dialogue: 0,0:18:26.92,0:18:29.42,Default,,0,0,0,,Олай болса, соңғыға барайық.
Dialogue: 0,0:18:29.42,0:18:31.92,Default,,0,0,0,,«Джунджо қызметшісі Буккоро лорд KISS»
Dialogue: 0,0:18:31.92,0:18:33.06,Default,,0,0,0,,Тонтоко
Dialogue: 0,0:20:10.06,0:20:11.89,Default,,0,0,0,,Ю... өтінемін, мені кешіріңіз.
Dialogue: 0,0:20:12.33,0:20:15.07,Default,,0,0,0,,Жарайды... Мен бәрін істеймін.
Dialogue: 0,0:20:16.92,0:20:18.45,Default,,0,0,0,,Өмірден өтуіңізбен құттықтаймыз.
Dialogue: 0,0:20:40.15,0:20:43.05,Default,,0,0,0,,Күң өмірінің арманшыл бірінші күні
Dialogue: 0,0:20:44.59,0:20:47.42,Default,,0,0,0,,Мен бітіремін
Dialogue: 0,0:22:29.71,0:22:31.09,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:22:31.96,0:22:34.01,Default,,0,0,0,,Өтірік мен қайтып келдім
Dialogue: 0,0:22:34.20,0:22:35.92,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:22:37.11,0:22:37.91,Default,,0,0,0,,Иә
Dialogue: 0,0:22:37.91,0:22:39.42,Default,,0,0,0,,Сондықтан мен айттым
Dialogue: 0,0:22:39.42,0:22:41.94,Default,,0,0,0,,Мен болашақты көремін дейді
Dialogue: 0,0:22:41.94,0:22:43.51,Default,,0,0,0,,Киім қорқынышты.
Dialogue: 0,0:22:44.24,0:22:45.12,Default,,0,0,0,,Иә
Dialogue: 0,0:22:45.34,0:22:47.02,Default,,0,0,0,,Нагоми Киіміңді ауыстыр.
Dialogue: 0,0:22:47.26,0:22:48.85,Default,,0,0,0,,Мен оны багаж бөлмесіне апардым.
Dialogue: 0,0:22:49.05,0:22:50.43,Default,,0,0,0,,Бөлмеге?
Dialogue: 0,0:22:50.81,0:22:52.15,Default,,0,0,0,,4-қабаттың артқы жағы
Dialogue: 0,0:22:54.46,0:22:55.09,Default,,0,0,0,,Иә
Dialogue: 0,0:22:57.36,0:22:59.43,Default,,0,0,0,,Қандай болса да.
Dialogue: 0,0:22:59.63,0:23:01.17,Default,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:23:02.11,0:23:04.49,Default,,0,0,0,,Әйтеуір, мен қазір бұл жерден қашуым керек.
Dialogue: 0,0:23:15.85,0:23:17.34,Default,,0,0,0,,Өйткені бос бөлмелер жоқ
Dialogue: 0,0:23:17.57,0:23:20.55,Default,,0,0,0,,Мен Нагоми-санмен ұйықтап, тамақ ішуді шештім.
Dialogue: 0,0:23:22.67,0:23:27.34,Default,,0,0,0,,Біз сізбен ұзақ мерзімді қарым-қатынасты асыға күтеміз.
Dialogue: 0,0:23:34.92,0:23:35.72,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:36.60,0:23:37.90,Default,,0,0,0,,Мен қашып құтыла алмаймын
Dialogue: 0,0:18:38.14,0:18:44.06,Default,,0,0,0,,Құпия есікті ашыңыз да, келіңіз, қожайын.
Dialogue: 0,0:18:44.06,0:18:49.03,Default,,0,0,0,,Сен тек маған қарауға уәде бересің.
Dialogue: 0,0:18:49.28,0:18:52.20,Default,,0,0,0,,«Қымбаттым» деп сиқырлаңыз
Dialogue: 0,0:18:52.20,0:18:55.01,Default,,0,0,0,,Махаббат қаншалықты таза болса, соншалықты лас
Dialogue: 0,0:18:55.01,0:19:00.95,Default,,0,0,0,,Бәрін өзіме сақтауға рұқсат етіңіз, Өтінемін
Dialogue: 0,0:19:01.50,0:19:04.67,Default,,0,0,0,,Сені жақсы көремін
Dialogue: 0,0:19:04.67,0:19:07.54,Default,,0,0,0,,Мәңгілік арманға шақырған, Қайтпаймын
Dialogue: 0,0:19:07.54,0:19:10.17,Default,,0,0,0,,Маған махаббат бер, Өлтір, сені өлтір, Вончу
Dialogue: 0,0:19:10.17,0:19:13.05,Default,,0,0,0,,Барлық күрішті сулау керек.
Dialogue: 0,0:19:13.05,0:19:15.59,Default,,0,0,0,,Эй, көзіңді жұмы.
Dialogue: 0,0:19:15.59,0:19:18.56,Default,,0,0,0,,Енді үш екі бір деп сана
Dialogue: 0,0:19:18.56,0:19:21.43,Default,,0,0,0,,Көптеген күлкілер жіберіңіз
Dialogue: 0,0:19:21.43,0:19:25.74,Default,,0,0,0,,Баккюн Баккюн Баккюн Баккюн Оясуминасай
Dialogue: 0,0:19:26.10,0:19:29.53,Default,,0,0,0,,Сені жақсы көремін
Dialogue: 0,0:19:29.53,0:19:32.36,Default,,0,0,0,,Мәңгілік арманға шақырған, Енді қайтып бара алмаймын
Dialogue: 0,0:19:32.36,0:19:34.89,Default,,0,0,0,,Маған махаббат бер, Өлтір, Өлтір, Вончу
Dialogue: 0,0:19:34.89,0:19:38.13,Default,,0,0,0,,Жүрегіңді шығарып, қолыңа ұста
Dialogue: 0,0:19:38.13,0:19:40.49,Default,,0,0,0,,Эй, көзіңді жұмы.
Dialogue: 0,0:19:40.49,0:19:43.08,Default,,0,0,0,,Енді үш екі бір деп сана
Dialogue: 0,0:19:43.08,0:19:46.04,Default,,0,0,0,,Көптеген күлкілер жіберіңіз
Dialogue: 0,0:19:46.04,0:19:48.92,Default,,0,0,0,,Баккюн Баккюн Баккюн Баккюн Мен енді тоқтай алмаймын
Dialogue: 0,0:19:48.92,0:19:51.34,Default,,0,0,0,,Махаббат шайқасы жанып тұр
Dialogue: 0,0:19:51.34,0:19:54.42,Default,,0,0,0,,Бойжеткен пәк махаббат жүгіреді
Dialogue: 0,0:19:54.42,0:19:57.18,Default,,0,0,0,,Кимино жүрегі жаңа ғана соқты
Dialogue: 0,0:19:57.18,0:19:59.47,Default,,0,0,0,,ТЖМ ТМ Буккун
Dialogue: 0,0:23:39.40,0:23:45.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
