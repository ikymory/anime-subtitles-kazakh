Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.84,0:01:34.32,Default,,0,0,0,,Бүгін таңертең Чийода Уордындағы Канда өзенінде, Токио.
Dialogue: 0,0:01:34.49,0:01:37.21,Default,,0,0,0,,Белгісіз еркек денесі табылды
Dialogue: 0,0:01:37.66,0:01:39.45,Default,,0,0,0,,Дене қатты бұзылған.
Dialogue: 0,0:01:39.57,0:01:42.00,Default,,0,0,0,,Полиция жедел түрде адамның кім екенін анықтауда...
Dialogue: 0,0:01:48.25,0:01:51.03,Default,,0,0,0,,Жоқ, мен бос емеспін. Мен бос емеспін.
Dialogue: 0,0:01:51.03,0:01:52.86,Default,,0,0,0,,Дүкен менеджеріне де көмектесіңіз.
Dialogue: 0,0:01:52.86,0:01:56.05,Default,,0,0,0,,Жұмыс күші жетпесе, неге жаңа қызметші жалдамасқа?
Dialogue: 0,0:01:56.05,0:01:57.72,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:01:57.88,0:02:00.49,Default,,0,0,0,,Бұл Омое-сама әсеріне байланысты.
Dialogue: 0,0:02:00.49,0:02:02.85,Default,,0,0,0,,Қызметшілер санын көбейту жақсы идея болуы мүмкін.
Dialogue: 0,0:02:02.85,0:02:04.49,Default,,0,0,0,,Мен де жұппын ба?
Dialogue: 0,0:02:06.87,0:02:07.90,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:02:07.90,0:02:10.40,Default,,0,0,0,,Жарайды, жарайды...
Dialogue: 0,0:02:10.79,0:02:12.20,Default,,0,0,0,,Окачимачи мырза...
Dialogue: 0,0:02:13.64,0:02:14.27,Default,,0,0,0,,Өтірік
Dialogue: 0,0:02:14.83,0:02:17.20,Default,,0,0,0,,Мұндай аяқталу тым қорқынышты, солай емес пе?
Dialogue: 0,0:02:17.20,0:02:20.30,Default,,0,0,0,,Окачимачи мырза О пішінінде.
Dialogue: 0,0:02:20.76,0:02:21.70,Default,,0,0,0,,Ой...
Dialogue: 0,0:02:21.94,0:02:25.10,Default,,0,0,0,,Бұл радио емес, Раджпанда, солай ма?
Dialogue: 0,0:02:26.21,0:02:26.79,Default,,0,0,0,,Моге…
Dialogue: 0,0:02:27.89,0:02:29.64,Default,,0,0,0,,Бас бос Деска
Dialogue: 0,0:02:38.20,0:02:40.37,Default,,0,0,0,,Сіз сондасыз
Dialogue: 0,0:02:41.43,0:02:42.78,Default,,0,0,0,,Ол тірі болды.
Dialogue: 0,0:02:43.12,0:02:44.36,Default,,0,0,0,,Оған бірдеңе қосылған.
Dialogue: 0,0:02:46.55,0:02:51.13,Default,,0,0,0,,Kedamoland тобынан Тонтокотон қызметшісі кафесін оқшаулаңыз
Dialogue: 0,0:02:51.55,0:02:52.82,Default,,0,0,0,,Бұл өтірік. Маған көрсет.
Dialogue: 0,0:02:53.55,0:02:54.62,Default,,0,0,0,,Ә… Не?!
Dialogue: 0,0:02:55.25,0:02:56.25,Default,,0,0,0,,Бұл арман
Dialogue: 0,0:02:56.87,0:02:59.70,Default,,0,0,0,,Бұл арман, солай ма?
Dialogue: 0,0:03:01.69,0:03:04.53,Default,,0,0,0,,Шүкір, мен телефонға қосыла алмаймын.
Dialogue: 0,0:03:04.53,0:03:08.03,Default,,0,0,0,,Егер сіз өз тобыңыздан оқшаулансаңыз, Акихабарада бұдан былай өмір сүре алмайсыз.
Dialogue: 0,0:03:08.03,0:03:11.15,Default,,0,0,0,,Omoe-sama әсерінен сатылымдар көбейсе де.
Dialogue: 0,0:03:11.41,0:03:12.54,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:12.54,0:03:13.75,Default,,0,0,0,,Вакаме балдырларының өлімі
Dialogue: 0,0:03:13.94,0:03:16.09,Default,,0,0,0,,Біз не боламыз?
Dialogue: 0,0:03:16.09,0:03:17.30,Default,,0,0,0,,Ол дереу жойылады
Dialogue: 0,0:03:17.86,0:03:19.22,Default,,0,0,0,,Менеджер, біз не істеуіміз керек?
Dialogue: 0,0:03:19.22,0:03:21.21,Default,,0,0,0,,Менен ештеңе сұрама
Dialogue: 0,0:03:21.21,0:03:22.70,Default,,0,0,0,,Өзіңіз ойлап көріңіз
Dialogue: 0,0:03:22.70,0:03:24.26,Default,,0,0,0,,Ойланып қарасам да түсінбеймін
Dialogue: 0,0:03:24.26,0:03:25.68,Default,,0,0,0,,Мен де
Dialogue: 0,0:03:25.68,0:03:28.06,Default,,0,0,0,,Біз нағыз шошқамыз.
Dialogue: 0,0:03:28.33,0:03:31.91,Default,,0,0,0,,Акиба - тордағы шошқа, өлтіруді күтіп отыр.
Dialogue: 0,0:03:33.30,0:03:36.10,Default,,0,0,0,,Мен бұл жаста өлмеуім керек еді.
Dialogue: 0,0:03:46.73,0:03:47.57,Default,,0,0,0,,Ой...
Dialogue: 0,0:03:48.56,0:03:50.96,Default,,0,0,0,,Арашико әлі 36-да.
Dialogue: 0,0:03:51.51,0:03:54.57,Default,,0,0,0,,Мені әлі де адастыруда.
Dialogue: 0,0:03:56.25,0:03:57.00,Default,,0,0,0,,Нагомин
Dialogue: 0,0:03:57.76,0:04:00.38,Default,,0,0,0,,Қайырлы таң, дүкен әлі ашық...
Dialogue: 0,0:04:00.38,0:04:01.70,Default,,0,0,0,,Ақай есімде.
Dialogue: 0,0:04:02.63,0:04:05.81,Default,,0,0,0,,Иә, үнемі қызыл киім киетін бұл Ақай-сан.
Dialogue: 0,0:04:06.30,0:04:07.55,Default,,0,0,0,,Ақай қайтыс болды
Dialogue: 0,0:04:07.85,0:04:09.90,Default,,0,0,0,,Өткен аптада Канда өзенінен табылған мәйіт
Dialogue: 0,0:04:10.00,0:04:10.94,Default,,0,0,0,,Бұл Ақай болатын.
Dialogue: 0,0:04:11.98,0:04:14.54,Default,,0,0,0,,Полиция азапталған болуы мүмкін
Dialogue: 0,0:04:14.89,0:04:16.24,Default,,0,0,0,,Бұл қызметшінің жұмысы.
Dialogue: 0,0:04:17.43,0:04:18.39,Default,,0,0,0,,Шындығында, онша кенеттен емес қой.
Dialogue: 0,0:04:18.39,0:04:20.44,Default,,0,0,0,,Қызметші өз иесін өлтіреді...
Dialogue: 0,0:04:20.53,0:04:23.81,Default,,0,0,0,,Ол басқа дүкендерде де Нагоминмен мақтанатын.
Dialogue: 0,0:04:24.09,0:04:26.91,Default,,0,0,0,,Әрине, дүкендегі қызметшілер маған менсінбей қарады.
Dialogue: 0,0:04:27.16,0:04:28.65,Default,,0,0,0,,Атмосфераны оқи алмайтын жігіт.
Dialogue: 0,0:04:29.54,0:04:31.62,Default,,0,0,0,,Шынымды айтсам, біз де қорқамыз
Dialogue: 0,0:04:32.04,0:04:35.30,Default,,0,0,0,,Мен үнемі келіп-кетемін, сондықтан мені байқап қалуы мүмкін.
Dialogue: 0,0:04:35.71,0:04:38.28,Default,,0,0,0,,Кешіріңіз, мен енді үйге бара алмаймын.
Dialogue: 0,0:04:38.47,0:04:40.58,Default,,0,0,0,,Өйткені мен өмірге ұмтыламын
Dialogue: 0,0:04:41.37,0:04:42.29,Default,,0,0,0,,Қош бол
Dialogue: 0,0:04:49.81,0:04:52.83,Default,,0,0,0,,Шошқа қорасына қош келдіңіз.
Dialogue: 0,0:04:55.46,0:04:59.38,Default,,0,0,0,,Кешіріңіз, біз қызметшілерге дүкенімізге кіруге рұқсат бермейміз.
Dialogue: 0,0:04:59.38,0:05:01.03,Default,,0,0,0,,Менің ойымша, сіз Нянды айтып тұрсыз ба?
Dialogue: 0,0:05:01.03,0:05:03.38,Default,,0,0,0,,Біз жас ханымдармыз.
Dialogue: 0,0:05:03.62,0:05:05.24,Default,,0,0,0,,Қалай қарасаң да қызметші.
Dialogue: 0,0:05:05.51,0:05:07.70,Default,,0,0,0,,Керемет шеберді тапты
Dialogue: 0,0:05:07.70,0:05:09.59,Default,,0,0,0,,Бір орынды бөлісейік.
Dialogue: 0,0:05:09.59,0:05:10.82,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:11.46,0:05:11.75,Default,,0,0,0,,Менің...
Dialogue: 0,0:05:12.63,0:05:14.84,Default,,0,0,0,,Мен мұны ішетін адам емеспін.
Dialogue: 0,0:05:14.84,0:05:18.07,Default,,0,0,0,,Осындай ессіз сусындар беретін орындардан да жақсы орындар бар.
Dialogue: 0,0:05:18.07,0:05:19.97,Default,,0,0,0,,Осылай ерте кетейік.
Dialogue: 0,0:05:20.28,0:05:21.11,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:05:21.11,0:05:23.70,Default,,0,0,0,,Сен кімнің қожайынымен әлек болып жүрсің?
Dialogue: 0,0:05:23.70,0:05:25.91,Default,,0,0,0,,Мен қазірдің өзінде қорқамын.
Dialogue: 0,0:05:26.77,0:05:29.60,Default,,0,0,0,,А... Мм, жақында үйге қайтамыз.
Dialogue: 0,0:05:30.34,0:05:32.35,Default,,0,0,0,,Иә, мен сізді қайтып көруді асыға күтемін.
Dialogue: 0,0:05:33.32,0:05:34.18,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:05:37.54,0:05:40.43,Default,,0,0,0,,Көрініс шошқа қорасына қолайлы.
Dialogue: 0,0:05:40.79,0:05:41.40,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:42.15,0:05:43.91,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:05:43.91,0:05:47.45,Default,,0,0,0,,Фестивальде Гираги арыстаны Омое-сама болады деп шешілді.
Dialogue: 0,0:05:47.45,0:05:49.58,Default,,0,0,0,,Балалар, сендер бұл ережені бұздыңдар, солай ма?
Dialogue: 0,0:05:50.38,0:05:52.58,Default,,0,0,0,,Менің Мое-сама болғаным үшін бе?
Dialogue: 0,0:05:52.58,0:05:53.91,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:05:54.59,0:05:56.42,Default,,0,0,0,,Оқшаулансаң, жаусың.
Dialogue: 0,0:05:56.62,0:05:58.69,Default,,0,0,0,,Бұл тамаша. Сіз мұны істегіңіз келе ме?
Dialogue: 0,0:06:01.08,0:06:02.72,Default,,0,0,0,,Арашико-сан, неге?
Dialogue: 0,0:06:03.03,0:06:05.47,Default,,0,0,0,,Опасыз күң жақсы түсінеді.
Dialogue: 0,0:06:05.65,0:06:08.28,Default,,0,0,0,,Ертең тағы келемін, мияу.
Dialogue: 0,0:06:14.04,0:06:16.68,Default,,0,0,0,,Арашико-сан, сен Десуканы неге тоқтаттың?
Dialogue: 0,0:06:18.24,0:06:19.68,Default,,0,0,0,,Арашико-сан, ұстадың ба?
Dialogue: 0,0:06:20.94,0:06:24.36,Default,,0,0,0,,Оның толық оқшауланғанына менің кінәм.
Dialogue: 0,0:06:25.13,0:06:29.93,Default,,0,0,0,,Kedamoland тобының өкілі екеуміздің қарындастығымыз бар.
Dialogue: 0,0:06:30.84,0:06:33.38,Default,,0,0,0,,Бәлкім, сіз бұрын айтып жүрген апаңыз болар...
Dialogue: 0,0:06:33.63,0:06:36.77,Default,,0,0,0,,Иә, мен өкілмен жұмыс істедім.
Dialogue: 0,0:06:37.00,0:06:37.83,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:06:38.03,0:06:38.71,Default,,0,0,0,,Шынайы
Dialogue: 0,0:06:42.37,0:06:46.48,Default,,0,0,0,,1960 жылдары Акихабарада басым күшке ие болды.
Dialogue: 0,0:06:46.84,0:06:48.89,Default,,0,0,0,,Мичио деген қызметші қыз болды.
Dialogue: 0,0:06:49.75,0:06:51.75,Default,,0,0,0,,Қазір көп нәрсе бар жерде
Dialogue: 0,0:06:52.13,0:06:55.95,Default,,0,0,0,,Мичио ашқан қызметші кафесі болды.
Dialogue: 0,0:06:56.61,0:06:59.89,Default,,0,0,0,,Мен және өкіл сонда қызметші болып жұмыс істедік.
Dialogue: 0,0:07:00.58,0:07:02.50,Default,,0,0,0,,Менің қызметші ретіндегі тәжірибесіздігім
Dialogue: 0,0:07:02.77,0:07:05.74,Default,,0,0,0,,Өкіл маған көп нәрсені үйретті.
Dialogue: 0,0:07:06.71,0:07:09.43,Default,,0,0,0,,Дегенмен, дүкен саясатына қатысты
Dialogue: 0,0:07:09.80,0:07:12.25,Default,,0,0,0,,Менің өкілім екеуміз жанжалдастық.
Dialogue: 0,0:07:13.94,0:07:18.08,Default,,0,0,0,,Менің ойымша, өкіл өзіне деген реніштен өзін оқшаулауды шешті.
Dialogue: 0,0:07:19.66,0:07:21.13,Default,,0,0,0,,Генерал Каэдама
Dialogue: 0,0:07:27.81,0:07:30.05,Default,,0,0,0,,Ертең мен саған қамқор боламын.
Dialogue: 0,0:07:30.28,0:07:31.99,Default,,0,0,0,,Жалғыз жүру жақсы емес.
Dialogue: 0,0:07:32.19,0:07:34.39,Default,,0,0,0,,Себебі мен Омое-сама болдым.
Dialogue: 0,0:07:34.60,0:07:37.32,Default,,0,0,0,,Жоқ, бұл менің және менің өкілімнің арасындағы мәселе.
Dialogue: 0,0:07:37.72,0:07:39.23,Default,,0,0,0,,Мен бәріңді тарта алмаймын.
Dialogue: 0,0:07:39.55,0:07:43.32,Default,,0,0,0,,Қатысамын деп ойлайтын адам біздің дүкенде бола алмайды.
Dialogue: 0,0:07:43.53,0:07:43.99,Default,,0,0,0,,Эй
Dialogue: 0,0:07:47.53,0:07:49.79,Default,,0,0,0,,Біз Арашиконы ұмытпаймыз.
Dialogue: 0,0:07:50.04,0:07:51.74,Default,,0,0,0,,Өз міндетіңді жақсы орында.
Dialogue: 0,0:07:52.20,0:07:52.59,Default,,0,0,0,,Иә
Dialogue: 0,0:07:53.36,0:07:54.76,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:07:54.76,0:07:55.86,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:07:56.13,0:07:58.16,Default,,0,0,0,,Бірақ басқа да жолдар бар.
Dialogue: 0,0:07:58.16,0:08:01.10,Default,,0,0,0,,Бұлай жалғаса берсе, Арши және басқалары бәрі өлтіріледі.
Dialogue: 0,0:08:01.10,0:08:02.19,Default,,0,0,0,,Шындығында, онша кенеттен емес қой.
Dialogue: 0,0:08:02.40,0:08:04.45,Default,,0,0,0,,Біз Арашиконы қорғай алмаймыз
Dialogue: 0,0:08:04.59,0:08:05.96,Default,,0,0,0,,Бұл аянышты.
Dialogue: 0,0:08:06.28,0:08:07.22,Default,,0,0,0,,Зоя
Dialogue: 0,0:08:07.39,0:08:11.39,Default,,0,0,0,,Барсақ, Арашико-санның дайындығы зая кетеді.
Dialogue: 0,0:08:11.67,0:08:12.74,Default,,0,0,0,,Қалай болғанда да, торттан дәм татпайсың ба?
Dialogue: 0,0:08:13.02,0:08:14.17,Default,,0,0,0,,Мен жалғыз болсам да...
Dialogue: 0,0:08:15.14,0:08:17.35,Default,,0,0,0,,Сіз өлуге дайынсыз ба?
Dialogue: 0,0:08:24.50,0:08:26.77,Default,,0,0,0,,Дайын болмасаң, қиналып қаласың.
Dialogue: 0,0:08:31.79,0:08:34.02,Default,,0,0,0,,Ал, ертең таң ерте.
Dialogue: 0,0:08:34.02,0:08:35.61,Default,,0,0,0,,Алдын ала кешірім сұраймын.
Dialogue: 0,0:08:36.37,0:08:37.84,Default,,0,0,0,,Жалпы, білікті
Dialogue: 0,0:08:46.96,0:08:51.42,Default,,0,0,0,,Мен сендермен танысқаннан бері мен өте көңілді болдым.
Dialogue: 0,0:08:52.15,0:08:54.62,Default,,0,0,0,,Ол сендерді қорғауға тырысып жатқан болуы керек.
Dialogue: 0,0:08:55.44,0:08:56.81,Default,,0,0,0,,Ол ебедейсіз жігіт.
Dialogue: 0,0:09:21.53,0:09:22.09,Default,,0,0,0,,Неге...
Dialogue: 0,0:09:22.61,0:09:24.67,Default,,0,0,0,,Эйссіз басталуы мүмкін емес, солай ма?
Dialogue: 0,0:09:24.67,0:09:26.40,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын.
Dialogue: 0,0:09:26.40,0:09:28.98,Default,,0,0,0,,Сен өзіңді саңырауқұлақ деп атағандықтан, мен оны себетке салып өлдім.
Dialogue: 0,0:09:28.98,0:09:31.08,Default,,0,0,0,,Сізге байланыстың күшін көрсетейік
Dialogue: 0,0:09:31.08,0:09:32.59,Default,,0,0,0,,Сен мені соңына дейін жек көрдің.
Dialogue: 0,0:09:34.00,0:09:35.50,Default,,0,0,0,,Сіз өз өміріңізді жоғалтасыз
Dialogue: 0,0:09:36.59,0:09:38.85,Default,,0,0,0,,Арашико-сан, мен шешімдімін.
Dialogue: 0,0:09:39.25,0:09:40.56,Default,,0,0,0,,Өлуге дайын емес
Dialogue: 0,0:09:40.93,0:09:43.65,Default,,0,0,0,,Біз бәріміз мүмкіндігінше тезірек оралуға бел будық.
Dialogue: 0,0:09:46.52,0:09:47.41,Default,,0,0,0,,Құрметті баршаңызға
Dialogue: 0,0:09:49.49,0:09:50.47,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:09:55.55,0:09:57.07,Default,,0,0,0,,Бүгін қалайсың?
Dialogue: 0,0:09:57.21,0:10:00.93,Default,,0,0,0,,Тері экожүйенің шыңына лайық жарқырайды
Dialogue: 0,0:10:01.21,0:10:01.87,Default,,0,0,0,,Иә
Dialogue: 0,0:10:02.33,0:10:03.98,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:10:04.17,0:10:06.62,Default,,0,0,0,,Сіз мұнда кім екенін білесіз бе?
Dialogue: 0,0:10:13.23,0:10:14.91,Default,,0,0,0,,Сенімен бірге келгенімді қалайсың ба?
Dialogue: 0,0:10:19.90,0:10:22.45,Default,,0,0,0,,Ей, балалар шықыңдар.
Dialogue: 0,0:10:22.45,0:10:23.91,Default,,0,0,0,,Қаруларыңызды қалдырыңыз.
Dialogue: 0,0:10:23.91,0:10:26.52,Default,,0,0,0,,Маған бәрібір, шошқалар, мені ара ұясына айналдырыңдар.
Dialogue: 0,0:10:27.70,0:10:29.44,Default,,0,0,0,,Неге сонша беймазасың?
Dialogue: 0,0:10:29.44,0:10:31.19,Default,,0,0,0,,Тез шық
Dialogue: 0,0:10:33.78,0:10:35.80,Default,,0,0,0,,Мені өлтіретін болсаң, тез өлтір.
Dialogue: 0,0:10:36.24,0:10:37.41,Default,,0,0,0,,Сен барымтасың
Dialogue: 0,0:10:37.63,0:10:40.98,Default,,0,0,0,,Дайындығы жоқ адам аңдар патшасымен төбелесіп жатқандай емес.
Dialogue: 0,0:10:41.08,0:10:44.82,Default,,0,0,0,,Бүгін жолым жаман болды, Аршы өле ме деп ойлаймын.
Dialogue: 0,0:10:44.94,0:10:47.17,Default,,0,0,0,,Жарайды, әйел интуициясы
Dialogue: 0,0:10:47.17,0:10:48.52,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:52.03,0:10:53.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:53.47,0:10:55.77,Default,,0,0,0,,Өкіл Шошқалар кепілге алып жатыр.
Dialogue: 0,0:10:55.77,0:10:57.71,Default,,0,0,0,,Мен жалт-жұлт еткен арыстанда баррикададамын
Dialogue: 0,0:10:58.31,0:10:59.08,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,0:10:59.92,0:11:02.23,Default,,0,0,0,,Бірақ Гираги арыстаны өкілдің тікелей ұрпағы...
Dialogue: 0,0:11:02.23,0:11:03.23,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,0:11:04.17,0:11:05.19,Default,,0,0,0,,Жарайды Дэмоно
Dialogue: 0,0:11:08.33,0:11:08.73,Default,,0,0,0,,Эй
Dialogue: 0,0:11:08.99,0:11:09.47,Default,,0,0,0,,Иә
Dialogue: 0,0:11:14.02,0:11:15.50,Default,,0,0,0,,Олар көп болады.
Dialogue: 0,0:11:16.11,0:11:16.69,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:11:17.09,0:11:17.56,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.38,0:11:24.79,Default,,0,0,0,,Бұрыштар көп.
Dialogue: 0,0:11:26.31,0:11:29.11,Default,,0,0,0,,Аңдар, мына жігіттің өмірін қаласаңдар...
Dialogue: 0,0:11:33.06,0:11:34.97,Default,,0,0,0,,Барымтада болсам да оқ жаудырды.
Dialogue: 0,0:11:34.97,0:11:36.44,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:36.72,0:11:38.79,Default,,0,0,0,,Наги-самадан күткендей
Dialogue: 0,0:11:38.79,0:11:41.47,Default,,0,0,0,,Тозаққа бірге барайық
Dialogue: 0,0:11:41.93,0:11:43.15,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:11:43.15,0:11:45.22,Default,,0,0,0,,Жануарлардың жақындауына жол берме
Dialogue: 0,0:11:46.10,0:11:48.02,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:11:57.85,0:11:58.97,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:11:59.71,0:12:02.33,Default,,0,0,0,,үшін Гираги арыстанына бет алды ма?
Dialogue: 0,0:12:07.24,0:12:09.41,Default,,0,0,0,,Өкілдік жоғарғы қабатта орналасқан сияқты.
Dialogue: 0,0:12:16.04,0:12:17.81,Default,,0,0,0,,Маннен Арашико
Dialogue: 0,0:12:19.94,0:12:20.53,Default,,0,0,0,,Өтірік
Dialogue: 0,0:12:21.31,0:12:22.47,Default,,0,0,0,,Маған Чаканы беріңіз
Dialogue: 0,0:12:29.33,0:12:30.90,Default,,0,0,0,,Өкіл сізді шақырып жатыр.
Dialogue: 0,0:12:35.78,0:12:38.36,Default,,0,0,0,,Үйге тірі ораламын деп ойламаңыз.
Dialogue: 0,0:12:39.65,0:12:41.56,Default,,0,0,0,,Кешіріңіз, мен сізбен бірге келдім.
Dialogue: 0,0:12:43.80,0:12:44.49,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:12:44.88,0:12:45.58,Default,,0,0,0,,Иә
Dialogue: 0,0:13:03.59,0:13:04.90,Default,,0,0,0,,Мен оны сізге қайтарамын.
Dialogue: 0,0:13:07.56,0:13:10.94,Default,,0,0,0,,Кемпірге айналғаныма өкінемін.
Dialogue: 0,0:13:12.03,0:13:14.98,Default,,0,0,0,,Оңай жеңемін деп ойламаппын.
Dialogue: 0,0:13:17.80,0:13:18.96,Default,,0,0,0,,Жоғары қара
Dialogue: 0,0:13:22.84,0:13:24.80,Default,,0,0,0,,Арашико, сен мұнда не істеп жүрсің?
Dialogue: 0,0:13:25.52,0:13:27.81,Default,,0,0,0,,Біз оқшаулауды жою туралы өтінішті сұрадық.
Dialogue: 0,0:13:28.73,0:13:30.93,Default,,0,0,0,,Сен мені өлтіруге келмедің бе?
Dialogue: 0,0:13:31.96,0:13:33.54,Default,,0,0,0,,Мен сені өлтіргім келді.
Dialogue: 0,0:13:34.02,0:13:36.84,Default,,0,0,0,,Бірақ мен Узуко-санды өзім өлтіре алмаймын.
Dialogue: 0,0:13:38.45,0:13:41.59,Default,,0,0,0,,Мен көмектесе алсам, сені өлтіргім келмейді.
Dialogue: 0,0:13:42.82,0:13:43.53,Default,,0,0,0,,Узуко-сан
Dialogue: 0,0:13:44.94,0:13:47.76,Default,,0,0,0,,Арашико Мен басшыларға орындар дайындаймын.
Dialogue: 0,0:13:48.81,0:13:51.13,Default,,0,0,0,,Оның орнына кежиме киіңіз.
Dialogue: 0,0:13:54.94,0:13:57.11,Default,,0,0,0,,Барып сол қарғыс атқыр адамдарды өлтір.
Dialogue: 0,0:13:58.52,0:14:01.51,Default,,0,0,0,,Сіз әрқашан Мичиё-санға құмар болдыңыз.
Dialogue: 0,0:14:01.73,0:14:04.62,Default,,0,0,0,,Мен сенің шошқа қорасын қорғауға тырысып жатқаныңды білемін.
Dialogue: 0,0:14:05.23,0:14:06.09,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:14:06.62,0:14:09.13,Default,,0,0,0,,Енді мені қорғау үшін күрес.
Dialogue: 0,0:14:09.55,0:14:11.63,Default,,0,0,0,,Мичио-санның түсінетініне сенімдімін.
Dialogue: 0,0:14:12.44,0:14:14.89,Default,,0,0,0,,Менің артымнан ерсең, сенде бәрі болады.
Dialogue: 0,0:14:15.41,0:14:16.60,Default,,0,0,0,,Акибадағы қауіпсіздік
Dialogue: 0,0:14:16.93,0:14:18.60,Default,,0,0,0,,Қызметші қыздардың құрметі
Dialogue: 0,0:14:18.76,0:14:20.15,Default,,0,0,0,,Бай шебер
Dialogue: 0,0:14:20.63,0:14:22.63,Default,,0,0,0,,Мен бәрін дайындаймын.
Dialogue: 0,0:14:23.99,0:14:26.25,Default,,0,0,0,,Тағы бірге қызметші болып жұмыс істейік.
Dialogue: 0,0:14:27.81,0:14:28.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:29.49,0:14:30.04,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:30.88,0:14:31.58,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:14:33.39,0:14:37.57,Default,,0,0,0,,Тонтокото мен үшін таптырмас.
Dialogue: 0,0:14:40.71,0:14:42.13,Default,,0,0,0,,Мұқият оқшаулау
Dialogue: 0,0:14:42.77,0:14:45.32,Default,,0,0,0,,Өз шарларыңызбен жасаңыз.
Dialogue: 0,0:14:45.85,0:14:46.82,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:14:47.17,0:14:49.56,Default,,0,0,0,,Менімен үйге барамын деп айтпадың ба?
Dialogue: 0,0:14:50.25,0:14:51.87,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:14:52.06,0:14:56.03,Default,,0,0,0,,Тонтокотон - болашақта Акихабараға қажет қызметші кафесі.
Dialogue: 0,0:14:56.36,0:14:59.14,Default,,0,0,0,,Шашыңызды дұрыс бұра алмайтын дүкен бар ма?
Dialogue: 0,0:14:59.43,0:15:04.09,Default,,0,0,0,,Мен Удзуко сияқты жүзі Буддаға ұқсайтын адамдардың келгенін қалаймын.
Dialogue: 0,0:15:09.60,0:15:11.89,Default,,0,0,0,,Сөздерді мұқият таңдаңыз
Dialogue: 0,0:15:12.09,0:15:12.73,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:15:14.34,0:15:16.25,Default,,0,0,0,,Неліктен біз шошқаларға ерекше көңіл бөлеміз?
Dialogue: 0,0:15:17.77,0:15:18.89,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:15:20.23,0:15:23.55,Default,,0,0,0,,Бәріміз казиноға барып, бірге бейсбол ойнадық.
Dialogue: 0,0:15:24.12,0:15:26.14,Default,,0,0,0,,Туған күніңізде іс-шара өткізіңіз
Dialogue: 0,0:15:26.41,0:15:28.17,Default,,0,0,0,,үшін тойлады.
Dialogue: 0,0:15:29.42,0:15:32.67,Default,,0,0,0,,Тіпті кетчуп салу дағдыларым да жақсарды.
Dialogue: 0,0:15:42.61,0:15:45.16,Default,,0,0,0,,Бұл көңілді ме? Бұл жақсы.
Dialogue: 0,0:15:46.21,0:15:46.97,Default,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:15:47.32,0:15:48.07,Default,,0,0,0,,Иә
Dialogue: 0,0:15:48.23,0:15:50.14,Default,,0,0,0,,Шаянның басын толтырыңыз.
Dialogue: 0,0:15:50.85,0:15:52.63,Default,,0,0,0,,Нагомидің бұған еш қатысы жоқ.
Dialogue: 0,0:15:54.07,0:15:55.44,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:15:55.64,0:15:57.14,Default,,0,0,0,,Нагоми-сан, №.
Dialogue: 0,0:15:57.14,0:15:59.94,Default,,0,0,0,,Арашико-сан, маған да қолымнан келгеннің бәрін жасауға рұқсат етіңіз.
Dialogue: 0,0:16:10.54,0:16:11.01,Default,,0,0,0,,Зоя
Dialogue: 0,0:16:11.37,0:16:12.24,Default,,0,0,0,,Жарайды Өлім
Dialogue: 0,0:16:12.24,0:16:14.25,Default,,0,0,0,,Бірақ бұл қанды
Dialogue: 0,0:16:14.25,0:16:15.39,Default,,0,0,0,,Бұлай болса, көмектесу мүмкін емес
Dialogue: 0,0:16:16.02,0:16:17.97,Default,,0,0,0,,Мен бәрінің өлгенін көргім келмейді.
Dialogue: 0,0:16:18.21,0:16:19.71,Default,,0,0,0,,Мен сенен бұрын өмірден өттім.
Dialogue: 0,0:16:20.82,0:16:22.72,Default,,0,0,0,,Эй, сен не ойлап тұрсың?
Dialogue: 0,0:16:22.72,0:16:25.14,Default,,0,0,0,,Мен сені кездестіргеніме қуаныштымын.
Dialogue: 0,0:16:25.14,0:16:27.43,Default,,0,0,0,,Егер сіз, дүкен менеджері, бас тартсаңыз, не істеу керек?
Dialogue: 0,0:16:27.64,0:16:29.25,Default,,0,0,0,,Арашико мен Нагоми де тынбай еңбек етуде
Dialogue: 0,0:16:29.39,0:16:31.51,Default,,0,0,0,,Бұл сіздің дүкеніңіз.
Dialogue: 0,0:16:33.41,0:16:34.69,Default,,0,0,0,,Менің дүкенім…
Dialogue: 0,0:16:39.82,0:16:42.40,Default,,0,0,0,,Менің дүкенімді атаңыз
Dialogue: 0,0:16:44.45,0:16:47.18,Default,,0,0,0,,Жартылай егіз қапталады.
Dialogue: 0,0:16:47.73,0:16:50.83,Default,,0,0,0,,Арашико, сіз шошқа қорасына ерекше көңіл бөлесіз.
Dialogue: 0,0:16:50.83,0:16:52.67,Default,,0,0,0,,Бұл қызметші мені бүлдіріп алғаны үшін бе?
Dialogue: 0,0:16:53.66,0:16:55.48,Default,,0,0,0,,Мынадай қызметшіге не болды?
Dialogue: 0,0:16:56.93,0:16:57.78,Default,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:16:59.70,0:17:03.47,Default,,0,0,0,,Нагоми-сан Мичио-санға ұқсайды
Dialogue: 0,0:17:10.70,0:17:11.41,Default,,0,0,0,,Нагоми-сан
Dialogue: 0,0:17:11.41,0:17:13.37,Default,,0,0,0,,Күш – бұл Акибада бәрі
Dialogue: 0,0:17:13.37,0:17:15.74,Default,,0,0,0,,Күшсіз қызметшінің құны жоқ.
Dialogue: 0,0:17:15.74,0:17:17.74,Default,,0,0,0,,Узуко-сан, тоқташы.
Dialogue: 0,0:17:17.74,0:17:21.31,Default,,0,0,0,,Егер мен Мичионың айтқанын орындасам, қазірге дейін барлығы өлтірілген болар еді.
Dialogue: 0,0:17:21.80,0:17:24.78,Default,,0,0,0,,Оны сен де білесің, сол үшін қызметші қызды өлтірдің.
Dialogue: 0,0:17:25.79,0:17:28.49,Default,,0,0,0,,Мені немесе мына жігітті таңдаңыз.
Dialogue: 0,0:17:32.16,0:17:34.12,Default,,0,0,0,,Құйын
Dialogue: 0,0:17:34.12,0:17:35.12,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:17:35.67,0:17:36.37,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:17:36.63,0:17:40.06,Default,,0,0,0,,Арашико-сан үшін оның жалғыз өкілі – әпкесі, солай ма?
Dialogue: 0,0:17:40.48,0:17:42.26,Default,,0,0,0,,Атпасаң өледі.
Dialogue: 0,0:17:44.07,0:17:44.97,Default,,0,0,0,,Таңдау мүмкін емес
Dialogue: 0,0:17:46.73,0:17:50.47,Default,,0,0,0,,Өйткені Узуко-сан мен Нагоми-сан екеуі де отбасының маңызды мүшелері.
Dialogue: 0,0:17:53.00,0:17:53.70,Default,,0,0,0,,Узуко-сан
Dialogue: 0,0:17:55.00,0:17:57.39,Default,,0,0,0,,Мені өміріммен кешір
Dialogue: 0,0:17:58.59,0:18:02.02,Default,,0,0,0,,Өйткені, бұл менің үйім.
Dialogue: 0,0:18:15.55,0:18:19.30,Default,,0,0,0,,Тіпті 36 жаста болса да, бұл әдепсіз.
Dialogue: 0,0:18:19.93,0:18:21.85,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:22.82,0:18:24.38,Default,,0,0,0,,Менің жылауым соншалықты маңызды ма?
Dialogue: 0,0:18:24.87,0:18:25.46,Default,,0,0,0,,Иә
Dialogue: 0,0:18:27.90,0:18:28.82,Default,,0,0,0,,Жалықтырғыш
Dialogue: 0,0:18:29.69,0:18:30.42,Default,,0,0,0,,Шығу
Dialogue: 0,0:18:31.26,0:18:33.51,Default,,0,0,0,,Ум, сіз нені меңзеп тұрсыз...
Dialogue: 0,0:18:33.60,0:18:36.39,Default,,0,0,0,,Охире-чанды бұрынғыдан 10 есе көп бұраңыз
Dialogue: 0,0:18:37.72,0:18:39.65,Default,,0,0,0,,Оқшаулау туралы айтылмады ма?
Dialogue: 0,0:18:39.77,0:18:42.52,Default,,0,0,0,,Охире-чан, мен саған 10 есе артық төлесем кешіресің бе?
Dialogue: 0,0:18:42.76,0:18:43.74,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:18:44.02,0:18:45.33,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:45.33,0:18:46.80,Default,,0,0,0,,Оны бұрап алуға болады.
Dialogue: 0,0:18:47.39,0:18:48.48,Default,,0,0,0,,Узуко-сан
Dialogue: 0,0:18:48.91,0:18:50.50,Default,,0,0,0,,Сен малсың.
Dialogue: 0,0:18:50.92,0:18:53.49,Default,,0,0,0,,Ең дұрысы топ үшін азық ретінде әрекет етіңіз.
Dialogue: 0,0:18:54.31,0:18:56.49,Default,,0,0,0,,Аяқтаған соң, тез жоғалып кет.
Dialogue: 0,0:19:04.97,0:19:05.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:06.54,0:19:07.18,Default,,0,0,0,,Узуко-сан
Dialogue: 0,0:19:07.94,0:19:10.15,Default,,0,0,0,,Менің қызметшімді көруге келіңізші.
Dialogue: 0,0:19:11.00,0:19:14.95,Default,,0,0,0,,Мен әрқашан қожайынымның үйінде боламын.
Dialogue: 0,0:19:19.69,0:19:21.96,Default,,0,0,0,,Шошқаға кім барады?
Dialogue: 0,0:19:28.34,0:19:29.85,Default,,0,0,0,,Тыңдаңдар, шошқалар.
Dialogue: 0,0:19:30.40,0:19:32.28,Default,,0,0,0,,Маған жаңа ғана өкіл қоңырау шалды.
Dialogue: 0,0:19:32.28,0:19:34.54,Default,,0,0,0,,Сіз не істеп жатырсыз? Мені тез атып таста.
Dialogue: 0,0:19:34.54,0:19:36.20,Default,,0,0,0,,Бірақ... Бірақ мен қарусызмын.
Dialogue: 0,0:19:36.20,0:19:37.12,Default,,0,0,0,,Тіс
Dialogue: 0,0:19:37.31,0:19:38.88,Default,,0,0,0,,Ұрыс аяқталды.
Dialogue: 0,0:19:43.15,0:19:46.14,Default,,0,0,0,,Қалтамда тесік бар...
Dialogue: 0,0:19:48.79,0:19:49.23,Default,,0,0,0,,Эй
Dialogue: 0,0:19:49.45,0:19:50.87,Default,,0,0,0,,Ұрыс аяқталды.
Dialogue: 0,0:19:50.87,0:19:52.40,Default,,0,0,0,,Атпа Атпа
Dialogue: 0,0:19:58.73,0:19:59.69,Default,,0,0,0,,Шашқа байлау
Dialogue: 0,0:20:01.54,0:20:03.31,Default,,0,0,0,,Жаман болып қалды.
Dialogue: 0,0:20:04.32,0:20:07.23,Default,,0,0,0,,Ах, мен тағы да осындай нәрсені сатып аламын.
Dialogue: 0,0:20:08.07,0:20:08.93,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:12.47,0:20:13.29,Default,,0,0,0,,Нагоми
Dialogue: 0,0:20:13.29,0:20:14.17,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:20:15.07,0:20:15.68,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:20:16.14,0:20:17.30,Default,,0,0,0,,Сіз амансыз деп үміттенемін.
Dialogue: 0,0:20:17.49,0:20:19.48,Default,,0,0,0,,Біраз уақыттан кейін өлетін еді.
Dialogue: 0,0:20:19.48,0:20:20.54,Default,,0,0,0,,не болды?
Dialogue: 0,0:20:20.81,0:20:23.88,Default,,0,0,0,,Охире-чан, мен бұрынғыдан 10 есе көп кешірілдім.
Dialogue: 0,0:20:23.88,0:20:25.86,Default,,0,0,0,,10x Шынайы ма?
Dialogue: 0,0:20:25.86,0:20:27.62,Default,,0,0,0,,Мен ешқашан дұрыс бұралған емеспін.
Dialogue: 0,0:20:27.86,0:20:29.66,Default,,0,0,0,,Мен одан жақсы баға ала алмадым.
Dialogue: 0,0:20:29.66,0:20:30.71,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:20:30.71,0:20:32.92,Default,,0,0,0,,Өкіл шынымен қорқынышты болды.
Dialogue: 0,0:20:32.92,0:20:33.99,Default,,0,0,0,,Шамадан тыс сөздер айтпа
Dialogue: 0,0:20:34.29,0:20:35.52,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:20:36.09,0:20:36.68,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:20:38.94,0:20:41.40,Default,,0,0,0,,Шошқа қорасына қош келдіңіздер.
Dialogue: 0,0:20:43.53,0:20:44.92,Default,,0,0,0,,Мо
Dialogue: 0,0:20:57.80,0:20:59.40,Default,,0,0,0,,Мен қайсысын таңдауым керек?
Dialogue: 0,0:21:00.17,0:21:01.46,Default,,0,0,0,,Бұл да жақсы
Dialogue: 0,0:21:01.46,0:21:03.37,Default,,0,0,0,,Бірақ бұл да Арашико-санға жарасатын сияқты.
Dialogue: 0,0:21:05.27,0:21:06.25,Default,,0,0,0,,Сіз оны сатып аласыз ба?
Dialogue: 0,0:21:06.62,0:21:07.07,Default,,0,0,0,,Иә
Dialogue: 0,0:21:07.71,0:21:09.22,Default,,0,0,0,,Маған сыйлық беріңізші...
Dialogue: 0,0:21:11.54,0:21:13.67,Default,,0,0,0,,Бұл Арасикоға сәйкес келуі мүмкін
Dialogue: 0,0:21:16.23,0:21:16.98,Default,,0,0,0,,Арашико-сан?
Dialogue: 0,0:21:18.21,0:21:19.87,Default,,0,0,0,,Арашико-сан Арашико-сан
Dialogue: 0,0:21:20.12,0:21:22.30,Default,,0,0,0,,Арашико-сан Арашико-сан Арашико-сан
Dialogue: 0,0:21:24.65,0:21:25.23,Default,,0,0,0,,Мен ондай адамды білмеймін.
Dialogue: 0,0:21:25.93,0:21:27.49,Default,,0,0,0,,Біреу өтінемін
Dialogue: 0,0:21:27.59,0:21:29.89,Default,,0,0,0,,Жедел жәрдем Жедел жәрдем, өтінемін.
Dialogue: 0,0:21:29.89,0:21:32.36,Default,,0,0,0,,Өтінемін, жедел жәрдем шақырыңыз.
Dialogue: 0,0:21:36.50,0:21:37.25,Default,,0,0,0,,Арашико-сан?
Dialogue: 0,0:21:37.88,0:21:40.69,Default,,0,0,0,,Мен қызметші болғым келеді
Dialogue: 0,0:21:40.69,0:21:41.78,Default,,0,0,0,,Сөйлемеңіз
Dialogue: 0,0:21:42.45,0:21:44.49,Default,,0,0,0,,Сүйкімді қызметшіге...
Dialogue: 0,0:21:44.69,0:21:47.15,Default,,0,0,0,,Арашико-сан қазірдің өзінде тамаша қызметші.
Dialogue: 0,0:21:47.53,0:21:49.21,Default,,0,0,0,,Бұл менің құрметті қызметші қызым.
Dialogue: 0,0:21:50.18,0:21:56.81,Default,,0,0,0,,Мен бәрімен бірге қызметші болып жұмыс істегім келеді...
Dialogue: 0,0:22:06.00,0:22:07.10,Default,,0,0,0,,Арашико-сан?
Dialogue: 0,0:22:08.60,0:22:14.60,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
