Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,♪~
Dialogue: 0,0:01:35.06,0:01:42.03,Default,,0,0,0,,(♪ «G минорлы 1-баллада, Op. 23»)
Dialogue: 0,0:01:42.15,0:01:48.62,Default,,0,0,0,,♪~
Dialogue: 0,0:01:58.17,0:02:05.13,Default,,0,0,0,,♪~
Dialogue: 0,0:02:08.60,0:02:11.01,Default,,0,0,0,,Косей
Dialogue: 0,0:02:11.39,0:02:13.68,Default,,0,0,0,,Арима
Dialogue: 0,0:02:13.93,0:02:15.10,Default,,0,0,0,,Арима мырза
Dialogue: 0,0:02:15.52,0:02:16.64,Default,,0,0,0,,Косей
Dialogue: 0,0:02:18.35,0:02:19.90,Default,,0,0,0,,Барлығы қарап тұр—
Dialogue: 0,0:02:20.32,0:02:23.40,Default,,0,0,0,,Өмірімді байытқан адамдар—
Dialogue: 0,0:02:23.94,0:02:26.86,Default,,0,0,0,,Мені сахнаға қайта әкелген адамдар—
Dialogue: 0,0:02:27.53,0:02:32.45,Default,,0,0,0,,Барлығы қарап отыр; мен олардың үмітін ақтауға тиісмін—
Dialogue: 0,0:02:35.75,0:02:38.12,Default,,0,0,0,,Бұл — анам маған берген дыбыс—
Dialogue: 0,0:02:38.33,0:02:40.67,Default,,0,0,0,,Ватару маған түсінуге көмектескен дыбыс—
Dialogue: 0,0:02:41.67,0:02:43.71,Default,,0,0,0,,Цубаки мен үшін тапқан дыбыс—
Dialogue: 0,0:02:44.67,0:02:47.55,Default,,0,0,0,,Айза мен Игава мырзамен бәсекелесуден туған дыбыс—
Dialogue: 0,0:02:47.88,0:02:50.35,Default,,0,0,0,,Айза мырзамен бірге жасаған дыбыс—
Dialogue: 0,0:02:50.97,0:02:53.56,Default,,0,0,0,,Хироко еске салған дыбыс
Dialogue: 0,0:02:59.52,0:03:02.82,Default,,0,0,0,,Қорқамын… оны ести алмаймын…—
Dialogue: 0,0:03:04.19,0:03:05.86,Default,,0,0,0,,Ол соншалықты керемет пианист болса да—
Dialogue: 0,0:03:08.20,0:03:09.95,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:03:11.95,0:03:15.20,Default,,0,0,0,,Иә, дұрыс айтасың—
Dialogue: 0,0:03:15.37,0:03:19.58,Default,,0,0,0,,Зейін қоя тыңдасам, мен сан алуан дыбыстарға толып тұрмын—
Dialogue: 0,0:03:20.12,0:03:21.88,Default,,0,0,0,,Мен жалғыз емеспін—
Dialogue: 0,0:03:23.38,0:03:25.92,Default,,0,0,0,,Біреумен кездескен сәттен бастап—
Dialogue: 0,0:03:26.09,0:03:28.05,Default,,0,0,0,,Біз жалғыз қала алмаймыз—
Dialogue: 0,0:03:29.47,0:03:30.84,Default,,0,0,0,,Біз байланыстамыз
Dialogue: 0,0:03:41.40,0:03:48.36,Default,,0,0,0,,♪~
Dialogue: 0,0:04:02.63,0:04:05.63,Default,,0,0,0,,Мені жалғыз қалдырма!
Dialogue: 0,0:04:06.42,0:04:08.76,Default,,0,0,0,,Ақымақ, мен дәл қасыңда тұрмын—
Dialogue: 0,0:04:12.26,0:04:15.68,Default,,0,0,0,,Ішімде…
Dialogue: 0,0:04:17.60,0:04:19.23,Default,,0,0,0,,Сен осындасың!
Dialogue: 0,0:04:25.61,0:04:29.15,Default,,0,0,0,,♪~
Dialogue: 0,0:04:29.28,0:04:31.70,Default,,0,0,0,,(Косей) Мен сені жалғыз қалдырмаймын—
Dialogue: 0,0:04:31.95,0:04:33.87,Default,,0,0,0,,Қолыңды соз… Қолыңды соз…—
Dialogue: 0,0:04:34.45,0:04:39.91,Default,,0,0,0,,Бар болғанымды осыған құямын… Оған жетемін… Оған жетемін… Оған жетемін…—
Dialogue: 0,0:04:40.33,0:04:43.79,Default,,0,0,0,,Оған жетемін… Оған жетемін… Оған жетемін!
Dialogue: 0,0:04:54.26,0:04:56.47,Default,,0,0,0,,Бұл ауруды аяғымызбен ұрып тастайық—
Dialogue: 0,0:04:56.68,0:04:58.47,Default,,0,0,0,,Сосын, қайтадан бірге…—
Dialogue: 0,0:04:59.64,0:05:01.06,Default,,0,0,0,,Тек екеуміз…
Dialogue: 0,0:05:34.30,0:05:35.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:08.46,0:06:15.42,Default,,0,0,0,,♪~
Dialogue: 0,0:08:44.37,0:08:46.91,Default,,0,0,0,,Күт… Кетпе—
Dialogue: 0,0:08:47.37,0:08:49.25,Default,,0,0,0,,(♪ «G минорлы 1-баллада, Op. 23»)
Dialogue: 0,0:08:49.37,0:08:54.17,Default,,0,0,0,,Арима
Dialogue: 0,0:08:55.84,0:08:59.76,Default,,0,0,0,,Арима мырза
Dialogue: 0,0:08:59.96,0:09:01.63,Default,,0,0,0,,Барлығы қарап тұр—
Dialogue: 0,0:09:01.76,0:09:08.72,Default,,0,0,0,,♪~
Dialogue: 0,0:10:41.36,0:10:42.82,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:10:49.91,0:10:52.99,Default,,0,0,0,,Өмірімді байытқан адамдар—
Dialogue: 0,0:10:54.62,0:10:55.91,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:10:56.16,0:10:58.46,Default,,0,0,0,,Мені сахнаға қайта әкелген адамдар—
Dialogue: 0,0:11:01.59,0:11:02.67,Default,,0,0,0,,Ах
Dialogue: 0,0:11:12.39,0:11:13.60,Default,,0,0,0,,Барлығы қарап отыр; мен олардың үмітін ақтауға тиісмін—
Dialogue: 0,0:11:14.68,0:11:16.56,Default,,0,0,0,,Бұл — анам маған берген дыбыс—
Dialogue: 0,0:11:44.13,0:11:47.42,Default,,0,0,0,,Ватару маған түсінуге көмектескен дыбыс—
Dialogue: 0,0:11:47.80,0:11:50.34,Default,,0,0,0,,Цубаки мен үшін тапқан дыбыс—
Dialogue: 0,0:11:50.47,0:11:52.09,Default,,0,0,0,,Айза мен Игава мырзамен бәсекелесуден туған дыбыс—
Dialogue: 0,0:11:53.22,0:11:54.72,Default,,0,0,0,,Айза мырзамен бірге жасаған дыбыс—
Dialogue: 0,0:11:55.43,0:11:58.35,Default,,0,0,0,,Хироко еске салған дыбыс
Dialogue: 0,0:11:59.69,0:12:03.15,Default,,0,0,0,,Қорқамын… оны ести алмаймын…—
Dialogue: 0,0:12:03.40,0:12:06.73,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:12:07.48,0:12:09.74,Default,,0,0,0,,Иә, дұрыс айтасың—
Dialogue: 0,0:12:09.90,0:12:13.16,Default,,0,0,0,,Зейін қоя тыңдасам, мен сан алуан дыбыстарға толып тұрмын—
Dialogue: 0,0:12:13.28,0:12:17.29,Default,,0,0,0,,Мен жалғыз емеспін—
Dialogue: 0,0:12:18.12,0:12:20.29,Default,,0,0,0,,Біреумен кездескен сәттен бастап—
Dialogue: 0,0:12:21.29,0:12:24.59,Default,,0,0,0,,Біз жалғыз қала алмаймыз—
