Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.64,Default,,0,0,0,,Әй, тезірек барайық!
Dialogue: 0,0:00:14.98,0:00:16.77,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:00:17.27,0:00:20.99,Default,,0,0,0,,Енді Бодж мырзаны жүргізуші куәлігін алуымен құттықтаймыз.
Dialogue: 0,0:00:21.57,0:00:24.16,Default,,0,0,0,,Дәмді тағамдарды көп жеу
Dialogue: 0,0:00:24.24,0:00:24.82,Default,,0,0,0,,Ах! О!
Dialogue: 0,0:00:25.74,0:00:26.24,Default,,0,0,0,,Ах
Dialogue: 0,0:00:26.82,0:00:30.70,Default,,0,0,0,,Бо... Бодж Бұл қылыш!
Dialogue: 0,0:00:31.66,0:00:32.62,Default,,0,0,0,,Хмф!
Dialogue: 0,0:00:33.21,0:00:36.04,Default,,0,0,0,,Бірақ бұл өте үлкен.
Dialogue: 0,0:00:36.13,0:00:38.17,Default,,0,0,0,,Бодж шынымен де солай жасады ма?
Dialogue: 0,0:00:39.88,0:00:42.38,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:00:46.01,0:00:47.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:49.06,0:00:50.72,Default,,0,0,0,,О~
Dialogue: 0,0:00:50.81,0:00:51.43,Default,,0,0,0,,О...
Dialogue: 0,0:00:53.27,0:00:53.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:54.48,0:00:56.94,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:00:57.98,0:01:00.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:02.49,0:01:04.49,Default,,0,0,0,,♪~
Dialogue: 0,0:02:28.49,0:02:30.49,Default,,0,0,0,,~♪
Dialogue: 0,0:02:32.95,0:02:35.74,Default,,0,0,0,,Не... Бұл ине сияқты?
Dialogue: 0,0:02:35.83,0:02:37.16,Default,,0,0,0,,Мен... Бұл жалған!
Dialogue: 0,0:02:37.25,0:02:38.75,Default,,0,0,0,,Тіпті осылай өтірік айту
Dialogue: 0,0:02:38.83,0:02:42.04,Default,,0,0,0,,Сен күшейіп кетсең де, мені алдамақшы болғаның жиіркенішті!
Dialogue: 0,0:02:42.13,0:02:44.50,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:02:44.59,0:02:47.13,Default,,0,0,0,,Бұл жалған немесе өтірік емес.
Dialogue: 0,0:02:47.21,0:02:49.97,Default,,0,0,0,,Бұл «блеф» деп аталады.
Dialogue: 0,0:02:50.05,0:02:52.18,Default,,0,0,0,,Хафф... Хафф?
Dialogue: 0,0:02:52.26,0:02:55.64,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:03:03.02,0:03:04.15,Default,,0,0,0,,Бодж мырза
Dialogue: 0,0:03:04.23,0:03:06.94,Default,,0,0,0,,Өзіңе төмен қарау
Dialogue: 0,0:03:07.03,0:03:08.86,Default,,0,0,0,,Алда он мың рет
Dialogue: 0,0:03:09.70,0:03:13.07,Default,,0,0,0,,Сіз өзіңізге күмәнданып, әр жолы төмен қарайсыз ба?
Dialogue: 0,0:03:15.66,0:03:16.99,Default,,0,0,0,,Жоқ, жоқ, жоқ...
Dialogue: 0,0:03:17.08,0:03:20.08,Default,,0,0,0,,Сіз жақсы көрінетін нәрсені айтып тұрсыз, бірақ бұл дұрыс емес.
Dialogue: 0,0:03:20.58,0:03:23.88,Default,,0,0,0,,Ал Каге-кун, уайымдама.
Dialogue: 0,0:03:23.96,0:03:26.55,Default,,0,0,0,,Бодже-кунның шеберлігі сөзсіз.
Dialogue: 0,0:03:28.71,0:03:29.67,Default,,0,0,0,,Және...
Dialogue: 0,0:03:29.76,0:03:32.55,Default,,0,0,0,,Күмәндансаңыз не істейсіз?
Dialogue: 0,0:03:32.64,0:03:33.64,Default,,0,0,0,,Уф
Dialogue: 0,0:03:35.43,0:03:36.85,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:03:37.43,0:03:38.81,Default,,0,0,0,,О, құдайым
Dialogue: 0,0:03:39.48,0:03:42.52,Default,,0,0,0,,Бодж Саған күмәнданғаны үшін менің кінәм болды.
Dialogue: 0,0:03:45.94,0:03:46.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:49.53,0:03:52.61,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:03:53.95,0:03:54.78,Default,,0,0,0,,Хун
Dialogue: 0,0:04:01.54,0:04:02.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:02.58,0:04:04.29,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:04:04.38,0:04:05.54,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:05.63,0:04:09.00,Default,,0,0,0,,Қызық, сен шынымен де инедей қылышпен соғыса аласың ба?
Dialogue: 0,0:04:09.09,0:04:10.42,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:04:10.51,0:04:14.72,Default,,0,0,0,,Менің теориям Бодж жеңілмейтін.
Dialogue: 0,0:04:14.80,0:04:16.26,Default,,0,0,0,,Теория~
Dialogue: 0,0:04:16.35,0:04:18.47,Default,,0,0,0,,Жеңілмейтін~
Dialogue: 0,0:04:18.56,0:04:19.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:19.31,0:04:24.69,Default,,0,0,0,,Енді, Бодж-кунның Desper Secret Technique трансферін атап өтейік...
Dialogue: 0,0:04:26.94,0:04:28.40,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:04:28.48,0:04:29.82,Default,,0,0,0,,Ой, мен қатты толқып тұрмын
Dialogue: 0,0:04:29.90,0:04:31.90,Default,,0,0,0,,Деспер құпия техникасы?
Dialogue: 0,0:04:32.70,0:04:34.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:35.74,0:04:37.57,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:04:37.66,0:04:41.79,Default,,0,0,0,,Балалар, өткен күні менімен ұрысып қалдыңдар...
Dialogue: 0,0:04:43.66,0:04:46.50,Default,,0,0,0,,Пуха~цу үлкен ұлы Аван
Dialogue: 0,0:04:46.58,0:04:48.38,Default,,0,0,0,,Екінші ұлы Лейн
Dialogue: 0,0:04:48.46,0:04:50.09,Default,,0,0,0,,Үшінші ұлы Сүйек
Dialogue: 0,0:04:51.42,0:04:54.68,Default,,0,0,0,,Бағынбайтын үш ағайынды Аван!
Dialogue: 0,0:04:56.22,0:04:58.60,Default,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:04:58.68,0:05:00.93,Default,,0,0,0,,Ол менің қылыштанатын шәкіртім.
Dialogue: 0,0:05:01.02,0:05:04.18,Default,,0,0,0,,Қылыш шеберлігі? (Туған) Шәкірт пе?
Dialogue: 0,0:05:04.27,0:05:06.56,Default,,0,0,0,,Бұл дик туралы не деуге болады?
Dialogue: 0,0:05:06.65,0:05:07.65,Default,,0,0,0,,(Ағайынды үш адамның күлкісі)
Dialogue: 0,0:05:07.73,0:05:09.65,Default,,0,0,0,,Чи... Чинчикурин?
Dialogue: 0,0:05:09.73,0:05:12.69,Default,,0,0,0,,Не? Сен ашулысың ба?
Dialogue: 0,0:05:13.19,0:05:16.07,Default,,0,0,0,,Ал, жай ғана ағып кетіңіз.
Dialogue: 0,0:05:16.82,0:05:19.78,Default,,0,0,0,,Деспер мырза, сіз өте сабырлысыз.
Dialogue: 0,0:05:19.87,0:05:21.79,Default,,0,0,0,,Тіпті Бодж...
Dialogue: 0,0:05:21.87,0:05:24.75,Default,,0,0,0,,Басқа адаммен қарым-қатынас жасамау ересек адамның жауабы ма?
Dialogue: 0,0:05:26.67,0:05:28.58,Default,,0,0,0,,Жарайды, мен де.
Dialogue: 0,0:05:30.21,0:05:32.46,Default,,0,0,0,,Осындай оғаш адамның шәкірт екеніне сене алар емеспін.
Dialogue: 0,0:05:33.17,0:05:36.09,Default,,0,0,0,,Түйе жүзді сізге жарасады.
Dialogue: 0,0:05:36.18,0:05:39.39,Default,,0,0,0,,(Ағайынды үш адамның күлкісі)
Dialogue: 0,0:05:40.64,0:05:42.47,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:05:42.56,0:05:44.14,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:05:47.19,0:05:49.23,Default,,0,0,0,,Иә! Деспер мырза?
Dialogue: 0,0:05:49.90,0:05:54.53,Default,,0,0,0,,Шәкіртімнің жаман сөзін кешіремін, бірақ өзімді кешірмеймін!
Dialogue: 0,0:05:54.61,0:05:55.49,Default,,0,0,0,,Бұл керісінше!
Dialogue: 0,0:05:56.07,0:05:58.36,Default,,0,0,0,,О... сен істедің.
Dialogue: 0,0:05:58.45,0:05:59.45,Default,,0,0,0,,Кел!
Dialogue: 0,0:06:09.54,0:06:10.79,Default,,0,0,0,,Хмф! (Сүйек) Эй!
Dialogue: 0,0:06:11.71,0:06:13.88,Default,,0,0,0,,Уау, өте әлсіз!
Dialogue: 0,0:06:15.09,0:06:16.34,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:06:16.42,0:06:17.38,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:20.43,0:06:21.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:22.43,0:06:23.72,Default,,0,0,0,,Кя~!
Dialogue: 0,0:06:24.31,0:06:26.02,Default,,0,0,0,,Бодж! иә?
Dialogue: 0,0:06:28.35,0:06:29.39,Default,,0,0,0,,О...
Dialogue: 0,0:06:29.90,0:06:32.48,Default,,0,0,0,,Бодж, сен таңқаларлықтай қаталсың.
Dialogue: 0,0:06:35.48,0:06:36.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:36.74,0:06:39.99,Default,,0,0,0,,Не? Менімен бірге жасайсың ба?
Dialogue: 0,0:06:41.03,0:06:43.66,Default,,0,0,0,,Бодж Жалаң қолды пайдалана алмайсың! Қылышты ал!
Dialogue: 0,0:06:43.74,0:06:46.79,Default,,0,0,0,,Жоқ, тіпті қылыш қолданудың қажеті жоқ.
Dialogue: 0,0:06:46.87,0:06:47.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:47.45,0:06:49.83,Default,,0,0,0,,Егер сіз Бодж мырза болсаңыз, мен сізді жалаң қолыммен жеңемін.
Dialogue: 0,0:06:49.92,0:06:52.67,Default,,0,0,0,,Деспер мырза? Басыңды ұрдың ба?
Dialogue: 0,0:06:52.75,0:06:54.29,Default,,0,0,0,,Қараңдаршы.
Dialogue: 0,0:06:55.13,0:06:58.30,Default,,0,0,0,,Мына мүшесі соншалықты ұятсыз!
Dialogue: 0,0:06:58.38,0:06:59.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:00.43,0:07:01.18,Default,,0,0,0,,(Петин!)
Dialogue: 0,0:07:05.10,0:07:05.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:07.31,0:07:08.60,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:09.10,0:07:11.56,Default,,0,0,0,,Жоқ, мұндай соққы...
Dialogue: 0,0:07:11.65,0:07:13.40,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:13.48,0:07:15.36,Default,,0,0,0,,Не? Күлесің бе?
Dialogue: 0,0:07:16.02,0:07:18.32,Default,,0,0,0,,Бодждың соққысына күлесің бе?
Dialogue: 0,0:07:19.86,0:07:23.70,Default,,0,0,0,,О? Ой, йоййо, барасың...
Dialogue: 0,0:07:24.95,0:07:25.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:25.66,0:07:28.29,Default,,0,0,0,,(Қонақтар айқайлайды)
Dialogue: 0,0:07:28.37,0:07:29.54,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:07:29.62,0:07:31.00,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:07:31.08,0:07:33.21,Default,,0,0,0,,Эй, сен не істедің?
Dialogue: 0,0:07:36.13,0:07:37.17,Default,,0,0,0,,Не?
Dialogue: 0,0:07:37.25,0:07:40.55,Default,,0,0,0,,Біздің әртүрлі осал тұстарымыз бар.
Dialogue: 0,0:07:40.63,0:07:42.76,Default,,0,0,0,,Мына жігіт~ (Сүйек) Эй!
Dialogue: 0,0:07:50.52,0:07:54.40,Default,,0,0,0,,Иек тербелуі Басты шайқаудың ең тиімді жолы
Dialogue: 0,0:07:54.48,0:07:56.69,Default,,0,0,0,,Бұл мидың шайқалуына әкелуі мүмкін.
Dialogue: 0,0:07:56.77,0:07:58.03,Default,,0,0,0,,Мидың шайқалуы?
Dialogue: 0,0:07:58.69,0:08:00.82,Default,,0,0,0,,Сізге шабуыл жасайтын күшті пайдалану
Dialogue: 0,0:08:00.90,0:08:04.99,Default,,0,0,0,,Сіз өзіңіздің әлсіздігіңізді жасыра отырып, әлсіз жерлерді дәл тигізе аласыз.
Dialogue: 0,0:08:05.95,0:08:08.37,Default,,0,0,0,,Бодж мырзаның кереметі осындай.
Dialogue: 0,0:08:09.58,0:08:13.25,Default,,0,0,0,,Мистер Деспер, сізге күмәндануыма менің кінәм болды!
Dialogue: 0,0:08:13.33,0:08:15.79,Default,,0,0,0,,Енді ешқашан күмәнданба
Dialogue: 0,0:08:15.88,0:08:16.67,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:17.25,0:08:20.38,Default,,0,0,0,,Сен бейбақ... біртүрлі нәрсе істедің.
Dialogue: 0,0:08:20.46,0:08:21.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:21.30,0:08:23.59,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:08:24.51,0:08:26.76,Default,,0,0,0,,Қолында қару болуы дегенді білдіреді
Dialogue: 0,0:08:26.85,0:08:30.89,Default,,0,0,0,,Сіздің өзіңізді өлтіруге дайын екеніңізді түсінгенім дұрыс па?
Dialogue: 0,0:08:30.97,0:08:32.14,Default,,0,0,0,,Не?
Dialogue: 0,0:08:36.73,0:08:37.40,Default,,0,0,0,,Бодж мырза!
Dialogue: 0,0:08:39.44,0:08:40.82,Default,,0,0,0,,Қылыш тартылды!
Dialogue: 0,0:08:46.62,0:08:49.12,Default,,0,0,0,,Қарғыс атсын... бейбақ!
Dialogue: 0,0:08:53.96,0:08:54.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:56.38,0:08:57.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:58.88,0:08:59.96,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:04.97,0:09:06.51,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:09:07.97,0:09:11.64,Default,,0,0,0,,Ах! Мен... мен оны өлтірдім.
Dialogue: 0,0:09:19.65,0:09:22.94,Default,,0,0,0,,Жақсы жұмыс, ес-түссіз жатқаның анық.
Dialogue: 0,0:09:25.74,0:09:27.45,Default,,0,0,0,,Есінен танып қалды ма?
Dialogue: 0,0:09:28.45,0:09:30.99,Default,,0,0,0,,Балалар сендерді үйге апарыңдар.
Dialogue: 0,0:09:34.08,0:09:36.71,Default,,0,0,0,,Деспер мырза, Бодж нақты не істеп жатыр?
Dialogue: 0,0:09:37.42,0:09:39.79,Default,,0,0,0,,Хмм, түсіндірейін.
Dialogue: 0,0:09:41.46,0:09:42.50,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:42.59,0:09:44.51,Default,,0,0,0,,Не, не істеп жатырсың?
Dialogue: 0,0:09:45.01,0:09:45.67,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:46.17,0:09:50.14,Default,,0,0,0,,Бұл ауырсынуды сезінетін «ауыру нүктесі» болғандықтан.
Dialogue: 0,0:09:50.22,0:09:51.26,Default,,0,0,0,,Цуутен?
Dialogue: 0,0:09:51.76,0:09:53.56,Default,,0,0,0,,Сонымен... бұл туралы не деуге болады?
Dialogue: 0,0:09:54.93,0:09:56.02,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:09:56.60,0:09:58.35,Default,,0,0,0,,Арх!
Dialogue: 0,0:09:58.44,0:10:00.94,Default,,0,0,0,,Де... Дедеде... Деспер мырза!
Dialogue: 0,0:10:01.02,0:10:03.23,Default,,0,0,0,,Жарайды, иә?
Dialogue: 0,0:10:04.19,0:10:07.70,Default,,0,0,0,,Ауырған жерді соқпасаң, ауыртпайсың.
Dialogue: 0,0:10:07.78,0:10:09.74,Default,,0,0,0,,Сондай-ақ қан тамырларынан аулақ болады.
Dialogue: 0,0:10:10.32,0:10:12.70,Default,,0,0,0,,Уф... бұл жиіркенішті.
Dialogue: 0,0:10:13.49,0:10:16.50,Default,,0,0,0,,Тірі заттар жұмбақ заттар.
Dialogue: 0,0:10:16.58,0:10:21.13,Default,,0,0,0,,Бодж мырза қарсыласын есінен танып қалу үшін осы таңғажайыпты пайдаланады.
Dialogue: 0,0:10:21.21,0:10:25.13,Default,,0,0,0,,Естен тану үшін ми кідіруі керек.
Dialogue: 0,0:10:25.21,0:10:25.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:25.88,0:10:28.13,Default,,0,0,0,,Тоқтату
Dialogue: 0,0:10:28.22,0:10:30.55,Default,,0,0,0,,Тек миға қан ағымын тоқтатыңыз
Dialogue: 0,0:10:31.05,0:10:34.60,Default,,0,0,0,,Бодждың инелі қылышы маңызды мүшелерден аулақ болады.
Dialogue: 0,0:10:34.68,0:10:39.23,Default,,0,0,0,,Тікелей жүйкені қоздырады және қан тамырларын кеңейтеді
Dialogue: 0,0:10:39.31,0:10:43.02,Default,,0,0,0,,Сондықтан қан ағымын миға дейін итеруге болмайды.
Dialogue: 0,0:10:43.11,0:10:44.27,Default,,0,0,0,,Синкопқа әкеледі
Dialogue: 0,0:10:44.36,0:10:46.23,Default,,0,0,0,,А... иә?
Dialogue: 0,0:10:46.32,0:10:48.32,Default,,0,0,0,,Қысқасы, Бодж мырза
Dialogue: 0,0:10:48.40,0:10:52.20,Default,,0,0,0,,Бұл сіздің қарсыласыңызды еш зиянсыз жеңе алатыныңызды білдіреді.
Dialogue: 0,0:10:52.28,0:10:55.04,Default,,0,0,0,,Уа... бұл керемет!
Dialogue: 0,0:10:55.12,0:10:58.75,Default,,0,0,0,,Бұл таңқаларлық, Бодж. Бұл Бодждың қылышы!
Dialogue: 0,0:11:00.33,0:11:01.58,Default,,0,0,0,,Және солай
Dialogue: 0,0:11:01.67,0:11:05.46,Default,,0,0,0,,Екінші жағынан, Бодж мырза әрқашан оңай.
Dialogue: 0,0:11:05.55,0:11:08.17,Default,,0,0,0,,Біреудің өмірін қиюға қабілетті болу
Dialogue: 0,0:11:09.38,0:11:11.13,Default,,0,0,0,,Уф Бодж...
Dialogue: 0,0:11:11.72,0:11:14.81,Default,,0,0,0,,Сіз күшейіп кеттіңіз, солай емес пе? Жақсы болды, солай ма?
Dialogue: 0,0:11:16.22,0:11:17.68,Default,,0,0,0,,Жоқ, солай ма?
Dialogue: 0,0:11:17.77,0:11:20.98,Default,,0,0,0,,Каге-кун, сен шынымен қандай күш іздедің?
Dialogue: 0,0:11:21.06,0:11:21.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:21.69,0:11:26.19,Default,,0,0,0,,Іздегеніңіз біреуді қорғай алатын ұлы күш еді.
Dialogue: 0,0:11:27.11,0:11:30.53,Default,,0,0,0,,Патша қылышы әлсізге көмектеседі, күштіге тосқауыл қояды.
Dialogue: 0,0:11:31.53,0:11:34.16,Default,,0,0,0,,Күш деген осы емес пе?
Dialogue: 0,0:11:34.24,0:11:36.54,Default,,0,0,0,,Дұрыс! Бұл дұрыс!
Dialogue: 0,0:11:37.04,0:11:40.04,Default,,0,0,0,,Бірақ адамның жүрегі әлсіз...
Dialogue: 0,0:11:40.54,0:11:41.29,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:11:41.96,0:11:44.13,Default,,0,0,0,,Бодж, бәрі жақсы болады.
Dialogue: 0,0:11:44.21,0:11:47.13,Default,,0,0,0,,Алдымен біз сізге қалай дайындалу керектігін үйретеміз.
Dialogue: 0,0:11:47.21,0:11:50.38,Default,,0,0,0,,Бодже мырза, қылыш шебердің білімі!
Dialogue: 0,0:11:50.47,0:11:51.47,Default,,0,0,0,,Бір!
Dialogue: 0,0:11:51.55,0:11:52.76,Default,,0,0,0,,А-а-а-а!
Dialogue: 0,0:11:52.84,0:11:54.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:54.09,0:11:55.22,Default,,0,0,0,,Екі!
Dialogue: 0,0:11:55.30,0:11:56.85,Default,,0,0,0,,А-а-а-а!
Dialogue: 0,0:11:57.43,0:11:58.47,Default,,0,0,0,,Үш!
Dialogue: 0,0:11:58.56,0:12:00.60,Default,,0,0,0,,А, аа!
Dialogue: 0,0:12:00.68,0:12:03.98,Default,,0,0,0,,Мм! оларды ешқашан ұмытпа
Dialogue: 0,0:12:04.06,0:12:04.86,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:05.36,0:12:06.19,Default,,0,0,0,,Иә
Dialogue: 0,0:12:06.27,0:12:09.82,Default,,0,0,0,,Ух... тамаша, тамаша Бодж.
Dialogue: 0,0:12:09.90,0:12:12.32,Default,,0,0,0,,Уау, Деспер мырза!
Dialogue: 0,0:12:12.40,0:12:14.66,Default,,0,0,0,,Не? (Тұтынушы) Келіңіздер...
Dialogue: 0,0:12:15.32,0:12:19.62,Default,,0,0,0,,Ең бастысы, Бодж мырзаның жүрегі басынан бері жақсы болды.
Dialogue: 0,0:12:19.70,0:12:21.71,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:12:21.79,0:12:23.42,Default,,0,0,0,,Бодж керемет.
Dialogue: 0,0:12:23.50,0:12:24.71,Default,,0,0,0,,ау
Dialogue: 0,0:12:25.21,0:12:28.42,Default,,0,0,0,,Осы білімді мықтап есте сақтау арқылы,
Dialogue: 0,0:12:28.50,0:12:32.55,Default,,0,0,0,,Дағдыларыңыз одан да артып, денеңіз бен ақыл-ойыңыз күшейеді.
Dialogue: 0,0:12:32.63,0:12:33.63,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:33.72,0:12:37.39,Default,,0,0,0,,Ал сіздің өміріңіз жарқын және қызықты болады.
Dialogue: 0,0:12:37.89,0:12:38.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:38.93,0:12:40.31,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:12:40.39,0:12:42.43,Default,,0,0,0,,Рахмет! Айаааааа!
Dialogue: 0,0:12:43.64,0:12:46.40,Default,,0,0,0,,Тамақ жейміз бе?
Dialogue: 0,0:12:49.90,0:12:52.86,Default,,0,0,0,,Ах~ мен жедім, жедім
Dialogue: 0,0:12:52.94,0:12:54.03,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:54.53,0:12:56.95,Default,,0,0,0,,Менің есіме бір нәрсе түсті.
Dialogue: 0,0:12:57.03,0:12:59.20,Default,,0,0,0,,Балалар, алдымен үйге баруларың керек.
Dialogue: 0,0:12:59.28,0:13:01.33,Default,,0,0,0,,Иә? О
Dialogue: 0,0:13:20.35,0:13:21.85,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:30.73,0:13:32.07,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:13:33.07,0:13:35.40,Default,,0,0,0,,Жоқ, жоқ, бұл оңай
Dialogue: 0,0:13:35.99,0:13:36.82,Default,,0,0,0,,Демалу
Dialogue: 0,0:13:37.32,0:13:37.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:38.45,0:13:41.99,Default,,0,0,0,,Бұл әрекет болса да, мен оның бетінен екі рет ұрдым...
Dialogue: 0,0:13:42.08,0:13:45.79,Default,,0,0,0,,Жоқ, мен соны сұрадым.
Dialogue: 0,0:13:45.87,0:13:48.96,Default,,0,0,0,,Сіздің арқаңызда мен Боджды іс-әрекетте көрдім.
Dialogue: 0,0:13:50.38,0:13:51.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:52.38,0:13:53.80,Default,,0,0,0,,Қабылданбайды!
Dialogue: 0,0:13:53.88,0:13:56.30,Default,,0,0,0,,О, шынымен бе? Хехе
Dialogue: 0,0:13:57.13,0:13:59.18,Default,,0,0,0,,Деспер мырза (Үмітсіздік) Иә?
Dialogue: 0,0:13:59.26,0:14:01.68,Default,,0,0,0,,Мен ойлағаннан артық ештеңе істей алмадым.
Dialogue: 0,0:14:02.18,0:14:02.89,Default,,0,0,0,,Иә
Dialogue: 0,0:14:03.68,0:14:05.23,Default,,0,0,0,,Қылыш ұстаған сәт
Dialogue: 0,0:14:05.31,0:14:08.35,Default,,0,0,0,,Мен мұны жеңе алмайтынымды бірден білдім.
Dialogue: 0,0:14:08.98,0:14:11.65,Default,,0,0,0,,Үйге келгенде арнайы дайындықтан өтесіз.
Dialogue: 0,0:14:11.73,0:14:12.44,Default,,0,0,0,,Не!
Dialogue: 0,0:14:12.52,0:14:14.86,Default,,0,0,0,,Мені кешіріңіз, капитан.
Dialogue: 0,0:14:14.94,0:14:17.32,Default,,0,0,0,,Хахаха (Үмітсіздік) Хэхехе
Dialogue: 0,0:14:17.82,0:14:19.91,Default,,0,0,0,,Бірақ Бодждың қабілеті
Dialogue: 0,0:14:19.99,0:14:21.53,Default,,0,0,0,,Бұлай емес.
Dialogue: 0,0:14:21.62,0:14:22.16,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:14:22.24,0:14:26.04,Default,,0,0,0,,Одан да таңғажайып дағдыларды меңгерді.
Dialogue: 0,0:14:26.96,0:14:31.50,Default,,0,0,0,,Ал, мен оны жиі көрсетемін деп ойламаймын.
Dialogue: 0,0:14:35.46,0:14:37.59,Default,,0,0,0,,Бодж Ойланып көріңізші.
Dialogue: 0,0:14:38.30,0:14:41.85,Default,,0,0,0,,Деспер-сан маған қарсыластың әлсіз жақтарын қалай пайдалану керектігін үйретті.
Dialogue: 0,0:14:42.43,0:14:46.14,Default,,0,0,0,,Сіз бұл жылдамдыққа қалай ие болдыңыз?
Dialogue: 0,0:14:48.81,0:14:51.48,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:14:51.56,0:14:54.73,Default,,0,0,0,,Не, Мицумата - бұл үлкен жылан?
Dialogue: 0,0:14:54.82,0:14:55.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:05.91,0:15:07.33,Default,,0,0,0,,(қауіпті дыбыс)
Dialogue: 0,0:15:14.46,0:15:16.46,Default,,0,0,0,,Жарайсыз, Бодж мырза.
Dialogue: 0,0:15:17.55,0:15:19.47,Default,,0,0,0,,Бірақ әлі көп жол бар.
Dialogue: 0,0:15:21.34,0:15:23.30,Default,,0,0,0,,Әлі де көзге сүйенеді
Dialogue: 0,0:15:23.89,0:15:25.68,Default,,0,0,0,,Сезімдерін ұштау
Dialogue: 0,0:15:27.81,0:15:32.52,Default,,0,0,0,,Ал ауаның қозғалысын теріңізбен сезініңіз.
Dialogue: 0,0:15:33.02,0:15:35.73,Default,,0,0,0,,Жалтаруға қабілетті болуы керек
Dialogue: 0,0:15:36.40,0:15:37.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:40.20,0:15:41.99,Default,,0,0,0,,Құлып қалай орналасқан?
Dialogue: 0,0:15:42.07,0:15:46.16,Default,,0,0,0,,Лорд Хиллингке жер асты әлемінен келген құбыжық шабуыл жасады.
Dialogue: 0,0:15:46.66,0:15:49.54,Default,,0,0,0,,Лорд Друси өзінің құрбандығымен қорғалды.
Dialogue: 0,0:15:49.62,0:15:53.08,Default,,0,0,0,,Осыдан кейін айна жер асты әлеміне бет алған сияқты.
Dialogue: 0,0:15:53.96,0:15:56.04,Default,,0,0,0,,Босс мырза үшін қозғалыс жоқ.
Dialogue: 0,0:15:56.63,0:16:01.55,Default,,0,0,0,,Ал жер асты әлемінің қақпасын лорд Апис күзетеді.
Dialogue: 0,0:16:02.22,0:16:03.55,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:04.68,0:16:06.85,Default,,0,0,0,,Мен мұны жалғыз істей алмаймын ...
Dialogue: 0,0:16:06.93,0:16:09.22,Default,,0,0,0,,Біз осында емеспіз бе?
Dialogue: 0,0:16:09.31,0:16:12.52,Default,,0,0,0,,Хахахаха мен жылан аулаушымын.
Dialogue: 0,0:16:12.60,0:16:15.48,Default,,0,0,0,,Балалар сендер сондай сүйкімдісіңдер, мен көмектесе алмаймын
Dialogue: 0,0:16:15.56,0:16:17.57,Default,,0,0,0,,Ұрысты тоқтатыңыз.
Dialogue: 0,0:16:19.03,0:16:23.07,Default,,0,0,0,,Мистер Бевин, егер сіз үшін болса...
Dialogue: 0,0:16:23.57,0:16:24.86,Default,,0,0,0,,Бодж мырза ше?
Dialogue: 0,0:16:24.95,0:16:26.07,Default,,0,0,0,,Иә
Dialogue: 0,0:16:26.16,0:16:29.74,Default,,0,0,0,,Жаттығуды аяқтағаннан кейін ол әлдеқайда күшті болды.
Dialogue: 0,0:16:29.83,0:16:30.83,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:16:31.45,0:16:33.67,Default,,0,0,0,,Деспер-самадан күткендей.
Dialogue: 0,0:16:33.75,0:16:35.79,Default,,0,0,0,,Иә шынымен
Dialogue: 0,0:16:38.59,0:16:41.51,Default,,0,0,0,,Түсіндім, Бодж мырза...
Dialogue: 0,0:16:45.34,0:16:47.14,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:16:47.22,0:16:48.43,Default,,0,0,0,,Бевин мырза
Dialogue: 0,0:16:50.64,0:16:54.31,Default,,0,0,0,,Мен Мастер Бодж сенің жанашырың екенін білемін, бірақ
Dialogue: 0,0:16:54.39,0:16:58.23,Default,,0,0,0,,Менің ойымша, Дайда-сама патша болуға лайықтырақ.
Dialogue: 0,0:16:58.73,0:17:00.78,Default,,0,0,0,,Сіз Мастер Боджды жаттықтырдыңыз.
Dialogue: 0,0:17:00.86,0:17:04.45,Default,,0,0,0,,Адамдарды ерін қимылдарын оқуды үйрету
Dialogue: 0,0:17:04.53,0:17:06.49,Default,,0,0,0,,Өте қызық емес
Dialogue: 0,0:17:07.20,0:17:09.33,Default,,0,0,0,,Шынында да, Бодж мырза
Dialogue: 0,0:17:09.41,0:17:11.83,Default,,0,0,0,,Бұл патшаның сауыты болмауы мүмкін.
Dialogue: 0,0:17:12.70,0:17:15.37,Default,,0,0,0,,Бірақ сол адам есейсе
Dialogue: 0,0:17:15.46,0:17:18.59,Default,,0,0,0,,Болашақта көптеген адамдарды құтқаратынына сенімдімін.
Dialogue: 0,0:17:18.67,0:17:22.42,Default,,0,0,0,,Бұл Дайда-самадан ерекшелік емес.
Dialogue: 0,0:17:22.92,0:17:24.76,Default,,0,0,0,,Бодж-сама, Дайда-сама?
Dialogue: 0,0:17:24.84,0:17:29.47,Default,,0,0,0,,Хахахахаха Бұл пайғамбарлық па? Бұл жабайы интуиция ма?
Dialogue: 0,0:17:30.51,0:17:31.81,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:17:31.89,0:17:35.27,Default,,0,0,0,,Мені солай сезінеді.
Dialogue: 0,0:17:40.15,0:17:44.32,Default,,0,0,0,,Патшаның жеңіспен оралуы... Бәлкім, солай болар.
Dialogue: 0,0:17:49.41,0:17:51.99,Default,,0,0,0,,Мицумат мені жаттықтырды.
Dialogue: 0,0:17:52.49,0:17:54.58,Default,,0,0,0,,Мұны Бевин де білетініне сенімдімін.
Dialogue: 0,0:17:55.08,0:17:55.79,Default,,0,0,0,,Мен—
Dialogue: 0,0:17:58.29,0:18:01.42,Default,,0,0,0,,Бодж Шын мәнінде, Бевин осылай деді.
Dialogue: 0,0:18:01.92,0:18:05.30,Default,,0,0,0,,Дәл қазір сіздің еліңізде үлкен қастандық жүріп жатқан сияқты.
Dialogue: 0,0:18:05.38,0:18:07.26,Default,,0,0,0,,Уф, а?
Dialogue: 0,0:18:07.76,0:18:11.30,Default,,0,0,0,,Жоқ, мен не болатынын білмеймін, бірақ...
Dialogue: 0,0:18:12.06,0:18:14.47,Default,,0,0,0,,«Сіз Бодж мырзаны қорғауыңыз керек»
Dialogue: 0,0:18:15.68,0:18:17.89,Default,,0,0,0,,Бірақ мені қате түсінбеңіз.
Dialogue: 0,0:18:18.77,0:18:21.73,Default,,0,0,0,,Мен алдымен Дайда-саманы ойлаймын.
Dialogue: 0,0:18:21.82,0:18:24.61,Default,,0,0,0,,Лорд Боджды король етейін деген ниетім жоқ.
Dialogue: 0,0:18:25.99,0:18:29.16,Default,,0,0,0,,Саған не үшін көмектесіп жатқанымды кейін түсінесің.
Dialogue: 0,0:18:31.57,0:18:33.87,Default,,0,0,0,,Бодж Енді не істейміз?
Dialogue: 0,0:18:34.66,0:18:36.50,Default,,0,0,0,,Еліңізге қайтқыңыз келе ме?
Dialogue: 0,0:18:39.92,0:18:41.92,Default,,0,0,0,,♪~
Dialogue: 0,0:18:54.51,0:18:56.52,Default,,0,0,0,,~♪
Dialogue: 0,0:18:56.60,0:18:57.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:05.40,0:19:11.41,Default,,0,0,0,,Бодж: Сіз бұл кәрі аңға күдіктенесіз бе?
Dialogue: 0,0:19:32.18,0:19:33.43,Default,,0,0,0,,Каге-чан
Dialogue: 0,0:19:37.56,0:19:38.47,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:40.06,0:19:42.52,Default,,0,0,0,,Боджа Сізде батылдық жоқ!
Dialogue: 0,0:19:42.60,0:19:43.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:48.40,0:19:48.90,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:49.74,0:19:52.11,Default,,0,0,0,,Басқаларға сену үшін батылдық!
Dialogue: 0,0:20:20.18,0:20:23.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:23.19,0:20:24.56,Default,,0,0,0,,Эй...
Dialogue: 0,0:20:25.86,0:20:26.81,Default,,0,0,0,,Эй
Dialogue: 0,0:20:27.77,0:20:28.65,Default,,0,0,0,,Бодж!
Dialogue: 0,0:20:30.03,0:20:33.91,Default,,0,0,0,,Арх! Арх! Арх!
Dialogue: 0,0:20:35.41,0:20:39.87,Default,,0,0,0,,(Үздіксіз басын ұру)
Dialogue: 0,0:20:44.04,0:20:45.75,Default,,0,0,0,,О, о... Ол
Dialogue: 0,0:20:46.92,0:20:47.84,Default,,0,0,0,,Эххе
Dialogue: 0,0:20:54.09,0:20:55.26,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:55.97,0:20:57.64,Default,,0,0,0,,Үйге барасыз ба? Бодж!
Dialogue: 0,0:20:57.72,0:20:58.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:03.85,0:21:07.31,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:21:20.49,0:21:22.50,Default,,0,0,0,,♪~
Dialogue: 0,0:22:47.83,0:22:49.83,Default,,0,0,0,,~♪
