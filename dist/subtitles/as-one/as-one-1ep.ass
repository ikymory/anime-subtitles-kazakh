Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:52.21,0:00:59.17,Default,,0,0,0,,♪ Эй, сен мені естисің бе?
Dialogue: 0,0:01:00.47,0:01:08.41,Default,,0,0,0,,Бұл әуен жалғыздықтың алшақтығында туған
Dialogue: 0,0:01:08.43,0:01:19.07,Default,,0,0,0,,ла ла ла...
Dialogue: 0,0:01:23.71,0:01:25.77,Default,,0,0,0,,la la...
Dialogue: 0,0:01:36.59,0:01:37.49,Default,,0,0,0,,...
Dialogue: 0,0:01:41.05,0:01:44.83,Default,,0,0,0,,...
Dialogue: 0,0:01:55.77,0:01:58.51,Default,,0,0,0,,Ой!
Dialogue: 0,0:02:00.98,0:02:05.62,Default,,0,0,0,,Бұл тамаша. Осымен барайық. Жарайсың, Йода.
Dialogue: 0,0:02:08.47,0:02:12.00,Default,,0,0,0,,Ә, ән мәтіні, иә?
Dialogue: 0,0:02:15.81,0:02:17.69,Default,,0,0,0,,Дерлік аяқталды
Dialogue: 0,0:02:17.69,0:02:19.50,Default,,0,0,0,,Ах, мен оны асыға күтемін.
Dialogue: 0,0:02:21.25,0:02:24.37,Default,,0,0,0,,Акито топтан кеткеннен бері оның күйі бұзылды.
Dialogue: 0,0:02:27.02,0:02:29.90,Default,,0,0,0,,Эй, қазір Акихитоға барайық.
Dialogue: 0,0:02:31.25,0:02:34.63,Default,,0,0,0,,Ол: «Қайтып кел, мұны бірге істейік» деді.
Dialogue: 0,0:02:36.58,0:02:38.09,Default,,0,0,0,,Бұл тітіркендіргіш болуы керек.
Dialogue: 0,0:02:38.80,0:02:40.71,Default,,0,0,0,,Сезімімді қазір саған зорласам да
Dialogue: 0,0:02:42.58,0:02:45.21,Default,,0,0,0,,Жарайды, егер мұны істегіңіз келсе, өзіңіз келіңіз.
Dialogue: 0,0:02:46.36,0:02:49.53,Default,,0,0,0,,Жарайды, тыңдалымға дейін әнге назар аударайық.
Dialogue: 0,0:03:08.31,0:03:10.58,Default,,0,0,0,,Біздің таптырмас жұлдызымыз
Dialogue: 0,0:03:11.46,0:03:15.19,Default,,0,0,0,,Бүгін Мегури Боши үшін ең маңызды күн
Dialogue: 0,0:03:16.34,0:03:20.41,Default,,0,0,0,,Ақыры екі елдің өкілдері мінген қарусыз автобус келеді.
Dialogue: 0,0:03:20.41,0:03:25.08,Default,,0,0,0,,Біз Sinus Fondom тау-кен мектебінің салтанатты орнына жақындап қалдық.
Dialogue: 0,0:03:29.42,0:03:31.32,Default,,0,0,0,,О? Жаңа кейіпкер пайда болды ма?
Dialogue: 0,0:03:32.32,0:03:38.28,Default,,0,0,0,,Адамдар санын бірнеше жүзге дейін қысқартқан соғысқа әкелген үмітсіздік символы.
Dialogue: 0,0:03:39.24,0:03:45.10,Default,,0,0,0,,Енді бұл өлке екі елдің қол ұстасқан үміт ұясына айналды.
Dialogue: 0,0:03:46.16,0:03:50.50,Default,,0,0,0,,Бүгін бірінші бітімге 24 жыл толды.
Dialogue: 0,0:03:51.24,0:03:56.68,Default,,0,0,0,,Екі ел де айналатын жұлдыздың бейбітшілік пен береке жылдарын жаңартады
Dialogue: 0,0:03:58.28,0:04:03.20,Default,,0,0,0,,Енді Нұрдель патша Пышақтың қасиетті империясының Вивесубасынан келеді.
Dialogue: 0,0:04:04.08,0:04:06.46,Default,,0,0,0,,Ал Гоасрекка еліндегі автобустан.
Dialogue: 0,0:04:06.46,0:04:11.94,Default,,0,0,0,,Премьер-министр Мартриц тоқтата тұру туралы келісімге қол қою рәсімі өтетін жерде болады.
Dialogue: 0,0:04:21.60,0:04:22.02,Default,,0,0,0,,Ахх!
Dialogue: 0,0:04:22.04,0:04:25.58,Default,,0,0,0,,Жұлдыз қаны...бір сәтте...
Dialogue: 0,0:04:28.70,0:04:29.54,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:04:30.80,0:04:32.64,Default,,0,0,0,,Бұл артқы шабандоз жүйесі ме?
Dialogue: 0,0:04:33.38,0:04:34.94,Default,,0,0,0,,Сіз таң қаласыз.
Dialogue: 0,0:04:34.94,0:04:36.52,Default,,0,0,0,,Білсеңіз
Dialogue: 0,0:04:37.38,0:04:39.22,Default,,0,0,0,,Мұндай нәрсені сақтау мүмкін емес.
Dialogue: 0,0:04:40.10,0:04:42.90,Default,,0,0,0,,Екі ұшқыштың санасын біріктіру
Dialogue: 0,0:04:42.90,0:04:45.76,Default,,0,0,0,,Когнитивтік аймақ және реакция жылдамдығының шектері
Dialogue: 0,0:04:46.16,0:04:50.98,Default,,0,0,0,,Жаңарту... Өнімділік айтарлықтай жақсарады.
Dialogue: 0,0:04:50.98,0:04:53.20,Default,,0,0,0,,Бірақ энергияны бір сәтте көтеруге болады.
Dialogue: 0,0:04:54.08,0:04:56.92,Default,,0,0,0,,Мұны елге жақсы көріну және оны күшті орналастыру үшін қалай пайдалануға болады?
Dialogue: 0,0:04:58.28,0:05:00.44,Default,,0,0,0,,Абсолюттік тепе-теңдікті табу
Dialogue: 0,0:05:01.72,0:05:03.74,Default,,0,0,0,,Екі елдің өкілдері бір-біріне қарап күлді.
Dialogue: 0,0:05:04.18,0:05:05.72,Default,,0,0,0,,Керемет көздер
Dialogue: 0,0:05:06.66,0:05:09.02,Default,,0,0,0,,Адамдар бір-біріне сене алады
Dialogue: 0,0:05:09.44,0:05:11.78,Default,,0,0,0,,Мұны екі елдің өкілдері дәлелдеді
Dialogue: 0,0:05:12.92,0:05:15.06,Default,,0,0,0,,Осы ұшымен қайшылық болғанша
Dialogue: 0,0:05:15.06,0:05:16.87,Default,,0,0,0,,Сенім тіпті билеуші елде де жалғасуда
Dialogue: 0,0:05:21.07,0:05:24.48,Default,,0,0,0,,Достық пен татулық?
Dialogue: 0,0:05:26.04,0:05:28.18,Default,,0,0,0,,Бұл пайдалы сөз.
Dialogue: 0,0:05:35.01,0:05:41.66,Default,,0,0,0,,Ұшқыштармен ақпарат алмасу Жаңа жүйені бір уақытта қайта тиеу алдыңғы кезеңге қатысты даналықты қажет етеді.
Dialogue: 0,0:05:42.31,0:05:48.63,Default,,0,0,0,,Ол әлі жұмыс істемейді. Мен оны нөлге дейін төмендеткім келмейді, сондықтан менің денсаулық бөлімшесі әлі де ескі Систорм болып табылады.
Dialogue: 0,0:05:49.45,0:05:50.63,Default,,0,0,0,,Бұл үлкен норма.
Dialogue: 0,0:05:51.50,0:05:52.68,Default,,0,0,0,,Бүгінгі соңғы баратын жер
Dialogue: 0,0:05:52.68,0:05:55.62,Default,,0,0,0,,Жауап ретінде менің пышақты жазуды аяқтамаңыз.
Dialogue: 0,0:05:59.04,0:06:02.22,Default,,0,0,0,,M9103 ұшыру қалдықтары бақылаудан шықты
Dialogue: 0,0:06:02.22,0:06:04.01,Default,,0,0,0,,Орташа маршрутты есептеу орындалуда.
Dialogue: 0,0:06:05.27,0:06:07.18,Default,,0,0,0,,Әр топ жіберуге дайындықты жалғастырады.
Dialogue: 0,0:06:07.18,0:06:09.74,Default,,0,0,0,,Асығыңыз, асығыңыз
Dialogue: 0,0:06:10.75,0:06:12.16,Default,,0,0,0,,Наконың физикалық жағдайы
Dialogue: 0,0:06:12.51,0:06:13.57,Default,,0,0,0,,Біз сақтадық
Dialogue: 0,0:06:13.57,0:06:15.37,Default,,0,0,0,,Бірақ басқа ұшақтар
Dialogue: 0,0:06:17.04,0:06:18.00,Default,,0,0,0,,Жарайды, оны іске қосыңыз.
Dialogue: 0,0:06:18.63,0:06:20.89,Default,,0,0,0,,Капитан! Сіз бір ғана ұшақпен кетесіз бе?
Dialogue: 0,0:06:22.04,0:06:22.86,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:06:22.86,0:06:24.22,Default,,0,0,0,,Күте тұрыңыз, капитан.
Dialogue: 0,0:06:24.77,0:06:25.60,Default,,0,0,0,,Егер басқа адамның соққы көрсеткіші...
Dialogue: 0,0:06:25.60,0:06:26.06,Default,,0,0,0,,Бисер
Dialogue: 0,0:07:01.62,0:07:05.24,Default,,0,0,0,,Маған назарымды емтиханға аударуымды айт.
Dialogue: 0,0:07:06.26,0:07:09.24,Default,,0,0,0,,Тыңдау? Фан мырза?
Dialogue: 0,0:07:10.34,0:07:14.06,Default,,0,0,0,,О, иә, бүгін жалған міну жоқ па?
Dialogue: 0,0:07:15.62,0:07:21.36,Default,,0,0,0,,Тағы осылай үнсіз қалсаңыз, ойыңызда бірдеңе болса сөйлеңіз.
Dialogue: 0,0:07:23.10,0:07:25.80,Default,,0,0,0,,Сәлем! Сіз сынақ емтиханын тапсырасыз, солай ма?
Dialogue: 0,0:07:27.44,0:07:28.23,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:29.93,0:07:32.93,Default,,0,0,0,,Мен де Йоның сөзін көп күттім.
Dialogue: 0,0:07:37.68,0:07:41.14,Default,,0,0,0,,Вигопсенакис толық гвардия капитанының ұшағына мінгенін растады
Dialogue: 0,0:07:37.80,0:07:38.06,Default,,0,0,0,,Куругара
Dialogue: 0,0:07:41.80,0:07:45.44,Default,,0,0,0,,Ескі үлгінің C жүйесі жүктелгенше қала беретінін растаңыз.
Dialogue: 0,0:07:45.84,0:07:47.86,Default,,0,0,0,,Тікелей үстіңгі катапульт жүйесін дауылдың іске қосылуы
Dialogue: 0,0:07:48.88,0:07:50.68,Default,,0,0,0,,Гиперорбитальды бақылау жүйесі
Dialogue: 0,0:07:52.12,0:07:53.36,Default,,0,0,0,,Барлық осьтерді іске қосу аяқталды
Dialogue: 0,0:07:54.04,0:07:56.04,Default,,0,0,0,,Капитан Бибо Мен кез келген уақытта барамын.
Dialogue: 0,0:07:56.04,0:07:56.80,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:08:15.41,0:08:17.43,Default,,0,0,0,,Бұл қорқынышты уақыт.
Dialogue: 0,0:08:17.43,0:08:20.37,Default,,0,0,0,,Гот Регга да осы рәсімнің отын жағады.
Dialogue: 0,0:08:20.37,0:08:22.31,Default,,0,0,0,,Мен оны стратегия үшін пайдалануды жоспарлап отырмын.
Dialogue: 0,0:08:22.31,0:08:23.61,Default,,0,0,0,,Әскерилерге хабарласыңыз
Dialogue: 0,0:08:24.25,0:08:25.49,Default,,0,0,0,,Канцлер Мартриц
Dialogue: 0,0:08:25.95,0:08:28.47,Default,,0,0,0,,Жоқ, бұл Блэйд жұлдыз патшалығы
Dialogue: 0,0:08:28.47,0:08:31.25,Default,,0,0,0,,Тозақ патшасының өміріне қауіп төндіру қаупі бар
Dialogue: 0,0:08:32.27,0:08:35.51,Default,,0,0,0,,M91035 мобильді қоқыстарының мәліметтері анықталды
Dialogue: 0,0:08:35.95,0:08:37.21,Default,,0,0,0,,Массалық категория 5
Dialogue: 0,0:08:37.95,0:08:40.13,Default,,0,0,0,,Бұл сирек кездесетін өлшем.
Dialogue: 0,0:08:40.13,0:08:42.79,Default,,0,0,0,,Егер индикаторға жетсе, зақым ауыр болады.
Dialogue: 0,0:08:43.51,0:08:44.99,Default,,0,0,0,,Бүгін қашықтық бойынша
Dialogue: 0,0:08:46.11,0:08:47.87,Default,,0,0,0,,Осындай үлкен қоқыс
Dialogue: 0,0:08:53.55,0:08:55.69,Default,,0,0,0,,Құлау нүктесі Батыс Кондем қаласы
Dialogue: 0,0:08:56.19,0:08:57.83,Default,,0,0,0,,Азаматтарды уақытында эвакуациялау мүмкін емес
Dialogue: 0,0:08:58.37,0:08:59.59,Default,,0,0,0,,Жарайды, мен аударамын.
Dialogue: 0,0:08:59.59,0:09:01.69,Default,,0,0,0,,Бір ғана тартқышпен бұл мүмкін емес.
Dialogue: 0,0:09:02.05,0:09:03.55,Default,,0,0,0,,Сіз оны тастай аласыз
Dialogue: 0,0:09:04.99,0:09:06.79,Default,,0,0,0,,Барлық аумақтағы азаматтар
Dialogue: 0,0:09:06.79,0:09:09.29,Default,,0,0,0,,Оңтүстік-шығыс бағыты Сүйретуге болатын қашықтық
Dialogue: 0,0:09:09.75,0:09:12.15,Default,,0,0,0,,Шекті аймақта зақымданбаған жер жоқ.
Dialogue: 0,0:09:12.15,0:09:14.99,Default,,0,0,0,,1472 нүктелер жиыны
Dialogue: 0,0:09:15.97,0:09:17.09,Default,,0,0,0,,Бұл Сайкеско!
Dialogue: 0,0:09:17.49,0:09:18.01,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:09:18.75,0:09:20.05,Default,,0,0,0,,Жарылыс орын алса
Dialogue: 0,0:09:20.05,0:09:22.99,Default,,0,0,0,,Дүниедегі барлық энергияның түсу мүмкіндігі бар
Dialogue: 0,0:09:22.99,0:09:24.95,Default,,0,0,0,,Тығыз жұлдыздар теңізіне құлады
Dialogue: 0,0:09:24.95,0:09:26.33,Default,,0,0,0,,Әсерді азайту
Dialogue: 0,0:09:27.99,0:09:28.59,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:29.13,0:09:30.23,Default,,0,0,0,,Тұрақты координаттар
Dialogue: 0,0:09:31.57,0:09:33.93,Default,,0,0,0,,Revly MQ-1035 тартқыш
Dialogue: 0,0:09:31.59,0:09:31.95,Default,,0,0,0,,Тағдыр
Dialogue: 0,0:09:33.93,0:09:36.23,Default,,0,0,0,,Кіру бұрышын тігінен түзетіңіз
Dialogue: 0,0:09:37.65,0:09:38.03,Default,,0,0,0,,Болт!
Dialogue: 0,0:09:38.91,0:09:39.39,Default,,0,0,0,,Өрт!
Dialogue: 0,0:09:45.09,0:09:46.25,Default,,0,0,0,,минуттық вагон болттарын орнату аяқталды
Dialogue: 0,0:09:47.23,0:09:48.87,Default,,0,0,0,,Сым, шакүреки
Dialogue: 0,0:09:51.27,0:09:51.99,Default,,0,0,0,,Орнату аяқталды
Dialogue: 0,0:09:52.53,0:09:53.85,Default,,0,0,0,,Айырмаудан аулақ болу
Dialogue: 0,0:09:57.13,0:09:59.03,Default,,0,0,0,,Ревлидің Нобумасаның түсу бұрышы 10°
Dialogue: 0,0:10:00.41,0:10:01.19,Default,,0,0,0,,MQ Іс жүзінде…
Dialogue: 0,0:10:06.10,0:10:07.50,Default,,0,0,0,,me
Dialogue: 0,0:10:07.71,0:10:08.42,Default,,0,0,0,,Бұл…
Dialogue: 0,0:10:09.02,0:10:10.07,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:10:11.42,0:10:11.78,Default,,0,0,0,,Не?
Dialogue: 0,0:10:16.00,0:10:17.30,Default,,0,0,0,,бар
Dialogue: 0,0:10:18.94,0:10:19.72,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:29.18,0:10:31.30,Default,,0,0,0,,7-бөлім Бұл кім?
Dialogue: 0,0:10:31.78,0:10:33.34,Default,,0,0,0,,Жаңа жүйе үшін сақтауды жалғастырмадыңыз ба?
Dialogue: 0,0:10:33.34,0:10:33.96,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:11:00.39,0:11:01.43,Default,,0,0,0,,Міне, осында
Dialogue: 0,0:11:02.39,0:11:03.79,Default,,0,0,0,,Кәмпиттер ше?
Dialogue: 0,0:11:05.03,0:11:05.75,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:11:06.50,0:11:09.42,Default,,0,0,0,,Иә
Dialogue: 0,0:11:10.26,0:11:10.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:11.33,0:11:14.39,Default,,0,0,0,,Кешіріңіз, жақында қалды.
Dialogue: 0,0:11:15.83,0:11:19.75,Default,,0,0,0,,Мүмкін сіз уайымдап жатқан шығарсыз.
Dialogue: 0,0:11:19.75,0:11:22.35,Default,,0,0,0,,Мен әрқашан бірдеймін
Dialogue: 0,0:11:22.35,0:11:22.61,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:22.61,0:11:26.41,Default,,0,0,0,,А, түсіндім.
Dialogue: 0,0:11:26.41,0:11:29.35,Default,,0,0,0,,Иә, сонда
Dialogue: 0,0:11:51.66,0:11:53.06,Default,,0,0,0,,Бостер ұзаққа созылмайды
Dialogue: 0,0:11:54.80,0:11:55.61,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:11:55.70,0:11:56.60,Default,,0,0,0,,Кішкене
Dialogue: 0,0:12:02.66,0:12:03.07,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:03.34,0:12:04.74,Default,,0,0,0,,Күшейткіш сым
Dialogue: 0,0:12:04.74,0:12:05.70,Default,,0,0,0,,Шығар!
Dialogue: 0,0:12:08.86,0:12:10.58,Default,,0,0,0,,Бұрыш, тігінен түзетілген
Dialogue: 0,0:12:11.50,0:12:13.74,Default,,0,0,0,,ену бұрышы, қате 0,01
Dialogue: 0,0:12:14.64,0:12:16.10,Default,,0,0,0,,Капитан, сәттілік!
Dialogue: 0,0:12:16.84,0:12:18.78,Default,,0,0,0,,Өлмейтін тас. көмек сұрау
Dialogue: 0,0:12:18.78,0:12:21.26,Default,,0,0,0,,Түсінікті. Мен сені бірден сонда жіберемін
Dialogue: 0,0:12:22.74,0:12:24.80,Default,,0,0,0,,Сіз кімсіз? Сен неге жоқсың?
Dialogue: 0,0:12:27.14,0:12:28.76,Default,,0,0,0,,Капитан, бұл жақсы емес.
Dialogue: 0,0:12:29.37,0:12:29.95,Default,,0,0,0,,Раку?
Dialogue: 0,0:12:30.39,0:12:32.44,Default,,0,0,0,,Мұның мәні неде? Бұл техникалық қызмет көрсететін кеме!
Dialogue: 0,0:12:32.89,0:12:34.27,Default,,0,0,0,,Неге мұндасың...
Dialogue: 0,0:12:34.27,0:12:35.29,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:12:36.37,0:12:36.72,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:37.86,0:12:38.89,Default,,0,0,0,,Өшіруге болады
Dialogue: 0,0:12:39.98,0:12:40.86,Default,,0,0,0,,Егер ол белгілі бір дәрежеде бар күшін салмайтын болса—
Dialogue: 0,0:12:41.46,0:12:44.50,Default,,0,0,0,,Қайт, Ракко
Dialogue: 0,0:12:45.89,0:12:47.05,Default,,0,0,0,,Мұнда…
Dialogue: 0,0:12:47.05,0:12:48.12,Default,,0,0,0,,Догора
Dialogue: 0,0:12:55.08,0:13:02.24,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:06.77,0:13:08.34,Default,,0,0,0,,Идиот? Үлес қосу.
Dialogue: 0,0:13:08.34,0:13:10.67,Default,,0,0,0,,Урда! Траекторияңызды өзгертпеңіз!
Dialogue: 0,0:13:12.29,0:13:19.89,Default,,0,0,0,,Сөзсіз тазалауға болады
Dialogue: 0,0:13:20.60,0:13:21.25,Default,,0,0,0,,Уми!
Dialogue: 0,0:13:23.37,0:13:24.94,Default,,0,0,0,,Ия, сіздің кезегіңіз.
Dialogue: 0,0:13:25.62,0:13:26.51,Default,,0,0,0,,Сіз бара аласыз ба?
Dialogue: 0,0:13:27.12,0:13:28.08,Default,,0,0,0,,Сіздің кезегіңіз.
Dialogue: 0,0:13:29.01,0:13:30.25,Default,,0,0,0,,Эй Ю
Dialogue: 0,0:13:30.89,0:13:32.82,Default,,0,0,0,,Комацу мырзаның қызметкерлеріне рахмет.
Dialogue: 0,0:13:33.75,0:13:34.37,Default,,0,0,0,,Юо
Dialogue: 0,0:13:35.65,0:13:36.08,Default,,0,0,0,,Эй
Dialogue: 0,0:13:36.98,0:13:37.96,Default,,0,0,0,,Бір нәрсе сұраңыз
Dialogue: 0,0:13:37.96,0:13:39.15,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:13:39.15,0:13:41.27,Default,,0,0,0,,Яо Яо
Dialogue: 0,0:13:42.58,0:13:43.39,Default,,0,0,0,,Яо
Dialogue: 0,0:13:50.60,0:13:51.77,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:13:52.51,0:13:54.13,Default,,0,0,0,,Сіздің кезегіңіз неде?
Dialogue: 0,0:13:55.26,0:13:56.28,Default,,0,0,0,,Хаха
Dialogue: 0,0:13:56.28,0:13:59.19,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:14:02.10,0:14:08.66,Default,,0,0,0,,Уф
Dialogue: 0,0:14:21.52,0:14:22.52,Default,,0,0,0,,Жылжыту...
Dialogue: 0,0:14:25.24,0:14:25.72,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:14:28.69,0:14:36.27,Default,,0,0,0,,Өшіріңіз... егер сіз болмасаңыз да...
Dialogue: 0,0:14:42.37,0:14:42.87,Default,,0,0,0,,Осы жерге дейін жеткеніңе қуаныштымын.
Dialogue: 0,0:14:42.87,0:14:45.81,Default,,0,0,0,,Әке!
Dialogue: 0,0:14:48.82,0:14:56.44,Default,,0,0,0,,Сол Косаку Каваджири, иіліп-жығылып, жалтақтайды.
Dialogue: 0,0:14:58.02,0:14:59.42,Default,,0,0,0,,Не?
Dialogue: 0,0:14:59.66,0:15:00.16,Default,,0,0,0,,А...?
Dialogue: 0,0:15:05.56,0:15:08.36,Default,,0,0,0,,Мен...?
Dialogue: 0,0:15:08.36,0:15:12.88,Default,,0,0,0,,Ах... Кетер...
Dialogue: 0,0:15:18.82,0:15:21.82,Default,,0,0,0,,Маған көмектесіңізші...
Dialogue: 0,0:15:25.52,0:15:26.82,Default,,0,0,0,,Әке...
Dialogue: 0,0:15:48.82,0:15:49.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:53.50,0:15:54.50,Default,,0,0,0,,Уау
Dialogue: 0,0:15:54.57,0:15:57.00,Default,,0,0,0,,Уау
Dialogue: 0,0:15:59.62,0:16:00.92,Default,,0,0,0,,Лунако...
Dialogue: 0,0:16:01.74,0:16:03.26,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:06.38,0:16:07.38,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:16:10.26,0:16:12.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:23.54,0:16:24.04,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:16:32.48,0:16:34.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:34.56,0:16:36.12,Default,,0,0,0,,Ах
Dialogue: 0,0:16:36.78,0:16:37.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.58,0:16:39.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:44.34,0:16:46.72,Default,,0,0,0,,Орбитаның өзгеруі...
Dialogue: 0,0:16:46.72,0:16:47.98,Default,,0,0,0,,Жұлдыз қаны болмаса да
Dialogue: 0,0:16:51.12,0:16:53.06,Default,,0,0,0,,Бар, жүр
Dialogue: 0,0:16:53.58,0:16:54.38,Default,,0,0,0,,Теңізге
Dialogue: 0,0:17:02.84,0:17:04.88,Default,,0,0,0,,M9103 азайту
Dialogue: 0,0:17:12.00,0:17:14.66,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:17:14.66,0:17:15.56,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:17:18.58,0:17:20.54,Default,,0,0,0,,Теңізге орбитаны түзету
Dialogue: 0,0:17:24.46,0:17:25.02,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:17:26.02,0:17:26.66,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:17:34.32,0:17:35.02,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:42.21,0:17:45.41,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:17:53.82,0:17:56.44,Default,,0,0,0,,MQ 103 принципі бойынша
Dialogue: 0,0:17:56.44,0:17:59.02,Default,,0,0,0,,Жақсы болған сияқты.
Dialogue: 0,0:17:59.60,0:18:03.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:17.10,0:18:22.52,Default,,0,0,0,,Жоғарыда аталған екі қорғаушыны Бонасоций қалпына келтірді.
Dialogue: 0,0:18:23.46,0:18:25.08,Default,,0,0,0,,Сіздің депозитіңізде
Dialogue: 0,0:18:26.06,0:18:28.52,Default,,0,0,0,,Менің ондай өкілеттігім жоқ
Dialogue: 0,0:18:29.50,0:18:33.26,Default,,0,0,0,,Бұл сан қолданыстағы технологиядан әлдеқайда көп.
Dialogue: 0,0:18:34.92,0:18:38.24,Default,,0,0,0,,Бұл маған сіз жасап жатқан антеннаны еске түсіреді.
Dialogue: 0,0:18:38.70,0:18:39.10,Default,,0,0,0,,Дисперстік
Dialogue: 0,0:18:38.74,0:18:46.64,Default,,0,0,0,,Талдауда Сіз бірдеңе болды дейсіз бе, тіпті сіз, Реалиде әзірлеуге жауапты адам да түсінбейтін бе?
Dialogue: 0,0:18:48.68,0:18:54.48,Default,,0,0,0,,Блэйд сізден озып кетпесе жақсы, бірақ премьер-министрден артық емес.
Dialogue: 0,0:18:54.48,0:18:57.40,Default,,0,0,0,,Сізге күтудің қажеті жоқ.
Dialogue: 0,0:19:02.00,0:19:06.42,Default,,0,0,0,,Қозғалайық! Лакоалис Леройдан көзіңді ал.
Dialogue: 0,0:19:09.67,0:19:12.27,Default,,0,0,0,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,0:19:12.27,0:19:14.13,Default,,0,0,0,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:19:37.78,0:19:40.82,Default,,0,0,0,,Бұл сенің сүйіктің ғой, Миямура.
Dialogue: 0,0:19:41.88,0:19:43.28,Default,,0,0,0,,Эй
Dialogue: 0,0:19:43.95,0:19:44.86,Default,,0,0,0,,А...
Dialogue: 0,0:19:49.40,0:19:50.76,Default,,0,0,0,,Бұрынғы бала
Dialogue: 0,0:19:51.88,0:19:52.64,Default,,0,0,0,,Кім?
Dialogue: 0,0:19:54.56,0:19:56.84,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:19:58.22,0:20:00.42,Default,,0,0,0,,- Мм - А, түсіндім.
Dialogue: 0,0:20:01.46,0:20:02.44,Default,,0,0,0,,Бұл арман
Dialogue: 0,0:20:02.44,0:20:05.76,Default,,0,0,0,,Не? Сау болыңыз...
Dialogue: 0,0:20:15.27,0:20:16.51,Default,,0,0,0,,О?
Dialogue: 0,0:20:17.35,0:20:19.51,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:20.65,0:20:21.57,Default,,0,0,0,,Мен сені таптым.
Dialogue: 0,0:20:26.61,0:20:28.59,Default,,0,0,0,,Маған не болып жатқанын білесің бе?
Dialogue: 0,0:20:29.19,0:20:30.32,Default,,0,0,0,,Сіз оны тоқтата аласыз ба?
Dialogue: 0,0:20:32.88,0:20:36.81,Default,,0,0,0,,Бұл сіздің арманыңыз ба? Басқа кімнің арманы?
Dialogue: 0,0:20:37.70,0:20:38.59,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:20:40.43,0:20:40.82,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:20:41.29,0:20:46.11,Default,,0,0,0,,Неліктен ол қайтадан жоғалып жатыр? Мені мұнда сен әкелген жоқсың.
Dialogue: 0,0:20:46.81,0:20:52.55,Default,,0,0,0,,Сіз мені шақырдыңыз, солай ма? Сізді міндетті түрде оқып, көмек сұраған дауыс болды.
Dialogue: 0,0:20:53.75,0:20:56.42,Default,,0,0,0,,Эй, бұл қайда?
Dialogue: 0,0:20:57.07,0:20:58.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:58.51,0:21:06.46,Default,,0,0,0,,Мен... Сондықтан мен ауруханаға бардым...
Dialogue: 0,0:21:09.07,0:21:11.44,Default,,0,0,0,,Лакоалис Лерой, техникалық қызмет көрсету жөніндегі офицер.
Dialogue: 0,0:21:11.44,0:21:12.85,Default,,0,0,0,,Иә
Dialogue: 0,0:21:12.85,0:21:15.79,Default,,0,0,0,,Мен Блейд Қасиетті Императорлық отбасынан шықтым.
Dialogue: 0,0:21:16.57,0:21:17.85,Default,,0,0,0,,Бізбен бірге жүріңіз
Dialogue: 0,0:21:19.40,0:21:21.35,Default,,0,0,0,,Қый!
Dialogue: 0,0:21:26.79,0:21:27.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:33.85,0:21:35.92,Default,,0,0,0,,0-2 Нұсқау орындалды
Dialogue: 0,0:21:36.17,0:21:38.25,Default,,0,0,0,,Жұлдыздық жерді жеткізу желісі сәтті жойылды
Dialogue: 0,0:21:38.87,0:21:41.57,Default,,0,0,0,,Енді нысананы бекітуге көшіңіз
Dialogue: 0,0:21:42.25,0:21:44.57,Default,,0,0,0,,Бұл төтенше жағдай. Тез орал.
Dialogue: 0,0:21:45.07,0:21:46.49,Default,,0,0,0,,Аурухана бөлмесіне оралыңыз.
Dialogue: 0,0:21:47.17,0:21:49.45,Default,,0,0,0,,Бізде бәрі жақсы, сондықтан сіз...
Dialogue: 0,0:21:52.03,0:21:54.01,Default,,0,0,0,,Бұл Ракоалисуруо.
Dialogue: 0,0:21:55.27,0:21:56.93,Default,,0,0,0,,Не? Бұл?
Dialogue: 0,0:21:57.33,0:21:58.85,Default,,0,0,0,,Мен сенімен бірге барайын ба?
Dialogue: 0,0:22:00.39,0:22:01.93,Default,,0,0,0,,Оны қиындыққа айналдырмаңыз
Dialogue: 0,0:22:02.37,0:22:06.93,Default,,0,0,0,,Мүмкін болса, оны тірідей әкелгім келеді.
Dialogue: 0,0:22:09.89,0:22:10.29,Default,,0,0,0,,Рако!
Dialogue: 0,0:22:11.65,0:22:12.23,Default,,0,0,0,,Libo!
Dialogue: 0,0:22:12.51,0:22:14.41,Default,,0,0,0,,Мен кейінірек түсіндіремін. Қанекей жүгірейік.
Dialogue: 0,0:22:20.20,0:22:23.55,Default,,0,0,0,,Нөлді жабу!
Dialogue: 0,0:22:26.77,0:22:27.90,Default,,0,0,0,,Пышақты әскер?
Dialogue: 0,0:22:28.31,0:22:30.03,Default,,0,0,0,,Азаматтық жолда жүргенде Орд
Dialogue: 0,0:22:30.03,0:22:30.88,Default,,0,0,0,,Тоқта
Dialogue: 0,0:22:30.88,0:22:31.51,Default,,0,0,0,,Пышақты әскер?
Dialogue: 0,0:22:32.40,0:22:34.38,Default,,0,0,0,,Неге тіпті одақтас...
Dialogue: 0,0:22:34.38,0:22:35.90,Default,,0,0,0,,Ешқайсысы да одақтас емес.
Dialogue: 0,0:22:36.88,0:22:37.94,Default,,0,0,0,,Асрекка да
Dialogue: 0,0:22:37.94,0:22:39.07,Default,,0,0,0,,Жүзі де
Dialogue: 0,0:22:39.50,0:22:40.64,Default,,0,0,0,,Мен сені көздеп отырмын
Dialogue: 0,0:22:40.64,0:22:42.27,Default,,0,0,0,,20-шы эпизод: Бастықтың соңғы бұйрығы
Dialogue: 0,0:22:42.27,0:22:43.27,Default,,0,0,0,,(Hol Horse) «Мен осы жерде сұрақ қойғым келетін адаммын!»
Dialogue: 0,0:22:43.27,0:22:44.75,Default,,0,0,0,,Теңдікті сақтамау
Dialogue: 0,0:22:44.75,0:22:46.53,Default,,0,0,0,,Басты бекітуді орындау
Dialogue: 0,0:22:50.14,0:22:50.90,Default,,0,0,0,,Сен
Dialogue: 0,0:22:50.90,0:22:51.51,Default,,0,0,0,,Соңы
Dialogue: 0,0:23:00.30,0:23:03.38,Default,,0,0,0,,Хмм
Dialogue: 0,0:23:03.94,0:23:04.50,Default,,0,0,0,,Хмм?
Dialogue: 0,0:23:09.26,0:23:10.92,Default,,0,0,0,,Ах
Dialogue: 0,0:23:21.44,0:23:23.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:34.62,0:23:36.54,Default,,0,0,0,,Жұлдыз қаны ағып жатыр!
Dialogue: 0,0:23:49.42,0:23:52.85,Default,,0,0,0,,Тоқтату тәртібін елемеу және Red Rock-қа кедергі жасау расталды
Dialogue: 0,0:23:52.85,0:23:53.48,Default,,0,0,0,,Капитан!
Dialogue: 0,0:23:55.67,0:23:59.55,Default,,0,0,0,,Егер сіз жариялағыңыз келсе, қатысушылардың аты-жөні мен тегіне кепілдік бере алмаймыз.
Dialogue: 0,0:23:59.55,0:24:00.55,Default,,0,0,0,,Қайталама
Dialogue: 0,0:24:01.17,0:24:03.23,Default,,0,0,0,,Өтінемін... жылжытыңыз!
Dialogue: 0,0:24:04.41,0:24:06.15,Default,,0,0,0,,Өтінемін...!
Dialogue: 0,0:24:06.15,0:24:07.69,Default,,0,0,0,,Мен қозғалғым келеді...
Dialogue: 0,0:24:07.69,0:24:08.21,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:24:09.17,0:24:09.61,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:24:09.61,0:24:11.29,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:24:12.13,0:24:12.99,Default,,0,0,0,,Жылжы!
Dialogue: 0,0:24:18.32,0:24:20.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:23.74,0:24:24.80,Default,,0,0,0,,Жүр!
Dialogue: 0,0:24:33.90,0:24:34.50,Default,,0,0,0,,Ах
Dialogue: 0,0:24:35.42,0:24:36.80,Default,,0,0,0,,Оны тастаңыз!
Dialogue: 0,0:24:39.20,0:24:41.32,Default,,0,0,0,,Куку куку
Dialogue: 0,0:24:41.32,0:24:43.00,Default,,0,0,0,,Иә
Dialogue: 0,0:24:55.00,0:24:55.98,Default,,0,0,0,,Жақсысың ба, Рако?
Dialogue: 0,0:24:56.76,0:24:57.40,Default,,0,0,0,,Иә
Dialogue: 0,0:24:58.12,0:25:00.10,Default,,0,0,0,,Бұл сізге біраз уақыт алады.
Dialogue: 0,0:25:02.14,0:25:03.04,Default,,0,0,0,,Рахмет сізге Виго
Dialogue: 0,0:25:03.74,0:25:06.58,Default,,0,0,0,,Қол астындағыларды қорғайтын капитан.
Dialogue: 0,0:25:09.12,0:25:11.50,Default,,0,0,0,,Дұрыс, капитан.
Dialogue: 0,0:25:12.08,0:25:15.80,Default,,0,0,0,,Бұл нормадан тыс энергия құбылысы қандай?
Dialogue: 0,0:25:16.52,0:25:19.68,Default,,0,0,0,,Маған бұл сізден туындаған құбылыс сияқты көрінді.
Dialogue: 0,0:25:25.42,0:25:26.62,Default,,0,0,0,,Адамдар…
Dialogue: 0,0:25:27.72,0:25:28.62,Default,,0,0,0,,Бар
Dialogue: 0,0:25:30.36,0:25:33.44,Default,,0,0,0,,Кенет маған біреу кіріп келді
Dialogue: 0,0:25:33.44,0:25:35.88,Default,,0,0,0,,Егер біз сол адаммен күш біріктірсек,
Dialogue: 0,0:25:36.62,0:25:38.50,Default,,0,0,0,,Жұлдыздың қаны таусылса да
Dialogue: 0,0:25:38.50,0:25:40.08,Default,,0,0,0,,Энергия пайда болады
Dialogue: 0,0:25:43.22,0:25:45.16,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:25:46.04,0:25:48.06,Default,,0,0,0,,Араларыңда кім бар?
Dialogue: 0,0:25:48.06,0:25:49.82,Default,,0,0,0,,Сіз одақтассыз ба?
Dialogue: 0,0:25:51.38,0:25:53.10,Default,,0,0,0,,Одақтас?
Dialogue: 0,0:25:54.62,0:25:55.98,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:25:56.62,0:25:57.18,Default,,0,0,0,,Минато
Dialogue: 0,0:25:58.40,0:26:00.36,Default,,0,0,0,,Менің атым
Dialogue: 0,0:26:00.36,0:26:01.94,Default,,0,0,0,,Қызық екен
Dialogue: 0,0:26:02.62,0:26:05.08,Default,,0,0,0,,Бұл Жердегі қалыпты жағдай.
Dialogue: 0,0:26:05.08,0:26:05.78,Default,,0,0,0,,Жер
Dialogue: 0,0:26:06.62,0:26:07.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:26:08.59,0:26:14.55,Default,,0,0,0,,-де мұндай жер жоқ, мүмкін бұл планетада жоқ шығар.
Dialogue: 0,0:26:16.14,0:26:19.74,Default,,0,0,0,,Сіз маған көлік бере аласыз ба?
Dialogue: 0,0:26:21.85,0:26:25.66,Default,,0,0,0,,Екі адамның санасын айыру.
Dialogue: 0,0:26:25.66,0:26:30.59,Default,,0,0,0,,Блэд пен Асрекка сіздің күшіңізге таласады.\NБасталғалы
Dialogue: 0,0:26:30.23,0:26:31.81,Default,,0,0,0,,...
Dialogue: 0,0:26:32.45,0:26:33.69,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:26:35.31,0:26:38.23,Default,,0,0,0,,Соғыс қайтадан басталады
Dialogue: 0,0:26:44.45,0:26:46.61,Default,,0,0,0,,Мүмкін мен жоқ болсам жақсы болар
Dialogue: 0,0:26:47.19,0:26:48.29,Default,,0,0,0,,Баладан бас тартпа
Dialogue: 0,0:26:49.73,0:26:51.55,Default,,0,0,0,,Сіз қажетті адамсыз.
Dialogue: 0,0:26:53.23,0:26:54.43,Default,,0,0,0,,Мен үшін де
Dialogue: 0,0:27:02.01,0:27:05.23,Default,,0,0,0,,Енді дыбыс... Маған ауыстыру машина керек
Dialogue: 0,0:27:05.91,0:27:07.99,Default,,0,0,0,,Мен барып аламын. Мен осында күтемін.
Dialogue: 0,0:27:19.56,0:27:20.68,Default,,0,0,0,,Жақсы жаңалық
Dialogue: 0,0:27:22.20,0:27:26.20,Default,,0,0,0,,Енді доктор Леройдың зерттеуін күтудің қажеті жоқ
Dialogue: 0,0:27:26.20,0:27:28.20,Default,,0,0,0,,Әуеден басталады
Dialogue: 0,0:27:36.01,0:27:40.27,Default,,0,0,0,,Қызым шымшып тұрса да әлі шыға алмай жүрмін.
Dialogue: 0,0:27:41.53,0:27:43.37,Default,,0,0,0,,Үйге бара аламын ба?
Dialogue: 0,0:27:43.37,0:27:44.67,Default,,0,0,0,,Бұл оңай емес пе?
Dialogue: 0,0:27:44.67,0:27:46.51,Default,,0,0,0,,Маған қиналып жатыр.
Dialogue: 0,0:27:47.15,0:27:49.15,Default,,0,0,0,,Мен де, тыңдау
Dialogue: 0,0:27:50.03,0:27:51.71,Default,,0,0,0,,Менің кетуден басқа амалым жоқ.
Dialogue: 0,0:27:53.28,0:27:54.06,Default,,0,0,0,,Жерде?
Dialogue: 0,0:27:55.26,0:27:56.90,Default,,0,0,0,,Папаның зертханасы жоқ
Dialogue: 0,0:27:56.90,0:27:58.34,Default,,0,0,0,,Bonasocuse Inc.
Dialogue: 0,0:27:58.88,0:28:00.86,Default,,0,0,0,,Бона... бұл қайда?
Dialogue: 0,0:28:01.58,0:28:04.26,Default,,0,0,0,,Қару жасаудан өмір сүру технологиясына дейін
Dialogue: 0,0:28:04.26,0:28:06.24,Default,,0,0,0,,Барлығын дерлік қолдайтын компаниялар
Dialogue: 0,0:28:06.78,0:28:09.04,Default,,0,0,0,,Әкем – анау жақтағы шөгінділер.
Dialogue: 0,0:28:09.04,0:28:10.52,Default,,0,0,0,,Жұлдыз қанына негізделген
Dialogue: 0,0:28:10.52,0:28:13.00,Default,,0,0,0,,Жаңа энергияны дамыту
Dialogue: 0,0:28:13.98,0:28:16.94,Default,,0,0,0,,Сенің әкең ғажап, солай емес пе?
Dialogue: 0,0:28:16.94,0:28:19.70,Default,,0,0,0,,Мен бүгін таңертең жолға шыққанда
Dialogue: 0,0:28:19.70,0:28:20.96,Default,,0,0,0,,Менің есімде бір нәрсе бар
Dialogue: 0,0:28:21.94,0:28:24.58,Default,,0,0,0,,Әкем түсінер еді.
Dialogue: 0,0:28:26.52,0:28:29.74,Default,,0,0,0,,Әкең Қағайдың жағында.
Dialogue: 0,0:28:30.48,0:28:33.08,Default,,0,0,0,,Сіз де мен сияқты көресіз.
Dialogue: 0,0:28:33.98,0:28:35.58,Default,,0,0,0,,Виго да осылай деді.
Dialogue: 0,0:28:37.48,0:28:39.00,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:28:40.20,0:28:41.88,Default,,0,0,0,,Танысқаныма қуаныштымын Ю
Dialogue: 0,0:28:50.96,0:28:52.56,Default,,0,0,0,,Робот
Dialogue: 0,0:28:55.00,0:28:56.10,Default,,0,0,0,,Виго
Dialogue: 0,0:28:57.74,0:28:58.90,Default,,0,0,0,,Атпен жүру
Dialogue: 0,0:29:02.34,0:29:04.18,Default,,0,0,0,,Bonasocuse?
Dialogue: 0,0:29:05.61,0:29:07.33,Default,,0,0,0,,Мен кірсем ғой.
Dialogue: 0,0:29:07.77,0:29:11.17,Default,,0,0,0,,Менің әкем жасаған құпия маршрутым бар.
Dialogue: 0,0:29:12.35,0:29:13.51,Default,,0,0,0,,Дәрігерге ұқсайды.
Dialogue: 0,0:29:14.23,0:29:16.97,Default,,0,0,0,,Мен осы уақытқа дейін келдім, мен сенімен бірге боламын
Dialogue: 0,0:29:19.75,0:29:22.41,Default,,0,0,0,,Сіз жақсы адамсыз, капитан.
Dialogue: 0,0:29:30.95,0:29:31.67,Default,,0,0,0,,Уау
Dialogue: 0,0:29:32.17,0:29:34.67,Default,,0,0,0,,Аспанда сондай үлкен артефакт бар
Dialogue: 0,0:29:36.09,0:29:37.55,Default,,0,0,0,,Ауырлық күшімен не болып жатыр?
Dialogue: 0,0:29:38.71,0:29:42.55,Default,,0,0,0,,Ах, өйткені оның өзі гравитацияны басқару спутнигі.
Dialogue: 0,0:29:42.55,0:29:44.81,Default,,0,0,0,,Орбитаның қалдықтары түспейді
Dialogue: 0,0:29:44.81,0:29:46.41,Default,,0,0,0,,Сіз не үшін қарызсыз?
Dialogue: 0,0:29:47.49,0:29:49.59,Default,,0,0,0,,Бұл ескі және әмбебап емес.
Dialogue: 0,0:29:49.59,0:29:53.09,Default,,0,0,0,,Бұл қоқыс бүгін таңертең бақылаудан шықты.
Dialogue: 0,0:29:53.71,0:29:56.03,Default,,0,0,0,,Басқа да осындай нәрселер бар ма?
Dialogue: 0,0:29:57.15,0:29:57.47,Default,,0,0,0,,Иә
Dialogue: 0,0:29:58.67,0:30:02.35,Default,,0,0,0,,Жұлдыздар елі үшін ұзақ және сұрапыл соғыстың қалдықтары
Dialogue: 0,0:30:03.41,0:30:07.67,Default,,0,0,0,,Мен жұлдыздар елі туралы көп естідім, бірақ...
Dialogue: 0,0:30:08.21,0:30:11.07,Default,,0,0,0,,Жұлдызды теңізден келе жатқан жұлдыздардың тереңінде
Dialogue: 0,0:30:10.71,0:30:14.09,Default,,0,0,0,,Бұл теңізден жиналған жұмбақ энергия.
Dialogue: 0,0:30:15.53,0:30:18.75,Default,,0,0,0,,Түсіндім, ол Жерде жоқ.
Dialogue: 0,0:30:19.53,0:30:21.51,Default,,0,0,0,,Мүмкін онсыз жақсырақ шығар
Dialogue: 0,0:30:22.55,0:30:25.77,Default,,0,0,0,,Мегурибоши жұлдыз қанына тым көп сенді
Dialogue: 0,0:30:26.31,0:30:27.41,Default,,0,0,0,,Бұл ыңғайлы болғандықтан
Dialogue: 0,0:30:28.69,0:30:33.55,Default,,0,0,0,,Соңында ол үшін күресудің арқасында адам саны азайды.
Dialogue: 0,0:30:34.65,0:30:35.01,Default,,0,0,0,,Бірақ
Dialogue: 0,0:30:36.35,0:30:38.27,Default,,0,0,0,,Жер ұқсас болуы мүмкін
Dialogue: 0,0:30:40.51,0:30:44.53,Default,,0,0,0,,Үмітсіздікке толы болғаны сонша, мен әлеуметтік өлең жаза аламын
Dialogue: 0,0:30:46.07,0:30:49.09,Default,,0,0,0,,Тілек жұлдызы... т.б.
Dialogue: 0,0:30:49.57,0:30:54.01,Default,,0,0,0,,Папаның зерттеуі аяқталғаннан кейін Мегури Жұлдызға үміт бар.
Dialogue: 0,0:30:54.01,0:30:55.45,Default,,0,0,0,,Өйткені қақтығыс болмайды
Dialogue: 0,0:30:56.51,0:30:58.55,Default,,0,0,0,,Жұлдыз қанын кристалдандыратын шар.
Dialogue: 0,0:30:59.25,0:31:02.55,Default,,0,0,0,,Үлкен энергияны өндіреді және артқы жүруге мүмкіндік береді
Dialogue: 0,0:31:02.55,0:31:07.79,Default,,0,0,0,,Жұлдыз қанын кристалдарға айналдыр...
Dialogue: 0,0:31:08.15,0:31:11.09,Default,,0,0,0,,Айтпақшы, ән шығарамын дедіңіз бе?
Dialogue: 0,0:31:12.17,0:31:16.43,Default,,0,0,0,,Ах... у... Мен музыка ойнаймын.
Dialogue: 0,0:31:16.43,0:31:17.35,Default,,0,0,0,,Жұмыста?
Dialogue: 0,0:31:18.13,0:31:21.05,Default,,0,0,0,,Кәмен шабандозы болғанда...
Dialogue: 0,0:31:21.05,0:31:23.41,Default,,0,0,0,,Мен тыңдағым келеді! Мен жердің музыкасын тыңдағым келеді
Dialogue: 0,0:31:23.41,0:31:24.77,Default,,0,0,0,,Ей, тыңдайыншы.
Dialogue: 0,0:31:24.77,0:31:25.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:28.31,0:31:30.29,Default,,0,0,0,,Мен ән айтқанды ұнатамын
Dialogue: 0,0:31:40.05,0:31:47.95,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,0:31:47.95,0:31:55.65,Default,,0,0,0,,Жалғыздықтың арасына көмілген
Dialogue: 0,0:32:05.30,0:32:07.30,Default,,0,0,0,,Бұл солған әуен, Босатпаймын
Dialogue: 0,0:32:09.04,0:32:17.48,Default,,0,0,0,,Сөз бен жүректің байланысы үзілді
Dialogue: 0,0:32:17.48,0:32:26.38,Default,,0,0,0,,Ертең аздап түс болады
Dialogue: 0,0:32:27.48,0:32:33.78,Default,,0,0,0,,Мен білмейтін нәрсе болуы керек
Dialogue: 0,0:32:36.58,0:32:40.48,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:32:41.20,0:32:44.40,Default,,0,0,0,,Қараңғылық арқылы
Dialogue: 0,0:32:44.40,0:32:49.16,Default,,0,0,0,,Ертеңгі мені сүртейік
Dialogue: 0,0:32:49.16,0:32:58.12,Default,,0,0,0,,Қара көз жасы алыстап барады
Dialogue: 0,0:32:58.12,0:33:01.96,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:33:03.14,0:33:03.88,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:33:03.88,0:33:04.96,Default,,0,0,0,,Қош бол
Dialogue: 0,0:33:12.77,0:33:13.85,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:33:14.53,0:33:16.37,Default,,0,0,0,,Мен Йох туралы естимін.
Dialogue: 0,0:33:16.37,0:33:17.73,Default,,0,0,0,,Изава) Қызық па?
Dialogue: 0,0:33:17.73,0:33:21.25,Default,,0,0,0,,Әуені жақсы, бірақ сөзі жеткіліксіз
Dialogue: 0,0:33:21.25,0:33:21.99,Default,,0,0,0,,Иса) (lol)
Dialogue: 0,0:33:23.27,0:33:26.59,Default,,0,0,0,,Мен өзімді шынымен адасып кеткендей сезінемін.
Dialogue: 0,0:33:28.09,0:33:30.73,Default,,0,0,0,,Шындығында, бұл әлі де орындалып жатқан жұмыс.
Dialogue: 0,0:33:31.95,0:33:33.27,Default,,0,0,0,,Бұл, әрине, айналма жол.
Dialogue: 0,0:33:34.29,0:33:37.59,Default,,0,0,0,,Ешкімге жүрегіңді ашпай жай ғана кезіп жүр
Dialogue: 0,0:33:38.35,0:33:40.65,Default,,0,0,0,,Мен Йохтың уайымын сездім.
Dialogue: 0,0:33:40.65,0:33:42.47,Default,,0,0,0,,Сіз мұны түсінесіз бе?
Dialogue: 0,0:33:43.63,0:33:47.27,Default,,0,0,0,,Әкемнің маған үнемі айтатыны біртүрлі
Dialogue: 0,0:33:47.79,0:33:50.27,Default,,0,0,0,,Мен бұл жай ғана Юэдің кеңесі сияқты сезінемін.
Dialogue: 0,0:33:51.67,0:33:54.49,Default,,0,0,0,,Жарайды, Раконың ата-анасының кеңесі.
Dialogue: 0,0:33:55.33,0:33:58.79,Default,,0,0,0,,Әкем маған әрқашан бірінші өзіңе сену керектігін айтатын.
Dialogue: 0,0:34:01.47,0:34:04.29,Default,,0,0,0,,Әйтеуір, мен ата-анамнан ерекшемін.
Dialogue: 0,0:34:05.08,0:34:07.38,Default,,0,0,0,,Өзіңізге сенімдісіз бе, жоқ па маңызды емес.
Dialogue: 0,0:34:08.24,0:34:10.96,Default,,0,0,0,,Біреудің саған сенуін күтпе
Dialogue: 0,0:34:11.72,0:34:13.94,Default,,0,0,0,,Мен бұған сенемін
Dialogue: 0,0:34:14.44,0:34:16.98,Default,,0,0,0,,Папа маған осылай үйретті
Dialogue: 0,0:34:18.50,0:34:20.56,Default,,0,0,0,,Мен өзіме кепілдік беруге тырыстым
Dialogue: 0,0:34:20.56,0:34:23.08,Default,,0,0,0,,Басқа нәрселерге де сенетініңізге сенімдімін.
Dialogue: 0,0:34:24.72,0:34:26.52,Default,,0,0,0,,Бұл оның салынып жатқанын білдіреді.
Dialogue: 0,0:34:27.30,0:34:29.36,Default,,0,0,0,,Бұл одан да жақсы ән болады.
Dialogue: 0,0:34:44.70,0:34:45.74,Default,,0,0,0,,♪~
Dialogue: 0,0:34:48.32,0:34:50.22,Default,,0,0,0,,Бұл мен білетін ән
Dialogue: 0,0:34:50.22,0:34:54.62,Default,,0,0,0,,Әй, бірақ бұл күн жасаған жердің әні.
Dialogue: 0,0:34:55.52,0:35:00.68,Default,,0,0,0,,Лулу дәрігердің маған баяғыда айтқан әніне ұқсайды.
Dialogue: 0,0:35:01.26,0:35:02.94,Default,,0,0,0,,Сол ән
Dialogue: 0,0:35:02.58,0:35:05.48,Default,,0,0,0,,Сіз бұл ән мені Тартқыш күзет корпусына кіруіме әкелді деп айта аласыз.
Dialogue: 0,0:35:07.22,0:35:08.58,Default,,0,0,0,,Мұны есту деген нені білдіреді?
Dialogue: 0,0:35:13.14,0:35:15.96,Default,,0,0,0,,12 жыл бұрын жаппай қоқыстардың құлауынан
Dialogue: 0,0:35:15.96,0:35:18.12,Default,,0,0,0,,Көп адамның өмірі қиылған түн
Dialogue: 0,0:35:19.04,0:35:20.40,Default,,0,0,0,,Менің ата-анам да
Dialogue: 0,0:35:22.30,0:35:24.08,Default,,0,0,0,,Бірдеңені айғайлап жатқанда
Dialogue: 0,0:35:24.08,0:35:27.20,Default,,0,0,0,,Әкем мен шешемді қираған қоқыс жұтып қойды.
Dialogue: 0,0:35:27.90,0:35:29.50,Default,,0,0,0,,Менің қолымнан келгені тек қарау болды.
Dialogue: 0,0:35:32.02,0:35:35.04,Default,,0,0,0,,Отбасының басқа мүшелерінен бөлінген
Dialogue: 0,0:35:35.04,0:35:40.18,Default,,0,0,0,,Жан-дүниемді мұңайтқанда, бейтаныс болса да қолдау көрсеткен үлкен кісі болды.
Dialogue: 0,0:35:42.28,0:35:45.72,Default,,0,0,0,,Бұл доктор Леруа, сіздің әкеңіз.
Dialogue: 0,0:35:47.08,0:35:50.32,Default,,0,0,0,,Әйелінен айырылу оған да ауыр тиген болуы керек.
Dialogue: 0,0:35:51.98,0:35:55.78,Default,,0,0,0,,Көңілімді көтеру үшін жиі ән тыңдауға мәжбүр ететін.
Dialogue: 0,0:35:56.90,0:36:00.92,Default,,0,0,0,,Неге екені белгісіз, оның әндерін тыңдасам, өзімді жайбарақат сезінемін.
Dialogue: 0,0:36:05.12,0:36:07.90,Default,,0,0,0,,Рако есіне тым жас шығар.
Dialogue: 0,0:36:10.60,0:36:13.22,Default,,0,0,0,,Бұл ән менікі ме?
Dialogue: 0,0:36:14.90,0:36:17.74,Default,,0,0,0,,Егер ол күндер болмаса, үмітім үзілетін еді.
Dialogue: 0,0:36:18.18,0:36:21.26,Default,,0,0,0,,Ол ешқашан Тартқыш күзет корпусына қосылмас еді.
Dialogue: 0,0:36:21.26,0:36:24.50,Default,,0,0,0,,Сендердің арқаларыңда мен енді құлаудан сақтандым.
Dialogue: 0,0:36:26.50,0:36:28.52,Default,,0,0,0,,Қайғылы оқиға қайталанады
Dialogue: 0,0:36:30.16,0:36:31.18,Default,,0,0,0,,Қандай ұят
Dialogue: 0,0:36:39.03,0:36:44.91,Default,,0,0,0,,Демек, бүгін таңертеңгі қоқыс құлауы Әсеркенің жоспары болса керек.
Dialogue: 0,0:36:45.31,0:36:46.47,Default,,0,0,0,,Әлі дәлел жоқ
Dialogue: 0,0:36:47.29,0:36:48.61,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:36:49.19,0:36:53.03,Default,,0,0,0,,Техникалық қызмет көрсететін кеменің көлігі орманда қалдырылды.
Dialogue: 0,0:36:53.71,0:36:56.49,Default,,0,0,0,,Сізге қашуға біреу көмектесіп жатқан сияқты.
Dialogue: 0,0:36:57.07,0:37:00.17,Default,,0,0,0,,Қарғыс атсын, Мартлиц.
Dialogue: 0,0:37:01.05,0:37:04.53,Default,,0,0,0,,Кішкене болса да шынайылық танытуым аңғалдық болды ма?
Dialogue: 0,0:37:05.81,0:37:07.29,Default,,0,0,0,,Спорттық ойын
Dialogue: 0,0:37:08.15,0:37:08.87,Default,,0,0,0,,...
Dialogue: 0,0:37:09.57,0:37:12.43,Default,,0,0,0,,Пышақтың сізді бірінші оятуына жол бермеңіз.
Dialogue: 0,0:37:12.43,0:37:16.03,Default,,0,0,0,,Мақсатты тұлға Лакоалис Леройдың қашатын жерін болжаңыз
Dialogue: 0,0:37:16.57,0:37:17.93,Default,,0,0,0,,Басқа күні бақылау
Dialogue: 0,0:37:18.71,0:37:20.23,Default,,0,0,0,,Доктор Леройдың қызы
Dialogue: 0,0:37:21.11,0:37:22.69,Default,,0,0,0,,Жұлдыздық қан кристалы?
Dialogue: 0,0:37:23.23,0:37:24.97,Default,,0,0,0,,Ол ұзақ уақыт бойы борттың қарауында болды.
Dialogue: 0,0:37:24.97,0:37:26.75,Default,,0,0,0,,Бұл сөздікте ешқандай претензия жоқ.
Dialogue: 0,0:37:27.85,0:37:30.41,Default,,0,0,0,,Сарай патшасы да жасырылған ба?
Dialogue: 0,0:37:30.93,0:37:31.71,Default,,0,0,0,,Муртел
Dialogue: 0,0:37:37.29,0:37:41.91,Default,,0,0,0,,Ой, маған ескерту жасалып жатыр.
Dialogue: 0,0:37:43.03,0:37:48.53,Default,,0,0,0,,Рұқсат етілмеген адамдар мен қарулы адамдардың ғимаратқа кіруіне рұқсат етілмейді.
Dialogue: 0,0:37:50.94,0:37:53.88,Default,,0,0,0,,Толық гвардиялық корпусты басқару санатын растау
Dialogue: 0,0:37:56.25,0:37:57.45,Default,,0,0,0,,Бәрібір барайық.
Dialogue: 0,0:37:58.32,0:37:59.46,Default,,0,0,0,,Кодты растау
Dialogue: 0,0:38:00.98,0:38:04.22,Default,,0,0,0,,B5 актері капитан Ксенакис 1 адам
Dialogue: 0,0:38:08.20,0:38:09.08,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:38:09.84,0:38:11.20,Default,,0,0,0,,Межелі бағытты өзгерту
Dialogue: 0,0:38:11.82,0:38:15.46,Default,,0,0,0,,Шетелдік контейнер әкемнің зертханасына айналма жолмен барсын.
Dialogue: 0,0:38:16.36,0:38:18.46,Default,,0,0,0,,Осыдан кейін бастапқы бағытқа дұрыс оралыңыз.
Dialogue: 0,0:38:18.46,0:38:20.80,Default,,0,0,0,,Риодо туралы жазбалар жоқ.
Dialogue: 0,0:38:20.80,0:38:22.04,Default,,0,0,0,,Шпиондық фильмге ұқсайды
Dialogue: 0,0:38:22.50,0:38:23.90,Default,,0,0,0,,Мен үйреніп қалдым.
Dialogue: 0,0:38:23.90,0:38:25.98,Default,,0,0,0,,Анаңды сағынсаң
Dialogue: 0,0:38:25.98,0:38:28.00,Default,,0,0,0,,Әкем жұмысқа барғысы келеді, солай ма?
Dialogue: 0,0:38:29.06,0:38:31.40,Default,,0,0,0,,Мұны өзіңіз жасаңыз...
Dialogue: 0,0:38:31.40,0:38:34.94,Default,,0,0,0,,Үйде жылап жатқанымды көргенде әкем айтты.
Dialogue: 0,0:38:36.12,0:38:38.84,Default,,0,0,0,,Анашым, кешіріңіз.
Dialogue: 0,0:38:39.30,0:38:42.10,Default,,0,0,0,,Оған көмектесу мүмкін емес, менің әкем бар.
Dialogue: 0,0:38:42.58,0:38:46.60,Default,,0,0,0,,Виго сияқты. Мен Pull Guard командасымен жақсы араластым.
Dialogue: 0,0:38:47.06,0:38:49.94,Default,,0,0,0,,Көптеген адамдарды құлаған қоқыстан құтқарыңыз
Dialogue: 0,0:38:50.52,0:38:52.46,Default,,0,0,0,,Менің әкем де маған көп қолдау көрсетеді.
Dialogue: 0,0:38:54.28,0:38:56.10,Default,,0,0,0,,Ұмытасың ба?
Dialogue: 0,0:39:00.21,0:39:00.94,Default,,0,0,0,,Әке?
Dialogue: 0,0:39:02.88,0:39:03.98,Default,,0,0,0,,Қағаз?
Dialogue: 0,0:39:05.99,0:39:07.39,Default,,0,0,0,,Сіз жоқсыз ба?
Dialogue: 0,0:39:11.59,0:39:12.79,Default,,0,0,0,,Танысқанымызға біраз болды ма?
Dialogue: 0,0:39:13.83,0:39:18.09,Default,,0,0,0,,Бала кезімде осында келіп ойнайтынмын.
Dialogue: 0,0:39:18.67,0:39:20.71,Default,,0,0,0,,Әкемнің маған жасаған ойыны
Dialogue: 0,0:39:26.09,0:39:27.11,Default,,0,0,0,,Не болды?
Dialogue: 0,0:39:27.33,0:39:29.71,Default,,0,0,0,,Мен ойнаған ойынды тексеріңіз.
Dialogue: 0,0:39:33.29,0:39:37.17,Default,,0,0,0,,Бұл шынымен ойын ма? Бұл шынымен де керемет.
Dialogue: 0,0:39:37.28,0:39:39.26,Default,,0,0,0,,Мақсат M9103
Dialogue: 0,0:39:39.63,0:39:40.84,Default,,0,0,0,,Массалық категория 5
Dialogue: 0,0:39:40.84,0:39:43.38,Default,,0,0,0,,Құлау бұрышы қазір түзетілуде.
Dialogue: 0,0:39:45.31,0:39:48.45,Default,,0,0,0,,Дәл солай... Бұл сұмдық.
Dialogue: 0,0:39:50.99,0:39:53.17,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,0:39:55.11,0:40:01.09,Default,,0,0,0,,Оңтайлы бекітілген орынды анықтайтын сандар да тамаша сәйкес келеді. Бұл әуе шайқасы емес.
Dialogue: 0,0:40:02.85,0:40:08.69,Default,,0,0,0,,Қайта-қайта сәтсіздікке ұшырап, оны тазартқаннан кейін жазбаны жаңарту үшін
Dialogue: 0,0:40:08.69,0:40:12.19,Default,,0,0,0,,Әкемнің мені мақтағанына қуаныштымын.
Dialogue: 0,0:40:12.19,0:40:15.67,Default,,0,0,0,,Сондықтан мен ойнай бердім
Dialogue: 0,0:40:16.93,0:40:20.37,Default,,0,0,0,,Менің денем 6-ны еске түсірді
Dialogue: 0,0:40:20.37,0:40:20.57,Default,,0,0,0,,6
Dialogue: 0,0:40:21.17,0:40:21.45,Default,,0,0,0,,5
Dialogue: 0,0:40:21.81,0:40:26.47,Default,,0,0,0,,4…3…2…1…нөл
Dialogue: 0,0:40:22.07,0:40:22.19,Default,,0,0,0,,4
Dialogue: 0,0:40:27.15,0:40:28.35,Default,,0,0,0,,Миссияның сәтсіздігі
Dialogue: 0,0:40:32.91,0:40:37.03,Default,,0,0,0,,Бұл видео...Қанша көрсем де үйрене алмай жүрмін.
Dialogue: 0,0:40:38.93,0:40:40.51,Default,,0,0,0,,Бұл өте қорқынышты болды.
Dialogue: 0,0:40:42.75,0:40:45.81,Default,,0,0,0,,Егер біз бүгін таңертең шатассақ
Dialogue: 0,0:40:48.41,0:40:49.67,Default,,0,0,0,,Бұл оқиға болды
Dialogue: 0,0:40:51.81,0:40:56.81,Default,,0,0,0,,♪~
Dialogue: 0,0:40:57.47,0:40:57.97,Default,,0,0,0,,Ах
Dialogue: 0,0:40:59.81,0:41:00.21,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:41:01.91,0:41:04.39,Default,,0,0,0,,Сен бүгін таңертең жақсы істедің, Рако.
Dialogue: 0,0:41:05.49,0:41:07.59,Default,,0,0,0,,Бірақ нақты нәрсе осы жерден басталады
Dialogue: 0,0:41:07.82,0:41:08.82,Default,,0,0,0,,не үшін шайқасып жүрсің?
Dialogue: 0,0:41:10.07,0:41:15.31,Default,,0,0,0,,Кешіріңіз, бұл қорқынышты аяқталу әлі жойылған жоқ.
Dialogue: 0,0:41:16.31,0:41:17.79,Default,,0,0,0,,Мен мұны ақыры білдім.
Dialogue: 0,0:41:18.91,0:41:20.63,Default,,0,0,0,,Бұдан басқа, оны ойынға айналдыру мүмкін емес.
Dialogue: 0,0:41:21.99,0:41:24.61,Default,,0,0,0,,Белгілі бір нүктеден болашақты анықтау мүмкін емес.
Dialogue: 0,0:41:26.09,0:41:28.87,Default,,0,0,0,,Сен келгенде, Йо-кун.
Dialogue: 0,0:41:30.69,0:41:31.09,Default,,0,0,0,,Мен...
Dialogue: 0,0:41:30.71,0:41:33.87,Default,,0,0,0,,Мен Йоның атын айттым ба?
Dialogue: 0,0:41:34.25,0:41:34.73,Default,,0,0,0,,(Сора) Ах, бірақ… (Стефани) О!
Dialogue: 0,0:41:36.47,0:41:37.19,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:41:37.19,0:41:37.71,Default,,0,0,0,,Юо-кун
Dialogue: 0,0:41:38.55,0:41:39.75,Default,,0,0,0,,Сыртқы түріңмен
Dialogue: 0,0:41:40.27,0:41:43.15,Default,,0,0,0,,Себеп пен салдар анықталмаған циклге енеді
Dialogue: 0,0:41:43.57,0:41:44.19,Default,,0,0,0,,Фактілер
Dialogue: 0,0:41:44.77,0:41:48.11,Default,,0,0,0,,Бүгінгі таңның қоқысы да екі адамның өз күшімен болашақты өзгертуінің нәтижесі.
Dialogue: 0,0:41:49.65,0:41:50.23,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:41:50.95,0:41:53.47,Default,,0,0,0,,Сол қорқынышты болашақтың алдын алу үшін бірге жұмыс жасайық.
Dialogue: 0,0:42:11.70,0:42:15.16,Default,,0,0,0,,қанын кристаллизациялау үшін екенін білемін.
Dialogue: 0,0:42:16.08,0:42:21.20,Default,,0,0,0,,Бірақ Юки мұны істей алмайды, өйткені оның күші жетпейді.
Dialogue: 0,0:42:21.98,0:42:30.12,Default,,0,0,0,,Бұл энергияның қажетті мөлшері тек теориялық бірлік болғанымен, қазір ол шын мәнінде бар.
Dialogue: 0,0:42:31.56,0:42:35.22,Default,,0,0,0,,Real Ride Бұл екеуіңнің күштерің туралы.
Dialogue: 0,0:42:36.34,0:42:39.22,Default,,0,0,0,,Кристалл ұрпақ - болашақты сақтаудың кілті
Dialogue: 0,0:42:44.44,0:42:47.06,Default,,0,0,0,,Маған күш-қуатыңызды беріңізші.
Dialogue: 0,0:42:48.44,0:42:53.68,Default,,0,0,0,,Әке бұлай түсіндірместен бірдеңе сұрайтын адам емес.
Dialogue: 0,0:42:54.58,0:42:56.74,Default,,0,0,0,,Маған қауіп төндіретін адам емес.
Dialogue: 0,0:42:58.19,0:43:01.73,Default,,0,0,0,,Сондықтан мен папаға сенемін.
Dialogue: 0,0:43:02.76,0:43:07.34,Default,,0,0,0,,Сенесіз бе? Бұл сенсің, солай емес пе?
Dialogue: 0,0:43:14.13,0:43:17.23,Default,,0,0,0,,Біздің жүрегіміз... біртұтас болсын!
Dialogue: 0,0:43:24.90,0:43:25.82,Default,,0,0,0,,Жылжы!
Dialogue: 0,0:43:28.19,0:43:29.67,Default,,0,0,0,,Ал взвод қайда?
Dialogue: 0,0:44:08.29,0:44:10.25,Default,,0,0,0,,Орын…
Dialogue: 0,0:44:18.70,0:44:20.24,Default,,0,0,0,,Екеуіңізге де рахмет
Dialogue: 0,0:44:23.50,0:44:26.30,Default,,0,0,0,,Мен жұлдызды қан кристалын жаңа ғана көшіріп алдым.
Dialogue: 0,0:44:29.22,0:44:30.66,Default,,0,0,0,,Жұлдыздық қан кристалы
Dialogue: 0,0:44:30.66,0:44:32.82,Default,,0,0,0,,Жұлдыз қан түйіндерінен жасалған
Dialogue: 0,0:44:33.68,0:44:35.42,Default,,0,0,0,,Бұл бірінші финал.
Dialogue: 0,0:44:36.60,0:44:40.08,Default,,0,0,0,,Кеса Мен Лаконың аурисінде бір нәрсе сақтадым.
Dialogue: 0,0:44:41.16,0:44:41.52,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:44:46.96,0:44:50.36,Default,,0,0,0,,Өтірік пе?
Dialogue: 0,0:44:51.88,0:44:55.10,Default,,0,0,0,,Менде содан бері бар.
Dialogue: 0,0:44:55.70,0:44:59.28,Default,,0,0,0,,Екеуі өскендіктен мұнда келдің.
Dialogue: 0,0:44:59.98,0:45:01.32,Default,,0,0,0,,Кристаллдың күші
Dialogue: 0,0:45:03.48,0:45:06.42,Default,,0,0,0,,Бұл себеп пен салдардың анықталмаған циклі.
Dialogue: 0,0:45:06.80,0:45:09.34,Default,,0,0,0,,Осы екеуін келесі жолы қолдансаңыз
Dialogue: 0,0:45:09.34,0:45:11.50,Default,,0,0,0,,Сіз бұл ойынның болашағын өзгерте аласыз ба?
Dialogue: 0,0:45:12.82,0:45:16.04,Default,,0,0,0,,Рако мұны істей алады, оған күн керек.
Dialogue: 0,0:45:17.24,0:45:19.52,Default,,0,0,0,,Түсінікті Мен сенімдімін
Dialogue: 0,0:45:20.52,0:45:23.30,Default,,0,0,0,,Қандай жағдай болса да, сенуден бас тартпа
Dialogue: 0,0:45:24.78,0:45:26.46,Default,,0,0,0,,Және ұмытпаңыз
Dialogue: 0,0:45:26.46,0:45:30.64,Default,,0,0,0,,Егер кристалды жіберсең, күн жерге қайтады.
Dialogue: 0,0:45:31.72,0:45:35.08,Default,,0,0,0,,Жұлдыз қанының түйіні бізді байланыстырады.
Dialogue: 0,0:45:35.84,0:45:36.56,Default,,0,0,0,,Күте тұрыңыз, әке!
Dialogue: 0,0:45:38.10,0:45:41.48,Default,,0,0,0,,Осы уақытқа дейін Виго-кун осында табылған күзетшіге келді.
Dialogue: 0,0:45:43.48,0:45:48.38,Default,,0,0,0,,Оның соңынан еріңіз
Dialogue: 0,0:45:55.40,0:45:55.84,Default,,0,0,0,,Заку!
Dialogue: 0,0:45:56.94,0:45:57.50,Default,,0,0,0,,Сіз қауіпсізсіз бе?
Dialogue: 0,0:45:58.21,0:45:58.71,Default,,0,0,0,,Бибо!
Dialogue: 0,0:46:00.90,0:46:02.74,Default,,0,0,0,,Менің қолымнан келетіні осы
Dialogue: 0,0:46:03.98,0:46:05.02,Default,,0,0,0,,Екі адам мәңгілік
Dialogue: 0,0:46:05.02,0:46:06.42,Default,,0,0,0,,Мен саған қарағым келді, бірақ
Dialogue: 0,0:46:07.64,0:46:08.78,Default,,0,0,0,,Осыдан кейін
Dialogue: 0,0:46:09.24,0:46:10.56,Default,,0,0,0,,Ол менің нағыз әкем.
Dialogue: 0,0:46:10.56,0:46:12.44,Default,,0,0,0,,Сіздің кезегіңіз
Dialogue: 0,0:46:14.28,0:46:15.44,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:46:16.42,0:46:18.56,Default,,0,0,0,,Мен сізге ризамын
Dialogue: 0,0:46:24.70,0:46:27.34,Default,,0,0,0,,Банкіңіз келгенде не болады?
Dialogue: 0,0:46:29.12,0:46:31.56,Default,,0,0,0,,Тағдыр біз жақта
Dialogue: 0,0:46:36.44,0:46:38.64,Default,,0,0,0,,Бұрынғы қалыптан тыс соққы толқыны болды
Dialogue: 0,0:46:38.64,0:46:40.86,Default,,0,0,0,,Екі елдің әскерилері анық анықтаған
Dialogue: 0,0:46:41.88,0:46:43.12,Default,,0,0,0,,Бұл сендер де болдыңдар.
Dialogue: 0,0:46:44.08,0:46:44.76,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:46:45.34,0:46:46.90,Default,,0,0,0,,Толық түсіндірмені кейін тыңдайық.
Dialogue: 0,0:46:47.74,0:46:48.72,Default,,0,0,0,,Қалай болғанда да, бұл
Dialogue: 0,0:46:49.52,0:46:51.96,Default,,0,0,0,,Енді жер бетінде қауіпсіз орын жоқ
Dialogue: 0,0:46:57.60,0:46:58.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:59.12,0:46:59.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:47:01.06,0:47:02.78,Default,,0,0,0,,Сіз аздап шаршаған сияқтысыз.
Dialogue: 0,0:47:03.92,0:47:04.60,Default,,0,0,0,,Жарайды
Dialogue: 0,0:47:05.16,0:47:06.04,Default,,0,0,0,,Баратын жер бар
Dialogue: 0,0:47:06.68,0:47:08.08,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:47:09.50,0:47:10.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:47:21.76,0:47:23.66,Default,,0,0,0,,Мен қатты ұйықтаймын
Dialogue: 0,0:47:24.18,0:47:27.16,Default,,0,0,0,,Мен үнемі артта жүрумен айналысқаным үшін емес.
Dialogue: 0,0:47:28.66,0:47:30.82,Default,,0,0,0,,Мен жақында Игоға айтуым керек.
Dialogue: 0,0:47:32.16,0:47:34.02,Default,,0,0,0,,Жұлдыздық қан кристалдары туралы
Dialogue: 0,0:47:35.32,0:47:37.46,Default,,0,0,0,,Сонымен қатар ойынның аяқталуы туралы.
Dialogue: 0,0:47:38.14,0:47:39.48,Default,,0,0,0,,Енді аздап ұйықта.
Dialogue: 0,0:47:40.54,0:47:42.18,Default,,0,0,0,,Оянғанда бірге айтайық.
Dialogue: 0,0:47:44.88,0:47:45.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:47:47.90,0:47:48.52,Default,,0,0,0,,Йо
Dialogue: 0,0:48:08.92,0:48:10.54,Default,,0,0,0,,Лако Лако
Dialogue: 0,0:48:11.96,0:48:12.28,Default,,0,0,0,,Лако
Dialogue: 0,0:48:17.16,0:48:18.90,Default,,0,0,0,,Жақында біз сонда боламыз
Dialogue: 0,0:48:18.90,0:48:21.56,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:48:22.74,0:48:23.98,Default,,0,0,0,,Дауыс шығады
Dialogue: 0,0:48:24.48,0:48:25.46,Default,,0,0,0,,Лаконың денесі?
Dialogue: 0,0:48:26.80,0:48:28.18,Default,,0,0,0,,Мен оны басқарып жатырмын ба?
Dialogue: 0,0:48:30.96,0:48:32.52,Default,,0,0,0,,Басқару спутнигі.
Dialogue: 0,0:48:33.42,0:48:35.32,Default,,0,0,0,,Бұл біраз тосын болады.
Dialogue: 0,0:48:36.50,0:48:38.56,Default,,0,0,0,,Бірақ мен Лакоға сенемін
Dialogue: 0,0:48:42.18,0:48:42.96,Default,,0,0,0,,Теңіз құмырасы ояу болғанда
Dialogue: 0,0:48:42.96,0:48:46.24,Default,,0,0,0,,Тірі қалғанша бар күшімді салудан басқа амалым жоқ
Dialogue: 0,0:48:47.70,0:48:49.42,Default,,0,0,0,,Bonasocius көлігіндегі қалыптан тыс әсер ету
Dialogue: 0,0:48:49.04,0:48:52.12,Default,,0,0,0,,Таңқаларлық құбылысқа байланысты желі қателерін анықтау жалғасуда.
Dialogue: 0,0:48:52.12,0:48:55.44,Default,,0,0,0,,Сәл бұрын басқару спутнигі бізге хабарласты.
Dialogue: 0,0:48:55.44,0:48:56.82,Default,,0,0,0,,Байланыстың бұзылуына байланысты тоқтатылды
Dialogue: 0,0:48:57.94,0:49:01.30,Default,,0,0,0,,Бірінен-бірі екі қатенің болуы кездейсоқтық па?
Dialogue: 0,0:49:01.30,0:49:04.78,Default,,0,0,0,,Асрекка аспаны Бонасоцийдің айналасында расталды
Dialogue: 0,0:49:05.26,0:49:08.06,Default,,0,0,0,,Сәулелерге дайындалатын кез келді.
Dialogue: 0,0:49:09.20,0:49:10.66,Default,,0,0,0,,Ақымақ Әскер
Dialogue: 0,0:49:10.29,0:49:11.11,Default,,0,0,0,,Міне.
Dialogue: 0,0:49:12.09,0:49:13.53,Default,,0,0,0,,Бонасоцийді іздеу
Dialogue: 0,0:49:13.53,0:49:15.01,Default,,0,0,0,,Блэйд армиясымен шайқаста
Dialogue: 0,0:49:15.33,0:49:16.43,Default,,0,0,0,,Бізде қиындықтар бар.
Dialogue: 0,0:49:17.01,0:49:17.93,Default,,0,0,0,,Соққы толқындары туралы
Dialogue: 0,0:49:18.27,0:49:19.43,Default,,0,0,0,,Bonasocius ішкі
Dialogue: 0,0:49:19.43,0:49:20.67,Default,,0,0,0,,Ағаш сөреден есеп жоқ.
Dialogue: 0,0:49:21.01,0:49:22.33,Default,,0,0,0,,Байланыс жоғалды
Dialogue: 0,0:49:22.97,0:49:24.73,Default,,0,0,0,,Пышақпен ұсталды ма?
Dialogue: 0,0:49:25.27,0:49:26.99,Default,,0,0,0,,Немесе қазірдің өзінде
Dialogue: 0,0:49:26.99,0:49:28.51,Default,,0,0,0,,Мен аударылып жатырмын деп ойладым
Dialogue: 0,0:49:29.51,0:49:33.63,Default,,0,0,0,,Буллард трагедияны қайталағысы келеді.
Dialogue: 0,0:50:04.53,0:50:08.41,Default,,0,0,0,,Мен сенің жаныңдамын, сен маған.
Dialogue: 0,0:50:09.49,0:50:12.25,Default,,0,0,0,,Соғыстың келеңсіз мұрасының салдарынан ата-анамыздан айырылғаннан кейін екеуміз де аман қала аламыз.
Dialogue: 0,0:50:12.25,0:50:14.75,Default,,0,0,0,,Ғаламшарды қорғауға тырысатын дос.
Dialogue: 0,0:50:15.55,0:50:17.17,Default,,0,0,0,,О, мм... колготки
Dialogue: 0,0:50:16.79,0:50:19.79,Default,,0,0,0,,Капитан... Рако қазір...
Dialogue: 0,0:50:25.21,0:50:25.65,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:50:28.55,0:50:29.51,Default,,0,0,0,,Гастрольдік жұлдыздар
Dialogue: 0,0:50:31.53,0:50:33.41,Default,,0,0,0,,Әдемі деп ойламайсың ба?
Dialogue: 0,0:50:35.03,0:50:39.79,Default,,0,0,0,,Адамзат соғыстары сол тамаша өлкені өртеп жіберді.
Dialogue: 0,0:50:39.79,0:50:45.11,Default,,0,0,0,,Аспанды қирандылармен жауып, бізді құрып кетудің алдында қалдырды.
Dialogue: 0,0:50:46.95,0:50:49.45,Default,,0,0,0,,Бұл жұлдыздардың қаны үшін соғыс.
Dialogue: 0,0:50:50.91,0:50:54.45,Default,,0,0,0,,Сол соғыс қазір де жалғаса берсе
Dialogue: 0,0:50:54.07,0:50:55.71,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:50:57.49,0:51:01.69,Default,,0,0,0,,24 жылға созылған кенеттен болған шайқас фугаку сегіз сипаты болса.
Dialogue: 0,0:51:03.43,0:51:07.31,Default,,0,0,0,,Біздің ата-анамыз қоқыс құлап өлген жоқ.
Dialogue: 0,0:51:09.07,0:51:10.37,Default,,0,0,0,,Бұл әскери соғыс.
Dialogue: 0,0:51:11.45,0:51:14.09,Default,,0,0,0,,Бұл майдың тамшысы болып бүркенген шабуыл болды.
Dialogue: 0,0:51:16.05,0:51:19.91,Default,,0,0,0,,Бұл соғыс бейбітшілік үшін кемшілік.
Dialogue: 0,0:51:20.87,0:51:22.39,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:51:23.27,0:51:24.65,Default,,0,0,0,,Бүгінгі күнге дейін өмір сүрді
Dialogue: 0,0:51:27.09,0:51:30.45,Default,,0,0,0,,Рако капитанының айтатын маңызды нәрсесі бар.
Dialogue: 0,0:51:31.15,0:51:32.71,Default,,0,0,0,,Мен қалай жауап бере аламын?
Dialogue: 0,0:51:33.21,0:51:36.15,Default,,0,0,0,,Кел, саған көрсететін бір нәрсем бар.
Dialogue: 0,0:51:36.15,0:51:38.13,Default,,0,0,0,,(Кёсукэ Хори) Егер әке кетіп қалса—
Dialogue: 0,0:51:38.13,0:51:40.63,Default,,0,0,0,,Бірақ психикалық тұрғыдан дайын
Dialogue: 0,0:51:45.75,0:51:46.59,Default,,0,0,0,,Кірмеңіз
Dialogue: 0,0:51:52.81,0:51:56.19,Default,,0,0,0,,Ең соңғы ұшырылатын ұшақ Әуе.
Dialogue: 0,0:51:56.67,0:51:58.63,Default,,0,0,0,,Pull Guard-пен салыстыруға болмайды
Dialogue: 0,0:51:59.13,0:52:01.41,Default,,0,0,0,,мүлдем басқа деңгейде өнімділікке ие
Dialogue: 0,0:52:02.07,0:52:05.09,Default,,0,0,0,,Бірақ ол әлі басталған жоқ.
Dialogue: 0,0:52:08.21,0:52:10.51,Default,,0,0,0,,Мүмкін емес үлкен энергия тұтыну және
Dialogue: 0,0:52:10.51,0:52:13.31,Default,,0,0,0,,Себебі ол артқы жүруді ескере отырып жасалған.
Dialogue: 0,0:52:14.27,0:52:17.83,Default,,0,0,0,,Оның үстіне жұлдыздар елінің кристалы әлі біткен жоқ.
Dialogue: 0,0:52:19.81,0:52:21.31,Default,,0,0,0,,Бірақ егер сіз
Dialogue: 0,0:52:22.31,0:52:25.27,Default,,0,0,0,,Мұны жылжыту арқылы қалпына келтіруге болады.
Dialogue: 0,0:52:25.89,0:52:28.59,Default,,0,0,0,,Жоспарды бүлдірдіңдер
Dialogue: 0,0:52:30.23,0:52:32.61,Default,,0,0,0,,MQ-103 көңілді қалдырды
Dialogue: 0,0:52:33.79,0:52:37.17,Default,,0,0,0,,ЕБҚ-ны сол қоқыстарға бекіту қиын болды.
Dialogue: 0,0:52:38.53,0:52:41.11,Default,,0,0,0,,...
Dialogue: 0,0:52:43.29,0:52:45.33,Default,,0,0,0,,Жұлдыздар елінде тізбекті жарылыс тудырыңыз
Dialogue: 0,0:52:45.85,0:52:47.43,Default,,0,0,0,,Көп сатылы инвестициялық сенімді нұсқаулық таңбалауышы
Dialogue: 0,0:52:48.07,0:52:49.83,Default,,0,0,0,,Массасы 5-разряд болса
Dialogue: 0,0:52:49.83,0:52:52.27,Default,,0,0,0,,Кен сағасының түбіндегі Жұлдызды теңізге бату
Dialogue: 0,0:52:53.05,0:52:55.11,Default,,0,0,0,,Егер сіз EVC бастасаңыз
Dialogue: 0,0:52:55.47,0:52:57.63,Default,,0,0,0,,Жұлдыздар елінің жоғалуы басталады
Dialogue: 0,0:52:58.99,0:53:04.81,Default,,0,0,0,,Еске алу күні баршаның көз алдында әлемді түбегейлі өзгерту мүмкіндігі болды.
Dialogue: 0,0:53:06.11,0:53:10.95,Default,,0,0,0,,Адамзаттың аман қалу үшін соғысуды тоқтатып, бір-біріне көмектесуден басқа амалы қалмайды.
Dialogue: 0,0:53:12.27,0:53:15.07,Default,,0,0,0,,Бұл тамаша жоспар болды.
Dialogue: 0,0:53:16.47,0:53:17.25,Default,,0,0,0,,Мен өкінемін
Dialogue: 0,0:53:16.88,0:53:18.14,Default,,0,0,0,,Мен өкінемін
Dialogue: 0,0:53:18.78,0:53:21.24,Default,,0,0,0,,Бұл жоспарды басынан бастап айтқан болсақ.
Dialogue: 0,0:53:21.92,0:53:23.74,Default,,0,0,0,,Мазасыздық жоқ
Dialogue: 0,0:53:24.48,0:53:25.04,Default,,0,0,0,,Лако
Dialogue: 0,0:53:25.60,0:53:26.80,Default,,0,0,0,,Бұл қорқынышты, Рако.
Dialogue: 0,0:53:28.46,0:53:29.08,Default,,0,0,0,,Лако
Dialogue: 0,0:53:30.02,0:53:31.54,Default,,0,0,0,,Егер антенна қозғалса
Dialogue: 0,0:53:31.54,0:53:33.14,Default,,0,0,0,,Енді қоқыс қажет емес
Dialogue: 0,0:53:34.40,0:53:35.86,Default,,0,0,0,,EBC тікелей тасымалдау
Dialogue: 0,0:53:35.86,0:53:36.80,Default,,0,0,0,,Жарылу
Dialogue: 0,0:53:36.80,0:53:38.56,Default,,0,0,0,,Жоқ, капитан.
Dialogue: 0,0:53:39.00,0:53:40.70,Default,,0,0,0,,Бұл стратегия мені алаңдатады.
Dialogue: 0,0:53:41.12,0:53:43.90,Default,,0,0,0,,Маған доктор Леруа айтты.
Dialogue: 0,0:53:44.38,0:53:45.84,Default,,0,0,0,,Қан буланып кетсе де
Dialogue: 0,0:53:46.88,0:53:49.26,Default,,0,0,0,,Сақталмаған, жойылған
Dialogue: 0,0:53:52.86,0:53:55.12,Default,,0,0,0,,Бұл стратегияны алғаш рет ұсынған
Dialogue: 0,0:53:55.12,0:53:56.62,Default,,0,0,0,,Доктор Леруа?
Dialogue: 0,0:53:58.06,0:54:00.38,Default,,0,0,0,,Бұл оның 15 жыл бұрынғы қағазы.
Dialogue: 0,0:54:01.20,0:54:03.44,Default,,0,0,0,,Біз бұл теорияны қолдаймыз
Dialogue: 0,0:54:04.06,0:54:06.30,Default,,0,0,0,,Ал енді біз оны дәлелдейміз.
Dialogue: 0,0:54:06.88,0:54:08.94,Default,,0,0,0,,Рако, оян, Рако.
Dialogue: 0,0:54:10.56,0:54:11.22,Default,,0,0,0,,Лако
Dialogue: 0,0:54:13.96,0:54:14.92,Default,,0,0,0,,Капитан
Dialogue: 0,0:54:14.92,0:54:18.50,Default,,0,0,0,,Мен...
Dialogue: 0,0:54:20.10,0:54:22.26,Default,,0,0,0,,Жұлдыз қанының кристалдық күшімен
Dialogue: 0,0:54:22.74,0:54:24.98,Default,,0,0,0,,Лаконың жүрегіне жол сілтеді
Dialogue: 0,0:54:24.98,0:54:25.74,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:54:26.56,0:54:26.98,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:54:27.14,0:54:27.98,Default,,0,0,0,,Бұл...
Dialogue: 0,0:54:27.98,0:54:31.22,Default,,0,0,0,,Мегури жұлдызын қорқынышты күйреуден құтқару.
Dialogue: 0,0:54:32.46,0:54:34.46,Default,,0,0,0,,Сіз құбыжықсыз
Dialogue: 0,0:54:41.92,0:54:43.12,Default,,0,0,0,,Не болды, Рюзаки?
Dialogue: 0,0:54:43.86,0:54:44.92,Default,,0,0,0,,Жұлдызды кристал
Dialogue: 0,0:54:46.44,0:54:47.16,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:54:47.16,0:54:49.20,Default,,0,0,0,,Сол соққы толқынының қалыптан тыс көру өткірлігі болып табылады
Dialogue: 0,0:54:49.20,0:54:50.40,Default,,0,0,0,,Соған байланысты ма?
Dialogue: 0,0:54:51.34,0:54:52.78,Default,,0,0,0,,Жақсы мәміле болса
Dialogue: 0,0:54:52.78,0:54:54.82,Default,,0,0,0,,Мен антеннаны жылжыта аламын.
Dialogue: 0,0:54:55.34,0:54:56.22,Default,,0,0,0,,Оны маған беріңіз
Dialogue: 0,0:54:56.22,0:54:59.14,Default,,0,0,0,,Мен мұны аяқтамаймын.
Dialogue: 0,0:54:59.60,0:55:01.38,Default,,0,0,0,,Мен және Ракон
Dialogue: 0,0:55:01.38,0:55:02.74,Default,,0,0,0,,Өйткені ол екі адамды байланыстырады.
Dialogue: 0,0:55:04.02,0:55:06.80,Default,,0,0,0,,Мен соғысты тоқтату үшін бәрін жасаймын
Dialogue: 0,0:55:07.54,0:55:10.92,Default,,0,0,0,,Бала кездегі досын ұрса да
Dialogue: 0,0:55:17.44,0:55:17.94,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:55:17.94,0:55:19.63,Default,,0,0,0,,Ляко! Оян!
Dialogue: 0,0:55:20.55,0:55:22.73,Default,,0,0,0,,Мен ешқашан мұндай нәрсеге қол тигізген емеспін.
Dialogue: 0,0:55:22.73,0:55:24.46,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:55:25.03,0:55:27.01,Default,,0,0,0,,Оянсаң ше...?
Dialogue: 0,0:55:28.07,0:55:30.82,Default,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,0:55:30.82,0:55:32.71,Default,,0,0,0,,Жарық жасыл, Ято-сан.
Dialogue: 0,0:55:49.75,0:55:52.65,Default,,0,0,0,,Бұл қорқынышты, Эйр-кун.
Dialogue: 0,0:55:53.23,0:55:55.01,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:55:55.90,0:55:58.92,Default,,0,0,0,,От жауды!?
Dialogue: 0,0:55:59.31,0:56:01.21,Default,,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,0:56:02.99,0:56:04.99,Default,,0,0,0,,Лакон
Dialogue: 0,0:56:04.99,0:56:06.27,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:56:07.23,0:56:07.99,Default,,0,0,0,,Лакон…
Dialogue: 0,0:56:08.51,0:56:09.37,Default,,0,0,0,,Ракон!
Dialogue: 0,0:56:10.35,0:56:10.73,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:56:11.93,0:56:12.53,Default,,0,0,0,,Лакон
Dialogue: 0,0:56:13.63,0:56:14.99,Default,,0,0,0,,Қорқынышты нәрсе...
Dialogue: 0,0:56:15.97,0:56:17.33,Default,,0,0,0,,Ларкюн
Dialogue: 0,0:56:20.05,0:56:21.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:56:23.79,0:56:25.03,Default,,0,0,0,,Мен сендім...
Dialogue: 0,0:56:28.01,0:56:30.05,Default,,0,0,0,,Мен сенсем де
Dialogue: 0,0:56:30.89,0:56:32.29,Default,,0,0,0,,Лачу
Dialogue: 0,0:56:33.91,0:56:35.21,Default,,0,0,0,,Шығу
Dialogue: 0,0:56:36.36,0:56:38.40,Default,,0,0,0,,Уф, суық қой!
Dialogue: 0,0:56:39.27,0:56:41.03,Default,,0,0,0,,Менің ішімнен
Dialogue: 0,0:56:43.89,0:56:45.09,Default,,0,0,0,,Шық!
Dialogue: 0,0:57:05.13,0:57:09.61,Default,,0,0,0,,Бұл жердің жұлдызды кристалы
Dialogue: 0,0:57:14.09,0:57:18.55,Default,,0,0,0,,Виго Әлем қорқынышты.
Dialogue: 0,0:57:21.76,0:57:22.67,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:57:24.01,0:57:27.50,Default,,0,0,0,,Жүйке жануары? Жарайды, мен бұл үшін несие аламын.
Dialogue: 0,0:57:28.71,0:57:32.00,Default,,0,0,0,,Өйткені ол антенналарды іске қоса алады.
Dialogue: 0,0:57:35.21,0:57:36.19,Default,,0,0,0,,Кеттік, Виго.
Dialogue: 0,0:57:38.00,0:57:41.46,Default,,0,0,0,,Бұл жолы жұлдыздың қанын буландырыңыз.
Dialogue: 0,0:57:42.80,0:57:43.15,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:57:45.59,0:57:46.28,Default,,0,0,0,,Виго
Dialogue: 0,0:57:51.31,0:57:52.47,Default,,0,0,0,,Лако…
Dialogue: 0,0:57:57.17,0:57:58.13,Default,,0,0,0,,Йо
Dialogue: 0,0:58:00.27,0:58:01.89,Default,,0,0,0,,Оянғаныңызға қуаныштымын.
Dialogue: 0,0:58:03.19,0:58:06.11,Default,,0,0,0,,Ол кенет жаяу жүргіншілер көпіріне құлап кеткен көрінеді.
Dialogue: 0,0:58:06.85,0:58:07.65,Default,,0,0,0,,Жер?
Dialogue: 0,0:58:09.13,0:58:09.97,Default,,0,0,0,,Лако ше?
Dialogue: 0,0:58:11.27,0:58:12.93,Default,,0,0,0,,Рако сенің досың ба?
Dialogue: 0,0:58:17.43,0:58:17.91,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:58:20.07,0:58:21.87,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:58:23.29,0:58:24.87,Default,,0,0,0,,Мен мұғалімді шақырамын.
Dialogue: 0,0:58:49.17,0:58:51.15,Default,,0,0,0,,Әуеден ұшыру
Dialogue: 0,0:58:54.65,0:58:57.65,Default,,0,0,0,,Ғылыми-зерттеу ғимаратынан Rearride System Exolink
Dialogue: 0,0:58:58.61,0:59:00.55,Default,,0,0,0,,Қашықтан белсендіруді енгізіңіз
Dialogue: 0,0:59:11.42,0:59:12.88,Default,,0,0,0,,Интеграция анық
Dialogue: 0,0:59:14.11,0:59:16.03,Default,,0,0,0,,Sistome іске қосу сәттілігі
Dialogue: 0,0:59:17.88,0:59:19.94,Default,,0,0,0,,Мен сенімен бірге баратын күнім келетінін білмедім.
Dialogue: 0,0:59:21.01,0:59:22.88,Default,,0,0,0,,Біздің істегеніміз өкінішті ме?
Dialogue: 0,0:59:24.36,0:59:26.73,Default,,0,0,0,,Кеттік, апа.
Dialogue: 0,0:59:40.94,0:59:42.74,Default,,0,0,0,,Бұл... антенна...
Dialogue: 0,0:59:45.02,0:59:46.18,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:59:57.06,0:59:59.82,Default,,0,0,0,,Күн шыққанда жер бетіне бас
Dialogue: 0,0:59:59.84,1:00:00.94,Default,,0,0,0,,Басқа нәрсеге айналу
Dialogue: 0,1:00:00.94,1:00:03.44,Default,,0,0,0,,Бұл бата сияқты
Dialogue: 0,1:00:04.40,1:00:07.50,Default,,0,0,0,,Мен өзімді бақытсыз сезінбеймін
Dialogue: 0,1:00:08.58,1:00:09.58,Default,,0,0,0,,Орындайық
Dialogue: 0,1:00:14.65,1:00:17.26,Default,,0,0,0,,Анашым, кешігіп қалдыңыз.
Dialogue: 0,1:00:19.42,1:00:21.23,Default,,0,0,0,,Топ көңілді ме?
Dialogue: 0,1:00:24.11,1:00:25.23,Default,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 0,1:00:27.40,1:00:29.19,Default,,0,0,0,,Мен сонда бола аламын ба?
Dialogue: 0,1:00:30.07,1:00:31.96,Default,,0,0,0,,Мен енді түсінбеймін
Dialogue: 0,1:00:33.73,1:00:34.32,Default,,0,0,0,,Жақында
Dialogue: 0,1:00:33.94,1:00:37.64,Default,,0,0,0,,Соңғы кезде айтып жүргенім осы.
Dialogue: 0,1:00:38.82,1:00:41.64,Default,,0,0,0,,Өзіңізді көп кінәламаңыз.
Dialogue: 0,1:00:42.48,1:00:45.56,Default,,0,0,0,,Тек топтарда емес, барлық жерде.
Dialogue: 0,1:00:46.10,1:00:46.46,Default,,0,0,0,,Мен
Dialogue: 0,1:00:48.62,1:00:52.16,Default,,0,0,0,,Дұрыс, менің анам да жалғыз қалғандай көрінді.
Dialogue: 0,1:00:52.96,1:00:58.26,Default,,0,0,0,,Сіз бұлай ештеңе айта алмаған кезде қандай сезімде болатынын білесіз.
Dialogue: 0,1:00:58.26,1:01:01.40,Default,,0,0,0,,Не айтсаң да өтпейді.
Dialogue: 0,1:01:02.50,1:01:03.84,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,1:01:04.90,1:01:06.38,Default,,0,0,0,,Мен жеткізгім келетін сезімдер
Dialogue: 0,1:01:06.38,1:01:08.14,Default,,0,0,0,,Бұл бар дегенді білдіре ме?
Dialogue: 0,1:01:08.14,1:01:08.60,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:01:11.12,1:01:12.54,Default,,0,0,0,,Мама, мен сізді алып кетуге келе жатырмын.
Dialogue: 0,1:01:21.40,1:01:24.16,Default,,0,0,0,,Раку Бұл менмін.
Dialogue: 0,1:01:25.12,1:01:25.48,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,1:01:27.54,1:01:28.56,Default,,0,0,0,,Ия...
Dialogue: 0,1:01:29.22,1:01:32.76,Default,,0,0,0,,Мен саған сене алмадым
Dialogue: 0,1:01:36.68,1:01:39.04,Default,,0,0,0,,Кешірім сұрайтын менмін
Dialogue: 0,1:01:39.78,1:01:42.04,Default,,0,0,0,,Мен сені жаман сезіндім.
Dialogue: 0,1:01:44.06,1:01:47.24,Default,,0,0,0,,Енді не істеуім керек?
Dialogue: 0,1:01:49.24,1:01:53.44,Default,,0,0,0,,Кешіріңіз, әрі қарай не болатынын білмеймін.
Dialogue: 0,1:01:55.98,1:02:00.82,Default,,0,0,0,,Мұны Рако арқылы жасауға болады. Өзіңіз дұрыс деп санаған болашаққа қарай жылжыңыз.
Dialogue: 0,1:02:02.02,1:02:03.36,Default,,0,0,0,,Өзіңізге сеніңіз
Dialogue: 0,1:02:05.78,1:02:08.54,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,1:02:10.52,1:02:14.08,Default,,0,0,0,,Мен болсам да, оны тоқтатуым керек
Dialogue: 0,1:02:16.58,1:02:18.86,Default,,0,0,0,,Кабинетте ұшқыш костюмі бар.
Dialogue: 0,1:02:19.44,1:02:22.23,Default,,0,0,0,,Вигоға дейін тау-кен позициясына жетіңіз
Dialogue: 0,1:02:22.52,1:02:25.98,Default,,0,0,0,,Жаңа модель Жұлдызды теңізде де жұмыс істей алады.
Dialogue: 0,1:02:28.44,1:02:32.98,Default,,0,0,0,,Энергия шығысы бейтараптандырылады және сіз ешқашан көтеріле алмайсыз.
Dialogue: 0,1:02:34.50,1:02:35.09,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,1:02:36.44,1:02:38.01,Default,,0,0,0,,Мен міндетті түрде тірі ораламын
Dialogue: 0,1:02:39.38,1:02:39.98,Default,,0,0,0,,Келесі жолы жалғасы
Dialogue: 0,1:02:41.50,1:02:42.48,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,1:02:45.23,1:02:48.88,Default,,0,0,0,,Әскердің әскерін растау Біздің әскер ертерек тоқтаған сияқты.
Dialogue: 0,1:02:49.63,1:02:52.44,Default,,0,0,0,,Бұл оның басталғанын білдіре ме?
Dialogue: 0,1:02:53.42,1:02:54.30,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:02:55.86,1:02:57.96,Default,,0,0,0,,Каникул аяқталды
Dialogue: 0,1:02:58.51,1:03:00.78,Default,,0,0,0,,Блэйд армиясынан ескерту хабары жоқ
Dialogue: 0,1:03:00.78,1:03:02.59,Default,,0,0,0,,Әскери әрекет деп танылды
Dialogue: 0,1:03:02.59,1:03:04.19,Default,,0,0,0,,ұятсыз
Dialogue: 0,1:03:04.19,1:03:07.36,Default,,0,0,0,,Бос тыйымды өрескел бұзу деген нені білдіреді?
Dialogue: 0,1:03:07.96,1:03:10.03,Default,,0,0,0,,Басқа ескертулер жоқ
Dialogue: 0,1:03:11.82,1:03:15.50,Default,,0,0,0,,Келесі жолы жалғасы
Dialogue: 0,1:03:17.20,1:03:18.46,Default,,0,0,0,,4 сағат өтті
Dialogue: 0,1:03:19.20,1:03:22.84,Default,,0,0,0,,Екі елдің өкілдері ресми мәлімдемелерді мұқият дайындауда
Dialogue: 0,1:03:22.84,1:03:27.90,Default,,0,0,0,,Екі елдің әскерлері бейтарап бос сызықта жиналып жатқаны хабарланды.
Dialogue: 0,1:03:27.90,1:03:30.16,Default,,0,0,0,,Олар жалған дабыл болып шықты
Dialogue: 0,1:03:31.36,1:03:32.74,Default,,0,0,0,,Бұл жала емес.
Dialogue: 0,1:03:33.78,1:03:35.50,Default,,0,0,0,,Біздің әрекеттеріміз әлі де
Dialogue: 0,1:03:36.84,1:03:39.46,Default,,0,0,0,,Керемет түрде уақытында келді
Dialogue: 0,1:03:39.46,1:03:41.60,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:03:43.70,1:03:44.98,Default,,0,0,0,,Менің қорғаушым
Dialogue: 0,1:03:45.36,1:03:46.08,Default,,0,0,0,,Бұл оңай ма?
Dialogue: 0,1:03:47.36,1:03:49.36,Default,,0,0,0,,Тірі сақталмауы керек еді
Dialogue: 0,1:03:50.74,1:03:53.86,Default,,0,0,0,,Егер сіз ештеңе істей алмасаңыз, бірақ ол сізге кедергі келтіреді
Dialogue: 0,1:03:53.86,1:03:56.52,Default,,0,0,0,,Бір соққымен бүкіл ұшақты жойыңыз.
Dialogue: 0,1:04:16.98,1:04:21.20,Default,,0,0,0,,Хё... не істеп жатырсың?
Dialogue: 0,1:04:22.50,1:04:24.22,Default,,0,0,0,,Нако! Нако!
Dialogue: 0,1:04:24.88,1:04:26.94,Default,,0,0,0,,Тыңдаңыз! Бір қорқынышты нәрсе болып жатыр...
Dialogue: 0,1:04:30.50,1:04:31.46,Default,,0,0,0,,Мен...
Dialogue: 0,1:04:33.68,1:04:34.54,Default,,0,0,0,,Мен сендім
Dialogue: 0,1:04:36.44,1:04:37.66,Default,,0,0,0,,(Барабан соғу дыбысы)
Dialogue: 0,1:05:05.40,1:05:05.86,Default,,0,0,0,,Міне!
Dialogue: 0,1:05:10.92,1:05:12.78,Default,,0,0,0,,Капитан, тоқтаңыз.
Dialogue: 0,1:05:12.78,1:05:14.65,Default,,0,0,0,,Раккоға қайта оралыңыз
Dialogue: 0,1:05:16.67,1:05:17.51,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,1:05:18.11,1:05:19.90,Default,,0,0,0,,Егер кескіңіз келсе, капитанмен бірге жасаңыз.
Dialogue: 0,1:05:29.28,1:05:30.59,Default,,0,0,0,,Лако…
Dialogue: 0,1:05:32.39,1:05:35.83,Default,,0,0,0,,Бұл өте жақсы! Мен шынымен Йох туралы айта аламын!
Dialogue: 0,1:05:36.53,1:05:37.91,Default,,0,0,0,,Тұлға жеткіліксіз
Dialogue: 0,1:05:39.27,1:05:42.23,Default,,0,0,0,,Ешкімге жүрегімді ашпай тентіреп жүрмін.
Dialogue: 0,1:05:43.09,1:05:45.29,Default,,0,0,0,,Сол уайымдарың өзгерді.
Dialogue: 0,1:05:45.29,1:05:48.23,Default,,0,0,0,,Біреудің саған сенуін күтпе
Dialogue: 0,1:05:48.75,1:05:50.23,Default,,0,0,0,,Мен бұған сенемін
Dialogue: 0,1:05:51.37,1:05:53.03,Default,,0,0,0,,Бұл орындалып жатқан жұмыс.
Dialogue: 0,1:05:53.69,1:05:55.83,Default,,0,0,0,,Бұл одан да жақсы ән болады.
Dialogue: 0,1:05:57.87,1:05:58.35,Default,,0,0,0,,Рако
Dialogue: 0,1:06:00.27,1:06:03.87,Default,,0,0,0,,Менің сізге айтқым келетін бір нәрсе бар.
Dialogue: 0,1:06:06.13,1:06:06.69,Default,,0,0,0,,Бұдан былай
Dialogue: 0,1:06:06.32,1:06:09.30,Default,,0,0,0,,Қазір қандай жағдайда екенімізді білмейсің!
Dialogue: 0,1:06:11.30,1:06:14.94,Default,,0,0,0,,Жұлдыздың қаны бұл планетаның болашағынан тағы да айырады.
Dialogue: 0,1:06:14.94,1:06:18.82,Default,,0,0,0,,Болашақ әлі бар, сенсең...
Dialogue: 0,1:06:18.82,1:06:22.02,Default,,0,0,0,,Мен ата-анамның болашағын мәңгілікке жоғалтқанын көрдім.
Dialogue: 0,1:06:22.92,1:06:24.80,Default,,0,0,0,,Сенсем қайтеді?
Dialogue: 0,1:06:25.56,1:06:26.66,Default,,0,0,0,,Бір кездері күмәнданғандар
Dialogue: 0,1:06:27.54,1:06:28.94,Default,,0,0,0,,Ол «кесу» деп аталады ма?
Dialogue: 0,1:06:31.02,1:06:33.84,Default,,0,0,0,,Егер сіз оны кие алсаңыз, оны ескертуге тырысыңыз!
Dialogue: 0,1:06:34.58,1:06:35.22,Default,,0,0,0,,Уф
Dialogue: 0,1:06:36.50,1:06:37.50,Default,,0,0,0,,!
Dialogue: 0,1:06:44.63,1:06:52.33,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,1:06:53.91,1:07:03.63,Default,,0,0,0,,Бұл әуен сені кездестіргенде туды
Dialogue: 0,1:07:03.63,1:07:11.19,Default,,0,0,0,,Мен сені енді жібермеймін
Dialogue: 0,1:07:15.63,1:07:18.43,Default,,0,0,0,,♪~
Dialogue: 0,1:07:18.43,1:07:18.57,Default,,0,0,0,,~♪
Dialogue: 0,1:07:24.79,1:07:31.31,Default,,0,0,0,,Қала сәл боялған
Dialogue: 0,1:07:31.31,1:07:38.41,Default,,0,0,0,,Бұлттардың арасымен ақырын
Dialogue: 0,1:07:41.17,1:07:45.27,Default,,0,0,0,,Жарқырау
Dialogue: 0,1:07:46.79,1:07:48.69,Default,,0,0,0,,Уақыт бойынша жүгіру
Dialogue: 0,1:07:48.31,1:07:55.31,Default,,0,0,0,,Сен екеуміз айналатын қып-қызыл жұлдыз
Dialogue: 0,1:07:55.87,1:08:04.17,Default,,0,0,0,,Болашаққа қарай жүгіре бер
Dialogue: 0,1:08:05.31,1:08:10.15,Default,,0,0,0,,Мен екеуміз айналамыз
Dialogue: 0,1:08:10.15,1:08:14.81,Default,,0,0,0,,Аспанда жүгірген қанаттары
Dialogue: 0,1:08:14.82,1:08:21.36,Default,,0,0,0,,Әрі және одан әрі
Dialogue: 0,1:08:21.36,1:08:26.68,Default,,0,0,0,,Қанатымды қағып кетсем де
Dialogue: 0,1:08:26.69,1:08:27.89,Default,,0,0,0,,Мен тікелей ұшатын болсам да
Dialogue: 0,1:08:30.87,1:08:31.87,Default,,0,0,0,,Жылжыту...
Dialogue: 0,1:08:49.31,1:08:50.01,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:52.97,1:08:53.57,Default,,0,0,0,,Хиро?
Dialogue: 0,1:09:00.87,1:09:02.63,Default,,0,0,0,,♪ Енді бар
Dialogue: 0,1:09:02.63,1:09:04.39,Default,,0,0,0,,Жоқ! Бұл қауіпті!
Dialogue: 0,1:09:04.83,1:09:06.83,Default,,0,0,0,,Үйге бара алмасаң не істейсің?
Dialogue: 0,1:09:06.83,1:09:07.83,Default,,0,0,0,,Неге келдің?
Dialogue: 0,1:09:08.87,1:09:11.87,Default,,0,0,0,,Мен Йоадан күдіктеніп, оны қуып жіберсем де...
Dialogue: 0,1:09:12.41,1:09:13.75,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,1:09:14.27,1:09:15.03,Default,,0,0,0,,(Hol Horse) «Мен осы жерде сұрақ қойғым келетін адаммын!»
Dialogue: 0,1:09:16.08,1:09:24.34,Default,,0,0,0,,♪ Айналамыз, сен екеуміз көкте жүгіреміз, қанатымызды жайамыз
Dialogue: 0,1:09:24.34,1:09:24.76,Default,,0,0,0,,Рако...жақсы.
Dialogue: 0,1:09:24.76,1:09:26.90,Default,,0,0,0,,Жақсы емес
Dialogue: 0,1:09:26.90,1:09:30.08,Default,,0,0,0,,Мен сенуден бас тарттым.
Dialogue: 0,1:09:30.62,1:09:31.36,Default,,0,0,0,,Бірақ
Dialogue: 0,1:09:33.20,1:09:36.34,Default,,0,0,0,,Жалынсаң да
Dialogue: 0,1:09:38.30,1:09:39.54,Default,,0,0,0,,Мен
Dialogue: 0,1:09:39.54,1:09:41.50,Default,,0,0,0,,Мен кешірім сұрамауым керек еді.
Dialogue: 0,1:09:58.73,1:10:01.79,Default,,0,0,0,,Сен маған солай айттың, Рако.
Dialogue: 0,1:10:03.13,1:10:04.97,Default,,0,0,0,,Мен өзіме сенемін
Dialogue: 0,1:10:05.71,1:10:08.05,Default,,0,0,0,,Мен осында қала аламын.
Dialogue: 0,1:10:20.72,1:10:21.38,Default,,0,0,0,,me
Dialogue: 0,1:10:26.12,1:10:30.36,Default,,0,0,0,,Бұл қалыпты емес шығыс артқы жүріс пе?
Dialogue: 0,1:10:36.20,1:10:37.32,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,1:10:38.36,1:10:39.06,Default,,0,0,0,,Джо!
Dialogue: 0,1:10:42.92,1:10:47.08,Default,,0,0,0,,Басқа адам бітті, кеттік.
Dialogue: 0,1:10:52.18,1:10:53.78,Default,,0,0,0,,Жаудың шығарғанын бағалама.
Dialogue: 0,1:10:54.22,1:10:55.75,Default,,0,0,0,,Жылдамдықпен жұлдыздар теңізіне қарай
Dialogue: 0,1:10:55.75,1:10:56.72,Default,,0,0,0,,Уф
Dialogue: 0,1:11:03.01,1:11:05.77,Default,,0,0,0,,Менің ойымша, біз жұлдыздар теңізінің булануына жол бермеуіміз керек.
Dialogue: 0,1:11:08.08,1:11:10.10,Default,,0,0,0,,А, ана жерде.
Dialogue: 0,1:11:10.10,1:11:12.06,Default,,0,0,0,,Сырттан іске қосылған құрылғы бар.
Dialogue: 0,1:11:13.22,1:11:15.44,Default,,0,0,0,,Жұлдыздар теңізіне жеткенше
Dialogue: 0,1:11:15.44,1:11:17.06,Default,,0,0,0,,Ол затты жарудан басқа амалымыз жоқ.
Dialogue: 0,1:11:17.92,1:11:18.42,Default,,0,0,0,,Отер!
Dialogue: 0,1:11:18.54,1:11:23.50,Default,,0,0,0,,♪~
Dialogue: 0,1:11:28.02,1:11:29.92,Default,,0,0,0,,Мен оның бәрін бірден өшіремін
Dialogue: 0,1:11:34.88,1:11:38.78,Default,,0,0,0,,Ертеңгі теңізге дейін Мен осылай жалғыз қаламын
Dialogue: 0,1:11:39.48,1:11:41.22,Default,,0,0,0,,Мако Бүгін таңертеңгі темір
Dialogue: 0,1:11:42.39,1:11:49.53,Default,,0,0,0,,Айрианың... Дебриясугай!
Dialogue: 0,1:11:50.61,1:11:51.37,Default,,0,0,0,,Уф
Dialogue: 0,1:11:54.21,1:11:55.21,Default,,0,0,0,,Ракон!
Dialogue: 0,1:11:55.41,1:11:57.31,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,1:11:57.31,1:12:04.69,Default,,0,0,0,,Жүр!
Dialogue: 0,1:12:39.54,1:12:42.04,Default,,0,0,0,,Кішкентай қыз!
Dialogue: 0,1:12:42.92,1:12:44.84,Default,,0,0,0,,Иә...
Dialogue: 0,1:12:44.84,1:12:46.04,Default,,0,0,0,,Мен жасадым, әке.
Dialogue: 0,1:12:48.26,1:12:49.74,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,1:12:59.96,1:13:00.76,Default,,0,0,0,,Уау
Dialogue: 0,1:13:03.48,1:13:05.66,Default,,0,0,0,,Жұлдыздар теңізіне сүңгіп...
Dialogue: 0,1:13:05.66,1:13:07.52,Default,,0,0,0,,Жарылғыш құрылғы болмаса да
Dialogue: 0,1:13:07.98,1:13:11.31,Default,,0,0,0,,Иә!?
Dialogue: 0,1:13:14.59,1:13:15.47,Default,,0,0,0,,Бұл...
Dialogue: 0,1:13:15.99,1:13:16.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:13:17.61,1:13:19.63,Default,,0,0,0,,EBC орнына
Dialogue: 0,1:13:19.63,1:13:21.87,Default,,0,0,0,,Жаңа машинаның шығыс жүйесінде
Dialogue: 0,1:13:21.87,1:13:24.67,Default,,0,0,0,,Жұлдыздар еліндегі кристалдарды жаруға ниетті.
Dialogue: 0,1:13:25.53,1:13:27.17,Default,,0,0,0,,Сіз өзін-өзі жоюды айтасыз ба?
Dialogue: 0,1:13:29.03,1:13:30.09,Default,,0,0,0,,Жарайды, Виго.
Dialogue: 0,1:13:31.67,1:13:32.95,Default,,0,0,0,,Мен қайтып орала алмаймын
Dialogue: 0,1:13:33.49,1:13:34.97,Default,,0,0,0,,Оны орындаңыз
Dialogue: 0,1:13:36.93,1:13:38.95,Default,,0,0,0,,Соғыссыз әлем
Dialogue: 0,1:13:41.43,1:13:43.45,Default,,0,0,0,,Уф!
Dialogue: 0,1:13:46.57,1:13:47.67,Default,,0,0,0,,Бибо, тыңда!
Dialogue: 0,1:13:48.39,1:13:50.75,Default,,0,0,0,,Тоқта! Не болды?
Dialogue: 0,1:13:51.77,1:13:54.07,Default,,0,0,0,,Сенің жүрегің жаралы, Виго.
Dialogue: 0,1:13:55.03,1:13:56.91,Default,,0,0,0,,Сіз дұрыс емес жолдасыз
Dialogue: 0,1:13:58.85,1:13:59.93,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,1:14:00.79,1:14:02.55,Default,,0,0,0,,Менің жүрегім жас еді
Dialogue: 0,1:14:03.58,1:14:05.50,Default,,0,0,0,,Соғысты жек көрушілікпен бұзылған
Dialogue: 0,1:14:07.12,1:14:09.52,Default,,0,0,0,,Трагедия қайталана береді.
Dialogue: 0,1:14:10.72,1:14:14.44,Default,,0,0,0,,Мен ешкімге өзімді қайта сезінуіне жол бермеймін.
Dialogue: 0,1:14:16.06,1:14:17.58,Default,,0,0,0,,Бұл жаралы жүрек
Dialogue: 0,1:14:18.22,1:14:20.28,Default,,0,0,0,,Соғысты аяқтау үшін қолданылады!
Dialogue: 0,1:14:24.02,1:14:24.72,Default,,0,0,0,,Сонымен!
Dialogue: 0,1:14:25.56,1:14:26.30,Default,,0,0,0,,Сондықтан
Dialogue: 0,1:14:26.76,1:14:28.10,Default,,0,0,0,,Бұл бітпейді!
Dialogue: 0,1:14:32.22,1:14:36.60,Default,,0,0,0,,Өйткені Виго қазір не істеп жатыр...
Dialogue: 0,1:14:37.82,1:14:39.44,Default,,0,0,0,,Бұл соғыс!
Dialogue: 0,1:14:40.44,1:14:45.22,Default,,0,0,0,,Қайғылы оқиғаны қайталап отырған адам қазір өзін тастап кетуге тырысқан Виго.
Dialogue: 0,1:14:45.78,1:14:46.74,Default,,0,0,0,,Қосылмаңыз!
Dialogue: 0,1:14:48.70,1:14:51.46,Default,,0,0,0,,Өмір сүрмесең, болашаққа бара алмайсың
Dialogue: 0,1:14:53.59,1:14:55.73,Default,,0,0,0,,Live Igo!
Dialogue: 0,1:14:57.35,1:14:58.29,Default,,0,0,0,,Тікелей эфир!
Dialogue: 0,1:15:00.49,1:15:03.47,Default,,0,0,0,,Өмір сүрген...
Dialogue: 0,1:15:06.41,1:15:07.45,Default,,0,0,0,,Әке.
Dialogue: 0,1:15:08.23,1:15:09.13,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:15:10.75,1:15:11.61,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:15:12.93,1:15:15.39,Default,,0,0,0,,Олардың айқайлаған соңғы сөздері
Dialogue: 0,1:15:16.57,1:15:18.65,Default,,0,0,0,,Мен оны шынымен естідім.
Dialogue: 0,1:15:19.99,1:15:21.55,Default,,0,0,0,,шын жүректен
Dialogue: 0,1:15:21.99,1:15:23.91,Default,,0,0,0,,Мен оны жойдым.
Dialogue: 0,1:15:28.09,1:15:29.85,Default,,0,0,0,,Нағыз жазушыға араласу
Dialogue: 0,1:15:30.53,1:15:31.51,Default,,0,0,0,,Жылдамдату, Виго.
Dialogue: 0,1:15:31.51,1:15:34.77,Default,,0,0,0,,Қазір жіберіп алсақ, жарылғыш жолға жете алмаймыз.
Dialogue: 0,1:15:34.77,1:15:35.39,Default,,0,0,0,,Бибо
Dialogue: 0,1:15:38.03,1:15:41.23,Default,,0,0,0,,Ойға оралатын сөздер бар.
Dialogue: 0,1:15:41.97,1:15:43.31,Default,,0,0,0,,Есіңізде болсын, жай ғана
Dialogue: 0,1:15:44.79,1:15:46.95,Default,,0,0,0,,Әке мен шешенің тілегі
Dialogue: 0,1:15:48.75,1:15:50.91,Default,,0,0,0,,Бұл планетаның болашағы
Dialogue: 0,1:15:51.55,1:15:52.55,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,1:15:53.57,1:15:57.09,Default,,0,0,0,,Бірақ менсіз және апамсыз бұл болашақ емес.
Dialogue: 0,1:15:58.59,1:16:01.37,Default,,0,0,0,,Старт мырзаны басынан бастайық
Dialogue: 0,1:16:02.75,1:16:05.25,Default,,0,0,0,,Сен алдандың ба, Диго?
Dialogue: 0,1:16:07.51,1:16:09.01,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,1:16:09.81,1:16:10.59,Default,,0,0,0,,Мен!
Dialogue: 0,1:16:12.82,1:16:18.09,Default,,0,0,0,,Уф...
Dialogue: 0,1:16:19.13,1:16:19.89,Default,,0,0,0,,Ол тоқтады ма?
Dialogue: 0,1:16:19.89,1:16:21.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:30.81,1:16:32.85,Default,,0,0,0,,Не деп тұрсың өзің?
Dialogue: 0,1:16:32.85,1:16:34.17,Default,,0,0,0,,А... сен.
Dialogue: 0,1:16:36.64,1:16:39.01,Default,,0,0,0,,Ах
Dialogue: 0,1:16:39.73,1:16:39.97,Default,,0,0,0,,Нако!
Dialogue: 0,1:16:43.29,1:16:44.57,Default,,0,0,0,,Басынан бастап
Dialogue: 0,1:16:45.77,1:16:47.95,Default,,0,0,0,,Мұны істеу керек еді!
Dialogue: 0,1:16:47.60,1:16:48.34,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:16:50.00,1:16:55.84,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:16:56.88,1:17:01.34,Default,,0,0,0,,Жұлдыздар теңізінде...
Dialogue: 0,1:17:01.34,1:17:02.40,Default,,0,0,0,,Цугаэ!
Dialogue: 0,1:17:19.62,1:17:21.44,Default,,0,0,0,,Накао, оны қайтарыңыз.
Dialogue: 0,1:17:21.07,1:17:24.27,Default,,0,0,0,,Оларға бер, Лакоа.
Dialogue: 0,1:17:25.15,1:17:26.56,Default,,0,0,0,,Рагон
Dialogue: 0,1:17:30.81,1:17:34.93,Default,,0,0,0,,Лиганы жалғыз қалдырмаңыз. Мысал келтіріңіз.
Dialogue: 0,1:17:39.92,1:17:40.42,Default,,0,0,0,,О
Dialogue: 0,1:17:40.42,1:17:41.35,Default,,0,0,0,,Эгиботчи
Dialogue: 0,1:17:42.22,1:17:42.65,Default,,0,0,0,,me
Dialogue: 0,1:17:50.04,1:17:50.92,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:17:56.38,1:17:57.82,Default,,0,0,0,,Сіз бе?
Dialogue: 0,1:17:58.60,1:17:59.10,Default,,0,0,0,,Виго!
Dialogue: 0,1:17:59.52,1:18:05.02,Default,,0,0,0,,Ууууууууууууууууууу
Dialogue: 0,1:18:05.16,1:18:07.42,Default,,0,0,0,,Біздің волонтер...
Dialogue: 0,1:18:07.42,1:18:08.58,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:18:16.32,1:18:18.74,Default,,0,0,0,,Неге сен!
Dialogue: 0,1:18:26.39,1:18:29.63,Default,,0,0,0,,Бұл Виго ма?
Dialogue: 0,1:18:30.65,1:18:31.97,Default,,0,0,0,,Капитан
Dialogue: 0,1:18:39.23,1:18:41.35,Default,,0,0,0,,Үлкен...
Dialogue: 0,1:18:53.72,1:18:57.38,Default,,0,0,0,,Рахмет, Виго, маған сенгеніңіз үшін.
Dialogue: 0,1:18:57.38,1:19:01.43,Default,,0,0,0,,О, мен сенемін, мен саған сенемін.
Dialogue: 0,1:19:01.89,1:19:02.68,Default,,0,0,0,,Жақсы
Dialogue: 0,1:19:02.68,1:19:06.22,Default,,0,0,0,,Нако Бұл ұшақ ұша ала ма?
Dialogue: 0,1:19:06.80,1:19:11.35,Default,,0,0,0,,Жоқ, бұл дыбыс енді жұмыс істемейтін сияқты.
Dialogue: 0,1:19:12.43,1:19:14.19,Default,,0,0,0,,Егер ұшақ теңізге құласа
Dialogue: 0,1:19:14.77,1:19:18.69,Default,,0,0,0,,Мен білемін, бірақ Вигоның газы жақсы.
Dialogue: 0,1:19:18.32,1:19:19.72,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,1:19:19.72,1:19:20.86,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,1:19:21.00,1:19:21.58,Default,,0,0,0,,Лаку!
Dialogue: 0,1:19:22.02,1:19:22.88,Default,,0,0,0,,Жеткілікті
Dialogue: 0,1:19:23.74,1:19:25.18,Default,,0,0,0,,Виго жұлдыздарды айналып өтеді
Dialogue: 0,1:19:26.22,1:19:28.42,Default,,0,0,0,,Себебі ол Бибоны өзі құтқарды.
Dialogue: 0,1:19:28.42,1:19:30.38,Default,,0,0,0,,Берілме, Раку!
Dialogue: 0,1:19:30.98,1:19:31.82,Default,,0,0,0,,Ракко!
Dialogue: 0,1:19:34.04,1:19:35.24,Default,,0,0,0,,Жоқ, Лаку.
Dialogue: 0,1:19:35.24,1:19:36.70,Default,,0,0,0,,Тағы да күш біріктірейік
Dialogue: 0,1:19:36.70,1:19:38.24,Default,,0,0,0,,Оны жылжытуға болады.
Dialogue: 0,1:19:38.90,1:19:40.56,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,1:19:42.90,1:19:43.58,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:19:44.90,1:19:47.82,Default,,0,0,0,,Кристаллдағы үлкен жарықшақ
Dialogue: 0,1:19:47.82,1:19:49.50,Default,,0,0,0,,Ол бұзылудың алдында тұр.
Dialogue: 0,1:19:50.26,1:19:52.22,Default,,0,0,0,,Үзілмей тұрып, жүрегімізді біріктірейік
Dialogue: 0,1:19:52.22,1:19:53.62,Default,,0,0,0,,Қозғалайық, Орако.
Dialogue: 0,1:19:55.02,1:19:56.32,Default,,0,0,0,,Ол үзілмей тұрып
Dialogue: 0,1:19:57.00,1:19:57.38,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,1:19:57.01,1:19:59.01,Default,,0,0,0,,Менің істегім келетін нәрсе
Dialogue: 0,1:20:00.57,1:20:01.27,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,1:20:02.19,1:20:05.71,Default,,0,0,0,,Сізге шынымен не ойлайтыныңызды айтыңыз.
Dialogue: 0,1:20:05.71,1:20:07.59,Default,,0,0,0,,Тезірек келші, Оттер.
Dialogue: 0,1:20:08.09,1:20:10.85,Default,,0,0,0,,Жұлдыздар теңізіне түссең, қайтып орала алмайсың.
Dialogue: 0,1:20:12.55,1:20:13.15,Default,,0,0,0,,Юо
Dialogue: 0,1:20:13.47,1:20:14.27,Default,,0,0,0,,Ян…
Dialogue: 0,1:20:15.89,1:20:18.01,Default,,0,0,0,,Сізге сенбегенім үшін кешіріңіз.
Dialogue: 0,1:20:23.35,1:20:24.77,Default,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,1:20:26.68,1:20:27.81,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,1:20:28.97,1:20:31.56,Default,,0,0,0,,Мен Йохты кездестіргеніме қуаныштымын.
Dialogue: 0,1:20:33.59,1:20:34.55,Default,,0,0,0,,Юоның әні
Dialogue: 0,1:20:36.36,1:20:37.98,Default,,0,0,0,,Қайтадан тыңдағым келді
Dialogue: 0,1:20:39.11,1:20:41.27,Default,,0,0,0,,♪~
Dialogue: 0,1:20:49.10,1:20:50.15,Default,,0,0,0,,Анашым!
Dialogue: 0,1:20:50.19,1:20:51.07,Default,,0,0,0,,Лагон!
Dialogue: 0,1:21:13.55,1:21:14.55,Default,,0,0,0,,Ал...
Dialogue: 0,1:21:15.56,1:21:16.14,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,1:21:17.60,1:21:18.07,Default,,0,0,0,,Ян мырза
Dialogue: 0,1:21:26.30,1:21:30.00,Default,,0,0,0,,Га
Dialogue: 0,1:21:33.07,1:21:34.31,Default,,0,0,0,,Менің ойымша, бұл Йо-кун.
Dialogue: 0,1:21:34.92,1:21:35.50,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,1:21:37.47,1:21:40.53,Default,,0,0,0,,Мұны шынымен де жұлдыздар елінің кристалдарында жасауға болады.
Dialogue: 0,1:21:41.03,1:21:42.85,Default,,0,0,0,,Капитан, Ракоға көмектес.
Dialogue: 0,1:21:42.85,1:21:44.42,Default,,0,0,0,,Егер бұл жалғаса берсе, Рако солай болады
Dialogue: 0,1:21:44.85,1:21:46.18,Default,,0,0,0,,Жол бар
Dialogue: 0,1:21:47.46,1:21:50.18,Default,,0,0,0,,Сондықтан мен сені жүрегіме шақырдым
Dialogue: 0,1:21:51.23,1:21:53.10,Default,,0,0,0,,Ёкун екеуміз артқы жарықты қостық.
Dialogue: 0,1:21:53.77,1:21:56.11,Default,,0,0,0,,Антеннаның қанаттарын қайта іске қосыңыз
Dialogue: 0,1:21:57.23,1:21:59.61,Default,,0,0,0,,Қанаттар қозғалса, көтерілуге болады.
Dialogue: 0,1:22:00.46,1:22:02.15,Default,,0,0,0,,Барлығы құтқарылады.
Dialogue: 0,1:22:02.15,1:22:04.27,Default,,0,0,0,,Жасайық. Қанекей мынаны істейік.
Dialogue: 0,1:22:04.88,1:22:05.93,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,1:22:06.72,1:22:08.73,Default,,0,0,0,,Мен бір нәрсені растағым келеді.
Dialogue: 0,1:22:09.68,1:22:10.72,Default,,0,0,0,,Раконың пайда болуынан
Dialogue: 0,1:22:11.34,1:22:13.38,Default,,0,0,0,,Ракода болмағаныңызға біраз болды.
Dialogue: 0,1:22:14.85,1:22:16.46,Default,,0,0,0,,Мен Жерге бір рет оралдым деп ойлаймын.
Dialogue: 0,1:22:17.18,1:22:19.31,Default,,0,0,0,,Бірақ неге қайта келдің?
Dialogue: 0,1:22:20.22,1:22:22.03,Default,,0,0,0,,Мен Лаломен танысқым келеді
Dialogue: 0,1:22:22.93,1:22:25.31,Default,,0,0,0,,Мен бірге айналып, жұлдыздарды құтқарғым келеді.
Dialogue: 0,1:22:27.46,1:22:29.22,Default,,0,0,0,,Мен өзіме сендім
Dialogue: 0,1:22:31.22,1:22:31.96,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,1:22:35.24,1:22:38.26,Default,,0,0,0,,Виго... Бұл қайғылы болса керек.
Dialogue: 0,1:22:39.34,1:22:42.46,Default,,0,0,0,,Бір күні мен де сол мұңды, жалғыздықты жеңемін.
Dialogue: 0,1:22:44.04,1:22:45.66,Default,,0,0,0,,Өзіңізге сеніңіз
Dialogue: 0,1:22:47.36,1:22:51.50,Default,,0,0,0,,Бұлай болғанда, сіз нағыз мені кездестіресіз.
Dialogue: 0,1:22:53.02,1:22:54.34,Default,,0,0,0,,Мен мәңгі күттім
Dialogue: 0,1:22:55.70,1:22:56.28,Default,,0,0,0,,Бимо
Dialogue: 0,1:22:58.56,1:23:00.08,Default,,0,0,0,,Сен сондайсың ба?
Dialogue: 0,1:23:03.30,1:23:08.06,Default,,0,0,0,,Мен жылап тұрғанда музыкаңызды тыңдайын
Dialogue: 0,1:23:08.48,1:23:10.12,Default,,0,0,0,,Жұлдызды қан кристалы
Dialogue: 0,1:23:11.44,1:23:12.96,Default,,0,0,0,,Бұл сізде болуы керек нәрсе
Dialogue: 0,1:23:15.70,1:23:16.76,Default,,0,0,0,,Есте сақтаңыз
Dialogue: 0,1:23:18.10,1:23:20.24,Default,,0,0,0,,Менің өткенімді өзгертпеңізші
Dialogue: 0,1:23:23.50,1:23:26.84,Default,,0,0,0,,Сен және музыка, мен де сені жақсы көремін
Dialogue: 0,1:23:30.20,1:23:30.60,Default,,0,0,0,,me
Dialogue: 0,1:23:44.56,1:23:47.32,Default,,0,0,0,,Кешіріңіз, Ракон
Dialogue: 0,1:23:48.22,1:23:51.14,Default,,0,0,0,,Мен күтумен батып кетемін
Dialogue: 0,1:23:52.30,1:23:54.40,Default,,0,0,0,,Сіз тек менден артық боласыз
Dialogue: 0,1:23:56.34,1:23:58.24,Default,,0,0,0,,Көптеген адамдарды құтқарады
Dialogue: 0,1:24:05.34,1:24:08.88,Default,,0,0,0,,Тікелей эфир Рако
Dialogue: 0,1:24:12.21,1:24:16.63,Default,,0,0,0,,Соғысты бастаған бейтарап бос желілік жабдық
Dialogue: 0,1:24:17.23,1:24:19.77,Default,,0,0,0,,Шындық пен оны ұйымдастырушы белгісіз.
Dialogue: 0,1:24:19.77,1:24:23.99,Default,,0,0,0,,Тартқыш күзет капитаны Биоксенакис пен капитан Машина
Dialogue: 0,1:24:23.99,1:24:27.93,Default,,0,0,0,,Белгісіз ұйымға тиесілі жұмбақ ұшақпен бірге қайда екені әлі белгісіз.
Dialogue: 0,1:24:28.29,1:24:33.45,Default,,0,0,0,,Гова мен Блэйдтің бірлескен іздеуі жалғасады деп күтілуде.
Dialogue: 0,1:24:34.31,1:24:36.99,Default,,0,0,0,,Король Милдер және премьер-министр Мартриц
Dialogue: 0,1:24:36.99,1:24:39.57,Default,,0,0,0,,Атысты тоқтату туралы келісімдегі бұл кешіктіру барлық бөлімшелерге қатысты.
Dialogue: 0,1:24:39.57,1:24:45.69,Default,,0,0,0,,Екі ел арасында тұрақты бейбітшілік келісімінің мүмкіндігін талқылау.
Dialogue: 0,1:24:46.21,1:24:48.37,Default,,0,0,0,,бірлескен мәлімдеме жасады
Dialogue: 0,1:24:48.37,1:24:51.39,Default,,0,0,0,,Мегурибоши арқылы әр қаланың тұрғындарынан
Dialogue: 0,1:25:01.53,1:25:04.15,Default,,0,0,0,,Сол таңды тудырған сенсің.
Dialogue: 0,1:25:07.21,1:25:08.05,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,1:25:07.67,1:25:08.71,Default,,0,0,0,,Мен ұмытпаймын
Dialogue: 0,1:25:10.59,1:25:11.17,Default,,0,0,0,,Виго
Dialogue: 0,1:25:15.79,1:25:17.29,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,1:25:19.39,1:25:20.11,Default,,0,0,0,,Бүгін де
Dialogue: 0,1:25:20.85,1:25:22.05,Default,,0,0,0,,Виго да
Dialogue: 0,1:25:24.45,1:25:26.81,Default,,0,0,0,,Екеуі қайда қалды?
Dialogue: 0,1:25:27.77,1:25:30.07,Default,,0,0,0,,Олар өздері қалаған болашаққа аттанды
Dialogue: 0,1:25:31.63,1:25:33.03,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,1:25:34.97,1:25:35.61,Default,,0,0,0,,Сену
Dialogue: 0,1:25:38.09,1:25:41.85,Default,,0,0,0,,Ендеше, біз шынымен де қайта кездесетінімізге сенімдімін.
Dialogue: 0,1:25:43.57,1:25:45.79,Default,,0,0,0,,Әй, тағы бір күні
Dialogue: 0,1:25:48.19,1:25:53.17,Default,,0,0,0,,Сен, сенің әнің, Мен оны жақсы көремін
Dialogue: 0,1:25:53.83,1:25:56.51,Default,,0,0,0,,Дайын өнімді естігенше күтіңіз.
Dialogue: 0,1:25:58.41,1:26:03.05,Default,,0,0,0,,Сізге сызбалар ұнайтыны сөзсіз.
Dialogue: 0,1:26:05.83,1:26:07.41,Default,,0,0,0,,Бір күні мен сенімдімін
Dialogue: 0,1:26:09.53,1:26:12.05,Default,,0,0,0,,Маған хабарлаңыз
Dialogue: 0,1:26:13.75,1:26:15.71,Default,,0,0,0,,Сізге тыңдауға рұқсат етіңіз
Dialogue: 0,1:26:16.95,1:26:18.59,Default,,0,0,0,,Біреу уәде берді
Dialogue: 0,1:26:20.63,1:26:23.25,Default,,0,0,0,,Адамның алыстығы сонша, мен оның қайда екенін білмеймін.
Dialogue: 0,1:26:26.42,1:26:33.47,Default,,0,0,0,,Бірақ менің жүрегіміз әрқашан байланысты екенін білемін. Егер сіз жеткізгіңіз келетін нәрсе болса, ол сізге жететініне сенімдімін.
Dialogue: 0,1:26:34.43,1:26:38.39,Default,,0,0,0,,Бұл мені үйретті деп ойлаймын
Dialogue: 0,1:26:38.97,1:26:40.06,Default,,0,0,0,,Өйткені сол адам
Dialogue: 0,1:26:42.76,1:26:48.03,Default,,0,0,0,,Рако, бұл мен сенің тыңдағаныңды қалаймын.
Dialogue: 0,1:26:48.64,1:26:49.42,Default,,0,0,0,,Мегури жұлдызы
Dialogue: 0,1:26:50.71,1:26:55.55,Default,,0,0,0,,♪~
Dialogue: 0,1:27:20.47,1:27:25.03,Default,,0,0,0,,Мен сені жібермеймін
Dialogue: 0,1:27:25.59,1:27:32.31,Default,,0,0,0,,Байланысқан жүректерімізді кісендейді
Dialogue: 0,1:27:32.87,1:27:39.45,Default,,0,0,0,,Қала сәл боялған
Dialogue: 0,1:27:39.45,1:27:45.47,Default,,0,0,0,,Бұлттардың арасымен ақырын
Dialogue: 0,1:27:50.21,1:27:53.65,Default,,0,0,0,,♪Бейнені көргеніңізге рахмет☆
Dialogue: 0,1:27:53.27,1:27:57.73,Default,,0,0,0,,Мен айналайын қызыл жұлдыз
Dialogue: 0,1:27:57.73,1:28:03.95,Default,,0,0,0,,Болашаққа қарай жүгіре бер
Dialogue: 0,1:28:04.81,1:28:08.49,Default,,0,0,0,,Мен және сен кері айналдыру
Dialogue: 0,1:28:08.49,1:28:12.07,Default,,0,0,0,,Аспанда жүгіретін қанаттарын жайып
Dialogue: 0,1:28:12.07,1:28:19.39,Default,,0,0,0,,Алысқа ұшып кетсем де
Dialogue: 0,1:28:23.59,1:28:24.13,Default,,0,0,0,,by H.
Dialogue: 0,1:28:32.52,1:28:33.92,Default,,0,0,0,,♪~
Dialogue: 0,1:28:33.92,1:28:38.92,Default,,0,0,0,,Иә, ұмытпаймын.
Dialogue: 0,1:28:39.97,1:28:46.39,Default,,0,0,0,,Сол күні берген уәдеміз туралы
Dialogue: 0,1:28:46.39,1:28:53.39,Default,,0,0,0,,Кеудеге терең пышақ салу
Dialogue: 0,1:28:54.02,1:28:55.44,Default,,0,0,0,,♪~
Dialogue: 0,1:28:55.46,1:29:05.12,Default,,0,0,0,,Өйткені мен ауырсынуға сенемін
Dialogue: 0,1:29:32.28,1:29:35.08,Default,,0,0,0,,♪~
