Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.54,0:00:05.71,Default,,0,0,0,,Балалар... біреуді іздеп жүрсіңдер.
Dialogue: 0,0:00:05.79,0:00:06.88,Default,,0,0,0,,Ол қандай жігіт?
Dialogue: 0,0:00:06.96,0:00:10.51,Default,,0,0,0,,Кішкентай және сымбатты, қара киім мен қара шаш
Dialogue: 0,0:00:11.01,0:00:12.34,Default,,0,0,0,,Сенің атың кім?
Dialogue: 0,0:00:12.84,0:00:14.09,Default,,0,0,0,,Аты...
Dialogue: 0,0:00:15.68,0:00:17.39,Default,,0,0,0,,Аты - Ричард
Dialogue: 0,0:00:18.10,0:00:19.51,Default,,0,0,0,,Сіз осы жерде тұрасыз ба?
Dialogue: 0,0:00:20.02,0:00:23.02,Default,,0,0,0,,Жоқ... бірақ біз тағы кездесетінімізге сенімдімін.
Dialogue: 0,0:00:23.73,0:00:26.23,Default,,0,0,0,,Қанның дәмі Қанның иісі...
Dialogue: 0,0:00:26.94,0:00:30.19,Default,,0,0,0,,Бәлкім, сол актімен бірдей нәрсе.
Dialogue: 0,0:00:35.03,0:00:35.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:36.24,0:00:38.78,Default,,0,0,0,,Маңыздысы – қазіргі сәт.
Dialogue: 0,0:00:39.41,0:00:41.75,Default,,0,0,0,,Ричард? Сіз мас болдыңыз ба?
Dialogue: 0,0:00:42.25,0:00:45.04,Default,,0,0,0,,Иә... аздап.
Dialogue: 0,0:00:45.54,0:00:47.29,Default,,0,0,0,,Бәрібір бәріміз бірдейміз
Dialogue: 0,0:00:47.79,0:00:51.46,Default,,0,0,0,,Нағыз мені білсең, қашасың
Dialogue: 0,0:00:52.71,0:00:55.97,Default,,0,0,0,,Маған тек ұрыс алаңы керек
Dialogue: 0,0:00:59.51,0:01:01.56,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:01.64,0:01:03.68,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:04.18,0:01:10.19,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:10.69,0:01:15.57,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:19.49,0:01:21.49,Default,,0,0,0,,♪～
Dialogue: 0,0:02:45.37,0:02:47.37,Default,,0,0,0,,～♪
Dialogue: 0,0:02:49.79,0:02:50.92,Default,,0,0,0,,(вазаның сынған дыбысы)
Dialogue: 0,0:02:51.58,0:02:54.79,Default,,0,0,0,,О... Құдай, Құдай, Құдай!
Dialogue: 0,0:02:55.30,0:03:00.59,Default,,0,0,0,,Менің бақытсыздығым сол кісінің әйелі болған соң басталды.
Dialogue: 0,0:03:00.68,0:03:02.09,Default,,0,0,0,,Осылай қалғаныңыз жөн
Dialogue: 0,0:03:02.18,0:03:03.85,Default,,0,0,0,,Жоғалып кету.
Dialogue: 0,0:03:04.72,0:03:05.81,Default,,0,0,0,,Эдвард…
Dialogue: 0,0:03:06.39,0:03:08.64,Default,,0,0,0,,Мен әзілдеп тұрмын, анашым.
Dialogue: 0,0:03:08.73,0:03:11.90,Default,,0,0,0,,Ол кісі болмаса жаңғыру да болмас еді.
Dialogue: 0,0:03:11.98,0:03:16.82,Default,,0,0,0,,Lancaster қалпына келтірілгенде, құқықтарыңыз қалпына келтіріледі.
Dialogue: 0,0:03:17.98,0:03:20.86,Default,,0,0,0,,Бірақ ол ұлын тастап кетті.
Dialogue: 0,0:03:21.49,0:03:23.28,Default,,0,0,0,,Егер нағыз патша...
Dialogue: 0,0:03:24.28,0:03:27.83,Default,,0,0,0,,Мені, өз ұлыңнан айыруға амал жоқ.
Dialogue: 0,0:03:29.25,0:03:32.96,Default,,0,0,0,,Ол кісі мені сол кезде тастап кеткені анық.
Dialogue: 0,0:03:33.63,0:03:38.17,Default,,0,0,0,,«Менде басқа амал қалмады».
Dialogue: 0,0:03:41.47,0:03:42.55,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:03:43.80,0:03:46.60,Default,,0,0,0,,Менің әкем емес...
Dialogue: 0,0:03:48.06,0:03:52.02,Default,,0,0,0,,Олай болса, Эдвард, анаңның бұйрығы.
Dialogue: 0,0:03:52.52,0:03:54.85,Default,,0,0,0,,Мәртебелі Генриді қайтарыңыз.
Dialogue: 0,0:03:54.94,0:03:55.61,Default,,0,0,0,,Мен неге...
Dialogue: 0,0:03:55.69,0:03:59.86,Default,,0,0,0,,Жау тұтқынына айналсақ, біз үшін ажал болар еді.
Dialogue: 0,0:04:00.44,0:04:01.07,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:04:01.15,0:04:03.57,Default,,0,0,0,,Егер ол кісі менің әкем болмаса
Dialogue: 0,0:04:03.66,0:04:05.91,Default,,0,0,0,,Дәлелдеңіз.
Dialogue: 0,0:04:05.99,0:04:10.58,Default,,0,0,0,,Сіз менің әкеме ұқсамай, өз рөліңізді тамаша орындай алатын адамсыз.
Dialogue: 0,0:04:11.16,0:04:16.33,Default,,0,0,0,,Әкең кім болса да, сен Англияның келесі патшасысың.
Dialogue: 0,0:04:16.96,0:04:17.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:19.84,0:04:21.17,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:22.42,0:04:25.68,Default,,0,0,0,,Оған деген сүйіспеншілік үшін емес, сен үшін.
Dialogue: 0,0:04:26.51,0:04:28.51,Default,,0,0,0,,Мен сені міндетті түрде қайтарамын.
Dialogue: 0,0:04:30.39,0:04:32.93,Default,,0,0,0,,Ағаңмен тағы да аңға ілесесің бе?
Dialogue: 0,0:04:33.52,0:04:36.77,Default,,0,0,0,,Содан бері аңшылыққа құмарсың.
Dialogue: 0,0:04:37.27,0:04:39.27,Default,,0,0,0,,Құрметпен
Dialogue: 0,0:04:39.36,0:04:43.61,Default,,0,0,0,,Түсіндім! Ағам мені арнайы дайындықтан өткізуді жасырын жоспарлап отыр.
Dialogue: 0,0:04:43.70,0:04:44.86,Default,,0,0,0,,Оны жасырудың қажеті жоқ.
Dialogue: 0,0:04:45.53,0:04:47.95,Default,,0,0,0,,Мен жай ғана ілесіп жүрмін.
Dialogue: 0,0:04:48.03,0:04:51.33,Default,,0,0,0,,Құрметті Ричард! Сіздің хатыңыз келді.
Dialogue: 0,0:04:51.83,0:04:53.54,Default,,0,0,0,,Бөлмеңізде қалдырыңыз.
Dialogue: 0,0:04:54.04,0:04:55.79,Default,,0,0,0,,Мен кетемін, аға.
Dialogue: 0,0:04:57.04,0:04:59.63,Default,,0,0,0,,Эй, бұл Аннан хат...
Dialogue: 0,0:04:59.71,0:05:00.80,Default,,0,0,0,,Сондай-ақ Джорджға!
Dialogue: 0,0:05:01.30,0:05:03.30,Default,,0,0,0,,Изабельден тағы бір хат...
Dialogue: 0,0:05:03.38,0:05:05.26,Default,,0,0,0,,Әй... қатты айтпа!
Dialogue: 0,0:05:05.84,0:05:08.26,Default,,0,0,0,,Мен жай ғана ілесіп жүрмін.
Dialogue: 0,0:05:11.39,0:05:14.93,Default,,0,0,0,,Иә... ұлы мәртебелі құпияларды қорғау үшін.
Dialogue: 0,0:05:16.35,0:05:18.19,Default,,0,0,0,,Элизабетпен танысыңыз
Dialogue: 0,0:05:18.27,0:05:20.94,Default,,0,0,0,,Сіз аң аулағаныңызға бірнеше күн болды.
Dialogue: 0,0:05:21.02,0:05:23.65,Default,,0,0,0,,Менің осында болғаныма куә бол.
Dialogue: 0,0:05:23.74,0:05:25.99,Default,,0,0,0,,Неге сонша бардың...
Dialogue: 0,0:05:26.74,0:05:28.87,Default,,0,0,0,,Ол бір күні жария болады ма?
Dialogue: 0,0:05:29.57,0:05:35.20,Default,,0,0,0,,Сіз айтқандай, біздің қарым-қатынасымыз ерте ме, кеш пе жалпыға ортақ болады.
Dialogue: 0,0:05:35.71,0:05:40.21,Default,,0,0,0,,Сондықтан мен іс тым күрделі болмай тұрып, белсенді тәсілді қабылдауды шештім.
Dialogue: 0,0:05:42.34,0:05:47.05,Default,,0,0,0,,Ешкім білмей онымен той жасағалы жатырмын.
Dialogue: 0,0:05:47.55,0:05:49.51,Default,,0,0,0,,Бұл әзіл емес сияқты.
Dialogue: 0,0:05:49.59,0:05:51.39,Default,,0,0,0,,Мен әрқашан байсалдымын
Dialogue: 0,0:05:52.06,0:05:54.14,Default,,0,0,0,,Мен, Ричард.
Dialogue: 0,0:05:54.22,0:05:59.27,Default,,0,0,0,,Мен одан жақсы әйелді кездестірмеймін деп ойлаймын.
Dialogue: 0,0:05:59.77,0:06:04.11,Default,,0,0,0,,Оны жіберсем, өлгенше өкінемін.
Dialogue: 0,0:06:04.19,0:06:05.57,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:06:05.65,0:06:09.07,Default,,0,0,0,,Амансың ба? Сен енді сыбайлассың.
Dialogue: 0,0:06:09.86,0:06:14.70,Default,,0,0,0,,Махаббат деген не... Адамдарды соншалықты көрінбейтін етіп жасай алатын нәрсе ме?
Dialogue: 0,0:06:17.62,0:06:22.21,Default,,0,0,0,,Ел патшасы кәмелетке толмаған төренің жесірін алады?
Dialogue: 0,0:06:22.79,0:06:24.80,Default,,0,0,0,,Бұл проблема болуы мүмкін емес.
Dialogue: 0,0:06:25.96,0:06:26.71,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:06:27.92,0:06:31.68,Default,,0,0,0,,Анау әйелдің құны артық сияқты.
Dialogue: 0,0:06:32.68,0:06:37.31,Default,,0,0,0,,Әкем алу үшін жанын қиған тәжден де артық...
Dialogue: 0,0:06:38.10,0:06:39.85,Default,,0,0,0,,Тәжден де артық
Dialogue: 0,0:06:40.39,0:06:43.61,Default,,0,0,0,,Мен сізді осы жерде және қазір кездестіргеніме қуаныштымын.
Dialogue: 0,0:06:46.82,0:06:48.95,Default,,0,0,0,,Бұл орман емес.
Dialogue: 0,0:06:49.57,0:06:51.24,Default,,0,0,0,,Оның мұнда болуының себебі жоқ...
Dialogue: 0,0:06:53.20,0:06:55.54,Default,,0,0,0,,Мен оны соңғы рет көрдім.
Dialogue: 0,0:06:57.41,0:06:59.75,Default,,0,0,0,,Біз енді ешқашан кездеспейміз
Dialogue: 0,0:07:02.33,0:07:04.59,Default,,0,0,0,,Енді ешқашан...
Dialogue: 0,0:07:07.26,0:07:09.13,Default,,0,0,0,,Біз кездеспеуіміз керек.
Dialogue: 0,0:07:11.51,0:07:12.84,Default,,0,0,0,,Ричард?
Dialogue: 0,0:07:13.34,0:07:17.10,Default,,0,0,0,,А... Бәрімізді Құдай қосты.
Dialogue: 0,0:07:18.56,0:07:22.35,Default,,0,0,0,,Мен сені тағы көремін деп ойладым. Қалайсың?
Dialogue: 0,0:07:23.94,0:07:26.11,Default,,0,0,0,,Неге бұл жігіт үнемі
Dialogue: 0,0:07:26.61,0:07:29.44,Default,,0,0,0,,Кенет менің алдымда...
Dialogue: 0,0:07:31.53,0:07:33.03,Default,,0,0,0,,Сен неге...
Dialogue: 0,0:07:34.16,0:07:36.74,Default,,0,0,0,,Екеуміз де сол орманға қайта барғымыз келеді.
Dialogue: 0,0:07:36.83,0:07:41.66,Default,,0,0,0,,Сіз екеуміз әртүрлі жерде тұрамыз. Қой қораға тез орал.
Dialogue: 0,0:07:46.17,0:07:48.34,Default,,0,0,0,,Мен қойшы емеспін
Dialogue: 0,0:07:49.42,0:07:53.63,Default,,0,0,0,,Енді мен саяхатшымын, сені кездестіру үшін саяхаттадым.
Dialogue: 0,0:07:54.14,0:07:57.22,Default,,0,0,0,,Сен... менің қайтып келетін жерімсің.
Dialogue: 0,0:07:57.31,0:07:59.31,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:07:59.39,0:08:03.44,Default,,0,0,0,,Сен маған неге көңіл бөлесің?
Dialogue: 0,0:08:03.52,0:08:06.94,Default,,0,0,0,,Сен... сен менің құтқарушым едің.
Dialogue: 0,0:08:07.94,0:08:11.94,Default,,0,0,0,,Мен... құтқарылумын ба? Бұл мен?
Dialogue: 0,0:08:13.15,0:08:16.82,Default,,0,0,0,,Қақтығыс күндері жалғыз құтқарушы едің.
Dialogue: 0,0:08:17.41,0:08:21.62,Default,,0,0,0,,Сондықтан мен сенің қасымда болғаныңды қалаймын, аз ғана уақыт.
Dialogue: 0,0:08:26.79,0:08:28.50,Default,,0,0,0,,Жаңбыр тоқтағанша.
Dialogue: 0,0:08:33.01,0:08:35.72,Default,,0,0,0,,Киіміңді ауыстырамын, тез шеш.
Dialogue: 0,0:08:36.22,0:08:38.26,Default,,0,0,0,,Сіз жалғыз тұрасыз ба?
Dialogue: 0,0:08:38.35,0:08:40.06,Default,,0,0,0,,Фонды білгіңіз келе ме?
Dialogue: 0,0:08:40.14,0:08:42.52,Default,,0,0,0,,Жоқ, оның не екені маған бәрібір.
Dialogue: 0,0:08:43.35,0:08:46.15,Default,,0,0,0,,Маған ұнағаны - өзіңсің
Dialogue: 0,0:08:47.61,0:08:48.44,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:08:48.94,0:08:52.74,Default,,0,0,0,,Егер бұл жігіт менің шынымды білсе...
Dialogue: 0,0:09:01.66,0:09:02.50,Default,,0,0,0,,Не!
Dialogue: 0,0:09:03.08,0:09:04.87,Default,,0,0,0,,Тез арада киімдеріңізді шешуіңіз керек.
Dialogue: 0,0:09:05.37,0:09:07.21,Default,,0,0,0,,Мен суық тиіп қалуым мүмкін деп ойладым...
Dialogue: 0,0:09:09.88,0:09:13.01,Default,,0,0,0,,Мен саған ауыстыратын киім әкелемін. Осы жерде күтіңіз.
Dialogue: 0,0:09:14.17,0:09:17.89,Default,,0,0,0,,Сенің мінезің әйелдік болса да, сенің денең еркек.
Dialogue: 0,0:09:18.89,0:09:20.14,Default,,0,0,0,,Бұл анық па...
Dialogue: 0,0:09:21.01,0:09:22.14,Default,,0,0,0,,Бірақ мен басқашамын.
Dialogue: 0,0:09:23.06,0:09:27.44,Default,,0,0,0,,Қанша шынықсаң да әйелдің айғағы жоғалмайды.
Dialogue: 0,0:09:29.02,0:09:32.98,Default,,0,0,0,,Кеудеңді басып алсаң да, ішіңді көме алмайсың.
Dialogue: 0,0:09:36.15,0:09:38.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:38.11,0:09:40.62,Default,,0,0,0,,Эй, сен ас үйде не істеп жүрсің?
Dialogue: 0,0:09:40.70,0:09:42.16,Default,,0,0,0,,Бұл сорпа.
Dialogue: 0,0:09:42.66,0:09:45.16,Default,,0,0,0,,Мен мұны жасырын жасап, сізді таң қалдырамын деп ойладым.
Dialogue: 0,0:09:47.79,0:09:49.25,Default,,0,0,0,,Керемет тағам!
Dialogue: 0,0:09:49.88,0:09:52.59,Default,,0,0,0,,Мен де бұрын тамақ пісірген емеспін.
Dialogue: 0,0:09:55.26,0:09:56.80,Default,,0,0,0,,Бірдеңе жетіспеді.
Dialogue: 0,0:09:57.30,0:10:00.68,Default,,0,0,0,,Даршын туралы не деуге болады? Мен әкелемін
Dialogue: 0,0:10:03.22,0:10:07.73,Default,,0,0,0,,Жарай ма? Тақуа қойшы, Түн ортасында
Dialogue: 0,0:10:08.23,0:10:09.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:09.56,0:10:10.77,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:10:11.61,0:10:14.03,Default,,0,0,0,,Мен кешеден бері ештеңе жеген жоқпын.
Dialogue: 0,0:10:14.82,0:10:17.03,Default,,0,0,0,,Құдай мені де кешіреді деп ойлаймын.
Dialogue: 0,0:10:17.11,0:10:21.28,Default,,0,0,0,,Не? Оны алғыс ретінде емес, өзі жегісі келген шығар.
Dialogue: 0,0:10:21.78,0:10:24.04,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:10:24.54,0:10:27.25,Default,,0,0,0,,Ол үшін уайымдама, тез тамақтан.
Dialogue: 0,0:10:27.33,0:10:28.25,Default,,0,0,0,,Иә
Dialogue: 0,0:10:30.79,0:10:32.21,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:10:33.00,0:10:33.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:36.96,0:10:39.22,Default,,0,0,0,,Мен мұндай дәмді сорпаны ешқашан ішкен емеспін.
Dialogue: 0,0:10:39.30,0:10:42.26,Default,,0,0,0,,Диқанның сорпасы бұршақ туралы болса керек.
Dialogue: 0,0:10:42.35,0:10:43.80,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:10:43.89,0:10:46.47,Default,,0,0,0,,Өзіңіз жасағанда дәмі әлдеқайда жақсы болады.
Dialogue: 0,0:10:46.56,0:10:49.14,Default,,0,0,0,,Мен оның көп бөлігін жасадым.
Dialogue: 0,0:10:49.23,0:10:51.94,Default,,0,0,0,,Иә, сондықтан дәмді болды.
Dialogue: 0,0:10:53.27,0:10:55.40,Default,,0,0,0,,Ричардқа рахмет
Dialogue: 0,0:10:58.07,0:11:00.61,Default,,0,0,0,,Осы қарқынмен таңға дейін тоқтамайды.
Dialogue: 0,0:11:02.24,0:11:03.78,Default,,0,0,0,,Мен саған төсек беремін
Dialogue: 0,0:11:03.87,0:11:05.12,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:11:05.20,0:11:07.58,Default,,0,0,0,,Жаңбыр басылғанша күтуге уәде бердің
Dialogue: 0,0:11:08.16,0:11:10.58,Default,,0,0,0,,Таңертең өз бетіңізше кетіңіз
Dialogue: 0,0:11:11.62,0:11:13.96,Default,,0,0,0,,…
Dialogue: 0,0:11:14.46,0:11:16.92,Default,,0,0,0,,Бірге жату дұрыс емес пе?
Dialogue: 0,0:11:18.17,0:11:20.01,Default,,0,0,0,,Сіздің бөлмеңіз сол жерде.
Dialogue: 0,0:11:20.09,0:11:23.01,Default,,0,0,0,,Мен сенімен көбірек сөйлескім келеді
Dialogue: 0,0:11:23.51,0:11:26.22,Default,,0,0,0,,Мен оянсам, бәрі бітті...
Dialogue: 0,0:11:26.31,0:11:30.06,Default,,0,0,0,,Мен бала емеспін. Тек өзіңіз ұйықтаңыз.
Dialogue: 0,0:11:37.23,0:11:39.44,Default,,0,0,0,,Артық емес.
Dialogue: 0,0:11:39.94,0:11:41.65,Default,,0,0,0,,Егер мен онымен бұдан былай бірге қалсам...
Dialogue: 0,0:11:43.57,0:11:46.62,Default,,0,0,0,,Ричард, саған не ұнайды?
Dialogue: 0,0:11:47.37,0:11:48.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:49.08,0:11:50.58,Default,,0,0,0,,Сіздің сүйікті тағамыңыз қандай?
Dialogue: 0,0:11:51.21,0:11:54.58,Default,,0,0,0,,Сүйікті әні: Аспанның түсі...
Dialogue: 0,0:11:55.58,0:11:57.50,Default,,0,0,0,,Жаңбырлы күні не ойнайсың?
Dialogue: 0,0:11:58.67,0:12:03.38,Default,,0,0,0,,Енді менімен араласпа...
Dialogue: 0,0:12:08.01,0:12:11.35,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:12:12.60,0:12:13.73,Default,,0,0,0,,Құйып жатыр!
Dialogue: 0,0:12:14.85,0:12:16.02,Default,,0,0,0,,Сіз бақытты көрінесіз.
Dialogue: 0,0:12:16.11,0:12:17.52,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:12:17.61,0:12:19.69,Default,,0,0,0,,Себебі мен сенімен көбірек сөйлескім келді.
Dialogue: 0,0:12:19.78,0:12:23.90,Default,,0,0,0,,Мен құлықсызмын, бірақ уәде бермей тұра алмаймын.
Dialogue: 0,0:12:23.99,0:12:27.91,Default,,0,0,0,,Оның үстіне ағам бәрібір біраз уақыт келмейтін шығар.
Dialogue: 0,0:12:30.54,0:12:31.58,Default,,0,0,0,,Бұл құлпынай.
Dialogue: 0,0:12:31.66,0:12:32.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:33.04,0:12:34.54,Default,,0,0,0,,Сүйікті тағам...
Dialogue: 0,0:12:35.62,0:12:37.00,Default,,0,0,0,,Мен де сені жақсы көремін!
Dialogue: 0,0:12:38.59,0:12:39.21,Default,,0,0,0,,Құрметті Эдвард
Dialogue: 0,0:12:40.09,0:12:42.88,Default,,0,0,0,,Барда Генри мырзамен кездескенін айтқан бір адам болды.
Dialogue: 0,0:12:42.97,0:12:45.13,Default,,0,0,0,,Бұл жай ғана мас қалжың емес пе?
Dialogue: 0,0:12:45.63,0:12:46.68,Default,,0,0,0,,Генри мырза
Dialogue: 0,0:12:46.76,0:12:48.43,Default,,0,0,0,,Ол Ричард есімді адамды іздеді...
Dialogue: 0,0:12:49.85,0:12:50.89,Default,,0,0,0,,Ричард?
Dialogue: 0,0:12:50.97,0:12:53.10,Default,,0,0,0,,Мен карта мен шахмат ойнамаймын...
Dialogue: 0,0:12:53.60,0:12:56.85,Default,,0,0,0,,Күн сағаттарын жасамайтын күндері не істейсіз?
Dialogue: 0,0:12:57.56,0:12:59.44,Default,,0,0,0,,Мені есіңе түсірдің деп үміттенемін.
Dialogue: 0,0:12:59.94,0:13:02.61,Default,,0,0,0,,Адамдармен жарысқанды ұнатпаймын.
Dialogue: 0,0:13:03.11,0:13:05.32,Default,,0,0,0,,Мен сіз туралы көбірек естігім келеді.
Dialogue: 0,0:13:05.40,0:13:07.20,Default,,0,0,0,,Мен бәрін айттым
Dialogue: 0,0:13:07.70,0:13:09.33,Default,,0,0,0,,Ертегі жақсы.
Dialogue: 0,0:13:12.58,0:13:15.62,Default,,0,0,0,,Мен ағам сияқты көп оқырман емеспін...
Dialogue: 0,0:13:18.38,0:13:22.00,Default,,0,0,0,,Шайтанның оқиғасы...шайтанның баласы
Dialogue: 0,0:13:23.84,0:13:29.05,Default,,0,0,0,,Бала дүниеге келген күні қатты дауыл ағаштарды құлатты.
Dialogue: 0,0:13:29.55,0:13:34.85,Default,,0,0,0,,Түнгі әйнек бақытсыз уақыттардың келгенін хабарлап жылайды.
Dialogue: 0,0:13:35.98,0:13:39.44,Default,,0,0,0,,Ана босану кезінде ерекше ауырсынуды бастан кешірді.
Dialogue: 0,0:13:39.52,0:13:42.23,Default,,0,0,0,,Туған шіркін баламды жек көрдім
Dialogue: 0,0:13:42.78,0:13:44.28,Default,,0,0,0,,Пайғамбар айтты
Dialogue: 0,0:13:44.78,0:13:49.03,Default,,0,0,0,,«Бір күні әркім баласы туған күнін қарғайды».
Dialogue: 0,0:13:51.33,0:13:53.66,Default,,0,0,0,,Баланы жақсы көретін ешкім болмады ма?
Dialogue: 0,0:13:54.16,0:13:56.41,Default,,0,0,0,,Білмей маған жақындаған адам
Dialogue: 0,0:13:56.50,0:13:59.75,Default,,0,0,0,,Баланың жын екенін білсе, кетеді.
Dialogue: 0,0:14:00.25,0:14:02.80,Default,,0,0,0,,Бала кімді жақсы көрді?
Dialogue: 0,0:14:04.30,0:14:05.84,Default,,0,0,0,,Мен сүйген адам...
Dialogue: 0,0:14:08.72,0:14:12.43,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:14:13.39,0:14:15.18,Default,,0,0,0,,Сіз қызықсыз сөйледіңіз.
Dialogue: 0,0:14:15.68,0:14:17.77,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:14:18.39,0:14:19.56,Default,,0,0,0,,Ричард…
Dialogue: 0,0:14:20.31,0:14:20.86,Default,,0,0,0,,Ричард!
Dialogue: 0,0:14:21.81,0:14:22.82,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:14:30.11,0:14:31.78,Default,,0,0,0,,Сіз аздап көп ішкенсіз.
Dialogue: 0,0:14:32.45,0:14:35.16,Default,,0,0,0,,Мен бірінші рет шарапты көп ішіп отырмын.
Dialogue: 0,0:14:36.16,0:14:38.37,Default,,0,0,0,,Мен сенімен сөйлескенде, неге?
Dialogue: 0,0:14:38.87,0:14:41.79,Default,,0,0,0,,Әрқашан дөрекі сөйлейді
Dialogue: 0,0:14:42.46,0:14:44.59,Default,,0,0,0,,Тек сіз үшін Неге...
Dialogue: 0,0:14:45.84,0:14:47.42,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,0:14:48.51,0:14:51.14,Default,,0,0,0,,Мүмкін сенімен...
Dialogue: 0,0:14:57.85,0:14:58.93,Default,,0,0,0,,Ричард…
Dialogue: 0,0:14:59.44,0:15:01.23,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:15:01.90,0:15:04.40,Default,,0,0,0,,Мені кешіре гөр, Құдайым...
Dialogue: 0,0:15:06.44,0:15:07.32,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:15:08.28,0:15:10.28,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:15:10.36,0:15:11.78,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:15:12.45,0:15:15.49,Default,,0,0,0,,Мен найзағай ойнай алмаймын...
Dialogue: 0,0:15:22.00,0:15:24.25,Default,,0,0,0,,Мен де онша жақсы емеспін.
Dialogue: 0,0:15:24.88,0:15:28.21,Default,,0,0,0,,Мен бүгін сенімен ұйықтаймын.
Dialogue: 0,0:15:29.63,0:15:32.55,Default,,0,0,0,,Мен... сенің құтқарушыңмын дедің.
Dialogue: 0,0:15:33.55,0:15:37.26,Default,,0,0,0,,Біз кездескен сайын құтқарылған адам шығар
Dialogue: 0,0:15:38.85,0:15:40.14,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,0:15:45.27,0:15:47.57,Default,,0,0,0,,Егер сенің әкең осында болса.
Dialogue: 0,0:15:47.65,0:15:49.03,Default,,0,0,0,,Кешіктіруге жол берілмейді
Dialogue: 0,0:15:49.65,0:15:50.74,Default,,0,0,0,,Қарсыластың жағдайын тексеру
Dialogue: 0,0:15:50.82,0:15:52.70,Default,,0,0,0,,Күте тұрыңыз, Эдвард!
Dialogue: 0,0:15:52.78,0:15:56.28,Default,,0,0,0,,Адам көп болғанда көзге түседі. Осы жерде күтіңіз.
Dialogue: 0,0:15:59.33,0:16:00.20,Default,,0,0,0,,Генри?
Dialogue: 0,0:16:02.92,0:16:05.71,Default,,0,0,0,,Мүмкін ол осында шығар...
Dialogue: 0,0:16:06.96,0:16:08.88,Default,,0,0,0,,Мен сенімен осылай болғанда
Dialogue: 0,0:16:08.96,0:16:11.51,Default,,0,0,0,,Мен өз елімді ұмытатындай сезінемін.
Dialogue: 0,0:16:12.01,0:16:13.84,Default,,0,0,0,,Жоқ, Мәртебелі.
Dialogue: 0,0:16:15.89,0:16:17.81,Default,,0,0,0,,Сәлем Элизабет
Dialogue: 0,0:16:18.31,0:16:21.02,Default,,0,0,0,,Сендер мұндай ертегіні естідіңдер ме?
Dialogue: 0,0:16:22.60,0:16:24.06,Default,,0,0,0,,Бір жерде
Dialogue: 0,0:16:24.56,0:16:28.65,Default,,0,0,0,,Бір бай әке бар еді, оның кітабында болашақтың бәрі жазылған.
Dialogue: 0,0:16:29.44,0:16:33.32,Default,,0,0,0,,Кітапта ұлының тағдыры да жазылған.
Dialogue: 0,0:16:35.82,0:16:39.95,Default,,0,0,0,,«Собор жанындағы кедей фермерден туған қызбен».
Dialogue: 0,0:16:40.95,0:16:43.12,Default,,0,0,0,,«Мен бір күні үйленемін»
Dialogue: 0,0:16:48.88,0:16:55.38,Default,,0,0,0,,Әкесі қызын тауып алып, оны ұлынан қайта-қайта ажыратуға тырысады.
Dialogue: 0,0:16:57.14,0:16:59.39,Default,,0,0,0,,Ғажайып болған сайын
Dialogue: 0,0:17:01.52,0:17:03.77,Default,,0,0,0,,Екеуі кездеседі
Dialogue: 0,0:17:06.85,0:17:11.82,Default,,0,0,0,,Басқаша айтқанда, ешкім тағдырға қарсы шыға алмайды.
Dialogue: 0,0:17:16.32,0:17:17.95,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:22.08,0:17:23.08,Default,,0,0,0,,Ричард!
Dialogue: 0,0:17:24.91,0:17:26.83,Default,,0,0,0,,Сәлем! Сенімен бәрі жақсы ма?
Dialogue: 0,0:17:27.33,0:17:28.92,Default,,0,0,0,,Ей, не істеуім керек...
Dialogue: 0,0:17:40.51,0:17:42.01,Default,,0,0,0,,Генри? (Генри) А...
Dialogue: 0,0:17:42.60,0:17:43.47,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:45.48,0:17:48.65,Default,,0,0,0,,Бұл жігіт... мен бе?
Dialogue: 0,0:17:53.57,0:17:55.90,Default,,0,0,0,,Міне, Ричард, бұл ғажайып!
Dialogue: 0,0:17:56.40,0:17:59.11,Default,,0,0,0,,Ол жуылмаған күйде қалады, көрдің бе?
Dialogue: 0,0:18:01.28,0:18:02.12,Default,,0,0,0,,Құлпынай…
Dialogue: 0,0:18:03.12,0:18:05.29,Default,,0,0,0,,Бұл жағада олар өте көп.
Dialogue: 0,0:18:05.79,0:18:08.75,Default,,0,0,0,,Негізі мен сені жасырын таң қалдырғым келді.
Dialogue: 0,0:18:10.58,0:18:12.80,Default,,0,0,0,,Мен кеткендей емес...
Dialogue: 0,0:18:13.80,0:18:15.21,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:18:16.42,0:18:18.80,Default,,0,0,0,,Сен менің қайтып келетін жерімсің
Dialogue: 0,0:18:25.68,0:18:26.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:28.52,0:18:30.27,Default,,0,0,0,,Енді ше...
Dialogue: 0,0:18:31.06,0:18:32.52,Default,,0,0,0,,Мен не істеп жатырмын...
Dialogue: 0,0:18:33.48,0:18:37.11,Default,,0,0,0,,Генри, сен мені жынды қылдың.
Dialogue: 0,0:18:37.90,0:18:40.36,Default,,0,0,0,,Сіз ұзақ уақыт алған жауап
Dialogue: 0,0:18:41.20,0:18:44.62,Default,,0,0,0,,Мен бәрін жоғалтатын сияқтымын
Dialogue: 0,0:18:45.29,0:18:46.50,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:18:47.25,0:18:51.21,Default,,0,0,0,,Бәрібір, мәңгі және мәңгі...
Dialogue: 0,0:18:54.75,0:18:55.96,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:18:56.05,0:18:58.84,Default,,0,0,0,,Келесі уәдені бере аламыз ба?
Dialogue: 0,0:18:59.47,0:19:01.43,Default,,0,0,0,,Егер біз тағы да кездесуге уәде берсек
Dialogue: 0,0:19:01.93,0:19:04.64,Default,,0,0,0,,Мен оны қайтатын орынға айналдыру арқылы өмір сүре аламын.
Dialogue: 0,0:19:05.14,0:19:06.72,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:07.31,0:19:09.64,Default,,0,0,0,,Егер мен сенімен бұдан былай қалсам...
Dialogue: 0,0:19:09.73,0:19:11.73,Default,,0,0,0,,Өтінемін, Ричард.
Dialogue: 0,0:19:13.06,0:19:14.69,Default,,0,0,0,,Үй иесі қайтып келді
Dialogue: 0,0:19:14.77,0:19:16.94,Default,,0,0,0,,Енді бұл жерге келме
Dialogue: 0,0:19:17.65,0:19:20.61,Default,,0,0,0,,Осы уақытқа дейін мен сені кездестіремін деп уәде берген емеспін.
Dialogue: 0,0:19:20.70,0:19:22.95,Default,,0,0,0,,Бірақ осылай...
Dialogue: 0,0:19:23.70,0:19:25.53,Default,,0,0,0,,Шинигами қалай өледі екен.
Dialogue: 0,0:19:25.62,0:19:27.95,Default,,0,0,0,,Біз тағы кездесетінімізге сенімдімін...
Dialogue: 0,0:19:41.26,0:19:41.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:43.51,0:19:46.89,Default,,0,0,0,,Ричард, сен де еркек едің.
Dialogue: 0,0:19:46.97,0:19:48.43,Default,,0,0,0,,Сіздің серіктесіңіз қандай әйел?
Dialogue: 0,0:19:49.77,0:19:51.06,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:51.56,0:19:55.23,Default,,0,0,0,,Жасыратын ештеңе жоқ Келесі уәдені бердіңіз бе?
Dialogue: 0,0:19:56.36,0:19:57.36,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:57.94,0:19:59.40,Default,,0,0,0,,Сізде өкініш бар ма?
Dialogue: 0,0:20:02.07,0:20:04.36,Default,,0,0,0,,Ағамның үйлену тойындай.
Dialogue: 0,0:20:04.45,0:20:09.95,Default,,0,0,0,,Өкінбеймін, жаныма қарай сүйдім.
Dialogue: 0,0:20:10.04,0:20:13.79,Default,,0,0,0,,Бұл кездесу – Құдайдың шақыруы.
Dialogue: 0,0:20:14.42,0:20:17.75,Default,,0,0,0,,Қараңдаршы, Ричард, өте әдемі.
Dialogue: 0,0:20:22.93,0:20:25.39,Default,,0,0,0,,(Дворяндар сөйлейді)
Dialogue: 0,0:20:25.47,0:20:29.01,Default,,0,0,0,,Бүгін тағы да тамаша көңіл күйдесің, аға.
Dialogue: 0,0:20:30.97,0:20:33.73,Default,,0,0,0,,Мәртебелі, мен сізге баяндағым келеді.
Dialogue: 0,0:20:33.81,0:20:37.23,Default,,0,0,0,,Қайтып келдің бе, Уорвик? Жақсы жаңалық?
Dialogue: 0,0:20:37.31,0:20:38.19,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:20:38.27,0:20:40.28,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:20:40.36,0:20:43.40,Default,,0,0,0,,Менің де бүгін баршаның алдында жария еткім келетін бір нәрсе бар.
Dialogue: 0,0:20:45.53,0:20:48.28,Default,,0,0,0,,Уорвик графы, мен сізден бастайын.
Dialogue: 0,0:20:48.83,0:20:49.41,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:20:49.91,0:20:55.67,Default,,0,0,0,,Бұл жолы Мәртебелі Эдвард пен Франция королінің әпкесі Бона ханшайымының арасында.
Dialogue: 0,0:20:55.75,0:20:59.92,Default,,0,0,0,,Біз келіскенімізді хабарлаймыз.
Dialogue: 0,0:21:00.00,0:21:02.30,Default,,0,0,0,,О! Бұл құптарлық
Dialogue: 0,0:21:02.38,0:21:03.76,Default,,0,0,0,,Құттықтаймыз, Мәртебелі!
Dialogue: 0,0:21:05.38,0:21:07.14,Default,,0,0,0,,Менен де құттықтаймын.
Dialogue: 0,0:21:09.01,0:21:09.76,Default,,0,0,0,,Мәртебелі?
Dialogue: 0,0:21:12.18,0:21:13.35,Default,,0,0,0,,Уорвик
Dialogue: 0,0:21:13.43,0:21:16.56,Default,,0,0,0,,Ланкастерді жеңу шайқасынан бері
Dialogue: 0,0:21:16.65,0:21:20.27,Default,,0,0,0,,Біздің жанымыз берік тізбекпен байланысқан.
Dialogue: 0,0:21:21.36,0:21:22.11,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:21:23.36,0:21:24.70,Default,,0,0,0,,Құдайдың атымен
Dialogue: 0,0:21:24.78,0:21:25.57,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:21:25.65,0:21:26.61,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:21:27.61,0:21:30.49,Default,,0,0,0,,Менің де барлығына айтқым келетін бір нәрсе бар.
Dialogue: 0,0:21:35.75,0:21:36.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:42.46,0:21:43.59,Default,,0,0,0,,Танысайық
Dialogue: 0,0:21:45.51,0:21:47.05,Default,,0,0,0,,Менің әйелім
Dialogue: 0,0:22:01.52,0:22:03.53,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
