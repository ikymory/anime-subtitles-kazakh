Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.08,0:00:06.84,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:00:08.50,0:00:09.17,Default,,0,0,0,,Кэтсби
Dialogue: 0,0:00:09.88,0:00:11.63,Default,,0,0,0,,Өйткені бүгін ауа-райы жақсы
Dialogue: 0,0:00:11.72,0:00:14.55,Default,,0,0,0,,Анам мені орманға апарамын деді.
Dialogue: 0,0:00:15.05,0:00:18.39,Default,,0,0,0,,Енді орманның тереңіне барайық
Dialogue: 0,0:00:20.22,0:00:21.39,Default,,0,0,0,,Кэтсби
Dialogue: 0,0:00:22.10,0:00:25.10,Default,,0,0,0,,Білесің бе... Орманда адасып кетсем ше?
Dialogue: 0,0:00:25.19,0:00:27.23,Default,,0,0,0,,Кел, мені алып кет.
Dialogue: 0,0:00:28.61,0:00:31.15,Default,,0,0,0,,Кэтсби Бұл жеткілікті.
Dialogue: 0,0:00:38.03,0:00:39.87,Default,,0,0,0,,Бұл тәтті құлпынай пирогы.
Dialogue: 0,0:00:39.95,0:00:42.45,Default,,0,0,0,,Сүйікті жанұяңызға кәдесый алсаңыз ше?
Dialogue: 0,0:00:45.67,0:00:47.83,Default,,0,0,0,,Баруға еш себеп жоқ...
Dialogue: 0,0:00:49.00,0:00:52.17,Default,,0,0,0,,Егер Ричард ұлы мәртебелі эгоизм туралы ештеңе айтпаса.
Dialogue: 0,0:00:52.26,0:00:54.63,Default,,0,0,0,,Менің анам Элизабетке сенуден басқа амалым жоқ.
Dialogue: 0,0:00:55.13,0:00:56.76,Default,,0,0,0,,«қаһарман» мамандығы пайда болды
Dialogue: 0,0:00:56.84,0:00:58.85,Default,,0,0,0,,Ол маған біраз кеңес бергенін айтты.
Dialogue: 0,0:00:58.93,0:01:01.01,Default,,0,0,0,,Бұл сатқындық болмас еді, солай ма?
Dialogue: 0,0:01:01.68,0:01:02.77,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:01:06.52,0:01:08.56,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:08.65,0:01:10.69,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:11.19,0:01:17.20,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:17.70,0:01:22.54,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:26.50,0:01:28.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:52.83,0:02:54.84,Default,,0,0,0,,～♪
Dialogue: 0,0:02:57.21,0:03:00.38,Default,,0,0,0,,Таққа отыруыңыз үшін
Dialogue: 0,0:03:00.47,0:03:02.30,Default,,0,0,0,,Келесі конгресс - шайқас.
Dialogue: 0,0:03:02.80,0:03:06.10,Default,,0,0,0,,Бізбен кім келісе алады?
Dialogue: 0,0:03:06.18,0:03:08.68,Default,,0,0,0,,Менің оқуым дәл қазір 50/50.
Dialogue: 0,0:03:09.35,0:03:12.44,Default,,0,0,0,,Нортумберленд графы мен лорд Ховард қатты
Dialogue: 0,0:03:12.94,0:03:15.90,Default,,0,0,0,,Хастингс пен Стэнлиді көндіру керек.
Dialogue: 0,0:03:16.57,0:03:18.03,Default,,0,0,0,,Ели епископ туралы не деуге болады?
Dialogue: 0,0:03:18.53,0:03:20.53,Default,,0,0,0,,Ол адамды ақшаға сатып алуға болады.
Dialogue: 0,0:03:21.11,0:03:22.74,Default,,0,0,0,,Онда мен сені баураймын.
Dialogue: 0,0:03:23.24,0:03:26.03,Default,,0,0,0,,Мен Ховардпен және басқалармен қайта кездесемін...
Dialogue: 0,0:03:26.53,0:03:28.79,Default,,0,0,0,,Оған жүрегімді салмасам ше?
Dialogue: 0,0:03:29.79,0:03:33.21,Default,,0,0,0,,Ерініңіз құмарланып сыбырласса
Dialogue: 0,0:03:33.29,0:03:35.67,Default,,0,0,0,,Ешкім жоқ демейді.
Dialogue: 0,0:03:35.75,0:03:36.92,Default,,0,0,0,,Бұл жұмыс істемесе ше?
Dialogue: 0,0:03:37.00,0:03:38.63,Default,,0,0,0,,Менің сені өлтіруден басқа амалым жоқ.
Dialogue: 0,0:03:39.92,0:03:43.43,Default,,0,0,0,,Өлтірмесек, ақыры өлім жазасына кесіледі.
Dialogue: 0,0:03:43.93,0:03:46.97,Default,,0,0,0,,Біз Құдаймен құмар ойнап жатырмыз.
Dialogue: 0,0:03:47.06,0:03:49.77,Default,,0,0,0,,Егер Хастингс
Dialogue: 0,0:03:50.27,0:03:52.56,Default,,0,0,0,,Оған не болады...?
Dialogue: 0,0:03:52.64,0:03:53.39,Default,,0,0,0,,Бұл жігіт пе?
Dialogue: 0,0:03:53.48,0:03:56.98,Default,,0,0,0,,Кэтсби - адал адам.
Dialogue: 0,0:03:57.77,0:04:02.40,Default,,0,0,0,,Ол маған өшпенділікпен қарайды ма?
Dialogue: 0,0:04:03.74,0:04:06.91,Default,,0,0,0,,Корольдік отбасына шын көңіл бөлетін адам түсінеді.
Dialogue: 0,0:04:08.33,0:04:11.66,Default,,0,0,0,,Бірақ жолында тікен тұрса
Dialogue: 0,0:04:11.75,0:04:14.29,Default,,0,0,0,,Мен оны өз қолыммен жұлып алғанша.
Dialogue: 0,0:04:19.59,0:04:21.21,Default,,0,0,0,,Ана, мен келдім!
Dialogue: 0,0:04:21.71,0:04:24.34,Default,,0,0,0,,Иә... Күтуден шаршадым.
Dialogue: 0,0:04:25.47,0:04:28.05,Default,,0,0,0,,Баяу Хастингс
Dialogue: 0,0:04:28.14,0:04:28.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:30.06,0:04:32.23,Default,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,0:04:32.31,0:04:33.69,Default,,0,0,0,,Лорд Хастингс
Dialogue: 0,0:04:34.19,0:04:36.40,Default,,0,0,0,,E... Құрметті Элизабет
Dialogue: 0,0:04:36.90,0:04:40.44,Default,,0,0,0,,Кешіріңіз, келе жатқанда қиындыққа тап болдыңыз.
Dialogue: 0,0:04:40.53,0:04:44.24,Default,,0,0,0,,Дәл қазір мен күн сайын тыныш өмір сүруім үшін дұға етемін...
Dialogue: 0,0:04:44.82,0:04:48.70,Default,,0,0,0,,Сіз осында болсаңыз, мен сіздің қауіпсіздігіңізге кепілдік беремін.
Dialogue: 0,0:04:48.78,0:04:51.20,Default,,0,0,0,,Мен жай ғана кеңес алғым келеді.
Dialogue: 0,0:04:52.04,0:04:56.17,Default,,0,0,0,,Ал... Сізге менің кеңесім керек пе?
Dialogue: 0,0:04:57.00,0:05:01.46,Default,,0,0,0,,Осылайша менде тіпті дұшпанымнан, өзімнен де ақыл-кеңес сұрауға адалдық бар.
Dialogue: 0,0:05:02.67,0:05:04.26,Default,,0,0,0,,Лорд Хастингс
Dialogue: 0,0:05:04.34,0:05:07.59,Default,,0,0,0,,Сіз сияқты біреу регент болуға лайықты.
Dialogue: 0,0:05:07.68,0:05:09.76,Default,,0,0,0,,Және... шектен шыққан.
Dialogue: 0,0:05:09.85,0:05:10.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:11.01,0:05:14.81,Default,,0,0,0,,Мен Эдвардты сіздің қамқорлығыңызға сеніммен қалдыра аламын.
Dialogue: 0,0:05:17.35,0:05:20.31,Default,,0,0,0,,Ричардқа есеп беруім керек пе...
Dialogue: 0,0:05:20.90,0:05:23.90,Default,,0,0,0,,Бірақ бұл туралы Букингем герцогы білсе...
Dialogue: 0,0:05:23.99,0:05:25.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:25.24,0:05:27.16,Default,,0,0,0,,Мен қайда баруым керек?
Dialogue: 0,0:05:27.24,0:05:28.70,Default,,0,0,0,,Лорд Хастингс
Dialogue: 0,0:05:29.20,0:05:33.33,Default,,0,0,0,,Менің ойымша, қасиетті жер сіздің сүйіктіңізбен кездесуге лайықты орын емес.
Dialogue: 0,0:05:33.83,0:05:36.87,Default,,0,0,0,,Ана патшайыммен кездеспесеңіз.
Dialogue: 0,0:05:36.96,0:05:40.42,Default,,0,0,0,,Ол өз ойын толығымен өзгертті.
Dialogue: 0,0:05:40.50,0:05:41.79,Default,,0,0,0,,Біртүрлі ниет жоқ...
Dialogue: 0,0:05:41.88,0:05:42.92,Default,,0,0,0,,Жоғары мәртебелі герцог!
Dialogue: 0,0:05:43.71,0:05:45.38,Default,,0,0,0,,Менің айтарым бар.
Dialogue: 0,0:05:45.88,0:05:47.84,Default,,0,0,0,,Лорд Хастингс корольдік отбасы туралы ойлады.
Dialogue: 0,0:05:47.93,0:05:50.80,Default,,0,0,0,,Сіз әрекет жасап жатқаныңызға күмән жоқ.
Dialogue: 0,0:05:51.85,0:05:55.77,Default,,0,0,0,,Менің сөзім өтірік болса, мені жазалаңыз.
Dialogue: 0,0:05:56.35,0:05:57.44,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:57.52,0:06:00.86,Default,,0,0,0,,Енді саған Жаратқан Иенің атынан айтар сөзім бар.
Dialogue: 0,0:06:01.52,0:06:02.07,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:06:04.07,0:06:05.94,Default,,0,0,0,,Неліктен Хастингсті қорғадың?
Dialogue: 0,0:06:06.82,0:06:10.41,Default,,0,0,0,,Өле-өлгенше мінсіз адам болу тілегің бе?
Dialogue: 0,0:06:12.24,0:06:14.41,Default,,0,0,0,,Сіздің қожайыныңыз кім?
Dialogue: 0,0:06:15.37,0:06:16.70,Default,,0,0,0,,Раббым...
Dialogue: 0,0:06:16.79,0:06:19.50,Default,,0,0,0,,Сіз оны басқаларға қарағанда жақсы түсінемін деп ойлайсыз ба?
Dialogue: 0,0:06:19.58,0:06:20.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:20.79,0:06:24.46,Default,,0,0,0,,Оның енді қалайтыны мейірімділік емес.
Dialogue: 0,0:06:24.96,0:06:26.67,Default,,0,0,0,,Сіз шайтан бола алмайсыз
Dialogue: 0,0:06:27.30,0:06:29.72,Default,,0,0,0,,Ричардты құтқара алмайсыз.
Dialogue: 0,0:06:37.10,0:06:38.85,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:38.94,0:06:40.98,Default,,0,0,0,,Сіз епископ Элимен кездестіңіз, солай ма?
Dialogue: 0,0:06:41.48,0:06:43.06,Default,,0,0,0,,Оны ақшаға сатып алуға болады ма?
Dialogue: 0,0:06:44.32,0:06:46.65,Default,,0,0,0,,Күте тұрыңыз... Бұл қандай белгі?
Dialogue: 0,0:06:47.90,0:06:50.86,Default,,0,0,0,,Епископ азғындықтың дәмін татқан сияқты.
Dialogue: 0,0:06:51.95,0:06:54.87,Default,,0,0,0,,Ол ақша емес, менің денемді сұрады.
Dialogue: 0,0:06:56.24,0:06:58.62,Default,,0,0,0,,Ол сені арамдады ма?
Dialogue: 0,0:06:59.12,0:07:02.08,Default,,0,0,0,,Ішіңнен қуып, жыртып тастаймын.
Dialogue: 0,0:07:02.17,0:07:07.46,Default,,0,0,0,,Не нәрсеге ашулануға болады? Бұл епископтың қолдауын күшейтті.
Dialogue: 0,0:07:08.63,0:07:11.55,Default,,0,0,0,,Неге сонша ашуланасың? Айтыңызшы
Dialogue: 0,0:07:12.30,0:07:13.39,Default,,0,0,0,,Бұл ант.
Dialogue: 0,0:07:15.64,0:07:17.52,Default,,0,0,0,,Сонда ол бұзылмайды.
Dialogue: 0,0:07:18.02,0:07:20.98,Default,,0,0,0,,Мен бұл денені сенен басқа ешкімге ашпаймын.
Dialogue: 0,0:07:23.69,0:07:25.31,Default,,0,0,0,,Мен ертерек құтқарылдым.
Dialogue: 0,0:07:25.90,0:07:29.36,Default,,0,0,0,,Мен сіздей таза, адал адамды кездестірмедім.
Dialogue: 0,0:07:31.90,0:07:33.32,Default,,0,0,0,,Сіздің қожайыныңыз кім?
Dialogue: 0,0:07:34.28,0:07:36.83,Default,,0,0,0,,Ричардты құтқара алмайсыз.
Dialogue: 0,0:07:41.71,0:07:42.75,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:07:43.25,0:07:44.25,Default,,0,0,0,,Кэтсби?
Dialogue: 0,0:07:45.00,0:07:46.46,Default,,0,0,0,,Менің саған айтатын әңгімем бар.
Dialogue: 0,0:07:46.96,0:07:48.25,Default,,0,0,0,,Қазір мүмкін емес
Dialogue: 0,0:07:48.34,0:07:51.05,Default,,0,0,0,,Маған бәрібір, кіріңіз.
Dialogue: 0,0:07:52.22,0:07:55.47,Default,,0,0,0,,Лорд Хастингс туралы айтатыным бар.
Dialogue: 0,0:07:56.60,0:07:57.68,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:59.02,0:08:01.43,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:08:02.10,0:08:04.65,Default,,0,0,0,,Ол кісі тікенге айналса...
Dialogue: 0,0:08:05.35,0:08:08.65,Default,,0,0,0,,Егер сіз пышағыңызды маған бағыттасаңыз...
Dialogue: 0,0:08:14.11,0:08:15.66,Default,,0,0,0,,Лорд Хастингс
Dialogue: 0,0:08:15.74,0:08:20.16,Default,,0,0,0,,Ол Вестминстерде патшайымның анасымен жиі жасырын кездесулер өткізетін.
Dialogue: 0,0:08:20.70,0:08:24.04,Default,,0,0,0,,Байланыстың тереңдей түсетініне күмән жоқ.
Dialogue: 0,0:08:25.00,0:08:29.09,Default,,0,0,0,,Сонымен, сіз Хастингспен не істемексіз?
Dialogue: 0,0:08:30.96,0:08:33.05,Default,,0,0,0,,Сатқындық белгілері болса...
Dialogue: 0,0:08:34.55,0:08:36.47,Default,,0,0,0,,Шұғыл жаза
Dialogue: 0,0:08:37.30,0:08:40.43,Default,,0,0,0,,Қожайыныңыз патша әулетіне адал адам.
Dialogue: 0,0:08:40.93,0:08:45.35,Default,,0,0,0,,Бірақ мен... қазір тіпті Йорктың қанына да опасыздық жасап жатырмын.
Dialogue: 0,0:08:46.06,0:08:48.15,Default,,0,0,0,,Тәжін алу үшін...
Dialogue: 0,0:08:50.07,0:08:53.49,Default,,0,0,0,,Менің Раббым жалғыз және өмір бойы жалғыз
Dialogue: 0,0:08:54.03,0:08:56.49,Default,,0,0,0,,Құрметті Ричард, сіз жалғызсыз.
Dialogue: 0,0:08:58.20,0:08:59.70,Default,,0,0,0,,Мен шайтанмын
Dialogue: 0,0:09:00.33,0:09:03.41,Default,,0,0,0,,Мен сені тозаққа жібергенім үшін жеңілдеп қалдым.
Dialogue: 0,0:09:04.04,0:09:08.42,Default,,0,0,0,,Адалдыққа байланып, Маған қиналып қарайсың...
Dialogue: 0,0:09:10.63,0:09:12.17,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:09:12.26,0:09:15.97,Default,,0,0,0,,Менің жарты дене өмірім - Ричардтың өмірі.
Dialogue: 0,0:09:16.47,0:09:18.64,Default,,0,0,0,,Иә, мәртебелі герцог.
Dialogue: 0,0:09:19.39,0:09:22.35,Default,,0,0,0,,Сатқынның басынан бастайық...
Dialogue: 0,0:09:23.77,0:09:25.85,Default,,0,0,0,,Мен оны қысқартайын ба?
Dialogue: 0,0:09:26.35,0:09:29.73,Default,,0,0,0,,Бұл кепілдің қаны.
Dialogue: 0,0:09:35.07,0:09:37.45,Default,,0,0,0,,Денемді күйдіретін жылу...
Dialogue: 0,0:09:38.11,0:09:40.91,Default,,0,0,0,,Жылулықтан жарқын ештеңе жоқ.
Dialogue: 0,0:09:41.58,0:09:43.12,Default,,0,0,0,,Жоғары мәртебелі мырза, дайындалыңыз.
Dialogue: 0,0:09:44.12,0:09:45.96,Default,,0,0,0,,Мен жекпе-жек турниріне барғалы жатырмын.
Dialogue: 0,0:09:46.04,0:09:48.08,Default,,0,0,0,,Лорд Ховардпен және басқалармен кездесу
Dialogue: 0,0:09:48.58,0:09:50.75,Default,,0,0,0,,Сіздің бізге деген қолдауыңыз берік, бірақ...
Dialogue: 0,0:09:50.84,0:09:53.46,Default,,0,0,0,,Оны патша ретінде қолдау туралы не айтасыз?
Dialogue: 0,0:09:56.26,0:09:58.26,Default,,0,0,0,,Оларды да кепілге бер.
Dialogue: 0,0:09:58.76,0:10:00.64,Default,,0,0,0,,Гу... Глостер герцогы
Dialogue: 0,0:10:00.72,0:10:03.31,Default,,0,0,0,,Епископ Эли... Не?
Dialogue: 0,0:10:03.81,0:10:05.64,Default,,0,0,0,,Әй, сөйлесейік...
Dialogue: 0,0:10:05.73,0:10:07.60,Default,,0,0,0,,Мен сенің әңгімеңді тыңдаймын.
Dialogue: 0,0:10:08.35,0:10:10.35,Default,,0,0,0,,Бірақ бұл құпия...
Dialogue: 0,0:10:10.44,0:10:12.19,Default,,0,0,0,,Мен қарсы емеспін, өтінемін.
Dialogue: 0,0:10:14.03,0:10:18.65,Default,,0,0,0,,Шын мәнінде... Ана патшайым мен оның ұлы Король Эдвард V үшін.
Dialogue: 0,0:10:18.74,0:10:20.78,Default,,0,0,0,,Құлшылық қызметі жоспарланған
Dialogue: 0,0:10:20.87,0:10:22.62,Default,,0,0,0,,Құлшылық рәсімі?
Dialogue: 0,0:10:22.70,0:10:23.99,Default,,0,0,0,,Мен ештеңе естіген жоқпын.
Dialogue: 0,0:10:24.08,0:10:26.91,Default,,0,0,0,,Сізге сеніммен...
Dialogue: 0,0:10:27.00,0:10:29.25,Default,,0,0,0,,Архиепископ ұсынған
Dialogue: 0,0:10:29.33,0:10:32.04,Default,,0,0,0,,Лорд Хастингс арқылы патшайымның анасы
Dialogue: 0,0:10:32.13,0:10:33.75,Default,,0,0,0,,Сіз сұраған сияқтысыз.
Dialogue: 0,0:10:34.50,0:10:36.51,Default,,0,0,0,,Глостер герцогы
Dialogue: 0,0:10:36.59,0:10:40.13,Default,,0,0,0,,Кез келген уақытта келіп, қайтадан құлпынай жеңіз.
Dialogue: 0,0:10:41.59,0:10:44.97,Default,,0,0,0,,Бұл Хастингстің сатқындығын дәлелдейді.
Dialogue: 0,0:10:45.06,0:10:48.23,Default,,0,0,0,,Бірақ мен Элизабеттің мұншалықты ұзақ жылжиын күткен жоқпын.
Dialogue: 0,0:10:48.73,0:10:51.02,Default,,0,0,0,,Егер ғибадат рәсімі өтсе
Dialogue: 0,0:10:51.10,0:10:55.36,Default,,0,0,0,,Бұл әлемге Ана патшайымның күші әлі де орасан зор екенін көрсетеді.
Dialogue: 0,0:10:56.15,0:10:57.82,Default,,0,0,0,,Бірақ бұған жол бермесек
Dialogue: 0,0:10:57.90,0:11:02.20,Default,,0,0,0,,Кедей ханшайымның дұшпаны ретінде мен өлімге қарсы антипатияны оятамын.
Dialogue: 0,0:11:02.28,0:11:04.33,Default,,0,0,0,,Бұл соғыс жариялау.
Dialogue: 0,0:11:04.95,0:11:07.12,Default,,0,0,0,,Құдайдан... шайтанға
Dialogue: 0,0:11:08.62,0:11:11.00,Default,,0,0,0,,Шайтанның өз жолдары бар
Dialogue: 0,0:11:12.17,0:11:14.79,Default,,0,0,0,,Мен тіпті тілек айтудың өзі күнә деп ойладым.
Dialogue: 0,0:11:15.59,0:11:18.21,Default,,0,0,0,,Жылу енді менің қолымда...
Dialogue: 0,0:11:19.01,0:11:22.26,Default,,0,0,0,,Қалағаныңды күшпен ал
Dialogue: 0,0:11:25.72,0:11:27.43,Default,,0,0,0,,Лорд Хастингс
Dialogue: 0,0:11:27.52,0:11:29.98,Default,,0,0,0,,Қызмет көрсету күні анықталды ма?
Dialogue: 0,0:11:30.48,0:11:33.60,Default,,0,0,0,,Сол себепті ғибадат қызметі тоқтатылды.
Dialogue: 0,0:11:34.73,0:11:36.07,Default,,0,0,0,,Бұл ғана емес
Dialogue: 0,0:11:36.15,0:11:39.53,Default,,0,0,0,,Оның орнына Глостер герцогы үшін қызмет өтеді.
Dialogue: 0,0:11:40.03,0:11:43.20,Default,,0,0,0,,Мүмкін емес! Мұндай бұйрықты кім берді?
Dialogue: 0,0:11:43.28,0:11:44.62,Default,,0,0,0,,Бұл патшаның бұйрығы.
Dialogue: 0,0:11:44.70,0:11:45.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:46.33,0:11:49.37,Default,,0,0,0,,Ричард патшаны азғырған болуы керек.
Dialogue: 0,0:11:49.45,0:11:50.58,Default,,0,0,0,,Мына шайтан!
Dialogue: 0,0:11:50.66,0:11:54.08,Default,,0,0,0,,Шынымды айтсам, қазіргі қызметінде.
Dialogue: 0,0:11:54.17,0:11:57.38,Default,,0,0,0,,Патшаға айтпай-ақ патша бұйрығын шығаруға бола ма?
Dialogue: 0,0:11:57.88,0:12:01.30,Default,,0,0,0,,Ал... айту қиын, бірақ...
Dialogue: 0,0:12:01.92,0:12:06.26,Default,,0,0,0,,Бауырыңызды Глостер герцогіне тапсырыңыз.
Dialogue: 0,0:12:07.01,0:12:08.14,Default,,0,0,0,,Құрметті Элизабет...
Dialogue: 0,0:12:08.22,0:12:08.72,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:08.81,0:12:11.93,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:12:12.02,0:12:14.65,Default,,0,0,0,,Сен істейсің, шайтан.
Dialogue: 0,0:12:14.73,0:12:19.19,Default,,0,0,0,,Сіз мені барлық үміттен айыруға және мені үмітсіз қалдыруды қалайсыз ба?
Dialogue: 0,0:12:19.28,0:12:22.82,Default,,0,0,0,,Бірақ мен өмірімді кек алуға арнаған әйелмін
Dialogue: 0,0:12:22.90,0:12:26.41,Default,,0,0,0,,Алып кеткен сайын, жаным жанады
Dialogue: 0,0:12:26.91,0:12:28.87,Default,,0,0,0,,Ричардты қараңыз.
Dialogue: 0,0:12:28.95,0:12:32.25,Default,,0,0,0,,Бұл жолы мен сені үмітсіз етемін
Dialogue: 0,0:12:32.33,0:12:33.79,Default,,0,0,0,,Ана…
Dialogue: 0,0:12:34.29,0:12:37.54,Default,,0,0,0,,Дұрыс, қалай байқамай қалдым деп ойлаймын.
Dialogue: 0,0:12:38.21,0:12:40.21,Default,,0,0,0,,Ричардпен танысу
Dialogue: 0,0:12:40.30,0:12:43.09,Default,,0,0,0,,Ал мен ең жек көретіннің бар болуы!
Dialogue: 0,0:12:44.34,0:12:47.47,Default,,0,0,0,,Мәртебелі, Глостер герцогы бұл жолы не істеді?
Dialogue: 0,0:12:47.55,0:12:50.60,Default,,0,0,0,,Бұл регенттің билігінен тыс екені анық!
Dialogue: 0,0:12:50.68,0:12:53.64,Default,,0,0,0,,Ол аздап... болғаны рас.
Dialogue: 0,0:12:54.14,0:12:56.06,Default,,0,0,0,,Сіз олай ойламайсыз ба? епископ
Dialogue: 0,0:12:56.15,0:12:58.65,Default,,0,0,0,,Ал... дәл солай.
Dialogue: 0,0:12:58.73,0:13:02.69,Default,,0,0,0,,Иә! Тым менсінбейтін, тым мақтаншақ
Dialogue: 0,0:13:02.78,0:13:04.78,Default,,0,0,0,,Күте тұрыңыз, лорд Хастингс.
Dialogue: 0,0:13:04.86,0:13:06.66,Default,,0,0,0,,Лорд Ховард…
Dialogue: 0,0:13:06.74,0:13:09.28,Default,,0,0,0,,Адамның өзі болмаса да, қорқақтық емес пе?
Dialogue: 0,0:13:09.37,0:13:11.58,Default,,0,0,0,,Ресми рәсім бойынша Глостер герцогы
Dialogue: 0,0:13:11.66,0:13:13.75,Default,,0,0,0,,Мәртебелі билікті маған берді.
Dialogue: 0,0:13:13.83,0:13:15.83,Default,,0,0,0,,Менсінбейтін өздерің!
Dialogue: 0,0:13:15.92,0:13:19.34,Default,,0,0,0,,Софизм! Кімде әділдік бар екені анық
Dialogue: 0,0:13:19.42,0:13:20.42,Default,,0,0,0,,Ананың пәк...
Dialogue: 0,0:13:20.50,0:13:21.46,Default,,0,0,0,,Хастингс
Dialogue: 0,0:13:22.30,0:13:24.17,Default,,0,0,0,,Құлшылық рәсімдері жалықтырады.
Dialogue: 0,0:13:24.76,0:13:25.51,Default,,0,0,0,,Бірақ Мәртебелі...
Dialogue: 0,0:13:25.59,0:13:27.22,Default,,0,0,0,,Түсіңіз...
Dialogue: 0,0:13:29.72,0:13:32.60,Default,,0,0,0,,Хастингс патшайымның анасымен ұйықтап жатыр деген қауесет бар.
Dialogue: 0,0:13:33.97,0:13:35.56,Default,,0,0,0,,Мен мұны кеш түсіндім
Dialogue: 0,0:13:36.23,0:13:39.52,Default,,0,0,0,,Патша сарайы қазір шіріген алмаларға толы.
Dialogue: 0,0:13:40.23,0:13:42.90,Default,,0,0,0,,Бізде мұны жалғыз талқылаудан басқа амал жоқ.
Dialogue: 0,0:13:42.98,0:13:44.82,Default,,0,0,0,,Орын...
Dialogue: 0,0:13:45.57,0:13:48.45,Default,,0,0,0,,Әділдік сақшыларына Алла разы болсын
Dialogue: 0,0:13:48.95,0:13:52.45,Default,,0,0,0,,Лорд Стэнли Лорд Хастингс Эли епископы
Dialogue: 0,0:13:53.12,0:13:55.45,Default,,0,0,0,,Сол зұлым, сатқын заңсыз...
Dialogue: 0,0:13:55.54,0:13:58.12,Default,,0,0,0,,Біз бұл елді Ричардтан қайтаруымыз керек.
Dialogue: 0,0:13:58.21,0:13:59.71,Default,,0,0,0,,Корольдік отбасы бұзылды
Dialogue: 0,0:13:59.79,0:14:03.38,Default,,0,0,0,,Бірақ жағдай бұрынғыдан да нашар.
Dialogue: 0,0:14:03.46,0:14:06.17,Default,,0,0,0,,Ричард бұрын қарапайым және адал жауынгер болған, бірақ...
Dialogue: 0,0:14:06.26,0:14:09.39,Default,,0,0,0,,Оның енді адамдарды өзіне тартатын біртүрлі күші бар.
Dialogue: 0,0:14:09.97,0:14:11.89,Default,,0,0,0,,Бұл... сиқыр сияқты.
Dialogue: 0,0:14:11.97,0:14:15.85,Default,,0,0,0,,Ақша мен билік орасан зор сиқырлы күшке ие.
Dialogue: 0,0:14:15.93,0:14:18.06,Default,,0,0,0,,Міне... болды.
Dialogue: 0,0:14:18.14,0:14:22.44,Default,,0,0,0,,Мысалы, оның сенімін жоғалтуына әкелетін жанжал болса...
Dialogue: 0,0:14:23.32,0:14:26.74,Default,,0,0,0,,Егер сіз білгіңіз келмейтін құпиялар мен әлсіз жақтарды білсеңіз...
Dialogue: 0,0:14:26.82,0:14:30.03,Default,,0,0,0,,Сол үшін мені шақырдың, солай ма? Элизабет
Dialogue: 0,0:14:30.61,0:14:32.20,Default,,0,0,0,,Бұл мен
Dialogue: 0,0:14:32.28,0:14:33.58,Default,,0,0,0,,Қайын ене!
Dialogue: 0,0:14:33.66,0:14:36.54,Default,,0,0,0,,Сізді кенеттен шақырғаным үшін кешіріңіз.
Dialogue: 0,0:14:36.62,0:14:38.21,Default,,0,0,0,,Құдай бізге бәрін береді...
Dialogue: 0,0:14:38.83,0:14:40.87,Default,,0,0,0,,Элизабет мен түсінемін.
Dialogue: 0,0:14:40.96,0:14:43.34,Default,,0,0,0,,Сіздің жоқтауыңыз – менің жоқтауым.
Dialogue: 0,0:14:43.84,0:14:47.26,Default,,0,0,0,,Бірақ менің жоқтауым одан да көп.
Dialogue: 0,0:14:48.34,0:14:51.72,Default,,0,0,0,,Бірақ мұның бәрі осы құрсақтан туған.
Dialogue: 0,0:14:52.22,0:14:54.22,Default,,0,0,0,,Оның барлық жаман істері...
Dialogue: 0,0:14:55.22,0:14:59.35,Default,,0,0,0,,Ынтымақтастығыңызға айырбас ретінде сізден бір өтінішім бар.
Dialogue: 0,0:15:01.19,0:15:03.31,Default,,0,0,0,,Ричардты өлтіріңіз
Dialogue: 0,0:15:03.40,0:15:04.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.36,0:15:08.74,Default,,0,0,0,,Мен мұны көп рет осылай жасауға тырыстым, бірақ жасай алмадым.
Dialogue: 0,0:15:08.82,0:15:12.24,Default,,0,0,0,,А... сөзбен өлтірсем
Dialogue: 0,0:15:12.32,0:15:15.16,Default,,0,0,0,,Әлемге Ричардтың құпиясын тезірек айтыңыз.
Dialogue: 0,0:15:15.24,0:15:17.24,Default,,0,0,0,,Мен сені жазалауым керек еді...
Dialogue: 0,0:15:17.83,0:15:18.70,Default,,0,0,0,,Құпия?
Dialogue: 0,0:15:18.79,0:15:20.58,Default,,0,0,0,,Нені жария етпеді?
Dialogue: 0,0:15:20.66,0:15:24.50,Default,,0,0,0,,Бұл біздің отбасымыздың бұзылуына әкелуі мүмкін еді.
Dialogue: 0,0:15:25.00,0:15:31.26,Default,,0,0,0,,Нәтижесінде менің қорқақтығым сол жынның өсуіне себеп болды.
Dialogue: 0,0:15:32.34,0:15:35.26,Default,,0,0,0,,Бірақ қазір менің жоғалтатын ештеңем жоқ.
Dialogue: 0,0:15:35.76,0:15:38.89,Default,,0,0,0,,Менің қымбатты Эдвардтың балаларынан басқа.
Dialogue: 0,0:15:38.97,0:15:42.48,Default,,0,0,0,,Иә, солай, сол аяулы балалар үшін.
Dialogue: 0,0:15:42.56,0:15:45.19,Default,,0,0,0,,Ричард туралы шындық қазір!
Dialogue: 0,0:15:46.32,0:15:48.57,Default,,0,0,0,,Ричард Плантагенет...
Dialogue: 0,0:15:54.45,0:15:58.12,Default,,0,0,0,,Құдайдың еркіне қарсы шыққан қанды шайтан еді!
Dialogue: 0,0:15:58.62,0:15:59.62,Default,,0,0,0,,Болжам жасайық
Dialogue: 0,0:15:59.70,0:16:05.04,Default,,0,0,0,,Қаншама қарттар, жесірлер, жетімдер баласынан айырылады.
Dialogue: 0,0:16:05.13,0:16:08.80,Default,,0,0,0,,Ібіліс келтірген әділетсіз өлімді жоқтайсың!
Dialogue: 0,0:16:09.38,0:16:11.09,Default,,0,0,0,,Не? Ричард мырза?
Dialogue: 0,0:16:11.17,0:16:14.64,Default,,0,0,0,,Енді сіз Глостерге өлімге әкелетін жара жасай аласыз.
Dialogue: 0,0:16:15.22,0:16:18.43,Default,,0,0,0,,Бұл ақпаратқа сену қиын, бірақ...
Dialogue: 0,0:16:18.93,0:16:23.06,Default,,0,0,0,,Жоқ... Сол кісінің әрекеті мен жайсыздығын еске түсірсем.
Dialogue: 0,0:16:23.56,0:16:25.40,Default,,0,0,0,,Барлығы мағынасы бар
Dialogue: 0,0:16:25.90,0:16:28.65,Default,,0,0,0,,Оны келесі парламентте міндетті түрде айыптаңыз.
Dialogue: 0,0:16:28.73,0:16:32.03,Default,,0,0,0,,Ібілістің шындығын жарыққа шығару.
Dialogue: 0,0:16:32.90,0:16:36.24,Default,,0,0,0,,Неге тудым... Неге тудым!
Dialogue: 0,0:16:36.32,0:16:39.66,Default,,0,0,0,,Туған күні қарғыс атсын! Шайтанды қарғыс атсын!
Dialogue: 0,0:16:39.74,0:16:42.75,Default,,0,0,0,,Ібіліс Ричард Плантагенет!
Dialogue: 0,0:16:48.67,0:16:50.34,Default,,0,0,0,,Қандай әбігер!
Dialogue: 0,0:16:50.42,0:16:54.05,Default,,0,0,0,,Ол сізді келесі парламентте отқа өртеп жібергісі келеді.
Dialogue: 0,0:16:54.63,0:16:56.43,Default,,0,0,0,,Ақпарат бергіңіз келе ме?
Dialogue: 0,0:16:56.93,0:16:59.01,Default,,0,0,0,,Енді өміріңді сұрағанның пайдасы жоқ.
Dialogue: 0,0:16:59.85,0:17:03.77,Default,,0,0,0,,Герцогтың сырын білдім, бірақ айтпадым.
Dialogue: 0,0:17:04.27,0:17:07.94,Default,,0,0,0,,Бірақ сіз өзіңізді шынымен білесіз бе?
Dialogue: 0,0:17:08.44,0:17:10.19,Default,,0,0,0,,Сіздің денеңізде қандай да бір ақау бар ма?
Dialogue: 0,0:17:10.77,0:17:13.90,Default,,0,0,0,,Егер сізге дәрі керек болса, кез келген уақытта бізге хабарлаңыз.
Dialogue: 0,0:17:14.57,0:17:16.61,Default,,0,0,0,,Патшаны ақымақ еткен дәрі ме?
Dialogue: 0,0:17:17.24,0:17:18.07,Default,,0,0,0,,Аборт жасайтын дәрілер
Dialogue: 0,0:17:19.74,0:17:23.62,Default,,0,0,0,,Сақ болыңыз, жарық түскенде жараларыңыз болады.
Dialogue: 0,0:17:26.87,0:17:30.29,Default,,0,0,0,,Келесі Конгрессте әшкереленетін шайтан емес.
Dialogue: 0,0:17:30.96,0:17:32.59,Default,,0,0,0,,Оның басы.
Dialogue: 0,0:17:37.01,0:17:38.64,Default,,0,0,0,,Басқа кеңесшілер туралы не деуге болады?
Dialogue: 0,0:17:39.30,0:17:42.31,Default,,0,0,0,,Аа, мен сәл ерте келдім.
Dialogue: 0,0:17:42.81,0:17:45.56,Default,,0,0,0,,Глостер герцогы да әлі келмеген сияқты.
Dialogue: 0,0:17:47.31,0:17:50.77,Default,,0,0,0,,Менің орныма сіз бола алмас па едіңіз?
Dialogue: 0,0:17:50.86,0:17:54.19,Default,,0,0,0,,Өйткені мен оны басқаларға қарағанда жақсы түсінемін.
Dialogue: 0,0:17:54.28,0:17:55.19,Default,,0,0,0,,Мен?
Dialogue: 0,0:17:55.69,0:17:59.41,Default,,0,0,0,,Қанша жақын болсаң да, Жүрегіңді өлшей алмаймын.
Dialogue: 0,0:18:00.16,0:18:04.08,Default,,0,0,0,,Сен екеуміз бір-біріміздің жүрегімізді біле алмауымыз үшін
Dialogue: 0,0:18:06.25,0:18:07.79,Default,,0,0,0,,Кешіктіргеніміз үшін кешіріңіз, мырзалар.
Dialogue: 0,0:18:12.00,0:18:14.09,Default,,0,0,0,,тақырыбы қандай?
Dialogue: 0,0:18:14.59,0:18:16.97,Default,,0,0,0,,Бұл, әрине, тәж кию болды...
Dialogue: 0,0:18:17.05,0:18:18.72,Default,,0,0,0,,Айтпақшы, епископ.
Dialogue: 0,0:18:19.22,0:18:22.47,Default,,0,0,0,,Өткен күні біз өте қызу уақытты өткіздік.
Dialogue: 0,0:18:22.55,0:18:23.76,Default,,0,0,0,,Жалғыз
Dialogue: 0,0:18:23.85,0:18:24.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:25.31,0:18:29.23,Default,,0,0,0,,Осыдан кейін сен маған бақшаңнан құлпынай беруге уәде бердің.
Dialogue: 0,0:18:29.73,0:18:31.65,Default,,0,0,0,,Қазір тапсырыс бере аласыз ба?
Dialogue: 0,0:18:31.73,0:18:33.36,Default,,0,0,0,,Мен... енді?
Dialogue: 0,0:18:33.44,0:18:34.69,Default,,0,0,0,,Иә қазір
Dialogue: 0,0:18:34.78,0:18:36.40,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:37.49,0:18:39.45,Default,,0,0,0,,Сонымен, қандай күн?
Dialogue: 0,0:18:39.53,0:18:42.03,Default,,0,0,0,,Басқалары тым баяу
Dialogue: 0,0:18:42.70,0:18:47.66,Default,,0,0,0,,Глостер герцогы, орнымнан бір сәтке кетуге бола ма?
Dialogue: 0,0:18:47.75,0:18:48.75,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:54.04,0:18:54.96,Default,,0,0,0,,Лорд Хастингс
Dialogue: 0,0:18:55.75,0:18:57.51,Default,,0,0,0,,Басқа кеңесшілер
Dialogue: 0,0:18:57.59,0:18:59.93,Default,,0,0,0,,Біз мұнда емес, мәжіліс залында жиналып жатқан сияқтымыз.
Dialogue: 0,0:19:00.01,0:19:03.72,Default,,0,0,0,,Қат! Менің ойымша, Глостер оны ақшаға сатып алды.
Dialogue: 0,0:19:03.80,0:19:07.39,Default,,0,0,0,,Кэтсби, осында мүмкіндігінше көп асылдарды жина.
Dialogue: 0,0:19:07.98,0:19:09.77,Default,,0,0,0,,Айыптау бойынша куәгер болуды сұраңыз
Dialogue: 0,0:19:09.85,0:19:10.94,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:19:11.44,0:19:12.65,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:19:13.15,0:19:18.15,Default,,0,0,0,,Мүлдем... Сіздей қабілетті, адал адам жоқ.
Dialogue: 0,0:19:18.78,0:19:22.11,Default,,0,0,0,,Глостер сіздің бұрынғы қожайыныңыз.
Dialogue: 0,0:19:22.20,0:19:23.99,Default,,0,0,0,,Сенің сезімдерің аралас екеніне сенімдімін...
Dialogue: 0,0:19:25.45,0:19:29.45,Default,,0,0,0,,Мен жай ғана... сол жылы жарықта
Dialogue: 0,0:19:29.54,0:19:31.79,Default,,0,0,0,,Мен сені әрі қарай жалғастыра аларсың деп үміттенген едім.
Dialogue: 0,0:19:33.17,0:19:37.84,Default,,0,0,0,,Ең болмағанда маған нұсқау беру сенің міндетің.
Dialogue: 0,0:19:39.21,0:19:40.26,Default,,0,0,0,,(есіктің тарс ашылған дыбысы)
Dialogue: 0,0:19:41.18,0:19:42.93,Default,,0,0,0,,Глостер герцогы!
Dialogue: 0,0:19:43.01,0:19:45.39,Default,,0,0,0,,Мен бұл кездесудің нақты тақырыбын айтайын.
Dialogue: 0,0:19:46.05,0:19:47.01,Default,,0,0,0,,Барлығың тыңдаңдар!
Dialogue: 0,0:19:47.10,0:19:50.35,Default,,0,0,0,,Ричард Плантаженет мемлекетті құлатуды жоспарлап отыр!
Dialogue: 0,0:19:50.93,0:19:53.60,Default,,0,0,0,,Сесили, бұл адамның биологиялық анасы
Dialogue: 0,0:19:53.69,0:19:56.94,Default,,0,0,0,,Өз намысымды ескермей ашқан шындық...
Dialogue: 0,0:19:57.02,0:20:00.40,Default,,0,0,0,,Ричардтың денесінде жын бар!
Dialogue: 0,0:20:05.41,0:20:09.04,Default,,0,0,0,,Ричард Кінәсіздігіңізді айтқыңыз келсе, бізге дәлелді көрсетіңіз.
Dialogue: 0,0:20:09.12,0:20:10.87,Default,,0,0,0,,Дәл осы жерде және қазір!
Dialogue: 0,0:20:12.12,0:20:14.29,Default,,0,0,0,,Қарғыс атқан шайтан...
Dialogue: 0,0:20:15.08,0:20:16.96,Default,,0,0,0,,Кім қарғыс айтты?
Dialogue: 0,0:20:17.04,0:20:18.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:18.75,0:20:24.13,Default,,0,0,0,,Бұл дене ібілістің кейпіндей сұмдық түрге айналдырылған.
Dialogue: 0,0:20:24.22,0:20:28.72,Default,,0,0,0,,Қарғыс қойғандар нағыз шайтандар емес пе?
Dialogue: 0,0:20:28.81,0:20:29.93,Default,,0,0,0,,Хастингс!
Dialogue: 0,0:20:30.43,0:20:32.73,Default,,0,0,0,,Ал оған қосылатындар
Dialogue: 0,0:20:32.81,0:20:34.56,Default,,0,0,0,,Сен шайтансың!
Dialogue: 0,0:20:34.65,0:20:35.94,Default,,0,0,0,,Жоқ... бұл қорлау!
Dialogue: 0,0:20:36.73,0:20:38.15,Default,,0,0,0,,Енді қараңыз.
Dialogue: 0,0:20:41.40,0:20:44.11,Default,,0,0,0,,Бұл туа біткен емес
Dialogue: 0,0:20:47.16,0:20:49.66,Default,,0,0,0,,Бұл сіздің қарғысыңыздың арқасында.
Dialogue: 0,0:20:50.29,0:20:51.50,Default,,0,0,0,,Сатқынды өлтіріңіз!
Dialogue: 0,0:20:54.25,0:20:56.12,Default,,0,0,0,,Дәлелдерге қарамай
Dialogue: 0,0:20:56.21,0:20:58.09,Default,,0,0,0,,Қазір мен бәріне көзім жетті
Dialogue: 0,0:20:58.17,0:21:01.34,Default,,0,0,0,,Шайтанның бос рақымын іздейтін ақымақтар!
Dialogue: 0,0:21:01.42,0:21:04.17,Default,,0,0,0,,Кэтсби! Ричардты қолға түсіріңіз!
Dialogue: 0,0:21:06.64,0:21:10.06,Default,,0,0,0,,Мен сені сол күні құтқара алмадым.
Dialogue: 0,0:21:10.68,0:21:13.06,Default,,0,0,0,,Құрметті Ричард... Құрметті Ричард!
Dialogue: 0,0:21:13.14,0:21:15.52,Default,,0,0,0,,Мен не істеуім керек, егер Ричард...
Dialogue: 0,0:21:16.31,0:21:17.02,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:21:17.81,0:21:22.03,Default,,0,0,0,,Мен ешқашан жолыңды нұрландыратын нұр бола алмаймын.
Dialogue: 0,0:21:22.11,0:21:23.40,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:21:25.70,0:21:29.24,Default,,0,0,0,,Мен үшін өмір Ричардты білдіреді.
Dialogue: 0,0:21:30.08,0:21:32.20,Default,,0,0,0,,Лорд Хастингс, дайын бол.
Dialogue: 0,0:21:32.29,0:21:34.25,Default,,0,0,0,,Тіпті сіз...
Dialogue: 0,0:21:34.75,0:21:36.16,Default,,0,0,0,,Лас!
Dialogue: 0,0:21:36.25,0:21:39.88,Default,,0,0,0,,Мен шайтанның басына тәж кигенше өлгенім артық!
Dialogue: 0,0:21:40.75,0:21:43.96,Default,,0,0,0,,Бірақ мен сені ешқашан жалғыз қалдырмаймын
Dialogue: 0,0:21:44.67,0:21:49.01,Default,,0,0,0,,Жолда қараңғылық қанша терең болса да
Dialogue: 0,0:21:49.51,0:21:50.43,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
