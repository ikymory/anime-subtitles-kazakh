Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.58,0:00:05.79,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:00:08.88,0:00:10.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:14.01,0:00:15.89,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:00:17.43,0:00:19.18,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:00:22.23,0:00:22.73,Default,,0,0,0,,(орыннан шыққан дыбыс)
Dialogue: 0,0:00:24.14,0:00:26.69,Default,,0,0,0,,Қалғанын қызметшілерге қалдырыңыз.
Dialogue: 0,0:00:26.77,0:00:30.40,Default,,0,0,0,,(қорқынышты күлкі)
Dialogue: 0,0:00:34.11,0:00:34.61,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:00:38.74,0:00:39.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:40.95,0:00:43.96,Default,,0,0,0,,Сен келдің, Ричард.
Dialogue: 0,0:00:47.50,0:00:49.54,Default,,0,0,0,,Ақ раушан қамыты
Dialogue: 0,0:00:49.63,0:00:51.67,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:00:52.17,0:00:58.18,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:00:58.68,0:01:03.48,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:07.48,0:01:09.48,Default,,0,0,0,,♪～
Dialogue: 0,0:02:33.36,0:02:35.36,Default,,0,0,0,,～♪
Dialogue: 0,0:02:39.45,0:02:40.53,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:02:40.61,0:02:42.41,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:02:42.49,0:02:44.16,Default,,0,0,0,,Менің ресми қызметпен айналыспағалы көп уақыт болды.
Dialogue: 0,0:02:44.24,0:02:46.70,Default,,0,0,0,,Шаршадыңыз деп үміттенемін.
Dialogue: 0,0:02:48.87,0:02:52.00,Default,,0,0,0,,Мәртебелі, қалдарыңыз қалай?
Dialogue: 0,0:02:52.63,0:02:53.79,Default,,0,0,0,,Уорвик
Dialogue: 0,0:02:54.29,0:02:58.84,Default,,0,0,0,,Құдайдың қалауы мен сенің қолың мені тұтқыннан азат етті.
Dialogue: 0,0:02:59.34,0:03:02.09,Default,,0,0,0,,Бірақ мұнда... бұл жерде өте тұнық.
Dialogue: 0,0:03:03.34,0:03:05.64,Default,,0,0,0,,Неге патша сарайынан бір рет шықпайсың?
Dialogue: 0,0:03:06.14,0:03:06.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:07.02,0:03:11.69,Default,,0,0,0,,Қажылықта жаныңды тыныштандыру.
Dialogue: 0,0:03:12.44,0:03:15.69,Default,,0,0,0,,Бұл сіздің денеңізге ең жақсы дәрі болуы керек.
Dialogue: 0,0:03:16.19,0:03:18.11,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:03:18.19,0:03:20.11,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:03:20.19,0:03:23.66,Default,,0,0,0,,Саясаттың ауыр жауапкершілігін мойнымызға алайық.
Dialogue: 0,0:03:24.16,0:03:26.62,Default,,0,0,0,,Көпшілік алдына шықпасаңыз да
Dialogue: 0,0:03:26.70,0:03:29.33,Default,,0,0,0,,Мен оның сырқатына байланысты жасырынып жүргенін барлығына хабарлаймын.
Dialogue: 0,0:03:31.37,0:03:32.87,Default,,0,0,0,,Иә... бұл дұрыс.
Dialogue: 0,0:03:33.37,0:03:36.17,Default,,0,0,0,,Бұл Құдайдың басшылығы екеніне сенімдімін.
Dialogue: 0,0:03:36.67,0:03:39.71,Default,,0,0,0,,Уорвик, сізді регент етіңіз.
Dialogue: 0,0:03:40.22,0:03:42.30,Default,,0,0,0,,Үкіметті саған тапсырамын.
Dialogue: 0,0:03:44.76,0:03:47.76,Default,,0,0,0,,Дана шешім, Мәртебелі.
Dialogue: 0,0:03:50.60,0:03:53.19,Default,,0,0,0,,Маргарет әлі Францияда.
Dialogue: 0,0:03:53.69,0:03:55.44,Default,,0,0,0,,Егер мен қазір Лондонды басып алсам...
Dialogue: 0,0:03:55.52,0:03:57.57,Default,,0,0,0,,Анна үшін кешірім сұраймын.
Dialogue: 0,0:03:58.07,0:03:59.82,Default,,0,0,0,,Олар бір-бірін ұнатты, солай ма?
Dialogue: 0,0:04:00.40,0:04:03.53,Default,,0,0,0,,...
Dialogue: 0,0:04:04.03,0:04:06.91,Default,,0,0,0,,Егер ол осылай көрінсе
Dialogue: 0,0:04:06.99,0:04:09.54,Default,,0,0,0,,Бұл Уорвиктің жоспарының нәтижесі болса керек.
Dialogue: 0,0:04:09.62,0:04:11.50,Default,,0,0,0,,Ол айлакер адам.
Dialogue: 0,0:04:12.00,0:04:15.12,Default,,0,0,0,,Онымен інісі де араласып кетті.
Dialogue: 0,0:04:15.71,0:04:18.17,Default,,0,0,0,,Уорвик пен Джордж корольден кейінгі екінші маңызды дворяндар.
Dialogue: 0,0:04:18.92,0:04:22.38,Default,,0,0,0,,Осылайша Энтони мен Хастингс оралды.
Dialogue: 0,0:04:22.47,0:04:25.89,Default,,0,0,0,,Бірақ біздің күштер әлі де жеткіліксіз.
Dialogue: 0,0:04:26.55,0:04:30.22,Default,,0,0,0,,Міне, менің сізден сұрайын дегенім бар.
Dialogue: 0,0:04:31.06,0:04:35.48,Default,,0,0,0,,Мәртебелі мырзаның даналығы мен адамгершілігі өте таң қалдырады.
Dialogue: 0,0:04:35.98,0:04:39.57,Default,,0,0,0,,Соңғы кездегі кадрлық өзгерістерді сынға алуым керек.
Dialogue: 0,0:04:39.65,0:04:40.73,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:40.82,0:04:44.45,Default,,0,0,0,,Менен гөрі регент болуға лайықты адам бар.
Dialogue: 0,0:04:44.53,0:04:46.11,Default,,0,0,0,,Сіз жоқсыз ба?
Dialogue: 0,0:04:47.28,0:04:48.41,Default,,0,0,0,,Құрметті Джордж
Dialogue: 0,0:04:49.41,0:04:54.04,Default,,0,0,0,,Бұл менің мырзамның қалауы, бірақ... сіз қалай ойлайсыз?
Dialogue: 0,0:04:55.67,0:04:56.83,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:57.71,0:04:59.92,Default,,0,0,0,,Менің бұл кісіге сенуден басқа амалым жоқ.
Dialogue: 0,0:05:00.00,0:05:02.67,Default,,0,0,0,,Мен ағама опасыздық жасағаннан бері мен...
Dialogue: 0,0:05:03.92,0:05:07.55,Default,,0,0,0,,Егер сіз келіссеңіз, мен де келісемін.
Dialogue: 0,0:05:08.05,0:05:10.81,Default,,0,0,0,,Бірақ алдымен таққа мұрагер болу құқығына тоқталайық...
Dialogue: 0,0:05:10.89,0:05:13.89,Default,,0,0,0,,Біріншіден, Эдвард ренегат вассалы екенін жариялаңыз.
Dialogue: 0,0:05:13.98,0:05:17.77,Default,,0,0,0,,Бірінші кезекте барлық мүлік пен мүлікті тәркілеу.
Dialogue: 0,0:05:17.85,0:05:18.86,Default,,0,0,0,,Әрине...
Dialogue: 0,0:05:18.94,0:05:21.23,Default,,0,0,0,,Бұл оқиға соңында айтылады.
Dialogue: 0,0:05:24.99,0:05:27.07,Default,,0,0,0,,Джордж және Ланкастер ханзадасы
Dialogue: 0,0:05:27.57,0:05:32.87,Default,,0,0,0,,Қайсысы патша болса, мен шешермін.
Dialogue: 0,0:05:33.37,0:05:35.62,Default,,0,0,0,,Барлығы менің қолымда
Dialogue: 0,0:05:37.58,0:05:42.13,Default,,0,0,0,,Енді мен осы елдің патшасымын.
Dialogue: 0,0:05:50.89,0:05:52.89,Default,,0,0,0,,Кейтсби бұл
Dialogue: 0,0:05:53.56,0:05:56.06,Default,,0,0,0,,Ричард Бұл Йорк туы
Dialogue: 0,0:05:56.14,0:05:58.35,Default,,0,0,0,,Оны Джорджға жеткізіңіз.
Dialogue: 0,0:05:58.44,0:06:00.02,Default,,0,0,0,,Ультиматум.
Dialogue: 0,0:06:00.52,0:06:05.36,Default,,0,0,0,,Оған оны қалай қолдану сізге байланысты екенін айтыңыз.
Dialogue: 0,0:06:07.11,0:06:10.49,Default,,0,0,0,,Ішіндегіні ешкімге көрмеу. Оны абайлап ұстаңыз.
Dialogue: 0,0:06:10.57,0:06:11.07,Default,,0,0,0,,Га
Dialogue: 0,0:06:14.12,0:06:15.58,Default,,0,0,0,,Мұндай қауіпті миссия
Dialogue: 0,0:06:15.66,0:06:17.62,Default,,0,0,0,,Ричард мұны жасамаса да...
Dialogue: 0,0:06:18.12,0:06:20.50,Default,,0,0,0,,Маған сеніп тапсыру үшін жолдан шығып кеткенің осыны білдіреді
Dialogue: 0,0:06:20.58,0:06:23.84,Default,,0,0,0,,Мүмкіндігінше сендіруге тырысу керек деп ойлаймын.
Dialogue: 0,0:06:23.92,0:06:25.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:25.21,0:06:28.72,Default,,0,0,0,,Ағалар арасындағы байланыстың тереңдігіне сүйсінгеннен басқа ештеңем жоқ.
Dialogue: 0,0:06:29.30,0:06:33.93,Default,,0,0,0,,Бұл ағайындық сүйіспеншіліктен гөрі мақтаныштың шайқасы.
Dialogue: 0,0:06:34.43,0:06:37.35,Default,,0,0,0,,Егер сіз жеңілсеңіз, сіз шайқаста жеңе алмайсыз.
Dialogue: 0,0:06:37.85,0:06:39.77,Default,,0,0,0,,Жеңіс біздің кез келгеніміз үшін
Dialogue: 0,0:06:41.48,0:06:42.40,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:06:43.02,0:06:45.57,Default,,0,0,0,,Бірақ Джордж пен Уорвик арасындағы байланыс
Dialogue: 0,0:06:45.65,0:06:47.61,Default,,0,0,0,,Күтілгеннен күшті
Dialogue: 0,0:06:47.69,0:06:49.99,Default,,0,0,0,,Ланкастерге қосылсаңыз да,
Dialogue: 0,0:06:50.49,0:06:55.41,Default,,0,0,0,,Уорвиктің жанынан шықпаған ағаңызды жылжыта аласыз ба? менің қолыммен
Dialogue: 0,0:06:55.91,0:06:58.62,Default,,0,0,0,,Жоқ, мен оны міндетті түрде қайтарамын.
Dialogue: 0,0:06:59.12,0:07:01.54,Default,,0,0,0,,Осы елді қолдарынан ал
Dialogue: 0,0:07:01.62,0:07:03.63,Default,,0,0,0,,Әй, мына жерде балалар!
Dialogue: 0,0:07:03.71,0:07:05.71,Default,,0,0,0,,Қарсылас ат арба. Оны сілкіп алайық!
Dialogue: 0,0:07:20.94,0:07:22.40,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:07:22.48,0:07:23.81,Default,,0,0,0,,Әсіресе ерекше...
Dialogue: 0,0:07:24.31,0:07:28.48,Default,,0,0,0,,Дегенмен, бұрынғы топ жақын маңдағы қонақүйде тұрады деген ақпарат бар.
Dialogue: 0,0:07:29.15,0:07:31.24,Default,,0,0,0,,Бүгін біз осы жерде боламыз.
Dialogue: 0,0:07:31.32,0:07:34.70,Default,,0,0,0,,Айналаңа қара. Сергек болыңыз.
Dialogue: 0,0:07:35.49,0:07:37.12,Default,,0,0,0,,Бұл киелі орын
Dialogue: 0,0:07:37.20,0:07:37.95,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:07:38.04,0:07:41.66,Default,,0,0,0,,Сен де қаруыңды жинап, намазыңды оқы.
Dialogue: 0,0:07:43.83,0:07:47.50,Default,,0,0,0,,Қайда барсаң да... қанша қашсаң да, сенің соңынан ереді
Dialogue: 0,0:07:47.59,0:07:48.75,Default,,0,0,0,,Қан мен жанжал
Dialogue: 0,0:07:49.26,0:07:52.88,Default,,0,0,0,,Мәртебелі мырза, ол кісінің тәтті сөзін тыңдамаңыз.
Dialogue: 0,0:07:52.97,0:07:55.60,Default,,0,0,0,,Ол Ұлы Мәртебелін өз еркіне қарай басқаруға тырысуда.
Dialogue: 0,0:07:55.68,0:07:57.43,Default,,0,0,0,,Бұл сатқындық, бұл бүлік, мәртебелі.
Dialogue: 0,0:07:57.51,0:07:59.06,Default,,0,0,0,,Нұсқаулар беріп, жауапкершілікті алыңыз.
Dialogue: 0,0:07:59.14,0:08:01.39,Default,,0,0,0,,Мәртебелі Мәртебелі Мәртебелі!
Dialogue: 0,0:08:04.31,0:08:05.77,Default,,0,0,0,,Мені өзіңізбен бірге алып кетіңізші.
Dialogue: 0,0:08:06.27,0:08:07.61,Default,,0,0,0,,Алыс жерде
Dialogue: 0,0:08:08.11,0:08:12.24,Default,,0,0,0,,Мейірімділік пен махаббатқа толы нағыз еркін әлемге
Dialogue: 0,0:08:14.41,0:08:15.28,Default,,0,0,0,,Ричард…
Dialogue: 0,0:08:19.49,0:08:21.25,Default,,0,0,0,,Сонымен, қайтадан инфильтрация?
Dialogue: 0,0:08:21.33,0:08:24.67,Default,,0,0,0,,Ол кезде төтенше жағдай болып, әріптестер бар еді.
Dialogue: 0,0:08:25.17,0:08:26.17,Default,,0,0,0,,Сіз сіңіп кетсеңіз де
Dialogue: 0,0:08:26.25,0:08:27.50,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:08:28.34,0:08:31.38,Default,,0,0,0,,Тұтынушы, сіздің асыңыз дайын.
Dialogue: 0,0:08:31.46,0:08:32.76,Default,,0,0,0,,Сіз тағамға тапсырыс бердіңіз бе?
Dialogue: 0,0:08:32.84,0:08:34.80,Default,,0,0,0,,Жоғары мәртебелі қонақтарға жеңіл тағамдар кіреді.
Dialogue: 0,0:08:34.88,0:08:36.47,Default,,0,0,0,,Бүгінгі күн сізге арналған
Dialogue: 0,0:08:36.97,0:08:39.26,Default,,0,0,0,,Түсіңіз.
Dialogue: 0,0:08:41.52,0:08:42.56,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:08:52.90,0:08:54.03,Default,,0,0,0,,Эй (күйеуі) Ух...
Dialogue: 0,0:08:54.11,0:08:57.16,Default,,0,0,0,,Мен ойымды өзгерттім. Тамақты осы бөлмеге әкел.
Dialogue: 0,0:08:57.24,0:08:58.95,Default,,0,0,0,,Иә, қазір!
Dialogue: 0,0:09:00.83,0:09:03.83,Default,,0,0,0,,Мүлдем... Тыныш тамақты да жей алмаймын.
Dialogue: 0,0:09:04.79,0:09:06.04,Default,,0,0,0,,Тұрғын үйді ауыстырғыңыз келе ме?
Dialogue: 0,0:09:07.38,0:09:07.88,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:08.54,0:09:10.63,Default,,0,0,0,,Бұл жерде, сөзсіз.
Dialogue: 0,0:09:10.71,0:09:14.01,Default,,0,0,0,,Бұрынғы топ әлі Йорктың қалдықтары ма?
Dialogue: 0,0:09:14.09,0:09:16.43,Default,,0,0,0,,Сіз көрген жалау соған дәлел.
Dialogue: 0,0:09:16.93,0:09:17.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:17.89,0:09:18.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:19.05,0:09:21.26,Default,,0,0,0,,Сыртқа шығыңыз! Мен саған еремін!
Dialogue: 0,0:09:21.76,0:09:22.89,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:22.97,0:09:23.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:23.85,0:09:27.48,Default,,0,0,0,,Йорк қалдықтары, сіз сол адамның өмірін алуға келдіңіз бе?
Dialogue: 0,0:09:28.19,0:09:28.98,Default,,0,0,0,,Бұл адам?
Dialogue: 0,0:09:29.06,0:09:30.65,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін!
Dialogue: 0,0:09:31.82,0:09:32.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:34.74,0:09:35.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:36.70,0:09:38.78,Default,,0,0,0,,Ланкастриялық дворян?
Dialogue: 0,0:09:38.86,0:09:42.29,Default,,0,0,0,,Сіз айтарлықтай дәрежедегі адам сияқтысыз, бірақ сіз мұнда не үшін келдіңіз?
Dialogue: 0,0:09:46.25,0:09:47.42,Default,,0,0,0,,Генри?
Dialogue: 0,0:09:48.79,0:09:50.21,Default,,0,0,0,,Ричард…
Dialogue: 0,0:09:50.71,0:09:52.92,Default,,0,0,0,,Қайда бардың! Оны ізде!
Dialogue: 0,0:09:53.42,0:09:54.80,Default,,0,0,0,,Кел! (Генри) А...
Dialogue: 0,0:09:56.17,0:09:58.59,Default,,0,0,0,,Ричард... Ричард!
Dialogue: 0,0:09:59.18,0:10:01.05,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:10:01.14,0:10:02.76,Default,,0,0,0,,Ричард, сен ауырып қалдың!
Dialogue: 0,0:10:03.43,0:10:04.60,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:10.15,0:10:11.73,Default,,0,0,0,,Бұл менің қаным...
Dialogue: 0,0:10:12.48,0:10:13.65,Default,,0,0,0,,Ричард!
Dialogue: 0,0:10:16.74,0:10:17.61,Default,,0,0,0,,Леди Кэтсби!
Dialogue: 0,0:10:18.11,0:10:20.24,Default,,0,0,0,,Мен кейінірек түсіндіремін. Барайық!
Dialogue: 0,0:10:22.33,0:10:23.58,Default,,0,0,0,,Эдвард
Dialogue: 0,0:10:23.66,0:10:26.95,Default,,0,0,0,,Сен мына сұлудың қолын ал
Dialogue: 0,0:10:27.04,0:10:31.67,Default,,0,0,0,,Сен мені әйеліңе айналдырам деп қайтпас уәде бердің.
Dialogue: 0,0:10:31.75,0:10:35.55,Default,,0,0,0,,Иә, анашым, мен сізді әйелім еткеніме қуаныштымын.
Dialogue: 0,0:10:35.63,0:10:37.13,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:10:37.63,0:10:40.76,Default,,0,0,0,,Неліктен ұйықтау уақытын әлі аяқтаған жоқсыз?
Dialogue: 0,0:10:40.84,0:10:42.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:42.14,0:10:45.93,Default,,0,0,0,,Адамдарды осылай сезіндірудің көптеген жолдары бар.
Dialogue: 0,0:10:46.02,0:10:47.39,Default,,0,0,0,,бұл... Ана
Dialogue: 0,0:10:47.48,0:10:48.35,Default,,0,0,0,,(орыннан шыққан дыбыс)
Dialogue: 0,0:10:49.23,0:10:53.31,Default,,0,0,0,,Жақсы ма? Бүгін кешке жасаңыз
Dialogue: 0,0:10:54.02,0:10:58.69,Default,,0,0,0,,Өз міндетіңді орында. Сізге махаббат керек емес, солай ма?
Dialogue: 0,0:11:12.21,0:11:15.17,Default,,0,0,0,,Мен бәрін білемін
Dialogue: 0,0:11:16.09,0:11:20.88,Default,,0,0,0,,Сізге Ричард ұнады, солай ма?
Dialogue: 0,0:11:22.64,0:11:23.22,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.72,0:11:26.31,Default,,0,0,0,,Бұл тек сен емес!
Dialogue: 0,0:11:26.39,0:11:28.35,Default,,0,0,0,,Маған да ұнайтын бір әйел болды.
Dialogue: 0,0:11:28.85,0:11:30.85,Default,,0,0,0,,Егер сіз әлі де сезімдеріңізді жібере алмасаңыз...
Dialogue: 0,0:11:30.94,0:11:33.81,Default,,0,0,0,,Жоқ, мен оны үзіп тастадым.
Dialogue: 0,0:11:34.73,0:11:36.36,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:36.94,0:11:40.19,Default,,0,0,0,,Сіз оны оңай ажырата алатындай сезіндіңіз бе?
Dialogue: 0,0:11:41.70,0:11:45.95,Default,,0,0,0,,Сене алар емеспін, олай емес.
Dialogue: 0,0:11:46.45,0:11:51.00,Default,,0,0,0,,Мен оны аламын деп Құдайға ант бердім.
Dialogue: 0,0:11:51.54,0:11:54.29,Default,,0,0,0,,Мен ешбір кедергіге қарсы тұрмаймын, тіпті...
Dialogue: 0,0:11:54.38,0:11:56.00,Default,,0,0,0,,Сіз түсінбейсіз!
Dialogue: 0,0:11:56.09,0:11:59.05,Default,,0,0,0,,Мен Ричардты қаншалықты жақсы көрдім.
Dialogue: 0,0:11:59.13,0:12:00.55,Default,,0,0,0,,Сізде ештеңе жоқ!
Dialogue: 0,0:12:00.63,0:12:02.93,Default,,0,0,0,,Сезімдерің маңызды емес.
Dialogue: 0,0:12:03.01,0:12:03.80,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:12:03.88,0:12:05.26,Default,,0,0,0,,Сіз білуге ​​мүмкіндік жоқ! (Ханзада Эдвард) Түсінемін!
Dialogue: 0,0:12:06.35,0:12:09.85,Default,,0,0,0,,Мен Ричардты сенен артық жақсы көремін!
Dialogue: 0,0:12:11.93,0:12:13.31,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:12:14.31,0:12:16.36,Default,,0,0,0,,Құдай мені кешірмейді
Dialogue: 0,0:12:16.86,0:12:17.52,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:12:17.61,0:12:20.11,Default,,0,0,0,,Кешірілмейтін адамсың.
Dialogue: 0,0:12:20.19,0:12:23.74,Default,,0,0,0,,Егер әлі де сұрақтарыңыз болса, маған хабарлаңыз. Ричард...
Dialogue: 0,0:12:24.78,0:12:27.03,Default,,0,0,0,,Ол шын мәнінде әйел
Dialogue: 0,0:12:27.53,0:12:32.62,Default,,0,0,0,,Әдетте ер адамша киініп, әйел екенін жасырады.
Dialogue: 0,0:12:33.33,0:12:34.96,Default,,0,0,0,,Қалжыңдауды доғарыңыз.
Dialogue: 0,0:12:36.00,0:12:38.54,Default,,0,0,0,,Бұл өтірік... Ричард-сама екеніне сенімдімін
Dialogue: 0,0:12:38.63,0:12:41.63,Default,,0,0,0,,Әйел сияқты арық, сұлу.
Dialogue: 0,0:12:42.13,0:12:42.88,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:43.67,0:12:47.47,Default,,0,0,0,,Жүрегіңнің тереңіне үнемі бірдеңені жасырып жүргендейсің...
Dialogue: 0,0:12:47.97,0:12:49.26,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:12:49.35,0:12:51.85,Default,,0,0,0,,Ричард туралы қанша ойласаңыз да
Dialogue: 0,0:12:51.93,0:12:53.64,Default,,0,0,0,,Ол әйел болғанша
Dialogue: 0,0:12:53.73,0:12:57.23,Default,,0,0,0,,Ол сені ешқашан сүймейді
Dialogue: 0,0:13:06.32,0:13:08.49,Default,,0,0,0,,Амансың ба? Ричард
Dialogue: 0,0:13:10.74,0:13:11.79,Default,,0,0,0,,Генри
Dialogue: 0,0:13:12.41,0:13:15.08,Default,,0,0,0,,Айналада мыңжапырақ жапырақтары бар ма?
Dialogue: 0,0:13:15.58,0:13:18.08,Default,,0,0,0,,Биік ирек жапырақтар...
Dialogue: 0,0:13:18.58,0:13:20.50,Default,,0,0,0,,Жарайды, күте тұрыңыз!
Dialogue: 0,0:13:25.09,0:13:29.09,Default,,0,0,0,,Мұндай үлкен жара... сені өлтірмейді.
Dialogue: 0,0:13:29.60,0:13:32.10,Default,,0,0,0,,Кэтсбимен және басқалармен тез кездесіңіз...
Dialogue: 0,0:13:33.81,0:13:37.10,Default,,0,0,0,,Ричард, сен өліп жатырсың ба?
Dialogue: 0,0:13:37.85,0:13:39.61,Default,,0,0,0,,Өл!
Dialogue: 0,0:13:40.44,0:13:43.32,Default,,0,0,0,,Орманның қойнауында жалғыз жоғалып кет!
Dialogue: 0,0:13:43.40,0:13:46.11,Default,,0,0,0,,Ешкім көмекке келмейді
Dialogue: 0,0:13:46.20,0:13:49.91,Default,,0,0,0,,Ібіліс өлсе де, ешкім қайғырмайды.
Dialogue: 0,0:13:49.99,0:13:52.66,Default,,0,0,0,,Өйткені, сен жалғызсың.
Dialogue: 0,0:13:53.29,0:13:55.33,Default,,0,0,0,,Соңына дейін!
Dialogue: 0,0:14:02.21,0:14:04.09,Default,,0,0,0,,Ричард…
Dialogue: 0,0:14:04.17,0:14:05.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:07.30,0:14:09.80,Default,,0,0,0,,Мен сені жазалау үшін келдім.
Dialogue: 0,0:14:09.89,0:14:14.27,Default,,0,0,0,,Тірі қалудың жазасы – туылу жазасы.
Dialogue: 0,0:14:14.85,0:14:16.02,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:14:17.31,0:14:20.44,Default,,0,0,0,,Сіз өлген болуыңыз керек еді!
Dialogue: 0,0:14:21.44,0:14:24.15,Default,,0,0,0,,(Қасқыр үреді)
Dialogue: 0,0:14:24.23,0:14:25.61,Default,,0,0,0,,Кет! Шайтан!
Dialogue: 0,0:14:25.69,0:14:27.82,Default,,0,0,0,,Ах... Генри
Dialogue: 0,0:14:28.32,0:14:30.11,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:30.78,0:14:32.32,Default,,0,0,0,,Алла разы болсын
Dialogue: 0,0:14:32.91,0:14:37.50,Default,,0,0,0,,Тым болмаса рұқсат етші... Өлім берсең өлейін.
Dialogue: 0,0:14:43.88,0:14:44.96,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:45.92,0:14:48.47,Default,,0,0,0,,Сіз шайтанды көрдіңіз бе?
Dialogue: 0,0:14:49.51,0:14:50.43,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:51.01,0:14:53.51,Default,,0,0,0,,Өйткені қасқыр – шайтан.
Dialogue: 0,0:14:54.39,0:14:56.93,Default,,0,0,0,,Құдай бізді құтқарды
Dialogue: 0,0:14:58.35,0:15:03.06,Default,,0,0,0,,Енді ешқашан... Мен сені енді ешқашан көрмеймін деп ойладым.
Dialogue: 0,0:15:04.77,0:15:06.98,Default,,0,0,0,,Мен кездеспегенім дұрыс деп ойладым.
Dialogue: 0,0:15:07.69,0:15:08.90,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:15:10.78,0:15:13.07,Default,,0,0,0,,Мен сенімен әрқашан кездескім келді.
Dialogue: 0,0:15:13.82,0:15:15.24,Default,,0,0,0,,Мен сені сағындым Ричард
Dialogue: 0,0:15:16.12,0:15:19.20,Default,,0,0,0,,Мен шынымен... шынымен бақыттымын.
Dialogue: 0,0:15:23.46,0:15:24.71,Default,,0,0,0,,Құрметті Ричард...
Dialogue: 0,0:15:25.21,0:15:27.42,Default,,0,0,0,,Мұнда аңдар келмейді
Dialogue: 0,0:15:27.92,0:15:29.21,Default,,0,0,0,,Мен оны жаңа ғана таптым.
Dialogue: 0,0:15:30.76,0:15:32.51,Default,,0,0,0,,Суық емес пе?
Dialogue: 0,0:15:34.76,0:15:37.81,Default,,0,0,0,,Генри Уорм...
Dialogue: 0,0:15:46.11,0:15:47.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:55.16,0:15:57.95,Default,,0,0,0,,Бұл арман емес еді...
Dialogue: 0,0:15:58.58,0:15:59.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:01.58,0:16:02.58,Default,,0,0,0,,Ричард
Dialogue: 0,0:16:02.67,0:16:05.33,Default,,0,0,0,,Жақсы нәрсе... бұл түс емес еді.
Dialogue: 0,0:16:05.42,0:16:05.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:06.63,0:16:08.67,Default,,0,0,0,,Кешіріңіз! Жара ...
Dialogue: 0,0:16:09.88,0:16:11.38,Default,,0,0,0,,Мен жаңасын алайын.
Dialogue: 0,0:16:12.47,0:16:13.68,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:16:13.76,0:16:14.59,Default,,0,0,0,,Ричард?
Dialogue: 0,0:16:16.93,0:16:17.85,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:19.01,0:16:20.89,Default,,0,0,0,,Неге сонша ренжідің?
Dialogue: 0,0:16:20.98,0:16:22.69,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,0:16:23.94,0:16:25.60,Default,,0,0,0,,Мен өлуге шамасы жоқ
Dialogue: 0,0:16:26.11,0:16:29.61,Default,,0,0,0,,Бұл ел Йорк үйіне қайтарылғанша.
Dialogue: 0,0:16:31.07,0:16:36.91,Default,,0,0,0,,Алайда ағамды көндіре алмасам, сол жерде өлтіріп тастауы мүмкін...
Dialogue: 0,0:16:38.16,0:16:41.37,Default,,0,0,0,,Тезірек үйге кел, Генри.
Dialogue: 0,0:16:44.46,0:16:46.42,Default,,0,0,0,,Ол атпен қашып кетті ме?
Dialogue: 0,0:16:46.92,0:16:48.75,Default,,0,0,0,,Мәртебелі Король аман ба?
Dialogue: 0,0:16:49.55,0:16:52.84,Default,,0,0,0,,Король туралы не деуге болады? Генри Лондон мұнарасында болуы керек
Dialogue: 0,0:16:53.34,0:16:55.05,Default,,0,0,0,,(Мейірбике 1) Ә? Неге бұл кішкентай ит тілім-шайыр шайнап отыр?
Dialogue: 0,0:16:55.97,0:16:57.89,Default,,0,0,0,,Бірақ әзірге Ричард...
Dialogue: 0,0:16:57.97,0:17:00.97,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:01.47,0:17:02.39,Default,,0,0,0,,Ричард!
Dialogue: 0,0:17:04.14,0:17:05.60,Default,,0,0,0,,Ауырса, мынаны қолданып көріңіз
Dialogue: 0,0:17:06.48,0:17:09.94,Default,,0,0,0,,Мен бұлақ таптым, бірақ су құйатын ештеңем жоқ...
Dialogue: 0,0:17:10.02,0:17:10.82,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:17:12.94,0:17:16.41,Default,,0,0,0,,Осы жерде болыңыз. Мен сауығып кеткен бойда кетемін.
Dialogue: 0,0:17:20.08,0:17:25.12,Default,,0,0,0,,Аспанға қарасам, Алғаш кездескен кезім есіме түседі.
Dialogue: 0,0:17:26.33,0:17:27.96,Default,,0,0,0,,Сіз өзгерген жоқсыз.
Dialogue: 0,0:17:29.08,0:17:32.80,Default,,0,0,0,,Мен анамның тастап кеткенін жиі армандаймын.
Dialogue: 0,0:17:33.76,0:17:36.55,Default,,0,0,0,,Сіз әлі де қорқынышты түс көресіз бе?
Dialogue: 0,0:17:37.89,0:17:39.76,Default,,0,0,0,,Дүниеде ештеңе өзгермейді
Dialogue: 0,0:17:40.47,0:17:45.48,Default,,0,0,0,,Бірақ сенімен өткен әдемі естеліктер мені тазартады
Dialogue: 0,0:17:46.06,0:17:48.44,Default,,0,0,0,,Әлемді әдемі түрде өзгертіңіз
Dialogue: 0,0:17:54.15,0:17:57.28,Default,,0,0,0,,Жалғыз болу қорқынышты емес еді
Dialogue: 0,0:17:57.78,0:18:02.91,Default,,0,0,0,,Әкемнен айырылғалы бері, Жалғыздық мейірімге бөленді.
Dialogue: 0,0:18:03.99,0:18:07.08,Default,,0,0,0,,Сондықтан мен енді ешқашан адаспаймын деп шештім.
Dialogue: 0,0:18:08.29,0:18:09.37,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:18:13.13,0:18:16.30,Default,,0,0,0,,Сіз мені... әлсіз етесіз.
Dialogue: 0,0:18:20.76,0:18:22.10,Default,,0,0,0,,Көшуге жарайсың ба?
Dialogue: 0,0:18:22.18,0:18:25.77,Default,,0,0,0,,Егер мен бәрін саған тапсырсам, аштан өлетін шығармын.
Dialogue: 0,0:18:25.85,0:18:27.31,Default,,0,0,0,,Сіз бұлақ бар дедіңіз.
Dialogue: 0,0:18:27.39,0:18:30.06,Default,,0,0,0,,Иә, мен оны белгіледім.
Dialogue: 0,0:18:30.15,0:18:34.02,Default,,0,0,0,,Жарайсыңдар, мен бүгін су әкелемін.
Dialogue: 0,0:18:34.11,0:18:35.78,Default,,0,0,0,,Сіз жалғыз барасыз ба?
Dialogue: 0,0:18:35.86,0:18:38.24,Default,,0,0,0,,Бірнеше бұтақтарды жинап, күтіңіз.
Dialogue: 0,0:18:43.12,0:18:46.91,Default,,0,0,0,,Қаншама... Ол бала ма?
Dialogue: 0,0:18:48.25,0:18:50.87,Default,,0,0,0,,Мұнда сіз адамдардың назарын аудара аласыз.
Dialogue: 0,0:19:04.14,0:19:05.72,Default,,0,0,0,,Суға түсуге болады ма?
Dialogue: 0,0:19:06.77,0:19:09.85,Default,,0,0,0,,Жарайды! Бұл жай ғана қан төгу.
Dialogue: 0,0:19:09.94,0:19:12.40,Default,,0,0,0,,Құлап қалсаң, қиналып қаласың. Мен саған көмектесемін.
Dialogue: 0,0:19:13.36,0:19:14.40,Default,,0,0,0,,Келме...
Dialogue: 0,0:19:18.90,0:19:20.70,Default,,0,0,0,,Маған қазір жақындасаңыз...
Dialogue: 0,0:19:22.41,0:19:24.53,Default,,0,0,0,,Менің денем көрінеді
Dialogue: 0,0:19:26.95,0:19:30.29,Default,,0,0,0,,Ричард...қанға боялған.
Dialogue: 0,0:19:33.00,0:19:35.17,Default,,0,0,0,,Қазір таза, Ричард.
Dialogue: 0,0:19:36.46,0:19:38.71,Default,,0,0,0,,Шынымен таза...
Dialogue: 0,0:19:43.26,0:19:46.39,Default,,0,0,0,,О? Бұл сирек. Ол бірінші тұтынушы.
Dialogue: 0,0:19:47.39,0:19:49.31,Default,,0,0,0,,Мен бірінші барамын, Генри.
Dialogue: 0,0:19:49.81,0:19:52.94,Default,,0,0,0,,Хе-хе... бұл сен көрмеген бет.
Dialogue: 0,0:19:53.02,0:19:55.48,Default,,0,0,0,,Ауыл қызы аман қалды.
Dialogue: 0,0:19:55.98,0:19:57.65,Default,,0,0,0,,Қазір киін...
Dialogue: 0,0:19:57.73,0:20:01.82,Default,,0,0,0,,Жоқ, аға, жүзіңіз сүйкімді емес пе?
Dialogue: 0,0:20:02.70,0:20:07.03,Default,,0,0,0,,Бұл біздің... құпия жұмақ
Dialogue: 0,0:20:07.62,0:20:09.54,Default,,0,0,0,,Әй, сен үлкен аға болсаң...
Dialogue: 0,0:20:10.83,0:20:12.62,Default,,0,0,0,,Тегін болса жақсы.
Dialogue: 0,0:20:12.71,0:20:14.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:14.17,0:20:15.54,Default,,0,0,0,,А... не!
Dialogue: 0,0:20:16.59,0:20:18.05,Default,,0,0,0,,Сәлем Генри!
Dialogue: 0,0:20:18.13,0:20:19.80,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:21.76,0:20:24.80,Default,,0,0,0,,Ана... Ана
Dialogue: 0,0:20:25.68,0:20:26.85,Default,,0,0,0,,Ана?
Dialogue: 0,0:20:27.85,0:20:31.39,Default,,0,0,0,,Сен жаман адамсың. Генри сені көреді.
Dialogue: 0,0:20:31.48,0:20:33.89,Default,,0,0,0,,Жарайды, сен әлі баласың.
Dialogue: 0,0:20:35.10,0:20:37.52,Default,,0,0,0,,Менің шын сүйетін жалғыз адамым сенсің
Dialogue: 0,0:20:38.02,0:20:42.36,Default,,0,0,0,,Мен барлығын Генриге қалдырамын, тек күнде екеуміз ғана...
Dialogue: 0,0:20:43.07,0:20:46.91,Default,,0,0,0,,Сен шайтансың, ең азғын, сұлусың
Dialogue: 0,0:20:46.99,0:20:51.50,Default,,0,0,0,,Иә, мен шайтанмын... махаббат шайтанымын.
Dialogue: 0,0:20:53.54,0:20:55.37,Default,,0,0,0,,Ананың опасыздығы мен сатқындығы
Dialogue: 0,0:20:56.63,0:20:59.42,Default,,0,0,0,,Бұл мені мәңгілікке қалдырды
Dialogue: 0,0:21:00.05,0:21:01.71,Default,,0,0,0,,Төртінші жекпе-жекте,
Dialogue: 0,0:21:02.21,0:21:04.22,Default,,0,0,0,,Сондықтан қорқасың ба?
Dialogue: 0,0:21:04.72,0:21:06.64,Default,,0,0,0,,Әйелдер жындар
Dialogue: 0,0:21:07.22,0:21:10.81,Default,,0,0,0,,Жоқ, қорқатын әйелдер емес.
Dialogue: 0,0:21:11.31,0:21:13.14,Default,,0,0,0,,Менің қорқатыным...
Dialogue: 0,0:21:14.18,0:21:15.35,Default,,0,0,0,,Қалау
Dialogue: 0,0:21:16.19,0:21:19.82,Default,,0,0,0,,Сүйу... Нәпсі күнә
Dialogue: 0,0:21:19.90,0:21:22.11,Default,,0,0,0,,Ауырды... неге?
Dialogue: 0,0:21:22.61,0:21:24.99,Default,,0,0,0,,Мен... ешкімді жақсы көрмеймін
Dialogue: 0,0:21:25.07,0:21:26.78,Default,,0,0,0,,Неліктен ауырады?
Dialogue: 0,0:21:27.91,0:21:33.16,Default,,0,0,0,,Сүйікті адамың болмаса да, жан-тәнімен сенетін досың болғаны дұрыс.
Dialogue: 0,0:21:33.25,0:21:36.71,Default,,0,0,0,,Мен әйел емеспін, бірақ...
Dialogue: 0,0:21:39.25,0:21:42.71,Default,,0,0,0,,Сен менің періштем Ричардсың
Dialogue: 0,0:21:45.51,0:21:49.93,Default,,0,0,0,,Мен... Генриді жақсы көремін.
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
