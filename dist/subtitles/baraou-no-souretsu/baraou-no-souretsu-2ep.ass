Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.96,0:00:07.79,Default,,0,0,0,,Ланкастер патшайымы Маргарет әскер жинады
Dialogue: 0,0:00:08.29,0:00:10.13,Default,,0,0,0,,Солтүстікті жаулап алды
Dialogue: 0,0:00:10.63,0:00:15.18,Default,,0,0,0,,Мен солтүстікке жорық жасап, Маргаретпен тура қарсымын.
Dialogue: 0,0:00:17.43,0:00:20.77,Default,,0,0,0,,Эдвард, сіз Уэльстің шекарасындасыз.
Dialogue: 0,0:00:20.85,0:00:21.56,Default,,0,0,0,,Га
Dialogue: 0,0:00:22.06,0:00:24.64,Default,,0,0,0,,Уорвик графы, астана Лондонды қорғаңыз.
Dialogue: 0,0:00:25.15,0:00:26.02,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:00:28.02,0:00:28.77,Default,,0,0,0,,Әке!
Dialogue: 0,0:00:29.36,0:00:32.28,Default,,0,0,0,,Мен де саған кедергі жасамаймын...
Dialogue: 0,0:00:38.58,0:00:39.58,Default,,0,0,0,,Ричард
Dialogue: 0,0:00:39.66,0:00:41.04,Default,,0,0,0,,Әке...
Dialogue: 0,0:00:41.12,0:00:42.29,Default,,0,0,0,,Сен!
Dialogue: 0,0:00:43.37,0:00:46.00,Default,,0,0,0,,Өтінемін, Ричард...
Dialogue: 0,0:00:46.08,0:00:49.71,Default,,0,0,0,,Менің кішкентай Ричардымды алып кетпеңіз.
Dialogue: 0,0:00:51.59,0:00:54.22,Default,,0,0,0,,Бұл бала бір күні майданға аттанатын шығар.
Dialogue: 0,0:00:54.72,0:00:59.10,Default,,0,0,0,,Бірақ бұл арық денеге әлі де анамның қолы керек.
Dialogue: 0,0:00:59.72,0:01:02.60,Default,,0,0,0,,Таяз әйелдің тілегін айтшы...
Dialogue: 0,0:01:03.10,0:01:04.81,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:01:05.94,0:01:07.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:07.65,0:01:11.11,Default,,0,0,0,,Ричард, менің әкем жақында үйге келеді.
Dialogue: 0,0:01:11.19,0:01:14.28,Default,,0,0,0,,Оған дейін анаңды қорға.
Dialogue: 0,0:01:19.95,0:01:21.16,Default,,0,0,0,,Әке...
Dialogue: 0,0:01:22.74,0:01:23.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:24.16,0:01:27.62,Default,,0,0,0,,Мен сені ол кісіге ешқашан жібермеймін.
Dialogue: 0,0:01:28.33,0:01:31.46,Default,,0,0,0,,Сіздің қатысуыңыз ол адамға өлім әкеледі.
Dialogue: 0,0:01:31.96,0:01:35.38,Default,,0,0,0,,Сөздерің қарғыс болып, халықты құртады.
Dialogue: 0,0:01:35.88,0:01:37.84,Default,,0,0,0,,Лас шайтан бала
Dialogue: 0,0:01:37.93,0:01:40.97,Default,,0,0,0,,Адамның жанын жемей өмір сүре алмайсың.
Dialogue: 0,0:01:41.55,0:01:42.97,Default,,0,0,0,,Олардың біреуі сарайдан оғаш масканы алып кеткен делінеді—
Dialogue: 0,0:01:43.06,0:01:45.98,Default,,0,0,0,,Мен бәріңді мына шайтаннан қорғаймын.
Dialogue: 0,0:01:46.06,0:01:47.35,Default,,0,0,0,,Бұл менің...
Dialogue: 0,0:01:47.44,0:01:51.44,Default,,0,0,0,,Бұл баланы дүниеге әкелгенім үшін өтеуім.
Dialogue: 0,0:01:57.53,0:01:59.57,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:59.66,0:02:01.70,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:02:02.20,0:02:08.21,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:02:08.71,0:02:13.59,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:02:17.51,0:02:19.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:43.38,0:03:45.39,Default,,0,0,0,,～♪
Dialogue: 0,0:03:50.60,0:03:53.27,Default,,0,0,0,,Ланкастердің үй базасы дәл сіздің алдыңызда.
Dialogue: 0,0:03:53.35,0:03:56.81,Default,,0,0,0,,Қылышыңды жіберме! Жеңіс мүмкіндігі біздікі!
Dialogue: 0,0:03:56.90,0:03:58.61,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:04:06.37,0:04:08.99,Default,,0,0,0,,Мен Маргареттің әскерінің соншалықты күшті екеніне сене алмаймын.
Dialogue: 0,0:04:09.08,0:04:11.91,Default,,0,0,0,,Олар біздің әскерден қорқып, қашып кеткен шығар.
Dialogue: 0,0:04:13.25,0:04:17.38,Default,,0,0,0,,Бір қызығы, жау солдаттарының саны аз...
Dialogue: 0,0:04:17.46,0:04:18.88,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:04:27.51,0:04:29.85,Default,,0,0,0,,Рождество жақындап қалды ма?
Dialogue: 0,0:04:30.68,0:04:34.19,Default,,0,0,0,,Бүкіл отбасымен той жасай алмаймын деп ойлаймын.
Dialogue: 0,0:04:34.27,0:04:35.81,Default,,0,0,0,,Бұл жағдайда...
Dialogue: 0,0:04:36.69,0:04:38.06,Default,,0,0,0,,Сәлем, анашым
Dialogue: 0,0:04:38.15,0:04:40.57,Default,,0,0,0,,Ричард... ол қайда кетті?
Dialogue: 0,0:04:42.15,0:04:44.53,Default,,0,0,0,,Сіз қауіпсіз жерде тұрасыз ба?
Dialogue: 0,0:04:45.53,0:04:47.24,Default,,0,0,0,,Мұнарада
Dialogue: 0,0:04:47.99,0:04:51.24,Default,,0,0,0,,Мұнарада тұтқындар бар ма? меннен басқа
Dialogue: 0,0:04:51.33,0:04:53.37,Default,,0,0,0,,Ол тұтқын!
Dialogue: 0,0:04:53.45,0:04:55.62,Default,,0,0,0,,Мұнда тек асыл адамдар бар!
Dialogue: 0,0:04:56.12,0:04:58.71,Default,,0,0,0,,Асыл... тұтқын?
Dialogue: 0,0:05:00.17,0:05:02.88,Default,,0,0,0,,Түсіндім, Генри осында...
Dialogue: 0,0:05:03.38,0:05:07.01,Default,,0,0,0,,Егер мен тұтқын болмасам, оны дәл қазір өлтіремін.
Dialogue: 0,0:05:07.09,0:05:10.18,Default,,0,0,0,,Мен сол басынан ұстап әкеме жүгірдім.
Dialogue: 0,0:05:10.26,0:05:13.22,Default,,0,0,0,,Қамыр да өте қарапайым.
Dialogue: 0,0:05:13.31,0:05:16.64,Default,,0,0,0,,Уорвик пен Эдвардсыз осылай болар еді.
Dialogue: 0,0:05:16.73,0:05:19.31,Default,,0,0,0,,Мәртебелі, біз қанды ашамыз!
Dialogue: 0,0:05:19.40,0:05:23.19,Default,,0,0,0,,Қол астындағылардың бірі өліп, жалғыз қашып кетуі патшаның жасайтын ісі емес.
Dialogue: 0,0:05:23.28,0:05:24.57,Default,,0,0,0,,Бірақ Мәртебелі!
Dialogue: 0,0:05:25.24,0:05:26.78,Default,,0,0,0,,Мен айтқанымнан қайтпауға ант бердім.
Dialogue: 0,0:05:27.28,0:05:30.91,Default,,0,0,0,,Тәжі немесе құрметпен өлім!
Dialogue: 0,0:05:33.37,0:05:34.33,Default,,0,0,0,,Хмф! (Жау солдаты А) Уф...
Dialogue: 0,0:05:34.83,0:05:36.21,Default,,0,0,0,,Ах! (Жау солдаты В) Уф...
Dialogue: 0,0:05:39.00,0:05:40.63,Default,,0,0,0,,Ланкастер!
Dialogue: 0,0:05:40.71,0:05:41.71,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:05:47.22,0:05:48.30,Default,,0,0,0,,Король...
Dialogue: 0,0:05:49.72,0:05:52.26,Default,,0,0,0,,Патша... шегінбейді.
Dialogue: 0,0:05:52.89,0:05:53.77,Default,,0,0,0,,Өз сөзіңізден қайтпаңыз!
Dialogue: 0,0:05:55.68,0:05:57.44,Default,,0,0,0,,Осы атпен!
Dialogue: 0,0:06:01.11,0:06:05.44,Default,,0,0,0,,Ричард Мен саған ант бердім...
Dialogue: 0,0:06:09.57,0:06:13.08,Default,,0,0,0,,Ричард Бұл ағаштың астынан кім өтеді?
Dialogue: 0,0:06:13.74,0:06:17.66,Default,,0,0,0,,Сол кезде қасында болған адамды сүю керек.
Dialogue: 0,0:06:17.75,0:06:19.12,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:19.21,0:06:21.71,Default,,0,0,0,,Анаң саған ашуланбай ма?
Dialogue: 0,0:06:21.79,0:06:23.04,Default,,0,0,0,,Әрине.
Dialogue: 0,0:06:23.13,0:06:26.34,Default,,0,0,0,,Дегенмен, ереже: кем дегенде 12 рет жасау керек.
Dialogue: 0,0:06:26.84,0:06:28.26,Default,,0,0,0,,Алдымен маған істе.
Dialogue: 0,0:06:28.76,0:06:30.01,Default,,0,0,0,,Әке!
Dialogue: 0,0:06:31.72,0:06:32.85,Default,,0,0,0,,Әке...
Dialogue: 0,0:06:39.69,0:06:41.40,Default,,0,0,0,,Ричард…
Dialogue: 0,0:06:41.48,0:06:43.56,Default,,0,0,0,,О, жақсы нәрсе.
Dialogue: 0,0:06:43.65,0:06:44.90,Default,,0,0,0,,Әлі тірі
Dialogue: 0,0:06:44.98,0:06:47.03,Default,,0,0,0,,Мені тез өлтір
Dialogue: 0,0:06:47.53,0:06:50.32,Default,,0,0,0,,Мен өмір сүруге қанша құм қалғанын білемін.
Dialogue: 0,0:06:50.41,0:06:51.86,Default,,0,0,0,,Жоқ, Мәртебелі
Dialogue: 0,0:06:51.95,0:06:55.49,Default,,0,0,0,,Себебі мен сені қорлау үшін тірі қалдырдым.
Dialogue: 0,0:06:56.24,0:06:57.33,Default,,0,0,0,,Енді мұны орындаңыз
Dialogue: 0,0:06:57.83,0:07:00.42,Default,,0,0,0,,Бар күшіммен тоқтым.
Dialogue: 0,0:07:00.50,0:07:02.08,Default,,0,0,0,,Хола
Dialogue: 0,0:07:02.17,0:07:04.42,Default,,0,0,0,,Мәртебелі оның өлімін қалады⸺
Dialogue: 0,0:07:04.50,0:07:06.17,Default,,0,0,0,,Бұл тәж.
Dialogue: 0,0:07:11.63,0:07:13.85,Default,,0,0,0,,О, охохохо
Dialogue: 0,0:07:13.93,0:07:15.60,Default,,0,0,0,,Қандай жақсы сәйкестік.
Dialogue: 0,0:07:15.68,0:07:20.02,Default,,0,0,0,,Эй, мырзалар, маған сәлем беріңдер! Оххохохо!
Dialogue: 0,0:07:20.10,0:07:22.48,Default,,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:07:22.56,0:07:26.48,Default,,0,0,0,,Өлім алдында мені көбірек көңіл көтеруіңізді өтінемін.
Dialogue: 0,0:07:27.19,0:07:28.99,Default,,0,0,0,,Йорк
Dialogue: 0,0:07:29.07,0:07:30.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:30.61,0:07:33.57,Default,,0,0,0,,Кәне, көбірек күрес! Мазасыз!
Dialogue: 0,0:07:33.66,0:07:37.58,Default,,0,0,0,,Жексенділігіңді ашпасаң, ашуым басылмас!
Dialogue: 0,0:07:38.16,0:07:41.96,Default,,0,0,0,,Өлсем де, күлден
Dialogue: 0,0:07:42.54,0:07:45.67,Default,,0,0,0,,Қайтадан кек қауырсындары ұшады
Dialogue: 0,0:07:46.29,0:07:50.26,Default,,0,0,0,,Бұл үміт сіздің мінсіздігіңіздің қайнар көзі ме?
Dialogue: 0,0:07:50.34,0:07:52.26,Default,,0,0,0,,Мен сенің айтқаныңды естідім.
Dialogue: 0,0:07:52.34,0:07:56.47,Default,,0,0,0,,Эдвард әйелші Джордж жалғыз ұяшық
Dialogue: 0,0:07:56.55,0:07:59.10,Default,,0,0,0,,Ал бірінші сыныптан кіші...
Dialogue: 0,0:07:59.64,0:08:04.10,Default,,0,0,0,,Сол кішкентай баланы ерекше жақсы көретін сияқтысың, солай емес пе?
Dialogue: 0,0:08:04.19,0:08:05.86,Default,,0,0,0,,Сіз не жоспарлап отырсыз...
Dialogue: 0,0:08:05.94,0:08:08.44,Default,,0,0,0,,Бұл сюжет.
Dialogue: 0,0:08:08.52,0:08:12.99,Default,,0,0,0,,Мен оны ұлы мәртебеліге өлім аузында жатқанда жеткізгім келді.
Dialogue: 0,0:08:14.20,0:08:15.24,Default,,0,0,0,,Ууух!
Dialogue: 0,0:08:16.16,0:08:18.41,Default,,0,0,0,,Қараңыз, Йорк.
Dialogue: 0,0:08:18.49,0:08:20.20,Default,,0,0,0,,Осы киімді бояған қан
Dialogue: 0,0:08:20.29,0:08:23.71,Default,,0,0,0,,Сүйікті кенже ұлыңыздың жүрегінен сығып қан.
Dialogue: 0,0:08:25.00,0:08:26.63,Default,,0,0,0,,Ричард…
Dialogue: 0,0:08:30.09,0:08:32.92,Default,,0,0,0,,Енді көз жасыңды сүрт
Dialogue: 0,0:08:34.22,0:08:37.35,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:08:38.85,0:08:41.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:43.10,0:08:45.48,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,0:08:46.60,0:08:47.52,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:48.02,0:08:50.73,Default,,0,0,0,,Хехехе...хехехе
Dialogue: 0,0:08:51.23,0:08:51.90,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:51.98,0:08:54.11,Default,,0,0,0,,сол әйелдің еркі еді, иә?
Dialogue: 0,0:08:54.70,0:08:56.74,Default,,0,0,0,,Иә, бұл бет!
Dialogue: 0,0:08:56.82,0:09:00.28,Default,,0,0,0,,Үмітсіздікке боялған сұлу жүзіңді көргім келді.
Dialogue: 0,0:09:00.37,0:09:02.45,Default,,0,0,0,,Бейшара Йорк
Dialogue: 0,0:09:03.37,0:09:06.37,Default,,0,0,0,,А... Мен қанағаттандым.
Dialogue: 0,0:09:08.50,0:09:12.46,Default,,0,0,0,,Сосын үмітсіз өл.
Dialogue: 0,0:09:14.47,0:09:16.59,Default,,0,0,0,,Жоғары мәртебелі, бұл жер жақсы емес!
Dialogue: 0,0:09:16.68,0:09:20.43,Default,,0,0,0,,Артқы күзетті оңтүстікке жылжытыңыз! Мен негізгі күшті әкелемін
Dialogue: 0,0:09:20.93,0:09:22.35,Default,,0,0,0,,Лондонды кез келген жағдайда қорғаңыз!
Dialogue: 0,0:09:23.10,0:09:24.23,Default,,0,0,0,,Құрметті Эдвард
Dialogue: 0,0:09:24.31,0:09:27.27,Default,,0,0,0,,Мәртебелі Генри басқа жаққа көшіп кеткен сияқты.
Dialogue: 0,0:09:33.03,0:09:34.11,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:09:34.61,0:09:37.53,Default,,0,0,0,,Мәртебелі Генриді тасымалдаушы Йорк сарбаздарынан қалпына келтіру
Dialogue: 0,0:09:37.61,0:09:39.16,Default,,0,0,0,,Қауіпсіз қорғалған.
Dialogue: 0,0:09:39.99,0:09:41.66,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:09:41.74,0:09:43.45,Default,,0,0,0,,Әркім, қолыңнан келгенін ал!
Dialogue: 0,0:09:44.04,0:09:46.25,Default,,0,0,0,,Тек алға ұмтылыңыз...
Dialogue: 0,0:09:47.50,0:09:50.59,Default,,0,0,0,,Бұл жолы Йорктың нағыз ұлының қанымен.
Dialogue: 0,0:09:50.67,0:09:53.05,Default,,0,0,0,,Мен сенің мойыныңды сүртіп алайын.
Dialogue: 0,0:10:02.93,0:10:04.39,Default,,0,0,0,,Әке...
Dialogue: 0,0:10:06.68,0:10:07.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:09.10,0:10:12.02,Default,,0,0,0,,Бұл қайда... неге сен?
Dialogue: 0,0:10:12.61,0:10:14.61,Default,,0,0,0,,Бұл ланкастриялықтардың үйі.
Dialogue: 0,0:10:15.11,0:10:17.24,Default,,0,0,0,,Мен сені тұтқынға алған соң кіргіздім.
Dialogue: 0,0:10:17.74,0:10:20.87,Default,,0,0,0,,Мен анамның әскеріне қосылғанша осындамын.
Dialogue: 0,0:10:20.95,0:10:23.28,Default,,0,0,0,,Маргареттің әскері ше?
Dialogue: 0,0:10:23.37,0:10:25.20,Default,,0,0,0,,Ланкастер алға жылжып жатыр ма?
Dialogue: 0,0:10:26.29,0:10:28.12,Default,,0,0,0,,Сіз ештеңе білмейсіз.
Dialogue: 0,0:10:28.62,0:10:30.96,Default,,0,0,0,,Мүмкін оның әкесімен әлі де бір қатысы бар шығар...
Dialogue: 0,0:10:31.54,0:10:32.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:32.13,0:10:34.67,Default,,0,0,0,,Әкеңе не болды? Бірдеңе болды ма?
Dialogue: 0,0:10:35.34,0:10:38.38,Default,,0,0,0,,Сіздің әкеңіз қазір Йоркте.
Dialogue: 0,0:10:38.47,0:10:40.38,Default,,0,0,0,,Жалғыз жүруге алыс емес.
Dialogue: 0,0:10:40.89,0:10:45.60,Default,,0,0,0,,Сіз менің қолымда болғаныңызша, мені өзіңізбен бірге ала аласыз.
Dialogue: 0,0:10:45.68,0:10:48.52,Default,,0,0,0,,Неліктен бізге Ланкастерге жабысу керек?
Dialogue: 0,0:10:48.60,0:10:52.02,Default,,0,0,0,,Әкемді кездестіретін болсам, ағам мен шешеммен бірге барар едім.
Dialogue: 0,0:10:52.10,0:10:54.82,Default,,0,0,0,,Ха, сенің анаң
Dialogue: 0,0:10:54.90,0:10:58.69,Default,,0,0,0,,Мен сіздің ағаңыз Ричардпен бірге эвакуацияланғаныңызды естідім.
Dialogue: 0,0:10:58.78,0:11:00.57,Default,,0,0,0,,Сізді тастап кетті
Dialogue: 0,0:11:00.65,0:11:01.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:06.16,0:11:07.16,Default,,0,0,0,,Ана?
Dialogue: 0,0:11:09.75,0:11:10.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:13.83,0:11:16.92,Default,,0,0,0,,Бұл бірінші рет емес... Мені лақтырып жіберді.
Dialogue: 0,0:11:21.59,0:11:25.10,Default,,0,0,0,,Күте тұрыңыз! Бұл аумақ көп ұзамай біздің әскердің қолына өтеді.
Dialogue: 0,0:11:25.18,0:11:26.26,Default,,0,0,0,,Неліктен тоқтау керек?
Dialogue: 0,0:11:26.76,0:11:30.23,Default,,0,0,0,,Мені тастап кеткеннен бері барымта ретінде құным жоқ.
Dialogue: 0,0:11:30.73,0:11:34.23,Default,,0,0,0,,Бұл... Неге екенін мен де білмеймін.
Dialogue: 0,0:11:34.31,0:11:37.11,Default,,0,0,0,,Әйел болғандықтан шығар!
Dialogue: 0,0:11:37.86,0:11:38.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:38.86,0:11:43.07,Default,,0,0,0,,Мен әйел емеспін. Әкем мені оның ұлымын деді.
Dialogue: 0,0:11:43.95,0:11:46.28,Default,,0,0,0,,Мен оны Ричард деп атадым.
Dialogue: 0,0:11:51.08,0:11:53.21,Default,,0,0,0,,(Солдаттардың ұрыс дауысы)
Dialogue: 0,0:11:55.50,0:11:57.88,Default,,0,0,0,,Ей, қай жолмен жүруім керек?
Dialogue: 0,0:11:57.96,0:12:00.34,Default,,0,0,0,,Әкеңе тезірек орал...
Dialogue: 0,0:12:00.42,0:12:01.26,Default,,0,0,0,,Эй
Dialogue: 0,0:12:02.51,0:12:03.84,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:12:04.64,0:12:06.93,Default,,0,0,0,,Бұл қаланы біз ланкастерлер басып алды.
Dialogue: 0,0:12:07.01,0:12:08.60,Default,,0,0,0,,(аттан түскен дыбыс)
Dialogue: 0,0:12:12.94,0:12:14.94,Default,,0,0,0,,Қала тұрғындарының көпшілігі қашып кетті.
Dialogue: 0,0:12:16.15,0:12:18.57,Default,,0,0,0,,Ойлан... Ойлан, Ричард.
Dialogue: 0,0:12:19.07,0:12:22.32,Default,,0,0,0,,Йорк қаласы алыс. Жылқылар бар.
Dialogue: 0,0:12:22.95,0:12:26.66,Default,,0,0,0,,Егер Ланкастер оны алып жатса, бұл жерден кету оңай болмайды.
Dialogue: 0,0:12:27.49,0:12:29.33,Default,,0,0,0,,Сіз ештеңе білмейсіз.
Dialogue: 0,0:12:29.83,0:12:32.33,Default,,0,0,0,,Мүмкін оның әкесімен әлі де бір қатысы бар шығар...
Dialogue: 0,0:12:32.91,0:12:34.92,Default,,0,0,0,,Тезірек әкеңе қайт!
Dialogue: 0,0:12:36.46,0:12:38.25,Default,,0,0,0,,Сіз шынымен де осы қаладансыз ба?
Dialogue: 0,0:12:41.59,0:12:45.97,Default,,0,0,0,,Әке... Мен сізге тез келемін!
Dialogue: 0,0:12:46.47,0:12:47.30,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:12:55.60,0:12:57.48,Default,,0,0,0,,(құрыштың шешіліп жатқан дыбысы)
Dialogue: 0,0:13:00.02,0:13:01.48,Default,,0,0,0,,Қарғыс атсын... Тезірек түс.
Dialogue: 0,0:13:01.57,0:13:03.40,Default,,0,0,0,,Тез шық!
Dialogue: 0,0:13:19.42,0:13:20.25,Default,,0,0,0,,(құлақ құлаған дыбыс)
Dialogue: 0,0:13:23.71,0:13:25.34,Default,,0,0,0,,Әйелі мен балалары…
Dialogue: 0,0:13:28.39,0:13:29.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:33.27,0:13:36.35,Default,,0,0,0,,Бұл баланың... әкесі
Dialogue: 0,0:13:37.94,0:13:39.98,Default,,0,0,0,,Мен... оны өлтірдім.
Dialogue: 0,0:13:44.69,0:13:45.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:54.95,0:13:55.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:01.54,0:14:02.46,Default,,0,0,0,,Әке...
Dialogue: 0,0:14:06.47,0:14:07.88,Default,,0,0,0,,Онда кім бар?
Dialogue: 0,0:14:07.97,0:14:08.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:10.89,0:14:13.56,Default,,0,0,0,,О, Құдай! Ричард…
Dialogue: 0,0:14:14.14,0:14:16.06,Default,,0,0,0,,Бұл шынымен сен бе?
Dialogue: 0,0:14:21.27,0:14:25.11,Default,,0,0,0,,Мен сенімен кездесемін деп ойламағаным сонша, қуаныштымын.
Dialogue: 0,0:14:25.61,0:14:26.32,Default,,0,0,0,,Неге...
Dialogue: 0,0:14:27.11,0:14:29.99,Default,,0,0,0,,Осындай кезде неге... неге!
Dialogue: 0,0:14:31.07,0:14:33.28,Default,,0,0,0,,Осы уақытқа дейін немен айналыстыңыз?
Dialogue: 0,0:14:33.78,0:14:35.16,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:14:35.24,0:14:36.33,Default,,0,0,0,,Келме...
Dialogue: 0,0:14:37.33,0:14:38.37,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:38.87,0:14:39.75,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:14:39.83,0:14:42.88,Default,,0,0,0,,Онда сен кел, Ричард.
Dialogue: 0,0:14:43.38,0:14:45.21,Default,,0,0,0,,Мен сенімен әрқашан кездескім келген
Dialogue: 0,0:14:46.76,0:14:48.30,Default,,0,0,0,,Кездейсоқ заттар...
Dialogue: 0,0:14:49.43,0:14:51.39,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:14:51.47,0:14:56.18,Default,,0,0,0,,Жалғыз... Мен жалғыз баруым керек.
Dialogue: 0,0:14:56.27,0:14:58.64,Default,,0,0,0,,А... күте тұрыңыз Ричард!
Dialogue: 0,0:15:00.23,0:15:02.23,Default,,0,0,0,,Жібер! Саған уақытым жоқ...
Dialogue: 0,0:15:02.31,0:15:05.44,Default,,0,0,0,,Мен де сенімен бірге барғым келеді! Мені өзіңізбен бірге ала аласыз ба?
Dialogue: 0,0:15:06.57,0:15:07.82,Default,,0,0,0,,Сіз?
Dialogue: 0,0:15:09.03,0:15:12.28,Default,,0,0,0,,Менің артымнан... Артымнан жүр Мен не істеуім керек?
Dialogue: 0,0:15:12.36,0:15:13.91,Default,,0,0,0,,Мен сенімен бірге болғым келеді
Dialogue: 0,0:15:13.99,0:15:18.66,Default,,0,0,0,,Мен сенің жаныңда болсам, өзімді өзім бола алатындай сезінемін.
Dialogue: 0,0:15:18.75,0:15:21.96,Default,,0,0,0,,Сондықтан екеуміз де сол орманға қайта барғымыз келеді.
Dialogue: 0,0:15:22.04,0:15:25.21,Default,,0,0,0,,Сонымен мен қой бақтым.
Dialogue: 0,0:15:25.29,0:15:28.88,Default,,0,0,0,,Мен әр күнімді шіркеу қоңырауларының дыбысымен өткізгім келеді.
Dialogue: 0,0:15:29.38,0:15:31.68,Default,,0,0,0,,Күндеріңіз тыныш және тыныш өтсін
Dialogue: 0,0:15:32.26,0:15:36.01,Default,,0,0,0,,Осылай жасасаң, саған бұлай зиян тимейді, солай ма?
Dialogue: 0,0:15:37.06,0:15:38.02,Default,,0,0,0,,Жара?
Dialogue: 0,0:15:40.98,0:15:44.23,Default,,0,0,0,,Мен зардап шеккен жоқпын. Бұл...
Dialogue: 0,0:15:45.44,0:15:46.57,Default,,0,0,0,,Адам қаны
Dialogue: 0,0:15:49.19,0:15:50.86,Default,,0,0,0,,Мен сенен өзгешемін
Dialogue: 0,0:15:51.86,0:15:55.99,Default,,0,0,0,,Ауырмасаң, неге жылайсың?
Dialogue: 0,0:15:56.62,0:16:00.50,Default,,0,0,0,,Мен... Маған ешкім керек емес
Dialogue: 0,0:16:02.54,0:16:03.58,Default,,0,0,0,,Ричард!
Dialogue: 0,0:16:04.92,0:16:05.42,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:16:07.21,0:16:09.09,Default,,0,0,0,,Мен оны іздедім.
Dialogue: 0,0:16:09.17,0:16:14.05,Default,,0,0,0,,Енді Лондонға бірге қайтайық.
Dialogue: 0,0:16:15.64,0:16:19.43,Default,,0,0,0,,Мені әкем күтіп тұр...
Dialogue: 0,0:16:19.97,0:16:21.48,Default,,0,0,0,,Сіз мені күтесіз
Dialogue: 0,0:16:24.56,0:16:26.56,Default,,0,0,0,,Біздің отряд жалғыз қалды ма?
Dialogue: 0,0:16:26.65,0:16:30.61,Default,,0,0,0,,Енді мен негізгі күшімді жоғалтқандықтан, мен енді күресе алмаймын...
Dialogue: 0,0:16:30.69,0:16:31.90,Default,,0,0,0,,Әлі берілме!
Dialogue: 0,0:16:32.57,0:16:34.99,Default,,0,0,0,,Эдвардтың күшейткіштері осы бағытта келе жатыр.
Dialogue: 0,0:16:35.07,0:16:37.62,Default,,0,0,0,,Кездескенше мен не болса да шыдаймын!
Dialogue: 0,0:16:47.38,0:16:49.59,Default,,0,0,0,,Мен әлі біткен жоқпын
Dialogue: 0,0:16:50.09,0:16:52.51,Default,,0,0,0,,Мәртебелі... менің арманым
Dialogue: 0,0:16:55.13,0:16:56.30,Default,,0,0,0,,Әке...
Dialogue: 0,0:17:01.72,0:17:02.85,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:17:02.93,0:17:03.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:04.31,0:17:06.40,Default,,0,0,0,,Йоркке апаратын жол қай жолмен?
Dialogue: 0,0:17:06.90,0:17:09.02,Default,,0,0,0,,Бағыт бойынша, ол жерде...
Dialogue: 0,0:17:09.77,0:17:14.95,Default,,0,0,0,,Бозарып кеткен сияқтысың, жақсысың ба? Йорк алыс
Dialogue: 0,0:17:15.45,0:17:17.45,Default,,0,0,0,,Демалуға уақыт жоқ
Dialogue: 0,0:17:18.20,0:17:21.49,Default,,0,0,0,,Түсіндім... Ұрылардан сақ болыңыз.
Dialogue: 0,0:17:25.71,0:17:27.88,Default,,0,0,0,,Қарап көріңізші, Мәртебелі.
Dialogue: 0,0:17:28.58,0:17:30.71,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:17:31.21,0:17:34.21,Default,,0,0,0,,Уорвиктің денесінің жоқ екені өкінішті.
Dialogue: 0,0:17:34.30,0:17:36.47,Default,,0,0,0,,Сіздің тәжіңізді ұрламақ болған Йорк...
Dialogue: 0,0:17:36.55,0:17:38.80,Default,,0,0,0,,Мен бұл туралы естігім келмейді!
Dialogue: 0,0:17:38.89,0:17:43.31,Default,,0,0,0,,О, мен Йорк герцогіне ант бергенім қандай сұмдық.
Dialogue: 0,0:17:43.39,0:17:45.14,Default,,0,0,0,,Осылай істе...
Dialogue: 0,0:17:46.02,0:17:48.15,Default,,0,0,0,,(Генридің айқайы)
Dialogue: 0,0:17:48.85,0:17:50.73,Default,,0,0,0,,Дұрыс, Мәртебелі.
Dialogue: 0,0:17:51.23,0:17:55.82,Default,,0,0,0,,Сіз тақты Йорк пен оның ұлына беруге уәде бердіңіз.
Dialogue: 0,0:17:56.32,0:17:58.86,Default,,0,0,0,,Әй, Мәртебелі, айтыңызшы.
Dialogue: 0,0:17:58.95,0:18:00.45,Default,,0,0,0,,Әдепсіздіктің қандай түрі бар?
Dialogue: 0,0:18:00.53,0:18:03.24,Default,,0,0,0,,Сіздің ұлыңыз мұрадан айырылды ма?
Dialogue: 0,0:18:03.87,0:18:06.25,Default,,0,0,0,,Сол баламен тікелей сөйлесіңіз.
Dialogue: 0,0:18:06.33,0:18:10.42,Default,,0,0,0,,Анашым! Әкем мені мұрадан айыруға мүмкіндік жоқ.
Dialogue: 0,0:18:10.50,0:18:13.55,Default,,0,0,0,,Патшаның ұлы патша болуға міндетті.
Dialogue: 0,0:18:14.05,0:18:15.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:15.67,0:18:18.63,Default,,0,0,0,,Кез келген жануар баланы еркелетеді.
Dialogue: 0,0:18:19.13,0:18:21.47,Default,,0,0,0,,Сондықтан жауды көргенде қорқамыз.
Dialogue: 0,0:18:22.51,0:18:24.85,Default,,0,0,0,,Қарашы, қарашы, Генри!
Dialogue: 0,0:18:24.93,0:18:27.85,Default,,0,0,0,,Өлтірген сарбаздарыңды, тастап кеткен ұлыңды!
Dialogue: 0,0:18:28.85,0:18:30.35,Default,,0,0,0,,Бұл менің кінәм емес
Dialogue: 0,0:18:30.44,0:18:33.44,Default,,0,0,0,,Амал жоқ... Амал жоқ!
Dialogue: 0,0:18:33.52,0:18:36.74,Default,,0,0,0,,Мен ешкімнің өлгенін қаламадым.
Dialogue: 0,0:18:37.24,0:18:39.91,Default,,0,0,0,,Өтінемін кешір мені, өтінемін кешір мені...
Dialogue: 0,0:18:40.41,0:18:41.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:41.74,0:18:45.08,Default,,0,0,0,,Қорқақ, арам, ұятсыз патша.
Dialogue: 0,0:18:45.58,0:18:48.62,Default,,0,0,0,,Мен ешқашан сенің әйелің болмағанымды қалаймын.
Dialogue: 0,0:18:49.71,0:18:52.46,Default,,0,0,0,,Ах... Құрметті Уильям
Dialogue: 0,0:18:53.00,0:18:55.17,Default,,0,0,0,,Енді құшақтайтын дене жоқ
Dialogue: 0,0:18:55.67,0:18:59.42,Default,,0,0,0,,Жүрегімді аспанға апардың
Dialogue: 0,0:18:59.51,0:19:03.64,Default,,0,0,0,,Кешіріңіз... Өтінемін, кешіріңіз, Йорк.
Dialogue: 0,0:19:04.14,0:19:07.02,Default,,0,0,0,,Өтінемін кешір мені... Өтінемін кешір мені...
Dialogue: 0,0:19:07.81,0:19:10.02,Default,,0,0,0,,Боқ... мен көп жүгірдім бе?
Dialogue: 0,0:19:10.10,0:19:13.94,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:19:19.57,0:19:22.11,Default,,0,0,0,,Мен түнде орманды жек көремін.
Dialogue: 0,0:19:44.26,0:19:45.68,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:48.89,0:19:52.06,Default,,0,0,0,,Ланкастер тонап кеткен үй...
Dialogue: 0,0:19:54.77,0:19:59.44,Default,,0,0,0,,Әке... Сіз жылы нәрсе жеп жатырсыз деп үміттенемін.
Dialogue: 0,0:19:59.53,0:20:00.24,Default,,0,0,0,,(шу)
Dialogue: 0,0:20:01.99,0:20:03.53,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:20:09.49,0:20:12.58,Default,,0,0,0,,Сіз Ланкастердің әскерінен кетіп қалдыңыз ба?
Dialogue: 0,0:20:12.66,0:20:13.46,Default,,0,0,0,,(төмен итеру дыбысы)
Dialogue: 0,0:20:13.96,0:20:17.34,Default,,0,0,0,,Сен жақсы үйрексің, енді киіміңді шеш.
Dialogue: 0,0:20:17.42,0:20:19.25,Default,,0,0,0,,Тыныш бол, балақай.
Dialogue: 0,0:20:19.34,0:20:21.92,Default,,0,0,0,,Біздің ауылды құртып жатырсың!
Dialogue: 0,0:20:23.88,0:20:27.80,Default,,0,0,0,,Эй, бұл әйел. Сіз бақыттысыз.
Dialogue: 0,0:20:27.89,0:20:30.35,Default,,0,0,0,,Маған ұнамайды! мен әйел емеспін
Dialogue: 0,0:20:30.43,0:20:33.19,Default,,0,0,0,,Тоқта... Тоқта! әке!
Dialogue: 0,0:20:34.48,0:20:36.44,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:20:36.94,0:20:37.56,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:42.78,0:20:44.36,Default,,0,0,0,,Мен әйел емеспін
Dialogue: 0,0:20:45.20,0:20:47.53,Default,,0,0,0,,Әке... көмектесіңізші!
Dialogue: 0,0:20:47.62,0:20:49.99,Default,,0,0,0,,Ібілістің баласы Ібілістің баласы!
Dialogue: 0,0:20:50.08,0:20:53.25,Default,,0,0,0,,Жоқ! Мен шайтанның баласы емеспін
Dialogue: 0,0:20:53.33,0:20:55.92,Default,,0,0,0,,Мен... әкемнің ұлымын!
Dialogue: 0,0:20:56.88,0:21:01.30,Default,,0,0,0,,Мені қараңғылықтан әкем ғана құтқара алады.
Dialogue: 0,0:21:05.59,0:21:06.34,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:08.60,0:21:09.51,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:21:15.39,0:21:19.56,Default,,0,0,0,,(Ричардтың ауыр тыныс алуы)
Dialogue: 0,0:21:24.11,0:21:25.45,Default,,0,0,0,,Әке!
Dialogue: 0,0:21:29.41,0:21:30.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:41.17,0:21:42.42,Default,,0,0,0,,Әке...
Dialogue: 0,0:21:45.59,0:21:48.09,Default,,0,0,0,,Менің... жарығым
Dialogue: 0,0:22:01.44,0:22:03.44,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.90,0:23:30.90,Default,,0,0,0,,～♪
