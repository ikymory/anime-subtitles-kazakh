Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:03.04,Default,,0,0,0,,(қылыштың тербелген дыбысы)
Dialogue: 0,0:00:03.54,0:00:05.79,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:00:06.29,0:00:07.38,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:08.46,0:00:10.01,Default,,0,0,0,,Қалайсың, Энн?
Dialogue: 0,0:00:10.09,0:00:12.67,Default,,0,0,0,,Менің мына ұлы тұлғама қарасаңыз, оны да көресіз...
Dialogue: 0,0:00:16.39,0:00:20.22,Default,,0,0,0,,Ричардтың сізге не ұнады?
Dialogue: 0,0:00:21.31,0:00:25.02,Default,,0,0,0,,Дұрыс, ерік-жігерім күшті...
Dialogue: 0,0:00:25.52,0:00:27.36,Default,,0,0,0,,Оның да түрі сүйкімді.
Dialogue: 0,0:00:27.86,0:00:28.82,Default,,0,0,0,,Олар жау болса да?
Dialogue: 0,0:00:29.32,0:00:32.57,Default,,0,0,0,,Жау болсаң да, патша болғанша аласың.
Dialogue: 0,0:00:33.28,0:00:36.24,Default,,0,0,0,,Және ол маған ешқашан қарамайды.
Dialogue: 0,0:00:37.03,0:00:38.62,Default,,0,0,0,,Оның жақсы жағы да осы.
Dialogue: 0,0:00:40.87,0:00:43.04,Default,,0,0,0,,Сіз...
Dialogue: 0,0:00:43.91,0:00:48.17,Default,,0,0,0,,Сіз осындай нәрсеге кек сақтайсыз ба? әке
Dialogue: 0,0:00:48.92,0:00:50.71,Default,,0,0,0,,Мен кек сақтамаймын.
Dialogue: 0,0:00:51.63,0:00:55.34,Default,,0,0,0,,Бәрі де Алланың жазған тағдыры.
Dialogue: 0,0:00:56.68,0:00:58.72,Default,,0,0,0,,Құдай... Құдай Құдай!
Dialogue: 0,0:00:58.80,0:01:02.56,Default,,0,0,0,,Құдайға сенбе! Алдын ала белгілеген тағдырыңды.
Dialogue: 0,0:01:03.27,0:01:06.23,Default,,0,0,0,,Өз күшіңізбен қалағаныңызға қол жеткізіңіз!
Dialogue: 0,0:01:06.90,0:01:08.94,Default,,0,0,0,,Ричард - кірпіш
Dialogue: 0,0:01:09.02,0:01:10.77,Default,,0,0,0,,Иа... хех
Dialogue: 0,0:01:10.86,0:01:12.78,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:01:12.86,0:01:14.99,Default,,0,0,0,,Бұлай айтқаныңызға сене алар емеспін.
Dialogue: 0,0:01:15.57,0:01:16.99,Default,,0,0,0,,Неге күлу керек?
Dialogue: 0,0:01:17.07,0:01:20.53,Default,,0,0,0,,Бірақ әйелдердің дені сау болғаны жақсы.
Dialogue: 0,0:01:21.03,0:01:21.95,Default,,0,0,0,,Эдвард
Dialogue: 0,0:01:22.74,0:01:25.91,Default,,0,0,0,,Бір-бірімізді сүйе алмасақ та
Dialogue: 0,0:01:26.00,0:01:27.92,Default,,0,0,0,,Дос бола алатынымызға сенімдімін.
Dialogue: 0,0:01:29.46,0:01:30.75,Default,,0,0,0,,Достар…
Dialogue: 0,0:01:31.50,0:01:35.72,Default,,0,0,0,,Эй, қарсы болмасаң, менімен шахмат ойнағың келе ме?
Dialogue: 0,0:01:35.80,0:01:38.01,Default,,0,0,0,,Мен кесте тігуде жақсы емеспін.
Dialogue: 0,0:01:41.55,0:01:43.60,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:43.68,0:01:45.77,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:46.27,0:01:52.23,Default,,0,0,0,,Раушан эмблемасы бар патша әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:52.73,0:01:57.61,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:02:01.53,0:02:03.54,Default,,0,0,0,,♪～
Dialogue: 0,0:03:27.41,0:03:29.41,Default,,0,0,0,,～♪
Dialogue: 0,0:03:31.00,0:03:36.71,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:03:38.42,0:03:40.17,Default,,0,0,0,,Тұман қалыңдап барады.
Dialogue: 0,0:03:42.22,0:03:43.89,Default,,0,0,0,,Бұл соңғы рет
Dialogue: 0,0:03:44.39,0:03:49.10,Default,,0,0,0,,Бұл шайқаста Ланкастер... Мен әкемнің жауын міндетті түрде жеңемін.
Dialogue: 0,0:03:51.68,0:03:52.85,Default,,0,0,0,,Құрметті Эдвард...
Dialogue: 0,0:03:57.27,0:03:59.65,Default,,0,0,0,,Керней тартпай...
Dialogue: 0,0:03:59.73,0:04:00.94,Default,,0,0,0,,Өйткені
Dialogue: 0,0:04:02.99,0:04:04.49,Default,,0,0,0,,Уорвик
Dialogue: 0,0:04:05.24,0:04:07.95,Default,,0,0,0,,Сіз өз жолыңызды қате бағалаған сияқтысыз.
Dialogue: 0,0:04:08.45,0:04:10.50,Default,,0,0,0,,Сіз қателескен адамсыз.
Dialogue: 0,0:04:11.00,0:04:14.37,Default,,0,0,0,,Бізге сонша әскермен шабуыл жасамақшысың ба?
Dialogue: 0,0:04:14.87,0:04:19.67,Default,,0,0,0,,Елшіге қалай қарауды білмейсің, бір әйел жетпейді дейсің.
Dialogue: 0,0:04:19.75,0:04:22.34,Default,,0,0,0,,Мен өзімді жаудан қорғаудың амалын ойлап та үлгермеймін.
Dialogue: 0,0:04:22.92,0:04:26.39,Default,,0,0,0,,Патшалықты иығыңда қалай көтере аласың?
Dialogue: 0,0:04:26.47,0:04:29.89,Default,,0,0,0,,Сені туған ағаң да тастап кетті!
Dialogue: 0,0:04:30.68,0:04:31.89,Default,,0,0,0,,Эдвардқа қара.
Dialogue: 0,0:04:32.93,0:04:35.44,Default,,0,0,0,,Сені тастап кеткен ағаң келді.
Dialogue: 0,0:04:35.94,0:04:39.15,Default,,0,0,0,,Ағамды шақыруға лайық әскерді басқарып.
Dialogue: 0,0:04:39.23,0:04:41.07,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:04:41.15,0:04:43.53,Default,,0,0,0,,Маргареттің әскері дер кезінде келді ме?
Dialogue: 0,0:04:53.71,0:04:54.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:55.67,0:04:57.63,Default,,0,0,0,,Менің інім
Dialogue: 0,0:04:57.71,0:05:02.38,Default,,0,0,0,,Сіз оны нағыз ағасы, заңды патшаға семсерін сілтеп тұрған бейбақ деп ойладыңыз ба?
Dialogue: 0,0:05:02.46,0:05:04.17,Default,,0,0,0,,Тыңда, Уорвик!
Dialogue: 0,0:05:04.26,0:05:08.76,Default,,0,0,0,,Жамандығым үшін ұяламын, Міне, ағайынның сенімін ақтайын деп отырмын.
Dialogue: 0,0:05:08.85,0:05:11.93,Default,,0,0,0,,Мен сені өлімші жауым деп жариялаймын!
Dialogue: 0,0:05:12.02,0:05:14.81,Default,,0,0,0,,Енді ұрыс күші 50/50!
Dialogue: 0,0:05:14.89,0:05:18.65,Default,,0,0,0,,Жүрегімдегі жараны 100-ге көбейтіп қайтарамын.
Dialogue: 0,0:05:18.73,0:05:20.23,Default,,0,0,0,,Мені кешіріңіз...
Dialogue: 0,0:05:20.31,0:05:21.65,Default,,0,0,0,,Сатқын!
Dialogue: 0,0:05:21.73,0:05:25.32,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,0:05:25.40,0:05:28.66,Default,,0,0,0,,Егер Генри Лондоннан қашып үлгерсе ше?
Dialogue: 0,0:05:28.74,0:05:30.16,Default,,0,0,0,,Немесе онда...
Dialogue: 0,0:05:30.24,0:05:31.91,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,0:05:32.45,0:05:36.54,Default,,0,0,0,,(сарбаздардың ұрыс дауыстары)
Dialogue: 0,0:05:39.33,0:05:41.25,Default,,0,0,0,,Қандай тұман! Бұл...
Dialogue: 0,0:05:41.75,0:05:43.42,Default,,0,0,0,,Менің артымнан жүр! (Ланкастер сарбаздары) Уф...
Dialogue: 0,0:05:44.55,0:05:47.26,Default,,0,0,0,,Көремін... Көремін
Dialogue: 0,0:05:47.76,0:05:50.26,Default,,0,0,0,,Ланкастердің қызыл қаны!
Dialogue: 0,0:05:53.43,0:05:54.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:55.31,0:05:58.31,Default,,0,0,0,,Мәртебелі, көпшілік шешім қабылдағанша.
Dialogue: 0,0:05:58.39,0:06:03.11,Default,,0,0,0,,Уорвик графының лагеріне кірмей, жасырынуға рұқсат етіңіз.
Dialogue: 0,0:06:03.69,0:06:06.19,Default,,0,0,0,,О... Құдайым
Dialogue: 0,0:06:06.78,0:06:09.74,Default,,0,0,0,,Құдайдың қалауымен жеңіске жету.
Dialogue: 0,0:06:10.32,0:06:13.95,Default,,0,0,0,,Жоқ... Мен ешкімнің зардап шеккенін қаламаймын.
Dialogue: 0,0:06:14.45,0:06:15.75,Default,,0,0,0,,Ешкім
Dialogue: 0,0:06:16.25,0:06:17.87,Default,,0,0,0,,Мәртебелі! (Генри) Мен...
Dialogue: 0,0:06:18.54,0:06:23.21,Default,,0,0,0,,Осы уақытқа дейін халықтың жүрегіне жақынмын деп ойладым.
Dialogue: 0,0:06:24.00,0:06:26.42,Default,,0,0,0,,Бірақ мен шындықтан бет бұра бердім.
Dialogue: 0,0:06:27.67,0:06:30.80,Default,,0,0,0,,Сенің қасыңда бәрінің дерті...
Dialogue: 0,0:06:31.72,0:06:33.51,Default,,0,0,0,,Мен оны өз көзіммен көруім керек
Dialogue: 0,0:06:34.01,0:06:37.10,Default,,0,0,0,,Ақырында, патша ретінде
Dialogue: 0,0:06:37.18,0:06:40.35,Default,,0,0,0,,(сарбаздардың ұрыс дауыстары)
Dialogue: 0,0:06:47.86,0:06:48.86,Default,,0,0,0,,Құрметті Ричард!
Dialogue: 0,0:06:49.36,0:06:52.70,Default,,0,0,0,,Мына тұманда...Ричард!
Dialogue: 0,0:06:53.57,0:06:56.87,Default,,0,0,0,,Осы тұманда бір-бірімізбен соғыссақ
Dialogue: 0,0:06:56.95,0:06:59.87,Default,,0,0,0,,Күмән толық күйреуге әкелуі мүмкін
Dialogue: 0,0:07:01.62,0:07:02.63,Default,,0,0,0,,Букингем
Dialogue: 0,0:07:03.29,0:07:06.84,Default,,0,0,0,,Сіз Ричард сияқты әскерлеріңізді осында тоқтатыңыз.
Dialogue: 0,0:07:06.92,0:07:08.38,Default,,0,0,0,,Не?
Dialogue: 0,0:07:09.59,0:07:14.05,Default,,0,0,0,,Ей, бұл адам қазір мен. Герцогқа көмектес.
Dialogue: 0,0:07:14.14,0:07:15.39,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:07:15.47,0:07:18.35,Default,,0,0,0,,Ричард күтіңіз! Сіз жалғыз кіруді жоспарлап отырсыз ба?
Dialogue: 0,0:07:19.02,0:07:22.27,Default,,0,0,0,,Сіз жалғыз емессіз, достарыңызбен біргесіз.
Dialogue: 0,0:07:22.35,0:07:23.48,Default,,0,0,0,,(Шинобу) Мұнда тірі қалғандар жоқ сияқты.
Dialogue: 0,0:07:25.77,0:07:28.15,Default,,0,0,0,,Керемет 50 және 50
Dialogue: 0,0:07:28.73,0:07:32.74,Default,,0,0,0,,Бірақ егер шайқас созылса, оларға күшейту керек болады...
Dialogue: 0,0:07:33.24,0:07:37.08,Default,,0,0,0,,Бауырым, мен Ричардпен және басқалармен бірге шайқасамын.
Dialogue: 0,0:07:37.16,0:07:38.04,Default,,0,0,0,,Джордж
Dialogue: 0,0:07:38.12,0:07:40.66,Default,,0,0,0,,Егер сіз Уорвикті жеңсеңіз, Изабель енді ешқашан...
Dialogue: 0,0:07:40.75,0:07:42.96,Default,,0,0,0,,Бірақ! Ах...
Dialogue: 0,0:07:43.71,0:07:45.96,Default,,0,0,0,,Сен менің қасымда бол
Dialogue: 0,0:07:46.46,0:07:48.75,Default,,0,0,0,,Мен Уорвикті өлтіремін.
Dialogue: 0,0:07:50.09,0:07:53.47,Default,,0,0,0,,Толқынды өзгертетін бір ғана соққы болса...
Dialogue: 0,0:07:57.47,0:07:59.02,Default,,0,0,0,,Уорвик туы…
Dialogue: 0,0:07:59.60,0:08:02.10,Default,,0,0,0,,Бұл Ланкастердің негізгі лагері ме?
Dialogue: 0,0:08:03.44,0:08:08.52,Default,,0,0,0,,(сарбаздардың ұрыс дауыстары)
Dialogue: 0,0:08:12.15,0:08:13.49,Default,,0,0,0,,Балалар! (Ланкастер сарбаздары) Ах...
Dialogue: 0,0:08:13.57,0:08:16.74,Default,,0,0,0,,Менің артымнан жүр! Жаудың лагері сонда.
Dialogue: 0,0:08:16.82,0:08:18.91,Default,,0,0,0,,Олар тұман болғандықтан байқамайды.
Dialogue: 0,0:08:18.99,0:08:20.54,Default,,0,0,0,,Енді мен өтірік айтатын едім
Dialogue: 0,0:08:20.62,0:08:24.62,Default,,0,0,0,,Мен әскери ерлік жасаймын! Қорқақтар, тұрған жеріңде қал!
Dialogue: 0,0:08:24.71,0:08:25.63,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:25.71,0:08:26.83,Default,,0,0,0,,Кеттік! Мен де барамын!
Dialogue: 0,0:08:26.92,0:08:29.00,Default,,0,0,0,,Бұл мүмкіндікті жіберіп алмаңыз!
Dialogue: 0,0:08:29.50,0:08:32.63,Default,,0,0,0,,Менің артымнан еріңдер, ланкастриялық сарбаздар.
Dialogue: 0,0:08:34.88,0:08:37.43,Default,,0,0,0,,Иә? Сіз мен жақтасыз ба?
Dialogue: 0,0:08:38.76,0:08:39.31,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:39.39,0:08:40.85,Default,,0,0,0,,Жауды жең!
Dialogue: 0,0:08:40.93,0:08:42.64,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:08:44.19,0:08:46.23,Default,,0,0,0,,Ланкастерді жеңіңіз!
Dialogue: 0,0:08:46.94,0:08:47.94,Default,,0,0,0,,Жоғары мәртебелі, граф!
Dialogue: 0,0:08:48.02,0:08:51.36,Default,,0,0,0,,Негізгі лагерьдің арты бірден құлай бастады!
Dialogue: 0,0:08:51.44,0:08:53.99,Default,,0,0,0,,Не? Олар күшейткіштер ме?
Dialogue: 0,0:08:54.07,0:08:55.86,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:08:56.57,0:08:59.20,Default,,0,0,0,,Біздің одақтастарымыз бір-бірімен соғысып жатқан сияқты.
Dialogue: 0,0:08:59.74,0:09:00.45,Default,,0,0,0,,Чи…
Dialogue: 0,0:09:00.95,0:09:04.21,Default,,0,0,0,,Бұл өзара шабуыл ма? бұл күлкілі
Dialogue: 0,0:09:04.71,0:09:06.58,Default,,0,0,0,,Аспан әлі біз жақта!
Dialogue: 0,0:09:06.67,0:09:09.75,Default,,0,0,0,,Мырзалар! Жеңіс өз қолымызда
Dialogue: 0,0:09:09.84,0:09:12.05,Default,,0,0,0,,Дәл осылай, мен сені бір қағып тастаймын!
Dialogue: 0,0:09:13.13,0:09:14.01,Default,,0,0,0,,Какаре!
Dialogue: 0,0:09:14.09,0:09:16.47,Default,,0,0,0,,Тоцугеки~!
Dialogue: 0,0:09:16.55,0:09:17.97,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:09:22.56,0:09:24.43,Default,,0,0,0,,Қарғыс атқыр тұман
Dialogue: 0,0:09:29.11,0:09:31.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:37.20,0:09:38.07,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:09:38.57,0:09:41.20,Default,,0,0,0,,Уорвик мен ант бердім.
Dialogue: 0,0:09:41.28,0:09:42.62,Default,,0,0,0,,Мені патша етіңіз!
Dialogue: 0,0:09:43.24,0:09:45.25,Default,,0,0,0,,Жоқ... жоқ
Dialogue: 0,0:09:45.75,0:09:47.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:47.67,0:09:50.17,Default,,0,0,0,,Сен менің жанымды арамдадың!
Dialogue: 0,0:09:50.25,0:09:53.63,Default,,0,0,0,,Жоқ... Мен бәрін бердім.
Dialogue: 0,0:09:54.13,0:09:55.80,Default,,0,0,0,,Сені патша ету үшін
Dialogue: 0,0:09:55.88,0:09:59.34,Default,,0,0,0,,Иә! Мен сенің патшаңмын!
Dialogue: 0,0:10:01.39,0:10:02.22,Default,,0,0,0,,Уорвик!
Dialogue: 0,0:10:03.47,0:10:04.89,Default,,0,0,0,,Эдвард…
Dialogue: 0,0:10:05.93,0:10:07.81,Default,,0,0,0,,Қарғыс атсын бұл бет...
Dialogue: 0,0:10:07.89,0:10:11.02,Default,,0,0,0,,Әкеңнің жанын арамдаған сенсің!
Dialogue: 0,0:10:11.11,0:10:12.32,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:10:12.40,0:10:13.69,Default,,0,0,0,,Қол тигізбеңіз
Dialogue: 0,0:10:13.77,0:10:15.99,Default,,0,0,0,,Бұл кісінің өмірі менікі!
Dialogue: 0,0:10:16.07,0:10:18.45,Default,,0,0,0,,Сіз және мен жеке жекпе-жекте?
Dialogue: 0,0:10:18.95,0:10:24.45,Default,,0,0,0,,Сіз ұмыттыңыз ба? Кішкентай кезіңде мен саған қылыш қолдануды үйреткенмін.
Dialogue: 0,0:10:30.37,0:10:33.17,Default,,0,0,0,,Күн батып бара жатыр, Эдвард.
Dialogue: 0,0:10:33.25,0:10:35.96,Default,,0,0,0,,Уорвик күткендей күшті.
Dialogue: 0,0:10:36.05,0:10:38.17,Default,,0,0,0,,Біз әлі де жеңілуге ​​шыдай алмаймыз.
Dialogue: 0,0:10:38.84,0:10:41.55,Default,,0,0,0,,Бірақ күткендей мағынасы бар.
Dialogue: 0,0:10:42.05,0:10:43.22,Default,,0,0,0,,Бұл сіздің қаныңыз ба?
Dialogue: 0,0:10:44.72,0:10:47.39,Default,,0,0,0,,Жақында сен менен күшті боласың
Dialogue: 0,0:10:49.19,0:10:50.06,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,0:10:53.44,0:10:54.23,Default,,0,0,0,,Уорвик
Dialogue: 0,0:10:54.90,0:10:58.86,Default,,0,0,0,,Егер мен орта жолда құлап қалсам
Dialogue: 0,0:10:59.53,0:11:03.24,Default,,0,0,0,,Өтінемін, Эдвардты патша етіңіз.
Dialogue: 0,0:11:05.91,0:11:08.79,Default,,0,0,0,,Маған ант беріңізші...
Dialogue: 0,0:11:09.91,0:11:11.67,Default,,0,0,0,,Қамыттағы тәж
Dialogue: 0,0:11:12.46,0:11:13.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:14.42,0:11:15.50,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:16.42,0:11:17.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:19.42,0:11:20.30,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:11:20.38,0:11:21.84,Default,,0,0,0,,Қарғыс атсын... (Эдвард) Уорвик!
Dialogue: 0,0:11:21.93,0:11:23.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:23.14,0:11:24.30,Default,,0,0,0,,Гах...
Dialogue: 0,0:11:26.22,0:11:27.89,Default,,0,0,0,,Жоғары мәртебелі, қашыңыз!
Dialogue: 0,0:11:27.97,0:11:30.10,Default,,0,0,0,,Бұлай жалғаса берсе, әскеріміз күйреді!
Dialogue: 0,0:11:30.69,0:11:33.15,Default,,0,0,0,,Жолға оралайық!
Dialogue: 0,0:11:33.65,0:11:35.44,Default,,0,0,0,,Ол қашып кетті! Оны қу!
Dialogue: 0,0:11:35.52,0:11:36.02,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:36.69,0:11:40.07,Default,,0,0,0,,Міндетті болыңыз... оларды тірідей ұстаңыз.
Dialogue: 0,0:11:40.57,0:11:41.99,Default,,0,0,0,,Ешқашан өлтірме
Dialogue: 0,0:11:43.41,0:11:46.41,Default,,0,0,0,,Бітім, мен мұның осылай аяқталуына шыдай алмаймын.
Dialogue: 0,0:11:46.49,0:11:49.62,Default,,0,0,0,,Мен бұл елді басқарып келемін.
Dialogue: 0,0:11:49.70,0:11:53.58,Default,,0,0,0,,Егер сіз Маргареттің әскеріне қосылсаңыз, дереу қайтадан соғысуға болады.
Dialogue: 0,0:11:54.71,0:11:55.63,Default,,0,0,0,,Тәжі...
Dialogue: 0,0:11:56.13,0:11:59.21,Default,,0,0,0,,Тәжі әлі менің қолымда
Dialogue: 0,0:11:59.71,0:12:00.67,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:12:12.06,0:12:15.60,Default,,0,0,0,,Уорвик, сенің уақытың бітті.
Dialogue: 0,0:12:16.11,0:12:17.86,Default,,0,0,0,,Бұдан былай бұл менмін
Dialogue: 0,0:12:18.94,0:12:20.28,Default,,0,0,0,,Кингмейкер
Dialogue: 0,0:12:22.57,0:12:23.28,Default,,0,0,0,,Уорвик!
Dialogue: 0,0:12:23.36,0:12:27.12,Default,,0,0,0,,Оны кім өлтірді! Оны дереу қолға түсіріп, басын кесіңіз!
Dialogue: 0,0:12:27.83,0:12:28.83,Default,,0,0,0,,Уорвик
Dialogue: 0,0:12:28.91,0:12:32.33,Default,,0,0,0,,А... мұңымның көлеңкесі
Dialogue: 0,0:12:32.87,0:12:36.17,Default,,0,0,0,,Сен өлсең, менің қараңғылығым да өледі.
Dialogue: 0,0:12:38.79,0:12:40.75,Default,,0,0,0,,Бар ма...
Dialogue: 0,0:12:40.84,0:12:41.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:42.88,0:12:44.05,Default,,0,0,0,,Ол соншалықты керемет пианист болса да—
Dialogue: 0,0:12:44.63,0:12:47.72,Default,,0,0,0,,Өлім сенің көзіңді Құдайдың пердесін жапты ма?
Dialogue: 0,0:12:48.22,0:12:50.72,Default,,0,0,0,,Жауымның жүзін білмей де...
Dialogue: 0,0:12:51.47,0:12:53.06,Default,,0,0,0,,Бұл біртүрлі нәрсе.
Dialogue: 0,0:12:53.14,0:12:56.65,Default,,0,0,0,,Мен оны жоғалтатынымды білгенде, тек әдемі нәрселер есіме түседі
Dialogue: 0,0:12:58.02,0:13:02.32,Default,,0,0,0,,А... Даңқ енді қоқыс па?
Dialogue: 0,0:13:02.99,0:13:04.99,Default,,0,0,0,,Менің қолымда ештеңе жоқ
Dialogue: 0,0:13:05.49,0:13:09.20,Default,,0,0,0,,Тіпті бұл дене де жақын арада жерге батады
Dialogue: 0,0:13:09.70,0:13:13.54,Default,,0,0,0,,Маған ештеңе қалмады...
Dialogue: 0,0:13:16.92,0:13:19.25,Default,,0,0,0,,Мәртебелі Патша аман болсын!
Dialogue: 0,0:13:19.96,0:13:23.34,Default,,0,0,0,,Қараңдаршы, жас жаңа патша келді.
Dialogue: 0,0:13:29.97,0:13:32.72,Default,,0,0,0,,Қандай құрметті және әдемі
Dialogue: 0,0:13:33.77,0:13:37.14,Default,,0,0,0,,Әке, бұл король Генри VI ма?
Dialogue: 0,0:13:37.65,0:13:38.98,Default,,0,0,0,,Ол Йорк герцогы⸺
Dialogue: 0,0:13:39.06,0:13:41.36,Default,,0,0,0,,Бұл Ричард Плантагенет емес пе?
Dialogue: 0,0:13:41.86,0:13:44.15,Default,,0,0,0,,Мәртебелі Генри сонда.
Dialogue: 0,0:13:48.82,0:13:50.32,Default,,0,0,0,,Бұл патша ма?
Dialogue: 0,0:13:50.91,0:13:54.54,Default,,0,0,0,,Йорк герцогы әлдеқайда құрметті және әдемі емес пе?
Dialogue: 0,0:13:57.04,0:14:00.58,Default,,0,0,0,,А... мына кісі тәж киіп жүрсе
Dialogue: 0,0:14:01.54,0:14:03.30,Default,,0,0,0,,Қандай әдемі
Dialogue: 0,0:14:12.76,0:14:13.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:15.68,0:14:19.31,Default,,0,0,0,,Жаныңды осылай ұстаймын
Dialogue: 0,0:14:20.35,0:14:22.65,Default,,0,0,0,,Менен басқаның қолынан өлме.
Dialogue: 0,0:14:24.65,0:14:27.78,Default,,0,0,0,,Мен... сенің патшаңмын.
Dialogue: 0,0:14:29.11,0:14:33.49,Default,,0,0,0,,Менің... менің патшам?
Dialogue: 0,0:14:34.66,0:14:35.87,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:14:37.79,0:14:42.38,Default,,0,0,0,,Бір күні Алланың рұқсатымен...
Dialogue: 0,0:14:48.92,0:14:49.80,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:14:49.88,0:14:51.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:51.59,0:14:55.85,Default,,0,0,0,,Не болды? Кейінірек ат арбамен келуге болады.
Dialogue: 0,0:14:56.35,0:15:00.56,Default,,0,0,0,,Жарайды, мен соғыс жағдайын тезірек білгім келеді.
Dialogue: 0,0:15:01.06,0:15:03.11,Default,,0,0,0,,Нәтиже белгілі
Dialogue: 0,0:15:03.61,0:15:08.24,Default,,0,0,0,,Біз жеткенше әкең тойлап жатқан болады.
Dialogue: 0,0:15:08.74,0:15:10.20,Default,,0,0,0,,Йорк төккен қанмен
Dialogue: 0,0:15:10.28,0:15:14.83,Default,,0,0,0,,Әке ешқашан Йорктіктерге зиян тигізбейді!
Dialogue: 0,0:15:15.70,0:15:19.96,Default,,0,0,0,,Ол шын мәнінде басқаларға қарағанда жанашыр.
Dialogue: 0,0:15:20.04,0:15:21.58,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:15:21.67,0:15:25.29,Default,,0,0,0,,Мен Уорвик Йорк ағайындыларды өлтіреді деп ойламаймын.
Dialogue: 0,0:15:25.38,0:15:28.42,Default,,0,0,0,,Ол негізінен парасатты адам.
Dialogue: 0,0:15:29.63,0:15:30.92,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:15:32.18,0:15:34.22,Default,,0,0,0,,Бірақ бұл қорқынышты.
Dialogue: 0,0:15:35.43,0:15:37.56,Default,,0,0,0,,Бұл шайқаста не болғанына қарамастан
Dialogue: 0,0:15:38.06,0:15:41.73,Default,,0,0,0,,Менің жүрегім өзгеріп бара жатқандай сезінемін
Dialogue: 0,0:15:43.35,0:15:44.86,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:15:46.11,0:15:50.99,Default,,0,0,0,,Не болса да, сенің менің әйелім екенің өзгермейді.
Dialogue: 0,0:15:51.07,0:15:53.57,Default,,0,0,0,,Мен әкемнен ерекшемін
Dialogue: 0,0:15:53.66,0:15:55.95,Default,,0,0,0,,Ер болып, отбасыңды қорға!
Dialogue: 0,0:15:56.45,0:16:00.04,Default,,0,0,0,,Сондықтан әзірге Ланкастердің жеңісінен үміттеніңіз.
Dialogue: 0,0:16:00.54,0:16:03.12,Default,,0,0,0,,Өйткені сіз ланкастриялықсыз.
Dialogue: 0,0:16:04.12,0:16:07.63,Default,,0,0,0,,Иә, мен енді Невилл отбасының қызы емеспін.
Dialogue: 0,0:16:08.13,0:16:11.17,Default,,0,0,0,,Бұдан былай Ланкастердің дворяндары ретінде.
Dialogue: 0,0:16:11.26,0:16:13.01,Default,,0,0,0,,Корольдік отбасын қорғаңыз
Dialogue: 0,0:16:13.51,0:16:15.39,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:16:15.47,0:16:17.85,Default,,0,0,0,,Йорк сарбаздары қашып кетті! Оны қу!
Dialogue: 0,0:16:17.93,0:16:19.85,Default,,0,0,0,,Жоқ! Мен Йорк емеспін!
Dialogue: 0,0:16:20.81,0:16:21.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:23.14,0:16:25.81,Default,,0,0,0,,Маған көмектес! мен...
Dialogue: 0,0:16:25.90,0:16:27.02,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:33.90,0:16:35.82,Default,,0,0,0,,Мен сенің патшаңмын
Dialogue: 0,0:16:36.32,0:16:38.66,Default,,0,0,0,,Сіз... патшасыз ба?
Dialogue: 0,0:16:39.16,0:16:43.66,Default,,0,0,0,,Халқым, сенің азабың – менің азабым.
Dialogue: 0,0:16:44.58,0:16:47.79,Default,,0,0,0,,Бірақ менің қолымнан келетіні – дұға ету
Dialogue: 0,0:16:47.88,0:16:50.34,Default,,0,0,0,,Хо... сіз шынымен патшасыз ба?
Dialogue: 0,0:16:50.84,0:16:55.13,Default,,0,0,0,,Сене алар емеспін... Ол жас жігіт сияқты.
Dialogue: 0,0:16:55.63,0:16:58.30,Default,,0,0,0,,Мен де сен сияқты көз жасымды төгуге келдім.
Dialogue: 0,0:17:00.06,0:17:01.97,Default,,0,0,0,,Сен екеуміз бірдейміз
Dialogue: 0,0:17:06.65,0:17:07.60,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:17:07.69,0:17:08.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:08.56,0:17:10.36,Default,,0,0,0,,Егер сіз шынымен патша болсаңыз
Dialogue: 0,0:17:10.86,0:17:15.11,Default,,0,0,0,,Маңдайында көп жылғы азаптың әжімдері басылуы керек.
Dialogue: 0,0:17:15.20,0:17:18.28,Default,,0,0,0,,Терім төгілген қан мен шаңмен ластанған.
Dialogue: 0,0:17:18.37,0:17:21.24,Default,,0,0,0,,Мен бұл әдемі болып қала алмаймын.
Dialogue: 0,0:17:21.33,0:17:23.66,Default,,0,0,0,,Патша осылайша кіршіксіз қалды.
Dialogue: 0,0:17:23.75,0:17:26.33,Default,,0,0,0,,Бізді қанға бояйтын.
Dialogue: 0,0:17:26.42,0:17:30.09,Default,,0,0,0,,Бәріне сен кінәлісің! Мен сен үшін өлемін!
Dialogue: 0,0:17:30.17,0:17:32.00,Default,,0,0,0,,Өмірдің мәнін білмей тұрып, мен...
Dialogue: 0,0:17:32.09,0:17:32.84,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:17:33.71,0:17:35.42,Default,,0,0,0,,Сіз кімсіз!
Dialogue: 0,0:17:35.92,0:17:39.05,Default,,0,0,0,,Ланкастер? Йорк? Маған айтпасаң, мен сені өлтіремін!
Dialogue: 0,0:17:40.80,0:17:45.52,Default,,0,0,0,,Ол... неге... ол Ланкастер болды.
Dialogue: 0,0:17:45.60,0:17:48.31,Default,,0,0,0,,Бұл ақымақ, олай болуы мүмкін емес...
Dialogue: 0,0:17:50.36,0:17:52.40,Default,,0,0,0,,О, Құдай...
Dialogue: 0,0:17:52.90,0:17:55.53,Default,,0,0,0,,Бұл менің кінәм емес, асыл бұйырған.
Dialogue: 0,0:17:56.11,0:17:58.03,Default,,0,0,0,,Ұрыс даласында өлтіруден басқа амалың жоқ.
Dialogue: 0,0:17:58.11,0:18:01.24,Default,,0,0,0,,Ланкастер болсын, Йорк болсын, оны өлтіруден басқа амалым жоқ!
Dialogue: 0,0:18:02.03,0:18:03.29,Default,,0,0,0,,Өмір сүру!
Dialogue: 0,0:18:04.62,0:18:06.08,Default,,0,0,0,,Мәртебелі! (Ричард) А...
Dialogue: 0,0:18:07.79,0:18:09.00,Default,,0,0,0,,Ж-жарайды… Сатып алғаныңызға рахмет.
Dialogue: 0,0:18:09.50,0:18:11.59,Default,,0,0,0,,Жоқ... Мен оны міндетті түрде естідім.
Dialogue: 0,0:18:12.54,0:18:15.05,Default,,0,0,0,,Қайда... Король Генри осында!
Dialogue: 0,0:18:19.22,0:18:21.26,Default,,0,0,0,,Осылайша, Ричард.
Dialogue: 0,0:18:22.01,0:18:23.72,Default,,0,0,0,,Генри сол жерде.
Dialogue: 0,0:18:23.81,0:18:26.93,Default,,0,0,0,,Мен сіздің сөзіңізге сенемін деп ойлайсыз ба?
Dialogue: 0,0:18:27.43,0:18:28.73,Default,,0,0,0,,(Ринраку) Бұл тек бір теория ғана, бірақ адам еті мен қанын жеудің орнына, Незуко…
Dialogue: 0,0:18:29.52,0:18:32.19,Default,,0,0,0,,Өтірік емес, рас
Dialogue: 0,0:18:32.27,0:18:35.69,Default,,0,0,0,,Жүр, сені тәтті Генри күтіп тұр.
Dialogue: 0,0:18:36.99,0:18:38.49,Default,,0,0,0,,Иә? Бұл дұрыс емес
Dialogue: 0,0:18:39.24,0:18:41.82,Default,,0,0,0,,Король Генри күтіп тұр ма?
Dialogue: 0,0:18:41.91,0:18:43.28,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:18:43.37,0:18:45.99,Default,,0,0,0,,Қымбаттым Генри де сені күтіп отыр.
Dialogue: 0,0:18:47.96,0:18:49.67,Default,,0,0,0,,Кел, Ричард.
Dialogue: 0,0:18:49.75,0:18:52.92,Default,,0,0,0,,Генриді көргіңіз келсе, осында келіңіз.
Dialogue: 0,0:18:54.71,0:18:58.47,Default,,0,0,0,,Күте тұр, Ричард, бақсыға құлақ аспа.
Dialogue: 0,0:18:58.97,0:19:02.30,Default,,0,0,0,,Әлгі әйел сізді шатастырғысы келеді.
Dialogue: 0,0:19:02.80,0:19:04.60,Default,,0,0,0,,Патша сол орманның арғы жағында.
Dialogue: 0,0:19:05.18,0:19:09.69,Default,,0,0,0,,Егер сіз бақсыға ерсеңіз, Генриді енді ешқашан өлтіре алмайсыз.
Dialogue: 0,0:19:10.19,0:19:12.02,Default,,0,0,0,,Менің жауларымнан кек ал
Dialogue: 0,0:19:12.77,0:19:14.73,Default,,0,0,0,,Йорк тағында тыныштықта жат
Dialogue: 0,0:19:14.82,0:19:17.61,Default,,0,0,0,,Ричард, менімен бірге жүр.
Dialogue: 0,0:19:17.69,0:19:19.32,Default,,0,0,0,,Егер сіз Генримен танысқыңыз келсе
Dialogue: 0,0:19:19.82,0:19:22.20,Default,,0,0,0,,Ричард, маған сеніңіз.
Dialogue: 0,0:19:22.87,0:19:24.62,Default,,0,0,0,,Тек менің сөздерім...
Dialogue: 0,0:19:24.70,0:19:26.16,Default,,0,0,0,,Генриді өлтіру үшін!
Dialogue: 0,0:19:26.24,0:19:27.87,Default,,0,0,0,,Кел, Ричард!
Dialogue: 0,0:19:30.29,0:19:31.33,Default,,0,0,0,,Жанна…
Dialogue: 0,0:19:32.67,0:19:33.46,Default,,0,0,0,,Ричард
Dialogue: 0,0:19:33.54,0:19:34.84,Default,,0,0,0,,Отыр, құбыжық!
Dialogue: 0,0:19:37.30,0:19:38.55,Default,,0,0,0,,Ричард…
Dialogue: 0,0:19:39.84,0:19:45.10,Default,,0,0,0,,Шынайы сені білетін жалғыз адам болсам да...
Dialogue: 0,0:19:46.43,0:19:50.27,Default,,0,0,0,,Әке, мен сенің жауыңды осы қолдармен міндетті түрде жеңемін.
Dialogue: 0,0:19:51.10,0:19:52.90,Default,,0,0,0,,Ричардқа ант етіңіз
Dialogue: 0,0:19:53.73,0:19:55.31,Default,,0,0,0,,Дәл сол кездегідей
Dialogue: 0,0:19:57.61,0:19:59.86,Default,,0,0,0,,Маған жол көрсетіңізші, әке.
Dialogue: 0,0:20:00.36,0:20:03.91,Default,,0,0,0,,Мені Генри корольге апарыңыз!
Dialogue: 0,0:20:05.41,0:20:08.16,Default,,0,0,0,,Қазір қашып кетіңіз, Мәртебелі!
Dialogue: 0,0:20:09.75,0:20:12.12,Default,,0,0,0,,Бұл адам не үшін өлді?
Dialogue: 0,0:20:12.87,0:20:14.33,Default,,0,0,0,,Ол бала да...
Dialogue: 0,0:20:15.00,0:20:18.63,Default,,0,0,0,,Мен болмасам, сен өлмес едің
Dialogue: 0,0:20:19.13,0:20:20.80,Default,,0,0,0,,Мен үшін...
Dialogue: 0,0:20:21.38,0:20:22.63,Default,,0,0,0,,Мұнда күт
Dialogue: 0,0:20:23.13,0:20:27.76,Default,,0,0,0,,Корольді жең, мен сол уәде етілген орманға барамын, Генри.
Dialogue: 0,0:20:28.72,0:20:31.10,Default,,0,0,0,,Өйткені маған ұнайтыны - өзіңсің.
Dialogue: 0,0:20:31.60,0:20:36.31,Default,,0,0,0,,Дұрыс, кім болсаң да, сен менікісің...
Dialogue: 0,0:20:37.48,0:20:38.44,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:38.52,0:20:42.28,Default,,0,0,0,,Қателеспесем, Генри корольді көрдім.
Dialogue: 0,0:20:42.78,0:20:44.20,Default,,0,0,0,,Осы бағытта
Dialogue: 0,0:20:44.28,0:20:45.16,Default,,0,0,0,,Генри ше?
Dialogue: 0,0:20:49.66,0:20:51.12,Default,,0,0,0,,Құрметті Ричард!
Dialogue: 0,0:20:54.75,0:20:57.71,Default,,0,0,0,,Мен... оны өлтірдім.
Dialogue: 0,0:20:59.09,0:21:01.17,Default,,0,0,0,,Мен өлтірдім
Dialogue: 0,0:21:01.25,0:21:03.05,Default,,0,0,0,,Қашайық, Мәртебелі!
Dialogue: 0,0:21:03.76,0:21:06.05,Default,,0,0,0,,Аты да, мәртебесі де маңызды емес.
Dialogue: 0,0:21:06.13,0:21:09.26,Default,,0,0,0,,Генри, сен менің жарығымсың.
Dialogue: 0,0:21:10.85,0:21:13.64,Default,,0,0,0,,Сондықтан мен патшаны өлтірдім...
Dialogue: 0,0:21:18.40,0:21:22.32,Default,,0,0,0,,Жарықты алыңыз...
Dialogue: 0,0:21:26.66,0:21:27.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:31.91,0:21:33.04,Default,,0,0,0,,Генри
Dialogue: 0,0:21:34.91,0:21:36.25,Default,,0,0,0,,Ричард…
Dialogue: 0,0:21:38.58,0:21:40.63,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:41.46,0:21:45.22,Default,,0,0,0,,Менің... Менің атым Ричард.
Dialogue: 0,0:21:46.13,0:21:49.05,Default,,0,0,0,,Ричард Плантагенет
Dialogue: 0,0:21:50.47,0:21:55.27,Default,,0,0,0,,Ланкастер өлтірген Йорк герцогының ұлы...
Dialogue: 0,0:21:56.60,0:22:00.98,Default,,0,0,0,,Генри Сіз кімсіз...?
Dialogue: 0,0:22:03.69,0:22:04.48,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:22:05.49,0:22:07.90,Default,,0,0,0,,Мен осы елденмін...
Dialogue: 0,0:22:09.24,0:22:10.12,Default,,0,0,0,,Король
Dialogue: 0,0:22:19.71,0:22:20.92,Default,,0,0,0,,(құлаған қылыштың дыбысы)
Dialogue: 0,0:22:32.64,0:22:34.64,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.90,0:23:30.90,Default,,0,0,0,,～♪
