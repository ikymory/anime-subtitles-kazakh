Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.01,0:00:13.26,Default,,0,0,0,,Уорвик, әкем...
Dialogue: 0,0:00:14.01,0:00:16.72,Default,,0,0,0,,Герцог атағы маған мұра болса да
Dialogue: 0,0:00:17.22,0:00:19.72,Default,,0,0,0,,Ол адам кетті...
Dialogue: 0,0:00:20.22,0:00:21.14,Default,,0,0,0,,Эдвард
Dialogue: 0,0:00:21.89,0:00:26.90,Default,,0,0,0,,Оның ұлы болсаң, оны герцог демей, патша де.
Dialogue: 0,0:00:27.40,0:00:29.27,Default,,0,0,0,,Әйтпесе, сіз
Dialogue: 0,0:00:29.36,0:00:31.40,Default,,0,0,0,,Ричард Плантагенеттің баласы емес
Dialogue: 0,0:00:32.86,0:00:33.99,Default,,0,0,0,,Уорвик…
Dialogue: 0,0:00:34.07,0:00:37.07,Default,,0,0,0,,Біздің әскер сізді Англия королі деп таниды.
Dialogue: 0,0:00:37.16,0:00:38.45,Default,,0,0,0,,Мәлімдеме жасаңыз
Dialogue: 0,0:00:39.08,0:00:42.25,Default,,0,0,0,,Лондон Ланкастерге кіруден бас тартады.
Dialogue: 0,0:00:42.75,0:00:44.91,Default,,0,0,0,,Олай болса, жау бір рет әскерді тартуы керек.
Dialogue: 0,0:00:46.46,0:00:48.38,Default,,0,0,0,,Дәл осы жерде шешуші шайқас болады.
Dialogue: 0,0:00:49.21,0:00:52.84,Default,,0,0,0,,Мырзалар, болашақты келесі шайқас анықтайды.
Dialogue: 0,0:00:52.92,0:00:56.80,Default,,0,0,0,,Англияны жақсы көретіндер, маған еріңдер!
Dialogue: 0,0:00:57.51,0:01:01.26,Default,,0,0,0,,Менің әкем сені өзінің «жан құтқарушысы» дейді.
Dialogue: 0,0:01:02.14,0:01:04.10,Default,,0,0,0,,Мен де, Уорвик.
Dialogue: 0,0:01:04.64,0:01:07.77,Default,,0,0,0,,Екі жанды бір тізбекпен байланыстырайық
Dialogue: 0,0:01:08.27,0:01:11.23,Default,,0,0,0,,Сіз құлаған кезде Эдвардтың да құлайтын уақыты келді.
Dialogue: 0,0:01:12.44,0:01:14.19,Default,,0,0,0,,Маған көз жасы керек емес
Dialogue: 0,0:01:15.40,0:01:17.66,Default,,0,0,0,,Жоқтау киімі – болат шынжыр
Dialogue: 0,0:01:18.45,0:01:21.87,Default,,0,0,0,,Ланкастердің дулығасына кек семсерін соғыңыз!
Dialogue: 0,0:01:21.95,0:01:24.08,Default,,0,0,0,,Құдайым, күш-қуат бер!
Dialogue: 0,0:01:25.83,0:01:27.71,Default,,0,0,0,,Қанша жыласаң да
Dialogue: 0,0:01:28.37,0:01:31.59,Default,,0,0,0,,Дем алған сайын ашудың оты тұтанады.
Dialogue: 0,0:01:32.09,0:01:34.55,Default,,0,0,0,,Осы денені түгел күйдіріңіз
Dialogue: 0,0:01:40.55,0:01:42.60,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:42.68,0:01:44.77,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:45.27,0:01:51.23,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:51.73,0:01:56.53,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:02:00.53,0:02:02.53,Default,,0,0,0,,♪～
Dialogue: 0,0:03:26.41,0:03:28.41,Default,,0,0,0,,～♪
Dialogue: 0,0:03:46.76,0:03:48.01,Default,,0,0,0,,Уорвик…
Dialogue: 0,0:03:50.43,0:03:51.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:51.77,0:03:53.77,Default,,0,0,0,,Сүйген адамыма уәде бердім
Dialogue: 0,0:03:54.27,0:03:57.48,Default,,0,0,0,,Тірі келсем, бірге болайық...
Dialogue: 0,0:03:57.98,0:03:59.53,Default,,0,0,0,,Қалжың болса да, ондай нәрсе
Dialogue: 0,0:03:59.61,0:04:01.40,Default,,0,0,0,,Бұлай айтпау керек.
Dialogue: 0,0:04:02.07,0:04:04.41,Default,,0,0,0,,Мен әрқашан байсалдымын
Dialogue: 0,0:04:06.03,0:04:09.37,Default,,0,0,0,,Мен қазір сенімен біргемін, Уорвик.
Dialogue: 0,0:04:15.92,0:04:17.21,Default,,0,0,0,,Бұл жер қай жер?
Dialogue: 0,0:04:20.96,0:04:22.67,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:04:25.93,0:04:28.81,Default,,0,0,0,,Барлық жерде тас қараңғы.
Dialogue: 0,0:04:29.39,0:04:30.39,Default,,0,0,0,,Оқ жаудыр!
Dialogue: 0,0:04:35.27,0:04:37.19,Default,,0,0,0,,Бұл мен үшін
Dialogue: 0,0:04:38.23,0:04:41.36,Default,,0,0,0,,Мен қанның түсін ғана көремін...
Dialogue: 0,0:04:42.24,0:04:43.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:44.74,0:04:48.12,Default,,0,0,0,,Қоян-қолтық ұрысқа дейін қанша азайтуға болады...
Dialogue: 0,0:04:49.28,0:04:51.83,Default,,0,0,0,,Қалғаны Құдайға байланысты.
Dialogue: 0,0:04:53.16,0:04:54.16,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:05:00.67,0:05:02.51,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:05:03.01,0:05:07.43,Default,,0,0,0,,Бұл денені күйдіретін жалынды басатын көз жас емес.
Dialogue: 0,0:05:18.56,0:05:19.19,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:19.27,0:05:21.65,Default,,0,0,0,,Жүр! Дәл осылай, қамыттың бәрін бірден басып тастаңыз.
Dialogue: 0,0:05:21.73,0:05:22.82,Default,,0,0,0,,Уау! (Эдуард) А...
Dialogue: 0,0:05:25.11,0:05:26.90,Default,,0,0,0,,Мен осы жерден артқа қарай жылжимын.
Dialogue: 0,0:05:26.99,0:05:29.37,Default,,0,0,0,,Мен саған бірге екенімізді айттым, Уорвик!
Dialogue: 0,0:05:29.45,0:05:30.87,Default,,0,0,0,,Аспанға ант етемін... Әй
Dialogue: 0,0:05:32.54,0:05:35.87,Default,,0,0,0,,Қарашы, Уорвик, күн...
Dialogue: 0,0:05:53.89,0:05:56.31,Default,,0,0,0,,Қан! Әлі жеткіліксіз
Dialogue: 0,0:05:56.39,0:05:58.98,Default,,0,0,0,,Көбірек, көбірек, көбірек!
Dialogue: 0,0:05:59.48,0:06:01.06,Default,,0,0,0,,Мен қан алғым келеді
Dialogue: 0,0:06:03.65,0:06:05.40,Default,,0,0,0,,Жау күштері?
Dialogue: 0,0:06:05.49,0:06:08.07,Default,,0,0,0,,Иә, олардың мыңдағаны
Dialogue: 0,0:06:08.15,0:06:10.78,Default,,0,0,0,,Одақтастарыңыздың моральдық деңгейінің төмендеуі.
Dialogue: 0,0:06:10.87,0:06:13.49,Default,,0,0,0,,Қазір шегіну жақсы идея ма?
Dialogue: 0,0:06:20.37,0:06:23.54,Default,,0,0,0,,Сол күн жақсылықтың белгісі. Аспан біз жақта!
Dialogue: 0,0:06:23.63,0:06:26.55,Default,,0,0,0,,Енді әкеңнің өкініші үшін кек алатын кез!
Dialogue: 0,0:06:27.47,0:06:29.01,Default,,0,0,0,,Дүние қараңғы
Dialogue: 0,0:06:29.51,0:06:32.76,Default,,0,0,0,,Жарығым ұрланды... мәңгілікке.
Dialogue: 0,0:06:32.85,0:06:36.52,Default,,0,0,0,,Қараңғыда мен қанның түсін ғана көремін
Dialogue: 0,0:06:37.02,0:06:38.73,Default,,0,0,0,,Сондықтан оны толтырыңыз.
Dialogue: 0,0:06:38.81,0:06:42.40,Default,,0,0,0,,Қанмен, қанмен, қанмен, қанмен!
Dialogue: 0,0:06:46.32,0:06:48.90,Default,,0,0,0,,Оны қанмен боя
Dialogue: 0,0:06:58.04,0:07:00.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:01.96,0:07:04.42,Default,,0,0,0,,Сіз Ланкастерсіз бе?
Dialogue: 0,0:07:06.00,0:07:09.47,Default,,0,0,0,,Маған көмектесіңізші... Мен қозғала алмаймын.
Dialogue: 0,0:07:10.30,0:07:13.85,Default,,0,0,0,,Өтінемін... мені отбасым күтіп отыр.
Dialogue: 0,0:07:13.93,0:07:15.43,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:17.47,0:07:20.69,Default,,0,0,0,,Мен... сенің жүзіңді көрмеймін.
Dialogue: 0,0:07:20.77,0:07:21.85,Default,,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:07:22.98,0:07:26.27,Default,,0,0,0,,Сіз оны бояй аласыз ба? әлем
Dialogue: 0,0:07:26.90,0:07:29.99,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз оны міндетті түрде көресіз.
Dialogue: 0,0:07:52.76,0:07:55.97,Default,,0,0,0,,Ах... енді жарық болмаса да
Dialogue: 0,0:07:56.47,0:08:00.56,Default,,0,0,0,,Мен көргеннің бәрі... дүние боялған
Dialogue: 0,0:08:02.77,0:08:05.65,Default,,0,0,0,,Енді қараңғы емес
Dialogue: 0,0:08:18.33,0:08:20.33,Default,,0,0,0,,Ей, мына жігіт дем алып жатыр.
Dialogue: 0,0:08:20.41,0:08:22.16,Default,,0,0,0,,Онда мені өлтір.
Dialogue: 0,0:08:22.66,0:08:24.12,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:08:24.21,0:08:26.21,Default,,0,0,0,,Раушанның түсі қанға тым боялған...
Dialogue: 0,0:08:26.29,0:08:27.29,Default,,0,0,0,,Бір минут күтіңіз (Йорк солдаты А) А...
Dialogue: 0,0:08:28.38,0:08:29.71,Default,,0,0,0,,Ол менің танысым.
Dialogue: 0,0:08:35.59,0:08:38.43,Default,,0,0,0,,Ал... сен бұл мен екенімді білдің.
Dialogue: 0,0:08:39.26,0:08:41.85,Default,,0,0,0,,Мен сені туылғаннан бері білемін.
Dialogue: 0,0:08:42.52,0:08:44.98,Default,,0,0,0,,Ричардтың қасында болу
Dialogue: 0,0:08:45.52,0:08:49.40,Default,,0,0,0,,Бұл менің өмірдегі рөлім.
Dialogue: 0,0:08:50.36,0:08:52.94,Default,,0,0,0,,Адалдықпен байланысты емес
Dialogue: 0,0:08:53.49,0:08:56.95,Default,,0,0,0,,Әкесі енді жоқ.
Dialogue: 0,0:08:58.66,0:09:01.91,Default,,0,0,0,,Сондықтан мен жұмысты тастап, оны іздеп келдім.
Dialogue: 0,0:09:02.45,0:09:06.33,Default,,0,0,0,,Сені анаңның үйіне жіберу үшін
Dialogue: 0,0:09:07.00,0:09:12.05,Default,,0,0,0,,Сізді қазір анаңызбен және Джорджпен бірге эвакуациялап жатырсыз.
Dialogue: 0,0:09:12.55,0:09:14.30,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:09:14.84,0:09:17.93,Default,,0,0,0,,Бұл сіздің әкеңізге ұнайтынына сенімдімін.
Dialogue: 0,0:09:22.35,0:09:24.43,Default,,0,0,0,,Жақында көріне бастауды жоспарлап жүрмін
Dialogue: 0,0:09:25.27,0:09:28.60,Default,,0,0,0,,Бұл сіздің әкеңізге ұнайтынына сенімдімін.
Dialogue: 0,0:09:30.02,0:09:33.36,Default,,0,0,0,,Мен көлеңкемін... жарықтың артындағы қараңғылық
Dialogue: 0,0:09:33.86,0:09:37.24,Default,,0,0,0,,Енді мен Король деп жариялаймын
Dialogue: 0,0:09:37.32,0:09:40.45,Default,,0,0,0,,Біз жеңдік! Біз жеңдік!
Dialogue: 0,0:09:40.53,0:09:42.70,Default,,0,0,0,,Жасасын король Эдвард!
Dialogue: 0,0:09:45.37,0:09:47.08,Default,,0,0,0,,Ең жоғарғы деңгейдегі ессіз ғалым
Dialogue: 0,0:09:48.12,0:09:51.88,Default,,0,0,0,,Қараңғыда да жалғыз жүру
Dialogue: 0,0:09:53.55,0:09:56.13,Default,,0,0,0,,Себебі мен техниканы таптым
Dialogue: 0,0:10:04.18,0:10:07.10,Default,,0,0,0,,(қылыштың тербелген дыбысы)
Dialogue: 0,0:10:25.29,0:10:27.54,Default,,0,0,0,,Ричард, сен қанша уақыт дайындалдың?
Dialogue: 0,0:10:29.62,0:10:32.54,Default,,0,0,0,,Кешіріңіз, Джордж аға.
Dialogue: 0,0:10:33.04,0:10:34.21,Default,,0,0,0,,Ричард…
Dialogue: 0,0:10:34.71,0:10:37.72,Default,,0,0,0,,Мен қызметшіме көмектесуге рұқсат бермеймін, сондықтан мен өз орнымның шетінде боламын.
Dialogue: 0,0:10:38.22,0:10:40.68,Default,,0,0,0,,Бұл Кейтсби жанында болған кезде болған жоқ.
Dialogue: 0,0:10:43.30,0:10:46.85,Default,,0,0,0,,Ол енді Йорк отбасының мүшесі емес.
Dialogue: 0,0:10:47.35,0:10:49.35,Default,,0,0,0,,Бұл екі жыл бұрын болды.
Dialogue: 0,0:10:49.85,0:10:50.60,Default,,0,0,0,,О
Dialogue: 0,0:10:51.10,0:10:53.36,Default,,0,0,0,,Бұл енді лорд Хастингстің орны болды ма?
Dialogue: 0,0:10:55.15,0:10:56.94,Default,,0,0,0,,(Дворяндардың таңданыс дауыстары)
Dialogue: 0,0:10:57.03,0:10:58.99,Default,,0,0,0,,Король Эдвард осында.
Dialogue: 0,0:10:59.74,0:11:02.32,Default,,0,0,0,,Қанша көрсем де сұлу патшасың.
Dialogue: 0,0:11:02.41,0:11:06.49,Default,,0,0,0,,Патша болу үшін туғаны рас.
Dialogue: 0,0:11:07.66,0:11:10.33,Default,,0,0,0,,Келесі есік - «Кингмейкер» Уорвик графы
Dialogue: 0,0:11:10.83,0:11:14.04,Default,,0,0,0,,Ол болмаса, Йорк жеңіске жетпес еді.
Dialogue: 0,0:11:14.13,0:11:18.38,Default,,0,0,0,,Джордж да, Ричард та жақсы.
Dialogue: 0,0:11:18.46,0:11:21.55,Default,,0,0,0,,Бірақ Ричард аздап қорқынышты, солай емес пе?
Dialogue: 0,0:11:21.63,0:11:23.01,Default,,0,0,0,,Жақындау қиын...
Dialogue: 0,0:11:23.09,0:11:26.31,Default,,0,0,0,,Жеңіс тәжін алғанымнан бері
Dialogue: 0,0:11:26.39,0:11:29.98,Default,,0,0,0,,Зақымдалған сауыт жай ғана әшекейге айналды.
Dialogue: 0,0:11:30.81,0:11:32.48,Default,,0,0,0,,Джордж Ричард
Dialogue: 0,0:11:33.06,0:11:37.15,Default,,0,0,0,,Ричард, сіз қызметшіңізді бөлмеден құлыптап жатқан сияқтысыз.
Dialogue: 0,0:11:37.65,0:11:39.90,Default,,0,0,0,,Сіз қазір Глостер герцогысыз.
Dialogue: 0,0:11:40.40,0:11:43.70,Default,,0,0,0,,Қол астындағылардың сенімінсіз биікке көтеріле алмайсыз.
Dialogue: 0,0:11:44.20,0:11:45.20,Default,,0,0,0,,Мырза Президент, қазіргі L, шатастырмау үшін,
Dialogue: 0,0:11:45.83,0:11:49.29,Default,,0,0,0,,Менің бейшара денемді адамдар көретініне ұяламын.
Dialogue: 0,0:11:49.95,0:11:54.42,Default,,0,0,0,,Ол сөзсіз арық, терісі қыздікіндей тегіс.
Dialogue: 0,0:11:55.21,0:11:57.17,Default,,0,0,0,,Бірақ ұялмаңыз
Dialogue: 0,0:11:57.25,0:12:00.01,Default,,0,0,0,,Адамның қадір-қасиеті мұндай нәрселермен анықталмайды.
Dialogue: 0,0:12:00.88,0:12:03.22,Default,,0,0,0,,Сонымен, мұны не анықтайды?
Dialogue: 0,0:12:05.26,0:12:06.43,Default,,0,0,0,,Әйел
Dialogue: 0,0:12:06.51,0:12:10.06,Default,,0,0,0,,Бауырлар, сізді қызықтыратын әйелдер бар ма?
Dialogue: 0,0:12:10.56,0:12:12.94,Default,,0,0,0,,Олардың бәрі әдемі әйелдер емес пе?
Dialogue: 0,0:12:13.02,0:12:16.15,Default,,0,0,0,,А...Ағаң сенің жарың болса жақсы емес пе?
Dialogue: 0,0:12:16.23,0:12:20.32,Default,,0,0,0,,Менің Францияда серіктесім бар.
Dialogue: 0,0:12:20.82,0:12:24.03,Default,,0,0,0,,Уорвик ресми түрде жүріп жатыр.
Dialogue: 0,0:12:25.74,0:12:28.95,Default,,0,0,0,,Бауырларым, бұл патшаның бұйрығы.
Dialogue: 0,0:12:29.03,0:12:32.83,Default,,0,0,0,,Осы жердегі қыздардың арасынан бүгінге серігіңізді таңдаңыз.
Dialogue: 0,0:12:32.91,0:12:34.87,Default,,0,0,0,,Не істеу керек? Ричард
Dialogue: 0,0:12:34.96,0:12:37.08,Default,,0,0,0,,Сен де мұндай нәрсеге шебер емессің.
Dialogue: 0,0:12:37.17,0:12:39.00,Default,,0,0,0,,Тек осы жағдай үшін
Dialogue: 0,0:12:39.09,0:12:41.84,Default,,0,0,0,,Таңдасаң, Мәртебелі риза болады.
Dialogue: 0,0:12:42.88,0:12:48.18,Default,,0,0,0,,Сіз... әкеңіз өмірден өткеннен кейін біраз өзгердіңіз.
Dialogue: 0,0:12:48.85,0:12:50.89,Default,,0,0,0,,Сіз енді бала емессіз
Dialogue: 0,0:12:51.72,0:12:53.14,Default,,0,0,0,,Әй, біз де
Dialogue: 0,0:12:53.23,0:12:54.48,Default,,0,0,0,,Сайысқа қатысайық.
Dialogue: 0,0:12:54.56,0:12:58.52,Default,,0,0,0,,Мен... менде бәрі жақсы. Мен еркектерге жақсы емеспін.
Dialogue: 0,0:12:59.02,0:13:01.11,Default,,0,0,0,,Әпкеңнің уақыты келді.
Dialogue: 0,0:13:01.19,0:13:04.78,Default,,0,0,0,,Әпкеңнің ол кісі туралы көптен бері айтып жүргенін білемін...
Dialogue: 0,0:13:04.86,0:13:07.82,Default,,0,0,0,,Сондықтан да жақсы! Жалғыз барғаныңыз жақсы емес пе?
Dialogue: 0,0:13:08.45,0:13:09.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:09.24,0:13:10.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:10.87,0:13:11.62,Default,,0,0,0,,О.
Dialogue: 0,0:13:13.91,0:13:15.21,Default,,0,0,0,,Энн Невилл…
Dialogue: 0,0:13:15.29,0:13:17.04,Default,,0,0,0,,Құрметті Ричард...
Dialogue: 0,0:13:17.12,0:13:19.08,Default,,0,0,0,,А, а... бұл.
Dialogue: 0,0:13:19.59,0:13:22.42,Default,,0,0,0,,Сол уақыт үшін кешіріңіз! Мен әрқашан кешірім сұрағым келді
Dialogue: 0,0:13:23.51,0:13:24.51,Default,,0,0,0,,қорқынышты нәрсе жасаңыз
Dialogue: 0,0:13:24.59,0:13:26.63,Default,,0,0,0,,Мүмкін мен айтқан шығармын...
Dialogue: 0,0:13:26.72,0:13:28.39,Default,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:13:29.39,0:13:32.52,Default,,0,0,0,,Негізі мен сенімен біргемін
Dialogue: 0,0:13:32.60,0:13:34.73,Default,,0,0,0,,Бұл... бұл...
Dialogue: 0,0:13:35.64,0:13:37.10,Default,,0,0,0,,Достарыңызға...
Dialogue: 0,0:13:40.69,0:13:42.32,Default,,0,0,0,,Қол
Dialogue: 0,0:13:46.61,0:13:48.82,Default,,0,0,0,,Әлгі жігіт мен білмегенше!
Dialogue: 0,0:13:48.91,0:13:53.91,Default,,0,0,0,,Ричард әпкеңмен болса, Джордж менімен бірге.
Dialogue: 0,0:14:04.34,0:14:07.68,Default,,0,0,0,,Уорвик Мен солай ойладым.
Dialogue: 0,0:14:07.76,0:14:10.68,Default,,0,0,0,,Қыздарың өте әдемі болып кетті.
Dialogue: 0,0:14:11.18,0:14:13.31,Default,,0,0,0,,Мен інілерімнен қызғанамын.
Dialogue: 0,0:14:13.81,0:14:17.94,Default,,0,0,0,,Менің Франциядағы ханшайымым да өте әдемі болса керек.
Dialogue: 0,0:14:18.44,0:14:20.10,Default,,0,0,0,,Бәрін бізге қалдыр
Dialogue: 0,0:14:21.06,0:14:25.28,Default,,0,0,0,,Мен сенің рұқсатыңсыз ештеңе істемеймін.
Dialogue: 0,0:14:25.78,0:14:28.99,Default,,0,0,0,,Бұл тақ екеуіңдікі.
Dialogue: 0,0:14:29.07,0:14:30.32,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:14:31.62,0:14:34.62,Default,,0,0,0,,Мәртебелі патша, сізден бір жақсылығым бар.
Dialogue: 0,0:14:35.12,0:14:38.04,Default,,0,0,0,,Мен банкеттің ортасындамын. Өтініш жазып жатсаңыз, мен кеңседемін...
Dialogue: 0,0:14:38.12,0:14:41.13,Default,,0,0,0,,Мен мұны соңғы екі жылда талай рет сұрадым.
Dialogue: 0,0:14:41.63,0:14:44.55,Default,,0,0,0,,Алайда мен сіздің рұқсатыңызды ала алмадым, сондықтан...
Dialogue: 0,0:14:45.13,0:14:49.17,Default,,0,0,0,,Оның марқұм күйеуінің алдыңғы шайқаста басып алынған жері.
Dialogue: 0,0:14:49.26,0:14:50.97,Default,,0,0,0,,Мен орнына бірдеңе алғым келеді.
Dialogue: 0,0:14:51.05,0:14:54.35,Default,,0,0,0,,Қабылданды...
Dialogue: 0,0:14:54.43,0:14:56.93,Default,,0,0,0,,Сіздің күйеуіңіз ланкастриялық болған.
Dialogue: 0,0:14:57.43,0:15:00.19,Default,,0,0,0,,Қызықты, батыл әйел.
Dialogue: 0,0:15:01.44,0:15:02.15,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:15:02.73,0:15:03.61,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:15:06.82,0:15:08.61,Default,,0,0,0,,Элизабет Вудвилл⸺\NМенің атым
Dialogue: 0,0:15:08.69,0:15:09.65,Default,,0,0,0,,...
Dialogue: 0,0:15:14.66,0:15:17.54,Default,,0,0,0,,Жарайды, мен шағымды қабылдаймын.
Dialogue: 0,0:15:17.62,0:15:21.50,Default,,0,0,0,,Бірақ қазір банкет, сондықтан түс.
Dialogue: 0,0:15:27.09,0:15:32.01,Default,,0,0,0,,Мәртебелі, мен жоғарыда айтқан француз ханшайымымен болған келісімге қатысты...
Dialogue: 0,0:15:34.18,0:15:36.93,Default,,0,0,0,,Элизабет Вудвилл
Dialogue: 0,0:15:38.10,0:15:39.02,Default,,0,0,0,,Бір күні, бір жерде...
Dialogue: 0,0:15:39.10,0:15:40.39,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:15:40.48,0:15:41.44,Default,,0,0,0,,Егер сіз сонда болсаңыз, шығыңыз.
Dialogue: 0,0:15:42.39,0:15:45.19,Default,,0,0,0,,Бала кезімде секіруші едім.
Dialogue: 0,0:15:45.69,0:15:48.65,Default,,0,0,0,,Мен әбден үйреніп қалдым, хаха...
Dialogue: 0,0:15:48.73,0:15:50.19,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:50.95,0:15:51.99,Default,,0,0,0,,Бұл махаббат болды ма?
Dialogue: 0,0:15:53.36,0:15:54.99,Default,,0,0,0,,Әдемі Элизабет?
Dialogue: 0,0:15:55.07,0:15:55.99,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:15:56.08,0:15:57.58,Default,,0,0,0,,Себебі сен қызықсың, солай ма?
Dialogue: 0,0:15:58.29,0:15:59.91,Default,,0,0,0,,Сүйкімді Анна
Dialogue: 0,0:16:00.54,0:16:02.08,Default,,0,0,0,,Мен ғашық емеспін
Dialogue: 0,0:16:02.16,0:16:04.54,Default,,0,0,0,,Өйткені сен мені бәрібір сүйе алмайсың
Dialogue: 0,0:16:06.92,0:16:08.30,Default,,0,0,0,,Бұл дене
Dialogue: 0,0:16:08.38,0:16:09.42,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:09.51,0:16:10.76,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:16:11.63,0:16:15.05,Default,,0,0,0,,Себебі мен сағынатын басқа біреу бар
Dialogue: 0,0:16:15.55,0:16:19.60,Default,,0,0,0,,Ричард, сен еркек те, әйел де емессің.
Dialogue: 0,0:16:19.68,0:16:23.23,Default,,0,0,0,,Бірақ олар ерлер де, әйелдер де.
Dialogue: 0,0:16:23.94,0:16:24.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:27.69,0:16:30.73,Default,,0,0,0,,Мен ешкімді жақсы көрмеймін
Dialogue: 0,0:16:31.57,0:16:32.49,Default,,0,0,0,,Ешкім...
Dialogue: 0,0:16:33.86,0:16:35.11,Default,,0,0,0,,Құрметті Маргарет!
Dialogue: 0,0:16:35.20,0:16:38.41,Default,,0,0,0,,Лорд Генридің жүрегі ақыры қайта оралды!
Dialogue: 0,0:16:41.25,0:16:44.12,Default,,0,0,0,,Мынау қайда... Мынау қайда?
Dialogue: 0,0:16:45.37,0:16:47.38,Default,,0,0,0,,Шотландия.
Dialogue: 0,0:16:47.46,0:16:49.84,Default,,0,0,0,,Қатыгез Йоркшылар тақты басып алды.
Dialogue: 0,0:16:50.42,0:16:55.47,Default,,0,0,0,,Біз, заңды патша әулеті, осылайша шет елге айдалды.
Dialogue: 0,0:16:56.59,0:16:58.55,Default,,0,0,0,,Соғыс аяқталды...
Dialogue: 0,0:16:58.64,0:17:01.52,Default,,0,0,0,,О, қандай өкінішті
Dialogue: 0,0:17:03.68,0:17:06.19,Default,,0,0,0,,Мен енді патша емеспін
Dialogue: 0,0:17:07.02,0:17:09.94,Default,,0,0,0,,Мен босмын... Мен боспын!
Dialogue: 0,0:17:11.90,0:17:14.40,Default,,0,0,0,,Не болды? Үлкен аға
Dialogue: 0,0:17:14.49,0:17:15.95,Default,,0,0,0,,Аңға шығайық
Dialogue: 0,0:17:16.03,0:17:18.91,Default,,0,0,0,,Анда-санда тым үлкен емес аңға шығу жақсы.
Dialogue: 0,0:17:19.58,0:17:21.33,Default,,0,0,0,,Қараңдаршы, бауырларым.
Dialogue: 0,0:17:21.83,0:17:25.96,Default,,0,0,0,,Сол күні мен күнді қарлы майдан даласында көрдім
Dialogue: 0,0:17:26.04,0:17:30.34,Default,,0,0,0,,Бір күн үшке бөлініп, одан кейін бір күнге қайтады.
Dialogue: 0,0:17:31.09,0:17:33.96,Default,,0,0,0,,Үш күн біздің үш ағамыз.
Dialogue: 0,0:17:34.47,0:17:37.84,Default,,0,0,0,,Осы елді басқару үшін үшеуміз күшімізді біріктіруіміз керек.
Dialogue: 0,0:17:37.93,0:17:39.80,Default,,0,0,0,,Құдайдың аяны болуы керек
Dialogue: 0,0:17:40.39,0:17:43.81,Default,,0,0,0,,Күннен қорғалған Йорктегі үш ағайынды
Dialogue: 0,0:17:44.31,0:17:48.60,Default,,0,0,0,,Осы күн астында аң аулау арқылы байланысымызды тереңдетейік.
Dialogue: 0,0:17:48.69,0:17:52.82,Default,,0,0,0,,Енді ең үлкенін кім жеңе алатынын көретін кез келді!
Dialogue: 0,0:17:53.61,0:17:55.53,Default,,0,0,0,,Көңіл-күйіңіз жақсы.
Dialogue: 0,0:18:09.88,0:18:11.29,Default,,0,0,0,,Мен сені жақын арада көргім келеді
Dialogue: 0,0:18:15.46,0:18:17.88,Default,,0,0,0,,Сіз хатты оқыдыңыз ба?
Dialogue: 0,0:18:18.93,0:18:19.80,Default,,0,0,0,,Элизабет
Dialogue: 0,0:18:21.51,0:18:25.52,Default,,0,0,0,,Иә... Күйеуімнің аумағын қайтарып берерсіз деп үміттенемін.
Dialogue: 0,0:18:25.60,0:18:28.48,Default,,0,0,0,,Мен сенің махаббатыңды қалаймын
Dialogue: 0,0:18:28.98,0:18:30.81,Default,,0,0,0,,Осылай жазу керек еді.
Dialogue: 0,0:18:30.90,0:18:34.27,Default,,0,0,0,,Мәртебелі, мен осы елдің азаматымын.
Dialogue: 0,0:18:34.36,0:18:36.99,Default,,0,0,0,,Әу бастан мен ұлы мәртебеліге махаббатымды ұсынамын.
Dialogue: 0,0:18:37.07,0:18:40.91,Default,,0,0,0,,Элизабет Менің қалағаным – махаббат жемісі.
Dialogue: 0,0:18:41.74,0:18:43.03,Default,,0,0,0,,Түсінікті болу үшін...
Dialogue: 0,0:18:45.54,0:18:46.87,Default,,0,0,0,,Мен сенімен ұйықтағым келеді
Dialogue: 0,0:18:47.91,0:18:52.29,Default,,0,0,0,,Олай болса мен түрмеде ұйықтаймын, мәртебелі.
Dialogue: 0,0:18:56.63,0:18:59.76,Default,,0,0,0,,Мисао үшін патшаны өлтірер ме едіңіз?
Dialogue: 0,0:19:02.34,0:19:02.93,Default,,0,0,0,,Иә
Dialogue: 0,0:19:04.47,0:19:08.93,Default,,0,0,0,,Сен мені бірінші болып қабылдамады, Элизабет.
Dialogue: 0,0:19:09.43,0:19:12.06,Default,,0,0,0,,Мен оны одан да көп көргім келеді.
Dialogue: 0,0:19:14.36,0:19:19.32,Default,,0,0,0,,Мәртебелі, мен патшайым болу үшін тым төменмін.
Dialogue: 0,0:19:19.82,0:19:23.24,Default,,0,0,0,,Мазалайтындай жағдайым жоқ.
Dialogue: 0,0:19:23.32,0:19:28.45,Default,,0,0,0,,Ханшайым? Ол өзінің сымбатты келбетіне сай келмейтін батыл адам.
Dialogue: 0,0:19:28.54,0:19:30.96,Default,,0,0,0,,Аа... Қызық
Dialogue: 0,0:19:31.46,0:19:34.96,Default,,0,0,0,,Менің ханшайымым боласың ба? Элизабет
Dialogue: 0,0:19:37.13,0:19:41.30,Default,,0,0,0,,Мәртебелін жақсы көретіндер мұны кешірмейді.
Dialogue: 0,0:19:41.38,0:19:45.97,Default,,0,0,0,,Элизабет, мен жалғыз сенсің.
Dialogue: 0,0:19:46.47,0:19:48.35,Default,,0,0,0,,Мен сенің жауабыңды енді тыңдамаймын.
Dialogue: 0,0:19:51.27,0:19:54.19,Default,,0,0,0,,Мен, патша, шештім.
Dialogue: 0,0:19:59.94,0:20:02.99,Default,,0,0,0,,Кенеттен аң аулаудың себебі осы ма...
Dialogue: 0,0:20:08.45,0:20:09.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:14.46,0:20:15.58,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:20:17.00,0:20:20.30,Default,,0,0,0,,Бұл біз үшін ғана құпия.
Dialogue: 0,0:20:22.09,0:20:25.34,Default,,0,0,0,,Ричард Менде ол бар.
Dialogue: 0,0:20:26.64,0:20:28.72,Default,,0,0,0,,Мен оны патшайым етемін деп шештім.
Dialogue: 0,0:20:32.23,0:20:33.89,Default,,0,0,0,,Бұл қандай хат?
Dialogue: 0,0:20:33.98,0:20:35.65,Default,,0,0,0,,Король Эдвард менің әпкемнің күйеуін өлтірді...
Dialogue: 0,0:20:35.73,0:20:36.69,Default,,0,0,0,,Энтони
Dialogue: 0,0:20:39.15,0:20:40.73,Default,,0,0,0,,Сіз бұл не екенін білесіз бе?
Dialogue: 0,0:20:42.36,0:20:44.11,Default,,0,0,0,,Күйеуінің естелігі
Dialogue: 0,0:20:45.28,0:20:49.08,Default,,0,0,0,,Мен әлі де жақсы көретін бір ғана адам бар
Dialogue: 0,0:20:49.95,0:20:52.04,Default,,0,0,0,,Сондықтан мен кек аламын
Dialogue: 0,0:20:52.70,0:20:56.12,Default,,0,0,0,,Патшайым болыңыз және патшаны өз қалауыңыз бойынша басқарыңыз
Dialogue: 0,0:20:56.21,0:21:01.38,Default,,0,0,0,,Біз күйеуімді өлтірген Йорк корольдік отбасын өзіміздікі етеміз.
Dialogue: 0,0:21:04.26,0:21:07.80,Default,,0,0,0,,Егер Эдвард француз ханшайымына үйленсе
Dialogue: 0,0:21:07.89,0:21:10.64,Default,,0,0,0,,Йорк корольдік отбасының күші одан әрі артады.
Dialogue: 0,0:21:11.22,0:21:15.27,Default,,0,0,0,,Соңғы уақытта ұлыңыз сізге көбірек ұқсай бастады.
Dialogue: 0,0:21:15.89,0:21:17.69,Default,,0,0,0,,Кейде менде иллюзиялар болады.
Dialogue: 0,0:21:18.86,0:21:19.77,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:21:21.73,0:21:25.78,Default,,0,0,0,,Мен сенің тәжіңді міндетті түрде қорғаймын.
Dialogue: 0,0:21:27.07,0:21:29.91,Default,,0,0,0,,Жау кім болса да
Dialogue: 0,0:21:42.96,0:21:44.72,Default,,0,0,0,,Эй, сен мұны естідің бе?
Dialogue: 0,0:21:44.80,0:21:48.76,Default,,0,0,0,,Король Эдвард осында аң аулауға келеді дейді.
Dialogue: 0,0:21:48.84,0:21:49.97,Default,,0,0,0,,Инкогнито?
Dialogue: 0,0:21:50.05,0:21:53.47,Default,,0,0,0,,Сен сол Эдвард корольсың.
Dialogue: 0,0:21:53.56,0:21:55.98,Default,,0,0,0,,«Патша келгенде, әйеліңіз бен қызыңызды жасырыңыз».
Dialogue: 0,0:21:56.48,0:21:57.27,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:21:57.35,0:22:00.90,Default,,0,0,0,,Балалар... біреуді іздеп жүрсіңдер.
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.90,0:23:30.90,Default,,0,0,0,,～♪
