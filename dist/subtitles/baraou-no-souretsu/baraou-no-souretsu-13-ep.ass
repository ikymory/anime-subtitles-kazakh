Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.46,0:00:07.50,Default,,0,0,0,,Мен жай ғана менмін
Dialogue: 0,0:00:08.00,0:00:09.96,Default,,0,0,0,,Сонда бұл шайтан.
Dialogue: 0,0:00:10.46,0:00:13.88,Default,,0,0,0,,Ойыңызды денеңізге сәйкес келетін пішінге айналдырыңыз!
Dialogue: 0,0:00:14.72,0:00:17.05,Default,,0,0,0,,Менде жанашырлық та, қорқыныш та, махаббат та жоқ,
Dialogue: 0,0:00:17.14,0:00:21.81,Default,,0,0,0,,Біздің жойылуымызды қалайтын әрбір адамды тозаққа жібереміз.
Dialogue: 0,0:00:21.89,0:00:24.02,Default,,0,0,0,,Қараңдар! бұл біздің күн
Dialogue: 0,0:00:24.10,0:00:26.52,Default,,0,0,0,,Мұңды маусым аяқталды!
Dialogue: 0,0:00:31.36,0:00:32.53,Default,,0,0,0,,Әй, қалай?
Dialogue: 0,0:00:33.15,0:00:35.20,Default,,0,0,0,,Саған жарасады, Элизабет.
Dialogue: 0,0:00:35.28,0:00:38.66,Default,,0,0,0,,Қазірдің өзінде! Мені анаңның атымен атама
Dialogue: 0,0:00:38.74,0:00:40.08,Default,,0,0,0,,Мені «Бет» деп атаңыз
Dialogue: 0,0:00:40.62,0:00:42.25,Default,,0,0,0,,Бұл өте егжей-тегжейлі.
Dialogue: 0,0:00:42.75,0:00:45.17,Default,,0,0,0,,Қызық, сізді қызықтыратын джентльмен де осында ма?
Dialogue: 0,0:00:45.25,0:00:46.29,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:00:47.04,0:00:47.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:49.79,0:00:52.46,Default,,0,0,0,,Амансың ба? ханым
Dialogue: 0,0:00:54.17,0:00:55.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:55.26,0:00:57.22,Default,,0,0,0,,Ричард ағай!
Dialogue: 0,0:00:57.72,0:01:01.81,Default,,0,0,0,,Бет, мен сені көптен бері көрмедім, сен керемет болып кеттің.
Dialogue: 0,0:01:01.89,0:01:02.64,Default,,0,0,0,,Энн!
Dialogue: 0,0:01:02.72,0:01:05.23,Default,,0,0,0,,Ричардқа Лондонға жиі келетінін айт.
Dialogue: 0,0:01:05.31,0:01:06.52,Default,,0,0,0,,Барлығы осында
Dialogue: 0,0:01:06.60,0:01:08.65,Default,,0,0,0,,Мереке басталғалы жатыр.
Dialogue: 0,0:01:09.36,0:01:13.07,Default,,0,0,0,,Бүгін де... шу басталады
Dialogue: 0,0:01:13.15,0:01:17.70,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,0:01:17.78,0:01:21.41,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:01:24.54,0:01:26.58,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:26.66,0:01:28.75,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:29.25,0:01:35.22,Default,,0,0,0,,Раушан эмблемасы бар патша әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:35.72,0:01:40.60,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:44.52,0:01:46.52,Default,,0,0,0,,♪～
Dialogue: 0,0:03:10.85,0:03:12.85,Default,,0,0,0,,～♪
Dialogue: 0,0:03:14.48,0:03:17.57,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:03:17.65,0:03:20.11,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:03:20.19,0:03:22.57,Default,,0,0,0,,Жазды жақсы өткізейік
Dialogue: 0,0:03:23.07,0:03:25.37,Default,,0,0,0,,Жасасын король Эдвард IV!
Dialogue: 0,0:03:25.95,0:03:29.08,Default,,0,0,0,,Жасасын король Эдвард IV!
Dialogue: 0,0:03:31.12,0:03:33.46,Default,,0,0,0,,Әке, бұл айдаһар.
Dialogue: 0,0:03:33.54,0:03:36.17,Default,,0,0,0,,Өлтір, өлтір! әулие Джордж
Dialogue: 0,0:03:36.25,0:03:38.46,Default,,0,0,0,,Өлтір! Өлтір, өлтір!
Dialogue: 0,0:03:38.55,0:03:40.72,Default,,0,0,0,,Бірақ сюжет... (Джордж) Жолдан кет!
Dialogue: 0,0:03:43.13,0:03:46.22,Default,,0,0,0,,Джордж Джордж! Эй!
Dialogue: 0,0:03:46.97,0:03:48.81,Default,,0,0,0,,Жоғары мәртебелі тақ мұрагері
Dialogue: 0,0:03:48.89,0:03:50.93,Default,,0,0,0,,Джордж герцог Кларенс
Dialogue: 0,0:03:51.02,0:03:52.10,Default,,0,0,0,,Зұлым айдаһар
Dialogue: 0,0:03:52.19,0:03:53.73,Default,,0,0,0,,Мен мұны істедім!
Dialogue: 0,0:03:54.52,0:03:57.11,Default,,0,0,0,,Джордж, сен массың ба? Қылышыңды таста!
Dialogue: 0,0:03:58.98,0:04:03.28,Default,,0,0,0,,Сіз өз билігіңіздің маған берілгеніне қатты наразы сияқтысыз.
Dialogue: 0,0:04:03.36,0:04:04.86,Default,,0,0,0,,Шулы...
Dialogue: 0,0:04:06.57,0:04:08.33,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:04:12.83,0:04:13.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:15.38,0:04:17.88,Default,,0,0,0,,Ричард, жағдайыңыз қалай?
Dialogue: 0,0:04:17.96,0:04:18.80,Default,,0,0,0,,Иә
Dialogue: 0,0:04:18.88,0:04:23.17,Default,,0,0,0,,Әйеліңіздің жағдайы қалай? менің әйелім де ойлайды
Dialogue: 0,0:04:23.26,0:04:25.68,Default,,0,0,0,,Сізге рахмет, істер жақсы жүріп жатыр.
Dialogue: 0,0:04:25.76,0:04:29.06,Default,,0,0,0,,Бір құдай інісіне жерін жоғалтып алғанын аяды.
Dialogue: 0,0:04:29.14,0:04:31.98,Default,,0,0,0,,Маған орнына бала берген сияқты.
Dialogue: 0,0:04:32.06,0:04:36.31,Default,,0,0,0,,Бірақ сенің жерің ешқашан екінші бала көтермейді.
Dialogue: 0,0:04:36.40,0:04:38.90,Default,,0,0,0,,Аннаны аямайсың ба?
Dialogue: 0,0:04:38.98,0:04:42.86,Default,,0,0,0,,Олар үйленгелі бері бір рет төсек бөліспеген деген қауесет бар.
Dialogue: 0,0:04:42.94,0:04:45.95,Default,,0,0,0,,Ол кімнің жалғыз ұлы? Олардың ұқсастығын тексеріңіз...
Dialogue: 0,0:04:46.03,0:04:47.53,Default,,0,0,0,,Мен аздап...
Dialogue: 0,0:04:47.62,0:04:48.28,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:48.37,0:04:49.66,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:50.29,0:04:53.87,Default,,0,0,0,,Барлығы оны асыға күтеді! Тағдыр тортын көру үшін мына жерді басыңыз
Dialogue: 0,0:04:53.96,0:04:56.79,Default,,0,0,0,,Қолыңызды матаның астына қойып, тортты алыңыз.
Dialogue: 0,0:04:56.87,0:04:59.59,Default,,0,0,0,,Торт түрінде болашақты болжау
Dialogue: 0,0:04:59.67,0:05:02.46,Default,,0,0,0,,Сәулешілік не айтады? Бұл бос сөз.
Dialogue: 0,0:05:02.55,0:05:04.38,Default,,0,0,0,,Сәлем! Тезірек шарап ішіңіз!
Dialogue: 0,0:05:04.88,0:05:07.47,Default,,0,0,0,,Ахахха мен мұндамын
Dialogue: 0,0:05:07.55,0:05:08.26,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:09.14,0:05:11.89,Default,,0,0,0,,Мен Джорджмен осы мәселе бойынша келісемін.
Dialogue: 0,0:05:14.81,0:05:16.06,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:16.64,0:05:19.11,Default,,0,0,0,,Бұл қандай пішінге ұқсайды?
Dialogue: 0,0:05:19.19,0:05:21.77,Default,,0,0,0,,Хмм... не? Яғни
Dialogue: 0,0:05:21.86,0:05:24.28,Default,,0,0,0,,Жарайды, бұл таға!
Dialogue: 0,0:05:24.36,0:05:25.86,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:25.95,0:05:29.12,Default,,0,0,0,,Әй, түсіндім, әке, бұл «Г» әрпі!
Dialogue: 0,0:05:29.20,0:05:30.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:31.33,0:05:33.12,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:05:33.20,0:05:36.04,Default,,0,0,0,,Жоқ, бұл баланың істегеніне көбірек ұқсайды...
Dialogue: 0,0:05:36.71,0:05:40.46,Default,,0,0,0,,Хастингс Сол ханымға жаңа көйлек.
Dialogue: 0,0:05:40.54,0:05:41.34,Default,,0,0,0,,Иә
Dialogue: 0,0:05:41.84,0:05:43.05,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:05:45.72,0:05:46.55,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:52.06,0:05:53.81,Default,,0,0,0,,Глостер герцогы…
Dialogue: 0,0:05:54.31,0:05:56.89,Default,,0,0,0,,Ричард Плантагенет
Dialogue: 0,0:05:57.39,0:05:58.69,Default,,0,0,0,,Қанды «Г»?
Dialogue: 0,0:05:59.27,0:06:02.69,Default,,0,0,0,,Букингем Бұл менің болашағым емес.
Dialogue: 0,0:06:03.19,0:06:05.15,Default,,0,0,0,,Олай болса болашағыңды таңда
Dialogue: 0,0:06:05.65,0:06:07.61,Default,,0,0,0,,Мен тек патшаның бұйрығын орындаймын...
Dialogue: 0,0:06:07.70,0:06:09.70,Default,,0,0,0,,Алдыңғы француз экспедициясында
Dialogue: 0,0:06:09.78,0:06:12.16,Default,,0,0,0,,Ол патшаның әдістеріне ұнамаған сияқты.
Dialogue: 0,0:06:12.24,0:06:13.53,Default,,0,0,0,,Аузыңызды жабыңыз
Dialogue: 0,0:06:13.62,0:06:15.87,Default,,0,0,0,,Уорвиктің өлтірілуіне келсек...
Dialogue: 0,0:06:16.37,0:06:18.71,Default,,0,0,0,,Ричард жасады деген қауесет бар.
Dialogue: 0,0:06:19.87,0:06:24.30,Default,,0,0,0,,Мен әрқашан сіздің адалдығыңызды сатып алдым, Ричард.
Dialogue: 0,0:06:24.80,0:06:29.09,Default,,0,0,0,,Болашағыңды бірге таңдаймын.
Dialogue: 0,0:06:32.72,0:06:34.85,Default,,0,0,0,,Өзіңіздің сүйікті көйлегіңізді әкеліңіз
Dialogue: 0,0:06:34.93,0:06:36.85,Default,,0,0,0,,Мәртебелі маған осылай деді.
Dialogue: 0,0:06:37.35,0:06:40.10,Default,,0,0,0,,Мен есіктің сыртындамын.
Dialogue: 0,0:06:40.19,0:06:43.61,Default,,0,0,0,,Бірақ мен көйлегімді өзім өзгерте алмаймын...
Dialogue: 0,0:06:43.69,0:06:44.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:47.28,0:06:51.11,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:06:57.66,0:06:59.91,Default,,0,0,0,,Мен сізге көмектесейін бе?
Dialogue: 0,0:07:00.50,0:07:01.46,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:07:01.54,0:07:04.21,Default,,0,0,0,,Мен оны көргенде-ақ түсіндім.
Dialogue: 0,0:07:04.71,0:07:06.50,Default,,0,0,0,,Ішіңізде жасырынып жатыр...
Dialogue: 0,0:07:07.38,0:07:09.01,Default,,0,0,0,,Сұлулық пен арсыздық
Dialogue: 0,0:07:09.09,0:07:12.05,Default,,0,0,0,,Мәртебелі, менің күйеуім бар...
Dialogue: 0,0:07:12.14,0:07:13.47,Default,,0,0,0,,Naoii
Dialogue: 0,0:07:14.05,0:07:15.89,Default,,0,0,0,,Сен де кел, Хастингс.
Dialogue: 0,0:07:15.97,0:07:18.56,Default,,0,0,0,,Күте тұрыңыз... Күте тұрыңыз, Мәртебелі.
Dialogue: 0,0:07:20.02,0:07:22.40,Default,,0,0,0,,Сіз мұны қолдандыңыз ба?
Dialogue: 0,0:07:22.48,0:07:27.11,Default,,0,0,0,,Ғажайып эликсирдің тәтті және нәпсіқұмарлық жылуын сезін...
Dialogue: 0,0:07:29.82,0:07:31.70,Default,,0,0,0,,Жер бетінде сен несің...
Dialogue: 0,0:07:32.86,0:07:34.70,Default,,0,0,0,,Менің атым Джейн
Dialogue: 0,0:07:35.20,0:07:39.62,Default,,0,0,0,,Сіз сиқыршымен ұйықтап көрдіңіз бе? Мәртебелі Король
Dialogue: 0,0:07:40.25,0:07:41.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:41.71,0:07:44.96,Default,,0,0,0,,Бақсы болашақты болжай ала ма?
Dialogue: 0,0:07:45.46,0:07:48.30,Default,,0,0,0,,Алғаштардан оқуға болады
Dialogue: 0,0:07:48.38,0:07:49.38,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:07:50.09,0:07:54.05,Default,,0,0,0,,Сол тағдырлы торт сияқты
Dialogue: 0,0:07:57.35,0:07:59.81,Default,,0,0,0,,Сіз де кеше түнде жалғыз болған сияқтысыз.
Dialogue: 0,0:08:02.44,0:08:07.02,Default,,0,0,0,,Тіпті бұл денеде әйел алуды қалау да күнә.
Dialogue: 0,0:08:07.52,0:08:08.86,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,0:08:10.99,0:08:13.49,Default,,0,0,0,,Менің де баруымның қажеті жоқ екеніне сенімдісің бе?
Dialogue: 0,0:08:14.07,0:08:17.12,Default,,0,0,0,,Келсең, мен тек ауырып қаламын.
Dialogue: 0,0:08:17.62,0:08:18.74,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:08:19.99,0:08:23.87,Default,,0,0,0,,Ричард, кетер алдында мені құшақтап ал
Dialogue: 0,0:08:24.37,0:08:25.37,Default,,0,0,0,,Хехехе
Dialogue: 0,0:08:28.38,0:08:30.80,Default,,0,0,0,,Бүгін де өте әдемі көрінесің.
Dialogue: 0,0:08:31.51,0:08:33.76,Default,,0,0,0,,Гүл алғың келсе, анаңа сыйла.
Dialogue: 0,0:08:34.76,0:08:35.89,Default,,0,0,0,,Эдвард
Dialogue: 0,0:08:38.93,0:08:40.01,Default,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,0:08:43.35,0:08:45.56,Default,,0,0,0,,Әкеңді шығарып салайық.
Dialogue: 0,0:08:47.02,0:08:50.48,Default,,0,0,0,,Мен ол адамға жыл сайын ұқсай бастаймын...
Dialogue: 0,0:08:50.98,0:08:55.61,Default,,0,0,0,,Ричард бұл баланың атын атаған сайын, өзін кінәлағандай сезінеді.
Dialogue: 0,0:08:56.11,0:08:59.20,Default,,0,0,0,,Махаббатсыз күндер баға
Dialogue: 0,0:09:00.08,0:09:02.08,Default,,0,0,0,,Әйеліңіз сізбен бірге жүрмей ме?
Dialogue: 0,0:09:03.04,0:09:04.08,Default,,0,0,0,,Бұл сізсіз
Dialogue: 0,0:09:04.58,0:09:06.96,Default,,0,0,0,,Мен сені күнде құшақтаймын.
Dialogue: 0,0:09:07.46,0:09:09.63,Default,,0,0,0,,Өйткені жан мен тән екі бөлек нәрсе.
Dialogue: 0,0:09:10.88,0:09:12.13,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:09:14.01,0:09:17.51,Default,,0,0,0,,Құдай жаза ретінде адамдарға денені берсе.
Dialogue: 0,0:09:18.22,0:09:22.77,Default,,0,0,0,,Бұл дене жан үшін түрме ғана.
Dialogue: 0,0:09:23.68,0:09:26.98,Default,,0,0,0,,Жан өлгенде тыныштықты білген.
Dialogue: 0,0:09:27.56,0:09:31.82,Default,,0,0,0,,Жаның жоқ болса, тұтқын болмас.
Dialogue: 0,0:09:32.32,0:09:33.69,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:09:33.78,0:09:36.40,Default,,0,0,0,,Ұлыммен шарап ішу – ең жақсысы.
Dialogue: 0,0:09:36.49,0:09:38.74,Default,,0,0,0,,Қараңыз! Біраз уақыттан кейін ол бос
Dialogue: 0,0:09:38.82,0:09:41.91,Default,,0,0,0,,Джордж, неге аз ішпейсің?
Dialogue: 0,0:09:41.99,0:09:44.33,Default,,0,0,0,,Ол кеше кеште балағат сөздер айтқанын айтты...
Dialogue: 0,0:09:44.41,0:09:45.71,Default,,0,0,0,,Мен саған шындықты айттым!
Dialogue: 0,0:09:45.79,0:09:47.96,Default,,0,0,0,,Бейшара ұлыма сәуегейлік айтайық
Dialogue: 0,0:09:48.04,0:09:49.46,Default,,0,0,0,,Сіз басқарған кезде
Dialogue: 0,0:09:49.54,0:09:52.17,Default,,0,0,0,,Біздің отбасы ауылдағы кедей ақсүйектерге айналды!
Dialogue: 0,0:09:52.25,0:09:53.42,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:09:53.50,0:09:57.68,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:09:57.76,0:10:01.64,Default,,0,0,0,,Кешіріңіз... мен не істесем де кері нәтиже береді.
Dialogue: 0,0:10:02.43,0:10:04.27,Default,,0,0,0,,Мен енді жақсы емеспін
Dialogue: 0,0:10:06.60,0:10:09.77,Default,,0,0,0,,Джордж, сен жаман емессің.
Dialogue: 0,0:10:09.85,0:10:12.98,Default,,0,0,0,,Сіз шын мәнінде патшамен тең дәрежедегі тіршілік иесісіз.
Dialogue: 0,0:10:13.07,0:10:14.23,Default,,0,0,0,,Изабель…
Dialogue: 0,0:10:16.28,0:10:20.78,Default,,0,0,0,,Мені қанша жек көрсең де, жұрттың алдында жағдайды нашарлатпа.
Dialogue: 0,0:10:20.87,0:10:23.66,Default,,0,0,0,,Уайымдамаңыз, маған сеніңіз
Dialogue: 0,0:10:24.83,0:10:29.17,Default,,0,0,0,,Әкеме опасыздық жасасаң да, мен сенің соңынан еремін деп шештім.
Dialogue: 0,0:10:29.67,0:10:31.83,Default,,0,0,0,,Тіпті өз әпкем де құрбан болды...
Dialogue: 0,0:10:33.88,0:10:35.25,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:35.96,0:10:38.80,Default,,0,0,0,,Құрметті Изабель, біз мұны сізге дайындадық.
Dialogue: 0,0:10:39.84,0:10:41.51,Default,,0,0,0,,Оның жұмыс істейтініне сенімдісіз бе?
Dialogue: 0,0:10:41.59,0:10:42.89,Default,,0,0,0,,Иә, ханым.
Dialogue: 0,0:10:43.39,0:10:44.47,Default,,0,0,0,,Ең үздік батыр болу үшін
Dialogue: 0,0:10:45.26,0:10:48.77,Default,,0,0,0,,Қарғыс бағаны талап етеді
Dialogue: 0,0:10:48.85,0:10:50.14,Default,,0,0,0,,Мен қарсы емеспін.
Dialogue: 0,0:10:51.35,0:10:54.23,Default,,0,0,0,,Маған патшайым болудың қажеті жоқ.
Dialogue: 0,0:10:54.77,0:10:59.32,Default,,0,0,0,,Сен менің бәрімсің, Джорджым...
Dialogue: 0,0:11:03.91,0:11:06.20,Default,,0,0,0,,А... уф...
Dialogue: 0,0:11:08.04,0:11:08.79,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:08.87,0:11:10.00,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:11:10.08,0:11:11.50,Default,,0,0,0,,Күткендей, Мәртебелі.
Dialogue: 0,0:11:11.58,0:11:13.13,Default,,0,0,0,,Сен оны бірнеше күн бұрын ертіп келгенде маған айтсаң ғой.
Dialogue: 0,0:11:13.21,0:11:15.75,Default,,0,0,0,,Осындай нәрсеге қуану керек, балам.
Dialogue: 0,0:11:16.34,0:11:18.38,Default,,0,0,0,,Джордж келмеді.
Dialogue: 0,0:11:18.96,0:11:21.30,Default,,0,0,0,,Шақырулар тізімінен шығарылды деп ойлаймын.
Dialogue: 0,0:11:21.80,0:11:24.55,Default,,0,0,0,,Соңғы рет мұны істеу табиғи ма?
Dialogue: 0,0:11:24.64,0:11:25.93,Default,,0,0,0,,Тек соңғы рет емес
Dialogue: 0,0:11:28.14,0:11:30.43,Default,,0,0,0,,Әке, қарашы!
Dialogue: 0,0:11:31.98,0:11:32.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:33.06,0:11:37.19,Default,,0,0,0,,Түн батып қалды, балалар қазір демалыңдар.
Dialogue: 0,0:11:37.69,0:11:38.57,Default,,0,0,0,,Мен әлі де...
Dialogue: 0,0:11:38.65,0:11:41.82,Default,,0,0,0,,Бүгін түнде той күндеріндегі шаршағаныңызды сауықтырыңыз.
Dialogue: 0,0:11:42.82,0:11:44.78,Default,,0,0,0,,Мен үшін мұнда болу ыңғайсыз ба?
Dialogue: 0,0:11:45.78,0:11:47.24,Default,,0,0,0,,Бірдеңе айттыңыз ба?
Dialogue: 0,0:11:49.62,0:11:50.71,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:50.79,0:11:54.08,Default,,0,0,0,,Королеваның сиқырлы күші ақыры таусылды ма?
Dialogue: 0,0:11:54.17,0:11:57.42,Default,,0,0,0,,Мүмкін жаңа бақсы пайда болған шығар.
Dialogue: 0,0:11:58.96,0:12:01.67,Default,,0,0,0,,Иә, бұл сирек емес.
Dialogue: 0,0:12:02.17,0:12:06.14,Default,,0,0,0,,Бірақ осы уақытқа дейін жаңа сүйіктім болса да
Dialogue: 0,0:12:06.22,0:12:09.31,Default,,0,0,0,,Ол мені ешқашан артымда қалдырмайтын.
Dialogue: 0,0:12:11.56,0:12:12.27,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:15.56,0:12:19.94,Default,,0,0,0,,Жарайды, маған енді патшаның ықыласы қажет емес.
Dialogue: 0,0:12:20.65,0:12:22.15,Default,,0,0,0,,Ана?
Dialogue: 0,0:12:23.03,0:12:25.70,Default,,0,0,0,,Менің қолымда қозыр бар
Dialogue: 0,0:12:26.70,0:12:29.45,Default,,0,0,0,,Патша болатын ұлдар
Dialogue: 0,0:12:29.95,0:12:33.50,Default,,0,0,0,,Олай болса, мырзалар, бұл жерден бізге кезек келді.
Dialogue: 0,0:12:33.58,0:12:35.83,Default,,0,0,0,,Ох~ (Джейн және басқалар) Ухх...
Dialogue: 0,0:12:37.21,0:12:38.46,Default,,0,0,0,,Ол әйел...
Dialogue: 0,0:12:39.34,0:12:42.92,Default,,0,0,0,,Құрметті Ричард, асыңыз дәмді болсын.
Dialogue: 0,0:12:47.93,0:12:52.81,Default,,0,0,0,,Мырзалар, бұл бүгін кешке арнайы дайындалған ғажайып саке.
Dialogue: 0,0:12:53.31,0:12:54.98,Default,,0,0,0,,Жұмаққа қош келдіңіз!
Dialogue: 0,0:13:01.69,0:13:04.57,Default,,0,0,0,,(Әйелдердің күлкісі)
Dialogue: 0,0:13:05.70,0:13:08.66,Default,,0,0,0,,Бұл... жұмақ па?
Dialogue: 0,0:13:08.74,0:13:11.66,Default,,0,0,0,,Бұл сіздің ағаңызға қатысты шығар.
Dialogue: 0,0:13:12.91,0:13:15.75,Default,,0,0,0,,Бұл сақинаның ішінде жұмақ бар...
Dialogue: 0,0:13:16.25,0:13:18.29,Default,,0,0,0,,Жарық бар деп сенді
Dialogue: 0,0:13:19.00,0:13:22.05,Default,,0,0,0,,Бұл сақинаның ішінде жұмақ бар
Dialogue: 0,0:13:22.67,0:13:26.18,Default,,0,0,0,,Уф... не? Менің басым айналып кетті
Dialogue: 0,0:13:26.84,0:13:27.76,Default,,0,0,0,,Ричард
Dialogue: 0,0:13:27.84,0:13:28.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:29.14,0:13:30.35,Default,,0,0,0,,Әке?
Dialogue: 0,0:13:30.85,0:13:32.26,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:13:35.98,0:13:38.56,Default,,0,0,0,,Ричард Бұл жұмақ.
Dialogue: 0,0:13:39.31,0:13:43.48,Default,,0,0,0,,Иә, Ричард, одан толық ләззат алыңыз.
Dialogue: 0,0:13:44.36,0:13:45.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:45.99,0:13:48.32,Default,,0,0,0,,Өзіңізді көбірек босатыңыз
Dialogue: 0,0:13:48.91,0:13:50.74,Default,,0,0,0,,Тоқта... тоқта!
Dialogue: 0,0:13:51.74,0:13:55.62,Default,,0,0,0,,Ібіліс Ібіліс... Ібіліс!
Dialogue: 0,0:13:55.70,0:13:58.42,Default,,0,0,0,,Менің жаным сол кезде өлді.
Dialogue: 0,0:13:58.50,0:14:01.92,Default,,0,0,0,,Бірақ оны еске түсіру өте оңай
Dialogue: 0,0:14:02.00,0:14:03.05,Default,,0,0,0,,Қандай нәзік өлім.
Dialogue: 0,0:14:03.13,0:14:04.09,Default,,0,0,0,,Сәлем Ричард!
Dialogue: 0,0:14:04.17,0:14:05.55,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:14:06.30,0:14:07.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:08.22,0:14:09.43,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:14:10.39,0:14:13.14,Default,,0,0,0,,Бұл жұмақ емес
Dialogue: 0,0:14:14.35,0:14:17.52,Default,,0,0,0,,Әлгі адам... Анау...
Dialogue: 0,0:14:19.35,0:14:20.98,Default,,0,0,0,,Менің әкем емес
Dialogue: 0,0:14:26.94,0:14:29.15,Default,,0,0,0,,А... бұл қайда?
Dialogue: 0,0:14:30.24,0:14:31.78,Default,,0,0,0,,Одан кейінгі естеліктер...
Dialogue: 0,0:14:32.28,0:14:34.49,Default,,0,0,0,,Мен бұл денені біреуге берем деп ешқашан ойламадым...
Dialogue: 0,0:14:34.58,0:14:35.70,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:36.75,0:14:37.96,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:14:38.62,0:14:39.75,Default,,0,0,0,,Кэтсби
Dialogue: 0,0:14:41.50,0:14:43.17,Default,,0,0,0,,Интрузивті еліктеу
Dialogue: 0,0:14:43.25,0:14:44.30,Default,,0,0,0,,Мырза Президент, қазіргі L, шатастырмау үшін,
Dialogue: 0,0:14:44.80,0:14:49.97,Default,,0,0,0,,Барлығы абыржыған күйде, кеше түнде болған оқиға ешкімнің есінде жоқ.
Dialogue: 0,0:14:51.72,0:14:52.68,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:14:53.18,0:14:55.81,Default,,0,0,0,,Мен сізге алдын ала айтып берер едім...
Dialogue: 0,0:14:56.60,0:14:59.98,Default,,0,0,0,,Мәртебелі мырзаның әйелі Джейн есімді әйел.
Dialogue: 0,0:15:00.06,0:15:02.69,Default,,0,0,0,,Түрлі дәрі-дәрмек дайындауға болады дейді.
Dialogue: 0,0:15:02.77,0:15:04.86,Default,,0,0,0,,Біз Хастингс мырзадан естідік.
Dialogue: 0,0:15:04.94,0:15:08.07,Default,,0,0,0,,Енді сіз маған қарағанда сот қауесеттерін көбірек білесіз.
Dialogue: 0,0:15:08.82,0:15:13.03,Default,,0,0,0,,Менің мырзам, мистер Хастингс, ұлы мәртебелі мырзамен жақсы қарым-қатынаста.
Dialogue: 0,0:15:16.12,0:15:17.54,Default,,0,0,0,,Сіз қиындық тудырдыңыз.
Dialogue: 0,0:15:18.04,0:15:19.79,Default,,0,0,0,,Құрметті Ричард, сол күні...
Dialogue: 0,0:15:19.87,0:15:21.25,Default,,0,0,0,,Айтпа! Ол аяқтады!
Dialogue: 0,0:15:22.21,0:15:25.04,Default,,0,0,0,,Сол күні бәрі аяқталды.
Dialogue: 0,0:15:26.38,0:15:29.92,Default,,0,0,0,,Керісінше... маған Джейн туралы айтып беріңізші.
Dialogue: 0,0:15:30.76,0:15:34.72,Default,,0,0,0,,Бұл жай ғана өсек, бірақ оны өзі айтты.
Dialogue: 0,0:15:35.22,0:15:36.89,Default,,0,0,0,,Мен бақсымын
Dialogue: 0,0:15:38.52,0:15:39.35,Default,,0,0,0,,Ведьма…
Dialogue: 0,0:15:39.43,0:15:45.02,Default,,0,0,0,,Мұны сезінгеннен кейін, қалыпты өзара әрекеттесу жай ғана қолайсыздықты тудырады.
Dialogue: 0,0:15:45.52,0:15:48.32,Default,,0,0,0,,Бұрын соншалықты жарқын көрінетін
Dialogue: 0,0:15:48.40,0:15:51.07,Default,,0,0,0,,Қолыңызға алған соң, ол өшіп қалады.
Dialogue: 0,0:15:51.15,0:15:52.53,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:15:53.11,0:15:55.53,Default,,0,0,0,,Бірақ Джейн басқаша.
Dialogue: 0,0:15:55.62,0:15:58.12,Default,,0,0,0,,Дәмін татқан сайын, оны қалайсыз.
Dialogue: 0,0:15:58.20,0:16:02.37,Default,,0,0,0,,Мені мына қызық тақтадан жұмаққа жетеле
Dialogue: 0,0:16:04.67,0:16:05.79,Default,,0,0,0,,Не істеді?
Dialogue: 0,0:16:05.88,0:16:09.59,Default,,0,0,0,,Соңғы кездері менің физикалық күшімнің кенет төмендегенін сезіндім.
Dialogue: 0,0:16:09.67,0:16:11.38,Default,,0,0,0,,Әсіресе көңіл көтерудің келесі күні...
Dialogue: 0,0:16:11.47,0:16:11.97,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:16:12.63,0:16:15.14,Default,,0,0,0,,А... Мен аздап шаршадым.
Dialogue: 0,0:16:15.22,0:16:17.72,Default,,0,0,0,,Оның орнына Джейнге қоңырау шала аласыз ба?
Dialogue: 0,0:16:18.22,0:16:21.89,Default,,0,0,0,,Ол сізге шексіз күш беретіні сөзсіз.
Dialogue: 0,0:16:22.98,0:16:24.85,Default,,0,0,0,,Маған Джейнді әкеліңіз.
Dialogue: 0,0:16:24.94,0:16:27.82,Default,,0,0,0,,Мен ұлы мәртебелі мырзаның қасында қалып, оны бақылап отырғым келеді.
Dialogue: 0,0:16:28.32,0:16:29.86,Default,,0,0,0,,Бұл маңызды емес деп ойлаймын, бірақ...
Dialogue: 0,0:16:30.57,0:16:35.70,Default,,0,0,0,,Сот мүшелері... әсіресе Элизабет құпия болуы керек.
Dialogue: 0,0:16:40.45,0:16:43.04,Default,,0,0,0,,Мен ол әйелдің жеке басын растағым келеді.
Dialogue: 0,0:16:43.71,0:16:46.04,Default,,0,0,0,,Егер сен бақсы болсаң, онда...
Dialogue: 0,0:16:46.54,0:16:47.21,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:16:50.46,0:16:52.21,Default,,0,0,0,,Бұл мереке емес
Dialogue: 0,0:16:52.30,0:16:54.05,Default,,0,0,0,,Мен оны өз басыма елестетемін
Dialogue: 0,0:16:54.13,0:16:55.88,Default,,0,0,0,,Дұға ет! Дұға ет!
Dialogue: 0,0:16:55.97,0:16:57.72,Default,,0,0,0,,Кек пен өшпенділік
Dialogue: 0,0:16:57.80,0:17:00.14,Default,,0,0,0,,Мына отқа!
Dialogue: 0,0:17:05.27,0:17:05.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:10.11,0:17:12.03,Default,,0,0,0,,«Король Эдвардтың өлімі»
Dialogue: 0,0:17:12.90,0:17:14.86,Default,,0,0,0,,Бұл қарғыс атқан қуыршақ
Dialogue: 0,0:17:16.99,0:17:20.87,Default,,0,0,0,,Бұл тілекті жер бетінде кім айтты? Мәртебелі қайтыс болды
Dialogue: 0,0:17:21.91,0:17:25.21,Default,,0,0,0,,О, мені кешіре гөр... Құдайым.
Dialogue: 0,0:17:25.29,0:17:27.04,Default,,0,0,0,,Изабель, жақсысың ба?
Dialogue: 0,0:17:27.12,0:17:28.21,Default,,0,0,0,,Кенеттен осындай нәрсе...
Dialogue: 0,0:17:28.29,0:17:31.25,Default,,0,0,0,,Босанғаннан бері денсаулығым түзелмей жатыр...
Dialogue: 0,0:17:31.34,0:17:33.88,Default,,0,0,0,,Менің босанғаныма жарты жылдан асты!
Dialogue: 0,0:17:34.38,0:17:36.88,Default,,0,0,0,,Мүмкін күйзеліске байланысты шығар...
Dialogue: 0,0:17:37.38,0:17:39.18,Default,,0,0,0,,Мықты бол, Изабель.
Dialogue: 0,0:17:39.26,0:17:43.43,Default,,0,0,0,,Мәртебелі, мен сіздің ауруыңызға не себеп болғанын білмеймін.
Dialogue: 0,0:17:44.14,0:17:46.39,Default,,0,0,0,,Ұлы мәртебеліге қарғыс атқан адам...
Dialogue: 0,0:17:47.14,0:17:49.61,Default,,0,0,0,,Медицина… сонда…
Dialogue: 0,0:17:52.27,0:17:55.90,Default,,0,0,0,,Изабель, мен сені әрқашанда қалдырдым.
Dialogue: 0,0:17:56.40,0:17:58.03,Default,,0,0,0,,Мені шынымен кешіріңіз
Dialogue: 0,0:17:58.61,0:18:01.33,Default,,0,0,0,,Бірақ мен ант етемін... ант етейін.
Dialogue: 0,0:18:01.83,0:18:03.99,Default,,0,0,0,,Мен енді қайта туамын.
Dialogue: 0,0:18:08.00,0:18:11.25,Default,,0,0,0,,Патшаға қарғыс айтсаң, бұл опасыздық болар еді!
Dialogue: 0,0:18:11.34,0:18:13.50,Default,,0,0,0,,Бұл кім? Ол кісінің аты кім?
Dialogue: 0,0:18:15.05,0:18:19.68,Default,,0,0,0,,Мәртебелі, есіңізде ме? тағдыр торты
Dialogue: 0,0:18:20.72,0:18:22.89,Default,,0,0,0,,Қызыл шарап – қанның белгісі
Dialogue: 0,0:18:22.97,0:18:25.14,Default,,0,0,0,,«G» бас әріпі – бастауыш
Dialogue: 0,0:18:25.72,0:18:26.73,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:18:27.64,0:18:30.69,Default,,0,0,0,,Иә... Қанды Джордж
Dialogue: 0,0:18:31.44,0:18:33.36,Default,,0,0,0,,Мен сені жақсы көремін Изабель
Dialogue: 0,0:18:34.07,0:18:35.48,Default,,0,0,0,,Мәңгі бірге...
Dialogue: 0,0:18:38.45,0:18:40.16,Default,,0,0,0,,Сәлем? изабель
Dialogue: 0,0:18:42.49,0:18:44.24,Default,,0,0,0,,Изабель? Изабель!
Dialogue: 0,0:18:45.08,0:18:46.95,Default,,0,0,0,,Бірақ дәлел болмаса...
Dialogue: 0,0:18:47.04,0:18:49.37,Default,,0,0,0,,Мәртебелі, міне дәлел.
Dialogue: 0,0:18:52.17,0:18:52.84,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:53.42,0:18:56.17,Default,,0,0,0,,Ішіне қағаз салынған үш қуыршақ
Dialogue: 0,0:18:56.71,0:19:00.43,Default,,0,0,0,,Мәртебелі және Мәртебелі тақ мұрагерінің қайтыс болуын тілейтін мәлімдеме бар.
Dialogue: 0,0:19:01.01,0:19:03.26,Default,,0,0,0,,Бірақ бұл Джордждың қолжазбасы...
Dialogue: 0,0:19:03.35,0:19:06.22,Default,,0,0,0,,Мәртебелі, мұны маған қалдырыңыз.
Dialogue: 0,0:19:06.31,0:19:09.52,Default,,0,0,0,,Қарғыс ақиқатын інімнен сұраймын.
Dialogue: 0,0:19:12.94,0:19:14.48,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:19:14.98,0:19:17.07,Default,,0,0,0,,Адамдардың бақсы екеніне сену
Dialogue: 0,0:19:17.15,0:19:19.32,Default,,0,0,0,,Сіз Джорджды кінәлі етіп көрсеткіңіз келе ме?
Dialogue: 0,0:19:20.24,0:19:22.28,Default,,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:19:22.36,0:19:24.66,Default,,0,0,0,,Сіз де күдіктенесіз.
Dialogue: 0,0:19:25.16,0:19:28.20,Default,,0,0,0,,Сотты бұзған бақсылар отқа жағылады.
Dialogue: 0,0:19:28.70,0:19:30.25,Default,,0,0,0,,Сол Джоан д'Арк сияқты
Dialogue: 0,0:19:31.08,0:19:33.71,Default,,0,0,0,,Құлағаныма мен кінәлімін бе?
Dialogue: 0,0:19:34.84,0:19:39.17,Default,,0,0,0,,Соғысты ұмытып, патшалықтан гөрі қалауды бірінші орынға қоятын патша.
Dialogue: 0,0:19:39.76,0:19:41.76,Default,,0,0,0,,Інісі маскүнем.
Dialogue: 0,0:19:41.84,0:19:45.80,Default,,0,0,0,,Йорк отбасының Ахиллес өкшесі – олардың эмоцияларымен тыныштықты бұзуы.
Dialogue: 0,0:19:46.31,0:19:47.47,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:19:47.56,0:19:48.64,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:19:48.72,0:19:50.93,Default,,0,0,0,,Мен сені қызықтырамын
Dialogue: 0,0:19:51.44,0:19:56.06,Default,,0,0,0,,Оның басқа еркектерден ерекшелігі... Оның іші күрделі сияқты.
Dialogue: 0,0:19:56.15,0:19:57.02,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,0:19:58.03,0:19:59.36,Default,,0,0,0,,Жай әзіл.
Dialogue: 0,0:19:59.44,0:20:02.07,Default,,0,0,0,,Аристократтар әр нәрседе мағынаны қалайды
Dialogue: 0,0:20:02.15,0:20:06.53,Default,,0,0,0,,Менің мақсатым жоқ, өмірден ләззат алғым келеді
Dialogue: 0,0:20:09.95,0:20:11.79,Default,,0,0,0,,Мен осы жерден өзім барамын.
Dialogue: 0,0:20:12.37,0:20:13.00,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:20:13.08,0:20:17.25,Default,,0,0,0,,Егер сіз Йоркке адал болуға ант етсеңіз, өзіңізді ештеңе білмегендей кейіп танытып, үйге қайтыңыз.
Dialogue: 0,0:20:18.17,0:20:21.88,Default,,0,0,0,,Егер сіз ол бақсыны өлтірмесеңіз, ол патшайымға тексеру ретінде қызмет етеді.
Dialogue: 0,0:20:22.38,0:20:25.97,Default,,0,0,0,,Бірақ Джордж енді Йорк үшін у емес.
Dialogue: 0,0:20:26.72,0:20:28.93,Default,,0,0,0,,Йоркке апат әкелген...
Dialogue: 0,0:20:30.60,0:20:32.64,Default,,0,0,0,,Джорджды қамауға алу
Dialogue: 0,0:20:36.94,0:20:38.82,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:20:39.69,0:20:41.28,Default,,0,0,0,,Неге мені шақырмайсың?
Dialogue: 0,0:20:41.36,0:20:43.65,Default,,0,0,0,,Мен сені іздедім
Dialogue: 0,0:20:43.74,0:20:45.74,Default,,0,0,0,,Мен оның қызметшісімен кетіп бара жатқанын көрдім.
Dialogue: 0,0:20:46.49,0:20:47.95,Default,,0,0,0,,Сіз мені тыңдадыңыз ба?
Dialogue: 0,0:20:48.03,0:20:49.66,Default,,0,0,0,,Қанша бас тартсаң да...
Dialogue: 0,0:20:49.74,0:20:51.87,Default,,0,0,0,,Букингем, маған қол ұшын берші.
Dialogue: 0,0:20:53.08,0:20:54.00,Default,,0,0,0,,Сіз шынымен...
Dialogue: 0,0:20:54.50,0:20:58.09,Default,,0,0,0,,Жоқ, бірақ бұған дейін мен растағым келетін бір нәрсе бар.
Dialogue: 0,0:20:58.79,0:21:00.55,Default,,0,0,0,,Менен ештеңе жасырмайсың ғой, солай ма?
Dialogue: 0,0:21:02.59,0:21:04.55,Default,,0,0,0,,Ештеңе де құпия емес деп ант ет.
Dialogue: 0,0:21:04.63,0:21:07.59,Default,,0,0,0,,Егер сіз мені екінші жартыңыз деп алсаңыз, менімен бәрін бөлісіңіз.
Dialogue: 0,0:21:09.14,0:21:10.18,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:21:12.60,0:21:13.60,Default,,0,0,0,,Содан кейін Ричард
Dialogue: 0,0:21:15.14,0:21:17.40,Default,,0,0,0,,Менің патшам, маған бұйыр.
Dialogue: 0,0:21:17.90,0:21:19.19,Default,,0,0,0,,Мен бәрін орындаймын
Dialogue: 0,0:21:20.32,0:21:22.69,Default,,0,0,0,,Менің ойымша, сіз бір нәрсені дұрыс түсінбедіңіз.
Dialogue: 0,0:21:22.78,0:21:24.99,Default,,0,0,0,,Кэтсби менің қызметшім емес.
Dialogue: 0,0:21:25.49,0:21:29.70,Default,,0,0,0,,Шынымен бе? Ол әлі де өз жұмысын тамаша атқарып жатқан сияқты.
Dialogue: 0,0:21:30.83,0:21:34.58,Default,,0,0,0,,Йоркке адалдық танытқан адам ретінде мен сізге мұны ұсынамын.
Dialogue: 0,0:21:36.25,0:21:37.79,Default,,0,0,0,,Қалағаныңды істе... Ха!
Dialogue: 0,0:21:38.63,0:21:39.21,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:39.71,0:21:43.71,Default,,0,0,0,,Йорк үшін кек алатындар кез келген әдіспен жойылады.
Dialogue: 0,0:21:44.63,0:21:47.01,Default,,0,0,0,,Мен оны сол кезде міндетті түрде ұстадым.
Dialogue: 0,0:21:48.26,0:21:50.85,Default,,0,0,0,,Менің... болашағым
Dialogue: 0,0:22:01.40,0:22:03.40,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.86,0:23:30.86,Default,,0,0,0,,～♪
