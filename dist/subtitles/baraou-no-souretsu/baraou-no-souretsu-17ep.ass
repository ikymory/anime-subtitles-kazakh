Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.21,0:00:09.84,Default,,0,0,0,,Бұл кісі бір кездері патшаның жақын досы болған.
Dialogue: 0,0:00:09.92,0:00:14.09,Default,,0,0,0,,Патша өлген соң кейде ағасындай жол көрсетіп жүрді.
Dialogue: 0,0:00:14.18,0:00:16.22,Default,,0,0,0,,Осы елді қолдады
Dialogue: 0,0:00:17.47,0:00:18.22,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:18.85,0:00:20.06,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:00:21.39,0:00:25.10,Default,,0,0,0,,Жаныңды шайтанға сатсаң, тозаққа барасың.
Dialogue: 0,0:00:25.19,0:00:27.19,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:00:27.27,0:00:28.06,Default,,0,0,0,,Барлығың тыңдаңдар!
Dialogue: 0,0:00:28.77,0:00:31.78,Default,,0,0,0,,Патшайым анасы мен лорд Хастингс және т.б
Dialogue: 0,0:00:31.86,0:00:34.86,Default,,0,0,0,,Глостер герцогіне қастандық жасалды.
Dialogue: 0,0:00:34.95,0:00:36.74,Default,,0,0,0,,Лорд Стэнли (Стэнли) Ух...
Dialogue: 0,0:00:37.49,0:00:39.33,Default,,0,0,0,,Сіз қате кемені алдыңыз.
Dialogue: 0,0:00:41.54,0:00:42.66,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:00:43.16,0:00:44.83,Default,,0,0,0,,Сіз оны дәл қазір көрдіңіз!
Dialogue: 0,0:00:44.91,0:00:45.87,Default,,0,0,0,,Лорд Хастингс
Dialogue: 0,0:00:45.96,0:00:49.25,Default,,0,0,0,,Глостер герцогы туралы негізсіз қауесет тарату
Dialogue: 0,0:00:49.34,0:00:52.51,Default,,0,0,0,,Герцогты өлі ету үшін сиқырды қолдануға тырысты
Dialogue: 0,0:00:52.59,0:00:53.80,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:00:53.88,0:00:57.59,Default,,0,0,0,,Ол біздің алдымызда өлім жазасына кесілді, алаяқтың жолы болды.
Dialogue: 0,0:00:57.68,0:01:01.89,Default,,0,0,0,,Құдай Глостер герцогының әділ жүрегін көрді!
Dialogue: 0,0:01:03.27,0:01:04.02,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:04.60,0:01:07.60,Default,,0,0,0,,Жоғары мәртебелі регент! Өтінемін кешір мені
Dialogue: 0,0:01:07.69,0:01:12.57,Default,,0,0,0,,Бұдан былай ойымды өзгертіп, жан-дүниемді саған беруге ант етемін.
Dialogue: 0,0:01:13.07,0:01:14.07,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:01:14.57,0:01:17.95,Default,,0,0,0,,Тыңда, қазір де кеш емес.
Dialogue: 0,0:01:18.53,0:01:21.49,Default,,0,0,0,,Осы ел үшін бір жеңнен қол шығарсақ
Dialogue: 0,0:01:21.99,0:01:26.58,Default,,0,0,0,,Мен сендерді ағайын деймін
Dialogue: 0,0:01:27.54,0:01:31.13,Default,,0,0,0,,Жақында... Мен оны сәлден кейін ұстап аламын
Dialogue: 0,0:01:32.38,0:01:33.46,Default,,0,0,0,,Жарық
Dialogue: 0,0:01:37.55,0:01:39.59,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:39.68,0:01:41.76,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:42.26,0:01:48.23,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:48.73,0:01:53.53,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:57.53,0:01:59.53,Default,,0,0,0,,♪～
Dialogue: 0,0:03:23.87,0:03:25.87,Default,,0,0,0,,～♪
Dialogue: 0,0:03:30.21,0:03:31.83,Default,,0,0,0,,Елизавета патшайым
Dialogue: 0,0:03:32.42,0:03:33.54,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:03:34.04,0:03:36.29,Default,,0,0,0,,Енді барлық жоспарлар аяқталды.
Dialogue: 0,0:03:37.30,0:03:38.59,Default,,0,0,0,,Букингем…
Dialogue: 0,0:03:38.67,0:03:41.67,Default,,0,0,0,,Мен сізге не қажет болса, соны істеймін
Dialogue: 0,0:03:41.76,0:03:45.72,Default,,0,0,0,,Глостер герцогінің өлуінің себебі бар еді.
Dialogue: 0,0:03:46.64,0:03:48.72,Default,,0,0,0,,Бұл Глостер герцогы.
Dialogue: 0,0:03:48.81,0:03:52.73,Default,,0,0,0,,Ол сенің ұлыңнан гөрі тақ мұрагері.
Dialogue: 0,0:03:52.81,0:03:54.10,Default,,0,0,0,,Не дейсің, құрметсіз!
Dialogue: 0,0:03:54.19,0:03:55.44,Default,,0,0,0,,Кэтсби
Dialogue: 0,0:03:55.94,0:04:00.94,Default,,0,0,0,,Бірде майдан даласында естіген қарғыс ақиқатты айт.
Dialogue: 0,0:04:01.90,0:04:04.28,Default,,0,0,0,,Мен сізге айтайын деп отырған оқиғаға қатысты.
Dialogue: 0,0:04:04.36,0:04:07.08,Default,,0,0,0,,Біз көптеген айғақтарды растадық.
Dialogue: 0,0:04:07.58,0:04:11.04,Default,,0,0,0,,Құдайға ант етемін, бұл рас.
Dialogue: 0,0:04:12.12,0:04:13.79,Default,,0,0,0,,Марқұм король Эдвард IV
Dialogue: 0,0:04:14.79,0:04:17.25,Default,,0,0,0,,Мен Элизабет Вудвиллді кездестірмес бұрын
Dialogue: 0,0:04:17.34,0:04:19.96,Default,,0,0,0,,Әйелге тұрмысқа шыққан
Dialogue: 0,0:04:20.05,0:04:21.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:21.71,0:04:25.68,Default,,0,0,0,,Элизабет Вудвилл корольдің заңды әйелі емес
Dialogue: 0,0:04:26.51,0:04:30.14,Default,,0,0,0,,Басқаша айтқанда, менің ұлым Эдвард заңды патша емес.
Dialogue: 0,0:04:30.85,0:04:32.85,Default,,0,0,0,,Бұл қорқынышты қате!
Dialogue: 0,0:04:33.35,0:04:36.98,Default,,0,0,0,,Король әулетінің қасиетті діңі аласа бұтаға егілді.
Dialogue: 0,0:04:37.69,0:04:38.98,Default,,0,0,0,,Уф... Бірақ жігіттер.
Dialogue: 0,0:04:39.07,0:04:40.94,Default,,0,0,0,,Бақытымызға орай, ханзада әлі
Dialogue: 0,0:04:41.03,0:04:43.65,Default,,0,0,0,,Оның басында алтын сақина жоқ!
Dialogue: 0,0:04:43.74,0:04:44.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:45.20,0:04:47.91,Default,,0,0,0,,Сіз әлі де қателеріңізді түзете аласыз.
Dialogue: 0,0:04:48.53,0:04:51.08,Default,,0,0,0,,Құдай... қарап тұр.
Dialogue: 0,0:04:55.54,0:04:58.38,Default,,0,0,0,,Әділдік таныт
Dialogue: 0,0:04:59.84,0:05:01.67,Default,,0,0,0,,Бауырластардың бәрін алып кет!
Dialogue: 0,0:05:01.75,0:05:04.22,Default,,0,0,0,,Лондон мұнарасына жалған патша!
Dialogue: 0,0:05:04.30,0:05:05.76,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:05:05.84,0:05:08.34,Default,,0,0,0,,Лас! Маған тимеңіз!
Dialogue: 0,0:05:08.43,0:05:10.05,Default,,0,0,0,,Мен патшамын!
Dialogue: 0,0:05:10.14,0:05:13.18,Default,,0,0,0,,Әлгі шайтан... Ричард!
Dialogue: 0,0:05:13.27,0:05:17.06,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:05:27.61,0:05:29.32,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,0:05:29.82,0:05:32.70,Default,,0,0,0,,Сіз бен біз күткен сәт
Dialogue: 0,0:05:33.66,0:05:35.66,Default,,0,0,0,,Сіз және мен...?
Dialogue: 0,0:05:37.75,0:05:42.63,Default,,0,0,0,,Уақыты келгенде, антыңызға куәлік етудің қажеті болмайды.
Dialogue: 0,0:05:44.09,0:05:46.63,Default,,0,0,0,,Патшаның денесі осы елдікі.
Dialogue: 0,0:05:47.84,0:05:48.68,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:05:49.68,0:05:52.31,Default,,0,0,0,,Джейннің айтқаны саған бәрібір ме?
Dialogue: 0,0:05:53.01,0:05:56.52,Default,,0,0,0,,Сіз өзіңізді шынымен білесіз бе?
Dialogue: 0,0:05:57.48,0:06:00.36,Default,,0,0,0,,Уайымдамаңыз, бұлай болуы мүмкін емес.
Dialogue: 0,0:06:00.44,0:06:03.86,Default,,0,0,0,,Дәлел бар ма? Әлде сенгің келетін нәрсе ме?
Dialogue: 0,0:06:04.86,0:06:06.82,Default,,0,0,0,,Тағы бір қорқынышты түн келеді
Dialogue: 0,0:06:08.15,0:06:10.57,Default,,0,0,0,,Мен жылуды бұрыннан білсем де...
Dialogue: 0,0:06:12.16,0:06:13.16,Default,,0,0,0,,Ричард?
Dialogue: 0,0:06:13.74,0:06:14.99,Default,,0,0,0,,Тәж үшін
Dialogue: 0,0:06:15.50,0:06:18.00,Default,,0,0,0,,Ант – сол мақсатқа арналған рәсім ғана.
Dialogue: 0,0:06:18.50,0:06:22.50,Default,,0,0,0,,Иә, Ричард, егер сіз патша болуға жарамды болсаңыз...
Dialogue: 0,0:06:23.71,0:06:24.84,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:25.96,0:06:27.97,Default,,0,0,0,,Мен сенсіз ұйықтай алмаймын
Dialogue: 0,0:06:29.97,0:06:30.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:32.93,0:06:33.64,Default,,0,0,0,,Оны ұмыт
Dialogue: 0,0:06:34.93,0:06:37.81,Default,,0,0,0,,Менің шешіміммен сіз...
Dialogue: 0,0:06:38.85,0:06:40.90,Default,,0,0,0,,Достастық жалғыз ант емес.
Dialogue: 0,0:06:41.48,0:06:43.11,Default,,0,0,0,,Маған не қалайтыныңызды айтыңыз
Dialogue: 0,0:06:47.65,0:06:50.28,Default,,0,0,0,,Тек... жанымда бол.
Dialogue: 0,0:06:51.99,0:06:55.62,Default,,0,0,0,,Таң атқанша қараңғылық күйгенше
Dialogue: 0,0:06:57.20,0:06:58.08,Default,,0,0,0,,Сіз естідіңіз бе?
Dialogue: 0,0:06:58.16,0:07:01.46,Default,,0,0,0,,Эдвард V және оның ағасы Лондон мұнарасына жеткізілді.
Dialogue: 0,0:07:01.54,0:07:03.79,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:07:03.88,0:07:06.42,Default,,0,0,0,,Сонда тағының келесі мұрагері қазірдің өзінде
Dialogue: 0,0:07:06.50,0:07:08.21,Default,,0,0,0,,Ол жалғыз
Dialogue: 0,0:07:10.47,0:07:12.59,Default,,0,0,0,,Не болды? Сен оны сезбейсің бе?
Dialogue: 0,0:07:14.18,0:07:16.06,Default,,0,0,0,,Сіз оны алдым деп ойласаңыз да
Dialogue: 0,0:07:16.14,0:07:20.77,Default,,0,0,0,,Әрқашан, осы қолдарда, үміт қарғысқа айналды
Dialogue: 0,0:07:20.85,0:07:22.65,Default,,0,0,0,,Бұл жолы рас
Dialogue: 0,0:07:23.15,0:07:26.19,Default,,0,0,0,,Тәж екеуміздің арамызда енді ешкім жоқ.
Dialogue: 0,0:07:26.69,0:07:28.73,Default,,0,0,0,,Барлық тікенектер жойылды
Dialogue: 0,0:07:29.53,0:07:31.11,Default,,0,0,0,,Сізге тек тілек айту керек
Dialogue: 0,0:07:31.78,0:07:34.41,Default,,0,0,0,,Қазір бәрі сіз қалағандай.
Dialogue: 0,0:07:34.91,0:07:37.20,Default,,0,0,0,,Глостер герцогы қайда?
Dialogue: 0,0:07:37.70,0:07:40.37,Default,,0,0,0,,Мен сіздің Лондон мұнарасында дұға етіп жатқаныңызды естідім.
Dialogue: 0,0:07:40.45,0:07:42.92,Default,,0,0,0,,Ол жарақатын сұрап жатқан сияқты.
Dialogue: 0,0:07:43.50,0:07:44.92,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:07:45.00,0:07:48.63,Default,,0,0,0,,Осы қарқынмен бәрі оның сценарийі бойынша жүріп жатыр.
Dialogue: 0,0:07:49.13,0:07:51.38,Default,,0,0,0,,Мен сізге айтайын
Dialogue: 0,0:07:51.47,0:07:54.26,Default,,0,0,0,,Ол осы уақытқа дейін не істеді?
Dialogue: 0,0:07:55.09,0:07:57.60,Default,,0,0,0,,Досымды өлтір, ағамды өлтір
Dialogue: 0,0:07:57.68,0:08:01.43,Default,,0,0,0,,Енді мен намазымды бейкүнә жүзбен оқимын
Dialogue: 0,0:08:01.52,0:08:03.14,Default,,0,0,0,,Сол жерде!
Dialogue: 0,0:08:03.64,0:08:06.19,Default,,0,0,0,,VI Генри осы жерде қайтыс болды.
Dialogue: 0,0:08:07.19,0:08:08.61,Default,,0,0,0,,Мен оны өлтірдім
Dialogue: 0,0:08:10.19,0:08:12.45,Default,,0,0,0,,Ол мені «шайтан» деп атады
Dialogue: 0,0:08:12.53,0:08:15.41,Default,,0,0,0,,Оған мейірім жоқ!
Dialogue: 0,0:08:15.49,0:08:16.66,Default,,0,0,0,,Өйткені Ричард
Dialogue: 0,0:08:16.74,0:08:20.24,Default,,0,0,0,,Құдайдың бейнесінде емес!
Dialogue: 0,0:08:20.83,0:08:23.16,Default,,0,0,0,,Ойлап қарасам, өсек-аяң болды.
Dialogue: 0,0:08:23.25,0:08:24.83,Default,,0,0,0,,Оның шындығы туралы…
Dialogue: 0,0:08:24.92,0:08:27.71,Default,,0,0,0,,Оның шындығын мен де естідім.
Dialogue: 0,0:08:27.79,0:08:31.71,Default,,0,0,0,,Иә, барлығы Глостер герцогы Ричард шайтан екенін айтты.
Dialogue: 0,0:08:31.80,0:08:34.38,Default,,0,0,0,,Шайтанның патша болуына жол берме!
Dialogue: 0,0:08:34.47,0:08:40.06,Default,,0,0,0,,Ібіліс патша болса, бұл ел құрдымға тасталады!
Dialogue: 0,0:08:40.64,0:08:42.64,Default,,0,0,0,,Жоғары мәртебелі! мұнараның айналасында жиналған халық
Dialogue: 0,0:08:43.23,0:08:45.65,Default,,0,0,0,,Ібіліс! Шайтан, шық!
Dialogue: 0,0:08:45.73,0:08:47.61,Default,,0,0,0,,Тәжін шайтанға берме!
Dialogue: 0,0:08:48.40,0:08:49.19,Default,,0,0,0,,Құрметті Ричард...
Dialogue: 0,0:08:49.27,0:08:52.82,Default,,0,0,0,,Сіз маған қоңырау шалып жатырсыз. Мен сіздің үміттеріңізді ақтаймын.
Dialogue: 0,0:08:53.57,0:08:55.28,Default,,0,0,0,,Жарайсың ба? Букингем
Dialogue: 0,0:08:55.36,0:08:58.66,Default,,0,0,0,,Сценарий аяқталды, оны орындаңыз.
Dialogue: 0,0:08:59.41,0:09:01.99,Default,,0,0,0,,Өлгендердің қарғысы тек адамдар ғана шатасады.
Dialogue: 0,0:09:02.66,0:09:06.00,Default,,0,0,0,,Ібіліс қалағанын істейді
Dialogue: 0,0:09:07.33,0:09:09.21,Default,,0,0,0,,Тыңдаңыз, бұл Киоген.
Dialogue: 0,0:09:09.71,0:09:12.21,Default,,0,0,0,,Қанша жалынсам да, сен
Dialogue: 0,0:09:12.30,0:09:15.13,Default,,0,0,0,,Қыздай таза, өтініштерді қабылдама.
Dialogue: 0,0:09:15.22,0:09:17.01,Default,,0,0,0,,Сіздің кезегіңіз, Ричард.
Dialogue: 0,0:09:17.09,0:09:19.14,Default,,0,0,0,,Сіздің рөліңіздің аты – «Құдай»
Dialogue: 0,0:09:19.64,0:09:20.26,Default,,0,0,0,,О
Dialogue: 0,0:09:21.31,0:09:25.27,Default,,0,0,0,,Құдайды да алдайтын қасиетті ойын көрсетемін.
Dialogue: 0,0:09:32.57,0:09:34.65,Default,,0,0,0,,Шайтан сияқты күлкілі сандырақ!
Dialogue: 0,0:09:35.15,0:09:38.24,Default,,0,0,0,,Бұл адам Плантагенеттің заңды ұрпағы.
Dialogue: 0,0:09:38.95,0:09:43.33,Default,,0,0,0,,Құрметті Глостер герцогы, осы елдің жаңа королі!
Dialogue: 0,0:09:43.41,0:09:44.87,Default,,0,0,0,,Қандай құрметсіз!
Dialogue: 0,0:09:44.95,0:09:48.79,Default,,0,0,0,,Әулиенің терісін қанша кисең де, ішегіңнің шірік иісін жасыра алмайсың!
Dialogue: 0,0:09:48.87,0:09:49.67,Default,,0,0,0,,Усурпатор!
Dialogue: 0,0:09:50.25,0:09:52.13,Default,,0,0,0,,Букингем маған қара
Dialogue: 0,0:09:54.17,0:09:55.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:56.76,0:09:59.64,Default,,0,0,0,,Балағат! Мен патша емеспін!
Dialogue: 0,0:10:00.39,0:10:03.93,Default,,0,0,0,,Тәжді қалайтыным рас.
Dialogue: 0,0:10:04.43,0:10:08.89,Default,,0,0,0,,Сүйікті ағасының қанын мұра еткен ханзада Эдвардқа арнау.
Dialogue: 0,0:10:08.98,0:10:10.90,Default,,0,0,0,,Бұл дұрыс емес Мәртебелі!
Dialogue: 0,0:10:11.61,0:10:13.77,Default,,0,0,0,,Ол бала ханзада емес.
Dialogue: 0,0:10:14.28,0:10:15.86,Default,,0,0,0,,Балалар, сендер де білулерің керек!
Dialogue: 0,0:10:16.53,0:10:21.45,Default,,0,0,0,,Эдвард IV тіпті ұрыспай-ақ өз халқының әйелдерін алған секс-жынды болды!
Dialogue: 0,0:10:21.53,0:10:23.83,Default,,0,0,0,,Әйтеуір, әлгі бала қос әйел алудың салдары еді ғой!
Dialogue: 0,0:10:23.91,0:10:27.41,Default,,0,0,0,,Күлкілі! Шайтанның үш тиындық ойынына алданба!
Dialogue: 0,0:10:28.83,0:10:30.50,Default,,0,0,0,,Егер сіз мені тағы да мазақ етсеңіз
Dialogue: 0,0:10:30.58,0:10:32.25,Default,,0,0,0,,Дос болсақ та аямаймыз!
Dialogue: 0,0:10:32.88,0:10:35.25,Default,,0,0,0,,Шындықты айту күнә болса
Dialogue: 0,0:10:35.34,0:10:36.55,Default,,0,0,0,,Мені жазалауыңызды өтінемін.
Dialogue: 0,0:10:37.38,0:10:42.80,Default,,0,0,0,,Бірақ осы уақытқа дейін шындықты айтқан бірде-бір адамды өлтірген жоқсың.
Dialogue: 0,0:10:42.89,0:10:47.35,Default,,0,0,0,,Мүмкін ол өзінің жанашыр жүрегінің арқасында осылай ойлайтын шығар.
Dialogue: 0,0:10:47.85,0:10:53.11,Default,,0,0,0,,Сүйікті ағамның ұлының асыл құқығы мен патша бақытына ие болғанын қалаймын!
Dialogue: 0,0:10:53.19,0:10:55.65,Default,,0,0,0,,Мен бір ғана нәрсені қалаймын
Dialogue: 0,0:10:56.48,0:11:00.03,Default,,0,0,0,,Мына қараңғы әлемді нұрландыратын нұр...
Dialogue: 0,0:11:00.53,0:11:02.07,Default,,0,0,0,,Қанды таң
Dialogue: 0,0:11:02.57,0:11:04.33,Default,,0,0,0,,Қайғылы күн
Dialogue: 0,0:11:04.91,0:11:06.33,Default,,0,0,0,,Жалғыз түн
Dialogue: 0,0:11:07.37,0:11:11.33,Default,,0,0,0,,Басатын жолды жарықтандыратын шамадан тыс жарық
Dialogue: 0,0:11:12.54,0:11:14.92,Default,,0,0,0,,Сол жарық болуы керек адам...
Dialogue: 0,0:11:15.42,0:11:17.13,Default,,0,0,0,,Біреу емес (Ричард) А...
Dialogue: 0,0:11:17.71,0:11:19.34,Default,,0,0,0,,Сіз боласыз
Dialogue: 0,0:11:19.42,0:11:22.51,Default,,0,0,0,,Жарық болып, осы дүниені нұрландырасың
Dialogue: 0,0:11:23.68,0:11:26.85,Default,,0,0,0,,Жас патшаның билігі кезіндегі хаос
Dialogue: 0,0:11:26.93,0:11:29.39,Default,,0,0,0,,Бұл халыққа қаншалықты ауыр болады?
Dialogue: 0,0:11:29.89,0:11:34.11,Default,,0,0,0,,Сондай замандардың азабын бәрінен де жақсы білетін өзіңсің...
Dialogue: 0,0:11:34.61,0:11:35.56,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:35.65,0:11:39.94,Default,,0,0,0,,Егер шын күші жоқ біреу патша болса, оның айналасындағы адамдар міндетті түрде соғысады.
Dialogue: 0,0:11:40.03,0:11:42.45,Default,,0,0,0,,Мен тағы да мұндай шатасуды қаламаймын.
Dialogue: 0,0:11:42.53,0:11:44.78,Default,,0,0,0,,Ұлымнан соғыста айырылдым
Dialogue: 0,0:11:44.87,0:11:46.62,Default,,0,0,0,,Ах, мен әкемді жақсы көремін...
Dialogue: 0,0:11:48.16,0:11:52.75,Default,,0,0,0,,Әке... Әкем менің бәрім еді.
Dialogue: 0,0:11:52.83,0:11:54.38,Default,,0,0,0,,Бұл көз жас...
Dialogue: 0,0:11:54.96,0:11:57.21,Default,,0,0,0,,Бәрі өтірік!
Dialogue: 0,0:11:57.29,0:11:59.96,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:01.13,0:12:04.97,Default,,0,0,0,,Мен сізбен ерекше байланысты сезінемін
Dialogue: 0,0:12:06.01,0:12:07.47,Default,,0,0,0,,Өз атыңызды қалдырыңыз
Dialogue: 0,0:12:07.56,0:12:09.81,Default,,0,0,0,,Иә, әке.
Dialogue: 0,0:12:12.77,0:12:13.52,Default,,0,0,0,,Глостер герцогы!
Dialogue: 0,0:12:14.15,0:12:17.36,Default,,0,0,0,,Айтсаңыз да, тыңдамайсыз.
Dialogue: 0,0:12:17.44,0:12:20.74,Default,,0,0,0,,Басқа қанмен таққа таласудан басқа амалым жоқ!
Dialogue: 0,0:12:20.82,0:12:23.57,Default,,0,0,0,,Тоқта! Глостер герцогы, ұрысты тоқтат!
Dialogue: 0,0:12:23.65,0:12:25.41,Default,,0,0,0,,Өтінемін! Өтінемін, Мәртебелі!
Dialogue: 0,0:12:25.49,0:12:27.99,Default,,0,0,0,,Мұны да жасаңыз! Тілегім қабыл болсын!
Dialogue: 0,0:12:28.08,0:12:30.58,Default,,0,0,0,,Глостер герцогы, тілегіміз!
Dialogue: 0,0:12:30.66,0:12:32.71,Default,,0,0,0,,Патшаға! Корольге! Корольге!
Dialogue: 0,0:12:32.79,0:12:35.17,Default,,0,0,0,,Бізге көмектес! Құдай бізге жар болсын!
Dialogue: 0,0:12:35.25,0:12:36.29,Default,,0,0,0,,Құдай, өтінемін!
Dialogue: 0,0:12:36.38,0:12:37.25,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:12:38.84,0:12:41.17,Default,,0,0,0,,Мен бұл елді жоймаймын.
Dialogue: 0,0:12:41.67,0:12:44.51,Default,,0,0,0,,Жанымның әділдігіне қарсы болса да
Dialogue: 0,0:12:45.55,0:12:50.14,Default,,0,0,0,,Букингем азаматтары, мен патша боламын.
Dialogue: 0,0:12:50.64,0:12:53.39,Default,,0,0,0,,Және бұл денеде
Dialogue: 0,0:12:53.48,0:12:55.27,Default,,0,0,0,,Тағдырдың жүгін көтер!
Dialogue: 0,0:12:55.35,0:12:58.23,Default,,0,0,0,,Құдай! Құдай сені сақтасын!
Dialogue: 0,0:12:59.02,0:13:01.36,Default,,0,0,0,,Ричард әкесінің атымен
Dialogue: 0,0:13:01.44,0:13:03.69,Default,,0,0,0,,Осы елдің патшасы бол!
Dialogue: 0,0:13:03.78,0:13:06.78,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:06.86,0:13:07.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:10.20,0:13:11.83,Default,,0,0,0,,(Топ өнімділігі)
Dialogue: 0,0:13:11.91,0:13:15.29,Default,,0,0,0,,Жаңа патшаға Құдай жарылқасын!
Dialogue: 0,0:13:15.37,0:13:17.25,Default,,0,0,0,,(Топ өнімділігі)
Dialogue: 0,0:13:17.33,0:13:20.54,Default,,0,0,0,,Не болды? Бұл қандай да бір мереке болды ма?
Dialogue: 0,0:13:21.05,0:13:23.92,Default,,0,0,0,,Иә, бұл жаңа патшаның таққа отыруы.
Dialogue: 0,0:13:24.01,0:13:26.97,Default,,0,0,0,,Эдвард V-тің тәж киюі!
Dialogue: 0,0:13:27.05,0:13:29.47,Default,,0,0,0,,Бұл Ричард әлемінің соңы!
Dialogue: 0,0:13:29.55,0:13:33.22,Default,,0,0,0,,Аа, егер бұлай болса, біз көп ұзамай бостандық аламыз.
Dialogue: 0,0:13:33.31,0:13:35.31,Default,,0,0,0,,Ей, жақсы хабар әкелетін құс!
Dialogue: 0,0:13:35.39,0:13:37.65,Default,,0,0,0,,Патшаға бірге тост айтайық!
Dialogue: 0,0:13:38.15,0:13:39.73,Default,,0,0,0,,Біздің патшаға!
Dialogue: 0,0:13:42.61,0:13:44.94,Default,,0,0,0,,Бұл дүниеге келген күнің
Dialogue: 0,0:13:45.82,0:13:48.49,Default,,0,0,0,,Жан түршігерлік дауыл ағаштарды құлатты.
Dialogue: 0,0:13:49.53,0:13:52.95,Default,,0,0,0,,Үкі айқайлады, түнгі қарға қарқылдады.
Dialogue: 0,0:13:53.91,0:13:59.25,Default,,0,0,0,,Бақытсыз күндердің келгенін барлығына білу үшін...
Dialogue: 0,0:14:06.26,0:14:07.80,Default,,0,0,0,,Сәлем, әке.
Dialogue: 0,0:14:07.88,0:14:11.30,Default,,0,0,0,,Неліктен барлығы патшаны тыңдайды?
Dialogue: 0,0:14:11.80,0:14:15.56,Default,,0,0,0,,Себебі Құдай патшаны таңдады.
Dialogue: 0,0:14:16.06,0:14:18.56,Default,,0,0,0,,Құдай мені таңдаса...
Dialogue: 0,0:14:19.06,0:14:22.77,Default,,0,0,0,,Патша болсаң, мұңаймайсың ба?
Dialogue: 0,0:14:22.86,0:14:24.15,Default,,0,0,0,,О, мен сенімдімін
Dialogue: 0,0:14:24.23,0:14:26.36,Default,,0,0,0,,Барлығы сіз қалағандай болады.
Dialogue: 0,0:14:26.99,0:14:30.57,Default,,0,0,0,,Тыңдашы, Ричард, алтын тәж...
Dialogue: 0,0:14:31.28,0:14:34.08,Default,,0,0,0,,Бұл сақинаның ішінде жұмақ бар
Dialogue: 0,0:14:35.20,0:14:36.87,Default,,0,0,0,,Ричардқа пайғамбарлық айтайық
Dialogue: 0,0:14:37.45,0:14:41.00,Default,,0,0,0,,Ақырында қарттар, жесірлер, жетімдер көп болады.
Dialogue: 0,0:14:41.67,0:14:46.46,Default,,0,0,0,,Жақынның қайтыс болғанын жоқтап, батамды беремін.
Dialogue: 0,0:14:47.05,0:14:48.92,Default,,0,0,0,,Өйткені Құдай...
Dialogue: 0,0:14:49.55,0:14:51.26,Default,,0,0,0,,Өйткені Құдай...
Dialogue: 0,0:14:52.22,0:14:55.68,Default,,0,0,0,,Өйткені мен осы қанды шайтанды таңдадым.
Dialogue: 0,0:14:56.35,0:14:58.14,Default,,0,0,0,,Қазір уақыт!
Dialogue: 0,0:14:58.23,0:15:00.31,Default,,0,0,0,,Құрметпен құттықтаймыз!
Dialogue: 0,0:15:02.94,0:15:06.73,Default,,0,0,0,,Ұлы мәртебелі Англия королі Ричард III!
Dialogue: 0,0:15:07.23,0:15:10.20,Default,,0,0,0,,Ұлы мәртебелі Патшаға Алла разы болсын!
Dialogue: 0,0:15:13.45,0:15:15.03,Default,,0,0,0,,Бізге де хабарласыңыз.
Dialogue: 0,0:15:15.53,0:15:17.79,Default,,0,0,0,,Алла қолдасын...
Dialogue: 0,0:15:19.46,0:15:22.46,Default,,0,0,0,,Бұл Мәртебелі Патшадан!
Dialogue: 0,0:15:23.04,0:15:25.42,Default,,0,0,0,,Құттықтаймыз, Мәртебелі!
Dialogue: 0,0:15:25.50,0:15:28.42,Default,,0,0,0,,Мәртебелі Король III Ричардқа бата болсын!
Dialogue: 0,0:15:29.17,0:15:31.97,Default,,0,0,0,,Соқыр нәрсе қалайша...
Dialogue: 0,0:15:33.30,0:15:36.60,Default,,0,0,0,,Адамдар тәждің жарқырауын мадақтайды.
Dialogue: 0,0:15:37.26,0:15:41.81,Default,,0,0,0,,Жарық сақинасына жасырылған шайтан мүйіздерін байқамай
Dialogue: 0,0:15:44.61,0:15:48.48,Default,,0,0,0,,Енді азамат соғысының жарасы жазылып, бейбітшілік орнады!
Dialogue: 0,0:15:49.32,0:15:51.65,Default,,0,0,0,,Бұл тыныштық мәңгілік болсын
Dialogue: 0,0:15:52.15,0:15:54.20,Default,,0,0,0,,Құдай дұға етсін
Dialogue: 0,0:15:54.28,0:15:56.58,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,0:15:57.16,0:16:00.12,Default,,0,0,0,,Бұл жылдам мереке үшін тамаша.
Dialogue: 0,0:16:00.20,0:16:01.79,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:01.87,0:16:04.83,Default,,0,0,0,,Бастапқыда бұл король V Эдвардқа арналған банкет болды.
Dialogue: 0,0:16:04.92,0:16:08.30,Default,,0,0,0,,Олай болса, бәріңіз, келесі қойылымға назар аударыңыздар!
Dialogue: 0,0:16:08.88,0:16:10.51,Default,,0,0,0,,Құдіреті күшті, Құдіретті Раббым
Dialogue: 0,0:16:10.59,0:16:13.68,Default,,0,0,0,,Маған осы жерде жұмақ құруға рұқсат етіңіз!
Dialogue: 0,0:16:14.30,0:16:17.39,Default,,0,0,0,,Мен Құдаймын! Ол патшалардың патшасы!
Dialogue: 0,0:16:17.47,0:16:21.98,Default,,0,0,0,,Уа, Раббым! Мәңгілік адалдық тек саған!
Dialogue: 0,0:16:22.81,0:16:25.06,Default,,0,0,0,,Эдвард патша болған кездегі тілектері
Dialogue: 0,0:16:25.15,0:16:27.06,Default,,0,0,0,,Бұл шешілуі керек пьеса.
Dialogue: 0,0:16:27.15,0:16:28.69,Default,,0,0,0,,Неліктен бұл тақырып?
Dialogue: 0,0:16:28.77,0:16:30.57,Default,,0,0,0,,Сәлем періштелер
Dialogue: 0,0:16:30.65,0:16:33.65,Default,,0,0,0,,Мен жоқта менің тағыма қол тигізбе
Dialogue: 0,0:16:34.24,0:16:36.12,Default,,0,0,0,,Құдай былай деді:
Dialogue: 0,0:16:36.78,0:16:41.45,Default,,0,0,0,,Егер сен сол таққа отырсаң, құдайдың құдіретімен тең күшке ие болмас па едің?
Dialogue: 0,0:16:42.58,0:16:46.50,Default,,0,0,0,,Жарқын болғаным үшін Алланың қасынан орын берілді.
Dialogue: 0,0:16:48.96,0:16:50.67,Default,,0,0,0,,Менің атым Люцифер
Dialogue: 0,0:16:50.75,0:16:55.13,Default,,0,0,0,,Люцифердің жарығы Құдайдың жарығынан бірнеше есе күшті және әдемі!
Dialogue: 0,0:16:55.22,0:16:57.51,Default,,0,0,0,,Дәл қазір сол таққа отыруың керек.
Dialogue: 0,0:16:58.10,0:17:01.10,Default,,0,0,0,,Аспан бәрі сенікі және менікі
Dialogue: 0,0:17:01.18,0:17:04.44,Default,,0,0,0,,Міне! Құдайдың құдіреті енді біздің қолымызда
Dialogue: 0,0:17:05.02,0:17:08.31,Default,,0,0,0,,Нағыз Патшаңа тағзым
Dialogue: 0,0:17:08.40,0:17:10.48,Default,,0,0,0,,Бұл анық...
Dialogue: 0,0:17:10.57,0:17:12.78,Default,,0,0,0,,Бұл құрметсіздік! Оны дереу тоқтатыңыз!
Dialogue: 0,0:17:12.86,0:17:15.40,Default,,0,0,0,,Нортумберленд
Dialogue: 0,0:17:15.49,0:17:16.57,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:17.36,0:17:18.49,Default,,0,0,0,,Қалғанын көрсетіңіз
Dialogue: 0,0:17:19.24,0:17:20.70,Default,,0,0,0,,Қандай ақымақ!
Dialogue: 0,0:17:20.78,0:17:23.50,Default,,0,0,0,,Тозаққа түсіп, мәңгілік тұзаққа түс!
Dialogue: 0,0:17:24.66,0:17:27.17,Default,,0,0,0,,Мені енді Құдай жақсы көрмейді
Dialogue: 0,0:17:27.25,0:17:30.54,Default,,0,0,0,,Алла сүйген адамдарды қызғанамын!
Dialogue: 0,0:17:32.00,0:17:35.30,Default,,0,0,0,,О, мен бұл Ричард екеніне сенімдімін.
Dialogue: 0,0:17:35.80,0:17:37.18,Default,,0,0,0,,Бір кездері...
Dialogue: 0,0:17:39.26,0:17:40.76,Default,,0,0,0,,Бұл жақсы шоу болды.
Dialogue: 0,0:17:40.85,0:17:42.31,Default,,0,0,0,,Сыйлықты алайық
Dialogue: 0,0:17:42.81,0:17:45.60,Default,,0,0,0,,Кэтсби, маған мейірімділік танытыңыз.
Dialogue: 0,0:17:46.19,0:17:49.52,Default,,0,0,0,,Актер Мен сені ертеңгі кешке шақырамын.
Dialogue: 0,0:17:50.02,0:17:52.11,Default,,0,0,0,,Қалған ойынды көрсетейін.
Dialogue: 0,0:17:52.69,0:17:55.69,Default,,0,0,0,,Бірақ қазір бұл Ричард әлемі.
Dialogue: 0,0:17:56.74,0:17:59.57,Default,,0,0,0,,Ертеңгі банкеттің барлық мазмұны өзгереді.
Dialogue: 0,0:17:59.66,0:18:02.53,Default,,0,0,0,,Бұл Эдвардтың банкеті емес екенін білсін.
Dialogue: 0,0:18:03.20,0:18:05.33,Default,,0,0,0,,Мен саған Ричардтың тойын көрсетемін.
Dialogue: 0,0:18:05.83,0:18:08.37,Default,,0,0,0,,Жаңа дәуір келді.
Dialogue: 0,0:18:09.00,0:18:10.00,Default,,0,0,0,,Эдвард…
Dialogue: 0,0:18:10.58,0:18:12.96,Default,,0,0,0,,Әке-шешеңе
Dialogue: 0,0:18:13.55,0:18:16.47,Default,,0,0,0,,Мен саған қайырлы түн тілегім келді.
Dialogue: 0,0:18:17.42,0:18:18.55,Default,,0,0,0,,Жоғары мәртебелі тақ мұрагері
Dialogue: 0,0:18:19.76,0:18:24.39,Default,,0,0,0,,Осы уақытқа дейін сізбен сәлемдесу мүмкіндігі болмағаным үшін кешірім сұраймын.
Dialogue: 0,0:18:25.02,0:18:29.85,Default,,0,0,0,,Оның соншалықты керемет тұлғаға айналғанын көргенде, көңілім толқып кетті.
Dialogue: 0,0:18:29.94,0:18:33.57,Default,,0,0,0,,Ах... рахмет, герцог Букингем.
Dialogue: 0,0:18:35.86,0:18:38.03,Default,,0,0,0,,Букингем, сәл қарсы боласыз ба?
Dialogue: 0,0:18:38.78,0:18:39.99,Default,,0,0,0,,Менің бір оқиғам бар.
Dialogue: 0,0:18:42.62,0:18:44.91,Default,,0,0,0,,Бүгін түнде мен Аннамен ұйықтаймын
Dialogue: 0,0:18:46.12,0:18:47.62,Default,,0,0,0,,Мен патшамын
Dialogue: 0,0:18:48.12,0:18:51.17,Default,,0,0,0,,Ханшайымға түнеу патшаның міндеті.
Dialogue: 0,0:18:52.25,0:18:53.13,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:18:54.75,0:18:56.09,Default,,0,0,0,,Маңызды ма?
Dialogue: 0,0:18:56.17,0:18:59.42,Default,,0,0,0,,Антымыз орындалды
Dialogue: 0,0:19:00.05,0:19:02.09,Default,,0,0,0,,Сіз мінсіз патша болуыңыз керек
Dialogue: 0,0:19:02.59,0:19:04.64,Default,,0,0,0,,Менің қалағаным осы
Dialogue: 0,0:19:09.35,0:19:11.35,Default,,0,0,0,,Патша бөлмесі...
Dialogue: 0,0:19:11.44,0:19:12.44,Default,,0,0,0,,Ішкім келеді ме?
Dialogue: 0,0:19:15.11,0:19:15.98,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:16.07,0:19:17.23,Default,,0,0,0,,Не?
Dialogue: 0,0:19:17.32,0:19:20.70,Default,,0,0,0,,Жоқ, біртүрлі... Мен қобалжыдым.
Dialogue: 0,0:19:21.20,0:19:24.03,Default,,0,0,0,,Мен сіздің бөлмеңізге бірінші рет кірдім.
Dialogue: 0,0:19:24.66,0:19:26.54,Default,,0,0,0,,Біз әрқашан жұп болдық
Dialogue: 0,0:19:27.04,0:19:28.16,Default,,0,0,0,,Оған үйреніңіз.
Dialogue: 0,0:19:28.66,0:19:29.91,Default,,0,0,0,,Сіз де
Dialogue: 0,0:19:30.58,0:19:34.00,Default,,0,0,0,,Егер сіз маған ұзақ уақыт бойы осылай жақын болсаңыз...
Dialogue: 0,0:19:34.50,0:19:36.46,Default,,0,0,0,,Дәл сол кездегі мен түс көргендей
Dialogue: 0,0:19:37.59,0:19:40.38,Default,,0,0,0,,Мүмкін бұл біздің...
Dialogue: 0,0:19:40.47,0:19:42.89,Default,,0,0,0,,Бәрі кеш
Dialogue: 0,0:19:44.01,0:19:46.43,Default,,0,0,0,,Королева - патшаның жарты денесі
Dialogue: 0,0:19:48.35,0:19:50.27,Default,,0,0,0,,Біз бір-бірімізді қолдамай өмір сүре алмаймыз.
Dialogue: 0,0:19:56.77,0:19:58.11,Default,,0,0,0,,Ричард жарақат алды ма?
Dialogue: 0,0:19:58.19,0:19:58.82,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:00.44,0:20:01.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:02.91,0:20:03.82,Default,,0,0,0,,Ричард?
Dialogue: 0,0:20:04.32,0:20:05.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:05.95,0:20:10.25,Default,,0,0,0,,Кешіріңіз... Мен бүгін шаршадым. Ертең бізде де кеш болады.
Dialogue: 0,0:20:11.16,0:20:12.21,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:20:12.71,0:20:14.96,Default,,0,0,0,,Сіз алған нұрға мас болдыңыз ба?
Dialogue: 0,0:20:15.83,0:20:20.67,Default,,0,0,0,,Егер ол тәждің жарығына тығылмаса, ол жай шайтан, Ричард.
Dialogue: 0,0:20:22.05,0:20:25.22,Default,,0,0,0,,Сіз оны алғандықтан қорқынышты болды ма?
Dialogue: 0,0:20:26.60,0:20:29.68,Default,,0,0,0,,Себебі мен кешірудің жылуын білдім...
Dialogue: 0,0:20:31.31,0:20:33.56,Default,,0,0,0,,Мына елсіз әлемде
Dialogue: 0,0:20:33.64,0:20:38.77,Default,,0,0,0,,Жанымның көрсеткен жолы мәңгілік ақ, мөлдір еді.
Dialogue: 0,0:20:39.27,0:20:42.69,Default,,0,0,0,,Өз қолыммен идеал патшаны жараттым.
Dialogue: 0,0:20:43.20,0:20:43.70,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:48.03,0:20:50.79,Default,,0,0,0,,Мен Ричардпын...
Dialogue: 0,0:20:56.38,0:20:59.25,Default,,0,0,0,,Мен бүгін қатты қорықтым.
Dialogue: 0,0:20:59.34,0:21:01.96,Default,,0,0,0,,Сол үшін де басынан жаман дедім.
Dialogue: 0,0:21:02.05,0:21:05.26,Default,,0,0,0,,Ричардтың осындай жомарт адам болғанына қуаныштымын.
Dialogue: 0,0:21:05.76,0:21:06.76,Default,,0,0,0,,О
Dialogue: 0,0:21:06.84,0:21:10.51,Default,,0,0,0,,Бірақ патша өз шешімін қашан өзгертетінін ешқашан білмейді.
Dialogue: 0,0:21:10.60,0:21:12.98,Default,,0,0,0,,Асылып қалмас бұрын, асығыңыз да, жасырынып жүріңіз...
Dialogue: 0,0:21:13.06,0:21:13.73,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:21:16.98,0:21:19.73,Default,,0,0,0,,Мен күлімсіреп біреуді өлтіре аламын
Dialogue: 0,0:21:19.82,0:21:20.57,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:21:20.65,0:21:24.07,Default,,0,0,0,,Көңілсіз күйде сіз: «Мен қанағаттандым!» деп айқайлауыңыз мүмкін.
Dialogue: 0,0:21:24.15,0:21:26.91,Default,,0,0,0,,Бос көз жасыңызбен бетіңізді сулауға да болады.
Dialogue: 0,0:21:27.49,0:21:29.62,Default,,0,0,0,,Оның стратегиясы Улисске қарағанда жақсырақ.
Dialogue: 0,0:21:29.70,0:21:32.95,Default,,0,0,0,,Қарап тұру насыбайгүлден де көп адамды өлтіруі мүмкін
Dialogue: 0,0:21:33.04,0:21:34.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:35.25,0:21:38.00,Default,,0,0,0,,Бұл менмін... Эй?
Dialogue: 0,0:21:38.08,0:21:39.25,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:21:41.13,0:21:43.42,Default,,0,0,0,,Тәжін ала алмау себебі...
Dialogue: 0,0:21:45.01,0:21:46.43,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:21:47.63,0:21:50.89,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:22:01.44,0:22:03.44,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.90,0:23:30.90,Default,,0,0,0,,～♪
