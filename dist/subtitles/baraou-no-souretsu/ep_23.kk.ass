Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.92,0:00:08.42,Default,,0,0,0,,Қазір! Аяулы Отаным
Dialogue: 0,0:00:09.25,0:00:10.92,Default,,0,0,0,,Біз сізді күттік.
Dialogue: 0,0:00:11.01,0:00:12.38,Default,,0,0,0,,Ричмонд графы
Dialogue: 0,0:00:12.47,0:00:15.26,Default,,0,0,0,,Жоқ... менің патшам.
Dialogue: 0,0:00:15.34,0:00:16.39,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:16.47,0:00:17.22,Default,,0,0,0,,Стэнли
Dialogue: 0,0:00:17.80,0:00:21.10,Default,,0,0,0,,Күйеу балаңыз Ричмонд қайда?
Dialogue: 0,0:00:22.73,0:00:25.15,Default,,0,0,0,,Сатқындық өлім жазасына кесіледі
Dialogue: 0,0:00:25.98,0:00:28.61,Default,,0,0,0,,Үлкен ақсүйек пе, жақын туыс па.
Dialogue: 0,0:00:28.69,0:00:32.82,Default,,0,0,0,,Біреуді қаншалықты жақсы көрсең де...
Dialogue: 0,0:00:33.95,0:00:35.28,Default,,0,0,0,,Ерекшеліктер жоқ
Dialogue: 0,0:00:38.62,0:00:39.49,Default,,0,0,0,,Мырзалар!
Dialogue: 0,0:00:39.99,0:00:43.62,Default,,0,0,0,,Ешбір бүлікшілер қайта көтерілмеуі үшін патша билігін күшейту қажет!
Dialogue: 0,0:00:44.50,0:00:47.67,Default,,0,0,0,,Патшаның жеке әскерін күшейту
Dialogue: 0,0:00:47.75,0:00:50.09,Default,,0,0,0,,Құқықтар мен эмблемаларды қатаң бақылау
Dialogue: 0,0:00:51.09,0:00:53.80,Default,,0,0,0,,Қан және эмблемаларды ұқыпсыз құрастыру.
Dialogue: 0,0:00:53.88,0:00:57.76,Default,,0,0,0,,Патша тұқымынан шыққан алаяқтардың алдын алу.
Dialogue: 0,0:01:01.51,0:01:03.89,Default,,0,0,0,,Ешқандай ерекшелік болмауы керек.
Dialogue: 0,0:01:04.39,0:01:07.77,Default,,0,0,0,,Тіпті денемнің жартысын да осы қолдар берді.
Dialogue: 0,0:01:08.52,0:01:13.03,Default,,0,0,0,,Ричард, уақытыңызды босата аласыз ба?
Dialogue: 0,0:01:19.57,0:01:21.58,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:21.66,0:01:23.70,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:24.20,0:01:30.21,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:30.71,0:01:35.51,Default,,0,0,0,,Адамдар оны «Раушангүлдер соғысы» деп атайды.
Dialogue: 0,0:01:39.51,0:01:41.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:05.85,0:03:07.85,Default,,0,0,0,,～♪
Dialogue: 0,0:03:10.39,0:03:12.06,Default,,0,0,0,,Орманға терең кірме
Dialogue: 0,0:03:12.15,0:03:13.77,Default,,0,0,0,,Шу шығарудан аулақ болыңыз
Dialogue: 0,0:03:13.86,0:03:14.36,Default,,0,0,0,,Иә
Dialogue: 0,0:03:15.02,0:03:15.90,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:15.98,0:03:20.15,Default,,0,0,0,,Орманда сенімен бірге болғаныма біраз болды...
Dialogue: 0,0:03:20.65,0:03:22.86,Default,,0,0,0,,Бәрі арман сияқты
Dialogue: 0,0:03:25.03,0:03:27.37,Default,,0,0,0,,Жаңбыр әлдеқашан тоқтаса да
Dialogue: 0,0:03:28.12,0:03:30.12,Default,,0,0,0,,Барлық жерде іздеу
Dialogue: 0,0:03:32.00,0:03:34.63,Default,,0,0,0,,Жаман түс, бәрі
Dialogue: 0,0:03:35.13,0:03:35.96,Default,,0,0,0,,Анн?
Dialogue: 0,0:03:37.09,0:03:38.42,Default,,0,0,0,,Ұрыс алаңы емес...
Dialogue: 0,0:03:38.92,0:03:40.88,Default,,0,0,0,,Парламент те, банкет те емес
Dialogue: 0,0:03:41.38,0:03:43.43,Default,,0,0,0,,Король сарайы Эдвардқа жараспайды.
Dialogue: 0,0:03:44.26,0:03:45.89,Default,,0,0,0,,Не болды...
Dialogue: 0,0:03:45.97,0:03:47.26,Default,,0,0,0,,Өтінемін, Ричард.
Dialogue: 0,0:03:48.56,0:03:50.35,Default,,0,0,0,,Сол баланы мұрадан айыру
Dialogue: 0,0:03:51.48,0:03:53.10,Default,,0,0,0,,Не айтасыз...
Dialogue: 0,0:03:53.19,0:03:56.06,Default,,0,0,0,,Мен көп өмір сүре алмаймын
Dialogue: 0,0:03:56.15,0:03:57.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:57.57,0:04:00.24,Default,,0,0,0,,Мен бала кезімде туберкулезбен ауырдым.
Dialogue: 0,0:04:00.74,0:04:02.86,Default,,0,0,0,,Бұл да...
Dialogue: 0,0:04:02.95,0:04:04.32,Default,,0,0,0,,Бірде сауығып кеткен...
Dialogue: 0,0:04:04.41,0:04:06.70,Default,,0,0,0,,Өзіңіздің физикалық жағдайыңызды біліңіз...
Dialogue: 0,0:04:08.49,0:04:08.99,Default,,0,0,0,,Энн!
Dialogue: 0,0:04:10.08,0:04:11.83,Default,,0,0,0,,Бұдан былай сізбен бірге
Dialogue: 0,0:04:11.91,0:04:14.71,Default,,0,0,0,,Мен бұл елді тұрғызамын деп ойладым.
Dialogue: 0,0:04:14.79,0:04:17.96,Default,,0,0,0,,Мен сол баланың болашағын қорғаймын деп ойладым.
Dialogue: 0,0:04:19.09,0:04:22.80,Default,,0,0,0,,Мен өлсем де, ол бала өмір бойы нысанаға алынады.
Dialogue: 0,0:04:23.30,0:04:28.55,Default,,0,0,0,,Патшаның ұлы болған соң, өлмейінше қан мен қулықтан құтыла алмайсың.
Dialogue: 0,0:04:28.64,0:04:30.64,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:04:30.72,0:04:32.27,Default,,0,0,0,,Дұрыс? Ричард
Dialogue: 0,0:04:32.98,0:04:33.69,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:04:33.77,0:04:35.90,Default,,0,0,0,,Еркін Эдвард
Dialogue: 0,0:04:35.98,0:04:39.27,Default,,0,0,0,,Осы қорқынышты жарық сақинасының қарғысынан
Dialogue: 0,0:04:40.44,0:04:43.19,Default,,0,0,0,,Құдай неге сонша...
Dialogue: 0,0:04:43.70,0:04:45.74,Default,,0,0,0,,Неге оны менен алдың?
Dialogue: 0,0:04:47.57,0:04:49.95,Default,,0,0,0,,Мен бүкіл денем мұздап бара жатқандай сезінемін.
Dialogue: 0,0:04:50.83,0:04:54.25,Default,,0,0,0,,Бұл жолы шын сүйетін адаммен
Dialogue: 0,0:04:54.33,0:04:56.00,Default,,0,0,0,,Нағыз мұрагер...
Dialogue: 0,0:04:56.08,0:04:58.88,Default,,0,0,0,,Жоқ, жоқ... мұнда емес.
Dialogue: 0,0:04:59.50,0:05:02.34,Default,,0,0,0,,Патшаның шатыры мұндай суық болуы мүмкін емес.
Dialogue: 0,0:05:02.42,0:05:04.17,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:05:04.84,0:05:05.63,Default,,0,0,0,,Қайда...
Dialogue: 0,0:05:08.05,0:05:09.01,Default,,0,0,0,,Қайда...
Dialogue: 0,0:05:10.72,0:05:12.85,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:05:15.23,0:05:16.31,Default,,0,0,0,,Неге...
Dialogue: 0,0:05:16.39,0:05:18.15,Default,,0,0,0,,Сен неге жоқсың!
Dialogue: 0,0:05:18.23,0:05:19.48,Default,,0,0,0,,(Құлаған нәрсенің дыбысы)
Dialogue: 0,0:05:19.56,0:05:20.73,Default,,0,0,0,,Мәртебелі?
Dialogue: 0,0:05:23.90,0:05:26.65,Default,,0,0,0,,Ол... ол жерде жоқ!
Dialogue: 0,0:05:28.11,0:05:30.70,Default,,0,0,0,,Мен онсыз ұйықтай алмаймын
Dialogue: 0,0:05:30.78,0:05:31.62,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:05:31.70,0:05:33.58,Default,,0,0,0,,Маған Ричард деп қоңырау шалыңыз
Dialogue: 0,0:05:34.20,0:05:35.87,Default,,0,0,0,,Сол жігіт сияқты
Dialogue: 0,0:05:37.00,0:05:39.25,Default,,0,0,0,,Мен бұл жылуды қалаймын ...
Dialogue: 0,0:05:40.04,0:05:41.96,Default,,0,0,0,,Ри… Құрметті Ричард
Dialogue: 0,0:05:42.05,0:05:43.84,Default,,0,0,0,,Тек көзіңізді жұмып отырыңыз
Dialogue: 0,0:05:43.92,0:05:46.22,Default,,0,0,0,,Өзіңізге ұнайтын әйелді елестетіңіз...
Dialogue: 0,0:05:46.30,0:05:48.26,Default,,0,0,0,,Құрметті Ричард! (Ричард) А...
Dialogue: 0,0:05:49.30,0:05:54.43,Default,,0,0,0,,Тәннің жылуымен жанды жылыту... мүмкін емес.
Dialogue: 0,0:05:55.98,0:05:56.85,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:05:57.44,0:06:00.15,Default,,0,0,0,,Бұл басқалардан артық...
Dialogue: 0,0:06:01.36,0:06:02.52,Default,,0,0,0,,Мен сені көргім келеді
Dialogue: 0,0:06:03.11,0:06:05.19,Default,,0,0,0,,Бірақ ол кетіп қалды
Dialogue: 0,0:06:05.69,0:06:07.24,Default,,0,0,0,,Себебі мен сені сүйдім
Dialogue: 0,0:06:08.15,0:06:10.16,Default,,0,0,0,,Мен жақсы көретін нәрсе жоғалады
Dialogue: 0,0:06:10.66,0:06:13.58,Default,,0,0,0,,Маңыздының бәрі жоғалады.
Dialogue: 0,0:06:14.74,0:06:18.08,Default,,0,0,0,,Қылмыс жасау арқылы қалағаныма қол жеткіздім.
Dialogue: 0,0:06:18.58,0:06:22.13,Default,,0,0,0,,үшін қылмыс жасаудың бағасы ма?
Dialogue: 0,0:06:23.09,0:06:24.21,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:06:25.09,0:06:27.67,Default,,0,0,0,,Біз сені соңына дейін ертіп барамыз.
Dialogue: 0,0:06:34.35,0:06:37.73,Default,,0,0,0,,Патшам, мен саған бір нәрсе көрсеткім келеді.
Dialogue: 0,0:06:37.81,0:06:39.19,Default,,0,0,0,,Иә? (Оксфорд) Бұл...
Dialogue: 0,0:06:39.77,0:06:42.31,Default,,0,0,0,,Бұл Букингем герцогы...
Dialogue: 0,0:06:42.40,0:06:45.57,Default,,0,0,0,,Бұл да оған сеніп тапсырылған өсиет.
Dialogue: 0,0:06:46.90,0:06:48.24,Default,,0,0,0,,Оксфорд графы
Dialogue: 0,0:06:48.74,0:06:51.70,Default,,0,0,0,,Сіздей майданда шыңдалған генерал болса,
Dialogue: 0,0:06:51.78,0:06:53.62,Default,,0,0,0,,Біздің әскер қауіпсіз.
Dialogue: 0,0:06:53.70,0:06:57.37,Default,,0,0,0,,Бірақ біз әлі батыр емеспіз.
Dialogue: 0,0:06:57.45,0:07:00.83,Default,,0,0,0,,Ричард - қазіргі және заңды король
Dialogue: 0,0:07:00.92,0:07:03.00,Default,,0,0,0,,Екінші жағынан, біздің армия туралы айтатын болсақ,
Dialogue: 0,0:07:03.08,0:07:05.34,Default,,0,0,0,,Шетелдік сатқын
Dialogue: 0,0:07:05.96,0:07:09.80,Default,,0,0,0,,Шынымды айтсам, Ричмондтың патша болу үшін нәзік тұқымы бар.
Dialogue: 0,0:07:10.38,0:07:12.22,Default,,0,0,0,,Бұл тым кеш...
Dialogue: 0,0:07:12.30,0:07:16.26,Default,,0,0,0,,Батыр болу үшін не қажет деп ойлайсың?
Dialogue: 0,0:07:17.06,0:07:19.18,Default,,0,0,0,,Күш... жеңіс пе?
Dialogue: 0,0:07:19.93,0:07:22.73,Default,,0,0,0,,және әңгіме
Dialogue: 0,0:07:24.56,0:07:29.74,Default,,0,0,0,,үшінңыз жиналыңыздар! Біз спектакльді бастаймыз!
Dialogue: 0,0:07:29.82,0:07:30.70,Default,,0,0,0,,Театр ұжымы?
Dialogue: 0,0:07:30.78,0:07:35.45,Default,,0,0,0,,Иә, батыр болу үшін бәрінен де батырға не керек.
Dialogue: 0,0:07:35.53,0:07:37.79,Default,,0,0,0,,Бұл... (труппа мүшесі) Мен оны осында қайталаймын.
Dialogue: 0,0:07:37.87,0:07:40.37,Default,,0,0,0,,Патша сарайының жасырын шындығы
Dialogue: 0,0:07:40.45,0:07:42.00,Default,,0,0,0,,Қарғыс атқан тұлға
Dialogue: 0,0:07:42.08,0:07:43.37,Default,,0,0,0,,Ең жақсы...
Dialogue: 0,0:07:43.46,0:07:47.46,Default,,0,0,0,,Король Ричард III-тің сатқындығы туралы оқиға!
Dialogue: 0,0:07:50.38,0:07:52.05,Default,,0,0,0,,Ол жауыз.
Dialogue: 0,0:07:55.97,0:07:59.93,Default,,0,0,0,,Бұлбұл... маусымнан адасып қалды ма?
Dialogue: 0,0:08:01.27,0:08:04.81,Default,,0,0,0,,Оны көмсем не болады? жаны жоқ нәрсе
Dialogue: 0,0:08:05.81,0:08:09.23,Default,,0,0,0,,Әрине, адам емес адамдар аспанға бара алмайды.
Dialogue: 0,0:08:10.07,0:08:12.20,Default,,0,0,0,,Мәртебелі! Мен есеп бергім келеді
Dialogue: 0,0:08:13.15,0:08:14.82,Default,,0,0,0,,граф Ричмонд әскері
Dialogue: 0,0:08:14.91,0:08:17.16,Default,,0,0,0,,Олар Уэльстегі портқа қонды дейді.
Dialogue: 0,0:08:17.91,0:08:20.62,Default,,0,0,0,,Ричмонд Ақыры келді ме?
Dialogue: 0,0:08:20.70,0:08:22.29,Default,,0,0,0,,Оксфорд графы және т.б
Dialogue: 0,0:08:22.37,0:08:25.58,Default,,0,0,0,,Ричмонд графына бірнеше дворяндар қосылды деп айтылады.
Dialogue: 0,0:08:25.67,0:08:27.54,Default,,0,0,0,,Парламент шақырғыңыз келе ме?
Dialogue: 0,0:08:27.63,0:08:28.96,Default,,0,0,0,,Кеңес қажет емес
Dialogue: 0,0:08:29.71,0:08:32.76,Default,,0,0,0,,Соғысудан басқа амал жоқ
Dialogue: 0,0:08:33.26,0:08:37.60,Default,,0,0,0,,Сіз естідіңіз бе? Қолдаушылар көбейіп бара жатқандай.
Dialogue: 0,0:08:37.68,0:08:39.89,Default,,0,0,0,,Осы қарқынмен жеңілу мүмкін.
Dialogue: 0,0:08:41.22,0:08:42.39,Default,,0,0,0,,Лорд Стэнли
Dialogue: 0,0:08:42.48,0:08:46.06,Default,,0,0,0,,Егер сіз оңтүстік-батысқа бара жатырсыз десеңіз, біз...
Dialogue: 0,0:08:46.15,0:08:46.85,Default,,0,0,0,,Мырзалар!
Dialogue: 0,0:08:47.52,0:08:52.49,Default,,0,0,0,,Бұл сіз қаншалықты бос сөз айтуға мүмкіндігіңіз болса, соғұрлым соғысқа дайын екеніңізді білдіре ме?
Dialogue: 0,0:08:52.57,0:08:55.86,Default,,0,0,0,,Жоқ, жоқ, мен қайтып қару-жарақтарымды дайындауым керек.
Dialogue: 0,0:08:55.95,0:08:58.32,Default,,0,0,0,,Мен де әскерлерімді шақыруым керек...
Dialogue: 0,0:08:59.41,0:09:01.91,Default,,0,0,0,,Сендер, шүкіршіліксіз ауа райы
Dialogue: 0,0:09:01.99,0:09:05.37,Default,,0,0,0,,Бірақ бұл көтерілістер бірінен соң бірі болған кезде...
Dialogue: 0,0:09:05.46,0:09:07.21,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:09:08.29,0:09:10.46,Default,,0,0,0,,Мен өзімді жайсыз сезінемін.
Dialogue: 0,0:09:10.54,0:09:12.67,Default,,0,0,0,,Букингем герцогымен шайқастан кейін
Dialogue: 0,0:09:12.76,0:09:14.63,Default,,0,0,0,,Мәртебелі бос қабықтай болды.
Dialogue: 0,0:09:18.01,0:09:19.55,Default,,0,0,0,,Қайтадан жақсы емес
Dialogue: 0,0:09:19.64,0:09:22.52,Default,,0,0,0,,Сол дәріге байланысты ма? Немесе...
Dialogue: 0,0:09:23.10,0:09:25.48,Default,,0,0,0,,Құрметті Ричард! Король Ричард!
Dialogue: 0,0:09:25.56,0:09:27.35,Default,,0,0,0,,Ричард!
Dialogue: 0,0:09:27.44,0:09:29.44,Default,,0,0,0,,Ричард!
Dialogue: 0,0:09:30.19,0:09:33.73,Default,,0,0,0,,үшін бізге опасыздық жасау мүмкіндігін іздейді.
Dialogue: 0,0:09:34.40,0:09:37.45,Default,,0,0,0,,Бірінен соң бірі орын алған көтерілістер, өліп жатқан патшайым
Dialogue: 0,0:09:37.53,0:09:40.20,Default,,0,0,0,,Не керек, мен маңызды мұрагерден айырылсам ше?
Dialogue: 0,0:09:40.28,0:09:42.95,Default,,0,0,0,,Сіз бәрін жоғалтасыз
Dialogue: 0,0:09:43.45,0:09:47.25,Default,,0,0,0,,Денемнің жартысын өлтіріп қорғаған тәжім де
Dialogue: 0,0:09:49.71,0:09:51.84,Default,,0,0,0,,Ханшайымның денсаулығы қалай?
Dialogue: 0,0:09:51.92,0:09:54.17,Default,,0,0,0,,Қазіргі уақытта тыныштықта
Dialogue: 0,0:09:54.26,0:09:57.30,Default,,0,0,0,,Шынымды айтсам, ол уақыттың қашан келгені маңызды емес.
Dialogue: 0,0:09:57.38,0:10:02.26,Default,,0,0,0,,Шын мәнінде, тақ мұрагері де сол аурудың белгілерін көрсетіп отыр.
Dialogue: 0,0:10:07.31,0:10:07.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:08.02,0:10:11.98,Default,,0,0,0,,Егер сіз оны жіберсеңіз, Ричардтың болашағы жоқ.
Dialogue: 0,0:10:12.06,0:10:14.86,Default,,0,0,0,,Мен бұл туралы бұрыннан білемін.
Dialogue: 0,0:10:16.53,0:10:17.32,Default,,0,0,0,,Жанна
Dialogue: 0,0:10:17.82,0:10:19.95,Default,,0,0,0,,Бірақ сіз бір нәрседе қателесесіз.
Dialogue: 0,0:10:20.45,0:10:24.20,Default,,0,0,0,,Мен шынымен қорғағым келген нәрсе...
Dialogue: 0,0:10:26.04,0:10:26.62,Default,,0,0,0,,Анн?
Dialogue: 0,0:10:27.62,0:10:29.54,Default,,0,0,0,,Ана? Қайда бара жатырсың?
Dialogue: 0,0:10:29.62,0:10:33.00,Default,,0,0,0,,Ол жер соншалықты өлімге құмар.
Dialogue: 0,0:10:34.17,0:10:36.09,Default,,0,0,0,,Қашып кеткің келсе, дәл қазір...
Dialogue: 0,0:10:36.17,0:10:38.55,Default,,0,0,0,,Күте тұрыңыз! ана!
Dialogue: 0,0:10:39.30,0:10:42.05,Default,,0,0,0,,үшін алаңдаулы. Қайтейік.
Dialogue: 0,0:10:42.55,0:10:43.93,Default,,0,0,0,,Тыңда, Эдвард.
Dialogue: 0,0:10:44.68,0:10:47.06,Default,,0,0,0,,Мен... жақында өлемін.
Dialogue: 0,0:10:47.14,0:10:48.64,Default,,0,0,0,,Тш, мен өлетініме сене алар емеспін...
Dialogue: 0,0:10:48.73,0:10:50.98,Default,,0,0,0,,Бұл жағдайда патша сарайы
Dialogue: 0,0:10:51.06,0:10:54.36,Default,,0,0,0,,Ол сенің өліміңді тілейтін адамдарға толы шайтанның үңгіріне айналады.
Dialogue: 0,0:10:54.44,0:10:57.32,Default,,0,0,0,,Әсіресе Ричард шайқаста жеңілсе
Dialogue: 0,0:10:58.19,0:11:02.28,Default,,0,0,0,,Патшаның үлкен ұлы өлім жазасына кесіледі немесе өмірінің соңына дейін түрмеде жабылады.
Dialogue: 0,0:11:03.07,0:11:03.99,Default,,0,0,0,,Бұған дейін...
Dialogue: 0,0:11:04.08,0:11:05.66,Default,,0,0,0,,Энн! Күте тұрыңыз!
Dialogue: 0,0:11:05.74,0:11:06.70,Default,,0,0,0,,Әке...
Dialogue: 0,0:11:08.08,0:11:08.95,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:09.04,0:11:10.33,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:11.04,0:11:14.25,Default,,0,0,0,,Маған ұнамайды! Мен мұнда қала алмаймын
Dialogue: 0,0:11:14.34,0:11:19.01,Default,,0,0,0,,Мынау... сол патша сарайы мен қалағандай емес!
Dialogue: 0,0:11:19.09,0:11:19.67,Default,,0,0,0,,Анна…
Dialogue: 0,0:11:20.34,0:11:25.22,Default,,0,0,0,,Мен қайтып оралғым келеді... сол күні сені кездестіргенге дейінгі өзіме.
Dialogue: 0,0:11:25.30,0:11:28.22,Default,,0,0,0,,Менің өмірімнен бұрын мен!
Dialogue: 0,0:11:28.77,0:11:29.85,Default,,0,0,0,,Күте тұрыңыз, Энн!
Dialogue: 0,0:11:30.73,0:11:32.98,Default,,0,0,0,,Тіпті армандауға да рұқсат етілмейді
Dialogue: 0,0:11:33.48,0:11:38.48,Default,,0,0,0,,Әйелдің міндеті – алдындағы адамды жай ғана жақсы көру.
Dialogue: 0,0:11:42.03,0:11:43.20,Default,,0,0,0,,Анна…
Dialogue: 0,0:11:44.87,0:11:45.91,Default,,0,0,0,,Жібер
Dialogue: 0,0:11:46.99,0:11:48.41,Default,,0,0,0,,Сәлем Ричард
Dialogue: 0,0:11:48.91,0:11:51.62,Default,,0,0,0,,Сен менің... қарғысымсың.
Dialogue: 0,0:11:52.54,0:11:54.21,Default,,0,0,0,,Мен сені сүйгендіктен емес
Dialogue: 0,0:11:54.71,0:11:57.46,Default,,0,0,0,,Мені сүйгендіктен байланып қалдың ғой, солай ма?
Dialogue: 0,0:11:58.05,0:11:59.84,Default,,0,0,0,,Себебі мен сені жақсы көргім келді
Dialogue: 0,0:11:59.92,0:12:04.30,Default,,0,0,0,,Осы уақыт бойы... сен мені байламадың да.
Dialogue: 0,0:12:04.97,0:12:07.85,Default,,0,0,0,,Мені тікенмен байлаған мен едім...
Dialogue: 0,0:12:09.68,0:12:11.93,Default,,0,0,0,,Мен сені жақсы көретініңді қалаймын
Dialogue: 0,0:12:12.44,0:12:16.61,Default,,0,0,0,,Тікенектер өсіп, тарылды.
Dialogue: 0,0:12:20.78,0:12:22.70,Default,,0,0,0,,Мен жақсы көргім келді...
Dialogue: 0,0:12:23.20,0:12:24.32,Default,,0,0,0,,Ричард…
Dialogue: 0,0:12:24.41,0:12:26.74,Default,,0,0,0,,Энн, кешіріңіз.
Dialogue: 0,0:12:28.49,0:12:29.49,Default,,0,0,0,,Тікенектер...
Dialogue: 0,0:12:30.70,0:12:33.33,Default,,0,0,0,,Оны осы жерде және қазір бірге бөліп алайық.
Dialogue: 0,0:12:36.96,0:12:41.05,Default,,0,0,0,,Қанды жолды өз еркіммен таңдадым.
Dialogue: 0,0:12:41.63,0:12:44.30,Default,,0,0,0,,Сізге бұл жүкті көтерудің қажеті жоқ.
Dialogue: 0,0:12:47.89,0:12:48.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:51.27,0:12:55.39,Default,,0,0,0,,Эдвард... Мен сені жақсы көремін
Dialogue: 0,0:12:56.35,0:12:59.44,Default,,0,0,0,,Мен бәрін жоғалтсам да...
Dialogue: 0,0:13:00.82,0:13:03.11,Default,,0,0,0,,Ол Лондоннан кеткенде
Dialogue: 0,0:13:03.19,0:13:05.32,Default,,0,0,0,,Мұрагер ханзада қайтыс болды деп жарияланды.
Dialogue: 0,0:13:06.16,0:13:08.28,Default,,0,0,0,,Мен жерлеуді соғысқа дейін өткізгім келеді.
Dialogue: 0,0:13:10.03,0:13:12.62,Default,,0,0,0,,Бұл... Аннадан келген хат па?
Dialogue: 0,0:13:13.12,0:13:15.00,Default,,0,0,0,,Неге мөрді де ашпадың...
Dialogue: 0,0:13:30.05,0:13:31.97,Default,,0,0,0,,Бұл шынымен де жақсы болды ма?
Dialogue: 0,0:13:32.47,0:13:35.43,Default,,0,0,0,,Мұрагердің өлімі - патшаға ауыр соққы.
Dialogue: 0,0:13:35.94,0:13:38.06,Default,,0,0,0,,Енді әйелің де өлсе...
Dialogue: 0,0:13:38.15,0:13:38.73,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:13:39.73,0:13:42.11,Default,,0,0,0,,Энн... міндетті түрде құтқарылады.
Dialogue: 0,0:13:42.19,0:13:47.45,Default,,0,0,0,,Сіз құтқарылмайтыныңызды білесіз, сондықтан менің тілегімді орындағыңыз келеді, солай ма?
Dialogue: 0,0:13:47.53,0:13:50.12,Default,,0,0,0,,Енді бұл менің де тілегім
Dialogue: 0,0:13:51.12,0:13:54.29,Default,,0,0,0,,Мұны Эдвардқа беріңіз.
Dialogue: 0,0:13:55.29,0:13:56.66,Default,,0,0,0,,Әкемнен қалған естелік.
Dialogue: 0,0:13:58.29,0:14:00.29,Default,,0,0,0,,Джейн Эдвард...
Dialogue: 0,0:14:00.79,0:14:05.84,Default,,0,0,0,,Жоқ... Мен енді ешкім емес баланы сұраймын.
Dialogue: 0,0:14:07.59,0:14:09.76,Default,,0,0,0,,Мәртебелі! Кіруге Болмайды!
Dialogue: 0,0:14:09.84,0:14:12.10,Default,,0,0,0,,Егер патшайымның ауруы таралса...
Dialogue: 0,0:14:12.18,0:14:15.27,Default,,0,0,0,,Маған кедергі жасама! Анна менің әйелім!
Dialogue: 0,0:14:15.77,0:14:16.60,Default,,0,0,0,,Ричард…
Dialogue: 0,0:14:17.81,0:14:20.06,Default,,0,0,0,,Төсекке жат, Энн.
Dialogue: 0,0:14:20.15,0:14:21.44,Default,,0,0,0,,Дене жарақаты
Dialogue: 0,0:14:21.94,0:14:25.48,Default,,0,0,0,,Біз ол баланы жоғалтқан жоқпыз.
Dialogue: 0,0:14:25.57,0:14:26.32,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:14:26.40,0:14:30.28,Default,,0,0,0,,Әй, ол бала жаңа өмірге ие болды.
Dialogue: 0,0:14:32.20,0:14:33.24,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:33.33,0:14:34.33,Default,,0,0,0,,Энн!
Dialogue: 0,0:14:35.74,0:14:36.95,Default,,0,0,0,,Ричард…
Dialogue: 0,0:14:37.75,0:14:40.17,Default,,0,0,0,,Енді мен тыныш өле аламын.
Dialogue: 0,0:14:40.25,0:14:43.50,Default,,0,0,0,,Ақымақ болма. Жақында сауығып кетесің.
Dialogue: 0,0:14:44.00,0:14:46.21,Default,,0,0,0,,Сауығуды тойлау үшін той дайындаймыз.
Dialogue: 0,0:14:46.71,0:14:49.13,Default,,0,0,0,,Мен де саған жаңа көйлек тіктірдім...
Dialogue: 0,0:14:49.22,0:14:51.43,Default,,0,0,0,,Сіз көйлекті киесіз.
Dialogue: 0,0:14:51.93,0:14:54.68,Default,,0,0,0,,Маған сенің көйлегің ұнайды
Dialogue: 0,0:14:54.76,0:14:57.85,Default,,0,0,0,,Мен сенің қалағаныңды орындаймын.
Dialogue: 0,0:14:58.52,0:15:02.44,Default,,0,0,0,,Патша орындай алмайтын тілек жоқ.
Dialogue: 0,0:15:04.40,0:15:06.23,Default,,0,0,0,,Мәртебелі Король
Dialogue: 0,0:15:06.32,0:15:10.99,Default,,0,0,0,,Біз ұлы мәртебеліге шексіз мейірімділігі үшін шын жүректен алғыс айтамыз.
Dialogue: 0,0:15:11.07,0:15:14.20,Default,,0,0,0,,Менің қызым тіпті керемет көйлек алды...
Dialogue: 0,0:15:14.28,0:15:16.62,Default,,0,0,0,,Мұның бәрі Энннің қалауы.
Dialogue: 0,0:15:17.12,0:15:19.37,Default,,0,0,0,,Бұл көйлек де Аннаға арналған.
Dialogue: 0,0:15:20.12,0:15:23.17,Default,,0,0,0,,Оны киіп алсаң қуанады.
Dialogue: 0,0:15:24.84,0:15:28.63,Default,,0,0,0,,Ағамның алдында қандай жүз жасауым керек?
Dialogue: 0,0:15:28.71,0:15:30.84,Default,,0,0,0,,Ағамның жауына құда түссем де...
Dialogue: 0,0:15:30.92,0:15:33.43,Default,,0,0,0,,Бірақ мен үйленбегенмін.
Dialogue: 0,0:15:33.93,0:15:35.80,Default,,0,0,0,,Анна патшайым өлгелі жатыр
Dialogue: 0,0:15:36.68,0:15:40.56,Default,,0,0,0,,Сондықтан Ричард сіздің қаныңызды қалайды.
Dialogue: 0,0:15:40.64,0:15:41.73,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:15:41.81,0:15:44.40,Default,,0,0,0,,үшін сенің бақытың үшін.
Dialogue: 0,0:15:44.90,0:15:48.69,Default,,0,0,0,,Егер сіз сарайға оралғыңыз келсе, мен оны орындаймын.
Dialogue: 0,0:15:48.78,0:15:53.82,Default,,0,0,0,,Өйткені сен менің соңғы үмітімсің
Dialogue: 0,0:15:56.03,0:15:57.24,Default,,0,0,0,,Ағай!
Dialogue: 0,0:16:01.29,0:16:03.42,Default,,0,0,0,,Мен сенбеймін.
Dialogue: 0,0:16:03.50,0:16:06.04,Default,,0,0,0,,Ағам туралы қанша жаман сөз айтса да,
Dialogue: 0,0:16:08.84,0:16:12.05,Default,,0,0,0,,Алдағы өміріңіз берекелі болсын.
Dialogue: 0,0:16:12.55,0:16:15.51,Default,,0,0,0,,Тыныштықпен өмір сүруіңді тілеймін.
Dialogue: 0,0:16:16.01,0:16:19.56,Default,,0,0,0,,Эдвард сізге әрқашан қамқорлық жасады.
Dialogue: 0,0:16:20.06,0:16:21.52,Default,,0,0,0,,Ричард
Dialogue: 0,0:16:21.60,0:16:26.65,Default,,0,0,0,,Бізді азат еткен сенің мейірімділігің болса да.
Dialogue: 0,0:16:26.73,0:16:32.19,Default,,0,0,0,,Ойынның мейірімімен, Өз қабіріңді қаздың.
Dialogue: 0,0:16:33.20,0:16:34.53,Default,,0,0,0,,Менің атым граф Ричмонд⸺
Dialogue: 0,0:16:34.61,0:16:36.12,Default,,0,0,0,,Генри Тюдор!
Dialogue: 0,0:16:36.20,0:16:39.37,Default,,0,0,0,,Мен бұл елді сенен қайтаруға келдім.
Dialogue: 0,0:16:39.95,0:16:41.37,Default,,0,0,0,,Құрметті ержүрек жауынгерлер
Dialogue: 0,0:16:41.45,0:16:44.29,Default,,0,0,0,,Ричмондқа күшіңізді беріңіз.
Dialogue: 0,0:16:44.37,0:16:46.71,Default,,0,0,0,,Жын патшасын жеңу үшін!
Dialogue: 0,0:16:46.79,0:16:47.92,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:16:48.00,0:16:50.05,Default,,0,0,0,,Ричард III-ді жеңіңіз!
Dialogue: 0,0:16:50.13,0:16:53.05,Default,,0,0,0,,Ібіліс! шайтан! шайтан!
Dialogue: 0,0:17:00.18,0:17:02.73,Default,,0,0,0,,Құрметті Ричард!
Dialogue: 0,0:17:03.23,0:17:06.06,Default,,0,0,0,,Есіңде ме? Сол мереке күні...
Dialogue: 0,0:17:06.94,0:17:10.02,Default,,0,0,0,,Сол жолы сен мені билеуімді өтінді.
Dialogue: 0,0:17:10.11,0:17:11.90,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,0:17:12.53,0:17:13.69,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:17:14.19,0:17:16.86,Default,,0,0,0,,Мен Ричардты еске алғанда
Dialogue: 0,0:17:16.95,0:17:20.28,Default,,0,0,0,,Таң атқанда қараңғылықтан тұрамын.
Dialogue: 0,0:17:21.37,0:17:24.16,Default,,0,0,0,,Бір күні сенімен тағы билей алсам
Dialogue: 0,0:17:24.25,0:17:26.37,Default,,0,0,0,,Қандай қызық!
Dialogue: 0,0:17:26.96,0:17:29.38,Default,,0,0,0,,Сол күн келгенше, өтінемін
Dialogue: 0,0:17:30.00,0:17:33.34,Default,,0,0,0,,Бақытты болсын
Dialogue: 0,0:17:39.22,0:17:41.10,Default,,0,0,0,,(Ричардтың жөтелі)
Dialogue: 0,0:17:42.72,0:17:44.39,Default,,0,0,0,,Англияның ержүрек ерлері!
Dialogue: 0,0:17:44.89,0:17:50.11,Default,,0,0,0,,Сатқын Ричмонд енді біздің заңды тағымызды тартып алмақшы.
Dialogue: 0,0:17:50.19,0:17:52.98,Default,,0,0,0,,Мен бұл елді басып жүрмін, Лондонға бет алдым.
Dialogue: 0,0:17:53.98,0:17:58.16,Default,,0,0,0,,Бірақ біздің жаулар бір кезде бұл елден қашқан жеңілгендер.
Dialogue: 0,0:17:59.20,0:18:02.24,Default,,0,0,0,,Бізді тікеннің тікеніндей ренжітетін ешнәрсенің күші жоқ.
Dialogue: 0,0:18:02.74,0:18:05.37,Default,,0,0,0,,Біз туған жерді қорғайтын әділет қалқанымыз
Dialogue: 0,0:18:06.04,0:18:08.25,Default,,0,0,0,,Патша атымен ұрыс алаңына аттаныңыз!
Dialogue: 0,0:18:08.75,0:18:09.58,Default,,0,0,0,,Наурыз!
Dialogue: 0,0:18:10.33,0:18:14.05,Default,,0,0,0,,Ричмондтың құдай қамқорлығы болса да
Dialogue: 0,0:18:14.67,0:18:17.13,Default,,0,0,0,,Жолымда енді тікен жоқ
Dialogue: 0,0:18:17.63,0:18:20.76,Default,,0,0,0,,Маған ештеңе қалмады...
Dialogue: 0,0:18:20.84,0:18:22.43,Default,,0,0,0,,Не істеп жатырсың! Жабыңыз!
Dialogue: 0,0:18:22.51,0:18:25.56,Default,,0,0,0,,Дөрекі! Кіммен сөйлесіп тұрсың?
Dialogue: 0,0:18:26.14,0:18:28.52,Default,,0,0,0,,Мен патшаның анасымын!
Dialogue: 0,0:18:28.60,0:18:29.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:31.06,0:18:34.27,Default,,0,0,0,,Сіз соғыста жеңіс үшін дұға етуге келдіңіз бе?
Dialogue: 0,0:18:34.36,0:18:38.32,Default,,0,0,0,,Иә, дұрыс, Ричмондтың жеңісі.
Dialogue: 0,0:18:38.40,0:18:41.28,Default,,0,0,0,,Олай болса, қорқыңызшы, анашым.
Dialogue: 0,0:18:41.37,0:18:42.78,Default,,0,0,0,,Марш барабанының дыбысы!
Dialogue: 0,0:18:42.87,0:18:44.03,Default,,0,0,0,,Ричард
Dialogue: 0,0:18:44.12,0:18:45.99,Default,,0,0,0,,Сіз дүниеге келген күн...
Dialogue: 0,0:18:46.08,0:18:46.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:47.00,0:18:50.46,Default,,0,0,0,,Жан түршігерлік дауыл ағаштарды құлатты.
Dialogue: 0,0:18:50.54,0:18:54.04,Default,,0,0,0,,Үкі сайрап, түнгі қарға!
Dialogue: 0,0:18:54.13,0:18:58.34,Default,,0,0,0,,Сіздің анаңыз босану кезінде ерекше ауыртпалық көрді.
Dialogue: 0,0:18:58.84,0:19:01.55,Default,,0,0,0,,Оның үстіне мен...
Dialogue: 0,0:19:02.05,0:19:06.56,Default,,0,0,0,,Құдайдың еркіне мойынсұнбаған қанды шайтан!
Dialogue: 0,0:19:10.23,0:19:12.90,Default,,0,0,0,,Мені қинаған дауыс...
Dialogue: 0,0:19:13.65,0:19:16.44,Default,,0,0,0,,Бұл менің анамның дауысы ма?
Dialogue: 0,0:19:16.94,0:19:21.07,Default,,0,0,0,,Ричард, сен патша болуға лайық емессің.
Dialogue: 0,0:19:21.66,0:19:24.32,Default,,0,0,0,,Мен мұны болмай тұрып ашуым керек еді.
Dialogue: 0,0:19:24.83,0:19:29.50,Default,,0,0,0,,Біз құпияны жер астына апаруды жоспарладық...
Dialogue: 0,0:19:30.87,0:19:32.67,Default,,0,0,0,,Сенің әкең
Dialogue: 0,0:19:32.75,0:19:36.42,Default,,0,0,0,,Ричард, Йорк герцогы Плантагенет емес
Dialogue: 0,0:19:36.50,0:19:37.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:40.47,0:19:44.34,Default,,0,0,0,,Мен сіздің бос сөзіңізге бұдан былай төтеп бере алмаймын.
Dialogue: 0,0:19:44.43,0:19:46.85,Default,,0,0,0,,Туғанға дейін он ай он күн
Dialogue: 0,0:19:47.89,0:19:50.27,Default,,0,0,0,,Ланкастермен шайқас күндері
Dialogue: 0,0:19:50.35,0:19:54.31,Default,,0,0,0,,Менің күйеуім Ричардтың көңіл-күйі мен ашуы басым болды.
Dialogue: 0,0:19:54.90,0:19:58.78,Default,,0,0,0,,Таққа деген құштарлығым мен қысымның арасында маған орын жоқ.
Dialogue: 0,0:19:59.40,0:20:01.70,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:20:02.70,0:20:05.28,Default,,0,0,0,,Мен әкеме де, басқа бауырларыма да ұқсамаймын.
Dialogue: 0,0:20:05.78,0:20:08.74,Default,,0,0,0,,Сіз туралы бәрі соның дәлелі!
Dialogue: 0,0:20:10.70,0:20:14.42,Default,,0,0,0,,Менің әкеме ұқсамайтыным рас.
Dialogue: 0,0:20:14.92,0:20:17.38,Default,,0,0,0,,Бірақ ол менің анама ұқсайды.
Dialogue: 0,0:20:17.46,0:20:18.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:18.92,0:20:22.05,Default,,0,0,0,,Өзіңіз қалаған, бірақ қол жеткізе алмайтын нәрсені ұстаңыз
Dialogue: 0,0:20:22.13,0:20:26.01,Default,,0,0,0,,Мен негізсіз азаптан құтылу үшін өзімді жазаладым.
Dialogue: 0,0:20:26.51,0:20:29.22,Default,,0,0,0,,Өзімді күнәһар, шайтан деп ойлаймын
Dialogue: 0,0:20:29.31,0:20:31.64,Default,,0,0,0,,Олай ойламасаң, мен шыдай алмаймын.
Dialogue: 0,0:20:31.73,0:20:33.27,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:33.35,0:20:34.35,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:20:35.65,0:20:37.90,Default,,0,0,0,,Сіз күнәкар емессіз
Dialogue: 0,0:20:38.40,0:20:40.94,Default,,0,0,0,,Сіз құрбан болдыңыз
Dialogue: 0,0:20:42.61,0:20:45.49,Default,,0,0,0,,Жоқ! Мен құрбан емеспін!
Dialogue: 0,0:20:45.57,0:20:47.95,Default,,0,0,0,,Мен кінәлі болдым!
Dialogue: 0,0:20:48.03,0:20:50.66,Default,,0,0,0,,Соның жазасы ретінде сен тудың!
Dialogue: 0,0:20:51.25,0:20:54.04,Default,,0,0,0,,Күйеуім мені әрқашан жақсы көрсе де
Dialogue: 0,0:20:54.54,0:20:57.13,Default,,0,0,0,,Сол адам... Ол кісі...
Dialogue: 0,0:20:57.63,0:21:01.38,Default,,0,0,0,,Сен мені қараңғылыққа дейін сүймедің...
Dialogue: 0,0:21:02.01,0:21:04.55,Default,,0,0,0,,Тым жұқа және сенімсіз
Dialogue: 0,0:21:05.05,0:21:07.84,Default,,0,0,0,,Мен сияқты кішкентай дене
Dialogue: 0,0:21:08.43,0:21:11.89,Default,,0,0,0,,Сіз ұзақ уақыт бойы осы адамның бақылауында болдыңыз ба?
Dialogue: 0,0:21:13.18,0:21:16.27,Default,,0,0,0,,Анашым, дұға етіңіз.
Dialogue: 0,0:21:17.10,0:21:20.77,Default,,0,0,0,,Ричмондтың жеңісі және менің өлімім
Dialogue: 0,0:21:21.82,0:21:25.15,Default,,0,0,0,,Егер ол сізді жұбатса
Dialogue: 0,0:21:26.41,0:21:31.08,Default,,0,0,0,,Мен сені қанша жек көрсем де... мен...
Dialogue: 0,0:21:31.91,0:21:33.58,Default,,0,0,0,,Шындық ...
Dialogue: 0,0:21:39.96,0:21:42.50,Default,,0,0,0,,Қош бол анашым
Dialogue: 0,0:21:44.21,0:21:47.38,Default,,0,0,0,,Менің... қарғысым.
Dialogue: 0,0:22:01.40,0:22:03.40,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.86,0:23:30.86,Default,,0,0,0,,～♪
