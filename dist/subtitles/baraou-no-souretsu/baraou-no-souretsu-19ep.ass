Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.71,0:00:06.58,Default,,0,0,0,,Барлығы басталып, аяқталады
Dialogue: 0,0:00:07.63,0:00:11.55,Default,,0,0,0,,Сол сақинаның ішінде мен кенеттен дүниеге келдім.
Dialogue: 0,0:00:12.55,0:00:13.51,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:00:14.59,0:00:17.47,Default,,0,0,0,,Бүгіннен бастап сіз Джеймс Тайреллсіз.
Dialogue: 0,0:00:18.51,0:00:21.06,Default,,0,0,0,,Барлығына құтқару сыйла
Dialogue: 0,0:00:22.48,0:00:24.39,Default,,0,0,0,,Джеймс Тиррелл қайда?
Dialogue: 0,0:00:24.98,0:00:27.23,Default,,0,0,0,,Тиррелл — қойшы күйеу
Dialogue: 0,0:00:27.73,0:00:31.74,Default,,0,0,0,,Жұмысыңның орнына тамақ пен төсек береміз.
Dialogue: 0,0:00:32.49,0:00:34.45,Default,,0,0,0,,Енді қойшыға айт.
Dialogue: 0,0:00:34.53,0:00:39.12,Default,,0,0,0,,Келесі король Ричард бұдан былай сіздің қожайыныңыз болады.
Dialogue: 0,0:00:41.62,0:00:43.58,Default,,0,0,0,,Өмір бойы жазаланады
Dialogue: 0,0:00:45.25,0:00:48.42,Default,,0,0,0,,Біз бүгін жойылу үшін өмір сүреміз.
Dialogue: 0,0:00:52.51,0:00:54.55,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:00:54.63,0:00:56.72,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:00:57.22,0:01:03.18,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:03.68,0:01:08.48,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:12.48,0:01:14.49,Default,,0,0,0,,♪～
Dialogue: 0,0:02:38.82,0:02:40.82,Default,,0,0,0,,～♪
Dialogue: 0,0:02:43.41,0:02:44.41,Default,,0,0,0,,Суық емес пе?
Dialogue: 0,0:02:44.99,0:02:47.37,Default,,0,0,0,,Бұл сізде болса, жақсы.
Dialogue: 0,0:02:47.87,0:02:49.29,Default,,0,0,0,,Бірақ оның дәмі қорқынышты.
Dialogue: 0,0:02:49.87,0:02:52.21,Default,,0,0,0,,Ыстық сорпа пісірсем ғой...
Dialogue: 0,0:02:56.00,0:02:58.67,Default,,0,0,0,,Сол кезді ұмыт...
Dialogue: 0,0:03:01.22,0:03:03.43,Default,,0,0,0,,Маған сенің осында болуың керек.
Dialogue: 0,0:03:09.23,0:03:10.52,Default,,0,0,0,,Діріл
Dialogue: 0,0:03:11.81,0:03:13.94,Default,,0,0,0,,Қараңғылық пен өткенді бірге алып жүрейік.
Dialogue: 0,0:03:15.06,0:03:16.90,Default,,0,0,0,,Мен сенің жарыммын
Dialogue: 0,0:03:19.90,0:03:21.36,Default,,0,0,0,,есімде
Dialogue: 0,0:03:24.32,0:03:27.91,Default,,0,0,0,,Менің жүрегімді өлтірген адам...
Dialogue: 0,0:03:29.04,0:03:31.71,Default,,0,0,0,,Мен өлтірген жігіт туралы
Dialogue: 0,0:03:31.79,0:03:33.79,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:03:36.21,0:03:38.05,Default,,0,0,0,,Сіз маған бір рет айттыңыз
Dialogue: 0,0:03:38.55,0:03:40.92,Default,,0,0,0,,«Мен сүйген адамымды өлтірдім»
Dialogue: 0,0:03:41.97,0:03:44.43,Default,,0,0,0,,О мен оны сүйдім
Dialogue: 0,0:03:45.55,0:03:48.77,Default,,0,0,0,,Бірақ бұл мен білмегендіктен болды
Dialogue: 0,0:03:49.89,0:03:53.69,Default,,0,0,0,,Ол Йорктың жауы, әкемнің жауы...
Dialogue: 0,0:03:54.35,0:03:55.81,Default,,0,0,0,,Ол Ланкастердің королі!
Dialogue: 0,0:03:55.90,0:03:56.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:57.86,0:04:03.53,Default,,0,0,0,,Ол кезде мен жас едім, адам төзгісіз уайым мен жалғыздықта өмір сүрдім.
Dialogue: 0,0:04:04.20,0:04:06.20,Default,,0,0,0,,Ол менің құтқарушым болды
Dialogue: 0,0:04:07.03,0:04:10.08,Default,,0,0,0,,Құрдас баладай бейкүнә
Dialogue: 0,0:04:10.95,0:04:14.12,Default,,0,0,0,,Әкесіндей жылы жүзді ересек адам
Dialogue: 0,0:04:15.04,0:04:20.09,Default,,0,0,0,,Бірақ... соңында ол мені сүйе алмады.
Dialogue: 0,0:04:20.80,0:04:26.30,Default,,0,0,0,,Жоғалып кеткен жара толғанда ашылады.
Dialogue: 0,0:04:27.14,0:04:30.68,Default,,0,0,0,,Сондықтан да мен бұл туралы ойланбай тұра алмаймын.
Dialogue: 0,0:04:31.93,0:04:33.23,Default,,0,0,0,,Бір күні сен де...
Dialogue: 0,0:04:35.98,0:04:36.73,Default,,0,0,0,,Ричард
Dialogue: 0,0:04:38.02,0:04:38.94,Default,,0,0,0,,Маған атыммен қоңырау шалыңыз
Dialogue: 0,0:04:40.23,0:04:41.32,Default,,0,0,0,,Менің атым
Dialogue: 0,0:04:45.03,0:04:45.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:47.03,0:04:50.70,Default,,0,0,0,,Естеліктер уақыттың шіріп бара жатқан қалдықтарынан басқа ештеңе емес.
Dialogue: 0,0:04:52.70,0:04:53.75,Default,,0,0,0,,Генри
Dialogue: 0,0:04:56.79,0:04:59.17,Default,,0,0,0,,Хен... Ли
Dialogue: 0,0:05:00.42,0:05:04.42,Default,,0,0,0,,Неге... Мен бұл дыбысты білемін.
Dialogue: 0,0:05:09.47,0:05:13.39,Default,,0,0,0,,А... иә? Қызық, не болды?
Dialogue: 0,0:05:14.77,0:05:15.69,Default,,0,0,0,,Тоқтату мүмкін емес
Dialogue: 0,0:05:16.98,0:05:21.40,Default,,0,0,0,,Қойшы болғаныңда Қанның қызғанын сезгенде
Dialogue: 0,0:05:21.90,0:05:26.11,Default,,0,0,0,,Мен өзімнің әлсіреген тіршілігім біршама жанданғандай болды.
Dialogue: 0,0:05:26.61,0:05:28.66,Default,,0,0,0,,Букингем герцогінен
Dialogue: 0,0:05:28.74,0:05:31.49,Default,,0,0,0,,Маған белгілі бір адамды құтқару сұралды.
Dialogue: 0,0:05:31.99,0:05:32.87,Default,,0,0,0,,Оның аты...
Dialogue: 0,0:05:33.83,0:05:35.41,Default,,0,0,0,,Джордж Плантагенет
Dialogue: 0,0:05:35.91,0:05:38.46,Default,,0,0,0,,Король Эдвардтың інісі
Dialogue: 0,0:05:44.46,0:05:46.92,Default,,0,0,0,,Бірақ мүмкін
Dialogue: 0,0:05:47.01,0:05:49.93,Default,,0,0,0,,Мен туылғаннан бері...
Dialogue: 0,0:05:50.64,0:05:52.22,Default,,0,0,0,,Шындық ...
Dialogue: 0,0:05:54.64,0:05:57.19,Default,,0,0,0,,Мен де адамдарды жақсы көргім келеді
Dialogue: 0,0:05:57.69,0:05:59.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:59.85,0:06:02.57,Default,,0,0,0,,Не? Мен сені тексеремін
Dialogue: 0,0:06:04.86,0:06:05.86,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:06:07.90,0:06:10.41,Default,,0,0,0,,Не? Бұл адам бір жерде...
Dialogue: 0,0:06:11.70,0:06:13.66,Default,,0,0,0,,Ол Ланкастердің королі!
Dialogue: 0,0:06:14.24,0:06:17.29,Default,,0,0,0,,Иә, ұқсас болудан гөрі...
Dialogue: 0,0:06:18.04,0:06:19.33,Default,,0,0,0,,Бұл нағыз фотосурет
Dialogue: 0,0:06:20.75,0:06:21.88,Default,,0,0,0,,Есіміңді айт!
Dialogue: 0,0:06:22.38,0:06:26.17,Default,,0,0,0,,Мені алып кеткен адам – «Джеймс Тайрелл».
Dialogue: 0,0:06:26.26,0:06:27.80,Default,,0,0,0,,Джеймс Тайрелл…
Dialogue: 0,0:06:28.42,0:06:29.80,Default,,0,0,0,,Мен оны көптен бері қарап жүрмін
Dialogue: 0,0:06:30.89,0:06:35.35,Default,,0,0,0,,Сізбен сөйлесетін әдемі көрініс
Dialogue: 0,0:06:36.56,0:06:39.73,Default,,0,0,0,,Мен де сол жарқылға қосылғым келеді.
Dialogue: 0,0:06:42.27,0:06:46.73,Default,,0,0,0,,Қазір кетсең, кейін тілегіңді орындаймын.
Dialogue: 0,0:06:47.24,0:06:48.03,Default,,0,0,0,,Білсең, бар!
Dialogue: 0,0:06:58.66,0:07:02.33,Default,,0,0,0,,Қарапайым адамдарға тым мейірімді болу да мәселе.
Dialogue: 0,0:07:02.42,0:07:04.63,Default,,0,0,0,,Мен ұрып-соғуым керек.
Dialogue: 0,0:07:04.71,0:07:05.88,Default,,0,0,0,,Халыққа роялти...
Dialogue: 0,0:07:05.96,0:07:07.55,Default,,0,0,0,,Ал... Айтпақшы, Бет.
Dialogue: 0,0:07:07.63,0:07:09.09,Default,,0,0,0,,Неліктен патша сарайы?
Dialogue: 0,0:07:09.17,0:07:10.80,Default,,0,0,0,,Маған шақыру келді.
Dialogue: 0,0:07:11.63,0:07:15.51,Default,,0,0,0,,Ағатай, бетперде киіп жүрсеңіз қатыса алатыныңызға сенімдімін.
Dialogue: 0,0:07:15.60,0:07:17.77,Default,,0,0,0,,Мен туралы ойладың.
Dialogue: 0,0:07:18.89,0:07:20.85,Default,,0,0,0,,Элизабет апай...
Dialogue: 0,0:07:20.94,0:07:23.60,Default,,0,0,0,,Бұл таңқаларлық шығар, бірақ сен мені кешірдің.
Dialogue: 0,0:07:24.44,0:07:28.48,Default,,0,0,0,,Құдай бізден әлі бас тартқан жоқ
Dialogue: 0,0:07:29.07,0:07:32.82,Default,,0,0,0,,Мен саған әйтеуір көйлек алып беремін, киініп, кет.
Dialogue: 0,0:07:32.91,0:07:36.53,Default,,0,0,0,,Бірақ... сіз Ричард ағайды жек көресіз, солай ма?
Dialogue: 0,0:07:37.03,0:07:39.58,Default,,0,0,0,,Сіздің өміріңіз сіздікі
Dialogue: 0,0:07:40.16,0:07:44.00,Default,,0,0,0,,Қыз бақыты – ана бақыты
Dialogue: 0,0:07:47.13,0:07:48.96,Default,,0,0,0,,Өйткені бұл сіздің анаңыз туралы.
Dialogue: 0,0:07:49.05,0:07:51.59,Default,,0,0,0,,Ол бірдеңе құрып жатқан болуы керек.
Dialogue: 0,0:07:52.26,0:07:53.51,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:07:55.60,0:07:59.10,Default,,0,0,0,,Мен... Барлығымен танысқым келеді.
Dialogue: 0,0:08:00.89,0:08:05.10,Default,,0,0,0,,Бірақ мен өзімнің жеке тұлғам ашылмай тұрып үйге барамын.
Dialogue: 0,0:08:07.44,0:08:08.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:08.52,0:08:11.44,Default,,0,0,0,,Мен көбірек билегім келеді
Dialogue: 0,0:08:11.94,0:08:14.28,Default,,0,0,0,,Бәріміз бірге билейміз бе?
Dialogue: 0,0:08:17.33,0:08:18.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:21.37,0:08:22.83,Default,,0,0,0,,Бұл тым көп.
Dialogue: 0,0:08:23.41,0:08:24.50,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:08:24.58,0:08:27.21,Default,,0,0,0,,Театр, қазір бәрі, бәрі.
Dialogue: 0,0:08:27.29,0:08:29.38,Default,,0,0,0,,Бұл қызық болып бара жатыр...
Dialogue: 0,0:08:29.46,0:08:33.09,Default,,0,0,0,,Егер көзге түссең, менің өміріме де қауіп төнеді!
Dialogue: 0,0:08:33.17,0:08:34.38,Default,,0,0,0,,Бірақ эй
Dialogue: 0,0:08:34.47,0:08:37.01,Default,,0,0,0,,Актерлердің барлығы дайын сияқты.
Dialogue: 0,0:08:37.09,0:08:39.01,Default,,0,0,0,,Актерлер ше? Иә
Dialogue: 0,0:08:39.72,0:08:43.43,Default,,0,0,0,,Сондай-ақ патшаның сценарийі, әке.
Dialogue: 0,0:08:43.52,0:08:45.60,Default,,0,0,0,,Әке... сонда?
Dialogue: 0,0:08:46.10,0:08:48.48,Default,,0,0,0,,Мені осылай атауға себеп бар ма...
Dialogue: 0,0:08:48.56,0:08:53.32,Default,,0,0,0,,Тағы да~ Бір тесіктің сезімін білетін дос емеспіз бе?
Dialogue: 0,0:08:54.24,0:08:57.28,Default,,0,0,0,,Сен менің емес әйелімнің баласысың.
Dialogue: 0,0:08:57.37,0:08:58.41,Default,,0,0,0,,Бұл жерден кет!
Dialogue: 0,0:08:58.49,0:09:01.58,Default,,0,0,0,,Менің енді бүлікшілермен араласуға ниетім жоқ!
Dialogue: 0,0:09:02.08,0:09:06.42,Default,,0,0,0,,Көтерілістің сізді папа деп атағанын қаламайсыз ба?
Dialogue: 0,0:09:06.50,0:09:09.59,Default,,0,0,0,,Бірақ мен, қазір патша, сізді шақырсам ше?
Dialogue: 0,0:09:09.67,0:09:11.96,Default,,0,0,0,,Иә? Бұл не...
Dialogue: 0,0:09:13.88,0:09:16.97,Default,,0,0,0,,Қайырлы күн, қайын ата.
Dialogue: 0,0:09:17.05,0:09:18.93,Default,,0,0,0,,Сондай-ақ патша сарайында
Dialogue: 0,0:09:22.52,0:09:23.98,Default,,0,0,0,,Киіміңізді осы жерден ауыстырыңыз
Dialogue: 0,0:09:24.56,0:09:25.52,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:09:31.52,0:09:33.65,Default,,0,0,0,,Бұл түннің соңы.
Dialogue: 0,0:09:34.82,0:09:36.74,Default,,0,0,0,,Патшалар мен герцогтерге оралу
Dialogue: 0,0:09:37.24,0:09:40.32,Default,,0,0,0,,Иә... Мәртебелі патша.
Dialogue: 0,0:09:42.95,0:09:43.45,Default,,0,0,0,,Генри…
Dialogue: 0,0:09:54.76,0:09:58.43,Default,,0,0,0,,Әй, өмір бойы той болса ғой.
Dialogue: 0,0:09:58.51,0:10:02.22,Default,,0,0,0,,Алданбаңыз, кеш қызық болды.
Dialogue: 0,0:10:02.31,0:10:04.39,Default,,0,0,0,,Сол кезде сол жерде болған сұлу ханшайым
Dialogue: 0,0:10:04.47,0:10:05.85,Default,,0,0,0,,Қызық, бұл кім болды?
Dialogue: 0,0:10:05.93,0:10:09.69,Default,,0,0,0,,Кеште мысықша киінген қызды көрмедің бе?
Dialogue: 0,0:10:10.19,0:10:12.36,Default,,0,0,0,,Ол сүйкімді бала.
Dialogue: 0,0:10:12.44,0:10:14.69,Default,,0,0,0,,Мен сенімен биледім.
Dialogue: 0,0:10:14.78,0:10:17.70,Default,,0,0,0,,Әй... сонда мен сенің жүзіңді көрдім.
Dialogue: 0,0:10:17.78,0:10:22.03,Default,,0,0,0,,Бұл бала ұлы мәртебелі ұлдарының бірі Эдвард.
Dialogue: 0,0:10:22.12,0:10:24.79,Default,,0,0,0,,Патшайымның ізі қалған болуы мүмкін.
Dialogue: 0,0:10:24.87,0:10:27.50,Default,,0,0,0,,Мен Лондонға осы уақытқа дейін әрең келдім.
Dialogue: 0,0:10:27.58,0:10:29.62,Default,,0,0,0,,Менің жүзімді ешкім білмейді
Dialogue: 0,0:10:29.71,0:10:31.58,Default,,0,0,0,,Менің білгенімді қаламаған шығарсыз.
Dialogue: 0,0:10:32.21,0:10:33.54,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:10:34.21,0:10:37.01,Default,,0,0,0,,Корольге мүлдем ұқсамайды
Dialogue: 0,0:10:37.59,0:10:38.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:38.92,0:10:40.01,Default,,0,0,0,,Аа, дәл осы.
Dialogue: 0,0:10:40.51,0:10:41.76,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:45.43,0:10:46.64,Default,,0,0,0,,Лорд Эдвард?
Dialogue: 0,0:10:47.48,0:10:51.69,Default,,0,0,0,,Әкем күрескенді жақсы көретін...
Dialogue: 0,0:10:53.06,0:10:58.11,Default,,0,0,0,,Мен мүлде жақсы емеспін, ал оқу қызықтырақ.
Dialogue: 0,0:10:59.24,0:11:02.57,Default,,0,0,0,,Соғыс әлемінде соғысудан басқа амалымыз қалмады.
Dialogue: 0,0:11:03.16,0:11:05.03,Default,,0,0,0,,Сізді қызықтыратын нәрсе бар ма?
Dialogue: 0,0:11:05.91,0:11:09.25,Default,,0,0,0,,Мен әкеме мүлдем ұқсамаймын.
Dialogue: 0,0:11:09.75,0:11:10.50,Default,,0,0,0,,Маған айтты
Dialogue: 0,0:11:11.71,0:11:15.29,Default,,0,0,0,,Мен әкемнің баласы емеспін.
Dialogue: 0,0:11:16.38,0:11:17.42,Default,,0,0,0,,Эдвард
Dialogue: 0,0:11:18.88,0:11:20.13,Default,,0,0,0,,Әке...
Dialogue: 0,0:11:20.72,0:11:21.97,Default,,0,0,0,,(Каттея) Біз сол арнайы елшімен Гардарикке барамыз —
Dialogue: 0,0:11:23.55,0:11:25.89,Default,,0,0,0,,Бірінші рет тойда болды.
Dialogue: 0,0:11:25.97,0:11:28.47,Default,,0,0,0,,Сол кезде мен таң қалдым.
Dialogue: 0,0:11:28.97,0:11:30.77,Default,,0,0,0,,Бірақ түн батқанда...
Dialogue: 0,0:11:31.60,0:11:34.40,Default,,0,0,0,,Бұл рас, шаштың түсіне қараңызшы.
Dialogue: 0,0:11:34.48,0:11:36.27,Default,,0,0,0,,Мен патшаның қанын сезбейтін сияқтымын.
Dialogue: 0,0:11:36.36,0:11:39.49,Default,,0,0,0,,Жарықтың себебі көкек бала ма?
Dialogue: 0,0:11:40.95,0:11:44.49,Default,,0,0,0,,Барлығы маған қарап, жасырын түрде оғаш істермен айналысты...
Dialogue: 0,0:11:44.57,0:11:46.99,Default,,0,0,0,,Ерлі-зайыптылар ұзақ уақыт бойы нашар қарым-қатынаста болды.
Dialogue: 0,0:11:47.58,0:11:48.99,Default,,0,0,0,,Бұл жай ғана келіспеушілік пе?
Dialogue: 0,0:11:49.08,0:11:52.21,Default,,0,0,0,,Сол өсек бәрінің есінде.
Dialogue: 0,0:11:53.67,0:11:54.42,Default,,0,0,0,,Ібіліс
Dialogue: 0,0:11:54.50,0:11:55.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:56.46,0:11:58.67,Default,,0,0,0,,Менің әкем шайтан...
Dialogue: 0,0:11:59.17,0:12:01.92,Default,,0,0,0,,Мен ештеңе айта алмадым.
Dialogue: 0,0:12:03.22,0:12:07.56,Default,,0,0,0,,Маған ұнамады, бірақ ештеңе айтуға қорықтым.
Dialogue: 0,0:12:07.64,0:12:11.10,Default,,0,0,0,,Мен әлсіз болғандықтан, күштірек болуым керек...
Dialogue: 0,0:12:13.64,0:12:15.31,Default,,0,0,0,,Мен оны бір сәт көз алдыма елестеттім
Dialogue: 0,0:12:16.11,0:12:20.15,Default,,0,0,0,,Бұл баланың анам сияқты маған бетін қайтаруы.
Dialogue: 0,0:12:23.20,0:12:25.36,Default,,0,0,0,,Бақша әдемі.
Dialogue: 0,0:12:25.87,0:12:27.78,Default,,0,0,0,,Мен сенің жасыңда едім
Dialogue: 0,0:12:28.28,0:12:31.50,Default,,0,0,0,,Мен ешқашан гүлдерді әдемі деп ойламаппын.
Dialogue: 0,0:12:32.25,0:12:34.79,Default,,0,0,0,,Ақ раушан - кек алу анты
Dialogue: 0,0:12:35.29,0:12:37.84,Default,,0,0,0,,Қызыл раушан - төгілген қанның дәлелі
Dialogue: 0,0:12:39.13,0:12:42.59,Default,,0,0,0,,Бірақ қазір бәрі әдемі болып көрінеді
Dialogue: 0,0:12:44.09,0:12:47.97,Default,,0,0,0,,Мағынаны іздеме, ол сонда ғана...
Dialogue: 0,0:12:51.27,0:12:54.69,Default,,0,0,0,,Білмей тұрып өзімді қымбат сезіндім.
Dialogue: 0,0:12:59.94,0:13:03.07,Default,,0,0,0,,Мен де әкеме ұқсамайтынмын.
Dialogue: 0,0:13:03.57,0:13:08.03,Default,,0,0,0,,Бірақ бізді осы дүниедегі басқалардан да күшті байланыс байланыстырдық.
Dialogue: 0,0:13:09.33,0:13:13.75,Default,,0,0,0,,Екіжүзділік пе, әлде аяушылық па? Сол сезімдердің шынайы табиғаты...
Dialogue: 0,0:13:14.83,0:13:17.96,Default,,0,0,0,,Әдемі, салқын, мейірімді...
Dialogue: 0,0:13:18.46,0:13:19.38,Default,,0,0,0,,Әке!
Dialogue: 0,0:13:21.05,0:13:23.76,Default,,0,0,0,,Әке – шырағым
Dialogue: 0,0:13:24.63,0:13:27.13,Default,,0,0,0,,Махаббаттың шын мәнін білмесең де
Dialogue: 0,0:13:28.30,0:13:31.22,Default,,0,0,0,,Мен қазір солай сезінемін.
Dialogue: 0,0:13:32.72,0:13:35.73,Default,,0,0,0,,Эдвард... менің ұлым
Dialogue: 0,0:13:36.94,0:13:39.36,Default,,0,0,0,,Бар болғаны...
Dialogue: 0,0:13:43.61,0:13:46.95,Default,,0,0,0,,Букингем Мен сенің мені неге шақырғаныңды білемін.
Dialogue: 0,0:13:47.03,0:13:47.91,Default,,0,0,0,,Иә
Dialogue: 0,0:13:47.99,0:13:51.24,Default,,0,0,0,,Бұл патша сарайында тараған ақымақ өсек шығар.
Dialogue: 0,0:13:51.83,0:13:53.54,Default,,0,0,0,,Қанша рет мөрленсе де
Dialogue: 0,0:13:53.62,0:13:56.46,Default,,0,0,0,,Қарғыс атқан өлідей қайта тірілу
Dialogue: 0,0:13:57.04,0:13:59.04,Default,,0,0,0,,Бұл патша үшін өлімге әкелетін өсек.
Dialogue: 0,0:14:00.63,0:14:02.42,Default,,0,0,0,,Эдвард да көңілсіз.
Dialogue: 0,0:14:04.76,0:14:08.01,Default,,0,0,0,,Мен қауесетті таратудың әдейі жасалғанын сеземін.
Dialogue: 0,0:14:08.51,0:14:11.72,Default,,0,0,0,,Тез арада шара қолданайық, Мәртебелі, сіз де шара қолдануыңызды өтінемін.
Dialogue: 0,0:14:12.22,0:14:13.14,Default,,0,0,0,,Онымен күресу керек пе?
Dialogue: 0,0:14:14.27,0:14:17.77,Default,,0,0,0,,Кінәлі табылса да, өсектің көзі жойылуы керек.
Dialogue: 0,0:14:17.85,0:14:19.69,Default,,0,0,0,,Дағдарыс қайта-қайта келеді
Dialogue: 0,0:14:20.90,0:14:25.03,Default,,0,0,0,,Королева тағы да ұлы мәртебеліден бала туды.
Dialogue: 0,0:14:25.53,0:14:28.82,Default,,0,0,0,,Бұл жалған қауесеттерді жоюдың ең жақсы жолы.
Dialogue: 0,0:14:30.49,0:14:31.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:31.62,0:14:35.45,Default,,0,0,0,,Мәртебелі, бұл менің патшаның сенімді адамы ретіндегі кеңесім.
Dialogue: 0,0:14:35.54,0:14:39.29,Default,,0,0,0,,Бірақ егер ол мені қабылдамаса...
Dialogue: 0,0:14:40.17,0:14:41.96,Default,,0,0,0,,Бұл менің денем...
Dialogue: 0,0:14:42.46,0:14:46.96,Default,,0,0,0,,Ешқандай емес... оның патшайым болуға белі бар.
Dialogue: 0,0:14:47.46,0:14:48.13,Default,,0,0,0,,Сіз білесіз
Dialogue: 0,0:14:48.22,0:14:49.17,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:14:50.18,0:14:52.30,Default,,0,0,0,,Ол мені танымайды
Dialogue: 0,0:14:54.10,0:14:55.10,Default,,0,0,0,,Қый!
Dialogue: 0,0:14:56.10,0:14:57.52,Default,,0,0,0,,Барлығы
Dialogue: 0,0:14:58.06,0:14:59.39,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:01.31,0:15:04.52,Default,,0,0,0,,Мен оны ешқашан ұстаған емеспін
Dialogue: 0,0:15:05.36,0:15:08.65,Default,,0,0,0,,Эдвард менің биологиялық балам емес.
Dialogue: 0,0:15:11.49,0:15:15.62,Default,,0,0,0,,Сіз ант бердіңіз... ешқандай құпия болған жоқ.
Dialogue: 0,0:15:16.33,0:15:17.37,Default,,0,0,0,,Букингем…
Dialogue: 0,0:15:17.45,0:15:18.79,Default,,0,0,0,,Мұраны жою
Dialogue: 0,0:15:19.66,0:15:21.58,Default,,0,0,0,,Эдвард В.
Dialogue: 0,0:15:21.67,0:15:25.21,Default,,0,0,0,,Мен сізді заңды қандасыңыз жоқ деп айыптағанымды ұмыттыңыз ба?
Dialogue: 0,0:15:25.71,0:15:27.50,Default,,0,0,0,,Егер сіздің қаныңыз болмаса, дереу...
Dialogue: 0,0:15:27.59,0:15:29.13,Default,,0,0,0,,Қан тегі дұрыс
Dialogue: 0,0:15:30.59,0:15:32.38,Default,,0,0,0,,Король Генри ұлының ұлы.
Dialogue: 0,0:15:32.97,0:15:34.68,Default,,0,0,0,,Ланкастер ханзадасы?
Dialogue: 0,0:15:34.76,0:15:38.27,Default,,0,0,0,,Ол тіпті бала емес, жаудың қаны бар дейсіз бе?
Dialogue: 0,0:15:38.35,0:15:40.35,Default,,0,0,0,,Сонда ағаңның баласы жақсы!
Dialogue: 0,0:15:40.94,0:15:43.35,Default,,0,0,0,,Мағынасы өткендегі естеліктерден өзгеше
Dialogue: 0,0:15:43.85,0:15:46.69,Default,,0,0,0,,Мұның қаншалықты қауіпті құпия екенін білу керек.
Dialogue: 0,0:15:47.19,0:15:49.32,Default,,0,0,0,,Король Ричард III үшін!
Dialogue: 0,0:15:53.03,0:15:55.49,Default,,0,0,0,,Мен Эдвардты қорғаймын.
Dialogue: 0,0:15:56.12,0:15:57.24,Default,,0,0,0,,Не болды саған, жексұрын? Неге күліп тұрсың!
Dialogue: 0,0:15:58.62,0:15:59.95,Default,,0,0,0,,Ол менің ұлым.
Dialogue: 0,0:16:02.29,0:16:04.46,Default,,0,0,0,,Барлық уақытта... біртүрлі сезінді.
Dialogue: 0,0:16:07.71,0:16:10.59,Default,,0,0,0,,Бірақ мен саған сендім.
Dialogue: 0,0:16:12.76,0:16:13.84,Default,,0,0,0,,Генри
Dialogue: 0,0:16:15.64,0:16:17.60,Default,,0,0,0,,Неліктен... неге?
Dialogue: 0,0:16:18.10,0:16:20.56,Default,,0,0,0,,Король Генри ұлының ұлы?
Dialogue: 0,0:16:21.14,0:16:24.56,Default,,0,0,0,,Құмарлыққа берілме, не істеу керектігін ойла
Dialogue: 0,0:16:24.65,0:16:26.90,Default,,0,0,0,,Шешімі болуы керек
Dialogue: 0,0:16:30.32,0:16:32.07,Default,,0,0,0,,Мен сені күттім, Генри.
Dialogue: 0,0:16:32.15,0:16:34.32,Default,,0,0,0,,Неліктен мұнда...
Dialogue: 0,0:16:34.82,0:16:38.16,Default,,0,0,0,,Дәл қазір сені уайымдауға шамасы жоқ. Шығу!
Dialogue: 0,0:16:38.24,0:16:40.74,Default,,0,0,0,,Маған ұнамайды, уәде бермедім бе?
Dialogue: 0,0:16:41.66,0:16:43.00,Default,,0,0,0,,Тиісті жеріңізге оралыңыз!
Dialogue: 0,0:16:43.08,0:16:45.54,Default,,0,0,0,,Маған ұнамайды. Сен айтпайынша мен үйге бармаймын.
Dialogue: 0,0:16:46.33,0:16:48.09,Default,,0,0,0,,Біз басқаларды қалай жақсы көре аламыз?
Dialogue: 0,0:16:48.59,0:16:53.05,Default,,0,0,0,,Сен ол адамды қалай жақсы көрсең, ол сені қалай жақсы көрсе...
Dialogue: 0,0:16:54.43,0:16:57.55,Default,,0,0,0,,Неліктен білгіңіз келеді? Махаббат және т.
Dialogue: 0,0:16:58.05,0:17:00.93,Default,,0,0,0,,Білсең, ешқашан қайтып орала алмайсың
Dialogue: 0,0:17:01.60,0:17:04.56,Default,,0,0,0,,Мен тікенді жолды кесіп аламын деп ойладым.
Dialogue: 0,0:17:05.14,0:17:08.15,Default,,0,0,0,,Ол кезде қорқатын ештеңе жоқ еді...
Dialogue: 0,0:17:09.15,0:17:13.11,Default,,0,0,0,,Қазірдің өзінде осы сәтте ойлар менің ойыма тосқауыл болып тұр.
Dialogue: 0,0:17:14.86,0:17:16.74,Default,,0,0,0,,Неге... Неге...
Dialogue: 0,0:17:17.66,0:17:19.95,Default,,0,0,0,,Мен сенен неге бас тарттым?
Dialogue: 0,0:17:22.87,0:17:23.83,Default,,0,0,0,,Не істеу керек!
Dialogue: 0,0:17:24.33,0:17:25.91,Default,,0,0,0,,Себебі сен қайғылы көріндің
Dialogue: 0,0:17:26.42,0:17:28.75,Default,,0,0,0,,Мені әлсіз адамдай көрме!
Dialogue: 0,0:17:29.29,0:17:31.63,Default,,0,0,0,,Бірақ мен кедейді құтқарғым келеді.
Dialogue: 0,0:17:32.13,0:17:35.51,Default,,0,0,0,,Мықтылар көмек сұрамайды
Dialogue: 0,0:17:35.59,0:17:39.26,Default,,0,0,0,,Дұрыс... Мен сені қаламаймын.
Dialogue: 0,0:17:40.60,0:17:42.10,Default,,0,0,0,,Бірақ Ричард ше?
Dialogue: 0,0:17:42.64,0:17:45.56,Default,,0,0,0,,Ричард Ланкастердің баласын қорғайтынын айтты.
Dialogue: 0,0:17:46.10,0:17:48.52,Default,,0,0,0,,Генри VI қаны...
Dialogue: 0,0:17:50.23,0:17:52.69,Default,,0,0,0,,Үлкен ағаңның жағдайы жақсы дейсің бе?
Dialogue: 0,0:17:54.07,0:17:54.82,Default,,0,0,0,,Неге...
Dialogue: 0,0:17:55.82,0:17:58.45,Default,,0,0,0,,Қараңғылық пен өткенді бірге алып жүргенде...
Dialogue: 0,0:17:59.24,0:18:01.28,Default,,0,0,0,,Мен бұл менің денемнің жартысы деп ант еттім.
Dialogue: 0,0:18:01.78,0:18:02.95,Default,,0,0,0,,(вазаның сынған дыбысы)
Dialogue: 0,0:18:06.83,0:18:07.87,Default,,0,0,0,,Мен, Ишикава және…
Dialogue: 0,0:18:08.75,0:18:11.38,Default,,0,0,0,,Мен қайтпасам ше?
Dialogue: 0,0:18:12.96,0:18:14.96,Default,,0,0,0,,Ол енді ешқашан...
Dialogue: 0,0:18:16.55,0:18:18.93,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:18:19.43,0:18:23.39,Default,,0,0,0,,Сабыр етіңіз, түсінбеушіліктің бұл деңгейін тез шешуге болады.
Dialogue: 0,0:18:23.89,0:18:25.64,Default,,0,0,0,,Мен қарсы шараларды әзірлеуге бардым.
Dialogue: 0,0:18:25.72,0:18:28.77,Default,,0,0,0,,Дұрыс, ол менің екінші жартым, мен жақын арада сенімдімін...
Dialogue: 0,0:18:28.85,0:18:30.52,Default,,0,0,0,,Букингем!
Dialogue: 0,0:18:32.48,0:18:33.82,Default,,0,0,0,,Бұл менмін, Ричард.
Dialogue: 0,0:18:34.32,0:18:35.15,Default,,0,0,0,,Анна…
Dialogue: 0,0:18:35.23,0:18:40.11,Default,,0,0,0,,Бүгін кешкі ас, бірақ қызметшілер бақшада акробатика көргісі келеді.
Dialogue: 0,0:18:40.61,0:18:42.24,Default,,0,0,0,,Мен сені сайқымазақ дей аламын ба?
Dialogue: 0,0:18:42.74,0:18:44.70,Default,,0,0,0,,А... Маған бәрібір.
Dialogue: 0,0:18:44.79,0:18:47.37,Default,,0,0,0,,Ричард, сен бозғылт көрінесің.
Dialogue: 0,0:18:48.66,0:18:51.96,Default,,0,0,0,,Банкет түні мен оны кештің ортасынан көре алмадым, бірақ
Dialogue: 0,0:18:52.46,0:18:54.63,Default,,0,0,0,,Сіз түні бойы ойнаған болуыңыз керек.
Dialogue: 0,0:18:56.88,0:19:00.68,Default,,0,0,0,,Сен сол түні шынымен әдемі болдың.
Dialogue: 0,0:19:01.26,0:19:04.39,Default,,0,0,0,,Ричард, кешкі асты ұйымдастыруды маған қалдыр.
Dialogue: 0,0:19:05.14,0:19:07.72,Default,,0,0,0,,Егер мен оны сайқымазақ деп атасам, Эдвард қуанар еді.
Dialogue: 0,0:19:08.73,0:19:10.69,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:19:12.48,0:19:14.19,Default,,0,0,0,,Мен сұрайын деп едім...
Dialogue: 0,0:19:15.40,0:19:17.86,Default,,0,0,0,,Сұлу әйел ұрлап кеткен шайтанның шынайы тұлғасы
Dialogue: 0,0:19:20.15,0:19:22.95,Default,,0,0,0,,Мен Ричардтың бұл бетті жасайтынына сене алмаймын...
Dialogue: 0,0:19:24.07,0:19:27.62,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұған ренжімеңіз
Dialogue: 0,0:19:28.87,0:19:32.79,Default,,0,0,0,,Сіз әрқашан қалағанның бәрі қазір осында.
Dialogue: 0,0:19:32.88,0:19:35.25,Default,,0,0,0,,Уау... Ахаха
Dialogue: 0,0:19:38.96,0:19:41.26,Default,,0,0,0,,Кейтсби Букингемге не болды?
Dialogue: 0,0:19:42.22,0:19:46.60,Default,,0,0,0,,Бүгін кешке өз бөлмеңде қонақтарыңмен кешкі ас ішетініңді естідім.
Dialogue: 0,0:19:48.56,0:19:49.56,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:19:50.14,0:19:53.77,Default,,0,0,0,,Әке, сізден бір жақсылығым бар. Бұл жақсы ма?
Dialogue: 0,0:19:53.85,0:19:55.23,Default,,0,0,0,,Не?
Dialogue: 0,0:19:55.73,0:19:58.90,Default,,0,0,0,,Бетті сарайға қайтаруыңызды қалаймын.
Dialogue: 0,0:20:00.19,0:20:01.28,Default,,0,0,0,,Мұрагерліктен айыру
Dialogue: 0,0:20:01.78,0:20:05.12,Default,,0,0,0,,Мереке түні бәріміз бірге билейік
Dialogue: 0,0:20:05.20,0:20:07.66,Default,,0,0,0,,Бет өте бақытты көрінді.
Dialogue: 0,0:20:08.54,0:20:10.70,Default,,0,0,0,,Сіз мені бұл баланы тастап кетуімді сұрайсыз ба?
Dialogue: 0,0:20:11.25,0:20:12.37,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:20:13.08,0:20:18.34,Default,,0,0,0,,Қанша тікен кедергі болса да, басқа жолы болуы керек.
Dialogue: 0,0:20:18.42,0:20:22.30,Default,,0,0,0,,Дұрыс? Бұл тәж де сенің арқаң болды...
Dialogue: 0,0:20:23.26,0:20:27.30,Default,,0,0,0,,Қанша сілкіп тастасам да, жүрегімнің түкпір-түкпірінде қараңғы, тоқырау.
Dialogue: 0,0:20:27.80,0:20:32.27,Default,,0,0,0,,Қараңғылық қойнауынан таныс қобалжу мен қорқыныш шығады...
Dialogue: 0,0:20:32.94,0:20:34.06,Default,,0,0,0,,Әке?
Dialogue: 0,0:20:34.56,0:20:36.48,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені жасай аласыз.
Dialogue: 0,0:20:36.56,0:20:37.48,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:38.15,0:20:39.15,Default,,0,0,0,,Ричард?
Dialogue: 0,0:20:39.23,0:20:41.49,Default,,0,0,0,,Уайымдама, мен бірден келемін.
Dialogue: 0,0:20:46.49,0:20:48.99,Default,,0,0,0,,Қайдасың... тездетіп жанымда бол
Dialogue: 0,0:20:50.62,0:20:51.70,Default,,0,0,0,,Генри!
Dialogue: 0,0:20:58.25,0:20:59.00,Default,,0,0,0,,Хаа…
Dialogue: 0,0:20:59.09,0:21:02.84,Default,,0,0,0,,Сайқымазақтар, билеу және жеуге болмайтын тағам
Dialogue: 0,0:21:03.34,0:21:04.97,Default,,0,0,0,,Патша керемет!
Dialogue: 0,0:21:05.55,0:21:08.43,Default,,0,0,0,,Бұрынғы патша қорада кітап оқумен айналысты.
Dialogue: 0,0:21:08.51,0:21:10.35,Default,,0,0,0,,Оқымайтын ақымақ бала
Dialogue: 0,0:21:10.43,0:21:12.39,Default,,0,0,0,,Тыныш бол, анаң туралы арманда.
Dialogue: 0,0:21:12.98,0:21:15.10,Default,,0,0,0,,«Мен сені сағындым~ Мама~»
Dialogue: 0,0:21:15.19,0:21:17.15,Default,,0,0,0,,«Мені тезірек алып кетіңізші~»
Dialogue: 0,0:21:17.23,0:21:20.86,Default,,0,0,0,,Бұл бір реттік ұйқыдағы әңгіме болды! Мағынасы болмас бұрын қанша рет айтуым керек?
Dialogue: 0,0:21:22.53,0:21:25.20,Default,,0,0,0,,Тек бірінші туылған қабілетсіз адам!
Dialogue: 0,0:21:25.70,0:21:28.28,Default,,0,0,0,,Онымен үнемі бірге болу – тозақ.
Dialogue: 0,0:21:29.49,0:21:32.20,Default,,0,0,0,,Мен бұл жерден қашан шыға аламын?
Dialogue: 0,0:21:32.29,0:21:35.25,Default,,0,0,0,,Ричард, мен өмірімнің соңына дейін осылай қалатыныма сене алмаймын...
Dialogue: 0,0:21:36.87,0:21:38.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:39.75,0:21:43.46,Default,,0,0,0,,Мәртебелі… Мәртебелі Король Эдвард V
Dialogue: 0,0:21:45.47,0:21:50.51,Default,,0,0,0,,Уайымдамаңыз, мен ұлы мәртебеліге көмектесуге келдім.
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
