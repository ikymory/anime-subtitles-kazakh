Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.58,0:00:02.42,Default,,0,0,0,,«Қара Джек 21»
Dialogue: 0,0:00:04.17,0:00:07.07,Default,,0,0,0,,Өмірдің шегі 21 сағат.
Dialogue: 0,0:00:07.07,0:00:10.30,Default,,0,0,0,,Қорқынышты да оғаш ауру Феникс ауруы адамзатты жоя ма?
Dialogue: 0,0:00:10.94,0:00:13.51,Default,,0,0,0,,Аспан ауруханасындағы үмітсіздік сандығы
Dialogue: 0,0:00:13.51,0:00:15.51,Default,,0,0,0,,Соңғы шайқас басталады
Dialogue: 0,0:01:39.73,0:01:42.03,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:01:42.03,0:01:44.62,Default,,0,0,0,,Қауіпсіздік жүйесінің шығарылымы
Dialogue: 0,0:01:45.53,0:01:48.87,Default,,0,0,0,,Ширахёши Мықты бол
Dialogue: 0,0:01:48.87,0:01:51.21,Default,,0,0,0,,Қара Джек Нишикава-кун және басқалар?
Dialogue: 0,0:01:51.21,0:01:53.14,Default,,0,0,0,,Бұл екеуі, дәл Мантоку сияқты.
Dialogue: 0,0:01:53.14,0:01:55.38,Default,,0,0,0,,Мен оны сіздің Қатерлі ісікке арналған аңшыға қойдым.
Dialogue: 0,0:01:55.38,0:01:56.52,Default,,0,0,0,,Сіз бәрібір уақытты сатып ала аласыз.
Dialogue: 0,0:01:58.48,0:01:59.80,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:01:59.84,0:02:03.49,Default,,0,0,0,,Сонымен... мен түсінемін. Ширабёши әлі жоқ.
Dialogue: 0,0:02:03.49,0:02:05.42,Default,,0,0,0,,Осы жігіттің баратын жерін өзгертіңіз.
Dialogue: 0,0:02:05.52,0:02:07.66,Default,,0,0,0,,Баратын жер? Бұл дұрыс
Dialogue: 0,0:02:07.66,0:02:10.02,Default,,0,0,0,,Дәл осылай, Sky Hospital Токиоға келсін.
Dialogue: 0,0:02:11.53,0:02:14.04,Default,,0,0,0,,Бүкіл Жапония вирус жұқтырған
Dialogue: 0,0:02:15.53,0:02:19.27,Default,,0,0,0,,Олай болса, қайда баруымыз керек... қайда баруымыз керек?
Dialogue: 0,0:02:19.27,0:02:24.08,Default,,0,0,0,,Солтүстік. Бұл нәрсенің бағытын өзгертіп, Солтүстік полюске ұшыңыз.
Dialogue: 0,0:02:24.21,0:02:27.51,Default,,0,0,0,,Солтүстік полюс? А, вирус белсенділігі
Dialogue: 0,0:02:27.51,0:02:29.16,Default,,0,0,0,,Төмен температурада әлсірейтіні белгілі
Dialogue: 0,0:02:35.38,0:02:40.00,Default,,0,0,0,,Ұшу жоспары қайта қаралды және біз қазір Солтүстік полюске қарай бет алып жатырмыз.
Dialogue: 0,0:02:40.22,0:02:42.72,Default,,0,0,0,,Ой Ширахёши Ширахёши
Dialogue: 0,0:02:52.03,0:02:55.07,Default,,0,0,0,,Күте тұрыңыз. Баратыныңызға сенімдісіз бе?
Dialogue: 0,0:02:55.07,0:02:57.37,Default,,0,0,0,,Иә, өйткені жағдай өзгерді.
Dialogue: 0,0:02:57.37,0:02:59.86,Default,,0,0,0,,Бірақ сіз өзіңізді тәуекелге ұшыратпасаңыз да
Dialogue: 0,0:02:59.90,0:03:02.02,Default,,0,0,0,,Ұйымды қайта іске қосу
Dialogue: 0,0:03:02.08,0:03:04.65,Default,,0,0,0,,Бізге дамыған вирус керек
Dialogue: 0,0:03:04.65,0:03:08.36,Default,,0,0,0,,Сонымен қатар, өз қолыммен атқаратын істерім бар.
Dialogue: 0,0:03:20.13,0:03:23.00,Default,,0,0,0,,Қара Джек, эй, өзіңді қатты итерме.
Dialogue: 0,0:03:23.00,0:03:25.33,Default,,0,0,0,,Соңында, эпинефриннен туындаған қан қысымы мен жүрек соғу жиілігінің ауытқулары
Dialogue: 0,0:03:25.33,0:03:28.24,Default,,0,0,0,,Мен жай ғана тынышталдым. А, ол ше?
Dialogue: 0,0:03:28.24,0:03:32.01,Default,,0,0,0,,Бұл ісікке қарсы және иммунитетті көтеретін дәрілердің қоспасы.
Dialogue: 0,0:03:32.01,0:03:34.51,Default,,0,0,0,,Ендеше, жеңілдеп қалар.
Dialogue: 0,0:03:34.51,0:03:38.18,Default,,0,0,0,,Мен қазірден бастап не істейтінімді шештім.
Dialogue: 0,0:03:38.18,0:03:40.85,Default,,0,0,0,,Біз Феникс ауруының емін тапқанша.
Dialogue: 0,0:03:40.85,0:03:42.78,Default,,0,0,0,,Сіз мұны шынымен жасайсыз ба?
Dialogue: 0,0:03:42.78,0:03:47.02,Default,,0,0,0,,Біз Феникс ауруы туралы ештеңе білмейміз... Иә?
Dialogue: 0,0:03:47.02,0:03:49.86,Default,,0,0,0,,Мұнда басыңыз Рикки әуе күштері базасы, Аляска жауабы
Dialogue: 0,0:03:49.86,0:03:51.79,Default,,0,0,0,,Мұнда қайталаңыз Аляска штаты…
Dialogue: 0,0:03:51.79,0:03:54.53,Default,,0,0,0,,Бұл АҚШ Әуе күштерінің шифрланған байланысы.
Dialogue: 0,0:03:54.53,0:03:57.20,Default,,0,0,0,,Қайталау Бұл Рики әуе күштерінің базасы.
Dialogue: 0,0:03:57.20,0:04:00.17,Default,,0,0,0,,Sky Hospital экипажына дереу жауап беруін айтыңыз.
Dialogue: 0,0:04:00.17,0:04:02.17,Default,,0,0,0,,Шұғыл жауапты қайталаңыз
Dialogue: 0,0:04:02.17,0:04:04.81,Default,,0,0,0,,Бұл Sky Hospital.
Dialogue: 0,0:04:04.81,0:04:07.64,Default,,0,0,0,,Күтпеген апатқа байланысты бұл ұшақ қазіргі уақытта... Доктор Уайт.
Dialogue: 0,0:04:07.64,0:04:10.68,Default,,0,0,0,,Тыңда, ұшақта вирус тарады.
Dialogue: 0,0:04:10.68,0:04:12.81,Default,,0,0,0,,Мен жағдайды толық білемін.
Dialogue: 0,0:04:12.81,0:04:16.48,Default,,0,0,0,,Президенттің көмекшісі жағдайды шешу үшін түсініктеме береді.
Dialogue: 0,0:04:16.48,0:04:19.82,Default,,0,0,0,,Өтінемін, ммм.
Dialogue: 0,0:04:19.82,0:04:21.76,Default,,0,0,0,,Бұл Кларк Боумен, менің көмекшім.
Dialogue: 0,0:04:21.76,0:04:24.99,Default,,0,0,0,,Сіздің батыл әрекеттеріңізге құрметімді білдіргім келеді.
Dialogue: 0,0:04:24.99,0:04:28.86,Default,,0,0,0,,Қазіргі уақытта сарапшылар жұқпалы ауруларды зерттеу жөніндегі халықаралық агенттіктен таңдалады.
Dialogue: 0,0:04:28.86,0:04:31.50,Default,,0,0,0,,Феникс ауруына қарсы шаралар қолдану
Dialogue: 0,0:04:31.50,0:04:34.54,Default,,0,0,0,,Біз ем таппайынша, сіз сыртқы әлеммен байланысыңыз болмауы керек.
Dialogue: 0,0:04:34.54,0:04:37.31,Default,,0,0,0,,Одан мүлдем аулақ болыңыз, күтіңіз
Dialogue: 0,0:04:37.31,0:04:41.51,Default,,0,0,0,,Сіз бізді жалғыз қалдырасыз ба, Кларк көмекшісі?
Dialogue: 0,0:04:41.51,0:04:44.01,Default,,0,0,0,,А, сен мені естисің бе, Блэк Джек?
Dialogue: 0,0:04:44.01,0:04:45.95,Default,,0,0,0,,Бұл менмін, Кума.
Dialogue: 0,0:04:45.95,0:04:48.35,Default,,0,0,0,,Доктор Кума? неге сен
Dialogue: 0,0:04:48.35,0:04:53.19,Default,,0,0,0,,Мен бұл командаға ең болмағанда күнәларымды өтеймін деген үмітпен қосылдым.
Dialogue: 0,0:04:53.19,0:04:59.36,Default,,0,0,0,,Жағдай ауыр, бірақ біз ешқашан берілмедік.
Dialogue: 0,0:04:59.36,0:05:01.63,Default,,0,0,0,,Доктор Кума Бұл не?
Dialogue: 0,0:05:01.63,0:05:04.67,Default,,0,0,0,,Қазір біз алған деректерді сізге жіберіп жатырмыз.
Dialogue: 0,0:05:04.67,0:05:07.44,Default,,0,0,0,,Доктор Кума Блэк Джек, егер сіз
Dialogue: 0,0:05:07.44,0:05:10.14,Default,,0,0,0,,Мүмкін бірдеңе тауып алармыз
Dialogue: 0,0:05:10.14,0:05:14.48,Default,,0,0,0,,Егер сіз Хонма Сенсейдің шәкірті болсаңыз,
Dialogue: 0,0:05:14.48,0:05:19.15,Default,,0,0,0,,Хонма мырза, біз де бар күшімізді саламыз.
Dialogue: 0,0:05:19.15,0:05:21.18,Default,,0,0,0,,Материалдың мұндай үлкен көлемі
Dialogue: 0,0:05:21.18,0:05:23.82,Default,,0,0,0,,Тексеру үшін бір ай қажет.
Dialogue: 0,0:05:23.82,0:05:26.32,Default,,0,0,0,,Енді орындайық, Ширабёши
Dialogue: 0,0:05:26.32,0:05:30.19,Default,,0,0,0,,Не, бұл деректер өте құпия.
Dialogue: 0,0:05:30.19,0:05:32.19,Default,,0,0,0,,21 сағат. Не...
Dialogue: 0,0:05:32.19,0:05:34.20,Default,,0,0,0,,Феникс ауруының қазіргі эволюциясы
Dialogue: 0,0:05:34.20,0:05:36.96,Default,,0,0,0,,Өлімге дейінгі модельдеу уақыты
Dialogue: 0,0:05:36.96,0:05:40.87,Default,,0,0,0,,Олар 21 сағат бойы тірі қала алады.
Dialogue: 0,0:05:40.87,0:05:44.71,Default,,0,0,0,,Біз оған ем табуымыз керек.
Dialogue: 0,0:05:44.71,0:05:46.71,Default,,0,0,0,,Күте тұрыңыз, доктор.
Dialogue: 0,0:05:46.71,0:05:50.21,Default,,0,0,0,,Вирус өлсе не болады?
Dialogue: 0,0:05:53.85,0:05:55.78,Default,,0,0,0,,Мен айта алмаймын.
Dialogue: 0,0:05:55.78,0:06:00.78,Default,,0,0,0,,Әдетте вирус жұқтырған адам өлген кезде өледі.
Dialogue: 0,0:06:09.30,0:06:14.30,Default,,0,0,0,,Ха, түсіндім. Бұл жағдайда инфекцияның таралуы туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:06:21.01,0:06:24.48,Default,,0,0,0,,Қара Джек
Dialogue: 0,0:06:24.48,0:06:27.52,Default,,0,0,0,,Мен құтқара аламын ба? Келіңіздер
Dialogue: 0,0:06:27.52,0:06:33.49,Default,,0,0,0,,Мен мәңгілік өмірге ие болдым деп ойладым, бірақ мен бұл жағдайдамын ба?
Dialogue: 0,0:06:33.49,0:06:36.39,Default,,0,0,0,,Мен мүлдем ақымақ түс көрдім.
Dialogue: 0,0:06:36.39,0:06:39.29,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:06:39.29,0:06:41.83,Default,,0,0,0,,Мен көп өлімді көрдім
Dialogue: 0,0:06:41.83,0:06:46.00,Default,,0,0,0,,Адам өмірі қандай нәзік және уақытша!
Dialogue: 0,0:06:46.00,0:06:48.34,Default,,0,0,0,,Мәңгілік өмір
Dialogue: 0,0:06:48.34,0:06:53.67,Default,,0,0,0,,Бұл біздің нәзік адамзаттың өліміне сынақ болды.
Dialogue: 0,0:06:53.67,0:06:56.58,Default,,0,0,0,,Сынақ
Dialogue: 0,0:06:56.58,0:07:00.18,Default,,0,0,0,,Менің қанымнан иммундық сарысу жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:07:00.18,0:07:05.15,Default,,0,0,0,,Мүмкін болса, бұл оңай болмайды деп ойлаймын.
Dialogue: 0,0:07:05.15,0:07:07.92,Default,,0,0,0,,Онда сен де осында өлесің.
Dialogue: 0,0:07:07.92,0:07:11.29,Default,,0,0,0,,Блэк Джек, Феникс ауруы?
Dialogue: 0,0:07:11.29,0:07:13.63,Default,,0,0,0,,Сіз оны емдеуге болады деп ойлайсыз ба?
Dialogue: 0,0:07:13.63,0:07:15.66,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:07:15.66,0:07:19.43,Default,,0,0,0,,Мен қиындықтарды жек көрмеймін.
Dialogue: 0,0:07:19.43,0:07:23.64,Default,,0,0,0,,Иә, президент мырза, сегіз сағатыңыз қалды.
Dialogue: 0,0:07:23.64,0:07:27.48,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:07:27.48,0:07:31.35,Default,,0,0,0,,Ең соңғы өте ыстық зымырандарды ұшыруға дайын болыңыз.
Dialogue: 0,0:07:31.35,0:07:33.65,Default,,0,0,0,,Бұл өте ыстық ракета ма?
Dialogue: 0,0:07:33.65,0:07:36.32,Default,,0,0,0,,Иә, онда 1 км радиуста болатындар.
Dialogue: 0,0:07:36.32,0:07:40.49,Default,,0,0,0,,Толық булануы мүмкін
Dialogue: 0,0:07:40.49,0:07:43.99,Default,,0,0,0,,Адамдар жоқ, вирустар жоқ, сонда олар ше?
Dialogue: 0,0:07:43.99,0:07:46.79,Default,,0,0,0,,Асығыңыздар, бұл президенттің бұйрығы.
Dialogue: 0,0:07:50.33,0:07:52.27,Default,,0,0,0,,Бұл бастапқы BOP вирусы
Dialogue: 0,0:07:52.27,0:07:56.14,Default,,0,0,0,,Ал бұл дамыған вирус.
Dialogue: 0,0:07:56.14,0:07:59.01,Default,,0,0,0,,Жіберілген деректерге сәйкес, доктор Джордж
Dialogue: 0,0:07:59.01,0:08:02.88,Default,,0,0,0,,Бұл БОП Канаданың қарлы тауларында табылған сияқты.
Dialogue: 0,0:08:02.88,0:08:04.81,Default,,0,0,0,,Ол ерте заманнан бері бар ма?
Dialogue: 0,0:08:04.81,0:08:07.45,Default,,0,0,0,,Оның ғарыштан келгені белгісіз болды.
Dialogue: 0,0:08:07.45,0:08:09.38,Default,,0,0,0,,Доктор Джордж бұл вирус деп айтты
Dialogue: 0,0:08:09.38,0:08:13.25,Default,,0,0,0,,Өздігінен электр энергиясын өндіру қасиетіне тоқталдым.
Dialogue: 0,0:08:13.25,0:08:15.19,Default,,0,0,0,,Бұл қолданылды
Dialogue: 0,0:08:15.19,0:08:18.99,Default,,0,0,0,,Бұл Noir Project әзірлеген жасанды жүрекке арналған ішкі батарея.
Dialogue: 0,0:08:21.00,0:08:23.90,Default,,0,0,0,,Кейінірек доктор Джордж БОП-ны радиацияға ұшыратты.
Dialogue: 0,0:08:23.90,0:08:25.83,Default,,0,0,0,,Ол әдейі дамыған сияқты.
Dialogue: 0,0:08:25.83,0:08:27.84,Default,,0,0,0,,Ах
Dialogue: 0,0:08:27.84,0:08:29.84,Default,,0,0,0,,Сәулеленуді қолдану арқылы қайталау
Dialogue: 0,0:08:29.84,0:08:33.14,Default,,0,0,0,,Дамыған БОП адам ДНҚ-сына бекітілген.
Dialogue: 0,0:08:33.14,0:08:36.98,Default,,0,0,0,,Жасушаның қартаюын тоқтататын өлместікке қарсы дәрі болды.
Dialogue: 0,0:08:36.98,0:08:38.91,Default,,0,0,0,,Бірақ екінші жағынан
Dialogue: 0,0:08:38.91,0:08:42.32,Default,,0,0,0,,БОП – темір және денеде шашыраған сансыз бөгде заттар.
Dialogue: 0,0:08:42.32,0:08:46.65,Default,,0,0,0,,Және ол рак клеткаларын және магнит сияқты басқа заттарды тартады.
Dialogue: 0,0:08:46.65,0:08:49.32,Default,,0,0,0,,Бұл қан тамырларының ішінде гематоманың дамуына әкеледі.
Dialogue: 0,0:08:49.32,0:08:53.83,Default,,0,0,0,,Сондай-ақ қатерлі ісіктерді әртүрлі жерлерге таратады
Dialogue: 0,0:08:53.83,0:08:56.66,Default,,0,0,0,,Мүмкін бұл Феникс ауруының шынайы табиғаты шығар.
Dialogue: 0,0:08:56.66,0:09:01.50,Default,,0,0,0,,Бұл жағдайда менің Рак аңшысының радиациялық емі болды
Dialogue: 0,0:09:01.50,0:09:04.94,Default,,0,0,0,,Вирус одан әрі дамыды ма?
Dialogue: 0,0:09:04.94,0:09:08.44,Default,,0,0,0,,Феникс ауруының негізгі себебі болып табылатын қуат өндіруші қасиетті жойсақ,
Dialogue: 0,0:09:08.44,0:09:10.48,Default,,0,0,0,,Ауруды басу мүмкіндігі болуы керек.
Dialogue: 0,0:09:10.48,0:09:13.78,Default,,0,0,0,,Кілт...
Dialogue: 0,0:09:13.78,0:09:16.68,Default,,0,0,0,,Хмм... бұл
Dialogue: 0,0:09:16.68,0:09:20.96,Default,,0,0,0,,Мен... Мен нені айтамын?
Dialogue: 0,0:09:20.96,0:09:24.83,Default,,0,0,0,,А, не болды, Блэк Джек?
Dialogue: 0,0:09:24.83,0:09:28.13,Default,,0,0,0,,Сәлем, Қара Джек
Dialogue: 0,0:09:28.13,0:09:32.47,Default,,0,0,0,,Бұл Феникс ауруы дамиды.
Dialogue: 0,0:09:32.47,0:09:34.47,Default,,0,0,0,,Қара Джек!
Dialogue: 0,0:09:42.48,0:09:45.31,Default,,0,0,0,,Мен сонда болдым
Dialogue: 0,0:09:45.31,0:09:49.98,Default,,0,0,0,,Ширабёши Әлі жоқ. Бас тартуға әлі ерте.
Dialogue: 0,0:09:49.98,0:09:53.02,Default,,0,0,0,,А, мен білемін. Қалай болғанда да, алғашқы көмек.
Dialogue: 0,0:09:53.02,0:09:56.49,Default,,0,0,0,,Өлетін жаман уақыт
Dialogue: 0,0:09:56.49,0:10:00.16,Default,,0,0,0,,Доктор Уайт пен Блэк Джек мырза
Dialogue: 0,0:10:00.16,0:10:03.06,Default,,0,0,0,,Ренка: Сіз мұны уақытында жасаған сияқтысыз.
Dialogue: 0,0:10:03.06,0:10:05.03,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:10:05.03,0:10:09.17,Default,,0,0,0,,Мен Феникс ауруының дамыған вирусы мен емдеу деректерін алуға келдім.
Dialogue: 0,0:10:09.17,0:10:12.01,Default,,0,0,0,,Ондай нәрсені не істейсің?
Dialogue: 0,0:10:12.01,0:10:15.04,Default,,0,0,0,,Бұл ұйым үшін өте қажет.
Dialogue: 0,0:10:15.04,0:10:17.18,Default,,0,0,0,,Сорю Ха
Dialogue: 0,0:10:17.18,0:10:19.51,Default,,0,0,0,,Негізгі компьютер бөлмесі артқы жағында.
Dialogue: 0,0:10:19.51,0:10:24.69,Default,,0,0,0,,Ширахёши Бұл қауіпсіздік жүйесі.
Dialogue: 0,0:10:24.69,0:10:29.36,Default,,0,0,0,,Мен доктор Блэк Джекпен әкеңнің қанын алуға барамын.
Dialogue: 0,0:10:29.36,0:10:31.36,Default,,0,0,0,,Келіңдер, келіңдер.
Dialogue: 0,0:10:40.00,0:10:42.90,Default,,0,0,0,,Әке
Dialogue: 0,0:10:42.90,0:10:46.71,Default,,0,0,0,,Менің бетіме жақсылап қарау керек.
Dialogue: 0,0:10:46.71,0:10:50.88,Default,,0,0,0,,Осы жүздің арқасында мен тозақтың азабын тарттым.
Dialogue: 0,0:10:50.88,0:10:55.05,Default,,0,0,0,,Мен сені кешіре алмаймын, өз қолыммен құтыламын.
Dialogue: 0,0:10:55.05,0:11:00.32,Default,,0,0,0,,Анаңның бетіне қарап өлесің, Қара Джек.
Dialogue: 0,0:11:00.32,0:11:03.12,Default,,0,0,0,,Не... Бортта зиянкес бар екенін растады
Dialogue: 0,0:11:07.83,0:11:11.13,Default,,0,0,0,,Сіз борттағы зиянкесті жою үшін не істедіңіз?
Dialogue: 0,0:11:17.00,0:11:19.00,Default,,0,0,0,,Қара Джек
Dialogue: 0,0:11:40.19,0:11:42.70,Default,,0,0,0,,Бұл шынымен де соңғы рет. Күте тұрыңыз.
Dialogue: 0,0:11:42.70,0:11:46.03,Default,,0,0,0,,А, күте тұр, Ренка.
Dialogue: 0,0:11:46.03,0:11:49.37,Default,,0,0,0,,Мына кісіні өлтірме
Dialogue: 0,0:11:49.37,0:11:52.71,Default,,0,0,0,,Әке, мылтықты қойыңыз.
Dialogue: 0,0:11:52.71,0:11:56.04,Default,,0,0,0,,Мені тыңда
Dialogue: 0,0:11:56.04,0:12:00.34,Default,,0,0,0,,Аузыңды жап, мен сенің тапсырысыңды енді қабылдамаймын.
Dialogue: 0,0:12:13.16,0:12:17.16,Default,,0,0,0,,А... солай.
Dialogue: 0,0:12:25.51,0:12:29.31,Default,,0,0,0,,Қара Джек... Мынау несі?
Dialogue: 0,0:12:31.31,0:12:33.31,Default,,0,0,0,,Екеуі де өлді ме?
Dialogue: 0,0:12:35.85,0:12:40.35,Default,,0,0,0,,Бұл әйел операция жасаса, бәрін жасай алады.
Dialogue: 0,0:12:40.35,0:12:43.02,Default,,0,0,0,,Сәлем Блэк Джек
Dialogue: 0,0:12:43.02,0:12:45.86,Default,,0,0,0,,Операцияға дайындық
Dialogue: 0,0:12:45.86,0:12:49.36,Default,,0,0,0,,Сіз мұны шынымен жасайсыз ба? Пайдасы жоқ, Блэк Джек.
Dialogue: 0,0:12:49.36,0:12:51.30,Default,,0,0,0,,Біз сенің өлуге жол бере алмаймыз
Dialogue: 0,0:12:51.30,0:12:53.23,Default,,0,0,0,,Әйел
Dialogue: 0,0:12:53.23,0:12:57.04,Default,,0,0,0,,Доктор Уайт, осы жерге жауап беріңізші, Рикки әуе күштері базасы.
Dialogue: 0,0:12:57.04,0:12:58.97,Default,,0,0,0,,Доктор Уайт
Dialogue: 0,0:12:58.97,0:13:01.81,Default,,0,0,0,,Бұл жеткілікті, аздап көп, деді доктор Кума.
Dialogue: 0,0:13:01.81,0:13:03.84,Default,,0,0,0,,21 сағат өтті
Dialogue: 0,0:13:03.84,0:13:06.68,Default,,0,0,0,,Зымыран ұшыруға дайындалу
Dialogue: 0,0:13:06.68,0:13:08.68,Default,,0,0,0,,А... иә
Dialogue: 0,0:13:18.36,0:13:20.49,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:13:20.49,0:13:24.17,Default,,0,0,0,,Жасанды жүрек Гидра типті жасанды жүрек
Dialogue: 0,0:13:24.17,0:13:26.67,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:26.67,0:13:30.50,Default,,0,0,0,,Әкем жасаған жасанды жүрек бұл адамға да қатысты.
Dialogue: 0,0:13:30.50,0:13:33.41,Default,,0,0,0,,Аа, қан қысымы түсіп, тынысы әлсіз.
Dialogue: 0,0:13:33.41,0:13:36.38,Default,,0,0,0,,Осылай жүрсең, жүрегің тоқтайды, ақымақ.
Dialogue: 0,0:13:36.38,0:13:39.21,Default,,0,0,0,,Жасанды жүрекке оқтан зақым келмеген
Dialogue: 0,0:13:39.21,0:13:41.85,Default,,0,0,0,,Бұл жүректі адам денесінен алып тастаса да,
Dialogue: 0,0:13:41.85,0:13:45.52,Default,,0,0,0,,Ол мәңгілікке қозғалады, бірақ бұл оның тоқтағанын білдіреді.
Dialogue: 0,0:13:45.52,0:13:48.02,Default,,0,0,0,,Жоқ! Не болды, Блэк Джек?
Dialogue: 0,0:13:48.02,0:13:51.36,Default,,0,0,0,,Мүмкін біз Феникс ауруын емдей аламыз.
Dialogue: 0,0:13:51.36,0:13:55.20,Default,,0,0,0,,Неге, Ширахёши, сен Ренконың қанын жинап жатырсың.
Dialogue: 0,0:13:55.20,0:13:58.03,Default,,0,0,0,,Оның қанынан иммундық сарысу құрыңыз.
Dialogue: 0,0:13:58.03,0:14:00.63,Default,,0,0,0,,Мен жүрегімді ауыстырамын, не болса да.
Dialogue: 0,0:14:00.63,0:14:02.57,Default,,0,0,0,,Толық түсініктеме кейінірек беріледі.
Dialogue: 0,0:14:02.57,0:14:05.97,Default,,0,0,0,,Бірақ жүректі трансплантациялауға келгенде донор қайда орналасқан?
Dialogue: 0,0:14:05.97,0:14:10.81,Default,,0,0,0,,Оның әкесі Мәнтоқудың жүрегі бар.
Dialogue: 0,0:14:10.81,0:14:13.31,Default,,0,0,0,,Зымыран ұшыру порты ашылады
Dialogue: 0,0:14:13.31,0:14:16.15,Default,,0,0,0,,Мақсат қоюды растау
Dialogue: 0,0:14:16.15,0:14:18.82,Default,,0,0,0,,Атуды кез келген уақытта жасауға болады
Dialogue: 0,0:14:18.82,0:14:21.32,Default,,0,0,0,,Жарайды, атайық, өрт.
Dialogue: 0,0:14:29.00,0:14:30.93,Default,,0,0,0,,Зымыранның сәтті ұшырылуы
Dialogue: 0,0:14:30.93,0:14:34.50,Default,,0,0,0,,Sky Hospital мақсатына жетуге 720 секунд қалды
Dialogue: 0,0:14:34.50,0:14:36.44,Default,,0,0,0,,О, ақымақ
Dialogue: 0,0:14:36.44,0:14:38.84,Default,,0,0,0,,Балалар сендер не істедіңдер?
Dialogue: 0,0:14:38.84,0:14:41.34,Default,,0,0,0,,Адам өмірі дегеніміз не деп ойлайсың?
Dialogue: 0,0:14:41.34,0:14:44.01,Default,,0,0,0,,Дәрігер айтқан 21 сағат өтті.
Dialogue: 0,0:14:44.01,0:14:46.85,Default,,0,0,0,,Бірақ бұл жерде Sky Hospital
Dialogue: 0,0:14:46.85,0:14:50.72,Default,,0,0,0,,Бұл Sky Hospital, жауап беріңіз.
Dialogue: 0,0:14:50.72,0:14:53.62,Default,,0,0,0,,Ширабёши-кун, жақсысың ба сұра.
Dialogue: 0,0:14:53.62,0:14:55.56,Default,,0,0,0,,Феникс ауруының емі табылды.
Dialogue: 0,0:14:55.56,0:14:57.56,Default,,0,0,0,,Не болса да
Dialogue: 0,0:14:57.56,0:15:01.50,Default,,0,0,0,,Бұл гидра типті жасанды жүректе қолданылатын BOP.
Dialogue: 0,0:15:01.50,0:15:04.97,Default,,0,0,0,,Ал қазіргі жаңа БОП дамыды
Dialogue: 0,0:15:04.97,0:15:07.64,Default,,0,0,0,,Бұл екеуі қарама-қарсы электрлік полярлыққа ие.
Dialogue: 0,0:15:07.64,0:15:12.14,Default,,0,0,0,,Осы екі BOP біріктірілгенде, қуат өндіру сипаттамалары кері өзгереді.
Dialogue: 0,0:15:12.14,0:15:16.01,Default,,0,0,0,,Біз физикалық денеге әсер етудің жойылғанын анықтадық.
Dialogue: 0,0:15:16.01,0:15:19.65,Default,,0,0,0,,Бұдан біз иммундық сарысу жасай аламыз.
Dialogue: 0,0:15:19.65,0:15:21.58,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:15:21.58,0:15:24.82,Default,,0,0,0,,Зымыран келгенше 520 секунд
Dialogue: 0,0:15:24.82,0:15:26.85,Default,,0,0,0,,Зымыранның траекториясын түзетіңіз.
Dialogue: 0,0:15:26.85,0:15:28.85,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:33.53,0:15:36.16,Default,,0,0,0,,Неге бағдарламаны қабылдамайсың?
Dialogue: 0,0:15:36.16,0:15:38.10,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:38.10,0:15:41.34,Default,,0,0,0,,Мен траекторияны түзете алмаймын. Не...
Dialogue: 0,0:15:41.34,0:15:44.17,Default,,0,0,0,,Бұл аврора ма?
Dialogue: 0,0:15:44.17,0:15:47.51,Default,,0,0,0,,Аврора тудыратын магнит өрісіне байланысты қашықтан басқару мүмкін емес.
Dialogue: 0,0:15:47.51,0:15:50.18,Default,,0,0,0,,Ақымақ, сосын аспанға жарып жібер.
Dialogue: 0,0:15:50.18,0:15:52.18,Default,,0,0,0,,Иә
Dialogue: 0,0:15:54.52,0:15:56.45,Default,,0,0,0,,Жоқ, сіз оны жарып жібере алмайсыз.
Dialogue: 0,0:15:56.45,0:16:00.02,Default,,0,0,0,,Мақсатқа жетуге 210 секунд қалды
Dialogue: 0,0:16:00.02,0:16:03.99,Default,,0,0,0,,Иммундық сарысу бітсе де, ол буланып кетеді.
Dialogue: 0,0:16:03.99,0:16:07.63,Default,,0,0,0,,Ширабёши-кун, бұл зымыран. Зымыран бізге қарай келе жатыр.
Dialogue: 0,0:16:07.63,0:16:11.13,Default,,0,0,0,,Неге, қазір кетесің бе?
Dialogue: 0,0:16:13.43,0:16:16.64,Default,,0,0,0,,Шүкір, менің басым айналып, қолым шаршады.
Dialogue: 0,0:16:16.64,0:16:18.97,Default,,0,0,0,,Мен өзімді жоғалтып алдым
Dialogue: 0,0:16:18.97,0:16:21.48,Default,,0,0,0,,Мен бұл әйелге не үшін көмектесемін?
Dialogue: 0,0:16:21.48,0:16:25.81,Default,,0,0,0,,Анамды ең көп қинаған адам осы емес пе?
Dialogue: 0,0:16:25.81,0:16:28.41,Default,,0,0,0,,Бірақ мен неге?
Dialogue: 0,0:16:32.59,0:16:36.16,Default,,0,0,0,,Бауырым, сен
Dialogue: 0,0:16:36.16,0:16:39.66,Default,,0,0,0,,Мұндай әйелді құтқаруға тұрарлық емес.
Dialogue: 0,0:16:39.66,0:16:42.33,Default,,0,0,0,,Адам өмірі шынымен де соншалықты маңызды ма?
Dialogue: 0,0:16:42.33,0:16:44.33,Default,,0,0,0,,Иә
Dialogue: 0,0:16:46.20,0:16:50.00,Default,,0,0,0,,Хехе... Ах Кирико
Dialogue: 0,0:16:50.00,0:16:53.22,Default,,0,0,0,,Сен бұрынғыдай әділсің, Блэк Джек.
Dialogue: 0,0:16:54.08,0:16:56.70,Default,,0,0,0,,Тірі заттар өлгенде табиғи түрде өледі.
Dialogue: 0,0:16:57.48,0:17:00.95,Default,,0,0,0,,Тек адамдар ғана оларды өмір сүруге мәжбүрлейді.
Dialogue: 0,0:17:00.95,0:17:02.66,Default,,0,0,0,,Қайсысы дұрыс?
Dialogue: 0,0:17:03.32,0:17:05.45,Default,,0,0,0,,Үніңді жап, Кирико, сен не істеп жатырсың?
Dialogue: 0,0:17:05.45,0:17:07.28,Default,,0,0,0,,Блэк Джек, ах
Dialogue: 0,0:17:09.64,0:17:10.76,Default,,0,0,0,,Хонма мырза
Dialogue: 0,0:17:11.33,0:17:13.96,Default,,0,0,0,,Осыны да есте сақтаңыз.
Dialogue: 0,0:17:14.10,0:17:18.63,Default,,0,0,0,,Дәрігерлер адамдарды емдемейді, тек емделуге көмектеседі.
Dialogue: 0,0:17:19.54,0:17:20.57,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:17:20.57,0:17:22.18,Default,,0,0,0,,Куру Ах
Dialogue: 0,0:17:23.16,0:17:25.18,Default,,0,0,0,,Ана әке
Dialogue: 0,0:17:27.81,0:17:30.64,Default,,0,0,0,,Жарайсың Куру
Dialogue: 0,0:17:30.64,0:17:33.28,Default,,0,0,0,,Жүр, Куру, жетеді.
Dialogue: 0,0:17:33.48,0:17:35.82,Default,,0,0,0,,Жүр, бірге барайық.
Dialogue: 0,0:17:35.82,0:17:37.82,Default,,0,0,0,,Күте тұрыңыз, сэр.
Dialogue: 0,0:17:39.99,0:17:42.16,Default,,0,0,0,,Науқас күтіп тұр.
Dialogue: 0,0:17:43.26,0:17:44.86,Default,,0,0,0,,Сіз Пинокосыз ба?
Dialogue: 0,0:17:44.86,0:17:50.50,Default,,0,0,0,,Дұрыс, Пиноко 18 жаста. Бұл оның бастапқы формасы.
Dialogue: 0,0:17:50.88,0:17:52.08,Default,,0,0,0,,Пиноко
Dialogue: 0,0:17:52.66,0:17:58.03,Default,,0,0,0,,Пиноко әрқашан сізбен бірге болады, ұстаз. Қолыңнан келгенін істе, ұстаз.
Dialogue: 0,0:18:04.02,0:18:05.66,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:06.82,0:18:11.36,Default,,0,0,0,,Қарғыс атсын, әлі емес, мен әлі бас тартпаймын.
Dialogue: 0,0:18:11.95,0:18:14.79,Default,,0,0,0,,Аврора әсерінен автопилот функциясы пайдасыз.
Dialogue: 0,0:18:14.79,0:18:17.08,Default,,0,0,0,,Қолмен жұмыс істеуге өзгерту Түсіндім.
Dialogue: 0,0:18:17.68,0:18:19.49,Default,,0,0,0,,Қозғалыңыз.
Dialogue: 0,0:18:19.82,0:18:23.56,Default,,0,0,0,,Зымыранның сізге жетуіне 21 секунд қалды, асығыңыз!
Dialogue: 0,0:18:24.13,0:18:26.43,Default,,0,0,0,,Мен өмірді сақтаймын
Dialogue: 0,0:18:30.47,0:18:32.47,Default,,0,0,0,,Жүр, жоғарыға шығайық.
Dialogue: 0,0:18:36.28,0:18:38.28,Default,,0,0,0,,Келіңіздер, тірі болыңыздар!
Dialogue: 0,0:18:40.65,0:18:42.70,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:18:43.70,0:18:46.45,Default,,0,0,0,,Зымыранның келуіне 15 секунд қалды
Dialogue: 0,0:18:46.45,0:18:48.99,Default,,0,0,0,,Тұр!
Dialogue: 0,0:18:48.99,0:18:53.86,Default,,0,0,0,,10 ９ ８ ７ ６…
Dialogue: 0,0:18:53.86,0:18:58.46,Default,,0,0,0,,５ ４ ３ ２ １…
Dialogue: 0,0:19:05.44,0:19:07.47,Default,,0,0,0,,Жарылысты растау
Dialogue: 0,0:19:07.66,0:19:10.96,Default,,0,0,0,,Sky Hospital радардан жоғалып кетті.
Dialogue: 0,0:19:11.95,0:19:14.98,Default,,0,0,0,,Кешіріңіз, Блэк Джек, мені кешіріңіз.
Dialogue: 0,0:19:14.98,0:19:17.12,Default,,0,0,0,,Мұнда басыңыз Sky Hospital
Dialogue: 0,0:19:17.12,0:19:19.79,Default,,0,0,0,,Бұл Sky Hospital.
Dialogue: 0,0:19:19.79,0:19:22.89,Default,,0,0,0,,Тірі... Сіз тірісіз бе?
Dialogue: 0,0:19:26.66,0:19:29.96,Default,,0,0,0,,Иә
Dialogue: 0,0:19:29.96,0:19:31.96,Default,,0,0,0,,Процедураның соңы
Dialogue: 0,0:19:40.97,0:19:44.47,Default,,0,0,0,,Әке, ана, мен жасадым.
Dialogue: 0,0:19:46.65,0:19:50.52,Default,,0,0,0,,Осы Феникс ауруы үшін иммундық сарысу әзірленген.
Dialogue: 0,0:19:50.52,0:19:55.36,Default,,0,0,0,,Сұраныс бойынша кез келген адамға тегін беріледі.
Dialogue: 0,0:19:55.36,0:19:58.99,Default,,0,0,0,,Осындай таңғажайып дәрі тегін бе? Бұл рас па?
Dialogue: 0,0:19:58.99,0:20:00.93,Default,,0,0,0,,Кез келген елде иә
Dialogue: 0,0:20:00.93,0:20:03.50,Default,,0,0,0,,Мұны монополиялауға жол берілмейді
Dialogue: 0,0:20:03.50,0:20:08.34,Default,,0,0,0,,Біз бұл иммундық сарысуды Хонма сарысуы деп атадық.
Dialogue: 0,0:20:08.34,0:20:10.37,Default,,0,0,0,,Хонма сарысуы? Бұл дұрыс
Dialogue: 0,0:20:10.37,0:20:12.67,Default,,0,0,0,,Бір кездері Джотаро Хонма мырза
Dialogue: 0,0:20:12.67,0:20:18.18,Default,,0,0,0,,БОП туындаған Хонма гематомасымен бір адам ғана кездесті.
Dialogue: 0,0:20:18.18,0:20:21.52,Default,,0,0,0,,Хонма Сенсей мен оның Мана шәкірттеріне рахмет
Dialogue: 0,0:20:21.52,0:20:23.85,Default,,0,0,0,,Хонма сарысуы аяқталды.
Dialogue: 0,0:20:23.85,0:20:28.36,Default,,0,0,0,,Біз сізді құрметпен осылай атаймыз.
Dialogue: 0,0:20:28.36,0:20:30.86,Default,,0,0,0,,Хонма мырза
Dialogue: 0,0:20:30.86,0:20:32.86,Default,,0,0,0,,Сізге жақсы, әке.
Dialogue: 0,0:20:42.57,0:20:47.04,Default,,0,0,0,,Мен оралдым, Хонма мырза.
Dialogue: 0,0:20:47.04,0:20:50.54,Default,,0,0,0,,Эй, Шараку-кун, сенің жағдайың жоқ.
Dialogue: 0,0:20:50.54,0:20:52.88,Default,,0,0,0,,Бұл бала Пиноко-чан жоғалып кеткен
Dialogue: 0,0:20:52.88,0:20:55.55,Default,,0,0,0,,Мәңгі осылай болды, тіпті менің әпкем де.
Dialogue: 0,0:20:55.55,0:20:59.22,Default,,0,0,0,,Профессор Блэк Джек кетті, сондықтан мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:20:59.22,0:21:01.15,Default,,0,0,0,,Не? иә? Неге қызарып жатырсың?
Dialogue: 0,0:21:01.15,0:21:04.19,Default,,0,0,0,,Мұғалім, сіз не істеп жатырсыз? Мен масқара емеспін.
Dialogue: 0,0:21:04.19,0:21:07.49,Default,,0,0,0,,Қош келдіңіз... Көбінесе сіз.
Dialogue: 0,0:21:07.49,0:21:10.33,Default,,0,0,0,,Пиноко-чан маған үнемі айғайлайды
Dialogue: 0,0:21:10.33,0:21:12.27,Default,,0,0,0,,Ал... бұл дұрыс емес.
Dialogue: 0,0:21:12.27,0:21:15.84,Default,,0,0,0,,Мен ағамын, Шараку!
Dialogue: 0,0:21:15.84,0:21:19.38,Default,,0,0,0,,Уау! Мен... кешіріңіз. Ах... иә?
Dialogue: 0,0:21:19.68,0:21:22.18,Default,,0,0,0,,Сенің ағаң кім?
Dialogue: 0,0:21:22.18,0:21:23.66,Default,,0,0,0,,Пиноко-чан
Dialogue: 0,0:21:25.85,0:21:27.85,Default,,0,0,0,,Блэк Джек мырза
Dialogue: 0,0:21:31.72,0:21:35.19,Default,,0,0,0,,Сіз қашан оралдыңыз? Ах, Пиноко-чан, мен сені қатты сағындым.
Dialogue: 0,0:21:35.19,0:21:38.23,Default,,0,0,0,,Жақсы, бұл ұзақ сапар болды.
Dialogue: 0,0:21:38.23,0:21:42.93,Default,,0,0,0,,Қош келдіңіз, мұғалім.
Dialogue: 0,0:21:42.93,0:21:44.93,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:21:50.20,0:21:53.80,Default,,0,0,0,,Мұғалім, тез, тез
Dialogue: 0,0:22:05.32,0:22:07.65,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,0:22:07.65,0:22:11.16,Default,,0,0,0,,Әй, мұғалім, сен шынымен үйді қайта тұрғызасың ба?
Dialogue: 0,0:22:11.16,0:22:14.56,Default,,0,0,0,,Әй, қайтадан нөлден бастайық.
Dialogue: 0,0:22:14.66,0:22:16.66,Default,,0,0,0,,Араманчу
Dialogue: 0,0:22:18.16,0:22:24.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
