Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.20,0:00:02.60,Default,,0,0,0,,«Қара Джек 21»
Dialogue: 0,0:00:04.93,0:00:08.44,Default,,0,0,0,,21 ғасырда қажет жаңа өмір драмасы
Dialogue: 0,0:00:08.44,0:00:11.31,Default,,0,0,0,,Қиялдан тыс орасан зор қастандық басталады
Dialogue: 0,0:00:11.31,0:00:15.11,Default,,0,0,0,,Таңқаларлық жаңа серия 90 секундтан кейін басталады
Dialogue: 0,0:01:36.19,0:01:40.06,Default,,0,0,0,,21 жыл бұрынғы жиіркенішті естеліктер
Dialogue: 0,0:01:40.06,0:01:44.97,Default,,0,0,0,,Әкем анам екеумізді жас кезімізде тастап, жоғалып кетті.
Dialogue: 0,0:01:44.97,0:01:49.81,Default,,0,0,0,,Бұл жарылмаған снаряд апаты себеп болды.
Dialogue: 0,0:01:49.81,0:01:52.31,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:54.94,0:01:57.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:57.45,0:02:00.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:00.35,0:02:02.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:17.37,0:02:22.97,Default,,0,0,0,,Доктор Джотаро Хонманың ғажайып операциясының арқасында мен аман қалдым.
Dialogue: 0,0:02:22.97,0:02:25.81,Default,,0,0,0,,Бірақ анам...
Dialogue: 0,0:02:25.81,0:02:27.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:30.61,0:02:34.81,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:02:38.92,0:02:41.86,Default,,0,0,0,,Содан бері 21 жыл (телефон рингтоны)
Dialogue: 0,0:02:41.86,0:02:44.09,Default,,0,0,0,,Мен қазір жоқпын.
Dialogue: 0,0:02:44.09,0:02:47.63,Default,,0,0,0,,Дыбыстық сигнал шыққан кезде атыңызды және сізге не қажет екенін айтыңыз.
Dialogue: 0,0:02:47.63,0:02:50.53,Default,,0,0,0,,(тон)
Dialogue: 0,0:02:50.53,0:02:54.40,Default,,0,0,0,,Куру, бұл менмін, Кагезо.
Dialogue: 0,0:02:54.40,0:02:57.50,Default,,0,0,0,,Мен сізбен танысқым келеді, маған хабарласыңыз.
Dialogue: 0,0:02:59.37,0:03:01.74,Default,,0,0,0,,Иә, бәрі осыған байланысты.
Dialogue: 0,0:03:01.74,0:03:05.44,Default,,0,0,0,,Ол жауап берушіде қалдырылған хабарламадан басталды.
Dialogue: 0,0:03:17.03,0:03:21.86,Default,,0,0,0,,Күте тұрыңыз! Ваннаны қабылдағаннан кейін тағамдарды алыңыз.
Dialogue: 0,0:03:21.86,0:03:26.57,Default,,0,0,0,,Ах! Тоқтау!
Dialogue: 0,0:03:26.57,0:03:30.17,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:03:32.17,0:03:35.41,Default,,0,0,0,,Куру, сен неге менімен хабарласпадың?
Dialogue: 0,0:03:35.41,0:03:38.71,Default,,0,0,0,,Менің бір науқасым бар, оны көргім келеді.
Dialogue: 0,0:03:38.71,0:03:41.15,Default,,0,0,0,,Бұл операцияны тек сіз жасай аласыз.
Dialogue: 0,0:03:41.15,0:03:44.59,Default,,0,0,0,,Өтінемін, Куру, өтінемін
Dialogue: 0,0:03:44.59,0:03:47.62,Default,,0,0,0,,Қайтадан сол жерден
Dialogue: 0,0:03:47.62,0:03:50.96,Default,,0,0,0,,Эй, тыңдап тұрған жоқсың ба? Бұл қате қоңырау
Dialogue: 0,0:03:50.96,0:03:54.36,Default,,0,0,0,,Не болды? Мен жақсы емес сияқтымын
Dialogue: 0,0:03:54.36,0:03:56.60,Default,,0,0,0,,Ах... Эй, кел, Икемачиен.
Dialogue: 0,0:03:56.60,0:03:58.97,Default,,0,0,0,,Мен төсекте ұйықтап жатырмын.
Dialogue: 0,0:03:58.97,0:04:01.30,Default,,0,0,0,,Енді температураңызды өлшеңіз.
Dialogue: 0,0:04:01.30,0:04:04.21,Default,,0,0,0,,Пиноко, мені жалғыз қалдыршы.
Dialogue: 0,0:04:04.21,0:04:06.14,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:06.14,0:04:08.41,Default,,0,0,0,,Өйткені Пиноко тізбектің артқы жағы.
Dialogue: 0,0:04:08.41,0:04:10.51,Default,,0,0,0,,Иә
Dialogue: 0,0:04:13.28,0:04:19.12,Default,,0,0,0,,Хмм, қызбаңыз жоқ сияқты.
Dialogue: 0,0:04:19.12,0:04:21.12,Default,,0,0,0,,Әй, не?
Dialogue: 0,0:04:21.12,0:04:23.53,Default,,0,0,0,,Куру деген кім?
Dialogue: 0,0:04:23.53,0:04:28.73,Default,,0,0,0,,Келіңіздер, неге? Өйткені автожауап беретін адам қайта-қайта айта береді.
Dialogue: 0,0:04:30.77,0:04:34.20,Default,,0,0,0,,Жапон тіліне «қара ұя» сөзін жазып көріңіз.
Dialogue: 0,0:04:34.20,0:04:37.01,Default,,0,0,0,,Не? Ал... қара – қара
Dialogue: 0,0:04:37.01,0:04:40.64,Default,,0,0,0,,Джек ше? Аа баланың аты
Dialogue: 0,0:04:40.64,0:04:44.94,Default,,0,0,0,,Хи хи хи, дұрыс, бұл Куру.
Dialogue: 0,0:04:54.19,0:04:59.03,Default,,0,0,0,,Бұл жаңадан ашылған BJ табыс тарихы.
Dialogue: 0,0:04:59.03,0:05:01.53,Default,,0,0,0,,Айдол әнші супермодель
Dialogue: 0,0:05:01.53,0:05:06.13,Default,,0,0,0,,Ал Голливуд жұлдыздарының барлығын BJ жасаған.
Dialogue: 0,0:05:06.13,0:05:10.01,Default,,0,0,0,,Біздің ұйымда мұндай білікті дәрігер жоқ.
Dialogue: 0,0:05:10.01,0:05:13.71,Default,,0,0,0,,Керемет, бәрі керемет
Dialogue: 0,0:05:17.48,0:05:21.35,Default,,0,0,0,,Мен әйеліме операция жасау үшін осы BJ-ден басқа ештеңе ойлай алмаймын.
Dialogue: 0,0:05:21.35,0:05:25.99,Default,,0,0,0,,Білемін, мен көп рет қоңырау шалып көрдім.
Dialogue: 0,0:05:25.99,0:05:29.99,Default,,0,0,0,,Маған бұйрықтарыңды берсеңдер, мен сені бірден сонда апарамын.
Dialogue: 0,0:05:29.99,0:05:35.26,Default,,0,0,0,,Жоқ, Куру, жоқ, BJ-ге мүлде тиіспе.
Dialogue: 0,0:05:35.26,0:05:37.26,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:40.10,0:05:42.50,Default,,0,0,0,,Куру
Dialogue: 0,0:05:42.50,0:05:46.80,Default,,0,0,0,,Сіз шынымен де қара адамсыз ба?
Dialogue: 0,0:06:00.36,0:06:05.33,Default,,0,0,0,,Куроо-кун, осында тағы ұйықтасаң, суық тиіп қаласың.
Dialogue: 0,0:06:05.33,0:06:08.60,Default,,0,0,0,,Анаңды бізге қалдыр.
Dialogue: 0,0:06:08.60,0:06:13.60,Default,,0,0,0,,Куроо...
Dialogue: 0,0:06:13.60,0:06:16.30,Default,,0,0,0,,Ана... Анашым!
Dialogue: 0,0:06:16.30,0:06:18.84,Default,,0,0,0,,Ма мырза... Мұғалім
Dialogue: 0,0:06:18.84,0:06:21.11,Default,,0,0,0,,Анам Анам анам оянды!
Dialogue: 0,0:06:21.11,0:06:24.01,Default,,0,0,0,,Куру, мені кешір
Dialogue: 0,0:06:24.01,0:06:26.48,Default,,0,0,0,,Берейік
Dialogue: 0,0:06:26.48,0:06:29.89,Default,,0,0,0,,Не? сенің әкең
Dialogue: 0,0:06:29.89,0:06:35.16,Default,,0,0,0,,Мен сені кешіремін.
Dialogue: 0,0:06:35.16,0:06:37.96,Default,,0,0,0,,Ана? ана!
Dialogue: 0,0:06:37.96,0:06:42.46,Default,,0,0,0,,Анашым! ана!
Dialogue: 0,0:07:03.49,0:07:05.95,Default,,0,0,0,,Көңіліңізді көтеру үшін
Dialogue: 0,0:07:05.95,0:07:08.49,Default,,0,0,0,,Пиноконың ерекше тағамдары (ит үруі)
Dialogue: 0,0:07:08.49,0:07:12.13,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:07:12.13,0:07:14.06,Default,,0,0,0,,Хааах!
Dialogue: 0,0:07:14.06,0:07:16.73,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:07:16.73,0:07:22.03,Default,,0,0,0,,Сіз қатты уайымдап тұрсыз, бірақ Пиноко туралы не ойлайсыз?
Dialogue: 0,0:07:31.95,0:07:35.25,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:07:41.46,0:07:43.53,Default,,0,0,0,,Сіз қалай ойлайсыз? иә
Dialogue: 0,0:07:43.53,0:07:47.90,Default,,0,0,0,,BJ көлігі қазір Бей-Ситиге қарай бет алды.
Dialogue: 0,0:07:47.90,0:07:51.83,Default,,0,0,0,,Ол Макадэзо мырзамен байланысатын сияқты.
Dialogue: 0,0:07:51.83,0:07:54.47,Default,,0,0,0,,Жарайды, қарап тұрыңыз.
Dialogue: 0,0:07:54.47,0:07:57.97,Default,,0,0,0,,Қып-қызыл кесіртке
Dialogue: 0,0:07:57.97,0:08:00.41,Default,,0,0,0,,Мысал элементі дайын
Dialogue: 0,0:08:00.41,0:08:02.34,Default,,0,0,0,,Бұл тез болды.
Dialogue: 0,0:08:02.34,0:08:06.21,Default,,0,0,0,,Мен осындай нәрсені қолданбасам жақсы болар еді.
Dialogue: 0,0:08:06.21,0:08:09.11,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:08:15.96,0:08:20.23,Default,,0,0,0,,Жалпы айтқанда, қытайлардың жасыратын нәрселері көп.
Dialogue: 0,0:08:20.23,0:08:22.26,Default,,0,0,0,,Пиноко қанша уайымдаса да,
Dialogue: 0,0:08:22.26,0:08:25.57,Default,,0,0,0,,Өйткені ол кенеттен шығады
Dialogue: 0,0:08:25.57,0:08:27.50,Default,,0,0,0,,Қылыш шымылдығы қандай керемет.
Dialogue: 0,0:08:27.50,0:08:29.90,Default,,0,0,0,,Ол әлдеқашан жабылған.
Dialogue: 0,0:08:29.90,0:08:31.94,Default,,0,0,0,,Бізде кездесуден басқа амал жоқ, солай ма?
Dialogue: 0,0:08:31.94,0:08:34.68,Default,,0,0,0,,Қайта толтырыңыз! А... иә
Dialogue: 0,0:08:34.68,0:08:37.58,Default,,0,0,0,,Сонымен... Бірақ өтініш жасаған адам...
Dialogue: 0,0:08:37.58,0:08:41.35,Default,,0,0,0,,Профессор Блэк Джектің шын атын қайдан білдіңіз?
Dialogue: 0,0:08:41.35,0:08:45.05,Default,,0,0,0,,Ах! Мүмкін мұғалімнің әкесі шығар?
Dialogue: 0,0:08:45.05,0:08:47.02,Default,,0,0,0,,О, мен оны ойлап аламын.
Dialogue: 0,0:08:47.02,0:08:49.99,Default,,0,0,0,,Әке? Ах.
Dialogue: 0,0:08:49.99,0:08:52.36,Default,,0,0,0,,Не керек, бұл қандай сұмдық
Dialogue: 0,0:08:52.36,0:08:55.80,Default,,0,0,0,,Чен-чэйдің әкесін алсаңыз, бұл Оку-танның Пинокосына да қатысты.
Dialogue: 0,0:08:55.80,0:09:00.27,Default,,0,0,0,,Ол менің әкем. Пинокода Ченчейден басқа отбасы жоқ.
Dialogue: 0,0:09:00.27,0:09:03.17,Default,,0,0,0,,Не... не айтып тұрсың? Сіздің отбасыңыз бар.
Dialogue: 0,0:09:03.17,0:09:06.41,Default,,0,0,0,,Дұрыс, мұнда көп нәрсе бар.
Dialogue: 0,0:09:06.41,0:09:08.74,Default,,0,0,0,,Иә, бәрі.
Dialogue: 0,0:09:08.74,0:09:12.38,Default,,0,0,0,,Мұғалім қайтып келгенше осында күте тұрыңыз.
Dialogue: 0,0:09:12.38,0:09:14.32,Default,,0,0,0,,Иә, солай істе.
Dialogue: 0,0:09:14.32,0:09:18.05,Default,,0,0,0,,Рахмет, сен осылай айтасың деп ойладым.
Dialogue: 0,0:09:18.05,0:09:20.96,Default,,0,0,0,,Мен ұйықтауға арналған жиынтық әкелдім.
Dialogue: 0,0:09:20.96,0:09:23.16,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:39.31,0:09:42.21,Default,,0,0,0,,Мына сөмке ше? Маған көрсетіңізші
Dialogue: 0,0:09:42.21,0:09:45.11,Default,,0,0,0,,Өтінемін, оны лас қолмен ұстамаңыз, жарай ма?
Dialogue: 0,0:09:45.11,0:09:50.25,Default,,0,0,0,,Бұл сөмкеде көптеген мет және есірткі бар.
Dialogue: 0,0:09:50.25,0:09:55.02,Default,,0,0,0,,Бірақ мына жігітті алып кетемін десең, мен сені үйіңе жіберемін.
Dialogue: 0,0:09:55.02,0:09:57.43,Default,,0,0,0,,Маған бәрібір. А?
Dialogue: 0,0:09:57.43,0:09:59.69,Default,,0,0,0,,Сол жерден өтіңіз
Dialogue: 0,0:09:59.69,0:10:02.00,Default,,0,0,0,,Сізді көргеніме қуаныштымын, Куру.
Dialogue: 0,0:10:02.00,0:10:04.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:06.40,0:10:09.60,Default,,0,0,0,,Мен сенің келетініңе сендім.
Dialogue: 0,0:10:15.08,0:10:17.08,Default,,0,0,0,,Ал, оны сол жерге қойыңыз.
Dialogue: 0,0:10:17.08,0:10:19.91,Default,,0,0,0,,Содан бері 20 жыл өтті.
Dialogue: 0,0:10:19.91,0:10:21.88,Default,,0,0,0,,Міне, біраз уақыт өтті.
Dialogue: 0,0:10:21.88,0:10:26.22,Default,,0,0,0,,Мен сені қайта көргеніме қуанатын ойым жоқ екенін айтуым керек.
Dialogue: 0,0:10:26.22,0:10:28.96,Default,,0,0,0,,Олай айтпа. Оның жинақтаған әңгімелері бар.
Dialogue: 0,0:10:28.96,0:10:31.86,Default,,0,0,0,,Сен сол Қара Джек едің ғой.
Dialogue: 0,0:10:31.86,0:10:34.76,Default,,0,0,0,,Енді мені қызықтыратын нәрсе
Dialogue: 0,0:10:34.76,0:10:38.20,Default,,0,0,0,,Мұның бәрі науқасқа қатысты. Науқас қайда?
Dialogue: 0,0:10:38.20,0:10:41.10,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,0:10:41.10,0:10:43.90,Default,,0,0,0,,Науқас басқа бөлмеде
Dialogue: 0,0:10:47.24,0:10:50.75,Default,,0,0,0,,Сенімен ажырасқан соң мен Макаоға бардым
Dialogue: 0,0:10:50.75,0:10:53.25,Default,,0,0,0,,Менеджмент бойынша кеңесші ретінде табысты жұмыс
Dialogue: 0,0:10:53.25,0:10:56.08,Default,,0,0,0,,Сол кезде мен қазіргі әйеліме қайта үйлендім.
Dialogue: 0,0:10:56.08,0:10:58.99,Default,,0,0,0,,Бұл менің әйелім Ренка.
Dialogue: 0,0:10:58.99,0:11:02.36,Default,,0,0,0,,Үш ай бұрын, мен жоқ кезде.
Dialogue: 0,0:11:02.36,0:11:04.96,Default,,0,0,0,,Сарай өртеніп жатты, ал ол...
Dialogue: 0,0:11:04.96,0:11:09.36,Default,,0,0,0,,Менің бетім қатты күйіп қалды.
Dialogue: 0,0:11:13.67,0:11:18.24,Default,,0,0,0,,Өтінемін, Куру, мен сенің керемет шеберлігіңмен операция жасауыңды қалаймын.
Dialogue: 0,0:11:18.24,0:11:22.74,Default,,0,0,0,,Мен әйелім Ренконы әлемдегі ең сұлу әйел еткенін қалаймын.
Dialogue: 0,0:11:24.81,0:11:27.78,Default,,0,0,0,,Куру, міне 500 000 доллар.
Dialogue: 0,0:11:27.78,0:11:30.32,Default,,0,0,0,,Оны аванстық төлем ретінде қабылдаңыз.
Dialogue: 0,0:11:30.32,0:11:34.19,Default,,0,0,0,,Операция сәтті болса, мен сізге тағы 500 000 доллар беремін.
Dialogue: 0,0:11:34.19,0:11:36.12,Default,,0,0,0,,Неліктен? иә?
Dialogue: 0,0:11:36.12,0:11:39.86,Default,,0,0,0,,Неге оған ол адамның бетін бұрынғы қалпында қалпына келтіруді айтпайсың?
Dialogue: 0,0:11:39.86,0:11:44.07,Default,,0,0,0,,Олай болса, учаскелік дәрігерден сұраңыз.
Dialogue: 0,0:11:44.07,0:11:46.80,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:46.80,0:11:51.64,Default,,0,0,0,,Тек сен мені әлемдегі ең сұлу әйел ете аласың.
Dialogue: 0,0:11:51.64,0:11:55.48,Default,,0,0,0,,Сіз мені мазақ етейін деп жатқан сияқтысыз.
Dialogue: 0,0:11:55.48,0:11:58.85,Default,,0,0,0,,Мен қалағанның бәрін алдым
Dialogue: 0,0:11:58.85,0:12:03.18,Default,,0,0,0,,Бұл ешқашан өзгермейді, сондықтан мен ол адамды әлемдегі ең әдемі әйел етемін.
Dialogue: 0,0:12:03.18,0:12:05.55,Default,,0,0,0,,Иә, Ренка да соны қалайды.
Dialogue: 0,0:12:05.55,0:12:09.39,Default,,0,0,0,,Сенің қолыңнан келеді, Куру. Әрине аласыз.
Dialogue: 0,0:12:09.39,0:12:13.26,Default,,0,0,0,,Дегенмен, мен әлемдегі ең ұсқынсыз тұлғаны жасасам
Dialogue: 0,0:12:13.26,0:12:16.23,Default,,0,0,0,,Сіз не істейсіз? сурет?
Dialogue: 0,0:12:16.23,0:12:20.60,Default,,0,0,0,,Кек алу үшін. Кек?
Dialogue: 0,0:12:20.60,0:12:22.64,Default,,0,0,0,,Жоқ, мүмкін операция кезінде.
Dialogue: 0,0:12:22.64,0:12:25.84,Default,,0,0,0,,Мен ол адамды өлтіруім мүмкін.
Dialogue: 0,0:12:25.84,0:12:28.14,Default,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,0:12:28.14,0:12:30.68,Default,,0,0,0,,Сіздің мақтанышыңыз оған жол бермейді.
Dialogue: 0,0:12:30.68,0:12:33.28,Default,,0,0,0,,Мақтаныш
Dialogue: 0,0:12:36.25,0:12:40.26,Default,,0,0,0,,Сонымен... бұл... есіңде ме?
Dialogue: 0,0:12:40.26,0:12:43.63,Default,,0,0,0,,Иә, анамның естелігі.
Dialogue: 0,0:12:43.63,0:12:46.93,Default,,0,0,0,,Бұл сізден сыйлық болды.
Dialogue: 0,0:12:49.36,0:12:52.27,Default,,0,0,0,,Ах! Сіз сондай бақытты көрінесіз
Dialogue: 0,0:12:52.27,0:12:55.54,Default,,0,0,0,,Анамды көрмегелі біраз болды.
Dialogue: 0,0:12:55.54,0:12:58.74,Default,,0,0,0,,Менің балалық санамда жақсы сақталған.
Dialogue: 0,0:13:03.81,0:13:06.71,Default,,0,0,0,,Бірақ сіз, сол жарылыстан кейін.
Dialogue: 0,0:13:06.71,0:13:10.69,Default,,0,0,0,,Ол мені және анамды тастап, шетелге кетті.
Dialogue: 0,0:13:10.69,0:13:14.29,Default,,0,0,0,,Сол кезде мен сені қаншалықты жек көрдім
Dialogue: 0,0:13:14.29,0:13:16.72,Default,,0,0,0,,Сіз білмейсіз.
Dialogue: 0,0:13:16.72,0:13:22.66,Default,,0,0,0,,Мен сенен кек алу үшін өмір сүрдім.
Dialogue: 0,0:13:22.66,0:13:27.36,Default,,0,0,0,,Бірдеңе... Менде әлі де осындай нәрсе болғанына сене алар емеспін.
Dialogue: 0,0:13:31.07,0:13:33.37,Default,,0,0,0,,Сол кулон
Dialogue: 0,0:13:33.37,0:13:37.98,Default,,0,0,0,,Менің қорыққаным орындалған сияқты.
Dialogue: 0,0:13:37.98,0:13:40.88,Default,,0,0,0,,Иә
Dialogue: 0,0:13:40.88,0:13:43.79,Default,,0,0,0,,Кешірші, Куру, қанша кешірім сұрасам да.
Dialogue: 0,0:13:43.79,0:13:47.02,Default,,0,0,0,,Мен кешірім күтпеймін.
Dialogue: 0,0:13:47.02,0:13:50.73,Default,,0,0,0,,Бірақ ең болмағанда түзетуге рұқсат бере аласыз ба?
Dialogue: 0,0:13:50.73,0:13:53.63,Default,,0,0,0,,Өтеу? мен істеп жатқан бизнес
Dialogue: 0,0:13:53.63,0:13:56.20,Default,,0,0,0,,Операция біткен соң бәрін саған тапсырамын.
Dialogue: 0,0:13:56.20,0:13:58.13,Default,,0,0,0,,...
Dialogue: 0,0:13:58.13,0:14:00.67,Default,,0,0,0,,Мен тиесілі компаниялардың синдикаты
Dialogue: 0,0:14:00.67,0:14:03.37,Default,,0,0,0,,Дүние жүзіндегі артықшылықты сыныптармен жұмыс
Dialogue: 0,0:14:03.37,0:14:08.01,Default,,0,0,0,,Оның негізгі қызметі - VIP-ке маманданған медициналық мекеме.
Dialogue: 0,0:14:08.01,0:14:11.25,Default,,0,0,0,,Түсіндің бе? Менімен қол ұстасып кетсеңіз
Dialogue: 0,0:14:11.25,0:14:16.02,Default,,0,0,0,,Сіз ең үлкен абырой мен байлыққа қол жеткізе аласыз.
Dialogue: 0,0:14:16.02,0:14:19.79,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:14:19.79,0:14:22.26,Default,,0,0,0,,Куру
Dialogue: 0,0:14:22.26,0:14:25.26,Default,,0,0,0,,Әкемді кешіріңіз...
Dialogue: 0,0:14:25.26,0:14:29.56,Default,,0,0,0,,...
Dialogue: 0,0:14:29.56,0:14:32.43,Default,,0,0,0,,Бұл өтеу ме?
Dialogue: 0,0:14:32.43,0:14:35.77,Default,,0,0,0,,Шамасы, тым көп сатып алған мен болдым.
Dialogue: 0,0:14:35.77,0:14:39.64,Default,,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:14:39.64,0:14:43.51,Default,,0,0,0,,Қалайсың, мен сені әлемдегі ең сұлу әйел етемін.
Dialogue: 0,0:14:43.51,0:14:45.81,Default,,0,0,0,,О!
Dialogue: 0,0:14:53.32,0:14:56.96,Default,,0,0,0,,Дұрыс, сізден сұрайын дегенім бар.
Dialogue: 0,0:14:56.96,0:14:59.29,Default,,0,0,0,,Не?
Dialogue: 0,0:14:59.29,0:15:02.76,Default,,0,0,0,,Анаңды әлі де жақсы көресің бе?
Dialogue: 0,0:15:02.76,0:15:06.63,Default,,0,0,0,,Ку… Куроо
Dialogue: 0,0:15:06.63,0:15:09.34,Default,,0,0,0,,Мен сенің анаңды жақсы көретінмін
Dialogue: 0,0:15:09.34,0:15:11.84,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:15:11.84,0:15:16.18,Default,,0,0,0,,Мен сені қазір сүймеймін
Dialogue: 0,0:15:16.18,0:15:19.81,Default,,0,0,0,,Менің жалғыз жақсы көретінім - Ренка.
Dialogue: 0,0:15:19.81,0:15:22.51,Default,,0,0,0,,Келесі жолы бірге көктемге киім аламыз деп келістік
Dialogue: 0,0:15:55.18,0:15:57.75,Default,,0,0,0,,Куру
Dialogue: 0,0:15:57.75,0:16:00.22,Default,,0,0,0,,Операция сәтті өтті.
Dialogue: 0,0:16:00.22,0:16:03.06,Default,,0,0,0,,…
Dialogue: 0,0:16:03.06,0:16:04.99,Default,,0,0,0,,...
Dialogue: 0,0:16:04.99,0:16:08.86,Default,,0,0,0,,Менің ойымша, ол шынымен сені әлемдегі ең әдемі әйел етті.
Dialogue: 0,0:16:08.86,0:16:14.07,Default,,0,0,0,,Мен сізге кепілдік беремін, бір айдан кейін.
Dialogue: 0,0:16:14.07,0:16:16.90,Default,,0,0,0,,...
Dialogue: 0,0:16:16.90,0:16:18.94,Default,,0,0,0,,Маған осы жерде тыныш отыруға рұқсат етіңіз.
Dialogue: 0,0:16:18.94,0:16:22.71,Default,,0,0,0,,Кешіріңіз, бірақ біз мұны осылай жасаймыз.
Dialogue: 0,0:16:22.71,0:16:26.11,Default,,0,0,0,,Хмм, жақсы демалыс.
Dialogue: 0,0:16:26.11,0:16:30.51,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:16:32.79,0:16:36.69,Default,,0,0,0,,...
Dialogue: 0,0:16:36.69,0:16:39.06,Default,,0,0,0,,Әдеттегідей «Том» шеберінен тыңдаңыз.
Dialogue: 0,0:16:39.06,0:16:43.40,Default,,0,0,0,,Мен саған қарыздармын, түсіндің бе?
Dialogue: 0,0:16:43.40,0:16:45.33,Default,,0,0,0,,１
Dialogue: 0,0:16:45.33,0:16:49.20,Default,,0,0,0,,...
Dialogue: 0,0:16:49.20,0:16:52.94,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:16:52.94,0:16:55.84,Default,,0,0,0,,Қош келдіңіз, не істеуіміз керек?
Dialogue: 0,0:16:55.84,0:16:59.25,Default,,0,0,0,,А... жарайды, парфе жақсы, сэндвичтер де жақсы.
Dialogue: 0,0:16:59.25,0:17:01.75,Default,,0,0,0,,А, Пиноконың сорпасы ше?
Dialogue: 0,0:17:01.75,0:17:04.29,Default,,0,0,0,,Пиноко-чан, сен қатты толқыдың, иә?
Dialogue: 0,0:17:04.29,0:17:07.02,Default,,0,0,0,,２
Dialogue: 0,0:17:07.02,0:17:09.92,Default,,0,0,0,,Үлкен бөлік
Dialogue: 0,0:17:12.69,0:17:17.53,Default,,0,0,0,,Содан бері 10 күн өтті, ота жасалған күннен бері ол адам жоғалып кетті.
Dialogue: 0,0:17:17.53,0:17:21.83,Default,,0,0,0,,Сүйемін деген әйелімді жалғыз қалдыру.
Dialogue: 0,0:17:24.44,0:17:28.78,Default,,0,0,0,,Әй, ол кісі де бүгін келе жатқан жоқ па?
Dialogue: 0,0:17:28.78,0:17:32.48,Default,,0,0,0,,Хмм, маған бәрібір.
Dialogue: 0,0:17:35.15,0:17:37.49,Default,,0,0,0,,Бұл жігіт не істеп жатыр?
Dialogue: 0,0:17:37.49,0:17:40.25,Default,,0,0,0,,Менде бұл заңды бизнес емес деген түсінік жоқ.
Dialogue: 0,0:17:40.25,0:17:42.35,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:17:44.76,0:17:47.06,Default,,0,0,0,,Ченчей
Dialogue: 0,0:17:52.83,0:17:55.13,Default,,0,0,0,,Пиноко сенің соңынан ереді.
Dialogue: 0,0:18:02.38,0:18:05.48,Default,,0,0,0,,Ақырында бір ай өтті
Dialogue: 0,0:18:19.73,0:18:22.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:25.43,0:18:28.34,Default,,0,0,0,,Сізге ұнады ма? өте жақсы
Dialogue: 0,0:18:28.34,0:18:30.61,Default,,0,0,0,,Куру, Ренка ше?
Dialogue: 0,0:18:30.61,0:18:33.54,Default,,0,0,0,,Операция сәтті болды ма? Иә
Dialogue: 0,0:18:33.54,0:18:36.04,Default,,0,0,0,,Үлкен жетістік!
Dialogue: 0,0:18:39.11,0:18:41.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:44.62,0:18:47.66,Default,,0,0,0,,Қандай әдемі керемет
Dialogue: 0,0:18:47.66,0:18:49.66,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:18:58.93,0:19:01.20,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:01.20,0:19:04.11,Default,,0,0,0,,Ах... Ку... Куроо
Dialogue: 0,0:19:04.11,0:19:07.01,Default,,0,0,0,,Неге... неге бұрынғы әйеліңнің бетін таңдадың?
Dialogue: 0,0:19:07.01,0:19:10.41,Default,,0,0,0,,Мен саған мені әлемдегі ең сұлу әйел ет деп айтуым керек еді.
Dialogue: 0,0:19:10.41,0:19:12.45,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:12.45,0:19:15.15,Default,,0,0,0,,Мен... не істедім?
Dialogue: 0,0:19:15.15,0:19:18.12,Default,,0,0,0,,Мен анамды әлемдегі ең сұлу адам деп ойладым.
Dialogue: 0,0:19:18.12,0:19:20.82,Default,,0,0,0,,Өйткені мен сенемін
Dialogue: 0,0:19:24.23,0:19:28.13,Default,,0,0,0,,Бұдан былай анаңның жүзімен бетпе-бет өмір сүресің.
Dialogue: 0,0:19:34.47,0:19:39.04,Default,,0,0,0,,Өтірік болса да анаңды жақсы көретініңді айтсаң,
Dialogue: 0,0:19:39.04,0:19:41.44,Default,,0,0,0,,Мен басқаша жүз жасамақ болдым.
Dialogue: 0,0:19:47.25,0:19:50.35,Default,,0,0,0,,Қалған соманы менің шотыма аударуыңызды өтінемін.
Dialogue: 0,0:19:57.83,0:20:00.43,Default,,0,0,0,,Қош бол, әке
Dialogue: 0,0:20:06.53,0:20:09.44,Default,,0,0,0,,Содан бері 21 жыл (телефон рингтоны)
Dialogue: 0,0:20:09.44,0:20:11.67,Default,,0,0,0,,Мен қазір жоқпын.
Dialogue: 0,0:20:11.67,0:20:15.68,Default,,0,0,0,,Дыбыстық сигнал шыққан кезде атыңызды және сізге не қажет екенін айтыңыз.
Dialogue: 0,0:20:15.68,0:20:20.38,Default,,0,0,0,,Жаңбыр жауып тұр. Ларго, тамақ ішейік.
Dialogue: 0,0:20:20.38,0:20:25.08,Default,,0,0,0,,Осында болған соң, Оку-танды қашанғы жалғыз қалдырасың?
Dialogue: 0,0:20:27.59,0:20:31.59,Default,,0,0,0,,Не? Ларго? не болды? Ларго!
Dialogue: 0,0:20:37.67,0:20:41.87,Default,,0,0,0,,Қош болыңыз, Қара Джек мырза
Dialogue: 0,0:20:45.41,0:20:47.41,Default,,0,0,0,,Largo!
Dialogue: 0,0:21:13.83,0:21:15.90,Default,,0,0,0,,Largo!
Dialogue: 0,0:21:15.90,0:21:19.64,Default,,0,0,0,,Күте тұрыңыз! Ах!
Dialogue: 0,0:21:19.64,0:21:22.84,Default,,0,0,0,,Қытай машиналары, қытай машиналары...
Dialogue: 0,0:21:22.84,0:21:27.31,Default,,0,0,0,,Ларго, мені жібер, мені жібер.
Dialogue: 0,0:21:27.31,0:21:30.22,Default,,0,0,0,,Largo? Хаха
Dialogue: 0,0:21:30.22,0:21:32.15,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:32.15,0:21:34.99,Default,,0,0,0,,Құрметті Блэк Джек мырза
Dialogue: 0,0:21:34.99,0:21:37.06,Default,,0,0,0,,Анаң сені күтіп отыр.
Dialogue: 0,0:21:37.06,0:21:40.23,Default,,0,0,0,,Мүмкіндігінше тезірек келіңіз.
Dialogue: 0,0:21:40.23,0:21:43.63,Default,,0,0,0,,Аспанға (таймер дыбысы)
Dialogue: 0,0:21:48.97,0:21:52.44,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:52.44,0:21:54.84,Default,,0,0,0,,Кя!
Dialogue: 0,0:22:07.25,0:22:09.45,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:22:12.73,0:22:16.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:23:45.52,0:23:48.06,Default,,0,0,0,,Блэк Джектің өмірін мақсат еткен жұмбақ ұйым
Dialogue: 0,0:23:48.06,0:23:50.96,Default,,0,0,0,,Енді әлемді дүр сілкіндірген үлкен қастандық басталды.
Dialogue: 0,0:23:50.96,0:23:55.30,Default,,0,0,0,,Мәйіт әлі табылған жоқ, ал заттар ше?
Dialogue: 0,0:23:55.30,0:23:57.67,Default,,0,0,0,,Блэк Джек қайтыс болды
Dialogue: 0,0:23:57.67,0:24:02.14,Default,,0,0,0,,Ең бастысы өткенмен емес, қазіргімен өмір сүру
Dialogue: 0,0:24:02.14,0:24:04.84,Default,,0,0,0,,Блэк Джек мырза?
Dialogue: 0,0:24:04.84,0:24:07.71,Default,,0,0,0,,Елес өлген жоқ!
Dialogue: 0,0:24:07.71,0:24:10.14,Default,,0,0,0,,«Қара Джек 21» Келесі Карта
Dialogue: 0,0:24:10.14,0:24:12.08,Default,,0,0,0,,Қайғылы Пиноко
Dialogue: 0,0:24:12.08,0:24:15.75,Default,,0,0,0,,21 жыл бұрынғы жарылыс кездейсоқ болған жоқ.
Dialogue: 0,0:24:16.02,0:24:17.78,Default,,0,0,0,,Шаракуды табыңыз!
Dialogue: 0,0:24:19.69,0:24:22.52,Default,,0,0,0,,Тохохо осындай жерде
Dialogue: 0,0:24:22.52,0:24:25.22,Default,,0,0,0,,Келесі жолы мені тауып беріңізші
Dialogue: 0,0:24:26.72,0:24:32.72,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
