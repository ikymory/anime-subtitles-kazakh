Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.25,0:00:08.25,Default,,0,0,0,,♪~
Dialogue: 0,0:01:25.33,0:01:31.34,Default,,0,0,0,,~♪
Dialogue: 0,0:01:34.46,0:01:39.09,Default,,0,0,0,,(тұман)
Dialogue: 0,0:01:43.52,0:01:47.35,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:48.77,0:01:51.77,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:55.53,0:01:57.90,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:02:24.22,0:02:27.10,Default,,0,0,0,,Күтіңіз, күтіңіз, күтіңіз! Қашпа, бюстгальтер!
Dialogue: 0,0:02:27.18,0:02:28.56,Default,,0,0,0,,Енді қаша алмайсың!
Dialogue: 0,0:02:28.64,0:02:31.10,Default,,0,0,0,,Моккори Рё-чанға оралыңыз!
Dialogue: 0,0:02:31.94,0:02:33.06,Default,,0,0,0,,Хе-хе…
Dialogue: 0,0:02:34.19,0:02:35.53,Default,,0,0,0,,Не? Ой...
Dialogue: 0,0:02:35.61,0:02:37.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:38.65,0:02:40.57,Default,,0,0,0,,Сәлем, Рио-сама
Dialogue: 0,0:02:40.66,0:02:42.91,Default,,0,0,0,,Егер менің көкірекшем ұнаса—
Dialogue: 0,0:02:42.99,0:02:45.83,Default,,0,0,0,,Мен сізге беремін, келіңіз, алыңыз.
Dialogue: 0,0:02:45.91,0:02:46.74,Default,,0,0,0,,Хе-хе…
Dialogue: 0,0:02:46.83,0:02:48.71,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:02:49.41,0:02:51.75,Default,,0,0,0,,А... тез~
Dialogue: 0,0:02:51.83,0:02:54.17,Default,,0,0,0,,Қоңырау соғылып біткенше
Dialogue: 0,0:02:54.25,0:02:56.63,Default,,0,0,0,,Иә, иә, иә, иә, иә, иә!
Dialogue: 0,0:02:56.71,0:02:58.59,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:02:58.67,0:03:00.05,Default,,0,0,0,,Бюстгалтеріңізді кеш қалдырыңыз!
Dialogue: 0,0:03:01.72,0:03:02.68,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:03:02.76,0:03:04.26,Default,,0,0,0,,Гугугугугу…
Dialogue: 0,0:03:04.35,0:03:05.93,Default,,0,0,0,,Уау, уау, уау...
Dialogue: 0,0:03:06.01,0:03:07.81,Default,,0,0,0,,Алып Моккори-чан жоғалып кетті!
Dialogue: 0,0:03:07.89,0:03:09.81,Default,,0,0,0,,Ол қайда? Бұл қайда? Қайда бардың?
Dialogue: 0,0:03:09.89,0:03:11.19,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:11.56,0:03:12.60,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:03:14.06,0:03:15.48,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:03:16.73,0:03:18.28,Default,,0,0,0,,Бұл кім? ? Түн ортасында осылай
Dialogue: 0,0:03:18.36,0:03:21.15,Default,,0,0,0,,Сізге рахмет, аққұба жоғалып кетті!
Dialogue: 0,0:03:21.24,0:03:22.36,Default,,0,0,0,,...
Dialogue: 0,0:03:22.45,0:03:23.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:24.20,0:03:25.37,Default,,0,0,0,,Умибозу…
Dialogue: 0,0:03:25.91,0:03:26.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:27.08,0:03:29.16,Default,,0,0,0,,Мен сізден жұмыс сұрағым келеді.
Dialogue: 0,0:03:29.25,0:03:30.62,Default,,0,0,0,,Мен... Бұл жұмыс! ?
Dialogue: 0,0:03:30.71,0:03:33.00,Default,,0,0,0,,Мұндай жағдай Тенду-сама көтерілгеннен кейін ғана болды...
Dialogue: 0,0:03:33.08,0:03:34.79,Default,,0,0,0,,Екінші адам аққұба әдемі әйел.
Dialogue: 0,0:03:34.88,0:03:36.13,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:36.21,0:03:37.84,Default,,0,0,0,,Няха~
Dialogue: 0,0:03:38.50,0:03:40.42,Default,,0,0,0,,А... Мен көмектесе алмаймын.
Dialogue: 0,0:03:40.51,0:03:43.05,Default,,0,0,0,,Бұл Умибозудан басқа ешкімнің өтініші. Мен оны қабылдаймын.
Dialogue: 0,0:03:43.13,0:03:46.14,Default,,0,0,0,,Capital Inn Tokyo 904 бөлмесінде
Dialogue: 0,0:03:46.22,0:03:49.02,Default,,0,0,0,,Бізде Кэтрин Хэйвард есімді әйел тұрады.
Dialogue: 0,0:03:49.10,0:03:49.93,Default,,0,0,0,,Жыл?
Dialogue: 0,0:03:50.02,0:03:51.35,Default,,0,0,0,,18
Dialogue: 0,0:03:51.43,0:03:54.77,Default,,0,0,0,,Сонымен 18~
Dialogue: 0,0:03:54.85,0:03:57.48,Default,,0,0,0,,Ол Жапонияда көрікті жерлерді аралауда.
Dialogue: 0,0:03:57.57,0:04:00.32,Default,,0,0,0,,Мен Жапонияда бірінші рет болып тұрмын, сондықтан ата-анам уайымдап жатыр...
Dialogue: 0,0:04:00.40,0:04:02.40,Default,,0,0,0,,Ол мені алып жүруді өтінді.
Dialogue: 0,0:04:02.90,0:04:05.53,Default,,0,0,0,,Бірақ мен сізді шұғыл мәселеге байланысты шығарып сала алмаймын.
Dialogue: 0,0:04:05.62,0:04:08.49,Default,,0,0,0,,Хмм... оның астарында бірдеңе жатқан сияқты.
Dialogue: 0,0:04:08.58,0:04:10.37,Default,,0,0,0,,Ұнамаса, жақсы, басқасын таңда.
Dialogue: 0,0:04:10.45,0:04:13.92,Default,,0,0,0,,Ах! Сабырсыз боқ! Кім жоқ деді?
Dialogue: 0,0:04:14.00,0:04:15.54,Default,,0,0,0,,-（） -（）
Dialogue: 0,0:04:15.63,0:04:16.46,Default,,0,0,0,,Эй, күте тұр!
Dialogue: 0,0:04:27.22,0:04:31.18,Default,,0,0,0,,...Ол біржақты, өзімшіл жігіт.
Dialogue: 0,0:04:31.27,0:04:33.69,Default,,0,0,0,,Аа... ақымақ...
Dialogue: 0,0:04:33.77,0:04:36.31,Default,,0,0,0,,Әдемі аққұба әйелмен және махаббатпен Токионың көрікті жерлерін аралау
Dialogue: 0,0:04:36.40,0:04:37.56,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:38.11,0:04:39.61,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,0:04:39.69,0:04:42.74,Default,,0,0,0,,Егер сіз есеп берусіз толық емес жұмыс күнімен жұмыс істей аламын деп ойласаңыз...
Dialogue: 0,0:04:42.82,0:04:45.07,Default,,0,0,0,,Үлкен қате, балға!
Dialogue: 0,0:05:04.72,0:05:05.55,Default,,0,0,0,,
Dialogue: 0,0:05:05.63,0:05:07.18,Default,,0,0,0,,Ха... кім?
Dialogue: 0,0:05:08.01,0:05:10.60,Default,,0,0,0,,Бөлмеге қызмет көрсету. Сізге таңғы ас әкелінді.
Dialogue: 0,0:05:10.68,0:05:12.97,Default,,0,0,0,,Таңғы ас? Мен мұндай нәрсені сұрамас едім.
Dialogue: 0,0:05:13.43,0:05:14.85,Default,,0,0,0,,Бұл қандай да бір қателік.
Dialogue: 0,0:05:15.27,0:05:16.73,Default,,0,0,0,,Үйге апарыңыз.
Dialogue: 0,0:05:16.81,0:05:19.36,Default,,0,0,0,,Жоқ, бұл қате емес.
Dialogue: 0,0:05:19.90,0:05:21.69,Default,,0,0,0,,Қайырлы таң Кэтрин!
Dialogue: 0,0:05:21.77,0:05:23.57,Default,,0,0,0,,Махаббат бөлмесіне қызмет көрсету
Dialogue: 0,0:05:23.65,0:05:25.99,Default,,0,0,0,,Сіз қалай кірдіңіз?
Dialogue: 0,0:05:26.07,0:05:27.28,Default,,0,0,0,,Есік құлыптаулы болуы керек еді.
Dialogue: 0,0:05:27.36,0:05:28.41,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:05:28.49,0:05:32.45,Default,,0,0,0,,Махаббат әмбебап және есік тосқауылдары жоқ.
Dialogue: 0,0:05:32.54,0:05:35.25,Default,,0,0,0,,Боку-чан Саэба Рё Умибозуның «Шымшақты соққысы».
Dialogue: 0,0:05:35.33,0:05:36.75,Default,,0,0,0,,Умибозу?
Dialogue: 0,0:05:36.83,0:05:38.71,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:05:39.21,0:05:42.00,Default,,0,0,0,,Жыл - 18, ол сіз ала алатындай лоликонға жақын ...
Dialogue: 0,0:05:42.09,0:05:43.63,Default,,0,0,0,,Керемет пропорциялар
Dialogue: 0,0:05:43.71,0:05:45.76,Default,,0,0,0,,Күтілгендей, шетелдіктер жақсы.
Dialogue: 0,0:05:45.84,0:05:47.97,Default,,0,0,0,,Саеба мырза, сіз Сұңқар...
Dialogue: 0,0:05:48.05,0:05:50.76,Default,,0,0,0,,Жоқ, егер Умибуузу мырза шымшып ұратын болса...
Dialogue: 0,0:05:50.85,0:05:52.68,Default,,0,0,0,,Өз рөліңізді тез орындауға қалай қарайсыз?
Dialogue: 0,0:05:53.68,0:05:54.93,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:05:55.02,0:05:58.31,Default,,0,0,0,,Шетелдік күткендей! Өте белсенді!
Dialogue: 0,0:05:58.39,0:06:00.02,Default,,0,0,0,,Кез келген уақытта келіңіз.
Dialogue: 0,0:06:00.10,0:06:02.65,Default,,0,0,0,,Уау! Қандай шыдамсыз адам!
Dialogue: 0,0:06:02.73,0:06:03.98,Default,,0,0,0,,Мен сені қатты жақсы көремін!
Dialogue: 0,0:06:04.07,0:06:05.44,Default,,0,0,0,,Не?
Dialogue: 0,0:06:05.53,0:06:07.61,Default,,0,0,0,,Кя Сарин Чан!
Dialogue: 0,0:06:07.70,0:06:09.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:11.07,0:06:14.54,Default,,0,0,0,,Бұл ұлттық масқара! Өзіңізді халықаралық деңгейде ұятқа қалдырмаңыз!
Dialogue: 0,0:06:14.62,0:06:16.04,Default,,0,0,0,,– деді Джосукэ Хигасиката. Гү…
Dialogue: 0,0:06:16.12,0:06:18.00,Default,,0,0,0,,Неліктен ладан бұл жерде...
Dialogue: 0,0:06:18.87,0:06:20.25,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:06:20.33,0:06:22.38,Default,,0,0,0,,Не... сіз нені түсінбедіңіз?
Dialogue: 0,0:06:22.46,0:06:25.46,Default,,0,0,0,,Үмібозы мәжбүрлеуден басқа амалым қалмады...
Dialogue: 0,0:06:25.55,0:06:27.88,Default,,0,0,0,,Сонда сіз тек бір шалбарға азайып қалдыңыз ба?
Dialogue: 0,0:06:27.97,0:06:29.43,Default,,0,0,0,,Сізден сұралды:
Dialogue: 0,0:06:29.51,0:06:32.72,Default,,0,0,0,,Ол көрікті жерлерге баруға келген құрбы қыздың жолсерігі болып жүрген шығар!
Dialogue: 0,0:06:33.26,0:06:35.89,Default,,0,0,0,,Туристік эскорт рөлі?
Dialogue: 0,0:06:35.97,0:06:38.73,Default,,0,0,0,,А, мен Каори Макимура, менің көмекшім.
Dialogue: 0,0:06:38.81,0:06:40.94,Default,,0,0,0,,Сәлем, мен қаншықпын, кешіріңізші.
Dialogue: 0,0:06:41.02,0:06:42.94,Default,,0,0,0,,Дұрыс, бұл салт-дәстүрдегі айырмашылық.
Dialogue: 0,0:06:43.06,0:06:44.73,Default,,0,0,0,,Бұл сіздің әдетіңіз!
Dialogue: 0,0:06:44.82,0:06:45.86,Default,,0,0,0,,Аа бор бор
Dialogue: 0,0:06:45.94,0:06:47.11,Default,,0,0,0,,Сіз—
Dialogue: 0,0:06:47.19,0:06:48.95,Default,,0,0,0,,Сіз Үмибозу мырзамен бір саладасыз ба?
Dialogue: 0,0:06:49.03,0:06:50.20,Default,,0,0,0,,бұл... Иә, дұрыс.
Dialogue: 0,0:06:50.28,0:06:51.32,Default,,0,0,0,,Ол қайда барады?
Dialogue: 0,0:06:51.41,0:06:52.49,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:06:52.57,0:06:54.78,Default,,0,0,0,,Мен, мен сені телефон арқылы сұрадым.
Dialogue: 0,0:06:55.49,0:06:56.54,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:57.29,0:06:59.04,Default,,0,0,0,,Кэтрин!
Dialogue: 0,0:06:59.12,0:07:00.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:00.83,0:07:03.54,Default,,0,0,0,,Мына жырық көйлек сыртқа шығуға жарасады...
Dialogue: 0,0:07:03.63,0:07:07.05,Default,,0,0,0,,Маған келетін болсақ, мен супер мини нәрсе алғым келеді!
Dialogue: 0,0:07:07.13,0:07:09.47,Default,,0,0,0,,Іш киімнің түсіне назар аударыңыз.
Dialogue: 0,0:07:09.55,0:07:11.38,Default,,0,0,0,,О, өте сүйкімді!
Dialogue: 0,0:07:11.47,0:07:12.76,Default,,0,0,0,,Бұл сүйікті
Dialogue: 0,0:07:14.43,0:07:16.47,Default,,0,0,0,,Жапонияда әйелдерді алып жүру кезінде...
Dialogue: 0,0:07:16.56,0:07:18.56,Default,,0,0,0,,Адамдардың заттарын іздеу! ?
Dialogue: 0,0:07:18.64,0:07:19.81,Default,,0,0,0,,Себебі—
Dialogue: 0,0:07:19.89,0:07:23.40,Default,,0,0,0,,Жапон тілі Біреуді жақсы білмейінше, алып жүруге болмайды.
Dialogue: 0,0:07:23.48,0:07:25.86,Default,,0,0,0,,Бұл да әдет-ғұрыптың айырмашылығы деп айтасыз ба?
Dialogue: 0,0:07:25.94,0:07:27.57,Default,,0,0,0,,Иә, Әл.
Dialogue: 0,0:07:27.65,0:07:30.28,Default,,0,0,0,,«Қалаға кірсең, қалаға бағын»...
Dialogue: 0,0:07:30.36,0:07:31.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:33.36,0:07:36.24,Default,,0,0,0,,Мұны қалай кешіресіз?
Dialogue: 0,0:07:36.33,0:07:38.91,Default,,0,0,0,,Білесің бе, көшеге шыққанда, киім ауыстырғың келсе де...
Dialogue: 0,0:07:39.00,0:07:41.21,Default,,0,0,0,,Жапондық іш киім шетелдіктерге жарамайды...
Dialogue: 0,0:07:41.29,0:07:44.71,Default,,0,0,0,,Сыртта іш киімді кім ауыстырады?
Dialogue: 0,0:07:45.17,0:07:46.21,Default,,0,0,0,,Ngo!
Dialogue: 0,0:07:47.00,0:07:48.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.88,0:07:54.09,Default,,0,0,0,,(лифт қоңырауы)
Dialogue: 0,0:08:00.85,0:08:03.10,Default,,0,0,0,,Аққұба және бұйра шаш Аққұба және бұйра шаш...
Dialogue: 0,0:08:03.19,0:08:04.23,Default,,0,0,0,,Салқын...
Dialogue: 0,0:08:06.27,0:08:08.15,Default,,0,0,0,,Бұл мүмкіндікті пайдаланыңыз...
Dialogue: 0,0:08:09.11,0:08:11.11,Default,,0,0,0,,Хмм... анау жігіт...
Dialogue: 0,0:08:12.78,0:08:13.82,Default,,0,0,0,,Сақ бол
Dialogue: 0,0:08:14.36,0:08:15.99,Default,,0,0,0,,Ладан, қара, көлік кілті
Dialogue: 0,0:08:16.07,0:08:16.91,Default,,0,0,0,,Не?
Dialogue: 0,0:08:16.99,0:08:18.78,Default,,0,0,0,,Көлігіңізді қонақүйдің алдына бұрыңыз.
Dialogue: 0,0:08:18.87,0:08:22.96,Default,,0,0,0,,Кәрі адамсың, оны әзірше алып кетуге тырыспа.
Dialogue: 0,0:08:23.04,0:08:25.50,Default,,0,0,0,,Сіздің мінез-құлық үлгіңіз: Соңғы кездері сіз тығырыққа тірелдіңіз.
Dialogue: 0,0:08:25.58,0:08:26.63,Default,,0,0,0,,Басқа таңдау жоқ!
Dialogue: 0,0:08:26.71,0:08:29.84,Default,,0,0,0,,Сіз кенеттен пайда болғаныңыз үшін менде тағы бір жақсы идея бар ...
Dialogue: 0,0:08:29.92,0:08:30.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:30.84,0:08:32.97,Default,,0,0,0,,Хе...
Dialogue: 0,0:08:33.05,0:08:35.89,Default,,0,0,0,,Мен бұл туралы айтудан шаршадым, жүр.
Dialogue: 0,0:08:35.97,0:08:37.18,Default,,0,0,0,,Салқын...
Dialogue: 0,0:08:38.51,0:08:40.77,Default,,0,0,0,,Хехехе... хехехе...
Dialogue: 0,0:08:41.52,0:08:42.98,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:08:45.02,0:08:46.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:46.81,0:08:48.65,Default,,0,0,0,,Хмм... иә, бұл
Dialogue: 0,0:08:49.69,0:08:51.36,Default,,0,0,0,,Рахмет, әпке
Dialogue: 0,0:08:51.44,0:08:52.69,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:08:52.78,0:08:53.61,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:08:53.69,0:08:55.07,Default,,0,0,0,,Папа!
Dialogue: 0,0:08:56.99,0:08:58.70,Default,,0,0,0,,Анау-мынау жүгіру қауіпті еді.
Dialogue: 0,0:08:58.78,0:08:59.83,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:01.04,0:09:02.16,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:09:02.25,0:09:03.29,Default,,0,0,0,,Иә
Dialogue: 0,0:09:04.75,0:09:07.83,Default,,0,0,0,,Асами папа, мен жақында ойын-сауық саябағына барғым келеді!
Dialogue: 0,0:09:07.92,0:09:11.00,Default,,0,0,0,,Жарайды, олай болса, дайындалу үшін бөлмеге барайық.
Dialogue: 0,0:09:13.13,0:09:14.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:14.26,0:09:15.72,Default,,0,0,0,,Кэтрин, не болды?
Dialogue: 0,0:09:16.93,0:09:19.05,Default,,0,0,0,,Каору-сан, балалар
Dialogue: 0,0:09:19.14,0:09:21.56,Default,,0,0,0,,Сіз Үмибозу мырзамен жиі жұмыс жасайсыз ба?
Dialogue: 0,0:09:21.64,0:09:24.06,Default,,0,0,0,,Бұл өте жақсы емес ...
Dialogue: 0,0:09:24.14,0:09:27.23,Default,,0,0,0,,Кейде мен сұраймын немесе сұраймын.
Dialogue: 0,0:09:27.31,0:09:28.15,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:09:28.23,0:09:29.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:29.36,0:09:32.65,Default,,0,0,0,,Сіз Үмибозу мырзаның қашан сатқындық жасайтынын білмейсіз.
Dialogue: 0,0:09:34.15,0:09:35.57,Default,,0,0,0,,Үмибозу мырзаға?
Dialogue: 0,0:09:37.07,0:09:38.91,Default,,0,0,0,,Саеба мырза баяу.
Dialogue: 0,0:09:38.99,0:09:39.91,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:39.99,0:09:42.87,Default,,0,0,0,,А, мен қазір қараймын, сондықтан осында күте тұрыңыз.
Dialogue: 0,0:09:45.87,0:09:49.00,Default,,0,0,0,,А... Қош болыңыз, бақылаушы-сан.
Dialogue: 0,0:09:55.97,0:09:58.18,Default,,0,0,0,,Дэнди Джек... Ол Жапонияға қашан барады? ?
Dialogue: 0,0:09:58.26,0:10:03.39,Default,,0,0,0,,Ешбір қажетсіз араласусыз миссияңызды тез арада аяқтаңыз.
Dialogue: 0,0:10:03.47,0:10:05.27,Default,,0,0,0,,Бұл раушан оның қанымен ...
Dialogue: 0,0:10:05.81,0:10:07.85,Default,,0,0,0,,Сұңқардың қанымен қызыл түске боя.
Dialogue: 0,0:10:20.28,0:10:23.33,Default,,0,0,0,,Не! Иіс жоқ па?
Dialogue: 0,0:10:23.41,0:10:24.66,Default,,0,0,0,,Мүмкіндік
Dialogue: 0,0:10:25.16,0:10:26.00,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:10:26.08,0:10:27.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:27.54,0:10:31.08,Default,,0,0,0,,Әпке! Алдын ала рахмет!
Dialogue: 0,0:10:31.83,0:10:32.92,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:10:33.00,0:10:35.42,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:10:36.09,0:10:37.05,Default,,0,0,0,,(Серо) Бастамас бұрын мен бұл жай ғана әуесқой деңгейде болады деп уайымдадым—
Dialogue: 0,0:10:37.13,0:10:38.26,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:10:38.80,0:10:41.30,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:10:41.39,0:10:42.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:42.80,0:10:43.72,Default,,0,0,0,,Хаа!
Dialogue: 0,0:10:51.60,0:10:52.65,Default,,0,0,0,,мен шынымен құрмет сезіндім.
Dialogue: 0,0:10:53.31,0:10:54.90,Default,,0,0,0,,Асами!
Dialogue: 0,0:10:54.98,0:10:57.36,Default,,0,0,0,,- Әке! Әке! -(Әке) Асами аман-есенсің...
Dialogue: 0,0:10:58.11,0:10:59.95,Default,,0,0,0,,Жақсы Жақсы...
Dialogue: 0,0:11:01.49,0:11:02.32,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:02.41,0:11:04.70,Default,,0,0,0,,Керемет рефлекстер
Dialogue: 0,0:11:04.78,0:11:07.29,Default,,0,0,0,,Арнайы дайындықтан өткендей...
Dialogue: 0,0:11:07.37,0:11:08.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:08.70,0:11:10.96,Default,,0,0,0,,Қажетсіз сұрауларды жасамаңыз
Dialogue: 0,0:11:12.63,0:11:14.84,Default,,0,0,0,,А-а... рахмет.
Dialogue: 0,0:11:14.92,0:11:16.46,Default,,0,0,0,,Олар студент болғанымен, тағылымдамаға келгеннен кейін олар баға жетпес ресурс.
Dialogue: 0,0:11:17.34,0:11:19.09,Default,,0,0,0,,Асами-чан... солай емес пе?
Dialogue: 0,0:11:19.17,0:11:20.42,Default,,0,0,0,,Бұдан былай сақ болыңыз.
Dialogue: 0,0:11:21.26,0:11:23.64,Default,,0,0,0,,Иә! Рахмет, әпке
Dialogue: 0,0:11:23.72,0:11:27.39,Default,,0,0,0,,Ендеше, жын иісі келмей тұрып, кір жуып алайық...
Dialogue: 0,0:11:29.68,0:11:30.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:31.02,0:11:34.06,Default,,0,0,0,,Сен мұнда менің көзімді ұрладың ғой.
Dialogue: 0,0:11:34.15,0:11:35.61,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:11:35.69,0:11:39.53,Default,,0,0,0,,Өздігінен жоғалып кетсең де, неге?
Dialogue: 0,0:11:39.61,0:11:42.82,Default,,0,0,0,,...Қауіпсіздікке жол бермедім.
Dialogue: 0,0:11:42.91,0:11:44.37,Default,,0,0,0,,Жапонияның жеке бөліктері!
Dialogue: 0,0:11:44.45,0:11:46.49,Default,,0,0,0,,Сіз ұятсыз!
Dialogue: 0,0:11:48.33,0:11:51.50,Default,,0,0,0,,Қалалық аңшы Рио Саеба...
Dialogue: 0,0:11:51.58,0:11:55.42,Default,,0,0,0,,Сұңқар, сен қосымша жігіт әкелдің.
Dialogue: 0,0:12:01.84,0:12:08.60,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:12:08.68,0:12:11.73,Default,,0,0,0,,Кэтрин-сан, сен өте діндарсың, солай емес пе?
Dialogue: 0,0:12:11.81,0:12:15.10,Default,,0,0,0,,Көрікті жерлерге барған кезде де шіркеуге дұға ету үшін қалай келуге болады?
Dialogue: 0,0:12:16.15,0:12:17.98,Default,,0,0,0,,...
Dialogue: 0,0:12:18.07,0:12:18.90,Default,,0,0,0,,...
Dialogue: 0,0:12:18.98,0:12:21.07,Default,,0,0,0,,Әй, бірдеңе дедіңіз бе?
Dialogue: 0,0:12:21.15,0:12:22.70,Default,,0,0,0,,Сіз, осы уақытқа дейін...
Dialogue: 0,0:12:22.78,0:12:25.28,Default,,0,0,0,,Сіз оны алып кетуді әлі ойламайсыз, солай ма?
Dialogue: 0,0:12:25.36,0:12:28.08,Default,,0,0,0,,А... Иә? Мен қайдан білемін?
Dialogue: 0,0:12:28.16,0:12:28.99,Default,,0,0,0,,…Таку
Dialogue: 0,0:12:30.24,0:12:32.46,Default,,0,0,0,,Бірақ ол...
Dialogue: 0,0:12:38.46,0:12:40.05,Default,,0,0,0,,Әке
Dialogue: 0,0:12:40.13,0:12:43.84,Default,,0,0,0,,Мен қандай да бір себептермен адамды өлтірмек болдым.
Dialogue: 0,0:12:43.92,0:12:46.84,Default,,0,0,0,,Бірақ мақсат орындалмады.
Dialogue: 0,0:12:46.93,0:12:48.43,Default,,0,0,0,,Мен қолыма жара салдым, бірақ...
Dialogue: 0,0:12:48.51,0:12:51.06,Default,,0,0,0,,Қалың тұманда адасып қалдым.
Dialogue: 0,0:12:51.14,0:12:53.18,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:12:53.27,0:12:55.10,Default,,0,0,0,,Бұл да Құдайдың нұсқауы
Dialogue: 0,0:12:55.19,0:12:57.10,Default,,0,0,0,,Ешкімді өлтірмеңіз
Dialogue: 0,0:12:57.19,0:12:59.02,Default,,0,0,0,,Құдайға мойынсұнбайсың
Dialogue: 0,0:12:59.11,0:13:01.90,Default,,0,0,0,,Бірақ адам Құдайға қарсы шықты.
Dialogue: 0,0:13:02.28,0:13:03.99,Default,,0,0,0,,Неліктен ол жазаланбайды?
Dialogue: 0,0:13:04.07,0:13:05.57,Default,,0,0,0,,Жазалау
Dialogue: 0,0:13:05.65,0:13:07.66,Default,,0,0,0,,Құдай бәрін көреді
Dialogue: 0,0:13:08.12,0:13:10.20,Default,,0,0,0,,Бірақ сегіз жыл өтті.
Dialogue: 0,0:13:10.28,0:13:12.37,Default,,0,0,0,,Құдай сол уақытта не істеді?
Dialogue: 0,0:13:13.33,0:13:16.58,Default,,0,0,0,,Мен Сұңқарды өлтіргеннен кейін жауабын іздеймін.
Dialogue: 0,0:13:17.88,0:13:19.17,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:28.09,0:13:29.22,Default,,0,0,0,,Баяу…
Dialogue: 0,0:13:30.55,0:13:31.85,Default,,0,0,0,,А, міне!
Dialogue: 0,0:13:31.93,0:13:34.27,Default,,0,0,0,,Ол саған осы жерде күтуіңді айтты!
Dialogue: 0,0:13:34.35,0:13:36.19,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:13:36.27,0:13:40.19,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:13:40.27,0:13:43.86,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:49.07,0:13:51.08,Default,,0,0,0,,Сіз мисс Кэтринді білесіз бе?
Dialogue: 0,0:13:51.16,0:13:52.54,Default,,0,0,0,,Yeah, well...
Dialogue: 0,0:13:52.62,0:13:54.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:57.46,0:14:00.00,Default,,0,0,0,,Мырза, оны құтқара гөр.
Dialogue: 0,0:14:00.08,0:14:01.13,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:05.01,0:14:06.88,Default,,0,0,0,,Не? Не айтқың келеді?
Dialogue: 0,0:14:06.97,0:14:08.30,Default,,0,0,0,,Келіңіздер ме?
Dialogue: 0,0:14:08.38,0:14:11.26,Default,,0,0,0,,Мен оның мұнда жоқ екенін ғана білемін.
Dialogue: 0,0:14:11.35,0:14:12.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:14.68,0:14:18.31,Default,,0,0,0,,Каори, сен қонақ үйге барып, оның қайтып оралмағанын көр.
Dialogue: 0,0:14:18.39,0:14:20.19,Default,,0,0,0,,Рио қайда бара жатыр?
Dialogue: 0,0:14:20.27,0:14:21.56,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:21.65,0:14:23.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.82,0:14:25.86,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:14:27.86,0:14:29.66,Default,,0,0,0,,Менде алаңдаушылық бар.
Dialogue: 0,0:14:29.74,0:14:31.03,Default,,0,0,0,,Айналдыру, содан кейін қайту
Dialogue: 0,0:14:32.20,0:14:33.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:33.33,0:14:35.62,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:14:35.70,0:14:36.87,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:36.95,0:14:39.04,Default,,0,0,0,,Мені жаңбырда жалғыз қалдырыңыз
Dialogue: 0,0:14:39.12,0:14:40.46,Default,,0,0,0,,Қайда бара жатырсың? ?
Dialogue: 0,0:14:43.50,0:14:48.92,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:14:50.05,0:14:51.68,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:14:53.35,0:14:59.23,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:07.23,0:15:08.65,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:15:22.96,0:15:24.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:24.59,0:15:25.75,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:15:25.84,0:15:27.88,Default,,0,0,0,,Умибозу жоқ.
Dialogue: 0,0:15:27.96,0:15:30.42,Default,,0,0,0,,Мм... мұнда неге келдің?
Dialogue: 0,0:15:30.51,0:15:31.34,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:15:31.43,0:15:32.89,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:15:32.97,0:15:35.26,Default,,0,0,0,,Сол адамның ерекше рефлекстері
Dialogue: 0,0:15:35.35,0:15:38.47,Default,,0,0,0,,Ал сіз Үмибозу сұңқарға қоңырау шалғанда
Dialogue: 0,0:15:38.56,0:15:40.06,Default,,0,0,0,,Мен бірдеңе болып жатыр деп ойладым.
Dialogue: 0,0:15:40.14,0:15:42.94,Default,,0,0,0,,Маған Үмибозу деген лақап ат қойылды.
Dialogue: 0,0:15:43.02,0:15:45.36,Default,,0,0,0,,Бұрын Falcon ретінде белгілі
Dialogue: 0,0:15:45.44,0:15:48.03,Default,,0,0,0,,Жай турист біле алмайды.
Dialogue: 0,0:15:48.11,0:15:49.94,Default,,0,0,0,,Ақсақ болса да жақсы емес.
Dialogue: 0,0:15:50.03,0:15:51.74,Default,,0,0,0,,Сіз мұны байқамайсыз.
Dialogue: 0,0:15:52.15,0:15:54.28,Default,,0,0,0,,Иә, тағы бір нәрсе бар.
Dialogue: 0,0:15:54.37,0:15:55.57,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:15:55.99,0:15:57.20,Default,,0,0,0,,Бұл қауіпті емес.
Dialogue: 0,0:15:58.08,0:15:59.66,Default,,0,0,0,,Мынаны қара!
Dialogue: 0,0:15:59.75,0:16:00.79,Default,,0,0,0,,Ах…
Dialogue: 0,0:16:00.87,0:16:03.58,Default,,0,0,0,,Сіз әлі де осындай нәрсені жасырып жүрсіз бе?
Dialogue: 0,0:16:03.67,0:16:04.71,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:16:04.79,0:16:07.04,Default,,0,0,0,,Мұндағы жамбасқа мұқият қараңыз!
Dialogue: 0,0:16:07.59,0:16:09.88,Default,,0,0,0,,Бұл жерде аздап тозған.
Dialogue: 0,0:16:09.96,0:16:13.01,Default,,0,0,0,,Себебі жамбастың ішкі бөлігінде жасырылған мылтық іш киіміңізге тиеді.
Dialogue: 0,0:16:13.09,0:16:15.72,Default,,0,0,0,,Сіз жай ғана ешкім емессіз.
Dialogue: 0,0:16:16.22,0:16:18.72,Default,,0,0,0,,Я... Мен Рио Саебамын
Dialogue: 0,0:16:18.81,0:16:21.18,Default,,0,0,0,,Қалалық аңшы ретінде де белгілі.
Dialogue: 0,0:16:21.60,0:16:24.73,Default,,0,0,0,,Иә... сен сол Қалалық аңшысың.
Dialogue: 0,0:16:24.81,0:16:26.40,Default,,0,0,0,,Мен көп өсек естідім.
Dialogue: 0,0:16:26.48,0:16:30.44,Default,,0,0,0,,Қарсы болмасаңыз, Умибозуды не үшін нысанаға алғаныңызды айта аласыз ба?
Dialogue: 0,0:16:30.94,0:16:31.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:31.94,0:16:35.41,Default,,0,0,0,,Адамдардың іш киімдерін қайда сақтайсыз? …Таку
Dialogue: 0,0:16:35.49,0:16:36.57,Default,,0,0,0,,Уууу…
Dialogue: 0,0:16:36.66,0:16:38.62,Default,,0,0,0,,Мен оны көрсетпеуім керек еді.
Dialogue: 0,0:16:41.41,0:16:42.45,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:45.75,0:16:46.58,Default,,0,0,0,,Сұңқар!
Dialogue: 0,0:16:46.67,0:16:47.84,Default,,0,0,0,,Кэтрин
Dialogue: 0,0:16:48.84,0:16:50.75,Default,,0,0,0,,Мен сізге айтамын, Саеба мырза.
Dialogue: 0,0:16:50.84,0:16:52.80,Default,,0,0,0,,Неліктен мен Сұңқарды нысанаға алып отырмын?
Dialogue: 0,0:16:52.88,0:16:55.51,Default,,0,0,0,,Сегіз жыл бұрын ол әкемнен айырылды...
Dialogue: 0,0:16:56.47,0:16:59.01,Default,,0,0,0,,Қарусыз әкемді арқасынан атып тастадым!
Dialogue: 0,0:17:00.56,0:17:03.18,Default,,0,0,0,,Соңғы сегіз жыл бойы мен күндіз-түні...
Dialogue: 0,0:17:03.27,0:17:05.19,Default,,0,0,0,,Сұңқарды өлтіру - мені алға жетелейтін жалғыз нәрсе.
Dialogue: 0,0:17:05.27,0:17:06.90,Default,,0,0,0,,Мен қиын жаттығуларды бастан өткердім.
Dialogue: 0,0:17:07.48,0:17:08.31,Default,,0,0,0,,Және—
Dialogue: 0,0:17:08.40,0:17:10.40,Default,,0,0,0,,Мен ақыры Юбе Фальконмен таныстым.
Dialogue: 0,0:17:10.48,0:17:11.61,Default,,0,0,0,,Бірақ ол қашып кетті
Dialogue: 0,0:17:12.23,0:17:14.53,Default,,0,0,0,,Сенің менімен адал жарысатын ойың жоқ.
Dialogue: 0,0:17:14.61,0:17:17.07,Default,,0,0,0,,Қорқақ, қорқақ!
Dialogue: 0,0:17:17.16,0:17:21.16,Default,,0,0,0,,Үмибозудың қашуының себебі болуы керек.
Dialogue: 0,0:17:21.24,0:17:23.54,Default,,0,0,0,,Мен төбелеске шақырғанда қашатын жігіт емеспін.
Dialogue: 0,0:17:23.62,0:17:27.00,Default,,0,0,0,,Сіз менімен бәсекелесе алмайсыз, өйткені өзіңізді кінәлі сезінесіз.
Dialogue: 0,0:17:37.51,0:17:38.93,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:17:39.97,0:17:41.68,Default,,0,0,0,,Сабыр ет, Кэтрин.
Dialogue: 0,0:17:41.76,0:17:43.35,Default,,0,0,0,,Сіз Умибозуды өлтіре алмайсыз.
Dialogue: 0,0:17:43.43,0:17:44.73,Default,,0,0,0,,Мен сені өлтіре аламын.
Dialogue: 0,0:17:44.81,0:17:47.81,Default,,0,0,0,,Мен сегіз жыл бойы өлтіруші болып дайындалдым.
Dialogue: 0,0:17:47.90,0:17:52.52,Default,,0,0,0,,Шын мәнінде біреуді ату сіз ойлағандай оңай емес.
Dialogue: 0,0:17:52.98,0:17:54.03,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:57.03,0:17:58.36,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:17:58.45,0:18:02.70,Default,,0,0,0,,Сұңқар, кек шымылдығын өз қолыммен түсірейін.
Dialogue: 0,0:18:02.79,0:18:04.66,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:18:06.33,0:18:07.46,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:18:07.54,0:18:08.67,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:08.75,0:18:09.79,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:09.88,0:18:11.17,Default,,0,0,0,,Уууу…
Dialogue: 0,0:18:11.25,0:18:14.13,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:18:15.21,0:18:18.01,Default,,0,0,0,,Өл, Сұңқар!
Dialogue: 0,0:18:18.18,0:18:19.09,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:18:20.68,0:18:22.26,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:25.14,0:18:26.52,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:18:42.12,0:18:43.99,Default,,0,0,0,,Кэтрин! Умибозу!
Dialogue: 0,0:18:48.29,0:18:49.33,Default,,0,0,0,,Ол туралы не деуге болады?
Dialogue: 0,0:18:49.41,0:18:51.63,Default,,0,0,0,,Ол енді ғана есеңгіреп қалды.
Dialogue: 0,0:18:51.71,0:18:52.79,Default,,0,0,0,,Уф! Ахх...
Dialogue: 0,0:18:52.88,0:18:54.25,Default,,0,0,0,,Умибозу…
Dialogue: 0,0:18:54.34,0:18:55.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:58.67,0:19:00.05,Default,,0,0,0,,Тыңдау құрылғысы?
Dialogue: 0,0:19:00.88,0:19:02.18,Default,,0,0,0,,(бұралған дыбыс)
Dialogue: 0,0:19:11.60,0:19:13.73,Default,,0,0,0,,Өмірлік маңызды нүктелер сәл ауытқыған
Dialogue: 0,0:19:18.57,0:19:19.61,Default,,0,0,0,,Я...
Dialogue: 0,0:19:20.78,0:19:22.74,Default,,0,0,0,,Шынын айт, Үмибозу
Dialogue: 0,0:19:23.16,0:19:24.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:24.28,0:19:27.66,Default,,0,0,0,,Қарусыз адамды арқасынан атуға болмайды.
Dialogue: 0,0:19:33.63,0:19:35.13,Default,,0,0,0,,Бұл сегіз жыл бұрын болды.
Dialogue: 0,0:19:35.88,0:19:38.84,Default,,0,0,0,,Мен Кэтриннің әкесі Хейвардпен жұмыс істедім.
Dialogue: 0,0:19:39.88,0:19:43.22,Default,,0,0,0,,Сол кезде өз билігін кеңейтуге тырысқан қылмыстық ұйым...
Dialogue: 0,0:19:43.30,0:19:46.14,Default,,0,0,0,,Олар бізді әкелу үшін бізге хабарласты.
Dialogue: 0,0:19:46.22,0:19:48.31,Default,,0,0,0,,Бірақ біз бас тарттық.
Dialogue: 0,0:19:49.02,0:19:51.69,Default,,0,0,0,,Олар бізді құртуға тырысуда.
Dialogue: 0,0:19:51.77,0:19:56.06,Default,,0,0,0,,Кэтринді кепілге ұстау үшін әлі жас еді.
Dialogue: 0,0:19:56.15,0:19:57.23,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:19:57.32,0:19:59.19,Default,,0,0,0,,Жоқ! Әке!
Dialogue: 0,0:20:00.40,0:20:02.65,Default,,0,0,0,,Хейворд бұл туралы білгенде, ол:
Dialogue: 0,0:20:02.74,0:20:05.12,Default,,0,0,0,,Ол мені күтпестен пойызға жалғыз отырды.
Dialogue: 0,0:20:05.20,0:20:06.03,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:20:06.12,0:20:09.58,Default,,0,0,0,,Бірақ оны тұтқынға алып, арқасынан оқ жаудырды.
Dialogue: 0,0:20:10.70,0:20:13.04,Default,,0,0,0,,Мен жүгіріп барсам, кеш болды.
Dialogue: 0,0:20:13.12,0:20:14.00,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:20:14.08,0:20:17.42,Default,,0,0,0,,Мен ашуланып, ұйымды құрттым.
Dialogue: 0,0:20:19.50,0:20:22.93,Default,,0,0,0,,Бірақ бастық Дэнди Джек еш жерде көрінбеді.
Dialogue: 0,0:20:23.01,0:20:24.89,Default,,0,0,0,,Сондай-ақ Кэтриннің пайда болуы
Dialogue: 0,0:20:27.10,0:20:31.85,Default,,0,0,0,,Содан кейін Кэтрин менің алдымда кісі өлтіруші болып шықты.
Dialogue: 0,0:20:32.48,0:20:34.98,Default,,0,0,0,,Неге оған айтпайсың? шындық
Dialogue: 0,0:20:35.06,0:20:36.81,Default,,0,0,0,,Айтсам да сенбейсіңдер.
Dialogue: 0,0:20:38.44,0:20:41.28,Default,,0,0,0,,Кэтрин мені атып тастаса, бұл да жақсы.
Dialogue: 0,0:20:44.11,0:20:47.20,Default,,0,0,0,,...және оны менімен бірге қалдырды.
Dialogue: 0,0:20:47.28,0:20:48.99,Default,,0,0,0,,Дэнди Джек туралы білдіңіз бе?
Dialogue: 0,0:20:49.08,0:20:51.12,Default,,0,0,0,,Жапонияға да келді
Dialogue: 0,0:20:51.20,0:20:53.46,Default,,0,0,0,,Ал зымыран ұшырған ол.
Dialogue: 0,0:20:53.54,0:20:55.46,Default,,0,0,0,,Мен оған қамқор боламын
Dialogue: 0,0:20:55.54,0:20:58.42,Default,,0,0,0,,Оған дейін мен Екатеринадан жеңілуге шамам жетпейді.
Dialogue: 0,0:21:00.92,0:21:02.88,Default,,0,0,0,,Демал, Үмибозу
Dialogue: 0,0:21:10.43,0:21:13.39,Default,,0,0,0,,Мен Сұңқарды өлтірдім...
Dialogue: 0,0:21:13.48,0:21:14.31,Default,,0,0,0,,Мен өлтіремін...
Dialogue: 0,0:21:18.11,0:21:19.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:20.11,0:21:22.48,Default,,0,0,0,,А, сен байқадың, Кэтрин.
Dialogue: 0,0:21:22.57,0:21:24.24,Default,,0,0,0,,Falcon ше? Falcon қайда?
Dialogue: 0,0:21:24.90,0:21:27.95,Default,,0,0,0,,Ол жарақат алды және сізге көмектесу үшін төменде демалып жатыр.
Dialogue: 0,0:21:28.03,0:21:28.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:28.95,0:21:29.91,Default,,0,0,0,,-（）… -（）
Dialogue: 0,0:21:30.78,0:21:31.83,Default,,0,0,0,,Ннн…
Dialogue: 0,0:21:32.95,0:21:33.79,Default,,0,0,0,,Онда жоқ!
Dialogue: 0,0:21:33.87,0:21:34.83,Default,,0,0,0,,Не! ?
Dialogue: 0,0:21:37.50,0:21:39.29,Default,,0,0,0,,Сен де гуру болдың ғой!
Dialogue: 0,0:21:39.38,0:21:40.75,Default,,0,0,0,,Сіз Сұңқарды жіберіп алдыңыз!
Dialogue: 0,0:21:40.84,0:21:42.34,Default,,0,0,0,,Қайда бардың! ? Falcon - бұл
Dialogue: 0,0:21:42.42,0:21:44.13,Default,,0,0,0,,Ол қорқақ қорқақ!
Dialogue: 0,0:21:44.21,0:21:45.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:45.59,0:21:47.38,Default,,0,0,0,,Сабыр ет, Кэтрин!
Dialogue: 0,0:21:48.55,0:21:50.68,Default,,0,0,0,,Ол қашпайды
Dialogue: 0,0:21:50.76,0:21:52.68,Default,,0,0,0,,Ісімді аяқтаған соң, мен сіздің алдыңызға шығамын.
Dialogue: 0,0:21:56.23,0:21:59.60,Default,,0,0,0,,Бірақ оның денесі сондай...
Dialogue: 0,0:21:59.69,0:22:05.69,Default,,0,0,0,,♪~
Dialogue: 0,0:23:28.74,0:23:34.74,Default,,0,0,0,,~♪
Dialogue: 0,0:23:37.12,0:23:39.62,Default,,0,0,0,,Ондай денемен, Үмибозу мырза, сіз жеңілесіз.
Dialogue: 0,0:23:39.70,0:23:42.37,Default,,0,0,0,,Жоқ, ол жақсы. Мәселе Кэтринге көбірек қатысты.
Dialogue: 0,0:23:42.46,0:23:45.34,Default,,0,0,0,,Дұрыс, өйткені Рио ештеңе істемеді, ол әлі де дұрыс түсінбеді...
Dialogue: 0,0:23:45.42,0:23:46.96,Default,,0,0,0,,Дэнди Джек оралды.
Dialogue: 0,0:23:47.05,0:23:48.63,Default,,0,0,0,,Біз ештеңе істей алмаймыз, өйткені ешқандай дәлел жоқ.
Dialogue: 0,0:23:48.71,0:23:50.26,Default,,0,0,0,,Алданып қала берсең жеткіліксіз.
Dialogue: 0,0:23:50.34,0:23:52.05,Default,,0,0,0,,Менің бұл жерде Кэтринге бәс тігуден басқа амалым жоқ.
Dialogue: 0,0:23:52.13,0:23:54.85,Default,,0,0,0,,Бәрі жақсы, мен оны тез түсіндіруім керек!
Dialogue: 0,0:23:54.93,0:23:56.35,Default,,0,0,0,,«Қала аңшысы 2»
Dialogue: 0,0:23:59.27,0:24:00.93,Default,,0,0,0,,Көрмесең кек ал.
Dialogue: 0,0:24:02.43,0:24:08.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory