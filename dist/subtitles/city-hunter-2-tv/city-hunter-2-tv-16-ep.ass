Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.25,0:00:08.25,Default,,0,0,0,,♪~
Dialogue: 0,0:01:25.33,0:01:31.34,Default,,0,0,0,,~♪
Dialogue: 0,0:01:33.42,0:01:35.76,Default,,0,0,0,,Әдемі аққұба Кэтрин-чан
Dialogue: 0,0:01:35.84,0:01:39.93,Default,,0,0,0,,Бір қызығы, ол әкесінің жауы ретінде Үмібозды көздеп отыр.
Dialogue: 0,0:01:40.01,0:01:42.56,Default,,0,0,0,,Үмибозы шынымен сенің әкеңнің жауы ма?
Dialogue: 0,0:01:42.64,0:01:44.10,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:01:44.18,0:01:45.68,Default,,0,0,0,,Нағыз жау –
Dialogue: 0,0:01:45.77,0:01:49.27,Default,,0,0,0,,Дэнди Джек, Умибозу талқандаған ұйымның бастығы
Dialogue: 0,0:01:49.35,0:01:52.44,Default,,0,0,0,,Сонда сіздің ата-анаңыз сіздің нағыз жауыңыз ба?
Dialogue: 0,0:01:52.52,0:01:55.15,Default,,0,0,0,,Умибозу сол Дэнди Джекті ойнайды.
Dialogue: 0,0:01:55.24,0:01:57.74,Default,,0,0,0,,Мен жараланған денеммен құтылдым
Dialogue: 0,0:01:57.82,0:02:02.03,Default,,0,0,0,,Ей, Умибозу, сен мұндай денемен не істей аласың?
Dialogue: 0,0:02:20.01,0:02:25.89,Default,,0,0,0,,
Dialogue: 0,0:02:26.77,0:02:29.27,Default,,0,0,0,,Уау... не? Эй... не болды?
Dialogue: 0,0:02:29.81,0:02:32.15,Default,,0,0,0,,Бұл кім? Онда кім бар?
Dialogue: 0,0:02:32.73,0:02:33.86,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:02:33.94,0:02:35.44,Default,,0,0,0,,Мм... Үмибозу
Dialogue: 0,0:02:35.53,0:02:37.57,Default,,0,0,0,,Дэнди Джек қайда?
Dialogue: 0,0:02:37.65,0:02:39.20,Default,,0,0,0,,Дэнди Джек?
Dialogue: 0,0:02:39.28,0:02:40.32,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:02:40.86,0:02:43.28,Default,,0,0,0,,Осы жерде, тапаншадан зымыран атқыштарға дейін —
Dialogue: 0,0:02:43.37,0:02:45.16,Default,,0,0,0,,Бұл сіз бәрін таба алатын жалғыз орын.
Dialogue: 0,0:02:45.24,0:02:47.91,Default,,0,0,0,,Хмф... Не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:02:48.00,0:02:49.75,Default,,0,0,0,,Қайтып келеді.
Dialogue: 0,0:02:49.83,0:02:51.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:56.50,0:02:58.46,Default,,0,0,0,,Бұл өте хобби.
Dialogue: 0,0:02:59.17,0:03:00.59,Default,,0,0,0,,Хехехе... түсіндім.
Dialogue: 0,0:03:00.68,0:03:04.80,Default,,0,0,0,,Асыл тастармен өрнектелген, 3 миллион ештеңе емес.
Dialogue: 0,0:03:04.89,0:03:05.93,Default,,0,0,0,,Ннн…
Dialogue: 0,0:03:06.51,0:03:07.89,Default,,0,0,0,,А... не істеп жатырсың! ?
Dialogue: 0,0:03:09.18,0:03:10.64,Default,,0,0,0,,Мына мүсін де әдемі.
Dialogue: 0,0:03:11.27,0:03:12.10,Default,,0,0,0,,(Мүсіннің сынған дыбысы)
Dialogue: 0,0:03:12.19,0:03:13.56,Default,,0,0,0,,Жоқ... тоқтат, Үмибозу!
Dialogue: 0,0:03:14.02,0:03:16.27,Default,,0,0,0,,Хмм... бұл да тамаша.
Dialogue: 0,0:03:16.36,0:03:17.65,Default,,0,0,0,,Ал... күте тұрыңыз.
Dialogue: 0,0:03:17.73,0:03:19.28,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:03:19.36,0:03:21.53,Default,,0,0,0,,Мм... nnnnnnnnnn...
Dialogue: 0,0:03:21.61,0:03:22.95,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:03:23.62,0:03:25.62,Default,,0,0,0,,Мен таныстырған вилланың мекен-жайы
Dialogue: 0,0:03:25.70,0:03:28.37,Default,,0,0,0,,Сіз бұл жерде болмасаңыз, мен білмеймін.
Dialogue: 0,0:03:31.29,0:03:32.33,Default,,0,0,0,,Сізге кедергі болды.
Dialogue: 0,0:03:32.42,0:03:33.79,Default,,0,0,0,,Әй, міне, солай.
Dialogue: 0,0:03:33.88,0:03:35.84,Default,,0,0,0,,Бұл өте қымбат. Эй, иә? Эй
Dialogue: 0,0:03:36.75,0:03:37.80,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:37.88,0:03:39.76,Default,,0,0,0,,А... Тоқта... А!
Dialogue: 0,0:03:39.84,0:03:41.38,Default,,0,0,0,,Иа... Жоқ...
Dialogue: 0,0:03:42.80,0:03:44.51,Default,,0,0,0,,Ахх...
Dialogue: 0,0:03:45.93,0:03:50.31,Default,,0,0,0,,Ай!
Dialogue: 0,0:03:50.39,0:03:55.36,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:03:56.56,0:03:58.07,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:03:58.15,0:03:59.94,Default,,0,0,0,,Бұл сен кімсің?
Dialogue: 0,0:04:00.03,0:04:02.86,Default,,0,0,0,,Әй, дұрыс айтасың, Үмибозу осында.
Dialogue: 0,0:04:02.95,0:04:05.24,Default,,0,0,0,,Кішкене театршыл болайын десем, көп қиындыққа тап болдым.
Dialogue: 0,0:04:05.32,0:04:07.91,Default,,0,0,0,,Бұл зақым үшін не істейсіз? Иә?
Dialogue: 0,0:04:08.45,0:04:11.12,Default,,0,0,0,,Тек өмірің барына қуан.
Dialogue: 0,0:04:13.21,0:04:16.96,Default,,0,0,0,,Хахахаха... Сұңқар, күткендей болды.
Dialogue: 0,0:04:17.04,0:04:19.30,Default,,0,0,0,,Бұл жолы мен оны аяқтаймын.
Dialogue: 0,0:04:19.38,0:04:20.96,Default,,0,0,0,,Кэтринмен
Dialogue: 0,0:04:37.69,0:04:39.02,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:04:39.11,0:04:42.94,Default,,0,0,0,,
Dialogue: 0,0:04:43.36,0:04:45.95,Default,,0,0,0,,(сықырлау дыбысы)
Dialogue: 0,0:04:46.03,0:04:47.66,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:04:52.95,0:04:55.04,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:55.12,0:05:00.59,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:03.92,0:05:05.34,Default,,0,0,0,,Керемет
Dialogue: 0,0:05:07.34,0:05:10.51,Default,,0,0,0,,Мен үшін Falcon нысананың бір бөлігі ғана.
Dialogue: 0,0:05:11.39,0:05:13.47,Default,,0,0,0,,Енді мен оны дәлелдеймін.
Dialogue: 0,0:05:13.98,0:05:16.89,Default,,0,0,0,,Сегіз жыл осылай өмір сүрдің бе?
Dialogue: 0,0:05:17.56,0:05:20.19,Default,,0,0,0,,Кек алғаннан кейін не қалады? Сізге
Dialogue: 0,0:05:23.65,0:05:26.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:27.78,0:05:29.87,Default,,0,0,0,,Ештеңені қалдырудың қажеті жоқ.
Dialogue: 0,0:05:29.95,0:05:32.83,Default,,0,0,0,,Мен үшін Сұңқарды жеңу маңызды.
Dialogue: 0,0:05:33.49,0:05:35.62,Default,,0,0,0,,Сіз маңызды нәрсені ұмытып жатырсыз.
Dialogue: 0,0:05:35.71,0:05:37.62,Default,,0,0,0,,Мұны қазір жасай алу -
Dialogue: 0,0:05:37.71,0:05:40.29,Default,,0,0,0,,Өйткені Умибозу сені қорғау үшін денесін желіге қойды.
Dialogue: 0,0:05:40.38,0:05:41.59,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:41.67,0:05:43.46,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:05:43.55,0:05:45.05,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:05:45.13,0:05:46.01,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:05:46.59,0:05:51.43,Default,,0,0,0,,Әкеңнің арқасынан оқ атқан қорқақ болуы керек емес пе?
Dialogue: 0,0:05:51.51,0:05:54.10,Default,,0,0,0,,Неліктен әлгі Үмибозу бұлай істеді?
Dialogue: 0,0:05:54.18,0:05:55.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:56.35,0:05:58.94,Default,,0,0,0,,Хмф... ол екіжүзді.
Dialogue: 0,0:05:59.02,0:06:01.56,Default,,0,0,0,,Менің ойымша, ол сіздің алдыңызда әдемі көрінгісі келді.
Dialogue: 0,0:06:02.02,0:06:07.32,Default,,0,0,0,,Қазір не істесем де, не айтсам да, оның әкемді өлтіргені өзгермейді.
Dialogue: 0,0:06:11.87,0:06:13.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:13.49,0:06:15.24,Default,,0,0,0,,Эй, Рё, біз бірдеңе істей алмаймыз ба?
Dialogue: 0,0:06:15.83,0:06:19.58,Default,,0,0,0,,Енді оған ештеңе деудің қажеті жоқ.
Dialogue: 0,0:06:19.67,0:06:22.63,Default,,0,0,0,,Бірақ мен мұны істеп жатқанда, Үмибозу-сан...
Dialogue: 0,0:06:22.71,0:06:25.76,Default,,0,0,0,,Мені Дэнди Джек деген жігіт ұрып-соғуы мүмкін.
Dialogue: 0,0:06:25.84,0:06:27.42,Default,,0,0,0,,-（） -（）
Dialogue: 0,0:06:28.01,0:06:30.64,Default,,0,0,0,,Қазіргі Умибозу - жаралы аң.
Dialogue: 0,0:06:30.72,0:06:33.35,Default,,0,0,0,,Оны жеңе алатын бір ғана адам бар, бірақ...
Dialogue: 0,0:06:33.43,0:06:34.89,Default,,0,0,0,,Бұл Дэнди Джек емес
Dialogue: 0,0:06:35.93,0:06:38.35,Default,,0,0,0,,Сіз Рёны айтасыз ба?
Dialogue: 0,0:06:38.43,0:06:39.56,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:40.14,0:06:43.23,Default,,0,0,0,,Үмибозды жеңе алатын жалғыз адам...
Dialogue: 0,0:06:43.73,0:06:45.94,Default,,0,0,0,,Бұл Кэтрин
Dialogue: 0,0:06:46.03,0:06:48.28,Default,,0,0,0,,Иә? Ол?
Dialogue: 0,0:07:17.43,0:07:20.81,Default,,0,0,0,,Саеба мырза, кешегі күн үшін кешіріңіз.
Dialogue: 0,0:07:20.89,0:07:22.31,Default,,0,0,0,,Сенің осында екеніңді білсем...
Dialogue: 0,0:07:22.40,0:07:24.77,Default,,0,0,0,,Мен оларды зымыранмен немесе соған ұқсас нәрселермен ұрған жоқпын.
Dialogue: 0,0:07:25.27,0:07:28.48,Default,,0,0,0,,Мен бұлай сылтау айту үшін келген жоқпын.
Dialogue: 0,0:07:28.94,0:07:32.28,Default,,0,0,0,,Хаха... Дұрыс айтасыз. Бұл жылдам әңгіме.
Dialogue: 0,0:07:32.36,0:07:34.82,Default,,0,0,0,,Мен жолдасымды қайтаруға келдім.
Dialogue: 0,0:07:35.32,0:07:36.74,Default,,0,0,0,,Қандай серіктес!
Dialogue: 0,0:07:36.83,0:07:40.12,Default,,0,0,0,,Сіз Кэтринге ракета аттыңыз!
Dialogue: 0,0:07:40.20,0:07:42.67,Default,,0,0,0,,Нағыз серіктес мұны істей алмайды!
Dialogue: 0,0:07:44.00,0:07:46.04,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:07:46.13,0:07:48.38,Default,,0,0,0,,Түсіндім, жас ханым.
Dialogue: 0,0:07:48.46,0:07:51.55,Default,,0,0,0,,Бірақ сұңқар біздің ортақ жауымыз.
Dialogue: 0,0:07:51.63,0:07:53.30,Default,,0,0,0,,Сұңқарды жеңу -
Dialogue: 0,0:07:53.38,0:07:55.89,Default,,0,0,0,,Кэтрин өзін құрбан етуге дайын еді.
Dialogue: 0,0:07:56.39,0:07:58.35,Default,,0,0,0,,Солай ма? Кэтрин
Dialogue: 0,0:07:59.68,0:08:00.73,Default,,0,0,0,,Иә
Dialogue: 0,0:08:00.81,0:08:03.81,Default,,0,0,0,,Райо мұны жасамас еді! Мен мұны ешқашан жасамас едім!
Dialogue: 0,0:08:04.65,0:08:07.77,Default,,0,0,0,,Сізбен дауласудың қажеті жоқ.
Dialogue: 0,0:08:07.86,0:08:10.23,Default,,0,0,0,,Кел, Кэтрин.
Dialogue: 0,0:08:14.61,0:08:15.82,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:15.91,0:08:16.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:17.62,0:08:19.49,Default,,0,0,0,,Сіз оны ала аласыз ба?
Dialogue: 0,0:08:19.58,0:08:22.46,Default,,0,0,0,,Кэтринге көмегі үшін алғыс айту.
Dialogue: 0,0:08:23.12,0:08:24.71,Default,,0,0,0,,Қайырлы күн
Dialogue: 0,0:08:24.79,0:08:25.83,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:08:33.26,0:08:35.26,Default,,0,0,0,,...
Dialogue: 0,0:08:35.34,0:08:36.89,Default,,0,0,0,,Менің сізді тоқтатуға құқығым жоқ.
Dialogue: 0,0:08:36.97,0:08:38.01,Default,,0,0,0,,…
Dialogue: 0,0:08:46.40,0:08:48.44,Default,,0,0,0,,Ха... Мен кеттім.
Dialogue: 0,0:08:48.52,0:08:50.52,Default,,0,0,0,,Біз ештеңе істей алмаймыз, солай ма?
Dialogue: 0,0:08:50.61,0:08:52.49,Default,,0,0,0,,(таймер дыбысы)
Dialogue: 0,0:08:53.65,0:08:55.49,Default,,0,0,0,,-（）  -（）…
Dialogue: 0,0:08:56.66,0:08:59.33,Default,,0,0,0,,(таймер дыбысы)
Dialogue: 0,0:08:59.41,0:09:01.49,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:01.58,0:09:02.83,Default,,0,0,0,,Ахх...
Dialogue: 0,0:09:11.25,0:09:12.30,Default,,0,0,0,,Я...
Dialogue: 0,0:09:13.09,0:09:14.55,Default,,0,0,0,,…
Dialogue: 0,0:09:14.63,0:09:17.76,Default,,0,0,0,,Гүл шоғына бомба қойылды.
Dialogue: 0,0:09:17.84,0:09:20.51,Default,,0,0,0,,Дэнди Джек осындай адам.
Dialogue: 0,0:09:20.60,0:09:22.14,Default,,0,0,0,,-（） -（）…
Dialogue: 0,0:09:22.22,0:09:24.77,Default,,0,0,0,,Эй... сәл күте тұр, Рё!
Dialogue: 0,0:09:25.94,0:09:26.98,Default,,0,0,0,,...
Dialogue: 0,0:09:36.11,0:09:37.53,Default,,0,0,0,,Сәлем Джек
Dialogue: 0,0:09:37.95,0:09:41.12,Default,,0,0,0,,Сол зымыран мені өлтіруі мүмкін еді.
Dialogue: 0,0:09:41.20,0:09:42.70,Default,,0,0,0,,That's right.
Dialogue: 0,0:09:43.12,0:09:46.50,Default,,0,0,0,,Бірақ сіз қайтадан Сұңқарға қарсы тұру үшін өмір сүресіз.
Dialogue: 0,0:09:46.58,0:09:49.21,Default,,0,0,0,,Жәннатта әкеңе риза бол.
Dialogue: 0,0:09:52.17,0:09:54.30,Default,,0,0,0,,Енді мынаны пайдаланыңыз
Dialogue: 0,0:09:55.01,0:09:56.13,Default,,0,0,0,,Сонда сөзсіз—
Dialogue: 0,0:09:56.22,0:09:59.26,Default,,0,0,0,,Бір оқпен сұңқардың кеудесін тесіп өте алады.
Dialogue: 0,0:10:00.68,0:10:03.26,Default,,0,0,0,,Мүмкін бұл сіздің соңғы мүмкіндігіңіз шығар.
Dialogue: 0,0:10:03.35,0:10:05.47,Default,,0,0,0,,Осы ниетпен істе, жарай ма?
Dialogue: 0,0:10:20.24,0:10:22.66,Default,,0,0,0,,...
Dialogue: 0,0:10:22.74,0:10:26.62,Default,,0,0,0,,Кэтриннің түсінбестігі шешілмейінше, ештеңе бітпейді.
Dialogue: 0,0:10:26.70,0:10:29.21,Default,,0,0,0,,Бұл біраз өрескел, бірақ бұл жалғыз әдіс.
Dialogue: 0,0:10:29.29,0:10:30.12,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:30.21,0:10:32.59,Default,,0,0,0,,Үшеуі кездесейік.
Dialogue: 0,0:10:32.67,0:10:34.84,Default,,0,0,0,,Кэтринге бәс тігу ғана қалды.
Dialogue: 0,0:10:35.42,0:10:37.30,Default,,0,0,0,,Сіз оған бәс тігесіз бе?
Dialogue: 0,0:10:40.34,0:10:46.43,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:10:55.78,0:10:58.40,Default,,0,0,0,,Үйдің сыртында ештеңе орнатылмаған сияқты.
Dialogue: 0,0:10:58.49,0:10:59.82,Default,,0,0,0,,(Тікұшақтың дыбысы)
Dialogue: 0,0:11:19.13,0:11:20.38,Default,,0,0,0,,Кэтрин…
Dialogue: 0,0:11:20.47,0:11:22.09,Default,,0,0,0,,Ол неге мұнда...
Dialogue: 0,0:11:28.10,0:11:29.52,Default,,0,0,0,,Шық, Сұңқар!
Dialogue: 0,0:11:29.60,0:11:31.69,Default,,0,0,0,,Мен сенің жақын екеніңді білемін!
Dialogue: 0,0:11:32.48,0:11:35.27,Default,,0,0,0,,Екатеринамен жарысқа шығып, қалайсың?
Dialogue: 0,0:11:35.36,0:11:37.69,Default,,0,0,0,,Әлде тек артқы жағынан атуға болады ма?
Dialogue: 0,0:11:37.78,0:11:38.82,Default,,0,0,0,,Қорқақ!
Dialogue: 0,0:11:42.11,0:11:45.20,Default,,0,0,0,,Өте тартымды, Дэнди Джек.
Dialogue: 0,0:11:58.55,0:12:01.55,Default,,0,0,0,,Хехехехе... Сұңқарға 8 жыл болды.
Dialogue: 0,0:12:01.63,0:12:04.05,Default,,0,0,0,,Мен сені осылай кездестіруді асыға күттім.
Dialogue: 0,0:12:04.14,0:12:05.18,Default,,0,0,0,,Хмм…
Dialogue: 0,0:12:05.26,0:12:08.60,Default,,0,0,0,,Сол кезде менің көз алдымнан ғайып болдың.
Dialogue: 0,0:12:08.68,0:12:12.27,Default,,0,0,0,,Тап-таза жүзімді қайта көрдім деп ойлағанымда, бұл жолы ол әйелдің артында қалды.
Dialogue: 0,0:12:12.35,0:12:16.19,Default,,0,0,0,,Мені қате түсінбеңіз, мен Кэтриннің қамқоршысымын.
Dialogue: 0,0:12:16.27,0:12:20.32,Default,,0,0,0,,Мен оның әкесінің жауларынан кек алғанын көру үшін келдім.
Dialogue: 0,0:12:21.32,0:12:22.74,Default,,0,0,0,,Кэтрин
Dialogue: 0,0:12:22.82,0:12:26.62,Default,,0,0,0,,Мені әкеңнің жауы қылғың келсе, бұл да жақсы.
Dialogue: 0,0:12:26.70,0:12:29.70,Default,,0,0,0,,Бірақ алдымен жұмысымды аяқтауға рұқсат етіңіз.
Dialogue: 0,0:12:29.79,0:12:31.75,Default,,0,0,0,,Бұл сұңқар, сұңқар.
Dialogue: 0,0:12:31.83,0:12:33.66,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:12:33.75,0:12:35.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:35.12,0:12:38.63,Default,,0,0,0,,Дэнди Джек! Мен сені тозаққа құлатамын.
Dialogue: 0,0:12:38.71,0:12:40.05,Default,,0,0,0,,Уф…
Dialogue: 0,0:12:40.13,0:12:42.01,Default,,0,0,0,,Кэтрин, не істеп жатырсың!
Dialogue: 0,0:12:42.09,0:12:44.47,Default,,0,0,0,,Алдымдағы адам әкемнің жауы.
Dialogue: 0,0:12:44.55,0:12:45.59,Default,,0,0,0,,Ату, ату.
Dialogue: 0,0:12:46.01,0:12:48.55,Default,,0,0,0,,Хейворд батыл адам болған
Dialogue: 0,0:12:48.64,0:12:49.68,Default,,0,0,0,,Мен әлі-
Dialogue: 0,0:12:49.76,0:12:52.31,Default,,0,0,0,,Мен оның серіктесі болғанымды мақтан тұтамын.
Dialogue: 0,0:12:52.39,0:12:53.43,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:54.23,0:12:55.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:55.35,0:12:59.77,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:13:08.16,0:13:09.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:09.28,0:13:10.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:10.95,0:13:11.79,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:12.24,0:13:14.25,Default,,0,0,0,,Уау! Хехехе...
Dialogue: 0,0:13:14.33,0:13:16.21,Default,,0,0,0,,Иә! Хехе...
Dialogue: 0,0:13:25.01,0:13:26.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.47,0:13:31.51,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:31.60,0:13:32.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:33.56,0:13:34.60,Default,,0,0,0,,
Dialogue: 0,0:13:44.11,0:13:46.20,Default,,0,0,0,,Не істеп жатырсың, Кэтрин?
Dialogue: 0,0:13:46.28,0:13:48.32,Default,,0,0,0,,Енді ешқашан, бұл мүмкіндікті жіберіп алмаңыз
Dialogue: 0,0:13:48.41,0:13:49.49,Default,,0,0,0,,Falcon ойнаңыз!
Dialogue: 0,0:13:52.91,0:13:55.00,Default,,0,0,0,,Эй, анада тұрған Коичи ғой.
Dialogue: 0,0:13:55.58,0:13:56.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:56.79,0:13:58.83,Default,,0,0,0,,Уф! Ахх...
Dialogue: 0,0:14:00.17,0:14:03.42,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:05.09,0:14:06.34,Default,,0,0,0,,Ах…
Dialogue: 0,0:14:09.55,0:14:10.47,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:10.55,0:14:11.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:17.77,0:14:20.19,Default,,0,0,0,,Міне, Дэнди Джек.
Dialogue: 0,0:14:20.27,0:14:21.77,Default,,0,0,0,,Ал... күте тұрыңыз.
Dialogue: 0,0:14:21.86,0:14:24.53,Default,,0,0,0,,Сіз мені өлтіре аласыз ба? Мұқият ойлан
Dialogue: 0,0:14:24.61,0:14:25.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:26.07,0:14:29.99,Default,,0,0,0,,Айтар сөзің болса, о дүниеде Хейвордқа айт.
Dialogue: 0,0:14:32.12,0:14:32.95,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:34.62,0:14:35.70,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:36.33,0:14:38.08,Default,,0,0,0,,Өкінішке орай, Сұңқар...
Dialogue: 0,0:14:38.16,0:14:41.17,Default,,0,0,0,,Мен Джектің оққа ұшқанын қарап отыра алмаймын.
Dialogue: 0,0:14:41.25,0:14:43.21,Default,,0,0,0,,О! Кэтрин жарайсың
Dialogue: 0,0:14:43.29,0:14:45.88,Default,,0,0,0,,Жарайды, мен сені өсірген ата-анамын.
Dialogue: 0,0:14:45.96,0:14:46.80,Default,,0,0,0,,Енді жасаңыз!
Dialogue: 0,0:14:46.88,0:14:49.17,Default,,0,0,0,,Мен әкемнің кекін жою үшін сегіз жыл күттім.
Dialogue: 0,0:14:49.26,0:14:50.84,Default,,0,0,0,,Ату! Ат!
Dialogue: 0,0:14:54.85,0:14:57.18,Default,,0,0,0,,...
Dialogue: 0,0:14:57.27,0:14:59.35,Default,,0,0,0,,Бұлай жалғаса берсе, Умибозу-сан атылады.
Dialogue: 0,0:14:59.44,0:15:02.06,Default,,0,0,0,,Күтіңіз күтуден басқа амалым жоқ
Dialogue: 0,0:15:02.15,0:15:03.90,Default,,0,0,0,,Не болды? Кэтрин
Dialogue: 0,0:15:03.98,0:15:06.44,Default,,0,0,0,,Қорқақ сияқты әрекет етуден тартынудың қажеті жоқ.
Dialogue: 0,0:15:06.53,0:15:10.36,Default,,0,0,0,,Жасай бер! Триггерді тартыңыз! Солай етсем 8 жыл азаптан құтыламын...
Dialogue: 0,0:15:12.57,0:15:14.91,Default,,0,0,0,,Сіз маңызды нәрсені ұмытып жатырсыз.
Dialogue: 0,0:15:14.99,0:15:16.74,Default,,0,0,0,,Мен қазір істей алатын нәрсе...
Dialogue: 0,0:15:16.83,0:15:19.58,Default,,0,0,0,,Өйткені Умибозу сені қорғау үшін денесін желіге қойды.
Dialogue: 0,0:15:19.66,0:15:20.54,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:15:21.58,0:15:23.21,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:23.29,0:15:25.25,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:25.34,0:15:26.84,Default,,0,0,0,,Қандай серіктес!
Dialogue: 0,0:15:26.92,0:15:29.72,Default,,0,0,0,,Нағыз серіктес мұны істей алмайды!
Dialogue: 0,0:15:29.80,0:15:32.18,Default,,0,0,0,,Не істеп жатырсың, Кэтрин?
Dialogue: 0,0:15:32.26,0:15:34.39,Default,,0,0,0,,Енді әкеңнің кекін тазартатын кез!
Dialogue: 0,0:15:34.47,0:15:36.85,Default,,0,0,0,,Ату! Ат! Сіз оны түсірдіңіз бе?
Dialogue: 0,0:15:36.93,0:15:39.81,Default,,0,0,0,,Білмеймін... Білмеймін!
Dialogue: 0,0:15:39.89,0:15:41.52,Default,,0,0,0,,Қандай шындық? ұяшық
Dialogue: 0,0:15:41.60,0:15:42.85,Default,,0,0,0,,Мен енді түсінбеймін
Dialogue: 0,0:15:42.94,0:15:45.86,Default,,0,0,0,,Чий! Осы аралықта не істедіңіз?
Dialogue: 0,0:15:45.94,0:15:47.32,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:15:47.40,0:15:48.40,Default,,0,0,0,,Оны маған қарызға бер!
Dialogue: 0,0:15:48.78,0:15:50.86,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:15:50.95,0:15:51.99,Default,,0,0,0,,Ах…
Dialogue: 0,0:15:52.07,0:15:53.70,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:15:53.78,0:15:55.16,Default,,0,0,0,,- (Умибозу) Кэтрин! -Қозғалма!
Dialogue: 0,0:16:04.17,0:16:06.42,Default,,0,0,0,,Көмектесіңіз! Осы қарқынмен ол төмендейді!
Dialogue: 0,0:16:06.50,0:16:08.13,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:16:08.21,0:16:09.05,Default,,0,0,0,,Не! ?
Dialogue: 0,0:16:09.13,0:16:13.01,Default,,0,0,0,,Бұл әйелді өлтірушіге айналдыру үшін маған сегіз жыл қажет болды.
Dialogue: 0,0:16:13.09,0:16:16.10,Default,,0,0,0,,Бірақ көріп тұрғаныңыздай, бұл мүлдем пайдасыз.
Dialogue: 0,0:16:16.18,0:16:18.51,Default,,0,0,0,,Мен сені өлтіре алсам, бәрі бітті.
Dialogue: 0,0:16:18.60,0:16:19.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:19.60,0:16:23.23,Default,,0,0,0,,Қымбаттым, мен Кэтринді ұстағанымның жалғыз себебі...
Dialogue: 0,0:16:23.31,0:16:25.31,Default,,0,0,0,,Хмф... Менің ойымша.
Dialogue: 0,0:16:25.40,0:16:29.19,Default,,0,0,0,,Менің ұйымымның жойылғанына ренішім, мен оны өлтіре алмаймын.
Dialogue: 0,0:16:29.69,0:16:31.94,Default,,0,0,0,,Кэтринді өлтіруші ретінде тәрбиелеу
Dialogue: 0,0:16:32.03,0:16:34.57,Default,,0,0,0,,Мен сені өлтіру туралы ойға келдім.
Dialogue: 0,0:16:34.66,0:16:37.16,Default,,0,0,0,,Кэтрин шынымен жақсы жұмыс жасады.
Dialogue: 0,0:16:37.24,0:16:41.66,Default,,0,0,0,,Әй... Әкемнің нағыз жауы мен екенімді де білмедім.
Dialogue: 0,0:16:41.75,0:16:43.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:44.25,0:16:45.50,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:16:45.58,0:16:50.88,Default,,0,0,0,,Ата-анаңның жауы ретінде жар болған адамның қызы өміріне қауіп төндіргені қандай сезімде?
Dialogue: 0,0:16:51.46,0:16:54.93,Default,,0,0,0,,Бұл ең үлкен кек деп ойламайсыз ба?
Dialogue: 0,0:16:55.01,0:16:56.80,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:16:56.89,0:16:58.89,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:16:58.97,0:17:00.97,Default,,0,0,0,,(Джектің күлкісі)
Dialogue: 0,0:17:01.06,0:17:03.89,Default,,0,0,0,,Солай... солай...
Dialogue: 0,0:17:03.98,0:17:05.89,Default,,0,0,0,,Ннн... масқара!
Dialogue: 0,0:17:06.52,0:17:09.27,Default,,0,0,0,,Бұл сыпайы комплимент.
Dialogue: 0,0:17:09.36,0:17:12.86,Default,,0,0,0,,Тозаққа барыңыз және Хейвордпен әсерлі кездесу өткізіңіз.
Dialogue: 0,0:17:12.94,0:17:15.86,Default,,0,0,0,,Сен жалғыздықты сезінбеу үшін мен Кэтринді бірден жіберемін.
Dialogue: 0,0:17:15.95,0:17:17.74,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:17:17.82,0:17:20.87,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:17:22.91,0:17:24.04,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:26.00,0:17:26.92,Default,,0,0,0,,Бұл кім? ?
Dialogue: 0,0:17:27.33,0:17:29.21,Default,,0,0,0,,Умибозу Кэтрин тез!
Dialogue: 0,0:17:31.63,0:17:34.59,Default,,0,0,0,,… ･
Dialogue: 0,0:17:34.67,0:17:35.51,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:17:36.84,0:17:38.01,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:17:40.14,0:17:41.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:41.26,0:17:42.47,Default,,0,0,0,,Ннн…
Dialogue: 0,0:17:42.56,0:17:43.85,Default,,0,0,0,,Мм... Умибозу-сан!
Dialogue: 0,0:17:43.93,0:17:45.35,Default,,0,0,0,,Тоқта, Сұңқар!
Dialogue: 0,0:17:45.43,0:17:47.35,Default,,0,0,0,,Мен сені өлтірмек болдым.
Dialogue: 0,0:17:47.44,0:17:49.31,Default,,0,0,0,,Қолдарыңызды алыңыз! Тіпті сен де құлайсың!
Dialogue: 0,0:17:49.40,0:17:50.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:50.65,0:17:53.03,Default,,0,0,0,,Хейворд үшін мен саған көмектесемін.
Dialogue: 0,0:17:53.11,0:17:55.99,Default,,0,0,0,,Ах... Сұңқар...
Dialogue: 0,0:18:07.04,0:18:08.04,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:18.97,0:18:20.93,Default,,0,0,0,,Ннн!
Dialogue: 0,0:18:21.01,0:18:22.47,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:18:22.55,0:18:26.93,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:18:28.23,0:18:29.39,Default,,0,0,0,,Уф…
Dialogue: 0,0:18:31.36,0:18:32.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:32.31,0:18:33.19,Default,,0,0,0,,Кэтрин!
Dialogue: 0,0:18:33.27,0:18:36.82,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:18:36.90,0:18:37.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:42.70,0:18:44.24,Default,,0,0,0,,Кэтрин
Dialogue: 0,0:18:44.33,0:18:45.70,Default,,0,0,0,,Ол жүгіруін тоқтатпайды, сүйретіліп бара жатса да
Dialogue: 0,0:18:45.79,0:18:48.04,Default,,0,0,0,,Мен сенің патронаттық ата-анаңмын.
Dialogue: 0,0:18:48.12,0:18:49.46,Default,,0,0,0,,Мен сені сегіз жыл бойы ұстадым...
Dialogue: 0,0:18:50.75,0:18:53.13,Default,,0,0,0,,Ал... күт, атпа, күт.
Dialogue: 0,0:18:58.17,0:18:59.47,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:18:59.55,0:19:02.55,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:19:02.64,0:19:04.39,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:05.97,0:19:07.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:08.60,0:19:09.98,Default,,0,0,0,,Жетеді
Dialogue: 0,0:19:10.06,0:19:12.48,Default,,0,0,0,,Хейвард бұдан артық ештеңе қаламайды.
Dialogue: 0,0:19:14.23,0:19:15.44,Default,,0,0,0,,Сұңқар…
Dialogue: 0,0:19:20.95,0:19:22.16,Default,,0,0,0,,Я...
Dialogue: 0,0:19:23.41,0:19:24.62,Default,,0,0,0,,Я...
Dialogue: 0,0:19:24.70,0:19:28.54,Default,,0,0,0,,Бір кезде мен не болады деп ойладым, бірақ ол түсінді деп ойлаймын.
Dialogue: 0,0:19:30.08,0:19:31.46,Default,,0,0,0,,Сұңқар өл!
Dialogue: 0,0:19:31.54,0:19:32.37,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:33.50,0:19:34.54,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:19:34.63,0:19:35.50,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:35.59,0:19:36.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:41.47,0:19:43.97,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:05.37,0:20:06.99,Default,,0,0,0,,Бәрі бітті...
Dialogue: 0,0:20:25.64,0:20:29.77,Default,,0,0,0,,Сегіз жыл бұрын Үмибозы әкеңді қорғай алмады.
Dialogue: 0,0:20:30.60,0:20:33.73,Default,,0,0,0,,Сонда сен оны әкемнің жауы деп атадың
Dialogue: 0,0:20:33.81,0:20:35.94,Default,,0,0,0,,Мен ешқандай ақтау айтқан жоқпын.
Dialogue: 0,0:20:37.40,0:20:41.65,Default,,0,0,0,,Сіздің әкеңіз оның бірінші және соңғы серіктесі болды.
Dialogue: 0,0:20:48.41,0:20:49.87,Default,,0,0,0,,Сұңқар!
Dialogue: 0,0:20:51.66,0:20:55.75,Default,,0,0,0,,Сұңқар I... Мен...
Dialogue: 0,0:20:57.08,0:20:59.71,Default,,0,0,0,,Жетер, ештеңе айтпа.
Dialogue: 0,0:20:59.80,0:21:01.42,Default,,0,0,0,,Сұңқар!
Dialogue: 0,0:21:01.51,0:21:03.22,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:03.92,0:21:06.68,Default,,0,0,0,,Бір жақсысы, түсініспеушілік жойылды.
Dialogue: 0,0:21:06.76,0:21:10.85,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:10.93,0:21:14.56,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:14.64,0:21:18.31,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:21.11,0:21:24.24,Default,,0,0,0,,Сан-Франциско арқылы 360-рейс—
Dialogue: 0,0:21:24.32,0:21:26.57,Default,,0,0,0,,Нью-Йоркке бара жатқан жолаушылар үшін...
Dialogue: 0,0:21:27.53,0:21:29.07,Default,,0,0,0,,Ха...Сұңқар
Dialogue: 0,0:21:30.49,0:21:31.54,Default,,0,0,0,,Қызыл теңіз
Dialogue: 0,0:21:32.16,0:21:34.04,Default,,0,0,0,,8 жыл бұрын
Dialogue: 0,0:21:34.79,0:21:36.67,Default,,0,0,0,,Қарапайым қыз сияқты
Dialogue: 0,0:21:37.21,0:21:39.50,Default,,0,0,0,,Әкемнің де осылай бақытты болатынына сенімдімін.
Dialogue: 0,0:21:40.00,0:21:41.80,Default,,0,0,0,,Бұл жақсы күлімсіреу
Dialogue: 0,0:21:41.88,0:21:44.21,Default,,0,0,0,,Ақыры, мен ескі Кэтринге оралдым.
Dialogue: 0,0:21:48.26,0:21:51.85,Default,,0,0,0,,Бірінші және соңғы серіктес...?
Dialogue: 0,0:21:51.93,0:21:54.47,Default,,0,0,0,,Ей, біз де солай екеніне сенімдімін.
Dialogue: 0,0:21:54.56,0:21:56.64,Default,,0,0,0,,О? Не?
Dialogue: 0,0:21:56.73,0:21:58.60,Default,,0,0,0,,Сондықтан мен жай ғана айттым!
Dialogue: 0,0:21:58.69,0:21:59.60,Default,,0,0,0,,Қый!
Dialogue: 0,0:21:59.69,0:22:01.15,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:22:01.23,0:22:07.24,Default,,0,0,0,,♪~
Dialogue: 0,0:23:28.74,0:23:34.74,Default,,0,0,0,,~♪
Dialogue: 0,0:23:36.12,0:23:40.29,Default,,0,0,0,,...
Dialogue: 0,0:23:40.37,0:23:43.04,Default,,0,0,0,,Саеко менен ұшақты ұрлау үшін төлеуімді сұрады!
Dialogue: 0,0:23:43.13,0:23:44.67,Default,,0,0,0,,Саэко-сан, Кан-кан!
Dialogue: 0,0:23:44.75,0:23:47.17,Default,,0,0,0,,Миса-чан, сен Ямато Надешикоға таңданасың.
Dialogue: 0,0:23:47.25,0:23:48.63,Default,,0,0,0,,Сондықтан мен сізді жаттықтырамын.
Dialogue: 0,0:23:48.71,0:23:50.42,Default,,0,0,0,,Оның сыртқы істер министрінің қызы!
Dialogue: 0,0:23:50.51,0:23:52.38,Default,,0,0,0,,...Мұның Моккошиге еш қатысы жоқ.
Dialogue: 0,0:23:52.47,0:23:55.64,Default,,0,0,0,,Керемет! Егер бұл дипломатиялық мәселеге айналса, мен не істеуім керек?
Dialogue: 0,0:23:55.72,0:23:56.76,Default,,0,0,0,,«Қала аңшысы 2»
Dialogue: 0,0:23:59.98,0:24:01.77,Default,,0,0,0,,Көрмесем ұят болар еді.
Dialogue: 0,0:24:03.27,0:24:09.27,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory