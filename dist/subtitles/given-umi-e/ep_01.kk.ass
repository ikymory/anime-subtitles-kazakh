Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.15,0:00:40.85,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:00:41.26,0:00:42.90,Default,,0,0,0,,Қазір үйге қайтайық.
Dialogue: 0,0:00:44.08,0:00:45.14,Default,,0,0,0,,5 минут қалды
Dialogue: 0,0:00:53.59,0:00:56.40,Default,,0,0,0,,Сенімен теңізге алғаш келген мен болдым.
Dialogue: 0,0:00:57.31,0:00:59.09,Default,,0,0,0,,Қазір қыстың ортасында басып шығару
Dialogue: 0,0:01:08.44,0:01:11.49,Default,,0,0,0,,5 минутқа жетпей кетсем де ұмытпаймын
Dialogue: 0,0:01:13.07,0:01:13.87,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:14.50,0:01:16.08,Default,,0,0,0,,Ұмытатыныңызға сенімдімін
Dialogue: 0,0:01:29.49,0:01:31.76,Default,,0,0,0,,Үйге келгенде ваннада жыныстық қатынасқа түсейік.
Dialogue: 0,0:01:33.10,0:01:33.76,Default,,0,0,0,,Иә
Dialogue: 0,0:01:34.93,0:01:35.67,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:01:35.97,0:01:37.74,Default,,0,0,0,,Пачхаха Қайсысы?
Dialogue: 0,0:01:38.32,0:01:39.17,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:01:48.09,0:01:50.14,Default,,0,0,0,,Сол бала қайтыс болғанның ертеңіне
Dialogue: 0,0:01:51.14,0:01:53.25,Default,,0,0,0,,Бұл Юкиге жіберілген пакет.
Dialogue: 0,0:01:54.04,0:01:55.28,Default,,0,0,0,,Сіз күлдіңіз.
Dialogue: 0,0:01:56.54,0:01:58.55,Default,,0,0,0,,Ондай шу шығарма
Dialogue: 0,0:01:58.93,0:02:00.97,Default,,0,0,0,,Келесі күні рейсте кесе кеспе.
Dialogue: 0,0:02:02.99,0:02:03.89,Default,,0,0,0,,Не?
Dialogue: 0,0:02:04.52,0:02:07.66,Default,,0,0,0,,Ол ертеңді ғана ойлаған жоқ.
Dialogue: 0,0:02:09.62,0:02:13.07,Default,,0,0,0,,Мен сол кесе кеспе жеген кезде бірінші рет жыладым.
Dialogue: 0,0:02:16.15,0:02:20.48,Default,,0,0,0,,Юки бастапқыда әдеттегі тауық жарысында өлетін тип болды.
Dialogue: 0,0:02:22.35,0:02:26.18,Default,,0,0,0,,Бұл кеше немесе бүгін болған оқиғаға байланысты емес.
Dialogue: 0,0:02:29.06,0:02:31.17,Default,,0,0,0,,Әлі қыстың ортасында
Dialogue: 0,0:02:33.01,0:02:34.43,Default,,0,0,0,,Мен мұны өз бетімше істеймін
Dialogue: 0,0:02:35.34,0:02:39.40,Default,,0,0,0,,Баланың ашуына сен кінәлі деп ойладым.
Dialogue: 0,0:02:44.30,0:02:46.11,Default,,0,0,0,,Жоқ, қазіргі
Dialogue: 0,0:02:47.43,0:02:48.53,Default,,0,0,0,,Жауапсыздық.
Dialogue: 0,0:02:50.67,0:02:51.82,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,0:02:53.03,0:02:53.96,Default,,0,0,0,,Осымен
Dialogue: 0,0:02:54.28,0:02:56.06,Default,,0,0,0,,Бұл Юкидің гитарасы.
Dialogue: 0,0:02:56.62,0:02:58.63,Default,,0,0,0,,Түбіртек және сәйкестендіру
Dialogue: 0,0:02:59.30,0:03:00.08,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:03:02.95,0:03:03.72,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:03:08.75,0:03:09.73,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:03:10.27,0:03:11.10,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:13.14,0:03:14.64,Default,,0,0,0,,Оның болуы ауырады.
Dialogue: 0,0:03:15.45,0:03:16.20,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:03:16.84,0:03:18.11,Default,,0,0,0,,Сіз оны арқаңызға көтеріп жүресіз
Dialogue: 0,0:03:19.20,0:03:20.78,Default,,0,0,0,,Бұл жай ғана таңу
Dialogue: 0,0:03:23.11,0:03:23.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:24.80,0:03:26.78,Default,,0,0,0,,Мен де, Юки де кешірім сұраймыз.
Dialogue: 0,0:03:28.46,0:03:29.87,Default,,0,0,0,,Қыс ортасын жай қалдырыңыз
Dialogue: 0,0:03:30.90,0:03:31.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:47.40,0:03:50.09,Default,,0,0,0,,Ғұн хун ғұн хун хун
Dialogue: 0,0:03:50.09,0:03:52.29,Default,,0,0,0,,Хун хұн хұх хун
Dialogue: 0,0:03:51.60,0:03:52.29,Default,,0,0,0,,Юки
Dialogue: 0,0:03:55.38,0:03:57.46,Default,,0,0,0,,Сіздің асқазаныңызда тесік бар
Dialogue: 0,0:04:00.62,0:04:02.18,Default,,0,0,0,,Жүрегіңдегі тесік
Dialogue: 0,0:04:03.19,0:04:06.47,Default,,0,0,0,,Тесік кішірейсе де жабылмайды.
Dialogue: 0,0:04:19.16,0:04:21.90,Default,,0,0,0,,Сонымен мен шұңқырдамын
Dialogue: 0,0:04:23.43,0:04:24.14,Default,,0,0,0,,Сіздің
Dialogue: 0,0:04:43.26,0:04:44.83,Default,,0,0,0,,Сіз қанша уақыттан бері ән айтасыз?
Dialogue: 0,0:04:56.86,0:04:58.48,Default,,0,0,0,,Оны қалай айттыңыз?
Dialogue: 0,0:05:14.37,0:05:16.28,Default,,0,0,0,,Уау, қарным ашты.
Dialogue: 0,0:05:16.28,0:05:18.13,Default,,0,0,0,,Бұл соңғы пойыз, сондықтан
Dialogue: 0,0:05:19.86,0:05:20.68,Default,,0,0,0,,Уенояма
Dialogue: 0,0:05:22.48,0:05:25.02,Default,,0,0,0,,Есептік жазба туралы менеджер білетін сияқты.
Dialogue: 0,0:05:25.54,0:05:27.72,Default,,0,0,0,,Мен сізге байланыс ақпаратымды берсем, дұрыс емес.
Dialogue: 0,0:05:28.11,0:05:28.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:30.57,0:05:31.17,Default,,0,0,0,,Есептік жазба
Dialogue: 0,0:05:31.17,0:05:32.34,Default,,0,0,0,,Буккиарати мен оның жігіттерінің – дәл сенің адамдарыңды жойған сол жандардың – алдында бірте-бірте өліп кету –
Dialogue: 0,0:05:33.31,0:05:35.35,Default,,0,0,0,,Жақында репетиция және генетика басталады.
Dialogue: 0,0:05:36.60,0:05:37.53,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:05:37.98,0:05:38.74,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:05:42.06,0:05:43.36,Default,,0,0,0,,Дүкенге тоқталайық.
Dialogue: 0,0:05:43.61,0:05:44.26,Default,,0,0,0,,О
Dialogue: 0,0:06:14.82,0:06:16.54,Default,,0,0,0,,Айтшы, қарғыс атсын.
Dialogue: 0,0:06:18.22,0:06:20.00,Default,,0,0,0,,Аа, қазірдің өзінде
Dialogue: 0,0:06:32.59,0:06:33.15,Default,,0,0,0,,На
Dialogue: 0,0:06:33.52,0:06:36.06,Default,,0,0,0,,Бұл алаңдатарлық хабар не?
Dialogue: 0,0:06:37.42,0:06:38.89,Default,,0,0,0,,Маған бірдеңе қызық болды
Dialogue: 0,0:06:39.36,0:06:41.16,Default,,0,0,0,,Сіз асығыс келдіңіз, солай емес пе?
Dialogue: 0,0:06:41.50,0:06:43.03,Default,,0,0,0,,Жақында соңғы пойыз кетеді.
Dialogue: 0,0:06:43.03,0:06:44.52,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:44.94,0:06:47.94,Default,,0,0,0,,Сізге жылдамырақ жауап беру керек шығар.
Dialogue: 0,0:06:48.24,0:06:51.01,Default,,0,0,0,,Мен күте тұра мазасыздануымды баса алмаймын.
Dialogue: 0,0:06:51.95,0:06:52.66,Default,,0,0,0,,Иә
Dialogue: 0,0:06:54.43,0:06:55.28,Default,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,0:06:56.26,0:06:57.10,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:07:05.45,0:07:06.84,Default,,0,0,0,,Отырыңыз
Dialogue: 0,0:07:29.25,0:07:31.98,Default,,0,0,0,,Жоқ, сіз шынымен не істеп жатырсыз?
Dialogue: 0,0:07:33.92,0:07:34.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:35.36,0:07:36.71,Default,,0,0,0,,Мен әлі күнге дейін жақсы айта алмаймын.
Dialogue: 0,0:07:39.22,0:07:40.42,Default,,0,0,0,,Маған жүгіріп келгені үшін
Dialogue: 0,0:07:41.80,0:07:42.52,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:45.75,0:07:48.58,Default,,0,0,0,,Жоқ, мен соңғы кездері жалғыз қалдым.
Dialogue: 0,0:07:50.68,0:07:52.88,Default,,0,0,0,,Сабақтан кейін студияға көбірек барасыз ба?
Dialogue: 0,0:07:53.85,0:07:56.58,Default,,0,0,0,,Каджи-сан және басқалары бізді ұстап алмаса да, біз бірге жүре аламыз.
Dialogue: 0,0:07:58.89,0:08:00.48,Default,,0,0,0,,Қазір жақсы
Dialogue: 0,0:08:01.86,0:08:02.62,Default,,0,0,0,,Бұл
Dialogue: 0,0:08:03.18,0:08:04.92,Default,,0,0,0,,Мен келесі аптада толық емес жұмыс күнім бар.
Dialogue: 0,0:08:09.95,0:08:12.76,Default,,0,0,0,,Кешіріңіз, мен 10 минуттан кейін оралуым керек.
Dialogue: 0,0:08:13.83,0:08:14.59,Default,,0,0,0,,10 минут
Dialogue: 0,0:08:18.52,0:08:19.30,Default,,0,0,0,,Осымен
Dialogue: 0,0:08:20.06,0:08:22.30,Default,,0,0,0,,Сіз оны Хирагиден естіген боларсыз.
Dialogue: 0,0:08:24.24,0:08:26.80,Default,,0,0,0,,Мен айдың соңында тікелей эфирде шоу жасаймын.
Dialogue: 0,0:08:28.84,0:08:30.86,Default,,0,0,0,,Мен сенен бір нәрсе сұрағаныңды қалаймын.
Dialogue: 0,0:08:32.36,0:08:33.30,Default,,0,0,0,,Келме
Dialogue: 0,0:08:43.54,0:08:44.24,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:08:45.36,0:08:46.89,Default,,0,0,0,,Шынында не болды?
Dialogue: 0,0:08:48.51,0:08:49.25,Default,,0,0,0,,Бұл біртүрлі
Dialogue: 0,0:08:49.91,0:08:53.17,Default,,0,0,0,,Мафую музыкаға мұндай пассивті болды ма?
Dialogue: 0,0:08:54.18,0:08:54.79,Default,,0,0,0,,Эй
Dialogue: 0,0:08:56.69,0:08:57.65,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:08:58.04,0:08:59.67,Default,,0,0,0,,Қазір жақсы
Dialogue: 0,0:09:01.31,0:09:02.98,Default,,0,0,0,,Дәл осылай
Dialogue: 0,0:09:07.56,0:09:09.30,Default,,0,0,0,,Содан соң соңғы пойыз кетеді.
Dialogue: 0,0:09:10.18,0:09:12.42,Default,,0,0,0,,Вари, маған қазір үйге баруға рұқсат етіңіз.
Dialogue: 0,0:09:17.07,0:09:17.78,Default,,0,0,0,,Ха
Dialogue: 0,0:09:19.57,0:09:20.22,Default,,0,0,0,,Ах
Dialogue: 0,0:09:20.91,0:09:21.71,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:09:25.35,0:09:26.10,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:09:28.25,0:09:29.07,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:09:31.76,0:09:32.71,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:09:38.54,0:09:39.41,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:09:40.89,0:09:42.94,Default,,0,0,0,,Осы сағатта қайда бардыңыз?
Dialogue: 0,0:09:43.61,0:09:44.62,Default,,0,0,0,,Жоқ, вокзалдың алдында түсіріп кетсеңіз жеткілікті.
Dialogue: 0,0:09:45.84,0:09:47.31,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:09:58.77,0:10:00.31,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:10:03.15,0:10:04.93,Default,,0,0,0,,Шынымды айтсам, көңілім қалды.
Dialogue: 0,0:10:07.66,0:10:09.90,Default,,0,0,0,,Кейде ол бірдеңе жасайды
Dialogue: 0,0:10:10.20,0:10:12.03,Default,,0,0,0,,Кенет тоқтап қалды.
Dialogue: 0,0:10:14.06,0:10:15.75,Default,,0,0,0,,Олай деуге болады.
Dialogue: 0,0:10:16.45,0:10:18.37,Default,,0,0,0,,Мен тек дұрыс күтуім керек.
Dialogue: 0,0:10:19.10,0:10:19.93,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:10:21.07,0:10:21.97,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:10:23.09,0:10:24.97,Default,,0,0,0,,Бүгінгі таңда басқаша
Dialogue: 0,0:10:29.01,0:10:32.90,Default,,0,0,0,,Ол музыкадан бас тартқандай болды.
Dialogue: 0,0:10:36.32,0:10:39.39,Default,,0,0,0,,Мен Given's студиясында екі ай бойы жаттыққан жоқпын.
Dialogue: 0,0:10:40.64,0:10:42.17,Default,,0,0,0,,Енді ән айтқың келмейді ме?
Dialogue: 0,0:10:43.44,0:10:44.16,Default,,0,0,0,,Біз
Dialogue: 0,0:10:44.89,0:10:45.70,Default,,0,0,0,,Берілген
Dialogue: 0,0:10:46.63,0:10:48.40,Default,,0,0,0,,Заттар осылайша ыдырай бере ме?
Dialogue: 0,0:10:52.19,0:10:53.10,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:10:54.92,0:10:57.64,Default,,0,0,0,,Мен қолдау алуым керек емес пе еді?
Dialogue: 0,0:10:58.78,0:11:01.29,Default,,0,0,0,,Сіздің топ бірінші кезекте тұрақсыз болғанда
Dialogue: 0,0:11:03.08,0:11:04.59,Default,,0,0,0,,Тіпті ақымақ болса да
Dialogue: 0,0:11:05.75,0:11:07.18,Default,,0,0,0,,Мен оның естігенін қаладым.
Dialogue: 0,0:11:07.73,0:11:09.51,Default,,0,0,0,,Сол әнді аяқтасам да
Dialogue: 0,0:11:13.12,0:11:15.66,Default,,0,0,0,,Сенің қиналғаның маған бәрібір
Dialogue: 0,0:11:16.50,0:11:18.16,Default,,0,0,0,,Бұл менің күшім
Dialogue: 0,0:11:19.64,0:11:21.63,Default,,0,0,0,,Хиираги музыкасында жоғалған
Dialogue: 0,0:11:24.90,0:11:25.73,Default,,0,0,0,,Жоспар
Dialogue: 0,0:11:26.24,0:11:27.65,Default,,0,0,0,,Гэнджун сияқты
Dialogue: 0,0:11:29.02,0:11:32.91,Default,,0,0,0,,Қыстың ортасында өзімді топқа арнағым келеді.
Dialogue: 0,0:11:34.98,0:11:37.34,Default,,0,0,0,,Оның музыкаға және махаббатқа берілгендігі
Dialogue: 0,0:11:38.43,0:11:40.06,Default,,0,0,0,,Идеал тип
Dialogue: 0,0:11:41.74,0:11:43.06,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:11:43.57,0:11:45.64,Default,,0,0,0,,Топтарды қыстың ортасында да қадірлеуге болады.
Dialogue: 0,0:11:46.86,0:11:48.10,Default,,0,0,0,,Мен үйренуім керек
Dialogue: 0,0:11:49.82,0:11:50.93,Default,,0,0,0,,Оның
Dialogue: 0,0:11:51.78,0:11:53.50,Default,,0,0,0,,Гэнджун дұрыс айтады.
Dialogue: 0,0:11:55.27,0:11:57.14,Default,,0,0,0,,Мен ол сияқты бола алмаймын.
Dialogue: 0,0:12:18.53,0:12:21.36,Default,,0,0,0,,Маған соншалықты жаман қарым-қатынас қалай болды?
Dialogue: 0,0:12:23.40,0:12:24.32,Default,,0,0,0,,Жоқ, түсіндім.
Dialogue: 0,0:12:24.76,0:12:25.86,Default,,0,0,0,,Мүмкін мен түсінемін.
Dialogue: 0,0:12:26.42,0:12:28.86,Default,,0,0,0,,Егер сіз де сол қалпыңызда болсаңыз, шынымды айтсам, ренжіп қалар едім.
Dialogue: 0,0:12:30.01,0:12:33.42,Default,,0,0,0,,Шынымды айтсам, Мафуюдың басқамен ән айтқанын көргім келмейді.
Dialogue: 0,0:12:34.56,0:12:36.05,Default,,0,0,0,,Жоқ, жоқ, бірақ
Dialogue: 0,0:12:36.43,0:12:38.47,Default,,0,0,0,,Неліктен мені әр уақытта тастайды?
Dialogue: 0,0:12:38.47,0:12:39.54,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:12:40.03,0:12:42.33,Default,,0,0,0,,Неліктен мен оны басқан кезде әрқашан ойнайды?
Dialogue: 0,0:12:43.14,0:12:44.69,Default,,0,0,0,,Неліктен бұл әлі де солай?
Dialogue: 0,0:12:45.16,0:12:47.54,Default,,0,0,0,,Музыка сіз үшін маңызды ма?
Dialogue: 0,0:12:49.71,0:12:52.91,Default,,0,0,0,,Жоқ, жоқ, маңызды емес.
Dialogue: 0,0:12:53.60,0:12:54.58,Default,,0,0,0,,Тоқта
Dialogue: 0,0:12:54.58,0:12:56.42,Default,,0,0,0,,Оны жеңілдетуге тырыспаңыз
Dialogue: 0,0:12:57.46,0:12:58.38,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:58.88,0:13:02.56,Default,,0,0,0,,Мафуюда күмән болмаған кезде ол әрқашан басқалардан гөрі алға қарай еңкейеді.
Dialogue: 0,0:13:05.26,0:13:06.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:07.27,0:13:08.96,Default,,0,0,0,,Мен бір нәрседен абдырап қалдым.
Dialogue: 0,0:13:10.38,0:13:12.16,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:13:13.00,0:13:15.58,Default,,0,0,0,,Мен сахнаға ең жақынмын.
Dialogue: 0,0:13:16.09,0:13:18.03,Default,,0,0,0,,Қыс ортасын сол жерден тартсаң
Dialogue: 0,0:13:18.67,0:13:20.42,Default,,0,0,0,,Соңында, әдеттегідей
Dialogue: 0,0:13:21.23,0:13:23.19,Default,,0,0,0,,Оны тартудың жалғыз жолы - музыка.
Dialogue: 0,0:13:23.80,0:13:25.70,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:13:27.39,0:13:28.98,Default,,0,0,0,,«Сен мені ести аласың ба?»
Dialogue: 0,0:13:30.14,0:13:31.91,Default,,0,0,0,,«Шулы болу»
Dialogue: 0,0:13:29.34,0:13:31.16,Default,,0,0,0,,syh мажор дебюті
Dialogue: 0,0:13:32.12,0:13:34.09,Default,,0,0,0,,«Дайын бол».
Dialogue: 0,0:13:34.09,0:13:36.10,Default,,0,0,0,,«Мен күтемін».
Dialogue: 0,0:13:31.58,0:13:33.79,Default,,0,0,0,,Бірінші жалғыз парад
Dialogue: 0,0:13:34.90,0:13:36.10,Default,,0,0,0,,Қазіргі уақытта сатылымда
Dialogue: 0,0:13:36.32,0:13:42.49,Default,,0,0,0,,«Кәне, біздің армандарымыздың шеруіне ілесіңіз».
Dialogue: 0,0:13:42.49,0:13:46.72,Default,,0,0,0,,«Қорықпа, мен қорықпаймын».
Dialogue: 0,0:13:42.49,0:13:43.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:46.10,0:13:47.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:46.72,0:13:48.58,Default,,0,0,0,,«Ей, сен шіріксің».
Dialogue: 0,0:13:47.64,0:13:48.58,Default,,0,0,0,,Соңында
Dialogue: 0,0:13:49.96,0:13:51.74,Default,,0,0,0,,Мен мұны өз жолыммен орындауым керек
Dialogue: 0,0:14:01.84,0:14:02.90,Default,,0,0,0,,Қыс ортасы
Dialogue: 0,0:14:04.91,0:14:05.64,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:06.01,0:14:06.83,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:09.50,0:14:10.35,Default,,0,0,0,,Итая мырза
Dialogue: 0,0:14:10.68,0:14:12.79,Default,,0,0,0,,Сіздің бұл уақытта келуіңіз ерекше.
Dialogue: 0,0:14:13.67,0:14:14.49,Default,,0,0,0,,О
Dialogue: 0,0:14:14.80,0:14:16.45,Default,,0,0,0,,Өйткені бізде кеше жаттығу матчы болды.
Dialogue: 0,0:14:17.20,0:14:19.22,Default,,0,0,0,,Бүгінгі күні футбол клубының жаттығуы жоқ.
Dialogue: 0,0:14:19.68,0:14:20.43,Default,,0,0,0,,Иә
Dialogue: 0,0:14:20.43,0:14:21.36,Default,,0,0,0,,Иә
Dialogue: 0,0:14:27.71,0:14:28.59,Default,,0,0,0,,Қыс ортасы
Dialogue: 0,0:14:28.95,0:14:30.84,Default,,0,0,0,,Мен мансап бойынша кеңес алуға өтініш бердім.
Dialogue: 0,0:14:31.27,0:14:32.04,Default,,0,0,0,,Ахх
Dialogue: 0,0:14:33.22,0:14:34.87,Default,,0,0,0,,Құжаттарды тапсыру мерзімі аяқталуға жақын.
Dialogue: 0,0:14:41.18,0:14:43.21,Default,,0,0,0,,Итая-кун оны жіберіп қойған.
Dialogue: 0,0:14:43.32,0:14:43.89,Default,,0,0,0,,Мен
Dialogue: 0,0:14:44.69,0:14:45.50,Default,,0,0,0,,Мен
Dialogue: 0,0:14:45.98,0:14:46.65,Default,,0,0,0,,Мен
Dialogue: 0,0:14:46.99,0:14:48.42,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:14:48.86,0:14:51.74,Default,,0,0,0,,Мен кәсіби командадан жеке детектив аламын.
Dialogue: 0,0:14:52.14,0:14:52.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:54.00,0:14:55.68,Default,,0,0,0,,Оматтато
Dialogue: 0,0:14:56.00,0:14:56.80,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:57.35,0:14:58.89,Default,,0,0,0,,Соңғы турнирде
Dialogue: 0,0:14:58.89,0:15:00.43,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:15:01.42,0:15:04.00,Default,,0,0,0,,Маған әр жерден қоңыраулар түсті.
Dialogue: 0,0:15:06.15,0:15:06.94,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:15:07.13,0:15:07.66,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:15:08.38,0:15:11.74,Default,,0,0,0,,Бірақ сіз тек бір орынды таңдай аласыз.
Dialogue: 0,0:15:13.47,0:15:15.99,Default,,0,0,0,,Сондықтан мен шынымен абдырап қалдым.
Dialogue: 0,0:15:17.24,0:15:19.82,Default,,0,0,0,,Мен ең шаршаған бөлікті таңдадым.
Dialogue: 0,0:15:20.95,0:15:21.80,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:15:21.80,0:15:22.58,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:15:28.64,0:15:29.53,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:15:30.49,0:15:32.80,Default,,0,0,0,,Барлығы шешім қабылдады
Dialogue: 0,0:15:33.18,0:15:34.06,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:34.60,0:15:36.76,Default,,0,0,0,,Мен барлығын білмеймін, бірақ
Dialogue: 0,0:15:37.54,0:15:39.98,Default,,0,0,0,,Егер мансап нұсқаларын көрсетпесеңіз, сізге ұрысады.
Dialogue: 0,0:15:40.48,0:15:41.12,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:15:59.80,0:16:00.65,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:01.50,0:16:02.48,Default,,0,0,0,,Итая
Dialogue: 0,0:16:03.79,0:16:06.81,Default,,0,0,0,,Бір көмекпен жерге барамыз.
Dialogue: 0,0:16:07.34,0:16:09.85,Default,,0,0,0,,Мұғалімге таңертеңгі жиынға кешігіп келетініңізді айтыңыз.
Dialogue: 0,0:16:10.20,0:16:11.28,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:16:11.70,0:16:13.32,Default,,0,0,0,,Бүгін менің демалыс күнім бар.
Dialogue: 0,0:16:13.60,0:16:15.48,Default,,0,0,0,,Уақыты шектеулі футболға өзгертілді.
Dialogue: 0,0:16:15.66,0:16:16.95,Default,,0,0,0,,Мэззи
Dialogue: 0,0:16:17.24,0:16:19.22,Default,,0,0,0,,Маған бір қарашы
Dialogue: 0,0:16:19.47,0:16:20.44,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:16:24.17,0:16:25.97,Default,,0,0,0,,Оның кеше ойыны болды.
Dialogue: 0,0:16:29.01,0:16:30.51,Default,,0,0,0,,Сіз не істеп жатырсыз? Барайық.
Dialogue: 0,0:16:31.33,0:16:32.05,Default,,0,0,0,,О
Dialogue: 0,0:16:37.95,0:16:39.38,Default,,0,0,0,,Мафуюмен ұрысып қалдым.
Dialogue: 0,0:16:41.29,0:16:42.03,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:42.38,0:16:44.38,Default,,0,0,0,,Қыс ортасы біртүрлі емес пе еді?
Dialogue: 0,0:16:46.45,0:16:49.91,Default,,0,0,0,,Менің ойымша, бұл аздап аулақ болды.
Dialogue: 0,0:16:51.01,0:16:52.08,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:53.11,0:16:57.69,Default,,0,0,0,,Әдетте, қыс ортасы мені аздап салқындаған кезде, мен Уау деп айтатын едім.
Dialogue: 0,0:17:01.36,0:17:03.68,Default,,0,0,0,,Неге тығылып жүрсің деп ойлап едім.
Dialogue: 0,0:17:04.34,0:17:06.30,Default,,0,0,0,,Қазір жеткілікті
Dialogue: 0,0:17:06.67,0:17:07.52,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:17:09.09,0:17:12.06,Default,,0,0,0,,Ол абдырап тұрғанда ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:17:12.67,0:17:14.89,Default,,0,0,0,,Қауіпті сызығы - егер сіз қатты итерсеңіз, сіз бас тартасыз.
Dialogue: 0,0:17:16.88,0:17:17.99,Default,,0,0,0,,Және кеше
Dialogue: 0,0:17:18.86,0:17:21.10,Default,,0,0,0,,Теледидардан Хиирагиге және басқаларға қараңыз.
Dialogue: 0,0:17:22.83,0:17:23.55,Default,,0,0,0,,О
Dialogue: 0,0:17:24.26,0:17:26.16,Default,,0,0,0,,Ол жігіттер нағыз кәсіпқойлар.
Dialogue: 0,0:17:26.55,0:17:28.16,Default,,0,0,0,,Мені кенет түсіндім.
Dialogue: 0,0:17:29.89,0:17:32.98,Default,,0,0,0,,Менің қазір сахнаға шығуға мүмкіндігім бар
Dialogue: 0,0:17:34.37,0:17:35.10,Default,,0,0,0,,Егер
Dialogue: 0,0:17:35.54,0:17:37.60,Default,,0,0,0,,Мафуюды музыкамен басқарыңыз
Dialogue: 0,0:17:38.76,0:17:41.19,Default,,0,0,0,,Қолдауымның арқасында менде болған кемшілік кешені
Dialogue: 0,0:17:41.60,0:17:42.70,Default,,0,0,0,,Сондай-ақ өз кінәсін сезіну
Dialogue: 0,0:17:43.34,0:17:45.82,Default,,0,0,0,,Сол жарымжан нәрселердің бәрін тастаңыз.
Dialogue: 0,0:17:47.00,0:17:49.34,Default,,0,0,0,,Музыканы байыппен қабылдаңыз
Dialogue: 0,0:17:51.10,0:17:52.08,Default,,0,0,0,,Мен сенімен бетпе-бет келгім келеді
Dialogue: 0,0:17:53.94,0:17:55.06,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:17:58.20,0:17:59.10,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:18:00.40,0:18:02.43,Default,,0,0,0,,Олардың тікелей эфирге келетініне сенімдімін.
Dialogue: 0,0:18:15.61,0:18:16.40,Default,,0,0,0,,Бұл ерте.
Dialogue: 0,0:18:16.93,0:18:17.65,Default,,0,0,0,,О
Dialogue: 0,0:18:18.55,0:18:20.00,Default,,0,0,0,,Мен жеке тәжірибемен айналысқым келеді.
Dialogue: 0,0:18:20.32,0:18:22.42,Default,,0,0,0,,Мен Хийрагиге мені ертерек жіберіңдер дедім.
Dialogue: 0,0:18:24.45,0:18:25.71,Default,,0,0,0,,Сіз мұны қашаннан бастап жасадыңыз?
Dialogue: 0,0:18:26.25,0:18:26.94,Default,,0,0,0,,Таң
Dialogue: 0,0:18:28.80,0:18:30.82,Default,,0,0,0,,Мен барлық әндерімді тамаша орындағым келеді.
Dialogue: 0,0:18:32.18,0:18:34.16,Default,,0,0,0,,Мен соңғы кездері шығарма жазудан басқа ештеңемен айналыспаймын.
Dialogue: 0,0:18:37.94,0:18:40.38,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:18:40.95,0:18:42.15,Default,,0,0,0,,ееееееееееееееееееееееееееееееек
Dialogue: 0,0:18:42.88,0:18:44.78,Default,,0,0,0,,Сіз қатты жұмыс істедіңіз бе?
Dialogue: 0,0:18:44.92,0:18:46.06,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:18:46.45,0:18:48.05,Default,,0,0,0,,Жанды орындау үшін
Dialogue: 0,0:18:48.16,0:18:49.29,Default,,0,0,0,,Құдай-ай, мұндай қалай болды?
Dialogue: 0,0:18:49.68,0:18:53.24,Default,,0,0,0,,Уақытқа алаңдамай жаттығуға болатыны менің арқамда.
Dialogue: 0,0:18:54.03,0:18:55.15,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:18:55.80,0:18:56.74,Default,,0,0,0,,Иә
Dialogue: 0,0:18:57.00,0:18:58.80,Default,,0,0,0,,Мен шынымен де солай ойладым
Dialogue: 0,0:18:58.14,0:18:59.50,Default,,0,0,0,,Шизу қашан келді?
Dialogue: 0,0:18:59.71,0:19:03.50,Default,,0,0,0,,Негізі жоғары сынып оқушылары үшін бұл студиялық төлемді төлеу қиын.
Dialogue: 0,0:19:04.36,0:19:06.80,Default,,0,0,0,,Мен тамақ жасадым.
Dialogue: 0,0:19:08.34,0:19:10.80,Default,,0,0,0,,Сіз бұл аптада ауысым деп айттыңыз.
Dialogue: 0,0:19:11.74,0:19:13.72,Default,,0,0,0,,Сондықтан толық емес жұмыс уақыты өте ауыр.
Dialogue: 0,0:19:14.08,0:19:16.13,Default,,0,0,0,,Әртүрлі шектеулер қолданылады
Dialogue: 0,0:19:16.80,0:19:18.26,Default,,0,0,0,,Егер бұл кәсіпқой болса
Dialogue: 0,0:19:19.07,0:19:20.98,Default,,0,0,0,,Жарайды, мен таңертең тапсырыс беремін.
Dialogue: 0,0:19:21.96,0:19:23.18,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:23.85,0:19:25.53,Default,,0,0,0,,Ойланып қарасам, бұл шың.
Dialogue: 0,0:19:26.46,0:19:28.79,Default,,0,0,0,,Сіз талқылайтын нәрсе бар деп айтқан жоқсыз.
Dialogue: 0,0:19:29.28,0:19:30.93,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:19:31.56,0:19:32.82,Default,,0,0,0,,Бұл өлең үлгісі.
Dialogue: 0,0:19:33.97,0:19:34.80,Default,,0,0,0,,Мыс.
Dialogue: 0,0:19:35.94,0:19:37.63,Default,,0,0,0,,Өткен күні жасаған дыбыс көзінен
Dialogue: 0,0:19:38.19,0:19:40.05,Default,,0,0,0,,Гитараны аздап өзгерткім келді.
Dialogue: 0,0:19:40.36,0:19:41.97,Default,,0,0,0,,Неге?
Dialogue: 0,0:19:42.50,0:19:43.92,Default,,0,0,0,,Себебі мен сені тұрғызғым келеді
Dialogue: 0,0:19:49.73,0:19:51.44,Default,,0,0,0,,Киелі жерде гүл бар
Dialogue: 0,0:19:52.27,0:19:54.14,Default,,0,0,0,,Гитара онша алға шықпайды.
Dialogue: 0,0:19:54.59,0:19:55.71,Default,,0,0,0,,Мен оны аздап басқым келеді.
Dialogue: 0,0:20:00.90,0:20:01.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:03.34,0:20:05.19,Default,,0,0,0,,Неліктен кенет өзгерді?
Dialogue: 0,0:20:06.72,0:20:09.00,Default,,0,0,0,,Бұл үлкен өзгеріс емес.
Dialogue: 0,0:20:09.75,0:20:10.87,Default,,0,0,0,,Сезімдерді азайту
Dialogue: 0,0:20:10.99,0:20:13.70,Default,,0,0,0,,Жоқ, менің айтып отырғаным бұл емес.
Dialogue: 0,0:20:15.34,0:20:17.36,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:20:17.68,0:20:18.34,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:20:19.38,0:20:22.01,Default,,0,0,0,,Менің тамаша адам екенім рас, бірақ
Dialogue: 0,0:20:22.44,0:20:23.40,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:20:26.88,0:20:27.54,Default,,0,0,0,,На
Dialogue: 0,0:20:28.33,0:20:29.38,Default,,0,0,0,,Бұл қандай ән?
Dialogue: 0,0:20:30.13,0:20:32.17,Default,,0,0,0,,Бұл оның аяқталғанын білдіре ме?
Dialogue: 0,0:20:35.62,0:20:36.90,Default,,0,0,0,,Егер сіз Хиирагиді қаласаңыз
Dialogue: 0,0:20:37.73,0:20:39.77,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:20:40.27,0:20:42.59,Default,,0,0,0,,Ақырында, барлық әндер осында.
Dialogue: 0,0:20:44.50,0:20:47.42,Default,,0,0,0,,Қыстың ортасында келіп мені тыңдайды.
Dialogue: 0,0:20:48.19,0:20:49.76,Default,,0,0,0,,Неге кенет жылайсың?
Dialogue: 0,0:20:50.22,0:20:53.00,Default,,0,0,0,,Сабыр ет, Хиираги әрқашан солай.
Dialogue: 0,0:20:53.80,0:20:55.10,Default,,0,0,0,,Жақында жылауыңды қоясың.
Dialogue: 0,0:20:55.22,0:20:57.02,Default,,0,0,0,,Сезімдеріңмен не болып жатыр?
Dialogue: 0,0:20:59.90,0:21:00.62,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:01.04,0:21:01.63,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:21:02.89,0:21:06.00,Default,,0,0,0,,Мен осы мысал өлеңді оқимын.
Dialogue: 0,0:21:06.37,0:21:07.26,Default,,0,0,0,,Эй
Dialogue: 0,0:21:07.63,0:21:09.43,Default,,0,0,0,,Ән атаусыз қалды.
Dialogue: 0,0:21:10.35,0:21:11.22,Default,,0,0,0,,Не?
Dialogue: 0,0:21:12.42,0:21:13.61,Default,,0,0,0,,Мен бұл туралы ойлана аламын.
Dialogue: 0,0:21:41.79,0:21:43.41,Default,,0,0,0,,Сонымен, дебют туралы не деуге болады?
Dialogue: 0,0:21:43.80,0:21:46.22,Default,,0,0,0,,Жақсы ойлайды.
Dialogue: 0,0:21:47.14,0:21:48.06,Default,,0,0,0,,Яғни
Dialogue: 0,0:21:48.28,0:21:49.68,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:21:50.77,0:21:51.92,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:52.20,0:21:54.54,Default,,0,0,0,,Мен жауап алмағандықтан анық.
Dialogue: 0,0:21:55.48,0:21:56.92,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:57.67,0:22:00.54,Default,,0,0,0,,Қазір барлық мүшелерді біріктіру қиын.
Dialogue: 0,0:22:00.75,0:22:02.18,Default,,0,0,0,,Ақырында
Dialogue: 0,0:22:02.37,0:22:05.70,Default,,0,0,0,,Өйткені олардың барлығы мектеп бітірер алдында студенттер, солай ма?
Dialogue: 0,0:22:06.16,0:22:08.20,Default,,0,0,0,,Мен электрондық поштада түсіндіргендей
Dialogue: 0,0:22:08.91,0:22:12.50,Default,,0,0,0,,Мен мұндай мүмкіндікке ие боламын деп ешқашан ойламадым.
Dialogue: 0,0:22:13.99,0:22:16.60,Default,,0,0,0,,Мен шын жүректен өте ризамын.
Dialogue: 0,0:22:17.80,0:22:18.73,Default,,0,0,0,,Бірақ
Dialogue: 0,0:22:19.99,0:22:23.51,Default,,0,0,0,,Әлі шешілмеген мүшелер бар дедіңіз бе?
Dialogue: 0,0:22:25.76,0:22:26.50,Default,,0,0,0,,Бұл
Dialogue: 0,0:22:27.03,0:22:28.56,Default,,0,0,0,,Мен күтуіңізді қалаймын.
Dialogue: 0,0:22:31.50,0:22:32.19,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:22:32.78,0:22:38.07,Default,,0,0,0,,Жоқ, менің ойымша, біз ақыр соңында міндетті түрде музыканы бірге орындауды таңдаймыз.
Dialogue: 0,0:22:39.38,0:22:40.06,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:22:41.06,0:22:42.50,Default,,0,0,0,,Бұл ең жақсысы
Dialogue: 0,0:22:43.08,0:22:45.32,Default,,0,0,0,,Өйткені мен шешім қабылдауға көп уақыт алатын адаммын.
Dialogue: 0,0:22:46.44,0:22:47.36,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:22:48.17,0:22:50.03,Default,,0,0,0,,Өйткені төртеуміз бірге жасағымыз келеді
Dialogue: 0,0:22:50.88,0:22:52.37,Default,,0,0,0,,Мен дұрыс күткім келеді.
Dialogue: 0,0:22:55.28,0:22:56.59,Default,,0,0,0,,Мен сол күні болдым
Dialogue: 0,0:22:57.23,0:22:59.15,Default,,0,0,0,,CAC-да кездескенше
Dialogue: 0,0:22:59.60,0:23:02.59,Default,,0,0,0,,Әуеннің шырқағанына біраз болды.
Dialogue: 0,0:23:03.40,0:23:06.74,Default,,0,0,0,,Діріл арқамнан аяғыма дейін жүгірді.
Dialogue: 0,0:23:07.96,0:23:11.42,Default,,0,0,0,,Көңілге қону – сондай рахат сезім.
Dialogue: 0,0:23:11.82,0:23:15.56,Default,,0,0,0,,Мен бұл мүшелердің барлығының бірге болуы керемет деп ойладым.
Dialogue: 0,0:23:17.50,0:23:19.55,Default,,0,0,0,,Кім шатастырғанын білмеймін.
Dialogue: 0,0:23:20.08,0:23:21.93,Default,,0,0,0,,Маған да барлығының бірге болғаны ұнайды.
Dialogue: 0,0:23:24.12,0:23:25.19,Default,,0,0,0,,Олай болса күтейік
Dialogue: 0,0:23:27.19,0:23:29.76,Default,,0,0,0,,Сондай-ақ мен Given Box жанкүйерімін.
Dialogue: 0,0:23:34.47,0:23:35.99,Default,,0,0,0,,Ол жақсы адам еді.
Dialogue: 0,0:23:37.12,0:23:39.94,Default,,0,0,0,,Мен тек осындай үлпілдек сөздер айта аламын.
Dialogue: 0,0:23:40.83,0:23:42.56,Default,,0,0,0,,Кім шатасты?
Dialogue: 0,0:23:42.96,0:23:45.18,Default,,0,0,0,,Қанша уақыт күту керек екенін сұрамаңыз.
Dialogue: 0,0:23:46.07,0:23:50.03,Default,,0,0,0,,Бірақ мен өзімнің қаншалықты байыпты екенімді көзімнің түбінде өлшеп тұрдым.
Dialogue: 0,0:23:51.93,0:23:52.76,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:23:54.11,0:23:55.68,Default,,0,0,0,,Кәсіби әлем?
Dialogue: 0,0:23:55.68,0:23:57.70,Default,,0,0,0,,Шудың болуы
Dialogue: 0,0:23:57.70,0:23:59.67,Default,,0,0,0,,Дайын бол
Dialogue: 0,0:23:59.67,0:24:01.87,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:24:01.87,0:24:04.18,Default,,0,0,0,,Жүр, менің артымнан жүр.
Dialogue: 0,0:24:08.50,0:24:11.36,Default,,0,0,0,,Әй, солай болды ма?
Dialogue: 0,0:24:11.78,0:24:16.35,Default,,0,0,0,,Мен Акихикомен сөйлесіп, сонда да жалғыз бардым.
Dialogue: 0,0:24:16.86,0:24:19.15,Default,,0,0,0,,Мен қатты қобалжыдым.
Dialogue: 0,0:24:19.50,0:24:20.98,Default,,0,0,0,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Бұл әлемге махаббатпен. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:24:21.58,0:24:22.89,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:24:23.98,0:24:26.04,Default,,0,0,0,,Ойланып тұрғанда қыстың ортасы.
Dialogue: 0,0:24:28.02,0:24:29.98,Default,,0,0,0,,Таке-чан, мен түсінемін.
Dialogue: 0,0:24:30.48,0:24:34.40,Default,,0,0,0,,Өйткені ол менің бірінші жоспарланған жанды орындауымның репетициясында ән айтқан жоқ.
Dialogue: 0,0:24:34.64,0:24:36.88,Default,,0,0,0,,Баххахахахахаха
Dialogue: 0,0:24:38.68,0:24:41.08,Default,,0,0,0,,Сен де қиналып жүрсің.
Dialogue: 0,0:24:44.36,0:24:45.29,Default,,0,0,0,,Жақсы
Dialogue: 0,0:24:46.69,0:24:50.55,Default,,0,0,0,,Бірақ мен өзімді оның әні құтқарып қалдым.
Dialogue: 0,0:24:51.91,0:24:53.87,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:24:54.58,0:24:58.76,Default,,0,0,0,,Келесі жолы мен Мафуюдың арқасын итеріп жіберетін адам болғым келеді.
Dialogue: 0,0:24:58.76,0:24:59.79,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:25:01.18,0:25:05.71,Default,,0,0,0,,Бірақ мен мұны істей алғанша күтемін.
Dialogue: 0,0:25:06.45,0:25:07.72,Default,,0,0,0,,Жақсы
Dialogue: 0,0:25:07.72,0:25:10.98,Default,,0,0,0,,Мүмкін бұл белгілі бір топ сезімі шығар.
Dialogue: 0,0:25:11.55,0:25:13.06,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:25:13.67,0:25:15.89,Default,,0,0,0,,Менде бір.
Dialogue: 0,0:25:17.20,0:25:20.31,Default,,0,0,0,,Жоқ, мүмкін оның топқа қатысы жоқ шығар.
Dialogue: 0,0:25:20.97,0:25:22.45,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:25:23.52,0:25:24.32,Default,,0,0,0,,Кейде
Dialogue: 0,0:25:24.52,0:25:29.44,Default,,0,0,0,,Әдеттегідей, мен өз рөлімді сезінетін кездер болады.
Dialogue: 0,0:25:30.24,0:25:34.21,Default,,0,0,0,,Сіз біреудің шешімін қолдайтын жағдайға тап болған кезде.
Dialogue: 0,0:25:34.93,0:25:38.61,Default,,0,0,0,,Сіз біреудің үлкен өзгеріс мүмкіндігіне қатысқан кезде.
Dialogue: 0,0:25:39.56,0:25:40.86,Default,,0,0,0,,Аа, түсіндім.
Dialogue: 0,0:25:41.16,0:25:43.92,Default,,0,0,0,,Мен сонда болдым деп ойлаймын.
Dialogue: 0,0:25:44.28,0:25:45.56,Default,,0,0,0,,Бұл мағынасы бар
Dialogue: 0,0:25:47.22,0:25:50.80,Default,,0,0,0,,Көп жағдайда мен қосалқы кейіпкермін.
Dialogue: 0,0:25:51.65,0:25:53.31,Default,,0,0,0,,Мен сол кездемін
Dialogue: 0,0:25:54.28,0:25:56.04,Default,,0,0,0,,Мен сені жек көрмеймін.
Dialogue: 0,0:26:00.19,0:26:02.14,Default,,0,0,0,,Жоқ, сәл көп болуы мүмкін
Dialogue: 0,0:26:05.77,0:26:09.30,Default,,0,0,0,,Бұл керемет, мен де көшіріп аламын деп ойлаймын.
Dialogue: 0,0:26:11.10,0:26:11.81,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:26:14.24,0:26:15.86,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:26:17.10,0:26:19.55,Default,,0,0,0,,Әсіресе қыс ортасында,
Dialogue: 0,0:26:19.95,0:26:22.68,Default,,0,0,0,,Уэнояма және біз Таке-чан
Dialogue: 0,0:26:23.09,0:26:26.22,Default,,0,0,0,,Мені танымайтын басқа біреу итеріп жатыр
Dialogue: 0,0:26:27.46,0:26:31.76,Default,,0,0,0,,Мені музыкаға осылай жетелеген шығар.
Dialogue: 0,0:26:41.68,0:26:43.16,Default,,0,0,0,,ше?
Dialogue: 0,0:26:44.14,0:26:45.41,Default,,0,0,0,,Компания тұлғасын есепке алу
Dialogue: 0,0:26:45.68,0:26:46.47,Default,,0,0,0,,Иә
Dialogue: 0,0:26:47.06,0:26:48.86,Default,,0,0,0,,Ол жалпы жақсы адам болатын.
Dialogue: 0,0:26:49.08,0:26:50.03,Default,,0,0,0,,Эй
Dialogue: 0,0:26:50.68,0:26:52.58,Default,,0,0,0,,Басқа нәрселер туралы әңгімелеу.
Dialogue: 0,0:26:53.50,0:26:55.52,Default,,0,0,0,,Сүйікті музыкаң туралы әңгімеле
Dialogue: 0,0:26:56.29,0:26:57.98,Default,,0,0,0,,Менің ОАО-да болған кезім туралы әңгіме.
Dialogue: 0,0:26:58.72,0:27:01.23,Default,,0,0,0,,Хийраги және оның тобы туралы әңгімелеу.
Dialogue: 0,0:27:01.77,0:27:02.85,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:27:04.31,0:27:07.48,Default,,0,0,0,,Мен сізге Уенояманың қолдауы туралы айттым ба?
Dialogue: 0,0:27:09.26,0:27:12.85,Default,,0,0,0,,Сізге Gitar Child Major қолдау көрсетіп жатыр ма?
Dialogue: 0,0:27:13.27,0:27:13.97,Default,,0,0,0,,Жарайды
Dialogue: 0,0:27:15.12,0:27:17.11,Default,,0,0,0,,Маған айтты
Dialogue: 0,0:27:18.56,0:27:19.48,Default,,0,0,0,,Ахаха
Dialogue: 0,0:27:21.43,0:27:23.05,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:27:24.22,0:27:27.65,Default,,0,0,0,,Мен де былтыр қолдауға ие болдым.
Dialogue: 0,0:27:27.94,0:27:30.26,Default,,0,0,0,,Мен ештеңе айта алмаймын.
Dialogue: 0,0:27:32.06,0:27:33.00,Default,,0,0,0,,Акихико
Dialogue: 0,0:27:33.72,0:27:34.80,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:27:40.83,0:27:45.40,Default,,0,0,0,,Мен музыка арқылы ақша табатындарды қызғанбаймын деп ойлаймын.
Dialogue: 0,0:27:45.94,0:27:46.91,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:27:47.40,0:27:50.64,Default,,0,0,0,,Оның қазір сахнаға шығуы керек сияқты.
Dialogue: 0,0:27:51.67,0:27:53.47,Default,,0,0,0,,Тіпті қыстың ортасында және Уенояма тауында
Dialogue: 0,0:27:56.77,0:27:57.85,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:27:58.78,0:28:02.59,Default,,0,0,0,,Мен Таке-чанға қалай қатысым бар.
Dialogue: 0,0:28:03.18,0:28:04.83,Default,,0,0,0,,Тексеріңіз
Dialogue: 0,0:28:09.22,0:28:11.02,Default,,0,0,0,,Қуырылған күріш жақсарып келеді.
Dialogue: 0,0:28:11.63,0:28:13.38,Default,,0,0,0,,Мен жаттықтым
Dialogue: 0,0:28:20.45,0:28:21.10,Default,,0,0,0,,Бұл
Dialogue: 0,0:28:21.58,0:28:22.91,Default,,0,0,0,,Бүгін Уеноямада
Dialogue: 0,0:28:23.30,0:28:24.10,Default,,0,0,0,,Демалу
Dialogue: 0,0:28:24.80,0:28:27.05,Default,,0,0,0,,Тікелей репетицияға байланысты үзіліс алатынымды хабарладым.
Dialogue: 0,0:28:27.40,0:28:28.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:28.67,0:28:29.54,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:28:29.78,0:28:31.87,Default,,0,0,0,,Сонда Сато-кун да демалыста ма?
Dialogue: 0,0:28:32.07,0:28:35.24,Default,,0,0,0,,Жоқ, ол басқа топпен жұмыс істейді.
Dialogue: 0,0:28:35.46,0:28:36.95,Default,,0,0,0,,Демалыс
Dialogue: 0,0:28:37.30,0:28:38.70,Default,,0,0,0,,Шынымен бе? Ол неге мұнда?
Dialogue: 0,0:28:38.88,0:28:41.36,Default,,0,0,0,,Сіз де ойынға келмейсіз ғой, солай емес пе?
Dialogue: 0,0:28:41.52,0:28:43.17,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:28:43.38,0:28:46.18,Default,,0,0,0,,Онда шағымданба, кедергі боласың.
Dialogue: 0,0:28:43.93,0:28:46.18,Default,,0,0,0,,Е, не болып жатыр?
Dialogue: 0,0:29:24.28,0:29:25.18,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:29:36.72,0:29:38.50,Default,,0,0,0,,А, мен не істеуім керек?
Dialogue: 0,0:29:39.22,0:29:40.82,Default,,0,0,0,,Концерт болатын күн де келіп жетті
Dialogue: 0,0:29:43.06,0:29:44.74,Default,,0,0,0,,Менің барғым келмейді
Dialogue: 0,0:29:46.18,0:29:47.17,Default,,0,0,0,,Неге деп ойлаймын
Dialogue: 0,0:29:47.86,0:29:51.50,Default,,0,0,0,,Мен сол кезде неге бет бұрдым деп ойлаймын.
Dialogue: 0,0:29:52.67,0:29:56.47,Default,,0,0,0,,Жүрегімнің бір жерінде Уенояма-кун мені шақырады деп үміттенемін.
Dialogue: 0,0:29:57.18,0:29:59.03,Default,,0,0,0,,Мен шынымен бақыттымын деп ойлаймын.
Dialogue: 0,0:30:00.83,0:30:04.80,Default,,0,0,0,,Мен өз ойымды басқа адамдарға қарағанда баяу тұжырымдаймын.
Dialogue: 0,0:30:05.47,0:30:08.54,Default,,0,0,0,,Мен не істегім келетінін де білмеймін
Dialogue: 0,0:30:10.34,0:30:11.09,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:30:12.10,0:30:13.07,Default,,0,0,0,,Менің барғым келмейді
Dialogue: 0,0:30:14.46,0:30:15.78,Default,,0,0,0,,Барлығының жылдамдығымен
Dialogue: 0,0:30:16.89,0:30:18.47,Default,,0,0,0,,Мен ғана қуып жете алмаймын
Dialogue: 0,0:30:27.12,0:30:27.96,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:30:33.68,0:30:34.32,Default,,0,0,0,,На
Dialogue: 0,0:30:35.27,0:30:36.18,Default,,0,0,0,,Ойнайық
Dialogue: 0,0:30:41.20,0:30:43.50,Default,,0,0,0,,Иә Тікелей эфир билеттері
Dialogue: 0,0:30:47.03,0:30:49.04,Default,,0,0,0,,Ал, билетті төлеудің қажеті жоқ.
Dialogue: 0,0:30:49.28,0:30:51.89,Default,,0,0,0,,Өйткені бұл шақыруларға арналған арнайы билет.
Dialogue: 0,0:30:52.93,0:30:54.59,Default,,0,0,0,,Рахмет
Dialogue: 0,0:30:54.77,0:30:56.00,Default,,0,0,0,,Жоқ Жоқ
Dialogue: 0,0:31:01.75,0:31:02.52,Default,,0,0,0,,Кейінірек
Dialogue: 0,0:31:02.86,0:31:06.00,Default,,0,0,0,,Мен саған бірдеңені кешіктірдім.
Dialogue: 0,0:31:07.58,0:31:10.00,Default,,0,0,0,,Маған Уенояманы қарызға бергеніңіз үшін рахмет.
Dialogue: 0,0:31:11.72,0:31:13.62,Default,,0,0,0,,Әсіресе соңғы екі аптада
Dialogue: 0,0:31:14.09,0:31:15.98,Default,,0,0,0,,Оны қатты қатайтыңыз.
Dialogue: 0,0:31:16.86,0:31:19.22,Default,,0,0,0,,Саған да қызық болмады деп ойлаймын.
Dialogue: 0,0:31:20.50,0:31:21.75,Default,,0,0,0,,Қалай болғанда да, мен құтқарылдым.
Dialogue: 0,0:31:22.64,0:31:26.22,Default,,0,0,0,,Сенің ойың туралы ойлауға уақытым да жоқ.
Dialogue: 0,0:31:27.02,0:31:28.78,Default,,0,0,0,,Бұл сіз жасағыңыз келген нәрсе ме?
Dialogue: 0,0:31:29.00,0:31:31.07,Default,,0,0,0,,Мен нені жеңгім келді
Dialogue: 0,0:31:31.48,0:31:33.15,Default,,0,0,0,,Міне, бар.
Dialogue: 0,0:31:34.80,0:31:38.61,Default,,0,0,0,,Мұның бәрі менің өзімшілдігім ғана.
Dialogue: 0,0:31:41.65,0:31:43.82,Default,,0,0,0,,Бұл менің өзімшілдігім ғана.
Dialogue: 0,0:31:45.60,0:31:47.65,Default,,0,0,0,,Мен Мафуюдың менен сұрағанын қалаймын.
Dialogue: 0,0:31:48.89,0:31:50.00,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:31:52.67,0:31:54.71,Default,,0,0,0,,Мен өзімшіл болдым
Dialogue: 0,0:31:55.77,0:31:56.77,Default,,0,0,0,,Бар болғаны
Dialogue: 0,0:32:03.28,0:32:03.91,Default,,0,0,0,,На
Dialogue: 0,0:32:04.24,0:32:07.16,Default,,0,0,0,,Ертеңнен бастап нақты өндіріс басталады.
Dialogue: 0,0:32:07.84,0:32:09.54,Default,,0,0,0,,Өте қорқынышты
Dialogue: 0,0:32:10.72,0:32:12.51,Default,,0,0,0,,Маған қолдау білдіруіңізді өтінемін.
Dialogue: 0,0:32:18.83,0:32:19.84,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:32:20.52,0:32:21.43,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:32:23.28,0:32:23.97,Default,,0,0,0,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:32:24.63,0:32:25.47,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:32:31.05,0:32:32.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:32:41.23,0:32:45.33,Default,,0,0,0,,Ол жоғалған күшік сияқты көрінді.
Dialogue: 0,0:32:45.76,0:32:50.48,Default,,0,0,0,,Жоқ, бірақ мен Сато мырзамен шынымен сөйлескен жоқпын.
Dialogue: 0,0:32:53.66,0:32:54.83,Default,,0,0,0,,Сато мырза
Dialogue: 0,0:32:55.47,0:32:56.30,Default,,0,0,0,,Иә
Dialogue: 0,0:32:57.93,0:32:58.93,Default,,0,0,0,,Генки
Dialogue: 0,0:33:00.39,0:33:02.16,Default,,0,0,0,,Уэнояма-кунның сыныбы
Dialogue: 0,0:33:02.62,0:33:03.74,Default,,0,0,0,,Иә
Dialogue: 0,0:33:04.07,0:33:04.96,Default,,0,0,0,,Генки
Dialogue: 0,0:33:05.96,0:33:10.41,Default,,0,0,0,,А, қарағым, мен Уэнояма-кунның жұмыста жоқ екенін естідім.
Dialogue: 0,0:33:10.76,0:33:13.01,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:33:13.30,0:33:14.52,Default,,0,0,0,,О, қыс ортасы
Dialogue: 0,0:33:15.30,0:33:16.26,Default,,0,0,0,,Уэки-кун
Dialogue: 0,0:33:16.60,0:33:17.32,Default,,0,0,0,,О
Dialogue: 0,0:33:18.69,0:33:20.35,Default,,0,0,0,,Уеноямамен татуластың ба?
Dialogue: 0,0:33:20.35,0:33:20.98,Default,,0,0,0,,Гах
Dialogue: 0,0:33:25.81,0:33:26.96,Default,,0,0,0,,Ахно
Dialogue: 0,0:33:28.10,0:33:30.68,Default,,0,0,0,,Екеуі мансап жолын шешті.
Dialogue: 0,0:33:31.45,0:33:32.20,Default,,0,0,0,,Он алтылық
Dialogue: 0,0:33:32.20,0:33:32.90,Default,,0,0,0,,Курс
Dialogue: 0,0:33:34.01,0:33:34.64,Default,,0,0,0,,Иә
Dialogue: 0,0:33:34.64,0:33:35.95,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:33:39.12,0:33:41.26,Default,,0,0,0,,Жеке университетке қабылдау
Dialogue: 0,0:33:42.26,0:33:43.80,Default,,0,0,0,,Жасағым келетін нәрсе
Dialogue: 0,0:33:43.45,0:33:45.12,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:33:46.85,0:33:48.74,Default,,0,0,0,,Мен де бұл туралы әлі ойланып жүрмін.
Dialogue: 0,0:33:50.14,0:33:51.77,Default,,0,0,0,,Өйткені бұл қалыпты жағдай.
Dialogue: 0,0:33:52.20,0:33:52.92,Default,,0,0,0,,Қалыпты
Dialogue: 0,0:33:53.66,0:33:56.84,Default,,0,0,0,,Уенояма және үстел дүкендері сияқты нәрселер қалыпты емес.
Dialogue: 0,0:33:57.81,0:34:01.56,Default,,0,0,0,,Міне, сол үшін ұрысып жатырмыз.
Dialogue: 0,0:34:02.00,0:34:05.21,Default,,0,0,0,,Кәсіби мансапты мақсат ету немесе мақсат етпеу туралы дау болды.
Dialogue: 0,0:34:09.31,0:34:12.20,Default,,0,0,0,,Бұл төбелес немесе басқа нәрсе емес.
Dialogue: 0,0:34:13.15,0:34:15.43,Default,,0,0,0,,Өйткені мен қоқыспын
Dialogue: 0,0:34:17.06,0:34:20.93,Default,,0,0,0,,Эй, Уэнояма не істегісі келетінін анық түсінді.
Dialogue: 0,0:34:21.28,0:34:24.83,Default,,0,0,0,,Бірақ әдетте мен дәл қазір қалай өмір сүретінімді шеше алмаймын.
Dialogue: 0,0:34:25.46,0:34:28.11,Default,,0,0,0,,Мен мән-жайды білмеймін, бірақ
Dialogue: 0,0:34:29.13,0:34:33.06,Default,,0,0,0,,Сіз қатты уайымдасаңыз, біреуді мазасыз деп айтудың қажеті жоқ.
Dialogue: 0,0:34:35.50,0:34:38.69,Default,,0,0,0,,Мен мұны шынымен білмегендіктен ғана айта аламын.
Dialogue: 0,0:34:41.96,0:34:45.40,Default,,0,0,0,,Ойланбас бұрын өз қалауыңыз бойынша әрекет ету дұрыс емес пе?
Dialogue: 0,0:34:46.50,0:34:47.77,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:35:12.11,0:35:13.21,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:35:14.55,0:35:16.85,Default,,0,0,0,,Бір қызығы, олар маған бәрі жақсы деді.
Dialogue: 0,0:35:17.57,0:35:19.66,Default,,0,0,0,,Мен вокзалға жеттім, бірақ үлгердім.
Dialogue: 0,0:35:27.26,0:35:28.10,Default,,0,0,0,,Бұл
Dialogue: 0,0:35:31.46,0:35:32.92,Default,,0,0,0,,Ән перзенті
Dialogue: 0,0:35:35.62,0:35:36.97,Default,,0,0,0,,Жақсы
Dialogue: 0,0:35:37.33,0:35:39.25,Default,,0,0,0,,Сіз аш едіңіз, солай емес пе?
Dialogue: 0,0:35:39.73,0:35:42.87,Default,,0,0,0,,Бүгін ештеңе жемей бітіретін сияқты болдым.
Dialogue: 0,0:35:43.72,0:35:45.31,Default,,0,0,0,,Бізге қосылғаныңыз үшін рахмет.
Dialogue: 0,0:35:48.35,0:35:49.36,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:35:50.99,0:35:53.08,Default,,0,0,0,,А, сіз қосымша кез келген нәрсені сұрай аласыз.
Dialogue: 0,0:35:53.42,0:35:54.30,Default,,0,0,0,,Иә
Dialogue: 0,0:35:55.74,0:35:57.51,Default,,0,0,0,,Сонымен сіз Жапонияда болдыңыз ба?
Dialogue: 0,0:35:58.32,0:36:00.16,Default,,0,0,0,,Сіз қашан оралдыңыз?
Dialogue: 0,0:36:02.24,0:36:04.14,Default,,0,0,0,,Мен оралдым.
Dialogue: 0,0:36:04.51,0:36:06.92,Default,,0,0,0,,Мен заттарымды реттеуге бір рет келдім деп ойлаймын.
Dialogue: 0,0:36:07.41,0:36:09.19,Default,,0,0,0,,Ұйымдастырылған ба?
Dialogue: 0,0:36:09.56,0:36:10.22,Default,,0,0,0,,Иә
Dialogue: 0,0:36:13.10,0:36:15.74,Default,,0,0,0,,Мен ресми түрде Нью-Йоркке көшіп жатырмын.
Dialogue: 0,0:36:16.94,0:36:18.59,Default,,0,0,0,,Сіз жарыста жүлде алдыңыз.
Dialogue: 0,0:36:18.96,0:36:21.26,Default,,0,0,0,,Мен сол жақтағы оркестрмен осылай таныстым.
Dialogue: 0,0:36:22.67,0:36:24.90,Default,,0,0,0,,Мен әрқашан қонақүйде тұратынмын.
Dialogue: 0,0:36:25.29,0:36:26.57,Default,,0,0,0,,Мүмкін сондықтан болар
Dialogue: 0,0:36:26.77,0:36:30.75,Default,,0,0,0,,Мен адамдармен және басқа да адамдармен қарым-қатынас жасауға немқұрайлы қарайтын болдым.
Dialogue: 0,0:36:31.67,0:36:35.95,Default,,0,0,0,,Көре алмаған бір танысым маған бөлме беруді ұсынды.
Dialogue: 0,0:36:37.78,0:36:40.35,Default,,0,0,0,,Мен қазір көшуім керек сияқты.
Dialogue: 0,0:36:41.79,0:36:42.80,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:36:43.18,0:36:45.97,Default,,0,0,0,,Сіз сонда мәңгі боласыз ба?
Dialogue: 0,0:36:46.48,0:36:47.47,Default,,0,0,0,,Жоқ
Dialogue: 0,0:36:47.97,0:36:51.47,Default,,0,0,0,,Әзірге алдағы екі жылға арналған жоспарларым толық.
Dialogue: 0,0:36:52.02,0:36:55.14,Default,,0,0,0,,Жарайды, менің ойымша, кем дегенде екі жыл қажет.
Dialogue: 0,0:36:56.15,0:36:57.88,Default,,0,0,0,,Ары қарай не боларын білмеймін
Dialogue: 0,0:36:59.68,0:37:01.68,Default,,0,0,0,,Менің ойымша, ол Жапонияға анда-санда келеді.
Dialogue: 0,0:37:02.00,0:37:03.75,Default,,0,0,0,,Өнімділік жұмысы немесе бір нәрсе үшін
Dialogue: 0,0:37:09.22,0:37:10.45,Default,,0,0,0,,Қыс ортасы ше?
Dialogue: 0,0:37:13.36,0:37:15.70,Default,,0,0,0,,Мүмкін бірдеңе дұрыс емес шығар.
Dialogue: 0,0:37:22.08,0:37:23.43,Default,,0,0,0,,Иә
Dialogue: 0,0:37:24.35,0:37:27.97,Default,,0,0,0,,Бірден көп нәрсе болып жатыр.
Dialogue: 0,0:37:28.98,0:37:30.95,Default,,0,0,0,,Менің досым үлкен дебют жасады
Dialogue: 0,0:37:31.37,0:37:34.07,Default,,0,0,0,,Гитарист сол жерде қолдауға қосылды.
Dialogue: 0,0:37:34.55,0:37:37.69,Default,,0,0,0,,Сонымен қатар, басқа мүшелер мен мектеп достары
Dialogue: 0,0:37:38.12,0:37:41.98,Default,,0,0,0,,Мен алға ұмтылып, өз жолымды қуып бара жатқандай сезінемін.
Dialogue: 0,0:37:44.51,0:37:45.30,Default,,0,0,0,,Иә
Dialogue: 0,0:37:46.58,0:37:48.36,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:37:49.15,0:37:50.39,Default,,0,0,0,,Дебют туралы да айтыңыз
Dialogue: 0,0:37:50.90,0:37:52.12,Default,,0,0,0,,Айналаңыздағылардың бәрі де
Dialogue: 0,0:37:52.76,0:37:54.96,Default,,0,0,0,,Ол кенет одан әрі алыстап кетті.
Dialogue: 0,0:37:55.66,0:37:57.26,Default,,0,0,0,,Бұл бөтендік сезімі
Dialogue: 0,0:37:57.69,0:38:01.36,Default,,0,0,0,,Тітіркену немесе музыканы ұнату
Dialogue: 0,0:38:04.18,0:38:06.62,Default,,0,0,0,,Маған Уэнояма-кун ұнайды.
Dialogue: 0,0:38:09.46,0:38:10.95,Default,,0,0,0,,Бүгін тікелей эфирге барсам
Dialogue: 0,0:38:11.45,0:38:13.54,Default,,0,0,0,,Бәрі өзгеретін сияқты
Dialogue: 0,0:38:14.47,0:38:16.36,Default,,0,0,0,,Мен қозғала алмаймын.
Dialogue: 0,0:38:16.80,0:38:18.05,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:38:18.05,0:38:19.39,Default,,0,0,0,,Тікелей эфир бүгін
Dialogue: 0,0:38:20.77,0:38:21.42,Default,,0,0,0,,Иә
Dialogue: 0,0:38:23.95,0:38:25.92,Default,,0,0,0,,Әңгіме өзгеруге жақын.
Dialogue: 0,0:38:21.72,0:38:23.31,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:38:28.35,0:38:31.53,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:38:31.86,0:38:34.59,Default,,0,0,0,,Мен бұл әңгімені естідім.
Dialogue: 0,0:38:35.10,0:38:36.69,Default,,0,0,0,,Жоқ, мен естідім.
Dialogue: 0,0:38:37.21,0:38:39.47,Default,,0,0,0,,Ой, басталатын уақыт та қалды.
Dialogue: 0,0:38:40.52,0:38:41.94,Default,,0,0,0,,Сіз мұны ала аласыз.
Dialogue: 0,0:38:42.77,0:38:43.86,Default,,0,0,0,,Угецу-сан
Dialogue: 0,0:38:44.18,0:38:45.51,Default,,0,0,0,,Бірге барайық
Dialogue: 0,0:38:45.87,0:38:46.94,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:38:47.52,0:38:51.86,Default,,0,0,0,,Уайымдама, уайымдама, мұндай іске бар күшіңді салып кіріскен дұрыс.
Dialogue: 0,0:38:52.08,0:38:55.82,Default,,0,0,0,,Бұл өте жақсы. Күте тұрыңыз, Угецу-сан.
Dialogue: 0,0:38:56.15,0:38:57.05,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:39:04.04,0:39:05.07,Default,,0,0,0,,Қыс ортасы
Dialogue: 0,0:39:05.78,0:39:07.50,Default,,0,0,0,,Сіз шынымен неден қорқасыз?
Dialogue: 0,0:39:14.13,0:39:16.71,Default,,0,0,0,,Қайта алмай қалам ба деп қорқамын.
Dialogue: 0,0:39:20.17,0:39:24.95,Default,,0,0,0,,Менден дебют жасағыңыз келе ме деп сұрағанда, мен шынымен де, өте бақытты болдым.
Dialogue: 0,0:39:26.10,0:39:29.65,Default,,0,0,0,,Бірақ егер сіз музыканы таңдасаңыз, онда сіз болуыңыз мүмкін
Dialogue: 0,0:39:30.22,0:39:32.78,Default,,0,0,0,,Музыкаға қарсы өмір сүру мүмкін емес.
Dialogue: 0,0:39:34.50,0:39:37.30,Default,,0,0,0,,Махаббат құнына келсе де
Dialogue: 0,0:39:39.22,0:39:41.98,Default,,0,0,0,,Керісінше, музыканы таңдамасаңыз да
Dialogue: 0,0:39:42.33,0:39:47.52,Default,,0,0,0,,Мен оны музыкасыз қарсы алмайтыныма сенімдімін.
Dialogue: 0,0:39:48.82,0:39:51.51,Default,,0,0,0,,Екі жақтан қоштасу ұшқыны бар.
Dialogue: 0,0:39:52.61,0:39:56.29,Default,,0,0,0,,Егер мен қазір тікелей эфирге барсам және музыка тыңдасам, мен
Dialogue: 0,0:39:56.90,0:39:59.74,Default,,0,0,0,,Музыканы тастаңыз, махаббатты тастаңыз
Dialogue: 0,0:40:00.34,0:40:04.67,Default,,0,0,0,,Мен шешуші нәрсе ойлайтыныма сенімдімін.
Dialogue: 0,0:40:05.74,0:40:10.26,Default,,0,0,0,,Дәл Угетсу музыка мен Каджиді таразылағандай.
Dialogue: 0,0:40:14.00,0:40:15.02,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:40:15.50,0:40:18.02,Default,,0,0,0,,Сіз екі жаққа да орала алмайсыз.
Dialogue: 0,0:40:19.38,0:40:24.61,Default,,0,0,0,,Мен таңдаймын ба, таңдамаймын ба, дәл осы сәтте бәрі өзгереді.
Dialogue: 0,0:40:25.29,0:40:28.14,Default,,0,0,0,,Мен келген жол ешқашан бұрынғы қалпына келмейді.
Dialogue: 0,0:40:29.55,0:40:32.01,Default,,0,0,0,,Және бір орында тұрып
Dialogue: 0,0:40:32.48,0:40:35.07,Default,,0,0,0,,Бұл өте азап.
Dialogue: 0,0:40:36.05,0:40:37.20,Default,,0,0,0,,Әзірге
Dialogue: 0,0:40:38.80,0:40:42.38,Default,,0,0,0,,Мен мүмкіндігінше алға жылжуды ұсынар едім.
Dialogue: 0,0:40:43.74,0:40:45.47,Default,,0,0,0,,Мен әңгімені естідім.
Dialogue: 0,0:40:45.74,0:40:47.25,Default,,0,0,0,,Ал қыстың ортасы
Dialogue: 0,0:40:47.79,0:40:51.34,Default,,0,0,0,,Содан бері мен басқа адамның не ойлайтынын түсіне алмадым.
Dialogue: 0,0:40:52.19,0:40:56.59,Default,,0,0,0,,Өз бетінше шешім қабылдамас бұрын, басқа адамның айтқанын тыңдау дұрыс емес пе?
Dialogue: 0,0:40:57.98,0:41:01.19,Default,,0,0,0,,Жоқ, сондықтан қорқынышты.
Dialogue: 0,0:41:01.19,0:41:02.70,Default,,0,0,0,,Баххахаха
Dialogue: 0,0:41:04.27,0:41:05.64,Default,,0,0,0,,Бірақ қазір қыс ортасы
Dialogue: 0,0:41:06.29,0:41:08.18,Default,,0,0,0,,Мен өзім көп ойландым.
Dialogue: 0,0:41:09.66,0:41:11.79,Default,,0,0,0,,Керемет
Dialogue: 0,0:41:23.53,0:41:25.86,Default,,0,0,0,,Үлкен қорап
Dialogue: 0,0:41:30.13,0:41:31.90,Default,,0,0,0,,Иіс Мен біраз уақыттан бері иіс сезбедім
Dialogue: 0,0:41:33.63,0:41:35.27,Default,,0,0,0,,Бұл жанды музыка өтетін орынның иісі.
Мен
Dialogue: 0,0:41:37.59,0:41:40.03,Default,,0,0,0,,өткім келеді
Dialogue: 0,0:41:40.34,0:41:42.45,Default,,0,0,0,,Бұл мүмкін емес, күшті.
Dialogue: 0,0:41:42.92,0:41:43.73,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:41:43.73,0:41:45.27,Default,,0,0,0,,Бар күшімізді салып, алға ұмтылайық
Dialogue: 0,0:41:47.17,0:41:48.52,Default,,0,0,0,,Менің де барғым келеді
Dialogue: 0,0:41:51.53,0:41:53.42,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:41:55.92,0:41:56.94,Default,,0,0,0,,Угецу-сан
Dialogue: 0,0:41:56.71,0:41:58.30,Default,,0,0,0,,Бір сәт кешіріңіз
Dialogue: 0,0:42:03.55,0:42:04.64,Default,,0,0,0,,Жарайды
Dialogue: 0,0:42:05.95,0:42:06.98,Default,,0,0,0,,Жалғастырыңыз
Dialogue: 0,0:42:34.68,0:42:36.26,Default,,0,0,0,,Әйтеуір анық емес
Dialogue: 0,0:42:37.25,0:42:38.38,Default,,0,0,0,,Жарақат алсаңыз да
Dialogue: 0,0:42:38.97,0:42:41.38,Default,,0,0,0,,Мен бәрі қалпына келеді деп сендім.
Dialogue: 0,0:42:43.01,0:42:44.30,Default,,0,0,0,,Қотыр пайда болды.
Dialogue: 0,0:42:44.77,0:42:46.21,Default,,0,0,0,,Егер ол шықса
Dialogue: 0,0:42:46.82,0:42:48.86,Default,,0,0,0,,Барлығы қалыпқа келе ме?
Dialogue: 0,0:42:49.73,0:42:51.63,Default,,0,0,0,,Қаншалықты жағымсыз болса да
Dialogue: 0,0:42:53.26,0:42:54.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:42:54.80,0:42:56.34,Default,,0,0,0,,Жүрегімнің бір жерінде
Dialogue: 0,0:42:57.89,0:42:59.73,Default,,0,0,0,,Бұл мүлде олай емес.
Dialogue: 0,0:43:02.70,0:43:05.49,Default,,0,0,0,,Кейбір нәрселерді қайтару мүмкін емес.
Dialogue: 0,0:43:07.70,0:43:10.42,Default,,0,0,0,,Егер сіз жалғастырсаңыз, міндетті түрде бірдеңе болады.
Dialogue: 0,0:43:10.91,0:43:12.50,Default,,0,0,0,,біржола өзгертілді
Dialogue: 0,0:43:14.67,0:43:18.31,Default,,0,0,0,,Сіз әлі де өміріңізді әнге арнай аласыз ба?
Dialogue: 0,0:43:19.69,0:43:21.48,Default,,0,0,0,,Сүйген адамыңды жоғалтпа
Dialogue: 0,0:43:22.24,0:43:23.28,Default,,0,0,0,,Өмір бойы
Dialogue: 0,0:43:33.20,0:43:34.43,Default,,0,0,0,,Ол басталады
Dialogue: 0,0:43:38.27,0:43:40.12,Default,,0,0,0,,Қайтып орала алмайтын түн
Dialogue: 0,0:43:44.60,0:43:46.05,Default,,0,0,0,,Ол басталады
Dialogue: 0,0:43:50.93,0:43:52.71,Default,,0,0,0,,Бүгін келгендеріңізге рахмет.
Dialogue: 0,0:43:53.42,0:43:55.90,Default,,0,0,0,,Бұл менің дебюттен кейінгі алғашқы өмірім.
Dialogue: 0,0:43:56.32,0:43:57.90,Default,,0,0,0,,Мен ішкі ағзамды құсып кететін сияқтымын.
Dialogue: 0,0:44:00.43,0:44:02.52,Default,,0,0,0,,Бірақ мен оны асыға күттім.
Dialogue: 0,0:44:03.14,0:44:05.04,Default,,0,0,0,,Барынша дауыстап ойнаңыз
Dialogue: 0,0:44:12.18,0:44:14.37,Default,,0,0,0,,Алдымен мен сізге қысқаша кіріспе айтайын.
Dialogue: 0,0:44:14.79,0:44:17.45,Default,,0,0,0,,Бүгін жаңа гитара қолдауы келеді.
Dialogue: 0,0:44:18.59,0:44:19.77,Default,,0,0,0,,Бұл Уенояма.
Dialogue: 0,0:44:19.93,0:44:21.06,Default,,0,0,0,,Маған қол шапалақтаңыз
Dialogue: 0,0:44:23.57,0:44:24.44,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:44:25.63,0:44:27.53,Default,,0,0,0,,Мен сенен бір нәрсе сұрағаныңды қалаймын.
Dialogue: 0,0:44:27.97,0:44:30.16,Default,,0,0,0,,Мен Мафуйдың менен сұрағанын қалаймын.
Dialogue: 0,0:44:31.67,0:44:32.46,Default,,0,0,0,,Бірақ
Dialogue: 0,0:44:33.02,0:44:34.10,Default,,0,0,0,,Хиираги
Dialogue: 0,0:44:34.98,0:44:36.20,Default,,0,0,0,,Уенояма мырза
Dialogue: 0,0:44:37.41,0:44:39.23,Default,,0,0,0,,Менің тыңдағым келетін ән бар.
Dialogue: 0,0:44:41.66,0:44:42.80,Default,,0,0,0,,Тіке тұру
Dialogue: 0,0:44:43.76,0:44:46.13,Default,,0,0,0,,Сіз екі жаққа да орала алмайсыз.
Dialogue: 0,0:44:47.07,0:44:47.71,Default,,0,0,0,,Егер
Dialogue: 0,0:44:48.21,0:44:48.96,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:44:50.28,0:44:52.79,Default,,0,0,0,,Осы жанды шоу үшін шығарылмаған әндер
Dialogue: 0,0:44:53.59,0:44:54.70,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:44:55.06,0:44:56.08,Default,,0,0,0,,Мен сұрауым керек
Dialogue: 0,0:44:57.10,0:44:57.90,Default,,0,0,0,,Теңізге
Dialogue: 0,0:45:01.98,0:45:07.28,Default,,0,0,0,,«Бір күні мен ұмытамын».
Dialogue: 0,0:45:08.44,0:45:13.76,Default,,0,0,0,,«Өлеңде осылай қалдырайық».
Dialogue: 0,0:45:14.81,0:45:20.49,Default,,0,0,0,,«Мен оны тыныш есте сақтау үшін».
Dialogue: 0,0:45:21.41,0:45:26.62,Default,,0,0,0,,«Осы ән арқылы біз бір-бірімізді кездестіреміз деп үміттенемін».
Dialogue: 0,0:45:28.29,0:45:34.78,Default,,0,0,0,,"Лалала сен"
Dialogue: 0,0:45:34.78,0:45:41.34,Default,,0,0,0,,«Ауызбен ойнайтын әуен».
Dialogue: 0,0:45:41.34,0:45:50.62,Default,,0,0,0,,«Тілектерімізді аманат етейік»
Dialogue: 0,0:45:48.66,0:45:50.62,Default,,0,0,0,,Өтірік айт
Dialogue: 0,0:45:51.58,0:45:53.09,Default,,0,0,0,,Бұл махаббат әні
Dialogue: 0,0:45:53.81,0:45:56.30,Default,,0,0,0,,«Сәлем.»
Dialogue: 0,0:45:56.30,0:46:00.69,Default,,0,0,0,,«Бұл өмірде»
Dialogue: 0,0:46:01.39,0:46:02.77,Default,,0,0,0,,Хор
Dialogue: 0,0:46:00.69,0:46:06.84,Default,,0,0,0,,«Әртүрлі сезімдер кездеседі»
Dialogue: 0,0:46:06.84,0:46:13.77,Default,,0,0,0,,«Толып кетудің мағынасы»
Dialogue: 0,0:46:13.77,0:46:19.78,Default,,0,0,0,,«Көз жасының дәмі маған айтады».
Dialogue: 0,0:46:19.78,0:46:26.69,Default,,0,0,0,,«Қараңдар, жаңбыр қашан жауады?»
Dialogue: 0,0:46:26.69,0:46:32.71,Default,,0,0,0,,«Осы жердің айналасында»
Dialogue: 0,0:46:32.71,0:46:39.84,Default,,0,0,0,,«Қуаныш та, қайғы да»
Dialogue: 0,0:46:39.84,0:46:44.18,Default,,0,0,0,,«Қол ұстасып теңізге»
Dialogue: 0,0:46:55.50,0:47:00.99,Default,,0,0,0,,«Себебі мен сені тастап кетемін».
Dialogue: 0,0:47:02.02,0:47:07.26,Default,,0,0,0,,«Қаншалықты тығыз байланған болса да»
Dialogue: 0,0:47:08.31,0:47:14.17,Default,,0,0,0,,"Мен түсінемін. Бірақ бәрібір."
Dialogue: 0,0:47:14.82,0:47:20.64,Default,,0,0,0,,«Сүйіспеншілік менің жанымда болғысы келеді».
Dialogue: 0,0:47:21.83,0:47:28.29,Default,,0,0,0,,«Менің жүрегім сенікі»
Dialogue: 0,0:47:28.29,0:47:34.82,Default,,0,0,0,,«кішірейту және кеңейту»
Dialogue: 0,0:47:34.82,0:47:45.00,Default,,0,0,0,,«Мені өз сезімдерім тірі қалдырады»
Dialogue: 0,0:47:53.57,0:48:00.15,Default,,0,0,0,,«Қыстың ортасында ғана түсетін тамшылар үшін».
Dialogue: 0,0:48:00.15,0:48:06.64,Default,,0,0,0,,«Сізге бір сәт жарқырауға рұқсат етіңіз».
Dialogue: 0,0:48:06.64,0:48:13.64,Default,,0,0,0,,«Біз шексіз тарихтың бір бұрышында кездестік».
Dialogue: 0,0:48:13.64,0:48:16.98,Default,,0,0,0,,«Ғажайып»
Dialogue: 0,0:48:16.98,0:48:25.46,Default,,0,0,0,,«Есте сақтау»
Dialogue: 0,0:48:26.24,0:48:28.69,Default,,0,0,0,,«Сәлем»
Dialogue: 0,0:48:29.29,0:48:30.55,Default,,0,0,0,,Табылды
Dialogue: 0,0:48:28.69,0:48:33.18,Default,,0,0,0,,«Бұл өмірде»
Dialogue: 0,0:48:31.60,0:48:32.96,Default,,0,0,0,,Жоқ
Dialogue: 0,0:48:33.52,0:48:37.25,Default,,0,0,0,,Юки, мен оны енді ешқашан көрмеймін деп ойладым
Dialogue: 0,0:48:33.18,0:48:39.24,Default,,0,0,0,,«Біз әртүрлі жыл мезгілдерінде кездесеміз»
Dialogue: 0,0:48:39.83,0:48:42.06,Default,,0,0,0,,Осындай шағын өлеңде
Dialogue: 0,0:48:42.53,0:48:43.75,Default,,0,0,0,,өзгеріссіз
Dialogue: 0,0:48:39.24,0:48:46.34,Default,,0,0,0,,«Мен бір нәрсені таптым».
Dialogue: 0,0:48:46.34,0:48:52.26,Default,,0,0,0,,«Менің бүкіл денем бұл есімді атайды».
Dialogue: 0,0:48:54.06,0:48:56.45,Default,,0,0,0,,Мұны қалай айтасыз?
Dialogue: 0,0:48:57.74,0:48:59.56,Default,,0,0,0,,Қытырлақ билетпен
Dialogue: 0,0:48:52.26,0:48:59.14,Default,,0,0,0,,«Қараңдар, жаңбыр қашан жауады?»
Dialogue: 0,0:49:01.54,0:49:03.07,Default,,0,0,0,,Осы уақытқа дейін жасырын
Dialogue: 0,0:48:59.14,0:49:05.17,Default,,0,0,0,,«Осы жердің айналасында»
Dialogue: 0,0:49:03.51,0:49:05.17,Default,,0,0,0,,Осындай жүрекпен
Dialogue: 0,0:49:06.40,0:49:07.64,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:49:08.86,0:49:11.39,Default,,0,0,0,,Мен саған сыйлық бермек болдым.
Dialogue: 0,0:49:05.17,0:49:12.33,Default,,0,0,0,,«Қуаныш та, қайғы да»
Dialogue: 0,0:49:12.33,0:49:16.56,Default,,0,0,0,,«Қол ұстасып теңізге»
Dialogue: 0,0:49:18.81,0:49:23.20,Default,,0,0,0,,«Қол ұстасып теңізге»
Dialogue: 0,0:50:14.11,0:50:15.11,Default,,0,0,0,,2-ән
Dialogue: 0,0:50:16.30,0:50:17.14,Default,,0,0,0,,Әдеттегі
Dialogue: 0,0:50:18.85,0:50:22.53,Default,,0,0,0,,«Маған бұлыңғыр сезімдер керек емес»
Dialogue: 0,0:50:24.19,0:50:28.21,Default,,0,0,0,,«Ортадан тыс»
Dialogue: 0,0:50:22.87,0:50:25.55,Default,,0,0,0,,Бұл не ынта?
Dialogue: 0,0:50:27.12,0:50:28.37,Default,,0,0,0,,Мен ән айтқым келеді
Dialogue: 0,0:50:29.78,0:50:32.58,Default,,0,0,0,,Мен қазір ән айтқым келеді
Dialogue: 0,0:50:34.09,0:50:35.52,Default,,0,0,0,,Тым салқын
Dialogue: 0,0:50:37.55,0:50:40.99,Default,,0,0,0,,Мен неге қазір жоқпын?
Dialogue: 0,0:50:42.26,0:50:44.02,Default,,0,0,0,,Уенояма-кунның қасында
Dialogue: 0,0:50:44.69,0:50:45.95,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:50:47.71,0:50:53.68,Default,,0,0,0,,Иә, бұл не? Мұндай қарапайым нәрсе?
Dialogue: 0,0:50:55.17,0:50:57.02,Default,,0,0,0,,Ол өзгеруі мүмкін.
Dialogue: 0,0:50:57.69,0:50:59.57,Default,,0,0,0,,Мен оны жоғалтып алуым мүмкін.
Dialogue: 0,0:51:00.64,0:51:03.03,Default,,0,0,0,,Өткен немесе болашақ?
Dialogue: 0,0:51:03.85,0:51:06.70,Default,,0,0,0,,Әрқашан кепілдіктер жоқ.
Dialogue: 0,0:51:09.29,0:51:09.97,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:51:11.52,0:51:13.85,Default,,0,0,0,,Әлгі прожектор көзді таң қалдырады
Dialogue: 0,0:51:15.22,0:51:16.05,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:51:16.99,0:51:19.08,Default,,0,0,0,,Мен ол жерде болмағаныма өкінемін.
Dialogue: 0,0:51:22.19,0:51:23.23,Default,,0,0,0,,Музыка
Dialogue: 0,0:51:24.23,0:51:25.94,Default,,0,0,0,,Маған Уенояма-кун ұнайды
Dialogue: 0,0:51:27.28,0:51:30.89,Default,,0,0,0,,Мен де сенің қасыңда тұрғым келеді.
Dialogue: 0,0:51:32.35,0:51:34.86,Default,,0,0,0,,Сайып келгенде, мұның бәрі бар
Dialogue: 0,0:51:35.64,0:51:37.27,Default,,0,0,0,,Жылдар мен онжылдықтар
Dialogue: 0,0:51:37.82,0:51:41.09,Default,,0,0,0,,Дәл солай, мәңгілік
Dialogue: 0,0:51:42.45,0:51:44.93,Default,,0,0,0,,Менің осы сәтке жабысудан басқа амалым жоқ
Dialogue: 0,0:51:47.64,0:51:49.21,Default,,0,0,0,,Аа, қазірдің өзінде
Dialogue: 0,0:51:49.21,0:51:50.85,Default,,0,0,0,,Себебі неде?
Dialogue: 0,0:51:51.31,0:51:52.64,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:51:53.17,0:51:54.64,Default,,0,0,0,,Би
Dialogue: 0,0:51:54.85,0:52:00.22,Default,,0,0,0,,«Еніп кет, бұл дауыс қазір, сол күндердің естеліктерін еске түсір».
Dialogue: 0,0:52:00.22,0:52:05.64,Default,,0,0,0,,«Қағазға не сала алар едің?»
Dialogue: 0,0:52:05.64,0:52:10.93,Default,,0,0,0,,«Гүріл, өшпесін. Бұл Хариботтың үмітінің соңы».
Dialogue: 0,0:52:10.93,0:52:16.91,Default,,0,0,0,,«Мен саған жеткенше ән айтамын».
Dialogue: 0,0:52:44.74,0:52:45.91,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:52:46.86,0:52:48.36,Default,,0,0,0,,Мен мұны осында қалдырамын.
Dialogue: 0,0:52:48.81,0:52:49.73,Default,,0,0,0,,Ааасу
Dialogue: 0,0:52:54.23,0:52:55.75,Default,,0,0,0,,Атсуууу
Dialogue: 0,0:52:59.75,0:53:01.43,Default,,0,0,0,,Қыс ортасы келді.
Dialogue: 0,0:53:05.64,0:53:07.83,Default,,0,0,0,,Бұл оған дұрыс жетті.
Dialogue: 0,0:53:08.22,0:53:09.21,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:53:11.11,0:53:12.82,Default,,0,0,0,,Бұл жүзді көргенім жақсы
Dialogue: 0,0:53:13.98,0:53:14.87,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:53:15.78,0:53:17.77,Default,,0,0,0,,Әлі аяқталмаған жігіт
Dialogue: 0,0:53:18.65,0:53:20.96,Default,,0,0,0,,Мен оны қыс ортасына дұрыс қайтара алдым деп ойлаймын.
Dialogue: 0,0:53:23.32,0:53:24.45,Default,,0,0,0,,Мен аяқтадым
Dialogue: 0,0:53:25.34,0:53:27.53,Default,,0,0,0,,Мен Юки туралы көп білмеймін.
Dialogue: 0,0:53:28.92,0:53:29.74,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:53:30.58,0:53:33.10,Default,,0,0,0,,Маған бұл ән өте ұнады
Dialogue: 0,0:53:34.67,0:53:36.60,Default,,0,0,0,,Сол әнді тапқаныма қуаныштымын
Dialogue: 0,0:53:38.76,0:53:39.66,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:53:46.53,0:53:48.61,Default,,0,0,0,,Хираги мен Гэнджун үшін де
Dialogue: 0,0:53:50.14,0:53:51.01,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:53:51.74,0:53:55.90,Default,,0,0,0,,Біз барлығына дұрыс бағытта қозғалу үшін бәрін жасадық.
Dialogue: 0,0:53:57.30,0:53:58.13,Default,,0,0,0,,Дайын
Dialogue: 0,0:54:00.22,0:54:01.63,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,0:54:02.38,0:54:03.92,Default,,0,0,0,,Бұл дәлелденді.
Dialogue: 0,0:54:06.06,0:54:07.78,Default,,0,0,0,,Мен бұған қазір қанағаттанамын.
Dialogue: 0,0:54:09.82,0:54:11.18,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:54:11.67,0:54:13.30,Default,,0,0,0,,Оны қытырлақтайтын кез келді.
Dialogue: 0,0:54:13.61,0:54:16.82,Default,,0,0,0,,Мүмкін сол үлкен кісілер сәлем беруге келер.
Dialogue: 0,0:54:16.82,0:54:17.69,Default,,0,0,0,,Ааа
Dialogue: 0,0:54:17.96,0:54:20.28,Default,,0,0,0,,Мен тағы 10 минут қозғала алмаймын.
Dialogue: 0,0:54:20.28,0:54:23.12,Default,,0,0,0,,Жаңа ғана дыбыстық сигнал туралы айтқан сіз емес пе едіңіз?
Dialogue: 0,0:54:23.66,0:54:25.82,Default,,0,0,0,,Он минут болды.
Dialogue: 0,0:54:28.23,0:54:31.04,Default,,0,0,0,,Не, енді қыстың ортасы ма?
Dialogue: 0,0:54:32.25,0:54:34.04,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:54:35.32,0:54:36.51,Default,,0,0,0,,Мен ән айтқым келеді
Dialogue: 0,0:54:37.98,0:54:38.89,Default,,0,0,0,,Мен ән айтқым келеді
Dialogue: 0,0:54:40.14,0:54:41.74,Default,,0,0,0,,Мен бірге музыка ойнағым келеді
Dialogue: 0,0:54:42.53,0:54:43.38,Default,,0,0,0,,Менің жаным… Ұйықтар алдында әр түн сайын➡
Dialogue: 0,0:54:46.61,0:54:47.14,Default,,0,0,0,,Иә
Dialogue: 0,0:54:53.20,0:54:53.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:54.41,0:54:55.99,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:54:57.03,0:54:57.88,Default,,0,0,0,,Менің жаным… Ұйықтар алдында әр түн сайын➡
Dialogue: 0,0:54:58.75,0:55:00.37,Default,,0,0,0,,Мен саған ешқашан өкінуге жол бермеймін
Dialogue: 0,0:55:01.26,0:55:01.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:02.21,0:55:03.89,Default,,0,0,0,,Тоқта
Dialogue: 0,0:55:04.10,0:55:08.14,Default,,0,0,0,,Неліктен сіз бұл мектепте кенеттен ұсыныс жасайсыз?
Dialogue: 0,0:55:08.46,0:55:08.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:09.32,0:55:12.61,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:55:14.00,0:55:16.13,Default,,0,0,0,,Белгілі бір жаздың басында
Dialogue: 0,0:55:17.23,0:55:19.26,Default,,0,0,0,,Белгілі бір түн туралы әңгіме
Dialogue: 0,0:55:20.62,0:55:22.50,Default,,0,0,0,,біреудің ерекше
Dialogue: 0,0:55:23.92,0:55:25.44,Default,,0,0,0,,Музыкалық әңгіме
Dialogue: 0,0:55:29.56,0:55:30.40,Default,,0,0,0,,Содан бері
Dialogue: 0,0:55:31.36,0:55:33.38,Default,,0,0,0,,Мидвинтер ән айтқысы келді
Dialogue: 0,0:55:33.79,0:55:37.01,Default,,0,0,0,,Мен ән айтуды таңдағаныма бірнеше ай болды
Dialogue: 0,0:55:41.26,0:55:43.14,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,0:55:44.49,0:55:45.66,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:55:45.86,0:55:48.66,Default,,0,0,0,,А, бірден жазуды бастайық.
Dialogue: 0,0:55:48.92,0:55:50.35,Default,,0,0,0,,бірден
Dialogue: 0,0:55:50.48,0:55:52.30,Default,,0,0,0,,Мен байлауларға қызығамын.
Dialogue: 0,0:55:52.54,0:55:53.66,Default,,0,0,0,,Байланыс
Dialogue: 0,0:55:54.68,0:55:57.38,Default,,0,0,0,,Сол күннен бастап әр күнім ролик болды.
Dialogue: 0,0:55:59.45,0:56:01.01,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:56:01.28,0:56:04.77,Default,,0,0,0,,Ал, кәсіпқой болу ақша табу деген сөз.
Dialogue: 0,0:56:05.04,0:56:05.90,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:56:05.90,0:56:07.08,Default,,0,0,0,,А, жоғары оқу орнына түсесің бе?
Dialogue: 0,0:56:07.48,0:56:08.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:09.60,0:56:11.79,Default,,0,0,0,,Әкем ұнаса, мен университетке түскім келеді.
Dialogue: 0,0:56:12.30,0:56:13.03,Default,,0,0,0,,Ахх
Dialogue: 0,0:56:13.19,0:56:16.50,Default,,0,0,0,,Менің ойымша, мен әлі де музыкамен айналысуды жеткілікті түрде үйрене алмадым.
Dialogue: 0,0:56:16.65,0:56:17.77,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:56:18.04,0:56:21.58,Default,,0,0,0,,Егер сіз жоғары оқу орнына түскіңіз келсе, мектепте оқып жүргенде қалағаныңызды жасай аласыз.
Dialogue: 0,0:56:22.69,0:56:25.52,Default,,0,0,0,,Бастапқыда сіз оны университетке жіберуді жоспарлағансыз, солай ма?
Dialogue: 0,0:56:26.40,0:56:27.50,Default,,0,0,0,,Әрине
Dialogue: 0,0:56:27.81,0:56:30.21,Default,,0,0,0,,Мен анамнан кейін сұрадым.
Dialogue: 0,0:56:32.30,0:56:35.08,Default,,0,0,0,,Не болды? Мен саған киінуге көмектесемін.
Dialogue: 0,0:56:35.32,0:56:36.67,Default,,0,0,0,,Жасайық.
Dialogue: 0,0:56:37.92,0:56:39.88,Default,,0,0,0,,Айналаңыздағы адамдардың көмегіне ие болу
Dialogue: 0,0:56:43.45,0:56:45.94,Default,,0,0,0,,Тығыз кестеде тікелей эфирде орындау
Dialogue: 0,0:56:49.33,0:56:52.44,Default,,0,0,0,,Қыс ортасы бұрынғыдан да музыкалық болды.
Dialogue: 0,0:56:55.34,0:56:57.64,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:56:59.38,0:57:02.64,Default,,0,0,0,,Иә, бұл өте жақсы өмір болды. Иә.
Dialogue: 0,0:57:02.76,0:57:04.16,Default,,0,0,0,,Бұл сыйлық.
Dialogue: 0,0:57:04.35,0:57:05.46,Default,,0,0,0,,Сәлем
Dialogue: 0,0:57:05.80,0:57:07.23,Default,,0,0,0,,Қыс ортасы
Dialogue: 0,0:57:07.57,0:57:10.45,Default,,0,0,0,,Жоғарыда айтылғандар біз бірге болған кезде шоғырланған.
Dialogue: 0,0:57:11.60,0:57:13.09,Default,,0,0,0,,Қой, әуре болмаңыз.
Dialogue: 0,0:57:14.15,0:57:18.08,Default,,0,0,0,,Біз үшін Уенояма-кунды қолдау аяқталды, солай емес пе?
Dialogue: 0,0:57:18.70,0:57:20.56,Default,,0,0,0,,Хиираги енді өзекті емес.
Dialogue: 0,0:57:21.11,0:57:23.46,Default,,0,0,0,,Жоқ, келесі концертке жалға беремін.
Dialogue: 0,0:57:23.46,0:57:24.74,Default,,0,0,0,,Балалар өте тез өседі ғой.
Dialogue: 0,0:57:25.07,0:57:26.83,Default,,0,0,0,,Мен де сол компаниядан рұқсат алдым.
Dialogue: 0,0:57:26.98,0:57:28.00,Default,,0,0,0,,Балалар өте тез өседі ғой.
Dialogue: 0,0:57:28.37,0:57:30.46,Default,,0,0,0,,Сондықтан мен сәлем беруге келдім.
Dialogue: 0,0:57:31.18,0:57:32.77,Default,,0,0,0,,Ендеше біз бірге орындаймыз.
Dialogue: 0,0:57:32.77,0:57:33.48,Default,,0,0,0,,Уф
Dialogue: 0,0:57:33.67,0:57:35.80,Default,,0,0,0,,Сіз қолдау айттыңыз.
Dialogue: 0,0:57:36.21,0:57:37.26,Default,,0,0,0,,Сонымен
Dialogue: 0,0:57:37.92,0:57:39.78,Default,,0,0,0,,Мен сені әлі де қолдаймын.
Dialogue: 0,0:57:40.76,0:57:43.04,Default,,0,0,0,,Біздің тәжірибеміз бұл жігітке қарағанда жақсырақ.
Dialogue: 0,0:57:43.27,0:57:45.58,Default,,0,0,0,,Музыка да сондай жақсы.
Dialogue: 0,0:57:46.51,0:57:47.40,Default,,0,0,0,,Жасайық
Dialogue: 0,0:57:48.04,0:57:49.40,Default,,0,0,0,,Бұл әрине қызық
Dialogue: 0,0:57:55.47,0:57:56.21,Default,,0,0,0,,Мен істеймін
Dialogue: 0,0:57:56.21,0:57:57.62,Default,,0,0,0,,Алдау
Dialogue: 0,0:58:00.06,0:58:04.96,Default,,0,0,0,,Көңіліңіз қалса, оны менен қайтарып алу үшін жақсы музыканы жасай беріңіз.
Dialogue: 0,0:58:09.14,0:58:09.75,Default,,0,0,0,,Тоқта
Dialogue: 0,0:58:09.75,0:58:10.46,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:58:10.87,0:58:13.68,Default,,0,0,0,,Ол Хийрагиге оны жігерлендіру үшін келгісі келді.
Dialogue: 0,0:58:14.07,0:58:15.50,Default,,0,0,0,,Көтермелеу?
Dialogue: 0,0:58:19.06,0:58:19.89,Default,,0,0,0,,Уау
Dialogue: 0,0:58:19.89,0:58:20.90,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:58:21.64,0:58:22.33,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,0:58:22.64,0:58:24.54,Default,,0,0,0,,Е, жоқ, жоқ, мен төлеймін.
Dialogue: 0,0:58:24.79,0:58:26.53,Default,,0,0,0,,Сіз төлеуіңіз керек, солай ма?
Dialogue: 0,0:58:27.14,0:58:30.56,Default,,0,0,0,,Бірақ менімен кеңескеніңіз үшін алғыс айтқым келеді.
Dialogue: 0,0:58:30.90,0:58:32.63,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:58:33.10,0:58:35.15,Default,,0,0,0,,Бұл үшін рахмет.
Dialogue: 0,0:58:36.88,0:58:38.82,Default,,0,0,0,,Олай болса, бұл мереке.
Dialogue: 0,0:58:41.17,0:58:43.39,Default,,0,0,0,,Маған осы CD-нің бір данасын беріңізші.
Dialogue: 0,0:58:46.27,0:58:48.46,Default,,0,0,0,,Ойыңызды өзгертпес бұрын оны алыңыз
Dialogue: 0,0:58:49.34,0:58:50.40,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:58:50.99,0:58:53.82,Default,,0,0,0,,Өйткені ол сатылса мен риза емеспін.
Dialogue: 0,0:58:54.27,0:58:55.95,Default,,0,0,0,,Бұл сіздің бірінші ықшам дискіңіз, солай ма?
Dialogue: 0,0:58:57.02,0:58:59.58,Default,,0,0,0,,Уау, мен де алғым келеді.
Dialogue: 0,0:59:11.47,0:59:14.12,Default,,0,0,0,,«Әлі жоқ»
Dialogue: 0,0:59:15.40,0:59:21.01,Default,,0,0,0,,«Ол шешілмей қалды»
Dialogue: 0,0:59:22.34,0:59:28.54,Default,,0,0,0,,«Көлеңкедегі қар сияқты».
Dialogue: 0,0:59:29.62,0:59:34.93,Default,,0,0,0,,«Мен жүрегімдегі сезіммен өмір сүремін»
Dialogue: 0,0:59:34.93,0:59:39.42,Default,,0,0,0,,«Ей, мен бұл махаббатты қалаймын».
Dialogue: 0,0:59:39.42,0:59:47.12,Default,,0,0,0,,«Қандай сөздерді қолдануым керек?»
Dialogue: 0,0:59:47.12,0:59:54.50,Default,,0,0,0,,«Сіз жасаған барлық нәрсе ертең жоғалады».
Dialogue: 0,0:59:54.52,1:00:01.54,Default,,0,0,0,,«Мәңгілікте серуендеу»
Dialogue: 0,1:00:01.54,1:00:08.70,Default,,0,0,0,,«Қоштаса алмай, бір орында тұрып».
Dialogue: 0,1:00:08.70,1:00:14.46,Default,,0,0,0,,«Менімен бірге»
Dialogue: 0,1:00:18.73,1:00:19.94,Default,,0,0,0,,Менің жинақтағы ақшамнан тек 285 йен ғана қалды!
Dialogue: 0,1:00:20.10,1:00:21.63,Default,,0,0,0,,Мен саған мынаны беремін
Dialogue: 0,1:00:19.13,1:00:21.63,Default,,0,0,0,,«Әлі жоқ»
Dialogue: 0,1:00:22.90,1:00:28.87,Default,,0,0,0,,«Бұзу мүмкін емес заклинание сияқты».
Dialogue: 0,1:00:22.38,1:00:26.34,Default,,0,0,0,,Бір қызығы, Касай-чан мен Сато-кун жақсы сәйкес келеді.
Dialogue: 0,1:00:27.21,1:00:29.66,Default,,0,0,0,,Ерекше мейірімді емес
Dialogue: 0,1:00:29.94,1:00:36.06,Default,,0,0,0,,«Немесе қарғыс сияқты».
Dialogue: 0,1:00:30.09,1:00:31.35,Default,,0,0,0,,Менің ойымша
Dialogue: 0,1:00:32.89,1:00:36.44,Default,,0,0,0,,Бір-бірімізге аздап жау болған шығармыз.
Dialogue: 0,1:00:37.69,1:00:41.26,Default,,0,0,0,,Желдің бағыты осындай болмашы нәрсеге байланысты өзгеруі мүмкін.
Dialogue: 0,1:00:37.20,1:00:42.21,Default,,0,0,0,,«Мен ауыр жүкті арқалап жүрмін».
Dialogue: 0,1:00:42.21,1:00:43.62,Default,,0,0,0,,Адамдар біртүрлі
Dialogue: 0,1:00:44.51,1:00:47.14,Default,,0,0,0,,Бір-бірін жарақаттау немесе соқтығысу
Dialogue: 0,1:00:42.50,1:00:46.86,Default,,0,0,0,,«Эй, мен осы қаладамын».
Dialogue: 0,1:00:47.14,1:00:49.93,Default,,0,0,0,,Арқадан итеру немесе итеру
Dialogue: 0,1:00:50.44,1:00:53.61,Default,,0,0,0,,Бос жалғанған
Dialogue: 0,1:00:46.86,1:00:54.74,Default,,0,0,0,,«Мен қандай ертеңгі күнді іздеуім керек?»
Dialogue: 0,1:00:54.74,1:00:59.00,Default,,0,0,0,,«Ах»
Dialogue: 0,1:01:08.21,1:01:15.31,Default,,0,0,0,,«Аспанда суық көздер қатады».
Dialogue: 0,1:01:15.31,1:01:22.51,Default,,0,0,0,,«Мейірімді болып, құлағанда»
Dialogue: 0,1:01:22.51,1:01:29.64,Default,,0,0,0,,«Алыстағы адаммен бірге болу»
Dialogue: 0,1:01:29.64,1:01:36.15,Default,,0,0,0,,«Оның бәрі бар»
Dialogue: 0,1:01:37.29,1:01:44.76,Default,,0,0,0,,«Сенің бәрі өз пішінін жоғалтса да»
Dialogue: 0,1:01:44.76,1:01:51.76,Default,,0,0,0,,«Сен менің ішімде мәңгі өмір сүресің».
Dialogue: 0,1:01:51.76,1:01:58.87,Default,,0,0,0,,«Менімен қоштаса алмай жүре бастаймын».
Dialogue: 0,1:01:58.87,1:02:04.80,Default,,0,0,0,,«Мәңгілік бірге»
Dialogue: 0,1:02:17.46,1:02:18.16,Default,,0,0,0,,Иә
Dialogue: 0,1:02:19.61,1:02:20.63,Default,,0,0,0,,Жақсы ән екен
Dialogue: 0,1:02:42.32,1:02:43.61,Default,,0,0,0,,Қыс ортасында не болды?
Dialogue: 0,1:02:45.62,1:02:46.57,Default,,0,0,0,,Бармайсың ба?
Dialogue: 0,1:02:49.37,1:02:50.28,Default,,0,0,0,,Бару
Dialogue: 0,1:02:54.59,1:02:56.22,Default,,0,0,0,,Мен осында күтемін.
Dialogue: 0,1:02:58.81,1:03:00.64,Default,,0,0,0,,Асқазанның шұңқырында
Dialogue: 0,1:03:01.87,1:03:03.48,Default,,0,0,0,,Себебі мен сенің әніңді тыңдаймын
Dialogue: 0,1:03:05.15,1:03:06.72,Default,,0,0,0,,Әзірге оны естуге болады.
Dialogue: 0,1:03:10.03,1:03:11.47,Default,,0,0,0,,Айқайлаңдар
Dialogue: 0,1:03:48.51,1:03:49.85,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:03:50.98,1:03:52.66,Default,,0,0,0,,Көптен бері көрмедім, қыс ортасы
Dialogue: 0,1:03:54.93,1:03:56.21,Default,,0,0,0,,Мектеп бітіруіңізбен құттықтаймыз
Dialogue: 0,1:03:56.91,1:03:58.61,Default,,0,0,0,,Рахмет
Dialogue: 0,1:03:59.73,1:04:01.03,Default,,0,0,0,,Сако-чан
Dialogue: 0,1:04:02.01,1:04:03.57,Default,,0,0,0,,Шұлықтар болды
Dialogue: 0,1:04:03.87,1:04:06.01,Default,,0,0,0,,Иә, иә, тез дайындал.
Dialogue: 0,1:04:06.38,1:04:07.30,Default,,0,0,0,,Иә
Dialogue: 0,1:04:08.65,1:04:11.09,Default,,0,0,0,,Бүгінгі рәсім Мен Маширо-чанмен бірге барамын
Dialogue: 0,1:04:12.24,1:04:14.70,Default,,0,0,0,,Сако-сан, тікелей эфирге келіңіз.
Dialogue: 0,1:04:15.49,1:04:17.34,Default,,0,0,0,,Мен оны өте жақсы байқадым.
Dialogue: 0,1:04:17.64,1:04:18.33,Default,,0,0,0,,Жоқ
Dialogue: 0,1:04:18.55,1:04:19.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:19.74,1:04:21.40,Default,,0,0,0,,Мен мұны ән айтып болғаннан кейін түсіндім.
Dialogue: 0,1:04:21.63,1:04:22.85,Default,,0,0,0,,Ах аа
Dialogue: 0,1:04:28.49,1:04:29.62,Default,,0,0,0,,Өкінішті
Dialogue: 0,1:04:30.57,1:04:31.63,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,1:04:33.33,1:04:35.10,Default,,0,0,0,,Мен гитараны итеріп жібердім
Dialogue: 0,1:04:35.73,1:04:36.96,Default,,0,0,0,,Бұл ауыртпалық болды, солай емес пе?
Dialogue: 0,1:04:38.83,1:04:39.46,Default,,0,0,0,,Иә
Dialogue: 0,1:04:41.32,1:04:41.99,Default,,0,0,0,,Бірақ
Dialogue: 0,1:04:43.46,1:04:44.78,Default,,0,0,0,,Сахнада тұру
Dialogue: 0,1:04:45.52,1:04:47.14,Default,,0,0,0,,Тек музыкамен
Dialogue: 0,1:04:48.15,1:04:52.15,Default,,0,0,0,,Осы уақытқа дейін сөзбен айтып жеткізе алмаған көп нәрсені түсіндім.
Dialogue: 0,1:04:53.35,1:04:55.75,Default,,0,0,0,,Менің ойымша, құтқарылған шығармын.
Dialogue: 0,1:04:57.13,1:04:57.81,Default,,0,0,0,,Сонымен
Dialogue: 0,1:04:58.88,1:05:00.12,Default,,0,0,0,,Мен мұны жақсы айта алмаймын, бірақ
Dialogue: 0,1:05:02.18,1:05:03.02,Default,,0,0,0,,Рахмет
Dialogue: 0,1:05:03.46,1:05:04.36,Default,,0,0,0,,Сако-сан
Dialogue: 0,1:05:07.76,1:05:08.98,Default,,0,0,0,,Маған гитараны беріңіз
Dialogue: 0,1:05:09.97,1:05:10.71,Default,,0,0,0,,Рахмет
Dialogue: 0,1:05:16.53,1:05:17.21,Default,,0,0,0,,Жарайды
Dialogue: 0,1:05:17.59,1:05:18.52,Default,,0,0,0,,Келіңіз.
Dialogue: 0,1:05:21.82,1:05:23.33,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,1:05:23.67,1:05:24.18,Default,,0,0,0,,Иә
Dialogue: 0,1:05:24.46,1:05:25.56,Default,,0,0,0,,Рахмет
Dialogue: 0,1:05:27.10,1:05:29.03,Default,,0,0,0,,Балалар, соңында не істедіңдер?
Dialogue: 0,1:05:29.56,1:05:31.67,Default,,0,0,0,,Сізде Uenoyama тобы болады ма?
Dialogue: 0,1:05:31.97,1:05:33.51,Default,,0,0,0,,Мен бәрібір университетке барамын.
Dialogue: 0,1:05:33.84,1:05:35.02,Default,,0,0,0,,Бұл өсімдіктерге де қатысты.
Dialogue: 0,1:05:35.28,1:05:36.24,Default,,0,0,0,,Эй
Dialogue: 0,1:05:36.80,1:05:38.03,Default,,0,0,0,,Итая футболшы болса керек.
Dialogue: 0,1:05:38.23,1:05:38.94,Default,,0,0,0,,Уау
Dialogue: 0,1:05:39.34,1:05:43.06,Default,,0,0,0,,Токиодан кетіп бара жатқанда мен өзімді жалғыз сезінемін.
Dialogue: 0,1:05:43.41,1:05:45.63,Default,,0,0,0,,Фотосуреттерде қорқынышты көрінесіз.
Dialogue: 0,1:05:47.90,1:05:48.72,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,1:05:48.72,1:05:50.82,Default,,0,0,0,,Сіз Сенпай түймешігін аласыз
Dialogue: 0,1:05:50.82,1:05:52.00,Default,,0,0,0,,Сато Сенпай
Dialogue: 0,1:05:52.00,1:05:53.95,Default,,0,0,0,,Сенпай концертке барды
Dialogue: 0,1:05:53.50,1:05:54.37,Default,,0,0,0,,Мен де
Dialogue: 0,1:05:54.12,1:05:55.82,Default,,0,0,0,,Оқуды аяқтамау
Dialogue: 0,1:06:23.84,1:06:24.99,Default,,0,0,0,,Біз де барамыз.
Dialogue: 0,1:06:26.62,1:06:27.25,Default,,0,0,0,,Иә
Dialogue: 0,1:06:46.29,1:06:48.07,Default,,0,0,0,,Самии
Dialogue: 0,1:06:48.89,1:06:50.18,Default,,0,0,0,,Қыс ортасында жақсы ма?
Dialogue: 0,1:06:51.10,1:06:51.90,Default,,0,0,0,,Жоқ
Dialogue: 0,1:07:10.86,1:07:12.80,Default,,0,0,0,,Охххх
Dialogue: 0,1:07:15.70,1:07:17.17,Default,,0,0,0,,Қыс ортасы Бірдеңе жеп қойыңыз
Dialogue: 0,1:07:19.25,1:07:21.33,Default,,0,0,0,,Уенояма-кун бұл қылыш
Dialogue: 0,1:07:21.50,1:07:23.38,Default,,0,0,0,,Ооо
Dialogue: 0,1:07:27.51,1:07:28.02,Default,,0,0,0,,Ах
Dialogue: 0,1:07:28.02,1:07:28.82,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:29.92,1:07:31.23,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:33.77,1:07:35.14,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,1:07:35.65,1:07:36.88,Default,,0,0,0,,Суық, солай емес пе?
Dialogue: 0,1:07:38.03,1:07:38.82,Default,,0,0,0,,Барлығы дүрбелеңде.
Dialogue: 0,1:07:39.45,1:07:41.05,Default,,0,0,0,,Сен оны не үшін жейсің?
Dialogue: 0,1:07:52.44,1:07:54.63,Default,,0,0,0,,Үлкен
Dialogue: 0,1:07:52.44,1:07:54.63,Default,,0,0,0,,Уау
Dialogue: 0,1:08:22.88,1:08:23.87,Default,,0,0,0,,Жақсы, онда
Dialogue: 0,1:08:24.18,1:08:24.89,Default,,0,0,0,,Қазір
Dialogue: 0,1:08:26.29,1:08:26.84,Default,,0,0,0,,Иә
Dialogue: 0,1:08:27.52,1:08:28.79,Default,,0,0,0,,Толық асқазан
Dialogue: 0,1:08:30.07,1:08:32.13,Default,,0,0,0,,Сіз көп жедіңіз.
Dialogue: 0,1:08:40.86,1:08:41.40,Default,,0,0,0,,Ұсыныс
Dialogue: 0,1:08:41.71,1:08:42.25,Default,,0,0,0,,Джотаро Куджо мен оның достары
Dialogue: 0,1:08:42.58,1:08:43.17,Default,,0,0,0,,Не дедің!
Dialogue: 0,1:08:44.10,1:08:45.02,Default,,0,0,0,,Ахххх
Dialogue: 0,1:08:50.33,1:08:52.38,Default,,0,0,0,,Сізді лақтыратын жер іздеңіз
Dialogue: 0,1:08:53.01,1:08:54.13,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:09:12.60,1:09:13.40,Default,,0,0,0,,Франция
Dialogue: 0,1:09:18.79,1:09:19.52,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:09:20.04,1:09:21.85,Default,,0,0,0,,А, сәлем, қыс ортасы
Dialogue: 0,1:09:23.40,1:09:24.21,Default,,0,0,0,,Генки
Dialogue: 0,1:09:26.45,1:09:27.27,Default,,0,0,0,,Угецу-сан
Dialogue: 0,1:09:27.65,1:09:29.50,Default,,0,0,0,,Кенеттен кешіріңіз
Dialogue: 0,1:09:30.04,1:09:33.02,Default,,0,0,0,,Дайындық болса да, мүшелер мүлде жиналмады.
Dialogue: 0,1:09:33.40,1:09:35.29,Default,,0,0,0,,Менің уақытым болғандықтан, қоңырау шалып көрдім.
Dialogue: 0,1:09:36.16,1:09:38.94,Default,,0,0,0,,Ол Нью-Йоркте болды.
Dialogue: 0,1:09:39.44,1:09:41.89,Default,,0,0,0,,Мен кеше өнер көрсетуге келдім.
Dialogue: 0,1:09:42.71,1:09:44.66,Default,,0,0,0,,CD келді.
Dialogue: 0,1:09:45.92,1:09:47.41,Default,,0,0,0,,Маған жібергеніңіз үшін рахмет
Dialogue: 0,1:09:48.75,1:09:49.55,Default,,0,0,0,,Жақсы
Dialogue: 0,1:09:51.55,1:09:54.15,Default,,0,0,0,,Содан бері не болғанын білмеймін.
Dialogue: 0,1:09:55.60,1:09:57.99,Default,,0,0,0,,Музыкамен жалғастырып жатқаныңызға қуаныштымын.
Менің ойымша,
Dialogue: 0,1:09:59.15,1:10:00.91,Default,,0,0,0,,айту керек
Dialogue: 0,1:10:04.58,1:10:06.15,Default,,0,0,0,,Сол кездегі мен айтқан уайым
Dialogue: 0,1:10:06.71,1:10:08.81,Default,,0,0,0,,Бәрі де жоғалып кеткен жоқ.
Dialogue: 0,1:10:10.10,1:10:10.70,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,1:10:11.48,1:10:12.50,Default,,0,0,0,,Жоқ
Dialogue: 0,1:10:13.14,1:10:15.02,Default,,0,0,0,,Мен енді ешқашан көрмеймін деп ойлаған адам
Dialogue: 0,1:10:16.53,1:10:18.90,Default,,0,0,0,,Музыкада қалған бірдеңені таптым
Dialogue: 0,1:10:20.03,1:10:21.04,Default,,0,0,0,,Табылды
Dialogue: 0,1:10:23.13,1:10:24.37,Default,,0,0,0,,анық
Dialogue: 0,1:10:26.73,1:10:27.37,Default,,0,0,0,,Сонымен
Dialogue: 0,1:10:28.16,1:10:29.14,Default,,0,0,0,,Өзімді жалғыз сезінсем де
Dialogue: 0,1:10:29.79,1:10:31.09,Default,,0,0,0,,Біз енді ешқашан кездеспесек те
Dialogue: 0,1:10:31.96,1:10:33.99,Default,,0,0,0,,Енді неден ұтсам да
Dialogue: 0,1:10:35.23,1:10:36.46,Default,,0,0,0,,Музыка болғанша
Dialogue: 0,1:10:37.70,1:10:38.75,Default,,0,0,0,,Бұл жады
Dialogue: 0,1:10:39.45,1:10:42.53,Default,,0,0,0,,Дыбыста қалады деп сендім
Dialogue: 0,1:10:45.61,1:10:47.58,Default,,0,0,0,,Сол себепті мен де музыкадамын
Dialogue: 0,1:10:48.73,1:10:49.98,Default,,0,0,0,,Музыка әлеміне
Dialogue: 0,1:10:51.10,1:10:51.87,Default,,0,0,0,,Менің өмір сүргім келеді
Dialogue: 0,1:10:52.74,1:10:53.34,Default,,0,0,0,,болып табылады
Dialogue: 0,1:10:57.04,1:10:57.80,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:10:59.83,1:11:00.45,Default,,0,0,0,,Кейінірек
Dialogue: 0,1:11:01.21,1:11:03.36,Default,,0,0,0,,Сол кезде Угцудың айтқаны
Dialogue: 0,1:11:03.60,1:11:05.97,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,1:11:06.92,1:11:09.39,Default,,0,0,0,,Музыка ғана қалса екен
Dialogue: 0,1:11:15.75,1:11:17.61,Default,,0,0,0,,Ол кезде мен шынымен түсінбейтінмін.
Dialogue: 0,1:11:19.86,1:11:20.66,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,1:11:21.17,1:11:24.74,Default,,0,0,0,,Угецу-санның айтқысы келгені осы ма?
Dialogue: 0,1:11:25.76,1:11:26.75,Default,,0,0,0,,Ал сендерге келсек, капитан Леви міндетті түрде
Dialogue: 0,1:11:27.90,1:11:31.70,Default,,0,0,0,,Менің ойымша, Угецу да музыкада қалады.
Dialogue: 0,1:11:33.13,1:11:36.48,Default,,0,0,0,,Музыка да солай екені сөзсіз.
Dialogue: 0,1:11:41.69,1:11:42.48,Default,,0,0,0,,Рахмет
Dialogue: 0,1:12:02.94,1:12:03.65,Default,,0,0,0,,Қыс ортасы
Dialogue: 0,1:12:05.57,1:12:08.12,Default,,0,0,0,,Кофе немесе латте алғыңыз келе ме?
Dialogue: 0,1:12:10.77,1:12:11.20,Default,,0,0,0,,Эй
Dialogue: 0,1:12:12.21,1:12:12.79,Default,,0,0,0,,Қыс ортасы
Dialogue: 0,1:12:25.16,1:12:26.76,Default,,0,0,0,,Мүмкін
Dialogue: 0,1:12:27.85,1:12:30.50,Default,,0,0,0,,Мен бұл сәтті ұмытып бара жатырмын
Dialogue: 0,1:12:33.58,1:12:34.15,Default,,0,0,0,,Сонымен
Dialogue: 0,1:12:35.65,1:12:37.49,Default,,0,0,0,,Музыканы жалғастырыңыз
Dialogue: 0,1:12:39.44,1:12:40.15,Default,,0,0,0,,Кафе латте
Dialogue: 0,1:12:41.01,1:12:41.81,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,1:12:43.07,1:12:43.73,Default,,0,0,0,,Рахмет
Dialogue: 0,1:13:00.40,1:13:01.32,Default,,0,0,0,,Ах
Dialogue: 0,1:13:01.98,1:13:03.30,Default,,0,0,0,,Мен келмеймін.
Dialogue: 0,1:13:11.29,1:13:12.83,Default,,0,0,0,,Өте жылы
Dialogue: 0,1:13:15.75,1:13:17.37,Default,,0,0,0,,Мен сені оятқым келмейді.
Dialogue: 0,1:13:36.26,1:13:37.49,Default,,0,0,0,,Әрқашан
Dialogue: 0,1:13:38.70,1:13:40.25,Default,,0,0,0,,Осылай қалса екен.
Dialogue: 0,1:13:45.43,1:13:46.32,Default,,0,0,0,,Уенояма-кун
Dialogue: 0,1:13:51.52,1:13:52.70,Default,,0,0,0,,Арманым үшін.
Dialogue: 0,1:13:55.06,1:13:55.75,Default,,0,0,0,,Нашар
Dialogue: 0,1:13:56.17,1:13:57.51,Default,,0,0,0,,Мен көп ұйықтадым
Dialogue: 0,1:14:02.00,1:14:03.63,Default,,0,0,0,,Сәлем
Dialogue: 0,1:14:04.38,1:14:05.14,Default,,0,0,0,,Иә
Dialogue: 0,1:14:08.35,1:14:10.37,Default,,0,0,0,,Қайтып келгенде жыныстық қатынасқа түсеміз бе?
Dialogue: 0,1:14:13.22,1:14:13.70,Default,,0,0,0,,Ха
Dialogue: 0,1:14:14.92,1:14:16.28,Default,,0,0,0,,Еееееееее
Dialogue: 0,1:14:35.27,1:14:38.38,Default,,0,0,0,,Ей, ұмытпа
Dialogue: 0,1:14:38.38,1:14:41.50,Default,,0,0,0,,Ей, ұмытпа
Dialogue: 0,1:14:41.50,1:14:44.50,Default,,0,0,0,,Мен осында болдым
Dialogue: 0,1:14:44.50,1:14:47.65,Default,,0,0,0,,Дұрыс өмір сүру
Dialogue: 0,1:14:47.65,1:14:50.69,Default,,0,0,0,,Мен өлемін
Dialogue: 0,1:14:50.69,1:14:53.77,Default,,0,0,0,,Мен бір күні өлемін
Dialogue: 0,1:14:53.77,1:14:56.84,Default,,0,0,0,,Ұмытпасаңыз
Dialogue: 0,1:14:56.84,1:15:01.73,Default,,0,0,0,,Өйткені ол жоғалып кетпейді деп ойлаймын
Dialogue: 0,1:15:24.30,1:15:26.66,Default,,0,0,0,,Эй, мен әрқашан осындамын.
Dialogue: 0,1:15:26.66,1:15:32.75,Default,,0,0,0,,Жоғалып кетсем де жарайды
Dialogue: 0,1:15:33.52,1:15:36.62,Default,,0,0,0,,Мен сізге айтқым келеді
Dialogue: 0,1:15:36.62,1:15:43.58,Default,,0,0,0,,Менімен танысқаныңызға көп рахмет.
Dialogue: 0,1:15:43.58,1:15:45.11,Default,,0,0,0,,Рахмет
Dialogue: 0,1:15:45.85,1:15:50.45,Default,,0,0,0,,Мен сені кездестіргеніме қуаныштымын
Dialogue: 0,1:15:55.36,1:15:58.36,Default,,0,0,0,,Ей, ұмытпа
Dialogue: 0,1:15:58.36,1:16:01.48,Default,,0,0,0,,Ей, ұмытпа
Dialogue: 0,1:16:01.48,1:16:04.50,Default,,0,0,0,,Мен осында болдым
Dialogue: 0,1:16:04.50,1:16:07.64,Default,,0,0,0,,Дұрыс өмір сүру
Dialogue: 0,1:16:07.64,1:16:10.63,Default,,0,0,0,,Мен өлемін
Dialogue: 0,1:16:10.63,1:16:13.79,Default,,0,0,0,,Бір күні өлсем де
Dialogue: 0,1:16:13.79,1:16:16.83,Default,,0,0,0,,Ұмытпасаңыз
Dialogue: 0,1:16:16.83,1:16:21.25,Default,,0,0,0,,Өйткені ол жоғалып кетпейді деп ойлаймын
Dialogue: 0,1:16:22.75,1:16:25.32,Default,,0,0,0,,Сенсіз
Dialogue: 0,1:16:25.32,1:16:29.81,Default,,0,0,0,,Мен шынында да ақымақпын
Dialogue: 0,1:16:29.81,1:16:31.16,Default,,0,0,0,,Жалғыз
Dialogue: 0,1:16:31.92,1:16:35.09,Default,,0,0,0,,Мен өмір сүре алмаймын
Dialogue: 0,1:16:35.09,1:16:37.60,Default,,0,0,0,,Кем дегенде
Dialogue: 0,1:16:37.60,1:16:42.04,Default,,0,0,0,,Осы өлең арқылы жеткізгім келеді
Dialogue: 0,1:16:42.04,1:16:43.40,Default,,0,0,0,,Рахмет
Dialogue: 0,1:16:44.30,1:16:49.97,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:17:12.16,1:17:18.26,Default,,0,0,0,,Қош болмасқа амалым жоқ
Dialogue: 0,1:17:18.26,1:17:24.48,Default,,0,0,0,,болдырмауға болмайды
Dialogue: 0,1:17:23.90,1:17:29.94,Default,,0,0,0,,Сондықтан біз
Dialogue: 0,1:17:29.94,1:17:36.04,Default,,0,0,0,,Жүрегімізде әрқашан жалған болайық
Dialogue: 0,1:17:36.04,1:17:40.04,Default,,0,0,0,,Ах
Dialogue: 0,1:18:07.63,1:18:10.70,Default,,0,0,0,,Ей, ұмытпа
Dialogue: 0,1:18:10.70,1:18:13.80,Default,,0,0,0,,Ей, ұмытпа
Dialogue: 0,1:18:13.80,1:18:16.80,Default,,0,0,0,,Бұл менің сөздерім
Dialogue: 0,1:18:16.80,1:18:19.90,Default,,0,0,0,,Менің дауысым, менің өмірім
Dialogue: 0,1:18:19.90,1:18:22.99,Default,,0,0,0,,Себебі мен ұмытпаймын
Dialogue: 0,1:18:22.99,1:18:25.99,Default,,0,0,0,,Кездесу кереметі
Dialogue: 0,1:18:25.99,1:18:32.26,Default,,0,0,0,,Біздің өміріміздің соңында аяқталатын жұмбақ
Dialogue: 0,1:18:32.26,1:18:35.26,Default,,0,0,0,,Ей, мен ұмытпаймын.
Dialogue: 0,1:18:35.26,1:18:38.33,Default,,0,0,0,,Ей, ұмытпа
Dialogue: 0,1:18:38.33,1:18:41.45,Default,,0,0,0,,Екеуі де осында болды.
Dialogue: 0,1:18:41.45,1:18:44.56,Default,,0,0,0,,Сүйу және сүйікті болу
Dialogue: 0,1:18:44.56,1:18:47.63,Default,,0,0,0,,Мен бір күні өлемін
Dialogue: 0,1:18:47.63,1:18:50.71,Default,,0,0,0,,Біз өлетін болсақ та
Dialogue: 0,1:18:50.71,1:18:53.61,Default,,0,0,0,,Осы әнді айтсаң
Dialogue: 0,1:18:53.61,1:18:58.44,Default,,0,0,0,,Өйткені бұл менің дәлелім
Dialogue: 0,1:19:06.07,1:19:11.01,Default,,0,0,0,,Өйткені бұл сіз бен менің дәлелім
Dialogue: 0,1:19:36.65,1:19:41.27,Default,,0,0,0,,Осы әнді ұмытпасаңыз
Dialogue: 0,1:19:42.04,1:19:46.75,Default,,0,0,0,,Біз әрқашан бірге боламыз
Dialogue: 0,1:19:47.57,1:19:50.16,Default,,0,0,0,,Сонымен
