Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.29,0:00:09.25,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:09.34,0:00:14.34,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:17.39,0:00:22.39,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:32.40,0:00:36.82,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:39.83,0:00:42.08,Default,,0,0,0,,Мм... иә?
Dialogue: 0,0:00:44.33,0:00:45.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:47.29,0:00:48.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:53.26,0:00:54.67,Default,,0,0,0,,Сіз жұмысқа барасыз ба?
Dialogue: 0,0:00:54.76,0:00:55.59,Default,,0,0,0,,Бір!
Dialogue: 0,0:01:16.49,0:01:20.41,Default,,0,0,0,,Ағаш кесу айына 60 000 иен табады.
Dialogue: 0,0:01:20.99,0:01:25.66,Default,,0,0,0,,Мен өткен күні сатқан бүйректерімнің құны 1,2 миллион иен болды.
Dialogue: 0,0:01:26.29,0:01:29.42,Default,,0,0,0,,Оң көз 300 000 иен
Dialogue: 0,0:01:30.09,0:01:31.67,Default,,0,0,0,,Алтын шарлардың бірін сат...
Dialogue: 0,0:01:32.75,0:01:35.05,Default,,0,0,0,,Ол қаншаға сатылды?
Dialogue: 0,0:01:35.13,0:01:37.43,Default,,0,0,0,,100 000-нан аз емес пе еді?
Dialogue: 0,0:01:40.39,0:01:42.81,Default,,0,0,0,,Қалған қарыз...
Dialogue: 0,0:01:43.60,0:01:45.81,Default,,0,0,0,,38,04 миллион иен
Dialogue: 0,0:01:46.48,0:01:47.35,Default,,0,0,0,,Бір!
Dialogue: 0,0:01:48.52,0:01:49.94,Default,,0,0,0,,Ой...
Dialogue: 0,0:01:50.02,0:01:53.07,Default,,0,0,0,,Почита, мен білемін.
Dialogue: 0,0:01:53.15,0:01:55.19,Default,,0,0,0,,Мен оны өлтіруім керек пе?
Dialogue: 0,0:01:55.99,0:02:00.66,Default,,0,0,0,,Егер сіз бір жынды өлтірсеңіз, бұл сізге шамамен 300 000 иен тұрады.
Dialogue: 0,0:02:00.74,0:02:02.37,Default,,0,0,0,,(сымның тартылған дыбысы)
Dialogue: 0,0:02:04.41,0:02:07.66,Default,,0,0,0,,Ақыр соңында, Ібіліс аңшысы ең тиімдісі.
Dialogue: 0,0:02:13.09,0:02:14.92,Default,,0,0,0,,Хи хи
Dialogue: 0,0:02:15.00,0:02:20.05,Default,,0,0,0,,♪～
Dialogue: 0,0:03:36.75,0:03:41.76,Default,,0,0,0,,～♪
Dialogue: 0,0:03:50.77,0:03:51.85,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:52.69,0:03:55.19,Default,,0,0,0,,Бұл қызанақ шайтаны.
Dialogue: 0,0:03:55.27,0:03:58.78,Default,,0,0,0,,Ол тұқымнан тіріледі, сондықтан оны өртеп жіберіңіз.
Dialogue: 0,0:03:58.86,0:04:00.94,Default,,0,0,0,,Жарайсың Денжи
Dialogue: 0,0:04:01.03,0:04:03.36,Default,,0,0,0,,Мына жігіттің мәйітін қара базарға сат.
Dialogue: 0,0:04:03.45,0:04:05.45,Default,,0,0,0,,Өте жақсы баға
Dialogue: 0,0:04:05.53,0:04:07.08,Default,,0,0,0,,Сыйақы – 400 000.
Dialogue: 0,0:04:07.16,0:04:08.33,Default,,0,0,0,,Мен қызғанамын.
Dialogue: 0,0:04:08.41,0:04:11.58,Default,,0,0,0,,Бұл қарыз бен пайызды шегергеннен кейін 170 000.
Dialogue: 0,0:04:11.66,0:04:16.50,Default,,0,0,0,,Сонымен қатар, брокерлік алымдар және әкімшілік алымдар Әкімшілік реттеу үшін алымдар
Dialogue: 0,0:04:16.58,0:04:19.09,Default,,0,0,0,,Қалғанын қоспағанда...
Dialogue: 0,0:04:19.88,0:04:21.59,Default,,0,0,0,,70 000 қалды
Dialogue: 0,0:04:22.22,0:04:28.85,Default,,0,0,0,,Осы 70 000 иенді су ақысын төлеуге және басқа қарыздарды төлеуге пайдалансаңыз...
Dialogue: 0,0:04:29.47,0:04:30.85,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:04:31.60,0:04:34.35,Default,,0,0,0,,Бар болғаны 1800 иен қалды.
Dialogue: 0,0:04:34.98,0:04:37.06,Default,,0,0,0,,Мен үйде ештеңе жей алмаймын
Dialogue: 0,0:04:37.15,0:04:41.11,Default,,0,0,0,,Мен осы айда осы ақшаға өмір сүруім керек...
Dialogue: 0,0:04:41.19,0:04:45.41,Default,,0,0,0,,Почита Бүгінгі ас – бір үзім нан.
Dialogue: 0,0:04:51.58,0:04:55.00,Default,,0,0,0,,Неге мұндай баланы шайтан аулаушы етіп жалдап жатырсың?
Dialogue: 0,0:04:55.67,0:04:59.13,Default,,0,0,0,,Сіз бізге қарызыңызды өтеуге мәжбүрлеп жатырсыз.
Dialogue: 0,0:04:59.21,0:05:02.88,Default,,0,0,0,,Дәлірек айтсақ, бұл оның өлген қарт адамы.
Dialogue: 0,0:05:02.96,0:05:04.72,Default,,0,0,0,,Ібіліс ұстағанға
Dialogue: 0,0:05:04.80,0:05:07.26,Default,,0,0,0,,Сіз шайтан аңшысы боласыз ба?
Dialogue: 0,0:05:07.34,0:05:10.47,Default,,0,0,0,,Дұрыс шайтан аулаушы
Dialogue: 0,0:05:10.56,0:05:14.77,Default,,0,0,0,,Бізге якудза шайтанның мәйітін жууға жол берме.
Dialogue: 0,0:05:15.35,0:05:19.27,Default,,0,0,0,,Сонымен қатар, Дэнджидің жақсы жағы ол сізге қарсы шықпайды.
Dialogue: 0,0:05:24.65,0:05:26.11,Default,,0,0,0,,Эй ит!
Dialogue: 0,0:05:26.20,0:05:27.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:27.11,0:05:29.91,Default,,0,0,0,,Мына темекіні жесең, мен саған 100 иен төлеймін.
Dialogue: 0,0:05:29.99,0:05:31.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:33.12,0:05:35.96,Default,,0,0,0,,Шынайы ма? Итадакимасу
Dialogue: 0,0:05:37.83,0:05:38.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:38.75,0:05:40.04,Default,,0,0,0,,(Дэнджидің жұтыну дыбысы)
Dialogue: 0,0:05:40.13,0:05:41.79,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:05:41.88,0:05:46.80,Default,,0,0,0,,Егер шайтан тағы пайда болса, мен сені шақырамын. Қашып кетсе, шошқаға жем болады.
Dialogue: 0,0:05:46.88,0:05:48.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:54.02,0:05:55.56,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:05:58.10,0:05:58.94,Default,,0,0,0,,Ставка
Dialogue: 0,0:06:03.19,0:06:05.11,Default,,0,0,0,,Бұл маған 3 күнге жетеді.
Dialogue: 0,0:06:05.19,0:06:06.03,Default,,0,0,0,,Бір!
Dialogue: 0,0:06:08.28,0:06:10.45,Default,,0,0,0,,Мен оны басқа күні естідім.
Dialogue: 0,0:06:10.53,0:06:14.45,Default,,0,0,0,,Адамдар әдетте нанды джемі бар жейді.
Dialogue: 0,0:06:15.04,0:06:18.83,Default,,0,0,0,,Жарайды, біз үшін қалыпты болу тек арман.
Dialogue: 0,0:06:19.42,0:06:22.71,Default,,0,0,0,,Мен өлгенше қарызымды өтей алмайтын сияқтымын.
Dialogue: 0,0:06:26.46,0:06:30.22,Default,,0,0,0,,Мен өлгенше әйелмен жүре алмайтын шығармын.
Dialogue: 0,0:06:30.30,0:06:33.93,Default,,0,0,0,,Тозығы жеткен үйшіктегі әйелді бұлай деуге болмайды.
Dialogue: 0,0:06:34.01,0:06:35.85,Default,,0,0,0,,Кездесуге баратын ақшам жоқ
Dialogue: 0,0:06:35.93,0:06:37.60,Default,,0,0,0,,Кун...
Dialogue: 0,0:06:40.98,0:06:45.94,Default,,0,0,0,,Егер арманым орындалатын болса, Өлмес бұрын сені құшақтай алар едім.
Dialogue: 0,0:07:01.42,0:07:05.84,Default,,0,0,0,,Ол осы айдың ақысын төлегенше асылып өлді.
Dialogue: 0,0:07:05.92,0:07:09.59,Default,,0,0,0,,Ғаки бег, денеңді сат
Dialogue: 0,0:07:09.67,0:07:12.34,Default,,0,0,0,,Ертеңге дейін 700 000 дайында.
Dialogue: 0,0:07:13.09,0:07:16.60,Default,,0,0,0,,Әйтпесе, мәйігіңді бөлшектеп, сатамын.
Dialogue: 0,0:07:24.23,0:07:27.90,Default,,0,0,0,,(Араның дыбысы)
Dialogue: 0,0:07:27.98,0:07:30.36,Default,,0,0,0,,Иә? Уууу...
Dialogue: 0,0:07:31.03,0:07:32.36,Default,,0,0,0,,Че... аралау!?
Dialogue: 0,0:07:32.45,0:07:33.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:36.12,0:07:38.54,Default,,0,0,0,,Ой... бұл шайтан.
Dialogue: 0,0:07:40.16,0:07:42.71,Default,,0,0,0,,Мені өлтіргің келсе, өлтір.
Dialogue: 0,0:07:42.79,0:07:44.29,Default,,0,0,0,,Мен бәрібір өлемін
Dialogue: 0,0:07:44.38,0:07:49.38,Default,,0,0,0,,Ха… ха ха…
Dialogue: 0,0:07:49.46,0:07:52.84,Default,,0,0,0,,Хмм... Ха ха...
Dialogue: 0,0:07:52.93,0:07:54.05,Default,,0,0,0,,Оңтүстік-оңтүстік-шығыс!
Dialogue: 0,0:07:55.64,0:07:57.56,Default,,0,0,0,,Сен де өлесің бе?
Dialogue: 0,0:07:57.64,0:08:00.56,Default,,0,0,0,,А... ха...
Dialogue: 0,0:08:00.64,0:08:02.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:02.69,0:08:03.73,Default,,0,0,0,,Га
Dialogue: 0,0:08:03.81,0:08:04.98,Default,,0,0,0,,Шайнаңыз!
Dialogue: 0,0:08:05.06,0:08:08.86,Default,,0,0,0,,Мен жындарды қан ішу арқылы емдейтінін естідім.
Dialogue: 0,0:08:08.94,0:08:11.32,Default,,0,0,0,,Өлгің келмесе, тістеп ал.
Dialogue: 0,0:08:12.45,0:08:14.49,Default,,0,0,0,,Осы шөлдеген таулардың тереңінде—
Dialogue: 0,0:08:21.95,0:08:23.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:23.79,0:08:26.21,Default,,0,0,0,,Менің қаным бос емес
Dialogue: 0,0:08:26.29,0:08:27.88,Default,,0,0,0,,Бұл келісім-шарт
Dialogue: 0,0:08:28.54,0:08:32.38,Default,,0,0,0,,Мен саған көмектесемін, сен маған көмектес.
Dialogue: 0,0:08:35.13,0:08:38.55,Default,,0,0,0,,Менің де өлгім келмейді.
Dialogue: 0,0:08:44.60,0:08:50.15,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:51.73,0:08:55.91,Default,,0,0,0,,Мені шайтан аулаушы етіп жұмысқа аласың ба?
Dialogue: 0,0:09:03.37,0:09:05.41,Default,,0,0,0,,Менің қарным ашты, ұйықтай алмаймын
Dialogue: 0,0:09:05.50,0:09:10.00,Default,,0,0,0,,Қарызды ойлап ұйықтай алмаймын, одан да ұйықтай алмаймын.
Dialogue: 0,0:09:12.76,0:09:15.80,Default,,0,0,0,,Бүгін ұйықтасам түс көремін деп шештім.
Dialogue: 0,0:09:16.38,0:09:19.97,Default,,0,0,0,,Бір үзім нанға варенье жағып, жеп қойыңыз.
Dialogue: 0,0:09:20.05,0:09:22.52,Default,,0,0,0,,Әйелмен сырласу
Dialogue: 0,0:09:22.60,0:09:26.19,Default,,0,0,0,,Бөлмеде бірге ойын ойнап, ұстап тұрып ұйықтайық.
Dialogue: 0,0:09:27.60,0:09:28.44,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:29.11,0:09:29.94,Default,,0,0,0,,Wahoo
Dialogue: 0,0:09:31.86,0:09:32.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:32.78,0:09:34.07,Default,,0,0,0,,(Дэндзидің жөтелі)
Dialogue: 0,0:09:34.69,0:09:40.07,Default,,0,0,0,,Ха ха... ха...
Dialogue: 0,0:09:41.08,0:09:42.33,Default,,0,0,0,,Ха...
Dialogue: 0,0:09:42.41,0:09:43.37,Default,,0,0,0,,Уау!?
Dialogue: 0,0:09:44.79,0:09:46.75,Default,,0,0,0,,Менің анам
Dialogue: 0,0:09:46.83,0:09:50.25,Default,,0,0,0,,Жүрек ауруынан, қан құсудан қайтыс болды.
Dialogue: 0,0:09:52.96,0:09:56.88,Default,,0,0,0,,Дэнжи Шайтан жұмысқа келді.
Dialogue: 0,0:09:58.43,0:09:59.76,Default,,0,0,0,,Я...
Dialogue: 0,0:10:15.44,0:10:19.61,Default,,0,0,0,,Тым болмаса арманым болса екен.
Dialogue: 0,0:10:45.35,0:10:47.68,Default,,0,0,0,,Осындай жерде шайтан пайда болды ма?
Dialogue: 0,0:10:52.31,0:10:54.19,Default,,0,0,0,,Мен оны таба алмаймын...
Dialogue: 0,0:10:54.77,0:10:56.94,Default,,0,0,0,,Сіз бір жерде жасырынып жүрсіз бе?
Dialogue: 0,0:10:57.65,0:11:00.95,Default,,0,0,0,,О, мүмкін ол үйіне кетіп қалған шығар?
Dialogue: 0,0:11:03.53,0:11:04.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:08.29,0:11:09.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:12.29,0:11:17.46,Default,,0,0,0,,Дэнджи, біз сізге ризамыз.
Dialogue: 0,0:11:17.55,0:11:19.59,Default,,0,0,0,,Не? иә
Dialogue: 0,0:11:19.67,0:11:25.97,Default,,0,0,0,,Ит итке бағынады, ит аз жалақыға жұмыс істейді.
Dialogue: 0,0:11:26.06,0:11:27.22,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:27.97,0:11:30.85,Default,,0,0,0,,Бірақ мен иттерді ұнатпаймын, өйткені олардың иісі жағымсыз.
Dialogue: 0,0:11:30.94,0:11:32.44,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:11:33.65,0:11:34.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:38.94,0:11:40.11,Default,,0,0,0,,Гухе
Dialogue: 0,0:11:40.86,0:11:41.86,Default,,0,0,0,,Шашылыңдар!
Dialogue: 0,0:11:43.78,0:11:46.37,Default,,0,0,0,,Біз де якудзамыз.
Dialogue: 0,0:11:46.45,0:11:50.37,Default,,0,0,0,,Күшті болыңыз және көбірек ақша табыңыз.
Dialogue: 0,0:11:50.45,0:11:55.00,Default,,0,0,0,,Мен шайтанмен мәміле жасауды шештім.
Dialogue: 0,0:11:55.58,0:11:57.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:57.09,0:12:01.26,Default,,0,0,0,,Біз қалайтынымыз – шайтанның күші
Dialogue: 0,0:12:01.34,0:12:05.26,Default,,0,0,0,,Менің қалағаным – Ібіліс аңшысы—
Dialogue: 0,0:12:05.34,0:12:06.76,Default,,0,0,0,,Өлім!
Dialogue: 0,0:12:06.85,0:12:08.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:08.10,0:12:10.56,Default,,0,0,0,,Ібіліс аңшысы
Dialogue: 0,0:12:10.64,0:12:14.15,Default,,0,0,0,,Шынымды айтсам, бұл балалар ақымақ, сондай ақымақ.
Dialogue: 0,0:12:14.23,0:12:14.73,Default,,0,0,0,,(зомбилердің ыңырануы)
Dialogue: 0,0:12:14.73,0:12:17.40,Default,,0,0,0,,Саған шайтанның күшін берсем
Dialogue: 0,0:12:14.73,0:12:17.40,Default,,0,0,0,,(зомбилердің ыңырануы)
Dialogue: 0,0:12:17.40,0:12:17.48,Default,,0,0,0,,(зомбилердің ыңырануы)
Dialogue: 0,0:12:17.48,0:12:19.23,Default,,0,0,0,,Менің құлым болма.
Dialogue: 0,0:12:17.48,0:12:19.23,Default,,0,0,0,,(зомбилердің ыңырануы)
Dialogue: 0,0:12:19.23,0:12:21.15,Default,,0,0,0,,Менің құлым болма.
Dialogue: 0,0:12:21.24,0:12:24.53,Default,,0,0,0,,Бұл күш сізді зомбиге айналдырады.
Dialogue: 0,0:12:24.61,0:12:27.16,Default,,0,0,0,,Өйткені мен зомби шайтанмын
Dialogue: 0,0:12:27.24,0:12:28.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:28.24,0:12:31.91,Default,,0,0,0,,Мен шайтан аңшыларын жек көремін, өйткені олар бізді жындарды өлтіреді.
Dialogue: 0,0:12:32.00,0:12:34.42,Default,,0,0,0,,Сондықтан мен сені өлтіремін
Dialogue: 0,0:12:34.50,0:12:35.79,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:35.88,0:12:38.79,Default,,0,0,0,,Барлығыңыз, бұл нәрсені жыртыңыз -
Dialogue: 0,0:12:38.88,0:12:40.21,Default,,0,0,0,,Оны тек қоқыс жәшігіне тастаңыз
Dialogue: 0,0:12:40.21,0:12:41.42,Default,,0,0,0,,Оны тек қоқыс жәшігіне тастаңыз
Dialogue: 0,0:12:40.21,0:12:41.42,Default,,0,0,0,,Дио…
Dialogue: 0,0:12:42.21,0:12:44.72,Default,,0,0,0,,Боқта ха ха...
Dialogue: 0,0:12:44.80,0:12:45.93,Default,,0,0,0,,Уф
Dialogue: 0,0:12:46.43,0:12:48.68,Default,,0,0,0,,(Зомбилердің ыңырсыуы)
Dialogue: 0,0:12:48.76,0:12:52.68,Default,,0,0,0,,(Дэндзидің жөтелі)
Dialogue: 0,0:12:52.77,0:12:58.98,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:12:59.06,0:13:00.07,Default,,0,0,0,,Шығу ...
Dialogue: 0,0:13:00.15,0:13:01.82,Default,,0,0,0,,Хаха...
Dialogue: 0,0:13:01.90,0:13:02.94,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:03.03,0:13:04.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:05.74,0:13:10.41,Default,,0,0,0,,(Зомбилердің ыңырсыуы)
Dialogue: 0,0:13:10.49,0:13:11.91,Default,,0,0,0,,Хаха...
Dialogue: 0,0:13:11.99,0:13:13.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:14.04,0:13:16.04,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:13:16.12,0:13:18.04,Default,,0,0,0,,Қарғыс атсын, кетсін!
Dialogue: 0,0:13:18.13,0:13:19.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:21.46,0:13:22.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:23.01,0:13:25.17,Default,,0,0,0,,Дүрс!
Dialogue: 0,0:13:25.17,0:13:26.30,Default,,0,0,0,,Дүрс!
Dialogue: 0,0:13:25.17,0:13:26.30,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:13:26.30,0:13:26.38,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:13:26.38,0:13:29.55,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:26.38,0:13:29.55,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:13:29.64,0:13:30.55,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:13:30.55,0:13:33.93,Default,,0,0,0,,Мен бай болғым келмейді.
Dialogue: 0,0:13:30.55,0:13:33.93,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:13:33.93,0:13:34.60,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:13:34.60,0:13:36.60,Default,,0,0,0,,Мен ең болмағанда қалыпты өмір сүргім келеді.
Dialogue: 0,0:13:34.60,0:13:36.60,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:13:36.60,0:13:38.35,Default,,0,0,0,,Мен ең болмағанда қалыпты өмір сүргім келеді.
Dialogue: 0,0:13:39.27,0:13:42.82,Default,,0,0,0,,Сіз осындай нәрсені жүзеге асыра алмайсыз ба?
Dialogue: 0,0:13:43.53,0:13:50.49,Default,,0,0,0,,...
Dialogue: 0,0:14:17.77,0:14:18.81,Default,,0,0,0,,(Почита жұтынған дыбыс)
Dialogue: 0,0:14:23.23,0:14:24.19,Default,,0,0,0,,…Чита
Dialogue: 0,0:14:24.69,0:14:25.86,Default,,0,0,0,,Почита!
Dialogue: 0,0:14:26.69,0:14:29.20,Default,,0,0,0,,Почита, мен жұмысқа барамын.
Dialogue: 0,0:14:29.28,0:14:33.45,Default,,0,0,0,,(арамен ағаш кесу дыбысы)
Dialogue: 0,0:14:41.96,0:14:43.09,Default,,0,0,0,,Почита
Dialogue: 0,0:14:43.17,0:14:47.34,Default,,0,0,0,,Мен шайтанмен соғысып өлуім мүмкін.
Dialogue: 0,0:14:47.42,0:14:51.09,Default,,0,0,0,,Сонда Почита ғана өкінемін.
Dialogue: 0,0:14:51.18,0:14:54.10,Default,,0,0,0,,Мен аштықтан өлуім мүмкін.
Dialogue: 0,0:14:54.18,0:14:57.85,Default,,0,0,0,,Сізді басқа шайтан аңшылары өлтіруі мүмкін.
Dialogue: 0,0:15:02.19,0:15:06.23,Default,,0,0,0,,Кейбір жындар өлген адамдардың денесін басып алатын сияқты.
Dialogue: 0,0:15:07.11,0:15:09.61,Default,,0,0,0,,Почита мұны істей алса
Dialogue: 0,0:15:10.15,0:15:12.78,Default,,0,0,0,,Менің денемді Почитаға бер.
Dialogue: 0,0:15:14.16,0:15:18.00,Default,,0,0,0,,Қабірге барса, якудза оның артынан келмейді, солай ма?
Dialogue: 0,0:15:18.83,0:15:21.50,Default,,0,0,0,,Олай болса бұл қаладан кет
Dialogue: 0,0:15:21.58,0:15:23.17,Default,,0,0,0,,Мен қыз досыма мүлде хабарласа алмай жатырмын—
Dialogue: 0,0:15:24.17,0:15:25.00,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:25.75,0:15:30.26,Default,,0,0,0,,Мен сенің қалыпты өмір сүріп, қалыпты өліммен өлгеніңді қалаймын.
Dialogue: 0,0:15:34.18,0:15:36.39,Default,,0,0,0,,Менің арманымды орындай гөр
Dialogue: 0,0:15:52.53,0:15:57.53,Default,,0,0,0,,Сен, қара нәсілді жексұрын!
Dialogue: 0,0:16:04.29,0:16:05.21,Default,,0,0,0,,Почита…
Dialogue: 0,0:16:05.29,0:16:06.71,Default,,0,0,0,,Бір!
Dialogue: 0,0:16:08.17,0:16:10.97,Default,,0,0,0,,Менің денемді дұрыс қабылдай алдыңыз ба?
Dialogue: 0,0:16:13.30,0:16:17.72,Default,,0,0,0,,Маған Дэнджидің армандары туралы естіген ұнады.
Dialogue: 0,0:16:17.81,0:16:19.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:20.06,0:16:22.02,Default,,0,0,0,,Бұл келісім-шарт
Dialogue: 0,0:16:22.10,0:16:23.85,Default,,0,0,0,,Менің жүрегімді істе
Dialogue: 0,0:16:23.94,0:16:28.73,Default,,0,0,0,,Оның орнына маған Денжидің арманын көрсетіңіз.
Dialogue: 0,0:16:28.82,0:16:30.23,Default,,0,0,0,,Почита!
Dialogue: 0,0:16:31.03,0:16:32.86,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:32.95,0:16:35.86,Default,,0,0,0,,А... ха
Dialogue: 0,0:16:36.62,0:16:37.87,Default,,0,0,0,,Егер осылай салқынқанды болып жүре берсең, сүйкімді жүзіңді бүлдіріп аласың.
Dialogue: 0,0:16:44.33,0:16:45.75,Default,,0,0,0,,Почита…
Dialogue: 0,0:16:45.83,0:16:48.25,Default,,0,0,0,,Гррр…
Dialogue: 0,0:16:52.09,0:16:55.01,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,0:16:55.09,0:16:59.51,Default,,0,0,0,,Оны жыртып алсаң да тірі ме? Неліктен? Жалпы
Dialogue: 0,0:16:59.60,0:17:02.52,Default,,0,0,0,,Мен күткендей, мен шайтан аңшыларын жек көремін.
Dialogue: 0,0:17:02.60,0:17:06.10,Default,,0,0,0,,Барлығы мұны жеді.
Dialogue: 0,0:17:09.61,0:17:11.02,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:11.86,0:17:14.74,Default,,0,0,0,,Бұл балалар неге сонша батасын алды?
Dialogue: 0,0:17:14.82,0:17:17.03,Default,,0,0,0,,Сіз жақсы өмірді қалайсыз ба?
Dialogue: 0,0:17:18.16,0:17:19.53,Default,,0,0,0,,Мен бірдеймін бе?
Dialogue: 0,0:17:20.28,0:17:23.54,Default,,0,0,0,,Мен Почитаға ие болу бақытына қанағаттанбаймын.
Dialogue: 0,0:17:24.12,0:17:27.29,Default,,0,0,0,,Мен жақсы өмірді армандадым
Dialogue: 0,0:17:28.08,0:17:31.55,Default,,0,0,0,,Көремін, бәрі армандайды.
Dialogue: 0,0:17:32.59,0:17:34.67,Default,,0,0,0,,Сонда бұл жаман емес.
Dialogue: 0,0:17:35.63,0:17:38.30,Default,,0,0,0,,Бұл жаман емес, бірақ...
Dialogue: 0,0:17:40.18,0:17:42.06,Default,,0,0,0,,Маған кедергі жасағың келмесе...
Dialogue: 0,0:17:44.81,0:17:47.39,Default,,0,0,0,,А... өл!
Dialogue: 0,0:17:47.48,0:17:49.23,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:51.15,0:17:53.07,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:17:55.65,0:17:58.82,Default,,0,0,0,,Оны жесең, өлетін шығарсың.
Dialogue: 0,0:18:02.16,0:18:05.08,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:18:05.16,0:18:08.08,Default,,0,0,0,,(мотор дыбысы)
Dialogue: 0,0:18:08.71,0:18:09.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:09.67,0:18:12.96,Default,,0,0,0,,(мотор дыбысы)
Dialogue: 0,0:18:13.05,0:18:13.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:14.92,0:18:18.30,Default,,0,0,0,,Ураааааааааа!
Dialogue: 0,0:18:24.52,0:18:26.23,Default,,0,0,0,,Я...
Dialogue: 0,0:18:26.31,0:18:29.27,Default,,0,0,0,,Хаха...
Dialogue: 0,0:18:31.27,0:18:32.73,Default,,0,0,0,,Сіз қандайсыз?
Dialogue: 0,0:18:32.82,0:18:36.74,Default,,0,0,0,,Бұрынғы кішкентай шайтан сіздің денеңізді басып алды ма?
Dialogue: 0,0:18:36.82,0:18:38.99,Default,,0,0,0,,А... (Зомби жын) Демек, біз доспыз!?
Dialogue: 0,0:18:42.57,0:18:43.58,Default,,0,0,0,,Хмммммммммммммммммммммммммммммммммммммммммммммм.
Dialogue: 0,0:18:43.66,0:18:45.12,Default,,0,0,0,,Дааааааа...
Dialogue: 0,0:18:45.20,0:18:49.83,Default,,0,0,0,,Хе... Хе... Ха...
Dialogue: 0,0:18:49.92,0:18:50.96,Default,,0,0,0,,Уаааа
Dialogue: 0,0:18:51.04,0:18:53.25,Default,,0,0,0,,Ооо...
Dialogue: 0,0:18:53.34,0:18:55.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:58.80,0:19:02.22,Default,,0,0,0,,Уф... бұл ауырады
Dialogue: 0,0:19:03.10,0:19:04.76,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:06.93,0:19:07.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:08.60,0:19:09.64,Default,,0,0,0,,Гррр... Урррррррррр.
Dialogue: 0,0:19:12.31,0:19:13.15,Default,,0,0,0,,Урааа
Dialogue: 0,0:19:13.23,0:19:16.57,Default,,0,0,0,,Уф... бұл ауырады.
Dialogue: 0,0:19:17.28,0:19:20.82,Default,,0,0,0,,Уф... Мұнда келме! Сәлем
Dialogue: 0,0:19:21.70,0:19:24.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:24.12,0:19:26.37,Default,,0,0,0,,Хмм, алаңдатады!
Dialogue: 0,0:19:26.45,0:19:29.37,Default,,0,0,0,,Келме! Келме! Келме!
Dialogue: 0,0:19:29.45,0:19:31.87,Default,,0,0,0,,Келме! Келме! Уф...хехе
Dialogue: 0,0:19:31.96,0:19:33.88,Default,,0,0,0,,Мұнда келме!
Dialogue: 0,0:19:33.96,0:19:35.17,Default,,0,0,0,,Уф
Dialogue: 0,0:19:35.96,0:19:38.13,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:38.71,0:19:39.76,Default,,0,0,0,,Әй
Dialogue: 0,0:19:40.47,0:19:41.34,Default,,0,0,0,,Уф
Dialogue: 0,0:19:42.34,0:19:43.55,Default,,0,0,0,,Уф
Dialogue: 0,0:19:43.64,0:19:45.64,Default,,0,0,0,,А... уф
Dialogue: 0,0:19:45.72,0:19:47.64,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:19:47.72,0:19:49.39,Default,,0,0,0,,Өлме!
Dialogue: 0,0:19:49.98,0:19:53.06,Default,,0,0,0,,Уаааааааааа!
Dialogue: 0,0:19:53.90,0:19:55.52,Default,,0,0,0,,(Джозеф) Бір, екі. (Абдул) Бір, екі.
Dialogue: 0,0:19:55.61,0:19:57.94,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:19:58.03,0:20:00.69,Default,,0,0,0,,Гяаааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:20:16.88,0:20:22.22,Default,,0,0,0,,(Зомбилердің ыңырсыуы)
Dialogue: 0,0:20:25.55,0:20:27.93,Default,,0,0,0,,Балалар сендерге келсек
Dialogue: 0,0:20:28.01,0:20:31.48,Default,,0,0,0,,Жүрегіңнің өзі шайтанға айналғаны ғажап.
Dialogue: 0,0:20:32.06,0:20:35.23,Default,,0,0,0,,Себебі мен шайтан аулаушы болып жұмыс істеймін.
Dialogue: 0,0:20:35.31,0:20:39.48,Default,,0,0,0,,Шайтанды өлтіру керек!
Dialogue: 0,0:20:39.57,0:20:42.03,Default,,0,0,0,,Жақсы хехе... Гехехе...
Dialogue: 0,0:20:43.70,0:20:44.53,Default,,0,0,0,,Әй
Dialogue: 0,0:20:45.16,0:20:49.41,Default,,0,0,0,,Түсіндім, олардың барлығын өлтіріңіз...
Dialogue: 0,0:20:49.49,0:20:51.16,Default,,0,0,0,,Қарыз өте қорқынышты!
Dialogue: 0,0:20:51.25,0:20:53.08,Default,,0,0,0,,Гяхахаха…
Dialogue: 0,0:20:53.16,0:20:55.83,Default,,0,0,0,,Ухаха... хахаха... Гяхаха...
Dialogue: 0,0:20:55.92,0:20:59.67,Default,,0,0,0,,Уухахаха... хяхаха... уххаха... хаха...
Dialogue: 0,0:21:38.46,0:21:40.38,Default,,0,0,0,,Сіз өзіңізден озып кеттіңіз.
Dialogue: 0,0:21:49.43,0:21:50.97,Default,,0,0,0,,Тірілері бар.
Dialogue: 0,0:22:04.61,0:22:05.86,Default,,0,0,0,,(Юки) Қыз ба? (Миямура) Ұл ба?
Dialogue: 0,0:22:06.45,0:22:09.61,Default,,0,0,0,,Біртүрлі иіс шығып тұр.
Dialogue: 0,0:22:09.70,0:22:12.87,Default,,0,0,0,,Адамға да, жынға да жатпайтын иіс
Dialogue: 0,0:22:15.45,0:22:17.62,Default,,0,0,0,,Сіз мұны істедіңіз бе?
Dialogue: 0,0:22:18.79,0:22:20.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:20.92,0:22:24.05,Default,,0,0,0,,Бұл... Мен сені ұстап алайын...
Dialogue: 0,0:22:39.56,0:22:40.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:43.57,0:22:44.61,Default,,0,0,0,,Адамдар
Dialogue: 0,0:22:44.69,0:22:47.36,Default,,0,0,0,,Жындардың басып алу мүмкіндігі бар ма?
Dialogue: 0,0:22:47.44,0:22:49.15,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:22:49.24,0:22:51.62,Default,,0,0,0,,Біреудің ұрланғанын оның бетіне қарап білуге болады.
Dialogue: 0,0:22:54.08,0:22:59.62,Default,,0,0,0,,Мен зомби жындарды өлтіруге келген қоғамдық қауіпсіздіктің шайтан аңшысымын.
Dialogue: 0,0:23:03.79,0:23:06.21,Default,,0,0,0,,Сізде екі таңдау бар.
Dialogue: 0,0:23:06.71,0:23:10.13,Default,,0,0,0,,Мен сені шайтан ретінде өлтіремін бе?
Dialogue: 0,0:23:10.76,0:23:13.47,Default,,0,0,0,,Мен сені адам ретінде сақтаймын ба?
Dialogue: 0,0:23:13.97,0:23:17.14,Default,,0,0,0,,Сақтасам, дұрыстап тамақтандырамын.
Dialogue: 0,0:23:26.19,0:23:27.73,Default,,0,0,0,,Қармақ...
Dialogue: 0,0:23:28.78,0:23:30.65,Default,,0,0,0,,Сіз қандай таңғы ас ішесіз?
Dialogue: 0,0:23:31.24,0:23:32.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:33.03,0:23:36.16,Default,,0,0,0,,Нанға сары май мен джем жағамыз
Dialogue: 0,0:23:36.24,0:23:42.17,Default,,0,0,0,,Салат, кофе және десерт... мүмкін бе?
Dialogue: 0,0:23:43.83,0:23:44.67,Default,,0,0,0,,Е...
Dialogue: 0,0:23:46.67,0:23:47.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:50.76,0:23:53.89,Default,,0,0,0,,Ең жақсысы емес пе?
Dialogue: 0,0:23:54.97,0:23:59.98,Default,,0,0,0,,♪～
Dialogue: 0,0:25:17.51,0:25:22.52,Default,,0,0,0,,～♪
Dialogue: 0,0:25:24.02,0:25:30.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory