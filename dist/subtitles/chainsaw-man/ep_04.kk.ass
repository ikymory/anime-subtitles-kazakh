Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:05.67,Default,,0,0,0,,(торғай жылайды)
Dialogue: 0,0:00:10.09,0:00:11.42,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:00:12.42,0:00:14.01,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:00:14.76,0:00:18.18,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:00:21.56,0:00:22.68,Default,,0,0,0,,(Аю жылауы)
Dialogue: 0,0:00:26.02,0:00:29.94,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:00:32.07,0:00:33.70,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:41.75,0:00:44.79,Default,,0,0,0,,Хехехе... хехехе...
Dialogue: 0,0:00:45.58,0:00:47.29,Default,,0,0,0,,(Ньяконың айқайы)
Dialogue: 0,0:00:48.38,0:00:51.55,Default,,0,0,0,,Егер сіз мысықтың өлтірілгенін қаламасаңыз
Dialogue: 0,0:00:51.63,0:00:54.55,Default,,0,0,0,,Маған адам әкел
Dialogue: 0,0:00:55.22,0:00:59.05,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:59.72,0:01:01.81,Default,,0,0,0,,Өмір де бірдей жеңіл
Dialogue: 0,0:01:02.72,0:01:04.06,Default,,0,0,0,,Тек мысық
Dialogue: 0,0:01:05.02,0:01:06.73,Default,,0,0,0,,Онда неге жүгіру керек?
Dialogue: 0,0:01:06.81,0:01:08.31,Default,,0,0,0,,Неліктен адамдарды іздеу керек?
Dialogue: 0,0:01:10.90,0:01:11.86,Default,,0,0,0,,Ха...
Dialogue: 0,0:01:11.94,0:01:13.82,Default,,0,0,0,,Ньякоға көмектесу үшін бе?
Dialogue: 0,0:01:13.90,0:01:15.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:15.40,0:01:17.57,Default,,0,0,0,,Ахх...
Dialogue: 0,0:01:18.53,0:01:21.16,Default,,0,0,0,,Бұл ақымақ себеп
Dialogue: 0,0:01:21.24,0:01:24.70,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:01:25.58,0:01:27.54,Default,,0,0,0,,Мен қанды жақсы көремін
Dialogue: 0,0:01:27.62,0:01:31.84,Default,,0,0,0,,Дәмі, иісі және өлім сезімі
Dialogue: 0,0:01:32.67,0:01:37.18,Default,,0,0,0,,Сонымен... Сондықтан мен жақында ғана білдім.
Dialogue: 0,0:01:38.43,0:01:43.64,Default,,0,0,0,,Қан жылы және жақсы сезінеді
Dialogue: 0,0:01:45.93,0:01:48.10,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:01:48.19,0:01:50.36,Default,,0,0,0,,(Ньяконың айқайы)
Dialogue: 0,0:02:05.79,0:02:07.87,Default,,0,0,0,,Бүркітті неге құтқардың?
Dialogue: 0,0:02:08.46,0:02:11.21,Default,,0,0,0,,Мен Юнвуды өлтірмек болдым
Dialogue: 0,0:02:12.42,0:02:14.13,Default,,0,0,0,,(Дэнджидің тыныс алу дыбысы)
Dialogue: 0,0:02:15.09,0:02:16.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:18.09,0:02:18.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:23.43,0:02:25.89,Default,,0,0,0,,Бұл ақымақ себеп.
Dialogue: 0,0:02:28.98,0:02:31.90,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:02:34.73,0:02:37.40,Default,,0,0,0,,Сізді алдағаным үшін кешіріңіз.
Dialogue: 0,0:02:37.49,0:02:39.90,Default,,0,0,0,,Өйткені Няко құтқарылды.
Dialogue: 0,0:02:40.66,0:02:42.70,Default,,0,0,0,,Мен саған кеудемді еркелетуге рұқсат етемін
Dialogue: 0,0:02:43.24,0:02:44.12,Default,,0,0,0,,А...
Dialogue: 0,0:02:47.45,0:02:48.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:52.29,0:02:58.30,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:02:58.38,0:03:00.80,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:03:00.88,0:03:02.80,Default,,0,0,0,,Жүр!
Dialogue: 0,0:03:02.89,0:03:04.55,Default,,0,0,0,,Келіңіздер~ Уф... (Қуат) Ха...
Dialogue: 0,0:03:04.64,0:03:10.39,Default,,0,0,0,,Уф... мен бардым... Ууууууууууууууууууу...
Dialogue: 0,0:03:11.56,0:03:12.40,Default,,0,0,0,,Га
Dialogue: 0,0:03:19.44,0:03:20.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:23.11,0:03:28.12,Default,,0,0,0,,♪～
Dialogue: 0,0:04:44.74,0:04:49.74,Default,,0,0,0,,～♪
Dialogue: 0,0:04:53.54,0:04:57.96,Default,,0,0,0,,(Сүлгі шайтанның жеп жатқан дыбысы)
Dialogue: 0,0:04:58.04,0:04:59.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:00.04,0:05:02.63,Default,,0,0,0,,Ммм (сүлік шайтанның жұтқан дыбысы)
Dialogue: 0,0:05:02.71,0:05:04.01,Default,,0,0,0,,Сізге көшу керек пе?
Dialogue: 0,0:05:04.51,0:05:08.97,Default,,0,0,0,,Мен саусақтарымды қозғалта алмаймын. Ньяконы алып қашып кет.
Dialogue: 0,0:05:09.68,0:05:10.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:11.56,0:05:12.39,Default,,0,0,0,,Уф
Dialogue: 0,0:05:13.60,0:05:14.64,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:16.48,0:05:17.94,Default,,0,0,0,,(Араның тоқтаған дыбысы)
Dialogue: 0,0:05:18.73,0:05:21.27,Default,,0,0,0,,Иә, мен араны шығара алмаймын.
Dialogue: 0,0:05:21.36,0:05:22.78,Default,,0,0,0,,Ха...
Dialogue: 0,0:05:22.86,0:05:25.19,Default,,0,0,0,,Қаныңыз жетпейді ме?
Dialogue: 0,0:05:27.07,0:05:27.95,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:28.03,0:05:31.70,Default,,0,0,0,,Ақыры таптым
Dialogue: 0,0:05:31.78,0:05:35.33,Default,,0,0,0,,Сіз емес пе?Мен жараны өлтірдім
Dialogue: 0,0:05:35.41,0:05:38.21,Default,,0,0,0,,Ол менің адамым еді!
Dialogue: 0,0:05:38.29,0:05:39.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:40.42,0:05:45.09,Default,,0,0,0,,Әй, мұқият қарасаң, сүйкімді жүзді көресің.
Dialogue: 0,0:05:45.17,0:05:48.72,Default,,0,0,0,,Сізде маған ұнайтын бет бар, сондықтан қашып кетуіңізге рұқсат етемін.
Dialogue: 0,0:05:49.84,0:05:51.22,Default,,0,0,0,,Арттағылар ше?
Dialogue: 0,0:05:51.30,0:05:53.97,Default,,0,0,0,,Нфф...
Dialogue: 0,0:05:54.60,0:05:55.98,Default,,0,0,0,,өлтіру
Dialogue: 0,0:06:00.73,0:06:01.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:01.65,0:06:03.82,Default,,0,0,0,,Сосын өл.
Dialogue: 0,0:06:04.57,0:06:06.82,Default,,0,0,0,,Уф ха ха...
Dialogue: 0,0:06:08.15,0:06:09.57,Default,,0,0,0,,Нууууууууу
Dialogue: 0,0:06:09.66,0:06:11.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:11.66,0:06:13.58,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:06:15.37,0:06:16.58,Default,,0,0,0,,Уф
Dialogue: 0,0:06:16.66,0:06:18.25,Default,,0,0,0,,Фуууууук
Dialogue: 0,0:06:19.79,0:06:20.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:21.71,0:06:22.84,Default,,0,0,0,,Хаха...
Dialogue: 0,0:06:22.92,0:06:24.96,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:06:26.92,0:06:28.26,Default,,0,0,0,,Ах (Сілік жын) Иә!
Dialogue: 0,0:06:28.34,0:06:29.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:30.43,0:06:32.35,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:06:32.43,0:06:34.81,Default,,0,0,0,,Нуаааааааааааааааааааааа
Dialogue: 0,0:06:35.93,0:06:37.06,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:06:37.14,0:06:39.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:39.14,0:06:41.10,Default,,0,0,0,,Тек кеудемді еркелету үшін...
Dialogue: 0,0:06:41.19,0:06:42.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:42.65,0:06:45.07,Default,,0,0,0,,Сіз осылай күресе аласыз ба?
Dialogue: 0,0:06:45.15,0:06:46.57,Default,,0,0,0,,А... уф
Dialogue: 0,0:06:46.65,0:06:48.82,Default,,0,0,0,,Ха-ха… хэ-хэ…
Dialogue: 0,0:06:49.40,0:06:50.74,Default,,0,0,0,,О, жоқ!(Сілік шайтан) Хаха
Dialogue: 0,0:06:50.82,0:06:54.03,Default,,0,0,0,,Ах, у, а...
Dialogue: 0,0:06:55.70,0:06:57.75,Default,,0,0,0,,Уф, уф, уф...
Dialogue: 0,0:06:57.83,0:07:00.58,Default,,0,0,0,,Гах... ха...
Dialogue: 0,0:07:00.67,0:07:02.25,Default,,0,0,0,,Бұл өтірік емес пе!?
Dialogue: 0,0:07:02.33,0:07:06.25,Default,,0,0,0,,Мына күшік жарғанатты өлтірді ме?
Dialogue: 0,0:07:06.34,0:07:08.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:08.84,0:07:10.76,Default,,0,0,0,,Жарқанаттар менімен бірге
Dialogue: 0,0:07:10.84,0:07:14.01,Default,,0,0,0,,Мен барлық адамдарды жеуді армандадым.
Dialogue: 0,0:07:14.64,0:07:18.02,Default,,0,0,0,,Абайсыз, бірақ асыл және тамаша арман
Dialogue: 0,0:07:18.10,0:07:21.77,Default,,0,0,0,,Ол күшіктің өлшеміне дейін талқандалған.
Dialogue: 0,0:07:21.85,0:07:25.15,Default,,0,0,0,,Оны өлтіру ысырап болар еді, бірақ
Dialogue: 0,0:07:25.82,0:07:27.28,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:07:27.94,0:07:31.53,Default,,0,0,0,,Хмм... Кеудеңді ысқыламай тұрып өлейін бе?
Dialogue: 0,0:07:31.61,0:07:33.41,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:07:33.49,0:07:37.08,Default,,0,0,0,,Оны арсыз қалаулары бар біреу өлтірді.
Dialogue: 0,0:07:37.16,0:07:39.79,Default,,0,0,0,,Бейшара жарқанат
Dialogue: 0,0:07:39.87,0:07:41.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:41.12,0:07:43.21,Default,,0,0,0,,Бұл ақымақ себеп.
Dialogue: 0,0:07:43.29,0:07:44.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:44.79,0:07:47.13,Default,,0,0,0,,Сізден басқаның бәрі байсалды.
Dialogue: 0,0:07:48.59,0:07:49.42,Default,,0,0,0,,Nu
Dialogue: 0,0:07:49.51,0:07:50.42,Default,,0,0,0,,Нуууу
Dialogue: 0,0:07:50.51,0:07:52.38,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:07:52.47,0:07:53.01,Default,,0,0,0,,Ооооооооооо...
Dialogue: 0,0:07:53.01,0:07:54.93,Default,,0,0,0,,Ооооооооооо...
Dialogue: 0,0:07:53.01,0:07:54.93,Default,,0,0,0,,Урия
Dialogue: 0,0:07:54.93,0:07:56.26,Default,,0,0,0,,Ооооооооооо...
Dialogue: 0,0:07:56.35,0:07:57.22,Default,,0,0,0,,Охххх...
Dialogue: 0,0:07:57.22,0:07:58.60,Default,,0,0,0,,Охххх...
Dialogue: 0,0:07:57.22,0:07:58.60,Default,,0,0,0,,(сымның тартылған дыбысы)
Dialogue: 0,0:07:58.60,0:07:59.43,Default,,0,0,0,,Охххх...
Dialogue: 0,0:07:59.52,0:08:02.27,Default,,0,0,0,,Уа!(Хилл Демон) Гяаааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:08:02.35,0:08:05.06,Default,,0,0,0,,…  …
Dialogue: 0,0:08:05.15,0:08:09.32,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:09.40,0:08:14.32,Default,,0,0,0,,Бәрің де менің істеп жатқаныма менсінбей қарайсыңдар...
Dialogue: 0,0:08:14.41,0:08:19.08,Default,,0,0,0,,Бұл кек алу ма? Мен отбасымды қорғағым келеді. Мен мысықты құтқарғым келеді.
Dialogue: 0,0:08:19.16,0:08:21.08,Default,,0,0,0,,Ахдано Кодано
Dialogue: 0,0:08:21.16,0:08:24.21,Default,,0,0,0,,Әр адамның үлкен армандары бар деп үміттенемін!
Dialogue: 0,0:08:24.29,0:08:27.08,Default,,0,0,0,,Олай болса, арман шайқасын көрейік! Арман шайқасы!
Dialogue: 0,0:08:27.17,0:08:29.96,Default,,0,0,0,,Мен сені өлтіргім келеді.
Dialogue: 0,0:08:30.05,0:08:33.59,Default,,0,0,0,,Теменің арманы кеудесін уқалаудан басқа ештеңе емес!
Dialogue: 0,0:08:33.67,0:08:35.51,Default,,0,0,0,,Ол үрген кезде сүйкімді
Dialogue: 0,0:08:35.59,0:08:37.89,Default,,0,0,0,,Күшіктей үреді, үреді, уф, уф, уф!
Dialogue: 0,0:08:37.97,0:08:41.22,Default,,0,0,0,,Жарайды, мен жеймін!
Dialogue: 0,0:08:41.31,0:08:47.15,Default,,0,0,0,,Ухаха... Бұл тамаша. Арман шайқасында жеңіске жетуіңізге тілектеспін!
Dialogue: 0,0:08:47.23,0:08:49.73,Default,,0,0,0,,Нуфуфуфу
Dialogue: 0,0:08:49.82,0:08:52.61,Default,,0,0,0,,Уф... уф... уф...
Dialogue: 0,0:08:52.69,0:08:54.28,Default,,0,0,0,,Нууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:08:54.99,0:08:55.82,Default,,0,0,0,,А...
Dialogue: 0,0:08:55.91,0:08:58.78,Default,,0,0,0,,Хмф… Хмф…
Dialogue: 0,0:08:58.87,0:09:01.91,Default,,0,0,0,,Уф ха ха ха ха...
Dialogue: 0,0:09:01.99,0:09:04.08,Default,,0,0,0,,Арх...
Dialogue: 0,0:09:04.16,0:09:06.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:07.21,0:09:08.33,Default,,0,0,0,,Уау
Dialogue: 0,0:09:09.00,0:09:13.17,Default,,0,0,0,,Ой! (Сілік жын) Гяаааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:13.26,0:09:15.05,Default,,0,0,0,,Ой-ой, әй, әй, әй
Dialogue: 0,0:09:15.13,0:09:16.88,Default,,0,0,0,,Уа, ау, ау...
Dialogue: 0,0:09:17.80,0:09:19.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:19.85,0:09:22.93,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:23.02,0:09:24.48,Default,,0,0,0,,Бұл шайтан
Dialogue: 0,0:09:24.56,0:09:26.64,Default,,0,0,0,,Фухаха…
Dialogue: 0,0:09:26.73,0:09:27.94,Default,,0,0,0,,Фунну
Dialogue: 0,0:09:28.02,0:09:30.36,Default,,0,0,0,,Гухаха... Ухахаха...
Dialogue: 0,0:09:30.44,0:09:34.57,Default,,0,0,0,,Хахахаха... Охохохохо...
Dialogue: 0,0:09:34.65,0:09:35.86,Default,,0,0,0,,Ух ха...хе
Dialogue: 0,0:09:35.95,0:09:38.24,Default,,0,0,0,,(Хиллдің шайтанының күлкісі)
Dialogue: 0,0:09:40.58,0:09:42.99,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:09:43.08,0:09:46.46,Default,,0,0,0,,Уф... ха ха ха ха...
Dialogue: 0,0:09:46.54,0:09:48.04,Default,,0,0,0,,Ugggg (сүлік шайтан) Ugggg
Dialogue: 0,0:09:48.12,0:09:51.00,Default,,0,0,0,,Урааа
Dialogue: 0,0:09:52.84,0:09:55.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:55.30,0:09:56.67,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:56.76,0:10:00.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:00.68,0:10:02.81,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:02.89,0:10:06.06,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:10:11.98,0:10:12.82,Default,,0,0,0,,Кон
Dialogue: 0,0:10:12.90,0:10:14.53,Default,,0,0,0,,Гаук
Dialogue: 0,0:10:19.03,0:10:21.32,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:21.41,0:10:24.04,Default,,0,0,0,,Бұл жігіт сүлік шайтан.
Dialogue: 0,0:10:24.12,0:10:25.83,Default,,0,0,0,,Мен оны жұтып аламын ба?
Dialogue: 0,0:10:25.91,0:10:27.25,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:37.13,0:10:38.67,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:43.35,0:10:45.77,Default,,0,0,0,,Сүлік жынының жойылуы расталды
Dialogue: 0,0:10:45.85,0:10:49.10,Default,,0,0,0,,Жаңадан келгендер аман қалғандарды құтқару мен қорғауға және эвакуацияға басшылық жасауға жауапты.
Dialogue: 0,0:10:49.19,0:10:50.10,Default,,0,0,0,,Иә! иә!
Dialogue: 0,0:10:50.19,0:10:53.77,Default,,0,0,0,,Химено-сенпай, шайтаннан сақ болыңыз.
Dialogue: 0,0:10:53.86,0:10:54.82,Default,,0,0,0,,Оши
Dialogue: 0,0:10:55.82,0:10:59.99,Default,,0,0,0,,Арман шайқасы... Мен... Мен арман шайқасымын...
Dialogue: 0,0:11:00.61,0:11:00.78,Default,,0,0,0,,Сіз және Қанды жын сұралады.
Dialogue: 0,0:11:00.78,0:11:03.16,Default,,0,0,0,,Сіз және Қанды жын сұралады.
Dialogue: 0,0:11:00.78,0:11:03.16,Default,,0,0,0,,Уф... жүр...
Dialogue: 0,0:11:03.16,0:11:04.24,Default,,0,0,0,,Уф... жүр...
Dialogue: 0,0:11:04.33,0:11:06.24,Default,,0,0,0,,Няко ше?
Dialogue: 0,0:11:04.33,0:11:06.24,Default,,0,0,0,,О, тоқтат!
Dialogue: 0,0:11:06.33,0:11:07.24,Default,,0,0,0,,Аххх... Уф... Хааааааааааа...
Dialogue: 0,0:11:07.24,0:11:08.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:07.24,0:11:08.50,Default,,0,0,0,,Аххх... Уф... Хааааааааааа...
Dialogue: 0,0:11:08.50,0:11:09.50,Default,,0,0,0,,Аххх... Уф... Хааааааааааа...
Dialogue: 0,0:11:09.50,0:11:11.00,Default,,0,0,0,,(айқай)
Dialogue: 0,0:11:09.50,0:11:11.00,Default,,0,0,0,,Аххх... Уф... Хааааааааааа...
Dialogue: 0,0:11:11.58,0:11:14.88,Default,,0,0,0,,Ветеринариялық ауруханада мысықтың денсаулық жағдайын тексеріңіз
Dialogue: 0,0:11:20.01,0:11:20.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:23.01,0:11:24.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:28.43,0:11:30.02,Default,,0,0,0,,Сіздің қолыңыз... иә?
Dialogue: 0,0:11:30.10,0:11:32.27,Default,,0,0,0,,Мен оны алдым...
Dialogue: 0,0:11:32.85,0:11:35.02,Default,,0,0,0,,Олар қан құйылғаннан кейін бір-біріне жабысып қалған көрінеді.
Dialogue: 0,0:11:35.90,0:11:38.23,Default,,0,0,0,,Ол шын мәнінде шайтан сияқты.
Dialogue: 0,0:11:39.44,0:11:42.28,Default,,0,0,0,,Сіз шайтанмен жақсы сөйлесіп жатқансыз, солай емес пе?
Dialogue: 0,0:11:42.36,0:11:44.37,Default,,0,0,0,,Мен қарап отырдым.
Dialogue: 0,0:11:44.87,0:11:48.54,Default,,0,0,0,,Аа... Шыныменде сен ештеңе білмейсің.
Dialogue: 0,0:11:48.62,0:11:53.00,Default,,0,0,0,,Ібіліс аңшысы шайтанмен келісім-шарт жасап, шайтанмен күреседі.
Dialogue: 0,0:11:54.38,0:11:56.50,Default,,0,0,0,,Менің түлкі шайтанмен келісімім бар.
Dialogue: 0,0:11:57.04,0:12:01.84,Default,,0,0,0,,Бұл сіздің күшіңізді қарызға алу үшін түлкіге денеңіздің бір бөлігін жеуге рұқсат беретін келісім.
Dialogue: 0,0:12:02.47,0:12:04.22,Default,,0,0,0,,Бұл жолы мен теріні жедім.
Dialogue: 0,0:12:04.30,0:12:07.72,Default,,0,0,0,,Хмм, бұл ауыр көрінеді...
Dialogue: 0,0:12:08.35,0:12:10.98,Default,,0,0,0,,Шайтан әрқашан адамдардың өлгенін қалайды.
Dialogue: 0,0:12:11.48,0:12:13.48,Default,,0,0,0,,Бұл жындарға да қатысты.
Dialogue: 0,0:12:13.56,0:12:15.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:15.10,0:12:17.36,Default,,0,0,0,,Күш – жақсы жігіт.
Dialogue: 0,0:12:20.19,0:12:21.40,Default,,0,0,0,,Бақылау камерасына
Dialogue: 0,0:12:21.49,0:12:25.24,Default,,0,0,0,,Патрульдік аумақтың сыртына шығыңыз. Сіз растадыңыз.
Dialogue: 0,0:12:25.32,0:12:30.16,Default,,0,0,0,,Ал жарғанат жын жасырынған деп есептелген үйде.
Dialogue: 0,0:12:30.24,0:12:32.79,Default,,0,0,0,,Қаныңыздың көп ағып жатқаны.
Dialogue: 0,0:12:32.87,0:12:34.71,Default,,0,0,0,,Сізді қанды жын өлтіріп кете жаздады.
Dialogue: 0,0:12:32.87,0:12:34.71,Default,,0,0,0,,Ух... мм...
Dialogue: 0,0:12:34.71,0:12:36.79,Default,,0,0,0,,Сізді қанды жын өлтіріп кете жаздады.
Dialogue: 0,0:12:37.46,0:12:39.30,Default,,0,0,0,,Неге екенін білмеймін, бірақ
Dialogue: 0,0:12:39.38,0:12:42.05,Default,,0,0,0,,Тағы да шайтанды қолдап жатырсың.
Dialogue: 0,0:12:42.72,0:12:45.80,Default,,0,0,0,,Ал... бұл қалай болды?
Dialogue: 0,0:12:49.47,0:12:53.23,Default,,0,0,0,,Менің қызым шынжырлы адаммен жеке кездескісі келеді.
Dialogue: 0,0:12:53.31,0:12:54.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:55.23,0:12:57.52,Default,,0,0,0,,Шайтан мені жұмыста жеп қояды деп қорқытты.
Dialogue: 0,0:12:57.61,0:12:59.06,Default,,0,0,0,,Мен қашып кеттім.
Dialogue: 0,0:12:59.15,0:13:03.40,Default,,0,0,0,,Мұқият қарасам, оның қоғамдық қауіпсіздік формасын киіп алғанын көрдім, мен оған алғыс айтқым келді.
Dialogue: 0,0:13:04.03,0:13:08.41,Default,,0,0,0,,Адамның өмірі қандай екенін кім біледі? Шайтан екеумізге көлік лақтырды.
Dialogue: 0,0:13:08.49,0:13:10.58,Default,,0,0,0,,Басына арасы бар жын...
Dialogue: 0,0:13:14.33,0:13:17.67,Default,,0,0,0,,Егер мен егжей-тегжейлі зерттеп, сізге есеп берсем.
Dialogue: 0,0:13:17.75,0:13:17.88,Default,,0,0,0,,Қанды жын да сені қорғады, сен де жойыласың.
Dialogue: 0,0:13:17.88,0:13:20.34,Default,,0,0,0,,Қанды жын да сені қорғады, сен де жойыласың.
Dialogue: 0,0:13:17.88,0:13:20.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:20.34,0:13:20.92,Default,,0,0,0,,Қанды жын да сені қорғады, сен де жойыласың.
Dialogue: 0,0:13:20.92,0:13:21.38,Default,,0,0,0,,Қанды жын да сені қорғады, сен де жойыласың.
Dialogue: 0,0:13:20.92,0:13:21.38,Default,,0,0,0,,Хмм... ой...
Dialogue: 0,0:13:21.38,0:13:22.00,Default,,0,0,0,,Хмм... ой...
Dialogue: 0,0:13:22.00,0:13:23.84,Default,,0,0,0,,Бірақ өлім болған жоқ.
Dialogue: 0,0:13:22.00,0:13:23.84,Default,,0,0,0,,Хмм... ой...
Dialogue: 0,0:13:23.84,0:13:23.92,Default,,0,0,0,,Хмм... ой...
Dialogue: 0,0:13:23.92,0:13:24.76,Default,,0,0,0,,Егер сіз бір ғана шартты қабылдасаңыз, мен сізге осы уақытты өткізіп жіберуге рұқсат етемін.
Dialogue: 0,0:13:23.92,0:13:24.76,Default,,0,0,0,,Хмм... ой...
Dialogue: 0,0:13:24.76,0:13:28.34,Default,,0,0,0,,Егер сіз бір ғана шартты қабылдасаңыз, мен сізге осы уақытты өткізіп жіберуге рұқсат етемін.
Dialogue: 0,0:13:28.43,0:13:29.89,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:33.31,0:13:35.85,Default,,0,0,0,,Менің айтқанымды тыңдаңыз
Dialogue: 0,0:13:36.48,0:13:39.10,Default,,0,0,0,,Сен ақымақсың, ақымақсың, мораль жоқ.
Dialogue: 0,0:13:39.19,0:13:43.86,Default,,0,0,0,,Мен сізден үлкенмін, мен әлеуметтік әділеттілікке сенемін.
Dialogue: 0,0:13:43.94,0:13:48.36,Default,,0,0,0,,Егер сіз мені тыңдасаңыз, қазіргі өміріңізді сақтай аласыз.
Dialogue: 0,0:13:50.95,0:13:53.87,Default,,0,0,0,,Сіз қалай ойлайсыз? Түсінсеңіз жауап беріңіз
Dialogue: 0,0:13:53.95,0:13:56.00,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:13:56.54,0:13:59.38,Default,,0,0,0,,О, мұны есте сақта.
Dialogue: 0,0:14:01.09,0:14:02.88,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:14:02.96,0:14:06.47,Default,,0,0,0,,Қараңызшы, сізде асыл мақсат жоқ.
Dialogue: 0,0:14:06.55,0:14:09.18,Default,,0,0,0,,Бұл тек қайғылы арман
Dialogue: 0,0:14:09.72,0:14:13.64,Default,,0,0,0,,Мен де сіз сияқты байсалдымын.
Dialogue: 0,0:14:14.35,0:14:16.89,Default,,0,0,0,,Оны асыға күтіңіздер!
Dialogue: 0,0:14:20.73,0:14:23.15,Default,,0,0,0,,Әзірше құрметті тілді есте сақтаңыз.
Dialogue: 0,0:14:23.23,0:14:26.90,Default,,0,0,0,,О, мен де бұл туралы ойланамын.
Dialogue: 0,0:14:32.53,0:14:33.83,Default,,0,0,0,,А... (қуат)?
Dialogue: 0,0:14:33.91,0:14:36.04,Default,,0,0,0,,Ол кінәсіз болды, солай ма?
Dialogue: 0,0:14:38.12,0:14:41.42,Default,,0,0,0,,Түсінсеңіз, оны тез жойыңыз.
Dialogue: 0,0:14:41.50,0:14:44.17,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:14:44.25,0:14:47.42,Default,,0,0,0,,Бұл жын-чан бір күні біреуді өлтіргенде
Dialogue: 0,0:14:47.51,0:14:50.18,Default,,0,0,0,,Оны жіберіп алғаны үшін Аки кінәлі.
Dialogue: 0,0:14:50.26,0:14:52.89,Default,,0,0,0,,Біз шайтан іздеушілерміз
Dialogue: 0,0:14:52.97,0:14:57.43,Default,,0,0,0,,Ол шайтан болсын, жын болсын, қолыңнан келгеннің бәрін пайдалан.
Dialogue: 0,0:14:57.52,0:15:01.56,Default,,0,0,0,,Бірақ дұшпан – жау, тек оны пайдалан.
Dialogue: 0,0:15:02.31,0:15:04.69,Default,,0,0,0,,Менің бір-бірімізбен танысуға ниетім жоқ.
Dialogue: 0,0:15:08.07,0:15:09.19,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:15:36.93,0:15:38.02,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:15:38.10,0:15:39.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:43.19,0:15:44.15,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:15:48.11,0:15:49.28,Default,,0,0,0,,…Мен оны түсінгенімде, білмей тұрып
Dialogue: 0,0:15:49.36,0:15:52.53,Default,,0,0,0,,Ол патрульдік аумақтың сыртына шығып кеткен сияқты.
Dialogue: 0,0:15:52.61,0:15:56.78,Default,,0,0,0,,Олар сол жерде өте зұлым шайтан тұратын үйді тапты.
Dialogue: 0,0:15:56.87,0:15:59.54,Default,,0,0,0,,Ол жарғанат жынымен кездескен сияқты.
Dialogue: 0,0:15:59.62,0:16:03.33,Default,,0,0,0,,Денджи шынжырлы араға айналып, жарғанатты жынды жойғаннан кейін.
Dialogue: 0,0:16:03.42,0:16:06.25,Default,,0,0,0,,Бұл жолы маған сүлік жын шабуыл жасады.
Dialogue: 0,0:16:06.34,0:16:08.55,Default,,0,0,0,,Біздің 4-ші дивизия мұны жойды.
Dialogue: 0,0:16:08.63,0:16:11.22,Default,,0,0,0,,Сондай-ақ Бат Хиллден
Dialogue: 0,0:16:11.30,0:16:13.68,Default,,0,0,0,,Мылтық етінің бөліктері табылмады.
Dialogue: 0,0:16:13.76,0:16:15.80,Default,,0,0,0,,Барлығы есеп үшін.
Dialogue: 0,0:16:18.68,0:16:20.18,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:16:20.27,0:16:23.56,Default,,0,0,0,,Бірақ Дэнджи-кун мен Пауэр-чан
Dialogue: 0,0:16:23.64,0:16:25.35,Default,,0,0,0,,Білмей
Dialogue: 0,0:16:25.44,0:16:27.82,Default,,0,0,0,,Сіз соншалықты алысқа бардыңыз, солай емес пе?
Dialogue: 0,0:16:28.40,0:16:31.07,Default,,0,0,0,,Олар керемет ақымақ.
Dialogue: 0,0:16:31.15,0:16:35.82,Default,,0,0,0,,Патрульдік аумақтан шығу – тәртіп бұзушылық.
Dialogue: 0,0:16:35.91,0:16:38.37,Default,,0,0,0,,Бұл жолы адам өлімі болған жоқ.
Dialogue: 0,0:16:38.45,0:16:41.25,Default,,0,0,0,,Нәтижесінде біз екі жынның көзін жойдық.
Dialogue: 0,0:16:41.33,0:16:43.29,Default,,0,0,0,,Ешқандай сұрақ қоймасам дұрыс па?
Dialogue: 0,0:16:48.88,0:16:50.21,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:50.84,0:16:53.22,Default,,0,0,0,,Енді кешіріңіз.
Dialogue: 0,0:16:54.22,0:16:57.89,Default,,0,0,0,,Хаякава-кун, сен сәл икемді болдың ба?
Dialogue: 0,0:16:58.80,0:17:02.98,Default,,0,0,0,,Мүмкін бұл Дэнджи-кунмен өмір сүрудің әсері шығар?
Dialogue: 0,0:17:03.06,0:17:08.61,Default,,0,0,0,,Жоқ, мен үшін ештеңе өзгерген жоқ.
Dialogue: 0,0:17:18.62,0:17:19.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:17:25.21,0:17:29.63,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:17:44.77,0:17:46.89,Default,,0,0,0,,(Газ пешінің жану дыбысы)
Dialogue: 0,0:18:39.15,0:18:42.20,Default,,0,0,0,,(Дэнджидің ұйқылы дауысы)
Dialogue: 0,0:18:55.30,0:18:57.21,Default,,0,0,0,,(Шаңсорғыш дыбысы)
Dialogue: 0,0:19:08.64,0:19:10.19,Default,,0,0,0,,Түскі асыңыз қандай?
Dialogue: 0,0:19:10.81,0:19:11.90,Default,,0,0,0,,Карри
Dialogue: 0,0:19:11.98,0:19:12.81,Default,,0,0,0,,Яри
Dialogue: 0,0:19:12.90,0:19:14.02,Default,,0,0,0,,Ах
Dialogue: 0,0:19:14.11,0:19:14.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:15.02,0:19:16.61,Default,,0,0,0,,(Есікті қағу)
Dialogue: 0,0:19:16.69,0:19:18.94,Default,,0,0,0,,Не? Шайтан?
Dialogue: 0,0:19:19.82,0:19:21.28,Default,,0,0,0,,(есік тұтқасының айналу дыбысы)
Dialogue: 0,0:19:21.82,0:19:23.20,Default,,0,0,0,,О...
Dialogue: 0,0:19:23.28,0:19:24.03,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:24.03,0:19:24.49,Default,,0,0,0,,Оу Оу! (Хаякава/Денжи) Иә?
Dialogue: 0,0:19:24.03,0:19:24.49,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:24.49,0:19:25.95,Default,,0,0,0,,Ou Ou Ou! (Хаякава/Денжи) Иә?
Dialogue: 0,0:19:26.03,0:19:28.70,Default,,0,0,0,,Джану тар үйі
Dialogue: 0,0:19:28.79,0:19:30.21,Default,,0,0,0,,(айқай)
Dialogue: 0,0:19:30.29,0:19:31.46,Default,,0,0,0,,Ах... Хмм...
Dialogue: 0,0:19:32.29,0:19:37.21,Default,,0,0,0,,Мен Пауэр-чанның маған Хаякава-кунның бөлмесін беруін қалаймын.
Dialogue: 0,0:19:37.30,0:19:42.22,Default,,0,0,0,,Сіз Денджи мен Қуат үшін керемет жаға жасай аласыз.
Dialogue: 0,0:19:42.30,0:19:45.26,Default,,0,0,0,,Осы қауіпті адамдарды неге менің үйіме жинайсың?
Dialogue: 0,0:19:42.30,0:19:45.26,Default,,0,0,0,,Уау... Тоқта, күт, Няко!
Dialogue: 0,0:19:45.26,0:19:45.85,Default,,0,0,0,,Осы қауіпті адамдарды неге менің үйіме жинайсың?
Dialogue: 0,0:19:45.93,0:19:50.35,Default,,0,0,0,,Себебі мен Хаякаваға көбірек сенемін.
Dialogue: 0,0:19:50.43,0:19:53.60,Default,,0,0,0,,Ол менікі, ей, мен ең күштімін.
Dialogue: 0,0:19:54.31,0:19:56.36,Default,,0,0,0,,А... иә
Dialogue: 0,0:19:56.44,0:20:00.03,Default,,0,0,0,,Олардың осында мәңгі тұруы біртүрлі болар еді.
Dialogue: 0,0:20:01.20,0:20:02.07,Default,,0,0,0,,Иә
Dialogue: 0,0:20:03.49,0:20:04.57,Default,,0,0,0,,Иә
Dialogue: 0,0:20:05.70,0:20:10.62,Default,,0,0,0,,Уайымдама, Пауэр-чан, мен сенен жақсы қыз болады дедім.
Dialogue: 0,0:20:10.70,0:20:11.16,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:20:11.16,0:20:12.87,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:20:11.16,0:20:12.87,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:20:12.87,0:20:14.63,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:20:14.71,0:20:16.84,Default,,0,0,0,,Мен көкөністерді жек көремін!Пои!
Dialogue: 0,0:20:16.92,0:20:18.05,Default,,0,0,0,,Ах!? Әй, сәбіз!
Dialogue: 0,0:20:18.13,0:20:19.05,Default,,0,0,0,,Уф
Dialogue: 0,0:20:19.13,0:20:20.63,Default,,0,0,0,,Көкөністерді лақтырмаңыз!
Dialogue: 0,0:20:20.71,0:20:26.64,Default,,0,0,0,,Әй, бұл көкөніс өсірген диқанға құрметсіздік деп ойламайсың ба, шайтан?
Dialogue: 0,0:20:28.22,0:20:31.77,Default,,0,0,0,,Дәретхана? Шіркін, мен кейде жанкүйер боламын
Dialogue: 0,0:20:31.85,0:20:33.02,Default,,0,0,0,,Ағын
Dialogue: 0,0:20:33.10,0:20:34.39,Default,,0,0,0,,Сасық.
Dialogue: 0,0:20:34.48,0:20:36.61,Default,,0,0,0,,Мен анда-санда ғана шомылатын адаммын.
Dialogue: 0,0:20:36.69,0:20:37.86,Default,,0,0,0,,Енгізіңіз!
Dialogue: 0,0:20:37.94,0:20:39.27,Default,,0,0,0,,Сасық!
Dialogue: 0,0:20:39.36,0:20:43.99,Default,,0,0,0,,Неге, Юнву, адамдар соншалықты нәзік.
Dialogue: 0,0:20:44.07,0:20:45.28,Default,,0,0,0,,Сәлем Няко
Dialogue: 0,0:20:45.36,0:20:48.53,Default,,0,0,0,,(Ньяконың айқайы)
Dialogue: 0,0:20:45.36,0:20:48.53,Default,,0,0,0,,Ух... мм...
Dialogue: 0,0:20:54.87,0:20:58.29,Default,,0,0,0,,Әлгі бейбақ кенеттен келіп, қобалжыды...
Dialogue: 0,0:20:58.38,0:21:01.05,Default,,0,0,0,,Ібіліс боктың ағуына жол бере алмайды
Dialogue: 0,0:21:01.13,0:21:03.30,Default,,0,0,0,,Мен көкөністерді де қалдырамын.
Dialogue: 0,0:21:03.38,0:21:04.55,Default,,0,0,0,,Сәлем, Енну.
Dialogue: 0,0:21:04.63,0:21:07.30,Default,,0,0,0,,Әй, қарғыс атқан шайтан
Dialogue: 0,0:21:07.39,0:21:10.31,Default,,0,0,0,,Бұл боқ кептеліп қалды, мен оны түсіре алмаймын.
Dialogue: 0,0:21:11.10,0:21:11.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:12.98,0:21:13.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:15.44,0:21:16.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:17.23,0:21:21.65,Default,,0,0,0,,Бұл уәде болды, солай ма? Мен сені кеудемді ысқылауға мәжбүр етемін...
Dialogue: 0,0:21:21.73,0:21:22.94,Default,,0,0,0,,Руб!
Dialogue: 0,0:21:23.03,0:21:24.70,Default,,0,0,0,,Ааааааааааааааааааааааааа...
Dialogue: 0,0:21:27.78,0:21:29.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:31.74,0:21:35.41,Default,,0,0,0,,А... Хм...
Dialogue: 0,0:21:35.50,0:21:38.17,Default,,0,0,0,,Ммм... Ммм... Мм...
Dialogue: 0,0:21:38.75,0:21:41.80,Default,,0,0,0,,Әй, не болды? Сіз бақытты болуыңыз керек.
Dialogue: 0,0:21:41.88,0:21:43.17,Default,,0,0,0,,Уқалаңыз, ысқылаңыз!
Dialogue: 0,0:21:43.26,0:21:44.92,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:21:45.01,0:21:47.18,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:47.88,0:21:48.72,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:48.80,0:21:50.43,Default,,0,0,0,,Шарт бар
Dialogue: 0,0:21:51.76,0:21:55.06,Default,,0,0,0,,Кеудеге массаж жасаудың саны үш рет.
Dialogue: 0,0:21:55.81,0:21:57.56,Default,,0,0,0,,Үш массаж?
Dialogue: 0,0:21:57.64,0:22:00.65,Default,,0,0,0,,Ньяконы құтқарған бірінші болды.
Dialogue: 0,0:22:00.73,0:22:03.44,Default,,0,0,0,,Жарқанатты өлтіру үшін екі соққы
Dialogue: 0,0:22:03.53,0:22:07.90,Default,,0,0,0,,Және ол мені Чонмагеден қорғады, сондықтан мен оған үш рет соққы бердім.
Dialogue: 0,0:22:08.49,0:22:10.91,Default,,0,0,0,,Кеудеңді уқалағаным өтірік болды.
Dialogue: 0,0:22:10.99,0:22:14.41,Default,,0,0,0,,Ен Вуды қажырлы еңбегі үшін марапаттау үшін үш массаж
Dialogue: 0,0:22:14.49,0:22:16.71,Default,,0,0,0,,Оны ысқылағаныңыз үшін рахмет.
Dialogue: 0,0:22:16.79,0:22:21.79,Default,,0,0,0,,(Дэнджидің дөрекі тыныс алуы)
Dialogue: 0,0:22:23.88,0:22:25.46,Default,,0,0,0,,Періште
Dialogue: 0,0:22:26.80,0:22:31.80,Default,,0,0,0,,♪～
Dialogue: 0,0:23:50.84,0:23:55.85,Default,,0,0,0,,～♪
