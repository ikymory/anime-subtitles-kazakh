Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.87,0:00:05.54,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:15.59,0:00:19.56,Default,,0,0,0,,Аки осы бөлмеде шайтанмен келісім-шарт жасайды.
Dialogue: 0,0:00:20.27,0:00:22.27,Default,,0,0,0,,Бар нәрсе – болашақтың шайтаны
Dialogue: 0,0:00:22.35,0:00:25.60,Default,,0,0,0,,Бұл жігітпен қоғамдық қауіпсіздікте екі адамның келісім-шарттары бар.
Dialogue: 0,0:00:25.69,0:00:27.44,Default,,0,0,0,,Бір адамның жарты ғұмыры бар
Dialogue: 0,0:00:27.52,0:00:31.53,Default,,0,0,0,,Басқа адам көзін және дәм мен иіс сезу қабілетін созады.
Dialogue: 0,0:00:32.65,0:00:35.07,Default,,0,0,0,,Егер сізге ұнаса, арзанырақ болады.
Dialogue: 0,0:00:39.37,0:00:40.70,Default,,0,0,0,,Олай болса өтінемін
Dialogue: 0,0:00:53.67,0:00:55.51,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:01:03.56,0:01:06.06,Default,,0,0,0,,Болашақтың ең жақсысы
Dialogue: 0,0:01:06.14,0:01:08.31,Default,,0,0,0,,Болашақтың ең жақсысы
Dialogue: 0,0:01:08.40,0:01:11.32,Default,,0,0,0,,Болашақ - ең жақсы!
Dialogue: 0,0:01:11.98,0:01:17.11,Default,,0,0,0,,♪～
Dialogue: 0,0:02:33.69,0:02:38.70,Default,,0,0,0,,～♪
Dialogue: 0,0:02:42.99,0:02:48.20,Default,,0,0,0,,Ия, эй, болашақ ең жақсы! Болашақ - ең жақсы!
Dialogue: 0,0:02:48.96,0:02:51.21,Default,,0,0,0,,Сіз де «Болашақ – ең жақсы» деп айқайлауыңыз керек.
Dialogue: 0,0:02:51.29,0:02:53.84,Default,,0,0,0,,Мен сенімен шарт жасасуға келдім.
Dialogue: 0,0:02:54.54,0:02:56.59,Default,,0,0,0,,Менен не қалайтыныңды айт
Dialogue: 0,0:03:00.18,0:03:02.47,Default,,0,0,0,,Сізде ең нашар көзқарас бар.
Dialogue: 0,0:03:02.55,0:03:05.47,Default,,0,0,0,,Жарайды, болашағыңды көрсетші.
Dialogue: 0,0:03:05.56,0:03:08.98,Default,,0,0,0,,Болашаққа байланысты мен келісім-шарттың мазмұнын қарастырамын.
Dialogue: 0,0:03:09.64,0:03:11.85,Default,,0,0,0,,Тезірек басыңды менің ішіме тығы!
Dialogue: 0,0:03:11.94,0:03:14.61,Default,,0,0,0,,Әйтпесе, сіз болашақты көре алмайсыз.
Dialogue: 0,0:03:15.36,0:03:16.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:24.82,0:03:29.79,Default,,0,0,0,,(болашақ шайтанның гуілдеуі)
Dialogue: 0,0:03:29.87,0:03:30.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.83,0:03:33.29,Default,,0,0,0,,Иа... хаха...
Dialogue: 0,0:03:33.37,0:03:34.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:34.46,0:03:37.13,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:03:38.96,0:03:40.76,Default,,0,0,0,,Шарт осындай
Dialogue: 0,0:03:40.84,0:03:43.38,Default,,0,0,0,,Оң көзіңде өмір сүруге рұқсат ет
Dialogue: 0,0:03:43.47,0:03:46.89,Default,,0,0,0,,Осылай жасасаң, мен сенің күшіңе айналамын.
Dialogue: 0,0:03:49.81,0:03:52.39,Default,,0,0,0,,«Сізге осы ғана керек пе?» сіздің бетіңізде.
Dialogue: 0,0:03:52.48,0:03:56.65,Default,,0,0,0,,Өйткені сен болашақта ең жаман жолмен өлесің.
Dialogue: 0,0:03:57.94,0:04:00.61,Default,,0,0,0,,Қалай өлетініңді білгің келе ме?
Dialogue: 0,0:04:00.69,0:04:02.74,Default,,0,0,0,,Сіз... (Хаякава) Айтудың қажеті жоқ.
Dialogue: 0,0:04:03.24,0:04:06.20,Default,,0,0,0,,Мені қалай өлетінім қызықтырмайды.
Dialogue: 0,0:04:06.28,0:04:10.16,Default,,0,0,0,,Мен өлтіргім келген адамды өлтіре алатын болсам, маған не болатыны маңызды емес.
Dialogue: 0,0:04:10.25,0:04:12.41,Default,,0,0,0,,Оны тез көзіңізге салыңыз
Dialogue: 0,0:04:12.50,0:04:13.46,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:13.54,0:04:15.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:15.25,0:04:17.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:17.25,0:04:19.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:21.05,0:04:23.30,Default,,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:04:24.05,0:04:26.80,Default,,0,0,0,,Бұл 100 ұпайлық қозғалыс болды.
Dialogue: 0,0:04:27.39,0:04:30.31,Default,,0,0,0,,Бүгіннен бастап мен саған күнде сабақ берудің қажеті жоқ.
Dialogue: 0,0:04:30.89,0:04:32.43,Default,,0,0,0,,Аптасына бір рет жасаңыз
Dialogue: 0,0:04:32.52,0:04:34.23,Default,,0,0,0,,Иә
Dialogue: 0,0:04:34.31,0:04:35.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:36.48,0:04:39.57,Default,,0,0,0,,Көтеріңкі болса да миыңызды салқын ұстаңыз
Dialogue: 0,0:04:40.19,0:04:44.45,Default,,0,0,0,,Қолыңыздағы қаруды және жағдайды әрқашан есте сақтаңыз.
Dialogue: 0,0:04:44.53,0:04:47.95,Default,,0,0,0,,Нұсқауларға сүйене отырып, нақты шайқас ертең басталады.
Dialogue: 0,0:04:48.03,0:04:48.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:49.03,0:04:50.08,Default,,0,0,0,,Нақты ұрыс?
Dialogue: 0,0:04:50.16,0:04:53.75,Default,,0,0,0,,Химено мен басқаларды өлтірген самурай қылыш пен жылан әйел
Dialogue: 0,0:04:53.83,0:04:56.79,Default,,0,0,0,,Бәріміз барып оны ұстаймыз.
Dialogue: 0,0:04:56.87,0:04:59.63,Default,,0,0,0,,Бұл жаңа 4-ші бөлімнің ашылу салтанаты.
Dialogue: 0,0:04:59.71,0:05:03.01,Default,,0,0,0,,Егер бұл стратегия сәтсіз болса, 4-сабақ аяқталады.
Dialogue: 0,0:05:05.13,0:05:09.47,Default,,0,0,0,,Егер бұл орын алса, бәрің де жойылып, менімен ауыр шайқасасыңдар.
Dialogue: 0,0:05:11.51,0:05:12.47,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:12.56,0:05:17.15,Default,,0,0,0,,Олай болса, мұғалімді өлтірмей жіберемін.
Dialogue: 0,0:05:17.65,0:05:18.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:18.56,0:05:21.07,Default,,0,0,0,,Себебі сен мені күшейттің
Dialogue: 0,0:05:21.15,0:05:23.36,Default,,0,0,0,,Енді сіз көбірек жындарды өлтіре аласыз
Dialogue: 0,0:05:23.44,0:05:26.61,Default,,0,0,0,,Сосын мен Макима-санмен кездесемін.
Dialogue: 0,0:05:34.04,0:05:37.75,Default,,0,0,0,,Жұмыс кестеңіздің тығыздығына қарамастан осы жолы тынымсыз еңбек еткеніңіз үшін рахмет.
Dialogue: 0,0:05:38.37,0:05:40.17,Default,,0,0,0,,Бұдан былай Дэнджи-кун мен Пауэр-чан
Dialogue: 0,0:05:40.25,0:05:42.13,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:05:44.92,0:05:48.01,Default,,0,0,0,,Мен оларды жек көре бастадым.
Dialogue: 0,0:05:48.09,0:05:49.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:49.51,0:05:53.31,Default,,0,0,0,,Мен өсірген ит өлген сайын ішетін спиртім көбейеді.
Dialogue: 0,0:05:54.93,0:05:59.15,Default,,0,0,0,,Ойыншық сынып қалса, өзімді кінәлі санамаймын деп ойладым, бірақ...
Dialogue: 0,0:05:59.73,0:06:03.69,Default,,0,0,0,,Осы жасқа келгенде жалығып, ойыншықтарға деген сезім пайда болады.
Dialogue: 0,0:06:07.49,0:06:10.41,Default,,0,0,0,,Сонымен әңгіме дегеніміз не?
Dialogue: 0,0:06:10.49,0:06:13.74,Default,,0,0,0,,Бұл арнайы дивизияның шабуылы...
Dialogue: 0,0:06:13.83,0:06:16.04,Default,,0,0,0,,Қоғамдық қауіпсіздік те ақымақ емес, солай ма?
Dialogue: 0,0:06:16.62,0:06:20.04,Default,,0,0,0,,Білдің, бірақ жіберіп алдың.
Dialogue: 0,0:06:20.12,0:06:22.54,Default,,0,0,0,,Маған да шабуыл жасалды.
Dialogue: 0,0:06:24.21,0:06:28.55,Default,,0,0,0,,Қанша қатыгез болсаң да, менің итімді өлтіруге тырыссаң да.
Dialogue: 0,0:06:28.63,0:06:32.80,Default,,0,0,0,,Мен адамдар жағында болғанша, мен оны елемеймін.
Dialogue: 0,0:06:34.93,0:06:36.31,Default,,0,0,0,,«Учиха»
Dialogue: 0,0:06:38.39,0:06:42.81,Default,,0,0,0,,Мен мүмкіндігінше көп адамды шайтаннан құтқарғым келеді.
Dialogue: 0,0:06:43.44,0:06:45.82,Default,,0,0,0,,Бұл операция сәтті орындалса
Dialogue: 0,0:06:45.90,0:06:50.20,Default,,0,0,0,,4-бөлімнің бар екендігі туралы белсенді түрде хабарлау қажет.
Dialogue: 0,0:06:50.70,0:06:53.91,Default,,0,0,0,,Егер біз мұны жасасақ, 4-бөлімге қазіргіге қарағанда жылжу оңайырақ болады.
Dialogue: 0,0:06:53.99,0:06:56.08,Default,,0,0,0,,Сіз адамдарды жындардан құтқара аласыз
Dialogue: 0,0:06:58.83,0:06:59.83,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:07:13.30,0:07:15.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:16.72,0:07:19.48,Default,,0,0,0,,Бастық виллаға көшірілді.
Dialogue: 0,0:07:19.56,0:07:20.48,Default,,0,0,0,,Жас...
Dialogue: 0,0:07:20.56,0:07:24.11,Default,,0,0,0,,Макима тірі болғанша, Жапонияда қашатын жер жоқ.
Dialogue: 0,0:07:24.19,0:07:26.98,Default,,0,0,0,,Біз сізді осы жерде ұстауға дайындалып жатырмыз.
Dialogue: 0,0:07:27.07,0:07:27.98,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,0:07:28.07,0:07:29.49,Default,,0,0,0,,Әйелдер, аузыңды жап!
Dialogue: 0,0:07:29.57,0:07:30.61,Default,,0,0,0,,Жас…
Dialogue: 0,0:07:32.66,0:07:35.74,Default,,0,0,0,,Атам осында болса, мен оның қашып кетуіне жол бермеймін.
Dialogue: 0,0:07:35.83,0:07:39.20,Default,,0,0,0,,Сонымен қатар, 4-бөлімде қарғыс атқан Денжи бар.
Dialogue: 0,0:07:39.29,0:07:42.25,Default,,0,0,0,,Келесі жолы жүрегіңді жұлып аламын
Dialogue: 0,0:07:42.33,0:07:45.25,Default,,0,0,0,,Жастық шағыңызға алаңдаудың қажеті жоқ.
Dialogue: 0,0:07:45.33,0:07:47.21,Default,,0,0,0,,Өлсем де, қайта тірілемін.
Dialogue: 0,0:07:47.71,0:07:51.67,Default,,0,0,0,,Осы жерде қалсаңыз, тістеп алмау үшін сақ болыңыз.
Dialogue: 0,0:07:51.76,0:07:53.26,Default,,0,0,0,,Шағудан қалай сақтануға болады?
Dialogue: 0,0:07:53.34,0:07:54.51,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:55.80,0:07:58.51,Default,,0,0,0,,Төменде құпия қару бар.
Dialogue: 0,0:07:58.60,0:08:00.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:00.60,0:08:02.98,Default,,0,0,0,,Атаның кәдесыйы—
Dialogue: 0,0:08:00.60,0:08:02.98,Default,,0,0,0,,(зомбилердің ыңырануы)
Dialogue: 0,0:08:02.98,0:08:03.06,Default,,0,0,0,,(зомбилердің ыңырануы)
Dialogue: 0,0:08:03.06,0:08:06.52,Default,,0,0,0,,Бұл қарызын өтей алмайтын қоқыстан тұратын зомби армиясы.
Dialogue: 0,0:08:03.06,0:08:06.52,Default,,0,0,0,,(зомбилердің ыңырануы)
Dialogue: 0,0:08:07.15,0:08:09.90,Default,,0,0,0,,Зомби тістеген адам зомбиге айналады.
Dialogue: 0,0:08:10.86,0:08:12.99,Default,,0,0,0,,4-сабақты аяқтайды.
Dialogue: 0,0:08:16.74,0:08:20.41,Default,,0,0,0,,Токионың көрікті жерлерін аралап, Киотоға қайтамыз.
Dialogue: 0,0:08:20.91,0:08:25.42,Default,,0,0,0,,Біз енді кездеспейтін шығармыз, мен сізге бір сұрақ қояйын.
Dialogue: 0,0:08:25.50,0:08:28.88,Default,,0,0,0,,Мен Акикун мылтық шайтанды көздеп отыр деп естідім.
Dialogue: 0,0:08:29.38,0:08:31.51,Default,,0,0,0,,Сіз шынымен мені өлтіре аламын деп ойлайсыз ба?
Dialogue: 0,0:08:32.01,0:08:37.01,Default,,0,0,0,,Бұл жолы сіз арнайы дивизияның 20-ға жуық мүшесін өлтірген жігіттен жеңілдіңіз.
Dialogue: 0,0:08:37.09,0:08:41.31,Default,,0,0,0,,Дүние жүзіндегі миллиондаған адамдарды өлтірген жігітті жеңе аласыз деп ойлайсыз ба?
Dialogue: 0,0:08:42.27,0:08:43.98,Default,,0,0,0,,Шын мәнінде, біз де
Dialogue: 0,0:08:44.06,0:08:47.48,Default,,0,0,0,,Мылтық шайтан мені бұзып жіберді деп ашуланып полиция бөлімшесіне келдім.
Dialogue: 0,0:08:48.56,0:08:51.65,Default,,0,0,0,,Бірақ мен мылтық шайтанды өлтіремін деп ойламаймын.
Dialogue: 0,0:08:51.73,0:08:54.24,Default,,0,0,0,,Егер сіз бұл туралы әдеттегідей ойласаңыз, бұл мүмкін емес екенін білесіз.
Dialogue: 0,0:08:56.74,0:08:59.78,Default,,0,0,0,,Шынымды айтсам, Акикун, саған қарасам ренжіп қаламын.
Dialogue: 0,0:09:00.28,0:09:03.79,Default,,0,0,0,,Мен әлсіз болсам да, мангадағы басты кейіпкер сияқты мақсат қоямын.
Dialogue: 0,0:09:03.87,0:09:06.08,Default,,0,0,0,,Ауырды, менде сүйел бар.
Dialogue: 0,0:09:06.62,0:09:08.58,Default,,0,0,0,,Эй, тұр, жарай ма?
Dialogue: 0,0:09:08.67,0:09:09.79,Default,,0,0,0,,Менің орнымнан тұрғым келмейді.
Dialogue: 0,0:09:15.51,0:09:18.51,Default,,0,0,0,,Өтінемін, менің алдымда әлек болма.
Dialogue: 0,0:09:18.59,0:09:21.39,Default,,0,0,0,,Сіз жай ғана аузыңызды жауып, көре аласыз.
Dialogue: 0,0:09:21.47,0:09:25.39,Default,,0,0,0,,Мен жеңіліп өлсем келіп күліңізші.
Dialogue: 0,0:09:26.89,0:09:29.11,Default,,0,0,0,,Енді мен өзімді көре алмаймын
Dialogue: 0,0:09:29.19,0:09:30.77,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:09:30.86,0:09:32.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:32.78,0:09:35.49,Default,,0,0,0,,Мен онсыз істей алмайтынымды білемін.
Dialogue: 0,0:09:46.41,0:09:48.33,Default,,0,0,0,,Нұсқауларыңыз үшін рахмет.
Dialogue: 0,0:09:53.42,0:09:54.76,Default,,0,0,0,,Аки-кун!
Dialogue: 0,0:09:56.38,0:09:59.68,Default,,0,0,0,,Мен саған ренжідім, бірақ мен сені қолдаймын.
Dialogue: 0,0:09:59.76,0:10:01.68,Default,,0,0,0,,Соңында мына сөздерді ұсынамын.
Dialogue: 0,0:10:02.85,0:10:06.56,Default,,0,0,0,,«Арнайы бөлімде лайықты адамдар жоқ, сондықтан сақ болыңыз!»
Dialogue: 0,0:10:23.08,0:10:26.70,Default,,0,0,0,,Сіз қоғамдық қауіпсіздіктің тұтынушысысыз. Қымбат шай дайындаңыз.
Dialogue: 0,0:10:27.37,0:10:29.46,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:10:29.54,0:10:31.58,Default,,0,0,0,,Токиода, менің жастарым
Dialogue: 0,0:10:31.67,0:10:34.34,Default,,0,0,0,,Сіз мұны рұқсатсыз жасағаныңызды көру өте керемет.
Dialogue: 0,0:10:34.42,0:10:36.71,Default,,0,0,0,,Қаласаңыз, мен жауап беремін.
Dialogue: 0,0:10:37.30,0:10:40.80,Default,,0,0,0,,Бұл менің нұсқауларым емес екенін түсінгеніңізді қалаймын.
Dialogue: 0,0:10:41.55,0:10:45.97,Default,,0,0,0,,Менің естігенім бойынша, Саватари есімді осы әйел ұйымдастырушы.
Dialogue: 0,0:10:46.77,0:10:50.02,Default,,0,0,0,,Менің жігітім осы әйелді делдал етіп алдап кеткен.
Dialogue: 0,0:10:50.10,0:10:53.27,Default,,0,0,0,,Мылтық шайтанмен мәміле жасаған сияқты.
Dialogue: 0,0:10:53.77,0:10:55.36,Default,,0,0,0,,Келісімшарттың мазмұны қандай?
Dialogue: 0,0:10:55.44,0:10:58.86,Default,,0,0,0,,Мылтық шайтанға 20 000 иен төлеудің орнына
Dialogue: 0,0:10:58.94,0:11:01.86,Default,,0,0,0,,Мердігер мылтық пен оқтарды алады.
Dialogue: 0,0:11:02.53,0:11:05.83,Default,,0,0,0,,Ібіліс әлеміне де ақша керек пе?
Dialogue: 0,0:11:06.37,0:11:08.87,Default,,0,0,0,,Адамшылықтан айырмашылығы жоқ.
Dialogue: 0,0:11:10.16,0:11:13.63,Default,,0,0,0,,Топтағы мылтық шайтанмен келісімшарты бар адамның аты-жөні.
Dialogue: 0,0:11:13.71,0:11:15.75,Default,,0,0,0,,Барлығын осында жазыңыз
Dialogue: 0,0:11:15.84,0:11:17.76,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:11:17.84,0:11:20.88,Default,,0,0,0,,Маған біраз демалып, ой жүгіртуге рұқсат етіңіз.
Dialogue: 0,0:11:20.97,0:11:23.89,Default,,0,0,0,,Тобыңыздың атына қосымша
Dialogue: 0,0:11:23.97,0:11:26.72,Default,,0,0,0,,Басқа топтарға да беріңіз.
Dialogue: 0,0:11:26.81,0:11:27.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:29.52,0:11:34.65,Default,,0,0,0,,Кішкентай қыз, сен тіпті түсінбейсің.
Dialogue: 0,0:11:34.73,0:11:37.86,Default,,0,0,0,,Соны білсең де, Ақиқатын білсең
Dialogue: 0,0:11:37.94,0:11:40.86,Default,,0,0,0,,Топтар арасында соғыс басталады.
Dialogue: 0,0:11:40.95,0:11:42.41,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:11:42.49,0:11:45.24,Default,,0,0,0,,Адамдардың қауіпсіздігі үшін
Dialogue: 0,0:11:45.32,0:11:46.78,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:11:57.92,0:12:02.80,Default,,0,0,0,,Ханым, сіз «қажетті зұлымдық» тіркесін білесіз бе?
Dialogue: 0,0:12:02.88,0:12:06.22,Default,,0,0,0,,Туыстар арасында бір-бірімізді құртайық.
Dialogue: 0,0:12:06.30,0:12:10.31,Default,,0,0,0,,Сосын бұл арада Жапонияға шетелдік мафиялар кіреді.
Dialogue: 0,0:12:11.10,0:12:13.81,Default,,0,0,0,,Біздің де кінәміз бар екені рас.
Dialogue: 0,0:12:13.89,0:12:18.61,Default,,0,0,0,,Қытай мен кеңес мафиясы бұдан да жаман істер жасайды, солай емес пе?
Dialogue: 0,0:12:18.69,0:12:21.36,Default,,0,0,0,,Біз бұған жол бермейміз.
Dialogue: 0,0:12:28.16,0:12:32.12,Default,,0,0,0,,Шайтан аңшылары адамдарды жындардан қорғайтыны сияқты.
Dialogue: 0,0:12:32.20,0:12:36.92,Default,,0,0,0,,Біз якудза да жапондықтарды шетелдіктерден қорғаймыз.
Dialogue: 0,0:12:37.50,0:12:40.42,Default,,0,0,0,,Ібіліс аулаушылардың арасында білімсіз ақымақтар көп.
Dialogue: 0,0:12:40.50,0:12:42.01,Default,,0,0,0,,Менің білмеуім табиғи нәрсе деп ойлаймын.
Dialogue: 0,0:12:42.09,0:12:45.97,Default,,0,0,0,,Ха-ха-ха-ха…
Dialogue: 0,0:12:47.18,0:12:48.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.76,0:12:51.97,Default,,0,0,0,,Достарыңды арзан ақшаға сата алмайсың.
Dialogue: 0,0:12:52.06,0:12:54.35,Default,,0,0,0,,Бұл ақша емес
Dialogue: 0,0:12:55.10,0:13:00.27,Default,,0,0,0,,Мұндағы бәріңнің әкелерің, шешелерің, аталарың.
Dialogue: 0,0:13:00.36,0:13:04.90,Default,,0,0,0,,Аға, әпке, ғашық, әйелдің...
Dialogue: 0,0:13:04.99,0:13:06.86,Default,,0,0,0,,Көз
Dialogue: 0,0:13:07.53,0:13:08.87,Default,,0,0,0,,Көздер?
Dialogue: 0,0:13:14.04,0:13:16.08,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:13:16.17,0:13:17.58,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:13:17.67,0:13:21.50,Default,,0,0,0,,Қоғамдық қауіпсіздікте көздерін қалпына келтіретін адамдар бар.
Dialogue: 0,0:13:17.67,0:13:21.50,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:13:21.59,0:13:23.55,Default,,0,0,0,,Егер бізге көмектесе алсаңыз
Dialogue: 0,0:13:23.63,0:13:25.34,Default,,0,0,0,,Мен сізді сол адаммен (мүшемен) таныстыруға рұқсат етіңіз...
Dialogue: 0,0:13:26.43,0:13:27.34,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:13:30.68,0:13:31.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:33.85,0:13:34.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.69,0:13:37.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:38.02,0:13:40.94,Default,,0,0,0,,(мүшелердің қауесеттері)
Dialogue: 0,0:13:41.02,0:13:44.07,Default,,0,0,0,,«Қажетті зұлымдық» дегенді қалай түсінесіңдер?
Dialogue: 0,0:13:44.15,0:13:47.74,Default,,0,0,0,,Бұл өз қателігін ақтау үшін сылтау.
Dialogue: 0,0:13:47.82,0:13:50.99,Default,,0,0,0,,Қоғамға мұндай сылтау қажет емес.
Dialogue: 0,0:13:47.82,0:13:50.99,Default,,0,0,0,,Ах, а... а...
Dialogue: 0,0:13:51.08,0:13:53.41,Default,,0,0,0,,Қажетті жамандық
Dialogue: 0,0:13:53.49,0:13:57.75,Default,,0,0,0,,Ол әрқашан мемлекеттің бақылауында болды.
Dialogue: 0,0:13:57.83,0:13:59.50,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:13:59.58,0:14:04.26,Default,,0,0,0,,Жертөле мен бірінші қабаттың кіреберістері Сиқырға қарсы 2-бөліммен және полициямен қоршалған.
Dialogue: 0,0:14:04.34,0:14:08.05,Default,,0,0,0,,Ғимараттағы барлық бақылау 4-сингулярлық бөлімге қалдырылады.
Dialogue: 0,0:14:08.59,0:14:12.51,Default,,0,0,0,,Мүмкіндігінше көп қоғамдық қауіпсіздік қызметкерлерін өлтіріп, Денджидің жүрегін ұрлаңыз.
Dialogue: 0,0:14:12.60,0:14:15.06,Default,,0,0,0,,Осыдан кейін жыланды пайдаланыңыз.
Dialogue: 0,0:14:15.14,0:14:17.27,Default,,0,0,0,,Менің ойымша, сіз бен біз құтыламыз.
Dialogue: 0,0:14:18.56,0:14:20.27,Default,,0,0,0,,Мен Дэнджиді өлтіремін.
Dialogue: 0,0:14:20.90,0:14:22.77,Default,,0,0,0,,Тым қызып кетпеңіз
Dialogue: 0,0:14:28.07,0:14:30.41,Default,,0,0,0,,Уф... Мен үйге барғым келеді.
Dialogue: 0,0:14:30.49,0:14:30.87,Default,,0,0,0,,Үйге барғың келсе, үйге бару керек.
Dialogue: 0,0:14:30.87,0:14:31.91,Default,,0,0,0,,Үйге барғың келсе, үйге бару керек.
Dialogue: 0,0:14:30.87,0:14:31.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:31.91,0:14:33.33,Default,,0,0,0,,Үйге барғың келсе, үйге бару керек.
Dialogue: 0,0:14:33.41,0:14:35.87,Default,,0,0,0,,Өйткені мен арнайы дайындықтан өттім.
Dialogue: 0,0:14:35.95,0:14:38.96,Default,,0,0,0,,Мен анау ананы өлтіремін.
Dialogue: 0,0:14:39.04,0:14:42.08,Default,,0,0,0,,Арнайы дайындық пен ақылды болғаныңыз үшін рахмет.
Dialogue: 0,0:14:42.17,0:14:44.67,Default,,0,0,0,,Оңай жеңіс! Гахахаха...
Dialogue: 0,0:14:44.75,0:14:47.17,Default,,0,0,0,,Хахаха... Гахаха... Хмм...
Dialogue: 0,0:14:47.26,0:14:48.42,Default,,0,0,0,,Ерен, көрдің бе?
Dialogue: 0,0:14:48.51,0:14:52.68,Default,,0,0,0,,Ху... (Күш) Хахахаха...
Dialogue: 0,0:14:55.14,0:14:56.27,Default,,0,0,0,,Стратегия дегеніміз не?
Dialogue: 0,0:14:56.93,0:14:58.56,Default,,0,0,0,,Стратегия жоқ
Dialogue: 0,0:14:58.64,0:15:02.94,Default,,0,0,0,,Арнайы бөлімді толығымен ғимаратқа тастаңыз.
Dialogue: 0,0:15:13.12,0:15:14.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:14.78,0:15:18.45,Default,,0,0,0,,Мен Шиинамын, Канагава префектурасының полиция инспекторы.
Dialogue: 0,0:15:18.54,0:15:20.21,Default,,0,0,0,,Бұл Сиқырға қарсы 2 бөлімінің Фуруно.
Dialogue: 0,0:15:20.29,0:15:23.71,Default,,0,0,0,,Бұл Кішібе, 4-ші ерекшелік дивизиясының капитаны.
Dialogue: 0,0:15:24.29,0:15:29.09,Default,,0,0,0,,Бұл жолы полиция мен 2-Сиқырға қарсы бөлімше бірінші қабаттағы және жертөледегі кіреберістерді жауып тастады.
Dialogue: 0,0:15:29.17,0:15:32.72,Default,,0,0,0,,Арнайы 4-бөлімде ішіндегі террористерді басу
Dialogue: 0,0:15:33.34,0:15:37.72,Default,,0,0,0,,Тек бір нәрседен сақ болу керек.
Dialogue: 0,0:15:37.81,0:15:42.48,Default,,0,0,0,,Бірегей 4-бөлім мүшелерінің көпшілігі адам емес адамдардан тұрады.
Dialogue: 0,0:15:42.56,0:15:44.90,Default,,0,0,0,,4-бөлімдегі біреу қалаға қашып кетсе ше?
Dialogue: 0,0:15:44.98,0:15:48.48,Default,,0,0,0,,Лаңкестер шабуылға шыққаннан гөрі көп зиян келтіреді.
Dialogue: 0,0:15:49.23,0:15:51.99,Default,,0,0,0,,Бұл жолы сіз террорист емессіз.
Dialogue: 0,0:15:52.07,0:15:57.49,Default,,0,0,0,,4-бөліммен шайқасқа түскен жағдайда мүшелердің ерекшеліктерін түсіндіріңіз.
Dialogue: 0,0:15:57.58,0:16:00.00,Default,,0,0,0,,Зомбилер! зомби!
Dialogue: 0,0:16:00.08,0:16:03.00,Default,,0,0,0,,Кяхаха...
Dialogue: 0,0:16:03.08,0:16:06.25,Default,,0,0,0,,Барлығын жеуге болады!
Dialogue: 0,0:16:10.09,0:16:10.76,Default,,0,0,0,,Гаа!
Dialogue: 0,0:16:10.76,0:16:11.63,Default,,0,0,0,,Шарк Мажин
Dialogue: 0,0:16:10.76,0:16:11.63,Default,,0,0,0,,Гаа!
Dialogue: 0,0:16:11.63,0:16:11.72,Default,,0,0,0,,Шарк Мажин
Dialogue: 0,0:16:11.72,0:16:12.17,Default,,0,0,0,,Шарк Мажин
Dialogue: 0,0:16:11.72,0:16:12.17,Default,,0,0,0,,О!
Dialogue: 0,0:16:12.17,0:16:12.26,Default,,0,0,0,,О!
Dialogue: 0,0:16:12.26,0:16:13.26,Default,,0,0,0,,Сіз кез келген жерде, қабырғалардың ішінде немесе жерде жүзе аласыз.
Dialogue: 0,0:16:12.26,0:16:13.26,Default,,0,0,0,,О!
Dialogue: 0,0:16:13.26,0:16:13.34,Default,,0,0,0,,Сіз кез келген жерде, қабырғалардың ішінде немесе жерде жүзе аласыз.
Dialogue: 0,0:16:13.34,0:16:15.51,Default,,0,0,0,,Сіз кез келген жерде, қабырғалардың ішінде немесе жерде жүзе аласыз.
Dialogue: 0,0:16:13.34,0:16:15.51,Default,,0,0,0,,Ха! Хи хи хи...
Dialogue: 0,0:16:16.18,0:16:16.39,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:16.39,0:16:17.35,Default,,0,0,0,,Бұл жігіт аз уақыт ішінде жын кейпіне де ие бола алады.
Dialogue: 0,0:16:16.39,0:16:17.35,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:17.35,0:16:18.18,Default,,0,0,0,,Бұл жігіт аз уақыт ішінде жын кейпіне де ие бола алады.
Dialogue: 0,0:16:18.18,0:16:19.18,Default,,0,0,0,,Бұл жігіт аз уақыт ішінде жын кейпіне де ие бола алады.
Dialogue: 0,0:16:18.18,0:16:19.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:19.93,0:16:21.14,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:21.23,0:16:22.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:22.77,0:16:23.81,Default,,0,0,0,,Гаа…
Dialogue: 0,0:16:23.89,0:16:24.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:25.06,0:16:26.31,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:16:27.82,0:16:29.86,Default,,0,0,0,,О, кешіріңіз! (Шарк Маджин) Уф...
Dialogue: 0,0:16:30.65,0:16:32.74,Default,,0,0,0,,Мен оны тістеп алғандықтан зомби деп ойладым.
Dialogue: 0,0:16:34.03,0:16:35.61,Default,,0,0,0,,Сәлем! Уф...
Dialogue: 0,0:16:35.70,0:16:36.53,Default,,0,0,0,,Зорлық-зомбылық жын
Dialogue: 0,0:16:36.53,0:16:37.41,Default,,0,0,0,,Зорлық-зомбылық жын
Dialogue: 0,0:16:36.53,0:16:37.41,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:16:37.41,0:16:38.03,Default,,0,0,0,,Зорлық-зомбылық жын
Dialogue: 0,0:16:38.12,0:16:40.16,Default,,0,0,0,,Бастапқыда жын болған кезде, жын болған кездегіден әлсірейді, бірақ...
Dialogue: 0,0:16:38.12,0:16:40.16,Default,,0,0,0,,Иә! Эй!
Dialogue: 0,0:16:40.16,0:16:40.24,Default,,0,0,0,,Бастапқыда жын болған кезде, жын болған кездегіден әлсірейді, бірақ...
Dialogue: 0,0:16:40.24,0:16:41.12,Default,,0,0,0,,Бастапқыда жын болған кезде, жын болған кездегіден әлсірейді, бірақ...
Dialogue: 0,0:16:40.24,0:16:41.12,Default,,0,0,0,,О, менің...
Dialogue: 0,0:16:41.20,0:16:46.13,Default,,0,0,0,,Бұл жігіт тіпті жынға да тым күшті, сондықтан мен оған у шығаратын маска кигіземін.
Dialogue: 0,0:16:46.21,0:16:49.21,Default,,0,0,0,,Не болса да, мына жігіттің маскасын шешпе.
Dialogue: 0,0:16:50.34,0:16:53.59,Default,,0,0,0,,Анау қыз, қашу керек.
Dialogue: 0,0:16:53.67,0:16:56.55,Default,,0,0,0,,If a human is bitten, they will turn into a zombie.
Dialogue: 0,0:16:57.89,0:16:58.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:58.80,0:17:00.85,Default,,0,0,0,,Не, шайтан?
Dialogue: 0,0:17:04.35,0:17:06.15,Default,,0,0,0,,Өрмекші жын
Dialogue: 0,0:17:06.23,0:17:08.77,Default,,0,0,0,,Әдетте адамға ұқсайды
Dialogue: 0,0:17:09.44,0:17:13.99,Default,,0,0,0,,Demons that resemble humans are friendly to humans, but demons are demons.
Dialogue: 0,0:17:14.07,0:17:14.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:14.99,0:17:16.91,Default,,0,0,0,,Мен біреуді ашуланып өлтіремін.
Dialogue: 0,0:17:16.99,0:17:18.03,Default,,0,0,0,,Уф
Dialogue: 0,0:17:22.45,0:17:25.96,Default,,0,0,0,,Уф... аяқ киім лас.
Dialogue: 0,0:17:26.04,0:17:27.75,Default,,0,0,0,,This guy is the worst
Dialogue: 0,0:17:30.54,0:17:31.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:33.34,0:17:34.63,Default,,0,0,0,,Періште жын
Dialogue: 0,0:17:34.72,0:17:39.14,Default,,0,0,0,,This is a special demon and has no hostility toward humans, but don't get close to it.
Dialogue: 0,0:17:39.22,0:17:42.51,Default,,0,0,0,,If you touch it, your life will be drained away.
Dialogue: 0,0:17:42.60,0:17:44.06,Default,,0,0,0,,Фуууууууууу... (қуат) Эй!
Dialogue: 0,0:17:44.14,0:17:46.19,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:46.27,0:17:47.19,Default,,0,0,0,,А...
Dialogue: 0,0:17:47.27,0:17:48.90,Default,,0,0,0,,Ah... (Hayakawa) Ugh.
Dialogue: 0,0:17:51.02,0:17:51.86,Default,,0,0,0,,Фу…
Dialogue: 0,0:17:53.78,0:17:56.74,Default,,0,0,0,,You over there, don't you have a handkerchief?
Dialogue: 0,0:18:02.58,0:18:08.50,Default,,0,0,0,,(Voices of the shark demon and the violent demon fighting)
Dialogue: 0,0:18:08.58,0:18:11.13,Default,,0,0,0,,You often come close to me.
Dialogue: 0,0:18:11.21,0:18:13.75,Default,,0,0,0,,If you are touched, your lifespan will be short...
Dialogue: 0,0:18:14.34,0:18:16.26,Default,,0,0,0,,If it's through cloth, it's okay, right?
Dialogue: 0,0:18:16.34,0:18:17.51,Default,,0,0,0,,Huh (Hayakawa) Ah.
Dialogue: 0,0:18:17.59,0:18:18.63,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:18.72,0:18:19.64,Default,,0,0,0,,Аа, дәл осы.
Dialogue: 0,0:18:19.72,0:18:21.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:21.14,0:18:21.97,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:24.56,0:18:27.10,Default,,0,0,0,,Devil, carry this guy outside.
Dialogue: 0,0:18:27.18,0:18:29.27,Default,,0,0,0,,Бұйрық...
Dialogue: 0,0:18:29.81,0:18:32.48,Default,,0,0,0,,Әйтеуір, төбелескеннен жақсы.
Dialogue: 0,0:18:32.56,0:18:34.36,Default,,0,0,0,,You guys (Дэндзи Kobeni Пауэр) huh?
Dialogue: 0,0:18:34.44,0:18:39.36,Default,,0,0,0,,Leave this to the demons and look for the samurai sword and snake woman.
Dialogue: 0,0:18:39.45,0:18:42.07,Default,,0,0,0,,А? Ate ше?
Dialogue: 0,0:18:42.16,0:18:44.95,Default,,0,0,0,,No. Search by division.
Dialogue: 0,0:18:59.01,0:19:00.47,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:19:19.49,0:19:20.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:21.49,0:19:22.82,Default,,0,0,0,,Ugh... (Henchman) Ah...
Dialogue: 0,0:19:22.91,0:19:24.12,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:19:24.20,0:19:25.49,Default,,0,0,0,,Гугга…
Dialogue: 0,0:19:26.08,0:19:27.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:30.00,0:19:31.37,Default,,0,0,0,,Ах
Dialogue: 0,0:19:36.71,0:19:38.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:41.01,0:19:43.01,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:19:45.18,0:19:47.18,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:19:48.31,0:19:49.89,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:19:52.14,0:19:53.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:39.07,0:20:41.36,Default,,0,0,0,,Момындықпен берілу (саватари) Жылан
Dialogue: 0,0:20:41.94,0:20:43.11,Default,,0,0,0,,Түкіру
Dialogue: 0,0:20:44.61,0:20:45.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:47.95,0:20:49.58,Default,,0,0,0,,Ах... ха
Dialogue: 0,0:20:54.67,0:20:56.33,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:21:01.51,0:21:04.22,Default,,0,0,0,,Оны өлтіріңіз.
Dialogue: 0,0:21:08.51,0:21:11.18,Default,,0,0,0,,Уф... Уф... Уф
Dialogue: 0,0:21:12.56,0:21:13.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:13.93,0:21:17.35,Default,,0,0,0,,Ugh uh… uh uh uh…
Dialogue: 0,0:21:19.98,0:21:22.28,Default,,0,0,0,,Мен бұрынғыға қарағанда көбірек қозғала аламын.
Dialogue: 0,0:21:22.36,0:21:24.44,Default,,0,0,0,,Егер мен өз күшімді пайдалансам
Dialogue: 0,0:21:24.53,0:21:27.66,Default,,0,0,0,,Your right eye can see a little into the future.
Dialogue: 0,0:21:29.74,0:21:30.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:32.70,0:21:35.50,Default,,0,0,0,,Уф... мм...
Dialogue: 0,0:21:36.29,0:21:37.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:38.50,0:21:40.00,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:21:40.79,0:21:41.92,Default,,0,0,0,,Уф
Dialogue: 0,0:21:44.67,0:21:45.51,Default,,0,0,0,,Ха...
Dialogue: 0,0:21:46.17,0:21:48.30,Default,,0,0,0,,Тек көрініп тұр.
Dialogue: 0,0:21:49.68,0:21:50.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:54.31,0:21:55.73,Default,,0,0,0,,Гах гах...
Dialogue: 0,0:21:56.56,0:21:58.73,Default,,0,0,0,,Уф, аа... гах...
Dialogue: 0,0:22:00.40,0:22:01.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:04.40,0:22:05.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:06.65,0:22:07.49,Default,,0,0,0,,Гррр…
Dialogue: 0,0:22:07.57,0:22:09.74,Default,,0,0,0,,Just strangle him to death
Dialogue: 0,0:22:10.41,0:22:11.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:13.58,0:22:18.12,Default,,0,0,0,,Каа аа аа аа... аа...
Dialogue: 0,0:22:26.01,0:22:31.18,Default,,0,0,0,,♪～
Dialogue: 0,0:23:50.01,0:23:55.01,Default,,0,0,0,,～♪
Dialogue: 0,0:23:56.51,0:24:02.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory