Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:41.60,0:00:44.17,Default,,0,0,0,,Сондай-ақ алдау ма?
Dialogue: 0,0:00:44.61,0:00:47.38,Default,,0,0,0,,Тез кел 401
Dialogue: 0,0:00:48.41,0:00:50.41,Default,,0,0,0,,Мен оны суға батырамын
Dialogue: 0,0:00:51.18,0:00:57.19,Default,,0,0,0,,♪～
Dialogue: 0,0:02:12.59,0:02:18.60,Default,,0,0,0,,～♪
Dialogue: 0,0:02:33.21,0:02:35.15,Default,,0,0,0,,Белсенді алдау жойылды
Dialogue: 0,0:02:35.72,0:02:38.55,Default,,0,0,0,,Тағы үш белсенді алдау
Dialogue: 0,0:02:38.62,0:02:40.42,Default,,0,0,0,,Сонар! Такаоның жағдайы қандай?
Dialogue: 0,0:02:41.19,0:02:44.46,Default,,0,0,0,,Тайфунның көзінде әлі де теңізде жүзу.
Dialogue: 0,0:02:45.26,0:02:47.40,Default,,0,0,0,,Ауыр крейсер
Dialogue: 0,0:02:47.46,0:02:48.86,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:02:49.76,0:02:51.93,Default,,0,0,0,,Кеме қанша тұман болса да,
Dialogue: 0,0:02:52.20,0:02:53.37,Default,,0,0,0,,Осы ауа райы жағдайында
Dialogue: 0,0:02:53.43,0:02:56.20,Default,,0,0,0,,Жауларды іздеу қабілеті төмендейді деп ойладым.
Dialogue: 0,0:02:56.27,0:02:59.34,Default,,0,0,0,,Такао бұл алдамшыға дәл тиіп тұр.
Dialogue: 0,0:02:59.91,0:03:03.38,Default,,0,0,0,,Иона, өтінемін, батып кеткен азғынның сюжетін беріңізші.
Dialogue: 0,0:03:03.44,0:03:04.75,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:03:07.72,0:03:10.18,Default,,0,0,0,,Такаоның жауды іздеу радиусын қабаттастырыңыз
Dialogue: 0,0:03:10.25,0:03:11.62,Default,,0,0,0,,Қабаттау
Dialogue: 0,0:03:15.69,0:03:16.62,Default,,0,0,0,,Бұл тамаша емес пе?
Dialogue: 0,0:03:16.96,0:03:18.19,Default,,0,0,0,,О
Dialogue: 0,0:03:18.29,0:03:21.20,Default,,0,0,0,,Такаоның жауларды іздеу қабілеті мен ойлағандай нашарлаған жоқ.
Dialogue: 0,0:03:21.26,0:03:22.63,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:03:23.36,0:03:25.97,Default,,0,0,0,,Пікіріңізді білдіріңіз… Жарайды ма?
Dialogue: 0,0:03:26.23,0:03:26.94,Default,,0,0,0,,О
Dialogue: 0,0:03:27.20,0:03:28.90,Default,,0,0,0,,Бір рет ашық теңізге ауыстырылды
Dialogue: 0,0:03:28.97,0:03:30.31,Default,,0,0,0,,Такао территориясы
Dialogue: 0,0:03:30.37,0:03:32.57,Default,,0,0,0,,Айналма жол туралы не деуге болады?
Dialogue: 0,0:03:32.64,0:03:35.71,Default,,0,0,0,,Егер бұл тұрақты шайқасқа айналса, біз қолайсыз жағдайда боламыз.
Dialogue: 0,0:03:35.81,0:03:36.95,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:37.71,0:03:40.32,Default,,0,0,0,,Такао өзгерсе де, ол үлгіні ұстанады.
Dialogue: 0,0:03:40.38,0:03:42.42,Default,,0,0,0,,Бұл жай ғана позицияны өзгерту емес пе?
Dialogue: 0,0:03:42.48,0:03:45.35,Default,,0,0,0,,Бұл... бұл рас.
Dialogue: 0,0:03:45.42,0:03:46.29,Default,,0,0,0,,Иона
Dialogue: 0,0:03:46.35,0:03:47.92,Default,,0,0,0,,Йокосукаға бағытты сұрау
Dialogue: 0,0:03:47.99,0:03:48.86,Default,,0,0,0,,сұралады
Dialogue: 0,0:03:49.96,0:03:53.83,Default,,0,0,0,,Кеме қазір №11 тайфунның ықпалында.
Dialogue: 0,0:03:54.00,0:03:55.36,Default,,0,0,0,,(Hagakure) Осы жолы сені қашып құтыла алмайсың! (Black) Уф…
Dialogue: 0,0:03:55.43,0:03:57.93,Default,,0,0,0,,Тайфунның бағыты бойынша солтүстікке қарай жүріңіз.
Dialogue: 0,0:03:58.00,0:04:00.77,Default,,0,0,0,,Такаоның көзінен қашып, Йокосукаға кіріңіз
Dialogue: 0,0:04:00.84,0:04:02.87,Default,,0,0,0,,Бұл қол қазірдің өзінде өлі.
Dialogue: 0,0:04:02.94,0:04:04.51,Default,,0,0,0,,Сонымен, В жоспары
Dialogue: 0,0:04:04.57,0:04:05.51,Default,,0,0,0,,Тайфуннан алыс
Dialogue: 0,0:04:05.57,0:04:09.24,Default,,0,0,0,,Такаоның пикет сызығын айналып өтіп, Йокосукаға жақындаңыз
Dialogue: 0,0:04:09.78,0:04:11.55,Default,,0,0,0,,Бұл да Шизуканың идеясы.
Dialogue: 0,0:04:12.45,0:04:13.51,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:04:13.58,0:04:16.42,Default,,0,0,0,,Такао бұл кемені қумайтынына кепілдік жоқ.
Dialogue: 0,0:04:16.52,0:04:19.65,Default,,0,0,0,,Және бұл жағдайда Такаоның ізін суыта алмады
Dialogue: 0,0:04:20.02,0:04:22.46,Default,,0,0,0,,Йокосукаға жету мүмкіндігі бар.
Dialogue: 0,0:04:23.32,0:04:26.36,Default,,0,0,0,,Бұл жағдайда тұман қалай пайда болады деген сұрақ туындайды.
Dialogue: 0,0:04:27.26,0:04:29.43,Default,,0,0,0,,Тұмандық шабуылдардың мақсаты әзірге
Dialogue: 0,0:04:29.50,0:04:31.27,Default,,0,0,0,,Ашық теңізге шығуды жоспарлаңыз
Dialogue: 0,0:04:31.33,0:04:33.90,Default,,0,0,0,,Кемелер тек ұшақтармен шектелді
Dialogue: 0,0:04:34.84,0:04:36.30,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:04:37.01,0:04:37.91,Default,,0,0,0,,Иона
Dialogue: 0,0:04:38.27,0:04:40.41,Default,,0,0,0,,Егер кеме теңіз қоршауын бұзып өтсе ше?
Dialogue: 0,0:04:40.48,0:04:42.68,Default,,0,0,0,,Йокосука портына кіру әрекеті кезінде
Dialogue: 0,0:04:42.74,0:04:43.81,Default,,0,0,0,,Такао не істейді?
Dialogue: 0,0:04:43.88,0:04:45.48,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:04:45.61,0:04:47.42,Default,,0,0,0,,Портқа кірсек те?
Dialogue: 0,0:04:47.48,0:04:48.42,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:04:49.28,0:04:51.02,Default,,0,0,0,,Тұманды реттейтін жоғарғы тәртіп
Dialogue: 0,0:04:51.65,0:04:53.39,Default,,0,0,0,,Адмиралтейт коды
Dialogue: 0,0:04:53.45,0:04:57.56,Default,,0,0,0,,Қандай да бір себептермен жерге тікелей шабуыл жасауға тыйым салынады.
Dialogue: 0,0:04:57.63,0:04:58.93,Default,,0,0,0,,Солай ма? Иона
Dialogue: 0,0:04:58.99,0:04:59.86,Default,,0,0,0,,Иә
Dialogue: 0,0:04:59.93,0:05:03.36,Default,,0,0,0,,Алайда, кемелерге жасалған шабуылдардан адасатын оқтар
Dialogue: 0,0:05:03.43,0:05:06.83,Default,,0,0,0,,Жерге зиян келтіруге тыйым салмайды
Dialogue: 0,0:05:06.90,0:05:08.04,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:05:08.74,0:05:10.91,Default,,0,0,0,,Сондықтан Йокосука порты
Dialogue: 0,0:05:10.97,0:05:14.01,Default,,0,0,0,,Бізге қарсы жасалған шабуылда кепілдік залал болу мүмкіндігі
Dialogue: 0,0:05:14.08,0:05:15.01,Default,,0,0,0,,Өте жоғары
Dialogue: 0,0:05:15.08,0:05:16.68,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:05:16.74,0:05:19.75,Default,,0,0,0,,Қала ауданы осымен іргелес.
Dialogue: 0,0:05:19.81,0:05:21.35,Default,,0,0,0,,Бұл апат.
Dialogue: 0,0:05:21.42,0:05:22.92,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:05:23.95,0:05:26.62,Default,,0,0,0,,Тайфун ақырында қызып, жоғалады.
Dialogue: 0,0:05:26.95,0:05:30.46,Default,,0,0,0,,Егер бұл орын алса, біздің жеңіске жету мүмкіндігіміз одан да азаяды.
Dialogue: 0,0:05:30.53,0:05:33.83,Default,,0,0,0,,Біздің уақытымыз шектеулі, солай ма?
Dialogue: 0,0:05:34.33,0:05:36.40,Default,,0,0,0,,Міне, С жоспары.
Dialogue: 0,0:05:36.76,0:05:38.73,Default,,0,0,0,,Біз осы жерде Такаоны жеңеміз.
Dialogue: 0,0:05:38.80,0:05:39.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:39.73,0:05:42.74,Default,,0,0,0,,Кенеттен ауыр крейсер класы?
Dialogue: 0,0:05:43.37,0:05:45.91,Default,,0,0,0,,Такаоны жеңу...
Dialogue: 0,0:05:46.47,0:05:47.41,Default,,0,0,0,,Иона
Dialogue: 0,0:05:47.48,0:05:48.88,Default,,0,0,0,,Азғынның жағдайы қандай?
Dialogue: 0,0:05:48.94,0:05:50.88,Default,,0,0,0,,Кванттық байланыс жақсы
Dialogue: 0,0:05:50.95,0:05:53.01,Default,,0,0,0,,Келесі екі сағатта проблема жоқ.
Dialogue: 0,0:05:53.51,0:05:54.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:54.65,0:05:55.55,Default,,0,0,0,,Иори!
Dialogue: 0,0:05:55.62,0:05:56.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:56.72,0:05:58.95,Default,,0,0,0,,Жауынгерлік нәтиже Қаншалықты сақтай аласыз?
Dialogue: 0,0:05:59.02,0:06:01.89,Default,,0,0,0,,Біз 3 минут бойы толық қуатыңызды пайдаланатыныңызға кепілдік береміз.
Dialogue: 0,0:06:01.96,0:06:03.02,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:03.09,0:06:04.56,Default,,0,0,0,,Ол қалқып тұр. Иона (Кёхэй) иә?
Dialogue: 0,0:06:04.63,0:06:06.63,Default,,0,0,0,,Мен айлакерліктерді бір уақытта жылжыта аламын ба?
Dialogue: 0,0:06:07.06,0:06:09.70,Default,,0,0,0,,Алдаушымен бетті жабу
Dialogue: 0,0:06:09.76,0:06:11.70,Default,,0,0,0,,Левитация... Есіңіз дұрыс па?
Dialogue: 0,0:06:11.97,0:06:13.13,Default,,0,0,0,,Саналылық
Dialogue: 0,0:06:13.43,0:06:15.10,Default,,0,0,0,,Дауыл қабырғасын пайдалану
Dialogue: 0,0:06:15.37,0:06:18.07,Default,,0,0,0,,Такао сізді ұстап алмас бұрын шабуыл жасаңыз.
Dialogue: 0,0:06:18.14,0:06:19.01,Default,,0,0,0,,Қозғалтқышты іске қосу!
Dialogue: 0,0:06:19.74,0:06:21.51,Default,,0,0,0,,Шығару 1/20
Dialogue: 0,0:06:21.64,0:06:23.61,Default,,0,0,0,,Қозғалтқышты іске қосу! 1/20 шығыс
Dialogue: 0,0:06:31.09,0:06:33.02,Default,,0,0,0,,Гравитон желідегі қалқымалы
Dialogue: 0,0:06:33.09,0:06:35.72,Default,,0,0,0,,Өзгертілген қалқымалылық плюс 6 Левитацияның төмен жылдамдығы!
Dialogue: 0,0:06:36.16,0:06:37.49,Default,,0,0,0,,Беткейлеуді бастады
Dialogue: 0,0:06:37.93,0:06:39.66,Default,,0,0,0,,Цурим көлденең
Dialogue: 0,0:06:39.73,0:06:42.80,Default,,0,0,0,,Мұхит ағынына қарсы шықпаңыз және алаяқпен бір уақытта су бетіне шықпаңыз.
Dialogue: 0,0:06:43.43,0:06:45.17,Default,,0,0,0,,Жауынгерлік өрістегі барлық кемелер!
Dialogue: 0,0:06:47.84,0:06:48.97,Default,,0,0,0,,қозғала бастады
Dialogue: 0,0:06:49.60,0:06:51.11,Default,,0,0,0,,4 реакция бар
Dialogue: 0,0:06:51.51,0:06:52.87,Default,,0,0,0,,Біреуі шынайы ма?
Dialogue: 0,0:06:52.94,0:06:54.98,Default,,0,0,0,,Әлде мұның бәрі жем ме?
Dialogue: 0,0:06:55.18,0:06:57.65,Default,,0,0,0,,Кез келген жағдайда, егер сіз теңізге барсаңыз
Dialogue: 0,0:06:57.71,0:07:00.98,Default,,0,0,0,,Сіз жаңбыр кезінде менің көз алдымнан қашып құтыла аласыз деп ойлайсыз ба?
Dialogue: 0,0:07:05.85,0:07:06.82,Default,,0,0,0,,Иона
Dialogue: 0,0:07:06.89,0:07:07.96,Default,,0,0,0,,Такао қазірдің өзінде бар
Dialogue: 0,0:07:08.02,0:07:09.99,Default,,0,0,0,,Қалай ойлайсың, бұл біздің қозғалыстарымызды бейнелейді ме?
Dialogue: 0,0:07:10.06,0:07:12.76,Default,,0,0,0,,Такаоның ерекшеліктеріне сәйкес, бұл мүмкін емес.
Dialogue: 0,0:07:13.53,0:07:15.03,Default,,0,0,0,,Тұжырымдаманы беру туралы не айтасыз?
Dialogue: 0,0:07:15.13,0:07:18.83,Default,,0,0,0,,Ұғымды беру үшін қашықтық та, окклюзия да маңызды емес.
Dialogue: 0,0:07:18.90,0:07:20.67,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:07:20.74,0:07:22.90,Default,,0,0,0,,Бірақ Такао түсінетін нәрсе
Dialogue: 0,0:07:22.97,0:07:25.21,Default,,0,0,0,,Мен бармын
Dialogue: 0,0:07:25.84,0:07:27.14,Default,,0,0,0,,Қарым-қатынас ұғымында
Dialogue: 0,0:07:27.21,0:07:30.45,Default,,0,0,0,,Бағыт аралығын анықтау мүмкін емес
Dialogue: 0,0:07:30.51,0:07:32.21,Default,,0,0,0,,Жарайсыңдар! Сонда бара аламын деп ойлаймын.
Dialogue: 0,0:07:34.95,0:07:36.08,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:36.15,0:07:37.75,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:07:44.49,0:07:46.59,Default,,0,0,0,,Такао қозғалтқышының шуы артып жатыр?
Dialogue: 0,0:07:49.73,0:07:51.00,Default,,0,0,0,,Такаоның бұрылуы
Dialogue: 0,0:07:51.07,0:07:52.60,Default,,0,0,0,,Ол ашылды ма?
Dialogue: 0,0:07:53.13,0:07:54.10,Default,,0,0,0,,Дүрбелеңге түспеңіз
Dialogue: 0,0:07:54.17,0:07:55.90,Default,,0,0,0,,Беткейлеу! Сол сияқты
Dialogue: 0,0:07:55.97,0:07:57.81,Default,,0,0,0,,Йо Соро түсінді
Dialogue: 0,0:08:01.81,0:08:03.48,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:08:21.20,0:08:22.76,Default,,0,0,0,,Біріншіден, бір соққымен
Dialogue: 0,0:08:22.83,0:08:24.93,Default,,0,0,0,,Кляйн өрісін сыни етіп көрсетіңіз
Dialogue: 0,0:08:25.60,0:08:27.54,Default,,0,0,0,,Тағзым! Торпедо түтігі күту режимінде!
Dialogue: 0,0:08:27.80,0:08:30.71,Default,,0,0,0,,1-ші, 2-ші және 3-ші орындарда жүктелген төмен жиілікті торпедалар!
Dialogue: 0,0:08:30.77,0:08:31.67,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:08:32.11,0:08:34.54,Default,,0,0,0,,Эрозия торпедосының №7 жүктелуі
Dialogue: 0,0:08:34.61,0:08:35.94,Default,,0,0,0,,Жүктеп алғаннан кейін барлық ұшыру түтіктерін ашыңыз!
Dialogue: 0,0:08:36.01,0:08:38.51,Default,,0,0,0,,А... Қызық, бұл не? Бұл
Dialogue: 0,0:08:38.91,0:08:41.28,Default,,0,0,0,,Капитан! Мен біртүрлі шу естимін
Dialogue: 0,0:08:42.02,0:08:44.19,Default,,0,0,0,,Тайфунның кесірінен емес пе?
Dialogue: 0,0:08:44.25,0:08:45.95,Default,,0,0,0,,Мүмкін солай шығар
Dialogue: 0,0:08:46.22,0:08:48.12,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:08:49.12,0:08:52.19,Default,,0,0,0,,Торпеданы тиеу және ұшыру түтігін босату аяқталды
Dialogue: 0,0:08:53.63,0:08:54.30,Default,,0,0,0,,Суреттерді топтастыру?
Dialogue: 0,0:08:54.56,0:08:55.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:56.90,0:08:58.73,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:09:02.24,0:09:05.94,Default,,0,0,0,,Мен Хьюга сияқты бола алмаймын.
Dialogue: 0,0:09:07.04,0:09:08.74,Default,,0,0,0,,Тереңдігі 15
Dialogue: 0,0:09:09.61,0:09:11.28,Default,,0,0,0,,Тез кел
Dialogue: 0,0:09:11.65,0:09:13.05,Default,,0,0,0,,401
Dialogue: 0,0:09:13.55,0:09:14.95,Default,,0,0,0,,Тереңдігі 10
Dialogue: 0,0:09:15.02,0:09:16.05,Default,,0,0,0,,Теңіз деңгейі жақын арада
Dialogue: 0,0:09:22.22,0:09:23.79,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:09:23.86,0:09:25.63,Default,,0,0,0,,Иә, дәл солай...
Dialogue: 0,0:09:25.86,0:09:27.76,Default,,0,0,0,,Теңіз деңгейіне 3...
Dialogue: 0,0:09:27.93,0:09:28.96,Default,,0,0,0,,２… １…
Dialogue: 0,0:09:29.30,0:09:30.16,Default,,0,0,0,,Левитация
Dialogue: 0,0:09:32.03,0:09:32.90,Default,,0,0,0,,Қатал!
Dialogue: 0,0:09:32.97,0:09:34.24,Default,,0,0,0,,Көп руль!
Dialogue: 0,0:09:34.30,0:09:36.30,Default,,0,0,0,,Рульге толы сері
Dialogue: 0,0:09:44.85,0:09:46.68,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:09:46.88,0:09:49.02,Default,,0,0,0,,О! шеңбер!
Dialogue: 0,0:09:49.65,0:09:51.99,Default,,0,0,0,,Қалқымалы қозғалыс! Ең үлкен мекеме! Жылдам сүңгу!
Dialogue: 0,0:09:52.32,0:09:53.99,Default,,0,0,0,,Шашырауға болатынның бәрін шашыраңдар!
Dialogue: 0,0:09:54.32,0:09:56.79,Default,,0,0,0,,Ол біздің қайда екенімізді жақсы біледі!
Dialogue: 0,0:10:05.70,0:10:07.07,Default,,0,0,0,,жойылды ма?
Dialogue: 0,0:10:07.13,0:10:10.30,Default,,0,0,0,,Өте ауырлық зеңбіректерінің ату уақыты тамаша болуы керек еді.
Dialogue: 0,0:10:12.81,0:10:15.24,Default,,0,0,0,,1-ден 3-ке дейінгі сандар! Төмен жиілікті торпедо ату!
Dialogue: 0,0:10:15.68,0:10:18.05,Default,,0,0,0,,Жарылу уақытын бізге қалдырыңыз! Теңізді араластырыңыз!
Dialogue: 0,0:10:18.11,0:10:18.98,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:10:19.05,0:10:20.85,Default,,0,0,0,,жарылысқа дейін 7 секунд! атыс!
Dialogue: 0,0:10:26.02,0:10:27.86,Default,,0,0,0,,Жоғары жылдамдықты қозғалтқыш дыбысы Көп жақындады!
Dialogue: 0,0:10:27.92,0:10:28.79,Default,,0,0,0,,Торпедалар!
Dialogue: 0,0:10:29.06,0:10:31.36,Default,,0,0,0,,Иона! Белсенді алдауды қалқан ретінде пайдаланыңыз!
Dialogue: 0,0:10:31.63,0:10:32.29,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:36.16,0:10:37.40,Default,,0,0,0,,Үш алаяқ жоғалып кетті!
Dialogue: 0,0:10:37.67,0:10:39.27,Default,,0,0,0,,Төмен жиілікті торпедо жарылысқа дейін 3 секунд!
Dialogue: 0,0:10:39.97,0:10:41.20,Default,,0,0,0,,Тыныштық! Құлаққаптардың дыбысы өшірілді!
Dialogue: 0,0:10:41.27,0:10:42.27,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:10:45.97,0:10:46.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:46.97,0:10:49.01,Default,,0,0,0,,Қозғалтқышты тоқтату Үнсіз сүңгу
Dialogue: 0,0:10:59.05,0:11:02.09,Default,,0,0,0,,401 жоғалған
Dialogue: 0,0:11:12.10,0:11:15.70,Default,,0,0,0,,Дайвинг аймағында және су өткізбейтін жағдайларда ауытқулар табылмады.
Dialogue: 0,0:11:16.17,0:11:18.01,Default,,0,0,0,,Кейбір сенсорлар зақымдалған.
Dialogue: 0,0:11:18.07,0:11:19.91,Default,,0,0,0,,Қазіргі уақытта еленбеуге болады
Dialogue: 0,0:11:20.17,0:11:21.21,Default,,0,0,0,,Кёхэй!
Dialogue: 0,0:11:21.28,0:11:24.28,Default,,0,0,0,,Ветроника қару-жарақ жүйесінде ауытқулар жоқ
Dialogue: 0,0:11:24.38,0:11:25.25,Default,,0,0,0,,Кез келген уақытта бара аласыз
Dialogue: 0,0:11:25.31,0:11:26.18,Default,,0,0,0,,Иори!
Dialogue: 0,0:11:26.85,0:11:29.15,Default,,0,0,0,,Машина бөлмесі Аномалия жоқ
Dialogue: 0,0:11:29.22,0:11:31.02,Default,,0,0,0,,Клейнфилд туралы не деуге болады?
Dialogue: 0,0:11:31.09,0:11:33.22,Default,,0,0,0,,Әй, анау.
Dialogue: 0,0:11:33.29,0:11:36.79,Default,,0,0,0,,Ауыр гравитациялық зеңбіректің арқасында біз сыншылдықтан бір қадам алыспыз.
Dialogue: 0,0:11:36.86,0:11:38.79,Default,,0,0,0,,Амансың ба? Иона
Dialogue: 0,0:11:38.86,0:11:40.13,Default,,0,0,0,,Мен қазір жақсымын
Dialogue: 0,0:11:40.19,0:11:41.20,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:41.26,0:11:43.96,Default,,0,0,0,,Өріс жинақталған энергияны босатуы керек.
Dialogue: 0,0:11:44.13,0:11:45.83,Default,,0,0,0,,Қаныққан
Dialogue: 0,0:11:45.90,0:11:47.30,Default,,0,0,0,,құлау, жоғалу
Dialogue: 0,0:11:47.70,0:11:49.00,Default,,0,0,0,,(Кодай) Босат! (Шода) Оны босатыңдар!
Dialogue: 0,0:11:49.07,0:11:50.44,Default,,0,0,0,,Энергияны бөлгеннен кейін
Dialogue: 0,0:11:50.70,0:11:53.41,Default,,0,0,0,,Менің тұрған жерім белгілі болады.
Dialogue: 0,0:11:53.97,0:11:57.21,Default,,0,0,0,,Тыныштық! Гравитациялық зеңбірек ату алдындағы шу
Dialogue: 0,0:11:57.28,0:11:59.75,Default,,0,0,0,,Келесі, Такао іске қосуға дайын болғанда
Dialogue: 0,0:11:59.81,0:12:02.75,Default,,0,0,0,,Дыбыстық басып шығаруды бірден түсіну үшін талдаңыз.
Dialogue: 0,0:12:02.82,0:12:04.82,Default,,0,0,0,,Кітапханада тіркелген
Dialogue: 0,0:12:04.89,0:12:05.75,Default,,0,0,0,,Иә
Dialogue: 0,0:12:05.82,0:12:06.72,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:12:06.99,0:12:08.72,Default,,0,0,0,,Гунзо мұндай жағдайда жиі кездеседі.
Dialogue: 0,0:12:08.79,0:12:11.83,Default,,0,0,0,,Сіз қатты ауырлық зеңбірегі нысанаға алынғанын байқадыңыз ба?
Dialogue: 0,0:12:12.13,0:12:14.96,Default,,0,0,0,,Такаоның дәл мақсатының арқасында.
Dialogue: 0,0:12:15.26,0:12:16.13,Default,,0,0,0,,Иона
Dialogue: 0,0:12:16.20,0:12:18.17,Default,,0,0,0,,Маған бетке шыққанға дейінгі соғыс жағдайының сюжетін беріңізші.
Dialogue: 0,0:12:18.23,0:12:19.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:22.37,0:12:25.47,Default,,0,0,0,,Такаоның садағы бізге қарай бағыттай берді.
Dialogue: 0,0:12:25.74,0:12:26.91,Default,,0,0,0,,Адал бол
Dialogue: 0,0:12:27.48,0:12:31.45,Default,,0,0,0,,Олар 401-ді көздейтінін қатты жарнамалағандай.
Dialogue: 0,0:12:31.51,0:12:32.81,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:32.88,0:12:34.98,Default,,0,0,0,,Егер біз Такао болсақ
Dialogue: 0,0:12:35.05,0:12:37.99,Default,,0,0,0,,Соңғы минутқа дейін байқамағандай кейіп танытасыз.
Dialogue: 0,0:12:38.05,0:12:38.92,Default,,0,0,0,,Бірақ келіңіз.
Dialogue: 0,0:12:39.49,0:12:40.42,Default,,0,0,0,,Такао қалай болды
Dialogue: 0,0:12:40.49,0:12:42.82,Default,,0,0,0,,Сіз біздің орналасқан жерімізді дәл анықтай алдыңыз ба?
Dialogue: 0,0:12:43.32,0:12:45.83,Default,,0,0,0,,Белсенді тапанша еленбеді.
Dialogue: 0,0:12:45.89,0:12:47.33,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:12:47.39,0:12:50.16,Default,,0,0,0,,Менің ойымша, Цуки оны жақтады ма?
Dialogue: 0,0:12:50.23,0:12:51.80,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:12:51.87,0:12:53.00,Default,,0,0,0,,Ах... (Кёхэй) А?
Dialogue: 0,0:12:54.54,0:12:56.27,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:56.34,0:12:58.01,Default,,0,0,0,,Такао әрқашан болды
Dialogue: 0,0:12:58.07,0:13:00.04,Default,,0,0,0,,Сіз мені бақылап тұрғандай сезінемін.
Dialogue: 0,0:13:00.34,0:13:01.98,Default,,0,0,0,,Қозғалысты бастағаннан кейін
Dialogue: 0,0:13:02.04,0:13:04.78,Default,,0,0,0,,Мен сенен ешқашан көзімді алмаған сияқтымын...
Dialogue: 0,0:13:05.15,0:13:06.55,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:13:07.01,0:13:10.35,Default,,0,0,0,,Оны тұманға айналдыр. Бұл өте түсініксіз мәлімдеме.
Dialogue: 0,0:13:11.02,0:13:12.99,Default,,0,0,0,,Жақсы сөзбен жеткізе алмайды
Dialogue: 0,0:13:13.05,0:13:14.29,Default,,0,0,0,,Бұл мен істей алатын ең жақсы нәрсе
Dialogue: 0,0:13:14.89,0:13:16.22,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:13:16.29,0:13:17.93,Default,,0,0,0,,А? Не айтқың келеді?
Dialogue: 0,0:13:17.99,0:13:21.26,Default,,0,0,0,,Тұманда кездейсоқтық болмайды.
Dialogue: 0,0:13:22.23,0:13:23.86,Default,,0,0,0,,Тағы бір қайық бар
Dialogue: 0,0:13:23.93,0:13:24.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:24.87,0:13:25.53,Default,,0,0,0,,Иона
Dialogue: 0,0:13:26.30,0:13:29.54,Default,,0,0,0,,Такаоның жауды іздеу ауқымы спецификациядан белгілі
Dialogue: 0,0:13:29.80,0:13:33.27,Default,,0,0,0,,Ағымдағы артиллериялық атыс бойынша есептелген қарсыластың іздеу ауқымын қосыңыз.
Dialogue: 0,0:13:33.54,0:13:34.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:38.35,0:13:39.55,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:13:39.81,0:13:42.12,Default,,0,0,0,,Бұл әскери кемелер класына қарағанда кең ауқым емес пе?
Dialogue: 0,0:13:42.45,0:13:43.88,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:13:43.95,0:13:45.29,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:46.05,0:13:47.42,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:13:47.92,0:13:48.99,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:13:49.32,0:13:50.42,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:13:51.83,0:13:53.46,Default,,0,0,0,,Кең аумаққа қосымша
Dialogue: 0,0:13:54.06,0:13:55.43,Default,,0,0,0,,Осы ауа райы жағдайында
Dialogue: 0,0:13:55.50,0:13:58.90,Default,,0,0,0,,Ажыратулар мен нақты нәрсені ажырату үшін жеткілікті рұқсат
Dialogue: 0,0:13:59.03,0:14:01.54,Default,,0,0,0,,Осыншама өнімділігі бар кемеге келгенде...
Dialogue: 0,0:14:01.60,0:14:05.84,Default,,0,0,0,,Бұл өте жасырын сүңгуір қайықтағы бақылау кемесі сияқты.
Dialogue: 0,0:14:06.14,0:14:07.01,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:14:07.07,0:14:09.28,Default,,0,0,0,,Сонарда Такаодан басқа кемелер жоқ.
Dialogue: 0,0:14:09.38,0:14:11.11,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:14:12.88,0:14:14.25,Default,,0,0,0,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:14:14.32,0:14:18.29,Default,,0,0,0,,Ол адам Такаоның жаңғырығына тығылып отыр.
Dialogue: 0,0:14:19.29,0:14:23.29,Default,,0,0,0,,Мен сені қозғалмады деп ойладым, өйткені сен толқынды теңізді жек көрдің.
Dialogue: 0,0:14:23.62,0:14:25.19,Default,,0,0,0,,Нағыз себеп
Dialogue: 0,0:14:25.26,0:14:28.00,Default,,0,0,0,,Дұрыс қозғала алмағандықтан.
Dialogue: 0,0:14:28.23,0:14:30.26,Default,,0,0,0,,Әрине, мағынасы бар.
Dialogue: 0,0:14:30.63,0:14:32.20,Default,,0,0,0,,Бұл жай ғана гипотеза емес пе?
Dialogue: 0,0:14:32.50,0:14:35.04,Default,,0,0,0,,Гипотеза дәлелдеуге арналған.
Dialogue: 0,0:14:35.10,0:14:38.14,Default,,0,0,0,,Келесі жолы мен оларды таң қалдырамын.
Dialogue: 0,0:14:38.21,0:14:41.21,Default,,0,0,0,,Мен Иона Хюганың заттарын пайдаланамын.
Dialogue: 0,0:14:41.28,0:14:42.21,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:14:42.28,0:14:43.31,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:14:43.51,0:14:44.55,Default,,0,0,0,,Бұл әлі
Dialogue: 0,0:14:44.61,0:14:47.45,Default,,0,0,0,,Операция модельдеу арқылы ғана расталды, солай ма?
Dialogue: 0,0:14:47.51,0:14:50.52,Default,,0,0,0,,Егер ол іс жүзінде қозғалса, қандай жүктеме болады...
Dialogue: 0,0:14:50.58,0:14:52.25,Default,,0,0,0,,Сіз мұны істей аласыз ба? Иона
Dialogue: 0,0:14:52.32,0:14:54.15,Default,,0,0,0,,Жарайды, мүмкін
Dialogue: 0,0:14:54.22,0:14:55.09,Default,,0,0,0,,Иона!
Dialogue: 0,0:14:55.16,0:14:56.56,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:14:57.06,0:14:58.63,Default,,0,0,0,,Менің капитаным
Dialogue: 0,0:14:58.89,0:15:01.56,Default,,0,0,0,,Сыртқы түріне қарамастан, бұл минет.
Dialogue: 0,0:15:02.16,0:15:03.26,Default,,0,0,0,,Ұшыңыз!
Dialogue: 0,0:15:17.91,0:15:19.15,Default,,0,0,0,,401
Dialogue: 0,0:15:19.21,0:15:21.22,Default,,0,0,0,,Сіз ұяңыздан шықтыңыз ба?
Dialogue: 0,0:15:21.98,0:15:23.35,Default,,0,0,0,,Upturim 30
Dialogue: 0,0:15:23.42,0:15:24.62,Default,,0,0,0,,Екі жақта да толық жылдамдық!
Dialogue: 0,0:15:31.19,0:15:33.09,Default,,0,0,0,,Жауынгерлік өрістегі барлық кемелер!
Dialogue: 0,0:15:36.63,0:15:38.33,Default,,0,0,0,,Садақ торпедо түтігі
Dialogue: 0,0:15:38.40,0:15:40.47,Default,,0,0,0,,1-ден 6-ға дейін басқарылатын торпедаларды тиеу!
Dialogue: 0,0:15:40.97,0:15:42.30,Default,,0,0,0,,Нұсқау үлгісін бізге қалдырыңыз!
Dialogue: 0,0:15:42.40,0:15:45.71,Default,,0,0,0,,Келесі, №7 және №8 эрозия торпедаларымен жүктеледі!
Dialogue: 0,0:15:45.97,0:15:46.97,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:15:47.37,0:15:50.21,Default,,0,0,0,,Иона эрозиялық торпедосының кіріс спецификациясы
Dialogue: 0,0:15:50.28,0:15:51.35,Default,,0,0,0,,Гаттен
Dialogue: 0,0:15:51.51,0:15:53.38,Default,,0,0,0,,1-ден 6-ға дейінгі сандар Өрт!
Dialogue: 0,0:16:01.66,0:16:03.66,Default,,0,0,0,,501 Кешіктірме
Dialogue: 0,0:16:11.37,0:16:14.30,Default,,0,0,0,,Такао 185-ке ауыстырылды! жылдамдық 7
Dialogue: 0,0:16:14.37,0:16:15.40,Default,,0,0,0,,кеш
Dialogue: 0,0:16:15.47,0:16:16.57,Default,,0,0,0,,Гунзо айтқандай
Dialogue: 0,0:16:17.00,0:16:19.21,Default,,0,0,0,,Сіз ішіңізде бірдеңе ұстап тұрсыз ба?
Dialogue: 0,0:16:19.27,0:16:21.61,Default,,0,0,0,,...
Dialogue: 0,0:16:54.41,0:16:56.01,Default,,0,0,0,,Танатоний реакциясы
Dialogue: 0,0:16:56.38,0:16:57.61,Default,,0,0,0,,Эрозиялық торпедо?
Dialogue: 0,0:16:57.78,0:17:00.18,Default,,0,0,0,,Бірақ мен оған тиіспеймін
Dialogue: 0,0:17:11.03,0:17:13.23,Default,,0,0,0,,Осы торпеданы бағдарламалаған адам
Dialogue: 0,0:17:13.69,0:17:15.63,Default,,0,0,0,,Оның қолдары жақсы.
Dialogue: 0,0:17:16.73,0:17:18.03,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:18.63,0:17:21.14,Default,,0,0,0,,Эрозияға ұшыраған көптеген қару-жарақ
Dialogue: 0,0:17:21.70,0:17:23.57,Default,,0,0,0,,Олардың барлығынан аулақ бола аласыз ба?
Dialogue: 0,0:17:24.77,0:17:27.27,Default,,0,0,0,,Такао бағытын өзгерту 150
Dialogue: 0,0:17:27.34,0:17:28.58,Default,,0,0,0,,Иона күту режимінде!
Dialogue: 0,0:17:29.11,0:17:30.11,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:40.22,0:17:43.12,Default,,0,0,0,,Максималды қозғалтқыш! Graviton Float Blow!
Dialogue: 0,0:17:43.19,0:17:45.33,Default,,0,0,0,,Барлық мүшелер Соққыға қарсы қорғаныс!
Dialogue: 0,0:17:45.39,0:17:46.83,Default,,0,0,0,,Барлық кемелер тез көтеріледі!
Dialogue: 0,0:17:53.50,0:17:54.84,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:17:55.10,0:17:56.60,Default,,0,0,0,,401
Dialogue: 0,0:17:56.74,0:17:57.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:01.54,0:18:02.58,Default,,0,0,0,,Не?
Dialogue: 0,0:18:07.31,0:18:08.32,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:15.29,0:18:17.16,Default,,0,0,0,,Өте ауырлық зеңбірегі...
Dialogue: 0,0:18:17.39,0:18:20.43,Default,,0,0,0,,Неліктен мұндай нәрсе круиздік сүңгуір қайыққа ұқсайды?
Dialogue: 0,0:18:20.79,0:18:22.86,Default,,0,0,0,,501 Төтенше жағдайды болдырмау!
Dialogue: 0,0:18:23.13,0:18:24.16,Default,,0,0,0,,Байланысты үзіңіз!
Dialogue: 0,0:18:34.81,0:18:35.84,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:18:36.11,0:18:38.51,Default,,0,0,0,,Бір кемеге ұқсайтындай қарнына жабысып қалды!
Dialogue: 0,0:18:39.18,0:18:41.72,Default,,0,0,0,,Takao ғарыш осін іске қосу бекітілген
Dialogue: 0,0:18:47.45,0:18:48.89,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:50.69,0:18:52.46,Default,,0,0,0,,Психикалық модель?
Dialogue: 0,0:18:53.33,0:18:54.63,Default,,0,0,0,,Биіктік бұрышы минус 3 градус
Dialogue: 0,0:18:54.70,0:18:56.50,Default,,0,0,0,,Биіктік бұрышы минус 3 градус
Dialogue: 0,0:18:56.60,0:18:58.60,Default,,0,0,0,,Жоқ, бұл Такао (Гунзо) үшін жақсы!
Dialogue: 0,0:19:00.50,0:19:01.37,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:05.61,0:19:07.44,Default,,0,0,0,,Такао кетейін деп жатыр!
Dialogue: 0,0:19:07.51,0:19:08.38,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:19:08.74,0:19:10.58,Default,,0,0,0,,Энергия ағынының жолы ұзаққа созылмайды!
Dialogue: 0,0:19:10.74,0:19:12.91,Default,,0,0,0,,Барлық мүшелер! Шокқа дайындалыңыз!
Dialogue: 0,0:19:13.18,0:19:15.32,Default,,0,0,0,,Супер гравитациялық зеңбірек атуы!
Dialogue: 0,0:19:15.92,0:19:16.78,Default,,0,0,0,,Өрт!
Dialogue: 0,0:19:24.42,0:19:25.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:31.17,0:19:32.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:44.34,0:19:47.81,Default,,0,0,0,,Түсіндім, 401 жеңді ме?
Dialogue: 0,0:19:53.49,0:19:56.46,Default,,0,0,0,,Гунзо Чихая күткендей
Dialogue: 0,0:20:12.54,0:20:14.34,Default,,0,0,0,,Сізді ұрып-соққан сияқты.
Dialogue: 0,0:20:16.71,0:20:19.38,Default,,0,0,0,,Қару-жарақтарды 24 сағатқа жауып тастаңыз.
Dialogue: 0,0:20:19.45,0:20:20.81,Default,,0,0,0,,Бұл... 401
Dialogue: 0,0:20:20.88,0:20:23.25,Default,,0,0,0,,Өйткені менде ауырлық күшінің зеңбірегі сияқты бір нәрсе жасырылған болатын.
Dialogue: 0,0:20:23.75,0:20:25.92,Default,,0,0,0,,Бірақ... неге мұндай нәрсе?
Dialogue: 0,0:20:26.25,0:20:28.66,Default,,0,0,0,,Хьюгадан алынған зат шығар.
Dialogue: 0,0:20:28.72,0:20:31.43,Default,,0,0,0,,Адамдар – өнертапқыш жаратылыс.
Dialogue: 0,0:20:31.63,0:20:32.89,Default,,0,0,0,,Хюуга?
Dialogue: 0,0:20:33.23,0:20:36.53,Default,,0,0,0,,401 және Хюуга баяғыда шайқас болды.
Dialogue: 0,0:20:36.60,0:20:38.80,Default,,0,0,0,,Ал Хюуга жеңіліп қалды.
Dialogue: 0,0:20:38.90,0:20:42.57,Default,,0,0,0,,Жабдықтарыңызды адамдар ұрлап алғаны қандай ұят.
Dialogue: 0,0:20:42.64,0:20:47.67,Default,,0,0,0,,401, қаруларыңыз құлыпталып, ашық теңізге жіберілді.
Dialogue: 0,0:20:47.74,0:20:49.41,Default,,0,0,0,,Сен Хюугаға күле аласың ба?
Dialogue: 0,0:20:49.48,0:20:50.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:52.68,0:20:55.85,Default,,0,0,0,,Біз мұндай нәрселерді қалдыра алмаймыз!
Dialogue: 0,0:20:57.58,0:20:59.39,Default,,0,0,0,,Бұл сізге ұқсамайды.
Dialogue: 0,0:20:59.45,0:21:01.26,Default,,0,0,0,,Сонымен, ақыры уақыт келді—
Dialogue: 0,0:21:01.76,0:21:02.82,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:21:17.87,0:21:19.64,Default,,0,0,0,,Сіз осындай жерде болдыңыз ба?
Dialogue: 0,0:21:24.48,0:21:26.75,Default,,0,0,0,,Бұл өте ауыртпалық болды.
Dialogue: 0,0:21:26.81,0:21:28.35,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:21:28.45,0:21:30.35,Default,,0,0,0,,Біз қарумыз
Dialogue: 0,0:21:30.75,0:21:33.39,Default,,0,0,0,,Өйткені ұрыс – тіршіліктің себебі
Dialogue: 0,0:21:36.72,0:21:37.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:47.80,0:21:50.57,Default,,0,0,0,,401 қару құлыптаулы
Dialogue: 0,0:21:50.64,0:21:53.47,Default,,0,0,0,,Сізді ашық теңізге жібердіңіз
Dialogue: 0,0:21:53.54,0:21:55.58,Default,,0,0,0,,Сен Хюугаға күле аласың ба?
Dialogue: 0,0:22:00.85,0:22:02.58,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:22:02.65,0:22:05.72,Default,,0,0,0,,Неге мені суға батырмадың?
Dialogue: 0,0:22:24.04,0:22:27.01,Default,,0,0,0,,Егер сізде бортта адам деп аталатын бөлімше болса
Dialogue: 0,0:22:27.51,0:22:29.94,Default,,0,0,0,,Мұндай тактика мүмкін бе?
Dialogue: 0,0:22:35.78,0:22:37.52,Default,,0,0,0,,Сол бірлік
Dialogue: 0,0:22:37.68,0:22:39.59,Default,,0,0,0,,Мен де соны қалаймын
Dialogue: 0,0:22:40.62,0:22:46.63,Default,,0,0,0,,♪～
Dialogue: 0,0:24:03.17,0:24:09.18,Default,,0,0,0,,～♪
