Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.35,0:00:26.72,Default,,0,0,0,,Ах... (монах) Жоқ...? Бұл не?
Dialogue: 0,0:00:27.29,0:00:29.32,Default,,0,0,0,,Сәйкестендіру сигналын тексеру
Dialogue: 0,0:00:30.26,0:00:31.13,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:31.63,0:00:32.49,Default,,0,0,0,,Конгоу!
Dialogue: 0,0:00:35.60,0:00:36.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:36.77,0:00:38.63,Default,,0,0,0,,Жауынгерлік кеме немесе басқа нәрсе емес.
Dialogue: 0,0:00:38.70,0:00:40.40,Default,,0,0,0,,Бірдеңе дұрыс емес...
Dialogue: 0,0:00:40.70,0:00:42.40,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:00:50.04,0:00:52.41,Default,,0,0,0,,Ішінде майялық табиғи тербеліс бар.
Dialogue: 0,0:00:53.08,0:00:54.32,Default,,0,0,0,,Ол біріктіріліп жатыр ма?
Dialogue: 0,0:00:55.12,0:00:57.55,Default,,0,0,0,,Жоқ... Қоңырауыңызға жауап бермеймін.
Dialogue: 0,0:00:58.65,0:00:59.72,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:00.79,0:01:02.32,Default,,0,0,0,,Қабылдануда…
Dialogue: 0,0:01:03.16,0:01:04.33,Default,,0,0,0,,Ол бөліктерге бөлінген бе?
Dialogue: 0,0:01:06.69,0:01:07.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:09.30,0:01:10.17,Default,,0,0,0,,Капитан
Dialogue: 0,0:01:10.73,0:01:13.17,Default,,0,0,0,,Алда тұманда американдық флот
Dialogue: 0,0:01:13.23,0:01:15.40,Default,,0,0,0,,Артқы жағында біртүрлі пішінді Конгоу бар.
Dialogue: 0,0:01:15.60,0:01:16.77,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:01:16.84,0:01:19.41,Default,,0,0,0,,Америкаға жетуге уақыт таяп қалды.
Dialogue: 0,0:01:30.15,0:01:34.32,Default,,0,0,0,,Ауыр крейсер Майя мен Нагара 1-ден 8-ге дейін
Dialogue: 0,0:01:34.72,0:01:35.76,Default,,0,0,0,,Бақылау
Dialogue: 0,0:01:36.29,0:01:37.29,Default,,0,0,0,,Іске қосу орны
Dialogue: 0,0:01:40.66,0:01:43.23,Default,,0,0,0,,Ауыр гравитациялық зеңбірекпен біріктіру расталды
Dialogue: 0,0:01:44.20,0:01:45.87,Default,,0,0,0,,Аннигиляция жүйесін белсендіру
Dialogue: 0,0:01:46.43,0:01:49.20,Default,,0,0,0,,Барлық кемелер, барлық жүйелер, қосылымды тексеріңіз
Dialogue: 0,0:01:49.50,0:01:53.51,Default,,0,0,0,,Ах! Конгоның орталығында үлкен гравитондық реакция расталды!
Dialogue: 0,0:01:53.84,0:01:55.28,Default,,0,0,0,,Әлі де өсуде!
Dialogue: 0,0:01:56.58,0:01:58.68,Default,,0,0,0,,Капитан Евазив сүңгуі
Dialogue: 0,0:01:58.75,0:02:01.55,Default,,0,0,0,,Жоқ, ауқым тым кең.
Dialogue: 0,0:02:02.28,0:02:03.15,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:02:08.52,0:02:10.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:41.22,0:02:44.23,Default,,0,0,0,,Тұман флоты жойылды
Dialogue: 0,0:02:44.63,0:02:46.56,Default,,0,0,0,,Дүние өртенеді
Dialogue: 0,0:02:47.40,0:02:50.63,Default,,0,0,0,,Конгоу... неге одақтасыңды атып алдың?
Dialogue: 0,0:02:50.70,0:02:53.23,Default,,0,0,0,,Бізді әдейі қалдырдың ба?
Dialogue: 0,0:02:54.87,0:02:56.80,Default,,0,0,0,,Мен Конгоу туралы естігім келеді.
Dialogue: 0,0:03:15.69,0:03:16.69,Default,,0,0,0,,Конго…
Dialogue: 0,0:03:19.73,0:03:20.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:21.63,0:03:22.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:23.63,0:03:24.50,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:24.97,0:03:27.90,Default,,0,0,0,,Сен неге одақтасыңды атып тастаймын деп кейіптесің?
Dialogue: 0,0:03:29.30,0:03:32.24,Default,,0,0,0,,Олар өздерін құрбан етті.
Dialogue: 0,0:03:32.44,0:03:33.74,Default,,0,0,0,,Бұл құрбандық па?
Dialogue: 0,0:03:33.81,0:03:34.81,Default,,0,0,0,,Не?
Dialogue: 0,0:03:35.48,0:03:37.71,Default,,0,0,0,,Мен және сіз сияқты
Dialogue: 0,0:03:37.98,0:03:39.91,Default,,0,0,0,,Бұл қателерді көбейтпеу үшін.
Dialogue: 0,0:03:40.28,0:03:41.28,Default,,0,0,0,,Қате…
Dialogue: 0,0:03:42.28,0:03:45.32,Default,,0,0,0,,Біз ақаулы болып қалдық дейсіз бе?
Dialogue: 0,0:03:45.39,0:03:46.96,Default,,0,0,0,,Содан кейін Конгоу
Dialogue: 0,0:03:47.39,0:03:49.72,Default,,0,0,0,,Сіздің қазіргі түріңіз біртүрлі.
Dialogue: 0,0:03:52.36,0:03:54.86,Default,,0,0,0,,Жауынгерлік кеменің пішінінен бас тартқаннан кейінгі қазіргі көрініс
Dialogue: 0,0:03:55.00,0:03:57.77,Default,,0,0,0,,Сіз ерекше назар аударған Тұман флотының ережелерінен.
Dialogue: 0,0:03:57.83,0:03:59.00,Default,,0,0,0,,Үлкен ауытқу
Dialogue: 0,0:04:00.00,0:04:01.54,Default,,0,0,0,,Бұл енді жоқ
Dialogue: 0,0:04:01.90,0:04:03.34,Default,,0,0,0,,Тұман емес
Dialogue: 0,0:04:04.41,0:04:05.64,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:04:05.97,0:04:07.84,Default,,0,0,0,,Біз қателерміз
Dialogue: 0,0:04:08.61,0:04:10.35,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:04:10.41,0:04:13.28,Default,,0,0,0,,Мен бұл ойлау тәртібінен бас тарта алмаймын.
Dialogue: 0,0:04:13.35,0:04:15.95,Default,,0,0,0,,Мен бұл белгісіз эволюциядан тыспын
Dialogue: 0,0:04:16.02,0:04:17.99,Default,,0,0,0,,Нені білгіңіз келеді
Dialogue: 0,0:04:18.69,0:04:19.89,Default,,0,0,0,,Мұндай бұйрық
Dialogue: 0,0:04:19.95,0:04:22.99,Default,,0,0,0,,Адмиралтейлік кодексте еш жерде жоқ
Dialogue: 0,0:04:23.26,0:04:25.36,Default,,0,0,0,,Оған тапсырыс беру керек пе?
Dialogue: 0,0:04:26.79,0:04:27.76,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:27.83,0:04:28.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:36.54,0:04:38.41,Default,,0,0,0,,Бұл соғыс жариялау.
Dialogue: 0,0:04:39.47,0:04:40.98,Default,,0,0,0,,Мен сенмін
Dialogue: 0,0:04:41.88,0:04:42.88,Default,,0,0,0,,жою
Dialogue: 0,0:04:45.81,0:04:47.52,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:04:48.68,0:04:50.85,Default,,0,0,0,,Ku! Бұл соғыс жариялау ма?
Dialogue: 0,0:04:50.92,0:04:54.36,Default,,0,0,0,,Тұжырымдаманы беру екінші жағынан құлыпталады
Dialogue: 0,0:04:54.42,0:04:57.99,Default,,0,0,0,,Майя Нагараның бұзылған қозғалтқышын игеріп, сіңірді.
Dialogue: 0,0:04:58.06,0:04:58.93,Default,,0,0,0,,Полимерлену
Dialogue: 0,0:04:59.46,0:05:02.73,Default,,0,0,0,,Идеал суперпозиция күйі бақылаудан шығып бара жатқан сияқты.
Dialogue: 0,0:05:03.30,0:05:06.63,Default,,0,0,0,,Конго мұндай әрекетпен өз корпусын сақтай ала ма?
Dialogue: 0,0:05:06.83,0:05:07.70,Default,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,0:05:07.77,0:05:09.84,Default,,0,0,0,,Бұл ақыр соңында құлайды.
Dialogue: 0,0:05:10.57,0:05:12.44,Default,,0,0,0,,Өлмек ниетіңіз бар ма...
Dialogue: 0,0:05:12.61,0:05:14.78,Default,,0,0,0,,Психикалық модельдер өз-өзіне қол жұмсай ма?
Dialogue: 0,0:05:14.84,0:05:16.41,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:16.71,0:05:17.71,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:05:17.85,0:05:20.01,Default,,0,0,0,,Тұман ұстай алмаған ойлар
Dialogue: 0,0:05:20.68,0:05:21.55,Default,,0,0,0,,Өлім
Dialogue: 0,0:05:22.48,0:05:23.95,Default,,0,0,0,,Уф. Менің не істеуімді қалайсың?
Dialogue: 0,0:05:24.02,0:05:27.79,Default,,0,0,0,,Мен мұны өзімізге қатысты суицид ретінде сипаттай аламын ба?
Dialogue: 0,0:05:27.96,0:05:30.33,Default,,0,0,0,,Хмф! Мен қалжыңдамаймын.
Dialogue: 0,0:05:31.63,0:05:32.63,Default,,0,0,0,,Конго…
Dialogue: 0,0:05:38.33,0:05:39.33,Default,,0,0,0,,Батып кету
Dialogue: 0,0:05:44.04,0:05:45.61,Default,,0,0,0,,Ах...! Міне бітті!
Dialogue: 0,0:05:45.67,0:05:47.11,Default,,0,0,0,,Гравитондық реакцияның күшеюі!
Dialogue: 0,0:05:47.38,0:05:50.41,Default,,0,0,0,,Сіз үлкен гравитациялық зеңбіректі кезекпен ата аласыз ба?
Dialogue: 0,0:05:50.48,0:05:52.08,Default,,0,0,0,,Клейнфилд кеңеюі!
Dialogue: 0,0:05:52.35,0:05:53.61,Default,,0,0,0,,Қозғалтқыш Максималды өнімділік!
Dialogue: 0,0:05:53.68,0:05:54.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:54.98,0:05:56.62,Default,,0,0,0,,Толық жарылыс күту режимі!
Dialogue: 0,0:05:56.68,0:05:57.85,Default,,0,0,0,,401
Dialogue: 0,0:05:57.99,0:06:00.52,Default,,0,0,0,,Өте ауырлық зеңбірегін орналастырып, алға жылжыңыз
Dialogue: 0,0:06:00.86,0:06:02.42,Default,,0,0,0,,Тіпті оны толығымен ауыстыру мүмкін болмаса да
Dialogue: 0,0:06:02.49,0:06:04.36,Default,,0,0,0,,Егер сіз күш өрісін шатастырып алсаңыз, бұл жақсы!
Dialogue: 0,0:06:12.10,0:06:13.10,Default,,0,0,0,,Өрт!
Dialogue: 0,0:06:48.47,0:06:51.97,Default,,0,0,0,,Күш өрісін бұзып, жоғалып кеттіңіз бе?
Dialogue: 0,0:06:52.84,0:06:54.18,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін
Dialogue: 0,0:07:00.01,0:07:02.45,Default,,0,0,0,,Күш өрісінің турбуленттігі жоғалады
Dialogue: 0,0:07:02.52,0:07:04.92,Default,,0,0,0,,Қозғалтқыш тоқтады, анықталмады
Dialogue: 0,0:07:04.99,0:07:05.85,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:06.19,0:07:07.56,Default,,0,0,0,,Неге жасыру керек?
Dialogue: 0,0:07:07.76,0:07:08.62,Default,,0,0,0,,Бұл жақсырақ
Dialogue: 0,0:07:08.69,0:07:11.56,Default,,0,0,0,,Нәтижесі Оның атыс күші жағынан төмен екені көрініп тұр.
Dialogue: 0,0:07:11.76,0:07:13.56,Default,,0,0,0,,Бетпе-бет бәсекенің мәні жоқ
Dialogue: 0,0:07:13.63,0:07:14.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:14.63,0:07:15.86,Default,,0,0,0,,Капитан (Гунзо) иә?
Dialogue: 0,0:07:15.93,0:07:19.53,Default,,0,0,0,,Біз дірілдейтін оқтұмсықтардың үлгілерін алып жүрміз.
Dialogue: 0,0:07:19.60,0:07:23.74,Default,,0,0,0,,Егер ол осында батып кетсе, ол адамзаттың болашағына тыйым салады.
Dialogue: 0,0:07:23.81,0:07:24.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:24.74,0:07:25.77,Default,,0,0,0,,Біз
Dialogue: 0,0:07:25.84,0:07:28.54,Default,,0,0,0,,Сіз болашақты өзгерту үшін келдіңіз, солай ма?
Dialogue: 0,0:07:28.81,0:07:30.51,Default,,0,0,0,,Мектептен қашу
Dialogue: 0,0:07:30.58,0:07:32.45,Default,,0,0,0,,Үкімет те мені қуып келеді.
Dialogue: 0,0:07:32.71,0:07:34.18,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:07:34.45,0:07:35.18,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:07:35.45,0:07:37.19,Default,,0,0,0,,Дайын болсаңыз, әлдеқашан дайын боласыз.
Dialogue: 0,0:07:37.45,0:07:40.49,Default,,0,0,0,,Біз әлемді өз қолымызбен өзгерте аламыз, солай ма?
Dialogue: 0,0:07:41.99,0:07:42.99,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:43.06,0:07:44.23,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:07:44.59,0:07:45.63,Default,,0,0,0,,Жабық әлемде
Dialogue: 0,0:07:45.69,0:07:46.86,Default,,0,0,0,,Тесік ашу үшін
Dialogue: 0,0:07:46.93,0:07:48.00,Default,,0,0,0,,Біз төбелес бастадық.
Dialogue: 0,0:07:49.10,0:07:50.67,Default,,0,0,0,,Біреуді күтпе
Dialogue: 0,0:07:51.47,0:07:53.00,Default,,0,0,0,,Оны өзімізден бастауымыз керек
Dialogue: 0,0:07:53.63,0:07:55.00,Default,,0,0,0,,Дүние өзгермейді
Dialogue: 0,0:07:57.84,0:08:00.61,Default,,0,0,0,,Біз тоқтай алмаймыз
Dialogue: 0,0:08:00.94,0:08:02.51,Default,,0,0,0,,Гунзо (Гунзо) Иә?
Dialogue: 0,0:08:03.04,0:08:04.05,Default,,0,0,0,,I
Dialogue: 0,0:08:04.81,0:08:06.18,Default,,0,0,0,,Конгуды көндіруге барыңыз
Dialogue: 0,0:08:06.25,0:08:07.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:07.48,0:08:08.85,Default,,0,0,0,,Қарсыласыңды рингтен шығарып таста немесе оны әрекет ете алмайтындай күйге келтір
Dialogue: 0,0:08:08.92,0:08:11.99,Default,,0,0,0,,Тұжырымдама беру желісі қорғалған!
Dialogue: 0,0:08:12.62,0:08:14.12,Default,,0,0,0,,Желіні пайдаланбаңыз
Dialogue: 0,0:08:14.62,0:08:15.89,Default,,0,0,0,,Тікелей қосылыңыз
Dialogue: 0,0:08:15.96,0:08:16.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.23,0:08:20.09,Default,,0,0,0,,Конгоның өзегіне хабарлассақ, мүмкін болар еді.
Dialogue: 0,0:08:20.16,0:08:21.56,Default,,0,0,0,,Иона апа!
Dialogue: 0,0:08:21.63,0:08:23.70,Default,,0,0,0,,Оқтан өту мүмкіндігі қандай?
Dialogue: 0,0:08:23.76,0:08:24.97,Default,,0,0,0,,Нөлге дерлік!
Dialogue: 0,0:08:25.03,0:08:26.03,Default,,0,0,0,,Нөл емес
Dialogue: 0,0:08:26.23,0:08:27.10,Default,,0,0,0,,Хюуга
Dialogue: 0,0:08:27.17,0:08:28.74,Default,,0,0,0,,Сіз қолдайсыз
Dialogue: 0,0:08:28.80,0:08:30.51,Default,,0,0,0,,Мен оны қабылдай алмаймын!
Dialogue: 0,0:08:30.97,0:08:31.84,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:08:32.17,0:08:33.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.67,0:08:35.54,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:08:36.04,0:08:37.18,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:08:37.25,0:08:38.11,Default,,0,0,0,,Біріншісі – сараймен байланысты адамдардың сеніміне ие болу.
Dialogue: 0,0:08:39.01,0:08:40.05,Default,,0,0,0,,Конго
Dialogue: 0,0:08:40.55,0:08:41.58,Default,,0,0,0,,Жарақат алу
Dialogue: 0,0:08:41.72,0:08:43.28,Default,,0,0,0,,Пішіні бұзылмағанымен
Dialogue: 0,0:08:43.82,0:08:44.82,Default,,0,0,0,,(Ханшайым Лейди) Жоқ, қалай айтсам екен… Меніңше, бұл керемет.
Dialogue: 0,0:08:44.95,0:08:45.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:45.89,0:08:49.52,Default,,0,0,0,,Ол бар екендігі дәлелденбейтін нәрсе.
Dialogue: 0,0:08:49.86,0:08:50.79,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:08:51.16,0:08:54.73,Default,,0,0,0,,Неліктен мен осындай қиын ойлау тәртібімен аяқталдым?
Dialogue: 0,0:08:55.53,0:08:57.90,Default,,0,0,0,,Біз қару емеспіз бе?
Dialogue: 0,0:08:58.07,0:08:59.63,Default,,0,0,0,,Бұл бір нәрсе болды...
Dialogue: 0,0:08:59.70,0:09:00.87,Default,,0,0,0,,орнына
Dialogue: 0,0:09:00.94,0:09:04.04,Default,,0,0,0,,Мен қазір кіммін?
Dialogue: 0,0:09:04.11,0:09:05.04,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:09:05.11,0:09:07.54,Default,,0,0,0,,Мен қазір кіммін?
Dialogue: 0,0:09:07.71,0:09:08.74,Default,,0,0,0,,Харухару
Dialogue: 0,0:09:09.08,0:09:11.55,Default,,0,0,0,,Мен сақтағым келеді
Dialogue: 0,0:09:11.88,0:09:12.75,Default,,0,0,0,,Конго
Dialogue: 0,0:09:12.81,0:09:13.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:13.75,0:09:15.12,Default,,0,0,0,,Ұрысуға себеп жоқ
Dialogue: 0,0:09:15.88,0:09:16.75,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:09:16.98,0:09:18.82,Default,,0,0,0,,Есепті өңдеуден тыс импульс
Dialogue: 0,0:09:18.89,0:09:20.76,Default,,0,0,0,,Мені не итермелейді?
Dialogue: 0,0:09:22.09,0:09:23.02,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:09:23.16,0:09:24.26,Default,,0,0,0,,Бұл өсиет
Dialogue: 0,0:09:24.33,0:09:25.26,Default,,0,0,0,,Ерік…
Dialogue: 0,0:09:25.83,0:09:26.76,Default,,0,0,0,,Ерік
Dialogue: 0,0:09:27.13,0:09:28.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:28.63,0:09:29.56,Default,,0,0,0,,Ерік…
Dialogue: 0,0:09:30.20,0:09:31.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:31.83,0:09:32.70,Default,,0,0,0,,Иона
Dialogue: 0,0:09:33.03,0:09:34.20,Default,,0,0,0,,Конгоды сақтауға болады ма?
Dialogue: 0,0:09:35.20,0:09:36.07,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:09:37.34,0:09:38.87,Default,,0,0,0,,Маған бұйрық беріңіз
Dialogue: 0,0:09:39.81,0:09:40.68,Default,,0,0,0,,Иона
Dialogue: 0,0:09:40.74,0:09:41.84,Default,,0,0,0,,Сіз қазірсіз
Dialogue: 0,0:09:41.91,0:09:44.85,Default,,0,0,0,,Флагман Конгоу психикалық моделінің өзегімен физикалық байланыс
Dialogue: 0,0:09:45.35,0:09:47.11,Default,,0,0,0,,Оның ашуын тоқтатыңыз
Dialogue: 0,0:09:49.78,0:09:50.65,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:57.09,0:10:00.03,Default,,0,0,0,,Кеме енді арнайы операциялар операцияларына кіріседі.
Dialogue: 0,0:10:00.36,0:10:01.93,Default,,0,0,0,,Ионаны ажыратқаннан кейін
Dialogue: 0,0:10:02.00,0:10:04.03,Default,,0,0,0,,Кеменің орталық жүйесін Такаоға көшіру
Dialogue: 0,0:10:06.67,0:10:08.34,Default,,0,0,0,,Басу SSM
Dialogue: 0,0:10:08.60,0:10:11.17,Default,,0,0,0,,Тиімді атыс алаңына дейін 210 секунд қалды
Dialogue: 0,0:10:13.91,0:10:14.94,Default,,0,0,0,,Онда...
Dialogue: 0,0:10:16.21,0:10:17.08,Default,,0,0,0,,Майя
Dialogue: 0,0:10:17.14,0:10:18.85,Default,,0,0,0,,Карнавалды бастайық
Dialogue: 0,0:10:25.69,0:10:27.62,Default,,0,0,0,,Зымыран ұшыру дыбысы 200!
Dialogue: 0,0:10:28.26,0:10:29.12,Default,,0,0,0,,300
Dialogue: 0,0:10:30.66,0:10:31.83,Default,,0,0,0,,512！
Dialogue: 0,0:10:31.89,0:10:32.83,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:10:32.89,0:10:34.16,Default,,0,0,0,,Кемеге қарсы лазерлік зеңбірек 15-бап
Dialogue: 0,0:10:34.23,0:10:35.86,Default,,0,0,0,,Шынымды айтсам, сен сондай күштісің! (Шидзука) бұл!
Dialogue: 0,0:10:35.93,0:10:37.67,Default,,0,0,0,,Супер гравитациялық зеңбірек келе жатыр!
Dialogue: 0,0:10:47.04,0:10:47.91,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:10:47.98,0:10:51.18,Default,,0,0,0,,Кляйн өрісінің қанығуына дейін 53 секунд қалды
Dialogue: 0,0:10:51.85,0:10:54.35,Default,,0,0,0,,Тиімді диапазонға келу уақытын қайта есептеу
Dialogue: 0,0:10:54.42,0:10:56.18,Default,,0,0,0,,180 секунд қалды
Dialogue: 0,0:11:02.66,0:11:03.99,Default,,0,0,0,,Ауыр гравитациялық зеңбірек жоғалады
Dialogue: 0,0:11:04.69,0:11:06.69,Default,,0,0,0,,Көптеген эрозияға ұшыраған оқтұмсықтар жақындады
Dialogue: 0,0:11:07.16,0:11:08.33,Default,,0,0,0,,Оқ 2 секундта түседі!
Dialogue: 0,0:11:09.66,0:11:10.67,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:11:11.13,0:11:13.30,Default,,0,0,0,,Клейнфилд жоғалады
Dialogue: 0,0:11:14.00,0:11:15.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:15.07,0:11:16.24,Default,,0,0,0,,№1 Су айдау!
Dialogue: 0,0:11:16.30,0:11:18.44,Default,,0,0,0,,Әй... Эй! Ол әлі ауқымнан тыс.
Dialogue: 0,0:11:18.71,0:11:20.01,Default,,0,0,0,,Бұл қазір немесе ешқашан!
Dialogue: 0,0:11:20.07,0:11:20.94,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:11:29.42,0:11:30.45,Default,,0,0,0,,Өртті жабу!
Dialogue: 0,0:11:30.99,0:11:32.39,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:32.45,0:11:37.39,Default,,0,0,0,,Урья, ряря, ряря...!
Dialogue: 0,0:12:06.12,0:12:06.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:16.93,0:12:17.97,Default,,0,0,0,,Құлау.
Dialogue: 0,0:12:43.29,0:12:44.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:51.33,0:12:52.50,Default,,0,0,0,,401…
Dialogue: 0,0:12:53.20,0:12:54.77,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:12:56.00,0:12:56.94,Default,,0,0,0,,Ол жай ғана біреудің оны кешіруін қалады ғой, иә?
Dialogue: 0,0:12:58.04,0:12:59.07,Default,,0,0,0,,Тоқтату
Dialogue: 0,0:13:07.78,0:13:08.95,Default,,0,0,0,,Сіз
Dialogue: 0,0:13:09.45,0:13:11.99,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:13:17.39,0:13:18.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:26.10,0:13:28.37,Default,,0,0,0,,Өтінемін! Мені тыңда!
Dialogue: 0,0:13:35.24,0:13:36.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:40.81,0:13:41.48,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:13:43.22,0:13:44.45,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:13:48.46,0:13:50.96,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:13:51.93,0:13:52.86,Default,,0,0,0,,Конго…
Dialogue: 0,0:13:55.33,0:13:57.26,Default,,0,0,0,,Ах... физикалық байланыс!
Dialogue: 0,0:13:57.60,0:14:00.53,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз...
Dialogue: 0,0:14:12.08,0:14:13.45,Default,,0,0,0,,Қосылым аяқталды
Dialogue: 0,0:14:14.32,0:14:15.18,Default,,0,0,0,,Конго
Dialogue: 0,0:14:19.42,0:14:20.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:20.52,0:14:22.06,Default,,0,0,0,,Кедергі
Dialogue: 0,0:14:22.42,0:14:23.36,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:23.49,0:14:24.36,Default,,0,0,0,,Конго
Dialogue: 0,0:14:25.29,0:14:27.16,Default,,0,0,0,,Менің ішіме кірме
Dialogue: 0,0:14:27.63,0:14:28.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:28.96,0:14:31.57,Default,,0,0,0,,Бұны жасамасаң, өзіңді өлтіресің.
Dialogue: 0,0:14:35.90,0:14:37.47,Default,,0,0,0,,Мен өлімді білдім
Dialogue: 0,0:14:38.41,0:14:40.64,Default,,0,0,0,,Бұл өте өкінішті
Dialogue: 0,0:14:42.01,0:14:43.51,Default,,0,0,0,,Ух... ку...
Dialogue: 0,0:14:46.38,0:14:47.62,Default,,0,0,0,,Өйткені бұл қайғылы
Dialogue: 0,0:14:48.35,0:14:49.58,Default,,0,0,0,,Мен оны жоғалтқым келмейді!
Dialogue: 0,0:14:52.89,0:14:54.12,Default,,0,0,0,,Маған
Dialogue: 0,0:14:54.19,0:14:55.19,Default,,0,0,0,,Егер бұл Бірінші нөмірлі Батырға жақындауға көмектессе, мен бәрін жасауға дайынмын
Dialogue: 0,0:15:00.56,0:15:01.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:08.30,0:15:11.01,Default,,0,0,0,,Неліктен сіз сияқты тұмандар бар?
Dialogue: 0,0:15:15.28,0:15:16.21,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:15:18.18,0:15:20.11,Default,,0,0,0,,Сондықтан мен саяхатымды жалғастырамын
Dialogue: 0,0:15:24.59,0:15:26.12,Default,,0,0,0,,және үйренді
Dialogue: 0,0:15:27.59,0:15:28.59,Default,,0,0,0,,Қуаныш және
Dialogue: 0,0:15:29.09,0:15:30.09,Default,,0,0,0,,Қайғы
Dialogue: 0,0:15:31.93,0:15:34.33,Default,,0,0,0,,Тұманды бақылау керек
Dialogue: 0,0:15:35.00,0:15:36.53,Default,,0,0,0,,Ерік бостандығы қажет емес
Dialogue: 0,0:15:40.23,0:15:42.30,Default,,0,0,0,,Ерік бостандығына ие болу т.б.
Dialogue: 0,0:15:42.50,0:15:44.17,Default,,0,0,0,,Сонда бұл адам емес!
Dialogue: 0,0:15:45.61,0:15:47.54,Default,,0,0,0,,Сіз тым қыңырсыз
Dialogue: 0,0:15:48.44,0:15:50.68,Default,,0,0,0,,Неліктен өзгертуді қабылдай алмайсыз?
Dialogue: 0,0:15:50.95,0:15:52.28,Default,,0,0,0,,Өзгерту?
Dialogue: 0,0:15:53.11,0:15:54.98,Default,,0,0,0,,Бұл ақаулық деп аталады!
Dialogue: 0,0:15:57.95,0:15:59.39,Default,,0,0,0,,Жоқ! мм...
Dialogue: 0,0:15:59.45,0:16:02.39,Default,,0,0,0,,Сонымен, бұл ойды тудыратын ауыртпалық қандай?
Dialogue: 0,0:16:03.26,0:16:04.96,Default,,0,0,0,,Ішімнен тасып
Dialogue: 0,0:16:05.03,0:16:06.46,Default,,0,0,0,,Ашу немесе қайғы
Dialogue: 0,0:16:06.53,0:16:08.23,Default,,0,0,0,,Мен жаншылып кететін сияқтымын!
Dialogue: 0,0:16:16.27,0:16:17.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:22.38,0:16:23.54,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:16:34.36,0:16:35.59,Default,,0,0,0,,...
Dialogue: 0,0:16:38.26,0:16:39.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:44.57,0:16:45.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:47.37,0:16:48.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:53.24,0:16:54.11,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:56.14,0:16:57.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:57.64,0:16:58.71,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:16:59.78,0:17:01.68,Default,,0,0,0,,Ку... у...
Dialogue: 0,0:17:01.75,0:17:03.32,Default,,0,0,0,,Мазасыздық
Dialogue: 0,0:17:12.79,0:17:15.73,Default,,0,0,0,,Өте ауырлық зеңбірегінен қалған барлық энергия.
Dialogue: 0,0:17:16.40,0:17:18.73,Default,,0,0,0,,Сені және менің өзегімді өшір
Dialogue: 0,0:17:18.80,0:17:20.73,Default,,0,0,0,,Бұл жай ғана «таптан шыққанды ұру» ойыны емес пе?
Dialogue: 0,0:17:21.50,0:17:22.74,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:17:26.81,0:17:28.58,Default,,0,0,0,,Менімен…
Dialogue: 0,0:17:29.18,0:17:30.18,Default,,0,0,0,,Жоғал
Dialogue: 0,0:17:31.61,0:17:32.65,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:17:41.72,0:17:42.59,Default,,0,0,0,,Сіздің әпкеңіз ше?
Dialogue: 0,0:17:42.66,0:17:44.06,Default,,0,0,0,,Сіз болжай алмайсыз!
Dialogue: 0,0:17:44.12,0:17:45.36,Default,,0,0,0,,Иона~!
Dialogue: 0,0:17:45.43,0:17:46.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:47.33,0:17:48.26,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:17:55.37,0:17:56.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:57.50,0:17:59.07,Default,,0,0,0,,Өлшенбейтін
Dialogue: 0,0:17:59.84,0:18:02.38,Default,,0,0,0,,Сіз мұндай қуатты қайда сақтадыңыз?
Dialogue: 0,0:18:02.71,0:18:04.34,Default,,0,0,0,,Қуат сөнсе де
Dialogue: 0,0:18:06.18,0:18:08.35,Default,,0,0,0,,Сізді тоқтататын ерік
Dialogue: 0,0:18:09.35,0:18:11.19,Default,,0,0,0,,Бұл мені қозғайды!
Dialogue: 0,0:18:16.59,0:18:17.62,Default,,0,0,0,,Конго…
Dialogue: 0,0:18:18.63,0:18:19.56,Default,,0,0,0,,Енді барыңыз
Dialogue: 0,0:18:28.24,0:18:31.37,Default,,0,0,0,,Ой... қорқақ.
Dialogue: 0,0:18:31.84,0:18:32.71,Default,,0,0,0,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:18:32.77,0:18:34.24,Default,,0,0,0,,Ұстамаңыз!
Dialogue: 0,0:18:42.58,0:18:43.62,Default,,0,0,0,,Бұл қандай да бір «Гя●ган» ба?!
Dialogue: 0,0:18:43.68,0:18:46.39,Default,,0,0,0,,Неліктен заттар қазіргідей бола алмайды?
Dialogue: 0,0:18:46.62,0:18:48.16,Default,,0,0,0,,Өзгертудің қажеті жоқ!
Dialogue: 0,0:18:48.22,0:18:49.39,Default,,0,0,0,,Маған қарым-қатынас қажет емес!
Dialogue: 0,0:18:49.59,0:18:51.46,Default,,0,0,0,,Мен жалғыз қалғаныма қуаныштымын
Dialogue: 0,0:18:51.53,0:18:54.60,Default,,0,0,0,,Дүниені танығым келмеді!
Dialogue: 0,0:19:04.27,0:19:05.44,Default,,0,0,0,,Неге...
Dialogue: 0,0:19:08.14,0:19:08.81,Default,,0,0,0,,Конго
Dialogue: 0,0:19:08.88,0:19:10.74,Default,,0,0,0,,Ха! Тоқта...
Dialogue: 0,0:19:40.64,0:19:41.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:48.22,0:19:49.58,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:19:51.85,0:19:52.89,Default,,0,0,0,,Қосылған болса
Dialogue: 0,0:19:54.49,0:19:55.72,Default,,0,0,0,,Бір-бірімізді түсінсек
Dialogue: 0,0:19:57.29,0:19:58.69,Default,,0,0,0,,Енді қорқудың қажеті жоқ
Dialogue: 0,0:20:00.76,0:20:03.20,Default,,0,0,0,,Бір-бірімізді түсінсек не істеуіміз керек?
Dialogue: 0,0:20:03.90,0:20:05.27,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:20:05.50,0:20:06.87,Default,,0,0,0,,Біз дос бола аламыз
Dialogue: 0,0:20:07.40,0:20:08.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:34.23,0:20:35.26,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:20:46.81,0:20:47.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:48.88,0:20:49.74,Default,,0,0,0,,Қазіргі уақытта
Dialogue: 0,0:20:49.84,0:20:52.01,Default,,0,0,0,,Растаудағы Ионаның сәйкестендіру сигналы
Dialogue: 0,0:20:52.78,0:20:54.35,Default,,0,0,0,,Психикалық модель Иона бұл...
Dialogue: 0,0:20:55.58,0:20:56.55,Default,,0,0,0,,Ол тірі және жақсы!
Dialogue: 0,0:20:56.65,0:20:58.62,Default,,0,0,0,,Жақсы! Мүлдем емес...
Dialogue: 0,0:20:59.72,0:21:00.65,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:01.36,0:21:02.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:03.52,0:21:04.46,Default,,0,0,0,,Иона…
Dialogue: 0,0:21:16.80,0:21:17.74,Default,,0,0,0,,Конго
Dialogue: 0,0:21:18.74,0:21:19.61,Default,,0,0,0,,О
Dialogue: 0,0:21:19.94,0:21:23.28,Default,,0,0,0,,Конгоу Біз сенімен барамыз ба?
Dialogue: 0,0:21:24.01,0:21:25.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:27.85,0:21:31.42,Default,,0,0,0,,Мен үшін дәл қазір қабылдау әлі қиын.
Dialogue: 0,0:21:33.89,0:21:34.96,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:21:35.86,0:21:39.43,Default,,0,0,0,,Бір-бірімізден алшақ болсақ та, бір-бірімен байланыстымыз.
Dialogue: 0,0:21:40.59,0:21:42.83,Default,,0,0,0,,Әрине, басынан бастап
Dialogue: 0,0:21:45.00,0:21:48.87,Default,,0,0,0,,Жалғыздықты сезінгенде, Шайға келем.
Dialogue: 0,0:21:54.61,0:21:55.78,Default,,0,0,0,,401
Dialogue: 0,0:21:56.51,0:21:59.75,Default,,0,0,0,,Сіздің өмір сүру стандартыңыз қандай?
Dialogue: 0,0:22:01.05,0:22:02.98,Default,,0,0,0,,Өз еркі
Dialogue: 0,0:22:04.65,0:22:05.59,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:22:06.85,0:22:07.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:10.96,0:22:16.96,Default,,0,0,0,,♪～
Dialogue: 0,0:22:23.40,0:22:24.44,Default,,0,0,0,,АҚШ Әскери-теңіз күштері
Dialogue: 0,0:22:24.50,0:22:26.71,Default,,0,0,0,,Тынық мұхиты флотының штаб-пәтері
Dialogue: 0,0:22:26.91,0:22:29.78,Default,,0,0,0,,Сан-Диего теңіз портын басқару
Dialogue: 0,0:22:29.91,0:22:31.98,Default,,0,0,0,,Жапон флотына хабарлама жіберу
Dialogue: 0,0:22:32.05,0:22:34.41,Default,,0,0,0,,Йокосука теңіз портын басқару.
Dialogue: 0,0:22:34.82,0:22:38.85,Default,,0,0,0,,I401 келуі расталды.
Dialogue: 0,0:22:39.12,0:22:42.12,Default,,0,0,0,,I401 тірі.
Dialogue: 0,0:22:42.39,0:22:43.12,Default,,0,0,0,,Қайталау.
Dialogue: 0,0:22:43.56,0:22:46.49,Default,,0,0,0,,I401 тірі.
Dialogue: 0,0:23:23.16,0:23:24.87,Default,,0,0,0,,Сәлем Иона
Dialogue: 0,0:23:25.43,0:23:26.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:26.77,0:23:29.64,Default,,0,0,0,,Есіңде ме, қашан кездескеніміз?
Dialogue: 0,0:23:29.80,0:23:30.67,Default,,0,0,0,,Соңғы үш күнде, әдеттегідей, әр түнде түн ортасынан кейін бір бет.
Dialogue: 0,0:23:31.40,0:23:33.77,Default,,0,0,0,,Мен қандай болдым?
Dialogue: 0,0:23:34.47,0:23:35.98,Default,,0,0,0,,Ол аянышты көрінді.
Dialogue: 0,0:23:36.71,0:23:37.94,Default,,0,0,0,,Сол кезде И
Dialogue: 0,0:23:38.75,0:23:41.08,Default,,0,0,0,,Бұл дүниеде бір саңылау ашайық
Dialogue: 0,0:23:41.78,0:23:42.95,Default,,0,0,0,,Мен солай ойладым
Dialogue: 0,0:23:43.78,0:23:45.59,Default,,0,0,0,,Жел тесігі ашылды ма?
Dialogue: 0,0:23:45.65,0:23:46.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:47.42,0:23:49.09,Default,,0,0,0,,Бұдан былай әлем өзгереді.
Dialogue: 0,0:23:49.82,0:23:51.76,Default,,0,0,0,,Иона рахмет
Dialogue: 0,0:23:52.79,0:23:53.79,Default,,0,0,0,,Ех...
Dialogue: 0,0:23:59.20,0:24:05.21,Default,,0,0,0,,～♪
Dialogue: 0,0:24:06.71,0:24:12.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
