Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:41.50,0:00:43.47,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:00:43.77,0:00:46.54,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:00:49.48,0:00:50.51,Default,,0,0,0,,Иона…
Dialogue: 0,0:00:53.78,0:00:54.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:55.42,0:00:56.52,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:00:56.58,0:00:57.45,Default,,0,0,0,,О... О!
Dialogue: 0,0:00:59.35,0:01:01.72,Default,,0,0,0,,Толық жарылыс режимінің әсерінен
Dialogue: 0,0:01:02.36,0:01:04.06,Default,,0,0,0,,Сонар сезімталдығы төмендеді
Dialogue: 0,0:01:04.13,0:01:05.56,Default,,0,0,0,,Жауап кешіктірілді
Dialogue: 0,0:01:05.73,0:01:06.66,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:01:07.16,0:01:09.43,Default,,0,0,0,,Алдымен зақымдану жағдайын тексеріңіз
Dialogue: 0,0:01:09.50,0:01:11.30,Default,,0,0,0,,және жөндеу жұмыстары.
Dialogue: 0,0:01:11.37,0:01:13.47,Default,,0,0,0,,Диск жүйесін қалпына келтіруге басымдық беріңіз
Dialogue: 0,0:01:13.57,0:01:14.44,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:01:19.07,0:01:20.84,Default,,0,0,0,,Өзін-өзі жөндеу бағдарламасын іске қосу
Dialogue: 0,0:01:21.14,0:01:24.48,Default,,0,0,0,,Наноматериалдарды пайдаланып ақаулы аймақты қалпына келтіруді бастаңыз
Dialogue: 0,0:01:25.81,0:01:26.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:26.78,0:01:27.65,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:27.72,0:01:31.49,Default,,0,0,0,,Өзін-өзі жөндеу бағдарламасының белсендіру жылдамдығы айтарлықтай төмендеді
Dialogue: 0,0:01:31.62,0:01:33.49,Default,,0,0,0,,Қазіргі уақытта 9,1 пайыз
Dialogue: 0,0:01:33.76,0:01:35.76,Default,,0,0,0,,Су басқан аумақтардың артуы
Dialogue: 0,0:01:38.86,0:01:41.53,Default,,0,0,0,,Жөндеу бағдарламасы жұмыс істемейді ме?
Dialogue: 0,0:01:41.86,0:01:45.17,Default,,0,0,0,,Флотты құрайтын наноматериалдарды инициализациялау
Dialogue: 0,0:01:45.23,0:01:46.84,Default,,0,0,0,,Қайта жазылғанына дәлел бар.
Dialogue: 0,0:01:47.24,0:01:48.14,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:01:48.74,0:01:50.57,Default,,0,0,0,,Кейбір наноматериалдар
Dialogue: 0,0:01:50.77,0:01:53.24,Default,,0,0,0,,Менің командаларымды енді қабылдамаймын
Dialogue: 0,0:01:53.71,0:01:55.74,Default,,0,0,0,,Мұндай шабуыл болуы мүмкін...
Dialogue: 0,0:01:57.45,0:01:59.11,Default,,0,0,0,,Алдыңғы шабуылмен
Dialogue: 0,0:01:59.31,0:02:01.42,Default,,0,0,0,,401
Dialogue: 0,0:02:01.48,0:02:03.25,Default,,0,0,0,,Кейбір наноматериалдар
Dialogue: 0,0:02:03.38,0:02:05.32,Default,,0,0,0,,біздің бақылауымызға алынды
Dialogue: 0,0:02:05.89,0:02:08.29,Default,,0,0,0,,Наноматериалдарды қайта инициализациялау
Dialogue: 0,0:02:08.79,0:02:13.33,Default,,0,0,0,,Өйткені біз 401 пішімі бірдей бауырлас кемеміз.
Dialogue: 0,0:02:13.39,0:02:14.46,Default,,0,0,0,,Ықтимал тактика
Dialogue: 0,0:02:14.73,0:02:16.43,Default,,0,0,0,,Енді 401
Dialogue: 0,0:02:16.50,0:02:20.44,Default,,0,0,0,,Сіз үнемі өсіп келе жатқан су қысымынан қорғанысыңызды жоғалттыңыз.
Dialogue: 0,0:02:20.70,0:02:23.24,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:02:23.61,0:02:26.57,Default,,0,0,0,,401 қайта пайда болуы мүмкін
Dialogue: 0,0:02:26.64,0:02:27.51,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:02:30.68,0:02:33.15,Default,,0,0,0,,401 әлі табылмады ма?
Dialogue: 0,0:02:33.62,0:02:35.88,Default,,0,0,0,,Айналадағы суларда кемелер болмайды
Dialogue: 0,0:02:36.32,0:02:39.52,Default,,0,0,0,,Кездесу орны міндетті түрде осы жерде болуы керек, солай емес пе?
Dialogue: 0,0:02:39.59,0:02:41.39,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:02:41.49,0:02:44.33,Default,,0,0,0,,Конгодан аман-есен қашып үлгермедің бе?
Dialogue: 0,0:02:44.46,0:02:46.63,Default,,0,0,0,,Хмм... Менің ойымша...
Dialogue: 0,0:02:46.79,0:02:49.36,Default,,0,0,0,,Такао үнемі телефон соғып тұрған сияқты.
Dialogue: 0,0:02:49.80,0:02:51.80,Default,,0,0,0,,Әлі жауап жоқ сияқты.
Dialogue: 0,0:02:52.30,0:02:53.67,Default,,0,0,0,,Эй... болмайды
Dialogue: 0,0:02:53.74,0:02:57.67,Default,,0,0,0,,Иона мен Гунзо Олар жеңілген жоқ, солай ма?
Dialogue: 0,0:02:57.74,0:02:58.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:59.27,0:03:00.17,Default,,0,0,0,,Харухару
Dialogue: 0,0:03:00.28,0:03:01.58,Default,,0,0,0,,Полиция қызметкері айтқандай—
Dialogue: 0,0:03:02.81,0:03:04.28,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:03:04.58,0:03:08.68,Default,,0,0,0,,Алдыңғы шайқаста бір-біріне кедергі келтіретін аса ауырлық зеңбіректерінің нәтижесі.
Dialogue: 0,0:03:08.88,0:03:12.79,Default,,0,0,0,,Айналадағы теңіз аймағының кеңістіктік фазасында қатты бұзылулар орын алады
Dialogue: 0,0:03:13.59,0:03:16.66,Default,,0,0,0,,Осымен концепциялық коммуникация пайдасыз.
Dialogue: 0,0:03:16.82,0:03:20.66,Default,,0,0,0,,Сонымен... біреу ойланбастан, бұлдырап айтып қояды.
Dialogue: 0,0:03:20.73,0:03:22.26,Default,,0,0,0,,Оған көмектесу мүмкін емес! Уау
Dialogue: 0,0:03:22.33,0:03:24.50,Default,,0,0,0,,Мен сені атқаным болмаса, сен де өлтірер едің.
Dialogue: 0,0:03:24.57,0:03:26.27,Default,,0,0,0,,Уф! Ммм...
Dialogue: 0,0:03:26.33,0:03:28.47,Default,,0,0,0,,Біріншіден, мен қарсы болдым!
Dialogue: 0,0:03:28.54,0:03:30.34,Default,,0,0,0,,Иона-саманың жем болып жатқанына сене алмайсың!
Dialogue: 0,0:03:30.84,0:03:32.41,Default,,0,0,0,,Бұл бала бәрібір!
Dialogue: 0,0:03:32.47,0:03:34.94,Default,,0,0,0,,Күте тұрыңыз~ Жартылай ұйықтау туралы не айтасыз?
Dialogue: 0,0:03:35.21,0:03:37.21,Default,,0,0,0,,Конгу мен Майяның реакциялары әлдеқашан жойылды.
Dialogue: 0,0:03:37.28,0:03:37.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:38.61,0:03:43.42,Default,,0,0,0,,Әзірге мен 401 реакциясы жоғалған аймаққа баруды ұсынамын.
Dialogue: 0,0:03:43.99,0:03:44.85,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:45.62,0:03:46.49,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:58.63,0:04:00.77,Default,,0,0,0,,Чихая Гунзо…
Dialogue: 0,0:04:07.68,0:04:09.58,Default,,0,0,0,,(ойыншық фортепиано дыбысы)
Dialogue: 0,0:04:13.51,0:04:16.38,Default,,0,0,0,,401-ді рұқсатсыз неге суға батырдың?
Dialogue: 0,0:04:16.88,0:04:19.55,Default,,0,0,0,,Сіз ерікті деп нені айтып тұрғаныңызды түсінбедім.
Dialogue: 0,0:04:19.89,0:04:23.66,Default,,0,0,0,,401-нің батуы - тұманның жалпы ниеті.
Dialogue: 0,0:04:23.83,0:04:27.73,Default,,0,0,0,,Бірақ сол кезде онымен соғысқан мен едім.
Dialogue: 0,0:04:28.30,0:04:30.77,Default,,0,0,0,,401 толық үзіліс режимін пайдаланады
Dialogue: 0,0:04:31.43,0:04:33.97,Default,,0,0,0,,Мен сіздің іздеу ауқымыңыздан шыққаннан кейін.
Dialogue: 0,0:04:34.04,0:04:34.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:35.67,0:04:38.97,Default,,0,0,0,,Балалар, сендер неге бірінші кезекте сол аймақта болдыңдар?
Dialogue: 0,0:04:39.51,0:04:40.81,Default,,0,0,0,,Мен ешқандай есеп алған жоқпын.
Dialogue: 0,0:04:41.04,0:04:43.71,Default,,0,0,0,,Біз сізді бақылап отырдық.
Dialogue: 0,0:04:44.45,0:04:46.38,Default,,0,0,0,,Сіз де Такао және басқалар сияқтысыз.
Dialogue: 0,0:04:46.45,0:04:49.05,Default,,0,0,0,,401-ге сәйкес келу мүмкіндігі болды
Dialogue: 0,0:04:49.45,0:04:54.02,Default,,0,0,0,,Мен олар сияқты 401-ге қосыламын деп ойладыңыз ба?
Dialogue: 0,0:04:54.49,0:04:56.29,Default,,0,0,0,,Бұл мүмкіндік мәселесі.
Dialogue: 0,0:04:56.36,0:05:00.96,Default,,0,0,0,,Шындығында, сіз әлі де 401-ге қажеттен артық қосыласыз.
Dialogue: 0,0:05:01.36,0:05:02.33,Default,,0,0,0,,Мен?
Dialogue: 0,0:05:02.96,0:05:04.30,Default,,0,0,0,,Мұның бәрі есеп беру үшін.
Dialogue: 0,0:05:04.40,0:05:06.07,Default,,0,0,0,,Патрульдік операцияларға оралу
Dialogue: 0,0:05:06.63,0:05:07.50,Default,,0,0,0,,Конго
Dialogue: 0,0:05:10.31,0:05:11.51,Default,,0,0,0,,Қосымша…
Dialogue: 0,0:05:13.41,0:05:14.08,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:14.61,0:05:17.95,Default,,0,0,0,,Мен Адмиралтейт кодексіне қарсымын...
Dialogue: 0,0:05:18.01,0:05:20.82,Default,,0,0,0,,Бұл бетті жасама~ Конгоу
Dialogue: 0,0:05:21.45,0:05:22.32,Default,,0,0,0,,Майя?
Dialogue: 0,0:05:22.38,0:05:23.48,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:05:23.55,0:05:27.36,Default,,0,0,0,,Енді 401 туралы уайымдаудың қажеті жоқ~
Dialogue: 0,0:05:27.82,0:05:28.69,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:28.99,0:05:30.79,Default,,0,0,0,,Конгоу бұрынғыдай қалды.
Dialogue: 0,0:05:30.86,0:05:34.73,Default,,0,0,0,,Тек Адмиралти кодексін адал орындаңыз!
Dialogue: 0,0:05:35.46,0:05:36.73,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:05:37.73,0:05:39.47,Default,,0,0,0,,Иә... бұл дұрыс.
Dialogue: 0,0:05:39.57,0:05:40.90,Default,,0,0,0,,Иә! Дұрыс~
Dialogue: 0,0:05:51.08,0:05:55.85,Default,,0,0,0,,Тиісті теңіз аймағында 1000 метр тереңдікте іздеу аяқталды
Dialogue: 0,0:05:56.72,0:05:58.52,Default,,0,0,0,,401 реакциясы
Dialogue: 0,0:05:58.95,0:05:59.82,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:00.79,0:06:02.86,Default,,0,0,0,,Тағы да Конго мен Майядан басқа
Dialogue: 0,0:06:02.92,0:06:06.39,Default,,0,0,0,,Бізге біреу шабуыл жасады деп ойлау табиғи ма...
Dialogue: 0,0:06:06.66,0:06:07.73,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:06:08.63,0:06:11.90,Default,,0,0,0,,Осы жердегі мұхит траншеясының тереңдігі 9000 метр.
Dialogue: 0,0:06:12.47,0:06:15.04,Default,,0,0,0,,Егер ол сол жерге батып кетсе, оны іздеудің жолы жоқ.
Dialogue: 0,0:06:15.44,0:06:17.97,Default,,0,0,0,,Сонда да іздегеннен басқа амалым жоқ!
Dialogue: 0,0:06:20.78,0:06:22.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:22.71,0:06:23.64,Default,,0,0,0,,(Бенедикт) Бұл миссияның қаншалықты маңызды екенін көрсетеді.
Dialogue: 0,0:06:23.71,0:06:24.85,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:06:25.38,0:06:26.61,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:06:26.68,0:06:28.38,Default,,0,0,0,,Сүңгіп, оны тікелей іздеңіз!
Dialogue: 0,0:06:28.92,0:06:30.99,Default,,0,0,0,,Мен ештеңе айтқан жоқпын!
Dialogue: 0,0:06:31.45,0:06:33.12,Default,,0,0,0,,Иона апаға шабуыл жасаған жау
Dialogue: 0,0:06:33.45,0:06:35.62,Default,,0,0,0,,Ол бір жерде жасырынып жүрген болуы мүмкін!
Dialogue: 0,0:06:35.86,0:06:37.49,Default,,0,0,0,,Ой... сұмдық!
Dialogue: 0,0:06:47.50,0:06:49.64,Default,,0,0,0,,Теңізде кеменің белгісі болмағандықтан
Dialogue: 0,0:06:49.70,0:06:51.54,Default,,0,0,0,,Жау сүңгуір қайық шығар.
Dialogue: 0,0:06:51.94,0:06:53.67,Default,,0,0,0,,Сіз ауыр крейсерсіз.
Dialogue: 0,0:06:53.74,0:06:55.18,Default,,0,0,0,,Су астындағы шайқаста тиімсіз
Dialogue: 0,0:06:56.11,0:06:56.98,Default,,0,0,0,,Неге...
Dialogue: 0,0:06:57.98,0:07:00.95,Default,,0,0,0,,Неге сонша сабырлы көрінесің!
Dialogue: 0,0:07:01.02,0:07:04.55,Default,,0,0,0,,Кәдімгі «Иона-ни-сама~» не болды?
Dialogue: 0,0:07:05.62,0:07:07.02,Default,,0,0,0,,Сізде жақсы болуы мүмкін емес.
Dialogue: 0,0:07:07.09,0:07:07.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:08.02,0:07:11.63,Default,,0,0,0,,Бірақ мен Иона әпкеге жауапты болдым.
Dialogue: 0,0:07:11.86,0:07:13.03,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:07:13.43,0:07:16.06,Default,,0,0,0,,Мен Иона апаның өсиетін орындауым керек.
Dialogue: 0,0:07:18.80,0:07:19.80,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:20.03,0:07:22.17,Default,,0,0,0,,Хюуга, оны маған қарызға берші.
Dialogue: 0,0:07:22.44,0:07:23.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.64,0:07:26.51,Default,,0,0,0,,Такао! Сіз...
Dialogue: 0,0:07:26.81,0:07:27.81,Default,,0,0,0,,Оның сізді тоқтатуына жол бермеңіз
Dialogue: 0,0:07:28.14,0:07:29.74,Default,,0,0,0,,Мен жалғыз барамын!
Dialogue: 0,0:07:30.55,0:07:31.21,Default,,0,0,0,,Капитан...
Dialogue: 0,0:07:31.98,0:07:34.05,Default,,0,0,0,,Гунзо күтіп тұр!
Dialogue: 0,0:07:38.55,0:07:41.22,Default,,0,0,0,,14 жаңа бөлімшелер қалқаларды зақымдады
Dialogue: 0,0:07:41.66,0:07:42.66,Default,,0,0,0,,Су тасқыны басталады
Dialogue: 0,0:07:42.96,0:07:44.06,Default,,0,0,0,,Матака?
Dialogue: 0,0:07:44.69,0:07:47.46,Default,,0,0,0,,Iona Purge су басқан аумақтар
Dialogue: 0,0:07:48.90,0:07:50.50,Default,,0,0,0,,Ах... (Гунзо) Не болды?
Dialogue: 0,0:07:50.93,0:07:55.20,Default,,0,0,0,,Бұл бөлімшенің ішінде кемені оттегімен қамтамасыз ету жүйесі орналасқан.
Dialogue: 0,0:07:55.47,0:07:56.17,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:07:56.54,0:07:57.67,Default,,0,0,0,,Тазарту!
Dialogue: 0,0:07:57.84,0:08:01.01,Default,,0,0,0,,Кем дегенде, кеме функцияларын сақтау үшін қажет бөлімдер ғана
Dialogue: 0,0:08:01.08,0:08:02.51,Default,,0,0,0,,Кляйн өрісінде қорғаңыз
Dialogue: 0,0:08:02.58,0:08:03.68,Default,,0,0,0,,Хмм... у... Ах, Гунзо!
Dialogue: 0,0:08:04.05,0:08:06.75,Default,,0,0,0,,Уф... жасай бер! Иона
Dialogue: 0,0:08:07.08,0:08:07.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:08.92,0:08:09.78,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:08:09.85,0:08:10.72,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:08:10.79,0:08:12.05,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:08:18.16,0:08:19.99,Default,,0,0,0,,Такао және оның достарымен қарым-қатынас туралы не айтасыз?
Dialogue: 0,0:08:20.53,0:08:23.03,Default,,0,0,0,,Ортақ аймақтарға әлі қол жеткізу мүмкін емес
Dialogue: 0,0:08:23.50,0:08:25.23,Default,,0,0,0,,Тұжырымдаманы тасымалдау мүмкін емес
Dialogue: 0,0:08:25.90,0:08:26.77,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:27.10,0:08:32.74,Default,,0,0,0,,Мүмкін, аса ауырлық зеңбіректерінің өзара араласуынан туындаған кеңістіктік ауытқулардың әсері болуы мүмкін.
Dialogue: 0,0:08:33.04,0:08:33.91,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:34.61,0:08:38.71,Default,,0,0,0,,Кез келген жағдайда апат сигналын қалыпты желіде қалдырыңыз.
Dialogue: 0,0:08:38.91,0:08:39.81,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:40.28,0:08:41.15,Default,,0,0,0,,Қазір...
Dialogue: 0,0:08:41.75,0:08:44.55,Default,,0,0,0,,Бұл орын алса, күту ғана қалады.
Dialogue: 0,0:08:44.75,0:08:45.62,Default,,0,0,0,,Иә
Dialogue: 0,0:08:47.96,0:08:48.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:49.22,0:08:50.69,Default,,0,0,0,,Монахтарсыз
Dialogue: 0,0:08:50.96,0:08:53.03,Default,,0,0,0,,Мен бәрінде Ионаға сенемін.
Dialogue: 0,0:08:53.53,0:08:54.63,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:08:54.93,0:08:57.67,Default,,0,0,0,,Бастапқыда мен ұшқышсыз навигация жасай алдым.
Dialogue: 0,0:08:58.17,0:08:59.60,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:09:01.04,0:09:04.14,Default,,0,0,0,,Басында Иона екеуміз ғана болдық.
Dialogue: 0,0:09:04.74,0:09:10.61,Default,,0,0,0,,Содан кейін монахтар, Харуна және басқалар, тіпті Такао мен Хюга да қосылды.
Dialogue: 0,0:09:10.88,0:09:14.05,Default,,0,0,0,,Біз білмес бұрын, бізде үлкен үй болды.
Dialogue: 0,0:09:14.68,0:09:15.55,Default,,0,0,0,,Иә
Dialogue: 0,0:09:15.82,0:09:18.95,Default,,0,0,0,,Ойланып қарасаңыз, бұл бәрінің басы еді.
Dialogue: 0,0:09:19.82,0:09:24.19,Default,,0,0,0,,Сіздің біздің академияға студент ретінде ауысады деп ешқашан ойламадым.
Dialogue: 0,0:09:24.73,0:09:28.76,Default,,0,0,0,,Топтық бейнелермен мүмкіндігінше көзге түспейтіндей байланыс орнату қажет болды.
Dialogue: 0,0:09:28.96,0:09:31.13,Default,,0,0,0,,Жоқ... айтарлықтай байқалды.
Dialogue: 0,0:09:31.20,0:09:34.34,Default,,0,0,0,,Біз деректер жинау жеткіліксіз болғанын жоққа шығармаймыз.
Dialogue: 0,0:09:34.60,0:09:36.17,Default,,0,0,0,,Келесі жолы жақсырақ әрекет етіңіз
Dialogue: 0,0:09:36.24,0:09:37.10,Default,,0,0,0,,Иә
Dialogue: 0,0:09:37.17,0:09:38.84,Default,,0,0,0,,Келесісі қашан?
Dialogue: 0,0:09:40.17,0:09:42.21,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:09:42.68,0:09:43.34,Default,,0,0,0,,Суреттерді топтастыру?
Dialogue: 0,0:09:44.11,0:09:45.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:46.15,0:09:47.68,Default,,0,0,0,,Кішкене салқын.
Dialogue: 0,0:09:47.75,0:09:48.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:52.65,0:09:55.06,Default,,0,0,0,,Кеме ішіндегі температура айтарлықтай төмендейді
Dialogue: 0,0:09:55.66,0:09:57.63,Default,,0,0,0,,Бөлме температурасын дереу реттеңіз
Dialogue: 0,0:09:57.69,0:09:58.36,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:58.63,0:10:02.06,Default,,0,0,0,,Дәл қазір біз мүмкіндігінше энергияны ысырап етуден аулақ болуымыз керек.
Dialogue: 0,0:10:02.86,0:10:03.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:11.01,0:10:12.01,Default,,0,0,0,,Иона?
Dialogue: 0,0:10:13.71,0:10:19.71,Default,,0,0,0,,Менің ойымша, метаболикалық функцияларды модельдеуге және дене бетінің температурасын арттыруға болады.
Dialogue: 0,0:10:22.98,0:10:23.88,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:10:26.39,0:10:28.69,Default,,0,0,0,,Хехе, дұрыс.
Dialogue: 0,0:10:28.76,0:10:30.89,Default,,0,0,0,,Энергияны үнемдеу керек
Dialogue: 0,0:10:31.06,0:10:31.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:31.99,0:10:34.96,Default,,0,0,0,,Маған өмір жинағынан көрпе әкеліп бере аласыз ба?
Dialogue: 0,0:10:37.16,0:10:40.20,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:10:45.17,0:10:47.74,Default,,0,0,0,,Иона қатты өзгерді.
Dialogue: 0,0:10:48.24,0:10:51.81,Default,,0,0,0,,Мен сенімен алғаш танысқандағы жеке тұлғамын.
Dialogue: 0,0:10:51.98,0:10:54.25,Default,,0,0,0,,Аппараттық жаңартулар жоқ
Dialogue: 0,0:10:55.08,0:10:57.05,Default,,0,0,0,,Менің айтқым келгені бұл емес...
Dialogue: 0,0:10:57.89,0:10:58.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:59.69,0:11:00.79,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:02.39,0:11:04.33,Default,,0,0,0,,Иона - Иона
Dialogue: 0,0:11:04.89,0:11:05.76,Default,,0,0,0,,Иә
Dialogue: 0,0:11:05.89,0:11:06.76,Default,,0,0,0,,Суреттерді топтастыру?
Dialogue: 0,0:11:08.03,0:11:10.16,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:11:12.93,0:11:13.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.14,0:11:15.00,Default,,0,0,0,,Суреттерді топтастыру?
Dialogue: 0,0:11:16.10,0:11:17.04,Default,,0,0,0,,О
Dialogue: 0,0:11:17.91,0:11:18.87,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:11:20.74,0:11:22.21,Default,,0,0,0,,Мен біраз аң-таң болдым.
Dialogue: 0,0:11:25.91,0:11:28.42,Default,,0,0,0,,Дене қызуының төмендеуі Импульс жиілігінің жоғарылауы
Dialogue: 0,0:11:29.12,0:11:30.12,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:30.35,0:11:32.45,Default,,0,0,0,,Жарайды, Иона.
Dialogue: 0,0:11:32.85,0:11:34.19,Default,,0,0,0,,Тыныс алудың қиындауы
Dialogue: 0,0:11:34.86,0:11:35.72,Default,,0,0,0,,Тыныс алу?
Dialogue: 0,0:11:37.86,0:11:41.03,Default,,0,0,0,,Кеме ішіндегі CO2 концентрациясы айтарлықтай өсті
Dialogue: 0,0:11:41.10,0:11:44.87,Default,,0,0,0,,Бұл жағдай жалғаса берсе, өмірді қамтамасыз ету бұзылады.
Dialogue: 0,0:11:53.34,0:11:56.81,Default,,0,0,0,,(жүрек соғу жиілігін бақылау дыбысы)
Dialogue: 0,0:12:09.89,0:12:11.33,Default,,0,0,0,,Келіңіздер! Иона…
Dialogue: 0,0:12:12.43,0:12:16.30,Default,,0,0,0,,Мен сізге энергияны ысырап етуден аулақ болуды айттым.
Dialogue: 0,0:12:16.46,0:12:17.33,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:17.40,0:12:18.40,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:19.47,0:12:20.77,Default,,0,0,0,,Егер сіз қозғалмасаңыз
Dialogue: 0,0:12:21.20,0:12:23.17,Default,,0,0,0,,Бұл біраз уақытқа созылады.
Dialogue: 0,0:12:27.21,0:12:29.21,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:12:46.19,0:12:47.13,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:12:48.96,0:12:49.83,Default,,0,0,0,,Не?
Dialogue: 0,0:12:50.53,0:12:51.53,Default,,0,0,0,,Түсінді
Dialogue: 0,0:12:52.17,0:12:56.00,Default,,0,0,0,,Мен өзгердім дегенді қалай түсінесіңдер?
Dialogue: 0,0:12:57.17,0:12:58.04,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:12:58.37,0:13:01.94,Default,,0,0,0,,Біз бұл кемені күтіп ұстау шараларын модельдедік.
Dialogue: 0,0:13:03.31,0:13:05.81,Default,,0,0,0,,Нәтижесінде, ең жақсы әрекет жолы
Dialogue: 0,0:13:05.91,0:13:08.42,Default,,0,0,0,,Міне, сізді кесу үшін
Dialogue: 0,0:13:09.85,0:13:11.12,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:13:13.45,0:13:17.19,Default,,0,0,0,,Мен сенімен бірге теңізге барған күннен бастап
Dialogue: 0,0:13:17.93,0:13:19.19,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:13:21.03,0:13:23.80,Default,,0,0,0,,Егер мен бұл дүниені құтқара алсам, ол аяқталуға жақын
Dialogue: 0,0:13:26.07,0:13:28.00,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:13:28.44,0:13:29.30,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:13:29.37,0:13:30.87,Default,,0,0,0,,Тыңда, Иона.
Dialogue: 0,0:13:31.51,0:13:33.07,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:13:33.34,0:13:37.88,Default,,0,0,0,,Дірілдейтін оқтұмсықты Америкаға жеткізуді ұмытпаңыз.
Dialogue: 0,0:13:38.21,0:13:39.81,Default,,0,0,0,,Сонда сөзсіз
Dialogue: 0,0:13:40.48,0:13:42.38,Default,,0,0,0,,Әлем өзгереді
Dialogue: 0,0:13:45.35,0:13:48.89,Default,,0,0,0,,Бұрын мен мұны ойланбастан жасайтын едім.
Dialogue: 0,0:13:49.42,0:13:52.83,Default,,0,0,0,,Олай етпеуге ешқандай себеп болмауы керек еді.
Dialogue: 0,0:13:53.26,0:13:56.03,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:13:58.17,0:14:00.23,Default,,0,0,0,,Мен сені тастап кете алмаймын
Dialogue: 0,0:14:01.14,0:14:02.40,Default,,0,0,0,,(Цуугата) Жұмыс тәжірибесінің бір бөлігі болсаң да, кем дегенде патрульге шығасың ғой—
Dialogue: 0,0:14:07.21,0:14:10.14,Default,,0,0,0,,186 секунд бұрын Әлсіз болса да\NМен апат сигналын алдым, ол
Dialogue: 0,0:14:10.24,0:14:13.45,Default,,0,0,0,,401-тен шыққан деп есептелді.
Dialogue: 0,0:14:13.98,0:14:15.55,Default,,0,0,0,,Жағдайларға қарап
Dialogue: 0,0:14:16.02,0:14:20.12,Default,,0,0,0,,Әпке сүңгуір қайық ретіндегі көптеген функцияларын жоғалтты.
Dialogue: 0,0:14:20.29,0:14:21.19,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:22.89,0:14:24.12,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:14:24.49,0:14:25.43,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:14:26.06,0:14:28.03,Default,,0,0,0,,Чихая Гунзо қазірдің өзінде...
Dialogue: 0,0:14:28.56,0:14:30.03,Default,,0,0,0,,Ә? Жоқ, мен ештеңе істеген жоқпын…
Dialogue: 0,0:14:30.40,0:14:31.47,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:14:32.00,0:14:34.13,Default,,0,0,0,,Егер шамалы болса да мүмкіндік болса
Dialogue: 0,0:14:34.87,0:14:36.04,Default,,0,0,0,,Мен барамын!
Dialogue: 0,0:14:37.17,0:14:40.94,Default,,0,0,0,,Гунзо... менің капитаным
Dialogue: 0,0:14:57.16,0:14:58.19,Default,,0,0,0,,Иона…
Dialogue: 0,0:14:58.89,0:14:59.56,Default,,0,0,0,,Иона…
Dialogue: 0,0:14:59.63,0:15:00.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:02.46,0:15:03.33,Default,,0,0,0,,Суреттерді топтастыру?
Dialogue: 0,0:15:06.23,0:15:10.60,Default,,0,0,0,,Тіршілікті қамтамасыз етуге қажетті функциялар
Dialogue: 0,0:15:11.01,0:15:12.67,Default,,0,0,0,,үшінн кесіңіз
Dialogue: 0,0:15:13.01,0:15:17.28,Default,,0,0,0,,Кеменің негізгі функцияларын қорғауға назар аударыңыз.
Dialogue: 0,0:15:20.58,0:15:22.98,Default,,0,0,0,,Бұл капитанның бұйрығы ма?
Dialogue: 0,0:15:24.42,0:15:25.29,Default,,0,0,0,,О
Dialogue: 0,0:15:27.12,0:15:27.99,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:28.56,0:15:29.49,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:15:30.12,0:15:32.06,Default,,0,0,0,,Иона...
Dialogue: 0,0:15:33.03,0:15:34.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:41.57,0:15:42.44,Default,,0,0,0,,Суреттерді топтастыру?
Dialogue: 0,0:15:45.11,0:15:47.17,Default,,0,0,0,,Топтық сурет? Топтық суреттер!
Dialogue: 0,0:15:47.51,0:15:48.41,Default,,0,0,0,,Оян!
Dialogue: 0,0:15:51.58,0:15:52.45,Default,,0,0,0,,Гунзо!
Dialogue: 0,0:15:55.12,0:15:57.48,Default,,0,0,0,,Ах... топтық сурет
Dialogue: 0,0:16:16.14,0:16:17.40,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:17.71,0:16:18.64,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:19.67,0:16:20.54,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:16:20.74,0:16:23.54,Default,,0,0,0,,Мен жалғыз қалғым келмейді!
Dialogue: 0,0:16:24.51,0:16:25.61,Default,,0,0,0,,Гунзо!
Dialogue: 0,0:16:35.72,0:16:38.06,Default,,0,0,0,,Қайда? Қайда?
Dialogue: 0,0:16:38.59,0:16:41.03,Default,,0,0,0,,Жауап беріңіз! 401
Dialogue: 0,0:16:43.46,0:16:44.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:53.11,0:16:54.54,Default,,0,0,0,,Таптым! Ах...
Dialogue: 0,0:17:07.65,0:17:08.52,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:17:15.76,0:17:16.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:27.27,0:17:30.04,Default,,0,0,0,,Чихая... Гунзо!
Dialogue: 0,0:17:30.24,0:17:31.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:37.72,0:17:38.72,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:17:39.62,0:17:42.26,Default,,0,0,0,,Бұл шынымен сенсің.
Dialogue: 0,0:17:44.26,0:17:48.33,Default,,0,0,0,,Мен үшін бұл бос орын емес.
Dialogue: 0,0:17:49.40,0:17:51.13,Default,,0,0,0,,Бұл еш жерде емес.
Dialogue: 0,0:18:29.57,0:18:31.27,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,0:18:49.86,0:18:54.23,Default,,0,0,0,,Басқаларды құтқару үшін өзіңізді құрбан етіңіз
Dialogue: 0,0:18:54.46,0:18:57.76,Default,,0,0,0,,Бұл әдетте тұман үшін мүмкін болмайтын әрекет.
Dialogue: 0,0:18:58.60,0:19:02.64,Default,,0,0,0,,Иона апа мұндай таңдау жасайды деп ойламаппын.
Dialogue: 0,0:19:03.27,0:19:04.74,Default,,0,0,0,,Сіз де
Dialogue: 0,0:19:05.14,0:19:05.81,Default,,0,0,0,,Хун
Dialogue: 0,0:19:06.51,0:19:09.44,Default,,0,0,0,,Өзіңізді құрайтын наноматериалдарды пайдалансаңыз
Dialogue: 0,0:19:09.51,0:19:12.75,Default,,0,0,0,,Иона апаның денесін қалпына келтіруге болады.
Dialogue: 0,0:19:13.31,0:19:16.72,Default,,0,0,0,,Бірақ бұл жолы сіз денеңізді жоғалтасыз.
Dialogue: 0,0:19:17.35,0:19:20.45,Default,,0,0,0,,Енді Иво Джиманың жинақталған наноматериалдары жоғалып кетті
Dialogue: 0,0:19:20.52,0:19:23.19,Default,,0,0,0,,Көбейту мүмкін емес дерлік.
Dialogue: 0,0:19:23.52,0:19:24.89,Default,,0,0,0,,(Танжиро) Ал, баста! (Үшеуі) Бар күшіңді сал!
Dialogue: 0,0:19:25.79,0:19:27.53,Default,,0,0,0,,Сен мұнымен жақсысың ба?
Dialogue: 0,0:19:28.33,0:19:30.36,Default,,0,0,0,,Бұл капитан...
Dialogue: 0,0:19:31.37,0:19:33.70,Default,,0,0,0,,Чихая Гунзо қаласа
Dialogue: 0,0:20:07.43,0:20:08.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:11.61,0:20:12.57,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:20:23.72,0:20:24.85,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:25.92,0:20:26.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:40.73,0:20:42.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:46.61,0:20:48.81,Default,,0,0,0,,Тірі!
Dialogue: 0,0:20:59.35,0:21:01.86,Default,,0,0,0,,(ойыншық фортепиано дыбысы)
Dialogue: 0,0:21:05.73,0:21:06.79,Default,,0,0,0,,Конго?
Dialogue: 0,0:21:21.41,0:21:24.85,Default,,0,0,0,,401 Такаомен қосылып, функционалдылықты қалпына келтіреді
Dialogue: 0,0:21:24.91,0:21:26.41,Default,,0,0,0,,шықты
Dialogue: 0,0:21:26.65,0:21:27.51,Default,,0,0,0,,Не?
Dialogue: 0,0:21:28.32,0:21:31.85,Default,,0,0,0,,Логикадан тыс жағдай дереу түзетілуі керек
Dialogue: 0,0:21:32.72,0:21:35.02,Default,,0,0,0,,Түсіндім, 401...
Dialogue: 0,0:21:35.29,0:21:35.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:36.39,0:21:39.29,Default,,0,0,0,,Жақсы... болуы керек.
Dialogue: 0,0:21:40.39,0:21:41.56,Default,,0,0,0,,Кеттік, Майя!
Dialogue: 0,0:21:42.30,0:21:45.90,Default,,0,0,0,,Бұл жолы мен 401-ді өз қолыммен жеңемін!
Dialogue: 0,0:21:46.53,0:21:47.73,Default,,0,0,0,,Жылдам, бізді Диоға апар.
Dialogue: 0,0:21:48.60,0:21:50.64,Default,,0,0,0,,Адмиралтейт кодексіне негізделген
Dialogue: 0,0:21:50.94,0:21:56.41,Default,,0,0,0,,Конго Сіз Шығыс бірінші крейсер флотының флагманы ретінде жұмыстан шығарылдыңыз.
Dialogue: 0,0:21:56.94,0:21:58.38,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:21:58.78,0:22:03.05,Default,,0,0,0,,Сіздің ойлау алгоритміңізде бірдеңе дұрыс емес.
Dialogue: 0,0:22:03.62,0:22:08.42,Default,,0,0,0,,Ағымдағы жағдайларда флоттың флагманы ретінде қалыпты пікірді күтуге болмайды.
Dialogue: 0,0:22:08.56,0:22:13.06,Default,,0,0,0,,401 біздің жауапкершілігіміз болып қала береді.
Dialogue: 0,0:22:13.56,0:22:16.43,Default,,0,0,0,,Басқа өмір болғанша күту керек.
Dialogue: 0,0:22:18.43,0:22:19.10,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:22:19.43,0:22:20.10,Default,,0,0,0,,Не?
Dialogue: 0,0:22:20.80,0:22:21.80,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:22:22.00,0:22:23.00,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:22:23.44,0:22:26.41,Default,,0,0,0,,401-ді суға батыратын менмін!
Dialogue: 0,0:22:27.51,0:22:28.84,Default,,0,0,0,,Балалар сендер емес!
Dialogue: 0,0:22:29.04,0:22:31.65,Default,,0,0,0,,Сізде де солай болды ма?
Dialogue: 0,0:22:32.71,0:22:34.01,Default,,0,0,0,,Жаңа айтқаным
Dialogue: 0,0:22:34.48,0:22:37.95,Default,,0,0,0,,Адмиралтейлік кодекстен айқын ауытқу болып табылады
Dialogue: 0,0:22:38.02,0:22:39.85,Default,,0,0,0,,Жоқ... жоқ! мен...
Dialogue: 0,0:22:39.92,0:22:41.76,Default,,0,0,0,,сізді байланыстырады
Dialogue: 0,0:22:41.86,0:22:43.02,Default,,0,0,0,,Қарсылық мағынасыз
Dialogue: 0,0:22:46.46,0:22:47.13,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:22:47.59,0:22:48.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:22:48.70,0:22:50.06,Default,,0,0,0,,Иә, Майя!
Dialogue: 0,0:22:50.73,0:22:52.60,Default,,0,0,0,,Сіз түсінесіз, солай ма?
Dialogue: 0,0:22:52.77,0:22:54.37,Default,,0,0,0,,Мен ауытқумын және т.б.
Dialogue: 0,0:22:54.43,0:22:56.77,Default,,0,0,0,,Иә! Жарайды, Конгоу.
Dialogue: 0,0:22:57.50,0:22:58.37,Default,,0,0,0,,Майя
Dialogue: 0,0:22:58.44,0:23:00.37,Default,,0,0,0,,Конгоу ештеңеге алаңдамауы керек.
Dialogue: 0,0:23:00.44,0:23:03.54,Default,,0,0,0,,Тек Адмиралти кодексін орындаңыз.
Dialogue: 0,0:23:03.84,0:23:06.01,Default,,0,0,0,,Иә, мен... (электронды дыбыс)
Dialogue: 0,0:23:06.08,0:23:08.82,Default,,0,0,0,,Иә! Жарайды, Конгоу.
Dialogue: 0,0:23:08.98,0:23:11.08,Default,,0,0,0,,Конгоу ештеңеге алаңдамауы керек.
Dialogue: 0,0:23:11.15,0:23:13.95,Default,,0,0,0,,Тек Адмиралти кодексін орындаңыз.
Dialogue: 0,0:23:14.42,0:23:15.09,Default,,0,0,0,,Майя... (электронды дыбыс)
Dialogue: 0,0:23:15.39,0:23:16.86,Default,,0,0,0,,Иә! Жарайды...
Dialogue: 0,0:23:16.92,0:23:18.83,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Майя?
Dialogue: 0,0:23:18.99,0:23:21.16,Default,,0,0,0,,Конгоу ештеңеге алаңдамай Адмиралтейлік кодекске кірді...
Dialogue: 0,0:23:21.43,0:23:22.10,Default,,0,0,0,,Майя!
Dialogue: 0,0:23:22.86,0:23:23.76,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:23:23.83,0:23:24.70,Default,,0,0,0,,Не?
Dialogue: 0,0:23:24.93,0:23:27.50,Default,,0,0,0,,Майя ауыр крейсерінің психикалық моделі
Dialogue: 0,0:23:27.57,0:23:29.70,Default,,0,0,0,,Эмоциялық бағдарлама орындалмады
Dialogue: 0,0:23:29.80,0:23:30.67,Default,,0,0,0,,Е...
Dialogue: 0,0:23:30.74,0:23:33.84,Default,,0,0,0,,Ол біз құрған бақылау бөлімі.
Dialogue: 0,0:23:34.11,0:23:37.68,Default,,0,0,0,,Өте қарапайым тәртіп бойынша жауап беру
Dialogue: 0,0:23:37.74,0:23:39.51,Default,,0,0,0,,Жай қуыршақ
Dialogue: 0,0:23:39.65,0:23:42.68,Default,,0,0,0,,Мен оны жабуға мәжбүр еттім.
Dialogue: 0,0:23:42.82,0:23:45.62,Default,,0,0,0,,Маған енді сені бақылап отырудың қажеті жоқ.
Dialogue: 0,0:23:46.02,0:23:48.62,Default,,0,0,0,,Бұл... ақымақ!
Dialogue: 0,0:23:48.92,0:23:50.89,Default,,0,0,0,,Бұл өтірік, солай ма? мая
Dialogue: 0,0:23:51.53,0:23:53.06,Default,,0,0,0,,Сен менікісің...
Dialogue: 0,0:23:54.69,0:23:55.90,Default,,0,0,0,,Менің...
Dialogue: 0,0:23:57.80,0:23:59.13,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:23:59.97,0:24:01.20,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:24:02.44,0:24:03.20,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:24:04.47,0:24:05.81,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:24:06.54,0:24:07.84,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:24:08.68,0:24:10.14,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:24:10.88,0:24:12.21,Default,,0,0,0,,Бұл карнавал!
