Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.65,0:00:19.68,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:00:19.75,0:00:21.78,Default,,0,0,0,,Менің әлі өлгім келмейді!
Dialogue: 0,0:00:22.52,0:00:25.02,Default,,0,0,0,,«Мен өлгім келмейді»
Dialogue: 0,0:00:25.59,0:00:26.65,Default,,0,0,0,,Қарғыс атқан ұрық метаморфозға ұшыраған жағдайда—
Dialogue: 0,0:00:27.29,0:00:29.56,Default,,0,0,0,,Өз іс-әрекетін тоқтатудан бас тартатын сөздер
Dialogue: 0,0:00:30.36,0:00:33.40,Default,,0,0,0,,Тегтерді жіктеу жазбасы
Dialogue: 0,0:00:33.73,0:00:35.40,Default,,0,0,0,,Сіз тағы да сөздерді жинап жатырсыз ба?
Dialogue: 0,0:00:36.40,0:00:39.50,Default,,0,0,0,,Сөз – ең жақсы, әдемі жүйе
Dialogue: 0,0:00:41.10,0:00:47.11,Default,,0,0,0,,♪～
Dialogue: 0,0:02:02.45,0:02:08.46,Default,,0,0,0,,～♪
Dialogue: 0,0:02:16.76,0:02:19.13,Default,,0,0,0,,«Әдемі»?
Dialogue: 0,0:02:19.43,0:02:20.74,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:02:21.34,0:02:22.74,Default,,0,0,0,,Ақпаратты беру құралы ретінде
Dialogue: 0,0:02:23.51,0:02:26.14,Default,,0,0,0,,Тым айналмалы және тиімсіз
Dialogue: 0,0:02:26.67,0:02:28.71,Default,,0,0,0,,Ұғымды беруді қолдану
Dialogue: 0,0:02:29.31,0:02:31.35,Default,,0,0,0,,Ақпарат алмасудың бұл деңгейі
Dialogue: 0,0:02:31.41,0:02:34.22,Default,,0,0,0,,Тіпті уақытты кідіріссіз орындауға болады
Dialogue: 0,0:02:34.28,0:02:35.15,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:02:35.22,0:02:35.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:45.36,0:02:46.39,Default,,0,0,0,,Клейнфилд
Dialogue: 0,0:02:46.53,0:02:48.16,Default,,0,0,0,,Іске қосу жылдамдығы 3%
Dialogue: 0,0:02:48.86,0:02:50.20,Default,,0,0,0,,Неліктен адамдар?
Dialogue: 0,0:02:50.27,0:02:52.27,Default,,0,0,0,,Қызық, олар мұндай ысырапшылдыққа барар ма еді?
Dialogue: 0,0:02:52.67,0:02:53.77,Default,,0,0,0,,Мен үндемеуім керек пе?
Dialogue: 0,0:03:13.42,0:03:15.29,Default,,0,0,0,,Шыу!
Dialogue: 0,0:03:16.22,0:03:17.69,Default,,0,0,0,,Хмф! Қыңыр
Dialogue: 0,0:03:21.86,0:03:24.43,Default,,0,0,0,,Жау кемесі мылтықтарын саған бағыттап тұр!
Dialogue: 0,0:03:24.63,0:03:27.44,Default,,0,0,0,,Хм, шыдамды болыңыз!
Dialogue: 0,0:03:27.94,0:03:29.70,Default,,0,0,0,,«Сабырлы бол»
Dialogue: 0,0:03:30.37,0:03:33.58,Default,,0,0,0,,Күресуге ерік-жігерін жоғалтқан адамның еріксіз айтқан сөздері
Dialogue: 0,0:03:33.91,0:03:35.34,Default,,0,0,0,,Берілетін сөздер
Dialogue: 0,0:03:35.68,0:03:38.65,Default,,0,0,0,,Тіркеулерді жіктеу жазбасы
Dialogue: 0,0:03:39.38,0:03:40.32,Default,,0,0,0,,Бітті!
Dialogue: 0,0:03:43.59,0:03:44.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:44.92,0:03:46.22,Default,,0,0,0,,Эрозиялық торпедалар?
Dialogue: 0,0:03:46.65,0:03:48.92,Default,,0,0,0,,Эрозия реакциясын есептеу орындалуда
Dialogue: 0,0:03:49.86,0:03:52.43,Default,,0,0,0,,Кляйн өрісін басқаруды бастау
Dialogue: 0,0:03:56.86,0:03:57.73,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:03:58.70,0:04:00.34,Default,,0,0,0,,Торпеданың эрозиясының қонуы!
Dialogue: 0,0:04:00.40,0:04:02.77,Default,,0,0,0,,Жаудың Клейнфилд кемесі орналастырылғанын растаңыз!
Dialogue: 0,0:04:03.34,0:04:04.51,Default,,0,0,0,,Психикалық модель?
Dialogue: 0,0:04:04.77,0:04:06.91,Default,,0,0,0,,Иә Киришима мен Харуна
Dialogue: 0,0:04:07.41,0:04:09.01,Default,,0,0,0,,Ұлы әскери кеме класы?
Dialogue: 0,0:04:09.41,0:04:10.45,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:04:10.55,0:04:14.35,Default,,0,0,0,,Үйге оралмағаныма көп болды, сондықтан мен демалсам деп ойладым.
Dialogue: 0,0:04:14.58,0:04:17.35,Default,,0,0,0,,Иона Жаудың назарын өзіңізге аударыңыз.
Dialogue: 0,0:04:17.72,0:04:19.49,Default,,0,0,0,,Оларды негізден тартыңыз
Dialogue: 0,0:04:19.82,0:04:20.69,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:20.92,0:04:22.36,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:04:22.69,0:04:25.66,Default,,0,0,0,,Оларды әзірше қабырғаның сыртына шығарамыз ба?
Dialogue: 0,0:04:25.83,0:04:26.69,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:26.89,0:04:28.66,Default,,0,0,0,,Енді жердің артықшылығы осында.
Dialogue: 0,0:04:28.93,0:04:31.43,Default,,0,0,0,,Мен олардың біреуін ғана осында батырамын!
Dialogue: 0,0:04:31.50,0:04:32.37,Default,,0,0,0,,О!
Dialogue: 0,0:04:32.83,0:04:36.44,Default,,0,0,0,,Ұлы әскери кеме сыныбы шығаратын Кляйн өрісін қанықтырады.
Dialogue: 0,0:04:36.54,0:04:38.61,Default,,0,0,0,,Негізгі корпусты зақымдау
Dialogue: 0,0:04:38.87,0:04:41.78,Default,,0,0,0,,Ауыр гравитациялық зеңбірекпен тікелей соққы жасау керек.
Dialogue: 0,0:04:42.01,0:04:43.85,Default,,0,0,0,,Бұл аса ауырлық зеңбірегі
Dialogue: 0,0:04:43.98,0:04:46.71,Default,,0,0,0,,Өткен күні Такаомен шайқаста зақымданған
Dialogue: 0,0:04:46.85,0:04:47.78,Default,,0,0,0,,Қолжетімсіз
Dialogue: 0,0:04:48.68,0:04:51.05,Default,,0,0,0,,Сондай-ақ, мен «Хюга» атты ұлы кемені суға батырған кезде
Dialogue: 0,0:04:51.39,0:04:53.72,Default,,0,0,0,,15 эрозия торпедасы тұтынылды
Dialogue: 0,0:04:54.32,0:04:55.89,Default,,0,0,0,,Қазіргі уақытта менде бар эрозия торпедалары
Dialogue: 0,0:04:55.96,0:04:56.96,Default,,0,0,0,,6 қалды
Dialogue: 0,0:04:57.06,0:04:59.29,Default,,0,0,0,,Жоқ, осы екі кітаптан басқа.
Dialogue: 0,0:04:59.43,0:05:00.66,Default,,0,0,0,,Бар болғаны 4 дана.
Dialogue: 0,0:05:00.93,0:05:03.80,Default,,0,0,0,,Ей, сен жан-жақтан бөгелдің!
Dialogue: 0,0:05:04.33,0:05:05.00,Default,,0,0,0,,Тыныштық!
Dialogue: 0,0:05:05.50,0:05:06.83,Default,,0,0,0,,Йокосука қорғаныс қабырғасының ішінде
Dialogue: 0,0:05:06.93,0:05:09.04,Default,,0,0,0,,Соңғы тренд ақпаратын беріңіз.
Dialogue: 0,0:05:09.30,0:05:10.64,Default,,0,0,0,,Иә! а!
Dialogue: 0,0:05:11.47,0:05:13.71,Default,,0,0,0,,Киришима Харунаның кезегі басталады!
Dialogue: 0,0:05:13.94,0:05:15.88,Default,,0,0,0,,Киришима бағыты 212
Dialogue: 0,0:05:15.94,0:05:17.65,Default,,0,0,0,,Харуна 215!
Dialogue: 0,0:05:18.31,0:05:20.32,Default,,0,0,0,,Иона тереңдігі Оны маған қалдырыңыз
Dialogue: 0,0:05:20.48,0:05:21.52,Default,,0,0,0,,Мұхит түбінде ұшу
Dialogue: 0,0:05:21.88,0:05:22.75,Default,,0,0,0,,Тексеру
Dialogue: 0,0:05:31.09,0:05:33.03,Default,,0,0,0,,Сіз суға түстіңіз бе? Жүгіріп кету?
Dialogue: 0,0:05:33.76,0:05:34.63,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:34.70,0:05:36.43,Default,,0,0,0,,Оның теңізге шығуға ниеті жоқ сияқты.
Dialogue: 0,0:05:36.96,0:05:40.37,Default,,0,0,0,,Өйткені, 401-мен күресудің ескі әдісі қандай?
Dialogue: 0,0:05:40.44,0:05:41.74,Default,,0,0,0,,Бұл мүлдем басқа.
Dialogue: 0,0:05:41.97,0:05:44.37,Default,,0,0,0,,Киришима, маған біраз уақыт беріңіз.
Dialogue: 0,0:05:44.64,0:05:45.54,Default,,0,0,0,,Харуна?
Dialogue: 0,0:05:45.61,0:05:47.04,Default,,0,0,0,,Мен онымен сөйлескім келеді
Dialogue: 0,0:05:47.71,0:05:48.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:49.54,0:05:50.41,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:50.81,0:05:51.71,Default,,0,0,0,,Сізді кім жалдады және қандай шарттармен?
Dialogue: 0,0:05:54.78,0:05:56.82,Default,,0,0,0,,Көптен бері 401-ді көрмеген
Dialogue: 0,0:05:57.45,0:05:59.49,Default,,0,0,0,,Киришима Харуна
Dialogue: 0,0:05:59.89,0:06:02.09,Default,,0,0,0,,Мен сені бірінші рет көріп тұрмын.
Dialogue: 0,0:06:02.56,0:06:03.99,Default,,0,0,0,,Маған бірдеңе керек пе?
Dialogue: 0,0:06:04.79,0:06:06.69,Default,,0,0,0,,Оның алдында отыруға қалай болады?
Dialogue: 0,0:06:07.13,0:06:08.90,Default,,0,0,0,,Адамдар сөйлескенде
Dialogue: 0,0:06:08.96,0:06:10.70,Default,,0,0,0,,Мен сенің осылай істейтініңді естідім?
Dialogue: 0,0:06:12.07,0:06:12.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:13.00,0:06:15.70,Default,,0,0,0,,Біз флоттың флагманы Конгоуданбыз.
Dialogue: 0,0:06:15.97,0:06:18.51,Default,,0,0,0,,Менде сені суға батыру туралы бұйрық бар.
Dialogue: 0,0:06:19.01,0:06:19.91,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:06:20.11,0:06:21.44,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:06:21.91,0:06:24.05,Default,,0,0,0,,Харуна сенімен сөйлескісі келеді.
Dialogue: 0,0:06:24.48,0:06:25.41,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:06:25.85,0:06:28.95,Default,,0,0,0,,401 Неліктен адам жағына шығу керек?
Dialogue: 0,0:06:29.45,0:06:30.92,Default,,0,0,0,,Мұны істеуге не мәжбүр етеді?
Dialogue: 0,0:06:31.39,0:06:33.15,Default,,0,0,0,,Такао да сенімен шайқастан кейін.
Dialogue: 0,0:06:33.49,0:06:35.52,Default,,0,0,0,,Қызметін тастап, қашып кетті
Dialogue: 0,0:06:35.92,0:06:37.73,Default,,0,0,0,,Адам экипажын іздеу
Dialogue: 0,0:06:38.63,0:06:39.49,Default,,0,0,0,,Такао
Dialogue: 0,0:06:39.59,0:06:41.03,Default,,0,0,0,,Енді менде бұл дене бар
Dialogue: 0,0:06:41.50,0:06:44.63,Default,,0,0,0,,Бізде адамдардан алатын ештеңе жоқ.
Dialogue: 0,0:06:44.90,0:06:47.00,Default,,0,0,0,,Бұл Конгоның қорытындысы.
Dialogue: 0,0:06:47.60,0:06:48.57,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:06:48.87,0:06:51.84,Default,,0,0,0,,Сіз әлі де адамдарға тағы бір нәрсе бар деп ойлайсыз ба?
Dialogue: 0,0:06:52.04,0:06:52.97,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:06:53.71,0:06:55.58,Default,,0,0,0,,Мен білмеймін... бірақ
Dialogue: 0,0:06:56.54,0:06:59.05,Default,,0,0,0,,Маған қазір капитан керек.
Dialogue: 0,0:06:59.68,0:07:02.85,Default,,0,0,0,,Өйткені мен Гунзо Чихаяның кемесімін.
Dialogue: 0,0:07:03.48,0:07:04.42,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:05.69,0:07:06.55,Default,,0,0,0,,Иона
Dialogue: 0,0:07:06.92,0:07:07.89,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:08.76,0:07:09.62,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:09.69,0:07:11.59,Default,,0,0,0,,Мен енді стратегияның контурын түсіндіремін.
Dialogue: 0,0:07:12.83,0:07:14.63,Default,,0,0,0,,Бұл біздің қазіргі ұстанымымыз.
Dialogue: 0,0:07:14.73,0:07:16.16,Default,,0,0,0,,Киришима Харунаның орналасқан жері
Dialogue: 0,0:07:16.70,0:07:17.57,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:07:17.73,0:07:19.90,Default,,0,0,0,,Осы жерден стратегияңызды жасаңыз
Dialogue: 0,0:07:19.97,0:07:22.04,Default,,0,0,0,,Осы жерден 2-кезең.
Dialogue: 0,0:07:22.77,0:07:23.91,Default,,0,0,0,,Осымен
Dialogue: 0,0:07:24.47,0:07:25.94,Default,,0,0,0,,Iori Ең үлкен қозғалтқыш!
Dialogue: 0,0:07:26.11,0:07:27.04,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:07:34.55,0:07:35.58,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:07:36.05,0:07:40.02,Default,,0,0,0,,Теңіз деңгейінің көтерілуіне байланысты бұрынғы Йокосука қаласы су астында қалды
Dialogue: 0,0:07:40.59,0:07:41.96,Default,,0,0,0,,Мен бұл туралы ойладым, капитан.
Dialogue: 0,0:07:42.66,0:07:44.83,Default,,0,0,0,,Мұнда дыбыс толқындары диффузиялық түрде шағылады.
Dialogue: 0,0:07:45.09,0:07:48.53,Default,,0,0,0,,Менің ойымша, жауға біздің орналасқан жерді дәл анықтау қиын болады.
Dialogue: 0,0:07:48.66,0:07:50.77,Default,,0,0,0,,Жарайсың, Иори! Қозғалтқыш тоқтады!
Dialogue: 0,0:07:51.03,0:07:53.10,Default,,0,0,0,,Не? Иә... Түсінікті
Dialogue: 0,0:07:57.64,0:07:59.61,Default,,0,0,0,,Бұл Йокосука қорғаныс қабырғасы
Dialogue: 0,0:07:59.81,0:08:03.08,Default,,0,0,0,,Сумен жабдықтау және суды кетіру розеткалары белгілі бір уақыт аралығында орнатылады.
Dialogue: 0,0:08:03.81,0:08:05.51,Default,,0,0,0,,Теңіз суы кіріп-шығады
Dialogue: 0,0:08:05.71,0:08:08.18,Default,,0,0,0,,Ғимараттар тобынан өту арқылы
Dialogue: 0,0:08:08.78,0:08:11.85,Default,,0,0,0,,Бұл салада күрделі тенденциялар қалыптасқан.
Dialogue: 0,0:08:11.99,0:08:12.99,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:13.22,0:08:15.59,Default,,0,0,0,,Осы толқынмен бірге жүрсек...
Dialogue: 0,0:08:15.96,0:08:18.16,Default,,0,0,0,,Менің орным анықталмады
Dialogue: 0,0:08:18.63,0:08:20.16,Default,,0,0,0,,Жаудың артына өте алады
Dialogue: 0,0:08:21.20,0:08:22.16,Default,,0,0,0,,Кёхэй! (Кёхэ) А?
Dialogue: 0,0:08:22.23,0:08:23.83,Default,,0,0,0,,Канистрлерді жайыңыз.
Dialogue: 0,0:08:23.90,0:08:24.77,Default,,0,0,0,,Мен қарсыласымды өлтіру үшін келген жоқпын
Dialogue: 0,0:08:37.68,0:08:40.72,Default,,0,0,0,,Жау кемесі Теңіз астындағы ғимараттар жоғары қарай жылжиды
Dialogue: 0,0:08:41.25,0:08:42.12,Default,,0,0,0,,Иона
Dialogue: 0,0:08:42.18,0:08:43.05,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:51.76,0:08:52.63,Default,,0,0,0,,Хмф!
Dialogue: 0,0:09:02.04,0:09:04.01,Default,,0,0,0,,Іске қосу нүктелері шашыраңқы
Dialogue: 0,0:09:04.21,0:09:06.61,Default,,0,0,0,,401 оны атпаған.
Dialogue: 0,0:09:07.14,0:09:10.21,Default,,0,0,0,,Жартылай автономды торпедо ұшыру қондырғысы.
Dialogue: 0,0:09:10.95,0:09:12.75,Default,,0,0,0,,дейсіз бе?
Dialogue: 0,0:09:26.33,0:09:27.19,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:09:27.66,0:09:30.03,Default,,0,0,0,,Әй, енді нағыз оқиға басталды!
Dialogue: 0,0:09:32.20,0:09:34.84,Default,,0,0,0,,Барлық торпедолар жойылды.
Dialogue: 0,0:09:35.20,0:09:37.24,Default,,0,0,0,,Адамды алып жүрудің нәтижесінде не аласыз
Dialogue: 0,0:09:37.31,0:09:38.61,Default,,0,0,0,,Бұл ойыншық па?
Dialogue: 0,0:09:38.87,0:09:40.64,Default,,0,0,0,,Түсіну мүлде қиын
Dialogue: 0,0:09:40.78,0:09:42.08,Default,,0,0,0,,Бірақ ол жұмыс істеді.
Dialogue: 0,0:09:42.81,0:09:44.01,Default,,0,0,0,,Шындығында біз
Dialogue: 0,0:09:44.11,0:09:46.88,Default,,0,0,0,,401 ағымдағы орнын жоғалтты
Dialogue: 0,0:09:46.95,0:09:47.82,Default,,0,0,0,,Хмф!
Dialogue: 0,0:09:48.75,0:09:51.62,Default,,0,0,0,,401 борттағы адамдармен мінез-құлық үлгілері
Dialogue: 0,0:09:51.72,0:09:53.25,Default,,0,0,0,,Біз үшін болжау мүмкін емес
Dialogue: 0,0:09:53.85,0:09:55.06,Default,,0,0,0,,Хюуга да, Такао да
Dialogue: 0,0:09:55.19,0:09:57.16,Default,,0,0,0,,Оған шыдай алмай, сынып қалды
Dialogue: 0,0:09:57.66,0:09:58.83,Default,,0,0,0,,Біз олармен біргеміз
Dialogue: 0,0:09:58.89,0:10:01.13,Default,,0,0,0,,Біз де сол жолмен жүреміз дейсіз бе?
Dialogue: 0,0:10:01.73,0:10:02.93,Default,,0,0,0,,Мен олай айтпаймын.
Dialogue: 0,0:10:03.13,0:10:05.67,Default,,0,0,0,,Бірақ егер бұл орын алса
Dialogue: 0,0:10:05.87,0:10:08.74,Default,,0,0,0,,Біз өкініп қалуымыз мүмкін.
Dialogue: 0,0:10:09.17,0:10:10.14,Default,,0,0,0,,Өкінішті?
Dialogue: 0,0:10:10.20,0:10:12.77,Default,,0,0,0,,Сіздің таңдауыңыз қате болды
Dialogue: 0,0:10:12.97,0:10:15.68,Default,,0,0,0,,Бұл кейін өкінетін нәрсе сияқты.
Dialogue: 0,0:10:15.81,0:10:16.98,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:10:17.08,0:10:20.38,Default,,0,0,0,,Таңдалған және шешілген оқиғалар
Dialogue: 0,0:10:20.88,0:10:23.08,Default,,0,0,0,,Оны кейін теріске шығарудың мәні неде?
Dialogue: 0,0:10:23.75,0:10:24.75,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:10:25.05,0:10:28.22,Default,,0,0,0,,Бірақ адамдар мұны жиі жасайтын сияқты.
Dialogue: 0,0:10:28.79,0:10:29.79,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:10:30.89,0:10:32.36,Default,,0,0,0,,Біз қарумыз
Dialogue: 0,0:10:32.86,0:10:33.86,Default,,0,0,0,,Тек алдымдағы жау
Dialogue: 0,0:10:33.93,0:10:36.63,Default,,0,0,0,,Тек оны суға батыру туралы ойлану керек
Dialogue: 0,0:10:37.10,0:10:38.90,Default,,0,0,0,,Бірақ... Ах!
Dialogue: 0,0:10:39.20,0:10:41.10,Default,,0,0,0,,Танатоний реакциясы Фронт!
Dialogue: 0,0:10:47.21,0:10:48.81,Default,,0,0,0,,Алда кеменің көлеңкесі бар
Dialogue: 0,0:10:49.08,0:10:51.31,Default,,0,0,0,,Бұл өлшем алдау емес
Dialogue: 0,0:10:51.71,0:10:53.88,Default,,0,0,0,,401... Хмф!
Dialogue: 0,0:10:54.38,0:10:57.12,Default,,0,0,0,,Олар жүгіру мен тығылудан бас тартқан сияқты.
Dialogue: 0,0:11:05.96,0:11:06.83,Default,,0,0,0,,Раковина!
Dialogue: 0,0:11:08.16,0:11:09.26,Default,,0,0,0,,Ах! Киришима!
Dialogue: 0,0:11:09.70,0:11:10.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:18.74,0:11:20.27,Default,,0,0,0,,Артынан?
Dialogue: 0,0:11:20.78,0:11:22.84,Default,,0,0,0,,401 алға... га!
Dialogue: 0,0:11:23.84,0:11:25.15,Default,,0,0,0,,Сонымен, ерекше бірдеңе болды ма?
Dialogue: 0,0:11:25.88,0:11:27.21,Default,,0,0,0,,Микаса жауынгерлік кемесі\NЖапон императорлық флотының
Dialogue: 0,0:11:27.35,0:11:29.25,Default,,0,0,0,,1902 жылы іске қосылды
Dialogue: 0,0:11:29.68,0:11:31.09,Default,,0,0,0,,...
Dialogue: 0,0:11:31.15,0:11:34.09,Default,,0,0,0,,66 флот жоспары бойынша салынған жауынгерлік кемелер
Dialogue: 0,0:11:34.76,0:11:36.79,Default,,0,0,0,,Бұрынғы Йокосука қаласымен бірге су астында қалды
Dialogue: 0,0:11:37.19,0:11:41.20,Default,,0,0,0,,Белсендірілген наноматериалдарды бетіне шашу арқылы
Dialogue: 0,0:11:41.70,0:11:43.20,Default,,0,0,0,,бізді алдады
Dialogue: 0,0:11:47.00,0:11:48.30,Default,,0,0,0,,Тәтті~ Әйтеуір!
Dialogue: 0,0:11:49.34,0:11:51.94,Default,,0,0,0,,Мен бұл жақсы идея деп ойладым~
Dialogue: 0,0:11:52.17,0:11:53.27,Default,,0,0,0,,Енді не керек
Dialogue: 0,0:11:53.34,0:11:56.21,Default,,0,0,0,,Біздің шынайы орналасқан жеріміз де анықталды.
Dialogue: 0,0:11:57.41,0:11:58.81,Default,,0,0,0,,Iori Ең үлкен қозғалтқыш!
Dialogue: 0,0:11:58.88,0:11:59.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:59.81,0:12:00.71,Default,,0,0,0,,Толық жылдамдық алға!
Dialogue: 0,0:12:00.85,0:12:02.08,Default,,0,0,0,,Толық жылдамдық алға
Dialogue: 0,0:12:02.32,0:12:03.75,Default,,0,0,0,,Не? Алға?
Dialogue: 0,0:12:03.82,0:12:04.92,Default,,0,0,0,,Сіз жауға асығасыз ба?
Dialogue: 0,0:12:06.82,0:12:10.06,Default,,0,0,0,,Бізді екеуміз ойнап жатырмыз, Харуна.
Dialogue: 0,0:12:12.26,0:12:14.03,Default,,0,0,0,,Жақсы~ 401
Dialogue: 0,0:12:14.73,0:12:16.40,Default,,0,0,0,,Өте қызық
Dialogue: 0,0:12:16.96,0:12:18.07,Default,,0,0,0,,Бірінші рет!
Dialogue: 0,0:12:18.33,0:12:21.17,Default,,0,0,0,,Иә, біз қарумыз.
Dialogue: 0,0:12:21.40,0:12:25.07,Default,,0,0,0,,Жаумен шайқасып, оны жеңу – біздің өмір сүруіміздің бірден-бір себебі.
Dialogue: 0,0:12:25.47,0:12:26.41,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:27.04,0:12:29.31,Default,,0,0,0,,Мен оны қолыммен батырғым келеді!
Dialogue: 0,0:12:30.01,0:12:30.88,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:12:31.75,0:12:33.88,Default,,0,0,0,,Киришиманың эмоция эмуляторының мәндері
Dialogue: 0,0:12:33.95,0:12:35.45,Default,,0,0,0,,кенет ауытқулар
Dialogue: 0,0:12:35.52,0:12:36.38,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:37.52,0:12:38.99,Default,,0,0,0,,Мен бәріңді атып тастаймын!
Dialogue: 0,0:12:42.02,0:12:43.46,Default,,0,0,0,,Көптеген торпедо ату дыбыстары!
Dialogue: 0,0:12:43.52,0:12:44.79,Default,,0,0,0,,Үш рет қатарынан түсіру расталды!
Dialogue: 0,0:12:44.86,0:12:46.03,Default,,0,0,0,,60 немесе одан да көп саны!
Dialogue: 0,0:12:46.19,0:12:48.03,Default,,0,0,0,,Содан кейін судың теңіз бетіне қонған дыбысы
Dialogue: 0,0:12:48.10,0:12:49.36,Default,,0,0,0,,120 немесе одан да көп сезім
Dialogue: 0,0:12:49.43,0:12:50.30,Default,,0,0,0,,Әлі де жалғасуда!
Dialogue: 0,0:12:57.44,0:13:00.11,Default,,0,0,0,,Үлкен кеме сияқты әрекет етпеңіз!
Dialogue: 0,0:13:00.41,0:13:01.84,Default,,0,0,0,,Ішке асығыс
Dialogue: 0,0:13:02.18,0:13:04.51,Default,,0,0,0,,Сіз адасып қалдыңыз ба? 401
Dialogue: 0,0:13:05.25,0:13:06.31,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:13:10.08,0:13:11.25,Default,,0,0,0,,өттіңіз бе?
Dialogue: 0,0:13:12.12,0:13:14.56,Default,,0,0,0,,Неліктен бізден бас тартуға барар едіңіз?
Dialogue: 0,0:13:14.89,0:13:16.49,Default,,0,0,0,,Оны шынымен жалаған жігіттер.
Dialogue: 0,0:13:16.56,0:13:18.49,Default,,0,0,0,,Мен сенің не істеріңді білмеймін...
Dialogue: 0,0:13:18.89,0:13:19.89,Default,,0,0,0,,Бұған жол берме!
Dialogue: 0,0:13:25.87,0:13:26.53,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:27.17,0:13:28.90,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:13:29.30,0:13:31.94,Default,,0,0,0,,Kleinfield 95% толтыру деңгейі
Dialogue: 0,0:13:32.34,0:13:34.91,Default,,0,0,0,,5% артық қуат жарайды
Dialogue: 0,0:13:35.01,0:13:36.21,Default,,0,0,0,,Жақын жерде!
Dialogue: 0,0:13:36.28,0:13:37.14,Default,,0,0,0,,(Рам) Балс. (Субару) Ах…
Dialogue: 0,0:13:38.08,0:13:38.95,Default,,0,0,0,,Кеме жөнделді!
Dialogue: 0,0:13:43.38,0:13:45.05,Default,,0,0,0,,Барлығы шокқа дайындал!
Dialogue: 0,0:14:03.07,0:14:06.27,Default,,0,0,0,,Қозғалтқыш шуы Жылу көзінің реакциясы расталмады
Dialogue: 0,0:14:09.11,0:14:10.61,Default,,0,0,0,,401 реакция…
Dialogue: 0,0:14:11.28,0:14:12.15,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:14:20.22,0:14:22.42,Default,,0,0,0,,А... жақсысың ба?
Dialogue: 0,0:14:23.12,0:14:24.02,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:24.86,0:14:27.33,Default,,0,0,0,,Мен өлемін деп ойладым.
Dialogue: 0,0:14:27.43,0:14:28.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:28.40,0:14:30.63,Default,,0,0,0,,Тіршілікті қамтамасыз ету жүйесі Аномалия жоқ
Dialogue: 0,0:14:31.20,0:14:33.07,Default,,0,0,0,,Қозғалтқыш әлі де тірі.
Dialogue: 0,0:14:33.47,0:14:35.07,Default,,0,0,0,,Якорь әлі тірі
Dialogue: 0,0:14:35.94,0:14:37.44,Default,,0,0,0,,Бұдан былай 3-кезең (үш)
Dialogue: 0,0:14:37.50,0:14:39.04,Default,,0,0,0,,Бұлай ойлау дұрыс па?
Dialogue: 0,0:14:39.14,0:14:40.01,Default,,0,0,0,,О
Dialogue: 0,0:14:40.14,0:14:42.94,Default,,0,0,0,,Бірақ, сіз шынымен жеңе аласыз ба?
Dialogue: 0,0:14:43.08,0:14:45.01,Default,,0,0,0,,Қалған эрозия торпедалары...
Dialogue: 0,0:14:45.61,0:14:46.61,Default,,0,0,0,,Екі ату...
Dialogue: 0,0:14:47.38,0:14:48.25,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:14:48.88,0:14:49.55,Default,,0,0,0,,Не? (Әлі) А...
Dialogue: 0,0:14:51.25,0:14:52.12,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:56.12,0:14:56.99,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:14:57.32,0:14:59.39,Default,,0,0,0,,Ол мұндай деңгейде батпайды.
Dialogue: 0,0:14:59.99,0:15:01.63,Default,,0,0,0,,Оны үйіндіге көму керек.
Dialogue: 0,0:15:02.46,0:15:03.66,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:15:03.93,0:15:06.63,Default,,0,0,0,,Осылай аяқталса, мен үшін қызық болмас еді.
Dialogue: 0,0:15:07.40,0:15:09.54,Default,,0,0,0,,«Қызық емес»?
Dialogue: 0,0:15:10.60,0:15:13.07,Default,,0,0,0,,Мен сізге 401 айтамын
Dialogue: 0,0:15:13.27,0:15:15.48,Default,,0,0,0,,Сіз бен біз адам алып бара жатырмыз
Dialogue: 0,0:15:15.58,0:15:17.04,Default,,0,0,0,,Қайсысы күшті!
Dialogue: 0,0:15:17.54,0:15:18.45,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:18.65,0:15:20.31,Default,,0,0,0,,Киришимамен танысайық
Dialogue: 0,0:15:25.32,0:15:26.19,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:15:26.62,0:15:28.06,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:15:28.42,0:15:30.26,Default,,0,0,0,,Ірі масштабты гравитациялық жер сілкінісі анықталды!
Dialogue: 0,0:15:30.59,0:15:31.66,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:15:32.26,0:15:33.19,Default,,0,0,0,,Теңіз...
Dialogue: 0,0:15:33.69,0:15:34.56,Default,,0,0,0,,жарықшақ
Dialogue: 0,0:15:51.58,0:15:53.51,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:16:05.43,0:16:06.39,Default,,0,0,0,,Уау! (Статикалық) Ах!
Dialogue: 0,0:16:06.49,0:16:08.23,Default,,0,0,0,,Эй... не? Иә
Dialogue: 0,0:16:22.71,0:16:25.45,Default,,0,0,0,,Гах, олар біріктіріліп жатыр!
Dialogue: 0,0:16:28.55,0:16:30.48,Default,,0,0,0,,Тіпті осындай нәрсені жасауға болады ма?
Dialogue: 0,0:16:30.55,0:16:31.45,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:16:31.52,0:16:33.05,Default,,0,0,0,,Бұны тыңдама!
Dialogue: 0,0:16:34.22,0:16:35.09,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:35.36,0:16:36.99,Default,,0,0,0,,Біз бақыттымыз
Dialogue: 0,0:16:37.19,0:16:38.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:38.36,0:16:40.59,Default,,0,0,0,,Әр кемемен бір-бірден жұмыс істеу қиындығынан құтылды.
Dialogue: 0,0:16:41.03,0:16:43.53,Default,,0,0,0,,Бұл адам екеуін де істегісі келеді!
Dialogue: 0,0:16:43.76,0:16:45.10,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:16:45.47,0:16:48.10,Default,,0,0,0,,Energy Life Ring Synchronization бастау
Dialogue: 0,0:16:49.17,0:16:51.41,Default,,0,0,0,,Азғындау аймағына гравитонның қысылуы
Dialogue: 0,0:16:52.04,0:16:53.41,Default,,0,0,0,,Iori Ең үлкен қозғалтқыш!
Dialogue: 0,0:16:53.54,0:16:55.31,Default,,0,0,0,,Иә! Ух~
Dialogue: 0,0:16:57.78,0:16:58.75,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:16:59.21,0:17:01.22,Default,,0,0,0,,Жеңіңіз! 401!
Dialogue: 0,0:17:01.75,0:17:03.55,Default,,0,0,0,,Тау сәулесінің шығуы артты!
Dialogue: 0,0:17:03.62,0:17:06.12,Default,,0,0,0,,Бұл екі кемеге тұрарлық! Ол қатты!
Dialogue: 0,0:17:06.62,0:17:08.06,Default,,0,0,0,,Бұл да көтерілді!
Dialogue: 0,0:17:14.43,0:17:16.76,Default,,0,0,0,,Бұл жақсы күрес 401!
Dialogue: 0,0:17:17.46,0:17:20.17,Default,,0,0,0,,Дегенерация 10% сынилыққа дейін қалды
Dialogue: 0,0:17:25.21,0:17:26.51,Default,,0,0,0,,Клейнфилдте тесік бар!
Dialogue: 0,0:17:26.64,0:17:27.51,Default,,0,0,0,,Бұл қажет болды!
Dialogue: 0,0:17:29.34,0:17:30.51,Default,,0,0,0,,Күрес!
Dialogue: 0,0:17:31.21,0:17:33.38,Default,,0,0,0,,Аса ауырлық зеңбірегімен ату кезінде
Dialogue: 0,0:17:33.65,0:17:37.22,Default,,0,0,0,,Кляйн өрісін атыс бағытында босату керек.
Dialogue: 0,0:17:37.58,0:17:39.49,Default,,0,0,0,,Және орасан зор энергия
Dialogue: 0,0:17:39.55,0:17:42.06,Default,,0,0,0,,Кеңістіктік ауысуды басқару үшін
Dialogue: 0,0:17:42.22,0:17:45.63,Default,,0,0,0,,Психикалық модельдердің есептеу күші өзінің шегіне жетеді
Dialogue: 0,0:17:46.16,0:17:49.30,Default,,0,0,0,,Сондықтан басқа арифметикалық өңдеулер ескерілмейді.
Dialogue: 0,0:17:49.80,0:17:51.13,Default,,0,0,0,,Бұл мақсат
Dialogue: 0,0:17:54.20,0:17:55.24,Default,,0,0,0,,Танатоний!
Dialogue: 0,0:17:56.40,0:17:57.54,Default,,0,0,0,,Мен саған олай тиіспеймін!
Dialogue: 0,0:18:02.81,0:18:04.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:04.34,0:18:05.35,Default,,0,0,0,,алды
Dialogue: 0,0:18:06.61,0:18:08.32,Default,,0,0,0,,Дегенерациялық сынилік!
Dialogue: 0,0:18:14.59,0:18:17.42,Default,,0,0,0,,Енді 401-ден асты!
Dialogue: 0,0:18:22.86,0:18:23.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:23.80,0:18:24.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:25.20,0:18:26.60,Default,,0,0,0,,Нағыз козир
Dialogue: 0,0:18:26.83,0:18:29.37,Default,,0,0,0,,Соңғы минутқа дейін сақтаңыз!
Dialogue: 0,0:18:33.34,0:18:36.14,Default,,0,0,0,,Ауыр гравитациялық зеңбіректердің ату реті Төтенше тоқтату!
Dialogue: 0,0:18:36.28,0:18:37.51,Default,,0,0,0,,Клейнфилд кеңеюі!
Dialogue: 0,0:18:37.74,0:18:38.61,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:18:38.68,0:18:39.81,Default,,0,0,0,,Ол қайдан пайда болды?
Dialogue: 0,0:18:40.15,0:18:40.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:41.88,0:18:43.32,Default,,0,0,0,,Микасаның көлеңкесінде...
Dialogue: 0,0:18:44.18,0:18:45.19,Default,,0,0,0,,Тағы бір!
Dialogue: 0,0:18:48.82,0:18:50.62,Default,,0,0,0,,401～！
Dialogue: 0,0:18:50.69,0:18:51.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:54.86,0:18:56.46,Default,,0,0,0,,Дегенерацияланған энергия
Dialogue: 0,0:18:56.53,0:18:58.37,Default,,0,0,0,,Басқару... мүмкін емес
Dialogue: 0,0:18:59.23,0:19:00.63,Default,,0,0,0,,Қат! Өрісті кеңейту!
Dialogue: 0,0:19:00.70,0:19:01.57,Default,,0,0,0,,Операция...
Dialogue: 0,0:19:02.20,0:19:03.34,Default,,0,0,0,,Уақытында емес!
Dialogue: 0,0:19:05.17,0:19:07.14,Default,,0,0,0,,Атыс ретін тоқтату…
Dialogue: 0,0:19:07.47,0:19:08.44,Default,,0,0,0,,Қабілетсіздік
Dialogue: 0,0:19:08.84,0:19:10.68,Default,,0,0,0,,Ол бұзылады...
Dialogue: 0,0:19:11.41,0:19:12.68,Default,,0,0,0,,Ана жақтағы бала өте шебер екен, бізге үйретсін бе?
Dialogue: 0,0:19:13.31,0:19:14.82,Default,,0,0,0,,Тау сәулесінің шығуы азайтылды!
Dialogue: 0,0:19:15.22,0:19:16.32,Default,,0,0,0,,Клейнфилд жоғалып кетті!
Dialogue: 0,0:19:16.78,0:19:18.69,Default,,0,0,0,,Енді тіпті қалыпты оқтұмсықтар
Dialogue: 0,0:19:18.75,0:19:20.72,Default,,0,0,0,,Жеткілікті зиян келтіруге болады!
Dialogue: 0,0:19:20.85,0:19:21.72,Default,,0,0,0,,Толық өрт!
Dialogue: 0,0:19:28.40,0:19:30.73,Default,,0,0,0,,Уф уф...
Dialogue: 0,0:19:31.63,0:19:34.37,Default,,0,0,0,,Біз жеңілеміз бе...?
Dialogue: 0,0:19:35.60,0:19:37.47,Default,,0,0,0,,Барлығы өз орындарына!! Соғысқа дайындалыңыздар!!
Dialogue: 0,0:19:38.37,0:19:40.37,Default,,0,0,0,,Біз жоғалтуымыз керек...
Dialogue: 0,0:19:41.34,0:19:43.68,Default,,0,0,0,,Барлық сипаттамаларда біз
Dialogue: 0,0:19:44.18,0:19:46.48,Default,,0,0,0,,401 басым болды
Dialogue: 0,0:19:47.51,0:19:48.52,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:19:49.28,0:19:51.95,Default,,0,0,0,,Не...? Не? Бұл сезім
Dialogue: 0,0:19:52.29,0:19:53.42,Default,,0,0,0,,Харуна!
Dialogue: 0,0:20:02.40,0:20:03.40,Default,,0,0,0,,Харуна…
Dialogue: 0,0:20:04.67,0:20:05.53,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:20:06.47,0:20:07.50,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:08.34,0:20:09.54,Default,,0,0,0,,Мен әлі де...
Dialogue: 0,0:20:12.44,0:20:13.77,Default,,0,0,0,,Менің өлгім келмейді!
Dialogue: 0,0:20:14.61,0:20:16.68,Default,,0,0,0,,Түсіндім, бұл...
Dialogue: 0,0:20:19.98,0:20:21.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:22.85,0:20:24.85,Default,,0,0,0,,Бұл өкініш
Dialogue: 0,0:20:28.29,0:20:28.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:46.47,0:20:47.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:47.41,0:20:48.31,Default,,0,0,0,,Киришима...
Dialogue: 0,0:20:48.48,0:20:50.91,Default,,0,0,0,,және Харунаның кемесінің бейнесі жоғалып кетті!
Dialogue: 0,0:20:50.98,0:20:52.91,Default,,0,0,0,,Әйтеуір жұмыс істеді, бірақ
Dialogue: 0,0:20:53.25,0:20:54.88,Default,,0,0,0,,Бұл жақын қоңырау болды.
Dialogue: 0,0:20:55.38,0:20:56.25,Default,,0,0,0,,О
Dialogue: 0,0:20:56.42,0:20:58.45,Default,,0,0,0,,Киришима мен Харунаның өңдеу қабілеті
Dialogue: 0,0:20:58.59,0:21:00.39,Default,,0,0,0,,Егер ол Ионаның күткенінен асып кетсе
Dialogue: 0,0:21:00.45,0:21:01.39,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:21:01.46,0:21:04.29,Default,,0,0,0,,Әй, жүрегіңе жаман екен! Таку
Dialogue: 0,0:21:04.49,0:21:06.79,Default,,0,0,0,,Маған бір соққы беріңізші, капитан.
Dialogue: 0,0:21:08.60,0:21:11.03,Default,,0,0,0,,Жақсы жұмыс, Иона.
Dialogue: 0,0:21:11.40,0:21:14.00,Default,,0,0,0,,Психикалық үлгіні алып бара жатқан кемені кім суға батырды?
Dialogue: 0,0:21:14.27,0:21:14.94,Default,,0,0,0,,Бұл алғаш рет.
Dialogue: 0,0:21:15.90,0:21:18.71,Default,,0,0,0,,Дұрыс... бұл мені жаман сезінді.
Dialogue: 0,0:21:19.01,0:21:20.04,Default,,0,0,0,,(Рей) Метеор… (Каэбуки) Фафрокис
Dialogue: 0,0:21:21.04,0:21:21.98,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:21:24.31,0:21:25.38,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:21:36.86,0:21:39.53,Default,,0,0,0,,Күміс құм... бұл наноматериал.
Dialogue: 0,0:21:39.79,0:21:40.73,Default,,0,0,0,,Брандо мырза
Dialogue: 0,0:21:41.03,0:21:41.90,Default,,0,0,0,,О!
Dialogue: 0,0:21:42.43,0:21:43.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.88,0:21:55.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:08.52,0:22:11.63,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,0:22:17.83,0:22:18.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:22.77,0:22:23.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:25.51,0:22:26.37,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:40.65,0:22:46.66,Default,,0,0,0,,♪～
Dialogue: 0,0:24:03.44,0:24:09.44,Default,,0,0,0,,～♪
