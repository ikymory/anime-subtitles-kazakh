Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.34,0:00:19.35,Default,,0,0,0,,Біз жақында Иво Джима бақылау аймағына кіреміз.
Dialogue: 0,0:00:19.68,0:00:22.55,Default,,0,0,0,,Капитан Сіз сенімдісіз бе?
Dialogue: 0,0:00:23.08,0:00:25.52,Default,,0,0,0,,Тұманды психикалық үлгімен сүйемелдеу
Dialogue: 0,0:00:26.12,0:00:28.12,Default,,0,0,0,,Қарулар Ионаға бекітілді
Dialogue: 0,0:00:28.72,0:00:31.13,Default,,0,0,0,,Сіз бізге зиян тигізе алмайсыз.
Dialogue: 0,0:00:31.73,0:00:35.56,Default,,0,0,0,,Қат! Харуна: Осыншама мойынсұну керек пе еді?
Dialogue: 0,0:00:36.06,0:00:38.07,Default,,0,0,0,,401 көмегінсіз
Dialogue: 0,0:00:38.13,0:00:40.14,Default,,0,0,0,,Бізді жойып жіберді
Dialogue: 0,0:00:40.30,0:00:41.67,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:00:42.40,0:00:44.67,Default,,0,0,0,,401 бізге не үшін көмектесті?
Dialogue: 0,0:00:45.14,0:00:46.61,Default,,0,0,0,,Біздің жаулар
Dialogue: 0,0:00:47.51,0:00:49.18,Default,,0,0,0,,Мен мұны білгім келеді
Dialogue: 0,0:00:49.81,0:00:50.78,Default,,0,0,0,,Хархару?
Dialogue: 0,0:00:51.48,0:00:53.58,Default,,0,0,0,,Отын суреті Жарайды.
Dialogue: 0,0:00:54.05,0:00:55.52,Default,,0,0,0,,Мен сені қорғаймын
Dialogue: 0,0:01:41.76,0:01:42.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:43.16,0:01:46.57,Default,,0,0,0,,401-дің негізі... Бұндай жерде екенін білмедім.
Dialogue: 0,0:01:46.73,0:01:50.21,Default,,0,0,0,,Бұл аралдан күшті анықтау және бейтараптандыру сигналы шығарылуда.
Dialogue: 0,0:01:50.37,0:01:52.54,Default,,0,0,0,,Біз байқамадық.
Dialogue: 0,0:01:52.67,0:01:56.88,Default,,0,0,0,,Мүмкін мен өз денемді наноматериалдармен толықтыра аламын.
Dialogue: 0,0:01:57.38,0:01:59.45,Default,,0,0,0,,Біраз уақыт солай болыңыз.
Dialogue: 0,0:01:59.55,0:02:00.88,Default,,0,0,0,,Иә? Не!
Dialogue: 0,0:02:01.32,0:02:02.85,Default,,0,0,0,,Бұл отынмен бояу үшін жақсырақ.
Dialogue: 0,0:02:03.38,0:02:06.49,Default,,0,0,0,,Неліктен мен мұндай кішкентай қыз үшін бұлай жасадым?
Dialogue: 0,0:02:06.86,0:02:07.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:08.26,0:02:11.36,Default,,0,0,0,,Қозғалу оңай, сондықтан қарсы емеспін...
Dialogue: 0,0:02:11.73,0:02:14.56,Default,,0,0,0,,(Кеменің дыбысы бекітіліп жатыр)
Dialogue: 0,0:02:16.23,0:02:17.43,Default,,0,0,0,,Портқа кіру аяқталды
Dialogue: 0,0:02:17.67,0:02:20.34,Default,,0,0,0,,Порт жүйесімен байланыс Барлық жасыл
Dialogue: 0,0:02:20.60,0:02:21.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:21.54,0:02:22.64,Default,,0,0,0,,Не болды? Иона
Dialogue: 0,0:02:23.17,0:02:24.24,Default,,0,0,0,,Біртүрлі нәрсе бар
Dialogue: 0,0:02:24.54,0:02:25.47,Default,,0,0,0,,Біртүрлі ме?
Dialogue: 0,0:02:25.54,0:02:26.51,Default,,0,0,0,,Бақылауға жіберу
Dialogue: 0,0:02:28.41,0:02:29.28,Default,,0,0,0,,Ах! (Статикалық) Әй!
Dialogue: 0,0:02:29.34,0:02:30.45,Default,,0,0,0,,Такао ауыр крейсері?
Dialogue: 0,0:02:31.35,0:02:33.25,Default,,0,0,0,,Сіз бұл базаға қалай жеттіңіз?
Dialogue: 0,0:02:33.31,0:02:35.35,Default,,0,0,0,,Оның алдында болды ма? Біз не істейміз?
Dialogue: 0,0:02:39.72,0:02:40.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:41.16,0:02:46.39,Default,,0,0,0,,Егер сіз капитан болсаңыз, маған бәрін көрсете аласыз.
Dialogue: 0,0:02:47.40,0:02:48.86,Default,,0,0,0,,Қозғалтқыш...
Dialogue: 0,0:02:49.83,0:02:55.84,Default,,0,0,0,,♪～
Dialogue: 0,0:04:11.55,0:04:17.55,Default,,0,0,0,,～♪
Dialogue: 0,0:04:26.59,0:04:28.00,Default,,0,0,0,,Такао ауыр крейсері...
Dialogue: 0,0:04:28.33,0:04:31.73,Default,,0,0,0,,Оның қайда екені белгісіз, бірақ оны сендер ұстадыңдар!
Dialogue: 0,0:04:32.03,0:04:33.00,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:04:33.94,0:04:35.04,Default,,0,0,0,,Онда неге мұндасың?
Dialogue: 0,0:04:35.54,0:04:38.47,Default,,0,0,0,,Сен жоқта не болды?
Dialogue: 0,0:04:39.01,0:04:40.04,Default,,0,0,0,,Жағаға шығайық
Dialogue: 0,0:04:40.51,0:04:41.81,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:04:42.38,0:04:44.65,Default,,0,0,0,,Иона Хюга әлі тірі, солай ма?
Dialogue: 0,0:04:44.95,0:04:46.01,Default,,0,0,0,,Хюуга?
Dialogue: 0,0:04:46.38,0:04:47.98,Default,,0,0,0,,Сіз «Хюга» атты ұлы кеме туралы айтып отырсыз ба?
Dialogue: 0,0:04:49.55,0:04:51.45,Default,,0,0,0,,Мен мұндамын Мен төменгі жағындамын
Dialogue: 0,0:04:52.29,0:04:54.76,Default,,0,0,0,,Хюга басылмағанша, бәрі жақсы.
Dialogue: 0,0:04:55.59,0:04:57.66,Default,,0,0,0,,Жағаға шығып, мән-жайды сұраса тезірек болар еді.
Dialogue: 0,0:05:01.96,0:05:04.40,Default,,0,0,0,,Қош келдіңіз, капитан.
Dialogue: 0,0:05:04.77,0:05:06.30,Default,,0,0,0,,Бұл кеш оралды.
Dialogue: 0,0:05:06.60,0:05:08.00,Default,,0,0,0,,Хюуга, еңбегіңіз үшін рахмет.
Dialogue: 0,0:05:08.90,0:05:11.37,Default,,0,0,0,,Сіз бұл докты жарты жыл бойы жақсы қорғадыңыз.
Dialogue: 0,0:05:11.64,0:05:12.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:12.77,0:05:15.94,Default,,0,0,0,,Жоқ, бұл да менің өзіме берген рөл.
Dialogue: 0,0:05:16.01,0:05:16.88,Default,,0,0,0,,Ха~!
Dialogue: 0,0:05:17.41,0:05:19.95,Default,,0,0,0,,Не? Эх!
Dialogue: 0,0:05:20.55,0:05:23.42,Default,,0,0,0,,Иона апа~!
Dialogue: 0,0:05:23.69,0:05:25.45,Default,,0,0,0,,Хюга әпкесі Хюга!
Dialogue: 0,0:05:25.52,0:05:26.75,Default,,0,0,0,,Чиакидің күні бойы ойлары
Dialogue: 0,0:05:26.82,0:05:28.86,Default,,0,0,0,,Біз сіздің үйге келуіңізді күттік!
Dialogue: 0,0:05:29.06,0:05:30.99,Default,,0,0,0,,Алыста, жоқ, жоқ, жоқ.
Dialogue: 0,0:05:31.86,0:05:32.99,Default,,0,0,0,,Не? Бұл жігіт...
Dialogue: 0,0:05:33.33,0:05:34.53,Default,,0,0,0,,Бұл психикалық үлгі ме?
Dialogue: 0,0:05:34.63,0:05:35.76,Default,,0,0,0,,Хюуга...?
Dialogue: 0,0:05:36.00,0:05:37.50,Default,,0,0,0,,Ойлап қарасаңыз, бір жыл бұрын
Dialogue: 0,0:05:37.57,0:05:40.03,Default,,0,0,0,,Әпкем мені бірінен соң бірі торпедамен ұрған күннен бастап.
Dialogue: 0,0:05:40.44,0:05:41.74,Default,,0,0,0,,Бұл «Хюга» әскери кемесі
Dialogue: 0,0:05:41.84,0:05:44.04,Default,,0,0,0,,Мен енді апамсыз өмір сүре алмаймын!
Dialogue: 0,0:05:44.44,0:05:46.01,Default,,0,0,0,,Есептік өңдеу қуатының шегінен шығу
Dialogue: 0,0:05:46.07,0:05:47.84,Default,,0,0,0,,Әйтеуір жағдай өзгеретін сияқты...
Dialogue: 0,0:05:47.91,0:05:49.84,Default,,0,0,0,,Бірдеңе болды.
Dialogue: 0,0:05:50.68,0:05:52.95,Default,,0,0,0,,Бұл шынымен Хюугаға ұқсайды.
Dialogue: 0,0:05:53.35,0:05:54.05,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:05:55.75,0:05:58.39,Default,,0,0,0,,Адамдық ойыңызды қалай түсінуге болады
Dialogue: 0,0:05:58.55,0:06:01.39,Default,,0,0,0,,Мен мұны істеудің ең жақсы жолы деген қорытындыға келдім.
Dialogue: 0,0:06:01.62,0:06:03.12,Default,,0,0,0,,Денені жасады
Dialogue: 0,0:06:03.79,0:06:05.83,Default,,0,0,0,,Психикалық модель Хюуга...
Dialogue: 0,0:06:05.96,0:06:08.36,Default,,0,0,0,,Иә! Кездескенше
Dialogue: 0,0:06:08.66,0:06:10.47,Default,,0,0,0,,Ха! Дене туралы айтсақ!
Dialogue: 0,0:06:10.67,0:06:12.50,Default,,0,0,0,,Сіз бір жерде... бір жерде жарақат алдыңыз ба?
Dialogue: 0,0:06:12.57,0:06:13.97,Default,,0,0,0,,Сізде жарақат бар ма?
Dialogue: 0,0:06:14.14,0:06:15.97,Default,,0,0,0,,Хьюуга көрсетіңізші!
Dialogue: 0,0:06:16.04,0:06:17.77,Default,,0,0,0,,Мынаны жөндей алған Хюугаға...
Dialogue: 0,0:06:17.94,0:06:18.81,Default,,0,0,0,,Арманым үшін.
Dialogue: 0,0:06:19.11,0:06:21.78,Default,,0,0,0,,Hyuga Erosion торпедомен қамтамасыз ету және
Dialogue: 0,0:06:21.84,0:06:23.58,Default,,0,0,0,,Өте ауырлық зеңбірегін жөндеу
Dialogue: 0,0:06:23.95,0:06:26.81,Default,,0,0,0,,Мен оны келесі сапарға толығымен қалпына келтіргім келеді.
Dialogue: 0,0:06:27.08,0:06:29.08,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:06:29.62,0:06:33.69,Default,,0,0,0,,Хюуга мен сенің кемең 401-ді ұстап тұрғанын білмедім.
Dialogue: 0,0:06:33.82,0:06:36.42,Default,,0,0,0,,Ұлы әскери кемесі Харуна Киришима
Dialogue: 0,0:06:36.89,0:06:38.69,Default,,0,0,0,,Жағдайлар расталды.
Dialogue: 0,0:06:39.09,0:06:41.03,Default,,0,0,0,,Балалар менімен бірге келе жатырсыңдар.
Dialogue: 0,0:06:41.16,0:06:42.90,Default,,0,0,0,,Қазір бәрі қызық бола бастады.
Dialogue: 0,0:06:43.40,0:06:44.40,Default,,0,0,0,,Бұл дәл солай.
Dialogue: 0,0:06:44.90,0:06:45.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:45.83,0:06:47.10,Default,,0,0,0,,Баланы жобалау…
Dialogue: 0,0:06:48.17,0:06:49.60,Default,,0,0,0,,Балаға арналған, солай емес пе?
Dialogue: 0,0:06:51.41,0:06:52.97,Default,,0,0,0,,Жанды болған жақсы
Dialogue: 0,0:06:53.14,0:06:54.51,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:06:54.64,0:06:57.65,Default,,0,0,0,,Бұл сол бір үлкен шайқас туралы жақсы нәрсе. Ухх.
Dialogue: 0,0:06:58.05,0:06:58.91,Default,,0,0,0,,Хюуга!
Dialogue: 0,0:06:59.11,0:07:01.52,Default,,0,0,0,,Адамзатқа қалай қосылдың!
Dialogue: 0,0:07:01.65,0:07:04.72,Default,,0,0,0,,О, мен тіпті козир комбинациясын қолданып, жеңіліп қалдым.
Dialogue: 0,0:07:05.12,0:07:07.72,Default,,0,0,0,,Оның үстіне ол сондай сүйкімді көрінді.
Dialogue: 0,0:07:07.79,0:07:09.16,Default,,0,0,0,,Мен сенің бұлай айтқаныңды қаламаймын.
Dialogue: 0,0:07:09.42,0:07:10.12,Default,,0,0,0,,Сен оны білесің бе, Аводөл? (Аводөл) Ах… өте
Dialogue: 0,0:07:10.99,0:07:13.83,Default,,0,0,0,,Хюуга, чатты кейінірек қалдырыңыз.
Dialogue: 0,0:07:14.20,0:07:16.13,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:07:16.53,0:07:17.93,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:07:19.13,0:07:24.11,Default,,0,0,0,,Көптен көрмеген, 401 экипаж
Dialogue: 0,0:07:25.61,0:07:27.01,Default,,0,0,0,,Ха! Гунзо-сама!
Dialogue: 0,0:07:27.18,0:07:29.58,Default,,0,0,0,,Умм, бұл қайсысы болды?
Dialogue: 0,0:07:29.74,0:07:30.88,Default,,0,0,0,,Нува, есімде!
Dialogue: 0,0:07:30.95,0:07:32.18,Default,,0,0,0,,Қазір есімде!
Dialogue: 0,0:07:32.85,0:07:34.45,Default,,0,0,0,,Хмф! Менің таңдауым жоқ
Dialogue: 0,0:07:37.89,0:07:39.02,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:07:39.52,0:07:40.86,Default,,0,0,0,,Сізбен кездесу үшін
Dialogue: 0,0:07:40.92,0:07:43.22,Default,,0,0,0,,Олар қисық сызықтан озып, осы орынды иемденді.
Dialogue: 0,0:07:43.62,0:07:47.09,Default,,0,0,0,,Жоқ, сіз кек алу кезінде қолға түсті.
Dialogue: 0,0:07:47.20,0:07:48.13,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:07:48.70,0:07:49.93,Default,,0,0,0,,Бізбен кездесу үшін бе?
Dialogue: 0,0:07:50.47,0:07:51.13,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:51.57,0:07:52.77,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:07:55.77,0:07:56.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:56.97,0:07:59.54,Default,,0,0,0,,Сіздің бизнесіңіз туралы сұрайық! Ауыр крейсер Такао!
Dialogue: 0,0:07:59.87,0:08:01.54,Default,,0,0,0,,А, бизнес?
Dialogue: 0,0:08:02.24,0:08:04.51,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:08:05.81,0:08:08.05,Default,,0,0,0,,Менің бизнесім...
Dialogue: 0,0:08:08.25,0:08:09.68,Default,,0,0,0,,Кел, айт! Такао
Dialogue: 0,0:08:09.85,0:08:11.82,Default,,0,0,0,,Екеуміз алдын ала жоспарлаған стратегия бойынша.
Dialogue: 0,0:08:11.99,0:08:14.56,Default,,0,0,0,,«Менің капитаным болшы!»...
Dialogue: 0,0:08:14.82,0:08:17.02,Default,,0,0,0,,Олай болса адамды алып кет.
Dialogue: 0,0:08:17.26,0:08:20.66,Default,,0,0,0,,Мен мұны істесем, Иона-сама менің жалғызым болады...
Dialogue: 0,0:08:21.13,0:08:22.03,Default,,0,0,0,,Юрури
Dialogue: 0,0:08:23.16,0:08:25.10,Default,,0,0,0,,Бұл тек менікі!
Dialogue: 0,0:08:25.73,0:08:26.67,Default,,0,0,0,,Хюуга
Dialogue: 0,0:08:27.03,0:08:28.57,Default,,0,0,0,,Иона апа~
Dialogue: 0,0:08:29.17,0:08:30.57,Default,,0,0,0,,Ооооооооооооооооооооо
Dialogue: 0,0:08:30.97,0:08:33.57,Default,,0,0,0,,Менің... менің...
Dialogue: 0,0:08:33.84,0:08:34.98,Default,,0,0,0,,Кел, айт! Такао
Dialogue: 0,0:08:35.54,0:08:36.78,Default,,0,0,0,,Саған берейін!
Dialogue: 0,0:08:37.11,0:08:39.61,Default,,0,0,0,,Айт! Маған Гунзо Чихая беріңіз!
Dialogue: 0,0:08:39.91,0:08:40.92,Default,,0,0,0,,Чи… чи…
Dialogue: 0,0:08:40.98,0:08:43.28,Default,,0,0,0,,Дірілдейтін оқтұмсық және оның деректері!
Dialogue: 0,0:08:43.78,0:08:44.92,Default,,0,0,0,,Нуо! а!
Dialogue: 0,0:08:45.95,0:08:48.22,Default,,0,0,0,,Сәлем! Өйткені, бұл мақсат!
Dialogue: 0,0:08:48.76,0:08:51.13,Default,,0,0,0,,Такао! Дірілдейтін оқтұмсықты тапсыру үшін...
Dialogue: 0,0:08:51.53,0:08:52.79,Default,,0,0,0,,Сіз! Сен ақымақ емессің бе?
Dialogue: 0,0:08:53.19,0:08:54.26,Default,,0,0,0,,Бұл жоспардан басқа!
Dialogue: 0,0:08:54.53,0:08:55.20,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:08:55.73,0:08:57.57,Default,,0,0,0,,Жақсы... өйткені
Dialogue: 0,0:08:57.73,0:08:59.87,Default,,0,0,0,,Бұл кенеттен қандай мойындау...
Dialogue: 0,0:09:00.00,0:09:03.14,Default,,0,0,0,,Қазір әйел боламын деп ұятқа қалма!
Dialogue: 0,0:09:03.60,0:09:05.91,Default,,0,0,0,,Әй... қыздың несі көп.
Dialogue: 0,0:09:06.07,0:09:08.94,Default,,0,0,0,,Otome плагинін қолданбаңыз!
Dialogue: 0,0:09:09.64,0:09:10.88,Default,,0,0,0,,А, бұл шулы!
Dialogue: 0,0:09:10.95,0:09:12.25,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:09:12.31,0:09:13.88,Default,,0,0,0,,Осындай жерде порт менеджері?
Dialogue: 0,0:09:13.95,0:09:16.68,Default,,0,0,0,,Ұлы әскери кеме ретіндегі мақтанышыңыз қайда кетті?
Dialogue: 0,0:09:16.75,0:09:18.32,Default,,0,0,0,,Шулы! Сіз не білесіз?
Dialogue: 0,0:09:18.92,0:09:22.06,Default,,0,0,0,,Иона апа соғыс құдайы сияқты құдайшыл!
Dialogue: 0,0:09:23.62,0:09:25.73,Default,,0,0,0,,Қанша қашсаң да, бірінен соң бірі қағып кетесің.
Dialogue: 0,0:09:25.79,0:09:27.63,Default,,0,0,0,,Шабуылдың күшті күші!
Dialogue: 0,0:09:27.90,0:09:30.23,Default,,0,0,0,,Ах~ Ах! Иона апа!
Dialogue: 0,0:09:30.30,0:09:32.73,Default,,0,0,0,,Мен саған қатты ғашықпын.
Dialogue: 0,0:09:32.80,0:09:35.20,Default,,0,0,0,,Мен сенің мойындауыңды тыңдамаймын!
Dialogue: 0,0:09:35.27,0:09:36.84,Default,,0,0,0,,Сәлем! (Такао Хюуга) Не!
Dialogue: 0,0:09:37.04,0:09:38.07,Default,,0,0,0,,Барлығы кетті
Dialogue: 0,0:09:39.71,0:09:41.11,Default,,0,0,0,,Иона апа!
Dialogue: 0,0:09:41.61,0:09:43.58,Default,,0,0,0,,Сонымен... болды.
Dialogue: 0,0:09:43.78,0:09:46.88,Default,,0,0,0,,Сәйкестендіру реакциясы бойынша сіз Киришимасыз...
Dialogue: 0,0:09:47.11,0:09:48.92,Default,,0,0,0,,Мен... аудармасын сұрама.
Dialogue: 0,0:10:00.09,0:10:01.90,Default,,0,0,0,,Желдің бағыты өзгерді ме?
Dialogue: 0,0:10:02.63,0:10:04.70,Default,,0,0,0,,Бұл болжауға болады.
Dialogue: 0,0:10:05.63,0:10:08.74,Default,,0,0,0,,Бірақ... Мен адам айнымалысын түсінбеймін.
Dialogue: 0,0:10:09.10,0:10:11.91,Default,,0,0,0,,Джобу Таки-э Чихая Гунзо…
Dialogue: 0,0:10:12.71,0:10:16.04,Default,,0,0,0,,Неліктен адамдармен әрекеттесетін кемелер шатастырады?
Dialogue: 0,0:10:16.74,0:10:18.61,Default,,0,0,0,,Менің атым Киришима, менің атым Такао.
Dialogue: 0,0:10:18.78,0:10:21.22,Default,,0,0,0,,Бұрынғы 2-ші флот өнертапқыш
Dialogue: 0,0:10:22.08,0:10:24.69,Default,,0,0,0,,Бұл флоттың флагманы болған адамға байланысты болуы мүмкін.
Dialogue: 0,0:10:25.12,0:10:26.72,Default,,0,0,0,,Хэбуши!
Dialogue: 0,0:10:26.99,0:10:28.02,Default,,0,0,0,,Қорқамын, ол қайтып келмейді.
Dialogue: 0,0:10:28.09,0:10:28.96,Default,,0,0,0,,Түшкіру
Dialogue: 0,0:10:29.12,0:10:32.19,Default,,0,0,0,,Адам баласы өсек естігенде түшкіретін сияқты.
Dialogue: 0,0:10:32.66,0:10:33.36,Default,,0,0,0,,Иә
Dialogue: 0,0:10:33.63,0:10:35.03,Default,,0,0,0,,Кім өсек айтты?
Dialogue: 0,0:10:35.26,0:10:36.23,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:10:36.30,0:10:37.26,Default,,0,0,0,,Не? ол
Dialogue: 0,0:10:44.07,0:10:45.41,Default,,0,0,0,,Сәлем Такао!
Dialogue: 0,0:10:45.74,0:10:47.91,Default,,0,0,0,,Сіз мұнда қанша уақыт боласыз?
Dialogue: 0,0:10:48.04,0:10:49.14,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:10:49.68,0:10:52.31,Default,,0,0,0,,Егер сізді сол адам қызықтырса.
Dialogue: 0,0:10:52.38,0:10:53.78,Default,,0,0,0,,Жақсырақ
Dialogue: 0,0:10:54.18,0:10:55.65,Default,,0,0,0,,Сіз олармен флот құрғыңыз келе ме?
Dialogue: 0,0:10:56.42,0:10:57.75,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:10:58.39,0:11:02.06,Default,,0,0,0,,Капитан Гунзо Чихая бұл жерден бас тартпақшы.
Dialogue: 0,0:11:02.36,0:11:03.29,Default,,0,0,0,,Бас тарту?
Dialogue: 0,0:11:03.86,0:11:07.06,Default,,0,0,0,,Қорсыз тұманмен қалай күресеміз?
Dialogue: 0,0:11:07.73,0:11:10.03,Default,,0,0,0,,Бұл қайтпас детерминация деп аталады емес пе?
Dialogue: 0,0:11:10.36,0:11:13.17,Default,,0,0,0,,Бұл бізге түсіну қиын ұғым.
Dialogue: 0,0:11:14.00,0:11:17.71,Default,,0,0,0,,Гунзо Чихая дірілдеген оқтұмсықтар жаппай шығарылса жүзеге асады.
Dialogue: 0,0:11:17.81,0:11:20.14,Default,,0,0,0,,Сіз бәрі өзгереді деп ойлайтын сияқтысыз.
Dialogue: 0,0:11:20.34,0:11:21.98,Default,,0,0,0,,Ақылсыз ойлау
Dialogue: 0,0:11:22.18,0:11:23.81,Default,,0,0,0,,Өлетін сияқты.
Dialogue: 0,0:11:24.71,0:11:27.88,Default,,0,0,0,,Адамдар өз өмірін бағаламай ма?
Dialogue: 0,0:11:28.22,0:11:31.02,Default,,0,0,0,,Үлкен игіліктер үшін өзіңізді құрбан ету
Dialogue: 0,0:11:31.32,0:11:33.39,Default,,0,0,0,,Жағдайлар жоқ сияқты емес.
Dialogue: 0,0:11:33.82,0:11:34.89,Default,,0,0,0,,Себеп дегеніміз не?
Dialogue: 0,0:11:37.36,0:11:39.19,Default,,0,0,0,,Егер біз бұл жерден бас тартсақ
Dialogue: 0,0:11:39.26,0:11:41.80,Default,,0,0,0,,Мен де 401 жылы тұрамын.
Dialogue: 0,0:11:42.23,0:11:44.03,Default,,0,0,0,,Сен де менімен неге келмейсің?
Dialogue: 0,0:11:44.77,0:11:47.47,Default,,0,0,0,,Хьюганың тұманға оралу ниеті жоқ па?
Dialogue: 0,0:11:48.04,0:11:50.00,Default,,0,0,0,,Бұған ешқандай себеп жоқ.
Dialogue: 0,0:11:50.14,0:11:53.81,Default,,0,0,0,,Мен әзірге Иона-саманың қосалқы процессоры болып жұмыс істеймін.
Dialogue: 0,0:11:54.21,0:11:55.08,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:55.14,0:11:58.01,Default,,0,0,0,,Біз оны «Көгілдір флот» деп атаймыз
Dialogue: 0,0:11:59.01,0:12:00.88,Default,,0,0,0,,Көк флот...?
Dialogue: 0,0:12:09.89,0:12:12.36,Default,,0,0,0,,Көк флот...
Dialogue: 0,0:12:16.90,0:12:17.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:18.87,0:12:19.90,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:12:24.00,0:12:25.51,Default,,0,0,0,,Мен төрелік еттім
Dialogue: 0,0:12:26.11,0:12:28.28,Default,,0,0,0,,Сіз біртүрлі плагинді енгіздіңіз.
Dialogue: 0,0:12:28.74,0:12:30.34,Default,,0,0,0,,Басқа процестер еленбейді
Dialogue: 0,0:12:30.44,0:12:33.85,Default,,0,0,0,,Жауынгерлік кеме класының есептеу қабілетін бағаламаңыз.
Dialogue: 0,0:12:34.35,0:12:36.95,Default,,0,0,0,,Сіз біртүрлі психикалық модель жасапсыз, солай емес пе?
Dialogue: 0,0:12:37.02,0:12:37.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:38.22,0:12:39.15,Default,,0,0,0,,Уау~
Dialogue: 0,0:12:40.12,0:12:41.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:41.29,0:12:42.16,Default,,0,0,0,,Хюуга!
Dialogue: 0,0:12:42.29,0:12:43.76,Default,,0,0,0,,Барлығына айтпаңыз
Dialogue: 0,0:12:44.06,0:12:45.29,Default,,0,0,0,,Жағдайлар әртүрлі, солай емес пе?
Dialogue: 0,0:12:45.86,0:12:47.43,Default,,0,0,0,,Хюуга оны нақтылады ма?
Dialogue: 0,0:12:47.80,0:12:50.50,Default,,0,0,0,,Сіз ингредиенттерді білетін болсаңыз, кез келген нәрсені жасай аласыз.
Dialogue: 0,0:12:51.43,0:12:52.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:53.53,0:12:56.17,Default,,0,0,0,,Сен адам емессің, тұман да емессің.
Dialogue: 0,0:12:56.54,0:12:57.91,Default,,0,0,0,,Себебі бұл қызықты.
Dialogue: 0,0:12:58.01,0:12:58.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:00.01,0:13:00.91,Default,,0,0,0,,Хюуга!
Dialogue: 0,0:13:01.01,0:13:02.98,Default,,0,0,0,,Мені қате түсінбеңіз, бұл жақсылық.
Dialogue: 0,0:13:03.34,0:13:05.31,Default,,0,0,0,,Такиги-е Өтінемін, жақсы араласыңыз.
Dialogue: 0,0:13:05.55,0:13:06.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:06.51,0:13:07.38,Default,,0,0,0,,Брандо мырза
Dialogue: 0,0:13:07.92,0:13:11.52,Default,,0,0,0,,Мен сендермен жүргенде ешқашан жалықпаймын хахахахаха!
Dialogue: 0,0:13:11.99,0:13:12.99,Default,,0,0,0,,Жүр, тамақ іш!
Dialogue: 0,0:13:13.05,0:13:13.92,Default,,0,0,0,,Иә
Dialogue: 0,0:13:14.09,0:13:16.02,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:13:16.52,0:13:17.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:18.13,0:13:21.90,Default,,0,0,0,,Бұл жерде түрлі ойлар мен сезімдер араласады.
Dialogue: 0,0:13:22.13,0:13:23.96,Default,,0,0,0,,Тым көп өңдеу жүктемесі
Dialogue: 0,0:13:24.37,0:13:25.27,Default,,0,0,0,,Сіз үйреніп кетесіз
Dialogue: 0,0:13:25.80,0:13:27.40,Default,,0,0,0,,Иона тым салмақты.
Dialogue: 0,0:13:28.07,0:13:29.04,Default,,0,0,0,,Маңызды ма?
Dialogue: 0,0:13:29.54,0:13:31.37,Default,,0,0,0,,Көп уайымдамаңыз
Dialogue: 0,0:13:32.07,0:13:33.14,Default,,0,0,0,,Тым көп уайымдау...
Dialogue: 0,0:13:38.38,0:13:39.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:41.45,0:13:43.28,Default,,0,0,0,,Елеулі залал қалды
Dialogue: 0,0:13:44.22,0:13:46.52,Default,,0,0,0,,Йокосукада жөндеу мүмкін болмады.
Dialogue: 0,0:13:48.96,0:13:50.22,Default,,0,0,0,,Иона, жақсысың ба?
Dialogue: 0,0:13:50.59,0:13:51.83,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:52.09,0:13:53.96,Default,,0,0,0,,Хюуга жақсы жұмыс істейді.
Dialogue: 0,0:13:54.26,0:13:56.56,Default,,0,0,0,,Жөндеу жұмыстары аяқталғаннан кейін оны тастаңыз
Dialogue: 0,0:13:57.16,0:13:59.17,Default,,0,0,0,,Алда қиын сапар болады.
Dialogue: 0,0:13:59.60,0:14:00.53,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:14:01.14,0:14:02.47,Default,,0,0,0,,Мен сенің кемеңмін
Dialogue: 0,0:14:02.60,0:14:03.47,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:14:04.44,0:14:05.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:06.01,0:14:06.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:08.91,0:14:11.05,Default,,0,0,0,,Не? бұл сезім
Dialogue: 0,0:14:15.58,0:14:16.55,Default,,0,0,0,,Капитан…
Dialogue: 0,0:14:18.19,0:14:20.15,Default,,0,0,0,,Бүгіннен бастап Көк флоттың флагманы болады
Dialogue: 0,0:14:20.25,0:14:21.56,Default,,0,0,0,,Такао, бұл сенсің.
Dialogue: 0,0:14:21.62,0:14:24.26,Default,,0,0,0,,Мен ауыр ауыр крейсермін
Dialogue: 0,0:14:24.56,0:14:26.49,Default,,0,0,0,,Флагмандық деген осындай...
Dialogue: 0,0:14:26.99,0:14:29.16,Default,,0,0,0,,Жоқ, мен тек сені ғана ойлаймын.
Dialogue: 0,0:14:29.40,0:14:31.53,Default,,0,0,0,,Бүгіннен бастап мен Такаоға отырамын.
Dialogue: 0,0:14:31.60,0:14:33.50,Default,,0,0,0,,Ах! Мен құрметтемін
Dialogue: 0,0:14:34.03,0:14:35.30,Default,,0,0,0,,Менің адмиралым…
Dialogue: 0,0:14:35.87,0:14:37.10,Default,,0,0,0,,Кел, Такао
Dialogue: 0,0:14:37.27,0:14:38.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:38.21,0:14:39.31,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:14:40.51,0:14:42.44,Default,,0,0,0,,Уау! Ухуху...
Dialogue: 0,0:14:43.31,0:14:44.18,Default,,0,0,0,,Такао?
Dialogue: 0,0:14:44.51,0:14:45.58,Default,,0,0,0,,Гунзо Чихая!
Dialogue: 0,0:14:47.45,0:14:49.18,Default,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,0:14:54.52,0:14:55.96,Default,,0,0,0,,401…
Dialogue: 0,0:14:57.36,0:15:00.49,Default,,0,0,0,,Мен мұндай сүңгуір қайықтың бортында капитан бар екеніне сене алмаймын.
Dialogue: 0,0:15:00.56,0:15:01.43,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:02.10,0:15:04.53,Default,,0,0,0,,Иона апаға ондай адам керек емес.
Dialogue: 0,0:15:05.00,0:15:06.27,Default,,0,0,0,,Неліктен бірінші кезекте
Dialogue: 0,0:15:06.33,0:15:09.14,Default,,0,0,0,,401 адаммен бірге әрекет ете ме?
Dialogue: 0,0:15:09.44,0:15:11.17,Default,,0,0,0,,№ 401
Dialogue: 0,0:15:12.01,0:15:13.14,Default,,0,0,0,,Бұл ерекше.
Dialogue: 0,0:15:14.28,0:15:17.65,Default,,0,0,0,,Сіз біз тұмандағы мутанттармыз деп айта аласыз.
Dialogue: 0,0:15:18.28,0:15:20.61,Default,,0,0,0,,Адамдар рак клеткаларын осылай атайды ма?
Dialogue: 0,0:15:20.68,0:15:22.28,Default,,0,0,0,,Бұл эволюцияның белгісі ме?
Dialogue: 0,0:15:22.98,0:15:24.15,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:25.45,0:15:26.49,Default,,0,0,0,,Эволюция?
Dialogue: 0,0:15:26.99,0:15:28.22,Default,,0,0,0,,(Нишики) Бұл... осы туралы сұрауға мен дұрыс адаммын ба?
Dialogue: 0,0:15:28.29,0:15:30.93,Default,,0,0,0,,Маған адамдармен не болатыны қызық емес.
Dialogue: 0,0:15:31.36,0:15:33.23,Default,,0,0,0,,Біз қайдан келдік?
Dialogue: 0,0:15:33.46,0:15:35.23,Default,,0,0,0,,Біз қайда барамыз?
Dialogue: 0,0:15:35.93,0:15:37.50,Default,,0,0,0,,Біз кімбіз?
Dialogue: 0,0:15:38.17,0:15:39.70,Default,,0,0,0,,Менің білгім келетіні осы.
Dialogue: 0,0:15:40.70,0:15:44.14,Default,,0,0,0,,Иона апа Гунзо Чихаямен байланысқа шыққаннан бері
Dialogue: 0,0:15:44.31,0:15:47.11,Default,,0,0,0,,Соғыс жағдайына келсек... дүние мүлде өзгерді.
Dialogue: 0,0:15:47.51,0:15:50.44,Default,,0,0,0,,Сондықтан мен Иона апа туралы бәрін білгім келеді.
Dialogue: 0,0:15:52.55,0:15:56.45,Default,,0,0,0,,Біз қару болдық...
Dialogue: 0,0:16:09.03,0:16:10.66,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:16:11.53,0:16:13.63,Default,,0,0,0,,Харухару, кеттік~ Болды!
Dialogue: 0,0:16:16.97,0:16:18.54,Default,,0,0,0,,Біз қарумыз
Dialogue: 0,0:16:19.44,0:16:21.54,Default,,0,0,0,,Қару ойлайды ма?
Dialogue: 0,0:16:22.44,0:16:23.54,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:16:24.24,0:16:26.25,Default,,0,0,0,,Біз қайда барамыз?
Dialogue: 0,0:16:32.22,0:16:33.29,Default,,0,0,0,,Ммм
Dialogue: 0,0:16:34.09,0:16:37.02,Default,,0,0,0,,401 Не? Сол көзқарас
Dialogue: 0,0:16:37.36,0:16:39.19,Default,,0,0,0,,Гунзо маған үзіліс жасауымды өтінді.
Dialogue: 0,0:16:39.33,0:16:41.00,Default,,0,0,0,,Иә, маған қоңырау шалуды доғар!
Dialogue: 0,0:16:41.76,0:16:43.63,Default,,0,0,0,,Немесе... капитан...
Dialogue: 0,0:16:43.70,0:16:46.47,Default,,0,0,0,,Сіз кемелер туралы осылай ойлайсыз ба?
Dialogue: 0,0:16:47.50,0:16:48.47,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:48.74,0:16:50.24,Default,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,0:16:50.54,0:16:51.51,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:16:51.64,0:16:53.11,Default,,0,0,0,,Мен ашулы емеспін!
Dialogue: 0,0:16:53.67,0:16:55.08,Default,,0,0,0,,Такао ауыр крейсері
Dialogue: 0,0:16:55.51,0:16:56.38,Default,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,0:16:56.68,0:16:58.21,Default,,0,0,0,,Ағымдағы уақыт бойынша
Dialogue: 0,0:16:58.51,0:17:01.08,Default,,0,0,0,,Сізді Хюганың басқаруынан босатыңыз
Dialogue: 0,0:17:01.45,0:17:02.58,Default,,0,0,0,,Не? Жарайды ма?
Dialogue: 0,0:17:03.08,0:17:04.15,Default,,0,0,0,,Сурет бойынша топтық нұсқаулар
Dialogue: 0,0:17:04.35,0:17:05.62,Default,,0,0,0,,Капитан?
Dialogue: 0,0:17:06.05,0:17:07.22,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:17:07.72,0:17:08.76,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:17:09.02,0:17:09.69,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:17:10.22,0:17:12.26,Default,,0,0,0,,Бұл сізге арналған ба, білмеймін.
Dialogue: 0,0:17:12.63,0:17:15.80,Default,,0,0,0,,Бірақ енді тұман флотына оралуға болады.
Dialogue: 0,0:17:16.60,0:17:19.63,Default,,0,0,0,,Неліктен жауды үйіне қайтару қиынға соғады?
Dialogue: 0,0:17:20.20,0:17:23.20,Default,,0,0,0,,Олар сізге тағы шабуыл жасауы мүмкін бе?
Dialogue: 0,0:17:23.64,0:17:25.81,Default,,0,0,0,,Бұл Гунцоның идеясы
Dialogue: 0,0:17:27.47,0:17:29.41,Default,,0,0,0,,Бәрін білетіндей айтасың.
Dialogue: 0,0:17:29.71,0:17:31.41,Default,,0,0,0,,Мен Гунцоның кемесімін
Dialogue: 0,0:17:31.75,0:17:34.11,Default,,0,0,0,,Сізде тұман мақтаныш жоқ па?
Dialogue: 0,0:17:35.35,0:17:37.58,Default,,0,0,0,,Гунцомен кездесіп, соңынан еріңіз
Dialogue: 0,0:17:38.05,0:17:41.69,Default,,0,0,0,,Бұл менің ішімде бар жалғыз бұйрық болды.
Dialogue: 0,0:17:42.39,0:17:43.42,Default,,0,0,0,,Бұйрық?
Dialogue: 0,0:17:43.56,0:17:44.83,Default,,0,0,0,,Түсіндім... Түсіндім!
Dialogue: 0,0:17:45.49,0:17:48.33,Default,,0,0,0,,Сіз бұйрық бойынша капитанның қасында қалдыңыз, солай ма?
Dialogue: 0,0:17:50.66,0:17:51.63,Default,,0,0,0,,Толық түсінгенім жоқ, бірақ—
Dialogue: 0,0:17:52.17,0:17:55.44,Default,,0,0,0,,Сонда сіз капитанға мән бермейсіз бе?
Dialogue: 0,0:17:56.34,0:17:57.64,Default,,0,0,0,,Топтық бейнелер ше?
Dialogue: 0,0:17:57.74,0:17:58.67,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:17:59.17,0:18:00.11,Default,,0,0,0,,Суреттерді топтастыру…
Dialogue: 0,0:18:00.81,0:18:03.24,Default,,0,0,0,,Гунзо менің...
Dialogue: 0,0:18:03.68,0:18:04.61,Default,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,0:18:07.35,0:18:08.48,Default,,0,0,0,,Әрі қарай!
Dialogue: 0,0:18:12.25,0:18:15.66,Default,,0,0,0,,Жөндеу жұмыстары аяқталғаннан кейін бұл аралды тастаңыз.
Dialogue: 0,0:18:16.09,0:18:18.46,Default,,0,0,0,,Харуна, Киришиманы әкелгені үшін.
Dialogue: 0,0:18:18.66,0:18:21.30,Default,,0,0,0,,Жау сіздің тұрған жеріңізді білетін еді.
Dialogue: 0,0:18:21.60,0:18:23.73,Default,,0,0,0,,Ерік-жігеріңіз болмаса да
Dialogue: 0,0:18:24.63,0:18:27.17,Default,,0,0,0,,Наноматериалдар аз қалды
Dialogue: 0,0:18:27.37,0:18:29.84,Default,,0,0,0,,Қай жолдан бас тарту керек болды
Dialogue: 0,0:18:30.10,0:18:32.57,Default,,0,0,0,,Бұдан былай эрозия торпедалары берілмейді.
Dialogue: 0,0:18:33.21,0:18:34.34,Default,,0,0,0,,Дірілдейтін оқтұмсық
Dialogue: 0,0:18:34.88,0:18:36.28,Default,,0,0,0,,Мен оны Америкаға жеткіземін.
Dialogue: 0,0:18:36.74,0:18:38.71,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:18:39.21,0:18:41.68,Default,,0,0,0,,Капитан соғысқысы келмейді, солай ма?
Dialogue: 0,0:18:42.15,0:18:43.78,Default,,0,0,0,,Бұл оқтұмсық жаппай шығарылды.
Dialogue: 0,0:18:43.85,0:18:46.12,Default,,0,0,0,,Тұманмен салыстырылатын қуатты алу арқылы.
Dialogue: 0,0:18:46.49,0:18:48.59,Default,,0,0,0,,Ақырында, адамдар тең дәрежеде келіссөздер жүргізе алады.
Dialogue: 0,0:18:48.89,0:18:49.82,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:18:49.89,0:18:51.53,Default,,0,0,0,,Олай болса, ойланудың қажеті жоқ!
Dialogue: 0,0:18:52.16,0:18:56.16,Default,,0,0,0,,Тұман, Иона және басқалар сияқты, ерік-жігері бар тіршілік иесі.
Dialogue: 0,0:18:56.60,0:18:59.50,Default,,0,0,0,,Мен бірге өмір сүрудің жолы бар деп есептеймін.
Dialogue: 0,0:19:00.67,0:19:04.20,Default,,0,0,0,,Егер жағдай қазіргідей жалғаса берсе, адамзат таусылып, жойылады.
Dialogue: 0,0:19:04.67,0:19:08.31,Default,,0,0,0,,Бізді қазір үкімет іздеуде.
Dialogue: 0,0:19:08.64,0:19:11.68,Default,,0,0,0,,Бірақ біз мұны істеуіміз керек.
Dialogue: 0,0:19:13.18,0:19:14.52,Default,,0,0,0,,Жоюға апаратын жол
Dialogue: 0,0:19:14.75,0:19:15.85,Default,,0,0,0,,Тоқтату
Dialogue: 0,0:19:24.56,0:19:25.86,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:19:30.86,0:19:32.40,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:19:34.70,0:19:37.67,Default,,0,0,0,,Сіз Гунзомен не үшін кездестіңіз?
Dialogue: 0,0:19:42.38,0:19:44.31,Default,,0,0,0,,Иә? Америкадан?
Dialogue: 0,0:19:44.78,0:19:47.35,Default,,0,0,0,,Әй, керемет түрде байланыс қалпына келтірілді.
Dialogue: 0,0:19:47.65,0:19:50.55,Default,,0,0,0,,A… Америка тірі және жақсы.
Dialogue: 0,0:19:50.72,0:19:51.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:52.82,0:19:54.25,Default,,0,0,0,,Адамзаттың болашағы…
Dialogue: 0,0:19:54.66,0:19:57.22,Default,,0,0,0,,Мойын терісінің бір бөлігі арқылы жалғанды ма?
Dialogue: 0,0:19:57.46,0:19:59.83,Default,,0,0,0,,Бірақ дірілдейтін оқтұмсықтың үлгісі...
Dialogue: 0,0:20:00.76,0:20:04.33,Default,,0,0,0,,Мен көремін. 401-нің тағдыры белгісіз.
Dialogue: 0,0:20:04.53,0:20:05.40,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:20:06.37,0:20:07.94,Default,,0,0,0,,Иә? жауапкершілік?
Dialogue: 0,0:20:08.67,0:20:11.44,Default,,0,0,0,,Жауапкершілікті өз мойнына алу – қарияның міндеті.
Dialogue: 0,0:20:11.91,0:20:15.28,Default,,0,0,0,,Мен оны саған жеткіземін 401 Хана
Dialogue: 0,0:20:19.78,0:20:21.45,Default,,0,0,0,,Ха... Харуна
Dialogue: 0,0:20:22.45,0:20:23.62,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:20:25.22,0:20:26.59,Default,,0,0,0,,Ха! Конгоу!
Dialogue: 0,0:20:27.65,0:20:29.42,Default,,0,0,0,,Харуна Киришима
Dialogue: 0,0:20:29.66,0:20:32.29,Default,,0,0,0,,Флоттан кету дегенді қалай түсінесіңдер?
Dialogue: 0,0:20:34.56,0:20:36.36,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,0:20:36.86,0:20:38.67,Default,,0,0,0,,Баланы жобалау?
Dialogue: 0,0:20:38.97,0:20:42.74,Default,,0,0,0,,Адмиралтия кодексінің директивасында бұған қатысы бар ештеңе жоқ.
Dialogue: 0,0:20:43.54,0:20:44.40,Default,,0,0,0,,Конго
Dialogue: 0,0:20:44.71,0:20:48.64,Default,,0,0,0,,Біз тұман тек бұйрық бойынша өмір сүре аламыз ба?
Dialogue: 0,0:20:48.84,0:20:51.55,Default,,0,0,0,,Иә, оған күмәнданудың қажеті жоқ.
Dialogue: 0,0:20:51.98,0:20:55.25,Default,,0,0,0,,Сонымен бұл қандай эмоция?
Dialogue: 0,0:20:55.45,0:20:58.59,Default,,0,0,0,,Көптеген белгісіздікпен адамның ойлауын үйрену
Dialogue: 0,0:20:58.72,0:21:01.29,Default,,0,0,0,,Бұл тексеруге арналған модельдеу.
Dialogue: 0,0:21:01.39,0:21:05.46,Default,,0,0,0,,Сіздің шатасуыңыз тым көп есептеу жүктемесіне байланысты.
Dialogue: 0,0:21:06.49,0:21:08.96,Default,,0,0,0,,Харуна Заттар таусылады.
Dialogue: 0,0:21:09.03,0:21:11.63,Default,,0,0,0,,Сіздің кеме жөндеуді қажет етеді.
Dialogue: 0,0:21:11.93,0:21:12.97,Default,,0,0,0,,Флотқа оралу
Dialogue: 0,0:21:13.97,0:21:17.00,Default,,0,0,0,,Мен уәде бердім
Dialogue: 0,0:21:17.64,0:21:19.57,Default,,0,0,0,,Такиги-емен дос болу
Dialogue: 0,0:21:19.67,0:21:22.98,Default,,0,0,0,,Достар? Бұл түсініксіз
Dialogue: 0,0:21:24.01,0:21:28.28,Default,,0,0,0,,Конгоу Мен Тәкинемен біраз уақыт боламын.
Dialogue: 0,0:21:30.72,0:21:32.62,Default,,0,0,0,,Сіз сілтемені бұздыңыз ба?
Dialogue: 0,0:21:33.29,0:21:35.32,Default,,0,0,0,,Киришима, сен не істейсің?
Dialogue: 0,0:21:35.39,0:21:38.89,Default,,0,0,0,,А... Мен Харунаны бақылап отырамын.
Dialogue: 0,0:21:39.06,0:21:41.40,Default,,0,0,0,,Бас тарту туралы не деуге болады?
Dialogue: 0,0:21:41.50,0:21:43.90,Default,,0,0,0,,Түсіндім... қарастырамын.
Dialogue: 0,0:21:46.73,0:21:48.37,Default,,0,0,0,,Эмоциялар туралы не деуге болады?
Dialogue: 0,0:21:48.44,0:21:50.84,Default,,0,0,0,,Эмоциялар – жетілмеген ауытқулар.
Dialogue: 0,0:21:50.97,0:21:53.37,Default,,0,0,0,,Біздің қаруымызға оның қажеті жоқ.
Dialogue: 0,0:21:53.94,0:21:54.84,Default,,0,0,0,,Майя
Dialogue: 0,0:21:54.91,0:21:56.61,Default,,0,0,0,,Не? Конго
Dialogue: 0,0:21:56.88,0:21:58.65,Default,,0,0,0,,Әңгіме синхрондалады.
Dialogue: 0,0:21:59.05,0:21:59.91,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:00.61,0:22:02.55,Default,,0,0,0,,Сіз маған қосылыңыз.
Dialogue: 0,0:22:02.88,0:22:03.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:04.02,0:22:05.42,Default,,0,0,0,,Ақырында, сіздің кезегіңіз!
Dialogue: 0,0:22:05.82,0:22:07.35,Default,,0,0,0,,Біз қарумыз!
Dialogue: 0,0:22:07.55,0:22:10.99,Default,,0,0,0,,Сіздің міндетіңіз – миссияны қабылдау және оны орындау!
Dialogue: 0,0:22:11.69,0:22:14.70,Default,,0,0,0,,Хехехе, бұл карнавал!
Dialogue: 0,0:22:16.76,0:22:17.73,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:18.07,0:22:21.77,Default,,0,0,0,,Ал, олар Харуна мен басқалары келгенде біледі.
Dialogue: 0,0:22:21.87,0:22:24.77,Default,,0,0,0,,Жалқаулықты ұнатпайтын сияқтысың.
Dialogue: 0,0:22:25.47,0:22:27.07,Default,,0,0,0,,Эй Конгоу
Dialogue: 0,0:22:33.01,0:22:34.72,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:22:35.48,0:22:39.65,Default,,0,0,0,,Сенің болмысыңның мәнін растауға рұқсат етіңіз.
Dialogue: 0,0:22:40.45,0:22:46.46,Default,,0,0,0,,♪～
Dialogue: 0,0:24:03.47,0:24:09.48,Default,,0,0,0,,～♪
