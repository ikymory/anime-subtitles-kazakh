Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.14,0:00:13.41,Default,,0,0,0,,Маки
Dialogue: 0,0:00:15.18,0:00:18.08,Default,,0,0,0,,Қуыршақ болып жаралған саған
Dialogue: 0,0:00:18.15,0:00:19.48,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:00:19.55,0:00:22.68,Default,,0,0,0,,Мен ғашық болдым
Dialogue: 0,0:00:23.45,0:00:25.12,Default,,0,0,0,,Ал қазір
Dialogue: 0,0:00:25.19,0:00:27.66,Default,,0,0,0,,Сіз адам емессіз
Dialogue: 0,0:00:28.39,0:00:30.49,Default,,0,0,0,,Біз адамзаттың жауымыз.
Dialogue: 0,0:00:30.56,0:00:33.23,Default,,0,0,0,,Қарым-қатынас жасауға тырысу
Dialogue: 0,0:00:33.63,0:00:36.40,Default,,0,0,0,,Бұл шынымен ирониялық.
Dialogue: 0,0:00:38.13,0:00:39.40,Default,,0,0,0,,Бірақ
Dialogue: 0,0:00:39.63,0:00:41.20,Default,,0,0,0,,О, Хиёри, қандай кездейсоқ кездесу.
Dialogue: 0,0:00:41.74,0:00:43.81,Default,,0,0,0,,Кез келген қарудан күштірек
Dialogue: 0,0:00:45.71,0:00:50.48,Default,,0,0,0,,Міне, сіз қазір дамытқыңыз келетін сезім.
Dialogue: 0,0:00:50.55,0:00:53.42,Default,,0,0,0,,Мен бұл әлемді өзгертемін деп ойлаймын
Dialogue: 0,0:00:54.58,0:00:57.12,Default,,0,0,0,,Менің ойымша, бұл.
Dialogue: 0,0:00:59.59,0:01:02.19,Default,,0,0,0,,Қош бол Маки
Dialogue: 0,0:01:04.76,0:01:08.30,Default,,0,0,0,,Қымбатты қызым
Dialogue: 0,0:01:11.43,0:01:15.84,Default,,0,0,0,,(жүрек-өкпенің тоқтауы дабылы)
Dialogue: 0,0:01:23.78,0:01:29.78,Default,,0,0,0,,♪～
Dialogue: 0,0:02:45.36,0:02:51.37,Default,,0,0,0,,～♪
Dialogue: 0,0:03:12.22,0:03:13.59,Default,,0,0,0,,Жарай бер, жарай бер — сен ауаны тұншықтырып жатырсың, шетке жыл.
Dialogue: 0,0:03:17.39,0:03:18.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:19.66,0:03:21.33,Default,,0,0,0,,қоршалған
Dialogue: 0,0:03:21.83,0:03:23.57,Default,,0,0,0,,Қару реакциясы анықталды
Dialogue: 0,0:03:23.63,0:03:24.73,Default,,0,0,0,,Сіз бізді нысанаға алып отырсыз ба?
Dialogue: 0,0:03:24.80,0:03:25.67,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:26.43,0:03:29.77,Default,,0,0,0,,Олар ескі компьютерлермен де жұмыс істейді.
Dialogue: 0,0:03:29.84,0:03:32.34,Default,,0,0,0,,Біз ол баланы кәдеге жаратуды шештік.
Dialogue: 0,0:03:33.94,0:03:34.98,Default,,0,0,0,,Мақсат
Dialogue: 0,0:03:36.24,0:03:37.51,Default,,0,0,0,,Маки
Dialogue: 0,0:03:40.62,0:03:41.92,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:03:43.52,0:03:44.45,Default,,0,0,0,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 0,0:03:44.85,0:03:46.59,Default,,0,0,0,,Гиобу резиденциясын электрмен жабдықтау
Dialogue: 0,0:03:46.65,0:03:48.26,Default,,0,0,0,,Барлығы блокталған
Dialogue: 0,0:03:48.32,0:03:50.49,Default,,0,0,0,,Біз енді сарайға кіреміз.
Dialogue: 0,0:03:50.73,0:03:51.99,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:52.26,0:03:55.43,Default,,0,0,0,,Тек психикалық модельдің жауынгерлік күші белгісіз.
Dialogue: 0,0:03:55.50,0:03:57.80,Default,,0,0,0,,Сақтықпен әрекет етіңіз
Dialogue: 0,0:03:57.87,0:03:58.80,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:58.87,0:04:02.77,Default,,0,0,0,,Бұл операцияның мақсаты - Джобу Маки.
Dialogue: 0,0:04:02.84,0:04:04.47,Default,,0,0,0,,Мен саған мүмкіндік беремін. Таңдауға екі жол бар.
Dialogue: 0,0:04:07.24,0:04:09.48,Default,,0,0,0,,Мүлдем алдын алу керек
Dialogue: 0,0:04:09.54,0:04:14.35,Default,,0,0,0,,Жалғыз нәрсе, дірілдеген оқтұмсықты жасау әдісі тұман жағына ауысады.
Dialogue: 0,0:04:15.25,0:04:16.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:16.82,0:04:18.72,Default,,0,0,0,,Қолымызға түскенше
Dialogue: 0,0:04:18.79,0:04:21.79,Default,,0,0,0,,Осы қызбен бірдеңе істеу ойың бар ма?
Dialogue: 0,0:04:21.86,0:04:25.49,Default,,0,0,0,,Олар резиденцияға сырттан шабуыл жасамай басып кіргендіктен.
Dialogue: 0,0:04:25.59,0:04:27.03,Default,,0,0,0,,Жоғары мүмкіндік
Dialogue: 0,0:04:27.40,0:04:29.60,Default,,0,0,0,,Мен Макиді тоқтатуға бел байладым.
Dialogue: 0,0:04:29.93,0:04:32.27,Default,,0,0,0,,Қозғалыстарыңызда іркіліс жоқ.
Dialogue: 0,0:04:32.37,0:04:35.27,Default,,0,0,0,,Бұл бөлменің орны бұрыннан белгілі болған сияқты.
Dialogue: 0,0:04:35.34,0:04:36.70,Default,,0,0,0,,Бізде көп уақыт жоқ
Dialogue: 0,0:04:37.41,0:04:38.37,Default,,0,0,0,,Киришима
Dialogue: 0,0:04:38.44,0:04:40.38,Default,,0,0,0,,Сізден біраз уақытқа маки жасауыңызды өтінсем бола ма?
Dialogue: 0,0:04:41.58,0:04:42.94,Default,,0,0,0,,Харуна, сен...
Dialogue: 0,0:04:43.71,0:04:44.95,Default,,0,0,0,,Қазір оралу
Dialogue: 0,0:04:47.28,0:04:48.65,Default,,0,0,0,,Екінші қабатқа келді
Dialogue: 0,0:04:48.72,0:04:50.45,Default,,0,0,0,,Жарайды, бөлмені қоршай бер.
Dialogue: 0,0:04:50.52,0:04:52.42,Default,,0,0,0,,Гиобу Макиді дереу қорғаңыз
Dialogue: 0,0:04:52.49,0:04:53.96,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:54.36,0:04:55.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:57.79,0:04:58.93,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:05:00.03,0:05:02.86,Default,,0,0,0,,Бұл Харуна атты ұлы кеменің психикалық үлгісі емес пе?
Dialogue: 0,0:05:03.03,0:05:04.33,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:04.40,0:05:05.80,Default,,0,0,0,,Тыныш түрде беріл.
Dialogue: 0,0:05:05.87,0:05:08.04,Default,,0,0,0,,Осылайша мен сіздің қауіпсіздігіңізге кепілдік бере аламын.
Dialogue: 0,0:05:08.54,0:05:11.87,Default,,0,0,0,,Момындықпен берілу...?
Dialogue: 0,0:05:12.34,0:05:14.51,Default,,0,0,0,,Аа, біздің мақсатымыз
Dialogue: 0,0:05:14.58,0:05:16.51,Default,,0,0,0,,Бұл тек Макидің жазасы, қылмыстық бөлім.
Dialogue: 0,0:05:17.98,0:05:19.35,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:05:19.41,0:05:22.42,Default,,0,0,0,,Біздің сізбен белсенді күресуге ниетіміз жоқ!
Dialogue: 0,0:05:22.85,0:05:23.95,Default,,0,0,0,,Ниет?
Dialogue: 0,0:05:24.35,0:05:26.62,Default,,0,0,0,,Ниет сөзінің анықтамасы
Dialogue: 0,0:05:26.89,0:05:29.42,Default,,0,0,0,,Мен саған қазір бірдеңе үйретемін.
Dialogue: 0,0:05:30.96,0:05:32.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:32.76,0:05:35.76,Default,,0,0,0,,Бұл менің ниетім
Dialogue: 0,0:05:36.36,0:05:38.37,Default,,0,0,0,,Ату!
Dialogue: 0,0:05:46.87,0:05:47.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:48.44,0:05:51.05,Default,,0,0,0,,Мен бүгін түнде бақытсызмын.
Dialogue: 0,0:05:51.81,0:05:53.01,Default,,0,0,0,,Бұл да...
Dialogue: 0,0:05:53.55,0:05:55.02,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:05:55.08,0:05:56.65,Default,,0,0,0,,Жоқ, Хару Хару!
Dialogue: 0,0:06:03.62,0:06:04.49,Default,,0,0,0,,Маки!
Dialogue: 0,0:06:04.76,0:06:06.43,Default,,0,0,0,,Джобу Маки! Қарғыс атсын!
Dialogue: 0,0:06:08.46,0:06:09.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:09.56,0:06:10.97,Default,,0,0,0,,Кешіріңіз, Харуна
Dialogue: 0,0:06:11.50,0:06:14.37,Default,,0,0,0,,Мен бұл қыздан көзімді алғанда...
Dialogue: 0,0:06:15.67,0:06:16.90,Default,,0,0,0,,Хару Хару…
Dialogue: 0,0:06:16.97,0:06:18.84,Default,,0,0,0,,Тыңда, Маки
Dialogue: 0,0:06:19.14,0:06:20.51,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:20.74,0:06:22.01,Default,,0,0,0,,Тұман...
Dialogue: 0,0:06:22.48,0:06:23.61,Default,,0,0,0,,Психикалық модель
Dialogue: 0,0:06:23.71,0:06:24.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:24.68,0:06:25.55,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:26.85,0:06:29.58,Default,,0,0,0,,Күткендей... солай болды.
Dialogue: 0,0:06:30.42,0:06:31.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:32.42,0:06:33.96,Default,,0,0,0,,Мен сені алдағым келген жоқ...
Dialogue: 0,0:06:34.46,0:06:35.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:35.42,0:06:36.39,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:42.56,0:06:43.97,Default,,0,0,0,,Маки...
Dialogue: 0,0:06:52.44,0:06:54.61,Default,,0,0,0,,Хмф! бұл қыз
Dialogue: 0,0:06:54.68,0:06:57.55,Default,,0,0,0,,Мен Харунаның тұман екенін білген бойда, бұл болды ма?
Dialogue: 0,0:06:57.91,0:06:59.91,Default,,0,0,0,,Бұл табиғи реакция.
Dialogue: 0,0:06:59.98,0:07:03.05,Default,,0,0,0,,Біздің және адамдардың бір-бірімен танысуы мүмкін емес.
Dialogue: 0,0:07:04.12,0:07:05.42,Default,,0,0,0,,Киришима
Dialogue: 0,0:07:05.59,0:07:06.49,Default,,0,0,0,,Харуна?
Dialogue: 0,0:07:07.05,0:07:08.49,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:07:08.72,0:07:11.89,Default,,0,0,0,,Сіз жай ғана Макиді қорғай аласыз ба?
Dialogue: 0,0:07:11.96,0:07:12.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:12.99,0:07:15.06,Default,,0,0,0,,Мен жауды тартамын
Dialogue: 0,0:07:15.13,0:07:19.03,Default,,0,0,0,,Осы уақытта Макимен бірге мына сарайдан қашыңыз.
Dialogue: 0,0:07:19.10,0:07:20.44,Default,,0,0,0,,Сен менің абыройымды осы лайға батырдың!
Dialogue: 0,0:07:20.97,0:07:24.54,Default,,0,0,0,,Мен Макидің қауіп-қатерге ұшырауына жол бере алмаймын.
Dialogue: 0,0:07:25.01,0:07:26.47,Default,,0,0,0,,Хмм... Дұрыс.
Dialogue: 0,0:07:26.54,0:07:27.61,Default,,0,0,0,,Мына қыздан
Dialogue: 0,0:07:27.68,0:07:30.75,Default,,0,0,0,,Жаңа оқтұмсықтың қалай жасалғанын білуіміз керек.
Dialogue: 0,0:07:30.91,0:07:31.78,Default,,0,0,0,,О
Dialogue: 0,0:07:32.08,0:07:33.82,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:07:34.12,0:07:35.02,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:07:41.96,0:07:44.79,Default,,0,0,0,,Наноматериалдардың ағымдағы мөлшері
Dialogue: 0,0:07:44.86,0:07:46.69,Default,,0,0,0,,Бұл шектеу ме?
Dialogue: 0,0:07:49.93,0:07:50.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:57.94,0:07:58.81,Default,,0,0,0,,Джобу Маки!
Dialogue: 0,0:07:58.87,0:07:59.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:00.14,0:08:02.08,Default,,0,0,0,,Шрик 2 (Екі) Мақсатты тексеріңіз!
Dialogue: 0,0:08:02.51,0:08:03.18,Default,,0,0,0,,Шабуылды бастаңыз!
Dialogue: 0,0:08:11.02,0:08:11.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:15.02,0:08:17.76,Default,,0,0,0,,Жаңа оқтұмсықтың әзірлеушісі
Dialogue: 0,0:08:17.86,0:08:21.13,Default,,0,0,0,,Джобу Тоджуро емес, Джобу Маки
Dialogue: 0,0:08:21.20,0:08:23.76,Default,,0,0,0,,Соңғы дизайн бала...
Dialogue: 0,0:08:24.53,0:08:29.07,Default,,0,0,0,,Адамзат жаңа оқтұмсықтарды жасау әдісі біздің қолымызға түседі деп қорқады.
Dialogue: 0,0:08:29.14,0:08:32.17,Default,,0,0,0,,Джобу Макиді жою туралы шешім қабылдады
Dialogue: 0,0:08:32.61,0:08:34.71,Default,,0,0,0,,Уау, сондай қатыгез~
Dialogue: 0,0:08:35.08,0:08:35.98,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:36.04,0:08:39.78,Default,,0,0,0,,Бұл адамдар үшін тамаша қозыр сияқты.
Dialogue: 0,0:08:39.85,0:08:42.08,Default,,0,0,0,,Бұл жаңа оқтұмсық дегеніміз не?
Dialogue: 0,0:08:42.15,0:08:43.25,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:43.52,0:08:44.99,Default,,0,0,0,,Сонда да, Харуна
Dialogue: 0,0:08:45.05,0:08:47.02,Default,,0,0,0,,Сонымен, ақыры уақыт келді—
Dialogue: 0,0:08:47.52,0:08:50.12,Default,,0,0,0,,Неге тікелей есеп беруге келмейсіз?
Dialogue: 0,0:08:50.83,0:08:54.23,Default,,0,0,0,,Психикалық модель Маки Гёбумен бірге аулаға қашып кетті.
Dialogue: 0,0:08:54.30,0:08:55.30,Default,,0,0,0,,Біз де сізге ереміз!
Dialogue: 0,0:08:55.56,0:08:56.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:12.21,0:09:13.55,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:09:13.61,0:09:16.78,Default,,0,0,0,,Мен бұл қызды неге қорғауым керек?
Dialogue: 0,0:09:22.19,0:09:24.89,Default,,0,0,0,,Қарғыс атсын! Олар табанды
Dialogue: 0,0:09:31.73,0:09:32.77,Default,,0,0,0,,Жығылу
Dialogue: 0,0:09:32.90,0:09:34.70,Default,,0,0,0,,Жоқ, Хару Хару!
Dialogue: 0,0:09:34.94,0:09:35.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:37.27,0:09:38.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:38.74,0:09:39.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:41.74,0:09:43.71,Default,,0,0,0,,Біз қару болып туылғанбыз.
Dialogue: 0,0:09:44.88,0:09:47.82,Default,,0,0,0,,Менің отымның астына түскендер
Dialogue: 0,0:09:47.88,0:09:50.69,Default,,0,0,0,,Мүмкін 100 немесе 200-ден төмен емес.
Dialogue: 0,0:09:51.05,0:09:52.82,Default,,0,0,0,,Осы уақытқа дейін I
Dialogue: 0,0:09:52.89,0:09:55.66,Default,,0,0,0,,Мен ештеңе сезбедім.
Dialogue: 0,0:09:56.69,0:09:58.09,Default,,0,0,0,,Со Маки
Dialogue: 0,0:09:58.69,0:10:00.03,Default,,0,0,0,,Күтілгендей, И
Dialogue: 0,0:10:00.60,0:10:03.13,Default,,0,0,0,,Мен сенің досың бола алмаймын
Dialogue: 0,0:10:03.23,0:10:04.33,Default,,0,0,0,,Харуна
Dialogue: 0,0:10:05.77,0:10:06.73,Default,,0,0,0,,Харуна Сәлем!
Dialogue: 0,0:10:06.80,0:10:08.87,Default,,0,0,0,,Сіз мені естімейсіз бе? Харуна!
Dialogue: 0,0:10:09.67,0:10:10.91,Default,,0,0,0,,Не?
Dialogue: 0,0:10:11.01,0:10:13.98,Default,,0,0,0,,Не болды? Бұл байланыс мәселесін тудырды ма?
Dialogue: 0,0:10:14.04,0:10:15.34,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:10:15.61,0:10:17.65,Default,,0,0,0,,Бұдан басқа, Маки не істеп жатыр?
Dialogue: 0,0:10:17.78,0:10:18.91,Default,,0,0,0,,(Джо Хирако) Ах! (Ирими) Ха!
Dialogue: 0,0:10:18.98,0:10:20.01,Default,,0,0,0,,О
Dialogue: 0,0:10:20.38,0:10:23.68,Default,,0,0,0,,Бірақ біраз уақыттан бері үндеген жоқ.
Dialogue: 0,0:10:24.39,0:10:26.02,Default,,0,0,0,,Сенің тұман болғаның
Dialogue: 0,0:10:26.65,0:10:28.26,Default,,0,0,0,,Сіз өте жақсы жауап берген сияқтысыз.
Dialogue: 0,0:10:31.29,0:10:33.03,Default,,0,0,0,,Не істеп жатырсың?!
Dialogue: 0,0:10:33.63,0:10:35.63,Default,,0,0,0,,Ағымдағы орын негізгі кіреберістің жанында.
Dialogue: 0,0:10:35.70,0:10:37.06,Default,,0,0,0,,Енді не істеуім керек?
Dialogue: 0,0:10:37.23,0:10:41.00,Default,,0,0,0,,Мен муляжды қолданамын және жауларды аулаға шоғырландырамын.
Dialogue: 0,0:10:41.07,0:10:44.01,Default,,0,0,0,,Бұл мүмкіндікті пайдаланып, Макимен бірге басты қақпадан қашыңыз.
Dialogue: 0,0:10:44.07,0:10:45.74,Default,,0,0,0,,Эй, бұл ұсыныс.
Dialogue: 0,0:10:45.97,0:10:48.24,Default,,0,0,0,,Камакура жағалауындағы Майядан қолдау сұрауға қалай қарайсыз?
Dialogue: 0,0:10:48.31,0:10:49.41,Default,,0,0,0,,Өзінің атыс күшімен
Dialogue: 0,0:10:49.68,0:10:51.65,Default,,0,0,0,,Әскери күштің бұл деңгейі жай сан емес, солай ма?
Dialogue: 0,0:10:52.05,0:10:53.21,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:10:53.28,0:10:54.15,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:10:54.22,0:10:58.12,Default,,0,0,0,,Майяның атыс күшімен бұл бөлімше бір сәтте жойылады.
Dialogue: 0,0:10:58.19,0:10:59.15,Default,,0,0,0,,Мәселе неде?
Dialogue: 0,0:11:00.19,0:11:02.16,Default,,0,0,0,,Маки мұны қаламайды.
Dialogue: 0,0:11:02.26,0:11:03.12,Default,,0,0,0,,(байланысты үзу дыбысы)
Dialogue: 0,0:11:03.19,0:11:04.93,Default,,0,0,0,,Сәлем, Харуна, Сәлем!
Dialogue: 0,0:11:05.93,0:11:07.76,Default,,0,0,0,,кесілген
Dialogue: 0,0:11:08.40,0:11:09.26,Default,,0,0,0,,Тіпті егер
Dialogue: 0,0:11:09.36,0:11:10.67,Default,,0,0,0,,Мына қыз
Dialogue: 0,0:11:10.90,0:11:12.83,Default,,0,0,0,,Неге қозғалмайсың?
Dialogue: 0,0:11:13.70,0:11:14.37,Default,,0,0,0,,Yotaro…
Dialogue: 0,0:11:14.90,0:11:15.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:15.94,0:11:17.14,Default,,0,0,0,,Харухару
Dialogue: 0,0:11:17.41,0:11:19.71,Default,,0,0,0,,Сіз қашып үлгердіңіз бе?
Dialogue: 0,0:11:19.77,0:11:20.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:20.91,0:11:22.88,Default,,0,0,0,,Сол қорқынышты адамдар
Dialogue: 0,0:11:23.18,0:11:26.95,Default,,0,0,0,,Мені билік ету үшін келгендіктен шығар.
Dialogue: 0,0:11:27.72,0:11:29.35,Default,,0,0,0,,Менен аулақ жүрсең
Dialogue: 0,0:11:29.42,0:11:31.69,Default,,0,0,0,,Харухару қауіпсіз болуы керек.
Dialogue: 0,0:11:31.75,0:11:32.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:32.69,0:11:35.32,Default,,0,0,0,,Мен Харухару үшін не істей аламын
Dialogue: 0,0:11:35.39,0:11:36.72,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:11:37.86,0:11:39.29,Default,,0,0,0,,Бұл қыз...
Dialogue: 0,0:11:39.43,0:11:40.86,Default,,0,0,0,,Йотаро
Dialogue: 0,0:11:40.93,0:11:42.80,Default,,0,0,0,,Мен... баяғыда
Dialogue: 0,0:11:42.86,0:11:45.40,Default,,0,0,0,,Мен бұрын бомба жасағанмын.
Dialogue: 0,0:11:46.70,0:11:49.77,Default,,0,0,0,,Оның не екенін білмей-ақ
Dialogue: 0,0:11:50.81,0:11:51.47,Default,,0,0,0,,Өйткені
Dialogue: 0,0:11:51.74,0:11:55.11,Default,,0,0,0,,Солай етсең, әкең риза болады.
Dialogue: 0,0:11:55.41,0:11:57.24,Default,,0,0,0,,Себебі сен мені мақтадың
Dialogue: 0,0:11:58.28,0:12:02.05,Default,,0,0,0,,Сондықтан мен дизайн жасау туралы ақылсыз болдым
Dialogue: 0,0:12:02.92,0:12:04.82,Default,,0,0,0,,Дірілдейтін оқтұмсық
Dialogue: 0,0:12:05.89,0:12:08.79,Default,,0,0,0,,Бірақ ол аяқталғаннан кейін
Dialogue: 0,0:12:08.96,0:12:11.43,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:12:12.49,0:12:15.10,Default,,0,0,0,,Сонымен... Сонымен...
Dialogue: 0,0:12:15.80,0:12:17.33,Default,,0,0,0,,Бомба
Dialogue: 0,0:12:17.77,0:12:18.83,Default,,0,0,0,,Тұман...
Dialogue: 0,0:12:19.20,0:12:22.77,Default,,0,0,0,,Бұл Хархару мен басқаларды өлтіруге арналған.
Dialogue: 0,0:12:25.21,0:12:27.81,Default,,0,0,0,,Сонымен... маған
Dialogue: 0,0:12:28.88,0:12:32.28,Default,,0,0,0,,Харухарумен дос болу үшін қандай талаптарды орындау керек?
Dialogue: 0,0:12:32.35,0:12:34.52,Default,,0,0,0,,Бұл басынан бері болған жоқ...
Dialogue: 0,0:12:44.02,0:12:46.89,Default,,0,0,0,,Автономды көп аяқты жауынгерлік машина «Рок краб»
Dialogue: 0,0:12:46.96,0:12:48.93,Default,,0,0,0,,Барлық көліктер кеңейтілді
Dialogue: 0,0:12:50.00,0:12:51.50,Default,,0,0,0,,Бір баланы кәдеге жарату
Dialogue: 0,0:12:51.77,0:12:54.40,Default,,0,0,0,,Мен мұндай көп ақша салуым керек деп ешқашан ойламадым.
Dialogue: 0,0:12:54.47,0:12:55.94,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:12:56.20,0:12:57.07,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:12:57.14,0:12:59.51,Default,,0,0,0,,Психикалық модель және Джобу Маки!
Dialogue: 0,0:12:59.77,0:13:00.54,Default,,0,0,0,,Ату!
Dialogue: 0,0:13:04.38,0:13:07.01,Default,,0,0,0,,Нашар өңдеу сыйымдылығының төмендеуі
Dialogue: 0,0:13:07.08,0:13:09.25,Default,,0,0,0,,Манекенді сақтау мүмкін емес
Dialogue: 0,0:13:09.78,0:13:13.05,Default,,0,0,0,,Ах! Бұл Джобу Маки емес!
Dialogue: 0,0:13:13.15,0:13:14.05,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:17.26,0:13:18.36,Default,,0,0,0,,Барлық көліктерді жабыңыз!
Dialogue: 0,0:13:18.43,0:13:21.56,Default,,0,0,0,,Әрбір бөлімшеге төтенше жағдай туралы хабарлама! Шынайы Gyobu Makie іздеңіз!
Dialogue: 0,0:13:25.40,0:13:26.93,Default,,0,0,0,,Маки...
Dialogue: 0,0:13:34.18,0:13:35.54,Default,,0,0,0,,3-ші взводтан шақыру
Dialogue: 0,0:13:35.81,0:13:36.48,Default,,0,0,0,,Есеп
Dialogue: 0,0:13:36.54,0:13:39.01,Default,,0,0,0,,Аулада психикалық модельді кім алып жүр?
Dialogue: 0,0:13:39.08,0:13:40.95,Default,,0,0,0,,Джобу Маки емес
Dialogue: 0,0:13:41.02,0:13:42.05,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:42.12,0:13:43.55,Default,,0,0,0,,Бұл күрделі манекен дейді.
Dialogue: 0,0:13:44.29,0:13:46.45,Default,,0,0,0,,Бұл жаман. Мен білген сияқтымын!
Dialogue: 0,0:13:48.82,0:13:49.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:50.02,0:13:51.56,Default,,0,0,0,,Бұл Джёбу Маки!
Dialogue: 0,0:13:52.26,0:13:53.33,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:13:58.93,0:14:01.14,Default,,0,0,0,,Не? Бұл қандай кішкентай!
Dialogue: 0,0:14:01.20,0:14:03.44,Default,,0,0,0,,Қат! Бұл дененің қолынан келмейді ғой, солай ма?
Dialogue: 0,0:14:07.98,0:14:09.11,Default,,0,0,0,,Йотаро?
Dialogue: 0,0:14:10.28,0:14:11.15,Default,,0,0,0,,Маки жат!
Dialogue: 0,0:14:11.38,0:14:12.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:17.18,0:14:18.59,Default,,0,0,0,,Йотаро Сіз сөйлей аласыз ба?
Dialogue: 0,0:14:18.85,0:14:19.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:20.15,0:14:22.89,Default,,0,0,0,,Мен... Өзім туралы кейін түсіндіремін!
Dialogue: 0,0:14:22.96,0:14:25.23,Default,,0,0,0,,Одан гөрі мына сарайдан тезірек кету...
Dialogue: 0,0:14:25.29,0:14:26.53,Default,,0,0,0,,Жоқ, не?
Dialogue: 0,0:14:27.09,0:14:29.03,Default,,0,0,0,,Бұрынғылар осылай деді
Dialogue: 0,0:14:29.10,0:14:32.10,Default,,0,0,0,,Харухару Біз қазір аулада ұрысып жатырмыз, солай ма?
Dialogue: 0,0:14:32.17,0:14:33.57,Default,,0,0,0,,О, дұрыс. Менді шілдеде көрсетілетін драмаға таңдады.
Dialogue: 0,0:14:33.63,0:14:35.04,Default,,0,0,0,,Мен барып көмектесуім керек!
Dialogue: 0,0:14:35.10,0:14:36.60,Default,,0,0,0,,Ақымақ болма! (Маки) Өйткені!
Dialogue: 0,0:14:37.27,0:14:39.04,Default,,0,0,0,,Сізді ұрысқа тарту үшін
Dialogue: 0,0:14:39.11,0:14:40.91,Default,,0,0,0,,Бұл Харунаға ұнайды деп ойлайсыз ба?
Dialogue: 0,0:14:41.18,0:14:42.58,Default,,0,0,0,,Ха... Бірақ!
Dialogue: 0,0:14:43.48,0:14:44.38,Default,,0,0,0,,Барлық бөлімшелерге хабарлаңыз
Dialogue: 0,0:14:45.18,0:14:46.25,Default,,0,0,0,,Мақсаттарыңызды тексеріңіз
Dialogue: 0,0:14:46.61,0:14:48.58,Default,,0,0,0,,Ілеспе психикалық модельмен
Dialogue: 0,0:14:48.88,0:14:50.25,Default,,0,0,0,,Дереу бейтараптандырыңыз
Dialogue: 0,0:14:50.32,0:14:51.19,Default,,0,0,0,,Сол жақтағы адам бәрін егжей-тегжейлі түсіндіреді. Содан кейін оның нұсқауларын орындаңыз
Dialogue: 0,0:14:51.29,0:14:53.15,Default,,0,0,0,,Дереу бейтараптандырыңыз
Dialogue: 0,0:14:58.99,0:15:02.46,Default,,0,0,0,,Мен Харуна тұманға қарсы соғыс кемесімін.
Dialogue: 0,0:15:02.66,0:15:03.66,Default,,0,0,0,,Тек күресу үшін
Dialogue: 0,0:15:04.40,0:15:06.17,Default,,0,0,0,,Менің бар болу себебім
Dialogue: 0,0:15:08.47,0:15:09.90,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:10.14,0:15:12.54,Default,,0,0,0,,Макиді қорғауға тырысу
Dialogue: 0,0:15:12.61,0:15:15.38,Default,,0,0,0,,Дірілдейтін оқтұмсықтардың жасалу жолдарын білу
Dialogue: 0,0:15:16.18,0:15:17.38,Default,,0,0,0,,Осымен
Dialogue: 0,0:15:21.08,0:15:22.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:22.92,0:15:23.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:28.69,0:15:30.02,Default,,0,0,0,,Бірақ
Dialogue: 0,0:15:30.32,0:15:31.63,Default,,0,0,0,,Неліктен мен
Dialogue: 0,0:15:31.69,0:15:34.30,Default,,0,0,0,,Мына жігіттерді өлтіре алмайсың ба?
Dialogue: 0,0:15:35.26,0:15:36.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:36.70,0:15:39.47,Default,,0,0,0,,Менің ішімде не айналып тұр?
Dialogue: 0,0:15:39.53,0:15:41.27,Default,,0,0,0,,Хару Хару! тістер!
Dialogue: 0,0:15:43.44,0:15:44.34,Default,,0,0,0,,Хару Хару!
Dialogue: 0,0:15:44.51,0:15:45.37,Default,,0,0,0,,Маки!
Dialogue: 0,0:15:47.37,0:15:49.18,Default,,0,0,0,,Джобу Маки табылды!
Dialogue: 0,0:15:52.51,0:15:53.38,Default,,0,0,0,,Маки!
Dialogue: 0,0:15:57.02,0:16:00.29,Default,,0,0,0,,Маған ұнамайды! Мен оны ұнатпаймын!
Dialogue: 0,0:16:01.02,0:16:04.02,Default,,0,0,0,,Мен... Менмін!
Dialogue: 0,0:16:04.33,0:16:06.36,Default,,0,0,0,,Мен Макиді жоғалтқым келмейді!
Dialogue: 0,0:16:06.56,0:16:07.59,Default,,0,0,0,,Ату!
Dialogue: 0,0:16:21.31,0:16:22.54,Default,,0,0,0,,Хару Хару…
Dialogue: 0,0:16:25.31,0:16:27.35,Default,,0,0,0,,Маки сен не үшін келдің?
Dialogue: 0,0:16:27.41,0:16:28.52,Default,,0,0,0,,Мен... (Маки) Маған ұнамайды!
Dialogue: 0,0:16:29.05,0:16:30.55,Default,,0,0,0,,Күтілгендей, И
Dialogue: 0,0:16:31.35,0:16:33.19,Default,,0,0,0,,Мен Харухаруды жақсы көремін!
Dialogue: 0,0:16:36.99,0:16:39.53,Default,,0,0,0,,Мен... тұманмын.
Dialogue: 0,0:16:39.59,0:16:41.30,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:16:41.70,0:16:45.00,Default,,0,0,0,,Мен бұл бомбаны жасадым
Dialogue: 0,0:16:45.20,0:16:48.30,Default,,0,0,0,,Харухару мені кешірмейді.
Dialogue: 0,0:16:50.30,0:16:51.31,Default,,0,0,0,,Маки… суреті
Dialogue: 0,0:16:54.51,0:16:56.74,Default,,0,0,0,,Бірақ жоқ.
Dialogue: 0,0:16:57.31,0:16:59.48,Default,,0,0,0,,Харухару менің досым.
Dialogue: 0,0:17:01.12,0:17:03.75,Default,,0,0,0,,Достарды жоғалту...
Dialogue: 0,0:17:04.49,0:17:05.59,Default,,0,0,0,,Мен оны жек көремін...
Dialogue: 0,0:17:06.09,0:17:07.25,Default,,0,0,0,,Маки
Dialogue: 0,0:17:13.29,0:17:14.80,Default,,0,0,0,,Хару Хару! Қарғыс атқыр...
Dialogue: 0,0:17:17.77,0:17:18.70,Default,,0,0,0,,(Кёсукэ) Дұрыс айтасың, Миямура-кун! (Миямура) Иә?
Dialogue: 0,0:17:18.77,0:17:22.04,Default,,0,0,0,,Жинақталған энергия уақытында бөлінбейді
Dialogue: 0,0:17:22.24,0:17:24.54,Default,,0,0,0,,Наноматериалдар аз ғана қалды.
Dialogue: 0,0:17:24.71,0:17:27.24,Default,,0,0,0,,Осылай жүре берсең, амалсыз кірісесің!
Dialogue: 0,0:17:27.64,0:17:28.64,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:17:28.71,0:17:31.58,Default,,0,0,0,,Бұл шаяндардың барлығы өздерінің бастапқы денелері болғанша істей алады!
Dialogue: 0,0:17:31.65,0:17:34.05,Default,,0,0,0,,Мен бәріңді бір сәтте қуамын!
Dialogue: 0,0:17:34.78,0:17:36.28,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:17:36.82,0:17:38.25,Default,,0,0,0,,Маған
Dialogue: 0,0:17:38.55,0:17:40.69,Default,,0,0,0,,Макиді қорғай алмаймыз ба?
Dialogue: 0,0:17:43.66,0:17:45.23,Default,,0,0,0,,Кез келген адам жақсы.
Dialogue: 0,0:17:45.56,0:17:46.76,Default,,0,0,0,,Ол соншалықты керемет пианист болса да—
Dialogue: 0,0:17:47.19,0:17:49.60,Default,,0,0,0,,Біреу маған күш-қуатыңызды беріңізші
Dialogue: 0,0:17:50.46,0:17:52.07,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:17:53.10,0:17:54.33,Default,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:17:58.27,0:17:59.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:01.24,0:18:03.24,Default,,0,0,0,,Не? не болып жатыр?
Dialogue: 0,0:18:03.31,0:18:06.08,Default,,0,0,0,,Жартас шаяндары бірінен соң бірі жойылуда!
Dialogue: 0,0:18:06.15,0:18:06.81,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:14.25,0:18:15.72,Default,,0,0,0,,401
Dialogue: 0,0:18:18.46,0:18:19.33,Default,,0,0,0,,Сканерлеу аяқталды
Dialogue: 0,0:18:20.33,0:18:21.70,Default,,0,0,0,,Биологиялық реакция жоқ
Dialogue: 0,0:18:21.76,0:18:23.53,Default,,0,0,0,,Жарайды, қолыңнан келгенше әрекет ет!
Dialogue: 0,0:18:23.86,0:18:25.60,Default,,0,0,0,,Бар күшіңізбен жасаңыз
Dialogue: 0,0:18:36.48,0:18:39.68,Default,,0,0,0,,Харуна, сен мұндай жерде не істеп жүрсің?
Dialogue: 0,0:18:40.81,0:18:42.82,Default,,0,0,0,,I... I
Dialogue: 0,0:18:44.25,0:18:46.65,Default,,0,0,0,,Біз Makie қолданамыз...
Dialogue: 0,0:18:47.25,0:18:48.86,Default,,0,0,0,,Достарыңызды қорғау
Dialogue: 0,0:18:50.16,0:18:51.29,Default,,0,0,0,,Иә
Dialogue: 0,0:18:51.36,0:18:52.79,Default,,0,0,0,,Олай болса, мен саған көмектесемін.
Dialogue: 0,0:18:54.19,0:18:55.63,Default,,0,0,0,,Иона координаталарын тексеріңіз
Dialogue: 0,0:18:56.33,0:18:58.23,Default,,0,0,0,,Қоршаған орта деректері келді
Dialogue: 0,0:18:58.30,0:18:59.63,Default,,0,0,0,,Монитордағы дисплей
Dialogue: 0,0:19:01.40,0:19:04.20,Default,,0,0,0,,Жарайды, биологиялық реакцияларды болдырмай шабуыл жасаңыз.
Dialogue: 0,0:19:04.27,0:19:06.77,Default,,0,0,0,,Біз тек айналадағы ұшқышсыз қаруларды ғана жоямыз.
Dialogue: 0,0:19:07.31,0:19:08.54,Default,,0,0,0,,Капитан
Dialogue: 0,0:19:08.61,0:19:10.31,Default,,0,0,0,,Маған вице-министрдің көмекшісі Камиин қоңырау шалды.
Dialogue: 0,0:19:10.91,0:19:12.55,Default,,0,0,0,,Мені қосыңыз
Dialogue: 0,0:19:14.15,0:19:17.15,Default,,0,0,0,,Сіз не істеп жатырсыз? Чихая Гунзо
Dialogue: 0,0:19:17.32,0:19:18.72,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:19:19.22,0:19:22.52,Default,,0,0,0,,Әскерді жау ету ниетің бар ма?
Dialogue: 0,0:19:23.49,0:19:25.93,Default,,0,0,0,,Біз әскери емеспіз
Dialogue: 0,0:19:26.36,0:19:28.20,Default,,0,0,0,,Сіз сұраған нәрсе
Dialogue: 0,0:19:28.26,0:19:32.43,Default,,0,0,0,,Сеніп тапсырылған дірілдейтін оқтұмсықты Америка Құрама Штаттарына тасымалдау
Dialogue: 0,0:19:32.80,0:19:34.33,Default,,0,0,0,,Тағдырымыз өріліп-үйлессін
Dialogue: 0,0:19:34.84,0:19:37.80,Default,,0,0,0,,Одан басқа қалағаныңды істе...
Dialogue: 0,0:19:37.87,0:19:38.87,Default,,0,0,0,,Иә
Dialogue: 0,0:19:38.94,0:19:43.28,Default,,0,0,0,,Сіз үлкен қателік жасағыңыз келе ме?
Dialogue: 0,0:19:43.48,0:19:44.34,Default,,0,0,0,,(байланысты үзу дыбысы)
Dialogue: 0,0:19:45.55,0:19:46.68,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:19:46.75,0:19:48.48,Default,,0,0,0,,Кёхэй, жарқырап көрсет.
Dialogue: 0,0:19:48.55,0:19:49.55,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:19:57.69,0:19:59.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:59.63,0:20:01.83,Default,,0,0,0,,Жартас крабының 80% жойылды!
Dialogue: 0,0:20:02.23,0:20:04.60,Default,,0,0,0,,Жоқ! Жағдайды бұдан былай сақтау мүмкін емес!
Dialogue: 0,0:20:04.67,0:20:05.93,Default,,0,0,0,,Барлық бөлімшелерге хабарлаңыз!
Dialogue: 0,0:20:06.20,0:20:07.73,Default,,0,0,0,,Барлық мүшелер шығып кетеді!
Dialogue: 0,0:20:09.27,0:20:10.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:12.74,0:20:15.24,Default,,0,0,0,,Мен... Психикалық үлгі!
Dialogue: 0,0:20:15.61,0:20:16.98,Default,,0,0,0,,Те... шегіну!
Dialogue: 0,0:20:17.44,0:20:18.78,Default,,0,0,0,,Шегін!
Dialogue: 0,0:20:21.85,0:20:23.95,Default,,0,0,0,,Ұрыстың соңы
Dialogue: 0,0:20:30.26,0:20:31.73,Default,,0,0,0,,Мен сиқыр жасаймын.
Dialogue: 0,0:20:32.53,0:20:33.39,Default,,0,0,0,,Хаа…
Dialogue: 0,0:20:33.46,0:20:35.63,Default,,0,0,0,,Бұл Хару Хару.
Dialogue: 0,0:20:38.33,0:20:39.87,Default,,0,0,0,,Мен, мен…
Dialogue: 0,0:20:39.97,0:20:41.37,Default,,0,0,0,,Маки
Dialogue: 0,0:20:43.00,0:20:44.40,Default,,0,0,0,,Хархару?
Dialogue: 0,0:20:45.34,0:20:46.54,Default,,0,0,0,,Маки
Dialogue: 0,0:20:47.24,0:20:47.91,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:20:49.28,0:20:51.58,Default,,0,0,0,,Тағы да менімен бірге...
Dialogue: 0,0:20:53.41,0:20:56.42,Default,,0,0,0,,Бізбен дос боласың ба?
Dialogue: 0,0:20:56.48,0:20:57.95,Default,,0,0,0,,Ех! мен де?
Dialogue: 0,0:20:58.45,0:20:59.69,Default,,0,0,0,,Хару Хару…
Dialogue: 0,0:21:02.66,0:21:03.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:19.91,0:21:21.61,Default,,0,0,0,,401
Dialogue: 0,0:21:23.54,0:21:24.61,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:21:25.01,0:21:26.88,Default,,0,0,0,,Маған көмектестіңіз бе?
Dialogue: 0,0:21:28.68,0:21:30.88,Default,,0,0,0,,Себебі мен Харунаның дауысын естідім
Dialogue: 0,0:21:31.49,0:21:32.45,Default,,0,0,0,,Не?
Dialogue: 0,0:21:32.75,0:21:34.49,Default,,0,0,0,,«Маған көмектес»
Dialogue: 0,0:21:34.55,0:21:36.29,Default,,0,0,0,,Сондықтан мен көмекке келдім.
Dialogue: 0,0:21:36.36,0:21:37.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:39.49,0:21:40.63,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:41.06,0:21:42.56,Default,,0,0,0,,Ел көлеміндегі ең ізденетін Зұлымдар Альянсы
Dialogue: 0,0:21:42.93,0:21:45.00,Default,,0,0,0,,Хмф! 401
Dialogue: 0,0:21:45.07,0:21:46.90,Default,,0,0,0,,Ең алдымен мен сізге алғыс айтқым келеді.
Dialogue: 0,0:21:46.97,0:21:49.47,Default,,0,0,0,,Жаулары көп, тіпті біз де...
Dialogue: 0,0:21:49.90,0:21:51.91,Default,,0,0,0,,Кім? Бұл Киришима!
Dialogue: 0,0:21:52.61,0:21:54.81,Default,,0,0,0,,Бұл Гунзо Чихая емес пе еді?
Dialogue: 0,0:21:54.88,0:21:57.31,Default,,0,0,0,,Енді қайда бара жатырсың?
Dialogue: 0,0:21:59.81,0:22:01.88,Default,,0,0,0,,Бұл біздің негізгі базамыз.
Dialogue: 0,0:22:17.46,0:22:18.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:24.40,0:22:25.94,Default,,0,0,0,,Бірақ… сен балаларды осыған араластырып, қуанатын адам емес едің ғой!!
Dialogue: 0,0:22:26.44,0:22:27.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:27.57,0:22:28.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:29.38,0:22:31.65,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:22:33.05,0:22:34.61,Default,,0,0,0,,Такао~
Dialogue: 0,0:22:35.02,0:22:36.75,Default,,0,0,0,,Сіз
Dialogue: 0,0:22:37.05,0:22:39.52,Default,,0,0,0,,Сен не үшін келдің?
Dialogue: 0,0:22:40.49,0:22:46.49,Default,,0,0,0,,♪～
Dialogue: 0,0:24:03.10,0:24:09.11,Default,,0,0,0,,～♪
