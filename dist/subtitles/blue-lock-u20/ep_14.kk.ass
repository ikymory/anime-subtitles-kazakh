Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.55,0:00:18.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:18.47,0:00:20.39,Default,,0,0,0,,Жиренішті!
Dialogue: 0,0:00:21.68,0:00:23.98,Default,,0,0,0,,Мен тәртіпсіздік жасаймын!
Dialogue: 0,0:00:24.98,0:00:27.15,Default,,0,0,0,,Енді соңғы екі минут өтті!
Dialogue: 0,0:00:27.23,0:00:29.65,Default,,0,0,0,,Соңғы қарсы шабуыл басталады!
Dialogue: 0,0:00:30.19,0:00:31.40,Default,,0,0,0,,Ал...
Dialogue: 0,0:00:31.48,0:00:34.61,Default,,0,0,0,,Мен осы қарсы аяқтағанша шабуылдағым келеді.
Dialogue: 0,0:00:35.28,0:00:37.32,Default,,0,0,0,,Ең тиімді бағыт...
Dialogue: 0,0:00:38.28,0:00:40.49,Default,,0,0,0,,Қайсысын істеуім керек?
Dialogue: 0,0:00:42.29,0:00:44.16,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:00:44.25,0:00:46.33,Default,,0,0,0,,- (Рин) Хаха... - (Хёори) Рин-кун!?
Dialogue: 0,0:00:46.42,0:00:47.25,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:47.33,0:00:48.38,Default,,0,0,0,,О, Бакусу
Dialogue: 0,0:00:48.46,0:00:49.50,Default,,0,0,0,,Рин-чан?
Dialogue: 0,0:00:51.05,0:00:52.17,Default,,0,0,0,,Қап!
Dialogue: 0,0:00:52.76,0:00:54.67,Default,,0,0,0,,Кек алу дегеніміз не?
Dialogue: 0,0:00:54.76,0:00:56.38,Default,,0,0,0,,Бәсекелес дегеніміз не?
Dialogue: 0,0:00:56.93,0:00:59.01,Default,,0,0,0,,Қандай ағайын!
Dialogue: 0,0:00:59.60,0:01:02.72,Default,,0,0,0,,Мені байлағанның бәрі жиіркенішті.
Dialogue: 0,0:01:02.81,0:01:03.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:04.02,0:01:05.64,Default,,0,0,0,,Я...
Dialogue: 0,0:01:07.40,0:01:09.40,Default,,0,0,0,,Олардың барлығын өлтіріңіз
Dialogue: 0,0:01:16.07,0:01:18.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:19.53,0:01:21.45,Default,,0,0,0,,Кеттік, Рин! Комбинацияны қолданыңыз...
Dialogue: 0,0:01:22.74,0:01:24.54,Default,,0,0,0,,А, сыртта!?
Dialogue: 0,0:01:24.62,0:01:27.17,Default,,0,0,0,,Бұл есептегіш!? Неге тар жақта...
Dialogue: 0,0:01:28.08,0:01:30.29,Default,,0,0,0,,Сіз жол бойы келдіңіз бе?
Dialogue: 0,0:01:30.38,0:01:32.59,Default,,0,0,0,,Тілің байланып қалды. Жаман мінез.
Dialogue: 0,0:01:33.05,0:01:34.55,Default,,0,0,0,,Өл, кішкентайым.
Dialogue: 0,0:01:35.26,0:01:37.09,Default,,0,0,0,,Сіздің қаруыңыз...
Dialogue: 0,0:01:37.18,0:01:38.51,Default,,0,0,0,,Жылдамдық
Dialogue: 0,0:01:38.97,0:01:40.93,Default,,0,0,0,,Индукциялық үдеу күші
Dialogue: 0,0:01:42.56,0:01:44.39,Default,,0,0,0,,Қарсы бағытта үдеумен...
Dialogue: 0,0:01:45.18,0:01:46.39,Default,,0,0,0,,Оны жойыңыз!
Dialogue: 0,0:01:46.48,0:01:47.77,Default,,0,0,0,,Әй!?
Dialogue: 0,0:01:47.85,0:01:50.31,Default,,0,0,0,,Мына жігіт бұлай төбелесе де алмайды!?
Dialogue: 0,0:01:50.40,0:01:52.19,Default,,0,0,0,,Бұл тәртіпсіздік
Dialogue: 0,0:01:52.27,0:01:56.95,Default,,0,0,0,,Риннің өткенінен мүлде басқа, ұтымдылықтан алыс қадам.
Dialogue: 0,0:01:57.03,0:01:58.91,Default,,0,0,0,,Сіз нені айтасыз!?
Dialogue: 0,0:01:58.99,0:01:59.86,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:00.32,0:02:02.99,Default,,0,0,0,,Не? Келесі боласың ба?
Dialogue: 0,0:02:03.79,0:02:06.83,Default,,0,0,0,,Солардың бәрін өлтір, татуировка жасаған бейбақ.
Dialogue: 0,0:02:07.37,0:02:09.42,Default,,0,0,0,,Сіздің қаруыңыз жасырын
Dialogue: 0,0:02:10.08,0:02:12.38,Default,,0,0,0,,Сахнаңызды алыңыз...
Dialogue: 0,0:02:13.17,0:02:15.55,Default,,0,0,0,,Айналып мені өлтір!
Dialogue: 0,0:02:15.63,0:02:16.80,Default,,0,0,0,,Оларды колоданың басынан бастап ретімен оқып шығамын
Dialogue: 0,0:02:16.88,0:02:20.68,Default,,0,0,0,,Бізді бетпе-бет шайқаста жеңу үшін өз күштеріңізді пайдалануға батылыңыз бар ма?
Dialogue: 0,0:02:20.76,0:02:23.68,Default,,0,0,0,,Қандай тәкаппар, сараң стиль
Dialogue: 0,0:02:23.76,0:02:26.02,Default,,0,0,0,,Крест! Шығу!
Dialogue: 0,0:02:26.10,0:02:26.98,Default,,0,0,0,,Міне!
Dialogue: 0,0:02:27.06,0:02:29.94,Default,,0,0,0,,Маған орындауға рұқсат етіңіз! Сіз мені оңайлықпен шығара алмайсыз
Dialogue: 0,0:02:30.02,0:02:31.40,Default,,0,0,0,,А...
Dialogue: 0,0:02:32.65,0:02:35.02,Default,,0,0,0,,Кері айналмау үшін қолдың қозғалысы
Dialogue: 0,0:02:35.11,0:02:37.94,Default,,0,0,0,,Бұл позициядан, бұл артқы өкшелі қақпан ба?
Dialogue: 0,0:02:38.49,0:02:40.36,Default,,0,0,0,,Екінші жау жеңілді
Dialogue: 0,0:02:40.45,0:02:41.91,Default,,0,0,0,,Гуча Гуча
Dialogue: 0,0:02:41.99,0:02:43.37,Default,,0,0,0,,Байқап көріңіз, қарғыс атсын!
Dialogue: 0,0:02:43.45,0:02:45.99,Default,,0,0,0,,Сатылған ұрыс – мәміле!
Dialogue: 0,0:02:46.08,0:02:47.95,Default,,0,0,0,,Үшінші дене
Dialogue: 0,0:02:48.04,0:02:52.75,Default,,0,0,0,,Негізгі қозғалтқышы магистраль болып табылатын физикалық баспасөз миының бұлшық еті ақымақ
Dialogue: 0,0:02:53.25,0:02:55.84,Default,,0,0,0,,колоссты өлтіру
Dialogue: 0,0:02:55.92,0:03:00.22,Default,,0,0,0,,Оны Теме жақсы білетін баспасөз дуэліне әкеліп, тамақтандырыңыз.
Dialogue: 0,0:03:00.30,0:03:03.64,Default,,0,0,0,,Бұл жігіт мені әдейі қуып жіберді!
Dialogue: 0,0:03:04.60,0:03:08.31,Default,,0,0,0,,Бірақ менің дене күшімнің алдында кішігірім айлалар түкке тұрғысыз.
Dialogue: 0,0:03:08.39,0:03:10.27,Default,,0,0,0,,Доберманды айыптау!
Dialogue: 0,0:03:12.52,0:03:14.44,Default,,0,0,0,,Жоғары басы
Dialogue: 0,0:03:14.52,0:03:15.90,Default,,0,0,0,,Айнал, қария.
Dialogue: 0,0:03:16.90,0:03:19.24,Default,,0,0,0,,Ауырлық центрі толық жарылды!
Dialogue: 0,0:03:19.32,0:03:20.45,Default,,0,0,0,,Хе-хе… Уф
Dialogue: 0,0:03:20.53,0:03:25.70,Default,,0,0,0,,Бұл жігіт менің асығыс күшімді пайдаланып, мені төменгі нүктеден басып тастады.
Dialogue: 0,0:03:25.78,0:03:26.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:26.91,0:03:28.70,Default,,0,0,0,,Ой, ысқырық жоқ!
Dialogue: 0,0:03:28.79,0:03:29.95,Default,,0,0,0,,Қате дерлік!
Dialogue: 0,0:03:30.04,0:03:31.50,Default,,0,0,0,,Ринді басып озыңыз!
Dialogue: 0,0:03:31.58,0:03:34.25,Default,,0,0,0,,Өзіңіз өтпейтін қорғаныс шебін бұзыңыз!
Dialogue: 0,0:03:34.71,0:03:35.75,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:03:35.84,0:03:37.50,Default,,0,0,0,,Бұл ол ма?
Dialogue: 0,0:03:38.25,0:03:41.38,Default,,0,0,0,,Қарсыластың ең күшті қаруын алып шығу
Dialogue: 0,0:03:41.47,0:03:44.39,Default,,0,0,0,,Ең басты мақсаты оны жою болып табылатын пьеса.
Dialogue: 0,0:03:45.39,0:03:49.27,Default,,0,0,0,,Рин Итоши, бұл сіздің ағыныңыз ба?
Dialogue: 0,0:03:50.10,0:03:52.52,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:03:53.39,0:03:55.98,Default,,0,0,0,,Бұл мен білмеймін Рин.
Dialogue: 0,0:03:58.48,0:04:02.07,Default,,0,0,0,,«Әдемі жойылған» Итоши Саенің футболы керісінше.
Dialogue: 0,0:04:03.57,0:04:07.53,Default,,0,0,0,,Жаудың ең жақсысын әшкерелейтін және оны «ұсқынсыз жойатын» футбол!
Dialogue: 0,0:04:08.45,0:04:10.45,Default,,0,0,0,,Бұл сіздің эгоңыз ба?
Dialogue: 0,0:04:10.54,0:04:14.50,Default,,0,0,0,,Сенің сексуалдылығың бұзылған, данышпан інім.
Dialogue: 0,0:04:15.08,0:04:16.71,Default,,0,0,0,,Тағы бір дене
Dialogue: 0,0:04:17.88,0:04:19.92,Default,,0,0,0,,Оны тәртіпсіздікке айналдырыңыз
Dialogue: 0,0:04:20.92,0:04:24.13,Default,,0,0,0,,Мені байланыстыратынның бәрін сындырыңыз
Dialogue: 0,0:04:24.22,0:04:25.39,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,0:04:26.30,0:04:28.81,Default,,0,0,0,,Мен осы мақсатпен қайта туамын
Dialogue: 0,0:04:28.89,0:04:30.35,Default,,0,0,0,,Тағы бір дене
Dialogue: 0,0:04:30.43,0:04:33.48,Default,,0,0,0,,Өлтір! өлтір! Корос!
Dialogue: 0,0:04:34.02,0:04:36.65,Default,,0,0,0,,Мақсатқа дейін 28 метрден сәл артық
Dialogue: 0,0:04:36.73,0:04:38.44,Default,,0,0,0,,Мен тапсырсам бітеді.
Dialogue: 0,0:04:39.02,0:04:41.28,Default,,0,0,0,,Бұл жерде уақытты ұтқан дұрыс
Dialogue: 0,0:04:41.99,0:04:44.49,Default,,0,0,0,,Шандырады, соңғы жол
Dialogue: 0,0:04:45.20,0:04:48.24,Default,,0,0,0,,Менің ішімдегі деректерді жаңартыңыз.
Dialogue: 0,0:04:49.03,0:04:50.45,Default,,0,0,0,,«Жылдамдық» ретрограды
Dialogue: 0,0:04:50.54,0:04:52.20,Default,,0,0,0,,«Құпия кері» жолын кесу
Dialogue: 0,0:04:52.29,0:04:54.41,Default,,0,0,0,,Және «ядро» коллапс
Dialogue: 0,0:04:55.12,0:04:57.88,Default,,0,0,0,,Әлбетте, бір кезең... жоқ, бірнеше кезең—
Dialogue: 0,0:04:58.42,0:05:01.71,Default,,0,0,0,,Агрессивті және қатыгез ойын стиліндегі өзгерістер
Dialogue: 0,0:05:02.38,0:05:04.67,Default,,0,0,0,,Қызықты Рин Итоши
Dialogue: 0,0:05:04.76,0:05:06.97,Default,,0,0,0,,Мен бар нәрседен асып түсуге тырыс!
Dialogue: 0,0:05:10.93,0:05:12.56,Default,,0,0,0,,​​О?
Dialogue: 0,0:05:12.64,0:05:14.77,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:05:15.77,0:05:16.98,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:05:18.23,0:05:20.69,Default,,0,0,0,,Тіпті мен жеңе алмаймын!
Dialogue: 0,0:05:21.27,0:05:23.40,Default,,0,0,0,,Веро Рин сияқты
Dialogue: 0,0:05:23.48,0:05:27.36,Default,,0,0,0,,Бұл эго - ең жақсы және МАХАББАТ жасушасы!
Dialogue: 0,0:05:28.11,0:05:30.91,Default,,0,0,0,,Жарайды, мен сені басты кейіпкер болуға рұқсат етпеймін.
Dialogue: 0,0:05:30.99,0:05:32.49,Default,,0,0,0,,Шидо! жақсы!
Dialogue: 0,0:05:33.29,0:05:34.45,Default,,0,0,0,,Жағдай...
Dialogue: 0,0:05:34.54,0:05:36.50,Default,,0,0,0,,Жеңіске жету мүмкіндігі қайта жазылады!
Dialogue: 0,0:05:37.50,0:05:38.67,Default,,0,0,0,,Күту керек пе?
Dialogue: 0,0:05:38.75,0:05:41.38,Default,,0,0,0,,Жоқ, егер мен бұл сәтті қашып құтылсам, ол жоғалады!
Dialogue: 0,0:05:41.46,0:05:44.09,Default,,0,0,0,,Тағдырыңды қағып алсаң болды.
Dialogue: 0,0:05:46.42,0:05:47.34,Default,,0,0,0,,Екі рет басыңыз!
Dialogue: 0,0:05:49.14,0:05:51.64,Default,,0,0,0,,Рин Сезіңіз! Маған қара!
Dialogue: 0,0:05:51.72,0:05:53.47,Default,,0,0,0,,Цк…чоро адам
Dialogue: 0,0:05:53.56,0:05:55.85,Default,,0,0,0,,Бұл қауіпті. Қазір тапсырсам...
Dialogue: 0,0:05:58.60,0:06:00.98,Default,,0,0,0,,Менің мүмкіндігімді шектеме!
Dialogue: 0,0:06:01.65,0:06:04.44,Default,,0,0,0,,Маған жабыспа, қарғыс атқыр Джи!
Dialogue: 0,0:06:05.99,0:06:08.36,Default,,0,0,0,,Коросты жою
Dialogue: 0,0:06:08.45,0:06:10.66,Default,,0,0,0,,Сіз сол қалыпта ата аласыз ба!?
Dialogue: 0,0:06:10.74,0:06:12.24,Default,,0,0,0,,Міне, Рин!
Dialogue: 0,0:06:12.33,0:06:16.00,Default,,0,0,0,,№11 шу бұл жігітке қиял береді.
Dialogue: 0,0:06:16.45,0:06:20.42,Default,,0,0,0,,Ескерту аймағына жеткенше!
Dialogue: 0,0:06:22.63,0:06:24.30,Default,,0,0,0,,Финтті ату!?
Dialogue: 0,0:06:25.84,0:06:27.13,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:06:27.88,0:06:29.63,Default,,0,0,0,,Мен оны әлі бұза алмаймын!
Dialogue: 0,0:06:30.09,0:06:32.10,Default,,0,0,0,,Мен тәртіпсіздік жасаймын
Dialogue: 0,0:06:32.89,0:06:34.56,Default,,0,0,0,,Барлығы!
Dialogue: 0,0:06:34.64,0:06:36.27,Default,,0,0,0,,Бұзып көріңіз!
Dialogue: 0,0:06:36.72,0:06:40.23,Default,,0,0,0,,Осы елді өзгертетін шабуылшы сен болсаң!
Dialogue: 0,0:06:41.02,0:06:42.06,Default,,0,0,0,,Өту
Dialogue: 0,0:06:44.86,0:06:45.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:46.82,0:06:47.86,Default,,0,0,0,,Ннн!
Dialogue: 0,0:06:57.20,0:06:58.25,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:59.83,0:07:01.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:01.29,0:07:02.71,Default,,0,0,0,,Я...
Dialogue: 0,0:07:08.63,0:07:10.76,Default,,0,0,0,,Әлі де жылы
Dialogue: 0,0:07:11.43,0:07:12.55,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:12.64,0:07:15.93,Default,,0,0,0,,Жапония!Жапония!
Dialogue: 0,0:07:16.01,0:07:19.48,Default,,0,0,0,,Жапония!Жапония!
Dialogue: 0,0:07:19.56,0:07:22.56,Default,,0,0,0,,Жапония!Жапония!
Dialogue: 0,0:07:24.44,0:07:25.61,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:25.69,0:07:28.86,Default,,0,0,0,,Жапония!Жапония!
Dialogue: 0,0:07:28.94,0:07:33.32,Default,,0,0,0,,Жапония! Жапония! Жапония!
Dialogue: 0,0:07:35.87,0:07:37.74,Default,,0,0,0,,Қосымша уақыт – 1 минут!
Dialogue: 0,0:07:37.83,0:07:39.00,Default,,0,0,0,,Доп - Сае Итоши!
Dialogue: 0,0:07:39.08,0:07:40.50,Default,,0,0,0,,Уақыт өтіп жатыр!
Dialogue: 0,0:07:40.58,0:07:42.25,Default,,0,0,0,,Бұл соңғы пьеса ма?
Dialogue: 0,0:07:42.83,0:07:44.46,Default,,0,0,0,,Өте ыстық болуға кепілдік беріледі!
Dialogue: 0,0:07:45.71,0:07:46.54,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:07:46.63,0:07:47.46,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:07:47.55,0:07:48.42,Default,,0,0,0,,Соңғы бір ойын!
Dialogue: 0,0:07:48.50,0:07:50.38,Default,,0,0,0,,- (Райнчи) Қайт, Көк жар! - (Нанасей) Тоқта! Тоқта!
Dialogue: 0,0:07:50.47,0:07:51.67,Default,,0,0,0,,- (Футако) Жүгір! -(Отойя) Жүгір!
Dialogue: 0,0:07:51.76,0:07:54.14,Default,,0,0,0,,Өлсең де қорға!
Dialogue: 0,0:07:54.22,0:07:57.22,Default,,0,0,0,,Егер мен оны алып кетсем, бұл үлкен мүмкіндік
Dialogue: 0,0:07:57.31,0:07:58.39,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:07:58.47,0:07:59.56,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:08:03.90,0:08:04.85,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:04.94,0:08:06.90,Default,,0,0,0,,Жоқ, мен осындамын!
Dialogue: 0,0:08:10.07,0:08:11.44,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:08:11.53,0:08:14.57,Default,,0,0,0,,Асықпаңдар, ақымақтар! Мен саған уақыт сатып аламын!
Dialogue: 0,0:08:14.66,0:08:15.99,Default,,0,0,0,,Адамдар жеткіліксіз!
Dialogue: 0,0:08:16.49,0:08:18.33,Default,,0,0,0,,Штаттан тыс жұмысшы жігіт, абай бол!
Dialogue: 0,0:08:18.41,0:08:20.20,Default,,0,0,0,,Мұнда ұпай жинасаң, бітті!
Dialogue: 0,0:08:20.29,0:08:21.62,Default,,0,0,0,,Жеңеміз!
Dialogue: 0,0:08:21.70,0:08:22.83,Default,,0,0,0,,- (Мару) Чий! -(Наги) Раджа!
Dialogue: 0,0:08:35.80,0:08:39.18,Default,,0,0,0,,Корос қирату
Dialogue: 0,0:08:43.06,0:08:45.31,Default,,0,0,0,,Мен шеше алмадым...
Dialogue: 0,0:08:45.39,0:08:46.69,Default,,0,0,0,,Сіздің шектеулеріңіз
Dialogue: 0,0:08:47.52,0:08:50.78,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын басын.
Dialogue: 0,0:08:51.94,0:08:53.78,Default,,0,0,0,,Сіз не істеп жатырсыз? Теми
Dialogue: 0,0:08:55.03,0:08:57.57,Default,,0,0,0,,Үндемей, үйде отырсаңыз...
Dialogue: 0,0:08:57.66,0:08:59.95,Default,,0,0,0,,Маған не болғанын білмей өліп кетуім мүмкін еді.
Dialogue: 0,0:09:00.53,0:09:04.54,Default,,0,0,0,,Бұндай жерде көрінгеніме өзім кінәлімін.
Dialogue: 0,0:09:04.62,0:09:06.29,Default,,0,0,0,,Сөйлеме!
Dialogue: 0,0:09:06.37,0:09:08.88,Default,,0,0,0,,Оны пайдаланба, қоқыс ағайын!
Dialogue: 0,0:09:09.88,0:09:12.21,Default,,0,0,0,,Енді түсіндің, Рин.
Dialogue: 0,0:09:12.80,0:09:14.92,Default,,0,0,0,,Сіз әлемдегі ең жақсы бола алмайсыз
Dialogue: 0,0:09:15.01,0:09:17.05,Default,,0,0,0,,Тоқта! Қазірдің өзінде...
Dialogue: 0,0:09:17.47,0:09:19.43,Default,,0,0,0,,Сіз мені себеп ретінде пайдалануыңыз керек.
Dialogue: 0,0:09:19.51,0:09:21.18,Default,,0,0,0,,Мен тіпті футбол ойнай да алмаймын.
Dialogue: 0,0:09:21.26,0:09:24.43,Default,,0,0,0,,Ол менің көлеңкем болып тұратын інім.
Dialogue: 0,0:09:29.69,0:09:31.23,Default,,0,0,0,,Бұл бояу.
Dialogue: 0,0:09:32.02,0:09:35.57,Default,,0,0,0,,Мені енді футбол ойнауға сылтау етпе.
Dialogue: 0,0:09:38.28,0:09:41.95,Default,,0,0,0,,Бұл жігіттің сол кездегі сөзінің мағынасы...
Dialogue: 0,0:09:42.03,0:09:44.62,Default,,0,0,0,,Енді мен мұның мағынасы бар сияқты.
Dialogue: 0,0:09:46.87,0:09:48.25,Default,,0,0,0,,Жылы...
Dialogue: 0,0:09:48.96,0:09:50.67,Default,,0,0,0,,Жиреніштісі...
Dialogue: 0,0:09:52.38,0:09:54.55,Default,,0,0,0,,Жою керек нәрсе ...
Dialogue: 0,0:09:56.30,0:09:57.93,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:10:03.10,0:10:07.56,Default,,0,0,0,,Генийдің інісі, серіктесі, қарсыласы
Dialogue: 0,0:10:08.64,0:10:12.11,Default,,0,0,0,,Сізге ыңғайлы мәндермен...
Dialogue: 0,0:10:12.19,0:10:14.03,Default,,0,0,0,,Менің өміріме қол сұғуға болмайды
Dialogue: 0,0:10:15.11,0:10:19.24,Default,,0,0,0,,Мен сенің өміріңде «бірдеңе» емеспін
Dialogue: 0,0:10:20.07,0:10:21.95,Default,,0,0,0,,«Са Итошидің інісі» бұл…
Dialogue: 0,0:10:23.99,0:10:25.04,Default,,0,0,0,,Маған бұл енді ұнамайды
Dialogue: 0,0:10:27.83,0:10:30.12,Default,,0,0,0,,Бұл ашуға сеніңіз
Dialogue: 0,0:10:31.17,0:10:33.67,Default,,0,0,0,,Өзіңізді деструктивті импульске бағындырыңыз
Dialogue: 0,0:10:34.59,0:10:35.63,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:36.71,0:10:37.76,Default,,0,0,0,,оның қан тамырларының қабырғаларынан шығып келе жатқанын—
Dialogue: 0,0:10:43.14,0:10:45.14,Default,,0,0,0,,Мен эгоистпін...
Dialogue: 0,0:10:46.47,0:10:48.35,Default,,0,0,0,,Итоши Рин!
Dialogue: 0,0:10:48.93,0:10:49.94,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:50.10,0:10:51.27,Default,,0,0,0,,Бұл керемет, Рин.
Dialogue: 0,0:10:51.90,0:10:53.23,Default,,0,0,0,,Менімен футбол ойна
Dialogue: 0,0:10:55.52,0:10:57.49,Default,,0,0,0,,Сіз қандайсыз?
Dialogue: 0,0:10:57.94,0:11:00.61,Default,,0,0,0,,Сіз бұл бетті әлі жасай алмайсыз, солай емес пе?
Dialogue: 0,0:11:00.70,0:11:04.33,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:11:04.41,0:11:06.16,Default,,0,0,0,,Я...
Dialogue: 0,0:11:06.24,0:11:08.00,Default,,0,0,0,,Я...
Dialogue: 0,0:11:09.91,0:11:12.08,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:12.17,0:11:13.54,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:16.30,0:11:19.13,Default,,0,0,0,,Жапония!Жапония!
Dialogue: 0,0:11:34.02,0:11:35.27,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:35.36,0:11:38.48,Default,,0,0,0,,Жапония!Жапония!
Dialogue: 0,0:13:11.91,0:13:13.37,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:13.45,0:13:19.46,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:13:19.54,0:13:22.84,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:22.92,0:13:25.84,Default,,0,0,0,,Көк жартастың кері айналуы!
Dialogue: 0,0:13:25.93,0:13:30.05,Default,,0,0,0,,(Қорытынды ысқырық)
Dialogue: 0,0:13:32.26,0:13:36.85,Default,,0,0,0,,Бір ғана адам... Мақсаттың алдында 11 саны ғана қалды...
Dialogue: 0,0:13:37.85,0:13:41.57,Default,,0,0,0,,Киёшиичидің тура соққысы қадалып қалды!
Dialogue: 0,0:13:41.65,0:13:46.15,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:46.24,0:13:50.49,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:51.91,0:13:53.16,Default,,0,0,0,,Я...
Dialogue: 0,0:13:54.58,0:13:58.50,Default,,0,0,0,,Ал соңғы ысқырық!
Dialogue: 0,0:13:59.00,0:14:01.75,Default,,0,0,0,,3-4 ұпай –
Dialogue: 0,0:14:01.84,0:14:04.51,Default,,0,0,0,,«Көк жартас» Он бір жеңеді!
Dialogue: 0,0:14:04.59,0:14:08.88,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:08.97,0:14:12.81,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:13.22,0:14:17.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:17.18,0:14:20.86,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:20.94,0:14:23.32,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:14:23.40,0:14:25.94,Default,,0,0,0,,Ей, данышпан
Dialogue: 0,0:14:26.03,0:14:28.78,Default,,0,0,0,,Неге бірден алдыңғы шепке өтпедің?
Dialogue: 0,0:14:29.32,0:14:32.28,Default,,0,0,0,,Ол ойнаған болса, тым болмаса гол жібермес еді.
Dialogue: 0,0:14:34.49,0:14:36.04,Default,,0,0,0,,Бар болғаны бір минут қалды...
Dialogue: 0,0:14:36.12,0:14:39.08,Default,,0,0,0,,Допты бере алмасаңыз, уақытыңыз бітеді.
Dialogue: 0,0:14:39.16,0:14:41.42,Default,,0,0,0,,Менен саған соққы өтеді
Dialogue: 0,0:14:41.50,0:14:43.75,Default,,0,0,0,,Бұл мен көрген ең жақсы нәрсе
Dialogue: 0,0:14:44.34,0:14:48.22,Default,,0,0,0,,Ол сіз мақсатқа жеткенше келді.
Dialogue: 0,0:14:48.30,0:14:49.68,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:14:50.26,0:14:51.30,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:51.84,0:14:55.72,Default,,0,0,0,,Ағамның қателігінен інім мені тоқтатты.
Dialogue: 0,0:14:55.81,0:14:58.52,Default,,0,0,0,,Мақсатымды есептеу дұрыс па?
Dialogue: 0,0:14:59.02,0:15:02.23,Default,,0,0,0,,Уәде етілгендей, маған байланыс ақпаратыңызды беріңізші!
Dialogue: 0,0:15:03.65,0:15:06.73,Default,,0,0,0,,Хмф... Мұны жасамас бұрын душ қабылдаңыз.
Dialogue: 0,0:15:06.82,0:15:08.40,Default,,0,0,0,,Эхехе...
Dialogue: 0,0:15:08.49,0:15:11.07,Default,,0,0,0,,Соңғы кредиттер стильді Киёши болды
Dialogue: 0,0:15:11.16,0:15:13.24,Default,,0,0,0,,Не? Иә, рахмет
Dialogue: 0,0:15:13.32,0:15:14.37,Default,,0,0,0,,Няхаха!
Dialogue: 0,0:15:14.45,0:15:16.12,Default,,0,0,0,,Керемет гол кейіпкері
Dialogue: 0,0:15:16.58,0:15:17.95,Default,,0,0,0,,Айзора…
Dialogue: 0,0:15:18.04,0:15:20.83,Default,,0,0,0,,Осы уақыт бойы менің соқыр жерімді көздедің бе?
Dialogue: 0,0:15:20.91,0:15:21.96,Default,,0,0,0,,О
Dialogue: 0,0:15:22.54,0:15:25.54,Default,,0,0,0,,Қалғаны – мен бір кадрда шеше алатын нүкте.
Dialogue: 0,0:15:26.30,0:15:30.92,Default,,0,0,0,,Сондай-ақ мен оның «Итошисаи жеңу» арманына сендім.
Dialogue: 0,0:15:31.01,0:15:33.39,Default,,0,0,0,,Бұл менің 90 минуттық кристалым.
Dialogue: 0,0:15:34.01,0:15:35.35,Default,,0,0,0,,Хан…
Dialogue: 0,0:15:35.43,0:15:40.89,Default,,0,0,0,,Сол сәтте мен рефлексивті түрде осы үш шарт бір-біріне сәйкес келетін жерге жүгірдім.
Dialogue: 0,0:15:42.06,0:15:45.40,Default,,0,0,0,,Доп сол жерге түсіп қалды.
Dialogue: 0,0:15:46.15,0:15:48.86,Default,,0,0,0,,Сіз Киёшиичиге сәттілік әкелдіңіз бе?
Dialogue: 0,0:15:51.57,0:15:52.95,Default,,0,0,0,,ол әлі де дем алып тұрғанша, сен жабысып алған «Shock» бақыланады.
Dialogue: 0,0:15:54.16,0:15:56.37,Default,,0,0,0,,Құттықтаймыз Көк жартас
Dialogue: 0,0:16:07.96,0:16:09.00,Default,,0,0,0,,Ннн…
Dialogue: 0,0:16:09.09,0:16:10.21,Default,,0,0,0,,Рин
Dialogue: 0,0:16:10.30,0:16:11.34,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:14.26,0:16:16.35,Default,,0,0,0,,Мен қателесіппін.
Dialogue: 0,0:16:16.43,0:16:20.43,Default,,0,0,0,,Мен Жапонияда жақсы шабуылшылар болмайды деп ойладым.
Dialogue: 0,0:16:20.52,0:16:21.77,Default,,0,0,0,,Бауырым...
Dialogue: 0,0:16:22.52,0:16:27.23,Default,,0,0,0,,Түйсіктеріңізді оятып, осы елде футболды өзгертіңіз...
Dialogue: 0,0:16:29.73,0:16:31.57,Default,,0,0,0,,Киёшиичи
Dialogue: 0,0:16:31.65,0:16:34.15,Default,,0,0,0,,Мүмкін бұл эгоист шығар.
Dialogue: 0,0:16:34.95,0:16:35.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.28,0:16:40.54,Default,,0,0,0,,Бұл ел әлі де өзгеруі мүмкін
Dialogue: 0,0:16:42.45,0:16:45.04,Default,,0,0,0,,Сәлем Киёши! Сізді шақырған жоқсыз.
Dialogue: 0,0:16:45.12,0:16:46.75,Default,,0,0,0,,Тіпті теледидарға сұхбат!
Dialogue: 0,0:16:46.83,0:16:47.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:48.50,0:16:50.42,Default,,0,0,0,,Жүр, кеттік!
Dialogue: 0,0:16:50.50,0:16:51.96,Default,,0,0,0,,Уау... Ха...
Dialogue: 0,0:16:52.05,0:16:52.88,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:16:52.97,0:16:55.05,Default,,0,0,0,,Ах, драмалық соңғы мақсат.
Dialogue: 0,0:16:55.13,0:16:57.59,Default,,0,0,0,,«Көк жартас» Он бір Киёшиичи!
Dialogue: 0,0:16:57.68,0:16:58.85,Default,,0,0,0,,Ойынды аяқтау
Dialogue: 0,0:16:58.93,0:17:01.06,Default,,0,0,0,,Өзіңіздің шынайы пікіріңізді білдіріңіз.
Dialogue: 0,0:17:01.56,0:17:04.56,Default,,0,0,0,,Мм... жақсы...
Dialogue: 0,0:17:04.64,0:17:07.77,Default,,0,0,0,,Мен өте қуаныштымын. Иә.
Dialogue: 0,0:17:07.86,0:17:12.11,Default,,0,0,0,,Бүгінгі ойынымен оны U-20 құрамасына қосуға болатын сияқты.
Dialogue: 0,0:17:12.19,0:17:14.65,Default,,0,0,0,,Сіздің болашаққа деген ұмтылысыңыз бар ма?
Dialogue: 0,0:17:14.74,0:17:15.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:18.24,0:17:21.37,Default,,0,0,0,,Болашақ... Ынта...
Dialogue: 0,0:17:22.87,0:17:25.62,Default,,0,0,0,,Менің болашағым...
Dialogue: 0,0:17:27.46,0:17:31.80,Default,,0,0,0,,Киёшиичи! Киёшиичи!
Dialogue: 0,0:17:33.46,0:17:38.14,Default,,0,0,0,,Киёшиичи! Киёшиичи!
Dialogue: 0,0:17:39.64,0:17:45.31,Default,,0,0,0,,Киёшиичи! Киёшиичи!
Dialogue: 0,0:17:50.44,0:17:51.69,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:17:51.77,0:17:52.82,Default,,0,0,0,,…Таңдау
Dialogue: 0,0:17:53.28,0:17:54.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.36,0:18:01.37,Default,,0,0,0,,We Blue Rock 20 жасқа дейінгі жасөспірімдер арасындағы әлем чемпионатын жеңеді.
Dialogue: 0,0:18:03.74,0:18:04.87,Default,,0,0,0,,Я...
Dialogue: 0,0:18:05.83,0:18:08.12,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:18:09.96,0:18:11.59,Default,,0,0,0,,Мен Жапониямын...
Dialogue: 0,0:18:12.38,0:18:15.51,Default,,0,0,0,,Мен сені 20 жасқа дейінгі жасөспірімдер арасындағы әлем чемпионатын жеңіп алуға мүмкіндік беремін!
Dialogue: 0,0:18:15.59,0:18:18.34,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:18.43,0:18:23.43,Default,,0,0,0,,♪ (көрермендер ән айту)
Dialogue: 0,0:18:32.86,0:18:34.73,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:18:34.82,0:18:37.69,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:18:37.78,0:18:41.16,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:18:41.24,0:18:44.37,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:18:47.91,0:18:49.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:49.33,0:18:51.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:53.29,0:18:57.05,Default,,0,0,0,,Құтты болсын, таланттың асыл тастары.
Dialogue: 0,0:18:57.63,0:19:00.51,Default,,0,0,0,,Балалар сендер таңғажайып нәрсе жасадыңдар.
Dialogue: 0,0:19:00.59,0:19:01.84,Default,,0,0,0,,Бірақ бұл —
Dialogue: 0,0:19:01.93,0:19:05.47,Default,,0,0,0,,Бұл сіздің футбол мансабыңыздың шыңы болмауы керек.
Dialogue: 0,0:19:06.01,0:19:08.43,Default,,0,0,0,,Бұл жеңіс шайқастың соңы емес —
Dialogue: 0,0:19:08.52,0:19:10.94,Default,,0,0,0,,Бұл Көк жартастың басы.
Dialogue: 0,0:19:11.81,0:19:15.61,Default,,0,0,0,,Осылардың арасынан мен әлемнің ең үздік шабуылшысын жасаймын.
Dialogue: 0,0:19:15.69,0:19:17.53,Default,,0,0,0,,Бұл арман өзгермейді
Dialogue: 0,0:19:18.07,0:19:21.57,Default,,0,0,0,,Жапонияны әлем чемпионатында жеңіске жеткізу —
Dialogue: 0,0:19:21.66,0:19:24.66,Default,,0,0,0,,Бір ғана кейіпкер жасау
Dialogue: 0,0:19:25.66,0:19:29.16,Default,,0,0,0,,Басқа адамдардың өмірі бейберекетке айналады.
Dialogue: 0,0:19:30.50,0:19:34.00,Default,,0,0,0,,Дайын болыңдар, таланттың асыл тастары.
Dialogue: 0,0:19:35.17,0:19:40.22,Default,,0,0,0,,Біз, Көк жартас, қайтып келмейтін кезеңге жеттік.
Dialogue: 0,0:19:42.30,0:19:43.34,Default,,0,0,0,,Хан…
Dialogue: 0,0:19:43.43,0:19:47.18,Default,,0,0,0,,Айтылмаған, мөлдір айна тынық су, сәнді жарық
Dialogue: 0,0:19:47.26,0:19:49.73,Default,,0,0,0,,Лайк Бұл мені тоңазытады!
Dialogue: 0,0:19:49.81,0:19:50.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:50.73,0:19:52.14,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:19:52.23,0:19:53.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:53.56,0:19:56.11,Default,,0,0,0,,Бүгін сіз өзіңіз жеуге болатын сәнді асханадан ләззат ала аласыз!
Dialogue: 0,0:19:56.19,0:19:57.86,Default,,0,0,0,,Барлығымыз тойлайық!
Dialogue: 0,0:19:57.94,0:20:00.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:00.90,0:20:03.78,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:20:38.73,0:20:43.57,Default,,0,0,0,,♪~
Dialogue: 0,0:21:30.58,0:21:36.58,Default,,0,0,0,,~♪
Dialogue: 0,0:21:41.42,0:21:42.55,Default,,0,0,0,,Рин
Dialogue: 0,0:21:43.46,0:21:46.76,Default,,0,0,0,,Сенсіз менің мақсатым орындалмас еді.
Dialogue: 0,0:21:47.47,0:21:52.72,Default,,0,0,0,,Сол кезде сенің Сады жеңетініне мен ғана сендім.
Dialogue: 0,0:21:53.72,0:21:56.69,Default,,0,0,0,,Мен сенен жеңілгендіктен, жолдың қыр-сырын үйрендім...
Dialogue: 0,0:21:57.77,0:22:00.56,Default,,0,0,0,,Мен бүгін сол мүмкіндікті таптым.
Dialogue: 0,0:22:01.69,0:22:03.07,Default,,0,0,0,,Рахмет Рин
Dialogue: 0,0:22:03.53,0:22:06.15,Default,,0,0,0,,Бұл менің де, сенің де мақсатым.
Dialogue: 0,0:22:11.87,0:22:13.04,Default,,0,0,0,,Сен оны бірнеше күн бұрын ертіп келгенде маған айтсаң ғой.
Dialogue: 0,0:22:16.25,0:22:18.08,Default,,0,0,0,,Дие Киёши
Dialogue: 0,0:22:18.50,0:22:20.96,Default,,0,0,0,,Мен сені енді кешіре алмаймын
Dialogue: 0,0:22:21.79,0:22:23.75,Default,,0,0,0,,Осы сәттен бастап...
Dialogue: 0,0:22:24.46,0:22:26.67,Default,,0,0,0,,Сен менің қарсыласымсың.
Dialogue: 0,0:22:26.76,0:22:27.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:29.22,0:22:30.55,Default,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:22:31.60,0:22:34.14,Default,,0,0,0,,«мүлдем өлтіру» дегенді білдіреді
Dialogue: 0,0:22:36.27,0:22:37.43,Default,,0,0,0,,О
Dialogue: 0,0:22:38.31,0:22:39.35,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:22:43.82,0:22:47.36,Default,,0,0,0,,Қалай болды? Барлығы, Blue Rock
Dialogue: 0,0:22:54.66,0:22:58.54,Default,,0,0,0,,Дүниені от жағуға дайын
Dialogue: 0,0:22:58.91,0:23:02.17,Default,,0,0,0,,Сенің Ұсқының ғана қалды
Dialogue: 0,0:23:09.26,0:23:11.64,Default,,0,0,0,,Әлемдегі ең үздік шабуылшы
Dialogue: 0,0:23:11.72,0:23:16.77,Default,,0,0,0,,Футбол ойнайтын ең ыстық жерде кенеттен пайда болады
Dialogue: 0,0:23:18.98,0:23:22.48,Default,,0,0,0,,Көк жартас жобасының 2-кезеңі
Dialogue: 0,0:23:22.56,0:23:23.61,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:23:23.69,0:23:27.82,Default,,0,0,0,,«Нео эгоисттік лига» басталады
Dialogue: 0,0:23:33.91,0:23:36.79,Default,,0,0,0,,(Ұялы телефон вибраторы)
Dialogue: 0,0:23:36.87,0:23:40.71,Default,,0,0,0,,(Ұялы телефон вибраторы)
Dialogue: 0,0:23:44.96,0:23:49.13,Default,,0,0,0,,Тізерлеп отыр, Көк жартас.
Dialogue: 0,0:23:50.63,0:23:56.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory