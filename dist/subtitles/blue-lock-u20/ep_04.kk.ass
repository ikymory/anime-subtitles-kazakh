Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.30,0:00:17.35,Default,,0,0,0,,Бұл Рейо-кун!
Dialogue: 0,0:00:17.43,0:00:18.89,Default,,0,0,0,,О, Рейу!
Dialogue: 0,0:00:18.97,0:00:21.43,Default,,0,0,0,,Рейо-кун, мына жаққа қара!
Dialogue: 0,0:00:21.52,0:00:25.02,Default,,0,0,0,,Микаге-кунның бағалары өте жақсы.
Dialogue: 0,0:00:25.10,0:00:27.90,Default,,0,0,0,,О, оның қолынан бәрі келеді.
Dialogue: 0,0:00:28.90,0:00:30.65,Default,,0,0,0,,О! 3 қатарынан!
Dialogue: 0,0:00:30.73,0:00:32.74,Default,,0,0,0,,Шын айтасың ба, Рео! Тым таңқаларлық!
Dialogue: 0,0:00:32.82,0:00:34.49,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:34.57,0:00:37.28,Default,,0,0,0,,Менде қалағанның бәрі бар
Dialogue: 0,0:00:37.99,0:00:39.20,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:39.28,0:00:41.91,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:43.16,0:00:46.71,Default,,0,0,0,,Мен де ала алмайтын нәрсе бар...
Dialogue: 0,0:00:47.50,0:00:49.84,Default,,0,0,0,,Бұл дүниеде бар шығар
Dialogue: 0,0:00:53.59,0:00:55.38,Default,,0,0,0,,Ақыры осы уақытқа дейін жеттік
Dialogue: 0,0:00:56.13,0:00:59.97,Default,,0,0,0,,Мен сенің қасыңда тағы бір рет шайқаса аламын.
Dialogue: 0,0:01:00.85,0:01:01.97,Default,,0,0,0,,Сәлем Наги
Dialogue: 0,0:01:04.43,0:01:07.31,Default,,0,0,0,,Маған дұрыстап қара
Dialogue: 0,0:01:08.23,0:01:10.77,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,0:01:11.98,0:01:16.32,Default,,0,0,0,,♪~
Dialogue: 0,0:02:35.94,0:02:41.95,Default,,0,0,0,,~♪
Dialogue: 0,0:02:48.54,0:02:49.91,Default,,0,0,0,,Сол мақсат сахнасы
Dialogue: 0,0:02:50.50,0:02:52.67,Default,,0,0,0,,Алдымен, осында бара жатырмын деп елестетіңіз.
Dialogue: 0,0:02:52.75,0:02:54.92,Default,,0,0,0,,Қарғаның артына өтіңіз
Dialogue: 0,0:02:55.00,0:02:58.51,Default,,0,0,0,,Дәл солай, Отоя мен Риннің соқыр жеріне жасырын кіріңіз...
Dialogue: 0,0:03:05.18,0:03:06.39,Default,,0,0,0,,Иә, иә сұрақ!
Dialogue: 0,0:03:06.47,0:03:07.52,Default,,0,0,0,,Бұл жағдайда –
Dialogue: 0,0:03:07.60,0:03:09.06,Default,,0,0,0,,Мен мұның бәрін ойладым...
Dialogue: 0,0:03:09.14,0:03:10.64,Default,,0,0,0,,Ол қозғала бастады ма?
Dialogue: 0,0:03:10.73,0:03:12.48,Default,,0,0,0,,Жоқ, не...
Dialogue: 0,0:03:12.56,0:03:16.11,Default,,0,0,0,,Ойлану және қозғалу кезінде өзіңізді әрекет ететіндей сезінесіз бе?
Dialogue: 0,0:03:16.82,0:03:20.82,Default,,0,0,0,,Ал соңғы бөлім Рин мен Шидоның арасын айналып өтеді.
Dialogue: 0,0:03:21.20,0:03:23.66,Default,,0,0,0,,Менің ойымша, оны жұлып алды.
Dialogue: 0,0:03:23.74,0:03:26.08,Default,,0,0,0,,Хе! Күткендей, бұл керемет!
Dialogue: 0,0:03:26.16,0:03:29.25,Default,,0,0,0,,Мұның бәрі бір сәттік сезім, солай ма?
Dialogue: 0,0:03:29.33,0:03:31.25,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:03:31.33,0:03:34.17,Default,,0,0,0,,Мен мұндай күрделі қимылды бірінші рет жасағандай сезінемін.
Dialogue: 0,0:03:34.25,0:03:36.25,Default,,0,0,0,,Мен де олай ойламадым.
Dialogue: 0,0:03:36.34,0:03:39.38,Default,,0,0,0,,Мен Киёши-кун шешім қабылдайды деп күтпедім.
Dialogue: 0,0:03:40.01,0:03:43.13,Default,,0,0,0,,Мен Рин-кун немесе Шидо-кун шешім қабылдайды деп жүріп өттім.
Dialogue: 0,0:03:43.89,0:03:46.93,Default,,0,0,0,,Осылайша сіз өткенге қарап, өз ойыныңызды талдайсыз...
Dialogue: 0,0:03:47.01,0:03:49.39,Default,,0,0,0,,Бұл Киёши-кун үшін дәл қазір маңызды.
Dialogue: 0,0:03:49.77,0:03:50.89,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:03:50.98,0:03:53.94,Default,,0,0,0,,Сіз маған «рефлексиялық ойлауға» кеңес бердіңіз бе?
Dialogue: 0,0:03:54.35,0:03:55.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:56.48,0:03:58.94,Default,,0,0,0,,Мысалы, құлау ойындары бар ма?
Dialogue: 0,0:04:01.65,0:04:02.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:02.78,0:04:04.57,Default,,0,0,0,,Алдымен жылдамдық баяу.
Dialogue: 0,0:04:04.66,0:04:06.57,Default,,0,0,0,,Ойлау барысында жинақтауға болады.
Dialogue: 0,0:04:06.66,0:04:09.54,Default,,0,0,0,,Бірақ жылдамдық тез өссе...
Dialogue: 0,0:04:09.62,0:04:12.25,Default,,0,0,0,,Ақырында бұл туралы ойлануға уақыт болмайды, солай ма?
Dialogue: 0,0:04:13.12,0:04:16.08,Default,,0,0,0,,Рин-кун мен Шидо-кунмен қатар өмір сүре алатын ойын жылдамдығы қандай?
Dialogue: 0,0:04:16.17,0:04:18.80,Default,,0,0,0,,Мен бұл қиын деп ойладым.
Dialogue: 0,0:04:18.88,0:04:20.00,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:04:20.09,0:04:22.05,Default,,0,0,0,,Мен асығып тұрмын—есеп-шотты беріңізші.
Dialogue: 0,0:04:22.13,0:04:24.80,Default,,0,0,0,,Бұрынғыдай қозғалу өте баяу.
Dialogue: 0,0:04:24.88,0:04:27.35,Default,,0,0,0,,Қазір ол қалай жинақталған?
Dialogue: 0,0:04:27.43,0:04:29.85,Default,,0,0,0,,Мен қазір қандай блоктарды қолдана аламын?
Dialogue: 0,0:04:29.93,0:04:31.56,Default,,0,0,0,,Келесі құлайтын блок
Dialogue: 0,0:04:31.64,0:04:32.81,Default,,0,0,0,,Ол қандай пішін?
Dialogue: 0,0:04:32.89,0:04:34.06,Default,,0,0,0,,«Түсіну»
Dialogue: 0,0:04:34.14,0:04:35.10,Default,,0,0,0,,«Ойлау»
Dialogue: 0,0:04:35.73,0:04:36.77,Default,,0,0,0,,«әрекет»
Dialogue: 0,0:04:37.36,0:04:41.23,Default,,0,0,0,,Тамаша ойыншылар оны миында өте жылдам өңдейді.
Dialogue: 0,0:04:41.73,0:04:46.20,Default,,0,0,0,,Мен «рефлексия» арқылы ең жақсы түймелерді енгізуді жалғастырамын
Dialogue: 0,0:04:47.20,0:04:50.12,Default,,0,0,0,,Бұл футболда да солай.
Dialogue: 0,0:04:50.58,0:04:52.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:53.91,0:04:55.58,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:04:57.08,0:05:00.25,Default,,0,0,0,,Олар қайда, кім, нені көздейді?
Dialogue: 0,0:05:01.34,0:05:04.22,Default,,0,0,0,,Мен қазір қандай қаруды қолдана аламын?
Dialogue: 0,0:05:04.30,0:05:06.72,Default,,0,0,0,,Келесі жол қайда?
Dialogue: 0,0:05:06.80,0:05:08.47,Default,,0,0,0,,Мен бәрін тексердім
Dialogue: 0,0:05:10.18,0:05:13.56,Default,,0,0,0,,Өйткені мен барлық қабілеттерімді өте жоғары жылдамдықта өңдей алдым...
Dialogue: 0,0:05:14.60,0:05:15.85,Default,,0,0,0,,Басқалардан бұрын
Dialogue: 0,0:05:15.94,0:05:18.06,Default,,0,0,0,,Мен сол ату нүктесіне жеттім.
Dialogue: 0,0:05:18.44,0:05:19.61,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:19.69,0:05:23.19,Default,,0,0,0,,Бірақ бұл әзірге жинақтаудың арқасында ғана мүмкін.
Dialogue: 0,0:05:23.28,0:05:25.99,Default,,0,0,0,,Топшы кенеттен таңғажайып бірдеңе жасай алған сияқты, бірақ...
Dialogue: 0,0:05:26.40,0:05:29.49,Default,,0,0,0,,Шындығында, жасауға болатын нәрсенің бәрі бір сәтте шоғырланады...
Dialogue: 0,0:05:29.57,0:05:31.41,Default,,0,0,0,,Жылдамдықты арттырды
Dialogue: 0,0:05:31.49,0:05:33.37,Default,,0,0,0,,Сонда бұл жаңа техника емес...
Dialogue: 0,0:05:33.45,0:05:36.21,Default,,0,0,0,,Бағдарламалық құралды өзгертпей, жай ғана жабдықты жаңартыңыз!
Dialogue: 0,0:05:36.66,0:05:37.71,Default,,0,0,0,,Иә
Dialogue: 0,0:05:37.79,0:05:42.21,Default,,0,0,0,,Смартфондардың байланыс жылдамдығы 4G-ден 5G-ге дейін өскен сияқты.
Dialogue: 0,0:05:43.30,0:05:45.72,Default,,0,0,0,,Бұл сезімнің шынайы табиғаты
Dialogue: 0,0:05:47.18,0:05:50.14,Default,,0,0,0,,Мен өзімді ұмытып кеткенім сонша...
Dialogue: 0,0:05:50.76,0:05:52.10,Default,,0,0,0,,Саяхат
Dialogue: 0,0:05:53.26,0:05:55.27,Default,,0,0,0,,Бірақ мүмкін...
Dialogue: 0,0:05:55.35,0:05:58.60,Default,,0,0,0,,Мен мұны істей алдым деп ойлаймын, өйткені көп нәрсе біріктірілді.
Dialogue: 0,0:05:58.69,0:06:01.81,Default,,0,0,0,,Рин мен Шидо бір-бірімен төбелесіп жатқандықтан, сахна артында қозғалу оңай болды.
Dialogue: 0,0:06:02.40,0:06:05.99,Default,,0,0,0,,Ең бастысы, сендерсіз бұл мүмкін емес еді.
Dialogue: 0,0:06:06.07,0:06:09.16,Default,,0,0,0,,Рахмет, Шичихоси Хёори
Dialogue: 0,0:06:10.11,0:06:15.58,Default,,0,0,0,,Шынымды айтсам, мен тек Киёши-санға ілесе алдым.
Dialogue: 0,0:06:16.04,0:06:17.08,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:17.16,0:06:18.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:18.62,0:06:20.75,Default,,0,0,0,,Бұл өрескел болуы мүмкін, бірақ...
Dialogue: 0,0:06:21.38,0:06:27.01,Default,,0,0,0,,Rin-kun and Shido-san's movements were too different for me to understand.
Dialogue: 0,0:06:27.80,0:06:32.51,Default,,0,0,0,,Бірақ мен Киёшидің ойынына әрең жеткендей болдым.
Dialogue: 0,0:06:33.18,0:06:34.47,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:34.56,0:06:38.48,Default,,0,0,0,,Thanks to that, the range of my play has suddenly increased, and it's totally fine.
Dialogue: 0,0:06:38.85,0:06:40.90,Default,,0,0,0,,Уау, бұл өте үлкен болды.
Dialogue: 0,0:06:40.98,0:06:43.40,Default,,0,0,0,,Хиори де ілтипатқа ие болды!
Dialogue: 0,0:06:43.77,0:06:46.57,Default,,0,0,0,,Мен әдеттегідей ойнадым.
Dialogue: 0,0:06:47.03,0:06:49.15,Default,,0,0,0,,Себебі Киёши-кун гол соқты—
Dialogue: 0,0:06:49.24,0:06:52.03,Default,,0,0,0,,Both Nanahoshi-kun and I were able to make our presence felt.
Dialogue: 0,0:06:52.12,0:06:55.28,Default,,0,0,0,,I think all three of us did what we could.
Dialogue: 0,0:06:55.83,0:06:57.70,Default,,0,0,0,,Иә, мен оны аяқтадым.
Dialogue: 0,0:06:57.79,0:06:59.12,Default,,0,0,0,,Мен де еш өкінбеймін!
Dialogue: 0,0:06:59.21,0:07:00.50,Default,,0,0,0,,Мен де!
Dialogue: 0,0:07:00.58,0:07:02.29,Default,,0,0,0,,Енді нәтижелерді күтіңіз!
Dialogue: 0,0:07:02.38,0:07:03.54,Default,,0,0,0,,(бес жоғары дыбыс)
Dialogue: 0,0:07:03.63,0:07:06.25,Default,,0,0,0,,Жақсы тапсырма!
Dialogue: 0,0:07:06.34,0:07:08.38,Default,,0,0,0,,Бұл~! Қазірдің өзінде
Dialogue: 0,0:07:08.46,0:07:10.72,Default,,0,0,0,,Хехе... Кешіріңіз.
Dialogue: 0,0:07:11.38,0:07:15.64,Default,,0,0,0,,Мен жаңа сезімге ие болдым, бірақ мен оны әлі түсінген жоқпын.
Dialogue: 0,0:07:19.10,0:07:22.31,Default,,0,0,0,,Бұл өшіру сезімінің қайталану мүмкіндігін арттырыңыз
Dialogue: 0,0:07:22.40,0:07:24.69,Default,,0,0,0,,Егер сіз оны еркін пайдалана алсаңыз...
Dialogue: 0,0:07:26.15,0:07:28.44,Default,,0,0,0,,Мен одан да жоғары көтеріле аламын!
Dialogue: 0,0:07:28.94,0:07:30.24,Default,,0,0,0,,Ей, уақыт келді...
Dialogue: 0,0:07:30.32,0:07:32.07,Default,,0,0,0,,Келесі ойын басталып жатыр ма?
Dialogue: 0,0:07:32.57,0:07:34.24,Default,,0,0,0,,Екінші ойын!
Dialogue: 0,0:07:43.33,0:07:45.25,Default,,0,0,0,,
Dialogue: 0,0:07:48.67,0:07:51.09,Default,,0,0,0,,Сен мені таңдамаған сол кезден...
Dialogue: 0,0:07:51.17,0:07:53.18,Default,,0,0,0,,Мен аздап күшейдім
Dialogue: 0,0:07:54.43,0:07:58.72,Default,,0,0,0,,Мен сені қуып жету үшін жеңуге тырысамын деп ойладым.
Dialogue: 0,0:07:58.81,0:07:59.93,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:01.31,0:08:03.60,Default,,0,0,0,,Менен әлі алдасың
Dialogue: 0,0:08:04.60,0:08:06.52,Default,,0,0,0,,Олай болса осы жерде дәлелдеп көрейік.
Dialogue: 0,0:08:08.44,0:08:09.61,Default,,0,0,0,,Жаныңызда...
Dialogue: 0,0:08:10.44,0:08:11.57,Default,,0,0,0,,I'm the only one!
Dialogue: 0,0:08:11.65,0:08:12.49,Default,,0,0,0,,О...
Dialogue: 0,0:08:12.57,0:08:13.82,Default,,0,0,0,,Ей, бұрынғыдан да жылдам!
Dialogue: 0,0:08:13.91,0:08:14.95,Default,,0,0,0,,Number 10 is...
Dialogue: 0,0:08:15.78,0:08:17.16,Default,,0,0,0,,Add “ore”
Dialogue: 0,0:08:17.70,0:08:19.12,Default,,0,0,0,,Солай шығар, Наги.
Dialogue: 0,0:08:20.08,0:08:22.37,Default,,0,0,0,,Қалаған доп және уақыт...
Dialogue: 0,0:08:23.29,0:08:24.67,Default,,0,0,0,,I know best!
Dialogue: 0,0:08:24.75,0:08:25.79,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:08:26.46,0:08:28.09,Default,,0,0,0,,Not good.
Dialogue: 0,0:08:28.17,0:08:29.21,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:29.30,0:08:30.55,Default,,0,0,0,,Та... Такае!
Dialogue: 0,0:08:30.63,0:08:33.17,Default,,0,0,0,,Орта мектептің ең ұзын оқушысы Исикари!
Dialogue: 0,0:08:34.26,0:08:36.05,Default,,0,0,0,,Мен үшін біршама төмен
Dialogue: 0,0:08:36.14,0:08:38.76,Default,,0,0,0,,Ия... бұл сол жігіт.
Dialogue: 0,0:08:40.22,0:08:41.72,Default,,0,0,0,,Жарайды, есептегіш!
Dialogue: 0,0:08:41.81,0:08:44.19,Default,,0,0,0,,Bring it out, you bottom eyelash bastard!
Dialogue: 0,0:08:44.27,0:08:45.10,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:45.19,0:08:46.60,Default,,0,0,0,,Ннн…
Dialogue: 0,0:08:46.69,0:08:47.98,Default,,0,0,0,,Мені пайдалан, Рин!
Dialogue: 0,0:08:48.52,0:08:50.69,Default,,0,0,0,,«Пайдалы монах» мені білдіреді!
Dialogue: 0,0:08:52.49,0:08:54.53,Default,,0,0,0,,(Джозеф) Нүүүү! Гүх!
Dialogue: 0,0:08:54.61,0:08:57.16,Default,,0,0,0,,№1 рейтингтік билет
Dialogue: 0,0:08:57.24,0:08:59.49,Default,,0,0,0,,Oh... I'm number 1 now...
Dialogue: 0,0:08:59.58,0:09:01.99,Default,,0,0,0,,Көтеріңкі көңіл-күйдегі есептегіш шешілді!
Dialogue: 0,0:09:02.08,0:09:03.45,Default,,0,0,0,,Игагуриді тоқтатыңыз
Dialogue: 0,0:09:03.96,0:09:05.58,Default,,0,0,0,,I'll make you a "useless boy"
Dialogue: 0,0:09:05.67,0:09:06.50,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:09:06.58,0:09:08.46,Default,,0,0,0,,Don't let me go if it's easy
Dialogue: 0,0:09:09.75,0:09:12.63,Default,,0,0,0,,Ешбір пас бәрібір қақпа алдында маған келмейді.
Dialogue: 0,0:09:12.71,0:09:14.67,Default,,0,0,0,,This is your last pass chance!
Dialogue: 0,0:09:15.55,0:09:16.68,Default,,0,0,0,,Where should I send it?
Dialogue: 0,0:09:17.43,0:09:19.39,Default,,0,0,0,,Which genius should I follow?
Dialogue: 0,0:09:20.30,0:09:23.10,Default,,0,0,0,,Бұл тағдырдың тоғысқан жері
Dialogue: 0,0:09:25.56,0:09:30.02,Default,,0,0,0,,Қай данышпан мені келесі кезеңге шығарады?
Dialogue: 0,0:09:31.52,0:09:32.98,Default,,0,0,0,,What are you doing!?
Dialogue: 0,0:09:33.07,0:09:35.11,Default,,0,0,0,,I'll break your brain!
Dialogue: 0,0:09:35.19,0:09:36.61,Default,,0,0,0,,Мен... Наму!
Dialogue: 0,0:09:37.95,0:09:39.07,Default,,0,0,0,,Зеку…
Dialogue: 0,0:09:39.16,0:09:40.28,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:40.83,0:09:42.99,Default,,0,0,0,,Мен қорқып, оған бердім!
Dialogue: 0,0:09:44.37,0:09:46.66,Default,,0,0,0,,This way, chonmagemaru
Dialogue: 0,0:09:46.75,0:09:49.63,Default,,0,0,0,,Oh my... Ura-ssu, Mr. Tentacle.
Dialogue: 0,0:09:49.71,0:09:51.00,Default,,0,0,0,,Бірақ әрең...
Dialogue: 0,0:09:52.09,0:09:54.13,Default,,0,0,0,,I hope this arrives.
Dialogue: 0,0:09:54.21,0:09:55.67,Default,,0,0,0,,О! Кәке!
Dialogue: 0,0:09:55.76,0:09:57.97,Default,,0,0,0,,Ах! Маған керек емес!
Dialogue: 0,0:10:00.55,0:10:03.18,Default,,0,0,0,,Look at your order, number 5.
Dialogue: 0,0:10:14.19,0:10:15.99,Default,,0,0,0,,Қайшыны сүйреу
Dialogue: 0,0:10:16.07,0:10:20.28,Default,,0,0,0,,Қарсыластың ауырлық центрін доппен ауыстырып, одан жоғары жылдамдықпен басып озу үшін жетілдірілген әдістеме.
Dialogue: 0,0:10:20.87,0:10:21.91,Default,,0,0,0,,Жарылыс жылдам!
Dialogue: 0,0:10:22.78,0:10:25.66,Default,,0,0,0,,1-санға бір-бірден бала сияқты қарайды!?
Dialogue: 0,0:10:25.75,0:10:28.50,Default,,0,0,0,,The basics of soccer are one-on-one
Dialogue: 0,0:10:28.58,0:10:29.87,Default,,0,0,0,,If you bring it here—
Dialogue: 0,0:10:29.96,0:10:32.54,Default,,0,0,0,,Мен Жапонияның ең мықтысы болғанымды мақтан тұтамын.
Dialogue: 0,0:10:33.04,0:10:34.09,Default,,0,0,0,,Қызық!
Dialogue: 0,0:10:34.63,0:10:36.30,Default,,0,0,0,,Do it with me, Goggle Man!
Dialogue: 0,0:10:36.80,0:10:38.26,Default,,0,0,0,,Хой Хой
Dialogue: 0,0:10:38.84,0:10:41.18,Default,,0,0,0,,Юкимия... Көрінгеніне қарамастан—
Dialogue: 0,0:10:41.76,0:10:45.06,Default,,0,0,0,,Физикалық және жылдамдыққа сенетін қатал күрескер!?
Dialogue: 0,0:10:45.56,0:10:47.85,Default,,0,0,0,,Хираку техникасы мен идеялары оны айналып өтеді.
Dialogue: 0,0:10:47.93,0:10:49.69,Default,,0,0,0,,Егер ол «жұмсақ» дриблинг болса...
Dialogue: 0,0:10:50.44,0:10:51.94,Default,,0,0,0,,Осылай, Норома-сан
Dialogue: 0,0:10:54.11,0:10:57.11,Default,,0,0,0,,Бұл жігіт күшпен және жылдамдықпен өтеді
Dialogue: 0,0:10:57.19,0:10:58.40,Default,,0,0,0,,«Қатты» дриблинг!
Dialogue: 0,0:10:58.86,0:11:02.11,Default,,0,0,0,,Бұл 5 саны Кеню Юкимия
Dialogue: 0,0:11:02.62,0:11:05.08,Default,,0,0,0,,Бірден бір император стилі!
Dialogue: 0,0:11:05.91,0:11:08.37,Default,,0,0,0,,Біреуге болмайды! Мен сені шымшып аламын, Ишикари!
Dialogue: 0,0:11:08.45,0:11:10.62,Default,,0,0,0,,Сіз бұйырған жоқсыз ба?
Dialogue: 0,0:11:11.21,0:11:12.38,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:11:12.46,0:11:13.79,Default,,0,0,0,,Мынаны пайдалан, Юкимия!
Dialogue: 0,0:11:14.34,0:11:15.80,Default,,0,0,0,,Жоқ, жоқ, олай емес.
Dialogue: 0,0:11:16.96,0:11:19.51,Default,,0,0,0,,Мен шешсем тыныш болады
Dialogue: 0,0:11:21.05,0:11:23.14,Default,,0,0,0,,Сол жерден орта!?
Dialogue: 0,0:11:23.22,0:11:25.43,Default,,0,0,0,,Жоқ, бірақ курс жоқ!?
Dialogue: 0,0:11:27.39,0:11:29.10,Default,,0,0,0,,Хан... Мискик!
Dialogue: 0,0:11:29.89,0:11:32.02,Default,,0,0,0,,Мен пацифистпін
Dialogue: 0,0:11:33.31,0:11:35.48,Default,,0,0,0,,Ха... не? Сол орбита
Dialogue: 0,0:11:35.56,0:11:37.69,Default,,0,0,0,,Жылдам құлап қашып кетеді
Dialogue: 0,0:11:38.53,0:11:39.65,Default,,0,0,0,,Гиро түсіру?
Dialogue: 0,0:11:40.36,0:11:42.36,Default,,0,0,0,,«Мен» сапары
Dialogue: 0,0:11:42.45,0:11:44.62,Default,,0,0,0,,О! Жоқ!
Dialogue: 0,0:11:44.70,0:11:46.37,Default,,0,0,0,,Иә? Тағы бір адам бар.
Dialogue: 0,0:11:48.70,0:11:49.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:51.04,0:11:52.08,Default,,0,0,0,,О...
Dialogue: 0,0:11:53.21,0:11:54.33,Default,,0,0,0,,(Көрермендер) Ә? Мүмкін емес. (Көрермендер) Сол бала…
Dialogue: 0,0:11:54.42,0:11:55.50,Default,,0,0,0,,Тұзақ па?
Dialogue: 0,0:11:57.67,0:11:59.67,Default,,0,0,0,,Бұлай етпе, 6 саны
Dialogue: 0,0:12:00.67,0:12:02.63,Default,,0,0,0,,
Dialogue: 0,0:12:03.63,0:12:06.43,Default,,0,0,0,,Үздік ойыншылар арасындағы үлкен өлшемді ынтымақтастық
Dialogue: 0,0:12:10.60,0:12:12.60,Default,,0,0,0,,Өйткені, сіз...
Dialogue: 0,0:12:12.69,0:12:14.60,Default,,0,0,0,,Мен білетін адам сенсің...
Dialogue: 0,0:12:15.27,0:12:16.90,Default,,0,0,0,,Кешіріңіз, Мегане-кун
Dialogue: 0,0:12:17.61,0:12:18.90,Default,,0,0,0,,Ұрланған
Dialogue: 0,0:12:26.03,0:12:28.45,Default,,0,0,0,,Мен өзімнің ағымдағы мақсатымды құра алмаймын.
Dialogue: 0,0:12:29.37,0:12:32.33,Default,,0,0,0,,Дәлдікпен жасалған күшті соққы...
Dialogue: 0,0:12:32.41,0:12:33.87,Default,,0,0,0,,Бұл бір-бірімен байланысты емес ...
Dialogue: 0,0:12:33.96,0:12:37.54,Default,,0,0,0,,Супер пьесалармен бір-бірімен соқтығысып, бірін-бірі жақсартатын қарым-қатынас
Dialogue: 0,0:12:37.63,0:12:39.63,Default,,0,0,0,,Жақсы тұзақ Наги-кун
Dialogue: 0,0:12:40.05,0:12:42.01,Default,,0,0,0,,Найшу Мегане-кун
Dialogue: 0,0:12:42.09,0:12:44.09,Default,,0,0,0,,Танысқаныма қуаныштымын, мм...
Dialogue: 0,0:12:44.63,0:12:45.68,Default,,0,0,0,,Юкимия...
Dialogue: 0,0:12:45.76,0:12:46.80,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:46.89,0:12:48.47,Default,,0,0,0,,Юкки жақсы.
Dialogue: 0,0:12:50.01,0:12:52.06,Default,,0,0,0,,Мен оған өз деңгейінде жете алмаймын.
Dialogue: 0,0:12:52.98,0:12:56.90,Default,,0,0,0,,Мен сені енді қанағаттандыра алмаймын, Наги.
Dialogue: 0,0:12:58.36,0:13:00.36,Default,,0,0,0,,Ол көңілді жүргендей көрінді.
Dialogue: 0,0:13:01.36,0:13:04.07,Default,,0,0,0,,Сіз жігерсіз болып көрініп, менің билетімді қабылдаған кезіңіз...
Dialogue: 0,0:13:04.15,0:13:06.61,Default,,0,0,0,,Сен басқа адамсың, ақымақ.
Dialogue: 0,0:13:13.08,0:13:15.00,Default,,0,0,0,,Өйткені, сіз...
Dialogue: 0,0:13:16.17,0:13:18.96,Default,,0,0,0,,Бұл менікі емес...
Dialogue: 0,0:13:19.04,0:13:20.25,Default,,0,0,0,,
Dialogue: 0,0:13:22.25,0:13:24.05,Default,,0,0,0,,Қарсы шабуылдың кезегі!
Dialogue: 0,0:13:24.13,0:13:25.88,Default,,0,0,0,,Антенналарды айналып өту
Dialogue: 0,0:13:25.97,0:13:28.30,Default,,0,0,0,,Маған бұйрық берме, Линлин!
Dialogue: 0,0:13:28.39,0:13:30.43,Default,,0,0,0,,Мен өз еркім бойынша өмір сүремін!
Dialogue: 0,0:13:30.51,0:13:32.18,Default,,0,0,0,,Линлин деген кім?
Dialogue: 0,0:13:32.81,0:13:33.68,Default,,0,0,0,,Қарғыс атқыр қате!
Dialogue: 0,0:13:34.35,0:13:36.64,Default,,0,0,0,,Өйткені, үздік 6-лық ерекше
Dialogue: 0,0:13:37.69,0:13:40.69,Default,,0,0,0,,Орташа адам көп тырысса да бұл адамдарға жете алмайды.
Dialogue: 0,0:13:40.77,0:13:44.15,Default,,0,0,0,,100 немесе одан жоғары ұпай жинаған керемет қаруға ие болыңыз
Dialogue: 0,0:13:44.24,0:13:48.70,Default,,0,0,0,,Екінші жағынан, мен салмақты жан-жақты спортшымын.
Dialogue: 0,0:13:49.32,0:13:53.24,Default,,0,0,0,,Мен өз ойынымның сапасын қаншалықты жақсартсам да, ең жоғары ұпайым 99 ұпай болып қалады.
Dialogue: 0,0:13:53.87,0:13:55.33,Default,,0,0,0,,Осы сипаттамалармен I—
Dialogue: 0,0:13:56.16,0:13:58.67,Default,,0,0,0,,Үздік 6-ға қалай бет бұруым керек?
Dialogue: 0,0:13:59.38,0:14:02.34,Default,,0,0,0,,Хаха! Мынаны шығар, Рин!
Dialogue: 0,0:14:03.63,0:14:06.51,Default,,0,0,0,,Айо саны 1 Дана пайымдау
Dialogue: 0,0:14:06.59,0:14:07.63,Default,,0,0,0,,Қарғыс атсын... Жоғары!
Dialogue: 0,0:14:07.72,0:14:08.76,Default,,0,0,0,,Қосымша
Dialogue: 0,0:14:08.84,0:14:11.89,Default,,0,0,0,,Екі алып ...Хайтуэр коалициялық үкіметі
Dialogue: 0,0:14:11.97,0:14:13.64,Default,,0,0,0,,Ол сізге жетеді ме? Қат!
Dialogue: 0,0:14:15.35,0:14:17.69,Default,,0,0,0,,Бұл құбыжықтардың химиялық реакциялары...
Dialogue: 0,0:14:18.06,0:14:19.69,Default,,0,0,0,,
Dialogue: 0,0:14:21.06,0:14:23.19,Default,,0,0,0,,Ханадан...
Dialogue: 0,0:14:23.27,0:14:25.94,Default,,0,0,0,,Сіз мен қол тигізбейтін жерді мақсат еттіңіз, солай ма?
Dialogue: 0,0:14:26.03,0:14:28.90,Default,,0,0,0,,Хмм... өрісті рационализациялау.
Dialogue: 0,0:14:29.36,0:14:31.32,Default,,0,0,0,,Teme сияқты қателерді жойыңыз.
Dialogue: 0,0:14:31.41,0:14:34.33,Default,,0,0,0,,Virus Buster қолданбасын қолданып көріңіз
Dialogue: 0,0:14:36.91,0:14:39.33,Default,,0,0,0,,Әлемнің ең үздік шабуылшысы
Dialogue: 0,0:14:39.79,0:14:40.83,Default,,0,0,0,,Сондықтан өзіңді де кінәлама
Dialogue: 0,0:14:41.75,0:14:43.54,Default,,0,0,0,,Басқалар қажет емес
Dialogue: 0,0:14:44.00,0:14:47.67,Default,,0,0,0,,Жоқ, мен басқа ештеңеге қызықпайтын адаммын.
Dialogue: 0,0:14:47.76,0:14:48.97,Default,,0,0,0,,Ол мүлде ақымақ.
Dialogue: 0,0:14:49.88,0:14:52.34,Default,,0,0,0,,А... бұл тітіркендіргіш.
Dialogue: 0,0:14:53.10,0:14:54.14,Default,,0,0,0,,Әрі қарай жүрейік
Dialogue: 0,0:14:55.85,0:14:59.69,Default,,0,0,0,,Сондықтан да болар, оның көз ұшқыр көрінуі.
Dialogue: 0,0:15:01.40,0:15:02.48,Default,,0,0,0,,Мен басқашамын
Dialogue: 0,0:15:03.81,0:15:07.48,Default,,0,0,0,,Мен мұнда жеңіліп, қайтып кетсем де, өмір сүре аламын.
Dialogue: 0,0:15:08.15,0:15:11.53,Default,,0,0,0,,Рей патша, сен менің мұрагерімсің.
Dialogue: 0,0:15:12.53,0:15:13.95,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:15:14.03,0:15:16.74,Default,,0,0,0,,Сіз де өз сыныбыңыздың жоғарғы жағында болдыңыз.
Dialogue: 0,0:15:16.83,0:15:21.08,Default,,0,0,0,,Үздік университетке түсіп, үздік бизнесмен болыңыз
Dialogue: 0,0:15:25.46,0:15:27.55,Default,,0,0,0,,Жоқ, бас тарт.
Dialogue: 0,0:15:27.63,0:15:30.67,Default,,0,0,0,,Менен асып түсу үшін тудың.
Dialogue: 0,0:15:31.26,0:15:35.10,Default,,0,0,0,,Футболшы тек таңдаулы адам бола алады.
Dialogue: 0,0:15:37.51,0:15:39.35,Default,,0,0,0,,Сіз болу мүмкін емес
Dialogue: 0,0:15:39.77,0:15:41.31,Default,,0,0,0,,Сен туралы ойлау
Dialogue: 0,0:15:41.39,0:15:43.56,Default,,0,0,0,,Мен мұны сен үшін айтып отырмын.
Dialogue: 0,0:15:44.36,0:15:45.40,Default,,0,0,0,,Сіздің...
Dialogue: 0,0:15:45.61,0:15:46.77,Default,,0,0,0,,...
Dialogue: 0,0:15:49.90,0:15:50.78,Default,,0,0,0,,Хан…
Dialogue: 0,0:15:52.45,0:15:54.37,Default,,0,0,0,,Бұл шынымен ақымақтық
Dialogue: 0,0:15:56.28,0:16:00.00,Default,,0,0,0,,Ол жаққа қайтып барсам да, мен тек зерігуді табамын.
Dialogue: 0,0:16:01.12,0:16:03.75,Default,,0,0,0,,Менің қалағаным осында
Dialogue: 0,0:16:04.88,0:16:05.96,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:06.04,0:16:08.05,Default,,0,0,0,,Тек осында
Dialogue: 0,0:16:10.01,0:16:13.05,Default,,0,0,0,,Бұл із-түзсіз жоғалып кететін арман болса...
Dialogue: 0,0:16:13.13,0:16:15.59,Default,,0,0,0,,Мен де барлық киімдерімді шешіп алдым...
Dialogue: 0,0:16:18.10,0:16:19.64,Default,,0,0,0,,Мен ақымақ боламын!
Dialogue: 0,0:16:20.02,0:16:21.10,Default,,0,0,0,,Кеттік
Dialogue: 0,0:16:21.18,0:16:22.56,Default,,0,0,0,,Мен... Мия!?
Dialogue: 0,0:16:24.02,0:16:26.65,Default,,0,0,0,,Сіз екі көзілдірікті жақсы емессіз бе?
Dialogue: 0,0:16:26.73,0:16:27.94,Default,,0,0,0,,Бұл сүйкімді емес.
Dialogue: 0,0:16:28.02,0:16:29.15,Default,,0,0,0,,Екінші!
Dialogue: 0,0:16:30.90,0:16:32.36,Default,,0,0,0,,Қанша созылсаң да...
Dialogue: 0,0:16:33.57,0:16:36.20,Default,,0,0,0,,Егер мен тек 99 ұпай алсам...
Dialogue: 0,0:16:36.28,0:16:37.95,Default,,0,0,0,,Хан... жүр!
Dialogue: 0,0:16:39.12,0:16:41.70,Default,,0,0,0,,Барлығын жоғары деңгейде ойнай алады—
Dialogue: 0,0:16:41.79,0:16:42.91,Default,,0,0,0,,Ептілік дегеніміз...
Dialogue: 0,0:16:44.71,0:16:46.54,Default,,0,0,0,,Менің талантыма келсек...
Dialogue: 0,0:16:46.63,0:16:49.34,Default,,0,0,0,,Қайтадан ашуға батыл болыңыз!
Dialogue: 0,0:16:51.59,0:16:54.80,Default,,0,0,0,,Қақпа алдынан келе жатқан пас! Мына қақпаншыдан абай бол!
Dialogue: 0,0:16:55.22,0:16:57.80,Default,,0,0,0,,Мен енді тапқыр кедей емеспін...
Dialogue: 0,0:16:57.89,0:17:00.14,Default,,0,0,0,,Мені шебер миллионер деп атаңыз.
Dialogue: 0,0:17:00.72,0:17:04.60,Default,,0,0,0,,Саған қарсы күресу үшін өз күшімді пайдалану.
Dialogue: 0,0:17:05.81,0:17:07.48,Default,,0,0,0,,Кел, патша Рей, міне қазір...
Dialogue: 0,0:17:09.61,0:17:10.90,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:12.61,0:17:14.86,Default,,0,0,0,,Оны сыртқа шығарма, Наги.
Dialogue: 0,0:17:14.95,0:17:16.61,Default,,0,0,0,,Өту... жоқ!
Dialogue: 0,0:17:16.70,0:17:18.07,Default,,0,0,0,,Иә? Соқ!?
Dialogue: 0,0:17:18.57,0:17:21.49,Default,,0,0,0,,Көк рокпен өзгере аласыз—
Dialogue: 0,0:17:21.58,0:17:24.33,Default,,0,0,0,,Мен де кез келген түсті өзгерте аламын!
Dialogue: 0,0:17:26.67,0:17:28.79,Default,,0,0,0,,Толтырылған! Тепкі мисс!
Dialogue: 0,0:17:28.88,0:17:32.30,Default,,0,0,0,,Ха... бұл орбита, бұрынғыдай болады деп ойламадым...
Dialogue: 0,0:17:36.30,0:17:38.05,Default,,0,0,0,,
Dialogue: 0,0:17:40.01,0:17:43.35,Default,,0,0,0,,Шынымды айтсам, ол жігіт... Юкимияның көшірмесі ғой!?
Dialogue: 0,0:17:46.56,0:17:49.31,Default,,0,0,0,,Бұл менің жаңа стилім
Dialogue: 0,0:17:49.40,0:17:50.94,Default,,0,0,0,,Хамелеон
Dialogue: 0,0:17:54.53,0:17:55.61,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:17:56.61,0:17:57.95,Default,,0,0,0,,Король Рейдің қазіргі мақсаты —
Dialogue: 0,0:17:58.03,0:18:01.16,Default,,0,0,0,,Өзінің ептілігін толық пайдаланатын көшіру қабілеті
Dialogue: 0,0:18:02.49,0:18:03.62,Default,,0,0,0,,Бұл –
Dialogue: 0,0:18:03.70,0:18:07.71,Default,,0,0,0,,Рей Микадждың Blue Rock-та аман қалуға жауабы!
Dialogue: 0,0:18:08.25,0:18:09.37,Default,,0,0,0,,Хе!
Dialogue: 0,0:18:09.46,0:18:12.54,Default,,0,0,0,,Көшіру... ондай нәрсе жеңілмейді.
Dialogue: 0,0:18:12.63,0:18:15.13,Default,,0,0,0,,Жоқ, бұл жай көшірме.
Dialogue: 0,0:18:15.59,0:18:18.18,Default,,0,0,0,,Біреудің әдіс-тәсілдеріне қаншалықты шебер еліктесең де...
Dialogue: 0,0:18:18.26,0:18:21.09,Default,,0,0,0,,Тек 99% қайта шығаруға болады
Dialogue: 0,0:18:21.18,0:18:22.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:22.30,0:18:25.43,Default,,0,0,0,,100% немесе одан да күшті түпнұсқамен күрессеңіз
Dialogue: 0,0:18:25.52,0:18:27.64,Default,,0,0,0,,Сіз оңай жеңе алмайсыз.
Dialogue: 0,0:18:28.10,0:18:29.85,Default,,0,0,0,,Әрине?
Dialogue: 0,0:18:29.94,0:18:33.11,Default,,0,0,0,,Көшіру мүмкін болса да, түпнұсқаның нашарлаған нұсқасы.
Dialogue: 0,0:18:33.27,0:18:35.61,Default,,0,0,0,,Сонымен қатар, жылдамдық пен биіктік –
Dialogue: 0,0:18:35.69,0:18:38.61,Default,,0,0,0,,Бұл қайталанбайтын ерекше физикалық қабілет болуы мүмкін.
Dialogue: 0,0:18:39.20,0:18:42.49,Default,,0,0,0,,Мен бұған қалай жауап беруді және оны бұзуды көре алмаймын.
Dialogue: 0,0:18:43.45,0:18:47.45,Default,,0,0,0,,Басқаша айтқанда, Рейоның көшірмесі әлі де дамып келе жатқан жаңа қабілет.
Dialogue: 0,0:18:48.00,0:18:49.08,Default,,0,0,0,,
Dialogue: 0,0:18:50.96,0:18:55.80,Default,,0,0,0,,(Қорытынды ысқырық)
Dialogue: 0,0:18:55.88,0:18:57.21,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:18:57.80,0:18:59.26,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:19:00.26,0:19:03.55,Default,,0,0,0,,Үздік 6-ны жеңгенше жарамсыз ба?
Dialogue: 0,0:19:05.10,0:19:08.02,Default,,0,0,0,,Бірақ мен жүруім керек эволюциялық жолды анық көрдім.
Dialogue: 0,0:19:09.77,0:19:11.98,Default,,0,0,0,,Сіз жеңілдіңіз, Рейо.
Dialogue: 0,0:19:13.94,0:19:16.61,Default,,0,0,0,,Бірақ бұл жақсы гол болды.
Dialogue: 0,0:19:17.23,0:19:22.57,Default,,0,0,0,,Керемет, сен әлгі жігіттің қаруына қарап, көшіріп аласың, епті болғаның қызық.
Dialogue: 0,0:19:28.62,0:19:29.79,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:30.54,0:19:32.17,Default,,0,0,0,,Бұл әлі де жеткіліксіз...
Dialogue: 0,0:19:32.88,0:19:34.92,Default,,0,0,0,,Қалаған футбол үшін
Dialogue: 0,0:19:36.75,0:19:37.92,Default,,0,0,0,,Иә
Dialogue: 0,0:19:38.01,0:19:39.21,Default,,0,0,0,,Хань…
Dialogue: 0,0:19:39.30,0:19:41.01,Default,,0,0,0,,Олай болса, маған бәрібір.
Dialogue: 0,0:19:41.09,0:19:42.34,Default,,0,0,0,,Төмен қарап, күтіңіз.
Dialogue: 0,0:19:43.55,0:19:45.43,Default,,0,0,0,,Сенің мені қуа бергің келетіні жеткілікті.
Dialogue: 0,0:19:45.51,0:19:47.18,Default,,0,0,0,,Мен адам боламын
Dialogue: 0,0:19:51.85,0:19:52.90,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:19:59.11,0:20:00.15,Default,,0,0,0,,Я...
Dialogue: 0,0:20:02.15,0:20:06.49,Default,,0,0,0,,Мен әрқашан қалағанымды аламын
Dialogue: 0,0:20:08.91,0:20:14.17,Default,,0,0,0,,♪~
Dialogue: 0,0:21:32.95,0:21:36.79,Default,,0,0,0,,~♪
Dialogue: 0,0:21:39.17,0:21:41.29,Default,,0,0,0,,О, мынау!
Dialogue: 0,0:21:41.38,0:21:42.46,Default,,0,0,0,,Итоши Саекун!
Dialogue: 0,0:21:42.55,0:21:45.05,Default,,0,0,0,,Кездесуге келгеніңізге рахмет!
Dialogue: 0,0:21:45.13,0:21:48.01,Default,,0,0,0,,Танысқаныма қуаныштымын, Гений-кун!
Dialogue: 0,0:21:51.76,0:21:54.81,Default,,0,0,0,,Ах, эй, Са Чан, мұны істе!
Dialogue: 0,0:21:55.23,0:21:58.19,Default,,0,0,0,,Бұл кім? Бұл семіз және қабілетсіз ақымақ
Dialogue: 0,0:21:58.85,0:22:01.69,Default,,0,0,0,,Уф... Әй, төраға мен директор!
Dialogue: 0,0:22:01.77,0:22:03.90,Default,,0,0,0,,Бұл тез.
Dialogue: 0,0:22:03.98,0:22:07.82,Default,,0,0,0,,Мен 20 жасқа дейінгі Жапония құрамасының кадрларын тексердім, бірақ...
Dialogue: 0,0:22:08.24,0:22:10.16,Default,,0,0,0,,Бір сөзбен айтқанда: ақымақ.
Dialogue: 0,0:22:11.16,0:22:12.20,Default,,0,0,0,,Әсіресе алға -
Dialogue: 0,0:22:12.28,0:22:14.75,Default,,0,0,0,,Қайнаған құсу ғана бар.
Dialogue: 0,0:22:16.00,0:22:18.83,Default,,0,0,0,,Өйткені мен Blue Rock жігіттеріне қарсы ойнай аламын—
Dialogue: 0,0:22:18.92,0:22:21.13,Default,,0,0,0,,Мен бұл шақыруды қабылдадым, бірақ...
Dialogue: 0,0:22:21.21,0:22:23.92,Default,,0,0,0,,Клуб қызметінің бұл деңгейі туралы айтудың қажеті жоқ.
Dialogue: 0,0:22:24.34,0:22:25.42,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:22:26.67,0:22:28.22,Default,,0,0,0,,Ей, егер сіз гебоны қайнатсаңыз ...
Dialogue: 0,0:22:28.30,0:22:30.80,Default,,0,0,0,,Сіз менің командама тіл тигізгіңіз келе ме?
Dialogue: 0,0:22:30.89,0:22:33.89,Default,,0,0,0,,Ал, жарайды, енді мен ересек болдым, Хоичи-чан.
Dialogue: 0,0:22:33.97,0:22:37.60,Default,,0,0,0,,Мен... Итоши Саекун, сен шабуылшыларды ұнатпайсың, солай ма?
Dialogue: 0,0:22:37.98,0:22:40.94,Default,,0,0,0,,Бұл жағдайда сіз жаңа біреуді шақыра аласыз.
Dialogue: 0,0:22:41.02,0:22:44.07,Default,,0,0,0,,Жасыңыз асып кетсе де, аңыз болса да!
Dialogue: 0,0:22:44.86,0:22:46.40,Default,,0,0,0,,Кез келген адам жақсы, солай ма?
Dialogue: 0,0:22:46.49,0:22:48.57,Default,,0,0,0,,Иә, иә! Егер сіз жапон болсаңыз!
Dialogue: 0,0:22:48.65,0:22:50.61,Default,,0,0,0,,Тіпті Рамос! Тіпті Казу!
Dialogue: 0,0:22:51.82,0:22:53.08,Default,,0,0,0,,Кем дегенде хабарласып қойсаңыз болар еді!
Dialogue: 0,0:22:54.24,0:22:58.46,Default,,0,0,0,,Blue Rock-та мен бірлескім келетін бір FW бар.
Dialogue: 0,0:23:05.09,0:23:08.34,Default,,0,0,0,,(Ойын дыбысы)
Dialogue: 0,0:23:08.80,0:23:10.43,Default,,0,0,0,,Наги-кун туралы бірдеңе...
Dialogue: 0,0:23:10.51,0:23:12.05,Default,,0,0,0,,Жалқаулыққа ұқсайды.
Dialogue: 0,0:23:12.14,0:23:12.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:13.35,0:23:15.60,Default,,0,0,0,,Менің ойымша, бұл туралы мен білмеймін.
Dialogue: 0,0:23:15.68,0:23:17.47,Default,,0,0,0,,Иә, мұндай нәрсе.
Dialogue: 0,0:23:18.10,0:23:21.35,Default,,0,0,0,,Екінші жағынан, Юкки солай көрінеді.
Dialogue: 0,0:23:21.44,0:23:23.06,Default,,0,0,0,,Психопат Тарсиер
Dialogue: 0,0:23:23.15,0:23:26.36,Default,,0,0,0,,Бұл нені білдіреді? иә?
Dialogue: 0,0:23:27.11,0:23:31.36,Default,,0,0,0,,Егер сіз көзілдірік киіп жүрсеңіз, сізбен бір командада болған Зантецу-кун бар шығар.
Dialogue: 0,0:23:31.45,0:23:35.37,Default,,0,0,0,,Иә? Менің ойымша, Зантецу тарсиерге ұқсамайды.
Dialogue: 0,0:23:35.45,0:23:37.83,Default,,0,0,0,,Көзілдірік кигендіктен, бұл өте оңай.
Dialogue: 0,0:23:38.25,0:23:41.16,Default,,0,0,0,,Иә? Сіз қандай бағалау критерийлерін қолданасыз?
Dialogue: 0,0:23:41.25,0:23:42.79,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:23:42.87,0:23:44.42,Default,,0,0,0,,Сонымен, Рейо-кун ше?
Dialogue: 0,0:23:44.88,0:23:47.80,Default,,0,0,0,,Хм... Рей патша — хамелеон ғой.
Dialogue: 0,0:23:47.88,0:23:49.21,Default,,0,0,0,,Ах~ Мен мұны түсіндім!
Dialogue: 0,0:23:49.30,0:23:51.68,Default,,0,0,0,,Көшіру Көшіру
Dialogue: 0,0:23:51.76,0:23:53.68,Default,,0,0,0,,Ант-кун таяқша жәндікке ұқсамайды ма?
Dialogue: 0,0:23:53.76,0:23:55.01,Default,,0,0,0,,Оша~
Dialogue: 0,0:23:55.10,0:23:57.01,Default,,0,0,0,,Ах~ Ошафуши
Dialogue: 0,0:23:57.10,0:23:59.10,Default,,0,0,0,,Содан кейін Киёши...
Dialogue: 0,0:23:59.18,0:24:00.27,Default,,0,0,0,,Қоңыздармен
Dialogue: 0,0:24:00.35,0:24:01.39,Default,,0,0,0,,Жаман
Dialogue: 0,0:24:01.48,0:24:03.60,Default,,0,0,0,,Хахахаха! Сол шаш үлгісі!
Dialogue: 0,0:24:03.69,0:24:05.81,Default,,0,0,0,,Мару бастық горилла ма?
Dialogue: 0,0:24:05.90,0:24:07.02,Default,,0,0,0,,Біліктілігі жоқ Ухо
Dialogue: 0,0:24:07.11,0:24:08.98,Default,,0,0,0,,Бұл бет дерлік!
Dialogue: 0,0:24:09.07,0:24:11.07,Default,,0,0,0,,А, Токимицу – әйел горилла.
Dialogue: 0,0:24:11.15,0:24:11.99,Default,,0,0,0,,Укья!
Dialogue: 0,0:24:12.07,0:24:13.61,Default,,0,0,0,,Мару-кунмен жұп құру!
Dialogue: 0,0:24:13.70,0:24:14.82,Default,,0,0,0,,Ухо
Dialogue: 0,0:24:16.12,0:24:18.58,Default,,0,0,0,,Олай болса, Ринкун ше?
Dialogue: 0,0:24:18.66,0:24:19.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:19.87,0:24:21.66,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:24:22.33,0:24:23.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:23.87,0:24:25.29,Default,,0,0,0,,Шлам құбыжығы?
Dialogue: 0,0:24:25.38,0:24:27.00,Default,,0,0,0,,Бояу Бояу
Dialogue: 0,0:24:27.09,0:24:30.42,Default,,0,0,0,,А, сәтсіз тәжірибеден туған қайғылы тіршілік формасы?
Dialogue: 0,0:24:30.51,0:24:32.92,Default,,0,0,0,,Иә, тиіп кетсең улы.
Dialogue: 0,0:24:33.01,0:24:34.97,Default,,0,0,0,,Бояу Бояу
Dialogue: 0,0:24:35.47,0:24:36.68,Default,,0,0,0,,Шлам деген кім?
Dialogue: 0,0:24:36.76,0:24:38.47,Default,,0,0,0,,- (Наги) Ах... - (Юкимия) О, жоқ...
Dialogue: 0,0:24:38.56,0:24:40.89,Default,,0,0,0,,Сондай-ақ, Киёши қоңыз емес.
Dialogue: 0,0:24:40.97,0:24:44.48,Default,,0,0,0,,Бұл қос құлақты антенналар құстар жейтін дернәсілдер болса керек.
Dialogue: 0,0:24:44.56,0:24:47.65,Default,,0,0,0,,Сен қазір жақсы жердесің, данышпан~!
Dialogue: 0,0:24:47.73,0:24:49.57,Default,,0,0,0,,Әрине.
Dialogue: 0,0:24:49.65,0:24:51.44,Default,,0,0,0,,1 саны күткендей
Dialogue: 0,0:24:51.53,0:24:53.24,Default,,0,0,0,,Осы ойынды доғарайық.
Dialogue: 0,0:24:53.32,0:24:55.11,Default,,0,0,0,,Ешкім жеңбейді
Dialogue: 0,0:24:56.61,0:25:02.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory