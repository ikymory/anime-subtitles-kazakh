Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.98,0:00:11.98,Default,,0000,0000,0000,,Sae
Dialogue: 0,0:00:09.98,0:00:11.98,Default,,0000,0000,0000,,Егер мен жеңсем→
Dialogue: 0,0:00:11.98,0:00:13.98,Default,,0000,0000,0000,,Біздің арманымыз аяқталды.
Dialogue: 0,0:00:15.98,0:00:18.99,Default,,0000,0000,0000,,Маған ұнамайды... Мен...
Dialogue: 0,0:00:18.99,0:00:20.99,Default,,0000,0000,0000,,Мен бұлай ұрысқым келмейді...
Dialogue: 0,0:00:20.99,0:00:22.99,Default,,0000,0000,0000,,Кеттік, Рин.
Dialogue: 0,0:00:25.99,0:00:27.99,Default,,0000,0000,0000,,Бұл бір реттік матч.
Dialogue: 0,0:00:30.00,0:00:32.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:00:49.02,0:00:51.02,Default,,0000,0000,0000,,《Неге...》
Dialogue: 0,0:00:51.02,0:00:53.02,Default,,0000,0000,0000,,《Үлкен аға! ! 》
Dialogue: 0,0:00:53.02,0:00:57.02,Default,,0000,0000,0000,,Рин... Соңғы төрт жыл бойы менсіз болдыңыз...
Dialogue: 0,0:00:57.02,0:00:59.03,Default,,0000,0000,0000,,(Допты тепкен дыбысы)
Dialogue: 0,0:00:59.03,0:01:00.96,Default,,0000,0000,0000,,(Мақсат торының тербелу дыбысы)
Dialogue: 0,0:01:00.96,0:01:04.96,Default,,0000,0000,0000,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:01:04.96,0:01:08.97,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:01:08.97,0:01:10.97,Default,,0000,0000,0000,,(ойыншық құлаған дыбыс)
Dialogue: 0,0:01:14.97,0:01:18.98,Default,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:01:19.98,0:01:22.98,Default,,0000,0000,0000,,қыдыру
Dialogue: 0,0:01:19.98,0:01:22.98,Default,,0000,0000,0000,,Эго
Dialogue: 0,0:01:19.98,0:01:22.98,Default,,0000,0000,0000,,«Дайындық жақсы жүріп жатыр ма? Ешін-күн».
Dialogue: 0,0:01:22.98,0:01:25.99,Default,,0000,0000,0000,,“Хе-хи-хи…”
Dialogue: 0,0:01:25.99,0:01:27.99,Default,,0000,0000,0000,,«Мен саған ризамын».
Dialogue: 0,0:01:27.99,0:01:31.99,Default,,0000,0000,0000,,«Сол Итоши Сае
Dialogue: 0,0:01:27.99,0:01:31.99,Default,,0000,0000,0000,,Blue Rock-қа деген қызығушылығымның арқасында →
Dialogue: 0,0:01:31.99,0:01:37.00,Default,,0000,0000,0000,,Бұқаралық ақпарат құралдары да шу шығарып жатыр
Dialogue: 0,0:01:31.99,0:01:37.00,Default,,0000,0000,0000,,Билеттер бірден сатылып кетті».
Dialogue: 0,0:01:37.00,0:01:40.00,Default,,0000,0000,0000,,«Үлкен сіріңкелер үлкен ақшаға айналды».
Dialogue: 0,0:01:40.00,0:01:44.00,Default,,0000,0000,0000,,«Сіз жасаған тапшылық
Dialogue: 0,0:01:40.00,0:01:44.00,Default,,0000,0000,0000,,Аздап толады».
Dialogue: 0,0:01:46.01,0:01:48.01,Default,,0000,0000,0000,,Кітапша аяқталды ма?
Dialogue: 0,0:01:50.01,0:01:53.01,Default,,0000,0000,0000,,«Сіз байсалдысыз ба?»
Dialogue: 0,0:01:53.01,0:01:56.02,Default,,0000,0000,0000,,«Ереуілшілер тобы →
Dialogue: 0,0:01:56.02,0:02:00.95,Default,,0000,0000,0000,,Элита элитасы
Dialogue: 0,0:01:56.02,0:02:00.95,Default,,0000,0000,0000,,Жиырмаға дейін
Dialogue: 0,0:01:56.02,0:02:00.95,Default,,0000,0000,0000,,Қалай ойлайсыз, біз U-20 Жапония құрамасын жеңе аламыз ба? »
Dialogue: 0,0:02:00.95,0:02:07.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:07.96,0:02:10.96,Default,,0000,0000,0000,,А... Мен мұны айтуым керек еді.
Dialogue: 0,0:02:10.96,0:02:15.97,Default,,0000,0000,0000,,Жапон футболы нені өзгертеді?
Dialogue: 0,0:02:10.96,0:02:15.97,Default,,0000,0000,0000,,Көк жартас.
Dialogue: 0,0:02:21.98,0:02:29.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:05.95,0:04:08.95,Default,,0000,0000,0000,,«Сендер таланттың асыл тастары».
Dialogue: 0,0:04:08.95,0:04:13.95,Default,,0000,0000,0000,,«Сіз
Dialogue: 0,0:04:08.95,0:04:13.95,Default,,0000,0000,0000,,Еліміздің түкпір-түкпірінен келген 300 орта мектеп ереуілшілерінен→
Dialogue: 0,0:04:13.95,0:04:15.96,Default,,0000,0000,0000,,Қиын таңдаудан аман қалды →
Dialogue: 0,0:04:15.96,0:04:20.96,Default,,0000,0000,0000,,Әлемдегі ең үлкен эгоист болуды мақсат еткен отыз бес адам».
Dialogue: 0,0:04:22.96,0:04:25.97,Default,,0000,0000,0000,,«Матч үш аптадан кейін.»
Dialogue: 0,0:04:25.97,0:04:29.97,Default,,0000,0000,0000,,«Қарсылас – Сае Итоши басқаратын U-20 Жапония құрамасы.»
Dialogue: 0,0:04:31.97,0:04:33.97,Default,,0000,0000,0000,,Жеңіске жетсең өкіл боласың...→
Dialogue: 0,0:04:33.97,0:04:35.98,Default,,0000,0000,0000,,Сіздің.
Dialogue: 0,0:04:35.98,0:04:38.98,Default,,0000,0000,0000,,«Бірақ ұтылып қалсақ→
Dialogue: 0,0:04:38.98,0:04:41.98,Default,,0000,0000,0000,,Көк жартас жоғалады».
Dialogue: 0,0:04:43.98,0:04:48.99,Default,,0000,0000,0000,,Исаги
Dialogue: 0,0:04:43.98,0:04:48.99,Default,,0000,0000,0000,,Йоичи
Dialogue: 0,0:04:43.98,0:04:48.99,Default,,0000,0000,0000,,《Бірнеше ай бұрын анонимді
Dialogue: 0,0:04:43.98,0:04:48.99,Default,,0000,0000,0000,,Мен ешкім емес едім...》
Dialogue: 0,0:04:48.99,0:04:51.99,Default,,0000,0000,0000,,《Көк жартасқа қоңырау шалып, эго туралы білді→
Dialogue: 0,0:04:51.99,0:04:54.99,Default,,0000,0000,0000,,Мен өлім сызығынан өтіп, осында келдім》
Dialogue: 0,0:04:56.00,0:04:58.00,Default,,0000,0000,0000,,《Егер бұл шайқаста жеңсек→
Dialogue: 0,0:04:58.00,0:05:01.00,Default,,0000,0000,0000,,Мен Жапонияның өкілі бола аламын! 》
Dialogue: 0,0:05:01.93,0:05:05.94,Default,,0000,0000,0000,,《Бірақ мен ұтылып қалсам→
Dialogue: 0,0:05:05.94,0:05:10.94,Default,,0000,0000,0000,,Көк жартастың жоғалуымен
Dialogue: 0,0:05:05.94,0:05:10.94,Default,,0000,0000,0000,,Менің футболдағы мансабым аяқталды.
Dialogue: 0,0:05:11.94,0:05:13.95,Default,,0000,0000,0000,,《Бұл шайқас →
Dialogue: 0,0:05:13.95,0:05:17.95,Default,,0000,0000,0000,,Осы қолдармен
Dialogue: 0,0:05:13.95,0:05:17.95,Default,,0000,0000,0000,,Сіздің өміріңізді толығымен өзгерте алатын матч! 》
Dialogue: 0,0:05:17.95,0:05:19.95,Default,,0000,0000,0000,,Раичи
Dialogue: 0,0:05:17.95,0:05:19.95,Default,,0000,0000,0000,,Джинго
Dialogue: 0,0:05:17.95,0:05:19.95,Default,,0000,0000,0000,,Сәлем! Бір минут күтіңіз.
Dialogue: 0,0:05:19.95,0:05:23.96,Default,,0000,0000,0000,,Мен бұл мүмкіндік екенін білемін, бірақ
Dialogue: 0,0:05:19.95,0:05:23.96,Default,,0000,0000,0000,,Мүшелер не істеуі керек? ?
Dialogue: 0,0:05:23.96,0:05:26.96,Default,,0000,0000,0000,,Біз бәріміз алғамыз! ?
Dialogue: 0,0:05:26.96,0:05:31.96,Default,,0000,0000,0000,,Олардың арасында жартылай қорғаушы бар екеніне сене алар емеспін.
Dialogue: 0,0:05:26.96,0:05:31.96,Default,,0000,0000,0000,,Сіз де қорғаушы таңдайсыз ба?
Dialogue: 0,0:05:31.96,0:05:33.97,Default,,0000,0000,0000,,«Әрине.»
Dialogue: 0,0:05:33.97,0:05:37.97,Default,,0000,0000,0000,,«Бұл форвард емес
Dialogue: 0,0:05:33.97,0:05:37.97,Default,,0000,0000,0000,,Бізде асығыс жиналған командамен күресуден басқа амал жоқ».
Dialogue: 0,0:05:37.97,0:05:39.97,Default,,0000,0000,0000,,«Арба Титаны»!!
Dialogue: 0,0:05:37.97,0:05:39.97,Default,,0000,0000,0000,,Бұл... ақылға қонымсыз!
Dialogue: 0,0:05:39.97,0:05:42.98,Default,,0000,0000,0000,,Екінші тарап
Dialogue: 0,0:05:39.97,0:05:42.98,Default,,0000,0000,0000,,Сіз кәсіби қорғаушысыз ба?
Dialogue: 0,0:05:42.98,0:05:44.98,Default,,0000,0000,0000,,Арюу
Dialogue: 0,0:05:42.98,0:05:44.98,Default,,0000,0000,0000,,Қиындық→
Dialogue: 0,0:05:44.98,0:05:47.98,Default,,0000,0000,0000,,Бұл «маған» ұнатпайтын даму емес.
Dialogue: 0,0:05:44.98,0:05:47.98,Default,,0000,0000,0000,,Токимицу
Dialogue: 0,0:05:44.98,0:05:47.98,Default,,0000,0000,0000,,Э…?—
Dialogue: 0,0:05:47.98,0:05:50.98,Default,,0000,0000,0000,,Ей, ұнайды немесе ұнамайды деп жатсаңыз...!
Dialogue: 0,0:05:50.98,0:05:52.99,Default,,0000,0000,0000,,«Абайлаңыз!»
Dialogue: 0,0:05:53.99,0:05:58.99,Default,,0000,0000,0000,,Мен қазір есімдерін атайтын алты адамға тоқталу
Dialogue: 0,0:05:53.99,0:05:58.99,Default,,0000,0000,0000,,Топ құру.
Dialogue: 0,0:05:58.99,0:06:05.00,Default,,0000,0000,0000,,Мына балалар
Dialogue: 0,0:05:58.99,0:06:05.00,Default,,0000,0000,0000,,Үздік алтылық
Dialogue: 0,0:05:58.99,0:06:05.00,Default,,0000,0000,0000,,Ағымдағы Blue Rock жалпы бағасы ТОП6.
Dialogue: 0,0:06:05.93,0:06:07.93,Default,,0000,0000,0000,,«Шақырылғандар алға шығу керек».
Dialogue: 0,0:06:07.93,0:06:09.94,Default,,0000,0000,0000,,«Ең алдымен...»
Dialogue: 0,0:06:11.94,0:06:13.94,Default,,0000,0000,0000,,«Итоши Рин»
Dialogue: 0,0:06:15.94,0:06:17.94,Default,,0000,0000,0000,,《Рин…》
Dialogue: 0,0:06:17.94,0:06:19.95,Default,,0000,0000,0000,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:06:17.94,0:06:19.95,Default,,0000,0000,0000,,《Ол 1-ші нөмір ғой...! 》
Dialogue: 0,0:06:21.95,0:06:23.95,Default,,0000,0000,0000,,Екі
Dialogue: 0,0:06:21.95,0:06:23.95,Default,,0000,0000,0000,,«Келесі №2».
Dialogue: 0,0:06:23.95,0:06:25.95,Default,,0000,0000,0000,,Рюсей
Dialogue: 0,0:06:23.95,0:06:25.95,Default,,0000,0000,0000,,«Шидо Рюсей»
Dialogue: 0,0:06:25.95,0:06:29.96,Default,,0000,0000,0000,,Шығу. Бабион!
Dialogue: 0,0:06:29.96,0:06:32.96,Default,,0000,0000,0000,,Иә! ? Бұл керемет пе? сен!
Dialogue: 0,0:06:33.96,0:06:35.96,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:06:35.96,0:06:39.97,Default,,0000,0000,0000,,Сен бірінші, мен екінші... иә?
Dialogue: 0,0:06:39.97,0:06:41.97,Default,,0000,0000,0000,,Бұл мені тоңазытады!
Dialogue: 0,0:06:42.97,0:06:44.97,Default,,0000,0000,0000,,《Тағы төрт адам...! 》
Dialogue: 0,0:06:44.97,0:06:47.97,Default,,0000,0000,0000,,Үш
Dialogue: 0,0:06:44.97,0:06:47.97,Default,,0000,0000,0000,,Қарға Табито
Dialogue: 0,0:06:44.97,0:06:47.97,Default,,0000,0000,0000,,«3-нөмірлі қарға саяхатшысы»
Dialogue: 0,0:06:49.98,0:06:51.98,Default,,0000,0000,0000,,Қандай бұлыңғыр.
Dialogue: 0,0:06:54.98,0:06:57.98,Default,,0000,0000,0000,,Төрт
Dialogue: 0,0:06:54.98,0:06:57.98,Default,,0000,0000,0000,,Отоя
Dialogue: 0,0:06:54.98,0:06:57.98,Default,,0000,0000,0000,,Эйта
Dialogue: 0,0:06:54.98,0:06:57.98,Default,,0000,0000,0000,,«№4 Отоя Кагета»
Dialogue: 0,0:06:58.99,0:07:00.99,Default,,0000,0000,0000,,Чусс.
Dialogue: 0,0:07:01.92,0:07:04.92,Default,,0000,0000,0000,,Бес
Dialogue: 0,0:07:01.92,0:07:04.92,Default,,0000,0000,0000,,Кенюу
Dialogue: 0,0:07:01.92,0:07:04.92,Default,,0000,0000,0000,,«№5 Кеню Юкимия»
Dialogue: 0,0:07:04.92,0:07:07.93,Default,,0000,0000,0000,,Иә, бұл құрмет.
Dialogue: 0,0:07:07.93,0:07:09.93,Default,,0000,0000,0000,,《Тағы бір адам...》
Dialogue: 0,0:07:09.93,0:07:11.93,Default,,0000,0000,0000,,《Мен де қосылғым келеді...》
Dialogue: 0,0:07:11.93,0:07:13.93,Default,,0000,0000,0000,,《Ешін жасамақшы→
Dialogue: 0,0:07:13.93,0:07:16.94,Default,,0000,0000,0000,,Blue Rock Onbir орталығында...! 》
Dialogue: 0,0:07:16.94,0:07:18.94,Default,,0000,0000,0000,,«Соңғы 6 саны...»
Dialogue: 0,0:07:21.94,0:07:23.94,Default,,0000,0000,0000,,«Наги Сейширо»
Dialogue: 0,0:07:23.94,0:07:25.95,Default,,0000,0000,0000,,Уа...
Dialogue: 0,0:07:29.95,0:07:32.95,Default,,0000,0000,0000,,«Міне, солай».
Dialogue: 0,0:07:29.95,0:07:32.95,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:07:32.95,0:07:37.96,Default,,0000,0000,0000,,«Ешін-сан, мен неге 5-ші орында тұрмын?
Dialogue: 0,0:07:32.95,0:07:37.96,Default,,0000,0000,0000,,Бірінші орыннан қандай айырмашылығы бар? »
Dialogue: 0,0:07:37.96,0:07:39.96,Default,,0000,0000,0000,,«Бұл қарапайым».
Dialogue: 0,0:07:39.96,0:07:41.96,Default,,0000,0000,0000,,«Қалған 35 адамның →
Dialogue: 0,0:07:41.96,0:07:45.97,Default,,0000,0000,0000,,Әлемдік іріктеу қарсыласына
Dialogue: 0,0:07:41.96,0:07:45.97,Default,,0000,0000,0000,,Кім гол соға алды→
Dialogue: 0,0:07:45.97,0:07:48.97,Default,,0000,0000,0000,,Итоши Рин және Шидо Рюсей».
Dialogue: 0,0:07:48.97,0:07:51.97,Default,,0000,0000,0000,,``Алғашқы таңдаудағы ұпайлар саны ғана қалды →
Dialogue: 0,0:07:51.97,0:07:54.97,Default,,0000,0000,0000,,Әлемдік іріктеуден алынған бағалау негізінде».
Dialogue: 0,0:07:54.97,0:07:56.98,Default,,0000,0000,0000,,«Соңында…→
Dialogue: 0,0:07:56.98,0:07:58.98,Default,,0000,0000,0000,,Бұл менің жеке таңдауым».
Dialogue: 0,0:07:58.98,0:08:01.91,Default,,0000,0000,0000,,Vegetation
Dialogue: 0,0:07:58.98,0:08:01.91,Default,,0000,0000,0000,,«Сенімдісің бе? Model Yu көзілдірігі»
Dialogue: 0,0:08:01.91,0:08:03.92,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:01.91,0:08:03.92,Default,,0000,0000,0000,,Гагамару
Dialogue: 0,0:08:01.91,0:08:03.92,Default,,0000,0000,0000,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:08:03.92,0:08:05.92,Default,,0000,0000,0000,,Ол кісі де үлгі болып жұмыс істейді.
Dialogue: 0,0:08:05.92,0:08:08.92,Default,,0000,0000,0000,,Бұл жиіркенішті...
Dialogue: 0,0:08:05.92,0:08:08.92,Default,,0000,0000,0000,,Крокодил
Dialogue: 0,0:08:05.92,0:08:08.92,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:08.92,0:08:11.92,Default,,0000,0000,0000,,«Қазір
Dialogue: 0,0:08:08.92,0:08:11.92,Default,,0000,0000,0000,,Бұл келесі таңдау».
Dialogue: 0,0:08:11.92,0:08:16.93,Default,,0000,0000,0000,,«Біріншіден, осы алты адам
Dialogue: 0,0:08:11.92,0:08:16.93,Default,,0000,0000,0000,,Жоғарыдан 2 адамнан 3 командаға бөліну.
Dialogue: 0,0:08:18.93,0:08:23.94,Default,,0000,0000,0000,,«Қалған 29 адам
Dialogue: 0,0:08:18.93,0:08:23.94,Default,,0000,0000,0000,,Қай командаға қосылғыңыз келетінін таңдаңыз».
Dialogue: 0,0:08:23.94,0:08:26.94,Default,,0000,0000,0000,,«Ал әр команданың 6 үздік мүшесі →
Dialogue: 0,0:08:26.94,0:08:30.94,Default,,0000,0000,0000,,Әрқайсысына 3 адамнан қосып, 5 → топ жасаңыз
Dialogue: 0,0:08:30.94,0:08:33.95,Default,,0000,0000,0000,,5-тен 5-ке бір матч өткізіңіз».
Dialogue: 0,0:08:33.95,0:08:35.95,Default,,0000,0000,0000,,《Мен көремін》
Dialogue: 0,0:08:35.95,0:08:41.95,Default,,0000,0000,0000,,《TOP6 ойыншыларының тамаша шабуыл формасы
Dialogue: 0,0:08:35.95,0:08:41.95,Default,,0000,0000,0000,,Сіз дұрыс адамды іздеп жүрсіз бе?
Dialogue: 0,0:08:41.95,0:08:45.96,Default,,0000,0000,0000,,«TOP6-дан басқа 29 адам
Dialogue: 0,0:08:41.95,0:08:45.96,Default,,0000,0000,0000,,Берілген мүмкіндік →
Dialogue: 0,0:08:45.96,0:08:47.96,Default,,0000,0000,0000,,Бір-ақ рет».
Dialogue: 0,0:08:47.96,0:08:49.96,Default,,0000,0000,0000,,«Бұл→
Dialogue: 0,0:08:49.96,0:08:55.97,Default,,0000,0000,0000,,Жапонияның U-20 құрамасына қарсы тұрақты ойын өткізді
Dialogue: 0,0:08:49.96,0:08:55.97,Default,,0000,0000,0000,,Сынақ.”
Dialogue: 0,0:08:55.97,0:08:58.97,Default,,0000,0000,0000,,Сіз бір матчта бар екеніңізді көрсеткіңіз келе ме?
Dialogue: 0,0:08:58.97,0:09:01.91,Default,,0000,0000,0000,,Ол шындап кәсіби көрінеді...
Dialogue: 0,0:09:01.91,0:09:03.91,Default,,0000,0000,0000,,Ха, бұл тамаша!
Dialogue: 0,0:09:03.91,0:09:05.91,Default,,0000,0000,0000,,«Сонымен қатар адам санына байланысты →
Dialogue: 0,0:09:05.91,0:09:08.92,Default,,0000,0000,0000,,Екі ойын үшін тек бір адам күреседі.''
Dialogue: 0,0:09:08.92,0:09:13.92,Default,,0000,0000,0000,,Жеті
Dialogue: 0,0:09:08.92,0:09:13.92,Default,,0000,0000,0000,,«ТОП6-дан кейін 7-ші орынға бағаланды→
Dialogue: 0,0:09:13.92,0:09:17.92,Default,,0000,0000,0000,,Бачира
Dialogue: 0,0:09:13.92,0:09:17.92,Default,,0000,0000,0000,,Айнала
Dialogue: 0,0:09:13.92,0:09:17.92,Default,,0000,0000,0000,,Хачираку Кай, сен бұл рөлді алуың керек».
Dialogue: 0,0:09:18.93,0:09:20.93,Default,,0000,0000,0000,,Аиаайсааааааааааааааааааааааа
Dialogue: 0,0:09:20.93,0:09:24.93,Default,,0000,0000,0000,,《Қырсық...! Біз бірге күресуіміз керек еді →
Dialogue: 0,0:09:24.93,0:09:27.93,Default,,0000,0000,0000,,Олар менен артық па? 》
Dialogue: 0,0:09:27.93,0:09:31.94,Default,,0000,0000,0000,,«ТОП 6 Балалар, сендер басқа бөлмеге барасыңдар».
Dialogue: 0,0:09:31.94,0:09:33.94,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:35.94,0:09:38.95,Default,,0000,0000,0000,,«Бұл жай ғана
Dialogue: 0,0:09:35.94,0:09:38.95,Default,,0000,0000,0000,,Ағымдағы бағалау тәртібімен».
Dialogue: 0,0:09:38.95,0:09:40.95,Default,,0000,0000,0000,,«ТОП6 болса да→
Dialogue: 0,0:09:40.95,0:09:45.95,Default,,0000,0000,0000,,Тестілеу нәтижесінде
Dialogue: 0,0:09:40.95,0:09:45.95,Default,,0000,0000,0000,,Рейтингтер өзгеретінін ұмытпаңыз.
Dialogue: 0,0:09:47.95,0:09:51.96,Default,,0000,0000,0000,,«Енді қалған 29 адамға айтып берейін».
Dialogue: 0,0:09:51.96,0:09:54.96,Default,,0000,0000,0000,,«Тестілеуді жоюдың кілті →
Dialogue: 0,0:09:54.96,0:09:56.96,Default,,0000,0000,0000,,Бекіту және бірге өмір сүру».
Dialogue: 0,0:09:56.96,0:10:00.97,Default,,0000,0000,0000,,«Даралығы мен ұпай жинау қабілеті күшті 6-ға қарсы→
Dialogue: 0,0:10:00.97,0:10:02.97,Default,,0000,0000,0000,,Өз құндылығыңызды «бекіту» →
Dialogue: 0,0:10:02.97,0:10:06.97,Default,,0000,0000,0000,,алмастырылмайтын тіршілік ретінде «бірге өмір сүреді».
Dialogue: 0,0:10:06.97,0:10:08.98,Default,,0000,0000,0000,,«Соңында...»
Dialogue: 0,0:10:06.97,0:10:08.98,Default,,0000,0000,0000,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:10:10.98,0:10:13.98,Default,,0000,0000,0000,,Риога
Dialogue: 0,0:10:10.98,0:10:13.98,Default,,0000,0000,0000,,«Бізден асып түсетініңді көрсет!»
Dialogue: 0,0:10:13.98,0:10:19.99,Default,,0000,0000,0000,,Сізге
Dialogue: 0,0:10:13.98,0:10:19.99,Default,,0000,0000,0000,,ТОП6 бірге күресетін достар емес.
Dialogue: 0,0:10:19.99,0:10:22.99,Default,,0000,0000,0000,,Мені алдау үшін оны трамплин ретінде пайдаланыңыз!
Dialogue: 0,0:10:22.99,0:10:29.00,Default,,0000,0000,0000,,《Болашақты анықтайтын ойынға қатысу
Dialogue: 0,0:10:22.99,0:10:29.00,Default,,0000,0000,0000,,Біріншіден, сіз тұрақты болуыңыз керек...》
Dialogue: 0,0:10:30.00,0:10:33.00,Default,,0000,0000,0000,,«Енді таңдаңыз.»
Dialogue: 0,0:10:33.00,0:10:37.00,Default,,0000,0000,0000,,«Болашағың мен тағдырыңды қолыңда ұстаймын.
Dialogue: 0,0:10:33.00,0:10:37.00,Default,,0000,0000,0000,,Менің ең жақсы командаластарым».
Dialogue: 0,0:10:39.01,0:10:41.01,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:10:46.01,0:10:48.01,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:10:48.01,0:10:51.02,Default,,0000,0000,0000,,Igagri...
Dialogue: 0,0:10:48.01,0:10:51.02,Default,,0000,0000,0000,,Сізде әр түрлі заттар бар! ?
Dialogue: 0,0:10:51.02,0:10:55.02,Default,,0000,0000,0000,,Оны тек бүгін кешке ғана жеуге болады.
Dialogue: 0,0:10:51.02,0:10:55.02,Default,,0000,0000,0000,,Жемесең, шығын!
Dialogue: 0,0:10:55.02,0:10:57.02,Default,,0000,0000,0000,,Дүниелік қалауымды төмендетпе!
Dialogue: 0,0:10:57.02,0:10:59.96,Default,,0000,0000,0000,,Жердегі тілектер...Біреуін аламын.
Dialogue: 0,0:10:59.96,0:11:02.96,Default,,0000,0000,0000,,Ах! Өзіңіз әкеліңіз!
Dialogue: 0,0:10:59.96,0:11:02.96,Default,,0000,0000,0000,,Мухо!
Dialogue: 0,0:11:02.96,0:11:05.97,Default,,0000,0000,0000,,Татар тұздығымен дүние тілегі. Дәмді.
Dialogue: 0,0:11:02.96,0:11:05.97,Default,,0000,0000,0000,,Түкір, түкір! Жұтпаңыз!
Dialogue: 0,0:11:05.97,0:11:07.97,Default,,0000,0000,0000,,Жұтпас бұрын түкір!
Dialogue: 0,0:11:05.97,0:11:07.97,Default,,0000,0000,0000,,Няхаха! Бұл жердегі тілектердің жиынтығы!
Dialogue: 0,0:11:07.97,0:11:10.97,Default,,0000,0000,0000,,Гагамару, мен саған таяқша беремін.
Dialogue: 0,0:11:07.97,0:11:10.97,Default,,0000,0000,0000,,Мұны қолданбаңыз!
Dialogue: 0,0:11:10.97,0:11:12.97,Default,,0000,0000,0000,,Аузыңды жап, тамақ іш!
Dialogue: 0,0:11:12.97,0:11:14.97,Default,,0000,0000,0000,,Алайда →
Dialogue: 0,0:11:14.97,0:11:19.98,Default,,0000,0000,0000,,Z командасының барлық бұрынғы мүшелері жиналады...
Dialogue: 0,0:11:14.97,0:11:19.98,Default,,0000,0000,0000,,Мен бұлай айта алмас едім.
Dialogue: 0,0:11:19.98,0:11:23.98,Default,,0000,0000,0000,,Нарухая
Dialogue: 0,0:11:19.98,0:11:23.98,Default,,0000,0000,0000,,Иә... Нарухаясыз өзімді жалғыз сезінемін...
Dialogue: 0,0:11:24.98,0:11:29.99,Default,,0000,0000,0000,,Куон
Dialogue: 0,0:11:24.98,0:11:29.99,Default,,0000,0000,0000,,Сондай-ақ сатқындық Куон мен әйелдік Имамура
Dialogue: 0,0:11:24.98,0:11:29.99,Default,,0000,0000,0000,,Иемон
Dialogue: 0,0:11:24.98,0:11:29.99,Default,,0000,0000,0000,,Қақпашы Иемон….
Dialogue: 0,0:11:31.99,0:11:36.00,Default,,0000,0000,0000,,Кунигами
Dialogue: 0,0:11:31.99,0:11:36.00,Default,,0000,0000,0000,,Және Кунигами...
Dialogue: 0,0:11:36.00,0:11:41.00,Default,,0000,0000,0000,,Шынымды айтсам.
Dialogue: 0,0:11:36.00,0:11:41.00,Default,,0000,0000,0000,,Мен Куниками құлайды деп күтпедім...
Dialogue: 0,0:11:41.00,0:11:43.00,Default,,0000,0000,0000,,Ол жігіт күшті.
Dialogue: 0,0:11:45.00,0:11:47.01,Default,,0000,0000,0000,,Шидо оны тастап кетті...
Dialogue: 0,0:11:47.01,0:11:50.01,Default,,0000,0000,0000,,Жыртылу
Dialogue: 0,0:11:47.01,0:11:50.01,Default,,0000,0000,0000,,Гиома
Dialogue: 0,0:11:47.01,0:11:50.01,Default,,0000,0000,0000,,Бұл Көк жартас...
Dialogue: 0,0:11:50.01,0:11:52.01,Default,,0000,0000,0000,,Ұсақталған….
Dialogue: 0,0:11:52.01,0:11:57.02,Default,,0000,0000,0000,,U-20 құрамасынан жеңілсек ше?
Dialogue: 0,0:11:52.01,0:11:57.02,Default,,0000,0000,0000,,Бұл жердің өзі жоғалады.
Dialogue: 0,0:11:57.02,0:12:00.95,Default,,0000,0000,0000,,Бізде де басқа адамдар туралы уайымдауға уақыт жоқ.
Dialogue: 0,0:12:00.95,0:12:02.96,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:12:02.96,0:12:05.96,Default,,0000,0000,0000,,Балалар сендер қай командаға қосылуды шештіңдер ме?
Dialogue: 0,0:12:05.96,0:12:07.96,Default,,0000,0000,0000,,Гепп….
Dialogue: 0,0:12:07.96,0:12:11.96,Default,,0000,0000,0000,,Мен А тобындамын.
Dialogue: 0,0:12:07.96,0:12:11.96,Default,,0000,0000,0000,,Мен көптен бері жұмыс істеп жүрген Шидо бар.
Dialogue: 0,0:12:11.96,0:12:15.97,Default,,0000,0000,0000,,Мен В немесе С деп ойлаймын. Қандай да бір түрде интуитивті.
Dialogue: 0,0:12:16.97,0:12:18.97,Default,,0000,0000,0000,,Мен лотерея арқылы шешемін!
Dialogue: 0,0:12:18.97,0:12:21.97,Default,,0000,0000,0000,,Әйтеуір екі ойын болады деп жалғыз маған айтты.
Dialogue: 0,0:12:21.97,0:12:25.98,Default,,0000,0000,0000,,О, түсіндім.
Dialogue: 0,0:12:21.97,0:12:25.98,Default,,0000,0000,0000,,Ақырында, сіз бұрынғы Z командасын алға шығардыңыз!
Dialogue: 0,0:12:25.98,0:12:27.98,Default,,0000,0000,0000,,Маған ұнамайды!
Dialogue: 0,0:12:27.98,0:12:31.98,Default,,0000,0000,0000,,Мен эгоистпін! Чигирин ше?
Dialogue: 0,0:12:31.98,0:12:33.99,Default,,0000,0000,0000,,Мен әлі шешкен жоқпын... Киёши ше?
Dialogue: 0,0:12:34.99,0:12:37.99,Default,,0000,0000,0000,,Хмм... Мен...
Dialogue: 0,0:12:37.99,0:12:41.99,Default,,0000,0000,0000,,A немесе C?
Dialogue: 0,0:12:37.99,0:12:41.99,Default,,0000,0000,0000,,Рин-чанның орны немесе Нагидің орны.
Dialogue: 0,0:12:41.99,0:12:45.00,Default,,0000,0000,0000,,Иә... Иә. Мен өте жақсы түсінемін ...
Dialogue: 0,0:12:46.00,0:12:49.00,Default,,0000,0000,0000,,Қаруыңызбен химиялық реакция жасағыңыз келсе...→
Dialogue: 0,0:12:49.00,0:12:52.00,Default,,0000,0000,0000,,Комбинацияларды қолдана алатын Наги бар.
Dialogue: 0,0:12:49.00,0:12:52.00,Default,,0000,0000,0000,,С командасы.
Dialogue: 0,0:12:52.00,0:12:56.01,Default,,0000,0000,0000,,Бірақ одан әлі асып түскен жоқ.
Dialogue: 0,0:12:52.00,0:12:56.01,Default,,0000,0000,0000,,Егер сіз белгісіз мүмкіндіктерге ставка жасағыңыз келсе →
Dialogue: 0,0:12:56.01,0:12:59.01,Default,,0000,0000,0000,,А командасы Рин Чанмен.
Dialogue: 0,0:12:59.01,0:13:01.01,Default,,0000,0000,0000,,...Бұл не?
Dialogue: 0,0:12:59.01,0:13:01.01,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:13:01.95,0:13:04.95,Default,,0000,0000,0000,,《“Бекіту” және “бірге өмір сүру”…》
Dialogue: 0,0:13:05.95,0:13:09.96,Default,,0000,0000,0000,,《Кіммен бірігуім керек?
Dialogue: 0,0:13:05.95,0:13:09.96,Default,,0000,0000,0000,,Бұл мен үшін ең жақсысы! ? 》
Dialogue: 0,0:13:15.96,0:13:17.96,Default,,0000,0000,0000,,(Ойын дыбысы)
Dialogue: 0,0:13:17.96,0:13:20.97,Default,,0000,0000,0000,,Бұл Кенью Юкимия. сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:13:21.97,0:13:24.97,Default,,0000,0000,0000,,Сейширо Наги. Құрметпен, Glasses-kun.
Dialogue: 0,0:13:24.97,0:13:28.97,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:13:24.97,0:13:28.97,Default,,0000,0000,0000,,Үлкен ағам сені қорғап қалар еді,
Dialogue: 0,0:13:24.97,0:13:28.97,Default,,0000,0000,0000,,Бізді қандай адам таңдайды?
Dialogue: 0,0:13:30.98,0:13:32.98,Default,,0000,0000,0000,,Бұл алғаш рет.
Dialogue: 0,0:13:32.98,0:13:35.98,Default,,0000,0000,0000,,Тату болайық, №1.
Dialogue: 0,0:13:36.98,0:13:40.99,Default,,0000,0000,0000,,Оны елемеңіз
Dialogue: 0,0:13:36.98,0:13:40.99,Default,,0000,0000,0000,,Біз командаласпыз.
Dialogue: 0,0:13:41.99,0:13:44.99,Default,,0000,0000,0000,,Сізге жарылыс ұнайды ма?
Dialogue: 0,0:13:44.99,0:13:46.99,Default,,0000,0000,0000,,Маған қызық емес...
Dialogue: 0,0:13:46.99,0:13:48.99,Default,,0000,0000,0000,,Өзіңді жоғалт, антенна бейбақ.
Dialogue: 0,0:13:50.00,0:13:52.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:55.00,0:13:58.00,Default,,0000,0000,0000,,О, бұл жақсы. О, құдайым.
Dialogue: 0,0:13:55.00,0:13:58.00,Default,,0000,0000,0000,,Пом-Пун!
Dialogue: 0,0:13:58.00,0:14:00.94,Default,,0000,0000,0000,,Тоқтауым керек пе?
Dialogue: 0,0:13:58.00,0:14:00.94,Default,,0000,0000,0000,,Ха, мені жайына қалдыр.
Dialogue: 0,0:14:00.94,0:14:03.94,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:14:00.94,0:14:03.94,Default,,0000,0000,0000,,Бір-бірімізді жаншып алсақ, ақша таба аламыз.
Dialogue: 0,0:14:03.94,0:14:06.95,Default,,0000,0000,0000,,Сәлем! басына оқ тигізу….
Dialogue: 0,0:14:06.95,0:14:10.95,Default,,0000,0000,0000,,Теме...
Dialogue: 0,0:14:06.95,0:14:10.95,Default,,0000,0000,0000,,Егер менің футбол ойыныма кедергі жасасаң, мен сені өлтіремін.
Dialogue: 0,0:14:10.95,0:14:13.95,Default,,0000,0000,0000,,Менің ойнайтыным футбол емес...→
Dialogue: 0,0:14:13.95,0:14:16.96,Default,,0000,0000,0000,,Бұл өмірлік іс-әрекет!
Dialogue: 0,0:14:16.96,0:14:19.96,Default,,0000,0000,0000,,«(Қол соғу дыбысы)»
Dialogue: 0,0:14:16.96,0:14:19.96,Default,,0000,0000,0000,,«Жарайды, ойнама».
Dialogue: 0,0:14:21.96,0:14:23.96,Default,,0000,0000,0000,,Біліңіз.
Dialogue: 0,0:14:24.96,0:14:28.97,Default,,0000,0000,0000,,«Сіз
Dialogue: 0,0:14:24.96,0:14:28.97,Default,,0000,0000,0000,,Былайша айтқанда, олар Көк жартастың элитасы».
Dialogue: 0,0:14:28.97,0:14:31.97,Default,,0000,0000,0000,,«Мен әр комбинацияны ойлай аламын→
Dialogue: 0,0:14:31.97,0:14:35.98,Default,,0000,0000,0000,,Ағымдағы эксперименттік супер шабуыл түрі 2 TOP»
Dialogue: 0,0:14:35.98,0:14:39.98,Default,,0000,0000,0000,,«Өзіңіз жасай алмайтын жаңа шабуылды көрсетіңіз».
Dialogue: 0,0:14:39.98,0:14:44.98,Default,,0000,0000,0000,,«Екінші тарап
Dialogue: 0,0:14:39.98,0:14:44.98,Default,,0000,0000,0000,,Оны әлемдегі ең жақсы болуға көмектесетін құрал деп ойлаңыз».
Dialogue: 0,0:14:44.98,0:14:46.99,Default,,0000,0000,0000,,«Ал қателессем де →
Dialogue: 0,0:14:46.99,0:14:51.99,Default,,0000,0000,0000,,ТОП6-дан басқа адамдарға
Dialogue: 0,0:14:46.99,0:14:51.99,Default,,0000,0000,0000,,Ол лауазымды тартып алма».
Dialogue: 0,0:14:51.99,0:14:56.00,Default,,0000,0000,0000,,«Сендер Көк жартастың шыңындасыңдар...»
Dialogue: 0,0:14:57.00,0:14:59.00,Default,,0000,0000,0000,,Сіз жасаған футбол →
Dialogue: 0,0:14:59.00,0:15:02.94,Default,,0000,0000,0000,,Яйба
Dialogue: 0,0:14:59.00,0:15:02.94,Default,,0000,0000,0000,,Жапон футболын бұзатын жүзге айналу
Dialogue: 0,0:14:59.00,0:15:02.94,Default,,0000,0000,0000,,Біліңіз.
Dialogue: 0,0:15:02.94,0:15:09.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:09.94,0:15:13.95,Default,,0000,0000,0000,,Мен сіздің «шақыруыңызды» көргім келеді.
Dialogue: 0,0:15:16.95,0:15:20.95,Default,,0000,0000,0000,,《Біріншіден, бұл сынақ
Dialogue: 0,0:15:16.95,0:15:20.95,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? 》
Dialogue: 0,0:15:21.95,0:15:25.96,Default,,0000,0000,0000,,《«Бірге өмір сүру» нені білдіреді?
Dialogue: 0,0:15:21.95,0:15:25.96,Default,,0000,0000,0000,,ТОП6-мен химиялық реакция...? 》
Dialogue: 0,0:15:26.96,0:15:30.96,Default,,0000,0000,0000,,《Бірақ «талаптарға» келгенде
Dialogue: 0,0:15:26.96,0:15:30.96,Default,,0000,0000,0000,,Оған жерлеуге болмайды...? 》
Dialogue: 0,0:15:31.96,0:15:36.97,Default,,0000,0000,0000,,《Оны өзіңіз таңдаңыз.
Dialogue: 0,0:15:31.96,0:15:36.97,Default,,0000,0000,0000,,Бір ғана сәйкестікте нәтижеге қол жеткізіңіз →
Dialogue: 0,0:15:36.97,0:15:39.97,Default,,0000,0000,0000,,Бұл таңдау өте қиын! 》
Dialogue: 0,0:15:39.97,0:15:41.97,Default,,0000,0000,0000,,Ах! Мен білмеймін!
Dialogue: 0,0:15:41.97,0:15:43.98,Default,,0000,0000,0000,,Бару
Dialogue: 0,0:15:41.97,0:15:43.98,Default,,0000,0000,0000,,Шоэй
Dialogue: 0,0:15:41.97,0:15:43.98,Default,,0000,0000,0000,,Шулы.
Dialogue: 0,0:15:43.98,0:15:46.98,Default,,0000,0000,0000,,Сіз не туралы шатасасыз? Жарайды.
Dialogue: 0,0:15:46.98,0:15:48.98,Default,,0000,0000,0000,,Сіз Мару туралы шешім қабылдадыңыз ба?
Dialogue: 0,0:15:48.98,0:15:51.98,Default,,0000,0000,0000,,Мазасыз кусао
Dialogue: 0,0:15:48.98,0:15:51.98,Default,,0000,0000,0000,,Мазасыз адам бар С-дан басқа.
Dialogue: 0,0:15:52.99,0:15:55.99,Default,,0000,0000,0000,,Мен білетін адаммен қайталап көрсем де
Dialogue: 0,0:15:52.99,0:15:55.99,Default,,0000,0000,0000,,Бұл өсу үшін жақсы емес →
Dialogue: 0,0:15:55.99,0:15:59.93,Default,,0000,0000,0000,,Қайда барсаңыз да
Dialogue: 0,0:15:55.99,0:15:59.93,Default,,0000,0000,0000,,Мен өзімді сол жерге қойып, патша боламын.
Dialogue: 0,0:15:59.93,0:16:01.93,Default,,0000,0000,0000,,Осымен.
Dialogue: 0,0:16:01.93,0:16:04.93,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:16:01.93,0:16:04.93,Default,,0000,0000,0000,,Өзіңмен болғаның дұрыс.
Dialogue: 0,0:16:04.93,0:16:08.93,Default,,0000,0000,0000,,Киёши Цука
Dialogue: 0,0:16:04.93,0:16:08.93,Default,,0000,0000,0000,,Неліктен сіз үздік 6-ға кірмейсіз?
Dialogue: 0,0:16:08.93,0:16:11.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:08.93,0:16:11.94,Default,,0000,0000,0000,,(Аузын шайып жатқан жылқы қасқырының дыбысы)
Dialogue: 0,0:16:11.94,0:16:13.94,Default,,0000,0000,0000,,Бұл тітіркендіргіш.
Dialogue: 0,0:16:13.94,0:16:16.94,Default,,0000,0000,0000,,Сен мен құртамын.
Dialogue: 0,0:16:16.94,0:16:19.95,Default,,0000,0000,0000,,Ондай жерге көмілмесін.
Dialogue: 0,0:16:16.94,0:16:19.95,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:16:19.95,0:16:22.95,Default,,0000,0000,0000,,О... ой…. кешіріңіз.
Dialogue: 0,0:16:22.95,0:16:24.95,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:16:22.95,0:16:24.95,Default,,0000,0000,0000,,(Адамды қалдыру)
Dialogue: 0,0:16:24.95,0:16:26.95,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:26.95,0:16:29.96,Default,,0000,0000,0000,,Нико
Dialogue: 0,0:16:26.95,0:16:29.96,Default,,0000,0000,0000,,Ikki
Dialogue: 0,0:16:26.95,0:16:29.96,Default,,0000,0000,0000,,Киёши-кун
Dialogue: 0,0:16:26.95,0:16:29.96,Default,,0000,0000,0000,,Мен осы безеуден тұратын бетке арналған жуғышты қарызға аламын.
Dialogue: 0,0:16:29.96,0:16:31.96,Default,,0000,0000,0000,,Не? Әй, екі бала!
Dialogue: 0,0:16:32.96,0:16:36.96,Default,,0000,0000,0000,,Қай команданы таңдау керек екенін әлі шешіп жатырсыз ба?
Dialogue: 0,0:16:32.96,0:16:36.96,Default,,0000,0000,0000,,Сіз әлі шешпеген сияқтысыз.
Dialogue: 0,0:16:36.96,0:16:38.96,Default,,0000,0000,0000,,Иә. о қымбаттым….
Dialogue: 0,0:16:40.97,0:16:43.97,Default,,0000,0000,0000,,Көк
Dialogue: 0,0:16:40.97,0:16:43.97,Default,,0000,0000,0000,,Ешін-сан бәсекелестік сезімін оятуда→
Dialogue: 0,0:16:43.97,0:16:48.97,Default,,0000,0000,0000,,Соңында ТОП6-ға кіре аламыз ба?
Dialogue: 0,0:16:43.97,0:16:48.97,Default,,0000,0000,0000,,Менің ойымша, сіз сынақтан өтіп жатырсыз.
Dialogue: 0,0:16:48.97,0:16:51.98,Default,,0000,0000,0000,,Ол сәйкес келе ме?
Dialogue: 0,0:16:48.97,0:16:51.98,Default,,0000,0000,0000,,Екі бала шешім қабылдады ма?
Dialogue: 0,0:16:52.98,0:16:56.98,Default,,0000,0000,0000,,Бұл анық
Dialogue: 0,0:16:52.98,0:16:56.98,Default,,0000,0000,0000,,Сіздің стиліңізді ұстанатын қарсыласты таңдаңыз.
Dialogue: 0,0:16:56.98,0:16:59.99,Default,,0000,0000,0000,,Мен фольга ретінде пайдаланылғаным үшін кешірім сұраймын.
Dialogue: 0,0:17:00.92,0:17:04.92,Default,,0000,0000,0000,,Мен сізден басты рөлді алып кететін нәрсе екенін білдім.
Dialogue: 0,0:17:05.92,0:17:09.93,Default,,0000,0000,0000,,Басты кейіпкер бола алатын адам...
Dialogue: 0,0:17:14.93,0:17:16.94,Default,,0000,0000,0000,,Әзірше, Киёши-кун...
Dialogue: 0,0:17:14.93,0:17:16.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:16.94,0:17:18.94,Default,,0000,0000,0000,,Сіз ертерек кете аласыз ба?
Dialogue: 0,0:17:18.94,0:17:21.94,Default,,0000,0000,0000,,Маңдайымды жуып жатқанымды көргім келмейді.
Dialogue: 0,0:17:21.94,0:17:23.94,Default,,0000,0000,0000,,Иә! ? Ой кешір...
Dialogue: 0,0:17:23.94,0:17:25.94,Default,,0000,0000,0000,,...
Dialogue: 0,0:17:23.94,0:17:25.94,Default,,0000,0000,0000,,《Қандай ұят...? 》
Dialogue: 0,0:17:26.95,0:17:32.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:32.95,0:17:36.96,Default,,0000,0000,0000,,《Ринмен бірге өзіңізді командада қалай жарнамалауға болады?
Dialogue: 0,0:17:32.95,0:17:36.96,Default,,0000,0000,0000,,Бұл оңай болмайтынына сенімдімін...》
Dialogue: 0,0:17:36.96,0:17:40.96,Default,,0000,0000,0000,,《Көміліп, қолынан ештеңе келмей
Dialogue: 0,0:17:36.96,0:17:40.96,Default,,0000,0000,0000,,Оның аяқталу мүмкіндігі бар...》
Dialogue: 0,0:17:41.96,0:17:44.96,Default,,0000,0000,0000,,《Мен бірге болуым керек адам ол...''
Dialogue: 0,0:17:46.97,0:17:49.97,Default,,0000,0000,0000,,Микадж
Dialogue: 0,0:17:46.97,0:17:49.97,Default,,0000,0000,0000,,Арыстан
Dialogue: 0,0:17:46.97,0:17:49.97,Default,,0000,0000,0000,,Бұл оңай шешім емес.
Dialogue: 0,0:17:49.97,0:17:53.97,Default,,0000,0000,0000,,Рей патша!
Dialogue: 0,0:17:49.97,0:17:53.97,Default,,0000,0000,0000,,Мен үшін де солай.
Dialogue: 0,0:17:53.97,0:17:56.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:53.97,0:17:56.98,Default,,0000,0000,0000,,Наги командасын таңдамайсың ба?
Dialogue: 0,0:17:56.98,0:18:00.91,Default,,0000,0000,0000,,Ха... Наги екеумізді ажыраттыңдар.
Dialogue: 0,0:17:56.98,0:18:00.91,Default,,0000,0000,0000,,Маған айтқым келмейді.
Dialogue: 0,0:18:00.91,0:18:02.92,Default,,0000,0000,0000,,Ах! кешіріңіз….
Dialogue: 0,0:18:03.92,0:18:06.92,Default,,0000,0000,0000,,Мен мұны жоспарлап едім, бірақ...→
Dialogue: 0,0:18:06.92,0:18:08.92,Default,,0000,0000,0000,,Мен адасып қалдым.
Dialogue: 0,0:18:08.92,0:18:10.92,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:18:10.92,0:18:16.93,Default,,0000,0000,0000,,Ал, қайталама іріктеу кезінде.
Dialogue: 0,0:18:10.92,0:18:16.93,Default,,0000,0000,0000,,Ол сені таңдады →
Dialogue: 0,0:18:16.93,0:18:21.93,Default,,0000,0000,0000,,Мен оны қайтадан көргім келеді
Dialogue: 0,0:18:16.93,0:18:21.93,Default,,0000,0000,0000,,Мен осы уақытқа дейін келдім ...
Dialogue: 0,0:18:22.94,0:18:24.94,Default,,0000,0000,0000,,Бірақ...→
Dialogue: 0,0:18:24.94,0:18:30.94,Default,,0000,0000,0000,,Үздік 6-ға кірген жігітті қараңыз
Dialogue: 0,0:18:24.94,0:18:30.94,Default,,0000,0000,0000,,Егер сіз оны қазіргі деңгейіңізбен байсалды түрде салыстырсаңыз...
Dialogue: 0,0:18:31.94,0:18:35.95,Default,,0000,0000,0000,,Әлгі жігіт барған сайын көбейіп барады
Dialogue: 0,0:18:31.94,0:18:35.95,Default,,0000,0000,0000,,Мен өзімді қолымнан тыс қалғандай сезінемін →
Dialogue: 0,0:18:35.95,0:18:38.95,Default,,0000,0000,0000,,Қатарласып күресуге сенімім жоқ.
Dialogue: 0,0:18:39.95,0:18:44.96,Default,,0000,0000,0000,,Бірақ егер сіз осы уақытты өткізіп алсаңыз
Dialogue: 0,0:18:39.95,0:18:44.96,Default,,0000,0000,0000,,Мен келесі жолы жоқ сияқты сезінемін.
Dialogue: 0,0:18:44.96,0:18:46.96,Default,,0000,0000,0000,,Бірақ менің қаншалықты пайдасыз екенімді көрсетсеңіз →
Dialogue: 0,0:18:46.96,0:18:49.96,Default,,0000,0000,0000,,Ол да
Dialogue: 0,0:18:46.96,0:18:49.96,Default,,0000,0000,0000,,Мен одан да алыс кететін сияқтымын...
Dialogue: 0,0:18:53.97,0:18:56.97,Default,,0000,0000,0000,,Мен не істерімді білмеймін...
Dialogue: 0,0:18:58.97,0:19:00.91,Default,,0000,0000,0000,,Мен де, Рей патша.
Dialogue: 0,0:19:00.91,0:19:02.91,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:02.91,0:19:05.91,Default,,0000,0000,0000,,Дұрыс... мұнда бірге күресу керек→
Dialogue: 0,0:19:05.91,0:19:09.92,Default,,0000,0000,0000,,Енді қол жеткізе алмайтын болмыс
Dialogue: 0,0:19:05.91,0:19:09.92,Default,,0000,0000,0000,,Бұл орын алуы мүмкін...
Dialogue: 0,0:19:10.92,0:19:13.92,Default,,0000,0000,0000,,Өйткені мен бұл өкінішті болғым келмейді...
Dialogue: 0,0:19:14.92,0:19:19.93,Default,,0000,0000,0000,,Ой... Рейу: Рахмет.
Dialogue: 0,0:19:14.92,0:19:19.93,Default,,0000,0000,0000,,Сізге рахмет, мен шешімімді қабылдадым.
Dialogue: 0,0:19:19.93,0:19:22.93,Default,,0000,0000,0000,,Мен бұл дұрыс нәрсе туралы емес екеніне сенімдімін.
Dialogue: 0,0:19:22.93,0:19:27.93,Default,,0000,0000,0000,,Сізге қажет нәрсе
Dialogue: 0,0:19:22.93,0:19:27.93,Default,,0000,0000,0000,,Сіздің таңдауыңыздың дұрыс екенін дәлелдеуге дайын болыңыз...
Dialogue: 0,0:19:28.93,0:19:34.94,Default,,0000,0000,0000,,Мен таңдаған жол
Dialogue: 0,0:19:28.93,0:19:34.94,Default,,0000,0000,0000,,Мен қателеспегенімді дәлелдеймін!
Dialogue: 0,0:19:37.94,0:19:42.95,Default,,0000,0000,0000,,Тейери
Dialogue: 0,0:19:37.94,0:19:42.95,Default,,0000,0000,0000,,«Дауыс беру аяқталды.
Dialogue: 0,0:19:37.94,0:19:42.95,Default,,0000,0000,0000,,Соңғы квотаны бастаңыз».
Dialogue: 0,0:19:42.95,0:19:45.95,Default,,0000,0000,0000,,«Костюміңізді киіп, мүмкіндігінше тезірек жиналыңыз».
Dialogue: 0,0:19:45.95,0:19:50.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:50.96,0:19:54.96,Default,,0000,0000,0000,,«Онда
Dialogue: 0,0:19:50.96,0:19:54.96,Default,,0000,0000,0000,,Біз тағайындалған командаларды жариялаймыз».
Dialogue: 0,0:19:54.96,0:19:59.97,Default,,0000,0000,0000,,《Енді, 20 жасқа дейінгі Жапония құрамасының матчына соңғы квота...》
Dialogue: 0,0:19:59.97,0:20:02.97,Default,,0000,0000,0000,,《Blue Rock Eleven үшін тұрақтыларды анықтаңыз
Dialogue: 0,0:19:59.97,0:20:02.97,Default,,0000,0000,0000,,Сынақ! 》
Dialogue: 0,0:20:02.97,0:20:05.97,Default,,0000,0000,0000,,《Мен таңдаған команда...》
Dialogue: 0,0:20:06.97,0:20:10.98,Default,,0000,0000,0000,,《Мен дәл қазір қасында тұрғым келетін адам →
Dialogue: 0,0:20:10.98,0:20:12.98,Default,,0000,0000,0000,,Бұл сенсің, Рин! 》
Dialogue: 0,0:20:14.98,0:20:17.98,Default,,0000,0000,0000,,《Хачираку мен сияқты А командасында болғысы келеді! 》
Dialogue: 0,0:20:19.99,0:20:24.99,Default,,0000,0000,0000,,《Мару Раиичи Футаго
Dialogue: 0,0:20:19.99,0:20:24.99,Default,,0000,0000,0000,,Чигири бір топ па?
Dialogue: 0,0:20:26.99,0:20:30.00,Default,,0000,0000,0000,,《Наги командасы бар
Dialogue: 0,0:20:26.99,0:20:30.00,Default,,0000,0000,0000,,Зантецу мен Гагамару...》
Dialogue: 0,0:20:30.00,0:20:33.00,Default,,0000,0000,0000,,《Аа... Рейода да С бар! 》
Dialogue: 0,0:20:33.00,0:20:37.00,Default,,0000,0000,0000,,《Ақыр соңында, сен
Dialogue: 0,0:20:33.00,0:20:37.00,Default,,0000,0000,0000,,Сіз Нагидің орнын таңдадыңыз》
Dialogue: 0,0:20:38.00,0:20:41.01,Default,,0000,0000,0000,,Сынақты жою кілті → болып табылады
Dialogue: 0,0:20:41.01,0:20:43.01,Default,,0000,0000,0000,,Шағымдар және ТОП6-мен бірге өмір сүру.
Dialogue: 0,0:20:44.01,0:20:47.01,Default,,0000,0000,0000,,《Олардың арасын кесу→
Dialogue: 0,0:20:47.01,0:20:50.02,Default,,0000,0000,0000,,Ең бастысы, сіз өз өміріңізді қалай алға жылжыта аласыз! 》
Dialogue: 0,0:20:51.02,0:20:54.02,Default,,0000,0000,0000,,《Ал осы шайқастан тыс→
Dialogue: 0,0:20:54.02,0:20:57.02,Default,,0000,0000,0000,,Жапон U-20 өкілі бар...! 》
Dialogue: 0,0:21:01.96,0:21:04.96,Default,,0000,0000,0000,,Хоичи-чан….
Dialogue: 0,0:21:04.96,0:21:06.97,Default,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,0:21:07.97,0:21:11.97,Default,,0000,0000,0000,,Иә. Жапон футбол әлемі үшін...
Dialogue: 0,0:21:12.97,0:21:14.97,Default,,0000,0000,0000,,(түсіру дыбысы)
Dialogue: 0,0:21:16.98,0:21:18.98,Default,,0000,0000,0000,,Оны ұсақтаңыз...
Dialogue: 0,0:21:18.98,0:21:20.98,Default,,0000,0000,0000,,Міндетті түрде жойыңыз...!
Dialogue: 0,0:21:20.98,0:21:24.98,Default,,0000,0000,0000,,Түсінбегендерге
Dialogue: 0,0:21:20.98,0:21:24.98,Default,,0000,0000,0000,,Жапон футбол әлемін жаулап алуына жол бермеңіз!
Dialogue: 0,0:21:25.98,0:21:27.99,Default,,0000,0000,0000,,Уайымдамаңыз.
Dialogue: 0,0:21:27.99,0:21:29.99,Default,,0000,0000,0000,,Олар идеалистік.
Dialogue: 0,0:21:29.99,0:21:34.99,Default,,0000,0000,0000,,Нағыз U-20 Жапония өкілі
Dialogue: 0,0:21:29.99,0:21:34.99,Default,,0000,0000,0000,,Бұл бізден басқа ешкім бола алмайды.
Dialogue: 0,0:21:35.99,0:21:39.00,Default,,0000,0000,0000,,Хе хи хи...!
Dialogue: 0,0:21:40.00,0:21:46.00,Default,,0000,0000,0000,,Мен күткендей Одақтан басқаны тыңдамаймын.
Dialogue: 0,0:21:40.00,0:21:46.00,Default,,0000,0000,0000,,Құлақсыз заң бірінші!
Dialogue: 0,0:21:46.00,0:21:50.01,Default,,0000,0000,0000,,Интернетте мені қорлап жатыр.
Dialogue: 0,0:21:46.00,0:21:50.01,Default,,0000,0000,0000,,Тоқтаңыз.
Dialogue: 0,0:21:50.01,0:21:52.01,Default,,0000,0000,0000,,Хе хе хи....
Dialogue: 0,0:21:50.01,0:21:52.01,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:21:52.01,0:21:56.01,Default,,0000,0000,0000,,Сондықтан. Мен мұны сұрадым, капитан!
Dialogue: 0,0:21:56.01,0:21:59.95,Default,,0000,0000,0000,,Айку
Dialogue: 0,0:21:56.01,0:21:59.95,Default,,0000,0000,0000,,Ай Ай Мен оны қабылдаймын.
Dialogue: 0,0:21:59.95,0:22:01.95,Default,,0000,0000,0000,,Көк тас.
Dialogue: 0,0:22:03.96,0:22:06.96,Default,,0000,0000,0000,,《Жеңіп ал және дәлелде...》
Dialogue: 0,0:22:06.96,0:22:11.96,Default,,0000,0000,0000,,《Мен әлемдегі ең үздік шабуылшы боламын! ! 》
Dialogue: 0,0:22:13.97,0:22:18.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:20.47,0:22:26.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory