Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.70,0:00:51.05,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:00:51.05,0:00:53.35,Default,,0,0,0,,Көз жасы?
Dialogue: 0,0:00:57.05,0:00:59.25,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:01:01.22,0:01:03.73,Default,,0,0,0,,Әй, эй, не болып жатыр?
Dialogue: 0,0:01:03.73,0:01:05.73,Default,,0,0,0,,Инуэ ше?
Dialogue: 0,0:01:05.73,0:01:09.90,Default,,0,0,0,,Жанына айырбас ретінде Инуэ➡
Dialogue: 0,0:01:09.90,0:01:12.73,Default,,0,0,0,,Ол Джухабахты жерледі.
Dialogue: 0,0:01:12.73,0:01:14.74,Default,,0,0,0,,Дұрыс, болды!
Dialogue: 0,0:01:17.41,0:01:19.81,Default,,0,0,0,,Амансың ба? Ах.
Dialogue: 0,0:01:22.41,0:01:25.75,Default,,0,0,0,,Инуэ қолында бардың бәрін пайдаланады➡
Dialogue: 0,0:01:25.75,0:01:29.59,Default,,0,0,0,,Бұл бізді бірге ұстады.
Dialogue: 0,0:01:29.59,0:01:34.39,Default,,0,0,0,,Ичиго. Әлем енді құтқарылды, солай ма?
Dialogue: 0,0:01:37.03,0:01:39.23,Default,,0,0,0,,Әлі жоқ. бұршақ пастасы?
Dialogue: 0,0:01:41.20,0:02:06.05,Default,,0,0,0,,♬～
Dialogue: 0,0:02:06.05,0:02:08.39,Default,,0,0,0,,Ичиго Сәлем...
Dialogue: 0,0:02:08.39,0:02:12.23,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:02:12.23,0:02:14.23,Default,,0,0,0,,Ичиго.
Dialogue: 0,0:02:14.23,0:02:16.53,Default,,0,0,0,,Әлгі қарғыс атқан монах?
Dialogue: 0,0:02:19.74,0:02:23.07,Default,,0,0,0,,Ичиго!
Dialogue: 0,0:02:23.07,0:02:25.27,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:02:36.18,0:02:38.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:38.69,0:02:42.69,Default,,0,0,0,,Неге маған бет бұрасың?
Dialogue: 0,0:03:03.71,0:03:05.71,Default,,0,0,0,,Inoue….
Dialogue: 0,0:03:12.39,0:03:16.22,Default,,0,0,0,,Таң атты. (Урю) Хашвальд.
Dialogue: 0,0:03:16.22,0:03:19.33,Default,,0,0,0,,Ол өзінің шегіне жетті.
Dialogue: 0,0:03:32.67,0:03:35.28,Default,,0,0,0,,Құдіреттілік.
Dialogue: 0,0:03:42.02,0:03:44.69,Default,,0,0,0,,Юха… Бах….
Dialogue: 0,0:03:44.69,0:03:47.69,Default,,0,0,0,,Сен мұнда не үшін келдің? Сіз...
Dialogue: 0,0:03:47.69,0:03:50.86,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:03:50.86,0:03:54.76,Default,,0,0,0,,Мұндай болашақ болған жоқ.
Dialogue: 0,0:05:36.67,0:05:39.83,Default,,0,0,0,,Қарғыс атсын... Жарық жетпейтін нағыз дүние қамалының түбінде➡
Dialogue: 0,0:05:39.83,0:05:42.34,Default,,0,0,0,,Сіз байқамаған болуыңыз мүмкін.
Dialogue: 0,0:05:42.34,0:05:45.84,Default,,0,0,0,,Қиындық қолғаптарын қосудың алдында➡
Dialogue: 0,0:05:45.84,0:05:49.18,Default,,0,0,0,,Менің күшім мен Мәртебелі билігім ауысты.
Dialogue: 0,0:05:49.18,0:05:54.02,Default,,0,0,0,,Ал менің шын құдіретім ұлы мәртебелі құдіретінен де жоғары➡
Dialogue: 0,0:05:54.02,0:05:56.52,Default,,0,0,0,,Ұрысқа жақсы.
Dialogue: 0,0:05:56.52,0:06:01.19,Default,,0,0,0,,Әсіресе сіз сияқты қатені түзететін адамға қарсы.
Dialogue: 0,0:06:01.19,0:06:05.69,Default,,0,0,0,,Қарғыс атсын! Таразы төңкерілді.
Dialogue: 0,0:06:05.69,0:06:08.36,Default,,0,0,0,,Маған жақсы нәрсе айтайын.
Dialogue: 0,0:06:08.36,0:06:11.37,Default,,0,0,0,,үшінн білу мен құдіреттіліктің нағыз сұмдығы➡
Dialogue: 0,0:06:11.37,0:06:14.04,Default,,0,0,0,,Бұл болашақты көре білу туралы емес.
Dialogue: 0,0:06:14.04,0:06:18.71,Default,,0,0,0,,Сіз нені айтасыз...? Ұрыс біткен кезде мен сізге хабарлаймын.
Dialogue: 0,0:06:18.71,0:06:23.21,Default,,0,0,0,,Енді өзің туралы бәрін таразылап көр, Урю Ишида!
Dialogue: 0,0:06:23.21,0:06:28.22,Default,,0,0,0,,Қайтармас жолды нұсқап жүрмін, Сенің сынған таразың болып!
Dialogue: 0,0:06:32.32,0:06:34.72,Default,,0,0,0,,Арх! Конча! Сіз жігіттер!
Dialogue: 0,0:06:41.50,0:06:45.17,Default,,0,0,0,,Қос қылыш сенің жалғыз артықшылығың деп ойладың ба?
Dialogue: 0,0:06:45.17,0:06:49.67,Default,,0,0,0,,Сіз менің қабілеттерімде тесік іздеп жүрсіз бе?
Dialogue: 0,0:06:52.01,0:06:57.01,Default,,0,0,0,,Ичиго Сіз қателесесіз.
Dialogue: 0,0:06:57.01,0:07:01.85,Default,,0,0,0,,Болашақ бір жолда болатын нәрсе емес.
Dialogue: 0,0:07:01.85,0:07:06.02,Default,,0,0,0,,Болашақ мұнда ➡ алдында шашыраңқы
Dialogue: 0,0:07:06.02,0:07:09.36,Default,,0,0,0,,Сансыз құм сияқты нәрсе.
Dialogue: 0,0:07:09.36,0:07:15.53,Default,,0,0,0,,Сансыз көрінетін шашыраңқы құм түйірлерінің әрқайсысы➡
Dialogue: 0,0:07:15.53,0:07:18.20,Default,,0,0,0,,Болашақ.
Dialogue: 0,0:07:18.20,0:07:22.20,Default,,0,0,0,,Сансыз мүмкіндіктер бар деп айтуға болады.
Dialogue: 0,0:07:22.20,0:07:28.21,Default,,0,0,0,,Ичиго Мен үміт туралы айтқанды ұнатамын.
Dialogue: 0,0:07:28.21,0:07:32.15,Default,,0,0,0,,Болашақты өзгертуге болады Бұл факт.
Dialogue: 0,0:07:32.15,0:07:35.98,Default,,0,0,0,,Үміт беретін және тамаша факт.
Dialogue: 0,0:07:35.98,0:07:38.65,Default,,0,0,0,,Бірақ болашақты өзгерту деген нені білдіреді➡
Dialogue: 0,0:07:38.65,0:07:44.16,Default,,0,0,0,,Бұл бір құмнан екінші құмға секіру.➡
Dialogue: 0,0:07:44.16,0:07:47.83,Default,,0,0,0,,Ал мен, құмның әрбір түйірі➡
Dialogue: 0,0:07:47.83,0:07:51.83,Default,,0,0,0,,Үлкен биіктіктен қарауға және өзара әрекеттесуге болады.
Dialogue: 0,0:07:51.83,0:07:57.34,Default,,0,0,0,,Әр нәрсені білу және құдіреттілік болашақты көретін күш емес.
Dialogue: 0,0:07:57.34,0:08:00.34,Default,,0,0,0,,Бұл болашақты өзгертетін күш.
Dialogue: 0,0:08:04.18,0:08:06.98,Default,,0,0,0,,Инау! (Орихиме) Хмм...
Dialogue: 0,0:08:09.18,0:08:13.02,Default,,0,0,0,,Кешіріңіз... кешіріңіз.
Dialogue: 0,0:08:13.02,0:08:17.03,Default,,0,0,0,,Ичиго мен сені қорғай алмадым➡
Dialogue: 0,0:08:17.03,0:08:20.70,Default,,0,0,0,,Бұл әйелдің болашағы.
Dialogue: 0,0:08:20.70,0:08:24.20,Default,,0,0,0,,Иә, мен оны өзгерттім.
Dialogue: 0,0:08:24.20,0:08:27.20,Default,,0,0,0,,Ичиго Үміт үз.
Dialogue: 0,0:08:27.20,0:08:29.37,Default,,0,0,0,,Бұрынғыдай➡
Dialogue: 0,0:08:29.37,0:08:34.14,Default,,0,0,0,,Тағдыр мен мүмкіндік деп аталатын домалақ құм түйіршіктерінде➡
Dialogue: 0,0:08:34.14,0:08:38.31,Default,,0,0,0,,Көзіңді жұмып, секіруді жалғастыр.
Dialogue: 0,0:08:38.31,0:08:42.32,Default,,0,0,0,,Бұл адамдардың үміті.
Dialogue: 0,0:08:42.32,0:08:46.32,Default,,0,0,0,,үшінмыз таразыда жүреміз.
Dialogue: 0,0:08:46.32,0:08:51.99,Default,,0,0,0,,Сізге ненің дұрыс, ненің бұрыс екенін анықтаңыз➡
Dialogue: 0,0:08:51.99,0:08:57.50,Default,,0,0,0,,Бөлінген дұрыс және бұрыс бөліктері бір-бірімен бүктеліп, адамның пішінін құрайды.
Dialogue: 0,0:08:57.50,0:09:01.34,Default,,0,0,0,,Міне, сіз кімсіз.
Dialogue: 0,0:09:01.34,0:09:06.01,Default,,0,0,0,,Сен де солай істеген боларсың, Урю Ишида.
Dialogue: 0,0:09:06.01,0:09:09.51,Default,,0,0,0,,Мен сені көре алмаймын.
Dialogue: 0,0:09:09.51,0:09:13.68,Default,,0,0,0,,Таразыны өлшеп, таңдауды жалғастырған болуыңыз керек.➡
Dialogue: 0,0:09:13.68,0:09:16.35,Default,,0,0,0,,Мен сені көре алмаймын.
Dialogue: 0,0:09:16.35,0:09:19.75,Default,,0,0,0,,Сен кімсің, Урю Ишида?
Dialogue: 0,0:09:21.69,0:09:25.03,Default,,0,0,0,,Шынымен сол таяз адамдарға➡
Dialogue: 0,0:09:25.03,0:09:29.36,Default,,0,0,0,,Өз өміріңізге қауіп төндіру сіздің шынайы қалауыңыз ба?
Dialogue: 0,0:09:29.36,0:09:32.30,Default,,0,0,0,,Көп уақыт өтті.
Dialogue: 0,0:09:32.30,0:09:37.14,Default,,0,0,0,,Мен кіммін...?
Dialogue: 0,0:09:37.14,0:09:40.94,Default,,0,0,0,,Сіз осындай нәрсеге жауап бере аласыз ба?
Dialogue: 0,0:09:47.32,0:09:49.65,Default,,0,0,0,,Мен үшін бұл➡
Dialogue: 0,0:09:49.65,0:09:53.66,Default,,0,0,0,,Балалар сендерді жеңгеннен кейін мен түсінемін.
Dialogue: 0,0:09:53.66,0:09:55.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:00.66,0:10:04.50,Default,,0,0,0,,Шекаралық инвазия мәнін арттыру! Ол тоқтамайды!
Dialogue: 0,0:10:04.50,0:10:08.67,Default,,0,0,0,,Жоюшы не істегісі келеді? Әлем жойылады!
Dialogue: 0,0:10:08.67,0:10:12.67,Default,,0,0,0,,Мен рухани баланы қара қуыс арқылы атып көрдім➡
Dialogue: 0,0:10:12.67,0:10:15.84,Default,,0,0,0,,Бір сәтке кішірейеді, бірақ тез қалпына келеді.
Dialogue: 0,0:10:15.84,0:10:18.68,Default,,0,0,0,,Бір сәтке де кішірейіп кеттің.
Dialogue: 0,0:10:18.68,0:10:20.68,Default,,0,0,0,,Жарайды, үмітіңді үзбе.
Dialogue: 0,0:10:20.68,0:10:23.52,Default,,0,0,0,,Әсерді арттырудың жалғыз жолы - оны жою.
Dialogue: 0,0:10:23.52,0:10:27.86,Default,,0,0,0,,Бұл бізде бірдей энергияны пайдаланудан басқа таңдау жоқ дегенді білдіре ме? ?
Dialogue: 0,0:10:27.86,0:10:30.36,Default,,0,0,0,,Мұндай энергияны қайдан табуға болады? ?
Dialogue: 0,0:10:30.36,0:10:33.53,Default,,0,0,0,,Білсең мен саған қамқор болмас едім!
Dialogue: 0,0:10:33.53,0:10:37.70,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым. Не істеу керек, Акин?
Dialogue: 0,0:10:37.70,0:10:42.04,Default,,0,0,0,,Бұл бұрмалау осы дүние мен жан әлемі арасындағы тепе-теңдікке байланысты➡
Dialogue: 0,0:10:42.04,0:10:44.87,Default,,0,0,0,,Ол құлап жатқандықтан таралуда.
Dialogue: 0,0:10:44.87,0:10:48.21,Default,,0,0,0,,Ах! ? Мұны неге қазір айтып отырсың? ?
Dialogue: 0,0:10:48.21,0:10:51.38,Default,,0,0,0,,Мұны теңестіру туралы не айтуға болады?
Dialogue: 0,0:10:51.38,0:10:53.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:55.72,0:10:58.89,Default,,0,0,0,,Қиял әлемінің қақпасын ашады.
Dialogue: 0,0:10:58.89,0:11:02.39,Default,,0,0,0,,Мен де сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:11:02.39,0:11:06.56,Default,,0,0,0,,Менің қандай адаммын деп неге сұрайсың?
Dialogue: 0,0:11:06.56,0:11:11.73,Default,,0,0,0,,Мен мұндай сұрақтарды қоя бермес бұрын, мені тезірек жеңіңіз➡
Dialogue: 0,0:11:11.73,0:11:15.24,Default,,0,0,0,,Жухабахқа асығуымыз керек емес пе?
Dialogue: 0,0:11:15.24,0:11:17.74,Default,,0,0,0,,Олар өледі.
Dialogue: 0,0:11:17.74,0:11:21.08,Default,,0,0,0,,Мен мұнда саған қанша жұмсасам да➡
Dialogue: 0,0:11:21.08,0:11:24.28,Default,,0,0,0,,Мәртебелі мырзаға ешқандай қауіп төнбейді.
Dialogue: 0,0:11:36.02,0:11:38.03,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:40.03,0:11:42.86,Default,,0,0,0,,Сен бақыттысың, Урю Ишида.
Dialogue: 0,0:11:42.86,0:11:46.37,Default,,0,0,0,,Маған қасірет қолғаптарын сәтті киіңіз➡
Dialogue: 0,0:11:46.37,0:11:50.04,Default,,0,0,0,,Осылайша мен құдайдың сансыз жойылу жебелерін ата алдым.
Dialogue: 0,0:11:50.04,0:11:54.38,Default,,0,0,0,,Сол жақсылық сізге бірдей бақытсыздық ретінде келеді.
Dialogue: 0,0:11:54.38,0:11:56.71,Default,,0,0,0,,Ga!
Dialogue: 0,0:11:56.71,0:11:59.38,Default,,0,0,0,,Менің қасиетті хатым Б.
Dialogue: 0,0:11:59.38,0:12:02.05,Default,,0,0,0,,Әлемдік үйлесімділік.
Dialogue: 0,0:12:02.05,0:12:06.22,Default,,0,0,0,,Диапазон әлемінде болатын бақытсыздықты бақытты адамдармен бөлісу арқылы➡
Dialogue: 0,0:12:06.22,0:12:08.72,Default,,0,0,0,,Дүниедегі үйлесімділікті сақтау.
Dialogue: 0,0:12:08.72,0:12:12.23,Default,,0,0,0,,Сіздің жеңу мүмкіндігіңіз жоқ, Урю Ишида.
Dialogue: 0,0:12:12.23,0:12:15.90,Default,,0,0,0,,Мен сенен басқа ештеңе сұрай алмаймын.
Dialogue: 0,0:12:15.90,0:12:20.07,Default,,0,0,0,,Егер сіз ештеңе айтпасаңыз, бұл да жақсы. Әзірге солай.
Dialogue: 0,0:12:20.07,0:12:24.07,Default,,0,0,0,,Тоқта... көргің келмей ме?
Dialogue: 0,0:12:24.07,0:12:27.41,Default,,0,0,0,,Менің... қасиетті хаттарым.
Dialogue: 0,0:12:27.41,0:12:29.74,Default,,0,0,0,,Бұл қызықсыз өмірді ұзарту.
Dialogue: 0,0:12:29.74,0:12:33.01,Default,,0,0,0,,Егер сіз мұнымен жеңе алсаңыз, оны бұрыннан пайдалануыңыз керек еді.
Dialogue: 0,0:12:33.01,0:12:35.68,Default,,0,0,0,,Төңкерілген.
Dialogue: 0,0:12:35.68,0:12:38.35,Default,,0,0,0,,Уақыт келді деп ойладым.
Dialogue: 0,0:12:38.35,0:12:40.69,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:12:40.69,0:12:43.36,Default,,0,0,0,,Менің қасиетті хаттарым➡
Dialogue: 0,0:12:43.36,0:12:45.69,Default,,0,0,0,,Толық қарсылық.
Dialogue: 0,0:12:45.69,0:12:47.70,Default,,0,0,0,,Дұрыс, болды!
Dialogue: 0,0:12:47.70,0:12:50.03,Default,,0,0,0,,Толық қарсылық.
Dialogue: 0,0:12:50.03,0:12:53.37,Default,,0,0,0,,Көрсетілген екі нүктенің арасында орын алған оқиғалар ➡
Dialogue: 0,0:12:53.37,0:12:55.87,Default,,0,0,0,,Кері айналдыруға болады.
Dialogue: 0,0:12:55.87,0:13:00.88,Default,,0,0,0,,Бұл жолы мен өзімнің де, сенің де жараларымды жай ғана өзгерттім.
Dialogue: 0,0:13:00.88,0:13:03.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:06.71,0:13:10.89,Default,,0,0,0,,Қандай керемет күш...
Dialogue: 0,0:13:10.89,0:13:14.72,Default,,0,0,0,,Мәртебелі назар аударып отырғаны таңқаларлық емес.
Dialogue: 0,0:13:14.72,0:13:17.73,Default,,0,0,0,,Болған оқиғаны кері қайтаруға мүмкіндігіңіз болса➡
Dialogue: 0,0:13:17.73,0:13:22.90,Default,,0,0,0,,Мәртебелі құдіретіне қарсы тұра алатын жалғыз сен шығарсың.
Dialogue: 0,0:13:22.90,0:13:25.07,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:13:25.07,0:13:29.40,Default,,0,0,0,,Сіз айтып отырған нағыз құдіретті күшке сілтеме жасайсыз ба?
Dialogue: 0,0:13:29.40,0:13:32.01,Default,,0,0,0,,Қалауыңызша қабылдаңыз.
Dialogue: 0,0:13:32.01,0:13:34.34,Default,,0,0,0,,Менің айта алатыным тек➡
Dialogue: 0,0:13:34.34,0:13:40.01,Default,,0,0,0,,Бұл жерде сені тоқтатқаным дұрыс болды.
Dialogue: 0,0:13:40.01,0:13:43.35,Default,,0,0,0,,Мен сені жіберемін деп ойлайсың ба?
Dialogue: 0,0:13:43.35,0:13:46.35,Default,,0,0,0,,Сіздің толық қарсылығыңыз керемет, бірақ➡
Dialogue: 0,0:13:46.35,0:13:49.19,Default,,0,0,0,,Бұл менің әлемдік үйлесімділігіме сәйкес келмейді.
Dialogue: 0,0:13:49.19,0:13:51.86,Default,,0,0,0,,Қарғыс атсын... Айтуым керек еді.
Dialogue: 0,0:13:51.86,0:13:54.20,Default,,0,0,0,,Бақытсыздық ортақ болады.
Dialogue: 0,0:13:54.20,0:13:57.70,Default,,0,0,0,,Және менің барлық бақытсыздықтарым➡
Dialogue: 0,0:13:57.70,0:14:01.04,Default,,0,0,0,,Сіз оны осы алмастырғыш қалқанмен ала аласыз.
Dialogue: 0,0:14:01.04,0:14:03.37,Default,,0,0,0,,Басқаша айтқанда, оның мағынасы осы.
Dialogue: 0,0:14:03.37,0:14:06.71,Default,,0,0,0,,Менің бақытым, мені ренжіткеніңіз➡
Dialogue: 0,0:14:06.71,0:14:09.54,Default,,0,0,0,,Дәл осындай бақытсыздық сізге де түседі➡
Dialogue: 0,0:14:09.54,0:14:15.05,Default,,0,0,0,,Менің денеме түскен бақытсыздық осы алмастырушы қалқанға ауысты➡
Dialogue: 0,0:14:15.05,0:14:19.72,Default,,0,0,0,,Сізге көбірек бақытсыздық келеді.
Dialogue: 0,0:14:19.72,0:14:25.56,Default,,0,0,0,,Мен саған жеңуге мүмкіндік жоқ дедім, Урю Ишида.
Dialogue: 0,0:14:25.56,0:14:29.73,Default,,0,0,0,,А... ха... уф….
Dialogue: 0,0:14:29.73,0:14:32.33,Default,,0,0,0,,Сіз әлі де берілмейсіз бе?
Dialogue: 0,0:14:32.33,0:14:34.84,Default,,0,0,0,,Сен дана адамсың.
Dialogue: 0,0:14:34.84,0:14:37.84,Default,,0,0,0,,Сіз маған да, Мәртебелі Мәртебеліге де тең келмейді➡
Dialogue: 0,0:14:37.84,0:14:40.84,Default,,0,0,0,,Түсіну керек.
Dialogue: 0,0:14:40.84,0:14:45.51,Default,,0,0,0,,Мен сені көре алмаймын дедім, бірақ қайтарып аламын.
Dialogue: 0,0:14:45.51,0:14:49.52,Default,,0,0,0,,Сіз және сол керемет ақымақ адамдар➡
Dialogue: 0,0:14:49.52,0:14:51.72,Default,,0,0,0,,Өте ұқсас.
Dialogue: 0,0:14:53.69,0:14:55.86,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:14:55.86,0:14:58.69,Default,,0,0,0,,Мен қалаған шынайы әлем –➡
Dialogue: 0,0:14:58.69,0:15:03.03,Default,,0,0,0,,Әйелдің қалаған дүниесі де осы.
Dialogue: 0,0:15:03.03,0:15:08.04,Default,,0,0,0,,Дау-дамай, қайғы-қасірет, жек көру, мұң жоқ➡
Dialogue: 0,0:15:08.04,0:15:10.04,Default,,0,0,0,,Бейбіт әлем.
Dialogue: 0,0:15:10.04,0:15:15.04,Default,,0,0,0,,Бұл мен қалайтын жаңа әлем.
Dialogue: 0,0:15:15.04,0:15:18.71,Default,,0,0,0,,Үміт үзбе, Ичиго.
Dialogue: 0,0:15:18.71,0:15:21.88,Default,,0,0,0,,Үмітсіз баламды өлтіру сияқты ештеңе жоқ➡
Dialogue: 0,0:15:21.88,0:15:26.09,Default,,0,0,0,,Ата-аналарға ешнәрсе қиын емес.
Dialogue: 0,0:15:28.72,0:15:31.23,Default,,0,0,0,,Сіз әлі де қозғала аласыз ба?
Dialogue: 0,0:15:31.23,0:15:37.00,Default,,0,0,0,,Мен Куросаки мен басқаларға ұқсаймын деп ойлайсың ба?
Dialogue: 0,0:15:37.00,0:15:39.50,Default,,0,0,0,,Осы уақытқа дейін менде➡ бар
Dialogue: 0,0:15:39.50,0:15:41.84,Default,,0,0,0,,үшінн тыныш ұстаңыз➡
Dialogue: 0,0:15:41.84,0:15:46.67,Default,,0,0,0,,Мен сіз айтқан шкала бойынша әрекет еттім деп ойладым.
Dialogue: 0,0:15:46.67,0:15:51.68,Default,,0,0,0,,Бірақ Куросаки мұны істеу үшін тым ақымақ.
Dialogue: 0,0:15:51.68,0:15:56.35,Default,,0,0,0,,Көмек бергіңіз келсе, көмекке барыңыз.
Dialogue: 0,0:15:56.35,0:15:59.52,Default,,0,0,0,,Таразы қай жаққа еңкейсе де➡
Dialogue: 0,0:15:59.52,0:16:03.19,Default,,0,0,0,,Таразыға қарамайды.
Dialogue: 0,0:16:03.19,0:16:06.86,Default,,0,0,0,,Иноуэ-сан ақымақ, Садо-кун да ақымақ➡
Dialogue: 0,0:16:06.86,0:16:10.57,Default,,0,0,0,,Кучики мырза ақымақ, Абарай да.
Dialogue: 0,0:16:12.70,0:16:17.71,Default,,0,0,0,,Мен сол ақымақтарға ұқсайтын болсам➡
Dialogue: 0,0:16:17.71,0:16:20.54,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:16:20.54,0:16:25.75,Default,,0,0,0,,Түсіндім, үміттен де, үмітсіздіктен де қорқасың.
Dialogue: 0,0:16:27.72,0:16:32.22,Default,,0,0,0,,Білуші, құдіретті болсаң да, жүрегіңді көре алмайтын сияқтысың.
Dialogue: 0,0:16:35.66,0:16:38.33,Default,,0,0,0,,Үмітсіздік деген не?
Dialogue: 0,0:16:38.33,0:16:40.33,Default,,0,0,0,,Мен сізді жақсы білемін.
Dialogue: 0,0:16:40.33,0:16:46.67,Default,,0,0,0,,♬～
Dialogue: 0,0:16:46.67,0:16:51.27,Default,,0,0,0,,Мен бұған дейін талай рет жеңдім!
Dialogue: 0,0:16:53.34,0:16:57.68,Default,,0,0,0,,Осы сәтте маған сен керек едің.
Dialogue: 0,0:16:57.68,0:16:59.68,Default,,0,0,0,,Менің ұлым.
Dialogue: 0,0:17:01.68,0:17:04.35,Default,,0,0,0,,Мен бақыттымын... сонда?
Dialogue: 0,0:17:04.35,0:17:08.36,Default,,0,0,0,,Мен сенің сезіміңді басынан сұраған емеспін.
Dialogue: 0,0:17:08.36,0:17:12.69,Default,,0,0,0,,Менің ойымша, олармен бірге болғаныңыз сізге тиімді емес.
Dialogue: 0,0:17:12.69,0:17:14.70,Default,,0,0,0,,Менің айтып тұрғаным осы.
Dialogue: 0,0:17:14.70,0:17:18.70,Default,,0,0,0,,Сіз олармен бірге өстіңіз бе?
Dialogue: 0,0:17:18.70,0:17:21.20,Default,,0,0,0,,Олармен бірге болған жылдардан да көп➡
Dialogue: 0,0:17:21.20,0:17:24.21,Default,,0,0,0,,Мәртебелі маған билік берген сәт➡
Dialogue: 0,0:17:24.21,0:17:26.87,Default,,0,0,0,,Сіз өсіп келе жатқан боларсыз.
Dialogue: 0,0:17:26.87,0:17:29.88,Default,,0,0,0,,Достар бір-біріне көмектессе➡
Dialogue: 0,0:17:29.88,0:17:34.15,Default,,0,0,0,,Сіз өз өміріңізді оларға емес, ұлы мәртебеге қоюыңыз керек.
Dialogue: 0,0:17:34.15,0:17:37.99,Default,,0,0,0,,Мен тепе-теңдік таңдау деп айттым.
Dialogue: 0,0:17:37.99,0:17:43.16,Default,,0,0,0,,Мен олармен бірге болуды таңдадым.
Dialogue: 0,0:17:43.16,0:17:45.99,Default,,0,0,0,,Бірақ ол жерде қызығушылық жоқ.
Dialogue: 0,0:17:45.99,0:17:48.83,Default,,0,0,0,,Дұрыс немесе бұрыс жауап жоқ.
Dialogue: 0,0:17:48.83,0:17:52.23,Default,,0,0,0,,Өйткені біз доспыз.
Dialogue: 0,0:17:55.00,0:17:57.67,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:17:57.67,0:18:01.01,Default,,0,0,0,,Мәртебелі сізді танығанмен➡
Dialogue: 0,0:18:01.01,0:18:04.18,Default,,0,0,0,,Бұл менің ештеңені лақтырғым келмейтінін білдіреді.
Dialogue: 0,0:18:04.18,0:18:07.98,Default,,0,0,0,,Олай болса, тым болмаса жаныңды бер, Урю Ишида!
Dialogue: 0,0:18:15.69,0:18:18.19,Default,,0,0,0,,Банкай!
Dialogue: 0,0:18:18.19,0:18:21.30,Default,,0,0,0,,Тенчейн Зангецу! !
Dialogue: 0,0:18:29.37,0:18:32.64,Default,,0,0,0,,Соншалықты қорқынышты көрінбе, Ичиго.
Dialogue: 0,0:18:32.64,0:18:36.98,Default,,0,0,0,,Мен сенің құдіретіңді құттықтаймын.
Dialogue: 0,0:18:36.98,0:18:39.98,Default,,0,0,0,,Жаңа Tenchain Zangetsu➡
Dialogue: 0,0:18:39.98,0:18:44.99,Default,,0,0,0,,Қорқынышты Банкай екен, мен солай бағаладым➡
Dialogue: 0,0:18:44.99,0:18:47.69,Default,,0,0,0,,Мен оны болашаққа сақтап қойдым.
Dialogue: 0,0:19:05.67,0:19:07.68,Default,,0,0,0,,Барыңыз… Гофу….
Dialogue: 0,0:19:07.68,0:19:12.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:12.51,0:19:15.02,Default,,0,0,0,,Банкай!
Dialogue: 0,0:19:15.02,0:19:17.52,Default,,0,0,0,,Банкай?
Dialogue: 0,0:19:17.52,0:19:21.19,Default,,0,0,0,,Маған бұл сөз ұнайды.
Dialogue: 0,0:19:21.19,0:19:23.19,Default,,0,0,0,,Махаббат….
Dialogue: 0,0:19:25.19,0:19:27.36,Default,,0,0,0,,Өлім құдайлары➡
Dialogue: 0,0:19:27.36,0:19:31.03,Default,,0,0,0,,Кез келген жағдайдан көтеріле аласыз➡
Dialogue: 0,0:19:31.03,0:19:33.73,Default,,0,0,0,,Өйткені ол құдіретті сөз.
Dialogue: 0,0:19:36.97,0:19:42.14,Default,,0,0,0,,Осы сөздердің арқасында мен өлім құдайларының жүрегінде көтерілемін➡
Dialogue: 0,0:19:42.14,0:19:45.98,Default,,0,0,0,,Көп рет сындыруға болады. Гуаа!
Dialogue: 0,0:19:45.98,0:19:52.15,Default,,0,0,0,,Сіз көп рет үмітсіздікті жеңіп, болашақты өзгерткен болуыңыз керек.
Dialogue: 0,0:19:52.15,0:19:55.49,Default,,0,0,0,,Мұның не үшін жасалғанын білесіз бе?
Dialogue: 0,0:19:55.49,0:19:59.33,Default,,0,0,0,,Себебі мен ол жерде болмадым.
Dialogue: 0,0:19:59.33,0:20:03.33,Default,,0,0,0,,Ичиго, болашақты өзгерт.
Dialogue: 0,0:20:03.33,0:20:07.00,Default,,0,0,0,,Болашақ қандай керемет болса да➡
Dialogue: 0,0:20:07.00,0:20:10.30,Default,,0,0,0,,Мен оны көріп тұрмын.
Dialogue: 0,0:20:13.67,0:20:17.34,Default,,0,0,0,,Тіпті болашақты да өзгерттің➡
Dialogue: 0,0:20:17.34,0:20:20.25,Default,,0,0,0,,Қане, кесіп алайық.
Dialogue: 0,0:20:22.18,0:20:28.02,Default,,0,0,0,,Енді, үмітіңді үзбе, Ичиго.
Dialogue: 0,0:20:28.02,0:20:33.03,Default,,0,0,0,,Ах! !
Dialogue: 0,0:22:04.05,0:22:06.39,Default,,0,0,0,,күрсіну….
Dialogue: 0,0:22:06.39,0:22:10.22,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:22:10.22,0:22:16.23,Default,,0,0,0,,Мәртебелі менің күшімді тартып алғаны ренжіді деп ойлайсың ба?
Dialogue: 0,0:22:16.23,0:22:18.90,Default,,0,0,0,,Бұл керісінше.
Dialogue: 0,0:22:18.90,0:22:23.07,Default,,0,0,0,,Мәртебелі сіздің күш-қуатыңызды тартып алған жоқ➡
Dialogue: 0,0:22:23.07,0:22:25.57,Default,,0,0,0,,Мен мақтан тұтамын.
Dialogue: 0,0:22:25.57,0:22:31.58,Default,,0,0,0,,Менің күшімді тартып алғаныңа мақтанамын.
Dialogue: 0,0:22:31.58,0:22:36.28,Default,,0,0,0,,Өйткені Мәртебелі мырзаға мен ғана көмектесемін.
Dialogue: 0,0:22:40.69,0:22:45.03,Default,,0,0,0,,Мен көремін. Күте тұрыңыз, Урю Ишида.
Dialogue: 0,0:22:45.03,0:22:49.33,Default,,0,0,0,,Жараларыңды маған аудар.
Dialogue: 0,0:22:51.37,0:22:54.37,Default,,0,0,0,,Мен... жақында өлемін.
Dialogue: 0,0:22:54.37,0:22:57.71,Default,,0,0,0,,Шрамы бар немесе жоқ➡
Dialogue: 0,0:22:57.71,0:22:59.87,Default,,0,0,0,,Бұл өзгеріссіз қалады.
Dialogue: 0,0:22:59.87,0:23:02.71,Default,,0,0,0,,Жоқ... дейсіз бе?
Dialogue: 0,0:23:02.71,0:23:06.71,Default,,0,0,0,,Мейірімділікке не болды?
Dialogue: 0,0:23:06.71,0:23:11.72,Default,,0,0,0,,Осы уақытқа дейін сен мені өлтіремін деп төбелесіп жүрген шығарсың.
Dialogue: 0,0:23:11.72,0:23:15.56,Default,,0,0,0,,Бірақ…. Сізге не қызық?
Dialogue: 0,0:23:15.56,0:23:19.23,Default,,0,0,0,,Мен саған бәрін өлшеп көр дедім.
Dialogue: 0,0:23:19.23,0:23:24.06,Default,,0,0,0,,Өлшей алмай, күдік қуып, шешім қабылдадым ➡
Dialogue: 0,0:23:24.06,0:23:27.23,Default,,0,0,0,,Өйткені сен бәріне өкінесің.
Dialogue: 0,0:23:27.23,0:23:33.17,Default,,0,0,0,,Соны да өлшеп көр, Урю Ишида.
Dialogue: 0,0:23:33.17,0:23:37.85,Default,,0,0,0,,Сіз... досыңызға көмектесуіңіз керек.
Dialogue: 0,0:23:37.85,0:23:54.19,Default,,0,0,0,,♬～
Dialogue: 0,0:23:54.19,0:23:57.20,Default,,0,0,0,,《Хашвальд: Нәтиже өзгеріссіз қалса да➡
