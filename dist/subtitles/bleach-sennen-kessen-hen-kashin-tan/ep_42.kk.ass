Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:21.14,0:00:23.14,Default,,0,0,0,,Не болды? Орихиме
Dialogue: 0,0:00:23.23,0:00:24.64,Default,,0,0,0,,Иә
Dialogue: 0,0:00:24.73,0:00:28.69,Default,,0,0,0,,Бұл гүл маған Куросаки-кунды еске түсіреді.
Dialogue: 0,0:00:28.77,0:00:30.28,Default,,0,0,0,,ал қылышың қазірдің өзінде сынық түскен.
Dialogue: 0,0:00:30.36,0:00:33.36,Default,,0,0,0,,Ичиго қызылға қарағанда соған ұқсас, солай ма?
Dialogue: 0,0:00:34.49,0:00:35.82,Default,,0,0,0,,(Изуку) Эндеворға келгенде сен сәл қаталсың ғой, Тодороки?
Dialogue: 0,0:00:35.91,0:00:37.62,Default,,0,0,0,,Қалай болғанда да, бәрі жақсы.
Dialogue: 0,0:00:37.70,0:00:40.62,Default,,0,0,0,,Егер бұл Ичиго туралы болса, мен оны кейінірек тыңдаймын.
Dialogue: 0,0:00:40.70,0:00:41.62,Default,,0,0,0,,Әзірге барайық.
Dialogue: 0,0:00:41.70,0:00:45.21,Default,,0,0,0,,Мен бәрін жарты жолда өтуім керек.
Dialogue: 0,0:00:45.29,0:00:47.29,Default,,0,0,0,,көремін. Бұл дұрыс.
Dialogue: 0,0:00:47.38,0:00:48.46,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:00:48.54,0:00:51.63,Default,,0,0,0,,Шынымен де қиын сабақтан тыс сабақ
Dialogue: 0,0:01:01.85,0:01:04.39,Default,,0,0,0,,Мен Куросаки-кунның жүрегі...
Dialogue: 0,0:01:13.23,0:01:15.45,Default,,0,0,0,,Оның да гүл сияқты түсі бар.
Dialogue: 0,0:01:16.03,0:01:18.57,Default,,0,0,0,,Жылы және мейірімді
Dialogue: 0,0:01:18.66,0:01:20.95,Default,,0,0,0,,Айналаны нұрландырып, жарқырайды.
Dialogue: 0,0:01:21.99,0:01:23.54,Default,,0,0,0,,үшінн қорғау
Dialogue: 0,0:01:27.21,0:01:28.42,Default,,0,0,0,,Сондықтан мен шешім қабылдадым
Dialogue: 0,0:01:30.59,0:01:32.92,Default,,0,0,0,,Куросаки-кун, мен...
Dialogue: 0,0:01:33.51,0:01:35.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:00.88,0:03:02.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:04.26,0:03:07.77,Default,,0,0,0,,Рейацу, ол секундына 48 рет өзгереді
Dialogue: 0,0:03:09.23,0:03:11.44,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:03:11.52,0:03:15.65,Default,,0,0,0,,Бұл 1 секундта барлық 48 үлгіні жеуге болатынын білдіреді.
Dialogue: 0,0:03:15.73,0:03:20.65,Default,,0,0,0,,Басқаша айтқанда, егер сіз мінсіз қарым-қатынаста болсаңыз және шабуылдардан бір секундқа аман қалсаңыз,
Dialogue: 0,0:03:21.45,0:03:24.16,Default,,0,0,0,,Барлық 48 жұқтырған түрі (толық)
Dialogue: 0,0:03:24.24,0:03:25.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:25.62,0:03:29.04,Default,,0,0,0,,Иммунитетті одан әрі талдау және алу үшін не қажет
Dialogue: 0,0:03:29.12,0:03:30.54,Default,,0,0,0,,Тек уақыт
Dialogue: 0,0:03:31.00,0:03:32.00,Default,,0,0,0,,Ой
Dialogue: 0,0:03:32.75,0:03:35.50,Default,,0,0,0,,Бұл адамның реиацусын өзгертудің де жолы бар.
Dialogue: 0,0:03:35.59,0:03:37.50,Default,,0,0,0,,Мүмкін бар...
Dialogue: 0,0:03:37.59,0:03:38.63,Default,,0,0,0,,Бұл ысырап.
Dialogue: 0,0:03:39.46,0:03:42.05,Default,,0,0,0,,Уақытты босқа өткізбеу үшін
Dialogue: 0,0:03:42.13,0:03:43.38,Default,,0,0,0,,Мейірімділіктен
Dialogue: 0,0:03:43.47,0:03:46.64,Default,,0,0,0,,Мен сізге Ворстендигімнің орындалуын айтып беремін.
Dialogue: 0,0:03:46.72,0:03:50.18,Default,,0,0,0,,Менің Vorstendig «Құдайдың улы көзқарасы» болып табылады
Dialogue: 0,0:03:50.27,0:03:52.73,Default,,0,0,0,,Улы өзгерістерге бейімделу
Dialogue: 0,0:03:53.35,0:03:56.02,Default,,0,0,0,,Удың беткі қабаты қанша өзгерсе де
Dialogue: 0,0:03:56.11,0:03:57.44,Default,,0,0,0,,Негіздері бірдей болса
Dialogue: 0,0:03:57.52,0:04:01.40,Default,,0,0,0,,Иммунитетіңізді өзгертіп, оны бірден жоюға болады.
Dialogue: 0,0:04:01.99,0:04:03.95,Default,,0,0,0,,Бұл оны айтудың айналмалы тәсілі ме?
Dialogue: 0,0:04:04.03,0:04:06.03,Default,,0,0,0,,Бірақ сіз түсінесіз.
Dialogue: 0,0:04:06.12,0:04:11.41,Default,,0,0,0,,Бұдан былай сіз де, ол да реятсуыңызды қанша өзгертсеңіз де.
Dialogue: 0,0:04:11.50,0:04:16.17,Default,,0,0,0,,Маған бір тырнақ та тигізе алмайсың дейді.
Dialogue: 0,0:04:16.67,0:04:19.96,Default,,0,0,0,,Енді не істейміз? Кисуке Урахара
Dialogue: 0,0:04:20.05,0:04:24.68,Default,,0,0,0,,1-ден 10-ға дейінгі қимылдарыңызды бұзғаныма сенбеймін.
Dialogue: 0,0:04:25.26,0:04:27.89,Default,,0,0,0,,Бізде нұсқалар таусылған сияқты емес, солай емес пе?
Dialogue: 0,0:04:31.77,0:04:32.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:32.77,0:04:35.14,Default,,0,0,0,,Бұлай таң қалмаңыз.
Dialogue: 0,0:04:35.23,0:04:36.40,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:04:37.23,0:04:39.27,Default,,0,0,0,,Бөлінген аумақтар
Dialogue: 0,0:04:39.98,0:04:43.15,Default,,0,0,0,,Мен ауыр сөздер айтқанды ұнатпаймын.
Dialogue: 0,0:04:43.24,0:04:47.78,Default,,0,0,0,,Ауыр сөздерді айтатын адамдар ыңғайсыз сияқты, солай емес пе?
Dialogue: 0,0:04:48.28,0:04:50.91,Default,,0,0,0,,Мен оған қол жеткізе алатын адам болғым келеді.
Dialogue: 0,0:04:50.99,0:04:51.91,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:52.41,0:04:54.33,Default,,0,0,0,,Мен осылай айтамын
Dialogue: 0,0:04:54.41,0:04:59.84,Default,,0,0,0,,Бұл өте улы аймақтан құтылу мүлдем мүмкін емес.
Dialogue: 0,0:05:00.46,0:05:03.59,Default,,0,0,0,,Сіз шынымен біздің қашып кеткенімізді қаламайсыз, солай ма?
Dialogue: 0,0:05:03.67,0:05:06.80,Default,,0,0,0,,Бұл анық. Бұл қандай растау?
Dialogue: 0,0:05:06.88,0:05:08.51,Default,,0,0,0,,Біз жаумыз.
Dialogue: 0,0:05:08.59,0:05:12.27,Default,,0,0,0,,Жоқ, мен мұны айтпауым керек.
Dialogue: 0,0:05:12.35,0:05:14.89,Default,,0,0,0,,Сіз адалдықтан әрекет етіп жатқан сияқтысыз.
Dialogue: 0,0:05:14.98,0:05:16.60,Default,,0,0,0,,Мен оны көре алмадым
Dialogue: 0,0:05:16.69,0:05:19.23,Default,,0,0,0,,Бұл дөрекі.
Dialogue: 0,0:05:19.31,0:05:23.36,Default,,0,0,0,,Адалдық туралы айтатын болсақ, мен помераниялыққа қарағанда екі есе көп адалдыққа ие боламын.
Dialogue: 0,0:05:23.44,0:05:26.32,Default,,0,0,0,,Бірақ сіз қателесесіз.
Dialogue: 0,0:05:26.40,0:05:28.57,Default,,0,0,0,,Бұл, әрине, бәрі емес.
Dialogue: 0,0:05:29.32,0:05:31.70,Default,,0,0,0,,Мен ұлы мәртебеліге қызығамын.
Dialogue: 0,0:05:32.74,0:05:36.62,Default,,0,0,0,,Қызық десем, жоғарыдан ести аламын ба?
Dialogue: 0,0:05:36.71,0:05:38.96,Default,,0,0,0,,Әрине, бұл менің айтқым келгені емес.
Dialogue: 0,0:05:39.67,0:05:43.21,Default,,0,0,0,,Бұл әлем Қиял әлемі Жан қоғамы
Dialogue: 0,0:05:43.30,0:05:45.76,Default,,0,0,0,,Үш дүниені құрту
Dialogue: 0,0:05:45.84,0:05:48.68,Default,,0,0,0,,Осыдан кейін мен бірдеңе жасауға тырысамын.
Dialogue: 0,0:05:48.76,0:05:51.60,Default,,0,0,0,,Мәртебеліден басқа мұндай адам бар ма?
Dialogue: 0,0:05:51.68,0:05:54.52,Default,,0,0,0,,Мысалы, мен мұнда Ұлы мәртебелі ханымды сағындым.
Dialogue: 0,0:05:54.60,0:05:58.85,Default,,0,0,0,,Келесіде осындай адам шығады деп ойлайсыз ба?
Dialogue: 0,0:05:58.94,0:06:02.69,Default,,0,0,0,,Кисуке Урахара Сен білімдісің.
Dialogue: 0,0:06:03.19,0:06:06.07,Default,,0,0,0,,Сіз бұл дүниеде бәрін көрген сияқтысыз.
Dialogue: 0,0:06:06.15,0:06:08.36,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:06:08.45,0:06:13.03,Default,,0,0,0,,Ұлы мәртебелі үш дүниені жойғаннан кейін не жасайды?
Dialogue: 0,0:06:13.53,0:06:15.75,Default,,0,0,0,,Мұны көргің келмей ме?
Dialogue: 0,0:06:18.83,0:06:21.58,Default,,0,0,0,,Сіз әлі де сол жылдамдықпен қозғала аласыз ба?
Dialogue: 0,0:06:22.25,0:06:25.09,Default,,0,0,0,,Берейхте бұл сыйлық үлкен мәміле.
Dialogue: 0,0:06:26.01,0:06:27.84,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:06:27.92,0:06:30.22,Default,,0,0,0,,Бұл сіздің бұрынғы жауабыңыз ба?
Dialogue: 0,0:06:30.30,0:06:31.84,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:06:31.93,0:06:35.52,Default,,0,0,0,,Мен сізді сөзсіз осы жақта деп ойладым.
Dialogue: 0,0:06:35.60,0:06:38.14,Default,,0,0,0,,Егер сіз капитан Нирука болсаңыз, немесе
Dialogue: 0,0:06:38.23,0:06:41.90,Default,,0,0,0,,Сіз жаңа нәрсені көргіңіз келетінін айтқан боларсыз.
Dialogue: 0,0:06:41.98,0:06:44.19,Default,,0,0,0,,Иә? Бұл Майури ме?
Dialogue: 0,0:06:44.27,0:06:45.78,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:06:45.86,0:06:49.99,Default,,0,0,0,,Мен Юха Бахтың не жасағанын көргім келмейді.
Dialogue: 0,0:06:50.07,0:06:54.49,Default,,0,0,0,,Егер сіз бұрын ешкім көрмеген нәрсені жасағыңыз келсе, оны өз қолыңызбен жасаңыз.
Dialogue: 0,0:06:54.58,0:06:56.79,Default,,0,0,0,,Ғалым болу деген осы
Dialogue: 0,0:06:56.87,0:06:58.29,Default,,0,0,0,,Иә
Dialogue: 0,0:06:58.87,0:07:00.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:00.71,0:07:02.83,Default,,0,0,0,,Мен сені жек көрмеймін.Жауап
Dialogue: 0,0:07:03.33,0:07:07.59,Default,,0,0,0,,Сонда да мен Мәртебелін көргім келеді.
Dialogue: 0,0:07:07.67,0:07:09.22,Default,,0,0,0,,Улы сақина!
Dialogue: 0,0:07:11.43,0:07:12.34,Default,,0,0,0,,Ах… Мен оларды бір сәтке де ұмытқан емеспін.
Dialogue: 0,0:07:15.64,0:07:16.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:18.14,0:07:19.23,Default,,0,0,0,,Сыйлық сақинасы
Dialogue: 0,0:07:19.31,0:07:22.81,Default,,0,0,0,,Бұл өте күшті және өлімге әкелетін дозалар (өліммен күресу) оған аз әсер етеді.
Dialogue: 0,0:07:22.90,0:07:25.11,Default,,0,0,0,,Оны қауіпті адамдарға қолданыңыз.
Dialogue: 0,0:07:25.19,0:07:29.82,Default,,0,0,0,,Әсері - Өліммен күресу қабілетін бір нүктеге шоғырландыру.
Dialogue: 0,0:07:29.90,0:07:33.82,Default,,0,0,0,,Жаудың тесіп өткен бөлігін дәл анықтау арқылы жауды дереу өлтіріңіз.
Dialogue: 0,0:07:36.03,0:07:36.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:36.78,0:07:40.04,Default,,0,0,0,,Бұл сенің кінәң, өйткені сен тым күштісің.
Dialogue: 0,0:07:40.12,0:07:42.25,Default,,0,0,0,,Өлімге әкелетін дозаны төмендету нәтиже бермейді
Dialogue: 0,0:07:42.33,0:07:44.83,Default,,0,0,0,,Барлық құралдарды жоюдың пайдасы жоқ
Dialogue: 0,0:07:45.33,0:07:48.42,Default,,0,0,0,,Олай болса, бес мүшең мен мүшеңнің бәрін жаншып ал.
Dialogue: 0,0:07:48.50,0:07:50.88,Default,,0,0,0,,Сені өлуге рұқсат етуден басқа амалым жоқ.
Dialogue: 0,0:07:51.63,0:07:53.51,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:07:53.59,0:07:56.64,Default,,0,0,0,,Сіз шынымен мені өлтіргіңіз келе ме?
Dialogue: 0,0:07:57.68,0:07:59.77,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:08:02.48,0:08:03.73,Default,,0,0,0,,Банкай
Dialogue: 0,0:08:04.69,0:08:05.48,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:05.56,0:08:09.07,Default,,0,0,0,,(барабан механизмінің қозғалу дыбысы)
Dialogue: 0,0:08:10.78,0:08:11.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:18.41,0:08:21.41,Default,,0,0,0,,Каннон Кай Бенихимнің өңделген нұсқасы
Dialogue: 0,0:08:22.00,0:08:24.79,Default,,0,0,0,,Эй... Бұл не?
Dialogue: 0,0:08:25.58,0:08:27.08,Default,,0,0,0,,Банкай?
Dialogue: 0,0:08:27.59,0:08:28.79,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:28.88,0:08:33.17,Default,,0,0,0,,Мәртебеліден алған дүниелердің ішінде Сіздің Банкай туралы ақпарат бар.
Dialogue: 0,0:08:33.76,0:08:38.18,Default,,0,0,0,,Бұл мен оны қазір бірге жүрген адамдардың алдында бірінші рет қолдануым.
Dialogue: 0,0:08:38.76,0:08:41.56,Default,,0,0,0,,Түсіндім, бұл солай.
Dialogue: 0,0:08:41.64,0:08:45.69,Default,,0,0,0,,Мен сізден сұрайын, бірақ ол қандай қабілет?
Dialogue: 0,0:08:45.77,0:08:47.94,Default,,0,0,0,,Мұны естіп тұрсың ба?
Dialogue: 0,0:08:48.02,0:08:49.48,Default,,0,0,0,,Сіз бұлай айта алмайсыз.
Dialogue: 0,0:08:49.57,0:08:51.86,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:08:51.94,0:08:54.61,Default,,0,0,0,,Сұрамай-ақ маған қарай беттеп бара жатырсың деп қорқасың.
Dialogue: 0,0:08:54.70,0:08:56.45,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:56.53,0:09:00.24,Default,,0,0,0,,Бірақ, мен айтпасам да түсінесің.
Dialogue: 0,0:09:01.08,0:09:01.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:04.33,0:09:06.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:13.05,0:09:13.80,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:15.51,0:09:17.84,Default,,0,0,0,,Сіз тынышсыз.
Dialogue: 0,0:09:17.93,0:09:21.76,Default,,0,0,0,,Адамдардың көпшілігі таңғалатыны сонша, олар қолын кесіп тастайды.
Dialogue: 0,0:09:22.27,0:09:26.69,Default,,0,0,0,,Оқығаныңыздай, менің Банкайымның әсері – «диапазон».
Dialogue: 0,0:09:26.77,0:09:31.07,Default,,0,0,0,,Хаха, менің қолымды кесуге батылым жетпейді.
Dialogue: 0,0:09:31.15,0:09:34.49,Default,,0,0,0,,Мен оны бір ғана соққымен оқи алатын шығармын, бірақ...
Dialogue: 0,0:09:34.57,0:09:37.07,Default,,0,0,0,,Не? не істеп жатырсың
Dialogue: 0,0:09:37.15,0:09:40.83,Default,,0,0,0,,Каннон Кай Коухименің қабілеті
Dialogue: 0,0:09:41.74,0:09:44.70,Default,,0,0,0,,Қол тигізген нәрсені түрлендіру мүмкіндігі
Dialogue: 0,0:09:51.88,0:09:53.30,Default,,0,0,0,,Гррр…
Dialogue: 0,0:09:53.38,0:09:55.51,Default,,0,0,0,,Не? Сіз оны көре аласыз ба?
Dialogue: 0,0:09:55.59,0:09:57.76,Default,,0,0,0,,Көздерің сені бірден өлтіруі керек еді.
Dialogue: 0,0:09:57.84,0:10:01.43,Default,,0,0,0,,Көріп тұрсыз, ол да қайта салынған.
Dialogue: 0,0:10:27.87,0:10:29.75,Default,,0,0,0,,саған бір нәрсені түсіндіргім келеді.
Dialogue: 0,0:10:29.83,0:10:33.09,Default,,0,0,0,,Маған ұнамайды, ұнамайды, маған ұнамайды.
Dialogue: 0,0:10:33.59,0:10:37.76,Default,,0,0,0,,Бұл мен жек көретін билік пен билік арасындағы шайқас емес пе?
Dialogue: 0,0:10:37.84,0:10:40.72,Default,,0,0,0,,Мен сені өз өрісіме сүйреу үшін қиындық көрдім.
Dialogue: 0,0:10:40.80,0:10:42.85,Default,,0,0,0,,Оны өз қарқыныңызбен орындаңыз
Dialogue: 0,0:10:42.93,0:10:46.14,Default,,0,0,0,,Сіз не істесеңіз де, нәрсені өзгерте аласыз.
Dialogue: 0,0:10:46.85,0:10:49.23,Default,,0,0,0,,Ол жаман жігіт Кисуке Урахара
Dialogue: 0,0:10:49.31,0:10:50.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:52.31,0:10:55.02,Default,,0,0,0,,Бірақ күткендей, ол мінсіз емес.
Dialogue: 0,0:10:55.61,0:10:57.74,Default,,0,0,0,,Сіз ұмытпайсыз, солай ма?
Dialogue: 0,0:10:58.24,0:11:02.91,Default,,0,0,0,,Бұл өте уланған доп (Gift Bar Deluxe) қашып құтыла алмайтын уланған бекініс.
Dialogue: 0,0:11:02.99,0:11:06.41,Default,,0,0,0,,Сіз бұл жерде дем ала алмайсыз.
Dialogue: 0,0:11:06.49,0:11:09.04,Default,,0,0,0,,Себебі мен әлі де реттеп жатырмын.
Dialogue: 0,0:11:37.53,0:11:40.15,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:11:40.24,0:11:42.74,Default,,0,0,0,,Gift Bar Deluxe енді қолдамайды
Dialogue: 0,0:11:42.82,0:11:44.24,Default,,0,0,0,,Сіз оны көтеруді жоспарлап отырсыз ба?
Dialogue: 0,0:11:48.08,0:11:48.99,Default,,0,0,0,,Тіпті қазір
Dialogue: 0,0:11:49.08,0:11:52.75,Default,,0,0,0,,Мен осылай жерде жорғалап жүрмін, сондықтан мен бар күшімді саламын.
Dialogue: 0,0:11:52.83,0:11:54.29,Default,,0,0,0,,Айтпайсың ба?
Dialogue: 0,0:11:54.38,0:11:55.63,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:11:56.59,0:11:58.13,Default,,0,0,0,,Сіздің Банкайыңыз
Dialogue: 0,0:11:58.21,0:12:01.01,Default,,0,0,0,,Жерде жай ғана жорғалау қауіпті.
Dialogue: 0,0:12:01.09,0:12:03.97,Default,,0,0,0,,Күткендей, мен өте жақсы түсінемін.
Dialogue: 0,0:12:04.05,0:12:06.47,Default,,0,0,0,,Қазірдің өзінде кеш.
Dialogue: 0,0:12:13.73,0:12:15.60,Default,,0,0,0,,Не?
Dialogue: 0,0:12:16.48,0:12:18.23,Default,,0,0,0,,Мен жәшікке қызықпын
Dialogue: 0,0:12:18.32,0:12:20.28,Default,,0,0,0,,Бұл сыйлық бар люкс
Dialogue: 0,0:12:20.36,0:12:23.24,Default,,0,0,0,,Сіз қашып құтылу мүмкін емес дедіңіз.
Dialogue: 0,0:12:23.86,0:12:26.49,Default,,0,0,0,,Өтпейтін демеген
Dialogue: 0,0:12:26.99,0:12:28.37,Default,,0,0,0,,Сондықтан көріңіз
Dialogue: 0,0:12:28.45,0:12:33.37,Default,,0,0,0,,Мен доптың сыртынан жасырын кіру тәсілін жасадым.
Dialogue: 0,0:12:33.96,0:12:36.58,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:12:37.08,0:12:38.63,Default,,0,0,0,,Гриммжоу мырза
Dialogue: 0,0:12:38.71,0:12:39.46,Default,,0,0,0,,Чи…
Dialogue: 0,0:12:47.68,0:12:50.06,Default,,0,0,0,,Сендер, тоқтаңдар.
Dialogue: 0,0:12:50.14,0:12:52.93,Default,,0,0,0,,Енді жылжытуға болады.
Dialogue: 0,0:12:53.43,0:12:55.02,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:12:55.52,0:12:58.94,Default,,0,0,0,,Мен сізді төмен бағаладым.
Dialogue: 0,0:12:59.02,0:13:00.40,Default,,0,0,0,,Не?
Dialogue: 0,0:13:00.48,0:13:04.15,Default,,0,0,0,,Жүрегің жаншылып кетсе де, дем ала ма?
Dialogue: 0,0:13:04.74,0:13:08.70,Default,,0,0,0,,Мен сені осында келе жатып емдедім.
Dialogue: 0,0:13:09.28,0:13:12.70,Default,,0,0,0,,Айзеннің қолымен бетперделері аршылған сынған беттер
Dialogue: 0,0:13:12.79,0:13:14.58,Default,,0,0,0,,Қайтару пышақпен
Dialogue: 0,0:13:14.66,0:13:19.38,Default,,0,0,0,,Арранкардың Рейатсуынан Void Reiatsu-ға толығымен өзгерді.
Dialogue: 0,0:13:19.46,0:13:23.21,Default,,0,0,0,,Мен бұл шайқаста пайдалы болуы мүмкін деп ойладым.
Dialogue: 0,0:13:23.84,0:13:27.72,Default,,0,0,0,,Сіз соншалықты көп оқыдыңыз ба?
Dialogue: 0,0:13:28.43,0:13:29.22,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:29.89,0:13:31.18,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:13:31.26,0:13:34.23,Default,,0,0,0,,Бұл пайдалы болуы мүмкін деп ойладым.
Dialogue: 0,0:13:34.31,0:13:36.48,Default,,0,0,0,,Сондықтан мен дайындалдым.
Dialogue: 0,0:13:37.06,0:13:40.27,Default,,0,0,0,,Мың препараттың біреуін қолдана алсаңыз, жақсы.
Dialogue: 0,0:13:40.36,0:13:43.94,Default,,0,0,0,,Мүмкін болатын барлық нәрсеге дайын болыңыз
Dialogue: 0,0:13:44.03,0:13:46.11,Default,,0,0,0,,Мен осылай істеймін
Dialogue: 0,0:13:46.70,0:13:48.28,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:13:48.86,0:13:50.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:50.87,0:13:54.04,Default,,0,0,0,,Бұл шайқас. Жеңілсең өлесің.
Dialogue: 0,0:13:54.12,0:13:56.91,Default,,0,0,0,,Өлмеу үшін өлетінше дайындалудың қажеті жоқ.
Dialogue: 0,0:13:57.00,0:13:58.79,Default,,0,0,0,,үшін мұны істеп жатқан шығар.
Dialogue: 0,0:13:59.75,0:14:01.54,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:02.04,0:14:04.17,Default,,0,0,0,,Неге қорқасың?
Dialogue: 0,0:14:04.96,0:14:09.39,Default,,0,0,0,,Мен түсіндім деп ойлаймын...
Dialogue: 0,0:14:12.93,0:14:16.35,Default,,0,0,0,,Сен қыңыр бейбақсың. Тек өл.
Dialogue: 0,0:14:17.02,0:14:18.44,Default,,0,0,0,,Гриммжоу мырза
Dialogue: 0,0:14:18.94,0:14:21.56,Default,,0,0,0,,Жауыңды өлтіргенге дейін
Dialogue: 0,0:14:21.65,0:14:23.61,Default,,0,0,0,,Бұл Темемен жасалған келісімшарт.
Dialogue: 0,0:14:23.69,0:14:25.61,Default,,0,0,0,,Бұл келісім-шарттың аяқталуы.
Dialogue: 0,0:14:26.86,0:14:27.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:28.57,0:14:31.03,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:14:31.12,0:14:34.66,Default,,0,0,0,,Ой... Бір нәрсені айтуды ұмытып кетіппін.
Dialogue: 0,0:14:35.45,0:14:36.66,Default,,0,0,0,,Эй, әлі жоқ...
Dialogue: 0,0:14:36.75,0:14:38.71,Default,,0,0,0,,Мен өлгенде
Dialogue: 0,0:14:39.50,0:14:42.92,Default,,0,0,0,,Gift Bal Deluxe оның қуат күші
Dialogue: 0,0:14:43.00,0:14:43.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:44.30,0:14:48.63,Default,,0,0,0,,Маған қорқып, өзімді араласуға жол берме.
Dialogue: 0,0:14:48.72,0:14:52.34,Default,,0,0,0,,Себебі бейсаналық қолданылған құлып шығып кетеді.
Dialogue: 0,0:14:54.93,0:14:58.68,Default,,0,0,0,,Сізге құрмет көрсетіңіз.
Dialogue: 0,0:14:58.77,0:15:01.56,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:15:02.35,0:15:06.90,Default,,0,0,0,,Енді қашуға күшің жетпеген шығар.
Dialogue: 0,0:15:06.98,0:15:08.78,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:08.86,0:15:10.57,Default,,0,0,0,,Алайда...
Dialogue: 0,0:15:11.24,0:15:15.91,Default,,0,0,0,,Сіз оны қандай да бір жолмен анықтай алатыныңызға сенімдімін.
Dialogue: 0,0:15:18.08,0:15:19.79,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:15:20.29,0:15:21.83,Default,,0,0,0,,Себебі мен ашулымын...
Dialogue: 0,0:15:22.33,0:15:27.50,Default,,0,0,0,,Мен оны өлімші деп айтпаймын...
Dialogue: 0,0:15:35.30,0:15:36.14,Default,,0,0,0,,Чи…
Dialogue: 0,0:15:36.64,0:15:39.18,Default,,0,0,0,,Бәле, мынау...
Dialogue: 0,0:15:39.27,0:15:42.77,Default,,0,0,0,,Сіз осындай нәрседен құтыла аласыз ба?
Dialogue: 0,0:15:44.31,0:15:45.65,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:15:45.73,0:15:49.90,Default,,0,0,0,,Бұл шынымен де сіз айтқан бес мүмкіндіктің бірі.
Dialogue: 0,0:15:50.49,0:15:53.91,Default,,0,0,0,,Ішіндегі реятсу...4.
Dialogue: 0,0:15:53.99,0:15:55.28,Default,,0,0,0,,Кемінде 2 бару
Dialogue: 0,0:15:56.03,0:15:57.66,Default,,0,0,0,,Кіреберіс...
Dialogue: 0,0:15:57.74,0:15:59.91,Default,,0,0,0,,Иә? Ауызыңды жап!
Dialogue: 0,0:16:00.62,0:16:03.87,Default,,0,0,0,,Негізі мен Ичигомен бірге барғым келді.
Dialogue: 0,0:16:09.21,0:16:10.71,Default,,0,0,0,,Гах... гах
Dialogue: 0,0:16:10.80,0:16:12.88,Default,,0,0,0,,Мұның бәрі осы ма?
Dialogue: 0,0:16:16.97,0:16:21.39,Default,,0,0,0,,Сізді ортада қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:16:22.64,0:16:24.02,Default,,0,0,0,,Куросаки мырза
Dialogue: 0,0:16:24.10,0:16:25.40,Default,,0,0,0,,Кучики мырза
Dialogue: 0,0:16:25.90,0:16:27.15,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:16:41.91,0:16:43.58,Default,,0,0,0,,Сіз оны сезінесіз бе? Инуэ
Dialogue: 0,0:16:44.58,0:16:45.29,Default,,0,0,0,,Иә
Dialogue: 0,0:16:46.75,0:16:48.29,Default,,0,0,0,,Бұл есіктің артында.
Dialogue: 0,0:16:49.92,0:16:50.67,Default,,0,0,0,,Иә
Dialogue: 0,0:16:52.63,0:16:53.59,Default,,0,0,0,,Екіден бірге...
Dialogue: 0,0:16:53.67,0:16:54.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:54.76,0:16:56.34,Default,,0,0,0,,Бұл қорқақ болуы мүмкін, бірақ
Dialogue: 0,0:16:57.14,0:16:58.60,Default,,0,0,0,,Қорғаныс сізге қалды.
Dialogue: 0,0:16:59.68,0:17:01.35,Default,,0,0,0,,Өтінемін, Инуэ
Dialogue: 0,0:17:03.77,0:17:04.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:06.40,0:17:07.69,Default,,0,0,0,,Соңында
Dialogue: 0,0:17:09.11,0:17:10.15,Default,,0,0,0,,Ақырында...
Dialogue: 0,0:17:11.11,0:17:12.07,Default,,0,0,0,,Ақырында...
Dialogue: 0,0:17:15.90,0:17:18.78,Default,,0,0,0,,Мен Куросаки-кунмен күресіп, оны қорғай аламын.
Dialogue: 0,0:17:24.71,0:17:26.29,Default,,0,0,0,,Сізді көргеніме қуаныштымын
Dialogue: 0,0:17:26.83,0:17:28.17,Default,,0,0,0,,Мен оны көптен күттім.
Dialogue: 0,0:17:28.75,0:17:30.75,Default,,0,0,0,,Қараңғы балам
Dialogue: 0,0:17:34.80,0:17:36.26,Default,,0,0,0,,Оны неге қалдырмасқа?
Dialogue: 0,0:17:36.76,0:17:39.47,Default,,0,0,0,,Бұл мүлдем қорғансыз.
Dialogue: 0,0:17:40.51,0:17:42.89,Default,,0,0,0,,Мен айтқым келеді...
Dialogue: 0,0:17:42.97,0:17:46.89,Default,,0,0,0,,Мен қорғансыз емеспін.
Dialogue: 0,0:17:47.60,0:17:51.86,Default,,0,0,0,,Толып жатқан рухани қысым қалыптасып қалғандай.
Dialogue: 0,0:17:52.44,0:17:54.36,Default,,0,0,0,,Сіз күштірек болдыңыз.
Dialogue: 0,0:17:54.86,0:17:55.65,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:55.74,0:17:59.53,Default,,0,0,0,,Бұл сіздің нағыз күшіңіз.
Dialogue: 0,0:18:00.49,0:18:02.28,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:18:02.37,0:18:04.29,Default,,0,0,0,,Сіз оң жақтан келе жатырсыз ба?
Dialogue: 0,0:18:04.37,0:18:06.29,Default,,0,0,0,,Сол жақтан келе жатыр ма?
Dialogue: 0,0:18:06.87,0:18:09.04,Default,,0,0,0,,Оны асыға күтейік
Dialogue: 0,0:18:11.84,0:18:14.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:14.84,0:18:18.43,Default,,0,0,0,,Ұзақ уақыттан кейін әке мен бала арасындағы диалогтан ләззат алғым келеді.
Dialogue: 0,0:18:20.22,0:18:23.18,Default,,0,0,0,,Сіз менің ата-анам емессіз.
Dialogue: 0,0:18:23.26,0:18:25.68,Default,,0,0,0,,Исшин Куросаки?
Dialogue: 0,0:18:25.77,0:18:28.98,Default,,0,0,0,,Бұл уақытша әке.
Dialogue: 0,0:18:29.06,0:18:34.32,Default,,0,0,0,,Сіз өзіңіздің күшіңіздің қайнар көзі туралы естіген болуыңыз керек.
Dialogue: 0,0:18:34.40,0:18:35.78,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:18:35.86,0:18:37.32,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:37.40,0:18:39.70,Default,,0,0,0,,Сіз менің ата-анам емессіз
Dialogue: 0,0:18:39.78,0:18:41.70,Default,,0,0,0,,Бұл менің ата-анамды өлтірген адам!
Dialogue: 0,0:18:41.78,0:18:43.53,Default,,0,0,0,,Менің анам туралы айтып тұрсың ба?
Dialogue: 0,0:18:43.62,0:18:45.08,Default,,0,0,0,,Сіз өте әйелдіксіз, Ичиго!
Dialogue: 0,0:18:46.16,0:18:47.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:50.67,0:18:52.38,Default,,0,0,0,,Гецуга Теншо!
Dialogue: 0,0:19:21.61,0:19:25.58,Default,,0,0,0,,Болашақты көре білу шайқаста жеңе алатыныңды білдірмейді.
Dialogue: 0,0:19:26.41,0:19:30.16,Default,,0,0,0,,Сізге бұл туралы білсеңіз де, алдын ала алмайтын шабуыл жасау жеткілікті.
Dialogue: 0,0:19:31.17,0:19:35.46,Default,,0,0,0,,Мен сенімен бірге сенің бойыңда жатқан барлық ғылым мен құдіретті жерлеймін.
Dialogue: 0,0:19:36.30,0:19:38.38,Default,,0,0,0,,Надандығыңызды түзетейін.
Dialogue: 0,0:19:38.46,0:19:39.46,Default,,0,0,0,,Урю Ишида
Dialogue: 0,0:19:40.59,0:19:43.34,Default,,0,0,0,,Майдан туралы бәрін білу жеткіліксіз.
Dialogue: 0,0:19:43.97,0:19:46.60,Default,,0,0,0,,Соғыс жағдайын «көруден» алыс
Dialogue: 0,0:19:47.35,0:19:52.10,Default,,0,0,0,,Сіз Ичиго Куросакиді ең маңызды шайқасқа жібердіңіз.
Dialogue: 0,0:19:52.69,0:19:57.36,Default,,0,0,0,,Жоспар оның бәрін білуші және құдіретті емес Ұлы Мәртебені жеңу.
Dialogue: 0,0:19:57.44,0:19:59.36,Default,,0,0,0,,Бұл ақылға қонымды стратегия.
Dialogue: 0,0:19:59.86,0:20:01.61,Default,,0,0,0,,Бірақ сіз қателесесіз.
Dialogue: 0,0:20:01.70,0:20:02.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:10.83,0:20:11.50,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:20:13.25,0:20:14.96,Default,,0,0,0,,Рух патшасының күші...
Dialogue: 0,0:20:17.96,0:20:18.63,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:37.48,0:20:37.98,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:20:38.90,0:20:40.98,Default,,0,0,0,,Біз не үшін қайғыра аламыз?
Dialogue: 0,0:20:41.61,0:20:44.36,Default,,0,0,0,,Ол өлетіндей өлді.
Dialogue: 0,0:20:44.45,0:20:48.66,Default,,0,0,0,,Мен сені дүниеге әкелдім, сені асырау үшін өмір сүрдім.
Dialogue: 0,0:20:48.74,0:20:50.12,Default,,0,0,0,,Сіз не нәрсеге қанағаттанбайсыз?
Dialogue: 0,0:20:50.20,0:20:52.91,Default,,0,0,0,,Бұдан асқан бақыт бар ма?
Dialogue: 0,0:20:53.00,0:20:53.66,Default,,0,0,0,,Уф
Dialogue: 0,0:20:54.67,0:20:55.46,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:58.38,0:20:59.63,Default,,0,0,0,,Куросаки-кун!
Dialogue: 0,0:21:02.30,0:21:03.63,Default,,0,0,0,,Куросаки-кун!
Dialogue: 0,0:21:06.18,0:21:08.64,Default,,0,0,0,,Әңгіменің соңы
Dialogue: 0,0:21:08.72,0:21:09.85,Default,,0,0,0,,Көңілді болды.
Dialogue: 0,0:21:11.56,0:21:12.85,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:21:12.93,0:21:15.73,Default,,0,0,0,,Біз төбелесеміз бе, Ичиго?
Dialogue: 0,0:21:16.31,0:21:18.65,Default,,0,0,0,,үшінн білу мен құдіреттіліктің күшіне не назар аударылды?
Dialogue: 0,0:21:18.73,0:21:20.36,Default,,0,0,0,,Бұл жақсы таңдау болды.
Dialogue: 0,0:21:20.86,0:21:21.48,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:21.57,0:21:25.20,Default,,0,0,0,,Мәртебелі мәртебенің қазіргі жағдайын өлшеуге тырысу тым асқақ.
Dialogue: 0,0:21:30.37,0:21:31.99,Default,,0,0,0,,Құдіретті (Құдіретті)
Dialogue: 0,0:21:32.08,0:21:32.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:39.13,0:21:41.88,Default,,0,0,0,,Мен туралы не білгің келді?
Dialogue: 0,0:21:41.96,0:21:43.26,Default,,0,0,0,,Урю Ишида
Dialogue: 0,0:21:49.43,0:21:51.51,Default,,0,0,0,,Үмітсіздік осыдан басталады.
Dialogue: 0,0:21:59.15,0:22:00.06,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:22:00.15,0:22:01.06,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:01.98,0:22:03.40,Default,,0,0,0,,Күте тұрыңыз, Куросаки-кун!
Dialogue: 0,0:22:07.61,0:22:10.28,Default,,0,0,0,,Қандай абайсыз шабуыл.
Dialogue: 0,0:22:10.37,0:22:13.70,Default,,0,0,0,,Ол әйелді неге әкелдің?
Dialogue: 0,0:22:13.79,0:22:16.41,Default,,0,0,0,,Сіз өшпенділікке бой алдырасыз ба?
Dialogue: 0,0:22:16.50,0:22:17.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:17.50,0:22:19.21,Default,,0,0,0,,Одан ауытқыма
Dialogue: 0,0:22:19.79,0:22:20.50,Default,,0,0,0,,Аһ!
Dialogue: 0,0:22:23.09,0:22:26.38,Default,,0,0,0,,Ақырында мені жеп, өлесің.
Dialogue: 0,0:22:26.47,0:22:29.18,Default,,0,0,0,,Мұндай асығыс өлу қызықсыз болар еді
Dialogue: 0,0:22:29.93,0:22:33.10,Default,,0,0,0,,Қанша уақыт пен ғажайыптар қажет болды?
Dialogue: 0,0:22:33.18,0:22:35.35,Default,,0,0,0,,Мен сені жараттым деп ойлаймын
Dialogue: 0,0:22:36.48,0:22:37.31,Default,,0,0,0,,Ауытқуға болмайды
Dialogue: 0,0:22:37.39,0:22:40.19,Default,,0,0,0,,Өміріңізге жеңіл қарамаңыз
Dialogue: 0,0:22:40.94,0:22:43.82,Default,,0,0,0,,Сіздің денеңіз - сіздің күшіңіз
Dialogue: 0,0:22:43.90,0:22:46.40,Default,,0,0,0,,Сіз жалғыз емессіз.
Dialogue: 0,0:22:46.49,0:22:49.65,Default,,0,0,0,,Бар күш-қуатыңды сарқып, өл.
Dialogue: 0,0:22:49.74,0:22:51.11,Default,,0,0,0,,Ичиго!
Dialogue: 0,0:22:56.41,0:22:58.41,Default,,0,0,0,,♪～
Dialogue: 0,0:24:22.46,0:24:24.46,Default,,0,0,0,,～♪
Dialogue: 0,0:24:31.26,0:24:33.05,Default,,0,0,0,,Бұл гүл жапырақшасы
Dialogue: 0,0:24:34.84,0:24:36.93,Default,,0,0,0,,Оның шашырап жатқаны ғажайып па?
Dialogue: 0,0:24:38.43,0:24:44.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
