Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:05.42,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:00:21.27,0:00:22.35,Default,,0,0,0,,Көз жасы?
Dialogue: 0,0:00:26.52,0:00:27.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:29.11,0:00:30.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:30.61,0:00:33.11,Default,,0,0,0,,Әй, не болып жатыр?
Dialogue: 0,0:00:33.19,0:00:34.11,Default,,0,0,0,,Инуэ ше?
Dialogue: 0,0:00:35.24,0:00:39.12,Default,,0,0,0,,Инуэ өз жанының орнына
Dialogue: 0,0:00:39.70,0:00:41.87,Default,,0,0,0,,Ол Джухабахты жерледі.
Dialogue: 0,0:00:41.95,0:00:42.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:46.50,0:00:48.04,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:00:48.13,0:00:49.09,Default,,0,0,0,,О
Dialogue: 0,0:00:52.01,0:00:54.72,Default,,0,0,0,,Инуэ қолында бардың бәрін пайдаланады
Dialogue: 0,0:00:55.38,0:00:57.84,Default,,0,0,0,,Ол бізді бірге ұстады.
Dialogue: 0,0:00:58.89,0:01:00.31,Default,,0,0,0,,Ичиго…
Dialogue: 0,0:01:00.93,0:01:03.68,Default,,0,0,0,,Әлем енді құтқарылды, солай ма?
Dialogue: 0,0:01:06.64,0:01:07.31,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:01:07.40,0:01:08.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:35.38,0:01:37.68,Default,,0,0,0,,Ичиго, сен...
Dialogue: 0,0:01:38.51,0:01:40.64,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:01:41.64,0:01:43.06,Default,,0,0,0,,Ичиго
Dialogue: 0,0:01:43.14,0:01:45.81,Default,,0,0,0,,Ха! Әлгі қарғыс атқан монах?
Dialogue: 0,0:01:49.40,0:01:50.56,Default,,0,0,0,,Ичиго…
Dialogue: 0,0:01:53.15,0:01:54.28,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:02:05.91,0:02:07.50,Default,,0,0,0,,- (Хашвальд) Неліктен? - (Ишида) Ах!
Dialogue: 0,0:02:08.79,0:02:12.04,Default,,0,0,0,,Неге маған бет бұрасың?
Dialogue: 0,0:02:18.93,0:02:19.72,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:21.43,0:02:22.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:22.47,0:02:23.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:27.02,0:02:28.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.94,0:02:31.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:33.06,0:02:34.98,Default,,0,0,0,,Inoue…
Dialogue: 0,0:02:42.24,0:02:43.24,Default,,0,0,0,,Таң болды
Dialogue: 0,0:02:44.12,0:02:45.49,Default,,0,0,0,,Хашвальд
Dialogue: 0,0:02:46.16,0:02:48.75,Default,,0,0,0,,Уақыт өтіп кеткен.
Dialogue: 0,0:02:54.29,0:02:54.88,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:03:02.30,0:03:04.64,Default,,0,0,0,,Құдіреті шексіз
Dialogue: 0,0:03:11.27,0:03:13.94,Default,,0,0,0,,Юха… Бах…
Dialogue: 0,0:03:14.02,0:03:15.94,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:03:16.02,0:03:16.98,Default,,0,0,0,,Сіз...
Dialogue: 0,0:03:17.07,0:03:19.07,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:03:19.15,0:03:20.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:20.11,0:03:24.49,Default,,0,0,0,,Мұндай болашақ болған жоқ
Dialogue: 0,0:03:25.49,0:03:27.49,Default,,0,0,0,,♪～
Dialogue: 0,0:04:52.95,0:04:54.96,Default,,0,0,0,,～♪
Dialogue: 0,0:04:56.04,0:04:56.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:56.83,0:04:59.17,Default,,0,0,0,,Жарық жете алмайтын шынайы әлемдік қамалдың (Ваалвельт) түбінде
Dialogue: 0,0:04:59.25,0:05:01.25,Default,,0,0,0,,Байқамағаныңыз дұрыс.
Dialogue: 0,0:05:02.26,0:05:05.05,Default,,0,0,0,,Қиындық қолғаптарын қосудың алдында
Dialogue: 0,0:05:05.76,0:05:08.43,Default,,0,0,0,,Мәртебелі мен мен арасындағы билік орын ауыстырды.
Dialogue: 0,0:05:09.01,0:05:13.60,Default,,0,0,0,,Ал менің шын құдіретім ұлы мәртебелі құдіретінен де жоғары.
Dialogue: 0,0:05:13.68,0:05:15.44,Default,,0,0,0,,Ұрысқа жақсы
Dialogue: 0,0:05:16.10,0:05:20.57,Default,,0,0,0,,Әсіресе сіз сияқты қатесін түзететін адамға емес.
Dialogue: 0,0:05:20.65,0:05:21.77,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:21.86,0:05:23.90,Default,,0,0,0,,Таразы төңкерілді
Dialogue: 0,0:05:25.45,0:05:27.32,Default,,0,0,0,,Сонда сенің сенімділігің содан ба, Цуки?
Dialogue: 0,0:05:27.86,0:05:31.08,Default,,0,0,0,,Алла Тағаланың нағыз сұмдығы
Dialogue: 0,0:05:31.16,0:05:33.29,Default,,0,0,0,,Бұл болашақты көре білу туралы емес.
Dialogue: 0,0:05:33.37,0:05:34.87,Default,,0,0,0,,Не айтпақсың…
Dialogue: 0,0:05:34.95,0:05:37.62,Default,,0,0,0,,Шайқас аяқталғаннан кейін мен сізге хабарлаймын.
Dialogue: 0,0:05:38.67,0:05:42.75,Default,,0,0,0,,Енді сен туралы бәрін таразылап көр, Урю Ишида.
Dialogue: 0,0:05:43.25,0:05:47.88,Default,,0,0,0,,Сынған таразыларыңыз қайтып келмейтін жолды көрсетіп тұр
Dialogue: 0,0:05:52.97,0:05:53.81,Default,,0,0,0,,Балалар!
Dialogue: 0,0:05:54.31,0:05:55.18,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:57.85,0:05:58.94,Default,,0,0,0,,Аһ!
Dialogue: 0,0:06:00.94,0:06:04.53,Default,,0,0,0,,Қос қылыш сенің жалғыз артықшылығың деп ойладың ба?
Dialogue: 0,0:06:05.19,0:06:09.28,Default,,0,0,0,,Сіз менің қабілеттерімде тесік іздеп жүрсіз бе?
Dialogue: 0,0:06:09.36,0:06:10.07,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:12.08,0:06:16.16,Default,,0,0,0,,Ичиго, сіз қателесесіз.
Dialogue: 0,0:06:16.66,0:06:21.17,Default,,0,0,0,,Болашақ бір жолда болатын нәрсе емес.
Dialogue: 0,0:06:21.88,0:06:23.17,Default,,0,0,0,,Болашақ қандай?
Dialogue: 0,0:06:23.25,0:06:28.30,Default,,0,0,0,,Осы нүктеге дейін шашылған сансыз құмдар сияқты нәрсе.
Dialogue: 0,0:06:29.09,0:06:35.14,Default,,0,0,0,,Бір қарағанда шашыраңқы болып көрінетін сансыз құм түйірлері, әрқайсысы
Dialogue: 0,0:06:35.64,0:06:37.10,Default,,0,0,0,,Бұл болашақ.
Dialogue: 0,0:06:37.81,0:06:41.56,Default,,0,0,0,,Сансыз мүмкіндіктер бар деп айтуға болады.
Dialogue: 0,0:06:42.27,0:06:43.40,Default,,0,0,0,,Ичиго
Dialogue: 0,0:06:43.48,0:06:47.11,Default,,0,0,0,,Мен үміт туралы айтқанды ұнатамын.
Dialogue: 0,0:06:48.15,0:06:51.82,Default,,0,0,0,,Болашақты өзгертуге болады, бұл факт.
Dialogue: 0,0:06:51.91,0:06:55.24,Default,,0,0,0,,Үміт тудыратын және тамаша фактілер
Dialogue: 0,0:06:55.79,0:06:58.12,Default,,0,0,0,,Бірақ болашақты өзгерту деген нені білдіреді?
Dialogue: 0,0:06:58.20,0:07:03.67,Default,,0,0,0,,Бұл бір құмнан екіншісіне секіру.
Dialogue: 0,0:07:03.75,0:07:07.34,Default,,0,0,0,,Ал мен құмның әрбір түйірін алдым
Dialogue: 0,0:07:07.42,0:07:11.13,Default,,0,0,0,,Үлкен биіктіктен қарауға және өзара әрекеттесуге болады.
Dialogue: 0,0:07:12.05,0:07:17.01,Default,,0,0,0,,Алла Тағала болашақты көретін құдірет емес.
Dialogue: 0,0:07:17.10,0:07:19.73,Default,,0,0,0,,Бұл болашақты өзгертетін күш.
Dialogue: 0,0:07:24.06,0:07:24.81,Default,,0,0,0,,Инау!
Dialogue: 0,0:07:24.90,0:07:26.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:28.73,0:07:31.15,Default,,0,0,0,,Кешіріңіз... кешіріңіз...
Dialogue: 0,0:07:32.41,0:07:34.07,Default,,0,0,0,,Ичиго.
Dialogue: 0,0:07:34.16,0:07:39.54,Default,,0,0,0,,Мен сені қорғай алмасам, ол әйелдің болашағы.
Dialogue: 0,0:07:40.04,0:07:43.46,Default,,0,0,0,,Иә, мен оны өзгерттім.
Dialogue: 0,0:07:43.54,0:07:46.96,Default,,0,0,0,,Ичиго, үміт үзбе.
Dialogue: 0,0:07:47.04,0:07:48.46,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:07:48.55,0:07:53.68,Default,,0,0,0,,Тағдыр және мүмкіндік деп аталатын домалақ құм түйіршіктерінде
Dialogue: 0,0:07:53.76,0:07:57.72,Default,,0,0,0,,Көзіңізді жұмып, секіруді жалғастырыңыз.
Dialogue: 0,0:07:57.81,0:08:01.73,Default,,0,0,0,,Бұл адамдар үшін үміт.
Dialogue: 0,0:08:01.81,0:08:05.69,Default,,0,0,0,,Барлығымыз таразыда жүреміз.
Dialogue: 0,0:08:06.52,0:08:11.24,Default,,0,0,0,,Сізге ненің дұрыс, ненің бұрыс екенін ажыратыңыз
Dialogue: 0,0:08:11.74,0:08:16.41,Default,,0,0,0,,Бөлінген дұрыс пен бұрыс бөліктері бір-бірімен қабаттасып, адам бейнесін жасайды.
Dialogue: 0,0:08:17.83,0:08:19.87,Default,,0,0,0,,Мен сондаймын
Dialogue: 0,0:08:21.45,0:08:25.00,Default,,0,0,0,,Сен де солай істеген боларсың, Урю Ишида.
Dialogue: 0,0:08:26.21,0:08:28.79,Default,,0,0,0,,Мен сені көре алмаймын
Dialogue: 0,0:08:29.42,0:08:33.05,Default,,0,0,0,,Таразыны өлшеп, таңдауды жалғастырған болу керек.
Dialogue: 0,0:08:33.13,0:08:35.80,Default,,0,0,0,,Мен сені көре алмаймын
Dialogue: 0,0:08:36.59,0:08:39.47,Default,,0,0,0,,Сіз кімсіз? Урю Ишида
Dialogue: 0,0:08:41.06,0:08:44.48,Default,,0,0,0,,Шынымен, сол таяз адамдарға.
Dialogue: 0,0:08:44.56,0:08:46.48,Default,,0,0,0,,Өз өміріне қауіп төндіру
Dialogue: 0,0:08:46.56,0:08:48.56,Default,,0,0,0,,Сіз шынымен де осыны қалайсыз ба?
Dialogue: 0,0:08:49.07,0:08:50.78,Default,,0,0,0,,Тапсырма ұзақ.
Dialogue: 0,0:08:52.11,0:08:55.82,Default,,0,0,0,,Мен кіммін...?
Dialogue: 0,0:08:56.74,0:09:00.53,Default,,0,0,0,,Сіз осындай нәрсеге жауап бере аласыз ба?
Dialogue: 0,0:09:06.87,0:09:08.92,Default,,0,0,0,,Мен үшін солай
Dialogue: 0,0:09:09.42,0:09:13.17,Default,,0,0,0,,Сізді жеңгеннен кейін мен түсінемін.
Dialogue: 0,0:09:14.26,0:09:15.42,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:19.14,0:09:20.10,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:09:20.18,0:09:23.18,Default,,0,0,0,,Шекараны бұзу санының өсуі тоқтамайды!
Dialogue: 0,0:09:24.14,0:09:26.52,Default,,0,0,0,,Квинси не істегісі келеді?
Dialogue: 0,0:09:26.60,0:09:28.06,Default,,0,0,0,,Әлем жойылады!
Dialogue: 0,0:09:28.15,0:09:32.19,Default,,0,0,0,,Мен рухани баланы қара қуыс арқылы атып көрдім.
Dialogue: 0,0:09:32.28,0:09:35.24,Default,,0,0,0,,Ол бір сәтке кішірейеді, бірақ содан кейін қалыпты өлшемге оралады.
Dialogue: 0,0:09:35.32,0:09:37.99,Default,,0,0,0,,Бір сәтке де кішірейіп кеттің.
Dialogue: 0,0:09:38.07,0:09:39.91,Default,,0,0,0,,Иә, бірақ үмітіңізді үзбеңіз.
Dialogue: 0,0:09:39.99,0:09:42.95,Default,,0,0,0,,Әсерді арттырудың жалғыз жолы - оны жою.
Dialogue: 0,0:09:43.04,0:09:45.54,Default,,0,0,0,,Бұл энергияның бірдей мөлшері
Dialogue: 0,0:09:45.62,0:09:47.46,Default,,0,0,0,,Бұл бір-бірімізді ұрудан басқа амалымыз жоқ дегенді білдіре ме?
Dialogue: 0,0:09:47.54,0:09:49.75,Default,,0,0,0,,Мұндай энергия қайда?
Dialogue: 0,0:09:49.83,0:09:52.42,Default,,0,0,0,,Білсең мен саған қамқор болмас едім!
Dialogue: 0,0:09:53.42,0:09:55.46,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:09:55.55,0:09:57.09,Default,,0,0,0,,Не істеу керек Акин
Dialogue: 0,0:09:57.17,0:09:58.72,Default,,0,0,0,,Бұл бұрмалау
Dialogue: 0,0:09:58.80,0:10:04.18,Default,,0,0,0,,Бұл дүниенің жандары мен Жан қоғамы арасындағы тепе-теңдік бұзылғандықтан таралуда.
Dialogue: 0,0:10:04.27,0:10:06.93,Default,,0,0,0,,О? Енді не айтып тұрсың?
Dialogue: 0,0:10:08.27,0:10:10.69,Default,,0,0,0,,Сейрейтті теңестіру туралы не деуге болады?
Dialogue: 0,0:10:10.77,0:10:11.94,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:15.78,0:10:17.78,Default,,0,0,0,,Қиял патшалығының қақпасын ашу
Dialogue: 0,0:10:18.95,0:10:21.70,Default,,0,0,0,,Мен де бір нәрсе сұрасам болады ма?
Dialogue: 0,0:10:21.78,0:10:23.28,Default,,0,0,0,,Сен неге?
Dialogue: 0,0:10:23.37,0:10:25.95,Default,,0,0,0,,Менің қандай адам екенімді сұрап тұрсың ба?
Dialogue: 0,0:10:26.58,0:10:28.58,Default,,0,0,0,,Осындай сұрақтарды қайта-қайта қоймас бұрын
Dialogue: 0,0:10:28.66,0:10:31.42,Default,,0,0,0,,Мені тезірек жеңіңіз
Dialogue: 0,0:10:31.50,0:10:34.59,Default,,0,0,0,,Жухабахқа асығуымыз керек емес пе?
Dialogue: 0,0:10:35.34,0:10:36.96,Default,,0,0,0,,Олар өледі
Dialogue: 0,0:10:37.59,0:10:40.59,Default,,0,0,0,,Мен сені қанша бүлдірсем де,
Dialogue: 0,0:10:40.68,0:10:43.85,Default,,0,0,0,,Мәртебеліге ешқандай қауіп төнбейді.
Dialogue: 0,0:10:44.85,0:10:45.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:55.36,0:10:56.32,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:59.15,0:11:02.28,Default,,0,0,0,,Урю Ишида, сен бақыттысың
Dialogue: 0,0:11:02.78,0:11:05.95,Default,,0,0,0,,Мені Райден Хантқа сәтті түсірді.
Dialogue: 0,0:11:06.04,0:11:09.33,Default,,0,0,0,,Осылайша мен қираудың сансыз қасиетті жебелерін ата алдым (Гейрих Пфейл).
Dialogue: 0,0:11:09.41,0:11:13.92,Default,,0,0,0,,Бұл бақыт сізге бірдей бақытсыздық ретінде келеді.
Dialogue: 0,0:11:14.00,0:11:14.75,Default,,0,0,0,,Ga!
Dialogue: 0,0:11:15.34,0:11:16.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:16.71,0:11:18.67,Default,,0,0,0,,Менің қасиетті әріпім «В»
Dialogue: 0,0:11:19.42,0:11:21.09,Default,,0,0,0,,Әлемдік үйлесімділік (баланс)
Dialogue: 0,0:11:21.59,0:11:25.76,Default,,0,0,0,,Диапазон әлемінде кездесетін бақытсыздықты бақытты адамдармен бөлісу арқылы.
Dialogue: 0,0:11:25.85,0:11:28.06,Default,,0,0,0,,Дүниедегі үйлесімділікті сақтау
Dialogue: 0,0:11:28.72,0:11:31.69,Default,,0,0,0,,Урю Ишиданы жеңу мүмкіндігіңіз жоқ
Dialogue: 0,0:11:32.19,0:11:35.31,Default,,0,0,0,,Мен енді сізден ештеңе сұрай алмаймын.
Dialogue: 0,0:11:35.40,0:11:37.98,Default,,0,0,0,,Егер сіз ештеңе айтпасаңыз, бұл да жақсы.
Dialogue: 0,0:11:38.48,0:11:39.32,Default,,0,0,0,,Міне
Dialogue: 0,0:11:39.40,0:11:40.70,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:11:41.20,0:11:43.53,Default,,0,0,0,,Оны көргің келмей ме?
Dialogue: 0,0:11:44.03,0:11:46.62,Default,,0,0,0,,Менің... Шрифт
Dialogue: 0,0:11:47.20,0:11:49.33,Default,,0,0,0,,Өмірді ұзарту қандай қызықсыз.
Dialogue: 0,0:11:49.41,0:11:52.25,Default,,0,0,0,,Егер сіз мұнымен жеңе алсаңыз, оны бұрыннан пайдалануыңыз керек еді.
Dialogue: 0,0:11:53.46,0:11:54.71,Default,,0,0,0,,Төңкерілу
Dialogue: 0,0:11:55.54,0:11:57.63,Default,,0,0,0,,Уақыт келді деп ойладым.
Dialogue: 0,0:11:58.63,0:12:00.05,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:12:00.13,0:12:02.26,Default,,0,0,0,,Менің Шрифтім
Dialogue: 0,0:12:02.76,0:12:05.14,Default,,0,0,0,,«А» толық антитеза
Dialogue: 0,0:12:05.22,0:12:06.35,Default,,0,0,0,,Не!
Dialogue: 0,0:12:07.18,0:12:09.43,Default,,0,0,0,,Антитеза
Dialogue: 0,0:12:09.52,0:12:12.77,Default,,0,0,0,,Екі көрсетілген нүкте арасында орын алған оқиғалар
Dialogue: 0,0:12:12.85,0:12:15.23,Default,,0,0,0,,Кері айналдыруға болады
Dialogue: 0,0:12:15.31,0:12:20.11,Default,,0,0,0,,Бұл жолы мен өзімнің де, сенің де жараларымды жай ғана өзгерттім.
Dialogue: 0,0:12:21.19,0:12:22.36,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:12:26.37,0:12:28.99,Default,,0,0,0,,Ұлы күш.
Dialogue: 0,0:12:30.33,0:12:33.87,Default,,0,0,0,,Мәртебелі назар аударып отырғаны таңқаларлық емес.
Dialogue: 0,0:12:34.37,0:12:37.21,Default,,0,0,0,,Егер сізде болған оқиғаны кері қайтаруға күшіңіз болса
Dialogue: 0,0:12:37.29,0:12:39.88,Default,,0,0,0,,Ұлы мәртебелі билікке кім қарсы тұра алады?
Dialogue: 0,0:12:39.96,0:12:42.26,Default,,0,0,0,,Бұл жай ғана сіз болуыңыз мүмкін.
Dialogue: 0,0:12:42.84,0:12:44.13,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:12:44.63,0:12:46.47,Default,,0,0,0,,Сіз Алла Тағаланы айттыңыз.
Dialogue: 0,0:12:46.55,0:12:48.76,Default,,0,0,0,,Сіз шынайы күш туралы айтып отырсыз ба?
Dialogue: 0,0:12:48.85,0:12:51.39,Default,,0,0,0,,Қалауыңызша қабылдаңыз
Dialogue: 0,0:12:51.89,0:12:53.48,Default,,0,0,0,,Мен айта аламын
Dialogue: 0,0:12:53.56,0:12:57.90,Default,,0,0,0,,Бұл жерде сені тоқтатқаным дұрыс болды.
Dialogue: 0,0:12:57.98,0:12:58.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:59.48,0:13:01.53,Default,,0,0,0,,Мен сені жіберемін деп ойлайсың ба?
Dialogue: 0,0:13:01.61,0:13:02.32,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:03.15,0:13:05.95,Default,,0,0,0,,Сіздің антитерсисіңіз тамаша, бірақ
Dialogue: 0,0:13:06.03,0:13:08.53,Default,,0,0,0,,Менің балансыма сәйкес келмейді
Dialogue: 0,0:13:08.62,0:13:09.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:10.03,0:13:11.41,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:13:11.49,0:13:13.54,Default,,0,0,0,,Бақытсыздық ортақ болады.
Dialogue: 0,0:13:13.62,0:13:17.21,Default,,0,0,0,,Және менің барлық бақытсыздықтарым
Dialogue: 0,0:13:17.29,0:13:20.42,Default,,0,0,0,,Сіз оны осы алмастырғыш қалқанмен ала аласыз.
Dialogue: 0,0:13:21.00,0:13:22.96,Default,,0,0,0,,Басқаша айтқанда, оның мағынасы осы.
Dialogue: 0,0:13:23.05,0:13:26.01,Default,,0,0,0,,Мені ренжіткеніңіз менің бақытым
Dialogue: 0,0:13:26.09,0:13:28.80,Default,,0,0,0,,Сізге бірдей бақытсыздық түседі.
Dialogue: 0,0:13:29.39,0:13:32.06,Default,,0,0,0,,Менің тәніме түскен бақытсыздық
Dialogue: 0,0:13:32.14,0:13:34.39,Default,,0,0,0,,Осы Фрейндшильдке берілді...
Dialogue: 0,0:13:34.48,0:13:35.48,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:35.56,0:13:38.40,Default,,0,0,0,,Сізге көбірек бақытсыздық келеді.
Dialogue: 0,0:13:38.48,0:13:40.11,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:13:40.19,0:13:42.27,Default,,0,0,0,,Мен сізге жеңу мүмкіндігі жоқ екенін айттым.
Dialogue: 0,0:13:42.36,0:13:44.07,Default,,0,0,0,,Урю Ишида
Dialogue: 0,0:13:45.11,0:13:47.36,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:13:47.86,0:13:49.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:49.11,0:13:51.62,Default,,0,0,0,,Сіз әлі де берілмейсіз бе?
Dialogue: 0,0:13:52.24,0:13:54.33,Default,,0,0,0,,Сен дана адамсың
Dialogue: 0,0:13:54.83,0:13:57.08,Default,,0,0,0,,Сіз маған да, Мәртебелі мәртебеге де тең келмейді.
Dialogue: 0,0:13:57.16,0:13:58.92,Default,,0,0,0,,Түсіну керек.
Dialogue: 0,0:14:00.75,0:14:04.84,Default,,0,0,0,,Мен сені көре алмаймын дедім, бірақ қайтарып аламын.
Dialogue: 0,0:14:04.92,0:14:06.22,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:14:06.30,0:14:08.84,Default,,0,0,0,,Бұл керемет ақымақ адамдар
Dialogue: 0,0:14:09.80,0:14:11.30,Default,,0,0,0,,өте ұқсас
Dialogue: 0,0:14:12.60,0:14:15.14,Default,,0,0,0,,Сіз түсінбейсіз
Dialogue: 0,0:14:15.22,0:14:21.15,Default,,0,0,0,,Мен қалаған шынайы дүние де әйел қалаған дүние.
Dialogue: 0,0:14:22.90,0:14:24.15,Default,,0,0,0,,Даусыз
Dialogue: 0,0:14:24.23,0:14:27.53,Default,,0,0,0,,Ешқандай ауыртпалық, өшпенділік, мұң жоқ
Dialogue: 0,0:14:27.61,0:14:29.49,Default,,0,0,0,,Тыныш әлем
Dialogue: 0,0:14:29.99,0:14:34.24,Default,,0,0,0,,Бұл мен қалайтын жаңа әлем
Dialogue: 0,0:14:35.24,0:14:38.12,Default,,0,0,0,,Үміт үзбе, Ичиго.
Dialogue: 0,0:14:38.62,0:14:41.58,Default,,0,0,0,,Үмітсіз ұлыңызды өлтіру сияқты ештеңе жоқ.
Dialogue: 0,0:14:41.67,0:14:45.42,Default,,0,0,0,,Ата-аналарға ешнәрсе қиын емес.
Dialogue: 0,0:14:48.80,0:14:50.59,Default,,0,0,0,,Сіз әлі де қозғала аласыз ба?
Dialogue: 0,0:14:51.18,0:14:52.09,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:52.18,0:14:54.01,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:54.10,0:14:56.60,Default,,0,0,0,,Бұл Куросакиге және басқаларға ұқсайды ма?
Dialogue: 0,0:14:57.14,0:15:01.27,Default,,0,0,0,,Мен осы уақытқа дейін сабырлы болдым
Dialogue: 0,0:15:01.35,0:15:05.65,Default,,0,0,0,,Мен сіз айтқан шкала бойынша әрекет еттім деп ойладым.
Dialogue: 0,0:15:06.65,0:15:11.07,Default,,0,0,0,,Бірақ Куросаки мұны істеу үшін тым ақымақ.
Dialogue: 0,0:15:11.57,0:15:14.33,Default,,0,0,0,,Көмек бергіңіз келсе, көмекке барыңыз.
Dialogue: 0,0:15:15.87,0:15:19.12,Default,,0,0,0,,Таразы қай жаққа еңкейсе де
Dialogue: 0,0:15:19.20,0:15:21.79,Default,,0,0,0,,Таразыға қарамайды.
Dialogue: 0,0:15:22.63,0:15:24.42,Default,,0,0,0,,Инуэ мырза да ақымақ.
Dialogue: 0,0:15:24.50,0:15:26.30,Default,,0,0,0,,Садо-кун да ақымақ.
Dialogue: 0,0:15:26.38,0:15:28.05,Default,,0,0,0,,Кучики мырза да ақымақ.
Dialogue: 0,0:15:28.13,0:15:30.05,Default,,0,0,0,,Абарай да ақымақ.
Dialogue: 0,0:15:32.34,0:15:37.01,Default,,0,0,0,,Мен сол ақымақтарға ұқсайтын болсам
Dialogue: 0,0:15:38.02,0:15:39.39,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:15:40.64,0:15:41.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:41.64,0:15:45.31,Default,,0,0,0,,Үміттен де, үмітсіздіктен де қорқасың.
Dialogue: 0,0:15:46.90,0:15:51.53,Default,,0,0,0,,Сіз бәрін білуші, құдіретті болсаңыз да, жүрегіңізді көре алмайтын сияқтысыз.
Dialogue: 0,0:15:55.53,0:15:57.03,Default,,0,0,0,,Үмітсіздік деген не?
Dialogue: 0,0:15:57.87,0:15:59.54,Default,,0,0,0,,Мен сізді жақсы білемін.
Dialogue: 0,0:16:06.42,0:16:08.13,Default,,0,0,0,,Көп рет...
Dialogue: 0,0:16:08.75,0:16:11.22,Default,,0,0,0,,Сіз оны жеңдіңіз!
Dialogue: 0,0:16:12.38,0:16:17.10,Default,,0,0,0,,Осы сәтте маған сен керек едің.
Dialogue: 0,0:16:17.60,0:16:19.31,Default,,0,0,0,,Менің ұлым
Dialogue: 0,0:16:21.27,0:16:23.56,Default,,0,0,0,,Сіз бақыттысыз ба...?
Dialogue: 0,0:16:24.19,0:16:27.69,Default,,0,0,0,,Мен сенің сезіміңді басынан сұраған емеспін.
Dialogue: 0,0:16:28.32,0:16:32.15,Default,,0,0,0,,Олармен бірге болу сізге пайда әкелмейді деп ойлаймын.
Dialogue: 0,0:16:32.24,0:16:33.82,Default,,0,0,0,,Менің айтайын дегенім осы.
Dialogue: 0,0:16:34.74,0:16:37.78,Default,,0,0,0,,Сіз олармен бірге өстіңіз бе?
Dialogue: 0,0:16:38.28,0:16:40.66,Default,,0,0,0,,Мен олармен бірге болған жылдардан да көп.
Dialogue: 0,0:16:40.74,0:16:43.71,Default,,0,0,0,,Мәртебелі маған билік берген сәт жақсырақ болды.
Dialogue: 0,0:16:43.79,0:16:46.21,Default,,0,0,0,,Сіз өсіп келе жатқан болуыңыз керек.
Dialogue: 0,0:16:46.29,0:16:49.46,Default,,0,0,0,,Бірін-бірі арттыратын достар болса
Dialogue: 0,0:16:49.55,0:16:53.59,Default,,0,0,0,,Сіз өз өміріңізді оларға емес, ұлы мәртебеге қоюыңыз керек.
Dialogue: 0,0:16:54.22,0:16:57.22,Default,,0,0,0,,Таразы таңдау дегенді айттым.
Dialogue: 0,0:16:58.22,0:17:02.47,Default,,0,0,0,,Мен өз таңдауым бойынша олармен бірге болуды таңдадым.
Dialogue: 0,0:17:03.14,0:17:05.19,Default,,0,0,0,,Бірақ мұнда қызығушылық жоқ.
Dialogue: 0,0:17:05.69,0:17:07.69,Default,,0,0,0,,Дұрыс немесе бұрыс жауап жоқ.
Dialogue: 0,0:17:08.19,0:17:11.73,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,0:17:14.61,0:17:16.99,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:17:17.57,0:17:20.41,Default,,0,0,0,,Сізді ұлы мәртебелі мойындағанымен
Dialogue: 0,0:17:20.49,0:17:23.08,Default,,0,0,0,,Бұл менің ештеңені лақтырғым келмейтінін білдіреді.
Dialogue: 0,0:17:23.58,0:17:27.54,Default,,0,0,0,,Олай болса, тым болмаса жаныңды бер, Урю Ишида!
Dialogue: 0,0:17:29.88,0:17:30.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:35.34,0:17:36.84,Default,,0,0,0,,Банкай!
Dialogue: 0,0:17:37.89,0:17:41.05,Default,,0,0,0,,Тенчейн Зангецу!
Dialogue: 0,0:17:47.73,0:17:48.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:48.73,0:17:52.15,Default,,0,0,0,,Соншалықты қорқынышты көрінбе, Ичиго.
Dialogue: 0,0:17:52.23,0:17:56.45,Default,,0,0,0,,Мен сенің құдіретіңді құттықтаймын.
Dialogue: 0,0:17:56.99,0:17:59.41,Default,,0,0,0,,Жаңа Тенчейн Зангецу
Dialogue: 0,0:17:59.49,0:18:01.74,Default,,0,0,0,,Бұл қорқынышты Банкай
Dialogue: 0,0:18:01.83,0:18:04.29,Default,,0,0,0,,Себебі мен солай шештім...
Dialogue: 0,0:18:04.87,0:18:07.04,Default,,0,0,0,,Мен оны болашаққа сақтап қойдым.
Dialogue: 0,0:18:11.00,0:18:12.13,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:21.18,0:18:22.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:23.06,0:18:23.97,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:25.27,0:18:26.98,Default,,0,0,0,,Гах... Гах...
Dialogue: 0,0:18:27.06,0:18:30.10,Default,,0,0,0,,Қарғыс атсын... Уау!
Dialogue: 0,0:18:30.19,0:18:31.10,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:32.31,0:18:33.94,Default,,0,0,0,,Банкай!
Dialogue: 0,0:18:34.44,0:18:35.78,Default,,0,0,0,,Банкай?
Dialogue: 0,0:18:35.86,0:18:36.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:37.32,0:18:39.82,Default,,0,0,0,,Маған бұл сөз ұнайды
Dialogue: 0,0:18:40.78,0:18:41.62,Default,,0,0,0,,Махаббат...
Dialogue: 0,0:18:45.04,0:18:46.91,Default,,0,0,0,,Сендер өлім құдайларысыңдар
Dialogue: 0,0:18:47.00,0:18:50.54,Default,,0,0,0,,Кез келген жағдайдан көтеріле аласыз.
Dialogue: 0,0:18:50.62,0:18:52.92,Default,,0,0,0,,Өйткені бұл құдіретті сөз.
Dialogue: 0,0:18:55.38,0:18:56.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:56.34,0:18:58.47,Default,,0,0,0,,Сол сөздің арқасында
Dialogue: 0,0:18:58.55,0:19:04.39,Default,,0,0,0,,Қайта-қайта көтеріліп келе жатқан Қасқырдың жүрегін жаралай аламын.
Dialogue: 0,0:19:04.47,0:19:05.31,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:05.39,0:19:09.23,Default,,0,0,0,,Үмітсіздікті талай рет жеңдіңіз
Dialogue: 0,0:19:09.31,0:19:11.94,Default,,0,0,0,,Бұл болашақты өзгерткен болуы керек.
Dialogue: 0,0:19:12.02,0:19:14.94,Default,,0,0,0,,Мұның не үшін жасалғанын білесіз бе?
Dialogue: 0,0:19:15.02,0:19:18.36,Default,,0,0,0,,Себебі мен ол жерде болмадым
Dialogue: 0,0:19:18.86,0:19:23.03,Default,,0,0,0,,Ичиго, болашақты өзгерт.
Dialogue: 0,0:19:23.12,0:19:26.49,Default,,0,0,0,,Болашақ қандай керемет болса да,
Dialogue: 0,0:19:26.99,0:19:29.66,Default,,0,0,0,,Мен оны көріп тұрмын
Dialogue: 0,0:19:33.13,0:19:37.13,Default,,0,0,0,,Сіз тіпті болашақты өзгерттіңіз
Dialogue: 0,0:19:37.63,0:19:39.92,Default,,0,0,0,,Кәне, кесіп алайық
Dialogue: 0,0:19:41.01,0:19:45.05,Default,,0,0,0,,Кел, үмітіңді үзбе.
Dialogue: 0,0:19:45.14,0:19:47.10,Default,,0,0,0,,Ичиго
Dialogue: 0,0:19:47.60,0:19:53.02,Default,,0,0,0,,(Ичигоның айқайы)
Dialogue: 0,0:19:53.60,0:19:55.61,Default,,0,0,0,,♪～
Dialogue: 0,0:21:19.61,0:21:21.61,Default,,0,0,0,,～♪
Dialogue: 0,0:21:23.74,0:21:25.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:26.36,0:21:28.87,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:21:29.53,0:21:31.58,Default,,0,0,0,,Сіз өкінесіз бе?
Dialogue: 0,0:21:32.16,0:21:35.29,Default,,0,0,0,,Менің билігімді ұлы мәртебелі тартып алды.
Dialogue: 0,0:21:36.96,0:21:38.08,Default,,0,0,0,,Бұл керісінше.
Dialogue: 0,0:21:38.58,0:21:42.30,Default,,0,0,0,,Мәртебелі билікті сізден тартып алмасын.
Dialogue: 0,0:21:42.80,0:21:44.13,Default,,0,0,0,,мақтаныш сезімін тудырады
Dialogue: 0,0:21:45.17,0:21:48.84,Default,,0,0,0,,Менің күшімді тартып алдың.
Dialogue: 0,0:21:48.93,0:21:50.55,Default,,0,0,0,,мақтаныш сезімін тудырады
Dialogue: 0,0:21:51.51,0:21:55.56,Default,,0,0,0,,Ұлы мәртебеліге тек мен ғана қызмет ете аламын.
Dialogue: 0,0:22:00.52,0:22:01.52,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:02.02,0:22:04.32,Default,,0,0,0,,Күте тұрыңыз, Урю Ишида
Dialogue: 0,0:22:05.28,0:22:08.99,Default,,0,0,0,,Жараларыңды маған аудар
Dialogue: 0,0:22:10.91,0:22:13.66,Default,,0,0,0,,Мен жақында өлемін
Dialogue: 0,0:22:14.66,0:22:16.79,Default,,0,0,0,,Шрамы бар немесе жоқ
Dialogue: 0,0:22:17.66,0:22:19.21,Default,,0,0,0,,Бұл өзгермейді
Dialogue: 0,0:22:19.29,0:22:22.09,Default,,0,0,0,,Не... дейсіз бе?
Dialogue: 0,0:22:22.75,0:22:25.67,Default,,0,0,0,,Не болды? Өкінішті ме?
Dialogue: 0,0:22:26.51,0:22:28.09,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:22:28.18,0:22:31.09,Default,,0,0,0,,Ол мені өлтіру ниетімен төбелескен болуы керек.
Dialogue: 0,0:22:31.18,0:22:32.30,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:22:32.93,0:22:34.56,Default,,0,0,0,,Сіз не туралы шатасасыз?
Dialogue: 0,0:22:35.31,0:22:37.93,Default,,0,0,0,,Мен саған бәрін өлшеп көр дедім.
Dialogue: 0,0:22:38.98,0:22:40.94,Default,,0,0,0,,Өлшеу мүмкін емес
Dialogue: 0,0:22:41.52,0:22:43.90,Default,,0,0,0,,Күмән қуған соң не шештім
Dialogue: 0,0:22:43.98,0:22:46.15,Default,,0,0,0,,Өйткені сен бәріне өкінесің.
Dialogue: 0,0:22:47.36,0:22:50.61,Default,,0,0,0,,Содан кейін оны да өлшеңіз.
Dialogue: 0,0:22:51.11,0:22:52.45,Default,,0,0,0,,Урю Ишида
Dialogue: 0,0:22:53.33,0:22:57.20,Default,,0,0,0,,Досыңа көмектесу керек.
Dialogue: 0,0:23:14.30,0:23:16.52,Default,,0,0,0,,Нәтиже өзгеріссіз қалса да
Dialogue: 0,0:23:17.02,0:23:21.94,Default,,0,0,0,,Қалағаныңызша таңдап, қалағаныңызша жүрудің мәні бар.
Dialogue: 0,0:23:25.15,0:23:26.48,Default,,0,0,0,,Қандай сараң.
Dialogue: 0,0:23:28.40,0:23:29.82,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:23:37.16,0:23:39.41,Default,,0,0,0,,Біз бір-бірімізге тартыламыз
Dialogue: 0,0:23:40.04,0:23:43.29,Default,,0,0,0,,Су тамшысындай Планетадай
Dialogue: 0,0:23:44.21,0:23:46.67,Default,,0,0,0,,Біз бір-бірімізге қарсы шығамыз
Dialogue: 0,0:23:47.38,0:23:50.63,Default,,0,0,0,,Магниттей, Теріңнің түсі сияқты
Dialogue: 0,0:23:52.13,0:23:58.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
