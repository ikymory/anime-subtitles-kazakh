Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.83,0:00:06.13,Default,,0,0,0,,Не?
Dialogue: 0,0:00:06.63,0:00:08.46,Default,,0,0,0,,Қараңғы емес пе?
Dialogue: 0,0:00:08.96,0:00:10.51,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:00:17.14,0:00:20.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:21.52,0:00:23.52,Default,,0,0,0,,♪～
Dialogue: 0,0:01:48.94,0:01:50.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.82,0:01:54.94,Default,,0,0,0,,Бар күшіңізді шығарып, өліңіз.
Dialogue: 0,0:01:55.03,0:01:56.40,Default,,0,0,0,,Ичиго!
Dialogue: 0,0:01:57.03,0:01:58.57,Default,,0,0,0,,Үш аспан қалқаны!
Dialogue: 0,0:02:01.12,0:02:01.62,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:02:01.70,0:02:03.37,Default,,0,0,0,,Төрт аспандық қарсылық қалқаны!
Dialogue: 0,0:02:03.45,0:02:05.62,Default,,0,0,0,,Бас тарту күші?
Dialogue: 0,0:02:05.70,0:02:08.25,Default,,0,0,0,,Мен бас тартамын!
Dialogue: 0,0:02:09.25,0:02:10.38,Default,,0,0,0,,Жетпейді
Dialogue: 0,0:02:15.67,0:02:16.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:17.76,0:02:22.68,Default,,0,0,0,,Ичиго сияқты нәрсе менің күшімнен өтеді.
Dialogue: 0,0:02:22.76,0:02:27.18,Default,,0,0,0,,Сіз оны бейсаналық түрде қабылдайсыз.
Dialogue: 0,0:02:27.27,0:02:28.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:30.23,0:02:31.06,Default,,0,0,0,,А...
Dialogue: 0,0:02:31.73,0:02:32.90,Default,,0,0,0,,Иә
Dialogue: 0,0:02:33.77,0:02:34.48,Default,,0,0,0,,Гуах
Dialogue: 0,0:02:35.19,0:02:35.86,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:37.65,0:02:38.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:53.17,0:02:54.17,Default,,0,0,0,,Иә
Dialogue: 0,0:02:58.38,0:03:01.01,Default,,0,0,0,,Әйел, құрметті бол.
Dialogue: 0,0:03:01.59,0:03:03.89,Default,,0,0,0,,Қарапайым адам ретінде
Dialogue: 0,0:03:03.97,0:03:08.02,Default,,0,0,0,,Сенің бұл жерге не істеп жатқаныңды білмей келгенің.
Dialogue: 0,0:03:09.31,0:03:11.60,Default,,0,0,0,,Сені ренжітуге жол берме
Dialogue: 0,0:03:12.81,0:03:13.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:15.06,0:03:16.77,Default,,0,0,0,,Мен қорғаймын
Dialogue: 0,0:03:20.28,0:03:20.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:21.99,0:03:24.87,Default,,0,0,0,,Сонымен, сіз...
Dialogue: 0,0:03:26.66,0:03:28.75,Default,,0,0,0,,Мен бас тартамын!
Dialogue: 0,0:03:38.46,0:03:39.51,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:43.51,0:03:46.18,Default,,0,0,0,,Гецуга Теншо!
Dialogue: 0,0:03:50.27,0:03:51.56,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:52.31,0:03:53.94,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:03:54.69,0:03:56.65,Default,,0,0,0,,Бұл құрметсіздік, Ичиго.
Dialogue: 0,0:03:56.73,0:03:59.69,Default,,0,0,0,,Бұл дүниені кесумен бірдей.
Dialogue: 0,0:04:01.28,0:04:05.95,Default,,0,0,0,,Мен әлемнің өзіне айналдым.
Dialogue: 0,0:04:06.99,0:04:09.74,Default,,0,0,0,,Мәртебелі билікті мұраға алған кезде
Dialogue: 0,0:04:09.83,0:04:13.87,Default,,0,0,0,,Мен сол билікті өз еркім бойынша еркін пайдалана аламын.
Dialogue: 0,0:04:13.96,0:04:17.25,Default,,0,0,0,,Бұл менің ұлы мәртебелі жартысы ретіндегі күшім.
Dialogue: 0,0:04:17.92,0:04:19.34,Default,,0,0,0,,Урю Ишида
Dialogue: 0,0:04:19.42,0:04:23.72,Default,,0,0,0,,Егер сіз Ұлы Мәртебелі бағыштау рәсімінен шынымен аман қалған болсаңыз (Аусвелен).
Dialogue: 0,0:04:23.80,0:04:28.30,Default,,0,0,0,,Менің күшім алдында тағы да аман бол.
Dialogue: 0,0:04:36.65,0:04:37.15,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:43.15,0:04:44.70,Default,,0,0,0,,Сіздің шайқасыңыз
Dialogue: 0,0:04:44.78,0:04:46.86,Default,,0,0,0,,Басынан бастап қарама-қайшы
Dialogue: 0,0:04:46.95,0:04:48.07,Default,,0,0,0,,Сіз оны көруіңіз керек еді.
Dialogue: 0,0:04:48.70,0:04:51.58,Default,,0,0,0,,Бұл дүние қаншалықты нәзік?
Dialogue: 0,0:04:51.66,0:04:53.79,Default,,0,0,0,,Қалай оңай теңселуге болады
Dialogue: 0,0:04:54.29,0:04:58.21,Default,,0,0,0,,Рух Патшасымен бір болған Ұлы Мәртебені өлтіру нені білдіреді?
Dialogue: 0,0:04:58.29,0:05:02.13,Default,,0,0,0,,Бұл әлемге бағыт-бағдар беруден айырмашылығы жоқ.
Dialogue: 0,0:05:05.84,0:05:06.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:15.69,0:05:16.69,Default,,0,0,0,,Гаха!
Dialogue: 0,0:05:20.23,0:05:21.69,Default,,0,0,0,,Бұл шіркін
Dialogue: 0,0:05:21.77,0:05:22.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:24.74,0:05:25.57,Default,,0,0,0,,Иә
Dialogue: 0,0:05:25.65,0:05:26.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:27.53,0:05:31.03,Default,,0,0,0,,Юхабахты жеңсек, дүние күйрейді.
Dialogue: 0,0:05:31.53,0:05:34.04,Default,,0,0,0,,Мұны бәріміз білеміз.
Dialogue: 0,0:05:36.33,0:05:37.33,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:05:37.42,0:05:38.25,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:05:39.33,0:05:41.71,Default,,0,0,0,,Куросаки осылай айтар еді.
Dialogue: 0,0:05:42.38,0:05:44.17,Default,,0,0,0,,Мен сені бәрібір ұрамын
Dialogue: 0,0:05:44.67,0:05:48.34,Default,,0,0,0,,Мен бұл дүниені мәңгілік қорғаған адамдарды білемін.
Dialogue: 0,0:05:49.01,0:05:53.14,Default,,0,0,0,,Ол адамдардың қорғағысы келетін нәрсені таптайсың.
Dialogue: 0,0:05:54.10,0:05:56.73,Default,,0,0,0,,Мен мыңдаған адамдарды қорғағым келеді
Dialogue: 0,0:05:57.23,0:05:58.98,Default,,0,0,0,,Сол адамдардың ойлары
Dialogue: 0,0:05:59.06,0:06:00.52,Default,,0,0,0,,Мен жақсы көретін нәрселер
Dialogue: 0,0:06:00.61,0:06:02.57,Default,,0,0,0,,Мен бәрін қорғағым келеді
Dialogue: 0,0:06:03.15,0:06:05.90,Default,,0,0,0,,Егер бұл дүниені қиюды білдірсе
Dialogue: 0,0:06:05.99,0:06:07.11,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:06:07.61,0:06:09.03,Default,,0,0,0,,Кеттік
Dialogue: 0,0:06:09.70,0:06:12.03,Default,,0,0,0,,...
Dialogue: 0,0:06:13.08,0:06:14.45,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:06:14.54,0:06:15.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.45,0:06:19.50,Default,,0,0,0,,Егер сіз ұлы мәртебелі жеңіп алсаңыз да
Dialogue: 0,0:06:19.58,0:06:21.38,Default,,0,0,0,,Өлімнен кейінгі Рух патшасы
Dialogue: 0,0:06:21.46,0:06:25.76,Default,,0,0,0,,Әлемді қазіргідей сақтау үшін не қажет?
Dialogue: 0,0:06:31.51,0:06:33.18,Default,,0,0,0,,Бұл әлі де жеткіліксіз бе?
Dialogue: 0,0:06:33.76,0:06:38.06,Default,,0,0,0,,Ичиго Қараңғылықтан туған, ұлым.
Dialogue: 0,0:06:38.64,0:06:43.69,Default,,0,0,0,,Ештеңені білмесең де, ішкі түйсігің арқылы білесің ғой, солай ма?
Dialogue: 0,0:06:43.77,0:06:48.69,Default,,0,0,0,,Сен бәрін білетіндіктен, мені жеңуден тартынба.
Dialogue: 0,0:06:49.28,0:06:50.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:50.99,0:06:53.32,Default,,0,0,0,,Хёшубу Ичибей
Dialogue: 0,0:06:53.41,0:06:56.66,Default,,0,0,0,,Бәрі ол жоспарлағандай.
Dialogue: 0,0:06:56.74,0:06:58.75,Default,,0,0,0,,Ичиго Куросакиді қабылдау
Dialogue: 0,0:06:58.83,0:07:02.79,Default,,0,0,0,,Және Рухани Патшаны еске түсіріп, түсіндірді.
Dialogue: 0,0:07:02.88,0:07:06.50,Default,,0,0,0,,Ичиго Куросаки өзінің өмір сүруіне лайық па?
Dialogue: 0,0:07:06.59,0:07:08.92,Default,,0,0,0,,Сапаны анықтау
Dialogue: 0,0:07:09.42,0:07:10.88,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:07:11.38,0:07:14.89,Default,,0,0,0,,Сен адамсың және өлім құдайсың
Dialogue: 0,0:07:14.97,0:07:18.06,Default,,0,0,0,,Бұл жалған және бұл Fullbringer.
Dialogue: 0,0:07:18.14,0:07:20.02,Default,,0,0,0,,Бұл Квинси.
Dialogue: 0,0:07:20.52,0:07:23.15,Default,,0,0,0,,Мен бұл туралы ойламаған едім.
Dialogue: 0,0:07:23.23,0:07:25.86,Default,,0,0,0,,Сіздің күшіңіздің мәні
Dialogue: 0,0:07:25.94,0:07:29.11,Default,,0,0,0,,Неліктен қара түсті киесің?
Dialogue: 0,0:07:29.69,0:07:31.99,Default,,0,0,0,,Қара – хаостың түсі
Dialogue: 0,0:07:32.07,0:07:35.07,Default,,0,0,0,,Хаос – Рух патшасының күші.
Dialogue: 0,0:07:35.16,0:07:39.87,Default,,0,0,0,,Қараның түссіз түсі Рух патшасының Рейатсуынан басқа ештеңе емес.
Dialogue: 0,0:07:39.95,0:07:44.83,Default,,0,0,0,,Ал қара түсті басқаратын адам Хёшубу Ичибей.
Dialogue: 0,0:07:44.92,0:07:47.55,Default,,0,0,0,,Ол сізге айтуы керек еді.
Dialogue: 0,0:07:47.63,0:07:49.42,Default,,0,0,0,,«Рух Патшасын қорға»
Dialogue: 0,0:07:49.51,0:07:50.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:51.17,0:07:52.97,Default,,0,0,0,,Апыр-ай, жақсы болды. Сонымен, іс шешілді ғой?
Dialogue: 0,0:07:53.47,0:07:55.30,Default,,0,0,0,,Апыр-ай, жақсы болды. Сонымен, іс шешілді ғой?
Dialogue: 0,0:08:05.86,0:08:06.81,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:08:09.65,0:08:12.82,Default,,0,0,0,,Тек ұл баланы басқа себеппен алып кетеді.
Dialogue: 0,0:08:13.40,0:08:17.91,Default,,0,0,0,,Оған құйылған күштің шамасына төтеп бере алатын ыдыс па?
Dialogue: 0,0:08:18.41,0:08:20.16,Default,,0,0,0,,Сынуға болатын тостаған?
Dialogue: 0,0:08:20.24,0:08:23.66,Default,,0,0,0,,Өз күшіңіздің азын-аулағын алыңыз және алыңыз.
Dialogue: 0,0:08:23.75,0:08:25.42,Default,,0,0,0,,Сіз өз денеңізді емдедіңіз.
Dialogue: 0,0:08:25.50,0:08:29.00,Default,,0,0,0,,Рух патшасын қорғаңыз, Ичиго.
Dialogue: 0,0:08:30.00,0:08:32.42,Default,,0,0,0,,Шын мәнісін айтайын.
Dialogue: 0,0:08:33.34,0:08:35.22,Default,,0,0,0,,Хёшубу Ичибей
Dialogue: 0,0:08:35.30,0:08:39.31,Default,,0,0,0,,Мен сені келесі Рух патшасы етуді жоспарладым.
Dialogue: 0,0:08:39.39,0:08:42.06,Default,,0,0,0,,Ха! Сол сияқты...
Dialogue: 0,0:08:42.14,0:08:43.27,Default,,0,0,0,,Сіз
Dialogue: 0,0:08:43.35,0:08:47.65,Default,,0,0,0,,Үш патшалықты сақтау үшін ғана пұтқа айналдырылған
Dialogue: 0,0:08:48.15,0:08:52.36,Default,,0,0,0,,Шинигами шыңында тұрған әлемді сақтау
Dialogue: 0,0:08:52.44,0:08:56.49,Default,,0,0,0,,Бұл Хёшубу Ичибей елестететін тыныштық.
Dialogue: 0,0:08:56.57,0:09:00.37,Default,,0,0,0,,Сізге бұл өлімнің синонимі болар еді.
Dialogue: 0,0:09:04.96,0:09:07.00,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:07.79,0:09:09.50,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:09:10.09,0:09:10.84,Default,,0,0,0,,Не?
Dialogue: 0,0:09:10.92,0:09:15.17,Default,,0,0,0,,Жоқ...Мен Куросаки осылай айтады деп ойладым.
Dialogue: 0,0:09:15.68,0:09:18.59,Default,,0,0,0,,Мен Рух патшасы болмаймын.
Dialogue: 0,0:09:18.68,0:09:20.97,Default,,0,0,0,,Бұл қалай болуы мүмкін?
Dialogue: 0,0:09:23.02,0:09:24.98,Default,,0,0,0,,Мен қазір білетінім ғана
Dialogue: 0,0:09:26.31,0:09:31.32,Default,,0,0,0,,Мен сені жеңбесем, мен ештеңені қорғай алмаймын.
Dialogue: 0,0:09:31.86,0:09:33.57,Default,,0,0,0,,Юхабах!
Dialogue: 0,0:09:43.54,0:09:47.21,Default,,0,0,0,,(қатты аяқ дыбыстары)
Dialogue: 0,0:09:47.29,0:09:49.67,Default,,0,0,0,,Бұл не құбыжық?
Dialogue: 0,0:09:49.75,0:09:51.75,Default,,0,0,0,,Оның күштілігі сонша, люк жарылып кетеді
Dialogue: 0,0:09:51.84,0:09:54.30,Default,,0,0,0,,Мен кішкентай емеспін.
Dialogue: 0,0:09:56.34,0:09:57.76,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:09:58.38,0:09:59.80,Default,,0,0,0,,Дөрекі
Dialogue: 0,0:09:59.89,0:10:02.43,Default,,0,0,0,,Готей 13, ол капитан болса да.
Dialogue: 0,0:10:02.51,0:10:05.64,Default,,0,0,0,,Менің ғажайыптың алдында, бұл солай ма?
Dialogue: 0,0:10:06.35,0:10:10.90,Default,,0,0,0,,Тіпті реятсудың кішкентай болғаны сонша, мен оны әрең сезінемін.
Dialogue: 0,0:10:10.98,0:10:15.11,Default,,0,0,0,,Құмдағы құмырсқаны басқанмен бірдей.
Dialogue: 0,0:10:15.69,0:10:17.82,Default,,0,0,0,,Мүмкін емес дерлік
Dialogue: 0,0:10:19.57,0:10:21.62,Default,,0,0,0,,Сондықтан сіз оны таба аласыз!
Dialogue: 0,0:10:21.70,0:10:24.87,Default,,0,0,0,,Егер бұл мүмкін болмаса, сіз оны таба алмаймын деп ойладыңыз ба?
Dialogue: 0,0:10:24.95,0:10:28.16,Default,,0,0,0,,Мүмкін емес нәрсені мүмкін ететін ғажайыптар
Dialogue: 0,0:10:28.25,0:10:30.42,Default,,0,0,0,,Алдыңғы әңгімені тыңдамадық.
Dialogue: 0,0:10:30.50,0:10:34.17,Default,,0,0,0,,Біреу мені кенет ғажайып деп атаса да, мен олардың не айтып жатқанын түсінбеймін.
Dialogue: 0,0:10:34.25,0:10:35.05,Default,,0,0,0,,Таз!
Dialogue: 0,0:10:35.13,0:10:36.88,Default,,0,0,0,,Мен таз емеспін
Dialogue: 0,0:10:36.96,0:10:39.22,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:40.97,0:10:41.84,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:10:44.56,0:10:47.27,Default,,0,0,0,,Сіз осындай нәрсені жеймін деп ойладыңыз ба?
Dialogue: 0,0:10:48.02,0:10:51.40,Default,,0,0,0,,Сене алар емеспін, егер бұл менің бір соққым болса.
Dialogue: 0,0:10:51.48,0:10:52.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:52.90,0:10:54.27,Default,,0,0,0,,Кері соққы
Dialogue: 0,0:10:56.78,0:10:59.70,Default,,0,0,0,,Вахаха! аспан мен жер төңкерілді
Dialogue: 0,0:10:59.78,0:11:01.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:01.24,0:11:03.41,Default,,0,0,0,,Бәрі төңкерілген
Dialogue: 0,0:11:07.12,0:11:09.46,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:09.54,0:11:11.08,Default,,0,0,0,,Барлығына қазір!
Dialogue: 0,0:11:13.58,0:11:16.34,Default,,0,0,0,,Мен сізге тритонды естуге рұқсат етемін.
Dialogue: 0,0:11:16.84,0:11:18.38,Default,,0,0,0,,Тецукен Данфу!
Dialogue: 0,0:11:18.46,0:11:21.05,Default,,0,0,0,,Өте ақ соққы!
Dialogue: 0,0:11:21.13,0:11:22.72,Default,,0,0,0,,Риппель Овердрайв Брэфордтың маңдайына жай ғана тиіп өтті ме?
Dialogue: 0,0:11:25.35,0:11:27.64,Default,,0,0,0,,Шоколад сырғытпасы
Dialogue: 0,0:11:27.72,0:11:29.39,Default,,0,0,0,,Өрт сөндіруші шелпек!
Dialogue: 0,0:11:29.48,0:11:31.10,Default,,0,0,0,,21-бап: Инеліктердің шығу тегі!
Dialogue: 0,0:11:33.65,0:11:35.27,Default,,0,0,0,,Бітті
Dialogue: 0,0:11:39.36,0:11:40.95,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:42.07,0:11:43.03,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:46.58,0:11:49.33,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:11:49.83,0:11:51.50,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:51.58,0:11:52.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:53.92,0:11:58.09,Default,,0,0,0,,О, құдай-ау, мұның соңы жоқ.
Dialogue: 0,0:11:58.59,0:11:59.46,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:00.05,0:12:04.93,Default,,0,0,0,,Осы аймақтың бәрін тастап көрейік.
Dialogue: 0,0:12:07.68,0:12:08.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:09.77,0:12:12.35,Default,,0,0,0,,Мен сізге оны тастауға рұқсат бере алмаймын.
Dialogue: 0,0:12:17.73,0:12:20.36,Default,,0,0,0,,Мұнда мәңгілік мұздатылған.
Dialogue: 0,0:12:21.24,0:12:22.74,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:12:23.45,0:12:26.41,Default,,0,0,0,,Готей 13 отрядының 10-шы отрядының капитаны
Dialogue: 0,0:12:26.99,0:12:28.83,Default,,0,0,0,,Тосиро Хицугая
Dialogue: 0,0:12:29.37,0:12:30.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:30.95,0:12:34.00,Default,,0,0,0,,Мен жұлдызды крест рыцарлары (Стернритер) Құдайдың кешірімінің сақшысымын
Dialogue: 0,0:12:34.08,0:12:36.04,Default,,0,0,0,,Джеральд Валькири
Dialogue: 0,0:12:39.92,0:12:41.88,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:12:43.05,0:12:43.80,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:12:45.01,0:12:47.34,Default,,0,0,0,,Мен мұнда тіл табысу үшін келген жоқпын.
Dialogue: 0,0:12:48.72,0:12:50.14,Default,,0,0,0,,Банкай
Dialogue: 0,0:12:50.64,0:12:53.14,Default,,0,0,0,,Дайгурэн Хёринмару
Dialogue: 0,0:13:00.02,0:13:01.36,Default,,0,0,0,,Широ-чан...
Dialogue: 0,0:13:07.91,0:13:09.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:15.58,0:13:17.37,Default,,0,0,0,,Бұл нашар жауап.
Dialogue: 0,0:13:17.46,0:13:18.46,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:19.25,0:13:19.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:20.38,0:13:21.55,Default,,0,0,0,,Куросаки-кун!
Dialogue: 0,0:13:23.05,0:13:26.68,Default,,0,0,0,,Баласының қателігін түзету әкенің міндеті ме?
Dialogue: 0,0:13:28.68,0:13:29.68,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:36.94,0:13:38.60,Default,,0,0,0,,Арх... Арх!
Dialogue: 0,0:13:41.36,0:13:41.86,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:13:43.86,0:13:45.03,Default,,0,0,0,,... жылдам
Dialogue: 0,0:13:45.61,0:13:47.91,Default,,0,0,0,,Мен Куросаки-кунның қимылдарына ілесе алмаймын.
Dialogue: 0,0:13:49.28,0:13:49.99,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:55.37,0:13:56.16,Default,,0,0,0,,Гррр…
Dialogue: 0,0:13:57.58,0:13:58.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:00.96,0:14:04.55,Default,,0,0,0,,Дааааааа!
Dialogue: 0,0:14:06.76,0:14:07.72,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:08.26,0:14:09.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:14.77,0:14:16.39,Default,,0,0,0,,Күте тұрыңыз, Куросаки-кун.
Dialogue: 0,0:14:16.48,0:14:18.94,Default,,0,0,0,,Эй... жай ғана тыныштал!
Dialogue: 0,0:14:29.70,0:14:32.74,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:14:34.58,0:14:35.74,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:14:36.33,0:14:38.25,Default,,0,0,0,,Өлімге неге асығасың?
Dialogue: 0,0:14:41.21,0:14:41.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:42.50,0:14:46.26,Default,,0,0,0,,Маған бар күшіңді көрсетуге құлықсызсың ба?
Dialogue: 0,0:14:46.34,0:14:50.30,Default,,0,0,0,,Маған күшіңді көрсет, мен оны сенен тартып алсам, көңілің қалар.
Dialogue: 0,0:14:50.80,0:14:53.43,Default,,0,0,0,,Бірақ жақсы ма, Ичиго?
Dialogue: 0,0:14:53.51,0:14:58.85,Default,,0,0,0,,Осылай өлсең, бұл дүние мен Жан қоғамы бітеді.
Dialogue: 0,0:14:58.93,0:15:00.85,Default,,0,0,0,,Мен аяқтаймын
Dialogue: 0,0:15:00.94,0:15:03.31,Default,,0,0,0,,Жақсы ма, Ичиго?
Dialogue: 0,0:15:03.40,0:15:04.27,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:08.32,0:15:09.95,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:15:11.66,0:15:12.87,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:15:12.95,0:15:16.54,Default,,0,0,0,,Сіздің достарыңыз бұл жақсы емес дейді.
Dialogue: 0,0:15:16.62,0:15:20.33,Default,,0,0,0,,Жараларыңды емдейді, күресуге шақырады.
Dialogue: 0,0:15:20.41,0:15:25.09,Default,,0,0,0,,Әрине, сізде жалғыз таңдау жоқ.
Dialogue: 0,0:15:25.17,0:15:29.30,Default,,0,0,0,,Жауап бер, Ичиго, әлсіздердің дауысына.
Dialogue: 0,0:15:30.72,0:15:32.72,Default,,0,0,0,,Маған сен керексің
Dialogue: 0,0:15:32.80,0:15:36.06,Default,,0,0,0,,Әрең тыныс алатын әлсіздерге
Dialogue: 0,0:15:36.64,0:15:37.43,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:37.51,0:15:38.68,Default,,0,0,0,,Тұрған…
Dialogue: 0,0:15:38.77,0:15:39.81,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:40.31,0:15:41.94,Default,,0,0,0,,Шайқас…
Dialogue: 0,0:15:42.77,0:15:44.23,Default,,0,0,0,,Ал өл!
Dialogue: 0,0:15:44.31,0:15:44.81,Default,,0,0,0,,Гуах
Dialogue: 0,0:15:47.57,0:15:48.57,Default,,0,0,0,,Уф
Dialogue: 0,0:15:49.94,0:15:50.82,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:15:51.32,0:15:52.15,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:57.49,0:15:58.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:03.67,0:16:05.83,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:16:06.59,0:16:08.55,Default,,0,0,0,,Рахмет сізге Инуэ
Dialogue: 0,0:16:09.46,0:16:10.30,Default,,0,0,0,,Иә
Dialogue: 0,0:16:10.38,0:16:13.18,Default,,0,0,0,,Мен жай ғана киім алдым.
Dialogue: 0,0:16:13.26,0:16:15.05,Default,,0,0,0,,Куросаки-кун тоқтады.
Dialogue: 0,0:16:15.89,0:16:19.56,Default,,0,0,0,,Маған артына қараған жүз өзімді ұмытқан мен емес еді.
Dialogue: 0,0:16:20.14,0:16:23.19,Default,,0,0,0,,Себеп бар деп ойладым.
Dialogue: 0,0:16:24.06,0:16:24.94,Default,,0,0,0,,О
Dialogue: 0,0:16:25.73,0:16:30.19,Default,,0,0,0,,Мен ояту үшін Квинсидің реиацусын қолданғым келген біреу бар еді.
Dialogue: 0,0:16:31.86,0:16:34.66,Default,,0,0,0,,Қылыш ақ...
Dialogue: 0,0:16:39.87,0:16:43.41,Default,,0,0,0,,Мен көремін. Бұл сіздің мақсатыңыз ба?
Dialogue: 0,0:16:51.51,0:16:53.51,Default,,0,0,0,,♪～
Dialogue: 0,0:18:17.51,0:18:19.51,Default,,0,0,0,,～♪
Dialogue: 0,0:18:24.77,0:18:26.35,Default,,0,0,0,,Жарайды, аяқтаңыз.
Dialogue: 0,0:18:28.81,0:18:30.73,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:31.31,0:18:33.44,Default,,0,0,0,,Бір сәтке тоқтай алмайсың ба?
Dialogue: 0,0:18:33.52,0:18:34.78,Default,,0,0,0,,Ол қатал жігіт.
Dialogue: 0,0:18:34.86,0:18:40.45,Default,,0,0,0,,Сіз мені осындай деңгейдегі мұз акробатикасымен тоқтата аламын деп ойладыңыз ба?
Dialogue: 0,0:18:47.75,0:18:48.66,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:18:52.75,0:18:55.42,Default,,0,0,0,,Мен ғажайыптарды ұнатпаймын, бірақ...
Dialogue: 0,0:18:55.92,0:18:56.88,Default,,0,0,0,,Бұл бүкіл оқиға әуесқойларға да тамаша әңгіме болады.
Dialogue: 0,0:18:57.80,0:18:58.88,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:58.97,0:19:01.72,Default,,0,0,0,,Бірден ойнайтын қиын қарсылас.
Dialogue: 0,0:19:01.80,0:19:03.10,Default,,0,0,0,,Қол ұшын созайық
Dialogue: 0,0:19:03.18,0:19:04.30,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:19:04.39,0:19:06.35,Default,,0,0,0,,Әрине, бұл биіктік айырмашылығымен
Dialogue: 0,0:19:06.43,0:19:08.89,Default,,0,0,0,,2-ден 1 болса да, қорқақ болмайды.
Dialogue: 0,0:19:10.52,0:19:11.85,Default,,0,0,0,,Бұл қандай көздер?
Dialogue: 0,0:19:11.94,0:19:14.90,Default,,0,0,0,,Бойдың айырмашылығы қалыпты деп айта аласыз ба?
Dialogue: 0,0:19:16.19,0:19:19.90,Default,,0,0,0,,Жоқ... бұл менің айтқым келгенім емес.
Dialogue: 0,0:19:20.40,0:19:20.99,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:21.07,0:19:22.24,Default,,0,0,0,,Неге кешірім сұрадың?
Dialogue: 0,0:19:22.32,0:19:24.95,Default,,0,0,0,,Сіз ақымақтық айтқаныңыз үшін кешірім сұрадыңыз.
Dialogue: 0,0:19:25.03,0:19:25.74,Default,,0,0,0,,Ол кеңсе қызметкері және үйленбеген.
Dialogue: 0,0:19:25.83,0:19:27.12,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:19:30.87,0:19:35.50,Default,,0,0,0,,Не? Капитан Каку бірге жойылады.
Dialogue: 0,0:19:36.96,0:19:38.51,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:19:39.17,0:19:40.97,Default,,0,0,0,,Мазасыз нәрсе келді.
Dialogue: 0,0:19:41.05,0:19:43.09,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:43.72,0:19:46.93,Default,,0,0,0,,Менің... оң қолым!
Dialogue: 0,0:19:48.14,0:19:50.27,Default,,0,0,0,,Одан да күшті!
Dialogue: 0,0:19:50.35,0:19:53.06,Default,,0,0,0,,Бұл не? Не болып жатыр?
Dialogue: 0,0:19:53.15,0:19:54.69,Default,,0,0,0,,Оның қабілеті.
Dialogue: 0,0:19:54.77,0:19:57.52,Default,,0,0,0,,Зақымдалған бөлік үлкейіп, күшейеді.
Dialogue: 0,0:19:58.11,0:19:59.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:59.36,0:20:02.65,Default,,0,0,0,,Демек, ол әуел бастан онша ұзын емес еді.
Dialogue: 0,0:20:04.11,0:20:06.99,Default,,0,0,0,,Не? Айтар сөзің болса, айт
Dialogue: 0,0:20:07.49,0:20:09.91,Default,,0,0,0,,Жоқ, маған аса мән бермеймін.
Dialogue: 0,0:20:10.87,0:20:12.37,Default,,0,0,0,,- (Кенпачи) Қызық - (Хицугая) Ах!
Dialogue: 0,0:20:12.46,0:20:15.25,Default,,0,0,0,,Олай болса мен сені бөліктерге бөлемін.
Dialogue: 0,0:20:15.33,0:20:17.34,Default,,0,0,0,,Не болатынын көру қызықты болады.
Dialogue: 0,0:20:17.42,0:20:19.00,Default,,0,0,0,,Әлгі ақымақ!
Dialogue: 0,0:20:22.47,0:20:24.01,Default,,0,0,0,,Бұл қандай ақша?
Dialogue: 0,0:20:24.09,0:20:27.68,Default,,0,0,0,,Мен оны қопсытпасам, сен екіге бөлінетін едің.
Dialogue: 0,0:20:27.76,0:20:30.31,Default,,0,0,0,,Сіз мен ойлағаннан да ұқыптысыз.
Dialogue: 0,0:20:30.39,0:20:32.60,Default,,0,0,0,,Олай болса, сәл абай болыңыз.
Dialogue: 0,0:20:32.68,0:20:35.15,Default,,0,0,0,,А? Сен не туралы айтып тұрсың?
Dialogue: 0,0:20:35.23,0:20:37.19,Default,,0,0,0,,Бұл нәрсені одан да үлкейтіңіз.
Dialogue: 0,0:20:37.27,0:20:39.36,Default,,0,0,0,,Құлап қалсам не істеймін дедім?
Dialogue: 0,0:20:39.44,0:20:41.19,Default,,0,0,0,,Мен көмектесе алмаймын
Dialogue: 0,0:20:41.28,0:20:43.86,Default,,0,0,0,,Мен сенімен бірге құлаймын, сені кесемін.
Dialogue: 0,0:20:43.95,0:20:47.16,Default,,0,0,0,,Егер осындай массасы бар адам осы биіктіктен құласа,
Dialogue: 0,0:20:47.24,0:20:49.62,Default,,0,0,0,,Осының өзі Сейрейтейді жояды.
Dialogue: 0,0:20:56.38,0:20:57.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:57.88,0:20:58.88,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:02.63,0:21:04.01,Default,,0,0,0,,Nuo...
Dialogue: 0,0:21:06.26,0:21:08.22,Default,,0,0,0,,Бұл өте шулы!
Dialogue: 0,0:21:08.30,0:21:13.60,Default,,0,0,0,,Мәселе мынада, жай ғана көңіл көтеру емес, бір оқта басыңды жоғалтасың.
Dialogue: 0,0:21:15.81,0:21:16.60,Default,,0,0,0,,Сараки!
Dialogue: 0,0:21:19.27,0:21:22.78,Default,,0,0,0,,Сен мені құлата алатындай күштісің.
Dialogue: 0,0:21:23.53,0:21:26.91,Default,,0,0,0,,Қатыгездік еткендіктен мен құлықсызмын, бірақ амалым жоқ.
Dialogue: 0,0:21:26.99,0:21:30.49,Default,,0,0,0,,Сіз сияқты қараңғылықтың құдіретті инкарнациясы
Dialogue: 0,0:21:30.58,0:21:33.54,Default,,0,0,0,,Үміт семсерім (Хофнунг) тот бассын!
Dialogue: 0,0:21:34.54,0:21:37.12,Default,,0,0,0,,Мен оны қиып аламын деп ешқашан ойламадым.
Dialogue: 0,0:21:37.21,0:21:40.04,Default,,0,0,0,,Мықты қалқан, берік дене?
Dialogue: 0,0:21:41.09,0:21:43.13,Default,,0,0,0,,Одан да кесіп алған дұрыс.
Dialogue: 0,0:21:43.63,0:21:45.01,Default,,0,0,0,,Сусын
Dialogue: 0,0:21:47.63,0:21:49.43,Default,,0,0,0,,Сыртқы экспозиция
Dialogue: 0,0:21:50.01,0:21:52.43,Default,,0,0,0,,Не? Бұл бастамасы ма?
Dialogue: 0,0:21:53.02,0:21:54.98,Default,,0,0,0,,Зараки жігіт, қашан...
Dialogue: 0,0:21:55.06,0:22:00.02,Default,,0,0,0,,Бұл оның семсерінің тұрақты босату түрі емес екенін білдіре ме?
Dialogue: 0,0:22:00.52,0:22:02.61,Default,,0,0,0,,Жоқ... бірінші орында
Dialogue: 0,0:22:02.69,0:22:07.36,Default,,0,0,0,,Әрқашан ашық түр деген ұғым болмауы мүмкін.
Dialogue: 0,0:22:13.20,0:22:14.87,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:22:17.08,0:22:18.33,Default,,0,0,0,,менің, Иида мен Тодорокидің есімдері жарияланбады—
Dialogue: 0,0:22:22.92,0:22:23.75,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:22:24.38,0:22:27.01,Default,,0,0,0,,Үміт (Хофнунг) жүзін төгіп алды.
Dialogue: 0,0:22:29.76,0:22:31.89,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:22:32.76,0:22:34.51,Default,,0,0,0,,Сенбонзакура Кейгон
Dialogue: 0,0:22:34.60,0:22:36.43,Default,,0,0,0,,Мұз айдаһарының құйрығы
Dialogue: 0,0:22:38.52,0:22:39.23,Default,,0,0,0,,Абсолюттік аспан!
Dialogue: 0,0:22:46.53,0:22:47.28,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:47.36,0:22:48.36,Default,,0,0,0,,Аһ!
Dialogue: 0,0:22:50.16,0:22:53.03,Default,,0,0,0,,Үмітсіздікті соншалықты қалайсыз ба?
Dialogue: 0,0:22:53.66,0:22:56.66,Default,,0,0,0,,Бұл не? Не болып жатыр?
Dialogue: 0,0:22:56.75,0:22:58.58,Default,,0,0,0,,Қандай сұрақ?
Dialogue: 0,0:22:58.66,0:23:00.62,Default,,0,0,0,,Менің күшім – «ғажайып»
Dialogue: 0,0:23:00.71,0:23:04.00,Default,,0,0,0,,Ғажайып дегеніміз не? Халықтың ой-пікіріне пішін беру
Dialogue: 0,0:23:04.50,0:23:09.55,Default,,0,0,0,,Жұрттың үрейінен тозбайтын денем дәу болып кетеді.
Dialogue: 0,0:23:09.63,0:23:13.05,Default,,0,0,0,,Хофнунг халықтың үмітін қылышпен байлады.
Dialogue: 0,0:23:13.14,0:23:16.26,Default,,0,0,0,,Бұзсаң, үмітсіздік болады.
Dialogue: 0,0:23:16.85,0:23:19.89,Default,,0,0,0,,Мен Джеральд Валкиримін
Dialogue: 0,0:23:19.98,0:23:24.48,Default,,0,0,0,,Мен ғажайыппын, ғажайып та менмін
Dialogue: 0,0:23:24.56,0:23:25.27,Default,,0,0,0,,Вахахаха
Dialogue: 0,0:23:25.36,0:23:26.73,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:23:27.23,0:23:29.78,Default,,0,0,0,,Вахахаха!
Dialogue: 0,0:23:30.45,0:23:31.36,Default,,0,0,0,,Чи…
Dialogue: 0,0:23:39.00,0:23:40.83,Default,,0,0,0,,Трансформация дегеніміз
Dialogue: 0,0:23:42.50,0:23:44.08,Default,,0,0,0,,Менің өмірім
Dialogue: 0,0:23:45.58,0:23:51.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
