Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:51.65,0:00:54.32,Default,,0,0,0,,Не болды, Орихиме?
Dialogue: 0,0:00:54.32,0:00:59.66,Default,,0,0,0,,Иә, бұл гүл Куросаки-кунға ұқсайды.
Dialogue: 0,0:00:59.66,0:01:01.66,Default,,0,0,0,,ал қылышың қазірдің өзінде сынық түскен.
Dialogue: 0,0:01:01.66,0:01:04.99,Default,,0,0,0,,Ичиго қызылға қарағанда соған ұқсас, солай ма?
Dialogue: 0,0:01:04.99,0:01:08.83,Default,,0,0,0,,Мен көремін. Жақсы, екеуі де жақсы.
Dialogue: 0,0:01:08.83,0:01:12.83,Default,,0,0,0,,Мен сенен Ичиго туралы кейінірек сұраймын. Әзірге барайық!
Dialogue: 0,0:01:12.83,0:01:16.17,Default,,0,0,0,,Бәрінен жарты жолда өтуім керек.
Dialogue: 0,0:01:16.17,0:01:18.51,Default,,0,0,0,,көремін. Бұл дұрыс.
Dialogue: 0,0:01:18.51,0:01:22.71,Default,,0,0,0,,Дұрыс. Сыныптан тыс сабақтар өте қиын.
Dialogue: 0,0:01:32.62,0:01:35.62,Default,,0,0,0,,《Мен Куросаки-кунның жүрегі екеніне сенімдімін...》
Dialogue: 0,0:01:43.63,0:01:47.14,Default,,0,0,0,,《Оның да сол гүл сияқты түсі бар.
Dialogue: 0,0:01:47.14,0:01:52.14,Default,,0,0,0,,Ол айналаны нұрландырып, жылы және нәзік жарқырайды.
Dialogue: 0,0:01:52.14,0:01:55.14,Default,,0,0,0,,үшінн қорғау үшін》
Dialogue: 0,0:01:57.65,0:02:00.82,Default,,0,0,0,,《Сондықтан мен шештім.
Dialogue: 0,0:02:00.82,0:02:03.52,Default,,0,0,0,,Куросаки-кун, мен...》
Dialogue: 0,0:03:45.12,0:03:49.96,Default,,0,0,0,,Рейацу, ол секундына 48 рет өзгереді.
Dialogue: 0,0:03:49.96,0:03:52.63,Default,,0,0,0,,Басқаша айтқанда➡
Dialogue: 0,0:03:52.63,0:03:56.80,Default,,0,0,0,,Бұл бір секундта барлық 48 үлгіні жеуге болатынын білдіреді.
Dialogue: 0,0:03:56.80,0:04:01.97,Default,,0,0,0,,Басқаша айтқанда, егер сіз тамаша қарым-қатынаста болсаңыз және шабуылдан бір секундқа аман қалсаңыз ➡
Dialogue: 0,0:04:01.97,0:04:05.17,Default,,0,0,0,,Барлық 48 түр жұқтырған.
Dialogue: 0,0:04:07.14,0:04:10.15,Default,,0,0,0,,Иммунитетті әрі қарай талдау және алу үшін не қажет➡
Dialogue: 0,0:04:10.15,0:04:12.15,Default,,0,0,0,,Тек уақыт.
Dialogue: 0,0:04:12.15,0:04:14.65,Default,,0,0,0,,Ой. Одан да көп➡
Dialogue: 0,0:04:14.65,0:04:18.32,Default,,0,0,0,,Мүмкін сол адамның реиатсуын өзгертудің жолы бар шығар➡
Dialogue: 0,0:04:18.32,0:04:20.32,Default,,0,0,0,,Оның пайдасы жоқ.
Dialogue: 0,0:04:20.32,0:04:23.33,Default,,0,0,0,,Уақытты босқа өткізбеу үшін➡
Dialogue: 0,0:04:23.33,0:04:27.83,Default,,0,0,0,,Мейірімділігім үшін мен сізге өзімнің мінсіз денемнің орындалуы туралы айтайын.
Dialogue: 0,0:04:27.83,0:04:31.17,Default,,0,0,0,,Менің мінсіз қасиетті денем Құдайдың улануы➡
Dialogue: 0,0:04:31.17,0:04:33.94,Default,,0,0,0,,Улы өзгерістерге бейімделу.
Dialogue: 0,0:04:33.94,0:04:38.61,Default,,0,0,0,,Удың беткі қабаты қанша өзгерсе де, негізі өзгеріссіз қалса➡
Dialogue: 0,0:04:38.61,0:04:42.61,Default,,0,0,0,,Иммунитетіңізді өзгертіп, оны бірден жоюға болады.
Dialogue: 0,0:04:42.61,0:04:47.28,Default,,0,0,0,,Бұл оны айтудың айналмалы тәсілі ме? Бірақ түсінесің.
Dialogue: 0,0:04:47.28,0:04:52.62,Default,,0,0,0,,Бұдан былай сіз немесе ол сіздің реиатсуыңызды қанша өзгертсе де➡
Dialogue: 0,0:04:52.62,0:04:57.79,Default,,0,0,0,,Маған бірде-бір тырнақ түсіре алмайсың.
Dialogue: 0,0:04:57.79,0:05:01.13,Default,,0,0,0,,Енді не істеуіміз керек, Кисуке Урахара?
Dialogue: 0,0:05:01.13,0:05:05.80,Default,,0,0,0,,Жоқ, мен сіздің қозғалыстарыңызды 1-ден 10➡-ге дейін қираттым
Dialogue: 0,0:05:05.80,0:05:09.20,Default,,0,0,0,,Бәрін таусылғандай емеспіз, солай ма?
Dialogue: 0,0:05:13.98,0:05:17.81,Default,,0,0,0,,Бұлай таң қалмаңыз. Керек бола қалған жағдайда.
Dialogue: 0,0:05:17.81,0:05:20.48,Default,,0,0,0,,Бөлінген аумақтар.
Dialogue: 0,0:05:20.48,0:05:24.49,Default,,0,0,0,,Мен ауыр сөздер айтқанды ұнатпаймын.
Dialogue: 0,0:05:24.49,0:05:29.16,Default,,0,0,0,,Ауыр сөздерді айтатын адамдар еркіндікке ие емес сияқты, солай емес пе?
Dialogue: 0,0:05:29.16,0:05:33.09,Default,,0,0,0,,Мен оған қол жеткізе алатын адам болғым келеді.
Dialogue: 0,0:05:33.09,0:05:35.60,Default,,0,0,0,,Мен айтайын.
Dialogue: 0,0:05:35.60,0:05:38.10,Default,,0,0,0,,Осы өте улы аймақтан➡
Dialogue: 0,0:05:38.10,0:05:41.10,Default,,0,0,0,,Одан құтылу мүлде мүмкін емес.
Dialogue: 0,0:05:41.10,0:05:44.77,Default,,0,0,0,,Сіз шынымен біздің қашып кеткенімізді қаламайсыз, солай ма?
Dialogue: 0,0:05:44.77,0:05:47.78,Default,,0,0,0,,Бұл анық. Қандай растау?
Dialogue: 0,0:05:47.78,0:05:49.78,Default,,0,0,0,,Біз жаумыз.
Dialogue: 0,0:05:49.78,0:05:52.78,Default,,0,0,0,,Жоқ, мен не айтуым керек?➡
Dialogue: 0,0:05:52.78,0:05:56.12,Default,,0,0,0,,Сіз адалдықтан әрекет етіп жатқан сияқтысыз➡
Dialogue: 0,0:05:56.12,0:05:58.12,Default,,0,0,0,,Мен оны көре алмадым.
Dialogue: 0,0:05:58.12,0:06:00.46,Default,,0,0,0,,Бұл дөрекі.
Dialogue: 0,0:06:00.46,0:06:04.63,Default,,0,0,0,,Адалдық бойынша, мен помераниялықтан екі есе адал деп айтар едім.
Dialogue: 0,0:06:04.63,0:06:07.30,Default,,0,0,0,,Бірақ сіз қателесесіз.
Dialogue: 0,0:06:07.30,0:06:09.80,Default,,0,0,0,,Бұл, әрине, бәрі емес.
Dialogue: 0,0:06:09.80,0:06:12.97,Default,,0,0,0,,Мен ұлы мәртебеліге қызығамын.
Dialogue: 0,0:06:12.97,0:06:17.47,Default,,0,0,0,,Қызық десем, жоғарыдан ести аламын ба?
Dialogue: 0,0:06:17.47,0:06:20.14,Default,,0,0,0,,Әрине, бұл менің айтқым келгені емес.
Dialogue: 0,0:06:20.14,0:06:24.31,Default,,0,0,0,,Бұл дүние...қиял әлемі...жан әлемі.
Dialogue: 0,0:06:24.31,0:06:26.82,Default,,0,0,0,,Үш әлемді қиратыңыз➡
Dialogue: 0,0:06:26.82,0:06:29.82,Default,,0,0,0,,Мен одан кейін бірдеңе жасауға тырысамын.
Dialogue: 0,0:06:29.82,0:06:32.92,Default,,0,0,0,,Мәртебеліден басқа мұндай адамдар бар ма?
Dialogue: 0,0:06:32.92,0:06:35.59,Default,,0,0,0,,Мысалы, мен Мәртебелін осында сағындым➡
Dialogue: 0,0:06:35.59,0:06:40.10,Default,,0,0,0,,Келесіде осындай адам шығады деп ойлайсыз ба?
Dialogue: 0,0:06:40.10,0:06:44.27,Default,,0,0,0,,Кисуке Урахара Сен білімдісің.
Dialogue: 0,0:06:44.27,0:06:47.44,Default,,0,0,0,,Сіз бұл дүниеде бәрін көрген сияқтысыз.
Dialogue: 0,0:06:47.44,0:06:49.44,Default,,0,0,0,,Сіз олай ойламайсыз ба?
Dialogue: 0,0:06:49.44,0:06:54.28,Default,,0,0,0,,Ұлы мәртебелі үш дүниені жойғаннан кейін не жасайды?
Dialogue: 0,0:06:54.28,0:06:57.18,Default,,0,0,0,,Мұны көргің келмей ме?
Dialogue: 0,0:06:59.78,0:07:02.78,Default,,0,0,0,,Сіз әлі де сол жылдамдықпен қозғала алмайсыз ба?
Dialogue: 0,0:07:02.78,0:07:06.29,Default,,0,0,0,,Бұл өте улы салада үлкен мәселе.
Dialogue: 0,0:07:06.29,0:07:09.12,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:07:09.12,0:07:13.13,Default,,0,0,0,,Бұл сіздің бұрынғы жауабыңыз ба? Бұл ұят.
Dialogue: 0,0:07:13.13,0:07:16.63,Default,,0,0,0,,Мен сізді сөзсіз осы жақта деп ойладым.
Dialogue: 0,0:07:16.63,0:07:19.47,Default,,0,0,0,,Егер сіз капитан Нируки немесе ➡ болсаңыз
Dialogue: 0,0:07:19.47,0:07:23.14,Default,,0,0,0,,Сіз жаңа нәрсені көргіңіз келетінін айтқан боларсыз.
Dialogue: 0,0:07:23.14,0:07:25.14,Default,,0,0,0,,Майури Нирвана?
Dialogue: 0,0:07:25.14,0:07:27.14,Default,,0,0,0,,Бірақ бәрібір➡
Dialogue: 0,0:07:27.14,0:07:31.15,Default,,0,0,0,,Мен Юха Бахтың не жасағанын көргім келмейді.
Dialogue: 0,0:07:31.15,0:07:34.08,Default,,0,0,0,,Бұрын ешкім көрмеген нәрсені жасағыңыз келсе➡
Dialogue: 0,0:07:34.08,0:07:38.09,Default,,0,0,0,,Өз қолдарымен. Ғалым болу деген осы.
Dialogue: 0,0:07:40.09,0:07:44.43,Default,,0,0,0,,көремін. Мен бұл жауапты жек көрмеймін.
Dialogue: 0,0:07:44.43,0:07:48.60,Default,,0,0,0,,Сонда да мен Мәртебелін көргім келеді!
Dialogue: 0,0:07:48.60,0:07:50.60,Default,,0,0,0,,Улы сақина!
Dialogue: 0,0:07:52.60,0:07:54.60,Default,,0,0,0,,Сендер, үндемеңдер!➡
Dialogue: 0,0:07:56.77,0:07:58.77,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:07:58.77,0:08:02.11,Default,,0,0,0,,Улы сақина керемет күшті➡
Dialogue: 0,0:08:02.11,0:08:06.11,Default,,0,0,0,,Оны өлімге әкелетін дозалар әсер етпейтін қауіпті адамдарға қолданыңыз.
Dialogue: 0,0:08:06.11,0:08:10.62,Default,,0,0,0,,Әсері өлімге әкелетін қуатты бір нүктеге шоғырландыру➡
Dialogue: 0,0:08:10.62,0:08:15.12,Default,,0,0,0,,Тесілген бөлікті дәл анықтау арқылы жауды дереу өлтіріңіз.
Dialogue: 0,0:08:15.12,0:08:17.96,Default,,0,0,0,,Ха… ха….
Dialogue: 0,0:08:17.96,0:08:21.13,Default,,0,0,0,,Бұл сенің кінәң, өйткені сен тым күштісің.
Dialogue: 0,0:08:21.13,0:08:23.63,Default,,0,0,0,,Өлімге әкелетін дозаны төмендету жақсы емес.
Dialogue: 0,0:08:23.63,0:08:26.47,Default,,0,0,0,,Барлық құралдарды жою жақсы емес.
Dialogue: 0,0:08:26.47,0:08:29.47,Default,,0,0,0,,Содан кейін барлық бес мүше мен мүшені ұсақтаңыз➡
Dialogue: 0,0:08:29.47,0:08:32.07,Default,,0,0,0,,Сені өлуге рұқсат етуден басқа амалым жоқ.
Dialogue: 0,0:08:32.07,0:08:34.41,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:34.41,0:08:38.41,Default,,0,0,0,,Сіз мені шындап өлтіргіңіз келеді, солай емес пе?
Dialogue: 0,0:08:38.41,0:08:40.62,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:08:43.08,0:08:45.09,Default,,0,0,0,,Банкай.
Dialogue: 0,0:08:59.10,0:09:02.60,Default,,0,0,0,,Каннон Кай Коухименің қайта қаралған нұсқасы.
Dialogue: 0,0:09:02.60,0:09:05.94,Default,,0,0,0,,О... бұл не?
Dialogue: 0,0:09:05.94,0:09:09.94,Default,,0,0,0,,Банкай? Болмады.
Dialogue: 0,0:09:09.94,0:09:14.45,Default,,0,0,0,,Мәртебеліден алған дүниелердің ішінде Сіздің Банкай туралы ақпарат бар.
Dialogue: 0,0:09:14.45,0:09:19.29,Default,,0,0,0,,Бұл мен оны қазір бірге жүрген адамдардың алдында бірінші рет қолдануым.
Dialogue: 0,0:09:19.29,0:09:22.79,Default,,0,0,0,,Мен көремін. Бұл дұрыс.
Dialogue: 0,0:09:22.79,0:09:26.96,Default,,0,0,0,,Мен сендерден сұрайын, бұл қандай қабілет?
Dialogue: 0,0:09:26.96,0:09:30.63,Default,,0,0,0,,Сіз мұндай нәрсені естідіңіз бе? Сіз олай айта алмайсыз.
Dialogue: 0,0:09:30.63,0:09:32.90,Default,,0,0,0,,Жарайды, солай деп ойлаймын➡
Dialogue: 0,0:09:32.90,0:09:35.74,Default,,0,0,0,,Сұрамай жақындауға қорықпа.
Dialogue: 0,0:09:35.74,0:09:39.07,Default,,0,0,0,,Жарайды. Бірақ айтудың қажеті жоқ➡
Dialogue: 0,0:09:39.07,0:09:41.58,Default,,0,0,0,,Түсінетін уақыт келді.
Dialogue: 0,0:09:44.91,0:09:47.22,Default,,0,0,0,,《Жоқ... мынау! ? 》
Dialogue: 0,0:09:56.59,0:09:58.76,Default,,0,0,0,,Сіз тынышсыз.
Dialogue: 0,0:09:58.76,0:10:03.26,Default,,0,0,0,,Адамдардың көпшілігі таңғалатыны сонша, олар қолын кесіп тастайды.
Dialogue: 0,0:10:03.26,0:10:07.94,Default,,0,0,0,,Оқығаныңыздай, менің Банкайымның әсері ауқымда.
Dialogue: 0,0:10:07.94,0:10:12.27,Default,,0,0,0,,Хаха... Тек қолымды кесуге дәтім жетпейді.
Dialogue: 0,0:10:12.27,0:10:15.44,Default,,0,0,0,,Мен оны бір ғана соққымен оқи алатын шығармын, бірақ...
Dialogue: 0,0:10:15.44,0:10:18.45,Default,,0,0,0,,《Не? Сен не істеп жатырсың? 》
Dialogue: 0,0:10:18.45,0:10:22.12,Default,,0,0,0,,Каннон Кай Коухименің қабілеті ➡
Dialogue: 0,0:10:22.12,0:10:25.72,Default,,0,0,0,,Қолы тиген нәрсені түрлендіру мүмкіндігі.
Dialogue: 0,0:10:34.46,0:10:36.63,Default,,0,0,0,,Не? Сіз оны көре аласыз ба? ?
Dialogue: 0,0:10:36.63,0:10:38.97,Default,,0,0,0,,Сенің көздерің мені бірден өлтіруі керек еді.
Dialogue: 0,0:10:38.97,0:10:43.47,Default,,0,0,0,,Мен оны көріп тұрмын. Бұл да қайта құрылды!
Dialogue: 0,0:10:43.47,0:11:08.50,Default,,0,0,0,,♬～
Dialogue: 0,0:11:08.50,0:11:10.83,Default,,0,0,0,,Аа, маған ұнамайды.
Dialogue: 0,0:11:10.83,0:11:14.34,Default,,0,0,0,,Маған ұнамайды, маған ұнамайды, маған ұнамайды.
Dialogue: 0,0:11:14.34,0:11:18.84,Default,,0,0,0,,Бұл мен жек көретін билік пен билік арасындағы шайқас емес пе?
Dialogue: 0,0:11:18.84,0:11:21.84,Default,,0,0,0,,Мен сені өз өрісіме тарту үшін қиындық көрдім➡
Dialogue: 0,0:11:21.84,0:11:24.18,Default,,0,0,0,,Оны өз қарқыныңызбен орындаңыз➡
Dialogue: 0,0:11:24.18,0:11:27.35,Default,,0,0,0,,Ол не нәрсеге қарамастан өзгертуге өте шебер.
Dialogue: 0,0:11:27.35,0:11:30.55,Default,,0,0,0,,Ол жаман жігіт Кисуке Урахара.
Dialogue: 0,0:11:33.12,0:11:36.29,Default,,0,0,0,,Бірақ күткендей, бұл мінсіз емес!
Dialogue: 0,0:11:36.29,0:11:39.13,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын! ?
Dialogue: 0,0:11:39.13,0:11:44.13,Default,,0,0,0,,Бұл өте улы доп - қашып құтылу мүмкін емес улы қамал!
Dialogue: 0,0:11:44.13,0:11:47.30,Default,,0,0,0,,Осымен тыныс алуға болады➡
Dialogue: 0,0:11:47.30,0:11:50.31,Default,,0,0,0,,Себебі мен әлі де реттеп жатырмын!
Dialogue: 0,0:11:50.31,0:12:18.67,Default,,0,0,0,,♬～
Dialogue: 0,0:12:18.67,0:12:21.50,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:12:21.50,0:12:25.51,Default,,0,0,0,,Сіз өте уланған доптың концентрациясын одан әрі арттыруды жоспарлап отырсыз ба?
Dialogue: 0,0:12:28.51,0:12:30.51,Default,,0,0,0,,Қазірдің өзінде➡
Dialogue: 0,0:12:30.51,0:12:33.95,Default,,0,0,0,,Жерде осылай жорғалап жүрсем де, бар күшімді саламын.
Dialogue: 0,0:12:33.95,0:12:36.95,Default,,0,0,0,,Сіз айтасыз. Мен түссіндім!
Dialogue: 0,0:12:36.95,0:12:39.12,Default,,0,0,0,,Сіздің Банкайыңыз➡
Dialogue: 0,0:12:39.12,0:12:42.12,Default,,0,0,0,,Жерде жай ғана жорғалау қауіпті.
Dialogue: 0,0:12:42.12,0:12:45.13,Default,,0,0,0,,Күтілгендей. Мен өте жақсы түсінемін.
Dialogue: 0,0:12:45.13,0:12:47.73,Default,,0,0,0,,Қазірдің өзінде кеш.
Dialogue: 0,0:12:54.14,0:12:56.80,Default,,0,0,0,,Не?
Dialogue: 0,0:12:56.80,0:12:59.47,Default,,0,0,0,,Мен жәшікке қызықпын.
Dialogue: 0,0:12:59.47,0:13:04.48,Default,,0,0,0,,Сіз бұл қатты уланған шардан құтылу мүмкін емес дедіңіз➡
Dialogue: 0,0:13:04.48,0:13:07.48,Default,,0,0,0,,Өтпейтін демеген.
Dialogue: 0,0:13:07.48,0:13:09.48,Default,,0,0,0,,Сондықтан көріңіз➡
Dialogue: 0,0:13:09.48,0:13:14.49,Default,,0,0,0,,Біз доптың сыртынан жасырын кіруге мүмкіндік беретін жолды жасадық.
Dialogue: 0,0:13:14.49,0:13:18.16,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:13:18.16,0:13:20.96,Default,,0,0,0,,Гриммжоу мырза. (Гримджоу) Цк.
Dialogue: 0,0:13:28.50,0:13:31.34,Default,,0,0,0,,А... сен...
Dialogue: 0,0:13:31.34,0:13:34.44,Default,,0,0,0,,Енді сіз қозғала аласыз.
Dialogue: 0,0:13:34.44,0:13:36.78,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:13:36.78,0:13:40.11,Default,,0,0,0,,Мен сізді төмен бағаладым.
Dialogue: 0,0:13:40.11,0:13:42.95,Default,,0,0,0,,Не? Жүрегім езіліп кетсе де➡
Dialogue: 0,0:13:42.95,0:13:45.45,Default,,0,0,0,,Әлі дем алып жатыр ма деп ойлаймын.
Dialogue: 0,0:13:45.45,0:13:49.96,Default,,0,0,0,,Мен сені осында келе жатып емдедім.
Dialogue: 0,0:13:49.96,0:13:53.96,Default,,0,0,0,,Айзеннің қолынан маскасы аршылған сынған беттер➡
Dialogue: 0,0:13:53.96,0:13:57.13,Default,,0,0,0,,Пышақты қайтару арқылы, сынған беттің реятсуынан➡
Dialogue: 0,0:13:57.13,0:14:00.30,Default,,0,0,0,,Толығымен ойдан шығарылған реиацуға айналады.
Dialogue: 0,0:14:00.30,0:14:04.47,Default,,0,0,0,,Бұл шайқаста пайдалы болуы мүмкін деп ойладым.
Dialogue: 0,0:14:04.47,0:14:08.98,Default,,0,0,0,,Сіз мұны оқыдыңыз ба?
Dialogue: 0,0:14:08.98,0:14:12.15,Default,,0,0,0,,Жоқ. Мен айттым.
Dialogue: 0,0:14:12.15,0:14:15.48,Default,,0,0,0,,Бұл пайдалы болуы мүмкін деп ойладым.
Dialogue: 0,0:14:15.48,0:14:17.82,Default,,0,0,0,,Сонымен мен дайындалдым.
Dialogue: 0,0:14:17.82,0:14:21.16,Default,,0,0,0,,Мыңның біреуін қолдансаңыз, жақсы.
Dialogue: 0,0:14:21.16,0:14:25.16,Default,,0,0,0,,Мүмкін болатын барлық нәрсеге дайындалыңыз.
Dialogue: 0,0:14:25.16,0:14:27.33,Default,,0,0,0,,Мен осылай істеймін.
Dialogue: 0,0:14:27.33,0:14:31.33,Default,,0,0,0,,Бұл тәртіпсіздік. Бұл не?
Dialogue: 0,0:14:31.33,0:14:34.94,Default,,0,0,0,,Бұл шайқас. Жеңілсем өлемін.
Dialogue: 0,0:14:34.94,0:14:38.11,Default,,0,0,0,,Өлмеу үшін өлетіндей дайындалудың қажеті жоқ➡
Dialogue: 0,0:14:38.11,0:14:40.11,Default,,0,0,0,,Мен мұны бәрі істеп жатқанына сенімдімін.
Dialogue: 0,0:14:40.11,0:14:43.11,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:14:43.11,0:14:46.11,Default,,0,0,0,,Қорқынышыңыздың себебі➡
Dialogue: 0,0:14:46.11,0:14:50.72,Default,,0,0,0,,Мен түсіндім деп ойлаймын...
Dialogue: 0,0:14:54.12,0:14:57.63,Default,,0,0,0,,Ол қыңыр бейбақ. Тез өл.
Dialogue: 0,0:14:57.63,0:14:59.96,Default,,0,0,0,,Гриммжоу мырза.
Dialogue: 0,0:14:59.96,0:15:04.47,Default,,0,0,0,,Темемен жасалған келісімшарт Теменің жауларын өлтіруге дейін барады.
Dialogue: 0,0:15:04.47,0:15:06.97,Default,,0,0,0,,Бұл келісім-шарттың аяқталуы.
Dialogue: 0,0:15:09.64,0:15:12.14,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:15:12.14,0:15:15.81,Default,,0,0,0,,Ой... Бір нәрсені айтуды ұмытып кетіппін.
Dialogue: 0,0:15:15.81,0:15:17.98,Default,,0,0,0,,Әлі жоқ...
Dialogue: 0,0:15:17.98,0:15:20.65,Default,,0,0,0,,Мен өлгенде➡
Dialogue: 0,0:15:20.65,0:15:24.82,Default,,0,0,0,,Қатты уланған шарлар күшін арттырады.
Dialogue: 0,0:15:24.82,0:15:27.32,Default,,0,0,0,,Мен қорқып кеттім➡
Dialogue: 0,0:15:27.32,0:15:31.83,Default,,0,0,0,,Мен өзімді араласпау үшін бейсаналық құлыпты кидім➡
Dialogue: 0,0:15:31.83,0:15:33.83,Default,,0,0,0,,Өйткені ол шығып кетеді.
Dialogue: 0,0:15:36.10,0:15:39.60,Default,,0,0,0,,Сізге үлкен құрметпен➡
Dialogue: 0,0:15:39.60,0:15:43.10,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:15:43.10,0:15:47.94,Default,,0,0,0,,Енді қашуға күшің жетпеген шығар.
Dialogue: 0,0:15:47.94,0:15:49.94,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:49.94,0:15:52.45,Default,,0,0,0,,Дегенмен➡
Dialogue: 0,0:15:52.45,0:15:56.75,Default,,0,0,0,,Сіз оны қандай да бір жолмен анықтай алатыныңызға сенімдімін.
Dialogue: 0,0:15:58.79,0:16:01.12,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:16:01.12,0:16:03.79,Default,,0,0,0,,Өйткені бұл мүйізтұмсық➡
Dialogue: 0,0:16:03.79,0:16:08.70,Default,,0,0,0,,Өлім деп айтпаймын...
Dialogue: 0,0:16:16.47,0:16:20.14,Default,,0,0,0,,Цк. Шүкір... мынау...
Dialogue: 0,0:16:20.14,0:16:24.48,Default,,0,0,0,,Осындай нәрсемен... сіз мұны істей аласыз ба?
Dialogue: 0,0:16:24.48,0:16:26.81,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:16:26.81,0:16:31.15,Default,,0,0,0,,Бұл сіз айтқан бес мүмкіндіктің бірі.
Dialogue: 0,0:16:31.15,0:16:34.59,Default,,0,0,0,,Ішіндегі реятсу...мүмкін 4.
Dialogue: 0,0:16:34.59,0:16:36.76,Default,,0,0,0,,Кемінде 2 бару.
Dialogue: 0,0:16:36.76,0:16:38.93,Default,,0,0,0,,Кіреберіс...
Dialogue: 0,0:16:38.93,0:16:41.10,Default,,0,0,0,,Бұл! ? Ауызыңды жап!
Dialogue: 0,0:16:41.10,0:16:45.40,Default,,0,0,0,,Негізі мен Ичигомен бірге барғым келді.
Dialogue: 0,0:16:51.61,0:16:54.11,Default,,0,0,0,,Менің ойымша, бұл солай.
Dialogue: 0,0:16:58.11,0:17:03.12,Default,,0,0,0,,Сізді ортада қалдырғаным үшін кешіріңіз...
Dialogue: 0,0:17:03.12,0:17:08.12,Default,,0,0,0,,Куросаки мырза, Кучики мырза, барлығы...
Dialogue: 0,0:17:22.47,0:17:24.81,Default,,0,0,0,,Сезіп тұрсың ба, Инуэ?
Dialogue: 0,0:17:24.81,0:17:27.14,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:27.14,0:17:29.98,Default,,0,0,0,,Бұл есіктің артында.
Dialogue: 0,0:17:29.98,0:17:32.58,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:32.58,0:17:36.08,Default,,0,0,0,,Екіден бірге….
Dialogue: 0,0:17:36.08,0:17:40.42,Default,,0,0,0,,Бұл қорқақтық шығар, бірақ мен қорғауды сізге тапсырдым.
Dialogue: 0,0:17:40.42,0:17:42.42,Default,,0,0,0,,Өтінемін, Инуэ.
Dialogue: 0,0:17:44.59,0:17:46.76,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:17:46.76,0:17:49.76,Default,,0,0,0,,《Орихиме: Соңында.
Dialogue: 0,0:17:49.76,0:17:53.47,Default,,0,0,0,,Ақырында... ақырында...》
Dialogue: 0,0:17:56.60,0:18:00.11,Default,,0,0,0,,《Мен Куросаки-кунмен күресіп, оны қорғай аламын》
Dialogue: 0,0:18:05.45,0:18:08.12,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:18:08.12,0:18:11.72,Default,,0,0,0,,Мен сені күттім, қараңғы балам.
Dialogue: 0,0:18:15.46,0:18:21.13,Default,,0,0,0,,Оны неге қалдырмасқа? Бұл мүлдем қорғансыз.\NМен
Dialogue: 0,0:18:21.13,0:18:24.13,Default,,0,0,0,,➡ айтқым келеді
Dialogue: 0,0:18:24.13,0:18:28.14,Default,,0,0,0,,Сіз қорғансыз емес сияқтысыз.
Dialogue: 0,0:18:28.14,0:18:33.07,Default,,0,0,0,,Толып жатқан рухани қысым қалыптасып қалғандай.
Dialogue: 0,0:18:33.07,0:18:36.91,Default,,0,0,0,,Сіз күштірек болдыңыз. жоқ….
Dialogue: 0,0:18:36.91,0:18:40.75,Default,,0,0,0,,Бұл сіздің шынайы күшіңіз.
Dialogue: 0,0:18:40.75,0:18:43.42,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:18:43.42,0:18:47.42,Default,,0,0,0,,Оң жақтан келе жатырсың ба, әлде сол жақтан ба?
Dialogue: 0,0:18:47.42,0:18:50.42,Default,,0,0,0,,Оны асыға күтейік.
Dialogue: 0,0:18:52.93,0:18:55.93,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:55.93,0:19:00.77,Default,,0,0,0,,Мен ата-ана мен бала арасындағы диалогты біраз уақыттан кейін алғаш рет ләззат алғым келеді.
Dialogue: 0,0:19:00.77,0:19:04.27,Default,,0,0,0,,Сіз менің ата-анам емессіз.
Dialogue: 0,0:19:04.27,0:19:06.61,Default,,0,0,0,,Исшин Куросаки?
Dialogue: 0,0:19:06.61,0:19:09.78,Default,,0,0,0,,Бұл оның әкесі ғана.
Dialogue: 0,0:19:09.78,0:19:15.62,Default,,0,0,0,,Сіз мұны бұрыннан естіген боларсыз. Сіздің күшіңіздің қайнар көзі туралы.
Dialogue: 0,0:19:15.62,0:19:18.45,Default,,0,0,0,,Мен оны естідім. Бұл солай.
Dialogue: 0,0:19:18.45,0:19:20.79,Default,,0,0,0,,Сіз менің ата-анам емессіз.
Dialogue: 0,0:19:20.79,0:19:22.96,Default,,0,0,0,,Бұл менің ата-анамды өлтірген адам!
Dialogue: 0,0:19:22.96,0:19:26.16,Default,,0,0,0,,Менің анам туралы айтып тұрсың ба? Сіз өте әйелдіксіз, Ичиго!
Dialogue: 0,0:19:31.13,0:19:33.57,Default,,0,0,0,,Гецуга Теншо!
Dialogue: 0,0:19:33.57,0:20:02.10,Default,,0,0,0,,♬～
Dialogue: 0,0:20:02.10,0:20:06.77,Default,,0,0,0,,《Урю: Болашақты көре білу шайқаста жеңе алатыныңды білдірмейді.
Dialogue: 0,0:20:06.77,0:20:12.27,Default,,0,0,0,,Сізге бұғаттауға болмайтынын білетін шабуылдар жасау жеткілікті.
Dialogue: 0,0:20:12.27,0:20:14.78,Default,,0,0,0,,Сіздің бойыңызда орналасқан барлық нәрсені білу және құдіреттілік➡
Dialogue: 0,0:20:14.78,0:20:16.78,Default,,0,0,0,,Мен сені жерлеймін.
Dialogue: 0,0:20:16.78,0:20:21.12,Default,,0,0,0,,Надандығыңызды түзетуге рұқсат етіңіз, Урю Ишида.
Dialogue: 0,0:20:21.12,0:20:24.62,Default,,0,0,0,,Майдан туралы бәрін білу жеткіліксіз➡
Dialogue: 0,0:20:24.62,0:20:27.79,Default,,0,0,0,,Соғыс жағдайын көруден алыс.
Dialogue: 0,0:20:27.79,0:20:33.29,Default,,0,0,0,,Сіз Ичиго Куросакиді ең маңызды шайқасқа жібердіңіз.
Dialogue: 0,0:20:33.29,0:20:35.80,Default,,0,0,0,,Мәртебелі құдіретті және құдіретті жоқ➡
Dialogue: 0,0:20:35.80,0:20:38.80,Default,,0,0,0,,Жоспар - оны жеңуге мүмкіндік беру.
Dialogue: 0,0:20:38.80,0:20:42.80,Default,,0,0,0,,Бұл ақылға қонымды стратегия. Бірақ сіз қателесесіз.
Dialogue: 0,0:20:54.48,0:20:56.48,Default,,0,0,0,,Рух патшасының күші...
Dialogue: 0,0:20:56.48,0:21:19.67,Default,,0,0,0,,♬～
Dialogue: 0,0:21:19.67,0:21:22.51,Default,,0,0,0,,Қайғыға не бар?
Dialogue: 0,0:21:22.51,0:21:25.68,Default,,0,0,0,,Ол өлетіндей өлді.
Dialogue: 0,0:21:25.68,0:21:29.68,Default,,0,0,0,,Мен сені дүниеге әкелдім, Азығым болып өмір сүрдім.
Dialogue: 0,0:21:29.68,0:21:34.19,Default,,0,0,0,,Не нәрсеге көңіліңіз толмайды? Бұдан асқан бақыт бар ма?
Dialogue: 0,0:21:39.46,0:21:41.46,Default,,0,0,0,,Куросаки-кун!
Dialogue: 0,0:21:43.46,0:21:45.47,Default,,0,0,0,,Куросаки-кун!
Dialogue: 0,0:21:47.47,0:21:52.47,Default,,0,0,0,,Әңгіменің соңы. Бұл көңілді болды.
Dialogue: 0,0:21:52.47,0:21:56.98,Default,,0,0,0,,Жүр... ұрысайық, Ичиго.
Dialogue: 0,0:21:56.98,0:22:01.65,Default,,0,0,0,,Бұл барлық нәрсені білу мен құдіреттіліктің күшіне назар аудару жақсы таңдау болды.
Dialogue: 0,0:22:01.65,0:22:06.45,Default,,0,0,0,,Бірақ Мәртебелі мәртебелі мәртебенің қазіргі жағдайын өлшеуге тырысу тым тәкаппарлық болар еді.
Dialogue: 0,0:22:11.49,0:22:13.49,Default,,0,0,0,,Құдіреттілік.
Dialogue: 0,0:22:19.83,0:22:24.24,Default,,0,0,0,,Мен туралы не білгің келді? Урю Ишида.
Dialogue: 0,0:22:30.01,0:22:32.71,Default,,0,0,0,,Үмітсіздік осыдан басталады.
Dialogue: 0,0:22:43.12,0:22:45.13,Default,,0,0,0,,Күте тұрыңыз, Куросаки-кун!
Dialogue: 0,0:22:48.80,0:22:51.30,Default,,0,0,0,,Қандай абайсыз шабуыл.
Dialogue: 0,0:22:51.30,0:22:54.64,Default,,0,0,0,,Әйелді не үшін әкелдің?
Dialogue: 0,0:22:54.64,0:22:57.14,Default,,0,0,0,,Сіз өшпенділікке бой алдырасыз ба?
Dialogue: 0,0:22:59.14,0:23:01.14,Default,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,0:23:04.14,0:23:07.65,Default,,0,0,0,,Ақыры мені жеп, өлесің➡
Dialogue: 0,0:23:07.65,0:23:10.82,Default,,0,0,0,,Өлімге осылай асығу қызықсыз болар еді.
Dialogue: 0,0:23:10.82,0:23:14.32,Default,,0,0,0,,Қанша уақыт пен ғажайыптарға жұмсадық➡
Dialogue: 0,0:23:14.32,0:23:17.16,Default,,0,0,0,,Мен сені жараттым деп ойлаймын.
Dialogue: 0,0:23:17.16,0:23:21.50,Default,,0,0,0,,орындамаңыз. Өміріңізді жеңіл қабылдамаңыз.
Dialogue: 0,0:23:21.50,0:23:24.83,Default,,0,0,0,,Сіздің денеңіз - сіздің күшіңіз ➡
Dialogue: 0,0:23:24.83,0:23:27.67,Default,,0,0,0,,Сіз жалғыз емессіз.
Dialogue: 0,0:23:27.67,0:23:30.84,Default,,0,0,0,,Бар күшіңді түкіріп, өл!
Dialogue: 0,0:23:30.84,0:23:32.84,Default,,0,0,0,,Ичиго!
Dialogue: 0,0:23:34.34,0:23:40.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
