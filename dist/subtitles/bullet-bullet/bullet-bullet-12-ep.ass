Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:04.21,Default,,0,0,0,,♪～
Dialogue: 0,0:01:26.62,0:01:29.17,Default,,0,0,0,,～♪
Dialogue: 0,0:01:36.93,0:01:39.55,Default,,0,0,0,,Мұның сыртында жүйенің өзегі жатыр.
Dialogue: 0,0:01:39.68,0:01:41.01,Default,,0,0,0,,Мен ол затты құртамын!
Dialogue: 0,0:01:42.68,0:01:44.43,Default,,0,0,0,,Нака-нии-нии-итачидің үлесі
Dialogue: 0,0:01:45.56,0:01:48.35,Default,,0,0,0,,Ал... біртүрлі, солай емес пе?
Dialogue: 0,0:01:48.48,0:01:52.61,Default,,0,0,0,,Ештеңе... Жау қалтасында жатырмын.
Dialogue: 0,0:01:52.73,0:01:54.78,Default,,0,0,0,,Қалыпты Кедергілер мен заттар көп...
Dialogue: 0,0:01:54.19,0:01:59.11,Default,,0,0,0,,(Бірінен соң бірі ашылатын есіктердің дыбысы)
Dialogue: 0,0:01:55.32,0:01:56.95,Default,,0,0,0,,Мими Мими Көрдіңіз бе...
Dialogue: 0,0:01:57.07,0:01:59.11,Default,,0,0,0,,Бізді шақырып жатқан сияқты... хмм...
Dialogue: 0,0:01:59.24,0:02:02.49,Default,,0,0,0,,Солай бола тұра, барудан басқа амалым жоқ!
Dialogue: 0,0:02:02.83,0:02:05.20,Default,,0,0,0,,(Көліктің кенет үдеу дыбысы)
Dialogue: 0,0:02:13.21,0:02:15.84,Default,,0,0,0,,Бұл ең терең бөлігі ме?
Dialogue: 0,0:02:16.67,0:02:18.34,Default,,0,0,0,,Мен ештеңе көрмеймін.
Dialogue: 0,0:02:20.72,0:02:21.60,Default,,0,0,0,,-Мм? -Ах
Dialogue: 0,0:02:22.72,0:02:24.77,Default,,0,0,0,,Музыка басталады!
Dialogue: 0,0:02:24.89,0:02:31.86,Default,,0,0,0,,(«Гатча самба» бөлмеде ойнайды)
Dialogue: 0,0:02:32.69,0:02:35.03,Default,,0,0,0,,(Ауыр техниканың құлаған дыбысы)
Dialogue: 0,0:02:35.53,0:02:37.03,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:02:37.65,0:02:42.03,Default,,0,0,0,,Ха ха ха, соны түсіндің бе? Қалай адамдар?
Dialogue: 0,0:02:42.57,0:02:46.95,Default,,0,0,0,,Барлығына! Жеңіс зарын айтайық!
Dialogue: 0,0:02:49.75,0:02:51.88,Default,,0,0,0,,Бұл қиын серуен болды.
Dialogue: 0,0:02:57.51,0:03:00.34,Default,,0,0,0,,Дүкен жабық сияқты.
Dialogue: 0,0:03:03.10,0:03:05.64,Default,,0,0,0,,Қалғанын сұрадым.
Dialogue: 0,0:03:06.68,0:03:07.68,Default,,0,0,0,,Беріліс
Dialogue: 0,0:03:07.35,0:03:08.43,Default,,0,0,0,,(«Гатча Самба» қайта ойналады)
Dialogue: 0,0:03:08.56,0:03:09.81,Default,,0,0,0,,Түсінді…
Dialogue: 0,0:03:08.56,0:03:10.48,Default,,0,0,0,,♪ Құштарлық әуені
Dialogue: 0,0:03:09.94,0:03:11.14,Default,,0,0,0,,Бұл бар...
Dialogue: 0,0:03:10.60,0:03:14.15,Default,,0,0,0,,♪ Иә! Samba-ға жеттім~
Dialogue: 0,0:03:14.27,0:03:19.15,Default,,0,0,0,,♪ Иә! Samba-ны алдым~ Би!
Dialogue: 0,0:03:19.53,0:03:24.16,Default,,0,0,0,,(Құрылтайшылардың күлкісі)
Dialogue: 0,0:03:20.53,0:03:22.16,Default,,0,0,0,,-А-а?
Dialogue: 0,0:03:24.49,0:03:25.95,Default,,0,0,0,,Түсіндім~!
Dialogue: 0,0:03:26.08,0:03:27.66,Default,,0,0,0,,Готча Самба~
Dialogue: 0,0:03:27.79,0:03:29.66,Default,,0,0,0,,Тағы бір рет билеңіз
Dialogue: 0,0:03:29.79,0:03:31.62,Default,,0,0,0,,Ояншы, ояншы, енді оян
Dialogue: 0,0:03:31.75,0:03:32.79,Default,,0,0,0,,Оған өз күнәларының ауырлығын түсіну үшін—
Dialogue: 0,0:03:32.92,0:03:34.79,Default,,0,0,0,,О, бұл аю!
Dialogue: 0,0:03:35.04,0:03:36.29,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:03:36.55,0:03:38.76,Default,,0,0,0,,Мен сенің арқаңа мінейін~
Dialogue: 0,0:03:39.21,0:03:42.76,Default,,0,0,0,,Бұл не деген балалар?
Dialogue: 0,0:03:43.05,0:03:47.01,Default,,0,0,0,,Ол сұмдық қария ғой, солай ма?
Dialogue: 0,0:03:47.35,0:03:48.35,Default,,0,0,0,,Жалғыз осылар ма?
Dialogue: 0,0:03:48.47,0:03:49.85,Default,,0,0,0,,Мемлекеттік қызметкерлер кімдер?
Dialogue: 0,0:03:49.98,0:03:51.69,Default,,0,0,0,,Соңғы бастық кім?
Dialogue: 0,0:03:51.81,0:03:53.77,Default,,0,0,0,,Бұл... әжетхана болуы мүмкін бе?
Dialogue: 0,0:03:53.90,0:03:56.69,Default,,0,0,0,,Балалар, сабақ оқитын кез келді!
Dialogue: 0,0:03:56.82,0:04:01.78,Default,,0,0,0,,Бүгінгі тарих сабағы Осы елдің өткенін білейік!
Dialogue: 0,0:04:01.90,0:04:03.74,Default,,0,0,0,,Мен оқуды жек көремін!
Dialogue: 0,0:04:03.86,0:04:05.16,Default,,0,0,0,,Бұл қызық!
Dialogue: 0,0:04:05.28,0:04:06.28,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:04:06.62,0:04:08.29,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:04:08.41,0:04:10.70,Default,,0,0,0,,Оқу - бұл сұмдық.
Dialogue: 0,0:04:10.83,0:04:12.33,Default,,0,0,0,,Секір!!
Dialogue: 0,0:04:12.46,0:04:15.25,Default,,0,0,0,,Барлығы жақсы көретін «Готчаны» тамашалайық!
Dialogue: 0,0:04:15.46,0:04:18.30,Default,,0,0,0,,Уау! Түсіндім! Түсіндім!
Dialogue: 0,0:04:18.42,0:04:20.21,Default,,0,0,0,,Иә! Яййй!
Dialogue: 0,0:04:20.34,0:04:22.76,Default,,0,0,0,,Иә! Түсіндім!
Dialogue: 0,0:04:22.88,0:04:24.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:30.81,0:04:35.35,Default,,0,0,0,,Адамзат өркениеті қақтығыс жалынымен жойылды.
Dialogue: 0,0:04:36.19,0:04:39.44,Default,,0,0,0,,Бірақ кейбір адамдар аман қалды.
Dialogue: 0,0:04:39.78,0:04:41.28,Default,,0,0,0,,Эвакуациялық кеме
Dialogue: 0,0:04:41.40,0:04:44.24,Default,,0,0,0,,Үлкен компьютерлер жиналып қалды.
Dialogue: 0,0:04:44.36,0:04:49.45,Default,,0,0,0,,Дүниенің күйреуін болжаған кейбір адамдар
Dialogue: 0,0:04:49.58,0:04:54.96,Default,,0,0,0,,Әсем табиғат пен өткен өркениеттер алдын ала сақталған.
Dialogue: 0,0:04:56.21,0:04:57.33,Default,,0,0,0,,Олар бірінші
Dialogue: 0,0:04:57.46,0:05:00.84,Default,,0,0,0,,Маңызды компьютерді жұмыс істеп тұру үшін
Dialogue: 0,0:05:00.96,0:05:03.72,Default,,0,0,0,,Энергия өндіретін құрылғы жасады.
Dialogue: 0,0:05:04.63,0:05:06.89,Default,,0,0,0,,Аман қалғандарға көмектесу
Dialogue: 0,0:05:07.26,0:05:10.72,Default,,0,0,0,,Және біз өз миссиямызды орындауды жалғастыра алуымыз үшін.
Dialogue: 0,0:05:10.85,0:05:16.44,Default,,0,0,0,,Басқалары өз өмірлерін төрт сақшыға сеніп тапсырды.
Dialogue: 0,0:05:17.81,0:05:20.98,Default,,0,0,0,,Бірақ 100 жыл, 200 жыл өтті.
Dialogue: 0,0:05:21.36,0:05:25.53,Default,,0,0,0,,Бірте-бірте олар есінен танып қалды.
Dialogue: 0,0:05:25.90,0:05:28.07,Default,,0,0,0,,Тым ұзақ уақыт ішінде
Dialogue: 0,0:05:28.20,0:05:31.99,Default,,0,0,0,,Біз енді кім екенімізді білмедік.
Dialogue: 0,0:05:32.91,0:05:38.46,Default,,0,0,0,,Олар мүлдем есінен танып қалмас бұрын робот жасады.
Dialogue: 0,0:05:38.58,0:05:44.01,Default,,0,0,0,,Олар роботқа өз атынан тапсырманы орындауды бұйырды.
Dialogue: 0,0:05:44.71,0:05:48.39,Default,,0,0,0,,Роботтар өз жасаушыларымен байланысқан
Dialogue: 0,0:05:48.51,0:05:52.51,Default,,0,0,0,,Адамзаттың естеліктері бар компьютерді қорғау
Dialogue: 0,0:05:52.72,0:05:55.60,Default,,0,0,0,,Көбірек энергия
Dialogue: 0,0:05:56.48,0:06:00.31,Default,,0,0,0,,Көбірек өмір жинады
Dialogue: 0,0:06:04.78,0:06:10.78,Default,,0,0,0,,Міне, қазіргі бақытты дүние осылай жаралған! Түсіндім!
Dialogue: 0,0:06:12.58,0:06:13.91,Default,,0,0,0,,Уау хахаха
Dialogue: 0,0:06:14.20,0:06:15.62,Default,,0,0,0,,Қызықты~
Dialogue: 0,0:06:16.33,0:06:17.62,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:18.04,0:06:19.83,Default,,0,0,0,,Мен білемін, бұл жақсы емес.
Dialogue: 0,0:06:19.96,0:06:23.13,Default,,0,0,0,,Бұл жай ғана ақсақ түсініктемелер. Маған қосымша әрекеттерді қосу керек.
Dialogue: 0,0:06:23.25,0:06:24.63,Default,,0,0,0,,Тұтынушылардың көңілінен шықты... иә?
Dialogue: 0,0:06:23.38,0:06:24.63,Default,,0,0,0,,Бұл емес!
Dialogue: 0,0:06:25.26,0:06:26.38,Default,,0,0,0,,Енді...
Dialogue: 0,0:06:26.51,0:06:27.42,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:06:27.55,0:06:30.84,Default,,0,0,0,,Бұл әсерлі, өйткені ол фактілерге негізделген, солай емес пе?
Dialogue: 0,0:06:30.97,0:06:33.89,Default,,0,0,0,,Түсіндім... бұл дұрыс.
Dialogue: 0,0:06:34.81,0:06:40.10,Default,,0,0,0,,Бізді ұрлаған энергия әркімнің өмірі болды.
Dialogue: 0,0:06:40.69,0:06:43.94,Default,,0,0,0,,Олардың барлығы осында жиналды!
Dialogue: 0,0:06:44.48,0:06:47.11,Default,,0,0,0,,Міне, әлгі мыжылған адамдар...
Dialogue: 0,0:06:47.24,0:06:53.45,Default,,0,0,0,,Әй, осы сұмдық дүниені жасаған да солар шығар.
Dialogue: 0,0:06:53.74,0:06:58.41,Default,,0,0,0,,Ух хехе~ Эй! Маған келесі Готчаны көрсет!
Dialogue: 0,0:06:53.74,0:06:56.41,Default,,0,0,0,,Жарайсың! Бұл соңғы бастық па?
Dialogue: 0,0:06:58.79,0:07:00.37,Default,,0,0,0,,Мен көбірек көргім келеді!
Dialogue: 0,0:07:00.75,0:07:02.38,Default,,0,0,0,,Аю, биле!
Dialogue: 0,0:07:02.50,0:07:04.88,Default,,0,0,0,,- (Тектілер) Кяхахахаха! -Бет мені!
Dialogue: 0,0:07:05.17,0:07:07.59,Default,,0,0,0,,Дұрыс жауап Дұрыс жауап Тамаша дұрыс жауап!
Dialogue: 0,0:07:07.71,0:07:11.84,Default,,0,0,0,,Сыйлық ретінде мен сізге кездесуді қалайтын адаммен кездесуге рұқсат етемін!
Dialogue: 0,0:07:12.72,0:07:13.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:13.72,0:07:14.97,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:07:15.72,0:07:17.77,Default,,0,0,0,,Әй... апай! ?
Dialogue: 0,0:07:17.89,0:07:20.39,Default,,0,0,0,,Мен сені күттім, Gear.
Dialogue: 0,0:07:26.82,0:07:28.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:28.86,0:07:32.24,Default,,0,0,0,,Хохохохохо жүзің жақсы екен
Dialogue: 0,0:07:32.74,0:07:36.74,Default,,0,0,0,,Сондықтан мен сізді осында шақырдым, өйткені мен оны көргім келді.
Dialogue: 0,0:07:37.29,0:07:41.25,Default,,0,0,0,,Әй, эй, бұл бардағы кемпір ғой, солай ма?
Dialogue: 0,0:07:41.37,0:07:43.50,Default,,0,0,0,,Әлде басқа ескі қаңбақ па?
Dialogue: 0,0:07:44.21,0:07:47.25,Default,,0,0,0,,Сіз шынымен... кемпірсіз бе?
Dialogue: 0,0:07:47.55,0:07:48.84,Default,,0,0,0,,О, солай деп ойлаймын.
Dialogue: 0,0:07:48.96,0:07:51.38,Default,,0,0,0,,Мен саған дәмді якинику бердім, солай ма?
Dialogue: 0,0:07:51.51,0:07:56.64,Default,,0,0,0,,Мен сендерге тәтті де тұзды да жасадым, өйткені мен тәттіні жақсы көремін.
Dialogue: 0,0:07:56.76,0:07:58.47,Default,,0,0,0,,-Хехехе-Неге...
Dialogue: 0,0:07:58.93,0:08:00.93,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:08:01.06,0:08:03.73,Default,,0,0,0,,Мен қайдамын?
Dialogue: 0,0:08:04.35,0:08:08.94,Default,,0,0,0,,Көңілсіз барда, Бір кездегі гүлденген қалада
Dialogue: 0,0:08:09.23,0:08:14.61,Default,,0,0,0,,Кемелерде, сауда орталықтарында, жоғарғы органдардың бөлмелерінде.
Dialogue: 0,0:08:15.03,0:08:19.12,Default,,0,0,0,,Мен барлық жердемін, мен бәрін көремін.
Dialogue: 0,0:08:19.45,0:08:22.29,Default,,0,0,0,,А, жаман дәмнің де шегі бар.
Dialogue: 0,0:08:22.41,0:08:24.04,Default,,0,0,0,,Өзім үшін емес
Dialogue: 0,0:08:24.17,0:08:28.13,Default,,0,0,0,,Осы дүниедегі ең асыл миссияны орындау.
Dialogue: 0,0:08:28.34,0:08:33.09,Default,,0,0,0,,Бұл... Gotcha жасау!
Dialogue: 0,0:08:33.72,0:08:38.05,Default,,0,0,0,,Готча — бұрын жер бетінде үлкен хит болған балаларға арналған шоу.
Dialogue: 0,0:08:38.18,0:08:42.73,Default,,0,0,0,,Дүниедегі барлық жақсы балалар мен жаман балалар осымен өсті.
Dialogue: 0,0:08:43.02,0:08:47.48,Default,,0,0,0,,Осы ұзақ және азапты уақыт ішінде мен Готчаны көрген жалғыз уақыт болды
Dialogue: 0,0:08:47.61,0:08:50.73,Default,,0,0,0,,Сіздің санаңыз өткеннің бейбіт заманына оралуы мүмкін.
Dialogue: 0,0:08:51.23,0:08:53.19,Default,,0,0,0,,-（Ａ） -（Ｂ･Ｃ･Ｄ）
Dialogue: 0,0:08:53.53,0:08:56.20,Default,,0,0,0,,Бірақ... дүние жойылды.
Dialogue: 0,0:08:56.61,0:09:01.20,Default,,0,0,0,,Өткеннің Готчасын таусылғаннан кейін, ол аяқталды және сіз болашақты көре алмайсыз.
Dialogue: 0,0:09:01.75,0:09:06.00,Default,,0,0,0,,Мұның қаншалықты қайғылы екенін білесіз бе?
Dialogue: 0,0:09:07.38,0:09:11.09,Default,,0,0,0,,Сонымен! Мен жаңа жұмыс жасауды шештім.
Dialogue: 0,0:09:11.21,0:09:15.84,Default,,0,0,0,,Шеберлер мәңгі күліп, бақытты болсын
Dialogue: 0,0:09:16.09,0:09:20.10,Default,,0,0,0,,Осы мақсатта біз дүниежүзі бойынша әңгімелерді іздедік.
Dialogue: 0,0:09:20.22,0:09:21.85,Default,,0,0,0,,Сансыз сандар...
Dialogue: 0,0:09:22.27,0:09:24.35,Default,,0,0,0,,Мен Gotcha жасадым
Dialogue: 0,0:09:24.48,0:09:25.85,Default,,0,0,0,,Уау! Бұл жол!
Dialogue: 0,0:09:25.98,0:09:26.85,Default,,0,0,0,,Жүктеңіз!
Dialogue: 0,0:09:27.27,0:09:30.19,Default,,0,0,0,,Маған бұл жұмыс ерекше ұнайды.
Dialogue: 0,0:09:30.32,0:09:34.40,Default,,0,0,0,,Батырмын деп қателескен аянышты адам туралы комедия.
Dialogue: 0,0:09:34.53,0:09:38.87,Default,,0,0,0,,Бұл күлкілі және күлкілі, бәрі қатты күледі!
Dialogue: 0,0:09:38.99,0:09:41.70,Default,,0,0,0,,Кяхахахаха!
Dialogue: 0,0:09:41.83,0:09:43.95,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:09:44.25,0:09:47.46,Default,,0,0,0,,Күлме! Жол - бұл... Жол - бұл!
Dialogue: 0,0:09:47.83,0:09:50.34,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:09:53.09,0:09:57.22,Default,,0,0,0,,Хохохохо, келесі кезекте сенің кезегің.
Dialogue: 0,0:09:58.84,0:10:02.72,Default,,0,0,0,,«Шөлдегі үш жеңілген» жаңа Готча!
Dialogue: 0,0:10:03.18,0:10:04.89,Default,,0,0,0,,Бұл біз бе?
Dialogue: 0,0:10:05.02,0:10:07.98,Default,,0,0,0,,Мен бұл түнді ешқашан ұмытпаймын
Dialogue: 0,0:10:09.06,0:10:11.27,Default,,0,0,0,,Бастапқыда ол маған жеткізілуі керек еді...
Dialogue: 0,0:10:11.40,0:10:12.73,Default,,0,0,0,,Негізгі кілт
Dialogue: 0,0:10:12.86,0:10:13.90,Default,,0,0,0,,Мен ештеңе білмеймін...
Dialogue: 0,0:10:14.03,0:10:17.61,Default,,0,0,0,,Тек тобыр болып жүргендер қолдарына алды.
Dialogue: 0,0:10:18.49,0:10:22.08,Default,,0,0,0,,Осы кезде менің денемді электр тоғы соқты!
Dialogue: 0,0:10:22.20,0:10:28.71,Default,,0,0,0,,Дұрыс, егер біз осы балаларды басты кейіпкер етсек, біз ең жақсы туындыны жасай аламыз.
Dialogue: 0,0:10:29.12,0:10:31.50,Default,,0,0,0,,Сонымен, осы уақытқа дейін...
Dialogue: 0,0:10:31.63,0:10:32.71,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:10:33.09,0:10:37.26,Default,,0,0,0,,Көптен бері алақанымда билеп жүрсің.
Dialogue: 0,0:10:37.38,0:10:38.72,Default,,0,0,0,,Бұл қызық болды, солай ма?
Dialogue: 0,0:10:39.09,0:10:40.18,Default,,0,0,0,,Дәл қазірден бастап
Dialogue: 0,0:10:40.30,0:10:43.56,Default,,0,0,0,,Әлемнің иттері Готчаның жаңа жұмысын тамашалап отыр.
Dialogue: 0,0:10:43.68,0:10:46.47,Default,,0,0,0,,Іш, жыла, күл
Dialogue: 0,0:10:46.93,0:10:49.98,Default,,0,0,0,,Бұл сізге қажет
Dialogue: 0,0:10:50.31,0:10:52.52,Default,,0,0,0,,Сіз қанша уақыт сөйлесесіз?
Dialogue: 0,0:10:52.65,0:10:54.86,Default,,0,0,0,,Қызықсыз Қызықсыз!
Dialogue: 0,0:10:54.98,0:10:56.99,Default,,0,0,0,,Тез жүр, ақымақ!
Dialogue: 0,0:10:57.11,0:10:59.99,Default,,0,0,0,,Аа, кешіріңіз, ұстаз.
Dialogue: 0,0:11:00.11,0:11:04.99,Default,,0,0,0,,Иә, мен сіздерге арнайы шоу көрсетемін.
Dialogue: 0,0:11:05.12,0:11:07.37,Default,,0,0,0,,-Ой, о? - Уа... Ха!
Dialogue: 0,0:11:10.46,0:11:12.29,Default,,0,0,0,,Өтірікші... солай ма?
Dialogue: 0,0:11:12.54,0:11:15.80,Default,,0,0,0,,Ұзақ әңгіменің де шарықтау шегі болады.
Dialogue: 0,0:11:16.25,0:11:20.76,Default,,0,0,0,,Сіз менден драмалық және көз жасымен жеңілдіңіз.
Dialogue: 0,0:11:20.88,0:11:24.68,Default,,0,0,0,,Шеберлердің көңілін көтеріңіз.
Dialogue: 0,0:11:24.80,0:11:28.39,Default,,0,0,0,,Ақымақ болма! Қалағаныңды істегенімді қалайсың ба?
Dialogue: 0,0:11:28.68,0:11:33.90,Default,,0,0,0,,Уфхххххххххххххххххххххххххххх
Dialogue: 0,0:11:34.77,0:11:35.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:36.11,0:11:39.28,Default,,0,0,0,,Не деген ақымақтар.
Dialogue: 0,0:11:39.40,0:11:41.70,Default,,0,0,0,,Менің байсалды аю болғаныма көп болды!
Dialogue: 0,0:11:42.28,0:11:46.91,Default,,0,0,0,,Жеңдер! Драаааааа! Ураааааааааааааааааааааааааааа!
Dialogue: 0,0:11:47.58,0:11:50.54,Default,,0,0,0,,Қарғыс атсын, ол сол алып денемен бәрінен де жалтарып кете алады!
Dialogue: 0,0:11:51.04,0:11:52.92,Default,,0,0,0,,Ол қатал, Gear!
Dialogue: 0,0:11:53.29,0:11:56.46,Default,,0,0,0,,Біріншіден, мылтық бұл сауытқа өте алмайды!
Dialogue: 0,0:11:56.59,0:11:58.42,Default,,0,0,0,,Мен басқа нәрсе туралы ойлауым керек...
Dialogue: 0,0:11:58.71,0:12:01.38,Default,,0,0,0,,Жай ойланып жүрмін, уақытым жоқ.
Dialogue: 0,0:12:01.63,0:12:03.22,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:04.51,0:12:06.18,Default,,0,0,0,,Кеттік
Dialogue: 0,0:12:08.01,0:12:09.35,Default,,0,0,0,,Hola Hola!
Dialogue: 0,0:12:09.47,0:12:13.90,Default,,0,0,0,,Басыңды екіге бөліп алмауға тырысып, амалсыз қаш.
Dialogue: 0,0:12:14.65,0:12:16.40,Default,,0,0,0,,Қат! Мен ойнап жатырмын
Dialogue: 0,0:12:16.52,0:12:17.73,Default,,0,0,0,,Хохохохохо
Dialogue: 0,0:12:17.86,0:12:23.32,Default,,0,0,0,,Оның ұятсыз жүгіріп келе жатқанын көргенде ит сияқты.
Dialogue: 0,0:12:23.45,0:12:27.12,Default,,0,0,0,,Бұл шынымен күлкілі және аянышты.
Dialogue: 0,0:12:27.78,0:12:32.16,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:12:32.58,0:12:33.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:34.75,0:12:38.00,Default,,0,0,0,,Сіз қаншалықты кішкентай екеніңізді түсінесіз бе?
Dialogue: 0,0:12:38.13,0:12:40.76,Default,,0,0,0,,Сен жай ғана ойыншықсың.
Dialogue: 0,0:12:40.88,0:12:43.09,Default,,0,0,0,,Қалағаныңызша ойнаңыз және аяқтағаннан кейін оны тастаңыз.
Dialogue: 0,0:12:43.22,0:12:46.47,Default,,0,0,0,,Бұл дүниедегі барлық адамдар осындай.
Dialogue: 0,0:12:46.59,0:12:48.89,Default,,0,0,0,,Сонда да қалада тыныш тұрсаң
Dialogue: 0,0:12:49.01,0:12:51.10,Default,,0,0,0,,Мен қалыпты өмір сүре алдым.
Dialogue: 0,0:12:51.81,0:12:57.86,Default,,0,0,0,,Жаман тамаққа тойып, Ішімдік пен гетчаның арасында күліп өлемін.
Dialogue: 0,0:12:57.98,0:13:01.15,Default,,0,0,0,,Бұл өмір сүрудің ең жақсы жолы емес пе?
Dialogue: 0,0:13:01.28,0:13:06.03,Default,,0,0,0,,Бірақ неге сыртқы әлем туралы білгіңіз келді?
Dialogue: 0,0:13:06.57,0:13:09.24,Default,,0,0,0,,Білмеу - ең бақытты нәрсе!
Dialogue: 0,0:13:09.37,0:13:10.49,Default,,0,0,0,,Шулы!
Dialogue: 0,0:13:10.91,0:13:12.33,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:13:12.66,0:13:15.42,Default,,0,0,0,,Енді аяқталды.
Dialogue: 0,0:13:16.04,0:13:17.92,Default,,0,0,0,,Уф!Уф!
Dialogue: 0,0:13:26.80,0:13:28.39,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:13:28.89,0:13:30.64,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:13:37.48,0:13:40.15,Default,,0,0,0,,Сіз осындай нәрсеге тоқтайсыз ба?
Dialogue: 0,0:13:40.82,0:13:42.65,Default,,0,0,0,,Мені ұрған адам!
Dialogue: 0,0:13:42.86,0:13:46.20,Default,,0,0,0,,Ха, сенің кезегің әлдеқашан бітті.
Dialogue: 0,0:13:46.32,0:13:49.99,Default,,0,0,0,,Іссапарға жеңілген адам келгенін қалай түсінесіз?
Dialogue: 0,0:13:50.12,0:13:51.62,Default,,0,0,0,,Мен әлі тағзым еткен жоқпын.
Dialogue: 0,0:13:51.74,0:13:52.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:52.83,0:13:55.46,Default,,0,0,0,,Себебі мен сасық аяғымды жалайтынмын.
Dialogue: 0,0:13:55.96,0:14:00.29,Default,,0,0,0,,Сызғыштың орнында, шіркін кенелер
Dialogue: 0,0:14:00.42,0:14:01.79,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:14:01.92,0:14:03.30,Default,,0,0,0,,(жылдам үдеу дыбысы)
Dialogue: 0,0:14:03.67,0:14:08.26,Default,,0,0,0,,Сондықтан мен мырзамын. Мен жеңіле алмаймын!
Dialogue: 0,0:14:08.68,0:14:11.18,Default,,0,0,0,,Ей, бұл қиын!
Dialogue: 0,0:14:17.06,0:14:19.15,Default,,0,0,0,,Атыс шайқасында біз қолайсыз жағдайға тап болдық.
Dialogue: 0,0:14:19.27,0:14:22.23,Default,,0,0,0,,Бірақ бұл дүниеде жеңілмейтін ештеңе жоқ.
Dialogue: 0,0:14:22.65,0:14:25.36,Default,,0,0,0,,Бір жерде нәзік бөлік болуы керек.
Dialogue: 0,0:14:25.49,0:14:26.44,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,0:14:27.15,0:14:28.95,Default,,0,0,0,,Нәзік бөлік... а
Dialogue: 0,0:14:29.70,0:14:31.07,Default,,0,0,0,,Негізгі дене қозғалса да
Dialogue: 0,0:14:31.20,0:14:33.70,Default,,0,0,0,,Тек сол кабель әрқашан жалғанған.
Dialogue: 0,0:14:34.04,0:14:36.58,Default,,0,0,0,,Мүмкін қуатқа арналған энергия құбыры.
Dialogue: 0,0:14:36.70,0:14:39.00,Default,,0,0,0,,Егер біз бұл затты жойсақ, оның қозғалысын тоқтатуымыз мүмкін.
Dialogue: 0,0:14:39.12,0:14:41.96,Default,,0,0,0,,Эй, қоқыс сатушының ұлы күткендей!
Dialogue: 0,0:14:51.18,0:14:55.01,Default,,0,0,0,,Би, Оқ!
Dialogue: 0,0:15:01.60,0:15:02.61,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:15:03.69,0:15:06.15,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:10.28,0:15:11.36,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:14.20,0:15:15.83,Default,,0,0,0,,Бұл~!
Dialogue: 0,0:15:16.58,0:15:20.41,Default,,0,0,0,,Жетеді! Жақсы көрінетін жолмен қалай жеңемін деп уайымдауды доғар!
Dialogue: 0,0:15:20.54,0:15:24.34,Default,,0,0,0,,Мен олардың барлығын жарып жіберемін!
Dialogue: 0,0:15:24.88,0:15:25.96,Default,,0,0,0,,Чугой Чугой!
Dialogue: 0,0:15:26.09,0:15:27.59,Default,,0,0,0,,Ахахха мен үрейленіп тұрмын.
Dialogue: 0,0:15:28.88,0:15:31.01,Default,,0,0,0,,(электрлік қысқа тұйықталу дыбысы)
Dialogue: 0,0:15:40.94,0:15:42.73,Default,,0,0,0,,････
Dialogue: 0,0:15:45.44,0:15:47.44,Default,,0,0,0,,Өлтіріңдер балалар
Dialogue: 0,0:15:47.90,0:15:51.11,Default,,0,0,0,,Мен Gotcha жасай беремін!
Dialogue: 0,0:15:51.24,0:15:54.99,Default,,0,0,0,,Болашақ мәңгілік шеберлер үшін!
Dialogue: 0,0:15:55.12,0:15:58.87,Default,,0,0,0,,(қуаттың өшіп жатқан дыбысы)
Dialogue: 0,0:15:56.16,0:15:57.16,Default,,0,0,0,,Ах
Dialogue: 0,0:15:58.08,0:15:58.87,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:59.70,0:16:03.88,Default,,0,0,0,,Энергиямен қамтамасыз ету азаяды ма? Не айтқың келеді?
Dialogue: 0,0:16:04.17,0:16:07.09,Default,,0,0,0,,Мен түсінбеймін, бірақ енді менің мүмкіндігім!
Dialogue: 0,0:16:10.42,0:16:11.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:13.22,0:16:14.22,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:16:14.34,0:16:15.26,Default,,0,0,0,,​​О?
Dialogue: 0,0:16:17.39,0:16:19.81,Default,,0,0,0,,Бұл... ысырап!
Dialogue: 0,0:16:19.93,0:16:21.73,Default,,0,0,0,,А-а-а?
Dialogue: 0,0:16:23.81,0:16:24.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:25.27,0:16:28.69,Default,,0,0,0,,Саған беріліспен араласуға кім рұқсат берді?
Dialogue: 0,0:16:29.03,0:16:30.36,Default,,0,0,0,,Беріліс үшін емес
Dialogue: 0,0:16:30.48,0:16:31.90,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:16:32.20,0:16:34.11,Default,,0,0,0,,Сенімді отбасы
Dialogue: 0,0:16:34.24,0:16:35.91,Default,,0,0,0,,Бұл қосулы!
Dialogue: 0,0:16:36.32,0:16:37.37,Default,,0,0,0,,-Барлығы... -Уау
Dialogue: 0,0:16:37.74,0:16:41.08,Default,,0,0,0,,Gear Мен сізді осы эмоционалды кездесуде құшақтағым келеді.
Dialogue: 0,0:16:41.66,0:16:44.29,Default,,0,0,0,,Біз бұл жігітті ұстаймыз!
Dialogue: 0,0:16:44.42,0:16:45.92,Default,,0,0,0,,Жасайық, сиыр!
Dialogue: 0,0:16:46.04,0:16:47.25,Default,,0,0,0,,Кеттік, Носа!
Dialogue: 0,0:16:48.21,0:16:49.71,Default,,0,0,0,,Бұзушылық!
Dialogue: 0,0:16:49.84,0:16:51.71,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:16:57.89,0:17:00.10,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:17:02.39,0:17:04.73,Default,,0,0,0,,Жүр!
Dialogue: 0,0:17:09.52,0:17:11.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:13.57,0:17:14.61,Default,,0,0,0,,Иә
Dialogue: 0,0:17:28.38,0:17:30.96,Default,,0,0,0,,Мына қаншық бейбақтар!
Dialogue: 0,0:17:31.46,0:17:32.26,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:33.84,0:17:35.84,Default,,0,0,0,,Уряаааааааааааа!
Dialogue: 0,0:17:38.39,0:17:40.47,Default,,0,0,0,,Уф! Ха! Апыр-ай!
Dialogue: 0,0:17:44.27,0:17:45.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:50.61,0:17:54.69,Default,,0,0,0,,А, мен бірінші рет нысанаға тидім.
Dialogue: 0,0:17:55.44,0:17:58.61,Default,,0,0,0,,Иә! Ринді көріп тұрсың ба?
Dialogue: 0,0:17:58.74,0:18:00.45,Default,,0,0,0,,Әке, әке, біз істедік!
Dialogue: 0,0:18:00.58,0:18:03.16,Default,,0,0,0,,Ахахха! Хе ха!
Dialogue: 0,0:18:03.29,0:18:05.16,Default,,0,0,0,,(электрлік қысқа тұйықталу дыбысы)
Dialogue: 0,0:18:10.63,0:18:11.92,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:18:12.34,0:18:14.55,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:18:14.67,0:18:16.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:16.47,0:18:18.34,Default,,0,0,0,,(Қуаныш дыбыстары)
Dialogue: 0,0:18:18.47,0:18:20.22,Default,,0,0,0,,-Жеңді! -Ухохохо
Dialogue: 0,0:18:20.34,0:18:23.06,Default,,0,0,0,,Беріліс! Gear!
Dialogue: 0,0:18:20.34,0:18:21.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:23.72,0:18:25.02,Default,,0,0,0,,Беріліс!
Dialogue: 0,0:18:25.47,0:18:26.48,Default,,0,0,0,,Нұх!
Dialogue: 0,0:18:26.93,0:18:30.40,Default,,0,0,0,,Есту құрылғысы? Бұл дауыс!
Dialogue: 0,0:18:30.86,0:18:32.11,Default,,0,0,0,,Сәлем! Барлығына!
Dialogue: 0,0:18:32.23,0:18:34.48,Default,,0,0,0,,Үлкен үлкен жаңалық!
Dialogue: 0,0:18:34.98,0:18:38.74,Default,,0,0,0,,Қазір жабайы қалада бір қорқынышты нәрсе болып жатыр!
Dialogue: 0,0:18:38.86,0:18:43.99,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:18:39.24,0:18:40.87,Default,,0,0,0,,Бұл қарғыс атқан Пауыл
Dialogue: 0,0:18:40.99,0:18:43.99,Default,,0,0,0,,Біз энергиямызды астанаға жібереміз!
Dialogue: 0,0:18:44.12,0:18:46.00,Default,,0,0,0,,Ендеше тоқтатыңыз!
Dialogue: 0,0:18:46.33,0:18:47.83,Default,,0,0,0,,Түсіңдер, балалар!
Dialogue: 0,0:18:47.96,0:18:49.92,Default,,0,0,0,,Артқа тұра аласыз ба!
Dialogue: 0,0:18:50.04,0:18:51.79,Default,,0,0,0,,Сенің ақымақ ұлың тым алғыр!
Dialogue: 0,0:18:51.92,0:18:54.00,Default,,0,0,0,,Әкем өзін итермесе, не істеймін!
Dialogue: 0,0:18:54.25,0:18:57.01,Default,,0,0,0,,Егер тағы да зорлық-зомбылық көрсетсең, мен сені тұтқынға аламын!
Dialogue: 0,0:18:57.13,0:19:01.01,Default,,0,0,0,,Қолыңнан келсе, істе, ақымақ!
Dialogue: 0,0:19:01.64,0:19:04.06,Default,,0,0,0,,Көңіл-күйі жоғары кейбір адамдар
Dialogue: 0,0:19:04.18,0:19:06.64,Default,,0,0,0,,Тенжин Полға шабуыл.
Dialogue: 0,0:19:06.77,0:19:08.68,Default,,0,0,0,,Мен дүрбелеңдемін!
Dialogue: 0,0:19:08.81,0:19:12.86,Default,,0,0,0,,Барлық жерде шөл далада!
Dialogue: 0,0:19:12.98,0:19:15.19,Default,,0,0,0,,Барлығы, қоқыс жинау ештеңе емес.
Dialogue: 0,0:19:15.32,0:19:18.36,Default,,0,0,0,,Соның арқасында полюстің жарығы шуылдап жанып тұрды.
Dialogue: 0,0:19:18.49,0:19:22.49,Default,,0,0,0,,Бизнеске жабылды О, құдай! Хаха
Dialogue: 0,0:19:22.62,0:19:26.37,Default,,0,0,0,,Мысық та құйрығын қайырып, ұйықтайды, ұйықтайды, ұйықтайды!
Dialogue: 0,0:19:25.49,0:19:27.83,Default,,0,0,0,,Қала тұрғындары...
Dialogue: 0,0:19:28.37,0:19:31.67,Default,,0,0,0,,Бұл оның өнімділігінің төмендеуіне себеп болды.
Dialogue: 0,0:19:32.88,0:19:38.30,Default,,0,0,0,,Даусыңыз бен ойыңыз бәріне жетті.
Dialogue: 0,0:19:39.67,0:19:41.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:42.43,0:19:43.30,Default,,0,0,0,,Ах
Dialogue: 0,0:19:46.68,0:19:48.27,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:19:50.73,0:19:54.31,Default,,0,0,0,,Тамағымыз бітті!
Dialogue: 0,0:19:54.44,0:19:57.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:03.57,0:20:05.03,Default,,0,0,0,,- (Қарсыласу басшысы) Лин! -Ах
Dialogue: 0,0:20:06.37,0:20:09.33,Default,,0,0,0,,Сіз не істегеніңізді білесіз бе?
Dialogue: 0,0:20:10.41,0:20:15.25,Default,,0,0,0,,Иә, мен үшін барлығына қауіп төніп тұр...
Dialogue: 0,0:20:15.92,0:20:18.21,Default,,0,0,0,,Қарсылық дисквалификацияланады.
Dialogue: 0,0:20:19.42,0:20:21.97,Default,,0,0,0,,Мен мұны қате істеген шығармын, бірақ
Dialogue: 0,0:20:22.09,0:20:25.34,Default,,0,0,0,,Сіз достарыңызды өз жолыңызбен қорғауға тырыстыңыз, солай ма?
Dialogue: 0,0:20:26.22,0:20:29.93,Default,,0,0,0,,Қайт, Рин, жаңа дәуір келе жатыр.
Dialogue: 0,0:20:30.06,0:20:32.10,Default,,0,0,0,,Маған сенің көмегің керек
Dialogue: 0,0:20:33.52,0:20:36.86,Default,,0,0,0,,Ха... Уф
Dialogue: 0,0:20:37.06,0:20:38.36,Default,,0,0,0,,Не?
Dialogue: 0,0:20:38.48,0:20:41.28,Default,,0,0,0,,Неліктен сен кенет өмірге қайта келдің?
Dialogue: 0,0:20:41.40,0:20:44.74,Default,,0,0,0,,А? Қайта тірілсе жаман болар ма еді?
Dialogue: 0,0:20:44.86,0:20:46.07,Default,,0,0,0,,-Иә -А? иә?
Dialogue: 0,0:20:46.20,0:20:49.87,Default,,0,0,0,,Барлығын қайта көргенім жақсы!
Dialogue: 0,0:20:50.20,0:20:51.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:51.45,0:20:53.16,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:53.29,0:20:56.17,Default,,0,0,0,,Ұйықтар алдында мұндай нәрсе мені мазалайды!
Dialogue: 0,0:20:56.29,0:20:57.50,Default,,0,0,0,,Негізсіз бұзу
Dialogue: 0,0:20:57.63,0:20:59.84,Default,,0,0,0,,Ішінде ақылсыз емес пе еді?
Dialogue: 0,0:21:00.17,0:21:02.38,Default,,0,0,0,,Міне, солай болады.
Dialogue: 0,0:21:02.88,0:21:05.09,Default,,0,0,0,,Бұл шынымен таң қалдырды.
Dialogue: 0,0:21:05.22,0:21:09.35,Default,,0,0,0,,Шындығында, бұл жай ғана өлі батарея болды.
Dialogue: 0,0:21:09.60,0:21:12.48,Default,,0,0,0,,Батарея бітті ме?
Dialogue: 0,0:21:13.06,0:21:14.85,Default,,0,0,0,,Енді ойлап қарасам, бұл рас.
Dialogue: 0,0:21:15.19,0:21:19.69,Default,,0,0,0,,Мен сіздің оны зарядтап жатқаныңызды ешқашан көрген емеспін.
Dialogue: 0,0:21:19.98,0:21:22.03,Default,,0,0,0,,Мұндай нәрсе қажет.
Dialogue: 0,0:21:22.15,0:21:25.32,Default,,0,0,0,,Мен бұл туралы мүлдем ұмытып кеттім.
Dialogue: 0,0:21:25.45,0:21:28.03,Default,,0,0,0,,Мықты болыңыз, Стингрей әже.
Dialogue: 0,0:21:28.16,0:21:29.62,Default,,0,0,0,,Қазірдің өзінде абайсызда
Dialogue: 0,0:21:29.74,0:21:31.45,Default,,0,0,0,,Өліп қала жаздадың.
Dialogue: 0,0:21:31.58,0:21:32.83,Default,,0,0,0,,Шындық
Dialogue: 0,0:21:32.95,0:21:36.21,Default,,0,0,0,,Қарапайым көрінеді, бірақ қарапайым
Dialogue: 0,0:21:36.79,0:21:38.29,Default,,0,0,0,,Хахахахахаха!
Dialogue: 0,0:21:38.42,0:21:39.42,Default,,0,0,0,,Уф
Dialogue: 0,0:21:39.17,0:21:41.21,Default,,0,0,0,,Мен оны… қолданамын деп ойламаған едім
Dialogue: 0,0:21:41.34,0:21:43.01,Default,,0,0,0,,Демалуға әлі ерте.
Dialogue: 0,0:21:43.13,0:21:44.13,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:44.22,0:21:46.22,Default,,0,0,0,,Маған оны тазалау керек.
Dialogue: 0,0:21:46.51,0:21:48.43,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:21:48.55,0:21:50.64,Default,,0,0,0,,Маған көбірек көрсет!
Dialogue: 0,0:21:50.93,0:21:53.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:51.31,0:21:53.60,Default,,0,0,0,,Бұл балалармен не істеуіміз керек?
Dialogue: 0,0:21:53.72,0:21:55.39,Default,,0,0,0,,Қызық екен, сені сонда апарайық.
Dialogue: 0,0:21:55.52,0:21:56.60,Default,,0,0,0,,- Иә? -Ақымақ болма!
Dialogue: 0,0:21:56.73,0:21:59.61,Default,,0,0,0,,Мастер...
Dialogue: 0,0:22:00.77,0:22:04.74,Default,,0,0,0,,«Дахлия» Бұл сіздің атыңыз.
Dialogue: 0,0:22:05.11,0:22:08.16,Default,,0,0,0,,«Өмірді қорғайтын» мағынасы
Dialogue: 0,0:22:12.08,0:22:16.58,Default,,0,0,0,,Мамору… Шимей…
Dialogue: 0,0:22:16.71,0:22:17.71,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:22:18.17,0:22:19.17,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:18.67,0:22:19.67,Default,,0,0,0,,Ах
Dialogue: 0,0:22:19.79,0:22:24.17,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:22:22.29,0:22:24.17,Default,,0,0,0,,Ах! Мен өзімді-өзім құртамын!
Dialogue: 0,0:22:29.55,0:22:30.97,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:22:31.10,0:22:33.14,Default,,0,0,0,,Жүр! тез!
Dialogue: 0,0:22:33.43,0:22:34.64,Default,,0,0,0,,Сіз оны уақытында жасайсыз ба?
Dialogue: 0,0:22:35.39,0:22:36.81,Default,,0,0,0,,-Сәлем! -А?
Dialogue: 0,0:22:37.18,0:22:38.94,Default,,0,0,0,,Gear~!
Dialogue: 0,0:22:40.06,0:22:46.78,Default,,0,0,0,,(Үздіксіз дабыл дыбысы)
Dialogue: 0,0:22:58.33,0:22:59.83,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:23:13.93,0:23:20.10,Default,,0,0,0,,Рақмет. Кешіріңіз.
Dialogue: 0,0:23:20.27,0:23:22.69,Default,,0,0,0,,(қозғалтқыш дыбысы өшеді)
Dialogue: 0,0:23:21.73,0:23:24.90,Default,,0,0,0,,Сіз ол жерден бірдеңе көре аласыз ба?
Dialogue: 0,0:23:26.15,0:23:31.11,Default,,0,0,0,,Мен барлығының ертеңін анық көремін!
Dialogue: 0,0:23:34.37,0:23:36.49,Default,,0,0,0,,♪～
Dialogue: 0,0:24:06.65,0:24:11.65,Default,,0,0,0,,Сонда әлем тоқтаған сағат сияқты қайта қозғала бастады.
Dialogue: 0,0:24:11.78,0:24:13.95,Default,,0,0,0,,Заттар тез өзгерді.
Dialogue: 0,0:24:20.25,0:24:26.04,Default,,0,0,0,,Қалада консерваторлар мен қарсыластар Тенжин полюсінің операциясы үшін күні-түні күресуде.
Dialogue: 0,0:24:26.92,0:24:31.05,Default,,0,0,0,,Өйткені, өмір салтына үйреніп алғаннан кейін оны тастау қиын сияқты.
Dialogue: 0,0:24:32.13,0:24:33.30,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:24:33.43,0:24:35.80,Default,,0,0,0,,Тірі қалған кейбір жүйелерден
Dialogue: 0,0:24:35.93,0:24:38.93,Default,,0,0,0,,Жердің бұрынғы ғылыми деректері ашылды.
Dialogue: 0,0:24:39.43,0:24:42.94,Default,,0,0,0,,Жаңа технологиялар біртіндеп өсіп келеді.
Dialogue: 0,0:24:43.85,0:24:45.19,Default,,0,0,0,,Бұдан былай дүние болады
Dialogue: 0,0:24:45.31,0:24:47.61,Default,,0,0,0,,Ол өзгере береді.
Dialogue: 0,0:24:47.73,0:24:53.32,Default,,0,0,0,,А, дұрыс. Өзгерген нәрселер туралы айтатын болсақ, бұл ағайынды аспаздардың үлкен фермасы.
Dialogue: 0,0:24:54.32,0:24:56.32,Default,,0,0,0,,Енді ол шөл даладай үлкен
Dialogue: 0,0:24:56.49,0:24:59.33,Default,,0,0,0,,Жаңа піскен көкөністер мен сүтті әртүрлі қалаларға жеткізу
Dialogue: 0,0:25:00.45,0:25:05.33,Default,,0,0,0,,Олардың өлтірушілер екеніне ешкім сенбес еді.
Dialogue: 0,0:25:06.29,0:25:10.84,Default,,0,0,0,,Айтпақшы, шараптың прототипі әлі де жасалып жатқан сияқты.
Dialogue: 0,0:25:10.96,0:25:12.76,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:25:13.09,0:25:15.72,Default,,0,0,0,,Гохо гохо гохо гохо
Dialogue: 0,0:25:17.68,0:25:18.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:21.81,0:25:25.39,Default,,0,0,0,,Сіз әбден қартайдыңыз, солай емес пе, Дампер?
Dialogue: 0,0:25:25.94,0:25:26.94,Default,,0,0,0,,Тема
Dialogue: 0,0:25:28.86,0:25:31.40,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:25:32.82,0:25:35.86,Default,,0,0,0,,Әркім өз ертеңіне қарай бет алады.
Dialogue: 0,0:25:37.07,0:25:39.58,Default,,0,0,0,,Сен қорғаған ертең
Dialogue: 0,0:25:39.87,0:25:43.41,Default,,0,0,0,,Ей, тез тамақтан!
Dialogue: 0,0:25:43.54,0:25:45.62,Default,,0,0,0,,Ол өседі
Dialogue: 0,0:25:45.75,0:25:47.58,Default,,0,0,0,,Жемесең, төмендетемін.
Dialogue: 0,0:25:47.71,0:25:50.34,Default,,0,0,0,,А, әке, енді қолыңнан келмейді.
Dialogue: 0,0:25:50.46,0:25:52.50,Default,,0,0,0,,Бір-біріңізді білетіндіктен тұтынушыларға осындай қызмет көрсету
Dialogue: 0,0:25:52.63,0:25:53.96,Default,,0,0,0,,Дүкенді жоюды жоспарлап отырсыз ба?
Dialogue: 0,0:25:54.09,0:25:55.92,Default,,0,0,0,,О, жоқ, жоқ, жоқ
Dialogue: 0,0:25:54.09,0:25:55.47,Default,,0,0,0,,Ана
Dialogue: 0,0:25:56.05,0:25:58.09,Default,,0,0,0,,Рин, егер ол ісің үшін сынға түссең, бәрі бітті.
Dialogue: 0,0:25:58.22,0:25:59.55,Default,,0,0,0,,Сондықтан!
Dialogue: 0,0:25:59.68,0:26:02.72,Default,,0,0,0,,Ах! Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:26:02.85,0:26:04.89,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:26:02.85,0:26:04.89,Default,,0,0,0,,Кәдімгі жұп төбелеседі
Dialogue: 0,0:26:05.43,0:26:09.90,Default,,0,0,0,,Әй, танымал аспаз аспаздық шеберлігін тағы да жетілдірді дейді.
Dialogue: 0,0:26:10.27,0:26:13.28,Default,,0,0,0,,Ақыры ермек сияқты әрекет ету қызық бола бастады.
Dialogue: 0,0:26:13.40,0:26:17.91,Default,,0,0,0,,Скатты кемпірдің Спартасы қауіпті, ал егер сіз аздап әлсіресеңіз...
Dialogue: 0,0:26:18.36,0:26:19.91,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:26:20.07,0:26:22.91,Default,,0,0,0,,Екеуің бірдеңе айттыңдар ма?
Dialogue: 0,0:26:23.04,0:26:25.04,Default,,0,0,0,,Мен ештеңе айтқан жоқпын!
Dialogue: 0,0:26:25.16,0:26:28.08,Default,,0,0,0,,Сондықтан ләззат алыңыз.
Dialogue: 0,0:26:28.21,0:26:31.67,Default,,0,0,0,,«Бір нәрсе қайнап жатқан сияқты, бірақ ештеңе қайнап жатқан жоқ».
Dialogue: 0,0:26:31.79,0:26:32.92,Default,,0,0,0,,Оян!
Dialogue: 0,0:26:33.80,0:26:35.05,Default,,0,0,0,,Мияу
Dialogue: 0,0:26:36.63,0:26:38.34,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:26:38.47,0:26:42.01,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:26:42.60,0:26:46.77,Default,,0,0,0,,Жаныңда болсам, өткенге оралғандай
Dialogue: 0,0:26:54.44,0:26:58.95,Default,,0,0,0,,Егер сол күні орталықта жарылыс болса.
Dialogue: 0,0:26:59.74,0:27:02.07,Default,,0,0,0,,Бұл дүниенің адамдары, бәлкім...
Dialogue: 0,0:27:04.54,0:27:05.79,Default,,0,0,0,,Рахмет
Dialogue: 0,0:27:09.62,0:27:11.92,Default,,0,0,0,,Хе ха!
Dialogue: 0,0:27:12.04,0:27:15.88,Default,,0,0,0,,DJ TJ "Радио! Радио! Радио!"
Dialogue: 0,0:27:16.00,0:27:17.38,Default,,0,0,0,,Келесі музыка
Dialogue: 0,0:27:17.51,0:27:21.22,Default,,0,0,0,,Шөл даладағы ковбойдың ыстық өтініші
Dialogue: 0,0:27:21.34,0:27:25.06,Default,,0,0,0,,Тыңдаушының аты... Иә? Сіз не оқисыз?
Dialogue: 0,0:27:22.26,0:27:23.26,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:27:25.18,0:27:27.89,Default,,0,0,0,,Барре... О! Хахахаха
Dialogue: 0,0:27:28.02,0:27:29.39,Default,,0,0,0,,«Оқ оқ»!
Dialogue: 0,0:27:29.52,0:27:31.90,Default,,0,0,0,,Жіберілетін нөмір – «Кері қайтару»!
Dialogue: 0,0:27:32.02,0:27:35.07,Default,,0,0,0,,(Дүкенде музыка ойналады)
Dialogue: 0,0:27:35.77,0:27:37.57,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:27:38.57,0:27:39.57,Default,,0,0,0,,Иә
Dialogue: 0,0:27:39.70,0:27:43.57,Default,,0,0,0,,(Автокөлік радиосынан музыка ойналады)
Dialogue: 0,0:28:04.26,0:28:06.26,Default,,0,0,0,,(музыканың соңы)
Dialogue: 0,0:28:07.76,0:28:13.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
