Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:04.92,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:00:09.80,0:00:10.92,Default,,0,0,0,,(қабылдағыш шуы)
Dialogue: 0,0:00:10.63,0:00:13.68,Default,,0,0,0,,Уау! Мен қазірдің өзінде дайынмын
Dialogue: 0,0:00:13.55,0:00:14.55,Default,,0,0,0,,(Трансивер шуы)
Dialogue: 0,0:00:13.80,0:00:16.30,Default,,0,0,0,,Қазіргі уақытта қарау уақытында
Dialogue: 0,0:00:16.43,0:00:17.76,Default,,0,0,0,,Ято ондай Қасиетті Құралды неге сақтап жүр?
Dialogue: 0,0:00:17.89,0:00:20.81,Default,,0,0,0,,Ол жерден бірдеңе көре аласыз ба? Gear?
Dialogue: 0,0:00:21.18,0:00:22.89,Default,,0,0,0,,Мен оны анық көремін
Dialogue: 0,0:00:23.31,0:00:25.60,Default,,0,0,0,,Менің ертеңім!
Dialogue: 0,0:00:25.73,0:00:26.65,Default,,0,0,0,,Хо есік!
Dialogue: 0,0:00:26.94,0:00:28.86,Default,,0,0,0,,Төменге, төменге қараңыз!
Dialogue: 0,0:00:28.98,0:00:32.32,Default,,0,0,0,,Міне, қазына ұйықтап жатыр!
Dialogue: 0,0:00:36.32,0:00:37.41,Default,,0,0,0,,Носа апа
Dialogue: 0,0:00:37.82,0:00:40.04,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:00:40.91,0:00:43.87,Default,,0,0,0,,３ ２ １
Dialogue: 0,0:00:45.58,0:00:47.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:47.96,0:00:50.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:51.21,0:00:52.34,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:56.01,0:00:58.89,Default,,0,0,0,,Уау~
Dialogue: 0,0:01:00.18,0:01:02.06,Default,,0,0,0,,Ха! Мен шыдай алмаймын~
Dialogue: 0,0:01:02.18,0:01:05.19,Default,,0,0,0,,Бұл шу сіздің миыңызды бұзады!
Dialogue: 0,0:01:05.31,0:01:07.98,Default,,0,0,0,,Сәлем! Беріліс өлетін болды, солай емес пе? Бұл жеңіл ойлы Карутама!
Dialogue: 0,0:01:08.11,0:01:10.86,Default,,0,0,0,,Не? Бұл араласатын кәрі ақымақ!
Dialogue: 0,0:01:10.98,0:01:13.49,Default,,0,0,0,,Нашар ма? Мен тізбекті өртеп жіберемін!
Dialogue: 0,0:01:13.61,0:01:16.66,Default,,0,0,0,,Балалар сендер өте тітіркендіргішсіңдер!
Dialogue: 0,0:01:18.66,0:01:20.66,Default,,0,0,0,,Сіз ең қатты дауыссыз
Dialogue: 0,0:01:22.45,0:01:24.50,Default,,0,0,0,,Күрсініңіз... Өтінемін.
Dialogue: 0,0:01:24.79,0:01:29.25,Default,,0,0,0,,Егер бұл жігіт сәтті болса, 20 000 Ed қарызы ештеңе болмайды.
Dialogue: 0,0:01:29.38,0:01:30.75,Default,,0,0,0,,Ол ертең-ақ ауруханадан шығады сияқты—
Dialogue: 0,0:01:31.63,0:01:34.34,Default,,0,0,0,,Сіз казиноға «садақа» жасағаныңыз үшін емес пе?
Dialogue: 0,0:01:34.46,0:01:35.84,Default,,0,0,0,,Неге тоқтамайсың?
Dialogue: 0,0:01:35.97,0:01:40.18,Default,,0,0,0,,Балалар ересектердің романтикасын түсінбейді.
Dialogue: 0,0:01:40.60,0:01:42.93,Default,,0,0,0,,Жоқ, сен ақ аюсың.
Dialogue: 0,0:01:45.39,0:01:47.19,Default,,0,0,0,,Ал мен бала емеспін.
Dialogue: 0,0:01:48.35,0:01:49.48,Default,,0,0,0,,I——
Dialogue: 0,0:01:51.65,0:01:53.40,Default,,0,0,0,,«Кәсіби»
Dialogue: 0,0:01:53.82,0:01:54.61,Default,,0,0,0,,Носа апа
Dialogue: 0,0:01:54.74,0:01:57.40,Default,,0,0,0,,Жарайды, бұл туралы не деуге болады?
Dialogue: 0,0:01:57.70,0:02:00.37,Default,,0,0,0,,３ ２ １
Dialogue: 0,0:02:00.49,0:02:01.41,Default,,0,0,0,,Жүр!
Dialogue: 0,0:03:17.61,0:03:18.82,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:20.40,0:03:21.70,Default,,0,0,0,,(ажыратқыштың өшіп қалған дыбысы)
Dialogue: 0,0:03:21.82,0:03:26.03,Default,,0,0,0,,(сиренаның дыбысы мен дыбысы)
Dialogue: 0,0:03:22.11,0:03:23.03,Default,,0,0,0,,Ах
Dialogue: 0,0:03:28.62,0:03:30.25,Default,,0,0,0,,Көп емес, бірақ… міне.
Dialogue: 0,0:03:30.79,0:03:33.50,Default,,0,0,0,,Жаным шуылдап тұр!
Dialogue: 0,0:03:33.63,0:03:35.46,Default,,0,0,0,,Алға!
Dialogue: 0,0:03:35.59,0:03:36.96,Default,,0,0,0,,(шинаның үйкеліс шуы)
Dialogue: 0,0:03:43.30,0:03:44.59,Default,,0,0,0,,(Қатты қозғалтқыш шуы)
Dialogue: 0,0:03:47.43,0:03:48.64,Default,,0,0,0,,Жүр, жүр!
Dialogue: 0,0:03:48.77,0:03:49.89,Default,,0,0,0,,Беріліс туралы не деуге болады?
Dialogue: 0,0:03:50.02,0:03:52.81,Default,,0,0,0,,Екеуміздің ұсталғанымыз жақсы.
Dialogue: 0,0:03:52.94,0:03:55.36,Default,,0,0,0,,Мені тастап кеткің келе ме? Сайт
Dialogue: 0,0:03:55.48,0:03:56.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:56.57,0:03:58.94,Default,,0,0,0,,Ааа!
Dialogue: 0,0:03:59.48,0:04:00.49,Default,,0,0,0,,Беріліс!
Dialogue: 0,0:04:00.78,0:04:03.86,Default,,0,0,0,,Мен сенің жақсы болатыныңа сендім.
Dialogue: 0,0:04:03.99,0:04:05.87,Default,,0,0,0,,Теме бірден өлуі керек.
Dialogue: 0,0:04:06.16,0:04:07.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:08.33,0:04:11.66,Default,,0,0,0,,Бұрын! бұрын! бұрын! бұрын! бұрын! бұрын! бұрын!
Dialogue: 0,0:04:10.25,0:04:11.66,Default,,0,0,0,,Эй!
Dialogue: 0,0:04:12.54,0:04:17.09,Default,,0,0,0,,(шиналар үйкелісінің шуы және полиция көлігінің сиренасы)
Dialogue: 0,0:04:31.81,0:04:33.19,Default,,0,0,0,,Жұмыс аяқталды
Dialogue: 0,0:04:33.31,0:04:34.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:35.02,0:04:36.90,Default,,0,0,0,,Ха! Ракушо
Dialogue: 0,0:04:37.02,0:04:37.98,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:04:38.11,0:04:40.36,Default,,0,0,0,,Енді сен байсың! Хехе
Dialogue: 0,0:04:40.48,0:04:43.40,Default,,0,0,0,,Біз не істеуіміз керек, Gear? Сіз өзіңіз қалаған нәрсені жүзеге асыра аласыз.
Dialogue: 0,0:04:43.78,0:04:45.53,Default,,0,0,0,,Егер сіз оны жүзеге асырғыңыз келсе
Dialogue: 0,0:04:47.57,0:04:48.41,Default,,0,0,0,,О
Dialogue: 0,0:04:50.04,0:04:51.37,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:04:52.00,0:04:54.66,Default,,0,0,0,,♪～
Dialogue: 0,0:06:17.25,0:06:19.25,Default,,0,0,0,,～♪
Dialogue: 0,0:06:26.17,0:06:27.92,Default,,0,0,0,,Сағат 8 болды!
Dialogue: 0,0:06:28.34,0:06:31.09,Default,,0,0,0,,Қош бол түнде, Қайырлы таң!
Dialogue: 0,0:06:31.22,0:06:33.76,Default,,0,0,0,,Бүгін де жарқыраған күн болады деп сенемін!
Dialogue: 0,0:06:34.26,0:06:35.27,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:06:38.60,0:06:40.52,Default,,0,0,0,,Уау~
Dialogue: 0,0:06:40.98,0:06:43.23,Default,,0,0,0,,(хорылдаған дыбыс)
Dialogue: 0,0:06:51.16,0:06:52.49,Default,,0,0,0,,(Жануарлардың дыбыстары)
Dialogue: 0,0:06:59.00,0:07:00.08,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:00.92,0:07:07.59,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:07:02.88,0:07:03.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:05.00,0:07:07.59,Default,,0,0,0,,Мен мұндайды бұрын-соңды көрген емеспін.
Dialogue: 0,0:07:08.92,0:07:11.51,Default,,0,0,0,,Жарайды, бүгінгі күн осы.
Dialogue: 0,0:07:27.36,0:07:28.74,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:07:28.86,0:07:30.49,Default,,0,0,0,,(Кері санақ дыбысы)
Dialogue: 0,0:07:30.61,0:07:31.57,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:07:31.70,0:07:33.28,Default,,0,0,0,,Сағат 5.
Dialogue: 0,0:07:33.70,0:07:37.41,Default,,0,0,0,,Күнге қайырлы түн, айға сәлем!
Dialogue: 0,0:07:37.54,0:07:40.71,Default,,0,0,0,,Ертең де қызықты күн болады деп сенемін!
Dialogue: 0,0:07:41.21,0:07:42.21,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:07:42.33,0:07:46.63,Default,,0,0,0,,(Жұмысшылардың шуы)
Dialogue: 0,0:07:44.88,0:07:45.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:50.09,0:07:51.68,Default,,0,0,0,,Иә Келесі
Dialogue: 0,0:07:52.18,0:07:54.89,Default,,0,0,0,,Бүгінгі сыйақы – 820 Ed.
Dialogue: 0,0:07:55.01,0:07:57.43,Default,,0,0,0,,Ах... тағы бір итеру!
Dialogue: 0,0:07:57.56,0:07:58.89,Default,,0,0,0,,Менің шағымданатын ештеңем жоқ.
Dialogue: 0,0:07:59.02,0:08:00.56,Default,,0,0,0,,Ертеңгі күнге де сәттілік~
Dialogue: 0,0:08:00.68,0:08:01.77,Default,,0,0,0,,Өзіңді сиқырлап, ұйықта.
Dialogue: 0,0:08:01.89,0:08:04.19,Default,,0,0,0,,...
Dialogue: 0,0:08:03.40,0:08:04.19,Default,,0,0,0,,Ах~
Dialogue: 0,0:08:04.31,0:08:06.23,Default,,0,0,0,,Бүгінгі «бұл» қалай?
Dialogue: 0,0:08:06.36,0:08:08.73,Default,,0,0,0,,Перт: Мен ішімдікке қызықпаймын.
Dialogue: 0,0:08:06.86,0:08:07.86,Default,,0,0,0,,Ugggggg
Dialogue: 0,0:08:08.86,0:08:10.44,Default,,0,0,0,,Эй~ Жоқ~
Dialogue: 0,0:08:10.57,0:08:12.40,Default,,0,0,0,,Эй, мен саған айттым ғой, солай ма? Фуфун
Dialogue: 0,0:08:12.53,0:08:16.24,Default,,0,0,0,,Ол суық сырадан гөрі қала сыртындағы нәрселерге көбірек қызығатын оғаш адам.
Dialogue: 0,0:08:16.37,0:08:18.03,Default,,0,0,0,,Қалай болғанда да, сіз кең даладасыз.
Dialogue: 0,0:08:17.20,0:08:21.08,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:08:18.16,0:08:19.54,Default,,0,0,0,,Тіпті темірді де ерітетін қышқыл көлі
Dialogue: 0,0:08:19.66,0:08:21.45,Default,,0,0,0,,Тіпті келесі қала жүздеген шақырым жерде.
Dialogue: 0,0:08:21.58,0:08:23.83,Default,,0,0,0,,Қаланы осылай тастап кету өз-өзіне қол жұмсау болар еді.
Dialogue: 0,0:08:23.96,0:08:28.13,Default,,0,0,0,,Мұнда ыңғайлы жұмыс істеу және дәмді саке ішу - бұл...
Dialogue: 0,0:08:25.58,0:08:28.13,Default,,0,0,0,,Ууууууууууу! Хмм...
Dialogue: 0,0:08:28.50,0:08:30.96,Default,,0,0,0,,Бұл өмірдің нағыз рахаты.
Dialogue: 0,0:08:31.09,0:08:32.05,Default,,0,0,0,,Хмм!
Dialogue: 0,0:08:31.72,0:08:32.63,Default,,0,0,0,,Ой
Dialogue: 0,0:08:32.17,0:08:35.30,Default,,0,0,0,,Мас болып, мас бол! Бол
Dialogue: 0,0:08:35.64,0:08:38.18,Default,,0,0,0,,Бұл трафиктің ең жақсы жолы!
Dialogue: 0,0:08:38.30,0:08:40.31,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:08:40.43,0:08:46.23,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:50.15,0:08:52.69,Default,,0,0,0,,Ұстаз, мен бірден тамақ дайындаймын.
Dialogue: 0,0:08:52.82,0:08:54.20,Default,,0,0,0,,40 ұпай
Dialogue: 0,0:08:54.32,0:08:55.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.70,0:08:58.91,Default,,0,0,0,,Болттар босап, сымдар таза.
Dialogue: 0,0:08:59.45,0:09:01.58,Default,,0,0,0,,Мен толыққанды жұмысым бар деп айта алмаймын.
Dialogue: 0,0:09:01.91,0:09:04.58,Default,,0,0,0,,Осымен мен әлі де сізге дүкенді қалдыра алмаймын.
Dialogue: 0,0:09:05.04,0:09:07.21,Default,,0,0,0,,Цк, сен неге ояусың?
Dialogue: 0,0:09:07.33,0:09:10.09,Default,,0,0,0,,Ұйықта! Сіз дәрі қабылдадыңыз ба?
Dialogue: 0,0:09:10.38,0:09:13.09,Default,,0,0,0,,Медицина? Бәрінен де бұл Боруто!
Dialogue: 0,0:09:13.42,0:09:15.09,Default,,0,0,0,,Ол Борутодан да ауырады!
Dialogue: 0,0:09:15.22,0:09:17.51,Default,,0,0,0,,Аурулар өздігінен жазылады!
Dialogue: 0,0:09:17.64,0:09:21.51,Default,,0,0,0,,Бірақ болт өздігінен тартылмайды, ақымақ.
Dialogue: 0,0:09:21.64,0:09:24.77,Default,,0,0,0,,«Қаланың сыртына шығыңыз» сияқты сөздерді айтуға уақытыңыз болмаса
Dialogue: 0,0:09:24.89,0:09:26.85,Default,,0,0,0,,Өнеріңізді жарқыратыңыз! Бұл...
Dialogue: 0,0:09:25.02,0:09:26.02,Default,,0,0,0,,Не!
Dialogue: 0,0:09:27.19,0:09:29.52,Default,,0,0,0,,(жөтел дыбысы)
Dialogue: 0,0:09:27.19,0:09:28.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:29.65,0:09:31.48,Default,,0,0,0,,Босс аааа!
Dialogue: 0,0:09:31.61,0:09:33.90,Default,,0,0,0,,(шаңсорғыш дыбысы)
Dialogue: 0,0:09:34.53,0:09:35.53,Default,,0,0,0,,Таку
Dialogue: 0,0:09:36.28,0:09:37.99,Default,,0,0,0,,Өзіңізге қамқорлық жасамаңыз
Dialogue: 0,0:09:49.50,0:09:51.29,Default,,0,0,0,,Хахаха
Dialogue: 0,0:09:54.38,0:09:56.67,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:09:58.80,0:10:00.76,Default,,0,0,0,,Суық және жақсы!
Dialogue: 0,0:10:00.89,0:10:01.85,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:10:01.97,0:10:03.68,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:10:03.81,0:10:07.69,Default,,0,0,0,,Түсіндім! Түсіндім! Түсіндім!
Dialogue: 0,0:10:07.81,0:10:08.81,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:10:09.23,0:10:10.86,Default,,0,0,0,,Апай әдеттегідей
Dialogue: 0,0:10:10.98,0:10:12.86,Default,,0,0,0,,-Иә, иә, гриль еті -Хихихи
Dialogue: 0,0:10:14.32,0:10:16.86,Default,,0,0,0,,Не? Мен бұлай көп сұраған емеспін.
Dialogue: 0,0:10:17.53,0:10:19.74,Default,,0,0,0,,Мен осылай сезінемін
Dialogue: 0,0:10:19.86,0:10:24.87,Default,,0,0,0,,Әрқашан аш болсаң да, бір ғана бөтелкеге тапсырыс бергенің өкінішті.
Dialogue: 0,0:10:25.33,0:10:27.87,Default,,0,0,0,,Оқта-текте батамды беремін.
Dialogue: 0,0:10:28.25,0:10:29.87,Default,,0,0,0,,А... иә
Dialogue: 0,0:10:30.75,0:10:32.17,Default,,0,0,0,,Бұл тапсырыс берілген элемент.
Dialogue: 0,0:10:32.29,0:10:34.17,Default,,0,0,0,,Не? Бұл ма?
Dialogue: 0,0:10:34.30,0:10:37.01,Default,,0,0,0,,Соңғы кездері барлық жерде дәрі-дәрмек тапшылығы байқалады.
Dialogue: 0,0:10:37.30,0:10:39.34,Default,,0,0,0,,Оның үстіне баға тез өсуде.
Dialogue: 0,0:10:39.76,0:10:43.85,Default,,0,0,0,,Кейбір тиімдірек, бірақ олар кем дегенде 500 000 ED тұрады.
Dialogue: 0,0:10:44.97,0:10:46.47,Default,,0,0,0,,суық тигізесің.
Dialogue: 0,0:10:52.77,0:10:55.15,Default,,0,0,0,,Эй, бұл беріліс!
Dialogue: 0,0:10:55.48,0:10:59.65,Default,,0,0,0,,Біз бір-бірімізді осындай жерде кездестіруге өте жақынбыз!
Dialogue: 0,0:10:59.95,0:11:01.53,Default,,0,0,0,,Сіз оны покерде жоғалтып алдыңыз, солай ма?
Dialogue: 0,0:11:01.91,0:11:04.74,Default,,0,0,0,,Blackjack бүгін осында.
Dialogue: 0,0:11:04.87,0:11:07.16,Default,,0,0,0,,Маған сәл ғана қарыз беріңізші!
Dialogue: 0,0:11:07.29,0:11:11.08,Default,,0,0,0,,Хмм, өтінемін, өтінемін, өтінемін
Dialogue: 0,0:11:07.70,0:11:11.08,Default,,0,0,0,,Соңғы рет және оған дейінгі уақытта жұмыс істемеді.
Dialogue: 0,0:11:11.75,0:11:14.50,Default,,0,0,0,,Бұрын жеңген.
Dialogue: 0,0:11:14.63,0:11:16.84,Default,,0,0,0,,Оны жақсырақ нәрсе үшін пайдаланыңыз.
Dialogue: 0,0:11:16.96,0:11:19.01,Default,,0,0,0,,Арх! Уағыз айтуды доғар!
Dialogue: 0,0:11:19.13,0:11:20.09,Default,,0,0,0,,-Ах! -Аа...
Dialogue: 0,0:11:20.22,0:11:22.51,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:11:26.93,0:11:32.65,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:31.81,0:11:32.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.77,0:11:33.61,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:33.73,0:11:37.44,Default,,0,0,0,,Мына қарғыс атқыр аю! Менің гриль етім...
Dialogue: 0,0:11:37.57,0:11:39.57,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:11:40.32,0:11:44.20,Default,,0,0,0,,Менің гриль етім Уау... Ой...
Dialogue: 0,0:11:44.66,0:11:45.66,Default,,0,0,0,,-Йо -Ах!
Dialogue: 0,0:11:46.12,0:11:47.20,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:49.45,0:11:53.63,Default,,0,0,0,,Сәлем! Жарайсың менің грильге... Ой?
Dialogue: 0,0:11:51.62,0:11:53.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:54.54,0:11:56.09,Default,,0,0,0,,Мен асығыс едім
Dialogue: 0,0:11:56.79,0:11:59.88,Default,,0,0,0,,Я... Яки~ Яки...
Dialogue: 0,0:12:00.01,0:12:00.84,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:12:01.34,0:12:03.59,Default,,0,0,0,,Мистер Гир, солай ма?
Dialogue: 0,0:12:03.80,0:12:04.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.22,0:12:08.10,Default,,0,0,0,,Мен сені іздедім, а?
Dialogue: 0,0:12:08.22,0:12:09.64,Default,,0,0,0,,О...
Dialogue: 0,0:12:23.70,0:12:27.41,Default,,0,0,0,,Мына қораптың ішінде әкемнің естелігі бар.
Dialogue: 0,0:12:28.03,0:12:30.29,Default,,0,0,0,,Бұл адам менің әкемнің досы.
Dialogue: 0,0:12:30.66,0:12:34.00,Default,,0,0,0,,Мен Тенжин Тенжин Поледе мекеме меңгерушісі болған әкемнің қол астындағы қызметкері болдым.
Dialogue: 0,0:12:34.92,0:12:37.25,Default,,0,0,0,,Біз көптен бері доспыз.
Dialogue: 0,0:12:38.21,0:12:41.55,Default,,0,0,0,,Әкем қайтыс болып, мен мекеме директоры болған кезде.
Dialogue: 0,0:12:41.67,0:12:43.84,Default,,0,0,0,,Өз көзқарасын өзгертті.
Dialogue: 0,0:12:44.30,0:12:49.68,Default,,0,0,0,,Тәкаппарлық танытып, бұл затты да оның көзі тірісінде берген уәдесі деп зорлықпен айтқан.
Dialogue: 0,0:12:50.39,0:12:54.69,Default,,0,0,0,,Бұл әкемдегі ең қымбат нәрсе болды.
Dialogue: 0,0:12:55.90,0:12:58.90,Default,,0,0,0,,Өзіңіз білетін адамнан әділетсіз алынған заттар.
Dialogue: 0,0:12:57.94,0:12:58.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:59.02,0:13:01.86,Default,,0,0,0,,Мен сіз заттарды қайтару үшін жұмыс істеп жатырсыз деп естідім.
Dialogue: 0,0:13:01.99,0:13:05.20,Default,,0,0,0,,Жарайды, мұны маған кім айтқанын білмеймін.
Dialogue: 0,0:13:05.53,0:13:07.45,Default,,0,0,0,,Бұл қандай да бір қателік емес пе?
Dialogue: 0,0:13:07.70,0:13:09.78,Default,,0,0,0,,Дұрыс, бұл жай ғана қоқыс дүкені.
Dialogue: 0,0:13:10.37,0:13:14.54,Default,,0,0,0,,Анамсыз жалғыз отбасым әкем болды.
Dialogue: 0,0:13:15.25,0:13:19.38,Default,,0,0,0,,Екеуміз бір-бірімізді қолдап бірге тұрдық.
Dialogue: 0,0:13:24.26,0:13:28.01,Default,,0,0,0,,Мен әкемнің естелігін қайтарғым келеді.
Dialogue: 0,0:13:29.51,0:13:30.51,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:13:31.35,0:13:32.35,Default,,0,0,0,,Әй
Dialogue: 0,0:13:32.85,0:13:34.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:33.47,0:13:35.14,Default,,0,0,0,,(Тұншығу дыбысы)
Dialogue: 0,0:13:34.31,0:13:35.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:35.27,0:13:37.48,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,0:13:38.35,0:13:40.98,Default,,0,0,0,,Сіз оны қабылдағыңыз келмейді деп ойлаймын.
Dialogue: 0,0:13:41.27,0:13:43.19,Default,,0,0,0,,Өйткені бұл аянышты.
Dialogue: 0,0:13:43.32,0:13:46.03,Default,,0,0,0,,Мұқият қара, ақымақ! Тым әдемі
Dialogue: 0,0:13:46.15,0:13:47.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:47.24,0:13:51.95,Default,,0,0,0,,Тыңда, сұлудан жақсылық сұрау жақсылық емес.
Dialogue: 0,0:13:52.08,0:13:55.16,Default,,0,0,0,,Сол себепті өткенде көп қиналдым.
Dialogue: 0,0:13:55.50,0:13:57.67,Default,,0,0,0,,Бұрын Кума 4 жаста еді.
Dialogue: 0,0:13:58.21,0:14:01.50,Default,,0,0,0,,Уф, 4 пен 40 арасында ешқандай айырмашылық жоқ.
Dialogue: 0,0:14:01.63,0:14:04.01,Default,,0,0,0,,Жарайды, бұл жолы жоқ!
Dialogue: 0,0:14:04.13,0:14:06.42,Default,,0,0,0,,Команда ретінде біз мұны істей аламыз.
Dialogue: 0,0:14:06.72,0:14:08.63,Default,,0,0,0,,Ей, сен үнемі осылай айтасың, солай ма?
Dialogue: 0,0:14:08.76,0:14:11.51,Default,,0,0,0,,Команда емес, «іскерлік серіктес»
Dialogue: 0,0:14:11.64,0:14:14.93,Default,,0,0,0,,Бұл тек ақшамен байланыстыратын керемет қарым-қатынас.
Dialogue: 0,0:14:15.22,0:14:17.44,Default,,0,0,0,,Қауіпті иісі бар сұраулар
Dialogue: 0,0:14:17.56,0:14:18.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:18.77,0:14:20.44,Default,,0,0,0,,Өте қауіпті
Dialogue: 0,0:14:20.56,0:14:21.44,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:21.56,0:14:22.98,Default,,0,0,0,,Аз
Dialogue: 0,0:14:24.23,0:14:29.20,Default,,0,0,0,,Аванстық төлем шамамен 200 000 ED құрайды, бірақ ол сәтті болса, мен соманы екі есе көбейтемін.
Dialogue: 0,0:14:36.50,0:14:38.16,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:14:45.63,0:14:48.30,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:14:54.56,0:14:56.27,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:15:00.10,0:15:03.44,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:15:18.54,0:15:21.87,Default,,0,0,0,,Үлкен Үштікті айтпағанда, олар одан да мықты—
Dialogue: 0,0:15:22.00,0:15:23.88,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:15:24.54,0:15:26.88,Default,,0,0,0,,Біз сіздің айтқаныңызды тыңдаймыз.
Dialogue: 0,0:15:27.00,0:15:32.09,Default,,0,0,0,,Егер біз қамтамасыз ете алатын нәрсе болса, бізге хабарлаңыз.
Dialogue: 0,0:15:39.02,0:15:41.81,Default,,0,0,0,,(шаңсорғыш дыбысы)
Dialogue: 0,0:15:42.35,0:15:44.86,Default,,0,0,0,,Хуааа~
Dialogue: 0,0:15:45.40,0:15:49.69,Default,,0,0,0,,Уф, сейфтің кілті?
Dialogue: 0,0:15:50.19,0:15:54.20,Default,,0,0,0,,Егер бұл сейф болса, оны терминалға енгізу арқылы ашуға болады.
Dialogue: 0,0:15:51.24,0:15:53.28,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:15:54.32,0:15:55.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:55.83,0:15:57.95,Default,,0,0,0,,Әкем осылай пайдаланатын.
Dialogue: 0,0:15:58.33,0:16:01.08,Default,,0,0,0,,Е... аа, рахмет
Dialogue: 0,0:16:01.50,0:16:05.71,Default,,0,0,0,,Маған ұнайды... не? Ол адам?
Dialogue: 0,0:16:02.17,0:16:03.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:07.21,0:16:08.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:09.01,0:16:12.22,Default,,0,0,0,,«Жүгіргіш жол» Бұл әйгілі, солай емес пе?
Dialogue: 0,0:16:12.63,0:16:18.22,Default,,0,0,0,,10 жыл бұрын Үкіметтен қыруар ақша ұрлап, елдің түкпір-түкпірінен қуған ірі қылмыскер.
Dialogue: 0,0:16:18.60,0:16:22.23,Default,,0,0,0,,Иә, бұл менің арманым.
Dialogue: 0,0:16:22.64,0:16:25.10,Default,,0,0,0,,Таңдану қылмыс па?
Dialogue: 0,0:16:25.23,0:16:27.61,Default,,0,0,0,,Бірақ ешкім қуып жете алмады.
Dialogue: 0,0:16:27.73,0:16:28.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:28.69,0:16:33.24,Default,,0,0,0,,Ешбір қарсыласқа ілінбей соңына дейін жүгіруді жалғастырдым.
Dialogue: 0,0:16:34.20,0:16:36.82,Default,,0,0,0,,Сол көкжиектен тыс
Dialogue: 0,0:16:37.41,0:16:40.41,Default,,0,0,0,,Ол айдалада өлді деген қауесет бар.
Dialogue: 0,0:16:40.54,0:16:42.96,Default,,0,0,0,,Жұмақтай жерде екенсің дейді.
Dialogue: 0,0:16:43.87,0:16:48.54,Default,,0,0,0,,Ешкім жете алмайтын жерге барғаным анық.
Dialogue: 0,0:16:49.71,0:16:53.63,Default,,0,0,0,,Мен мұны қызғандым.
Dialogue: 0,0:16:53.93,0:16:58.80,Default,,0,0,0,,Мен туғаннан бері бір ғана аспанды көрдім.
Dialogue: 0,0:17:00.31,0:17:01.47,Default,,0,0,0,,Барлығы осындай
Dialogue: 0,0:17:01.60,0:17:06.52,Default,,0,0,0,,Қалада туып, қалада өлген, бұл жерде қалыпты жағдай.
Dialogue: 0,0:17:06.65,0:17:10.40,Default,,0,0,0,,Егер сізге парасаттылық ұнаса, сіз мұны істемес едіңіз.
Dialogue: 0,0:17:11.23,0:17:14.70,Default,,0,0,0,,Бір күні сіз үшін маңызды адам аурудан айыққанда,
Dialogue: 0,0:17:14.82,0:17:15.99,Default,,0,0,0,,Онда барыңыз
Dialogue: 0,0:17:16.61,0:17:22.50,Default,,0,0,0,,Сол көкжиектен ары қарай не жатқанын өз көзіңізбен көріңіз
Dialogue: 0,0:17:30.04,0:17:31.75,Default,,0,0,0,,Мияу
Dialogue: 0,0:17:34.42,0:17:36.18,Default,,0,0,0,,Жұмыс уақыты келді
Dialogue: 0,0:17:37.93,0:17:39.76,Default,,0,0,0,,Мүмкін, саған кішкене сабақ беруім керек шығар.
Dialogue: 0,0:17:40.39,0:17:41.68,Default,,0,0,0,,Нұсқау бойынша
Dialogue: 0,0:17:48.52,0:17:49.52,Default,,0,0,0,,(бұрғылау дыбысы)
Dialogue: 0,0:18:14.05,0:18:15.38,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:16.97,0:18:18.26,Default,,0,0,0,,(ажыратқыштың өшіп қалу дыбысы)
Dialogue: 0,0:18:18.34,0:18:20.09,Default,,0,0,0,,(дыбыс және сирена дыбыстары)
Dialogue: 0,0:18:18.38,0:18:19.59,Default,,0,0,0,,Ах
Dialogue: 0,0:18:20.22,0:18:21.26,Default,,0,0,0,,Ах
Dialogue: 0,0:18:20.22,0:18:22.64,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:18:21.64,0:18:22.64,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:18:25.43,0:18:26.89,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:18:30.69,0:18:33.02,Default,,0,0,0,,(үздіксіз шырылдайтын оқтар)
Dialogue: 0,0:18:42.83,0:18:43.83,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:50.37,0:18:52.38,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:18:52.50,0:18:53.92,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:18:55.30,0:18:56.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:56.71,0:18:57.72,Default,,0,0,0,,Аю!
Dialogue: 0,0:18:58.26,0:18:59.26,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:01.55,0:19:03.39,Default,,0,0,0,,(Қатты қозғалтқыш шуы)
Dialogue: 0,0:19:14.11,0:19:16.94,Default,,0,0,0,,Ахахха! Мен сенің қашуыңа жол бермеймін!
Dialogue: 0,0:19:19.49,0:19:20.82,Default,,0,0,0,,Не істеуіміз керек, Gear?
Dialogue: 0,0:19:20.95,0:19:21.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:23.82,0:19:25.12,Default,,0,0,0,,(Музыканың дыбыс деңгейін арттыру)
Dialogue: 0,0:19:25.24,0:19:26.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:29.79,0:19:31.08,Default,,0,0,0,,құрлық арқылы Пәкістанға бет алған
Dialogue: 0,0:19:31.21,0:19:32.75,Default,,0,0,0,,(шинаның үйкеліс шуы)
Dialogue: 0,0:19:39.97,0:19:42.72,Default,,0,0,0,,Ұрлағаныңызды қайтарыңыз.
Dialogue: 0,0:20:28.76,0:20:31.02,Default,,0,0,0,,(Полиция көлігінің сиренасының дыбысы)
Dialogue: 0,0:20:33.48,0:20:35.27,Default,,0,0,0,,(шинаның үйкеліс шуы)
Dialogue: 0,0:20:41.28,0:20:45.87,Default,,0,0,0,,Уау~
Dialogue: 0,0:20:50.62,0:20:52.87,Default,,0,0,0,,(Клаксон қоңырау шалады)
Dialogue: 0,0:20:53.75,0:20:55.71,Default,,0,0,0,,Бұл не? Эй!
Dialogue: 0,0:21:07.64,0:21:08.68,Default,,0,0,0,,О...
Dialogue: 0,0:21:08.80,0:21:10.31,Default,,0,0,0,,Беріліс! Бұған дейін!
Dialogue: 0,0:21:10.43,0:21:11.39,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:11.52,0:21:13.31,Default,,0,0,0,,Тоқта! тоқта!
Dialogue: 0,0:21:19.94,0:21:21.40,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:21:23.36,0:21:29.24,Default,,0,0,0,,Сол көкжиектен ары қарай не жатқанын өз көзіңізбен көріңіз
Dialogue: 0,0:21:32.33,0:21:33.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:40.38,0:21:44.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:46.18,0:21:47.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:47.18,0:21:53.06,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,0:21:53.89,0:21:54.89,Default,,0,0,0,,Аһ!
Dialogue: 0,0:22:00.69,0:22:02.57,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:22:02.69,0:22:03.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:10.57,0:22:11.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:16.87,0:22:18.33,Default,,0,0,0,,Қазір асығыңыз!
Dialogue: 0,0:22:18.46,0:22:20.33,Default,,0,0,0,,Көп емес, бірақ… міне.
Dialogue: 0,0:22:26.09,0:22:27.63,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:22:28.84,0:22:31.35,Default,,0,0,0,,Ия, мен қашып үлгердім!
Dialogue: 0,0:22:28.84,0:22:34.60,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:22:31.47,0:22:34.60,Default,,0,0,0,,Саяси адамдар маған бәрібір! Хехе
Dialogue: 0,0:22:34.72,0:22:37.06,Default,,0,0,0,,Теме ештеңе істемеді, солай ма?
Dialogue: 0,0:22:34.72,0:22:38.85,Default,,0,0,0,,Уау! Хахахаха
Dialogue: 0,0:22:37.43,0:22:38.85,Default,,0,0,0,,Жақсысың ба Gear?
Dialogue: 0,0:22:39.31,0:22:44.48,Default,,0,0,0,,Бұл өте жаман болды~ Бірақ мен бұл жолы да үлгердім.
Dialogue: 0,0:22:44.61,0:22:47.32,Default,,0,0,0,,Иә, олжаны тексерейік.
Dialogue: 0,0:22:47.65,0:22:49.99,Default,,0,0,0,,Мұнда қазына бар~
Dialogue: 0,0:22:50.11,0:22:51.78,Default,,0,0,0,,Эй, рұқсатсыз ашпа.
Dialogue: 0,0:22:51.91,0:22:52.83,Default,,0,0,0,,Ашық
Dialogue: 0,0:22:54.08,0:22:55.49,Default,,0,0,0,,Түсіндім~!
Dialogue: 0,0:22:55.62,0:22:56.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:22:57.29,0:22:59.33,Default,,0,0,0,,Бұл естелік пе?
Dialogue: 0,0:22:59.96,0:23:01.83,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:23:02.08,0:23:04.00,Default,,0,0,0,,Қарғыс атқыр, мен оны сағындым.
Dialogue: 0,0:23:04.84,0:23:08.34,Default,,0,0,0,,Нии-сан, бұл не болды?
Dialogue: 0,0:23:09.17,0:23:13.85,Default,,0,0,0,,Олардың кейбіреулері осы дүниеге Ізгі хабарды жеткізеді
Dialogue: 0,0:23:14.22,0:23:17.22,Default,,0,0,0,,Ішінде «Тәңір жыры» жатыр дейді.
Dialogue: 0,0:23:23.73,0:23:24.86,Default,,0,0,0,,(айналған мұздың дыбысы)
Dialogue: 0,0:23:26.44,0:23:28.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:27.57,0:23:28.49,Default,,0,0,0,,(әйнек түсіру дыбысы)
Dialogue: 0,0:23:28.99,0:23:31.86,Default,,0,0,0,,Қандай кездейсоқ кездесу, Хиёри
Dialogue: 0,0:23:33.70,0:23:35.16,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:23:38.04,0:23:39.33,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:23:41.08,0:23:43.75,Default,,0,0,0,,Қандарымен және бастарымен
Dialogue: 0,0:23:44.92,0:23:47.25,Default,,0,0,0,,♪～
Dialogue: 0,0:25:08.25,0:25:12.63,Default,,0,0,0,,～♪
