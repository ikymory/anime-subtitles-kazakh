Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:04.33,Default,,0,0,0,,Бізбен не істеуді жоспарлайсыз?
Dialogue: 0,0:00:06.50,0:00:08.38,Default,,0,0,0,,Енді біз кім екенімізді білеміз
Dialogue: 0,0:00:08.50,0:00:10.38,Default,,0,0,0,,Үйге жай бара алмаймын
Dialogue: 0,0:00:10.84,0:00:12.05,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:00:12.17,0:00:14.09,Default,,0,0,0,,-Бастық-(Бас Линь) Ах.
Dialogue: 0,0:00:14.47,0:00:16.35,Default,,0,0,0,,Мылтығыңызды түсіріңіз.
Dialogue: 0,0:00:16.76,0:00:17.60,Default,,0,0,0,,Нұх
Dialogue: 0,0:00:23.35,0:00:26.73,Default,,0,0,0,,(«Роботтан ағып жатқан «Готча Самба»)
Dialogue: 0,0:00:30.11,0:00:31.36,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:31.61,0:00:34.53,Default,,0,0,0,,Қажетті басты кілт осында.
Dialogue: 0,0:00:35.20,0:00:37.03,Default,,0,0,0,,Оларға рахмет
Dialogue: 0,0:00:37.74,0:00:39.95,Default,,0,0,0,,Сіз не істейсіз, бастық?
Dialogue: 0,0:00:40.08,0:00:41.87,Default,,0,0,0,,(Музыканың соңы)
Dialogue: 0,0:00:45.54,0:00:47.46,Default,,0,0,0,,Сол бейбақ
Dialogue: 0,0:00:47.75,0:00:50.46,Default,,0,0,0,,Өз көзқарасыңызды өзгертіңіз!
Dialogue: 0,0:00:51.05,0:00:52.67,Default,,0,0,0,,-Сәлем? Ой... -Кешіріңіз.
Dialogue: 0,0:00:53.26,0:00:55.80,Default,,0,0,0,,10 жыл бұрын бізге қатты соққы болды.
Dialogue: 0,0:00:55.93,0:01:01.47,Default,,0,0,0,,Жолдастардың саны азайып, іс-әрекетіміздің ауқымы тарылып, тұншығудың алдында тұрмыз.
Dialogue: 0,0:01:02.14,0:01:04.48,Default,,0,0,0,,Бұл Қарсыласудың қазіргі жағдайы.
Dialogue: 0,0:01:06.85,0:01:08.94,Default,,0,0,0,,Мылтықты сізге қаратқаным үшін кешірім сұраймын.
Dialogue: 0,0:01:10.52,0:01:12.11,Default,,0,0,0,,Соңғы сәлем—әділетті қоғам үшін құрбандық.
Dialogue: 0,0:01:13.19,0:01:17.36,Default,,0,0,0,,Бірақ біз осы операцияға барлығын салып жатырмыз.
Dialogue: 0,0:01:17.61,0:01:19.83,Default,,0,0,0,,Дүниені дұрыс өзгерту
Dialogue: 0,0:01:20.74,0:01:25.62,Default,,0,0,0,,Өте құпия мемлекеттік деректерді алу үшін осы жерде негізгі кілтті пайдаланыңыз.
Dialogue: 0,0:01:26.29,0:01:31.38,Default,,0,0,0,,Дегенмен, біз астаналық адамдар ДНҚ чиптері арқылы басқарылады.
Dialogue: 0,0:01:31.67,0:01:34.80,Default,,0,0,0,,Ешкім орталық мемлекеттік мекемелерге рұқсатсыз кіре алмайды.
Dialogue: 0,0:01:35.63,0:01:40.26,Default,,0,0,0,,Тек сіз сияқты бөгде адамдар басып алады.
Dialogue: 0,0:01:41.18,0:01:44.89,Default,,0,0,0,,Бастапқыда Нұх мұны жалғыз жасауды жоспарлаған.
Dialogue: 0,0:01:45.64,0:01:50.69,Default,,0,0,0,,Мен де сіздердің ынтымақтастықтарыңызды сұраймын.
Dialogue: 0,0:01:53.15,0:01:54.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:56.65,0:01:59.32,Default,,0,0,0,,♪～
Dialogue: 0,0:03:21.74,0:03:23.57,Default,,0,0,0,,～♪
Dialogue: 0,0:03:26.91,0:03:29.87,Default,,0,0,0,,Ай!
Dialogue: 0,0:03:30.66,0:03:35.63,Default,,0,0,0,,Эй, біз неге казиноға бармаймыз? Қарқынды өзгерту үшін тез дем алыңыз
Dialogue: 0,0:03:35.75,0:03:37.88,Default,,0,0,0,,Мен көптен бері бармаған дүкен бар...
Dialogue: 0,0:03:38.00,0:03:38.96,Default,,0,0,0,,Nga!
Dialogue: 0,0:03:38.00,0:03:41.01,Default,,0,0,0,,Тория! Сен ақымақ аю!
Dialogue: 0,0:03:40.26,0:03:42.05,Default,,0,0,0,,Жауап бірден болмауы керек.
Dialogue: 0,0:03:42.68,0:03:44.64,Default,,0,0,0,,Қазір тамақтанып алайық.
Dialogue: 0,0:03:49.93,0:03:53.81,Default,,0,0,0,,Бұл елдің үкіметі адамдарды екіге бөлді.
Dialogue: 0,0:03:54.86,0:03:59.57,Default,,0,0,0,,«молшылықтан ләззат алатындарға» және «молшылықты жасайтындарға»
Dialogue: 0,0:04:00.40,0:04:02.90,Default,,0,0,0,,Еңбекқорлығыңның айғағы
Dialogue: 0,0:04:05.62,0:04:07.33,Default,,0,0,0,,Енді барамыз ба?
Dialogue: 0,0:04:07.45,0:04:08.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:10.70,0:04:13.83,Default,,0,0,0,,Сонда да бұл қала әдемі.
Dialogue: 0,0:04:15.46,0:04:18.21,Default,,0,0,0,,Аа, кешіріңіз, жақсысыз ба?
Dialogue: 0,0:04:18.59,0:04:22.59,Default,,0,0,0,,Кешіріңіз, мен оқиғаға қатты батып кеттім.
Dialogue: 0,0:04:22.80,0:04:23.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:25.72,0:04:29.22,Default,,0,0,0,,♪ Samba барлығын бірге жинады
Dialogue: 0,0:04:29.47,0:04:33.14,Default,,0,0,0,,♪ Түнде күліп, билеп алайық
Dialogue: 0,0:04:33.39,0:04:36.90,Default,,0,0,0,,♪ Өзіңізді ырғаққа бағындырыңыз
Dialogue: 0,0:04:34.14,0:04:36.15,Default,,0,0,0,,Ах, кешіріңіз.
Dialogue: 0,0:04:37.15,0:04:40.78,Default,,0,0,0,,♪ Көңіліңізден шыққан түн енді ғана басталып жатыр
Dialogue: 0,0:04:40.90,0:04:44.53,Default,,0,0,0,,♪ үшінмен бірге Самбаны алыңыз
Dialogue: 0,0:04:44.65,0:04:49.41,Default,,0,0,0,,♪ Өмірде бір рет Ичиго Ичидің галстуктарын өсірейік
Dialogue: 0,0:04:49.03,0:04:51.79,Default,,0,0,0,,(Адамдардың шуы)
Dialogue: 0,0:04:49.53,0:04:51.79,Default,,0,0,0,,♪ Әрқашан махаббатпен жарылған
Dialogue: 0,0:04:52.16,0:04:55.79,Default,,0,0,0,,♪ Сиқырлы ырғақ
Dialogue: 0,0:04:55.92,0:04:57.75,Default,,0,0,0,,♪ Секіріңіз және қол бұлғаңыз
Dialogue: 0,0:04:57.88,0:05:01.80,Default,,0,0,0,,♪ Жүр, билейік
Dialogue: 0,0:05:01.92,0:05:03.92,Default,,0,0,0,,♪ Түсіндім! алды самба
Dialogue: 0,0:05:04.05,0:05:05.43,Default,,0,0,0,,Түсіндім алдым
Dialogue: 0,0:05:05.55,0:05:10.31,Default,,0,0,0,,♪ Мен сені алдым! Samba Gotcha Wow Wow
Dialogue: 0,0:05:10.43,0:05:14.81,Default,,0,0,0,,♪ үшін бақытты және көңілді Иә!
Dialogue: 0,0:05:14.94,0:05:17.52,Default,,0,0,0,,...
Dialogue: 0,0:05:17.65,0:05:19.77,Default,,0,0,0,,...
Dialogue: 0,0:05:19.90,0:05:20.90,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:21.02,0:05:25.49,Default,,0,0,0,,♪ Мен сені алдым! Samba Gotcha Wow Wow
Dialogue: 0,0:05:25.61,0:05:27.41,Default,,0,0,0,,♪ Бәріміз бірге ән айтайық
Dialogue: 0,0:05:27.53,0:05:30.03,Default,,0,0,0,,♪ Құштарлық әуені Иә!
Dialogue: 0,0:05:30.16,0:05:33.91,Default,,0,0,0,,♪ Gotcha Samba Иә!
Dialogue: 0,0:05:34.04,0:05:36.87,Default,,0,0,0,,Елорда тұрғындарымен, қожайынмен және қала тұрғындарымен
Dialogue: 0,0:05:37.00,0:05:39.08,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:05:39.58,0:05:43.38,Default,,0,0,0,,Бірақ тек қала тұрғындары ғана ауыр өмір сүруге мәжбүр болды.
Dialogue: 0,0:05:43.51,0:05:45.09,Default,,0,0,0,,Біржақты тәртіппен алынып тасталды
Dialogue: 0,0:05:46.01,0:05:49.18,Default,,0,0,0,,Оның үстіне олар сіз байқамас үшін басқарылады...
Dialogue: 0,0:05:49.30,0:05:51.10,Default,,0,0,0,,Кукк солай
Dialogue: 0,0:05:52.18,0:05:58.56,Default,,0,0,0,,Астана керемет, ғимараттар таза, тамақ жақсы, жұмыс істеудің қажеті жоқ.
Dialogue: 0,0:05:58.81,0:06:00.19,Default,,0,0,0,,Бірақ бұл сұмдық!
Dialogue: 0,0:06:00.94,0:06:04.69,Default,,0,0,0,,Мен мұны істеймін! Риннің стратегиясымен ынтымақтастықта болыңыз!
Dialogue: 0,0:06:04.99,0:06:05.94,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:06.40,0:06:09.16,Default,,0,0,0,,Егер Gear мұны жасайтын болса, мен онымен бірге барамын!
Dialogue: 0,0:06:09.28,0:06:12.95,Default,,0,0,0,,Біз сияқтымыз, анау... анау...
Dialogue: 0,0:06:13.79,0:06:15.58,Default,,0,0,0,,Топ құру.
Dialogue: 0,0:06:16.50,0:06:17.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:18.54,0:06:21.00,Default,,0,0,0,,...
Dialogue: 0,0:06:21.13,0:06:22.29,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:22.42,0:06:26.97,Default,,0,0,0,,♪ Мен сені алдым! Samba Gotcha Wow Wow
Dialogue: 0,0:06:24.42,0:06:25.30,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:27.09,0:06:30.72,Default,,0,0,0,,♪ үшін қуанатын көңілді дыбыс
Dialogue: 0,0:06:31.26,0:06:34.10,Default,,0,0,0,,♪ Иә! алды самба
Dialogue: 0,0:06:34.22,0:06:37.35,Default,,0,0,0,,♪ Гача Самбаны жақсы көріңіз
Dialogue: 0,0:06:35.43,0:06:37.35,Default,,0,0,0,,Гача Гача Самба Самба
Dialogue: 0,0:06:37.64,0:06:42.11,Default,,0,0,0,,♪ Мен сені алдым! Samba Gotcha Wow Wow
Dialogue: 0,0:06:39.98,0:06:40.81,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:42.23,0:06:46.11,Default,,0,0,0,,♪ Құштарлық әуенін айтайық бәріміз
Dialogue: 0,0:06:46.48,0:06:49.86,Default,,0,0,0,,♪ Иә! алды самба
Dialogue: 0,0:06:49.65,0:06:50.66,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:50.16,0:06:53.37,Default,,0,0,0,,♪ Иә! алды самба
Dialogue: 0,0:06:53.78,0:06:54.87,Default,,0,0,0,,♪ Би!
Dialogue: 0,0:06:56.20,0:06:57.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:59.66,0:07:00.67,Default,,0,0,0,,Би
Dialogue: 0,0:07:06.38,0:07:08.59,Default,,0,0,0,,Бұл жолы олардың қашып кетуіне жол берме
Dialogue: 0,0:07:08.72,0:07:10.88,Default,,0,0,0,,Барлық қатысушылар
Dialogue: 0,0:07:11.51,0:07:14.76,Default,,0,0,0,,Егер сіз сәтті болсаңыз, сіз белгілі бір пост аласыз.
Dialogue: 0,0:07:15.81,0:07:18.02,Default,,0,0,0,,Менің оң қолым сияқты
Dialogue: 0,0:07:22.73,0:07:25.77,Default,,0,0,0,,Мына дүниені ал
Dialogue: 0,0:07:26.98,0:07:30.78,Default,,0,0,0,,Шабуылға ұшырайтын мемлекеттік мекеме астананың орталығында орналасқан.
Dialogue: 0,0:07:30.90,0:07:33.53,Default,,0,0,0,,Бұл дұрыс, Дайтенжин Пол
Dialogue: 0,0:07:34.28,0:07:38.16,Default,,0,0,0,,Ұлы Тенжин полюсіне еніп, ішіндегі сервер бөлмесіне кіріңіз.
Dialogue: 0,0:07:38.29,0:07:40.58,Default,,0,0,0,,Ұрлайтын қазына сонда.
Dialogue: 0,0:07:40.91,0:07:42.37,Default,,0,0,0,,Бірақ осы мақсат үшін
Dialogue: 0,0:07:42.50,0:07:45.79,Default,,0,0,0,,Әр түрлі жерлерде орнатылған қауіпсіздікті бұзу керек
Dialogue: 0,0:07:46.04,0:07:49.34,Default,,0,0,0,,Не? Сырттан келген адам болса жақсы емес пе?
Dialogue: 0,0:07:49.46,0:07:50.67,Default,,0,0,0,,Басқару чипі емес
Dialogue: 0,0:07:50.80,0:07:54.18,Default,,0,0,0,,Зиянкестің өзін анықтайтын және әрекет ететін қауіпсіздік.
Dialogue: 0,0:07:54.30,0:07:56.30,Default,,0,0,0,,- (Тісті ақ аю) Уау! -Мен тыңдамаймын!
Dialogue: 0,0:07:56.81,0:07:59.43,Default,,0,0,0,,Өйткені қауіпсіздік материалдары жоғалған
Dialogue: 0,0:07:59.56,0:08:01.31,Default,,0,0,0,,Мен қазір лекция оқимын.
Dialogue: 0,0:08:01.43,0:08:03.81,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:08:03.94,0:08:06.73,Default,,0,0,0,,Соңғы 10 жылдағы оқиғалардың тізімін мұқият қарап шығыңыз
Dialogue: 0,0:08:08.02,0:08:09.48,Default,,0,0,0,,Сондай-ақ астанаға кіру және кету туралы жазба бар.
Dialogue: 0,0:08:14.61,0:08:16.99,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:08:19.12,0:08:21.50,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:08:36.14,0:08:37.60,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:08:57.74,0:08:58.83,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:09:08.50,0:09:10.88,Default,,0,0,0,,Ол жерге жасырын кіру керек.
Dialogue: 0,0:09:11.50,0:09:14.17,Default,,0,0,0,,Мен Тенжин полюске бір рет еніп кеттім.
Dialogue: 0,0:09:14.30,0:09:17.39,Default,,0,0,0,,Бұл жай ғана бастық, жеңіл жүрейік.
Dialogue: 0,0:09:17.84,0:09:21.10,Default,,0,0,0,,Эй, менің Аюдан сұрайтыным бар.
Dialogue: 0,0:09:21.22,0:09:22.85,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:09:23.14,0:09:24.64,Default,,0,0,0,,- Рин туралы - Доки!
Dialogue: 0,0:09:25.98,0:09:28.98,Default,,0,0,0,,-Сен -Аа, а, а, а, а...
Dialogue: 0,0:09:29.11,0:09:30.86,Default,,0,0,0,,Сен Ринді жақсы көресің, солай ма?
Dialogue: 0,0:09:31.32,0:09:32.44,Default,,0,0,0,,О...
Dialogue: 0,0:09:33.03,0:09:37.70,Default,,0,0,0,,Уау! Күткендей мен де солай ойладым.
Dialogue: 0,0:09:33.28,0:09:35.03,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:09:37.82,0:09:40.45,Default,,0,0,0,,Сонымен, қос кездесуге барсақ қалай болады? Gear және Нұх
Dialogue: 0,0:09:40.58,0:09:41.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:41.58,0:09:43.54,Default,,0,0,0,,Жастық – көк көктем
Dialogue: 0,0:09:43.66,0:09:45.62,Default,,0,0,0,,Куу! Бұл дұрыс емес!
Dialogue: 0,0:09:45.75,0:09:47.08,Default,,0,0,0,,Көңіліңізді түсірмеңіз!
Dialogue: 0,0:09:47.21,0:09:48.63,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:09:49.21,0:09:51.13,Default,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:09:51.34,0:09:52.63,Default,,0,0,0,,Мені жалғыз қалдыр!
Dialogue: 0,0:09:53.21,0:09:55.17,Default,,0,0,0,,Канаваги: ​​Бұған тиіспе.
Dialogue: 0,0:09:55.30,0:09:56.63,Default,,0,0,0,,Уау, жылы! Ах
Dialogue: 0,0:09:59.01,0:10:01.47,Default,,0,0,0,,Ааа... иә?
Dialogue: 0,0:10:01.60,0:10:05.64,Default,,0,0,0,,Дұрыс, команданың жасыратын ештеңесі болмады.
Dialogue: 0,0:10:06.43,0:10:08.60,Default,,0,0,0,,Ех! Қызым?
Dialogue: 0,0:10:08.73,0:10:10.56,Default,,0,0,0,,Хееее!
Dialogue: 0,0:10:11.06,0:10:14.57,Default,,0,0,0,,Ақ аюдың Риннің әкесі екені таң қалдырады.
Dialogue: 0,0:10:14.69,0:10:17.40,Default,,0,0,0,,Ей, сен ұмытпадың ба? Бұл жігіттің ішкі ағзалары...
Dialogue: 0,0:10:17.53,0:10:19.57,Default,,0,0,0,,Ха! ол болды!
Dialogue: 0,0:10:19.82,0:10:24.33,Default,,0,0,0,,Мен қызымды кездестіремін деп ойламаппын. Енді не істеуім керек?
Dialogue: 0,0:10:24.87,0:10:28.33,Default,,0,0,0,,Бұл мәселені өзіңізге қалдырыңыз!
Dialogue: 0,0:10:28.46,0:10:30.83,Default,,0,0,0,,-Аа... -Аа...
Dialogue: 0,0:10:34.75,0:10:35.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:40.43,0:10:44.31,Default,,0,0,0,,(Gear, Polar Bear және Cow әндерінің дауысы)
Dialogue: 0,0:10:41.72,0:10:44.31,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:10:57.49,0:11:01.61,Default,,0,0,0,,Ертең біз үлкен жетістіктерге жетеміз.
Dialogue: 0,0:11:01.74,0:11:04.08,Default,,0,0,0,,Игі істерімен
Dialogue: 0,0:11:04.66,0:11:07.66,Default,,0,0,0,,Ал алынған мемлекеттік құпиялар
Dialogue: 0,0:11:07.79,0:11:10.58,Default,,0,0,0,,Біз жасаған хабар тарату жүйесін пайдалану
Dialogue: 0,0:11:10.83,0:11:13.54,Default,,0,0,0,,Шөлдегі барлық қалаларға жібер
Dialogue: 0,0:11:13.71,0:11:17.09,Default,,0,0,0,,Нағыз тең әлемді жүзеге асыру үшін!
Dialogue: 0,0:11:17.84,0:11:20.34,Default,,0,0,0,,Көптен күткен тілегіңіздің орындалатын уақыты жақындап қалды
Dialogue: 0,0:11:20.47,0:11:24.60,Default,,0,0,0,,Бұл кішігірім мереке, бірақ бүгінгі кеш сіз оны толықтай ұнатасыз деп үміттенемін.
Dialogue: 0,0:11:25.47,0:11:28.02,Default,,0,0,0,,Алкоголь Алкоголь Алкоголь қайда?
Dialogue: 0,0:11:28.14,0:11:30.10,Default,,0,0,0,,-Аа... -Міне мен.
Dialogue: 0,0:11:30.23,0:11:31.94,Default,,0,0,0,,Кел, іш, іш
Dialogue: 0,0:11:32.06,0:11:34.61,Default,,0,0,0,,Ақ аю костюмі керемет, солай емес пе?
Dialogue: 0,0:11:32.06,0:11:33.94,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:11:34.73,0:11:37.40,Default,,0,0,0,,Өте сүйкімді, тұлып сияқты~
Dialogue: 0,0:11:37.53,0:11:39.53,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:39.65,0:11:40.95,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:42.36,0:11:44.82,Default,,0,0,0,,Бұл шынымен ақсақ болды.
Dialogue: 0,0:11:44.95,0:11:47.99,Default,,0,0,0,,Қалай ойласаң да күдікті.
Dialogue: 0,0:11:51.79,0:11:53.79,Default,,0,0,0,,Сен тұлыпсың!
Dialogue: 0,0:11:52.71,0:11:53.71,Default,,0,0,0,,Гуаааа!
Dialogue: 0,0:11:54.88,0:11:56.54,Default,,0,0,0,,Сіз маскүнем бе?
Dialogue: 0,0:11:56.92,0:11:58.13,Default,,0,0,0,,Папа
Dialogue: 0,0:11:59.51,0:12:02.55,Default,,0,0,0,,Сол кішкентай және сүйкімді қыз...
Dialogue: 0,0:12:02.68,0:12:03.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:03.01,0:12:05.30,Default,,0,0,0,,Сәлем! Сен не істеп жатырсың?
Dialogue: 0,0:12:05.43,0:12:08.56,Default,,0,0,0,,А, жоқ, бұл жай ғана ақ аю өтіп бара жатыр.
Dialogue: 0,0:12:08.97,0:12:11.56,Default,,0,0,0,,Сәлем! Маған ішкі ағзаларыңызды көрсетіңіз!
Dialogue: 0,0:12:10.39,0:12:11.56,Default,,0,0,0,,А... жақсы
Dialogue: 0,0:12:11.68,0:12:13.81,Default,,0,0,0,,Маған ұнамайды... Маған ұнамайды!
Dialogue: 0,0:12:13.94,0:12:15.52,Default,,0,0,0,,Қиындық
Dialogue: 0,0:12:16.15,0:12:19.03,Default,,0,0,0,,Менің қызым ұялшақ еді...
Dialogue: 0,0:12:19.15,0:12:21.53,Default,,0,0,0,,Оны тез шешіңіз!
Dialogue: 0,0:12:22.03,0:12:23.32,Default,,0,0,0,,Жоқ, тоқтат!
Dialogue: 0,0:12:23.45,0:12:26.24,Default,,0,0,0,,Қашпа, ақымақ
Dialogue: 0,0:12:26.37,0:12:30.08,Default,,0,0,0,,Ым, кешіріңіз... Мен тоқтауым керек еді...
Dialogue: 0,0:12:30.20,0:12:31.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:31.16,0:12:33.25,Default,,0,0,0,,Жоқ, сіз әбден мас екенсіз.
Dialogue: 0,0:12:33.37,0:12:35.21,Default,,0,0,0,,Менің ертең маңызды жұмысым бар...
Dialogue: 0,0:12:35.67,0:12:37.79,Default,,0,0,0,,Неге уағыз айтып жатырсың?
Dialogue: 0,0:12:37.92,0:12:40.17,Default,,0,0,0,,Сіз менің әкемсіз бе?
Dialogue: 0,0:12:40.30,0:12:41.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:41.38,0:12:43.34,Default,,0,0,0,,Тототото Жоқ!
Dialogue: 0,0:12:43.47,0:12:44.84,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:44.97,0:12:46.47,Default,,0,0,0,,Егер мен әке болсам...
Dialogue: 0,0:12:46.59,0:12:47.64,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:12:47.76,0:12:49.26,Default,,0,0,0,,- Өрт! - Дааа!
Dialogue: 0,0:12:49.89,0:12:52.73,Default,,0,0,0,,Жақсы, бұл менің әкем емес.
Dialogue: 0,0:12:54.02,0:12:56.69,Default,,0,0,0,,Әкеңді жек көресің бе?
Dialogue: 0,0:12:57.40,0:12:58.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:59.48,0:13:00.73,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:13:02.32,0:13:03.49,Default,,0,0,0,,Демек, мұнда Бағана болған екен ғой?
Dialogue: 0,0:13:04.11,0:13:07.24,Default,,0,0,0,,Рин шынымен әкесін жек көреді, солай емес пе?
Dialogue: 0,0:13:08.66,0:13:11.04,Default,,0,0,0,,Бірақ бұл бәрі емес шығар.
Dialogue: 0,0:13:13.96,0:13:15.62,Default,,0,0,0,,-Рахмет -Иә? Ах
Dialogue: 0,0:13:16.67,0:13:18.29,Default,,0,0,0,,Маған көмекке келгеніңіз үшін рахмет.
Dialogue: 0,0:13:19.42,0:13:22.92,Default,,0,0,0,,Кеш болды, бірақ мен сізге дұрыс алғыс айта алмадым.
Dialogue: 0,0:13:25.76,0:13:26.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:27.34,0:13:30.01,Default,,0,0,0,,Соның кесірінен мен осындай нәрсеге тартылдым.
Dialogue: 0,0:13:30.14,0:13:31.76,Default,,0,0,0,,Мен Нұхқа ризамын
Dialogue: 0,0:13:31.89,0:13:32.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:32.89,0:13:36.52,Default,,0,0,0,,Мен білгім келетін нәрселерді үйрендім және көп нәрсені алғаш рет білдім.
Dialogue: 0,0:13:37.48,0:13:40.02,Default,,0,0,0,,Өйткені Нұх маған қаладан кетуге мүмкіндік берді.
Dialogue: 0,0:13:40.82,0:13:44.74,Default,,0,0,0,,Мен көкжиектен тысқары, бұрыннан көргім келген нәрсені көре алдым.
Dialogue: 0,0:13:45.11,0:13:49.16,Default,,0,0,0,,Сіз қазір білудің қажеті жоқ нәрселерді білемін деп ойламайсыз ба?
Dialogue: 0,0:13:50.20,0:13:54.25,Default,,0,0,0,,Иә, бірақ білгенім жақсы деп ойлаймын.
Dialogue: 0,0:13:54.37,0:13:56.91,Default,,0,0,0,,Мен сыртқы әлемге шыққанда оны жақсырақ түсіндім.
Dialogue: 0,0:13:57.46,0:13:59.58,Default,,0,0,0,,Мен, менің қалам
Dialogue: 0,0:13:59.71,0:14:03.17,Default,,0,0,0,,Мен қожайын мен қала тұрғындарын жақсы көремін.
Dialogue: 0,0:14:03.30,0:14:05.92,Default,,0,0,0,,Сондықтан мен барлығына қолымнан келгеннің бәрін жасағым келеді.
Dialogue: 0,0:14:06.97,0:14:07.97,Default,,0,0,0,,Иә
Dialogue: 0,0:14:08.43,0:14:12.18,Default,,0,0,0,,Нұх туралы не деуге болады? Неліктен Нұх қауіпті нәрсе істеп жатыр?
Dialogue: 0,0:14:13.22,0:14:17.06,Default,,0,0,0,,Жас кезімде жақын араласқан досым қайтыс болды.
Dialogue: 0,0:14:17.35,0:14:20.90,Default,,0,0,0,,Мұңайғаным сонша, жылауымды тоқтата алмадым.
Dialogue: 0,0:14:21.48,0:14:23.94,Default,,0,0,0,,Бірақ жерлеуге бәрі күлді.
Dialogue: 0,0:14:24.98,0:14:28.78,Default,,0,0,0,,үшінның күлкісі қорқынышты болды, мен оны жек көрдім.
Dialogue: 0,0:14:31.12,0:14:36.83,Default,,0,0,0,,Сол кезде қалаға бір әйел келіп видео көрсетті.
Dialogue: 0,0:14:38.00,0:14:41.25,Default,,0,0,0,,Бұл дүниенің ақиқатына үндеген бейне болды.
Dialogue: 0,0:14:43.00,0:14:47.38,Default,,0,0,0,,Мен жас едім, не айтып тұрғаныңызды түсінбедім.
Dialogue: 0,0:14:48.67,0:14:51.72,Default,,0,0,0,,Бірақ бұл дүниеде бір ғана қателік бар
Dialogue: 0,0:14:52.60,0:14:54.18,Default,,0,0,0,,Бұл түсінікті болды
Dialogue: 0,0:14:56.18,0:15:00.02,Default,,0,0,0,,Содан уақыт өте келе мен Қарсыласудың бар екенін білдім.
Dialogue: 0,0:15:00.35,0:15:02.06,Default,,0,0,0,,Агент болды
Dialogue: 0,0:15:05.53,0:15:07.19,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:15:07.78,0:15:11.20,Default,,0,0,0,,Мен сендерге өтірік айтып, сандарды ұрлауға мәжбүр еттім.
Dialogue: 0,0:15:11.91,0:15:13.45,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:15:13.57,0:15:15.70,Default,,0,0,0,,Жол апатын мен ұйымдастырдым
Dialogue: 0,0:15:16.79,0:15:19.33,Default,,0,0,0,,Полицияның көзі сізде болсын.
Dialogue: 0,0:15:23.71,0:15:25.34,Default,,0,0,0,,Ааа... аа...
Dialogue: 0,0:15:25.96,0:15:27.21,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:15:27.34,0:15:31.47,Default,,0,0,0,,Бірақ мен көптеген тапсырмаларды осылай орындадым.
Dialogue: 0,0:15:31.59,0:15:34.35,Default,,0,0,0,,Үкімет адамдардың сезімдері мен эмоцияларын бақылайды.
Dialogue: 0,0:15:34.47,0:15:36.35,Default,,0,0,0,,Өйткені мен оны кешіре алмадым
Dialogue: 0,0:15:37.56,0:15:39.77,Default,,0,0,0,,Мұңайсам жылағым келеді
Dialogue: 0,0:15:39.89,0:15:42.10,Default,,0,0,0,,Қуансам күлкім келеді
Dialogue: 0,0:15:42.23,0:15:46.61,Default,,0,0,0,,Сүйген адамым өлсе, көз жасым келеді.
Dialogue: 0,0:15:48.48,0:15:50.90,Default,,0,0,0,,Мен бұл сезімді жоғалтқым келмейді
Dialogue: 0,0:15:52.20,0:15:54.20,Default,,0,0,0,,Сондықтан мен ұрыстым
Dialogue: 0,0:15:54.32,0:16:00.41,Default,,0,0,0,,Басқаларды алдамайынша, әлемді өзгерте алмайсың.
Dialogue: 0,0:16:01.75,0:16:02.75,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:03.58,0:16:06.25,Default,,0,0,0,,Нұх көптен бері еңбек етіп жүр емес пе?
Dialogue: 0,0:16:06.92,0:16:07.75,Default,,0,0,0,,Керемет
Dialogue: 0,0:16:09.42,0:16:11.26,Default,,0,0,0,,Кішкентай болсаң да, тәкаппарсың.
Dialogue: 0,0:16:11.97,0:16:14.34,Default,,0,0,0,,Маған бала сияқты қарауды доғар.
Dialogue: 0,0:16:14.47,0:16:15.68,Default,,0,0,0,,Қазірдің өзінде 15
Dialogue: 0,0:16:16.10,0:16:18.43,Default,,0,0,0,,О, мен 17-демін
Dialogue: 0,0:16:20.56,0:16:23.44,Default,,0,0,0,,Я, мен үлкен апамын.
Dialogue: 0,0:16:24.10,0:16:26.31,Default,,0,0,0,,Әлгі әйел Gear-ді азғырып жатыр.
Dialogue: 0,0:16:26.44,0:16:29.61,Default,,0,0,0,,Қозғалыңыз, шабуыл жасаңыз!
Dialogue: 0,0:16:29.73,0:16:32.74,Default,,0,0,0,,- Еркектің ас ішпеу ұят! -Адамға ұят!
Dialogue: 0,0:16:32.86,0:16:34.66,Default,,0,0,0,,-Муу! - (Ақ аю Нака) Ах!
Dialogue: 0,0:16:35.16,0:16:37.45,Default,,0,0,0,,-Сен не қарап тұрсың? -Уау
Dialogue: 0,0:16:37.58,0:16:40.45,Default,,0,0,0,,Сәлем! Қарама!
Dialogue: 0,0:16:40.58,0:16:42.46,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:16:44.04,0:16:46.83,Default,,0,0,0,,Аа~ мен тым көп іштім~
Dialogue: 0,0:16:48.13,0:16:50.84,Default,,0,0,0,,Бірақ бұл қызықты болды.
Dialogue: 0,0:17:05.19,0:17:06.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:19.78,0:17:22.54,Default,,0,0,0,,Үлкен Үштікті айтпағанда, олар одан да мықты—
Dialogue: 0,0:17:23.41,0:17:25.37,Default,,0,0,0,,Елордада осындай жер асты бар ма?
Dialogue: 0,0:17:25.50,0:17:28.04,Default,,0,0,0,,Оны тапқанда біз де таң қалдық.
Dialogue: 0,0:17:28.42,0:17:32.63,Default,,0,0,0,,Бұл астанадан қашқанда жүріп өткен жолым еді.
Dialogue: 0,0:17:32.76,0:17:34.22,Default,,0,0,0,,Елордада жер асты болуы мүмкін
Dialogue: 0,0:17:34.34,0:17:38.05,Default,,0,0,0,,Ешкім білмейтін үңгір тәрізді жолдар көп болуы керек.
Dialogue: 0,0:17:41.31,0:17:44.48,Default,,0,0,0,,Дайтенжин полюсінің ауа өткізгішіне қосылған
Dialogue: 0,0:17:45.27,0:17:46.48,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,0:17:49.65,0:17:50.94,Default,,0,0,0,,Мияу!
Dialogue: 0,0:17:51.77,0:17:53.69,Default,,0,0,0,,Жұмыс уақыты келді
Dialogue: 0,0:17:56.45,0:17:57.95,Default,,0,0,0,,Басталып жатыр.
Dialogue: 0,0:17:58.28,0:17:59.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:04.83,0:18:07.29,Default,,0,0,0,,Уау, ау!
Dialogue: 0,0:18:07.42,0:18:09.04,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:18:09.42,0:18:11.04,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:17.09,0:18:21.14,Default,,0,0,0,,Ішке кіргеннен кейін алдымен күзетшінің көзін жабыңыз.
Dialogue: 0,0:18:21.26,0:18:24.06,Default,,0,0,0,,Аз ғана адам орналастырылғанымен,
Dialogue: 0,0:18:24.18,0:18:26.60,Default,,0,0,0,,Ережелердің формальдылығы ғана болған балалар.
Dialogue: 0,0:18:26.73,0:18:29.40,Default,,0,0,0,,Жүйе барлығын автоматты түрде жасайды.
Dialogue: 0,0:18:31.77,0:18:34.15,Default,,0,0,0,,Камераны ұяға салыңыз, сонда баруға болады
Dialogue: 0,0:18:34.44,0:18:36.99,Default,,0,0,0,,Енді қауіпсіздікті тазалаңыз
Dialogue: 0,0:18:37.90,0:18:40.66,Default,,0,0,0,,Абайлаңыз және абай болыңыз.
Dialogue: 0,0:18:41.12,0:18:44.45,Default,,0,0,0,,Уақытты дұрыс таңдасаңыз немесе қате қадам жасасаңыз...
Dialogue: 0,0:18:44.58,0:18:46.29,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:18:46.41,0:18:48.41,Default,,0,0,0,,-Оу! -ой!
Dialogue: 0,0:18:50.71,0:18:52.04,Default,,0,0,0,,Бірден о дүниеге аттану
Dialogue: 0,0:18:52.96,0:18:54.42,Default,,0,0,0,,Біз келдік
Dialogue: 0,0:19:03.89,0:19:05.01,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:05.14,0:19:06.18,Default,,0,0,0,,-Уау! -Хмм!
Dialogue: 0,0:19:09.60,0:19:11.40,Default,,0,0,0,,А, айналады, айналады.
Dialogue: 0,0:19:14.07,0:19:16.40,Default,,0,0,0,,Себебі өткел сенсорлармен қапталған.
Dialogue: 0,0:19:16.86,0:19:18.32,Default,,0,0,0,,Ешқашан қол тигізбеңіз
Dialogue: 0,0:19:18.78,0:19:21.99,Default,,0,0,0,,Бастапқыда сенсордың құлпы ашылып, аутентификацияланатын болады.
Dialogue: 0,0:19:22.11,0:19:24.62,Default,,0,0,0,,Кешіріңіз! Мен қалай екенін білмеймін
Dialogue: 0,0:19:24.91,0:19:26.33,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:19:26.45,0:19:28.58,Default,,0,0,0,,Мен растау кодын алдым.
Dialogue: 0,0:19:26.79,0:19:28.58,Default,,0,0,0,,Мияу
Dialogue: 0,0:19:28.91,0:19:30.58,Default,,0,0,0,,Таноми Нерон
Dialogue: 0,0:19:32.17,0:19:33.08,Default,,0,0,0,,Ня
Dialogue: 0,0:19:33.46,0:19:35.09,Default,,0,0,0,,Жарайсың, Нерон.
Dialogue: 0,0:19:35.21,0:19:36.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:36.34,0:19:37.59,Default,,0,0,0,,Мияу
Dialogue: 0,0:19:37.71,0:19:41.05,Default,,0,0,0,,Аа~ Жоқ~!
Dialogue: 0,0:19:48.64,0:19:49.85,Default,,0,0,0,,(датчик босату дыбысы)
Dialogue: 0,0:19:49.98,0:19:50.98,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:56.94,0:19:58.03,Default,,0,0,0,,Баратын жер
Dialogue: 0,0:20:14.75,0:20:15.92,Default,,0,0,0,,Міне.
Dialogue: 0,0:20:16.29,0:20:18.50,Default,,0,0,0,,Консоль портына қосылыңыз
Dialogue: 0,0:20:18.63,0:20:20.42,Default,,0,0,0,,Мысалға кіру кілтін енгізіңіз
Dialogue: 0,0:20:21.30,0:20:24.43,Default,,0,0,0,,Содан кейін деректер автоматты түрде көшіріледі.
Dialogue: 0,0:20:24.89,0:20:26.43,Default,,0,0,0,,Ооо~
Dialogue: 0,0:20:26.55,0:20:27.68,Default,,0,0,0,,Жүр, жүр!
Dialogue: 0,0:20:27.81,0:20:28.93,Default,,0,0,0,,Алға жылжу~
Dialogue: 0,0:20:32.81,0:20:34.94,Default,,0,0,0,,Ах~ Нерон~
Dialogue: 0,0:20:35.06,0:20:36.94,Default,,0,0,0,,-Ой... -Жоқ, тез түс.
Dialogue: 0,0:20:37.31,0:20:38.44,Default,,0,0,0,,Мияу~
Dialogue: 0,0:20:38.57,0:20:39.61,Default,,0,0,0,,Сіз
Dialogue: 0,0:20:40.69,0:20:41.53,Default,,0,0,0,,Ня
Dialogue: 0,0:20:42.82,0:20:43.61,Default,,0,0,0,,Не!
Dialogue: 0,0:20:43.74,0:20:46.45,Default,,0,0,0,,S0004 Шексіз өмір
Dialogue: 0,0:20:46.57,0:20:48.87,Default,,0,0,0,,А, не?
Dialogue: 0,0:20:47.41,0:20:50.20,Default,,0,0,0,,Өмірді ұзарту және оның жүйесі туралы
Dialogue: 0,0:20:49.49,0:20:52.37,Default,,0,0,0,,Сіз қандай да бір құжатты шақырған сияқтысыз.
Dialogue: 0,0:20:52.83,0:20:56.50,Default,,0,0,0,,Хромосомалардың ұшындағы теломерлер қысқарған сайын
Dialogue: 0,0:20:56.67,0:20:58.79,Default,,0,0,0,,Жасушалар өледі
Dialogue: 0,0:21:00.05,0:21:03.01,Default,,0,0,0,,Теломазаның жұтылуына байланысты Т-1 күйіне айналды
Dialogue: 0,0:21:03.13,0:21:07.72,Default,,0,0,0,,Теломераның қысқаруын болдырмау және жасуша өмір сүру ұзақтығын ұзарту
Dialogue: 0,0:21:08.35,0:21:12.27,Default,,0,0,0,,Бұл Infinity Life «өмірді ұзарту»
Dialogue: 0,0:21:12.93,0:21:14.23,Default,,0,0,0,,Тез тоқтау керек
Dialogue: 0,0:21:14.85,0:21:15.85,Default,,0,0,0,,Ах
Dialogue: 0,0:21:16.35,0:21:18.27,Default,,0,0,0,,Теломез Т-1 күйінде
Dialogue: 0,0:21:18.40,0:21:21.07,Default,,0,0,0,,Келесі тәртіппен қамтамасыз етілген:
Dialogue: 0,0:21:21.73,0:21:25.95,Default,,0,0,0,,Ресурстарды қалпына келтіру операцияларымен айналысатын жұмысшылар киетін бетперделер
Dialogue: 0,0:21:26.07,0:21:29.37,Default,,0,0,0,,Оған теломеза араласқан сұйықтық жалғанған.
Dialogue: 0,0:21:29.49,0:21:33.62,Default,,0,0,0,,Теломез маска қолданушының денесіне тыныс алу арқылы енеді.
Dialogue: 0,0:21:34.08,0:21:35.92,Default,,0,0,0,,Теломеза бүкіл денеде айналады
Dialogue: 0,0:21:36.04,0:21:40.09,Default,,0,0,0,,Жасушалардағы теломерлерді сіңіріп, Т-1-ге өзгереді
Dialogue: 0,0:21:40.21,0:21:42.34,Default,,0,0,0,,Не? Сен не туралы айтып тұрсың?
Dialogue: 0,0:21:42.84,0:21:46.88,Default,,0,0,0,,Т-1 күйіне айналған теломеза тыныс алу арқылы да таралады.
Dialogue: 0,0:21:47.01,0:21:51.18,Default,,0,0,0,,Ағзадан бөлініп, маска ішіндегі сүзгі арқылы сіңеді
Dialogue: 0,0:21:51.68,0:21:54.89,Default,,0,0,0,,Жиналған Т-1 сұйық күйінде сақталады.
Dialogue: 0,0:21:55.02,0:21:59.86,Default,,0,0,0,,Әр қаланы TNJN-000 мұнарасына қосатын кабельдер арқылы
Dialogue: 0,0:21:59.98,0:22:01.57,Default,,0,0,0,,Елордаға жіберілді
Dialogue: 0,0:22:02.27,0:22:05.78,Default,,0,0,0,,Екінші жағынан, теломерлері жиналған жұмысшылардың жасушаларында,
Dialogue: 0,0:22:05.90,0:22:09.95,Default,,0,0,0,,Хейфлик шегінен өтіп, жасушалар қартаю күйіне өтеді.
Dialogue: 0,0:22:10.07,0:22:13.04,Default,,0,0,0,,Жылдам қартаю 20 жастың ортасында басталады
Dialogue: 0,0:22:13.16,0:22:15.45,Default,,0,0,0,,30-жылдардың аяғындағы өлім
Dialogue: 0,0:22:15.87,0:22:20.58,Default,,0,0,0,,Мұндай жүйенің жұмысы Т-1 тұрақты жеткізіліміне мүмкіндік береді.
Dialogue: 0,0:22:20.71,0:22:23.88,Default,,0,0,0,,Оның бітпейтін ғұмыры бар.
Dialogue: 0,0:22:24.80,0:22:26.22,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:22:26.34,0:22:27.88,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:22:28.26,0:22:30.09,Default,,0,0,0,,Кіруге дайындалыңыз! Асығыңыз!
Dialogue: 0,0:22:30.51,0:22:33.10,Default,,0,0,0,,Сен не туралы айтып тұрсың?
Dialogue: 0,0:22:34.56,0:22:38.60,Default,,0,0,0,,Шөл даладағы адамдардың өмірі пайдаланылуда.
Dialogue: 0,0:22:39.02,0:22:43.19,Default,,0,0,0,,Жинау жұмыстары кезінде киетін бетпердеден өтпеңіз.
Dialogue: 0,0:22:43.32,0:22:44.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:44.36,0:22:46.11,Default,,0,0,0,,Тек энергия емес
Dialogue: 0,0:22:46.24,0:22:50.32,Default,,0,0,0,,Уақытымыздан, тіпті өмірімізден де тоналды.
Dialogue: 0,0:22:50.45,0:22:51.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:53.20,0:22:55.87,Default,,0,0,0,,Бітті, тезірек бұл жерден кетейік.
Dialogue: 0,0:22:56.87,0:22:57.71,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:22:57.83,0:22:59.12,Default,,0,0,0,,-Оуч -Ха!
Dialogue: 0,0:23:00.00,0:23:01.33,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:23:00.37,0:23:01.33,Default,,0,0,0,,Га
Dialogue: 0,0:23:01.67,0:23:04.30,Default,,0,0,0,,үшін қорғалған! Бір адамның да қашып кетуіне жол бермеңіз!
Dialogue: 0,0:23:09.43,0:23:10.63,Default,,0,0,0,,Полиция ше?
Dialogue: 0,0:23:11.18,0:23:13.80,Default,,0,0,0,,Осы уақытта...
Dialogue: 0,0:23:15.81,0:23:17.35,Default,,0,0,0,,Мен енді құлай алмаймын!
Dialogue: 0,0:23:17.47,0:23:19.31,Default,,0,0,0,,Біз бұл стратегияны еш нәрсеге қарамастан орындаймыз!
Dialogue: 0,0:23:21.44,0:23:22.98,Default,,0,0,0,,Бітті
Dialogue: 0,0:23:23.11,0:23:26.44,Default,,0,0,0,,А... А, бұл мүмкін емес.
Dialogue: 0,0:23:26.78,0:23:28.32,Default,,0,0,0,,Сіз неге...
Dialogue: 0,0:23:33.70,0:23:35.33,Default,,0,0,0,,Сіз...
Dialogue: 0,0:23:40.87,0:23:43.08,Default,,0,0,0,,♪～
Dialogue: 0,0:25:03.41,0:25:08.63,Default,,0,0,0,,～♪
