Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:04.21,Default,,0,0,0,,♪～
Dialogue: 0,0:01:26.62,0:01:28.46,Default,,0,0,0,,～♪
Dialogue: 0,0:01:32.50,0:01:33.76,Default,,0,0,0,,Сіз...
Dialogue: 0,0:01:35.22,0:01:36.26,Default,,0,0,0,,Бөшке
Dialogue: 0,0:01:36.55,0:01:38.01,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:01:38.30,0:01:41.14,Default,,0,0,0,,Жоспарыңыз сәтсіз аяқталды.
Dialogue: 0,0:01:41.35,0:01:43.97,Default,,0,0,0,,Эй, сен не айтып тұрсың?
Dialogue: 0,0:01:44.10,0:01:45.81,Default,,0,0,0,,Не істеу керек? Не?
Dialogue: 0,0:01:45.93,0:01:47.10,Default,,0,0,0,,-Уф -Тісті!
Dialogue: 0,0:01:49.10,0:01:51.82,Default,,0,0,0,,Бұл біз бірдеңе істей алатын нәрсе емес.
Dialogue: 0,0:01:51.94,0:01:53.11,Default,,0,0,0,,(Оқ тиеу дыбысы)
Dialogue: 0,0:01:53.23,0:01:54.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:55.94,0:01:58.82,Default,,0,0,0,,О… ой… ой…
Dialogue: 0,0:02:05.08,0:02:07.21,Default,,0,0,0,,Ей эй эй ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей
Dialogue: 0,0:02:07.58,0:02:09.50,Default,,0,0,0,,Қаш!
Dialogue: 0,0:02:11.42,0:02:13.75,Default,,0,0,0,,-Мм! Ха ха ха
Dialogue: 0,0:02:13.88,0:02:15.63,Default,,0,0,0,,(үздіксіз атыс)
Dialogue: 0,0:02:16.84,0:02:18.88,Default,,0,0,0,,Сәлем! Болжам бар ма?
Dialogue: 0,0:02:19.30,0:02:20.89,Default,,0,0,0,,Риннен шарлауды сұраңыз
Dialogue: 0,0:02:21.01,0:02:22.01,Default,,0,0,0,,Хахаха
Dialogue: 0,0:02:21.55,0:02:23.64,Default,,0,0,0,,(Байланыс құралының қоңырау үні)
Dialogue: 0,0:02:22.60,0:02:23.64,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:02:23.76,0:02:28.89,Default,,0,0,0,,(Коммуникатордың қоңырау үні)
Dialogue: 0,0:02:27.14,0:02:28.23,Default,,0,0,0,,Уф
Dialogue: 0,0:02:29.02,0:02:35.48,Default,,0,0,0,,(Үздіксіз қоңырау үні)
Dialogue: 0,0:02:29.23,0:02:34.36,Default,,0,0,0,,Рин! Сен... Қашаннан бері бізге опасыздық жасадың!
Dialogue: 0,0:02:34.48,0:02:35.48,Default,,0,0,0,,Уф
Dialogue: 0,0:02:40.41,0:02:42.53,Default,,0,0,0,,Сіз көрдіңіз
Dialogue: 0,0:02:43.03,0:02:45.54,Default,,0,0,0,,Шөл далада қарулы топ.
Dialogue: 0,0:02:46.20,0:02:48.04,Default,,0,0,0,,Шамасы солай.
Dialogue: 0,0:02:49.16,0:02:51.04,Default,,0,0,0,,Сіз шынымен басқаша дейсіз бе?
Dialogue: 0,0:02:51.63,0:02:57.13,Default,,0,0,0,,Біздің жұмыс – ұлтқа қауіп төндіретін кедергілерді жасырын түрде жою.
Dialogue: 0,0:02:57.26,0:02:59.55,Default,,0,0,0,,Ол үшін сіз кез келген мәртебені қабылдауыңыз керек.
Dialogue: 0,0:02:59.68,0:03:01.55,Default,,0,0,0,,кез келген әрекетті жасауға дайын
Dialogue: 0,0:03:01.97,0:03:03.30,Default,,0,0,0,,Ұлттық қауіпсіздік агенттігі?
Dialogue: 0,0:03:04.51,0:03:08.31,Default,,0,0,0,,Шынымды айтсам, мен сенімен саудаласқым келеді.
Dialogue: 0,0:03:09.14,0:03:11.98,Default,,0,0,0,,Мемлекет басшысының нұсқауымен біз, Қауіпсіздік бюросы,
Dialogue: 0,0:03:12.10,0:03:15.40,Default,,0,0,0,,Сіз Қарсылықты зерттедіңіз.
Dialogue: 0,0:03:15.69,0:03:18.32,Default,,0,0,0,,Біз жасырынатын жерді анықтадық.
Dialogue: 0,0:03:18.69,0:03:19.57,Default,,0,0,0,,Га
Dialogue: 0,0:03:20.03,0:03:21.32,Default,,0,0,0,,Шайқастан кейін
Dialogue: 0,0:03:21.45,0:03:24.57,Default,,0,0,0,,Барлық достарыңызды өлтіру оңай
Dialogue: 0,0:03:25.12,0:03:26.16,Default,,0,0,0,,Уф
Dialogue: 0,0:03:27.54,0:03:31.42,Default,,0,0,0,,Дегенмен, мүмкін болса, мен оны жұмсақ түрде орындағым келеді.
Dialogue: 0,0:03:31.54,0:03:35.04,Default,,0,0,0,,Маған көмектессең, мен сені ұстаймын.
Dialogue: 0,0:03:35.17,0:03:37.17,Default,,0,0,0,,Өз өміріңді қиюдың қажеті жоқ
Dialogue: 0,0:03:37.84,0:03:39.13,Default,,0,0,0,,Сізге бұл қалай ұнайды?
Dialogue: 0,0:03:39.26,0:03:40.42,Default,,0,0,0,,Кук
Dialogue: 0,0:03:42.59,0:03:45.72,Default,,0,0,0,,Енді тағы бір шарт қосайық.
Dialogue: 0,0:03:47.22,0:03:49.43,Default,,0,0,0,,Бұл барлығына арналған
Dialogue: 0,0:03:47.22,0:03:51.18,Default,,0,0,0,,(Үздіксіз қоңырау үні)
Dialogue: 0,0:03:50.18,0:03:51.18,Default,,0,0,0,,Барлығының…
Dialogue: 0,0:03:52.69,0:03:54.98,Default,,0,0,0,,Жоқ, мен сізбен байланыса алмаймын.
Dialogue: 0,0:03:55.11,0:03:57.82,Default,,0,0,0,,Мүмкін жасырынатын жер де...
Dialogue: 0,0:03:57.94,0:03:59.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:59.32,0:04:02.40,Default,,0,0,0,,Менің ойымша, Рин жақсы болады ма? Эй!
Dialogue: 0,0:04:02.53,0:04:03.86,Default,,0,0,0,,Уф
Dialogue: 0,0:04:03.99,0:04:06.28,Default,,0,0,0,,Қарғыс атсын... Эй! Қарғыс атсын!
Dialogue: 0,0:04:06.41,0:04:07.78,Default,,0,0,0,,-Гош -Кума Сабыр ет!
Dialogue: 0,0:04:07.91,0:04:10.75,Default,,0,0,0,,Егер сіз осында болсаңыз, түсіну мүмкін емес!
Dialogue: 0,0:04:10.87,0:04:12.37,Default,,0,0,0,,Ах... уф... ха!
Dialogue: 0,0:04:14.00,0:04:15.38,Default,,0,0,0,,Мен... Кешіріңіз...
Dialogue: 0,0:04:16.33,0:04:18.63,Default,,0,0,0,,Бұл жерден тезірек кетейік.
Dialogue: 0,0:04:25.39,0:04:28.10,Default,,0,0,0,,Төменге жеткенде, алдыңғы есіктен өтіңіз.
Dialogue: 0,0:04:28.43,0:04:30.10,Default,,0,0,0,,Бірақ күзетші бар.
Dialogue: 0,0:04:30.47,0:04:32.60,Default,,0,0,0,,Бөшкелермен жұмыс істегеннен әлдеқайда жақсы.
Dialogue: 0,0:04:32.73,0:04:35.98,Default,,0,0,0,,Нуо Нуо Асығыңыз!
Dialogue: 0,0:04:36.10,0:04:40.07,Default,,0,0,0,,Нггггггг... гхххх!
Dialogue: 0,0:04:40.19,0:04:41.94,Default,,0,0,0,,Ха ха ха жарайды!
Dialogue: 0,0:04:41.69,0:04:42.69,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:42.07,0:04:44.45,Default,,0,0,0,,Жабу, жабу, жабу, жабу... Жабу, жабу, жабылады!
Dialogue: 0,0:04:47.49,0:04:49.99,Default,,0,0,0,,Шүкір, неге білдің!
Dialogue: 0,0:04:54.92,0:04:56.37,Default,,0,0,0,,- (Барлығы) Ах! - (лифттің тоқтаған дыбысы)
Dialogue: 0,0:04:57.50,0:04:58.50,Default,,0,0,0,,Тоқтатылды
Dialogue: 0,0:04:59.17,0:05:00.42,Default,,0,0,0,,Қараңызшы, ол жұмыс істейді ме? Байқап көріңіз.
Dialogue: 0,0:05:00.55,0:05:02.01,Default,,0,0,0,,Бұл уақытында орындалмайды
Dialogue: 0,0:05:02.38,0:05:03.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:03.88,0:05:07.14,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:05:07.26,0:05:09.10,Default,,0,0,0,,Сәлем! Кәне!
Dialogue: 0,0:05:09.22,0:05:10.26,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:16.94,0:05:20.27,Default,,0,0,0,,Мияу! Мияу!
Dialogue: 0,0:05:18.19,0:05:19.27,Default,,0,0,0,,Ах
Dialogue: 0,0:05:20.65,0:05:22.28,Default,,0,0,0,,Әй, мына жігіттер бортта.
Dialogue: 0,0:05:22.69,0:05:24.36,Default,,0,0,0,,Ол жерде апаттық баспалдақ болуы керек.
Dialogue: 0,0:05:24.49,0:05:25.61,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:26.49,0:05:28.95,Default,,0,0,0,,Сен бара жатқанда мен сені тоқтатамын!
Dialogue: 0,0:05:29.07,0:05:30.08,Default,,0,0,0,,О, «екі ел арасындағы неке жақын арада болады» дедің бе?
Dialogue: 0,0:05:30.28,0:05:31.58,Default,,0,0,0,,Әйтпесе бәрімізді қамауға аламыз!
Dialogue: 0,0:05:31.95,0:05:35.29,Default,,0,0,0,,Бірақ! Ол әлемді өзгерте ме? Біраз уақыттан кейін...
Dialogue: 0,0:05:35.41,0:05:37.83,Default,,0,0,0,,Сондықтан деректерді біреу алуы керек!
Dialogue: 0,0:05:38.46,0:05:40.67,Default,,0,0,0,,Балалар сендер жем бола алмайсыңдар!
Dialogue: 0,0:05:40.79,0:05:42.50,Default,,0,0,0,,Бұл рас болуы мүмкін, бірақ...
Dialogue: 0,0:05:42.88,0:05:44.84,Default,,0,0,0,,Мен бас тартқан жоқпын!
Dialogue: 0,0:05:45.30,0:05:47.30,Default,,0,0,0,,Мен мұны берілістерге қалдырамын.
Dialogue: 0,0:05:47.43,0:05:50.10,Default,,0,0,0,,Сіз маған бірнеше рет көмектестіңіз
Dialogue: 0,0:05:50.76,0:05:52.60,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,0:05:52.97,0:05:54.06,Default,,0,0,0,,Ах
Dialogue: 0,0:05:55.35,0:05:59.56,Default,,0,0,0,,Бәрі біткенде, мен міндетті түрде қайтадан Нұхқа көмектесемін!
Dialogue: 0,0:06:00.27,0:06:01.36,Default,,0,0,0,,Күту
Dialogue: 0,0:06:01.69,0:06:03.36,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:06:03.94,0:06:04.94,Default,,0,0,0,,Кук
Dialogue: 0,0:06:05.74,0:06:07.36,Default,,0,0,0,,(Оқ тиеу дыбысы)
Dialogue: 0,0:06:08.78,0:06:09.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:10.03,0:06:12.16,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:06:11.03,0:06:12.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:12.28,0:06:17.58,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:06:15.16,0:06:17.58,Default,,0,0,0,,Нұх... Қарғыс атсын!
Dialogue: 0,0:06:20.00,0:06:21.75,Default,,0,0,0,,Допты жұлып алған адам — біздің Хью Хадсон мектебінің мақтанышы —
Dialogue: 0,0:06:21.88,0:06:22.88,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:22.96,0:06:29.18,Default,,0,0,0,,(Жақындаған аяқ дыбыстары)
Dialogue: 0,0:06:24.67,0:06:26.42,Default,,0,0,0,,Жоқ, менің жоғары көтерілуден басқа амалым жоқ!
Dialogue: 0,0:06:26.55,0:06:29.18,Default,,0,0,0,,Бұл өтірік! Қарғыс атсын!
Dialogue: 0,0:06:31.05,0:06:34.89,Default,,0,0,0,,Тексеріңіз! уф уф
Dialogue: 0,0:06:37.35,0:06:39.64,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:06:40.56,0:06:44.57,Default,,0,0,0,,Ха... Хе! Эй!
Dialogue: 0,0:06:45.28,0:06:46.28,Default,,0,0,0,,Сәттілік, аю!
Dialogue: 0,0:06:46.65,0:06:49.49,Default,,0,0,0,,Сіз қайда барасыз? Ха ха ха
Dialogue: 0,0:06:49.61,0:06:52.32,Default,,0,0,0,,Жоғары Барсаң да, шығу жоқ!
Dialogue: 0,0:06:52.45,0:06:54.41,Default,,0,0,0,,Эй, мен білемін!
Dialogue: 0,0:06:52.45,0:06:54.87,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:06:54.53,0:06:55.79,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:06:55.91,0:06:57.29,Default,,0,0,0,,Мен білемін бе?
Dialogue: 0,0:06:58.08,0:06:59.33,Default,,0,0,0,,Келген жерден шық!
Dialogue: 0,0:06:59.46,0:07:01.88,Default,,0,0,0,,Иә? Бұл тағы да сол арна!
Dialogue: 0,0:07:02.00,0:07:03.71,Default,,0,0,0,,Сіз басқа ешкімді танымайсыз!
Dialogue: 0,0:07:04.04,0:07:05.50,Default,,0,0,0,,Қабат жоспарын тексеріңіз
Dialogue: 0,0:07:05.63,0:07:08.09,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:07:08.21,0:07:10.18,Default,,0,0,0,,Келесі қабаттан жоғары көтерілуге болатын сияқты.
Dialogue: 0,0:07:11.38,0:07:12.55,Default,,0,0,0,,Бұдан басқа!
Dialogue: 0,0:07:14.43,0:07:15.60,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:16.26,0:07:17.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:20.19,0:07:21.10,Default,,0,0,0,,Ей, ақымақ!
Dialogue: 0,0:07:21.98,0:07:24.69,Default,,0,0,0,,Арх! Асықшы! Күтпе!
Dialogue: 0,0:07:24.40,0:07:27.94,Default,,0,0,0,,Уф... уф... уф...
Dialogue: 0,0:07:24.81,0:07:25.69,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:07:26.94,0:07:27.94,Default,,0,0,0,,Беріліс!
Dialogue: 0,0:07:28.28,0:07:29.90,Default,,0,0,0,,Арх! Қарғыс атсын!
Dialogue: 0,0:07:30.03,0:07:31.07,Default,,0,0,0,,Сендер-ай, шіркін!
Dialogue: 0,0:07:31.82,0:07:32.82,Default,,0,0,0,,Аю!
Dialogue: 0,0:07:33.20,0:07:36.28,Default,,0,0,0,,Уайымдама, мен бүгін ақымақпын.
Dialogue: 0,0:07:36.41,0:07:38.33,Default,,0,0,0,,Бұл жігіттердің көздері жоқ.
Dialogue: 0,0:07:38.54,0:07:40.46,Default,,0,0,0,,Жақсы! Тез қаш!
Dialogue: 0,0:07:40.58,0:07:42.50,Default,,0,0,0,,Ал мен осы уақытқа дейін үндемедім.
Dialogue: 0,0:07:42.62,0:07:44.58,Default,,0,0,0,,Мен кунг-фу шеберімін
Dialogue: 0,0:07:44.96,0:07:46.21,Default,,0,0,0,,Аю!
Dialogue: 0,0:07:46.34,0:07:47.34,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,0:07:48.42,0:07:51.47,Default,,0,0,0,,Балалар, орындаңдар!
Dialogue: 0,0:07:51.59,0:07:54.09,Default,,0,0,0,,Ринге қамқорлық жасаңыз.
Dialogue: 0,0:07:55.68,0:07:56.89,Default,,0,0,0,,Ішек
Dialogue: 0,0:07:57.72,0:07:58.93,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:07:59.06,0:08:00.35,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:00.48,0:08:01.48,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:01.94,0:08:05.27,Default,,0,0,0,,Кух хе хех бұл жақсы емес хе хе
Dialogue: 0,0:08:05.86,0:08:08.61,Default,,0,0,0,,Салқын болуға тырыстым, бірақ дірілдеп тұрдым.
Dialogue: 0,0:08:08.73,0:08:11.99,Default,,0,0,0,,Хехе мен қозғала алмаймын Хэхе
Dialogue: 0,0:08:12.57,0:08:14.41,Default,,0,0,0,,(қарсыласу мүшелерінің қадамдары)
Dialogue: 0,0:08:21.16,0:08:23.75,Default,,0,0,0,,Сіз уәдеңізде тұрасыз, солай ма?
Dialogue: 0,0:08:25.67,0:08:27.00,Default,,0,0,0,,Сапар аяқталды
Dialogue: 0,0:08:27.13,0:08:30.42,Default,,0,0,0,,Барлық фишкаларын алып тастап, астананың сыртына апарыңыз.
Dialogue: 0,0:08:30.55,0:08:31.92,Default,,0,0,0,,Оны сол жерге тастаңыз.
Dialogue: 0,0:08:32.05,0:08:33.13,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:33.26,0:08:35.26,Default,,0,0,0,,Күте тұрыңыз! Бұл басқа әңгіме!
Dialogue: 0,0:08:35.39,0:08:37.39,Default,,0,0,0,,Мен сенің өміріңді алмаймын...
Dialogue: 0,0:08:39.01,0:08:40.47,Default,,0,0,0,,Сіз алдадыңыз ба?
Dialogue: 0,0:08:41.39,0:08:42.73,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:08:43.27,0:08:47.73,Default,,0,0,0,,Мемлекетке кедергілерді жою үшін бәрін жасауға дайын болыңыз.
Dialogue: 0,0:08:48.23,0:08:50.53,Default,,0,0,0,,Алданба! Барлығы қазір...
Dialogue: 0,0:08:50.65,0:08:51.65,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:08:52.44,0:08:57.91,Default,,0,0,0,,Маған пікір айта алатын жалғыз адам - мистер Буррелл.
Dialogue: 0,0:08:58.95,0:08:59.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:01.45,0:09:02.54,Default,,0,0,0,,Уф
Dialogue: 0,0:09:05.83,0:09:08.96,Default,,0,0,0,,Барлығына бас
Dialogue: 0,0:09:09.84,0:09:14.01,Default,,0,0,0,,Бірақ басқа уәдені орындайық.
Dialogue: 0,0:09:22.85,0:09:26.06,Default,,0,0,0,,Мияу...мяу!
Dialogue: 0,0:09:28.94,0:09:30.07,Default,,0,0,0,,Ха! Уф!
Dialogue: 0,0:09:30.98,0:09:33.78,Default,,0,0,0,,Сен жақсы орындадың Gear
Dialogue: 0,0:09:33.90,0:09:36.95,Default,,0,0,0,,Соңғы уақытқа дейін ештеңе білмеген айдаладағы бала
Dialogue: 0,0:09:37.61,0:09:41.45,Default,,0,0,0,,Сыртқы әлемге саяхат жасап, астананың құпиясын біліңіз
Dialogue: 0,0:09:41.58,0:09:43.45,Default,,0,0,0,,Өйткені, біз осы уақытқа дейін жеттік.
Dialogue: 0,0:09:44.70,0:09:46.33,Default,,0,0,0,,Бірақ бұл мағынасыз.
Dialogue: 0,0:09:46.92,0:09:48.96,Default,,0,0,0,,Сіз ештеңе істей алмайсыз
Dialogue: 0,0:09:49.46,0:09:52.50,Default,,0,0,0,,Мырзаны қанша өлтірсем де...
Dialogue: 0,0:09:52.63,0:09:54.46,Default,,0,0,0,,Сен мені оңай өлтіре алмайсың!
Dialogue: 0,0:09:55.22,0:09:58.97,Default,,0,0,0,,Шындықты ашыңыз және қаладағы барлық адамдарға көмектесіңіз!
Dialogue: 0,0:10:00.76,0:10:01.76,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:10:01.89,0:10:04.27,Default,,0,0,0,,Уа... аа...
Dialogue: 0,0:10:04.85,0:10:05.93,Default,,0,0,0,,Е...
Dialogue: 0,0:10:07.48,0:10:08.90,Default,,0,0,0,,(үзік-үзік ысырма дыбысы)
Dialogue: 0,0:10:09.52,0:10:10.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:10.61,0:10:14.40,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:10:12.44,0:10:13.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:15.03,0:10:16.49,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:10:17.86,0:10:19.45,Default,,0,0,0,,Бұл қандай күмбез?
Dialogue: 0,0:10:19.57,0:10:20.57,Default,,0,0,0,,Бұл астана.
Dialogue: 0,0:10:20.70,0:10:21.95,Default,,0,0,0,,-Ха! -Бұл?
Dialogue: 0,0:10:22.45,0:10:25.62,Default,,0,0,0,,Тіпті жұмақта тұратын адамдар да астана деп аталады
Dialogue: 0,0:10:25.75,0:10:28.46,Default,,0,0,0,,Көзге көрінбейтін торда ұсталған шошқа ғана
Dialogue: 0,0:10:29.46,0:10:34.71,Default,,0,0,0,,Дүние сіз ойлағаннан әлдеқайда үлкен, күшті және ұсқынсыз.
Dialogue: 0,0:10:35.46,0:10:39.22,Default,,0,0,0,,Егер сіз мұны оңай жасай аламын деп ойласаңыз, қателескенсіз.
Dialogue: 0,0:10:39.34,0:10:40.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:40.51,0:10:43.22,Default,,0,0,0,,Қазір мұнда не істеп жатсаңыз да
Dialogue: 0,0:10:43.35,0:10:45.47,Default,,0,0,0,,Дүние ешқашан өзгермейді
Dialogue: 0,0:10:46.35,0:10:49.77,Default,,0,0,0,,Шөл далада бірде-бір адам өлім тағдырынан құтыла алмайды.
Dialogue: 0,0:10:49.89,0:10:52.48,Default,,0,0,0,,Оның өмірі көзді ашып-жұмғанша алынады
Dialogue: 0,0:10:53.02,0:10:54.23,Default,,0,0,0,,Өмір?
Dialogue: 0,0:10:55.11,0:10:59.86,Default,,0,0,0,,Біз өмір сүруге уақытымыздан, тіпті өмірімізден де тоналды.
Dialogue: 0,0:11:00.28,0:11:02.37,Default,,0,0,0,,Нұх та сол кезде осылай деді.
Dialogue: 0,0:11:02.95,0:11:04.87,Default,,0,0,0,,Сіз түсінбейтін сияқтысыз.
Dialogue: 0,0:11:04.99,0:11:06.87,Default,,0,0,0,,Қалада да көрген боларсың.
Dialogue: 0,0:11:07.50,0:11:10.58,Default,,0,0,0,,Бірнеше жыл ішінде айтарлықтай нашарлайтын ересектер
Dialogue: 0,0:11:10.71,0:11:11.96,Default,,0,0,0,,Га
Dialogue: 0,0:11:12.08,0:11:15.46,Default,,0,0,0,,Иә, бұл ауру немесе басқа нәрсе емес.
Dialogue: 0,0:11:16.46,0:11:20.09,Default,,0,0,0,,Бұл әлемнің негізін құрайтын жүйелердің бірі.
Dialogue: 0,0:11:20.47,0:11:22.93,Default,,0,0,0,,Ауру емес...
Dialogue: 0,0:11:23.05,0:11:24.18,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:11:24.30,0:11:27.68,Default,,0,0,0,,Жарайды, бастық жақында келеді...
Dialogue: 0,0:11:36.69,0:11:37.98,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:40.20,0:11:41.82,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:11:41.95,0:11:43.99,Default,,0,0,0,,Кәрі қаңбақ болсаң, кеттің.
Dialogue: 0,0:11:44.12,0:11:46.41,Default,,0,0,0,,Міне, оған бір жыл болды.
Dialogue: 0,0:11:46.53,0:11:50.54,Default,,0,0,0,,Қарасам, әлгі кәрі қаңбақ да дүниеден өтті ме?
Dialogue: 0,0:11:51.50,0:11:56.21,Default,,0,0,0,,Дүкеннің аты Мен не оқитынымды білмедім.
Dialogue: 0,0:11:56.34,0:11:59.96,Default,,0,0,0,,Бұл менің құрал-саймансыз жалғыздықтан құтылатын жер болды.
Dialogue: 0,0:12:00.09,0:12:03.01,Default,,0,0,0,,Не? Жалғызмын деп кім айтты?
Dialogue: 0,0:12:03.13,0:12:06.39,Default,,0,0,0,,Бір топ сандырақ... Ван Гог Ван Гог Ван Гог
Dialogue: 0,0:12:06.51,0:12:08.77,Default,,0,0,0,,Науқастың тыныштығын сақтауыңызды өтінемін!
Dialogue: 0,0:12:08.89,0:12:10.56,Default,,0,0,0,,Өйткені ол қарт адам.
Dialogue: 0,0:12:10.68,0:12:12.85,Default,,0,0,0,,Биыл 34 болды, солай ма?
Dialogue: 0,0:12:12.98,0:12:17.52,Default,,0,0,0,,Нукасе Темее 30-ға жақындап қалған шығар.
Dialogue: 0,0:12:17.65,0:12:19.90,Default,,0,0,0,,Бірден солай болды, ақымақ!
Dialogue: 0,0:12:18.23,0:12:19.23,Default,,0,0,0,,Аха~
Dialogue: 0,0:12:20.03,0:12:23.99,Default,,0,0,0,,Го Хохо Го Хохо
Dialogue: 0,0:12:29.29,0:12:30.50,Default,,0,0,0,,Түсіндіңіз.
Dialogue: 0,0:12:31.33,0:12:33.00,Default,,0,0,0,,Сіз ештеңе істей алмайсыз
Dialogue: 0,0:12:33.87,0:12:36.79,Default,,0,0,0,,Ешкімді құтқару мүмкін емес
Dialogue: 0,0:12:36.92,0:12:39.00,Default,,0,0,0,,Беріліс ұстаңыз!
Dialogue: 0,0:12:40.00,0:12:41.84,Default,,0,0,0,,Сәлем Gear!
Dialogue: 0,0:12:48.10,0:12:50.60,Default,,0,0,0,,Ах... Эй, Носа-ни.
Dialogue: 0,0:12:51.02,0:12:52.85,Default,,0,0,0,,Оның айтқаны рас болса
Dialogue: 0,0:12:52.98,0:12:56.02,Default,,0,0,0,,Шеберге көмектесу қиын болуы мүмкін.
Dialogue: 0,0:12:56.15,0:12:59.27,Default,,0,0,0,,Бәрін шеше алмасақ та
Dialogue: 0,0:12:59.40,0:13:02.90,Default,,0,0,0,,Шындықты танытудың үлкен мәні бар.
Dialogue: 0,0:13:03.03,0:13:05.11,Default,,0,0,0,,Сіз мұны істеуді шештіңіз, солай ма?
Dialogue: 0,0:13:04.11,0:13:05.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:05.70,0:13:07.12,Default,,0,0,0,,Берілістерге сеніп тапсырыңыз
Dialogue: 0,0:13:07.49,0:13:09.45,Default,,0,0,0,,Тек орындаңыз!
Dialogue: 0,0:13:11.12,0:13:12.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:12.41,0:13:15.79,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:13:14.58,0:13:18.75,Default,,0,0,0,,Дұрыс, қанша адам бұл мүмкін емес десе де.
Dialogue: 0,0:13:18.88,0:13:21.71,Default,,0,0,0,,Сіз тырыспасаңыз, түсінбейсіз!
Dialogue: 0,0:13:22.05,0:13:22.96,Default,,0,0,0,,Беріліс!
Dialogue: 0,0:13:23.09,0:13:25.17,Default,,0,0,0,,Жақсы көрінетін сенім!
Dialogue: 0,0:13:25.63,0:13:29.18,Default,,0,0,0,,Онда біз мұнда ұстай алмаймыз.
Dialogue: 0,0:13:29.30,0:13:32.47,Default,,0,0,0,,Иә, жол болса... бар!
Dialogue: 0,0:13:32.60,0:13:33.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:35.64,0:13:38.52,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:13:40.11,0:13:42.36,Default,,0,0,0,,Вааах!
Dialogue: 0,0:13:43.15,0:13:44.32,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:13:47.49,0:13:50.03,Default,,0,0,0,,- Даа! -Охх!
Dialogue: 0,0:13:50.32,0:13:54.29,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:13:56.12,0:13:57.75,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:13:57.87,0:13:58.88,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:00.75,0:14:03.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:03.25,0:14:04.84,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:14:05.84,0:14:06.84,Default,,0,0,0,,О!
Dialogue: 0,0:14:13.14,0:14:14.97,Default,,0,0,0,,Вааах!
Dialogue: 0,0:14:15.10,0:14:16.68,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:14:15.10,0:14:18.44,Default,,0,0,0,,(аспаннан түскен дыбыс)
Dialogue: 0,0:14:16.81,0:14:18.44,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:14:20.23,0:14:21.27,Default,,0,0,0,,- (Ер адам) Ах! -(Әйел) Уф!
Dialogue: 0,0:14:24.23,0:14:25.40,Default,,0,0,0,,Фааа!
Dialogue: 0,0:14:25.53,0:14:26.78,Default,,0,0,0,,-Хаа~ -Хехехехе
Dialogue: 0,0:14:26.90,0:14:28.86,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,0:14:30.99,0:14:32.49,Default,,0,0,0,,(электрлік қысқа тұйықталу дыбысы)
Dialogue: 0,0:14:32.62,0:14:33.91,Default,,0,0,0,,Ол ес-түссіз. Өте ауыр халде.
Dialogue: 0,0:14:34.04,0:14:35.45,Default,,0,0,0,,Беріліс жарай ма?
Dialogue: 0,0:14:35.58,0:14:38.29,Default,,0,0,0,,Иә, Носа апалар... олардың қолдары!
Dialogue: 0,0:14:38.87,0:14:40.33,Default,,0,0,0,,Хехехе, жарайды.
Dialogue: 0,0:14:40.46,0:14:42.13,Default,,0,0,0,,Бұл соншалықты проблема емес.
Dialogue: 0,0:14:42.25,0:14:43.84,Default,,0,0,0,,Атқан жұлдыз сияқты
Dialogue: 0,0:14:43.96,0:14:46.13,Default,,0,0,0,,Бұл менің өмір жолым!
Dialogue: 0,0:14:46.26,0:14:48.30,Default,,0,0,0,,Мені қорғағаныңыз үшін рахмет.
Dialogue: 0,0:14:48.42,0:14:49.84,Default,,0,0,0,,Бұл анық емес пе?
Dialogue: 0,0:14:49.97,0:14:51.01,Default,,0,0,0,,О!
Dialogue: 0,0:15:02.11,0:15:05.69,Default,,0,0,0,,Осы жерден не істеуіміз керек? Мен жасырынған жерге қайтып бара алмаймын.
Dialogue: 0,0:15:06.07,0:15:09.20,Default,,0,0,0,,Біз айдаладағы адамдармен сөйлесудің жолын ойластыруымыз керек.
Dialogue: 0,0:15:10.03,0:15:11.95,Default,,0,0,0,,Шөл далада қалай айту керек
Dialogue: 0,0:15:12.95,0:15:14.49,Default,,0,0,0,,Хабар тарату станциясы
Dialogue: 0,0:15:14.62,0:15:18.04,Default,,0,0,0,,Олар сол жерден шөл даланың барлық қалаларына бағдарламалар таратады.
Dialogue: 0,0:15:18.70,0:15:20.04,Default,,0,0,0,,Хабар тарату станциясы!
Dialogue: 0,0:15:20.16,0:15:21.79,Default,,0,0,0,,Әрине бар!
Dialogue: 0,0:15:21.92,0:15:22.92,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:30.13,0:15:32.68,Default,,0,0,0,,Қарсылық жасырынатын жер басып алынды.
Dialogue: 0,0:15:32.80,0:15:34.43,Default,,0,0,0,,Тек қаңғыбас иттер ғана қалды
Dialogue: 0,0:15:34.55,0:15:36.64,Default,,0,0,0,,Неліктен ол өлтірілмеді?
Dialogue: 0,0:15:37.27,0:15:40.69,Default,,0,0,0,,Мен сіздің күшіңізге тым сенімді болдым ба?
Dialogue: 0,0:15:40.81,0:15:43.56,Default,,0,0,0,,Уайымдамаңыз, біз оны жақын арада жөндейміз.
Dialogue: 0,0:15:43.69,0:15:44.86,Default,,0,0,0,,(телефонның тұтқасын қою дыбысы)
Dialogue: 0,0:15:44.98,0:15:46.40,Default,,0,0,0,,Контакт дөңгелегі
Dialogue: 0,0:15:49.03,0:15:49.86,Default,,0,0,0,,Уф
Dialogue: 0,0:15:50.70,0:15:51.82,Default,,0,0,0,,-Ей! -Уф!
Dialogue: 0,0:15:53.32,0:15:54.32,Default,,0,0,0,,Га
Dialogue: 0,0:16:01.21,0:16:07.04,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:16:10.38,0:16:12.47,Default,,0,0,0,,(электрлік қысқа дыбыс)
Dialogue: 0,0:16:21.31,0:16:22.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:23.56,0:16:26.40,Default,,0,0,0,,Бұл... барлық қалалар ма?
Dialogue: 0,0:16:27.73,0:16:29.90,Default,,0,0,0,,Ха! Бұл менің қалам!
Dialogue: 0,0:16:30.03,0:16:31.36,Default,,0,0,0,,- (Қуаттың өшіп жатқан дыбысы) - Ха! Уф!
Dialogue: 0,0:16:31.99,0:16:34.32,Default,,0,0,0,,- Не? - Бұл тағы да олар!
Dialogue: 0,0:16:34.45,0:16:36.24,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:16:36.37,0:16:38.03,Default,,0,0,0,,Қуат беру үзілді
Dialogue: 0,0:16:38.49,0:16:40.58,Default,,0,0,0,,Мен де қазір сонда бара жатырмын.
Dialogue: 0,0:16:40.70,0:16:44.00,Default,,0,0,0,,Сәлем! Ол дерлік болды
Dialogue: 0,0:16:44.12,0:16:45.50,Default,,0,0,0,,Әзірге беріліс жоқ
Dialogue: 0,0:16:46.50,0:16:47.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:48.04,0:16:50.67,Default,,0,0,0,,Осы уақытқа дейін келіп, бас тартқаным үшін кешірім сұраймын.
Dialogue: 0,0:16:50.80,0:16:51.92,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:16:52.05,0:16:53.51,Default,,0,0,0,,Бұл әсерлі.
Dialogue: 0,0:16:53.63,0:16:56.01,Default,,0,0,0,,Бірақ біз оны тарата алмасақ, ештеңе істей алмаймыз.
Dialogue: 0,0:16:56.14,0:16:57.09,Default,,0,0,0,,Ах
Dialogue: 0,0:16:58.64,0:17:01.02,Default,,0,0,0,,Мен қуатты қалпына келтіре аламын.
Dialogue: 0,0:17:01.14,0:17:04.02,Default,,0,0,0,,Күте тұрыңыз! Сенің сезіміңді білемін, бірақ бұл өте қауіпті!
Dialogue: 0,0:17:04.56,0:17:07.02,Default,,0,0,0,,Қуат беру жүйесін бұзу тым ауыр.
Dialogue: 0,0:17:07.15,0:17:09.61,Default,,0,0,0,,Негізгі жады зақымдалған болуы мүмкін!
Dialogue: 0,0:17:09.73,0:17:11.28,Default,,0,0,0,,Тіпті қауіпсіздік шабуылдары...
Dialogue: 0,0:17:11.40,0:17:13.24,Default,,0,0,0,,Бұл өте нашар болғандықтан, не?
Dialogue: 0,0:17:13.57,0:17:14.57,Default,,0,0,0,,Сіз...
Dialogue: 0,0:17:14.70,0:17:15.70,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:16.03,0:17:18.32,Default,,0,0,0,,Носа-ниге бірдеңе болса...
Dialogue: 0,0:17:18.45,0:17:21.99,Default,,0,0,0,,Асыл отбасымның...тілектерін орындау үшін.
Dialogue: 0,0:17:22.12,0:17:24.21,Default,,0,0,0,,Мен аздап тәуекелге қарсы емеспін.
Dialogue: 0,0:17:24.33,0:17:25.21,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:17:25.58,0:17:28.46,Default,,0,0,0,,Иә, иә, мен сіздің әңгімеңізді естідім.
Dialogue: 0,0:17:28.58,0:17:29.54,Default,,0,0,0,,Стингрей әже
Dialogue: 0,0:17:29.67,0:17:32.17,Default,,0,0,0,,Бұл тапсырмаларды қарт адамдарға тапсырыңыз.
Dialogue: 0,0:17:32.30,0:17:34.97,Default,,0,0,0,,Жоқ, Эй-баа, мен мұны Носаға шешуге рұқсат етемін.
Dialogue: 0,0:17:35.09,0:17:36.22,Default,,0,0,0,,Сиыр-чан
Dialogue: 0,0:17:36.68,0:17:40.22,Default,,0,0,0,,Мен әңгімені естідім! Бұл рөлді вирусқа қалдырыңыз...
Dialogue: 0,0:17:40.35,0:17:43.68,Default,,0,0,0,,Шатаспаңыз! Мен сізге рұқсат етіңіз дедім!
Dialogue: 0,0:17:40.68,0:17:41.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:43.81,0:17:45.23,Default,,0,0,0,,Сіз шынымен ашулысыз.
Dialogue: 0,0:17:45.52,0:17:49.27,Default,,0,0,0,,Кешіріңіз, Эй-ба, Нака-нии, рахмет, Сиыр.
Dialogue: 0,0:17:49.40,0:17:51.27,Default,,0,0,0,,Мен не айтсам да, тыңдамайды.
Dialogue: 0,0:17:51.40,0:17:53.78,Default,,0,0,0,,Ол кезде менің ойыншығым сынған болатын.
Dialogue: 0,0:17:54.07,0:17:56.24,Default,,0,0,0,,10 ересек адамға кіргеннен кейін
Dialogue: 0,0:17:56.36,0:17:59.95,Default,,0,0,0,,14 адам Бұл сіз жақсы көрген ойыншық, солай ма?
Dialogue: 0,0:18:00.07,0:18:02.24,Default,,0,0,0,,Сен жылап тұрдың, мен саған көмектесуге келмедім.
Dialogue: 0,0:18:02.37,0:18:03.58,Default,,0,0,0,,Шу!
Dialogue: 0,0:18:03.70,0:18:06.91,Default,,0,0,0,,Gear-ге баланың қайсысы нақты проблема екенін айтыңыз.
Dialogue: 0,0:18:07.04,0:18:08.25,Default,,0,0,0,,-Тісті беріліс -Мм
Dialogue: 0,0:18:08.37,0:18:10.67,Default,,0,0,0,,Себебі менде бәрі жақсы
Dialogue: 0,0:18:11.38,0:18:12.50,Default,,0,0,0,,Иә
Dialogue: 0,0:18:12.80,0:18:16.01,Default,,0,0,0,,Жарайды, онда барайық.
Dialogue: 0,0:18:16.13,0:18:22.68,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:18:35.28,0:18:36.53,Default,,0,0,0,,(Қысқа дыбыс)
Dialogue: 0,0:18:38.99,0:18:41.37,Default,,0,0,0,,Ия, бұл керемет, Носа-ни!
Dialogue: 0,0:18:43.53,0:18:45.37,Default,,0,0,0,,Енді оны маған қалдырыңыз!
Dialogue: 0,0:18:45.95,0:18:48.58,Default,,0,0,0,,Бұдан былай редуктор барлық қалалардағы мониторларда көрсетіледі.
Dialogue: 0,0:18:48.71,0:18:50.54,Default,,0,0,0,,Барлығына шындықты айт!
Dialogue: 0,0:18:50.67,0:18:51.88,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:18:52.00,0:18:56.59,Default,,0,0,0,,Сағат 8 болды! Түнде қош бол, таң қайырлы таң!
Dialogue: 0,0:18:56.71,0:19:00.59,Default,,0,0,0,,Бүгін сізде де жарқын күн болады деп үміттенемін! Түсіндім!
Dialogue: 0,0:19:02.18,0:19:03.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:03.39,0:19:04.93,Default,,0,0,0,,(Кофенің шашылып жатқан дыбысы)
Dialogue: 0,0:19:06.06,0:19:07.10,Default,,0,0,0,,Беріліс?
Dialogue: 0,0:19:07.85,0:19:11.10,Default,,0,0,0,,Бәрің мені ести аласыңдар ма?
Dialogue: 0,0:19:11.65,0:19:14.11,Default,,0,0,0,,Мен қазір елордадамын.
Dialogue: 0,0:19:14.57,0:19:17.23,Default,,0,0,0,,Барлығы тұратын қалаға ұқсамайды
Dialogue: 0,0:19:17.36,0:19:21.57,Default,,0,0,0,,Барлығы таза, түрлі тағамдар көп болды.
Dialogue: 0,0:19:21.70,0:19:24.62,Default,,0,0,0,,Сіз кез келген уақытта қалағаныңызша таза су іше аласыз.
Dialogue: 0,0:19:24.99,0:19:28.12,Default,,0,0,0,,Шаң жоқ, киімдерің кірленбейді.
Dialogue: 0,0:19:28.70,0:19:33.63,Default,,0,0,0,,Мұнда тұратын адамдардың бір күні біздікінен мүлде бөлек.
Dialogue: 0,0:19:34.17,0:19:36.13,Default,,0,0,0,,Мына бейнені қараңыз
Dialogue: 0,0:19:36.96,0:19:39.13,Default,,0,0,0,,Теломез Т-1 күйінде болады
Dialogue: 0,0:19:39.26,0:19:40.97,Default,,0,0,0,,Сонымен қатар тыныс алу арқылы
Dialogue: 0,0:19:41.09,0:19:45.39,Default,,0,0,0,,Ағзадан шығарылады және маска ішіндегі сүзгі арқылы сіңеді
Dialogue: 0,0:19:45.81,0:19:48.97,Default,,0,0,0,,Жиналған Т-1 сұйық күйінде сақталады.
Dialogue: 0,0:19:49.10,0:19:53.94,Default,,0,0,0,,Әр қаланы TNJN-000 мұнарасына қосатын кабельдер арқылы
Dialogue: 0,0:19:54.06,0:19:55.73,Default,,0,0,0,,Астанаға жіберілді
Dialogue: 0,0:19:56.36,0:19:59.82,Default,,0,0,0,,Екінші жағынан, теломерлері жиналған жұмысшылардың жасушаларында,
Dialogue: 0,0:19:59.94,0:20:01.28,Default,,0,0,0,,Хейфлик шегі...
Dialogue: 0,0:20:01.40,0:20:03.78,Default,,0,0,0,,Жаңа көргеніңіздей.
Dialogue: 0,0:20:04.16,0:20:06.20,Default,,0,0,0,,Қарапайым тілмен айтқанда, барлығы...
Dialogue: 0,0:20:06.33,0:20:10.29,Default,,0,0,0,,Осы уақытқа дейін астаналықтар менің өмірімді алып жатыр.
Dialogue: 0,0:20:10.62,0:20:13.83,Default,,0,0,0,,Ересектер кенет қартайып, денесі әлсірейді.
Dialogue: 0,0:20:13.96,0:20:16.84,Default,,0,0,0,,Мұның бәрі осы жүйенің арқасында болды.
Dialogue: 0,0:20:17.13,0:20:21.42,Default,,0,0,0,,Елордалықтар мұны барлығынан жасырып, пайдаланып жатыр.
Dialogue: 0,0:20:21.55,0:20:24.93,Default,,0,0,0,,Олар бізден бірнеше есе көп өмір сүреді!
Dialogue: 0,0:20:25.30,0:20:27.85,Default,,0,0,0,,Бұл мүлдем дұрыс емес!
Dialogue: 0,0:20:28.43,0:20:31.81,Default,,0,0,0,,Ендеше бәріміз осы әлемді өзгертейік!
Dialogue: 0,0:20:32.98,0:20:36.90,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:20:37.02,0:20:39.32,Default,,0,0,0,,Ол не деді?
Dialogue: 0,0:20:37.77,0:20:38.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:39.44,0:20:41.86,Default,,0,0,0,,Өмір сүру ұзақтығы немесе ұзақ өмір сүру?
Dialogue: 0,0:20:42.49,0:20:45.99,Default,,0,0,0,,Дұрыс емес пе? Біздің өміріміз ше?
Dialogue: 0,0:20:46.12,0:20:48.49,Default,,0,0,0,,Бұл менің бірдеңе дұрыс емес екенін білдіре ме?
Dialogue: 0,0:20:48.62,0:20:51.87,Default,,0,0,0,,Олай емес! Оған астаналықтар кінәлі.
Dialogue: 0,0:20:52.37,0:20:55.46,Default,,0,0,0,,Барлығы құрбан болды! Өмір мені сорып алды!
Dialogue: 0,0:20:55.58,0:21:00.09,Default,,0,0,0,,Өмір деген... Кенеттен осылай айтсаң да, солай емес пе?
Dialogue: 0,0:21:00.21,0:21:02.51,Default,,0,0,0,,Готчаның жалғасын көрмейсіз бе?
Dialogue: 0,0:21:02.63,0:21:04.38,Default,,0,0,0,,Сәлем... бәрі...
Dialogue: 0,0:21:02.63,0:21:04.93,Default,,0,0,0,,(Тұрғындардың наразылық дауыстары)
Dialogue: 0,0:21:05.01,0:21:08.89,Default,,0,0,0,,Сіз мені тыңдадыңыз, солай ма? Күлкілі емес пе? Мүлдем!
Dialogue: 0,0:21:09.01,0:21:10.18,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:21:10.31,0:21:13.18,Default,,0,0,0,,Мен сіз айтып отырған жағдайды түсіндім.
Dialogue: 0,0:21:13.31,0:21:14.89,Default,,0,0,0,,Тек... не істеуім керек?
Dialogue: 0,0:21:15.23,0:21:18.77,Default,,0,0,0,,Сонымен! Сіз мен сияқты бірдеңе істеуіңіз керек!
Dialogue: 0,0:21:18.90,0:21:22.32,Default,,0,0,0,,Ресурстарды жинауды тоқтатыңыз, бетперде кимеңіз...
Dialogue: 0,0:21:19.19,0:21:24.15,Default,,0,0,0,,Уааааааааааааааааааааааа?
Dialogue: 0,0:21:22.44,0:21:24.90,Default,,0,0,0,,Иә! Қаладан кет және осында кел!
Dialogue: 0,0:21:25.03,0:21:28.37,Default,,0,0,0,,Ресурстарды жинауды тоқтатсақ, өмірімізді не істеуіміз керек?
Dialogue: 0,0:21:28.49,0:21:31.66,Default,,0,0,0,,Сіз электр қуатын пайдалана алмайсыз немесе тамақ сатып ала алмайсыз...
Dialogue: 0,0:21:31.79,0:21:34.91,Default,,0,0,0,,Кішкентай балаларымыз бар, сондықтан қаладан шыға алмаймыз.
Dialogue: 0,0:21:35.04,0:21:37.67,Default,,0,0,0,,Біріншіден, мен бұл қаладан кеткім келмейді деп ойлаймын.
Dialogue: 0,0:21:38.04,0:21:41.17,Default,,0,0,0,,Бетперде тақпасаң, өкпең зақымдалады.
Dialogue: 0,0:21:41.30,0:21:43.63,Default,,0,0,0,,Кешіріңіз, Готча келе жатыр еді.
Dialogue: 0,0:21:43.76,0:21:44.76,Default,,0,0,0,,Сәлем Gear!
Dialogue: 0,0:21:44.88,0:21:48.59,Default,,0,0,0,,Түсінбеген нәрсені айтпа, тез үйге кел!
Dialogue: 0,0:21:48.72,0:21:52.85,Default,,0,0,0,,Неге... неге! Сіз бейнені көрдіңіз.
Dialogue: 0,0:21:48.72,0:21:52.85,Default,,0,0,0,,(Тұрғындардың шағымдары)
Dialogue: 0,0:21:52.97,0:21:54.14,Default,,0,0,0,,Мұндағы адамдар бәрінен де жақсы.
Dialogue: 0,0:21:54.27,0:21:56.44,Default,,0,0,0,,Мен өзім үшін жақсы өмір сүрдім!
Dialogue: 0,0:21:56.56,0:21:58.10,Default,,0,0,0,,Тек барлығына жұмыс істеуге рұқсат етіңіз!
Dialogue: 0,0:21:58.23,0:22:00.19,Default,,0,0,0,,Мен жұмыс істегенді жек көрмеймін.
Dialogue: 0,0:21:59.73,0:22:00.69,Default,,0,0,0,,Ах
Dialogue: 0,0:22:00.31,0:22:02.32,Default,,0,0,0,,Жақсы өмір болса да
Dialogue: 0,0:22:01.19,0:22:04.69,Default,,0,0,0,,Барлығы... ойланып көріңізші!
Dialogue: 0,0:22:02.44,0:22:04.69,Default,,0,0,0,,Бұл мүлдем қызық емес сияқты.
Dialogue: 0,0:22:05.07,0:22:06.36,Default,,0,0,0,,Әйтпесе, біз
Dialogue: 0,0:22:05.07,0:22:07.99,Default,,0,0,0,,Маған айқайлама...
Dialogue: 0,0:22:06.49,0:22:09.70,Default,,0,0,0,,Неге сонша еңбек еткеніңді білмейсің!
Dialogue: 0,0:22:09.82,0:22:12.24,Default,,0,0,0,,Егер сізге кенеттен әлемді өзгерту туралы айтылған болса да
Dialogue: 0,0:22:12.37,0:22:14.58,Default,,0,0,0,,Мен қазіргі өмірімнен оңай бас тарта алмаймын.
Dialogue: 0,0:22:14.70,0:22:16.41,Default,,0,0,0,,Әдетте солай емес пе?
Dialogue: 0,0:22:16.54,0:22:18.50,Default,,0,0,0,,Менің ойымша, бұл жақсы болды.
Dialogue: 0,0:22:18.62,0:22:21.71,Default,,0,0,0,,Бұны естігеннен кейін бәрі қиындыққа тап болады деп ойламайсыз ба?
Dialogue: 0,0:22:21.84,0:22:24.21,Default,,0,0,0,,Неге олай дедің?
Dialogue: 0,0:22:24.34,0:22:25.71,Default,,0,0,0,,Мен мұны сұраған жоқпын
Dialogue: 0,0:22:25.84,0:22:28.63,Default,,0,0,0,,Біз қазіргідей қалуымыз керек пе?
Dialogue: 0,0:22:28.76,0:22:29.76,Default,,0,0,0,,О
Dialogue: 0,0:22:37.23,0:22:38.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:46.03,0:22:47.11,Default,,0,0,0,,Беріліс
Dialogue: 0,0:22:46.61,0:22:47.61,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:48.95,0:22:51.91,Default,,0,0,0,,Сондықтан да мағынасыз дедім.
Dialogue: 0,0:23:00.46,0:23:05.63,Default,,0,0,0,,(Байланыс құрылғысының шуы)
Dialogue: 0,0:23:03.29,0:23:05.63,Default,,0,0,0,,Осы коммуникаторды ұстаңыз.
Dialogue: 0,0:23:05.75,0:23:08.92,Default,,0,0,0,,Уәде бойынша әкеңнің тұрған жерін хабарлаймын.
Dialogue: 0,0:23:09.05,0:23:10.84,Default,,0,0,0,,Бұл жаңғырық 2
Dialogue: 0,0:23:09.05,0:23:10.05,Default,,0,0,0,,(Байланыс құрылғысын қабылдау дыбысы)
Dialogue: 0,0:23:11.34,0:23:13.80,Default,,0,0,0,,TNJN Tower-те қаңғыбас итті қорғаңыз
Dialogue: 0,0:23:13.93,0:23:17.31,Default,,0,0,0,,Аты «Такада қош бол Адиос Хайхай Таро»
Dialogue: 0,0:23:17.43,0:23:21.02,Default,,0,0,0,,Ақ аю костюмін кию Қайталау
Dialogue: 0,0:23:21.15,0:23:24.32,Default,,0,0,0,,TNJN мұнарасында қаңғыбас ит қорғалған
Dialogue: 0,0:23:24.44,0:23:27.82,Default,,0,0,0,,Аты «Такада қош бол Адиос Хайхай Таро»
Dialogue: 0,0:23:27.94,0:23:30.36,Default,,0,0,0,,Ақ аю костюмін киіңіз
Dialogue: 0,0:23:31.53,0:23:35.87,Default,,0,0,0,,Кешіріңіз, Носа-ни мен үшін көп еңбек етті.
Dialogue: 0,0:23:38.58,0:23:39.87,Default,,0,0,0,,Носа апа?
Dialogue: 0,0:23:42.92,0:23:47.38,Default,,0,0,0,,Тісті... Носа кетті.
Dialogue: 0,0:23:47.84,0:23:48.84,Default,,0,0,0,,Га
Dialogue: 0,0:23:50.93,0:23:53.14,Default,,0,0,0,,♪～
