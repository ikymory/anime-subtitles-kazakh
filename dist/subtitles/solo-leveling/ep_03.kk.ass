Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.94,0:00:17.95,Default,,0,0,0,,Каха….
Dialogue: 0,0:00:17.95,0:00:19.95,Default,,0,0,0,,Аа….
Dialogue: 0,0:00:21.95,0:00:25.95,Default,,0,0,0,,А... аа....
Dialogue: 0,0:00:25.95,0:00:27.96,Default,,0,0,0,,《Тағы да...》
Dialogue: 0,0:00:36.47,0:00:37.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:37.97,0:00:40.47,Default,,0,0,0,,《Егер менің тағы бір мүмкіндігім болса...》
Dialogue: 0,0:00:41.97,0:00:43.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:43.47,0:00:48.48,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:00:48.48,0:00:50.98,Default,,0,0,0,,《Аурухана? Ха...》
Dialogue: 0,0:00:52.98,0:00:54.48,Default,,0,0,0,,《Бар…》
Dialogue: 0,0:01:00.99,0:01:02.49,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:02.49,0:01:04.49,Default,,0,0,0,,《Аяқтар да...》
Dialogue: 0,0:01:06.50,0:01:09.50,Default,,0,0,0,,《Кеудеге пышақ салған ештеңе емес...》
Dialogue: 0,0:01:09.50,0:01:12.50,Default,,0,0,0,,Бұл арман болды ма?
Dialogue: 0,0:01:12.50,0:01:14.94,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:01:14.94,0:01:18.44,Default,,0,0,0,,О, сіз байқаған сияқтысыз.
Dialogue: 0,0:01:18.44,0:01:20.94,Default,,0,0,0,,Ум...
Dialogue: 0,0:01:20.94,0:01:25.45,Default,,0,0,0,,Менің атым Инукай, мен Аңшылар қауымдастығының мониторинг бөлімінің менеджерімін.
Dialogue: 0,0:01:25.45,0:01:26.95,Default,,0,0,0,,Бұл Домон.
Dialogue: 0,0:01:26.95,0:01:28.95,Default,,0,0,0,,Бақылау бөлімі.
Dialogue: 0,0:01:28.95,0:01:34.96,Default,,0,0,0,,Неліктен ... жақсы? Мен қазір дәрігер шақырамын.
Dialogue: 0,0:01:34.96,0:01:39.96,Default,,0,0,0,,♬ (Тақырыпты ашу)
Dialogue: 0,0:01:39.96,0:03:02.98,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:05.88,0:03:09.89,Default,,0,0,0,,Не... Мен үш күн бойы ес-түссіз жаттым! ?
Dialogue: 0,0:03:09.89,0:03:13.39,Default,,0,0,0,,Мизуки мырза мен Мабучи мырза... екеуі де жақсы ма?
Dialogue: 0,0:03:13.39,0:03:15.89,Default,,0,0,0,,Иә, жай ғана…➡
Dialogue: 0,0:03:15.89,0:03:18.89,Default,,0,0,0,,Аңшы Мабучи қолынан айырылды➡
Dialogue: 0,0:03:18.89,0:03:22.90,Default,,0,0,0,,Мен зейнетке шығуға мәжбүр болуым мүмкін➡
Dialogue: 0,0:03:22.90,0:03:25.90,Default,,0,0,0,,Мизуки Хантер қатты психикалық шок➡
Dialogue: 0,0:03:25.90,0:03:27.90,Default,,0,0,0,,Мен емделіп жатырмын. ➡
Dialogue: 0,0:03:27.90,0:03:32.41,Default,,0,0,0,,Егер ол солай көрінсе, ол аңшы қызметін жалғастыра ала ма деп ойлаймын...
Dialogue: 0,0:03:39.41,0:03:43.42,Default,,0,0,0,,Бұл жолы қос зынданнан тірі оралған адам –➡
Dialogue: 0,0:03:43.42,0:03:45.42,Default,,0,0,0,,Тек 6 адам.
Dialogue: 0,0:03:45.42,0:03:48.92,Default,,0,0,0,,Аңшыларға әрқашан қауіп төнеді➡
Dialogue: 0,0:03:48.92,0:03:51.93,Default,,0,0,0,,Мұндай көлемдегі апаттар сирек кездеседі. ➡
Dialogue: 0,0:03:51.93,0:03:55.93,Default,,0,0,0,,Әйтеуір... ➡
Dialogue: 0,0:03:55.93,0:03:58.43,Default,,0,0,0,,Тірі қалған адамнан есеп алды➡
Dialogue: 0,0:03:58.43,0:04:01.94,Default,,0,0,0,,Мен Бякко гильдиясымен бірге оқиға орнына барған кезде ол әлдеқашан...
Dialogue: 0,0:04:05.87,0:04:08.88,Default,,0,0,0,,Мизушино Хантер сол жерде жатты➡
Dialogue: 0,0:04:08.88,0:04:13.38,Default,,0,0,0,,Тіпті храмдар мен тас мүсіндердің ізі де қалмады.
Dialogue: 0,0:04:13.38,0:04:16.38,Default,,0,0,0,,Міне... Сене алмайсың.
Dialogue: 0,0:04:17.89,0:04:21.89,Default,,0,0,0,,Тірі қалғандардың айғақтарында тіпті шамалы сәйкессіздіктер бар➡
Dialogue: 0,0:04:21.89,0:04:25.39,Default,,0,0,0,,Оқиға орнында жәбірленушінің денесінің бір бөлігі қалмаса➡
Dialogue: 0,0:04:25.39,0:04:29.40,Default,,0,0,0,,Мен сізге күмәнданатын болдым.
Dialogue: 0,0:04:29.40,0:04:31.90,Default,,0,0,0,,Иә? (Инукай) Айтпақшы➡
Dialogue: 0,0:04:31.90,0:04:34.90,Default,,0,0,0,,Бұл біздің болжамымыз ғана...
Dialogue: 0,0:04:36.40,0:04:38.91,Default,,0,0,0,,Mizushino Hunter You➡
Dialogue: 0,0:04:38.91,0:04:42.41,Default,,0,0,0,,Оянғаннан кейінгі ояну емес пе?
Dialogue: 0,0:04:42.41,0:04:45.91,Default,,0,0,0,,《Ха... Оянғаннан кейін ояну! ? 》
Dialogue: 0,0:04:47.92,0:04:50.92,Default,,0,0,0,,《Аңшының қабілет мәндері ояну кезінде анықталады➡
Dialogue: 0,0:04:50.92,0:04:53.42,Default,,0,0,0,,Ол ешқашан өзгермейді. ➡
Dialogue: 0,0:04:53.42,0:04:57.93,Default,,0,0,0,,Дегенмен, анда-санда оянатын аңшылар да бар сияқты. ➡
Dialogue: 0,0:04:57.93,0:05:01.93,Default,,0,0,0,,Ол өз шегінен асып, А немесе S классына айналуы мүмкін... ➡
Dialogue: 0,0:05:01.93,0:05:03.93,Default,,0,0,0,,Мүмкін мен де! ? 》
Dialogue: 0,0:05:03.93,0:05:05.87,Default,,0,0,0,,(бірдеңені қою дыбысы)
Dialogue: 0,0:05:05.87,0:05:07.87,Default,,0,0,0,,Сиқырлы қуатты өлшейтін құрылғы. ➡
Dialogue: 0,0:05:07.87,0:05:09.87,Default,,0,0,0,,Қолыңызды осында ұстаңыз.
Dialogue: 0,0:05:11.37,0:05:13.38,Default,,0,0,0,,《Тірі қалғандардың куәлігі бойынша➡
Dialogue: 0,0:05:13.38,0:05:15.88,Default,,0,0,0,,Егер ол жерде сізді бірден өлтіретін құбыжық болса➡
Dialogue: 0,0:05:15.88,0:05:18.88,Default,,0,0,0,,Төменгі аңшының аман қалуы мүмкін емес. ➡
Dialogue: 0,0:05:18.88,0:05:21.38,Default,,0,0,0,,Оның із-түзсіз жоғалып кеткені➡
Dialogue: 0,0:05:21.38,0:05:25.89,Default,,0,0,0,,А-сыныпсыз...жоқ, S-сыныпты аңшысыз мүмкін емес еді. ➡
Dialogue: 0,0:05:25.89,0:05:29.39,Default,,0,0,0,,Біз алдымен Мизушино Хантердің қайта оянғанына күдіктенуіміз керек.
Dialogue: 0,0:05:29.39,0:05:31.39,Default,,0,0,0,,(Өлшем дыбысы)
Dialogue: 0,0:05:33.40,0:05:37.40,Default,,0,0,0,,Сіз қалай ойлайсыз? Егер сіз қайта оянсаңыз, сіздің дәрежеңіз қандай?
Dialogue: 0,0:05:37.40,0:05:41.90,Default,,0,0,0,,Мен өте дөрекі нәрсе істеген сияқтымын.
Dialogue: 0,0:05:41.90,0:05:43.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:43.41,0:05:46.91,Default,,0,0,0,,(Domon) Е класы әдетте 70➡ жоғары болса да
Dialogue: 0,0:05:46.91,0:05:49.91,Default,,0,0,0,,Бұл қарапайым адаммен бірдей емес пе?
Dialogue: 0,0:05:49.91,0:05:53.92,Default,,0,0,0,,(Инукай) 《Зынданда жоғалып кетті, оны қайта қарау мүмкін емес. ➡
Dialogue: 0,0:05:53.92,0:05:56.42,Default,,0,0,0,,Ол қалай аман қалды? 》
Dialogue: 0,0:05:56.42,0:05:59.92,Default,,0,0,0,,Не, сен мұны күткенсің...?
Dialogue: 0,0:06:01.42,0:06:03.43,Default,,0,0,0,,《Одан да әлгі адамдар➡
Dialogue: 0,0:06:03.43,0:06:05.93,Default,,0,0,0,,Бұл сізді алаңдатпады ма? 》
Dialogue: 0,0:06:07.86,0:06:10.87,Default,,0,0,0,,Мұны мен ғана көре аламын ба?
Dialogue: 0,0:06:12.87,0:06:14.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:14.37,0:06:15.87,Default,,0,0,0,,《Бұл сенсорлық панель емес пе...》
Dialogue: 0,0:06:15.87,0:06:17.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:30.89,0:06:32.39,Default,,0,0,0,,《Ол кезде осылай болғанына сенімдімін...》
Dialogue: 0,0:06:32.39,0:06:34.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:34.39,0:06:37.39,Default,,0,0,0,,Ой…. (Аой) Күрсіну….
Dialogue: 0,0:06:37.39,0:06:41.90,Default,,0,0,0,,(Аои) Денеңізді жақсырақ күтіңіз! Сен қатты уайымдадың!
Dialogue: 0,0:06:41.90,0:06:43.40,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:06:43.40,0:06:45.40,Default,,0,0,0,,Басқалары жақсы➡
Dialogue: 0,0:06:45.40,0:06:47.90,Default,,0,0,0,,Тек менің ағам ылғи тоз-тоз болып жүр! ➡
Dialogue: 0,0:06:47.90,0:06:49.90,Default,,0,0,0,,Мен сен үшін алаңдаймын!
Dialogue: 0,0:06:49.90,0:06:52.91,Default,,0,0,0,,``Мен өлуге және әпкемді артта қалдыруға дайын болғаныма сене алмаймын...''
Dialogue: 0,0:06:52.91,0:06:56.41,Default,,0,0,0,,Бірдеңе дұрыс емес пе? Келесі жолы бірдеңе қайталанса➡
Dialogue: 0,0:06:56.41,0:06:58.41,Default,,0,0,0,,Менің ағам аңшы болып жұмыс істемеуі үшін➡
Dialogue: 0,0:06:58.41,0:07:00.92,Default,,0,0,0,,Мен оқуды тастап, жұмыс істеймін!
Dialogue: 0,0:07:00.92,0:07:04.42,Default,,0,0,0,,Түсіндім, түсінемін, кешіріңіз. Айтпақшы, Аои➡
Dialogue: 0,0:07:04.42,0:07:06.86,Default,,0,0,0,,Мұны көре аласыз ба? Бұл не?
Dialogue: 0,0:07:06.86,0:07:09.36,Default,,0,0,0,,Жаман ештеңе.
Dialogue: 0,0:07:09.36,0:07:13.36,Default,,0,0,0,,Мысалы, сізде ойында оқылмаған хабар бар делік.
Dialogue: 0,0:07:13.36,0:07:15.36,Default,,0,0,0,,Иә? ойын?
Dialogue: 0,0:07:15.36,0:07:17.87,Default,,0,0,0,,Мұны қалай оқуым керек?
Dialogue: 0,0:07:17.87,0:07:19.87,Default,,0,0,0,,Сіз де бас емтиханынан өтесіз бе?
Dialogue: 0,0:07:19.87,0:07:22.37,Default,,0,0,0,,Аои: Мен тек ойын ойнайтынмын.
Dialogue: 0,0:07:22.37,0:07:26.37,Default,,0,0,0,,Менің ойымша... неге жай ғана хабар терезесін ашпасқа?
Dialogue: 0,0:07:26.37,0:07:29.88,Default,,0,0,0,,Хабарлама терезесін ашу керек пе? (электронды дыбыс)
Dialogue: 0,0:07:29.88,0:07:34.38,Default,,0,0,0,,(Аои) Неге кенет ойындар туралы айтып жатырсың? А, жоқ... Мен ауруханадамын, бос уақытым бар.
Dialogue: 0,0:07:34.38,0:07:38.89,Default,,0,0,0,,《Сіз ол кезде ойыншылардың мән бермегенін айттыңыз...》
Dialogue: 0,0:07:38.89,0:07:42.89,Default,,0,0,0,,Сыртынан қарағанда, қазір бәрі жақсы сияқты. Мен сонда барамын.
Dialogue: 0,0:07:44.89,0:07:46.90,Default,,0,0,0,,Рин Күткеніңізге рахмет.
Dialogue: 0,0:07:48.40,0:07:51.90,Default,,0,0,0,,«Бұл жүйе ойыншының өсуін қолдайды.➡
Dialogue: 0,0:07:51.90,0:07:53.90,Default,,0,0,0,,Осы жүйенің нұсқауларына жауап бермесеңіз➡
Dialogue: 0,0:07:53.90,0:07:56.91,Default,,0,0,0,,Айыппұл салынуы мүмкін. ➡
Dialogue: 0,0:07:56.91,0:07:58.91,Default,,0,0,0,,Маған ақша төленді»?
Dialogue: 0,0:07:58.91,0:08:02.41,Default,,0,0,0,,​​Нені меңзеп тұрғаныңызды түсінбеймін.
Dialogue: 0,0:08:02.41,0:08:05.35,Default,,0,0,0,,«Күнделікті квест: күшті болуды мақсат ету»?
Dialogue: 0,0:08:05.35,0:08:07.85,Default,,0,0,0,,Растау.
Dialogue: 0,0:08:07.85,0:08:11.35,Default,,0,0,0,,«Отырғызу, отыру, еңкейу, жүгіру.»➡
Dialogue: 0,0:08:11.35,0:08:15.36,Default,,0,0,0,,Егер сіз олардың барлығын орындай алмасаңыз, сізге айыппұл салынады »?
Dialogue: 0,0:08:15.36,0:08:20.36,Default,,0,0,0,,Хаха... Бұл не? Әзілдеріңізді қалыпты жағдайда ұстаңыз.
Dialogue: 0,0:08:20.36,0:08:24.37,Default,,0,0,0,,Мен ауруханада жатқанда мұндай төзімділікке ие болуым мүмкін емес.
Dialogue: 0,0:08:24.37,0:08:26.87,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:08:28.37,0:08:30.87,Default,,0,0,0,,Мизушино Хантер мысал ретінде➡
Dialogue: 0,0:08:30.87,0:08:34.88,Default,,0,0,0,,Оның қайта оянғанының белгісі жоқ, Гото төрағасы.
Dialogue: 0,0:08:34.88,0:08:36.38,Default,,0,0,0,,📱 (Өту) Түсіндім. ➡
Dialogue: 0,0:08:36.38,0:08:39.88,Default,,0,0,0,,Бұл зынданды бұзуға әкелмеуі бақыт болды➡
Dialogue: 0,0:08:39.88,0:08:43.39,Default,,0,0,0,,Бұл іс бойынша түсініксіз нәрселер тым көп.
Dialogue: 0,0:08:43.39,0:08:47.39,Default,,0,0,0,,Иә, бұл әзірге ешбір жағдайға қатысты емес.
Dialogue: 0,0:08:47.39,0:08:50.39,Default,,0,0,0,,📱 (Гото) Зынданда белгісіз көп болғанымен... ➡
Dialogue: 0,0:08:50.39,0:08:53.40,Default,,0,0,0,,Түсінемін, бұл іс ерекше жағдай➡
Dialogue: 0,0:08:53.40,0:08:56.40,Default,,0,0,0,,Деректер банкінде тіркелу және қайта қарау туралы сұрау.
Dialogue: 0,0:08:56.40,0:08:58.40,Default,,0,0,0,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:08:59.90,0:09:01.40,Default,,0,0,0,,Уф….
Dialogue: 0,0:09:01.40,0:09:03.41,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:09:07.84,0:09:12.85,Default,,0,0,0,,(Могами) Косака мырза, келесі В класындағы рейдке нұсқаушы ретінде қатысуыңызды сұраймыз.
Dialogue: 0,0:09:12.85,0:09:15.35,Default,,0,0,0,,Сіз нұсқаушысыз ба...?
Dialogue: 0,0:09:15.35,0:09:18.85,Default,,0,0,0,,Бұл рейд сонымен қатар жаңа қызметкерлерді оқыту және жұмыс орнында оқыту ретінде қызмет етеді.
Dialogue: 0,0:09:18.85,0:09:20.36,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:09:20.36,0:09:23.86,Default,,0,0,0,,Мен көшбасшы болу үшін кесілген деп ойламаймын...
Dialogue: 0,0:09:23.86,0:09:26.86,Default,,0,0,0,,Кәдімгідей күресе берсең, бәрі жақсы болады.
Dialogue: 0,0:09:26.86,0:09:31.87,Default,,0,0,0,,Әркім, артыңа қарап, үйрен. Сізде сонша қабілет бар.
Dialogue: 0,0:09:33.37,0:09:35.37,Default,,0,0,0,,Біз, Аңшылар Гильдиясы,➡
Dialogue: 0,0:09:35.37,0:09:38.37,Default,,0,0,0,,Ол Жапониядағы бес негізгі гильдияға кіреді➡
Dialogue: 0,0:09:38.37,0:09:40.88,Default,,0,0,0,,Жаһандық тұрғыдан алғанда, ол әлі де жеткіліксіз.
Dialogue: 0,0:09:40.88,0:09:43.88,Default,,0,0,0,,Жеке тұлғалардың дәрежесін көтеру мүмкін емес➡
Dialogue: 0,0:09:43.88,0:09:47.38,Default,,0,0,0,,Тәжірибелік дағдыларыңызды жақсартуға болады.
Dialogue: 0,0:09:47.38,0:09:50.89,Default,,0,0,0,,Алдағы уақытта.
Dialogue: 0,0:09:56.39,0:09:57.89,Default,,0,0,0,,Әй? ➡
Dialogue: 0,0:09:57.89,0:09:59.89,Default,,0,0,0,,Басқа қақпа?
Dialogue: 0,0:10:01.90,0:10:04.40,Default,,0,0,0,,Осындай жерде қақпа пайда бола ма?
Dialogue: 0,0:10:04.40,0:10:08.40,Default,,0,0,0,,Сіз әлі аңшысыз ба? (Еркек) Тез бірдеңе істейік.
Dialogue: 0,0:10:10.41,0:10:14.91,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,0:10:18.91,0:10:20.42,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:10:20.42,0:10:22.42,Default,,0,0,0,,Хмм…. (жердің шуылдауы)
Dialogue: 0,0:10:22.42,0:10:23.92,Default,,0,0,0,,Джи… Жер сілкінісі! ? (жердің шуылдауы)
Dialogue: 0,0:10:23.92,0:10:26.92,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:10:26.92,0:10:28.42,Default,,0,0,0,,Уау! (жердің шуылдауы)
Dialogue: 0,0:10:30.43,0:10:33.43,Default,,0,0,0,,Хмм… аа….
Dialogue: 0,0:10:33.43,0:10:35.43,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:35.43,0:10:38.43,Default,,0,0,0,,Ал... шөл! ? Не болып жатыр?
Dialogue: 0,0:10:38.43,0:10:41.94,Default,,0,0,0,,Бұл түс пе? Дәл қазір аурухана бөлмесінде...
Dialogue: 0,0:10:50.45,0:10:52.45,Default,,0,0,0,,Тіпті Ұлы науқан кезінде, Лугника патшалығы экспедициялық корпус ұйымдастырған кезде—
Dialogue: 0,0:10:54.45,0:10:56.95,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:10:59.45,0:11:01.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:01.46,0:11:04.46,Default,,0,0,0,,(Медбике) Не болды? (Медбике) Бұл бөлмедегі науқас...
Dialogue: 0,0:11:04.46,0:11:05.89,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:05.89,0:11:08.40,Default,,0,0,0,,Ха-ха… Уау… Қарғыс атсын….
Dialogue: 0,0:11:08.40,0:11:12.40,Default,,0,0,0,,Хахаха... Уф!
Dialogue: 0,0:11:12.40,0:11:15.40,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:11:15.40,0:11:18.91,Default,,0,0,0,,Уау! !
Dialogue: 0,0:11:22.91,0:11:25.91,Default,,0,0,0,,Қазірдің өзінде қаншасы бар?
Dialogue: 0,0:11:25.91,0:11:28.92,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:11:28.92,0:11:31.42,Default,,0,0,0,,Әлі екі сағат қалды! ?
Dialogue: 0,0:11:31.42,0:11:33.92,Default,,0,0,0,,(Медбике) Сіз сондасыз ба? (Медбике) Жоқ, мұнда...
Dialogue: 0,0:11:33.92,0:11:35.92,Default,,0,0,0,,Мен бөлмені қайта тінтемін.
Dialogue: 0,0:11:35.92,0:11:37.43,Default,,0,0,0,,Иә... ➡
Dialogue: 0,0:11:37.43,0:11:40.93,Default,,0,0,0,,Менің ойымша, ол ешқашан ауруханадан шыққан жоқ...
Dialogue: 0,0:11:40.93,0:11:43.93,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:11:43.93,0:11:46.43,Default,,0,0,0,,Мен енді мұны істей алмаймын... Мен өз шегімдемін...
Dialogue: 0,0:11:46.43,0:11:47.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:47.94,0:11:57.45,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:57.45,0:11:59.45,Default,,0,0,0,,Уау! !
Dialogue: 0,0:11:59.45,0:12:04.45,Default,,0,0,0,,Қарғыс атқыр... ха ха ха ха...
Dialogue: 0,0:12:04.45,0:12:06.39,Default,,0,0,0,,Әй... ой...
Dialogue: 0,0:12:06.39,0:12:08.39,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:12:08.39,0:12:10.89,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:12:10.89,0:12:13.39,Default,,0,0,0,,Айыппұл… Квест….
Dialogue: 0,0:12:13.39,0:12:14.90,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:12:17.40,0:12:19.40,Default,,0,0,0,,Мизушино мырза! ? ➡
Dialogue: 0,0:12:19.40,0:12:21.90,Default,,0,0,0,,Мизушино-сан, жақсысың ба? ?
Dialogue: 0,0:12:30.81,0:12:35.48,Default,,0,0,0,,Иә, сіздің үлгеріміңіз жақсы. Біраз уақыттан кейін ауруханадан шығасың деп ойлаймын.
Dialogue: 0,0:12:35.48,0:12:36.99,Default,,0,0,0,,📱(Aoi) Жақсы. ➡
Dialogue: 0,0:12:36.99,0:12:40.49,Default,,0,0,0,,Мен сені қатты уайымдадым, сондықтан ауруханадан шыққанда сені Шағалға емдеймін.
Dialogue: 0,0:12:40.49,0:12:42.99,Default,,0,0,0,,Иә, иә, түсінемін.
Dialogue: 0,0:12:44.99,0:12:46.10,Default,,0,0,0,,Ал, барамыз ба?
Dialogue: 0,0:12:48.50,0:12:51.50,Default,,0,0,0,,Не? Мен рейдтемін бе?
Dialogue: 0,0:12:51.50,0:12:56.00,Default,,0,0,0,,📱 (Қызметкерлер) Иә, бұл өткен күні Хатаока қаласында болған D класының қақпасы.
Dialogue: 0,0:12:56.00,0:12:59.94,Default,,0,0,0,,Өкінішке орай, барлық гильдиялар кетті... ➡
Dialogue: 0,0:12:59.94,0:13:02.44,Default,,0,0,0,,Әрине, бұл мүмкін емес деп айтпас едім. ➡
Dialogue: 0,0:13:02.44,0:13:05.95,Default,,0,0,0,,Мен Мизуки Хантердің жағдайын жақсы білемін.
Dialogue: 0,0:13:05.95,0:13:08.95,Default,,0,0,0,,(Мидзуки) Кешіріңіз... 📱(Қызметкерлер) Жоқ, уайымдамаңыз. ➡
Dialogue: 0,0:13:08.95,0:13:12.95,Default,,0,0,0,,Аа, дұрыс, сіз ояндыңыз. Дұрыс, Мизушино Хантер.
Dialogue: 0,0:13:12.95,0:13:14.96,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:13:14.96,0:13:16.96,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:13:21.96,0:13:25.97,Default,,0,0,0,,(Мидзуки)《Мизушино-сан, сенің жақсы болғаныңа қуаныштымын...》
Dialogue: 0,0:13:28.97,0:13:31.47,Default,,0,0,0,,Қараңызшы, ол қайтадан жүгіріп келеді.
Dialogue: 0,0:13:31.47,0:13:35.48,Default,,0,0,0,,Мен есін жиғаннан бері мұны күнде істеп жүрмін.
Dialogue: 0,0:13:35.48,0:13:37.98,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:13:37.98,0:13:39.98,Default,,0,0,0,,Мизушино мырза….
Dialogue: 0,0:13:39.98,0:13:43.99,Default,,0,0,0,,(Медбике) Аңшылар қарапайым адамдарға қарағанда тез жазылып кетеді дейді.
Dialogue: 0,0:13:43.99,0:13:46.49,Default,,0,0,0,,Ол өз денесін қайта жаттықтырғысы келеді. ➡
Dialogue: 0,0:13:46.49,0:13:48.99,Default,,0,0,0,,Өзіңді зорлама деп айтсам, тыңдама. ➡
Dialogue: 0,0:13:48.99,0:13:51.99,Default,,0,0,0,,Жаңа ғана ауыр жарақат алсам да. (Медбике) Бұл мәселе.
Dialogue: 0,0:13:51.99,0:13:53.49,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:13:53.49,0:13:57.00,Default,,0,0,0,,《Бүгін менің ес жиғаныма төртінші күн. ➡
Dialogue: 0,0:13:57.00,0:13:59.00,Default,,0,0,0,,Мен бірнеше нәрсені білдім. ➡
Dialogue: 0,0:13:59.00,0:14:03.44,Default,,0,0,0,,Біріншіден, менің көз алдымда көрген нәрсе галлюцинация емес сияқты. ➡
Dialogue: 0,0:14:03.44,0:14:06.94,Default,,0,0,0,,Күнделікті тапсырманы орындасаңыз, сіз үш сыйлық аласыз.
Dialogue: 0,0:14:06.94,0:14:09.44,Default,,0,0,0,,Жағдайды қалпына келтіру.
Dialogue: 0,0:14:09.44,0:14:12.45,Default,,0,0,0,,Менің шаршағаным бір сәтте жоғалады.
Dialogue: 0,0:14:12.45,0:14:16.45,Default,,0,0,0,,Уф... Келесі қабілет ұпайлары.
Dialogue: 0,0:14:16.45,0:14:19.95,Default,,0,0,0,,《Алған ұпайларыңызды сүйікті қабілеттеріңізге бөлуге болады. ➡
Dialogue: 0,0:14:19.95,0:14:22.96,Default,,0,0,0,,Менің ойымша, бұл бұлшықет күші. ➡
Dialogue: 0,0:14:22.96,0:14:25.46,Default,,0,0,0,,Қабілет құндылықтарыңызды неғұрлым жоғарылатсаңыз, соғұрлым күшті боласыз. ➡
Dialogue: 0,0:14:25.46,0:14:28.96,Default,,0,0,0,,Менің бұлшық ет күшім артқанын сеземін. ➡
Dialogue: 0,0:14:28.96,0:14:31.97,Default,,0,0,0,,Сондай-ақ дағдылар мен түгендеу экрандары бар. ➡
Dialogue: 0,0:14:31.97,0:14:35.97,Default,,0,0,0,,Қазір мен біртүрлі дүниенің куәсі болып отырмын.
Dialogue: 0,0:14:35.97,0:14:38.97,Default,,0,0,0,,Ха, бұл ойын сияқты.
Dialogue: 0,0:14:38.97,0:14:40.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:40.98,0:14:43.98,Default,,0,0,0,,Ахаха….
Dialogue: 0,0:14:43.98,0:14:45.48,Default,,0,0,0,,(Алманы тістеген дыбыс)
Dialogue: 0,0:14:45.48,0:14:49.48,Default,,0,0,0,,《Соңғы күнделікті квест сыйлығының кездейсоқ қорабы. ➡
Dialogue: 0,0:14:49.48,0:14:51.49,Default,,0,0,0,,Бүгін не шығады...》
Dialogue: 0,0:14:58.99,0:15:01.00,Default,,0,0,0,,Кілт пе?
Dialogue: 0,0:15:02.43,0:15:04.93,Default,,0,0,0,,Осы уақытқа дейін тек қалам мен таңғыштарды қолдандым➡
Dialogue: 0,0:15:04.93,0:15:08.44,Default,,0,0,0,,Бар болғаны бос сөз болды...
Dialogue: 0,0:15:08.44,0:15:11.44,Default,,0,0,0,,“Данға зындан”? Бұл не?
Dialogue: 0,0:15:13.44,0:15:17.95,Default,,0,0,0,,Осы уақытқа дейінгі ағымға қарағанда, бұл күшейетін оқиға болуы мүмкін, бірақ...
Dialogue: 0,0:15:19.45,0:15:21.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:21.45,0:15:24.45,Default,,0,0,0,,📺(Әйел) Енді бүгінгі қақпа індеті жағдайына тоқталайық. ➡
Dialogue: 0,0:15:24.45,0:15:27.96,Default,,0,0,0,,Сіз көріп отырған аймақтарда жаңа D класты қақпалар пайда болды. ➡
Dialogue: 0,0:15:27.96,0:15:29.96,Default,,0,0,0,,Джото ауданы және ➡
Dialogue: 0,0:15:29.96,0:15:33.96,Default,,0,0,0,,Чубу аймағындағы C класты қақпалар қазір шешілуде. ➡
Dialogue: 0,0:15:33.96,0:15:35.96,Default,,0,0,0,,Келесі күні порт аймағында оқиға орын алды➡
Dialogue: 0,0:15:35.96,0:15:39.47,Default,,0,0,0,,В класындағы қақпаға келетін болсақ, Аңшылар Гильдиясы жақында келеді➡
Dialogue: 0,0:15:39.47,0:15:41.97,Default,,0,0,0,,Біз рейд өткізуді жоспарлап отырмыз.
Dialogue: 0,0:15:41.97,0:15:46.47,Default,,0,0,0,,📱 Сондай-ақ кейбір көлік қозғалысына шектеулер болады...
Dialogue: 0,0:15:46.47,0:15:49.98,Default,,0,0,0,,(Ер) Енді не істеуіміз керек? (Еркек) Әзірше тамақ ішейік...
Dialogue: 0,0:15:49.98,0:15:53.48,Default,,0,0,0,,(Ер адам) Жарайды, мен штабқа қайтайын.
Dialogue: 0,0:16:02.92,0:16:04.43,Default,,0,0,0,,<Анашым! ➡
Dialogue: 0,0:16:04.43,0:16:07.43,Default,,0,0,0,,Анашым, оян! > <Не болды! ? ＞
Dialogue: 0,0:16:07.43,0:16:09.93,Default,,0,0,0,,<Анам оянбайды! ＞
Dialogue: 0,0:16:11.43,0:16:12.93,Default,,0,0,0,,<Батып бара жатырсыз ба? ＞
Dialogue: 0,0:16:12.93,0:16:16.44,Default,,0,0,0,,(Дәрігер) <Соңғы ұйқы деп те аталады. ➡
Dialogue: 0,0:16:16.44,0:16:19.44,Default,,0,0,0,,Қақпа пайда болғаннан бері байқалған ауру➡
Dialogue: 0,0:16:19.44,0:16:22.94,Default,,0,0,0,,Ол он мыңдаған адамның 1-інде кездеседі. ➡
Dialogue: 0,0:16:22.94,0:16:27.45,Default,,0,0,0,,Бір теорияға сәйкес, себеп мананың ұзақ уақыт әсер етуі. ➡
Dialogue: 0,0:16:27.45,0:16:31.45,Default,,0,0,0,,Кез келген жағдайда қазіргі медицина өмірді ұзартатын емдеуді қамтамасыз ету үшін барын салуда.
Dialogue: 0,0:16:31.45,0:16:33.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:33.45,0:16:35.46,Default,,0,0,0,,<Міне, сен жассың! ➡
Dialogue: 0,0:16:35.46,0:16:37.96,Default,,0,0,0,,Мазасыз болмаңыз! > <Иә! ＞
Dialogue: 0,0:16:49.97,0:16:51.97,Default,,0,0,0,,<Құттықтаймыз. ➡
Dialogue: 0,0:16:51.97,0:16:54.98,Default,,0,0,0,,Сіз аңшы мамандығына ие болдыңыз. ➡
Dialogue: 0,0:16:54.98,0:16:57.98,Default,,0,0,0,,Мен сіздің болашақ әрекеттеріңізді күтемін.＞
Dialogue: 0,0:16:57.98,0:16:59.48,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:59.48,0:17:03.42,Default,,0,0,0,,<Сен істедің, Аой! Осы арқылы мен анамның еміне ақша таба аламын! ＞
Dialogue: 0,0:17:03.42,0:17:05.92,Default,,0,0,0,,<Бірақ бұл қауіпті емес пе? ＞
Dialogue: 0,0:17:10.42,0:17:11.93,Default,,0,0,0,,<Уау!＞
Dialogue: 0,0:17:11.93,0:17:13.93,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:17:17.43,0:17:18.93,Default,,0,0,0,,<Не істеп жатырсың! ＞
Dialogue: 0,0:17:18.93,0:17:20.94,Default,,0,0,0,,(Аңшы) <Сен бұрышта тұра бер! ＞
Dialogue: 0,0:17:20.94,0:17:24.44,Default,,0,0,0,,(Аңшы)
Dialogue: 0,0:17:27.44,0:17:31.95,Default,,0,0,0,,<Мен саған айтамын, мен жұмыс істемейтін адаммен үйінді бөліскім келмейді! ＞
Dialogue: 0,0:17:37.45,0:17:39.45,Default,,0,0,0,,Қабілет ұпайлары….
Dialogue: 0,0:17:39.45,0:17:40.96,Default,,0,0,0,,Бұлшықет күші.
Dialogue: 0,0:17:51.47,0:17:53.47,Default,,0,0,0,,《Мен жабдықты дайындап қойдым. ➡
Dialogue: 0,0:17:53.47,0:17:56.47,Default,,0,0,0,,Мен істеуім керек нәрсені жасадым. ➡
Dialogue: 0,0:17:56.47,0:17:58.97,Default,,0,0,0,,Мен қашуға сенімдімін. ➡
Dialogue: 0,0:17:58.97,0:18:02.48,Default,,0,0,0,,Бұрынғыдай қауіпті көрінсе, бар жылдамдықпен қашайық.
Dialogue: 0,0:18:28.94,0:18:31.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:31.44,0:18:41.45,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:41.45,0:18:42.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:44.45,0:18:46.45,Default,,0,0,0,,Бірақ білесің бе, Коичи…
Dialogue: 0,0:18:46.45,0:18:47.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:47.96,0:18:51.46,Default,,0,0,0,,Шығу бұғатталды ма?
Dialogue: 0,0:18:51.46,0:18:52.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:56.96,0:19:00.90,Default,,0,0,0,,《Байқадым, бұл жер мүлдем басқа өлшемде. ➡
Dialogue: 0,0:19:00.90,0:19:04.41,Default,,0,0,0,,Инстанция зындандары жай ғана зындандар емес. ➡
Dialogue: 0,0:19:04.41,0:19:09.41,Default,,0,0,0,,Мен ол жерде ешқашан болған емеспін, бірақ бұл Red Gate концепциясына ұқсас болуы мүмкін.
Dialogue: 0,0:19:09.41,0:19:13.41,Default,,0,0,0,,Мен қашып кетуді ойладым➡
Dialogue: 0,0:19:13.41,0:19:15.42,Default,,0,0,0,,Бұдан қашып құтыла алмайсың!
Dialogue: 0,0:19:16.92,0:19:18.92,Default,,0,0,0,,«Қайтар тас»?
Dialogue: 0,0:19:18.92,0:19:23.92,Default,,0,0,0,,Не? Бұл бәрібір оны тазаламайынша кете алмайтыныңызды білдіре ме?
Dialogue: 0,0:19:23.92,0:19:26.43,Default,,0,0,0,,Мен тіпті E-сыныптағы құбыжықтарды жеңе алмаймын➡
Dialogue: 0,0:19:26.43,0:19:30.43,Default,,0,0,0,,Мен сізге зынданды өзіңіз тазалаңыз деп айтамын...
Dialogue: 0,0:19:31.93,0:19:36.94,Default,,0,0,0,,Мен шынымен де кешсіз жалғыз бастықпын ба?
Dialogue: 0,0:19:36.94,0:19:39.44,Default,,0,0,0,,Бірақ мұны істеуден басқа амалымыз жоқ!
Dialogue: 0,0:19:49.95,0:19:54.46,Default,,0,0,0,,Не істеуім керек... Мен өзімді әлсіз сезіне бастадым...
Dialogue: 0,0:19:54.46,0:19:56.46,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:19:56.46,0:19:58.96,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:19:58.96,0:20:00.96,Default,,0,0,0,,Бұл шықты! Және олардың үшеуі бар!
Dialogue: 0,0:20:00.96,0:20:02.96,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:02.96,0:20:04.47,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:20:04.47,0:20:43.00,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:43.00,0:20:46.51,Default,,0,0,0,,Уау! !
Dialogue: 0,0:20:52.51,0:20:54.52,Default,,0,0,0,,《Мен оны жеңе алдым...》
Dialogue: 0,0:20:54.52,0:21:04.46,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:04.46,0:21:06.46,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:21:08.46,0:21:12.47,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:21:12.47,0:21:17.97,Default,,0,0,0,,Хахаха... Мен күшейіп келемін.
Dialogue: 0,0:21:20.47,0:21:21.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:28.48,0:21:30.99,Default,,0,0,0,,《Қасқыр…. ➡
Dialogue: 0,0:21:30.99,0:21:33.99,Default,,0,0,0,,Сезім арқылы білуге болады. ➡
Dialogue: 0,0:21:33.99,0:21:38.99,Default,,0,0,0,,Бұрынғы гоблиннен әлдеқайда күшті》
Dialogue: 0,0:21:38.99,0:21:40.10,Default,,0,0,0,,Уф… аа….
Dialogue: 0,0:21:40.10,0:21:44.00,Default,,0,0,0,,Менің аяғым... қозғалмайды...
Dialogue: 0,0:21:44.00,0:21:46.00,Default,,0,0,0,,«Неге?» ➡
Dialogue: 0,0:21:46.00,0:21:49.00,Default,,0,0,0,,Сіз қорқасыз ба? ➡
Dialogue: 0,0:21:49.00,0:21:51.51,Default,,0,0,0,,Мен жарақат жоқ деп ойладым...》
Dialogue: 0,0:21:53.01,0:21:54.51,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:21:54.51,0:21:57.01,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:21:57.01,0:21:59.01,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:59.01,0:22:01.45,Default,,0,0,0,,Аһ!
Dialogue: 0,0:22:01.45,0:22:03.95,Default,,0,0,0,,《Емші де жоқ... ➡
Dialogue: 0,0:22:03.95,0:22:06.95,Default,,0,0,0,,Бұл жерде жарақат алсаңыз, бәрі бітті.
Dialogue: 0,0:22:06.95,0:22:08.46,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:22:08.46,0:22:10.46,Default,,0,0,0,,Ол Арнайы сыныпқа тең Қарғыс рухына айналуы күтіледі.
Dialogue: 0,0:22:10.46,0:22:12.46,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:22:12.46,0:22:14.46,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:22:14.46,0:22:23.47,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:24.97,0:22:29.98,Default,,0,0,0,,♬ (Соңғы тақырып)
Dialogue: 0,0:22:29.98,0:23:52.99,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
