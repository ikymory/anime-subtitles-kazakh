Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Ол екі топқа бөлінеді ме?
Dialogue: 0,0:00:07.28,0:00:10.08,Default,,0,0,0,,Қоян саны 745
Dialogue: 0,0:00:10.25,0:00:13.67,Default,,0,0,0,,Олардың барлығынан бірден құтылсақ жақсы болар еді.
Dialogue: 0,0:00:13.79,0:00:14.67,Default,,0,0,0,,Сіз келесіз бе?
Dialogue: 0,0:00:15.04,0:00:16.75,Default,,0,0,0,,Менің болжамым сол
Dialogue: 0,0:00:17.50,0:00:18.59,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:00:18.71,0:00:20.01,Default,,0,0,0,,Онда барайық.
Dialogue: 0,0:00:23.38,0:00:25.22,Default,,0,0,0,,Мадо-сан, бұл...
Dialogue: 0,0:00:25.72,0:00:29.22,Default,,0,0,0,,Хихи білмегеніңіз жақсы...
Dialogue: 0,0:00:37.86,0:00:38.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:40.15,0:00:41.74,Default,,0,0,0,,Анам…
Dialogue: 0,0:00:45.36,0:00:46.41,Default,,0,0,0,,Тука-чан
Dialogue: 0,0:00:48.24,0:00:49.45,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:00:49.62,0:00:51.29,Default,,0,0,0,,Оның саған еш қатысы жоқ.
Dialogue: 0,0:00:52.12,0:00:54.58,Default,,0,0,0,,Мен көмектесе алатын бірдеңе бар ма...
Dialogue: 0,0:00:57.79,0:00:59.46,Default,,0,0,0,,Сіз не істей аласыз -
Dialogue: 0,0:01:00.30,0:01:01.80,Default,,0,0,0,,Енді жоқ шығар
Dialogue: 0,0:01:06.68,0:01:07.68,Default,,0,0,0,,Хинами?
Dialogue: 0,0:01:09.35,0:01:10.43,Default,,0,0,0,,Хинами!
Dialogue: 0,0:01:11.60,0:01:12.56,Default,,0,0,0,,Неге...
Dialogue: 0,0:02:37.89,0:02:42.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:51.99,0:02:53.28,Default,,0,0,0,,Хинами…
Dialogue: 0,0:02:53.66,0:02:54.66,Default,,0,0,0,,Тука-чан!
Dialogue: 0,0:02:55.08,0:02:57.75,Default,,0,0,0,,Жоқ!Бұл жерде де жоқ!Бұл туралы ше?
Dialogue: 0,0:03:00.75,0:03:02.08,Default,,0,0,0,,Қайда...
Dialogue: 0,0:03:02.25,0:03:03.92,Default,,0,0,0,,А, мүмкін...
Dialogue: 0,0:03:08.97,0:03:09.93,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:03:12.68,0:03:13.93,Default,,0,0,0,,Ryoko-san...
Dialogue: 0,0:03:18.52,0:03:19.69,Default,,0,0,0,,Хинами-чан...
Dialogue: 0,0:03:21.06,0:03:22.35,Default,,0,0,0,,Басқа ешкім...
Dialogue: 0,0:03:43.58,0:03:45.21,Default,,0,0,0,,Өте жақын!
Dialogue: 0,0:03:47.63,0:03:48.84,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:03:51.47,0:03:52.63,Default,,0,0,0,,Тука-чан
Dialogue: 0,0:03:53.64,0:03:55.76,Default,,0,0,0,,Бұл... сол кез еді!
Dialogue: 0,0:03:55.97,0:03:56.81,Default,,0,0,0,,Жаман!
Dialogue: 0,0:03:57.47,0:03:58.52,Default,,0,0,0,,Хинами!
Dialogue: 0,0:04:03.65,0:04:06.48,Default,,0,0,0,,Сол дене тілі... бұл әлі қоян!
Dialogue: 0,0:04:13.66,0:04:15.91,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:04:25.38,0:04:26.75,Default,,0,0,0,,Хинами…
Dialogue: 0,0:04:29.80,0:04:31.63,Default,,0,0,0,,Хинами Бұл не?
Dialogue: 0,0:04:32.92,0:04:35.09,Default,,0,0,0,,Ана...
Dialogue: 0,0:04:37.55,0:04:40.60,Default,,0,0,0,,Жүр, Хинами!Бұл жерде қауіпті
Dialogue: 0,0:04:40.72,0:04:41.85,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:42.89,0:04:47.11,Default,,0,0,0,,Қызық, арлылар өмір сүрмеуі керек пе?
Dialogue: 0,0:04:48.32,0:04:50.44,Default,,0,0,0,,Мен анама барғым келеді...
Dialogue: 0,0:04:51.86,0:04:55.20,Default,,0,0,0,,Мені анаңның үйіне апар.
Dialogue: 0,0:04:57.03,0:04:58.87,Default,,0,0,0,,Өтінемін... сондықтан
Dialogue: 0,0:05:02.54,0:05:03.62,Default,,0,0,0,,Хинами…
Dialogue: 0,0:05:10.63,0:05:12.05,Default,,0,0,0,,Анама...
Dialogue: 0,0:05:12.96,0:05:14.17,Default,,0,0,0,,Мен сенімен танысқым келеді
Dialogue: 0,0:05:29.31,0:05:31.07,Default,,0,0,0,,Қоянның досы ма?
Dialogue: 0,0:05:31.57,0:05:35.74,Default,,0,0,0,,Сен үшін уайымдайтын уақытым жоқ, кетіңізші.
Dialogue: 0,0:05:37.95,0:05:39.16,Default,,0,0,0,,Мені жіберме
Dialogue: 0,0:05:40.41,0:05:44.50,Default,,0,0,0,,Жара әлі жазылды ма?қоян
Dialogue: 0,0:05:44.91,0:05:50.25,Default,,0,0,0,,Бізді қауесеттерге тарту - өкінішті арзан стратегия.
Dialogue: 0,0:05:51.09,0:05:53.84,Default,,0,0,0,,балаша балаша кукукуку
Dialogue: 0,0:05:55.63,0:05:59.93,Default,,0,0,0,,Сізге сыйлық ұнады ма?Мені сағындың ба?
Dialogue: 0,0:06:00.39,0:06:01.93,Default,,0,0,0,,Анасына
Dialogue: 0,0:06:02.18,0:06:05.23,Default,,0,0,0,,Тенми~!
Dialogue: 0,0:06:15.15,0:06:16.61,Default,,0,0,0,,Ақымақ болмаңдар...!
Dialogue: 0,0:06:20.28,0:06:24.24,Default,,0,0,0,,(Қанеки) Мен бұл кісіні жібере алмаймын...
Dialogue: 0,0:06:24.87,0:06:26.46,Default,,0,0,0,,Бұл мен...
Dialogue: 0,0:06:31.46,0:06:32.75,Default,,0,0,0,,Мотивацияңыз бар ма?
Dialogue: 0,0:06:33.13,0:06:34.34,Default,,0,0,0,,Сонда!
Dialogue: 0,0:06:47.98,0:06:49.48,Default,,0,0,0,,Сора!
Dialogue: 0,0:06:57.49,0:07:00.74,Default,,0,0,0,,Күткендей, бұл жердегі басқалардан өзгеше!
Dialogue: 0,0:07:02.24,0:07:05.16,Default,,0,0,0,,Секір!Көбірек секіріңіз!
Dialogue: 0,0:07:05.66,0:07:08.50,Default,,0,0,0,,Қатесіз!
Dialogue: 0,0:07:09.87,0:07:12.54,Default,,0,0,0,,Сіздің қаруыңызды бұл жерде қолдануға болмайды.
Dialogue: 0,0:07:15.13,0:07:16.38,Default,,0,0,0,,Даа!
Dialogue: 0,0:07:21.09,0:07:22.18,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:23.55,0:07:25.93,Default,,0,0,0,,Мен сендерден бір рет сұрайын деп едім.
Dialogue: 0,0:07:26.97,0:07:31.85,Default,,0,0,0,,Жазықсыз адамдарды абайсызда өлтіріп, өз қалауы бойынша жейді.
Dialogue: 0,0:07:34.06,0:07:36.53,Default,,0,0,0,,Неліктен барсыңдар?
Dialogue: 0,0:07:37.53,0:07:39.69,Default,,0,0,0,,Ата-анасы өлтірілген балалар...
Dialogue: 0,0:07:40.20,0:07:42.57,Default,,0,0,0,,Артында қалғандардың қайғысы...
Dialogue: 0,0:07:43.41,0:07:44.49,Default,,0,0,0,,Жалғыздық...
Dialogue: 0,0:07:45.58,0:07:48.04,Default,,0,0,0,,Сіз бұл туралы бір кездері ойладыңыз ба?
Dialogue: 0,0:07:48.79,0:07:49.66,Default,,0,0,0,,Жауап!
Dialogue: 0,0:07:51.25,0:07:53.83,Default,,0,0,0,,Еш себепсіз шабуылға ұшыраудан қорқу
Dialogue: 0,0:07:54.67,0:07:56.55,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:07:56.92,0:08:00.01,Default,,0,0,0,,(Тука) Сүйікті адам жәндік сияқты өлтірілді...
Dialogue: 0,0:08:00.59,0:08:02.59,Default,,0,0,0,,Сіз бұл сезімді түсінесіз бе?
Dialogue: 0,0:08:04.93,0:08:06.35,Default,,0,0,0,,Теме...
Dialogue: 0,0:08:07.01,0:08:09.56,Default,,0,0,0,,Қоян менің серігімді өлтірді
Dialogue: 0,0:08:10.73,0:08:12.48,Default,,0,0,0,,Ол не үшін өлтірілді?
Dialogue: 0,0:08:13.23,0:08:18.32,Default,,0,0,0,,Ол тергеуші болғандықтан ба?Ол адам болғандықтан ба?Өзіңізді мазақ етпеңіз!
Dialogue: 0,0:08:18.78,0:08:21.36,Default,,0,0,0,,Оның өлтірілуіне не себеп болды...
Dialogue: 0,0:08:21.61,0:08:24.95,Default,,0,0,0,,Рёконың өлтірілуіне не себеп болды?
Dialogue: 0,0:08:25.57,0:08:27.87,Default,,0,0,0,,Бұл дүние қате
Dialogue: 0,0:08:28.24,0:08:30.95,Default,,0,0,0,,Оны бұрмалайтындар сендерсіңдер!
Dialogue: 0,0:08:31.37,0:08:33.29,Default,,0,0,0,,Сен осында болсаң ғой!
Dialogue: 0,0:08:35.04,0:08:37.29,Default,,0,0,0,,Даа!Гррр...
Dialogue: 0,0:08:40.21,0:08:41.21,Default,,0,0,0,,Өлме!
Dialogue: 0,0:08:48.43,0:08:51.31,Default,,0,0,0,,Сіз қалай ойлайсыз?Таныс көрінеді.
Dialogue: 0,0:08:53.98,0:08:55.06,Default,,0,0,0,,Сіздің...
Dialogue: 0,0:08:56.73,0:08:58.40,Default,,0,0,0,,Мен жақсы көремін...
Dialogue: 0,0:09:00.86,0:09:03.11,Default,,0,0,0,,Бұл менің анам!
Dialogue: 0,0:09:06.91,0:09:12.54,Default,,0,0,0,,Квинке өз балаларыңыздан жасалған, хахаха!
Dialogue: 0,0:09:12.79,0:09:14.75,Default,,0,0,0,,Гесу бейбақ!
Dialogue: 0,0:09:20.30,0:09:25.55,Default,,0,0,0,,(Қанеки) Аруақтар дүниені бұрмалап жатыр... Шынымен солай ма?
Dialogue: 0,0:09:26.76,0:09:29.39,Default,,0,0,0,,(Канеки) Риоконың өлтірілуіне себеп болды ма?
Dialogue: 0,0:09:31.68,0:09:33.22,Default,,0,0,0,,Хинами-чан ше?
Dialogue: 0,0:09:34.31,0:09:39.36,Default,,0,0,0,,Хинами өзі сүйген адамының өмірін жоғалтқан адам емес пе?
Dialogue: 0,0:09:43.49,0:09:46.66,Default,,0,0,0,,Тіпті арлылардың да сезімі бар.
Dialogue: 0,0:09:47.61,0:09:49.24,Default,,0,0,0,,Оның адамдардан еш айырмашылығы жоқ.
Dialogue: 0,0:09:50.16,0:09:52.83,Default,,0,0,0,,Неліктен адамдар бұған назар аудармайды?
Dialogue: 0,0:09:56.25,0:09:57.92,Default,,0,0,0,,Түсінуге тырыспа!
Dialogue: 0,0:09:58.46,0:10:01.13,Default,,0,0,0,,Бұл сондай айқын нәрсе болса да
Dialogue: 0,0:10:01.71,0:10:03.46,Default,,0,0,0,,Бұл қарапайым нәрсе болса да...
Dialogue: 0,0:10:11.64,0:10:15.85,Default,,0,0,0,,Мұны байқайтын жалғыз мен...
Dialogue: 0,0:10:16.69,0:10:18.56,Default,,0,0,0,,Осыны жеткізе білу...
Dialogue: 0,0:10:19.40,0:10:21.06,Default,,0,0,0,,Мен жалғыз ғұламамын
Dialogue: 0,0:10:21.86,0:10:23.86,Default,,0,0,0,,Тек адам қызметшісі
Dialogue: 0,0:10:26.90,0:10:28.32,Default,,0,0,0,,Бұл тек мен...
Dialogue: 0,0:10:32.03,0:10:33.41,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:10:35.50,0:10:39.92,Default,,0,0,0,,Дұрыс емес нәрсе... бұл дүние емес...
Dialogue: 0,0:10:41.04,0:10:45.21,Default,,0,0,0,,Әрине, теріс жолға түскен аруақтар бар.
Dialogue: 0,0:10:46.09,0:10:50.51,Default,,0,0,0,,Бірақ барлық аруақтар ондай емес...
Dialogue: 0,0:10:53.05,0:10:59.69,Default,,0,0,0,,Мен көбірек білуім керек... адамдар... аруақтар да...
Dialogue: 0,0:11:00.40,0:11:04.77,Default,,0,0,0,,Дүниені бұрмалап жатқан тек аруақтар ғана емес.
Dialogue: 0,0:11:06.19,0:11:07.53,Default,,0,0,0,,Сен де
Dialogue: 0,0:11:08.28,0:11:09.90,Default,,0,0,0,,Не айтып тұрсың...
Dialogue: 0,0:11:10.57,0:11:12.70,Default,,0,0,0,,Сіз түсінбейсіз бе?
Dialogue: 0,0:11:13.07,0:11:14.20,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:11:16.24,0:11:17.16,Default,,0,0,0,,Түсінуге рұқсат етіңіз
Dialogue: 0,0:11:20.68,0:11:23.56,Default,,0,0,0,,Сіз жақсы материал сияқтысыз.
Dialogue: 0,0:11:24.23,0:11:29.44,Default,,0,0,0,,Дегенмен, күйеуі де, әйелі де оны пайдалану өте ыңғайлы деп санайды.
Dialogue: 0,0:11:29.57,0:11:34.86,Default,,0,0,0,,Әкең анаңды аяқтаған кезде қызық болды.
Dialogue: 0,0:11:35.40,0:11:37.49,Default,,0,0,0,,Тоқта... Ро...
Dialogue: 0,0:11:37.91,0:11:42.41,Default,,0,0,0,,Енді мен сені қайда жерлеймін?
Dialogue: 0,0:11:42.75,0:11:45.37,Default,,0,0,0,,Мен сені өлтіремін, қарғыс атқыр қария.
Dialogue: 0,0:11:45.96,0:11:48.21,Default,,0,0,0,,Ол ауызды сұмдық.
Dialogue: 0,0:11:52.38,0:11:54.42,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:10.61,0:12:11.73,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:20.37,0:12:23.49,Default,,0,0,0,,Мен мұны қалай жеткізе аламын?
Dialogue: 0,0:12:24.12,0:12:26.37,Default,,0,0,0,,Мен бір-бірімізді қалай түсінеміз деп ойлаймын
Dialogue: 0,0:12:34.05,0:12:38.72,Default,,0,0,0,,(Қанеки) Бір-бірімізбен ұрыспауымыз керек... Бір-бірімізге таласпауымыз керек...
Dialogue: 0,0:12:39.51,0:12:42.43,Default,,0,0,0,,Адамдар да, аруақтар да...
Dialogue: 0,0:12:43.26,0:12:46.93,Default,,0,0,0,,Қайғы тізбегін үз
Dialogue: 0,0:12:47.64,0:12:50.94,Default,,0,0,0,,Бұған жету үшін не істеуім керек?
Dialogue: 0,0:12:51.27,0:12:52.69,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:12:58.45,0:13:01.45,Default,,0,0,0,,Сен сияқтылар үшін уайымдауға уақытым жоқ.
Dialogue: 0,0:13:04.91,0:13:06.16,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:13:06.87,0:13:09.79,Default,,0,0,0,,Бұл адамды жібермеңіз
Dialogue: 0,0:13:10.50,0:13:15.76,Default,,0,0,0,,Бұл туралы бірдеңе істей алсам... Бірақ менде ондай күш жоқ...
Dialogue: 0,0:13:22.43,0:13:26.85,Default,,0,0,0,,(Канеки) Түсінемін... бұл жалғыз нұсқа ма?
Dialogue: 0,0:13:27.73,0:13:32.31,Default,,0,0,0,,Сосын, әзірше... Әзірше...
Dialogue: 0,0:13:33.27,0:13:36.78,Default,,0,0,0,,Мен сені ішімде қабылдаймын
Dialogue: 0,0:13:38.24,0:13:39.24,Default,,0,0,0,,Ризе-сан
Dialogue: 0,0:13:41.99,0:13:43.99,Default,,0,0,0,,О!
Dialogue: 0,0:13:59.22,0:14:00.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:03.84,0:14:09.98,Default,,0,0,0,,(Қанеки) Тәбетім жеп кететін сияқты... Мен өзімді ләззатқа батып бара жатқандай сезінемін.
Dialogue: 0,0:14:10.60,0:14:16.07,Default,,0,0,0,,Бірақ мен адамдарды назардан тыс қалдырмаймын...
Dialogue: 0,0:14:27.28,0:14:28.74,Default,,0,0,0,,Олар Квинкеге бағытталған ба?
Dialogue: 0,0:14:29.25,0:14:30.79,Default,,0,0,0,,Осы күшпен...
Dialogue: 0,0:14:31.25,0:14:32.50,Default,,0,0,0,,Аты-жөні!
Dialogue: 0,0:14:36.38,0:14:37.46,Default,,0,0,0,,Қазір...
Dialogue: 0,0:14:38.88,0:14:40.76,Default,,0,0,0,,Бұл адам да күресе алмайды.
Dialogue: 0,0:14:44.26,0:14:46.93,Default,,0,0,0,,Квинкесіз...
Dialogue: 0,0:14:47.93,0:14:48.76,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:49.68,0:14:53.56,Default,,0,0,0,,Жау алдында аяқ-қолыңнан айырылсаң да...
Dialogue: 0,0:14:54.06,0:14:55.23,Default,,0,0,0,,Өтінемін қашып кет
Dialogue: 0,0:14:57.02,0:15:01.61,Default,,0,0,0,,(Қанеки) Бұлай жалғаса берсе... Мен сені өлтіремін.
Dialogue: 0,0:15:02.78,0:15:05.41,Default,,0,0,0,,Сонымен... қаш.
Dialogue: 0,0:15:05.57,0:15:08.74,Default,,0,0,0,,(Амон) Ақымақ болма!Арқаның алдынан бұрылып!
Dialogue: 0,0:15:08.87,0:15:10.37,Default,,0,0,0,,(Канеки) Тезірек!(Амон) Уау!
Dialogue: 0,0:15:17.75,0:15:18.75,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:19.38,0:15:22.01,Default,,0,0,0,,(Амон) Куу... (Канеки) Өтінемін...
Dialogue: 0,0:15:24.09,0:15:28.18,Default,,0,0,0,,Өтінемін, мені өлтіруші етпеңдер...
Dialogue: 0,0:15:28.76,0:15:32.52,Default,,0,0,0,,(Тоука) Егер сен ғұлама болсаң, дәл осылай айта алмас па едің?
Dialogue: 0,0:15:33.06,0:15:36.23,Default,,0,0,0,,Өмір сүргісі келгеннің несі жаман?
Dialogue: 0,0:15:36.77,0:15:40.73,Default,,0,0,0,,Егер сіз тек адамдарды жей алсаңыз, бұл сіздің қолыңыздан келетін жалғыз нәрсе.
Dialogue: 0,0:15:41.32,0:15:44.95,Default,,0,0,0,,Мен мұндай денемен қалай дұрыс өмір сүре аламын?
Dialogue: 0,0:15:45.24,0:15:46.49,Default,,0,0,0,,Қалай!
Dialogue: 0,0:15:46.78,0:15:49.24,Default,,0,0,0,,Өл!Өл, өл, өл, өл!
Dialogue: 0,0:15:50.12,0:15:51.49,Default,,0,0,0,,Барлығы өледі!
Dialogue: 0,0:15:52.75,0:15:53.95,Default,,0,0,0,,Мен де...
Dialogue: 0,0:15:55.62,0:15:58.96,Default,,0,0,0,,Мен де сен сияқты өмір сүргім келеді...
Dialogue: 0,0:15:59.75,0:16:01.50,Default,,0,0,0,,Оны естуге шыдай алмаймын.
Dialogue: 0,0:16:02.42,0:16:06.30,Default,,0,0,0,,(Мато) Бұл соңы!(Хинами) Жыл!
Dialogue: 0,0:16:13.68,0:16:15.06,Default,,0,0,0,,Квинке...
Dialogue: 0,0:16:15.64,0:16:16.98,Default,,0,0,0,,Жоғалып кетті ме?
Dialogue: 0,0:16:20.48,0:16:25.11,Default,,0,0,0,,Жоқ... Менің оң қолым жоғалып кетті ме...
Dialogue: 0,0:16:28.24,0:16:29.12,Default,,0,0,0,,Хинами?
Dialogue: 0,0:16:34.16,0:16:38.12,Default,,0,0,0,,Енді апамды ренжітпе...
Dialogue: 0,0:16:39.50,0:16:43.30,Default,,0,0,0,,Әкең мен шешеңе олай қарама!
Dialogue: 0,0:16:47.09,0:16:48.72,Default,,0,0,0,,Хаха, керемет!
Dialogue: 0,0:16:52.26,0:16:53.81,Default,,0,0,0,,Керемет!
Dialogue: 0,0:16:53.93,0:16:58.52,Default,,0,0,0,,Ол анасы мен әкесінің ең жақсы жақтарын ғана мұра етті!
Dialogue: 0,0:16:58.69,0:17:01.73,Default,,0,0,0,,Мен мұны қалаймын!Маған берші!
Dialogue: 0,0:17:06.40,0:17:07.95,Default,,0,0,0,,Не...!Гуаа!
Dialogue: 0,0:17:23.54,0:17:24.55,Default,,0,0,0,,Хинами…
Dialogue: 0,0:17:25.30,0:17:26.34,Default,,0,0,0,,Аяқтау...
Dialogue: 0,0:17:27.17,0:17:28.51,Default,,0,0,0,,Мен алмаймын...
Dialogue: 0,0:17:29.43,0:17:32.64,Default,,0,0,0,,Мен сенің ата-анаңның жауымын.
Dialogue: 0,0:17:33.64,0:17:36.68,Default,,0,0,0,,Маңызды емес...
Dialogue: 0,0:17:37.39,0:17:40.60,Default,,0,0,0,,Мен кек алуды ойламаймын!
Dialogue: 0,0:17:43.48,0:17:46.69,Default,,0,0,0,,Мен жай ғана қайғылымын
Dialogue: 0,0:17:47.44,0:17:52.70,Default,,0,0,0,,Мен анам мен әкемді көргім келгені үшін қайғылымын.
Dialogue: 0,0:17:54.37,0:18:00.46,Default,,0,0,0,,Әке... Ана... Мен жалғызбын.
Dialogue: 0,0:18:04.38,0:18:06.05,Default,,0,0,0,,Wonderful
Dialogue: 0,0:18:06.34,0:18:10.76,Default,,0,0,0,,Иә, отбасылар бірге тұруы керек.
Dialogue: 0,0:18:11.63,0:18:16.43,Default,,0,0,0,,Сонда сен менің квинкем бола аласың!
Dialogue: 0,0:18:25.77,0:18:28.07,Default,,0,0,0,,Қарғыс атқыр... Мен шатастырдым ба?
Dialogue: 0,0:18:28.61,0:18:34.03,Default,,0,0,0,,Сіз үшін өмір сүруге тұрарлық нәрсе бар ма?
Dialogue: 0,0:18:34.53,0:18:37.53,Default,,0,0,0,,Мені күлдірме... хахаха...
Dialogue: 0,0:18:37.99,0:18:42.92,Default,,0,0,0,,Әлі жоқ... Мен сенен кек аламын...
Dialogue: 0,0:18:43.46,0:18:46.25,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:46.38,0:18:51.80,Default,,0,0,0,,Бір көзімді өз қолыммен көмгенше...
Dialogue: 0,0:18:54.55,0:18:57.18,Default,,0,0,0,,Әлі өлме...
Dialogue: 0,0:19:01.64,0:19:02.98,Default,,0,0,0,,Уф... Хаа...
Dialogue: 0,0:19:03.14,0:19:07.15,Default,,0,0,0,,(Амон) Әлгі аруақ... неге мені сағындың?
Dialogue: 0,0:19:09.11,0:19:10.82,Default,,0,0,0,,Ол жылап тұрды
Dialogue: 0,0:19:12.03,0:19:16.49,Default,,0,0,0,,Уф... жоқ, ол сәйкес келмейді...
Dialogue: 0,0:19:17.41,0:19:20.54,Default,,0,0,0,,Маған ұнамайды...біреу...
Dialogue: 0,0:19:21.00,0:19:23.41,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:19:24.00,0:19:27.75,Default,,0,0,0,,Уф... ет!Ет!
Dialogue: 0,0:19:28.79,0:19:32.17,Default,,0,0,0,,Бұл жақсы емес... егер осылай қала берсе...
Dialogue: 0,0:19:33.84,0:19:35.84,Default,,0,0,0,,Кім... Қызық...
Dialogue: 0,0:19:36.68,0:19:41.43,Default,,0,0,0,,(Канеки Ризе) Мен қазір қатты аштым.
Dialogue: 0,0:19:42.60,0:19:43.56,Default,,0,0,0,,Эй
Dialogue: 0,0:19:47.02,0:19:49.27,Default,,0,0,0,,Йошимура-санның сізге назар аударуының себебі
Dialogue: 0,0:19:49.40,0:19:50.94,Default,,0,0,0,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:19:52.53,0:19:56.53,Default,,0,0,0,,Мен де сенің бұдан былай не істейтініңді көргім келеді.
Dialogue: 0,0:19:59.70,0:20:02.04,Default,,0,0,0,,Қайтып оралыңыз Кен
Dialogue: 0,0:20:03.79,0:20:05.96,Default,,0,0,0,,Йомо…сан
Dialogue: 0,0:20:07.04,0:20:09.38,Default,,0,0,0,,Мен не істеп жатырмын...
Dialogue: 0,0:20:10.13,0:20:11.00,Default,,0,0,0,,Тамақтаныңыз
Dialogue: 0,0:20:12.13,0:20:13.34,Default,,0,0,0,,Бұл оңайырақ болады.
Dialogue: 0,0:20:17.89,0:20:19.72,Default,,0,0,0,,Сіз осындай нәрсені киесіз.
Dialogue: 0,0:20:20.26,0:20:22.56,Default,,0,0,0,,Сіз маған осылай тиіп жатырсыз...
Dialogue: 0,0:20:23.22,0:20:24.56,Default,,0,0,0,,Сізге бұл ұнамайды!
Dialogue: 0,0:20:41.95,0:20:43.37,Default,,0,0,0,,Хинами-чан!
Dialogue: 0,0:20:54.05,0:20:54.96,Default,,0,0,0,,Тука-чан?
Dialogue: 0,0:21:31.21,0:21:32.96,Default,,0,0,0,,Тірі болу дұрыс па?
Dialogue: 0,0:21:33.79,0:21:37.42,Default,,0,0,0,,Мен... өмір сүре аламын ба?
Dialogue: 0,0:21:41.01,0:21:41.93,Default,,0,0,0,,Хинами-чан
Dialogue: 0,0:21:44.14,0:21:47.06,Default,,0,0,0,,Сол кезде Риоко-сан...
Dialogue: 0,0:21:47.72,0:21:50.48,Default,,0,0,0,,Менің ойымша, ол «тірі» деді.
Dialogue: 0,0:23:30.74,0:23:35.75,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.25,0:23:42.25,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
