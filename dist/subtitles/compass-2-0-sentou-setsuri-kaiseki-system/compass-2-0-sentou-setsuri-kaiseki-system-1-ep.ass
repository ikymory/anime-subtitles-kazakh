Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.13,0:00:10.26,Default,,0,0,0,,Сол жаққа әкел!
Dialogue: 0,0:00:12.26,0:00:13.34,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:00:13.43,0:00:15.34,Default,,0,0,0,,Мен бұған мүлдем өкінбеймін.
Dialogue: 0,0:00:18.30,0:00:19.60,Default,,0,0,0,,Хмм (гонг) хмм
Dialogue: 0,0:00:20.64,0:00:22.31,Default,,0,0,0,,Тағы 3 бөлік сол жақта ашық
Dialogue: 0,0:00:24.10,0:00:25.31,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:00:32.49,0:00:33.32,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:35.36,0:00:36.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:36.28,0:00:37.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:41.95,0:00:42.79,Default,,0,0,0,,Я...
Dialogue: 0,0:00:42.87,0:00:44.16,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:44.71,0:00:45.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:46.58,0:00:47.92,Default,,0,0,0,,Кесілген тағамды ұсыныңыз, артта тұрыңыз!
Dialogue: 0,0:00:49.92,0:00:50.80,Default,,0,0,0,,Я...
Dialogue: 0,0:00:52.38,0:00:53.21,Default,,0,0,0,,Гррр…
Dialogue: 0,0:00:56.09,0:00:59.01,Default,,0,0,0,,Тек ата-аналар қауымдастығын жеңіп алып, оны жабыңыз.
Dialogue: 0,0:00:59.85,0:01:02.43,Default,,0,0,0,,Соутаның проблемасы оның үйірме жұмыстарына келмеуі.
Dialogue: 0,0:01:02.52,0:01:05.10,Default,,0,0,0,,Мен қателескен жоқпын
Dialogue: 0,0:01:05.19,0:01:06.52,Default,,0,0,0,,Мен оны Солтүстік-Шығыс әскери театрдан алдым.
Dialogue: 0,0:01:06.60,0:01:08.02,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:01:09.11,0:01:11.44,Default,,0,0,0,,Сәлеметсіз бе, қазір ойын жүріп жатыр...
Dialogue: 0,0:01:11.52,0:01:12.44,Default,,0,0,0,,Иә? Аурухана?
Dialogue: 0,0:01:13.07,0:01:15.49,Default,,0,0,0,,Соута Йошино ше?
Dialogue: 0,0:01:15.57,0:01:18.32,Default,,0,0,0,,Сута үйде...
Dialogue: 0,0:01:33.00,0:01:38.01,Default,,0,0,0,,♪～
Dialogue: 0,0:02:57.71,0:03:02.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:03.47,0:03:05.10,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:07.64,0:03:09.14,Default,,0,0,0,,Чика Чика!
Dialogue: 0,0:03:09.23,0:03:10.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:10.14,0:03:13.02,Default,,0,0,0,,Ха ха ха… (ресми ант) Юхито…
Dialogue: 0,0:03:13.10,0:03:15.86,Default,,0,0,0,,Ал... Сіздің Токиоға баратыныңыз рас па?
Dialogue: 0,0:03:15.94,0:03:18.11,Default,,0,0,0,,Қайта кездесе аламыз ба?
Dialogue: 0,0:03:18.19,0:03:19.11,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:19.19,0:03:21.15,Default,,0,0,0,,Ұмыту
Dialogue: 0,0:03:21.24,0:03:24.24,Default,,0,0,0,,Юхитоны ешқашан ұмытпа
Dialogue: 0,0:03:24.32,0:03:28.08,Default,,0,0,0,,Мен де Чиканы ешқашан ұмытпаймын.
Dialogue: 0,0:03:29.62,0:03:32.79,Default,,0,0,0,,Негізі мен сенімен мәңгі бірге болғым келеді, бірақ...
Dialogue: 0,0:03:33.37,0:03:36.04,Default,,0,0,0,,Қош бол Юхито
Dialogue: 0,0:03:36.13,0:03:38.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:41.30,0:03:43.05,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:03:44.64,0:03:45.85,Default,,0,0,0,,Трансфер студент (Юхито) Уау
Dialogue: 0,0:03:45.93,0:03:48.64,Default,,0,0,0,,Келу Сіз кешіккеніңізге сенімдісіз бе?
Dialogue: 0,0:03:48.72,0:03:50.48,Default,,0,0,0,,Керемет пе?
Dialogue: 0,0:03:50.56,0:03:52.19,Default,,0,0,0,,Бұл керемет деп үміттенемін
Dialogue: 0,0:03:52.77,0:03:54.35,Default,,0,0,0,,Бұл қалыпты бет.
Dialogue: 0,0:03:54.44,0:03:55.86,Default,,0,0,0,,Қалыптыдан сәл аз болуы мүмкін
Dialogue: 0,0:03:55.94,0:03:59.57,Default,,0,0,0,,Юхито мұны балабақшаға келгенше ғана білген, солай ма?
Dialogue: 0,0:03:59.65,0:04:01.69,Default,,0,0,0,,Бұл керемет шығар.
Dialogue: 0,0:04:01.78,0:04:03.49,Default,,0,0,0,,...
Dialogue: 0,0:04:03.57,0:04:05.66,Default,,0,0,0,,Көзілдірікті кішкентай жігіттің жолы болмайтынына сенімдімін.
Dialogue: 0,0:04:05.74,0:04:08.87,Default,,0,0,0,,Сіз мұңайып тұрсыз ба?
Dialogue: 0,0:04:08.95,0:04:10.62,Default,,0,0,0,,Сіз шынымен де баласыз...
Dialogue: 0,0:04:10.70,0:04:11.96,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:04:12.04,0:04:14.12,Default,,0,0,0,,Үлкен апа сияқты әрекет етуді доғар.
Dialogue: 0,0:04:14.21,0:04:15.79,Default,,0,0,0,,Сыныбыңызға оралыңыз.
Dialogue: 0,0:04:15.88,0:04:18.17,Default,,0,0,0,,Иә, иә, мен көмектесе алмаймын.
Dialogue: 0,0:04:19.71,0:04:23.38,Default,,0,0,0,,Мен іш шалбар киіп жүрмін, сондықтан қарап шығудың қажеті жоқ.
Dialogue: 0,0:04:23.47,0:04:25.97,Default,,0,0,0,,Жүннен жасалған шалбар?
Dialogue: 0,0:04:26.68,0:04:29.18,Default,,0,0,0,,Мен өзіңізді соншалықты керемет көрінуге мәжбүрлеудің мәнін түсінбеймін.
Dialogue: 0,0:04:29.26,0:04:31.14,Default,,0,0,0,,Сән - бұл жүрек туралы
Dialogue: 0,0:04:31.77,0:04:34.10,Default,,0,0,0,,Балаларға әлі ерте ме?
Dialogue: 0,0:04:34.69,0:04:37.73,Default,,0,0,0,,Юхито, сені жеңгең Генко тағы да мазақ етіп жатыр ма?
Dialogue: 0,0:04:37.81,0:04:39.86,Default,,0,0,0,,Сіз ренжідіңіз, аузыңызды жап!
Dialogue: 0,0:04:39.94,0:04:42.82,Default,,0,0,0,,Трансфер оқушы: Сіз бала кезден доссыз ба?
Dialogue: 0,0:04:42.90,0:04:44.07,Default,,0,0,0,,Балабақша
Dialogue: 0,0:04:44.15,0:04:46.24,Default,,0,0,0,,Сізге кездесу ұнады ма?
Dialogue: 0,0:04:46.32,0:04:49.24,Default,,0,0,0,,Сіз ақымақсыз ба? Бұл ер адам.
Dialogue: 0,0:04:50.87,0:04:54.12,Default,,0,0,0,,Мен сол жемісті асыға күттім.
Dialogue: 0,0:04:55.62,0:04:57.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:57.33,0:05:00.13,Default,,0,0,0,,Мен қысқы каникулда көшуді аяқтауым керек еді.
Dialogue: 0,0:05:00.21,0:05:02.01,Default,,0,0,0,,Маған бетіңді де көрсетпе...
Dialogue: 0,0:05:03.42,0:05:04.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:04.34,0:05:05.93,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:05:09.35,0:05:10.47,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:12.64,0:05:14.02,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:16.19,0:05:17.44,Default,,0,0,0,,Я...
Dialogue: 0,0:05:17.52,0:05:18.40,Default,,0,0,0,,Чика!
Dialogue: 0,0:05:20.19,0:05:22.40,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:05:26.20,0:05:28.07,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:05:31.83,0:05:33.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:33.79,0:05:38.25,Default,,0,0,0,,Чика, сен мені түсінбедің бе?
Dialogue: 0,0:05:39.92,0:05:42.75,Default,,0,0,0,,Токиодан келген Кусей Хайдзима
Dialogue: 0,0:05:42.84,0:05:46.09,Default,,0,0,0,,Менің атамның үйі қалада.
Dialogue: 0,0:05:46.17,0:05:48.84,Default,,0,0,0,,Ол балабақшаға дейін Сузуму қаласында тұрса керек.
Dialogue: 0,0:05:48.93,0:05:50.80,Default,,0,0,0,,Ол мені елемеді.
Dialogue: 0,0:05:50.89,0:05:52.22,Default,,0,0,0,,Куроба-кун (Юхито) Эй?
Dialogue: 0,0:05:52.31,0:05:56.77,Default,,0,0,0,,Мен Хайдзима-кунның бұрынғы мектебінде волейбол ойнағанын естідім.
Dialogue: 0,0:05:56.85,0:05:58.81,Default,,0,0,0,,Волейбол үйірмесіне қосылу
Dialogue: 0,0:05:58.90,0:06:01.69,Default,,0,0,0,,Үйірме жұмыстары туралы айтып беріңізші.
Dialogue: 0,0:06:01.77,0:06:03.19,Default,,0,0,0,,Хайдзима-кун
Dialogue: 0,0:06:03.27,0:06:04.44,Default,,0,0,0,,Куроба-кунның алдында отыру
Dialogue: 0,0:06:04.53,0:06:05.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:05.78,0:06:06.90,Default,,0,0,0,,(Отыру дыбысы)
Dialogue: 0,0:06:06.99,0:06:08.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:10.24,0:06:11.66,Default,,0,0,0,,Сіздің ұстанымыңыз қандай? (Юхито)?
Dialogue: 0,0:06:11.74,0:06:14.08,Default,,0,0,0,,Позиция Волейбол клубы ма?
Dialogue: 0,0:06:14.16,0:06:16.54,Default,,0,0,0,,Аа, позициясы осындай.
Dialogue: 0,0:06:16.62,0:06:20.46,Default,,0,0,0,,Менің ойымша, бұл анық емес.
Dialogue: 0,0:06:20.54,0:06:24.21,Default,,0,0,0,,Бұл әлі шешілген жоқ. Матч кезінде не істейсіз?
Dialogue: 0,0:06:24.30,0:06:27.26,Default,,0,0,0,,Мен ешқашан дұрыс матчта болған емеспін.
Dialogue: 0,0:06:27.34,0:06:29.34,Default,,0,0,0,,Тәжірибе күндері де орынды.
Dialogue: 0,0:06:29.43,0:06:33.43,Default,,0,0,0,,Бұл тек атымен ғана тиесілі адамдардан тұратын клуб.
Dialogue: 0,0:06:33.51,0:06:34.93,Default,,0,0,0,,Үйге қара.
Dialogue: 0,0:06:35.01,0:06:36.72,Default,,0,0,0,,Мен міндетті түрде қандай да бір клубқа қосылуым керек...
Dialogue: 0,0:06:36.81,0:06:38.31,Default,,0,0,0,,Ах! Сіз білесіз бе (Юхито)?
Dialogue: 0,0:06:38.39,0:06:39.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:39.48,0:06:44.07,Default,,0,0,0,,Мүмкін сіздің мектебіңіз күшті болған шығар?
Dialogue: 0,0:06:44.15,0:06:45.11,Default,,0,0,0,,Чи…
Dialogue: 0,0:06:45.19,0:06:46.94,Default,,0,0,0,,Бұл қажетсіз үлкен ме?
Dialogue: 0,0:06:47.03,0:06:48.69,Default,,0,0,0,,Нана...
Dialogue: 0,0:06:49.36,0:06:51.66,Default,,0,0,0,,Не, мына жігіт!
Dialogue: 0,0:06:52.74,0:06:53.57,Default,,0,0,0,,Чика?
Dialogue: 0,0:06:53.66,0:06:55.87,Default,,0,0,0,,Аа, жалпыға ортақ ант.
Dialogue: 0,0:06:55.95,0:06:57.20,Default,,0,0,0,,Бұл есімде.
Dialogue: 0,0:06:57.29,0:06:58.54,Default,,0,0,0,,Хояро?
Dialogue: 0,0:06:58.62,0:07:00.96,Default,,0,0,0,,Мені есіңе түсірсең, Рай Чан.
Dialogue: 0,0:07:01.04,0:07:03.38,Default,,0,0,0,,Менің ойымша, ол шынымен де сонда болды.
Dialogue: 0,0:07:03.46,0:07:05.88,Default,,0,0,0,,Сіз оны елес деп ойладыңыз ба?
Dialogue: 0,0:07:05.96,0:07:07.46,Default,,0,0,0,,Ах, Яну, әдеттегідей.
Dialogue: 0,0:07:08.21,0:07:11.59,Default,,0,0,0,,Неліктен Токиоға көшті?
Dialogue: 0,0:07:11.68,0:07:12.93,Default,,0,0,0,,Рай-чан, сен білесің бе?
Dialogue: 0,0:07:13.51,0:07:15.64,Default,,0,0,0,,Менің анам қайтыс болды, солай ма?
Dialogue: 0,0:07:15.72,0:07:19.18,Default,,0,0,0,,Әлгі қарияның жерлеуге барғаны есімде.
Dialogue: 0,0:07:20.02,0:07:23.52,Default,,0,0,0,,Қарт бұрын Токиодан келген.
Dialogue: 0,0:07:24.48,0:07:27.98,Default,,0,0,0,,Неліктен бұл жерге қайта оралдың?
Dialogue: 0,0:07:29.49,0:07:31.03,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:07:31.11,0:07:32.91,Default,,0,0,0,,Адамның өзінен сұраңыз.
Dialogue: 0,0:07:32.99,0:07:35.41,Default,,0,0,0,,Егер мен мұны істей алсам, менде қиындық болмайды.
Dialogue: 0,0:07:36.16,0:07:38.74,Default,,0,0,0,,Ол тосқауыл қойып жатыр.
Dialogue: 0,0:07:40.33,0:07:43.33,Default,,0,0,0,,Эй, мен қажетсіз үлкенмін бе?
Dialogue: 0,0:07:43.42,0:07:45.59,Default,,0,0,0,,Эй, сен білмейсің.
Dialogue: 0,0:07:45.67,0:07:46.38,Default,,0,0,0,,Үлкен екенсің, мен сияқты сөйлейсің.
Dialogue: 0,0:07:46.38,0:07:49.05,Default,,0,0,0,,Үлкен екенсің, мен сияқты сөйлейсің.
Dialogue: 0,0:07:46.38,0:07:49.05,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:07:49.05,0:07:49.13,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:07:49.13,0:07:50.88,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:07:49.13,0:07:50.88,Default,,0,0,0,,Сіз әлі жарты адамсыз.
Dialogue: 0,0:07:50.88,0:07:50.97,Default,,0,0,0,,Сіз әлі жартылай толғансыз.
Dialogue: 0,0:07:50.97,0:07:51.26,Default,,0,0,0,,Сіз әлі жартылай толғансыз.
Dialogue: 0,0:07:50.97,0:07:51.26,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:07:51.26,0:07:51.34,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:07:51.34,0:07:51.80,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:07:51.34,0:07:51.80,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:51.80,0:07:52.18,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:52.26,0:07:53.30,Default,,0,0,0,,Мақтанбасаң да...
Dialogue: 0,0:07:53.38,0:07:54.22,Default,,0,0,0,,Қараңызшы (Юхито) А...
Dialogue: 0,0:07:54.30,0:07:55.14,Default,,0,0,0,,Юхито?
Dialogue: 0,0:07:55.22,0:07:57.76,Default,,0,0,0,,Тәтем түскі ас уақыты келді деді.
Dialogue: 0,0:07:57.85,0:07:59.64,Default,,0,0,0,,Қайырлы таң үйге
Dialogue: 0,0:08:00.56,0:08:01.52,Default,,0,0,0,,Жіпті жігіт
Dialogue: 0,0:08:02.31,0:08:04.56,Default,,0,0,0,,Менің осында екенімді қайдан білдің?
Dialogue: 0,0:08:04.65,0:08:06.98,Default,,0,0,0,,Демек, сен ақымақсың.
Dialogue: 0,0:08:07.06,0:08:07.90,Default,,0,0,0,,Ол осы мамандық атауын беруге тікелей шабыт болған —
Dialogue: 0,0:08:11.07,0:08:12.15,Default,,0,0,0,,Куробане
Dialogue: 0,0:08:12.45,0:08:14.20,Default,,0,0,0,,Чика... Хайдзима
Dialogue: 0,0:08:14.28,0:08:16.28,Default,,0,0,0,,Осы сағатқа дейін не істедің?
Dialogue: 0,0:08:16.37,0:08:17.49,Default,,0,0,0,,Үйірме жұмыстары
Dialogue: 0,0:08:17.58,0:08:20.62,Default,,0,0,0,,Үйірме жұмыстары... волейбол?
Dialogue: 0,0:08:20.70,0:08:22.16,Default,,0,0,0,,Бүгін жаттығу күні, солай ма?
Dialogue: 0,0:08:22.25,0:08:24.42,Default,,0,0,0,,Бірақ ешкім келмейді.
Dialogue: 0,0:08:24.50,0:08:25.33,Default,,0,0,0,,О
Dialogue: 0,0:08:26.17,0:08:27.71,Default,,0,0,0,,Сіз мұны жалғыз жасадыңыз ба?
Dialogue: 0,0:08:28.25,0:08:29.09,Default,,0,0,0,,О
Dialogue: 0,0:08:29.17,0:08:31.51,Default,,0,0,0,,О, сен ақымақсың.
Dialogue: 0,0:08:31.59,0:08:34.18,Default,,0,0,0,,Кішкентай бала үлкен болып кетті.
Dialogue: 0,0:08:34.26,0:08:36.76,Default,,0,0,0,,Бұл шамамен Юхитомен бірдей.
Dialogue: 0,0:08:36.84,0:08:39.56,Default,,0,0,0,,Лай-чан, есіңде ме?
Dialogue: 0,0:08:39.64,0:08:41.97,Default,,0,0,0,,Нағашым атаммен шоги ойнауға келді.
Dialogue: 0,0:08:42.60,0:08:45.44,Default,,0,0,0,,Менің есімде, бірақ сондықтан ма?
Dialogue: 0,0:08:48.94,0:08:50.19,Default,,0,0,0,,Куробане
Dialogue: 0,0:08:50.27,0:08:52.86,Default,,0,0,0,,Сіз қызықсыз.
Dialogue: 0,0:08:52.94,0:08:53.90,Default,,0,0,0,,На
Dialogue: 0,0:08:53.99,0:08:56.20,Default,,0,0,0,,Қызық па?
Dialogue: 0,0:08:56.28,0:08:59.24,Default,,0,0,0,,Сіз осындай қызықты нәрсе істеп жатырсыз ба? сурет?
Dialogue: 0,0:08:59.33,0:09:00.87,Default,,0,0,0,,Мен істеймін
Dialogue: 0,0:09:03.54,0:09:06.83,Default,,0,0,0,,Ой, ол жігіт мені қатты жаман сезінді.
Dialogue: 0,0:09:07.46,0:09:10.59,Default,,0,0,0,,Мектепте де солай, толқыдым.
Dialogue: 0,0:09:13.71,0:09:14.67,Default,,0,0,0,,Сызық (Әйел мүше) Иә
Dialogue: 0,0:09:14.76,0:09:15.59,Default,,0,0,0,,Келесі (Әйел мүше) Иә
Dialogue: 0,0:09:33.48,0:09:34.32,Default,,0,0,0,,Га
Dialogue: 0,0:09:52.00,0:09:54.67,Default,,0,0,0,,Спайк service... таңқаларлық...
Dialogue: 0,0:09:55.55,0:09:57.13,Default,,0,0,0,,Әй, ауысатын студент
Dialogue: 0,0:09:57.72,0:09:59.30,Default,,0,0,0,,Сен де бүгін жалғызсың ба?
Dialogue: 0,0:09:59.39,0:10:02.85,Default,,0,0,0,,Көріп отырғаныңыздай, бұл бір-біріне тығыз оралған.
Dialogue: 0,0:10:02.93,0:10:05.06,Default,,0,0,0,,Егер сіз жалғыз ойнасаңыз
Dialogue: 0,0:10:05.14,0:10:07.31,Default,,0,0,0,,Бұрышқа барсаң жақсы емес пе?
Dialogue: 0,0:10:07.39,0:10:08.39,Default,,0,0,0,,Екі жағын пайдалана алсаңыз...
Dialogue: 0,0:10:08.48,0:10:10.98,Default,,0,0,0,,Сіз тиімді жаттығу жасай аласыз (Юхито) Ах...
Dialogue: 0,0:10:11.06,0:10:13.15,Default,,0,0,0,,Бір бетсіз жаттығуға болмайды.
Dialogue: 0,0:10:13.23,0:10:15.36,Default,,0,0,0,,Адам саны маңызды емес
Dialogue: 0,0:10:15.44,0:10:19.11,Default,,0,0,0,,Егер сізде жаттығуға арналған орын жеткіліксіз болса, кеңесшіңізбен кеңесіңіз.
Dialogue: 0,0:10:19.20,0:10:22.16,Default,,0,0,0,,Не, жаңа ғана келдіңіз бе?
Dialogue: 0,0:10:22.24,0:10:23.53,Default,,0,0,0,,Сәлем (менеджер) мм...
Dialogue: 0,0:10:23.62,0:10:27.00,Default,,0,0,0,,Жалғыз болмасаң, шағым айта алмайсың.
Dialogue: 0,0:10:27.08,0:10:30.96,Default,,0,0,0,,Ой... Кешіріңіз, кешігіп қалдым...
Dialogue: 0,0:10:31.79,0:10:33.29,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:33.88,0:10:35.76,Default,,0,0,0,,Мен оны көруге келдім.
Dialogue: 0,0:10:36.46,0:10:39.76,Default,,0,0,0,,Менің істегенім қызықсыз, сасық.
Dialogue: 0,0:10:39.84,0:10:43.39,Default,,0,0,0,,Мен сізді шынымен қызықты нәрсе істеп жатырсыз деп ойладым.
Dialogue: 0,0:10:43.47,0:10:46.72,Default,,0,0,0,,Хояде, мен саған көмектесу үшін келген жоқпын.
Dialogue: 0,0:10:46.81,0:10:49.44,Default,,0,0,0,,Бұл бұрын болған оқиға.
Dialogue: 0,0:10:49.52,0:10:51.52,Default,,0,0,0,,1-ден 20-ға дейін тым көп.
Dialogue: 0,0:10:52.15,0:10:55.61,Default,,0,0,0,,2-20 болса да, бұл өте көңіл көншітерлік емес.
Dialogue: 0,0:10:55.69,0:10:58.40,Default,,0,0,0,,Сен сондай сүйкімдісің
Dialogue: 0,0:10:58.49,0:11:02.16,Default,,0,0,0,,Сіз осындай сөздерді айтып достарыңызды жоғалтасыз.
Dialogue: 0,0:11:03.28,0:11:04.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:06.99,0:11:10.41,Default,,0,0,0,,Мен мұны көрдім. Бұл таңқаларлық болды. Спайк қызмет етеді.
Dialogue: 0,0:11:10.50,0:11:13.83,Default,,0,0,0,,Маған дәлдікті жақсарту керек, мен оны әлі матчтарда пайдалана алмаймын.
Dialogue: 0,0:11:13.92,0:11:17.51,Default,,0,0,0,,А, сіз үнемі қызмет көрсетуді ұрып тұрдыңыз ба?
Dialogue: 0,0:11:17.59,0:11:20.72,Default,,0,0,0,,Бұл сіз жалғыз жасай алатын жалғыз нәрсе.
Dialogue: 0,0:11:20.80,0:11:22.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.18,0:11:27.26,Default,,0,0,0,,Менде жейде жоқ, бірақ менімен араласуға болады.
Dialogue: 0,0:11:27.97,0:11:30.89,Default,,0,0,0,,Мен бүгін Лай-чанға уәде бердім.
Dialogue: 0,0:11:30.98,0:11:33.44,Default,,0,0,0,,Бірақ мен оны жақсы білмеймін.
Dialogue: 0,0:11:33.52,0:11:35.65,Default,,0,0,0,,Жақсы тәжірибе серіктесі болмауы мүмкін
Dialogue: 0,0:11:35.73,0:11:37.27,Default,,0,0,0,,Жалғыз істеген дұрыс болса...
Dialogue: 0,0:11:37.36,0:11:38.48,Default,,0,0,0,,Мен енді келмеймін
Dialogue: 0,0:11:40.44,0:11:41.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:42.57,0:11:43.82,Default,,0,0,0,,Не деген...
Dialogue: 0,0:11:43.91,0:11:45.99,Default,,0,0,0,,Бір минут күтіңіз, мен сізді контактілермен ауыстырамын.
Dialogue: 0,0:11:46.08,0:11:47.45,Default,,0,0,0,,үшін? неге?
Dialogue: 0,0:11:47.54,0:11:50.33,Default,,0,0,0,,Мен бәрібір жалғыз болдым, сондықтан мен жалқау болдым.
Dialogue: 0,0:11:50.41,0:11:54.04,Default,,0,0,0,,Сондай-ақ, оны жүктеп салу тәсілі мүлдем жақсы емес.
Dialogue: 0,0:11:54.13,0:11:55.75,Default,,0,0,0,,Мен созылудан басынан бастаймын.
Dialogue: 0,0:11:56.46,0:11:57.29,Default,,0,0,0,,Олар әдемі әйелдер.
Dialogue: 0,0:11:57.38,0:11:58.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.97,0:12:08.10,Default,,0,0,0,,Математика 95 ұпай
Dialogue: 0,0:12:08.18,0:12:10.43,Default,,0,0,0,,Қоғам 99 ұпай
Dialogue: 0,0:12:11.27,0:12:13.85,Default,,0,0,0,,Яно, жапон тілінде 30 ұпай...
Dialogue: 0,0:12:13.94,0:12:15.35,Default,,0,0,0,,Уайымдама (Юхито)
Dialogue: 0,0:12:15.44,0:12:17.65,Default,,0,0,0,,Басқа адамдардың жауаптарын мазақ етпеңіз.
Dialogue: 0,0:12:17.73,0:12:18.94,Default,,0,0,0,,...
Dialogue: 0,0:12:19.02,0:12:22.45,Default,,0,0,0,,Тіпті сен де, математикадан 42 ұпай.
Dialogue: 0,0:12:22.53,0:12:23.53,Default,,0,0,0,,Қоғам 55 ұпай
Dialogue: 0,0:12:24.11,0:12:27.20,Default,,0,0,0,,Егер бәрібір айту керек болса, маған жапон тіліндегі ұпайыңызды айтыңыз.
Dialogue: 0,0:12:27.28,0:12:30.74,Default,,0,0,0,,Әсерлі 87 ұпай...
Dialogue: 0,0:12:31.33,0:12:32.75,Default,,0,0,0,,Аа~ қатты
Dialogue: 0,0:12:33.46,0:12:36.71,Default,,0,0,0,,Күтілгендей, бұл атақты мектептегідей қыздыру.
Dialogue: 0,0:12:36.79,0:12:39.46,Default,,0,0,0,,Куробане, қазір бойыңыз неше сантиметр?
Dialogue: 0,0:12:39.55,0:12:41.96,Default,,0,0,0,,Иә? 173 адам күйіп қалды
Dialogue: 0,0:12:42.67,0:12:44.09,Default,,0,0,0,,Ол қашан өлшенген?
Dialogue: 0,0:12:44.18,0:12:47.43,Default,,0,0,0,,Хм, меніңше, күз болды ма?
Dialogue: 0,0:12:51.02,0:12:52.85,Default,,0,0,0,,175.0
Dialogue: 0,0:12:52.93,0:12:56.27,Default,,0,0,0,,Ой, ол 2 сантиметрге өсті.
Dialogue: 0,0:12:56.35,0:12:57.19,Default,,0,0,0,,Келесі жолы I
Dialogue: 0,0:12:58.73,0:13:02.15,Default,,0,0,0,,172.7
Dialogue: 0,0:13:02.23,0:13:05.24,Default,,0,0,0,,Мен де өстім, 2 сантиметрге.
Dialogue: 0,0:13:05.32,0:13:07.11,Default,,0,0,0,,2,3 см айырмашылық
Dialogue: 0,0:13:07.20,0:13:08.99,Default,,0,0,0,,Сіз орнатушысыз.
Dialogue: 0,0:13:09.07,0:13:10.99,Default,,0,0,0,,Бойыңыз туралы көп уайымдаудың қажеті жоқ.
Dialogue: 0,0:13:11.95,0:13:13.83,Default,,0,0,0,,Менің сүйікті ойыншым бар
Dialogue: 0,0:13:14.41,0:13:16.25,Default,,0,0,0,,Абэ бүкіл Жапония үшін таңдалды
Dialogue: 0,0:13:16.87,0:13:19.42,Default,,0,0,0,,191 орнатушы бар.
Dialogue: 0,0:13:19.50,0:13:22.38,Default,,0,0,0,,Ол неғұрлым үлкен болса, орнату орны соғұрлым жоғары болады.
Dialogue: 0,0:13:22.46,0:13:24.51,Default,,0,0,0,,Торға жақын доптарға қарсы күшейеді
Dialogue: 0,0:13:24.59,0:13:27.43,Default,,0,0,0,,Сондай-ақ, ол екі жақты және сол жақ екіде жақсы ойнайды.
Dialogue: 0,0:13:27.51,0:13:29.14,Default,,0,0,0,,Иә? Айтпақшы, сен де...
Dialogue: 0,0:13:29.22,0:13:31.76,Default,,0,0,0,,Сіз оны екі қолыңызбен соғыңыз.
Dialogue: 0,0:13:31.85,0:13:33.52,Default,,0,0,0,,Сіз екі жақтысыз ба?
Dialogue: 0,0:13:33.60,0:13:35.31,Default,,0,0,0,,Мен оны екі жақты етіп жасадым.
Dialogue: 0,0:13:35.39,0:13:36.89,Default,,0,0,0,,Сіз екі жақты болса да...
Dialogue: 0,0:13:36.98,0:13:38.85,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:13:38.94,0:13:39.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:40.06,0:13:42.40,Default,,0,0,0,,Рё, не болды?
Dialogue: 0,0:13:42.48,0:13:44.28,Default,,0,0,0,,Ах Юхито...
Dialogue: 0,0:13:44.36,0:13:47.20,Default,,0,0,0,,Волейбол үйірмесі жаттығады деп естідім.
Dialogue: 0,0:13:47.28,0:13:48.70,Default,,0,0,0,,О, онда...
Dialogue: 0,0:13:48.78,0:13:49.62,Default,,0,0,0,,Жасайық! (Юхито) О!
Dialogue: 0,0:13:49.70,0:13:53.33,Default,,0,0,0,,Үш адам көп жаттығулар жасай алады
Dialogue: 0,0:13:53.41,0:13:58.04,Default,,0,0,0,,♪～
Dialogue: 0,0:14:43.46,0:14:47.67,Default,,0,0,0,,～♪
Dialogue: 0,0:14:49.59,0:14:50.43,Default,,0,0,0,,Куробанеса
Dialogue: 0,0:14:51.18,0:14:52.47,Default,,0,0,0,,Ойындарды жаттықтыру кезінде
Dialogue: 0,0:14:52.55,0:14:55.26,Default,,0,0,0,,Блокқа қараңдар, айқыш пен түзуді ажырата аласыңдар.
Dialogue: 0,0:14:55.35,0:14:58.31,Default,,0,0,0,,Айқас және түзу...
Dialogue: 0,0:14:58.39,0:15:00.94,Default,,0,0,0,,Аа, ортаға тура соғу түзу.
Dialogue: 0,0:15:01.02,0:15:02.94,Default,,0,0,0,,Крест – сыртқа сәл бұралған доп.
Dialogue: 0,0:15:03.02,0:15:04.11,Default,,0,0,0,,Керісінше, ақымақ.
Dialogue: 0,0:15:04.98,0:15:07.86,Default,,0,0,0,,Спайк алаңды диагональ бойынша кесіп өтеді
Dialogue: 0,0:15:07.94,0:15:11.07,Default,,0,0,0,,Бүйір сызыққа параллель өтетін түзу.
Dialogue: 0,0:15:11.16,0:15:13.45,Default,,0,0,0,,Авангардқа соққы бергенде
Dialogue: 0,0:15:13.53,0:15:16.83,Default,,0,0,0,,Өйткені менде тордың алдынан бетпе-бет келіп, итермелейтін әдетім бар.
Dialogue: 0,0:15:16.91,0:15:19.20,Default,,0,0,0,,Адал соқса, крестке айналады.
Dialogue: 0,0:15:19.29,0:15:22.37,Default,,0,0,0,,Егер допты сыртқа бұрам деген ниетпен соқса, ол түзу болады.
Dialogue: 0,0:15:22.46,0:15:23.67,Default,,0,0,0,,Бұл күрделі...
Dialogue: 0,0:15:24.21,0:15:26.38,Default,,0,0,0,,Бұл аса күрделі емес, бірақ (Юхито) А...
Dialogue: 0,0:15:26.46,0:15:28.38,Default,,0,0,0,,Ал, жоқ, дайындалайық.
Dialogue: 0,0:15:28.46,0:15:29.59,Default,,0,0,0,,Дайындалуда...
Dialogue: 0,0:15:29.67,0:15:30.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:31.55,0:15:33.47,Default,,0,0,0,,Басыңызда білмесеңіз де
Dialogue: 0,0:15:33.55,0:15:36.10,Default,,0,0,0,,Менің көру қабілетім жақсы, сондықтан мен блоктармен күресемін.
Dialogue: 0,0:15:36.18,0:15:40.02,Default,,0,0,0,,Өзегіңізді қаншалықты жақсы пайдаланасыз, иығыңыз қаншалықты жұмсақ және т.б.
Dialogue: 0,0:15:40.10,0:15:41.23,Default,,0,0,0,,Жоғарыда күтуге болатын жер
Dialogue: 0,0:15:41.31,0:15:45.90,Default,,0,0,0,,Мүмкін бұл сізде бар қасиет шығар.
Dialogue: 0,0:15:45.98,0:15:47.44,Default,,0,0,0,,Сіз жақсарасыз.
Dialogue: 0,0:15:47.52,0:15:48.36,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:48.44,0:15:50.49,Default,,0,0,0,,Егер сіз мұны дұрыс жасасаңыз, қысқа уақыт ішінде
Dialogue: 0,0:15:50.57,0:15:52.36,Default,,0,0,0,,Бойың да өседі.
Dialogue: 0,0:15:52.45,0:15:54.03,Default,,0,0,0,,Бұл да қызба ма?
Dialogue: 0,0:15:54.11,0:15:56.58,Default,,0,0,0,,Не? Мен біртүрлі нәрсе айттым ба?
Dialogue: 0,0:15:56.66,0:15:59.66,Default,,0,0,0,,Жоқ, сіз әрқашан бастықсыз.
Dialogue: 0,0:15:59.75,0:16:04.67,Default,,0,0,0,,Мен ол кісіні олай мақтамайтын, мойындамайтын жігіт деп ойладым.
Dialogue: 0,0:16:04.75,0:16:07.09,Default,,0,0,0,,Егер сізде мойындайтын нәрсе болса, оны мойындау табиғи нәрсе.
Dialogue: 0,0:16:08.96,0:16:10.92,Default,,0,0,0,,Волейболға қабілетім болса да
Dialogue: 0,0:16:11.80,0:16:13.88,Default,,0,0,0,,Өте танымал емес.
Dialogue: 0,0:16:16.47,0:16:18.51,Default,,0,0,0,,Хайдзима: Сен орта мектеп туралы не істейсің?
Dialogue: 0,0:16:19.35,0:16:20.60,Default,,0,0,0,,Сіз оны осында апарасыз ба?
Dialogue: 0,0:16:20.68,0:16:22.89,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:16:22.98,0:16:26.15,Default,,0,0,0,,Бірақ? Қандай да бір жағдай бар ма?
Dialogue: 0,0:16:26.23,0:16:27.86,Default,,0,0,0,,Одан да көп
Dialogue: 0,0:16:27.94,0:16:30.36,Default,,0,0,0,,Сәуір келсе, бір жыл болады.
Dialogue: 0,0:16:30.44,0:16:31.94,Default,,0,0,0,,О, қымбаттым.
Dialogue: 0,0:16:32.03,0:16:36.62,Default,,0,0,0,,Артық үміт артпау керек, бірақ бір-екі адамды ұстай аламын ба деп ойлаймын.
Dialogue: 0,0:16:36.70,0:16:38.95,Default,,0,0,0,,Мүшелер саны көбейсе, мен турнирге қатысқым келеді.
Dialogue: 0,0:16:39.03,0:16:42.33,Default,,0,0,0,,Мен бұл турнир кестесі туралы білмеймін.
Dialogue: 0,0:16:42.41,0:16:45.50,Default,,0,0,0,,Жазда Зенчу алдында префектуралық турнир болуы керек.
Dialogue: 0,0:16:45.58,0:16:49.34,Default,,0,0,0,,Сіз көріне алсаңыз да, біздің деңгейде жеңіске жете алмайсыз деп ойлаймын...
Dialogue: 0,0:16:49.92,0:16:52.59,Default,,0,0,0,,Ойнамасаң қызық емес.
Dialogue: 0,0:16:52.67,0:16:54.30,Default,,0,0,0,,Мен сіріңке ойнағым келеді
Dialogue: 0,0:16:55.05,0:16:59.76,Default,,0,0,0,,Мен бәріңді дайындаймын, сонда жазға дейін формада боласыңдар.
Dialogue: 0,0:16:59.85,0:17:01.52,Default,,0,0,0,,Қалғанын мен шешемін
Dialogue: 0,0:17:01.60,0:17:02.77,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:17:03.35,0:17:06.10,Default,,0,0,0,,Сіздің кеңесшіңіздің турнирге қатысуына рұқсат етілмегендіктен емес пе?
Dialogue: 0,0:17:06.19,0:17:07.65,Default,,0,0,0,,Ертең барып тыңдайық.
Dialogue: 0,0:17:07.73,0:17:08.56,Default,,0,0,0,,О
Dialogue: 0,0:17:08.65,0:17:11.36,Default,,0,0,0,,Ол жаққа баратын адам түпнұсқа Бонды пайдаланып жатқан жоқ па?
Dialogue: 0,0:17:11.44,0:17:13.28,Default,,0,0,0,,Чива Біраз уақыт өтті.
Dialogue: 0,0:17:13.36,0:17:15.20,Default,,0,0,0,,Ах, Рай-чан
Dialogue: 0,0:17:16.07,0:17:18.32,Default,,0,0,0,,Сіздің аға буындарыңыз қайтып келді ме?
Dialogue: 0,0:17:18.41,0:17:20.58,Default,,0,0,0,,Университет де көктемгі демалыста.
Dialogue: 0,0:17:20.66,0:17:23.45,Default,,0,0,0,,Бон, бүгін сенде қанша бар?
Dialogue: 0,0:17:23.54,0:17:24.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:24.46,0:17:26.42,Default,,0,0,0,,Сіз аз ғана өзгеріс әкеле аласыз.
Dialogue: 0,0:17:26.50,0:17:29.38,Default,,0,0,0,,Соңғы кездері үйірме жұмыстары кезінде сөмкемді қараусыз қалдыратын болдым.
Dialogue: 0,0:17:29.46,0:17:30.88,Default,,0,0,0,,Клуб қызметі?
Dialogue: 0,0:17:30.96,0:17:34.59,Default,,0,0,0,,Мен көремін. Йоримичидің айтқаны осы ма?
Dialogue: 0,0:17:34.67,0:17:36.18,Default,,0,0,0,,Сіз Балибо ойнадыңыз ба?
Dialogue: 0,0:17:36.26,0:17:38.01,Default,,0,0,0,,Тек байқап көріңіз.
Dialogue: 0,0:17:38.09,0:17:39.93,Default,,0,0,0,,Қараңызшы, сіз қабылдауды орындадыңыз ба?
Dialogue: 0,0:17:40.01,0:17:43.39,Default,,0,0,0,,Сіз не істедіңіз? Мен оны да ұмыттым
Dialogue: 0,0:17:43.47,0:17:45.89,Default,,0,0,0,,Мм... Менің ойымша, бұл солай ма?
Dialogue: 0,0:17:45.98,0:17:46.81,Default,,0,0,0,,О
Dialogue: 0,0:17:46.89,0:17:48.02,Default,,0,0,0,,Бұл өте өкінішті
Dialogue: 0,0:17:48.10,0:17:50.73,Default,,0,0,0,,Бұл "Хайкюу!!" Керемет Бон
Dialogue: 0,0:17:50.81,0:17:52.48,Default,,0,0,0,,Гяхахаха... (Юхито) Ахаха...
Dialogue: 0,0:17:52.57,0:17:53.40,Default,,0,0,0,,Хайдзима?
Dialogue: 0,0:17:53.48,0:17:54.82,Default,,0,0,0,,Мен мұны көңіл көтеру үшін істеп жатқан жоқпын.
Dialogue: 0,0:17:54.90,0:17:56.20,Default,,0,0,0,,Әлеуметтенбеу
Dialogue: 0,0:17:56.28,0:17:58.03,Default,,0,0,0,,Түсіндім, мені тартпа.
Dialogue: 0,0:17:58.11,0:18:00.20,Default,,0,0,0,,Жай ойнап жатырсыз ба? Юхито
Dialogue: 0,0:18:00.82,0:18:01.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:02.45,0:18:05.25,Default,,0,0,0,,Жоқ, мен Чика-чанға бөртпе алдым
Dialogue: 0,0:18:05.33,0:18:07.37,Default,,0,0,0,,Сіз байыпты емессіз, солай ма?
Dialogue: 0,0:18:07.46,0:18:10.42,Default,,0,0,0,,Эй, Рай-чан, сен ашулысың ба?
Dialogue: 0,0:18:10.50,0:18:13.21,Default,,0,0,0,,Соңғы кездері бірге болмағанымызға мен кінәлімін.
Dialogue: 0,0:18:13.30,0:18:15.34,Default,,0,0,0,,Көктемгі демалыста тағы ойнайық.
Dialogue: 0,0:18:15.42,0:18:17.67,Default,,0,0,0,,Көктемгі демалыста да жаттығу
Dialogue: 0,0:18:17.76,0:18:19.80,Default,,0,0,0,,Сіз мұны күнде жасай алмайсыз, солай ма?
Dialogue: 0,0:18:20.51,0:18:24.10,Default,,0,0,0,,Жазғы турнирге барсам, әлі де уақытында өте алмаймын.
Dialogue: 0,0:18:24.18,0:18:25.64,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:18:25.72,0:18:26.60,Default,,0,0,0,,Юхито~
Dialogue: 0,0:18:26.68,0:18:27.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:27.60,0:18:31.19,Default,,0,0,0,,Түсіндім, мен сені мәжбүрлеп жатырмын.
Dialogue: 0,0:18:31.27,0:18:34.27,Default,,0,0,0,,Егер сіз жай ғана көңіл көтеру үшін тастасаңыз, ұят болады.
Dialogue: 0,0:18:35.23,0:18:37.82,Default,,0,0,0,,Сіз де тым шыдамсыз болмаңыз.
Dialogue: 0,0:18:37.90,0:18:39.78,Default,,0,0,0,,Мен көп күте алмаймын.
Dialogue: 0,0:18:39.86,0:18:42.62,Default,,0,0,0,,Ей, жаман сөз айтпа.
Dialogue: 0,0:18:42.70,0:18:43.91,Default,,0,0,0,,Сіз байыпты емессіз, солай ма?
Dialogue: 0,0:18:43.99,0:18:46.87,Default,,0,0,0,,О~ Мен өте танымалмын.
Dialogue: 0,0:18:46.95,0:18:50.67,Default,,0,0,0,,Біреуін таңдасаңыз, екіншісімен байланысты үзесіз.
Dialogue: 0,0:18:51.25,0:18:53.13,Default,,0,0,0,,Мен... түсіндім, солай ма?
Dialogue: 0,0:18:53.21,0:18:56.63,Default,,0,0,0,,Менің де Рай Чанның қаны бар.
Dialogue: 0,0:18:56.71,0:18:59.09,Default,,0,0,0,,Ол оңай қызады және оңай суытады.
Dialogue: 0,0:18:59.17,0:19:02.09,Default,,0,0,0,,Волейболда да кездейсоқ жерлерден жалығып кетемін, меніңше...
Dialogue: 0,0:19:02.18,0:19:03.76,Default,,0,0,0,,Не? (ресми ант) Ах!
Dialogue: 0,0:19:04.35,0:19:05.72,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:19:05.81,0:19:06.97,Default,,0,0,0,,Жоқ, жақсы...
Dialogue: 0,0:19:07.06,0:19:08.68,Default,,0,0,0,,Бұл... Ах! (Итерілген дыбыс)
Dialogue: 0,0:19:09.27,0:19:10.73,Default,,0,0,0,,Олай болса қазір шығыңыз.
Dialogue: 0,0:19:10.81,0:19:13.69,Default,,0,0,0,,Бұл кенеттен секірмесе де...
Dialogue: 0,0:19:13.77,0:19:15.61,Default,,0,0,0,,Мен турнирді бүлдіргім келмейді.
Dialogue: 0,0:19:15.69,0:19:16.86,Default,,0,0,0,,Бұл тәртіпсіздік...
Dialogue: 0,0:19:16.94,0:19:18.40,Default,,0,0,0,,Кез келген келеңсіздіктер үшін кешірім сұраймыз.
Dialogue: 0,0:19:19.07,0:19:20.61,Default,,0,0,0,,Мен ойында болғым келеді!
Dialogue: 0,0:19:20.70,0:19:21.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:23.16,0:19:26.29,Default,,0,0,0,,Хахаха! Сіз өзіңіздің шынайы болмысыңызды көрсеттіңіз!
Dialogue: 0,0:19:26.37,0:19:30.16,Default,,0,0,0,,Әлемде беделі жоғары данышпан бапкер
Dialogue: 0,0:19:30.25,0:19:33.75,Default,,0,0,0,,Сіз тек өз қалауыңызды орындауды ойлап жүрсіз бе?
Dialogue: 0,0:19:34.38,0:19:37.25,Default,,0,0,0,,Рай-чан? Сен не туралы айтып тұрсың?
Dialogue: 0,0:19:37.34,0:19:39.97,Default,,0,0,0,,Білгің келді, Юхито.
Dialogue: 0,0:19:40.55,0:19:43.47,Default,,0,0,0,,Чика мұнда неге оралды?
Dialogue: 0,0:19:43.55,0:19:45.22,Default,,0,0,0,,Мен Хойя туралы біраз зерттеу жүргіздім.
Dialogue: 0,0:19:45.30,0:19:46.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:46.22,0:19:47.06,Default,,0,0,0,,Ой
Dialogue: 0,0:19:47.14,0:19:50.31,Default,,0,0,0,,Сіз Юхитоны кінәлайтын жерде дұрыс емессіз.
Dialogue: 0,0:19:50.39,0:19:52.77,Default,,0,0,0,,Денеңнен шыққан тот емес пе?
Dialogue: 0,0:19:52.85,0:19:53.69,Default,,0,0,0,,Рай-чан...
Dialogue: 0,0:19:53.77,0:19:55.31,Default,,0,0,0,,Дотоке Юхито (Юхито) Ах...
Dialogue: 0,0:19:55.40,0:19:58.73,Default,,0,0,0,,Мектептің аты менің қариямнан шыққан.
Dialogue: 0,0:19:58.82,0:20:01.65,Default,,0,0,0,,Бұл қариядан білу оңай болды.
Dialogue: 0,0:20:02.28,0:20:05.32,Default,,0,0,0,,Мен жай ғана интернеттен жылдам іздедім...
Dialogue: 0,0:20:05.41,0:20:06.74,Default,,0,0,0,,Мен кетемін мен кетемін
Dialogue: 0,0:20:07.33,0:20:09.95,Default,,0,0,0,,Өткен жылға дейін Такчу Мейшинде жоғарғы билік құрды.
Dialogue: 0,0:20:10.04,0:20:11.75,Default,,0,0,0,,Кемеңгердің жаман сөздері
Dialogue: 0,0:20:11.83,0:20:12.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:12.83,0:20:15.08,Default,,0,0,0,,Ей, сені шынымен жек көреді.
Dialogue: 0,0:20:15.17,0:20:16.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:17.00,0:20:18.05,Default,,0,0,0,,Юхито
Dialogue: 0,0:20:18.13,0:20:19.80,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:20:19.88,0:20:23.51,Default,,0,0,0,,Менің де Чикаға ренішім жоқ.
Dialogue: 0,0:20:23.59,0:20:25.01,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:20:25.64,0:20:27.51,Default,,0,0,0,,Мұның бәрі сіз үшін.
Dialogue: 0,0:20:27.60,0:20:29.14,Default,,0,0,0,,Жаман сөз айтпа
Dialogue: 0,0:20:29.22,0:20:31.60,Default,,0,0,0,,Волейболға тым берілмеңіз.
Dialogue: 0,0:20:31.68,0:20:32.60,Default,,0,0,0,,Неге...
Dialogue: 0,0:20:33.19,0:20:36.06,Default,,0,0,0,,Бұл жігіт волейбол үшін бәрін жасайды.
Dialogue: 0,0:20:36.15,0:20:38.32,Default,,0,0,0,,Бәрі де болады.
Dialogue: 0,0:20:39.23,0:20:40.11,Default,,0,0,0,,Дұрыс істе!
Dialogue: 0,0:20:40.86,0:20:42.44,Default,,0,0,0,,Сол жақ өрістің рөлі - қабылдау.
Dialogue: 0,0:20:43.03,0:20:45.78,Default,,0,0,0,,Сенің жұмысың менімен, орнатушымен байланысу.
Dialogue: 0,0:20:45.86,0:20:48.28,Default,,0,0,0,,Сіз жай ғана көтеріңіз дейсіз.
Dialogue: 0,0:20:48.37,0:20:52.25,Default,,0,0,0,,Мен бұлай істей алмайтын адамды тырп еткізбеймін.
Dialogue: 0,0:20:53.91,0:20:56.25,Default,,0,0,0,,Ертеңгі ойынға негізгі құрамнан шығарылды
Dialogue: 0,0:20:56.33,0:20:59.29,Default,,0,0,0,,Әзірге Йошино және басқалар
Dialogue: 0,0:20:59.38,0:21:02.34,Default,,0,0,0,,Аналардың ішімдік ішу әдеті де аз болады.
Dialogue: 0,0:21:03.26,0:21:04.55,Default,,0,0,0,,Иә? Аурухана?
Dialogue: 0,0:21:04.63,0:21:06.64,Default,,0,0,0,,Соута Йошино ше?
Dialogue: 0,0:21:08.01,0:21:10.81,Default,,0,0,0,,Сута үйде...
Dialogue: 0,0:21:11.81,0:21:14.81,Default,,0,0,0,,Тыңда, Юхито, міне осы.
Dialogue: 0,0:21:15.94,0:21:18.31,Default,,0,0,0,,Сізді тыңдамайтын клуб мүшелерін бұраңыз
Dialogue: 0,0:21:19.44,0:21:21.02,Default,,0,0,0,,Сіз мені өз-өзіне қол жұмсауға мәжбүр еттіңіз.
Dialogue: 0,0:21:21.11,0:21:22.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:23.24,0:21:25.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:25.99,0:21:30.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:51.03,0:22:55.87,Default,,0,0,0,,～♪
