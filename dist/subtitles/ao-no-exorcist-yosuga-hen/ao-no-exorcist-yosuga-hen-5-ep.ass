Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.87,0:00:05.04,Default,,0,0,0,,Мен ең күштімін
Dialogue: 0,0:00:05.13,0:00:06.75,Default,,0,0,0,,Оның нені білдіретінін білесіз бе?
Dialogue: 0,0:00:06.84,0:00:10.96,Default,,0,0,0,,Сол қарғыс атқыр Широ әп-сәтте жойылуы мүмкін.
Dialogue: 0,0:00:11.05,0:00:13.72,Default,,0,0,0,,Бұрынғы сұмдықты қараңыз.
Dialogue: 0,0:00:13.80,0:00:16.55,Default,,0,0,0,,Мен бәрін білуші, құдіретті Құдаймын.
Dialogue: 0,0:00:16.64,0:00:18.47,Default,,0,0,0,,Барлығы менің қалауым бойынша.
Dialogue: 0,0:00:18.56,0:00:21.22,Default,,0,0,0,,Сіз қалай ойлайсыз? Юрий де бақытты, солай ма?
Dialogue: 0,0:00:22.06,0:00:22.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:22.81,0:00:23.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:27.31,0:00:29.48,Default,,0,0,0,,А? Не...
Dialogue: 0,0:00:29.57,0:00:31.07,Default,,0,0,0,,Мені өлтірме!
Dialogue: 0,0:00:31.65,0:00:35.32,Default,,0,0,0,,Мен хомяк болған кезімде жақсырақ болсам ғой.
Dialogue: 0,0:00:35.41,0:00:37.62,Default,,0,0,0,,Иә? Бұл қоқыс
Dialogue: 0,0:00:37.70,0:00:42.08,Default,,0,0,0,,Сіз адамдар жасаған жақсылық пен жамандықтың нормалары мен сезімдері туралы естідіңіз бе?
Dialogue: 0,0:00:42.16,0:00:45.12,Default,,0,0,0,,Мен құдаймын, сені неге өлтіре алмаймын?
Dialogue: 0,0:00:45.21,0:00:48.25,Default,,0,0,0,,Өлтіріп, жеп жатсаң да мен сені өлтіремін.
Dialogue: 0,0:00:48.33,0:00:50.55,Default,,0,0,0,,Барлығы өмір сүргісі келеді!
Dialogue: 0,0:00:50.63,0:00:52.76,Default,,0,0,0,,Мен өмір сүргім келгендіктен өлтіремін!
Dialogue: 0,0:00:52.84,0:00:55.88,Default,,0,0,0,,Сен өмір сүрмеу үшін өлтірдің.
Dialogue: 0,0:00:55.97,0:00:57.51,Default,,0,0,0,,Сіздің де өмір сүргіңіз келуі керек.
Dialogue: 0,0:00:58.72,0:01:01.10,Default,,0,0,0,,Білмейсіз бе? фосфорлы от
Dialogue: 0,0:01:01.18,0:01:03.35,Default,,0,0,0,,Мені бұл атпен атама!
Dialogue: 0,0:01:03.43,0:01:04.43,Default,,0,0,0,,Кя!
Dialogue: 0,0:01:06.52,0:01:07.65,Default,,0,0,0,,Широ
Dialogue: 0,0:01:08.15,0:01:11.27,Default,,0,0,0,,Юрий, сенен көңілім қалды.
Dialogue: 0,0:01:11.36,0:01:14.82,Default,,0,0,0,,Мен сені жанымда қалдыруды ойладым.
Dialogue: 0,0:01:14.90,0:01:16.65,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:01:17.16,0:01:18.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:22.99,0:01:24.54,Default,,0,0,0,,Ол қашып кетті ме?
Dialogue: 0,0:01:25.04,0:01:28.83,Default,,0,0,0,,Chase! Ондай құбыжық қалаға шықса не істер еді?
Dialogue: 0,0:01:28.92,0:01:31.17,Default,,0,0,0,,Широ, жақсысың ба?
Dialogue: 0,0:01:31.25,0:01:34.34,Default,,0,0,0,,Аа, форманың арқасында жақсымын.
Dialogue: 0,0:01:34.42,0:01:36.93,Default,,0,0,0,,Е-е, сен пысықайсың ғой, солай ма?
Dialogue: 0,0:01:37.01,0:01:39.18,Default,,0,0,0,,Бала кезімде маған қарашы.
Dialogue: 0,0:01:40.09,0:01:40.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:41.26,0:01:43.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:43.52,0:01:46.35,Default,,0,0,0,,(Лилидің айқайы)
Dialogue: 0,0:01:48.65,0:01:50.65,Default,,0,0,0,,♪～
Dialogue: 0,0:03:14.19,0:03:16.19,Default,,0,0,0,,～♪
Dialogue: 0,0:03:21.49,0:03:25.95,Default,,0,0,0,,«Мен білмеймін»? Бұл әйел ақымақ сияқты әрекет етті
Dialogue: 0,0:03:26.03,0:03:28.41,Default,,0,0,0,,Мен өмір мен өлімнен жоғары тұратын болмыспын.
Dialogue: 0,0:03:29.41,0:03:30.66,Default,,0,0,0,,Құдай!
Dialogue: 0,0:03:34.75,0:03:37.17,Default,,0,0,0,,Хаха... хахаха
Dialogue: 0,0:03:37.25,0:03:41.63,Default,,0,0,0,,Бауырларым, қанаттарымның астына келіңдер.
Dialogue: 0,0:03:42.34,0:03:45.30,Default,,0,0,0,,Не? Қадамдарыңызды сағынып жүрсіз бе?
Dialogue: 0,0:03:46.22,0:03:49.22,Default,,0,0,0,,Өзіңді Құдай деп ойла...
Dialogue: 0,0:03:49.93,0:03:51.73,Default,,0,0,0,,Ол бұл Шайтан екенін айтты.
Dialogue: 0,0:03:51.81,0:03:52.89,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:52.98,0:03:55.31,Default,,0,0,0,,Шайтан? Сіз сенімдісіз бе?
Dialogue: 0,0:03:56.44,0:03:58.82,Default,,0,0,0,,Керісінше, бұл дұрыс сияқты.
Dialogue: 0,0:03:59.36,0:04:04.86,Default,,0,0,0,,Ол адам жындардың барлығымызбен дерлік байланыса алады.
Dialogue: 0,0:04:05.41,0:04:10.08,Default,,0,0,0,,Жын деп атауға лайық тіршілік иесі болуы мүмкін.
Dialogue: 0,0:04:10.16,0:04:11.66,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:04:11.75,0:04:13.46,Default,,0,0,0,,Бірақ егер бұл Шайтан болса
Dialogue: 0,0:04:13.54,0:04:15.33,Default,,0,0,0,,Иеленген дене ұзаққа бармайды.
Dialogue: 0,0:04:15.42,0:04:18.13,Default,,0,0,0,,Оның ыдырауы аз ғана уақыт
Dialogue: 0,0:04:18.21,0:04:20.46,Default,,0,0,0,,Қандай мүмкіндіктер орындалды?
Dialogue: 0,0:04:21.13,0:04:22.84,Default,,0,0,0,,Әлі жоқ шығар
Dialogue: 0,0:04:23.84,0:04:28.97,Default,,0,0,0,,Біз сіздің қайда екеніңізді білмейміз, бірақ біз оны сезінеміз.
Dialogue: 0,0:04:29.81,0:04:34.14,Default,,0,0,0,,Әлі жетілмеген, бірақ өсіп келе жатқан
Dialogue: 0,0:04:35.73,0:04:38.02,Default,,0,0,0,,Бұл сенің әкең.
Dialogue: 0,0:04:38.52,0:04:39.48,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:40.07,0:04:42.03,Default,,0,0,0,,Бұл сіз күткендей болды ма?
Dialogue: 0,0:04:42.74,0:04:44.74,Default,,0,0,0,,Жоқ... мүлде жоқ.
Dialogue: 0,0:04:45.24,0:04:47.91,Default,,0,0,0,,Бұл жақсы мағына ма? Бұл жаман дегенді білдіре ме?
Dialogue: 0,0:04:50.16,0:04:51.91,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:04:56.37,0:04:56.92,Default,,0,0,0,,Лилия
Dialogue: 0,0:04:57.50,0:04:59.92,Default,,0,0,0,,Dragoon жазбаша тестіне сұрақтар жасаңыз.
Dialogue: 0,0:05:00.00,0:05:02.01,Default,,0,0,0,,Иә? неге?
Dialogue: 0,0:05:02.09,0:05:03.92,Default,,0,0,0,,Сіз маған бір нәрсе қарызсыз.
Dialogue: 0,0:05:04.01,0:05:07.18,Default,,0,0,0,,Сіз әлі де депрессиядасыз ба?
Dialogue: 0,0:05:07.26,0:05:09.97,Default,,0,0,0,,Жарты жыл болды ғой, солай емес пе?
Dialogue: 0,0:05:10.05,0:05:11.47,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:05:11.56,0:05:12.85,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:05:12.93,0:05:14.93,Default,,0,0,0,,Ах~ менің Аомориге миссиям бар.
Dialogue: 0,0:05:15.44,0:05:18.69,Default,,0,0,0,,Маған взвод құрыңдар деді, бірақ бұл азап болады, сондықтан мен жалғыз барамын.
Dialogue: 0,0:05:18.77,0:05:20.69,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:05:20.77,0:05:22.90,Default,,0,0,0,,Жалғыз саған бірдеңе болса не істер едің?
Dialogue: 0,0:05:22.98,0:05:26.15,Default,,0,0,0,,Бір Баба Яга, бұл оңай жеңіс.
Dialogue: 0,0:05:30.12,0:05:31.66,Default,,0,0,0,,Шаршадым, ұйықтап қалдым.
Dialogue: 0,0:05:31.74,0:05:35.04,Default,,0,0,0,,Эй, мына жігіттен шындап сұрай аласың ба?
Dialogue: 0,0:05:35.75,0:05:40.50,Default,,0,0,0,,Хмм, қасиетті жерде бос орын жоқ деп ойлаймын.
Dialogue: 0,0:05:40.59,0:05:43.30,Default,,0,0,0,,Бос орын пайда болғанға дейін отбасы жоқ қыз балаға патронаттық тәрбиеші ретінде.
Dialogue: 0,0:05:43.38,0:05:47.05,Default,,0,0,0,,Неге арнамасқа? Әкесі Фуджимото
Dialogue: 0,0:05:47.13,0:05:49.72,Default,,0,0,0,,Ақымақ болма! Мефисто
Dialogue: 0,0:05:49.80,0:05:52.39,Default,,0,0,0,,Маған үнемі қажет емес тапсырмалар беру
Dialogue: 0,0:05:52.47,0:05:55.31,Default,,0,0,0,,Пана сізді бірден орналастыра алады.
Dialogue: 0,0:05:56.02,0:05:56.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:57.39,0:06:00.48,Default,,0,0,0,,Пана шынымен соншалықты нашар ма?
Dialogue: 0,0:06:00.98,0:06:03.86,Default,,0,0,0,,Онда сіз бәрін білмейсіз.
Dialogue: 0,0:06:03.94,0:06:07.32,Default,,0,0,0,,Олай болса, Широның өз қолына алғаны дұрыс деп ойлаймын.
Dialogue: 0,0:06:07.40,0:06:10.20,Default,,0,0,0,,Менің бала күтуім мүмкін емес.
Dialogue: 0,0:06:10.28,0:06:11.87,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:06:11.95,0:06:13.24,Default,,0,0,0,,Шынында да, Ок Чан.
Dialogue: 0,0:06:13.33,0:06:17.00,Default,,0,0,0,,Мені жалғыз өсіре алмаймын дедіңіз.
Dialogue: 0,0:06:17.08,0:06:18.33,Default,,0,0,0,,Ок-чан?
Dialogue: 0,0:06:18.41,0:06:22.25,Default,,0,0,0,,Әй, сіздің патронат әкеңіз, бұрынғы эксзорцист.
Dialogue: 0,0:06:22.34,0:06:22.96,Default,,0,0,0,,Иә
Dialogue: 0,0:06:23.04,0:06:27.01,Default,,0,0,0,,Жақсы аспаз Нико-чан мен көп білетін Обабаның көмегімен
Dialogue: 0,0:06:27.09,0:06:29.22,Default,,0,0,0,,Ол мені өсіргенін айтты
Dialogue: 0,0:06:29.30,0:06:32.47,Default,,0,0,0,,Широ басқаларға сенсе де көмек ала алады.
Dialogue: 0,0:06:33.35,0:06:35.52,Default,,0,0,0,,Онда сіз маған көмектесе аласыз.
Dialogue: 0,0:06:36.43,0:06:38.48,Default,,0,0,0,,А, бірақ қараңыз...
Dialogue: 0,0:06:38.56,0:06:40.35,Default,,0,0,0,,Тест сұрағы Себебі менің қолымнан келді
Dialogue: 0,0:06:40.44,0:06:42.40,Default,,0,0,0,,Бұл қарызға берілген несие
Dialogue: 0,0:06:42.48,0:06:43.98,Default,,0,0,0,,Ал, рахмет.
Dialogue: 0,0:06:48.07,0:06:51.03,Default,,0,0,0,,Жарайды, мені бір түнге қалдырыңызшы.
Dialogue: 0,0:06:51.11,0:06:51.99,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:06:54.49,0:06:57.29,Default,,0,0,0,,Мен фосфорлы жалынды күтемін
Dialogue: 0,0:06:57.37,0:06:59.12,Default,,0,0,0,,Сіз мұны әлі де жасамайсыз.
Dialogue: 0,0:06:59.21,0:07:00.96,Default,,0,0,0,,Ол әлдеқашан өлді!
Dialogue: 0,0:07:01.04,0:07:03.88,Default,,0,0,0,,Баланың тыныш тығылып қалуы мүмкін емес.
Dialogue: 0,0:07:03.96,0:07:06.05,Default,,0,0,0,,Дене нашарлай бастағанда
Dialogue: 0,0:07:06.13,0:07:09.47,Default,,0,0,0,,Ол ыдырамай тұрып міндетті түрде бөлімге оралуы керек.
Dialogue: 0,0:07:10.38,0:07:12.89,Default,,0,0,0,,Мен қайтып келсем, бұл жолы сені құтқарамын.
Dialogue: 0,0:07:12.97,0:07:15.14,Default,,0,0,0,,Сондықтан Шура-чан араласа алмайды.
Dialogue: 0,0:07:16.51,0:07:17.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:21.94,0:07:26.48,Default,,0,0,0,,Ендеше, бүгіннен бастап бәрің менің бұйрығым бойынша жұмыс істейсіңдер.
Dialogue: 0,0:07:26.57,0:07:29.24,Default,,0,0,0,,Сіздің жұмысыңыз негізінен маған көмектесу. Түсінесіз бе?
Dialogue: 0,0:07:29.32,0:07:30.78,Default,,0,0,0,,Иә, мен бар күшімді саламын
Dialogue: 0,0:07:30.86,0:07:31.82,Default,,0,0,0,,Мен құрметтімін
Dialogue: 0,0:07:31.90,0:07:33.24,Default,,0,0,0,,Жақсы, сұрақтарыңыз бар ма?
Dialogue: 0,0:07:33.32,0:07:35.95,Default,,0,0,0,,Мынау Дакко-чан қандай қыз?
Dialogue: 0,0:07:36.03,0:07:38.41,Default,,0,0,0,,Байқадың, сен менің шәкіртімсің.
Dialogue: 0,0:07:38.49,0:07:39.25,Default,,0,0,0,,Шәкірт пе?
Dialogue: 0,0:07:40.12,0:07:41.50,Default,,0,0,0,,О, бұл Широ.
Dialogue: 0,0:07:41.58,0:07:44.75,Default,,0,0,0,,Соңғы уақытта оның айналасында қызу болды.
Dialogue: 0,0:07:47.09,0:07:47.92,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:48.55,0:07:52.05,Default,,0,0,0,,Хаа~ Мына жігіттер не істеп жатыр?
Dialogue: 0,0:07:52.13,0:07:52.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:53.47,0:07:55.22,Default,,0,0,0,,Біраздан бері қызық болдым.
Dialogue: 0,0:07:55.30,0:07:57.64,Default,,0,0,0,,Широ сізге не ұнайды?
Dialogue: 0,0:07:57.72,0:07:59.52,Default,,0,0,0,,Иә! Неге олай?
Dialogue: 0,0:07:59.60,0:08:00.93,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:08:01.02,0:08:01.98,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:02.69,0:08:05.27,Default,,0,0,0,,Ол таза ақ, менен үлкен бе?
Dialogue: 0,0:08:05.35,0:08:07.44,Default,,0,0,0,,Маған сенің дауысың ұнайды, көзің де ұнайды.
Dialogue: 0,0:08:07.52,0:08:09.36,Default,,0,0,0,,Бұл таңқаларлық бөлік.
Dialogue: 0,0:08:09.44,0:08:12.07,Default,,0,0,0,,Өйткені сен менен мүлдем басқасың
Dialogue: 0,0:08:13.99,0:08:18.37,Default,,0,0,0,,Қорқынышты, суық, қатыгез және дәрменсіз
Dialogue: 0,0:08:19.20,0:08:21.91,Default,,0,0,0,,Ортадағы жылу мөлдір.
Dialogue: 0,0:08:22.00,0:08:24.04,Default,,0,0,0,,Мен көңілім қалды, оны жалғыз қалдыра алмаймын
Dialogue: 0,0:08:25.12,0:08:28.59,Default,,0,0,0,,Мен Широның жылы жеріне қол тигізгім келді.
Dialogue: 0,0:08:28.67,0:08:30.05,Default,,0,0,0,,Қолымды созу
Dialogue: 0,0:08:30.92,0:08:33.97,Default,,0,0,0,,Жоқ, бұл өте тітіркендіргіш.
Dialogue: 0,0:08:36.47,0:08:37.64,Default,,0,0,0,,Бірақ маған ұнайды
Dialogue: 0,0:08:39.06,0:08:40.35,Default,,0,0,0,,Мен сені әрқашан жақсы көрдім
Dialogue: 0,0:08:41.77,0:08:42.77,Default,,0,0,0,,Лилия?
Dialogue: 0,0:08:44.35,0:08:46.15,Default,,0,0,0,,(Люцифердің ауыр тыныс алуы)
Dialogue: 0,0:08:46.23,0:08:48.19,Default,,0,0,0,,Неге... Гохо
Dialogue: 0,0:08:48.27,0:08:50.73,Default,,0,0,0,,Тек мен... Арх!
Dialogue: 0,0:08:52.82,0:08:54.65,Default,,0,0,0,,Шайтанның жоғалғанына екі жыл
Dialogue: 0,0:08:54.74,0:08:58.16,Default,,0,0,0,,Шайтаннан алынған эликсирге төзімді болдым.
Dialogue: 0,0:08:58.24,0:09:00.41,Default,,0,0,0,,Соңғы уақытта ол әрең жұмыс істейді.
Dialogue: 0,0:09:01.08,0:09:03.79,Default,,0,0,0,,Менің ағам өте қауіпті жағдайда.
Dialogue: 0,0:09:03.87,0:09:05.92,Default,,0,0,0,,Емдеу бөлмесінің айналасындағы бөгет
Dialogue: 0,0:09:06.50,0:09:09.67,Default,,0,0,0,,Кез келген жағдайда оны күшейтуіміз керек.
Dialogue: 0,0:09:09.75,0:09:13.05,Default,,0,0,0,,Ах... анау Казуо-ниисан.
Dialogue: 0,0:09:13.13,0:09:15.01,Default,,0,0,0,,Мен не істеймін?
Dialogue: 0,0:09:15.09,0:09:16.43,Default,,0,0,0,,Гах...
Dialogue: 0,0:09:16.51,0:09:18.84,Default,,0,0,0,,Оны әр уақытта тыңдамаңыз!
Dialogue: 0,0:09:18.93,0:09:20.97,Default,,0,0,0,,Сабуротаны пайдалану мүмкін емес.
Dialogue: 0,0:09:21.06,0:09:23.02,Default,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:09:23.10,0:09:24.93,Default,,0,0,0,,Бухахаха
Dialogue: 0,0:09:25.02,0:09:27.40,Default,,0,0,0,,Осылайша мен тұрмысқа шықтым.
Dialogue: 0,0:09:27.48,0:09:29.69,Default,,0,0,0,,Бұл әкем маған дайындаған әйел.
Dialogue: 0,0:09:29.77,0:09:32.82,Default,,0,0,0,,Оның өзіне тән ештеңесі де жоқ.
Dialogue: 0,0:09:33.32,0:09:35.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:42.45,0:09:43.79,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:09:43.87,0:09:47.25,Default,,0,0,0,,Люцифер Бұл жағдай тірі тозақ.
Dialogue: 0,0:09:48.00,0:09:49.75,Default,,0,0,0,,Неге бас тартпайсың?
Dialogue: 0,0:09:51.88,0:09:53.05,Default,,0,0,0,,Келеді...
Dialogue: 0,0:09:53.55,0:09:54.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:57.84,0:09:59.51,Default,,0,0,0,,Не? Кенеттен...
Dialogue: 0,0:10:01.89,0:10:03.51,Default,,0,0,0,,О, кедергі!
Dialogue: 0,0:10:06.56,0:10:08.52,Default,,0,0,0,,Қарғыс атқыр... түсіп жатыр.
Dialogue: 0,0:10:08.60,0:10:10.35,Default,,0,0,0,,Балаларды эвакуациялаңыз!
Dialogue: 0,0:10:10.44,0:10:13.86,Default,,0,0,0,,Гехо, гохо... маскүнем.
Dialogue: 0,0:10:14.48,0:10:16.86,Default,,0,0,0,,Осы денемен бірдеңе жасаңыз.
Dialogue: 0,0:10:16.94,0:10:19.57,Default,,0,0,0,,(Эзорцисттердің айқайы)
Dialogue: 0,0:10:19.66,0:10:21.87,Default,,0,0,0,,Кішкентай шабаққа алданып қалмаңыз.
Dialogue: 0,0:10:21.95,0:10:24.45,Default,,0,0,0,,Тек басым болыңыз
Dialogue: 0,0:10:24.95,0:10:26.83,Default,,0,0,0,,Гухо га ха…
Dialogue: 0,0:10:27.33,0:10:29.37,Default,,0,0,0,,Егер бұл Ақымақ Патшаның ұрпағы болса, сенің үнемі жеңіліп отыруың таңғалатын жайт емес.
Dialogue: 0,0:10:30.92,0:10:32.88,Default,,0,0,0,,Бұл Шайтан
Dialogue: 0,0:10:32.96,0:10:36.13,Default,,0,0,0,,Кенсей, бұл жолы қашып кетші.
Dialogue: 0,0:10:36.21,0:10:38.13,Default,,0,0,0,,Бірақ мен Люциферді бұлай қалдыра алмаймын.
Dialogue: 0,0:10:38.76,0:10:41.26,Default,,0,0,0,,Еремия, сен қал.
Dialogue: 0,0:10:41.34,0:10:43.14,Default,,0,0,0,,Люциферді қорғаңыз
Dialogue: 0,0:10:43.22,0:10:43.76,Default,,0,0,0,,Иә
Dialogue: 0,0:10:44.39,0:10:45.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:45.47,0:10:47.68,Default,,0,0,0,,(Зерттеушінің айқайы)
Dialogue: 0,0:10:47.77,0:10:48.77,Default,,0,0,0,,Шайтан…
Dialogue: 0,0:10:48.85,0:10:51.06,Default,,0,0,0,,Гехо гохо...
Dialogue: 0,0:10:51.15,0:10:53.77,Default,,0,0,0,,Бұл денені қазір ауыстырыңыз.
Dialogue: 0,0:10:54.48,0:10:56.98,Default,,0,0,0,,Сонымен... ол дене, бәлкім
Dialogue: 0,0:10:57.07,0:10:59.61,Default,,0,0,0,,Бұл сізге жылдар бойы таныс нәрсе.
Dialogue: 0,0:10:59.70,0:11:00.91,Default,,0,0,0,,Бұл ерекше және ерекше.
Dialogue: 0,0:11:00.99,0:11:03.91,Default,,0,0,0,,Ауырды, бірдеңе істе!
Dialogue: 0,0:11:03.99,0:11:06.66,Default,,0,0,0,,Эликсирді енгізуге болады
Dialogue: 0,0:11:06.74,0:11:09.29,Default,,0,0,0,,Физикалық тозу жылдамдығын аздап баяулатуға болады...
Dialogue: 0,0:11:09.37,0:11:11.04,Default,,0,0,0,,Содан кейін орындаңыз.
Dialogue: 0,0:11:11.12,0:11:13.21,Default,,0,0,0,,Әй...
Dialogue: 0,0:11:13.29,0:11:17.76,Default,,0,0,0,,Тәк... Тәк-шәк, Ауырды!
Dialogue: 0,0:11:17.84,0:11:20.84,Default,,0,0,0,,Мен осылай шіріп кетсем...
Dialogue: 0,0:11:20.93,0:11:23.09,Default,,0,0,0,,Барлығы өмір сүргісі келеді!
Dialogue: 0,0:11:23.18,0:11:23.84,Default,,0,0,0,,Гррр…
Dialogue: 0,0:11:24.55,0:11:26.51,Default,,0,0,0,,Сіз де өмір сүргіңіз келеді.
Dialogue: 0,0:11:28.06,0:11:29.23,Default,,0,0,0,,Лилия…
Dialogue: 0,0:11:29.31,0:11:31.23,Default,,0,0,0,,-Юри қайда? -Ух...
Dialogue: 0,0:11:31.31,0:11:32.73,Default,,0,0,0,,басқа иттер болды,
Dialogue: 0,0:11:35.02,0:11:36.90,Default,,0,0,0,,Юрий Егин қайда?
Dialogue: 0,0:11:37.57,0:11:39.57,Default,,0,0,0,,Панаханаға шұғыл шақыру.
Dialogue: 0,0:11:43.70,0:11:45.16,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:45.24,0:11:47.87,Default,,0,0,0,,Бұл эликсирдің әсері ме?
Dialogue: 0,0:11:47.95,0:11:49.41,Default,,0,0,0,,Бірақ... Бірақ Эликсир де.
Dialogue: 0,0:11:49.50,0:11:53.25,Default,,0,0,0,,Егер сіз оны тым көп пайдалансаңыз, сізде оған төзімділік қалыптасады және ол ақырында тиімсіз болады.
Dialogue: 0,0:11:53.33,0:11:55.58,Default,,0,0,0,,А, ол сияқты ма?
Dialogue: 0,0:11:55.67,0:11:56.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:56.38,0:11:59.13,Default,,0,0,0,,Бұл бөлімнің артындағы жігіт.
Dialogue: 0,0:11:59.84,0:12:02.51,Default,,0,0,0,,Ол мұнда иесі, солай ма?
Dialogue: 0,0:12:04.80,0:12:05.97,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:12:06.47,0:12:09.35,Default,,0,0,0,,Мен саған әрқашан солай қарайтынмын.
Dialogue: 0,0:12:09.43,0:12:13.64,Default,,0,0,0,,Менің қасымдағы ең үлкен күшті басқара алатын сен кімсің?
Dialogue: 0,0:12:14.73,0:12:20.48,Default,,0,0,0,,Мен Сегіз Патшаның (Баалдың) біріншісімін, Люцифер, Жарық Патшасымын.
Dialogue: 0,0:12:20.57,0:12:23.40,Default,,0,0,0,,Ал мен саған бас иетін адаммын.
Dialogue: 0,0:12:24.70,0:12:30.33,Default,,0,0,0,,Мен саған қызмет етемін, әкем, шайтан Шайтан.
Dialogue: 0,0:12:31.12,0:12:37.29,Default,,0,0,0,,Бәріміз ағайынбыз, Әкеге де қуанышпен қызмет етейік.
Dialogue: 0,0:12:37.38,0:12:39.84,Default,,0,0,0,,Ахахха! жақсы!
Dialogue: 0,0:12:39.92,0:12:43.30,Default,,0,0,0,,Қызық емес пе? Маған ұнайды, Люцифер.
Dialogue: 0,0:12:43.38,0:12:47.26,Default,,0,0,0,,Мұқият тыңдаңыз! Мен мұны өз сарайыма айналдырамын
Dialogue: 0,0:12:47.34,0:12:50.31,Default,,0,0,0,,Мен патшамын, сендер патшалықтың тұрғындарысыңдар.
Dialogue: 0,0:12:50.39,0:12:51.56,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:51.64,0:12:54.35,Default,,0,0,0,,Біз не істеуіміз керек...
Dialogue: 0,0:12:54.44,0:12:58.44,Default,,0,0,0,,Мен және Люцифер үшін зерттеуіңізді жалғастырыңыз.
Dialogue: 0,0:12:58.94,0:13:01.23,Default,,0,0,0,,Сіз зерттеуді жалғастыра аласыз
Dialogue: 0,0:13:01.94,0:13:03.11,Default,,0,0,0,,О...
Dialogue: 0,0:13:03.19,0:13:05.40,Default,,0,0,0,,Бұл қарапайым ереже.
Dialogue: 0,0:13:05.49,0:13:07.74,Default,,0,0,0,,Маған қызмет етсең, мен сені қорғаймын.
Dialogue: 0,0:13:08.37,0:13:10.83,Default,,0,0,0,,Егер бүлік шығарсаңдар, бәрің де өлесіңдер.
Dialogue: 0,0:13:11.83,0:13:13.33,Default,,0,0,0,,Шайтан бөлімнің қызметкері
Dialogue: 0,0:13:13.41,0:13:15.16,Default,,0,0,0,,Эксперименттік субъектіні кепілге алу
Dialogue: 0,0:13:15.25,0:13:17.88,Default,,0,0,0,,Сұралған тамақ, зерттеу материалдары және т.б.
Dialogue: 0,0:13:17.96,0:13:19.38,Default,,0,0,0,,Қоршауға ниетіңіз бар ма?
Dialogue: 0,0:13:19.96,0:13:24.63,Default,,0,0,0,,Кедергі жойылған жағдайға қатысты ел ішінде де, халықаралық деңгейде де түсіндіруді талап етеді.
Dialogue: 0,0:13:25.13,0:13:27.26,Default,,0,0,0,,Оны жасырудың шегі бар ма?
Dialogue: 0,0:13:27.34,0:13:29.51,Default,,0,0,0,,Тек бөлім жасырылған.
Dialogue: 0,0:13:29.60,0:13:31.89,Default,,0,0,0,,Одан басқа, жалпыға жария етейік.
Dialogue: 0,0:13:32.60,0:13:34.89,Default,,0,0,0,,Шайтанның бар екендігі...
Dialogue: 0,0:13:34.98,0:13:36.44,Default,,0,0,0,,Мен әлі де сене алар емеспін.
Dialogue: 0,0:13:36.52,0:13:38.31,Default,,0,0,0,,Бұл Қытай филиалынан Люси Ян.
Dialogue: 0,0:13:38.40,0:13:40.90,Default,,0,0,0,,Сондай-ақ Мексика филиалынан Оссеола Редарм бар.
Dialogue: 0,0:13:40.98,0:13:42.65,Default,,0,0,0,,Бұл Ширу Фуджимото ма?
Dialogue: 0,0:13:42.73,0:13:45.07,Default,,0,0,0,,Төрт ұлы рыцарь (Арканттар) жоқ, бірақ Қасиетті Рыцарлар келе жатыр.
Dialogue: 0,0:13:45.15,0:13:47.15,Default,,0,0,0,,Рыцарлар тобының негізгі күштері жұмылдырылды.
Dialogue: 0,0:13:51.12,0:13:53.62,Default,,0,0,0,,Сонда сен хабаршысың ба?
Dialogue: 0,0:13:53.70,0:13:55.58,Default,,0,0,0,,Ол біртүрлі жігіт.
Dialogue: 0,0:13:55.66,0:13:59.00,Default,,0,0,0,,Ол жын болса да, көбіне адамның жағын алады.
Dialogue: 0,0:13:59.08,0:14:03.34,Default,,0,0,0,,Сіз өте күшті сияқтысыз. Сіз маған қосылғыңыз келе ме?
Dialogue: 0,0:14:03.96,0:14:05.09,Default,,0,0,0,,Мен тәтті картоппын
Dialogue: 0,0:14:05.17,0:14:07.01,Default,,0,0,0,,Бұл біздің сеніміміз
Dialogue: 0,0:14:07.09,0:14:10.97,Default,,0,0,0,,Шақырғаныңызға рахмет, бірақ мен одан бас тартамын.
Dialogue: 0,0:14:11.05,0:14:11.76,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:14:11.85,0:14:15.77,Default,,0,0,0,,Сонымен қатар, керек-жарақтарға не болды? Мен оны таба алмаймын
Dialogue: 0,0:14:16.35,0:14:19.60,Default,,0,0,0,,Жабдықтар кепілге алынған балаларды босатуға айырбас болып табылады.
Dialogue: 0,0:14:19.69,0:14:20.52,Default,,0,0,0,,Назар аударғаныңызға рахмет...
Dialogue: 0,0:14:22.19,0:14:23.52,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:26.11,0:14:29.41,Default,,0,0,0,,Мәміле? Мені күлдірмеңіз
Dialogue: 0,0:14:29.49,0:14:31.82,Default,,0,0,0,,Өз ұстанымыңды біл, ақымақ!
Dialogue: 0,0:14:31.91,0:14:33.62,Default,,0,0,0,,Бір ай.
Dialogue: 0,0:14:33.70,0:14:36.83,Default,,0,0,0,,Менің қорым таусылғанда, бір ай ішінде маған керек-жарақтарды беріңіз.
Dialogue: 0,0:14:36.91,0:14:40.33,Default,,0,0,0,,Әйтпесе, мен оны лезде өшіремін.
Dialogue: 0,0:14:41.71,0:14:46.71,Default,,0,0,0,,Бәрін өлтір... Хахахаха мына жігіт пен мына жігіт.
Dialogue: 0,0:14:46.80,0:14:47.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:51.97,0:14:53.68,Default,,0,0,0,,Эликсирді ұстаңыз!
Dialogue: 0,0:14:53.76,0:14:57.02,Default,,0,0,0,,Шайтанның сенімді жын шығару сиқырын білгенге дейін
Dialogue: 0,0:14:57.10,0:15:00.94,Default,,0,0,0,,Неге алдымен кепілге алынғандардың қауіпсіздігін қамтамасыз етіп, оларды керек-жарақпен қамтамасыз етпеске?
Dialogue: 0,0:15:01.02,0:15:02.90,Default,,0,0,0,,Сондықтан біз күресуіміз керек
Dialogue: 0,0:15:02.98,0:15:04.23,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:04.32,0:15:06.57,Default,,0,0,0,,Шайтанның талабына көнбе
Dialogue: 0,0:15:06.65,0:15:10.61,Default,,0,0,0,,Сонымен қатар, егер сіз Шайтанға айналсаңыз, сіздің иеленген денеңіз ұзаққа бармайды.
Dialogue: 0,0:15:10.70,0:15:14.95,Default,,0,0,0,,Қалған айда біз шайтанның иелігін жоюды мақсат етеміз.
Dialogue: 0,0:15:19.20,0:15:22.33,Default,,0,0,0,,(Эзорцисттердің айқайы)
Dialogue: 0,0:15:23.29,0:15:28.17,Default,,0,0,0,,Ақырында мен бір ай бойы Баспананы жаулап алудың ізін де таба алмадым.
Dialogue: 0,0:15:28.67,0:15:30.76,Default,,0,0,0,,Өлгендердің саны сансыз.
Dialogue: 0,0:15:31.26,0:15:32.51,Default,,0,0,0,,Бұл шайқас
Dialogue: 0,0:15:32.59,0:15:35.14,Default,,0,0,0,,Бірдеңе дұрыс емес деп ойламайсыз ба? Осцеола
Dialogue: 0,0:15:35.22,0:15:38.18,Default,,0,0,0,,Жындардың бекінісін анықтау мүмкін емес.
Dialogue: 0,0:15:38.27,0:15:40.64,Default,,0,0,0,,Баспана қай жерден келеді?
Dialogue: 0,0:15:40.73,0:15:44.23,Default,,0,0,0,,Ертең кепілге алынғандар үшін сіздің талаптарыңызды қабылдамайтын сияқты...
Dialogue: 0,0:15:44.31,0:15:46.86,Default,,0,0,0,,Шайтан мүлде көрінбейді...
Dialogue: 0,0:15:46.94,0:15:49.65,Default,,0,0,0,,Мен үш бурл бар дегенді естімеппін.
Dialogue: 0,0:15:50.24,0:15:51.90,Default,,0,0,0,,Мені жіберуіңізді өтінемін
Dialogue: 0,0:15:51.99,0:15:53.82,Default,,0,0,0,,Мен Шайтанды сендіруге тырысамын
Dialogue: 0,0:15:54.32,0:15:55.95,Default,,0,0,0,,Сіз әлі де солай айтасыз ба?
Dialogue: 0,0:15:56.03,0:15:58.62,Default,,0,0,0,,Мұнда келіп-кетуге кім рұқсат береді?
Dialogue: 0,0:15:58.70,0:16:01.00,Default,,0,0,0,,Өйткені мен Шайтанды жақсы білемін.
Dialogue: 0,0:16:01.08,0:16:04.25,Default,,0,0,0,,Көптеген адамдар өліп жатыр. Мен үндемей тұра алмаймын.
Dialogue: 0,0:16:04.75,0:16:07.13,Default,,0,0,0,,Шайтан мені шақырды, солай ма?
Dialogue: 0,0:16:07.21,0:16:09.96,Default,,0,0,0,,Тек қамауда болғаннан кейін бірінші байланыста.
Dialogue: 0,0:16:10.05,0:16:11.97,Default,,0,0,0,,Содан бері өтініштер түскен жоқ.
Dialogue: 0,0:16:13.13,0:16:15.39,Default,,0,0,0,,Ал, түсінікті болсын.
Dialogue: 0,0:16:15.89,0:16:17.93,Default,,0,0,0,,Статус-квоны сақтау қажет.
Dialogue: 0,0:16:18.43,0:16:22.35,Default,,0,0,0,,Бұл туралы ештеңе білмейтін шетелдік күшейтулер баспанада күресуге мүмкіндік беріңіз.
Dialogue: 0,0:16:22.43,0:16:25.85,Default,,0,0,0,,Осы уақытта бөлімге керек-жарақтар жасырын түрде тасымалданады.
Dialogue: 0,0:16:26.77,0:16:28.07,Default,,0,0,0,,Шайтан эликсир үшін
Dialogue: 0,0:16:28.15,0:16:30.61,Default,,0,0,0,,Олар бөлімді сақтайтын сияқты.
Dialogue: 0,0:16:30.69,0:16:33.15,Default,,0,0,0,,Шайтанның жағдайы мәз емес сияқты.
Dialogue: 0,0:16:33.24,0:16:35.20,Default,,0,0,0,,Қанша уақыт алатынын білмеймін.
Dialogue: 0,0:16:35.28,0:16:37.74,Default,,0,0,0,,Осылай шіріп кетсе, айтар сөзім жоқ.
Dialogue: 0,0:16:38.24,0:16:40.66,Default,,0,0,0,,Бұл ұзақ мерзімді шайқас.
Dialogue: 0,0:16:41.29,0:16:44.46,Default,,0,0,0,,Сіз шынымен бөлімнің бар болуын қорғағыңыз келе ме?
Dialogue: 0,0:16:44.54,0:16:45.67,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:46.25,0:16:48.67,Default,,0,0,0,,Бұл біздің арнайы агент ретіндегі жұмысымыз.
Dialogue: 0,0:16:55.97,0:16:56.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:24.12,0:17:25.41,Default,,0,0,0,,Барғыңыз келе ме?
Dialogue: 0,0:17:27.04,0:17:28.04,Default,,0,0,0,,Широ
Dialogue: 0,0:17:28.54,0:17:31.09,Default,,0,0,0,,Бөлімге қалай кірмексіз?
Dialogue: 0,0:17:31.17,0:17:32.92,Default,,0,0,0,,Кілтті қазір қайтарыңыз...
Dialogue: 0,0:17:33.01,0:17:35.63,Default,,0,0,0,,Еліктеу бөліміне оралды
Dialogue: 0,0:17:35.72,0:17:37.72,Default,,0,0,0,,Мен нақты нәрсені жасырдым.
Dialogue: 0,0:17:38.22,0:17:41.39,Default,,0,0,0,,Ал, бұл ескі күндер ғана. Мен үндемедім.
Dialogue: 0,0:17:41.47,0:17:42.43,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:42.51,0:17:45.27,Default,,0,0,0,,Мен де толық жауызға айналдым.
Dialogue: 0,0:17:46.39,0:17:47.90,Default,,0,0,0,,Мен әлі баруым керек
Dialogue: 0,0:17:49.52,0:17:51.90,Default,,0,0,0,,Мені шығарып салуға келдің бе?
Dialogue: 0,0:17:51.98,0:17:54.11,Default,,0,0,0,,Кездейсоқ емес
Dialogue: 0,0:17:54.65,0:17:55.53,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:17:55.61,0:17:58.16,Default,,0,0,0,,Соңында шыншыл болсам ғой.
Dialogue: 0,0:17:59.03,0:18:01.16,Default,,0,0,0,,Шура-чан, бәрімен жақсы аралас.
Dialogue: 0,0:18:01.66,0:18:03.70,Default,,0,0,0,,Бөлмеңізді мұқият тазалаңыз.
Dialogue: 0,0:18:03.79,0:18:07.58,Default,,0,0,0,,Сондай-ақ, үнемі темекі шегу денеңізге зиян тигізеді.
Dialogue: 0,0:18:08.79,0:18:09.75,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:18:22.85,0:18:23.81,Default,,0,0,0,,Эй, сен келгеннен бері бәрі осылай болып тұр, иә?
Dialogue: 0,0:18:25.35,0:18:26.43,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:18:44.12,0:18:47.41,Default,,0,0,0,,Әке! Вампир Фуджимото әке!
Dialogue: 0,0:18:47.50,0:18:50.12,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:18:51.04,0:18:52.21,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:19:09.39,0:19:10.56,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:13.02,0:19:15.90,Default,,0,0,0,,Қош бол Широ
Dialogue: 0,0:19:23.45,0:19:25.87,Default,,0,0,0,,(Шайтанның шуы)
Dialogue: 0,0:19:32.00,0:19:32.88,Default,,0,0,0,,Лилия?
Dialogue: 0,0:19:33.67,0:19:35.38,Default,,0,0,0,,Көптен бері көрмедім, Шайтан
Dialogue: 0,0:19:36.21,0:19:37.88,Default,,0,0,0,,Маған ісіңді тез айт.
Dialogue: 0,0:19:38.76,0:19:41.76,Default,,0,0,0,,Өтінемін, адамдармен ұрысуды доғарыңыз.
Dialogue: 0,0:19:42.26,0:19:44.76,Default,,0,0,0,,Бөлімдегі адамдарды да босатыңыз.
Dialogue: 0,0:19:45.26,0:19:46.43,Default,,0,0,0,,Менімен бірге қаш
Dialogue: 0,0:19:46.93,0:19:49.89,Default,,0,0,0,,Мен сені бұл жолы тастамаймын
Dialogue: 0,0:19:49.98,0:19:52.44,Default,,0,0,0,,Хаха... хахахаха!
Dialogue: 0,0:19:52.52,0:19:55.61,Default,,0,0,0,,Сіз өзіңізді соншалықты құндымын деп ойлайсыз ба?
Dialogue: 0,0:19:55.69,0:19:57.61,Default,,0,0,0,,Не деген босқа әйел.
Dialogue: 0,0:19:57.69,0:19:59.19,Default,,0,0,0,,Сіз мені шақырдыңыз, солай ма?
Dialogue: 0,0:19:59.74,0:20:01.28,Default,,0,0,0,,Маған сенімен бірге болуға рұқсат ет
Dialogue: 0,0:20:01.78,0:20:04.82,Default,,0,0,0,,Менімен бірге болғың келмейді.
Dialogue: 0,0:20:05.53,0:20:07.49,Default,,0,0,0,,Мен бәрін білемін.
Dialogue: 0,0:20:07.58,0:20:12.00,Default,,0,0,0,,Сіз қарапайым адамсыз. Сіз мені түсіне алмайсыз.
Dialogue: 0,0:20:12.08,0:20:16.21,Default,,0,0,0,,Олар өз түсінігінен тыс нәрселердің бар екенін қабылдай алмайды және оларды жек көреді.
Dialogue: 0,0:20:16.29,0:20:17.42,Default,,0,0,0,,Өйткені сен ақымақсың
Dialogue: 0,0:20:17.50,0:20:19.42,Default,,0,0,0,,Мен уайымдап тұрмын!
Dialogue: 0,0:20:19.50,0:20:22.59,Default,,0,0,0,,Денеңіз ұзаққа бармайды дегенді естігенде қандай қорқынышты сезінесіз?
Dialogue: 0,0:20:22.67,0:20:25.34,Default,,0,0,0,,Ах~! Шулы!
Dialogue: 0,0:20:25.43,0:20:28.72,Default,,0,0,0,,Маған бала сияқты қарама! Мен құдаймын!
Dialogue: 0,0:20:29.31,0:20:32.27,Default,,0,0,0,,Өте жақсы, неге екенін білмеймін...
Dialogue: 0,0:20:32.35,0:20:34.35,Default,,0,0,0,,Гухо! Гаха…
Dialogue: 0,0:20:34.44,0:20:37.02,Default,,0,0,0,,Неліктен мінсіз мен осылай аяқталды?
Dialogue: 0,0:20:37.61,0:20:40.82,Default,,0,0,0,,Сен... сен нағыз көздің жауысың.
Dialogue: 0,0:20:40.90,0:20:42.24,Default,,0,0,0,,Ой~!
Dialogue: 0,0:20:42.32,0:20:44.70,Default,,0,0,0,,(Шайтандардың айқайы)
Dialogue: 0,0:20:44.78,0:20:48.28,Default,,0,0,0,,Хахахаха Өлтір, көретін нәрсе ғой.
Dialogue: 0,0:20:48.99,0:20:50.37,Default,,0,0,0,,Кен Баоак!
Dialogue: 0,0:20:51.95,0:20:55.17,Default,,0,0,0,,Хахахаха қаншаға дейін созылады екен
Dialogue: 0,0:20:56.04,0:20:57.04,Default,,0,0,0,,Кя!
Dialogue: 0,0:20:57.13,0:20:58.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:58.79,0:20:59.42,Default,,0,0,0,,Баорк
Dialogue: 0,0:20:59.50,0:21:01.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:01.71,0:21:02.76,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:07.05,0:21:09.76,Default,,0,0,0,,Гохо… Гехо…
Dialogue: 0,0:21:13.06,0:21:14.06,Default,,0,0,0,,...меда
Dialogue: 0,0:21:17.44,0:21:21.23,Default,,0,0,0,,Өтінемін, менің қасымда болшы.
Dialogue: 0,0:21:22.15,0:21:25.24,Default,,0,0,0,,Сен менікісің
Dialogue: 0,0:22:01.77,0:22:02.61,Default,,0,0,0,,Иә
Dialogue: 0,0:22:05.94,0:22:07.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.24,0:23:35.24,Default,,0,0,0,,～♪
