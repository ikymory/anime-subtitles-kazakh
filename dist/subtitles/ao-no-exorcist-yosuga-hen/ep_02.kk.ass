Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.12,0:00:06.92,Default,,0,0,0,,Сіз қауіпсіздіктен жалтарасыз
Dialogue: 0,0:00:07.00,0:00:08.67,Default,,0,0,0,,Жиі 13 бөлім
Dialogue: 0,0:00:08.75,0:00:10.46,Default,,0,0,0,,Шығатын сияқты.
Dialogue: 0,0:00:10.96,0:00:13.80,Default,,0,0,0,,Тіптен тым-тырыс елді мекендерге жасырынған үй салыпты.
Dialogue: 0,0:00:13.88,0:00:15.89,Default,,0,0,0,,Хехе қызық
Dialogue: 0,0:00:16.39,0:00:20.60,Default,,0,0,0,,Мен өз тәжірибемде сіз сияқты адамды бірінші рет көріп тұрмын.
Dialogue: 0,0:00:21.10,0:00:25.23,Default,,0,0,0,,Жасырын жерден аздаған ақша, шамамен 30 000 иен табылған сияқты.
Dialogue: 0,0:00:25.31,0:00:27.40,Default,,0,0,0,,Оны қалай жинадың?
Dialogue: 0,0:00:27.48,0:00:29.61,Default,,0,0,0,,Цк, ұрлама.
Dialogue: 0,0:00:30.11,0:00:34.07,Default,,0,0,0,,Мен бөлшектерді тазалау және сату сияқты көп нәрсені жасадым ...Мен ақша жинадым.
Dialogue: 0,0:00:34.15,0:00:36.28,Default,,0,0,0,,Бұл қиын болар еді
Dialogue: 0,0:00:36.91,0:00:40.24,Default,,0,0,0,,Баласың, дүние қатал.
Dialogue: 0,0:00:40.33,0:00:43.37,Default,,0,0,0,,Адалдық Бөлімде тыныш болған дұрыс
Dialogue: 0,0:00:43.46,0:00:46.04,Default,,0,0,0,,Жеңіл өмір сүруге болатынын түсінбедің бе?
Dialogue: 0,0:00:46.12,0:00:49.21,Default,,0,0,0,,Дұрыс, дүние қоқысқа толы.
Dialogue: 0,0:00:49.71,0:00:52.17,Default,,0,0,0,,Бірақ бұл ақымақ бөлімнен әлдеқайда жақсы.
Dialogue: 0,0:00:52.80,0:00:55.05,Default,,0,0,0,,Ақшаң жеткілікті болған соң, бұл жерден қаш.
Dialogue: 0,0:00:55.13,0:00:57.84,Default,,0,0,0,,Мен алыс жерде еркін өмір сүруді жоспарладым.
Dialogue: 0,0:00:58.34,0:01:00.72,Default,,0,0,0,,Сондай жерде, маған ұқсайтын адамдармен
Dialogue: 0,0:01:00.81,0:01:02.85,Default,,0,0,0,,Дүниені білмей өмір сүрсең
Dialogue: 0,0:01:03.64,0:01:05.39,Default,,0,0,0,,Өлгені жақсы.
Dialogue: 0,0:01:05.89,0:01:07.85,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:08.35,0:01:10.61,Default,,0,0,0,,Мені өлтіресің бе?
Dialogue: 0,0:01:10.69,0:01:11.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:11.40,0:01:14.57,Default,,0,0,0,,Сіз бөлімдегі ең аға директорсыз ба?
Dialogue: 0,0:01:14.65,0:01:16.20,Default,,0,0,0,,Мефисто Фелес
Dialogue: 0,0:01:16.28,0:01:16.86,Default,,0,0,0,,Пух
Dialogue: 0,0:01:16.95,0:01:19.20,Default,,0,0,0,,Хяхаха! Хахахаха!
Dialogue: 0,0:01:19.28,0:01:22.99,Default,,0,0,0,,Айтып отырғанымды ойласам, хи хи хи!
Dialogue: 0,0:01:23.08,0:01:25.87,Default,,0,0,0,,Сен... поф, бұл жақсы.
Dialogue: 0,0:01:25.96,0:01:27.50,Default,,0,0,0,,Қызық екен!
Dialogue: 0,0:01:27.58,0:01:28.37,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:01:29.00,0:01:31.63,Default,,0,0,0,,Маған ұнады ма? мефисто
Dialogue: 0,0:01:31.71,0:01:32.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:34.42,0:01:36.76,Default,,0,0,0,,Онда мені кандидат ет!
Dialogue: 0,0:01:37.26,0:01:38.43,Default,,0,0,0,,Пампака-пан!
Dialogue: 0,0:01:42.01,0:01:44.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:08.52,0:03:10.52,Default,,0,0,0,,～♪
Dialogue: 0,0:03:14.52,0:03:16.65,Default,,0,0,0,,Сізге хат жіберді ме?
Dialogue: 0,0:03:16.73,0:03:20.90,Default,,0,0,0,,Әрбір 15 жыл сайын тестілеу субъектілерінің әр тобынан бір адам эксвиро жасауы керек.
Dialogue: 0,0:03:20.99,0:03:23.20,Default,,0,0,0,,Биыл 15 жыл.
Dialogue: 0,0:03:23.28,0:03:25.16,Default,,0,0,0,,Az тобы әлі шешілген жоқ
Dialogue: 0,0:03:25.24,0:03:26.53,Default,,0,0,0,,Шарттар маған да сәйкес келеді.
Dialogue: 0,0:03:26.62,0:03:28.04,Default,,0,0,0,,- (Широ) Маған солай істе! -Уф...
Dialogue: 0,0:03:28.12,0:03:31.46,Default,,0,0,0,,Егер сіз Exwire болсаңыз, эксперименттік субъект ретінде сіздің міндеттеріңіз жылына бір рет қана болады.
Dialogue: 0,0:03:31.54,0:03:34.13,Default,,0,0,0,,Егер сіз жын шығаратын болсаңыз, өз бетіңізше өмір сүре аласыз.
Dialogue: 0,0:03:34.21,0:03:38.55,Default,,0,0,0,,Қасиетті рыцарь болсаң, мәртебең де, ақшаң да, абыройың да,... әйелің де болады.
Dialogue: 0,0:03:38.63,0:03:40.05,Default,,0,0,0,,Бостандық!
Dialogue: 0,0:03:41.01,0:03:43.80,Default,,0,0,0,,Мен адамдарды жындардан құтқару үшін жаратылғанмын.
Dialogue: 0,0:03:44.68,0:03:46.55,Default,,0,0,0,,Осындай өмірге өкінемін.
Dialogue: 0,0:03:46.64,0:03:49.56,Default,,0,0,0,,Шайтанға құрбандыққа берілме.
Dialogue: 0,0:03:51.23,0:03:52.23,Default,,0,0,0,,-Буху - (Широ) Уф...
Dialogue: 0,0:03:52.31,0:03:55.27,Default,,0,0,0,,Хе... хи хи хи хи хи
Dialogue: 0,0:03:55.36,0:03:57.57,Default,,0,0,0,,Қандай надан және ақымақ!
Dialogue: 0,0:03:57.65,0:03:58.78,Default,,0,0,0,,Гррр…
Dialogue: 0,0:03:58.86,0:04:01.53,Default,,0,0,0,,Паладин - бостандыққа билет емес
Dialogue: 0,0:04:02.03,0:04:03.32,Default,,0,0,0,,♪ Вуф-вуф, вуф-вуф
Dialogue: 0,0:04:03.40,0:04:05.37,Default,,0,0,0,,Егер сіз Exwire болсаңыз
Dialogue: 0,0:04:05.45,0:04:07.74,Default,,0,0,0,,Бөлім туралы ақпаратты сыртқа шығармаңыз
Dialogue: 0,0:04:07.83,0:04:11.83,Default,,0,0,0,,Өмірімнің орнына мен Молинаспен келісім-шартқа отырамын.
Dialogue: 0,0:04:11.91,0:04:15.79,Default,,0,0,0,,Хи хи хи жаттығуы өте қатал
Dialogue: 0,0:04:15.88,0:04:20.67,Default,,0,0,0,,Бұрынғы тестілеуші тірі болса, оның оқудан шығуына рұқсат етілмейді.
Dialogue: 0,0:04:21.80,0:04:23.59,Default,,0,0,0,,Паладин болсаң да
Dialogue: 0,0:04:23.68,0:04:27.55,Default,,0,0,0,,Өмір бойы рыцарлар тобына адал болуға ант беретін итке айнал.
Dialogue: 0,0:04:27.64,0:04:29.06,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:04:29.14,0:04:31.68,Default,,0,0,0,,Мәңгілік еркін бола алмайсың.
Dialogue: 0,0:04:31.77,0:04:33.89,Default,,0,0,0,,Ихихихихихи
Dialogue: 0,0:04:35.10,0:04:36.44,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:04:36.52,0:04:37.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:37.36,0:04:41.07,Default,,0,0,0,,Алдымдағы барлық жауды өлтіремін.
Dialogue: 0,0:04:41.57,0:04:44.20,Default,,0,0,0,,Өлтіру, өлтіру, өлтіру
Dialogue: 0,0:04:44.28,0:04:47.37,Default,,0,0,0,,Сіз паладин болғаннан кейін, сіздің иелеріңіз сізбен бітті.
Dialogue: 0,0:04:47.95,0:04:51.79,Default,,0,0,0,,Ақырында мен сенің тамағыңды жұлып аламын.
Dialogue: 0,0:04:53.08,0:04:54.54,Default,,0,0,0,,Қызықты
Dialogue: 0,0:04:54.62,0:04:55.96,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:04:56.04,0:04:59.21,Default,,0,0,0,,Мен сізге Azazel Group Exwire-ге кеңес беремін.
Dialogue: 0,0:04:59.29,0:05:00.63,Default,,0,0,0,,А? Шынайы ма?
Dialogue: 0,0:05:01.13,0:05:04.22,Default,,0,0,0,,Қария... бұл шынында да ұшты.
Dialogue: 0,0:05:04.30,0:05:06.51,Default,,0,0,0,,Тағы да, бұл менің уақытыма сәл ұқсас.
Dialogue: 0,0:05:06.59,0:05:07.89,Default,,0,0,0,,Мен – Фэт Гам. Баршаңызбен танысуға қуаныштымын.
Dialogue: 0,0:05:08.39,0:05:10.56,Default,,0,0,0,,Дегенмен, шарттар бар
Dialogue: 0,0:05:11.64,0:05:15.44,Default,,0,0,0,,Шайтанның алдында бір рет болса да бас игенде
Dialogue: 0,0:05:15.52,0:05:19.11,Default,,0,0,0,,Менің бір ғана өтінішімді тыңдаңыз.
Dialogue: 0,0:05:19.81,0:05:21.07,Default,,0,0,0,,...Болды.
Dialogue: 0,0:05:22.48,0:05:24.69,Default,,0,0,0,,Ал, мен міндім.
Dialogue: 0,0:05:29.16,0:05:30.70,Default,,0,0,0,,Оны міндетті түрде қорғаңыз!
Dialogue: 0,0:05:30.78,0:05:32.79,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:05:33.29,0:05:35.87,Default,,0,0,0,,Хехехе... О, құдайым.
Dialogue: 0,0:05:36.37,0:05:37.21,Default,,0,0,0,,Окумура мырза
Dialogue: 0,0:05:37.83,0:05:41.29,Default,,0,0,0,,Үй қызметшісінің стилі толығымен танымал болды.
Dialogue: 0,0:05:41.38,0:05:42.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:43.46,0:05:46.72,Default,,0,0,0,,Қария айтты, ол не бөлім?
Dialogue: 0,0:05:46.80,0:05:51.47,Default,,0,0,0,,Эксорцизм мектебі қазір баспана ма? деп аталатынын білемін
Dialogue: 0,0:05:51.97,0:05:54.81,Default,,0,0,0,,Баспана мен бөлім әртүрлі ме?
Dialogue: 0,0:05:54.89,0:05:57.81,Default,,0,0,0,,Енді жалғастырыңыз.
Dialogue: 0,0:05:57.89,0:05:59.52,Default,,0,0,0,,Маған айтпайсың ба?
Dialogue: 0,0:06:02.69,0:06:04.48,Default,,0,0,0,,Содан бері неше жыл өтті?
Dialogue: 0,0:06:04.57,0:06:05.65,Default,,0,0,0,,4 жыл
Dialogue: 0,0:06:05.74,0:06:06.65,Default,,0,0,0,,Бұл кенеттен.
Dialogue: 0,0:06:06.74,0:06:10.20,Default,,0,0,0,,Бұл жерді сіз қазір Жын шығару мектебі деп атайсыз
Dialogue: 0,0:06:10.28,0:06:12.70,Default,,0,0,0,,Ұзақ уақыт бойы ол әдетте баспана ретінде белгілі болды.
Dialogue: 0,0:06:12.78,0:06:17.96,Default,,0,0,0,,Сондай-ақ бұл балалар үйі және жын шығарушыларды дайындайтын мектеп болды.
Dialogue: 0,0:06:18.50,0:06:20.37,Default,,0,0,0,,Қайырлы таң, лорд Ферес.
Dialogue: 0,0:06:20.46,0:06:21.58,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:22.75,0:06:26.05,Default,,0,0,0,,Сен менің оққағарыма ұқсауың керек.
Dialogue: 0,0:06:26.67,0:06:32.10,Default,,0,0,0,,Жындардың ауруына шалдыққан немесе жындармен туысқан және туыстары жоқ балалар үйге беріледі.
Dialogue: 0,0:06:32.18,0:06:34.72,Default,,0,0,0,,Мен эксорцист ретінде жаттығатынмын.
Dialogue: 0,0:06:37.14,0:06:37.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:37.81,0:06:39.06,Default,,0,0,0,,Анашым!
Dialogue: 0,0:06:40.23,0:06:43.77,Default,,0,0,0,,Бірақ көгілдір түннен кейін ол жойылады.
Dialogue: 0,0:06:44.27,0:06:46.03,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:06:46.11,0:06:48.74,Default,,0,0,0,,Мен білмеймін. Неліктен?
Dialogue: 0,0:06:49.90,0:06:52.74,Default,,0,0,0,,Өйткені бұл жер қараған жер еді.
Dialogue: 0,0:06:53.32,0:06:54.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:54.95,0:06:57.25,Default,,0,0,0,,Баспана – бұл былайша айтқанда, жұртшылықтың бет-бейнесі.
Dialogue: 0,0:06:57.33,0:06:59.08,Default,,0,0,0,,Оның тереңдігінде
Dialogue: 0,0:06:59.16,0:07:03.46,Default,,0,0,0,,Ол 13-ші бөлім деп аталатын зерттеу нысанын жасырды.
Dialogue: 0,0:07:03.96,0:07:04.67,Default,,0,0,0,,Зерттеу?
Dialogue: 0,0:07:05.29,0:07:09.59,Default,,0,0,0,,Зерттеу күрделі және сіз оны түсіне алмайсыз.
Dialogue: 0,0:07:09.67,0:07:12.43,Default,,0,0,0,,Ал... Меніңше, солай.
Dialogue: 0,0:07:16.47,0:07:19.18,Default,,0,0,0,,Қысқасы... Иә.
Dialogue: 0,0:07:19.27,0:07:21.89,Default,,0,0,0,,Корольдік деңгейдегі жынның иеленуіне төтеп бере алатын адам денесі.
Dialogue: 0,0:07:21.98,0:07:24.06,Default,,0,0,0,,Мен жасауға тырыстым
Dialogue: 0,0:07:24.15,0:07:25.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:25.86,0:07:27.94,Default,,0,0,0,,Жын патшасының клонын жасаңыз
Dialogue: 0,0:07:28.03,0:07:31.36,Default,,0,0,0,,Бұл иеленген денені өсіруге арналған зерттеу.
Dialogue: 0,0:07:32.45,0:07:34.87,Default,,0,0,0,,Широ Фуджимото осында дүниеге келген.
Dialogue: 0,0:07:35.78,0:07:38.62,Default,,0,0,0,,Ки король Азазельдің клоны ретінде
Dialogue: 0,0:07:38.70,0:07:39.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:41.08,0:07:43.37,Default,,0,0,0,,Мефисто шайтанның ыдысын жасау
Dialogue: 0,0:07:43.46,0:07:46.17,Default,,0,0,0,,Көптеген адам өмірі эксперимент ретінде пайдаланылды.
Dialogue: 0,0:07:46.67,0:07:50.26,Default,,0,0,0,,Оның үстіне менің әкем сол экспериментте дүниеге келген эксперименталушы болды...
Dialogue: 0,0:07:52.84,0:07:54.26,Default,,0,0,0,,Сіз...
Dialogue: 0,0:07:55.76,0:07:57.76,Default,,0,0,0,,Олар жау ма?
Dialogue: 0,0:07:57.85,0:07:59.14,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:07:59.22,0:08:00.89,Default,,0,0,0,,Бұл Люциферге арналған.
Dialogue: 0,0:08:00.98,0:08:02.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:02.73,0:08:07.40,Default,,0,0,0,,Эксперименттік тақырып Зерттеуші Зерттеу туралы барлығы
Dialogue: 0,0:08:08.23,0:08:10.61,Default,,0,0,0,,Бұл нысан туралы барлығы
Dialogue: 0,0:08:11.11,0:08:14.53,Default,,0,0,0,,Люцифер деп аталатын күшті бомбаның жарылуын көру
Dialogue: 0,0:08:14.61,0:08:17.12,Default,,0,0,0,,Уақытты сатып алу үшін
Dialogue: 0,0:08:17.20,0:08:19.33,Default,,0,0,0,,Ол бар.
Dialogue: 0,0:08:24.92,0:08:28.04,Default,,0,0,0,,Бұдан былай аяқтар иықтың енінде болуы керек, қолдар артқы жағында біріктірілген.
Dialogue: 0,0:08:28.13,0:08:30.67,Default,,0,0,0,,Артымнан бір ауыз сөз айтпа
Dialogue: 0,0:09:01.70,0:09:02.62,Default,,0,0,0,,Лорд Ферес
Dialogue: 0,0:09:02.70,0:09:05.21,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:09:05.29,0:09:08.58,Default,,0,0,0,,Сіз экспериментті бастауға дайынсыз ба? Эминеску мырза
Dialogue: 0,0:09:08.67,0:09:09.92,Default,,0,0,0,,Иә
Dialogue: 0,0:09:10.00,0:09:12.51,Default,,0,0,0,,Бүгін өзімді өте нашар сезінемін.
Dialogue: 0,0:09:13.17,0:09:14.67,Default,,0,0,0,,Тәжірибе жүргізуге қолайлы жағдай
Dialogue: 0,0:09:14.76,0:09:15.51,Default,,0,0,0,,Қандай жағымсыз иіс! Тамағымның арты ұстап, ауырып барады.
Dialogue: 0,0:09:15.59,0:09:17.51,Default,,0,0,0,,Енді, бастаңыз.
Dialogue: 0,0:09:18.14,0:09:19.51,Default,,0,0,0,,Тәжірибені бастау
Dialogue: 0,0:09:20.01,0:09:20.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:20.60,0:09:23.85,Default,,0,0,0,,Бұл Шемихаза
Dialogue: 0,0:09:23.93,0:09:27.65,Default,,0,0,0,,Сондай-ақ, Kenza агенттігінің барлығы осында.
Dialogue: 0,0:09:28.27,0:09:31.69,Default,,0,0,0,,Мен бәрін көруім керек.
Dialogue: 0,0:09:31.77,0:09:34.78,Default,,0,0,0,,Өйткені мен дана адамды жалғыз қалдыра алмаймын.
Dialogue: 0,0:09:35.28,0:09:36.90,Default,,0,0,0,,Мына жерден қараңыз
Dialogue: 0,0:09:36.99,0:09:38.99,Default,,0,0,0,,Эликсир 51
Dialogue: 0,0:09:39.49,0:09:46.46,Default,,0,0,0,,Бұл керемет денені қалпына келтіру қабілеті бар 59 жыннан алынған сарысу.
Dialogue: 0,0:09:46.54,0:09:48.87,Default,,0,0,0,,Тышқанға немесе адам мәйіттеріне инъекция жасау және т.б.
Dialogue: 0,0:09:49.38,0:09:53.55,Default,,0,0,0,,Некроз тежелген адамдардан әрі қарай сарысу алынды.
Dialogue: 0,0:09:53.63,0:09:56.84,Default,,0,0,0,,Люцифер тобы Барлық субъектілермен тәжірибе жасалды
Dialogue: 0,0:09:56.92,0:10:01.18,Default,,0,0,0,,11 жануарда жасуша регенерациясының жақсаруы байқалды.
Dialogue: 0,0:10:01.26,0:10:04.68,Default,,0,0,0,,Жасушалар сол 11 субъектіден алынды.
Dialogue: 0,0:10:04.77,0:10:08.69,Default,,0,0,0,,Бұл арнайы тазартылған Elixir 51 болып табылады
Dialogue: 0,0:10:10.77,0:10:12.02,Default,,0,0,0,,(Инъекциялық дыбыс)
Dialogue: 0,0:10:12.11,0:10:16.03,Default,,0,0,0,,Бұл дәрі-дәрмектің ашылуы Мәртебелі Люциферді азаптан құтқарады.
Dialogue: 0,0:10:16.11,0:10:19.32,Default,,0,0,0,,Жағдайды аз да болса жеңілдететініне сенімдімін.
Dialogue: 0,0:10:21.20,0:10:22.87,Default,,0,0,0,,Ал, яғни.
Dialogue: 0,0:10:22.95,0:10:27.37,Default,,0,0,0,,Жағымсыз эксперимент? Мен жасаған дәрімен
Dialogue: 0,0:10:27.46,0:10:31.00,Default,,0,0,0,,Мұның бәрі оның денесі үшін бе?
Dialogue: 0,0:10:31.54,0:10:32.71,Default,,0,0,0,,Неге...
Dialogue: 0,0:10:38.63,0:10:41.26,Default,,0,0,0,,30 минуттай уақыт өтті.
Dialogue: 0,0:10:41.84,0:10:42.93,Default,,0,0,0,,Виталдарда қандай да бір өзгерістер бар ма?
Dialogue: 0,0:10:43.01,0:10:44.51,Default,,0,0,0,,бөліміне өтіңіз… Өзгеріс жоқ
Dialogue: 0,0:10:45.97,0:10:48.14,Default,,0,0,0,,Ол жерден қозғалмаңыз
Dialogue: 0,0:10:52.90,0:10:56.44,Default,,0,0,0,,Бауырым, мені естіп тұрсың ба?
Dialogue: 0,0:10:57.86,0:11:00.03,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:11:03.62,0:11:05.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:05.12,0:11:05.95,Default,,0,0,0,,Гофф
Dialogue: 0,0:11:06.04,0:11:07.16,Default,,0,0,0,,(Монитордың ескерту дыбысы)
Dialogue: 0,0:11:10.37,0:11:12.46,Default,,0,0,0,,Сәтсіздікке ұқсайды.
Dialogue: 0,0:11:13.79,0:11:15.17,Default,,0,0,0,,Аға
Dialogue: 0,0:11:15.71,0:11:19.84,Default,,0,0,0,,Сол денеден бас тартсаң, азап азабынан құтыласың.
Dialogue: 0,0:11:20.47,0:11:25.39,Default,,0,0,0,,Материалдық әлемді (Ашер) одан әрі тартпаңыз және бос әлемге тыныш оралыңыз.
Dialogue: 0,0:11:25.47,0:11:28.97,Default,,0,0,0,,Бір күні жаңа инкарнация болады.
Dialogue: 0,0:11:30.06,0:11:31.14,Default,,0,0,0,,Дәл…
Dialogue: 0,0:11:31.23,0:11:34.94,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:11:35.02,0:11:36.65,Default,,0,0,0,,Самаел…
Dialogue: 0,0:11:39.36,0:11:42.74,Default,,0,0,0,,Сен қатыгезсің...
Dialogue: 0,0:11:47.66,0:11:49.41,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:52.71,0:11:58.88,Default,,0,0,0,,Мен... бір күні...
Dialogue: 0,0:11:59.59,0:12:02.76,Default,,0,0,0,,Сыйлық... Ru...
Dialogue: 0,0:12:03.38,0:12:05.39,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:12:05.47,0:12:10.43,Default,,0,0,0,,Мен сенемін...
Dialogue: 0,0:12:10.52,0:12:11.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:11.64,0:12:12.69,Default,,0,0,0,,Цк
Dialogue: 0,0:12:12.77,0:12:15.35,Default,,0,0,0,,Әрі қарай інімнің денсаулығына зиян тигізеді.
Dialogue: 0,0:12:15.86,0:12:18.07,Default,,0,0,0,,Бүгінгі күнге тоқталайық.
Dialogue: 0,0:12:18.15,0:12:19.07,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:12:19.15,0:12:23.90,Default,,0,0,0,,Мен эликсир тәжірибесінің сәтті болуын күтемін, Эминеску мырза.
Dialogue: 0,0:12:24.53,0:12:26.24,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:12:39.34,0:12:44.63,Default,,0,0,0,,(Люцифердің тыныс алу дыбысы)
Dialogue: 0,0:12:47.89,0:12:49.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:49.64,0:12:50.81,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:12:53.64,0:12:57.15,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:12:59.27,0:13:02.57,Default,,0,0,0,,Люцифер... Мен оны бұрын бір рет көргенмін.
Dialogue: 0,0:13:03.49,0:13:04.11,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:04.82,0:13:08.45,Default,,0,0,0,,Сол уақыттан әлдеқайда көп...
Dialogue: 0,0:13:08.53,0:13:13.54,Default,,0,0,0,,Сіз оны теріңізбен сездіңіз бе? Ол жігіт шығып кетсе не болады?
Dialogue: 0,0:13:14.04,0:13:17.63,Default,,0,0,0,,Түсіндім... сондықтан
Dialogue: 0,0:13:17.71,0:13:18.71,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:23.42,0:13:24.30,Default,,0,0,0,,Широ
Dialogue: 0,0:13:24.80,0:13:25.72,Default,,0,0,0,,Пампака-пан!
Dialogue: 0,0:13:25.80,0:13:28.64,Default,,0,0,0,,Бүгін сенің кезекшілік күнің жылына бір рет болды ма?
Dialogue: 0,0:13:28.72,0:13:30.30,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:13:30.39,0:13:31.93,Default,,0,0,0,,Бұл өте үлкен болып келеді.
Dialogue: 0,0:13:32.01,0:13:36.69,Default,,0,0,0,,Мен сізді эксвире ретінде өте жақсы деп естідім.
Dialogue: 0,0:13:37.19,0:13:39.94,Default,,0,0,0,,Жақында сенің эксорцист бола алатыныңа сенемін.
Dialogue: 0,0:13:40.02,0:13:41.48,Default,,0,0,0,,Су толқындары, олар кеткен жерге шабуыл жасаңдар
Dialogue: 0,0:13:41.57,0:13:42.19,Default,,0,0,0,,Өлу
Dialogue: 0,0:13:45.28,0:13:45.99,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:46.49,0:13:50.99,Default,,0,0,0,,Төрт жыл өтсе де, ол әлі де 13-бөлімде эксперименттік пән болып табылады.
Dialogue: 0,0:13:51.49,0:13:54.45,Default,,0,0,0,,Люцифер мінсіз денені алғанға дейін
Dialogue: 0,0:13:54.54,0:13:56.79,Default,,0,0,0,,Мен ешқашан берілмеймін
Dialogue: 0,0:13:57.29,0:14:02.09,Default,,0,0,0,,Олар ессіздікті басу үшін бар.
Dialogue: 0,0:14:03.30,0:14:07.30,Default,,0,0,0,,Басында Люцифер үшін жаңа иеленген денені жасау
Dialogue: 0,0:14:07.38,0:14:11.47,Default,,0,0,0,,Көптеген клондар жасалды, бірақ олар жұмыс істемеді.
Dialogue: 0,0:14:12.22,0:14:14.72,Default,,0,0,0,,Содан кейін бұрынғыдан Эминеску мырза
Dialogue: 0,0:14:14.81,0:14:18.60,Default,,0,0,0,,Эликсир I өмір эликсирінің дамуын ұсынды.
Dialogue: 0,0:14:19.10,0:14:21.52,Default,,0,0,0,,Сізде эликсир болғанша, кез келген дене
Dialogue: 0,0:14:21.61,0:14:24.86,Default,,0,0,0,,Мен оны иеленген денеге айналдыруға болады деп ойладым.
Dialogue: 0,0:14:25.61,0:14:30.24,Default,,0,0,0,,Алайда әзірленген препаратты сынайтын клондар үшін,
Dialogue: 0,0:14:30.99,0:14:32.91,Default,,0,0,0,,Тозақтың басы
Dialogue: 0,0:14:33.58,0:14:34.41,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:34.49,0:14:35.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:37.50,0:14:40.42,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:14:41.13,0:14:44.50,Default,,0,0,0,,Уф... ха ха ха...
Dialogue: 0,0:14:47.26,0:14:49.93,Default,,0,0,0,,Я...Йо Джиро
Dialogue: 0,0:14:50.63,0:14:53.05,Default,,0,0,0,,Сіз әлі тірісіз бе?
Dialogue: 0,0:14:53.14,0:14:54.64,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:14:56.31,0:14:57.43,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:14:57.52,0:14:59.52,Default,,0,0,0,,Ал... Мен...
Dialogue: 0,0:14:59.60,0:15:02.35,Default,,0,0,0,,Вауававава…
Dialogue: 0,0:15:03.36,0:15:06.78,Default,,0,0,0,,Тірі қалсаң да, адамдығың жойылады.
Dialogue: 0,0:15:07.28,0:15:10.15,Default,,0,0,0,,- (Тәжірибе субъектілері) Ваааааааааааах... - (Широ) Қарғыс атсын...
Dialogue: 0,0:15:11.78,0:15:16.58,Default,,0,0,0,,Бұл жерде Широ Фуджимото есімді адам дүниеге келген.
Dialogue: 0,0:15:17.29,0:15:19.96,Default,,0,0,0,,Қандай жағдайда болмасын аман қалу
Dialogue: 0,0:15:20.46,0:15:22.46,Default,,0,0,0,,Мен жасырынып шығамын
Dialogue: 0,0:15:26.67,0:15:28.67,Default,,0,0,0,,Басқа амал жоқ па?
Dialogue: 0,0:15:28.76,0:15:31.59,Default,,0,0,0,,Бұлай істеуге болмайды!
Dialogue: 0,0:15:31.68,0:15:35.10,Default,,0,0,0,,Бұл әлемді қорғаудың жалғыз жолы болса да?
Dialogue: 0,0:15:35.18,0:15:38.35,Default,,0,0,0,,Қарғыс атсын... Білмеймін!
Dialogue: 0,0:15:38.43,0:15:41.85,Default,,0,0,0,,Шынымды айтсам, мен оның айналасындағы сезімдерді өлшей алмаймын.
Dialogue: 0,0:15:41.94,0:15:43.98,Default,,0,0,0,,Өйткені мен шайтанмын
Dialogue: 0,0:15:44.06,0:15:45.56,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:15:45.65,0:15:47.36,Default,,0,0,0,,Қалай болғанда да, бұл!
Dialogue: 0,0:15:47.44,0:15:49.99,Default,,0,0,0,,О? Сіз қазірдің өзінде қашып жатырсыз ба?
Dialogue: 0,0:15:50.07,0:15:50.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:51.24,0:15:53.32,Default,,0,0,0,,Сіз оны көре аласыз ба? Ақымақ!
Dialogue: 0,0:16:02.58,0:16:04.17,Default,,0,0,0,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:16:07.25,0:16:08.88,Default,,0,0,0,,Бұл өте ауыр, солай емес пе?
Dialogue: 0,0:16:08.96,0:16:10.42,Default,,0,0,0,,- (Нұсқаушы) Жинаңыздар! -(Рин) Ах...
Dialogue: 0,0:16:10.51,0:16:12.88,Default,,0,0,0,,Иә? Мен оны қойдым
Dialogue: 0,0:16:12.97,0:16:14.43,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:16:15.26,0:16:18.18,Default,,0,0,0,,Бұл миссия үшін эксзорцизмнің мақсаты - Ағаш Рухы.
Dialogue: 0,0:16:18.26,0:16:19.52,Default,,0,0,0,,Миссия?
Dialogue: 0,0:16:19.60,0:16:21.56,Default,,0,0,0,,Зұлым рухпен біріктірілген (зұлым елес)
Dialogue: 0,0:16:21.64,0:16:24.52,Default,,0,0,0,,Туристер мен өз қабілеттерін сынап жатқан адамдар арасында да өлім болды.
Dialogue: 0,0:16:25.02,0:16:28.52,Default,,0,0,0,,Бұл өте жауыз жын. Қолдау көрсетіп жатсаңыз да, сақтықты төмендетпеңіз.
Dialogue: 0,0:16:28.61,0:16:29.40,Default,,0,0,0,,Иә
Dialogue: 0,0:16:29.90,0:16:30.78,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:16:30.86,0:16:32.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:32.11,0:16:33.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:33.11,0:16:34.45,Default,,0,0,0,,Анашым!
Dialogue: 0,0:16:34.53,0:16:38.28,Default,,0,0,0,,...Ол да мен бұрын көргенімнен сәл үлкен бе?
Dialogue: 0,0:16:38.87,0:16:41.66,Default,,0,0,0,,Exorcist және Exwire жын шығаруды орындауда
Dialogue: 0,0:16:41.75,0:16:43.75,Default,,0,0,0,,Page логистикалық қолдауды қамтамасыз етеді
Dialogue: 0,0:16:43.83,0:16:47.21,Default,,0,0,0,,Энтті әлсірету үшін шамдармен қоршаңыз.
Dialogue: 0,0:16:47.71,0:16:48.88,Default,,0,0,0,,Шамдарды тарату
Dialogue: 0,0:16:49.38,0:16:51.46,Default,,0,0,0,,Бірінші нақты шайқас
Dialogue: 0,0:16:51.55,0:16:54.17,Default,,0,0,0,,Ақылсыз қателіктер жібермеу үшін абай болу керек.
Dialogue: 0,0:16:54.26,0:16:56.18,Default,,0,0,0,,Менің аяғымды тартпа, Юрий.
Dialogue: 0,0:16:56.26,0:16:56.89,Default,,0,0,0,,Иә
Dialogue: 0,0:16:56.97,0:16:58.85,Default,,0,0,0,,Лилия керемет
Dialogue: 0,0:16:58.93,0:17:01.06,Default,,0,0,0,,Егер менің аяғымды тартатын болсаң, ол сенсің, Дженни.
Dialogue: 0,0:17:01.14,0:17:01.89,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:01.97,0:17:04.60,Default,,0,0,0,,Неге, Юрий, сен маған жақсылық жасайсың.
Dialogue: 0,0:17:04.69,0:17:07.35,Default,,0,0,0,,Сонда мен Дженниге жақсы боламын.
Dialogue: 0,0:17:07.44,0:17:08.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:08.40,0:17:10.27,Default,,0,0,0,,Жын шығару отряды келді!
Dialogue: 0,0:17:10.36,0:17:11.86,Default,,0,0,0,,Сондай-ақ Exwire бар.
Dialogue: 0,0:17:16.70,0:17:18.24,Default,,0,0,0,,Ширу~!
Dialogue: 0,0:17:18.82,0:17:19.99,Default,,0,0,0,,-Ахаха - (Широ) А?
Dialogue: 0,0:17:21.83,0:17:23.25,Default,,0,0,0,,А, сен...
Dialogue: 0,0:17:23.33,0:17:26.00,Default,,0,0,0,,Ха ха ха... есіңде ме?
Dialogue: 0,0:17:26.08,0:17:28.63,Default,,0,0,0,,Мен Юрий 5 жыл болды ма?
Dialogue: 0,0:17:28.71,0:17:30.84,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатқан сияқтысыз. Мен қуаныштымын!
Dialogue: 0,0:17:33.09,0:17:36.34,Default,,0,0,0,,Цк, менімен сөйлеспе, балам.
Dialogue: 0,0:17:36.84,0:17:37.80,Default,,0,0,0,,Е...
Dialogue: 0,0:17:39.85,0:17:43.77,Default,,0,0,0,,О... есіңде жоқ па? мен туралы
Dialogue: 0,0:17:44.35,0:17:45.89,Default,,0,0,0,,Кім? не?
Dialogue: 0,0:17:45.98,0:17:47.94,Default,,0,0,0,,-Сұлу жігіт емес пе?
Dialogue: 0,0:17:48.02,0:17:49.35,Default,,0,0,0,,Ол шынымен де сонда болды.
Dialogue: 0,0:17:49.86,0:17:53.28,Default,,0,0,0,,Жарайды, Пейдж әртүрлі тағайындалған орындарда күтіп тұр.
Dialogue: 0,0:17:53.36,0:17:56.20,Default,,0,0,0,,Тамырларды зақымдап, құлатқаннан кейін
Dialogue: 0,0:17:56.28,0:17:57.53,Default,,0,0,0,,Жүректің басына түртіңіз
Dialogue: 0,0:17:58.11,0:18:01.78,Default,,0,0,0,,Қарсыласың үлкен, ол құлағанша жақындама!
Dialogue: 0,0:18:03.37,0:18:06.12,Default,,0,0,0,,Ооооооо...
Dialogue: 0,0:18:08.75,0:18:13.00,Default,,0,0,0,,Ооооооо
Dialogue: 0,0:18:13.09,0:18:15.05,Default,,0,0,0,,А... бұл Энт пе?
Dialogue: 0,0:18:15.13,0:18:16.34,Default,,0,0,0,,-Үлкен -Эй~
Dialogue: 0,0:18:16.42,0:18:17.38,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:18:17.47,0:18:19.68,Default,,0,0,0,,Тамырларды жағу кезінде мұқият әрекет етіңіз.
Dialogue: 0,0:18:23.22,0:18:26.43,Default,,0,0,0,,Гуоооо~
Dialogue: 0,0:18:26.52,0:18:27.94,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:18:29.52,0:18:31.56,Default,,0,0,0,,Тамырға тым жақындама... Уф!
Dialogue: 0,0:18:31.65,0:18:33.65,Default,,0,0,0,,Әзірге артқа шегініңіз!
Dialogue: 0,0:18:33.73,0:18:35.73,Default,,0,0,0,,Чит Марина
Dialogue: 0,0:18:37.57,0:18:38.32,Default,,0,0,0,,Әй
Dialogue: 0,0:18:44.37,0:18:45.45,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:45.54,0:18:47.33,Default,,0,0,0,,А, бұл кім? Күте тұрыңыз!
Dialogue: 0,0:18:47.91,0:18:50.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:53.17,0:18:54.67,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:18:55.17,0:18:58.34,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:18:58.42,0:18:59.93,Default,,0,0,0,,Не? не болды?
Dialogue: 0,0:19:00.01,0:19:02.34,Default,,0,0,0,,Эксперттердің бірі рұқсатсыз кіріп келді.
Dialogue: 0,0:19:02.43,0:19:03.68,Default,,0,0,0,,Сіз байсалдысыз ба? Сен ақымақсың ба?
Dialogue: 0,0:19:03.76,0:19:06.22,Default,,0,0,0,,Әй, бұл керемет емес пе?
Dialogue: 0,0:19:07.06,0:19:09.06,Default,,0,0,0,,Ха... тамырлар тоқтап қалды.
Dialogue: 0,0:19:09.14,0:19:10.35,Default,,0,0,0,,Қазір ол өртеніп кетті!
Dialogue: 0,0:19:10.44,0:19:11.15,Default,,0,0,0,,- (Эзоркист)... Иә! -(Оқушылар) Иә!
Dialogue: 0,0:19:14.02,0:19:17.36,Default,,0,0,0,,Олардан алыс бол~!
Dialogue: 0,0:19:22.41,0:19:23.20,Default,,0,0,0,,Өл
Dialogue: 0,0:19:28.16,0:19:30.08,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:30.58,0:19:31.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:39.80,0:19:43.55,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:19:47.10,0:19:49.35,Default,,0,0,0,,Уау...қандай ишарат.
Dialogue: 0,0:19:49.85,0:19:52.90,Default,,0,0,0,,Бұл әлі де Exwire ме? Сенің атың кім?
Dialogue: 0,0:19:52.98,0:19:56.27,Default,,0,0,0,,Хаха Ширу... Бұл шынымен адам ба?
Dialogue: 0,0:19:56.90,0:19:59.32,Default,,0,0,0,,тачи）Мимимит Ни~ни~
Dialogue: 0,0:19:59.40,0:20:00.82,Default,,0,0,0,,Жасыл адам
Dialogue: 0,0:20:00.90,0:20:01.82,Default,,0,0,0,,Орманның жасыл адамы
Dialogue: 0,0:20:01.90,0:20:04.03,Default,,0,0,0,,Отқа күйіп, қашып кеткен болуы керек.
Dialogue: 0,0:20:04.66,0:20:06.20,Default,,0,0,0,,Жалғыз қалса зияны жоқ
Dialogue: 0,0:20:06.28,0:20:10.54,Default,,0,0,0,,(Жасыл адамдардың айқайы)
Dialogue: 0,0:20:10.62,0:20:13.33,Default,,0,0,0,,Ширу, бұл керемет...
Dialogue: 0,0:20:20.21,0:20:21.34,Default,,0,0,0,,Ширу!
Dialogue: 0,0:20:21.88,0:20:23.84,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:20:25.14,0:20:28.39,Default,,0,0,0,,Бірақ бұлай күресу қауіпті.
Dialogue: 0,0:20:28.47,0:20:32.85,Default,,0,0,0,,Мен сенің өте күшті екеніңді білдім, бірақ бәрі таң қалды.
Dialogue: 0,0:20:33.35,0:20:34.27,Default,,0,0,0,,Мен де...
Dialogue: 0,0:20:36.15,0:20:37.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:38.48,0:20:39.78,Default,,0,0,0,,Ниги! Гах!
Dialogue: 0,0:20:40.73,0:20:42.74,Default,,0,0,0,,(оқ пен жасыл адамның айқайы)
Dialogue: 0,0:20:45.66,0:20:49.24,Default,,0,0,0,,А... неге?
Dialogue: 0,0:20:49.33,0:20:50.33,Default,,0,0,0,,Бұл шайтан.
Dialogue: 0,0:20:50.83,0:20:54.12,Default,,0,0,0,,Бірақ ол қашып кетті! Мен қорықтым...
Dialogue: 0,0:20:54.21,0:20:57.71,Default,,0,0,0,,Сонымен не? Жын шығарушы - жындарды шығаратын адам.
Dialogue: 0,0:20:58.21,0:20:59.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:59.63,0:21:02.76,Default,,0,0,0,,Иә, бірақ... бірақ жоқ.
Dialogue: 0,0:21:03.26,0:21:06.55,Default,,0,0,0,,Жын шығарушы – адамдарды жындардан құтқарушы.
Dialogue: 0,0:21:08.26,0:21:11.18,Default,,0,0,0,,Бұл алмасу бір жерде...
Dialogue: 0,0:21:11.26,0:21:14.23,Default,,0,0,0,,Зиянсыз жындарды өлтіру басқа.
Dialogue: 0,0:21:14.31,0:21:17.81,Default,,0,0,0,,Біз шайтанның көмегімен соғысамыз.
Dialogue: 0,0:21:17.90,0:21:18.90,Default,,0,0,0,,Біз тіл табысуымыз керек
Dialogue: 0,0:21:18.98,0:21:21.61,Default,,0,0,0,,Иә? Шын айтасың ба?
Dialogue: 0,0:21:22.11,0:21:24.03,Default,,0,0,0,,Хахаха мен өлемін
Dialogue: 0,0:21:24.53,0:21:26.95,Default,,0,0,0,,Жоқ... өл.
Dialogue: 0,0:21:28.16,0:21:31.45,Default,,0,0,0,,Сіз мен ең жек көретін түрімсіз
Dialogue: 0,0:21:35.33,0:21:38.04,Default,,0,0,0,,Жинал! Юрий, кеттік.
Dialogue: 0,0:21:38.67,0:21:39.71,Default,,0,0,0,,Т… Мені ешкім қудалап жүрген жоқ еді.
Dialogue: 0,0:21:40.21,0:21:44.59,Default,,0,0,0,,Өткір ғана емес,... жойқын.
Dialogue: 0,0:21:45.92,0:21:48.43,Default,,0,0,0,,Иә? Ол жақта не бар?
Dialogue: 0,0:21:48.93,0:21:50.60,Default,,0,0,0,,Көк жарық...
Dialogue: 0,0:21:50.68,0:21:52.31,Default,,0,0,0,,Бұл фосфорлы от. Бұл сирек.
Dialogue: 0,0:21:52.39,0:21:53.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:53.97,0:21:55.27,Default,,0,0,0,,Шайтан!
Dialogue: 0,0:22:05.99,0:22:07.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.41,0:23:35.41,Default,,0,0,0,,～♪
