Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.34,0:00:07.92,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:00:21.73,0:00:22.64,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:00:30.78,0:00:34.15,Default,,0,0,0,,Бұл... өткен шақ па?
Dialogue: 0,0:00:34.78,0:00:36.07,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:00:36.57,0:00:37.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:49.42,0:00:50.38,Default,,0,0,0,,Хе-хе-хе-хе. Міне, 1-курстың үшеуіміз ақыры бірге жиналдық
Dialogue: 0,0:00:50.46,0:00:52.38,Default,,0,0,0,,Білмес бұрын, артыңызда
Dialogue: 0,0:00:53.01,0:00:55.05,Default,,0,0,0,,Иә? иә? иә?
Dialogue: 0,0:00:55.76,0:00:58.68,Default,,0,0,0,,Ол кейінірек Широ Фуджимото әке болды.
Dialogue: 0,0:00:58.76,0:01:00.89,Default,,0,0,0,,Мефисто? Сіз маған ердің бе?
Dialogue: 0,0:01:00.97,0:01:01.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:02.02,0:01:07.19,Default,,0,0,0,,Мен осыдан 40 жыл бұрын сіз қасыңызда болған адаммын.
Dialogue: 0,0:01:07.27,0:01:10.32,Default,,0,0,0,,Бұл өтірік, қазіргідей дерлік.
Dialogue: 0,0:01:10.40,0:01:15.03,Default,,0,0,0,,Жын кірген дене тозуы мүмкін, бірақ ол қартаймайды.
Dialogue: 0,0:01:15.11,0:01:18.70,Default,,0,0,0,,Ал мен уақыт патшасымын
Dialogue: 0,0:01:19.20,0:01:22.74,Default,,0,0,0,,Денеден басқа, эго әрқашан өзгермейді.
Dialogue: 0,0:01:23.24,0:01:25.96,Default,,0,0,0,,Қай уақытта барсаңыз да
Dialogue: 0,0:01:27.37,0:01:30.88,Default,,0,0,0,,Сондықтан мен бос уақытым болған кезде сізге бағыт-бағдар беремін.
Dialogue: 0,0:01:31.54,0:01:32.84,Default,,0,0,0,,Бұл саяхат...
Dialogue: 0,0:01:32.92,0:01:33.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:33.55,0:01:37.68,Default,,0,0,0,,Бұл қайғылы саяхат болатынын есте сақтаңыз.
Dialogue: 0,0:01:40.09,0:01:41.01,Default,,0,0,0,,О
Dialogue: 0,0:01:47.44,0:01:48.10,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:01:48.60,0:01:51.52,Default,,0,0,0,,Орын мен уақыт көп өзгермейді.
Dialogue: 0,0:01:51.61,0:01:56.74,Default,,0,0,0,,Бұл Сейджудзи Гакуэнчо Кита арзан тұрғын үй ауданы.
Dialogue: 0,0:01:58.36,0:02:00.62,Default,,0,0,0,,40 жыл бұрын көптеген қирандылар болған
Dialogue: 0,0:02:00.70,0:02:04.83,Default,,0,0,0,,Бұл үйсіз адамдар мен қылмыскерлерге толы қауіпті аймақ болды.
Dialogue: 0,0:02:06.29,0:02:07.50,Default,,0,0,0,,(құбырдың домалау дыбысы)
Dialogue: 0,0:02:07.58,0:02:09.29,Default,,0,0,0,,- (Рин) А... - Юрий!
Dialogue: 0,0:02:09.87,0:02:11.58,Default,,0,0,0,,Бұл сағатта қыдырма.
Dialogue: 0,0:02:12.09,0:02:13.25,Default,,0,0,0,,Бұл тамақ.
Dialogue: 0,0:02:13.34,0:02:14.46,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:02:15.96,0:02:17.30,Default,,0,0,0,,Юрий...
Dialogue: 0,0:02:19.30,0:02:19.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:24.56,0:02:26.06,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:02:29.81,0:02:30.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:31.69,0:02:34.02,Default,,0,0,0,,Ол кейін Юрий Егин болды
Dialogue: 0,0:02:34.11,0:02:36.90,Default,,0,0,0,,Ол сенің және Окумура-сенсейдің анасы.
Dialogue: 0,0:02:37.40,0:02:38.32,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:02:38.40,0:02:39.78,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:02:39.86,0:02:43.53,Default,,0,0,0,,Мүмкіндігінше бұрынғы адамдармен қарым-қатынастан аулақ болыңыз.
Dialogue: 0,0:02:44.37,0:02:48.45,Default,,0,0,0,,Уақыт парадоксы жоқ, бірақ бұл түсініксіз.
Dialogue: 0,0:02:48.54,0:02:53.21,Default,,0,0,0,,Иә? Мен шынымен түсінбеймін, бірақ бұл қажетсіз нәрселерді жасамау дегенді білдіреді деп ойлаймын.
Dialogue: 0,0:02:53.29,0:02:54.13,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:54.21,0:02:56.30,Default,,0,0,0,,А... Енді жек көремін.
Dialogue: 0,0:02:58.09,0:03:00.47,Default,,0,0,0,,Қараңғы түскенде көшеге шықпаңыз
Dialogue: 0,0:03:00.55,0:03:01.51,Default,,0,0,0,,Юри-чан
Dialogue: 0,0:03:01.59,0:03:05.10,Default,,0,0,0,,Иә, қауіпті адамдар өте көп.
Dialogue: 0,0:03:05.60,0:03:08.93,Default,,0,0,0,,Кемпірдей көзімді ойып алғанымды да білмеймін.
Dialogue: 0,0:03:09.02,0:03:10.02,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:03:10.10,0:03:13.73,Default,,0,0,0,,Каха~ Маған Ачиши ұнайды.
Dialogue: 0,0:03:13.81,0:03:16.69,Default,,0,0,0,,Қарақшыға ұқсайды, керемет
Dialogue: 0,0:03:16.77,0:03:18.07,Default,,0,0,0,,Кач~!
Dialogue: 0,0:03:18.15,0:03:20.86,Default,,0,0,0,,(Юридің күлкісі)
Dialogue: 0,0:03:20.95,0:03:22.45,Default,,0,0,0,,Бұл күлкі емес
Dialogue: 0,0:03:23.70,0:03:25.12,Default,,0,0,0,,Адамдар әлі де жақсы
Dialogue: 0,0:03:25.62,0:03:29.70,Default,,0,0,0,,Қараңғылықтан жорғалап шығатын қорқынышты заттар бар.
Dialogue: 0,0:03:29.79,0:03:31.83,Default,,0,0,0,,Ок-чан мен Обаба бұрын болған
Dialogue: 0,0:03:31.92,0:03:34.13,Default,,0,0,0,,Ол эксорцист болды.
Dialogue: 0,0:03:34.21,0:03:36.21,Default,,0,0,0,,Юрий Ghost Мен қорықпаймын
Dialogue: 0,0:03:36.29,0:03:37.34,Default,,0,0,0,,Хи хи
Dialogue: 0,0:03:37.84,0:03:41.47,Default,,0,0,0,,Юрий: Елестер адамдарға қарағанда қорқынышты.
Dialogue: 0,0:03:41.55,0:03:45.05,Default,,0,0,0,,Аруақтар – адамдардың жүрегінің көрінісі.
Dialogue: 0,0:03:45.14,0:03:45.72,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:03:45.80,0:03:48.77,Default,,0,0,0,,Себебі мен бір күні көк шарды көрдім.
Dialogue: 0,0:03:48.85,0:03:50.64,Default,,0,0,0,,Бұл мүлдем қорқынышты емес еді.
Dialogue: 0,0:03:51.68,0:03:53.39,Default,,0,0,0,,Көк отты шар?
Dialogue: 0,0:03:53.90,0:03:55.02,Default,,0,0,0,,Апа, жақсысың ба?
Dialogue: 0,0:03:55.10,0:03:58.23,Default,,0,0,0,,Бұл «фосфор оты».
Dialogue: 0,0:03:58.32,0:03:59.36,Default,,0,0,0,,Ринка?
Dialogue: 0,0:03:59.44,0:04:02.78,Default,,0,0,0,,Дүние жүзінде көрінетін күдікті өрттер
Dialogue: 0,0:04:02.86,0:04:07.03,Default,,0,0,0,,Оны өлген адамның жаны немесе тозақ оты деп те айтады.
Dialogue: 0,0:04:07.12,0:04:08.33,Default,,0,0,0,,Бұл жұмбақ
Dialogue: 0,0:04:08.83,0:04:10.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:10.58,0:04:11.79,Default,,0,0,0,,Гоблиндер мен перілер
Dialogue: 0,0:04:11.87,0:04:15.29,Default,,0,0,0,,Кейбіреулер мұны түлкінің уақытша көрінісі дейді.
Dialogue: 0,0:04:15.38,0:04:16.75,Default,,0,0,0,,Я~
Dialogue: 0,0:04:16.83,0:04:20.84,Default,,0,0,0,,Керемет! Юрий мен сенімен дос болғым келеді
Dialogue: 0,0:04:20.92,0:04:24.51,Default,,0,0,0,,Обаба! Өтінемін, бұлай сөйлеуді доғар.
Dialogue: 0,0:04:24.59,0:04:25.89,Default,,0,0,0,,Біртүрлі адамға айналу
Dialogue: 0,0:04:25.97,0:04:29.64,Default,,0,0,0,,Хи хи хи! Біртүрлілері қызық.
Dialogue: 0,0:04:29.72,0:04:30.93,Default,,0,0,0,,Хи хи хи!
Dialogue: 0,0:04:35.94,0:04:38.94,Default,,0,0,0,,Мен оны тезірек мектепке жіберуім керек.
Dialogue: 0,0:04:39.02,0:04:41.03,Default,,0,0,0,,Бұл өте тез өтті.
Dialogue: 0,0:04:41.53,0:04:43.53,Default,,0,0,0,,Ок-чан қоқыс жәшігінде
Dialogue: 0,0:04:43.61,0:04:46.45,Default,,0,0,0,,Мен жаңа туған нәрестені көтерген кезде
Dialogue: 0,0:04:46.53,0:04:48.91,Default,,0,0,0,,Не болар екен деп ойладым.
Dialogue: 0,0:04:50.29,0:04:51.20,Default,,0,0,0,,О
Dialogue: 0,0:04:52.29,0:04:56.62,Default,,0,0,0,,Ок-чан, сенің эксзорцист лицензияң әлі де бар, солай ма?
Dialogue: 0,0:04:57.13,0:04:58.88,Default,,0,0,0,,Қайтадан жұмыс істесем ше?
Dialogue: 0,0:05:00.30,0:05:04.80,Default,,0,0,0,,Егер көзім жақсы көретін болса, жұмыс істеуге қарсы болмас едім.
Dialogue: 0,0:05:06.26,0:05:09.39,Default,,0,0,0,,Балалар, сіздердің лайықты өмір сүретін уақыт келді.
Dialogue: 0,0:05:09.89,0:05:11.68,Default,,0,0,0,,Үйді дұрыс жалға алу
Dialogue: 0,0:05:13.47,0:05:14.43,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:14.93,0:05:18.27,Default,,0,0,0,,үшінның арқасында өсе алдым.
Dialogue: 0,0:05:18.94,0:05:22.98,Default,,0,0,0,,Сонымен қатар, бәрі қасында болғанда қызық болады.
Dialogue: 0,0:05:23.48,0:05:24.36,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:05:30.58,0:05:33.12,Default,,0,0,0,,Бақытты болып көрінгеніңізге қуаныштымын.
Dialogue: 0,0:05:33.20,0:05:36.00,Default,,0,0,0,,Уақыт бойынша сәл алға жылжайық.
Dialogue: 0,0:05:36.08,0:05:37.54,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:05:39.54,0:05:40.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:41.34,0:05:42.92,Default,,0,0,0,,Иә? Жер жоқ
Dialogue: 0,0:05:43.00,0:05:44.63,Default,,0,0,0,,Бұл менің құрбым.
Dialogue: 0,0:05:45.55,0:05:48.13,Default,,0,0,0,,Бүгін біз үйде ойнаймыз.
Dialogue: 0,0:05:48.22,0:05:50.89,Default,,0,0,0,,«Concon» «Сәлеметсіз бе»
Dialogue: 0,0:05:50.97,0:05:54.27,Default,,0,0,0,,«Қош келдіңіз, тұтынушы»
Dialogue: 0,0:05:54.35,0:05:58.19,Default,,0,0,0,,«Мен кофе дайындаймын, күте тұрыңыз.»
Dialogue: 0,0:05:58.69,0:06:00.36,Default,,0,0,0,,«Маған бәрібір»
Dialogue: 0,0:06:00.44,0:06:01.40,Default,,0,0,0,,«Иә»
Dialogue: 0,0:06:01.98,0:06:04.40,Default,,0,0,0,,Копокопо Копокопо…
Dialogue: 0,0:06:04.48,0:06:06.78,Default,,0,0,0,,Күте тұрыңыз... бұл өте өкінішті.
Dialogue: 0,0:06:06.86,0:06:08.82,Default,,0,0,0,,Тез достасыңыз
Dialogue: 0,0:06:08.91,0:06:12.16,Default,,0,0,0,,Жас бала осындай емес пе?
Dialogue: 0,0:06:13.62,0:06:14.16,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:06:15.24,0:06:16.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:16.79,0:06:17.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:21.25,0:06:21.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:23.80,0:06:24.71,Default,,0,0,0,,Ринка?
Dialogue: 0,0:06:25.21,0:06:27.05,Default,,0,0,0,,- Бұл көк жалын жын - (фосфор) Иә?
Dialogue: 0,0:06:27.55,0:06:30.13,Default,,0,0,0,,Бұл кезде Шайтан фосфор оты деп аталды.
Dialogue: 0,0:06:30.22,0:06:33.35,Default,,0,0,0,,Бұл жай ғана пайда болып, ғайып болған болмыс еді.
Dialogue: 0,0:06:33.43,0:06:34.43,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:34.93,0:06:36.39,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:37.85,0:06:39.06,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:06:39.14,0:06:40.23,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:06:41.81,0:06:44.48,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:06:46.03,0:06:47.61,Default,,0,0,0,,Уишо Уишо…
Dialogue: 0,0:06:49.86,0:06:50.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:52.45,0:06:54.28,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:06:54.37,0:06:56.79,Default,,0,0,0,,Ахахаха эхехехе
Dialogue: 0,0:06:57.41,0:06:59.75,Default,,0,0,0,,- (Рин) Ойнап жатырсың ба? -Дұрыс.
Dialogue: 0,0:06:59.83,0:07:00.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:00.67,0:07:04.09,Default,,0,0,0,,Алайда Шайтанда бұл уақытта эго жоқ.
Dialogue: 0,0:07:04.17,0:07:07.88,Default,,0,0,0,,Ойнап жатқанын біле ме, жұмбақ.
Dialogue: 0,0:07:07.96,0:07:12.09,Default,,0,0,0,,Кем дегенде, бұл олардың бірінші интеллектуалды алмасуы болса керек.
Dialogue: 0,0:07:13.18,0:07:14.18,Default,,0,0,0,,Лилия!
Dialogue: 0,0:07:14.26,0:07:16.93,Default,,0,0,0,,Бұл жерде қауіпті, ойнама!
Dialogue: 0,0:07:17.01,0:07:18.47,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:07:19.89,0:07:20.98,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:07:24.27,0:07:25.57,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:07:25.65,0:07:27.02,Default,,0,0,0,,Үйде ойнау
Dialogue: 0,0:07:27.69,0:07:30.32,Default,,0,0,0,,Қоқыс құласа, тірідей көміліп қаласың.
Dialogue: 0,0:07:30.40,0:07:31.32,Default,,0,0,0,,Бірақ мұнда
Dialogue: 0,0:07:31.40,0:07:34.28,Default,,0,0,0,,Неше түрлі қызықты нәрселер бар.
Dialogue: 0,0:07:37.70,0:07:39.33,Default,,0,0,0,,Әрі қарай жүрейік
Dialogue: 0,0:07:41.41,0:07:43.29,Default,,0,0,0,,(Тұрғындардың шуы)
Dialogue: 0,0:07:43.37,0:07:44.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:45.46,0:07:46.46,Default,,0,0,0,,Өрт?
Dialogue: 0,0:07:47.96,0:07:49.17,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:07:50.42,0:07:51.72,Default,,0,0,0,,Ок-чан...
Dialogue: 0,0:07:52.38,0:07:53.26,Default,,0,0,0,,Ах
Dialogue: 0,0:07:53.34,0:07:56.72,Default,,0,0,0,,О… Оку-чан Нико-чан
Dialogue: 0,0:07:56.80,0:07:57.72,Default,,0,0,0,,Обаба!
Dialogue: 0,0:07:57.81,0:07:58.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:58.68,0:08:00.48,Default,,0,0,0,,Бұл өртті сөндіру жолында. Оған жақындама!
Dialogue: 0,0:08:01.56,0:08:02.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:02.69,0:08:06.56,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:10.99,0:08:13.82,Default,,0,0,0,,Күйіп кеткен үш мәйіт табылды.
Dialogue: 0,0:08:13.91,0:08:17.37,Default,,0,0,0,,Бұл жай ғана үйсіз өртті дұрыс басқару емес шығар.
Dialogue: 0,0:08:17.45,0:08:19.37,Default,,0,0,0,,Маған үзіліс беріңіз.
Dialogue: 0,0:08:20.91,0:08:23.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:25.58,0:08:26.83,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:08:27.59,0:08:30.84,Default,,0,0,0,,Мен сізге бұл істе көмектеспеймін.
Dialogue: 0,0:08:33.01,0:08:36.26,Default,,0,0,0,,Кешіріңіз, тамақты бөлісіңіз.
Dialogue: 0,0:08:36.34,0:08:40.01,Default,,0,0,0,,Тсш, қасыма келме, арам жырау.
Dialogue: 0,0:08:41.35,0:08:43.77,Default,,0,0,0,,Ақшаң жоқ болса, ешқайда кетпе.
Dialogue: 0,0:08:50.27,0:08:51.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:56.49,0:08:58.32,Default,,0,0,0,,Ах... Ашық
Dialogue: 0,0:09:00.58,0:09:01.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:05.75,0:09:08.33,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:09.79,0:09:11.17,Default,,0,0,0,,Үй
Dialogue: 0,0:09:12.26,0:09:13.42,Default,,0,0,0,,Футон
Dialogue: 0,0:09:13.51,0:09:15.42,Default,,0,0,0,,Күрделі кітаптар
Dialogue: 0,0:09:16.34,0:09:18.93,Default,,0,0,0,,Нико-чан деген кітап тентек
Dialogue: 0,0:09:19.85,0:09:20.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:20.60,0:09:24.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:25.52,0:09:27.27,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:09:27.35,0:09:28.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:29.81,0:09:31.19,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:34.40,0:09:35.70,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:41.03,0:09:44.20,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:09:58.88,0:10:00.89,Default,,0,0,0,,(шу)
Dialogue: 0,0:10:00.97,0:10:01.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:04.68,0:10:05.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:05.77,0:10:10.31,Default,,0,0,0,,Сіз қанша адамға жасырын кірдіңіз?
Dialogue: 0,0:10:11.44,0:10:12.73,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:10:18.78,0:10:20.78,Default,,0,0,0,,♪～
Dialogue: 0,0:11:44.20,0:11:46.20,Default,,0,0,0,,～♪
Dialogue: 0,0:11:53.25,0:11:54.08,Default,,0,0,0,,Қария?
Dialogue: 0,0:11:55.58,0:11:59.17,Default,,0,0,0,,Уау, жақсы ұқсастық бар
Dialogue: 0,0:11:59.26,0:12:00.51,Default,,0,0,0,,- (Широ) А? -(Рин) Ах...
Dialogue: 0,0:12:02.88,0:12:04.18,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:05.18,0:12:06.72,Default,,0,0,0,,Мен Юриймін
Dialogue: 0,0:12:07.22,0:12:10.85,Default,,0,0,0,,Менің отбасымның бәрі қайтыс болды, сондықтан баратын жерім болмады.
Dialogue: 0,0:12:11.35,0:12:12.48,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:12:12.56,0:12:14.73,Default,,0,0,0,,Жанашырлық танытудың пайдасы жоқ.
Dialogue: 0,0:12:14.81,0:12:16.36,Default,,0,0,0,,Өлмей тұрып шық.
Dialogue: 0,0:12:16.86,0:12:19.40,Default,,0,0,0,,Цк, сен тұтас бір сөмкені жедің.
Dialogue: 0,0:12:19.48,0:12:22.61,Default,,0,0,0,,Бірақ қазір далаға шықсам, суықтан өліп қалуым мүмкін.
Dialogue: 0,0:12:24.20,0:12:25.74,Default,,0,0,0,,Содан кейін өліңіз.
Dialogue: 0,0:12:25.82,0:12:27.70,Default,,0,0,0,,Оның маған қатысы жоқ.
Dialogue: 0,0:12:30.83,0:12:34.00,Default,,0,0,0,,Ю… Ю…
Dialogue: 0,0:12:35.12,0:12:36.50,Default,,0,0,0,,Юкио!
Dialogue: 0,0:12:37.17,0:12:37.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:38.04,0:12:39.50,Default,,0,0,0,,Обаба айтты
Dialogue: 0,0:12:39.59,0:12:44.68,Default,,0,0,0,,Ақшақар таза ақ, үлкен, суық және қорқынышты.
Dialogue: 0,0:12:44.76,0:12:46.01,Default,,0,0,0,,Сен маған ұқсайсың
Dialogue: 0,0:12:46.09,0:12:48.89,Default,,0,0,0,,Қар тоқтағанша мені сонда қалдырсаңшы.
Dialogue: 0,0:12:48.97,0:12:50.81,Default,,0,0,0,,Хааах!
Dialogue: 0,0:12:50.89,0:12:53.35,Default,,0,0,0,,Оның маған не пайдасы бар?
Dialogue: 0,0:12:53.43,0:12:55.48,Default,,0,0,0,,Бұл мен жасаған жасырыну.
Dialogue: 0,0:12:55.56,0:12:57.65,Default,,0,0,0,,Басқаларды артқа тастап кете алмайсың!
Dialogue: 0,0:12:58.56,0:12:59.15,Default,,0,0,0,,Табыс?
Dialogue: 0,0:12:59.23,0:13:00.98,Default,,0,0,0,,Сонда мына азғын кітап...
Dialogue: 0,0:13:01.07,0:13:03.36,Default,,0,0,0,,Уау, қарама!
Dialogue: 0,0:13:03.44,0:13:04.57,Default,,0,0,0,,Сізге ұнайды, солай ма?
Dialogue: 0,0:13:04.65,0:13:05.70,Default,,0,0,0,,Шу!
Dialogue: 0,0:13:05.78,0:13:09.45,Default,,0,0,0,,Мен білемін, бұл жерде көптеген тентек кітаптар бар.
Dialogue: 0,0:13:09.95,0:13:13.33,Default,,0,0,0,,Қар жауып, таң атқанда мен сені сонда апарамын.
Dialogue: 0,0:13:13.41,0:13:14.87,Default,,0,0,0,,Оған дейін оны осында қалдырыңыз
Dialogue: 0,0:13:14.96,0:13:17.50,Default,,0,0,0,,Әй, бұл жақсы нәрсе, солай ма?
Dialogue: 0,0:13:17.58,0:13:21.05,Default,,0,0,0,,Не? Эй эй эй эй
Dialogue: 0,0:13:21.13,0:13:23.59,Default,,0,0,0,,- Дұрыс па? Дұрыс па? -(Широ) Цк, түсіндім.
Dialogue: 0,0:13:24.34,0:13:25.88,Default,,0,0,0,,Мен оны таңға қалдырамын.
Dialogue: 0,0:13:26.93,0:13:29.18,Default,,0,0,0,,Менің ойымша, үлкен кеуделер туралы кітап бар.
Dialogue: 0,0:13:29.68,0:13:30.51,Default,,0,0,0,,Бүгін?
Dialogue: 0,0:13:31.01,0:13:32.89,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:13:33.56,0:13:36.89,Default,,0,0,0,,Не? Мефисто Эй
Dialogue: 0,0:13:43.19,0:13:45.61,Default,,0,0,0,,Ах~ Самии
Dialogue: 0,0:13:47.24,0:13:47.74,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:49.99,0:13:51.03,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:51.12,0:13:54.29,Default,,0,0,0,,Бірге жабысқанда жылы болатынын білмейсің бе?
Dialogue: 0,0:13:54.37,0:13:57.08,Default,,0,0,0,,Ақшақар екеніңді сезбейсің бе?
Dialogue: 0,0:13:57.16,0:14:00.17,Default,,0,0,0,,Юкио деген кім? Бұл не жігіт? Шынайы ма?
Dialogue: 0,0:14:01.38,0:14:04.51,Default,,0,0,0,,Жоқ, мен Юкиоға қарамауым керек шығар.
Dialogue: 0,0:14:05.01,0:14:07.05,Default,,0,0,0,,Тіпті адам емес
Dialogue: 0,0:14:08.59,0:14:09.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.55,0:14:11.89,Default,,0,0,0,,Дұрыс айтасың — ол әдеттегіден де көп әуре-сарсаңға түсіп жүр.
Dialogue: 0,0:14:12.43,0:14:15.14,Default,,0,0,0,,Тіпті йти де жылы
Dialogue: 0,0:14:16.52,0:14:17.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:19.02,0:14:20.52,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:21.65,0:14:25.03,Default,,0,0,0,,Мама, анда-санда маған ренжімеңіз.
Dialogue: 0,0:14:25.11,0:14:27.53,Default,,0,0,0,,А... бұл күрделі.
Dialogue: 0,0:14:29.95,0:14:33.45,Default,,0,0,0,,«Ақшақар да жылы болады».
Dialogue: 0,0:14:35.12,0:14:36.29,Default,,0,0,0,,Юкио...
Dialogue: 0,0:14:37.58,0:14:39.00,Default,,0,0,0,,(Қара иттің үруі)
Dialogue: 0,0:14:39.58,0:14:40.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:40.46,0:14:42.92,Default,,0,0,0,,Ешқандай қадам жасамаңыз. Мен сені ұстаймын.
Dialogue: 0,0:14:44.38,0:14:45.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:46.42,0:14:47.46,Default,,0,0,0,,- (Широ) Ябе - Ух...
Dialogue: 0,0:14:50.01,0:14:51.22,Default,,0,0,0,,Гаугавгав!
Dialogue: 0,0:14:51.30,0:14:52.60,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:14:52.68,0:14:53.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:53.64,0:14:57.81,Default,,0,0,0,,Мен таптым, жақсылап ойлан, Широ.
Dialogue: 0,0:14:59.39,0:15:00.81,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:15:02.19,0:15:03.56,Default,,0,0,0,,Бұл тамаша жасырыну.
Dialogue: 0,0:15:04.15,0:15:06.82,Default,,0,0,0,,Сіз осында жасырынып, жасырынып жүрсіз бе?
Dialogue: 0,0:15:08.57,0:15:11.82,Default,,0,0,0,,Аз тобында да мұны тек сіз ғана жасайсыз.
Dialogue: 0,0:15:12.82,0:15:15.08,Default,,0,0,0,,- (Фуджимото) Мына бала ше? - Сәлем...
Dialogue: 0,0:15:15.16,0:15:17.41,Default,,0,0,0,,Цк... Білмеймін.
Dialogue: 0,0:15:17.49,0:15:20.21,Default,,0,0,0,,Ол рұқсатсыз кіріп кеткен үйсіз адам.
Dialogue: 0,0:15:20.71,0:15:22.33,Default,,0,0,0,,Сіз мені тыңдадыңыз
Dialogue: 0,0:15:22.42,0:15:24.17,Default,,0,0,0,,Бүгін таңертең іші онша үлкен емес еді, ал қазір…
Dialogue: 0,0:15:24.25,0:15:26.96,Default,,0,0,0,,Жетім болса керек, ешкімге айтпайды.
Dialogue: 0,0:15:27.46,0:15:28.42,Default,,0,0,0,,Ит пе?
Dialogue: 0,0:15:28.51,0:15:29.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:30.22,0:15:33.84,Default,,0,0,0,,Мына қара итті көріп тұрсың ба?
Dialogue: 0,0:15:33.93,0:15:35.10,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,0:15:35.93,0:15:39.31,Default,,0,0,0,,Егер сіз шайтанды көре алсаңыз, бұл басқа әңгіме.
Dialogue: 0,0:15:39.39,0:15:43.10,Default,,0,0,0,,Оны панаханада қорғап, оның жеке басын зерттейік.
Dialogue: 0,0:15:43.19,0:15:44.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:46.32,0:15:47.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:54.82,0:15:56.20,Default,,0,0,0,,Баспана?
Dialogue: 0,0:15:57.58,0:16:00.62,Default,,0,0,0,,Бұл қандай жер? Жақсы жер?
Dialogue: 0,0:16:01.66,0:16:03.62,Default,,0,0,0,,Мынау сұмдық жер.
Dialogue: 0,0:16:04.38,0:16:07.21,Default,,0,0,0,,Сізде сәттілік жоқ.
Dialogue: 0,0:16:08.30,0:16:08.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:11.47,0:16:13.88,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:25.98,0:16:28.77,Default,,0,0,0,,Мен кішкентай кезімде оқшау болдым.
Dialogue: 0,0:16:29.48,0:16:32.90,Default,,0,0,0,,Мен өз сезімімді, күшімді қалай ұстау керектігін білмеймін.
Dialogue: 0,0:16:32.99,0:16:35.41,Default,,0,0,0,,Көбінесе басқаларға ауыр жарақат салу.
Dialogue: 0,0:16:35.91,0:16:38.99,Default,,0,0,0,,Мен мұны түсінген кезде мен әбден шошып кеттім.
Dialogue: 0,0:16:40.66,0:16:43.00,Default,,0,0,0,,Бірақ менде Йети болды
Dialogue: 0,0:16:43.50,0:16:46.92,Default,,0,0,0,,Қария маған қайтатын жер жасады.
Dialogue: 0,0:16:48.17,0:16:52.01,Default,,0,0,0,,Бұл өте қуанышты жағдай болды.
Dialogue: 0,0:16:54.01,0:16:57.43,Default,,0,0,0,,Мен нағыз жалғыздықты білмеймін
Dialogue: 0,0:16:58.72,0:17:03.52,Default,,0,0,0,,Сондықтан мен анамның дәл осы кезде өзін қаншалықты жалғыз сезінгеніне таң қаламын.
Dialogue: 0,0:17:04.02,0:17:05.44,Default,,0,0,0,,Сіз қаншалықты сенімсізсіз?
Dialogue: 0,0:17:06.52,0:17:08.44,Default,,0,0,0,,Мен тіпті елестете де алмаймын
Dialogue: 0,0:17:23.50,0:17:24.08,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:17:25.62,0:17:29.59,Default,,0,0,0,,Уау... бұл баспана ма?
Dialogue: 0,0:17:30.54,0:17:32.09,Default,,0,0,0,,Қараңғы.
Dialogue: 0,0:17:35.05,0:17:36.97,Default,,0,0,0,,Бұл жын шығару мектебі емес пе?
Dialogue: 0,0:17:37.76,0:17:40.80,Default,,0,0,0,,Ол 40 жыл бұрын «Баспана» деп аталды ма?
Dialogue: 0,0:17:41.31,0:17:43.06,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:17:43.56,0:17:47.85,Default,,0,0,0,,Бұл мен бұрын хабарласқан бала, ол үшін уақытша қорғауды сұрағым келеді.
Dialogue: 0,0:17:47.94,0:17:48.98,Default,,0,0,0,,Мен оны саған сақтаймын.
Dialogue: 0,0:17:49.69,0:17:51.27,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:17:51.36,0:17:53.78,Default,,0,0,0,,О, у... бұл Юрий.
Dialogue: 0,0:17:54.28,0:17:55.36,Default,,0,0,0,,Сіздің тегіңіз кім?
Dialogue: 0,0:17:55.94,0:17:56.99,Default,,0,0,0,,Ал...
Dialogue: 0,0:17:59.16,0:17:59.99,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:18:00.70,0:18:02.12,Default,,0,0,0,,Кел, Юрий-сан.
Dialogue: 0,0:18:02.20,0:18:03.91,Default,,0,0,0,,Алдымен өзіңізді тазалаңыз.
Dialogue: 0,0:18:03.99,0:18:06.62,Default,,0,0,0,,Мен сізді төсекке апара алмаймын, өйткені ол қаншалықты лас.
Dialogue: 0,0:18:06.71,0:18:08.87,Default,,0,0,0,,- (Фуджимото) Широ Сен осылайсың - Ах!
Dialogue: 0,0:18:10.21,0:18:12.50,Default,,0,0,0,,А... Әй, қайда барасың?
Dialogue: 0,0:18:12.59,0:18:13.13,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:13.21,0:18:15.05,Default,,0,0,0,,-(Қызметкерлер) Сен осылайсың -Эй эй!
Dialogue: 0,0:18:20.59,0:18:22.81,Default,,0,0,0,,Фондық тексеру аяқталды
Dialogue: 0,0:18:23.39,0:18:25.52,Default,,0,0,0,,Сіздің атыңыз Юрий Егин.
Dialogue: 0,0:18:26.39,0:18:30.65,Default,,0,0,0,,Егин отбасы конгломерат болды, бірақ ол таратылғаннан кейін құлдырауға ұшырады.
Dialogue: 0,0:18:30.73,0:18:32.52,Default,,0,0,0,,Менің отбасым шаң сияқты
Dialogue: 0,0:18:32.61,0:18:35.86,Default,,0,0,0,,Анаң өлді, әкең белгісіз.
Dialogue: 0,0:18:35.94,0:18:37.95,Default,,0,0,0,,Басқаша айтқанда, сіз жалғызсыз және көмексізсіз.
Dialogue: 0,0:18:38.03,0:18:41.03,Default,,0,0,0,,Сондықтан мен бұл баспанаға ресми түрде қабылдандым.
Dialogue: 0,0:18:41.11,0:18:42.66,Default,,0,0,0,,Таңбаларды оқи алмайды
Dialogue: 0,0:18:43.16,0:18:44.37,Default,,0,0,0,,Сұрақтарыңыз бар ма?
Dialogue: 0,0:18:45.08,0:18:45.95,Default,,0,0,0,,Сұрақ…
Dialogue: 0,0:18:47.08,0:18:50.67,Default,,0,0,0,,Мм... Баспана қандай жер?
Dialogue: 0,0:18:50.75,0:18:54.88,Default,,0,0,0,,Бұл сен сияқты дарынды балаларға арналған баспана.
Dialogue: 0,0:18:54.96,0:18:57.26,Default,,0,0,0,,Дарындылық дегеніміз не?
Dialogue: 0,0:18:57.76,0:19:00.18,Default,,0,0,0,,Жын шығарушы болу таланты
Dialogue: 0,0:19:00.26,0:19:01.80,Default,,0,0,0,,Эксорцист пе?
Dialogue: 0,0:19:01.89,0:19:02.64,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:19:02.72,0:19:04.64,Default,,0,0,0,,Сіз бұдан былай осында боласыз.
Dialogue: 0,0:19:04.72,0:19:07.98,Default,,0,0,0,,Эксорцист болуды үйреніңіз.
Dialogue: 0,0:19:08.48,0:19:09.64,Default,,0,0,0,,Білім…
Dialogue: 0,0:19:11.10,0:19:15.07,Default,,0,0,0,,Мен оны тезірек мектепке жіберуім керек.
Dialogue: 0,0:19:16.23,0:19:18.40,Default,,0,0,0,,Бұл мектеп пе?
Dialogue: 0,0:19:18.90,0:19:20.74,Default,,0,0,0,,Сіз бұл туралы ойлай аласыз.
Dialogue: 0,0:19:22.70,0:19:28.12,Default,,0,0,0,,Осы мекемеде таңғы 6-да ояныңыз. Қоңыраудан кейін жатақхананы тазалаңыз
Dialogue: 0,0:19:28.79,0:19:31.87,Default,,0,0,0,,Таңғы астан кейін 8:00-ден 14:00-ге дейін міндетті оқу
Dialogue: 0,0:19:32.46,0:19:33.88,Default,,0,0,0,,14:00-ден 17:00-ге дейін
Dialogue: 0,0:19:33.96,0:19:37.96,Default,,0,0,0,,Жын шығарушы болу үшін білім мен білім алыңыз
Dialogue: 0,0:19:39.13,0:19:41.97,Default,,0,0,0,,22.00-ге дейін жаттығу, арасында кешкі ас
Dialogue: 0,0:19:42.47,0:19:44.39,Default,,0,0,0,,23:00 Жарық сөнеді
Dialogue: 0,0:19:44.97,0:19:47.22,Default,,0,0,0,,Негізінен сыртқа шығуға болмайды.
Dialogue: 0,0:19:54.94,0:19:58.15,Default,,0,0,0,,Ок-чан мен Обаба жын шығарушылар болды
Dialogue: 0,0:19:58.23,0:20:02.65,Default,,0,0,0,,Мен де жын шығаратын болсам, Ок Чан ашуланады.
Dialogue: 0,0:20:02.74,0:20:04.91,Default,,0,0,0,,Қарт қуанбасын.
Dialogue: 0,0:20:05.41,0:20:06.66,Default,,0,0,0,,Нико-чан...
Dialogue: 0,0:20:07.16,0:20:08.62,Default,,0,0,0,,Эхехехехе...
Dialogue: 0,0:20:08.70,0:20:10.20,Default,,0,0,0,,Шулы!
Dialogue: 0,0:20:10.29,0:20:11.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:11.12,0:20:14.67,Default,,0,0,0,,Неге күлесің? Менің көңілім ауып кеткені сонша, ұйықтай алмаймын.
Dialogue: 0,0:20:14.75,0:20:15.67,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:16.46,0:20:19.25,Default,,0,0,0,,Мен мұнда келгенде, әдетте бірінші күні жылаймын.
Dialogue: 0,0:20:19.76,0:20:21.97,Default,,0,0,0,,Сіз жындысыз ба?
Dialogue: 0,0:20:22.05,0:20:23.43,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:20:23.51,0:20:27.35,Default,,0,0,0,,Не? Өйткені... жаттығу қиын.
Dialogue: 0,0:20:27.43,0:20:28.43,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:20:29.06,0:20:32.06,Default,,0,0,0,,Бірақ мен шайтанды зерттеуді ұнататынмын.
Dialogue: 0,0:20:33.14,0:20:34.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:34.27,0:20:36.69,Default,,0,0,0,,Хаха бұл жақсы болды
Dialogue: 0,0:20:38.23,0:20:41.53,Default,,0,0,0,,Егер сіз жын шығаратын болсаңыз, жұмысқа орналасып, еркіндік аласыз.
Dialogue: 0,0:20:42.03,0:20:46.45,Default,,0,0,0,,Егер сіз ерекше көрнекті деп танылсаңыз, сіз курсант атанып, элиталық курсқа түсесіз.
Dialogue: 0,0:20:46.53,0:20:47.99,Default,,0,0,0,,Экс-ваур?
Dialogue: 0,0:20:48.08,0:20:49.79,Default,,0,0,0,,Өткізу
Dialogue: 0,0:20:49.87,0:20:51.70,Default,,0,0,0,,Үйреніп алсаң, бір кісілік бөлме аласың.
Dialogue: 0,0:20:51.79,0:20:54.71,Default,,0,0,0,,Жалақы мүлдем басқа деп естідім.
Dialogue: 0,0:20:55.29,0:20:58.96,Default,,0,0,0,,Қыздарды таңдау өте оңай, сондықтан бар күшіңізді салыңыз.
Dialogue: 0,0:20:59.54,0:21:03.26,Default,,0,0,0,,Түсінбеген нәрсені сұраңыз, мен бұл бөлменің ең үлкенімін.
Dialogue: 0,0:21:04.05,0:21:05.72,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:09.39,0:21:14.31,Default,,0,0,0,,Умм, бұл мекемеде ақ нәсілді бір бала жоқ па?
Dialogue: 0,0:21:14.39,0:21:16.10,Default,,0,0,0,,Ити сияқты
Dialogue: 0,0:21:16.19,0:21:17.48,Default,,0,0,0,,Юкио?
Dialogue: 0,0:21:17.56,0:21:21.07,Default,,0,0,0,,Иә, оның аты «Широу» болса керек.
Dialogue: 0,0:21:21.57,0:21:23.99,Default,,0,0,0,,Бұл таныс емес сияқты.
Dialogue: 0,0:21:24.07,0:21:25.49,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:28.32,0:21:32.58,Default,,0,0,0,,Әскерді көргенде біртүрлі болды, бірақ мен қазір тынышталдым деп ойлаймын.
Dialogue: 0,0:21:33.66,0:21:35.37,Default,,0,0,0,,Сәттілік анашым
Dialogue: 0,0:21:36.58,0:21:37.75,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:21:38.71,0:21:41.59,Default,,0,0,0,,Иә? Бұл жер таныс сияқты.
Dialogue: 0,0:21:42.34,0:21:43.09,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:21:44.97,0:21:46.09,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:46.88,0:21:48.05,Default,,0,0,0,,Мен сені алып келдім
Dialogue: 0,0:21:48.55,0:21:51.39,Default,,0,0,0,,Еңбегіңізге рахмет, орнынан кетіңіз.
Dialogue: 0,0:21:51.47,0:21:52.10,Default,,0,0,0,,Га
Dialogue: 0,0:21:54.77,0:21:55.52,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:21:55.60,0:22:00.40,Default,,0,0,0,,Сіз Azazel тобының сынақ нөмірі So-004сіз
Dialogue: 0,0:22:00.48,0:22:02.40,Default,,0,0,0,,Бұл Широ-кун.
Dialogue: 0,0:22:05.99,0:22:07.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.07,0:23:35.08,Default,,0,0,0,,～♪
