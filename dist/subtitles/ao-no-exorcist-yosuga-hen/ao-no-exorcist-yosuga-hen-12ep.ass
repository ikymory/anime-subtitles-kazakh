Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:03.67,Default,,0,0,0,,♪～
Dialogue: 0,0:01:27.25,0:01:29.25,Default,,0,0,0,,～♪
Dialogue: 0,0:01:35.13,0:01:36.13,Default,,0,0,0,,Хаму
Dialogue: 0,0:01:37.93,0:01:39.55,Default,,0,0,0,,Иә, жақсы ма?
Dialogue: 0,0:01:39.64,0:01:40.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:42.10,0:01:44.10,Default,,0,0,0,,Фосфор! Бұл жеуге болатын нәрсе емес!
Dialogue: 0,0:01:46.10,0:01:49.02,Default,,0,0,0,,- (Рин) Ахахха - (Широ) Не ​​істеп жатырсың!
Dialogue: 0,0:01:52.86,0:01:53.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:54.78,0:01:55.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:55.36,0:01:56.53,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:01:57.86,0:02:00.78,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:02:01.53,0:02:04.16,Default,,0,0,0,,Юкио сенен әлсіз.
Dialogue: 0,0:02:04.24,0:02:05.37,Default,,0,0,0,,Мені қорға
Dialogue: 0,0:02:05.45,0:02:06.79,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:06.87,0:02:08.79,Default,,0,0,0,,Көңіліңіз қалса, оны қайтарып көріңіз.
Dialogue: 0,0:02:08.87,0:02:10.75,Default,,0,0,0,,Оны қайтарыңыз~
Dialogue: 0,0:02:10.83,0:02:12.21,Default,,0,0,0,,Юкио!
Dialogue: 0,0:02:12.29,0:02:14.00,Default,,0,0,0,,(Жігіттер жылайды)
Dialogue: 0,0:02:14.09,0:02:16.13,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:02:16.21,0:02:18.01,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:02:18.09,0:02:19.68,Default,,0,0,0,,Қараңызшы, сіз де кешірім сұрауыңыз керек.
Dialogue: 0,0:02:19.76,0:02:20.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:22.47,0:02:25.31,Default,,0,0,0,,Мен саған мені қорға деп айттым, бірақ бұл тым көп.
Dialogue: 0,0:02:26.56,0:02:27.81,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:28.52,0:02:30.40,Default,,0,0,0,,Сізге де рахмет
Dialogue: 0,0:02:34.44,0:02:36.11,Default,,0,0,0,,Керемет!
Dialogue: 0,0:02:36.19,0:02:37.61,Default,,0,0,0,,Ол жылтыр.
Dialogue: 0,0:02:37.69,0:02:38.61,Default,,0,0,0,,Хой
Dialogue: 0,0:02:38.70,0:02:39.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:43.20,0:02:46.62,Default,,0,0,0,,Уф... бұл қорқынышты
Dialogue: 0,0:02:46.70,0:02:49.50,Default,,0,0,0,,Мен енді қорқынышты ештеңе көргім келмейді
Dialogue: 0,0:02:49.58,0:02:52.75,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:02:52.83,0:02:53.84,Default,,0,0,0,,Юкио
Dialogue: 0,0:02:56.55,0:02:58.72,Default,,0,0,0,,Әкеңмен бірге күрескің келе ме?
Dialogue: 0,0:02:59.22,0:03:00.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:02.14,0:03:04.47,Default,,0,0,0,,Қараңғылықтан қорқып өмір сүргеннен гөрі
Dialogue: 0,0:03:04.55,0:03:07.72,Default,,0,0,0,,Күшті болғың келмей ме, өзгені де, бауырыңды да қорғайсың ба?
Dialogue: 0,0:03:09.73,0:03:10.94,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:03:11.44,0:03:14.15,Default,,0,0,0,,Мен ағамды қорғайтындай күшті болғым келеді!
Dialogue: 0,0:03:14.23,0:03:15.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.74,0:03:28.16,Default,,0,0,0,,Әй, қолыңнан келгеннің бәрін істе! Сіз уәде бердіңіз!
Dialogue: 0,0:03:28.24,0:03:30.66,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:03:33.29,0:03:34.50,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:03:36.59,0:03:39.30,Default,,0,0,0,,(Риннің тынысы)
Dialogue: 0,0:03:42.88,0:03:44.05,Default,,0,0,0,,Мені жалғыз қалдырыңыз!
Dialogue: 0,0:03:45.01,0:03:46.89,Default,,0,0,0,,Қазір бәрі жақсы!
Dialogue: 0,0:03:51.39,0:03:53.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:53.27,0:03:55.02,Default,,0,0,0,,Эй, Рин, күл!
Dialogue: 0,0:03:59.15,0:04:01.07,Default,,0,0,0,,Қараңызшы, бұл Юкио Окумура.
Dialogue: 0,0:04:01.15,0:04:03.91,Default,,0,0,0,,- (Б қыз оқушы) Керемет! -(Оқушы қыз С) Көзілдірік қауіпті.
Dialogue: 0,0:04:16.83,0:04:19.38,Default,,0,0,0,,Фосфор! Бүгін сабақты жіберіп алмаңыз
Dialogue: 0,0:04:19.46,0:04:21.46,Default,,0,0,0,,Тіпті кіші мектеп оқушылары да көшірме алады.
Dialogue: 0,0:04:21.55,0:04:22.84,Default,,0,0,0,,Шулы қария!
Dialogue: 0,0:04:22.92,0:04:25.72,Default,,0,0,0,,Ондай жерде маған орын жоқ!
Dialogue: 0,0:04:26.26,0:04:28.85,Default,,0,0,0,,Ол шынымен қиналған жігіт.
Dialogue: 0,0:04:29.35,0:04:33.18,Default,,0,0,0,,Таңертеңгілік тамақты сыпайы түрде дайындағанда сүйкімді... бірақ...
Dialogue: 0,0:04:33.69,0:04:38.19,Default,,0,0,0,,Хаа~ Тағы біраз... хахахаха
Dialogue: 0,0:04:39.90,0:04:40.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:40.53,0:04:42.82,Default,,0,0,0,,Шулы, қарғыс атсын.
Dialogue: 0,0:04:42.90,0:04:45.86,Default,,0,0,0,,Ха... сен мені естисің бе? Мысалдағы жігіт?
Dialogue: 0,0:04:46.36,0:04:47.99,Default,,0,0,0,,Соңғы уақытта көбейіп келеді.
Dialogue: 0,0:04:49.12,0:04:51.08,Default,,0,0,0,,Бұл бетті жасама.
Dialogue: 0,0:04:52.04,0:04:57.13,Default,,0,0,0,,Уақыты келгенде мен сені өлтіретін ауыр азапты беремін.
Dialogue: 0,0:04:57.21,0:04:59.92,Default,,0,0,0,,Шикі тырнақ сыпырылған, Темір қыз, т.б.
Dialogue: 0,0:05:00.00,0:05:01.17,Default,,0,0,0,,××× т.б.
Dialogue: 0,0:05:01.67,0:05:04.84,Default,,0,0,0,,Мен орындаймын хи хи хи
Dialogue: 0,0:05:04.92,0:05:06.47,Default,,0,0,0,,Қалжың болса да, тоқтат!
Dialogue: 0,0:05:06.55,0:05:07.93,Default,,0,0,0,,Мен де кәсіпқоймын.
Dialogue: 0,0:05:08.01,0:05:09.97,Default,,0,0,0,,Маған мәңгілік баладай қарама, маған сүйенші.
Dialogue: 0,0:05:11.18,0:05:12.47,Default,,0,0,0,,Уайымдама, қазір бәрі жақсы.
Dialogue: 0,0:05:12.56,0:05:16.73,Default,,0,0,0,,Жын-перілермен күресудің тиімді жолы - ақыл мен денені байыту
Dialogue: 0,0:05:16.81,0:05:20.02,Default,,0,0,0,,Жақсы тамақтаныңыз, жақсы ұйықтаңыз және жақсы қозғалыңыз - бұл ең жақсы!
Dialogue: 0,0:05:20.11,0:05:21.94,Default,,0,0,0,,Жүр, сен де же!
Dialogue: 0,0:05:24.32,0:05:26.32,Default,,0,0,0,,Юкио дұрыс айтады.
Dialogue: 0,0:05:26.82,0:05:29.87,Default,,0,0,0,,Соңғы кездері өзімді нашар сезініп жүрмін.
Dialogue: 0,0:05:30.37,0:05:31.99,Default,,0,0,0,,Мен де қартайдым.
Dialogue: 0,0:05:32.66,0:05:36.04,Default,,0,0,0,,Келесі Денем алынса, жеңе аламын ба деп ойлаймын...
Dialogue: 0,0:05:37.25,0:05:39.75,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:05:39.83,0:05:42.13,Default,,0,0,0,,Өйткені «шайтан жүректен»
Dialogue: 0,0:05:43.42,0:05:44.63,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:05:45.13,0:05:49.47,Default,,0,0,0,,Балалар әлі балалар, сондықтан біз бұл туралы бірдеңе істеуіміз керек.
Dialogue: 0,0:05:50.68,0:05:54.85,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:05:56.27,0:05:57.77,Default,,0,0,0,,Бұл көрініс не болды?
Dialogue: 0,0:05:57.85,0:05:58.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:59.60,0:06:00.52,Default,,0,0,0,,Э-э…
Dialogue: 0,0:06:00.61,0:06:03.36,Default,,0,0,0,,үшін маған сұхбатқа бару керектігін айтты, мен оны қарызға алдым.
Dialogue: 0,0:06:03.44,0:06:04.36,Default,,0,0,0,,Галстук ше?
Dialogue: 0,0:06:04.44,0:06:06.99,Default,,0,0,0,,Сәнді...
Dialogue: 0,0:06:07.07,0:06:10.66,Default,,0,0,0,,А... ххх, сен оны қалай байлауды білмейсің.
Dialogue: 0,0:06:10.74,0:06:12.58,Default,,0,0,0,,Маған қарызға бер, мен саған үйретемін.
Dialogue: 0,0:06:12.66,0:06:13.74,Default,,0,0,0,,А...
Dialogue: 0,0:06:14.24,0:06:16.33,Default,,0,0,0,,Жағаңызды жоғары көтеріп, түймені басыңыз.
Dialogue: 0,0:06:18.71,0:06:22.34,Default,,0,0,0,,Менің фигурам ғана үлкен болып кетті.
Dialogue: 0,0:06:22.96,0:06:26.92,Default,,0,0,0,,Мен кішкентай кезімде «Әке, әке» сүйкімді деп ойлайтынмын.
Dialogue: 0,0:06:27.97,0:06:29.68,Default,,0,0,0,,Сіз бұл туралы қашан айтасыз?
Dialogue: 0,0:06:30.30,0:06:32.97,Default,,0,0,0,,Үлкен кезде сүйкімді болсаң жақсы емес пе?
Dialogue: 0,0:06:33.05,0:06:34.26,Default,,0,0,0,,Ересек?
Dialogue: 0,0:06:34.35,0:06:37.60,Default,,0,0,0,,Әй, үлкендер қайда?
Dialogue: 0,0:06:37.68,0:06:39.81,Default,,0,0,0,,- (Широ) Няхахаха - (Рин) Шулы!
Dialogue: 0,0:06:39.89,0:06:44.44,Default,,0,0,0,,Көңіліңіз қалса, қанша өскеніңізді көрсетіңіз.
Dialogue: 0,0:06:46.65,0:06:47.82,Default,,0,0,0,,Өйткені
Dialogue: 0,0:06:48.32,0:06:51.11,Default,,0,0,0,,Мен мұны өз күшіммен жасай алатынымды дәлелдеймін.
Dialogue: 0,0:06:51.20,0:06:54.08,Default,,0,0,0,,Мына көздерге мұқият қара!
Dialogue: 0,0:06:54.58,0:06:56.41,Default,,0,0,0,,Мен көзімді жұма алмаймын
Dialogue: 0,0:06:56.49,0:06:58.33,Default,,0,0,0,,Үніңді жап, қария.
Dialogue: 0,0:07:03.71,0:07:04.59,Default,,0,0,0,,Фосфор…
Dialogue: 0,0:07:05.09,0:07:08.55,Default,,0,0,0,,Хе хе хи хи хи...
Dialogue: 0,0:07:08.63,0:07:13.30,Default,,0,0,0,,Ахахаха хахаха...
Dialogue: 0,0:07:13.39,0:07:15.56,Default,,0,0,0,,Міне, осында ма?
Dialogue: 0,0:07:15.64,0:07:16.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:17.39,0:07:19.68,Default,,0,0,0,,Жын шығарушылар
Dialogue: 0,0:07:19.77,0:07:23.86,Default,,0,0,0,,Сол баланы өсіремін деп күлдім.
Dialogue: 0,0:07:23.94,0:07:28.44,Default,,0,0,0,,Мен ойлағаннан да тезірек аяқталатын сияқты.
Dialogue: 0,0:07:28.53,0:07:32.07,Default,,0,0,0,,Шынымен, сіз Риннің денесін көздеп отырсыз ба?
Dialogue: 0,0:07:32.16,0:07:35.62,Default,,0,0,0,,Ахахах... хахахаха
Dialogue: 0,0:07:35.70,0:07:39.08,Default,,0,0,0,,Ихихихихихи Ахахахха!
Dialogue: 0,0:07:39.16,0:07:40.66,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:07:41.54,0:07:46.75,Default,,0,0,0,,Менің денем жай ғана саңылау, мен осы уақыт бойы фосфорды бақылап жүрдім.
Dialogue: 0,0:07:47.25,0:07:48.59,Default,,0,0,0,,Қарғыс атсын шайтан!
Dialogue: 0,0:07:48.67,0:07:53.01,Default,,0,0,0,,Ухихихихи ахахахха!
Dialogue: 0,0:07:56.43,0:07:58.06,Default,,0,0,0,,Уф, бұл да...
Dialogue: 0,0:07:58.56,0:08:00.93,Default,,0,0,0,,Ихихихихихи…
Dialogue: 0,0:08:01.02,0:08:03.85,Default,,0,0,0,,Күте тұрыңыз! Мен шайтан дегенді түсінбеймін...
Dialogue: 0,0:08:03.94,0:08:05.86,Default,,0,0,0,,Ояну дегеніміз не?
Dialogue: 0,0:08:06.36,0:08:08.11,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:08:08.19,0:08:09.86,Default,,0,0,0,,Не? Ой...
Dialogue: 0,0:08:09.94,0:08:11.82,Default,,0,0,0,,Муда Муда
Dialogue: 0,0:08:12.65,0:08:14.82,Default,,0,0,0,,Бұл пайдасыз күрес
Dialogue: 0,0:08:15.57,0:08:17.07,Default,,0,0,0,,Сен екеуің алда барыңдар!
Dialogue: 0,0:08:19.83,0:08:20.87,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:08:21.37,0:08:24.21,Default,,0,0,0,,Басқаша айтқанда, мен келсем, бәрі шешіледі.
Dialogue: 0,0:08:24.29,0:08:25.12,Default,,0,0,0,,Фосфор
Dialogue: 0,0:08:25.21,0:08:26.96,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:08:27.04,0:08:30.09,Default,,0,0,0,,Қазір әдемі көрінеді, солай емес пе?
Dialogue: 0,0:08:30.17,0:08:32.59,Default,,0,0,0,,-(Рин) Бұл әлдеқайда сергітер еді. -(Широ) Рин...
Dialogue: 0,0:08:35.26,0:08:37.89,Default,,0,0,0,,Жібер! Ақырында мен оны лақтырып тастаймын
Dialogue: 0,0:08:37.97,0:08:40.31,Default,,0,0,0,,Мен бәрібір жаман баламын.
Dialogue: 0,0:08:40.81,0:08:43.85,Default,,0,0,0,,Жоқ, біз қандас емеспіз, біз жатпыз ба?
Dialogue: 0,0:08:43.94,0:08:44.44,Default,,0,0,0,,Фосфор
Dialogue: 0,0:08:44.52,0:08:46.73,Default,,0,0,0,,Адал бол, өз отбасым деп...
Dialogue: 0,0:08:46.81,0:08:50.94,Default,,0,0,0,,Іші әбден әлсіреген.
Dialogue: 0,0:08:51.44,0:08:54.86,Default,,0,0,0,,Хехехе... Ихихихихихи
Dialogue: 0,0:08:54.95,0:08:56.49,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:08:57.11,0:09:01.49,Default,,0,0,0,,Қазір иеленудің тамаша уақыты.
Dialogue: 0,0:09:02.29,0:09:04.58,Default,,0,0,0,,Менің көз алдымда тағы да әкедей болма!
Dialogue: 0,0:09:11.21,0:09:15.01,Default,,0,0,0,,Таң атуға жақын, асығыңыздар сөмкелеріңізді жинаңыздар.
Dialogue: 0,0:09:22.43,0:09:23.02,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:23.10,0:09:29.15,Default,,0,0,0,,(Шайтанның күлкісі)
Dialogue: 0,0:09:29.65,0:09:33.82,Default,,0,0,0,,Exorcist үшін осы.
Dialogue: 0,0:09:34.32,0:09:37.74,Default,,0,0,0,,Ахахаха! Хаа~
Dialogue: 0,0:09:37.82,0:09:40.24,Default,,0,0,0,,Аздап алаңдатады.
Dialogue: 0,0:09:40.32,0:09:41.24,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:41.78,0:09:42.62,Default,,0,0,0,,Гррр…
Dialogue: 0,0:09:46.41,0:09:47.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:48.67,0:09:52.55,Default,,0,0,0,,Бұл бала менің денемді иемденуі мүмкін емес.
Dialogue: 0,0:09:52.63,0:09:54.13,Default,,0,0,0,,Ба-ка
Dialogue: 0,0:09:54.63,0:09:57.38,Default,,0,0,0,,Бірақ талант сонда.
Dialogue: 0,0:09:57.88,0:10:00.60,Default,,0,0,0,,Бос әлемге тек мазмұнды ұрлау
Dialogue: 0,0:10:00.68,0:10:04.56,Default,,0,0,0,,Нағыз әкем менің миымды мұқият жуады.
Dialogue: 0,0:10:05.35,0:10:10.94,Default,,0,0,0,,Егер сіз жақсы жұмыс жасасаңыз, мен сияқты денеге ие болуыңыз мүмкін.
Dialogue: 0,0:10:12.94,0:10:16.28,Default,,0,0,0,,Иә? Кім мұны істейді?
Dialogue: 0,0:10:16.36,0:10:17.28,Default,,0,0,0,,Эй...
Dialogue: 0,0:10:17.36,0:10:19.91,Default,,0,0,0,,Сіздің денеңіз, әрине!
Dialogue: 0,0:10:22.62,0:10:24.45,Default,,0,0,0,,«Неге мен — теңіз офицері — әскердің орнына?»
Dialogue: 0,0:10:25.79,0:10:26.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:28.66,0:10:33.92,Default,,0,0,0,,Балам, сенімен танысқаныма қуаныштымын.
Dialogue: 0,0:10:35.46,0:10:39.38,Default,,0,0,0,,Не деген сұмдық Ахахахха!
Dialogue: 0,0:10:39.47,0:10:40.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:40.97,0:10:42.47,Default,,0,0,0,,Мен Шайтанмын
Dialogue: 0,0:10:42.97,0:10:46.72,Default,,0,0,0,,Жаһаннам Құдайы және сіздің биологиялық әкеңіз.
Dialogue: 0,0:10:48.52,0:10:50.90,Default,,0,0,0,,Сіз мені әке деп атай аласыз.
Dialogue: 0,0:10:50.98,0:10:53.90,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:10:55.19,0:10:56.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:57.49,0:10:58.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:08.04,0:11:09.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:09.87,0:11:10.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:10.46,0:11:13.46,Default,,0,0,0,,Менің қаным бар тозақ Құдайы
Dialogue: 0,0:11:13.54,0:11:16.21,Default,,0,0,0,,Оның денесі материалдық әлемде (ушер)
Dialogue: 0,0:11:16.71,0:11:19.09,Default,,0,0,0,,Сіз ерекшесіз
Dialogue: 0,0:11:19.80,0:11:20.80,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:11:20.88,0:11:22.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:23.34,0:11:27.43,Default,,0,0,0,,Хахахаха! Бұл жақсы туған айқай
Dialogue: 0,0:11:27.52,0:11:30.81,Default,,0,0,0,,Бүгін сен шайтан болып қайта туыласың.
Dialogue: 0,0:11:31.60,0:11:34.15,Default,,0,0,0,,Уф...біреу маған көмектессін!
Dialogue: 0,0:11:34.23,0:11:34.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:34.90,0:11:37.61,Default,,0,0,0,,Балам туған күнің құтты болсын
Dialogue: 0,0:11:37.69,0:11:39.07,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:11:41.07,0:11:41.95,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:11:47.66,0:11:49.87,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:11:50.37,0:11:55.71,Default,,0,0,0,,Бұл менің ұлым, оны қайтарып алуға бола ма?
Dialogue: 0,0:11:57.17,0:12:01.55,Default,,0,0,0,,О... мен, жын шығарушы.
Dialogue: 0,0:12:02.43,0:12:04.43,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:12:05.34,0:12:09.68,Default,,0,0,0,,Ол сондай балық иісі бар монах, ол өз өмірін қиюы мүмкін.
Dialogue: 0,0:12:10.39,0:12:12.64,Default,,0,0,0,,Бірақ қазірдің өзінде кеш
Dialogue: 0,0:12:13.60,0:12:17.40,Default,,0,0,0,,Жаһаннам қақпасын ешқашан жібермеңіз
Dialogue: 0,0:12:20.94,0:12:24.03,Default,,0,0,0,,Қария! Мықты бол, қария!
Dialogue: 0,0:12:24.53,0:12:28.37,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:47.30,0:12:49.56,Default,,0,0,0,,Жауабын таптың ба?
Dialogue: 0,0:12:55.44,0:13:00.15,Default,,0,0,0,,Шайтан Юрий Эгин Широ Фуджимото
Dialogue: 0,0:13:00.94,0:13:05.70,Default,,0,0,0,,Осыншама мәйітті басып өткеннен кейін қандай сезімде болдыңыз?
Dialogue: 0,0:13:07.11,0:13:10.53,Default,,0,0,0,,Ешқашан туылмасаң жақсы болар ма еді?
Dialogue: 0,0:13:11.04,0:13:12.75,Default,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,0:13:15.50,0:13:18.08,Default,,0,0,0,,Сіз кімсіз...?
Dialogue: 0,0:13:18.58,0:13:22.63,Default,,0,0,0,,Мені қару етесің бе, әлде Шайтанның денесіне айналдырасың ба?
Dialogue: 0,0:13:22.71,0:13:23.76,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:13:26.13,0:13:30.43,Default,,0,0,0,,Ал, тар мағынада екеуі де.
Dialogue: 0,0:13:30.93,0:13:36.44,Default,,0,0,0,,Уақыт патшасы болғандықтан, мен, уақыт патшасы да болашақты болжай алмаймын.
Dialogue: 0,0:13:36.94,0:13:39.61,Default,,0,0,0,,Мен не істегіңіз келсе де
Dialogue: 0,0:13:39.69,0:13:42.86,Default,,0,0,0,,Мінсіз бақылау мүмкін емес
Dialogue: 0,0:13:45.49,0:13:47.61,Default,,0,0,0,,Тағы да,
Dialogue: 0,0:13:47.70,0:13:53.12,Default,,0,0,0,,Бұл кілт сізді барғыңыз келетін жерге апарады.
Dialogue: 0,0:14:06.17,0:14:09.39,Default,,0,0,0,,Болашақ өз қолыңда
Dialogue: 0,0:14:18.31,0:14:19.35,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:14:19.85,0:14:22.40,Default,,0,0,0,,Гү!
Dialogue: 0,0:14:22.48,0:14:23.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.15,0:14:25.90,Default,,0,0,0,,Сіз қайтып келдіңіз бе?
Dialogue: 0,0:14:26.40,0:14:28.61,Default,,0,0,0,,Балалар, жол шөптерін қайда жедіңдер?
Dialogue: 0,0:14:30.78,0:14:32.03,Default,,0,0,0,,Иә? Ол кім?
Dialogue: 0,0:14:32.95,0:14:34.58,Default,,0,0,0,,Ах, жоқ, яғни…
Dialogue: 0,0:14:35.08,0:14:37.37,Default,,0,0,0,,Мен капюшонды киюді ұмытып кетіппін!
Dialogue: 0,0:14:37.87,0:14:39.62,Default,,0,0,0,,Жарайсыңдар, отырыңдар.
Dialogue: 0,0:14:40.12,0:14:41.17,Default,,0,0,0,,А...
Dialogue: 0,0:14:42.33,0:14:43.79,Default,,0,0,0,,Осыны қолданып көріңіз.
Dialogue: 0,0:14:43.88,0:14:44.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:48.51,0:14:52.60,Default,,0,0,0,,А, мынау... Май және соя соусы қосылған онигири қуырылған күріш
Dialogue: 0,0:14:52.68,0:14:56.06,Default,,0,0,0,,Кішкентай кезімде қариям осыны жасап беретін.
Dialogue: 0,0:14:56.81,0:15:00.06,Default,,0,0,0,,Мен оны бірінші рет жасап отырмын, дәмін татып көріңдер.
Dialogue: 0,0:15:00.14,0:15:02.06,Default,,0,0,0,,Ах ха... ха
Dialogue: 0,0:15:14.41,0:15:15.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:16.29,0:15:18.41,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:19.41,0:15:21.04,Default,,0,0,0,,- (Рин) Дәмді екен - (Широ) Ой
Dialogue: 0,0:15:21.79,0:15:23.54,Default,,0,0,0,,Мүмкін сәл жұқа
Dialogue: 0,0:15:23.63,0:15:24.67,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:15:25.17,0:15:28.17,Default,,0,0,0,,Бір досымның мұны маған жасағаны есімде.
Dialogue: 0,0:15:28.92,0:15:30.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:30.30,0:15:31.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:32.01,0:15:34.05,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:15:34.14,0:15:36.18,Default,,0,0,0,,Көп, тамақ ішіп ал.
Dialogue: 0,0:15:36.26,0:15:37.85,Default,,0,0,0,,Ах... Азусу
Dialogue: 0,0:15:37.93,0:15:40.68,Default,,0,0,0,,Бозарып кеткен сияқтысың. Сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 0,0:15:41.98,0:15:44.40,Default,,0,0,0,,Ерекше кезекшіліктегі жас жігіт бір тапсырманы орындауға мәжбүр болды.
Dialogue: 0,0:15:44.48,0:15:45.98,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:15:46.98,0:15:50.61,Default,,0,0,0,,Кешіріңіз, бірақ маған Жүз айдаһар жынсыздандыратын корпусының қолбасшылығынан бас тартуға рұқсат етіңіз.
Dialogue: 0,0:15:50.69,0:15:54.87,Default,,0,0,0,,Жақында Люсидің орнына Төрт Ұлы Рыцарьға (Аркнайт) қосылған жігіт.
Dialogue: 0,0:15:54.95,0:15:57.41,Default,,0,0,0,,Ум... аа...
Dialogue: 0,0:15:57.49,0:16:00.96,Default,,0,0,0,,Е... Періште? Ол жасай берсін.
Dialogue: 0,0:16:01.04,0:16:02.87,Default,,0,0,0,,Бұл өте күшті
Dialogue: 0,0:16:03.67,0:16:08.13,Default,,0,0,0,,Шынымды айтсам, әкелік шаруамен айналысамын.
Dialogue: 0,0:16:08.67,0:16:11.76,Default,,0,0,0,,Неге Ватиканға айтпайсың?
Dialogue: 0,0:16:14.43,0:16:17.18,Default,,0,0,0,,Әке болу... қиын ба?
Dialogue: 0,0:16:17.81,0:16:19.81,Default,,0,0,0,,Ал...
Dialogue: 0,0:16:20.68,0:16:23.52,Default,,0,0,0,,Мен әке болу дегенді түсінбеймін.
Dialogue: 0,0:16:24.02,0:16:28.77,Default,,0,0,0,,Қараңдаршы, менің ағам көзілдірігінен сілекей ағып ұйықтап жатыр.
Dialogue: 0,0:16:29.27,0:16:32.61,Default,,0,0,0,,Ол жомарт және мейірімді еңбекқор, бірақ
Dialogue: 0,0:16:33.11,0:16:36.24,Default,,0,0,0,,Тәнім әлсіреп, тағамым жұқа, Ібіліс көремін.
Dialogue: 0,0:16:36.32,0:16:38.03,Default,,0,0,0,,Мен әрқашан секіремін
Dialogue: 0,0:16:38.87,0:16:42.20,Default,,0,0,0,,Әйтеуір, өзіме деген сенімім жоқ па деп уайымдаймын.
Dialogue: 0,0:16:42.71,0:16:44.04,Default,,0,0,0,,Мен бірдеңе істегім келеді
Dialogue: 0,0:16:44.12,0:16:47.04,Default,,0,0,0,,«Менімен бірге күшейіп, эксорцист болғың келе ме?» деп сұрадым.
Dialogue: 0,0:16:47.92,0:16:51.00,Default,,0,0,0,,«Мен ағамды қорғайтындай күшті болғым келеді».
Dialogue: 0,0:16:51.51,0:16:55.18,Default,,0,0,0,,Мені Жын шығару мектебінің мұғалімі де іздеді.
Dialogue: 0,0:16:55.80,0:17:00.97,Default,,0,0,0,,Мен үйрететін жалғыз нәрсе, мен мүмкіндігінше үйреткім келеді.
Dialogue: 0,0:17:02.14,0:17:04.39,Default,,0,0,0,,Астындағы жартылай бөксесі дірілдеп жатыр.
Dialogue: 0,0:17:04.48,0:17:04.98,Default,,0,0,0,,А...
Dialogue: 0,0:17:05.81,0:17:08.81,Default,,0,0,0,,Бұл жігіт те отбасының қамын ойлайды, сондықтан ол жаман адам емес.
Dialogue: 0,0:17:08.90,0:17:13.15,Default,,0,0,0,,Мәселе мынада, ол шыдамдылық танытқаннан кейін зорлықшыл болып, өз күшін басқара алмайды.
Dialogue: 0,0:17:13.65,0:17:15.95,Default,,0,0,0,,Ең бастысы, тым көп жау жасаңыз.
Dialogue: 0,0:17:16.53,0:17:21.66,Default,,0,0,0,,Юкиоға эксорцист ретінде соғысуды үйретуім керек пе?
Dialogue: 0,0:17:21.74,0:17:24.37,Default,,0,0,0,,Мен бұл туралы біраз уақыттан бері алаңдадым.
Dialogue: 0,0:17:25.08,0:17:25.71,Default,,0,0,0,,Шығу
Dialogue: 0,0:17:25.79,0:17:26.50,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:27.42,0:17:30.54,Default,,0,0,0,,Мен бұл жігітке тамақ жасауды үйретемін деп ойладым.
Dialogue: 0,0:17:30.63,0:17:34.17,Default,,0,0,0,,Мен мүмкіндігінше үйреткім келді, сондықтан мен жаттығатынмын.
Dialogue: 0,0:17:34.26,0:17:38.26,Default,,0,0,0,,Біз бірге оқитын сияқтымыз.
Dialogue: 0,0:17:40.39,0:17:41.60,Default,,0,0,0,,Неге...
Dialogue: 0,0:17:42.10,0:17:42.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:43.77,0:17:46.02,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:17:46.10,0:17:48.73,Default,,0,0,0,,Ас әзірлеу сіздің миыңызды және физикалық күшіңізді пайдаланады
Dialogue: 0,0:17:48.81,0:17:50.77,Default,,0,0,0,,Қанша күш қолдану керектігін де есте сақтау керек.
Dialogue: 0,0:17:50.86,0:17:53.32,Default,,0,0,0,,Сіз оны жасап жатқан адам туралы да ойлануыңыз керек.
Dialogue: 0,0:17:53.90,0:17:57.49,Default,,0,0,0,,Бәрінен де ол: «Мен Юкионы тамақтандырғым келеді» дейді.
Dialogue: 0,0:17:57.57,0:17:59.49,Default,,0,0,0,,Біраз дән қалса жақсы.
Dialogue: 0,0:17:59.57,0:18:00.74,Default,,0,0,0,,Тостаған да жылап тұр.
Dialogue: 0,0:18:01.37,0:18:05.00,Default,,0,0,0,,Юкио балық гамбургерін жейтін еді, солай ма?
Dialogue: 0,0:18:08.08,0:18:09.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:15.67,0:18:16.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:21.85,0:18:22.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:23.01,0:18:24.01,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:24.10,0:18:26.93,Default,,0,0,0,,Фосфордан қорықпайтын Юкио - құтқарушы.
Dialogue: 0,0:18:27.02,0:18:28.02,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:18:28.10,0:18:29.56,Default,,0,0,0,,Хехе...
Dialogue: 0,0:18:33.94,0:18:34.78,Default,,0,0,0,,Бірақ білесің бе—
Dialogue: 0,0:18:35.44,0:18:38.74,Default,,0,0,0,,Сығылған мектептің нұсқаушысы да, аспазшы әке де қателесуі мүмкін.
Dialogue: 0,0:18:39.24,0:18:42.62,Default,,0,0,0,,Шынымды айтсам, дұрыс жауаптың қандай екенін білмеймін.
Dialogue: 0,0:18:43.12,0:18:47.08,Default,,0,0,0,,Мен бос емеспін, бұл өте қиын болуы керек.
Dialogue: 0,0:18:47.75,0:18:50.46,Default,,0,0,0,,(Екі адам ұйықтап жатыр)
Dialogue: 0,0:18:50.54,0:18:51.92,Default,,0,0,0,,Мен оларға қарасам
Dialogue: 0,0:18:53.09,0:18:56.46,Default,,0,0,0,,Мұндай уайымдар маңызды емес.
Dialogue: 0,0:19:00.88,0:19:02.43,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:05.51,0:19:08.10,Default,,0,0,0,,- (Рин) Мен кетейін деп жатырмын - (Широ) А?
Dialogue: 0,0:19:08.60,0:19:11.06,Default,,0,0,0,,Кешіріңіз, бос сөзді доғарыңыз.
Dialogue: 0,0:19:11.65,0:19:12.31,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:19:12.40,0:19:13.81,Default,,0,0,0,,- (фосфор) А? -(Широ) Қалғанын ал.
Dialogue: 0,0:19:13.90,0:19:16.19,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:19:16.69,0:19:19.32,Default,,0,0,0,,Бұл Ватиканға хабарлама жіберетін адам.
Dialogue: 0,0:19:19.40,0:19:21.95,Default,,0,0,0,,бұл... Иә, кешіріңіз.
Dialogue: 0,0:19:53.10,0:19:53.98,Default,,0,0,0,,Әке.
Dialogue: 0,0:19:54.06,0:19:54.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:57.19,0:19:58.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:07.53,0:20:10.75,Default,,0,0,0,,Ей, көп нәрсеге мән берме.
Dialogue: 0,0:20:16.25,0:20:17.50,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:18.13,0:20:19.21,Default,,0,0,0,,Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:20:20.71,0:20:22.01,Default,,0,0,0,,Жауабын білген соң...
Dialogue: 0,0:20:22.76,0:20:24.22,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:24.30,0:20:26.30,Default,,0,0,0,,Бәрі біткен сияқты
Dialogue: 0,0:20:28.51,0:20:32.39,Default,,0,0,0,,Тумағаным жақсы болар еді.
Dialogue: 0,0:20:34.56,0:20:37.19,Default,,0,0,0,,Куу… Куууу…
Dialogue: 0,0:20:37.27,0:20:40.53,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:40.61,0:20:42.07,Default,,0,0,0,,Сен ақымақ емессің бе?
Dialogue: 0,0:20:42.57,0:20:47.70,Default,,0,0,0,,Мені тірі қалдыру үшін әкем де, шешем де көп еңбек етті.
Dialogue: 0,0:20:49.99,0:20:53.29,Default,,0,0,0,,Шайтанның баласы болса да, мен де
Dialogue: 0,0:20:53.37,0:20:54.46,Default,,0,0,0,,Бірақ бұл шынымен дұрыс па?
Dialogue: 0,0:20:54.54,0:20:57.29,Default,,0,0,0,,Мен бір күні өлгенше
Dialogue: 0,0:20:57.38,0:20:59.50,Default,,0,0,0,,Тірі болған дұрыс
Dialogue: 0,0:21:00.67,0:21:04.76,Default,,0,0,0,,Ағайындар, жақсы араласыңдар.
Dialogue: 0,0:21:05.76,0:21:08.05,Default,,0,0,0,,Иә, ол ақымақ еді.
Dialogue: 0,0:21:08.14,0:21:11.14,Default,,0,0,0,,Мен шайтанмен дос болуды армандап, сәтсіздікке ұшырадым.
Dialogue: 0,0:21:11.22,0:21:14.64,Default,,0,0,0,,Сонда сіз ше?
Dialogue: 0,0:21:16.02,0:21:18.48,Default,,0,0,0,,Адамдар мен жындар бір-бірін түсіне алады.
Dialogue: 0,0:21:19.48,0:21:20.86,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:21:31.58,0:21:33.50,Default,,0,0,0,,Менде Йети бар
Dialogue: 0,0:21:37.46,0:21:38.42,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:21:39.67,0:21:40.88,Default,,0,0,0,,Сондай-ақ Юкиоға
Dialogue: 0,0:21:42.13,0:21:43.38,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:21:47.26,0:21:48.59,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:21:48.68,0:21:49.43,Default,,0,0,0,,Сен
Dialogue: 0,0:21:52.01,0:21:53.31,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:57.89,0:21:59.56,Default,,0,0,0,,Берілме!
Dialogue: 0,0:22:05.90,0:22:07.90,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.24,0:23:35.24,Default,,0,0,0,,～♪
