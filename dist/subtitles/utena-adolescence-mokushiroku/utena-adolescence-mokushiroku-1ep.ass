Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:03:46.53,0:03:48.13,Default,NTP,0000,0000,0000,!Effect,Тенжу Утена!
Dialogue: 0,0:03:50.40,0:03:53.53,Default,NTP,0000,0000,0000,!Effect,Жаңа мектептегі алғашқы күніңізді қалай сезінесіз?
Dialogue: 0,0:03:53.53,0:03:54.97,Default,NTP,0000,0000,0000,!Effect,Дұрыс...
Dialogue: 0,0:03:55.12,0:03:56.90,Default,NTP,0000,0000,0000,!Effect,Сендей сүйкімді қыз болса
Dialogue: 0,0:03:56.94,0:03:58.16,Default,NTP,0000,0000,0000,!Effect,Бұл көңілді болатын сияқты
Dialogue: 0,0:03:58.85,0:03:59.53,Default,NTP,0000,0000,0000,!Effect,Жақсы!
Dialogue: 0,0:04:00.26,0:04:02.04,Default,NTP,0000,0000,0000,!Effect,Менің ойымша, бұл... бізге сәйкес келеді ме?
Dialogue: 0,0:04:02.71,0:04:04.69,Default,NTP,0000,0000,0000,!Effect,Мен саған мектепті көрсетемін!
Dialogue: 0,0:04:05.05,0:04:07.26,Default,NTP,0000,0000,0000,!Effect,Сіздің атыңыз кім?
Dialogue: 0,0:04:08.46,0:04:10.05,Default,NTP,0000,0000,0000,!Effect,Вакаба Шинохара!
Dialogue: 0,0:04:19.16,0:04:21.72,Default,NTP,0000,0000,0000,!Effect,Бәріңе сәлем!
Dialogue: 0,0:04:22.09,0:04:27.03,Default,NTP,0000,0000,0000,!Effect,Егер бұл дауыс сізге жетсе, құлақтарыңызды ашып тыңдаңыздар!
Dialogue: 0,0:04:27.10,0:04:30.09,Default,NTP,0000,0000,0000,!Effect,Вагахо академиясының хабар тарату клубының жақсы достары
Dialogue: 0,0:04:30.17,0:04:31.10,Default,NTP,0000,0000,0000,!Effect,E-ko арқылы
Dialogue: 0,0:04:31.17,0:04:32.36,Default,NTP,0000,0000,0000,!Effect,F баланың
Dialogue: 0,0:04:32.44,0:04:35.57,Default,NTP,0000,0000,0000,!Effect,Түсте мектеп хабары!
Dialogue: 0,0:04:35.77,0:04:37.50,Default,NTP,0000,0000,0000,!Effect,Бүгін салқын жел соғады
Dialogue: 0,0:04:37.58,0:04:40.34,Default,NTP,0000,0000,0000,!Effect,Бұл өте жағымды күн болды!
Dialogue: 0,0:04:40.41,0:04:44.54,Default,NTP,0000,0000,0000,!Effect,Егер сізде түскі ас қорабы болса, оны сыртқа апарыңыз!
Dialogue: 0,0:04:46.59,0:04:48.05,Default,NTP,0000,0000,0000,!Effect,Сіз тоқтағаныңыз жөн.
Dialogue: 0,0:04:48.12,0:04:51.02,Default,NTP,0000,0000,0000,!Effect,Өйткені жаңбыр еріксіз жауады
Dialogue: 0,0:04:51.62,0:04:55.49,Default,NTP,0000,0000,0000,!Effect,Әй, олар ауа райы болжамында бұлай айтқан жоқ!
Dialogue: 0,0:04:58.36,0:05:00.52,Default,NTP,0000,0000,0000,!Effect,Жүрегіме жауған жаңбыр
Dialogue: 0,0:05:00.60,0:05:02.79,Default,NTP,0000,0000,0000,!Effect,Бұл аспанды бұлт бүркейтіні сөзсіз.
Dialogue: 0,0:05:02.87,0:05:04.30,Default,NTP,0000,0000,0000,!Effect,Сізді тағы да тастап кетті ме?
Dialogue: 0,0:05:04.37,0:05:06.80,Default,NTP,0000,0000,0000,!Effect,Маған не болды? !
Dialogue: 0,0:05:06.87,0:05:08.31,Default,NTP,0000,0000,0000,!Effect,Сәлем бәріңе! !
Dialogue: 0,0:05:10.01,0:05:13.21,Default,NTP,0000,0000,0000,!Effect,Жігітіңіздің арқасына сурет салып ойнағанда
Dialogue: 0,0:05:13.28,0:05:18.31,Default,NTP,0000,0000,0000,!Effect,Келесі күнгі дене шынықтыру сабағының жүзу екенін тексеріңіз! !
Dialogue: 0,0:05:21.32,0:05:22.79,Default,NTP,0000,0000,0000,!Effect,Сәлем, Вакаба?
Dialogue: 0,0:05:23.60,0:05:24.17,Default,NTP,0000,0000,0000,!Effect,О, не?
Dialogue: 0,0:05:25.82,0:05:28.16,Default,NTP,0000,0000,0000,!Effect,Орта мектеп ғимараты...
Dialogue: 0,0:05:29.70,0:05:30.63,Default,NTP,0000,0000,0000,!Effect,Не?
Dialogue: 0,0:05:35.50,0:05:36.93,Default,NTP,0000,0000,0000,!Effect,Қоршау бөлімі
Dialogue: 0,0:05:37.00,0:05:39.33,Default,NTP,0000,0000,0000,!Effect,Қыздар арасында өте танымал!
Dialogue: 0,0:05:39.40,0:05:41.24,Default,NTP,0000,0000,0000,!Effect,Әй, міне ханзада келді!
Dialogue: 0,0:05:42.47,0:05:43.74,Default,NTP,0000,0000,0000,!Effect,Ханзада?
Dialogue: 0,0:06:10.80,0:06:12.27,Default,NTP,0000,0000,0000,!Effect,Күтілгендей.
Dialogue: 0,0:06:12.47,0:06:15.10,Default,NTP,0000,0000,0000,!Effect,Бірақ мен әлі бас тартпаймын.
Dialogue: 0,0:06:18.08,0:06:20.47,Default,NTP,0000,0000,0000,!Effect,Фортепиано сізге көбірек жарасады.
Dialogue: 0,0:06:24.78,0:06:26.15,Default,NTP,0000,0000,0000,!Effect,Бұл өте танымал.
Dialogue: 0,0:06:26.22,0:06:28.02,Default,NTP,0000,0000,0000,!Effect,Дұрыс.
Dialogue: 0,0:06:28.09,0:06:31.25,Default,NTP,0000,0000,0000,!Effect,Бұл Джури-сенпай мен Микки.
Dialogue: 0,0:06:32.12,0:06:35.36,Default,NTP,0000,0000,0000,!Effect,Әлгі бұйра шашты қыз Арисугава Джури-сенпай.
Dialogue: 0,0:06:35.49,0:06:36.89,Default,NTP,0000,0000,0000,!Effect,Семсерлесу клубының капитаны
Dialogue: 0,0:06:37.18,0:06:39.30,Default,NTP,0000,0000,0000,!Effect,Ол студенттік кеңестің тамаша мүшесі!
Dialogue: 0,0:06:40.37,0:06:41.23,Default,NTP,0000,0000,0000,!Effect,Келесі!
Dialogue: 0,0:06:41.30,0:06:45.17,Default,NTP,0000,0000,0000,!Effect,Қыздардың бәрі оны ханзада деп атайды.
Dialogue: 0,0:06:45.24,0:06:47.76,Default,NTP,0000,0000,0000,!Effect,Мүмкін ол сенің қарсыласың шығар
Dialogue: 0,0:06:48.57,0:06:49.56,Default,NTP,0000,0000,0000,!Effect,ИӘ! Бұл мен, мен
Dialogue: 0,0:06:49.64,0:06:53.67,Default,NTP,0000,0000,0000,!Effect,Бала Каорумики-кун.
Dialogue: 0,0:06:56.58,0:06:57.78,Default,NTP,0000,0000,0000,!Effect,Мен әлі орта мектепте болсам да.
Dialogue: 0,0:06:57.85,0:07:01.18,Default,NTP,0000,0000,0000,!Effect,Ол данышпан, университеттің оқу бағдарламаларын қабылдайды.
Dialogue: 0,0:07:01.25,0:07:03.85,Default,NTP,0000,0000,0000,!Effect,Сүйкімді болу сізді танымал етеді...
Dialogue: 0,0:07:14.77,0:07:15.49,Default,NTP,0000,0000,0000,!Effect,Бірақ
Dialogue: 0,0:07:15.57,0:07:17.13,Default,NTP,0000,0000,0000,!Effect,Егіз әпкем араласты.
Dialogue: 0,0:07:17.20,0:07:20.19,Default,NTP,0000,0000,0000,!Effect,Сен қыз ала алмайсың деген қауесет бар.
Dialogue: 0,0:07:21.21,0:07:23.00,Default,NTP,0000,0000,0000,!Effect,Иә? Утена...
Dialogue: 0,0:07:23.86,0:07:24.64,Default,NTP,0000,0000,0000,!Effect,Қайда?
Dialogue: 0,0:08:25.14,0:08:26.43,Default,NTP,0000,0000,0000,!Effect,Жаңбыр жауып тұр.
Dialogue: 0,0:08:29.34,0:08:30.67,Default,NTP,0000,0000,0000,!Effect,Жақында тоқтайды
Dialogue: 0,0:08:31.28,0:08:33.71,Default,NTP,0000,0000,0000,!Effect,Құбылмалы... жаңбыр сияқты.
Dialogue: 0,0:08:34.73,0:08:36.10,Default,NTP,0000,0000,0000,!Effect,Содан бері неше жыл өтті?
Dialogue: 0,0:08:36.75,0:08:38.91,Default,NTP,0000,0000,0000,!Effect,Сізді осылай қарсы алу
Dialogue: 0,0:08:39.35,0:08:43.15,Default,NTP,0000,0000,0000,!Effect,Планетарийге барамын деген уәдеңіз есіңізде ме?
Dialogue: 0,0:08:43.82,0:08:45.22,Default,NTP,0000,0000,0000,!Effect,Осылай қалды.
Dialogue: 0,0:08:45.53,0:08:46.99,Default,NTP,0000,0000,0000,!Effect,Мені қате түсінбеңіз!
Dialogue: 0,0:08:48.56,0:08:49.96,Default,NTP,0000,0000,0000,!Effect,Түсінбеушілік?
Dialogue: 0,0:08:50.86,0:08:52.16,Default,NTP,0000,0000,0000,!Effect,…Мен
Dialogue: 0,0:08:52.23,0:08:54.46,Default,NTP,0000,0000,0000,!Effect,Мен енді бір адам емеспін
Dialogue: 0,0:08:54.67,0:08:57.50,Default,NTP,0000,0000,0000,!Effect,Мен мұнда сені қуу үшін келген жоқпын.
Dialogue: 0,0:08:58.22,0:08:59.40,Default,NTP,0000,0000,0000,!Effect,Бірақ мен таң қалдым.
Dialogue: 0,0:08:59.47,0:09:02.17,Default,NTP,0000,0000,0000,!Effect,Мен сені бұл мектепте болады деп күтпедім.
Dialogue: 0,0:09:06.61,0:09:07.77,Default,NTP,0000,0000,0000,!Effect,Бұл көрініс...
Dialogue: 0,0:09:09.31,0:09:10.80,Default,NTP,0000,0000,0000,!Effect,Ханзада
Dialogue: 0,0:09:11.02,0:09:14.25,Default,NTP,0000,0000,0000,!Effect,Мен бұл шешімді сенімен ажырасқаннан кейін қабылдадым.
Dialogue: 0,0:09:14.62,0:09:16.71,Default,NTP,0000,0000,0000,!Effect,Жоғары ұмтылыспен өмір сүр
Dialogue: 0,0:09:21.15,0:09:23.76,Default,NTP,0000,0000,0000,!Effect,Сізге жоғары ұмтылыс
Dialogue: 0,0:09:26.16,0:09:27.65,Default,NTP,0000,0000,0000,!Effect,Сол сақина...
Dialogue: 0,0:09:29.10,0:09:32.30,Default,NTP,0000,0000,0000,!Effect,Түсіндім, біреуге құда түстім.
Dialogue: 0,0:09:33.24,0:09:36.47,Default,NTP,0000,0000,0000,!Effect,Мені осы мектепке жетелеген осы болды.
Dialogue: 0,0:09:37.94,0:09:40.94,Default,NTP,0000,0000,0000,!Effect,...Раушан гравюра
Dialogue: 0,0:09:53.16,0:09:54.28,Default,NTP,0000,0000,0000,!Effect,Раушан гүлдер, иә?
Dialogue: 0,0:09:58.83,0:10:00.16,Default,NTP,0000,0000,0000,!Effect,Ақ раушан
Dialogue: 0,0:10:26.12,0:10:27.18,Default,NTP,0000,0000,0000,!Effect,…Бұл
Dialogue: 0,0:10:47.65,0:10:49.98,Default,NTP,0000,0000,0000,!Effect,Не?
Dialogue: 0,0:11:58.18,0:11:59.62,Default,NTP,0000,0000,0000,!Effect,Сіз қорықпайсыз ба?
Dialogue: 0,0:12:03.62,0:12:07.25,Default,NTP,0000,0000,0000,!Effect,Сол жерде тұрып қорықпайсың ба?
Dialogue: 0,0:12:07.53,0:12:09.12,Default,NTP,0000,0000,0000,!Effect,Қандай керемет раушан гүлі!
Dialogue: 0,0:12:09.26,0:12:10.69,Default,NTP,0000,0000,0000,!Effect,Менің раушан гүлім.
Dialogue: 0,0:12:10.76,0:12:11.85,Default,NTP,0000,0000,0000,!Effect,Суретке түсіріп алсам болар еді
Dialogue: 0,0:12:11.93,0:12:15.96,Default,NTP,0000,0000,0000,!Effect,Мен президенттің әпкесімін, сондықтан маған ерекше күтім көрсетіледі.
Dialogue: 0,0:12:16.84,0:12:17.89,Default,NTP,0000,0000,0000,!Effect,Бірақ
Dialogue: 0,0:12:19.30,0:12:21.97,Default,NTP,0000,0000,0000,!Effect,Негізі менмін
Dialogue: 0,0:12:22.04,0:12:24.27,Default,NTP,0000,0000,0000,!Effect,Мүмкін оны раушан гүлдері басып алған шығар...
Dialogue: 0,0:12:34.52,0:12:37.45,Default,NTP,0000,0000,0000,!Effect,Бұл мектепке не үшін келдің?
Dialogue: 0,0:12:38.66,0:12:39.75,Default,NTP,0000,0000,0000,!Effect,Мен...
Dialogue: 0,0:12:45.83,0:12:47.02,Default,NTP,0000,0000,0000,!Effect,Мен
Dialogue: 0,0:13:07.85,0:13:10.91,Default,NTP,0000,0000,0000,!Effect,Бұл раушан маркасы менікі!
Dialogue: 0,0:13:11.19,0:13:13.52,Default,NTP,0000,0000,0000,!Effect,! ? Неліктен бұл атау?
Dialogue: 0,0:13:13.59,0:13:15.12,Default,NTP,0000,0000,0000,!Effect,Қауіпке барма.
Dialogue: 0,0:13:19.90,0:13:22.73,Default,NTP,0000,0000,0000,!Effect,Раушан келінге не істеп жатырсың?
Dialogue: 0,0:13:22.80,0:13:26.70,Default,NTP,0000,0000,0000,!Effect,Раушан гүлінің қалыңдығы?
Dialogue: 0,0:13:29.27,0:13:32.61,Default,NTP,0000,0000,0000,!Effect,Бұл орынға қатысы барлардан басқа ешкімге тыйым салынады.
Dialogue: 0,0:13:36.35,0:13:40.25,Default,NTP,0000,0000,0000,!Effect,О, түсіндім. Сіз де дуэлистсіз бе?
Dialogue: 0,0:13:40.39,0:13:41.68,Default,NTP,0000,0000,0000,!Effect,Дуэлист?
Dialogue: 0,0:13:41.75,0:13:43.62,Default,NTP,0000,0000,0000,!Effect,Қоғамдық апатты жою
Dialogue: 0,0:13:43.69,0:13:44.92,Default,NTP,0000,0000,0000,!Effect,Бұл бейтаныс бет
Dialogue: 0,0:13:44.99,0:13:47.19,Default,NTP,0000,0000,0000,!Effect,Сіз бұл алаңға келуге жарамды сияқтысыз.
Dialogue: 0,0:13:47.26,0:13:48.75,Default,NTP,0000,0000,0000,!Effect,Біліктілік?
Dialogue: 0,0:13:49.63,0:13:50.79,Default,NTP,0000,0000,0000,!Effect,Сіз нені айтасыз?
Dialogue: 0,0:13:51.43,0:13:52.95,Default,NTP,0000,0000,0000,!Effect,Хмф! Алданбаңыз.
Dialogue: 0,0:13:54.50,0:13:56.30,Default,NTP,0000,0000,0000,!Effect,Раушан белгісі...
Dialogue: 0,0:14:00.17,0:14:01.26,Default,NTP,0000,0000,0000,!Effect,Күте тұрыңыз!
Dialogue: 0,0:14:03.81,0:14:06.37,Default,NTP,0000,0000,0000,!Effect,Сіз бұл не екенін білесіз бе?
Dialogue: 0,0:14:07.11,0:14:08.58,Default,NTP,0000,0000,0000,!Effect,Бұл не?
Dialogue: 0,0:14:09.15,0:14:10.88,Default,NTP,0000,0000,0000,!Effect,Раушан маркасының ресми өкілі...
Dialogue: 0,0:14:10.95,0:14:15.68,Default,NTP,0000,0000,0000,!Effect,Раушанның бұл белгісі дуэльде қыз келіншекті ала алатын дуэлисттің дәлелі болып табылады.
Dialogue: 0,0:14:15.75,0:14:17.19,Default,NTP,0000,0000,0000,!Effect,Дуэлист?
Dialogue: 0,0:14:19.36,0:14:21.12,Default,NTP,0000,0000,0000,!Effect,Мен сені аламын ба?
Dialogue: 0,0:14:21.83,0:14:23.29,Default,NTP,0000,0000,0000,!Effect,Әй, қойшы енді.
Dialogue: 0,0:14:23.36,0:14:26.66,Default,NTP,0000,0000,0000,!Effect,Раушан гүлінің белгісі болса да
Dialogue: 0,0:14:26.73,0:14:30.57,Default,NTP,0000,0000,0000,!Effect,Сіз мұны білмейсіз бе?
Dialogue: 0,0:14:37.58,0:14:38.94,Default,NTP,0000,0000,0000,!Effect,Өйткені, сіз
Dialogue: 0,0:14:39.14,0:14:42.84,Default,NTP,0000,0000,0000,!Effect,Ол дуэль серіктесі болмаған сияқты.
Dialogue: 0,0:14:46.75,0:14:50.07,Default,NTP,0000,0000,0000,!Effect,Мені осы мектепке жетелеген де осы болды.
Dialogue: 0,0:14:50.54,0:14:51.70,Default,NTP,0000,0000,0000,!Effect,...Раушан мөрі
Dialogue: 0,0:15:17.98,0:15:19.07,Default,NTP,0000,0000,0000,!Effect,Энти
Dialogue: 0,0:15:19.86,0:15:20.81,Default,NTP,0000,0000,0000,!Effect,Дайын болыңыз
Dialogue: 0,0:15:42.91,0:15:46.00,Default,NTP,0000,0000,0000,!Effect,Кеудедегі раушан гүлдерін жоғалтқан - ұтылған адам.
Dialogue: 0,0:15:46.71,0:15:48.61,Default,NTP,0000,0000,0000,!Effect,....Сенде қылыш бар ма?
Dialogue: 0,0:15:49.46,0:15:50.21,Default,NTP,0000,0000,0000,!Effect,Қылыш?
Dialogue: 0,0:15:50.55,0:15:54.11,Default,NTP,0000,0000,0000,!Effect,Сіз бұл сақина туралы шынымен білесіз бе?
Dialogue: 0,0:15:54.25,0:15:55.45,Default,NTP,0000,0000,0000,!Effect,Оны қазір алып тастауым керек пе?
Dialogue: 0,0:15:56.39,0:15:57.79,Default,NTP,0000,0000,0000,!Effect,Мен қиналып жатырмын...
Dialogue: 0,0:15:58.59,0:16:03.55,Default,NTP,0000,0000,0000,!Effect,Қылышсыз біреумен жекпе-жекке шығуға болмайды.
Dialogue: 0,0:16:05.56,0:16:06.83,Default,NTP,0000,0000,0000,!Effect,Менде қылыш бар!
Dialogue: 0,0:16:07.35,0:16:07.94,Default,NTP,0000,0000,0000,!Effect,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:16:14.71,0:16:16.26,Default,NTP,0000,0000,0000,!Effect,Шағымданатын ештеңе жоқ, солай ма?
Dialogue: 0,0:16:17.98,0:16:18.97,Default,NTP,0000,0000,0000,!Effect,Жарайды!
Dialogue: 0,0:16:26.12,0:16:28.61,Default,NTP,0000,0000,0000,!Effect,Құрметті Сайонжи, мүмкін бұл адам шынымен...
Dialogue: 0,0:16:30.82,0:16:33.08,Default,NTP,0000,0000,0000,!Effect,Қоңырау соғылғанда жекпе-жек басталады.
Dialogue: 0,0:16:33.63,0:16:35.09,Default,NTP,0000,0000,0000,!Effect,Араласпа, Энти!
Dialogue: 0,0:16:35.39,0:16:37.33,Default,NTP,0000,0000,0000,!Effect,Сүйіктіңді ұрма!
Dialogue: 0,0:16:37.40,0:16:40.73,Default,NTP,0000,0000,0000,!Effect,Ғашықты жақсы көресің бе? ол раушан қалыңдық
Dialogue: 0,0:16:40.99,0:16:45.53,Default,NTP,0000,0000,0000,!Effect,Басқаша айтқанда, мен, қазіргі дуэльдің жеңімпазы...
Dialogue: 0,0:16:45.99,0:16:47.24,Default,NTP,0000,0000,0000,!Effect,Меншік!
Dialogue: 0,0:16:47.31,0:16:49.21,Default,NTP,0000,0000,0000,!Effect,Меншік туралы не деуге болады? ?
Dialogue: 0,0:16:52.06,0:16:53.03,Default,NTP,0000,0000,0000,!Effect,Шынымен дуэль
Dialogue: 0,0:16:53.11,0:16:55.00,Default,NTP,0000,0000,0000,!Effect,Қыздармен алмасып жатырсың ба?
Dialogue: 0,0:16:55.58,0:16:57.57,Default,NTP,0000,0000,0000,!Effect,Оның сезіміне қарамастан?
Dialogue: 0,0:16:57.87,0:16:58.84,Default,NTP,0000,0000,0000,!Effect,Жауап!
Dialogue: 0,0:16:59.19,0:17:00.55,Default,NTP,0000,0000,0000,!Effect,Мына сақина кімде бар
Dialogue: 0,0:17:00.62,0:17:03.49,Default,NTP,0000,0000,0000,!Effect,Сіз шынымен де ол үшін дуласып жатырсыз ба?
Dialogue: 0,0:17:04.52,0:17:06.62,Default,NTP,0000,0000,0000,!Effect,Оның сезімі туралы не деуге болады?
Dialogue: 0,0:17:06.69,0:17:08.35,Default,NTP,0000,0000,0000,!Effect,Қазір не істеп жатырсың?
Dialogue: 0,0:17:17.77,0:17:18.63,Default,NTP,0000,0000,0000,!Effect,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:17:18.70,0:17:19.93,Default,NTP,0000,0000,0000,!Effect,Мен ештеңе білмеймін!
Dialogue: 0,0:17:20.00,0:17:21.80,Default,NTP,0000,0000,0000,!Effect,Ол раушан қалыңдық!
Dialogue: 0,0:17:21.87,0:17:24.14,Default,NTP,0000,0000,0000,!Effect,Түсінбейтін сенсің!
Dialogue: 0,0:17:24.21,0:17:24.97,Default,NTP,0000,0000,0000,!Effect,Не?
Dialogue: 0,0:17:25.04,0:17:27.27,Default,NTP,0000,0000,0000,!Effect,Дуэльде алмасты
Dialogue: 0,0:17:27.35,0:17:30.71,Default,NTP,0000,0000,0000,!Effect,Бақытты қыздар бар ма? !
Dialogue: 0,0:17:30.78,0:17:32.15,Default,NTP,0000,0000,0000,!Effect,Иә! !
Dialogue: 0,0:17:37.96,0:17:38.98,Default,NTP,0000,0000,0000,!Effect,...сіз
Dialogue: 0,0:17:39.06,0:17:40.52,Default,NTP,0000,0000,0000,!Effect,Сіз әйелсіз бе?
Dialogue: 0,0:17:40.59,0:17:43.43,Default,NTP,0000,0000,0000,!Effect,Еркек деп айтқаным есімде жоқ!
Dialogue: 0,0:17:43.97,0:17:44.75,Default,NTP,0000,0000,0000,!Effect,Юкине-кун, барсың ба?
Dialogue: 0,0:17:44.83,0:17:48.70,Default,NTP,0000,0000,0000,!Effect,Мен әйелді ұрған адамға ешқашан жеңілмеймін! !
Dialogue: 0,0:17:49.27,0:17:51.20,Default,NTP,0000,0000,0000,!Effect,Күн деп атаймыз
Dialogue: 0,0:17:51.27,0:17:54.26,Default,NTP,0000,0000,0000,!Effect,Сен ештеңе түсінбейсің ғой!
Dialogue: 0,0:17:55.77,0:17:57.17,Default,NTP,0000,0000,0000,!Effect,Міне! !
Dialogue: 0,0:17:59.83,0:18:00.64,Default,NTP,0000,0000,0000,!Effect,Энти! ?
Dialogue: 0,0:18:01.44,0:18:04.80,Default,NTP,0000,0000,0000,!Effect,Қылышсыз дуэльге рұқсат етілмейді.
Dialogue: 0,0:18:29.17,0:18:30.20,Default,NTP,0000,0000,0000,!Effect,Қылыш...
Dialogue: 0,0:20:09.67,0:20:10.34,Default,NTP,0000,0000,0000,!Effect,Who?
Dialogue: 0,0:20:10.54,0:20:12.80,Default,NTP,0000,0000,0000,!Effect,I. Химемия Энти
Dialogue: 0,0:20:14.10,0:20:14.90,Default,NTP,0000,0000,0000,!Effect,Қайырлы кеш
Dialogue: 0,0:20:18.31,0:20:20.80,Default,NTP,0000,0000,0000,!Effect,Жаңа ғана көшіп келдің, жинап жатырсың ба?
Dialogue: 0,0:20:21.37,0:20:22.92,Default,NTP,0000,0000,0000,!Effect,Мен ұйықтайын деп қалдым.
Dialogue: 0,0:20:22.93,0:20:25.84,Default,NTP,0000,0000,0000,!Effect,Менің бөлмеме адамдарды шақырмау саясаты бар.
Dialogue: 0,0:20:26.54,0:20:28.66,Default,NTP,0000,0000,0000,!Effect,Ал, бүгін кештен аулақ болайық.
Dialogue: 0,0:20:38.30,0:20:39.63,Default,NTP,0000,0000,0000,!Effect,Иә…♡
Dialogue: 0,0:20:39.84,0:20:41.80,Default,NTP,0000,0000,0000,!Effect,Мен сені осылай үйге жібере алмаймын, солай ма?
Dialogue: 0,0:20:42.27,0:20:43.93,Default,NTP,0000,0000,0000,!Effect,Дұрыс па, солай емес пе?
Dialogue: 0,0:20:47.15,0:20:48.31,Default,NTP,0000,0000,0000,!Effect,Бұл не?
Dialogue: 0,0:20:48.87,0:20:51.82,Default,NTP,0000,0000,0000,!Effect,Раушан белгісі. Сіз білесіз бе?
Dialogue: 0,0:20:53.33,0:20:58.28,Default,NTP,0000,0000,0000,!Effect,Егер сізде бар болса, сіз дуэльге қатыса аласыз.
Dialogue: 0,0:20:58.49,0:21:00.75,Default,NTP,0000,0000,0000,!Effect,Сол Сайонджи жігіті
Dialogue: 0,0:21:00.83,0:21:05.19,Default,NTP,0000,0000,0000,!Effect,Ол сені қалайтынын айтты және бәрімен айтысады...
Dialogue: 0,0:21:05.34,0:21:08.37,Default,NTP,0000,0000,0000,!Effect,Енді сені алған соң не істейміз?
Dialogue: 0,0:21:10.84,0:21:12.89,Default,NTP,0000,0000,0000,!Effect,Біртүрлі адам....
Dialogue: 0,0:21:13.07,0:21:15.60,Default,NTP,0000,0000,0000,!Effect,Тенчжоу Утена, м...
Dialogue: 0,0:21:17.58,0:21:18.63,Default,NTP,0000,0000,0000,!Effect,Утена жақсы
Dialogue: 0,0:21:18.71,0:21:21.68,Default,NTP,0000,0000,0000,!Effect,Иә. Құрметпен Утена
Dialogue: 0,0:21:21.75,0:21:25.11,Default,NTP,0000,0000,0000,!Effect,Біз жақсы болатын сияқтымыз.
Dialogue: 0,0:21:27.82,0:21:30.91,Default,NTP,0000,0000,0000,!Effect,Бұл дуэльде жеңген жігітте әрқашан бола ма?
Dialogue: 0,0:21:31.22,0:21:32.71,Default,NTP,0000,0000,0000,!Effect,Мен раушан гүлінің келінімін
Dialogue: 0,0:21:33.35,0:21:36.37,Default,NTP,0000,0000,0000,!Effect,Қатысушының қалағанын жасауы өз еркінде.
Dialogue: 0,0:21:39.66,0:21:41.26,Default,NTP,0000,0000,0000,!Effect,Бұл жұқа.
Dialogue: 0,0:21:47.81,0:21:48.77,Default,NTP,0000,0000,0000,!Effect,Тоқта!
Dialogue: 0,0:21:50.44,0:21:51.64,Default,NTP,0000,0000,0000,!Effect,Спектакль аяқталды
Dialogue: 0,0:21:51.90,0:21:53.36,Default,NTP,0000,0000,0000,!Effect,Тез бөлмеңе қайт!
Dialogue: 0,0:21:57.88,0:21:58.81,Default,NTP,0000,0000,0000,!Effect,О, менің
Dialogue: 0,0:21:59.94,0:22:01.44,Default,NTP,0000,0000,0000,!Effect,Көптеген сүйкімді киімдер
Dialogue: 0,0:22:01.64,0:22:04.39,Default,NTP,0000,0000,0000,!Effect,Сонымен не? Сізде шағымданатын нәрсе бар ма?
Dialogue: 0,0:22:04.56,0:22:05.65,Default,NTP,0000,0000,0000,!Effect,Жоқ
Dialogue: 0,0:22:07.04,0:22:08.02,Default,NTP,0000,0000,0000,!Effect,Тоқта!
Dialogue: 0,0:22:12.96,0:22:14.49,Default,NTP,0000,0000,0000,!Effect,Мен ойладым...
Dialogue: 0,0:22:14.80,0:22:16.60,Default,NTP,0000,0000,0000,!Effect,Эй, сен біртүрлі екенсің.
Dialogue: 0,0:22:18.84,0:22:22.33,Default,NTP,0000,0000,0000,!Effect,Әлгі жігіт... біртүрлі екен.
Dialogue: 0,0:22:24.03,0:22:26.61,Default,NTP,0000,0000,0000,!Effect,Не? Сіз тағы да ханзада туралы айтып отырсыз ба?
Dialogue: 0,0:22:26.84,0:22:27.91,Default,NTP,0000,0000,0000,!Effect,Иә
Dialogue: 0,0:22:28.06,0:22:30.99,Default,NTP,0000,0000,0000,!Effect,Қыз енді ханзададай киінген
Dialogue: 0,0:22:32.11,0:22:35.99,Default,NTP,0000,0000,0000,!Effect,Бірақ сен әлі де ханзада сарайын армандайтыныңа сенімдімін
Dialogue: 0,0:22:36.05,0:22:38.11,Default,NTP,0000,0000,0000,!Effect,Ойлап қарасам, мен де сонда болдым.
Dialogue: 0,0:22:38.29,0:22:39.58,Default,NTP,0000,0000,0000,!Effect,Ханзада
Dialogue: 0,0:22:41.49,0:22:44.00,Default,NTP,0000,0000,0000,!Effect,Бірақ ханзада өлді.
Dialogue: 0,0:22:45.18,0:22:48.20,Default,NTP,0000,0000,0000,!Effect,Мені бала күнгі досым қыз өлтірді.
Dialogue: 0,0:22:50.03,0:22:53.42,Default,NTP,0000,0000,0000,!Effect,Өйткені оны ханзада ұнатып қалды
Dialogue: 0,0:22:53.60,0:22:55.47,Default,NTP,0000,0000,0000,!Effect,Ол қайықтан құлаған кезде
Dialogue: 0,0:22:55.73,0:22:59.09,Default,NTP,0000,0000,0000,!Effect,Мен оны құтқардым, мені сыпырып алып кетті.
Dialogue: 0,0:23:01.58,0:23:03.10,Default,NTP,0000,0000,0000,!Effect,...ақымақ көрінеді
Dialogue: 0,0:23:03.41,0:23:07.18,Default,NTP,0000,0000,0000,!Effect,Мен ханзадамен жалғыз қалуым керек еді.
Dialogue: 0,0:23:07.39,0:23:09.62,Default,NTP,0000,0000,0000,!Effect,Ханзада кетті.
Dialogue: 0,0:23:12.76,0:23:15.18,Default,NTP,0000,0000,0000,!Effect,...Сондықтан мен сені ешқашан кешірмеймін
Dialogue: 0,0:23:15.97,0:23:18.77,Default,NTP,0000,0000,0000,!Effect,Мен саған өмір бойы ханзада болуға рұқсат етемін.
Dialogue: 0,0:23:41.24,0:23:44.01,Default,NTP,0000,0000,0000,!Effect,Эй, Вакаба, тоқта!
Dialogue: 0,0:24:01.17,0:24:03.97,Default,NTP,0000,0000,0000,!Effect,Мен сені дуист ретінде таңдайды деп күтпедім.
Dialogue: 0,0:24:07.71,0:24:12.17,Default,NTP,0000,0000,0000,!Effect,Сіз бұл сақина сізді осы мектепке әкелді деп айттыңыз.
Dialogue: 0,0:24:12.25,0:24:13.97,Default,NTP,0000,0000,0000,!Effect,Олай болса, сен де.
Dialogue: 0,0:24:15.13,0:24:16.75,Default,NTP,0000,0000,0000,!Effect,Сіз оны көздеп отырсыз ба?
Dialogue: 0,0:24:17.39,0:24:18.69,Default,NTP,0000,0000,0000,!Effect,Міне осылай болады.
Dialogue: 0,0:24:19.31,0:24:20.16,Default,NTP,0000,0000,0000,!Effect,(Номудың айғайы)
Dialogue: 0,0:24:20.22,0:24:23.35,Default,NTP,0000,0000,0000,!Effect,Неліктен? Әрине, ол тартымды
Dialogue: 0,0:24:25.63,0:24:28.43,Default,NTP,0000,0000,0000,!Effect,Оның қандай қыз екенін білесің бе?
Dialogue: 0,0:24:28.69,0:24:29.78,Default,NTP,0000,0000,0000,!Effect,Ол қандай бала?
Dialogue: 0,0:24:30.90,0:24:32.33,Default,NTP,0000,0000,0000,!Effect,Бұл бала біртүрлі екен.
Dialogue: 0,0:24:32.44,0:24:33.00,Default,NTP,0000,0000,0000,!Effect,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:24:33.04,0:24:34.00,Default,NTP,0000,0000,0000,!Effect,Өйткені
Dialogue: 0,0:24:34.14,0:24:37.38,Default,NTP,0000,0000,0000,!Effect,Сол қыз дуэльде кім жеңсе, сол қыз төбелеседі...
Dialogue: 0,0:24:38.18,0:24:39.37,Default,NTP,0000,0000,0000,!Effect,Не?
Dialogue: 0,0:24:41.05,0:24:43.71,Default,NTP,0000,0000,0000,!Effect,Ол раушан түсті қалыңдық
Dialogue: 0,0:24:43.78,0:24:47.55,Default,NTP,0000,0000,0000,!Effect,Әрине, сіз араласатын адаммен түнейсіз.
Dialogue: 0,0:24:47.80,0:24:50.35,Default,NTP,0000,0000,0000,!Effect,Сіз дуэльді жеңіп көрдіңіз бе?
Dialogue: 0,0:24:52.56,0:24:54.58,Default,NTP,0000,0000,0000,!Effect,Ал Химемия мен келісімге келер болсақ...
Dialogue: 0,0:24:54.66,0:24:57.06,Default,NTP,0000,0000,0000,!Effect,Мұның сізге еш қатысы жоқ, солай ма?
Dialogue: 0,0:24:59.90,0:25:00.99,Default,NTP,0000,0000,0000,!Effect,Химемия Энти!
Dialogue: 0,0:25:04.54,0:25:06.16,Default,NTP,0000,0000,0000,!Effect,Онда!
Dialogue: 0,0:25:12.34,0:25:13.67,Default,NTP,0000,0000,0000,!Effect,Бүгін түнде не істейміз?
Dialogue: 0,0:25:14.88,0:25:16.11,Default,NTP,0000,0000,0000,!Effect,Сен де кеше бардың ғой, солай ма?
Dialogue: 0,0:25:16.35,0:25:18.51,Default,NTP,0000,0000,0000,!Effect,Раушан келінге қызықпаймын.
Dialogue: 0,0:25:18.82,0:25:19.48,Default,NTP,0000,0000,0000,!Effect,Иә
Dialogue: 0,0:25:19.55,0:25:21.61,Default,NTP,0000,0000,0000,!Effect,Мен сені алу үшін қиналсам да
Dialogue: 0,0:25:21.69,0:25:23.02,Default,NTP,0000,0000,0000,!Effect,Қандай қызықсыз ханзада.
Dialogue: 0,0:25:23.09,0:25:24.28,Default,NTP,0000,0000,0000,!Effect,Бұл дұрыс.
Dialogue: 0,0:25:31.00,0:25:32.16,Default,NTP,0000,0000,0000,!Effect,О, менің...
Dialogue: 0,0:25:32.93,0:25:35.46,Default,NTP,0000,0000,0000,!Effect,Қараңызшы, бұл өте ылғалды...
Dialogue: 0,0:25:35.53,0:25:39.23,Default,NTP,0000,0000,0000,!Effect,Бассейнде сулану мүмкін емес.
Dialogue: 0,0:25:39.37,0:25:41.30,Default,NTP,0000,0000,0000,!Effect,Егер Туга-сенпай...
Dialogue: 0,0:25:47.68,0:25:53.08,Default,NTP,0000,0000,0000,!Effect,Хм... Қызық, апам Раушан ханзаданы неге қамап қойды?
Dialogue: 0,0:25:57.36,0:26:01.26,Default,NTP,0000,0000,0000,!Effect,Әйтеуір, адамдар ішке кіре бастады.
Dialogue: 0,0:26:01.33,0:26:03.09,Default,NTP,0000,0000,0000,!Effect,Бұл қиын болды.
Dialogue: 0,0:26:11.54,0:26:12.78,Default,NTP,0000,0000,0000,!Effect,Есікті аш!
Dialogue: 0,0:26:13.17,0:26:14.67,Default,NTP,0000,0000,0000,!Effect,Маған ханзаданы қайтар!
Dialogue: 0,0:26:15.04,0:26:16.17,Default,NTP,0000,0000,0000,!Effect,Оны ашыңыз! Ведьма!
Dialogue: 0,0:26:16.24,0:26:18.17,Default,NTP,0000,0000,0000,!Effect,Ведьма!
Dialogue: 0,0:26:18.24,0:26:21.30,Default,NTP,0000,0000,0000,!Effect,Ведьма!
Dialogue: 0,0:26:23.38,0:26:27.92,Default,NTP,0000,0000,0000,!Effect,Менің әпкем шынымен бақсы. Сондықтан оның сиқырлы күштері болды
Dialogue: 0,0:26:28.52,0:26:32.42,Default,NTP,0000,0000,0000,!Effect,Бірақ мен барлығынан жасырған тағы бір нәрсе бар.
Dialogue: 0,0:26:33.29,0:26:34.81,Default,NTP,0000,0000,0000,!Effect,Не ол?
Dialogue: 0,0:26:35.29,0:26:37.39,Default,NTP,0000,0000,0000,!Effect,Раушан ханзаданың шынайы тұлғасы қандай?
Dialogue: 0,0:26:37.66,0:26:40.33,Default,NTP,0000,0000,0000,!Effect,Шын мәнінде, бұл Шыбындардың Иесі болды.
Dialogue: 0,0:26:40.66,0:26:41.96,Default,NTP,0000,0000,0000,!Effect,Бақсы болған апам
Dialogue: 0,0:26:42.03,0:26:44.16,Default,NTP,0000,0000,0000,!Effect,Ол мені сиқырлы күші бар ханзадаға айналдырды.
Dialogue: 0,0:26:45.40,0:26:46.13,Default,NTP,0000,0000,0000,!Effect,Сонымен
Dialogue: 0,0:26:46.20,0:26:48.14,Default,NTP,0000,0000,0000,!Effect,Әпкемнің сиқыры кеткенде
Dialogue: 0,0:26:48.34,0:26:51.07,Default,NTP,0000,0000,0000,!Effect,Ханзада да өзінің бастапқы түріне оралды.
Dialogue: 0,0:26:53.61,0:26:58.45,Default,NTP,0000,0000,0000,!Effect,Сонымен, жоғалтқан сиқырлы күшке ие болу үшін, сіз
Dialogue: 0,0:26:58.93,0:27:00.68,Default,NTP,0000,0000,0000,!Effect,Сонымен, сіз бұл ойынды орнаттыңыз ба?
Dialogue: 0,0:27:01.41,0:27:01.95,Default,NTP,0000,0000,0000,!Effect,Бірақ
Dialogue: 0,0:27:02.22,0:27:04.99,Default,NTP,0000,0000,0000,!Effect,Соңында алатын адам менмін.
Dialogue: 0,0:27:06.04,0:27:08.72,Default,NTP,0000,0000,0000,!Effect,...Не алуға тырысып жатырсың?
Dialogue: 0,0:27:10.32,0:27:11.35,Default,NTP,0000,0000,0000,!Effect,Не?
Dialogue: 0,0:27:11.43,0:27:12.74,Default,NTP,0000,0000,0000,!Effect,Оны жасырмаңыз
Dialogue: 0,0:27:13.44,0:27:15.76,Default,NTP,0000,0000,0000,!Effect,Сіз мен білмейтін нәрсені істеп жатырсыз.
Dialogue: 0,0:27:15.83,0:27:17.56,Default,NTP,0000,0000,0000,!Effect,...Қозғалмаңыз!
Dialogue: 0,0:27:23.11,0:27:26.58,Default,NTP,0000,0000,0000,!Effect,Мен бірге уақыт өткізген бақшаға қайта бара алмаймын.
Dialogue: 0,0:27:27.75,0:27:28.60,Default,NTP,0000,0000,0000,!Effect,Бірақ
Dialogue: 0,0:27:28.83,0:27:31.73,Default,NTP,0000,0000,0000,!Effect,Мен сені әрқашан қастерлеймін. ! !
Dialogue: 0,0:27:40.34,0:27:41.62,Default,NTP,0000,0000,0000,!Effect,Сатқын!
Dialogue: 0,0:27:52.30,0:27:55.00,Default,NTP,0000,0000,0000,!Effect,Қайда бара жатырсың? Осындай уақытта...
Dialogue: 0,0:27:56.87,0:27:58.60,Default,NTP,0000,0000,0000,!Effect,Раушан қалыңдық...
Dialogue: 0,0:28:01.71,0:28:04.47,Default,NTP,0000,0000,0000,!Effect,Бала кезімде әкем бұйырған
Dialogue: 0,0:28:04.48,0:28:05.65,Default,NTP,0000,0000,0000,!Effect,Мен шашымды ұзын етіп өсірдім
Dialogue: 0,0:28:06.44,0:28:08.41,Default,NTP,0000,0000,0000,!Effect,Бұл басқа адамның қалауы болды.
Dialogue: 0,0:28:08.67,0:28:09.35,Default,NTP,0000,0000,0000,!Effect,Қарсылас?
Dialogue: 0,0:28:09.42,0:28:10.98,Default,NTP,0000,0000,0000,!Effect,Менің қазіргі әкем
Dialogue: 0,0:28:11.29,0:28:13.88,Default,NTP,0000,0000,0000,!Effect,Мен сатылып кетті
Dialogue: 0,0:28:35.11,0:28:36.93,Default,NTP,0000,0000,0000,!Effect,...Мен көп нәрсені жоғалттым, бірақ
Dialogue: 0,0:28:37.54,0:28:41.08,Default,NTP,0000,0000,0000,!Effect,Сіздің арқаңызда мен осы мектептің дуэльдік ойынына қатыса алдым.
Dialogue: 0,0:28:48.46,0:28:50.02,Default,NTP,0000,0000,0000,!Effect,Сіз жеңе аласыз, солай ма?
Dialogue: 0,0:28:50.49,0:28:52.99,Default,NTP,0000,0000,0000,!Effect,....Мен Юриден жеңілмеймін!
Dialogue: 0,0:28:53.33,0:28:54.70,Default,NTP,0000,0000,0000,!Effect,Юри?
Dialogue: 0,0:28:55.48,0:28:56.46,Default,NTP,0000,0000,0000,!Effect,Өйткені
Dialogue: 0,0:28:56.53,0:28:58.23,Default,NTP,0000,0000,0000,!Effect,Әлгі жігіт жиіркенішті.
Dialogue: 0,0:28:58.68,0:29:00.94,Default,NTP,0000,0000,0000,!Effect,Менің ойымша, ешкім білмейді.
Dialogue: 0,0:29:01.07,0:29:02.72,Default,NTP,0000,0000,0000,!Effect,Оны мен ғана көрдім
Dialogue: 0,0:29:03.30,0:29:04.14,Default,NTP,0000,0000,0000,!Effect,Не? Не?
Dialogue: 0,0:29:09.68,0:29:12.41,Default,NTP,0000,0000,0000,!Effect,...Ол үнемі кулон тағып жүреді, солай ма?
Dialogue: 0,0:29:12.48,0:29:15.15,Default,NTP,0000,0000,0000,!Effect,Менің суретімді сол шкафтың ішіне сал
Dialogue: 0,0:29:15.22,0:29:17.78,Default,NTP,0000,0000,0000,!Effect,Жалғыз қарау
Dialogue: 0,0:29:22.69,0:29:24.72,Default,NTP,0000,0000,0000,!Effect,Мен қазірдің өзінде құсып бара жатқандай сезінемін.
Dialogue: 0,0:29:24.80,0:29:28.42,Default,NTP,0000,0000,0000,!Effect,Бұл өсек-аяңға айналып, көп әбігерге түсуде.
Dialogue: 0,0:29:31.77,0:29:35.73,Default,NTP,0000,0000,0000,!Effect,Мен бұл қауесетті кім таратқан деп ойлаймын.
Dialogue: 0,0:30:16.88,0:30:18.30,Default,NTP,0000,0000,0000,!Effect,...дуэльде жеңіңіз
Dialogue: 0,0:30:18.61,0:30:20.54,Default,NTP,0000,0000,0000,!Effect,Юриді жазалаңыз.
Dialogue: 0,0:30:22.05,0:30:23.11,Default,NTP,0000,0000,0000,!Effect,Бұл шынымен де…
Dialogue: 0,0:30:27.42,0:30:29.68,Default,NTP,0000,0000,0000,!Effect,Мен жекпе-жекте жеңіске жетуге ниеттемін.
Dialogue: 0,0:30:30.87,0:30:32.69,Default,NTP,0000,0000,0000,!Effect,Сен Юриге қорқынышты ештеңе істей алмайсың.
Dialogue: 0,0:30:35.53,0:30:36.50,Default,NTP,0000,0000,0000,!Effect,.....Неге! ?
Dialogue: 0,0:30:38.44,0:30:41.93,Default,NTP,0000,0000,0000,!Effect,Дуэлисттердің талпынысы жоғары.
Dialogue: 0,0:30:58.76,0:31:02.35,Default,NTP,0000,0000,0000,!Effect,Бұл қараңғылықтың тереңдігі дүниенің соңына дейін жалғасады
Dialogue: 0,0:31:02.52,0:31:03.83,Default,NTP,0000,0000,0000,!Effect,Бұл қорқынышты.
Dialogue: 0,0:31:04.60,0:31:06.06,Default,NTP,0000,0000,0000,!Effect,Мен оған тартылатын сияқтымын.
Dialogue: 0,0:31:17.64,0:31:20.80,Default,NTP,0000,0000,0000,!Effect,Басталғалы жатыр. Революция...!
Dialogue: 0,0:31:24.62,0:31:26.41,Default,NTP,0000,0000,0000,!Effect,Неліктен сен дуэлистсің?
Dialogue: 0,0:31:27.89,0:31:29.85,Default,NTP,0000,0000,0000,!Effect,Әрине, мені таңдағандықтан.
Dialogue: 0,0:31:30.32,0:31:32.88,Default,NTP,0000,0000,0000,!Effect,Бірақ сіз бас тарта аласыз, солай ма?
Dialogue: 0,0:31:34.76,0:31:38.99,Default,NTP,0000,0000,0000,!Effect,Мен әрқашан қолымда күшті күш болғанын қалаймын.
Dialogue: 0,0:31:39.06,0:31:40.33,Default,NTP,0000,0000,0000,!Effect,Бұл ұл бала.
Dialogue: 0,0:31:45.96,0:31:47.17,Default,NTP,0000,0000,0000,!Effect,Юри - бұл
Dialogue: 0,0:31:47.39,0:31:49.70,Default,NTP,0000,0000,0000,!Effect,Раушан келінді қатты жек көрсең де
Dialogue: 0,0:31:50.26,0:31:52.70,Default,NTP,0000,0000,0000,!Effect,Бұл ойынға не үшін қосылдың?
Dialogue: 0,0:31:52.78,0:31:56.64,Default,NTP,0000,0000,0000,!Effect,Мен күш бәрін жойғанын қалаймын
Dialogue: 0,0:31:56.91,0:31:58.00,Default,NTP,0000,0000,0000,!Effect,Барлығы дегенді қалай түсінесіңдер?
Dialogue: 0,0:31:58.54,0:32:00.78,Default,NTP,0000,0000,0000,!Effect,Мені байланыстыратынның бәрі
Dialogue: 0,0:32:05.04,0:32:06.79,Default,NTP,0000,0000,0000,!Effect,....Екеуміз ғана болсақ та.
Dialogue: 0,0:32:07.02,0:32:09.16,Default,NTP,0000,0000,0000,!Effect,Бұл қызықсыз тақырып.
Dialogue: 0,0:32:36.52,0:32:37.49,Default,NTP,0000,0000,0000,!Effect,Шиори!
Dialogue: 0,0:32:39.12,0:32:41.89,Default,NTP,0000,0000,0000,!Effect,Мұнда жалпы студенттерге кіруге рұқсат етілмейді.
Dialogue: 0,0:32:42.06,0:32:43.26,Default,NTP,0000,0000,0000,!Effect,Кешіріңіз
Dialogue: 0,0:32:43.59,0:32:45.09,Default,NTP,0000,0000,0000,!Effect,Мен сізді алаңдатып отырмын ба?
Dialogue: 0,0:32:45.34,0:32:47.13,Default,NTP,0000,0000,0000,!Effect,Осы сағатта не болды?
Dialogue: 0,0:32:47.33,0:32:49.64,Default,NTP,0000,0000,0000,!Effect,Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:32:50.85,0:32:53.35,Default,NTP,0000,0000,0000,!Effect,Неге екені белгісіз Джури-санның түрін көргім келді.
Dialogue: 0,0:32:53.39,0:32:54.53,Default,NTP,0000,0000,0000,!Effect,Бірдеңе болды ма?
Dialogue: 0,0:33:03.71,0:33:06.56,Default,NTP,0000,0000,0000,!Effect,Юри-сан, сен дуэлистсің, солай ма?
Dialogue: 0,0:33:07.79,0:33:09.71,Default,NTP,0000,0000,0000,!Effect,Сіз мұны қайдан білесіз?
Dialogue: 0,0:33:09.89,0:33:12.05,Default,NTP,0000,0000,0000,!Effect,Мен де көп нәрсені білемін.
Dialogue: 0,0:33:13.76,0:33:14.85,Default,NTP,0000,0000,0000,!Effect,Оны осылай созып, салбыратып қой.
Dialogue: 0,0:33:16.56,0:33:17.72,Default,NTP,0000,0000,0000,!Effect,Бұл шексіз тұйық
Dialogue: 0,0:33:17.80,0:33:20.23,Default,NTP,0000,0000,0000,!Effect,Тенжоу Утена есімді бала туралы.
Dialogue: 0,0:33:20.30,0:33:21.73,Default,NTP,0000,0000,0000,!Effect,Сен не білесің?
Dialogue: 0,0:33:21.87,0:33:24.83,Default,NTP,0000,0000,0000,!Effect,Сол қыз Туга-сенпайды жақсы көреді.
Dialogue: 0,0:33:25.01,0:33:29.28,Default,NTP,0000,0000,0000,!Effect,Сол себепті дуалист болу үшін қыңыр әрекет жасап, еркекше киініп жүр.
Dialogue: 0,0:33:30.26,0:33:33.04,Default,NTP,0000,0000,0000,!Effect,Еркектерге әуестеніп, ханзада болып жүрсің бе?
Dialogue: 0,0:33:33.11,0:33:36.06,Default,NTP,0000,0000,0000,!Effect,Мұндай адамның әлемге төңкеріс жасайтын күші болуы үшін?
Dialogue: 0,0:33:36.06,0:33:37.44,Default,NTP,0000,0000,0000,!Effect,Сіз қателесесіз.
Dialogue: 0,0:33:37.61,0:33:39.91,Default,NTP,0000,0000,0000,!Effect,Ол күлкілі емес.
Dialogue: 0,0:33:40.15,0:33:41.14,Default,NTP,0000,0000,0000,!Effect,Сіз жеңе аласыз, солай ма?
Dialogue: 0,0:33:41.30,0:33:43.13,Default,NTP,0000,0000,0000,!Effect,Жеңімпаз - Юри, солай ма?
Dialogue: 0,0:33:44.45,0:33:47.25,Default,NTP,0000,0000,0000,!Effect,Мен сені келесі жекпе-жекте жеңемін.
Dialogue: 0,0:33:48.93,0:33:53.02,Default,NTP,0000,0000,0000,!Effect,Юриді не байланыстырады...
Dialogue: 0,0:34:32.54,0:34:33.43,Default,NTP,0000,0000,0000,!Effect,Утена?
Dialogue: 0,0:34:34.41,0:34:36.14,Default,NTP,0000,0000,0000,!Effect,Бұл сағатта не болды?
Dialogue: 0,0:34:37.24,0:34:39.51,Default,NTP,0000,0000,0000,!Effect,Осындай уақытта раушан гүлдеріне қалай қамқорлық жасай аласыз?
Dialogue: 0,0:34:39.58,0:34:41.63,Default,NTP,0000,0000,0000,!Effect,Өйткені мен раушан гүлінің келінімін
Dialogue: 0,0:34:46.68,0:34:47.81,Default,NTP,0000,0000,0000,!Effect,Басқа нәрсе
Dialogue: 0,0:34:47.81,0:34:50.21,Default,NTP,0000,0000,0000,!Effect,Сіз мені ренжітетін бірдеңе айттыңыз деп ойлаймын.
Dialogue: 0,0:34:53.22,0:34:54.45,Default,NTP,0000,0000,0000,!Effect,Ол басқа Титанға шабуыл жасайды; бізге мүлде қызықпайды
Dialogue: 0,0:34:54.52,0:34:58.08,Default,NTP,0000,0000,0000,!Effect,Дуэльді жеңген жігіт кім болса да солай істей ме?
Dialogue: 0,0:34:58.60,0:34:59.80,Default,NTP,0000,0000,0000,!Effect,Бұл туралы не деуге болады?
Dialogue: 0,0:35:00.50,0:35:03.90,Default,NTP,0000,0000,0000,!Effect,Мүмкін сізге Кирю-сенпай қызық шығар?
Dialogue: 0,0:35:04.53,0:35:06.54,Default,NTP,0000,0000,0000,!Effect,Сіз, ол туралы...
Dialogue: 0,0:35:06.54,0:35:07.56,Default,NTP,0000,0000,0000,!Effect,Шулы! ! ! !
Dialogue: 0,0:35:09.01,0:35:10.00,Default,NTP,0000,0000,0000,!Effect,Сіз не істеп жатырсыз?
Dialogue: 0,0:35:10.44,0:35:11.24,Default,NTP,0000,0000,0000,!Effect,Бұл сенсің!
Dialogue: 0,0:35:11.44,0:35:12.46,Default,NTP,0000,0000,0000,!Effect,Қысқы бүршік...
Dialogue: 0,0:35:13.86,0:35:15.71,Default,NTP,0000,0000,0000,!Effect,Фуюбудқа біртүрлі болып қалған не болды?
Dialogue: 0,0:35:16.15,0:35:17.07,Default,NTP,0000,0000,0000,!Effect,Менің ойымша....
Dialogue: 0,0:35:18.69,0:35:21.48,Default,NTP,0000,0000,0000,!Effect,Сіз... дұрыс па?
Dialogue: 0,0:35:26.89,0:35:29.22,Default,NTP,0000,0000,0000,!Effect,Мен сені жанымда болар деп ойладым...
Dialogue: 0,0:35:30.49,0:35:33.49,Default,NTP,0000,0000,0000,!Effect,Әкем мен шешем кеткенде де сен сонда болдың...
Dialogue: 0,0:35:34.06,0:35:38.43,Default,NTP,0000,0000,0000,!Effect,....Сен әрқашан жанымда болады деп ойладым...
Dialogue: 0,0:35:40.60,0:35:43.16,Default,NTP,0000,0000,0000,!Effect,Бұдан былай біз мәңгі бірге боламыз
Dialogue: 0,0:35:44.71,0:35:47.20,Default,NTP,0000,0000,0000,!Effect,Жұлдыздарға қарайық дедім...
Dialogue: 0,0:35:47.71,0:35:48.64,Default,NTP,0000,0000,0000,!Effect,Жұлдыз?
Dialogue: 0,0:35:49.28,0:35:50.91,Default,NTP,0000,0000,0000,!Effect,Қандай ханзада...
Dialogue: 0,0:35:51.58,0:35:52.98,Default,NTP,0000,0000,0000,!Effect,Ешқайсысы жоқ.
Dialogue: 0,0:37:14.97,0:37:16.23,Default,NTP,0000,0000,0000,!Effect,Химемия....
Dialogue: 0,0:39:28.43,0:39:31.47,Default,NTP,0000,0000,0000,!Effect,Иә! назар аударыңыз! назар аударыңыз!
Dialogue: 0,0:39:32.07,0:39:36.02,Default,NTP,0000,0000,0000,!Effect,Енді жұппен Жаратқан Иенің суретін салыңдар.
Dialogue: 0,0:39:36.91,0:39:39.37,Default,NTP,0000,0000,0000,!Effect,Әдепті болуға тырыспаңыз
Dialogue: 0,0:39:39.44,0:39:42.73,Default,NTP,0000,0000,0000,!Effect,Басқа адамның болмысын жақсы түсіру керек.
Dialogue: 0,0:39:43.67,0:39:46.66,Default,NTP,0000,0000,0000,!Effect,Бүгін ауа-райы жақсы, сондықтан мен палатаның сыртына шығуға қарсы емеспін.
Dialogue: 0,0:39:57.08,0:39:57.99,Default,NTP,0000,0000,0000,!Effect,Химемия?
Dialogue: 0,0:40:00.06,0:40:01.29,Default,NTP,0000,0000,0000,!Effect,Күте тұрыңыз, Химемия...
Dialogue: 0,0:40:02.63,0:40:04.33,Default,NTP,0000,0000,0000,!Effect,Егер күтсеңіз
Dialogue: 0,0:40:04.94,0:40:07.46,Default,NTP,0000,0000,0000,!Effect,，…
Dialogue: 0,0:40:08.14,0:40:10.27,Default,NTP,0000,0000,0000,!Effect,Химемия! ! ! !
Dialogue: 0,0:40:23.45,0:40:25.74,Default,NTP,0000,0000,0000,!Effect,Мұның үстінде бақылау бөлмесі бар.
Dialogue: 0,0:40:30.09,0:40:32.46,Default,NTP,0000,0000,0000,!Effect,Жарайды ма? Осындай жерге барсам да...
Dialogue: 0,0:40:32.69,0:40:35.19,Default,NTP,0000,0000,0000,!Effect,Жарайды ~ оны ешкім кимейді.
Dialogue: 0,0:40:40.72,0:40:42.49,Default,NTP,0000,0000,0000,!Effect,Керемет көрініс
Dialogue: 0,0:41:07.83,0:41:09.36,Default,NTP,0000,0000,0000,!Effect,Кеш үшін кешіріңіз.
Dialogue: 0,0:41:09.90,0:41:10.75,Default,NTP,0000,0000,0000,!Effect,Рахмет
Dialogue: 0,0:41:11.52,0:41:12.32,Default,NTP,0000,0000,0000,!Effect,Не?
Dialogue: 0,0:41:12.84,0:41:17.54,Default,NTP,0000,0000,0000,!Effect,Мұндай жаман сөздерді айтпа. Мен өз сезімімді біржақты білдіргендей болдым.
Dialogue: 0,0:41:17.84,0:41:19.80,Default,NTP,0000,0000,0000,!Effect,Бірақ сен мен үшін осындасың...
Dialogue: 0,0:41:19.62,0:41:23.15,DefaultL2,NTP,0000,0000,0000,!Effect,Қарсы емес. сен менімен айналысасың
Dialogue: 0,0:41:23.75,0:41:24.67,Default,NTP,0000,0000,0000,!Effect,Сіз білесіз...
Dialogue: 0,0:41:25.19,0:41:27.90,Default,NTP,0000,0000,0000,!Effect,Өтінемін, «қатысу» сияқты сөздерді тоқтата аласыз ба?
Dialogue: 0,0:41:28.52,0:41:31.51,Default,NTP,0000,0000,0000,!Effect,Қалай болғанда да, мен дуэль жасамаймын.
Dialogue: 0,0:41:34.89,0:41:37.25,Default,NTP,0000,0000,0000,!Effect,Сен мені ұнатпайсың ба?
Dialogue: 0,0:41:37.91,0:41:39.33,Default,NTP,0000,0000,0000,!Effect,Олардың әсерлері тым ауыр сияқты, иә?
Dialogue: 0,0:41:40.40,0:41:41.36,Default,NTP,0000,0000,0000,!Effect,Сіз нені айтасыз?
Dialogue: 0,0:41:41.86,0:41:42.96,Default,NTP,0000,0000,0000,!Effect,Дос болып қалсақ
Dialogue: 0,0:41:43.24,0:41:44.59,Default,NTP,0000,0000,0000,!Effect,Біз неге дұрыс араласпаймыз?
Dialogue: 0,0:41:46.15,0:41:48.70,Default,NTP,0000,0000,0000,!Effect,Кешке мен бөлмеме қайтып кеттім.
Dialogue: 0,0:41:49.14,0:41:50.94,Default,NTP,0000,0000,0000,!Effect,Жалғыз қалғаннан кейін де
Dialogue: 0,0:41:51.01,0:41:53.70,Default,NTP,0000,0000,0000,!Effect,Мен өзімді біршама жақсы сезінгенімді байқадым.
Dialogue: 0,0:41:54.04,0:41:56.07,Default,NTP,0000,0000,0000,!Effect,Бұл... басқа нәрсе.
Dialogue: 0,0:41:56.94,0:42:00.88,Default,NTP,0000,0000,0000,!Effect,Бір-бірінің мәселесін талқылап, қиналғанда бір-біріне көмектесу.
Dialogue: 0,0:42:00.95,0:42:05.22,Default,NTP,0000,0000,0000,!Effect,Бір қызығы, маған жетіспейтін нәрсе қарапайым нәрсе болды...
Dialogue: 0,0:42:05.29,0:42:07.69,Default,NTP,0000,0000,0000,!Effect,Кеше мен шынымды айтсам...
Dialogue: 0,0:42:08.63,0:42:10.35,Default,NTP,0000,0000,0000,!Effect,Қаласаңыз
Dialogue: 0,0:42:10.43,0:42:12.52,Default,NTP,0000,0000,0000,!Effect,Кішкене ашып жібере аласыз ба?
Dialogue: 0,0:42:13.13,0:42:16.00,Default,NTP,0000,0000,0000,!Effect,Мен сенімен дос болғым келеді
Dialogue: 0,0:42:16.30,0:42:19.39,Default,NTP,0000,0000,0000,!Effect,..Раушан келін және басқа да оғаш құпиялар ше?
Dialogue: 0,0:42:19.47,0:42:20.49,Default,NTP,0000,0000,0000,!Effect,Неліктен онсыз жасамасқа?
Dialogue: 0,0:42:20.57,0:42:23.27,Default,NTP,0000,0000,0000,!Effect,Өйткені сіз ешқашан өзіңіз туралы айтпайсыз...
Dialogue: 0,0:42:22.54,0:42:24.16,DefaultL2,NTP,0000,0000,0000,!Effect,Өзгеріс уақыты келді емес пе?
Dialogue: 0,0:42:30.25,0:42:31.90,Default,NTP,0000,0000,0000,!Effect,Эй...эй
Dialogue: 0,0:42:33.24,0:42:33.98,Default,NTP,0000,0000,0000,!Effect,Не?
Dialogue: 0,0:42:34.94,0:42:36.58,Default,NTP,0000,0000,0000,!Effect,Ақыр соңында, тоқталайық.
Dialogue: 0,0:42:37.09,0:42:37.98,Default,NTP,0000,0000,0000,!Effect,Неліктен?
Dialogue: 0,0:42:38.25,0:42:39.59,Default,NTP,0000,0000,0000,!Effect,Неліктен...
Dialogue: 0,0:42:40.99,0:42:44.37,Default,NTP,0000,0000,0000,!Effect,Басқа адамның мәнін түсіну маңызды
Dialogue: 0,0:42:45.64,0:42:48.93,Default,NTP,0000,0000,0000,!Effect,Біртүрлі құпияларды жасырма
Dialogue: 0,0:42:49.17,0:42:51.76,Default,NTP,0000,0000,0000,!Effect,Мен түсіндім. Бұл жақсы, иә?
Dialogue: 0,0:43:09.75,0:43:11.41,Default,NTP,0000,0000,0000,!Effect,Эй...эй...
Dialogue: 0,0:43:14.72,0:43:18.29,Default,NTP,0000,0000,0000,!Effect,Мен... бұл мен ғана...
Dialogue: 0,0:43:20.73,0:43:24.33,Default,NTP,0000,0000,0000,!Effect,Үлгі болу деген нені білдіреді?
Dialogue: 0,0:43:25.00,0:43:27.53,Default,NTP,0000,0000,0000,!Effect,Бұл әділетсіз...
Dialogue: 0,0:43:31.34,0:43:32.43,Default,NTP,0000,0000,0000,!Effect,Иә.
Dialogue: 0,0:43:41.99,0:43:44.55,Default,NTP,0000,0000,0000,!Effect,Сен олай болмасаң да...
Dialogue: 0,0:43:55.67,0:43:59.80,Default,NTP,0000,0000,0000,!Effect,! ? Эй, Химемия, мына сурет...
Dialogue: 0,0:44:03.81,0:44:05.80,Default,NTP,0000,0000,0000,!Effect,Осы суреттің үлгісі...
Dialogue: 0,0:44:08.21,0:44:09.61,Default,NTP,0000,0000,0000,!Effect,Сіз бе?
Dialogue: 0,0:44:10.65,0:44:12.38,Default,NTP,0000,0000,0000,!Effect,Мені бәрі жақсы көреді
Dialogue: 0,0:44:13.72,0:44:16.65,Default,NTP,0000,0000,0000,!Effect,Раушан қалыңдықты не үшін қалайсыз?
Dialogue: 0,0:44:17.69,0:44:20.12,Default,NTP,0000,0000,0000,!Effect,Мен саған айтамын...
Dialogue: 0,0:44:40.58,0:44:43.17,Default,NTP,0000,0000,0000,!Effect,! ! бұл......! !
Dialogue: 0,0:44:52.79,0:44:55.39,Default,NTP,0000,0000,0000,!Effect,Мен керемет тамақ жасадым!
Dialogue: 0,0:44:55.59,0:44:59.79,Default,NTP,0000,0000,0000,!Effect,Төрағаның кабинетінің артқы жағында шынымен жанжалды сурет ілулі тұр! !
Dialogue: 0,0:44:59.98,0:45:02.54,Default,NTP,0000,0000,0000,!Effect,Бұл қазірдің өзінде проблема, үлкен мәселе!
Dialogue: 0,0:45:02.54,0:45:06.36,Default,NTP,0000,0000,0000,!Effect,О, мен одан да жақсы бейне таспа алдым!
Dialogue: 0,0:45:06.49,0:45:09.94,Default,NTP,0000,0000,0000,!Effect,Бұл тағы бір жанжалды таспа.
Dialogue: 0,0:45:11.14,0:45:11.96,Default,NTP,0000,0000,0000,!Effect,Қазір мен сөйлесіп тұрған адам – басқа емес,
Dialogue: 0,0:46:47.17,0:46:49.01,Default,NTP,0000,0000,0000,!Effect,Бұл шынымен жанжалды таспа ма?
Dialogue: 0,0:46:49.04,0:46:50.40,Default,NTP,0000,0000,0000,!Effect,Мен қателестім деп ойлаймын.
Dialogue: 0,0:46:54.01,0:46:57.21,Default,NTP,0000,0000,0000,!Effect,Бұл жолы нағыз жанжалды таспа.
Dialogue: 0,0:46:57.34,0:46:58.21,Default,NTP,0000,0000,0000,!Effect,Қазір мен сөйлесіп тұрған адам – басқа емес,
Dialogue: 0,0:47:01.66,0:47:04.02,Default,NTP,0000,0000,0000,!Effect,Акио-сан, төрағаның міндетін атқарушы.
Dialogue: 0,0:47:08.39,0:47:11.88,Default,NTP,0000,0000,0000,!Effect,Бұл мен президенттің қызына құда түскен кезім еді.
Dialogue: 0,0:47:11.96,0:47:14.53,Default,NTP,0000,0000,0000,!Effect,Ол суреттегі ханзада сияқты.
Dialogue: 0,0:47:15.00,0:47:16.93,Default,NTP,0000,0000,0000,!Effect,Сіз әлі жассыз.
Dialogue: 0,0:47:17.00,0:47:20.40,Default,NTP,0000,0000,0000,!Effect,Өз ісіне шебер, мінезі мейірімді.
Dialogue: 0,0:47:20.54,0:47:22.63,Default,NTP,0000,0000,0000,!Effect,Ал мына көрініс!
Dialogue: 0,0:47:22.71,0:47:24.72,Default,NTP,0000,0000,0000,!Effect,Жоқ, онша емес.
Dialogue: 0,0:47:25.88,0:47:27.67,Default,NTP,0000,0000,0000,!Effect,Бұл шынымен бейне ме?
Dialogue: 0,0:47:27.92,0:47:31.24,Default,NTP,0000,0000,0000,!Effect,Жақсы адам салқын көлікте жақсы көрінеді, солай ма?
Dialogue: 0,0:47:31.57,0:47:32.44,Default,NTP,0000,0000,0000,!Effect,Жоқ
Dialogue: 0,0:47:32.64,0:47:34.98,Default,NTP,0000,0000,0000,!Effect,Бірақ бұл көлік қозғалмайды, солай ма?
Dialogue: 0,0:47:35.44,0:47:37.05,Default,NTP,0000,0000,0000,!Effect,Мен кілтімді жоғалтып алдым
Dialogue: 0,0:47:54.00,0:47:55.99,Default,NTP,0000,0000,0000,!Effect,Қош келдің, ағайын.
Dialogue: 0,0:47:55.94,0:47:56.86,Default,NTP,0000,0000,0000,!Effect,Мен үйдемін
Dialogue: 0,0:47:58.27,0:48:01.02,Default,NTP,0000,0000,0000,!Effect,Дұрыс айтасың, Акио-сан.
Dialogue: 0,0:48:01.46,0:48:04.26,Default,NTP,0000,0000,0000,!Effect,Сіз сіңліңізді де бағып жатырсыз деп естідім.
Dialogue: 0,0:48:04.78,0:48:07.83,Default,NTP,0000,0000,0000,!Effect,Біз өте жақын бауырлармыз!
Dialogue: 0,0:48:08.01,0:48:10.72,Default,NTP,0000,0000,0000,!Effect,Бірақ жанжал осы жерден басталады
Dialogue: 0,0:48:10.79,0:48:11.65,Default,NTP,0000,0000,0000,!Effect,Осы жерден
Dialogue: 0,0:48:11.72,0:48:13.12,Default,NTP,0000,0000,0000,!Effect,Осы жерден! !
Dialogue: 0,0:48:18.17,0:48:21.03,Default,NTP,0000,0000,0000,!Effect,Ғажайып Раушан қалыңдықтың сыры
Dialogue: 0,0:48:21.34,0:48:21.93,Default,NTP,0000,0000,0000,!Effect,Құпиясы
Dialogue: 0,0:48:22.20,0:48:23.63,Default,NTP,0000,0000,0000,!Effect,Бұл құпия...
Dialogue: 0,0:48:25.97,0:48:28.94,Default,NTP,0000,0000,0000,!Effect,Химемия, бұл...
Dialogue: 0,0:48:31.58,0:48:32.53,Default,NTP,0000,0000,0000,!Effect,Бл…ээ…!!
Dialogue: 0,0:48:32.72,0:48:35.04,Default,NTP,0000,0000,0000,!Effect,Раушан қалыңдықтың құпиясы болғандықтан...
Dialogue: 0,0:49:23.69,0:49:25.42,Default,NTP,0000,0000,0000,!Effect,Юри-санды итеріп жатыр...
Dialogue: 0,0:49:25.76,0:49:27.70,Default,NTP,0000,0000,0000,!Effect,Бұлай етпе, жігіт!
Dialogue: 0,0:49:47.08,0:49:49.21,Default,NTP,0000,0000,0000,!Effect,Сіз өте ақылдысыз.
Dialogue: 0,0:49:49.29,0:49:52.12,Default,NTP,0000,0000,0000,!Effect,Бұл менің клуб мүшелеріммен жақсы сәйкестік болар еді.
Dialogue: 0,0:49:58.56,0:50:03.81,Default,NTP,0000,0000,0000,!Effect,Бірақ сіз жарымжан ханзада болып көрінудің қаншалықты қымбат екенін білмейтін сияқтысыз.
Dialogue: 0,0:50:12.07,0:50:15.13,Default,NTP,0000,0000,0000,!Effect,...Раушанның белгісі саған жараспайды.
Dialogue: 0,0:50:19.75,0:50:20.58,Default,NTP,0000,0000,0000,!Effect,Мен...
Dialogue: 0,0:50:24.52,0:50:26.92,Default,NTP,0000,0000,0000,!Effect,Мен ұтыла алмаймын!
Dialogue: 0,0:50:28.54,0:50:30.66,Default,NTP,0000,0000,0000,!Effect,Сен Туганы қатты сағындың ба?
Dialogue: 0,0:50:32.36,0:50:34.45,Default,NTP,0000,0000,0000,!Effect,Сен не айтып тұрсың, Юри?
Dialogue: 0,0:50:34.88,0:50:37.72,Default,NTP,0000,0000,0000,!Effect,Туга деген кім?
Dialogue: 0,0:50:47.03,0:50:49.25,Default,NTP,0000,0000,0000,!Effect,Қараңызшы, бұл...
Dialogue: 0,0:50:51.65,0:50:54.01,Default,NTP,0000,0000,0000,!Effect,Мәңгілік бар делінген қамал.
Dialogue: 0,0:50:54.29,0:50:54.98,Default,NTP,0000,0000,0000,!Effect,Құлып?
Dialogue: 0,0:50:56.35,0:50:59.07,Default,NTP,0000,0000,0000,!Effect,Мен де ол жерге әлі кірген жоқпын.
Dialogue: 0,0:50:59.66,0:51:02.42,Default,NTP,0000,0000,0000,!Effect,Барсаң бәрін аласың дейді.
Dialogue: 0,0:51:02.63,0:51:05.69,Default,NTP,0000,0000,0000,!Effect,Мәңгілік, ғажайыптар, жарқыраған заттар
Dialogue: 0,0:51:06.24,0:51:08.49,Default,NTP,0000,0000,0000,!Effect,Сіздің құпия сезімдеріңіз міндетті түрде орындалады.
Dialogue: 0,0:51:09.14,0:51:12.35,Default,NTP,0000,0000,0000,!Effect,Себебі менде болу деген осы
Dialogue: 0,0:51:13.84,0:51:15.38,Default,NTP,0000,0000,0000,!Effect,Әлі де сен
Dialogue: 0,0:51:16.41,0:51:18.11,Default,NTP,0000,0000,0000,!Effect,Раушан белгісін тастаңыз ба?
Dialogue: 0,0:51:24.65,0:51:27.74,Default,NTP,0000,0000,0000,!Effect,Әлі таусылдыңыз ба? Ханзада?
Dialogue: 0,0:51:41.44,0:51:42.39,Default,NTP,0000,0000,0000,!Effect,Дегенмен, сол бір қадам біз, адамзат үшін, үлкен ілгерілеу болар еді.
Dialogue: 0,0:51:47.98,0:51:51.26,Default,NTP,0000,0000,0000,!Effect,Әй, сен әлі ханзада ойнай бересің бе?
Dialogue: 0,0:51:51.37,0:51:52.37,Default,NTP,0000,0000,0000,!Effect,Тенджо-кун
Dialogue: 0,0:51:55.81,0:51:57.40,Default,NTP,0000,0000,0000,!Effect,Ержүрек Аспан Тәңірі
Dialogue: 0,0:51:57.53,0:51:59.64,Default,NTP,0000,0000,0000,!Effect,Қалай ойлайсың, осындай позициямен жасай аласың ба...! !
Dialogue: 0,0:52:16.80,0:52:18.27,Default,NTP,0000,0000,0000,!Effect,Сіздің сыртқы келбетіңіз...
Dialogue: 0,0:52:23.37,0:52:24.36,Default,NTP,0000,0000,0000,!Effect,Дәл қазір...
Dialogue: 0,0:52:24.44,0:52:27.84,Default,NTP,0000,0000,0000,!Effect,Қосымша! Қосымша! Қосымша!
Dialogue: 0,0:52:40.69,0:52:44.47,Default,NTP,0000,0000,0000,!Effect,Акио-сан, Акио-сан! ! ! ! !
Dialogue: 0,0:52:44.86,0:52:47.50,Default,NTP,0000,0000,0000,!Effect,Сіз Кашира Кашираны білесіз бе?
Dialogue: 0,0:52:48.26,0:52:49.49,Default,NTP,0000,0000,0000,!Effect,Бұл төраға.
Dialogue: 0,0:52:49.57,0:52:50.79,Default,NTP,0000,0000,0000,!Effect,Иә, төраға.
Dialogue: 0,0:52:51.04,0:52:52.43,Default,NTP,0000,0000,0000,!Effect,Иә, төраға.
Dialogue: 0,0:52:52.57,0:52:54.66,Default,NTP,0000,0000,0000,!Effect,Мен сені көремін деп ойламасаң
Dialogue: 0,0:52:54.74,0:52:56.86,Default,NTP,0000,0000,0000,!Effect,Иеміз суық топырақта
Dialogue: 0,0:52:56.94,0:52:58.96,Default,NTP,0000,0000,0000,!Effect,Сізді біреу өлтірді ме?
Dialogue: 0,0:52:59.04,0:53:01.24,Default,NTP,0000,0000,0000,!Effect,Өйткені ол жерленген!
Dialogue: 0,0:53:01.31,0:53:03.57,Default,NTP,0000,0000,0000,!Effect,Сонда кінәлі кім?
Dialogue: 0,0:53:03.74,0:53:06.01,Default,NTP,0000,0000,0000,!Effect,Кашира Кашира, сен білесің бе...?
Dialogue: 0,0:53:06.28,0:53:08.67,Default,NTP,0000,0000,0000,!Effect,Кашира Кашира, сен білесің бе...!
Dialogue: 0,0:53:08.95,0:53:11.22,Default,NTP,0000,0000,0000,!Effect,Бұл гүлзардың иесі.
Dialogue: 0,0:53:11.49,0:53:13.85,Default,NTP,0000,0000,0000,!Effect,Раушан гүлінің өсу себебі
Dialogue: 0,0:53:13.92,0:53:16.12,Default,NTP,0000,0000,0000,!Effect,Ағамның мәйітін жасыру үшін
Dialogue: 0,0:53:16.19,0:53:18.68,Default,NTP,0000,0000,0000,!Effect,Дәлелдер қайда?
Dialogue: 0,0:53:18.76,0:53:20.79,Default,NTP,0000,0000,0000,!Effect,Мына бейнені қараңыз
Dialogue: 0,0:53:20.86,0:53:22.96,Default,NTP,0000,0000,0000,!Effect,Мына бейнені қараңыз!
Dialogue: 0,0:53:24.93,0:53:26.09,Default,NTP,0000,0000,0000,!Effect,Ах! Міне бітті!
Dialogue: 0,0:53:26.17,0:53:28.47,Default,NTP,0000,0000,0000,!Effect,Жанжалды бейне таптым!
Dialogue: 0,0:53:28.54,0:53:29.87,Default,NTP,0000,0000,0000,!Effect,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:53:31.84,0:53:33.24,Default,NTP,0000,0000,0000,!Effect,Химемия...
Dialogue: 0,0:53:35.44,0:53:36.47,Default,NTP,0000,0000,0000,!Effect,Химемия!
Dialogue: 0,0:53:37.30,0:53:38.20,Default,NTP,0000,0000,0000,!Effect,Химемия! ?
Dialogue: 0,0:53:45.45,0:53:46.61,Default,NTP,0000,0000,0000,!Effect,Ханзада....
Dialogue: 0,0:53:51.54,0:53:52.55,Default,NTP,0000,0000,0000,!Effect,Химемия!
Dialogue: 0,0:53:54.06,0:53:55.76,Default,NTP,0000,0000,0000,!Effect,Химемия!
Dialogue: 0,0:54:18.12,0:54:19.09,Default,NTP,0000,0000,0000,!Effect,Алып тасташы, өтінемін...?
Dialogue: 0,0:54:19.76,0:54:21.19,Default,NTP,0000,0000,0000,!Effect,Сіз ұйықтап жатқан жоқсыз ба? ?
Dialogue: 0,0:54:21.56,0:54:22.65,Default,NTP,0000,0000,0000,!Effect,Химемия! !
Dialogue: 0,0:54:24.14,0:54:25.82,Default,NTP,0000,0000,0000,!Effect,Химемия! ! ! !
Dialogue: 0,0:54:27.80,0:54:28.99,Default,NTP,0000,0000,0000,!Effect,Әй, қашаннан бері! ?
Dialogue: 0,0:54:29.49,0:54:30.66,Default,NTP,0000,0000,0000,!Effect,Сіз оны қашан байқадыңыз?
Dialogue: 0,0:54:31.29,0:54:32.82,Default,NTP,0000,0000,0000,!Effect,Сіз үнемі ұйықтап жатушысыз ба?
Dialogue: 0,0:54:33.34,0:54:35.53,Default,NTP,0000,0000,0000,!Effect,Ол жай ғана ұйықтап жатқан кейіп танытты ма?
Dialogue: 0,0:54:39.48,0:54:43.10,Default,NTP,0000,0000,0000,!Effect,Қарсы емес. Сенің ағаң менің ханзадам
Dialogue: 0,0:54:43.35,0:54:44.89,Default,NTP,0000,0000,0000,!Effect,Сіз қалаған уақытта қалағаныңызды жасай аласыз.
Dialogue: 0,0:54:44.69,0:54:45.35,DefaultL2,NTP,0000,0000,0000,!Effect,Айтпа! !
Dialogue: 0,0:54:46.10,0:54:47.59,Default,NTP,0000,0000,0000,!Effect,Мен ондай адам емеспін!
Dialogue: 0,0:54:49.35,0:54:50.19,Default,NTP,0000,0000,0000,!Effect,Умия!
Dialogue: 0,0:54:52.46,0:54:53.51,Default,NTP,0000,0000,0000,!Effect,Умия!
Dialogue: 0,0:54:58.88,0:54:59.96,Default,NTP,0000,0000,0000,!Effect,Умия!
Dialogue: 0,0:55:01.86,0:55:02.54,Default,NTP,0000,0000,0000,!Effect,Key
Dialogue: 0,0:55:02.94,0:55:04.89,Default,NTP,0000,0000,0000,!Effect,Кілт, кілт, мен кілтті таба алмаймын
Dialogue: 0,0:55:05.12,0:55:06.56,Default,NTP,0000,0000,0000,!Effect,Кілт? Не айтқың келеді?
Dialogue: 0,0:55:06.73,0:55:09.26,Default,NTP,0000,0000,0000,!Effect,Кілті жоқ көлік қозғалмай тот басады.
Dialogue: 0,0:55:09.34,0:55:10.53,Default,NTP,0000,0000,0000,!Effect,Кілт қайда?
Dialogue: 0,0:55:11.57,0:55:12.39,Default,NTP,0000,0000,0000,!Effect,Перне…
Dialogue: 0,0:55:13.48,0:55:14.25,Default,NTP,0000,0000,0000,!Effect,Кілт!
Dialogue: 0,0:55:15.34,0:55:17.12,Default,NTP,0000,0000,0000,!Effect,Кілт қай жерде! !
Dialogue: 0,0:55:17.09,0:55:18.38,Default,NTP,0000,0000,0000,!Effect,Сабыр ет, ағайын.
Dialogue: 0,0:55:18.45,0:55:19.96,Default,NTP,0000,0000,0000,!Effect,Сенің ағаң – нағашы.
Dialogue: 0,0:55:19.96,0:55:21.54,Default,NTP,0000,0000,0000,!Effect,Осылайша сіз өзіңіз қалаған нәрсені жасай аласыз
Dialogue: 0,0:55:24.06,0:55:26.44,Default,NTP,0000,0000,0000,!Effect,Сен не білесің?
Dialogue: 0,0:56:19.01,0:56:26.08,Default,NTP,0000,0000,0000,!Effect,(Қатысушылар үшін. Артында күтіңіз)
Dialogue: 0,0:56:44.53,0:56:45.43,Default,NTP,0000,0000,0000,!Effect,Утена
Dialogue: 0,0:56:45.99,0:56:48.97,Default,NTP,0000,0000,0000,!Effect,Фуюуга....Химемия қайда?
Dialogue: 0,0:56:56.15,0:56:57.54,Default,NTP,0000,0000,0000,!Effect,Неліктен онымен кездескіңіз келеді?
Dialogue: 0,0:56:58.06,0:57:01.60,Default,NTP,0000,0000,0000,!Effect,Сіз де ғажайыптар жасау күшін алғыңыз келе ме?
Dialogue: 0,0:57:02.34,0:57:04.58,Default,NTP,0000,0000,0000,!Effect,Оның мұндай күші бар ма?
Dialogue: 0,0:57:05.45,0:57:06.25,Default,NTP,0000,0000,0000,!Effect,Утена
Dialogue: 0,0:57:06.89,0:57:10.91,Default,NTP,0000,0000,0000,!Effect,Осы мектепте ойналатын ойындардың мәні неде деп ойлайсыңдар?
Dialogue: 0,0:57:11.46,0:57:15.26,Default,NTP,0000,0000,0000,!Effect,Бұл толығымен ханзаданың айналасына салынған жер.
Dialogue: 0,0:57:15.73,0:57:18.36,Default,NTP,0000,0000,0000,!Effect,Дегенмен, тек қана ет пен қанды ханзада жоқ.
Dialogue: 0,0:57:18.93,0:57:19.73,Default,NTP,0000,0000,0000,!Effect,Сонымен
Dialogue: 0,0:57:20.03,0:57:21.89,Default,NTP,0000,0000,0000,!Effect,Бос орындарды толтыру
Dialogue: 0,0:57:22.13,0:57:23.73,Default,NTP,0000,0000,0000,!Effect,Маған бұл ойын керек
Dialogue: 0,0:57:24.04,0:57:26.87,Default,NTP,0000,0000,0000,!Effect,Раушан келін болған кезде
Dialogue: 0,0:57:27.38,0:57:29.77,Default,NTP,0000,0000,0000,!Effect,Сол мәңгілік қамал пайда болды
Dialogue: 0,0:57:30.24,0:57:30.64,Default,NTP,0000,0000,0000,!Effect,Иә
Dialogue: 0,0:57:31.26,0:57:33.57,Default,NTP,0000,0000,0000,!Effect,Мен інім ханзаданы өлтіргенде.
Dialogue: 0,0:57:35.04,0:57:35.91,Default,NTP,0000,0000,0000,!Effect,Жоқ...
Dialogue: 0,0:57:36.84,0:57:39.24,Default,NTP,0000,0000,0000,!Effect,Ханзада о бастан өлген.
Dialogue: 0,0:57:53.65,0:57:55.25,Default,NTP,0000,0000,0000,!Effect,Ақыры есіме түсті.
Dialogue: 0,0:57:56.61,0:57:57.34,Default,NTP,0000,0000,0000,!Effect,Қый!
Dialogue: 0,0:57:57.56,0:57:59.37,Default,NTP,0000,0000,0000,!Effect,Мен сенімен ажырасқанда
Dialogue: 0,0:58:00.17,0:58:02.03,Default,NTP,0000,0000,0000,!Effect,Сіз жоғалып кеткен сәт туралы
Dialogue: 0,0:58:02.88,0:58:05.21,Default,NTP,0000,0000,0000,!Effect,Неге екені белгісіз, мұнда келгеннен бері ұмытып кетіппін.
Dialogue: 0,0:58:06.15,0:58:09.22,Default,NTP,0000,0000,0000,!Effect,Ол кезде біздің мектеп жанындағы өзенде.
Dialogue: 0,0:58:09.35,0:58:11.15,Default,NTP,0000,0000,0000,!Effect,Бір бала қайтыс болды, солай ма?
Dialogue: 0,0:58:11.81,0:58:13.21,Default,NTP,0000,0000,0000,!Effect,Бұл болды ма?
Dialogue: 0,0:58:13.46,0:58:14.41,Default,NTP,0000,0000,0000,!Effect,Жылы
Dialogue: 0,0:58:14.99,0:58:17.99,Default,NTP,0000,0000,0000,!Effect,Қайықтағы қыз өзенге жалғыз құлады.
Dialogue: 0,0:58:18.65,0:58:21.33,Default,NTP,0000,0000,0000,!Effect,Ал оны құтқару үшін ішке секірген бала
Dialogue: 0,0:58:21.67,0:58:22.97,Default,NTP,0000,0000,0000,!Effect,Оған көмектес
Dialogue: 0,0:58:23.29,0:58:25.17,Default,NTP,0000,0000,0000,!Effect,Мені сыпырып алып кетті
Dialogue: 0,0:58:29.17,0:58:31.47,Default,NTP,0000,0000,0000,!Effect,Осы уақытқа дейін қалай ұмыттым...
Dialogue: 0,0:58:38.75,0:58:40.64,Default,NTP,0000,0000,0000,!Effect,Көмектесіңіз! маған көмектесші...!
Dialogue: 0,0:58:41.94,0:58:44.03,Default,NTP,0000,0000,0000,!Effect,Біреу! Біреу келеді! !
Dialogue: 0,0:58:44.49,0:58:46.42,Default,NTP,0000,0000,0000,!Effect,Көмектесіңіз! маған көмектесші...!
Dialogue: 0,0:58:46.59,0:58:49.51,Default,NTP,0000,0000,0000,!Effect,Утена, менімен барғың келе ме?
Dialogue: 0,0:58:50.09,0:58:51.55,Default,NTP,0000,0000,0000,!Effect,Мен қазір осындамын
Dialogue: 0,0:58:51.80,0:58:53.38,Default,NTP,0000,0000,0000,!Effect,Мен сен туралы ойладым
Dialogue: 0,0:58:53.77,0:58:56.55,Default,NTP,0000,0000,0000,!Effect,Мен сені ақырзаманға дейін жақсы көруге уәде беремін
Dialogue: 0,0:58:58.14,0:58:59.46,Default,NTP,0000,0000,0000,!Effect,Бұл жақсы емес пе?
Dialogue: 0,0:59:00.12,0:59:01.46,Default,NTP,0000,0000,0000,!Effect,Осы жерде бақытты болыңыз
Dialogue: 0,0:59:04.79,0:59:06.70,Default,NTP,0000,0000,0000,!Effect,Сіз де сол кезде осылай дедіңіз.
Dialogue: 0,0:59:08.24,0:59:11.08,Default,NTP,0000,0000,0000,!Effect,Біреу асығыңыз! біреу!
Dialogue: 0,0:59:11.74,0:59:12.46,Default,NTP,0000,0000,0000,!Effect,Сол түн
Dialogue: 0,0:59:13.12,0:59:15.22,Default,NTP,0000,0000,0000,!Effect,Мен капеллада жалғыз жылап жүргенде де
Dialogue: 0,0:59:16.08,0:59:17.88,Default,NTP,0000,0000,0000,!Effect,Мен сені ойлаймын
Dialogue: 0,0:59:18.79,0:59:20.23,Default,NTP,0000,0000,0000,!Effect,Ол мені ақырын ұстады...
Dialogue: 0,0:59:27.60,0:59:28.46,Default,NTP,0000,0000,0000,!Effect,Күте тұрыңыз! ! ! ! !
Dialogue: 0,0:59:33.98,0:59:35.26,Default,NTP,0000,0000,0000,!Effect,Рахмет
Dialogue: 0,0:59:35.34,0:59:36.67,Default,NTP,0000,0000,0000,!Effect,...сен шынымен солайсың
Dialogue: 0,0:59:37.71,0:59:40.10,Default,NTP,0000,0000,0000,!Effect,Ол менің ханзада болды.
Dialogue: 0,0:59:40.61,0:59:41.85,Default,NTP,0000,0000,0000,!Effect,Не болды, Утена?
Dialogue: 0,0:59:44.87,0:59:46.88,Default,NTP,0000,0000,0000,!Effect,Сұмдық, қыз суға батып бара жатыр!
Dialogue: 0,0:59:48.25,0:59:50.31,Default,NTP,0000,0000,0000,!Effect,Күте тұрыңыз, кетпеңіз!
Dialogue: 0,0:59:50.39,0:59:51.94,Default,NTP,0000,0000,0000,!Effect,Барма, Туга!
Dialogue: 0,0:59:52.30,0:59:55.13,Default,NTP,0000,0000,0000,!Effect,Жоқ, мен баруым керек, әйтпесе ол суға батып кетеді!
Dialogue: 0,0:59:55.98,0:59:58.63,Default,NTP,0000,0000,0000,!Effect,Туга, сен өлесің!
Dialogue: 0,0:59:59.14,1:00:03.94,Default,NTP,0000,0000,0000,!Effect,Қысқы бүршік! Қысқы бүршік! Қысқы бүршіктер! ! !
Dialogue: 0,1:00:56.44,1:00:57.30,Default,NTP,0000,0000,0000,!Effect,Утена...!
Dialogue: 0,1:01:07.13,1:01:09.06,Default,NTP,0000,0000,0000,!Effect,Мен таптым
Dialogue: 0,1:01:09.51,1:01:10.49,Default,NTP,0000,0000,0000,!Effect,Утена
Dialogue: 0,1:01:10.63,1:01:13.43,Default,NTP,0000,0000,0000,!Effect,Сен менің нағыз ханзада болдым.
Dialogue: 0,1:01:15.10,1:01:17.38,Default,NTP,0000,0000,0000,!Effect,Сен енді мектептің ханзадасысың
Dialogue: 0,1:01:17.95,1:01:19.00,Default,NTP,0000,0000,0000,!Effect,Кез келген ғажайып
Dialogue: 0,1:01:19.19,1:01:21.87,Default,NTP,0000,0000,0000,!Effect,Кез келген мәңгілік сіздің қолыңызда.
Dialogue: 0,1:01:22.48,1:01:24.08,Default,NTP,0000,0000,0000,!Effect,Бұл дүниеде болғанша
Dialogue: 0,1:01:31.09,1:01:31.95,Default,NTP,0000,0000,0000,!Effect,Қайырлы таң, Камилла.
Dialogue: 0,1:01:32.94,1:01:34.98,Default,NTP,0000,0000,0000,!Effect,Кеттік. сыртқы әлемге
Dialogue: 0,1:01:36.26,1:01:37.01,Default,NTP,0000,0000,0000,!Effect,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,1:01:57.75,1:02:00.20,Default,NTP,0000,0000,0000,!Effect,Химемия, сыртқа шық!
Dialogue: 0,1:02:01.02,1:02:02.92,Default,NTP,0000,0000,0000,!Effect,Бұл дүниеден кетейік! ! !
Dialogue: 0,1:02:02.93,1:02:04.98,Default,NTP,0000,0000,0000,!Effect,Жоқ! ! Мен істей алмаймын! ! ! ! ! ! !
Dialogue: 0,1:02:05.14,1:02:06.25,Default,NTP,0000,0000,0000,!Effect,Химемия! ! !
Dialogue: 0,1:02:36.30,1:02:37.08,Default,NTP,0000,0000,0000,!Effect,Утена?
Dialogue: 0,1:04:09.51,1:04:11.57,Default,NTP,0000,0000,0000,!Effect,Утена...?
Dialogue: 0,1:04:18.85,1:04:19.63,Default,NTP,0000,0000,0000,!Effect,Бұл кілт.
Dialogue: 0,1:04:19.89,1:04:21.36,Default,NTP,0000,0000,0000,!Effect,Мен кілтімді таба алмай жатырмын
Dialogue: 0,1:04:21.44,1:04:22.09,Default,NTP,0000,0000,0000,!Effect,Кілт?
Dialogue: 0,1:04:22.46,1:04:25.58,Default,NTP,0000,0000,0000,!Effect,Кілті жоқ көлік қозғалмай тот басады.
Dialogue: 0,1:04:26.34,1:04:27.02,Default,NTP,0000,0000,0000,!Effect,Кілт қайда?
Dialogue: 0,1:04:27.10,1:04:28.86,Default,NTP,0000,0000,0000,!Effect,Кілт, кілт
Dialogue: 0,1:04:28.93,1:04:31.10,Default,NTP,0000,0000,0000,!Effect,Кілт қайда?! !
Dialogue: 0,1:04:41.22,1:04:43.04,Default,NTP,0000,0000,0000,!Effect,Кеттік, Утена.
Dialogue: 0,1:04:43.94,1:04:45.11,Default,NTP,0000,0000,0000,!Effect,Сыртқы әлемге!
Dialogue: 0,1:05:01.67,1:05:04.40,Default,NTP,0000,0000,0000,!Effect,Сәлем бәріңе, ұшып бара жатырсыңдар ма?
Dialogue: 0,1:05:04.55,1:05:05.39,Default,NTP,0000,0000,0000,!Effect,Е және бала
Dialogue: 0,1:05:05.60,1:05:07.24,Default,NTP,0000,0000,0000,!Effect,F-ko жеткізген
Dialogue: 0,1:05:07.42,1:05:10.32,Default,NTP,0000,0000,0000,!Effect,Радио тікелей эфир!
Dialogue: 0,1:05:19.31,1:05:21.75,Default,NTP,0000,0000,0000,!Effect,Жарыс режимі, қатысу
Dialogue: 0,1:05:35.70,1:05:39.22,Default,NTP,0000,0000,0000,!Effect,Міне, бүгінгі басты іс-шара басталды!
Dialogue: 0,1:05:39.27,1:05:42.82,Default,NTP,0000,0000,0000,!Effect,Қазіргі уақытта Энти Химемия жалғыз жүгіруде.
Dialogue: 0,1:05:43.35,1:05:44.86,Default,NTP,0000,0000,0000,!Effect,Бұл бір ғана көлік жүріп жатыр.
Dialogue: 0,1:05:44.94,1:05:46.13,Default,NTP,0000,0000,0000,!Effect,Сіз жалғызсыз, солай ма?
Dialogue: 0,1:05:46.21,1:05:48.98,Default,NTP,0000,0000,0000,!Effect,Олай десеңіз, мен тіпті қарамаймын.
Dialogue: 0,1:05:52.38,1:05:53.92,Default,NTP,0000,0000,0000,!Effect,Қосымша мәселе! Қосымша!
Dialogue: 0,1:05:54.18,1:05:55.05,Default,NTP,0000,0000,0000,!Effect,Міне!
Dialogue: 0,1:05:55.21,1:05:57.39,Default,NTP,0000,0000,0000,!Effect,Артынан бір қара бар!
Dialogue: 0,1:06:03.16,1:06:04.12,Default,NTP,0000,0000,0000,!Effect,Тез!
Dialogue: 0,1:06:17.57,1:06:18.72,Default,NTP,0000,0000,0000,!Effect,Сіз таң қалдыңыз ба?
Dialogue: 0,1:06:18.91,1:06:21.38,Default,NTP,0000,0000,0000,!Effect,Егер сіз көлікке айнала алатын жалғыз адаммын деп ойласаңыз
Dialogue: 0,1:06:21.44,1:06:22.97,Default,NTP,0000,0000,0000,!Effect,Үлкен қате!
Dialogue: 0,1:06:23.15,1:06:25.86,Default,NTP,0000,0000,0000,!Effect,Иә, мен де көлік болдым!
Dialogue: 0,1:06:33.86,1:06:35.50,Default,NTP,0000,0000,0000,!Effect,Жоқ, бұл дөрекі.
Dialogue: 0,1:06:38.46,1:06:40.40,Default,NTP,0000,0000,0000,!Effect,Бұл дүниеден қашу
Dialogue: 0,1:06:40.60,1:06:43.87,Default,NTP,0000,0000,0000,!Effect,Балалар, сендерге осындай керемет нәрсе жасауға рұқсат етеміз бе?
Dialogue: 0,1:06:44.13,1:06:46.20,Default,NTP,0000,0000,0000,!Effect,Нағыз керемет және әдемі не?
Dialogue: 0,1:06:46.44,1:06:51.40,Default,NTP,0000,0000,0000,!Effect,Бұл мен, мен, мен, мен, мен....
Dialogue: 0,1:07:04.26,1:07:07.38,Default,NTP,0000,0000,0000,!Effect,Ой, қара жігіт құлады!
Dialogue: 0,1:07:07.57,1:07:10.86,Default,NTP,0000,0000,0000,!Effect,Химемия Энти қайтадан өз алдына!
Dialogue: 0,1:07:34.98,1:07:39.55,Default,NTP,0000,0000,0000,!Effect,Бұл нені білдіреді? Қаралардың саны тез өсуде!
Dialogue: 0,1:07:39.55,1:07:43.21,Default,NTP,0000,0000,0000,!Effect,Көбінесе ұнамсыз нәрселер бір нәрсемен бірге жүреді, солай емес пе?
Dialogue: 0,1:07:43.55,1:07:43.92,Default,NTP,0000,0000,0000,!Effect,
Dialogue: 0,1:07:43.92,1:07:44.19,Default,NTP,0000,0000,0000,!Effect,(балдыркөк, жасыл бұрыш)
Dialogue: 0,1:07:44.19,1:07:45.69,Default,NTP,0000,0000,0000,!Effect,(балдыркөк, бұрыш, сәбіз)
Dialogue: 0,1:08:01.81,1:08:04.64,Default,NTP,0000,0000,0000,!Effect,Саны өте үлкен және өсуде!
Dialogue: 0,1:08:04.64,1:08:05.95,Default,NTP,0000,0000,0000,!Effect,Бұл шайтан сияқты.
Dialogue: 0,1:08:06.01,1:08:08.93,Default,NTP,0000,0000,0000,!Effect,Біз мұндай көп көрген емеспіз!
Dialogue: 0,1:08:09.34,1:08:12.68,Default,NTP,0000,0000,0000,!Effect,Бұл қайдан шықты?
Dialogue: 0,1:08:24.27,1:08:28.48,Default,NTP,0000,0000,0000,!Effect,О, күте тұрыңыз, не болды?
Dialogue: 0,1:08:28.90,1:08:31.81,Default,NTP,0000,0000,0000,!Effect,Қосымша! Мен туннельге кірдім
Dialogue: 0,1:08:31.87,1:08:34.05,Default,NTP,0000,0000,0000,!Effect,Мен біраз уақыт радио толқындарын жібере алмаймын!
Dialogue: 0,1:08:34.51,1:08:36.91,Default,NTP,0000,0000,0000,!Effect,Кешіріңіз.
Dialogue: 0,1:09:00.04,1:09:00.86,Default,NTP,0000,0000,0000,!Effect,Ақаулық бар ма?
Dialogue: 0,1:09:01.34,1:09:02.62,Default,NTP,0000,0000,0000,!Effect,Жылдамдық жоқ...
Dialogue: 0,1:09:24.79,1:09:26.83,Default,NTP,0000,0000,0000,!Effect,..Жоқ...көмектесіңіз!
Dialogue: 0,1:09:29.15,1:09:30.19,Default,NTP,0000,0000,0000,!Effect,Утена!
Dialogue: 0,1:09:52.65,1:09:54.31,Default,NTP,0000,0000,0000,!Effect,Радиотолқын күйі қалпына келтірілді!
Dialogue: 0,1:09:54.84,1:09:57.17,Default,NTP,0000,0000,0000,!Effect,Енді біз хабар таратуды жалғастыра аламыз.
Dialogue: 0,1:09:58.49,1:10:00.96,Default,NTP,0000,0000,0000,!Effect,Мен мұны білмей тұрып, жағдай тынышталды.
Dialogue: 0,1:10:01.41,1:10:04.03,Default,NTP,0000,0000,0000,!Effect,Мені достық құтқарған сияқты.
Dialogue: 0,1:10:07.33,1:10:10.01,Default,NTP,0000,0000,0000,!Effect,Осы кезде сол жақ айналма жолға шығуға болады.
Dialogue: 0,1:10:10.69,1:10:11.47,Default,NTP,0000,0000,0000,!Effect,Неліктен..
Dialogue: 0,1:10:12.04,1:10:15.24,Default,NTP,0000,0000,0000,!Effect,Балалар, қазір сыртқы әлемді мақсат етіп жатырсыңдар ма?
Dialogue: 0,1:10:15.69,1:10:19.05,Default,NTP,0000,0000,0000,!Effect,Талаптарың биік болса, жақсы достар тартасың.
Dialogue: 0,1:10:19.81,1:10:20.78,Default,NTP,0000,0000,0000,!Effect,Жарайды
Dialogue: 0,1:10:21.04,1:10:23.71,Default,NTP,0000,0000,0000,!Effect,Балалар сендер сыртын таба алатындарыңа сенімдімін.
Dialogue: 0,1:10:24.09,1:10:26.75,Default,NTP,0000,0000,0000,!Effect,Ақырында біз осыны жалғастыруды жоспарлап отырмыз!
Dialogue: 0,1:10:26.82,1:10:27.89,Default,NTP,0000,0000,0000,!Effect,Сыртта кездессек
Dialogue: 0,1:10:28.34,1:10:31.11,Default,NTP,0000,0000,0000,!Effect,Бұл жолы мен сені батыл түрде азғырамын
Dialogue: 0,1:10:41.94,1:10:44.86,Default,NTP,0000,0000,0000,!Effect,Сіз керемет жұмыс жасадыңыз, сіз қазір шығуыңыз керек!
Dialogue: 0,1:10:45.07,1:10:47.82,Default,NTP,0000,0000,0000,!Effect,Шығу? Сыртқы әлемге?
Dialogue: 0,1:10:48.01,1:10:48.87,Default,NTP,0000,0000,0000,!Effect,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,1:10:48.94,1:10:51.24,Default,NTP,0000,0000,0000,!Effect,Біз де оны ешқашан көрген емеспіз.
Dialogue: 0,1:10:51.31,1:10:53.41,Default,NTP,0000,0000,0000,!Effect,Бұл жақын жерде болуы керек!
Dialogue: 0,1:10:53.48,1:10:54.51,Default,NTP,0000,0000,0000,!Effect,О, күте тұрыңыз
Dialogue: 0,1:10:54.58,1:10:56.75,Default,NTP,0000,0000,0000,!Effect,Мен мұнда біраз кадрлар түсірдім.
Dialogue: 0,1:10:57.19,1:10:59.19,Default,NTP,0000,0000,0000,!Effect,Бұл не? Қамал?
Dialogue: 0,1:10:59.99,1:11:02.08,Default,NTP,0000,0000,0000,!Effect,Бұл шығу белгісі ме?
Dialogue: 0,1:11:34.30,1:11:35.32,Default,NTP,0000,0000,0000,!Effect,Бұл тұзақ!
Dialogue: 0,1:11:35.49,1:11:37.82,Default,NTP,0000,0000,0000,!Effect,Бұл шығу емес, жүгір!
Dialogue: 0,1:12:25.61,1:12:26.67,Default,NTP,0000,0000,0000,!Effect,1 шақырымдай қалды
Dialogue: 0,1:12:26.74,1:12:28.21,Default,NTP,0000,0000,0000,!Effect,Сіз сол жақтан айналма жолды көре аласыз!
Dialogue: 0,1:12:28.40,1:12:31.19,Default,NTP,0000,0000,0000,!Effect,Сол жерден түсіп, өз әлеміңізге қашыңыз!
Dialogue: 0,1:12:34.25,1:12:35.03,Default,NTP,0000,0000,0000,!Effect,Мен
Dialogue: 0,1:12:35.98,1:12:37.04,Default,NTP,0000,0000,0000,!Effect,Енді қашуға болмайды!
Dialogue: 0,1:12:38.83,1:12:40.92,Default,NTP,0000,0000,0000,!Effect,Мен бұл шығу екеніне сенімдімін.
Dialogue: 0,1:12:41.32,1:12:42.93,Default,NTP,0000,0000,0000,!Effect,Неліктен олай ойлайсың?
Dialogue: 0,1:12:43.66,1:12:46.22,Default,NTP,0000,0000,0000,!Effect,Сыртқы әлемге барайық!
Dialogue: 0,1:13:04.40,1:13:06.97,Default,NTP,0000,0000,0000,!Effect,Қосымша мәселе! алдыңғы кедергі
Dialogue: 0,1:13:07.03,1:13:08.61,Default,NTP,0000,0000,0000,!Effect,Ішін көрейік!
Dialogue: 0,1:13:14.46,1:13:18.88,Default,NTP,0000,0000,0000,!Effect,Ішінде көптеген үлкен шиналар жан-жаққа айналып жүр!
Dialogue: 0,1:13:19.60,1:13:24.11,Default,NTP,0000,0000,0000,!Effect,Шамасы, шиналардың жұмысы сырттан келген қаскүнемдерді басып-жаншу.
Dialogue: 0,1:13:25.05,1:13:28.22,Default,NTP,0000,0000,0000,!Effect,Бұл жерден өту мүмкін емес!
Dialogue: 0,1:13:28.28,1:13:30.14,Default,NTP,0000,0000,0000,!Effect,Сіз жақсы жұмыс істеп жатырсыз.
Dialogue: 0,1:14:02.89,1:14:06.31,Default,NTP,0000,0000,0000,!Effect,Қосымша! Қосымша! Шығуға жеткенде кері санақ басталады!
Dialogue: 0,1:14:06.61,1:14:07.27,Default,NTP,0000,0000,0000,!Effect,19
Dialogue: 0,1:14:07.63,1:14:08.46,Default,NTP,0000,0000,0000,!Effect,18
Dialogue: 0,1:14:08.74,1:14:09.44,Default,NTP,0000,0000,0000,!Effect,17
Dialogue: 0,1:14:09.74,1:14:10.44,Default,NTP,0000,0000,0000,!Effect,16
Dialogue: 0,1:14:10.85,1:14:11.44,Default,NTP,0000,0000,0000,!Effect,15
Dialogue: 0,1:14:11.94,1:14:12.45,Default,NTP,0000,0000,0000,!Effect,14
Dialogue: 0,1:14:12.86,1:14:13.45,Default,NTP,0000,0000,0000,!Effect,Жіп қылышымды қарсыласымның осалдығымен жалғайды,
Dialogue: 0,1:14:13.83,1:14:14.45,Default,NTP,0000,0000,0000,!Effect,12
Dialogue: 0,1:14:14.88,1:14:15.45,Default,NTP,0000,0000,0000,!Effect,11
Dialogue: 0,1:14:15.89,1:14:16.45,Default,NTP,0000,0000,0000,!Effect,10
Dialogue: 0,1:14:16.86,1:14:17.45,Default,NTP,0000,0000,0000,!Effect,9
Dialogue: 0,1:14:17.78,1:14:18.45,Default,NTP,0000,0000,0000,!Effect,8
Dialogue: 0,1:14:18.88,1:14:19.45,Default,NTP,0000,0000,0000,!Effect,7
Dialogue: 0,1:14:19.81,1:14:20.45,Default,NTP,0000,0000,0000,!Effect,6
Dialogue: 0,1:14:20.87,1:14:21.45,Default,NTP,0000,0000,0000,!Effect,5
Dialogue: 0,1:14:21.83,1:14:22.46,Default,NTP,0000,0000,0000,!Effect,4
Dialogue: 0,1:14:22.90,1:14:23.46,Default,NTP,0000,0000,0000,!Effect,3
Dialogue: 0,1:14:23.87,1:14:24.25,Default,NTP,0000,0000,0000,!Effect,2
Dialogue: 0,1:14:24.62,1:14:25.46,Default,NTP,0000,0000,0000,!Effect,1
Dialogue: 0,1:14:27.28,1:14:28.90,Default,NTP,0000,0000,0000,!Effect,Иә!
Dialogue: 0,1:15:25.22,1:15:26.26,Default,NTP,0000,0000,0000,!Effect,Аға
Dialogue: 0,1:15:27.13,1:15:29.91,Default,NTP,0000,0000,0000,!Effect,Иә, бұл сіздің ханзадаңыз.
Dialogue: 0,1:15:31.37,1:15:33.01,Default,NTP,0000,0000,0000,!Effect,Қорықпау керек
Dialogue: 0,1:15:34.23,1:15:36.86,Default,NTP,0000,0000,0000,!Effect,Жүр, менімен үйге кел.
Dialogue: 0,1:15:38.36,1:15:41.76,Default,NTP,0000,0000,0000,!Effect,Барарда өле алатын сол жабық әлемге
Dialogue: 0,1:15:42.37,1:15:43.41,Default,NTP,0000,0000,0000,!Effect,Poor guy
Dialogue: 0,1:15:44.08,1:15:47.50,Default,NTP,0000,0000,0000,!Effect,Сен ол дүниеде тек ханзада бола аласың, солай ма?
Dialogue: 0,1:15:47.74,1:15:51.42,Default,NTP,0000,0000,0000,!Effect,Бірақ менің ойымша, Утена пайда болады.
Dialogue: 0,1:15:52.04,1:15:53.23,Default,NTP,0000,0000,0000,!Effect,Сыртқы әлемге
Dialogue: 0,1:15:54.80,1:15:55.40,Default,NTP,0000,0000,0000,!Effect,Йосе
Dialogue: 0,1:15:55.93,1:15:58.72,Default,NTP,0000,0000,0000,!Effect,Сіз бәрібір ақырзаманға түсесіз.
Dialogue: 0,1:15:59.02,1:16:00.04,Default,NTP,0000,0000,0000,!Effect,Денем қан-қырынға толды!
Dialogue: 0,1:16:00.88,1:16:04.28,Default,NTP,0000,0000,0000,!Effect,Бірақ біз оған өз еркімізбен бара аламыз.
Dialogue: 0,1:16:06.84,1:16:09.50,Default,NTP,0000,0000,0000,!Effect,Қош бол, ханзадасым
Dialogue: 0,1:16:17.51,1:16:18.50,Default,NTP,0000,0000,0000,!Effect,Солай болғай.
Dialogue: 0,1:16:19.07,1:16:20.04,Default,NTP,0000,0000,0000,!Effect,Өте жаман.
Dialogue: 0,1:16:20.81,1:16:22.74,Default,NTP,0000,0000,0000,!Effect,Бірақ сіз
Dialogue: 0,1:16:22.81,1:16:25.64,Default,NTP,0000,0000,0000,!Effect,Өйткені мен ол дүниеде ханшайым болып қала беремін.
Dialogue: 0,1:16:27.18,1:16:28.71,Default,NTP,0000,0000,0000,!Effect,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:16:28.98,1:16:31.38,Default,NTP,0000,0000,0000,!Effect,Тірісінде өлсең болғаны.
Dialogue: 0,1:16:52.17,1:16:56.77,Default,NTP,0000,0000,0000,!Effect,Әлем...
Dialogue: 0,1:17:03.38,1:17:06.98,Default,NTP,0000,0000,0000,!Effect,Төңкеріс жасайтын күш! !
Dialogue: 0,1:18:56.02,1:19:01.93,Default,NTP,0000,0000,0000,!Effect,Ей, бұдан былай баратын жеріміз – жолсыз әлем.
Dialogue: 0,1:19:02.84,1:19:06.73,Default,NTP,0000,0000,0000,!Effect,Сонымен, біз ақыр соңында жақсы емес болып қалуымыз мүмкін.
Dialogue: 0,1:19:08.48,1:19:09.27,Default,NTP,0000,0000,0000,!Effect,Утена
Dialogue: 0,1:19:10.03,1:19:11.76,Default,NTP,0000,0000,0000,!Effect,Мен түсіндім
Dialogue: 0,1:19:12.64,1:19:16.82,Default,NTP,0000,0000,0000,!Effect,Біз бастапқыда сыртқы әлемде туылғанбыз.
Dialogue: 0,1:19:17.79,1:19:22.25,Default,NTP,0000,0000,0000,!Effect,Олай болса, біз туған қалаға қайтамыз.
Dialogue: 0,1:19:24.79,1:19:25.92,Default,NTP,0000,0000,0000,!Effect,Мен де түсіндім.
Dialogue: 0,1:19:26.89,1:19:28.63,Default,NTP,0000,0000,0000,!Effect,Мені неге қалайсың?
Dialogue: 0,1:19:29.09,1:19:31.17,Default,NTP,0000,0000,0000,!Effect,Мен сенен бас тартпадым ба?
Dialogue: 0,1:19:32.92,1:19:36.79,Default,NTP,0000,0000,0000,!Effect,Біз ханзадамызды жоғалтуға сыбайлас болдық.
Dialogue: 0,1:19:38.93,1:19:42.33,Default,NTP,0000,0000,0000,!Effect,Иә, сыртқы әлемде жол жоқ.
Dialogue: 0,1:19:42.51,1:19:45.65,Default,NTP,0000,0000,0000,!Effect,Сіз жаңа жолдар сала аласыз, солай ма?
Dialogue: 0,1:19:47.32,1:19:49.22,Default,NTP,0000,0000,0000,!Effect,Ендеше бізге бару керек
Dialogue: 0,1:19:50.10,1:19:51.28,Default,NTP,0000,0000,0000,!Effect,Егер жалғастырсақ
Dialogue: 0,1:19:51.73,1:19:53.38,Default,NTP,0000,0000,0000,!Effect,Дүние соншалықты кеңейеді
Dialogue: 0,1:19:54.68,1:19:55.44,Default,NTP,0000,0000,0000,!Effect,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:37:40.32,0:37:43.55,INJP2,NTP,0000,0000,0000,!Effect,Бұл раушан біздің тағдырымыз
Dialogue: 0,0:37:44.98,0:37:51.87,INJP2,NTP,0000,0000,0000,!Effect,Екеуміз қазір жетелейміз
Dialogue: 0,0:37:53.64,0:37:57.02,INJP2,NTP,0000,0000,0000,!Effect,Біз тағы кездесеміз
Dialogue: 0,0:37:57.17,0:38:01.81,INJP2,NTP,0000,0000,0000,!Effect,Кез келген уақытта
Dialogue: 0,0:38:02.73,0:38:09.78,INJP2,NTP,0000,0000,0000,!Effect,Бұл уәдені ұмытпа
Dialogue: 0,0:38:09.97,0:38:15.33,INJP2,NTP,0000,0000,0000,!Effect,Біз осы уақытқа дейін жеттік
Dialogue: 0,0:38:16.61,0:38:26.63,INJP2,NTP,0000,0000,0000,!Effect,Махаббат кейде адамның жүрегін жаралайды, бірақ
Dialogue: 0,0:38:26.72,0:38:28.63,INJP2,NTP,0000,0000,0000,!Effect,Маған арман берші
Dialogue: 0,0:38:28.84,0:38:35.35,INJP2,NTP,0000,0000,0000,!Effect,Ерлігіңде әрқашан жарқырай бер
Dialogue: 0,0:38:35.42,0:38:41.78,INJP2,NTP,0000,0000,0000,!Effect,Махаббат адамның жүрегін қатты елжіретеді.
Dialogue: 0,0:38:41.98,0:38:46.19,INJP2,NTP,0000,0000,0000,!Effect,Сондықтан біз біргеміз
Dialogue: 0,0:38:46.31,0:38:50.49,INJP2,NTP,0000,0000,0000,!Effect,Әрине, әлемді өзгерту
Dialogue: 0,0:38:50.69,0:38:53.83,INJP2,NTP,0000,0000,0000,!Effect,Және барлығы
Dialogue: 0,0:38:53.90,0:39:03.03,INJP2,NTP,0000,0000,0000,!Effect,Бір күшке айналу
Dialogue: 0,1:02:20.94,1:02:23.81,INJP3,NTP,0000,0000,0000,!Effect,Тағдырдың абсолютті апокалипсисі
Dialogue: 0,1:02:24.08,1:02:27.10,INJP3,NTP,0000,0000,0000,!Effect,Тағдырдың абсолютті апокалипсисі
Dialogue: 0,1:02:27.29,1:02:36.03,INJP3,NTP,0000,0000,0000,!Effect,Тууды тіркеу. Шомылдыру рәсімінен өту тізімі. өлімді тіркеу
Dialogue: 0,1:02:37.09,1:02:40.18,INJP3,NTP,0000,0000,0000,!Effect,Абсолютті Тағдыр Апокалипсисі
Dialogue: 0,1:02:40.38,1:02:43.45,INJP3,NTP,0000,0000,0000,!Effect,Тағдырдың абсолютті апокалипсисі
Dialogue: 0,1:02:43.63,1:02:52.33,INJP3,NTP,0000,0000,0000,!Effect,Менің туған күнім. Абсолютті туу. апокалипсис
Dialogue: 0,1:03:00.00,1:03:06.16,INJP3,NTP,0000,0000,0000,!Effect,Қараңғылық шөлде, күн суыту. Уба
Dialogue: 0,1:03:06.51,1:03:12.98,INJP3,NTP,0000,0000,0000,!Effect,Алтын жалатудың жұмағы
Dialogue: 0,1:03:13.03,1:03:19.26,INJP3,NTP,0000,0000,0000,!Effect,Күн мен түн қарама-қарсы бағытта айналады
Dialogue: 0,1:03:19.58,1:03:25.92,INJP3,NTP,0000,0000,0000,!Effect,Уақытпен жабылған Жоғалған жұмақ
Dialogue: 0,1:03:26.06,1:03:29.13,INJP3,NTP,0000,0000,0000,!Effect,Содомның қараңғылығы
Dialogue: 0,1:03:29.37,1:03:32.30,INJP3,NTP,0000,0000,0000,!Effect,Жарықтың қараңғылығы
Dialogue: 0,1:03:32.69,1:03:35.54,INJP3,NTP,0000,0000,0000,!Effect,Қараңғылық
Dialogue: 0,1:03:35.88,1:03:38.77,INJP3,NTP,0000,0000,0000,!Effect,Шексіз қараңғылық
Dialogue: 0,1:03:39.08,1:03:42.86,INJP3,NTP,0000,0000,0000,!Effect,Тағдырдың абсолютті апокалипсисі
Dialogue: 0,1:03:43.23,1:03:53.11,INJP3,NTP,0000,0000,0000,!Effect,Тағдырдың абсолютті апокалипсисі...
Dialogue: 0,1:03:53.11,1:03:54.16,INJP3,NTP,0000,0000,0000,!Effect,Кусимо
Dialogue: 0,1:03:54.23,1:03:55.22,INJP3,NTP,0000,0000,0000,!Effect,Шимоку Кумоши
Dialogue: 0,1:03:55.40,1:03:56.96,INJP3,NTP,0000,0000,0000,!Effect,немесе
Dialogue: 0,1:12:54.07,1:12:57.57,INJP,NTP,0000,0000,0000,!Effect,Таза, салқын өмір сүрейік...
Dialogue: 0,1:12:57.57,1:12:59.40,INJP,NTP,0000,0000,0000,!Effect,Ұзақ уақыт…
Dialogue: 0,1:13:01.62,1:13:05.17,INJP,NTP,0000,0000,0000,!Effect,Бөлінсек те...
Dialogue: 0,1:13:05.17,1:13:09.39,INJP,NTP,0000,0000,0000,!Effect,Кеттік. менің революциямды алып кет
Dialogue: 0,1:13:10.73,1:13:14.78,INJP,NTP,0000,0000,0000,!Effect,Мектеп ауласында нұр жауып, қол ұстасып
Dialogue: 0,1:13:15.07,1:13:18.63,INJP,NTP,0000,0000,0000,!Effect,Бір-бірімізге ант бердік, жұбаттық
Dialogue: 0,1:13:18.63,1:13:23.30,INJP,NTP,0000,0000,0000,!Effect,Мен енді ешқашан сүймеймін
Dialogue: 0,1:13:25.47,1:13:32.92,INJP,NTP,0000,0000,0000,!Effect,Бетімізге тиіп тұрған фото
Dialogue: 0,1:13:33.07,1:13:41.97,INJP,NTP,0000,0000,0000,!Effect,Күлкіңізді кішкене жалғыздықпен толтырыңыз
Dialogue: 0,1:13:42.76,1:13:46.37,INJP,NTP,0000,0000,0000,!Effect,Түс көрсем де, жылап, қиналсам да
Dialogue: 0,1:13:46.42,1:13:50.20,INJP,NTP,0000,0000,0000,!Effect,Шындық қиын болады
Dialogue: 0,1:13:50.27,1:13:53.65,INJP,NTP,0000,0000,0000,!Effect,Мен өз орнымды, бар болмысымның құнын тапқым келеді
Dialogue: 0,1:13:53.86,1:13:57.38,INJP,NTP,0000,0000,0000,!Effect,Мен бүгін кіммін
Dialogue: 0,1:13:57.89,1:14:01.45,INJP,NTP,0000,0000,0000,!Effect,таза болу, шешіну, жалаңаш болу
Dialogue: 0,1:14:01.57,1:14:05.24,INJP,NTP,0000,0000,0000,!Effect,Раушан гүлдей еркіндікте билеу
Dialogue: 0,1:14:05.40,1:14:08.84,INJP,NTP,0000,0000,0000,!Effect,Бөлінсек те
Dialogue: 0,1:14:08.84,1:14:13.43,INJP,NTP,0000,0000,0000,!Effect,Мен әлемді өзгертемін
Dialogue: 0,1:21:32.50,1:21:36.89,EDJP,NTP,0000,0000,0000,!Effect,Сөздерге қарағанда сенімдірек
Dialogue: 0,1:21:36.98,1:21:41.00,EDJP,NTP,0000,0000,0000,!Effect,Денеге қарағанда түсініксіз нәрсе
Dialogue: 0,1:21:41.40,1:21:49.65,EDJP,NTP,0000,0000,0000,!Effect,Мен оларды таба алмадым, сондықтан екеумізге тағы да сызат түсті.
Dialogue: 0,1:22:05.55,1:22:12.49,EDJP,NTP,0000,0000,0000,!Effect,Біздің естеліктеріміз тарыла бастаған сол күндер,
Dialogue: 0,1:22:13.46,1:22:20.08,EDJP,NTP,0000,0000,0000,!Effect,Бір-біріне қарап тұрғандай көздермен, Жүрегімде қашықтықты өлшеп жатырмын
Dialogue: 0,1:22:20.58,1:22:27.43,EDJP,NTP,0000,0000,0000,!Effect,Ажырасу ниетім болмаса да
Dialogue: 0,1:22:28.44,1:22:34.58,EDJP,NTP,0000,0000,0000,!Effect,Біз бір-бірімізді ойнақылап соқтығысатын пайдасыз ғашықтармыз
Dialogue: 0,1:22:34.62,1:22:38.58,EDJP,NTP,0000,0000,0000,!Effect,Менің қасымда бол... Жақынырақ...
Dialogue: 0,1:22:38.79,1:22:42.88,EDJP,NTP,0000,0000,0000,!Effect,Мен тіпті сөзді шығара алмаймын, шошып кеттім
Dialogue: 0,1:22:43.42,1:22:50.80,EDJP,NTP,0000,0000,0000,!Effect,Мен өзімшіл болсам ғой
Dialogue: 0,1:22:51.21,1:22:55.64,EDJP,NTP,0000,0000,0000,!Effect,Сөздерге қарағанда сенімдірек
Dialogue: 0,1:22:55.63,1:22:59.41,EDJP,NTP,0000,0000,0000,!Effect,Денеге қарағанда түсініксіз нәрсе
Dialogue: 0,1:23:00.05,1:23:06.72,EDJP,NTP,0000,0000,0000,!Effect,Мен оларды таба алмадым, сондықтан екеумізге тағы да сызат түсті.
Dialogue: 0,1:23:06.91,1:23:10.58,EDJP,NTP,0000,0000,0000,!Effect,Толқу жоқ, артық емес
Dialogue: 0,1:23:10.71,1:23:14.57,EDJP,NTP,0000,0000,0000,!Effect,Маған қарағанда көңілді жүрген сияқтысың.
Dialogue: 0,1:23:15.15,1:23:20.85,EDJP,NTP,0000,0000,0000,!Effect,Қарау неге ауырады?
Dialogue: 0,1:23:20.98,1:23:25.13,EDJP,NTP,0000,0000,0000,!Effect,...Одан да жақсы, мен сенің қалыңдығың болғым келеді.
Dialogue: 0,1:23:53.12,1:23:57.44,EDJP,NTP,0000,0000,0000,!Effect,Достарыңызға ештеңе бермеңіз
Dialogue: 0,1:23:57.48,1:24:01.32,EDJP,NTP,0000,0000,0000,!Effect,Мен тек сен үшін өмір сүре алмаймын
Dialogue: 0,1:24:02.01,1:24:08.61,EDJP,NTP,0000,0000,0000,!Effect,Абыржыған күйде екеуі қайта-қайта сүйісіп кетті.
Dialogue: 0,1:24:08.83,1:24:12.58,EDJP,NTP,0000,0000,0000,!Effect,Енді уайымдамаңыз.
Dialogue: 0,1:24:22.88,1:24:26.99,EDJP,NTP,0000,0000,0000,!Effect,...Одан да жақсы, мен сенің қалыңдығың болғым келеді.
Dialogue: 0,1:24:12.61,1:24:22.85,EDJPL1,NTP,0000,0000,0000,!Effect,Мен сені қаншалықты жақсы көрсем, соншалықты сен
Dialogue: 0,1:22:20.58,1:22:27.43,EDJPL2,NTP,0000,0000,0000,!Effect,Әрқашан тек алаңдаушылықты жинаңыз
Dialogue: 0,1:24:12.61,1:24:22.85,EDJPL2,NTP,0000,0000,0000,!Effect,Неліктен өзімді жалғыз сезінемін?
Dialogue: 0,0:16:45.02,0:16:49.95,INJP1,NTP,0000,0000,0000,,Мен туралы барлығы ``ортағасырлық'' схоластикалық абстракция
Dialogue: 0,0:16:49.99,0:16:54.91,INJP1,NTP,0000,0000,0000,,Мен туралы бәрін «ортағасырлық» ететін парализдік ойлар
Dialogue: 0,0:16:55.01,0:17:00.03,INJP1,NTP,0000,0000,0000,,Мен туралы бәрін «ортағасырлық» етіп, қорқынышты пайғамбарлық жаз
Dialogue: 0,0:17:00.18,0:17:05.22,INJP1,NTP,0000,0000,0000,,Мен туралы барлығын «ортағасырлық» етіп, ақыл-ой сиқырлы шеңберін жасаңыз
Dialogue: 0,0:17:09.69,0:17:15.47,INJP1,NTP,0000,0000,0000,,Экзистентті құру жұмбақ ләззат бергіш құрылғы
Dialogue: 0,0:17:16.51,0:17:22.07,INJP1,NTP,0000,0000,0000,,Қасиетті Декатан аяқталмаған тарих Шыны бөтелке құрылғысы
Dialogue: 0,0:17:22.10,0:17:28.89,INJP1,NTP,0000,0000,0000,,Мәңгілік ғажайыпқа сену
Dialogue: 0,0:17:29.15,0:17:35.61,INJP1,NTP,0000,0000,0000,,Мәңгілік Құдайды сынады
Dialogue: 0,0:17:35.78,0:17:39.29,INJP1,NTP,0000,0000,0000,,Ах, орта ғасырлардың бітпейтін тарихы.
Dialogue: 0,0:17:39.34,0:17:42.13,INJP1,NTP,0000,0000,0000,,Маған қайта тіріл
Dialogue: 0,0:17:45.81,0:17:49.13,INJP1,NTP,0000,0000,0000,,Ішкі өнімдердің тарихы
Dialogue: 0,0:17:49.18,0:18:00.88,INJP1,NTP,0000,0000,0000,,Әй, өмірге қайта келші, Орта ғасырдың бітпейтін тарихы!
Dialogue: 0,0:18:01.09,0:18:07.74,INJP1,NTP,0000,0000,0000,,Көзімде, қолымда, қанымда, тынысымда
Dialogue: 0,0:18:07.93,0:18:14.59,INJP1,NTP,0000,0000,0000,,Жандан! Жандан! Жандан! Жандан!
Dialogue: 0,0:18:14.95,0:18:19.94,INJP1,NTP,0000,0000,0000,,Жандан! Жандан! Жандан!
Dialogue: 0,0:18:19.94,0:18:23.29,INJP1,NTP,0000,0000,0000,,``Ортағасырлық'' Барлық уақытта!
Dialogue: 0,0:18:23.30,0:18:25.44,INJP1,NTP,0000,0000,0000,,Бөлме! Киім!
Dialogue: 0,0:18:26.32,0:18:31.44,INJP1,NTP,0000,0000,0000,,Мен туралы барлығы ``ортағасырлық'', ақылсыздық пен ақымақтық
Dialogue: 0,0:18:31.55,0:18:36.59,INJP1,NTP,0000,0000,0000,,Мен туралы барлығы «ортағасырлық» Астрология медицинасы
Dialogue: 0,0:18:36.73,0:18:41.66,INJP1,NTP,0000,0000,0000,,Мен туралы барлығын ''ортағасырлық'' етіңіз
Dialogue: 0,0:18:41.82,0:18:46.84,INJP1,NTP,0000,0000,0000,,Мен туралы барлығын «ортағасырлық» оптикалық антидотқа айналдыр
Dialogue: 0,0:18:46.97,0:18:52.00,INJP1,NTP,0000,0000,0000,,Мен туралы барлығын «ортағасырлық» және схоластикалық абстракция жасаңыз
Dialogue: 0,0:18:52.01,0:18:55.39,INJP1,NTP,0000,0000,0000,,Мен туралы бәрін «ортағасырлық» етіңіз
Dialogue: 0,1:24:28.49,1:24:34.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory