Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.02,0:00:03.02,Default,,0,0,0,,(тінтуірді басқан дыбыс)
Dialogue: 0,0:00:07.89,0:00:09.89,Default,,0,0,0,,(Бейне жаңғырық дыбысы)
Dialogue: 0,0:00:09.89,0:00:12.20,Default,,0,0,0,,Ла Ла Ла Ла қыздары!
Dialogue: 0,0:00:12.20,0:00:14.20,Default,,0,0,0,,Бүгін~! Бүгін~?
Dialogue: 0,0:00:14.20,0:00:17.20,Default,,0,0,0,,Бұл өте танымал жоба! (А-бала) Бұл не?
Dialogue: 0,0:00:17.20,0:00:20.20,Default,,0,0,0,,Ыммен ән викторинасы!
Dialogue: 0,0:00:21.87,0:00:24.71,Default,,0,0,0,,Келесі «Арыстан биі» әнін айтайық.
Dialogue: 0,0:00:24.71,0:00:26.78,Default,,0,0,0,,Да~ка~ра~.
Dialogue: 0,0:00:26.78,0:00:30.72,Default,,0,0,0,,«Арыстан биінен» бұрын «Робо үйін» жасауымыз керек! абсолютті!
Dialogue: 0,0:00:30.72,0:00:32.72,Default,,0,0,0,,Эй, мен солай ойлаймын.
Dialogue: 0,0:00:32.72,0:00:36.05,Default,,0,0,0,,Ах~ Иә. (Ритсу Минезуки) Иә...
Dialogue: 0,0:00:36.05,0:00:39.89,Default,,0,0,0,,Элеа-чан, сен өткен күні жақсы дедің.
Dialogue: 0,0:00:39.89,0:00:43.23,Default,,0,0,0,,Кешегі мен бүгіні бөлек.
Dialogue: 0,0:00:43.23,0:00:46.06,Default,,0,0,0,,Санпо П әні → Иә.
Dialogue: 0,0:00:46.06,0:00:48.06,Default,,0,0,0,,Бұл жақсы емес. Хахаха...
Dialogue: 0,0:00:49.73,0:00:52.74,Default,,0,0,0,,Элеа-чан, бұл жерде оның ән айту тәсілі.
Dialogue: 0,0:00:52.74,0:00:56.07,Default,,0,0,0,,Менің ойымша, бұл ең нашар дер едім.
Dialogue: 0,0:00:56.07,0:00:59.74,Default,,0,0,0,,♬~ Қазірдің өзінде~! Оны осында қойған дұрыс.
Dialogue: 0,0:00:59.74,0:01:03.18,Default,,0,0,0,,Мен неге түсінбеймін деп ойлаймын! Қайта түсіріңіз!
Dialogue: 0,0:01:03.18,0:01:07.52,Default,,0,0,0,,♬〜
Dialogue: 0,0:01:07.52,0:01:11.52,Default,,0,0,0,,Өткен күндегі бейне? Уау, бұл керемет. Ол өсіп келеді!
Dialogue: 0,0:01:11.52,0:01:13.52,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,0:01:13.52,0:01:18.32,Default,,0,0,0,,Бірақ біз жаңа нәрсені сынап көруіміз керек. Сандар маңызды!
Dialogue: 0,0:01:20.60,0:01:29.80,Default,,0,0,0,,Аа... Күрсіну…. Күрсіну… күрсіну….
Dialogue: 0,0:01:34.05,0:01:36.75,Default,,0,0,0,,Аяқталды.
Dialogue: 0,0:01:39.05,0:01:41.12,Default,,0,0,0,,♬〜 Хмм... Мм!
Dialogue: 0,0:01:41.12,0:01:44.39,Default,,0,0,0,,Бітті! Ауыз – апат көзі.
Dialogue: 0,0:01:44.39,0:01:48.23,Default,,0,0,0,,Мен бүгін сөйлемей, ән салмай барымды саламын!
Dialogue: 0,0:01:48.23,0:01:50.23,Default,,0,0,0,,О!
Dialogue: 0,0:01:52.06,0:01:59.74,Default,,0,0,0,,♬〜«Бұл біздің аман қалуымыздың схемасы».
Dialogue: 0,0:01:59.74,0:02:01.91,Default,,0,0,0,,♬ (дайын жинақ және дайын жиынтықты тауып, анықтаңыз)
Dialogue: 0,0:02:01.91,0:02:05.51,Default,,0,0,0,,♬ (бұл бір ғана жаңа түрі)
Dialogue: 0,0:02:05.51,0:02:10.18,Default,,0,0,0,,♬ Оқиға әрқашан біздің айналамызда өрбиді.
Dialogue: 0,0:02:10.18,0:02:15.19,Default,,0,0,0,,♬ Түсінікті болғаны сонша, тағы айтамын.
Dialogue: 0,0:02:15.19,0:02:17.25,Default,,0,0,0,,♬ Нұсқауларды оқи аласыз ба?
Dialogue: 0,0:02:17.25,0:02:20.26,Default,,0,0,0,,♬ Қанша мұқият жазсам да,
Dialogue: 0,0:02:20.26,0:02:23.03,Default,,0,0,0,,♬ Менің ойымша, бұл мен кедергі келтіретіндіктен шығар.
Dialogue: 0,0:02:23.03,0:02:25.70,Default,,0,0,0,,♬ Бірақ ол қатты дыбыстар шығарады!
Dialogue: 0,0:02:25.70,0:02:31.54,Default,,0,0,0,,♬ Сецуна Шамадан тыс қозғалысқа ұқсайтын декорация
Dialogue: 0,0:02:31.54,0:02:36.21,Default,,0,0,0,,♬ Мен оны қисық еткім келмейді.
Dialogue: 0,0:02:36.21,0:02:41.05,Default,,0,0,0,,♬ Тазалық тағы да күлкілі болып көрінетіні сонша, Ақымақ болма!
Dialogue: 0,0:02:41.05,0:02:43.11,Default,,0,0,0,,♬ Жүйкенің өшетініне сенімдімін
Dialogue: 0,0:02:43.11,0:02:45.88,Default,,0,0,0,,♬ Әділ сауап алатын уақыт келеді.
Dialogue: 0,0:02:45.88,0:02:49.89,Default,,0,0,0,,♬ Біздің аман қалуымыздың қысқаша мазмұны
Dialogue: 0,0:02:49.89,0:02:51.89,Default,,0,0,0,,♬ Қайта жазу
Dialogue: 0,0:02:51.89,0:02:55.73,Default,,0,0,0,,♬ Жаңа типте, абсурдты жылататын оқиға
Dialogue: 0,0:02:55.73,0:02:58.23,Default,,0,0,0,,♬ Мен кез келген жерге бара аламын, өйткені мен кез келген жерге бара аламын.
Dialogue: 0,0:02:58.23,0:03:00.23,Default,,0,0,0,,♬ Қадамдарыңызды тоқтатпаңыз
Dialogue: 0,0:03:00.23,0:03:05.00,Default,,0,0,0,,♬ Бұл аниме емес, шынайы емес. Санат кейінірек анықталады.
Dialogue: 0,0:03:05.00,0:03:08.34,Default,,0,0,0,,♬ Күрделі де көңілсіз дүниеден шаршадым!
Dialogue: 0,0:03:08.34,0:03:11.41,Default,,0,0,0,,♬ Арманымызды салуды маған қалдырыңыз
Dialogue: 0,0:03:11.41,0:03:14.01,Default,,0,0,0,,♬ (дайын жинақ және дайын жиынтықты тауып, анықтаңыз)
Dialogue: 0,0:03:14.01,0:03:16.01,Default,,0,0,0,,♬ (бұл тек бір жаңа түрі, біздің таңдауымыз) Жүрек соғуының сенімділігін қадағалаңыз
Dialogue: 0,0:03:16.01,0:03:18.02,Default,,0,0,0,,♬ (дайын жинап, анықтаңыз)
Dialogue: 0,0:03:18.02,0:03:20.02,Default,,0,0,0,,♬ (дайын жинақ және оның бір ғана жаңа түрі екенін табыңыз)
Dialogue: 0,0:03:23.30,0:03:28.57,Default,,0,0,0,,♬~ ≪Төменгі мектепте оқып жүргенімде топ құрып, бірге жұмыс жасадық. ≫
Dialogue: 0,0:03:28.57,0:03:31.41,Default,,0,0,0,,≪Әрекеттерге интернетте «Мен ән айтып көрдім» жүктеп салу кіреді →
Dialogue: 0,0:03:31.41,0:03:36.11,Default,,0,0,0,,Біз сөйлесіп жатқан бейнелерді жүктеп салу қызықты болды. ≫
Dialogue: 0,0:03:37.75,0:03:43.05,Default,,0,0,0,,≪Алайда кенеттен біртүрлі бейне пайда болып, әрекетіміз аяқталды. ≫
Dialogue: 0,0:03:47.09,0:03:49.09,Default,,0,0,0,,≪Бұл қорқынышты болды. ≫
Dialogue: 0,0:03:49.09,0:03:54.09,Default,,0,0,0,,≪Мен сыртқа шыға алмай, дыбыс шығара алмадым. ≫
Dialogue: 0,0:03:55.87,0:04:00.54,Default,,0,0,0,,≪Бірақ мен оның осылай аяқталғанын қаламаймын→
Dialogue: 0,0:04:00.54,0:04:03.04,Default,,0,0,0,,Мен тағы да армандағым келеді. ≫
Dialogue: 0,0:04:04.61,0:04:12.61,Default,,0,0,0,,≪Мен ән айтқым келеді, сөйлескім келеді және барлығына сені қаншалықты жақсы көретінімді айтқым келеді! ≫
Dialogue: 0,0:04:14.55,0:04:17.22,Default,,0,0,0,,Накамачи мырза бүгін де экскурсияға барғысы келеді.
Dialogue: 0,0:04:17.22,0:04:20.42,Default,,0,0,0,,Бірақ топ болуы мүмкін емес!
Dialogue: 0,0:04:22.06,0:04:52.26,Default,,0,0,0,,♪～(гитара дыбысы)
Dialogue: 0,0:04:52.26,0:04:55.03,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:55.03,0:04:58.10,Default,,0,0,0,,♬~ «Ноно-чан, сен гитарада жақсы ойнайсың!»
Dialogue: 0,0:04:58.10,0:05:00.10,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:05:00.10,0:05:04.04,Default,,0,0,0,,«Мю-тайпу құрылуымен құттықтаймыз». Рақмет сізге.
Dialogue: 0,0:05:04.04,0:05:06.54,Default,,0,0,0,,«Юночи әні». иә~!
Dialogue: 0,0:05:06.54,0:05:09.61,Default,,0,0,0,,Соңы Юно Чанның әні болды!
Dialogue: 0,0:05:09.61,0:05:13.55,Default,,0,0,0,,«Мю Тайпуның суреттері сүйкімді» солай ма?
Dialogue: 0,0:05:13.55,0:05:16.05,Default,,0,0,0,,Цуко-чан маған сурет салды.
Dialogue: 0,0:05:16.05,0:05:19.72,Default,,0,0,0,,«Бұл профессор Яко Фуджими».
Dialogue: 0,0:05:19.72,0:05:25.39,Default,,0,0,0,,«Мен апталық сериал мен Yoko-sensei тобы құлап қала ма деп қорқамын»?
Dialogue: 0,0:05:25.39,0:05:28.39,Default,,0,0,0,,Ноно-чан сізге қамқор болады, сондықтан уайымдамаңыз!
Dialogue: 0,0:05:28.39,0:05:31.90,Default,,0,0,0,,«Сурет өрескел болды»? Иә.
Dialogue: 0,0:05:31.90,0:05:35.57,Default,,0,0,0,,Чичинпуипуй~ Түзу бол!
Dialogue: 0,0:05:35.57,0:05:38.40,Default,,0,0,0,,Ноночан. Ванна~!
Dialogue: 0,0:05:38.40,0:05:41.91,Default,,0,0,0,,Ой, Нана хула келе жатыр. Иә, ванна.
Dialogue: 0,0:05:41.91,0:05:44.24,Default,,0,0,0,,Бүгін келгеніңіз үшін рахмет!
Dialogue: 0,0:05:44.24,0:05:49.74,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Вааааааааааааааааааааа.
Dialogue: 0,0:05:52.69,0:05:56.36,Default,,0,0,0,,Мен тақтаға жазуға біраз уақыт аламын.
Dialogue: 0,0:05:56.36,0:05:58.36,Default,,0,0,0,,♬〜 ≪(Фудзицуко) Уау...! ≫
Dialogue: 0,0:05:58.36,0:06:00.36,Default,,0,0,0,,♬〜
Dialogue: 0,0:06:00.36,0:06:02.36,Default,,0,0,0,,♬〜 ≪Мм...! ≫
Dialogue: 0,0:06:02.36,0:06:04.36,Default,,0,0,0,,♬〜
Dialogue: 0,0:06:04.36,0:06:07.37,Default,,0,0,0,,♬〜 ≪Аа…. ≫
Dialogue: 0,0:06:07.37,0:06:10.04,Default,,0,0,0,,Фудзи мырза. Иә! Қолжазба да маңызды →
Dialogue: 0,0:06:10.04,0:06:13.11,Default,,0,0,0,,Мен мұны міндетті түрде сынақтан өткіземін, сондықтан жазып алыңыз.
Dialogue: 0,0:06:13.11,0:06:15.11,Default,,0,0,0,,Иә, кешіріңіз...
Dialogue: 0,0:06:15.11,0:06:18.04,Default,,0,0,0,,Онда! Сабақ кезінде хабар тарату мектеп ережелеріне қайшы.
Dialogue: 0,0:06:18.04,0:06:20.05,Default,,0,0,0,,Кейінірек қызметкерлер бөлмесіне келіңіз.
Dialogue: 0,0:06:20.05,0:06:22.05,Default,,0,0,0,,♬〜
Dialogue: 0,0:06:22.05,0:06:25.38,Default,,0,0,0,,Фуджими мырза, қолжазбаңызды жібергеніңіз үшін рахмет.
Dialogue: 0,0:06:25.38,0:06:29.39,Default,,0,0,0,,Өткен аптадағы оқырман сауалнамасының нәтижелері де жаңадан келген оқырманның алғашқы сериясы →
Dialogue: 0,0:06:29.39,0:06:33.23,Default,,0,0,0,,Менің ойымша, бұл өте жақсы бастама. Бұл жақсы болды.
Dialogue: 0,0:06:33.23,0:06:37.23,Default,,0,0,0,,Серияландыру, мектептегі жұмыс және топтағы іс-әрекеттер қиын, солай емес пе?
Dialogue: 0,0:06:37.23,0:06:41.23,Default,,0,0,0,,Мерзім жақындағанда мен жаттығудан үзіліс жасаймын.
Dialogue: 0,0:06:41.23,0:06:44.07,Default,,0,0,0,,Жақсы. Қиын болса, аптасына бір рет көріңіз →
Dialogue: 0,0:06:44.07,0:06:46.07,Default,,0,0,0,,Мен жоғарыдан сұрауды ойладым →
Dialogue: 0,0:06:46.07,0:06:48.57,Default,,0,0,0,,Мүмкін болса, мен осы серпінге мінгім келеді→
Dialogue: 0,0:06:48.57,0:06:52.01,Default,,0,0,0,,Барымызды салайық! иә….
Dialogue: 0,0:06:52.01,0:07:05.36,Default,,0,0,0,,♬〜
Dialogue: 0,0:07:05.36,0:07:07.36,Default,,0,0,0,,Топтық жаттығу алдында→
Dialogue: 0,0:07:07.36,0:07:11.03,Default,,0,0,0,,Сіз қайсысын бірінші естігіңіз келеді, жақсы ма, әлде жаман ма?
Dialogue: 0,0:07:11.03,0:07:13.53,Default,,0,0,0,,Жақсы әңгіме! Жарайды.
Dialogue: 0,0:07:13.53,0:07:16.33,Default,,0,0,0,,Друруруру….
Dialogue: 0,0:07:18.04,0:07:21.11,Default,,0,0,0,,Жаңа аватар жасалды!
Dialogue: 0,0:07:21.11,0:07:23.11,Default,,0,0,0,,♬〜 Марукун! Фудзи мырза →
Dialogue: 0,0:07:23.11,0:07:26.05,Default,,0,0,0,,Ол мүшенің кейіпкер дизайнының бұрышында сызылған, солай ма?
Dialogue: 0,0:07:26.05,0:07:28.11,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:07:28.11,0:07:31.88,Default,,0,0,0,,Белгіленген мерзімге жету үшін аянбай еңбек еткеніңіз үшін рахмет.
Dialogue: 0,0:07:31.88,0:07:33.89,Default,,0,0,0,,Мэри!
Dialogue: 0,0:07:33.89,0:07:35.89,Default,,0,0,0,,Жаман жаңалық осыдан басталады.
Dialogue: 0,0:07:35.89,0:07:37.89,Default,,0,0,0,,♬〜
Dialogue: 0,0:07:37.89,0:07:40.39,Default,,0,0,0,,Myu Taipu-ның SNS жүйесі қиындыққа тап болды.
Dialogue: 0,0:07:40.39,0:07:42.39,Default,,0,0,0,,Пя~! ! ! ! ?
Dialogue: 0,0:07:44.90,0:07:48.40,Default,,0,0,0,,Ах, мен жүйеден шықтым. Накамачи-сан!
Dialogue: 0,0:07:48.40,0:07:52.57,Default,,0,0,0,,Әлі ештеңе айтқан жоқ... Миянаға мырзаны сынап жатыр.
Dialogue: 0,0:07:52.57,0:07:55.41,Default,,0,0,0,,Отсыз түтін болмайды.
Dialogue: 0,0:07:55.41,0:07:57.58,Default,,0,0,0,,Бұл қазірдің өзінде өртеу деңгейіндегі айыптау.
Dialogue: 0,0:07:57.58,0:08:01.18,Default,,0,0,0,,Барлығы Фудзи-санның жанкүйерінің пікірінен басталды. сурет….
Dialogue: 0,0:08:01.18,0:08:03.68,Default,,0,0,0,,♬〜 Сериализация мен жолақты теңестіруге алаңдайтын пікірлер →
Dialogue: 0,0:08:03.68,0:08:08.35,Default,,0,0,0,,«Миянаға-сан құлап қалса да жарайды?» деген сияқты сөз айтпадың ба?
Dialogue: 0,0:08:08.35,0:08:10.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.36,0:08:13.03,Default,,0,0,0,,Ноно-чан сізге қамқор болады, сондықтан уайымдамаңыз!
Dialogue: 0,0:08:13.03,0:08:15.86,Default,,0,0,0,,Сіз жай ғана уайымдап тұрған сияқтысыз.
Dialogue: 0,0:08:15.86,0:08:17.86,Default,,0,0,0,,Дұрыс, бірақ→
Dialogue: 0,0:08:17.86,0:08:21.87,Default,,0,0,0,,``Сіз құлап қаласыз деп болжанады ма?'' Бұл зиянды деп танылды.
Dialogue: 0,0:08:21.87,0:08:23.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:26.94,0:08:28.94,Default,,0,0,0,,Хмм? Аа, аа….
Dialogue: 0,0:08:28.94,0:08:30.94,Default,,0,0,0,,Хмм? Сенімен бәрі жақсы ма?
Dialogue: 0,0:08:30.94,0:08:35.74,Default,,0,0,0,,Иә! Ноно-чан патшалығы тыныштықта. Бұл дұрыс...
Dialogue: 0,0:08:39.72,0:08:41.72,Default,,0,0,0,,Цуко-чан!
Dialogue: 0,0:08:41.72,0:08:46.39,Default,,0,0,0,,Бұл туралы артық ойламаңыз! Не!
Dialogue: 0,0:08:46.39,0:08:50.90,Default,,0,0,0,,Біз нұсқауларды шығарамыз, бірақ нақты уақытта экстремалды пікірлерді болдырмаудың жолы жоқ.
Dialogue: 0,0:08:50.90,0:08:54.97,Default,,0,0,0,,Жеке менің ойымша, таратуды әзірге кейінге қалдырған дұрыс.
Dialogue: 0,0:08:54.97,0:08:56.97,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:56.97,0:09:00.47,Default,,0,0,0,,Олай болса, жаттығуды бастайық! иә.
Dialogue: 0,0:09:02.24,0:09:06.58,Default,,0,0,0,,Марукунның проблемалық кеңес беру бұрышы!
Dialogue: 0,0:09:06.58,0:09:08.91,Default,,0,0,0,,«Дон Дон Пафф пафф~!»
Dialogue: 0,0:09:08.91,0:09:10.91,Default,,0,0,0,,«Сіздің проблемаңыз неде?»
Dialogue: 0,0:09:12.99,0:09:16.09,Default,,0,0,0,,♬〜 Күнге мен сияқты көлеңке →
Dialogue: 0,0:09:16.09,0:09:18.99,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:09:18.99,0:09:22.26,Default,,0,0,0,,«Иә?» Не деген күлкілі!
Dialogue: 0,0:09:22.26,0:09:25.33,Default,,0,0,0,,Отакустарға кездейсоқ заттар сияқты қаралатыны анық.
Dialogue: 0,0:09:25.33,0:09:27.77,Default,,0,0,0,,Мен мұндай нәрселерге сезімталмын, сондықтан түсінемін.
Dialogue: 0,0:09:27.77,0:09:30.10,Default,,0,0,0,,Күн түсінбейтін шығар!
Dialogue: 0,0:09:30.10,0:09:32.80,Default,,0,0,0,,«Сіз жабайы әрекет жасайсыз».
Dialogue: 0,0:09:34.44,0:09:38.44,Default,,0,0,0,,Келісім-шарт Мен оны дұрыс қарауым керек еді.
Dialogue: 0,0:09:38.44,0:09:43.12,Default,,0,0,0,,"Ой, топ? Менің иллюстрация жұмысы соқыр болды деп ойлаймын."
Dialogue: 0,0:09:43.12,0:09:45.62,Default,,0,0,0,,Мен кем дегенде бір қару қосуға тырысамын→
Dialogue: 0,0:09:45.62,0:09:47.69,Default,,0,0,0,,Манга, иллюстрациялар және топтық жаттығулар →
Dialogue: 0,0:09:47.69,0:09:49.69,Default,,0,0,0,,Өлетіндей істеп жатырмын.
Dialogue: 0,0:09:49.69,0:09:52.56,Default,,0,0,0,,♬~ Мен бір мангамен ғана өмір сүре аламын →
Dialogue: 0,0:09:52.56,0:09:56.23,Default,,0,0,0,,Мен оның керемет емес екенін білемін.
Dialogue: 0,0:09:56.23,0:10:01.17,Default,,0,0,0,,«Жарақ көп болғаны дұрыс шығар». Бұл дұрыс! !
Dialogue: 0,0:10:01.17,0:10:05.94,Default,,0,0,0,,♬~ Мен осы бейберекет дүниеден аман өту үшін қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:10:05.94,0:10:09.44,Default,,0,0,0,,Менің жолым болғаны... Уф... «Ұстама ұстап тұрсың ба?».
Dialogue: 0,0:10:18.42,0:10:22.75,Default,,0,0,0,,Емдеу! Маған ем жетпейді!
Dialogue: 0,0:10:22.75,0:10:28.09,Default,,0,0,0,,♬〜 Фуаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:10:28.09,0:10:30.10,Default,,0,0,0,,Өте сүйкімді...
Dialogue: 0,0:10:30.10,0:10:36.60,Default,,0,0,0,,Мені тек Киавахи емдей алады...
Dialogue: 0,0:10:36.60,0:10:42.11,Default,,0,0,0,,Кяванюмо? Nyomomo monyo?
Dialogue: 0,0:10:42.11,0:10:46.45,Default,,0,0,0,,...
Dialogue: 0,0:10:46.45,0:10:51.45,Default,,0,0,0,,Нёмомо... күрсінді... Нюкики...
Dialogue: 0,0:10:51.45,0:10:56.62,Default,,0,0,0,,Шимекири! Шимекири!
Dialogue: 0,0:10:56.62,0:10:58.62,Default,,0,0,0,,Шимекири! Шимекири! Тынш!
Dialogue: 0,0:10:58.62,0:11:00.63,Default,,0,0,0,,♬〜 Атыңызды жоғарыға жіберіңіз →
Dialogue: 0,0:11:00.63,0:11:03.06,Default,,0,0,0,,Таң атқанша 5 дөрекі SD таңба!
Dialogue: 0,0:11:03.06,0:11:06.90,Default,,0,0,0,,Мен аман қаламын!
Dialogue: 0,0:11:06.90,0:11:10.97,Default,,0,0,0,,Иә? Сенімен бәрі жақсы ма?
Dialogue: 0,0:11:10.97,0:11:13.41,Default,,0,0,0,,Көз астындағы қара шеңберлер.
Dialogue: 0,0:11:13.41,0:11:16.07,Default,,0,0,0,,Фудзи мырза, ұйықтап жатқан жоқсыз ба? Бүгін қазірдің өзінде...
Dialogue: 0,0:11:16.07,0:11:18.08,Default,,0,0,0,,Жарайды. ♪〜(пернетақта дыбысы)
Dialogue: 0,0:11:18.08,0:11:21.91,Default,,0,0,0,,Мәселе жоқ. Мен оны істей аламын. ♪〜(пернетақта дыбысы)
Dialogue: 0,0:11:21.91,0:11:26.42,Default,,0,0,0,,Жалғастыру... ♪〜(пернетақта дыбысы)
Dialogue: 0,0:11:26.42,0:11:33.09,Default,,0,0,0,,Не? Ұйықтап қалдыңыз ба?
Dialogue: 0,0:11:33.09,0:11:36.76,Default,,0,0,0,,Мен сені үйге сәлден кейін шақырамын.
Dialogue: 0,0:11:36.76,0:11:38.76,Default,,0,0,0,,Мм.
Dialogue: 0,0:11:38.76,0:11:42.10,Default,,0,0,0,,(гитара дыбысы)
Dialogue: 0,0:11:42.10,0:11:44.10,Default,,0,0,0,,Мен саған қамқор болуым керек!
Dialogue: 0,0:11:51.56,0:11:54.39,Default,,0,0,0,,(Оқушылар сөйлейді)
Dialogue: 0,0:11:54.39,0:11:56.89,Default,,0,0,0,,≪Мен ұйықтап қалдым... ≫
Dialogue: 0,0:11:56.89,0:12:01.73,Default,,0,0,0,,Жолдарды түзетіп, түскі асқа дейін көмекшілерге нұсқау беру.
Dialogue: 0,0:12:01.73,0:12:04.23,Default,,0,0,0,,Мен кеше түскі үзілісте ұйықтап қалдым→
Dialogue: 0,0:12:04.23,0:12:06.74,Default,,0,0,0,,Музыкалық аспаптарды жаттықтыру үшін қолдану. Тұрақты сурет материалына оралу →
Dialogue: 0,0:12:06.74,0:12:08.81,Default,,0,0,0,,Қайырлы таң, Цуко-чан! Мен түсте келуім керек →
Dialogue: 0,0:12:08.81,0:12:12.58,Default,,0,0,0,,Мазмұнына қарай бірден жауап береміз...
Dialogue: 0,0:12:12.58,0:12:14.58,Default,,0,0,0,,♬〜
Dialogue: 0,0:12:14.58,0:12:17.65,Default,,0,0,0,,Эй...қайырлы таң.
Dialogue: 0,0:12:17.65,0:12:21.08,Default,,0,0,0,,Сен мектепке ерте барасың~ Таңертеңгілік сабақ?
Dialogue: 0,0:12:21.08,0:12:23.92,Default,,0,0,0,,Мм. Иә?
Dialogue: 0,0:12:23.92,0:12:29.93,Default,,0,0,0,,SNS оқиғасы Келтірілген қолайсыздық үшін кешірім сұраймын...! ?
Dialogue: 0,0:12:29.93,0:12:32.60,Default,,0,0,0,,Жоқ...! ? Жартысы!
Dialogue: 0,0:12:32.60,0:12:34.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:36.27,0:12:38.27,Default,,0,0,0,,Гю де жарты ко!
Dialogue: 0,0:12:41.10,0:12:43.11,Default,,0,0,0,,Ахаха.
Dialogue: 0,0:12:43.11,0:12:45.18,Default,,0,0,0,,Харья~?
Dialogue: 0,0:12:45.18,0:12:47.18,Default,,0,0,0,,≪Бұл мүмкін емес... ≫
Dialogue: 0,0:12:47.18,0:12:51.72,Default,,0,0,0,,(Оқушылар сөйлейді)
Dialogue: 0,0:12:51.72,0:12:54.55,Default,,0,0,0,,Уф….
Dialogue: 0,0:12:54.55,0:12:58.62,Default,,0,0,0,,Хмм….
Dialogue: 0,0:12:58.62,0:13:00.62,Default,,0,0,0,,Кууууууууу!
Dialogue: 0,0:13:00.62,0:13:03.63,Default,,0,0,0,,♬~ ≪Осы аптадағы Чупа Сачу тым жақсы~! ≫
Dialogue: 0,0:13:03.63,0:13:06.40,Default,,0,0,0,,≪Тек Йоко Фуджими мангасынан алуға болады→
Dialogue: 0,0:13:06.40,0:13:08.40,Default,,0,0,0,,Тамақтану Менің ойымша, солай! ≫
Dialogue: 0,0:13:08.40,0:13:13.40,Default,,0,0,0,,≪Тіпті жағымсыз нәрселер көп болса да, мені тек Құдай ғана емдей алады. ≫
Dialogue: 0,0:13:18.91,0:13:22.58,Default,,0,0,0,,Егер мен де Яко-сенсейге бірдеңе істей алсам...
Dialogue: 0,0:13:22.58,0:13:27.42,Default,,0,0,0,,Ах! болды~! Сәлем!
Dialogue: 0,0:13:27.42,0:13:31.62,Default,,0,0,0,,♬~ Түскі асты бірге ішейік~!
Dialogue: 0,0:13:35.09,0:13:38.76,Default,,0,0,0,,Уау. Шынымен... мен істеп жатырмын.
Dialogue: 0,0:13:38.76,0:13:40.83,Default,,0,0,0,,Иә. Миянага мырза…→
Dialogue: 0,0:13:40.83,0:13:43.60,Default,,0,0,0,,Сіз бір мектепте оқыдыңыз ба? ?
Dialogue: 0,0:13:43.60,0:13:45.60,Default,,0,0,0,,Міне.
Dialogue: 0,0:13:48.11,0:13:51.54,Default,,0,0,0,,♬~ Цуко-чан мен Ноно-чан екінші курс студенттері →
Dialogue: 0,0:13:51.54,0:13:54.38,Default,,0,0,0,,Мен сені бірінші рет кездестіруім.
Dialogue: 0,0:13:54.38,0:13:59.05,Default,,0,0,0,,Ноно-чан А және Цуко-чан В класы~. Хмм.
Dialogue: 0,0:13:59.05,0:14:02.39,Default,,0,0,0,,≪В сыныбы дәл менің үстімде. ≫
Dialogue: 0,0:14:02.39,0:14:06.22,Default,,0,0,0,,≪Яко-сенсэй күн сайын менің үстімде қатты жұмыс істейтінін ойласам→
Dialogue: 0,0:14:06.22,0:14:09.73,Default,,0,0,0,,Мен мектепте де қолымнан келгеннің бәрін жасай аламын. ≫
Dialogue: 0,0:14:09.73,0:14:11.73,Default,,0,0,0,,Мм.
Dialogue: 0,0:14:11.73,0:14:14.57,Default,,0,0,0,,♬〜
Dialogue: 0,0:14:14.57,0:14:16.57,Default,,0,0,0,,Араре-чан. Иә?
Dialogue: 0,0:14:18.57,0:14:20.57,Default,,0,0,0,,Бұл...! ?
Dialogue: 0,0:14:20.57,0:14:22.57,Default,,0,0,0,,Не...! ? Иә?
Dialogue: 0,0:14:22.57,0:14:25.41,Default,,0,0,0,,Мугья! ? ештеңе~...!
Dialogue: 0,0:14:25.41,0:14:27.41,Default,,0,0,0,,Фу~фу~.
Dialogue: 0,0:14:30.08,0:14:32.08,Default,,0,0,0,,♬〜 Аа….
Dialogue: 0,0:14:32.08,0:14:36.92,Default,,0,0,0,,Ноно-чанның сезімін түсіндіңіз бе?
Dialogue: 0,0:14:36.92,0:14:41.99,Default,,0,0,0,,♬〜
Dialogue: 0,0:14:41.99,0:14:47.60,Default,,0,0,0,,Жоқ…. ♬〜 Гон, Гюн және Докудоку→
Dialogue: 0,0:14:47.60,0:14:49.93,Default,,0,0,0,,Оны жеткізе алмайсыз ба? иә….
Dialogue: 0,0:14:49.93,0:14:54.94,Default,,0,0,0,,Таңертеңгі гю~ саған да жеткізілмеген шығар...
Dialogue: 0,0:14:54.94,0:14:57.64,Default,,0,0,0,,Өйткені, біз дұрыс сөйлесуіміз керек.
Dialogue: 0,0:14:59.88,0:15:01.88,Default,,0,0,0,,≪Мен білдім... ≫
Dialogue: 0,0:15:01.88,0:15:05.95,Default,,0,0,0,,Бірақ... сөйлескенде...
Dialogue: 0,0:15:05.95,0:15:08.72,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:08.72,0:15:12.56,Default,,0,0,0,,Араре-чан Цуко-чан туралы алдын ала білген бе?
Dialogue: 0,0:15:12.56,0:15:14.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:14.56,0:15:16.56,Default,,0,0,0,,♬~ Яко-сенсэй – таңғажайып манга суретшісі.
Dialogue: 0,0:15:16.56,0:15:18.90,Default,,0,0,0,,Алғашында иллюстрациялар мені қызықтырды.
Dialogue: 0,0:15:18.90,0:15:20.96,Default,,0,0,0,,6-сыныпта туған күніме сыйлық ретінде алған смартфонмен →
Dialogue: 0,0:15:20.96,0:15:24.97,Default,,0,0,0,,Мен сурет салу алаңдарына еніп, Йоко-сенсэйдің шығармаларына таң қалдым.
Dialogue: 0,0:15:24.97,0:15:27.24,Default,,0,0,0,,Йоко-сенсэйдің мангасы кейіпкерлер туралы...
Dialogue: 0,0:15:27.24,0:15:29.24,Default,,0,0,0,,О...
Dialogue: 0,0:15:30.91,0:15:33.74,Default,,0,0,0,,Мен Цуко-чанды жақсы көремін.
Dialogue: 0,0:15:33.74,0:15:36.94,Default,,0,0,0,,Ах~ Секиралалалала~.
Dialogue: 0,0:15:39.25,0:15:41.25,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:41.25,0:15:43.25,Default,,0,0,0,,Араре-чанның «Маған ұнайды» →
Dialogue: 0,0:15:43.25,0:15:45.59,Default,,0,0,0,,Цуко-чанға айтайық! иә?
Dialogue: 0,0:15:45.59,0:15:48.26,Default,,0,0,0,,♬〜 Цуко-чанның жағдайы нашар →
Dialogue: 0,0:15:48.26,0:15:51.19,Default,,0,0,0,,Менің ойымша, Араре-чан оны емдей алады!
Dialogue: 0,0:15:51.19,0:15:54.53,Default,,0,0,0,,Өйткені «лайктың» күші бар!
Dialogue: 0,0:15:54.53,0:15:57.03,Default,,0,0,0,,Қуат….
Dialogue: 0,0:15:57.03,0:15:59.87,Default,,0,0,0,,Цуко-чанға «чу~» деп айтайық!
Dialogue: 0,0:15:59.87,0:16:02.71,Default,,0,0,0,,≪Бучу~. ≫
Dialogue: 0,0:16:02.71,0:16:06.21,Default,,0,0,0,,Чу~? ? ?
Dialogue: 0,0:16:06.21,0:16:08.55,Default,,0,0,0,,Артқа қайтып, тұрған суретті түзетіңіз→
Dialogue: 0,0:16:08.55,0:16:10.61,Default,,0,0,0,,Түскі асқа дейін қолжазбамен жұмыс.
Dialogue: 0,0:16:10.61,0:16:13.31,Default,,0,0,0,,Одан кейін пернетақтаны жаттықтырдық... Ах.
Dialogue: 0,0:16:18.62,0:16:21.56,Default,,0,0,0,,Кәмпит? Цуко-чан!
Dialogue: 0,0:16:21.56,0:16:24.23,Default,,0,0,0,,Бұл 3 секунд ережесі. А...?
Dialogue: 0,0:16:24.23,0:16:26.23,Default,,0,0,0,,Таймерді бастау. (ысқырық дыбысы)
Dialogue: 0,0:16:26.23,0:16:28.90,Default,,0,0,0,,♬〜 １･２･３
Dialogue: 0,0:16:28.90,0:16:31.74,Default,,0,0,0,,１･２･３
Dialogue: 0,0:16:31.74,0:16:35.24,Default,,0,0,0,,１･２･３ … １…
Dialogue: 0,0:16:35.24,0:16:37.91,Default,,0,0,0,,≪Мен Цуко-чанды әкелемін! ≫
Dialogue: 0,0:16:37.91,0:16:39.91,Default,,0,0,0,,≪Араре-чан, осында күте тұрыңыз! ≫
Dialogue: 0,0:16:39.91,0:16:42.75,Default,,0,0,0,,≪Аме Аме Изанай Дайсакуз~! ≫
Dialogue: 0,0:16:42.75,0:16:45.08,Default,,0,0,0,,≪Жүр! ≫
Dialogue: 0,0:16:45.08,0:16:47.08,Default,,0,0,0,,Маған солай айтылды...
Dialogue: 0,0:16:47.08,0:16:52.86,Default,,0,0,0,,〜… １･２･３
Dialogue: 0,0:16:52.86,0:16:55.19,Default,,0,0,0,,１･２･３
Dialogue: 0,0:16:55.19,0:16:58.03,Default,,0,0,0,,１･２･３
Dialogue: 0,0:16:58.03,0:17:04.03,Default,,0,0,0,,１･２･３  １･２･３
Dialogue: 0,0:17:04.03,0:17:07.10,Default,,0,0,0,,１･２･３
Dialogue: 0,0:17:07.10,0:17:15.05,Default,,0,0,0,,Ах! Цуко-чан сонда болды! Тәттілер үйі. Міне, міне!
Dialogue: 0,0:17:15.05,0:17:18.05,Default,,0,0,0,,Сәлем, Яко-сенсей! Накамачи мырза?
Dialogue: 0,0:17:18.05,0:17:20.05,Default,,0,0,0,,Бүгін ауа-райы жақсы → (хабарландыру дыбысы)
Dialogue: 0,0:17:20.05,0:17:22.05,Default,,0,0,0,,Сізге қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,0:17:22.05,0:17:24.72,Default,,0,0,0,,Манет мырзадан...
Dialogue: 0,0:17:24.72,0:17:26.72,Default,,0,0,0,,♬〜 ≪Сонымен! Түні бойы ұйқысыз болған соң →
Dialogue: 0,0:17:26.72,0:17:29.39,Default,,0,0,0,,Өмірімді қатерге тігіп таңертең сапқа тұрдым, бірақ көз алдымнан ғайып болды→
Dialogue: 0,0:17:29.39,0:17:33.06,Default,,0,0,0,,Йодошима Үлкен Денкидің көз жасы шектеулі стикер! ≫ ≪Ах! ≫
Dialogue: 0,0:17:33.06,0:17:36.73,Default,,0,0,0,,≪Барлық келушілер үшін тарату кестесі делдалдардың алдын алу үшін асығыс өзгертілді→
Dialogue: 0,0:17:36.73,0:17:41.53,Default,,0,0,0,,Тешима Spa Highland фантомы шектеулі жапсырмасы өте сирек болды! ≫
Dialogue: 0,0:17:46.05,0:17:48.05,Default,,0,0,0,,күрсіну… күрсіну…. Араре-чан.
Dialogue: 0,0:17:48.05,0:17:50.38,Default,,0,0,0,,Сәттілік! Ха!
Dialogue: 0,0:17:50.38,0:17:52.72,Default,,0,0,0,,Профессор Яко Фуджими! Иә!
Dialogue: 0,0:17:52.72,0:17:55.39,Default,,0,0,0,,♬〜 Мен Яко ханымның жұмысын алғаш рет кездестірдім→
Dialogue: 0,0:17:55.39,0:17:57.72,Default,,0,0,0,,6-сыныпта оқып жүргенімде досымның әпкесі көрсетті →
Dialogue: 0,0:17:57.72,0:18:01.06,Default,,0,0,0,,Маджи Руру иллюстрациясы! Мен бір көргеннен баурап алдым.
Dialogue: 0,0:18:01.06,0:18:04.06,Default,,0,0,0,,Содан туған күніме сыйлық ретінде алған смартфонды пайдаландым→
Dialogue: 0,0:18:04.06,0:18:06.07,Default,,0,0,0,,Сурет салу алаңына еніңіз.
Dialogue: 0,0:18:06.07,0:18:08.90,Default,,0,0,0,,Маджи руру жанрында ең көп лайк жинаған мұғалімнің суреті →
Dialogue: 0,0:18:08.90,0:18:12.24,Default,,0,0,0,,Несін айтамын, басқалардан бөлек сапта болдым!
Dialogue: 0,0:18:12.24,0:18:15.07,Default,,0,0,0,,Бұл кейіпкердің әрбір жолында сүйкімді нәрсе бар →
Dialogue: 0,0:18:15.07,0:18:17.41,Default,,0,0,0,,Осы жерді жақсы көретіндей сезімге толып кеттім→
Dialogue: 0,0:18:17.41,0:18:20.48,Default,,0,0,0,,Мен барлығын жай жолдармен жеткізуге болатыны таңқаларлық деп ойладым→
Dialogue: 0,0:18:20.48,0:18:23.75,Default,,0,0,0,,Мен мұны білмей тұрып, мұғалімнің салған суреттерін үнемі бақылап отыратынмын.
Dialogue: 0,0:18:23.75,0:18:28.25,Default,,0,0,0,,Серияландыру! Маған сенің салған әңгімелерің қатты ұнайды...
Dialogue: 0,0:18:28.25,0:18:31.05,Default,,0,0,0,,♬〜
Dialogue: 0,0:18:32.76,0:18:36.06,Default,,0,0,0,,≪Мінекей…. ≫
Dialogue: 0,0:18:38.60,0:18:40.60,Default,,0,0,0,,Араре-чан?
Dialogue: 0,0:18:40.60,0:18:43.44,Default,,0,0,0,,Харья~.
Dialogue: 0,0:18:43.44,0:18:47.11,Default,,0,0,0,,А... ха... ≪Мені тартып алды. Мен саған қиындық туғыздым. ≫
Dialogue: 0,0:18:47.11,0:18:50.91,Default,,0,0,0,,≪Мен сөйлеспеу керектігін білдім! ! ≫
Dialogue: 0,0:18:54.05,0:18:56.05,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:18:58.55,0:19:01.22,Default,,0,0,0,,≪Мен бұл станцияны пайдаланбауым керек еді! ≫
Dialogue: 0,0:19:01.22,0:19:03.22,Default,,0,0,0,,(Пойыздың жөнелту қоңырауы)
Dialogue: 0,0:19:16.24,0:19:21.57,Default,,0,0,0,,≪Мен сені сол вокзалда кездестірдім, сондықтан мен мұнда өзгердім. ≫
Dialogue: 0,0:19:21.57,0:19:23.64,Default,,0,0,0,,♬〜
Dialogue: 0,0:19:23.64,0:19:27.65,Default,,0,0,0,,≪Одан қаншалықты аулақ жүрсеңіз... ≫
Dialogue: 0,0:19:27.65,0:19:31.65,Default,,0,0,0,,≪Ол кезде мен... ≫
Dialogue: 0,0:19:33.42,0:19:55.44,Default,,0,0,0,,♪〜(пернетақта дыбысы)
Dialogue: 0,0:19:55.44,0:19:57.44,Default,,0,0,0,,А...
Dialogue: 0,0:20:02.62,0:20:05.92,Default,,0,0,0,,≪Сіздің салған әңгімелеріңіз маған қатты ұнайды... ≫
Dialogue: 0,0:20:10.39,0:20:14.39,Default,,0,0,0,,А, мен бұл сақтау үшін тағы бір нәрсе екеніне сенімдімін.
Dialogue: 0,0:20:16.06,0:20:20.86,Default,,0,0,0,,Армандар - күш! Армандар - күш! Менің арманым...
Dialogue: 0,0:20:26.21,0:20:33.91,Default,,0,0,0,,♬〜
Dialogue: 0,0:20:33.91,0:20:35.98,Default,,0,0,0,,Қайырлы таң, Араре-чан.
Dialogue: 0,0:20:35.98,0:20:37.98,Default,,0,0,0,,Ммммммммм.
Dialogue: 0,0:20:37.98,0:20:39.99,Default,,0,0,0,,Ауыз патроны? иә~.
Dialogue: 0,0:20:39.99,0:20:42.42,Default,,0,0,0,,О, дұрыс. иә~!
Dialogue: 0,0:20:42.42,0:20:44.52,Default,,0,0,0,,Иә. иә? Ах.
Dialogue: 0,0:20:44.52,0:20:47.23,Default,,0,0,0,,Қайырлы таң, Цуко-чан.
Dialogue: 0,0:20:47.23,0:20:49.26,Default,,0,0,0,,Хмм….
Dialogue: 0,0:20:49.26,0:20:52.27,Default,,0,0,0,,Кешегі күн үшін рахмет
Dialogue: 0,0:20:52.27,0:20:55.03,Default,,0,0,0,,Иә! ? Ммммммммммм! ?
Dialogue: 0,0:20:55.03,0:20:58.10,Default,,0,0,0,,Иә. Пуа! Бұл ыңғайсыздық
Dialogue: 0,0:20:58.10,0:21:00.11,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:21:00.11,0:21:03.91,Default,,0,0,0,,♬~ Накамачи-санның әсері Бұл менің жүрегімді қатты тебірентті.
Dialogue: 0,0:21:05.71,0:21:07.71,Default,,0,0,0,,Бұл.
Dialogue: 0,0:21:09.38,0:21:11.88,Default,,0,0,0,,Сіз сенімдісіз бе? ? Егер бұл Араре-сан болса.
Dialogue: 0,0:21:11.88,0:21:14.39,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:21:14.39,0:21:18.06,Default,,0,0,0,,Цуко-чанның емі өте сәтті болды.
Dialogue: 0,0:21:18.06,0:21:22.06,Default,,0,0,0,,Сөйлесу өте жақсы болды. иә!
Dialogue: 0,0:21:22.06,0:21:24.06,Default,,0,0,0,,Миянаға мырзаның пікіріне жауап ретінде →
Dialogue: 0,0:21:24.06,0:21:26.90,Default,,0,0,0,,Мен баспадан мәлімдеме жасауды сұрауды шештім.
Dialogue: 0,0:21:26.90,0:21:30.57,Default,,0,0,0,,Рахмет. Бірақ оны асыра алмаңыз.
Dialogue: 0,0:21:30.57,0:21:33.57,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:21:33.57,0:21:37.08,Default,,0,0,0,,Фудзицуко Енді мен екі жұп сандал кидім→
Dialogue: 0,0:21:37.08,0:21:40.91,Default,,0,0,0,,Жүгіруге дайын! о~! керемет~!
Dialogue: 0,0:21:40.91,0:21:42.92,Default,,0,0,0,,(лифт қоңырауы)
Dialogue: 0,0:21:42.92,0:21:45.25,Default,,0,0,0,,♬〜 Бұл стикер ме? иә!
Dialogue: 0,0:21:45.25,0:21:52.02,Default,,0,0,0,,≪Сұлу Гото, Бурикко, Күншуақ.≫
Dialogue: 0,0:21:52.02,0:21:54.02,Default,,0,0,0,,≪Мен бұған жақсы емеспін. ≫
Dialogue: 0,0:21:55.70,0:21:57.70,Default,,0,0,0,,♬〜“Жұмбақ жоқ”
Dialogue: 0,0:21:57.70,0:22:00.03,Default,,0,0,0,,♬ Құстар не үшін ұшады?
Dialogue: 0,0:22:00.03,0:22:04.10,Default,,0,0,0,,♬ Неліктен мысық үнемі ұйықтап жатыр?
Dialogue: 0,0:22:04.10,0:22:08.04,Default,,0,0,0,,♬ Бүгін қандай күнде өмір сүріп жатырсыз?
Dialogue: 0,0:22:08.04,0:22:13.38,Default,,0,0,0,,♬ Бәрін іздеп көрейік.
Dialogue: 0,0:22:13.38,0:22:19.72,Default,,0,0,0,,♬ (Лалала…)
Dialogue: 0,0:22:19.72,0:22:24.02,Default,,0,0,0,,♬ Неліктен таңертең маған жарық түседі?
Dialogue: 0,0:22:24.02,0:22:27.73,Default,,0,0,0,,♬ Неліктен түнде өзіңді жалғыз сезінесің?
Dialogue: 0,0:22:27.73,0:22:35.80,Default,,0,0,0,,♬ Қайғылы жайттарды жазып алсам ғой.
Dialogue: 0,0:22:35.80,0:22:44.08,Default,,0,0,0,,♬ Осы кең дүниенің түкпір-түкпірінде күліп, уайымдаңыз
Dialogue: 0,0:22:44.08,0:22:51.88,Default,,0,0,0,,♬ Үйіміздің жұмбақтарын ашуға тырысайық.
Dialogue: 0,0:22:53.52,0:22:57.02,Default,,0,0,0,,♬ Бүгін не туралы сөйлесуіміз керек?
Dialogue: 0,0:22:57.02,0:23:01.03,Default,,0,0,0,,♬ Сенімен қандай ән айтайын?
Dialogue: 0,0:23:01.03,0:23:05.03,Default,,0,0,0,,♬ Әлі ешкім білмейтін гүлдер
Dialogue: 0,0:23:05.03,0:23:13.11,Default,,0,0,0,,♬ Барлығын іздеп көрейік.
Dialogue: 0,0:23:13.11,0:23:18.31,Default,,0,0,0,,♬ Бәрін іздеп көрейік.
