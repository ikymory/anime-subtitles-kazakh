Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.82,0:00:09.65,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:10.61,0:00:12.78,Default,,0,0,0,,Бұл дәмді Химекама-кун болды
Dialogue: 0,0:00:13.36,0:00:15.62,Default,,0,0,0,,Сіз дарынды аспазсыз.
Dialogue: 0,0:00:15.70,0:00:19.24,Default,,0,0,0,,Егер сіз аспаздық мамандығын таңдасаңыз, мекемеңіз сізге қолдау көрсетер ме еді?
Dialogue: 0,0:00:19.33,0:00:20.87,Default,,0,0,0,,Таңдау? Ха
Dialogue: 0,0:00:21.37,0:00:24.58,Default,,0,0,0,,Мекемелер қолдаған талант – Құдайдың сыйы.
Dialogue: 0,0:00:24.67,0:00:26.25,Default,,0,0,0,,Сіз таңдай алмайсыз
Dialogue: 0,0:00:26.83,0:00:29.46,Default,,0,0,0,,Белгіленген рөлмен туған
Dialogue: 0,0:00:29.55,0:00:32.51,Default,,0,0,0,,Өмірдің мәнін іздеудің қажеті жоқ.
Dialogue: 0,0:00:32.59,0:00:34.68,Default,,0,0,0,,Иә, бұл игілік.
Dialogue: 0,0:00:45.31,0:00:47.23,Default,,0,0,0,,Сензокуға құрметпен қарау.
Dialogue: 0,0:00:47.94,0:00:51.28,Default,,0,0,0,,Бұл жағдайға байланысты. Біз ешқандай уәде бере алмаймыз.
Dialogue: 0,0:00:51.36,0:00:53.19,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:00:54.45,0:00:55.20,Default,,0,0,0,,Иә
Dialogue: 0,0:00:59.16,0:01:00.74,Default,,0,0,0,,Мәңгі сол жерде
Dialogue: 0,0:01:00.83,0:01:03.33,Default,,0,0,0,,Біз оларға үйде ойнауға рұқсат ете алмаймыз.
Dialogue: 0,0:01:03.83,0:01:05.29,Default,,0,0,0,,Эй, күт!
Dialogue: 0,0:01:05.79,0:01:08.67,Default,,0,0,0,,Сензоку-чан, бұл бар емес.
Dialogue: 0,0:01:08.75,0:01:10.75,Default,,0,0,0,,Уа, түстен бастап ішсем болады ма?
Dialogue: 0,0:01:10.84,0:01:13.09,Default,,0,0,0,,Иә, Мизуки жартылай мас.
Dialogue: 0,0:01:13.17,0:01:14.84,Default,,0,0,0,,Абэ-сан жұмыста
Dialogue: 0,0:01:14.92,0:01:16.26,Default,,0,0,0,,Бүгінгісі де керемет.
Dialogue: 0,0:01:16.34,0:01:19.05,Default,,0,0,0,,Бұл сендзоку ерекше тағам болғандықтан, Китамура мырза оны да жей ме?
Dialogue: 0,0:01:19.14,0:01:20.93,Default,,0,0,0,,Жеңдер~! (Ёнеока) Иә, иә, мен де.
Dialogue: 0,0:01:21.01,0:01:21.72,Default,,0,0,0,,Мен де (Чизоку) Иә!
Dialogue: 0,0:01:21.81,0:01:24.18,Default,,0,0,0,,Арнайы 1 мылтық, 2 мылтық, 3 мылтық!
Dialogue: 0,0:01:26.60,0:01:29.31,Default,,0,0,0,,Такина Үш ерекшелік!
Dialogue: 0,0:01:29.40,0:01:31.57,Default,,0,0,0,,Осылай жалғаса берсе жаман.
Dialogue: 0,0:01:31.65,0:01:32.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:36.61,0:01:38.20,Default,,0,0,0,,Уау~ Ммм
Dialogue: 0,0:01:39.07,0:01:40.66,Default,,0,0,0,,Бұл қызыл түсте.
Dialogue: 0,0:01:40.74,0:01:43.70,Default,,0,0,0,,Сұраныс бойынша алған ақшаңызды қоссаңыз да, міне осы.
Dialogue: 0,0:01:43.79,0:01:47.25,Default,,0,0,0,,Оқ-дәрі мен көлік ақысын қалай төлейсіз?
Dialogue: 0,0:01:47.33,0:01:49.63,Default,,0,0,0,,DA-дан қолдау ақшасы бар.
Dialogue: 0,0:01:49.71,0:01:52.21,Default,,0,0,0,,Ол Сензокудың мия қызметі үшін төлем деп аталады.
Dialogue: 0,0:01:52.30,0:01:54.21,Default,,0,0,0,,Сіздің аяқтарыңыз толығымен шығып кетті.
Dialogue: 0,0:01:54.30,0:01:57.01,Default,,0,0,0,,Бұл жігіт жоғары оқтарды көп атады.
Dialogue: 0,0:01:57.09,0:01:58.63,Default,,0,0,0,,Бұл парфет те Иә!
Dialogue: 0,0:01:58.72,0:02:02.51,Default,,0,0,0,,Ол тәуелсізмін десе де, ол ақша үшін ДА-ға сенетінін айтты.
Dialogue: 0,0:02:02.60,0:02:05.85,Default,,0,0,0,,Уф~ Кусуноки-сан сияқты нәрсе.
Dialogue: 0,0:02:06.52,0:02:08.81,Default,,0,0,0,,Ух... эхехехе
Dialogue: 0,0:02:09.73,0:02:11.06,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:02:11.56,0:02:14.57,Default,,0,0,0,,Бұдан былай мен Рико-Риконың бухгалтерлік есебіне жауапты боламын!
Dialogue: 0,0:02:15.07,0:02:17.07,Default,,0,0,0,,♪~
Dialogue: 0,0:03:42.07,0:03:44.07,Default,,0,0,0,,~♪
Dialogue: 0,0:03:47.99,0:03:49.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:49.33,0:03:50.54,Default,,0,0,0,,Уф (Қашқын) Уф
Dialogue: 0,0:03:50.62,0:03:51.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:54.00,0:03:54.79,Default,,0,0,0,,Сензоку
Dialogue: 0,0:03:54.88,0:03:57.29,Default,,0,0,0,,Тазартқыштарды пайдалану көп ақшаны талап етеді.
Dialogue: 0,0:03:57.38,0:04:02.05,Default,,0,0,0,,Сайтты бұзбайтын және ағымдағы күйге оралуды қажет етпейтін әрекеттерді есте сақтаңыз.
Dialogue: 0,0:04:02.55,0:04:04.01,Default,,0,0,0,,Fu~i
Dialogue: 0,0:04:04.09,0:04:05.51,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:05.59,0:04:07.56,Default,,0,0,0,,Не? Уау~
Dialogue: 0,0:04:07.64,0:04:08.72,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:04:08.81,0:04:10.85,Default,,0,0,0,,(Мың ыңырану)
Dialogue: 0,0:04:13.39,0:04:14.27,Default,,0,0,0,,Уау
Dialogue: 0,0:04:14.35,0:04:15.15,Default,,0,0,0,,(Сензоку но Секикоми)
Dialogue: 0,0:04:16.94,0:04:18.86,Default,,0,0,0,,Сіз тым көп аттыңыз (Чизоку) Иә~
Dialogue: 0,0:04:23.36,0:04:25.03,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:27.32,0:04:30.20,Default,,0,0,0,,Тоңазытқышты ашық қалдыру - электр энергиясын ысырап ету.
Dialogue: 0,0:04:30.29,0:04:31.29,Default,,0,0,0,,Менго
Dialogue: 0,0:04:31.87,0:04:33.91,Default,,0,0,0,,3… 7…
Dialogue: 0,0:04:35.29,0:04:36.13,Default,,0,0,0,,Бұл – тура қызыл карта. (Бакуго) Тс.
Dialogue: 0,0:04:37.13,0:04:38.67,Default,,0,0,0,,Соро-ри ух...
Dialogue: 0,0:04:38.75,0:04:41.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:44.18,0:04:45.76,Default,,0,0,0,,(Оқушы) 15 минут па? (Изуку) Мен үшін ұпайлар аса маңызды емес.
Dialogue: 0,0:04:48.22,0:04:49.97,Default,,0,0,0,,(Такинано күрсініп)
Dialogue: 0,0:04:59.52,0:05:01.98,Default,,0,0,0,,Енді сен біткен соң мен үйге қайтайын Аль.
Dialogue: 0,0:05:02.07,0:05:03.65,Default,,0,0,0,,Мен сыйлығымды әлі алған жоқпын.
Dialogue: 0,0:05:03.74,0:05:04.99,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:05:06.03,0:05:06.91,Default,,0,0,0,,Сіз бұл туралы айтып отырсыз ба?
Dialogue: 0,0:05:06.99,0:05:08.12,Default,,0,0,0,,Сәлем (1-ші серуенші) Ах!
Dialogue: 0,0:05:08.20,0:05:09.49,Default,,0,0,0,,Мылтық!
Dialogue: 0,0:05:09.58,0:05:10.49,Default,,0,0,0,,Айт
Dialogue: 0,0:05:10.58,0:05:11.37,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:05:11.45,0:05:12.12,Default,,0,0,0,,Ихихи
Dialogue: 0,0:05:12.20,0:05:14.37,Default,,0,0,0,,Бұл біз емеспіз.
Dialogue: 0,0:05:14.46,0:05:15.37,Default,,0,0,0,,Сол жексұрын Зекро — осылайша кетіп қалды ма?
Dialogue: 0,0:05:15.46,0:05:16.75,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:17.58,0:05:18.58,Default,,0,0,0,,Аһ!
Dialogue: 0,0:05:18.67,0:05:19.29,Default,,0,0,0,,Эй, тоқта...
Dialogue: 0,0:05:19.38,0:05:20.75,Default,,0,0,0,,Әй
Dialogue: 0,0:05:20.84,0:05:23.71,Default,,0,0,0,,Гуах! Кууууу~
Dialogue: 0,0:05:23.80,0:05:25.67,Default,,0,0,0,,А... а?
Dialogue: 0,0:05:25.76,0:05:27.64,Default,,0,0,0,,Қалай... қалай? Не... неге?
Dialogue: 0,0:05:27.72,0:05:29.30,Default,,0,0,0,,Сіз төлемейсіз.
Dialogue: 0,0:05:29.39,0:05:31.60,Default,,0,0,0,,Уа~ча~!
Dialogue: 0,0:05:33.43,0:05:34.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:35.39,0:05:36.27,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:05:36.35,0:05:37.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:37.31,0:05:39.44,Default,,0,0,0,,(таймер дыбысы)
Dialogue: 0,0:05:39.52,0:05:42.02,Default,,0,0,0,,Негізі бізде әлі соңғы екі кітап қалды.
Dialogue: 0,0:05:42.11,0:05:43.90,Default,,0,0,0,,Иә~
Dialogue: 0,0:05:43.98,0:05:46.07,Default,,0,0,0,,Қалғаны өзіңізге байланысты.
Dialogue: 0,0:05:48.95,0:05:51.83,Default,,0,0,0,,Түсіндім! Мен... төлеймін.
Dialogue: 0,0:05:53.24,0:05:55.16,Default,,0,0,0,,Хун (сензоку) жігіттері~
Dialogue: 0,0:05:55.25,0:05:58.21,Default,,0,0,0,,Көрдіңіз бе? Сіз оны көрдіңіз бе? Мен бір ғана оқ аттым.
Dialogue: 0,0:05:58.29,0:06:00.71,Default,,0,0,0,,Сіз қалай ойлайсыз? Жарайсың.
Dialogue: 0,0:06:00.79,0:06:02.29,Default,,0,0,0,,Мені мақтады!
Dialogue: 0,0:06:02.38,0:06:04.26,Default,,0,0,0,,Хи-и иә
Dialogue: 0,0:06:07.34,0:06:08.43,Default,,0,0,0,,Мизуки мырза
Dialogue: 0,0:06:08.51,0:06:11.01,Default,,0,0,0,,Мен сол жаңа парфей туралы ойладым.
Dialogue: 0,0:06:11.10,0:06:13.64,Default,,0,0,0,,Не? Көргім келеді, көргім келеді, жасағым келеді.
Dialogue: 0,0:06:15.14,0:06:17.60,Default,,0,0,0,,Қазір суытып тұрғанда дәмді...
Dialogue: 0,0:06:17.69,0:06:19.81,Default,,0,0,0,,Ыстық шоколады көп парфе
Dialogue: 0,0:06:19.90,0:06:21.02,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:21.52,0:06:23.36,Default,,0,0,0,,Гудмо... Бұл не?
Dialogue: 0,0:06:23.44,0:06:26.53,Default,,0,0,0,,Бұл мен ойлап тапқан жаңа мәзір. Сіз қалай ойлайсыз?
Dialogue: 0,0:06:26.61,0:06:28.11,Default,,0,0,0,,Бұл... шш!
Dialogue: 0,0:06:28.20,0:06:29.16,Default,,0,0,0,,Сензоку?
Dialogue: 0,0:06:30.53,0:06:32.91,Default,,0,0,0,,Мм... Иә, жақсы деп ойлаймын.
Dialogue: 0,0:06:32.99,0:06:34.03,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:34.12,0:06:34.83,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:06:35.74,0:06:37.29,Default,,0,0,0,,Шыдамдылығыңыз үшін рахмет!
Dialogue: 0,0:06:37.37,0:06:38.75,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:06:46.26,0:06:48.13,Default,,0,0,0,,Тағы 3 қосыңыз! Чизоку: Бұл екінші нөмір.
Dialogue: 0,0:06:48.22,0:06:50.09,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:06:52.26,0:06:53.05,Default,,0,0,0,,Иә
Dialogue: 0,0:06:53.14,0:06:54.60,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:57.14,0:06:58.93,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:06:59.02,0:06:59.77,Default,,0,0,0,,Хмм…
Dialogue: 0,0:06:59.85,0:07:01.06,Default,,0,0,0,,Жаңғақ па?
Dialogue: 0,0:07:01.56,0:07:03.02,Default,,0,0,0,,№3 Тұр!
Dialogue: 0,0:07:03.11,0:07:03.73,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:07:04.40,0:07:05.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:05.36,0:07:06.98,Default,,0,0,0,,Сіз жұмыс істейсіз бе?
Dialogue: 0,0:07:07.07,0:07:09.15,Default,,0,0,0,,Қандай жел соғады?
Dialogue: 0,0:07:09.24,0:07:12.95,Default,,0,0,0,,Чизоку қолы бос емес болғандықтан, менен де мұны істеуімді өтінді.
Dialogue: 0,0:07:13.57,0:07:15.95,Default,,0,0,0,,О... күте тұрыңыз...
Dialogue: 0,0:07:16.04,0:07:18.41,Default,,0,0,0,,Мен сенің үмітіңе сүйенемін, Гран Торино
Dialogue: 0,0:07:18.50,0:07:20.25,Default,,0,0,0,,Бұл бала интернетте болмаған.
Dialogue: 0,0:07:20.33,0:07:22.33,Default,,0,0,0,,Дүкенде жаңасыз ба? Жасың нешеде?
Dialogue: 0,0:07:22.96,0:07:23.71,Default,,0,0,0,,Бұл құпия
Dialogue: 0,0:07:23.79,0:07:26.30,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:07:26.38,0:07:29.26,Default,,0,0,0,,Әлі көп нәрсе бар. Тездетіп алыңыз...
Dialogue: 0,0:07:29.34,0:07:32.01,Default,,0,0,0,,Хехехехехе... Не деп күліп тұрсың?
Dialogue: 0,0:07:32.09,0:07:35.51,Default,,0,0,0,,Келесі кезекте кезекте тұрғандар, сізді күткеніміз үшін кешіріңіз, осы жерді басыңыз.
Dialogue: 0,0:07:35.60,0:07:37.22,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:07:37.31,0:07:39.18,Default,,0,0,0,,Хихихи~ Хии~ Фу Фу
Dialogue: 0,0:07:39.89,0:07:42.65,Default,,0,0,0,,Мизуки, осында келіңіз!
Dialogue: 0,0:07:42.73,0:07:44.10,Default,,0,0,0,,Сәлем~ Гьяхья
Dialogue: 0,0:07:45.36,0:07:47.27,Default,,0,0,0,,Иә кафе Рико Рико
Dialogue: 0,0:07:47.98,0:07:48.98,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:07:49.07,0:07:49.69,Default,,0,0,0,,Сензоку!
Dialogue: 0,0:07:49.78,0:07:52.66,Default,,0,0,0,,Хмм? Бұл профессор Ямагиши.
Dialogue: 0,0:07:53.57,0:07:55.16,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:07:55.24,0:07:58.70,Default,,0,0,0,,Міне! Тексеріңіз, бүгін сіздің кездесуіңіз!
Dialogue: 0,0:07:58.79,0:08:02.08,Default,,0,0,0,,Кешіріңіз, бірақ шын мәнінде...
Dialogue: 0,0:08:02.16,0:08:04.17,Default,,0,0,0,,Дүкен тым бос емес
Dialogue: 0,0:08:04.25,0:08:05.21,Default,,0,0,0,,Не? Хехехе!
Dialogue: 0,0:08:05.29,0:08:06.34,Default,,0,0,0,,Жоқ, білмеймін.
Dialogue: 0,0:08:06.42,0:08:07.84,Default,,0,0,0,,Жаса!
Dialogue: 0,0:08:07.92,0:08:10.34,Default,,0,0,0,,Ах... Ахаха
Dialogue: 0,0:08:10.84,0:08:15.05,Default,,0,0,0,,Жақында... Иә, көп рахмет.
Dialogue: 0,0:08:15.14,0:08:16.10,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:08:16.60,0:08:18.01,Default,,0,0,0,,Бүгін де келмейді.
Dialogue: 0,0:08:19.06,0:08:20.31,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:22.89,0:08:24.27,Default,,0,0,0,,Біртүрлі жаңадан келген адам
Dialogue: 0,0:08:24.77,0:08:26.90,Default,,0,0,0,,Бірінші жаттығу ~ №
Dialogue: 0,0:08:26.98,0:08:27.94,Default,,0,0,0,,мысық
Dialogue: 0,0:08:28.02,0:08:28.98,Default,,0,0,0,,Хмм, Нуко!
Dialogue: 0,0:08:29.07,0:08:31.61,Default,,0,0,0,,Мияу! (Оқушылар) Нуко!
Dialogue: 0,0:08:31.69,0:08:33.90,Default,,0,0,0,,Ину (Сензоку) Инну ван ван!
Dialogue: 0,0:08:33.99,0:08:35.86,Default,,0,0,0,,Инну Инну…
Dialogue: 0,0:08:35.95,0:08:37.45,Default,,0,0,0,,Ину Инуу~
Dialogue: 0,0:08:37.53,0:08:38.41,Default,,0,0,0,,Қолмен тіреу!
Dialogue: 0,0:08:38.49,0:08:39.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:39.16,0:08:42.25,Default,,0,0,0,,Сақа... Сақа... (Оқушы) Сакадачи
Dialogue: 0,0:08:42.33,0:08:43.04,Default,,0,0,0,,Маған сен!
Dialogue: 0,0:08:43.12,0:08:44.92,Default,,0,0,0,,Ит жоқ! Ит!
Dialogue: 0,0:08:45.00,0:08:47.54,Default,,0,0,0,,Ит ит
Dialogue: 0,0:08:47.63,0:08:49.13,Default,,0,0,0,,Жалаңаш Кадзиме~! (Оқушылар) Жалаңаш Кадзиме!
Dialogue: 0,0:08:49.21,0:08:49.84,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:08:49.92,0:08:52.38,Default,,0,0,0,,Мұндай ересек адамға айналмау керек.
Dialogue: 0,0:08:53.92,0:08:55.80,Default,,0,0,0,,Бүгін шын мәнінде... (Чизоку) Алда-жалда!
Dialogue: 0,0:08:56.51,0:08:59.35,Default,,0,0,0,,Бұл жерде бізге жеткілікті. Бөлісейік.
Dialogue: 0,0:08:59.43,0:09:00.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.35,0:09:02.22,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:02.31,0:09:03.52,Default,,0,0,0,,Бұл мен ғана
Dialogue: 0,0:09:03.60,0:09:04.98,Default,,0,0,0,,Бұл сыртқы шеңбер!
Dialogue: 0,0:09:16.78,0:09:17.91,Default,,0,0,0,,Уау
Dialogue: 0,0:09:18.66,0:09:21.29,Default,,0,0,0,,Алдау немесе емдеу!
Dialogue: 0,0:09:21.91,0:09:23.04,Default,,0,0,0,,Хэллоуин құтты болсын
Dialogue: 0,0:09:23.12,0:09:25.12,Default,,0,0,0,,Уау, хаха, жақсы қыз.
Dialogue: 0,0:09:25.62,0:09:26.71,Default,,0,0,0,,Хэллоуин мерекесі құтты болсын
Dialogue: 0,0:09:26.79,0:09:28.71,Default,,0,0,0,,Уау, қандай жақсы қыз.
Dialogue: 0,0:09:28.79,0:09:30.67,Default,,0,0,0,,Хэллоуин құтты болсын, сен жақсы қызсың~
Dialogue: 0,0:09:30.75,0:09:31.88,Default,,0,0,0,,Хмм (Чизоку) Ах~!
Dialogue: 0,0:09:31.96,0:09:34.55,Default,,0,0,0,,Мен де Такинаның сыйлығын алғым келеді~
Dialogue: 0,0:09:34.63,0:09:35.42,Default,,0,0,0,,Сіз баласыз ба?
Dialogue: 0,0:09:35.51,0:09:36.76,Default,,0,0,0,,Үлкен сөмке!
Dialogue: 0,0:09:37.38,0:09:39.76,Default,,0,0,0,,Сензоку-оне-чан, мен де осыны ала аламын ба?
Dialogue: 0,0:09:39.85,0:09:41.72,Default,,0,0,0,,Жарайды~ (Балалар) Жарайсыңдар!
Dialogue: 0,0:09:41.81,0:09:43.89,Default,,0,0,0,,Уау, ақша! (Балалар) Банк ойынын ойнайық
Dialogue: 0,0:09:43.97,0:09:45.18,Default,,0,0,0,,Мен де (бала) Мен де
Dialogue: 0,0:09:45.27,0:09:47.39,Default,,0,0,0,,Ха ха ха, әкел, әкел~
Dialogue: 0,0:09:47.48,0:09:48.65,Default,,0,0,0,,Иә, жоқ!
Dialogue: 0,0:09:52.23,0:09:54.03,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:09:54.69,0:09:58.57,Default,,0,0,0,,(динамиктерден ойналатын музыка)
Dialogue: 0,0:09:59.91,0:10:01.37,Default,,0,0,0,,Фуфу~н
Dialogue: 0,0:10:04.20,0:10:05.91,Default,,0,0,0,,Ахаха~
Dialogue: 0,0:10:08.71,0:10:10.21,Default,,0,0,0,,Бум-бум Сәлем
Dialogue: 0,0:10:10.29,0:10:13.75,Default,,0,0,0,,Бұл АТ революциясы ма? Бұл арзан болды.
Dialogue: 0,0:10:14.25,0:10:16.38,Default,,0,0,0,,Жаңғақтан да жақсы
Dialogue: 0,0:10:18.93,0:10:21.55,Default,,0,0,0,,Ал, неше түрлі түрлері бар.
Dialogue: 0,0:10:21.64,0:10:24.39,Default,,0,0,0,,Иә? Такина-сама, қайда бардың?
Dialogue: 0,0:10:24.47,0:10:25.60,Default,,0,0,0,,Жаңғақтар да
Dialogue: 0,0:10:25.68,0:10:27.31,Default,,0,0,0,,Мен дәл қазір сонда болсам да
Dialogue: 0,0:10:27.39,0:10:29.14,Default,,0,0,0,,Мм... (Сензоку) Міне?
Dialogue: 0,0:10:29.23,0:10:31.65,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұл күдікті.
Dialogue: 0,0:10:32.73,0:10:33.82,Default,,0,0,0,,Акциялар?
Dialogue: 0,0:10:33.90,0:10:37.57,Default,,0,0,0,,Егер мен Курумимен бірігіп, инвестиция салсам ше?
Dialogue: 0,0:10:37.65,0:10:39.03,Default,,0,0,0,,Сіз сонша жерге барасыз ба?
Dialogue: 0,0:10:39.11,0:10:41.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:41.37,0:10:41.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:42.74,0:10:45.24,Default,,0,0,0,,Сәлеметсіз бе, Ямагиши мырза? Бұл Такина
Dialogue: 0,0:10:45.33,0:10:48.66,Default,,0,0,0,,Бұл кезекті тексеру, солай емес пе? ол ертең бара алады
Dialogue: 0,0:10:48.75,0:10:49.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:49.42,0:10:50.62,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:10:50.71,0:10:51.71,Default,,0,0,0,,Артында қалуым керек пе? Менің де, Жосукенің де?
Dialogue: 0,0:10:51.79,0:10:55.84,Default,,0,0,0,,Мүшелердің денсаулығын басқару да менің міндетім. Өтінемін солай жасаңыз.
Dialogue: 0,0:10:56.84,0:10:58.38,Default,,0,0,0,,Иә
Dialogue: 0,0:10:58.88,0:11:01.14,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:11:01.22,0:11:02.97,Default,,0,0,0,,Сәлем Такина-чан
Dialogue: 0,0:11:03.05,0:11:05.72,Default,,0,0,0,,Аа, Гото мырза, қош келдіңіз.
Dialogue: 0,0:11:06.35,0:11:08.10,Default,,0,0,0,,Бүгін Сендзоку-чан ше?
Dialogue: 0,0:11:08.18,0:11:09.73,Default,,0,0,0,,Бүгін менде ауысым кешігіп жатыр.
Dialogue: 0,0:11:10.39,0:11:13.06,Default,,0,0,0,,Yahoo Gochumon Dozo
Dialogue: 0,0:11:13.81,0:11:15.40,Default,,0,0,0,,Жарайды ма? Бұл
Dialogue: 0,0:11:15.90,0:11:17.61,Default,,0,0,0,,Мың киім
Dialogue: 0,0:11:18.11,0:11:20.82,Default,,0,0,0,,(дәретхананың ағу дыбысы)
Dialogue: 0,0:11:21.57,0:11:22.45,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:11:23.57,0:11:24.24,Default,,0,0,0,,Ах
Dialogue: 0,0:11:28.25,0:11:29.79,Default,,0,0,0,,А, а...
Dialogue: 0,0:11:29.87,0:11:32.12,Default,,0,0,0,,Ugg… uf…
Dialogue: 0,0:11:33.71,0:11:34.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:34.38,0:11:36.09,Default,,0,0,0,,(дәретхананың ағу дыбысы)
Dialogue: 0,0:11:36.17,0:11:38.34,Default,,0,0,0,,Такина! Мен парфет жасадым
Dialogue: 0,0:11:38.42,0:11:39.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:39.13,0:11:41.01,Default,,0,0,0,,Мен енді ол парфейді жемеймін.
Dialogue: 0,0:11:41.09,0:11:42.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:42.38,0:11:43.84,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:11:43.93,0:11:46.22,Default,,0,0,0,,Жарайды, танымал.
Dialogue: 0,0:11:46.31,0:11:48.56,Default,,0,0,0,,Роборико, өтінемін.
Dialogue: 0,0:11:48.64,0:11:50.06,Default,,0,0,0,,Жоғары Нагашитеокимасу
Dialogue: 0,0:11:51.02,0:11:53.02,Default,,0,0,0,,Әй, жоқ... Қат!
Dialogue: 0,0:11:53.10,0:11:55.27,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:11:56.44,0:11:56.94,Default,,0,0,0,,Иә
Dialogue: 0,0:11:57.02,0:11:58.28,Default,,0,0,0,,Ямагиши
Dialogue: 0,0:11:58.36,0:12:00.32,Default,,0,0,0,,Аа, Ямагиши мырза, бұл Такина.
Dialogue: 0,0:12:00.40,0:12:03.07,Default,,0,0,0,,Чизоку сол дүкенде ме?
Dialogue: 0,0:12:03.16,0:12:05.57,Default,,0,0,0,,Жоқ, сіз ол жерге бармайсыз ба?
Dialogue: 0,0:12:05.66,0:12:08.41,Default,,0,0,0,,Ол келмеді. Оның ұялы телефоны жауап бермейді.
Dialogue: 0,0:12:08.49,0:12:11.41,Default,,0,0,0,,Мен көремін. Мен де іздеймін.
Dialogue: 0,0:12:15.04,0:12:15.92,Default,,0,0,0,,Хмм?
Dialogue: 0,0:12:16.54,0:12:21.97,Default,,0,0,0,,(Қоңыраулы әуен)
Dialogue: 0,0:12:22.84,0:12:24.38,Default,,0,0,0,,Қоңырау соғып тұр
Dialogue: 0,0:12:26.55,0:12:27.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:27.47,0:12:30.64,Default,,0,0,0,,(Қоңыраулы әуен)
Dialogue: 0,0:12:33.56,0:12:39.69,Default,,0,0,0,,(Қоңыраулы әуен)
Dialogue: 0,0:12:40.90,0:12:41.86,Default,,0,0,0,,Мен оны ала аламын ба?
Dialogue: 0,0:12:41.94,0:12:42.90,Default,,0,0,0,,Иә
Dialogue: 0,0:12:44.61,0:12:46.28,Default,,0,0,0,,Сензоку? Бұл қайда?
Dialogue: 0,0:12:46.37,0:12:48.03,Default,,0,0,0,,Сіз кезекті тексеруден өткен жоқсыз ба?
Dialogue: 0,0:12:48.12,0:12:51.83,Default,,0,0,0,,Ой, кешіріңіз, кешіріңіз, шұғыл жұмысқа байланысты сәл кешігіп қалдым.
Dialogue: 0,0:12:51.91,0:12:54.08,Default,,0,0,0,,Мұны профессор Ямагишиге де айтыңыз.
Dialogue: 0,0:12:56.00,0:12:57.33,Default,,0,0,0,,Хмм?
Dialogue: 0,0:12:57.42,0:12:59.67,Default,,0,0,0,,Денсаулық маңызды
Dialogue: 0,0:13:00.17,0:13:02.59,Default,,0,0,0,,Сіздің денеңіз сіздің капиталыңыз, солай ма? Біз
Dialogue: 0,0:13:02.67,0:13:04.51,Default,,0,0,0,,«ra» дегеніміз не? «Ра»
Dialogue: 0,0:13:04.59,0:13:06.34,Default,,0,0,0,,Мылтық сілтеген адамға не айту керек?
Dialogue: 0,0:13:06.43,0:13:08.55,Default,,0,0,0,,Біреуді өлтіру үшін алдымен тірі болуың керек.
Dialogue: 0,0:13:08.64,0:13:09.30,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:10.97,0:13:12.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:12.14,0:13:14.73,Default,,0,0,0,,Бұл керемет. Сіз мұны қалай жасадыңыз?
Dialogue: 0,0:13:15.23,0:13:16.48,Default,,0,0,0,,Құпия
Dialogue: 0,0:13:17.27,0:13:19.36,Default,,0,0,0,,Сол жүректе тұқым бар ма?
Dialogue: 0,0:13:19.44,0:13:22.32,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:13:22.40,0:13:24.90,Default,,0,0,0,,Ей, бұл құпия.
Dialogue: 0,0:13:26.49,0:13:29.37,Default,,0,0,0,,«Қатты өл»! ол саған ұнайды ма?
Dialogue: 0,0:13:29.45,0:13:31.20,Default,,0,0,0,,Е? Иә.
Dialogue: 0,0:13:31.29,0:13:32.91,Default,,0,0,0,,Сізге кім ұнайды? (Сензоку) Пауэлл
Dialogue: 0,0:13:33.00,0:13:34.04,Default,,0,0,0,,Полиция қызметкері
Dialogue: 0,0:13:34.12,0:13:37.25,Default,,0,0,0,,Сіз тіпті МакКлейнді кездестірмеген болсаңыз да, сіздің серіктес болу сезімі.
Dialogue: 0,0:13:37.33,0:13:39.04,Default,,0,0,0,,Соңғы көріністе!
Dialogue: 0,0:13:39.13,0:13:39.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:41.04,0:13:42.67,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:13:42.75,0:13:44.51,Default,,0,0,0,,А, мен кофе дайындасам бола ма?
Dialogue: 0,0:13:44.59,0:13:47.34,Default,,0,0,0,,Ащы жақсы емес. Басқа бірдеңе бар ма?
Dialogue: 0,0:13:47.43,0:13:48.05,Default,,0,0,0,,Хун
Dialogue: 0,0:13:55.14,0:13:56.18,Default,,0,0,0,,Бухет
Dialogue: 0,0:13:57.27,0:13:58.73,Default,,0,0,0,,не үшін қолданылады?
Dialogue: 0,0:13:59.23,0:14:01.61,Default,,0,0,0,,Мені есіңізде ме?
Dialogue: 0,0:14:01.69,0:14:04.03,Default,,0,0,0,,Хмм? түкіру
Dialogue: 0,0:14:04.11,0:14:05.57,Default,,0,0,0,,Бұрын
Dialogue: 0,0:14:06.07,0:14:07.61,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:14:08.70,0:14:11.16,Default,,0,0,0,,Ендеше, мен сендерге ескі әңгіме айтып берейін.
Dialogue: 0,0:14:12.49,0:14:14.16,Default,,0,0,0,,Радио мұнарасының оқиғасы
Dialogue: 0,0:14:17.21,0:14:21.67,Default,,0,0,0,,(радиодан оқ пен айғай естіледі)
Dialogue: 0,0:14:23.17,0:14:25.30,Default,,0,0,0,,Батыс жағына не болды?
Dialogue: 0,0:14:25.38,0:14:26.30,Default,,0,0,0,,Студент пе?
Dialogue: 0,0:14:26.38,0:14:28.01,Default,,0,0,0,,Мұнда да келеді
Dialogue: 0,0:14:30.26,0:14:30.97,Default,,0,0,0,,Жоғары!
Dialogue: 0,0:14:31.05,0:14:31.76,Default,,0,0,0,,Гуах
Dialogue: 0,0:14:31.85,0:14:35.97,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:14:36.68,0:14:37.43,Default,,0,0,0,,(Соққы дыбысы)
Dialogue: 0,0:14:37.52,0:14:38.27,Default,,0,0,0,,Мажима!
Dialogue: 0,0:14:38.77,0:14:41.65,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:14:42.36,0:14:43.40,Default,,0,0,0,,Үлкен сағат астында!
Dialogue: 0,0:14:44.69,0:14:45.28,Default,,0,0,0,,Әй
Dialogue: 0,0:14:45.36,0:14:46.65,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:46.74,0:14:50.49,Default,,0,0,0,,Гардеробта 4 адам Касса астындағы оң дүңгіршекте 3 адам
Dialogue: 0,0:14:50.57,0:14:52.16,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:52.24,0:14:53.45,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:14:53.53,0:14:56.16,Default,,0,0,0,,Уф... Ха ха ха Уф
Dialogue: 0,0:14:56.24,0:14:58.50,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:02.71,0:15:03.96,Default,,0,0,0,,жойылды
Dialogue: 0,0:15:04.96,0:15:06.71,Default,,0,0,0,,Әлі бір адам қалды!
Dialogue: 0,0:15:06.80,0:15:08.13,Default,,0,0,0,,Не!
Dialogue: 0,0:15:08.22,0:15:09.13,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:09.22,0:15:13.97,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:15:15.01,0:15:15.76,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:15.85,0:15:17.22,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:19.14,0:15:20.39,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:21.90,0:15:22.85,Default,,0,0,0,,(JoJo) Құдай-ай! Мынаны ал—Орыаа!
Dialogue: 0,0:15:22.94,0:15:26.65,Default,,0,0,0,,(үздіксіз ату)
Dialogue: 0,0:15:26.73,0:15:27.99,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:28.57,0:15:29.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:32.36,0:15:34.12,Default,,0,0,0,,Гуах
Dialogue: 0,0:15:36.20,0:15:37.58,Default,,0,0,0,,Ішек
Dialogue: 0,0:15:38.75,0:15:39.79,Default,,0,0,0,,Уау
Dialogue: 0,0:15:41.16,0:15:44.25,Default,,0,0,0,,Маджима... жарылыңыз.
Dialogue: 0,0:15:47.00,0:15:47.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:47.80,0:15:49.01,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:15:49.09,0:15:49.67,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:15:50.26,0:15:53.64,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:57.18,0:15:59.81,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:16:02.73,0:16:05.90,Default,,0,0,0,,Адамдарды құбыжық деп сипаттама
Dialogue: 0,0:16:05.98,0:16:08.94,Default,,0,0,0,,Бұл шын мәнінде құбыжық, есіңізде ме?
Dialogue: 0,0:16:09.03,0:16:11.99,Default,,0,0,0,,Жоқ, мен сен туралы бірдеңе білемін бе?
Dialogue: 0,0:16:12.07,0:16:15.62,Default,,0,0,0,,Хахахахахахахаха! Дұрыс па?
Dialogue: 0,0:16:18.37,0:16:20.29,Default,,0,0,0,,Менде де бар.
Dialogue: 0,0:16:21.08,0:16:22.96,Default,,0,0,0,,Онда неге бұлай істеп жатырсың?
Dialogue: 0,0:16:23.04,0:16:23.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:23.71,0:16:27.38,Default,,0,0,0,,Егер сізде бұл болса, сізде керемет талант болуы керек, солай ма?
Dialogue: 0,0:16:27.46,0:16:29.38,Default,,0,0,0,,Адамдарды бақытты ететін нәрсе
Dialogue: 0,0:16:29.46,0:16:31.80,Default,,0,0,0,,Сіздің істеп жатқаныңыз керісінше, солай емес пе?
Dialogue: 0,0:16:31.88,0:16:33.93,Default,,0,0,0,,Сен де өлтірушісің ғой?
Dialogue: 0,0:16:34.01,0:16:37.39,Default,,0,0,0,,Менімен жүр, мен адамдарға көмектесемін!
Dialogue: 0,0:16:37.47,0:16:39.06,Default,,0,0,0,,А, сен
Dialogue: 0,0:16:39.14,0:16:42.60,Default,,0,0,0,,Сіз Аланды бейбітшілікті жақтайтын агенттік деп ойлайсыз ба?
Dialogue: 0,0:16:42.68,0:16:45.85,Default,,0,0,0,,Сізден басқалардың барлығы бірдей нәтижелерге жетті, солай емес пе?
Dialogue: 0,0:16:46.44,0:16:50.03,Default,,0,0,0,,Мен әлемді медаль иегері сияқты таң қалдырғым келеді!
Dialogue: 0,0:16:50.11,0:16:53.74,Default,,0,0,0,,Сіз айтасыз ба? Ха, бұл бақытты жігіт.
Dialogue: 0,0:16:54.78,0:16:57.62,Default,,0,0,0,,Сен, Алан, ол кісілердің бірі емессің.
Dialogue: 0,0:16:58.12,0:17:02.37,Default,,0,0,0,,Не айтсаң да, мен Йоши-санмен уәдем бар.
Dialogue: 0,0:17:02.87,0:17:04.50,Default,,0,0,0,,Бұл дәлел
Dialogue: 0,0:17:04.58,0:17:08.00,Default,,0,0,0,,Йоши мырза Аран агенттігінен бе?
Dialogue: 0,0:17:08.09,0:17:09.75,Default,,0,0,0,,Оның саған еш қатысы жоқ.
Dialogue: 0,0:17:09.84,0:17:12.21,Default,,0,0,0,,Аланмен байланыстасыз ба? Сіз
Dialogue: 0,0:17:12.30,0:17:15.47,Default,,0,0,0,,Мен сенің менен артық білетініңді білмеймін.
Dialogue: 0,0:17:15.55,0:17:17.72,Default,,0,0,0,,Мен қалағанымды істеймін~
Dialogue: 0,0:17:18.30,0:17:21.22,Default,,0,0,0,,Жақсы, сен екеуміз бірдейміз.
Dialogue: 0,0:17:23.48,0:17:25.73,Default,,0,0,0,,Менің өлтіру дағдыларым сатып алынды және маған қолдау көрсетілді.
Dialogue: 0,0:17:26.27,0:17:28.94,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:17:29.02,0:17:31.53,Default,,0,0,0,,Аланның халқы таза.
Dialogue: 0,0:17:31.61,0:17:34.69,Default,,0,0,0,,Біздің өлтіргенімізді құптай алатындай дәрежеде.
Dialogue: 0,0:17:35.78,0:17:36.66,Default,,0,0,0,,Не? Ой, үйге барасың ба?
Dialogue: 0,0:17:38.70,0:17:41.08,Default,,0,0,0,,Сіздің серіктесіңіз осында.
Dialogue: 0,0:17:41.16,0:17:41.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:45.29,0:17:45.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:46.67,0:17:48.13,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:17:49.17,0:17:51.67,Default,,0,0,0,,Қайта кездескенше, радио мұнарасында мия тамыры!
Dialogue: 0,0:17:52.17,0:17:53.84,Default,,0,0,0,,(өшіргішпен ату)
Dialogue: 0,0:17:56.13,0:17:58.59,Default,,0,0,0,,Маджима үйге келді ме?
Dialogue: 0,0:17:59.09,0:18:00.97,Default,,0,0,0,,Сен оны өлтірдің бе? Такина
Dialogue: 0,0:18:01.05,0:18:03.68,Default,,0,0,0,,Кешіріңіз, мен дәл сіздің алдыңызда болдым.
Dialogue: 0,0:18:03.77,0:18:06.39,Default,,0,0,0,,Оның да бұл жолы болды.
Dialogue: 0,0:18:06.48,0:18:07.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:07.31,0:18:09.81,Default,,0,0,0,,Ондай жігітте қандай талант бар?
Dialogue: 0,0:18:09.90,0:18:12.44,Default,,0,0,0,,Зорлық-зомбылық жасайтын қылмыскерлерге де қолдау көрсетіледі ме?
Dialogue: 0,0:18:12.52,0:18:13.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:13.19,0:18:15.28,Default,,0,0,0,,Мика Мен өз ғашығымнан естіген жоқпын...
Dialogue: 0,0:18:15.36,0:18:16.07,Default,,0,0,0,,(Үзілген дыбыс)
Dialogue: 0,0:18:16.15,0:18:17.11,Default,,0,0,0,,(жаңғақ құлаған дыбыс)
Dialogue: 0,0:18:17.20,0:18:18.82,Default,,0,0,0,,Сіз оны бір жерден алдыңыз ба?
Dialogue: 0,0:18:18.91,0:18:21.53,Default,,0,0,0,,Йошидің мұндай адамға көмектесуі мүмкін емес.
Dialogue: 0,0:18:22.24,0:18:23.16,Default,,0,0,0,,Сәлем, мұғалім?
Dialogue: 0,0:18:23.66,0:18:24.29,Default,,0,0,0,,Ha
Dialogue: 0,0:18:24.87,0:18:25.58,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:18:25.66,0:18:27.50,Default,,0,0,0,,...
Dialogue: 0,0:18:27.58,0:18:28.37,Default,,0,0,0,,Хмм?
Dialogue: 0,0:18:28.46,0:18:29.46,Default,,0,0,0,,Сензоку! (Чизоку) Уау~ Иә!
Dialogue: 0,0:18:29.54,0:18:32.71,Default,,0,0,0,,Менің қоңырауыма 3 қоңыраудың ішінде жауап беріңіз.
Dialogue: 0,0:18:32.79,0:18:34.42,Default,,0,0,0,,Шықпаса қауіпті болып саналады.
Dialogue: 0,0:18:34.50,0:18:37.09,Default,,0,0,0,,Келесі бірден өту туралы хабарландыру болады!
Dialogue: 0,0:18:37.17,0:18:38.47,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:18:38.55,0:18:39.93,Default,,0,0,0,,Ұнамаса, дереу кет.
Dialogue: 0,0:18:40.01,0:18:42.43,Default,,0,0,0,,Басқаша айтқанда, сіз қай жерде болсаңыз да келе аласыз.
Dialogue: 0,0:18:42.51,0:18:45.68,Default,,0,0,0,,Сондай-ақ, басқа қауіпсіз үйге көшуіңізді сұраймыз.
Dialogue: 0,0:18:45.77,0:18:49.69,Default,,0,0,0,,Иә~ Маған бәрінен де сол жер ұнайды.
Dialogue: 0,0:18:49.77,0:18:51.23,Default,,0,0,0,,Мен қайтадан шығамын.
Dialogue: 0,0:18:51.31,0:18:54.94,Default,,0,0,0,,Шынымен бе? Бірге тұру? Маған тағы тамақ жасап бере аласыз ба?
Dialogue: 0,0:18:55.03,0:18:56.99,Default,,0,0,0,,Иә, иә, жұмыс істейік!
Dialogue: 0,0:18:57.07,0:18:58.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:05.62,0:19:07.25,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:19:08.33,0:19:11.25,Default,,0,0,0,,Бұл ДА мылтығы емес пе?
Dialogue: 0,0:19:14.29,0:19:15.34,Default,,0,0,0,,Иә
Dialogue: 0,0:19:15.96,0:19:17.80,Default,,0,0,0,,Мен онымен бірге алдым.
Dialogue: 0,0:19:20.84,0:19:22.18,Default,,0,0,0,,Йошимацу мырзаға?
Dialogue: 0,0:19:22.26,0:19:25.93,Default,,0,0,0,,Иә... бұл маңызды.
Dialogue: 0,0:19:29.06,0:19:30.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:30.52,0:19:34.15,Default,,0,0,0,,Болды, шкафқа қайта кіріп, ұйықта!
Dialogue: 0,0:19:35.02,0:19:37.65,Default,,0,0,0,,Күн суытып барады (Чизоку).
Dialogue: 0,0:19:37.73,0:19:40.53,Default,,0,0,0,,Такина келген күні шие гүлдері жайқалып тұрды.
Dialogue: 0,0:19:42.82,0:19:43.99,Default,,0,0,0,,Содан бері...
Dialogue: 0,0:19:46.16,0:19:48.37,Default,,0,0,0,,Йоши-сан келмейді.
Dialogue: 0,0:20:00.34,0:20:01.84,Default,,0,0,0,,Иә (Чизоку) Иә?
Dialogue: 0,0:20:02.43,0:20:03.93,Default,,0,0,0,,Ой, бұл балабақшадан.
Dialogue: 0,0:20:04.43,0:20:05.64,Default,,0,0,0,,Сіз мұны қалайсыз, солай ма?
Dialogue: 0,0:20:05.72,0:20:07.18,Default,,0,0,0,,Маған бере аласыз ба?
Dialogue: 0,0:20:07.76,0:20:08.68,Default,,0,0,0,,Эххе
Dialogue: 0,0:20:08.77,0:20:11.64,Default,,0,0,0,,О, ит! сүйкімді!
Dialogue: 0,0:20:11.73,0:20:14.73,Default,,0,0,0,,Такина соңғы кездері өте белсенді.
Dialogue: 0,0:20:15.40,0:20:18.23,Default,,0,0,0,,Мен жай ғана дүкен банкротқа ұшырамағанына көз жеткізгім келді.
Dialogue: 0,0:20:19.57,0:20:21.11,Default,,0,0,0,,Бұл маңызды орын, солай ма?
Dialogue: 0,0:20:23.28,0:20:24.20,Default,,0,0,0,,Такина
Dialogue: 0,0:20:27.16,0:20:28.33,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:20:30.04,0:20:32.83,Default,,0,0,0,,Тұрақты тексеруге барыңыз.
Dialogue: 0,0:20:32.91,0:20:34.92,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:20:35.67,0:20:37.34,Default,,0,0,0,,Сізге не ұнамайды?
Dialogue: 0,0:20:37.42,0:20:39.96,Default,,0,0,0,,Бұл маған ұнамағаны емес...
Dialogue: 0,0:20:40.05,0:20:41.01,Default,,0,0,0,,Оларға мұқият қарап тұр.
Dialogue: 0,0:20:41.09,0:20:43.34,Default,,0,0,0,,Чу Чу… Инъекция
Dialogue: 0,0:20:44.22,0:20:44.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:46.26,0:20:50.14,Default,,0,0,0,,Сіз инъекциядан қорқасыз ба? Маған мылтық сілтесе де қарсы емеспін
Dialogue: 0,0:20:50.22,0:20:53.06,Default,,0,0,0,,Иә! Өйткені мен инъекциядан қашып құтыла алмаймын.
Dialogue: 0,0:20:53.14,0:20:56.90,Default,,0,0,0,,Ахахахаха Радио мұнарасындағы мия?
Dialogue: 0,0:20:56.98,0:20:59.44,Default,,0,0,0,,Сіз инъекциядан қорқасыз ба? (Чизоку) Хмм!
Dialogue: 0,0:21:03.74,0:21:05.36,Default,,0,0,0,,Оны тез орындаңыз.
Dialogue: 0,0:21:05.45,0:21:06.49,Default,,0,0,0,,Аяқталды ма? Ол аяқталды ма? Эй, эй
Dialogue: 0,0:21:06.57,0:21:08.33,Default,,0,0,0,,Ова уа... аяқталды ма? Ой... біттің бе? Ол аяқталды ма?
Dialogue: 0,0:21:09.70,0:21:10.70,Default,,0,0,0,,Бітті
Dialogue: 0,0:21:10.79,0:21:14.25,Default,,0,0,0,,Сәлем! Бұл еңсеруге болатын ең қиын кедергі.
Dialogue: 0,0:21:14.33,0:21:16.29,Default,,0,0,0,,Сіз әрқашан қорқасыз ба?
Dialogue: 0,0:21:16.37,0:21:17.88,Default,,0,0,0,,Иә, ауырады.
Dialogue: 0,0:21:17.96,0:21:21.00,Default,,0,0,0,,Сіздің денеңізге бөгде заттарды салу мүмкіндігі бар.
Dialogue: 0,0:21:21.80,0:21:25.18,Default,,0,0,0,,Доктор Ямагиши бұл жай ғана витаминдік қоспа дейді.
Dialogue: 0,0:21:25.26,0:21:27.30,Default,,0,0,0,,Бүгінгі күн басқаша.
Dialogue: 0,0:21:27.39,0:21:27.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:28.64,0:21:31.51,Default,,0,0,0,,Дару!
Dialogue: 0,0:21:32.93,0:21:34.89,Default,,0,0,0,,Қымбатты, га...
Dialogue: 0,0:21:35.81,0:21:38.44,Default,,0,0,0,,Ямагиши мырза...
Dialogue: 0,0:21:39.44,0:21:40.19,Default,,0,0,0,,Ах
Dialogue: 0,0:21:41.23,0:21:42.78,Default,,0,0,0,,Сіз әдепті болуыңыз керек еді.
Dialogue: 0,0:21:43.28,0:21:46.91,Default,,0,0,0,,Чизоку әлі де? Кеш болды, солай емес пе?
Dialogue: 0,0:21:47.49,0:21:48.78,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:48.87,0:21:50.33,Default,,0,0,0,,Хмм хмм
Dialogue: 0,0:22:05.30,0:22:09.89,Default,,0,0,0,,(Смартфон қоңырау үні)
Dialogue: 0,0:22:11.76,0:22:13.72,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:22:14.52,0:22:15.64,Default,,0,0,0,,Хмм…
Dialogue: 0,0:22:17.35,0:22:18.10,Default,,0,0,0,,Уф
Dialogue: 0,0:22:23.86,0:22:25.19,Default,,0,0,0,,Аздап
Dialogue: 0,0:22:25.28,0:22:26.49,Default,,0,0,0,,(Исуми Миямура) Иә (Ишикава) Маған беріп тұрсың ба?
Dialogue: 0,0:22:29.99,0:22:31.87,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,0:22:37.96,0:22:40.54,Default,,0,0,0,,Мика сен кінәлісің
Dialogue: 0,0:22:41.46,0:22:44.50,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:22:44.59,0:22:46.59,Default,,0,0,0,,♪~
Dialogue: 0,0:23:58.33,0:24:00.33,Default,,0,0,0,,~♪
Dialogue: 0,0:24:01.83,0:24:06.83,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
