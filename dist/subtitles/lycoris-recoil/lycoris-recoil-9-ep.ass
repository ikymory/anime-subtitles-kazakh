Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(Такинаның ауыр тыныс алуы)
Dialogue: 0,0:00:07.52,0:00:08.19,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,0:00:08.27,0:00:10.65,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:21.20,0:00:22.96,Default,,0,0,0,,(Есікті автоматты түрде ашу/жабу дыбысы)
Dialogue: 0,0:00:26.75,0:00:28.63,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:00:36.09,0:00:37.76,Default,,0,0,0,,Ах
Dialogue: 0,0:00:37.85,0:00:38.47,Default,,0,0,0,,Уф
Dialogue: 0,0:00:38.55,0:00:39.39,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:41.72,0:00:42.27,Default,,0,0,0,,Әй
Dialogue: 0,0:00:45.90,0:00:46.65,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:46.73,0:00:49.52,Default,,0,0,0,,Сензоку! Сензоку!
Dialogue: 0,0:00:51.86,0:00:53.90,Default,,0,0,0,,Сен... не істедің!
Dialogue: 0,0:00:54.82,0:00:55.61,Default,,0,0,0,,(Мылтық даусы және әйнектің сынуы)
Dialogue: 0,0:00:55.70,0:00:56.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:56.28,0:00:56.95,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:57.49,0:00:58.95,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:06.25,0:01:09.00,Default,,0,0,0,,Ха... Сензоку!
Dialogue: 0,0:01:09.09,0:01:12.17,Default,,0,0,0,,Сензоку? Сензоку!
Dialogue: 0,0:01:13.05,0:01:15.05,Default,,0,0,0,,♪~
Dialogue: 0,0:02:39.55,0:02:41.55,Default,,0,0,0,,~♪
Dialogue: 0,0:02:48.14,0:02:51.90,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:02:53.94,0:02:54.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:00.28,0:03:01.16,Default,,0,0,0,,(электрокардиограмма мониторының синхронды дыбысы)
Dialogue: 0,0:03:01.24,0:03:02.74,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:07.70,0:03:08.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:10.83,0:03:13.54,Default,,0,0,0,,О... олар сәйкес келеді.
Dialogue: 0,0:03:15.80,0:03:19.30,Default,,0,0,0,,Ұйықтататын таблеткалардың әсерінен біраз уақытқа баяу сезінуіңіз мүмкін.
Dialogue: 0,0:03:24.89,0:03:27.81,Default,,0,0,0,,Не болды? Ямагиши мырза
Dialogue: 0,0:03:28.52,0:03:29.68,Default,,0,0,0,,Сол әйел
Dialogue: 0,0:03:30.48,0:03:32.65,Default,,0,0,0,,Кенеттен жоғары кернеу салдарынан шамадан тыс зарядтау
Dialogue: 0,0:03:32.73,0:03:35.19,Default,,0,0,0,,Аппараттық құралға кіру енді мүмкін емес
Dialogue: 0,0:03:35.27,0:03:35.90,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:03:35.98,0:03:37.86,Default,,0,0,0,,Мен оны енді зарядтай алмаймын.
Dialogue: 0,0:03:38.44,0:03:43.16,Default,,0,0,0,,Бұл қарапайым, бірақ бұл жоюдың ең тиімді әдісі.
Dialogue: 0,0:03:44.28,0:03:45.41,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:03:46.62,0:03:47.79,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:03:48.95,0:03:51.58,Default,,0,0,0,,Бақытымызға орай, зарядтаудан кейін бірден болды.
Dialogue: 0,0:03:52.08,0:03:53.37,Default,,0,0,0,,2 ай қалды
Dialogue: 0,0:03:53.87,0:03:55.25,Default,,0,0,0,,Екі ай...
Dialogue: 0,0:03:55.33,0:03:57.96,Default,,0,0,0,,Егер сіз қозғалмасаңыз, ол сәл ұзағырақ болады.
Dialogue: 0,0:03:58.50,0:03:59.80,Default,,0,0,0,,Екі ай дегеніміз не?
Dialogue: 0,0:03:59.88,0:04:01.51,Default,,0,0,0,,Өмір сүру ұзақтығы, иә?
Dialogue: 0,0:04:04.26,0:04:06.01,Default,,0,0,0,,Сензокудың қалған өмірі
Dialogue: 0,0:04:08.47,0:04:10.39,Default,,0,0,0,,Сонымен... міне, солай!
Dialogue: 0,0:04:10.98,0:04:13.35,Default,,0,0,0,,Сынған бөлікті ауыстырыңыз...
Dialogue: 0,0:04:13.44,0:04:14.85,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,0:04:15.44,0:04:19.03,Default,,0,0,0,,Бұл көңілсіз, бірақ біздің біліміміз бен технологиямыз.
Dialogue: 0,0:04:19.11,0:04:20.57,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:04:22.15,0:04:26.12,Default,,0,0,0,,Сензокудың жасанды жүрегін алмастыра алмайды.
Dialogue: 0,0:04:27.78,0:04:29.62,Default,,0,0,0,,Уф... (Чизоку) Қайда бара жатырсың?
Dialogue: 0,0:04:29.70,0:04:31.29,Default,,0,0,0,,Мен анау медбикеден құтыламын.
Dialogue: 0,0:04:31.37,0:04:33.08,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:33.16,0:04:35.04,Default,,0,0,0,,Бұл жақсы болуы мүмкін емес!
Dialogue: 0,0:04:35.12,0:04:37.33,Default,,0,0,0,,Жарайды, иә?
Dialogue: 0,0:04:38.38,0:04:41.55,Default,,0,0,0,,Бастау соншалықты ұзақ болмады.
Dialogue: 0,0:04:42.38,0:04:43.76,Default,,0,0,0,,Бастапқыда?
Dialogue: 0,0:04:48.68,0:04:51.77,Default,,0,0,0,,Оны өлтіру ештеңені өзгертпейді.
Dialogue: 0,0:04:53.85,0:04:55.77,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:04:57.06,0:04:59.36,Default,,0,0,0,,Иә, сіз бұл парфейді жеуді қойдыңыз ба?
Dialogue: 0,0:04:59.44,0:05:02.07,Default,,0,0,0,,Такина ұялшақ
Dialogue: 0,0:05:02.15,0:05:04.49,Default,,0,0,0,,Мен оны әлі жеген жоқпын.
Dialogue: 0,0:05:05.49,0:05:07.78,Default,,0,0,0,,Тапсырыс берілді! (Ямадера) О!
Dialogue: 0,0:05:09.08,0:05:10.74,Default,,0,0,0,,Сіз
Dialogue: 0,0:05:10.83,0:05:12.58,Default,,0,0,0,,Такина ашуланады~
Dialogue: 0,0:05:12.66,0:05:16.25,Default,,0,0,0,,Аа, жарайды, жақсы, бірінші кезекте тұтынушы келеді.
Dialogue: 0,0:05:16.33,0:05:16.92,Default,,0,0,0,,Ах
Dialogue: 0,0:05:17.00,0:05:20.42,Default,,0,0,0,,Ах~чача чачача~
Dialogue: 0,0:05:25.47,0:05:29.39,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:05:31.10,0:05:33.39,Default,,0,0,0,,Иә, Рико-Рико постер қызы
Dialogue: 0,0:05:36.39,0:05:38.56,Default,,0,0,0,,Мен ДА-ға барғым келді.
Dialogue: 0,0:05:38.65,0:05:40.19,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:40.27,0:05:44.53,Default,,0,0,0,,Кусуноки мырзаның табандылығы сонша, мен оған бірдеңе беретіндіктен келуін өтіндім.
Dialogue: 0,0:05:44.61,0:05:46.07,Default,,0,0,0,,Мм, ақша шығар.
Dialogue: 0,0:05:46.15,0:05:49.03,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:05:50.70,0:05:52.87,Default,,0,0,0,,Такина, сен оны түсінесің.
Dialogue: 0,0:05:52.95,0:05:54.58,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:05:54.66,0:05:58.33,Default,,0,0,0,,А, сондықтан айтқым келмеді.
Dialogue: 0,0:05:58.42,0:05:59.71,Default,,0,0,0,,Сіз әдеттегідейсіз.
Dialogue: 0,0:05:59.79,0:06:01.38,Default,,0,0,0,,Сәлем! Тара жүгіріп келеді...
Dialogue: 0,0:06:01.46,0:06:03.55,Default,,0,0,0,,Әй, сен неткен ақымақсың!
Dialogue: 0,0:06:03.63,0:06:04.96,Default,,0,0,0,,Иә? Эй... күт!
Dialogue: 0,0:06:05.05,0:06:05.80,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:05.88,0:06:08.30,Default,,0,0,0,,(Янкилердің айқайы)
Dialogue: 0,0:06:08.38,0:06:09.80,Default,,0,0,0,,Ах ла ла~
Dialogue: 0,0:06:12.26,0:06:13.26,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:16.14,0:06:18.73,Default,,0,0,0,,Өлгелі тұрғаныңызды ескерсеңіз, жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:06:19.31,0:06:23.11,Default,,0,0,0,,Құлағың жылдам. Сонда не?
Dialogue: 0,0:06:23.19,0:06:24.36,Default,,0,0,0,,DA дегенге қайта келу
Dialogue: 0,0:06:24.44,0:06:26.19,Default,,0,0,0,,(Сензоку но Секикоми)
Dialogue: 0,0:06:26.28,0:06:28.49,Default,,0,0,0,,Мен өлейін деп жатырмын, сондықтан өзімді жақсы сезінбеймін~
Dialogue: 0,0:06:28.57,0:06:30.36,Default,,0,0,0,,Мен Машима келді деп естідім.
Dialogue: 0,0:06:30.45,0:06:32.12,Default,,0,0,0,,Біз екі рет кездестік.
Dialogue: 0,0:06:32.70,0:06:34.33,Default,,0,0,0,,Екі рет жіберіп алды
Dialogue: 0,0:06:34.41,0:06:36.83,Default,,0,0,0,,Бұл менің жұмысым емес.
Dialogue: 0,0:06:37.37,0:06:40.00,Default,,0,0,0,,Менің бұл жерде соңғы рет болуым деп ойлаймын.
Dialogue: 0,0:06:40.08,0:06:42.54,Default,,0,0,0,,Көңілдірек сөйлесейік.
Dialogue: 0,0:06:42.63,0:06:44.71,Default,,0,0,0,,Сонда... сен маған не бересің?
Dialogue: 0,0:06:47.01,0:06:47.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:49.30,0:06:51.64,Default,,0,0,0,,Неліктен Кусуноки мырзада бұл бар?
Dialogue: 0,0:06:51.72,0:06:54.60,Default,,0,0,0,,Ақпараттың ағып кетуін болдырмау үшін қалпына келтірілді
Dialogue: 0,0:06:54.68,0:06:57.52,Default,,0,0,0,,Мен сені іздедім~ Ұры!
Dialogue: 0,0:06:57.60,0:07:01.10,Default,,0,0,0,,Жақында Маджиманы бағындыру бойынша кең ауқымды операция өтеді.
Dialogue: 0,0:07:01.19,0:07:02.35,Default,,0,0,0,,Сіз де қатысуыңыз керек.
Dialogue: 0,0:07:02.44,0:07:05.15,Default,,0,0,0,,Уау, бұл қатал әзіл.
Dialogue: 0,0:07:05.23,0:07:06.44,Default,,0,0,0,,Көптеген
Dialogue: 0,0:07:06.53,0:07:10.20,Default,,0,0,0,,Мен сені керемет мия жасау үшін көп еңбектенсем де.
Dialogue: 0,0:07:10.78,0:07:13.45,Default,,0,0,0,,Өз міндетін орындамай өледі.
Dialogue: 0,0:07:16.99,0:07:20.87,Default,,0,0,0,,Менің рөлім Кусуноки мырзаның рөлінен өзгеше.
Dialogue: 0,0:07:20.96,0:07:22.63,Default,,0,0,0,,Әңгіме біткен жоқ
Dialogue: 0,0:07:23.21,0:07:24.25,Default,,0,0,0,,Отырыңыз
Dialogue: 0,0:07:25.38,0:07:27.51,Default,,0,0,0,,Такинаны осында қайтарыңыз.
Dialogue: 0,0:07:27.59,0:07:30.05,Default,,0,0,0,,Сонда бұл туралы ойланудың қажеті жоқ.
Dialogue: 0,0:07:30.72,0:07:33.68,Default,,0,0,0,,А, бұл үшін рахмет~
Dialogue: 0,0:07:34.68,0:07:36.81,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:07:37.68,0:07:39.56,Default,,0,0,0,,-да? Бұл не болды?
Dialogue: 0,0:07:40.06,0:07:42.69,Default,,0,0,0,,Хмм? ұры өзін тапсырды
Dialogue: 0,0:07:43.19,0:07:44.44,Default,,0,0,0,,Бұл не? (Сензоку) Хехе
Dialogue: 0,0:07:44.52,0:07:45.52,Default,,0,0,0,,Бючон
Dialogue: 0,0:07:46.57,0:07:48.32,Default,,0,0,0,,Қош келдіңіз... Ах.
Dialogue: 0,0:07:48.90,0:07:51.61,Default,,0,0,0,,Parfait Parfait ~ Сіз тез жасауға болатын кез келген нәрсе.
Dialogue: 0,0:07:51.70,0:07:53.82,Default,,0,0,0,,Фуфуки бар ма?
Dialogue: 0,0:07:53.91,0:07:56.87,Default,,0,0,0,,Жоқ, мен бірден қайтамын, иә!
Dialogue: 0,0:07:56.95,0:07:58.54,Default,,0,0,0,,Ертеңге дейін жауап беріңіз.
Dialogue: 0,0:07:59.04,0:08:02.62,Default,,0,0,0,,Хмм... Иә? бұл?
Dialogue: 0,0:08:02.71,0:08:04.67,Default,,0,0,0,,Қайтару туралы бұйрық шығар.
Dialogue: 0,0:08:04.75,0:08:05.50,Default,,0,0,0,,Ах
Dialogue: 0,0:08:06.13,0:08:08.09,Default,,0,0,0,,Маджиманың жасырынған жері анықталды
Dialogue: 0,0:08:08.59,0:08:10.80,Default,,0,0,0,,Бізге басып кіру үшін әскери күш керек
Dialogue: 0,0:08:10.88,0:08:12.51,Default,,0,0,0,,Сізге жақсы!
Dialogue: 0,0:08:12.59,0:08:14.05,Default,,0,0,0,,Жүр, үйге қайтайық! Эх...
Dialogue: 0,0:08:14.13,0:08:16.14,Default,,0,0,0,,А-а-а... операция 3 күннен кейін.
Dialogue: 0,0:08:16.22,0:08:17.18,Default,,0,0,0,,Мырза, кешіріңіз.
Dialogue: 0,0:08:17.26,0:08:18.31,Default,,0,0,0,,Сіз әлі үйге барасыз ба?
Dialogue: 0,0:08:18.39,0:08:20.39,Default,,0,0,0,,Парфе ~ Қайта келіңіз
Dialogue: 0,0:08:21.52,0:08:23.48,Default,,0,0,0,,Иә! Такина
Dialogue: 0,0:08:24.60,0:08:25.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:25.56,0:08:27.23,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:27.98,0:08:32.03,Default,,0,0,0,,Мен ДА-ға қайта барғым келді, сондықтан мен сізге бақыттырақ болыңыз дедім.
Dialogue: 0,0:08:32.11,0:08:34.36,Default,,0,0,0,,Ақымақ ұстамады ма?
Dialogue: 0,0:08:34.45,0:08:35.32,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:08:35.86,0:08:38.03,Default,,0,0,0,,Иә, аяқталды~
Dialogue: 0,0:08:38.12,0:08:40.66,Default,,0,0,0,,Егер бітсе... (Чизоку) Иә? Иә иә түсінемін
Dialogue: 0,0:08:40.74,0:08:42.58,Default,,0,0,0,,Мен бос емеспін, сондықтан кезек берейін... (Чизоку) Танысқаныма қуаныштымын~
Dialogue: 0,0:08:43.08,0:08:44.62,Default,,0,0,0,,Иә? Такина
Dialogue: 0,0:08:44.71,0:08:46.21,Default,,0,0,0,,Не? (Сензоку) артта
Dialogue: 0,0:08:46.29,0:08:47.96,Default,,0,0,0,,Ах (Чизоку) Міне, өтінемін!
Dialogue: 0,0:08:48.04,0:08:49.67,Default,,0,0,0,,Уфф...
Dialogue: 0,0:08:49.75,0:08:53.38,Default,,0,0,0,,Ха, жүгіруге рұқсат бергенім үшін кешіріңіз.
Dialogue: 0,0:08:53.47,0:08:54.93,Default,,0,0,0,,Жоқ, ана жақтағы жігіттер ше?
Dialogue: 0,0:08:55.01,0:08:56.05,Default,,0,0,0,,Амансың ба? Ах!
Dialogue: 0,0:08:56.14,0:08:57.89,Default,,0,0,0,,А, жарайды, жарайды, ақыры.
Dialogue: 0,0:08:57.97,0:08:58.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:58.64,0:09:00.01,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:09:00.10,0:09:01.39,Default,,0,0,0,,Жүгірме!
Dialogue: 0,0:09:01.47,0:09:03.27,Default,,0,0,0,,(жүгірген аяқ дыбысы)
Dialogue: 0,0:09:07.44,0:09:12.07,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:09:15.32,0:09:16.91,Default,,0,0,0,,Сіз оны шегесіз.
Dialogue: 0,0:09:21.66,0:09:24.50,Default,,0,0,0,,Өзімді кінәлі сезінгендіктен, темекі шегкім келеді
Dialogue: 0,0:09:25.16,0:09:27.88,Default,,0,0,0,,Өзіңізді ренжіткеніңіз дұрыс
Dialogue: 0,0:09:27.96,0:09:30.21,Default,,0,0,0,,Егер сіз осылай темекі шегетін болсаңыз, тоқтаңыз.
Dialogue: 0,0:09:30.29,0:09:31.38,Default,,0,0,0,,Иә
Dialogue: 0,0:09:31.46,0:09:34.55,Default,,0,0,0,,Мен оны қарап шықтым. Менімен тезірек кеңесіңіз.
Dialogue: 0,0:09:35.05,0:09:38.22,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе? Әлемдік жаңғақ
Dialogue: 0,0:09:38.30,0:09:40.30,Default,,0,0,0,,Қазір бәрі бітті.
Dialogue: 0,0:09:40.89,0:09:43.10,Default,,0,0,0,,«Алан қозғалтқышы» «Шиндзи Йосимацу»
Dialogue: 0,0:09:43.60,0:09:45.73,Default,,0,0,0,,Интернетте олар туралы ақпарат жоқ.
Dialogue: 0,0:09:45.81,0:09:47.90,Default,,0,0,0,,Барлығының өшірілгенінің ізі ғана бар.
Dialogue: 0,0:09:48.48,0:09:49.56,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:09:49.65,0:09:52.86,Default,,0,0,0,,Сонымен... Мен оны тікелей білетін адамнан естігім келді.
Dialogue: 0,0:09:52.94,0:09:55.32,Default,,0,0,0,,Мен үйренбеген шайды қайнатып алдым.
Dialogue: 0,0:09:55.82,0:09:56.82,Default,,0,0,0,,(Миканың күрсінуі)
Dialogue: 0,0:10:00.28,0:10:01.99,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:10:03.12,0:10:06.12,Default,,0,0,0,,Мика Бұл Чизокуға арналған.
Dialogue: 0,0:10:06.66,0:10:08.12,Default,,0,0,0,,Сіз мұны түсінесіз бе?
Dialogue: 0,0:10:08.71,0:10:13.09,Default,,0,0,0,,Тыныш Джиннің ісі: Сензокудың жүрегін жаралаған әйел
Dialogue: 0,0:10:13.59,0:10:17.55,Default,,0,0,0,,Йосимацу ұйымдастырушы болуы мүмкін
Dialogue: 0,0:10:20.01,0:10:22.05,Default,,0,0,0,,Бұл 10 жыл бұрын болды.
Dialogue: 0,0:10:22.14,0:10:24.68,Default,,0,0,0,,О~
Dialogue: 0,0:10:25.89,0:10:28.06,Default,,0,0,0,,Бұл шынымен Йоши-сан.
Dialogue: 0,0:10:52.17,0:10:53.13,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:10:53.21,0:10:54.50,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:55.46,0:10:56.30,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:57.09,0:10:57.92,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:11:02.68,0:11:04.30,Default,,0,0,0,,Wonderful
Dialogue: 0,0:11:06.85,0:11:09.52,Default,,0,0,0,,Менің ойымша, сіз оны мылтықпен өлтіре алмайсыз.
Dialogue: 0,0:11:09.60,0:11:11.19,Default,,0,0,0,,А, бірақ...
Dialogue: 0,0:11:11.27,0:11:12.23,Default,,0,0,0,,Сензоку!
Dialogue: 0,0:11:12.31,0:11:14.52,Default,,0,0,0,,Сәлем Сензоку!
Dialogue: 0,0:11:15.02,0:11:17.90,Default,,0,0,0,,Туа біткен жүрек ақауы.
Dialogue: 0,0:11:17.99,0:11:22.24,Default,,0,0,0,,Алты айдан кейін ауру оны өлтірді.
Dialogue: 0,0:11:22.32,0:11:23.45,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:28.62,0:11:30.12,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:11:31.33,0:11:32.50,Default,,0,0,0,,(чемоданның ашылған дыбысы)
Dialogue: 0,0:11:34.63,0:11:35.67,Default,,0,0,0,,Бұл да
Dialogue: 0,0:11:35.75,0:11:39.67,Default,,0,0,0,,Аран институтының қолдауымен туған талант жемісі.
Dialogue: 0,0:11:40.26,0:11:43.47,Default,,0,0,0,,Соқпайтын толық алмастырғыш жасанды жүрек
Dialogue: 0,0:11:43.97,0:11:47.31,Default,,0,0,0,,Қазіргі белгілі технологиядан бірнеше ұрпақ алда⸺
Dialogue: 0,0:11:47.39,0:11:50.14,Default,,0,0,0,,Ең практикалық алмастырғыш.
Dialogue: 0,0:11:50.23,0:11:53.31,Default,,0,0,0,,Дегенмен, ол мінсіз емес.
Dialogue: 0,0:11:53.40,0:11:54.48,Default,,0,0,0,,дегенді қалай түсінесіңдер?
Dialogue: 0,0:11:54.56,0:11:56.90,Default,,0,0,0,,Төзімділік мәселелері
Dialogue: 0,0:11:57.40,0:11:59.94,Default,,0,0,0,,Кәмелетке толғанша шығар
Dialogue: 0,0:12:01.28,0:12:04.20,Default,,0,0,0,,Мия тек 18 жаста.
Dialogue: 0,0:12:04.28,0:12:05.95,Default,,0,0,0,,Осыншама ұзақ өмір сүру жеткілікті...
Dialogue: 0,0:12:06.03,0:12:08.16,Default,,0,0,0,,Өлтіруге жеткілікті ме? Уф...
Dialogue: 0,0:12:08.74,0:12:12.37,Default,,0,0,0,,Өлтіретін талантыңызды әлемге жеткізіңіз
Dialogue: 0,0:12:12.96,0:12:15.92,Default,,0,0,0,,Бұл ең маңызды шарт.
Dialogue: 0,0:12:18.05,0:12:20.05,Default,,0,0,0,,Үміттерді ақтайық
Dialogue: 0,0:12:22.55,0:12:26.01,Default,,0,0,0,,Сендзокуды өлтіру құралы ретінде де көрдіңіз бе?
Dialogue: 0,0:12:27.55,0:12:28.56,Default,,0,0,0,,Ол қашан өзгерді?
Dialogue: 0,0:12:32.48,0:12:34.23,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:34.31,0:12:35.98,Default,,0,0,0,,Сіз оны қайтадан көріп жатырсыз ба?
Dialogue: 0,0:12:36.48,0:12:39.40,Default,,0,0,0,,Мика Сіз балаларға жақсы қарайсыз ба?
Dialogue: 0,0:12:39.90,0:12:41.36,Default,,0,0,0,,Мен бұған жақсы емеспін.
Dialogue: 0,0:12:41.44,0:12:43.82,Default,,0,0,0,,Сізді үнемі балалар қоршап жүресіз бе?
Dialogue: 0,0:12:43.90,0:12:47.57,Default,,0,0,0,,Бұл жұмыс. Мына аяғым болмаса, қолымнан келмес еді.
Dialogue: 0,0:12:47.66,0:12:48.91,Default,,0,0,0,,Сәлем Мика
Dialogue: 0,0:12:49.41,0:12:53.54,Default,,0,0,0,,Операциядан кейін бұл балаға оның қабілеттерін пайдалануға көмектесуіңізді қалаймын.
Dialogue: 0,0:12:53.62,0:12:57.00,Default,,0,0,0,,Әрине, ДА баланы тәрбиелеуге жауапты болады.
Dialogue: 0,0:12:57.08,0:12:58.96,Default,,0,0,0,,Мен сізден сұраймын
Dialogue: 0,0:12:59.63,0:13:01.92,Default,,0,0,0,,Ол біздің қызымыз емес пе?
Dialogue: 0,0:13:02.71,0:13:03.63,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:13:04.26,0:13:06.13,Default,,0,0,0,,Мен мұндай миссияға бірінші рет қатысып отырмын.
Dialogue: 0,0:13:06.64,0:13:07.89,Default,,0,0,0,,Миссия емес
Dialogue: 0,0:13:08.76,0:13:11.81,Default,,0,0,0,,Сен екеуміздің арамыздағы уәде
Dialogue: 0,0:13:14.39,0:13:17.35,Default,,0,0,0,,Кейбір қосымша оқиғалар араласқан ба деп ойлаймын.
Dialogue: 0,0:13:17.44,0:13:20.73,Default,,0,0,0,,Жоқ, оның тұлғасы да бір сыр.
Dialogue: 0,0:13:21.86,0:13:26.20,Default,,0,0,0,,Осылайша Чизоку екеуміз ата-ана мен бала ойнай бастадық.
Dialogue: 0,0:13:31.08,0:13:31.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:34.62,0:13:35.91,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:13:38.92,0:13:39.79,Default,,0,0,0,,Ха… га
Dialogue: 0,0:13:44.97,0:13:48.39,Default,,0,0,0,,Сіз бе? маған көмектесетін адам
Dialogue: 0,0:13:48.47,0:13:51.31,Default,,0,0,0,,Иә, сіз дұрыс емес адамсыз. Мен мұнда қызметкермін.
Dialogue: 0,0:13:51.39,0:13:52.56,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:13:52.64,0:13:55.52,Default,,0,0,0,,Мұнда мұндай керемет костюм киген ешкім жоқ.
Dialogue: 0,0:13:55.60,0:13:57.56,Default,,0,0,0,,Ахаха рахмет
Dialogue: 0,0:13:57.64,0:14:00.31,Default,,0,0,0,,Жоқ, «рахмет» менікі.
Dialogue: 0,0:14:00.40,0:14:02.27,Default,,0,0,0,,Сізге қалай алғыс айтуым керек?
Dialogue: 0,0:14:06.99,0:14:10.99,Default,,0,0,0,,Сізде үлкен миссия бар, оны орындаңыз.
Dialogue: 0,0:14:11.87,0:14:14.20,Default,,0,0,0,,Сол себепті мен...
Dialogue: 0,0:14:15.45,0:14:18.46,Default,,0,0,0,,Ой, мен құтқарушы болдым.
Dialogue: 0,0:14:19.12,0:14:21.00,Default,,0,0,0,,Құтқарушы?
Dialogue: 0,0:14:29.22,0:14:32.76,Default,,0,0,0,,Рахмет, мен де аламын.
Dialogue: 0,0:14:32.85,0:14:34.31,Default,,0,0,0,,Құтқарушы!
Dialogue: 0,0:14:40.94,0:14:42.11,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:14:43.61,0:14:45.98,Default,,0,0,0,,Құтқарушы ірімшік! (Ёшимацу) Ха
Dialogue: 0,0:14:46.07,0:14:47.03,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:50.45,0:14:51.16,Default,,0,0,0,,Эххе
Dialogue: 0,0:14:55.70,0:14:59.58,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:14:59.67,0:15:06.25,Default,,0,0,0,,(Жүрек-өкпе аппаратының механикалық дыбысы және электрокардиограмма мониторының синхрондалған дыбысы)
Dialogue: 0,0:15:06.34,0:15:08.05,Default,,0,0,0,,Мұғалім қорқынышты
Dialogue: 0,0:15:08.13,0:15:11.64,Default,,0,0,0,,Уайымдама, бәрі жақсы болады.
Dialogue: 0,0:15:12.22,0:15:13.10,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:17.60,0:15:18.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:19.43,0:15:20.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:22.56,0:15:24.52,Default,,0,0,0,,Құтқарушы...
Dialogue: 0,0:15:38.45,0:15:39.66,Default,,0,0,0,,Мереке?
Dialogue: 0,0:15:40.91,0:15:41.87,Default,,0,0,0,,Кімнен?
Dialogue: 0,0:15:43.50,0:15:44.84,Default,,0,0,0,,Құтқарушы
Dialogue: 0,0:15:46.92,0:15:50.26,Default,,0,0,0,,Сонда бұл адамдарға көмектесетін мылтық.
Dialogue: 0,0:15:52.47,0:15:55.43,Default,,0,0,0,,Содан бері Синдзи жоғалып кетті.
Dialogue: 0,0:15:55.93,0:15:57.43,Default,,0,0,0,,Тіпті маған дейін
Dialogue: 0,0:16:00.85,0:16:03.69,Default,,0,0,0,,Чизоку неге өлтірмейді?
Dialogue: 0,0:16:04.73,0:16:06.15,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:16:07.48,0:16:09.99,Default,,0,0,0,,Бірақ сен неге Сендзоку өмірін мақсат етіп отырсың?
Dialogue: 0,0:16:10.74,0:16:14.32,Default,,0,0,0,,Сіз өз миссиясын орындамағандарды жоюды жоспарлайсыз ба?
Dialogue: 0,0:16:14.41,0:16:17.37,Default,,0,0,0,,Содан әлгі медбике оны өлтірді.
Dialogue: 0,0:16:18.87,0:16:20.33,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:16:20.41,0:16:22.91,Default,,0,0,0,,Мені нысанаға алған Алан Йосимацу болса керек.
Dialogue: 0,0:16:23.00,0:16:25.96,Default,,0,0,0,,Мен де сол күні қару алған Маджимамен байланыстамын.
Dialogue: 0,0:16:26.46,0:16:30.05,Default,,0,0,0,,Оны неге идеологиялық жақтайтыныңызды енді түсіндім.
Dialogue: 0,0:16:30.55,0:16:31.63,Default,,0,0,0,,Маджима қолға түссе, о
Dialogue: 0,0:16:31.72,0:16:34.43,Default,,0,0,0,,Бұл сендзокудың жүрегі туралы білетініңді білдіре ме?
Dialogue: 0,0:16:34.51,0:16:35.84,Default,,0,0,0,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:16:35.93,0:16:37.14,Default,,0,0,0,,Иә, Мизуки де.
Dialogue: 0,0:16:37.22,0:16:40.31,Default,,0,0,0,,Ха, менімен бөлісудің қажеті жоқ.
Dialogue: 0,0:16:40.39,0:16:42.43,Default,,0,0,0,,Мен оның ізін таба алмағандықтан.
Dialogue: 0,0:16:42.52,0:16:45.44,Default,,0,0,0,,Маджиманың жарқыраған қимылдарын қадағалау оңай.
Dialogue: 0,0:16:46.10,0:16:48.94,Default,,0,0,0,,ДА операцияларына қатысу мүмкіндігі.
Dialogue: 0,0:16:49.57,0:16:51.19,Default,,0,0,0,,Мен бас тартуды ойладым.
Dialogue: 0,0:16:51.28,0:16:53.65,Default,,0,0,0,,Неліктен? Бұл сіз күткен қайтып келу ме?
Dialogue: 0,0:16:55.70,0:16:59.66,Default,,0,0,0,,Бұл Сензокудың соңғы екі айы.
Dialogue: 0,0:17:01.20,0:17:03.83,Default,,0,0,0,,Бірақ мен ДА-ға қайта ораламын.
Dialogue: 0,0:17:03.91,0:17:07.63,Default,,0,0,0,,Чизокудың өмір сүруіне ең кішкентай мүмкіндік болса
Dialogue: 0,0:17:08.25,0:17:10.30,Default,,0,0,0,,Мен Сензокуға айтамын
Dialogue: 0,0:17:10.38,0:17:12.21,Default,,0,0,0,,Жоқ, мен өзім айтамын.
Dialogue: 0,0:17:12.92,0:17:14.30,Default,,0,0,0,,Маған уақыт беріңіз.
Dialogue: 0,0:17:15.26,0:17:17.43,Default,,0,0,0,,Хаа~ Аа?
Dialogue: 0,0:17:17.51,0:17:19.35,Default,,0,0,0,,Сәлем! Қашан?
Dialogue: 0,0:17:19.43,0:17:22.35,Default,,0,0,0,,Ол Йоши мырзаны айтты... Ол кім?
Dialogue: 0,0:17:22.43,0:17:24.48,Default,,0,0,0,,Ал... келіңіздер.
Dialogue: 0,0:17:24.56,0:17:25.64,Default,,0,0,0,,Фухун (Робота) Уау, түсіндім!
Dialogue: 0,0:17:25.73,0:17:28.23,Default,,0,0,0,,Мен оны қолдаған Aran агенттігінің агентімін.
Dialogue: 0,0:17:28.31,0:17:29.56,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:17:30.15,0:17:32.78,Default,,0,0,0,,Мен Робота стратегиясын ойлап таптым.
Dialogue: 0,0:17:33.69,0:17:34.65,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:17:35.82,0:17:38.28,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:17:38.37,0:17:39.99,Default,,0,0,0,,(Аня) Кешкі асқа не бермек екен? (Іштің күркіреген дыбысы)
Dialogue: 0,0:17:40.08,0:17:41.37,Default,,0,0,0,,Қош келдіңіз! Эй, қош келдіңіз!
Dialogue: 0,0:17:41.45,0:17:42.83,Default,,0,0,0,,Эй, эй, эй!
Dialogue: 0,0:17:42.91,0:17:44.20,Default,,0,0,0,,Эй, кеттік... Жаккаашии!
Dialogue: 0,0:17:44.29,0:17:46.33,Default,,0,0,0,,О, кешіріңіз.
Dialogue: 0,0:17:46.41,0:17:49.08,Default,,0,0,0,,А, мен жалықтым.
Dialogue: 0,0:17:49.17,0:17:50.79,Default,,0,0,0,,Ах
Dialogue: 0,0:17:50.88,0:17:51.75,Default,,0,0,0,,Азусагава, ақыл-есің дұрыс па? Өкінішке орай, жоқ.
Dialogue: 0,0:17:51.84,0:17:53.59,Default,,0,0,0,,О, о... қош келдіңіз
Dialogue: 0,0:17:55.97,0:17:57.22,Default,,0,0,0,,Мен сендерге шағын әңгіме айтып берейін.
Dialogue: 0,0:17:57.30,0:17:59.14,Default,,0,0,0,,Не? Күрсін...
Dialogue: 0,0:17:59.72,0:18:00.80,Default,,0,0,0,,Хмм?
Dialogue: 0,0:18:01.93,0:18:03.31,Default,,0,0,0,,Сіз не ойнап жатырсыз?
Dialogue: 0,0:18:03.97,0:18:05.18,Default,,0,0,0,,Не? (Чизоку) Иә?
Dialogue: 0,0:18:09.65,0:18:10.73,Default,,0,0,0,,Сыртқа шығайық
Dialogue: 0,0:18:11.23,0:18:11.94,Default,,0,0,0,,Ha
Dialogue: 0,0:18:12.52,0:18:13.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:14.28,0:18:15.49,Default,,0,0,0,,Жоспар
Dialogue: 0,0:18:18.78,0:18:22.66,Default,,0,0,0,,Біріншіден, бұл жерде суық емес пе? ол
Dialogue: 0,0:18:22.74,0:18:25.08,Default,,0,0,0,,Бұл Чизоку таңдаған.
Dialogue: 0,0:18:25.16,0:18:27.66,Default,,0,0,0,,Хмм... Бұл жазғы киім. Басқа ештеңең жоқ па?
Dialogue: 0,0:18:27.75,0:18:28.46,Default,,0,0,0,,Маған біртіндеп орал
Dialogue: 0,0:18:30.63,0:18:31.33,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:31.42,0:18:34.92,Default,,0,0,0,,Senzoku-san has chosen the winter version of Takina!
Dialogue: 0,0:18:37.47,0:18:40.59,Default,,0,0,0,,Уау! Бұл шынымен жақсы материал.
Dialogue: 0,0:18:40.68,0:18:42.85,Default,,0,0,0,,Ах
Dialogue: 0,0:18:43.56,0:18:45.85,Default,,0,0,0,,Қозғалатын уақыт келді.
Dialogue: 0,0:18:45.93,0:18:47.35,Default,,0,0,0,,Не? Мен әлі де пальто сатып аламын ...
Dialogue: 0,0:18:47.43,0:18:49.31,Default,,0,0,0,,I don't have much time, so I'll do this (Chizoku) Huh?
Dialogue: 0,0:18:49.39,0:18:50.65,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:18:51.35,0:18:52.56,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:18:53.06,0:18:55.90,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:18:56.86,0:18:59.86,Default,,0,0,0,,Неге сонша тез қозғаласың?
Dialogue: 0,0:18:59.95,0:19:00.70,Default,,0,0,0,,Бұл құпия
Dialogue: 0,0:19:01.66,0:19:03.24,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:19:06.45,0:19:08.33,Default,,0,0,0,,Өмір жоспар бойынша өтеді
Dialogue: 0,0:19:08.41,0:19:09.83,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:19:09.92,0:19:12.79,Default,,0,0,0,,Сәттілік.
Dialogue: 0,0:19:15.30,0:19:18.51,Default,,0,0,0,,Қиындықтан ләззат алу - сендзоку стилі.
Dialogue: 0,0:19:21.80,0:19:24.76,Default,,0,0,0,,I can't catch it (Senzoku) I can't catch it.
Dialogue: 0,0:19:25.26,0:19:28.02,Default,,0,0,0,,Бұл көңілді ме? (Чизоку) Хехе, қызық екен.
Dialogue: 0,0:19:28.10,0:19:29.68,Default,,0,0,0,,Егер мен Такинамен бірге болсам
Dialogue: 0,0:19:31.19,0:19:34.19,Default,,0,0,0,,О, уақыт келді.
Dialogue: 0,0:19:36.02,0:19:36.73,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:36.82,0:19:38.19,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,0:19:40.11,0:19:42.86,Default,,0,0,0,,Мен біраз бара жатырмын. Қайда бара жатырсың?
Dialogue: 0,0:19:42.95,0:19:43.99,Default,,0,0,0,,Бұл құпия
Dialogue: 0,0:19:54.29,0:19:55.13,Default,,0,0,0,,(Такинано түшкірді)
Dialogue: 0,0:19:55.21,0:19:57.88,Default,,0,0,0,,Сондықтан мен пальто сатып алуым керек еді.
Dialogue: 0,0:19:57.96,0:19:59.34,Default,,0,0,0,,Жақсы... жақсы
Dialogue: 0,0:20:00.17,0:20:01.05,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:20:01.93,0:20:03.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:06.43,0:20:07.64,Default,,0,0,0,,Сіз бірдеңе күтіп тұрсыз ба?
Dialogue: 0,0:20:08.14,0:20:09.77,Default,,0,0,0,,Қар... сағат 9-дан бастап
Dialogue: 0,0:20:09.85,0:20:12.23,Default,,0,0,0,,Каха Со
Dialogue: 0,0:20:12.31,0:20:14.77,Default,,0,0,0,,Бұл тамаша кесте болуы керек еді.
Dialogue: 0,0:20:14.85,0:20:18.94,Default,,0,0,0,,Хехехехе, құдай құбылмалы ғой.
Dialogue: 0,0:20:19.86,0:20:23.61,Default,,0,0,0,,Мен бүгін ғана тоқтағанымды қалаймын.
Dialogue: 0,0:20:24.11,0:20:25.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:26.20,0:20:27.16,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:28.95,0:20:31.62,Default,,0,0,0,,Мен DA-ға қайта орала аламын ба? Ах...
Dialogue: 0,0:20:31.71,0:20:34.58,Default,,0,0,0,,Күтілгендей! Сіз жасадыңыз. Қашан?
Dialogue: 0,0:20:36.46,0:20:37.38,Default,,0,0,0,,Ертең
Dialogue: 0,0:20:38.80,0:20:39.96,Default,,0,0,0,,Сіз бақытты емессіз бе?
Dialogue: 0,0:20:40.46,0:20:41.80,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:20:42.47,0:20:46.34,Default,,0,0,0,,I see, it sure would have been nice if it rained~
Dialogue: 0,0:20:46.85,0:20:47.64,Default,,0,0,0,,Иә
Dialogue: 0,0:20:53.73,0:20:57.31,Default,,0,0,0,,It's all unreasonable, don't you think so?
Dialogue: 0,0:20:58.57,0:21:02.36,Default,,0,0,0,,There's no use worrying about things that are out of your control.
Dialogue: 0,0:21:02.44,0:21:04.53,Default,,0,0,0,,Оны қабылдаңыз және бар күшіңізді салыңыз!
Dialogue: 0,0:21:05.03,0:21:07.37,Default,,0,0,0,,Әдетте жақсы нәрселер осылай болады.
Dialogue: 0,0:21:07.87,0:21:11.20,Default,,0,0,0,,Сонымен қатар, Такинаның жоспары өте сәтті.
Dialogue: 0,0:21:11.79,0:21:14.21,Default,,0,0,0,,Мен бүгін өте қызық болдым.
Dialogue: 0,0:21:14.29,0:21:15.67,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:21:18.92,0:21:19.84,Default,,0,0,0,,Иә
Dialogue: 0,0:21:21.46,0:21:22.59,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:21:23.84,0:21:26.38,Default,,0,0,0,,А, мен бүгін ДА-ға хабарласуым керек.
Dialogue: 0,0:21:26.47,0:21:27.80,Default,,0,0,0,,Иә, алға.
Dialogue: 0,0:21:28.72,0:21:29.30,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:21:29.39,0:21:31.39,Default,,0,0,0,,Қоштасу, қабыл алыңыздар!
Dialogue: 0,0:21:31.47,0:21:34.27,Default,,0,0,0,,Рахмет, мен барамын.
Dialogue: 0,0:21:39.90,0:21:40.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:41.52,0:21:42.73,Default,,0,0,0,,О~
Dialogue: 0,0:21:46.78,0:21:47.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:48.53,0:21:49.16,Default,,0,0,0,,Ах
Dialogue: 0,0:22:08.13,0:22:10.14,Default,,0,0,0,,♪~
Dialogue: 0,0:23:21.75,0:23:23.75,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.34,0:23:29.72,Default,,0,0,0,,(Смартфон қоңырау үні)
Dialogue: 0,0:23:29.80,0:23:30.51,Default,,0,0,0,,(Қоңырауды ажырату дыбысы)
Dialogue: 0,0:23:33.55,0:23:34.68,Default,,0,0,0,,Синдзи…
Dialogue: 0,0:23:36.39,0:23:37.39,Default,,0,0,0,,Мика
Dialogue: 0,0:23:38.93,0:23:39.43,Default,,0,0,0,,Ах
Dialogue: 0,0:23:40.10,0:23:40.60,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:23:40.69,0:23:42.40,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:23:42.48,0:23:44.11,Default,,0,0,0,,(Миньондардың қадамдары)
Dialogue: 0,0:23:45.90,0:23:48.65,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:23:53.87,0:23:55.53,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:23:58.66,0:24:00.12,Default,,0,0,0,,Йоши мырза
Dialogue: 0,0:24:01.62,0:24:06.62,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
