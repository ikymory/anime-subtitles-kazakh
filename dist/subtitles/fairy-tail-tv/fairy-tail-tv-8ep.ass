Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.60,0:00:12.13,Default,,0000,0000,0000,,<Фиор патшалығы.
Dialogue: 0,0:00:12.13,0:00:16.01,Default,,0000,0000,0000,,17 миллион халқы бар тұрақты бейтарап ел.
Dialogue: 0,0:00:16.01,0:00:19.54,Default,,0000,0000,0000,,Бұл сиқырлы әлем.
Dialogue: 0,0:00:19.54,0:00:25.27,Default,,0000,0000,0000,,Сиқыр әдетте сатып алынады және сатылды және адамдардың өмірінде терең тамыр жайды.
Dialogue: 0,0:00:25.27,0:00:30.98,Default,,0000,0000,0000,,Ал сол сиқырды толық пайдаланып күн көріп жатқандар бар.
Dialogue: 0,0:00:30.98,0:00:34.69,Default,,0000,0000,0000,,Адамдар оларды сиқыршылар деп атады.
Dialogue: 0,0:00:34.69,0:00:38.73,Default,,0000,0000,0000,,Сиқыршылар әртүрлі гильдияларға жатады→
Dialogue: 0,0:00:38.73,0:00:41.76,Default,,0000,0000,0000,,Сұраныс бойынша жұмысты орындау.
Dialogue: 0,0:00:41.76,0:00:44.96,Default,,0000,0000,0000,,Елде көптеген гильдиялар бар.
Dialogue: 0,0:00:44.96,0:00:49.84,Default,,0000,0000,0000,,Белгілі бір қалада сиқыршылар гильдиясы бар.
Dialogue: 0,0:00:49.84,0:00:56.41,Default,,0000,0000,0000,,Өткенде немесе тіпті болашақта көптеген аңыздарды жасаған гильдия.
Dialogue: 0,0:00:56.41,0:01:01.41,Default,,0000,0000,0000,,Оның аты... «Ертегі»>
Dialogue: 0,0:03:43.74,0:03:46.77,Default,,0000,0000,0000,,<Нацу: соңғы ретке дейін «ЕРтегі»>
Dialogue: 0,0:03:46.77,0:03:49.14,Default,,0000,0000,0000,,Екеуің маған күш-қуат беріңдер деп едім. Сіз маған ілесе аласыз ба?
Dialogue: 0,0:03:49.14,0:03:52.14,Default,,0000,0000,0000,,《Осы жігітпен бе? 》 《Сұр: команда ма? 》
Dialogue: 0,0:03:58.06,0:04:00.06,Default,,0000,0000,0000,,Қандай үлкен мәселе!
Dialogue: 0,0:04:05.80,0:04:13.72,Default,,0000,0000,0000,,<Ежелгі заманның қара сиқыршысы Зереф жасаған тыйым салынған сиқырлы бесік жыры.
Dialogue: 0,0:04:13.72,0:04:19.77,Default,,0000,0000,0000,,Сыбызғы үні адамның жанын ұрлайды дейді.
Dialogue: 0,0:04:19.77,0:04:26.77,Default,,0000,0000,0000,,Бесік жырының ысқырығы үшін тартыс аяқталуға жақын>
Dialogue: 0,0:04:34.75,0:04:36.44,Default,,0000,0000,0000,,Нацу!
Dialogue: 0,0:04:36.44,0:04:40.15,Default,,0000,0000,0000,,Хаха Түсіндің бе, Fairy Tail фильміндегі кішкентай бала?
Dialogue: 0,0:04:40.15,0:04:43.51,Default,,0000,0000,0000,,От желді жеңе алмайды.
Dialogue: 0,0:04:43.51,0:04:46.55,Default,,0000,0000,0000,,Қарғыс атсын. Бұл тайфунға ұқсайды.
Dialogue: 0,0:04:46.55,0:04:50.75,Default,,0000,0000,0000,,Жалын енді сізге жете алмайды!
Dialogue: 0,0:04:50.75,0:04:54.62,Default,,0000,0000,0000,,Уау. Қарғыс атсын. Storm Shred!
Dialogue: 0,0:04:54.62,0:04:57.32,Default,,0000,0000,0000,,Қиямет! бұл! Эй!
Dialogue: 0,0:04:57.32,0:05:06.07,Default,,0000,0000,0000,,Ха ха. Жеткізу!
Dialogue: 0,0:05:06.07,0:05:10.07,Default,,0000,0000,0000,,Отты былай қойғанда, оған жақындай да алмаймын. Қат!
Dialogue: 0,0:05:17.02,0:05:20.21,Default,,0000,0000,0000,,Не болды, балақай? Бұл солай ма?
Dialogue: 0,0:05:20.21,0:05:23.91,Default,,0000,0000,0000,,Сүйегі көп жігіт деп ойладым.
Dialogue: 0,0:05:23.91,0:05:26.44,Default,,0000,0000,0000,,Өте орынды. Мен мұны аяқтаймын.
Dialogue: 0,0:05:26.44,0:05:30.44,Default,,0000,0000,0000,,Барлығын кесетін жел сиқыры, Эмера Балам!
Dialogue: 0,0:05:34.85,0:05:36.70,Default,,0000,0000,0000,,Тіпті Эмера Балаам! ?
Dialogue: 0,0:05:36.70,0:05:39.90,Default,,0000,0000,0000,,Егер сіз бұған жол берсеңіз, сіз ыдырайсыз.
Dialogue: 0,0:05:39.90,0:05:42.90,Default,,0000,0000,0000,,Шашырау. Жанып тұрған сұм бала!
Dialogue: 0,0:05:48.33,0:05:51.69,Default,,0000,0000,0000,,Нацу! Нацу оян!
Dialogue: 0,0:05:51.69,0:05:57.58,Default,,0000,0000,0000,,Уау, сол денені қалдырудың өзі үлкен мәселе.
Dialogue: 0,0:05:57.58,0:06:00.45,Default,,0000,0000,0000,,Бұл жас сиқыршы үшін үлкен жетістік болды.
Dialogue: 0,0:06:00.45,0:06:03.64,Default,,0000,0000,0000,,Нацу. Уайымдама.
Dialogue: 0,0:06:03.64,0:06:06.01,Default,,0000,0000,0000,,Мен қарттарды бірден сонда жіберемін.
Dialogue: 0,0:06:06.01,0:06:09.01,Default,,0000,0000,0000,,Бесік жырының әуенімен.
Dialogue: 0,0:06:11.56,0:06:14.59,Default,,0000,0000,0000,,Не... бұл бесік жыры.
Dialogue: 0,0:06:14.59,0:06:17.62,Default,,0000,0000,0000,,Атаның басын қаласаң, әділ, шаршы алаңға тарт.
Dialogue: 0,0:06:17.62,0:06:22.83,Default,,0000,0000,0000,,Нацу күткендей! Ақымақ! Тұру!
Dialogue: 0,0:06:22.83,0:06:25.03,Default,,0000,0000,0000,,Күресуге батылың жетпесе, менімен араласпа!
Dialogue: 0,0:06:25.03,0:06:27.03,Default,,0000,0000,0000,,Қандай қыңыр бала!
Dialogue: 0,0:06:32.10,0:06:36.64,Default,,0000,0000,0000,,Боқ. Хмф!
Dialogue: 0,0:06:36.64,0:06:40.85,Default,,0000,0000,0000,,Чикушо Мен неге жақындай алмаймын?
Dialogue: 0,0:06:40.85,0:06:43.87,Default,,0000,0000,0000,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:06:43.87,0:06:50.28,Default,,0000,0000,0000,,Мен түсінбеймін! Сені қарғаймын!
Dialogue: 0,0:06:50.28,0:06:53.28,Default,,0000,0000,0000,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:06:55.16,0:06:57.18,Default,,0000,0000,0000,,Бұл қорқынышты сиқыр.
Dialogue: 0,0:06:57.18,0:07:01.06,Default,,0000,0000,0000,,Сіздің эмоцияларыңыз жалынға айналып жатқан сияқты.
Dialogue: 0,0:07:01.06,0:07:03.91,Default,,0000,0000,0000,,Бұл! ?
Dialogue: 0,0:07:03.91,0:07:07.28,Default,,0000,0000,0000,,Эригордың желі біртүрлі бағытта ағып жатыр.
Dialogue: 0,0:07:07.28,0:07:09.14,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,0:07:09.14,0:07:12.00,Default,,0000,0000,0000,,《Эмоцияның жалыны! ?
Dialogue: 0,0:07:12.00,0:07:15.03,Default,,0000,0000,0000,,Ежелгі сиқырда мұндай сиқырдың бар екеніне сенімдімін.
Dialogue: 0,0:07:15.03,0:07:18.39,Default,,0000,0000,0000,,Жоқ, мұндай жас жігіт...》
Dialogue: 0,0:07:18.39,0:07:20.92,Default,,0000,0000,0000,,Хмм... Не! ?
Dialogue: 0,0:07:20.92,0:07:23.61,Default,,0000,0000,0000,,Жел оған қарсы! Мен түсінемін!
Dialogue: 0,0:07:23.61,0:07:27.15,Default,,0000,0000,0000,,Уау! ! Нацу!
Dialogue: 0,0:07:27.15,0:07:31.15,Default,,0000,0000,0000,,Жоқ... Нацу жеңе алмайды. Оны Грейге қалдырыңыз.
Dialogue: 0,0:07:35.73,0:07:38.92,Default,,0000,0000,0000,,Не болды! !
Dialogue: 0,0:07:38.92,0:07:41.13,Default,,0000,0000,0000,,Қарғыс атсын... дауылды поштаны шайып жатыр!
Dialogue: 0,0:07:41.13,0:07:45.33,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,0:07:45.33,0:07:47.85,Default,,0000,0000,0000,,Бар!
Dialogue: 0,0:07:47.85,0:07:50.88,Default,,0000,0000,0000,,《Айналадағы ауа Нацудың өте жоғары температурасымен қызады→
Dialogue: 0,0:07:50.88,0:07:53.24,Default,,0000,0000,0000,,Кенеттен көтерілу →
Dialogue: 0,0:07:53.24,0:07:54.09,Default,,0000,0000,0000,,Төмен қысым жүйесі пайда болды.
Dialogue: 0,0:07:54.09,0:07:58.62,Default,,0000,0000,0000,,Жел төменгі атмосфералық қысымға қарай ағады.
Dialogue: 0,0:07:58.62,0:08:01.49,Default,,0000,0000,0000,,Мен сені жеңемін!
Dialogue: 0,0:08:01.49,0:08:05.70,Default,,0000,0000,0000,,《Осындай қызу сиқыры... Бұл жігіт, мүмкін емес! ? 》
Dialogue: 0,0:08:05.70,0:08:08.70,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:11.25,0:08:12.27,Default,,0000,0000,0000,,От айдаһар қылыш мүйізі!
Dialogue: 0,0:08:12.27,0:08:15.96,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:08:15.96,0:08:20.18,Default,,0000,0000,0000,,《Ол болды... Айдаһар өлтіруші! 》
Dialogue: 0,0:08:20.18,0:08:25.23,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Бақытты! махаббат! Нацу саламандр күткендей.
Dialogue: 0,0:08:25.23,0:08:27.92,Default,,0000,0000,0000,,Сіз бұрын не жинадыңыз?
Dialogue: 0,0:08:27.92,0:08:30.61,Default,,0000,0000,0000,,Мысықтың есте сақтау қабілеті нашар.
Dialogue: 0,0:08:30.61,0:08:34.65,Default,,0000,0000,0000,,Мен бұл жігітті жеңе алмаймын дедім, сонда Эльза ше?
Dialogue: 0,0:08:34.65,0:08:38.19,Default,,0000,0000,0000,,Уау~ Менің есте сақтау қабілетім мысықтан да нашар. Грей, Эрза емес.
Dialogue: 0,0:08:38.19,0:08:42.56,Default,,0000,0000,0000,,Бірақ Нацу жеңді!
Dialogue: 0,0:08:42.56,0:08:44.75,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:08:44.75,0:08:46.28,Default,,0000,0000,0000,,Соңында неге соққы алдыңыз?
Dialogue: 0,0:08:46.28,0:08:51.28,Default,,0000,0000,0000,,Өйткені Нацу керемет! Түсінемін~ Ахахаха!
Dialogue: 0,0:08:54.19,0:08:56.21,Default,,0000,0000,0000,,Нацу!
Dialogue: 0,0:08:56.21,0:08:59.40,Default,,0000,0000,0000,,Әй, кешігіп қалдың ғой? Қазір бітті.
Dialogue: 0,0:08:59.40,0:09:02.26,Default,,0000,0000,0000,,Ай! Күткендей.
Dialogue: 0,0:09:02.26,0:09:04.45,Default,,0000,0000,0000,,Ке! Эльза, жақсысың ба?
Dialogue: 0,0:09:04.45,0:09:07.64,Default,,0000,0000,0000,,А, уайымдама.
Dialogue: 0,0:09:07.64,0:09:13.71,Default,,0000,0000,0000,,《Кагеяма: Бұл... Мен Эригор-санның жеңілетініне сенбеймін...》
Dialogue: 0,0:09:13.71,0:09:15.56,Default,,0000,0000,0000,,Мұндай адамға қарсы тұру қиынға соғады.
Dialogue: 0,0:09:15.56,0:09:18.25,Default,,0000,0000,0000,,Сіз қиналып жатырсыз ба? Керемет жеңіс! Керемет жеңіс!
Dialogue: 0,0:09:18.25,0:09:20.28,Default,,0000,0000,0000,,Бұл нәзік нүкте.
Dialogue: 0,0:09:20.28,0:09:23.48,Default,,0000,0000,0000,,Цукайо, сен жалаңаш орамал тағып жүрген бұзық сияқтысың.
Dialogue: 0,0:09:23.48,0:09:26.84,Default,,0000,0000,0000,,Сіз айтасыз ба? Люси, маған киіміңді қарызға бер.
Dialogue: 0,0:09:26.84,0:09:28.70,Default,,0000,0000,0000,,Неге мен! ? Фуфуфу….
Dialogue: 0,0:09:28.70,0:09:31.89,Default,,0000,0000,0000,,Қалай болғанда да, бұл керемет, Нацу.
Dialogue: 0,0:09:31.89,0:09:34.89,Default,,0000,0000,0000,,Енді магистрлер қорғалған.
Dialogue: 0,0:09:36.94,0:09:39.30,Default,,0000,0000,0000,,Айтпақшы. Кәдімгі жиналыс өтетін жерге барыңыз →
Dialogue: 0,0:09:39.30,0:09:44.35,Default,,0000,0000,0000,,Шеберден оқиға туралы хабарлауға және ысқырықты жоюға қатысты нұсқауларды сұраңыз.
Dialogue: 0,0:09:44.35,0:09:46.35,Default,,0000,0000,0000,,Кловер дәл сол жерде.
Dialogue: 0,0:09:53.28,0:09:56.63,Default,,0000,0000,0000,,Кейдж! Бұл қауіпті!
Dialogue: 0,0:09:56.63,0:10:01.63,Default,,0000,0000,0000,,Мен бесік жырын алдым! Сақтанбаңыз, ұшатындар! Хахахаха!
Dialogue: 0,0:10:04.39,0:10:08.76,Default,,0000,0000,0000,,Әлгі бейбақ! Бұл не? Мен саған көмектестім!
Dialogue: 0,0:10:08.76,0:10:10.76,Default,,0000,0000,0000,,Бұл карта сәл ақымақтай көрінбей ме?
Dialogue: 0,0:10:13.31,0:10:15.83,Default,,0000,0000,0000,,Есептерге сәйкес, Эйзенвальд →
Dialogue: 0,0:10:15.83,0:10:19.03,Default,,0000,0000,0000,,Ол кезекті жиналысқа қатысып отырған гильдия шеберінің өмірін көздеп отыр.
Dialogue: 0,0:10:19.03,0:10:22.57,Default,,0000,0000,0000,,Енді оқиға орнына барыңыз және оларды сүртіңіз!
Dialogue: 0,0:10:22.57,0:10:24.25,Default,,0000,0000,0000,,Бұл қандай сиқыршы?
Dialogue: 0,0:10:24.25,0:10:28.12,Default,,0000,0000,0000,,Мен сізге Фиоре армиясының қаншалықты қорқынышты екенін көрсетемін!
Dialogue: 0,0:10:28.12,0:10:31.12,Default,,0000,0000,0000,,О!
Dialogue: 0,0:10:34.35,0:10:39.57,Default,,0000,0000,0000,,《Жарайды, осы қашықтықта бесік жырының дыбысы жеткілікті түрде жетеді.
Dialogue: 0,0:10:39.57,0:10:42.27,Default,,0000,0000,0000,,Ақырында... ақыры, осы жолы! 》
Dialogue: 0,0:10:42.27,0:10:45.30,Default,,0000,0000,0000,,Мухёхёхё!
Dialogue: 0,0:10:45.30,0:10:49.50,Default,,0000,0000,0000,,Мына бала да, анау да жынды.
Dialogue: 0,0:10:49.50,0:10:54.55,Default,,0000,0000,0000,,Ал, сиқыршылар қазіргі уақытта іштей де, сырттай да жоғары деңгейде.
Dialogue: 0,0:10:54.55,0:10:57.08,Default,,0000,0000,0000,,Гравюр ең жақсы... Ха!
Dialogue: 0,0:10:57.08,0:11:00.28,Default,,0000,0000,0000,,Олай емес... бұлай істеудің уақыты емес еді.
Dialogue: 0,0:11:00.28,0:11:03.14,Default,,0000,0000,0000,,Тезірек олардың қайда бара жатқанын біліңіз! ?
Dialogue: 0,0:11:03.14,0:11:05.16,Default,,0000,0000,0000,,Доккин! !
Dialogue: 0,0:11:05.16,0:11:08.02,Default,,0000,0000,0000,,Басқа болса, басқа! Бұл зерттеу →
Dialogue: 0,0:11:08.02,0:11:10.04,Default,,0000,0000,0000,,Бұл жерде ештеңе жоқ...
Dialogue: 0,0:11:10.04,0:11:12.89,Default,,0000,0000,0000,,Ешқандай сылтау айтудың қажеті жоқ...
Dialogue: 0,0:11:12.89,0:11:14.58,Default,,0000,0000,0000,,Иә? Не, ауырып тұрсың ба?
Dialogue: 0,0:11:14.58,0:11:17.28,Default,,0000,0000,0000,,Мынадай жерде не істеп жүрсің?
Dialogue: 0,0:11:17.28,0:11:19.97,Default,,0000,0000,0000,,Жоқ, бұл….
Dialogue: 0,0:11:19.97,0:11:24.01,Default,,0000,0000,0000,,《Тоқта... Мынау ертегідегі Макаров емес пе? ?
Dialogue: 0,0:11:24.01,0:11:26.87,Default,,0000,0000,0000,,Менің шыбындармен байланысым бар.
Dialogue: 0,0:11:26.87,0:11:29.40,Default,,0000,0000,0000,,Мм... Иә?
Dialogue: 0,0:11:29.40,0:11:32.59,Default,,0000,0000,0000,,Бір ән тыңдағың келе ме?
Dialogue: 0,0:11:32.59,0:11:35.30,Default,,0000,0000,0000,,Ауруханаларда музыкалық аспаптарға тыйым салынады.
Dialogue: 0,0:11:35.30,0:11:38.33,Default,,0000,0000,0000,,Иә? Мен оны біреудің тыңдағанын қалаймын.
Dialogue: 0,0:11:38.33,0:11:41.86,Default,,0000,0000,0000,,Бұл жиіркенішті ысқырық.
Dialogue: 0,0:11:41.86,0:11:44.55,Default,,0000,0000,0000,,Сырт келбетіне қарамастан, жағымды өңі бар.
Dialogue: 0,0:11:44.55,0:11:48.76,Default,,0000,0000,0000,,Хмм, асығыңыз.
Dialogue: 0,0:11:48.76,0:11:52.30,Default,,0000,0000,0000,,Бір ғана ән болса да, бәрібір. иә.
Dialogue: 0,0:11:52.30,0:11:54.99,Default,,0000,0000,0000,,《Біз жеңдік! 》
Dialogue: 0,0:11:54.99,0:11:58.99,Default,,0000,0000,0000,,Мұқият тыңдаңыз. Хмм.
Dialogue: 0,0:12:01.22,0:12:04.22,Default,,0000,0000,0000,,《Соңында...》
Dialogue: 0,0:12:07.45,0:12:10.15,Default,,0000,0000,0000,,((Чараи - жалғыз заңды гильдия.
Dialogue: 0,0:12:10.15,0:12:14.02,Default,,0000,0000,0000,,Қабілетім төмен болса да, көңілім көтерілмейді.
Dialogue: 0,0:12:14.02,0:12:17.55,Default,,0000,0000,0000,,Бұл бізді қараңғылыққа түсіреді→
Dialogue: 0,0:12:17.55,0:12:21.25,Default,,0000,0000,0000,,Бұл менің өмірімді тонап кеткен сиқырлы әлемнен алған кегім!
Dialogue: 0,0:12:21.25,0:12:25.25,Default,,0000,0000,0000,,Сіз мұны істесеңіз де, құқығыңызды қайтармайсыз!
Dialogue: 0,0:12:29.83,0:12:33.54,Default,,0000,0000,0000,,Бәрің де сәл алға қарай өмір сүріңдер.
Dialogue: 0,0:12:33.54,0:12:36.07,Default,,0000,0000,0000,,Кейдж, маған сенің көмегің керек!
Dialogue: 0,0:12:36.07,0:12:40.07,Default,,0000,0000,0000,,Біз бір гильдия мүшесі емеспіз бе? ))
Dialogue: 0,0:12:43.47,0:12:46.50,Default,,0000,0000,0000,,Міне болды! Ата!
Dialogue: 0,0:12:46.50,0:12:48.69,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,0:12:48.69,0:12:50.54,Default,,0000,0000,0000,,Бұл жақсы уақыт, сондықтан қараңыз.
Dialogue: 0,0:12:50.54,0:12:52.73,Default,,0000,0000,0000,,Балалар сендер сондай сүйкімдісіңдер.
Dialogue: 0,0:12:52.73,0:12:55.92,Default,,0000,0000,0000,,Супертип. (2 адам) Ех!
Dialogue: 0,0:12:55.92,0:12:58.79,Default,,0000,0000,0000,,Бұл адам кім? Мастер Боб.
Dialogue: 0,0:12:58.79,0:13:03.18,Default,,0000,0000,0000,,О, Эльза-чан, сен қатты өстің. Бұл адам сол Көк пегастың қожайыны! ?
Dialogue: 0,0:13:03.18,0:13:08.18,Default,,0000,0000,0000,,Хмм... не болды? Асықшы!
Dialogue: 0,0:13:12.76,0:13:14.61,Default,,0000,0000,0000,,Ой, жоқ!
Dialogue: 0,0:13:14.61,0:13:17.65,Default,,0000,0000,0000,,Ендеше, үндеме, бұл қызық.
Dialogue: 0,0:13:17.65,0:13:21.69,Default,,0000,0000,0000,,Quatro Cerberus…. Мастер Голдмин.
Dialogue: 0,0:13:21.69,0:13:23.69,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,0:15:12.63,0:15:15.00,Default,,0000,0000,0000,,《Тек үрле... тек үрле.
Dialogue: 0,0:15:15.00,0:15:18.00,Default,,0000,0000,0000,,Бұл бәрін өзгертеді! 》
Dialogue: 0,0:15:22.40,0:15:25.40,Default,,0000,0000,0000,,Ештеңе өзгермейді.
Dialogue: 0,0:15:27.61,0:15:31.65,Default,,0000,0000,0000,,Әлсіз адамдар мәңгі әлсіз болып қалады.
Dialogue: 0,0:15:31.65,0:15:34.18,Default,,0000,0000,0000,,Бірақ барлық әлсіздік жаман емес.
Dialogue: 0,0:15:34.18,0:15:38.22,Default,,0000,0000,0000,,Адамдар бастапқыда әлсіз жаратылыстар.
Dialogue: 0,0:15:38.22,0:15:44.22,Default,,0000,0000,0000,,Мен өзімді жалғыз қауіпсіз сезінбеймін, сондықтан менде гильдия бар. Менің достарым бар.
Dialogue: 0,0:15:46.47,0:15:50.84,Default,,0000,0000,0000,,Мықты өмір сүру үшін қатарласып жүрейік.
Dialogue: 0,0:15:50.84,0:15:54.04,Default,,0000,0000,0000,,Едепсіз адамдар басқа адамдарға қарағанда қабырғаларды көбірек соғады →
Dialogue: 0,0:15:54.04,0:15:56.56,Default,,0000,0000,0000,,Ол айналма жолмен жүруі мүмкін.
Dialogue: 0,0:15:56.56,0:16:03.47,Default,,0000,0000,0000,,Алайда ертеңгі күнге сеніп алға қадам бассаңыз, табиғи күш-қуат пайда болады.
Dialogue: 0,0:16:03.47,0:16:08.36,Default,,0000,0000,0000,,Күшті өмір сүруге тырысыңыз және күліңіз.
Dialogue: 0,0:16:08.36,0:16:12.56,Default,,0000,0000,0000,,Мұндай сыбызғыға сенудің қажеті жоқ.
Dialogue: 0,0:16:12.56,0:16:22.00,Default,,0000,0000,0000,,♪♪~
Dialogue: 0,0:16:22.00,0:16:24.51,Default,,0000,0000,0000,,Міне, келдік.
Dialogue: 0,0:16:24.51,0:16:27.05,Default,,0000,0000,0000,,Ұстаз! Ата! Қарт адам!
Dialogue: 0,0:16:27.05,0:16:30.24,Default,,0000,0000,0000,,Нуо~! Неге мұндасың? ?
Dialogue: 0,0:16:30.24,0:16:35.45,Default,,0000,0000,0000,,Күтілгендей! Жаңа ғана айтқан сөздерім: Менің көзім ыстық.
Dialogue: 0,0:16:35.45,0:16:37.31,Default,,0000,0000,0000,,Қатты!
Dialogue: 0,0:16:37.31,0:16:39.16,Default,,0000,0000,0000,,Мәселе шешілді.
Dialogue: 0,0:16:39.16,0:16:42.16,Default,,0000,0000,0000,,Ата, бұл керемет. Маған берші.
Dialogue: 0,0:16:44.71,0:16:47.91,Default,,0000,0000,0000,,Мухахахахха! Барлығы және осы жігіт →
Dialogue: 0,0:16:47.91,0:16:50.11,Default,,0000,0000,0000,,Ей, арсыз сиқыршылар!
Dialogue: 0,0:16:50.11,0:16:52.11,Default,,0000,0000,0000,,Бірдеңе болды!
Dialogue: 0,0:16:54.32,0:16:57.51,Default,,0000,0000,0000,,Не... Не?!
Dialogue: 0,0:16:57.51,0:17:00.88,Default,,0000,0000,0000,,Мен енді шыдай алмаймын!
Dialogue: 0,0:17:00.88,0:17:05.88,Default,,0000,0000,0000,,Мен өзімді өлтіремін!
Dialogue: 0,0:17:13.33,0:17:17.21,Default,,0000,0000,0000,,Кисама және басқалардың жандары!
Dialogue: 0,0:17:17.21,0:17:20.40,Default,,0000,0000,0000,,Тым үлкен! (Бақытты) Сол жерде тұр! ?
Dialogue: 0,0:17:20.40,0:17:23.77,Default,,0000,0000,0000,,Мынау кім? Мен бұл туралы білмеймін!
Dialogue: 0,0:17:23.77,0:17:27.98,Default,,0000,0000,0000,,О, бұл қиын. Бұл жігіт Зереф кітабындағы шайтан.
Dialogue: 0,0:17:27.98,0:17:29.66,Default,,0000,0000,0000,,Бұл өте жаман. Маған көмектескіңіз келе ме?
Dialogue: 0,0:17:29.66,0:17:31.66,Default,,0000,0000,0000,,Тек артқа отырыңыз және өтіңіз.
Dialogue: 0,0:17:41.28,0:17:43.80,Default,,0000,0000,0000,,Неліктен сыбызғыдан құбыжық шығады?
Dialogue: 0,0:17:43.80,0:17:46.33,Default,,0000,0000,0000,,Бұл құбыжық шын мәнінде бесік жыры.
Dialogue: 0,0:17:46.33,0:17:48.85,Default,,0000,0000,0000,,Басқаша айтқанда, тірі сиқыр...
Dialogue: 0,0:17:48.85,0:17:50.21,Default,,0000,0000,0000,,Бұл Зерефтің сиқыры.
Dialogue: 0,0:17:50.21,0:17:54.92,Default,,0000,0000,0000,,Тірі сиқыр? Зереф бұрыннан келе жатыр ма?
Dialogue: 0,0:17:54.92,0:17:58.28,Default,,0000,0000,0000,,Қара сиқыршы Зереф. Сиқыршылар әлемінің тарихында →
Dialogue: 0,0:17:58.28,0:18:02.32,Default,,0000,0000,0000,,Ең жауыз сиқыршы. Жүздеген жылдар бұрынғы теріс мұра →
Dialogue: 0,0:18:02.32,0:18:05.69,Default,,0000,0000,0000,,Оның қазір пайда болғанына сене алмаймын...
Dialogue: 0,0:18:05.69,0:18:10.57,Default,,0000,0000,0000,,Енді оны кімнің рухынан аламын?
Dialogue: 0,0:18:10.57,0:18:12.93,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:18:12.93,0:18:14.61,Default,,0000,0000,0000,,Әй, жан бақытты ма?
Dialogue: 0,0:18:14.61,0:18:18.65,Default,,0000,0000,0000,,Сіз білесіз бе! Менен сұрама! Өйткені, ол жерде қиын!
Dialogue: 0,0:18:18.65,0:18:20.01,Default,,0000,0000,0000,,Нацу Грей! Барлығын алыс ұстаңыз!
Dialogue: 0,0:18:20.01,0:18:23.87,Default,,0000,0000,0000,,Бастық болыңыз! Бұйрық бермеңіз!
Dialogue: 0,0:18:23.87,0:18:25.23,Default,,0000,0000,0000,,Мен оны сұрадым!
Dialogue: 0,0:18:25.23,0:18:27.91,Default,,0000,0000,0000,,Шығады... №2 бақытты.
Dialogue: 0,0:18:27.91,0:18:30.27,Default,,0000,0000,0000,,Мынау алып уд ағашы тіпті осар емес!
Dialogue: 0,0:18:30.27,0:18:33.80,Default,,0000,0000,0000,,Тез кіріңіз!
Dialogue: 0,0:18:33.80,0:18:37.80,Default,,0000,0000,0000,,Жігіттер, бұл жерден кетіңдер!
Dialogue: 0,0:18:45.42,0:18:49.63,Default,,0000,0000,0000,,Капитан! Таулар жоғалып барады! не! ? Та... Шегін!
Dialogue: 0,0:18:49.63,0:18:52.83,Default,,0000,0000,0000,,Мен шештім!
Dialogue: 0,0:18:52.83,0:18:57.21,Default,,0000,0000,0000,,Кисама және басқа барлық сиқыршылар өз жандарын алады!
Dialogue: 0,0:18:57.21,0:19:00.90,Default,,0000,0000,0000,,Қандай қызық! Қолыңнан келсе, жаса!
Dialogue: 0,0:19:00.90,0:19:03.27,Default,,0000,0000,0000,,Сіз үшеуіңізбен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:19:03.27,0:19:07.81,Default,,0000,0000,0000,,Люси ше? Бүгінгі күні пайдалануға жарамды аспан рухтары жоқ →
Dialogue: 0,0:19:07.81,0:19:09.66,Default,,0000,0000,0000,,Бұл барлығын ұстап қалуы мүмкін.
Dialogue: 0,0:19:09.66,0:19:12.69,Default,,0000,0000,0000,,Бұл ақталу. Шулы мысық!
Dialogue: 0,0:19:12.69,0:19:17.25,Default,,0000,0000,0000,,Гуо... Гуо~!
Dialogue: 0,0:19:17.25,0:19:20.44,Default,,0000,0000,0000,,О, бұл қорқынышты дауыс. Бұл не ыңғайсыздық?
Dialogue: 0,0:19:20.44,0:19:22.63,Default,,0000,0000,0000,,Бұл басталды ма? Жоқ!
Dialogue: 0,0:19:22.63,0:19:26.17,Default,,0000,0000,0000,,Бесік жыры! Менің жанымды алып кетті!
Dialogue: 0,0:19:26.17,0:19:29.17,Default,,0000,0000,0000,,Кеттік! (Грей/Нацу) О!
Dialogue: 0,0:19:33.91,0:19:36.10,Default,,0000,0000,0000,,Ауыстыру!
Dialogue: 0,0:19:36.10,0:19:48.71,Default,,0000,0000,0000,,♪♪~
Dialogue: 0,0:19:48.71,0:19:50.40,Default,,0000,0000,0000,,Түн!
Dialogue: 0,0:19:50.40,0:19:52.40,Default,,0000,0000,0000,,Гуо~!
Dialogue: 0,0:19:59.16,0:20:03.16,Default,,0000,0000,0000,,Мұзды макияж... Лэнс!
Dialogue: 0,0:20:05.72,0:20:09.76,Default,,0000,0000,0000,,Осымен өмір сүр!
Dialogue: 0,0:20:09.76,0:20:12.76,Default,,0000,0000,0000,,От айдаһарының темір жұдырығы!
Dialogue: 0,0:20:14.48,0:20:18.52,Default,,0000,0000,0000,,Не?!
Dialogue: 0,0:20:18.52,0:20:20.04,Default,,0000,0000,0000,,Мен сені жалынмен ұрдым!
Dialogue: 0,0:20:20.04,0:20:24.91,Default,,0000,0000,0000,,Бұл мұз сиқыршысы ма? Бұл сауыттың өзгеруі!
Dialogue: 0,0:20:24.91,0:20:27.91,Default,,0000,0000,0000,,Бұл жиіркенішті, балалар!
Dialogue: 0,0:20:32.16,0:20:36.19,Default,,0000,0000,0000,,Маған тағы бір соққы беріңіз!
Dialogue: 0,0:20:36.19,0:20:40.24,Default,,0000,0000,0000,,От айдаһарының қанаты соққысы!
Dialogue: 0,0:20:40.24,0:20:42.76,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:20:42.76,0:20:46.80,Default,,0000,0000,0000,,Бұл таңқаларлық. Мен мұндай үйлестірілген шабуылды ешқашан көрген емеспін!
Dialogue: 0,0:20:46.80,0:20:48.49,Default,,0000,0000,0000,,Керемет! махаббат!
Dialogue: 0,0:20:48.49,0:20:52.36,Default,,0000,0000,0000,,Гуо~!
Dialogue: 0,0:20:52.36,0:20:54.36,Default,,0000,0000,0000,,Бұл қауіпті! Бесік жыры келе жатыр!
Dialogue: 0,0:20:59.59,0:21:01.11,Default,,0000,0000,0000,,Жасыл желек өліп барады.
Dialogue: 0,0:21:01.11,0:21:03.80,Default,,0000,0000,0000,,Мені бесік жыры сорып жатыр!
Dialogue: 0,0:21:03.80,0:21:06.80,Default,,0000,0000,0000,,Мен Кисаманың жанын аламын!
Dialogue: 0,0:21:13.24,0:21:15.92,Default,,0000,0000,0000,,Бұл не! ? Skyship!
Dialogue: 0,0:21:15.92,0:21:17.28,Default,,0000,0000,0000,,Не! ? Бұл дыбыс!
Dialogue: 0,0:21:17.28,0:21:20.98,Default,,0000,0000,0000,,Менің мақтаныш үнім қайда? ?
Dialogue: 0,0:21:20.98,0:21:22.16,Default,,0000,0000,0000,,Дұрыс, бұрынғы шабуыл...
Dialogue: 0,0:21:22.16,0:21:25.36,Default,,0000,0000,0000,,Дыбыс дұрыс шықпайды, себебі сіз көп саңылауларды бұрғылағансыз.
Dialogue: 0,0:21:25.36,0:21:29.39,Default,,0000,0000,0000,,Тартыңыз, тартыңыз, бұл соққы сызығы! ?
Dialogue: 0,0:21:29.39,0:21:31.58,Default,,0000,0000,0000,,Эй, қарным ашты.
Dialogue: 0,0:21:31.58,0:21:34.78,Default,,0000,0000,0000,,Мұны істеме!
Dialogue: 0,0:21:34.78,0:21:37.78,Default,,0000,0000,0000,,Мен жынды болдым! Ол соншалықты үлкен, ол жаман!
Dialogue: 0,0:21:39.00,0:21:41.00,Default,,0000,0000,0000,,Мұздан жасалған макияж.
Dialogue: 0,0:21:45.89,0:21:47.24,Default,,0000,0000,0000,,Қалқан!
Dialogue: 0,0:21:47.24,0:21:49.93,Default,,0000,0000,0000,,Иә, аға, сен кереметсің.
Dialogue: 0,0:21:49.93,0:21:51.28,Default,,0000,0000,0000,,Бір сәтте модельдеу сиқыры соншалықты көп!
Dialogue: 0,0:21:51.28,0:21:56.66,Default,,0000,0000,0000,,Сиқырды қалыптастыру? Бұл сиқырлы күшке пішін беретін сиқыр.
Dialogue: 0,0:21:56.66,0:22:00.04,Default,,0000,0000,0000,,Бұл да пішінді алып тастайтын сиқыр.
Dialogue: 0,0:22:00.04,0:22:03.04,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:22:08.12,0:22:12.15,Default,,0000,0000,0000,,Ой! Мен оны жеген кезде өзімді күшті сезіндім!
Dialogue: 0,0:22:12.15,0:22:15.02,Default,,0000,0000,0000,,Міне! Бейкемон немесе Кисама!
Dialogue: 0,0:22:15.02,0:22:17.21,Default,,0000,0000,0000,,Қандай коллаж!
Dialogue: 0,0:22:17.21,0:22:21.25,Default,,0000,0000,0000,,Бұл өрмелеп жатыр! Ауыстыру!
Dialogue: 0,0:22:21.25,0:22:24.61,Default,,0000,0000,0000,,О! Қара қауырсын сауыт!
Dialogue: 0,0:22:24.61,0:22:27.64,Default,,0000,0000,0000,,Бұл бір соққының жойқын күшін арттыратын сиқырлы сауыт.
Dialogue: 0,0:22:27.64,0:22:31.51,Default,,0000,0000,0000,,Мұздан жасалған табақша!
Dialogue: 0,0:22:31.51,0:22:35.55,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:35.55,0:22:37.57,Default,,0000,0000,0000,,Нацу! Қазір!
Dialogue: 0,0:22:37.57,0:22:39.43,Default,,0000,0000,0000,,Уша!
Dialogue: 0,0:22:39.43,0:22:43.13,Default,,0000,0000,0000,,Оң қолдағы жалын, сол қолдағы жалын!
Dialogue: 0,0:22:43.13,0:22:46.83,Default,,0000,0000,0000,,Екі жалынды біріктіріңіз!
Dialogue: 0,0:22:46.83,0:22:51.38,Default,,0000,0000,0000,,Уау! Мұны да алыңыз!
Dialogue: 0,0:22:51.38,0:22:54.38,Default,,0000,0000,0000,,От айдаһарының жарқыраған жалыны!
Dialogue: 0,0:22:58.95,0:23:01.95,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:23:18.82,0:23:21.68,Default,,0000,0000,0000,,Керемет! Керемет!
Dialogue: 0,0:23:21.68,0:23:23.20,Default,,0000,0000,0000,,Зерефтің жындары сондай оңай.
Dialogue: 0,0:23:23.20,0:23:27.07,Default,,0000,0000,0000,,Уау! Керемет!
Dialogue: 0,0:23:27.07,0:23:33.63,Default,,0000,0000,0000,,Мынау... бұл ертегі сиқыршысы!
Dialogue: 0,0:23:33.63,0:23:35.49,Default,,0000,0000,0000,,Күтілгендей, ең мықты команда! Өте керемет!
Dialogue: 0,0:23:35.49,0:23:39.52,Default,,0000,0000,0000,,Ай! Ал ше! Бұл керемет!
Dialogue: 0,0:23:39.52,0:23:42.72,Default,,0000,0000,0000,,Жарайсыңдар бәріңе! Бұл үлкен мәселе емес еді.
Dialogue: 0,0:23:42.72,0:23:46.43,Default,,0000,0000,0000,,Бұл кішкентай ғана нәрсе. Хаха... Ақымақ екен ғой.
Dialogue: 0,0:23:46.43,0:23:49.46,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:23:49.46,0:23:53.46,Default,,0000,0000,0000,,Қараңызшы, дәрігерге бару керек.
Dialogue: 0,0:23:55.52,0:23:57.38,Default,,0000,0000,0000,,Мен мән-жайды түсінбеймін, бірақ→
Dialogue: 0,0:23:57.38,0:24:00.41,Default,,0000,0000,0000,,Мен Ертегіге қарызмын.
Dialogue: 0,0:24:00.41,0:24:05.78,Default,,0000,0000,0000,,Бірақ бұл... Ах!
Dialogue: 0,0:24:05.78,0:24:08.65,Default,,0000,0000,0000,,Бұл тым көп!
Dialogue: 0,0:24:08.65,0:24:10.00,Default,,0000,0000,0000,,Кезекті жиналыс өтетін орынды былай қойғанда...
Dialogue: 0,0:24:10.00,0:24:13.20,Default,,0000,0000,0000,,Ай! Бір-екі тау жоғалып кетті.
Dialogue: 0,0:24:13.20,0:24:16.40,Default,,0000,0000,0000,,Ах! Ұстаз! Бірдеңе шықты!
Dialogue: 0,0:24:16.40,0:24:19.26,Default,,0000,0000,0000,,Хаха! Ол толығымен жойылды.
Dialogue: 0,0:24:19.26,0:24:22.46,Default,,0000,0000,0000,,Біреу оларды ұстап алсын!
Dialogue: 0,0:24:22.46,0:24:25.82,Default,,0000,0000,0000,,Әй, балалар ата-аналарына ұқсайды.
Dialogue: 0,0:24:25.82,0:24:27.51,Default,,0000,0000,0000,,Бұл менің белсенді күндерімді еске түсіреді.
Dialogue: 0,0:24:27.51,0:24:29.53,Default,,0000,0000,0000,,Бұл ақымақтық.
Dialogue: 0,0:24:29.53,0:24:31.55,Default,,0000,0000,0000,,Кэдже-чан жас кезімдегі маған ұқсайды!
Dialogue: 0,0:24:31.55,0:24:33.23,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:24:33.23,0:24:35.59,Default,,0000,0000,0000,,Ол кезде қызық болатын.
Dialogue: 0,0:24:35.59,0:24:40.14,Default,,0000,0000,0000,,Бәріміз әбігерге түсіп, кеңес мүшелері ұрысып қалдық.
Dialogue: 0,0:24:40.14,0:24:44.01,Default,,0000,0000,0000,,Әй, айтпақшы, мына сымбатты жігіт менмін.
Dialogue: 0,0:24:44.01,0:24:47.70,Default,,0000,0000,0000,,Сіз басқа адамсыз! эй? Кагечин Хризоцу Хризоцу!
Dialogue: 0,0:24:47.70,0:24:49.55,Default,,0000,0000,0000,,Олар бір-біріне ұқсамайды!
Dialogue: 0,0:24:49.55,0:24:52.59,Default,,0000,0000,0000,,Қалай болғанда да, сіз де солай сезінесіз, солай ма?
Dialogue: 0,0:24:52.59,0:24:54.28,Default,,0000,0000,0000,,Гильдия қызық.
Dialogue: 0,0:24:54.28,0:24:56.80,Default,,0000,0000,0000,,Бірдеңе болды. кінә.
Dialogue: 0,0:24:56.80,0:24:58.15,Default,,0000,0000,0000,,Жарайды, мен сені ұстаймын!
Dialogue: 0,0:24:58.15,0:25:00.34,Default,,0000,0000,0000,,Сіз қабылдаудың соңындасыз!
Dialogue: 0,0:25:00.34,0:25:04.34,Default,,0000,0000,0000,,Түсіндім! Ахахха!
Dialogue: 0,0:25:05.84,0:25:11.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory