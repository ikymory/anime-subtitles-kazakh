Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.15,0:00:11.50,Default,,0000,0000,0000,,<Фиор патшалығы.
Dialogue: 0,0:00:11.50,0:00:16.22,Default,,0000,0000,0000,,17 миллион халқы бар тұрақты бейтарап ел.
Dialogue: 0,0:00:16.22,0:00:19.25,Default,,0000,0000,0000,,Бұл сиқырлы әлем.
Dialogue: 0,0:00:19.25,0:00:25.65,Default,,0000,0000,0000,,Сиқыр әдетте сатып алынады және сатылды және адамдардың өмірінде терең тамыр жайды.
Dialogue: 0,0:00:25.65,0:00:30.19,Default,,0000,0000,0000,,Ал сол сиқырды толық пайдаланып күн көріп жатқандар бар.
Dialogue: 0,0:00:30.19,0:00:34.57,Default,,0000,0000,0000,,Адамдар оларды сиқыршылар деп атады.
Dialogue: 0,0:00:34.57,0:00:38.77,Default,,0000,0000,0000,,Сиқыршылар әртүрлі гильдияларға жатады→
Dialogue: 0,0:00:38.77,0:00:41.46,Default,,0000,0000,0000,,Сұраныс бойынша жұмысты орындау.
Dialogue: 0,0:00:41.46,0:00:44.50,Default,,0000,0000,0000,,Елде көптеген гильдиялар бар.
Dialogue: 0,0:00:44.50,0:00:49.55,Default,,0000,0000,0000,,Белгілі бір қалада сиқыршылар гильдиясы бар.
Dialogue: 0,0:00:49.55,0:00:56.79,Default,,0000,0000,0000,,Өткенде немесе тіпті болашақта көптеген аңыздарды жасаған гильдия.
Dialogue: 0,0:00:56.79,0:01:01.79,Default,,0000,0000,0000,,Аты...Ертегі>
Dialogue: 0,0:03:43.95,0:03:45.81,Default,,0000,0000,0000,,<Нацу: соңғы ретке дейін «ЕРтегі»>
Dialogue: 0,0:03:45.81,0:03:48.84,Default,,0000,0000,0000,,Сыйақы – 2 миллион зергерлік бұйымдар.
Dialogue: 0,0:03:48.84,0:03:50.53,Default,,0000,0000,0000,,Зиянкес анықталды!
Dialogue: 0,0:03:50.53,0:03:53.22,Default,,0000,0000,0000,,Шулы! (Бағалау) Бойоён!
Dialogue: 0,0:03:53.22,0:03:55.07,Default,,0000,0000,0000,,Кітап Ватари-санның авторы!
Dialogue: 0,0:03:55.07,0:03:57.09,Default,,0000,0000,0000,,«КҮНДІК ҮЗІЛІКТІҢ» осындай сыры бар еді!
Dialogue: 0,0:03:57.09,0:03:59.95,Default,,0000,0000,0000,,Мен оны жесем, күш алдым!
Dialogue: 0,0:03:59.95,0:04:01.95,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:04:06.69,0:04:10.55,Default,,0000,0000,0000,,Не? Бұл сиқыршы.
Dialogue: 0,0:04:10.55,0:04:13.25,Default,,0000,0000,0000,,Анашым мен ертегіні көріп тұрмын.
Dialogue: 0,0:04:13.25,0:04:17.12,Default,,0000,0000,0000,,Ал, енді Люсиді тауып алайық.
Dialogue: 0,0:04:17.12,0:04:19.14,Default,,0000,0000,0000,,Бұл не болды? Бұл жігіттер.
Dialogue: 0,0:04:19.14,0:04:21.67,Default,,0000,0000,0000,,Жалдамалы.
Dialogue: 0,0:04:21.67,0:04:23.52,Default,,0000,0000,0000,,Әдебиеттің жауы! ?
Dialogue: 0,0:04:23.52,0:04:27.90,Default,,0000,0000,0000,,Мен сияқты ұлы, білімді адамдарға.
Dialogue: 0,0:04:27.90,0:04:31.43,Default,,0000,0000,0000,,Жанында бейтаныс күң болғанына қуанатындай көрінетін жігіт білімді екен.
Dialogue: 0,0:04:31.43,0:04:34.47,Default,,0000,0000,0000,,Менің әдемі аққұба қызымды мазақ етпе!
Dialogue: 0,0:04:34.47,0:04:37.49,Default,,0000,0000,0000,,Уау! Бұл қазына картасы ма?
Dialogue: 0,0:04:37.49,0:04:41.20,Default,,0000,0000,0000,,Қазынаны жасыратын орын? Бұл кітапта қандай құпия бар?
Dialogue: 0,0:04:41.20,0:04:44.23,Default,,0000,0000,0000,,Айтпасаң қолың сынады.
Dialogue: 0,0:04:44.23,0:04:47.43,Default,,0000,0000,0000,,Ой... ара!
Dialogue: 0,0:04:47.43,0:04:49.45,Default,,0000,0000,0000,,Бойо!
Dialogue: 0,0:04:49.45,0:04:52.48,Default,,0000,0000,0000,,Алып кетпе, қызым!
Dialogue: 0,0:04:52.48,0:04:56.01,Default,,0000,0000,0000,,Бұл кітап маған тиесілі және оны Кем Залеон жазған.
Dialogue: 0,0:04:56.01,0:04:59.01,Default,,0000,0000,0000,,Кітаптың сыры да маған тиесілі!
Dialogue: 0,0:05:02.07,0:05:04.26,Default,,0000,0000,0000,,Бақытты!
Dialogue: 0,0:05:04.26,0:05:07.12,Default,,0000,0000,0000,,Керемет! керемет!
Dialogue: 0,0:05:07.12,0:05:10.15,Default,,0000,0000,0000,,Бұл мысық кім?
Dialogue: 0,0:05:10.15,0:05:14.03,Default,,0000,0000,0000,,Менің айтайын дегенім, сен, көтеріл.
Dialogue: 0,0:05:14.03,0:05:16.03,Default,,0000,0000,0000,,Өйткені бұл ағынды сулар.
Dialogue: 0,0:05:22.45,0:05:24.13,Default,,0000,0000,0000,,Кестелер өзгерді.
Dialogue: 0,0:05:24.13,0:05:27.66,Default,,0000,0000,0000,,Осы кітапты маған берсең, мен сені кешіремін.
Dialogue: 0,0:05:27.66,0:05:29.68,Default,,0000,0000,0000,,Мен оны тым болмаса бір рет жұдырықтай салғым келеді.
Dialogue: 0,0:05:29.68,0:05:31.70,Default,,0000,0000,0000,,Бойоё аспан рухының сиқыры?
Dialogue: 0,0:05:31.70,0:05:35.24,Default,,0000,0000,0000,,Алайда ол әдебиетші қыз болса да, сөздерді дұрыс қолданбайды.
Dialogue: 0,0:05:35.24,0:05:39.94,Default,,0000,0000,0000,,Жағдайдың кері айналуы – күштердің артықшылығы мен кемшілігін өзгерту.
Dialogue: 0,0:05:39.94,0:05:41.96,Default,,0000,0000,0000,,Тағы бір мысық →
Dialogue: 0,0:05:41.96,0:05:43.49,Default,,0000,0000,0000,,Менің сиқырлы сүңгуірім сынбайды.
Dialogue: 0,0:05:43.49,0:05:46.68,Default,,0000,0000,0000,,Бойоёё~.
Dialogue: 0,0:05:46.68,0:05:49.21,Default,,0000,0000,0000,,Бұл сиқыр болды ма?
Dialogue: 0,0:05:49.21,0:05:52.58,Default,,0000,0000,0000,,Сонымен, Эвалу да сиқыршы ма? Айтайын дегенім, сен, ол сасып тұр.
Dialogue: 0,0:05:52.58,0:05:56.45,Default,,0000,0000,0000,,Бойо! Бойоё! Бойо!
Dialogue: 0,0:05:56.45,0:05:59.97,Default,,0000,0000,0000,,Бұл кітапта жазылған.
Dialogue: 0,0:05:59.97,0:06:02.68,Default,,0000,0000,0000,,Бұл басты кейіпкер Эверу болған қорқынышты шытырман оқиғалы роман болды.
Dialogue: 0,0:06:02.68,0:06:05.37,Default,,0000,0000,0000,,Бұл не? Мен басты кейіпкермін →
Dialogue: 0,0:06:05.37,0:06:09.24,Default,,0000,0000,0000,,Керемет! Бірақ мазмұны сұмдық.
Dialogue: 0,0:06:09.24,0:06:12.95,Default,,0000,0000,0000,,Сіз Кем Залеон болсаңыз да, сіз бұл сұмдықты жаздыңыз.
Dialogue: 0,0:06:12.95,0:06:14.95,Default,,0000,0000,0000,,Ах! Бұл шектен шыққан!
Dialogue: 0,0:06:19.18,0:06:22.20,Default,,0000,0000,0000,,Мені бірдеңе жазуға мәжбүрлейтін қандай тәкаппарсың!
Dialogue: 0,0:06:22.20,0:06:24.73,Default,,0000,0000,0000,,Сіз бастықсыз ба? Менің халқым ұлы.
Dialogue: 0,0:06:24.73,0:06:27.75,Default,,0000,0000,0000,,Мен әріптесім туралы кітап жаза аламын →
Dialogue: 0,0:06:27.75,0:06:29.94,Default,,0000,0000,0000,,Бұл үлкен құрмет.
Dialogue: 0,0:06:29.94,0:06:31.13,Default,,0000,0000,0000,,Мен сені жазып жібергенім жоқ!
Dialogue: 0,0:06:31.13,0:06:34.33,Default,,0000,0000,0000,,Қауіп? Бұл не?
Dialogue: 0,0:06:34.33,0:06:37.02,Default,,0000,0000,0000,,Жазбау одан да жаман екені сөзсіз.
Dialogue: 0,0:06:37.02,0:06:39.71,Default,,0000,0000,0000,,Бұл не? ?
Dialogue: 0,0:06:39.71,0:06:42.91,Default,,0000,0000,0000,,Мен саған осы жігітті бас кейіпкер етіп кітап жазуға рұқсат етемін дедім.→
Dialogue: 0,0:06:42.91,0:06:44.43,Default,,0000,0000,0000,,Сол ақымақ маған қарсы шықты.
Dialogue: 0,0:06:44.43,0:06:47.12,Default,,0000,0000,0000,,Сондықтан мен саған айттым.
Dialogue: 0,0:06:47.12,0:06:51.16,Default,,0000,0000,0000,,Жазбасаң барлық туыстарыңды азаматтықтан айырамын.
Dialogue: 0,0:06:51.16,0:06:53.85,Default,,0000,0000,0000,,Иә! ? Егер бұл орын алса →
Dialogue: 0,0:06:53.85,0:06:56.21,Default,,0000,0000,0000,,Сіз саудагерлер гильдиясы немесе қолөнершілер гильдиясына қосыла алмайсыз.
Dialogue: 0,0:06:56.21,0:06:58.23,Default,,0000,0000,0000,,Бұл жігіт өте керемет! ?
Dialogue: 0,0:06:58.23,0:07:01.93,Default,,0000,0000,0000,,Сондықтан сіз оны керемет деп айтасыз.
Dialogue: 0,0:07:01.93,0:07:05.13,Default,,0000,0000,0000,,Өйткені, ол жазған.
Dialogue: 0,0:07:05.13,0:07:08.84,Default,,0000,0000,0000,,Алайда мен ренжігендіктен бір рет бас тарттым→
Dialogue: 0,0:07:08.84,0:07:12.21,Default,,0000,0000,0000,,Мен оны камерасына жазуға мәжбүр еттім. Бойоёо.
Dialogue: 0,0:07:12.21,0:07:14.07,Default,,0000,0000,0000,,Ей, сен жазушысың. Сізді тамаша жазушы деп мақтанышпен айтамын.→
Dialogue: 0,0:07:14.07,0:07:17.07,Default,,0000,0000,0000,,Мен оның өзін-өзі бағалауын таптадым.
Dialogue: 0,0:07:20.62,0:07:23.15,Default,,0000,0000,0000,,Өз қалауларың үшін мұндай әрекетке қалай бардыңдар!
Dialogue: 0,0:07:23.15,0:07:27.36,Default,,0000,0000,0000,,Оқшауланған үш жыл ішінде оның не ойлағанын білесіз бе?
Dialogue: 0,0:07:27.36,0:07:31.56,Default,,0000,0000,0000,,Үш жыл?
Dialogue: 0,0:07:31.56,0:07:34.26,Default,,0000,0000,0000,,Жерлесімнің ұлылығын түсіндім. Бойоёёо.
Dialogue: 0,0:07:34.26,0:07:37.79,Default,,0000,0000,0000,,Жоқ. Бұл менің мақтанышыммен шайқас болды.
Dialogue: 0,0:07:37.79,0:07:40.82,Default,,0000,0000,0000,,Жазбасаң, отбасыңа қауіп төнеді.
Dialogue: 0,0:07:40.82,0:07:43.18,Default,,0000,0000,0000,,Бірақ сіз сияқты адам басты кейіпкер болған кітаптар жоқ →
Dialogue: 0,0:07:43.18,0:07:46.54,Default,,0000,0000,0000,,Жазушы ретіндегі мақтанышым оған жол бермейді.
Dialogue: 0,0:07:46.54,0:07:49.57,Default,,0000,0000,0000,,Кисама сен неге сонша көп білесің?
Dialogue: 0,0:07:49.57,0:07:52.44,Default,,0000,0000,0000,,Мұның бәрі осы кітапта жазылған.
Dialogue: 0,0:07:52.44,0:07:55.63,Default,,0000,0000,0000,,Иә? Сосын досым да оқыды.
Dialogue: 0,0:07:55.63,0:07:58.83,Default,,0000,0000,0000,,Кем Залеон пайда болмайды. Әрине, егер сіз оны әдеттегідей оқысаңыз →
Dialogue: 0,0:07:58.83,0:08:02.87,Default,,0000,0000,0000,,Бұл жанкүйерлердің көңілін қалдыратын сұмдық. Бірақ сіз мұны білесіз, солай ма?
Dialogue: 0,0:08:02.87,0:08:05.90,Default,,0000,0000,0000,,Кем Зареон бастапқыда сиқыршы болған.
Dialogue: 0,0:08:05.90,0:08:08.77,Default,,0000,0000,0000,,Не? (Бағалау) Мүмкін емес...
Dialogue: 0,0:08:08.77,0:08:13.65,Default,,0000,0000,0000,,Ол өзінің соңғы күшін осы кітапқа сиқырлау үшін жұмсады.
Dialogue: 0,0:08:13.65,0:08:16.35,Default,,0000,0000,0000,,Егер сіз сиқырды бұзсаңыз, маған деген кекіңізді сипаттайтын сөйлемді табасыз →
Dialogue: 0,0:08:16.35,0:08:21.07,Default,,0000,0000,0000,,Бұл пайда болу механизмі болды ма? Бұл шектен шыққан!
Dialogue: 0,0:08:21.07,0:08:24.92,Default,,0000,0000,0000,,Сіздің идеяларыңыз нашар.
Dialogue: 0,0:08:24.92,0:08:27.96,Default,,0000,0000,0000,,Бұл кітаптың қалай аяқталғаны туралы әңгіме жазылғаны рас.
Dialogue: 0,0:08:27.96,0:08:32.00,Default,,0000,0000,0000,,Бірақ бұл Кем Залеон қалдырғысы келген сөздер емес.
Dialogue: 0,0:08:32.00,0:08:35.37,Default,,0000,0000,0000,,Нағыз құпия басқа жерде!
Dialogue: 0,0:08:35.37,0:08:38.73,Default,,0000,0000,0000,,Не? Нағыз құпия?
Dialogue: 0,0:08:38.73,0:08:41.09,Default,,0000,0000,0000,,Сондықтан мен бұл кітапты саған бермеймін.
Dialogue: 0,0:08:41.09,0:08:43.09,Default,,0000,0000,0000,,Айтайын дегенім, сізде оған ие болу үшін біліктілік жоқ.
Dialogue: 0,0:08:46.31,0:08:52.31,Default,,0000,0000,0000,,Алып шаян сарайының есігін ашыңыз! Қатерлі ісік.
Dialogue: 0,0:09:04.16,0:09:06.68,Default,,0000,0000,0000,,Қатерлі ісік.
Dialogue: 0,0:09:06.68,0:09:09.87,Default,,0000,0000,0000,,Краб китер!
Dialogue: 0,0:09:09.87,0:09:12.74,Default,,0000,0000,0000,,Сөз соңына шаянды толығымен қосыңыз. Оған күмән жоқ. Бұл краб.
Dialogue: 0,0:09:12.74,0:09:15.77,Default,,0000,0000,0000,,О, мен білемін. Бұл уәде деп аталады.
Dialogue: 0,0:09:15.77,0:09:18.97,Default,,0000,0000,0000,,Мен шоғырланғым келеді. Үндемесең, табаныңды шымшып аламын.
Dialogue: 0,0:09:18.97,0:09:25.70,Default,,0000,0000,0000,,Люси, бүгін қандай шаш үлгісін жасамақшысың... асшаян?
Dialogue: 0,0:09:25.70,0:09:27.89,Default,,0000,0000,0000,,Асшаян? Сіз атмосфераны оқи аласыз ба деп ойлаймын.
Dialogue: 0,0:09:27.89,0:09:31.43,Default,,0000,0000,0000,,Шайқас. Мына сақалды қартты ұр.
Dialogue: 0,0:09:31.43,0:09:34.46,Default,,0000,0000,0000,,Жарайды асшаяндар. Мен бұл тура деп ойладым →
Dialogue: 0,0:09:34.46,0:09:38.17,Default,,0000,0000,0000,,Сіз ілгекке түскен сияқтысыз. Иә, қазір үйге баруға рұқсат ете аласыз.
Dialogue: 0,0:09:38.17,0:09:40.86,Default,,0000,0000,0000,,Үйге барсаң ше?
Dialogue: 0,0:09:40.86,0:09:42.04,Default,,0000,0000,0000,,《Бұл шын құпия ма?
Dialogue: 0,0:09:42.04,0:09:46.08,Default,,0000,0000,0000,,Мен көптеген кәсіптерімнің шымылдығын жаздым ба?
Dialogue: 0,0:09:46.08,0:09:50.12,Default,,0000,0000,0000,,Бұл жаман. Кеңестегі тексеруші сиқыршыға берсеңіз →
Dialogue: 0,0:09:50.12,0:09:53.12,Default,,0000,0000,0000,,Бұл менің соңым емес пе?
Dialogue: 0,0:09:55.17,0:10:00.17,Default,,0000,0000,0000,,Тың ғибадатханасының есігін ашыңыз. Барго.
Dialogue: 0,0:10:02.07,0:10:05.77,Default,,0000,0000,0000,,Не? Люси сияқты сиқыр.
Dialogue: 0,0:10:05.77,0:10:08.14,Default,,0000,0000,0000,,Сіз мені шақырып жатырсыз ба, сэр?
Dialogue: 0,0:10:08.14,0:10:13.18,Default,,0000,0000,0000,,Балго Бұл кітапты алыңыз. Өтірік? Бұл аспан рухы ма?
Dialogue: 0,0:10:13.18,0:10:16.88,Default,,0000,0000,0000,,Асшаяндар.
Dialogue: 0,0:10:16.88,0:10:19.74,Default,,0000,0000,0000,,Не! ? (Люси/Бақытты) Нацу! о?
Dialogue: 0,0:10:19.74,0:10:22.77,Default,,0000,0000,0000,,Неліктен Кисама Баргомен бірге? Сіз, қалай?
Dialogue: 0,0:10:22.77,0:10:26.31,Default,,0000,0000,0000,,Не? Бұл жігіт қозғала бастады, мен оның соңынан ердім де, кенет...
Dialogue: 0,0:10:26.31,0:10:28.33,Default,,0000,0000,0000,,Мен түсінбеймін!
Dialogue: 0,0:10:28.33,0:10:31.86,Default,,0000,0000,0000,,Оны кию керек, дәлірек айтсақ, ұстап алу керек емес пе?
Dialogue: 0,0:10:31.86,0:10:35.74,Default,,0000,0000,0000,,Сіз адамдар астральды рухтар әлемінен өтті деп айтасыз ба?
Dialogue: 0,0:10:35.74,0:10:38.43,Default,,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,0:10:38.43,0:10:42.31,Default,,0000,0000,0000,,Люси, мен не істеуім керек? Әй, ол жігітті кетір!
Dialogue: 0,0:10:42.31,0:10:46.17,Default,,0000,0000,0000,,Бикеш Кеспелерді сүртіңіз.
Dialogue: 0,0:10:46.17,0:10:49.88,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:10:49.88,0:10:52.88,Default,,0000,0000,0000,,Үрлеу.
Dialogue: 0,0:10:54.09,0:10:56.09,Default,,0000,0000,0000,,От айдаһарының айқайы.
Dialogue: 0,0:10:59.64,0:11:02.50,Default,,0000,0000,0000,,Мынау бұзылған мең!
Dialogue: 0,0:11:02.50,0:11:05.37,Default,,0000,0000,0000,,Ах! Мен енді қашып құтыла алмаймын.
Dialogue: 0,0:11:05.37,0:11:10.25,Default,,0000,0000,0000,,Сіз! Бойоёо….
Dialogue: 0,0:11:10.25,0:11:12.28,Default,,0000,0000,0000,,Асшаяндар!
Dialogue: 0,0:11:12.28,0:11:15.63,Default,,0000,0000,0000,,Қолтық рөлін ойнасаң болды!
Dialogue: 0,0:11:15.63,0:11:20.52,Default,,0000,0000,0000,,Тұтынушы: Осындай асшаяндарды алғыңыз келе ме?
Dialogue: 0,0:11:20.52,0:11:24.52,Default,,0000,0000,0000,,Хаха! Жаса, краб... асшаян?
Dialogue: 0,0:11:34.82,0:11:38.20,Default,,0000,0000,0000,,Сіз мұны керемет түрде жасадыңыз, Люси. Fairy Tail сиқыршысынан күткендей.
Dialogue: 0,0:11:38.20,0:11:41.06,Default,,0000,0000,0000,,Ай! Бірақ мен оны қайтадан сындырдым.
Dialogue: 0,0:11:41.06,0:11:43.06,Default,,0000,0000,0000,,Мен... Бұл менің кінәм бе?
Dialogue: 0,0:11:51.33,0:11:55.87,Default,,0000,0000,0000,,Бұл кітаптың құрылымы мен жазу стилі шынымен қорқынышты →
Dialogue: 0,0:11:55.87,0:11:58.23,Default,,0000,0000,0000,,Мен оны Кем Залеон жазғанына сене алмадым.
Dialogue: 0,0:11:58.23,0:12:01.23,Default,,0000,0000,0000,,Сонымен? Сондықтан менде бір сыр бар деп ойладым.
Dialogue: 0,0:12:03.62,0:12:05.47,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:12:05.47,0:12:09.85,Default,,0000,0000,0000,,Мен оны жоюды сұрадым деп ойлаймын.
Dialogue: 0,0:12:09.85,0:12:13.71,Default,,0000,0000,0000,,Жою оңай. Тіпті Кирби мұны істей алады.
Dialogue: 0,0:12:13.71,0:12:17.09,Default,,0000,0000,0000,,Олай болса, мен оны өртеп жіберемін. Мен мұндай кітапты көргім келмейді.
Dialogue: 0,0:12:17.09,0:12:21.13,Default,,0000,0000,0000,,Неліктен бұл кітаптың бар екенін мойындай алмайсыз→
Dialogue: 0,0:12:21.13,0:12:23.82,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:12:23.82,0:12:25.34,Default,,0000,0000,0000,,Әкемнің намысын қорғау үшін.
Dialogue: 0,0:12:25.34,0:12:29.21,Default,,0000,0000,0000,,Сіз Кем Залеонның ұлысыз. (Нацу/Бақытты) Иә?
Dialogue: 0,0:12:29.21,0:12:31.89,Default,,0000,0000,0000,,Неліктен бұл?
Dialogue: 0,0:12:31.89,0:12:34.92,Default,,0000,0000,0000,,Сіз бұл кітапты оқыдыңыз ба? үй….
Dialogue: 0,0:12:34.92,0:12:38.30,Default,,0000,0000,0000,,Бірақ оны оқудың қажеті жоқ. Бұл жақсы емес. – деді әкем.
Dialogue: 0,0:12:38.30,0:12:41.16,Default,,0000,0000,0000,,Сонда сіз оны өртеп жібердіңіз бе? бұл дұрыс.
Dialogue: 0,0:12:41.16,0:12:43.19,Default,,0000,0000,0000,,Бұл қызықсыз, мен оны өртеп жіберемін! ?
Dialogue: 0,0:12:43.19,0:12:46.71,Default,,0000,0000,0000,,Бұл соншалықты көп емес пе? О! ?
Dialogue: 0,0:12:46.71,0:12:48.73,Default,,0000,0000,0000,,Бұл менің әкем жазған кітап!
Dialogue: 0,0:12:48.73,0:12:52.94,Default,,0000,0000,0000,,Нацу мен саған айттым ғой! Бұл менің мақтанышымды қорғау үшін.
Dialogue: 0,0:12:52.94,0:12:56.14,Default,,0000,0000,0000,,Ал... әкем «КҮН ҮЗІЛУ»→ деп жазды
Dialogue: 0,0:12:56.14,0:12:58.66,Default,,0000,0000,0000,,Мен ұялдым.
Dialogue: 0,0:12:58.66,0:13:01.66,Default,,0000,0000,0000,,31 жыл бұрын….
Dialogue: 0,0:13:04.22,0:13:06.24,Default,,0000,0000,0000,,Әке! ?
Dialogue: 0,0:13:06.24,0:13:09.11,Default,,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:13:09.11,0:13:14.32,Default,,0000,0000,0000,,Үш жыл бойы хабарласқан жоқпыз. Қай жерде жазып жүрсің?
Dialogue: 0,0:13:14.32,0:13:18.70,Default,,0000,0000,0000,,Мен біттім. Жазушы болуды доғар.
Dialogue: 0,0:13:18.70,0:13:20.72,Default,,0000,0000,0000,,Не….
Dialogue: 0,0:13:20.72,0:13:27.12,Default,,0000,0000,0000,,Мен енді ешқашан кітап жазбаймын! Апыр-ай!
Dialogue: 0,0:13:27.12,0:13:29.12,Default,,0000,0000,0000,,Ей! !
Dialogue: 0,0:15:08.46,0:15:12.00,Default,,0000,0000,0000,,Сен ақымақсың. Мен мұны үш жыл бұрын айтуым керек еді.
Dialogue: 0,0:15:12.00,0:15:14.02,Default,,0000,0000,0000,,Осындай ақымақ кітаппен жұмыс жасасаңыз→
Dialogue: 0,0:15:14.02,0:15:16.04,Default,,0000,0000,0000,,Сіз бұл үшін міндетті түрде өкінесіз.
Dialogue: 0,0:15:16.04,0:15:20.58,Default,,0000,0000,0000,,Ақша жақсы болды. Сен ең нашарсың!
Dialogue: 0,0:15:20.58,0:15:24.13,Default,,0000,0000,0000,,А... бұл ең жаман ақымақ болды.
Dialogue: 0,0:15:24.13,0:15:28.16,Default,,0000,0000,0000,,Неге күлесің? Мұндай қалдықтар үшін →
Dialogue: 0,0:15:28.16,0:15:31.86,Default,,0000,0000,0000,,Мен үш жыл бойы отбасыма қараусыз қалдым!
Dialogue: 0,0:15:31.86,0:15:37.75,Default,,0000,0000,0000,,Кирби... Мен сені әрқашан ойладым.
Dialogue: 0,0:15:37.75,0:15:41.29,Default,,0000,0000,0000,,Егер солай болса, жазып алып, үйге ертерек келуге болатын еді!
Dialogue: 0,0:15:41.29,0:15:44.49,Default,,0000,0000,0000,,Жазушы ретіндегі мақтанышыңызбен бірге отбасыңызды да тастадыңыз.
Dialogue: 0,0:15:44.49,0:15:50.38,Default,,0000,0000,0000,,Жазушы болудан бас тартқаныңыз дұрыс. Мен мақтанышсыз адамға жұмыс істей алмаймын.
Dialogue: 0,0:15:50.38,0:15:53.38,Default,,0000,0000,0000,,Менің әкем де...
Dialogue: 0,0:15:58.46,0:16:02.34,Default,,0000,0000,0000,,Көп ұзамай әкем қайтыс болды.
Dialogue: 0,0:16:02.34,0:16:08.40,Default,,0000,0000,0000,,Содан кейін де... Әкемді жек көретінмін.
Dialogue: 0,0:16:08.40,0:16:11.59,Default,,0000,0000,0000,,Бірақ жылдар өткен сайын →
Dialogue: 0,0:16:11.59,0:16:15.30,Default,,0000,0000,0000,,Жек көру өкінішке айналды.
Dialogue: 0,0:16:15.30,0:16:21.02,Default,,0000,0000,0000,,Дегенмен, қанша кешірім сұрасам да, әкем бұл дүниеде жоқ...
Dialogue: 0,0:16:21.02,0:16:23.88,Default,,0000,0000,0000,,Сондықтан кем дегенде түзетулер енгізу үшін →
Dialogue: 0,0:16:23.88,0:16:26.74,Default,,0000,0000,0000,,Әкемнің соңғы жұмысына айналған бұл сұмдық жұмыс →
Dialogue: 0,0:16:26.74,0:16:32.14,Default,,0000,0000,0000,,Әкемнің абыройы үшін оны бұл дүниеден өшіргім келді.
Dialogue: 0,0:16:32.14,0:16:35.33,Default,,0000,0000,0000,,Енді менің әкем...
Dialogue: 0,0:16:35.33,0:16:37.33,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:16:40.38,0:16:42.74,Default,,0000,0000,0000,,басталды.
Dialogue: 0,0:16:42.74,0:16:46.94,Default,,0000,0000,0000,,Бұл не! ?
Dialogue: 0,0:16:46.94,0:16:51.16,Default,,0000,0000,0000,,Кем Залеон... Жоқ, оның шын есімі Зекуа Мелон.
Dialogue: 0,0:16:51.16,0:16:54.16,Default,,0000,0000,0000,,Ол осы кітапқа сиқырлады. Сиқыр?
Dialogue: 0,0:16:57.05,0:16:59.74,Default,,0000,0000,0000,,『ҚҰРМЕТТІ ҚАБЫ』….
Dialogue: 0,0:16:59.74,0:17:02.43,Default,,0000,0000,0000,,Сонымен... Құрметті Кирби.
Dialogue: 0,0:17:02.43,0:17:05.80,Default,,0000,0000,0000,,Әріптерді өзгертетін сиқыр жасады.
Dialogue: 0,0:17:05.80,0:17:10.18,Default,,0000,0000,0000,,Мұның бәрі ішіндегі нәрсеге байланысты.
Dialogue: 0,0:17:10.18,0:17:13.38,Default,,0000,0000,0000,,О! әдемі!
Dialogue: 0,0:17:13.38,0:17:16.90,Default,,0000,0000,0000,,Жазушы болуды тоқтату себебі →
Dialogue: 0,0:17:16.90,0:17:19.77,Default,,0000,0000,0000,,Ең нашар кітап жазудан басқа→
Dialogue: 0,0:17:19.77,0:17:22.31,Default,,0000,0000,0000,,Мен ең жақсы кітап жазған шығармын.
Dialogue: 0,0:17:22.31,0:17:29.54,Default,,0000,0000,0000,,Кирби мырзаға хаттар атты тамаша кітап...
Dialogue: 0,0:17:29.54,0:17:33.54,Default,,0000,0000,0000,,Мен сені үнемі ойлайтынмын.
Dialogue: 0,0:17:36.11,0:17:40.32,Default,,0000,0000,0000,,Бұл Кем Залеонның артында қалдырғысы келген кітап.
Dialogue: 0,0:17:40.32,0:17:46.54,Default,,0000,0000,0000,,Әке... Рахмет. Бұл кітапты өртеу мүмкін емес.
Dialogue: 0,0:17:46.54,0:17:48.73,Default,,0000,0000,0000,,Онда бізге де сыйлықтың қажеті жоқ.
Dialogue: 0,0:17:48.73,0:17:50.58,Default,,0000,0000,0000,,Ай! иә! ?
Dialogue: 0,0:17:50.58,0:17:54.62,Default,,0000,0000,0000,,Өтініш кітапты жою. Мен оған қол жеткізген жоқпын.
Dialogue: 0,0:17:54.62,0:17:57.65,Default,,0000,0000,0000,,Жоқ... бұл себеп емес...
Dialogue: 0,0:17:57.65,0:18:01.53,Default,,0000,0000,0000,,Иә! Бұл үлкен жақсылық, сондықтан мен оны қабылдаймын.
Dialogue: 0,0:18:01.53,0:18:05.57,Default,,0000,0000,0000,,Ойын~. Ол осы уақытқа дейін жақсы нәрселерді айтып жүрді, бірақ мұның бәрі бос сөз.
Dialogue: 0,0:18:05.57,0:18:08.93,Default,,0000,0000,0000,,Міне! Маған қажет емес нәрселер керек емес.
Dialogue: 0,0:18:08.93,0:18:11.95,Default,,0000,0000,0000,,Міне! Мен оны тілеймін!
Dialogue: 0,0:18:11.95,0:18:16.01,Default,,0000,0000,0000,,Үйге қайт. Қауын да тезірек үйіне қайтуы керек.
Dialogue: 0,0:18:16.01,0:18:19.01,Default,,0000,0000,0000,,Иә? сурет?
Dialogue: 0,0:18:21.56,0:18:26.11,Default,,0000,0000,0000,,Мен сене алар емеспін. Менің ойымша, бұл әдетте 2 миллион хара.
Dialogue: 0,0:18:26.11,0:18:29.30,Default,,0000,0000,0000,,Сұраныс Егер сіз оған қол жеткізе алмасаңыз да ақша алсаңыз→
Dialogue: 0,0:18:29.30,0:18:32.00,Default,,0000,0000,0000,,Бұл Fairy Tail беделінің сәтсіздігі. махаббат!
Dialogue: 0,0:18:32.00,0:18:34.69,Default,,0000,0000,0000,,Жарайды, өйткені бәрі жақсы өтті.
Dialogue: 0,0:18:34.69,0:18:36.71,Default,,0000,0000,0000,,Үйге жаяу барасыз ба?
Dialogue: 0,0:18:36.71,0:18:40.91,Default,,0000,0000,0000,,Иә. Ол кісілер бай емес пе?
Dialogue: 0,0:18:40.91,0:18:44.29,Default,,0000,0000,0000,,Ол бұл үйді тек өзін көрсету үшін жалға алғанын айтты.
Dialogue: 0,0:18:44.29,0:18:48.49,Default,,0000,0000,0000,,Мен мұны істемесем де, өтінішті қабылдайтын едім.
Dialogue: 0,0:18:48.49,0:18:51.49,Default,,0000,0000,0000,,Мен білмеймін. Мен оны қабылдадым. Мүмкін.
Dialogue: 0,0:18:53.54,0:18:57.58,Default,,0000,0000,0000,,Дәлірек айтқанда, сіз үйді қалай байқадыңыз?
Dialogue: 0,0:18:57.58,0:19:02.30,Default,,0000,0000,0000,,Иә? Үйдің иісі анау жігіттерден бөлек еді. Сіз оны әдеттегідей байқайсыз.
Dialogue: 0,0:19:02.30,0:19:05.49,Default,,0000,0000,0000,,Өйткені мен хайуан емеспін...
Dialogue: 0,0:19:05.49,0:19:09.71,Default,,0000,0000,0000,,Бірақ мен романистерге қайран қаламын.
Dialogue: 0,0:19:09.71,0:19:11.06,Default,,0000,0000,0000,,Күтілгендей.
Dialogue: 0,0:19:11.06,0:19:17.11,Default,,0000,0000,0000,,Алдыңғы Люси жасырған нәрсе - ол өзі жазған роман.
Dialogue: 0,0:19:17.11,0:19:19.14,Default,,0000,0000,0000,,Кітап туралы көп біледі.
Dialogue: 0,0:19:19.14,0:19:23.51,Default,,0000,0000,0000,,Ешқашан ешкімге айтпа! неге?
Dialogue: 0,0:19:23.51,0:19:27.05,Default,,0000,0000,0000,,Әлі жаман! Егер сіз оны оқысаңыз, ұят болады!
Dialogue: 0,0:19:27.05,0:19:29.73,Default,,0000,0000,0000,,Жоқ, оны ешкім оқымайды.
Dialogue: 0,0:19:29.73,0:19:32.73,Default,,0000,0000,0000,,Бұл аздап қайғылы.
Dialogue: 0,0:19:34.46,0:19:37.65,Default,,0000,0000,0000,,Бір сәт, бұл шынымен дұрыс жол ма?
Dialogue: 0,0:19:37.65,0:19:39.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:39.01,0:19:42.53,Default,,0000,0000,0000,,Хаппи былай дейді, сондықтан бұл болуы керек →
Dialogue: 0,0:19:42.53,0:19:45.06,Default,,0000,0000,0000,,. (Бақытты) Кешіріңіз!
Dialogue: 0,0:19:45.06,0:19:48.93,Default,,0000,0000,0000,,Мен осылай болсам да, мысықпын ғой, солай ма? Мысықтардың мұрны жақсы.
Dialogue: 0,0:19:48.93,0:19:50.28,Default,,0000,0000,0000,,Бұл иттер туралы емес пе?
Dialogue: 0,0:19:50.28,0:19:54.16,Default,,0000,0000,0000,,Иіс пен жолдың бір-біріне қандай қатысы бар? Менің айтып тұрғаным осы.
Dialogue: 0,0:19:54.16,0:19:57.85,Default,,0000,0000,0000,,Жарайды, өзің жүруің керек.
Dialogue: 0,0:19:57.85,0:20:00.71,Default,,0000,0000,0000,,Мен шаршадым. Менің айтып тұрғаным осы.
Dialogue: 0,0:20:00.71,0:20:02.23,Default,,0000,0000,0000,,Мен мұны қалаймын.
Dialogue: 0,0:20:02.23,0:20:05.10,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:20:05.10,0:20:10.10,Default,,0000,0000,0000,,Тым көп ұрысамыз деймін. Сәттілік Нацу!
Dialogue: 0,0:20:13.01,0:20:16.21,Default,,0000,0000,0000,,Бұл сұр! Неге шалбар! ? Менің айтып тұрғаным осы.
Dialogue: 0,0:20:16.21,0:20:18.23,Default,,0000,0000,0000,,Мен дәретхана іздеп жүрмін!
Dialogue: 0,0:20:18.23,0:20:21.09,Default,,0000,0000,0000,,Мен сені тапқанша неге киіміңді шешіп алдың?
Dialogue: 0,0:20:21.09,0:20:24.62,Default,,0000,0000,0000,,Орманда мұндай дәретхана болуы мүмкін емес.
Dialogue: 0,0:20:24.62,0:20:27.65,Default,,0000,0000,0000,,Сіз басқалардың дәретханасына кедергі жасамайтын адамсыз.
Dialogue: 0,0:20:27.65,0:20:30.18,Default,,0000,0000,0000,,Төмен деңгей. Мен айтамын...
Dialogue: 0,0:20:30.18,0:20:35.56,Default,,0000,0000,0000,,Мен көремін. Мен жұмыстан үйге келе жатырмын.
Dialogue: 0,0:20:35.56,0:20:38.93,Default,,0000,0000,0000,,Магнолияға оралудың төте жолы - осы орманды кесу.
Dialogue: 0,0:20:38.93,0:20:42.97,Default,,0000,0000,0000,,Хоора Хоора Хоора! Мұрным жақсы деп мақтанатынмын →
Dialogue: 0,0:20:42.97,0:20:45.99,Default,,0000,0000,0000,,Сұрдың иісі Түсінбедің бе?
Dialogue: 0,0:20:45.99,0:20:48.53,Default,,0000,0000,0000,,Сіз иіскегіңіз келмейтін иістер бар. Мінеки!
Dialogue: 0,0:20:48.53,0:20:51.72,Default,,0000,0000,0000,,Өте шулы. Темее, тез үйге өзің қайт.
Dialogue: 0,0:20:51.72,0:20:54.75,Default,,0000,0000,0000,,Әрине, мен үйге тезірек баруым керек→
Dialogue: 0,0:20:54.75,0:20:56.10,Default,,0000,0000,0000,,Өйткені бұл қауіпті. Не болды?
Dialogue: 0,0:20:56.10,0:20:58.96,Default,,0000,0000,0000,,Эльза жақында оралады.
Dialogue: 0,0:20:58.96,0:21:00.32,Default,,0000,0000,0000,,Бұл Эльза ма?
Dialogue: 0,0:21:00.32,0:21:04.02,Default,,0000,0000,0000,,Ол ертегідегі ең күшті сиқыршы деп айтылады.
Dialogue: 0,0:21:04.02,0:21:06.21,Default,,0000,0000,0000,,Керемет! Мен сені сағындым!
Dialogue: 0,0:21:06.21,0:21:10.91,Default,,0000,0000,0000,,Бірақ Эльза ешбір журналда немесе ештеңеде көрінбейді →
Dialogue: 0,0:21:10.91,0:21:13.27,Default,,0000,0000,0000,,Сіз қандай адамсыз? қорқады….
Dialogue: 0,0:21:13.27,0:21:15.46,Default,,0000,0000,0000,,Аң? аң?
Dialogue: 0,0:21:15.46,0:21:19.00,Default,,0000,0000,0000,,Бұл құбыжық.
Dialogue: 0,0:21:19.00,0:21:22.20,Default,,0000,0000,0000,,Бұл соншалықты үлкен емес. Жоқ, бұл таңқаларлық.
Dialogue: 0,0:21:22.20,0:21:26.90,Default,,0000,0000,0000,,Қорқыныш тұрғысынан Люсидің қиялы алыс емес.
Dialogue: 0,0:21:26.90,0:21:29.10,Default,,0000,0000,0000,,Мүмкін одан да үлкен.
Dialogue: 0,0:21:29.10,0:21:31.79,Default,,0000,0000,0000,,Бұл өте үлкен.
Dialogue: 0,0:21:31.79,0:21:33.48,Default,,0000,0000,0000,,Жоқ, егер бұл тау болса, бірінде 3-ке жуық → болар еді
Dialogue: 0,0:21:33.48,0:21:35.17,Default,,0000,0000,0000,,Бірден жарылып кетпей ме?
Dialogue: 0,0:21:35.17,0:21:38.86,Default,,0000,0000,0000,,Үш - бұл асыра сілтеу. Екі ше?
Dialogue: 0,0:21:38.86,0:21:42.40,Default,,0000,0000,0000,,Біреуімен екі тауды ұшырып жіберетін әйел... қорқынышты болуы мүмкін...
Dialogue: 0,0:21:42.40,0:21:47.61,Default,,0000,0000,0000,,Әйтеуір, тезірек үйге баруым керек. Эй, кеттік!
Dialogue: 0,0:21:47.61,0:21:49.61,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:51.49,0:21:53.51,Default,,0000,0000,0000,,Пепе Пепе! Сиқыршы!
Dialogue: 0,0:21:53.51,0:21:55.20,Default,,0000,0000,0000,,Бақытты! ? махаббат….
Dialogue: 0,0:21:55.20,0:21:58.23,Default,,0000,0000,0000,,Хехе... Соңғы рет протеин алғаныма біраз болды.
Dialogue: 0,0:21:58.23,0:22:01.42,Default,,0000,0000,0000,,Мен жаңғақтардан шаршадым.
Dialogue: 0,0:22:01.42,0:22:04.95,Default,,0000,0000,0000,,Ет! Бұл дәмді көрінеді.
Dialogue: 0,0:22:04.95,0:22:07.81,Default,,0000,0000,0000,,Ой, мына жігіт дірілдеп тұр.
Dialogue: 0,0:22:07.81,0:22:11.36,Default,,0000,0000,0000,,Бұл қорқынышты болуы мүмкін, бірақ біз оны асқазанға түсіреміз.
Dialogue: 0,0:22:11.36,0:22:14.05,Default,,0000,0000,0000,,Жоқ, мен қорыққандықтан дірілдеп тұрған жоқпын.
Dialogue: 0,0:22:14.05,0:22:17.25,Default,,0000,0000,0000,,А? Мен дәретханаға барғым келді.
Dialogue: 0,0:22:17.25,0:22:19.27,Default,,0000,0000,0000,,Иә? Ол ағып кетуі мүмкін.
Dialogue: 0,0:22:19.27,0:22:22.97,Default,,0000,0000,0000,,Егер сіз мұны істесеңіз, оның дәмі біртүрлі болады.
Dialogue: 0,0:22:22.97,0:22:25.97,Default,,0000,0000,0000,,Шулы! Жаса! ет!
Dialogue: 0,0:22:27.35,0:22:30.72,Default,,0000,0000,0000,,Орташа. А, бұл енді жұмыс істемеуі мүмкін.
Dialogue: 0,0:22:30.72,0:22:33.91,Default,,0000,0000,0000,,Дәмі біртүрлі болатынына сенімдімін, бірақ солай ма?
Dialogue: 0,0:22:33.91,0:22:37.45,Default,,0000,0000,0000,,Күте тұрыңыз! бақытты!
Dialogue: 0,0:22:37.45,0:22:41.65,Default,,0000,0000,0000,,Бір қызық дәм болмады. Мен оны әлі айтуым керек пе?
Dialogue: 0,0:22:41.65,0:22:44.19,Default,,0000,0000,0000,,Ол жігіт біздің біріміз. Себебі қарным ашты →
Dialogue: 0,0:22:44.19,0:22:46.04,Default,,0000,0000,0000,,Мен саған оны жеуге рұқсат ете алмаймын.
Dialogue: 0,0:22:46.04,0:22:49.40,Default,,0000,0000,0000,,Балалар сендер сиқыршысыңдар. Бұл қандай гильдия?
Dialogue: 0,0:22:49.40,0:22:52.27,Default,,0000,0000,0000,,Маңызды емес! Жаса!
Dialogue: 0,0:22:52.27,0:22:56.27,Default,,0000,0000,0000,,Сұр Жасайық! Сіз маған бұйрық бермейсіз.
Dialogue: 0,0:22:59.33,0:23:01.33,Default,,0000,0000,0000,,Құм бомбасын өлтіріңіз!
Dialogue: 0,0:23:04.05,0:23:06.41,Default,,0000,0000,0000,,Нацу! Уайымдама!
Dialogue: 0,0:23:06.41,0:23:09.41,Default,,0000,0000,0000,,Бақытты сұра! Ух... иә!
Dialogue: 0,0:23:12.46,0:23:16.46,Default,,0000,0000,0000,,Уау, Люси мені жеп қояды~. Шулы мысық!
Dialogue: 0,0:23:18.52,0:23:21.39,Default,,0000,0000,0000,,Ай!
Dialogue: 0,0:23:21.39,0:23:24.42,Default,,0000,0000,0000,,Жай… Танысыңыз….
Dialogue: 0,0:23:24.42,0:23:27.45,Default,,0000,0000,0000,,Келесі!
Dialogue: 0,0:23:27.45,0:23:31.49,Default,,0000,0000,0000,,Күтіп тұрған адам келе жатыр. Су дағдарысы кезеңі мен әйелдер дағдарысы фазасы пайда болуда.
Dialogue: 0,0:23:31.49,0:23:34.01,Default,,0000,0000,0000,,Болжам ...?
Dialogue: 0,0:23:34.01,0:23:36.21,Default,,0000,0000,0000,,Сиқырды қолданбай... Керемет!
Dialogue: 0,0:23:36.21,0:23:38.06,Default,,0000,0000,0000,,Киім! О!
Dialogue: 0,0:23:38.06,0:23:41.42,Default,,0000,0000,0000,,Бұл не деген жігіттер...?
Dialogue: 0,0:23:41.42,0:23:44.45,Default,,0000,0000,0000,,Герояба! Теми!
Dialogue: 0,0:23:44.45,0:23:47.45,Default,,0000,0000,0000,,Жұрттың аузын аштырма!
Dialogue: 0,0:23:49.67,0:23:53.71,Default,,0000,0000,0000,,Кеттік... От айдаһарының темір жұдырығы!
Dialogue: 0,0:23:53.71,0:24:02.63,Default,,0000,0000,0000,,～
Dialogue: 0,0:24:02.63,0:24:04.63,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:24:07.01,0:24:09.70,Default,,0000,0000,0000,,Закомен тым байсалды болма.
Dialogue: 0,0:24:09.70,0:24:12.90,Default,,0000,0000,0000,,Темее, мен анау ауызды күйдіремін! Күйіп қалмаңыз.
Dialogue: 0,0:24:12.90,0:24:15.59,Default,,0000,0000,0000,,Теменің жылы оты. Ах! ?
Dialogue: 0,0:24:15.59,0:24:18.79,Default,,0000,0000,0000,,Лара…. Е... не? Лала?
Dialogue: 0,0:24:18.79,0:24:22.33,Default,,0000,0000,0000,,Лала... сау бол... бірақ...
Dialogue: 0,0:24:22.33,0:24:24.52,Default,,0000,0000,0000,,А? Бесік жыры?
Dialogue: 0,0:24:24.52,0:24:27.38,Default,,0000,0000,0000,,Қауіпті! Эй!
Dialogue: 0,0:24:27.38,0:24:30.38,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:24:31.26,0:24:34.11,Default,,0000,0000,0000,,Бұл не? Ол кім? ?
Dialogue: 0,0:24:34.11,0:24:39.33,Default,,0000,0000,0000,,Қатысу әлдеқашан жоғалып кетті. Ол өте тез қашатын жігіт.
Dialogue: 0,0:24:39.33,0:24:42.03,Default,,0000,0000,0000,,Тәтті, мен түсінбеймін.
Dialogue: 0,0:24:42.03,0:24:45.03,Default,,0000,0000,0000,,Бесік жыры?
Dialogue: 0,0:25:01.72,0:25:11.72,Default,,0000,0000,0000,,～
Dialogue: 0,0:25:13.22,0:25:19.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory