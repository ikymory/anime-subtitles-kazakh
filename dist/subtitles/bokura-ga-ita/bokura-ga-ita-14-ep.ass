Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.29,0:00:08.46,Default,,0,0,0,,Иә? Сіз үнемі қайда барасыз?
Dialogue: 0,0:00:08.55,0:00:10.92,Default,,0,0,0,,А-а, болды, сонда болды
Dialogue: 0,0:00:13.59,0:00:16.34,Default,,0,0,0,,Бұрын мен бір нәрсені есіме түсірдім.
Dialogue: 0,0:00:16.43,0:00:17.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:17.35,0:00:19.06,Default,,0,0,0,,Сол күні таңертең
Dialogue: 0,0:00:20.97,0:00:22.85,Default,,0,0,0,,Бұл ультиматум болды.
Dialogue: 0,0:00:23.85,0:00:25.77,Default,,0,0,0,,«Өкінішті»
Dialogue: 0,0:00:29.11,0:00:30.19,Default,,0,0,0,,Мен саған айттым ба?
Dialogue: 0,0:00:34.45,0:00:35.41,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:00:35.49,0:00:36.57,Default,,0,0,0,,Ах
Dialogue: 0,0:01:04.98,0:01:06.35,Default,,0,0,0,,Махаббат бұл...
Dialogue: 0,0:01:08.56,0:01:10.11,Default,,0,0,0,,Уақыт...
Dialogue: 0,0:01:12.98,0:01:14.19,Default,,0,0,0,,үшін
Dialogue: 0,0:01:20.20,0:01:25.21,Default,,0,0,0,,♪～
Dialogue: 0,0:02:45.91,0:02:50.96,Default,,0,0,0,,～♪
Dialogue: 0,0:03:10.23,0:03:11.39,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:11.48,0:03:13.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:13.27,0:03:15.40,Default,,0,0,0,,Уа, сабыр ет, мен автобустамын.
Dialogue: 0,0:03:16.23,0:03:17.36,Default,,0,0,0,,Хмм (Тамачи) Уф
Dialogue: 0,0:03:21.74,0:03:22.20,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:03:22.20,0:03:24.03,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:03:22.20,0:03:24.03,Default,,0,0,0,,Шық, тез шық.
Dialogue: 0,0:03:24.03,0:03:25.74,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:03:26.41,0:03:29.08,Default,,0,0,0,,Мен қазір телефонға жауап бере алмаймын.
Dialogue: 0,0:03:29.16,0:03:30.16,Default,,0,0,0,,Теру дыбысынан кейін...
Dialogue: 0,0:03:33.75,0:03:36.17,Default,,0,0,0,,Ал, егер Такахашиге қимыл жасасаң, мен сені өлтіремін.
Dialogue: 0,0:03:36.25,0:03:38.92,Default,,0,0,0,,Көлікте ұялы телефонды пайдалану...
Dialogue: 0,0:03:39.01,0:03:40.92,Default,,0,0,0,,А, кешіріңіз, эй.
Dialogue: 0,0:03:41.01,0:03:43.43,Default,,0,0,0,,Сіз түсесіз бе? Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:03:44.93,0:03:46.43,Default,,0,0,0,,Алдын алу
Dialogue: 0,0:03:49.64,0:03:50.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:51.02,0:03:53.94,Default,,0,0,0,,Күшіктер шынымен сүйкімді
Dialogue: 0,0:03:54.02,0:03:56.48,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:03:56.56,0:03:59.44,Default,,0,0,0,,Мизучин Бұлай тарлық ету азапты.
Dialogue: 0,0:03:59.53,0:04:01.86,Default,,0,0,0,,Мен де сені ұстап алайын
Dialogue: 0,0:04:01.95,0:04:03.99,Default,,0,0,0,,Жоқ, бұл менікі.
Dialogue: 0,0:04:04.07,0:04:04.45,Default,,0,0,0,,Міне, осында, осында.
Dialogue: 0,0:04:04.45,0:04:05.66,Default,,0,0,0,,Міне, осында, осында.
Dialogue: 0,0:04:04.45,0:04:05.66,Default,,0,0,0,,Қолымнан келгенше...
Dialogue: 0,0:04:06.95,0:04:10.50,Default,,0,0,0,,Мүмкін мен уақытты өткізіп алған шығармын.
Dialogue: 0,0:04:10.58,0:04:11.66,Default,,0,0,0,,Такеучи мырза
Dialogue: 0,0:04:12.41,0:04:13.71,Default,,0,0,0,,Суретке түсіру
Dialogue: 0,0:04:18.09,0:04:19.67,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,0:04:22.72,0:04:23.84,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:25.68,0:04:28.68,Default,,0,0,0,,Қарасам, екеуінің де иелері табылды.
Dialogue: 0,0:04:28.76,0:04:31.89,Default,,0,0,0,,Иә, туыстарым келесі аптада береді.
Dialogue: 0,0:04:32.39,0:04:34.69,Default,,0,0,0,,Негізі біреуін үйде ұстағым келді.
Dialogue: 0,0:04:34.77,0:04:37.40,Default,,0,0,0,,Екіншісін қайдан алдың?
Dialogue: 0,0:04:34.77,0:04:37.40,Default,,0,0,0,,Күтіңіз, күтіңіз, ахаха
Dialogue: 0,0:04:37.48,0:04:39.19,Default,,0,0,0,,Иә? Көршілес
Dialogue: 0,0:04:39.27,0:04:41.73,Default,,0,0,0,,Сонда біз қайта кездесе алмаймыз, солай ма?
Dialogue: 0,0:04:41.82,0:04:44.74,Default,,0,0,0,,Иә? Бұл дұрыс
Dialogue: 0,0:04:49.20,0:04:51.37,Default,,0,0,0,,Егер бірдеңе жасап көрсең, мен сені өлтіремін.
Dialogue: 0,0:05:07.93,0:05:09.93,Default,,0,0,0,,Ия, күте тұрыңыз.
Dialogue: 0,0:05:10.01,0:05:12.72,Default,,0,0,0,,Қараңыз, ван ван ван, күтіңіз!
Dialogue: 0,0:05:12.81,0:05:14.77,Default,,0,0,0,,Ахахаха Күт, күт, Уфуфуфу
Dialogue: 0,0:05:14.85,0:05:17.27,Default,,0,0,0,,(күшіктің үруі)
Dialogue: 0,0:05:17.35,0:05:19.81,Default,,0,0,0,,Уа, күте тұрыңыз!
Dialogue: 0,0:05:21.36,0:05:22.82,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:05:22.90,0:05:25.82,Default,,0,0,0,,Мен бір сәт есеңгіреп қалдым.
Dialogue: 0,0:05:26.86,0:05:28.82,Default,,0,0,0,,Мизучин де солай.
Dialogue: 0,0:05:28.91,0:05:33.83,Default,,0,0,0,,Ерекше мағынасы бар ма?
Dialogue: 0,0:05:34.54,0:05:38.37,Default,,0,0,0,,Мен мұны байқаған кезде кенеттен сөйлеу қиынға соқты.
Dialogue: 0,0:05:39.50,0:05:41.34,Default,,0,0,0,,Ано (Нами) А... иә?
Dialogue: 0,0:05:41.42,0:05:42.84,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:05:42.92,0:05:45.55,Default,,0,0,0,,Аа, кешіріңіз, бұл менмін.
Dialogue: 0,0:05:45.63,0:05:47.43,Default,,0,0,0,,Үйден (телефонға жауап беру дыбысы)
Dialogue: 0,0:05:47.51,0:05:48.59,Default,,0,0,0,,Иә
Dialogue: 0,0:05:48.68,0:05:50.55,Default,,0,0,0,,...
Dialogue: 0,0:05:50.64,0:05:51.97,Default,,0,0,0,,Жеткізу Ол келгендіктен
Dialogue: 0,0:05:52.06,0:05:54.89,Default,,0,0,0,,Анам менен бірдеңе сұрай аламын ба деп сұрады.
Dialogue: 0,0:05:54.97,0:05:56.56,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,0:05:56.64,0:05:57.73,Default,,0,0,0,,Мен қайтып келгенде
Dialogue: 0,0:05:57.81,0:05:59.06,Default,,0,0,0,,Қашан қайтасыз?
Dialogue: 0,0:05:59.15,0:06:01.44,Default,,0,0,0,,Мен білмеймін. Аз ғана уақыт.
Dialogue: 0,0:06:01.52,0:06:03.11,Default,,0,0,0,,Сағат нешеге таяп қалды?
Dialogue: 0,0:06:03.19,0:06:04.32,Default,,0,0,0,,Мен асығыспын.
Dialogue: 0,0:06:04.40,0:06:07.11,Default,,0,0,0,,Бірден, мен бірден сонда боламын.
Dialogue: 0,0:06:07.90,0:06:09.32,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:09.41,0:06:10.99,Default,,0,0,0,,Тәртіп
Dialogue: 0,0:06:11.07,0:06:13.33,Default,,0,0,0,,Айтпақшы, қазір қайдасың?
Dialogue: 0,0:06:15.70,0:06:18.54,Default,,0,0,0,,(Қоңырау ажыратылған дыбыс)
Dialogue: 0,0:06:18.62,0:06:20.46,Default,,0,0,0,,О, бұзылды.
Dialogue: 0,0:06:21.42,0:06:24.17,Default,,0,0,0,,Бұл бала таң қаларлықтай ақылды.
Dialogue: 0,0:06:26.96,0:06:29.63,Default,,0,0,0,,Менің әпкеме ұқсайтыныңызға сенімдімін.
Dialogue: 0,0:06:29.72,0:06:32.76,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:06:32.85,0:06:33.72,Default,,0,0,0,,Айтайын, мен
Dialogue: 0,0:06:33.81,0:06:36.89,Default,,0,0,0,,Мен ол әйелге ешқашан қол қойған емеспін, солай ма?
Dialogue: 0,0:06:36.97,0:06:39.52,Default,,0,0,0,,Бірақ бұл нені білдіреді?
Dialogue: 0,0:06:39.60,0:06:42.56,Default,,0,0,0,,«Қалай қарсыласыңды жеңуге болады?» Шабуылдың дұрыс жолы
Dialogue: 0,0:06:42.65,0:06:44.82,Default,,0,0,0,,Мүмкін сіз біреудің қасында үйренген шығарсыз.
Dialogue: 0,0:06:44.90,0:06:47.15,Default,,0,0,0,,Ақымақ болма, Такахаши менің әйелім.
Dialogue: 0,0:06:49.32,0:06:50.66,Default,,0,0,0,,Мен тасталдым, бірақ
Dialogue: 0,0:06:56.33,0:06:57.66,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:06:57.75,0:07:00.54,Default,,0,0,0,,Терлеп жүгіріп келдің.
Dialogue: 0,0:07:01.29,0:07:04.88,Default,,0,0,0,,Мен ешқашан жақын досым сатқындық жасайды деп ойламадым.
Dialogue: 0,0:07:06.92,0:07:09.47,Default,,0,0,0,,Махаббатта жеңіске жетудің кілтін айтайын ба?
Dialogue: 0,0:07:10.59,0:07:13.64,Default,,0,0,0,,1 Серіктесті дұрыс таңдау
Dialogue: 0,0:07:13.72,0:07:16.39,Default,,0,0,0,,2 Адал болыңыз
Dialogue: 0,0:07:16.47,0:07:19.48,Default,,0,0,0,,Олардың біреуі жоқ болса, ол жұмыс істемейді.
Dialogue: 0,0:07:20.43,0:07:22.15,Default,,0,0,0,,Дұрыс адам кім?
Dialogue: 0,0:07:22.23,0:07:23.86,Default,,0,0,0,,Тек ұнату жеткілікті емес пе?
Dialogue: 0,0:07:23.94,0:07:28.11,Default,,0,0,0,,Сайып келгенде, адамдар тек байланысы бар адамдармен ғана бірге бола алады.
Dialogue: 0,0:07:28.19,0:07:31.74,Default,,0,0,0,,Егер сізде қарым-қатынас болмаса, неге қарым-қатынас жасамасқа?
Dialogue: 0,0:07:31.82,0:07:33.32,Default,,0,0,0,,Хмм тым жоғары
Dialogue: 0,0:07:33.41,0:07:35.12,Default,,0,0,0,,Бұл қоқыс.
Dialogue: 0,0:07:40.54,0:07:41.75,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:07:42.25,0:07:45.25,Default,,0,0,0,,Ғашық болған соң, тағдыр деп сенгің келеді.
Dialogue: 0,0:07:48.88,0:07:50.13,Default,,0,0,0,,Күл!
Dialogue: 0,0:07:52.68,0:07:56.05,Default,,0,0,0,,Сонда сізге жетіспейтін нәрсе – «шынымды айтсам»
Dialogue: 0,0:07:56.14,0:07:57.72,Default,,0,0,0,,Мен сізге тағы бір нәрсе айтайын.
Dialogue: 0,0:07:57.81,0:08:00.48,Default,,0,0,0,,Менің есімде сол балалар итті өздерімен бірге алып кеткен.
Dialogue: 0,0:08:00.56,0:08:02.44,Default,,0,0,0,,Мен сол жаққа бұрылдым (орыннан шыққан дыбыс)
Dialogue: 0,0:08:02.52,0:08:05.44,Default,,0,0,0,,Ол S-Mart жанындағы саябаққа бара жатқан шығар...
Dialogue: 0,0:08:10.03,0:08:12.65,Default,,0,0,0,,Фумика: Бұл оң жақта емес, сол жақта, солай ма?
Dialogue: 0,0:08:12.74,0:08:14.16,Default,,0,0,0,,Қандай жаман ...
Dialogue: 0,0:08:14.24,0:08:16.45,Default,,0,0,0,,Жас болу тітіркендіргіш емес пе (ана)?
Dialogue: 0,0:08:16.53,0:08:17.95,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:08:18.03,0:08:20.83,Default,,0,0,0,,Жас кезде тынбай еңбек еткен жақсы.
Dialogue: 0,0:08:20.91,0:08:24.21,Default,,0,0,0,,Ерлігің болса, кез келген қиындықты жеңе білу керек!
Dialogue: 0,0:08:24.29,0:08:26.96,Default,,0,0,0,,Жоқ, сіз жай ғана көңіл көтеріп жатырсыз...
Dialogue: 0,0:08:27.04,0:08:31.96,Default,,0,0,0,,Екеуің де күресіңдер, күресіңдер, жақсы адам болыңдар.
Dialogue: 0,0:08:34.05,0:08:35.97,Default,,0,0,0,,Ахаха, күте тұр, күт!
Dialogue: 0,0:08:36.05,0:08:38.97,Default,,0,0,0,,Уа, уф, уф, уф, ахах
Dialogue: 0,0:08:39.06,0:08:43.27,Default,,0,0,0,,Қаш! (күшік үреді)
Dialogue: 0,0:08:43.35,0:08:46.69,Default,,0,0,0,,Қара, күт, күт, күт, ахахха...
Dialogue: 0,0:08:46.77,0:08:51.53,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:08:51.61,0:08:53.99,Default,,0,0,0,,Бұл жақсы емес пе? Жақсы емес пе?
Dialogue: 0,0:08:54.07,0:08:56.32,Default,,0,0,0,,Егер ол бізбен бірге қалса, қауіп-қатерде болады.
Dialogue: 0,0:08:56.41,0:09:00.24,Default,,0,0,0,,Маған соншалықты жақсы болған кезде екеуің не істеп жатырсыңдар?
Dialogue: 0,0:09:00.33,0:09:01.49,Default,,0,0,0,,Өтінемін, сөйлеңіз.
Dialogue: 0,0:09:04.58,0:09:07.75,Default,,0,0,0,,Ми... Мизугучи иттерді өте жақсы көреді.
Dialogue: 0,0:09:07.83,0:09:10.29,Default,,0,0,0,,Мен таң қалдым және оған жабыспай тұра алмадым.
Dialogue: 0,0:09:10.38,0:09:13.88,Default,,0,0,0,,Жарайды, расында, жарайды, мен одан ешқашан жалықпаймын.
Dialogue: 0,0:09:14.72,0:09:16.68,Default,,0,0,0,,Байқаусызда Мизучинге көзім түсті
Dialogue: 0,0:09:16.76,0:09:18.89,Default,,0,0,0,,Мен уақытты үнсіз өткіздім.
Dialogue: 0,0:09:18.97,0:09:21.14,Default,,0,0,0,,Өзіңізді жаман сезіндіңіз бе?
Dialogue: 0,0:09:21.22,0:09:22.97,Default,,0,0,0,,Мен ренжіген жоқпын деп үміттенемін.
Dialogue: 0,0:09:23.06,0:09:26.02,Default,,0,0,0,,Неліктен сіз бұлай сезінесіз?
Dialogue: 0,0:09:41.08,0:09:42.83,Default,,0,0,0,,Ахах... хах
Dialogue: 0,0:09:43.54,0:09:48.33,Default,,0,0,0,,Эй... жай ғана... үзіліс...
Dialogue: 0,0:09:48.42,0:09:49.75,Default,,0,0,0,,А, кешіріңіз, мен сіздің сөзіңізді бөлдім бе?
Dialogue: 0,0:09:49.83,0:09:51.04,Default,,0,0,0,,Жоқ, мүлде емес!
Dialogue: 0,0:09:51.13,0:09:52.59,Default,,0,0,0,,үшін...
Dialogue: 0,0:09:53.38,0:09:54.80,Default,,0,0,0,,Әрине...
Dialogue: 0,0:09:55.63,0:09:57.38,Default,,0,0,0,,О... дұрыс.
Dialogue: 0,0:09:57.47,0:09:58.76,Default,,0,0,0,,Бұл қылыш соққысы аспан мен аспан арасында саңылау ашады—
Dialogue: 0,0:09:58.84,0:10:00.89,Default,,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:10:00.97,0:10:03.18,Default,,0,0,0,,Мен ақымақпын. Мен өзімді тым санаймын.
Dialogue: 0,0:10:03.26,0:10:06.77,Default,,0,0,0,,Негізі мен Такеучидің ең жақын досының бұрынғы ғашығымын.
Dialogue: 0,0:10:06.85,0:10:11.27,Default,,0,0,0,,Такеучи-кунның сізге мейірімді болуы табиғи нәрсе емес пе?
Dialogue: 0,0:10:11.36,0:10:15.44,Default,,0,0,0,,Оның ерекше мағынасы жоқ.
Dialogue: 0,0:10:15.53,0:10:19.53,Default,,0,0,0,,(Яноның ауыр тыныс алуы)
Dialogue: 0,0:10:27.29,0:10:29.71,Default,,0,0,0,,Сен әлгі қарғыс атқыр әйелді алдың.
Dialogue: 0,0:10:29.79,0:10:32.63,Default,,0,0,0,,Менің айтайын дегенім, егер сіз бұл туралы ойласаңыз, бұл өте анық.
Dialogue: 0,0:10:32.71,0:10:34.34,Default,,0,0,0,,Итіңізді әкеліңіз...
Dialogue: 0,0:10:34.42,0:10:37.38,Default,,0,0,0,,Итіңізді әкелсеңіз... онда бұл өзен арнасы, солай ма?
Dialogue: 0,0:10:41.01,0:10:43.80,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:10:44.68,0:10:46.14,Default,,0,0,0,,Аялдама ана жақта емес пе?
Dialogue: 0,0:10:46.22,0:10:48.35,Default,,0,0,0,,Хмм... бұл жақынырақ.
Dialogue: 0,0:11:06.83,0:11:09.16,Default,,0,0,0,,Менің ойымша, автобус жақында келеді.
Dialogue: 0,0:11:09.25,0:11:11.12,Default,,0,0,0,,Аа, шынымен де (Яно) Такахаши
Dialogue: 0,0:11:11.92,0:11:14.88,Default,,0,0,0,,Сіз менімен ажырасуды ойлайтын шығарсыз, бірақ
Dialogue: 0,0:11:14.96,0:11:16.63,Default,,0,0,0,,Өйткені мен бұған келісім бермедім.
Dialogue: 0,0:11:21.59,0:11:24.64,Default,,0,0,0,,Екеуміз ажырасып кеттік деп ойламаймын.
Dialogue: 0,0:11:27.72,0:11:31.14,Default,,0,0,0,,Мүмкін сіз өзіңізді жеткіліксіз деп ойлайтын шығарсыз.
Dialogue: 0,0:11:32.52,0:11:35.61,Default,,0,0,0,,Мұны сіз шешу емес, мен шешуім керек.
Dialogue: 0,0:11:36.73,0:11:37.86,Default,,0,0,0,,(Автобустың жүру дыбысы)
Dialogue: 0,0:11:37.94,0:11:38.78,Default,,0,0,0,,Автобус келді
Dialogue: 0,0:11:41.24,0:11:42.86,Default,,0,0,0,,Мінбе (Нанами) Ух... Иә.
Dialogue: 0,0:11:42.95,0:11:43.78,Default,,0,0,0,,Такахаши!
Dialogue: 0,0:11:43.86,0:11:46.28,Default,,0,0,0,,Немесе мені жеткіліксіз деп ойласаңыз
Dialogue: 0,0:11:46.37,0:11:48.12,Default,,0,0,0,,Қалағаныңызша жасаңыз
Dialogue: 0,0:11:48.20,0:11:49.50,Default,,0,0,0,,Бұдан былай қалағаныңызша
Dialogue: 0,0:11:49.58,0:11:52.75,Default,,0,0,0,,Сіз үшін кез келген сома, кез келген сома
Dialogue: 0,0:11:52.83,0:11:55.21,Default,,0,0,0,,Жомарт болма
Dialogue: 0,0:11:55.79,0:11:58.17,Default,,0,0,0,,Мен бәрін жасаймын. Тыңда, мен...
Dialogue: 0,0:11:58.25,0:12:00.42,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:12:03.68,0:12:05.26,Default,,0,0,0,,Мен сенмін
Dialogue: 0,0:12:10.43,0:12:11.98,Default,,0,0,0,,Қайтып келерсіз деп үміттенемін...
Dialogue: 0,0:12:15.15,0:12:16.48,Default,,0,0,0,,Күту
Dialogue: 0,0:12:37.54,0:12:38.88,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:12:43.63,0:12:44.88,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:12:52.93,0:12:54.69,Default,,0,0,0,,Автобус құны (Нами) Иә!
Dialogue: 0,0:12:54.77,0:12:56.60,Default,,0,0,0,,(салынып жатқан тиын дыбысы)
Dialogue: 0,0:13:04.57,0:13:06.24,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:13:06.74,0:13:08.70,Default,,0,0,0,,Сіз мұны айтып тұрсыз ба?
Dialogue: 0,0:13:10.78,0:13:13.75,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:13:13.83,0:13:16.46,Default,,0,0,0,,Эй (Яно), менімен сөйлеспе.
Dialogue: 0,0:13:16.54,0:13:18.79,Default,,0,0,0,,Сіз лас итті пайдаланғыңыз келе ме?
Dialogue: 0,0:13:18.88,0:13:20.25,Default,,0,0,0,,Сіз де пайдалана аласыз ба?
Dialogue: 0,0:13:20.88,0:13:22.80,Default,,0,0,0,,«Егер сіз бірдеңе жасасаңыз, мен сізді өлтіремін».
Dialogue: 0,0:13:22.88,0:13:25.22,Default,,0,0,0,,Бұл блеф емес, есіңізде болсын.
Dialogue: 0,0:13:26.93,0:13:28.26,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:13:28.84,0:13:30.72,Default,,0,0,0,,Сенгоку кезеңінің басы.
Dialogue: 0,0:13:30.80,0:13:31.97,Default,,0,0,0,,Бұл қорқынышты, Ван Ван.
Dialogue: 0,0:13:32.06,0:13:32.89,Default,,0,0,0,,Ах
Dialogue: 0,0:13:32.97,0:13:34.48,Default,,0,0,0,,Ол мұны әкелді, солай ма?
Dialogue: 0,0:13:34.56,0:13:36.06,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:13:36.14,0:13:38.27,Default,,0,0,0,,Бір-біріне ұқсайтындықтан айта аламын (Такеучи)?
Dialogue: 0,0:13:38.94,0:13:39.98,Default,,0,0,0,,Келісімді пайдаланбай-ақ мені одақтасың қыла аласың деп ойладың ғой?
Dialogue: 0,0:13:40.06,0:13:41.98,Default,,0,0,0,,Оны қайтарыңыз (Яно) Жоқ.
Dialogue: 0,0:13:44.44,0:13:45.49,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:13:45.57,0:13:49.20,Default,,0,0,0,,Тадаши, сен формаңмен қайда қыдырдың?
Dialogue: 0,0:13:49.28,0:13:50.66,Default,,0,0,0,,Хмм, сәл күте тұрыңыз...
Dialogue: 0,0:13:50.74,0:13:52.24,Default,,0,0,0,,Жеткізу күтілуде.
Dialogue: 0,0:13:54.12,0:13:55.75,Default,,0,0,0,,Сіз бұрынғы жігітіңізді кездестірдіңіз бе?
Dialogue: 0,0:13:56.79,0:13:59.46,Default,,0,0,0,,Мен сені іздедім.
Dialogue: 0,0:13:59.54,0:14:01.71,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:14:02.55,0:14:05.71,Default,,0,0,0,,Бүгін өзіңмен бірге алып кеткен қыз емес пе?
Dialogue: 0,0:14:05.80,0:14:08.34,Default,,0,0,0,,Ой, бұл қыз емес, бұрынғы қыз.
Dialogue: 0,0:14:08.43,0:14:11.97,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:14:12.05,0:14:13.89,Default,,0,0,0,,Урус (Фумика) Хэхе
Dialogue: 0,0:14:13.97,0:14:15.22,Default,,0,0,0,,Сіз мұны жасайсыз.
Dialogue: 0,0:14:16.64,0:14:17.48,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:14:21.56,0:14:23.40,Default,,0,0,0,,(күшіктің үруі)
Dialogue: 0,0:14:26.69,0:14:28.07,Default,,0,0,0,,Қараңдаршы, бұл ойыншық.
Dialogue: 0,0:14:28.15,0:14:29.95,Default,,0,0,0,,(күшіктің үруі)
Dialogue: 0,0:14:30.57,0:14:32.78,Default,,0,0,0,,Сіз дәретхананы қалай пайдалануды үйрендіңіз, бұл сіздің сыйлығыңыз.
Dialogue: 0,0:14:32.87,0:14:34.83,Default,,0,0,0,,Сізге ұнады ма? (ойыншық дыбысы)
Dialogue: 0,0:14:37.25,0:14:38.83,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:40.04,0:14:41.33,Default,,0,0,0,,Жақсы, онда
Dialogue: 0,0:14:41.42,0:14:42.84,Default,,0,0,0,,Мотохару
Dialogue: 0,0:14:42.92,0:14:44.50,Default,,0,0,0,,Қайтып келдіңіз бе?
Dialogue: 0,0:14:44.59,0:14:46.51,Default,,0,0,0,,Ванна қайнап жатыр, ендеше кіріңіз.
Dialogue: 0,0:14:46.59,0:14:48.22,Default,,0,0,0,,(Ойыншық дыбысы)
Dialogue: 0,0:14:48.76,0:14:51.76,Default,,0,0,0,,А... өтінемін, бүгін итіңізді ваннаға апармаңыз.
Dialogue: 0,0:14:51.84,0:14:52.68,Default,,0,0,0,,Ал, көзіңді жұм.
Dialogue: 0,0:14:52.76,0:14:54.51,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:14:54.60,0:14:57.22,Default,,0,0,0,,О, және мансап таңдау сауалнама қағазы.
Dialogue: 0,0:14:57.31,0:14:58.77,Default,,0,0,0,,Сіз оны рұқсатсыз жібердіңіз.
Dialogue: 0,0:14:58.85,0:15:01.10,Default,,0,0,0,,Ата-аналар бағанасы бос қалды
Dialogue: 0,0:15:01.19,0:15:02.77,Default,,0,0,0,,Менің мансап жолым – менің проблемам, солай ма?
Dialogue: 0,0:15:02.86,0:15:04.98,Default,,0,0,0,,Бұл отбасылық мәселе.
Dialogue: 0,0:15:05.73,0:15:07.69,Default,,0,0,0,,Әкеңе дұрыстап айт.
Dialogue: 0,0:15:13.37,0:15:15.49,Default,,0,0,0,,Ата-ана төлейді.
Dialogue: 0,0:15:16.74,0:15:18.25,Default,,0,0,0,,Тез
Dialogue: 0,0:15:18.33,0:15:20.58,Default,,0,0,0,,Нана-чанды кездестіремін деп үміттенемін.
Dialogue: 0,0:15:20.66,0:15:21.96,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:30.51,0:15:33.43,Default,,0,0,0,,(Сыныптағы шу)
Dialogue: 0,0:15:33.51,0:15:35.85,Default,,0,0,0,,Хмм, осындай нәрсе
Dialogue: 0,0:15:35.93,0:15:37.93,Default,,0,0,0,,Ухаха (ер студент) Бұл ақымақтық.
Dialogue: 0,0:15:38.02,0:15:39.60,Default,,0,0,0,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:15:39.68,0:15:41.44,Default,,0,0,0,,Сіз бұл...
Dialogue: 0,0:15:41.52,0:15:44.44,Default,,0,0,0,,Идиот! (Ер студенттердің күлкісі)
Dialogue: 0,0:15:46.90,0:15:49.40,Default,,0,0,0,,Бұл талант.
Dialogue: 0,0:15:54.45,0:15:55.95,Default,,0,0,0,,Сіз мұны айттыңыз ба?
Dialogue: 0,0:15:56.03,0:15:57.91,Default,,0,0,0,,Мен? Айтпа
Dialogue: 0,0:15:57.99,0:16:01.12,Default,,0,0,0,,(Оқушылардың күлкісі)
Dialogue: 0,0:16:01.21,0:16:04.12,Default,,0,0,0,,Бұл Мауслендке жатпайды.
Dialogue: 0,0:16:07.21,0:16:09.63,Default,,0,0,0,,Баратын уақыт болды ма? (Яно) А.
Dialogue: 0,0:16:10.42,0:16:11.88,Default,,0,0,0,,Қайда бара жатырсыңдар?
Dialogue: 0,0:16:11.97,0:16:14.64,Default,,0,0,0,,Токури Шон (Яно) Токари Шон уақыты!
Dialogue: 0,0:16:14.72,0:16:16.64,Default,,0,0,0,,Күдікті (екі адам күледі)
Dialogue: 0,0:16:16.72,0:16:18.68,Default,,0,0,0,,А, көрсеткі...
Dialogue: 0,0:16:35.78,0:16:37.16,Default,,0,0,0,,Не?
Dialogue: 0,0:16:38.83,0:16:42.71,Default,,0,0,0,,Уф... у...
Dialogue: 0,0:16:42.79,0:16:46.92,Default,,0,0,0,,Өткен күндегі Яноның тышқан жері туралы ұсынысы
Dialogue: 0,0:16:47.00,0:16:50.84,Default,,0,0,0,,Оны комитет қабылдамады.
Dialogue: 0,0:16:50.92,0:16:52.76,Default,,0,0,0,,... А?
Dialogue: 0,0:16:52.84,0:16:55.93,Default,,0,0,0,,Кешіріңіз, бұл жақсы идея болды.
Dialogue: 0,0:16:56.01,0:16:58.97,Default,,0,0,0,,Тінтуір авторлық құқықтарды өте таңдайды.
Dialogue: 0,0:17:00.14,0:17:01.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:01.81,0:17:02.68,Default,,0,0,0,,Иә
Dialogue: 0,0:17:03.73,0:17:04.69,Default,,0,0,0,,үшін осы ма?
Dialogue: 0,0:17:04.77,0:17:07.19,Default,,0,0,0,,Не? Мм... иә
Dialogue: 0,0:17:17.07,0:17:18.37,Default,,0,0,0,,Күту
Dialogue: 0,0:17:18.45,0:17:20.49,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:17:22.12,0:17:23.87,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:17:25.83,0:17:26.67,Default,,0,0,0,,Эй
Dialogue: 0,0:17:26.75,0:17:28.13,Default,,0,0,0,,Егер ол шашын жайып жіберсе
Dialogue: 0,0:17:28.21,0:17:30.42,Default,,0,0,0,,Сіз оны сондай сүйкімді деп ойламайсыз ба?
Dialogue: 0,0:17:30.50,0:17:32.67,Default,,0,0,0,,Иә? (Яно) Сіз олай ойламайсыз ба?
Dialogue: 0,0:17:32.76,0:17:34.47,Default,,0,0,0,,Жоқ, бұл менің қиялым ғана.
Dialogue: 0,0:17:34.55,0:17:36.63,Default,,0,0,0,,ше? (Ер оқушы) Бұл менің қиялым екені сөзсіз.
Dialogue: 0,0:17:36.72,0:17:39.01,Default,,0,0,0,,Бұрынғы киімімді шешіп алған кезім сияқты.
Dialogue: 0,0:17:39.09,0:17:40.64,Default,,0,0,0,,Олардың шаш үлгісі бірдей.
Dialogue: 0,0:17:41.14,0:17:42.89,Default,,0,0,0,,Сіз соған ұмтыласыз ба? Ол жігіт
Dialogue: 0,0:17:43.81,0:17:44.85,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:44.93,0:17:47.35,Default,,0,0,0,,Сабақ үстінде сол басты көргенде, мен шоғырлана алмаймын.
Dialogue: 0,0:17:47.44,0:17:48.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.74,0:17:57.20,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:17:57.28,0:17:58.11,Default,,0,0,0,,Такахаши
Dialogue: 0,0:17:59.03,0:18:00.37,Default,,0,0,0,,Сенің шаруаң жоқ па?
Dialogue: 0,0:18:00.45,0:18:03.04,Default,,0,0,0,,Мм, мм... Мен боядым.
Dialogue: 0,0:18:03.12,0:18:04.95,Default,,0,0,0,,Иә, қазір аяқталды.
Dialogue: 0,0:18:07.92,0:18:08.75,Default,,0,0,0,,Сіз оны алып жүрсіз бе?
Dialogue: 0,0:18:08.83,0:18:10.33,Default,,0,0,0,,А... иә
Dialogue: 0,0:18:10.42,0:18:11.38,Default,,0,0,0,,Маған қарызға бер
Dialogue: 0,0:18:11.46,0:18:13.38,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:18:14.09,0:18:15.26,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:18:17.47,0:18:18.93,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:18:19.01,0:18:21.30,Default,,0,0,0,,Яно биыл өте керемет.
Dialogue: 0,0:18:21.39,0:18:23.22,Default,,0,0,0,,Өткен жылдан мүлде басқаша
Dialogue: 0,0:18:23.31,0:18:25.39,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:18:25.47,0:18:26.98,Default,,0,0,0,,Такахаши
Dialogue: 0,0:18:27.06,0:18:28.73,Default,,0,0,0,,Жұмыс (Нами) Иә
Dialogue: 0,0:18:28.81,0:18:30.40,Default,,0,0,0,,Такахаши аяқтады
Dialogue: 0,0:18:30.48,0:18:31.73,Default,,0,0,0,,Олай болса, бұл.
Dialogue: 0,0:18:31.81,0:18:34.27,Default,,0,0,0,,Такахаши менде бар.
Dialogue: 0,0:18:34.36,0:18:35.48,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:18:35.57,0:18:37.24,Default,,0,0,0,,Такахаши (Нами) Яно
Dialogue: 0,0:18:37.32,0:18:39.66,Default,,0,0,0,,Мен Яноның мотивациясын шынымен де сездім.
Dialogue: 0,0:18:39.74,0:18:42.24,Default,,0,0,0,,Сондықтан мен үлкен жұмысқа кірісуді жөн көрдім.
Dialogue: 0,0:18:44.28,0:18:45.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:48.29,0:18:50.46,Default,,0,0,0,,Иә? Сен Андон тобында емес пе едің?
Dialogue: 0,0:18:52.00,0:18:54.96,Default,,0,0,0,,Шығу? Бұл шығару ма?
Dialogue: 0,0:19:00.05,0:19:05.06,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:19:21.45,0:19:22.91,Default,,0,0,0,,Такеучи мырза
Dialogue: 0,0:19:23.57,0:19:25.33,Default,,0,0,0,,Мен саған суық нәрсе беремін. Иә.
Dialogue: 0,0:19:25.41,0:19:28.45,Default,,0,0,0,,Не? Рахмет, оны сонда қалдырыңыз.
Dialogue: 0,0:19:28.54,0:19:30.54,Default,,0,0,0,,Мен оны саған бердім.
Dialogue: 0,0:19:30.62,0:19:31.46,Default,,0,0,0,,Иии!
Dialogue: 0,0:19:32.08,0:19:34.50,Default,,0,0,0,,Мен тәттілерді іше алмаймын.
Dialogue: 0,0:19:44.34,0:19:45.18,Default,,0,0,0,,Уау (Такеучи) Уау
Dialogue: 0,0:19:45.26,0:19:46.26,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:19:46.35,0:19:47.26,Default,,0,0,0,,Әке шын мәнінде дәрігер емес
Dialogue: 0,0:19:47.35,0:19:48.72,Default,,0,0,0,,О, қантты сусындар
Dialogue: 0,0:19:48.81,0:19:51.48,Default,,0,0,0,,Сіз іше алмайсыз, солай ма? Мен оны сен үшін ішемін.
Dialogue: 0,0:19:51.56,0:19:53.10,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:19:53.19,0:19:55.86,Default,,0,0,0,,Мен кафе командасының мүшесімін және үйде жұмыс істеймін.
Dialogue: 0,0:19:55.94,0:19:57.48,Default,,0,0,0,,Бұл ойын әділ емес.
Dialogue: 0,0:19:57.57,0:20:00.40,Default,,0,0,0,,Сондықтан мектептегі мерекелік жұмыс кезінде жақындауға тыйым салынады.
Dialogue: 0,0:20:00.49,0:20:02.40,Default,,0,0,0,,Сен мені жай ғана жек көрдің.
Dialogue: 0,0:20:02.49,0:20:05.41,Default,,0,0,0,,Кафе ұжымы аулаға не үшін барды?
Dialogue: 0,0:20:05.49,0:20:06.58,Default,,0,0,0,,Нана (2 адам) Ах.
Dialogue: 0,0:20:06.66,0:20:08.41,Default,,0,0,0,,Менің айтатын нәрсем бар.
Dialogue: 0,0:20:08.49,0:20:09.95,Default,,0,0,0,,Эй, жасырын!
Dialogue: 0,0:20:10.70,0:20:12.87,Default,,0,0,0,,Менің әлсірегенімді бірден білемін.
Dialogue: 0,0:20:12.96,0:20:15.63,Default,,0,0,0,,Менің ойымша, Такеучи
Dialogue: 0,0:20:15.71,0:20:19.17,Default,,0,0,0,,Менің ойымша, ол Нананы ұнатады.
Dialogue: 0,0:20:23.51,0:20:25.93,Default,,0,0,0,,Сонымен... осындай нәрсе
Dialogue: 0,0:20:26.01,0:20:28.43,Default,,0,0,0,,Қарап-ақ білуге ​​болады, күңгірт.
Dialogue: 0,0:20:37.52,0:20:41.44,Default,,0,0,0,,Сонымен... Бірақ Такеучи Яноның досы ма?
Dialogue: 0,0:20:41.53,0:20:44.95,Default,,0,0,0,,Мен құрбымның бұрынғы қызына ғашық болып қалмаймын.
Dialogue: 0,0:20:46.53,0:20:50.20,Default,,0,0,0,,Такеучи-кун ондай адам емес.
Dialogue: 0,0:20:55.17,0:20:56.33,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:20:56.42,0:21:00.46,Default,,0,0,0,,Ал... бұлай айтсаң, бұл өте нанымды.
Dialogue: 0,0:21:01.71,0:21:03.17,Default,,0,0,0,,Сонда Яно ше?
Dialogue: 0,0:21:05.26,0:21:08.76,Default,,0,0,0,,Сіз не істемексіз? Мен оны кафе тобына жібердім.
Dialogue: 0,0:21:08.85,0:21:10.93,Default,,0,0,0,,Нанадан үміт үзбейсің бе?
Dialogue: 0,0:21:11.72,0:21:14.43,Default,,0,0,0,,Бір күні қайта бастауды ойлайсыз ба?
Dialogue: 0,0:21:21.07,0:21:21.94,Default,,0,0,0,,Яно...
Dialogue: 0,0:21:36.79,0:21:40.46,Default,,0,0,0,,Осындай нәрсе болған кезде мені мазалайды.
Dialogue: 0,0:21:42.71,0:21:46.01,Default,,0,0,0,,Шынымды айтсам, қалай жауап берерімді білмеймін.
Dialogue: 0,0:21:46.09,0:21:47.68,Default,,0,0,0,,Мені жалғыз қалдырғаныңызды қалаймын
Dialogue: 0,0:21:48.22,0:21:49.43,Default,,0,0,0,,Біраз уақыттан бері
Dialogue: 0,0:21:49.51,0:21:51.72,Default,,0,0,0,,Жалғыз болу
Dialogue: 0,0:21:51.81,0:21:54.22,Default,,0,0,0,,Маған ойлануға уақыт керек
Dialogue: 0,0:22:09.28,0:22:10.20,Default,,0,0,0,,Эй
Dialogue: 0,0:22:43.57,0:22:45.11,Default,,0,0,0,,Бұл үлкен мәселе емес
Dialogue: 0,0:22:46.61,0:22:47.99,Default,,0,0,0,,Бұл үлкен мәселе емес
Dialogue: 0,0:22:49.49,0:22:51.07,Default,,0,0,0,,Қабылданбағанға дейін
Dialogue: 0,0:22:52.03,0:22:53.41,Default,,0,0,0,,Бұл тіпті осырық емес.
Dialogue: 0,0:22:53.49,0:22:55.04,Default,,0,0,0,,Мен де үйрендім
Dialogue: 0,0:22:55.12,0:22:57.16,Default,,0,0,0,,Ештеңе істей алмай кеткен жақсы.
Dialogue: 0,0:22:58.04,0:22:59.46,Default,,0,0,0,,әлдеқайда жақсы
Dialogue: 0,0:23:03.59,0:23:05.25,Default,,0,0,0,,Менің жолым болды
Dialogue: 0,0:23:06.05,0:23:06.96,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:23:10.47,0:23:11.43,Default,,0,0,0,,Өйткені мен жеңілмеймін
Dialogue: 0,0:23:35.66,0:23:40.66,Default,,0,0,0,,♪～
Dialogue: 0,0:25:00.87,0:25:05.87,Default,,0,0,0,,～♪
Dialogue: 0,0:25:09.67,0:25:10.55,Default,,0,0,0,,Екеуміз ажырассақ та
Dialogue: 0,0:25:10.63,0:25:12.38,Default,,0,0,0,,Мен сені ренжіткім келмейді
Dialogue: 0,0:25:12.46,0:25:14.17,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:25:15.13,0:25:16.26,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:25:16.34,0:25:17.84,Default,,0,0,0,,Бұл менің құрбым.
Dialogue: 0,0:25:17.93,0:25:19.97,Default,,0,0,0,,Өтінемін, бұлай етпеңіз.
Dialogue: 0,0:25:20.43,0:25:21.26,Default,,0,0,0,,Мектептен шығарылу үшін қажет найзағайлар: 7 қалды
Dialogue: 0,0:25:22.47,0:25:24.73,Default,,0,0,0,,Өлген адамды ұмыта аласыз ба?
Dialogue: 0,0:25:25.27,0:25:26.65,Default,,0,0,0,,Оны есте қалдырыңыз
Dialogue: 0,0:25:28.10,0:25:29.44,Default,,0,0,0,,Кім жылап жатыр?
Dialogue: 0,0:25:29.52,0:25:31.69,Default,,0,0,0,,Кім күледі?
Dialogue: 0,0:25:33.19,0:25:39.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
