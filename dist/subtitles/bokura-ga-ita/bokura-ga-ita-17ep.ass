Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.50,0:00:03.96,Default,,0,0,0,,Шарттар қолданылады.
Dialogue: 0,0:00:04.54,0:00:07.59,Default,,0,0,0,,Нана-санның оқиғасын айтып берейін...
Dialogue: 0,0:00:09.13,0:00:13.01,Default,,0,0,0,,Мен Нана туралы ештеңе білмеймін.
Dialogue: 0,0:00:14.63,0:00:18.26,Default,,0,0,0,,Яноның Нана-санға деген сезімін мұқият тыңдаңыз.
Dialogue: 0,0:00:19.64,0:00:22.14,Default,,0,0,0,,Егер мен өзімді ұйымдастыра алсам
Dialogue: 0,0:00:23.23,0:00:28.15,Default,,0,0,0,,Мүмкін мен Яномен тіл табыса алармын.
Dialogue: 0,0:00:31.15,0:00:36.16,Default,,0,0,0,,♪～
Dialogue: 0,0:01:57.03,0:02:01.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:02.53,0:02:04.91,Default,,0,0,0,,(бормен жазу дыбысы)
Dialogue: 0,0:02:24.56,0:02:27.31,Default,,0,0,0,,Яно Әлі біткен жоқ.
Dialogue: 0,0:02:30.40,0:02:32.31,Default,,0,0,0,,Такахаши, үйге қайт.
Dialogue: 0,0:02:32.40,0:02:34.32,Default,,0,0,0,,О~
Dialogue: 0,0:02:35.53,0:02:37.90,Default,,0,0,0,,Мм... бүгінгі комитет
Dialogue: 0,0:02:37.99,0:02:39.74,Default,,0,0,0,,О~ мені тастап кетті
Dialogue: 0,0:02:43.20,0:02:45.12,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:02:45.74,0:02:48.12,Default,,0,0,0,,Біз әлі танысуды бастауды шешкен жоқпыз.
Dialogue: 0,0:02:48.96,0:02:50.12,Default,,0,0,0,,Сіз түсінесіз деп ойлаймын.
Dialogue: 0,0:02:51.00,0:02:52.38,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:02:53.08,0:02:55.88,Default,,0,0,0,,Қайсысы жақсы, сенбі ме, жексенбі ме?
Dialogue: 0,0:02:55.96,0:02:56.96,Default,,0,0,0,,Екеуі де!
Dialogue: 0,0:02:57.46,0:03:00.13,Default,,0,0,0,,Олай болса, сенбі күні сағат 11-де вокзал алдында.
Dialogue: 0,0:03:02.64,0:03:03.85,Default,,0,0,0,,Бұл күн емес.
Dialogue: 0,0:03:04.55,0:03:05.85,Default,,0,0,0,,Иә
Dialogue: 0,0:03:09.43,0:03:10.60,Default,,0,0,0,,Уши
Dialogue: 0,0:03:13.19,0:03:16.48,Default,,0,0,0,,Осындай бақытты жүзді көргенде өзімді сондай бақытты сезінемін.
Dialogue: 0,0:03:16.57,0:03:18.28,Default,,0,0,0,,Мен жынды болып бара жатырмын
Dialogue: 0,0:03:26.37,0:03:27.29,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:03:27.37,0:03:28.70,Default,,0,0,0,,Гарн және...
Dialogue: 0,0:03:28.79,0:03:30.33,Default,,0,0,0,,Бетке жазылған
Dialogue: 0,0:03:31.54,0:03:33.58,Default,,0,0,0,,Менің ойымша, сіз мұны білесіз, бірақ...
Dialogue: 0,0:03:33.67,0:03:34.71,Default,,0,0,0,,Бұл күн емес.
Dialogue: 0,0:03:34.79,0:03:35.75,Default,,0,0,0,,Және бумен пісірілген тәтті картоп.
Dialogue: 0,0:03:35.84,0:03:36.79,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:03:36.88,0:03:38.09,Default,,0,0,0,,Сіз шынымен түсінесіз бе?
Dialogue: 0,0:03:38.17,0:03:39.01,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:03:39.76,0:03:43.34,Default,,0,0,0,,Біз кездессек, менікі болады деп ойладың ба?
Dialogue: 0,0:03:45.05,0:03:48.60,Default,,0,0,0,,Ойланып қарасаңыз, біртүрлі нәрсе болған болуы мүмкін.
Dialogue: 0,0:03:48.68,0:03:51.23,Default,,0,0,0,,Мен: «Нана-санның оқиғасын айтып берші» дедім.
Dialogue: 0,0:03:52.56,0:03:56.23,Default,,0,0,0,,Мен бұл әдіс жұмыс істей ме деп алаңдаймын...
Dialogue: 0,0:03:57.90,0:04:00.24,Default,,0,0,0,,Менің артық айтатын сөзім жоқ деп ойлаймын.
Dialogue: 0,0:04:00.32,0:04:04.74,Default,,0,0,0,,Мен онымен орта мектептің екінші курсында қыста кездесіп, орта мектептің үшінші жылының жазында оқыс оқиғаға байланысты екеуміз айырылысып қалдық.
Dialogue: 0,0:04:05.53,0:04:06.66,Default,,0,0,0,,Мен сен тұрған жерге дүрлігіп барамын
Dialogue: 0,0:04:07.33,0:04:11.75,Default,,0,0,0,,Сіз бұл оқиғадан нені анықтауыңыз керек?
Dialogue: 0,0:04:13.83,0:04:17.34,Default,,0,0,0,,Бұлай деп нені айтасың?
Dialogue: 0,0:04:18.38,0:04:19.84,Default,,0,0,0,,Көз алдыңызда
Dialogue: 0,0:04:19.92,0:04:23.93,Default,,0,0,0,,Такахаши мен Нананы теңізге лақтырып, суға батып кетсін.
Dialogue: 0,0:04:24.01,0:04:26.18,Default,,0,0,0,,Алдымен кімге көмектесу керек?
Dialogue: 0,0:04:26.26,0:04:29.10,Default,,0,0,0,,Мен осындай түсінікті әдіс болғанын қалаймын.
Dialogue: 0,0:04:32.64,0:04:34.94,Default,,0,0,0,,Түсінуге оңай әдіс…
Dialogue: 0,0:04:35.90,0:04:38.73,Default,,0,0,0,,Әйтеуір, тамақ ішейік.
Dialogue: 0,0:04:38.82,0:04:40.82,Default,,0,0,0,,Ах, Викинг мұнда.
Dialogue: 0,0:04:44.11,0:04:45.57,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:04:46.45,0:04:49.16,Default,,0,0,0,,Менің ойымша, сіз растауға тырысып жатырсыз ...
Dialogue: 0,0:04:49.24,0:04:50.08,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:04:50.16,0:04:52.54,Default,,0,0,0,,Яноның сезімі...
Dialogue: 0,0:04:52.62,0:04:54.08,Default,,0,0,0,,Хмм... Рахмет.
Dialogue: 0,0:04:59.38,0:05:00.38,Default,,0,0,0,,Не?
Dialogue: 0,0:05:00.46,0:05:01.30,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:01.38,0:05:04.67,Default,,0,0,0,,Мен оның суреті бар деп ешқашан ойламаппын.
Dialogue: 0,0:05:04.76,0:05:06.38,Default,,0,0,0,,Мен оны сағындым.
Dialogue: 0,0:05:06.47,0:05:08.05,Default,,0,0,0,,Өзіңіз қалағандай жасаңыз.
Dialogue: 0,0:05:08.14,0:05:10.26,Default,,0,0,0,,Ах, Яно, бұл дұрыс емес.
Dialogue: 0,0:05:10.35,0:05:11.47,Default,,0,0,0,,Не?
Dialogue: 0,0:05:15.35,0:05:16.81,Default,,0,0,0,,Яно қайда орналасқан?
Dialogue: 0,0:05:18.27,0:05:21.15,Default,,0,0,0,,Сізде Такахаши Яноның тұсқағаз суреті бар ма?
Dialogue: 0,0:05:21.23,0:05:22.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:22.15,0:05:24.32,Default,,0,0,0,,Юкатадағы, мен мұны бұрын жасағанмын.
Dialogue: 0,0:05:24.40,0:05:26.15,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:05:26.78,0:05:28.41,Default,,0,0,0,,Бұл көп екен, иә?
Dialogue: 0,0:05:28.49,0:05:29.41,Default,,0,0,0,,Аз ғана.
Dialogue: 0,0:05:29.49,0:05:32.95,Default,,0,0,0,,Іс жақсы болса, мен саған сыйлық беремін.
Dialogue: 0,0:05:33.04,0:05:34.25,Default,,0,0,0,,Сіз...
Dialogue: 0,0:05:34.33,0:05:36.29,Default,,0,0,0,,Сіз оны жойдым деп айтпадыңыз ба?
Dialogue: 0,0:05:36.37,0:05:39.00,Default,,0,0,0,,Қанша сұрасам да, «Жоқ» деп айтпадың ба?
Dialogue: 0,0:05:39.08,0:05:40.50,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:05:42.59,0:05:43.46,Default,,0,0,0,,Не?
Dialogue: 0,0:05:43.55,0:05:46.80,Default,,0,0,0,,Ой... жоқ, ештеңе.
Dialogue: 0,0:05:48.18,0:05:50.93,Default,,0,0,0,,Ойланып қарашы, неге тұсқағазды өшірдің?
Dialogue: 0,0:05:51.01,0:05:52.01,Default,,0,0,0,,Е...
Dialogue: 0,0:05:54.10,0:05:55.06,Default,,0,0,0,,Өтінемін…
Dialogue: 0,0:05:55.14,0:05:57.64,Default,,0,0,0,,Годзилла? А, Такеши Гота?
Dialogue: 0,0:05:57.73,0:05:59.44,Default,,0,0,0,,Гоуко... (Яно) Барасың ба?
Dialogue: 0,0:05:59.52,0:06:00.61,Default,,0,0,0,,Мен тамақтанып жатырмын.
Dialogue: 0,0:06:00.69,0:06:01.61,Default,,0,0,0,,Топтың күні?
Dialogue: 0,0:06:03.69,0:06:06.03,Default,,0,0,0,,«Махаббат★Кон»? (Нами) Топтық кездесу.
Dialogue: 0,0:06:06.11,0:06:08.49,Default,,0,0,0,,Бас мердігер? (Нами) Иә... мен топтық кездесуге бардым.
Dialogue: 0,0:06:08.57,0:06:10.32,Default,,0,0,0,,Сункон? (Нами) Мен сенбеймін.
Dialogue: 0,0:06:10.41,0:06:12.91,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:06:12.99,0:06:15.50,Default,,0,0,0,,Түсіндірейін...
Dialogue: 0,0:06:15.58,0:06:18.08,Default,,0,0,0,,«Мен сені күтемін» деген сияқты сөздерді айтып, соқыр кездесуге барасыз ба?
Dialogue: 0,0:06:18.16,0:06:19.54,Default,,0,0,0,,Жоқ, бұл жай ғана болды...
Dialogue: 0,0:06:19.62,0:06:20.46,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:06:20.54,0:06:22.21,Default,,0,0,0,,Ши... шілде?
Dialogue: 0,0:06:22.29,0:06:24.13,Default,,0,0,0,,О, бұл өте ерте.
Dialogue: 0,0:06:24.21,0:06:25.71,Default,,0,0,0,,Жоқ, сондықтан мен өзімді...
Dialogue: 0,0:06:25.80,0:06:28.17,Default,,0,0,0,,Менен басқа қыз тапқыңыз келді ме?
Dialogue: 0,0:06:29.97,0:06:30.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:32.60,0:06:35.39,Default,,0,0,0,,Жоқ... бұл дұрыс емес.
Dialogue: 0,0:06:35.47,0:06:39.19,Default,,0,0,0,,Мен сенен басқа әйелді көрмеймін.
Dialogue: 0,0:06:45.15,0:06:47.82,Default,,0,0,0,,Яно мені сүйреп апарады
Dialogue: 0,0:06:48.95,0:06:51.53,Default,,0,0,0,,Мен бүгін үйге барамын.
Dialogue: 0,0:06:52.57,0:06:55.20,Default,,0,0,0,,Бүгін де Нана-сан туралы айта алмайтын сияқтымын.
Dialogue: 0,0:06:55.70,0:06:58.70,Default,,0,0,0,,Осыдан кейін әдеттегі кездесуге барсақ ше?
Dialogue: 0,0:06:58.79,0:06:59.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:00.21,0:07:02.58,Default,,0,0,0,,Мен Нана туралы айттым.
Dialogue: 0,0:07:02.67,0:07:06.42,Default,,0,0,0,,Шын мәнінде, Такахаши үшін мұндай шарттар бар
Dialogue: 0,0:07:06.50,0:07:09.59,Default,,0,0,0,,Менің ойымша, сіз оған сізді кешіруге мүмкіндік бергіңіз келді⸺
Dialogue: 0,0:07:10.68,0:07:11.68,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:07:13.68,0:07:17.81,Default,,0,0,0,,Неліктен өз сезімдеріңіз туралы шыншыл болуға тырыспайсыз?
Dialogue: 0,0:07:21.02,0:07:22.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:22.52,0:07:25.90,Default,,0,0,0,,Сезіммен жүгірсең де, сәтсіздікке ұшырайсың.
Dialogue: 0,0:07:31.86,0:07:36.24,Default,,0,0,0,,Негізі Нанаға әуес болған бұрынғы жігіт емес.
Dialogue: 0,0:07:37.12,0:07:39.04,Default,,0,0,0,,Менің ойымша, бұл Такахаши.
Dialogue: 0,0:07:52.93,0:07:57.10,Default,,0,0,0,,Сенім болмаса, мүмкін болатын ештеңе болмайды.
Dialogue: 0,0:08:03.23,0:08:04.94,Default,,0,0,0,,Мына бамбук ше?
Dialogue: 0,0:08:05.02,0:08:06.40,Default,,0,0,0,,Мен қайтып келдім (Яно) Иә?
Dialogue: 0,0:08:06.48,0:08:07.61,Default,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:08:07.69,0:08:09.53,Default,,0,0,0,,Бұл Яноның кінәсі
Dialogue: 0,0:08:10.19,0:08:12.61,Default,,0,0,0,,Өйткені Яно менімен дұрыс сөйлеспейді.
Dialogue: 0,0:08:12.70,0:08:15.24,Default,,0,0,0,,Біз не үшін кездестік деп ойлайсыңдар?
Dialogue: 0,0:08:20.66,0:08:24.37,Default,,0,0,0,,Бүгін барғыңыз келетін жер бар ма?
Dialogue: 0,0:08:30.30,0:08:31.71,Default,,0,0,0,,Қайта оралуыңмен!
Dialogue: 0,0:08:31.80,0:08:34.09,Default,,0,0,0,,Тез орындайық.
Dialogue: 0,0:08:34.18,0:08:35.43,Default,,0,0,0,,Шырын
Dialogue: 0,0:08:35.51,0:08:37.43,Default,,0,0,0,,Көңіліңді түсірме, Таке-чан
Dialogue: 0,0:08:37.51,0:08:40.60,Default,,0,0,0,,Сіз оны түсіруге қалай батылсыз...
Dialogue: 0,0:08:40.68,0:08:43.02,Default,,0,0,0,,Жарайды, ауыр сөз айтпа.
Dialogue: 0,0:08:43.10,0:08:45.35,Default,,0,0,0,,Жұбату кешін өткізейік.
Dialogue: 0,0:08:45.44,0:08:47.52,Default,,0,0,0,,Біз достарға мән береміз!
Dialogue: 0,0:08:48.36,0:08:50.40,Default,,0,0,0,,Мен мұны айта аламын ба? Мен мұны айта аламын ба?
Dialogue: 0,0:08:50.48,0:08:52.90,Default,,0,0,0,,Мен кіммін? Мен кіммін?
Dialogue: 0,0:08:52.99,0:08:57.11,Default,,0,0,0,,Негізі осыны мектепте бір бала маған биыл екі рет айтты.
Dialogue: 0,0:08:57.20,0:08:58.20,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:08:58.28,0:09:00.16,Default,,0,0,0,,Неліктен біз араласпадық?
Dialogue: 0,0:09:00.24,0:09:02.83,Default,,0,0,0,,Мені ұнатпасаң, менімен кездесе алмайсың.
Dialogue: 0,0:09:03.33,0:09:05.41,Default,,0,0,0,,Танысып көріңіз және бір-біріңізге ғашық болыңыз.
Dialogue: 0,0:09:05.92,0:09:10.84,Default,,0,0,0,,Мен мұны істей алсам, мен оны күштеп алып кетемін... бірақ...
Dialogue: 0,0:09:10.92,0:09:14.55,Default,,0,0,0,,Өйткені, екеуі де бір бетте.
Dialogue: 0,0:09:14.63,0:09:18.22,Default,,0,0,0,,Өзара сезімдер жақсы естіледі.
Dialogue: 0,0:09:18.30,0:09:19.55,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:09:22.01,0:09:23.77,Default,,0,0,0,,Чибимиге не болды?
Dialogue: 0,0:09:23.85,0:09:25.60,Default,,0,0,0,,Себебі мен ренжідім
Dialogue: 0,0:09:25.69,0:09:27.31,Default,,0,0,0,,Ол мені аздап мазақ етті.
Dialogue: 0,0:09:28.27,0:09:29.98,Default,,0,0,0,,Өткен жазғы фестиваль
Dialogue: 0,0:09:30.06,0:09:32.57,Default,,0,0,0,,Мен түпнұсқаны қатты іздедім.
Dialogue: 0,0:09:33.07,0:09:34.57,Default,,0,0,0,,Менің тынысым тарылды
Dialogue: 0,0:09:37.61,0:09:40.78,Default,,0,0,0,,Мен болсам, іздеуге рұқсат етпес едім.
Dialogue: 0,0:09:41.99,0:09:46.91,Default,,0,0,0,,Мен әрқашан Такахаши мені іздегенше табамын.
Dialogue: 0,0:09:52.96,0:09:54.76,Default,,0,0,0,,Бұл қажет емес
Dialogue: 0,0:09:57.22,0:09:59.26,Default,,0,0,0,,Мүмкін бас тартуға әлі ерте шығар?
Dialogue: 0,0:10:01.05,0:10:04.02,Default,,0,0,0,,Дұрыс айтасыңдар, бәрібір балалар.
Dialogue: 0,0:10:04.10,0:10:06.48,Default,,0,0,0,,Менің ойымша, ол маған қарағанда өз жағында.
Dialogue: 0,0:10:08.31,0:10:09.81,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:10:09.90,0:10:10.73,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:11.31,0:10:13.90,Default,,0,0,0,,Әйелсіз оның жақсылығы жоқ.
Dialogue: 0,0:10:14.78,0:10:17.78,Default,,0,0,0,,Сіз әйелдің қолдауын қажет ететін адамсыз ба?
Dialogue: 0,0:10:17.86,0:10:19.20,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:10:19.78,0:10:23.70,Default,,0,0,0,,Әрқашан қорғауға тиіс нәрсені қажет ететін тип.
Dialogue: 0,0:10:24.20,0:10:27.20,Default,,0,0,0,,Нені қорғау керек? Бұл не? Бұл сондай әурешілік.
Dialogue: 0,0:10:27.29,0:10:29.08,Default,,0,0,0,,Онсыз оңайырақ.
Dialogue: 0,0:10:29.17,0:10:30.50,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:10:30.58,0:10:33.96,Default,,0,0,0,,Адамдар қорғайтын бірдеңесі болған кезде ең қауіпсіз болады.
Dialogue: 0,0:10:34.05,0:10:38.30,Default,,0,0,0,,Алайда оның хабары бар ма, білмеймін.
Dialogue: 0,0:10:38.38,0:10:41.68,Default,,0,0,0,,Ол негізінен әйелдерге сенбейді.
Dialogue: 0,0:10:42.35,0:10:45.68,Default,,0,0,0,,Ең қиыны да осы болса керек.
Dialogue: 0,0:10:45.77,0:10:50.35,Default,,0,0,0,,Иә? Мен орта мектептің 1 курсында оқитынмын. Анасы қайта үйленді.
Dialogue: 0,0:10:50.44,0:10:51.44,Default,,0,0,0,,Бірінші неке
Dialogue: 0,0:10:52.27,0:10:56.94,Default,,0,0,0,,Менің қазіргі әкем - анасының бірінші некесі.
Dialogue: 0,0:11:03.95,0:11:06.79,Default,,0,0,0,,Жетер, менде бүгін таңдау жоқ.
Dialogue: 0,0:11:07.29,0:11:09.00,Default,,0,0,0,,Бұл қалыпты күн.
Dialogue: 0,0:11:09.50,0:11:10.71,Default,,0,0,0,,Мен киімімді ауыстыра аламын ба?
Dialogue: 0,0:11:10.79,0:11:12.29,Default,,0,0,0,,Мен осында күтемін.
Dialogue: 0,0:11:12.38,0:11:13.96,Default,,0,0,0,,Жарайды, мен бірден қайтамын.
Dialogue: 0,0:11:15.59,0:11:18.30,Default,,0,0,0,,Мен Яноның үйіне келдім.
Dialogue: 0,0:11:18.38,0:11:20.17,Default,,0,0,0,,Бірақ бұл тек бүгінге арналған
Dialogue: 0,0:11:21.30,0:11:23.05,Default,,0,0,0,,Та-да!
Dialogue: 0,0:11:23.14,0:11:25.43,Default,,0,0,0,,Не, ит алдың ба?
Dialogue: 0,0:11:25.51,0:11:27.68,Default,,0,0,0,,Иә, қандай?
Dialogue: 0,0:11:27.77,0:11:29.52,Default,,0,0,0,,Мен білмеймін. Бұл гибрид, солай ма?
Dialogue: 0,0:11:29.60,0:11:31.44,Default,,0,0,0,,Өйткені оны Такено тастап кеткен.
Dialogue: 0,0:11:32.31,0:11:33.31,Default,,0,0,0,,(күшіктің үруі)
Dialogue: 0,0:11:33.85,0:11:35.40,Default,,0,0,0,,Үлкен! Сіз семіз бе?
Dialogue: 0,0:11:35.48,0:11:36.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:36.40,0:11:37.90,Default,,0,0,0,,Бұл шынымен бірдей ит пе?
Dialogue: 0,0:11:37.98,0:11:39.82,Default,,0,0,0,,Тіпті иттер де өседі, солай ма?
Dialogue: 0,0:11:41.32,0:11:43.20,Default,,0,0,0,,О, мен ақымақ
Dialogue: 0,0:11:43.28,0:11:46.03,Default,,0,0,0,,Мен абайсызда, абайсызда итпен дос болып кеттім.
Dialogue: 0,0:11:46.58,0:11:47.79,Default,,0,0,0,,Аты кім?
Dialogue: 0,0:11:48.58,0:11:50.08,Default,,0,0,0,,Ла… (Нанами) Ла?
Dialogue: 0,0:11:52.75,0:11:53.62,Default,,0,0,0,,Лара
Dialogue: 0,0:11:53.71,0:11:57.34,Default,,0,0,0,,Лара? Бұл сүйкімді есім. Бұл қыз.
Dialogue: 0,0:11:58.75,0:12:02.84,Default,,0,0,0,,Яно әке болатын сияқты, таң қалдырады.
Dialogue: 0,0:12:02.93,0:12:04.76,Default,,0,0,0,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:12:04.84,0:12:06.51,Default,,0,0,0,,Жоқ, әйтеуір
Dialogue: 0,0:12:06.60,0:12:09.47,Default,,0,0,0,,Дәлірек айтсақ, осы уақытқа дейін
Dialogue: 0,0:12:09.56,0:12:12.64,Default,,0,0,0,,Мен сізді өте үйсіз деп ойладым.
Dialogue: 0,0:12:12.73,0:12:17.23,Default,,0,0,0,,Менің арманым үш бала мен үлкен ит болу.
Dialogue: 0,0:12:17.31,0:12:19.69,Default,,0,0,0,,Бұл балабақшада баскетбол голы бар жылы үй.
Dialogue: 0,0:12:22.65,0:12:26.37,Default,,0,0,0,,Үш бала...Бір бала жақсы деп ойлаймын.
Dialogue: 0,0:12:26.45,0:12:28.24,Default,,0,0,0,,Не? Бұл жақсы емес
Dialogue: 0,0:12:28.33,0:12:31.87,Default,,0,0,0,,Жалғыз болсаңыз, ойнайтын ешкіміңіз болмайды, сондықтан бар күшімізді салайық!
Dialogue: 0,0:12:31.95,0:12:36.08,Default,,0,0,0,,Жақсы, кем дегенде екі адам жақсы, бір ұл, бір қыз.
Dialogue: 0,0:12:36.17,0:12:38.25,Default,,0,0,0,,Жоқ, екі адам болуы керек.
Dialogue: 0,0:12:38.34,0:12:42.67,Default,,0,0,0,,Мен Яноға үйленетін сияқты емеспін.
Dialogue: 0,0:12:45.68,0:12:46.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.39,0:12:50.18,Default,,0,0,0,,Мен жаман болдым
Dialogue: 0,0:12:52.93,0:12:56.35,Default,,0,0,0,,Екі еркек болса, әкесі сыртта болса да
Dialogue: 0,0:12:56.44,0:12:58.15,Default,,0,0,0,,Менің аулап ойнайтын адамым бар.
Dialogue: 0,0:13:06.57,0:13:09.70,Default,,0,0,0,,Мен әкеммен ешқашан ештеңе істеген емеспін.
Dialogue: 0,0:13:10.83,0:13:12.62,Default,,0,0,0,,Әкем туралы естеліктерім
Dialogue: 0,0:13:13.37,0:13:15.75,Default,,0,0,0,,Анамнан естігенімнің бәрі
Dialogue: 0,0:13:16.50,0:13:18.63,Default,,0,0,0,,Олар мені туылғаннан кейін көп ұзамай өлді деді.
Dialogue: 0,0:13:19.88,0:13:21.71,Default,,0,0,0,,Жас кезіндегі ауру
Dialogue: 0,0:13:22.42,0:13:26.68,Default,,0,0,0,,Яно алғаш рет әкесі туралы айтады
Dialogue: 0,0:13:29.05,0:13:31.35,Default,,0,0,0,,Спортшы және жүзгіш
Dialogue: 0,0:13:31.85,0:13:35.68,Default,,0,0,0,,Студент кезіңізде Хоккайдо турнирінде рекорд орнатқансыз.
Dialogue: 0,0:13:36.19,0:13:38.19,Default,,0,0,0,,Қайта-қайта тыңдау
Dialogue: 0,0:13:38.73,0:13:40.36,Default,,0,0,0,,Мен оны елестеттім
Dialogue: 0,0:13:40.94,0:13:43.40,Default,,0,0,0,,Мен көрмеген әке бейнесі
Dialogue: 0,0:13:43.48,0:13:44.82,Default,,0,0,0,,(Лараның қабығы)
Dialogue: 0,0:13:46.28,0:13:49.99,Default,,0,0,0,,4-сыныпта оқып жүргенімде анамнан сұрағаным осы еді.
Dialogue: 0,0:13:53.08,0:13:57.58,Default,,0,0,0,,Әкеңнің суреті жоқ па? Маған әкеңнің түрін көрсет
Dialogue: 0,0:13:58.83,0:14:00.04,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:14:02.25,0:14:04.09,Default,,0,0,0,,Айнаға қараңыз
Dialogue: 0,0:14:05.67,0:14:10.93,Default,,0,0,0,,Міне, менің әкем. 10 жасымда әкем.
Dialogue: 0,0:14:12.85,0:14:15.14,Default,,0,0,0,,Мотохару әкесіне ұқсайды
Dialogue: 0,0:14:15.22,0:14:19.77,Default,,0,0,0,,Көңілді, бұзық, ақылды, сымбатты.
Dialogue: 0,0:14:21.31,0:14:26.03,Default,,0,0,0,,Олар жыл өткен сайын таң қалдырарлықтай ұқсас бола бастады.
Dialogue: 0,0:14:28.86,0:14:33.20,Default,,0,0,0,,Әкем менің бойым менімен бірдей екенін үнемі айтып отыратын.
Dialogue: 0,0:14:33.28,0:14:34.41,Default,,0,0,0,,Екі ыдыс?
Dialogue: 0,0:14:34.49,0:14:37.66,Default,,0,0,0,,Е, мен оны көргім келеді! Мен оны көргім келді
Dialogue: 0,0:14:37.75,0:14:41.04,Default,,0,0,0,,Өйткені бұл Яноның ересек адамдағы түрі.
Dialogue: 0,0:14:41.13,0:14:41.96,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:14:42.04,0:14:43.79,Default,,0,0,0,,Не? Шынымен бе?
Dialogue: 0,0:14:44.30,0:14:47.17,Default,,0,0,0,,Фотосурет болды ма? қалай болды?
Dialogue: 0,0:14:47.26,0:14:49.43,Default,,0,0,0,,Мен шынымен түсінбедім
Dialogue: 0,0:14:51.26,0:14:52.43,Default,,0,0,0,,Ей, кеттік!
Dialogue: 0,0:14:52.51,0:14:53.55,Default,,0,0,0,,(Лараның қабығы)
Dialogue: 0,0:15:02.35,0:15:06.73,Default,,0,0,0,,Ах, рахмет. Сен әкелдің. Бұл тамаша.
Dialogue: 0,0:15:07.78,0:15:11.74,Default,,0,0,0,,Аа, менің телефон нөмірім жазылған тақтайша бар.
Dialogue: 0,0:15:12.28,0:15:13.37,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:15:14.99,0:15:16.58,Default,,0,0,0,,Лара... сұлулық?
Dialogue: 0,0:15:26.80,0:15:29.21,Default,,0,0,0,,Менің кеудем ауырады...
Dialogue: 0,0:15:31.72,0:15:32.55,Default,,0,0,0,,Қайтару
Dialogue: 0,0:15:32.64,0:15:33.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:33.55,0:15:35.89,Default,,0,0,0,,Бүгін бұдан былай тұрудың қажеті жоқ.
Dialogue: 0,0:15:38.97,0:15:40.56,Default,,0,0,0,,Мен сені аялдамаға апарамын.
Dialogue: 0,0:15:41.52,0:15:42.77,Default,,0,0,0,,Егер көп болса
Dialogue: 0,0:15:43.56,0:15:45.52,Default,,0,0,0,,Мен жеңілуге жақынмын
Dialogue: 0,0:15:55.62,0:15:57.03,Default,,0,0,0,,Не?
Dialogue: 0,0:15:57.12,0:15:59.87,Default,,0,0,0,,Қол... байлау керек емес пе?
Dialogue: 0,0:16:00.66,0:16:02.58,Default,,0,0,0,,Бұл жақсы болмайды.
Dialogue: 0,0:16:04.63,0:16:07.88,Default,,0,0,0,,Сонымен... поцелу?
Dialogue: 0,0:16:07.96,0:16:09.09,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:16:13.13,0:16:14.01,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:16:18.14,0:16:19.56,Default,,0,0,0,,Қоштасуда қол алысу
Dialogue: 0,0:16:23.56,0:16:25.31,Default,,0,0,0,,Мен шығармын
Dialogue: 0,0:16:26.44,0:16:28.23,Default,,0,0,0,,Яноны мазақ ету
Dialogue: 0,0:16:29.65,0:16:34.45,Default,,0,0,0,,Біреуден жалтарып, қаскөйлік жасап, оның алдында жемді бұлғау сияқты.
Dialogue: 0,0:16:36.45,0:16:38.99,Default,,0,0,0,,Менің сенімім жеткіліксіз болғандықтан...
Dialogue: 0,0:16:39.99,0:16:41.25,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:49.71,0:16:52.92,Default,,0,0,0,,Бүгін... Рахмет
Dialogue: 0,0:17:03.89,0:17:07.69,Default,,0,0,0,,Әртүрлі адамдардың сөздері ойға оралады
Dialogue: 0,0:17:08.19,0:17:10.82,Default,,0,0,0,,Бірінен соң бірі қалқып, бірінен соң бірі ғайып болады
Dialogue: 0,0:17:12.19,0:17:15.99,Default,,0,0,0,,Мен сенімді емес ештеңе жоқ.
Dialogue: 0,0:17:19.12,0:17:22.08,Default,,0,0,0,,Ниет пен эмоция екі түрлі нәрсе
Dialogue: 0,0:17:23.04,0:17:26.17,Default,,0,0,0,,Менің сезімім ғана біледі
Dialogue: 0,0:17:27.25,0:17:29.17,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:17:30.75,0:17:31.75,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:17:33.34,0:17:35.13,Default,,0,0,0,,Сену сезімі
Dialogue: 0,0:17:36.68,0:17:38.89,Default,,0,0,0,,Ерік күші қажет...
Dialogue: 0,0:17:42.31,0:17:45.73,Default,,0,0,0,,Яно I...
Dialogue: 0,0:17:47.73,0:17:49.27,Default,,0,0,0,,Қарама-қайшы
Dialogue: 0,0:18:08.92,0:18:12.00,Default,,0,0,0,,Аа, Мотохару, дұрыс жерде.
Dialogue: 0,0:18:12.09,0:18:13.92,Default,,0,0,0,,Сіз маған кастрюльді алып бере аласыз ба?
Dialogue: 0,0:18:14.00,0:18:14.92,Default,,0,0,0,,Оны білмейсің бе? Картаға қара!
Dialogue: 0,0:18:15.01,0:18:17.51,Default,,0,0,0,,Бұл Фелисит Парментье
Dialogue: 0,0:18:17.59,0:18:18.84,Default,,0,0,0,,...
Dialogue: 0,0:18:18.93,0:18:20.93,Default,,0,0,0,,Жазда ақшыл гүлдері бар.
Dialogue: 0,0:18:21.01,0:18:22.22,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:18:22.30,0:18:25.14,Default,,0,0,0,,Ауыр... қайда қою керек?
Dialogue: 0,0:18:25.22,0:18:27.39,Default,,0,0,0,,Констанс Спрайдың жанында
Dialogue: 0,0:18:27.48,0:18:28.64,Default,,0,0,0,,Қарсы... Қарсы?
Dialogue: 0,0:18:28.73,0:18:29.94,Default,,0,0,0,,Сол жерде көтерілді
Dialogue: 0,0:18:30.52,0:18:31.77,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:30.52,0:18:31.77,Default,,0,0,0,,(Тостағанды қою дыбысы)
Dialogue: 0,0:18:33.27,0:18:35.23,Default,,0,0,0,,Білмей тұрып мынандай аркам бар еді.
Dialogue: 0,0:18:35.73,0:18:36.90,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:18:36.99,0:18:39.78,Default,,0,0,0,,Көктем келгенде алқызыл раушан гүлдері бірден осында болады.
Dialogue: 0,0:18:43.49,0:18:45.24,Default,,0,0,0,,Түс сияқты емес
Dialogue: 0,0:18:46.08,0:18:49.12,Default,,0,0,0,,Ммм... бұл мені қыжылдайды.
Dialogue: 0,0:18:50.25,0:18:52.92,Default,,0,0,0,,Бұрынғыдай сөйлемейсің.
Dialogue: 0,0:18:54.92,0:18:57.26,Default,,0,0,0,,Бастауыш мектепте оқып жүрген кезіңізде болдыңыз
Dialogue: 0,0:18:57.84,0:18:59.80,Default,,0,0,0,,Өте сөйлегіш
Dialogue: 0,0:19:00.97,0:19:02.93,Default,,0,0,0,,Мектептен қайтып келгенде
Dialogue: 0,0:19:03.01,0:19:06.77,Default,,0,0,0,,Сен маған бүгін болған оқиғаның бәрін айтып бердің.
Dialogue: 0,0:19:11.40,0:19:12.98,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:19:16.53,0:19:17.65,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:19:18.82,0:19:20.40,Default,,0,0,0,,Мен енді ғана ересек болдым.
Dialogue: 0,0:19:22.82,0:19:24.74,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:19:41.84,0:19:45.89,Default,,0,0,0,,Менің әкем суда жүзумен айналысқан және орта мектептің біріншілігінде бірінші орынды жеңіп алған.
Dialogue: 0,0:19:47.81,0:19:50.85,Default,,0,0,0,,Сондықтан мен де әкем сияқты жүзуші боламын.
Dialogue: 0,0:19:50.93,0:19:52.73,Default,,0,0,0,,Бірақ сен некесіз баласың.
Dialogue: 0,0:19:52.81,0:19:55.81,Default,,0,0,0,,Некесіз бала дегеніміз не? шұжық?
Dialogue: 0,0:19:55.90,0:20:00.11,Default,,0,0,0,,Мұғалім! Яно мен басқалары тағы ұрысып жатыр.
Dialogue: 0,0:20:01.45,0:20:02.86,Default,,0,0,0,,Жарайды, сен қалай ойлайсың?
Dialogue: 0,0:20:01.45,0:20:02.86,Default,,0,0,0,,(тоқтату дыбысы)
Dialogue: 0,0:20:04.28,0:20:05.12,Default,,0,0,0,,Хмм…
Dialogue: 0,0:20:05.95,0:20:07.70,Default,,0,0,0,,Ол өспейді...
Dialogue: 0,0:20:13.08,0:20:14.12,Default,,0,0,0,,Эй
Dialogue: 0,0:20:14.21,0:20:18.05,Default,,0,0,0,,Неліктен сіріңке алдында айнаға қарап отырасың?
Dialogue: 0,0:20:18.13,0:20:19.67,Default,,0,0,0,,Джинкс немесе бір нәрсе ме?
Dialogue: 0,0:20:19.76,0:20:21.51,Default,,0,0,0,,Рухани бірлік
Dialogue: 0,0:20:23.88,0:20:25.84,Default,,0,0,0,,Көңіліңізді түсірмеңіз
Dialogue: 0,0:20:26.68,0:20:29.26,Default,,0,0,0,,Мен жаңа жеке рекорд орнаттым.
Dialogue: 0,0:20:30.52,0:20:31.77,Default,,0,0,0,,Жарайсыңдар
Dialogue: 0,0:20:32.81,0:20:34.52,Default,,0,0,0,,1-орынға ие болмадым.
Dialogue: 0,0:20:34.60,0:20:36.27,Default,,0,0,0,,Бұл екінші орын емес, тамаша.
Dialogue: 0,0:20:38.36,0:20:39.73,Default,,0,0,0,,Көңілің қалмады ма?
Dialogue: 0,0:20:39.82,0:20:43.32,Default,,0,0,0,,Амал жоқ, мақтаншақ балам.
Dialogue: 0,0:20:46.62,0:20:50.41,Default,,0,0,0,,Мотохару Мен ауруханаға бара жатырмын. Асығыңыз және дайындалыңыз.
Dialogue: 0,0:20:50.49,0:20:52.25,Default,,0,0,0,,Балалар сендер үйге қайтыңдар
Dialogue: 0,0:20:52.33,0:20:54.25,Default,,0,0,0,,Не? Бірдеңе болды ма?
Dialogue: 0,0:20:54.33,0:20:56.96,Default,,0,0,0,,Бәлкім, мен саған өткен күні барған шығармын.
Dialogue: 0,0:20:57.04,0:20:59.42,Default,,0,0,0,,Анамның жақын досының науқас күйеуі
Dialogue: 0,0:21:06.51,0:21:07.76,Default,,0,0,0,,Уау
Dialogue: 0,0:21:07.84,0:21:09.18,Default,,0,0,0,,Жақсылап қараңызшы
Dialogue: 0,0:21:09.76,0:21:12.22,Default,,0,0,0,,Қаңқаға ұқсайды және жиіркенішті
Dialogue: 0,0:21:12.31,0:21:14.10,Default,,0,0,0,,Бүгін ғана, маған жақсылап қараңызшы.
Dialogue: 0,0:21:14.73,0:21:17.56,Default,,0,0,0,,Өйткені ол сенің... әкең.
Dialogue: 0,0:21:29.16,0:21:31.79,Default,,0,0,0,,Ол сенің анаңның досының күйеуі ғой, солай ма?
Dialogue: 0,0:21:35.21,0:21:37.58,Default,,0,0,0,,Сонымен, мен Мичико апайдың баласымын ба?
Dialogue: 0,0:21:37.67,0:21:39.08,Default,,0,0,0,,Менің балам
Dialogue: 0,0:21:42.38,0:21:43.76,Default,,0,0,0,,Мотохару
Dialogue: 0,0:21:46.05,0:21:48.93,Default,,0,0,0,,Мама, мен үйленгім келетін адам бар ма?
Dialogue: 0,0:21:49.01,0:21:53.56,Default,,0,0,0,,Мотохару осы жас шамасында болғандықтан, оған әлі де әке керек емес пе?
Dialogue: 0,0:21:57.14,0:22:02.15,Default,,0,0,0,,♪～
Dialogue: 0,0:22:20.67,0:22:21.79,Default,,0,0,0,,Неге...
Dialogue: 0,0:22:24.88,0:22:26.97,Default,,0,0,0,,Сіз шынымен не қалайсыз
Dialogue: 0,0:22:27.05,0:22:29.63,Default,,0,0,0,,Менің көз алдымнан үнемі өтіп жатқан шығар.
Dialogue: 0,0:22:41.40,0:22:45.53,Default,,0,0,0,,Қалғанымды қаласаңыз, кете аласыз.
Dialogue: 0,0:22:47.11,0:22:50.49,Default,,0,0,0,,Ұнамаймын деп ойласаңыз да, солай бола береді
Dialogue: 0,0:22:52.12,0:22:53.24,Default,,0,0,0,,(электрондық поштаны жіберу дыбысы)
Dialogue: 0,0:22:56.91,0:22:58.83,Default,,0,0,0,,Үміт әрқашан орындалады
Dialogue: 0,0:23:00.04,0:23:03.00,Default,,0,0,0,,Сәттілік ұзаққа бармайды
Dialogue: 0,0:23:03.63,0:23:06.71,Default,,0,0,0,,Өмір әрқашан ойлағандай бола бермейді.
Dialogue: 0,0:23:07.71,0:23:08.88,Default,,0,0,0,,(Пошта қабылдау дыбысы)
Dialogue: 0,0:23:08.88,0:23:09.72,Default,,0,0,0,,(Пошта қабылдау дыбысы)
Dialogue: 0,0:23:08.88,0:23:09.72,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:23:13.93,0:23:17.52,Default,,0,0,0,,Егер сәттілік бақытсыздыққа айналса
Dialogue: 0,0:23:20.23,0:23:23.94,Default,,0,0,0,,Мүмкін, сәтсіздік сәттілікке айналуы мүмкін.
Dialogue: 0,0:23:26.36,0:23:27.78,Default,,0,0,0,,Оған сеніңіз...
Dialogue: 0,0:23:29.24,0:23:30.36,Default,,0,0,0,,Өмір сүру
Dialogue: 0,0:23:32.28,0:23:33.28,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:25:07.00,0:25:08.38,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:25:08.46,0:25:11.05,Default,,0,0,0,,Яно маған қатты ұнады деп ойлаймын!
Dialogue: 0,0:25:11.13,0:25:13.47,Default,,0,0,0,,Осы уақытқа дейін өкінетініңізге сенімдімін!
Dialogue: 0,0:25:13.55,0:25:14.63,Default,,0,0,0,,Мен Яноны артта қалдырғаным.
Dialogue: 0,0:25:14.72,0:25:16.55,Default,,0,0,0,,Мен қатты өкінемін!
Dialogue: 0,0:25:16.64,0:25:19.72,Default,,0,0,0,,Мен Яноны өле-өлгенше мұңайтқаным үшін өкінемін!
Dialogue: 0,0:25:20.22,0:25:22.22,Default,,0,0,0,,Мен қазір де сенімдімін...
Dialogue: 0,0:25:23.48,0:25:26.23,Default,,0,0,0,,Мен Яноны көктен бақылайтын боламын!
Dialogue: 0,0:25:27.48,0:25:29.36,Default,,0,0,0,,Мен сені бақытты ете алмаймын...
Dialogue: 0,0:25:30.69,0:25:31.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:25:31.82,0:25:35.90,Default,,0,0,0,,～♪
Dialogue: 0,0:25:37.40,0:25:43.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
