Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.80,0:00:15.34,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:00:15.43,0:00:18.64,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:00:18.72,0:00:22.43,Default,,0,0,0,,(Гуанлунның ырылдауы)
Dialogue: 0,0:00:24.44,0:00:27.77,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:30.78,0:00:31.78,Default,,0,0,0,,Ах
Dialogue: 0,0:00:36.74,0:00:38.45,Default,,0,0,0,,Оны тек сен ғана көресің
Dialogue: 0,0:00:39.28,0:00:42.20,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:43.71,0:00:46.46,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:00:59.64,0:01:00.85,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:09.65,0:01:10.86,Default,,0,0,0,,Я...
Dialogue: 0,0:01:11.36,0:01:12.36,Default,,0,0,0,,Ах
Dialogue: 0,0:01:13.19,0:01:14.32,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:01:15.45,0:01:16.28,Default,,0,0,0,,Уф
Dialogue: 0,0:01:18.99,0:01:20.83,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:01:22.87,0:01:24.25,Default,,0,0,0,,Гуу
Dialogue: 0,0:01:29.71,0:01:32.80,Default,,0,0,0,,Уф аа
Dialogue: 0,0:01:34.84,0:01:35.72,Default,,0,0,0,,Бұл жігіт жебеуші бола ма?
Dialogue: 0,0:01:35.80,0:01:38.43,Default,,0,0,0,,«Kaebuki Tsuyu» әріптерін сұрақ қойып шығара алмаймын
Dialogue: 0,0:01:38.51,0:01:43.60,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:51.48,0:01:56.49,Default,,0,0,0,,♪～
Dialogue: 0,0:02:46.74,0:02:51.75,Default,,0,0,0,,～♪
Dialogue: 0,0:02:53.25,0:02:54.92,Default,,0,0,0,,Мисечан
Dialogue: 0,0:02:55.00,0:02:58.80,Default,,0,0,0,,Осы айда жұмысқа байланысты бізде бірнеше ішімдік тойлары болды.
Dialogue: 0,0:02:58.88,0:03:01.47,Default,,0,0,0,,Келесі айдың қалта ақшасын алдын ала қарызға алайын.
Dialogue: 0,0:03:01.55,0:03:04.89,Default,,0,0,0,,Мури! Бұл жалақы күніне дейін
Dialogue: 0,0:03:04.97,0:03:08.47,Default,,0,0,0,,Мұны қандай да бір жолмен басқарыңыз.
Dialogue: 0,0:03:08.56,0:03:10.18,Default,,0,0,0,,Бұл да қиын.
Dialogue: 0,0:03:10.27,0:03:12.35,Default,,0,0,0,,Бағалар тез өсуде.
Dialogue: 0,0:03:12.44,0:03:15.82,Default,,0,0,0,,Жалақыңыз сәл көтерілмей ме?
Dialogue: 0,0:03:16.48,0:03:19.19,Default,,0,0,0,,Бұл құлдырауды ескере отырып, бұл мүмкін емес еді.
Dialogue: 0,0:03:19.28,0:03:20.53,Default,,0,0,0,,Я...
Dialogue: 0,0:03:20.61,0:03:21.40,Default,,0,0,0,,(Күнбағыс дауысы)
Dialogue: 0,0:03:21.40,0:03:24.99,Default,,0,0,0,,(Күнбағыс дауысы)
Dialogue: 0,0:03:21.40,0:03:24.99,Default,,0,0,0,,Сыртта ыстық болса да, дүние салқын.
Dialogue: 0,0:03:25.07,0:03:26.41,Default,,0,0,0,,Шынымен
Dialogue: 0,0:03:26.49,0:03:30.50,Default,,0,0,0,,Шинносуке мен басқалары есейгенде не болады екен...
Dialogue: 0,0:03:30.58,0:03:32.96,Default,,0,0,0,,Мен болашаққа алаңдаймын.
Dialogue: 0,0:03:33.96,0:03:36.88,Default,,0,0,0,,Ересек адамдар хентай болып табылады.
Dialogue: 0,0:03:36.96,0:03:40.34,Default,,0,0,0,,Олай десеңіз, қиын... А?
Dialogue: 0,0:03:43.38,0:03:45.76,Default,,0,0,0,,Жоқ... бұл қандай көрінеді?
Dialogue: 0,0:03:45.85,0:03:49.97,Default,,0,0,0,,Бүгін жазғы демалыс басталады, мен қатты толқып тұрмын!
Dialogue: 0,0:03:50.06,0:03:51.73,Default,,0,0,0,,♪ Жазғы демалыс
Dialogue: 0,0:03:51.81,0:03:54.69,Default,,0,0,0,,Ах... Шинноске, кешіріңіз.
Dialogue: 0,0:03:54.77,0:03:57.44,Default,,0,0,0,,Маған компаниямда жоба жетекшісі болу жауапкершілігі жүктелді.
Dialogue: 0,0:03:57.52,0:04:00.90,Default,,0,0,0,,Осы жазда мен сені ешқайда апара алмайтын шығармын.
Dialogue: 0,0:04:00.99,0:04:02.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:02.45,0:04:06.20,Default,,0,0,0,,Менің 5 жасымда өмірде бір рет болатын жазғы демалыс болса да?
Dialogue: 0,0:04:06.28,0:04:08.37,Default,,0,0,0,,Мен жағажайға барып, отшашуды көргім келеді.
Dialogue: 0,0:04:08.45,0:04:10.83,Default,,0,0,0,,Мен қателерді ұстап, барбекю алғым келеді!
Dialogue: 0,0:04:10.91,0:04:13.08,Default,,0,0,0,,Сол себепті кешірім сұраймын
Dialogue: 0,0:04:13.16,0:04:15.63,Default,,0,0,0,,Бұл туралы не істеуім керек?
Dialogue: 0,0:04:15.71,0:04:19.46,Default,,0,0,0,,Ах~ Балабақшадағы үй тапсырмасына арналған суретті күнделік.
Dialogue: 0,0:04:19.55,0:04:22.47,Default,,0,0,0,,Олай болса, үйге көмектесіп, күнделігіңе жазу туралы не айтасың?
Dialogue: 0,0:04:22.55,0:04:25.43,Default,,0,0,0,,Көмек беру бұрынғыдай!
Dialogue: 0,0:04:25.51,0:04:27.89,Default,,0,0,0,,Сіз мұны үнемі жасай бермейсіз, солай ма?
Dialogue: 0,0:04:27.97,0:04:32.35,Default,,0,0,0,,Бұл жағдайда мен Нанако-оне-санмен соба кеспесін жеймін.
Dialogue: 0,0:04:33.89,0:04:35.56,Default,,0,0,0,,Нанакоға барайық
Dialogue: 0,0:04:35.65,0:04:37.52,Default,,0,0,0,,Иә, Шинносуке-сан.
Dialogue: 0,0:04:43.65,0:04:45.36,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:04:46.20,0:04:48.07,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:04:48.74,0:04:51.24,Default,,0,0,0,,Бұл асығыстық емес, қашып кету.
Dialogue: 0,0:04:51.33,0:04:55.08,Default,,0,0,0,,Нанако-чан, сенің осы жазда шетелге қонақ үйге баратыныңды естідім.
Dialogue: 0,0:04:55.16,0:04:56.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:58.71,0:05:01.92,Default,,0,0,0,,Оланың 5-ші жылының жазы аяқталды...
Dialogue: 0,0:05:02.01,0:05:03.38,Default,,0,0,0,,О, бұл қауіпті.
Dialogue: 0,0:05:02.01,0:05:03.38,Default,,0,0,0,,Уақыт таңғы 8 болды.
Dialogue: 0,0:05:03.38,0:05:04.42,Default,,0,0,0,,Уақыт таңғы 8 болды.
Dialogue: 0,0:05:04.51,0:05:05.97,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,0:05:06.05,0:05:08.18,Default,,0,0,0,,Иә, абай болыңыз.
Dialogue: 0,0:05:08.26,0:05:09.35,Default,,0,0,0,,Aiai~
Dialogue: 0,0:05:10.14,0:05:12.81,Default,,0,0,0,,Широға тамақ беріңіз.
Dialogue: 0,0:05:12.89,0:05:16.06,Default,,0,0,0,,Біреуден бірдеңе сұрау деген осы ма?
Dialogue: 0,0:05:16.14,0:05:18.27,Default,,0,0,0,,(Камино) Санатоның тәттілері де дәл солай —
Dialogue: 0,0:05:18.35,0:05:21.73,Default,,0,0,0,,Ол қазірдің өзінде балалармен дөрекі.
Dialogue: 0,0:05:21.82,0:05:23.19,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:05:23.28,0:05:25.82,Default,,0,0,0,,Широ Гохандазо
Dialogue: 0,0:05:26.70,0:05:27.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:28.61,0:05:31.16,Default,,0,0,0,,Не, серуендеп жатырсың ба?
Dialogue: 0,0:05:35.46,0:05:37.58,Default,,0,0,0,,Happy-чан, қазір кеттік.
Dialogue: 0,0:05:37.67,0:05:39.75,Default,,0,0,0,,- (Ит) Бір! -Кун
Dialogue: 0,0:05:41.25,0:05:42.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:52.81,0:05:53.68,Default,,0,0,0,,Кун
Dialogue: 0,0:06:02.65,0:06:03.57,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:04.44,0:06:06.03,Default,,0,0,0,,Кун
Dialogue: 0,0:06:12.08,0:06:14.95,Default,,0,0,0,,Сіз жолға түсесіз, сондықтан кетіңіз.
Dialogue: 0,0:06:15.04,0:06:16.25,Default,,0,0,0,,Мүмкін емес~
Dialogue: 0,0:06:16.33,0:06:20.79,Default,,0,0,0,,Ей, мен осы жазда балдырдай тербеліп өтемін.
Dialogue: 0,0:06:20.88,0:06:24.88,Default,,0,0,0,,Көмек болмас, әкем де жұмыста.
Dialogue: 0,0:06:24.96,0:06:26.76,Default,,0,0,0,,Эй, шеш.
Dialogue: 0,0:06:26.84,0:06:28.55,Default,,0,0,0,,Жоқ, аң.
Dialogue: 0,0:06:28.63,0:06:29.76,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:06:29.84,0:06:31.39,Default,,0,0,0,,Токиода салынған
Dialogue: 0,0:06:31.47,0:06:33.47,Default,,0,0,0,,Әлемнің түкпір-түкпірінен назар аудару —
Dialogue: 0,0:06:33.55,0:06:35.26,Default,,0,0,0,,Дино аралы Жапония
Dialogue: 0,0:06:35.35,0:06:36.85,Default,,0,0,0,,Ашылу салтанаты
Dialogue: 0,0:06:36.93,0:06:38.73,Default,,0,0,0,,Жақында
Dialogue: 0,0:06:38.81,0:06:39.77,Default,,0,0,0,,Торап пен реле қосылған.
Dialogue: 0,0:06:39.77,0:06:40.69,Default,,0,0,0,,Торап пен реле қосылған.
Dialogue: 0,0:06:39.77,0:06:40.69,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:06:41.31,0:06:43.11,Default,,0,0,0,,Толқу туралы не айтасыз?
Dialogue: 0,0:06:41.31,0:06:43.11,Default,,0,0,0,,Ах, нағыз динозаврлар бар ойын-сауық саябағы.
Dialogue: 0,0:06:43.11,0:06:44.86,Default,,0,0,0,,Ах, нағыз динозаврлар бар ойын-сауық саябағы.
Dialogue: 0,0:06:44.94,0:06:46.65,Default,,0,0,0,,Бірақ мен сене алмаймын.
Dialogue: 0,0:06:56.12,0:07:00.33,Default,,0,0,0,,Бүгін әлем тарихы өзгеруде.
Dialogue: 0,0:07:03.71,0:07:05.63,Default,,0,0,0,,I, Bubble Одорохи,
Dialogue: 0,0:07:05.71,0:07:10.84,Default,,0,0,0,,Біз динозаврларды қазіргі заманға қайтара алдық!
Dialogue: 0,0:07:12.64,0:07:14.51,Default,,0,0,0,,Шындық болса, ғажап болар еді.
Dialogue: 0,0:07:14.60,0:07:18.93,Default,,0,0,0,,Бұдан былай сіз міндетті түрде осылай ойлайсыз.
Dialogue: 0,0:07:19.56,0:07:22.15,Default,,0,0,0,,«Сену мүмкін емес!»
Dialogue: 0,0:07:22.23,0:07:24.56,Default,,0,0,0,,Unmica Bubbly дегеніміз не?
Dialogue: 0,0:07:24.65,0:07:26.40,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:07:26.48,0:07:29.86,Default,,0,0,0,,Мен бұл керемет ғажайып сияқты сезінемін.
Dialogue: 0,0:07:30.95,0:07:31.82,Default,,0,0,0,,Олай болса
Dialogue: 0,0:07:32.53,0:07:34.78,Default,,0,0,0,,３ ２…
Dialogue: 0,0:07:35.41,0:07:36.74,Default,,0,0,0,,１！
Dialogue: 0,0:07:37.58,0:07:39.25,Default,,0,0,0,,Уф уаа
Dialogue: 0,0:07:40.45,0:07:43.21,Default,,0,0,0,,Дайнозавр!
Dialogue: 0,0:07:45.50,0:07:48.13,Default,,0,0,0,,Керемет шытырман оқиғаға барайық
Dialogue: 0,0:07:48.21,0:07:50.76,Default,,0,0,0,,-Е, өтірік -Уау, ғажап!
Dialogue: 0,0:07:50.84,0:07:53.09,Default,,0,0,0,,Менің де барғым келеді
Dialogue: 0,0:07:53.18,0:07:55.55,Default,,0,0,0,,Динозаврлар қозғалуда
Dialogue: 0,0:07:55.64,0:07:58.93,Default,,0,0,0,,Бұл стегозавр ма?
Dialogue: 0,0:08:00.31,0:08:03.19,Default,,0,0,0,,Брахиозавр жапырақтарды жейді
Dialogue: 0,0:08:03.27,0:08:05.65,Default,,0,0,0,,Тамақтануды автобустың ішінен сезінуге болады.
Dialogue: 0,0:08:05.73,0:08:07.86,Default,,0,0,0,,Ой... Уау.
Dialogue: 0,0:08:07.94,0:08:10.82,Default,,0,0,0,,Мен... тамақтанып жатырмын. Керемет.
Dialogue: 0,0:08:10.90,0:08:12.45,Default,,0,0,0,,Анчоус көпіршігі!
Dialogue: 0,0:08:12.53,0:08:14.99,Default,,0,0,0,,Сенгісіз Даттеба!
Dialogue: 0,0:08:17.74,0:08:19.37,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:08:19.45,0:08:22.04,Default,,0,0,0,,Қазіргі заманда динозаврлар өмірге қайта оралды.
Dialogue: 0,0:08:22.12,0:08:23.58,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:08:23.66,0:08:26.13,Default,,0,0,0,,Мен Тиранозавр рексімен танысқым келеді
Dialogue: 0,0:08:26.21,0:08:29.17,Default,,0,0,0,,Бұл ең күшті және ең керемет
Dialogue: 0,0:08:29.25,0:08:31.67,Default,,0,0,0,,Мен брахиозаврмын.
Dialogue: 0,0:08:31.76,0:08:33.76,Default,,0,0,0,,Сол әсем көрініс
Dialogue: 0,0:08:33.84,0:08:38.47,Default,,0,0,0,,Динозаврлар қорқынышты, бірақ Стегозавр сүйкімді, солай емес пе?
Dialogue: 0,0:08:38.55,0:08:40.43,Default,,0,0,0,,Көбелек~
Dialogue: 0,0:08:40.51,0:08:43.02,Default,,0,0,0,,Маған темпура ыдысы ұнайды.
Dialogue: 0,0:08:43.10,0:08:45.98,Default,,0,0,0,,Олай десеңіз, бұл птеранодон.
Dialogue: 0,0:08:46.98,0:08:48.52,Default,,0,0,0,,Бо Чан ше?
Dialogue: 0,0:08:49.02,0:08:50.90,Default,,0,0,0,,Навакоцератоптар
Dialogue: 0,0:08:50.98,0:08:51.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:52.07,0:08:53.86,Default,,0,0,0,,Бо-чан, баяу жүр.
Dialogue: 0,0:08:54.45,0:08:56.57,Default,,0,0,0,,Навакоцератоптар
Dialogue: 0,0:08:56.66,0:08:59.28,Default,,0,0,0,,Бұл жылдамдық мәселесі емес.
Dialogue: 0,0:08:59.37,0:09:04.12,Default,,0,0,0,,Бор дәуірінің соңғы кезеңінде өмір сүрген трицератоптар тұқымдасының өкілі.
Dialogue: 0,0:09:04.21,0:09:05.37,Default,,0,0,0,,Я~
Dialogue: 0,0:09:05.46,0:09:07.83,Default,,0,0,0,,Бо Чан, сен динозаврлар туралы көп білесің.
Dialogue: 0,0:09:07.92,0:09:10.17,Default,,0,0,0,,Мен толқыған кезде
Dialogue: 0,0:09:10.25,0:09:11.84,Default,,0,0,0,,Мен бара алмаймын.
Dialogue: 0,0:09:11.92,0:09:16.30,Default,,0,0,0,,Дино аралы екі жыл бұрын толық брондалған сияқты.
Dialogue: 0,0:09:18.18,0:09:19.22,Default,,0,0,0,,Я...
Dialogue: 0,0:09:22.31,0:09:23.64,Default,,0,0,0,,Құрметті Шин~
Dialogue: 0,0:09:23.72,0:09:25.60,Default,,0,0,0,,Әй, Ай Чан!
Dialogue: 0,0:09:27.40,0:09:31.27,Default,,0,0,0,,Ертең менімен Дино аралына барғың келе ме?
Dialogue: 0,0:09:31.36,0:09:32.65,Default,,0,0,0,,Иә!?
Dialogue: 0,0:09:32.73,0:09:34.74,Default,,0,0,0,,А, барғым келеді, барғым келеді.
Dialogue: 0,0:09:34.82,0:09:37.32,Default,,0,0,0,,Суотоме отбасы да демеуші болып табылады.
Dialogue: 0,0:09:37.41,0:09:40.41,Default,,0,0,0,,Билеттер тегін.
Dialogue: 0,0:09:40.49,0:09:44.12,Default,,0,0,0,,Керемет! Мен Ай Чанмен Дино аралына бара аламын.
Dialogue: 0,0:09:44.20,0:09:47.08,Default,,0,0,0,,Мен Масаоды шақырған жоқпын.
Dialogue: 0,0:09:47.16,0:09:47.79,Default,,0,0,0,,Жақсы, сіз бақыттысыз.
Dialogue: 0,0:09:47.79,0:09:48.75,Default,,0,0,0,,Жақсы, сіз бақыттысыз.
Dialogue: 0,0:09:47.79,0:09:48.75,Default,,0,0,0,,Күтпеген даму
Dialogue: 0,0:09:48.75,0:09:48.83,Default,,0,0,0,,Күтпеген даму
Dialogue: 0,0:09:48.83,0:09:49.79,Default,,0,0,0,,Күтпеген даму
Dialogue: 0,0:09:48.83,0:09:49.79,Default,,0,0,0,,-Оны асыға күт -Тірі болғаныма қуаныштымын
Dialogue: 0,0:09:49.79,0:09:50.92,Default,,0,0,0,,-Оны асыға күт -Тірі болғаныма қуаныштымын
Dialogue: 0,0:09:51.00,0:09:53.88,Default,,0,0,0,,Жоқ, мені шақыратын жалғыз адам – Шин-сама...
Dialogue: 0,0:09:53.96,0:09:56.59,Default,,0,0,0,,Біз сізге де дайындаймыз.
Dialogue: 0,0:09:56.67,0:09:59.05,Default,,0,0,0,,-Эхехехе... -(Казама-кун) Жарайды!
Dialogue: 0,0:09:59.14,0:10:01.51,Default,,0,0,0,,Ngg…
Dialogue: 0,0:10:06.73,0:10:09.19,Default,,0,0,0,,На... не?
Dialogue: 0,0:10:09.77,0:10:10.69,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:10.77,0:10:12.02,Default,,0,0,0,,Энн!
Dialogue: 0,0:10:12.11,0:10:13.61,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,0:10:14.98,0:10:15.90,Default,,0,0,0,,Энн!
Dialogue: 0,0:10:15.99,0:10:17.15,Default,,0,0,0,,На?
Dialogue: 0,0:10:19.28,0:10:20.57,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:10:23.66,0:10:25.33,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:26.83,0:10:28.25,Default,,0,0,0,,Кун
Dialogue: 0,0:10:30.83,0:10:32.46,Default,,0,0,0,,Эх Шинносуке
Dialogue: 0,0:10:32.54,0:10:35.13,Default,,0,0,0,,Сіз Дино аралына бара аласыз ба?
Dialogue: 0,0:10:35.21,0:10:37.84,Default,,0,0,0,,Ай Чан мені алып кетейін деп жатыр.
Dialogue: 0,0:10:37.92,0:10:39.30,Default,,0,0,0,,Бұл мен алған кітапша.
Dialogue: 0,0:10:39.38,0:10:40.68,Default,,0,0,0,,О
Dialogue: 0,0:10:41.34,0:10:46.18,Default,,0,0,0,,Бұл тамаша. Бұл жұмыста қызу тақырып.
Dialogue: 0,0:10:51.40,0:10:55.69,Default,,0,0,0,,Нағыз динозаврларды көруге болатын керемет саябақ
Dialogue: 0,0:10:55.78,0:10:58.19,Default,,0,0,0,,Сіздің келуіңізді асыға күтеміз.
Dialogue: 0,0:10:58.28,0:10:59.65,Default,,0,0,0,,Кім? бұл адам
Dialogue: 0,0:10:59.74,0:11:02.87,Default,,0,0,0,,О, сіз Hyper Event продюсерісіз бе?
Dialogue: 0,0:11:03.53,0:11:05.62,Default,,0,0,0,,Шинносуке дүниеге келмес бұрын
Dialogue: 0,0:11:05.70,0:11:09.62,Default,,0,0,0,,Ол әлем бойынша түрлі іс-шараларды ұйымдастыратын атақты адам.
Dialogue: 0,0:11:09.71,0:11:11.83,Default,,0,0,0,,Нөлдік гравитациялық рамен саябағы
Dialogue: 0,0:11:11.92,0:11:14.25,Default,,0,0,0,,Идея жаңашыл, солай емес пе?
Dialogue: 0,0:11:14.34,0:11:17.05,Default,,0,0,0,,Мен олардың динозаврларды қайтарып жатқанына сене алмаймын.
Dialogue: 0,0:11:17.13,0:11:19.51,Default,,0,0,0,,Ертеңгі күнді толық рахаттаныңыз.
Dialogue: 0,0:11:19.59,0:11:20.76,Default,,0,0,0,,Хохой
Dialogue: 0,0:11:20.84,0:11:23.05,Default,,0,0,0,,Түскі асты Суотоме отбасы қамтыды.
Dialogue: 0,0:11:23.14,0:11:26.22,Default,,0,0,0,,Үш жұлдызды аспаз жасаған бентоға ұқсайды.
Dialogue: 0,0:11:27.77,0:11:30.14,Default,,0,0,0,,Уау... қандай қызғаныш
Dialogue: 0,0:11:30.23,0:11:32.19,Default,,0,0,0,,Жемесең, төмендетемін.
Dialogue: 0,0:11:32.27,0:11:33.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:34.40,0:11:36.90,Default,,0,0,0,,Мақсат... Ең жақсыны мақсат ет
Dialogue: 0,0:11:37.61,0:11:38.98,Default,,0,0,0,,Кун
Dialogue: 0,0:11:44.70,0:11:48.16,Default,,0,0,0,,Дино аралына қош келдіңіз
Dialogue: 0,0:11:48.24,0:11:50.54,Default,,0,0,0,,Бүгін барлығын бағыттаңыз—
Dialogue: 0,0:11:51.87,0:11:52.87,Default,,0,0,0,,Бұл Анджела.
Dialogue: 0,0:11:52.96,0:11:55.29,Default,,0,0,0,,Уау Анджела-чан
Dialogue: 0,0:11:55.38,0:11:57.59,Default,,0,0,0,,Ола Шинносуке Нохара 5 жаста
Dialogue: 0,0:11:57.67,0:11:59.26,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:11:57.67,0:11:59.26,Default,,0,0,0,,Хикивариге қарағанда кішкентай наттоны жақсы көретін тип...
Dialogue: 0,0:11:59.26,0:11:59.34,Default,,0,0,0,,Хикивариге қарағанда кішкентай наттоны жақсы көретін тип...
Dialogue: 0,0:11:59.34,0:12:01.22,Default,,0,0,0,,Хикивариге қарағанда кішкентай наттоны жақсы көретін тип...
Dialogue: 0,0:11:59.34,0:12:01.22,Default,,0,0,0,,...
Dialogue: 0,0:12:01.30,0:12:02.88,Default,,0,0,0,,Серіктес ретінде
Dialogue: 0,0:12:02.97,0:12:05.68,Default,,0,0,0,,Маған жауапты болу арнайы тағайындалды.
Dialogue: 0,0:12:05.76,0:12:07.89,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:12:07.97,0:12:10.64,Default,,0,0,0,,Әпке, сіз шынымен де кереметсіз бе?
Dialogue: 0,0:12:11.68,0:12:14.06,Default,,0,0,0,,Динозаврлар туралы сұрақтарыңыз болса
Dialogue: 0,0:12:14.15,0:12:15.60,Default,,0,0,0,,Менен кез келген нәрсені сұраңыз
Dialogue: 0,0:12:15.69,0:12:16.81,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:12:16.90,0:12:18.77,Default,,0,0,0,,Иә, онда сіз.
Dialogue: 0,0:12:18.86,0:12:22.11,Default,,0,0,0,,Ора ғашық па?
Dialogue: 0,0:12:22.19,0:12:23.32,Default,,0,0,0,,А...
Dialogue: 0,0:12:23.40,0:12:25.99,Default,,0,0,0,,Құрмаға қайсысы жақсы, теңіз немесе тау?
Dialogue: 0,0:12:26.07,0:12:28.95,Default,,0,0,0,,Сіздің сүйікті адамыңыз сіз байланыста болғыңыз келетін адам түрі ме?
Dialogue: 0,0:12:29.03,0:12:32.00,Default,,0,0,0,,Сіз динозаврлар туралы айтып отырсыз ба?
Dialogue: 0,0:12:34.04,0:12:35.42,Default,,0,0,0,,Уау
Dialogue: 0,0:12:35.50,0:12:36.96,Default,,0,0,0,,Хаха Яй!
Dialogue: 0,0:12:37.04,0:12:38.17,Default,,0,0,0,,Иә
Dialogue: 0,0:12:38.25,0:12:39.88,Default,,0,0,0,,Иә
Dialogue: 0,0:12:41.05,0:12:42.38,Default,,0,0,0,,Иә
Dialogue: 0,0:12:42.47,0:12:43.34,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:12:43.42,0:12:45.80,Default,,0,0,0,,-Тамаша -Керемет
Dialogue: 0,0:12:48.35,0:12:51.27,Default,,0,0,0,,Уау, бұл трицератопс!
Dialogue: 0,0:12:52.77,0:12:58.11,Default,,0,0,0,,Ендеше, егер сол жердегі кішкентай динозаврдың атын білсеңіз, қолыңызды көтеріңіз.
Dialogue: 0,0:12:58.19,0:12:59.57,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:12:59.65,0:13:01.53,Default,,0,0,0,,Мм... сен
Dialogue: 0,0:13:01.61,0:13:03.36,Default,,0,0,0,,...
Dialogue: 0,0:13:03.44,0:13:04.99,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:13:05.07,0:13:06.32,Default,,0,0,0,,Онда қолыңды көтерме!
Dialogue: 0,0:13:06.41,0:13:07.78,Default,,0,0,0,,Ах... хаха...
Dialogue: 0,0:13:07.87,0:13:10.37,Default,,0,0,0,,Анчицератопс
Dialogue: 0,0:13:10.45,0:13:15.33,Default,,0,0,0,,Суға түсе аласың ба, жоқ па?
Dialogue: 0,0:13:15.92,0:13:18.67,Default,,0,0,0,,Дұрыс, сіз егжей-тегжейлі білесіз.
Dialogue: 0,0:13:18.75,0:13:19.67,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:13:20.59,0:13:23.59,Default,,0,0,0,,Бұл Тиранозавр рексі ме?
Dialogue: 0,0:13:23.67,0:13:25.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:25.13,0:13:27.26,Default,,0,0,0,,Вистахи Эверсау
Dialogue: 0,0:13:27.34,0:13:30.68,Default,,0,0,0,,Тиранозавр – бұл
Dialogue: 0,0:13:32.97,0:13:34.35,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:13:34.43,0:13:36.31,Default,,0,0,0,,А... а...
Dialogue: 0,0:13:38.35,0:13:41.61,Default,,0,0,0,,Қандай динозавр көп ұшады?
Dialogue: 0,0:13:41.69,0:13:43.23,Default,,0,0,0,,Сол жерден...
Dialogue: 0,0:13:43.32,0:13:44.69,Default,,0,0,0,,Бұл птеранодон
Dialogue: 0,0:13:45.74,0:13:48.20,Default,,0,0,0,,Бұл Диморфодон.
Dialogue: 0,0:13:48.28,0:13:49.41,Default,,0,0,0,,Тапеяра
Dialogue: 0,0:13:49.49,0:13:51.91,Default,,0,0,0,,Анурогнат Иә
Dialogue: 0,0:13:51.99,0:13:53.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:53.95,0:13:57.29,Default,,0,0,0,,Сырты кербез, солай емес пе?
Dialogue: 0,0:13:57.37,0:13:58.37,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:13:58.46,0:14:01.34,Default,,0,0,0,,Маған брахиозавр көбірек ұнайды
Dialogue: 0,0:14:01.42,0:14:03.30,Default,,0,0,0,,-(Казама-кун), солай ма? -Ой?
Dialogue: 0,0:14:04.34,0:14:08.22,Default,,0,0,0,,Әй, әлгі динозавр неге қозғалмайды?
Dialogue: 0,0:14:08.30,0:14:09.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:09.76,0:14:14.10,Default,,0,0,0,,А... Меніңше, ұйықтап жатыр.
Dialogue: 0,0:14:21.86,0:14:23.73,Default,,0,0,0,,Жоқ, мен осы жолы шындап тұрмын! Жоғарғы қабатта өлі дене жатыр.
Dialogue: 0,0:14:24.48,0:14:26.69,Default,,0,0,0,,Бури Бури Бури
Dialogue: 0,0:14:26.78,0:14:29.24,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:14:29.32,0:14:30.66,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:14:30.74,0:14:32.12,Default,,0,0,0,,Жоқ, Шин Чан
Dialogue: 0,0:14:32.20,0:14:33.62,Default,,0,0,0,,Арандататын нәрселер...
Dialogue: 0,0:14:33.70,0:14:35.58,Default,,0,0,0,,-Хехе~ -Уау...
Dialogue: 0,0:14:35.66,0:14:37.54,Default,,0,0,0,,Амаргазавр
Dialogue: 0,0:14:37.62,0:14:41.00,Default,,0,0,0,,Бұл қорқынышты көрінеді, бірақ бұл шөпқоректі динозавр.
Dialogue: 0,0:14:37.62,0:14:41.00,Default,,0,0,0,,Эхе~ Хэхе~
Dialogue: 0,0:14:41.08,0:14:43.63,Default,,0,0,0,,Шин-сама, бұл тамаша.
Dialogue: 0,0:14:43.71,0:14:45.46,Default,,0,0,0,,- Уф - Екінші жағынан ...
Dialogue: 0,0:14:45.55,0:14:48.67,Default,,0,0,0,,Угбо...мен де!
Dialogue: 0,0:14:48.76,0:14:53.10,Default,,0,0,0,,Эй, эй! Балалар, мұнда келіңдер!
Dialogue: 0,0:14:53.18,0:14:54.81,Default,,0,0,0,,А, жоқ!
Dialogue: 0,0:14:57.85,0:14:58.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:00.06,0:15:02.44,Default,,0,0,0,,Ах, уау, эй!
Dialogue: 0,0:15:03.19,0:15:07.36,Default,,0,0,0,,Velociraptor Кішкентай, бірақ өте қатыгез
Dialogue: 0,0:15:07.44,0:15:09.32,Default,,0,0,0,,Мына ақымақ күріш шары!
Dialogue: 0,0:15:09.40,0:15:10.78,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,0:15:10.86,0:15:12.95,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,0:15:14.16,0:15:17.49,Default,,0,0,0,,Нана нана…
Dialogue: 0,0:15:19.79,0:15:21.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:22.29,0:15:23.54,Default,,0,0,0,,Нт
Dialogue: 0,0:15:25.13,0:15:26.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:29.92,0:15:32.76,Default,,0,0,0,,Күтілгендей, бұл ең жақсы аспаз жасаған түскі ас қорабы.
Dialogue: 0,0:15:32.84,0:15:34.93,Default,,0,0,0,,Стейктен жасалған тендер
Dialogue: 0,0:15:35.01,0:15:36.72,Default,,0,0,0,,- (Репортер) Көпіршік Одороки мырза - Әй?
Dialogue: 0,0:15:36.81,0:15:39.18,Default,,0,0,0,,Ғасыр ерлігіне жеткенің құтты болсын
Dialogue: 0,0:15:39.27,0:15:40.56,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:15:40.64,0:15:42.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:42.23,0:15:44.19,Default,,0,0,0,,Динозаврларды қалай тірілтуге болады
Dialogue: 0,0:15:44.27,0:15:46.36,Default,,0,0,0,,Қиындық көп болса керек, солай ма?
Dialogue: 0,0:15:46.44,0:15:50.69,Default,,0,0,0,,Мен сенбейтін дүниеммен жарық көргім келеді
Dialogue: 0,0:15:50.78,0:15:54.07,Default,,0,0,0,,Ол үшін кез келген қиындықтың өзі лайық.
Dialogue: 0,0:15:55.37,0:15:57.03,Default,,0,0,0,,Бірақ қалай...
Dialogue: 0,0:15:57.12,0:16:00.25,Default,,0,0,0,,Бұл өте құпия
Dialogue: 0,0:16:00.33,0:16:01.50,Default,,0,0,0,,Бұл құпия
Dialogue: 0,0:16:01.58,0:16:03.58,Default,,0,0,0,,Көп жылдық зерттеулер негізінде—
Dialogue: 0,0:16:03.67,0:16:06.71,Default,,0,0,0,,Мен тек сенгісіз әдіс деп айта аламын.
Dialogue: 0,0:16:06.79,0:16:09.51,Default,,0,0,0,,Әрекет Камен және Кванттық Робо
Dialogue: 0,0:16:09.59,0:16:10.84,Default,,0,0,0,,Сізге қайсысы ұнайды?
Dialogue: 0,0:16:10.92,0:16:13.26,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:16:13.34,0:16:14.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:16.05,0:16:17.35,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:19.14,0:16:20.93,Default,,0,0,0,,Нанако, қарап тұрсың ба?
Dialogue: 0,0:16:21.02,0:16:21.89,Default,,0,0,0,,Эй, мен мұнда жақсы жүрмін, сондықтан Нанако да жақсы...
Dialogue: 0,0:16:21.89,0:16:23.19,Default,,0,0,0,,Эй, мен мұнда жақсы жүрмін, сондықтан Нанако да жақсы...
Dialogue: 0,0:16:21.89,0:16:23.19,Default,,0,0,0,,Ах
Dialogue: 0,0:16:23.19,0:16:24.27,Default,,0,0,0,,Эй, мен мұнда жақсы жүрмін, сондықтан Нанако да жақсы...
Dialogue: 0,0:16:24.35,0:16:25.48,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:27.06,0:16:27.94,Default,,0,0,0,,Иә
Dialogue: 0,0:16:29.48,0:16:31.15,Default,,0,0,0,,Аха~
Dialogue: 0,0:16:32.07,0:16:35.07,Default,,0,0,0,,Жақсы, сау бала екенсің.
Dialogue: 0,0:16:35.16,0:16:38.08,Default,,0,0,0,,Не?!
Dialogue: 0,0:16:38.16,0:16:40.04,Default,,0,0,0,,Уау~
Dialogue: 0,0:16:43.54,0:16:44.75,Default,,0,0,0,,Эй, эй, мен Гача Гачаны ойнағым келеді
Dialogue: 0,0:16:44.75,0:16:45.92,Default,,0,0,0,,Эй, эй, мен Гача Гачаны ойнағым келеді
Dialogue: 0,0:16:44.75,0:16:45.92,Default,,0,0,0,,Мен мұны қалаймын
Dialogue: 0,0:16:46.00,0:16:49.84,Default,,0,0,0,,Үлкен апаның жол көрсетушісі қызық болды
Dialogue: 0,0:16:50.46,0:16:53.30,Default,,0,0,0,,Мен мұны естігеніме мақтанамын.
Dialogue: 0,0:16:53.38,0:16:56.76,Default,,0,0,0,,Соңында, бұл келушілерге арналған бонустық монета.
Dialogue: 0,0:16:57.51,0:16:59.72,Default,,0,0,0,,Сіз бұл гачаны тарта аласыз.
Dialogue: 0,0:16:59.81,0:17:01.68,Default,,0,0,0,,-Уау~ -(Казама-кун) Жарайды.
Dialogue: 0,0:17:08.27,0:17:11.11,Default,,0,0,0,,Ой, бұл брахиозавр.
Dialogue: 0,0:17:12.19,0:17:13.82,Default,,0,0,0,,Стегозавр
Dialogue: 0,0:17:14.82,0:17:16.53,Default,,0,0,0,,Трицератопстар
Dialogue: 0,0:17:17.32,0:17:19.99,Default,,0,0,0,,- Уау, сондай сүйкімді - (Бо-чан) Ахахха
Dialogue: 0,0:17:20.08,0:17:22.20,Default,,0,0,0,,Тиранно, кел.
Dialogue: 0,0:17:23.50,0:17:25.87,Default,,0,0,0,,Тиранно, кел!
Dialogue: 0,0:17:25.96,0:17:29.33,Default,,0,0,0,,Бұлай айтсаң, ол шындыққа жанаспайды.
Dialogue: 0,0:17:30.88,0:17:32.30,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:33.59,0:17:35.88,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:17:35.97,0:17:37.47,Default,,0,0,0,,Тиранозавр нәжісі
Dialogue: 0,0:17:38.18,0:17:39.60,Default,,0,0,0,,Дұрыс түсінгеніңізге қуаныштымын.
Dialogue: 0,0:17:39.68,0:17:42.01,Default,,0,0,0,,Мен күткендей емес
Dialogue: 0,0:17:42.10,0:17:43.43,Default,,0,0,0,,Жарайды, солай!
Dialogue: 0,0:17:43.52,0:17:45.89,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:17:48.48,0:17:51.32,Default,,0,0,0,,Уау! Туыстарының шарлары~
Dialogue: 0,0:17:51.40,0:17:53.78,Default,,0,0,0,,Уау өте сирек
Dialogue: 0,0:17:53.86,0:17:55.99,Default,,0,0,0,,Сен күткендей, Шин-сама.
Dialogue: 0,0:17:59.16,0:18:00.24,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:18:00.32,0:18:02.66,Default,,0,0,0,,Көпіршікті одороки алтын суреті
Dialogue: 0,0:18:02.74,0:18:05.20,Default,,0,0,0,,А... Маған керегі жоқ.
Dialogue: 0,0:18:06.21,0:18:11.04,Default,,0,0,0,,На-на-на-на-на-на-на…
Dialogue: 0,0:18:18.55,0:18:19.89,Default,,0,0,0,,Кун
Dialogue: 0,0:18:22.97,0:18:24.52,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:18:24.60,0:18:28.73,Default,,0,0,0,,Шинносуке Сіз өте көңілді болған сияқтысыз
Dialogue: 0,0:18:28.81,0:18:30.31,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:18:30.94,0:18:34.27,Default,,0,0,0,,Бірақ жазғы демалыс әлі ұзақ.
Dialogue: 0,0:18:36.78,0:18:37.95,Default,,0,0,0,,Кун
Dialogue: 0,0:18:41.28,0:18:45.33,Default,,0,0,0,,Мен сенбейтін дүниеммен жарық көргім келеді
Dialogue: 0,0:18:45.41,0:18:46.33,Default,,0,0,0,,Осы мақсатта...
Dialogue: 0,0:18:51.83,0:18:53.54,Default,,0,0,0,,Құрметті Анджела
Dialogue: 0,0:18:53.63,0:18:56.46,Default,,0,0,0,,Сіздің алғашқы динозавр гидіңіз қалай болды?
Dialogue: 0,0:18:58.22,0:18:59.42,Default,,0,0,0,,Бөлек
Dialogue: 0,0:18:59.51,0:19:02.09,Default,,0,0,0,,Аммонер Ито жалғастырды
Dialogue: 0,0:19:02.18,0:19:03.68,Default,,0,0,0,,Иә
Dialogue: 0,0:19:03.76,0:19:04.89,Default,,0,0,0,,Ах
Dialogue: 0,0:19:04.97,0:19:07.52,Default,,0,0,0,,Мынау, Көпіршік-сама.
Dialogue: 0,0:19:07.60,0:19:08.85,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:19:08.93,0:19:10.06,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:19:10.14,0:19:12.27,Default,,0,0,0,,Жер де өте танымал болды, әр жерден адамдар келді.
Dialogue: 0,0:19:12.35,0:19:16.28,Default,,0,0,0,,Бізге сұхбаттар мен ынтымақтастық туралы сұраулар толып кетті.
Dialogue: 0,0:19:19.11,0:19:20.70,Default,,0,0,0,,(Су асты дыбысы)
Dialogue: 0,0:19:20.78,0:19:21.91,Default,,0,0,0,,Ах
Dialogue: 0,0:19:22.53,0:19:24.58,Default,,0,0,0,,(Су асты дыбысы)
Dialogue: 0,0:19:25.28,0:19:28.08,Default,,0,0,0,,Гуаах
Dialogue: 0,0:19:28.16,0:19:30.50,Default,,0,0,0,,Кімге қарсы шығасың?
Dialogue: 0,0:19:33.08,0:19:34.59,Default,,0,0,0,,Оны тек сен ғана көресің
Dialogue: 0,0:19:37.96,0:19:39.88,Default,,0,0,0,,Оны тез тастаңыз.
Dialogue: 0,0:19:39.97,0:19:41.30,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:41.38,0:19:44.34,Default,,0,0,0,,Сондай-ақ, мысалда не болып жатыр?
Dialogue: 0,0:19:45.01,0:19:47.81,Default,,0,0,0,,Құлаудың шамамен орналасқан жері анықталды.
Dialogue: 0,0:19:47.89,0:19:50.31,Default,,0,0,0,,Әрине дерлік
Dialogue: 0,0:19:51.02,0:19:54.31,Default,,0,0,0,,Мен оны тезірек алуым керек.
Dialogue: 0,0:20:10.00,0:20:11.87,Default,,0,0,0,,-(1 оқушы қыз) Сүйкімді екен -(2 оқушы қыз) Гао~
Dialogue: 0,0:20:22.84,0:20:25.22,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:20:25.30,0:20:28.06,Default,,0,0,0,,Бұл стегозавр тәрізді шалғам үккіш
Dialogue: 0,0:20:28.14,0:20:31.68,Default,,0,0,0,,Екіден тұратын жиынтық 3800 иенді құрайды.
Dialogue: 0,0:20:31.77,0:20:33.64,Default,,0,0,0,,Птеранодон Рюко
Dialogue: 0,0:20:33.73,0:20:35.06,Default,,0,0,0,,Velociraptor күмісі
Dialogue: 0,0:20:35.15,0:20:36.69,Default,,0,0,0,,Игуанодон Мари
Dialogue: 0,0:20:36.77,0:20:40.15,Default,,0,0,0,,Үшеуміз бірге, Сайтама Бенисасори-тай
Dialogue: 0,0:20:40.23,0:20:43.49,Default,,0,0,0,,Әлем бұрын-соңды болмаған динозаврлар бумын бастан кешуде.
Dialogue: 0,0:20:43.57,0:20:45.91,Default,,0,0,0,,Біз де оны мінуіміз керек.
Dialogue: 0,0:20:45.99,0:20:48.12,Default,,0,0,0,,Мынау ақсақ!
Dialogue: 0,0:20:48.78,0:20:49.83,Default,,0,0,0,,Алға, Трисера!
Dialogue: 0,0:20:49.91,0:20:51.79,Default,,0,0,0,,Жоғалтпа, Брахио!
Dialogue: 0,0:20:51.87,0:20:53.46,Default,,0,0,0,,Сәттілік Масуарао!
Dialogue: 0,0:20:53.54,0:20:56.00,Default,,0,0,0,,- (Казама-кун) А, мен жеңілдім - (Бо-чан) Хаха
Dialogue: 0,0:20:56.08,0:20:57.79,Default,,0,0,0,,Келесі Масао-кун, жасайсың ба?
Dialogue: 0,0:20:58.54,0:21:02.09,Default,,0,0,0,,Менікі бәрібір...
Dialogue: 0,0:21:03.63,0:21:05.68,Default,,0,0,0,,Ей, динозаврлар қазір жақсы.
Dialogue: 0,0:21:05.76,0:21:08.51,Default,,0,0,0,,Нағыз үй ойынын ойнайық.
Dialogue: 0,0:21:08.60,0:21:10.26,Default,,0,0,0,,«Жемістер өте тәтті»
Dialogue: 0,0:21:10.35,0:21:13.06,Default,,0,0,0,,Әрине, сұлу әйел рөлін Нене ойнайды.
Dialogue: 0,0:21:13.14,0:21:15.64,Default,,0,0,0,,Мен кіммен бірге болуым керек?
Dialogue: 0,0:21:15.73,0:21:16.98,Default,,0,0,0,,Иә
Dialogue: 0,0:21:17.06,0:21:19.61,Default,,0,0,0,,Мен... Шинносуке жақсырақ болмай ма?
Dialogue: 0,0:21:19.69,0:21:21.27,Default,,0,0,0,,Жоқ, жоқ, бұл Масао-кун, солай ма?
Dialogue: 0,0:21:21.36,0:21:24.57,Default,,0,0,0,,Бо...Бо-чан маған қарағанда жақсы...
Dialogue: 0,0:21:25.49,0:21:26.78,Default,,0,0,0,,Жоқ, жоқ, мұнда...
Dialogue: 0,0:21:26.86,0:21:28.37,Default,,0,0,0,,-Ах Широ -(үшін) А?
Dialogue: 0,0:21:29.16,0:21:31.33,Default,,0,0,0,,Біз қайда барамыз?
Dialogue: 0,0:21:33.12,0:21:34.04,Default,,0,0,0,,Энн Энн!
Dialogue: 0,0:21:34.12,0:21:37.87,Default,,0,0,0,,На? На~ На~ На~!
Dialogue: 0,0:21:37.96,0:21:39.63,Default,,0,0,0,,N~
Dialogue: 0,0:21:40.92,0:21:42.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:42.96,0:21:45.26,Default,,0,0,0,,Сәлем Широ~
Dialogue: 0,0:21:46.13,0:21:47.63,Default,,0,0,0,,Энн Энн
Dialogue: 0,0:21:48.80,0:21:51.64,Default,,0,0,0,,Жоқ... бұл қандай жаратылыс?
Dialogue: 0,0:21:51.72,0:21:53.93,Default,,0,0,0,,Мүмкін динозавр шығар?
Dialogue: 0,0:21:54.02,0:21:56.18,Default,,0,0,0,,Не, мүмкін емес пе?
Dialogue: 0,0:21:56.81,0:21:58.10,Default,,0,0,0,,(Туған туыс) Олай деуге болады, бірақ (Туған туыс) бұл маңызды мәселе.
Dialogue: 0,0:21:59.19,0:22:01.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:22:01.15,0:22:02.90,Default,,0,0,0,,С… Сүйкімді
Dialogue: 0,0:22:02.98,0:22:06.53,Default,,0,0,0,,Мен мұны нағыз үй ойынына тірек ретінде әкелдім.
Dialogue: 0,0:22:06.61,0:22:07.99,Default,,0,0,0,,Тамақтану керек пе?
Dialogue: 0,0:22:08.07,0:22:09.11,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:22:09.20,0:22:10.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:22:15.04,0:22:19.04,Default,,0,0,0,,Сіз оны осылай жейсіз. Иә, өтінемін.
Dialogue: 0,0:22:19.12,0:22:20.33,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,0:22:21.92,0:22:22.92,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:22:23.00,0:22:24.42,Default,,0,0,0,,Уау
Dialogue: 0,0:22:24.50,0:22:25.71,Default,,0,0,0,,Менің де солай жасағым келеді
Dialogue: 0,0:22:25.80,0:22:26.88,Default,,0,0,0,,-Ола да! -(Бо-чан) Бо!
Dialogue: 0,0:22:26.97,0:22:28.26,Default,,0,0,0,,-Жарайды онда. -(Бо-чан) Бо-чан.
Dialogue: 0,0:22:28.34,0:22:29.22,Default,,0,0,0,,- (Казама-кун) Өтінемін - Иә.
Dialogue: 0,0:22:29.30,0:22:30.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:22:32.89,0:22:36.02,Default,,0,0,0,,Хмм, бұл өте тәтті.
Dialogue: 0,0:22:36.10,0:22:38.35,Default,,0,0,0,,Оны неге жейсің!
Dialogue: 0,0:22:38.44,0:22:39.69,Default,,0,0,0,,Уки?
Dialogue: 0,0:22:41.52,0:22:43.15,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:22:43.23,0:22:45.82,Default,,0,0,0,,Бұл бала жалғыз ба?
Dialogue: 0,0:22:45.90,0:22:49.11,Default,,0,0,0,,Ата-анасы да, иесі де жоқ сияқты...
Dialogue: 0,0:22:49.20,0:22:50.99,Default,,0,0,0,,-Анан! -сурет?
Dialogue: 0,0:22:51.07,0:22:53.20,Default,,0,0,0,,...
Dialogue: 0,0:22:53.28,0:22:55.58,Default,,0,0,0,,Сол бала бізбен бірге
Dialogue: 0,0:22:55.66,0:22:58.00,Default,,0,0,0,,Мені өзіңізбен бірге үйге апарғыңыз келе ме?
Dialogue: 0,0:22:58.08,0:22:58.91,Default,,0,0,0,,Энн!
Dialogue: 0,0:22:59.00,0:23:01.92,Default,,0,0,0,,Әкем де, шешем де жоқ дейді.
Dialogue: 0,0:23:02.00,0:23:04.04,Default,,0,0,0,,Энн Энн Энн!
Dialogue: 0,0:23:04.13,0:23:07.59,Default,,0,0,0,,О, құдай-ау, көмектесуге болмайды.
Dialogue: 0,0:23:10.13,0:23:11.26,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:23:11.34,0:23:13.68,Default,,0,0,0,,Бұл қандай тіршілік иесі?
Dialogue: 0,0:23:13.76,0:23:15.47,Default,,0,0,0,,Мен оны үйде сақтай аламын ба?
Dialogue: 0,0:23:15.56,0:23:17.85,Default,,0,0,0,,Шин Чан, жақсысың ба?
Dialogue: 0,0:23:15.56,0:23:17.85,Default,,0,0,0,,Е, сен мынаны сақтайсың ба?
Dialogue: 0,0:23:17.85,0:23:17.93,Default,,0,0,0,,Е, сен мынаны сақтайсың ба?
Dialogue: 0,0:23:17.93,0:23:18.60,Default,,0,0,0,,Е, сен мынаны сақтайсың ба?
Dialogue: 0,0:23:17.93,0:23:18.60,Default,,0,0,0,,Мұндай келіссөздер, әрине, жаман.
Dialogue: 0,0:23:18.60,0:23:18.68,Default,,0,0,0,,Мұндай келіссөздер, әрине, жаман.
Dialogue: 0,0:23:18.68,0:23:19.52,Default,,0,0,0,,Мұндай келіссөздер, әрине, жаман.
Dialogue: 0,0:23:18.68,0:23:19.52,Default,,0,0,0,,Иә
Dialogue: 0,0:23:19.52,0:23:19.60,Default,,0,0,0,,Мұндай келіссөздер, әрине, жаман.
Dialogue: 0,0:23:19.60,0:23:20.94,Default,,0,0,0,,Мұндай келіссөздер, әрине, жаман.
Dialogue: 0,0:23:19.60,0:23:20.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:21.02,0:23:24.19,Default,,0,0,0,,Жоқ, келген жеріңе қайт.
Dialogue: 0,0:23:24.27,0:23:26.90,Default,,0,0,0,,Сіз өзіңізге жауапкершілікпен қарай алмайсыз.
Dialogue: 0,0:23:26.98,0:23:31.41,Default,,0,0,0,,Жарайды, Широ саған қамқор болады.
Dialogue: 0,0:23:31.49,0:23:32.36,Default,,0,0,0,,Кун
Dialogue: 0,0:23:32.45,0:23:34.24,Default,,0,0,0,,Сіз емессіз бе?
Dialogue: 0,0:23:34.32,0:23:37.83,Default,,0,0,0,,Жалпы айтқанда, жануарлар басқа жануарларға қамқорлық жасайды.
Dialogue: 0,0:23:37.91,0:23:39.37,Default,,0,0,0,,Энн!
Dialogue: 0,0:23:39.45,0:23:40.29,Default,,0,0,0,,Уау
Dialogue: 0,0:23:40.37,0:23:42.37,Default,,0,0,0,,О! мақта кәмпит
Dialogue: 0,0:23:42.46,0:23:44.46,Default,,0,0,0,,Бұл гиозаға ұқсайды.
Dialogue: 0,0:23:44.54,0:23:45.96,Default,,0,0,0,,Энн!
Dialogue: 0,0:23:46.04,0:23:47.75,Default,,0,0,0,,Жыныс мүшесіне дейін
Dialogue: 0,0:23:47.84,0:23:49.26,Default,,0,0,0,,тыныс алу
Dialogue: 0,0:23:49.34,0:23:50.26,Default,,0,0,0,,Хааа~
Dialogue: 0,0:23:50.34,0:23:52.26,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:23:52.34,0:23:54.93,Default,,0,0,0,,Бірінші кезекте ұстауға жақсы жануар ма?
Dialogue: 0,0:23:55.01,0:23:56.97,Default,,0,0,0,,Хмм... игуанаға ұқсайды.
Dialogue: 0,0:23:57.06,0:23:59.14,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:23:59.22,0:24:00.18,Default,,0,0,0,,Анан!
Dialogue: 0,0:24:00.27,0:24:02.64,Default,,0,0,0,,Кун...
Dialogue: 0,0:24:02.73,0:24:04.19,Default,,0,0,0,,-Аа-ух
Dialogue: 0,0:24:05.27,0:24:07.57,Default,,0,0,0,,Широның сезімін түсінемін.
Dialogue: 0,0:24:07.65,0:24:10.07,Default,,0,0,0,,Сіз де Синносүкені күнде күтесіз бе?
Dialogue: 0,0:24:10.15,0:24:11.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:11.11,0:24:12.99,Default,,0,0,0,,Уақытыңыз болса.
Dialogue: 0,0:24:13.07,0:24:15.62,Default,,0,0,0,,Не, анау ақымақ?
Dialogue: 0,0:24:19.24,0:24:23.12,Default,,0,0,0,,Жарайды, менің ойымша, бұл бала тыныш және оған күтім жасау оңай.
Dialogue: 0,0:24:23.21,0:24:24.58,Default,,0,0,0,,Ә? Шынында ма?
Dialogue: 0,0:24:24.67,0:24:26.29,Default,,0,0,0,,- (Қазама-күн) Мүмкін... -Мүмкін
Dialogue: 0,0:24:26.38,0:24:27.29,Default,,0,0,0,,- Мүмкін - (Бо-чан) Мүмкін
Dialogue: 0,0:24:27.38,0:24:30.26,Default,,0,0,0,,Хмм, мүмкін...
Dialogue: 0,0:24:30.34,0:24:33.01,Default,,0,0,0,,Сіз де көбірек шағымдануыңыз керек.
Dialogue: 0,0:24:33.09,0:24:36.43,Default,,0,0,0,,Бұл бала мектепке барады және ағылшын тілінде сөйлей алады.
Dialogue: 0,0:24:36.51,0:24:38.97,Default,,0,0,0,,Менің өтінішім емес!
Dialogue: 0,0:24:39.06,0:24:42.68,Default,,0,0,0,,Нене және басқалары қолдарынан келгеннің бәрін жасайды және сізге бірге қамқорлық жасайды.
Dialogue: 0,0:24:42.77,0:24:45.15,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:24:45.23,0:24:47.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:47.69,0:24:50.94,Default,,0,0,0,,Егер бәрі осылай десе...
Dialogue: 0,0:24:51.03,0:24:53.07,Default,,0,0,0,,Иесі табылмайынша.
Dialogue: 0,0:24:53.15,0:24:55.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:55.11,0:24:56.57,Default,,0,0,0,,Сізге жақсы, Широ.
Dialogue: 0,0:24:56.66,0:24:57.49,Default,,0,0,0,,Энн!
Dialogue: 0,0:24:57.57,0:25:00.37,Default,,0,0,0,,А, мына балаға есім ойлап көрейік.
Dialogue: 0,0:25:00.45,0:25:02.50,Default,,0,0,0,,Жақсы сияқты Мен не істеуім керек?
Dialogue: 0,0:25:02.58,0:25:04.41,Default,,0,0,0,,Олай болса, Тоору-чан.
Dialogue: 0,0:25:04.50,0:25:06.83,Default,,0,0,0,,Бұл менің атым!
Dialogue: 0,0:25:06.92,0:25:11.30,Default,,0,0,0,,Біріншіден, ұл ба, қыз ба?
Dialogue: 0,0:25:21.26,0:25:23.27,Default,,0,0,0,,Иә, Банан-чан дегеніміз не?
Dialogue: 0,0:25:23.35,0:25:26.02,Default,,0,0,0,,Не? Бұл жағдайда Нанако жақсырақ.
Dialogue: 0,0:25:26.10,0:25:28.15,Default,,0,0,0,,Банан-чан сүйкімдірек!
Dialogue: 0,0:25:28.23,0:25:29.06,Default,,0,0,0,,Нанако!
Dialogue: 0,0:25:29.15,0:25:30.23,Default,,0,0,0,,Банан!
Dialogue: 0,0:25:30.32,0:25:31.69,Default,,0,0,0,,Нана
Dialogue: 0,0:25:31.78,0:25:32.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:32.86,0:25:34.99,Default,,0,0,0,,Бір сәт Нана
Dialogue: 0,0:25:35.07,0:25:37.91,Default,,0,0,0,,Нана-чан... өте сүйкімді!
Dialogue: 0,0:25:37.99,0:25:39.07,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:25:39.16,0:25:40.37,Default,,0,0,0,,Бо Чан күткендей
Dialogue: 0,0:25:40.45,0:25:41.91,Default,,0,0,0,,Нана
Dialogue: 0,0:25:41.99,0:25:43.70,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:25:43.79,0:25:45.87,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:25:46.62,0:25:49.83,Default,,0,0,0,,Ал, әзірше бүгіннен бастап маған қамқорлық жасаңыз.
Dialogue: 0,0:25:49.92,0:25:51.96,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:25:52.05,0:25:54.30,Default,,0,0,0,,Жоқ!? Жоқ!
Dialogue: 0,0:25:54.38,0:25:56.76,Default,,0,0,0,,Уау
Dialogue: 0,0:25:56.84,0:26:02.47,Default,,0,0,0,,А, а, а, а, а...
Dialogue: 0,0:26:02.56,0:26:06.43,Default,,0,0,0,,(Широның айқайы)
Dialogue: 0,0:26:06.52,0:26:10.40,Default,,0,0,0,,-Кууун Кууун... -Хмм...
Dialogue: 0,0:26:10.48,0:26:12.61,Default,,0,0,0,,Ал...
Dialogue: 0,0:26:16.36,0:26:19.74,Default,,0,0,0,,Широ Нана Гохандазо
Dialogue: 0,0:26:19.82,0:26:21.70,Default,,0,0,0,,Yotto...
Dialogue: 0,0:26:21.78,0:26:23.83,Default,,0,0,0,,Хотто Оотто
Dialogue: 0,0:26:23.91,0:26:25.25,Default,,0,0,0,,Иә
Dialogue: 0,0:26:28.75,0:26:30.75,Default,,0,0,0,,Көбірек алғыңыз келе ме?
Dialogue: 0,0:26:30.83,0:26:31.96,Default,,0,0,0,,Хой
Dialogue: 0,0:26:35.09,0:26:36.26,Default,,0,0,0,,Хой
Dialogue: 0,0:26:36.34,0:26:37.88,Default,,0,0,0,,- Энн Анна! -Хойхой
Dialogue: 0,0:26:37.97,0:26:39.09,Default,,0,0,0,,Энн!
Dialogue: 0,0:26:39.18,0:26:40.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:42.51,0:26:43.81,Default,,0,0,0,,Энн Энн Энн!
Dialogue: 0,0:26:43.89,0:26:46.31,Default,,0,0,0,,Жарайды, сен жегің келетінін айттың!
Dialogue: 0,0:26:46.39,0:26:48.69,Default,,0,0,0,,-Хой Хой Хой -Анан Энн
Dialogue: 0,0:26:48.77,0:26:49.85,Default,,0,0,0,,Хой Хой
Dialogue: 0,0:26:50.60,0:26:54.07,Default,,0,0,0,,Не болды? Сіз маған қамқорлық жасайсыз, иә?
Dialogue: 0,0:26:54.94,0:26:57.53,Default,,0,0,0,,Бұл Нанаға
Dialogue: 0,0:26:57.61,0:27:00.11,Default,,0,0,0,,Қорғаныс күштерінің төс белгісінің жағасы?
Dialogue: 0,0:27:00.20,0:27:02.99,Default,,0,0,0,,Керемет, Бо Чан жасады ма?
Dialogue: 0,0:27:03.07,0:27:05.58,Default,,0,0,0,,Йотто... Эй
Dialogue: 0,0:27:05.66,0:27:07.04,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:27:08.12,0:27:09.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:27:09.29,0:27:10.29,Default,,0,0,0,,Энн Энн!
Dialogue: 0,0:27:11.21,0:27:14.42,Default,,0,0,0,,Жарайды, жаңа мүше, бүгіннен бастап танысқаныма қуаныштымын.
Dialogue: 0,0:27:14.50,0:27:17.30,Default,,0,0,0,,- Жоқ! -Ууу...
Dialogue: 0,0:27:17.38,0:27:19.30,Default,,0,0,0,,Жақында сені алып кетесің.
Dialogue: 0,0:27:19.38,0:27:23.30,Default,,0,0,0,,Нана қазір Касукабе қорғаныс күштерінің мүшесі.
Dialogue: 0,0:27:24.35,0:27:28.93,Default,,0,0,0,,Ерекше жаз басталатын сияқты.
Dialogue: 0,0:27:29.02,0:27:31.56,Default,,0,0,0,,Ола мен Тоору-чанның жазы
Dialogue: 0,0:27:32.06,0:27:33.69,Default,,0,0,0,,-Уу~ - (Қазама-күн) Уау!
Dialogue: 0,0:27:33.77,0:27:36.27,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:27:36.36,0:27:37.40,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:27:37.48,0:27:38.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:38.40,0:27:41.86,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:27:42.78,0:27:48.54,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:27:52.92,0:27:55.63,Default,,0,0,0,,Йотто... Иә.
Dialogue: 0,0:27:59.67,0:28:06.10,Default,,0,0,0,,(Масао-кунның күлкісі)
Dialogue: 0,0:28:08.39,0:28:10.68,Default,,0,0,0,,Нана, сен жақсы жүзесің.
Dialogue: 0,0:28:10.77,0:28:12.64,Default,,0,0,0,,Бұл теңіз игуанасы ма?
Dialogue: 0,0:28:12.73,0:28:14.31,Default,,0,0,0,,-Қара, қара~ -(2 адам) А?
Dialogue: 0,0:28:15.06,0:28:16.77,Default,,0,0,0,,Игуана
Dialogue: 0,0:28:17.36,0:28:19.94,Default,,0,0,0,,үшін қарбыз кеседі.
Dialogue: 0,0:28:20.03,0:28:21.07,Default,,0,0,0,,Рахмет
Dialogue: 0,0:28:21.15,0:28:22.70,Default,,0,0,0,,-Дәмді көрінеді~ -Ия!
Dialogue: 0,0:28:27.99,0:28:29.24,Default,,0,0,0,,Таяая
Dialogue: 0,0:28:29.33,0:28:31.12,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:28:31.20,0:28:32.75,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:28:33.46,0:28:38.55,Default,,0,0,0,,Ой~ Ой~ Иә Уйююю~
Dialogue: 0,0:28:41.17,0:28:46.97,Default,,0,0,0,,Мен игуанамын Ууу...
Dialogue: 0,0:28:48.26,0:28:51.93,Default,,0,0,0,,Бури бури~ Бури бури~ бури бури~
Dialogue: 0,0:28:48.26,0:28:51.93,Default,,0,0,0,,Нана Нана~ Нана Нана~ Нана Нана~
Dialogue: 0,0:28:52.02,0:28:54.27,Default,,0,0,0,,Маған біртүрлі нәрселерді айтпа
Dialogue: 0,0:28:54.35,0:28:56.40,Default,,0,0,0,,Уау, пілге ұқсайды
Dialogue: 0,0:28:57.19,0:28:58.48,Default,,0,0,0,,Кун...
Dialogue: 0,0:28:59.44,0:29:04.20,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:29:08.49,0:29:10.37,Default,,0,0,0,,Жоқ
Dialogue: 0,0:29:16.12,0:29:18.88,Default,,0,0,0,,На~ на на на~
Dialogue: 0,0:29:18.96,0:29:20.30,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:29:20.38,0:29:22.76,Default,,0,0,0,,Эй, Нана, істеп жатырсың ба?
Dialogue: 0,0:29:23.67,0:29:27.55,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:29:27.64,0:29:29.89,Default,,0,0,0,,Жоқ! Жоқ!
Dialogue: 0,0:29:29.97,0:29:34.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:37.90,0:29:40.40,Default,,0,0,0,,Нана нана… на~
Dialogue: 0,0:29:40.48,0:29:43.11,Default,,0,0,0,,А, эй, мен қазір бос емеспін!
Dialogue: 0,0:29:43.19,0:29:44.78,Default,,0,0,0,,Жоқ
Dialogue: 0,0:29:44.86,0:29:46.32,Default,,0,0,0,,-Нанана... -Ах
Dialogue: 0,0:29:47.95,0:29:49.62,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:29:55.62,0:29:57.21,Default,,0,0,0,,Құрметті Анджела
Dialogue: 0,0:29:57.29,0:30:01.21,Default,,0,0,0,,Ынтымақтастық тауарлары: динозаврларды қолдау жанкүйерлері.
Dialogue: 0,0:30:01.29,0:30:03.13,Default,,0,0,0,,Одан да көп
Dialogue: 0,0:30:03.21,0:30:06.42,Default,,0,0,0,,Gau негізгі блогы мен батареяның жұмысын жақсартыңыз.
Dialogue: 0,0:30:06.51,0:30:10.14,Default,,0,0,0,,Саған әзіл жетпейді, Анджела.
Dialogue: 0,0:30:10.22,0:30:10.89,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:30:10.89,0:30:11.97,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:30:10.89,0:30:11.97,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:30:11.97,0:30:12.06,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:30:12.06,0:30:15.10,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:30:12.06,0:30:15.10,Default,,0,0,0,,Мен «Динозавр» жобасының жетекшісімін.
Dialogue: 0,0:30:17.19,0:30:19.48,Default,,0,0,0,,Сен оны әлі таппадың ба?
Dialogue: 0,0:30:19.56,0:30:20.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:30:20.73,0:30:23.19,Default,,0,0,0,,Мен оны іздеуге бүкіл трилобит бөлімін жіберіп жатырмын...
Dialogue: 0,0:30:23.27,0:30:24.65,Default,,0,0,0,,Ақтау жоқ!
Dialogue: 0,0:30:24.73,0:30:27.11,Default,,0,0,0,,Тезірек барып, өзіңді ізде.
Dialogue: 0,0:30:27.99,0:30:29.45,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:30:31.03,0:30:32.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:33.70,0:30:36.50,Default,,0,0,0,,Билли, оны маған бер.
Dialogue: 0,0:30:37.12,0:30:41.42,Default,,0,0,0,,Жоқ, мен бұл баланы құруға жауаптымын.
Dialogue: 0,0:30:41.50,0:30:44.38,Default,,0,0,0,,Маған бұл керек.
Dialogue: 0,0:30:45.42,0:30:49.05,Default,,0,0,0,,Жүр, мұнда кел.
Dialogue: 0,0:30:49.13,0:30:51.84,Default,,0,0,0,,Жоқ!? Жоқ!
Dialogue: 0,0:30:51.93,0:30:53.01,Default,,0,0,0,,На…
Dialogue: 0,0:30:55.06,0:30:56.52,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:30:58.14,0:31:01.06,Default,,0,0,0,,Субъект қашып кетті. Дереу қақпаны жабыңыз.
Dialogue: 0,0:31:01.15,0:31:05.86,Default,,0,0,0,,Құпия ашылар алдында
Dialogue: 0,0:31:07.78,0:31:08.95,Default,,0,0,0,,Жоқ
Dialogue: 0,0:31:10.99,0:31:13.24,Default,,0,0,0,,На~ На!
Dialogue: 0,0:31:13.32,0:31:15.20,Default,,0,0,0,,Жарайды, солай!
Dialogue: 0,0:31:15.29,0:31:16.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:31:17.16,0:31:18.37,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:31:18.45,0:31:20.16,Default,,0,0,0,,Жоқ... Жоқ!
Dialogue: 0,0:31:20.25,0:31:21.92,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:31:22.00,0:31:23.92,Default,,0,0,0,,На~ На!
Dialogue: 0,0:31:25.34,0:31:26.38,Default,,0,0,0,,Шуш
Dialogue: 0,0:31:26.46,0:31:27.63,Default,,0,0,0,,Апай?
Dialogue: 0,0:31:27.71,0:31:28.59,Default,,0,0,0,,Шуш
Dialogue: 0,0:31:28.67,0:31:32.09,Default,,0,0,0,,Шуш
Dialogue: 0,0:31:32.18,0:31:33.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:31:33.51,0:31:34.35,Default,,0,0,0,,Энн Энн!
Dialogue: 0,0:31:34.43,0:31:36.43,Default,,0,0,0,,Шуш
Dialogue: 0,0:31:41.90,0:31:43.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:43.40,0:31:45.02,Default,,0,0,0,,Нт
Dialogue: 0,0:31:45.11,0:31:46.15,Default,,0,0,0,,Кун...
Dialogue: 0,0:31:46.23,0:31:47.78,Default,,0,0,0,,На… на…
Dialogue: 0,0:31:48.61,0:31:50.24,Default,,0,0,0,,Әй, не болды, Шинносуке!
Dialogue: 0,0:31:50.82,0:31:53.41,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:31:53.49,0:31:55.49,Default,,0,0,0,,Эй, мүмкін бұл...
Dialogue: 0,0:31:55.58,0:31:57.49,Default,,0,0,0,,Мен сәл ғана құладым.
Dialogue: 0,0:31:57.58,0:31:59.95,Default,,0,0,0,,Жоқ, бұл жай ғана құлау...
Dialogue: 0,0:32:00.04,0:32:02.42,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:32:03.08,0:32:04.46,Default,,0,0,0,,Ммм
Dialogue: 0,0:32:05.96,0:32:08.09,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:32:09.46,0:32:10.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:32:13.38,0:32:15.22,Default,,0,0,0,,Сіз шынымен құлап қалдыңыз ба?
Dialogue: 0,0:32:15.30,0:32:16.14,Default,,0,0,0,,Иә
Dialogue: 0,0:32:16.22,0:32:17.76,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:32:17.85,0:32:20.77,Default,,0,0,0,,Нашар Жаман Мен дұрыс қарамадым
Dialogue: 0,0:32:20.85,0:32:21.98,Default,,0,0,0,,Кун
Dialogue: 0,0:32:31.82,0:32:33.03,Default,,0,0,0,,...
Dialogue: 0,0:32:33.11,0:32:35.49,Default,,0,0,0,,- Иә? - Энн Энн!
Dialogue: 0,0:32:35.57,0:32:37.49,Default,,0,0,0,,Не болды? Широ
Dialogue: 0,0:32:38.37,0:32:39.45,Default,,0,0,0,,Уау
Dialogue: 0,0:32:39.54,0:32:40.75,Default,,0,0,0,,Кун
Dialogue: 0,0:32:40.83,0:32:42.62,Default,,0,0,0,,Нана... Нана!
Dialogue: 0,0:32:46.50,0:32:48.34,Default,,0,0,0,,Жоқ
Dialogue: 0,0:32:50.09,0:32:51.63,Default,,0,0,0,,На...
Dialogue: 0,0:32:53.76,0:32:54.59,Default,,0,0,0,,Нт
Dialogue: 0,0:32:58.81,0:33:00.43,Default,,0,0,0,,На...
Dialogue: 0,0:33:06.77,0:33:08.19,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:33:09.15,0:33:10.32,Default,,0,0,0,,На…
Dialogue: 0,0:33:13.95,0:33:14.78,Default,,0,0,0,,Нт
Dialogue: 0,0:33:20.58,0:33:21.79,Default,,0,0,0,,Жоқ
Dialogue: 0,0:33:23.54,0:33:24.96,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:33:29.29,0:33:31.55,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:33:32.38,0:33:33.59,Default,,0,0,0,,Нана!
Dialogue: 0,0:33:33.67,0:33:35.51,Default,,0,0,0,,Нана!
Dialogue: 0,0:33:36.76,0:33:38.34,Default,,0,0,0,,Ол болған жоқ.
Dialogue: 0,0:33:38.43,0:33:39.47,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:33:39.55,0:33:41.81,Default,,0,0,0,,Осылай іздеп көрейік.
Dialogue: 0,0:33:41.89,0:33:43.43,Default,,0,0,0,,(Изуку) Мүмкін. Оятып алғаным үшін кешір.
Dialogue: 0,0:33:43.52,0:33:44.85,Default,,0,0,0,,Нана!
Dialogue: 0,0:33:44.93,0:33:46.64,Default,,0,0,0,,-Нана? -(Казама-кун) Нана
Dialogue: 0,0:33:46.73,0:33:48.06,Default,,0,0,0,,Нана!
Dialogue: 0,0:33:48.15,0:33:49.40,Default,,0,0,0,,Нана!
Dialogue: 0,0:33:50.48,0:33:51.36,Default,,0,0,0,,Нана?
Dialogue: 0,0:33:52.02,0:33:53.32,Default,,0,0,0,,Нана!
Dialogue: 0,0:33:53.40,0:33:55.32,Default,,0,0,0,,Нана~!
Dialogue: 0,0:33:57.74,0:33:59.20,Default,,0,0,0,,На…
Dialogue: 0,0:34:02.33,0:34:05.29,Default,,0,0,0,,Жоқ... Жоқ! Жоқ!
Dialogue: 0,0:34:06.16,0:34:08.29,Default,,0,0,0,,Энн! Энн!
Dialogue: 0,0:34:08.37,0:34:09.21,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:34:09.29,0:34:11.67,Default,,0,0,0,,Жоқ! Жоқ!
Dialogue: 0,0:34:11.75,0:34:13.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:13.21,0:34:15.59,Default,,0,0,0,,Жоқ... иә?
Dialogue: 0,0:34:17.63,0:34:18.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:34:19.01,0:34:21.76,Default,,0,0,0,,Нах нах нах...
Dialogue: 0,0:34:21.85,0:34:23.47,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:34:24.72,0:34:26.52,Default,,0,0,0,,Жақсы болды.
Dialogue: 0,0:34:27.39,0:34:29.06,Default,,0,0,0,,Сонымен, үйге барасың ба?
Dialogue: 0,0:34:29.15,0:34:32.23,Default,,0,0,0,,На~ На~
Dialogue: 0,0:34:36.78,0:34:40.16,Default,,0,0,0,,Қош келдіңіздер, монша қайнап жатыр.
Dialogue: 0,0:34:40.24,0:34:43.20,Default,,0,0,0,,Уау! Широ, Нана, мен саған қосыламын.
Dialogue: 0,0:34:43.28,0:34:44.12,Default,,0,0,0,,Энн!
Dialogue: 0,0:34:46.29,0:34:48.08,Default,,0,0,0,,Бүгінгі күн туралы.
Dialogue: 0,0:34:48.16,0:34:49.08,Default,,0,0,0,,О
Dialogue: 0,0:34:51.13,0:34:55.76,Default,,0,0,0,,Жарайды... бұл туралы көп уайымдамаңыз.
Dialogue: 0,0:34:55.84,0:34:57.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:34:58.59,0:35:00.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:35:00.89,0:35:02.76,Default,,0,0,0,,Ухехехе...
Dialogue: 0,0:35:03.51,0:35:04.72,Default,,0,0,0,,Уф
Dialogue: 0,0:35:05.68,0:35:08.77,Default,,0,0,0,,Ах~
Dialogue: 0,0:35:08.85,0:35:12.94,Default,,0,0,0,,...
Dialogue: 0,0:35:14.69,0:35:16.44,Default,,0,0,0,,Широ да тасталды.
Dialogue: 0,0:35:16.53,0:35:19.61,Default,,0,0,0,,Синносуке сені үйге әкелді, солай ма?
Dialogue: 0,0:35:19.70,0:35:21.41,Default,,0,0,0,,Не болды? кенеттен
Dialogue: 0,0:35:21.49,0:35:23.03,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:35:23.12,0:35:24.70,Default,,0,0,0,,Мен Нанаға қарап тұрғанымда
Dialogue: 0,0:35:24.78,0:35:29.08,Default,,0,0,0,,Осылайша Широ екеуміз бір отбасы болдық.
Dialogue: 0,0:35:29.16,0:35:31.17,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:35:31.25,0:35:32.42,Default,,0,0,0,,О
Dialogue: 0,0:35:33.54,0:35:36.05,Default,,0,0,0,,Балалар керемет, солай емес пе?
Dialogue: 0,0:35:36.13,0:35:37.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:35:37.21,0:35:41.55,Default,,0,0,0,,-Ах~ -На~
Dialogue: 0,0:35:37.21,0:35:41.55,Default,,0,0,0,,...
Dialogue: 0,0:35:43.22,0:35:45.10,Default,,0,0,0,,Бүгін көңілді болды, Йоширин
Dialogue: 0,0:35:45.18,0:35:47.10,Default,,0,0,0,,Дұрыс, Мичи.
Dialogue: 0,0:35:49.10,0:35:50.06,Default,,0,0,0,,Я...
Dialogue: 0,0:35:51.60,0:35:53.52,Default,,0,0,0,,- (Мацузака мырза) Ооо - (Билли) Ах!
Dialogue: 0,0:35:57.32,0:35:59.24,Default,,0,0,0,,Мынау қандай әдемі жігіт?
Dialogue: 0,0:35:59.32,0:36:01.40,Default,,0,0,0,,Әйелдерге көзің жоқ.
Dialogue: 0,0:36:01.49,0:36:02.70,Default,,0,0,0,,Уаааа
Dialogue: 0,0:36:03.41,0:36:04.66,Default,,0,0,0,,Дұрыс емес пе?
Dialogue: 0,0:36:09.20,0:36:11.62,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:36:14.13,0:36:17.63,Default,,0,0,0,,Бури Бури~ Бури Бури~...
Dialogue: 0,0:36:14.13,0:36:17.63,Default,,0,0,0,,Нана нана~ Нана нана~…
Dialogue: 0,0:36:18.42,0:36:20.30,Default,,0,0,0,,Нана кеттік!
Dialogue: 0,0:36:20.38,0:36:23.26,Default,,0,0,0,,Жоқ... жоқ
Dialogue: 0,0:36:23.34,0:36:24.47,Default,,0,0,0,,Не!?
Dialogue: 0,0:36:25.09,0:36:26.97,Default,,0,0,0,,На~ На!
Dialogue: 0,0:36:27.05,0:36:28.31,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:36:29.10,0:36:30.81,Default,,0,0,0,,Вау Нана, бұл керемет.
Dialogue: 0,0:36:30.89,0:36:33.02,Default,,0,0,0,,...
Dialogue: 0,0:36:33.10,0:36:35.65,Default,,0,0,0,,Күннен күнге күшейесің.
Dialogue: 0,0:36:35.73,0:36:38.32,Default,,0,0,0,,Өсудің жазындай.
Dialogue: 0,0:36:38.40,0:36:42.74,Default,,0,0,0,,Біздің де қолымыздан келе ме деп ойлаймын, өсу жазы
Dialogue: 0,0:36:42.82,0:36:45.95,Default,,0,0,0,,Достық морж?
Dialogue: 0,0:36:46.03,0:36:47.91,Default,,0,0,0,,Әй~ Әй, ау, ау
Dialogue: 0,0:36:47.99,0:36:49.87,Default,,0,0,0,,Бұл мүлдем басқа!
Dialogue: 0,0:36:49.95,0:36:52.33,Default,,0,0,0,,Жоқ, Казама-санның жынысы~
Dialogue: 0,0:36:52.41,0:36:54.04,Default,,0,0,0,,Онда...
Dialogue: 0,0:36:54.62,0:36:56.00,Default,,0,0,0,,- (Билли) Жігіттер! -сурет?
Dialogue: 0,0:36:57.25,0:36:59.46,Default,,0,0,0,,Жоқ! Жоқ, жоқ, жоқ…
Dialogue: 0,0:36:59.55,0:37:01.46,Default,,0,0,0,,- (Билли) Аман-есен болғаныңызға қуаныштымын - Жоқ!
Dialogue: 0,0:37:01.55,0:37:03.42,Default,,0,0,0,,Мен сені сағындым
Dialogue: 0,0:37:03.51,0:37:05.89,Default,,0,0,0,,Әй~ Әй, ау, ау
Dialogue: 0,0:37:05.97,0:37:07.43,Default,,0,0,0,,Мені бірге сағынба
Dialogue: 0,0:37:07.51,0:37:08.35,Default,,0,0,0,,Ау~
Dialogue: 0,0:37:09.47,0:37:11.43,Default,,0,0,0,,Осы баланы маған қайтарып бере аласыз ба?
Dialogue: 0,0:37:11.52,0:37:13.10,Default,,0,0,0,,Сенің ағаң кім?
Dialogue: 0,0:37:13.18,0:37:15.06,Default,,0,0,0,,Бұл баланың иесі.
Dialogue: 0,0:37:15.81,0:37:17.02,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:37:17.10,0:37:20.40,Default,,0,0,0,,Мен болмасам, мен бұл баланы өсіре алмаймын.
Dialogue: 0,0:37:21.32,0:37:22.44,Default,,0,0,0,,Ах
Dialogue: 0,0:37:23.24,0:37:24.99,Default,,0,0,0,,Анан Анан
Dialogue: 0,0:37:25.07,0:37:27.11,Default,,0,0,0,,Энн Энн!
Dialogue: 0,0:37:27.20,0:37:29.08,Default,,0,0,0,,- (Билли) Ах - Нах... Жоқ.
Dialogue: 0,0:37:29.70,0:37:30.87,Default,,0,0,0,,Жоқ
Dialogue: 0,0:37:32.66,0:37:33.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:37:35.00,0:37:36.42,Default,,0,0,0,,Анан!
Dialogue: 0,0:37:37.21,0:37:38.67,Default,,0,0,0,,Жүріңдер, келіңдер.
Dialogue: 0,0:37:38.75,0:37:40.38,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:37:40.46,0:37:41.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:42.42,0:37:44.55,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:37:44.63,0:37:47.51,Default,,0,0,0,,Уау... аа
Dialogue: 0,0:37:48.64,0:37:50.47,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:37:50.55,0:37:52.39,Default,,0,0,0,,Иә? Динозаврларға арналған гид...
Dialogue: 0,0:37:52.47,0:37:54.18,Default,,0,0,0,,Ангела-чан
Dialogue: 0,0:37:54.27,0:37:56.48,Default,,0,0,0,,Ой~ Әй, ау...
Dialogue: 0,0:37:56.56,0:37:58.52,Default,,0,0,0,,Сіз мұны қанша уақыттан бері істеп жүрсіз?
Dialogue: 0,0:38:00.61,0:38:03.44,Default,,0,0,0,,Жоқ... атмосфера бұрынғыдан өзгеше.
Dialogue: 0,0:38:03.53,0:38:04.40,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:38:04.49,0:38:07.15,Default,,0,0,0,,Бұл сөзсіз Гап Мо.
Dialogue: 0,0:38:07.24,0:38:08.82,Default,,0,0,0,,Менің айтып отырғаным бұл емес.
Dialogue: 0,0:38:08.91,0:38:12.28,Default,,0,0,0,,Сен маған көп қиындық тудырдың.
Dialogue: 0,0:38:12.37,0:38:14.79,Default,,0,0,0,,Бірақ мен оны үйіне апарамын!
Dialogue: 0,0:38:14.79,0:38:15.71,Default,,0,0,0,,Бірақ мен оны үйіне апарамын!
Dialogue: 0,0:38:14.79,0:38:15.71,Default,,0,0,0,,Жоқ
Dialogue: 0,0:38:16.58,0:38:18.17,Default,,0,0,0,,Мына баланы алып, тез қаш!
Dialogue: 0,0:38:18.25,0:38:19.79,Default,,0,0,0,,-Жібер! -Анн!
Dialogue: 0,0:38:19.88,0:38:21.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:22.96,0:38:24.09,Default,,0,0,0,,Шық!
Dialogue: 0,0:38:24.84,0:38:27.05,Default,,0,0,0,,Трилобит блогы Келіңіздер!
Dialogue: 0,0:38:28.47,0:38:29.51,Default,,0,0,0,,U~
Dialogue: 0,0:38:29.59,0:38:30.76,Default,,0,0,0,,- Иә! -Ооо
Dialogue: 0,0:38:30.85,0:38:33.14,Default,,0,0,0,,Триас қалыптастыруға барайық!
Dialogue: 0,0:38:33.76,0:38:34.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:38:34.68,0:38:36.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:38:37.89,0:38:38.77,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:38:47.32,0:38:48.15,Default,,0,0,0,,Күн!
Dialogue: 0,0:38:49.03,0:38:49.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:38:50.74,0:38:51.57,Default,,0,0,0,,Шайнаңыз!
Dialogue: 0,0:38:54.12,0:38:56.00,Default,,0,0,0,,- (Казама-кун) Уау! -Браво!
Dialogue: 0,0:38:56.08,0:38:58.25,Default,,0,0,0,,Енді олар біркелкі орналасқан емес пе?
Dialogue: 0,0:38:58.33,0:38:59.21,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:38:59.29,0:39:00.62,Default,,0,0,0,,Мен сәл дұрыс айтамын ба?
Dialogue: 0,0:39:00.71,0:39:01.71,Default,,0,0,0,,Мүмкін мен қателескен шығармын
Dialogue: 0,0:39:01.79,0:39:02.88,Default,,0,0,0,,Қалыптастыру маңызды емес!
Dialogue: 0,0:39:03.42,0:39:04.84,Default,,0,0,0,,-Мм? -Ой?
Dialogue: 0,0:39:04.92,0:39:06.80,Default,,0,0,0,,- Энн! -(үшін) иә?
Dialogue: 0,0:39:07.42,0:39:08.26,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:39:08.34,0:39:10.30,Default,,0,0,0,,Энн Энн Энн Энн!
Dialogue: 0,0:39:10.38,0:39:11.22,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:39:13.51,0:39:15.89,Default,,0,0,0,,Бірдеңе келді! Иә иә
Dialogue: 0,0:39:19.14,0:39:21.35,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:39:21.44,0:39:23.23,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:39:25.61,0:39:26.98,Default,,0,0,0,,Енді қаша алмайсың.
Dialogue: 0,0:39:27.07,0:39:27.94,Default,,0,0,0,,Уф
Dialogue: 0,0:39:29.49,0:39:32.36,Default,,0,0,0,,Енді оны қайтарыңыз.
Dialogue: 0,0:39:33.41,0:39:34.33,Default,,0,0,0,,Кун...
Dialogue: 0,0:39:34.41,0:39:35.41,Default,,0,0,0,,Широ…
Dialogue: 0,0:39:35.49,0:39:36.79,Default,,0,0,0,,Жоқ
Dialogue: 0,0:39:36.87,0:39:38.00,Default,,0,0,0,,Уау
Dialogue: 0,0:39:38.70,0:39:41.29,Default,,0,0,0,,Уау, аа, аа, а...
Dialogue: 0,0:39:41.37,0:39:42.54,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:39:42.63,0:39:44.96,Default,,0,0,0,,- Жоқ! -(Санё) Уау!
Dialogue: 0,0:39:45.67,0:39:48.17,Default,,0,0,0,,Тынш... жоқ!
Dialogue: 0,0:39:48.26,0:39:49.38,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:39:50.22,0:39:51.93,Default,,0,0,0,,-Анан... -Міне!
Dialogue: 0,0:39:52.01,0:39:52.84,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:39:53.51,0:39:54.35,Default,,0,0,0,,Энн!
Dialogue: 0,0:39:54.43,0:39:56.31,Default,,0,0,0,,Мен... дәл қазір
Dialogue: 0,0:39:56.39,0:39:58.10,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:39:59.85,0:40:01.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:02.65,0:40:03.98,Default,,0,0,0,,Хмм
Dialogue: 0,0:40:05.27,0:40:09.99,Default,,0,0,0,,Ауа-райының қолайсыздығына байланысты біз бүгін жабық боламыз.
Dialogue: 0,0:40:10.07,0:40:13.41,Default,,0,0,0,,үшінңыз, үйге қайтқанда абайлаңыздар.
Dialogue: 0,0:40:13.49,0:40:15.37,Default,,0,0,0,,Біз өте өкінеміз.
Dialogue: 0,0:40:15.45,0:40:19.29,Default,,0,0,0,,Ауа-райының қолайсыздығына байланысты біз бүгін жабық боламыз.
Dialogue: 0,0:40:19.91,0:40:23.29,Default,,0,0,0,,Мен оны және Биллиді Касукабеден таптым.
Dialogue: 0,0:40:23.37,0:40:24.75,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:40:24.83,0:40:26.75,Default,,0,0,0,,Сағындыңыз ба?
Dialogue: 0,0:40:26.84,0:40:30.55,Default,,0,0,0,,Кешіріңіз, келесі жолы...
Dialogue: 0,0:40:31.30,0:40:33.22,Default,,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:40:33.30,0:40:35.93,Default,,0,0,0,,Сен маған керек емессің
Dialogue: 0,0:40:36.72,0:40:39.10,Default,,0,0,0,,Енді маған жүзіңді көрсетпе
Dialogue: 0,0:40:39.72,0:40:43.06,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:40:49.73,0:40:51.94,Default,,0,0,0,,3-қақпаны ашыңыз.
Dialogue: 0,0:40:52.78,0:40:54.41,Default,,0,0,0,,12 қақпа, жабыңыз.
Dialogue: 0,0:40:55.95,0:40:57.41,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:40:58.87,0:41:00.83,Default,,0,0,0,,Аа, қазірдің өзінде
Dialogue: 0,0:41:13.26,0:41:14.63,Default,,0,0,0,,Жаңбыр қатты жауып тұр
Dialogue: 0,0:41:17.72,0:41:19.10,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,0:41:19.18,0:41:21.56,Default,,0,0,0,,Нананың нағыз иесі болса
Dialogue: 0,0:41:21.64,0:41:23.39,Default,,0,0,0,,Мен оны қайтаруым керек пе?
Dialogue: 0,0:41:23.48,0:41:26.73,Default,,0,0,0,,Не? Дұрыс
Dialogue: 0,0:41:28.11,0:41:29.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:31.03,0:41:34.57,Default,,0,0,0,,Дино аралынан қашып кеткенге ұқсайтын динозавр
Dialogue: 0,0:41:34.65,0:41:36.74,Default,,0,0,0,,Қаладағы шабуыл
Dialogue: 0,0:41:36.82,0:41:41.37,Default,,0,0,0,,Қазіргі уақытта бүкіл Чуо Уорд аймағына шұғыл эвакуациялау туралы бұйрық шығарылды.
Dialogue: 0,0:41:41.45,0:41:42.37,Default,,0,0,0,,үшінңыз, сабыр сақтап, эвакуацияланыңыздар.
Dialogue: 0,0:41:42.37,0:41:45.33,Default,,0,0,0,,үшінңыз, сабыр сақтап, эвакуацияланыңыздар.
Dialogue: 0,0:41:42.37,0:41:45.33,Default,,0,0,0,,А... неге?
Dialogue: 0,0:41:45.41,0:41:47.29,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:41:47.37,0:41:51.71,Default,,0,0,0,,А, мен мұны істедім деп ойлаймын.
Dialogue: 0,0:41:51.80,0:41:54.63,Default,,0,0,0,,Неліктен қақпа ашық!
Dialogue: 0,0:41:56.18,0:41:58.43,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:41:58.51,0:42:02.77,Default,,0,0,0,,Мүмкін найзағай жүйеде қысқа тұйықталуды тудырған шығар?
Dialogue: 0,0:42:04.10,0:42:06.48,Default,,0,0,0,,Динозавр әмбебап дүкенге соқтығысты!
Dialogue: 0,0:42:06.56,0:42:10.27,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:42:11.44,0:42:12.78,Default,,0,0,0,,Иә? Иә!?
Dialogue: 0,0:42:12.78,0:42:14.65,Default,,0,0,0,,Иә? Иә!?
Dialogue: 0,0:42:12.78,0:42:14.65,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:42:14.74,0:42:17.40,Default,,0,0,0,,Жоқ... бұл робот.
Dialogue: 0,0:42:17.49,0:42:21.28,Default,,0,0,0,,Дино аралындағы динозаврлар роботтар!
Dialogue: 0,0:42:24.29,0:42:27.54,Default,,0,0,0,,Бұл жолы да керемет болды.
Dialogue: 0,0:42:27.62,0:42:30.88,Default,,0,0,0,,Сіздің келесі идеяңыз бар ма?
Dialogue: 0,0:42:30.96,0:42:33.34,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:42:30.96,0:42:33.34,Default,,0,0,0,,Иә, әрине келесі жолы.
Dialogue: 0,0:42:33.34,0:42:34.84,Default,,0,0,0,,Иә, әрине келесі жолы.
Dialogue: 0,0:42:36.42,0:42:40.05,Default,,0,0,0,,Бүгін... Динозавр...
Dialogue: 0,0:42:40.14,0:42:42.22,Default,,0,0,0,,Динозаврларды қайтарайық
Dialogue: 0,0:42:42.30,0:42:43.68,Default,,0,0,0,,О!
Dialogue: 0,0:42:43.76,0:42:47.48,Default,,0,0,0,,Бұл менің «Сенбейтін» ойынымның шыңы болады.
Dialogue: 0,0:42:48.89,0:42:50.15,Default,,0,0,0,,Дино аралында
Dialogue: 0,0:42:50.23,0:42:52.61,Default,,0,0,0,,Динозаврлар біртүрлі әрекет етіп жатқан сияқты
Dialogue: 0,0:42:52.69,0:42:54.53,Default,,0,0,0,,Оны жиі көретін сияқты.
Dialogue: 0,0:42:54.61,0:42:57.65,Default,,0,0,0,,Бұл мүлдем шектен шыққан.
Dialogue: 0,0:42:57.74,0:43:00.24,Default,,0,0,0,,Роботтарды шынайы деп көрсету
Dialogue: 0,0:43:00.32,0:43:01.07,Default,,0,0,0,,«Мен әлемді нұрландырғым келеді» сияқты сөздер
Dialogue: 0,0:43:01.07,0:43:02.41,Default,,0,0,0,,«Мен әлемді нұрландырғым келеді» сияқты сөздер
Dialogue: 0,0:43:01.07,0:43:02.41,Default,,0,0,0,,Мына балалар алақандарын артқа бұрды.
Dialogue: 0,0:43:02.41,0:43:02.49,Default,,0,0,0,,Мына балалар алақандарын артқа бұрды.
Dialogue: 0,0:43:02.49,0:43:03.95,Default,,0,0,0,,Мына балалар алақандарын артқа бұрды.
Dialogue: 0,0:43:02.49,0:43:03.95,Default,,0,0,0,,Мен бұл күдікті деп ойладым.
Dialogue: 0,0:43:04.66,0:43:05.91,Default,,0,0,0,,Сондай-ақ SNS бағдарламасында
Dialogue: 0,0:43:06.00,0:43:08.71,Default,,0,0,0,,Біз көптеген пікірлер алдық.
Dialogue: 0,0:43:08.79,0:43:10.87,Default,,0,0,0,,Біткен жоқ па?
Dialogue: 0,0:43:10.96,0:43:14.55,Default,,0,0,0,,Мен аяқтаған жоқпын!
Dialogue: 0,0:43:18.63,0:43:21.93,Default,,0,0,0,,Енді мен сайттағы топ кастерінен тағы да айтып беруін сұраймын.
Dialogue: 0,0:43:22.01,0:43:24.22,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:43:27.27,0:43:30.48,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:43:32.19,0:43:37.19,Default,,0,0,0,,Хмф хаха~
Dialogue: 0,0:43:43.70,0:43:45.28,Default,,0,0,0,,(Ағып жатқан судың дыбысы)
Dialogue: 0,0:43:45.37,0:43:46.70,Default,,0,0,0,,Ах~
Dialogue: 0,0:43:59.05,0:44:00.72,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:44:03.68,0:44:05.72,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:44:06.35,0:44:07.47,Default,,0,0,0,,Әй?
Dialogue: 0,0:44:10.93,0:44:14.40,Default,,0,0,0,,Әй әке, оян, оян.
Dialogue: 0,0:44:14.48,0:44:16.52,Default,,0,0,0,,-Мен енді іше алмаймын... -Эй
Dialogue: 0,0:44:16.61,0:44:18.11,Default,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,0:44:18.19,0:44:20.57,Default,,0,0,0,,Анашым, үлкен көздер
Dialogue: 0,0:44:22.24,0:44:23.78,Default,,0,0,0,,-Мм? -а?
Dialogue: 0,0:44:24.66,0:44:26.16,Default,,0,0,0,,Ештеңе.
Dialogue: 0,0:44:26.24,0:44:28.24,Default,,0,0,0,,Сіз армандаған жоқсыз ба?
Dialogue: 0,0:44:28.33,0:44:30.20,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:44:30.29,0:44:31.46,Default,,0,0,0,,Әй?
Dialogue: 0,0:44:36.71,0:44:38.05,Default,,0,0,0,,Көз…
Dialogue: 0,0:44:38.71,0:44:40.09,Default,,0,0,0,,Көздер!
Dialogue: 0,0:44:40.17,0:44:41.76,Default,,0,0,0,,-Уау -Бұл не?
Dialogue: 0,0:44:41.84,0:44:43.30,Default,,0,0,0,,- Шинносуке! -Күнбағыс!
Dialogue: 0,0:44:43.38,0:44:44.39,Default,,0,0,0,,Сыртқа асығыңыз!
Dialogue: 0,0:44:48.43,0:44:50.31,Default,,0,0,0,,-Таяя~ -Кё... Динозавр!?
Dialogue: 0,0:44:55.90,0:44:57.65,Default,,0,0,0,,Керемет!
Dialogue: 0,0:44:57.73,0:45:00.07,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:45:00.78,0:45:02.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:06.16,0:45:09.54,Default,,0,0,0,,Ах! Несие алғаныма әлі 32 жыл қалды.
Dialogue: 0,0:45:09.62,0:45:11.50,Default,,0,0,0,,Бұл бәрі емес!
Dialogue: 0,0:45:14.04,0:45:15.29,Default,,0,0,0,,На?
Dialogue: 0,0:45:19.42,0:45:21.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:22.38,0:45:23.80,Default,,0,0,0,,Ах
Dialogue: 0,0:45:23.88,0:45:25.76,Default,,0,0,0,,Жоқ... олар мұнда неге жиналып жатыр?
Dialogue: 0,0:45:25.84,0:45:28.22,Default,,0,0,0,,Уау, өте танымал~
Dialogue: 0,0:45:28.30,0:45:29.60,Default,,0,0,0,,Егер сіз бақытты болсаңыз!
Dialogue: 0,0:45:29.68,0:45:30.85,Default,,0,0,0,,Шинносуке! Мұнда тез кел!
Dialogue: 0,0:45:30.85,0:45:32.10,Default,,0,0,0,,Шинносуке! Мұнда тез кел!
Dialogue: 0,0:45:30.85,0:45:32.10,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:45:32.10,0:45:33.14,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:45:34.02,0:45:35.39,Default,,0,0,0,,Оны тек сен ғана көресің
Dialogue: 0,0:45:35.48,0:45:38.31,Default,,0,0,0,,А, ұлу
Dialogue: 0,0:45:41.36,0:45:42.40,Default,,0,0,0,,Робот?
Dialogue: 0,0:45:44.32,0:45:45.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:46.28,0:45:47.16,Default,,0,0,0,,Жүр!
Dialogue: 0,0:45:47.24,0:45:48.95,Default,,0,0,0,,О, ағайын!
Dialogue: 0,0:45:49.03,0:45:50.62,Default,,0,0,0,,-Сендер бір-біріңді білесіңдер ме? -Иә
Dialogue: 0,0:45:50.70,0:45:53.08,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:45:56.08,0:45:58.21,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:46:01.84,0:46:03.01,Default,,0,0,0,,Хмм
Dialogue: 0,0:46:07.55,0:46:08.93,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:46:09.01,0:46:12.01,Default,,0,0,0,,Мен оны осы баламен тыныш өмір сүруім үшін сатып алдым.
Dialogue: 0,0:46:12.72,0:46:16.23,Default,,0,0,0,,Мен Билли Одорокимін, динозаврды зерттеуші.
Dialogue: 0,0:46:16.31,0:46:18.40,Default,,0,0,0,,Ола Синносуке Нохара!
Dialogue: 0,0:46:18.48,0:46:20.44,Default,,0,0,0,,Маған қысқаша Брэдпи деп қоңырау шалыңыз.
Dialogue: 0,0:46:20.52,0:46:22.78,Default,,0,0,0,,Не, Одорокки...
Dialogue: 0,0:46:22.86,0:46:25.40,Default,,0,0,0,,Иә, мен Bubble Одорокидің ұлымын.
Dialogue: 0,0:46:25.49,0:46:26.40,Default,,0,0,0,,Иә!?
Dialogue: 0,0:46:26.49,0:46:28.28,Default,,0,0,0,,Нана~
Dialogue: 0,0:46:28.36,0:46:29.57,Default,,0,0,0,,Сыртқа шыққыңыз келе ме?
Dialogue: 0,0:46:29.66,0:46:30.49,Default,,0,0,0,,Нт
Dialogue: 0,0:46:30.57,0:46:33.45,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:46:34.16,0:46:37.29,Default,,0,0,0,,Бірақ сенің әкең неліктен бұлай жасайды?
Dialogue: 0,0:46:37.92,0:46:43.25,Default,,0,0,0,,Әкем шынымен де мейірімді, арманымды қолдайтын.
Dialogue: 0,0:46:44.71,0:46:48.22,Default,,0,0,0,,Билли динозаврларды жақсы көреді.
Dialogue: 0,0:46:48.30,0:46:50.18,Default,,0,0,0,,Сіз болашақта динозавр дәрігерісіз бе?
Dialogue: 0,0:46:50.26,0:46:54.14,Default,,0,0,0,,Мен зерттеуші боламын! Динозаврларды қайтарыңыз
Dialogue: 0,0:46:54.22,0:46:57.60,Default,,0,0,0,,О, бұл сенгісіз.
Dialogue: 0,0:46:57.68,0:47:01.65,Default,,0,0,0,,Уәде беремін, асыға күтемін.
Dialogue: 0,0:47:03.15,0:47:06.28,Default,,0,0,0,,Бірақ ол барған сайын танымал болды.
Dialogue: 0,0:47:06.86,0:47:09.86,Default,,0,0,0,,Менің әкем өзгерді.
Dialogue: 0,0:47:11.03,0:47:12.66,Default,,0,0,0,,Осы уақытта әкем
Dialogue: 0,0:47:12.74,0:47:16.41,Default,,0,0,0,,Біз әлемге динозаврларды әкелетінімізді жарияладық.
Dialogue: 0,0:47:16.50,0:47:19.37,Default,,0,0,0,,Бірақ олардың барлығы робот емес пе?
Dialogue: 0,0:47:19.46,0:47:23.50,Default,,0,0,0,,Маған нағыз динозаврды тірілтуді тапсырды.
Dialogue: 0,0:47:23.59,0:47:25.09,Default,,0,0,0,,Зерттеуді жалғастыру
Dialogue: 0,0:47:25.84,0:47:29.26,Default,,0,0,0,,Қазба қалдықтарынан ДНҚ мен белоктарды анықтау...
Dialogue: 0,0:47:30.01,0:47:33.18,Default,,0,0,0,,Бірақ эксперимент сәтсіздіктерге толы болды.
Dialogue: 0,0:47:33.26,0:47:34.85,Default,,0,0,0,,Ал менің әкем...
Dialogue: 0,0:47:35.81,0:47:38.81,Default,,0,0,0,,Әрбір жарыс үшін AI интеллектімен жабдықталған
Dialogue: 0,0:47:38.89,0:47:43.56,Default,,0,0,0,,Қаңқа арнайы қорытпадан жасалып, синтетикалық терімен қапталған.
Dialogue: 0,0:47:43.65,0:47:44.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:47:44.82,0:47:47.44,Default,,0,0,0,,Бұл сіздің өтірік айтып тұрғаныңызды білдіре ме?
Dialogue: 0,0:47:48.11,0:47:51.28,Default,,0,0,0,,Бұл дүниедегі ақымақтар оны көре ала ма?
Dialogue: 0,0:47:51.36,0:47:55.87,Default,,0,0,0,,Ең алдымен олар нағыз динозаврды жасай алмайды.
Dialogue: 0,0:47:57.12,0:48:00.83,Default,,0,0,0,,Әке, маған берген уәдеңізді ұмыттыңыз ба?
Dialogue: 0,0:48:00.91,0:48:03.79,Default,,0,0,0,,Уәде? Сен не туралы айтып тұрсың?
Dialogue: 0,0:48:03.88,0:48:05.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:05.34,0:48:09.30,Default,,0,0,0,,Сіз зерттеген деректер роботтарды жасауда да пайдаланылады.
Dialogue: 0,0:48:09.38,0:48:10.22,Default,,0,0,0,,Ах
Dialogue: 0,0:48:11.09,0:48:15.89,Default,,0,0,0,,Атап айтқанда, қаңқаның пішіні дауысты естіген динозаврлардың бір түріне ұқсайды.
Dialogue: 0,0:48:15.97,0:48:18.14,Default,,0,0,0,,Бұл шынайы қарым-қатынасқа көмектесті.
Dialogue: 0,0:48:18.22,0:48:19.73,Default,,0,0,0,,Енді сіз қауіпсізсіз
Dialogue: 0,0:48:19.81,0:48:22.27,Default,,0,0,0,,Дино аралын ашуға болады
Dialogue: 0,0:48:22.35,0:48:25.23,Default,,0,0,0,,Нәтижелер зая кетпегеніне қуаныштымын.
Dialogue: 0,0:48:28.78,0:48:31.28,Default,,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:48:32.20,0:48:33.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:48:37.03,0:48:38.20,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:48:46.29,0:48:48.17,Default,,0,0,0,,Шынымен де кездейсоқ I
Dialogue: 0,0:48:48.25,0:48:52.34,Default,,0,0,0,,Нағыз динозавр Спинозаврды қайтара алды
Dialogue: 0,0:48:52.42,0:48:53.30,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:48:53.38,0:48:56.97,Default,,0,0,0,,Нана шығар?
Dialogue: 0,0:48:57.05,0:48:58.22,Default,,0,0,0,,На?
Dialogue: 0,0:48:58.31,0:49:00.68,Default,,0,0,0,,Бұл бала нағыз динозавр ма?
Dialogue: 0,0:49:01.31,0:49:02.14,Default,,0,0,0,,Иә
Dialogue: 0,0:49:02.23,0:49:03.64,Default,,0,0,0,,Иә!?
Dialogue: 0,0:49:03.73,0:49:04.56,Default,,0,0,0,,На?
Dialogue: 0,0:49:04.65,0:49:05.60,Default,,0,0,0,,Энн Энн!
Dialogue: 0,0:49:05.69,0:49:06.65,Default,,0,0,0,,Жоқ
Dialogue: 0,0:49:06.73,0:49:10.07,Default,,0,0,0,,Сіз неге таң қалдыңыз?
Dialogue: 0,0:49:10.15,0:49:12.69,Default,,0,0,0,,Қазір әкеме берсем
Dialogue: 0,0:49:12.78,0:49:15.53,Default,,0,0,0,,Менің басымнан қандай сұмдық болады екен...
Dialogue: 0,0:49:15.61,0:49:18.49,Default,,0,0,0,,Сөйтіп екеуі бірге қашып кетті.
Dialogue: 0,0:49:18.58,0:49:21.33,Default,,0,0,0,,Нана Ол динозавр болды ма?
Dialogue: 0,0:49:21.41,0:49:22.96,Default,,0,0,0,,Жоқ
Dialogue: 0,0:49:23.04,0:49:26.75,Default,,0,0,0,,Білесің бе, мен ол қызды Нана деп атаймын.
Dialogue: 0,0:49:26.83,0:49:28.54,Default,,0,0,0,,Оның ұл екенін білесің бе?
Dialogue: 0,0:49:28.63,0:49:30.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:49:30.09,0:49:32.96,Default,,0,0,0,,Жалпы айтқанда, бұл бала «Спитаро» деп аталады.
Dialogue: 0,0:49:33.05,0:49:35.59,Default,,0,0,0,,Менің ойлаған есімім бар.
Dialogue: 0,0:49:36.93,0:49:39.22,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,0:49:39.30,0:49:41.06,Default,,0,0,0,,Бұл дерлік бірдей.
Dialogue: 0,0:49:41.14,0:49:44.02,Default,,0,0,0,,О, дұрыс, Спитаро.
Dialogue: 0,0:49:44.69,0:49:45.98,Default,,0,0,0,,На?
Dialogue: 0,0:49:46.65,0:49:48.11,Default,,0,0,0,,Мен жауап бермеймін
Dialogue: 0,0:49:48.19,0:49:49.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:49.36,0:49:52.07,Default,,0,0,0,,Онда бұрынғыдай Нана.
Dialogue: 0,0:49:52.15,0:49:53.44,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:49:53.53,0:49:55.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:49:53.53,0:49:55.07,Default,,0,0,0,,Сіз осындай жерде болдыңыз.
Dialogue: 0,0:49:55.07,0:49:55.53,Default,,0,0,0,,Сіз осындай жерде болдыңыз.
Dialogue: 0,0:49:56.24,0:49:57.49,Default,,0,0,0,,О~
Dialogue: 0,0:49:57.57,0:49:58.87,Default,,0,0,0,,Кім?
Dialogue: 0,0:49:58.95,0:50:01.33,Default,,0,0,0,,Динозаврдың гид-ханымы
Dialogue: 0,0:50:01.41,0:50:03.79,Default,,0,0,0,,Анджела Одороки
Dialogue: 0,0:50:03.87,0:50:06.25,Default,,0,0,0,,Бұл менің әпкем.
Dialogue: 0,0:50:06.33,0:50:08.08,Default,,0,0,0,,Әпке?
Dialogue: 0,0:50:08.17,0:50:09.71,Default,,0,0,0,,Анджела…чан
Dialogue: 0,0:50:10.67,0:50:14.01,Default,,0,0,0,,Қалайсың? Тар жер, бірақ...
Dialogue: 0,0:50:14.09,0:50:16.05,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:50:16.13,0:50:19.80,Default,,0,0,0,,Сіз динозаврлардың гидшісісіз бе? Бұл қиын жұмыс, солай емес пе?
Dialogue: 0,0:50:19.89,0:50:22.35,Default,,0,0,0,,Менің де динозаврға ұқсайтын әйелім бар...
Dialogue: 0,0:50:24.39,0:50:25.52,Default,,0,0,0,,Гааах!
Dialogue: 0,0:50:25.60,0:50:28.73,Default,,0,0,0,,Билли, неге оны әкеңе бермедің?
Dialogue: 0,0:50:29.98,0:50:32.19,Default,,0,0,0,,Бұл бала әкесінің құралы емес!
Dialogue: 0,0:50:33.15,0:50:34.65,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:50:35.28,0:50:39.03,Default,,0,0,0,,Мен ата-ана ретінде бұл баланы қорғауым керек.
Dialogue: 0,0:50:40.66,0:50:44.62,Default,,0,0,0,,На~? Жоқ! Жоқ!
Dialogue: 0,0:50:44.70,0:50:46.96,Default,,0,0,0,,На на~!
Dialogue: 0,0:50:47.04,0:50:49.92,Default,,0,0,0,,Ендеше, өз ата-анаңа опасыздық жасау дұрыс па?
Dialogue: 0,0:50:50.67,0:50:53.25,Default,,0,0,0,,Маған қалаған нәрсені істеуге рұқсат етіңіз.
Dialogue: 0,0:50:53.34,0:50:56.97,Default,,0,0,0,,Мен әкеме ризамын, бірақ...
Dialogue: 0,0:50:57.05,0:51:02.64,Default,,0,0,0,,Тіпті әкелер де әлемнің күткен қысымынан зардап шегеді.
Dialogue: 0,0:51:02.72,0:51:06.73,Default,,0,0,0,,Әкемді бізден басқа кім асырай алады?
Dialogue: 0,0:51:07.93,0:51:10.40,Default,,0,0,0,,Наа аа аа…
Dialogue: 0,0:51:10.48,0:51:12.44,Default,,0,0,0,,Иә, күліңіз~
Dialogue: 0,0:51:12.52,0:51:14.36,Default,,0,0,0,,Эй, Шинносуке-кун
Dialogue: 0,0:51:14.44,0:51:16.82,Default,,0,0,0,,Наха~
Dialogue: 0,0:51:16.90,0:51:19.40,Default,,0,0,0,,Ууу...
Dialogue: 0,0:51:20.28,0:51:22.20,Default,,0,0,0,,-(Билли) Пфф хахаха... -Эй!
Dialogue: 0,0:51:22.28,0:51:23.91,Default,,0,0,0,,Анджела да солай істей ме?
Dialogue: 0,0:51:23.99,0:51:25.24,Default,,0,0,0,,Мен мұны істемеймін!
Dialogue: 0,0:51:25.33,0:51:29.83,Default,,0,0,0,,Әйтеуір, әкеме апарамын!
Dialogue: 0,0:51:29.92,0:51:32.42,Default,,0,0,0,,Анан! Анна~!
Dialogue: 0,0:51:32.50,0:51:33.92,Default,,0,0,0,,Күте тұрыңыз... бұл тағы сіз бе?
Dialogue: 0,0:51:37.46,0:51:38.84,Default,,0,0,0,,-Ааа
Dialogue: 0,0:51:39.88,0:51:40.72,Default,,0,0,0,,Ах
Dialogue: 0,0:51:44.43,0:51:46.18,Default,,0,0,0,,Біраз уақыт өтті, Билли.
Dialogue: 0,0:51:46.26,0:51:47.47,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,0:51:47.56,0:51:50.10,Default,,0,0,0,,Сіз сол кезде сізбен бірге ойнаған баласыз ба?
Dialogue: 0,0:51:50.19,0:51:51.52,Default,,0,0,0,,Жоқ
Dialogue: 0,0:51:51.60,0:51:54.19,Default,,0,0,0,,Айтайын дегенім көп.
Dialogue: 0,0:51:54.27,0:51:56.23,Default,,0,0,0,,Әзірше мен сізге осыны беруге рұқсат етіңіз.
Dialogue: 0,0:51:56.32,0:51:58.32,Default,,0,0,0,,Нана...
Dialogue: 0,0:51:59.61,0:52:02.36,Default,,0,0,0,,Дино аралының құпиясы ашылды.
Dialogue: 0,0:52:02.45,0:52:03.87,Default,,0,0,0,,Оның мағынасы жоқ.
Dialogue: 0,0:52:03.95,0:52:06.58,Default,,0,0,0,,Оны зерттеп, жаппай шығарыңыз.
Dialogue: 0,0:52:06.66,0:52:09.83,Default,,0,0,0,,Әлемді нағыз Дино аралына айналдыр
Dialogue: 0,0:52:09.91,0:52:11.92,Default,,0,0,0,,Сіз мұны істесеңіз де
Dialogue: 0,0:52:12.00,0:52:14.29,Default,,0,0,0,,Әкемді енді ешкім танымайды.
Dialogue: 0,0:52:14.38,0:52:18.71,Default,,0,0,0,,Ондай жағдайда мен олардың барлығын ұстап алып, қатені түзетемін!
Dialogue: 0,0:52:18.80,0:52:21.88,Default,,0,0,0,,Бұл қызықсыз әлемде не сенбестікке әкелуі мүмкін?
Dialogue: 0,0:52:21.97,0:52:23.76,Default,,0,0,0,,Бұл мен ғана!
Dialogue: 0,0:52:23.84,0:52:25.51,Default,,0,0,0,,Сіз не туралы ақымақсыз?
Dialogue: 0,0:52:25.60,0:52:27.68,Default,,0,0,0,,Мен саған Спитароны ешқашан бермеймін!
Dialogue: 0,0:52:27.76,0:52:28.97,Default,,0,0,0,,Нана Даттеба
Dialogue: 0,0:52:29.06,0:52:30.85,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:52:30.93,0:52:32.10,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:52:32.19,0:52:35.31,Default,,0,0,0,,Сен әлі осындасың ба, мына пайдасыз нәрсе?
Dialogue: 0,0:52:35.40,0:52:36.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:37.86,0:52:41.70,Default,,0,0,0,,Сәлем! Өз қызыңа не айтасың!
Dialogue: 0,0:52:41.78,0:52:43.99,Default,,0,0,0,,Пайдасыз деген сөз
Dialogue: 0,0:52:44.07,0:52:46.58,Default,,0,0,0,,Бұл — ашқан әке үшін қолданылатын сөз!
Dialogue: 0,0:52:46.66,0:52:48.29,Default,,0,0,0,,Иә...
Dialogue: 0,0:52:48.37,0:52:49.74,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:52:49.83,0:52:52.46,Default,,0,0,0,,Басқаларға араласудың қажеті жоқ
Dialogue: 0,0:52:52.54,0:52:55.71,Default,,0,0,0,,Бұл жігіттер өздерінің нанғысыз талантын мұра еткен жоқ.
Dialogue: 0,0:52:55.79,0:53:00.05,Default,,0,0,0,,Менің сөзімді тыңдасаң, бақытты боласың.
Dialogue: 0,0:53:00.96,0:53:04.47,Default,,0,0,0,,Сәлем! Сіз қаншалықты ғажайып екеніңізді білмеймін
Dialogue: 0,0:53:04.55,0:53:08.10,Default,,0,0,0,,Екеуіңнің бақытыңды еріксіз шешпеңдер!
Dialogue: 0,0:53:08.18,0:53:10.43,Default,,0,0,0,,Иә! Бала деген не?
Dialogue: 0,0:53:10.52,0:53:15.10,Default,,0,0,0,,Ата-анасы іздемегенде балалар өздігінен көп ойланып өседі.
Dialogue: 0,0:53:15.19,0:53:18.82,Default,,0,0,0,,Бұл мүмкіндікке сену ата-ананың міндеті!
Dialogue: 0,0:53:18.90,0:53:21.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:21.36,0:53:23.82,Default,,0,0,0,,Хмф! Бос сөздің соңы
Dialogue: 0,0:53:23.90,0:53:25.66,Default,,0,0,0,,Содан кейін динозавр...
Dialogue: 0,0:53:25.74,0:53:27.24,Default,,0,0,0,,- (Аммонер Ито) Көпіршік мырза - А?
Dialogue: 0,0:53:27.32,0:53:31.33,Default,,0,0,0,,Сіз маған сол жолды айтуға рұқсат етесіз, мен уәде беремін.
Dialogue: 0,0:53:31.41,0:53:32.25,Default,,0,0,0,,На
Dialogue: 0,0:53:32.33,0:53:35.37,Default,,0,0,0,,Хехехе, мен қазір Анджела-самадан ауысамын.
Dialogue: 0,0:53:35.46,0:53:38.67,Default,,0,0,0,,Динозавр жобасының екінші жетекшісі болды.
Dialogue: 0,0:53:38.75,0:53:40.71,Default,,0,0,0,,Бұл Аммонер Ито.
Dialogue: 0,0:53:40.80,0:53:42.67,Default,,0,0,0,,Біртүрлі шаш үлгісі
Dialogue: 0,0:53:42.76,0:53:44.38,Default,,0,0,0,,Шулы!
Dialogue: 0,0:53:44.47,0:53:47.01,Default,,0,0,0,,Менің роботым сәл басқаша.
Dialogue: 0,0:53:47.64,0:53:51.35,Default,,0,0,0,,Динозаврды күшпен алдық делік.
Dialogue: 0,0:53:53.18,0:53:54.39,Default,,0,0,0,,Уф
Dialogue: 0,0:53:56.14,0:53:58.36,Default,,0,0,0,,Керемет!
Dialogue: 0,0:54:01.27,0:54:03.69,Default,,0,0,0,,Аа... жай ғана...
Dialogue: 0,0:54:05.49,0:54:06.74,Default,,0,0,0,,Уау
Dialogue: 0,0:54:10.41,0:54:11.95,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:54:22.84,0:54:24.59,Default,,0,0,0,,(Сұңқыр дыбыс)
Dialogue: 0,0:54:24.67,0:54:27.18,Default,,0,0,0,,-Ах -Мына ақымақ
Dialogue: 0,0:54:27.26,0:54:29.18,Default,,0,0,0,,- (Мисаэ/Хироши) Уау - Ах!
Dialogue: 0,0:54:29.26,0:54:30.64,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:54:32.72,0:54:33.89,Default,,0,0,0,,Нат…
Dialogue: 0,0:54:35.77,0:54:37.23,Default,,0,0,0,,Уаааа
Dialogue: 0,0:54:37.85,0:54:39.19,Default,,0,0,0,,Гуаа уау
Dialogue: 0,0:54:39.27,0:54:41.11,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:54:41.19,0:54:43.78,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:54:43.86,0:54:46.70,Default,,0,0,0,,Ахо!
Dialogue: 0,0:54:48.66,0:54:51.24,Default,,0,0,0,,...
Dialogue: 0,0:54:51.32,0:54:53.74,Default,,0,0,0,,Энн Энн Энн Анн Ах!
Dialogue: 0,0:54:55.79,0:54:56.79,Default,,0,0,0,,Ах
Dialogue: 0,0:55:06.05,0:55:08.38,Default,,0,0,0,,Қауіпті бөксенің мега өлшемі
Dialogue: 0,0:55:08.47,0:55:09.38,Default,,0,0,0,,Қауіпті бөксенің мега өлшемі
Dialogue: 0,0:55:09.38,0:55:10.93,Default,,0,0,0,,Қауіпті бөксенің мега өлшемі
Dialogue: 0,0:55:09.38,0:55:10.93,Default,,0,0,0,,Кім...
Dialogue: 0,0:55:11.01,0:55:14.22,Default,,0,0,0,,Бұл үлкен есек!
Dialogue: 0,0:55:14.31,0:55:16.56,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:55:20.35,0:55:21.65,Default,,0,0,0,,-(Билли) Уф - нах
Dialogue: 0,0:55:23.73,0:55:26.65,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:55:26.74,0:55:27.74,Default,,0,0,0,,Әке!
Dialogue: 0,0:55:27.82,0:55:28.99,Default,,0,0,0,,О, Шинносуке!
Dialogue: 0,0:55:29.07,0:55:31.36,Default,,0,0,0,,Керемет тегіс~
Dialogue: 0,0:55:31.45,0:55:32.78,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:55:32.87,0:55:34.12,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:55:34.20,0:55:35.58,Default,,0,0,0,,- Жоқ! -о?
Dialogue: 0,0:55:35.66,0:55:37.25,Default,,0,0,0,,На на на
Dialogue: 0,0:55:37.33,0:55:38.87,Default,,0,0,0,,Жоқ
Dialogue: 0,0:55:38.96,0:55:41.33,Default,,0,0,0,,Қарғыс атсын... Нана!
Dialogue: 0,0:55:41.42,0:55:43.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:55:44.38,0:55:45.25,Default,,0,0,0,,Энн Энн!
Dialogue: 0,0:55:46.92,0:55:51.30,Default,,0,0,0,,(Широның қабығы)
Dialogue: 0,0:55:52.89,0:55:54.26,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:55:54.35,0:55:56.77,Default,,0,0,0,,Нана!
Dialogue: 0,0:56:00.60,0:56:01.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:03.10,0:56:04.27,Default,,0,0,0,,Ах
Dialogue: 0,0:56:08.23,0:56:10.11,Default,,0,0,0,,Мен мұндай болады деп ешқашан күтпедім
Dialogue: 0,0:56:10.20,0:56:13.07,Default,,0,0,0,,Мен Дино аралына барамын деп ешқашан ойламадым.
Dialogue: 0,0:56:13.16,0:56:15.12,Default,,0,0,0,,-(Билли) Кешіріңіз -О, жоқ...
Dialogue: 0,0:56:15.78,0:56:18.91,Default,,0,0,0,,Егер мен Нанамен қашып үлгерсем...
Dialogue: 0,0:56:19.00,0:56:20.08,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:56:20.16,0:56:23.54,Default,,0,0,0,,Ола мен Нана таныс емес еді.
Dialogue: 0,0:56:23.63,0:56:28.00,Default,,0,0,0,,Иә, иә, бұл рас, бірақ...
Dialogue: 0,0:56:29.17,0:56:30.47,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:56:31.51,0:56:34.89,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:56:34.97,0:56:36.10,Default,,0,0,0,,Уау
Dialogue: 0,0:56:36.18,0:56:39.22,Default,,0,0,0,,Динозавр қызбасы!
Dialogue: 0,0:56:42.02,0:56:46.02,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:56:48.86,0:56:52.45,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:56:54.99,0:56:57.87,Default,,0,0,0,,А, а, а... а
Dialogue: 0,0:56:59.66,0:57:01.83,Default,,0,0,0,,Дино аралынан шығарылған динозаврлар
Dialogue: 0,0:57:01.91,0:57:03.46,Default,,0,0,0,,Әртүрлі жерлердегі шабуыл
Dialogue: 0,0:57:03.54,0:57:04.83,Default,,0,0,0,,Сабыр сақтаңыз және қауіпсіз жерге көшіңіз.
Dialogue: 0,0:57:04.83,0:57:06.29,Default,,0,0,0,,Сабыр сақтаңыз және қауіпсіз жерге көшіңіз.
Dialogue: 0,0:57:04.83,0:57:06.29,Default,,0,0,0,,Ол дәрігер атағын биліктегілердің көңілін табу үшін пайдаланып жүр
Dialogue: 0,0:57:06.38,0:57:08.75,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:57:08.84,0:57:12.72,Default,,0,0,0,,Мені танымайтын адамдарды ұстаңыз!
Dialogue: 0,0:57:14.80,0:57:16.09,Default,,0,0,0,,Гяаа
Dialogue: 0,0:57:17.26,0:57:20.14,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:57:20.22,0:57:23.10,Default,,0,0,0,,Әй, мені бұл жерден алып кет!
Dialogue: 0,0:57:28.31,0:57:30.07,Default,,0,0,0,,Біздің Касукабе...
Dialogue: 0,0:57:30.15,0:57:31.53,Default,,0,0,0,,Хмм
Dialogue: 0,0:57:31.61,0:57:32.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:32.61,0:57:35.49,Default,,0,0,0,,Ммм...
Dialogue: 0,0:57:35.57,0:57:38.45,Default,,0,0,0,,Не? Е, менің уақытым бар шығар...
Dialogue: 0,0:57:38.53,0:57:40.45,Default,,0,0,0,,Кю~
Dialogue: 0,0:57:41.83,0:57:44.91,Default,,0,0,0,,Дәл сол жерде, мен бір сәтке тоқтай аламын ба?
Dialogue: 0,0:57:49.79,0:57:50.88,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:57:51.42,0:57:54.30,Default,,0,0,0,,(Күнбағыс күлкі)
Dialogue: 0,0:57:57.84,0:58:00.22,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:58:00.31,0:58:03.14,Default,,0,0,0,,Бауырым, сен не істеп жатырсың?
Dialogue: 0,0:58:03.22,0:58:04.81,Default,,0,0,0,,Нананың үйі?
Dialogue: 0,0:58:04.89,0:58:08.65,Default,,0,0,0,,Иә, әкем екеуміз оны жасау үшін көп еңбек еттік!
Dialogue: 0,0:58:10.32,0:58:11.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:58:12.19,0:58:14.49,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:58:14.57,0:58:16.28,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:58:16.36,0:58:17.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:17.70,0:58:19.57,Default,,0,0,0,,Осындай уақытта сен кімсің?
Dialogue: 0,0:58:21.87,0:58:23.12,Default,,0,0,0,,А...
Dialogue: 0,0:58:23.20,0:58:24.25,Default,,0,0,0,,Гяу
Dialogue: 0,0:58:25.46,0:58:27.21,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:58:27.29,0:58:29.67,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:58:29.75,0:58:32.13,Default,,0,0,0,,(Мисэдің айқайы)
Dialogue: 0,0:58:32.21,0:58:33.59,Default,,0,0,0,,Ах
Dialogue: 0,0:58:33.67,0:58:36.05,Default,,0,0,0,,ал екіншісі – «бар күшіңді салу»!
Dialogue: 0,0:58:36.13,0:58:38.51,Default,,0,0,0,,Әкем, анам, күнбағыс...
Dialogue: 0,0:58:48.94,0:58:49.81,Default,,0,0,0,,Жоқ
Dialogue: 0,0:58:59.20,0:59:00.78,Default,,0,0,0,,Энн! Энн!
Dialogue: 0,0:59:00.87,0:59:04.16,Default,,0,0,0,,На… на~ на~
Dialogue: 0,0:59:19.68,0:59:21.47,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:59:21.55,0:59:24.43,Default,,0,0,0,,(Масао-кунның жылауы)
Dialogue: 0,0:59:24.51,0:59:26.22,Default,,0,0,0,,Папа~ Мама~
Dialogue: 0,0:59:26.31,0:59:29.94,Default,,0,0,0,,Тынш! Егер табылсақ, бізді де алып кетеді.
Dialogue: 0,0:59:30.02,0:59:32.36,Default,,0,0,0,,-Уау~ -(Бо-чан) Мына дауыс
Dialogue: 0,0:59:32.44,0:59:33.27,Default,,0,0,0,,Шин-чан?
Dialogue: 0,0:59:34.23,0:59:35.23,Default,,0,0,0,,Иә!?
Dialogue: 0,0:59:35.90,0:59:38.65,Default,,0,0,0,,Жоқ, мен осы жолы шындап тұрмын! Жоғарғы қабатта өлі дене жатыр.
Dialogue: 0,0:59:40.07,0:59:42.57,Default,,0,0,0,,Уау, Казама-кун, шашыңды қидың ба?
Dialogue: 0,0:59:42.66,0:59:45.58,Default,,0,0,0,,Сіз айтып отырғаныңыз осы емес пе?
Dialogue: 0,0:59:46.41,0:59:48.62,Default,,0,0,0,,Ха-о
Dialogue: 0,0:59:49.21,0:59:51.08,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:59:52.67,0:59:54.34,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:59:54.42,0:59:55.63,Default,,0,0,0,,Әй
Dialogue: 0,0:59:56.80,0:59:58.01,Default,,0,0,0,,Ха!
Dialogue: 0,0:59:58.09,0:59:59.97,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:04.51,1:00:06.89,Default,,0,0,0,,Ах... Ах.
Dialogue: 0,1:00:07.81,1:00:10.02,Default,,0,0,0,,А... Анжела?
Dialogue: 0,1:00:11.73,1:00:13.31,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,1:00:13.40,1:00:18.32,Default,,0,0,0,,Жақында нағыз динозаврлар жер бетінде жүретін әлем пайда болады.
Dialogue: 0,1:00:18.40,1:00:22.16,Default,,0,0,0,,Бұл сізді адам сенгісіз сезінеді.
Dialogue: 0,1:00:22.74,1:00:26.66,Default,,0,0,0,,Дайын болғанша, осы жерді тексеріңіз
Dialogue: 0,1:00:30.41,1:00:33.08,Default,,0,0,0,,Мен динозаврларды қайтарғым келеді
Dialogue: 0,1:00:33.17,1:00:36.63,Default,,0,0,0,,Бір адам осылай тіледі.
Dialogue: 0,1:00:37.30,1:00:41.42,Default,,0,0,0,,Мен ешқашан бас тартуды ойлаған емеспін.
Dialogue: 0,1:00:41.51,1:00:44.59,Default,,0,0,0,,Оның үлкен сыны басталды
Dialogue: 0,1:00:44.68,1:00:46.14,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,1:00:46.22,1:00:47.85,Default,,0,0,0,,Мен мұны көргім келмейді!
Dialogue: 0,1:00:47.93,1:00:49.56,Default,,0,0,0,,Бұл жерден тез кет!
Dialogue: 0,1:00:49.64,1:00:53.52,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:01:04.07,1:01:06.45,Default,,0,0,0,,Бұл Спинозавр
Dialogue: 0,1:01:06.53,1:01:11.62,Default,,0,0,0,,Оның желкенді қайыққа ұқсайтын арқасы және желбезек тәрізді құйрығы бар.
Dialogue: 0,1:01:11.70,1:01:14.58,Default,,0,0,0,,Түсіндіру оңай, бірақ...
Dialogue: 0,1:01:15.42,1:01:17.04,Default,,0,0,0,,Сурет көңіл көншітпейді
Dialogue: 0,1:01:17.13,1:01:17.96,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:18.04,1:01:20.00,Default,,0,0,0,,(Синносукенің күлкісі)
Dialogue: 0,1:01:20.09,1:01:24.97,Default,,0,0,0,,Бірақ мен Нананың нағыз Спинозавр болатынын ешқашан күткен емеспін.
Dialogue: 0,1:01:25.05,1:01:28.43,Default,,0,0,0,,Менің атым Нана, мен винил бассейндерін жақсы көремін.
Dialogue: 0,1:01:28.51,1:01:30.89,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:01:30.97,1:01:33.73,Default,,0,0,0,,Сондай-ақ, отшашулар атылғанда мен қуандым.
Dialogue: 0,1:01:33.81,1:01:36.85,Default,,0,0,0,,Иә, сен де қарбызды жаруға шебер едің.
Dialogue: 0,1:01:36.94,1:01:39.82,Default,,0,0,0,,Мен жасырынбақтан жақсы емеспін.
Dialogue: 0,1:01:39.90,1:01:42.03,Default,,0,0,0,,Хаха, құйрық шығып жатыр.
Dialogue: 0,1:01:42.11,1:01:44.28,Default,,0,0,0,,Хахаха иә иә
Dialogue: 0,1:01:47.82,1:01:50.66,Default,,0,0,0,,Ахаха~
Dialogue: 0,1:01:50.74,1:01:51.70,Default,,0,0,0,,​​О?
Dialogue: 0,1:01:57.33,1:01:58.92,Default,,0,0,0,,Анджела-чан
Dialogue: 0,1:01:59.42,1:02:01.34,Default,,0,0,0,,Зефир жегіңіз келе ме?
Dialogue: 0,1:02:01.42,1:02:02.34,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,1:02:02.42,1:02:04.55,Default,,0,0,0,,Олай болса, мен саған зефир беремін~
Dialogue: 0,1:02:06.51,1:02:09.01,Default,,0,0,0,,Ммм тәтті~
Dialogue: 0,1:02:09.89,1:02:11.47,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,1:02:12.10,1:02:14.68,Default,,0,0,0,,Сіз біртүрлі жігітсіз.
Dialogue: 0,1:02:14.77,1:02:15.60,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,1:02:15.69,1:02:17.27,Default,,0,0,0,,Саған бәрібір емес пе?
Dialogue: 0,1:02:17.35,1:02:19.98,Default,,0,0,0,,Мен неге көмектесуге келдім?
Dialogue: 0,1:02:20.69,1:02:22.82,Default,,0,0,0,,Мен саған ғашық болдым ба?
Dialogue: 0,1:02:22.90,1:02:24.99,Default,,0,0,0,,Ах... иә.
Dialogue: 0,1:02:26.07,1:02:28.78,Default,,0,0,0,,Мен оны шынымен түсінбеймін.
Dialogue: 0,1:02:29.62,1:02:32.79,Default,,0,0,0,,Билли көп нәрсені есіне түсірмеуі мүмкін.
Dialogue: 0,1:02:32.87,1:02:36.37,Default,,0,0,0,,Менің анам мен әкем өте жақын.
Dialogue: 0,1:02:36.46,1:02:37.75,Default,,0,0,0,,Хмм.
Dialogue: 0,1:02:38.50,1:02:41.00,Default,,0,0,0,,Менің анам басынан бастап физикалық тұрғыдан әлсіз болды.
Dialogue: 0,1:02:41.09,1:02:44.92,Default,,0,0,0,,Ол кезде әкем мүлде атақты емес еді.
Dialogue: 0,1:02:45.01,1:02:48.72,Default,,0,0,0,,Бірақ үйде әрқашан күлкі болды.
Dialogue: 0,1:02:49.97,1:02:53.64,Default,,0,0,0,,３ ２ １
Dialogue: 0,1:02:53.72,1:02:54.60,Default,,0,0,0,,...
Dialogue: 0,1:02:54.68,1:02:56.02,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,1:02:56.10,1:02:57.89,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,1:02:57.98,1:02:59.81,Default,,0,0,0,,Бір күні міндетті түрде
Dialogue: 0,1:02:59.90,1:03:03.86,Default,,0,0,0,,Мен көптеген адамдарға Unbelievable шығарамын.
Dialogue: 0,1:03:04.48,1:03:07.15,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,1:03:07.78,1:03:12.66,Default,,0,0,0,,Бірақ бұған дейін анам қайтыс болды...
Dialogue: 0,1:03:12.74,1:03:16.66,Default,,0,0,0,,Сонда да әкем анасына берген уәдесін орындауға барын салды.
Dialogue: 0,1:03:17.41,1:03:22.21,Default,,0,0,0,,Бірақ мен тырысқан сайын келесі идеяны сұрайды.
Dialogue: 0,1:03:22.29,1:03:23.80,Default,,0,0,0,,Бұрышқа айдалу
Dialogue: 0,1:03:23.88,1:03:27.09,Default,,0,0,0,,Кез келген әдіспен, тіпті өтірік айту арқылы
Dialogue: 0,1:03:27.17,1:03:30.05,Default,,0,0,0,,Мен назар аударуым керек деп ойлай бастадым.
Dialogue: 0,1:03:30.13,1:03:34.14,Default,,0,0,0,,Анам үнемі өтірік айту жақсы емес дейді.
Dialogue: 0,1:03:34.22,1:03:35.56,Default,,0,0,0,,Иә
Dialogue: 0,1:03:35.64,1:03:40.10,Default,,0,0,0,,Негізі оның да дұрыс екенін білдім.
Dialogue: 0,1:03:40.85,1:03:43.19,Default,,0,0,0,,Бір күні мен бұрынғыдай мейірімді әке боламын.
Dialogue: 0,1:03:43.27,1:03:46.07,Default,,0,0,0,,Мен сені қайтып келуің мүмкін деп ойладым.
Dialogue: 0,1:03:47.74,1:03:53.16,Default,,0,0,0,,Осылайша мен армандарымнан бас тартып, әкеме қолдау көрсеттім...
Dialogue: 0,1:03:53.24,1:03:55.70,Default,,0,0,0,,Жоқ, жеткілікті.
Dialogue: 0,1:03:55.79,1:03:57.62,Default,,0,0,0,,Мен оны қазір өзгерте алмаймын.
Dialogue: 0,1:03:57.70,1:04:00.12,Default,,0,0,0,,Менің өмір жолым мен ойлау тәсілім
Dialogue: 0,1:04:00.21,1:04:01.87,Default,,0,0,0,,Қуырылған зефир
Dialogue: 0,1:04:01.96,1:04:04.04,Default,,0,0,0,,Адамдардың айтқанын тыңдайсыз ба?
Dialogue: 0,1:04:04.13,1:04:07.00,Default,,0,0,0,,Не? Өйткені, мен нан пісіргім келеді~
Dialogue: 0,1:04:07.09,1:04:08.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:08.67,1:04:09.84,Default,,0,0,0,,Анджела да
Dialogue: 0,1:04:10.55,1:04:14.55,Default,,0,0,0,,Мен қалаған нәрсені, қалаған кезде істесем ше?
Dialogue: 0,1:04:15.85,1:04:20.18,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,1:04:20.27,1:04:23.23,Default,,0,0,0,,Ааа
Dialogue: 0,1:04:26.27,1:04:30.49,Default,,0,0,0,,Түсіндім, жақсы, иә?
Dialogue: 0,1:04:31.95,1:04:32.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:32.86,1:04:35.24,Default,,0,0,0,,Уау, бұл жақсы иіс
Dialogue: 0,1:04:35.32,1:04:37.70,Default,,0,0,0,,-Е -Келіңдер бәрің.
Dialogue: 0,1:04:37.79,1:04:40.16,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,1:04:42.92,1:04:44.13,Default,,0,0,0,,Дәмді
Dialogue: 0,1:04:44.79,1:04:46.59,Default,,0,0,0,,Мен де ала аламын ба?
Dialogue: 0,1:04:46.67,1:04:47.67,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,1:04:47.75,1:04:49.80,Default,,0,0,0,,Өзім пісірсем ше?
Dialogue: 0,1:04:49.88,1:04:50.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:50.88,1:04:52.26,Default,,0,0,0,,Бұл цундере~
Dialogue: 0,1:04:52.34,1:04:54.72,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:04:55.51,1:04:58.18,Default,,0,0,0,,Ертең біз таңертең бірінші кезекте Дино аралына барамыз.
Dialogue: 0,1:04:58.26,1:05:00.47,Default,,0,0,0,,Мен барлығын құтқарамын.
Dialogue: 0,1:05:14.11,1:05:16.24,Default,,0,0,0,,Жоқ
Dialogue: 0,1:05:16.32,1:05:17.78,Default,,0,0,0,,Кун
Dialogue: 0,1:05:23.62,1:05:25.33,Default,,0,0,0,,Кун
Dialogue: 0,1:05:26.58,1:05:27.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:30.55,1:05:31.42,Default,,0,0,0,,Хой
Dialogue: 0,1:05:32.55,1:05:33.38,Default,,0,0,0,,Хой
Dialogue: 0,1:05:35.22,1:05:37.09,Default,,0,0,0,,Ахаха…
Dialogue: 0,1:05:39.06,1:05:39.93,Default,,0,0,0,,О!
Dialogue: 0,1:05:40.60,1:05:45.56,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,1:05:45.65,1:05:48.11,Default,,0,0,0,,Кун...
Dialogue: 0,1:05:48.19,1:05:49.15,Default,,0,0,0,,Күн
Dialogue: 0,1:06:00.95,1:06:02.75,Default,,0,0,0,,Синдзюку аймағы Миссия аяқталды
Dialogue: 0,1:06:02.83,1:06:05.12,Default,,0,0,0,,Түсінген Омия аймағының миссиясы аяқталды.
Dialogue: 0,1:06:05.21,1:06:06.75,Default,,0,0,0,,Қазір межелі жерге бара жатыр
Dialogue: 0,1:06:06.83,1:06:07.75,Default,,0,0,0,,Бұл...
Dialogue: 0,1:06:07.83,1:06:11.55,Default,,0,0,0,,Бұл Дино аралының радиосы. Егер мен оны осылай ұстай алсам ...
Dialogue: 0,1:06:11.63,1:06:12.71,Default,,0,0,0,,Сіз оған тағы да қашып кетуге мүмкіндік бердіңіз!?
Dialogue: 0,1:06:12.80,1:06:14.22,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,1:06:12.80,1:06:14.22,Default,,0,0,0,,Сондай-ақ… Кешіріңіз.
Dialogue: 0,1:06:14.22,1:06:15.17,Default,,0,0,0,,Сондай-ақ… Кешіріңіз.
Dialogue: 0,1:06:15.26,1:06:18.55,Default,,0,0,0,,Сибуя аймағында табылған динозавр мен ит
Dialogue: 0,1:06:18.64,1:06:19.64,Default,,0,0,0,,Дереу түсіріңіз!
Dialogue: 0,1:06:19.72,1:06:21.60,Default,,0,0,0,,Динозаврлар мен иттер
Dialogue: 0,1:06:21.68,1:06:23.56,Default,,0,0,0,,-(Билли) Анджела -Білемін.
Dialogue: 0,1:06:23.64,1:06:25.52,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:06:26.10,1:06:29.48,Default,,0,0,0,,Уваа
Dialogue: 0,1:06:30.94,1:06:33.94,Default,,0,0,0,,Мен барлығының анасы мен әкесін құтқарамын.
Dialogue: 0,1:06:34.69,1:06:36.65,Default,,0,0,0,,Екеуміз де мақсатымызға жеткенде
Dialogue: 0,1:06:37.49,1:06:39.62,Default,,0,0,0,,Хачиконың алдында кездесейік
Dialogue: 0,1:06:39.70,1:06:42.99,Default,,0,0,0,,Түсіндім, мен Хачиді Нанакоға әкелемін!
Dialogue: 0,1:06:43.08,1:06:44.91,Default,,0,0,0,,Нана мен Хачи қарама-қарсы!
Dialogue: 0,1:06:45.00,1:06:45.83,Default,,0,0,0,,​​О?
Dialogue: 0,1:06:45.91,1:06:48.12,Default,,0,0,0,,Және Билли
Dialogue: 0,1:06:49.25,1:06:51.04,Default,,0,0,0,,үшін үшін кешірім сұраймын
Dialogue: 0,1:06:51.13,1:06:52.29,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:52.38,1:06:56.26,Default,,0,0,0,,Сезімдеріңмен шыншыл болған саған
Dialogue: 0,1:06:56.34,1:06:57.97,Default,,0,0,0,,Менің ойымша, ол қызғаншақ болды.
Dialogue: 0,1:06:58.05,1:06:58.97,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:59.93,1:07:01.68,Default,,0,0,0,,Мен балаларды сұрадым.
Dialogue: 0,1:07:03.56,1:07:04.89,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:07:04.97,1:07:07.85,Default,,0,0,0,,Иә, бұл Шинносуке.
Dialogue: 0,1:07:08.56,1:07:10.81,Default,,0,0,0,,Нананың қорғаныс белгісі?
Dialogue: 0,1:07:12.82,1:07:15.03,Default,,0,0,0,,Ах... иә?
Dialogue: 0,1:07:17.40,1:07:21.28,Default,,0,0,0,,Бұл маңызды, солай ма? Мен оны дұрыстап қайтаруым керек.
Dialogue: 0,1:07:21.37,1:07:22.45,Default,,0,0,0,,Иә
Dialogue: 0,1:07:23.83,1:07:25.75,Default,,0,0,0,,Ал, керісінше, осы.
Dialogue: 0,1:07:26.33,1:07:28.71,Default,,0,0,0,,Өте сирек кездесетін туыстар добы
Dialogue: 0,1:07:28.79,1:07:30.71,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,1:07:33.84,1:07:34.80,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,1:07:34.88,1:07:37.72,Default,,0,0,0,,Широ мен Нанаға көмектесейік!
Dialogue: 0,1:07:37.80,1:07:40.51,Default,,0,0,0,,Касукабе қорғаныс күштері
Dialogue: 0,1:07:40.59,1:07:43.05,Default,,0,0,0,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,1:07:43.14,1:07:46.89,Default,,0,0,0,,(Широ мен Нананың ауыр тыныс алуы)
Dialogue: 0,1:07:46.97,1:07:49.81,Default,,0,0,0,,Гяаа
Dialogue: 0,1:07:57.78,1:07:59.28,Default,,0,0,0,,- Анна! -жоқ
Dialogue: 0,1:08:01.20,1:08:02.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:08:03.24,1:08:04.70,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:08:06.49,1:08:08.79,Default,,0,0,0,,Кун анан!
Dialogue: 0,1:08:08.87,1:08:10.54,Default,,0,0,0,,На на на
Dialogue: 0,1:08:25.10,1:08:28.18,Default,,0,0,0,,Бұл... мммм...
Dialogue: 0,1:08:29.35,1:08:32.65,Default,,0,0,0,,Қайда? Бұл қайда?
Dialogue: 0,1:08:32.73,1:08:35.44,Default,,0,0,0,,Мен сенің қашуыңа ешқашан жол бермеймін
Dialogue: 0,1:08:35.52,1:08:38.61,Default,,0,0,0,,Шибуядағы барлық динозаврларды жинаңыз!
Dialogue: 0,1:08:43.70,1:08:47.20,Default,,0,0,0,,Ааа
Dialogue: 0,1:08:48.54,1:08:51.21,Default,,0,0,0,,А-а-а-а-а-а
Dialogue: 0,1:08:55.08,1:08:58.46,Default,,0,0,0,,(үшін ауыр тыныс алады)
Dialogue: 0,1:09:00.17,1:09:01.34,Default,,0,0,0,,Ах
Dialogue: 0,1:09:02.88,1:09:04.89,Default,,0,0,0,,Бұл каму көкірекше.
Dialogue: 0,1:09:04.97,1:09:07.76,Default,,0,0,0,,Егер сіз оны осылай атасаңыз, бұл камуфляж.
Dialogue: 0,1:09:08.85,1:09:10.10,Default,,0,0,0,,Ah (дірілдеген дыбыс)
Dialogue: 0,1:09:10.18,1:09:13.06,Default,,0,0,0,,(Динозаврлардың айқайы)
Dialogue: 0,1:09:13.14,1:09:14.52,Default,,0,0,0,,Уф...
Dialogue: 0,1:09:19.07,1:09:19.94,Default,,0,0,0,,Бо!
Dialogue: 0,1:09:25.99,1:09:27.87,Default,,0,0,0,,Фу…
Dialogue: 0,1:09:27.95,1:09:29.87,Default,,0,0,0,,Бұл өте кішкентай.
Dialogue: 0,1:09:36.88,1:09:38.75,Default,,0,0,0,,Сол бала...
Dialogue: 0,1:09:38.84,1:09:41.01,Default,,0,0,0,,Сіз мені тағы да алаңдатуды жоспарлап отырсыз ба?
Dialogue: 0,1:09:41.09,1:09:42.72,Default,,0,0,0,,- (Аммонер Ито) Көпіршік мырза - А?
Dialogue: 0,1:09:42.80,1:09:44.68,Default,,0,0,0,,Бұл монета
Dialogue: 0,1:09:44.76,1:09:50.26,Default,,0,0,0,,Бұл мен жасаған ең күшті динозаврлар әскері.
Dialogue: 0,1:09:50.35,1:09:53.23,Default,,0,0,0,,Ал... бұл сенімді.
Dialogue: 0,1:10:12.37,1:10:15.25,Default,,0,0,0,,Ахх!
Dialogue: 0,1:10:22.67,1:10:23.51,Default,,0,0,0,,Га
Dialogue: 0,1:10:25.38,1:10:28.05,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:10:28.14,1:10:29.43,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,1:10:33.27,1:10:34.60,Default,,0,0,0,,Қалың сауыт
Dialogue: 0,1:10:37.14,1:10:39.02,Default,,0,0,0,,Балға тәрізді құйрық
Dialogue: 0,1:10:39.10,1:10:40.48,Default,,0,0,0,,Ах
Dialogue: 0,1:10:40.56,1:10:41.57,Default,,0,0,0,,Анкилозавр
Dialogue: 0,1:10:41.57,1:10:43.19,Default,,0,0,0,,Анкилозавр
Dialogue: 0,1:10:41.57,1:10:43.19,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,1:10:43.19,1:10:43.28,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,1:10:43.28,1:10:44.53,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,1:10:43.28,1:10:44.53,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,1:10:44.53,1:10:45.24,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,1:10:45.32,1:10:46.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:10:48.99,1:10:50.16,Default,,0,0,0,,Кішкентай
Dialogue: 0,1:10:50.24,1:10:52.12,Default,,0,0,0,,Сонымен 3 Кирозавр
Dialogue: 0,1:10:52.20,1:10:53.33,Default,,0,0,0,,Гррр!
Dialogue: 0,1:10:53.41,1:10:54.58,Default,,0,0,0,,Сүйкімді
Dialogue: 0,1:10:54.66,1:10:57.54,Default,,0,0,0,,Жақында кездескенше~ (күлді)
Dialogue: 0,1:10:59.21,1:11:00.92,Default,,0,0,0,,Нана!
Dialogue: 0,1:11:01.00,1:11:03.38,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,1:11:03.46,1:11:04.63,Default,,0,0,0,,Қауіпті! ғимаратқа
Dialogue: 0,1:11:04.71,1:11:07.26,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:11:08.88,1:11:13.10,Default,,0,0,0,,(үшін ауыр тыныс алады)
Dialogue: 0,1:11:13.97,1:11:14.85,Default,,0,0,0,,Фу…
Dialogue: 0,1:11:14.93,1:11:16.77,Default,,0,0,0,,Әй?
Dialogue: 0,1:11:16.85,1:11:18.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:18.81,1:11:23.82,Default,,0,0,0,,(♪ «МАХАББАТ машинасы»)
Dialogue: 0,1:11:32.66,1:11:35.08,Default,,0,0,0,,Гаа!
Dialogue: 0,1:11:59.77,1:12:01.94,Default,,0,0,0,,-Бұл... -(Бо-чан) Орнитомимус
Dialogue: 0,1:12:06.78,1:12:07.61,Default,,0,0,0,,Хмм... дәмді.
Dialogue: 0,1:12:07.69,1:12:09.19,Default,,0,0,0,,Дәл Одорнитомимус
Dialogue: 0,1:12:17.79,1:12:21.04,Default,,0,0,0,,Биге келгенде Масао-кун да жеңілмейді.
Dialogue: 0,1:12:21.12,1:12:23.46,Default,,0,0,0,,Е, менің қолымнан келмейді~
Dialogue: 0,1:12:25.59,1:12:27.17,Default,,0,0,0,,Қараңдар, мен сені шақырып жатырмын.
Dialogue: 0,1:12:27.25,1:12:28.51,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:28.59,1:12:30.80,Default,,0,0,0,,...
Dialogue: 0,1:12:39.85,1:12:42.02,Default,,0,0,0,,Келіңіздер, кешке отырайық
Dialogue: 0,1:12:55.99,1:12:56.83,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:12:58.79,1:13:00.95,Default,,0,0,0,,♪ Гавгау Гавгау
Dialogue: 0,1:13:06.04,1:13:07.84,Default,,0,0,0,,♪ Гавгау Гавгау
Dialogue: 0,1:13:12.22,1:13:17.22,Default,,0,0,0,,～♪
Dialogue: 0,1:13:19.01,1:13:19.93,Default,,0,0,0,,Ах
Dialogue: 0,1:13:25.44,1:13:31.07,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,1:13:35.16,1:13:35.99,Default,,0,0,0,,Егер қашып кеткім келгенде—
Dialogue: 0,1:13:35.99,1:13:37.20,Default,,0,0,0,,Егер қашып кеткім келгенде—
Dialogue: 0,1:13:35.99,1:13:37.20,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,1:13:38.78,1:13:41.45,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:13:41.54,1:13:43.12,Default,,0,0,0,,- (үшін) Ах - Уау!
Dialogue: 0,1:13:43.21,1:13:45.04,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:13:45.12,1:13:47.50,Default,,0,0,0,,Ти... Тиранозавр!
Dialogue: 0,1:13:47.58,1:13:50.96,Default,,0,0,0,,Бор кезеңінің ең күшті жыртқышы!
Dialogue: 0,1:13:51.05,1:13:53.67,Default,,0,0,0,,Масао-кун, сіз өзіңіздің сүйікті динозаврыңызды кездестірдіңіз.
Dialogue: 0,1:13:53.76,1:13:55.43,Default,,0,0,0,,Мен сені қазір көргім келмеді!
Dialogue: 0,1:14:00.06,1:14:02.60,Default,,0,0,0,,Иә? Эх...
Dialogue: 0,1:14:02.68,1:14:03.56,Default,,0,0,0,,А...
Dialogue: 0,1:14:07.86,1:14:09.65,Default,,0,0,0,,Маған қарап.
Dialogue: 0,1:14:10.69,1:14:13.61,Default,,0,0,0,,Тиранозавр... мүмкін
Dialogue: 0,1:14:13.69,1:14:15.24,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,1:14:15.32,1:14:17.07,Default,,0,0,0,,- Анан! -о?
Dialogue: 0,1:14:17.16,1:14:18.53,Default,,0,0,0,,Ах
Dialogue: 0,1:14:18.62,1:14:20.28,Default,,0,0,0,,-На~ -Широ! Нана!
Dialogue: 0,1:14:20.37,1:14:22.45,Default,,0,0,0,,- Жоқ! -(Билли) Нана!
Dialogue: 0,1:14:24.04,1:14:25.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:14:26.00,1:14:27.88,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,1:14:27.96,1:14:30.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:33.88,1:14:35.76,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:14:35.84,1:14:37.97,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,1:14:38.80,1:14:41.18,Default,,0,0,0,,Уау, көмектесші~
Dialogue: 0,1:14:45.18,1:14:48.10,Default,,0,0,0,,Ааа...
Dialogue: 0,1:14:48.77,1:14:51.36,Default,,0,0,0,,Бұл динозаврлар қандай?
Dialogue: 0,1:14:51.44,1:14:53.57,Default,,0,0,0,,Дәл солай... Мен қателесіппін.
Dialogue: 0,1:14:53.65,1:14:55.86,Default,,0,0,0,,Гача Гача үшін дұрыс монета... у...
Dialogue: 0,1:14:55.86,1:14:57.53,Default,,0,0,0,,Гача Гача үшін дұрыс монета... у...
Dialogue: 0,1:14:55.86,1:14:57.53,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:14:57.53,1:14:57.61,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:14:57.61,1:14:59.99,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:14:57.61,1:14:59.99,Default,,0,0,0,,Гах... бұл жолы не болып жатыр!
Dialogue: 0,1:15:00.78,1:15:02.28,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,1:15:02.37,1:15:04.08,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,1:15:11.67,1:15:12.79,Default,,0,0,0,,Рахмет
Dialogue: 0,1:15:12.88,1:15:14.30,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,1:15:14.38,1:15:15.92,Default,,0,0,0,,-Жарайды -Мен мұны істегім келеді~
Dialogue: 0,1:15:17.13,1:15:18.88,Default,,0,0,0,,Бірақ неге...
Dialogue: 0,1:15:19.55,1:15:20.84,Default,,0,0,0,,Рахмет
Dialogue: 0,1:15:20.93,1:15:21.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:21.89,1:15:23.60,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,1:15:24.31,1:15:28.52,Default,,0,0,0,,Біз үшін ашуланғаныңызға қуаныштымын.
Dialogue: 0,1:15:29.10,1:15:30.98,Default,,0,0,0,,Анджела-чан...
Dialogue: 0,1:15:31.06,1:15:32.44,Default,,0,0,0,,Сәлем Анжела
Dialogue: 0,1:15:32.52,1:15:34.90,Default,,0,0,0,,Менің жолыма кедергі болма!
Dialogue: 0,1:15:35.57,1:15:37.44,Default,,0,0,0,,Әке, кешіріңіз.
Dialogue: 0,1:15:37.53,1:15:40.86,Default,,0,0,0,,Бірақ мен өз жолыммен өмір сүремін
Dialogue: 0,1:15:40.95,1:15:44.33,Default,,0,0,0,,Хмф! Қазір бүлікшіл кезең бе?
Dialogue: 0,1:15:44.41,1:15:48.29,Default,,0,0,0,,Арман қуатын кез емес деп ойлаймын!
Dialogue: 0,1:15:49.12,1:15:50.46,Default,,0,0,0,,Мен...
Dialogue: 0,1:15:51.25,1:15:53.75,Default,,0,0,0,,Мен әрқашан автобуста гид болғым келетін.
Dialogue: 0,1:15:53.84,1:15:55.13,Default,,0,0,0,,А...
Dialogue: 0,1:15:55.21,1:15:56.26,Default,,0,0,0,,Сізге жақсы көрінеді
Dialogue: 0,1:15:56.34,1:15:57.17,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,1:15:57.26,1:15:58.72,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,1:15:58.80,1:16:01.72,Default,,0,0,0,,Динозаврларға гид болып жұмыс істегенде
Dialogue: 0,1:16:01.80,1:16:04.39,Default,,0,0,0,,Бұл өте қызық болды, мен қатты толқып кеттім!
Dialogue: 0,1:16:05.01,1:16:07.52,Default,,0,0,0,,Бәрің, мен сендерге сыртты көрсетемін.
Dialogue: 0,1:16:07.60,1:16:08.81,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:08.89,1:16:10.77,Default,,0,0,0,,Бұл монета!
Dialogue: 0,1:16:11.85,1:16:15.23,Default,,0,0,0,,Динозаврлар адамдардан бұрын келеді.
Dialogue: 0,1:16:17.82,1:16:19.90,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,1:16:19.99,1:16:21.36,Default,,0,0,0,,Дауыс жарқын!
Dialogue: 0,1:16:21.45,1:16:25.78,Default,,0,0,0,,Араларыңызда автобус жүргізе алатындарыңыз бар ма?
Dialogue: 0,1:16:25.87,1:16:28.75,Default,,0,0,0,,Мен аламын, бірақ
Dialogue: 0,1:16:28.83,1:16:31.08,Default,,0,0,0,,- (Әйел) Мен де - (Ер) Мен де
Dialogue: 0,1:16:31.62,1:16:33.29,Default,,0,0,0,,Рахмет
Dialogue: 0,1:16:33.38,1:16:36.21,Default,,0,0,0,,Кәне, бәрің тездетіп автобусқа мініңдер.
Dialogue: 0,1:16:38.09,1:16:41.13,Default,,0,0,0,,Бұл автобус қазір Шибуяға бара жатыр.
Dialogue: 0,1:16:42.13,1:16:47.72,Default,,0,0,0,,Сол жерде біз сіздің балаларыңызды қарсы алып, қауіпсіз жерге апарамыз.
Dialogue: 0,1:16:51.23,1:16:53.81,Default,,0,0,0,,Енді барлығымыз оң қолдарыңа қараңдаршы.
Dialogue: 0,1:16:53.90,1:16:54.73,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:54.81,1:16:56.65,Default,,0,0,0,,Бұл Токио мұнарасы.
Dialogue: 0,1:16:56.73,1:16:59.78,Default,,0,0,0,,Токио мұнарасының ресми атауы - Жапония радио мұнарасы.
Dialogue: 0,1:16:59.78,1:17:00.74,Default,,0,0,0,,Токио мұнарасының ресми атауы - Жапония радио мұнарасы.
Dialogue: 0,1:16:59.78,1:17:00.74,Default,,0,0,0,,Мен мұндай түсімді жасырғаныма сене алар емеспін
Dialogue: 0,1:17:00.74,1:17:00.82,Default,,0,0,0,,Мен мұндай түсімді жасырғаныма сене алар емеспін
Dialogue: 0,1:17:00.82,1:17:03.20,Default,,0,0,0,,Мен мұндай түсімді жасырғаныма сене алар емеспін
Dialogue: 0,1:17:00.82,1:17:03.20,Default,,0,0,0,,Бұл 1958 жылы ашылған биіктігі 333 метр радио мұнарасы.
Dialogue: 0,1:17:03.20,1:17:06.49,Default,,0,0,0,,Бұл 1958 жылы ашылған биіктігі 333 метр радио мұнарасы.
Dialogue: 0,1:17:06.58,1:17:08.79,Default,,0,0,0,,А, аа, иә~
Dialogue: 0,1:17:08.87,1:17:10.08,Default,,0,0,0,,Жоқ, уақыт.
Dialogue: 0,1:17:10.16,1:17:11.79,Default,,0,0,0,,Айуууу...
Dialogue: 0,1:17:11.87,1:17:14.17,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:17:14.25,1:17:17.42,Default,,0,0,0,,Хатаяя~ Ачача~
Dialogue: 0,1:17:17.50,1:17:19.17,Default,,0,0,0,,Уау
Dialogue: 0,1:17:19.25,1:17:20.59,Default,,0,0,0,,Кәсіби
Dialogue: 0,1:17:29.14,1:17:34.48,Default,,0,0,0,,Хаа
Dialogue: 0,1:17:40.11,1:17:41.11,Default,,0,0,0,,Пуха~
Dialogue: 0,1:17:41.19,1:17:43.07,Default,,0,0,0,,А, ыстық болды.
Dialogue: 0,1:17:43.15,1:17:45.36,Default,,0,0,0,,Енді бәріміз Хачикоға барайық.
Dialogue: 0,1:17:45.36,1:17:45.99,Default,,0,0,0,,Енді бәріміз Хачикоға барайық.
Dialogue: 0,1:17:45.36,1:17:45.99,Default,,0,0,0,,(ұшатын дыбыс)
Dialogue: 0,1:17:45.99,1:17:46.07,Default,,0,0,0,,(ұшатын дыбыс)
Dialogue: 0,1:17:46.07,1:17:47.03,Default,,0,0,0,,(ұшатын дыбыс)
Dialogue: 0,1:17:46.07,1:17:47.03,Default,,0,0,0,,Ах
Dialogue: 0,1:17:47.03,1:17:47.12,Default,,0,0,0,,(ұшатын дыбыс)
Dialogue: 0,1:17:47.12,1:17:48.28,Default,,0,0,0,,(ұшатын дыбыс)
Dialogue: 0,1:17:47.12,1:17:48.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:48.28,1:17:49.12,Default,,0,0,0,,(ұшатын дыбыс)
Dialogue: 0,1:17:49.20,1:17:51.37,Default,,0,0,0,,Уау...
Dialogue: 0,1:17:52.08,1:17:53.46,Default,,0,0,0,,-Кяаа! -(Бо Чан) Ахх...
Dialogue: 0,1:17:56.88,1:17:58.38,Default,,0,0,0,,Гаруру…
Dialogue: 0,1:17:59.42,1:18:00.84,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,1:18:01.76,1:18:04.30,Default,,0,0,0,,Гггаа
Dialogue: 0,1:18:04.93,1:18:08.72,Default,,0,0,0,,Уф, енді жоқ
Dialogue: 0,1:18:08.80,1:18:11.14,Default,,0,0,0,,Акрокантозавр
Dialogue: 0,1:18:11.22,1:18:12.77,Default,,0,0,0,,Шетц
Dialogue: 0,1:18:12.85,1:18:14.68,Default,,0,0,0,,Карнотавр
Dialogue: 0,1:18:14.77,1:18:17.15,Default,,0,0,0,,...
Dialogue: 0,1:18:17.23,1:18:20.65,Default,,0,0,0,,Хохо Бұл динозаврлар қай дәуірден?
Dialogue: 0,1:18:20.73,1:18:23.11,Default,,0,0,0,,-～ -（）
Dialogue: 0,1:18:23.78,1:18:25.57,Default,,0,0,0,,Жоқ
Dialogue: 0,1:18:26.15,1:18:27.53,Default,,0,0,0,,Шинносуке!
Dialogue: 0,1:18:27.61,1:18:28.99,Default,,0,0,0,,- (Қазама Мама) Тоору-чан! -Нене!
Dialogue: 0,1:18:31.49,1:18:33.58,Default,,0,0,0,,Тездетіңізші, бастық!
Dialogue: 0,1:18:33.66,1:18:36.58,Default,,0,0,0,,Түсінген және...
Dialogue: 0,1:18:36.67,1:18:39.54,Default,,0,0,0,,Мен директормын!
Dialogue: 0,1:18:41.59,1:18:43.96,Default,,0,0,0,,Сәлем...
Dialogue: 0,1:18:48.43,1:18:52.18,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:18:52.18,1:18:53.85,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:18:52.18,1:18:53.85,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:18:53.85,1:18:55.81,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:19:01.31,1:19:05.03,Default,,0,0,0,,Өйткені—
Dialogue: 0,1:19:05.11,1:19:07.99,Default,,0,0,0,,Спинозавр
Dialogue: 0,1:19:13.20,1:19:15.08,Default,,0,0,0,,-（） -
Dialogue: 0,1:19:15.83,1:19:18.54,Default,,0,0,0,,(Су асты дыбысы)
Dialogue: 0,1:19:18.62,1:19:20.96,Default,,0,0,0,,Спинозавр…
Dialogue: 0,1:19:21.04,1:19:25.76,Default,,0,0,0,,Сонда Нананың жылаған дауысын естіп, көмекке келдің бе?
Dialogue: 0,1:19:33.22,1:19:35.10,Default,,0,0,0,,Уау, сенбейтін!
Dialogue: 0,1:19:35.18,1:19:36.10,Default,,0,0,0,,Бо!
Dialogue: 0,1:19:42.94,1:19:44.86,Default,,0,0,0,,Әзірге жолға шығайық.
Dialogue: 0,1:19:49.24,1:19:52.62,Default,,0,0,0,,(Су асты дыбысы)
Dialogue: 0,1:19:54.58,1:19:55.83,Default,,0,0,0,,На…
Dialogue: 0,1:19:59.71,1:20:01.33,Default,,0,0,0,,(Су асты дыбысы)
Dialogue: 0,1:20:01.42,1:20:04.29,Default,,0,0,0,,Ол жігіт бұзып тастап кетуі керек еді.
Dialogue: 0,1:20:04.38,1:20:05.80,Default,,0,0,0,,Гуу...
Dialogue: 0,1:20:05.88,1:20:07.76,Default,,0,0,0,,...
Dialogue: 0,1:20:07.84,1:20:09.51,Default,,0,0,0,,Ммм
Dialogue: 0,1:20:09.59,1:20:11.72,Default,,0,0,0,,Какеру Уеха…
Dialogue: 0,1:20:17.18,1:20:18.10,Default,,0,0,0,,Шинносуке!
Dialogue: 0,1:20:18.18,1:20:20.56,Default,,0,0,0,,Күнбағыс әке-ана!
Dialogue: 0,1:20:20.64,1:20:22.73,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:20:22.81,1:20:25.52,Default,,0,0,0,,-Жақсысың ба? -Ух~ менің қарным ашты.
Dialogue: 0,1:20:25.61,1:20:28.28,Default,,0,0,0,,Аман-есен болғаныңызға қуаныштымын, мама.
Dialogue: 0,1:20:31.03,1:20:32.91,Default,,0,0,0,,Не? Сол көзқарас
Dialogue: 0,1:20:32.99,1:20:35.45,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:20:35.53,1:20:37.49,Default,,0,0,0,,Кейінірек түсіндіріледі
Dialogue: 0,1:20:38.45,1:20:39.87,Default,,0,0,0,,Ах
Dialogue: 0,1:20:43.38,1:20:45.17,Default,,0,0,0,,-На... -Уф
Dialogue: 0,1:20:46.55,1:20:49.97,Default,,0,0,0,,Уау! Джумбо Киннің шарлары~
Dialogue: 0,1:20:50.05,1:20:52.76,Default,,0,0,0,,...
Dialogue: 0,1:21:02.64,1:21:04.85,Default,,0,0,0,,Сенгісіз
Dialogue: 0,1:21:04.94,1:21:06.57,Default,,0,0,0,,Қорытынды
Dialogue: 0,1:21:06.65,1:21:10.03,Default,,0,0,0,,Ахх...
Dialogue: 0,1:21:10.69,1:21:11.99,Default,,0,0,0,,Ол дәрігер атағын биліктегілердің көңілін табу үшін пайдаланып жүр
Dialogue: 0,1:21:14.99,1:21:15.91,Default,,0,0,0,,Анан!
Dialogue: 0,1:21:18.83,1:21:20.20,Default,,0,0,0,,На…
Dialogue: 0,1:21:20.29,1:21:24.17,Default,,0,0,0,,Мен оны осы жолы аламын
Dialogue: 0,1:21:31.21,1:21:32.05,Default,,0,0,0,,Уау
Dialogue: 0,1:21:33.68,1:21:35.26,Default,,0,0,0,,Тағы да сен бе?
Dialogue: 0,1:21:35.34,1:21:37.47,Default,,0,0,0,,(Су асты дыбысы)
Dialogue: 0,1:21:39.01,1:21:41.35,Default,,0,0,0,,Кімге қарсы шығып жатырсың?
Dialogue: 0,1:21:46.35,1:21:48.23,Default,,0,0,0,,Билли-кун, осылай!
Dialogue: 0,1:21:54.57,1:21:56.74,Default,,0,0,0,,Суи Суи
Dialogue: 0,1:21:57.53,1:21:59.62,Default,,0,0,0,,-Уау -Алға, Спино!
Dialogue: 0,1:21:59.70,1:22:01.49,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:22:02.95,1:22:05.54,Default,,0,0,0,,Сен табанды жігітсің
Dialogue: 0,1:22:05.62,1:22:08.79,Default,,0,0,0,,Құрметті Көпіршік, мысалдағы түймені басыңыз.
Dialogue: 0,1:22:08.88,1:22:11.84,Default,,0,0,0,,Түсіндім, бұл құпия қулық.
Dialogue: 0,1:22:12.46,1:22:13.55,Default,,0,0,0,,О
Dialogue: 0,1:22:16.97,1:22:19.22,Default,,0,0,0,,Уау, өте жақсы...
Dialogue: 0,1:22:19.30,1:22:21.31,Default,,0,0,0,,Массаж функциясы
Dialogue: 0,1:22:23.35,1:22:25.02,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,1:22:25.10,1:22:28.02,Default,,0,0,0,,Ұрыста босаңсу керек пе?
Dialogue: 0,1:22:28.10,1:22:29.23,Default,,0,0,0,,Ах
Dialogue: 0,1:22:36.32,1:22:37.57,Default,,0,0,0,,Иә...
Dialogue: 0,1:22:39.87,1:22:42.91,Default,,0,0,0,,Жолың болсын, жолың болсын
Dialogue: 0,1:22:42.99,1:22:44.75,Default,,0,0,0,,-Жоқ... Наһ -Ан!
Dialogue: 0,1:22:49.75,1:22:50.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:53.59,1:22:54.76,Default,,0,0,0,,Жоқ
Dialogue: 0,1:22:56.17,1:22:59.55,Default,,0,0,0,,Ал... әлі жоқ!
Dialogue: 0,1:23:07.69,1:23:09.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:10.23,1:23:11.27,Default,,0,0,0,,На?
Dialogue: 0,1:23:19.53,1:23:21.28,Default,,0,0,0,,Энн! Анан...
Dialogue: 0,1:23:21.37,1:23:23.03,Default,,0,0,0,,Иә, бұл ыңғайсыздық!
Dialogue: 0,1:23:23.12,1:23:24.83,Default,,0,0,0,,Ах! Бір…
Dialogue: 0,1:23:24.91,1:23:26.29,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,1:23:27.66,1:23:29.25,Default,,0,0,0,,На?
Dialogue: 0,1:23:29.33,1:23:30.75,Default,,0,0,0,,Амансың ба? Широ!
Dialogue: 0,1:23:30.83,1:23:31.71,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,1:23:31.79,1:23:33.17,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,1:23:33.25,1:23:35.13,Default,,0,0,0,,Мұны істеуді доғарыңыз!
Dialogue: 0,1:23:38.76,1:23:40.55,Default,,0,0,0,,Ол жерден кет
Dialogue: 0,1:23:40.64,1:23:44.56,Default,,0,0,0,,Менің дүниені нұрландыратын миссиям бар.
Dialogue: 0,1:23:44.64,1:23:46.18,Default,,0,0,0,,Жоқ
Dialogue: 0,1:23:46.27,1:23:50.52,Default,,0,0,0,,Дәл қазір әкем өзін әлемге танытқысы келеді.
Dialogue: 0,1:23:50.60,1:23:52.98,Default,,0,0,0,,Шулы! сендер үндемеңдер
Dialogue: 0,1:23:53.06,1:23:55.23,Default,,0,0,0,,Тек мені тыңда!
Dialogue: 0,1:23:55.32,1:23:56.53,Default,,0,0,0,,Ал Вайолет ше?
Dialogue: 0,1:23:56.61,1:23:59.65,Default,,0,0,0,,Менің өмірім әкемдікі емес
Dialogue: 0,1:24:00.36,1:24:02.12,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,1:24:02.20,1:24:04.62,Default,,0,0,0,,Мен өзім шешкен жолмен жүргім келеді.
Dialogue: 0,1:24:08.37,1:24:11.83,Default,,0,0,0,,Сен де мені тастап кетесің бе?
Dialogue: 0,1:24:13.13,1:24:18.51,Default,,0,0,0,,Сіз бұл дүниеде ыңғайлы кезде ғана сырласатын адамдар сияқты емессіз бе?
Dialogue: 0,1:24:18.59,1:24:22.47,Default,,0,0,0,,Бұл ата-ана мен баланың арасындағы байланыстың көлемі сіз үшін ме?
Dialogue: 0,1:24:22.55,1:24:27.43,Default,,0,0,0,,Себебі ата-ана мен баланың арасында байланыс бар, өйткені сен маңызды әкесің.
Dialogue: 0,1:24:27.52,1:24:30.52,Default,,0,0,0,,Қалай ойлайсың, біз оны тоқтатуымыз керек пе?
Dialogue: 0,1:24:31.48,1:24:35.61,Default,,0,0,0,,Біздің әкеміз жалғыз.
Dialogue: 0,1:24:35.69,1:24:37.07,Default,,0,0,0,,Есте сақта
Dialogue: 0,1:24:37.15,1:24:40.53,Default,,0,0,0,,Анама уәде берген кездегі сезім
Dialogue: 0,1:24:42.11,1:24:43.11,Default,,0,0,0,,Хмм
Dialogue: 0,1:24:43.87,1:24:45.12,Default,,0,0,0,,Хмм...
Dialogue: 0,1:24:48.41,1:24:52.08,Default,,0,0,0,,На… на на на на…
Dialogue: 0,1:24:52.17,1:24:53.75,Default,,0,0,0,,Ша…
Dialogue: 0,1:24:54.79,1:24:58.21,Default,,0,0,0,,Нааа!
Dialogue: 0,1:24:59.76,1:25:01.13,Default,,0,0,0,,Нана?
Dialogue: 0,1:25:05.80,1:25:10.27,Default,,0,0,0,,Наа!
Dialogue: 0,1:25:14.69,1:25:16.69,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,1:25:16.77,1:25:18.65,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:19.57,1:25:21.57,Default,,0,0,0,,Енді жоқ... Енді жоқ...
Dialogue: 0,1:25:21.57,1:25:22.07,Default,,0,0,0,,Енді жоқ... Енді жоқ...
Dialogue: 0,1:25:21.57,1:25:22.07,Default,,0,0,0,,(Нананың қабығы)
Dialogue: 0,1:25:22.07,1:25:22.15,Default,,0,0,0,,(Нананың қабығы)
Dialogue: 0,1:25:22.15,1:25:23.70,Default,,0,0,0,,(Нананың қабығы)
Dialogue: 0,1:25:22.15,1:25:23.70,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,1:25:23.70,1:25:23.78,Default,,0,0,0,,(Нананың қабығы)
Dialogue: 0,1:25:23.78,1:25:24.61,Default,,0,0,0,,(Нананың қабығы)
Dialogue: 0,1:25:23.78,1:25:24.61,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,1:25:24.61,1:25:26.07,Default,,0,0,0,,(Нананың қабығы)
Dialogue: 0,1:25:27.66,1:25:30.83,Default,,0,0,0,,Уф... Уф Ах
Dialogue: 0,1:25:32.66,1:25:35.50,Default,,0,0,0,,Жарайды... тыныштал.
Dialogue: 0,1:25:35.58,1:25:36.46,Default,,0,0,0,,Уф
Dialogue: 0,1:25:36.54,1:25:38.92,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:39.00,1:25:42.17,Default,,0,0,0,,Уф... ха... а...
Dialogue: 0,1:25:45.84,1:25:47.30,Default,,0,0,0,,-Гау! -Нана!
Dialogue: 0,1:25:47.39,1:25:48.56,Default,,0,0,0,,Ах
Dialogue: 0,1:25:51.72,1:25:53.02,Default,,0,0,0,,Ммм
Dialogue: 0,1:25:54.39,1:25:55.23,Default,,0,0,0,,Билли!
Dialogue: 0,1:25:56.44,1:25:57.69,Default,,0,0,0,,Үлкен аға!?
Dialogue: 0,1:25:59.11,1:26:00.28,Default,,0,0,0,,Гау!
Dialogue: 0,1:26:01.99,1:26:04.28,Default,,0,0,0,,Жоқ... не істеуді жоспарлап отырсыз?
Dialogue: 0,1:26:04.36,1:26:05.86,Default,,0,0,0,,Мен Нананы тоқтатамын
Dialogue: 0,1:26:05.95,1:26:07.74,Default,,0,0,0,,- (Казама-кун) Тоқта... -Болмайды!
Dialogue: 0,1:26:07.82,1:26:10.70,Default,,0,0,0,,Динозаврлар мен адамдардың қатар өмір сүруі мүмкін емес.
Dialogue: 0,1:26:10.79,1:26:14.16,Default,,0,0,0,,Сондықтан Нананы дүниеге әкелген мен жауапкершілікті аламын.
Dialogue: 0,1:26:14.25,1:26:15.62,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:16.46,1:26:19.09,Default,,0,0,0,,Нана кешіріңіз
Dialogue: 0,1:26:19.17,1:26:21.80,Default,,0,0,0,,Бұл өте жасырын!
Dialogue: 0,1:26:22.71,1:26:23.76,Default,,0,0,0,,Шинносуке…
Dialogue: 0,1:26:23.84,1:26:26.72,Default,,0,0,0,,Мен Нанамен бірге болғым келеді!
Dialogue: 0,1:26:27.59,1:26:30.97,Default,,0,0,0,,Дұрыс, Нана Касукабе қорғаныс күштерінің мүшесі!
Dialogue: 0,1:26:31.06,1:26:32.31,Default,,0,0,0,,Біз көмектесуіміз керек!
Dialogue: 0,1:26:32.31,1:26:33.18,Default,,0,0,0,,Біз көмектесуіміз керек!
Dialogue: 0,1:26:32.31,1:26:33.18,Default,,0,0,0,,Иә
Dialogue: 0,1:26:33.27,1:26:35.64,Default,,0,0,0,,Бұл күлкілі!
Dialogue: 0,1:26:36.31,1:26:39.23,Default,,0,0,0,,Сіз тырыспайынша білмейсіз!
Dialogue: 0,1:26:41.73,1:26:44.19,Default,,0,0,0,,А... а...
Dialogue: 0,1:26:46.07,1:26:47.66,Default,,0,0,0,,- Иә? Нана ше? -сурет?
Dialogue: 0,1:26:50.66,1:26:52.29,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:26:52.37,1:26:55.75,Default,,0,0,0,,Хмф! Шинносуке кет!
Dialogue: 0,1:26:55.83,1:26:56.75,Default,,0,0,0,,Тайя!
Dialogue: 0,1:26:56.83,1:26:58.71,Default,,0,0,0,,Әтеш!
Dialogue: 0,1:26:59.58,1:27:01.29,Default,,0,0,0,,Нанаға көмектес
Dialogue: 0,1:27:03.34,1:27:04.71,Default,,0,0,0,,Касукабе қорғаныс күштері
Dialogue: 0,1:27:04.80,1:27:06.88,Default,,0,0,0,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,1:27:08.34,1:27:09.55,Default,,0,0,0,,Эй!
Dialogue: 0,1:27:16.52,1:27:18.98,Default,,0,0,0,,Ата-аналар... Сіз дисквалификациясыз.
Dialogue: 0,1:27:20.48,1:27:23.40,Default,,0,0,0,,Менің әкемді кінәлауға құқығым жоқ...
Dialogue: 0,1:27:24.03,1:27:25.07,Default,,0,0,0,,Уф
Dialogue: 0,1:27:25.69,1:27:31.07,Default,,0,0,0,,Қыңылдауға уақыт болса, не істеуге болатынын ойлаңыз!
Dialogue: 0,1:27:32.74,1:27:35.04,Default,,0,0,0,,Келме, Келме!
Dialogue: 0,1:27:36.25,1:27:38.00,Default,,0,0,0,,…қашып кету…
Dialogue: 0,1:27:38.08,1:27:41.88,Default,,0,0,0,,Ораораора! Кәне!
Dialogue: 0,1:27:41.96,1:27:43.46,Default,,0,0,0,,- (Йошинага мырза) А? - (Аджео мырза) Мацузака мырза!?
Dialogue: 0,1:27:44.59,1:27:46.51,Default,,0,0,0,,Бұл балалар көп жұмыс істейді.
Dialogue: 0,1:27:46.59,1:27:49.43,Default,,0,0,0,,Ересектер қорқуды көтере алмайды!
Dialogue: 0,1:27:50.59,1:27:51.84,Default,,0,0,0,,Иә.
Dialogue: 0,1:27:51.93,1:27:54.39,Default,,0,0,0,,Бұл шынымен де қорқынышты.
Dialogue: 0,1:28:00.02,1:28:01.81,Default,,0,0,0,,Ммм
Dialogue: 0,1:28:01.90,1:28:05.48,Default,,0,0,0,,Менің асыл ұстазымды ренжітсең ше?
Dialogue: 0,1:28:05.57,1:28:07.28,Default,,0,0,0,,Бұл жай ғана болмайды.
Dialogue: 0,1:28:07.36,1:28:09.24,Default,,0,0,0,,Гааа...
Dialogue: 0,1:28:09.90,1:28:11.16,Default,,0,0,0,,Эй!
Dialogue: 0,1:28:11.24,1:28:12.20,Default,,0,0,0,,Ааа
Dialogue: 0,1:28:13.45,1:28:16.62,Default,,0,0,0,,Сүйікті көгершін күшімізді көрсетейік пе?
Dialogue: 0,1:28:16.70,1:28:18.16,Default,,0,0,0,,Шинигами қалай өледі екен.
Dialogue: 0,1:28:18.25,1:28:23.13,Default,,0,0,0,,-Бум-(Митчи) Хэхехехехехехе
Dialogue: 0,1:28:23.21,1:28:27.09,Default,,0,0,0,,Бұл динозаврлардан қорқытатын Сайтама Crimson Scorpion отряды емес!
Dialogue: 0,1:28:27.17,1:28:28.42,Default,,0,0,0,,О!
Dialogue: 0,1:28:30.84,1:28:34.01,Default,,0,0,0,,Дағдарыс - бұл сату мүмкіндігі!
Dialogue: 0,1:28:34.10,1:28:36.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:28:37.02,1:28:38.39,Default,,0,0,0,,Мисае!
Dialogue: 0,1:28:38.47,1:28:40.35,Default,,0,0,0,,Уф...
Dialogue: 0,1:28:40.44,1:28:43.06,Default,,0,0,0,,Хм, жақсысың ба? Мисае
Dialogue: 0,1:28:43.73,1:28:44.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:45.40,1:28:46.94,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,1:28:47.03,1:28:49.28,Default,,0,0,0,,Сіз нені дұрыс істемейсіз?
Dialogue: 0,1:28:53.32,1:28:56.58,Default,,0,0,0,,А... мұны маған қалдырыңыз.
Dialogue: 0,1:28:56.66,1:28:58.20,Default,,0,0,0,,Бот?
Dialogue: 0,1:28:59.08,1:29:01.33,Default,,0,0,0,,Бәріміз жарасып алайық
Dialogue: 0,1:29:01.41,1:29:03.83,Default,,0,0,0,,Нене... Нене-чан мейірімді
Dialogue: 0,1:29:03.92,1:29:06.29,Default,,0,0,0,,Үйден қашқандарды да қоса алғанда.
Dialogue: 0,1:29:06.38,1:29:09.01,Default,,0,0,0,,Қорықпа, кел.
Dialogue: 0,1:29:09.09,1:29:10.47,Default,,0,0,0,,Үйден қашқандарды да қоса алғанда.
Dialogue: 0,1:29:10.55,1:29:13.18,Default,,0,0,0,,Бәріңе сәлем~
Dialogue: 0,1:29:14.43,1:29:14.97,Default,,0,0,0,,Үйден қашқандарды да қоса алғанда.
Dialogue: 0,1:29:14.97,1:29:16.64,Default,,0,0,0,,Үйден қашқандарды да қоса алғанда.
Dialogue: 0,1:29:14.97,1:29:16.64,Default,,0,0,0,,Хмф! (соққы дыбысы)
Dialogue: 0,1:29:16.72,1:29:18.10,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,1:29:18.18,1:29:22.06,Default,,0,0,0,,Адамдар маған мейірімділік танытып жатыр, олардың көзқарасында не кінәлі?
Dialogue: 0,1:29:22.14,1:29:25.81,Default,,0,0,0,,Хмф! Хмф! Хмф! Хмф! Хмф!
Dialogue: 0,1:29:27.19,1:29:31.36,Default,,0,0,0,,Ха... Кешіріңіз, кешіріңіз, бәріңіз, келіңіздер~
Dialogue: 0,1:29:33.36,1:29:36.87,Default,,0,0,0,,Қарашы, мен сенің мейірімділігіңді сездім.
Dialogue: 0,1:29:36.95,1:29:38.58,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,1:29:39.24,1:29:40.24,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:42.79,1:29:44.08,Default,,0,0,0,,Ах!
Dialogue: 0,1:29:44.17,1:29:46.29,Default,,0,0,0,,Мен бірдеңе істеймін
Dialogue: 0,1:29:47.54,1:29:51.63,Default,,0,0,0,,Есті...
Dialogue: 0,1:29:51.71,1:29:53.34,Default,,0,0,0,,Гуоооо
Dialogue: 0,1:29:54.09,1:29:55.30,Default,,0,0,0,,Таң қалды!
Dialogue: 0,1:29:55.97,1:29:57.26,Default,,0,0,0,,Есті...
Dialogue: 0,1:29:57.35,1:29:58.97,Default,,0,0,0,,Гуоооо
Dialogue: 0,1:29:59.06,1:30:01.93,Default,,0,0,0,,Бобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобо обобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобо обобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобобо obobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobobbobbob.b құбыжық!
Dialogue: 0,1:30:03.10,1:30:03.73,Default,,0,0,0,,Таң қалды
Dialogue: 0,1:30:03.73,1:30:06.44,Default,,0,0,0,,Таң қалды
Dialogue: 0,1:30:03.73,1:30:06.44,Default,,0,0,0,,Бо-чанға тән емес күшті ойын
Dialogue: 0,1:30:06.44,1:30:08.36,Default,,0,0,0,,Таң қалды
Dialogue: 0,1:30:12.49,1:30:14.28,Default,,0,0,0,,Оны тек сен ғана көресің
Dialogue: 0,1:30:15.32,1:30:16.74,Default,,0,0,0,,Уф
Dialogue: 0,1:30:16.82,1:30:19.70,Default,,0,0,0,,(Су асты дыбысы)
Dialogue: 0,1:30:19.78,1:30:22.41,Default,,0,0,0,,О... үлкен
Dialogue: 0,1:30:26.83,1:30:29.59,Default,,0,0,0,,Мен оларды тарту үшін жем ретінде әрекет етемін.
Dialogue: 0,1:30:29.67,1:30:31.55,Default,,0,0,0,,Казама-кун…
Dialogue: 0,1:30:31.63,1:30:35.01,Default,,0,0,0,,Эй, мынау! Гао!
Dialogue: 0,1:30:35.09,1:30:36.47,Default,,0,0,0,,Казама-кун
Dialogue: 0,1:30:37.30,1:30:38.47,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,1:30:38.55,1:30:40.93,Default,,0,0,0,,Жарайды, бәрі үшін.
Dialogue: 0,1:30:41.01,1:30:42.27,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:42.35,1:30:44.39,Default,,0,0,0,,Мен бұған мүлдем қарамадым.
Dialogue: 0,1:30:44.48,1:30:45.73,Default,,0,0,0,,Иә!?
Dialogue: 0,1:30:46.52,1:30:48.35,Default,,0,0,0,,Жоқ... неге?
Dialogue: 0,1:30:48.44,1:30:51.07,Default,,0,0,0,,Динозавр, міне!
Dialogue: 0,1:30:53.78,1:30:55.44,Default,,0,0,0,,Казама-кун да!
Dialogue: 0,1:30:55.53,1:30:56.99,Default,,0,0,0,,Иә
Dialogue: 0,1:30:57.07,1:30:59.28,Default,,0,0,0,,Иә!
Dialogue: 0,1:31:01.62,1:31:02.95,Default,,0,0,0,,Эй!
Dialogue: 0,1:31:03.04,1:31:04.79,Default,,0,0,0,,Осы жерден не істеуіміз керек?
Dialogue: 0,1:31:04.87,1:31:06.00,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:31:06.08,1:31:07.42,Default,,0,0,0,,Жоспар жоқ!
Dialogue: 0,1:31:12.13,1:31:13.38,Default,,0,0,0,,Ах Шинносуке
Dialogue: 0,1:31:13.46,1:31:14.30,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:31:21.43,1:31:24.10,Default,,0,0,0,,Мен не істеп жатырмын...
Dialogue: 0,1:31:24.18,1:31:26.18,Default,,0,0,0,,Бұл тек бір жазғы өсу.
Dialogue: 0,1:31:26.27,1:31:27.27,Default,,0,0,0,,Уф
Dialogue: 0,1:31:27.35,1:31:29.31,Default,,0,0,0,,-Шинчан! -Не?
Dialogue: 0,1:31:29.40,1:31:32.27,Default,,0,0,0,,Шин-чан, Нанаға барыңызшы!
Dialogue: 0,1:31:32.36,1:31:34.73,Default,,0,0,0,,Оря Оря Оря Оря…
Dialogue: 0,1:31:34.82,1:31:36.19,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,1:31:36.28,1:31:37.90,Default,,0,0,0,,Хааа!
Dialogue: 0,1:31:38.70,1:31:40.11,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:31:41.24,1:31:44.12,Default,,0,0,0,,Бу ража!
Dialogue: 0,1:31:45.12,1:31:49.21,Default,,0,0,0,,Ахх
Dialogue: 0,1:31:50.75,1:31:52.29,Default,,0,0,0,,Уа, ау, ау
Dialogue: 0,1:31:58.09,1:31:59.09,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:32:03.76,1:32:04.64,Default,,0,0,0,,Хмм
Dialogue: 0,1:32:07.18,1:32:08.81,Default,,0,0,0,,Керемет!
Dialogue: 0,1:32:08.89,1:32:10.27,Default,,0,0,0,,Нана!
Dialogue: 0,1:32:12.06,1:32:13.23,Default,,0,0,0,,Ой
Dialogue: 0,1:32:14.11,1:32:17.15,Default,,0,0,0,,Уау Уау ой
Dialogue: 0,1:32:17.24,1:32:19.99,Default,,0,0,0,,Уау ааа уф
Dialogue: 0,1:32:20.07,1:32:22.11,Default,,0,0,0,,Нана!
Dialogue: 0,1:32:28.75,1:32:30.29,Default,,0,0,0,,Оны тек сен ғана көресің
Dialogue: 0,1:32:30.37,1:32:32.96,Default,,0,0,0,,Не? Уау...
Dialogue: 0,1:32:33.04,1:32:34.67,Default,,0,0,0,,Уф...
Dialogue: 0,1:32:37.59,1:32:40.30,Default,,0,0,0,,Біз тегті де бірге ойнадық.
Dialogue: 0,1:32:41.38,1:32:42.93,Default,,0,0,0,,Біз де жасырынбақ ойнадық!
Dialogue: 0,1:32:43.64,1:32:44.64,Default,,0,0,0,,Оны тек сен ғана көресің
Dialogue: 0,1:32:44.72,1:32:47.52,Default,,0,0,0,,Кун...
Dialogue: 0,1:32:48.77,1:32:49.60,Default,,0,0,0,,Энн!
Dialogue: 0,1:32:49.68,1:32:52.31,Default,,0,0,0,,Нана, үйге бірге барайық!
Dialogue: 0,1:32:52.40,1:32:54.02,Default,,0,0,0,,Уф...
Dialogue: 0,1:32:55.40,1:32:58.48,Default,,0,0,0,,Бұл мүлдем ауырмайды!
Dialogue: 0,1:33:00.03,1:33:01.15,Default,,0,0,0,,Уф
Dialogue: 0,1:33:01.24,1:33:02.20,Default,,0,0,0,,Эй!
Dialogue: 0,1:33:03.49,1:33:04.66,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,1:33:05.24,1:33:07.03,Default,,0,0,0,,Банандар да бар.
Dialogue: 0,1:33:07.74,1:33:11.50,Default,,0,0,0,,Менің жазғы демалыстағы сурет күнделігім әлі біткен жоқ.
Dialogue: 0,1:33:13.33,1:33:17.00,Default,,0,0,0,,Мен бірге істегім келетін нәрселер әлі де бар.
Dialogue: 0,1:33:17.09,1:33:21.72,Default,,0,0,0,,Нана қорғаныс күшінің мүшесі!
Dialogue: 0,1:33:24.26,1:33:26.18,Default,,0,0,0,,Ах!
Dialogue: 0,1:33:53.58,1:33:55.25,Default,,0,0,0,,Анна~
Dialogue: 0,1:33:57.84,1:33:59.55,Default,,0,0,0,,Кун
Dialogue: 0,1:33:59.63,1:34:01.30,Default,,0,0,0,,Жоқ
Dialogue: 0,1:34:02.38,1:34:03.63,Default,,0,0,0,,На…
Dialogue: 0,1:34:04.55,1:34:05.59,Default,,0,0,0,,Энн!
Dialogue: 0,1:34:07.39,1:34:08.55,Default,,0,0,0,,Жоқ
Dialogue: 0,1:34:08.64,1:34:10.51,Default,,0,0,0,,Энн Энн!
Dialogue: 0,1:34:10.60,1:34:12.68,Default,,0,0,0,,-На~ -Нана!
Dialogue: 0,1:34:12.77,1:34:15.10,Default,,0,0,0,,...
Dialogue: 0,1:34:16.27,1:34:17.98,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:18.98,1:34:20.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:21.44,1:34:24.82,Default,,0,0,0,,(Мұғалімдердің күлкісі)
Dialogue: 0,1:34:27.91,1:34:28.74,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:34:28.82,1:34:30.58,Default,,0,0,0,,Нана!
Dialogue: 0,1:34:33.50,1:34:35.37,Default,,0,0,0,,Ахахаха…
Dialogue: 0,1:34:38.50,1:34:39.54,Default,,0,0,0,,Нана!
Dialogue: 0,1:34:39.63,1:34:41.38,Default,,0,0,0,,Шинносуке! Широ!
Dialogue: 0,1:34:44.67,1:34:46.30,Default,,0,0,0,,На…
Dialogue: 0,1:34:49.85,1:34:51.22,Default,,0,0,0,,Уф аа
Dialogue: 0,1:34:51.31,1:34:52.18,Default,,0,0,0,,Ах
Dialogue: 0,1:34:52.26,1:34:53.14,Default,,0,0,0,,Ах
Dialogue: 0,1:34:53.22,1:34:54.10,Default,,0,0,0,,Ах
Dialogue: 0,1:35:01.32,1:35:05.53,Default,,0,0,0,,Ууу...
Dialogue: 0,1:35:07.66,1:35:08.49,Default,,0,0,0,,Нана!?
Dialogue: 0,1:35:08.57,1:35:10.45,Default,,0,0,0,,Ха Нана!
Dialogue: 0,1:35:10.53,1:35:12.62,Default,,0,0,0,,Наа наааа...
Dialogue: 0,1:35:12.70,1:35:14.58,Default,,0,0,0,,Нана…
Dialogue: 0,1:35:14.66,1:35:18.25,Default,,0,0,0,,Наа...
Dialogue: 0,1:35:24.55,1:35:27.38,Default,,0,0,0,,Nnn…
Dialogue: 0,1:35:27.47,1:35:33.60,Default,,0,0,0,,Наа
Dialogue: 0,1:35:38.89,1:35:40.02,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:43.07,1:35:45.44,Default,,0,0,0,,Уау!
Dialogue: 0,1:35:47.99,1:35:49.36,Default,,0,0,0,,- Нана! -Анн!
Dialogue: 0,1:35:52.03,1:35:53.41,Default,,0,0,0,,Кун
Dialogue: 0,1:35:56.00,1:35:56.83,Default,,0,0,0,,Нана…
Dialogue: 0,1:35:56.91,1:35:58.25,Default,,0,0,0,,Кун
Dialogue: 0,1:35:59.83,1:36:00.71,Default,,0,0,0,,Нана…
Dialogue: 0,1:36:09.47,1:36:11.14,Default,,0,0,0,,Кешіріңіз Нана
Dialogue: 0,1:36:12.26,1:36:14.60,Default,,0,0,0,,Балаңыздың денесімен көп жұмыс істедіңіз.
Dialogue: 0,1:36:14.68,1:36:16.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:18.27,1:36:19.85,Default,,0,0,0,,Не болды?
Dialogue: 0,1:36:19.94,1:36:22.73,Default,,0,0,0,,Мықты болыңыз! Нана!
Dialogue: 0,1:36:24.11,1:36:25.61,Default,,0,0,0,,Нана…
Dialogue: 0,1:36:31.03,1:36:32.91,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:36:32.99,1:36:35.33,Default,,0,0,0,,- Нана! -(Бо-чан) Бо... Бо...
Dialogue: 0,1:36:35.95,1:36:38.58,Default,,0,0,0,,Тым қатты
Dialogue: 0,1:36:39.21,1:36:41.25,Default,,0,0,0,,Оралардың арқасында
Dialogue: 0,1:36:42.12,1:36:43.38,Default,,0,0,0,,Ах
Dialogue: 0,1:36:46.38,1:36:49.51,Default,,0,0,0,,Жоқ, барлығына мен кінәлімін.
Dialogue: 0,1:36:51.47,1:36:52.97,Default,,0,0,0,,Шинносуке-кун
Dialogue: 0,1:36:53.05,1:36:57.52,Default,,0,0,0,,Широ үшінңызға рахмет
Dialogue: 0,1:36:58.56,1:37:02.39,Default,,0,0,0,,Нана үшін сендермен өткізген уақытым керемет болды...
Dialogue: 0,1:37:02.48,1:37:05.36,Default,,0,0,0,,Менің ойымша, ол өте бақытты болды.
Dialogue: 0,1:37:06.19,1:37:08.82,Default,,0,0,0,,Мен сендермен танысқаныма қуаныштымын.
Dialogue: 0,1:37:09.69,1:37:11.20,Default,,0,0,0,,Рахмет
Dialogue: 0,1:37:18.83,1:37:25.75,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:30.30,1:37:37.22,Default,,0,0,0,,(Тілшілер дауысы)
Dialogue: 0,1:37:39.72,1:37:41.68,Default,,0,0,0,,Көпіршік мырза, бірдеңе айтыңызшы.
Dialogue: 0,1:37:41.77,1:37:43.60,Default,,0,0,0,,Неге олай өтірік айттың?
Dialogue: 0,1:37:43.69,1:37:47.06,Default,,0,0,0,,Бұл үлкен оқиға туралы не ойлайсыз?
Dialogue: 0,1:38:03.50,1:38:06.04,Default,,0,0,0,,Келтірілген қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,1:38:06.13,1:38:08.67,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,1:38:08.75,1:38:11.01,Default,,0,0,0,,-Жақсысың деп үміттенемін, Билли.-(Билли) Иә.
Dialogue: 0,1:38:11.09,1:38:12.97,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,1:38:14.09,1:38:16.93,Default,,0,0,0,,Динозаврлардан басқаға құмар болатын нәрсені іздеңіз.
Dialogue: 0,1:38:18.72,1:38:20.14,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,1:38:21.47,1:38:25.10,Default,,0,0,0,,Мен бір күні динозаврлармен қайта кездескім келеді.
Dialogue: 0,1:38:25.19,1:38:26.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:26.65,1:38:29.52,Default,,0,0,0,,Жарайды ма? осында және қазір бас тартыңыз
Dialogue: 0,1:38:29.61,1:38:30.52,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:38:30.61,1:38:33.49,Default,,0,0,0,,Арман сенен қашпайды
Dialogue: 0,1:38:34.11,1:38:37.62,Default,,0,0,0,,Көбірек ойлан, көбірек уайымда
Dialogue: 0,1:38:37.70,1:38:39.45,Default,,0,0,0,,Жауабын табыңыз
Dialogue: 0,1:38:39.53,1:38:40.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:38:42.83,1:38:45.41,Default,,0,0,0,,Түсіндім, апа.
Dialogue: 0,1:38:46.08,1:38:48.67,Default,,0,0,0,,Ал, мен болашақты асыға күтемін.
Dialogue: 0,1:38:48.75,1:38:51.88,Default,,0,0,0,,Армандар өте ыстық~
Dialogue: 0,1:38:51.96,1:38:55.84,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,1:38:55.93,1:38:58.80,Default,,0,0,0,,Мен мұны қалаймын
Dialogue: 0,1:39:06.81,1:39:08.69,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,1:39:17.15,1:39:18.95,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,1:39:19.03,1:39:20.95,Default,,0,0,0,,Бұл таңқаларлық тиімді.
Dialogue: 0,1:39:21.03,1:39:22.91,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,1:39:26.96,1:39:30.83,Default,,0,0,0,,Жазғы каникулдан кейін автобусқа жетпей қалу...
Dialogue: 0,1:39:30.92,1:39:32.80,Default,,0,0,0,,Қайырлы таң Нохара-сан
Dialogue: 0,1:39:32.88,1:39:35.17,Default,,0,0,0,,Қайырлы таң~
Dialogue: 0,1:39:35.26,1:39:38.84,Default,,0,0,0,,Қала мен үй қалпына келгеніне қуаныштымын.
Dialogue: 0,1:39:38.93,1:39:39.76,Default,,0,0,0,,Шынымен
Dialogue: 0,1:39:39.84,1:39:43.22,Default,,0,0,0,,Одорохи отбасының байлығы ғажап еді.
Dialogue: 0,1:39:43.31,1:39:47.52,Default,,0,0,0,,Мұндағы тақтайшадағы кір де дәл бұрынғыдай емес.
Dialogue: 0,1:39:47.60,1:39:51.77,Default,,0,0,0,,Жылтыр жаңа ғимарат жасаса жақсы болар еді.
Dialogue: 0,1:39:51.86,1:39:52.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:52.82,1:39:53.40,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:39:53.40,1:39:54.19,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:39:53.40,1:39:54.19,Default,,0,0,0,,Ан…
Dialogue: 0,1:39:54.19,1:39:54.27,Default,,0,0,0,,Ан…
Dialogue: 0,1:39:54.27,1:39:55.36,Default,,0,0,0,,Ан…
Dialogue: 0,1:39:54.27,1:39:55.36,Default,,0,0,0,,А, кешір, Широ, мен кешкі асты ұмытып кетіппін.
Dialogue: 0,1:39:55.36,1:39:57.19,Default,,0,0,0,,А, кешір, Широ, мен кешкі асты ұмытып кетіппін.
Dialogue: 0,1:39:57.28,1:39:58.15,Default,,0,0,0,,Хаха…
Dialogue: 0,1:39:59.28,1:40:01.12,Default,,0,0,0,,Кун...
Dialogue: 0,1:40:05.41,1:40:08.41,Default,,0,0,0,,Шин Чан бірінші күннен кешігіп қалды ма?
Dialogue: 0,1:40:09.04,1:40:11.58,Default,,0,0,0,,Бұл да бір жаздың өсімі ме?
Dialogue: 0,1:40:11.67,1:40:15.00,Default,,0,0,0,,Жоқ! Бұл шынымен ақымақ
Dialogue: 0,1:40:15.09,1:40:17.05,Default,,0,0,0,,Олай емес~
Dialogue: 0,1:40:17.13,1:40:18.97,Default,,0,0,0,,Мен сені мақтап тұрғаным жоқ!
Dialogue: 0,1:40:19.05,1:40:21.14,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,1:40:21.22,1:40:22.43,Default,,0,0,0,,Бо
Dialogue: 0,1:40:23.10,1:40:24.85,Default,,0,0,0,,Баршаңызға қайырлы таң
Dialogue: 0,1:40:24.93,1:40:27.27,Default,,0,0,0,,Жазғы демалыста үй тапсырмасын орындадың ба?
Dialogue: 0,1:40:27.35,1:40:28.39,Default,,0,0,0,,Уа!
Dialogue: 0,1:40:29.27,1:40:32.44,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:40:33.48,1:40:34.36,Default,,0,0,0,,Хой
Dialogue: 0,1:40:44.91,1:40:49.91,Default,,0,0,0,,♪～
Dialogue: 0,1:44:08.57,1:44:13.41,Default,,0,0,0,,～♪
Dialogue: 0,1:44:33.76,1:44:35.68,Default,,0,0,0,,Мен де сенімен танысқым келеді
Dialogue: 0,1:44:40.81,1:44:44.31,Default,,0,0,0,,Уахахаха әрекет сәулесі!
Dialogue: 0,1:44:44.40,1:44:46.69,Default,,0,0,0,,Уау, мен жеңілдім!
Dialogue: 0,1:44:46.78,1:44:49.82,Default,,0,0,0,,Олай болса, бұл жолы тез шомылайық.
Dialogue: 0,1:44:49.90,1:44:51.49,Default,,0,0,0,,Иә!?
Dialogue: 0,1:44:51.57,1:44:52.74,Default,,0,0,0,,Энн!
Dialogue: 0,1:44:54.24,1:45:00.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
