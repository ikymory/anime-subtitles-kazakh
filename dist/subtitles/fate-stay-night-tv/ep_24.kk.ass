Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.56,0:00:24.69,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:00:25.23,0:00:29.32,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:00:30.57,0:00:31.82,Default,,0,0,0,,Уау
Dialogue: 0,0:00:36.74,0:00:39.49,Default,,0,0,0,,Уф! Ха ха ха...
Dialogue: 0,0:00:42.29,0:00:44.16,Default,,0,0,0,,Мынадай нәрсе!
Dialogue: 0,0:00:44.54,0:00:47.13,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:00:47.88,0:00:52.26,Default,,0,0,0,,Менің әкем көп жылдар бойы осындай нәрсені алып жүруге мәжбүр болды ма?
Dialogue: 0,0:00:54.97,0:00:58.68,Default,,0,0,0,,Бала кезімде әділдіктің одақтасына сүйсіндім.
Dialogue: 0,0:00:59.60,0:01:00.93,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:01:01.06,0:01:04.85,Default,,0,0,0,,Қарияның арманын орындаймын.
Dialogue: 0,0:01:04.98,0:01:07.90,Default,,0,0,0,,Ах, мен жеңілдеп қалдым.
Dialogue: 0,0:01:12.69,0:01:13.78,Default,,0,0,0,,Иә.
Dialogue: 0,0:01:13.90,0:01:19.12,Default,,0,0,0,,Егер Ширу Эмия шынымен Кирицугу Эмиияның ұлы болса... әділет одақтасы...
Dialogue: 0,0:01:19.37,0:01:22.62,Default,,0,0,0,,Ширу Егер сіз бірдеңе жасағыңыз келсе, ол өлетін болса да жеңіңіз.
Dialogue: 0,0:01:22.91,0:01:25.96,Default,,0,0,0,,Уф! Не болса да...
Dialogue: 0,0:01:27.96,0:01:30.46,Default,,0,0,0,,Котомине - сіз жеңуіңіз керек жау.
Dialogue: 0,0:01:31.46,0:01:34.13,Default,,0,0,0,,Мен ол кісіден ұтыла алмаймын!
Dialogue: 0,0:01:34.80,0:01:36.42,Default,,0,0,0,,Өз өміріңізге қауіп төндіріңіз
Dialogue: 0,0:01:36.97,0:01:40.09,Default,,0,0,0,,Немесе ол маған жетеді.
Dialogue: 0,0:01:40.35,0:01:46.35,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:01:48.48,0:01:49.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:50.19,0:01:52.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:58.32,0:01:59.16,Default,,0,0,0,,Ах
Dialogue: 0,0:02:36.53,0:02:37.69,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:02:38.03,0:02:40.07,Default,,0,0,0,,Сіз оны сілкіп тастадыңыз ба?
Dialogue: 0,0:02:40.99,0:02:41.53,Default,,0,0,0,,Сіз
Dialogue: 0,0:02:44.91,0:02:46.41,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:02:46.91,0:02:51.21,Default,,0,0,0,,Сіз одан құтылдым деп ойлаған кезде, бұл қысқа тұйықталу ой
Dialogue: 0,0:02:51.58,0:02:54.04,Default,,0,0,0,,Бұл барлық опциялардың таусылғанын білдіре ме?
Dialogue: 0,0:02:54.29,0:02:58.05,Default,,0,0,0,,Шулы! Менде басынан жоспар болған жоқ
Dialogue: 0,0:02:58.38,0:03:00.88,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:03:02.09,0:03:02.97,Default,,0,0,0,,Хехе...
Dialogue: 0,0:03:04.64,0:03:08.85,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:03:09.77,0:03:11.60,Default,,0,0,0,,Энума Элиш!
Dialogue: 0,0:03:14.06,0:03:17.98,Default,,0,0,0,,Excalibur!
Dialogue: 0,0:03:21.28,0:03:23.11,Default,,0,0,0,,(Кашиваги) Олай деу дұрыс па?
Dialogue: 0,0:03:23.53,0:03:25.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:33.42,0:03:34.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:44.01,0:03:48.10,Default,,0,0,0,,Ой... ой... ой...
Dialogue: 0,0:03:49.18,0:03:50.64,Default,,0,0,0,,Хехе...
Dialogue: 0,0:03:54.94,0:03:55.90,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:59.48,0:04:02.03,Default,,0,0,0,,Ах… Уф…
Dialogue: 0,0:04:02.53,0:04:05.70,Default,,0,0,0,,Бұл менің рөлім болса
Dialogue: 0,0:04:05.87,0:04:08.99,Default,,0,0,0,,Әлі де істеуге болады
Dialogue: 0,0:04:10.70,0:04:11.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:37.98,0:04:38.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:42.49,0:04:43.61,Default,,0,0,0,,Энума Элиш!
Dialogue: 0,0:04:47.12,0:04:47.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:48.99,0:04:50.83,Default,,0,0,0,,Сен менің...
Dialogue: 0,0:04:54.87,0:04:56.33,Default,,0,0,0,,Бақылау қосулы
Dialogue: 0,0:05:07.39,0:05:10.72,Default,,0,0,0,,Сен менің қынам едің.
Dialogue: 0,0:05:17.60,0:05:22.90,Default,,0,0,0,,Ол армандаған утопия
Dialogue: 0,0:05:25.11,0:05:26.70,Default,,0,0,0,,Аты...
Dialogue: 0,0:05:28.28,0:05:29.74,Default,,0,0,0,,Авалон!
Dialogue: 0,0:05:57.89,0:05:58.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:00.98,0:06:01.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:06.65,0:06:09.99,Default,,0,0,0,,Және... бұл проекциялық сиқыр! ?
Dialogue: 0,0:06:12.66,0:06:13.95,Default,,0,0,0,,Иә
Dialogue: 0,0:06:18.75,0:06:20.04,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:20.88,0:06:21.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:31.34,0:06:32.35,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:06:33.35,0:06:35.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:39.81,0:06:42.52,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:06:54.66,0:06:58.45,Default,,0,0,0,,Сәлем! Мұндай кішкентай трюк!
Dialogue: 0,0:07:00.00,0:07:01.04,Default,,0,0,0,,Мысалы…
Dialogue: 0,0:07:01.17,0:07:02.42,Default,,0,0,0,,Enuma…
Dialogue: 0,0:07:02.54,0:07:05.42,Default,,0,0,0,,Калибур!
Dialogue: 0,0:07:07.59,0:07:10.76,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:18.35,0:07:21.73,Default,,0,0,0,,Котомине Кирей!
Dialogue: 0,0:07:21.85,0:07:23.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:23.90,0:07:26.15,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:07:29.94,0:07:31.95,Default,,0,0,0,,Демалыңыз! (Комине) Уау!
Dialogue: 0,0:07:35.20,0:07:37.08,Default,,0,0,0,,А... а...
Dialogue: 0,0:07:37.20,0:07:38.49,Default,,0,0,0,,Авалон…
Dialogue: 0,0:07:40.00,0:07:44.50,Default,,0,0,0,,Патша өлгеннен кейін келеді деген утопия.
Dialogue: 0,0:07:45.59,0:07:48.42,Default,,0,0,0,,Бес сиқыр да жақындай алмайды
Dialogue: 0,0:07:48.80,0:07:52.84,Default,,0,0,0,,Еш нәрсе бұзуға болмайтын соңғы қорғаныс.
Dialogue: 0,0:07:54.05,0:07:58.31,Default,,0,0,0,,Бұл сіздің нағыз асыл фантастикаңыз
Dialogue: 0,0:07:58.51,0:08:01.60,Default,,0,0,0,,Аңызға айналған киелі қылыштың құдіреті ме?
Dialogue: 0,0:08:12.49,0:08:15.28,Default,,0,0,0,,Ол жеккөрінішті әйел.
Dialogue: 0,0:08:15.95,0:08:20.54,Default,,0,0,0,,Менімен соңына дейін күресесіңдер ме?
Dialogue: 0,0:08:21.58,0:08:23.29,Default,,0,0,0,,Бірақ мен сені кешіремін
Dialogue: 0,0:08:23.83,0:08:27.08,Default,,0,0,0,,Кейбір нәрселер әдемі, өйткені олар қол жетімді емес.
Dialogue: 0,0:08:27.92,0:08:30.00,Default,,0,0,0,,Олай болса, Рыцарь патшасы
Dialogue: 0,0:08:31.96,0:08:33.67,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:34.34,0:08:37.30,Default,,0,0,0,,Бұл өте қызық болды.
Dialogue: 0,0:08:42.06,0:08:43.52,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:08:44.48,0:08:48.61,Default,,0,0,0,,Неліктен сенде бұл қылыш бар?
Dialogue: 0,0:08:48.81,0:08:50.61,Default,,0,0,0,,Бұл менікі емес
Dialogue: 0,0:08:51.11,0:08:53.28,Default,,0,0,0,,Бұл мен Тохсақадан алған нәрсе.
Dialogue: 0,0:08:53.44,0:08:54.99,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:55.61,0:08:58.62,Default,,0,0,0,,Бұрын еріксіз-
Dialogue: 0,0:08:59.78,0:09:02.62,Default,,0,0,0,,Мен оны бір қызға бердім.
Dialogue: 0,0:09:04.41,0:09:07.96,Default,,0,0,0,,Бұл 10 жыл бұрын болса керек.
Dialogue: 0,0:09:08.58,0:09:12.88,Default,,0,0,0,,Түсіндім, мен де әлсіреуім керек.
Dialogue: 0,0:09:14.13,0:09:16.13,Default,,0,0,0,,Уф, аа...
Dialogue: 0,0:09:39.41,0:09:41.28,Default,,0,0,0,,Бақылау қосулы
Dialogue: 0,0:10:02.22,0:10:04.18,Default,,0,0,0,,Қасиетті Граалды жою
Dialogue: 0,0:10:14.90,0:10:17.19,Default,,0,0,0,,Негізгі команда
Dialogue: 0,0:10:18.57,0:10:22.37,Default,,0,0,0,,Оны сенің өміріңсіз жою мүмкін емес.
Dialogue: 0,0:10:23.62,0:10:25.91,Default,,0,0,0,,Соңғы пәрмен емлесін пайдаланыңыз
Dialogue: 0,0:10:27.00,0:10:27.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:31.79,0:10:33.09,Default,,0,0,0,,Ширу
Dialogue: 0,0:10:35.84,0:10:38.72,Default,,0,0,0,,Даусыңыздан естігім келеді
Dialogue: 0,0:10:38.84,0:10:39.84,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:44.24,0:11:45.57,Default,,0,0,0,,Сабер
Dialogue: 0,0:11:49.04,0:11:51.16,Default,,0,0,0,,Өз міндеттеріңізді орындаңыз.
Dialogue: 0,0:12:26.45,0:12:27.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:11.83,0:13:13.87,Default,,0,0,0,,Міне, солай емес пе?
Dialogue: 0,0:13:14.08,0:13:14.79,Default,,0,0,0,,О
Dialogue: 0,0:13:15.75,0:13:17.29,Default,,0,0,0,,айтқан жоқпын ба?
Dialogue: 0,0:13:18.46,0:13:22.67,Default,,0,0,0,,Мен сенің қылышыңа айналып, жауларыңды жеңіп, сені қорғадым.
Dialogue: 0,0:13:23.92,0:13:26.47,Default,,0,0,0,,Осы уәдемді орындағаныма қуаныштымын.
Dialogue: 0,0:13:27.80,0:13:30.85,Default,,0,0,0,,Иә, сен жақсы жұмыс жасадың.
Dialogue: 0,0:13:32.97,0:13:36.19,Default,,0,0,0,,Соңында мен сізге бір нәрсені айтуым керек.
Dialogue: 0,0:13:48.20,0:13:49.37,Default,,0,0,0,,Ширу
Dialogue: 0,0:13:49.70,0:13:53.04,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:14:04.96,0:14:05.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:18.48,0:14:22.73,Default,,0,0,0,,А... шынымен де сізге ұқсайды.
Dialogue: 0,0:14:32.62,0:14:34.70,Default,,0,0,0,,) Сенпай Сенпай
Dialogue: 0,0:14:35.74,0:14:37.16,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:37.29,0:14:38.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:38.87,0:14:40.25,Default,,0,0,0,,Қайырлы таң Сакура
Dialogue: 0,0:14:40.37,0:14:43.25,Default,,0,0,0,,Таңғы ас дайын, сенпай.
Dialogue: 0,0:14:43.38,0:14:46.51,Default,,0,0,0,,Не? Сіз бүгін садақ ату клубының турнирін өткізесіз.
Dialogue: 0,0:14:46.63,0:14:49.17,Default,,0,0,0,,Мен таңғы ас дайындадым.
Dialogue: 0,0:14:49.38,0:14:53.30,Default,,0,0,0,,Менде әдеттегідей таң болмаса, өзімді жақсы сезінбеймін.
Dialogue: 0,0:14:53.43,0:14:54.43,Default,,0,0,0,,Түсіндім, бұл жаман.
Dialogue: 0,0:14:54.56,0:14:56.18,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:14:56.31,0:14:56.97,Default,,0,0,0,,Иә? (Сакура) Ах
Dialogue: 0,0:14:58.68,0:15:00.35,Default,,0,0,0,,Тайга! тоқта
Dialogue: 0,0:15:00.48,0:15:01.56,Default,,0,0,0,,Тежеу, тежеу
Dialogue: 0,0:15:02.10,0:15:03.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:03.27,0:15:04.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:05.02,0:15:06.36,Default,,0,0,0,,Кет, кет...!
Dialogue: 0,0:15:06.48,0:15:07.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:07.86,0:15:09.90,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:15:13.37,0:15:16.54,Default,,0,0,0,,Ширу да күшейіп кетті.
Dialogue: 0,0:15:16.66,0:15:18.37,Default,,0,0,0,,Жалаң қолмен велосипедті қалай ұстауға болады?
Dialogue: 0,0:15:18.50,0:15:19.75,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:15:19.87,0:15:24.00,Default,,0,0,0,,Ширу, оны айтудан тартынба. Кез келген уақытта Тайғаның мойнын тырнап аламын.
Dialogue: 0,0:15:24.13,0:15:25.17,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:25.29,0:15:27.67,Default,,0,0,0,,Сәлем! Сіз маған үйіңізде қалуға рұқсат бергендей мейірімді болдыңыз.
Dialogue: 0,0:15:27.80,0:15:29.01,Default,,0,0,0,,Қоқыс күні лақтырамын.
Dialogue: 0,0:15:29.13,0:15:30.76,Default,,0,0,0,,Тайга мені жібермейді
Dialogue: 0,0:15:30.88,0:15:32.09,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:15:32.22,0:15:33.76,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:15:34.39,0:15:34.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:36.26,0:15:37.60,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:15:37.72,0:15:39.81,Default,,0,0,0,,Таңертең қуырылған тофу
Dialogue: 0,0:15:39.93,0:15:41.60,Default,,0,0,0,,Тайга әлсіз
Dialogue: 0,0:15:41.73,0:15:44.52,Default,,0,0,0,,Иә? Мен оны шынымен атап өткім келеді.
Dialogue: 0,0:15:45.52,0:15:47.36,Default,,0,0,0,,Ол дәмді болды деді.
Dialogue: 0,0:15:47.48,0:15:48.32,Default,,0,0,0,,А...
Dialogue: 0,0:15:56.20,0:15:57.99,Default,,0,0,0,,Мен оны жақсы көремін!
Dialogue: 0,0:15:58.12,0:16:01.46,Default,,0,0,0,,Мен мені жақсы көремін!
Dialogue: 0,0:16:01.58,0:16:02.62,Default,,0,0,0,,Йокогама Токионың бір бөлігі ғой!
Dialogue: 0,0:16:02.75,0:16:05.04,Default,,0,0,0,,YouTube сайтында тым көп сәнді драмаларды көру
Dialogue: 0,0:16:05.17,0:16:07.17,Default,,0,0,0,,Хехе...
Dialogue: 0,0:16:12.76,0:16:13.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:21.56,0:16:24.77,Default,,0,0,0,,Котомине шіркеуіне жаңа діни қызметкер келген сияқты.
Dialogue: 0,0:16:24.90,0:16:26.06,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:26.27,0:16:28.69,Default,,0,0,0,,Рюдоужи храмын қалпына келтіру жұмыстары да жалғасуда...
Dialogue: 0,0:16:28.82,0:16:30.94,Default,,0,0,0,,Менің ойымша, қазір бәрі қалыпты жағдайға оралды.
Dialogue: 0,0:16:34.86,0:16:35.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:36.12,0:16:38.70,Default,,0,0,0,,Мен сізді көбірек көңілсіз деп ойладым.
Dialogue: 0,0:16:38.83,0:16:39.87,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:40.54,0:16:43.29,Default,,0,0,0,,Ендеше, көңілім түссе, мені жұбатасыз ба?
Dialogue: 0,0:16:43.41,0:16:46.79,Default,,0,0,0,,Амал жоқ, мен оны тепкілеп, бір күнде орнынан тұрғыздым.
Dialogue: 0,0:16:46.92,0:16:47.79,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:16:48.29,0:16:51.21,Default,,0,0,0,,Не... (Широу) Жоқ.
Dialogue: 0,0:16:51.42,0:16:53.88,Default,,0,0,0,,Өкінбейтініне сенімдімін
Dialogue: 0,0:16:55.93,0:16:58.68,Default,,0,0,0,,Ширудың ойынша ол шешілді.
Dialogue: 0,0:16:58.80,0:16:59.76,Default,,0,0,0,,О
Dialogue: 0,0:17:01.64,0:17:03.73,Default,,0,0,0,,Бір күні менің жадым өшеді...
Dialogue: 0,0:17:03.85,0:17:07.23,Default,,0,0,0,,Оның дауысы, ым-ишарасы...
Dialogue: 0,0:17:07.35,0:17:09.40,Default,,0,0,0,,Мүмкін ұмытармын
Dialogue: 0,0:17:09.90,0:17:11.07,Default,,0,0,0,,Мүмкін емес. Рақмет.
Dialogue: 0,0:17:12.11,0:17:14.65,Default,,0,0,0,,Сабердің маған ұнағаны бір ғана...
Dialogue: 0,0:17:14.78,0:17:16.07,Default,,0,0,0,,Мен әрқашан есімде сақтаймын
Dialogue: 0,0:17:20.37,0:17:21.70,Default,,0,0,0,,Ах Ширу
Dialogue: 0,0:17:22.33,0:17:24.04,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:17:41.72,0:17:42.85,Default,,0,0,0,,Артур король
Dialogue: 0,0:17:43.56,0:17:45.60,Default,,0,0,0,,Мен дереу әскерді шақырамын.
Dialogue: 0,0:17:45.73,0:17:47.14,Default,,0,0,0,,Енді осында
Dialogue: 0,0:17:47.48,0:17:48.52,Default,,0,0,0,,Бедивере
Dialogue: 0,0:17:48.65,0:17:51.32,Default,,0,0,0,,А, есін жидың ба?
Dialogue: 0,0:17:52.02,0:17:52.90,Default,,0,0,0,,Иә
Dialogue: 0,0:17:53.48,0:17:55.86,Default,,0,0,0,,Мен аздап түс көрдім
Dialogue: 0,0:17:56.49,0:17:57.95,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:17:58.11,0:17:59.07,Default,,0,0,0,,О
Dialogue: 0,0:17:59.41,0:18:01.74,Default,,0,0,0,,Мен оны көп көрмедім.
Dialogue: 0,0:18:02.16,0:18:04.29,Default,,0,0,0,,Менде құнды тәжірибе болды
Dialogue: 0,0:18:04.79,0:18:08.42,Default,,0,0,0,,Жақсылап демалыңыз.
Dialogue: 0,0:18:10.13,0:18:15.05,Default,,0,0,0,,Көзімді тағы жұмсам, арманымның жалғасын көретініме сенімдімін.
Dialogue: 0,0:18:15.17,0:18:16.92,Default,,0,0,0,,Арманның жалғасы...
Dialogue: 0,0:18:18.26,0:18:20.43,Default,,0,0,0,,Бізде бірдей арман болуы мүмкін бе?
Dialogue: 0,0:18:21.30,0:18:22.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:24.56,0:18:27.85,Default,,0,0,0,,Иә, менің де тәжірибем бар.
Dialogue: 0,0:18:28.64,0:18:30.23,Default,,0,0,0,,Егер қатты қаласаңыз
Dialogue: 0,0:18:30.35,0:18:31.61,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:32.11,0:18:34.23,Default,,0,0,0,,Сіз білімдісіз.
Dialogue: 0,0:18:39.74,0:18:41.28,Default,,0,0,0,,Бедивере
Dialogue: 0,0:18:42.91,0:18:44.37,Default,,0,0,0,,Менің қылышымды ал
Dialogue: 0,0:18:44.62,0:18:45.66,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:49.00,0:18:50.12,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:18:50.54,0:18:55.21,Default,,0,0,0,,Осы орман арқылы және сол қанды төбеден
Dialogue: 0,0:18:56.00,0:18:59.17,Default,,0,0,0,,Терең көлде...
Dialogue: 0,0:18:59.76,0:19:01.93,Default,,0,0,0,,Менің қылышымды лақтыр
Dialogue: 0,0:19:11.06,0:19:14.02,Default,,0,0,0,,Бар, Бедивер.
Dialogue: 0,0:19:17.03,0:19:18.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:00.65,0:20:03.07,Default,,0,0,0,,Тіпті жақын сезінсе де
Dialogue: 0,0:20:03.28,0:20:05.20,Default,,0,0,0,,Қолымды созсам да, ұстай алмаймын
Dialogue: 0,0:20:05.99,0:20:10.58,Default,,0,0,0,,Сонда да... Жетпесе де, жүрегіңде қалатын нәрсе болады.
Dialogue: 0,0:20:12.46,0:20:15.42,Default,,0,0,0,,Біз бір уақытта болдық және бір нәрсеге қарадық.
Dialogue: 0,0:20:16.84,0:20:18.92,Default,,0,0,0,,Есіңізде болса
Dialogue: 0,0:20:19.17,0:20:22.84,Default,,0,0,0,,Бір-бірімізден алыста болсақ та, бірге екенімізге сене аламыз.
Dialogue: 0,0:20:23.59,0:20:25.55,Default,,0,0,0,,Енді жүгіруді жалғастырыңыз
Dialogue: 0,0:20:25.89,0:20:29.31,Default,,0,0,0,,Егер сіз алысты көздесеңіз, бір күні...
Dialogue: 0,0:20:29.56,0:20:32.48,Default,,0,0,0,,Сіз мақсат еткен нәрсе сіздің қолыңызда болуы керек
Dialogue: 0,0:20:41.78,0:20:46.32,Default,,0,0,0,,Қылыш көлдің ханымының қолында екені сөзсіз.
Dialogue: 0,0:20:47.32,0:20:48.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:49.16,0:20:50.87,Default,,0,0,0,,Мақтан тұт
Dialogue: 0,0:20:51.37,0:20:54.46,Default,,0,0,0,,Сіз патшаның өмірін сақтап қалдыңыз.
Dialogue: 0,0:21:01.55,0:21:02.97,Default,,0,0,0,,Бедивере
Dialogue: 0,0:21:03.22,0:21:04.30,Default,,0,0,0,,Иә
Dialogue: 0,0:21:06.30,0:21:08.30,Default,,0,0,0,,Бұл жолғы ұйқы...
Dialogue: 0,0:21:10.39,0:21:14.23,Default,,0,0,0,,Аз… ұзақ уақыт…
Dialogue: 0,0:21:31.62,0:21:34.41,Default,,0,0,0,,Сіз іздеп жүрсіз бе? король Артур
Dialogue: 0,0:21:41.34,0:21:43.42,Default,,0,0,0,,Арманның жалғасы
Dialogue: 0,0:21:46.59,0:21:51.60,Default,,0,0,0,,♪~
Dialogue: 0,0:23:54.93,0:23:59.93,Default,,0,0,0,,~♪
