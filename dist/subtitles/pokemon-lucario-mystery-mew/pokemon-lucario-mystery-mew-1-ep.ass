Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.34,0:00:13.72,Default,,0,0,0,,Пика
Dialogue: 0,0:00:19.47,0:00:23.31,Default,,0,0,0,,Қалталы құбыжық қысқа покемон
Dialogue: 0,0:00:23.81,0:00:26.98,Default,,0,0,0,,Бұл планетадағы жұмбақ және жұмбақ тіршілік иелері
Dialogue: 0,0:00:27.52,0:00:35.20,Default,,0,0,0,,Түрлердің саны 100, 200, 300, мүмкін одан да көп.
Dialogue: 0,0:00:37.95,0:00:39.37,Default,,0,0,0,,Покемон және адамдар -
Dialogue: 0,0:00:39.45,0:00:42.62,Default,,0,0,0,,Дос және серіктес ретінде бірге жұмыс істеу -
Dialogue: 0,0:00:42.71,0:00:45.67,Default,,0,0,0,,Басқа уақытта бір-біріне жау болып қарсы шықты.
Dialogue: 0,0:00:45.75,0:00:48.92,Default,,0,0,0,,Дүние жүзінде өмір сүрген
Dialogue: 0,0:00:52.51,0:00:56.22,Default,,0,0,0,,Ал мына бала Сатоши Масала қаласынан
Dialogue: 0,0:00:58.55,0:01:01.31,Default,,0,0,0,,Шайқасып, Покемон шебері болыңыз
Dialogue: 0,0:01:01.81,0:01:04.19,Default,,0,0,0,,Жаттығу сапарын жалғастыру
Dialogue: 0,0:01:06.85,0:01:09.19,Default,,0,0,0,,Покемон қанша болса, сонша кездесу бар.
Dialogue: 0,0:01:09.27,0:01:11.82,Default,,0,0,0,,Покемон қанша болса, сонша қоштасу бар.
Dialogue: 0,0:01:12.28,0:01:16.78,Default,,0,0,0,,Міне, қанша әңгіме иірілді.
Dialogue: 0,0:01:18.45,0:01:24.25,Default,,0,0,0,,Иә, бұл баяғыда.
Dialogue: 0,0:01:54.40,0:01:56.61,Default,,0,0,0,,(О-оның айқайы)
Dialogue: 0,0:02:05.66,0:02:06.79,Default,,0,0,0,,...
Dialogue: 0,0:02:16.47,0:02:17.59,Default,,0,0,0,,...
Dialogue: 0,0:02:24.22,0:02:26.52,Default,,0,0,0,,Толқын өткізгіш туралы не деуге болады?
Dialogue: 0,0:02:53.88,0:02:54.88,Default,,0,0,0,,...
Dialogue: 0,0:03:16.40,0:03:17.40,Default,,0,0,0,,Ах
Dialogue: 0,0:03:27.33,0:03:28.37,Default,,0,0,0,,Гергар
Dialogue: 0,0:03:28.75,0:03:30.41,Default,,0,0,0,,...
Dialogue: 0,0:03:41.47,0:03:42.68,Default,,0,0,0,,Құрметті Аарон
Dialogue: 0,0:03:42.97,0:03:47.22,Default,,0,0,0,,(жаңғырық дауыс)
Dialogue: 0,0:03:53.52,0:03:54.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:59.53,0:04:00.99,Default,,0,0,0,,Құрметті Аарон
Dialogue: 0,0:04:01.32,0:04:02.66,Default,,0,0,0,,Мен сені естіп тұрмын, Лукарио.
Dialogue: 0,0:04:03.45,0:04:05.07,Default,,0,0,0,,Әскердің өте көп саны.
Dialogue: 0,0:04:06.12,0:04:09.54,Default,,0,0,0,,Мен осыған түсіп қалсам, сарайым бұзылады.
Dialogue: 0,0:04:09.95,0:04:11.46,Default,,0,0,0,,Ахахаха! Қандай қызық.
Dialogue: 0,0:04:15.38,0:04:18.42,Default,,0,0,0,,Ұрысты қазір тоқтату мүмкін емес пе?
Dialogue: 0,0:04:21.05,0:04:22.17,Default,,0,0,0,,Гергар
Dialogue: 0,0:04:38.52,0:04:40.69,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:04:42.95,0:04:45.45,Default,,0,0,0,,(Гельгардың айқайы)
Dialogue: 0,0:04:51.16,0:04:52.25,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:04:52.91,0:04:54.50,Default,,0,0,0,,...
Dialogue: 0,0:04:57.58,0:05:00.88,Default,,0,0,0,,Мен, мен, бұл жерден кете алмаймын.
Dialogue: 0,0:05:01.13,0:05:03.76,Default,,0,0,0,,Патша болып тағдырымды қамалмен бөлісемін.
Dialogue: 0,0:05:04.63,0:05:05.68,Default,,0,0,0,,Құрметті Лин...
Dialogue: 0,0:05:14.35,0:05:15.89,Default,,0,0,0,,Пиджеотто
Dialogue: 0,0:05:17.19,0:05:18.81,Default,,0,0,0,,Пиджеотто
Dialogue: 0,0:05:34.79,0:05:36.12,Default,,0,0,0,,(Қаруланғандардың айқайы)
Dialogue: 0,0:05:36.46,0:05:39.33,Default,,0,0,0,,Пихо Пихо
Dialogue: 0,0:05:40.75,0:05:42.71,Default,,0,0,0,,Пиджеотто
Dialogue: 0,0:05:43.67,0:05:44.92,Default,,0,0,0,,Пихо Пихо
Dialogue: 0,0:05:45.13,0:05:47.26,Default,,0,0,0,,Біз әдетте соншалықты алдын ала брондамаймыз, сондықтан асығыс емесбіз
Dialogue: 0,0:05:48.80,0:05:50.01,Default,,0,0,0,,Пижо
Dialogue: 0,0:05:52.47,0:05:53.47,Default,,0,0,0,,Пиджеотто
Dialogue: 0,0:05:53.56,0:05:55.14,Default,,0,0,0,,Көгершін
Dialogue: 0,0:06:03.57,0:06:04.90,Default,,0,0,0,,Құрметті Аарон
Dialogue: 0,0:06:09.24,0:06:10.28,Default,,0,0,0,,Құрметті Аарон
Dialogue: 0,0:06:10.37,0:06:12.53,Default,,0,0,0,,Лукарио, сенің көздерің...
Dialogue: 0,0:06:12.62,0:06:14.29,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:06:15.50,0:06:17.41,Default,,0,0,0,,Осы жерден кетіңіз, иә?
Dialogue: 0,0:06:17.92,0:06:20.54,Default,,0,0,0,,Мен сарайды тастап кеттім
Dialogue: 0,0:06:20.92,0:06:23.21,Default,,0,0,0,,Мен ол сарайға енді қайтып оралмаймын.
Dialogue: 0,0:06:24.30,0:06:25.63,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:06:28.13,0:06:29.47,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:06:31.39,0:06:32.39,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:32.93,0:06:34.06,Default,,0,0,0,,Уф
Dialogue: 0,0:06:36.35,0:06:37.81,Default,,0,0,0,,Құрметті Аарон
Dialogue: 0,0:06:47.69,0:06:49.95,Default,,0,0,0,,Неліктен...?
Dialogue: 0,0:07:10.68,0:07:15.18,Default,,0,0,0,,Ағаш, дүниенің басындағы ағаш, жылайды.
Dialogue: 0,0:07:36.83,0:07:40.96,Default,,0,0,0,,Пиджот Пиджотто
Dialogue: 0,0:07:44.59,0:07:47.17,Default,,0,0,0,,(О-оның айқайы)
Dialogue: 0,0:08:09.74,0:08:13.16,Default,,0,0,0,,Pijot Pijot
Dialogue: 0,0:08:15.82,0:08:17.41,Default,,0,0,0,,Пиджеотто
Dialogue: 0,0:08:19.54,0:08:20.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:22.71,0:08:24.79,Default,,0,0,0,,Пиджеотто
Dialogue: 0,0:08:25.63,0:08:26.92,Default,,0,0,0,,Аарон…
Dialogue: 0,0:09:26.56,0:09:29.15,Default,,0,0,0,,«Лин патшайым ойлады»
Dialogue: 0,0:09:29.69,0:09:33.28,Default,,0,0,0,,«Толқынбағдарламасының қолданушысы Аарон Мью сонда тұрады деді...»
Dialogue: 0,0:09:33.36,0:09:37.11,Default,,0,0,0,,«Ол дүниенің басында ағаштың күшін пайдаланды».
Dialogue: 0,0:09:37.53,0:09:39.03,Default,,0,0,0,,Сонда?
Dialogue: 0,0:09:39.24,0:09:43.66,Default,,0,0,0,,«Жер бетін жаулаған өшпенділік пен ашу басылды».
Dialogue: 0,0:09:44.25,0:09:45.58,Default,,0,0,0,,«Покемон...»
Dialogue: 0,0:09:45.66,0:09:48.54,Default,,0,0,0,,«Олар өз орындарына оралды».
Dialogue: 0,0:09:49.75,0:09:54.21,Default,,0,0,0,,«Бұл жерге тағы да бейбітшілік келді».
Dialogue: 0,0:09:55.34,0:09:56.93,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,0:09:58.89,0:10:00.30,Default,,0,0,0,,«Ал Һарон...»
Dialogue: 0,0:10:00.39,0:10:04.47,Default,,0,0,0,,«Қазір толқын жетекші қаһарман ретінде белгілі».
Dialogue: 0,0:10:05.68,0:10:08.44,Default,,0,0,0,,Қайта оқу: Толқын жетектеген батырдың оқиғасы
Dialogue: 0,0:10:08.52,0:10:09.81,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:10:09.90,0:10:11.23,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:44.57,0:11:46.20,Default,,0,0,0,,Покемон шебері болуды мақсат ету —
Dialogue: 0,0:11:46.28,0:11:51.04,Default,,0,0,0,,Саяхаттарын жалғастыра отырып, Сатоши және оның достары осында, Олдран сарайына келді.
Dialogue: 0,0:11:51.37,0:11:52.79,Default,,0,0,0,,Осы сарайда өтті
Dialogue: 0,0:11:52.87,0:11:57.00,Default,,0,0,0,,Толқындардың қаһарманы Ааронды құрметтейтін фестивальге қатысу.
Dialogue: 0,0:11:57.71,0:12:00.22,Default,,0,0,0,,Покемон сарайындағы шайқастың жеңімпазы...
Dialogue: 0,0:12:00.30,0:12:02.13,Default,,0,0,0,,Жылдың толқын гид кейіпкері ретінде—
Dialogue: 0,0:12:02.63,0:12:04.39,Default,,0,0,0,,Мақтады.
Dialogue: 0,0:12:04.47,0:12:06.68,Default,,0,0,0,,Мен жеңілмеймін, Пикер.
Dialogue: 0,0:12:06.76,0:12:08.27,Default,,0,0,0,,Құлып оқиғалары үшін—
Dialogue: 0,0:12:08.35,0:12:10.85,Default,,0,0,0,,Сіз ескі киіміңізбен қатысуыңыз керек.
Dialogue: 0,0:12:10.93,0:12:13.48,Default,,0,0,0,,Иә, менде ондай жоқ.
Dialogue: 0,0:12:13.56,0:12:16.57,Default,,0,0,0,,Хмм, сарай оны саған дайындап жатыр.
Dialogue: 0,0:12:16.65,0:12:19.15,Default,,0,0,0,,Шынымен бе? Қызық, батырдың киімі де бар ма?
Dialogue: 0,0:12:19.23,0:12:20.44,Default,,0,0,0,,Пикер
Dialogue: 0,0:12:20.53,0:12:22.86,Default,,0,0,0,,Осы уақытта Пикачу да киінеді ме?
Dialogue: 0,0:12:22.95,0:12:25.66,Default,,0,0,0,,А, бұл жақсы шығар, Пика?
Dialogue: 0,0:12:26.16,0:12:28.08,Default,,0,0,0,,СПА
Dialogue: 0,0:12:38.42,0:12:40.38,Default,,0,0,0,,Суба Суба
Dialogue: 0,0:12:41.88,0:12:43.26,Default,,0,0,0,,Пичу
Dialogue: 0,0:12:43.63,0:12:44.97,Default,,0,0,0,,Пипипипи
Dialogue: 0,0:12:45.05,0:12:47.18,Default,,0,0,0,,Пипипи пикчу
Dialogue: 0,0:12:54.98,0:12:58.36,Default,,0,0,0,,Уау, осылардың бірін таңдай аламын ба?
Dialogue: 0,0:12:58.44,0:13:01.03,Default,,0,0,0,,Мен қайсысын таңдауым керек? мен адасып кетем
Dialogue: 0,0:13:01.11,0:13:02.82,Default,,0,0,0,,Батырдың киімі қандай?
Dialogue: 0,0:13:03.86,0:13:05.70,Default,,0,0,0,,Мен, у...
Dialogue: 0,0:13:06.11,0:13:07.32,Default,,0,0,0,,Пика?
Dialogue: 0,0:13:07.41,0:13:08.87,Default,,0,0,0,,Пичу Пи?
Dialogue: 0,0:13:09.08,0:13:10.70,Default,,0,0,0,,Пикачу?
Dialogue: 0,0:13:13.16,0:13:14.41,Default,,0,0,0,,Camo Camo Pika?
Dialogue: 0,0:13:15.12,0:13:16.75,Default,,0,0,0,,Camo Camo Camo
Dialogue: 0,0:13:16.83,0:13:18.59,Default,,0,0,0,,Камо Камо Пика
Dialogue: 0,0:13:19.09,0:13:20.42,Default,,0,0,0,,Camo Camo Camo
Dialogue: 0,0:13:20.50,0:13:23.84,Default,,0,0,0,,Camo Camo Camo Camo Camo Camo
Dialogue: 0,0:13:24.22,0:13:25.26,Default,,0,0,0,,Пика?
Dialogue: 0,0:13:25.34,0:13:27.26,Default,,0,0,0,,Ja~ Pi?
Dialogue: 0,0:13:28.14,0:13:30.26,Default,,0,0,0,,Сіз қалай ойлайсыз? пикачу
Dialogue: 0,0:13:31.64,0:13:32.68,Default,,0,0,0,,Ахаха
Dialogue: 0,0:13:32.85,0:13:33.85,Default,,0,0,0,,Пикер
Dialogue: 0,0:13:33.93,0:13:35.56,Default,,0,0,0,,Үлкен әпке?
Dialogue: 0,0:13:35.64,0:13:36.98,Default,,0,0,0,,Қош бол
Dialogue: 0,0:13:37.06,0:13:39.02,Default,,0,0,0,,А, бұл сізге жарасады, солай емес пе?
Dialogue: 0,0:13:39.11,0:13:40.32,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:13:40.40,0:13:43.11,Default,,0,0,0,,Хехе, мен батырмын. Қалай ойлайсың, Пикачу?
Dialogue: 0,0:13:43.74,0:13:47.16,Default,,0,0,0,,Пика~ Пип... Пип Пи?
Dialogue: 0,0:13:47.66,0:13:49.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:49.62,0:13:53.37,Default,,0,0,0,,Пика сигналдық сигнал сигналы сигнал сигналы сигнал сигналы сигнал сигналы
Dialogue: 0,0:13:53.91,0:13:55.08,Default,,0,0,0,,Пика?
Dialogue: 0,0:13:55.29,0:13:56.71,Default,,0,0,0,,Сүйкімді болуы мүмкін
Dialogue: 0,0:13:56.79,0:13:58.79,Default,,0,0,0,,Саған жарасады, Пика~
Dialogue: 0,0:13:58.88,0:14:01.42,Default,,0,0,0,,Покемон шайқасы басталғалы тұр.
Dialogue: 0,0:14:01.50,0:14:03.46,Default,,0,0,0,,Жарайды, Пикачу, кеттік.
Dialogue: 0,0:14:03.55,0:14:04.84,Default,,0,0,0,,Пика
Dialogue: 0,0:14:05.88,0:14:08.84,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:14:10.10,0:14:12.18,Default,,0,0,0,,Хисо сута та тат
Dialogue: 0,0:14:12.26,0:14:14.14,Default,,0,0,0,,Барлығы оған сіңіп кеткенде —
Dialogue: 0,0:14:14.22,0:14:17.35,Default,,0,0,0,,Мен осы сарайдағы барлық Покемондарды жинаймын.
Dialogue: 0,0:14:17.44,0:14:20.44,Default,,0,0,0,,Ой, мен бірінші киімімді ауыстыруым керек.
Dialogue: 0,0:14:20.52,0:14:22.15,Default,,0,0,0,,Мен қайсысын таңдауым керек?
Dialogue: 0,0:14:22.23,0:14:24.03,Default,,0,0,0,,Тезірек, о
Dialogue: 0,0:14:24.53,0:14:27.45,Default,,0,0,0,,Бұл өте жақсы Ахахха
Dialogue: 0,0:14:27.70,0:14:29.03,Default,,0,0,0,,Е, тез!
Dialogue: 0,0:14:29.11,0:14:30.78,Default,,0,0,0,,Сонанс
Dialogue: 0,0:14:32.03,0:14:38.67,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:14:40.13,0:14:42.71,Default,,0,0,0,,Осы елдің патшайымы —
Dialogue: 0,0:14:42.79,0:14:46.72,Default,,0,0,0,,Айрин ханым, Олдран сарайының лорды
Dialogue: 0,0:14:46.80,0:14:50.47,Default,,0,0,0,,Охохо!
Dialogue: 0,0:14:50.55,0:14:56.18,Default,,0,0,0,,Манене Манене Манене
Dialogue: 0,0:14:56.64,0:14:59.10,Default,,0,0,0,,Патшайым жақсы болуы мүмкін
Dialogue: 0,0:14:59.77,0:15:01.52,Default,,0,0,0,,Бұдан былай әлем құтқарылды —
Dialogue: 0,0:15:01.61,0:15:05.23,Default,,0,0,0,,Толқындардың қаһарманы Ааронға арналған Покемон шайқасын бастаңыз
Dialogue: 0,0:15:05.32,0:15:11.32,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:17:11.94,0:17:17.95,Default,,0,0,0,,~♪
Dialogue: 0,0:17:20.95,0:17:24.08,Default,,0,0,0,,Өндіруші қабілетсіз Пикачу жеңеді
Dialogue: 0,0:17:24.16,0:17:27.88,Default,,0,0,0,,Сондықтан, биылғы «Толқын гид» кейіпкері - Масара қаласынан Сатоши.
Dialogue: 0,0:17:27.96,0:17:28.42,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:17:28.42,0:17:30.63,Default,,0,0,0,,О, мен жасадым, мен жасадым, Мане~
Dialogue: 0,0:17:30.63,0:17:33.84,Default,,0,0,0,,Әй, мен жасадым, мен жасадым, Мане~
Dialogue: 0,0:17:34.13,0:17:35.88,Default,,0,0,0,,Пикачу Пиппи Пика
Dialogue: 0,0:17:35.97,0:17:38.72,Default,,0,0,0,,(Айпамның айқайы)
Dialogue: 0,0:17:38.80,0:17:40.68,Default,,0,0,0,,Пикачу~
Dialogue: 0,0:17:40.76,0:17:41.77,Default,,0,0,0,,Иә? Пика?
Dialogue: 0,0:17:43.77,0:17:44.81,Default,,0,0,0,,Аа...
Dialogue: 0,0:17:45.77,0:17:48.23,Default,,0,0,0,,Сіз және Пикачу ең жақсы серіктессіз.
Dialogue: 0,0:17:48.52,0:17:53.15,Default,,0,0,0,,Әйел? а? а?
Dialogue: 0,0:17:53.69,0:17:56.57,Default,,0,0,0,,Мен баламын. Сізбен танысқаныма қуаныштымын. Мен Сатошимін.
Dialogue: 0,0:17:57.11,0:17:58.99,Default,,0,0,0,,Менің атым Такеши.
Dialogue: 0,0:17:59.28,0:18:01.24,Default,,0,0,0,,Иә? Мен өзімді әдемі ханым деп санаймын.
Dialogue: 0,0:18:01.33,0:18:02.54,Default,,0,0,0,,Ең жақсы серіктес болу —
Dialogue: 0,0:18:02.62,0:18:04.29,Default,,0,0,0,,Жаса... ауырады ауырады иә иә
Dialogue: 0,0:18:04.37,0:18:06.87,Default,,0,0,0,,Сол жерден серіктес тауып алайық.
Dialogue: 0,0:18:07.50,0:18:09.42,Default,,0,0,0,,Пам пам сигналы… дыбыстық сигнал
Dialogue: 0,0:18:09.50,0:18:12.17,Default,,0,0,0,,Папа папа Пам Пам Пикачу
Dialogue: 0,0:18:29.56,0:18:31.73,Default,,0,0,0,,Бұл Аарон, Толқындардың қаһарманы.
Dialogue: 0,0:18:31.82,0:18:34.11,Default,,0,0,0,,Мынау ие болған деген батырдың таяғы.
Dialogue: 0,0:18:34.19,0:18:35.74,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:18:35.82,0:18:38.49,Default,,0,0,0,,Покемон шайқасында жеңіске жетті.
Dialogue: 0,0:18:38.57,0:18:42.49,Default,,0,0,0,,Бұған батыр ретінде таңдалғандар ғана ие болады.
Dialogue: 0,0:18:42.58,0:18:44.16,Default,,0,0,0,,Керемет Пика
Dialogue: 0,0:18:44.24,0:18:46.75,Default,,0,0,0,,Ал, Сатоши.
Dialogue: 0,0:18:46.83,0:18:47.87,Default,,0,0,0,,Иә
Dialogue: 0,0:18:48.67,0:18:49.92,Default,,0,0,0,,(Барлық қошемет)
Dialogue: 0,0:18:49.92,0:18:52.29,Default,,0,0,0,,Мынау толқынбатырдың таяғы.
Dialogue: 0,0:18:52.29,0:18:53.09,Default,,0,0,0,,(Барлық қошемет)
Dialogue: 0,0:18:53.09,0:18:53.59,Default,,0,0,0,,Пи~ка~ Иә?
Dialogue: 0,0:18:53.59,0:18:55.21,Default,,0,0,0,,Пи~ка~ Иә?
Dialogue: 0,0:18:58.05,0:18:59.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:59.80,0:19:01.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:01.85,0:19:03.93,Default,,0,0,0,,Ана? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:19:04.01,0:19:05.22,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:05.56,0:19:06.93,Default,,0,0,0,,Pi? Пика? Мама мама~
Dialogue: 0,0:19:08.23,0:19:12.27,Default,,0,0,0,,Осы елдің тыныштығын қорғаған ержүрек Һаронды мадақтау.
Dialogue: 0,0:19:12.36,0:19:13.86,Default,,0,0,0,,Бүгінгі кешті көңілді өткізейік
Dialogue: 0,0:19:31.25,0:19:35.59,Default,,0,0,0,,Уау ахаха хаха хехехе ахаха
Dialogue: 0,0:19:36.00,0:19:37.51,Default,,0,0,0,,Ки… Ки… Кид мырза
Dialogue: 0,0:19:37.84,0:19:39.88,Default,,0,0,0,,Одо... Ододо... Би билей аласыз ба?
Dialogue: 0,0:19:39.97,0:19:41.01,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:41.09,0:19:43.51,Default,,0,0,0,,Хахаха, мен құрметтімін.
Dialogue: 0,0:19:46.76,0:19:48.52,Default,,0,0,0,,Қобалжудың қажеті жоқ.
Dialogue: 0,0:19:48.60,0:19:50.85,Default,,0,0,0,,Мен қуанып тұрмын, өйткені мен сені жетелеймін.
Dialogue: 0,0:19:53.35,0:19:54.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:55.27,0:19:59.82,Default,,0,0,0,,Пикка Пикка Пиккачу~
Dialogue: 0,0:19:59.90,0:20:01.20,Default,,0,0,0,,Пика
Dialogue: 0,0:20:01.28,0:20:05.62,Default,,0,0,0,,Пика пика чуу пика
Dialogue: 0,0:20:06.03,0:20:07.49,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:20:08.08,0:20:11.08,Default,,0,0,0,,Жарайды, бәріміз бірге кешті тамашалаңдар.
Dialogue: 0,0:20:14.08,0:20:15.08,Default,,0,0,0,,Пикер шпоры
Dialogue: 0,0:20:15.17,0:20:16.17,Default,,0,0,0,,Джуэй
Dialogue: 0,0:20:16.25,0:20:17.30,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,0:20:17.38,0:20:19.26,Default,,0,0,0,,Паопаопао
Dialogue: 0,0:20:19.34,0:20:22.51,Default,,0,0,0,,Аа, бір сәт кешіріңіз.
Dialogue: 0,0:20:25.09,0:20:26.14,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:20:26.76,0:20:27.97,Default,,0,0,0,,pao pao pao pao gamecock
Dialogue: 0,0:20:28.06,0:20:29.27,Default,,0,0,0,,Зени кетті
Dialogue: 0,0:20:29.35,0:20:30.77,Default,,0,0,0,,Пикка Пикка
Dialogue: 0,0:20:30.85,0:20:32.27,Default,,0,0,0,,(Жіті шулар)
Dialogue: 0,0:20:32.94,0:20:35.94,Default,,0,0,0,,Жарайды, мен де той берейін.
Dialogue: 0,0:20:36.02,0:20:38.44,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:20:38.52,0:20:40.69,Default,,0,0,0,,Батыр өз орнын тастамауы керек.
Dialogue: 0,0:20:40.90,0:20:42.57,Default,,0,0,0,,(Йотаро Куджо) Өкінішті, бірақ осы сапарда… Какёинге жарыстан шығудан басқа амал қалмауы мүмкін.
Dialogue: 0,0:20:43.61,0:20:44.61,Default,,0,0,0,,Хаа... Мане
Dialogue: 0,0:21:03.51,0:21:06.09,Default,,0,0,0,,Енді Покемонды ұстау мүмкіндігі емес пе?
Dialogue: 0,0:21:06.18,0:21:09.10,Default,,0,0,0,,Мен бұл көйлекпен тағы біраз билеймін.
Dialogue: 0,0:21:09.18,0:21:10.47,Default,,0,0,0,,Оны кигенім үшін кешіріңіз.
Dialogue: 0,0:21:10.77,0:21:11.81,Default,,0,0,0,,Ах
Dialogue: 0,0:21:12.52,0:21:14.39,Default,,0,0,0,,Сіз билеуде жақсысыз.
Dialogue: 0,0:21:14.48,0:21:16.02,Default,,0,0,0,,Пампака-пан!
Dialogue: 0,0:21:16.10,0:21:18.90,Default,,0,0,0,,Жақсы адам, менде махаббат сезімі бар.
Dialogue: 0,0:21:18.98,0:21:20.40,Default,,0,0,0,,Ахаха Ахаха Ах Ах Ах Ах
Dialogue: 0,0:21:20.48,0:21:21.82,Default,,0,0,0,,Уау, бұл жақсы сезім
Dialogue: 0,0:21:22.53,0:21:23.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:24.57,0:21:26.16,Default,,0,0,0,,Біз бір жерде кездестік пе?
Dialogue: 0,0:21:26.24,0:21:28.53,Default,,0,0,0,,Иә, жоқ, олай болуы мүмкін емес...
Dialogue: 0,0:21:31.87,0:21:35.83,Default,,0,0,0,,Мереке, шарлар көп, ең жақсы
Dialogue: 0,0:21:35.92,0:21:38.46,Default,,0,0,0,,Пам Айпам Пика Пика
Dialogue: 0,0:21:38.75,0:21:40.17,Default,,0,0,0,,Пика Сәлем
Dialogue: 0,0:21:40.25,0:21:42.59,Default,,0,0,0,,Эй, эй, Зени Зени Зени
Dialogue: 0,0:21:42.67,0:21:44.01,Default,,0,0,0,,Жабу (Мияу) Мияу?
Dialogue: 0,0:21:44.22,0:21:46.76,Default,,0,0,0,,Пикка Пикка Паппа Пао
Dialogue: 0,0:21:50.22,0:21:53.14,Default,,0,0,0,,Такеши-кун, сен маған сусын әкеле аласың ба?
Dialogue: 0,0:21:53.22,0:21:56.06,Default,,0,0,0,,Әрине, күте тұрыңыз.
Dialogue: 0,0:21:56.60,0:21:58.52,Default,,0,0,0,,Пика Пика Эй, эй, эй
Dialogue: 0,0:21:58.60,0:22:00.44,Default,,0,0,0,,Пика пика эй эй эй
Dialogue: 0,0:22:01.36,0:22:02.36,Default,,0,0,0,,Ня?
Dialogue: 0,0:22:04.24,0:22:05.24,Default,,0,0,0,,Миау
Dialogue: 0,0:22:05.32,0:22:07.49,Default,,0,0,0,,Әй, няаа
Dialogue: 0,0:22:11.16,0:22:13.54,Default,,0,0,0,,Мияу... Мияу?
Dialogue: 0,0:22:14.70,0:22:16.54,Default,,0,0,0,,Ол жақта таң атты.
Dialogue: 0,0:22:17.12,0:22:19.33,Default,,0,0,0,,Сіз таңғы асыңызды бітірдіңіз бе? банктер
Dialogue: 0,0:22:19.42,0:22:21.79,Default,,0,0,0,,Бұл круассан мен кофе болды.
Dialogue: 0,0:22:22.13,0:22:23.88,Default,,0,0,0,,Сіз де салат жеуіңіз керек.
Dialogue: 0,0:22:23.96,0:22:25.47,Default,,0,0,0,,Кейінірек көкөніс шырыны —
Dialogue: 0,0:22:25.55,0:22:27.30,Default,,0,0,0,,Алайық.
Dialogue: 0,0:22:27.38,0:22:28.72,Default,,0,0,0,,Балдыркөкті де қосыңыз.
Dialogue: 0,0:22:28.97,0:22:30.93,Default,,0,0,0,,Мен бұған жақсы емеспін.
Dialogue: 0,0:22:31.01,0:22:32.43,Default,,0,0,0,,Сіз таңдай алмайсыз.
Dialogue: 0,0:22:32.51,0:22:33.89,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:22:34.93,0:22:38.14,Default,,0,0,0,,Кешкі асты ішіп қойдыңыз ба, жас ханым?
Dialogue: 0,0:22:38.23,0:22:42.07,Default,,0,0,0,,Бұл сарай кеші, сондықтан ол экстравагант болуы керек.
Dialogue: 0,0:22:42.15,0:22:45.49,Default,,0,0,0,,Жұмыстан кейін мерекені сізге қалдырамын.
Dialogue: 0,0:22:45.57,0:22:46.69,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:22:46.78,0:22:48.24,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:22:48.32,0:22:51.37,Default,,0,0,0,,Оның орнына маған осы сарайдың еден жоспарын жіберіңізші.
Dialogue: 0,0:22:51.45,0:22:53.58,Default,,0,0,0,,Мен душ қабылдағаным дұрыс па?
Dialogue: 0,0:22:53.66,0:22:54.66,Default,,0,0,0,,Ханым
Dialogue: 0,0:22:54.74,0:22:57.12,Default,,0,0,0,,Мен кешкі асты кідіртемін.
Dialogue: 0,0:22:57.21,0:22:59.58,Default,,0,0,0,,30 секунд күтіңіз.
Dialogue: 0,0:22:59.67,0:23:00.75,Default,,0,0,0,,20 секунд.
Dialogue: 0,0:23:00.83,0:23:02.13,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:23:05.67,0:23:08.97,Default,,0,0,0,,Күткеніңізге рахмет. Біз оны сізге жібереміз.
Dialogue: 0,0:23:09.05,0:23:10.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:23:10.26,0:23:12.51,Default,,0,0,0,,Ақылсыз ештеңе жасамаңыз.
Dialogue: 0,0:23:12.72,0:23:16.39,Default,,0,0,0,,Иә, иә, түсінемін, Бас Батлер Бэнкс.
Dialogue: 0,0:23:17.77,0:23:18.85,Default,,0,0,0,,Мияу...
Dialogue: 0,0:23:21.60,0:23:25.15,Default,,0,0,0,,Ня мен оның достары іскер бәсекелес болуы мүмкін.
Dialogue: 0,0:23:37.33,0:23:41.33,Default,,0,0,0,,Пикачу қайда кетті? Ах...
Dialogue: 0,0:23:45.17,0:23:46.46,Default,,0,0,0,,Жоқ
Dialogue: 0,0:23:47.21,0:23:48.80,Default,,0,0,0,,Гомбе?
Dialogue: 0,0:23:49.59,0:23:52.80,Default,,0,0,0,,Айпам Айпам Пика Пика Пика
Dialogue: 0,0:23:54.18,0:23:55.18,Default,,0,0,0,,Скат
Dialogue: 0,0:23:55.72,0:23:57.39,Default,,0,0,0,,Апалм Ай
Dialogue: 0,0:23:57.47,0:23:59.85,Default,,0,0,0,,(Пикачу таңданған дауысы)
Dialogue: 0,0:24:10.28,0:24:12.32,Default,,0,0,0,,А? а?
Dialogue: 0,0:24:12.41,0:24:13.57,Default,,0,0,0,,Ммм... Аа?
Dialogue: 0,0:24:24.42,0:24:27.13,Default,,0,0,0,,(Пикачудың көңілді дауысы)
Dialogue: 0,0:24:27.21,0:24:28.67,Default,,0,0,0,,Papapa Pao
Dialogue: 0,0:24:28.75,0:24:30.72,Default,,0,0,0,,Папа Пао Пао (Джуптордың айқайы)
Dialogue: 0,0:24:30.80,0:24:33.09,Default,,0,0,0,,Хе хе хе хе эй зе зени
Dialogue: 0,0:24:34.76,0:24:35.97,Default,,0,0,0,,Пика?
Dialogue: 0,0:24:36.05,0:24:37.64,Default,,0,0,0,,Эй, эй, эй
Dialogue: 0,0:24:37.72,0:24:39.35,Default,,0,0,0,,Дане
Dialogue: 0,0:24:39.81,0:24:41.27,Default,,0,0,0,,Pika
Dialogue: 0,0:24:42.31,0:24:44.77,Default,,0,0,0,,Aeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeayyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy possible?
Dialogue: 0,0:24:50.99,0:24:52.90,Default,,0,0,0,,Peeker
Dialogue: 0,0:24:54.82,0:24:56.28,Default,,0,0,0,,Pika Aayei
Dialogue: 0,0:24:56.37,0:24:57.66,Default,,0,0,0,,Апалма
Dialogue: 0,0:24:58.95,0:25:00.24,Default,,0,0,0,,Apalm
Dialogue: 0,0:25:00.33,0:25:01.91,Default,,0,0,0,,Pika pika?
Dialogue: 0,0:25:03.12,0:25:09.17,Default,,0,0,0,,(Пикачудың көңілді дауысы)
Dialogue: 0,0:25:10.21,0:25:11.59,Default,,0,0,0,,Hmm... uh...
Dialogue: 0,0:25:12.38,0:25:15.26,Default,,0,0,0,,Мм... ше... ахахаха
Dialogue: 0,0:25:15.34,0:25:17.30,Default,,0,0,0,,Үлкен дөңгелектер аа...
Dialogue: 0,0:25:17.39,0:25:18.39,Default,,0,0,0,,Hahahaha aaah
Dialogue: 0,0:25:18.60,0:25:20.14,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:25:28.27,0:25:29.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:25:38.07,0:25:39.41,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:25:47.08,0:25:48.83,Default,,0,0,0,,Amazing nya
Dialogue: 0,0:25:48.92,0:25:50.25,Default,,0,0,0,,Meow Meow
Dialogue: 0,0:25:50.34,0:25:52.88,Default,,0,0,0,,Няняняняняня…
Dialogue: 0,0:25:52.96,0:25:54.05,Default,,0,0,0,,Meow!
Dialogue: 0,0:25:54.38,0:25:56.97,Default,,0,0,0,,(ренжіген дауыс)
Dialogue: 0,0:25:57.22,0:25:59.22,Default,,0,0,0,,Nyaa~
Dialogue: 0,0:26:00.68,0:26:05.35,Default,,0,0,0,,Gone Gong Gon Gone Gong Gone
Dialogue: 0,0:26:05.94,0:26:07.10,Default,,0,0,0,,Әй?
Dialogue: 0,0:26:17.74,0:26:20.12,Default,,0,0,0,,Пикачу hei hei
Dialogue: 0,0:26:20.20,0:26:22.24,Default,,0,0,0,,Мью Pika?
Dialogue: 0,0:26:25.58,0:26:26.96,Default,,0,0,0,,I found it.
Dialogue: 0,0:26:27.04,0:26:28.46,Default,,0,0,0,,Ману (Манула) Ману
Dialogue: 0,0:26:28.54,0:26:31.00,Default,,0,0,0,,Жарайсың ба? Бұл таратқышты Мью жүйесіне қосыңыз
Dialogue: 0,0:26:31.09,0:26:32.50,Default,,0,0,0,,New
Dialogue: 0,0:26:33.75,0:26:34.96,Default,,0,0,0,,Жаңа
Dialogue: 0,0:26:41.01,0:26:42.01,Default,,0,0,0,,Ня?
Dialogue: 0,0:26:42.93,0:26:44.10,Default,,0,0,0,,Ня?
Dialogue: 0,0:26:44.18,0:26:45.52,Default,,0,0,0,,Пика (Мияу) Аня
Dialogue: 0,0:26:45.60,0:26:47.69,Default,,0,0,0,,Omyara Мью
Dialogue: 0,0:26:47.77,0:26:50.44,Default,,0,0,0,,Ня Мюу ня (Мюудың күлкісі)
Dialogue: 0,0:26:50.52,0:26:51.90,Default,,0,0,0,,Neurat
Dialogue: 0,0:26:51.98,0:26:53.86,Default,,0,0,0,,Pika Мью
Dialogue: 0,0:26:54.48,0:26:55.99,Default,,0,0,0,,Миу Миу (Манулас) Ману Ману
