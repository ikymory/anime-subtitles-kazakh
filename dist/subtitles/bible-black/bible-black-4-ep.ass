Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:21.08,0:00:24.60,Default,,0,0,0,,Шынайы тазалық
Dialogue: 0,0:00:26.96,0:00:29.57,Default,,0,0,0,,Тиісті уақытты күту ғана қалды
Dialogue: 0,0:00:57.66,0:01:00.14,Default,,0,0,0,,Минасэ-кун бұл кітапты алды.
Dialogue: 0,0:01:02.00,0:01:04.14,Default,,0,0,0,,Мүмкін бұл
Dialogue: 0,0:01:14.26,0:01:15.95,Default,,0,0,0,,Сіз қалай ойлайсыз? Имари-сан
Dialogue: 0,0:01:17.71,0:01:19.87,Default,,0,0,0,,Маған көмектес
Dialogue: 0,0:01:21.34,0:01:25.21,Default,,0,0,0,,Адал болу уақыты келсе ше? Ұстаудың қажеті жоқ
Dialogue: 0,0:01:25.21,0:01:28.96,Default,,0,0,0,,Мен ұстанған сайын, толқу соғұрлым күшейе түседі
Dialogue: 0,0:01:28.96,0:01:32.92,Default,,0,0,0,,Маған көмектес, көмектесші, Минасе
Dialogue: 0,0:01:33.41,0:01:34.72,Default,,0,0,0,,Имари
Dialogue: 0,0:01:35.49,0:01:37.01,Default,,0,0,0,,Минасе-кунтара
Dialogue: 0,0:01:37.53,0:01:39.47,Default,,0,0,0,,Сіз оны өте үлкен етіп жасадыңыз
Dialogue: 0,0:01:40.12,0:01:41.68,Default,,0,0,0,,Ұялмайсың ба?
Dialogue: 0,0:01:42.87,0:01:45.89,Default,,0,0,0,,Жоқ, мен енді шыдай алмаймын.
Dialogue: 0,0:01:47.10,0:01:48.39,Default,,0,0,0,,Имари мырза
Dialogue: 0,0:01:48.67,0:01:50.65,Default,,0,0,0,,Мен сізден тағы сұраймын.
Dialogue: 0,0:01:50.84,0:01:53.09,Default,,0,0,0,,Мастурбация жасамайтыныңызға сенімдісіз бе?
Dialogue: 0,0:01:54.46,0:01:56.82,Default,,0,0,0,,Мен мұны істеп жатырмын. Мен мастурбация жасаймын.
Dialogue: 0,0:01:56.90,0:01:58.11,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:01:58.45,0:02:00.53,Default,,0,0,0,,Аптасына неше рет?
Dialogue: 0,0:02:03.12,0:02:07.21,Default,,0,0,0,,Иә, шамамен аптасына үш рет.
Dialogue: 0,0:02:07.21,0:02:09.05,Default,,0,0,0,,Сіз мұны үш рет жасадыңыз ба?
Dialogue: 0,0:02:09.05,0:02:11.75,Default,,0,0,0,,Міне, мен жақсы емеспін деп айта аламын.
Dialogue: 0,0:02:11.98,0:02:14.05,Default,,0,0,0,,Жоқ, олай айтпа.
Dialogue: 0,0:02:14.05,0:02:16.17,Default,,0,0,0,,Тіпті Минасаның алдында
Dialogue: 0,0:02:17.45,0:02:22.43,Default,,0,0,0,,Шынайы жауап бергеніңіз үшін мен сізге Минасэ-кунның алдында көп кондиция беруге рұқсат етемін.
Dialogue: 0,0:02:31.71,0:02:33.69,Default,,0,0,0,,Минас
Dialogue: 0,0:02:55.30,0:02:56.34,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:56.34,0:02:58.01,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:02:58.01,0:03:00.01,Default,,0,0,0,,Бұл қалыпты емес.
Dialogue: 0,0:03:01.43,0:03:02.80,Default,,0,0,0,,Имари
Dialogue: 0,0:03:03.33,0:03:05.72,Default,,0,0,0,,Минас маған көмектесіңізші
Dialogue: 0,0:03:07.75,0:03:09.10,Default,,0,0,0,,Имари
Dialogue: 0,0:03:09.28,0:03:11.06,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:03:11.06,0:03:13.23,Default,,0,0,0,,Минас
Dialogue: 0,0:03:13.59,0:03:14.77,Default,,0,0,0,,Имари
Dialogue: 0,0:03:16.66,0:03:18.15,Default,,0,0,0,,Имари
Dialogue: 0,0:03:33.41,0:03:34.57,Default,,0,0,0,,Минас
Dialogue: 0,0:03:40.12,0:03:41.68,Default,,0,0,0,,*Бұл имп
Dialogue: 0,0:03:41.68,0:03:44.09,Default,,0,0,0,,Оны саған кім берді деп ойлайсың?
Dialogue: 0,0:03:47.64,0:03:50.10,Default,,0,0,0,,*Ақылсыз және ұялшақ адам
Dialogue: 0,0:03:58.30,0:03:59.57,Default,,0,0,0,,Бірақ оны қазір анаға көрсетпе.
Dialogue: 0,0:03:59.57,0:04:01.36,Default,,0,0,0,,Жоқ, келме.
Dialogue: 0,0:04:26.28,0:04:27.26,Default,,0,0,0,,Имари
Dialogue: 0,0:04:36.89,0:04:38.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:38.08,0:04:39.52,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:04:39.52,0:04:40.91,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:40.91,0:04:43.28,Default,,0,0,0,,Жақсы көрінесің, Имари-сан.
Dialogue: 0,0:04:43.68,0:04:45.78,Default,,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:04:55.96,0:04:58.11,Default,,0,0,0,,Жібер, тоқтат.
Dialogue: 0,0:04:59.56,0:05:00.71,Default,,0,0,0,,Саэки
Dialogue: 0,0:05:03.84,0:05:06.43,Default,,0,0,0,,Мен таң қалдым. Бұрынғыдан қиынырақ.
Dialogue: 0,0:05:08.72,0:05:10.35,Default,,0,0,0,,Бірақ оны қазір анаға көрсетпе.
Dialogue: 0,0:05:10.96,0:05:12.97,Default,,0,0,0,,Бөлек
Dialogue: 0,0:05:14.04,0:05:16.52,Default,,0,0,0,,Мені жіберуіңізді өтінемін
Dialogue: 0,0:05:18.47,0:05:19.47,Default,,0,0,0,,Имари-сан
Dialogue: 0,0:05:20.84,0:05:23.17,Default,,0,0,0,,Сіз тым жігерлісіз.
Dialogue: 0,0:05:23.17,0:05:25.49,Default,,0,0,0,,Мен сізге тыныштандыратын укол саламын.
Dialogue: 0,0:05:26.99,0:05:28.57,Default,,0,0,0,,Бұл жұмыс істейді.
Dialogue: 0,0:05:30.81,0:05:32.79,Default,,0,0,0,,Жоқ, қалжыңдауды доғар.
Dialogue: 0,0:05:33.02,0:05:34.66,Default,,0,0,0,,Мен қалжыңдап жатырмын деп ойлайсың ба?
Dialogue: 0,0:05:35.44,0:05:39.84,Default,,0,0,0,,Сосын Минасе-кун, Имари-санға сол қалың уколды бер.
Dialogue: 0,0:05:39.84,0:05:41.50,Default,,0,0,0,,Бұл қалай мүмкін?
Dialogue: 0,0:05:41.80,0:05:43.04,Default,,0,0,0,,Өтірік айту
Dialogue: 0,0:05:43.30,0:05:46.59,Default,,0,0,0,,Имари-санның ішіне кіргіңіз келе ме?
Dialogue: 0,0:05:50.15,0:05:52.81,Default,,0,0,0,,Бірақ кешіріңіз, бірақ алдыңғысын бере алмаймын.
Dialogue: 0,0:05:53.62,0:05:55.10,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:05:55.10,0:05:56.87,Default,,0,0,0,,Мен саған пәк есек беремін
Dialogue: 0,0:05:56.87,0:05:58.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:58.19,0:05:59.69,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:06:00.88,0:06:02.73,Default,,0,0,0,,Не істеп жатырсың?
Dialogue: 0,0:06:13.36,0:06:14.79,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:06:15.27,0:06:18.54,Default,,0,0,0,,Жоқ, бұл сіздің бөксеңізге кіре алмайды.
Dialogue: 0,0:06:18.83,0:06:20.83,Default,,0,0,0,,Оны тоқтатыңыз.
Dialogue: 0,0:06:24.15,0:06:25.96,Default,,0,0,0,,Тоқта, Саэки.
Dialogue: 0,0:06:26.12,0:06:28.16,Default,,0,0,0,,Тыныш қал, Минасэ-кун.
Dialogue: 0,0:06:28.33,0:06:30.01,Default,,0,0,0,,Мақсатымды шеше алмаймын.
Dialogue: 0,0:06:35.43,0:06:36.31,Default,,0,0,0,,Енді менің L екенім әлі ашылмағандықтан, егер Нагаре өлсе,
Dialogue: 0,0:06:36.31,0:06:37.64,Default,,0,0,0,,Ал, күте тұрыңыз.
Dialogue: 0,0:06:50.14,0:06:52.49,Default,,0,0,0,,Қараңдар, мен кірдім.
Dialogue: 0,0:06:55.49,0:06:57.95,Default,,0,0,0,,Минас
Dialogue: 0,0:06:59.48,0:07:00.83,Default,,0,0,0,,Имари
Dialogue: 0,0:07:01.19,0:07:02.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:02.29,0:07:03.71,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:07:03.71,0:07:06.59,Default,,0,0,0,,Бір орында тұрмаңдар, екеуің де қозғалыңдар.
Dialogue: 0,0:07:14.50,0:07:16.26,Default,,0,0,0,,Уф, ауырып тұр.
Dialogue: 0,0:07:16.26,0:07:18.14,Default,,0,0,0,,Минас Ауырады.
Dialogue: 0,0:07:18.73,0:07:21.06,Default,,0,0,0,,Дене өздігінен қозғалады
Dialogue: 0,0:07:34.25,0:07:36.12,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:37.46,0:07:39.12,Default,,0,0,0,,Оны толық сезіну
Dialogue: 0,0:07:39.77,0:07:42.33,Default,,0,0,0,,Өз қалауларыңызға бағыныңыз
Dialogue: 0,0:07:47.74,0:07:49.55,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:07:49.73,0:07:52.20,Default,,0,0,0,,Ләззатқа ешкім қарсы тұра алмайды
Dialogue: 0,0:07:57.80,0:07:59.47,Default,,0,0,0,,Қарашы, Минасэ-кун.
Dialogue: 0,0:07:59.47,0:08:01.85,Default,,0,0,0,,Имари-сан да сезе бастады.
Dialogue: 0,0:08:01.85,0:08:04.73,Default,,0,0,0,,Қаттырақ ұрып, мені қуант
Dialogue: 0,0:08:07.70,0:08:09.75,Default,,0,0,0,,Жоқ, Минасе, жоқ.
Dialogue: 0,0:08:18.30,0:08:20.04,Default,,0,0,0,,Имари кешіріңіз
Dialogue: 0,0:08:20.38,0:08:22.56,Default,,0,0,0,,Менің денем тоқтамайды
Dialogue: 0,0:08:28.99,0:08:31.84,Default,,0,0,0,,Бұл тоқтамайды
Dialogue: 0,0:08:36.46,0:08:38.10,Default,,0,0,0,,Ми, Минасе
Dialogue: 0,0:08:39.43,0:08:41.93,Default,,0,0,0,,Жақсы, Минасе.
Dialogue: 0,0:08:41.93,0:08:44.56,Default,,0,0,0,,Жарайды, себебі бұл Минасе
Dialogue: 0,0:08:47.23,0:08:48.77,Default,,0,0,0,,Имари
Dialogue: 0,0:08:49.30,0:08:51.82,Default,,0,0,0,,Саған жақсы болды, Минасэ-кун.
Dialogue: 0,0:08:51.82,0:08:53.82,Default,,0,0,0,,Көп беріңіз.
Dialogue: 0,0:08:54.43,0:08:57.32,Default,,0,0,0,,Имари-санның сүйкімді бөксесінің іші
Dialogue: 0,0:09:12.12,0:09:13.30,Default,,0,0,0,,Кіру
Dialogue: 0,0:09:13.30,0:09:16.26,Default,,0,0,0,,Ыстық заттар кіре береді
Dialogue: 0,0:09:26.10,0:09:27.09,Default,,0,0,0,,Имари мырза
Dialogue: 0,0:09:27.57,0:09:28.77,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:09:28.77,0:09:30.84,Default,,0,0,0,,Қыз кезінде анусыңызды ұсыну
Dialogue: 0,0:09:31.64,0:09:33.65,Default,,0,0,0,,Бұл-осындай нәрсе
Dialogue: 0,0:09:33.65,0:09:36.15,Default,,0,0,0,,Балалар, сендер адам баласының ең жаманысыңдар.
Dialogue: 0,0:09:36.28,0:09:38.74,Default,,0,0,0,,Мақтауларыңызға рахмет.
Dialogue: 0,0:09:38.74,0:09:40.33,Default,,0,0,0,,Ібіліс
Dialogue: 0,0:09:40.33,0:09:42.66,Default,,0,0,0,,Бұл ең жақсы комплимент.
Dialogue: 0,0:09:49.23,0:09:50.92,Default,,0,0,0,,Аман болыңыз, Имари-сан.
Dialogue: 0,0:09:51.40,0:09:54.63,Default,,0,0,0,,Мен сенің қыздығыңды сақтаймын.
Dialogue: 0,0:10:27.39,0:10:28.67,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:10:35.56,0:10:36.59,Default,,0,0,0,,Та-да!
Dialogue: 0,0:10:38.22,0:10:39.59,Default,,0,0,0,,Бөртпе
Dialogue: 0,0:10:40.99,0:10:42.93,Default,,0,0,0,,Маған сенің бөксең ұнайды.
Dialogue: 0,0:10:54.26,0:10:55.23,Default,,0,0,0,,Имари
Dialogue: 0,0:11:26.41,0:11:27.85,Default,,0,0,0,,Имари
Dialogue: 0,0:11:29.55,0:11:32.06,Default,,0,0,0,,О, Минасэ-кун әлі осында ма?
Dialogue: 0,0:11:32.06,0:11:33.77,Default,,0,0,0,,Қазір үйге бара аласыз.
Dialogue: 0,0:11:37.05,0:11:39.78,Default,,0,0,0,,Минасе-кун, Имари-сан.
Dialogue: 0,0:11:39.78,0:11:42.32,Default,,0,0,0,,Содан бері біз бесеу болдық.
Dialogue: 0,0:11:44.49,0:11:48.08,Default,,0,0,0,,Менің ойымша, мен мұны бөкседе жасағанды ​​жақсы көре бастадым.
Dialogue: 0,0:11:48.56,0:11:52.33,Default,,0,0,0,,Имари-санның жүзіндегі қуанышты көрініске қараңыз.
Dialogue: 0,0:11:53.42,0:11:55.96,Default,,0,0,0,,Мен оны пәк қыз емес деп ойлаймын.
Dialogue: 0,0:11:56.74,0:11:58.84,Default,,0,0,0,,Бұл сенің дәрің.
Dialogue: 0,0:11:59.49,0:12:01.17,Default,,0,0,0,,Меніңше, Реа да қарыздар туралы немесе сондай нәрселерді ойламайды.
Dialogue: 0,0:12:10.61,0:12:12.31,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:12:15.14,0:12:18.69,Default,,0,0,0,,Ішім тоқ
Dialogue: 0,0:12:18.69,0:12:20.32,Default,,0,0,0,,Көп
Dialogue: 0,0:12:25.31,0:12:26.53,Default,,0,0,0,,Имари
Dialogue: 0,0:12:37.74,0:12:40.42,Default,,0,0,0,,Минасэ-кун, сен тағы да толқыдың.
Dialogue: 0,0:12:43.62,0:12:46.14,Default,,0,0,0,,Неге сонша аяныштысың?
Dialogue: 0,0:13:02.13,0:13:03.01,Default,,0,0,0,,Имари
Dialogue: 0,0:13:08.19,0:13:11.29,Default,,0,0,0,,Имаридің тесігі дірілдеп тұр
Dialogue: 0,0:13:11.29,0:13:12.87,Default,,0,0,0,,Көбірек алғыңыз келе ме?
Dialogue: 0,0:13:13.98,0:13:15.37,Default,,0,0,0,,Мен көбірек алғым келеді
Dialogue: 0,0:13:15.65,0:13:18.29,Default,,0,0,0,,Бөкседе көбірек
Dialogue: 0,0:13:19.43,0:13:22.55,Default,,0,0,0,,Жарайды, мен көбірек істеймін.
Dialogue: 0,0:13:34.07,0:13:35.69,Default,,0,0,0,,Мен толқып тұрмын
Dialogue: 0,0:13:35.69,0:13:38.77,Default,,0,0,0,,Имаридің бөксесі керемет
Dialogue: 0,0:13:38.77,0:13:41.07,Default,,0,0,0,,О, жақсы жақсы
Dialogue: 0,0:13:41.15,0:13:45.03,Default,,0,0,0,,Менің бөксе тесігім менің тесігімді сезеді
Dialogue: 0,0:13:51.67,0:13:52.74,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:55.07,0:13:57.42,Default,,0,0,0,,Неліктен бұл жақсы?
Dialogue: 0,0:13:59.71,0:14:00.69,Default,,0,0,0,,Имари
Dialogue: 0,0:14:02.37,0:14:06.39,Default,,0,0,0,,Минасе-кун, Имари-санды әкелгенің үшін рахмет.
Dialogue: 0,0:14:11.47,0:14:13.14,Default,,0,0,0,,Денсаулықтың өзі
Dialogue: 0,0:14:14.42,0:14:16.56,Default,,0,0,0,,Бұл ең жақсы дене
Dialogue: 0,0:14:17.48,0:14:19.98,Default,,0,0,0,,Тоқтатпа, көбірек қағып ал
Dialogue: 0,0:14:19.98,0:14:22.15,Default,,0,0,0,,Қазір тоқтатсам, жынды боламын.
Dialogue: 0,0:14:23.17,0:14:24.48,Default,,0,0,0,,Қолыңнан келмейді, балам.
Dialogue: 0,0:14:37.28,0:14:39.59,Default,,0,0,0,,жүріңіз
Dialogue: 0,0:14:39.88,0:14:41.71,Default,,0,0,0,,Жақсы, Имари-сан.
Dialogue: 0,0:14:41.71,0:14:43.38,Default,,0,0,0,,Барлығына шығыңыз
Dialogue: 0,0:14:43.57,0:14:46.76,Default,,0,0,0,,Минасе-кунның алдында пәк болып қала беремін.
Dialogue: 0,0:15:00.25,0:15:02.77,Default,,0,0,0,,Енді Минасэ-кун қарап алсын.
Dialogue: 0,0:15:02.77,0:15:05.44,Default,,0,0,0,,Сіз өміріңізде бірінші рет қайда барасыз
Dialogue: 0,0:15:05.44,0:15:07.11,Default,,0,0,0,,Минас
Dialogue: 0,0:15:08.18,0:15:09.78,Default,,0,0,0,,Минасэ қарап тұр
Dialogue: 0,0:15:10.60,0:15:11.74,Default,,0,0,0,,Имари
Dialogue: 0,0:15:12.77,0:15:13.66,Default,,0,0,0,,Минас
Dialogue: 0,0:15:14.28,0:15:15.87,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:15:16.19,0:15:17.87,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:17.87,0:15:19.25,Default,,0,0,0,,Имари
Dialogue: 0,0:15:22.10,0:15:25.17,Default,,0,0,0,,Минасэ-кун, менімен бірге жүрші.
Dialogue: 0,0:15:31.50,0:15:33.87,Default,,0,0,0,,Мен саған беремін, Имари-сан.
Dialogue: 0,0:15:45.39,0:15:47.26,Default,,0,0,0,,жүр
Dialogue: 0,0:15:47.26,0:15:49.57,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:02.21,0:16:03.72,Default,,0,0,0,,Имари
Dialogue: 0,0:16:03.72,0:16:05.25,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:16:05.25,0:16:06.63,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін
Dialogue: 0,0:16:08.91,0:16:11.42,Default,,0,0,0,,Бәрін өзіңіз лас қалдырыңыз
Dialogue: 0,0:16:11.42,0:16:14.01,Default,,0,0,0,,Оны Имари-санға жиі айтасың.
Dialogue: 0,0:16:16.80,0:16:19.93,Default,,0,0,0,,Мен ырымға дейін күш-қуатымды жұмсағым келмейді.
Dialogue: 0,0:16:19.93,0:16:22.35,Default,,0,0,0,,Мен саған көмектескім келді, бірақ
Dialogue: 0,0:16:23.97,0:16:26.24,Default,,0,0,0,,Менің жолыма түскіңіз келсе
Dialogue: 0,0:16:26.59,0:16:27.98,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:16:31.73,0:16:33.99,Default,,0,0,0,,Қайтып барып Такагиге де айтыңыз.
Dialogue: 0,0:16:34.35,0:16:37.95,Default,,0,0,0,,*Менің не істеп жатқанымды үнсіз бақылап тұрмын (?)
Dialogue: 0,0:16:38.83,0:16:43.83,Default,,0,0,0,,Ертең қызықсыз бірдеңе жасасаң, келесі жолы аямаймын.
Dialogue: 0,0:16:54.24,0:16:57.01,Default,,0,0,0,,Аянышты адам, ол ең нашар
Dialogue: 0,0:18:08.02,0:18:10.07,Default,,0,0,0,,Мұғалім, ояу болдыңыз ба?
Dialogue: 0,0:18:10.82,0:18:12.84,Default,,0,0,0,,Минасэ-кунның өңі бозарған.
Dialogue: 0,0:18:17.03,0:18:18.13,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:20.66,0:18:23.64,Default,,0,0,0,,Минасе-кун, маған күндіз көмектескеніңіз үшін рахмет.
Dialogue: 0,0:18:24.33,0:18:25.22,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:26.00,0:18:28.02,Default,,0,0,0,,Мұғалімге бұлай не болды?
Dialogue: 0,0:18:28.02,0:18:29.27,Default,,0,0,0,,Менің
Dialogue: 0,0:18:29.96,0:18:32.48,Default,,0,0,0,,Сіз Китамимен және басқалармен байланысты үздіңіз, солай ма?
Dialogue: 0,0:18:34.59,0:18:35.69,Default,,0,0,0,,Иә
Dialogue: 0,0:18:36.39,0:18:38.03,Default,,0,0,0,,Осы сиқырлы кітапта
Dialogue: 0,0:18:38.03,0:18:39.74,Default,,0,0,0,,Мұның бәрі мағынасы бар.
Dialogue: 0,0:18:40.18,0:18:41.74,Default,,0,0,0,,Фалко, мен саған бір өтінішпен жүгінер едім…
Dialogue: 0,0:18:41.74,0:18:43.37,Default,,0,0,0,,Менде мұндай бар екенін ешқашан білмедім.
Dialogue: 0,0:18:47.19,0:18:49.12,Default,,0,0,0,,Мен оны қалай алғаныңызды білмеймін.
Dialogue: 0,0:18:49.86,0:18:52.29,Default,,0,0,0,,Бұл біз қол тигізбеуіміз керек күш.
Dialogue: 0,0:18:55.32,0:18:58.51,Default,,0,0,0,,Мен бір рет тырыстым, бірақ соңында қайтара алмадым.
Dialogue: 0,0:19:00.58,0:19:02.01,Default,,0,0,0,,Мен бірден байқадым
Dialogue: 0,0:19:03.57,0:19:04.85,Default,,0,0,0,,Оны қамауға алу үшін дереу келіңіз.
Dialogue: 0,0:19:19.03,0:19:22.41,Default,,0,0,0,,Бірақ мен кері бұрыла алмадым.
Dialogue: 0,0:19:34.82,0:19:36.46,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:19:40.94,0:19:42.28,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:19:50.54,0:19:51.56,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:19:52.59,0:19:55.11,Default,,0,0,0,,Сіз соңғы минутта ояндыңыз.
Dialogue: 0,0:19:55.96,0:19:59.86,Default,,0,0,0,,Осыдан 12 жыл бұрын мен де не істеп жүргенімізден қорқатынмын.
Dialogue: 0,0:20:00.39,0:20:02.07,Default,,0,0,0,,Мен ол шеңберден шықтым.
Dialogue: 0,0:20:04.87,0:20:06.87,Default,,0,0,0,,Дәл осыдан кейін болды.
Dialogue: 0,0:20:14.19,0:20:16.13,Default,,0,0,0,,Рейка Китами
Dialogue: 0,0:20:18.67,0:20:22.96,Default,,0,0,0,,Сол түні ырымда құрбандық шалған қыз.
Dialogue: 0,0:20:28.51,0:20:32.06,Default,,0,0,0,,Өлер алдында ол шайтанмен мәміле жасады.
Dialogue: 0,0:20:42.08,0:20:43.36,Default,,0,0,0,,Шарт болса
Dialogue: 0,0:20:43.93,0:20:46.78,Default,,0,0,0,,Шайтан берген уақытша өмір
Dialogue: 0,0:20:47.31,0:20:49.29,Default,,0,0,0,,Енді аяқталуға жақын
Dialogue: 0,0:20:51.54,0:20:55.12,Default,,0,0,0,,Китами Имари-санның денесін басып алып, шайтанды алдауды жоспарлайды.
Dialogue: 0,0:20:56.23,0:20:58.17,Default,,0,0,0,,Идиот! Мұндай нәрсе
Dialogue: 0,0:20:58.61,0:21:00.46,Default,,0,0,0,,Ол біледі
Dialogue: 0,0:21:05.09,0:21:07.76,Default,,0,0,0,,Маған Имари-санның жазықсыз денесі керек.
Dialogue: 0,0:21:08.97,0:21:12.02,Default,,0,0,0,,Ертең мен қызықсыз еліктеушілік жасасам,
Dialogue: 0,0:21:12.02,0:21:13.98,Default,,0,0,0,,Бұл жолы аяушылық жоқ
Dialogue: 0,0:21:15.25,0:21:16.65,Default,,0,0,0,,Ертең
Dialogue: 0,0:21:16.96,0:21:18.44,Default,,0,0,0,,Мен мұны айттым.
Dialogue: 0,0:21:18.44,0:21:20.36,Default,,0,0,0,,Ертең менің жолыма бөгет болсаң, мен сені өлтіремін.
Dialogue: 0,0:21:22.64,0:21:23.62,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:21:24.10,0:21:26.96,Default,,0,0,0,,Китами 12 жыл бұрынғы Вальпургис түніндегідей.
Dialogue: 0,0:21:26.96,0:21:28.94,Default,,0,0,0,,Мен рәсім жасауды жоспарлап отырмын.
Dialogue: 0,0:21:29.82,0:21:30.95,Default,,0,0,0,,Такаджо мырза
Dialogue: 0,0:21:32.26,0:21:36.04,Default,,0,0,0,,Минасе-кун, мүмкін сіз әлі де ең нашар жағдайдан аулақ бола аласыз.
Dialogue: 0,0:21:37.10,0:21:37.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:38.51,0:21:40.71,Default,,0,0,0,,Дегенмен, бұл уақытты қажет етеді
Dialogue: 0,0:21:43.15,0:21:44.08,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:21:44.71,0:21:46.76,Default,,0,0,0,,Не болды? Такаги мырза
Dialogue: 0,0:21:48.08,0:21:49.35,Default,,0,0,0,,Оны кесу мүмкін емес
Dialogue: 0,0:21:49.35,0:21:50.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:50.37,0:21:53.47,Default,,0,0,0,,Есірткі заттарды көп мөлшерде қабылдауға мәжбүрлеу
Dialogue: 0,0:21:54.17,0:21:56.69,Default,,0,0,0,,Мен есірткіге үйреніп қалдым деп ойладым, бірақ
Dialogue: 0,0:21:59.38,0:22:01.77,Default,,0,0,0,,Иә, тіпті ыстық душ.
Dialogue: 0,0:22:01.77,0:22:02.62,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:22:02.62,0:22:03.35,Default,,0,0,0,,Иә
Dialogue: 0,0:22:06.67,0:22:07.85,Default,,0,0,0,,Мені құшақтап ал
Dialogue: 0,0:22:07.85,0:22:09.24,Default,,0,0,0,,Се, мұғалім
Dialogue: 0,0:22:10.07,0:22:11.32,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:22:11.32,0:22:14.29,Default,,0,0,0,,Менің денем ауырып жатыр, мен оны енді көтере алмаймын деп ойлаймын.
Dialogue: 0,0:22:15.23,0:22:16.08,Default,,0,0,0,,Бірақ
Dialogue: 0,0:22:16.65,0:22:19.21,Default,,0,0,0,,Мен мұндай нәрсені сұрамауым керек екенін білемін.
Dialogue: 0,0:22:20.07,0:22:21.34,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:22:22.36,0:22:23.67,Default,,0,0,0,,Такаджо мырза
Dialogue: 0,0:22:28.12,0:22:29.18,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:22:29.18,0:22:31.72,Default,,0,0,0,,Маған көмектесуіңізді сұраймын.
Dialogue: 0,0:22:35.50,0:22:38.73,Default,,0,0,0,,Менің мастурбация жасағанымды көргеніңді қаламаймын.
Dialogue: 0,0:23:04.63,0:23:06.84,Default,,0,0,0,,Минасэ-кун жақсы.
Dialogue: 0,0:23:08.66,0:23:11.47,Default,,0,0,0,,Мырза, мен оны бұрын байқамаппын.
Dialogue: 0,0:23:11.47,0:23:14.35,Default,,0,0,0,,Мұғалімнің тұрған жерінен үлкендердің иісі аңқып тұр.
Dialogue: 0,0:23:16.18,0:23:18.81,Default,,0,0,0,,Барған сайын иіскеу
Dialogue: 0,0:23:18.81,0:23:21.35,Default,,0,0,0,,Мені көбірек айыпта, Минасэ-кун.
Dialogue: 0,0:23:23.46,0:23:25.36,Default,,0,0,0,,Жақсы
Dialogue: 0,0:23:26.15,0:23:28.11,Default,,0,0,0,,Маған Минасэ-кунды беріңіз
Dialogue: 0,0:23:28.11,0:23:30.15,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:23:30.84,0:23:32.54,Default,,0,0,0,,Мұғалім, мен сені кіргіземін.
Dialogue: 0,0:23:33.67,0:23:34.95,Default,,0,0,0,,Оны тез салыңыз
Dialogue: 0,0:23:34.95,0:23:37.54,Default,,0,0,0,,Тезірек араластыр, Минасэ-кун.
Dialogue: 0,0:23:42.24,0:23:43.73,Default,,0,0,0,,Кіру
Dialogue: 0,0:23:43.73,0:23:46.55,Default,,0,0,0,,Минасэ-кун кіріп келеді.
Dialogue: 0,0:23:55.44,0:23:57.51,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:23:57.51,0:23:59.10,Default,,0,0,0,,Ішке терең жету
Dialogue: 0,0:23:59.10,0:24:00.56,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:24:00.56,0:24:01.73,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:24:04.63,0:24:06.65,Default,,0,0,0,,Жоқ, егер сіз соншалықты көп жасасаңыз.
Dialogue: 0,0:24:06.65,0:24:07.90,Default,,0,0,0,,Бірден
Dialogue: 0,0:24:08.31,0:24:09.40,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:24:16.28,0:24:17.49,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:24:17.86,0:24:19.83,Default,,0,0,0,,Мен өзімді керемет сезінемін
Dialogue: 0,0:24:20.93,0:24:22.67,Default,,0,0,0,,Мен тағы да келемін деп ойлаймын
Dialogue: 0,0:24:25.80,0:24:27.25,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:24:35.98,0:24:38.33,Default,,0,0,0,,Міне, Минасэ-кун тағы да барамыз
Dialogue: 0,0:24:38.33,0:24:40.14,Default,,0,0,0,,Мен де
Dialogue: 0,0:24:40.14,0:24:41.85,Default,,0,0,0,,Кеттік
Dialogue: 0,0:24:42.64,0:24:45.10,Default,,0,0,0,,Менің де уақытым келді
Dialogue: 0,0:24:47.27,0:24:49.86,Default,,0,0,0,,Бірге барайық
Dialogue: 0,0:24:50.38,0:24:52.74,Default,,0,0,0,,Оны өзіңіз қалаған жерден алыңыз
Dialogue: 0,0:24:57.14,0:24:58.37,Default,,0,0,0,,Шығу
Dialogue: 0,0:25:19.30,0:25:20.85,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:25:20.96,0:25:22.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:25:26.35,0:25:29.06,Default,,0,0,0,,Маған аздап ұйықтауға рұқсат етіңіз
Dialogue: 0,0:26:07.97,0:26:10.40,Default,,0,0,0,,Салтанатты рәсім бүгін кешке өтеді.
Dialogue: 0,0:26:12.88,0:26:15.65,Default,,0,0,0,,Қараңғылықтың күші күшейеді
Dialogue: 0,0:26:15.65,0:26:17.82,Default,,0,0,0,,Вальпурги түні
Dialogue: 0,0:26:19.32,0:26:25.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
