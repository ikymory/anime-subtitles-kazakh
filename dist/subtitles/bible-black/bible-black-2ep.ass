Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.46,0:00:14.13,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:00:15.30,0:00:17.20,Default,,0,0,0,,Минасэ-кунның құпиясы
Dialogue: 0,0:00:20.89,0:00:23.14,Default,,0,0,0,,Ешқандай құпия жоқ.
Dialogue: 0,0:00:23.30,0:00:24.27,Default,,0,0,0,,Өтірік
Dialogue: 0,0:00:28.92,0:00:32.61,Default,,0,0,0,,Сіз қолданып жатқан нәрсе - бұл махаббат қарғысы.
Dialogue: 0,0:00:33.51,0:00:37.37,Default,,0,0,0,,Адамдардың жүрегін басқарып, арсыздық жасау өнері
Dialogue: 0,0:00:38.74,0:00:42.16,Default,,0,0,0,,Ешқандай білімсіз мұндай нәрсені істеу мүмкін емес.
Dialogue: 0,0:00:55.94,0:00:59.44,Default,,0,0,0,,Кешіріңіз, бірақ мені ондай нәрсе қызықтырмайды.
Dialogue: 0,0:01:04.33,0:01:07.56,Default,,0,0,0,,Бірақ сіз сиқырды қолдандыңыз
Dialogue: 0,0:01:08.96,0:01:12.07,Default,,0,0,0,,Бұл жай ғана
Dialogue: 0,0:01:15.98,0:01:19.16,Default,,0,0,0,,Маған сырыңызды айтыңызшы
Dialogue: 0,0:01:53.54,0:01:55.82,Default,,0,0,0,,Менің кітабым бар.
Dialogue: 0,0:02:00.00,0:02:01.87,Default,,0,0,0,,Сиқырлы кітап
Dialogue: 0,0:02:13.87,0:02:15.42,Default,,0,0,0,,Бөксе де
Dialogue: 0,0:03:06.77,0:03:09.56,Default,,0,0,0,,Бұл дөрекі, қызға қол көтеру.
Dialogue: 0,0:03:09.80,0:03:11.71,Default,,0,0,0,,Өйткені Саэки табанды.
Dialogue: 0,0:03:11.71,0:03:14.40,Default,,0,0,0,,Мен саған көрсетемін дедім, бірақ қарызға беремін деп айтқан жоқпын.
Dialogue: 0,0:03:15.13,0:03:16.32,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:03:16.43,0:03:17.36,Default,,0,0,0,,Не?
Dialogue: 0,0:03:18.22,0:03:21.70,Default,,0,0,0,,Сіз қазірдің өзінде шайтанның сиқырына түсе бастадыңыз.
Dialogue: 0,0:03:23.12,0:03:24.57,Default,,0,0,0,,Мен жаман ештеңе айтпаймын.
Dialogue: 0,0:03:25.27,0:03:26.62,Default,,0,0,0,,Сақ болғаныңыз жөн.
Dialogue: 0,0:03:38.24,0:03:40.38,Default,,0,0,0,,Сіздің әпкеңіз тағы түнде ме?
Dialogue: 0,0:03:57.84,0:03:59.15,Default,,0,0,0,,Иә, Имари.
Dialogue: 0,0:04:00.34,0:04:02.20,Default,,0,0,0,,Ах, Юкико-сан
Dialogue: 0,0:04:02.20,0:04:03.78,Default,,0,0,0,,Куруми-чан, кешіріңіз.
Dialogue: 0,0:04:03.78,0:04:05.91,Default,,0,0,0,,Оған тамақ дайындаңыз
Dialogue: 0,0:04:05.91,0:04:07.70,Default,,0,0,0,,Келесі жолы оның орнын толтырамын.
Dialogue: 0,0:04:16.44,0:04:19.67,Default,,0,0,0,,Сіз қазірдің өзінде шайтанның сиқырына түсе бастадыңыз.
Dialogue: 0,0:04:27.95,0:04:29.77,Default,,0,0,0,,Қайырлы кеш, Минасэ-кун
Dialogue: 0,0:04:30.71,0:04:31.81,Default,,0,0,0,,Шираки!
Dialogue: 0,0:04:33.13,0:04:35.06,Default,,0,0,0,,Не болды? Түннің бір уағында осылай
Dialogue: 0,0:04:38.47,0:04:40.11,Default,,0,0,0,,Мен сені көргім келеді
Dialogue: 0,0:04:40.11,0:04:41.11,Default,,0,0,0,,Бұл жерде
Dialogue: 0,0:04:51.56,0:04:54.06,Default,,0,0,0,,Соңында менің ойыма тек карри ғана келеді.
Dialogue: 0,0:04:57.13,0:04:59.46,Default,,0,0,0,,Бірақ Минасэ карриді жақсы көреді.
Dialogue: 0,0:05:13.06,0:05:14.56,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:05:14.67,0:05:15.58,Default,,0,0,0,,Бөртпе
Dialogue: 0,0:05:16.00,0:05:18.90,Default,,0,0,0,,Менің бөксем Минасэ-кундікіне толы.
Dialogue: 0,0:05:19.64,0:05:20.90,Default,,0,0,0,,Ақ ағаш
Dialogue: 0,0:05:28.22,0:05:30.20,Default,,0,0,0,,Ғажайып таңғажайып
Dialogue: 0,0:05:31.08,0:05:32.16,Default,,0,0,0,,Ақ ағаш
Dialogue: 0,0:05:32.16,0:05:34.70,Default,,0,0,0,,Ширакидің бөксесі ең жақсысы
Dialogue: 0,0:05:35.96,0:05:37.26,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:05:42.16,0:05:43.26,Default,,0,0,0,,Минас
Dialogue: 0,0:05:52.92,0:05:55.52,Default,,0,0,0,,Минасе-кунның қолында болу
Dialogue: 0,0:05:55.96,0:05:58.60,Default,,0,0,0,,Мені Минасэ-кун жақсы көреді.
Dialogue: 0,0:06:05.40,0:06:07.82,Default,,0,0,0,,Минасе-кун, тоқтама.
Dialogue: 0,0:06:08.04,0:06:09.27,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:06:17.08,0:06:20.00,Default,,0,0,0,,Өйткені мен Минасе-кунға тиесілімін.
Dialogue: 0,0:06:20.00,0:06:23.42,Default,,0,0,0,,Сіз мені қалағаныңызша, қалаған уақытта ұстай аласыз.
Dialogue: 0,0:06:23.61,0:06:25.88,Default,,0,0,0,,А, мен мұны істеуге рұқсат етіңіз.
Dialogue: 0,0:06:31.08,0:06:33.32,Default,,0,0,0,,Ішке терең жету
Dialogue: 0,0:06:34.08,0:06:35.60,Default,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:06:35.96,0:06:37.06,Default,,0,0,0,,Шираки
Dialogue: 0,0:06:37.06,0:06:38.52,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:06:39.03,0:06:40.06,Default,,0,0,0,,Бұл орын алатын сияқты
Dialogue: 0,0:06:40.57,0:06:41.90,Default,,0,0,0,,Мен де
Dialogue: 0,0:06:44.89,0:06:46.32,Default,,0,0,0,,Бетіңізге шашыратыңыз
Dialogue: 0,0:06:47.18,0:06:49.95,Default,,0,0,0,,Минасе-кунның дәмін көрейін
Dialogue: 0,0:06:50.06,0:06:51.32,Default,,0,0,0,,Көп нәрсені беріңіз
Dialogue: 0,0:06:52.39,0:06:54.33,Default,,0,0,0,,Минас: ұйықтап қалдың ба?
Dialogue: 0,0:07:00.12,0:07:01.29,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:07:03.74,0:07:05.38,Default,,0,0,0,,Минас кешкі ас
Dialogue: 0,0:07:39.07,0:07:40.79,Default,,0,0,0,,Мұғалім, тоқтатыңыз.
Dialogue: 0,0:07:41.11,0:07:42.83,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:07:42.83,0:07:45.17,Default,,0,0,0,,*Жүзу үйірмесінің үміті күткендей.
Dialogue: 0,0:07:45.21,0:07:46.96,Default,,0,0,0,,Тығыздығы әртүрлі.
Dialogue: 0,0:07:48.32,0:07:49.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:50.31,0:07:54.14,Default,,0,0,0,,Бірақ қыздығыңды сақтау керек.
Dialogue: 0,0:08:00.31,0:08:01.69,Default,,0,0,0,,О, сонда.
Dialogue: 0,0:08:03.05,0:08:05.02,Default,,0,0,0,,Артқы жағы ше?
Dialogue: 0,0:08:08.55,0:08:11.36,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:13.44,0:08:15.95,Default,,0,0,0,,Жарайды, сенің құлаң.
Dialogue: 0,0:08:16.96,0:08:19.49,Default,,0,0,0,,Қауіпсіздікті түсірсем, тым-тырыс болып кетемін
Dialogue: 0,0:08:26.99,0:08:28.59,Default,,0,0,0,,Сәлем Минасэ-кун
Dialogue: 0,0:08:29.36,0:08:31.13,Default,,0,0,0,,Сіз Имари-санмен кездесесіз бе?
Dialogue: 0,0:08:31.76,0:08:34.43,Default,,0,0,0,,Ол жай ғана бала күнгі дос.
Dialogue: 0,0:08:34.43,0:08:35.57,Default,,0,0,0,,Ах.
Dialogue: 0,0:08:35.57,0:08:40.18,Default,,0,0,0,,Өйткені сен кеше біздің сүйіспеншілік танытып жатқанымызды көріп, жылап шығып кеттің.
Dialogue: 0,0:08:40.67,0:08:42.03,Default,,0,0,0,,Ақ ағаш
Dialogue: 0,0:08:42.10,0:08:43.66,Default,,0,0,0,,Сіз бұл біртүрлі деп ойламайсыз ба?
Dialogue: 0,0:08:45.32,0:08:48.31,Default,,0,0,0,,Сезіміңіздің жалған екенін білмейсіз бе?
Dialogue: 0,0:08:49.42,0:08:50.69,Default,,0,0,0,,Жалған?
Dialogue: 0,0:08:53.13,0:08:54.99,Default,,0,0,0,,Бұл туралы сабырмен ойланыңыз.
Dialogue: 0,0:08:54.99,0:08:57.37,Default,,0,0,0,,Мені шынымен ұнатасың ба?
Dialogue: 0,0:08:57.90,0:08:59.06,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:08:59.47,0:09:01.38,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:09:01.87,0:09:03.96,Default,,0,0,0,,Шираки, оян.
Dialogue: 0,0:09:04.79,0:09:07.50,Default,,0,0,0,,Өйткені, саған Имари-сан ұнайды.
Dialogue: 0,0:09:07.50,0:09:08.79,Default,,0,0,0,,Олай емес!
Dialogue: 0,0:09:08.79,0:09:10.23,Default,,0,0,0,,Маған назар аударыңызшы, Шираки.
Dialogue: 0,0:09:10.23,0:09:12.01,Default,,0,0,0,,Сенің сезімің менікі
Dialogue: 0,0:09:12.01,0:09:13.05,Default,,0,0,0,,Ой...
Dialogue: 0,0:09:13.05,0:09:15.72,Default,,0,0,0,,Менің сезімдерім жалған
Dialogue: 0,0:09:19.81,0:09:20.97,Default,,0,0,0,,Шираки!
Dialogue: 0,0:09:28.43,0:09:29.81,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:09:29.81,0:09:31.27,Default,,0,0,0,,Бұл суицид.
Dialogue: 0,0:09:31.31,0:09:33.32,Default,,0,0,0,,Кім? студенттер кеңесінің төрағасы
Dialogue: 0,0:09:39.20,0:09:40.43,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:09:40.43,0:09:42.12,Default,,0,0,0,,Тек ессіз
Dialogue: 0,0:09:42.48,0:09:44.37,Default,,0,0,0,,Тіпті сызат та жоқ
Dialogue: 0,0:09:44.98,0:09:47.96,Default,,0,0,0,,Тіпті төтенше жағдай қызметкерлері де таң қалды.
Dialogue: 0,0:09:48.71,0:09:50.96,Default,,0,0,0,,Сен маған сиқырыңмен көмектестің, солай ма?
Dialogue: 0,0:09:53.78,0:09:56.09,Default,,0,0,0,,Өйткені сенің сиқырың әйгілі
Dialogue: 0,0:09:57.37,0:09:59.55,Default,,0,0,0,,Мен бұл сөзсіз солай деп ойладым.
Dialogue: 0,0:10:12.76,0:10:13.86,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:10:15.76,0:10:17.82,Default,,0,0,0,,Соншалықты қорқынышты көрінбе.
Dialogue: 0,0:10:17.93,0:10:20.34,Default,,0,0,0,,Мен сенен енді маған орфографиялық кітапты беруіңді сұрамаймын.
Dialogue: 0,0:10:23.16,0:10:24.39,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:10:24.93,0:10:25.91,Default,,0,0,0,,Сұранысыңыз бар ма?
Dialogue: 0,0:10:27.17,0:10:28.12,Default,,0,0,0,,Не?
Dialogue: 0,0:10:28.41,0:10:29.87,Default,,0,0,0,,Іс жүзінде I
Dialogue: 0,0:10:29.87,0:10:33.29,Default,,0,0,0,,Мен басқа мектептің балаларымен сиқырлы шеңбер құрып жатырмын.
Dialogue: 0,0:10:34.25,0:10:36.63,Default,,0,0,0,,Дәл осыдан 12 жыл бұрынғы қыздар сияқты.
Dialogue: 0,0:10:37.89,0:10:39.51,Default,,0,0,0,,Бұл дәл хоум-ран болған жоқ қой, иә~!?
Dialogue: 0,0:10:40.34,0:10:42.18,Default,,0,0,0,,Біз де бүгін кешке жиналамыз.
Dialogue: 0,0:10:42.18,0:10:43.56,Default,,0,0,0,,Сіз бізге қосыласыз ба?
Dialogue: 0,0:10:45.19,0:10:47.39,Default,,0,0,0,,Мен мүшелерге Минасэ-кун туралы айтқанымда
Dialogue: 0,0:10:47.39,0:10:49.14,Default,,0,0,0,,Мені әкелу тым қатты
Dialogue: 0,0:10:49.98,0:10:51.06,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:10:51.19,0:10:53.27,Default,,0,0,0,,Менің енді сиқырға қатысым жоқ.
Dialogue: 0,0:11:00.66,0:11:02.03,Default,,0,0,0,,Үйірме жұмыстары туралы не айтасыз?
Dialogue: 0,0:11:02.03,0:11:03.41,Default,,0,0,0,,Сіз де бүгін әлсіреп жатырсыз ба?
Dialogue: 0,0:11:03.52,0:11:05.62,Default,,0,0,0,,Үлгі мектепте жоқ.
Dialogue: 0,0:11:06.98,0:11:09.83,Default,,0,0,0,,Китами мырзадан сақ болыңыз
Dialogue: 0,0:11:48.35,0:11:51.79,Default,,0,0,0,,Бұл қыздар шайтанды шақырған жер.
Dialogue: 0,0:11:53.87,0:11:55.08,Default,,0,0,0,,Китами мырза!
Dialogue: 0,0:11:56.10,0:11:59.88,Default,,0,0,0,,Минасэ-кун, сен бұл бөлменің кілтін қайдан алдың?
Dialogue: 0,0:12:00.43,0:12:01.67,Default,,0,0,0,,Осымен.
Dialogue: 0,0:12:02.14,0:12:06.01,Default,,0,0,0,,Үйірме жұмыстарынан кейін өнер бөлмесінің кілтін қайтаруға кездейсоқ бардым.
Dialogue: 0,0:12:06.86,0:12:07.76,Default,,0,0,0,,Иә
Dialogue: 0,0:12:07.76,0:12:10.14,Default,,0,0,0,,Қызметкерлер бөлмесінде қайталанатын кілт болды.
Dialogue: 0,0:12:14.65,0:12:15.94,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:12:16.89,0:12:19.44,Default,,0,0,0,,12 жыл бұрын Вальпурги түні
Dialogue: 0,0:12:20.22,0:12:23.74,Default,,0,0,0,,Мұнда болған оқиғаның барлығын білетін жалғыз адам
Dialogue: 0,0:12:24.61,0:12:28.53,Default,,0,0,0,,Бірақ рәсімге қатысқандардың бәрі өлді, солай ма?
Dialogue: 0,0:12:28.53,0:12:29.87,Default,,0,0,0,,Иә, мен өлдім.
Dialogue: 0,0:12:30.44,0:12:33.00,Default,,0,0,0,,Үйірменің барлық мүшелері
Dialogue: 0,0:12:33.00,0:12:34.25,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:12:35.07,0:12:37.09,Default,,0,0,0,,Мен елес сияқтымын ба?
Dialogue: 0,0:12:39.59,0:12:43.30,Default,,0,0,0,,Мен сол кезде және осы жерде шайтанмен келісім жасадым.
Dialogue: 0,0:12:45.22,0:12:47.64,Default,,0,0,0,,Ол кітап есімде.
Dialogue: 0,0:12:49.84,0:12:53.06,Default,,0,0,0,,*Шайтанның белгісі бар тыйым салынған жеміс (? қасиетті рәсім?)
Dialogue: 0,0:12:53.93,0:12:57.61,Default,,0,0,0,,Оның иесі Құдайдың құдіретімен бірдей күшке ие болады.
Dialogue: 0,0:12:58.30,0:13:00.61,Default,,0,0,0,,Сіз бұл кітапты іздедіңіз бе?
Dialogue: 0,0:13:00.88,0:13:01.82,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:03.53,0:13:06.03,Default,,0,0,0,,Қаласаң, беремін.
Dialogue: 0,0:13:09.02,0:13:11.66,Default,,0,0,0,,Мен сені шақыруға келдім
Dialogue: 0,0:13:11.91,0:13:13.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:14.09,0:13:16.87,Default,,0,0,0,,Құдайдан да асып түсетін одан әрі құдірет
Dialogue: 0,0:13:16.87,0:13:19.79,Default,,0,0,0,,Қаласаңыз, алуға болады.
Dialogue: 0,0:13:20.57,0:13:21.97,Default,,0,0,0,,Дәл мен сияқты
Dialogue: 0,0:13:23.76,0:13:25.38,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:25.38,0:13:27.93,Default,,0,0,0,,Сіз қазір аздап қорқып тұрсыз.
Dialogue: 0,0:13:30.54,0:13:32.68,Default,,0,0,0,,Бірақ сіз байқаған боларсыз.
Dialogue: 0,0:13:32.68,0:13:37.15,Default,,0,0,0,,Кітапқа мөр бассам да, қайта ашылатын шығар.
Dialogue: 0,0:13:38.56,0:13:41.69,Default,,0,0,0,,Сіз бас тарта алмайсыз
Dialogue: 0,0:13:50.48,0:13:56.12,Default,,0,0,0,,Адам сиқырмен айналысқаннан кейін, ол азғырудан ешқашан құтыла алмайды.
Dialogue: 0,0:14:01.84,0:14:04.59,Default,,0,0,0,,Менің артымнан ерсең болғаны
Dialogue: 0,0:14:05.45,0:14:08.26,Default,,0,0,0,,Мен саған қараңғылықтың ғажайыптарын көрсетемін.
Dialogue: 0,0:14:23.25,0:14:25.44,Default,,0,0,0,,Жарайды, жүр.
Dialogue: 0,0:14:38.65,0:14:41.29,Default,,0,0,0,,Енді нақты нәрсе басталады.
Dialogue: 0,0:14:41.47,0:14:44.00,Default,,0,0,0,,Маған біраз демалуға рұқсат етіңіз.
Dialogue: 0,0:14:44.72,0:14:47.32,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:14:48.05,0:14:51.26,Default,,0,0,0,,*Амор, Венес, Астарос
Dialogue: 0,0:15:04.35,0:15:05.57,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:15:06.69,0:15:11.45,Default,,0,0,0,,Ақылыңызға сенімді болыңыз және ең жоғарғы ләззатты еш ойланбастан сезініңіз.
Dialogue: 0,0:15:21.16,0:15:22.80,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:15:23.80,0:15:25.59,Default,,0,0,0,,Оны әлі шығармаңыз.
Dialogue: 0,0:15:25.59,0:15:27.00,Default,,0,0,0,,Сабырлы болыңыз
Dialogue: 0,0:15:27.00,0:15:28.30,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:15:29.28,0:15:30.93,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:15:30.93,0:15:33.85,Default,,0,0,0,,Сезімдерің менің бақылауымда.
Dialogue: 0,0:15:34.13,0:15:37.64,Default,,0,0,0,,Қанша барғым келсе де, бармайынша бара алмаймын.
Dialogue: 0,0:15:37.64,0:15:39.06,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:39.29,0:15:40.85,Default,,0,0,0,,Қатты қозғалады.
Dialogue: 0,0:15:40.85,0:15:44.15,Default,,0,0,0,,Өйткені әдеттен тыс тітіркендіргіштер миға тікелей әсер етеді
Dialogue: 0,0:15:44.15,0:15:45.61,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:15:46.01,0:15:47.53,Default,,0,0,0,,Мұғалім, күте тұрыңыз!
Dialogue: 0,0:16:04.63,0:16:07.34,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен үшін жақсы емес пе?
Dialogue: 0,0:16:07.34,0:16:09.17,Default,,0,0,0,,Мұғалім, мені жіберіңізші!
Dialogue: 0,0:16:09.17,0:16:10.51,Default,,0,0,0,,Маған өмір сүруге рұқсат етіңіз
Dialogue: 0,0:16:10.51,0:16:12.84,Default,,0,0,0,,Мен жынды болып бара жатырмын
Dialogue: 0,0:16:13.49,0:16:15.80,Default,,0,0,0,,Сен жақсы көрінесің, Минасэ-кун.
Dialogue: 0,0:16:19.94,0:16:21.35,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:16:21.58,0:16:25.06,Default,,0,0,0,,Ішіме кіріңді түкір
Dialogue: 0,0:16:29.72,0:16:31.28,Default,,0,0,0,,А, шықты.
Dialogue: 0,0:16:31.28,0:16:32.99,Default,,0,0,0,,Үлкен күшпен
Dialogue: 0,0:16:33.46,0:16:35.07,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:16:36.63,0:16:40.08,Default,,0,0,0,,Енді сен менің қызметшімсің
Dialogue: 0,0:16:45.16,0:16:46.81,Default,,0,0,0,,Сіз әлі
Dialogue: 0,0:16:48.74,0:16:51.45,Default,,0,0,0,,Жоғары деңгейдегі рухтарды бағындыру мүмкін емес.
Dialogue: 0,0:16:53.79,0:16:56.51,Default,,0,0,0,,Мен сізге танысымды беремін.
Dialogue: 0,0:16:57.20,0:16:59.18,Default,,0,0,0,,Менің келісім-шартымды қабылдаңыз
Dialogue: 0,0:16:59.18,0:17:02.27,Default,,0,0,0,,Ал маған адалдық пен қуаныш сыйла.
Dialogue: 0,0:17:02.82,0:17:03.63,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:17:03.63,0:17:04.60,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:17:05.21,0:17:08.86,Default,,0,0,0,,Эй, кеше түнде Куруми-чан екеуіңе бірдеңе болды ма?
Dialogue: 0,0:17:08.86,0:17:11.57,Default,,0,0,0,,Куруми-чан, сен бөлмеңнен бір қадам да шыққан жоқсың.
Dialogue: 0,0:17:11.76,0:17:14.03,Default,,0,0,0,,Кешке рахмет айтуға барсам, анам:
Dialogue: 0,0:17:16.82,0:17:19.37,Default,,0,0,0,,Эй, сен мені тыңдап тұрсың ба?
Dialogue: 0,0:17:22.27,0:17:23.37,Default,,0,0,0,,Эй, міне!
Dialogue: 0,0:17:26.11,0:17:29.25,Default,,0,0,0,,Бюстгалтеріңізді дұрыс кигеніңізге көз жеткізіңіз, бұл көз ауыртады.
Dialogue: 0,0:17:30.88,0:17:32.26,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:17:32.26,0:17:33.55,Default,,0,0,0,,Арзан
Dialogue: 0,0:17:45.79,0:17:47.19,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:48.17,0:17:49.52,Default,,0,0,0,,Әпкеме
Dialogue: 0,0:17:54.80,0:17:55.82,Default,,0,0,0,,No
Dialogue: 0,0:18:11.91,0:18:13.26,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:18:13.26,0:18:16.01,Default,,0,0,0,,Мен сізге танысымды беремін.
Dialogue: 0,0:18:17.64,0:18:19.64,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:18:24.92,0:18:26.77,Default,,0,0,0,,Иә, бұл Минасе.
Dialogue: 0,0:18:29.89,0:18:31.97,Default,,0,0,0,,Не! Сіз де табандысыз.
Dialogue: 0,0:18:35.57,0:18:36.90,Default,,0,0,0,,О, жарайды
Dialogue: 0,0:18:36.90,0:18:38.32,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:18:38.32,0:18:39.82,Default,,0,0,0,,Маған картаны факс арқылы жіберіңіз.
Dialogue: 0,0:18:40.10,0:18:42.07,Default,,0,0,0,,Иә, сонда
Dialogue: 0,0:18:45.94,0:18:47.37,Default,,0,0,0,,Сіз Китами мырзасыз ба?
Dialogue: 0,0:18:48.02,0:18:49.25,Default,,0,0,0,,Бұл Минасе.
Dialogue: 0,0:18:51.91,0:18:52.83,Default,,0,0,0,,Иә
Dialogue: 0,0:18:53.05,0:18:54.30,Default,,0,0,0,,Минас
Dialogue: 0,0:18:54.78,0:18:56.42,Default,,0,0,0,,Күте тұрыңыз, мен оны қазір ашамын.
Dialogue: 0,0:18:57.53,0:18:59.01,Default,,0,0,0,,Қош келдіңіз, Минасе-кун
Dialogue: 0,0:19:00.45,0:19:01.97,Default,,0,0,0,,Мен сені мазалаймын.
Dialogue: 0,0:19:03.01,0:19:04.46,Default,,0,0,0,,Китами мырза
Dialogue: 0,0:19:04.46,0:19:07.06,Default,,0,0,0,,Сіз нені айтасыз? Түсіндіріңізші, Минасе-кун.
Dialogue: 0,0:19:07.46,0:19:09.02,Default,,0,0,0,,Бұл жерден кет
Dialogue: 0,0:19:13.09,0:19:14.90,Default,,0,0,0,,Каори, не болды?
Dialogue: 0,0:19:15.26,0:19:16.65,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:16.73,0:19:18.32,Default,,0,0,0,,Каориге не істедің?
Dialogue: 0,0:19:18.76,0:19:21.03,Default,,0,0,0,,Әй, күт, сен несің!
Dialogue: 0,0:19:22.97,0:19:25.53,Default,,0,0,0,,Сіз қалай сөйлеуді білмейсіз.
Dialogue: 0,0:19:25.98,0:19:27.12,Default,,0,0,0,,Макиге қауіп төніп тұр
Dialogue: 0,0:19:29.65,0:19:31.19,Default,,0,0,0,,Маки, жақсысың ба?
Dialogue: 0,0:19:35.99,0:19:37.59,Default,,0,0,0,,*Аматсуки амулет
Dialogue: 0,0:19:39.43,0:19:42.50,Default,,0,0,0,,сенапос, телфита, эстамосс
Dialogue: 0,0:19:42.50,0:19:44.85,Default,,0,0,0,,парандесса, гистанос
Dialogue: 0,0:19:47.91,0:19:49.06,Default,,0,0,0,,Ведьма
Dialogue: 0,0:19:49.06,0:19:53.81,Default,,0,0,0,,Рафаэль, Габриэль, Майкл, Уриэль
Dialogue: 0,0:19:57.09,0:19:59.37,Default,,0,0,0,,Сонымен, сіз тосқауыл қоюды ойладыңыз ба?
Dialogue: 0,0:20:05.27,0:20:06.45,Default,,0,0,0,,Каори
Dialogue: 0,0:20:07.85,0:20:10.37,Default,,0,0,0,,Мен саған нағыз сиқыр көрсетемін.
Dialogue: 0,0:20:13.46,0:20:15.38,Default,,0,0,0,,бестабелто
Dialogue: 0,0:20:35.25,0:20:38.11,Default,,0,0,0,,Не болып жатыр? менің денем
Dialogue: 0,0:20:38.21,0:20:40.99,Default,,0,0,0,,Ыстық Ол жақта ыстық
Dialogue: 0,0:20:42.05,0:20:43.90,Default,,0,0,0,,Екеуің де мықты болыңдар
Dialogue: 0,0:20:47.16,0:20:49.99,Default,,0,0,0,,Маған көмектес, маған көмектес, Минасе-кун
Dialogue: 0,0:20:51.24,0:20:52.41,Default,,0,0,0,,Бұл пайдасыз.
Dialogue: 0,0:20:52.41,0:20:56.29,Default,,0,0,0,,Минасэ-кун сені бұдан былай зорлайды.
Dialogue: 0,0:20:56.29,0:20:57.32,Default,,0,0,0,,Е! ?
Dialogue: 0,0:20:58.50,0:21:01.26,Default,,0,0,0,,Мен жамандық жасамаймын, Саэки.
Dialogue: 0,0:21:02.09,0:21:03.55,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:21:03.55,0:21:07.34,Default,,0,0,0,,Сен шынымен де жаныңды шайтанға саттың ғой, солай емес пе?
Dialogue: 0,0:21:08.00,0:21:10.93,Default,,0,0,0,,Оны сал, не қаласаң, соны сал.
Dialogue: 0,0:21:10.93,0:21:12.48,Default,,0,0,0,,Мүмкіндігінше тезірек
Dialogue: 0,0:21:12.48,0:21:13.85,Default,,0,0,0,,Өтінемін, мені сиқыршы
Dialogue: 0,0:21:13.85,0:21:16.52,Default,,0,0,0,,Сіз де соны қалайсыз және қарсы тұра алмайсыз, солай ма?
Dialogue: 0,0:21:30.83,0:21:32.58,Default,,0,0,0,,*Андрогиндік «Гермафродит»
Dialogue: 0,0:21:36.10,0:21:37.67,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:38.34,0:21:40.13,Default,,0,0,0,,Тез құлау
Dialogue: 0,0:21:45.86,0:21:47.73,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз қаладыңыз ба?
Dialogue: 0,0:21:49.71,0:21:50.64,Default,,0,0,0,,Иә
Dialogue: 0,0:21:51.58,0:21:55.85,Default,,0,0,0,,Көңіліңіз толмайынша жасамайынша, толқу басылмайды.
Dialogue: 0,0:21:56.37,0:21:59.46,Default,,0,0,0,,Өтінемін, тезірек!
Dialogue: 0,0:21:59.46,0:22:01.11,Default,,0,0,0,,Өтінемін, асығыңыз
Dialogue: 0,0:22:02.54,0:22:05.11,Default,,0,0,0,,Енді бастайық па? Минасе-кун
Dialogue: 0,0:22:05.11,0:22:06.32,Default,,0,0,0,,Иә мырза
Dialogue: 0,0:22:18.37,0:22:19.79,Default,,0,0,0,,Жарайды, енді іске кірісейік.
Dialogue: 0,0:22:19.79,0:22:22.71,Default,,0,0,0,,Бірінші рет болса да, мен оны сезініп тұрмын
Dialogue: 0,0:22:22.71,0:22:27.38,Default,,0,0,0,,Таза, айлакер! Тезірек маған хабарлаңыз
Dialogue: 0,0:22:27.38,0:22:29.26,Default,,0,0,0,,Тыныш күтіңіз.
Dialogue: 0,0:22:29.26,0:22:30.85,Default,,0,0,0,,қаншық
Dialogue: 0,0:22:35.24,0:22:37.81,Default,,0,0,0,,Ику Ику!
Dialogue: 0,0:22:41.09,0:22:42.15,Default,,0,0,0,,Шық!
Dialogue: 0,0:22:47.72,0:22:49.36,Default,,0,0,0,,Енді сізсіз
Dialogue: 0,0:23:00.84,0:23:02.67,Default,,0,0,0,,Мұғалім, шыққалы жатыр.
Dialogue: 0,0:23:02.67,0:23:05.13,Default,,0,0,0,,Мен де кетейін деп жатырмын.
Dialogue: 0,0:23:05.49,0:23:07.12,Default,,0,0,0,,Енді оны өшірмеңіз
Dialogue: 0,0:23:07.12,0:23:08.79,Default,,0,0,0,,Мен тойдым
Dialogue: 0,0:23:08.79,0:23:13.64,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Алдынан 3 рет, бөкседен 2 рет оқ аттым.
Dialogue: 0,0:23:14.41,0:23:16.89,Default,,0,0,0,,Мұғалім, көп!
Dialogue: 0,0:23:16.89,0:23:21.06,Default,,0,0,0,,Минасе-кун, бір рет барып дем алайық.
Dialogue: 0,0:23:21.31,0:23:22.31,Default,,0,0,0,,Иә
Dialogue: 0,0:23:22.31,0:23:24.48,Default,,0,0,0,,Мені қазір кешіріңіз
Dialogue: 0,0:23:30.44,0:23:32.41,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:23:49.95,0:23:51.63,Default,,0,0,0,,Қазір емес
Dialogue: 0,0:23:52.15,0:23:54.18,Default,,0,0,0,,Мектептен шығатын уақыт әлдеқашан өтіп кетті.
Dialogue: 0,0:23:56.57,0:23:58.72,Default,,0,0,0,,Қолдары да қозғалмайтын сияқты.
Dialogue: 0,0:23:58.72,0:24:00.10,Default,,0,0,0,,Қазір үйге қайт
Dialogue: 0,0:24:00.46,0:24:01.81,Default,,0,0,0,,Такаджо мырза
Dialogue: 0,0:24:02.38,0:24:03.48,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:24:03.86,0:24:05.61,Default,,0,0,0,,Әлгі көңілді Имари-сан
Dialogue: 0,0:24:05.61,0:24:07.90,Default,,0,0,0,,Неліктен үш күн сабаққа келмейсің?
Dialogue: 0,0:24:08.09,0:24:10.15,Default,,0,0,0,,Енді мен үшін
Dialogue: 0,0:24:10.47,0:24:13.78,Default,,0,0,0,,Бұл сіздің сиқырыңызға қатысты болуы керек, солай ма?
Dialogue: 0,0:24:14.62,0:24:15.74,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:24:16.27,0:24:18.95,Default,,0,0,0,,Минасэ-кун, мен сені ешқашан күтпедім!
Dialogue: 0,0:24:18.95,0:24:20.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:24:25.99,0:24:27.38,Default,,0,0,0,,Жақсы өтті.
Dialogue: 0,0:24:28.36,0:24:30.42,Default,,0,0,0,,Ол аздап көзі ауырады.
Dialogue: 0,0:24:33.24,0:24:35.09,Default,,0,0,0,,Сен жақсысың, Минасэ-кун.
Dialogue: 0,0:24:43.75,0:24:45.11,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:24:45.11,0:24:47.08,Default,,0,0,0,,Минас ақымақ
Dialogue: 0,0:24:48.61,0:24:49.78,Default,,0,0,0,,Имари
Dialogue: 0,0:24:51.01,0:24:52.65,Default,,0,0,0,,Имари сонда ма?
Dialogue: 0,0:24:53.14,0:24:54.45,Default,,0,0,0,,Минас
Dialogue: 0,0:24:54.68,0:24:57.16,Default,,0,0,0,,Маған бетіңізді көрсете аласыз ба?
Dialogue: 0,0:24:59.89,0:25:01.29,Default,,0,0,0,,Имари
Dialogue: 0,0:25:01.29,0:25:03.04,Default,,0,0,0,,Қазір жүзіңе қарасам
Dialogue: 0,0:25:04.13,0:25:06.29,Default,,0,0,0,,Даусыңды естісем
Dialogue: 0,0:25:06.48,0:25:08.63,Default,,0,0,0,,Мен кері бұрылатындай сезінемін.
Dialogue: 0,0:25:11.84,0:25:13.36,Default,,0,0,0,,Имари
Dialogue: 0,0:25:39.12,0:25:40.62,Default,,0,0,0,,Кеш болған жоқ па?
Dialogue: 0,0:25:42.87,0:25:44.71,Default,,0,0,0,,Кешіріңіз
