Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.54,0:00:10.77,Default,,0,0,0,,Сиқырмен айналысқандарды тірі қалдырма.
Dialogue: 0,0:00:11.13,0:00:16.71,Default,,0,0,0,,Кез келген жануармен ұйықтаған адам өлім жазасына кесілсін.
Dialogue: 0,0:00:16.71,0:00:23.82,Default,,0,0,0,,Жаратқан Иеден басқа кез келген құдайға құрбандық шалған адам жойылады.
Dialogue: 0,0:00:23.82,0:00:32.19,Default,,0,0,0,,Ескі өсиет Мысырдан шығу 22 тарау 18/20 аят
Dialogue: 0,0:00:33.96,0:00:39.17,Default,,0,0,0,,...
Dialogue: 0,0:00:45.21,0:00:52.68,Default,,0,0,0,,El erohim erohi erohim. Савант эрохим
Dialogue: 0,0:00:53.22,0:00:58.12,Default,,0,0,0,,Эйхай Эйхеяджа. Қайырлы түн
Dialogue: 0,0:01:05.66,0:01:09.60,Default,,0,0,0,,Я шадие тетора. Граматон шади
Dialogue: 0,0:01:11.00,0:01:16.34,Default,,0,0,0,,...
Dialogue: 0,0:01:16.81,0:01:18.61,Default,,0,0,0,,Агура аумин
Dialogue: 0,0:01:46.36,0:01:48.74,Default,,0,0,0,,Құрбандыққа шалынатын қой
Dialogue: 0,0:01:48.74,0:01:53.08,Default,,0,0,0,,Сен зұлым рухтарға қарсы күштің тірегісің
Dialogue: 0,0:01:53.18,0:01:54.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:55.28,0:01:57.58,Default,,0,0,0,,Ев өлтірілді
Dialogue: 0,0:01:57.58,0:02:01.58,Default,,0,0,0,,Маған қараңғылық құдайларына билік бер.
Dialogue: 0,0:02:02.18,0:02:04.52,Default,,0,0,0,,Құрбандыққа шалынатын қой
Dialogue: 0,0:02:04.99,0:02:10.16,Default,,0,0,0,,Маған бүлікші жындарды басу үшін билік беріңіз.
Dialogue: 0,0:02:15.31,0:02:21.36,Default,,0,0,0,,Ах, құтқарушы жанның құрбандығы, Аматсу патшалығының қақпасын ашқан адам.
Dialogue: 0,0:02:21.57,0:02:24.04,Default,,0,0,0,,Сендердің қақпаларыңды ашайық
Dialogue: 0,0:02:24.04,0:02:26.17,Default,,0,0,0,,Сіздің ханзадаларыңыз
Dialogue: 0,0:02:26.17,0:02:28.61,Default,,0,0,0,,Мәңгілік есігін аш
Dialogue: 0,0:02:28.61,0:02:31.68,Default,,0,0,0,,Даңқ патшасы кіреді
Dialogue: 0,0:02:31.85,0:02:34.62,Default,,0,0,0,,Мәңгілік Патша – Құдіретті Патша
Dialogue: 0,0:02:34.62,0:02:37.35,Default,,0,0,0,,Иеміз — Даңқ Патшасы
Dialogue: 0,0:02:37.41,0:02:40.04,Default,,0,0,0,,Әкеге, Ұлға және Киелі Рухқа даңқ
Dialogue: 0,0:02:40.04,0:02:41.50,Default,,0,0,0,,Неліктен мен керек?
Dialogue: 0,0:02:41.50,0:02:45.06,Default,,0,0,0,,...
Dialogue: 0,0:02:45.90,0:02:49.18,Default,,0,0,0,,...
Dialogue: 0,0:02:49.77,0:02:53.04,Default,,0,0,0,,...
Dialogue: 0,0:02:53.50,0:02:56.81,Default,,0,0,0,,...
Dialogue: 0,0:02:57.37,0:03:00.58,Default,,0,0,0,,...
Dialogue: 0,0:03:00.68,0:03:03.85,Default,,0,0,0,,...
Dialogue: 0,0:03:03.85,0:03:06.84,Default,,0,0,0,,...
Dialogue: 0,0:03:06.84,0:03:09.95,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:32.07,0:03:34.10,Default,,0,0,0,,Минас
Dialogue: 0,0:03:34.79,0:03:38.93,Default,,0,0,0,,Бұл не, Имари? Сізге бірдеңе керек пе?
Dialogue: 0,0:03:38.93,0:03:41.32,Default,,0,0,0,,Минас, түскі асты бірге ішейік.
Dialogue: 0,0:03:41.32,0:03:44.69,Default,,0,0,0,,дегеніміз не? Сіз әлі тамақтанып үлгердіңіз бе?
Dialogue: 0,0:03:46.41,0:03:48.91,Default,,0,0,0,,Сіздің дәретханаңыз тым ұзын.
Dialogue: 0,0:03:49.64,0:03:51.77,Default,,0,0,0,,Енді тезірек сөйлесейік.
Dialogue: 0,0:03:51.77,0:03:54.38,Default,,0,0,0,,Қоңырау соғылып бітті.
Dialogue: 0,0:03:54.38,0:03:58.11,Default,,0,0,0,,Бірақ мұндай үлкен түскі ас қорабы?
Dialogue: 0,0:04:05.11,0:04:06.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:06.26,0:04:07.41,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:04:07.41,0:04:10.62,Default,,0,0,0,,Сіз екі түскі қорап әкелгеніңізге сенімдісіз бе?
Dialogue: 0,0:04:10.62,0:04:13.29,Default,,0,0,0,,Ал, барамыз ба?
Dialogue: 0,0:04:13.29,0:04:14.64,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:04:14.64,0:04:16.93,Default,,0,0,0,,Оның Имариге қатысы жоқ.
Dialogue: 0,0:04:16.93,0:04:18.79,Default,,0,0,0,,Күріш дәндерімен бірге келеді.
Dialogue: 0,0:04:27.29,0:04:28.47,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:28.47,0:04:30.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:37.61,0:04:38.58,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:04:38.94,0:04:42.65,Default,,0,0,0,,Бұл мұғалім не туралы айтып тұр?
Dialogue: 0,0:04:43.50,0:04:46.39,Default,,0,0,0,,Ито мырза, түскі асыңызды әлі бітірдіңіз бе?
Dialogue: 0,0:04:46.39,0:04:49.38,Default,,0,0,0,,Жоқ, жоқ, бірақ қазірден бастап.
Dialogue: 0,0:04:49.80,0:04:51.23,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:05:02.04,0:05:03.18,Default,,0,0,0,,Секір!!
Dialogue: 0,0:05:05.62,0:05:08.07,Default,,0,0,0,,Мен сендерге той беремін.
Dialogue: 0,0:05:24.06,0:05:27.93,Default,,0,0,0,,Элохим Элохим, Элохий Элохим, Сабаот Элион
Dialogue: 0,0:05:37.87,0:05:43.14,Default,,0,0,0,,Мұғалім, Китами-сенсэй, маған бірдеңе болды.
Dialogue: 0,0:05:43.24,0:05:45.97,Default,,0,0,0,,Бұл жерде сіз үшін өте ыстық
Dialogue: 0,0:05:59.78,0:06:04.12,Default,,0,0,0,,Мұғалім, сіз мұны істей алмайсыз.
Dialogue: 0,0:06:04.31,0:06:06.93,Default,,0,0,0,,Иә, мүмкін емес.
Dialogue: 0,0:06:07.62,0:06:08.53,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:06:08.90,0:06:10.80,Default,,0,0,0,,Мен тоқтаймын
Dialogue: 0,0:06:10.80,0:06:11.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:12.43,0:06:13.60,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:06:13.65,0:06:16.47,Default,,0,0,0,,Қайсысы? анық бол
Dialogue: 0,0:06:17.44,0:06:19.81,Default,,0,0,0,,Жоқ, тоқтамаңыз.
Dialogue: 0,0:06:20.72,0:06:23.59,Default,,0,0,0,,Өтінемін, тоқтамаңыз, солай ма?
Dialogue: 0,0:06:24.29,0:06:26.98,Default,,0,0,0,,Жоқ, жоқ, тоқтама.
Dialogue: 0,0:06:26.98,0:06:29.18,Default,,0,0,0,,Шығармаңыз
Dialogue: 0,0:06:29.18,0:06:31.62,Default,,0,0,0,,Өтінемін, солай ма?
Dialogue: 0,0:06:31.62,0:06:35.77,Default,,0,0,0,,О, о, о, өтінемін
Dialogue: 0,0:06:36.37,0:06:37.67,Default,,0,0,0,,Iikone
Dialogue: 0,0:07:01.46,0:07:06.34,Default,,0,0,0,,Жарайсыңдар, сенің тесігің жақсы екен
Dialogue: 0,0:07:21.47,0:07:25.86,Default,,0,0,0,,Мұғалім Китами Сенсей керемет
Dialogue: 0,0:07:25.89,0:07:28.32,Default,,0,0,0,,Бұл дәмді ме, Ито мырза? менікі
Dialogue: 0,0:07:28.32,0:07:32.52,Default,,0,0,0,,Бұл дәмді Өте дәмді
Dialogue: 0,0:07:33.09,0:07:36.76,Default,,0,0,0,,Онда мен сені көбірек тамақтандырамын.
Dialogue: 0,0:07:38.41,0:07:42.53,Default,,0,0,0,,Мен сенің ішіңдегі әрбір тамшысын сығамын
Dialogue: 0,0:08:02.93,0:08:06.27,Default,,0,0,0,,Мұғалім Китами Сенсей
Dialogue: 0,0:08:08.77,0:08:12.13,Default,,0,0,0,,Бұл да таза емес еді.
Dialogue: 0,0:08:23.01,0:08:25.10,Default,,0,0,0,,Егер сіз оны іздемесеңіз
Dialogue: 0,0:08:25.25,0:08:26.98,Default,,0,0,0,,Жазықсыз дене
Dialogue: 0,0:08:27.76,0:08:30.14,Default,,0,0,0,,Вальпургис түні
Dialogue: 0,0:08:38.76,0:08:40.45,Default,,0,0,0,,Бұл еркелік пе?
Dialogue: 0,0:08:42.55,0:08:44.12,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:45.27,0:08:46.94,Default,,0,0,0,,Неліктен бұлай болады?
Dialogue: 0,0:08:47.15,0:08:48.07,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:08:53.86,0:08:55.64,Default,,0,0,0,,Рика Шираки
Dialogue: 0,0:08:56.35,0:08:58.23,Default,,0,0,0,,Сізге қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,0:08:58.72,0:09:01.47,Default,,0,0,0,,Менің студенттік кеңесте біраз жұмысым бар еді.
Dialogue: 0,0:09:01.80,0:09:03.54,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:03.66,0:09:05.35,Default,,0,0,0,,Бұл сіз бе?
Dialogue: 0,0:09:10.73,0:09:12.55,Default,,0,0,0,,Кешеден бері
Dialogue: 0,0:09:12.66,0:09:15.54,Default,,0,0,0,,Кешеден бері сені ойлап жүрмін.
Dialogue: 0,0:09:16.86,0:09:18.57,Default,,0,0,0,,Шираки-сан
Dialogue: 0,0:09:19.13,0:09:21.21,Default,,0,0,0,,Тек сені ойлау
Dialogue: 0,0:09:21.21,0:09:23.25,Default,,0,0,0,,Жүрегім жарылып кетердей.
Dialogue: 0,0:09:32.51,0:09:33.50,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:09:39.04,0:09:39.92,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:09:42.25,0:09:43.79,Default,,0,0,0,,Мені ұста
Dialogue: 0,0:09:46.90,0:09:49.45,Default,,0,0,0,,Өтінемін, қазір мені ұстаңыз
Dialogue: 0,0:09:49.73,0:09:51.45,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:09:51.45,0:09:53.52,Default,,0,0,0,,Шираки-сан
Dialogue: 0,0:09:53.99,0:09:56.86,Default,,0,0,0,,Минасэ-кун, сен мені жек көресің бе?
Dialogue: 0,0:09:56.92,0:09:58.18,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:09:58.18,0:10:01.43,Default,,0,0,0,,Міне, мен әрқашан таңданатынмын.
Dialogue: 0,0:10:01.45,0:10:03.11,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:10:09.90,0:10:10.86,Default,,0,0,0,,Бұл да
Dialogue: 0,0:10:13.83,0:10:15.28,Default,,0,0,0,,Мені мазақтамаңыз
Dialogue: 0,0:10:15.28,0:10:16.41,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:10:22.65,0:10:24.19,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:10:24.54,0:10:26.02,Default,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:10:32.71,0:10:34.19,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:10:34.19,0:10:37.40,Default,,0,0,0,,Асығыңыз, асығыңыз, мені былғаңыз
Dialogue: 0,0:10:37.40,0:10:38.57,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:11:01.67,0:11:03.80,Default,,0,0,0,,Минасэ-кун тез
Dialogue: 0,0:11:04.33,0:11:05.90,Default,,0,0,0,,Керемет көрініс
Dialogue: 0,0:11:05.93,0:11:08.96,Default,,0,0,0,,Шираки мырза шынымен де бұзық болған, солай емес пе?
Dialogue: 0,0:11:08.96,0:11:10.63,Default,,0,0,0,,Бұл Минасэ-кунның кінәсі.
Dialogue: 0,0:11:10.63,0:11:12.23,Default,,0,0,0,,Мені осылай сезіндіру
Dialogue: 0,0:11:13.54,0:11:16.74,Default,,0,0,0,,Шираки-санның маңызды бөліктері анық көрінеді
Dialogue: 0,0:11:16.74,0:11:18.87,Default,,0,0,0,,Жоқ, бұл ұят.
Dialogue: 0,0:11:18.87,0:11:23.65,Default,,0,0,0,,Шираки-сан, жүзің сүйкімді, бірақ иісің күшті.
Dialogue: 0,0:11:23.65,0:11:26.78,Default,,0,0,0,,Жоқ, ол жерді иіскеме.
Dialogue: 0,0:11:28.89,0:11:30.95,Default,,0,0,0,,Минасе-кун, №.
Dialogue: 0,0:11:32.09,0:11:33.99,Default,,0,0,0,,Бірақ оның иісі өте жақсы.
Dialogue: 0,0:11:33.99,0:11:34.90,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:11:34.90,0:11:37.66,Default,,0,0,0,,А, мен оны иіскеп тұрғым келеді.
Dialogue: 0,0:11:37.66,0:11:38.96,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:11:41.36,0:11:44.10,Default,,0,0,0,,Шираки мырза, маған бөксеңізді беріңіз.
Dialogue: 0,0:11:45.34,0:11:46.37,Default,,0,0,0,,Иә
Dialogue: 0,0:12:05.32,0:12:07.02,Default,,0,0,0,,Жарайды, бұл дұрыс.
Dialogue: 0,0:12:07.39,0:12:08.75,Default,,0,0,0,,Не? бұл?
Dialogue: 0,0:12:08.75,0:12:10.66,Default,,0,0,0,,Ал, бұл не?
Dialogue: 0,0:12:11.20,0:12:12.93,Default,,0,0,0,,Не?
Dialogue: 0,0:12:12.93,0:12:16.30,Default,,0,0,0,,Жоқ! Мен саусағымды инемен шаншып алдым
Dialogue: 0,0:12:16.40,0:12:21.44,Default,,0,0,0,,Өйткені, сиқыршы болып көрінетін Саэки жасай алмайтын нәрсені мен істей алмаймын, солай ма?
Dialogue: 0,0:12:24.03,0:12:25.57,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:12:25.57,0:12:28.74,Default,,0,0,0,,Бұл жұмбақ, себебі Саэки мырза осындай нәрсені жасайды.
Dialogue: 0,0:12:28.74,0:12:30.13,Default,,0,0,0,,Минас мұны жасады
Dialogue: 0,0:12:30.13,0:12:32.21,Default,,0,0,0,,Үніңді жап, Имари.
Dialogue: 0,0:12:32.21,0:12:35.18,Default,,0,0,0,,Енді мен думанды салтанатты түрде айтамын.
Dialogue: 0,0:12:35.18,0:12:36.32,Default,,0,0,0,,Емле?
Dialogue: 0,0:12:36.99,0:12:37.68,Default,,0,0,0,,Мурай
Dialogue: 0,0:12:37.68,0:12:38.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:38.57,0:12:42.72,Default,,0,0,0,,*Онда мына затты Асада-кунның сөмкесіне салып көріңіз.
Dialogue: 0,0:12:43.19,0:12:45.04,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:12:50.90,0:12:54.44,Default,,0,0,0,,Элохи, Элохим, Элохий, Сабаот
Dialogue: 0,0:12:54.44,0:12:57.24,Default,,0,0,0,,Элион, Исхирос, Жаратқан Ие, Ях
Dialogue: 0,0:12:57.74,0:12:59.91,Default,,0,0,0,,Тетраграмматон, Садай
Dialogue: 0,0:13:09.68,0:13:11.32,Default,,0,0,0,,Минас Бұл қиын.
Dialogue: 0,0:13:19.07,0:13:20.46,Default,,0,0,0,,Асада мырза
Dialogue: 0,0:13:24.61,0:13:26.33,Default,,0,0,0,,Ақыр аяғында тастап кеткен сияқты.
Dialogue: 0,0:13:26.33,0:13:28.47,Default,,0,0,0,,Онымен бірге Асада-кун келе жатты.
Dialogue: 0,0:13:28.47,0:13:32.48,Default,,0,0,0,,Сол Мұрай деген қыздың қасынан өткен бойда ол мені мойындады.
Dialogue: 0,0:13:34.40,0:13:35.08,Default,,0,0,0,,Кенеттен!
Dialogue: 0,0:13:34.99,0:13:37.58,Default,,0,0,0,,Бірақ сіз мойындаған соң соншалықты алысқа барасыз ба?
Dialogue: 0,0:13:37.58,0:13:39.45,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:13:41.93,0:13:43.32,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:44.47,0:13:45.72,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:13:44.85,0:13:45.88,Default,,0,0,0,,Шираки
Dialogue: 0,0:13:45.88,0:13:47.69,Default,,0,0,0,,Бұл жер қай жерде деп ойлайсыңдар?
Dialogue: 0,0:13:48.48,0:13:50.36,Default,,0,0,0,,Мені жібер. Сен не істеп жатырсың?
Dialogue: 0,0:13:50.36,0:13:53.36,Default,,0,0,0,,Жібер, жібер, Мұрай-сан
Dialogue: 0,0:13:53.36,0:13:55.23,Default,,0,0,0,,Жоқ, жібер
Dialogue: 0,0:13:55.23,0:13:56.93,Default,,0,0,0,,Асада мырза
Dialogue: 0,0:13:57.27,0:13:59.90,Default,,0,0,0,,Барлығыңыз, көрудің орнына көмектесіңіздер.
Dialogue: 0,0:14:09.68,0:14:10.75,Default,,0,0,0,,Шираки мырза
Dialogue: 0,0:14:11.32,0:14:12.32,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:14:41.64,0:14:45.08,Default,,0,0,0,,Минасэ-кун, келші.
Dialogue: 0,0:15:00.33,0:15:01.66,Default,,0,0,0,,Шираки мырза
Dialogue: 0,0:15:05.39,0:15:08.97,Default,,0,0,0,,Мен ішімде Минасэ-кунды сезінемін.
Dialogue: 0,0:15:14.91,0:15:17.69,Default,,0,0,0,,Бірінші рет болса да, жақсы сезінемін
Dialogue: 0,0:15:17.69,0:15:19.65,Default,,0,0,0,,Мен де өзімді жақсы сезінемін
Dialogue: 0,0:15:19.65,0:15:20.88,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:15:20.88,0:15:23.08,Default,,0,0,0,,Қарқындырақ етіңіз
Dialogue: 0,0:15:29.68,0:15:31.03,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:15:33.24,0:15:34.20,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:15:41.73,0:15:43.77,Default,,0,0,0,,Олай жасасаң, шығасың.
Dialogue: 0,0:15:44.34,0:15:45.87,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:15:46.01,0:15:47.19,Default,,0,0,0,,Мен де
Dialogue: 0,0:15:47.19,0:15:49.58,Default,,0,0,0,,Мен тым ерте
Dialogue: 0,0:15:49.94,0:15:51.48,Default,,0,0,0,,Бару
Dialogue: 0,0:15:51.48,0:15:52.61,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:54.38,0:15:55.48,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,0:15:55.48,0:15:56.68,Default,,0,0,0,,Жою керек
Dialogue: 0,0:15:56.88,0:15:58.84,Default,,0,0,0,,Жоқ! Ішке апарыңыз
Dialogue: 0,0:15:58.84,0:15:59.68,Default,,0,0,0,,Бірақ
Dialogue: 0,0:15:59.68,0:16:02.46,Default,,0,0,0,,Жақсы! Барлығын ішке салыңыз
Dialogue: 0,0:16:02.46,0:16:04.69,Default,,0,0,0,,Минасе-кунды өзіңдікімен толтыр.
Dialogue: 0,0:16:07.56,0:16:08.43,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:16:08.43,0:16:09.60,Default,,0,0,0,,Керемет
Dialogue: 0,0:16:09.60,0:16:10.87,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:16:48.84,0:16:50.94,Default,,0,0,0,,Эй Минасе, көрейін.
Dialogue: 0,0:16:50.94,0:16:52.07,Default,,0,0,0,,No
Dialogue: 0,0:16:52.07,0:16:54.78,Default,,0,0,0,,Ой, мен оны жақсы сала алмаймын ба?
Dialogue: 0,0:16:55.47,0:16:56.51,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:16:56.51,0:16:59.05,Default,,0,0,0,,Мен оны сізге көрсеткім келмейді, себебі ол әлі орындалуда.
Dialogue: 0,0:16:59.48,0:17:01.46,Default,,0,0,0,,Неліктен? Жарайды.
Dialogue: 0,0:17:01.51,0:17:02.85,Default,,0,0,0,,Сондықтан бұл жақсы емес
Dialogue: 0,0:17:04.68,0:17:06.59,Default,,0,0,0,,Сіз оны өте жақсы сала аласыз.
Dialogue: 0,0:17:07.52,0:17:08.90,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:17:08.35,0:17:10.83,Default,,0,0,0,,Сіз оны сол қалпында бейнеледіңіз, солай ма?
Dialogue: 0,0:17:11.22,0:17:13.18,Default,,0,0,0,,Көріп тұрсаңыз, сурет салмас бұрын айтып беріңізші!
Dialogue: 0,0:17:13.18,0:17:15.03,Default,,0,0,0,,Минасе мырза, Имари мырза
Dialogue: 0,0:17:15.63,0:17:17.20,Default,,0,0,0,,Такаджо мырза
Dialogue: 0,0:17:18.27,0:17:21.24,Default,,0,0,0,,Балалар, сендер өте жақынсыңдар, солай емес пе?
Dialogue: 0,0:17:27.82,0:17:29.36,Default,,0,0,0,,Сәлем Минасе
Dialogue: 0,0:17:32.71,0:17:33.88,Default,,0,0,0,,Не?
Dialogue: 0,0:17:35.22,0:17:36.85,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:36.85,0:17:37.85,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:17:55.47,0:17:56.87,Default,,0,0,0,,Китами мырза
Dialogue: 0,0:17:59.50,0:18:01.61,Default,,0,0,0,,Не болды? Осындай жерде
Dialogue: 0,0:18:02.28,0:18:04.76,Default,,0,0,0,,Әй, иә! сіз іздеген нәрсе
Dialogue: 0,0:18:05.31,0:18:06.61,Default,,0,0,0,,Мен сізге көмектесе аламын ба?
Dialogue: 0,0:18:07.08,0:18:08.75,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:18:12.86,0:18:16.26,Default,,0,0,0,,Бұл әйел өзінің қатысуын мүлде жоғалтты.
Dialogue: 0,0:18:17.26,0:18:18.39,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:18:30.74,0:18:31.88,Default,,0,0,0,,Кешегі күн
Dialogue: 0,0:18:31.88,0:18:32.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:34.33,0:18:36.36,Default,,0,0,0,,*Кеше Мұрай-сан туралы.
Dialogue: 0,0:18:38.79,0:18:40.95,Default,,0,0,0,,Бұл кездейсоқтық, солай ма?
Dialogue: 0,0:18:44.05,0:18:45.75,Default,,0,0,0,,Бұл анық емес пе?
Dialogue: 0,0:18:45.85,0:18:47.80,Default,,0,0,0,,Тіпті Саэки де оккультизмге бейім.
Dialogue: 0,0:18:47.80,0:18:50.32,Default,,0,0,0,,Сіз тісіңізді қайрап отырып айттыңыз.
Dialogue: 0,0:18:51.43,0:18:53.03,Default,,0,0,0,,Не болды? Имари
Dialogue: 0,0:18:54.46,0:18:56.50,Default,,0,0,0,,Саэки мырза
Dialogue: 0,0:19:02.27,0:19:03.15,Default,,0,0,0,,Саэки
Dialogue: 0,0:19:04.26,0:19:05.76,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:19:05.76,0:19:07.68,Default,,0,0,0,,Менің сізге айтарым маңызды.
Dialogue: 0,0:19:14.28,0:19:16.85,Default,,0,0,0,,А, жарайды, мен барамын.
Dialogue: 0,0:19:16.99,0:19:18.55,Default,,0,0,0,,Сәлем, Имарибецу
Dialogue: 0,0:19:18.63,0:19:20.39,Default,,0,0,0,,Бұл пайдалы, Имари-сан.
Dialogue: 0,0:19:20.39,0:19:21.69,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:19:34.72,0:19:35.76,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:19:36.07,0:19:40.21,Default,,0,0,0,,Сіз біраз уақыттан бері сиқырдың бар екенін жоққа шығардыңыз, солай емес пе?
Dialogue: 0,0:19:40.94,0:19:41.88,Default,,0,0,0,,О
Dialogue: 0,0:19:41.88,0:19:45.08,Default,,0,0,0,,Бірақ сіз оны өзіңіз пайдаландыңыз
Dialogue: 0,0:19:46.05,0:19:47.42,Default,,0,0,0,,Мұрай мырза кеше
Dialogue: 0,0:19:48.14,0:19:49.18,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:19:50.08,0:19:51.62,Default,,0,0,0,,Бүгінгі Шираки мырза
Dialogue: 0,0:19:53.79,0:19:54.96,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:19:54.96,0:19:58.39,Default,,0,0,0,,Студенттік кеңестің президенті Шираки мырза сізбен ешқашан айналыспайды.
Dialogue: 0,0:20:04.90,0:20:06.77,Default,,0,0,0,,Менің үйім осында.
Dialogue: 0,0:20:07.67,0:20:08.87,Default,,0,0,0,,Келесіз бе?
Dialogue: 0,0:20:12.91,0:20:15.48,Default,,0,0,0,,Қара сиқыршыдан күткендей
Dialogue: 0,0:20:16.34,0:20:19.81,Default,,0,0,0,,Бірақ бұл сіздің жасыңыздағы қызға арналған бөлме ме?
Dialogue: 0,0:20:20.08,0:20:22.38,Default,,0,0,0,,Қай ағаны айтып тұрсыз?
Dialogue: 0,0:20:26.42,0:20:28.42,Default,,0,0,0,,Сіз көбірек демалуға болады.
Dialogue: 0,0:20:28.86,0:20:30.62,Default,,0,0,0,,Өйткені қазір басқа ешкім жоқ
Dialogue: 0,0:20:34.60,0:20:37.33,Default,,0,0,0,,Олай болса, әңгіме қандай?
Dialogue: 0,0:20:38.03,0:20:39.87,Default,,0,0,0,,Сондықтан мен білгім келеді
Dialogue: 0,0:20:39.87,0:20:41.77,Default,,0,0,0,,Минасэ-кунның құпиясы
Dialogue: 0,0:20:42.77,0:20:45.07,Default,,0,0,0,,Құпия жоқ.
Dialogue: 0,0:20:45.07,0:20:46.31,Default,,0,0,0,,Өтірік
Dialogue: 0,0:20:46.64,0:20:49.38,Default,,0,0,0,,Сіз қолданып жатқан нәрсе - бұл махаббат қарғысы
Dialogue: 0,0:20:50.07,0:20:52.67,Default,,0,0,0,,Адамдардың жүрегін басқарып, зинақорлық жасау өнері
Dialogue: 0,0:20:53.85,0:20:56.78,Default,,0,0,0,,Ешқандай білімсіз мұндай нәрсені істеу мүмкін емес.
Dialogue: 0,0:21:01.19,0:21:02.52,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:21:02.52,0:21:07.13,Default,,0,0,0,,Сіз 12 жыл бұрын болған сиқырлы шеңбер туралы естідіңіз бе?
Dialogue: 0,0:21:07.13,0:21:08.88,Default,,0,0,0,,Бұл қауесет пе? жай
Dialogue: 0,0:21:10.51,0:21:12.05,Default,,0,0,0,,Олардың да сиқыры
Dialogue: 0,0:21:12.05,0:21:15.11,Default,,0,0,0,,Бастапқыда бұл менің қызыққаным үшін жасаған іс еді.
Dialogue: 0,0:21:15.84,0:21:16.94,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:21:19.39,0:21:22.41,Default,,0,0,0,,Бірақ ол бірте-бірте күшейе түсті.
Dialogue: 0,0:21:23.11,0:21:26.18,Default,,0,0,0,,Құрбандық ретінде тірі малды жұлып алу
Dialogue: 0,0:21:26.18,0:21:29.18,Default,,0,0,0,,Қанын, жанын шайтанға құрбан етті.
Dialogue: 0,0:21:29.18,0:21:30.45,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:21:32.85,0:21:37.49,Default,,0,0,0,,Олар шын мәнінде архаикалық сиқырлы рәсімдерді орындады.
Dialogue: 0,0:21:38.89,0:21:41.00,Default,,0,0,0,,Соңында
Dialogue: 0,0:21:41.46,0:21:44.03,Default,,0,0,0,,12 жыл бұрын Вальпурги түні
Dialogue: 0,0:22:25.48,0:22:28.01,Default,,0,0,0,,Жарайды, мен үйге барамын.
Dialogue: 0,0:22:28.01,0:22:29.31,Default,,0,0,0,,Күте тұрыңыз, Минасэ-кун
Dialogue: 0,0:22:29.31,0:22:31.91,Default,,0,0,0,,Мен бұл Вальпургис пе, әлде Катидид па, білмеймін.
Dialogue: 0,0:22:31.91,0:22:34.15,Default,,0,0,0,,Мені ондай нәрсе қызықтырмайды.
Dialogue: 0,0:22:34.52,0:22:36.25,Default,,0,0,0,,Мен сенімен кездескім келмейді.
Dialogue: 0,0:22:36.25,0:22:37.15,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:22:39.02,0:22:40.55,Default,,0,0,0,,Алаяқтық жоқ
Dialogue: 0,0:22:40.55,0:22:43.62,Default,,0,0,0,,Сіз міндетті түрде сиқырды қолданасыз.
Dialogue: 0,0:22:43.97,0:22:45.61,Default,,0,0,0,,Бұл жай ғана
Dialogue: 0,0:22:45.61,0:22:46.56,Default,,0,0,0,,Сәйкестік?
Dialogue: 0,0:22:47.96,0:22:49.10,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:22:49.56,0:22:51.40,Default,,0,0,0,,Маған сырыңды айт
Dialogue: 0,0:22:52.46,0:22:53.60,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:22:56.65,0:22:59.17,Default,,0,0,0,,Әрине, тегін демеймін.
Dialogue: 0,0:23:15.76,0:23:18.30,Default,,0,0,0,,Саэки-санның әңгімесі қандай?
Dialogue: 0,0:23:18.30,0:23:19.83,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:23:23.63,0:23:25.19,Default,,0,0,0,,Минас
Dialogue: 0,0:23:25.19,0:23:27.40,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:24:06.49,0:24:07.71,Default,,0,0,0,,Енді сөйлесіңіз
Dialogue: 0,0:24:08.14,0:24:09.74,Default,,0,0,0,,Минасэ-кунның құпиясы
Dialogue: 0,0:24:10.12,0:24:12.38,Default,,0,0,0,,Эй, бұл болмайды.
Dialogue: 0,0:24:12.66,0:24:15.68,Default,,0,0,0,,Егер сіз мұны жасасаңыз, маған хабарлауға уәде беремін.
Dialogue: 0,0:24:16.03,0:24:18.20,Default,,0,0,0,,Сіз мені жіберемін деп уәде бердіңіз ғой, солай ма?
Dialogue: 0,0:24:19.70,0:24:21.76,Default,,0,0,0,,Терезені ашып, айқайлаңыз
Dialogue: 0,0:24:23.70,0:24:26.13,Default,,0,0,0,,Сіз жалғастыра аласыз ба?
Dialogue: 0,0:24:28.77,0:24:29.58,Default,,0,0,0,,Иә
Dialogue: 0,0:24:30.83,0:24:32.70,Default,,0,0,0,,Менің кітабым бар
Dialogue: 0,0:24:32.70,0:24:34.06,Default,,0,0,0,,Сиқырлы кітап
Dialogue: 0,0:24:34.06,0:24:35.80,Default,,0,0,0,,Бұл қандай кітап?
Dialogue: 0,0:24:35.80,0:24:37.84,Default,,0,0,0,,Бұл бөлмедегідей емес.
Dialogue: 0,0:24:38.14,0:24:39.77,Default,,0,0,0,,Қосымша
Dialogue: 0,0:24:39.77,0:24:42.38,Default,,0,0,0,,Бұл ескі қолжазба.
Dialogue: 0,0:24:43.31,0:24:45.85,Default,,0,0,0,,Оны қалай алдың?
Dialogue: 0,0:24:45.85,0:24:49.02,Default,,0,0,0,,Эй, мен кітапты көре аламын ба?
Dialogue: 0,0:24:50.57,0:24:53.69,Default,,0,0,0,,Әй, ол сиқырлы кітап қазір қайда?
Dialogue: 0,0:24:53.69,0:24:54.88,Default,,0,0,0,,Бұл
Dialogue: 0,0:24:54.88,0:24:56.29,Default,,0,0,0,,Сөмкеде
Dialogue: 0,0:24:59.32,0:25:01.36,Default,,0,0,0,,Рахмет, Минасэ-кун
Dialogue: 0,0:25:03.36,0:25:05.30,Default,,0,0,0,,Сіз қалай ойлайсыз? Минасе-кун
Dialogue: 0,0:25:05.30,0:25:06.40,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:25:09.98,0:25:13.21,Default,,0,0,0,,Саэкидің кеудесі жұмсақ
