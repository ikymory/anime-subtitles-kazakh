Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,(Ат құйрығының ауыр тыныс алуы)
Dialogue: 0,0:00:20.85,0:00:21.93,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:22.02,0:00:23.52,Default,,0,0,0,,Иә Томо
Dialogue: 0,0:00:23.60,0:00:25.94,Default,,0,0,0,,Сіз бірдеңе естідіңіз бе? Кеше кел
Dialogue: 0,0:00:26.02,0:00:26.94,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:00:27.02,0:00:29.61,Default,,0,0,0,,Рика екеуміз отбасылық мейрамханаға бардық.
Dialogue: 0,0:00:29.69,0:00:31.94,Default,,0,0,0,,Сонымен, Рика...
Dialogue: 0,0:00:36.03,0:00:41.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:01.32,0:02:05.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:09.37,0:02:11.92,Default,,0,0,0,,Кешіріңіз, бұл...
Dialogue: 0,0:02:12.00,0:02:14.00,Default,,0,0,0,,Жоқ, өйткені... у... Убуката мырза
Dialogue: 0,0:02:14.09,0:02:14.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:15.00,0:02:17.59,Default,,0,0,0,,Бүгін, бүгін көркейту комитетінің жұмысы.
Dialogue: 0,0:02:17.67,0:02:19.18,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:02:19.80,0:02:21.43,Default,,0,0,0,,ше? Не айтқың келеді?
Dialogue: 0,0:02:21.51,0:02:23.93,Default,,0,0,0,,Өйткені... Убуката мырза
Dialogue: 0,0:02:24.01,0:02:26.14,Default,,0,0,0,,Мен көріктендіру комитетінде болсам да, жақында үйге барамын.
Dialogue: 0,0:02:26.22,0:02:29.56,Default,,0,0,0,,Сабақтан кейін үнемі өзім жинаймын.
Dialogue: 0,0:02:29.64,0:02:30.65,Default,,0,0,0,,Кім? Бұл жігіт
Dialogue: 0,0:02:30.73,0:02:31.65,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:02:31.73,0:02:35.44,Default,,0,0,0,,Мен Цукуси Эмотомын. Мен де көріктендіру комиссиясының мүшесімін.
Dialogue: 0,0:02:35.53,0:02:37.19,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:37.28,0:02:40.03,Default,,0,0,0,,Жақсы, сен Чикакомен көп сөйлестің.
Dialogue: 0,0:02:40.11,0:02:43.20,Default,,0,0,0,,Ұл балалар да қорқады, бірақ атмосфера қорқынышты.
Dialogue: 0,0:02:43.28,0:02:44.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:46.49,0:02:47.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:49.33,0:02:50.96,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:02:51.04,0:02:53.54,Default,,0,0,0,,Мен футбол үйірмесіне қосылдым.
Dialogue: 0,0:02:53.63,0:02:55.25,Default,,0,0,0,,ше? сонда не?
Dialogue: 0,0:02:55.34,0:02:59.72,Default,,0,0,0,,Сондықтан жаттығуға ерте барып, дайындалуым керек еді...
Dialogue: 0,0:02:59.80,0:03:03.43,Default,,0,0,0,,Менің әжем бір жылдан бері ауыр халде.
Dialogue: 0,0:03:03.51,0:03:06.35,Default,,0,0,0,,Бұл мүмкін емес, себебі сабақтан кейін сізге бару жоспарым бар.
Dialogue: 0,0:03:06.97,0:03:08.47,Default,,0,0,0,,Түсіндіңіз бе? иә?
Dialogue: 0,0:03:08.56,0:03:09.48,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:03:09.56,0:03:12.73,Default,,0,0,0,,Чикаконың әжесі кеше шуылдады.
Dialogue: 0,0:03:12.81,0:03:14.73,Default,,0,0,0,,1 жылдан бері ауыр жағдайдасыз.
Dialogue: 0,0:03:15.36,0:03:19.24,Default,,0,0,0,,Менің өмірімде ондай адаммен айналысуға бос уақытым жетпейді.
Dialogue: 0,0:03:19.32,0:03:21.82,Default,,0,0,0,,Ахахаха... аа
Dialogue: 0,0:03:21.91,0:03:23.74,Default,,0,0,0,,Мм... барлығы.
Dialogue: 0,0:03:23.82,0:03:24.37,Default,,0,0,0,,Дория
Dialogue: 0,0:03:24.37,0:03:25.24,Default,,0,0,0,,Дория
Dialogue: 0,0:03:24.37,0:03:25.24,Default,,0,0,0,,Дұрыстап тазалаңыз.
Dialogue: 0,0:03:25.24,0:03:25.33,Default,,0,0,0,,Дұрыстап тазалаңыз.
Dialogue: 0,0:03:25.33,0:03:26.74,Default,,0,0,0,,Дұрыстап тазалаңыз.
Dialogue: 0,0:03:25.33,0:03:26.74,Default,,0,0,0,,Әй.
Dialogue: 0,0:03:26.83,0:03:27.83,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:27.91,0:03:29.00,Default,,0,0,0,,Няро, ауырып тұр
Dialogue: 0,0:03:29.79,0:03:31.58,Default,,0,0,0,,Дұрыс істе!
Dialogue: 0,0:03:31.66,0:03:32.58,Default,,0,0,0,,Тағы бір доп
Dialogue: 0,0:03:32.67,0:03:34.75,Default,,0,0,0,,Пи келесі жолы 160км
Dialogue: 0,0:03:34.83,0:03:37.25,Default,,0,0,0,,А... анау жігіттер.
Dialogue: 0,0:03:38.21,0:03:41.09,Default,,0,0,0,,Не? Анау шұбар
Dialogue: 0,0:03:41.72,0:03:44.76,Default,,0,0,0,,Мұндай жаратылысты қалай жасауға болады?
Dialogue: 0,0:03:44.84,0:03:46.55,Default,,0,0,0,,Қасиетті ғибадатхана~ Фай! О!
Dialogue: 0,0:03:46.64,0:03:48.43,Default,,0,0,0,,Фай о! Фай о!
Dialogue: 0,0:03:48.51,0:03:52.27,Default,,0,0,0,,Қасиетті ғибадатхана~ Фай! О! Фай о! Фай о!
Dialogue: 0,0:03:52.35,0:03:54.77,Default,,0,0,0,,(мүшелердің айқайы)
Dialogue: 0,0:03:56.36,0:03:58.27,Default,,0,0,0,,Хмм, Казама!
Dialogue: 0,0:04:00.11,0:04:01.28,Default,,0,0,0,,Әй
Dialogue: 0,0:04:02.74,0:04:04.03,Default,,0,0,0,,Иә
Dialogue: 0,0:04:04.11,0:04:04.95,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:06.03,0:04:07.24,Default,,0,0,0,,(атылған дыбыс)
Dialogue: 0,0:04:09.45,0:04:12.46,Default,,0,0,0,,Хмм, Казама жақсы болған сияқты.
Dialogue: 0,0:04:12.54,0:04:15.46,Default,,0,0,0,,Чит (Казама) Кассано-сенпай жақсы пас
Dialogue: 0,0:04:15.54,0:04:16.88,Default,,0,0,0,,Өйткені есіктің арғы жағында жалаңаш қыз тұр.
Dialogue: 0,0:04:16.96,0:04:19.38,Default,,0,0,0,,Сіз шынымен де бізбен құрдассыз ба?
Dialogue: 0,0:04:19.46,0:04:21.71,Default,,0,0,0,,Шүкір, мен де сондаймын...
Dialogue: 0,0:04:21.80,0:04:24.22,Default,,0,0,0,,Кәне, сыртқы шеңберді тез бітірейік.
Dialogue: 0,0:04:24.30,0:04:26.51,Default,,0,0,0,,Сейсеки~ Фай! О!
Dialogue: 0,0:04:26.59,0:04:30.72,Default,,0,0,0,,Фай о! Фай о! Сейсеки~ Фай! О!
Dialogue: 0,0:04:33.23,0:04:37.48,Default,,0,0,0,,(ат құйрықтың ауыр тыныс алуы)
Dialogue: 0,0:04:37.56,0:04:38.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:38.48,0:04:40.90,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:40.98,0:04:45.15,Default,,0,0,0,,Не? Неліктен ол таңертеңнен бері жүгірді?
Dialogue: 0,0:04:45.24,0:04:47.91,Default,,0,0,0,,Мен футбол үйірмесіне қосылдым.
Dialogue: 0,0:04:49.41,0:04:50.70,Default,,0,0,0,,О
Dialogue: 0,0:04:52.00,0:04:55.67,Default,,0,0,0,,(Ат құйрығының ауыр тыныс алуы)
Dialogue: 0,0:04:56.96,0:04:58.42,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:59.75,0:05:01.00,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:01.09,0:05:03.17,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:03.26,0:05:05.84,Default,,0,0,0,,Иә? Чикако бүгін ерте
Dialogue: 0,0:05:05.93,0:05:07.18,Default,,0,0,0,,Маған тәттілер беріңізші.
Dialogue: 0,0:05:07.26,0:05:08.85,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:08.93,0:05:12.02,Default,,0,0,0,,Мен де ерте келе аламын.
Dialogue: 0,0:05:12.10,0:05:12.93,Default,,0,0,0,,Ах
Dialogue: 0,0:05:16.35,0:05:17.19,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:17.27,0:05:19.48,Default,,0,0,0,,Иә? Мен бұл оның екеніне сенімдімін ...
Dialogue: 0,0:05:19.56,0:05:20.77,Default,,0,0,0,,Бұл Эмото ма?
Dialogue: 0,0:05:20.86,0:05:23.23,Default,,0,0,0,,(Ат құйрықтың ауыр тыныс алуы)
Dialogue: 0,0:05:23.32,0:05:25.28,Default,,0,0,0,,Мен олардың түнде жүгіргенін де көрдім.
Dialogue: 0,0:05:25.36,0:05:28.78,Default,,0,0,0,,Айтпақшы, біздің футбол клубы мықты ғой, солай емес пе?
Dialogue: 0,0:05:28.87,0:05:30.24,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:30.33,0:05:32.95,Default,,0,0,0,,Мен ұлттық құрылтайда талай рет болдым.
Dialogue: 0,0:05:33.04,0:05:36.04,Default,,0,0,0,,Томоның сүйікті Казамасы да футбол клубына жатады, солай ма?
Dialogue: 0,0:05:36.12,0:05:37.54,Default,,0,0,0,,Тоқта, хехе
Dialogue: 0,0:05:38.17,0:05:40.88,Default,,0,0,0,,Бірақ Эмотоның қозғалыс сезімі жоқ, солай ма?
Dialogue: 0,0:05:40.96,0:05:42.30,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:05:42.38,0:05:44.34,Default,,0,0,0,,Сонда сіз шарасыз ба?
Dialogue: 0,0:05:44.42,0:05:46.30,Default,,0,0,0,,Бірақ бұл мүмкін емес емес пе?
Dialogue: 0,0:05:48.43,0:05:49.43,Default,,0,0,0,,Хун
Dialogue: 0,0:05:51.26,0:05:53.93,Default,,0,0,0,,Бүгін кешігіп келу себебі неде?
Dialogue: 0,0:05:54.02,0:05:56.52,Default,,0,0,0,,Вокзалда қиындыққа тап болған кемпір болды.
Dialogue: 0,0:05:56.60,0:05:58.98,Default,,0,0,0,,Сіз қаншалықты мазасыз, әже?
Dialogue: 0,0:05:59.06,0:06:03.44,Default,,0,0,0,,Бүгін рас, сондықтан мен кемпірді көтеріп алдым...
Dialogue: 0,0:06:03.52,0:06:05.61,Default,,0,0,0,,Қараңдаршы, мына бұлшықеттермен
Dialogue: 0,0:06:05.69,0:06:06.69,Default,,0,0,0,,Ай!
Dialogue: 0,0:06:06.78,0:06:07.78,Default,,0,0,0,,Әй, тыныш бол.
Dialogue: 0,0:06:07.86,0:06:08.57,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:08.57,0:06:09.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:08.57,0:06:09.53,Default,,0,0,0,,Казама: Жарайды, отыр, киін.
Dialogue: 0,0:06:09.53,0:06:09.61,Default,,0,0,0,,Казама: Жарайды, отыр, киін.
Dialogue: 0,0:06:09.61,0:06:10.78,Default,,0,0,0,,Казама: Жарайды, отыр, киін.
Dialogue: 0,0:06:09.61,0:06:10.78,Default,,0,0,0,,Өтірік
Dialogue: 0,0:06:10.78,0:06:11.45,Default,,0,0,0,,Казама: Жарайды, отыр, киін.
Dialogue: 0,0:06:11.53,0:06:13.95,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:15.20,0:06:17.46,Default,,0,0,0,,Казама бөтен адам
Dialogue: 0,0:06:17.54,0:06:22.42,Default,,0,0,0,,Төңкерілсең де, Қазамадай болмайсың.
Dialogue: 0,0:06:23.09,0:06:25.17,Default,,0,0,0,,Неге маған ешкім айтпайды?
Dialogue: 0,0:06:26.09,0:06:29.43,Default,,0,0,0,,Ерте бергеніңіз жақсы.
Dialogue: 0,0:06:32.01,0:06:34.22,Default,,0,0,0,,Уау, тырнақ дәмді екен
Dialogue: 0,0:06:34.31,0:06:36.64,Default,,0,0,0,,Ол шаштараздың қызы ғой.
Dialogue: 0,0:06:36.72,0:06:38.23,Default,,0,0,0,,Келесі I
Dialogue: 0,0:06:38.31,0:06:41.31,Default,,0,0,0,,Отбасылық мейрамханада толық емес жұмыс күні, солай ма? Сіз ашуланбайсыз ба?
Dialogue: 0,0:06:41.40,0:06:42.48,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:06:43.40,0:06:46.69,Default,,0,0,0,,Мен сияқты өмірден ләззат алыңыз
Dialogue: 0,0:06:46.78,0:06:48.07,Default,,0,0,0,,(Ат құйрығының ауыр тыныс алуы)
Dialogue: 0,0:06:48.07,0:06:48.99,Default,,0,0,0,,(Ат құйрықтың ауыр тыныс алуы)
Dialogue: 0,0:06:48.07,0:06:48.99,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:48.99,0:06:51.74,Default,,0,0,0,,(Ат құйрығының ауыр тыныс алуы)
Dialogue: 0,0:06:51.82,0:06:53.87,Default,,0,0,0,,Убуката мырза
Dialogue: 0,0:06:54.45,0:06:55.99,Default,,0,0,0,,Әжеге қонаққа бару
Dialogue: 0,0:06:56.95,0:06:57.91,Default,,0,0,0,,Эй, Казаманың бұлшық еттері ғажап еді.
Dialogue: 0,0:06:57.91,0:06:58.91,Default,,0,0,0,,Ей, Казаманың бұлшық еттері керемет еді.
Dialogue: 0,0:06:57.91,0:06:58.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:58.91,0:06:59.66,Default,,0,0,0,,Ей, Казаманың бұлшық еттері керемет еді.
Dialogue: 0,0:07:00.37,0:07:01.96,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:07:02.04,0:07:05.55,Default,,0,0,0,,Кешіріңіз, бәрі... Ах!
Dialogue: 0,0:07:05.63,0:07:11.47,Default,,0,0,0,,Эмото, сіз жеңілген, сәтсіздікке ұшыраған және үлкен ақымақсыз.
Dialogue: 0,0:07:16.81,0:07:17.47,Default,,0,0,0,,Ой, қарағым, мынау сүйкімді емес пе?
Dialogue: 0,0:07:17.47,0:07:19.02,Default,,0,0,0,,Әй, қарағым, бұл сондай сүйкімді емес пе?
Dialogue: 0,0:07:17.47,0:07:19.02,Default,,0,0,0,,Маған бәрібір...
Dialogue: 0,0:07:19.02,0:07:19.10,Default,,0,0,0,,Маған бәрібір...
Dialogue: 0,0:07:19.10,0:07:19.93,Default,,0,0,0,,Маған бәрібір...
Dialogue: 0,0:07:19.10,0:07:19.93,Default,,0,0,0,,Иә
Dialogue: 0,0:07:20.02,0:07:20.73,Default,,0,0,0,,(Риканың сөйлейтін дауысы)
Dialogue: 0,0:07:20.73,0:07:22.94,Default,,0,0,0,,(Риканың сөйлейтін дауысы)
Dialogue: 0,0:07:20.73,0:07:22.94,Default,,0,0,0,,Ақырында ол түсінеді
Dialogue: 0,0:07:23.52,0:07:25.69,Default,,0,0,0,,(Ат құйрықтың ауыр тыныс алуы)
Dialogue: 0,0:07:26.69,0:07:29.32,Default,,0,0,0,,Егер сіз өте ақымақ ақымақ болмасаңыз.
Dialogue: 0,0:07:31.53,0:07:33.45,Default,,0,0,0,,(Ат құйрықтың ауыр тыныс алуы)
Dialogue: 0,0:07:33.53,0:07:35.87,Default,,0,0,0,,Бұл өте ақымақ болды ма?
Dialogue: 0,0:07:35.95,0:07:37.74,Default,,0,0,0,,Чикако, не болды?
Dialogue: 0,0:07:37.83,0:07:40.20,Default,,0,0,0,,Таңертеңнен бері осылай.
Dialogue: 0,0:07:41.29,0:07:42.75,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:07:42.83,0:07:43.79,Default,,0,0,0,,Бару...
Dialogue: 0,0:07:43.88,0:07:44.71,Default,,0,0,0,,Қайда?
Dialogue: 0,0:07:44.79,0:07:49.71,Default,,0,0,0,,(Ат құйрықтың ауыр тыныс алуы)
Dialogue: 0,0:07:52.09,0:07:53.22,Default,,0,0,0,,Ах
Dialogue: 0,0:07:54.39,0:07:56.22,Default,,0,0,0,,Убуката мырза?
Dialogue: 0,0:07:56.30,0:07:57.72,Default,,0,0,0,,Эмото
Dialogue: 0,0:07:57.81,0:07:59.97,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:08:00.06,0:08:02.89,Default,,0,0,0,,Сіздің өмір жолыңыз дұрыс емес.
Dialogue: 0,0:08:02.98,0:08:06.48,Default,,0,0,0,,Ум, м, қайда?
Dialogue: 0,0:08:06.56,0:08:08.86,Default,,0,0,0,,Өз жағдайыңызды біліңіз
Dialogue: 0,0:08:08.94,0:08:12.24,Default,,0,0,0,,Сыныптағылардың бәрі саған күлетінін түсінбейсің бе?
Dialogue: 0,0:08:12.32,0:08:14.24,Default,,0,0,0,,Міне, дәл осылай мүлдем әлсіз болу дегенді айтады, иә, Польнарефф?
Dialogue: 0,0:08:14.32,0:08:17.07,Default,,0,0,0,,Қанша тырыссаң да,
Dialogue: 0,0:08:17.16,0:08:18.37,Default,,0,0,0,,Казама болуы мүмкін емес
Dialogue: 0,0:08:18.45,0:08:19.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:19.83,0:08:22.58,Default,,0,0,0,,Бұл 100% анықталған.
Dialogue: 0,0:08:22.66,0:08:25.17,Default,,0,0,0,,Бұл дүниеге келген кезде
Dialogue: 0,0:08:25.25,0:08:28.13,Default,,0,0,0,,Сіз Линкольн немесе Билл Гейтс бола алмайсыз.
Dialogue: 0,0:08:28.75,0:08:31.46,Default,,0,0,0,,Қозғалтқыш жүйкелеріңіз өте нашар.
Dialogue: 0,0:08:31.55,0:08:33.67,Default,,0,0,0,,Футбол әрине мүмкін емес.
Dialogue: 0,0:08:33.76,0:08:37.64,Default,,0,0,0,,Тым ақымақ, тым ебедейсіз, тым ақымақ
Dialogue: 0,0:08:37.72,0:08:41.43,Default,,0,0,0,,Біліңіз! Футбол ойнауды тоқтату керек
Dialogue: 0,0:08:41.52,0:08:44.14,Default,,0,0,0,,Оған тұрарлық басқа жолды іздеңіз.
Dialogue: 0,0:08:44.23,0:08:45.94,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:47.48,0:08:48.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.73,0:08:54.95,Default,,0,0,0,,Тек мейірімділік танытып, сізге хабарлау.
Dialogue: 0,0:08:55.57,0:08:56.41,Default,,0,0,0,,Умм
Dialogue: 0,0:08:57.95,0:09:00.87,Default,,0,0,0,,Сізге көп рахмет. Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:09:00.95,0:09:01.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:03.62,0:09:06.96,Default,,0,0,0,,Ал... мүлде өтпей жатыр.
Dialogue: 0,0:09:08.38,0:09:10.46,Default,,0,0,0,,Қасиетті ғибадатхана~ Фай~
Dialogue: 0,0:09:10.55,0:09:14.55,Default,,0,0,0,,Фай о~ Фай о~ Қасиетті ғибадатхана~ о...
Dialogue: 0,0:09:14.63,0:09:19.68,Default,,0,0,0,,(мүшелердің ауыр тыныс алуы)
Dialogue: 0,0:09:19.76,0:09:21.51,Default,,0,0,0,,А, мен шаршадым.
Dialogue: 0,0:09:21.60,0:09:22.56,Default,,0,0,0,,Жоспар
Dialogue: 0,0:09:22.64,0:09:24.68,Default,,0,0,0,,Сіз жүгірмейсіз, солай ма?
Dialogue: 0,0:09:24.77,0:09:27.06,Default,,0,0,0,,Жаңбыр жауып тұр, сондықтан бүгінгі күн аяқталды
Dialogue: 0,0:09:27.90,0:09:32.40,Default,,0,0,0,,Эй Эмото, сен неге күнде жаттығуға кешігіп келесің?
Dialogue: 0,0:09:32.48,0:09:33.90,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:09:33.99,0:09:37.20,Default,,0,0,0,,Ол күнде таңертең жүгіреді. Бұл оның кешіккенінің жазасы емес пе?
Dialogue: 0,0:09:37.28,0:09:38.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:38.49,0:09:42.41,Default,,0,0,0,,Ой, сабақтан кейін тазалық бар дегені есімде.
Dialogue: 0,0:09:42.49,0:09:43.95,Default,,0,0,0,,ше? Бұл не?
Dialogue: 0,0:09:44.04,0:09:46.62,Default,,0,0,0,,Мен осылай босаңсысам деп едім.
Dialogue: 0,0:09:46.71,0:09:48.46,Default,,0,0,0,,Бұл Эмото сияқты.
Dialogue: 0,0:09:48.54,0:09:50.17,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:09:50.25,0:09:51.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:51.17,0:09:54.21,Default,,0,0,0,,Эмото: Ол күнде кешігіп келеді.
Dialogue: 0,0:09:54.30,0:09:55.51,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:09:55.59,0:09:57.80,Default,,0,0,0,,Казама, сен білмедің бе?
Dialogue: 0,0:09:57.88,0:09:58.72,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:58.80,0:10:00.97,Default,,0,0,0,,Ум, қайсысы?
Dialogue: 0,0:10:01.05,0:10:02.93,Default,,0,0,0,,Сол сыныптағы кір жуғыш тақта
Dialogue: 0,0:10:03.01,0:10:04.97,Default,,0,0,0,,Кітап қайда? (Казама) Гуа!
Dialogue: 0,0:10:05.06,0:10:07.02,Default,,0,0,0,,Ал... әлі де жүгіруде
Dialogue: 0,0:10:07.10,0:10:09.19,Default,,0,0,0,,Қайда? (Накиджин және т.б.) Бұл сыртқы периферия!
Dialogue: 0,0:10:09.27,0:10:12.69,Default,,0,0,0,,(Ат құйрықтың ауыр тыныс алуы)
Dialogue: 0,0:10:12.77,0:10:17.95,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:10:23.03,0:10:25.62,Default,,0,0,0,,Шынымен не? Бұл не?
Dialogue: 0,0:10:25.70,0:10:28.91,Default,,0,0,0,,Бұл жиіркенішті. Бұл жиіркенішті. Бұл менің кінәм деп айта аласыз.
Dialogue: 0,0:10:29.00,0:10:31.46,Default,,0,0,0,,Әй, тітіркеніп кетсең, жасама!
Dialogue: 0,0:10:31.54,0:10:34.30,Default,,0,0,0,,Ха ха ха ха... (Убуката) Эмото!
Dialogue: 0,0:10:34.38,0:10:36.42,Default,,0,0,0,,Иә, кешіріңіз
Dialogue: 0,0:10:36.51,0:10:38.51,Default,,0,0,0,,Сәлем Эмото!
Dialogue: 0,0:10:38.59,0:10:41.47,Default,,0,0,0,,Иә? Убукатаның дауысы...
Dialogue: 0,0:10:42.18,0:10:43.72,Default,,0,0,0,,Есту галлюцинациялары...
Dialogue: 0,0:10:44.31,0:10:45.31,Default,,0,0,0,,Сәлем Эмото!
Dialogue: 0,0:10:45.39,0:10:47.73,Default,,0,0,0,,О, не? Шынайы ма?
Dialogue: 0,0:10:47.81,0:10:50.94,Default,,0,0,0,,Неге мені жаза ретінде жүгіруге мәжбүрлейтініңді айтпадың?
Dialogue: 0,0:10:51.02,0:10:52.73,Default,,0,0,0,,Не? Не айтқың келеді?
Dialogue: 0,0:10:52.81,0:10:55.86,Default,,0,0,0,,Менің кесірімнен үйірме жұмыстарына кешігіп қалдың.
Dialogue: 0,0:10:55.94,0:10:57.40,Default,,0,0,0,,Сен Қазамаға да айтпадың.
Dialogue: 0,0:10:57.49,0:10:58.74,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:10:58.82,0:11:02.24,Default,,0,0,0,,«Иә», неге сонша ақымақтықпен жазаланып отырсың?
Dialogue: 0,0:11:02.32,0:11:03.16,Default,,0,0,0,,Иә
Dialogue: 0,0:11:03.24,0:11:05.12,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:05.62,0:11:06.62,Default,,0,0,0,,Ах
Dialogue: 0,0:11:07.24,0:11:09.58,Default,,0,0,0,,Мені мұндай нәрсе қызықтырмайды.
Dialogue: 0,0:11:10.46,0:11:13.63,Default,,0,0,0,,Бірақ мен қарасам ашуланамын.
Dialogue: 0,0:11:13.71,0:11:15.09,Default,,0,0,0,,Сіз білмейсіз
Dialogue: 0,0:11:16.09,0:11:18.09,Default,,0,0,0,,Ойланудан қорқу
Dialogue: 0,0:11:18.17,0:11:21.30,Default,,0,0,0,,Жете алмағандағы көңілі қалу
Dialogue: 0,0:11:21.97,0:11:23.97,Default,,0,0,0,,Неге дұрыс сылтау таппайсың?
Dialogue: 0,0:11:24.05,0:11:26.26,Default,,0,0,0,,Сіз көріктендіру комитетінің мүшесі ретінде жұмысыңызды тоқтата аласыз.
Dialogue: 0,0:11:26.93,0:11:29.43,Default,,0,0,0,,Адалдық қасиет пе? Солай емес пе?
Dialogue: 0,0:11:30.35,0:11:34.02,Default,,0,0,0,,Басыңызды пайдаланып өмір сүріңіз! «Үш патшалықтың романтикасын» оқыңыз!
Dialogue: 0,0:11:34.65,0:11:38.11,Default,,0,0,0,,Убуката мырза ақылды, солай емес пе?
Dialogue: 0,0:11:38.19,0:11:40.74,Default,,0,0,0,,Не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:11:40.82,0:11:41.70,Default,,0,0,0,,Уф
Dialogue: 0,0:11:42.28,0:11:46.20,Default,,0,0,0,,Сонымен... Бірақ менің қолымнан келгені осы ғана.
Dialogue: 0,0:11:46.28,0:11:48.41,Default,,0,0,0,,Ендеше сен мені тыңда...
Dialogue: 0,0:11:48.49,0:11:50.87,Default,,0,0,0,,Мен оны бірінші рет таптым (Убуката) Ах.
Dialogue: 0,0:11:50.96,0:11:53.50,Default,,0,0,0,,Мен оны шындап көргім келеді!
Dialogue: 0,0:11:54.46,0:11:59.46,Default,,0,0,0,,Убуката мырзаның айтқанының бәрі дұрыс шығар.
Dialogue: 0,0:11:59.55,0:12:04.39,Default,,0,0,0,,Мен мұның бәрін қате істеп жатқан шығармын.
Dialogue: 0,0:12:05.14,0:12:11.06,Default,,0,0,0,,Өйткені мен қарапайым, ақымақ және түкке тұрғысыз екенімді білемін.
Dialogue: 0,0:12:11.14,0:12:13.64,Default,,0,0,0,,Бірақ... сондықтан...
Dialogue: 0,0:12:14.73,0:12:19.15,Default,,0,0,0,,Өмірімді қатерге тігіп өмір сүргім келеді!
Dialogue: 0,0:12:20.90,0:12:23.86,Default,,0,0,0,,Канеки
Dialogue: 0,0:12:24.45,0:12:26.41,Default,,0,0,0,,Бұл жігіт неге сонша ренжіді?
Dialogue: 0,0:12:30.29,0:12:33.79,Default,,0,0,0,,Адал және ақымақ өмір сүруді жалғастыру ...
Dialogue: 0,0:12:33.87,0:12:37.71,Default,,0,0,0,,Мен бұл жігіттің шығынға ұшырайтынына сенімдімін.
Dialogue: 0,0:12:37.79,0:12:41.96,Default,,0,0,0,,Бірақ ақиқат, бәрі осылай өмір сүргісі келеді.
Dialogue: 0,0:12:43.05,0:12:45.59,Default,,0,0,0,,Мен дұрыс емес өмір сүргім келеді
Dialogue: 0,0:12:46.47,0:12:49.97,Default,,0,0,0,,Бірақ әдетте олар мұны істей алмайды; олар ренжіп, бас тартады.
Dialogue: 0,0:12:51.89,0:12:54.98,Default,,0,0,0,,Сонда сен бәрін ұмытасың
Dialogue: 0,0:12:56.90,0:12:59.27,Default,,0,0,0,,Міне, адамның өсуі.
Dialogue: 0,0:13:00.44,0:13:01.94,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:13:12.70,0:13:14.75,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:13:14.83,0:13:15.37,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:13:15.37,0:13:16.21,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:13:15.37,0:13:16.21,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:17.79,0:13:18.38,Default,,0,0,0,,Қайтадан қош келдіңіз! Ванна қайнап жатыр, Чикако.
Dialogue: 0,0:13:18.38,0:13:19.38,Default,,0,0,0,,Қайтадан қош келдіңіз! Ванна қайнап жатыр, Чикако.
Dialogue: 0,0:13:18.38,0:13:19.38,Default,,0,0,0,,Ах
Dialogue: 0,0:13:19.38,0:13:20.13,Default,,0,0,0,,Қайтадан қош келдіңіз! Ванна қайнап жатыр, Чикако.
Dialogue: 0,0:13:20.13,0:13:21.09,Default,,0,0,0,,Қайтадан қош келдіңіз! Ванна қайнап жатыр, Чикако.
Dialogue: 0,0:13:20.13,0:13:21.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:21.84,0:13:23.59,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:13:25.05,0:13:27.72,Default,,0,0,0,,Бұл шынайы өсім емес.
Dialogue: 0,0:13:29.85,0:13:34.60,Default,,0,0,0,,Қарапайым және мағынасыз? Жоқ, бұл дұрыс емес.
Dialogue: 0,0:13:38.90,0:13:43.03,Default,,0,0,0,,Сен ерекшесің, ақымақ.
Dialogue: 0,0:13:53.95,0:13:56.37,Default,,0,0,0,,(мүшелердің айқайы)
Dialogue: 0,0:14:00.54,0:14:02.09,Default,,0,0,0,,Inter-High мүшесі болудың уақыты келді.
Dialogue: 0,0:14:02.17,0:14:03.71,Default,,0,0,0,,Шешетін кез келді
Dialogue: 0,0:14:03.80,0:14:04.63,Default,,0,0,0,,О
Dialogue: 0,0:14:05.26,0:14:08.38,Default,,0,0,0,,Бір капитан ваннада аяғын сындырып алды.
Dialogue: 0,0:14:08.47,0:14:09.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:08.47,0:14:09.47,Default,,0,0,0,,(Сүйектер дыбысы)
Dialogue: 0,0:14:09.55,0:14:13.26,Default,,0,0,0,,Оның шыға алмау мүмкіндігін қарастыруымыз керек.
Dialogue: 0,0:14:13.35,0:14:15.43,Default,,0,0,0,,Хаа (Наказава) Бұл сен туралы.
Dialogue: 0,0:14:15.52,0:14:17.98,Default,,0,0,0,,Не, мен шыға алмаймын ба?
Dialogue: 0,0:14:18.85,0:14:21.98,Default,,0,0,0,,Мен матчқа қатыса алмаймын...
Dialogue: 0,0:14:25.40,0:14:26.24,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:28.70,0:14:29.70,Default,,0,0,0,,Иә
Dialogue: 0,0:14:30.28,0:14:32.24,Default,,0,0,0,,Цк, эй, допты ал.
Dialogue: 0,0:14:32.32,0:14:35.16,Default,,0,0,0,,О? Барып, мына ақымақ баклажанды алыңыз.
Dialogue: 0,0:14:35.24,0:14:37.12,Default,,0,0,0,,Не? Ақымақ
Dialogue: 0,0:14:37.20,0:14:38.37,Default,,0,0,0,,Шулы
Dialogue: 0,0:14:38.46,0:14:39.83,Default,,0,0,0,,(Ханзада мен Ошиба арасындағы даулардың дауыстары)
Dialogue: 0,0:14:39.83,0:14:42.38,Default,,0,0,0,,(Ханзада мен Ошиба арасындағы даулардың дауыстары)
Dialogue: 0,0:14:39.83,0:14:42.38,Default,,0,0,0,,Иә Иә Иә Әм...
Dialogue: 0,0:14:48.80,0:14:50.97,Default,,0,0,0,,Ммм (Хайасе) Ой, шіркін~
Dialogue: 0,0:14:51.05,0:14:53.35,Default,,0,0,0,,Менің ойымша, бұл Усуй Ня.
Dialogue: 0,0:14:53.43,0:14:56.56,Default,,0,0,0,,Жоқ, бұл қауіпті болды. Мен озып кетем деп ойладым.
Dialogue: 0,0:14:56.64,0:14:58.02,Default,,0,0,0,,Өтірікші!
Dialogue: 0,0:14:59.56,0:15:00.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:03.36,0:15:05.27,Default,,0,0,0,,Өзімді жоғалтып алған сияқтымын.
Dialogue: 0,0:15:05.36,0:15:06.28,Default,,0,0,0,,Уау
Dialogue: 0,0:15:08.15,0:15:10.53,Default,,0,0,0,,Мені тоқтатпақ болғаныңызға 10 жыл болды.
Dialogue: 0,0:15:12.32,0:15:14.33,Default,,0,0,0,,Оны қалай тоқтатуға болады?
Dialogue: 0,0:15:14.41,0:15:16.70,Default,,0,0,0,,Сондықтан 10 жыл ерте.
Dialogue: 0,0:15:16.79,0:15:18.29,Default,,0,0,0,,Сәлем, Курусу
Dialogue: 0,0:15:18.37,0:15:21.96,Default,,0,0,0,,Қазірдің өзінде мен жаңадан бастағандарға қарсы бұрынғыдай мақтанамын.
Dialogue: 0,0:15:22.04,0:15:23.58,Default,,0,0,0,,Сіз жетілмегенсіз.
Dialogue: 0,0:15:23.67,0:15:24.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:24.96,0:15:26.88,Default,,0,0,0,,Сіз тым адалсыз.
Dialogue: 0,0:15:26.96,0:15:30.05,Default,,0,0,0,,Аяқпен ұрып-соғып, ұсталып қаласыз.
Dialogue: 0,0:15:30.13,0:15:32.30,Default,,0,0,0,,Сен оңай алданатын түріңсің.
Dialogue: 0,0:15:32.38,0:15:35.14,Default,,0,0,0,,Ал, алданудан қалай аулақ бола аламын?
Dialogue: 0,0:15:35.22,0:15:37.14,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:15:38.81,0:15:40.64,Default,,0,0,0,,Өзің ойла, Барса!
Dialogue: 0,0:15:40.73,0:15:42.39,Default,,0,0,0,,Иә, а, а...
Dialogue: 0,0:15:42.48,0:15:43.85,Default,,0,0,0,,Хмм... О!
Dialogue: 0,0:15:45.06,0:15:47.11,Default,,0,0,0,,Бұл жерде көңілді көрінеді.
Dialogue: 0,0:15:54.16,0:15:55.57,Default,,0,0,0,,Қайырлы таң...
Dialogue: 0,0:15:55.66,0:15:59.41,Default,,0,0,0,,А, бұл дұрыс болды. Эмото, мен қауын нан сатып алдым.
Dialogue: 0,0:15:59.50,0:16:01.75,Default,,0,0,0,,Рахмет... және кілегей нан...
Dialogue: 0,0:16:01.83,0:16:03.62,Default,,0,0,0,,Шоколад чипсы да құпталады.
Dialogue: 0,0:16:03.71,0:16:07.09,Default,,0,0,0,,Кеттік! Асықпасаңыз, сатылып кетеді
Dialogue: 0,0:16:07.17,0:16:08.38,Default,,0,0,0,,Танысқаныма қуаныштымын~
Dialogue: 0,0:16:08.46,0:16:09.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:10.05,0:16:11.38,Default,,0,0,0,,Мен шынымды айтамын.
Dialogue: 0,0:16:11.47,0:16:12.59,Default,,0,0,0,,Бұл ыңғайлы~
Dialogue: 0,0:16:12.68,0:16:13.93,Default,,0,0,0,,Бұл аңғал.
Dialogue: 0,0:16:14.01,0:16:15.34,Default,,0,0,0,,Гучоку дегеніміз не?
Dialogue: 0,0:16:15.43,0:16:17.76,Default,,0,0,0,,Сіз мұны білмейсіз бе? Бұл қиын емес пе?
Dialogue: 0,0:16:17.85,0:16:20.31,Default,,0,0,0,,Цк Эмотоның бейбақы
Dialogue: 0,0:16:24.85,0:16:27.19,Default,,0,0,0,,Әй, кетті!
Dialogue: 0,0:16:28.40,0:16:30.69,Default,,0,0,0,,Қарашы, Чикако (Убуката)?
Dialogue: 0,0:16:30.78,0:16:33.03,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:33.11,0:16:37.24,Default,,0,0,0,,Эй, Эмото, сен мықты футбол командасының мүшесімін дейсің.
Dialogue: 0,0:16:37.32,0:16:39.16,Default,,0,0,0,,Сіз шағымданасыз ба? Мұнда
Dialogue: 0,0:16:39.24,0:16:43.87,Default,,0,0,0,,Жоқ, мен спорт жейдесін ұмытып қалдым.
Dialogue: 0,0:16:44.54,0:16:46.13,Default,,0,0,0,,Бұл шын мәнінде футбол клубы.
Dialogue: 0,0:16:46.21,0:16:49.59,Default,,0,0,0,,Мен өзімді марафон клубындамын деп ойладым, өйткені мен үнемі жүгірдім.
Dialogue: 0,0:16:49.67,0:16:52.92,Default,,0,0,0,,Аа, футбол командасында Казама-куннан басқа біреу бар ма?
Dialogue: 0,0:16:53.01,0:16:55.63,Default,,0,0,0,,Жарайды, Казама-кун, бүгін тағы кешігіп қалдың.
Dialogue: 0,0:16:55.72,0:16:57.22,Default,,0,0,0,,Қара жейдедегі бала ма?
Dialogue: 0,0:16:57.30,0:16:59.89,Default,,0,0,0,,Футбол клубы күшті, солай ма?
Dialogue: 0,0:17:00.43,0:17:01.93,Default,,0,0,0,,Ол соншалықты үлкен болса да
Dialogue: 0,0:17:02.02,0:17:04.27,Default,,0,0,0,,Адамдар сыртқы түріне тәуелді емес.
Dialogue: 0,0:17:04.98,0:17:08.36,Default,,0,0,0,,Менің жейденің арқасында маған көп көңіл бөлінеді.
Dialogue: 0,0:17:08.44,0:17:09.86,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:17:10.23,0:17:10.65,Default,,0,0,0,,(Допты тепкен дыбысы)
Dialogue: 0,0:17:10.65,0:17:12.07,Default,,0,0,0,,(Допты тепкен дыбысы)
Dialogue: 0,0:17:10.65,0:17:12.07,Default,,0,0,0,,Эмото! Ах
Dialogue: 0,0:17:12.94,0:17:13.86,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:15.53,0:17:18.45,Default,,0,0,0,,Вау Йошида-кун дзюдо клубынан
Dialogue: 0,0:17:18.53,0:17:21.70,Default,,0,0,0,,Алып кетпе, қарғыс атқыр футбол клубы.
Dialogue: 0,0:17:21.79,0:17:23.16,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:24.25,0:17:25.87,Default,,0,0,0,,Ол шығарылды
Dialogue: 0,0:17:25.96,0:17:27.04,Default,,0,0,0,,шығарылды
Dialogue: 0,0:17:27.12,0:17:28.50,Default,,0,0,0,,Йошида-кун керемет
Dialogue: 0,0:17:31.59,0:17:32.42,Default,,0,0,0,,Уф (Ёшида) Уау
Dialogue: 0,0:17:32.50,0:17:33.38,Default,,0,0,0,,Ах
Dialogue: 0,0:17:33.46,0:17:34.42,Default,,0,0,0,,Тоқтады!
Dialogue: 0,0:17:34.51,0:17:35.92,Default,,0,0,0,,Сол жігіт мұны істейді.
Dialogue: 0,0:17:36.01,0:17:38.68,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:17:39.43,0:17:42.81,Default,,0,0,0,,Бұл кездейсоқтық! Бұл кездейсоқтық! Маған тез беріңізші!
Dialogue: 0,0:17:42.89,0:17:44.27,Default,,0,0,0,,Жоқ... уф
Dialogue: 0,0:17:45.10,0:17:46.89,Default,,0,0,0,,Эмото
Dialogue: 0,0:17:46.98,0:17:48.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:48.23,0:17:49.40,Default,,0,0,0,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,0:17:49.48,0:17:50.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:51.52,0:17:54.82,Default,,0,0,0,,Уау, таңқаларлық. Бұл шынымен Эмото ма?
Dialogue: 0,0:17:54.90,0:17:56.65,Default,,0,0,0,,Мен бұған дейін талай рет тоқтатқанмын.
Dialogue: 0,0:17:56.74,0:18:00.16,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:18:00.24,0:18:05.91,Default,,0,0,0,,Ха, ха, ха, алданып қалма, қарғыс атқыр Эмото.
Dialogue: 0,0:18:09.00,0:18:11.71,Default,,0,0,0,,Йошида-кун сол аяғын қолданбайды.
Dialogue: 0,0:18:11.79,0:18:13.92,Default,,0,0,0,,Мен допты оң аяғыммен ұстаймын.
Dialogue: 0,0:18:14.00,0:18:18.22,Default,,0,0,0,,Клубтың жай ғана доп ойнауына жол бермеңіз.
Dialogue: 0,0:18:18.30,0:18:19.18,Default,,0,0,0,,Ах
Dialogue: 0,0:18:19.26,0:18:21.30,Default,,0,0,0,,Оң жаққа қарау...
Dialogue: 0,0:18:21.39,0:18:22.22,Default,,0,0,0,,Әй
Dialogue: 0,0:18:22.30,0:18:23.93,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:18:24.81,0:18:27.06,Default,,0,0,0,,Керемет! Мен оны қайтадан тоқтаттым
Dialogue: 0,0:18:27.14,0:18:28.85,Default,,0,0,0,,Бұл…
Dialogue: 0,0:18:28.94,0:18:30.02,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:18:30.73,0:18:33.02,Default,,0,0,0,,Қат!
Dialogue: 0,0:18:33.65,0:18:35.32,Default,,0,0,0,,Күшпен және күшпен
Dialogue: 0,0:18:35.40,0:18:37.03,Default,,0,0,0,,Бұл мені таң қалдырады
Dialogue: 0,0:18:37.11,0:18:39.53,Default,,0,0,0,,Уф... Ой? иә?
Dialogue: 0,0:18:39.61,0:18:41.53,Default,,0,0,0,,Эмото Мен ұстап тұрмын.
Dialogue: 0,0:18:41.62,0:18:46.54,Default,,0,0,0,,Курусу-кунның қимылдары сияқты жылдам немесе күшті емес
Dialogue: 0,0:18:46.62,0:18:49.04,Default,,0,0,0,,Уф! (Йошида) Ах!
Dialogue: 0,0:18:52.67,0:18:54.42,Default,,0,0,0,,Мен аукционды ұтып алдым!
Dialogue: 0,0:18:54.50,0:18:56.34,Default,,0,0,0,,Жақсы! Шынайы ма?
Dialogue: 0,0:18:56.42,0:18:58.13,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:18:58.22,0:18:59.34,Default,,0,0,0,,Уф
Dialogue: 0,0:19:00.76,0:19:01.59,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:01.68,0:19:02.85,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:19:02.93,0:19:03.76,Default,,0,0,0,,Сіз оны толығымен түсіндіңіз!
Dialogue: 0,0:19:03.76,0:19:04.68,Default,,0,0,0,,Сіз оны толығымен түсіндіңіз!
Dialogue: 0,0:19:03.76,0:19:04.68,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:19:06.14,0:19:09.18,Default,,0,0,0,,Жоқ... жоқ.
Dialogue: 0,0:19:10.14,0:19:14.19,Default,,0,0,0,,(Цукуси мен Йошиданың қатты дауыстары)
Dialogue: 0,0:19:14.27,0:19:16.94,Default,,0,0,0,,Футбол клубындағы барлық адамдар...
Dialogue: 0,0:19:17.03,0:19:19.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:20.03,0:19:22.20,Default,,0,0,0,,Мен ойнамаймын.
Dialogue: 0,0:19:22.28,0:19:24.95,Default,,0,0,0,,Мына жігіт, ондай күшті қайдан алады...
Dialogue: 0,0:19:25.03,0:19:27.20,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:19:30.75,0:19:33.38,Default,,0,0,0,,Жарайды... Берілме, ақымақ!
Dialogue: 0,0:19:33.46,0:19:35.21,Default,,0,0,0,,Нууууууууу!
Dialogue: 0,0:19:36.50,0:19:38.42,Default,,0,0,0,,Иә? Чикако?
Dialogue: 0,0:19:38.51,0:19:40.42,Default,,0,0,0,,Шынайы ма? (Убуката) Ха!
Dialogue: 0,0:19:40.51,0:19:42.84,Default,,0,0,0,,Эмото-кун керемет!
Dialogue: 0,0:19:42.93,0:19:44.43,Default,,0,0,0,,Жасай бер, қыз!
Dialogue: 0,0:19:45.22,0:19:46.93,Default,,0,0,0,,Уф (Студент қыз) А, құладым.
Dialogue: 0,0:19:49.77,0:19:54.77,Default,,0,0,0,,(Қыз студенттер қолдайды)
Dialogue: 0,0:19:58.03,0:20:01.70,Default,,0,0,0,,Ха, сипап қойдым... Ах.
Dialogue: 0,0:20:01.78,0:20:04.95,Default,,0,0,0,,Убуката мырза, у...
Dialogue: 0,0:20:06.78,0:20:09.41,Default,,0,0,0,,Сіз өте батылдық таныттыңыз.
Dialogue: 0,0:20:14.71,0:20:15.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:22.84,0:20:23.97,Default,,0,0,0,,Бұл зейінімді басқа жаққа бұрады, сондықтан кетші.
Dialogue: 0,0:20:26.43,0:20:27.47,Default,,0,0,0,,Ах
Dialogue: 0,0:20:30.81,0:20:32.73,Default,,0,0,0,,Ах (Убуката) бірдеңе айт.
Dialogue: 0,0:20:35.06,0:20:36.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:40.73,0:20:43.74,Default,,0,0,0,,Уау! (Мұғалімдер) Уау!
Dialogue: 0,0:20:43.82,0:20:45.07,Default,,0,0,0,,Не?
Dialogue: 0,0:20:45.16,0:20:45.86,Default,,0,0,0,,Енді?
Dialogue: 0,0:20:45.86,0:20:46.57,Default,,0,0,0,,Енді?
Dialogue: 0,0:20:45.86,0:20:46.57,Default,,0,0,0,,Мен таң қалдым~
Dialogue: 0,0:20:46.57,0:20:47.24,Default,,0,0,0,,Мен таң қалдым~
Dialogue: 0,0:20:47.32,0:20:48.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:56.25,0:20:59.84,Default,,0,0,0,,Бүгіннен бастап мен көріктендіру комитетінің мүшесі ретінде де жұмыс істеймін.
Dialogue: 0,0:20:59.92,0:21:01.42,Default,,0,0,0,,Өйткені мен ешкімнің әлсіреуіне жол бермеймін
Dialogue: 0,0:21:01.51,0:21:03.51,Default,,0,0,0,,Жұмысты аяқтағаннан кейін үйірме жұмыстарына бару керек.
Dialogue: 0,0:21:03.59,0:21:04.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:04.51,0:21:07.51,Default,,0,0,0,,Мм... Убуката-сан, солай ма? Чикако
Dialogue: 0,0:21:07.59,0:21:08.76,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:21:08.85,0:21:11.43,Default,,0,0,0,,Мен мұны істеп жатқандықтан...
Dialogue: 0,0:21:13.23,0:21:14.85,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:15.69,0:21:16.73,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:21:16.73,0:21:18.69,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:21:16.73,0:21:18.69,Default,,0,0,0,,(қатты шу)
Dialogue: 0,0:21:18.69,0:21:19.56,Default,,0,0,0,,(қатты шу)
Dialogue: 0,0:21:19.56,0:21:20.40,Default,,0,0,0,,(қатты шу)
Dialogue: 0,0:21:19.56,0:21:20.40,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:26.53,0:21:29.07,Default,,0,0,0,,10 жыл Ерте дедім.
Dialogue: 0,0:21:31.91,0:21:33.08,Default,,0,0,0,,Е/Ж
Dialogue: 0,0:21:33.16,0:21:35.08,Default,,0,0,0,,О! Ах
Dialogue: 0,0:21:35.16,0:21:36.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:36.92,0:21:38.88,Default,,0,0,0,,О, Цукуси, мен естідім.
Dialogue: 0,0:21:38.96,0:21:42.34,Default,,0,0,0,,Убуката сізді қайтадан нан алуға мәжбүр етті ме?
Dialogue: 0,0:21:42.42,0:21:44.55,Default,,0,0,0,,Ах, бірақ бұл...
Dialogue: 0,0:21:44.63,0:21:46.09,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:21:46.17,0:21:49.14,Default,,0,0,0,,Ол кеуде қуысының тамақтануы басына түсетін тип.
Dialogue: 0,0:21:49.22,0:21:51.93,Default,,0,0,0,,Әңгімеңіз қаншалықты төмен болды?
Dialogue: 0,0:21:49.22,0:21:51.93,Default,,0,0,0,,(Қазаманың ыңырануы)
Dialogue: 0,0:21:51.93,0:21:52.01,Default,,0,0,0,,(Қазаманың ыңырануы)
Dialogue: 0,0:21:52.01,0:21:53.52,Default,,0,0,0,,(Қазаманың ыңырануы)
Dialogue: 0,0:21:52.01,0:21:53.52,Default,,0,0,0,,Немесе… Казама-кун
Dialogue: 0,0:21:55.18,0:21:57.77,Default,,0,0,0,,Ал, менде барлығына бір жаңалығым бар.
Dialogue: 0,0:21:58.85,0:22:01.15,Default,,0,0,0,,Менеджер кірді
Dialogue: 0,0:22:01.23,0:22:02.77,Default,,0,0,0,,Менің атым Чикако Убуката.
Dialogue: 0,0:22:02.86,0:22:04.78,Default,,0,0,0,,Га...
Dialogue: 0,0:22:04.86,0:22:06.11,Default,,0,0,0,,Айқай
Dialogue: 0,0:22:06.19,0:22:07.78,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:22:09.03,0:22:10.91,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:22:12.62,0:22:15.54,Default,,0,0,0,,Ах... ахах
Dialogue: 0,0:22:21.00,0:22:25.92,Default,,0,0,0,,♪～
Dialogue: 0,0:23:45.92,0:23:50.92,Default,,0,0,0,,～♪
Dialogue: 0,0:23:52.34,0:23:55.55,Default,,0,0,0,,Бір-екі күнде түзелмейтіні рас.
Dialogue: 0,0:23:55.64,0:24:00.64,Default,,0,0,0,,Бірақ егер сіз тіпті 1 мм жақсырақ болғыңыз келсе, соңғы сәтке дейін күрескіңіз келеді, солай емес пе?
Dialogue: 0,0:24:00.73,0:24:03.85,Default,,0,0,0,,Мүшелікке міндетті түрде сайланасың, Қасахара-сенпай.
