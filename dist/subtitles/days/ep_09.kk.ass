Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.46,0:00:03.71,Default,,0,0,0,,Бұл финал
Dialogue: 0,0:00:03.79,0:00:05.92,Default,,0,0,0,,Тағы бір жеңсек, ұлттық боламыз.
Dialogue: 0,0:00:06.54,0:00:08.67,Default,,0,0,0,,Егер күмәніңіз болса, шешімді маған қалдырыңыз
Dialogue: 0,0:00:08.75,0:00:11.67,Default,,0,0,0,,Оны басқа біреу үшін деп ойлаудың қажеті жоқ.
Dialogue: 0,0:00:11.76,0:00:14.93,Default,,0,0,0,,Өз мүддеңіз үшін әрекет етіңіз
Dialogue: 0,0:00:15.01,0:00:18.43,Default,,0,0,0,,Менің ойымша, бұл команда үшін пайдалы.
Dialogue: 0,0:00:18.51,0:00:20.64,Default,,0,0,0,,Менің философиям
Dialogue: 0,0:00:25.40,0:00:29.82,Default,,0,0,0,,Мен толық жауапкершілікті аламын. Қалағаныңды істе.
Dialogue: 0,0:00:32.65,0:00:37.07,Default,,0,0,0,,Қасиетті ғибадатхана! Фай!
Dialogue: 0,0:00:37.16,0:00:42.58,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:00:46.88,0:00:49.09,Default,,0,0,0,,Енді сөйлейік!
Dialogue: 0,0:00:49.17,0:00:52.34,Default,,0,0,0,,Қасиетті Сакрамент Фай! о!
Dialogue: 0,0:00:56.38,0:00:58.51,Default,,0,0,0,,Сәттілік Казама-кун
Dialogue: 0,0:00:58.60,0:00:59.60,Default,,0,0,0,,О
Dialogue: 0,0:00:59.68,0:01:02.85,Default,,0,0,0,,Цукуси Мен бүгін көп нәрсе істеймін
Dialogue: 0,0:01:05.44,0:01:08.90,Default,,0,0,0,,Ах, Казама-кун...
Dialogue: 0,0:01:12.98,0:01:14.53,Default,,0,0,0,,Орындық Сөйлеңіз!
Dialogue: 0,0:01:14.61,0:01:16.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:19.16,0:01:21.87,Default,,0,0,0,,Олай болса, жоғары Токио арасындағы алдын ала финалдар
Dialogue: 0,0:01:23.08,0:01:27.92,Default,,0,0,0,,Сейсеки орта мектебі мен Токио Митрополиті Сакураги орта мектебі Матч басталады!
Dialogue: 0,0:01:28.00,0:01:30.88,Default,,0,0,0,,Охохо!
Dialogue: 0,0:01:30.96,0:01:34.88,Default,,0,0,0,,Сакура жоғары! Сакура жоғары! Сакура жоғары! Сакура жоғары!
Dialogue: 0,0:01:34.96,0:01:40.89,Default,,0,0,0,,Сакура жоғары! Сакура жоғары! Сакура жоғары! Сакура жоғары! Сакура жоғары! Сакура жоғары!
Dialogue: 0,0:01:40.97,0:01:47.14,Default,,0,0,0,,Сакрамент! Қасиетті ғибадатхана! Қасиетті ғибадатхана! Қасиетті ғибадатхана!
Dialogue: 0,0:01:47.23,0:01:53.94,Default,,0,0,0,,Сакрамент! Қасиетті ғибадатхана! Қасиетті ғибадатхана! Қасиетті ғибадатхана! Қасиетті ғибадатхана...
Dialogue: 0,0:01:54.44,0:01:55.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:55.86,0:02:01.07,Default,,0,0,0,,Әлде... Казама-күн, қолыңды ертерек қыссам, қолым дірілдеп тұрды.
Dialogue: 0,0:02:01.16,0:02:03.91,Default,,0,0,0,,Оның түсі де сәл нашар көрінді.
Dialogue: 0,0:02:03.99,0:02:05.91,Default,,0,0,0,,Мен мұны өте қиын жасаймын
Dialogue: 0,0:02:06.00,0:02:07.91,Default,,0,0,0,,Сондай-ақ... мүмкін
Dialogue: 0,0:02:08.54,0:02:12.42,Default,,0,0,0,,Сіз бір жерде жарақат алдыңыз ба? Сіз шынымен өзіңізді жақсы сезінбейсіз бе?
Dialogue: 0,0:02:12.50,0:02:14.38,Default,,0,0,0,,Сол директор
Dialogue: 0,0:02:14.46,0:02:15.76,Default,,0,0,0,,Ка... Кака... Каза... (Наказава) Иә? Не?
Dialogue: 0,0:02:15.76,0:02:16.26,Default,,0,0,0,,Ка... Кака... Каза... (Наказава) Иә? Не?
Dialogue: 0,0:02:16.34,0:02:17.13,Default,,0,0,0,,О, басталды!
Dialogue: 0,0:02:17.13,0:02:18.42,Default,,0,0,0,,О, басталды!
Dialogue: 0,0:02:20.05,0:02:20.93,Default,,0,0,0,,Иә
Dialogue: 0,0:02:21.01,0:02:26.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:46.30,0:03:50.93,Default,,0,0,0,,～♪
Dialogue: 0,0:03:57.48,0:04:00.74,Default,,0,0,0,,Сейсекидің үш шабуылшысы да ұлттық класс.
Dialogue: 0,0:04:01.78,0:04:03.28,Default,,0,0,0,,Оң жақ Казама
Dialogue: 0,0:04:04.24,0:04:05.78,Default,,0,0,0,,Орталық бұта
Dialogue: 0,0:04:07.16,0:04:08.53,Default,,0,0,0,,Мизуки сол жақта
Dialogue: 0,0:04:09.87,0:04:11.62,Default,,0,0,0,,Әдепті ұстанатын сенсің.
Dialogue: 0,0:04:12.37,0:04:14.00,Default,,0,0,0,,Енді рұқсаттаманы кімге бересіз?
Dialogue: 0,0:04:19.71,0:04:20.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:20.92,0:04:22.13,Default,,0,0,0,,Иә! (Сарухаши) Ах!
Dialogue: 0,0:04:22.22,0:04:23.42,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:23.51,0:04:24.38,Default,,0,0,0,,(Допты тепкен дыбысы)
Dialogue: 0,0:04:24.47,0:04:25.43,Default,,0,0,0,,Бұл Казама!
Dialogue: 0,0:04:25.51,0:04:26.89,Default,,0,0,0,,Ах
Dialogue: 0,0:04:27.80,0:04:28.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:28.72,0:04:30.64,Default,,0,0,0,,То... Қателік бар ма?
Dialogue: 0,0:04:30.72,0:04:32.52,Default,,0,0,0,,Иә? Казама?
Dialogue: 0,0:04:32.60,0:04:34.35,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:04:36.44,0:04:38.86,Default,,0,0,0,,(Казама мен оның достарының дауысы)
Dialogue: 0,0:04:40.28,0:04:44.61,Default,,0,0,0,,Бұл... бұл сезім... менің аяғым жерге тимейді.
Dialogue: 0,0:04:46.07,0:04:49.12,Default,,0,0,0,,Доп жабыспайды... Бұл не? Бұл
Dialogue: 0,0:04:50.79,0:04:53.12,Default,,0,0,0,,Мен үлкен сахналарға үйреніп қалдым.
Dialogue: 0,0:04:54.33,0:04:58.13,Default,,0,0,0,,Мен бала кезімде ел бойынша финалға шықтым.
Dialogue: 0,0:04:59.54,0:05:03.13,Default,,0,0,0,,Мен орта мектепте оқып жүргенде оқу орталығын да бастан өткердім.
Dialogue: 0,0:05:04.38,0:05:07.64,Default,,0,0,0,,Бұл сезімнің бәрінен өзгеше.
Dialogue: 0,0:05:08.55,0:05:14.68,Default,,0,0,0,,Иә, мен қазір өзімді жоғары сезінемін!
Dialogue: 0,0:05:08.55,0:05:14.68,Default,,0,0,0,,(Қазаманың жүрек соғысы)
Dialogue: 0,0:05:14.77,0:05:15.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:16.81,0:05:17.65,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:17.73,0:05:18.56,Default,,0,0,0,,Не!
Dialogue: 0,0:05:21.15,0:05:25.07,Default,,0,0,0,,Менің өмірімдегі ең күшті жаудың алдында тұрған ...
Dialogue: 0,0:05:26.28,0:05:27.57,Default,,0,0,0,,Мен жалғыз асығамын!
Dialogue: 0,0:05:27.66,0:05:29.07,Default,,0,0,0,,Ба ба ба ба…
Dialogue: 0,0:05:29.99,0:05:30.87,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:05:30.95,0:05:32.99,Default,,0,0,0,,Мен жай ғана білгім келеді!
Dialogue: 0,0:05:33.08,0:05:35.20,Default,,0,0,0,,Сәлем! (Казама) Уф!
Dialogue: 0,0:05:38.21,0:05:39.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:39.17,0:05:40.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:42.05,0:05:43.30,Default,,0,0,0,,Жарайды, келіңдер! жол!
Dialogue: 0,0:05:43.92,0:05:44.76,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:45.30,0:05:47.84,Default,,0,0,0,,Әй, күте тұр, Казама! Қашпа!
Dialogue: 0,0:05:49.64,0:05:51.35,Default,,0,0,0,,Өкінішке орай, бәрі осы.
Dialogue: 0,0:05:51.43,0:05:53.35,Default,,0,0,0,,Уау! (Нитобе) Бұл Кисараги!
Dialogue: 0,0:05:53.43,0:05:55.14,Default,,0,0,0,,Қайтар, Казама!
Dialogue: 0,0:05:55.81,0:05:56.64,Default,,0,0,0,,Оны тартып алыңыз!
Dialogue: 0,0:05:58.81,0:06:00.44,Default,,0,0,0,,Оны әдейі тізеңізге қойдыңыз ба?
Dialogue: 0,0:06:00.52,0:06:01.77,Default,,0,0,0,,Не? ток
Dialogue: 0,0:06:01.86,0:06:03.94,Default,,0,0,0,,Кисараги де асып түсті!
Dialogue: 0,0:06:04.61,0:06:05.44,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:06.15,0:06:08.20,Default,,0,0,0,,Тек сақтаушы ғана қалды! (Көрермендер) Шынымен!
Dialogue: 0,0:06:08.28,0:06:09.20,Default,,0,0,0,,Ах
Dialogue: 0,0:06:11.28,0:06:13.20,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,0:06:19.96,0:06:22.04,Default,,0,0,0,,Сонымен... керемет
Dialogue: 0,0:06:22.75,0:06:25.09,Default,,0,0,0,,Мен өзімді жақсы сезінбей жатқаныма сене алар емеспін.
Dialogue: 0,0:06:25.17,0:06:26.71,Default,,0,0,0,,Мен жақсы жұмыс істеп жатырмын.
Dialogue: 0,0:06:26.80,0:06:30.30,Default,,0,0,0,,Казама-кунның ойыны алаңды тыныштандырды.
Dialogue: 0,0:06:32.89,0:06:35.68,Default,,0,0,0,,Мен жай ғана білгім келеді
Dialogue: 0,0:06:35.77,0:06:38.31,Default,,0,0,0,,Мен қазір қайдамын?
Dialogue: 0,0:06:38.39,0:06:39.44,Default,,0,0,0,,Охохо!
Dialogue: 0,0:06:39.52,0:06:41.15,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:41.23,0:06:42.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:42.81,0:06:43.98,Default,,0,0,0,,Сакрамент №9
Dialogue: 0,0:06:44.07,0:06:47.24,Default,,0,0,0,,Сіз күтпеген жерден Сакура орта мектебін жеңдіңіз!
Dialogue: 0,0:06:47.32,0:06:49.28,Default,,0,0,0,,Біз қаншалықты алыс жүре аламыз?
Dialogue: 0,0:06:50.15,0:06:53.87,Default,,0,0,0,,Өйткені, Казама-кун керемет адам.
Dialogue: 0,0:06:54.45,0:06:56.95,Default,,0,0,0,,Сонда да ол менің үйіме кірді.
Dialogue: 0,0:06:57.04,0:06:59.33,Default,,0,0,0,,Ол ешқашан байыптылық танытпады.
Dialogue: 0,0:06:59.41,0:07:00.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:00.83,0:07:01.29,Default,,0,0,0,,Бұрыш алынды
Dialogue: 0,0:07:01.29,0:07:02.21,Default,,0,0,0,,Бұрыш алынды
Dialogue: 0,0:07:01.29,0:07:02.21,Default,,0,0,0,,Қарсылас неғұрлым күшті болса, Джин Казама деген адам соғұрлым намысшыл болады.
Dialogue: 0,0:07:02.21,0:07:02.29,Default,,0,0,0,,Қарсылас неғұрлым күшті болса, Джин Казама деген адам соғұрлым намысшыл болады.
Dialogue: 0,0:07:02.29,0:07:03.13,Default,,0,0,0,,Қарсылас неғұрлым күшті болса, Джин Казама деген адам соғұрлым намысшыл болады.
Dialogue: 0,0:07:02.29,0:07:03.13,Default,,0,0,0,,Әкем әдеттегідей драмалық болып жатыр—
Dialogue: 0,0:07:03.13,0:07:03.21,Default,,0,0,0,,Қарсылас неғұрлым күшті болса, Джин Казама деген адам соғұрлым намысшыл болады.
Dialogue: 0,0:07:03.21,0:07:05.13,Default,,0,0,0,,Қарсылас неғұрлым күшті болса, Джин Казама деген адам соғұрлым намысшыл болады.
Dialogue: 0,0:07:03.21,0:07:05.13,Default,,0,0,0,,Дұрыс шешім қабылдаңыз.
Dialogue: 0,0:07:05.13,0:07:05.21,Default,,0,0,0,,Қарсылас күшті болған сайын, Джин Казама деген адамның мақтанышы артады.
Dialogue: 0,0:07:05.21,0:07:06.38,Default,,0,0,0,,Қарсылас неғұрлым күшті болса, Джин Казама деген адамның мақтанышы артады.
Dialogue: 0,0:07:05.21,0:07:06.38,Default,,0,0,0,,Келесі, жол
Dialogue: 0,0:07:07.30,0:07:09.38,Default,,0,0,0,,Сіз әлі байсалдысыз ба?
Dialogue: 0,0:07:10.63,0:07:12.34,Default,,0,0,0,,Бірінші рет қалай ойнауға болады
Dialogue: 0,0:07:12.43,0:07:15.39,Default,,0,0,0,,Сіріңкенің өзіне айтарлықтай әсер етеді
Dialogue: 0,0:07:15.47,0:07:19.02,Default,,0,0,0,,Мен мұны білдім және істедім.
Dialogue: 0,0:07:19.10,0:07:20.10,Default,,0,0,0,,Маған рұқсат беріңіз
Dialogue: 0,0:07:20.10,0:07:20.64,Default,,0,0,0,,Маған рұқсат беріңіз
Dialogue: 0,0:07:20.10,0:07:20.64,Default,,0,0,0,,Қасиетті ғибадатхана өзгерді
Dialogue: 0,0:07:20.64,0:07:20.73,Default,,0,0,0,,Қасиетті ғибадатхана өзгерді
Dialogue: 0,0:07:20.73,0:07:22.19,Default,,0,0,0,,Қасиетті ғибадатхана өзгерді
Dialogue: 0,0:07:20.73,0:07:22.19,Default,,0,0,0,,Тәртіп!
Dialogue: 0,0:07:23.02,0:07:25.98,Default,,0,0,0,,Бұл біз қиын уақытты өткізген бірінші ойыннан мүлде басқа команда.
Dialogue: 0,0:07:26.90,0:07:29.99,Default,,0,0,0,,Мизуки оралғаннан кейін Казаманың қызметі
Dialogue: 0,0:07:30.95,0:07:33.16,Default,,0,0,0,,Менің футболым матч ойнаған сайын жақсарып келеді.
Dialogue: 0,0:07:34.74,0:07:36.66,Default,,0,0,0,,Себебі анық
Dialogue: 0,0:07:36.74,0:07:39.66,Default,,0,0,0,,Өйткені командада барлығы жақсы жүгіреді.
Dialogue: 0,0:07:39.75,0:07:43.88,Default,,0,0,0,,Осылайша мен футболдың ауқымын кеңейтіп, жағдайымды жақсарттым.
Dialogue: 0,0:07:46.75,0:07:48.55,Default,,0,0,0,,Ах! (Казама) Уф!
Dialogue: 0,0:07:48.63,0:07:49.46,Default,,0,0,0,,Ах
Dialogue: 0,0:07:49.55,0:07:52.97,Default,,0,0,0,,Сейсекидің тез жүгіретін командаға айналу себебі...
Dialogue: 0,0:07:53.05,0:07:56.05,Default,,0,0,0,,Қасиетті ғибадатхана!
Dialogue: 0,0:07:57.43,0:08:00.81,Default,,0,0,0,,Өйткені бәрі бірдей жаңадан бастаушыға жеңілгісі келмейді.
Dialogue: 0,0:08:01.52,0:08:04.56,Default,,0,0,0,,Рақымынан тайып тұрған беделді киелі ғибадатхананы не өзгертті?
Dialogue: 0,0:08:04.65,0:08:07.06,Default,,0,0,0,,Бұл екеуі бірінші курс студенттері!
Dialogue: 0,0:08:07.86,0:08:09.48,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:08:09.57,0:08:10.49,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:08:10.57,0:08:12.70,Default,,0,0,0,,Керемет қасиетті №9 иә?
Dialogue: 0,0:08:12.78,0:08:14.07,Default,,0,0,0,,Бұл бір жыл болды ма?
Dialogue: 0,0:08:14.16,0:08:15.45,Default,,0,0,0,,Тым күшті!
Dialogue: 0,0:08:15.53,0:08:17.16,Default,,0,0,0,,Сіз соншалықты өткір емессіз бе!
Dialogue: 0,0:08:17.24,0:08:18.87,Default,,0,0,0,,Казама-кун керемет!
Dialogue: 0,0:08:19.58,0:08:21.66,Default,,0,0,0,,Дәл қазір ең көзге түсетін нәрсе!
Dialogue: 0,0:08:22.33,0:08:24.92,Default,,0,0,0,,Ол капитан Мизукиге қарағанда ерекше!
Dialogue: 0,0:08:25.00,0:08:26.79,Default,,0,0,0,,Тапсырыс келмейді...
Dialogue: 0,0:08:26.88,0:08:28.63,Default,,0,0,0,,Казама…
Dialogue: 0,0:08:28.71,0:08:30.17,Default,,0,0,0,,Мүмкін бұл...
Dialogue: 0,0:08:30.25,0:08:34.18,Default,,0,0,0,,Менің ойымша, біз осылайша соңына дейін барамыз.
Dialogue: 0,0:08:34.26,0:08:35.68,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:08:35.76,0:08:36.97,Default,,0,0,0,,Ей! (Казама) Ух...
Dialogue: 0,0:08:37.05,0:08:38.97,Default,,0,0,0,,Ах! Ол тоқтатылды!
Dialogue: 0,0:08:39.51,0:08:40.35,Default,,0,0,0,,Не!
Dialogue: 0,0:08:41.89,0:08:44.35,Default,,0,0,0,,На... Наруками-сан...
Dialogue: 0,0:08:44.44,0:08:46.35,Default,,0,0,0,,А, бірақ бұл мақсаттың алдында!
Dialogue: 0,0:08:46.44,0:08:48.81,Default,,0,0,0,,Егер сіз допты ұстасаңыз, сізде мүмкіндік бар!
Dialogue: 0,0:08:48.90,0:08:49.82,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:08:49.90,0:08:50.82,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:50.90,0:08:53.57,Default,,0,0,0,,Барма! Жабыңыз! иә?
Dialogue: 0,0:08:59.12,0:09:00.03,Default,,0,0,0,,Жаман!
Dialogue: 0,0:09:13.59,0:09:14.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:14.84,0:09:15.84,Default,,0,0,0,,Ах
Dialogue: 0,0:09:18.80,0:09:20.72,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:09:20.81,0:09:21.72,Default,,0,0,0,,Инохара!
Dialogue: 0,0:09:21.81,0:09:22.31,Default,,0,0,0,,(Допты тепкен дыбысы)
Dialogue: 0,0:09:22.31,0:09:23.14,Default,,0,0,0,,(Допты тепкен дыбысы)
Dialogue: 0,0:09:22.31,0:09:23.14,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:30.86,0:09:32.78,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:09:32.86,0:09:36.15,Default,,0,0,0,,Өз жартыңыздан қарсылас қақпасына дриблинг туралы не айтасыз?
Dialogue: 0,0:09:36.24,0:09:36.78,Default,,0,0,0,,Айзава мырза қиын кезеңді бастан кешіп жатқан сияқты
Dialogue: 0,0:09:36.78,0:09:37.74,Default,,0,0,0,,Айзава мырза қиын кезеңді бастан кешіп жатқан сияқты
Dialogue: 0,0:09:36.78,0:09:37.74,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:37.74,0:09:37.82,Default,,0,0,0,,Айзава мырза қиын кезеңді бастан кешіп жатқан сияқты
Dialogue: 0,0:09:37.82,0:09:38.86,Default,,0,0,0,,Айзава мырза қиын кезеңді бастан кешіп жатқан сияқты
Dialogue: 0,0:09:37.82,0:09:38.86,Default,,0,0,0,,Сіз қанша адамды шығардыңыз?
Dialogue: 0,0:09:38.86,0:09:38.95,Default,,0,0,0,,Айзава мырза қиын кезеңді бастан кешіп жатқан сияқты
Dialogue: 0,0:09:38.95,0:09:40.91,Default,,0,0,0,,Айзава мырза қиын кезеңді бастан кешіп жатқан сияқты
Dialogue: 0,0:09:38.95,0:09:40.91,Default,,0,0,0,,Наруками жарылысы!
Dialogue: 0,0:09:40.99,0:09:44.54,Default,,0,0,0,,Эгоист Наруками! (Наруками) Ах, сәтсіздік.
Dialogue: 0,0:09:44.62,0:09:48.83,Default,,0,0,0,,Ол кірмеді, бірақ ол әлі де жақсырақ!
Dialogue: 0,0:09:49.75,0:09:51.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:51.79,0:09:53.46,Default,,0,0,0,,Күзетші де жақсы!
Dialogue: 0,0:09:53.55,0:09:56.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:57.76,0:09:59.68,Default,,0,0,0,,Мен 5 адамнан өттім.
Dialogue: 0,0:09:59.76,0:10:01.68,Default,,0,0,0,,ше? Хмм...
Dialogue: 0,0:10:02.60,0:10:04.47,Default,,0,0,0,,Не? Мен оны ести алмаймын.
Dialogue: 0,0:10:05.06,0:10:07.44,Default,,0,0,0,,Сынықты тексеру
Dialogue: 0,0:10:08.23,0:10:11.15,Default,,0,0,0,,(Нарукамидің гуілдеуі)
Dialogue: 0,0:10:11.23,0:10:14.94,Default,,0,0,0,,Мен «эгоист» деп түсінемін.
Dialogue: 0,0:10:16.11,0:10:17.24,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:10:17.32,0:10:22.33,Default,,0,0,0,,(Нарукамидің гуілдеуі)
Dialogue: 0,0:10:27.79,0:10:29.25,Default,,0,0,0,,Сакура биігі де қысқа бұрыш па?
Dialogue: 0,0:10:29.33,0:10:31.00,Default,,0,0,0,,Нарукамиге барыңыз!
Dialogue: 0,0:10:32.13,0:10:34.30,Default,,0,0,0,,А, тез! Қоршалған!
Dialogue: 0,0:10:37.63,0:10:40.38,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:10:40.47,0:10:41.30,Default,,0,0,0,,Ах
Dialogue: 0,0:10:41.89,0:10:44.18,Default,,0,0,0,,Не? Керемет қолдау
Dialogue: 0,0:10:44.26,0:10:46.06,Default,,0,0,0,,Цуку Чан сыртта емес пе?
Dialogue: 0,0:10:47.14,0:10:48.93,Default,,0,0,0,,Иә? Тіпті орындықта емес
Dialogue: 0,0:10:49.64,0:10:52.36,Default,,0,0,0,,Қазір жағдай қандай?
Dialogue: 0,0:10:52.44,0:10:55.44,Default,,0,0,0,,Бұл олай емес. Қараңызшы (Саюри) Иә?
Dialogue: 0,0:10:56.15,0:10:57.94,Default,,0,0,0,,Мұндай әрекетті орындау үшін төрт адам керек
Dialogue: 0,0:10:58.65,0:11:01.95,Default,,0,0,0,,Құдіретті Қасиетті Құдайдың өзі құдайды тоқтата алмайды
Dialogue: 0,0:11:03.12,0:11:05.45,Default,,0,0,0,,... маңызды емес.
Dialogue: 0,0:11:06.54,0:11:08.37,Default,,0,0,0,,Аяғыңды шығарсаң, қашып кетесің.
Dialogue: 0,0:11:09.96,0:11:14.71,Default,,0,0,0,,Егер сіз кеңістікті қалдырсаңыз, ол жылдамдықпен жыртылады.
Dialogue: 0,0:11:18.09,0:11:19.59,Default,,0,0,0,,Қасиетті лақтыру
Dialogue: 0,0:11:20.80,0:11:24.14,Default,,0,0,0,,Мен не істесем де, бұл құбыжықты тоқтата алмаймын.
Dialogue: 0,0:11:24.68,0:11:27.93,Default,,0,0,0,,Мен оны тоқтатуды елестете де алмаймын.
Dialogue: 0,0:11:28.02,0:11:31.56,Default,,0,0,0,,Хм, ату ғана қалды.
Dialogue: 0,0:11:32.90,0:11:33.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:36.27,0:11:38.23,Default,,0,0,0,,Поки
Dialogue: 0,0:11:39.03,0:11:40.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:40.95,0:11:45.78,Default,,0,0,0,,Біреудің жүрегінің дүрсілдеген дыбысын естуге шыдамаймын.
Dialogue: 0,0:11:45.87,0:11:47.95,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:11:48.04,0:11:49.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:51.79,0:11:55.42,Default,,0,0,0,,Жүр, тез тастап жіберейік~
Dialogue: 0,0:11:55.50,0:11:59.34,Default,,0,0,0,,Бұл жігіт бір бұранданы толығымен шығарып алды.
Dialogue: 0,0:12:00.17,0:12:03.84,Default,,0,0,0,,Цк, мен Нарукамиді тоқтату үшін бірдеңе істеуім керек.
Dialogue: 0,0:12:04.39,0:12:06.68,Default,,0,0,0,,Ешбір жолды ойлай алмаймын
Dialogue: 0,0:12:06.76,0:12:08.85,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе...
Dialogue: 0,0:12:08.93,0:12:09.85,Default,,0,0,0,,Бұл доп!
Dialogue: 0,0:12:10.47,0:12:11.35,Default,,0,0,0,,Сіз жеңе аласыз!
Dialogue: 0,0:12:11.89,0:12:12.73,Default,,0,0,0,,Ах
Dialogue: 0,0:12:12.81,0:12:17.73,Default,,0,0,0,,Бұл Кимишита-сенпай Гамба! Рухты енгізіңіз!
Dialogue: 0,0:12:17.82,0:12:19.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:19.78,0:12:22.15,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:12:22.24,0:12:25.61,Default,,0,0,0,,Мұғалім, менде ақымақ кітаптар жоқ.
Dialogue: 0,0:12:25.70,0:12:26.53,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:12:26.62,0:12:28.87,Default,,0,0,0,,Бұл Сакура орта мектебіндегі орындықтың алдында.
Dialogue: 0,0:12:28.95,0:12:30.70,Default,,0,0,0,,Иә, сен сондай ақымақсың.
Dialogue: 0,0:12:30.79,0:12:32.87,Default,,0,0,0,,Қасиетті жер алыс!
Dialogue: 0,0:12:32.96,0:12:34.54,Default,,0,0,0,,Ах! Бұл рас!
Dialogue: 0,0:12:34.62,0:12:36.67,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:36.75,0:12:39.50,Default,,0,0,0,,Мен ынта-жігермен қуандым, мен білмей тұрып, ол осында болды...
Dialogue: 0,0:12:39.59,0:12:42.59,Default,,0,0,0,,Маған үнемі шабуыл жасалғаны өте жаман болды.
Dialogue: 0,0:12:42.67,0:12:44.55,Default,,0,0,0,,Тез оралыңыз!
Dialogue: 0,0:12:45.13,0:12:47.51,Default,,0,0,0,,Сіз! орындыққа қайта оралыңыз
Dialogue: 0,0:12:47.60,0:12:48.85,Default,,0,0,0,,Кешіріңіз! кешіріңіз!
Dialogue: 0,0:12:48.85,0:12:49.18,Default,,0,0,0,,Кешіріңіз! кешіріңіз!
Dialogue: 0,0:12:48.85,0:12:49.18,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:12:49.18,0:12:49.26,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:12:49.26,0:12:50.72,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:12:49.26,0:12:50.72,Default,,0,0,0,,Кешіріңіз! кешіріңіз!
Dialogue: 0,0:12:50.72,0:12:50.81,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:12:50.81,0:12:51.64,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:12:50.81,0:12:51.64,Default,,0,0,0,,А... жоқ, жоқ
Dialogue: 0,0:12:51.72,0:12:53.14,Default,,0,0,0,,О...
Dialogue: 0,0:12:53.23,0:12:54.14,Default,,0,0,0,,Не?
Dialogue: 0,0:12:54.23,0:12:55.14,Default,,0,0,0,,Бұл жерде біртүрлі нәрсе бар.
Dialogue: 0,0:12:55.23,0:12:58.31,Default,,0,0,0,,Ахахха, ол жігіт шынымен қызық екен.
Dialogue: 0,0:12:58.40,0:12:59.32,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:12:59.40,0:13:00.52,Default,,0,0,0,,Ангури…
Dialogue: 0,0:13:00.61,0:13:02.69,Default,,0,0,0,,Ұят жігіт...
Dialogue: 0,0:13:02.78,0:13:03.94,Default,,0,0,0,,Пуха!
Dialogue: 0,0:13:04.03,0:13:07.87,Default,,0,0,0,,Ол жақта көптен бері допты көтере алмай жүргенім рас.
Dialogue: 0,0:13:07.95,0:13:08.99,Default,,0,0,0,,Жылқы құйрығына ұқсайды
Dialogue: 0,0:13:09.07,0:13:11.79,Default,,0,0,0,,Бұл күлкі емес!
Dialogue: 0,0:13:09.07,0:13:11.79,Default,,0,0,0,,(Қазаманың күлкісі)
Dialogue: 0,0:13:11.87,0:13:15.54,Default,,0,0,0,,Бір жыл бойы ұжымдық жауапкершілікпен Комазаваны айналып өтейік!
Dialogue: 0,0:13:15.62,0:13:16.46,Default,,0,0,0,,Ей!
Dialogue: 0,0:13:16.54,0:13:18.88,Default,,0,0,0,,Біз де.
Dialogue: 0,0:13:18.96,0:13:22.13,Default,,0,0,0,,Футболды өзімізше ойнасақ дұрыс емес пе?
Dialogue: 0,0:13:22.76,0:13:25.42,Default,,0,0,0,,Ух... цк
Dialogue: 0,0:13:26.22,0:13:28.18,Default,,0,0,0,,Тез оралыңыз!
Dialogue: 0,0:13:28.26,0:13:29.26,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:13:29.35,0:13:31.06,Default,,0,0,0,,Жарайды, қайт.
Dialogue: 0,0:13:31.14,0:13:34.56,Default,,0,0,0,,Даусыңды естігенше мен сені итеріп жіберемін
Dialogue: 0,0:13:35.18,0:13:37.19,Default,,0,0,0,,А... иә!
Dialogue: 0,0:13:38.35,0:13:39.19,Default,,0,0,0,,Ой!
Dialogue: 0,0:13:39.27,0:13:41.11,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:41.19,0:13:42.19,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:13:43.15,0:13:44.19,Default,,0,0,0,,Оны қайтар!
Dialogue: 0,0:13:47.28,0:13:48.45,Default,,0,0,0,,О!
Dialogue: 0,0:13:48.53,0:13:49.70,Default,,0,0,0,,Бүйірді өзгерту!
Dialogue: 0,0:13:50.57,0:13:53.99,Default,,0,0,0,,Нарукамиді тоқтату әрине қиын.
Dialogue: 0,0:13:54.08,0:13:58.17,Default,,0,0,0,,Бірақ бізде де құбыжық бар.
Dialogue: 0,0:14:01.54,0:14:04.88,Default,,0,0,0,,Енді қарсы шабуылдың уақыты келді.
Dialogue: 0,0:14:17.18,0:14:18.56,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:14:18.64,0:14:20.27,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:20.35,0:14:21.77,Default,,0,0,0,,О~ Мизуки
Dialogue: 0,0:14:21.86,0:14:24.11,Default,,0,0,0,,Бітті ме? 1 жыл автобуспен жүру
Dialogue: 0,0:14:24.19,0:14:25.03,Default,,0,0,0,,Иә
Dialogue: 0,0:14:25.53,0:14:28.11,Default,,0,0,0,,Өкініштісі, мен саған рұқсат бердім.
Dialogue: 0,0:14:28.20,0:14:31.32,Default,,0,0,0,,Жоқ, мен салмақты аяқтағаннан кейін жалықтым.
Dialogue: 0,0:14:31.41,0:14:33.87,Default,,0,0,0,,Сіз өте кеш тұрдыңыз деп ойлаймын.
Dialogue: 0,0:14:33.95,0:14:36.29,Default,,0,0,0,,Ұзақ уақыт алған бір адам болды.
Dialogue: 0,0:14:36.91,0:14:39.29,Default,,0,0,0,,Сіз қалай ойлайсыз? Биыл
Dialogue: 0,0:14:40.04,0:14:44.71,Default,,0,0,0,,Жоқ, көп келдім, бірақ ертең жартысы бар.
Dialogue: 0,0:14:44.80,0:14:45.80,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:14:46.51,0:14:47.80,Default,,0,0,0,,Казама ше?
Dialogue: 0,0:14:49.01,0:14:50.26,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:14:50.34,0:14:51.59,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:51.68,0:14:54.81,Default,,0,0,0,,Кіші мектептің бірінші курсынан мені шақырған адам болды.
Dialogue: 0,0:14:54.89,0:14:56.68,Default,,0,0,0,,Иә? Бәрі осы ма?
Dialogue: 0,0:14:56.77,0:14:57.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:57.93,0:14:59.81,Default,,0,0,0,,Басқа нәрсе жоқ па?
Dialogue: 0,0:15:00.98,0:15:01.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:02.52,0:15:03.77,Default,,0,0,0,,«Бәрі осы» деген нені білдіреді?
Dialogue: 0,0:15:03.86,0:15:06.32,Default,,0,0,0,,А... жоқ, мүмкін бұл менің қиялым шығар?
Dialogue: 0,0:15:06.98,0:15:09.65,Default,,0,0,0,,Өйткені сен өте бақытты көрінесің
Dialogue: 0,0:15:10.40,0:15:12.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:12.36,0:15:13.82,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:15:13.91,0:15:15.16,Default,,0,0,0,,Сіз мұны істеп жатырсыз ба?
Dialogue: 0,0:15:15.24,0:15:18.37,Default,,0,0,0,,Иә, мен істеймін, хехе
Dialogue: 0,0:15:18.45,0:15:20.62,Default,,0,0,0,,Түсіндің бе? (Хайбара) Сөзсіз
Dialogue: 0,0:15:20.71,0:15:22.83,Default,,0,0,0,,Бәрі бірдей түсіне бермейді
Dialogue: 0,0:15:25.42,0:15:28.30,Default,,0,0,0,,Басқан сайын күшейе түседі
Dialogue: 0,0:15:28.38,0:15:29.84,Default,,0,0,0,,Бұл арамшөп түрі.
Dialogue: 0,0:15:29.92,0:15:30.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:31.01,0:15:32.34,Default,,0,0,0,,«Бұл»? (Хайбара) «Иә?»
Dialogue: 0,0:15:33.01,0:15:34.30,Default,,0,0,0,,«Бұл»?
Dialogue: 0,0:15:38.93,0:15:41.35,Default,,0,0,0,,О! Капитан Мизуки!
Dialogue: 0,0:15:41.44,0:15:43.31,Default,,0,0,0,,Бұл Мизуки! (Көрермендер) Мизуки барады!
Dialogue: 0,0:15:43.40,0:15:44.36,Default,,0,0,0,,Жылдам шабуыл!
Dialogue: 0,0:15:47.32,0:15:48.23,Default,,0,0,0,,Кисараги!
Dialogue: 0,0:15:50.19,0:15:52.11,Default,,0,0,0,,Тәтті! (Кисараги/Арима) Не!
Dialogue: 0,0:15:52.74,0:15:53.61,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:54.28,0:15:55.12,Default,,0,0,0,,♬~
Dialogue: 0,0:15:55.20,0:15:56.87,Default,,0,0,0,,Ах... (Мидзуки) Ах!
Dialogue: 0,0:15:58.95,0:16:00.75,Default,,0,0,0,,Уау! (Кондо) Ха!
Dialogue: 0,0:16:02.29,0:16:03.12,Default,,0,0,0,,Аһ!
Dialogue: 0,0:16:04.88,0:16:06.63,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:16:06.71,0:16:08.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:08.09,0:16:09.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:10.67,0:16:11.51,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:12.84,0:16:14.01,Default,,0,0,0,,Бұрыш?
Dialogue: 0,0:16:14.84,0:16:16.64,Default,,0,0,0,,Оның ұзындығы 40 метр.
Dialogue: 0,0:16:16.72,0:16:18.64,Default,,0,0,0,,Эй... ол менің артымнан келді.
Dialogue: 0,0:16:20.43,0:16:21.64,Default,,0,0,0,,Үш адам белгілейді
Dialogue: 0,0:16:21.73,0:16:22.64,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:16:25.23,0:16:26.65,Default,,0,0,0,,Капитан Мизуки
Dialogue: 0,0:16:26.73,0:16:27.90,Default,,0,0,0,,Ах
Dialogue: 0,0:16:28.90,0:16:30.82,Default,,0,0,0,,Үш адам белгіледі?
Dialogue: 0,0:16:30.90,0:16:32.36,Default,,0,0,0,,Жарайды, міне сенің мүмкіндігің!
Dialogue: 0,0:16:32.44,0:16:33.45,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:16:33.53,0:16:34.53,Default,,0,0,0,,Қасиетті бұрыш
Dialogue: 0,0:16:34.61,0:16:36.82,Default,,0,0,0,,Тағы бірдеңе істейміз бе? (Көрермендер) Өтінемін!
Dialogue: 0,0:16:36.91,0:16:40.74,Default,,0,0,0,,Иә, әлі де ақымақ соққылар.
Dialogue: 0,0:16:42.08,0:16:44.71,Default,,0,0,0,,Сіз бақытты көрінесіз, капитан.
Dialogue: 0,0:16:44.79,0:16:46.00,Default,,0,0,0,,Не? сол бет
Dialogue: 0,0:16:48.96,0:16:51.26,Default,,0,0,0,,Сіз тым көзге түсесіз, баласыз ба?
Dialogue: 0,0:16:51.34,0:16:54.09,Default,,0,0,0,,Бұлай шағымданудың қажеті жоқ, капитан.
Dialogue: 0,0:16:55.01,0:16:57.80,Default,,0,0,0,,Менің жұмысым – ұпай жинау.
Dialogue: 0,0:16:57.89,0:16:58.39,Default,,0,0,0,,Киичи де, Казама да киелі жерде.
Dialogue: 0,0:16:58.39,0:17:00.47,Default,,0,0,0,,Киичи де, Казама да киелі жерде.
Dialogue: 0,0:16:58.39,0:17:00.47,Default,,0,0,0,,Оны маған беріңіз! Маған берші!
Dialogue: 0,0:17:00.56,0:17:03.48,Default,,0,0,0,,Егер ықтималдық жоғары болса, ойланбастан оған барыңыз
Dialogue: 0,0:17:07.31,0:17:08.27,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:10.07,0:17:13.78,Default,,0,0,0,,Мен сенің сезіміңді білемін.
Dialogue: 0,0:17:17.41,0:17:19.62,Default,,0,0,0,,Жарақатыма байланысты жарты жыл күтуге тура келді.
Dialogue: 0,0:17:19.70,0:17:20.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:24.62,0:17:25.46,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:17:29.17,0:17:30.46,Default,,0,0,0,,Үстеме шығындар?
Dialogue: 0,0:17:30.54,0:17:31.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:37.51,0:17:38.14,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:17:38.14,0:17:39.18,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:17:38.14,0:17:39.18,Default,,0,0,0,,Айзава мырза қиын кезеңді бастан кешіп жатқан сияқты
Dialogue: 0,0:17:39.18,0:17:39.26,Default,,0,0,0,,Айзава мырза қиын кезеңді бастан кешіп жатқан сияқты
Dialogue: 0,0:17:39.26,0:17:40.60,Default,,0,0,0,,Айзава мырза қиын кезеңді бастан кешіп жатқан сияқты
Dialogue: 0,0:17:39.26,0:17:40.60,Default,,0,0,0,,Күзетші тоқтады!
Dialogue: 0,0:17:41.64,0:17:42.60,Default,,0,0,0,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:17:43.35,0:17:44.18,Default,,0,0,0,,Цк
Dialogue: 0,0:17:44.27,0:17:47.73,Default,,0,0,0,,Мизуки керемет! (Көрермендер) Қандай физикалық қабілетіңіз бар!
Dialogue: 0,0:17:47.81,0:17:49.90,Default,,0,0,0,,Секірген (инудо) хун
Dialogue: 0,0:17:51.57,0:17:53.40,Default,,0,0,0,,Үш адам жеткілікті ме?
Dialogue: 0,0:17:53.48,0:17:55.90,Default,,0,0,0,,О, қандай ұят!
Dialogue: 0,0:17:55.99,0:17:57.15,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:17:57.82,0:18:00.16,Default,,0,0,0,,Мен... Мен бұл керемет деп ойладым.
Dialogue: 0,0:18:01.16,0:18:03.83,Default,,0,0,0,,Бұл адам бүгінде басым.
Dialogue: 0,0:18:03.91,0:18:05.54,Default,,0,0,0,,Ол шынымен жарақат алды ма?
Dialogue: 0,0:18:08.62,0:18:12.17,Default,,0,0,0,,Мен өзімді жанып тұрғандай сезінемін. Біраз уақыт өтті.
Dialogue: 0,0:18:13.42,0:18:16.26,Default,,0,0,0,,Не? Ұзақ уақытта көрмеу?
Dialogue: 0,0:18:16.34,0:18:18.01,Default,,0,0,0,,Бұл бірінші рет болып тұр ма?
Dialogue: 0,0:18:18.09,0:18:19.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:21.05,0:18:21.51,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:18:21.51,0:18:22.93,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:18:21.51,0:18:22.93,Default,,0,0,0,,Маған рұқсат қағазын беріңіз
Dialogue: 0,0:18:22.93,0:18:23.01,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:18:23.01,0:18:23.81,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:18:23.01,0:18:23.81,Default,,0,0,0,,Мен бұрын жақсы пас бердім.
Dialogue: 0,0:18:23.81,0:18:23.89,Default,,0,0,0,,Мен бұрын жақсы пас бердім.
Dialogue: 0,0:18:23.89,0:18:24.77,Default,,0,0,0,,Мен бұрын жақсы пас жасадым.
Dialogue: 0,0:18:23.89,0:18:24.77,Default,,0,0,0,,Өйткені, ол адамның мағынасы жоқ.
Dialogue: 0,0:18:24.77,0:18:24.85,Default,,0,0,0,,Өйткені, ол адамның мағынасы жоқ.
Dialogue: 0,0:18:24.85,0:18:26.48,Default,,0,0,0,,Өйткені, ол адамның мағынасы жоқ.
Dialogue: 0,0:18:24.85,0:18:26.48,Default,,0,0,0,,Оны маған (Ием) бер!
Dialogue: 0,0:18:27.10,0:18:31.11,Default,,0,0,0,,Эмото: Мизукиге жақсылап қараңыз.
Dialogue: 0,0:18:31.19,0:18:34.11,Default,,0,0,0,,Міне мен сізге айтайын деп отырмын.
Dialogue: 0,0:18:34.19,0:18:35.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:36.28,0:18:37.24,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:38.32,0:18:41.57,Default,,0,0,0,,Не? Сен ашулысың ба?
Dialogue: 0,0:18:41.66,0:18:43.33,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:18:43.41,0:18:44.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:44.33,0:18:47.00,Default,,0,0,0,,Жоқ сияқты...
Dialogue: 0,0:18:47.08,0:18:48.50,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:49.46,0:18:52.25,Default,,0,0,0,,Ойынның алдында ол маған келіп:
Dialogue: 0,0:18:52.33,0:18:55.25,Default,,0,0,0,,Бүгін мен бар күшіммен ұшамын басынан.
Dialogue: 0,0:18:55.34,0:18:56.71,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:18:56.80,0:18:59.51,Default,,0,0,0,,Аяғыңыз толық сауығып кетті деп алданып қалмаңыз.
Dialogue: 0,0:19:01.05,0:19:05.01,Default,,0,0,0,,Мен сізге бір нәрсе айтқым келеді. Саған айтқым келген адам бар.
Dialogue: 0,0:19:06.47,0:19:08.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:11.94,0:19:13.02,Default,,0,0,0,,Маған айтқыңыз келе ме?
Dialogue: 0,0:19:17.61,0:19:21.28,Default,,0,0,0,,Бұл есептеу мүмкін емес. Бұл жігіттің бүгінгі күші қандай?
Dialogue: 0,0:19:22.91,0:19:26.66,Default,,0,0,0,,Мизуки сен келгенде ең бақытты болған шығар.
Dialogue: 0,0:19:26.74,0:19:27.79,Default,,0,0,0,,Келуім керек пе?
Dialogue: 0,0:19:28.50,0:19:31.08,Default,,0,0,0,,Сіз оның жаңадан бастағанын естідіңіз бе?
Dialogue: 0,0:19:31.17,0:19:34.67,Default,,0,0,0,,А... иә, сәл ғана.
Dialogue: 0,0:19:34.75,0:19:39.80,Default,,0,0,0,,Дәл қазіргі ұжым сияқты бізде де ұрпақтар бойына мықты адамдар көп болды.
Dialogue: 0,0:19:41.26,0:19:44.80,Default,,0,0,0,,Ол үндемеді, бірақ қиналған болуы керек.
Dialogue: 0,0:19:46.26,0:19:50.56,Default,,0,0,0,,Жабайы аңдар арасындағы тышқан сияқты.
Dialogue: 0,0:19:52.19,0:19:55.81,Default,,0,0,0,,Не? бастаушы? мүмкін емес
Dialogue: 0,0:19:55.90,0:19:58.03,Default,,0,0,0,,Қатты тырысқанның пайдасы жоқ
Dialogue: 0,0:19:58.11,0:20:00.07,Default,,0,0,0,,Тек бас тарт!
Dialogue: 0,0:20:01.36,0:20:03.07,Default,,0,0,0,,Кедергі кедергі!
Dialogue: 0,0:20:04.99,0:20:06.07,Default,,0,0,0,,Хисато…
Dialogue: 0,0:20:06.16,0:20:08.83,Default,,0,0,0,,Сәлем Хисато.
Dialogue: 0,0:20:08.91,0:20:12.83,Default,,0,0,0,,Өмірде адасып қалсаң, қиынырақ жолды таңда.
Dialogue: 0,0:20:15.42,0:20:19.34,Default,,0,0,0,,Бұл өмір сүрудің ең әдемі жолы
Dialogue: 0,0:20:21.01,0:20:23.09,Default,,0,0,0,,Бұл менің бірінші рет, Эмото.
Dialogue: 0,0:20:24.30,0:20:26.60,Default,,0,0,0,,Мен сенің алдыңда ойнағанда...
Dialogue: 0,0:20:29.68,0:20:33.10,Default,,0,0,0,,Сіздің өмір жолыңыз өте қауіпті.
Dialogue: 0,0:20:33.89,0:20:35.15,Default,,0,0,0,,Қазір жақсы
Dialogue: 0,0:20:35.23,0:20:37.65,Default,,0,0,0,,Бұл жеткілікті жақсы.
Dialogue: 0,0:20:37.73,0:20:41.57,Default,,0,0,0,,Бірақ бұл әрқашан солай бола бермейді.
Dialogue: 0,0:20:41.65,0:20:43.61,Default,,0,0,0,,Кейде шу естисіз.
Dialogue: 0,0:20:44.57,0:20:47.62,Default,,0,0,0,,Кейбіреулер: «Сен мұны істей алмайсың» дейді.
Dialogue: 0,0:20:47.70,0:20:50.70,Default,,0,0,0,,Кейбір адамдар сіздің күш-жігеріңізге күледі.
Dialogue: 0,0:20:51.70,0:20:52.87,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:52.96,0:20:53.87,Default,,0,0,0,,Ах
Dialogue: 0,0:20:54.67,0:20:57.38,Default,,0,0,0,,Мұндай дауыстарды тыңдаудың қажеті жоқ.
Dialogue: 0,0:20:57.92,0:20:58.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:58.96,0:21:01.88,Default,,0,0,0,,Қателік жасамаңыз Эмото
Dialogue: 0,0:21:02.51,0:21:05.05,Default,,0,0,0,,Күш ешқашан сатқындық жасамайды
Dialogue: 0,0:21:05.13,0:21:08.10,Default,,0,0,0,,Дұрыс айтасың, тек алға.
Dialogue: 0,0:21:13.43,0:21:16.35,Default,,0,0,0,,Уау Мизуки голы!
Dialogue: 0,0:21:13.43,0:21:16.35,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:17.44,0:21:20.36,Default,,0,0,0,,Қасиетті артықшылық!
Dialogue: 0,0:21:20.44,0:21:22.15,Default,,0,0,0,,Бұл бірінші нүкте!
Dialogue: 0,0:21:22.23,0:21:23.69,Default,,0,0,0,,Жарайсың капитан!
Dialogue: 0,0:21:23.78,0:21:25.95,Default,,0,0,0,,Жақсы! (Аққу) Мен бара аламын!
Dialogue: 0,0:21:26.03,0:21:28.91,Default,,0,0,0,,Жарайсыңдар! (Мүше) Капитан - ең жақсы!
Dialogue: 0,0:21:28.99,0:21:30.83,Default,,0,0,0,,Мизуки~!
Dialogue: 0,0:21:30.91,0:21:33.25,Default,,0,0,0,,Өйткені ол сөйлей алмайды.
Dialogue: 0,0:21:33.95,0:21:36.25,Default,,0,0,0,,Сіз оны түсіндіңіз бе? Эмото
Dialogue: 0,0:21:39.50,0:21:41.42,Default,,0,0,0,,Эмото Сәлем!
Dialogue: 0,0:21:42.25,0:21:44.30,Default,,0,0,0,,Тыңдаңыз... Ах.
Dialogue: 0,0:21:48.97,0:21:50.05,Default,,0,0,0,,Иә
Dialogue: 0,0:21:51.01,0:21:55.93,Default,,0,0,0,,♪～
Dialogue: 0,0:23:15.89,0:23:20.89,Default,,0,0,0,,～♪
Dialogue: 0,0:23:32.36,0:23:34.66,Default,,0,0,0,,Бұлай аяқталмайды деп ойлаймын.
Dialogue: 0,0:23:35.74,0:23:37.16,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:23:37.99,0:23:41.46,Default,,0,0,0,,Ал центрі тұтас болғандықтан
Dialogue: 0,0:23:41.54,0:23:44.92,Default,,0,0,0,,Басқа ойыншылардың да рөлдері анық және олардан тайынбайды.
Dialogue: 0,0:23:46.17,0:23:50.13,Default,,0,0,0,,Сакура биіктің қарсы шабуылы басталады
Dialogue: 0,0:23:53.43,0:23:55.47,Default,,0,0,0,,Футбол – жинаған ұпай саны үшін жарыс.
Dialogue: 0,0:23:56.68,0:24:01.02,Default,,0,0,0,,Ұпай жинаған адам керемет, күшті және салқын.
