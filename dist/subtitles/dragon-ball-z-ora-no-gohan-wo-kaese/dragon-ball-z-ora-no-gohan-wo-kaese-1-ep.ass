Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.05,0:00:18.68,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:00:36.70,0:00:40.95,Default,,0,0,0,,Сон Гоку, мен сені бұл жолы міндетті түрде жеңемін.
Dialogue: 0,0:00:41.08,0:00:42.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:43.83,0:00:45.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:48.00,0:00:50.25,Default,,0,0,0,,Ооо...
Dialogue: 0,0:00:51.92,0:00:52.88,Default,,0,0,0,,Уф…
Dialogue: 0,0:00:54.09,0:00:56.51,Default,,0,0,0,,Не... сен кімсің! Кооо аааа
Dialogue: 0,0:01:03.48,0:01:04.43,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:01:07.56,0:01:09.94,Default,,0,0,0,,Сен... сен! Уау
Dialogue: 0,0:01:10.07,0:01:11.94,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:01:13.90,0:01:15.53,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:21.03,0:01:23.95,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:01:24.08,0:01:26.92,Default,,0,0,0,,Пикколо мен Құдай бір рухта
Dialogue: 0,0:01:27.04,0:01:29.92,Default,,0,0,0,,Енді Құдай да өлді.
Dialogue: 0,0:01:32.71,0:01:34.42,Default,,0,0,0,,Пикколо жеңілді
Dialogue: 0,0:01:34.55,0:01:38.01,Default,,0,0,0,,Сон Гоку... Аа, жоқ, бұл рас болуы мүмкін емес.
Dialogue: 0,0:01:38.13,0:01:41.81,Default,,0,0,0,,А, жақсы... мүмкін емес.
Dialogue: 0,0:01:44.56,0:01:50.56,Default,,0,0,0,,♪〜
Dialogue: 0,0:03:25.62,0:03:31.62,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:42.09,0:03:45.01,Default,,0,0,0,,Хмм... 2017 жылғы семинар...
Dialogue: 0,0:03:45.14,0:03:51.14,Default,,0,0,0,,17 және 13 жылдық дернәсілдік кезең бар ма?
Dialogue: 0,0:03:51.27,0:03:56.61,Default,,0,0,0,,Хмм... 17 жыл бойы жер астында жатыр емес пе?
Dialogue: 0,0:03:56.73,0:03:59.28,Default,,0,0,0,,Гохан-чан! (Гохан) Иә?
Dialogue: 0,0:03:59.40,0:04:01.49,Default,,0,0,0,,Түскі ас! (Гохан) А...
Dialogue: 0,0:04:02.70,0:04:05.82,Default,,0,0,0,,А... Анашым, мен де бүгін жақсы жүрмін.
Dialogue: 0,0:04:10.58,0:04:11.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.75,0:04:14.67,Default,,0,0,0,,Сәлем Гохан
Dialogue: 0,0:04:14.79,0:04:16.58,Default,,0,0,0,,Әй, бұл ата.
Dialogue: 0,0:04:16.71,0:04:18.59,Default,,0,0,0,,Ой, ой
Dialogue: 0,0:04:18.71,0:04:21.59,Default,,0,0,0,,Гохан Қалайсың? Хахаха...
Dialogue: 0,0:04:21.71,0:04:23.59,Default,,0,0,0,,Иә, атам да жақсы көрінеді.
Dialogue: 0,0:04:23.72,0:04:27.85,Default,,0,0,0,,А... Жақсымын, жақсымын, міне, кәдесый.
Dialogue: 0,0:04:27.97,0:04:29.68,Default,,0,0,0,,Уау, рахмет
Dialogue: 0,0:04:29.81,0:04:32.60,Default,,0,0,0,,Чи-Чи кітап жақсы кәдесый болатынын айтады.
Dialogue: 0,0:04:32.73,0:04:34.19,Default,,0,0,0,,Көлемді болмаңыз
Dialogue: 0,0:04:34.31,0:04:36.27,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:04:36.40,0:04:37.77,Default,,0,0,0,,Ахх... (Гохан) Хмм...
Dialogue: 0,0:04:37.90,0:04:40.15,Default,,0,0,0,,Ой, сен нені мазақ етіп тұрсың?
Dialogue: 0,0:04:41.82,0:04:42.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:42.94,0:04:48.83,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:04:48.95,0:04:51.33,Default,,0,0,0,,Ой, не болды?
Dialogue: 0,0:04:51.45,0:04:53.29,Default,,0,0,0,,Ата
Dialogue: 0,0:04:53.41,0:04:54.83,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:04:56.62,0:04:57.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:57.58,0:05:00.13,Default,,0,0,0,,Уа, ау, ау... (енді)
Dialogue: 0,0:05:00.25,0:05:03.09,Default,,0,0,0,,Ой! (Гюмау) Ух...
Dialogue: 0,0:05:03.21,0:05:06.84,Default,,0,0,0,,Ах... (Гохан) Анашым А...
Dialogue: 0,0:05:06.97,0:05:08.93,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:05:17.35,0:05:19.48,Default,,0,0,0,,Бұл кім? Сіз
Dialogue: 0,0:05:21.40,0:05:22.73,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:05:22.86,0:05:25.15,Default,,0,0,0,,Баланың басында -
Dialogue: 0,0:05:25.28,0:05:27.53,Default,,0,0,0,,Мен Айдаһар шарын алуға келдім.
Dialogue: 0,0:05:27.66,0:05:29.07,Default,,0,0,0,,Ах (Гохан) Ах...
Dialogue: 0,0:05:29.20,0:05:30.66,Default,,0,0,0,,Гохан! Үй.
Dialogue: 0,0:05:30.78,0:05:33.79,Default,,0,0,0,,Уф... Анашым Ооо.
Dialogue: 0,0:05:34.37,0:05:35.50,Default,,0,0,0,,Уау анашым!
Dialogue: 0,0:05:35.62,0:05:39.63,Default,,0,0,0,,Тезірек (Гохан) Вах уа да да да да...
Dialogue: 0,0:05:39.75,0:05:42.38,Default,,0,0,0,,Уау...Анашым
Dialogue: 0,0:05:42.50,0:05:44.46,Default,,0,0,0,,Ах (Гохан) Вах уа...
Dialogue: 0,0:05:44.59,0:05:45.84,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:45.97,0:05:47.80,Default,,0,0,0,,Ой, жақсы...
Dialogue: 0,0:05:54.77,0:05:55.68,Default,,0,0,0,,Гохан!
Dialogue: 0,0:05:56.93,0:05:58.06,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:03.98,0:06:07.57,Default,,0,0,0,,Ннн! Тейя!
Dialogue: 0,0:06:07.70,0:06:09.24,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:09.36,0:06:11.32,Default,,0,0,0,,Каа!
Dialogue: 0,0:06:11.45,0:06:13.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:13.37,0:06:14.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:14.33,0:06:16.50,Default,,0,0,0,,Анашым!
Dialogue: 0,0:06:18.04,0:06:19.25,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:20.00,0:06:21.67,Default,,0,0,0,,Чичи!
Dialogue: 0,0:06:22.54,0:06:26.76,Default,,0,0,0,,А, ана, ана, а... Гохан
Dialogue: 0,0:06:26.88,0:06:29.76,Default,,0,0,0,,Бар... Гохан, қаш.
Dialogue: 0,0:06:29.88,0:06:34.81,Default,,0,0,0,,Вах уа уа уа уа уа уа уа гигг...
Dialogue: 0,0:06:38.35,0:06:39.94,Default,,0,0,0,,Уау Уау...
Dialogue: 0,0:06:43.86,0:06:45.19,Default,,0,0,0,,Чичи!
Dialogue: 0,0:06:46.28,0:06:49.82,Default,,0,0,0,,А, аа! Не... не болды? Чичи
Dialogue: 0,0:06:49.95,0:06:53.74,Default,,0,0,0,,Ахххх... Гоку
Dialogue: 0,0:06:53.87,0:06:56.74,Default,,0,0,0,,Бар... Гоханды ұрлап әкетті.
Dialogue: 0,0:06:56.87,0:06:59.46,Default,,0,0,0,,Гохан? Гохан деген кім?
Dialogue: 0,0:06:59.58,0:07:01.67,Default,,0,0,0,,А... Мен түсінбеймін.
Dialogue: 0,0:07:01.79,0:07:05.17,Default,,0,0,0,,Жаса... Мен Айдаһардың артынан келдім.
Dialogue: 0,0:07:05.29,0:07:07.71,Default,,0,0,0,,Айдаһар добы? Қайда бардың?
Dialogue: 0,0:07:07.84,0:07:09.51,Default,,0,0,0,,Ах... (Гоку) Чичи!
Dialogue: 0,0:07:10.68,0:07:16.22,Default,,0,0,0,,(Гоханның айқайы)
Dialogue: 0,0:07:16.35,0:07:19.48,Default,,0,0,0,,Енді бізде бесеу бар.
Dialogue: 0,0:07:20.60,0:07:21.94,Default,,0,0,0,,Хаха!
Dialogue: 0,0:07:22.85,0:07:25.48,Default,,0,0,0,,Тек екі нәрсе қалды.
Dialogue: 0,0:07:26.82,0:07:29.65,Default,,0,0,0,,Имбирь Егер сізде олардың 7-і болса, Шенроннан сұраңыз...
Dialogue: 0,0:07:29.78,0:07:31.95,Default,,0,0,0,,Сіз мәңгілік өмірге ие боласыз.
Dialogue: 0,0:07:32.07,0:07:33.03,Default,,0,0,0,,Хаха!
Dialogue: 0,0:07:33.16,0:07:34.70,Default,,0,0,0,,Тағы екі
Dialogue: 0,0:07:34.82,0:07:37.20,Default,,0,0,0,,Қалған екеуінің орналасқан жерін де білеміз...
Dialogue: 0,0:07:37.33,0:07:39.66,Default,,0,0,0,,Кейінірек таңғы астың алдында пальтомен
Dialogue: 0,0:07:39.79,0:07:45.17,Default,,0,0,0,,Әй... Құдай да өледі, бірақ мен ешқашан өлмеймін.
Dialogue: 0,0:07:45.29,0:07:48.80,Default,,0,0,0,,Енді сіз кек алудың алғашқы қадамын жасай аласыз.
Dialogue: 0,0:07:48.92,0:07:52.22,Default,,0,0,0,,Жер бетіндегі барлық тіршілік иелері...
Dialogue: 0,0:07:52.34,0:07:56.60,Default,,0,0,0,,Қайғы мен үмітсіздіктің тереңдігіне сүңгетін уақыт келді.
Dialogue: 0,0:07:56.72,0:08:00.77,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:08:00.89,0:08:03.60,Default,,0,0,0,,Тез үйге қайтыңыз (күлді)
Dialogue: 0,0:08:03.73,0:08:04.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:04.69,0:08:08.44,Default,,0,0,0,,Өте шулы. Үндемесең, мен сені үйге мәңгілікке жібермеймін.
Dialogue: 0,0:08:08.57,0:08:10.65,Default,,0,0,0,,Маған көмектесуге әкем келеді.
Dialogue: 0,0:08:10.78,0:08:14.28,Default,,0,0,0,,Менің әкемнің аты Сон Гоку, ол әлемдегі ең мықты.
Dialogue: 0,0:08:14.41,0:08:17.99,Default,,0,0,0,,Не? Сон Гоку сол Тенкайчи Будокайда...
Dialogue: 0,0:08:18.12,0:08:22.04,Default,,0,0,0,,Жын патшасы Пикколоны жеңген Сон Гоку ма?
Dialogue: 0,0:08:22.16,0:08:25.54,Default,,0,0,0,,Дұрыс, мен Сон Гокудың ұлымын.
Dialogue: 0,0:08:25.67,0:08:27.08,Default,,0,0,0,,А...
Dialogue: 0,0:08:27.21,0:08:29.05,Default,,0,0,0,,Оның орнына сен жылауықсың.
Dialogue: 0,0:08:29.17,0:08:31.84,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:08:31.96,0:08:33.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:33.55,0:08:35.84,Default,,0,0,0,,Пикколо бізді де жеңуі мүмкін еді.
Dialogue: 0,0:08:35.97,0:08:36.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.97,0:08:38.80,Default,,0,0,0,,Иә, оңай болды.
Dialogue: 0,0:08:38.93,0:08:40.56,Default,,0,0,0,,Бұл бұрылыс болды.
Dialogue: 0,0:08:40.68,0:08:43.23,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:08:43.35,0:08:47.56,Default,,0,0,0,,Ммм...
Dialogue: 0,0:08:47.69,0:08:50.07,Default,,0,0,0,,Иә? Ба... ақымақ
Dialogue: 0,0:08:50.19,0:08:52.90,Default,,0,0,0,,Мен бұл жігіттен бір тылсым күш сезінемін.
Dialogue: 0,0:08:53.03,0:08:55.49,Default,,0,0,0,,Мен мұндай күшті бірінші рет сезінуім.
Dialogue: 0,0:08:55.61,0:08:59.28,Default,,0,0,0,,Оны қалай жылтырататыныңызға байланысты өте пайдалы болуы мүмкін.
Dialogue: 0,0:08:59.41,0:09:02.33,Default,,0,0,0,,Дұрыс, мен сені қызметші етемін.
Dialogue: 0,0:09:02.45,0:09:03.91,Default,,0,0,0,,Иә? Қызметші?
Dialogue: 0,0:09:04.04,0:09:05.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:05.21,0:09:09.67,Default,,0,0,0,,Әй, сен бақыттысың ғой, өлтірмеген.
Dialogue: 0,0:09:09.79,0:09:11.71,Default,,0,0,0,,Аха…
Dialogue: 0,0:09:11.84,0:09:15.17,Default,,0,0,0,,Міне, осы жігіттер сияқты күшті боласың.
Dialogue: 0,0:09:15.30,0:09:17.05,Default,,0,0,0,,Қатты ма?
Dialogue: 0,0:09:20.60,0:09:22.85,Default,,0,0,0,,Олардың мақсаты Гохан емес.
Dialogue: 0,0:09:23.68,0:09:25.27,Default,,0,0,0,,Бұл Айдаһар добы
Dialogue: 0,0:09:26.60,0:09:29.06,Default,,0,0,0,,Мен бес жинадым.
Dialogue: 0,0:09:29.19,0:09:30.73,Default,,0,0,0,,Сіз бұл туралы ерекше ойлайтыныңызға сенімдімін.
Dialogue: 0,0:09:30.86,0:09:33.69,Default,,0,0,0,,Міне (Каме Эрмит) Иә, оңтүстікте.
Dialogue: 0,0:09:33.82,0:09:35.78,Default,,0,0,0,,Қызыл теңіздің айналасында.
Dialogue: 0,0:09:36.70,0:09:38.32,Default,,0,0,0,,Мен айдаһар радарын қарызға аламын.
Dialogue: 0,0:09:38.45,0:09:39.37,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:09:39.49,0:09:44.25,Default,,0,0,0,,Гоку: Оның шеберлігі сонша, ол Чи-Чи мен Гюмауды оңай жеңе алады.
Dialogue: 0,0:09:44.37,0:09:46.50,Default,,0,0,0,,Абайлап жүр (Гоку) Ах.
Dialogue: 0,0:09:47.25,0:09:49.33,Default,,0,0,0,,Балам, абай бол.
Dialogue: 0,0:09:56.76,0:09:58.05,Default,,0,0,0,,Гоку...
Dialogue: 0,0:09:59.64,0:10:01.01,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:10:01.14,0:10:04.56,Default,,0,0,0,,Маған ұнамайды, мен үйге барамын.
Dialogue: 0,0:10:05.47,0:10:06.64,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:10:06.77,0:10:10.40,Default,,0,0,0,,Мен неге мұндай баланы күтуім керек?
Dialogue: 0,0:10:12.19,0:10:14.48,Default,,0,0,0,,Уау! Ия
Dialogue: 0,0:10:14.61,0:10:15.74,Default,,0,0,0,,Бұл!
Dialogue: 0,0:10:15.86,0:10:18.49,Default,,0,0,0,,А... аа
Dialogue: 0,0:10:18.61,0:10:23.03,Default,,0,0,0,,Шөлдедім қарным ашты
Dialogue: 0,0:10:23.16,0:10:25.66,Default,,0,0,0,,Жоқ! Оны жеме!
Dialogue: 0,0:10:25.79,0:10:28.91,Default,,0,0,0,,Өзім жеп жүрсем де
Dialogue: 0,0:10:29.04,0:10:30.71,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:10:33.09,0:10:34.38,Default,,0,0,0,,Дәмді
Dialogue: 0,0:10:36.46,0:10:38.01,Default,,0,0,0,,А, өте дәмді болды.
Dialogue: 0,0:10:38.13,0:10:39.76,Default,,0,0,0,,Бала оны жесе...
Dialogue: 0,0:10:39.88,0:10:42.55,Default,,0,0,0,,(1-қыз) Өзіңізге ұнағанша торт алыңыз
Dialogue: 0,0:10:42.68,0:10:44.89,Default,,0,0,0,,Мас болыңыз
Dialogue: 0,0:10:45.01,0:10:46.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:48.98,0:10:50.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:50.77,0:10:51.85,Default,,0,0,0,,Аха
Dialogue: 0,0:10:58.57,0:10:59.99,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:00.11,0:11:02.28,Default,,0,0,0,,Эй, эй, сәл күте тұрыңыз.
Dialogue: 0,0:11:02.41,0:11:04.87,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:31.23,0:11:33.98,Default,,0,0,0,,Ха ха ха... күте тұрыңыз!
Dialogue: 0,0:11:34.11,0:11:39.11,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:11:39.57,0:11:41.86,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:11:58.71,0:12:00.30,Default,,0,0,0,,Сәлем! (Гохан) Хахахаха
Dialogue: 0,0:12:00.42,0:12:03.51,Default,,0,0,0,,Тез, күте тұрыңыз!
Dialogue: 0,0:12:06.60,0:12:09.77,Default,,0,0,0,,Өйткені, ол жай ғана бала емес.
Dialogue: 0,0:12:21.65,0:12:27.66,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:12:27.78,0:12:32.04,Default,,0,0,0,,Ууууу... Таку! Ол менің қолымды күйдіретін бала.
Dialogue: 0,0:12:36.63,0:12:38.50,Default,,0,0,0,,Сарымсақ кіші.
Dialogue: 0,0:12:38.63,0:12:40.84,Default,,0,0,0,,Бұл соңғы екеуі
Dialogue: 0,0:12:47.05,0:12:49.31,Default,,0,0,0,,Енді сізде бәрі бар.
Dialogue: 0,0:12:49.43,0:12:53.31,Default,,0,0,0,,Енді Шенрон тілегіңді орындасын.
Dialogue: 0,0:12:53.43,0:12:55.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:55.85,0:12:57.31,Default,,0,0,0,,Ахх
Dialogue: 0,0:12:59.65,0:13:01.19,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:04.70,0:13:06.32,Default,,0,0,0,,ол немесе сенімге толы қуғыншы,
Dialogue: 0,0:13:06.45,0:13:08.16,Default,,0,0,0,,Кел, Айдаһар
Dialogue: 0,0:13:15.62,0:13:19.00,Default,,0,0,0,,Иә? Бұл жігіттер, Шенрон...
Dialogue: 0,0:13:23.67,0:13:27.05,Default,,0,0,0,,Уау (Сарымсақ кіші) Керемет...
Dialogue: 0,0:13:44.28,0:13:47.36,Default,,0,0,0,,Қане, тілегіңді айт.
Dialogue: 0,0:13:47.49,0:13:52.62,Default,,0,0,0,,Қандай тілегің болса да, мен тек біреуін орындаймын.
Dialogue: 0,0:13:53.70,0:13:56.37,Default,,0,0,0,,Мәңгілік өмір!
Dialogue: 0,0:13:56.50,0:13:59.46,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:14:00.29,0:14:02.71,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:06.42,0:14:08.47,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:09.13,0:14:10.93,Default,,0,0,0,,О, о...
Dialogue: 0,0:14:14.39,0:14:18.31,Default,,0,0,0,,Охххх...
Dialogue: 0,0:14:21.44,0:14:28.32,Default,,0,0,0,,Адамдар, бұдан былай дүниенің билеушісі менмін.
Dialogue: 0,0:14:29.45,0:14:32.37,Default,,0,0,0,,Қараңғыда жасырынған Чимма-Рё
Dialogue: 0,0:14:32.49,0:14:38.41,Default,,0,0,0,,Сиқырды бұзып ұзақ шыдамдылықтан қайта тіріл
Dialogue: 0,0:14:38.54,0:14:44.46,Default,,0,0,0,,Бүкіл әлемге мейірімсіз қан жаусын.
Dialogue: 0,0:14:47.46,0:14:51.22,Default,,0,0,0,,Мен бұл дүниені өмірден таусылмай билей аламын.
Dialogue: 0,0:14:51.34,0:14:56.64,Default,,0,0,0,,Уа, адамдар, бәрі маған мойынсұнбайынша қорқыныш болады.
Dialogue: 0,0:14:56.77,0:14:58.64,Default,,0,0,0,,Мәңгілік жалғасады
Dialogue: 0,0:14:58.77,0:15:01.81,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:15:01.94,0:15:06.61,Default,,0,0,0,,Менің тілегім орындалды
Dialogue: 0,0:15:06.73,0:15:11.61,Default,,0,0,0,,Спидвегон, мен мұнда келдім —
Dialogue: 0,0:15:18.87,0:15:21.42,Default,,0,0,0,,Ува-ку-ку-у-у!
Dialogue: 0,0:15:27.88,0:15:30.26,Default,,0,0,0,,Енді қорқатын ештеңе жоқ
Dialogue: 0,0:15:30.38,0:15:32.09,Default,,0,0,0,,Әкем үшін кек ал
Dialogue: 0,0:15:32.22,0:15:36.68,Default,,0,0,0,,Құдайдың нұры берілген барлық адамдарды өлтіріңіз.
Dialogue: 0,0:15:36.81,0:15:42.48,Default,,0,0,0,,Дүниені мен қалағандай етіп жасаңыз Хаха!
Dialogue: 0,0:15:46.19,0:15:48.98,Default,,0,0,0,,Біздің сарымсақ кіші.
Dialogue: 0,0:15:52.32,0:15:54.70,Default,,0,0,0,,5 йен
Dialogue: 0,0:15:54.82,0:15:56.37,Default,,0,0,0,,Гоханды қайтарыңыз!
Dialogue: 0,0:15:56.49,0:15:58.66,Default,,0,0,0,,Гоханды қайтар! Иә?
Dialogue: 0,0:15:58.79,0:16:00.37,Default,,0,0,0,,Гоханды қайтарыңыз!
Dialogue: 0,0:16:00.50,0:16:01.41,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:16:03.54,0:16:05.25,Default,,0,0,0,,Сіз Сон Гокусыз.
Dialogue: 0,0:16:05.38,0:16:06.63,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:06.75,0:16:09.88,Default,,0,0,0,,Гюмаудың ағасы мен Чичи ауырды.
Dialogue: 0,0:16:11.59,0:16:14.26,Default,,0,0,0,,Уф... мен де сені ренжітемін.
Dialogue: 0,0:16:14.39,0:16:15.05,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:16:15.18,0:16:18.85,Default,,0,0,0,,Уф... иә?
Dialogue: 0,0:16:18.97,0:16:19.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:22.85,0:16:24.48,Default,,0,0,0,,Оу...
Dialogue: 0,0:16:28.02,0:16:29.53,Default,,0,0,0,,Құдай!
Dialogue: 0,0:16:29.86,0:16:32.24,Default,,0,0,0,,Пикколо деген жігіт өлген жоқ па?
Dialogue: 0,0:16:32.36,0:16:34.32,Default,,0,0,0,,Құдай, қажетсіз істермен айналыспа.
Dialogue: 0,0:16:34.45,0:16:38.16,Default,,0,0,0,,О? Ах... Сон Гоку бұрынғыдай.
Dialogue: 0,0:16:38.28,0:16:40.66,Default,,0,0,0,,Хехе... Құдай, қош келдіңіз.
Dialogue: 0,0:16:40.79,0:16:45.33,Default,,0,0,0,,Ақыр соңында, сарымсақ 300 жылдан кейін өмірге келді ме?
Dialogue: 0,0:16:45.46,0:16:48.71,Default,,0,0,0,,Ол өз амбицияларын орындау үшін қолынан келгеннің бәрін жасайды.
Dialogue: 0,0:16:48.84,0:16:50.67,Default,,0,0,0,,Менің әкем сияқты.
Dialogue: 0,0:16:50.80,0:16:51.76,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:16:51.88,0:16:54.80,Default,,0,0,0,,Ата-ана ата-ана болса, балалар да бала.
Dialogue: 0,0:16:54.93,0:16:58.76,Default,,0,0,0,,Құдай тағына сарымсақ әкеңмен жарысатының рас.
Dialogue: 0,0:16:58.89,0:17:01.81,Default,,0,0,0,,Мен сенің мұрагерің болып сайландым.
Dialogue: 0,0:17:01.93,0:17:07.02,Default,,0,0,0,,Өйткені алдыңғы құдай Сарымсақтың амбицияларын көрді.
Dialogue: 0,0:17:13.49,0:17:17.78,Default,,0,0,0,,Бұған қанағаттанбаған Сарымсақ Құдайға қарсы шықты.
Dialogue: 0,0:17:17.91,0:17:23.08,Default,,0,0,0,,Сондықтан Құдай өз құдіретін мөрлейді.
Dialogue: 0,0:17:29.50,0:17:35.13,Default,,0,0,0,,Ол 300 жылдан кейін міндетті түрде қайта тірілемін деп қиналып айқайлады, бірақ...
Dialogue: 0,0:17:35.26,0:17:40.01,Default,,0,0,0,,Кегін балаға сеніп тапсыратындай кекшіл болады деп ойламаппын.
Dialogue: 0,0:17:40.14,0:17:43.64,Default,,0,0,0,,Хмф, егер сіз де Құдай тағына отырмайынша...
Dialogue: 0,0:17:43.77,0:17:47.31,Default,,0,0,0,,Мен кек алып өлмес едім.
Dialogue: 0,0:17:47.44,0:17:50.48,Default,,0,0,0,,О, бұл маңызды емес. Гохан қайда?
Dialogue: 0,0:17:50.61,0:17:53.23,Default,,0,0,0,,Қарғыс атқан бала әлі ұйықтап жатыр.
Dialogue: 0,0:17:53.36,0:17:54.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:56.07,0:17:57.45,Default,,0,0,0,,Орта?
Dialogue: 0,0:18:00.41,0:18:01.58,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:18:02.20,0:18:03.83,Default,,0,0,0,,Мен үшін уайымдама — тез арада көліктен шық
Dialogue: 0,0:18:15.42,0:18:21.43,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:18:21.55,0:18:23.35,Default,,0,0,0,,Гохан!
Dialogue: 0,0:18:25.97,0:18:27.94,Default,,0,0,0,,Егер сіз сол баспалдақпен көтерілгіңіз келсе
Dialogue: 0,0:18:28.06,0:18:30.48,Default,,0,0,0,,Алдымен бізді жеңіп алайық.
Dialogue: 0,0:18:31.40,0:18:34.07,Default,,0,0,0,,Зімбір, сарымсақ триосының бірі
Dialogue: 0,0:18:34.19,0:18:36.19,Default,,0,0,0,,Сондай-ақ Ники
Dialogue: 0,0:18:36.32,0:18:38.40,Default,,0,0,0,,Сондай-ақ Саншо
Dialogue: 0,0:18:41.53,0:18:42.53,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:18:54.38,0:18:56.51,Default,,0,0,0,,Фуфуфуфуфуфуфу!
Dialogue: 0,0:18:58.59,0:18:59.84,Default,,0,0,0,,Ол, бәлкім, бір әйелмен көңіл көтеріп жүрген шығар, иә?
Dialogue: 0,0:19:00.18,0:19:01.68,Default,,0,0,0,,Жарайды, келіңіз.
Dialogue: 0,0:19:01.80,0:19:03.55,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,0:19:03.68,0:19:05.22,Default,,0,0,0,,Зімбір
Dialogue: 0,0:19:05.35,0:19:06.81,Default,,0,0,0,,Түйін
Dialogue: 0,0:19:06.93,0:19:08.98,Default,,0,0,0,,Унаджуцу
Dialogue: 0,0:19:09.10,0:19:09.98,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:19:10.10,0:19:11.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:12.10,0:19:13.11,Default,,0,0,0,,Каа!
Dialogue: 0,0:19:13.23,0:19:14.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:14.98,0:19:16.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:26.03,0:19:26.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:27.04,0:19:28.95,Default,,0,0,0,,Угаааа
Dialogue: 0,0:19:37.05,0:19:38.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:39.01,0:19:40.67,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:44.47,0:19:46.51,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:46.64,0:19:48.22,Default,,0,0,0,,Ол, бәлкім, бір әйелмен көңіл көтеріп жүрген шығар, иә?
Dialogue: 0,0:19:48.85,0:19:52.52,Default,,0,0,0,,Мұны жасамаңыз. Ол үлкенірек және жылдамырақ болды.
Dialogue: 0,0:19:52.64,0:19:53.69,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:19:54.65,0:19:55.48,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:20:00.78,0:20:03.78,Default,,0,0,0,,Құдай оңай өледі деп ойлайсың ба?
Dialogue: 0,0:20:03.91,0:20:08.12,Default,,0,0,0,,Маған Шенрон мәңгілік өмір сыйлады.
Dialogue: 0,0:20:08.24,0:20:11.04,Default,,0,0,0,,Мен ешқашан жеңілмеймін
Dialogue: 0,0:20:12.08,0:20:15.04,Default,,0,0,0,,Сен мақтаншақ ақымақсың
Dialogue: 0,0:20:18.17,0:20:21.13,Default,,0,0,0,,Мұндай техника Орада жұмыс істемейді.
Dialogue: 0,0:20:22.30,0:20:25.39,Default,,0,0,0,,Уряларыяля торя!
Dialogue: 0,0:20:29.35,0:20:30.31,Default,,0,0,0,,Толя!
Dialogue: 0,0:20:30.43,0:20:31.89,Default,,0,0,0,,Ах…
Dialogue: 0,0:20:32.35,0:20:34.23,Default,,0,0,0,,Есік...
Dialogue: 0,0:20:34.35,0:20:36.06,Default,,0,0,0,,Wo...
Dialogue: 0,0:20:37.36,0:20:38.77,Default,,0,0,0,,Гохан қайда!
Dialogue: 0,0:20:38.90,0:20:41.78,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:20:41.90,0:20:43.90,Default,,0,0,0,,Тея!
Dialogue: 0,0:20:45.74,0:20:46.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:46.70,0:20:48.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:48.49,0:20:49.62,Default,,0,0,0,,О...
Dialogue: 0,0:20:51.16,0:20:52.87,Default,,0,0,0,,Не! (Гоку) О
Dialogue: 0,0:21:00.17,0:21:01.80,Default,,0,0,0,,Криллин
Dialogue: 0,0:21:02.71,0:21:04.80,Default,,0,0,0,,Сасық, Гоку.
Dialogue: 0,0:21:04.93,0:21:06.09,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:21:09.18,0:21:11.60,Default,,0,0,0,,Иә? Бірақ мен тағы бір нәрсе бар екеніне сенімдімін ...
Dialogue: 0,0:21:11.72,0:21:15.31,Default,,0,0,0,,Немерем, менің де осында екенімді ұмытпа.
Dialogue: 0,0:21:21.44,0:21:22.40,Default,,0,0,0,,Пикколо!
Dialogue: 0,0:21:22.53,0:21:23.61,Default,,0,0,0,,Пикколо?
Dialogue: 0,0:21:24.15,0:21:25.70,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:26.74,0:21:27.74,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:21:27.86,0:21:30.28,Default,,0,0,0,,Аххх...
Dialogue: 0,0:21:31.54,0:21:34.45,Default,,0,0,0,,Хе... мен саған көмектесу үшін келген жоқпын.
Dialogue: 0,0:21:34.58,0:21:36.46,Default,,0,0,0,,Мен бұл жігіттерге қарыздармын
Dialogue: 0,0:21:38.13,0:21:40.09,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:21:40.21,0:21:41.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:43.76,0:21:46.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:46.88,0:21:49.55,Default,,0,0,0,,А, а?
Dialogue: 0,0:21:51.60,0:21:56.89,Default,,0,0,0,,(Гоханның ұйқылы дауысы)
Dialogue: 0,0:21:57.02,0:21:58.85,Default,,0,0,0,,(ұйқылы дауыс)
Dialogue: 0,0:21:58.98,0:22:00.65,Default,,0,0,0,,Ух-бех…
Dialogue: 0,0:22:00.77,0:22:02.65,Default,,0,0,0,,Сәлем Гохан!
Dialogue: 0,0:22:02.77,0:22:04.57,Default,,0,0,0,,О, ол жоғалып кетті
Dialogue: 0,0:22:07.15,0:22:09.70,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:22:10.57,0:22:12.03,Default,,0,0,0,,Тея!
Dialogue: 0,0:22:12.24,0:22:13.62,Default,,0,0,0,,О…
Dialogue: 0,0:22:16.71,0:22:17.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:19.42,0:22:21.17,Default,,0,0,0,,Охххх...
Dialogue: 0,0:22:21.29,0:22:22.09,Default,,0,0,0,,Тея!
Dialogue: 0,0:22:22.21,0:22:23.71,Default,,0,0,0,,Wo...
Dialogue: 0,0:22:23.84,0:22:25.46,Default,,0,0,0,,Тея!
Dialogue: 0,0:22:25.96,0:22:27.13,Default,,0,0,0,,Уау...
Dialogue: 0,0:22:30.09,0:22:33.89,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:22:34.01,0:22:37.89,Default,,0,0,0,,Гохан! (Гоханның ұйқылы дауысы)
Dialogue: 0,0:22:38.02,0:22:39.64,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:22:39.77,0:22:41.35,Default,,0,0,0,,Криллин Гоханды сұрайды
Dialogue: 0,0:22:41.48,0:22:43.48,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:22:44.82,0:22:47.11,Default,,0,0,0,,Ооо...
Dialogue: 0,0:22:56.83,0:22:58.54,Default,,0,0,0,,А, ә...
Dialogue: 0,0:22:59.46,0:23:02.25,Default,,0,0,0,,Мен үшін уайымдама — тез арада көліктен шық
Dialogue: 0,0:23:02.63,0:23:06.25,Default,,0,0,0,,Гах! Ой ой…
Dialogue: 0,0:23:10.47,0:23:13.10,Default,,0,0,0,,Мен сенің қарызыңды толық өтеймін.
Dialogue: 0,0:23:13.22,0:23:15.31,Default,,0,0,0,,Ооо жақсы...
Dialogue: 0,0:23:15.85,0:23:16.97,Default,,0,0,0,,Ах
Dialogue: 0,0:23:19.48,0:23:20.44,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:23:25.48,0:23:27.98,Default,,0,0,0,,(Саншоның айқайы)
Dialogue: 0,0:23:29.40,0:23:33.49,Default,,0,0,0,,Үш адам күтпеген шабуыл болмаса, менімен күресе аласыз ба?
Dialogue: 0,0:23:33.62,0:23:37.87,Default,,0,0,0,,Қалжыңдама, мен саған жетемін.
Dialogue: 0,0:23:37.99,0:23:39.96,Default,,0,0,0,,Дея!
Dialogue: 0,0:23:42.87,0:23:45.50,Default,,0,0,0,,Хахаха... Тек сонша күш пе?
Dialogue: 0,0:23:47.63,0:23:49.71,Default,,0,0,0,,Уф! Уау...
Dialogue: 0,0:23:54.76,0:23:56.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:56.18,0:23:58.52,Default,,0,0,0,,Яяяяяяя!
Dialogue: 0,0:24:00.27,0:24:01.52,Default,,0,0,0,,Ахх...
Dialogue: 0,0:24:01.64,0:24:03.19,Default,,0,0,0,,Каа!
Dialogue: 0,0:24:03.31,0:24:05.06,Default,,0,0,0,,Дея…
Dialogue: 0,0:24:06.94,0:24:10.65,Default,,0,0,0,,Гааааааааааааа... мынау құбыжық
Dialogue: 0,0:24:13.32,0:24:16.16,Default,,0,0,0,,Бірінен соң бірі түкке тұрғысыз.
Dialogue: 0,0:24:16.91,0:24:19.83,Default,,0,0,0,,Уау...
Dialogue: 0,0:24:24.92,0:24:27.13,Default,,0,0,0,,Гухаа!
Dialogue: 0,0:24:33.01,0:24:36.09,Default,,0,0,0,,(Сарымсақ кішінің күлкісі)
Dialogue: 0,0:24:37.76,0:24:42.77,Default,,0,0,0,,Енді мен қараңғылыққа толы идеалды әлемді жасаймын.
Dialogue: 0,0:24:43.39,0:24:46.31,Default,,0,0,0,,Тыныштықпен кетіңіз
Dialogue: 0,0:24:47.69,0:24:49.61,Default,,0,0,0,,Ха!
Dialogue: 0,0:24:49.73,0:24:51.11,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,0:24:52.11,0:24:54.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:56.36,0:24:58.70,Default,,0,0,0,,О... мен!
Dialogue: 0,0:25:03.66,0:25:07.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:09.54,0:25:14.59,Default,,0,0,0,,Хмм... Тах!
Dialogue: 0,0:25:14.72,0:25:17.39,Default,,0,0,0,,Iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii!
Dialogue: 0,0:25:21.22,0:25:23.10,Default,,0,0,0,,Тея!
Dialogue: 0,0:25:23.23,0:25:25.10,Default,,0,0,0,,Ахххх... Уау!
Dialogue: 0,0:25:29.73,0:25:31.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:25:33.94,0:25:34.95,Default,,0,0,0,,Уау...
Dialogue: 0,0:25:35.53,0:25:37.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:38.95,0:25:41.16,Default,,0,0,0,,Өсу! Нёи таяқ
Dialogue: 0,0:25:42.83,0:25:44.66,Default,,0,0,0,,Ааа!
Dialogue: 0,0:25:54.21,0:25:57.30,Default,,0,0,0,,Аля ха!
Dialogue: 0,0:25:58.97,0:25:59.84,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:26:01.55,0:26:03.43,Default,,0,0,0,,Уау...
Dialogue: 0,0:26:03.56,0:26:05.93,Default,,0,0,0,,Камехаме…
Dialogue: 0,0:26:06.06,0:26:07.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:26:07.81,0:26:10.61,Default,,0,0,0,,Толқындар!
Dialogue: 0,0:26:10.73,0:26:11.61,Default,,0,0,0,,Wo...
Dialogue: 0,0:26:11.73,0:26:13.61,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:26:13.73,0:26:15.11,Default,,0,0,0,,Уау...
Dialogue: 0,0:26:15.24,0:26:17.24,Default,,0,0,0,,Ахх...
Dialogue: 0,0:26:17.78,0:26:20.66,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:26:29.87,0:26:32.92,Default,,0,0,0,,(Сарымсақ кішінің күлкісі)
Dialogue: 0,0:26:33.04,0:26:35.30,Default,,0,0,0,,Ескі солдаттар енді ғана жоғалып барады
Dialogue: 0,0:26:35.42,0:26:40.39,Default,,0,0,0,,Әкеңнің ызасын есіңе ал. Енді соңғы соққыны беретін кез келді.
Dialogue: 0,0:26:40.51,0:26:42.14,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:26:42.26,0:26:47.89,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:26:48.02,0:26:49.89,Default,,0,0,0,,Мен әлі жердің құдайымын
Dialogue: 0,0:26:50.02,0:26:52.73,Default,,0,0,0,,Дүниедегі үстемдігіңмен —
Dialogue: 0,0:26:52.86,0:26:55.11,Default,,0,0,0,,Қанша бақытсыздық пен апат әкеледі?
Dialogue: 0,0:26:55.23,0:26:56.40,Default,,0,0,0,,Мен білемін деп ойлаймын
Dialogue: 0,0:26:56.53,0:27:00.03,Default,,0,0,0,,Менің өмірім қымбат болса да, мен сенің қалағаныңды істеуге рұқсат бермеймін.
Dialogue: 0,0:27:00.16,0:27:02.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:02.16,0:27:04.91,Default,,0,0,0,,Ооо... (Құдай) Ооо!
Dialogue: 0,0:27:05.04,0:27:08.83,Default,,0,0,0,,Ақымақ! Бір-біріңді пышақтай аламын дейсің бе?
Dialogue: 0,0:27:08.96,0:27:10.00,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:27:10.12,0:27:13.92,Default,,0,0,0,,Бұл мен істей алатын соңғы нәрсе болуы мүмкін.
Dialogue: 0,0:27:14.04,0:27:16.09,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:27:16.21,0:27:19.42,Default,,0,0,0,,Сен өлсең де, мен өлмеймін
Dialogue: 0,0:27:19.55,0:27:20.59,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:27:20.72,0:27:22.76,Default,,0,0,0,,Шынында да, сен өлмеуің мүмкін.
Dialogue: 0,0:27:22.89,0:27:23.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:24.43,0:27:25.39,Default,,0,0,0,,Ах
Dialogue: 0,0:27:25.51,0:27:29.02,Default,,0,0,0,,Бірақ өмір мәңгілік болса да—
Dialogue: 0,0:27:29.14,0:27:32.19,Default,,0,0,0,,Қолыңнан ештеңе келмесе, бұл тозақ
Dialogue: 0,0:27:32.31,0:27:34.94,Default,,0,0,0,,Мен саған тозақ азабын таттырамын
Dialogue: 0,0:27:36.23,0:27:38.03,Default,,0,0,0,,Пикколо! Хмф
Dialogue: 0,0:27:39.82,0:27:41.11,Default,,0,0,0,,Уф…
Dialogue: 0,0:27:43.74,0:27:45.91,Default,,0,0,0,,Криллин, мен Гоханды сұраймын.
Dialogue: 0,0:27:46.83,0:27:48.62,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:27:50.79,0:27:55.21,Default,,0,0,0,,Хмф... Бұл ұят, Сон Гоку Пикколо.
Dialogue: 0,0:27:55.34,0:27:56.84,Default,,0,0,0,,Сіз сияқты адамдар...
Dialogue: 0,0:27:56.96,0:28:00.38,Default,,0,0,0,,Лас құдайлардың көмегінен бас тартпа.
Dialogue: 0,0:28:01.38,0:28:07.31,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:28:07.43,0:28:09.10,Default,,0,0,0,,Уф…
Dialogue: 0,0:28:10.10,0:28:12.19,Default,,0,0,0,,Мен керемет күшті сезінемін
Dialogue: 0,0:28:12.69,0:28:14.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:14.31,0:28:15.48,Default,,0,0,0,,Уф…
Dialogue: 0,0:28:20.57,0:28:21.49,Default,,0,0,0,,Ахх...
Dialogue: 0,0:28:21.61,0:28:22.82,Default,,0,0,0,,О!
Dialogue: 0,0:28:25.78,0:28:26.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:32.54,0:28:34.50,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:28:39.50,0:28:41.01,Default,,0,0,0,,Ах... Қарғыс атсын.
Dialogue: 0,0:28:43.76,0:28:46.85,Default,,0,0,0,,Құдай, маған мына жерден қарашы! Ха!
Dialogue: 0,0:28:46.97,0:28:48.93,Default,,0,0,0,,Өтінемін, Гоку
Dialogue: 0,0:28:49.06,0:28:52.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:28:59.90,0:29:01.07,Default,,0,0,0,,Фу…
Dialogue: 0,0:29:01.74,0:29:03.95,Default,,0,0,0,,Уау...
Dialogue: 0,0:29:04.20,0:29:06.24,Default,,0,0,0,,Пикколо, кет!
Dialogue: 0,0:29:06.36,0:29:08.41,Default,,0,0,0,,Әй, атататт...
Dialogue: 0,0:29:11.70,0:29:13.08,Default,,0,0,0,,Уф... (Гоку) Хмф...
Dialogue: 0,0:29:13.20,0:29:14.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:22.34,0:29:24.30,Default,,0,0,0,,Ah Ah...
Dialogue: 0,0:29:26.63,0:29:28.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:33.43,0:29:34.89,Default,,0,0,0,,Аяя яя яя...
Dialogue: 0,0:29:37.06,0:29:38.10,Default,,0,0,0,,Ах…
Dialogue: 0,0:29:59.96,0:30:00.67,Default,,0,0,0,,Уф…
Dialogue: 0,0:30:03.76,0:30:06.47,Default,,0,0,0,,Уа (Сарымсақ кіші) Уау!
Dialogue: 0,0:30:07.47,0:30:09.05,Default,,0,0,0,,О, қарғыс атсын!
Dialogue: 0,0:30:10.26,0:30:14.85,Default,,0,0,0,,(Сарымсақ кішінің күлкісі)
Dialogue: 0,0:30:28.32,0:30:30.28,Default,,0,0,0,,Уау...
Dialogue: 0,0:30:31.28,0:30:34.08,Default,,0,0,0,,Екі адамға соншама?
Dialogue: 0,0:30:34.20,0:30:36.45,Default,,0,0,0,,Қарғыс атсын, бұл керемет күш.
Dialogue: 0,0:30:36.58,0:30:39.00,Default,,0,0,0,,Күтсең, өлтіресің.
Dialogue: 0,0:30:47.22,0:30:49.13,Default,,0,0,0,,Ха... оны шешіп алайын ба?
Dialogue: 0,0:30:49.26,0:30:52.89,Default,,0,0,0,,Бар күшіңді жұмсамасаң, бәлеге қаласың.
Dialogue: 0,0:30:57.10,0:30:59.85,Default,,0,0,0,,Иә? Пикколо: Сен де ауырсың...
Dialogue: 0,0:30:59.98,0:31:04.19,Default,,0,0,0,,Ха... Сіз жалғыз жаттығу емессіз.
Dialogue: 0,0:31:04.36,0:31:07.11,Default,,0,0,0,,Ола екеуің бірге ұрысып жатқаныңа сенбеймін.
Dialogue: 0,0:31:07.24,0:31:11.87,Default,,0,0,0,,Сіз оны жеңгеннен кейін, сіздің кезегіңіз.
Dialogue: 0,0:31:11.99,0:31:13.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:13.16,0:31:15.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:31:15.45,0:31:16.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:31:31.30,0:31:32.84,Default,,0,0,0,,Ахх...
Dialogue: 0,0:31:39.06,0:31:40.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:31:40.18,0:31:40.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:31:42.90,0:31:48.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:02.67,0:32:06.42,Default,,0,0,0,,Ха ха ха... Пикколо
Dialogue: 0,0:32:06.54,0:32:08.17,Default,,0,0,0,,Хаха...
Dialogue: 0,0:32:10.80,0:32:13.18,Default,,0,0,0,,Пикколо, сен...
Dialogue: 0,0:32:13.30,0:32:15.30,Default,,0,0,0,,Артқа тартыңыз.
Dialogue: 0,0:32:15.43,0:32:18.39,Default,,0,0,0,,Немерем! Енді мәселені шешу кезегі бізге келді.
Dialogue: 0,0:32:18.51,0:32:19.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:21.39,0:32:23.81,Default,,0,0,0,,Қараңдаршы, мұны істеуден басқа амалымыз жоқ.
Dialogue: 0,0:32:33.03,0:32:35.32,Default,,0,0,0,,Ха!
Dialogue: 0,0:32:35.45,0:32:41.41,Default,,0,0,0,,Мен өлімді айтуым керек еді! Эй!
Dialogue: 0,0:32:56.84,0:32:59.06,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:32:59.89,0:33:01.06,Default,,0,0,0,,Уау...
Dialogue: 0,0:33:01.18,0:33:04.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:17.20,0:33:19.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:20.33,0:33:21.87,Default,,0,0,0,,Әй... (Гоку) Әй!
Dialogue: 0,0:33:22.00,0:33:25.04,Default,,0,0,0,,Ах... (Гоку) Пикколо Кук!
Dialogue: 0,0:33:29.71,0:33:34.01,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:33:34.13,0:33:37.26,Default,,0,0,0,,А... Гокудың баласы ма?
Dialogue: 0,0:33:37.84,0:33:40.60,Default,,0,0,0,,Жарайды... Бұл ауызда болады деп ойламадым.
Dialogue: 0,0:33:42.18,0:33:44.27,Default,,0,0,0,,Гохан!
Dialogue: 0,0:33:50.57,0:33:53.44,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:33:53.57,0:33:56.11,Default,,0,0,0,,Мен ебедейсіз еліктеушімін.
Dialogue: 0,0:33:56.57,0:33:58.24,Default,,0,0,0,,Тея! (Гоку) А...
Dialogue: 0,0:33:59.49,0:34:00.49,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:34:00.62,0:34:05.79,Default,,0,0,0,,Барлығы, бәрі, мен жасаған өлі аймаққа сіңіп кетіңіз.
Dialogue: 0,0:34:05.91,0:34:08.08,Default,,0,0,0,,Бірде-бір жарық сәулесі жарқырамайды
Dialogue: 0,0:34:08.21,0:34:13.76,Default,,0,0,0,,Сіз өлгенше жаныңыз бен тәніңіз мұздайтын қараңғы тозаққа қамаласыз.
Dialogue: 0,0:34:17.05,0:34:20.30,Default,,0,0,0,,Уа, уф...
Dialogue: 0,0:34:23.43,0:34:25.31,Default,,0,0,0,,Оооу...
Dialogue: 0,0:34:25.98,0:34:27.77,Default,,0,0,0,,Аххх...
Dialogue: 0,0:34:29.10,0:34:31.31,Default,,0,0,0,,(Сарымсақ кішінің күлкісі)
Dialogue: 0,0:34:31.98,0:34:33.86,Default,,0,0,0,,(Гоханның айқайы)
Dialogue: 0,0:34:33.98,0:34:39.86,Default,,0,0,0,,(Гоханның айқайы)
Dialogue: 0,0:34:39.99,0:34:42.87,Default,,0,0,0,,Уккук... Гохан! (жылау)
Dialogue: 0,0:34:42.99,0:34:44.87,Default,,0,0,0,,Уф... (жылап)
Dialogue: 0,0:34:49.79,0:34:52.38,Default,,0,0,0,,Коу!
Dialogue: 0,0:34:52.50,0:34:53.50,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:34:53.63,0:34:58.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:58.63,0:35:01.51,Default,,0,0,0,,Коу!
Dialogue: 0,0:35:01.64,0:35:03.05,Default,,0,0,0,,Гохан!
Dialogue: 0,0:35:03.18,0:35:06.06,Default,,0,0,0,,Қой!
Dialogue: 0,0:35:06.18,0:35:10.06,Default,,0,0,0,,Уууу... Ол бала менің қолымнан келмейді.
Dialogue: 0,0:35:10.19,0:35:13.06,Default,,0,0,0,,Унуууууууууууууууу!
Dialogue: 0,0:35:13.19,0:35:18.07,Default,,0,0,0,,Бұл қандай күш? Өйткені, ол қарапайым адам емес еді.
Dialogue: 0,0:35:18.19,0:35:20.07,Default,,0,0,0,,Дея!
Dialogue: 0,0:35:20.20,0:35:24.58,Default,,0,0,0,,Нуну... Ку!
Dialogue: 0,0:35:24.70,0:35:29.62,Default,,0,0,0,,Мен бар күшімді жіберемін Гваа!
Dialogue: 0,0:35:31.75,0:35:33.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:34.67,0:35:39.30,Default,,0,0,0,,Аяяяя!
Dialogue: 0,0:35:39.42,0:35:41.30,Default,,0,0,0,,Укккк…
Dialogue: 0,0:35:41.43,0:35:43.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:43.43,0:35:45.26,Default,,0,0,0,,Уау... (Гохан) Уау!
Dialogue: 0,0:35:45.43,0:35:47.68,Default,,0,0,0,,Торя!
Dialogue: 0,0:35:48.43,0:35:51.14,Default,,0,0,0,,Уууу…
Dialogue: 0,0:35:51.27,0:35:55.82,Default,,0,0,0,,Әй, қарт кісі, жақсысың ба? Ауырған жоқсың ба?
Dialogue: 0,0:35:55.94,0:35:59.49,Default,,0,0,0,,Ааааааааааааааа...
Dialogue: 0,0:35:59.61,0:36:01.99,Default,,0,0,0,,Тах!
Dialogue: 0,0:36:02.11,0:36:03.70,Default,,0,0,0,,Ууууууууууууу...
Dialogue: 0,0:36:04.16,0:36:05.53,Default,,0,0,0,,Гохан!
Dialogue: 0,0:36:05.66,0:36:06.70,Default,,0,0,0,,Уау...
Dialogue: 0,0:36:06.83,0:36:08.16,Default,,0,0,0,,Ахх...
Dialogue: 0,0:36:08.29,0:36:10.16,Default,,0,0,0,,Гоку!
Dialogue: 0,0:36:10.29,0:36:13.04,Default,,0,0,0,,Әке!
Dialogue: 0,0:36:14.79,0:36:19.09,Default,,0,0,0,,Ахх...
Dialogue: 0,0:36:20.51,0:36:24.93,Default,,0,0,0,,Мен өлмеймін, мәңгілік өмірге қол жеткіздім.
Dialogue: 0,0:36:25.05,0:36:28.60,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:36:36.52,0:36:38.86,Default,,0,0,0,,Палуба...
Dialogue: 0,0:36:44.99,0:36:46.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:21.53,0:37:23.95,Default,,0,0,0,,А, а, а...
Dialogue: 0,0:37:25.32,0:37:27.49,Default,,0,0,0,,Немесе… Құдай-ау, Кіші Сарымсақ ше?
Dialogue: 0,0:37:27.62,0:37:32.08,Default,,0,0,0,,Өзі жаратқан тозаққа түсті.
Dialogue: 0,0:37:32.75,0:37:37.71,Default,,0,0,0,,Сарымсақ сонда мәңгі өмір сүруі керек
Dialogue: 0,0:37:37.83,0:37:44.01,Default,,0,0,0,,Ах... Мәңгілік өмірге ие болғаныңа өкінетін шығарсың.
Dialogue: 0,0:37:50.18,0:37:51.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:51.97,0:37:54.35,Default,,0,0,0,,Ах Гохан
Dialogue: 0,0:37:55.60,0:38:00.15,Default,,0,0,0,,Әй, әке, сен маған көмектесуге келдің ғой.
Dialogue: 0,0:38:00.27,0:38:01.77,Default,,0,0,0,,​​О?
Dialogue: 0,0:38:03.82,0:38:05.86,Default,,0,0,0,,Гохан есіңде жоқ па?
Dialogue: 0,0:38:05.99,0:38:08.91,Default,,0,0,0,,Өйткені, менің әкем әлемдегі ең мықты.
Dialogue: 0,0:38:09.03,0:38:09.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:11.74,0:38:13.62,Default,,0,0,0,,Иә? Ха…
Dialogue: 0,0:38:13.79,0:38:17.08,Default,,0,0,0,,Ах ха ха ха...
Dialogue: 0,0:38:18.29,0:38:23.17,Default,,0,0,0,,Гохан, қандай қорқынышты жағдай. Енді анамызға оралайық.
Dialogue: 0,0:38:23.30,0:38:26.92,Default,,0,0,0,,Иә! Хафф...
Dialogue: 0,0:38:44.07,0:38:49.45,Default,,0,0,0,,Сон Гоку, мен мұны бір күні міндетті түрде шешемін.
Dialogue: 0,0:38:51.49,0:38:55.41,Default,,0,0,0,,Кіші Сарымсақтың да үлкен амбициясы
Dialogue: 0,0:38:55.54,0:39:00.25,Default,,0,0,0,,Гоку мен оның достарының күшімен бұл арман сияқты аяқталды.
Dialogue: 0,0:39:00.37,0:39:04.00,Default,,0,0,0,,Гокуды ұлы Гохан құтқарды...
Dialogue: 0,0:39:04.13,0:39:07.55,Default,,0,0,0,,Мен Чичиге айтуды ойладым, бірақ...
Dialogue: 0,0:39:09.22,0:39:11.97,Default,,0,0,0,,Иә? Эххе...
Dialogue: 0,0:39:12.97,0:39:15.43,Default,,0,0,0,,Мен Чи-Чиге бәрібір сенбеймін.
Dialogue: 0,0:39:16.02,0:39:19.06,Default,,0,0,0,,Гохан есейгенде, бұл туралы сөйлесейік.
Dialogue: 0,0:39:34.62,0:39:40.62,Default,,0,0,0,,♪〜
Dialogue: 0,0:41:02.33,0:41:08.34,Default,,0,0,0,,〜♪
