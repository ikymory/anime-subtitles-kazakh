Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.91,0:00:02.37,Default,,0,0,0,,Иә, қайталаңыз.
Dialogue: 0,0:00:02.75,0:00:05.25,Default,,0,0,0,,Әскери полицияның жедел әрекет етуіне байланысты
Dialogue: 0,0:00:05.33,0:00:08.25,Default,,0,0,0,,Чернобогтағы тәртіпсіздіктер аяқталуға жақын.
Dialogue: 0,0:00:08.71,0:00:11.38,Default,,0,0,0,,Көпшілік аймақтарда тобыр залалсыздандырылды.
Dialogue: 0,0:00:11.47,0:00:14.05,Default,,0,0,0,,Қауіпсіздік қамтамасыз етілген.
Dialogue: 0,0:00:14.68,0:00:16.97,Default,,0,0,0,,Азаматтар үйден шықпауы керек
Dialogue: 0,0:00:17.05,0:00:19.60,Default,,0,0,0,,Әскери полицияның толық жеңісін күтіңіз
Dialogue: 0,0:00:20.14,0:00:21.14,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:00:21.23,0:00:23.77,Default,,0,0,0,,Әскери полицияның жедел әрекет етуіне байланысты
Dialogue: 0,0:00:23.85,0:00:27.02,Default,,0,0,0,,Чернобогтағы тәртіпсіздіктер аяқталуға жақын.
Dialogue: 0,0:00:27.40,0:00:29.98,Default,,0,0,0,,Көптеген аймақтарда тобыр бейтараптандырылды.
Dialogue: 0,0:00:30.36,0:00:32.78,Default,,0,0,0,,Капитан!! Жаулар өте көп!! Осы қарқынмен...
Dialogue: 0,0:00:33.70,0:00:34.57,Default,,0,0,0,,Ауру жұқтырған адамдар...
Dialogue: 0,0:00:34.66,0:00:35.91,Default,,0,0,0,,Оны жалама
Dialogue: 0,0:00:36.16,0:00:38.49,Default,,0,0,0,,Қарғыс атсын! Күшейткіштер әлі келген жоқ.
Dialogue: 0,0:00:39.03,0:00:39.95,Default,,0,0,0,,Дүрбелең емес!!
Dialogue: 0,0:00:40.04,0:00:42.04,Default,,0,0,0,,Олар бір топ қоқыстар ғой!!
Dialogue: 0,0:00:42.25,0:00:44.46,Default,,0,0,0,,Мәртебелі үшін бәрі
Dialogue: 0,0:00:44.58,0:00:45.83,Default,,0,0,0,,Эй... балалар!
Dialogue: 0,0:00:45.92,0:00:47.67,Default,,0,0,0,,Жаудың алдынан қашуға рұқсат етілсе...!!
Dialogue: 0,0:00:48.25,0:00:54.05,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:00:58.68,0:01:01.06,Default,,0,0,0,,Хаха... Мен қашып үлгердім...!
Dialogue: 0,0:01:01.56,0:01:03.02,Default,,0,0,0,,Аһ...!?
Dialogue: 0,0:01:07.77,0:01:08.69,Default,,0,0,0,,Кеттік
Dialogue: 0,0:01:09.52,0:01:11.23,Default,,0,0,0,,Қара капюшон киген жігітпен араласпа
Dialogue: 0,0:01:11.90,0:01:12.99,Default,,0,0,0,,Қалғандарды өлтіріңіз
Dialogue: 0,0:02:45.87,0:02:47.87,Default,,0,0,0,,Чернобогтағы тәртіпсіздіктер
Dialogue: 0,0:02:47.95,0:02:51.54,Default,,0,0,0,,Әскери полицияның жедел әрекетімен ол аяқталуға жақын.
Dialogue: 0,0:02:51.88,0:02:54.04,Default,,0,0,0,,Барлық дерлік аймақтар тыныштандырылған.
Dialogue: 0,0:02:54.29,0:02:56.25,Default,,0,0,0,,Жағдай қазірдің өзінде тынышталды.
Dialogue: 0,0:02:56.92,0:02:57.88,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:02:58.67,0:03:00.51,Default,,0,0,0,,Чернобогтағы тәртіпсіздіктер
Dialogue: 0,0:03:00.59,0:03:03.80,Default,,0,0,0,,Әскери полицияның жедел әрекетімен ол аяқталуға жақын.
Dialogue: 0,0:03:03.89,0:03:06.56,Default,,0,0,0,,Мұндай жалған есептерді қалай жасауға болады?
Dialogue: 0,0:03:06.64,0:03:07.77,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:03:07.97,0:03:10.64,Default,,0,0,0,,Урсус әскери полициясының бұл дәрежеде итермелейтінін елестету қиын.
Dialogue: 0,0:03:11.19,0:03:14.61,Default,,0,0,0,,Үкіметтің жағдайды байыппен басуға ниеті жоқ сияқты.
Dialogue: 0,0:03:15.65,0:03:18.69,Default,,0,0,0,,... Реюньонның сахна артындағы жұмыстарды атқара алатынын елестету қиын, бірақ...
Dialogue: 0,0:03:18.78,0:03:19.70,Default,,0,0,0,,О
Dialogue: 0,0:03:19.99,0:03:23.45,Default,,0,0,0,,Бірақ жағдайға қарасақ, бұл әбден мүмкін.
Dialogue: 0,0:03:24.37,0:03:25.24,Default,,0,0,0,,Амия
Dialogue: 0,0:03:26.37,0:03:28.70,Default,,0,0,0,,Бізге қазір қосыла алмаймыз.
Dialogue: 0,0:03:28.79,0:03:30.37,Default,,0,0,0,,Сенің сезіміңді түсінемін, бірақ
Dialogue: 0,0:03:30.66,0:03:33.54,Default,,0,0,0,,Дәрігерді Родосқа қайтару – біздің басты міндетіміз.
Dialogue: 0,0:03:34.17,0:03:35.46,Default,,0,0,0,,...
Dialogue: 0,0:03:35.96,0:03:37.38,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:03:37.96,0:03:40.63,Default,,0,0,0,,Жағдайың жақсы, Амия.
Dialogue: 0,0:03:41.38,0:03:42.13,Default,,0,0,0,,Эйс мырза
Dialogue: 0,0:03:42.93,0:03:46.51,Default,,0,0,0,,Жалғыз нәрсе - Ниаллдың және скауттардың отрядымен кездесіп, қашу.
Dialogue: 0,0:03:46.93,0:03:48.10,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:03:49.73,0:03:50.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:50.98,0:03:52.06,Default,,0,0,0,,Дәрігер?
Dialogue: 0,0:03:52.48,0:03:53.19,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:53.60,0:03:54.31,Default,,0,0,0,,Тұман
Dialogue: 0,0:03:55.61,0:03:56.82,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:03:57.11,0:03:58.07,Default,,0,0,0,,Шынында да...
Dialogue: 0,0:03:58.69,0:04:00.24,Default,,0,0,0,,Барған сайын қараңғыланып барады
Dialogue: 0,0:04:01.36,0:04:02.61,Default,,0,0,0,,Жау өнері...!
Dialogue: 0,0:04:03.45,0:04:04.61,Default,,0,0,0,,Шеңбер бойымен қалыптасу
Dialogue: 0,0:04:04.70,0:04:05.45,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:06.16,0:04:07.99,Default,,0,0,0,,Жауынгерлер зембілдердің айналасында орналасады
Dialogue: 0,0:04:08.08,0:04:09.20,Default,,0,0,0,,Шаршы құрастыр!
Dialogue: 0,0:04:09.54,0:04:10.75,Default,,0,0,0,,Көріну анық болған кезде
Dialogue: 0,0:04:10.95,0:04:11.66,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:04:11.79,0:04:13.58,Default,,0,0,0,,Дұшпандық нысана көрінбейді
Dialogue: 0,0:04:13.79,0:04:16.88,Default,,0,0,0,,Күй жаңартылды. Жаудың ұшқышсыз ұшағы көрінеді
Dialogue: 0,0:04:19.21,0:04:22.63,Default,,0,0,0,,Барлық достық барлаушылар ұшқышсыз ұшқыштар соққыға ұшырады және жарамдылық мерзімі бітті
Dialogue: 0,0:04:22.80,0:04:26.14,Default,,0,0,0,,Барлық мүшелер...!! Ағаштың көлеңкесіне көшіңіз! Асығыңыз!!!!!
Dialogue: 0,0:04:30.31,0:04:32.64,Default,,0,0,0,,Мүмкін... ескерту атуы...
Dialogue: 0,0:04:33.44,0:04:37.02,Default,,0,0,0,,Мақсат бізді бөлу...?
Dialogue: 0,0:04:38.52,0:04:39.65,Default,,0,0,0,,Тұман көп...
Dialogue: 0,0:04:40.44,0:04:42.24,Default,,0,0,0,,Бұл сіздің одақтастарыңыздың орнын көрсетеді...
Dialogue: 0,0:04:42.32,0:04:43.90,Default,,0,0,0,,Кяаааааа!!!! Тоқта!
Dialogue: 0,0:04:44.20,0:04:44.91,Default,,0,0,0,,Айтыңызшы!!!
Dialogue: 0,0:04:44.99,0:04:45.61,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:50.24,0:04:51.12,Default,,0,0,0,,Амия
Dialogue: 0,0:04:51.66,0:04:52.50,Default,,0,0,0,,Доберман мырза!
Dialogue: 0,0:04:52.83,0:04:55.58,Default,,0,0,0,,Эйс жолдың арғы жағында төбелесіп жатыр.
Dialogue: 0,0:04:55.67,0:04:56.79,Default,,0,0,0,,Жаулардың саны белгісіз болса да
Dialogue: 0,0:04:56.92,0:04:58.25,Default,,0,0,0,,Көп емес сияқты.
Dialogue: 0,0:04:58.92,0:05:00.84,Default,,0,0,0,,Бұдан былай сигнал бомбаларымен қолдау шақырыңыз.
Dialogue: 0,0:05:01.05,0:05:02.76,Default,,0,0,0,,Тұман иесін ұрамыз
Dialogue: 0,0:05:02.84,0:05:04.13,Default,,0,0,0,,Көрінуді жақсарту
Dialogue: 0,0:05:04.63,0:05:06.55,Default,,0,0,0,,Қарсыласты күшейту арқылы жеңу
Dialogue: 0,0:05:06.72,0:05:08.09,Default,,0,0,0,,Бұл жерден қашайық.
Dialogue: 0,0:05:08.22,0:05:09.01,Default,,0,0,0,,Иә!...!
Dialogue: 0,0:05:09.68,0:05:10.47,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:11.06,0:05:12.18,Default,,0,0,0,,Дәрігер жоқ!
Dialogue: 0,0:05:12.39,0:05:13.18,Default,,0,0,0,,Не!?
Dialogue: 0,0:05:13.81,0:05:15.35,Default,,0,0,0,,Сіз бірге болдыңыз ба?!
Dialogue: 0,0:05:20.94,0:05:21.78,Default,,0,0,0,,...
Dialogue: 0,0:05:23.11,0:05:24.74,Default,,0,0,0,,Шу шығарсаң, мен сені өлтіремін.
Dialogue: 0,0:05:25.32,0:05:27.07,Default,,0,0,0,,Мен біреуді іздеп жүрмін
Dialogue: 0,0:05:28.37,0:05:30.74,Default,,0,0,0,,Олардан білетіндерінің бәрін айтып беруін сұраңыз
Dialogue: 0,0:05:31.08,0:05:31.95,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:05:32.29,0:05:34.45,Default,,0,0,0,,Мен ештеңе білмеймін ...
Dialogue: 0,0:05:35.54,0:05:37.71,Default,,0,0,0,,Ұмытып қалдым деп айтпа
Dialogue: 0,0:05:38.75,0:05:40.38,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:05:40.96,0:05:43.59,Default,,0,0,0,,Бұл менің аймағым, солай ма?
Dialogue: 0,0:05:43.76,0:05:45.26,Default,,0,0,0,,Кез келген ерікті әрекет
Dialogue: 0,0:05:45.59,0:05:48.13,Default,,0,0,0,,Сіз бұл туралы хабарлауыңыз керек, солай ма?
Dialogue: 0,0:05:48.26,0:05:50.26,Default,,0,0,0,,Тәжі өлтіруші
Dialogue: 0,0:05:50.43,0:05:53.06,Default,,0,0,0,,Бірақ мен мейірімдімін
Dialogue: 0,0:05:53.31,0:05:55.27,Default,,0,0,0,,Егер қазір кетсеңіз
Dialogue: 0,0:05:55.35,0:05:57.39,Default,,0,0,0,,Көрген жоқпыз деп алайық
Dialogue: 0,0:06:02.73,0:06:04.61,Default,,0,0,0,,Жау шегініп жатыр...?
Dialogue: 0,0:06:05.40,0:06:06.82,Default,,0,0,0,,Тұман сейілді...
Dialogue: 0,0:06:09.95,0:06:11.03,Default,,0,0,0,,Дәрігер...!
Dialogue: 0,0:06:11.70,0:06:12.74,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:06:12.87,0:06:14.49,Default,,0,0,0,,Енді қайтып келе аласыз ба?
Dialogue: 0,0:06:14.70,0:06:17.79,Default,,0,0,0,,Сізде әлі жұмыс бар.
Dialogue: 0,0:06:17.87,0:06:19.00,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:06:19.37,0:06:21.42,Default,,0,0,0,,Ол адамнан аулақ болыңыз
Dialogue: 0,0:06:22.34,0:06:23.00,Default,,0,0,0,,А...
Dialogue: 0,0:06:23.67,0:06:26.42,Default,,0,0,0,,Мен сенің байғұс жеңілгеніңді асыға күтемін.
Dialogue: 0,0:06:26.67,0:06:27.55,Default,,0,0,0,,А...
Dialogue: 0,0:06:27.63,0:06:29.34,Default,,0,0,0,,Айтпа...
Dialogue: 0,0:06:31.09,0:06:33.97,Default,,0,0,0,,Жау басшыларының үйлесімділігі жоқ.
Dialogue: 0,0:06:34.85,0:06:36.35,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,0:06:36.43,0:06:38.52,Default,,0,0,0,,Тәжі өлтірушінің дөрекілігін кешіріңіз!
Dialogue: 0,0:06:39.10,0:06:40.15,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:06:40.23,0:06:42.36,Default,,0,0,0,,Олардың шабуылға ниеті жоқ сияқты...
Dialogue: 0,0:06:42.44,0:06:44.40,Default,,0,0,0,,Мен әлі білмеймін, босаңсыма
Dialogue: 0,0:06:44.61,0:06:46.57,Default,,0,0,0,,Командир аман!
Dialogue: 0,0:06:46.78,0:06:48.53,Default,,0,0,0,,Мен кенеттен кешірім сұраймын.
Dialogue: 0,0:06:48.70,0:06:49.40,Default,,0,0,0,,Енді жүріңіз
Dialogue: 0,0:06:49.70,0:06:50.74,Default,,0,0,0,,Дәрігер!!
Dialogue: 0,0:06:50.99,0:06:51.66,Default,,0,0,0,,Эй
Dialogue: 0,0:06:51.74,0:06:52.41,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:06:52.49,0:06:53.12,Default,,0,0,0,,...Ах
Dialogue: 0,0:06:53.28,0:06:54.03,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:06:54.12,0:06:55.04,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,0:06:55.12,0:06:56.54,Default,,0,0,0,,Бұл бала тұманның иесі ме?
Dialogue: 0,0:06:56.75,0:06:57.54,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:57.62,0:07:00.04,Default,,0,0,0,,Дәрігерді Тұман Лордтан босатқан сияқты.
Dialogue: 0,0:07:00.67,0:07:02.21,Default,,0,0,0,,Мен сенің не ойлап тұрғаныңды білмеймін.
Dialogue: 0,0:07:03.04,0:07:04.92,Default,,0,0,0,,Хмм...тыңдаңыз.
Dialogue: 0,0:07:05.34,0:07:06.96,Default,,0,0,0,,Бақытымызға орай, олардың барлығы тірі.
Dialogue: 0,0:07:07.51,0:07:08.97,Default,,0,0,0,,Бірнеше адам жарақат алды
Dialogue: 0,0:07:09.05,0:07:10.18,Default,,0,0,0,,Бұл қорқынышты жара.
Dialogue: 0,0:07:10.63,0:07:11.76,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:07:11.84,0:07:14.80,Default,,0,0,0,,Осы жерден өтсеңіз, емдеуге болатын жер бар.
Dialogue: 0,0:07:14.97,0:07:15.64,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:07:15.72,0:07:17.10,Default,,0,0,0,,Жақсы қайтарылды.
Dialogue: 0,0:07:17.18,0:07:18.43,Default,,0,0,0,,Кеттік
Dialogue: 0,0:07:18.56,0:07:21.48,Default,,0,0,0,,Жарайды, бәрі сәйкес келетін сияқты!
Dialogue: 0,0:07:21.81,0:07:23.94,Default,,0,0,0,,Мен өзімді таныстыруға кешігіп қалдым.
Dialogue: 0,0:07:24.06,0:07:25.48,Default,,0,0,0,,Менің атым Мефисто
Dialogue: 0,0:07:25.98,0:07:29.49,Default,,0,0,0,,Енді менімен қызықты ойындар ойнап көрейік!
Dialogue: 0,0:07:29.86,0:07:32.28,Default,,0,0,0,,Ақыр соңында, мен оны елемеуге мүмкіндік жоқ.
Dialogue: 0,0:07:32.57,0:07:34.12,Default,,0,0,0,,Мен уақытты сатып аламын
Dialogue: 0,0:07:34.24,0:07:35.08,Default,,0,0,0,,Жүр!
Dialogue: 0,0:07:36.08,0:07:39.00,Default,,0,0,0,,Балалардың ойынына қатысуға уақытым жоқ!
Dialogue: 0,0:07:39.16,0:07:40.71,Default,,0,0,0,,О, ау
Dialogue: 0,0:07:40.79,0:07:44.67,Default,,0,0,0,,Мен сізді шын жүректен қуантуға тырысамын.
Dialogue: 0,0:07:44.88,0:07:46.25,Default,,0,0,0,,Сіз қашуға тырысасыз ба?
Dialogue: 0,0:07:46.34,0:07:47.59,Default,,0,0,0,,Тоқта!!! Бұл буктурма!
Dialogue: 0,0:07:48.17,0:07:51.26,Default,,0,0,0,,Уайымдамаңыз, мен әлі ештеңе істемеймін.
Dialogue: 0,0:07:51.55,0:07:52.43,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:07:52.63,0:07:54.43,Default,,0,0,0,,Балалар мен сендерге қызығамын.
Dialogue: 0,0:07:55.35,0:07:57.85,Default,,0,0,0,,Мен құжаттарды оқыдым.
Dialogue: 0,0:07:58.22,0:07:59.93,Default,,0,0,0,,Бұл фармацевтикалық компания болса да
Dialogue: 0,0:08:00.02,0:08:02.85,Default,,0,0,0,,Шындық пробиркаларды тізіп қоюдан да көп.
Dialogue: 0,0:08:03.14,0:08:05.94,Default,,0,0,0,,Адамның өмірін қимайтын тиімсіз күрес
Dialogue: 0,0:08:06.02,0:08:08.23,Default,,0,0,0,,Оны ұстанатындар
Dialogue: 0,0:08:08.32,0:08:10.24,Default,,0,0,0,,Өте қызықты.
Dialogue: 0,0:08:10.32,0:08:13.95,Default,,0,0,0,,Ең бастысы, сен сол саркофагтан шығарылғансың.
Dialogue: 0,0:08:14.03,0:08:14.66,Default,,0,0,0,,Иә
Dialogue: 0,0:08:14.74,0:08:18.16,Default,,0,0,0,,Сен, бетіңді жасырып жүрген қара капюшон.
Dialogue: 0,0:08:18.45,0:08:20.75,Default,,0,0,0,,Сіз бізден сәл ерекшеленетін сияқтысыз.
Dialogue: 0,0:08:20.83,0:08:22.08,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:08:22.16,0:08:23.46,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:08:23.62,0:08:26.71,Default,,0,0,0,,Сен сонда қалай тірі қалдың?
Dialogue: 0,0:08:27.63,0:08:30.09,Default,,0,0,0,,...
Dialogue: 0,0:08:30.67,0:08:32.30,Default,,0,0,0,,Бұл — әуе кемелерін қорғап қалудың жалғыз жолы.
Dialogue: 0,0:08:32.88,0:08:35.51,Default,,0,0,0,,Маған қайтарып бере аласыз ба?
Dialogue: 0,0:08:35.59,0:08:36.14,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:08:36.55,0:08:37.64,Default,,0,0,0,,Өзіңді алдама!!!!
Dialogue: 0,0:08:38.01,0:08:40.35,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:08:40.43,0:08:44.44,Default,,0,0,0,,Егер сіз оны маған қайтарсаңыз, мен оны жібере алар едім, бірақ...
Dialogue: 0,0:08:44.52,0:08:46.31,Default,,0,0,0,,Жарайды, ойын ойнайық.
Dialogue: 0,0:08:46.73,0:08:48.15,Default,,0,0,0,,Міне, ережелер
Dialogue: 0,0:08:48.23,0:08:52.03,Default,,0,0,0,,Себебі, менің «достарым» сені бөлшектеп тастамақ.
Dialogue: 0,0:08:52.15,0:08:55.53,Default,,0,0,0,,Егер сіз оны жойсаңыз және тіпті бір адам аман қалсаңыз, сіз жеңесіз!
Dialogue: 0,0:08:55.74,0:08:56.53,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:56.74,0:08:59.03,Default,,0,0,0,,Бұл оңай және қызықты ойын!
Dialogue: 0,0:08:59.12,0:09:01.16,Default,,0,0,0,,Жақында табиғи апат болады.
Dialogue: 0,0:09:01.24,0:09:02.08,Default,,0,0,0,,Неге...!
Dialogue: 0,0:09:02.20,0:09:03.83,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:03.91,0:09:09.09,Default,,0,0,0,,Табиғи апат жақындап қалған фестиваль үшін тамаша уақыт емес пе?
Dialogue: 0,0:09:09.59,0:09:10.46,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:09:10.55,0:09:11.59,Default,,0,0,0,,Мақсаты не!!
Dialogue: 0,0:09:11.88,0:09:13.88,Default,,0,0,0,,Мақсаты? Сақтық כ
Dialogue: 0,0:09:14.05,0:09:15.59,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:09:15.76,0:09:18.55,Default,,0,0,0,,Біздің жоспарымызға қатысы жоқтар
Dialogue: 0,0:09:18.76,0:09:20.93,Default,,0,0,0,,Осында өлсем бе, қашсам ба
Dialogue: 0,0:09:21.01,0:09:22.93,Default,,0,0,0,,Бұл шынымен де маңызды емес.
Dialogue: 0,0:09:23.02,0:09:24.02,Default,,0,0,0,,Жынды...
Dialogue: 0,0:09:24.27,0:09:24.60,Default,,0,0,0,,Сіз мені естисіз бе...
Dialogue: 0,0:09:25.23,0:09:26.19,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:09:26.27,0:09:28.15,Default,,0,0,0,,Әңгімелеуді доғарайық.
Dialogue: 0,0:09:29.02,0:09:30.02,Default,,0,0,0,,Сіз капюшондасыз! Маған көңіл көтеруіңізді өтінемін.
Dialogue: 0,0:09:32.36,0:09:33.11,Default,,0,0,0,,Сіз капюшондасыз! Маған көңіл көтеруіңізді өтінемін.
Dialogue: 0,0:09:35.28,0:09:36.24,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:09:42.33,0:09:43.16,Default,,0,0,0,,Жүгіру!!!!
Dialogue: 0,0:09:43.24,0:09:44.75,Default,,0,0,0,,Ахахахаха!!
Dialogue: 0,0:09:45.21,0:09:49.25,Default,,0,0,0,,Бұл қорқақ Тәжі өлтірушімен бірдей қимыл!
Dialogue: 0,0:09:49.33,0:09:52.05,Default,,0,0,0,,Бұл сізге уақытты да сатып алмайды!
Dialogue: 0,0:09:52.88,0:09:55.09,Default,,0,0,0,,Сиқыршы C5 шабуылы
Dialogue: 0,0:09:57.97,0:09:58.89,Default,,0,0,0,,Амансың ба!!
Dialogue: 0,0:09:58.97,0:10:00.60,Default,,0,0,0,,Келесі - b6
Dialogue: 0,0:10:01.01,0:10:02.10,Default,,0,0,0,,Сонымен...!
Dialogue: 0,0:10:03.56,0:10:04.93,Default,,0,0,0,,Қуып жетті
Dialogue: 0,0:10:05.02,0:10:08.44,Default,,0,0,0,,Жүр, азапыңды көрсетші...
Dialogue: 0,0:10:09.02,0:10:11.02,Default,,0,0,0,,Иә? О?
Dialogue: 0,0:10:11.36,0:10:13.07,Default,,0,0,0,,Олардың саны аз сияқты.
Dialogue: 0,0:10:13.40,0:10:16.24,Default,,0,0,0,,Жарақат алған адаммен бірге қашуға қалай дәтің бар?
Dialogue: 0,0:10:16.32,0:10:19.86,Default,,0,0,0,,Қандай адамгершілігі жоқ, біліксіз командир.
Dialogue: 0,0:10:19.95,0:10:21.95,Default,,0,0,0,,Маған мұндай нәрсе ұнайды.
Dialogue: 0,0:10:22.03,0:10:24.12,Default,,0,0,0,,Мазалау үшін өлтіруге тұрарлық
Dialogue: 0,0:10:25.16,0:10:26.33,Default,,0,0,0,,Бар!
Dialogue: 0,0:10:26.41,0:10:27.75,Default,,0,0,0,,Бұл g3!
Dialogue: 0,0:10:29.29,0:10:30.46,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:10:30.54,0:10:31.67,Default,,0,0,0,,Жақында...!
Dialogue: 0,0:10:39.05,0:10:40.30,Default,,0,0,0,,Амия-сан!!!
Dialogue: 0,0:10:41.64,0:10:43.47,Default,,0,0,0,,Бұл үлкен мәселе емес еді.
Dialogue: 0,0:10:44.06,0:10:44.97,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:10:45.06,0:10:47.48,Default,,0,0,0,,Жаңбырлы түнде шашыраған ұшқын сияқты...
Dialogue: 0,0:10:48.14,0:10:49.27,Default,,0,0,0,,Өл
Dialogue: 0,0:10:51.27,0:10:52.40,Default,,0,0,0,,Не!!?
Dialogue: 0,0:10:53.65,0:10:55.61,Default,,0,0,0,,Күшейткіштер ше...?
Dialogue: 0,0:10:55.69,0:10:57.44,Default,,0,0,0,,Өзіңізді алдамаңыз!!!!!
Dialogue: 0,0:10:57.94,0:10:58.90,Default,,0,0,0,,Келдің бе!
Dialogue: 0,0:10:59.24,0:11:00.91,Default,,0,0,0,,Кешігіп қалғаным үшін кешіріңіз.
Dialogue: 0,0:11:01.24,0:11:01.99,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:02.07,0:11:03.49,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:04.08,0:11:05.95,Default,,0,0,0,,Сіз дәрігерсіз бе?
Dialogue: 0,0:11:06.16,0:11:08.29,Default,,0,0,0,,Казимьер Найт Ниар
Dialogue: 0,0:11:09.12,0:11:11.79,Default,,0,0,0,,Біз сені алып кетуге келдік.
Dialogue: 0,0:11:19.17,0:11:20.47,Default,,0,0,0,,...Сынған...
Dialogue: 0,0:11:21.30,0:11:23.26,Default,,0,0,0,,Менің ойыным...
Dialogue: 0,0:11:23.47,0:11:24.39,Default,,0,0,0,,Сынған...!!!
Dialogue: 0,0:11:26.68,0:11:28.89,Default,,0,0,0,,Сіздің сарбаздарыңыз олқылыққа толы.
Dialogue: 0,0:11:29.81,0:11:32.44,Default,,0,0,0,,Қала базасын басып алған Реюньон
Dialogue: 0,0:11:32.60,0:11:34.90,Default,,0,0,0,,тиімдірек жылжытылды
Dialogue: 0,0:11:35.94,0:11:39.65,Default,,0,0,0,,Сіз тобырдың көбеюіне және азаматтарды қыруға рұқсат етіңіз.
Dialogue: 0,0:11:40.03,0:11:43.78,Default,,0,0,0,,Олар тек өздерінің негізгі талғамын қанағаттандырады.
Dialogue: 0,0:11:44.03,0:11:45.28,Default,,0,0,0,,Бағыну!!!
Dialogue: 0,0:11:47.58,0:11:50.54,Default,,0,0,0,,Фауст!!! Мына жігіттің аузын жап!!!
Dialogue: 0,0:11:54.08,0:11:55.71,Default,,0,0,0,,Не? Сіз оны қабылдадыңыз ба ...?
Dialogue: 0,0:11:56.04,0:11:57.46,Default,,0,0,0,,Мергендерден сақ болыңыз!!!
Dialogue: 0,0:11:57.55,0:11:58.50,Default,,0,0,0,,Түтін экранын орнатыңыз!!
Dialogue: 0,0:11:58.59,0:12:00.05,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:12:00.17,0:12:01.42,Default,,0,0,0,,Тағы да!!
Dialogue: 0,0:12:01.51,0:12:02.76,Default,,0,0,0,,Оны бөліктерге бөліңіз!!!
Dialogue: 0,0:12:04.84,0:12:06.10,Default,,0,0,0,,Айқас атыс...!?
Dialogue: 0,0:12:08.01,0:12:09.10,Default,,0,0,0,,Неге...
Dialogue: 0,0:12:09.31,0:12:12.02,Default,,0,0,0,,Ниалл-сан, зардап шеккендерді эвакуациялау аяқталды!
Dialogue: 0,0:12:12.14,0:12:13.06,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:13.14,0:12:14.15,Default,,0,0,0,,Барлық қызметкерлер шығарылады!!
Dialogue: 0,0:12:14.65,0:12:15.23,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:15.81,0:12:19.23,Default,,0,0,0,,Мен қалағандай өлмейсің...!!!
Dialogue: 0,0:12:19.32,0:12:21.95,Default,,0,0,0,,Мына жігіттер... әлі тұра ала ма...!
Dialogue: 0,0:12:22.03,0:12:22.95,Default,,0,0,0,,Асығыңыз!!
Dialogue: 0,0:12:23.15,0:12:23.95,Default,,0,0,0,,Амия!
Dialogue: 0,0:12:24.03,0:12:24.95,Default,,0,0,0,,Қолдау жеткілікті
Dialogue: 0,0:12:25.03,0:12:25.95,Default,,0,0,0,,Сіз де асығыңыз!!
Dialogue: 0,0:12:26.03,0:12:26.95,Default,,0,0,0,,Иә!!
Dialogue: 0,0:12:27.53,0:12:29.45,Default,,0,0,0,,Вуууууууууу...
Dialogue: 0,0:12:29.54,0:12:31.75,Default,,0,0,0,,Кококококоросу...!!
Dialogue: 0,0:12:33.92,0:12:35.04,Default,,0,0,0,,Көмегің үшін рахмет!
Dialogue: 0,0:12:35.17,0:12:35.83,Default,,0,0,0,,Кеттік!!
Dialogue: 0,0:12:35.92,0:12:36.58,Default,,0,0,0,,Взвод командирі, тіпті біз Әйел Титанын қолға түсірсек те,
Dialogue: 0,0:12:38.84,0:12:40.26,Default,,0,0,0,,Тек Ниалл қалды!!
Dialogue: 0,0:12:44.55,0:12:45.39,Default,,0,0,0,,Ниалл мырза!!!
Dialogue: 0,0:12:47.26,0:12:48.22,Default,,0,0,0,,Осы жолмен!!
Dialogue: 0,0:12:50.06,0:12:51.02,Default,,0,0,0,,Ха, ха…
Dialogue: 0,0:12:55.73,0:12:57.65,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:12:57.73,0:13:00.02,Default,,0,0,0,,Бұл қызық ойын болды.
Dialogue: 0,0:13:01.69,0:13:02.94,Default,,0,0,0,,Мефисто
Dialogue: 0,0:13:03.03,0:13:04.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:04.53,0:13:05.49,Default,,0,0,0,,Сәтсіз
Dialogue: 0,0:13:05.66,0:13:06.66,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:13:06.74,0:13:08.03,Default,,0,0,0,,Кешірім сұрама
Dialogue: 0,0:13:08.12,0:13:09.74,Default,,0,0,0,,Бұл олардың кінәсі
Dialogue: 0,0:13:10.62,0:13:11.70,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:13:11.79,0:13:15.54,Default,,0,0,0,,Бұл Талула апа Чернобог орталығын бақылауға алған кезде болды.
Dialogue: 0,0:13:16.29,0:13:18.58,Default,,0,0,0,,Мен апама барамын.
Dialogue: 0,0:13:18.92,0:13:21.59,Default,,0,0,0,,Мен сізді Родосты қуумен қалдыра аламын ба?
Dialogue: 0,0:13:21.80,0:13:22.55,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:13:23.51,0:13:25.63,Default,,0,0,0,,Сол жәндіктер
Dialogue: 0,0:13:25.72,0:13:27.55,Default,,0,0,0,,Әпкеңнің қолынан келсін.
Dialogue: 0,0:13:29.14,0:13:30.05,Default,,0,0,0,,Фауст
Dialogue: 0,0:13:30.85,0:13:31.97,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:13:32.72,0:13:35.69,Default,,0,0,0,,Қанша бағынышты болғаны маңызды емес
Dialogue: 0,0:13:35.81,0:13:38.35,Default,,0,0,0,,Өзіңді бірінші орынға қою
Dialogue: 0,0:13:38.48,0:13:39.48,Default,,0,0,0,,Ұнады ма?
Dialogue: 0,0:13:40.32,0:13:41.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:41.61,0:13:44.07,Default,,0,0,0,,Келіңдер, бауырларым.
Dialogue: 0,0:13:45.11,0:13:46.95,Default,,0,0,0,,Біздің уақыт
Dialogue: 0,0:13:47.03,0:13:48.87,Default,,0,0,0,,Сізді алып кету үшін
Dialogue: 0,0:13:53.87,0:13:55.58,Default,,0,0,0,,Зардап шеккен адам емделгеннен кейін
Dialogue: 0,0:13:55.66,0:13:57.04,Default,,0,0,0,,Дереу кетіңіз
Dialogue: 0,0:13:57.42,0:13:59.21,Default,,0,0,0,,Қашып кетуге бір ғана тыныс қалды.
Dialogue: 0,0:13:59.42,0:14:01.63,Default,,0,0,0,,Барлығыңыз сәл шыдамдылық танытыңыз.
Dialogue: 0,0:14:02.71,0:14:04.46,Default,,0,0,0,,Ол қатты бұзылған сияқты
Dialogue: 0,0:14:05.01,0:14:07.30,Default,,0,0,0,,Мен мұндай нәрсе болады деп ешқашан күтпедім.
Dialogue: 0,0:14:08.18,0:14:09.26,Default,,0,0,0,,Амия-сан
Dialogue: 0,0:14:09.34,0:14:10.43,Default,,0,0,0,,...2c мұнда
Dialogue: 0,0:14:11.18,0:14:12.06,Default,,0,0,0,,Иә
Dialogue: 0,0:14:12.14,0:14:13.89,Default,,0,0,0,,Azazel клиникасы
Dialogue: 0,0:14:16.02,0:14:17.14,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:14:17.23,0:14:18.44,Default,,0,0,0,,Осы елде
Dialogue: 0,0:14:18.52,0:14:20.69,Default,,0,0,0,,Орипатия инфекциясы анықталса
Dialogue: 0,0:14:21.36,0:14:24.32,Default,,0,0,0,,Сіз дереу карантиндік аймаққа жеткізілесіз.
Dialogue: 0,0:14:25.03,0:14:25.69,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:26.11,0:14:30.03,Default,,0,0,0,,Көптеген адамдар жұқпалы ауруларын жасырып өмір сүреді.
Dialogue: 0,0:14:31.91,0:14:35.29,Default,,0,0,0,,Бұндай адамдарды жасырын емдейтін жер...
Dialogue: 0,0:14:36.50,0:14:37.46,Default,,0,0,0,,деп аталатын
Dialogue: 0,0:14:37.54,0:14:38.83,Default,,0,0,0,,Ол қараңғы дәрігер болған.
Dialogue: 0,0:14:40.67,0:14:43.00,Default,,0,0,0,,Реюньонмен байланыс болған сияқты...
Dialogue: 0,0:14:44.46,0:14:46.34,Default,,0,0,0,,Осы жағдайды қарастыру
Dialogue: 0,0:14:46.63,0:14:48.26,Default,,0,0,0,,Кез келген сұраудан бас тарту
Dialogue: 0,0:14:48.34,0:14:49.72,Default,,0,0,0,,Кек алды\NМенің ойымша, бұл
Dialogue: 0,0:14:49.88,0:14:51.51,Default,,0,0,0,,...
Dialogue: 0,0:14:52.64,0:14:54.06,Default,,0,0,0,,Мұндағы адамдар
Dialogue: 0,0:14:54.47,0:14:56.27,Default,,0,0,0,,Сіз бізден бас тарттыңыз.
Dialogue: 0,0:14:57.23,0:14:58.89,Default,,0,0,0,,Оған салқындықпен қарау...
Dialogue: 0,0:15:00.81,0:15:04.32,Default,,0,0,0,,Оның Реюньонға деген көзқарасы бірдей болғанына сенімдімін.
Dialogue: 0,0:15:04.94,0:15:06.44,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:15:06.65,0:15:08.03,Default,,0,0,0,,Өзім кінәлімін...!
Dialogue: 0,0:15:08.36,0:15:09.74,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:15:09.95,0:15:11.32,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:15:12.12,0:15:13.62,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:15:14.12,0:15:16.29,Default,,0,0,0,,Мен енді басқаларға сене алмадым.
Dialogue: 0,0:15:18.75,0:15:20.12,Default,,0,0,0,,...
Dialogue: 0,0:15:20.33,0:15:22.08,Default,,0,0,0,,Менің ойымша, бұл келді.
Dialogue: 0,0:15:22.63,0:15:24.96,Default,,0,0,0,,Тіпті жұқтырған адамдар болса да
Dialogue: 0,0:15:25.25,0:15:27.09,Default,,0,0,0,,Біз бір-бірімізге оңай сене алмаймыз.
Dialogue: 0,0:15:28.09,0:15:32.05,Default,,0,0,0,,Қорғау үшін қабырға салмасақ, зардап шегеміз.
Dialogue: 0,0:15:33.22,0:15:35.05,Default,,0,0,0,,Мен осылай ойлағаныма сенімдімін.
Dialogue: 0,0:15:36.14,0:15:38.47,Default,,0,0,0,,Оларды жек көруге болмайды
Dialogue: 0,0:15:40.31,0:15:41.44,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:15:41.52,0:15:43.23,Default,,0,0,0,,Ауру жұқтырған адамдар кемсітуге ұшырамайды
Dialogue: 0,0:15:43.35,0:15:48.23,Default,,0,0,0,,Мен Родосты адамдар қалыпты өмір сүретін орын ретінде жасадым.
Dialogue: 0,0:15:48.53,0:15:51.95,Default,,0,0,0,,Кейбір адамдар әлі де жүрегін аша алмайды.
Dialogue: 0,0:15:52.53,0:15:55.24,Default,,0,0,0,,Сіздердің көпшілігіңіз Родостасыздар
Dialogue: 0,0:15:55.32,0:15:57.70,Default,,0,0,0,,Инфекцияның алшақтығын жою
Dialogue: 0,0:15:57.79,0:15:58.95,Default,,0,0,0,,Өмір сүру
Dialogue: 0,0:15:59.83,0:16:02.37,Default,,0,0,0,,Бұл клиника Родос сияқты.
Dialogue: 0,0:16:03.17,0:16:07.25,Default,,0,0,0,,Ол жұқтырған адамдар үшін баспана ретінде жасалған болуы мүмкін.
Dialogue: 0,0:16:07.96,0:16:09.38,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:16:09.51,0:16:12.34,Default,,0,0,0,,Олар да аман қалуға тырысады
Dialogue: 0,0:16:12.76,0:16:14.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:14.30,0:16:15.39,Default,,0,0,0,,Мен ойланбай қалдым
Dialogue: 0,0:16:16.01,0:16:17.43,Default,,0,0,0,,Бұл туралы уайымдамаңыз.
Dialogue: 0,0:16:17.51,0:16:18.43,Default,,0,0,0,,Қашан
Dialogue: 0,0:16:18.68,0:16:19.64,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,0:16:19.97,0:16:20.93,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:21.02,0:16:22.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:22.23,0:16:25.06,Default,,0,0,0,,Бұрынғы шайқаста жеңіл жарақат алған көрінеді.
Dialogue: 0,0:16:25.48,0:16:28.32,Default,,0,0,0,,Эй, сен маған тегін медициналық оператор әкеле аласың ба?
Dialogue: 0,0:16:28.40,0:16:30.90,Default,,0,0,0,,А, уа, мен барамын!
Dialogue: 0,0:16:32.70,0:16:33.78,Default,,0,0,0,,Курткаңызды ұстаңыз
Dialogue: 0,0:16:34.07,0:16:35.36,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:36.03,0:16:39.79,Default,,0,0,0,,Өзіңді жақсы күт, Өкіл.
Dialogue: 0,0:16:40.62,0:16:42.54,Default,,0,0,0,,Иә... Мен абай боламын.
Dialogue: 0,0:16:42.87,0:16:44.46,Default,,0,0,0,,Оң қолыңызды сәл көтеріңіз
Dialogue: 0,0:16:45.37,0:16:47.21,Default,,0,0,0,,Қан кетпегеніне қуаныштымын.
Dialogue: 0,0:16:47.84,0:16:49.67,Default,,0,0,0,,Өнер қабынуды басады.
Dialogue: 0,0:16:52.55,0:16:53.72,Default,,0,0,0,,Дәрігер?
Dialogue: 0,0:16:54.22,0:16:55.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:55.72,0:16:58.05,Default,,0,0,0,,Өнер принциптеріне тоқталайық.
Dialogue: 0,0:16:59.56,0:17:00.77,Default,,0,0,0,,Бұл құралда бар
Dialogue: 0,0:17:00.85,0:17:03.52,Default,,0,0,0,,Құрамында оригиний деп аталатын минерал бар
Dialogue: 0,0:17:04.19,0:17:06.31,Default,,0,0,0,,Өнер қабілетінің қайнар көзі болып табылатын зат.
Dialogue: 0,0:17:07.27,0:17:08.65,Default,,0,0,0,,Осы құрал арқылы
Dialogue: 0,0:17:08.94,0:17:12.65,Default,,0,0,0,,Өнерді тек туа біткен қабілеті барлар ғана пайдалана алады.
Dialogue: 0,0:17:12.86,0:17:14.95,Default,,0,0,0,,Қабілеттер пайдаланушыға байланысты өзгереді.
Dialogue: 0,0:17:15.78,0:17:18.20,Default,,0,0,0,,Ол сияқты емдейтін адамдар бар.
Dialogue: 0,0:17:18.53,0:17:20.95,Default,,0,0,0,,Кейбір адамдар қаланы от теңізіне айналдырады.
Dialogue: 0,0:17:21.95,0:17:24.62,Default,,0,0,0,,Бұл қуатты өнеркәсіптік технологияға қолдану арқылы
Dialogue: 0,0:17:24.79,0:17:26.83,Default,,0,0,0,,Бүгінгі өркениет мүмкін.
Dialogue: 0,0:17:28.46,0:17:32.26,Default,,0,0,0,,Originium біздің өмірімізге пайда әкеледі
Dialogue: 0,0:17:33.05,0:17:33.76,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:17:33.84,0:17:36.09,Default,,0,0,0,,Орипатия неден туындайды?
Dialogue: 0,0:17:36.34,0:17:37.64,Default,,0,0,0,,Бұл Originium.
Dialogue: 0,0:17:38.14,0:17:38.97,Default,,0,0,0,,Білек...
Dialogue: 0,0:17:39.55,0:17:40.47,Default,,0,0,0,,...Иә
Dialogue: 0,0:17:40.56,0:17:42.97,Default,,0,0,0,,Бұл да Originium
Dialogue: 0,0:17:43.52,0:17:45.73,Default,,0,0,0,,Денедегі Originium орта ретінде пайдаланылса
Dialogue: 0,0:17:46.02,0:17:47.14,Default,,0,0,0,,Құралдарсыз да
Dialogue: 0,0:17:47.23,0:17:48.94,Default,,0,0,0,,Сіз өнерді пайдалана аласыз.
Dialogue: 0,0:17:49.65,0:17:52.40,Default,,0,0,0,,Орипатия сіздің өнер қабілетіңізді күшейтеді.
Dialogue: 0,0:17:52.90,0:17:54.49,Default,,0,0,0,,Бұл екі жүзді семсер.
Dialogue: 0,0:17:54.61,0:17:57.53,Default,,0,0,0,,Өмірді отын ретінде пайдаланудың синонимі
Dialogue: 0,0:17:58.20,0:18:00.28,Default,,0,0,0,,Пайдаланушының өлімін тездету
Dialogue: 0,0:18:00.87,0:18:04.25,Default,,0,0,0,,Пайда болса, бағасы да бар.
Dialogue: 0,0:18:04.37,0:18:07.58,Default,,0,0,0,,Егер мен орипатияны осы арқылы емдей алсам, менде ешқандай қиындық болмас еді.
Dialogue: 0,0:18:08.08,0:18:12.09,Default,,0,0,0,,Бұл емхананың істегені нақты емдеу емес еді.
Dialogue: 0,0:18:12.34,0:18:14.09,Default,,0,0,0,,Тек симптомдардың дамуын жеңілдету үшін
Dialogue: 0,0:18:15.05,0:18:18.05,Default,,0,0,0,,Қазіргі технологиямен жасай алатынымыз осы ғана.
Dialogue: 0,0:18:18.22,0:18:19.14,Default,,0,0,0,,Бітті
Dialogue: 0,0:18:19.22,0:18:20.22,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:20.34,0:18:21.80,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:21.89,0:18:23.31,Default,,0,0,0,,Енді оңайырақ
Dialogue: 0,0:18:24.35,0:18:25.43,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:25.73,0:18:29.19,Default,,0,0,0,,Орипатияны осылай емдесек
Dialogue: 0,0:18:29.77,0:18:30.86,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:18:30.94,0:18:33.23,Default,,0,0,0,,Ештеңеге қарамастан Родосқа аман-есен оралайық.
Dialogue: 0,0:18:33.32,0:18:34.19,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:18:35.94,0:18:36.69,Default,,0,0,0,,･･･
Dialogue: 0,0:18:37.53,0:18:39.53,Default,,0,0,0,,А...жоқ
Dialogue: 0,0:18:39.70,0:18:40.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:41.03,0:18:43.20,Default,,0,0,0,,Мен сізге қысым көрсетпеймін.
Dialogue: 0,0:18:43.91,0:18:45.87,Default,,0,0,0,,Зардап шеккен адамға медициналық көмек көрсетілді
Dialogue: 0,0:18:46.45,0:18:47.20,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:47.46,0:18:50.42,Default,,0,0,0,,Олар скаут отрядымен байланыса алмайтын сияқты.
Dialogue: 0,0:18:50.96,0:18:51.88,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:18:51.96,0:18:54.21,Default,,0,0,0,,Әйтеуір, кездесуге асығайық.
Dialogue: 0,0:18:54.63,0:18:55.38,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:18:56.92,0:18:59.93,Default,,0,0,0,,Менің кейбір достарым да естеліктерін жоғалтты.
Dialogue: 0,0:19:01.22,0:19:02.64,Default,,0,0,0,,Бұл менің жеке пікірім
Dialogue: 0,0:19:02.89,0:19:04.35,Default,,0,0,0,,Ең маңыздысы
Dialogue: 0,0:19:04.76,0:19:06.72,Default,,0,0,0,,Өткен немесе жоғалып кеткен естеліктер емес
Dialogue: 0,0:19:07.93,0:19:09.69,Default,,0,0,0,,«Қазір» сіз үшін
Dialogue: 0,0:19:10.02,0:19:12.10,Default,,0,0,0,,Және «бұдан былай»
Dialogue: 0,0:19:13.98,0:19:15.15,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:27.16,0:19:29.79,Default,,0,0,0,,Менің ойымша, скауттар тобы әлі келген жоқ...
Dialogue: 0,0:19:33.38,0:19:34.46,Default,,0,0,0,,Тыныш...
Dialogue: 0,0:19:34.79,0:19:37.17,Default,,0,0,0,,Дәрігер: Бұл қақпан деп ойлайсың ба?
Dialogue: 0,0:19:37.25,0:19:38.80,Default,,0,0,0,,Жоқ...тек...
Dialogue: 0,0:19:39.30,0:19:40.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:40.30,0:19:42.89,Default,,0,0,0,,Ескерту: Артқы жағындағы жылу көзі анықталды
Dialogue: 0,0:19:43.22,0:19:44.43,Default,,0,0,0,,Өрт…\NБұл
Dialogue: 0,0:19:44.64,0:19:45.43,Default,,0,0,0,,ма?
Dialogue: 0,0:19:46.06,0:19:49.02,Default,,0,0,0,,Жан-жақтан от болып жатқаны рас...
Dialogue: 0,0:19:49.60,0:19:50.69,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:19:50.81,0:19:52.90,Default,,0,0,0,,Шаршыны зерттейік.
Dialogue: 0,0:19:53.15,0:19:55.15,Default,,0,0,0,,Төтенше жағдайда көмек сұрау
Dialogue: 0,0:19:55.40,0:19:56.23,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:19:57.36,0:19:59.90,Default,,0,0,0,,Артқы жағын қадағалап күтеміз...
Dialogue: 0,0:20:01.65,0:20:02.36,Default,,0,0,0,,Эйс?
Dialogue: 0,0:20:03.32,0:20:05.45,Default,,0,0,0,,Мұнда саған бірдеңе болды ма?
Dialogue: 0,0:20:06.03,0:20:07.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:07.54,0:20:08.83,Default,,0,0,0,,...Жоқ, бұл ештеңе емес.
Dialogue: 0,0:20:09.37,0:20:10.75,Default,,0,0,0,,Баяғыда.
Dialogue: 0,0:20:11.00,0:20:12.42,Default,,0,0,0,,Қалаған кезде сөйлесемін
Dialogue: 0,0:20:13.12,0:20:13.75,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:20:15.00,0:20:16.54,Default,,0,0,0,,...Алаңға қашайық
Dialogue: 0,0:20:16.92,0:20:17.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:18.17,0:20:19.26,Default,,0,0,0,,Қазір
Dialogue: 0,0:20:19.34,0:20:21.51,Default,,0,0,0,,Ескерту: Жылу көзі анықталды
Dialogue: 0,0:20:23.72,0:20:25.01,Default,,0,0,0,,Эвакуация!!! Эвакуацияланамын!!!!!
Dialogue: 0,0:20:37.69,0:20:39.65,Default,,0,0,0,,Бұл өнер...!
Dialogue: 0,0:20:39.90,0:20:42.03,Default,,0,0,0,,Бұл құжаттамада көрінгеннен гөрі қиынырақ...
Dialogue: 0,0:20:42.53,0:20:44.24,Default,,0,0,0,,Реюньон тиранты...!!
Dialogue: 0,0:20:45.41,0:20:46.53,Default,,0,0,0,,Талула
Dialogue: 0,0:20:46.99,0:20:48.70,Default,,0,0,0,,Қашу жолын бекітіңіз
Dialogue: 0,0:20:48.91,0:20:49.62,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:20:49.70,0:20:51.12,Default,,0,0,0,,Жауапты бағыттау...
Dialogue: 0,0:21:19.69,0:21:21.36,Default,,0,0,0,,Колт! Оу!
Dialogue: 0,0:21:21.73,0:21:25.20,Default,,0,0,0,,Сіз шынымен де біздің жақта тұруыңыз керек еді.
Dialogue: 0,0:21:26.78,0:21:28.62,Default,,0,0,0,,Жұқтырған адам не істеді?
Dialogue: 0,0:21:30.41,0:21:32.04,Default,,0,0,0,,Жазықсыз адамдар
Dialogue: 0,0:21:32.29,0:21:33.70,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:21:35.41,0:21:36.96,Default,,0,0,0,,Сізге
Dialogue: 0,0:21:37.67,0:21:39.21,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:21:40.21,0:21:42.67,Default,,0,0,0,,Тек сөзбен ғана төлейтін идеалистке
Dialogue: 0,0:21:43.55,0:21:45.22,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:21:47.26,0:21:48.80,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:21:51.18,0:21:53.68,Default,,0,0,0,,Менің сезімім ешкімге жетпейді
Dialogue: 0,0:21:54.64,0:21:56.14,Default,,0,0,0,,Тәтті армандар
Dialogue: 0,0:21:56.69,0:21:58.23,Default,,0,0,0,,Орындалмайды
Dialogue: 0,0:21:59.61,0:22:01.98,Default,,0,0,0,,Маған ұнайтын соңы
Dialogue: 0,0:22:02.44,0:22:03.69,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:22:05.24,0:22:06.95,Default,,0,0,0,,Өлсін!
Dialogue: 0,0:22:08.45,0:22:14.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory