Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.71,0:00:05.63,Default,,0,0,0,,Амия!!!
Dialogue: 0,0:00:10.42,0:00:11.26,Default,,0,0,0,,Мен саған рұқсат бермеймін...!!!
Dialogue: 0,0:00:12.01,0:00:12.80,Default,,0,0,0,,Мен...!!
Dialogue: 0,0:00:13.43,0:00:14.84,Default,,0,0,0,,Мен бәріңді қорғаймын...!!!
Dialogue: 0,0:00:18.06,0:00:18.81,Default,,0,0,0,,Хо…
Dialogue: 0,0:00:20.10,0:00:20.72,Default,,0,0,0,,Амия!!
Dialogue: 0,0:00:20.81,0:00:21.43,Default,,0,0,0,,ТОҚТАҢЫЗ!!!
Dialogue: 0,0:00:21.81,0:00:22.85,Default,,0,0,0,,Доберман мырза...!
Dialogue: 0,0:00:24.94,0:00:25.56,Default,,0,0,0,,Асығыңыз...цу...!!
Dialogue: 0,0:00:26.27,0:00:27.48,Default,,0,0,0,,Барлығымен бірге...!
Dialogue: 0,0:00:28.02,0:00:29.32,Default,,0,0,0,,Қашып кетіңізші...!
Dialogue: 0,0:00:30.23,0:00:31.99,Default,,0,0,0,,Сен мені жалғыз қалдырып барасың ба!!!
Dialogue: 0,0:00:32.24,0:00:33.49,Default,,0,0,0,,Жалғыз менің қолымнан келмейді!!
Dialogue: 0,0:00:34.95,0:00:35.57,Default,,0,0,0,,Амия!!
Dialogue: 0,0:00:35.66,0:00:36.37,Default,,0,0,0,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:00:36.70,0:00:38.08,Default,,0,0,0,,Осы қарқынмен сақина...!!
Dialogue: 0,0:00:38.95,0:00:40.04,Default,,0,0,0,,Бұл дене
Dialogue: 0,0:00:40.54,0:00:41.79,Default,,0,0,0,,Сынса да...!!
Dialogue: 0,0:00:42.79,0:00:43.91,Default,,0,0,0,,･･･!!!!
Dialogue: 0,0:00:51.42,0:00:52.42,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:00:53.76,0:00:54.88,Default,,0,0,0,,Сіз...
Dialogue: 0,0:02:31.31,0:02:32.06,Default,,0,0,0,,Таллулаға
Dialogue: 0,0:02:32.19,0:02:33.02,Default,,0,0,0,,Барлығы бірден!
Dialogue: 0,0:02:33.40,0:02:34.23,Default,,0,0,0,,Амияны қолдаңыз!!
Dialogue: 0,0:02:47.04,0:02:47.87,Default,,0,0,0,,Эйс мырза...!
Dialogue: 0,0:02:54.42,0:02:55.05,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:02:55.71,0:02:57.34,Default,,0,0,0,,Ол неге қозғалды...
Dialogue: 0,0:02:57.96,0:02:59.01,Default,,0,0,0,,Стратегиялардың…?
Dialogue: 0,0:02:59.34,0:03:01.59,Default,,0,0,0,,Бұл ұстанатын уақыт емес сияқты!
Dialogue: 0,0:03:01.80,0:03:02.43,Default,,0,0,0,,О
Dialogue: 0,0:03:02.84,0:03:03.47,Default,,0,0,0,,Жалпы мүшелер
Dialogue: 0,0:03:03.55,0:03:05.06,Default,,0,0,0,,Нұсқауларды орындап, шегініңіз!
Dialogue: 0,0:03:05.60,0:03:06.22,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:03:06.35,0:03:07.18,Default,,0,0,0,,Пәрменді сұрау
Dialogue: 0,0:03:07.47,0:03:08.10,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:09.06,0:03:09.85,Default,,0,0,0,,құлады
Dialogue: 0,0:03:10.06,0:03:11.19,Default,,0,0,0,,Құрылыс үйінділері
Dialogue: 0,0:03:11.69,0:03:12.90,Default,,0,0,0,,Бір жерде бос орын бар.
Dialogue: 0,0:03:13.52,0:03:14.52,Default,,0,0,0,,Ол жерден кетейік
Dialogue: 0,0:03:15.15,0:03:16.19,Default,,0,0,0,,Егер сіз шаршыдан кетсеңіз
Dialogue: 0,0:03:16.73,0:03:18.11,Default,,0,0,0,,Шығу нүктесінің жанында
Dialogue: 0,0:03:18.40,0:03:19.49,Default,,0,0,0,,Жасыратын жер...
Dialogue: 0,0:03:39.09,0:03:40.26,Default,,0,0,0,,Бұл туралы не істеуім керек...
Dialogue: 0,0:03:40.38,0:03:41.05,Default,,0,0,0,,...маған көмектесіңізші
Dialogue: 0,0:03:41.13,0:03:41.68,Default,,0,0,0,,Келіңіздер!!
Dialogue: 0,0:03:41.76,0:03:42.88,Default,,0,0,0,,Соқыр жүгірме!!!
Dialogue: 0,0:03:44.55,0:03:45.30,Default,,0,0,0,,Көмек...!
Dialogue: 0,0:03:45.55,0:03:46.89,Default,,0,0,0,,Менің бұл жерде өлуден басқа амалым жоқ шығар...!!
Dialogue: 0,0:03:46.97,0:03:47.76,Default,,0,0,0,,Маған көмектесіңізші...!!
Dialogue: 0,0:03:48.10,0:03:50.27,Default,,0,0,0,,Менің өлгім келмейді... өлгім келмейді...!!!
Dialogue: 0,0:03:50.98,0:03:51.60,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:03:52.06,0:03:52.85,Default,,0,0,0,,Менен...!!
Dialogue: 0,0:03:52.94,0:03:54.35,Default,,0,0,0,,Өтінемін, мені тастап кетпеші...!!!
Dialogue: 0,0:03:59.19,0:03:59.82,Default,,0,0,0,,Амия...!!!
Dialogue: 0,0:04:00.07,0:04:00.99,Default,,0,0,0,,Бұл…
Dialogue: 0,0:04:01.19,0:04:02.82,Default,,0,0,0,,Өлшем - шек...!
Dialogue: 0,0:04:08.37,0:04:08.99,Default,,0,0,0,,t=...
Dialogue: 0,0:04:09.29,0:04:10.29,Default,,0,0,0,,Талула ханым...
Dialogue: 0,0:04:13.25,0:04:14.71,Default,,0,0,0,,...\\...
Dialogue: 0,0:04:14.79,0:04:16.21,Default,,0,0,0,,Ауырды...!!
Dialogue: 0,0:04:16.29,0:04:17.42,Default,,0,0,0,,Менің қолым...
Dialogue: 0,0:04:17.54,0:04:20.01,Default,,0,0,0,,Достарыңыздың өлуіне жол беру...
Dialogue: 0,0:04:22.05,0:04:22.67,Default,,0,0,0,,Амия!!
Dialogue: 0,0:04:22.84,0:04:23.47,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:04:25.34,0:04:26.34,Default,,0,0,0,,Шың өтті!
Dialogue: 0,0:04:26.51,0:04:28.18,Default,,0,0,0,,Екінші толқын келгенше кетейік!!
Dialogue: 0,0:04:28.39,0:04:29.06,Default,,0,0,0,,Ниалл
Dialogue: 0,0:04:29.22,0:04:29.85,Default,,0,0,0,,Нұсқаулық сұраңыз!
Dialogue: 0,0:04:30.22,0:04:30.85,Default,,0,0,0,,— Герцог Тайбар, уақыт таяды.
Dialogue: 0,0:04:33.98,0:04:35.81,Default,,0,0,0,,Амияның мүмкіндігін пайдаланды...!
Dialogue: 0,0:04:36.40,0:04:37.02,Default,,0,0,0,,Шегіну!!
Dialogue: 0,0:04:37.15,0:04:37.77,Default,,0,0,0,,Жүгіру!!!
Dialogue: 0,0:04:40.03,0:04:40.69,Default,,0,0,0,,Елдіандықтар маған бұйрық беріп тұр ма?
Dialogue: 0,0:04:44.95,0:04:45.57,Default,,0,0,0,,Амансың ба!!
Dialogue: 0,0:04:46.36,0:04:46.99,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:47.24,0:04:48.33,Default,,0,0,0,,Зембіл сынған...!
Dialogue: 0,0:04:48.74,0:04:49.95,Default,,0,0,0,,Мен Талуланы аламын...!
Dialogue: 0,0:04:50.04,0:04:50.79,Default,,0,0,0,,Амия!!
Dialogue: 0,0:04:51.20,0:04:52.08,Default,,0,0,0,,Мен онымен айналысамын!
Dialogue: 0,0:04:52.41,0:04:53.62,Default,,0,0,0,,Дәрігерді алып, алға!!!
Dialogue: 0,0:04:54.21,0:04:54.96,Default,,0,0,0,,Доберман капитаны
Dialogue: 0,0:04:55.33,0:04:56.29,Default,,0,0,0,,Барыңыз...!
Dialogue: 0,0:04:56.58,0:04:57.71,Default,,0,0,0,,Біз бұл туралы бірдеңе жасаймыз!!
Dialogue: 0,0:04:58.13,0:04:58.92,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:04:59.25,0:05:00.09,Default,,0,0,0,,Тезірек жетіңіз!
Dialogue: 0,0:05:01.00,0:05:01.63,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:05:04.38,0:05:05.26,Default,,0,0,0,,Эйс және басқалар
Dialogue: 0,0:05:05.38,0:05:06.51,Default,,0,0,0,,Талуланы тоқтатыңыз...
Dialogue: 0,0:05:07.39,0:05:08.26,Default,,0,0,0,,Бұл жерде де қауіпті.
Dialogue: 0,0:05:08.51,0:05:09.14,Default,,0,0,0,,Эвакуация...
Dialogue: 0,0:05:09.22,0:05:09.76,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:09.93,0:05:10.68,Default,,0,0,0,,Жоқ...!!!
Dialogue: 0,0:05:11.10,0:05:11.77,Default,,0,0,0,,Эйс мырза!!!
Dialogue: 0,0:05:12.77,0:05:13.43,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:05:13.81,0:05:14.64,Default,,0,0,0,,Эйс-сан!!
Dialogue: 0,0:05:15.85,0:05:17.02,Default,,0,0,0,,Жолды аш...ма...цу
Dialogue: 0,0:05:18.15,0:05:18.90,Default,,0,0,0,,Амия!!
Dialogue: 0,0:05:19.02,0:05:19.77,Default,,0,0,0,,Алға!!
Dialogue: 0,0:05:20.27,0:05:20.90,Default,,0,0,0,,Бірақ...!!
Dialogue: 0,0:05:21.44,0:05:22.78,Default,,0,0,0,,Бізде бәрі жақсы болады!!
Dialogue: 0,0:05:23.28,0:05:23.90,Default,,0,0,0,,Бар!
Dialogue: 0,0:05:25.03,0:05:25.82,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:05:26.53,0:05:28.66,Default,,0,0,0,,Нені бірінші орынға қою керектігін ойланыңыз
Dialogue: 0,0:05:29.03,0:05:29.66,Default,,0,0,0,,?
Dialogue: 0,0:05:30.66,0:05:31.28,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:05:31.83,0:05:32.45,Default,,0,0,0,,Доберман
Dialogue: 0,0:05:37.04,0:05:37.75,Default,,0,0,0,,…Түсінікті
Dialogue: 0,0:05:38.46,0:05:39.38,Default,,0,0,0,,Құрылымды қалыптастырыңыз!!
Dialogue: 0,0:05:39.58,0:05:40.29,Default,,0,0,0,,Алға жылжу!!
Dialogue: 0,0:05:42.67,0:05:43.34,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:05:45.09,0:05:46.05,Default,,0,0,0,,Бір күні
Dialogue: 0,0:05:46.34,0:05:47.43,Default,,0,0,0,,Сіз және Амия
Dialogue: 0,0:05:48.34,0:05:51.76,Default,,0,0,0,,Осы қатыгез дүниемен бетпе-бет келетін уақыт келеді.
Dialogue: 0,0:05:53.14,0:05:54.18,Default,,0,0,0,,...ол туралы
Dialogue: 0,0:05:55.31,0:05:56.14,Default,,0,0,0,,Жоқ! Мен өлгім келмейді. Отбасымды көргім келеді.
Dialogue: 0,0:05:57.39,0:05:58.35,Default,,0,0,0,,...
Dialogue: 0,0:05:58.81,0:05:59.44,Default,,0,0,0,,Бар!
Dialogue: 0,0:05:59.94,0:06:00.90,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:06:07.28,0:06:08.95,Default,,0,0,0,,Табиғат апаты басылған сияқты.
Dialogue: 0,0:06:10.57,0:06:12.33,Default,,0,0,0,,Мен қашу нүктесі қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:06:13.49,0:06:15.33,Default,,0,0,0,,IJ Көлік ұшағы келгенше осында күтіңіз.
Dialogue: 0,0:06:16.00,0:06:17.58,Default,,0,0,0,,Айналаңызға сергек болыңыз
Dialogue: 0,0:06:19.96,0:06:20.58,Default,,0,0,0,,Ниалл
Dialogue: 0,0:06:22.42,0:06:23.55,Default,,0,0,0,,Жарқыраған рыцарь болсаң
Dialogue: 0,0:06:24.50,0:06:27.67,Default,,0,0,0,,Әр уақытта адамдарға жол көрсететін нұр болуы керек.
Dialogue: 0,0:06:28.80,0:06:29.43,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:29.97,0:06:30.72,Default,,0,0,0,,Сіз мұны айттыңыз.
Dialogue: 0,0:06:32.30,0:06:32.93,Default,,0,0,0,,...Ах
Dialogue: 0,0:06:33.51,0:06:34.35,Default,,0,0,0,,...
Dialogue: 0,0:06:35.39,0:06:36.77,Default,,0,0,0,,Олардың ойлары
Dialogue: 0,0:06:37.02,0:06:38.14,Default,,0,0,0,,Оны ысырап етпеңіз
Dialogue: 0,0:06:40.60,0:06:41.40,Default,,0,0,0,,Амия
Dialogue: 0,0:06:41.81,0:06:42.52,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:06:43.98,0:06:45.32,Default,,0,0,0,,Эйс және т.б
Dialogue: 0,0:06:45.40,0:06:46.57,Default,,0,0,0,,Амансың ба...?
Dialogue: 0,0:06:52.99,0:06:53.70,Default,,0,0,0,,...
Dialogue: 0,0:06:55.20,0:06:55.83,Default,,0,0,0,,ма?
Dialogue: 0,0:07:03.08,0:07:04.04,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:07:04.92,0:07:06.05,Default,,0,0,0,,Эйс және басқалар үшін
Dialogue: 0,0:07:06.67,0:07:07.63,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:08.38,0:07:09.01,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:07:10.63,0:07:11.80,Default,,0,0,0,,Родостағы барлық адамдар
Dialogue: 0,0:07:12.55,0:07:13.64,Default,,0,0,0,,Өйткені ол күшті
Dialogue: 0,0:07:21.35,0:07:21.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:22.23,0:07:24.40,Default,,0,0,0,,Осы уақытқа дейін қалай күресуге болады?
Dialogue: 0,0:07:24.77,0:07:26.19,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:07:26.90,0:07:29.69,Default,,0,0,0,,Сүйегің күлге айналса да күрес
Dialogue: 0,0:07:30.61,0:07:31.91,Default,,0,0,0,,Ол керемет жауынгер.
Dialogue: 0,0:07:32.99,0:07:34.49,Default,,0,0,0,,Менің есімде...
Dialogue: 0,0:07:35.08,0:07:36.03,Default,,0,0,0,,Родос
Dialogue: 0,0:07:38.41,0:07:40.25,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:07:41.33,0:07:44.58,Default,,0,0,0,,Мен бұлай оңай құтыламын деп ойламадым...
Dialogue: 0,0:07:46.09,0:07:48.88,Default,,0,0,0,,Дос табу үшін алдымен өзіңізді таныстырыңыз
Dialogue: 0,0:07:49.09,0:07:49.71,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:07:50.38,0:07:52.47,Default,,0,0,0,,Маған В деп қоңырау шалыңыз
Dialogue: 0,0:07:53.26,0:07:54.05,Default,,0,0,0,,W...
Dialogue: 0,0:07:55.14,0:07:55.76,Default,,0,0,0,,Сіз…
Dialogue: 0,0:07:56.14,0:07:57.72,Default,,0,0,0,,Біз бір жерде кездестік пе?
Dialogue: 0,0:07:59.18,0:08:00.14,Default,,0,0,0,,(Нәрсенің төгілу дыбысы)
Dialogue: 0,0:08:01.06,0:08:01.69,Default,,0,0,0,,W!
Dialogue: 0,0:08:02.10,0:08:02.98,Default,,0,0,0,,Мақсаты не!!
Dialogue: 0,0:08:03.48,0:08:04.48,Default,,0,0,0,,Мақсат…
Dialogue: 0,0:08:05.11,0:08:06.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:06.61,0:08:08.94,Default,,0,0,0,,Маған дәрігерді бере аласыз ба?
Dialogue: 0,0:08:09.82,0:08:10.61,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:08:10.90,0:08:12.11,Default,,0,0,0,,Сіз... білесіз бе?
Dialogue: 0,0:08:12.40,0:08:13.70,Default,,0,0,0,,Мен оны өте жақсы білемін.
Dialogue: 0,0:08:13.91,0:08:15.37,Default,,0,0,0,,Оның бетін көру
Dialogue: 0,0:08:15.45,0:08:17.16,Default,,0,0,0,,Біз осы уақытқа дейін жеттік
Dialogue: 0,0:08:17.49,0:08:18.66,Default,,0,0,0,,Талқылауға тұрарлық емес...
Dialogue: 0,0:08:19.24,0:08:19.87,Default,,0,0,0,,Амия
Dialogue: 0,0:08:20.16,0:08:21.66,Default,,0,0,0,,Әңгімелеу – уақытты босқа өткізу
Dialogue: 0,0:08:22.16,0:08:22.87,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:08:22.96,0:08:24.29,Default,,0,0,0,,Оның есімі Амия.
Dialogue: 0,0:08:24.87,0:08:25.88,Default,,0,0,0,,Шынында да, ол үйде өте сабырлы.
Dialogue: 0,0:08:25.96,0:08:27.63,Default,,0,0,0,,Мен өз ісімді аяқтадым.
Dialogue: 0,0:08:27.84,0:08:28.92,Default,,0,0,0,,Қайта кездескенше
Dialogue: 0,0:08:29.00,0:08:30.01,Default,,0,0,0,,Қоянның баласы
Dialogue: 0,0:08:30.59,0:08:31.42,Default,,0,0,0,,Барайық
Dialogue: 0,0:08:31.97,0:08:32.97,Default,,0,0,0,,О... Әй!
Dialogue: 0,0:08:33.72,0:08:34.38,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:08:34.97,0:08:35.55,Default,,0,0,0,,Күте тұрыңыз!!
Dialogue: 0,0:08:37.18,0:08:38.81,Default,,0,0,0,,Сіз шынымен бас тарттыңыз ба?
Dialogue: 0,0:08:39.68,0:08:40.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:40.72,0:08:43.14,Default,,0,0,0,,Мен мұның артында қандай да бір жоспар жатқандай сезіндім... ..
Dialogue: 0,0:08:52.53,0:08:53.15,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:08:53.49,0:08:54.11,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:08:54.86,0:08:55.66,Default,,0,0,0,,···Ace···
Dialogue: 0,0:08:56.03,0:08:56.78,Default,,0,0,0,,Капитан:
Dialogue: 0,0:08:58.74,0:08:59.95,Default,,0,0,0,,Басқалары
Dialogue: 0,0:09:00.45,0:09:02.33,Default,,0,0,0,,Жалғыз қалған сен және мен.
Dialogue: 0,0:09:03.12,0:09:04.12,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:09:06.25,0:09:06.88,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:07.67,0:09:09.50,Default,,0,0,0,,Менің қолымнан келгені айқайлау ғана...
Dialogue: 0,0:09:09.96,0:09:10.96,Default,,0,0,0,,Мен алмадым...
Dialogue: 0,0:09:12.34,0:09:13.21,Default,,0,0,0,,Ештеңе...!!
Dialogue: 0,0:09:13.38,0:09:14.22,Default,,0,0,0,,Мен алмаймын...
Dialogue: 0,0:09:17.22,0:09:18.14,Default,,0,0,0,,Мен... Айтайын дегенім...
Dialogue: 0,0:09:19.39,0:09:20.14,Default,,0,0,0,,･･･ Жоқ...!
Dialogue: 0,0:09:20.43,0:09:21.51,Default,,0,0,0,,Оны сол жерде қалдырыңыз
Dialogue: 0,0:09:22.39,0:09:23.93,Default,,0,0,0,,Жара жайылып кетеді
Dialogue: 0,0:09:24.81,0:09:26.06,Default,,0,0,0,,Алғашқы көмек көрсету шаралары жүргізілді.
Dialogue: 0,0:09:26.23,0:09:27.35,Default,,0,0,0,,Біраз уақыттан кейін жүре аласыз...
Dialogue: 0,0:09:27.44,0:09:28.10,Default,,0,0,0,,Капитан Цу...
Dialogue: 0,0:09:28.69,0:09:29.52,Default,,0,0,0,,Менің сол қолым...
Dialogue: 0,0:09:32.15,0:09:33.40,Default,,0,0,0,,Екіншісі қалады
Dialogue: 0,0:09:34.15,0:09:34.82,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:09:35.32,0:09:35.95,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:09:36.11,0:09:36.95,Default,,0,0,0,,Өтінемін, қашыңыз!
Dialogue: 0,0:09:37.32,0:09:38.11,Default,,0,0,0,,Мен капитан екеніне сенімдімін
Dialogue: 0,0:09:38.20,0:09:38.74,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:38.82,0:09:39.49,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:09:39.78,0:09:42.49,Default,,0,0,0,,Көлік ұшағы жақын арада эвакуация пунктіне келеді.
Dialogue: 0,0:09:42.87,0:09:44.33,Default,,0,0,0,,Білсе, бітті.
Dialogue: 0,0:09:46.00,0:09:47.29,Default,,0,0,0,,Мен саған уақыт сатып аламын
Dialogue: 0,0:09:47.62,0:09:49.75,Default,,0,0,0,,Сосын мен де...уф!!
Dialogue: 0,0:09:51.09,0:09:51.75,Default,,0,0,0,,Күзетші
Dialogue: 0,0:09:52.63,0:09:55.84,Default,,0,0,0,,Мен сенің жаныңды қолыммен алдым.
Dialogue: 0,0:09:57.55,0:09:58.43,Default,,0,0,0,,Аман бол
Dialogue: 0,0:09:59.30,0:10:01.68,Default,,0,0,0,,Қолдарыма тұрды
Dialogue: 0,0:10:02.39,0:10:03.01,Default,,0,0,0,,Иә
Dialogue: 0,0:10:03.10,0:10:04.10,Default,,0,0,0,,Ойланып көрейін
Dialogue: 0,0:10:05.10,0:10:06.10,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:10:07.31,0:10:08.31,Default,,0,0,0,,Капитан Эйс!!
Dialogue: 0,0:10:10.77,0:10:11.40,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:12.44,0:10:13.48,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:10:14.98,0:10:16.07,Default,,0,0,0,,Мейірім жоқ...
Dialogue: 0,0:10:35.63,0:10:36.26,Default,,0,0,0,,Не болды...?
Dialogue: 0,0:10:40.18,0:10:40.89,Default,,0,0,0,,...аздап...
Dialogue: 0,0:10:42.60,0:10:44.56,Default,,0,0,0,,Жүрегім ауырды...
Dialogue: 0,0:10:50.06,0:10:50.81,Default,,0,0,0,,Дәрігер мырза
Dialogue: 0,0:10:53.98,0:10:54.65,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:54.73,0:10:55.44,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:10:55.53,0:10:56.65,Default,,0,0,0,,Өтінемін, жылама...
Dialogue: 0,0:10:57.99,0:10:58.61,Default,,0,0,0,,дейін
Dialogue: 0,0:10:59.28,0:11:01.11,Default,,0,0,0,,Маған біреу айтты
Dialogue: 0,0:11:02.12,0:11:04.95,Default,,0,0,0,,Ұрыс болған соң көз жасыңды тыясың дейді.
Dialogue: 0,0:11:06.24,0:11:07.50,Default,,0,0,0,,Бөлмеңізге қайтып келгенше
Dialogue: 0,0:11:09.25,0:11:10.04,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:11:11.00,0:11:11.62,Default,,0,0,0,,Родосқа
Dialogue: 0,0:11:13.29,0:11:14.50,Default,,0,0,0,,Біздің үйде...
Dialogue: 0,0:11:42.03,0:11:43.91,Default,,0,0,0,,Енді сіз топтама аймағын көре аласыз.
Dialogue: 0,0:11:45.74,0:11:46.87,Default,,0,0,0,,Бұл да Originium.
Dialogue: 0,0:11:48.04,0:11:49.45,Default,,0,0,0,,Сіз алаңда көргендей
Dialogue: 0,0:11:50.04,0:11:53.04,Default,,0,0,0,,Originium метеоритке айналып, жерге құлады...
Dialogue: 0,0:11:53.50,0:11:54.54,Default,,0,0,0,,Бұл табиғи апат.
Dialogue: 0,0:11:55.42,0:11:56.25,Default,,0,0,0,,Аймаққа байланысты
Dialogue: 0,0:11:56.34,0:11:59.01,Default,,0,0,0,,Қардың зақымдануы мен су тасқыны әртүрлі жолмен көрінсе де,
Dialogue: 0,0:11:59.76,0:12:02.30,Default,,0,0,0,,Табиғи апаттар әрқашан Originium-ды артта қалдырады.
Dialogue: 0,0:12:03.43,0:12:04.59,Default,,0,0,0,,Бұл үлкен
Dialogue: 0,0:12:05.68,0:12:08.18,Default,,0,0,0,,Оригиниум жер үстінде өседі.
Dialogue: 0,0:12:08.72,0:12:09.60,Default,,0,0,0,,Өсу...?
Dialogue: 0,0:12:10.35,0:12:11.35,Default,,0,0,0,,Кен...?
Dialogue: 0,0:12:12.14,0:12:14.02,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ
Dialogue: 0,0:12:14.94,0:12:17.61,Default,,0,0,0,,Оригинияның кристалдық тамыры ақырында жарылып кетеді.
Dialogue: 0,0:12:18.15,0:12:20.74,Default,,0,0,0,,Оригиний бөлшектері деп аталатындарды бөліңіз
Dialogue: 0,0:12:21.49,0:12:23.57,Default,,0,0,0,,Аспанда бұлт түзеді
Dialogue: 0,0:12:23.91,0:12:25.78,Default,,0,0,0,,Бұл жаңа табиғи апатты тудыратын сияқты.
Dialogue: 0,0:12:26.66,0:12:27.41,Default,,0,0,0,,...
Dialogue: 0,0:12:27.83,0:12:28.83,Default,,0,0,0,,Орипатия...
Dialogue: 0,0:12:29.58,0:12:30.20,Default,,0,0,0,,О
Dialogue: 0,0:12:30.66,0:12:33.29,Default,,0,0,0,,Біздің тағдырымыз жұқтырған адамдардың тағдырына өте ұқсас.
Dialogue: 0,0:12:34.08,0:12:35.54,Default,,0,0,0,,Табиғи апаттар және орипатия
Dialogue: 0,0:12:36.00,0:12:37.34,Default,,0,0,0,,Халықты да жек көру
Dialogue: 0,0:12:38.17,0:12:39.34,Default,,0,0,0,,Тоқтамай кеңейе береді
Dialogue: 0,0:12:39.63,0:12:40.26,Default,,0,0,0,,Доберман
Dialogue: 0,0:12:41.05,0:12:42.72,Default,,0,0,0,,Сіз де таусылған болуыңыз керек.
Dialogue: 0,0:12:43.97,0:12:45.18,Default,,0,0,0,,Сізге демалу керек
Dialogue: 0,0:12:46.26,0:12:47.05,Default,,0,0,0,,Мазасыздық
Dialogue: 0,0:12:48.01,0:12:48.76,Default,,0,0,0,,Аяғыңды ал
Dialogue: 0,0:12:50.10,0:12:51.52,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:12:52.06,0:12:54.23,Default,,0,0,0,,Енді сөйлесу оңайырақ.
Dialogue: 0,0:12:54.94,0:12:55.73,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:12:56.60,0:12:57.31,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:12:58.40,0:12:59.07,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:12:59.57,0:13:01.07,Default,,0,0,0,,Сізбен кездесе бастағаным үшін кешіріңіз.
Dialogue: 0,0:13:01.57,0:13:02.19,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:02.78,0:13:03.99,Default,,0,0,0,,Бұл маған да көмектеседі.
Dialogue: 0,0:13:05.70,0:13:07.32,Default,,0,0,0,,Чернобогты әлі де көре аласыз ба?
Dialogue: 0,0:13:09.16,0:13:09.83,Default,,0,0,0,,О
Dialogue: 0,0:13:10.49,0:13:13.79,Default,,0,0,0,,Ол үлкен мобильді құрылғыда құрастырылған.
Dialogue: 0,0:13:14.62,0:13:15.25,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:13:15.62,0:13:17.71,Default,,0,0,0,,Орынды қала бойынша жылжыта алады
Dialogue: 0,0:13:18.63,0:13:20.55,Default,,0,0,0,,...Табиғи апаттарды болдырмау үшін...?
Dialogue: 0,0:13:21.13,0:13:21.75,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:22.55,0:13:25.76,Default,,0,0,0,,Дүние жүзіндегі көптеген қалалар қазір мобильді
Dialogue: 0,0:13:27.01,0:13:29.35,Default,,0,0,0,,Табиғи апаттардың орнын болжауға болады.
Dialogue: 0,0:13:29.97,0:13:32.10,Default,,0,0,0,,Қалаларды алдын ала көшіру арқылы
Dialogue: 0,0:13:32.39,0:13:33.43,Default,,0,0,0,,Зақымданудың алдын алу
Dialogue: 0,0:13:33.98,0:13:34.60,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:35.39,0:13:37.06,Default,,0,0,0,,Неліктен Чернобог...
Dialogue: 0,0:13:38.56,0:13:39.19,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:40.44,0:13:41.90,Default,,0,0,0,,Осы тәртіпсіздікте
Dialogue: 0,0:13:42.57,0:13:43.78,Default,,0,0,0,,Мұның артында бір нәрсе бар
Dialogue: 0,0:13:47.74,0:13:48.45,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:48.57,0:13:50.12,Default,,0,0,0,,Сіз Родосқа барасыз ба?
Dialogue: 0,0:13:52.04,0:13:52.66,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:52.83,0:13:54.25,Default,,0,0,0,,Баратын жер - Рюмон.
Dialogue: 0,0:13:55.29,0:13:56.12,Default,,0,0,0,,Ронмен...?
Dialogue: 0,0:13:56.83,0:13:59.00,Default,,0,0,0,,Менің ойымша, ол осы нүктеден тыс қалаға кетіп қалады.
Dialogue: 0,0:13:59.54,0:14:02.42,Default,,0,0,0,,Ауру жұқтырғандар Чернобогтан қашып кеткен сияқты...
Dialogue: 0,0:14:02.88,0:14:03.80,Default,,0,0,0,,Бұл капитан.
Dialogue: 0,0:14:04.21,0:14:05.92,Default,,0,0,0,,Енді қонуға дайындаламыз.
Dialogue: 0,0:14:51.93,0:14:52.97,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:14:54.06,0:14:55.72,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:14:56.85,0:14:58.06,Default,,0,0,0,,Мен тыңдаймын.
Dialogue: 0,0:14:59.23,0:15:00.85,Default,,0,0,0,,Бұл қиын миссия болды.
Dialogue: 0,0:15:01.81,0:15:02.48,Default,,0,0,0,,･･･Иә･･･
Dialogue: 0,0:15:03.19,0:15:03.98,Default,,0,0,0,,Ниалл!
Dialogue: 0,0:15:04.48,0:15:05.65,Default,,0,0,0,,Жақсы екеніңізге қуаныштымын.
Dialogue: 0,0:15:05.98,0:15:06.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:06.98,0:15:07.61,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:07.69,0:15:08.36,Default,,0,0,0,,Мен ондай адамды білмеймін.
Dialogue: 0,0:15:08.53,0:15:10.20,Default,,0,0,0,,Мен зембіл сұрай аламын ба?
Dialogue: 0,0:15:10.57,0:15:11.61,Default,,0,0,0,,Мен оны бірден аламын!
Dialogue: 0,0:15:12.03,0:15:12.95,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:15:13.20,0:15:14.58,Default,,0,0,0,,Біз де көмектесеміз.
Dialogue: 0,0:15:16.70,0:15:17.45,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:15:18.20,0:15:19.16,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:15:20.12,0:15:21.46,Default,,0,0,0,,терең ұйқыда
Dialogue: 0,0:15:22.38,0:15:23.63,Default,,0,0,0,,Родосқа келгеннен кейін
Dialogue: 0,0:15:23.84,0:15:25.46,Default,,0,0,0,,Кері жібі үзілген сияқты.
Dialogue: 0,0:15:26.21,0:15:28.26,Default,,0,0,0,,Ол өз шегінен асып кеткен болуы керек...
Dialogue: 0,0:15:29.22,0:15:30.01,Default,,0,0,0,,Таңқаларлық емес
Dialogue: 0,0:15:31.63,0:15:32.43,Default,,0,0,0,,...
Dialogue: 0,0:15:46.77,0:15:47.65,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:15:47.94,0:15:48.69,Default,,0,0,0,,Құрметті дәрігер
Dialogue: 0,0:15:50.03,0:15:50.95,Default,,0,0,0,,Бұл қайда...?
Dialogue: 0,0:15:51.78,0:15:53.11,Default,,0,0,0,,Бұл қонақ бөлмесі.
Dialogue: 0,0:15:53.57,0:15:56.12,Default,,0,0,0,,Қазіргі уақытта дәрігердің жеке бөлмесі дайындалуда.
Dialogue: 0,0:15:56.24,0:15:58.20,Default,,0,0,0,,Осы жерде біраз демалдық.
Dialogue: 0,0:15:58.83,0:15:59.45,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:15:59.54,0:16:01.37,Default,,0,0,0,,Әрине, Родос кемесінің ішінде.
Dialogue: 0,0:16:03.50,0:16:05.75,Default,,0,0,0,,...
Dialogue: 0,0:16:06.42,0:16:07.04,Default,,0,0,0,,Сыртта…
Dialogue: 0,0:16:07.59,0:16:08.42,Default,,0,0,0,,Менің сыртқа шыққым келеді
Dialogue: 0,0:16:09.80,0:16:12.13,Default,,0,0,0,,Мен саған Амия-самаға көрсетейін.
Dialogue: 0,0:16:09.09,0:16:09.71,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:13.26,0:16:14.18,Default,,0,0,0,,...
Dialogue: 0,0:16:14.76,0:16:15.39,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:15.51,0:16:17.10,Default,,0,0,0,,Доктор сияқты жақсы емес.
Dialogue: 0,0:16:18.31,0:16:20.22,Default,,0,0,0,,Киімді ауыстыруға болады.
Dialogue: 0,0:16:21.48,0:16:23.60,Default,,0,0,0,,Палубада Амия ханым отыр.
Dialogue: 0,0:16:24.40,0:16:26.52,Default,,0,0,0,,Бұл жерден сәл алыс.
Dialogue: 0,0:16:27.65,0:16:28.61,Default,,0,0,0,,Өйткені бұл үлкен мәселе.
Dialogue: 0,0:16:28.90,0:16:29.53,Default,,0,0,0,,Жолда
Dialogue: 0,0:16:29.61,0:16:32.20,Default,,0,0,0,,Кеме бортындағы қондырғыларды да түсіндірейін.
Dialogue: 0,0:16:32.82,0:16:33.57,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:16:42.75,0:16:43.71,Default,,0,0,0,,Родос кемелері
Dialogue: 0,0:16:43.79,0:16:46.08,Default,,0,0,0,,Келесі межелі жерге жүгіру
Dialogue: 0,0:16:47.96,0:16:49.25,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:16:50.59,0:16:51.46,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:52.26,0:16:53.51,Default,,0,0,0,,Шынында да ештеңе...
Dialogue: 0,0:16:57.26,0:16:58.64,Default,,0,0,0,,Мен үшін...
Dialogue: 0,0:16:59.47,0:17:00.14,Default,,0,0,0,,Ą…..
Dialogue: 0,0:17:00.68,0:17:01.56,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,0:17:05.60,0:17:06.98,Default,,0,0,0,,Кеме басшылығын сұраңыз
Dialogue: 0,0:17:07.65,0:17:08.69,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:17:10.53,0:17:11.19,Default,,0,0,0,,Родос
Dialogue: 0,0:17:11.53,0:17:15.28,Default,,0,0,0,,Әртүрлі тазарту қондырғыларымен жабдықталған құрлықтағы кеме.
Dialogue: 0,0:17:16.66,0:17:17.91,Default,,0,0,0,,Жетілдірілген хирургиядан
Dialogue: 0,0:17:18.24,0:17:19.58,Default,,0,0,0,,Дәрілік рецепттен басқа
Dialogue: 0,0:17:20.08,0:17:23.12,Default,,0,0,0,,Бізде орипатияны зерттеуге арналған арнайы жабдықтар да бар.
Dialogue: 0,0:17:24.33,0:17:26.92,Default,,0,0,0,,Барлық жұмыс энергиясы кемеде қамтамасыз етілген.
Dialogue: 0,0:17:27.50,0:17:30.59,Default,,0,0,0,,Қажетті Originium өндіру және өңдеу
Dialogue: 0,0:17:31.80,0:17:32.92,Default,,0,0,0,,Бұл ғана емес
Dialogue: 0,0:17:33.26,0:17:35.68,Default,,0,0,0,,Түпнұсқа және басқа да бағалы металдарды өңдеу
Dialogue: 0,0:17:36.09,0:17:39.14,Default,,0,0,0,,Біздің қалалармен және компаниялармен де сауда келісімдері бар
Dialogue: 0,0:17:40.39,0:17:41.31,Default,,0,0,0,,Тұрғын аумақ
Dialogue: 0,0:17:41.68,0:17:43.14,Default,,0,0,0,,Мүшелер мен ауруханаға жатқызылған науқастар
Dialogue: 0,0:17:43.22,0:17:45.43,Default,,0,0,0,,Ыңғайлы болу үшін жасалған
Dialogue: 0,0:17:46.14,0:17:47.73,Default,,0,0,0,,Миссиядан кейін немесе емделу кезінде
Dialogue: 0,0:17:47.81,0:17:51.98,Default,,0,0,0,,Психикалық және физикалық ауыртпалықтарға күтім жасау да қамтамасыз етілуі мүмкін.
Dialogue: 0,0:17:53.19,0:17:53.90,Default,,0,0,0,,Родоста
Dialogue: 0,0:17:54.28,0:17:55.28,Default,,0,0,0,,Шығу тегі және нәсіл
Dialogue: 0,0:17:55.70,0:17:57.78,Default,,0,0,0,,Инфекцияға немесе инфекцияға қарамастан
Dialogue: 0,0:17:58.20,0:18:01.33,Default,,0,0,0,,Қаншама адамдар бірге тұрады.
Dialogue: 0,0:18:02.12,0:18:02.79,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:18:02.87,0:18:05.08,Default,,0,0,0,,Родостың қызметі кең ауқымды болғандықтан,
Dialogue: 0,0:18:05.37,0:18:06.16,Default,,0,0,0,,Көлік ұшағы және
Dialogue: 0,0:18:06.25,0:18:09.96,Default,,0,0,0,,Біз сондай-ақ әртүрлі қару-жарақ пен техникаға қолдау көрсетеміз.
Dialogue: 0,0:18:13.21,0:18:14.55,Default,,0,0,0,,Сіз мақсатқа жеттіңіз.
Dialogue: 0,0:18:15.13,0:18:16.84,Default,,0,0,0,,Жоғарыдағы ақпарат дұрыс па?
Dialogue: 0,0:18:17.43,0:18:18.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:18.47,0:18:19.26,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:18:21.39,0:18:23.26,Default,,0,0,0,,…
Dialogue: 0,0:18:24.68,0:18:25.31,Default,,0,0,0,,Өте
Dialogue: 0,0:18:26.14,0:18:27.23,Default,,0,0,0,,Бұл үлкен...
Dialogue: 0,0:18:33.61,0:18:34.36,Default,,0,0,0,,Амия
Dialogue: 0,0:18:36.32,0:18:37.19,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:18:38.70,0:18:40.78,Default,,0,0,0,,Мен ұйықтамасам болады ма?
Dialogue: 0,0:18:42.24,0:18:42.95,Default,,0,0,0,,О
Dialogue: 0,0:18:43.66,0:18:44.29,Default,,0,0,0,,Көздер
Dialogue: 0,0:18:44.66,0:18:45.83,Default,,0,0,0,,Мен өзімді сергек сезінемін
Dialogue: 0,0:18:46.45,0:18:47.33,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:48.12,0:18:49.08,Default,,0,0,0,,Мен ұйықтай алмаймын
Dialogue: 0,0:18:49.37,0:18:51.38,Default,,0,0,0,,Мен таза ауа жұтуға келдім.
Dialogue: 0,0:18:53.88,0:18:55.09,Default,,0,0,0,,...
Dialogue: 0,0:18:55.76,0:18:57.51,Default,,0,0,0,,Мен оны ойымнан шығара алмаймын.
Dialogue: 0,0:18:59.38,0:19:00.09,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:00.55,0:19:03.47,Default,,0,0,0,,Мен идеалистік сөйлеп тұрған шығармын.
Dialogue: 0,0:19:03.97,0:19:04.60,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:19:04.89,0:19:06.22,Default,,0,0,0,,Дұрыс жолды таңдаңыз
Dialogue: 0,0:19:06.52,0:19:08.02,Default,,0,0,0,,Мен әрекет етіп жатырмын деп ойлаймын
Dialogue: 0,0:19:09.39,0:19:10.02,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:19:10.65,0:19:13.36,Default,,0,0,0,,Мен таңдаған жол шынымен дұрыс па?
Dialogue: 0,0:19:13.81,0:19:15.69,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:19:16.65,0:19:18.11,Default,,0,0,0,,Менің жүрегім солай
Dialogue: 0,0:19:18.57,0:19:20.28,Default,,0,0,0,,Мен өзімді көргендей сезінемін...
Dialogue: 0,0:19:22.07,0:19:22.91,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:23.74,0:19:24.83,Default,,0,0,0,,Мен осылай сөйлесем де
Dialogue: 0,0:19:24.91,0:19:26.70,Default,,0,0,0,,Бұл сізді тек қиындыққа душар етеді...
Dialogue: 0,0:19:28.33,0:19:29.16,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:19:30.04,0:19:32.21,Default,,0,0,0,,Эйс бұл туралы хабарламада айтты.
Dialogue: 0,0:19:33.96,0:19:34.75,Default,,0,0,0,,Бұл — бір сәт бұрынғы Итадори ешқашан жасамайтын қимыл
Dialogue: 0,0:19:35.50,0:19:36.46,Default,,0,0,0,,Сен және мен
Dialogue: 0,0:19:37.51,0:19:38.13,Default,,0,0,0,,Бұл…
Dialogue: 0,0:19:38.67,0:19:41.13,Default,,0,0,0,,Қатал дүниемен бетпе-бет келетін кезі келгенде
Dialogue: 0,0:19:43.34,0:19:44.26,Default,,0,0,0,,Бұл сөз
Dialogue: 0,0:19:44.64,0:19:46.72,Default,,0,0,0,,Мен әлі нақты мағынасын білмеймін...
Dialogue: 0,0:19:48.35,0:19:49.89,Default,,0,0,0,,Егер сіз өз идеалыңызды ұстансаңыз
Dialogue: 0,0:19:50.43,0:19:52.40,Default,,0,0,0,,Әрқашан шындықпен соқтығысыңыз...
Dialogue: 0,0:19:52.94,0:19:54.06,Default,,0,0,0,,Әлі де ол...
Dialogue: 0,0:19:54.48,0:19:59.07,Default,,0,0,0,,Мен сенің тура жолды жалғастыратыныңа сенемін.
Dialogue: 0,0:20:00.78,0:20:01.45,Default,,0,0,0,,Эйс мырза
Dialogue: 0,0:20:04.41,0:20:05.87,Default,,0,0,0,,Иә...дұрыс.
Dialogue: 0,0:20:06.91,0:20:09.58,Default,,0,0,0,,Мені шатастырмау керек...
Dialogue: 0,0:20:10.33,0:20:11.62,Default,,0,0,0,,Қазір мен үшін
Dialogue: 0,0:20:11.83,0:20:12.67,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:20:13.67,0:20:15.38,Default,,0,0,0,,Бірте-бірте алыңыз
Dialogue: 0,0:20:16.75,0:20:17.42,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:20:18.88,0:20:20.42,Default,,0,0,0,,Өз идеалыңызға міндетті түрде сәйкес келіңіз
Dialogue: 0,0:20:20.51,0:20:21.55,Default,,0,0,0,,Көмектесіңіз
Dialogue: 0,0:20:22.43,0:20:23.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:23.93,0:20:24.59,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:20:25.22,0:20:25.80,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:26.05,0:20:27.51,Default,,0,0,0,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:20:28.26,0:20:29.47,Default,,0,0,0,,Біз 3 күннен кейін
Dialogue: 0,0:20:29.72,0:20:31.56,Default,,0,0,0,,Мен жаңа миссияны қабылдауды жоспарлап отырмын.
Dialogue: 0,0:20:32.39,0:20:33.23,Default,,0,0,0,,Оған дейін
Dialogue: 0,0:20:33.48,0:20:34.94,Default,,0,0,0,,Көп демалыңыз
Dialogue: 0,0:20:35.27,0:20:37.77,Default,,0,0,0,,Дене күшіңізді қалпына келтіріңіз.
Dialogue: 0,0:20:39.11,0:20:39.73,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:20:46.95,0:20:48.03,Default,,0,0,0,,бастайық
Dialogue: 0,0:20:48.78,0:20:50.70,Default,,0,0,0,,Чернобогтағы операцияларда
Dialogue: 0,0:20:50.95,0:20:53.91,Default,,0,0,0,,Дәрігерді құтқару мақсатын орындады.
Dialogue: 0,0:20:54.58,0:20:56.17,Default,,0,0,0,,Құрбандық үлкен болды, бірақ...
Dialogue: 0,0:20:57.13,0:21:00.09,Default,,0,0,0,,Реюнионға қатысты ақпараттың үлкен көлемі де алынды.
Dialogue: 0,0:21:00.46,0:21:02.67,Default,,0,0,0,,Стратегиялық тұрғыдан алғанда, бұл сәтті деуге болады.
Dialogue: 0,0:21:03.59,0:21:04.93,Default,,0,0,0,,Сол талдаулардың нәтижелері...
Dialogue: 0,0:21:05.34,0:21:07.64,Default,,0,0,0,,Реюньонның келесі шабуыл мақсаты
Dialogue: 0,0:21:07.72,0:21:10.31,Default,,0,0,0,,Жалын елінің Айдаһар қақпасы болып шықты.
Dialogue: 0,0:21:11.93,0:21:12.60,Default,,0,0,0,,Ронмен...
Dialogue: 0,0:21:13.60,0:21:15.27,Default,,0,0,0,,Чернобог сияқты жаман емес
Dialogue: 0,0:21:15.64,0:21:18.48,Default,,0,0,0,,Рюмон - бұл жұқтырған адамдармен жұмыс істеу қиын жағдайға ие аймақ.
Dialogue: 0,0:21:19.15,0:21:22.03,Default,,0,0,0,,Доктор Келси бұған қатысты сайтта болды.
Dialogue: 0,0:21:22.49,0:21:25.15,Default,,0,0,0,,Рюмон өкілімен келісім-шартқа дайындалу
Dialogue: 0,0:21:26.16,0:21:26.95,Default,,0,0,0,,Орнатылған болса
Dialogue: 0,0:21:27.03,0:21:29.33,Default,,0,0,0,,Қала ішінде ашық түрде жұмыс істей алады, бірақ
Dialogue: 0,0:21:29.49,0:21:31.20,Default,,0,0,0,,Келісімшарттың тағдыры әлі белгісіз.
Dialogue: 0,0:21:32.08,0:21:34.00,Default,,0,0,0,,Сонымен дәрігер мен Амия
Dialogue: 0,0:21:34.08,0:21:35.33,Default,,0,0,0,,Айдаһар қақпасына кіріңіз
Dialogue: 0,0:21:35.41,0:21:36.42,Default,,0,0,0,,Доктор Келсимен
Dialogue: 0,0:21:36.50,0:21:38.75,Default,,0,0,0,,Келісім-шарт жасауға көшуіңізді қалаймын.
Dialogue: 0,0:21:39.29,0:21:40.25,Default,,0,0,0,,Заң күшіне енгеннен кейін
Dialogue: 0,0:21:40.59,0:21:42.84,Default,,0,0,0,,Лонгмендегі Реюнион тенденцияларын зерттеу
Dialogue: 0,0:21:42.92,0:21:44.01,Default,,0,0,0,,Бұл сіздің міндетіңіз.
Dialogue: 0,0:21:44.47,0:21:45.30,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:21:45.93,0:21:48.34,Default,,0,0,0,,Мен Ниаллдың менімен басқа миссияға барғанын қалаймын.
Dialogue: 0,0:21:48.72,0:21:49.51,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:21:50.43,0:21:52.72,Default,,0,0,0,,Реюньонның қимылдары күткеннен жақсырақ.
Dialogue: 0,0:21:53.52,0:21:54.85,Default,,0,0,0,,Өте сақ болыңыз.
Dialogue: 0,0:21:55.39,0:21:56.02,Default,,0,0,0,,Иә
Dialogue: 0,0:21:57.65,0:21:58.27,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:22:00.40,0:22:01.11,Default,,0,0,0,,Бұл жолы да
Dialogue: 0,0:22:01.73,0:22:03.03,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:22:05.49,0:22:06.32,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:22:07.82,0:22:13.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory