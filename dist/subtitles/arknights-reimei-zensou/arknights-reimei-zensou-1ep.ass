Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.46,0:00:03.46,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:00:06.17,0:00:07.17,Default,,0,0,0,,Дәрігер...!
Dialogue: 0,0:00:07.84,0:00:11.51,Default,,0,0,0,,-Біраз уақыттан бері шекараны кезіп жүрген сияқтысыз, доктор...!
Dialogue: 0,0:00:12.30,0:00:13.59,Default,,0,0,0,,Денеден тыс қан айналымының басталуы...
Dialogue: 0,0:00:14.01,0:00:14.64,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:00:14.64,0:00:16.39,Default,,0,0,0,,Кардиоплегия сұйықтығының толық инфузиясы
Dialogue: 0,0:00:17.72,0:00:18.76,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:00:18.97,0:00:19.68,Default,,0,0,0,,Қысқыштар!
Dialogue: 0,0:00:20.35,0:00:22.85,Default,,0,0,0,,Тұрақтандыруды бастау
Dialogue: 0,0:00:22.98,0:00:23.77,Default,,0,0,0,,Енді мұнда көп қалма.
Dialogue: 0,0:00:25.10,0:00:26.98,Default,,0,0,0,,Енді бұл жерде көп қалма.
Dialogue: 0,0:00:27.56,0:00:28.52,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:00:28.86,0:00:31.53,Default,,0,0,0,,Мен тағы да азап шегуім керек
Dialogue: 0,0:00:32.99,0:00:35.24,Default,,0,0,0,,Оған сен керексің
Dialogue: 0,0:00:36.32,0:00:37.20,Default,,0,0,0,,Дәрігер...?
Dialogue: 0,0:00:37.82,0:00:38.70,Default,,0,0,0,,Дәрігер!?
Dialogue: 0,0:00:39.83,0:00:40.83,Default,,0,0,0,,Дәрігер!!
Dialogue: 0,0:00:42.12,0:00:44.16,Default,,0,0,0,,Шынымен... жақсы болды...
Dialogue: 0,0:00:45.62,0:00:46.83,Default,,0,0,0,,Оян
Dialogue: 0,0:00:48.17,0:00:49.09,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:00:49.34,0:00:50.46,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:00:50.71,0:00:51.67,Default,,0,0,0,,Бұл Амия.
Dialogue: 0,0:00:52.42,0:00:54.80,Default,,0,0,0,,Мен сені алып кетуге мүмкіндік алдым......
Dialogue: 0,0:00:58.85,0:00:59.85,Default,,0,0,0,,Дәрігер...?
Dialogue: 0,0:01:00.60,0:01:01.81,Default,,0,0,0,,Не болды...?
Dialogue: 0,0:01:02.68,0:01:03.85,Default,,0,0,0,,Менің дауысым...
Dialogue: 0,0:01:04.85,0:01:06.23,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:01:06.77,0:01:08.11,Default,,0,0,0,,Дене температурасы қан қысымы
Dialogue: 0,0:01:08.52,0:01:10.40,Default,,0,0,0,,Қалыпты диапазондағы барлық қалғандары
Dialogue: 0,0:01:10.65,0:01:13.57,Default,,0,0,0,,Сандар бойынша физикалық функцияға есептер бар...
Dialogue: 0,0:01:14.44,0:01:15.53,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:01:17.49,0:01:18.24,Default,,0,0,0,,Амия-сан
Dialogue: 0,0:01:18.49,0:01:20.53,Default,,0,0,0,,Капитан Доберманнан шұғыл хабарлама!
Dialogue: 0,0:01:20.99,0:01:23.29,Default,,0,0,0,,Реюньон деп есептелетін қарулы топ расталды!
Dialogue: 0,0:01:24.58,0:01:25.96,Default,,0,0,0,,Оқиға орнынан дереу кетіңіз
Dialogue: 0,0:01:26.21,0:01:27.46,Default,,0,0,0,,Контактіні болдырмаңыз
Dialogue: 0,0:01:27.75,0:01:28.50,Default,,0,0,0,,!
Dialogue: 0,0:01:28.79,0:01:30.29,Default,,0,0,0,,Неліктен кездесу керек?
Dialogue: 0,0:01:30.92,0:01:32.21,Default,,0,0,0,,Осы уақытқа дейін...
Dialogue: 0,0:01:32.55,0:01:33.63,Default,,0,0,0,,Мүмкін дәрігер...
Dialogue: 0,0:01:33.71,0:01:37.01,Default,,0,0,0,,Жоқ, олар дәрігердің бар екенін білмеуі керек...
Dialogue: 0,0:01:37.43,0:01:38.68,Default,,0,0,0,,Қандай мақсат болса да
Dialogue: 0,0:01:38.76,0:01:41.60,Default,,0,0,0,,Олармен қазір байланысу жақсы идея емес.
Dialogue: 0,0:01:41.85,0:01:43.10,Default,,0,0,0,,Тез көшейік.
Dialogue: 0,0:01:43.18,0:01:43.81,Default,,0,0,0,,-Түсінікті -Иә!
Dialogue: 0,0:01:44.81,0:01:46.60,Default,,0,0,0,,Кешіріңіз, мен енді ғана ояндым.
Dialogue: 0,0:01:47.14,0:01:48.19,Default,,0,0,0,,Бұл жерде қауіпті
Dialogue: 0,0:01:48.52,0:01:50.40,Default,,0,0,0,,Дереу киімдеріңізді ауыстырып, көшеге шығыңыз
Dialogue: 0,0:01:53.69,0:01:54.48,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:01:55.78,0:01:56.78,Default,,0,0,0,,Тағы кездескенше...
Dialogue: 0,0:01:57.90,0:01:58.74,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:03:11.19,0:03:12.02,Default,,0,0,0,,Аномалия жоқ
Dialogue: 0,0:03:16.23,0:03:17.11,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:03:17.48,0:03:18.86,Default,,0,0,0,,Қысқа үзіліс...
Dialogue: 0,0:03:19.15,0:03:19.90,Default,,0,0,0,,Амия-сан
Dialogue: 0,0:03:20.40,0:03:22.36,Default,,0,0,0,,Капитан Доберманмен байланысу мүмкін емес
Dialogue: 0,0:03:24.49,0:03:27.62,Default,,0,0,0,,Олар Реюньонмен соғысып жатқан шығар...
Dialogue: 0,0:03:28.12,0:03:29.96,Default,,0,0,0,,Біз де сақ болуымыз керек...
Dialogue: 0,0:03:30.79,0:03:31.58,Default,,0,0,0,,!!?Дәрігер!!!
Dialogue: 0,0:03:31.62,0:03:32.75,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,0:03:33.04,0:03:34.38,Default,,0,0,0,,Сіздің тыныс алуыңыз тым таяз!
Dialogue: 0,0:03:34.50,0:03:35.75,Default,,0,0,0,,Терең тыныс ал!
Dialogue: 0,0:03:36.67,0:03:37.50,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:03:38.09,0:03:38.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:39.09,0:03:40.55,Default,,0,0,0,,Мен өзімді солай жасауға мәжбүрледім.
Dialogue: 0,0:03:41.22,0:03:42.26,Default,,0,0,0,,Мен оны арқама көтеріп алайын
Dialogue: 0,0:03:42.55,0:03:43.84,Default,,0,0,0,,Алда қырағылықты сұраңыз
Dialogue: 0,0:03:43.93,0:03:44.80,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:45.39,0:03:46.10,Default,,0,0,0,,Бұдан басқа
Dialogue: 0,0:03:46.39,0:03:49.14,Default,,0,0,0,,Біз Реюньонның қайда жасырынып жатқанын білмейміз.
Dialogue: 0,0:03:49.73,0:03:51.27,Default,,0,0,0,,Сақтықпен
Dialogue: 0,0:03:51.56,0:03:52.19,Default,,0,0,0,,Жүз бір
Dialogue: 0,0:03:52.39,0:03:54.48,Default,,0,0,0,,Кездесу нүктесінің жанына барайық
Dialogue: 0,0:04:04.78,0:04:05.57,Default,,0,0,0,,Дәрігер...?
Dialogue: 0,0:04:06.24,0:04:07.08,Default,,0,0,0,,Дәрігер!!
Dialogue: 0,0:04:09.45,0:04:10.33,Default,,0,0,0,,Тынышталыңыз...
Dialogue: 0,0:04:10.91,0:04:12.79,Default,,0,0,0,,Баяу дем ал...
Dialogue: 0,0:04:13.25,0:04:15.50,Default,,0,0,0,,Сөйлеуге өзіңізді мәжбүрлемесеңіз жақсы...
Dialogue: 0,0:04:16.13,0:04:17.09,Default,,0,0,0,,Кемеге оралғаннан кейін
Dialogue: 0,0:04:17.17,0:04:18.50,Default,,0,0,0,,Біраз демалып алайық
Dialogue: 0,0:04:19.30,0:04:20.46,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:04:21.47,0:04:23.01,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:04:30.27,0:04:32.43,Default,,0,0,0,,Кездесу орнында кездесу бар...
Dialogue: 0,0:04:33.23,0:04:34.98,Default,,0,0,0,,Шайқастың дәлелі жоқ сияқты.
Dialogue: 0,0:04:35.40,0:04:37.02,Default,,0,0,0,,Сіз енді ол жерді пайдалана алмайсыз...
Dialogue: 0,0:04:38.19,0:04:40.36,Default,,0,0,0,,В жоспарының нүктесіне көшейік
Dialogue: 0,0:04:40.86,0:04:44.49,Default,,0,0,0,,Егер сіз Добермандармен сол жерде де кездесе алмасаңыз.
Dialogue: 0,0:04:44.61,0:04:46.03,Default,,0,0,0,,Жақын аумақты іздеу
Dialogue: 0,0:04:50.62,0:04:51.83,Default,,0,0,0,,Мен аяқ дыбыстарын естимін...
Dialogue: 0,0:04:52.00,0:04:53.04,Default,,0,0,0,,Қайтып кел!
Dialogue: 0,0:04:55.00,0:04:56.29,Default,,0,0,0,,Мұнда да адамдар келеді...
Dialogue: 0,0:04:57.13,0:04:57.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:58.29,0:04:59.50,Default,,0,0,0,,Балалар сендер қандайсыңдар...
Dialogue: 0,0:04:59.63,0:05:00.92,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:05:01.25,0:05:02.34,Default,,0,0,0,,Қаруларыңызды тастаңыздар!!
Dialogue: 0,0:05:02.88,0:05:03.84,Default,,0,0,0,,Сіз кімсіз!
Dialogue: 0,0:05:03.97,0:05:05.09,Default,,0,0,0,,Сен мұнда не істеп жүрсің!!
Dialogue: 0,0:05:05.18,0:05:05.80,Default,,0,0,0,,Айт!
Dialogue: 0,0:05:06.97,0:05:09.51,Default,,0,0,0,,Біз сенің жауың емеспіз
Dialogue: 0,0:05:09.93,0:05:11.22,Default,,0,0,0,,қазіргі уақытта қарғысқа ұшыраған эмбрионмен бірге әлі де сонда қамалып отыр –
Dialogue: 0,0:05:12.64,0:05:15.06,Default,,0,0,0,,Сіз маған шындықты айтпайсыз деп ойлаймын.
Dialogue: 0,0:05:15.27,0:05:17.02,Default,,0,0,0,,Барлық заттарыңызды тексеріңіз
Dialogue: 0,0:05:17.23,0:05:18.10,Default,,0,0,0,,Мені алып кетіңіз
Dialogue: 0,0:05:19.19,0:05:19.98,Default,,0,0,0,,Тұр
Dialogue: 0,0:05:20.44,0:05:21.11,Default,,0,0,0,,Сәлем!!
Dialogue: 0,0:05:21.61,0:05:22.57,Default,,0,0,0,,Күзетші!!
Dialogue: 0,0:05:22.86,0:05:24.69,Default,,0,0,0,,Қажетсіз ештеңе жасамаңыз
Dialogue: 0,0:05:27.53,0:05:28.20,Default,,0,0,0,,Не!?
Dialogue: 0,0:05:28.24,0:05:29.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:30.45,0:05:31.74,Default,,0,0,0,,Доберман мырза!
Dialogue: 0,0:05:31.99,0:05:33.70,Default,,0,0,0,,Кәсібі: тыңшы
Dialogue: 0,0:05:34.25,0:05:35.08,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:05:35.29,0:05:36.71,Default,,0,0,0,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:05:36.92,0:05:39.00,Default,,0,0,0,,Міне! Ұстаңыз! Оның қашып кетуіне жол бермеңіз!
Dialogue: 0,0:05:39.08,0:05:42.00,Default,,0,0,0,,Төменгі адамдар қазіргі дүрбелеңге байланысты байқады.
Dialogue: 0,0:05:42.34,0:05:43.76,Default,,0,0,0,,Тесік тапты
Dialogue: 0,0:05:43.84,0:05:44.46,Default,,0,0,0,,Маған еріңіз
Dialogue: 0,0:05:47.80,0:05:49.34,Default,,0,0,0,,Кездескенімізге қуаныштымын.
Dialogue: 0,0:05:49.72,0:05:50.35,Default,,0,0,0,,Иә
Dialogue: 0,0:05:50.43,0:05:52.72,Default,,0,0,0,,Дәрігер де аман-есен құтқарылды.
Dialogue: 0,0:05:52.97,0:05:55.02,Default,,0,0,0,,Енді жерді көздеңіз
Dialogue: 0,0:05:55.39,0:05:56.52,Default,,0,0,0,,Осымен
Dialogue: 0,0:05:56.64,0:05:59.31,Default,,0,0,0,,Көптеген реюниондар жерасты өткеліне басып кірді.
Dialogue: 0,0:06:00.06,0:06:02.94,Default,,0,0,0,,Сіз бірдеңе іздеп жатқан сияқтысыз, бірақ мен не іздеп жатқаныңызды білмеймін.
Dialogue: 0,0:06:03.57,0:06:04.65,Default,,0,0,0,,Жалғыз нәрсе сенімді
Dialogue: 0,0:06:04.73,0:06:07.82,Default,,0,0,0,,Бұл біздің жау ретінде танылғанымызды білдіреді.
Dialogue: 0,0:06:08.32,0:06:12.53,Default,,0,0,0,,Біз пайдалануды жоспарлаған жер бетіне шығатын барлық жолдар бос деп есептеген дұрыс.
Dialogue: 0,0:06:13.29,0:06:15.50,Default,,0,0,0,,Бірақ басқа шығу жолдарын іздеуге уақыт жоқ.
Dialogue: 0,0:06:15.83,0:06:17.54,Default,,0,0,0,,Шайқас сөзсіз болады
Dialogue: 0,0:06:17.71,0:06:18.37,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:06:18.79,0:06:21.21,Default,,0,0,0,,Мен сіздің жауынгерлік командалық қабілеттеріңіз туралы қауесетті естідім.
Dialogue: 0,0:06:21.75,0:06:24.38,Default,,0,0,0,,Мен шығуды бұзып өту үшін жауынгерлік команданы сұрағым келеді.
Dialogue: 0,0:06:25.21,0:06:25.88,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:06:26.21,0:06:27.59,Default,,0,0,0,,PRTS
Dialogue: 0,0:06:29.97,0:06:32.26,Default,,0,0,0,,Мен сізді мәжбүрлегенім үшін кешіріңіз.
Dialogue: 0,0:06:33.14,0:06:33.97,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:34.06,0:06:35.39,Default,,0,0,0,,Егер сіздің командаңыз
Dialogue: 0,0:06:35.60,0:06:37.93,Default,,0,0,0,,Әр адам жерге аман-есен қашып кетуі керек.
Dialogue: 0,0:06:39.14,0:06:40.23,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:40.44,0:06:41.15,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:06:41.48,0:06:43.15,Default,,0,0,0,,Бізге көмектесіңізші
Dialogue: 0,0:06:44.11,0:06:45.48,Default,,0,0,0,,КІРУ
Dialogue: 0,0:06:50.41,0:06:51.28,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:06:51.36,0:06:51.99,Default,,0,0,0,,･･･Жоқ...
Dialogue: 0,0:06:52.07,0:06:52.70,Default,,0,0,0,,Ž...?
Dialogue: 0,0:06:53.28,0:06:55.45,Default,,0,0,0,,Сезімімді... айтып жеткізе алмаймын...
Dialogue: 0,0:06:57.08,0:06:58.20,Default,,0,0,0,,Мен оны Солтүстік-Шығыс әскери театрдан алдым.
Dialogue: 0,0:06:58.50,0:06:59.96,Default,,0,0,0,,Э?
Dialogue: 0,0:07:01.04,0:07:02.46,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:02.67,0:07:03.71,Default,,0,0,0,,Біреу...
Dialogue: 0,0:07:04.46,0:07:05.88,Default,,0,0,0,,...Білмеймін
Dialogue: 0,0:07:06.92,0:07:07.88,Default,,0,0,0,,･･･
Dialogue: 0,0:07:08.59,0:07:09.80,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:07:10.88,0:07:12.76,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:07:14.93,0:07:15.68,Default,,0,0,0,,Эй
Dialogue: 0,0:07:15.72,0:07:16.89,Default,,0,0,0,,Сіз не туралы айтып отырсыз...?
Dialogue: 0,0:07:17.31,0:07:18.68,Default,,0,0,0,,Мұндай уақытта қалжыңдама
Dialogue: 0,0:07:18.93,0:07:19.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:19.98,0:07:21.52,Default,,0,0,0,,Бұл өтірік емес деп ойлаймын
Dialogue: 0,0:07:21.77,0:07:23.15,Default,,0,0,0,,Өте сирек
Dialogue: 0,0:07:23.31,0:07:27.36,Default,,0,0,0,,Адамдар суық ұйқыдан оянғаннан кейін есте сақтау қабілетінің төмендеуіне шағымданатын жағдайлар бар.
Dialogue: 0,0:07:27.61,0:07:28.69,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:07:29.03,0:07:30.45,Default,,0,0,0,,Ол қалпына келе ме?
Dialogue: 0,0:07:30.65,0:07:31.61,Default,,0,0,0,,Жад қашан оралады?
Dialogue: 0,0:07:32.03,0:07:33.57,Default,,0,0,0,,Менде де мәліметтер бар...
Dialogue: 0,0:07:33.87,0:07:34.70,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:07:35.45,0:07:36.62,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:07:37.08,0:07:39.66,Default,,0,0,0,,Сіз орипатияны зерттеуді ұмыттыңыз ба...?
Dialogue: 0,0:07:40.50,0:07:41.21,Default,,0,0,0,,Амия:
Dialogue: 0,0:07:41.37,0:07:43.96,Default,,0,0,0,,Жағдай бастапқы жоспардан тым өзгеше
Dialogue: 0,0:07:44.17,0:07:45.96,Default,,0,0,0,,Біз стратегиямызды қайта қарауымыз керек...
Dialogue: 0,0:07:46.42,0:07:47.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:47.25,0:07:48.38,Default,,0,0,0,,Родос саясаты…
Dialogue: 0,0:07:48.92,0:07:50.22,Default,,0,0,0,,Амия, тыңдап тұрсың ба?
Dialogue: 0,0:07:51.42,0:07:52.43,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:54.01,0:07:54.72,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:07:55.68,0:07:56.55,Default,,0,0,0,,...Жарайды.
Dialogue: 0,0:07:57.10,0:07:58.81,Default,,0,0,0,,Қай жерде жақсы?
Dialogue: 0,0:07:58.89,0:08:00.52,Default,,0,0,0,,Сіз өзіңізді де есіңе түсірмейсіз!!
Dialogue: 0,0:08:00.81,0:08:03.35,Default,,0,0,0,,Бірдеңе есіңізде болуы мүмкін
Dialogue: 0,0:08:03.56,0:08:06.36,Default,,0,0,0,,Сіздің жадыңыз қайта оралмайды деп шешілген жоқ.
Dialogue: 0,0:08:06.44,0:08:08.11,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:08:08.19,0:08:09.65,Default,,0,0,0,,Тілек – бұл
Dialogue: 0,0:08:12.11,0:08:12.74,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:13.28,0:08:15.53,Default,,0,0,0,,Қазіргі әскери күшіңізбен не істей алатыныңызды ойлаңыз.
Dialogue: 0,0:08:18.24,0:08:19.04,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:08:19.87,0:08:20.83,Default,,0,0,0,,Сен
Dialogue: 0,0:08:21.04,0:08:23.33,Default,,0,0,0,,Олар біздің қымбат достарымыз.
Dialogue: 0,0:08:24.58,0:08:25.54,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:26.17,0:08:26.96,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:08:27.42,0:08:28.59,Default,,0,0,0,,Өйткені мен есімде сақтай аламын
Dialogue: 0,0:08:53.61,0:08:54.36,Default,,0,0,0,,Аномалия жоқ
Dialogue: 0,0:08:55.16,0:08:56.95,Default,,0,0,0,,Мен бұл да жаман идея деп ойладым...
Dialogue: 0,0:08:57.87,0:08:59.20,Default,,0,0,0,,Сіздің қорқыныштарыңыз негізсіз болды ма...?
Dialogue: 0,0:08:59.95,0:09:01.49,Default,,0,0,0,,Родоспен байланысуға болады ма?
Dialogue: 0,0:09:02.62,0:09:03.62,Default,,0,0,0,,Жауап жоқ
Dialogue: 0,0:09:03.87,0:09:05.50,Default,,0,0,0,,Кептелу әлі жалғасуда
Dialogue: 0,0:09:06.46,0:09:07.38,Default,,0,0,0,,Сіз алға жылжуды қалайсыз ба?
Dialogue: 0,0:09:07.63,0:09:08.25,Default,,0,0,0,,О
Dialogue: 0,0:09:08.71,0:09:10.84,Default,,0,0,0,,Бірақ алдымен жердегі жағдайды тексеріңіз.
Dialogue: 0,0:09:11.59,0:09:13.17,Default,,0,0,0,,Сен екеуміз жоғарыға көтерілеміз.
Dialogue: 0,0:09:14.05,0:09:15.97,Default,,0,0,0,,Қалғандары, артқа қарайды.
Dialogue: 0,0:09:16.05,0:09:16.97,Default,,0,0,0,,Сигнал күтіңіз
Dialogue: 0,0:09:17.51,0:09:18.30,Default,,0,0,0,,･･･
Dialogue: 0,0:09:20.22,0:09:22.06,Default,,0,0,0,,Қайтып оралған дұрыс...
Dialogue: 0,0:09:22.77,0:09:23.73,Default,,0,0,0,,Қайту...
Dialogue: 0,0:09:24.39,0:09:25.85,Default,,0,0,0,,Бұл жер астына қайта баруым керек дегенді білдіре ме?
Dialogue: 0,0:09:26.39,0:09:27.02,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:09:28.48,0:09:29.48,Default,,0,0,0,,Сол екеуі...
Dialogue: 0,0:09:30.32,0:09:31.07,Default,,0,0,0,,Қауіпті...
Dialogue: 0,0:09:32.15,0:09:32.94,Default,,0,0,0,,Артқа!!!
Dialogue: 0,0:09:35.78,0:09:36.40,Default,,0,0,0,,Қақпа!!
Dialogue: 0,0:09:37.28,0:09:38.11,Default,,0,0,0,,Бұл қақпан ба...!
Dialogue: 0,0:09:41.16,0:09:41.99,Default,,0,0,0,,Шегіну!!
Dialogue: 0,0:09:42.08,0:09:42.70,Default,,0,0,0,,Қолдау!!
Dialogue: 0,0:09:43.29,0:09:44.20,Default,,0,0,0,,Ол да төменнен келеді!!!
Dialogue: 0,0:09:45.25,0:09:46.00,Default,,0,0,0,,Бұл да!!
Dialogue: 0,0:09:47.21,0:09:48.46,Default,,0,0,0,,Мен сені осында тоқтатамын!!
Dialogue: 0,0:09:49.00,0:09:49.75,Default,,0,0,0,,Сіз мені естисіз бе...
Dialogue: 0,0:09:49.96,0:09:51.50,Default,,0,0,0,,Капитан Доберманды қолдау...
Dialogue: 0,0:09:52.05,0:09:52.96,Default,,0,0,0,,Амия-сан!!
Dialogue: 0,0:09:53.30,0:09:54.09,Default,,0,0,0,,->...
Dialogue: 0,0:09:54.21,0:09:55.09,Default,,0,0,0,,Жауап беру...
Dialogue: 0,0:09:55.84,0:09:56.72,Default,,0,0,0,,Бұл Эйс!!
Dialogue: 0,0:09:57.05,0:09:57.68,Default,,0,0,0,,Сіз мені естисіз бе!!
Dialogue: 0,0:09:58.18,0:09:59.22,Default,,0,0,0,,Капитан Эйс!?
Dialogue: 0,0:09:59.55,0:10:00.30,Default,,0,0,0,,Мен сізді естимін!!
Dialogue: 0,0:10:01.10,0:10:02.01,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:10:02.31,0:10:03.52,Default,,0,0,0,,Есту гранатасын қолданыңыз!
Dialogue: 0,0:10:03.60,0:10:04.22,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,0:10:04.85,0:10:05.89,Default,,0,0,0,,Егер мен сигнал берсем
Dialogue: 0,0:10:06.14,0:10:07.23,Default,,0,0,0,,Көздеріңіз бен құлақтарыңызды жабыңыз!
Dialogue: 0,0:10:07.94,0:10:08.56,Default,,0,0,0,,Кеттік!!
Dialogue: 0,0:10:08.65,0:10:09.48,Default,,0,0,0,,Дәрігер, жатыңыз!!
Dialogue: 0,0:10:49.27,0:10:50.27,Default,,0,0,0,,Бітті...
Dialogue: 0,0:10:50.35,0:10:51.65,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:10:54.23,0:10:55.40,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:10:56.40,0:10:58.40,Default,,0,0,0,,Сондай кішкентай бала да...
Dialogue: 0,0:11:01.16,0:11:03.16,Default,,0,0,0,,Дүкеніңізді рұқсатсыз жалға алғаным үшін кешіріңіз.
Dialogue: 0,0:11:04.08,0:11:05.12,Default,,0,0,0,,Біраз уақытқа
Dialogue: 0,0:11:05.20,0:11:07.16,Default,,0,0,0,,Маған осы жерде демалуға рұқсат етіңіз.
Dialogue: 0,0:11:08.75,0:11:09.54,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:11:10.79,0:11:11.96,Default,,0,0,0,,Мен оны саған бергім келді.
Dialogue: 0,0:11:15.00,0:11:16.34,Default,,0,0,0,,КІРУ
Dialogue: 0,0:11:17.84,0:11:18.72,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:11:19.51,0:11:21.55,Default,,0,0,0,,Бұл PRTS
Dialogue: 0,0:11:21.89,0:11:23.80,Default,,0,0,0,,Саусақ ізінің аутентификациясы арқылы жүйеге кіруге болады
Dialogue: 0,0:11:24.43,0:11:26.47,Default,,0,0,0,,Сізге қажетті ақпаратты береді
Dialogue: 0,0:11:26.76,0:11:28.22,Default,,0,0,0,,Біздің достар
Dialogue: 0,0:11:33.19,0:11:34.23,Default,,0,0,0,,…Жарайды.
Dialogue: 0,0:11:34.90,0:11:35.65,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:11:36.11,0:11:37.90,Default,,0,0,0,,Ақырын еске түсірейік
Dialogue: 0,0:11:38.57,0:11:39.69,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:11:40.15,0:11:42.61,Default,,0,0,0,,Артқы жолдардағы қауіпсіздікті қамтамасыз ету
Dialogue: 0,0:11:42.86,0:11:44.24,Default,,0,0,0,,10 минуттан кейін шығу
Dialogue: 0,0:11:44.91,0:11:46.12,Default,,0,0,0,,Оған дейін демалыңыз.
Dialogue: 0,0:11:49.91,0:11:50.83,Default,,0,0,0,,Эйс мырза
Dialogue: 0,0:11:51.16,0:11:51.79,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:11:52.58,0:11:54.04,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:11:54.92,0:11:55.75,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:11:56.71,0:11:58.59,Default,,0,0,0,,Мен есте сақтау қабілетінің төмендеуі туралы естідім.
Dialogue: 0,0:12:00.72,0:12:01.80,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:12:02.34,0:12:03.47,Default,,0,0,0,,Аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,0:12:05.14,0:12:06.55,Default,,0,0,0,,Родосқа қайтып келгенде
Dialogue: 0,0:12:06.64,0:12:07.97,Default,,0,0,0,,Баяу сөйлеңіз
Dialogue: 0,0:12:08.47,0:12:09.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:09.77,0:12:10.85,Default,,0,0,0,,Доберман капитаны
Dialogue: 0,0:12:11.68,0:12:13.14,Default,,0,0,0,,Мен жеткілікті сақ емеспін ...
Dialogue: 0,0:12:13.60,0:12:14.15,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:14.40,0:12:16.65,Default,,0,0,0,,Жаудың қимылдары мүлде күтпеген еді.
Dialogue: 0,0:12:17.36,0:12:19.28,Default,,0,0,0,,Менің өмірім сақталды.
Dialogue: 0,0:12:20.11,0:12:21.40,Default,,0,0,0,,Барлау тобының баяндамасында
Dialogue: 0,0:12:21.49,0:12:22.57,Default,,0,0,0,,Бүкіл қала бойынша
Dialogue: 0,0:12:22.65,0:12:24.53,Default,,0,0,0,,Реюнион қызып жатыр
Dialogue: 0,0:12:25.45,0:12:27.53,Default,,0,0,0,,Талан-таражға салу
Dialogue: 0,0:12:27.66,0:12:28.99,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:12:29.91,0:12:31.20,Default,,0,0,0,,Сіз мұны істесеңіз де
Dialogue: 0,0:12:31.91,0:12:34.33,Default,,0,0,0,,Қудалау тек күшейе түседі...
Dialogue: 0,0:12:35.33,0:12:36.08,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:12:36.46,0:12:38.09,Default,,0,0,0,,Бізге не шабуыл жасады
Dialogue: 0,0:12:38.17,0:12:39.42,Default,,0,0,0,,Реюнион қозғалысы
Dialogue: 0,0:12:40.34,0:12:44.09,Default,,0,0,0,,«Орипатия» ауруын жұқтырған адамдар ғана ұйымдастырған.
Dialogue: 0,0:12:44.22,0:12:45.30,Default,,0,0,0,,Террористік топ
Dialogue: 0,0:12:46.39,0:12:48.93,Default,,0,0,0,,Алдымен олар өздерін кемсітуге қарсылық білдірді.
Dialogue: 0,0:12:49.56,0:12:52.43,Default,,0,0,0,,Бұл жай ғана шеру шеруіне арналған жиын болған сияқты.
Dialogue: 0,0:12:53.02,0:12:55.98,Default,,0,0,0,,Оның шынайы болмысы ақыры азу тістерін ашты ма?
Dialogue: 0,0:12:56.35,0:12:57.40,Default,,0,0,0,,Олар да
Dialogue: 0,0:12:58.06,0:12:59.36,Default,,0,0,0,,Урсус үкіметіне қарсы көтеріліс жасасаңыз
Dialogue: 0,0:12:59.44,0:13:00.61,Default,,0,0,0,,Бұл тегін емес
Dialogue: 0,0:13:00.69,0:13:01.82,Default,,0,0,0,,Сіз білуіңіз керек
Dialogue: 0,0:13:02.36,0:13:05.15,Default,,0,0,0,,Бұл олардың жеңіске жету мүмкіндігі бар екенін білдіреді.
Dialogue: 0,0:13:06.07,0:13:09.08,Default,,0,0,0,,Урсус қауіпсіздік күштері әлі де тоқтата алмады ...
Dialogue: 0,0:13:09.16,0:13:10.45,Default,,0,0,0,,Бұл дәлел.
Dialogue: 0,0:13:11.12,0:13:13.33,Default,,0,0,0,,Саған рақмет, менің күн тәртібім бей-берекет болды.
Dialogue: 0,0:13:13.41,0:13:15.16,Default,,0,0,0,,Бірақ бұл маған көмектесті.
Dialogue: 0,0:13:15.29,0:13:17.58,Default,,0,0,0,,Егер Эйс сол кезде мені тексеруге келмеген болса...
Dialogue: 0,0:13:17.67,0:13:19.84,Default,,0,0,0,,Мен Рей туралы көп естігенім сонша, мен өлдім.
Dialogue: 0,0:13:21.75,0:13:23.34,Default,,0,0,0,,Сонда да сол жігіттер
Dialogue: 0,0:13:23.76,0:13:26.38,Default,,0,0,0,,Табиғат апаты жақындап қалған бұл уақытта неге...
Dialogue: 0,0:13:26.72,0:13:28.22,Default,,0,0,0,,Басынан бастап
Dialogue: 0,0:13:28.39,0:13:30.97,Default,,0,0,0,,Менің ойымша, олар табиғи апаттан туындаған хаосты пайдаланып қалуға тырысты.
Dialogue: 0,0:13:31.51,0:13:34.06,Default,,0,0,0,,Тіпті өз өміріне қауіп төнген жағдайда да
Dialogue: 0,0:13:34.14,0:13:34.98,Default,,0,0,0,,Кек алуға қол жеткізу...
Dialogue: 0,0:13:35.06,0:13:37.35,Default,,0,0,0,,Сіз аң аулаудан қалып қойған Урсусандар бар ма!!!!
Dialogue: 0,0:13:37.90,0:13:40.36,Default,,0,0,0,,Олар қансыз, көз жасы жоқ қоқыс!!
Dialogue: 0,0:13:40.77,0:13:42.73,Default,,0,0,0,,Біз көрген азап
Dialogue: 0,0:13:42.86,0:13:44.78,Default,,0,0,0,,Қазір дәмін татып көрейін!!!!
Dialogue: 0,0:13:45.32,0:13:45.95,Default,,0,0,0,,Қанша?
Dialogue: 0,0:13:46.53,0:13:47.61,Default,,0,0,0,,Шамамен 20 адам
Dialogue: 0,0:13:47.99,0:13:49.41,Default,,0,0,0,,Ұрысқа түспеу керек
Dialogue: 0,0:13:50.12,0:13:51.45,Default,,0,0,0,,Сол жақтан жаулар келе жатыр!
Dialogue: 0,0:13:51.58,0:13:52.79,Default,,0,0,0,,Мен артта келемін!
Dialogue: 0,0:13:56.96,0:13:57.67,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:13:59.63,0:14:00.63,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:01.09,0:14:02.09,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:14:06.09,0:14:07.26,Default,,0,0,0,,Өзім…
Dialogue: 0,0:14:07.47,0:14:08.18,Default,,0,0,0,,Жүгіре алады
Dialogue: 0,0:14:20.61,0:14:21.56,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:14:21.65,0:14:22.27,Default,,0,0,0,,Не болды!?
Dialogue: 0,0:14:22.65,0:14:25.03,Default,,0,0,0,,Екі ата-анасы мен балалары барлар үшін...
Dialogue: 0,0:14:25.82,0:14:26.44,Default,,0,0,0,,Табылған жағдайда
Dialogue: 0,0:14:26.53,0:14:27.86,Default,,0,0,0,,Сізді өлтіреді...
Dialogue: 0,0:14:27.95,0:14:28.57,Default,,0,0,0,,Күте тұрыңыз!!
Dialogue: 0,0:14:29.16,0:14:32.45,Default,,0,0,0,,Егер сіз көптеген адамдармен бетпе-бет келсеңіз де, құрбандар тек көбейеді!!
Dialogue: 0,0:14:32.66,0:14:34.37,Default,,0,0,0,,Мен оның қауіпті екенін білемін.
Dialogue: 0,0:14:34.45,0:14:36.33,Default,,0,0,0,,Бірақ біз оны назардан тыс қалдыра алмаймыз!
Dialogue: 0,0:14:36.58,0:14:38.16,Default,,0,0,0,,Жағдайды қара, Амия!
Dialogue: 0,0:14:38.25,0:14:39.42,Default,,0,0,0,,Егер шайқас ұзаққа созылса
Dialogue: 0,0:14:39.50,0:14:41.08,Default,,0,0,0,,Егер көп адам жарақат алса
Dialogue: 0,0:14:41.17,0:14:42.63,Default,,0,0,0,,Табиғат апатынан құтыла алмайсың.
Dialogue: 0,0:14:42.71,0:14:44.25,Default,,0,0,0,,Мұндағылардың бәрі өледі!!
Dialogue: 0,0:14:44.34,0:14:45.55,Default,,0,0,0,,Сабыр ет, Доберман!
Dialogue: 0,0:14:45.63,0:14:47.17,Default,,0,0,0,,Сіз Родостың өкілісіз.
Dialogue: 0,0:14:47.51,0:14:49.05,Default,,0,0,0,,Басшы ретінде
Dialogue: 0,0:14:49.13,0:14:51.55,Default,,0,0,0,,Қазір нені бірінші орынға қою керектігі туралы ойланыңыз.
Dialogue: 0,0:14:56.31,0:14:58.06,Default,,0,0,0,,КІРУ
Dialogue: 0,0:14:58.98,0:15:03.02,Default,,0,0,0,,Әкімші
Dialogue: 0,0:15:03.65,0:15:05.44,Default,,0,0,0,,Басталуда... Жарайды
Dialogue: 0,0:15:06.40,0:15:08.07,Default,,0,0,0,,Рұқсат Lv. 8
Dialogue: 0,0:15:08.61,0:15:09.61,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:15:10.07,0:15:10.86,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:15:12.78,0:15:13.66,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:14.70,0:15:16.12,Default,,0,0,0,,Дрондарды орналастыру
Dialogue: 0,0:15:17.66,0:15:19.29,Default,,0,0,0,,Жауларды іздеуді бастаңыз
Dialogue: 0,0:15:20.25,0:15:21.21,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:15:21.42,0:15:22.17,Default,,0,0,0,,Сіз көмектесе аласыз...
Dialogue: 0,0:15:23.00,0:15:24.29,Default,,0,0,0,,Ғимарат...пайдалану...
Dialogue: 0,0:15:24.79,0:15:25.55,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:15:25.92,0:15:27.38,Default,,0,0,0,,Сіз бұйрықты қабылдай аласыз ба?
Dialogue: 0,0:15:27.51,0:15:28.26,Default,,0,0,0,,Күте тұрыңыз!!
Dialogue: 0,0:15:28.63,0:15:30.80,Default,,0,0,0,,Қазір не болғанын есіне түсірмеген саған бұл мүмкін емес!!
Dialogue: 0,0:15:31.22,0:15:31.97,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:15:32.14,0:15:33.59,Default,,0,0,0,,Маған бұйрық беріңізші.
Dialogue: 0,0:15:34.22,0:15:35.14,Default,,0,0,0,,Амия!!
Dialogue: 0,0:15:35.26,0:15:36.06,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:15:36.26,0:15:38.47,Default,,0,0,0,,Екеуіңді тоқтата алған адам болды
Dialogue: 0,0:15:38.56,0:15:39.81,Default,,0,0,0,,Мұның бәрі дәрігердің арқасында.
Dialogue: 0,0:15:40.06,0:15:40.85,Default,,0,0,0,,Не...?
Dialogue: 0,0:15:41.02,0:15:43.90,Default,,0,0,0,,Айналадағы жағдайды бақылап, талдай білу
Dialogue: 0,0:15:43.98,0:15:45.82,Default,,0,0,0,,Бұрынғыдан ештеңе өзгерген жоқ
Dialogue: 0,0:15:46.48,0:15:47.78,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:15:48.32,0:15:49.74,Default,,0,0,0,,Мен дәрігерге сенімдімін
Dialogue: 0,0:15:50.11,0:15:51.78,Default,,0,0,0,,Бұл бізге жеңіс әкеледі...
Dialogue: 0,0:15:52.78,0:15:53.87,Default,,0,0,0,,Күресейік
Dialogue: 0,0:15:55.45,0:15:56.33,Default,,0,0,0,,...
Dialogue: 0,0:15:57.20,0:15:58.83,Default,,0,0,0,,Мен саған енді сенемін
Dialogue: 0,0:15:59.33,0:16:01.58,Default,,0,0,0,,Өкіл соншалықты көп айтса
Dialogue: 0,0:16:01.71,0:16:02.83,Default,,0,0,0,,Менің атқа мінуден басқа амалым жоқ, солай ма?
Dialogue: 0,0:16:03.25,0:16:04.42,Default,,0,0,0,,Барлығы
Dialogue: 0,0:16:04.50,0:16:05.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:06.84,0:16:08.30,Default,,0,0,0,,Егер қақтығысты болдырмау мүмкін болса
Dialogue: 0,0:16:08.38,0:16:09.71,Default,,0,0,0,,Үндемеңіз
Dialogue: 0,0:16:10.47,0:16:11.92,Default,,0,0,0,,Егер шайқас қажет болса
Dialogue: 0,0:16:12.01,0:16:13.76,Default,,0,0,0,,Соңына дейін күрес
Dialogue: 0,0:16:14.68,0:16:15.97,Default,,0,0,0,,Бұл біз
Dialogue: 0,0:16:17.51,0:16:18.93,Default,,0,0,0,,Бұл Родосқа апаратын жол!!
Dialogue: 0,0:16:21.93,0:16:22.85,Default,,0,0,0,,Таптым!!
Dialogue: 0,0:16:23.14,0:16:23.90,Default,,0,0,0,,Ана...
Dialogue: 0,0:16:24.10,0:16:24.73,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:16:24.90,0:16:26.61,Default,,0,0,0,,Өмірмен байланыс
Dialogue: 0,0:16:26.86,0:16:27.82,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:16:28.15,0:16:29.78,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:16:30.61,0:16:31.86,Default,,0,0,0,,Миссияның басталуы
Dialogue: 0,0:16:32.32,0:16:33.65,Default,,0,0,0,,Тіпті осы бала...!
Dialogue: 0,0:16:34.11,0:16:34.82,Default,,0,0,0,,А?
Dialogue: 0,0:16:34.99,0:16:37.07,Default,,0,0,0,,Ыңғайлы ештеңе айтпа!!
Dialogue: 0,0:16:37.24,0:16:38.49,Default,,0,0,0,,Баладан бастаңыз!!
Dialogue: 0,0:16:38.58,0:16:39.20,Default,,0,0,0,,Эй
Dialogue: 0,0:16:39.29,0:16:40.41,Default,,0,0,0,,Сіз жеткілікті өлтірдіңіз.
Dialogue: 0,0:16:41.95,0:16:42.83,Default,,0,0,0,,...
Dialogue: 0,0:16:47.08,0:16:48.42,Default,,0,0,0,,Не болды!? Сенімен бәрі жақсы ма!?
Dialogue: 0,0:16:49.00,0:16:49.80,Default,,0,0,0,,1 кезең
Dialogue: 0,0:16:53.09,0:16:53.63,Default,,0,0,0,,Жау!!
Dialogue: 0,0:16:54.22,0:16:54.88,Default,,0,0,0,,Оқ жаудыр!
Dialogue: 0,0:16:55.84,0:16:56.97,Default,,0,0,0,,2-кезең
Dialogue: 0,0:16:57.93,0:16:58.85,Default,,0,0,0,,Оны сүйреп апарыңыз!!
Dialogue: 0,0:17:04.94,0:17:05.56,Default,,0,0,0,,Не...
Dialogue: 0,0:17:06.52,0:17:07.15,Default,,0,0,0,,Баршаңыз, мұны есте сақтаңыздар.
Dialogue: 0,0:17:08.15,0:17:08.81,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:17:09.69,0:17:10.48,Default,,0,0,0,,Тоқта...
Dialogue: 0,0:17:10.78,0:17:11.57,Default,,0,0,0,,Шулы!!
Dialogue: 0,0:17:12.32,0:17:13.15,Default,,0,0,0,,Атпа!!
Dialogue: 0,0:17:13.24,0:17:14.78,Default,,0,0,0,,Бұл жігіттерге де тиеді!!
Dialogue: 0,0:17:15.40,0:17:16.70,Default,,0,0,0,,Қара өнер...
Dialogue: 0,0:17:17.07,0:17:18.78,Default,,0,0,0,,Ол қарапайым сиқыршыға ұқсамайды...
Dialogue: 0,0:17:18.95,0:17:20.79,Default,,0,0,0,,Tsk! Ол жай ғана бала!!
Dialogue: 0,0:17:21.41,0:17:22.50,Default,,0,0,0,,Олардың барлығын ұстаңыз
Dialogue: 0,0:17:22.58,0:17:23.62,Default,,0,0,0,,Мені осында әкеліңіз!!!
Dialogue: 0,0:17:24.00,0:17:25.08,Default,,0,0,0,,3-кезең
Dialogue: 0,0:17:34.97,0:17:35.63,Default,,0,0,0,,Боқ...
Dialogue: 0,0:17:36.47,0:17:37.09,Default,,0,0,0,,О! Бұл жігіттер
Dialogue: 0,0:17:37.84,0:17:38.97,Default,,0,0,0,,Не...
Dialogue: 0,0:17:39.01,0:17:40.10,Default,,0,0,0,,Не деген...!
Dialogue: 0,0:17:41.26,0:17:43.98,Default,,0,0,0,,Сендер де біз сияқты емессіңдер ме!!
Dialogue: 0,0:17:44.77,0:17:45.89,Default,,0,0,0,,4-кезең
Dialogue: 0,0:17:54.53,0:17:55.53,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:17:56.57,0:17:58.03,Default,,0,0,0,,Мақсат қорғалды
Dialogue: 0,0:17:59.49,0:18:00.95,Default,,0,0,0,,Тапсырма орындалды
Dialogue: 0,0:18:08.29,0:18:08.92,Default,,0,0,0,,Ана...
Dialogue: 0,0:18:09.17,0:18:09.79,Default,,0,0,0,,Ана...
Dialogue: 0,0:18:10.42,0:18:11.46,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:18:11.67,0:18:12.80,Default,,0,0,0,,Не болды!?
Dialogue: 0,0:18:13.59,0:18:15.92,Default,,0,0,0,,Менің басым түсіп, демалып жатырмын.
Dialogue: 0,0:18:16.34,0:18:17.22,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:18:18.38,0:18:19.43,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:18:21.26,0:18:22.81,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:18:23.39,0:18:24.39,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:25.27,0:18:27.98,Default,,0,0,0,,Анаң тез сауығып кетеді.
Dialogue: 0,0:18:28.44,0:18:29.27,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:18:29.60,0:18:30.23,Default,,0,0,0,,Взвод командирі, тіпті біз Әйел Титанын қолға түсірсек те,
Dialogue: 0,0:18:30.90,0:18:31.61,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:18:32.02,0:18:33.32,Default,,0,0,0,,Бұл тамаша бұйрық болды.
Dialogue: 0,0:18:33.94,0:18:35.44,Default,,0,0,0,,Бұрынғы сыйламаушылық үшін кешірім сұраңыз
Dialogue: 0,0:18:35.99,0:18:37.53,Default,,0,0,0,,Сіз бірінші дәрежелі командирсіз.
Dialogue: 0,0:18:38.11,0:18:39.78,Default,,0,0,0,,Жады болмаса да
Dialogue: 0,0:18:39.86,0:18:42.58,Default,,0,0,0,,Бұл тәжірибе сіздің денеңізде қалады дегенді білдіре ме?
Dialogue: 0,0:18:43.20,0:18:44.41,Default,,0,0,0,,Тіпті өзім де
Dialogue: 0,0:18:44.62,0:18:46.16,Default,,0,0,0,,Макинохара, сенің үлкен әпкең жоқ қой?
Dialogue: 0,0:18:46.25,0:18:47.00,Default,,0,0,0,,Тоқта!!!
Dialogue: 0,0:18:48.37,0:18:49.12,Default,,0,0,0,,Осы балаға
Dialogue: 0,0:18:49.92,0:18:51.00,Default,,0,0,0,,Оған тиме...!!
Dialogue: 0,0:18:51.50,0:18:52.13,Default,,0,0,0,,Анашым...?
Dialogue: 0,0:18:52.46,0:18:53.59,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:18:53.84,0:18:56.71,Default,,0,0,0,,Екеуіңізді қауіпсіз жерге жеткіземіз...
Dialogue: 0,0:18:57.92,0:18:59.76,Default,,0,0,0,,Сіз де жұқтырғансыз ба?
Dialogue: 0,0:19:01.26,0:19:03.47,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:19:04.10,0:19:04.68,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:19:04.85,0:19:06.56,Default,,0,0,0,,Енді біз үшін алаңдамаңыз
Dialogue: 0,0:19:06.85,0:19:07.48,Default,,0,0,0,,Маа
Dialogue: 0,0:19:07.81,0:19:09.06,Default,,0,0,0,,Күте тұрыңыз!!
Dialogue: 0,0:19:16.32,0:19:17.11,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:19:18.07,0:19:20.03,Default,,0,0,0,,Қауіпсіз орынды табыңыз...
Dialogue: 0,0:19:20.74,0:19:21.95,Default,,0,0,0,,Жасырыңыз...
Dialogue: 0,0:19:23.24,0:19:26.45,Default,,0,0,0,,Емдеуді қажет ететіндерді емдеу аяқталды.
Dialogue: 0,0:19:26.62,0:19:27.24,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:27.50,0:19:29.58,Default,,0,0,0,,Мына балалар оянбай тұрып кетейік.
Dialogue: 0,0:19:34.21,0:19:35.09,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:19:35.29,0:19:36.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:37.34,0:19:38.59,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:19:38.80,0:19:41.18,Default,,0,0,0,,Ешкім өз өмірін жоғалтқан жоқ.
Dialogue: 0,0:19:48.60,0:19:50.31,Default,,0,0,0,,Мысалдар тобын тапты
Dialogue: 0,0:19:50.43,0:19:51.48,Default,,0,0,0,,Хабарлау.
Dialogue: 0,0:19:55.36,0:19:56.40,Default,,0,0,0,,! ･･
Dialogue: 0,0:19:57.11,0:19:57.86,Default,,0,0,0,,Мен сені қуамын
Dialogue: 0,0:20:01.82,0:20:03.61,Default,,0,0,0,,Алдағы саябақ арқылы өтсеңіз
Dialogue: 0,0:20:03.91,0:20:06.58,Default,,0,0,0,,Бұл Ниалл тобымен және скауттар отрядымен кездесу нүктесі.
Dialogue: 0,0:20:07.20,0:20:09.50,Default,,0,0,0,,Біз алға барып, жағдайды тексереміз.
Dialogue: 0,0:20:09.70,0:20:11.04,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,0:20:16.34,0:20:17.21,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:20:18.46,0:20:21.09,Default,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,0:20:21.92,0:20:23.51,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:20:24.76,0:20:28.72,Default,,0,0,0,,...
Dialogue: 0,0:20:29.31,0:20:31.73,Default,,0,0,0,,Мен мұны дәрігерге түсіндіруім керек.
Dialogue: 0,0:20:33.10,0:20:34.69,Default,,0,0,0,,Реюньон сияқты
Dialogue: 0,0:20:35.48,0:20:37.61,Default,,0,0,0,,Бізге де ауру әсер етеді.
Dialogue: 0,0:20:38.65,0:20:40.69,Default,,0,0,0,,Жұқпалы және өлімге әкелетін аурулар
Dialogue: 0,0:20:40.94,0:20:41.74,Default,,0,0,0,,Орипатия
Dialogue: 0,0:20:42.70,0:20:44.53,Default,,0,0,0,,Біртіндеп дене кристалданады
Dialogue: 0,0:20:44.70,0:20:46.20,Default,,0,0,0,,Соңында ол жарылып кетеді
Dialogue: 0,0:20:46.37,0:20:49.12,Default,,0,0,0,,Айналаңызға жұқпалы шаңды тарату
Dialogue: 0,0:20:49.74,0:20:51.50,Default,,0,0,0,,Белгіленген ем жоқ
Dialogue: 0,0:20:52.41,0:20:53.96,Default,,0,0,0,,Мен және Доберман мырза
Dialogue: 0,0:20:54.25,0:20:57.17,Default,,0,0,0,,Родостағы адамдардың көпшілігі жұқтырған.
Dialogue: 0,0:20:58.29,0:21:01.30,Default,,0,0,0,,Орипатияда байланыс инфекциясы туралы хабарламалар жоқ.
Dialogue: 0,0:21:01.55,0:21:03.22,Default,,0,0,0,,Көптеген жұқтырмаған адамдар
Dialogue: 0,0:21:03.30,0:21:05.72,Default,,0,0,0,,Бізге жақындаудан аулақ болыңыз
Dialogue: 0,0:21:06.59,0:21:11.02,Default,,0,0,0,,Инфекция жұқтырған адамдарға қатысты кемсітушілік және предюдиум барлық елдерде бар.
Dialogue: 0,0:21:11.10,0:21:13.81,Default,,0,0,0,,Мұнда Урсустың бас тарту реакциясы ерекше күшті.
Dialogue: 0,0:21:14.69,0:21:18.98,Default,,0,0,0,,Урсус үкіметі орипатиядан қорқу үшін біржақты хабарлауды пайдаланады.
Dialogue: 0,0:21:19.23,0:21:20.40,Default,,0,0,0,,Көптеген азаматтар
Dialogue: 0,0:21:20.57,0:21:23.44,Default,,0,0,0,,Жұқтырған адамдарды жою керек деп ойлау
Dialogue: 0,0:21:24.40,0:21:29.99,Default,,0,0,0,,Реюньон оларды қудалағандардан кек алу үшін қару-жарақпен көтерілді
Dialogue: 0,0:21:30.41,0:21:32.24,Default,,0,0,0,,Біреу үзіп тастамаса
Dialogue: 0,0:21:32.33,0:21:33.95,Default,,0,0,0,,Жек көру тізбегі жалғасады
Dialogue: 0,0:21:34.79,0:21:36.17,Default,,0,0,0,,Біз, Родос,
Dialogue: 0,0:21:36.50,0:21:39.13,Default,,0,0,0,,Инфекция жұқтырмаған адамға қарамастан
Dialogue: 0,0:21:39.42,0:21:41.84,Default,,0,0,0,,Ауру мен азаптан қорқатындарды құтқар.
Dialogue: 0,0:21:42.21,0:21:43.30,Default,,0,0,0,,Орипатияның себептері
Dialogue: 0,0:21:43.38,0:21:46.30,Default,,0,0,0,,Барлық мәселелерді шешетін ұйым
Dialogue: 0,0:21:47.09,0:21:49.14,Default,,0,0,0,,Жанжалда қаза тапқан өмірлер
Dialogue: 0,0:21:49.22,0:21:51.26,Default,,0,0,0,,Мен мүмкіндігінше көп нәрсені қорғағым келеді...
Dialogue: 0,0:21:51.51,0:21:52.18,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:52.26,0:21:53.97,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:21:54.43,0:21:56.56,Default,,0,0,0,,Орипатияға ем тапты
Dialogue: 0,0:21:56.64,0:21:58.98,Default,,0,0,0,,Дау-дамайдың тамырын кесу керек
Dialogue: 0,0:22:00.06,0:22:01.19,Default,,0,0,0,,Бұл үміт
Dialogue: 0,0:22:01.61,0:22:02.27,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:22:02.65,0:22:03.53,Default,,0,0,0,,Оларға тез хабарлауың керек…
Dialogue: 0,0:22:04.69,0:22:06.86,Default,,0,0,0,,Дәрігер есте сақтау қабілетін жоғалтқанға дейін
Dialogue: 0,0:22:06.95,0:22:11.49,Default,,0,0,0,,Орипатияны зерттеудегі жетекші сарапшы ретінде ол емдеу әдістерін құрумен де айналысты.
Dialogue: 0,0:22:12.45,0:22:16.54,Default,,0,0,0,,Дәрігердің зерттеуі орипатияны толық емдеуге мүмкіндік берсе
Dialogue: 0,0:22:16.66,0:22:19.50,Default,,0,0,0,,Біз адамдарды қорқыныштан құтқара білуіміз керек.
Dialogue: 0,0:22:19.92,0:22:22.29,Default,,0,0,0,,Сіз әлі ештеңе білмеуіңіз мүмкін.
Dialogue: 0,0:22:22.63,0:22:23.63,Default,,0,0,0,,Бірақ ақыр соңында
Dialogue: 0,0:22:23.96,0:22:26.84,Default,,0,0,0,,Сіз не істеу керектігін түсінесіз
Dialogue: 0,0:22:27.30,0:22:28.22,Default,,0,0,0,,Бұл Эйс
Dialogue: 0,0:22:28.47,0:22:29.72,Default,,0,0,0,,Айналадағы ауытқулар жоқ
Dialogue: 0,0:22:29.84,0:22:30.80,Default,,0,0,0,,Туннель арқылы өтіңіз.
Dialogue: 0,0:22:30.89,0:22:31.51,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:22:32.35,0:22:33.26,Default,,0,0,0,,Алға жылжайық
Dialogue: 0,0:22:35.85,0:22:36.85,Default,,0,0,0,,Амияға не болды?
Dialogue: 0,0:22:37.39,0:22:39.40,Default,,0,0,0,,Табиғат апаты бұл қаланы шарпығанша
Dialogue: 0,0:22:39.60,0:22:40.98,Default,,0,0,0,,Қанша уақыт?
Dialogue: 0,0:22:41.61,0:22:42.90,Default,,0,0,0,,...шамамен 3 сағат
Dialogue: 0,0:22:43.19,0:22:44.02,Default,,0,0,0,,Ой.
Dialogue: 0,0:22:45.15,0:22:46.53,Default,,0,0,0,,Сіздің жараңыз қалай?
Dialogue: 0,0:22:46.99,0:22:49.32,Default,,0,0,0,,Иә, ол қазірдің өзінде жазыла бастады.
Dialogue: 0,0:22:49.61,0:22:51.16,Default,,0,0,0,,А... Өзіңізді қатты итермеңіз.
Dialogue: 0,0:22:51.24,0:22:52.16,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:22:54.87,0:22:56.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:57.08,0:22:58.37,Default,,0,0,0,,Дәрігерсіз
Dialogue: 0,0:22:58.79,0:23:01.67,Default,,0,0,0,,Мен сол ата-ана мен баланы құтқарудан бас тарттым.
Dialogue: 0,0:23:03.59,0:23:05.34,Default,,0,0,0,,Сіз бұрынғыдайсыз
Dialogue: 0,0:23:05.67,0:23:07.59,Default,,0,0,0,,Біз Родостың мүшелеріміз.
Dialogue: 0,0:23:07.97,0:23:09.05,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:23:09.30,0:23:10.72,Default,,0,0,0,,Ең маңызды...
Dialogue: 0,0:23:14.35,0:23:15.76,Default,,0,0,0,,...Мен маңызды доспын.
Dialogue: 0,0:23:17.52,0:23:18.98,Default,,0,0,0,,Кеттік
Dialogue: 0,0:23:20.48,0:23:26.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory