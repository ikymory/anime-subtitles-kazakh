Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.42,0:00:05.83,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:00:18.47,0:00:21.23,Default,,0,0,0,,Аздап шулы болатын сияқты.
Dialogue: 0,0:00:25.15,0:00:25.77,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:00:26.19,0:00:26.98,Default,,0,0,0,,Бұл Амия
Dialogue: 0,0:00:27.40,0:00:28.65,Default,,0,0,0,,Мен Мишаны қорғадым.
Dialogue: 0,0:00:29.32,0:00:29.94,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:00:30.73,0:00:32.40,Default,,0,0,0,,Мен қазір кездесу орны туралы хабарлаймын.
Dialogue: 0,0:00:32.74,0:00:34.11,Default,,0,0,0,,Мені дереу жеткізіңіз.
Dialogue: 0,0:00:34.66,0:00:35.53,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:00:35.61,0:00:38.33,Default,,0,0,0,,Кездесу орнындағы қауіпсіздікке Күзет бюросы кепілдік береді.
Dialogue: 0,0:00:38.66,0:00:39.28,Default,,0,0,0,,Осымен
Dialogue: 0,0:00:39.99,0:00:40.62,Default,,0,0,0,,Умм
Dialogue: 0,0:00:42.62,0:00:43.41,Default,,0,0,0,,Сол адам
Dialogue: 0,0:00:43.50,0:00:46.67,Default,,0,0,0,,Олар бізді тек шығынды адамдар деп санайды.
Dialogue: 0,0:00:47.00,0:00:49.59,Default,,0,0,0,,Ынтымақтастық қатынас тек атауда болады.
Dialogue: 0,0:00:49.88,0:00:50.50,Default,,0,0,0,,Қазір
Dialogue: 0,0:00:50.71,0:00:52.34,Default,,0,0,0,,Кездесуге асығайық
Dialogue: 0,0:00:53.01,0:00:55.84,Default,,0,0,0,,Корольдік гвардиялық бюро қауіпсіздікті қамтамасыз ететін сияқты.
Dialogue: 0,0:02:35.82,0:02:36.74,Default,,0,0,0,,Миша мырза?
Dialogue: 0,0:02:39.07,0:02:40.07,Default,,0,0,0,,Басынан бастап
Dialogue: 0,0:02:40.36,0:02:42.62,Default,,0,0,0,,Сіз мені күзет бюросына тапсыруды жоспарладыңыз ба?
Dialogue: 0,0:02:44.03,0:02:44.66,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:44.74,0:02:46.29,Default,,0,0,0,,Рюмон күзет бюросынан
Dialogue: 0,0:02:46.37,0:02:49.37,Default,,0,0,0,,Маған тек сені қорғауды сұрады.
Dialogue: 0,0:02:49.87,0:02:50.58,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:02:55.71,0:02:56.71,Default,,0,0,0,,Ақымақ сияқты
Dialogue: 0,0:02:58.26,0:02:59.80,Default,,0,0,0,,Сіз туралы аз
Dialogue: 0,0:03:00.30,0:03:01.34,Default,,0,0,0,,Мен сендім
Dialogue: 0,0:03:02.09,0:03:04.60,Default,,0,0,0,,Мен сізге шынымен көмектескім келеді!
Dialogue: 0,0:03:04.68,0:03:08.93,Default,,0,0,0,,Миша мен басқа жұқтырған адамдарды Родоста қорғауға болады.
Dialogue: 0,0:03:09.23,0:03:11.14,Default,,0,0,0,,Мен Коное бюросымен келіссөздер жүргізу ниетім бар.
Dialogue: 0,0:03:11.23,0:03:13.23,Default,,0,0,0,,Бұны тыңдау мүмкін емес.
Dialogue: 0,0:03:15.32,0:03:16.98,Default,,0,0,0,,Мені алуға келсең
Dialogue: 0,0:03:19.03,0:03:20.03,Default,,0,0,0,,Алдауға болмайды
Dialogue: 0,0:03:20.49,0:03:22.36,Default,,0,0,0,,Әу бастан-ақ айтқан болар едім.
Dialogue: 0,0:03:22.82,0:03:24.03,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:03:24.20,0:03:26.08,Default,,0,0,0,,Мен оны ұстаймын деп ойлаған жоқпын.
Dialogue: 0,0:03:26.91,0:03:27.54,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:28.83,0:03:29.62,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:30.37,0:03:31.54,Default,,0,0,0,,Миша үшін
Dialogue: 0,0:03:31.62,0:03:33.17,Default,,0,0,0,,Ештеңе өзгермейді, солай ма?
Dialogue: 0,0:03:35.00,0:03:35.63,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:35.71,0:03:37.50,Default,,0,0,0,,Жалғыз қашасың ба?
Dialogue: 0,0:03:37.59,0:03:38.63,Default,,0,0,0,,Шек емес
Dialogue: 0,0:03:39.09,0:03:40.17,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:03:40.38,0:03:42.72,Default,,0,0,0,,Корольдік гвардиялық бюродан уақытша қорғаныс ала алады
Dialogue: 0,0:03:42.80,0:03:43.97,Default,,0,0,0,,Менің ойымша, бұл ең жақсы
Dialogue: 0,0:03:46.14,0:03:47.10,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:03:47.18,0:03:48.01,Default,,0,0,0,,Амия туралы
Dialogue: 0,0:03:50.77,0:03:52.48,Default,,0,0,0,,Харлоу!
Dialogue: 0,0:03:54.69,0:03:55.94,Default,,0,0,0,,Барлығы
Dialogue: 0,0:03:56.02,0:03:58.36,Default,,0,0,0,,Мен сені сағындым
Dialogue: 0,0:04:00.03,0:04:01.32,Default,,0,0,0,,Exia-san
Dialogue: 0,0:04:01.40,0:04:02.07,Default,,0,0,0,,Yahoo
Dialogue: 0,0:04:02.15,0:04:03.11,Default,,0,0,0,,Амия
Dialogue: 0,0:04:03.20,0:04:04.91,Default,,0,0,0,,Сіз таң қалдыңыз ба? Сіз таң қалдыңыз ба?
Dialogue: 0,0:04:04.99,0:04:05.62,Default,,0,0,0,,Иә
Dialogue: 0,0:04:05.70,0:04:06.53,Default,,0,0,0,,Өте!
Dialogue: 0,0:04:06.62,0:04:07.33,Default,,0,0,0,,Ия
Dialogue: 0,0:04:08.45,0:04:10.70,Default,,0,0,0,,Неліктен сіз кенеттен пайда боласыз?
Dialogue: 0,0:04:11.25,0:04:13.08,Default,,0,0,0,,Penguin Express тегін ме?
Dialogue: 0,0:04:13.17,0:04:13.92,Default,,0,0,0,,Біраз
Dialogue: 0,0:04:14.12,0:04:14.92,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:04:15.46,0:04:17.50,Default,,0,0,0,,Сіз бұдан былай өте бос боламын деп ойлайсыз ба?
Dialogue: 0,0:04:17.92,0:04:20.05,Default,,0,0,0,,Адамдарды мазалайтын қандай да бір түрі
Dialogue: 0,0:04:20.30,0:04:22.38,Default,,0,0,0,,Олар бізге әр жерден келе жатыр.
Dialogue: 0,0:04:23.72,0:04:25.30,Default,,0,0,0,,Қашықтықтан өтетін жол
Dialogue: 0,0:04:25.39,0:04:28.26,Default,,0,0,0,,Шынымды айтсам, жаулар да көп.
Dialogue: 0,0:04:28.89,0:04:29.51,Default,,0,0,0,,Жау...?
Dialogue: 0,0:04:30.31,0:04:31.02,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:04:31.31,0:04:33.27,Default,,0,0,0,,Ол шалғайда жасырынып жүр дейді.
Dialogue: 0,0:04:33.35,0:04:35.40,Default,,0,0,0,,Қайта кездесу және жұқтырған адам
Dialogue: 0,0:04:36.40,0:04:38.77,Default,,0,0,0,,Ежелден қуғын-сүргінге ұшыраған шалғайдағы адамдар
Dialogue: 0,0:04:39.23,0:04:41.53,Default,,0,0,0,,Қайта қосылу идеясына берік болсаңыз да.
Dialogue: 0,0:04:41.61,0:04:42.99,Default,,0,0,0,,Таңқаларлық емес
Dialogue: 0,0:04:43.82,0:04:44.49,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:04:44.82,0:04:45.82,Default,,0,0,0,,Осы жерден өту
Dialogue: 0,0:04:46.11,0:04:47.99,Default,,0,0,0,,Мишаны аман-есен шығаруымыз керек.
Dialogue: 0,0:04:53.58,0:04:54.25,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:04:55.67,0:04:56.71,Default,,0,0,0,,Бұл өнер!
Dialogue: 0,0:04:59.25,0:05:00.84,Default,,0,0,0,,Тіпті сиқыршылар да қарсы алады.
Dialogue: 0,0:05:03.42,0:05:05.30,Default,,0,0,0,,Дәрігер мен Миша, өтінемін.
Dialogue: 0,0:05:05.59,0:05:06.55,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:07.72,0:05:08.97,Default,,0,0,0,,Сіз бортқа шықтыңыз.
Dialogue: 0,0:05:13.14,0:05:13.85,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:05:14.14,0:05:15.19,Default,,0,0,0,,Кездесу
Dialogue: 0,0:05:15.56,0:05:16.27,Default,,0,0,0,,Джама!
Dialogue: 0,0:05:18.90,0:05:19.56,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:05:20.48,0:05:21.11,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:05:23.69,0:05:25.40,Default,,0,0,0,,Реюньонда Миша да бар.
Dialogue: 0,0:05:31.74,0:05:32.41,Default,,0,0,0,,Миша
Dialogue: 0,0:05:34.50,0:05:35.33,Default,,0,0,0,,Мен саған рұқсат бермеймін
Dialogue: 0,0:05:48.22,0:05:48.84,Default,,0,0,0,,Иә
Dialogue: 0,0:05:48.97,0:05:50.39,Default,,0,0,0,,Аяқталды
Dialogue: 0,0:05:51.10,0:05:52.01,Default,,0,0,0,,Хия~
Dialogue: 0,0:05:52.43,0:05:53.64,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:05:53.85,0:05:54.81,Default,,0,0,0,,Отсуоцу!
Dialogue: 0,0:05:56.31,0:05:58.56,Default,,0,0,0,,Сіз де күресуіңіз керек
Dialogue: 0,0:06:06.19,0:06:06.82,Default,,0,0,0,,Жарақат
Dialogue: 0,0:06:07.03,0:06:07.82,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:06:10.24,0:06:11.24,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:06:11.32,0:06:12.12,Default,,0,0,0,,Миша мырза
Dialogue: 0,0:06:16.58,0:06:17.21,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:06:18.08,0:06:19.42,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:06:19.67,0:06:21.75,Default,,0,0,0,,Мен сені күткендей емеспін.
Dialogue: 0,0:06:22.42,0:06:23.25,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:06:23.42,0:06:25.55,Default,,0,0,0,,Жау тағы келе жатыр.
Dialogue: 0,0:06:26.09,0:06:27.47,Default,,0,0,0,,Тым жылдам қозғалу
Dialogue: 0,0:06:27.97,0:06:28.97,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:06:29.05,0:06:29.97,Default,,0,0,0,,Қоян?
Dialogue: 0,0:06:32.85,0:06:34.85,Default,,0,0,0,,Мен мүмкіндігінше ұрысудан аулақ болғым келеді.
Dialogue: 0,0:06:35.81,0:06:36.43,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:36.77,0:06:38.52,Default,,0,0,0,,Қауіпсіз жол қайда?
Dialogue: 0,0:06:39.10,0:06:40.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:40.27,0:06:42.23,Default,,0,0,0,,Мұндай жағдайларда маған қалдырыңыз.
Dialogue: 0,0:06:42.40,0:06:45.32,Default,,0,0,0,,Жау күтпейтін сирек жолдар бар.
Dialogue: 0,0:06:45.48,0:06:46.44,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:06:47.44,0:06:49.53,Default,,0,0,0,,Мен оның қауіпсіз екенін көремін.
Dialogue: 0,0:06:51.57,0:06:53.58,Default,,0,0,0,,Әзірге барлығы сол жерді көздеу керек.
Dialogue: 0,0:06:54.95,0:06:55.62,Default,,0,0,0,,Иә
Dialogue: 0,0:06:56.49,0:06:57.12,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:06:57.41,0:06:58.50,Default,,0,0,0,,Кейін кездескенше!
Dialogue: 0,0:06:59.58,0:07:00.50,Default,,0,0,0,,Жоқ… әлі де бір жол бар.
Dialogue: 0,0:07:02.33,0:07:03.00,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:07:03.46,0:07:04.09,Default,,0,0,0,,Барлығы
Dialogue: 0,0:07:36.20,0:07:37.20,Default,,0,0,0,,Миша
Dialogue: 0,0:07:38.50,0:07:39.16,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,0:07:42.87,0:07:43.54,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:44.63,0:07:45.46,Default,,0,0,0,,Жақында
Dialogue: 0,0:07:45.75,0:07:48.05,Default,,0,0,0,,Мен Эксиа-сан айтқан жерге келдім.
Dialogue: 0,0:07:48.67,0:07:49.42,Default,,0,0,0,,Миша
Dialogue: 0,0:07:49.71,0:07:51.13,Default,,0,0,0,,Онда жаяу жүре аласыз ба?
Dialogue: 0,0:07:51.38,0:07:52.01,Default,,0,0,0,,Иә
Dialogue: 0,0:07:53.76,0:07:54.51,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:26.46,0:08:27.17,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:08:38.81,0:08:39.76,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:08:40.60,0:08:41.81,Default,,0,0,0,,Техас мырза
Dialogue: 0,0:08:44.06,0:08:44.73,Default,,0,0,0,,Сіз тамақ ішесіз бе?
Dialogue: 0,0:08:45.06,0:08:45.73,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:45.81,0:08:46.77,Default,,0,0,0,,Өте жақсы.
Dialogue: 0,0:08:47.27,0:08:47.90,Default,,0,0,0,,Иә
Dialogue: 0,0:08:48.48,0:08:49.27,Default,,0,0,0,,Бұл...?
Dialogue: 0,0:08:49.82,0:08:50.69,Default,,0,0,0,,Алдыңғы тұтынушы.
Dialogue: 0,0:08:52.11,0:08:53.03,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:08:53.36,0:08:54.61,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:08:54.82,0:08:56.45,Default,,0,0,0,,Маған Exia телефон соқты.
Dialogue: 0,0:08:56.74,0:08:57.37,Default,,0,0,0,,О.
Dialogue: 0,0:08:57.53,0:08:59.53,Default,,0,0,0,,Кейде жақсы емес пе?
Dialogue: 0,0:09:02.70,0:09:04.46,Default,,0,0,0,,Бұл жігіт Реюньон деп атады
Dialogue: 0,0:09:04.75,0:09:06.88,Default,,0,0,0,,Келесі жасақтар одан да көп сияқты.
Dialogue: 0,0:09:07.50,0:09:09.29,Default,,0,0,0,,Осы уақытқа дейін осында болғандар
Dialogue: 0,0:09:09.92,0:09:11.71,Default,,0,0,0,,Олар топта ашық жұмыс істеп жатыр.
Dialogue: 0,0:09:12.46,0:09:13.09,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:09:13.47,0:09:15.68,Default,,0,0,0,,Реюньон кедей аудандарды пайдаланады
Dialogue: 0,0:09:15.88,0:09:18.72,Default,,0,0,0,,Сонымен, сіз Рюмонның ішінде күш құрдыңыз.
Dialogue: 0,0:09:19.18,0:09:19.93,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:09:21.14,0:09:22.22,Default,,0,0,0,,Олардың мақсаты
Dialogue: 0,0:09:22.64,0:09:23.89,Default,,0,0,0,,Миша шығар
Dialogue: 0,0:09:25.19,0:09:26.02,Default,,0,0,0,,₤4...?
Dialogue: 0,0:09:26.10,0:09:26.85,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:27.27,0:09:29.31,Default,,0,0,0,,Неге екенін біз де білмейміз
Dialogue: 0,0:09:30.73,0:09:31.36,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:09:31.61,0:09:34.90,Default,,0,0,0,,Бұл туралы тек Рюмон мен Реюньон білетін нәрсе бар шығар.
Dialogue: 0,0:09:35.20,0:09:35.82,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:36.07,0:09:39.37,Default,,0,0,0,,Кейінірек капитанның сүйкімді бетін сипап жатып,
Dialogue: 0,0:09:39.45,0:09:40.49,Default,,0,0,0,,Тыңдап көрейік
Dialogue: 0,0:09:43.70,0:09:45.41,Default,,0,0,0,,Мен Exia компаниясынан қауіпсіздік растауын алдым.
Dialogue: 0,0:09:47.37,0:09:48.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:58.55,0:09:59.89,Default,,0,0,0,,Барлығы көлеңкеде
Dialogue: 0,0:10:00.35,0:10:00.97,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:10:01.05,0:10:01.97,Default,,0,0,0,,Менің қасымда
Dialogue: 0,0:10:05.18,0:10:06.64,Default,,0,0,0,,Мен бұлай қозғала алмаймын.
Dialogue: 0,0:10:06.73,0:10:09.44,Default,,0,0,0,,Мен артта қалғанды ​​ұнатпаймын.
Dialogue: 0,0:10:19.70,0:10:20.53,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:10:21.16,0:10:22.03,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:10:31.04,0:10:31.84,Default,,0,0,0,,Табылды
Dialogue: 0,0:10:54.11,0:10:54.82,Default,,0,0,0,,Миша
Dialogue: 0,0:11:05.95,0:11:07.12,Default,,0,0,0,,Ағымдағы дауыс
Dialogue: 0,0:11:27.18,0:11:27.89,Default,,0,0,0,,Шегін!
Dialogue: 0,0:11:28.27,0:11:28.93,Default,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:11:33.61,0:11:34.27,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:35.32,0:11:36.52,Default,,0,0,0,,Сіз маған қашып кетуге рұқсат бергіңіз келе ме?
Dialogue: 0,0:11:37.11,0:11:37.90,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:38.82,0:11:39.53,Default,,0,0,0,,Соңында
Dialogue: 0,0:11:40.28,0:11:41.32,Default,,0,0,0,,Бұл күн де келді
Dialogue: 0,0:11:51.33,0:11:52.00,Default,,0,0,0,,Эй
Dialogue: 0,0:11:52.17,0:11:54.25,Default,,0,0,0,,Жоғарыда қашу жолы бар ма?
Dialogue: 0,0:11:54.63,0:11:56.79,Default,,0,0,0,,Жау мені қуса ақыры емес пе?
Dialogue: 0,0:11:57.05,0:11:59.01,Default,,0,0,0,,Межелі жерге жету үшін
Dialogue: 0,0:11:59.46,0:12:01.22,Default,,0,0,0,,Қалаған жолмен жүріңіз
Dialogue: 0,0:12:02.05,0:12:04.26,Default,,0,0,0,,Бұл Penguin Express қағидаларының бірі.
Dialogue: 0,0:12:05.43,0:12:06.72,Default,,0,0,0,,Кез келген жолмен
Dialogue: 0,0:12:17.86,0:12:18.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:19.36,0:12:20.57,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:12:20.90,0:12:22.11,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:22.74,0:12:23.66,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:12:23.91,0:12:25.53,Default,,0,0,0,,Мен осы жерден ұшамын!
Dialogue: 0,0:12:25.82,0:12:26.49,Default,,0,0,0,,Ұшу?
Dialogue: 0,0:12:27.74,0:12:28.37,Default,,0,0,0,,Бұл
Dialogue: 0,0:12:28.79,0:12:30.66,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:12:31.08,0:12:32.37,Default,,0,0,0,,Мына жерде...?
Dialogue: 0,0:12:35.25,0:12:36.17,Default,,0,0,0,,Ия
Dialogue: 0,0:12:36.38,0:12:37.42,Default,,0,0,0,,Бинго!
Dialogue: 0,0:12:39.21,0:12:40.21,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:12:40.30,0:12:42.34,Default,,0,0,0,,Оны ешкім елестете алмайды.
Dialogue: 0,0:12:42.42,0:12:44.55,Default,,0,0,0,,Мен мінсізмін
Dialogue: 0,0:12:45.47,0:12:46.18,Default,,0,0,0,,Іздеу
Dialogue: 0,0:12:46.34,0:12:47.22,Default,,0,0,0,,Біраз
Dialogue: 0,0:12:47.30,0:12:49.26,Default,,0,0,0,,мінсіз деген не?
Dialogue: 0,0:12:49.51,0:12:50.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:50.89,0:12:52.56,Default,,0,0,0,,Бұл күтпеген жағдай.
Dialogue: 0,0:12:52.98,0:12:54.02,Default,,0,0,0,,Техас
Dialogue: 0,0:12:54.10,0:12:56.81,Default,,0,0,0,,Неге олардың бәрін жеңбедің?
Dialogue: 0,0:12:56.98,0:12:58.36,Default,,0,0,0,,Менен онша көп сұраған жоқ.
Dialogue: 0,0:12:58.65,0:12:59.73,Default,,0,0,0,,Аяқ киім
Dialogue: 0,0:13:00.19,0:13:00.82,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:01.11,0:13:01.73,Default,,0,0,0,,Нджама
Dialogue: 0,0:13:01.86,0:13:03.19,Default,,0,0,0,,Өйткені менің баруым керек емес.
Dialogue: 0,0:13:08.28,0:13:08.99,Default,,0,0,0,,Ал, қалай ойлайсың, Армин?
Dialogue: 0,0:13:09.33,0:13:10.83,Default,,0,0,0,,Барлығыңызды тездетіңіз
Dialogue: 0,0:13:13.29,0:13:14.46,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:13:16.92,0:13:18.25,Default,,0,0,0,,Мен жауды тоқтатамын
Dialogue: 0,0:13:18.75,0:13:19.79,Default,,0,0,0,,Алға!
Dialogue: 0,0:13:19.96,0:13:21.59,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:13:21.67,0:13:22.30,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:26.18,0:13:27.30,Default,,0,0,0,,Сіз де дәрігерге барыңыз!
Dialogue: 0,0:13:30.05,0:13:30.76,Default,,0,0,0,,Миша!
Dialogue: 0,0:13:31.56,0:13:32.18,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:13:32.27,0:13:33.68,Default,,0,0,0,,Мықтап ұстаңыз!
Dialogue: 0,0:13:42.57,0:13:43.65,Default,,0,0,0,,Мен сені жібермеймін!
Dialogue: 0,0:14:04.38,0:14:05.30,Default,,0,0,0,,Аня Форджер
Dialogue: 0,0:14:10.72,0:14:11.72,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:14:11.97,0:14:15.31,Default,,0,0,0,,Бұл бағыт бізге ғана арналған, солай емес пе?
Dialogue: 0,0:14:17.85,0:14:18.60,Default,,0,0,0,,Миша
Dialogue: 0,0:14:30.11,0:14:32.16,Default,,0,0,0,,Капитан Ченмен кездесу орнына
Dialogue: 0,0:14:32.49,0:14:33.62,Default,,0,0,0,,Бұл дерлік қалды.
Dialogue: 0,0:14:34.62,0:14:37.37,Default,,0,0,0,,Бұл ұзақ жол болды.
Dialogue: 0,0:14:42.21,0:14:43.17,Default,,0,0,0,,Миша мырза
Dialogue: 0,0:14:44.21,0:14:44.84,Default,,0,0,0,,Дұрыс емес пе, Ято-но-ками?
Dialogue: 0,0:14:45.05,0:14:45.84,Default,,0,0,0,,Масаода
Dialogue: 0,0:14:49.34,0:14:51.09,Default,,0,0,0,,Кішкене ойлы
Dialogue: 0,0:14:51.59,0:14:53.35,Default,,0,0,0,,Тек басы айналады
Dialogue: 0,0:14:55.22,0:14:56.14,Default,,0,0,0,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:14:58.73,0:15:00.02,Default,,0,0,0,,Бір дем алайық
Dialogue: 0,0:15:00.40,0:15:01.35,Default,,0,0,0,,мен Токио вокзалына дейін шамамен бір жарым сағат Шинкансенге отырдым
Dialogue: 0,0:15:01.44,0:15:02.52,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:15:02.73,0:15:05.27,Default,,0,0,0,,Мақсатқа сәл жақынырақ болса да
Dialogue: 0,0:15:05.57,0:15:06.19,Default,,0,0,0,,Иә
Dialogue: 0,0:15:07.07,0:15:07.69,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:15:14.83,0:15:16.33,Default,,0,0,0,,Менен сұрағыңыз келетін нәрсе бар ма?
Dialogue: 0,0:15:17.45,0:15:18.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:19.33,0:15:20.29,Default,,0,0,0,,Реюньон дегеніміз не?
Dialogue: 0,0:15:21.04,0:15:21.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:22.58,0:15:23.21,Default,,0,0,0,,Олар да
Dialogue: 0,0:15:23.58,0:15:24.96,Default,,0,0,0,,Жұқтырған адамның тіндері
Dialogue: 0,0:15:26.96,0:15:28.21,Default,,0,0,0,,Жұқтырған адамдар арасындағы
Dialogue: 0,0:15:28.30,0:15:29.63,Default,,0,0,0,,Сіз ұрысып жатырсыз ба?
Dialogue: 0,0:15:30.26,0:15:31.18,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:33.55,0:15:35.39,Default,,0,0,0,,Айырмашылығы баратын жолда.
Dialogue: 0,0:15:36.26,0:15:37.31,Default,,0,0,0,,Алға жол?
Dialogue: 0,0:15:37.93,0:15:38.77,Default,,0,0,0,,Реюньон
Dialogue: 0,0:15:39.18,0:15:40.35,Default,,0,0,0,,Жұқтырғандар үшін
Dialogue: 0,0:15:40.64,0:15:43.10,Default,,0,0,0,,Біздің идеалымыз - тиесілі орынды құру.
Dialogue: 0,0:15:44.02,0:15:44.65,Default,,0,0,0,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:15:45.15,0:15:47.28,Default,,0,0,0,,Оған жұқтырмаған адамдар кірмейді
Dialogue: 0,0:15:47.65,0:15:51.53,Default,,0,0,0,,Бұл қайта қосылу идеясына қарсы шыққандарды да шеттету дегенді білдіреді.
Dialogue: 0,0:15:52.24,0:15:52.82,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:15:53.28,0:15:54.37,Default,,0,0,0,,Біз, Родос,
Dialogue: 0,0:15:54.99,0:15:56.03,Default,,0,0,0,,Жұқтырған адам
Dialogue: 0,0:15:56.12,0:15:59.37,Default,,0,0,0,,Жұқпалы емес адамдардың бірге өмір сүру жолын іздеу
Dialogue: 0,0:16:00.41,0:16:01.79,Default,,0,0,0,,Бірге тұру
Dialogue: 0,0:16:02.62,0:16:03.25,Default,,0,0,0,,Иә
Dialogue: 0,0:16:04.50,0:16:05.71,Default,,0,0,0,,Родос және Реюньон
Dialogue: 0,0:16:06.59,0:16:08.05,Default,,0,0,0,,Біздің жолдарымыз басқаша болса
Dialogue: 0,0:16:08.13,0:16:09.59,Default,,0,0,0,,Жанжалдар туындайды
Dialogue: 0,0:16:10.38,0:16:11.59,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:16:16.80,0:16:18.35,Default,,0,0,0,,Мен ештеңе білмедім
Dialogue: 0,0:16:19.52,0:16:21.02,Default,,0,0,0,,Чернобог қаласы
Dialogue: 0,0:16:21.48,0:16:22.81,Default,,0,0,0,,Кенет соғыс сияқты
Dialogue: 0,0:16:22.89,0:16:24.06,Default,,0,0,0,,Шатасып кетті
Dialogue: 0,0:16:25.23,0:16:26.48,Default,,0,0,0,,Мен неге екенін түсінбеймін
Dialogue: 0,0:16:27.32,0:16:27.94,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:16:28.02,0:16:28.77,Default,,0,0,0,,Дәл солай. Өте ықтимал.
Dialogue: 0,0:16:31.86,0:16:33.45,Default,,0,0,0,,Мен аңдып қашып кеттім
Dialogue: 0,0:16:37.28,0:16:40.29,Default,,0,0,0,,Чернобогқа шабуыл жасаған Реюньон болды.
Dialogue: 0,0:16:42.08,0:16:42.96,Default,,0,0,0,,Иә
Dialogue: 0,0:16:43.83,0:16:44.50,Default,,0,0,0,,Миша
Dialogue: 0,0:16:45.42,0:16:46.75,Default,,0,0,0,,Сіз мұнда қанша уақыт болдыңыз?
Dialogue: 0,0:16:47.67,0:16:49.71,Default,,0,0,0,,Бір аптаға жуық
Dialogue: 0,0:16:50.17,0:16:51.34,Default,,0,0,0,,Бір апта?
Dialogue: 0,0:16:55.72,0:16:57.09,Default,,0,0,0,,Рюмонға келгеннен кейін
Dialogue: 0,0:16:57.18,0:16:59.06,Default,,0,0,0,,Мен мұның өсіп келе жатқанын байқадым
Dialogue: 0,0:16:59.93,0:17:00.60,Default,,0,0,0,,Сонымен
Dialogue: 0,0:17:02.06,0:17:02.85,Default,,0,0,0,,Миша мырза
Dialogue: 0,0:17:04.02,0:17:04.69,Default,,0,0,0,,Мықты
Dialogue: 0,0:17:05.14,0:17:06.85,Default,,0,0,0,,Орипатия белгілері.
Dialogue: 0,0:17:07.02,0:17:08.15,Default,,0,0,0,,Соншалықты тез?
Dialogue: 0,0:17:08.69,0:17:09.48,Default,,0,0,0,,Орипатия бар
Dialogue: 0,0:17:09.77,0:17:12.24,Default,,0,0,0,,Жедел және созылмалы түрлері бар.
Dialogue: 0,0:17:27.42,0:17:29.29,Default,,0,0,0,,Бұл тек алғашқы көмек көрсету шарасы
Dialogue: 0,0:17:30.29,0:17:31.30,Default,,0,0,0,,Мен
Dialogue: 0,0:17:31.67,0:17:33.42,Default,,0,0,0,,Егер елеулі шаралар қабылданбаса
Dialogue: 0,0:17:35.97,0:17:36.88,Default,,0,0,0,,Амия
Dialogue: 0,0:17:37.93,0:17:38.68,Default,,0,0,0,,Миша
Dialogue: 0,0:17:39.85,0:17:40.85,Default,,0,0,0,,Ол жай ғана біреудің оны кешіруін қалады ғой, иә?
Dialogue: 0,0:17:40.93,0:17:44.60,Default,,0,0,0,,Мен Рюмоннан сізді Родоста емдеуін сұраймын.
Dialogue: 0,0:17:51.23,0:17:51.86,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:17:52.53,0:17:53.61,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:18:02.03,0:18:02.70,Default,,0,0,0,,Тар
Dialogue: 0,0:18:03.24,0:18:04.83,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:18:05.33,0:18:07.54,Default,,0,0,0,,Бұл ең қысқа жол.
Dialogue: 0,0:18:08.58,0:18:09.42,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:18:10.13,0:18:11.96,Default,,0,0,0,,Осы жерден өткеннен кейін межелі жерге жетесіз.
Dialogue: 0,0:18:12.04,0:18:13.00,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:18:13.80,0:18:15.30,Default,,0,0,0,,Бұл біздің қала!
Dialogue: 0,0:18:15.76,0:18:16.51,Default,,0,0,0,,Шық!
Dialogue: 0,0:18:16.92,0:18:17.72,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:18.18,0:18:19.47,Default,,0,0,0,,Барлығымыз жұқтырдық
Dialogue: 0,0:18:19.55,0:18:20.64,Default,,0,0,0,,Мен ұрысқым келмейді
Dialogue: 0,0:18:21.14,0:18:22.89,Default,,0,0,0,,Бізбен бірге кел!
Dialogue: 0,0:18:23.31,0:18:25.89,Default,,0,0,0,,Олар біздің үйді қиратты!
Dialogue: 0,0:18:26.14,0:18:27.39,Default,,0,0,0,,Оян!
Dialogue: 0,0:18:27.81,0:18:28.89,Default,,0,0,0,,Бізбен бірге
Dialogue: 0,0:18:29.06,0:18:30.81,Default,,0,0,0,,Жұқтырғандар үшін тұр!
Dialogue: 0,0:18:31.23,0:18:32.27,Default,,0,0,0,,Не айттың!
Dialogue: 0,0:18:32.61,0:18:34.07,Default,,0,0,0,,Үйімізді қайтарып бер!
Dialogue: 0,0:18:37.65,0:18:38.36,Default,,0,0,0,,Осыдан әрі баруға саған рұқсат жоқ.
Dialogue: 0,0:18:38.65,0:18:39.36,Default,,0,0,0,,Амия-сан
Dialogue: 0,0:18:41.70,0:18:42.87,Default,,0,0,0,,Сахна артына өту
Dialogue: 0,0:18:42.95,0:18:45.24,Default,,0,0,0,,Қане, қазір түкпір-түкпірден шығайық!
Dialogue: 0,0:18:45.79,0:18:47.62,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,0:18:48.75,0:18:49.62,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:18:58.84,0:18:59.47,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:18:59.68,0:19:00.43,Default,,0,0,0,,Амия
Dialogue: 0,0:19:01.97,0:19:03.51,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:19:06.56,0:19:07.27,Default,,0,0,0,,Бірден
Dialogue: 0,0:19:07.85,0:19:08.98,Default,,0,0,0,,Мен оны аяқтаймын.
Dialogue: 0,0:19:10.31,0:19:10.94,Default,,0,0,0,,Иә
Dialogue: 0,0:19:12.98,0:19:13.61,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:19:13.90,0:19:15.15,Default,,0,0,0,,Миша, өтінемін.
Dialogue: 0,0:19:15.86,0:19:16.48,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:19:17.44,0:19:20.36,Default,,0,0,0,,Саған ергенім қате болмады.
Dialogue: 0,0:19:21.07,0:19:21.70,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:19:21.78,0:19:24.45,Default,,0,0,0,,Осы арамза адамдарды оқытайық.
Dialogue: 0,0:19:24.95,0:19:25.91,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:19:26.20,0:19:27.70,Default,,0,0,0,,Осылай бола ма?
Dialogue: 0,0:19:28.12,0:19:29.21,Default,,0,0,0,,Сіз мұны білдіңіз.
Dialogue: 0,0:19:29.62,0:19:30.29,Default,,0,0,0,,Хэхэцу
Dialogue: 0,0:19:30.54,0:19:31.21,Default,,0,0,0,,Мане
Dialogue: 0,0:19:43.59,0:19:45.39,Default,,0,0,0,,Мен саған ұнайтын нәрсені істеуге рұқсат бермеймін!
Dialogue: 0,0:19:50.31,0:19:51.56,Default,,0,0,0,,Культ жетекшісін табынатын ізбасардың сезімі
Dialogue: 0,0:20:09.12,0:20:10.16,Default,,0,0,0,,Бұл жерде қауіпті
Dialogue: 0,0:20:10.91,0:20:12.29,Default,,0,0,0,,Дереу кетіңіз
Dialogue: 0,0:20:13.83,0:20:14.75,Default,,0,0,0,,Жырақта!
Dialogue: 0,0:20:17.09,0:20:19.42,Default,,0,0,0,,Мен кеткенде қайда баруым керек?
Dialogue: 0,0:20:21.17,0:20:22.09,Default,,0,0,0,,Біздің үй
Dialogue: 0,0:20:23.34,0:20:24.39,Default,,0,0,0,,Міне
Dialogue: 0,0:20:25.47,0:20:27.14,Default,,0,0,0,,Мені қанша құртса да
Dialogue: 0,0:20:28.06,0:20:30.64,Default,,0,0,0,,Бұл мен бола алатын жалғыз жер
Dialogue: 0,0:20:36.90,0:20:37.82,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:45.07,0:20:46.57,Default,,0,0,0,,Кездесу
Dialogue: 0,0:20:46.66,0:20:49.03,Default,,0,0,0,,Ауруға шалдыққан адамдарға қандай жеңілдік бар?
Dialogue: 0,0:20:49.45,0:20:51.00,Default,,0,0,0,,...
Dialogue: 0,0:20:51.66,0:20:52.79,Default,,0,0,0,,Осындай кездесуде
Dialogue: 0,0:20:53.46,0:20:55.67,Default,,0,0,0,,Кейбір адамдардың шабыт алғанын білдіреді.
Dialogue: 0,0:20:56.67,0:20:58.84,Default,,0,0,0,,Неліктен бұлай болады?
Dialogue: 0,0:20:59.13,0:21:02.26,Default,,0,0,0,,Мен Родоске мүлде сенбеймін.
Dialogue: 0,0:21:04.63,0:21:05.76,Default,,0,0,0,,Реюньон
Dialogue: 0,0:21:06.47,0:21:08.68,Default,,0,0,0,,...
Dialogue: 0,0:21:09.26,0:21:11.77,Default,,0,0,0,,Сіз оны жүзеге асыра алатындай сөйлейсіз.
Dialogue: 0,0:21:13.02,0:21:13.68,Default,,0,0,0,,Тіпті бір сәтке
Dialogue: 0,0:21:13.77,0:21:16.35,Default,,0,0,0,,Қатал шындықтан көзіңді бұра алсаң
Dialogue: 0,0:21:17.52,0:21:18.65,Default,,0,0,0,,...
Dialogue: 0,0:21:19.44,0:21:21.11,Default,,0,0,0,,...
Dialogue: 0,0:21:22.07,0:21:23.57,Default,,0,0,0,,...
Dialogue: 0,0:21:23.65,0:21:25.57,Default,,0,0,0,,...
Dialogue: 0,0:21:26.82,0:21:27.45,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:27.57,0:21:28.24,Default,,0,0,0,,Родос
Dialogue: 0,0:21:28.78,0:21:31.37,Default,,0,0,0,,Қолымнан келмейтін нәрсені істей аламын деп өтірік айтпаймын.
Dialogue: 0,0:21:32.70,0:21:35.16,Default,,0,0,0,,...
Dialogue: 0,0:21:35.58,0:21:39.25,Default,,0,0,0,,Өтірік айта алмайтын, жағымпазданбайтын ақымақ адал қоян қыз туралы.
Dialogue: 0,0:21:40.17,0:21:42.09,Default,,0,0,0,,Сіз бұған сенбейсіз.
Dialogue: 0,0:21:50.01,0:21:50.85,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:21:54.14,0:21:54.93,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:21:55.52,0:21:56.77,Default,,0,0,0,,...
Dialogue: 0,0:22:00.11,0:22:00.82,Default,,0,0,0,,...
Dialogue: 0,0:22:03.94,0:22:05.11,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:06.61,0:22:12.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory