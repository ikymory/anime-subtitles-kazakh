Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.76,0:00:26.84,Default,,0,0,0,,Pipirupilpirupilpipilupi Мен оны түзетемін.
Dialogue: 0,0:00:34.56,0:00:37.68,Default,,0,0,0,,Жалт қаратпаңыз
Dialogue: 0,0:00:40.84,0:00:44.84,Default,,0,0,0,,Angel Earthsplash Докудокудокуро-чан
Dialogue: 0,0:00:44.88,0:00:49.62,Default,,0,0,0,,Boxaz Angel Жүрек соғуы
Dialogue: 0,0:00:50.74,0:00:55.94,Default,,0,0,0,,Мені Рунамен байлап, ұрып, тепкілеп, жерге іліп ал.
Dialogue: 0,0:00:56.18,0:00:59.54,Default,,0,0,0,,Бірақ бұл менің махаббатым
Dialogue: 0,0:01:08.03,0:01:28.27,Default,,0,0,0,,...
Dialogue: 0,0:01:31.98,0:01:35.38,Default,,0,0,0,,Бұл махаббаттың Кюмпиті, Докуро-чан
Dialogue: 0,0:01:50.12,0:01:52.32,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:01:55.00,0:01:58.30,Default,,0,0,0,,Докуро-чан осындай жерде болды
Dialogue: 0,0:01:58.58,0:02:00.62,Default,,0,0,0,,Ах, Сакура-кун
Dialogue: 0,0:02:00.62,0:02:02.78,Default,,0,0,0,,Үйге бар.
Dialogue: 0,0:02:02.78,0:02:03.60,Default,,0,0,0,,Иә
Dialogue: 0,0:02:03.60,0:02:08.68,Default,,0,0,0,,Докуро-чан көп ұзамай шүмекке тимей су ішу керек.
Dialogue: 0,0:02:08.84,0:02:10.32,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:02:10.78,0:02:12.14,Default,,0,0,0,,Менің есімде ештеңе жоқ!
Dialogue: 0,0:02:12.14,0:02:16.28,Default,,0,0,0,,Менің айтқым келгені, оны кранға тікелей қою санитарлық талаптарға сай емес.
Dialogue: 0,0:02:16.50,0:02:20.70,Default,,0,0,0,,Бұл Сакура-кунның да осы шүмектен су ішкісі келетінін білдіре ме?
Dialogue: 0,0:02:21.10,0:02:22.50,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:02:22.50,0:02:26.42,Default,,0,0,0,,Жарайды, Докуро-чан, сен әдетте суды осылай ішесің.
Dialogue: 0,0:02:27.76,0:02:30.30,Default,,0,0,0,,Аузыңызды шығып жатқан судың үстіне қойыңыз.
Dialogue: 0,0:02:39.64,0:02:43.80,Default,,0,0,0,,Докуро-чан дәл қазір сол адаммен менің басымды кесіп алмақшы.
Dialogue: 0,0:02:43.80,0:02:50.13,Default,,0,0,0,,Жоқ, мен
Dialogue: 0,0:02:50.13,0:02:51.05,Default,,0,0,0,,Сөзсіз айла
Dialogue: 0,0:02:59.14,0:03:01.04,Default,,0,0,0,,Аздап ылғалды, не істеуім керек?
Dialogue: 0,0:03:01.92,0:03:05.46,Default,,0,0,0,,Сакура-кун, не болды?
Dialogue: 0,0:03:10.01,0:03:15.15,Default,,0,0,0,,Бас сүйек-чан!
Dialogue: 0,0:03:29.36,0:03:31.14,Default,,0,0,0,,Мен киімімді ауыстырайын.
Dialogue: 0,0:03:32.80,0:03:34.94,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:03:34.94,0:03:36.12,Default,,0,0,0,,Шизуки-чан
Dialogue: 0,0:03:36.12,0:03:40.22,Default,,0,0,0,,Сакура-кун, сенен сұрайын дегенім бар.
Dialogue: 0,0:03:40.28,0:03:42.76,Default,,0,0,0,,Кеңес беру дегеніміз не? Консультация дегеніміз не? Консультация дегеніміз не?
Dialogue: 0,0:03:42.76,0:03:44.54,Default,,0,0,0,,Мүмкін, мүмкін, мүмкін
Dialogue: 0,0:03:44.54,0:03:48.04,Default,,0,0,0,,Эй, Миямото-кун бар ма?
Dialogue: 0,0:03:48.16,0:03:50.38,Default,,0,0,0,,Иә, Миямото?
Dialogue: 0,0:03:51.26,0:03:54.38,Default,,0,0,0,,Миямото-кунның сүйікті қызы бар ма?
Dialogue: 0,0:03:54.62,0:03:57.00,Default,,0,0,0,,Жоқ, мен олай ойламаймын.
Dialogue: 0,0:03:57.00,0:04:01.64,Default,,0,0,0,,Бірақ бейсбол клубының менеджерімен 3 жыл бойы жақсы дос болған деген қауесет тарады.
Dialogue: 0,0:04:01.64,0:04:03.76,Default,,0,0,0,,Мен Маемиямотодан сұрадым.
Dialogue: 0,0:04:03.76,0:04:07.48,Default,,0,0,0,,Керісінше, табандылық танытып, мені мазалап жүргенін айтты.
Dialogue: 0,0:04:07.48,0:04:10.44,Default,,0,0,0,,Олай болса, сен неге Миямото туралы естідің?
Dialogue: 0,0:04:10.76,0:04:15.86,Default,,0,0,0,,Негізі мен оны ұната бастадым.
Dialogue: 0,0:04:19.08,0:04:21.30,Default,,0,0,0,,Мен ғашық болған бір қыз болды.
Dialogue: 0,0:04:21.30,0:04:22.96,Default,,0,0,0,,Не, Сакура-кун?
Dialogue: 0,0:04:24.04,0:04:25.28,Default,,0,0,0,,Сакура-кун, не болды?
Dialogue: 0,0:04:25.62,0:04:27.10,Default,,0,0,0,,Сәлем Сакура-кун
Dialogue: 0,0:04:27.14,0:04:28.98,Default,,0,0,0,,Бұл жер
Dialogue: 0,0:04:28.98,0:04:31.56,Default,,0,0,0,,Мах Жер билеп тұрды
Dialogue: 0,0:04:32.56,0:04:34.86,Default,,0,0,0,,Сакура-кун, сен дұрыс түсінбедің бе?
Dialogue: 0,0:04:35.52,0:04:39.56,Default,,0,0,0,,Мен Миямото-кунға бала сүйгенін қалайтынымды айттым.
Dialogue: 0,0:04:41.08,0:04:47.04,Default,,0,0,0,,Менімен бір кітапханаға баратын 2 курс С сынып оқушысы Чиери Оно маған кеңес берді.
Dialogue: 0,0:04:47.22,0:04:52.48,Default,,0,0,0,,Сонымен, Сакура-кун, Чиери-чан мен Миямото-кунның арасына делдал болуға көмектесесің бе?
Dialogue: 0,0:04:53.80,0:04:56.77,Default,,0,0,0,,Сәлем Чиери-чан
Dialogue: 0,0:04:57.55,0:05:00.65,Default,,0,0,0,,Бұл формула, ол туралы айтып бере аласыз ба?
Dialogue: 0,0:05:02.09,0:05:05.71,Default,,0,0,0,,А, мен оны да түсінбеймін.
Dialogue: 0,0:05:14.60,0:05:14.96,Default,,0,0,0,,О
Dialogue: 0,0:05:14.96,0:05:17.20,Default,,0,0,0,,Біріншіден, барлық жақшаларды алып тастау
Dialogue: 0,0:05:17.20,0:05:19.74,Default,,0,0,0,,Себебі мен допты жинауым керек
Dialogue: 0,0:05:22.93,0:05:26.31,Default,,0,0,0,,Бір күні таңертең Грегор Самса оянды.
Dialogue: 0,0:05:26.31,0:05:31.85,Default,,0,0,0,,Мен төсегімде улы жәндіктің үлкен мөлшерге дейін шыңдалғанын таптым.
Dialogue: 0,0:05:32.37,0:05:34.31,Default,,0,0,0,,Жарайды, Грейл.
Dialogue: 0,0:05:34.39,0:05:36.81,Default,,0,0,0,,Бұл ауру емес
Dialogue: 0,0:05:37.37,0:05:38.95,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:05:38.95,0:05:40.81,Default,,0,0,0,,Сакура-чан, сен мұнда неге келдің?
Dialogue: 0,0:05:40.81,0:05:41.69,Default,,0,0,0,,Ши
Dialogue: 0,0:05:41.69,0:05:43.59,Default,,0,0,0,,Сакура-кун, бұл кітапхана.
Dialogue: 0,0:05:43.59,0:05:45.09,Default,,0,0,0,,Сондықтан таңғаласың.
Dialogue: 0,0:05:45.09,0:05:47.45,Default,,0,0,0,,Бұл ертерек басқа әңгіме болар еді.
Dialogue: 0,0:05:47.45,0:05:49.41,Default,,0,0,0,,Кітапханада не істеп жүрсің?
Dialogue: 0,0:05:49.41,0:05:51.29,Default,,0,0,0,,Сізде ондай кейіпкер жоқ.
Dialogue: 0,0:05:52.14,0:05:54.94,Default,,0,0,0,,Сакура-кун, шу шығарып тұрғаның не?
Dialogue: 0,0:05:54.94,0:05:57.70,Default,,0,0,0,,Сабыр етпесең, қайта қателесесің.
Dialogue: 0,0:05:57.70,0:05:58.60,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:05:58.60,0:06:00.96,Default,,0,0,0,,Эй, эй, Сакура-кун
Dialogue: 0,0:06:01.18,0:06:02.66,Default,,0,0,0,,Мұны қалай оқисыз?
Dialogue: 0,0:06:02.66,0:06:04.78,Default,,0,0,0,,Бұл теңіз бетіндегі дене.
Dialogue: 0,0:06:06.12,0:06:11.64,Default,,0,0,0,,Ал теңіз денесі улы жәндіктерді сіңіреді,
Dialogue: 0,0:06:11.64,0:06:13.20,Default,,0,0,0,,Бұл кітапхана
Dialogue: 0,0:06:13.20,0:06:15.36,Default,,0,0,0,,Кешіріңіз, бұл ештеңе емес, бұл ештеңе емес.
Dialogue: 0,0:06:15.36,0:06:16.72,Default,,0,0,0,,Токуро-чан, №.
Dialogue: 0,0:06:16.72,0:06:18.40,Default,,0,0,0,,Кітапханаға біртүрлі кітап әкеліңіз
Dialogue: 0,0:06:18.40,0:06:20.22,Default,,0,0,0,,Бұл кітапхана кітабы.
Dialogue: 0,0:06:20.22,0:06:21.86,Default,,0,0,0,,Тыйым салынғанына сене алар емеспін
Dialogue: 0,0:06:21.86,0:06:25.16,Default,,0,0,0,,Жылулық пен қыздың тән сыры
Dialogue: 0,0:06:25.48,0:06:27.90,Default,,0,0,0,,Мен сені қатты оқып жатырсың деп ойлаған кезде
Dialogue: 0,0:06:27.90,0:06:29.22,Default,,0,0,0,,Хехехе мақтады.
Dialogue: 0,0:06:29.22,0:06:30.14,Default,,0,0,0,,Мақтамау
Dialogue: 0,0:06:30.14,0:06:32.56,Default,,0,0,0,,Токуро-чан үшін бұл да ерте.
Dialogue: 0,0:06:32.56,0:06:35.90,Default,,0,0,0,,Сакура, саған дұрыс білім беремін.
Dialogue: 0,0:06:35.90,0:06:38.38,Default,,0,0,0,,Уайымдама, мен уды сындырдым.
Dialogue: 0,0:06:38.38,0:06:39.52,Default,,0,0,0,,Сәлем Сакура
Dialogue: 0,0:06:39.52,0:06:41.18,Default,,0,0,0,,Оны қатты айтудың қажеті жоқ.
Dialogue: 0,0:06:41.18,0:06:42.44,Default,,0,0,0,,Біз сыныптаспыз.
Dialogue: 0,0:06:42.84,0:06:45.56,Default,,0,0,0,,Сакура-кун, сен тұрғанда, бірге оқиық.
Dialogue: 0,0:06:45.56,0:06:48.76,Default,,0,0,0,,Дұрыс, бәріміз бірге оқуымыз керек.
Dialogue: 0,0:06:48.76,0:06:51.26,Default,,0,0,0,,Жуынатын бөлме үшін кешіріңіз.
Dialogue: 0,0:06:55.02,0:06:57.22,Default,,0,0,0,,Иә, мен де солаймын.
Dialogue: 0,0:06:57.22,0:06:58.66,Default,,0,0,0,,Бұл не, Сакура?
Dialogue: 0,0:06:58.66,0:07:01.06,Default,,0,0,0,,Мен анықтамалық материалдарды іздеймін.
Dialogue: 0,0:07:01.06,0:07:03.96,Default,,0,0,0,,Мен жақында қайтамын, сондықтан мен өзіммен бірге Токуро-чанды іздеймін.
Dialogue: 0,0:07:03.96,0:07:05.60,Default,,0,0,0,,Эй, сен не оқып жатырсың?
Dialogue: 0,0:07:05.62,0:07:06.76,Default,,0,0,0,,Алдыңғы шайқас
Dialogue: 0,0:07:06.76,0:07:09.30,Default,,0,0,0,,Жоқ, бұл қазір екеуміз үшін ең жаман нәрсе.
Dialogue: 0,0:07:09.30,0:07:10.54,Default,,0,0,0,,Мұнда кел, Токуро-чан.
Dialogue: 0,0:07:11.80,0:07:14.30,Default,,0,0,0,,Мені осындай жерге әкелгенде не айтып тұрсың?
Dialogue: 0,0:07:14.58,0:07:18.04,Default,,0,0,0,,Токуро-чан, атмосфераны неге көбірек оқымайсың?
Dialogue: 0,0:07:18.04,0:07:20.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:20.46,0:07:21.78,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:21.78,0:07:23.52,Default,,0,0,0,,Мен атмосфераны оқыдым.
Dialogue: 0,0:07:23.52,0:07:25.84,Default,,0,0,0,,Мұнда емес, ана жақтағы атмосфера.
Dialogue: 0,0:07:25.84,0:07:26.52,Default,,0,0,0,,Иә
Dialogue: 0,0:07:26.52,0:07:28.78,Default,,0,0,0,,Көзілдірік киген қыз Чи Оно.
Dialogue: 0,0:07:28.78,0:07:29.90,Default,,0,0,0,,Бала Миямото
Dialogue: 0,0:07:30.74,0:07:33.94,Default,,0,0,0,,Негізі, Оно-сан, маған Миямото ұнайды.
Dialogue: 0,0:07:34.86,0:07:37.80,Default,,0,0,0,,Енді мен және Шизуки-чанмыз.
Dialogue: 0,0:07:37.80,0:07:41.56,Default,,0,0,0,,Екеуіңді жақсы дос етуге тырысамын.
Dialogue: 0,0:07:41.56,0:07:43.30,Default,,0,0,0,,Токуро-чан
Dialogue: 0,0:07:43.98,0:07:46.50,Default,,0,0,0,,Мүмкін сіз ұялшақ шығарсыз?
Dialogue: 0,0:07:46.50,0:07:49.58,Default,,0,0,0,,Оно-сан Миямото-кунды жақсы көре ме?
Dialogue: 0,0:07:49.58,0:07:50.80,Default,,0,0,0,,Иә
Dialogue: 0,0:07:52.84,0:07:53.72,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:53.72,0:07:56.46,Default,,0,0,0,,Байқамасаңыз, көмектесу мүмкін емес.
Dialogue: 0,0:07:56.46,0:07:57.32,Default,,0,0,0,,Бірақ қазірден бастап
Dialogue: 0,0:07:57.32,0:08:00.32,Default,,0,0,0,,Мен періштеммін, демек, мен Кюмпитпін.
Dialogue: 0,0:08:00.32,0:08:00.96,Default,,0,0,0,,Иә
Dialogue: 0,0:08:01.16,0:08:02.62,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:08:02.62,0:08:04.08,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:08:04.36,0:08:05.80,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:08:05.80,0:08:09.92,Default,,0,0,0,,Періште – бір-бірін сүйе алатын екі адамға жол көрсететін періште.
Dialogue: 0,0:08:10.50,0:08:13.36,Default,,0,0,0,,Періштелерде әдетте мұндай болат сауыт болмайды.
Dialogue: 0,0:08:13.36,0:08:14.74,Default,,0,0,0,,Сонымен, сіз не істейсіз?
Dialogue: 0,0:08:14.74,0:08:15.34,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:08:15.34,0:08:16.64,Default,,0,0,0,,Токуро-чанның бірдеңе істеуінен гөрі
Dialogue: 0,0:08:16.64,0:08:18.46,Default,,0,0,0,,Оно-санның өзі айтуы керек, солай ма?
Dialogue: 0,0:08:18.46,0:08:21.42,Default,,0,0,0,,Біздің қолымыздан келгені Оно мырзаға көмектесу.
Dialogue: 0,0:08:21.42,0:08:23.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:23.66,0:08:24.88,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:08:24.88,0:08:28.26,Default,,0,0,0,,Періштелердің қолынан бәрі көмек.
Dialogue: 0,0:08:28.26,0:08:29.90,Default,,0,0,0,,Түсіндім, Токуро-чан.
Dialogue: 0,0:08:29.90,0:08:31.12,Default,,0,0,0,,Олай болса маған қосымша сыйлық беріңіз.
Dialogue: 0,0:08:31.12,0:08:32.02,Default,,0,0,0,,Иә
Dialogue: 0,0:08:32.02,0:08:35.24,Default,,0,0,0,,Оно-сан Миямотоны жақсы көретіні құпия
Dialogue: 0,0:08:35.24,0:08:39.02,Default,,0,0,0,,Сакура-кун әлі күнге дейін анасымен бірге шомылатыны құпия.
Dialogue: 0,0:08:39.02,0:08:40.20,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:40.20,0:08:42.28,Default,,0,0,0,,Бастауыш мектептің 6-сыныбында ойнауды тоқтаттым.
Dialogue: 0,0:08:42.28,0:08:44.52,Default,,0,0,0,,Сондықтан сәл күте тұрыңыз.
Dialogue: 0,0:08:44.52,0:08:46.22,Default,,0,0,0,,Қорғау
Dialogue: 0,0:08:46.22,0:08:50.86,Default,,0,0,0,,Иә
Dialogue: 0,0:08:59.42,0:09:00.64,Default,,0,0,0,,Миямото
Dialogue: 0,0:09:08.12,0:09:09.52,Default,,0,0,0,,Бұл қиын, Токуро-чан.
Dialogue: 0,0:09:09.52,0:09:11.32,Default,,0,0,0,,Неліктен сиқырмен шатастырдың?
Dialogue: 0,0:09:11.32,0:09:13.38,Default,,0,0,0,,Бұл сенің кесіріңнен болды, солай ма?
Dialogue: 0,0:09:13.54,0:09:14.62,Default,,0,0,0,,Бұл басқаша
Dialogue: 0,0:09:14.62,0:09:16.64,Default,,0,0,0,,Себебі Сакура-кун маған жиіркенішті істер жасайды.
Dialogue: 0,0:09:16.64,0:09:19.86,Default,,0,0,0,,Бәрі жақсы, адамдарды тазарту үшін кедергі сияқты нәрсені белсендіріңіз.
Dialogue: 0,0:09:19.86,0:09:22.12,Default,,0,0,0,,Сакура-кун періштелер туралы не ойлайды?
Dialogue: 0,0:09:22.12,0:09:23.80,Default,,0,0,0,,Періштелер мұны істей алмайды.
Dialogue: 0,0:09:23.80,0:09:25.04,Default,,0,0,0,,Сонымен, сіз не істей аласыз?
Dialogue: 0,0:09:25.04,0:09:26.48,Default,,0,0,0,,Радио жаттығулары
Dialogue: 0,0:09:26.48,0:09:27.94,Default,,0,0,0,,2-ші
Dialogue: 0,0:09:27.94,0:09:29.60,Default,,0,0,0,,Бұл пайдасыз нәрсе
Dialogue: 0,0:09:31.80,0:09:33.50,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:33.50,0:09:35.20,Default,,0,0,0,,Оно мырза
Dialogue: 0,0:09:36.44,0:09:37.90,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:09:37.94,0:09:39.54,Default,,0,0,0,,Миямото-кун басқаша.
Dialogue: 0,0:09:39.54,0:09:40.50,Default,,0,0,0,,Екеуің де жақсысыңдар.
Dialogue: 0,0:09:40.50,0:09:42.06,Default,,0,0,0,,Миямото-кун
Dialogue: 0,0:09:42.06,0:09:43.70,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:43.70,0:09:45.06,Default,,0,0,0,,Нумата Сенпай
Dialogue: 0,0:09:45.06,0:09:45.90,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:09:45.90,0:09:47.48,Default,,0,0,0,,Ол Харуна Нумата
Dialogue: 0,0:09:47.48,0:09:48.86,Default,,0,0,0,,Бейсбол клубының менеджері
Dialogue: 0,0:09:48.86,0:09:50.74,Default,,0,0,0,,Өткен жылғы Мисс Герника мектебі жалпы есепте 3-ші орын
Dialogue: 0,0:09:50.74,0:09:52.84,Default,,0,0,0,,Менің айтайын дегенім, бұл неге мұнда?
Dialogue: 0,0:09:52.84,0:09:54.16,Default,,0,0,0,,Жарайды, Сенпай.
Dialogue: 0,0:09:54.16,0:09:55.22,Default,,0,0,0,,Мен қаншамын
Dialogue: 0,0:09:55.22,0:09:56.30,Default,,0,0,0,,А, осы ма?
Dialogue: 0,0:09:56.30,0:09:59.38,Default,,0,0,0,,Сіз бейсбол клубының болашағын иығыңызда көтеретін эйссіз.
Dialogue: 0,0:09:59.38,0:10:01.98,Default,,0,0,0,,Ойыншыларға қамқорлық жасау – менеджердің жұмысы.
Dialogue: 0,0:10:01.98,0:10:03.34,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:10:03.34,0:10:04.14,Default,,0,0,0,,Иә
Dialogue: 0,0:10:05.36,0:10:06.36,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:10:07.23,0:10:09.23,Default,,0,0,0,,Неліктен бұл Шрабха?
Dialogue: 0,0:10:15.56,0:10:18.04,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:10:18.97,0:10:20.13,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:10:20.13,0:10:21.77,Default,,0,0,0,,Аға
Dialogue: 0,0:10:21.77,0:10:23.09,Default,,0,0,0,,Оно мырза
Dialogue: 0,0:10:23.09,0:10:24.29,Default,,0,0,0,,Токуро-чан
Dialogue: 0,0:10:24.29,0:10:25.25,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:10:25.25,0:10:27.53,Default,,0,0,0,,Миямото-кун менмін
Dialogue: 0,0:10:27.53,0:10:30.67,Default,,0,0,0,,Мен Миямото-кунды медбике кабинетіне апарамын.
Dialogue: 0,0:10:31.23,0:10:33.51,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:10:34.07,0:10:36.43,Default,,0,0,0,,Егер Миямото-кун қателессе,
Dialogue: 0,0:10:36.43,0:10:39.15,Default,,0,0,0,,Мен енді бейсбол ойнай алмайтын шығармын.
Dialogue: 0,0:10:39.15,0:10:40.41,Default,,0,0,0,,Сенпай, тоқташы.
Dialogue: 0,0:10:40.41,0:10:41.11,Default,,0,0,0,,Мен
Dialogue: 0,0:10:41.41,0:10:41.81,Default,,0,0,0,,Ылғау
Dialogue: 0,0:10:41.81,0:10:44.09,Default,,0,0,0,,Мен тек шындықты айттым.
Dialogue: 0,0:10:44.09,0:10:47.13,Default,,0,0,0,,Миямото-кун мені қорғап, жарақат алды.
Dialogue: 0,0:10:47.23,0:10:51.05,Default,,0,0,0,,Мен Миямото-кунды медбике кабинетіне апарамын.
Dialogue: 0,0:10:51.21,0:10:52.73,Default,,0,0,0,,Бұл бала не істеп жатыр?
Dialogue: 0,0:10:52.73,0:10:54.79,Default,,0,0,0,,Сәлем Миямото-кун
Dialogue: 0,0:10:54.79,0:10:55.55,Default,,0,0,0,,Аға
Dialogue: 0,0:10:55.69,0:10:58.33,Default,,0,0,0,,Мен Оно мырзадан мені сонда апаруын өтінемін.
Dialogue: 0,0:10:58.33,0:10:59.21,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:10:59.21,0:11:01.25,Default,,0,0,0,,Миямото-кун
Dialogue: 0,0:11:02.50,0:11:03.94,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:11:03.94,0:11:05.70,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:11:05.70,0:11:06.86,Default,,0,0,0,,Оно мырза
Dialogue: 0,0:11:06.86,0:11:07.88,Default,,0,0,0,,Кеттік
Dialogue: 0,0:11:07.88,0:11:08.72,Default,,0,0,0,,Иә
Dialogue: 0,0:11:12.00,0:11:14.50,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:11.72,0:11:13.00,Default,,0,0,0,,Мен
Dialogue: 0,0:11:13.76,0:11:15.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:15.64,0:11:19.00,Default,,0,0,0,,Мен үшін, мен үшін маңызды біреу
Dialogue: 0,0:11:19.00,0:11:20.92,Default,,0,0,0,,Жарайды, өйткені бұл жай кесу.
Dialogue: 0,0:11:20.92,0:11:22.74,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:11:22.74,0:11:24.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:24.28,0:11:25.08,Default,,0,0,0,,Мен
Dialogue: 0,0:11:25.08,0:11:26.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:26.10,0:11:27.02,Default,,0,0,0,,Оно мырза
Dialogue: 0,0:11:27.02,0:11:27.62,Default,,0,0,0,,Мен
Dialogue: 0,0:11:27.62,0:11:28.98,Default,,0,0,0,,Біреуді оқуыңызды көруін сұраңыз
Dialogue: 0,0:11:28.98,0:11:31.16,Default,,0,0,0,,Сонымен қатар, зардап шеккен адамға көмек көрсету.
Dialogue: 0,0:11:31.16,0:11:32.22,Default,,0,0,0,,Иә
Dialogue: 0,0:11:32.22,0:11:33.32,Default,,0,0,0,,Мен
Dialogue: 0,0:11:33.32,0:11:34.02,Default,,0,0,0,,Мен
Dialogue: 0,0:11:34.02,0:11:36.46,Default,,0,0,0,,Оно-санмен оқу қызық болды.
Dialogue: 0,0:11:36.46,0:11:36.76,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:11:37.90,0:11:38.70,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:11:39.44,0:11:42.02,Default,,0,0,0,,Бұл жолы осындай нәрсе болды.
Dialogue: 0,0:11:42.02,0:11:43.48,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:11:43.58,0:11:46.02,Default,,0,0,0,,Маған оқуды үйрете аласыз ба?
Dialogue: 0,0:11:46.84,0:11:48.84,Default,,0,0,0,,Өйткені, бұл
Dialogue: 0,0:11:48.84,0:11:51.70,Default,,0,0,0,,Қызық, бұл біздің артық брутомыз бола ма?
Dialogue: 0,0:11:51.70,0:11:53.80,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:53.80,0:11:55.88,Default,,0,0,0,,Бұл екеуіне не керек еді
Dialogue: 0,0:11:55.88,0:11:59.54,Default,,0,0,0,,Мүмкін бұл кішкентай ғана мүмкіндік болды.
Dialogue: 0,0:11:59.54,0:12:00.16,Default,,0,0,0,,Кейінірек
Dialogue: 0,0:12:00.16,0:12:02.42,Default,,0,0,0,,Оны табу үшін батылдық
Dialogue: 0,0:12:02.42,0:12:03.36,Default,,0,0,0,,Мүмкін, өз-өзімді қабылдауымда сәл айырмашылық бар шығар
Dialogue: 0,0:12:03.36,0:12:04.54,Default,,0,0,0,,Немесе
Dialogue: 0,0:12:05.18,0:12:08.69,Default,,0,0,0,,Жоқ, бірақ мен бұл шындық деп ешқашан ойламадым.
Dialogue: 0,0:12:08.69,0:12:11.57,Default,,0,0,0,,Куро-чан Купидаға айналады.
Dialogue: 0,0:12:11.57,0:12:15.05,Default,,0,0,0,,А, түсіндім, бірақ періште жай ғана періште емес деп ойлаймын.
Dialogue: 0,0:12:15.05,0:12:17.59,Default,,0,0,0,,Білесің бе, Сакура-кун?
Dialogue: 0,0:12:17.59,0:12:18.63,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:18.63,0:12:20.37,Default,,0,0,0,,Кино билеттері.
Dialogue: 0,0:12:20.37,0:12:22.47,Default,,0,0,0,,Оны маған анам берді.
Dialogue: 0,0:12:22.47,0:12:24.01,Default,,0,0,0,,Иә
Dialogue: 0,0:12:24.01,0:12:26.29,Default,,0,0,0,,Сынақ біткеннен кейін бәрібір.
Dialogue: 0,0:12:26.29,0:12:27.81,Default,,0,0,0,,Бірге бармау
Dialogue: 0,0:12:27.81,0:12:29.45,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:12:29.45,0:12:31.33,Default,,0,0,0,,Бір таң
Dialogue: 0,0:12:31.33,0:12:34.51,Default,,0,0,0,,Грегор Самса біртүрлі түстен оянғанда
Dialogue: 0,0:12:34.51,0:12:36.17,Default,,0,0,0,,Төсектегі улы жәндіктер
Dialogue: 0,0:12:36.17,0:12:38.95,Default,,0,0,0,,Ол бір нәрсеге құлап қалды.
Dialogue: 0,0:12:39.31,0:12:41.41,Default,,0,0,0,,Жарайды, Грегор.
Dialogue: 0,0:12:41.41,0:12:45.35,Default,,0,0,0,,Денсаулықтың белгісі
Dialogue: 0,0:12:47.56,0:12:48.68,Default,,0,0,0,,Boxus Angel
Dialogue: 0,0:12:53.16,0:12:55.72,Default,,0,0,0,,Бұл жаңа кино жұмағы.
Dialogue: 0,0:12:55.72,0:12:57.36,Default,,0,0,0,,Токоро-чан
Dialogue: 0,0:13:01.36,0:13:05.94,Default,,0,0,0,,Ах.
Dialogue: 0,0:13:05.94,0:13:08.00,Default,,0,0,0,,Неліктен дәл осы уақытта?
Dialogue: 0,0:13:08.76,0:13:10.68,Default,,0,0,0,,Сакура-кун
Dialogue: 0,0:13:12.14,0:13:14.44,Default,,0,0,0,,Сізді оятқаным үшін кешіріңіз, Токоро-чан.
Dialogue: 0,0:13:14.72,0:13:17.28,Default,,0,0,0,,Токоро-чан неге менің футонымда ұйықтап жатыр?
Dialogue: 0,0:13:18.90,0:13:19.94,Default,,0,0,0,,Сакура-кун
Dialogue: 0,0:13:38.76,0:13:40.64,Default,,0,0,0,,Тұр
Dialogue: 0,0:13:40.64,0:13:41.94,Default,,0,0,0,,Тұр
Dialogue: 0,0:13:41.94,0:13:42.44,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:13:42.44,0:13:43.12,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:13:43.12,0:13:44.44,Default,,0,0,0,,Орныңыздан тұрмаңыз
Dialogue: 0,0:13:46.27,0:13:46.97,Default,,0,0,0,,Токоро-чан
Dialogue: 0,0:13:46.97,0:13:48.33,Default,,0,0,0,,Тағы да біз
Dialogue: 0,0:13:48.33,0:13:51.51,Default,,0,0,0,,Ұйқы
Dialogue: 0,0:13:57.49,0:13:58.39,Default,,0,0,0,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:13:58.39,0:14:00.83,Default,,0,0,0,,Ана
Dialogue: 0,0:14:00.83,0:14:08.11,Default,,0,0,0,,Мен сияқты нәрсе
Dialogue: 0,0:14:08.11,0:14:10.47,Default,,0,0,0,,Менің алдымда сөйле
Dialogue: 0,0:14:11.59,0:14:13.83,Default,,0,0,0,,Неліктен Сакура-кун менің футонымда?
Dialogue: 0,0:14:13.83,0:14:14.67,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:14.67,0:14:16.27,Default,,0,0,0,,Токоро-чан менің футонымда
Dialogue: 0,0:14:22.72,0:14:23.24,Default,,0,0,0,,бара алмаймын
Dialogue: 0,0:14:23.24,0:14:32.24,Default,,0,0,0,,Бұл
Dialogue: 0,0:14:32.38,0:14:33.76,Default,,0,0,0,,Токоро-чан
Dialogue: 0,0:14:33.76,0:14:34.92,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:14:34.92,0:14:36.48,Default,,0,0,0,,Жолда ұйықтама
Dialogue: 0,0:14:36.48,0:14:37.16,Default,,0,0,0,,Бұл
Dialogue: 0,0:14:37.16,0:14:37.90,Default,,0,0,0,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:14:37.90,0:14:39.18,Default,,0,0,0,,Бұл біртүрлі
Dialogue: 0,0:14:39.60,0:14:41.16,Default,,0,0,0,,Бұл Перри.
Dialogue: 0,0:14:41.16,0:14:43.80,Default,,0,0,0,,Оны дұрыс түзетіңіз
Dialogue: 0,0:14:48.89,0:14:50.13,Default,,0,0,0,,Такумо
Dialogue: 0,0:14:50.61,0:14:53.29,Default,,0,0,0,,Бұл сізге суық тиюге әкеледі.
Dialogue: 0,0:14:53.29,0:14:55.23,Default,,0,0,0,,Даме Дансу Сакура-кун
Dialogue: 0,0:14:55.23,0:14:56.95,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:14:56.95,0:14:58.69,Default,,0,0,0,,Әлі ерте.
Dialogue: 0,0:14:58.69,0:14:59.67,Default,,0,0,0,,Өйткені
Dialogue: 0,0:14:59.67,0:15:01.01,Default,,0,0,0,,Юу және тағы басқалар
Dialogue: 0,0:15:01.01,0:15:02.49,Default,,0,0,0,,Кіші орта мектеп болатын сияқты
Dialogue: 0,0:15:02.49,0:15:03.75,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:15:03.75,0:15:05.29,Default,,0,0,0,,Менің бишім
Dialogue: 0,0:15:05.29,0:15:07.23,Default,,0,0,0,,Мұқият тыңдағандарыңызға рахмет.
Dialogue: 0,0:15:07.23,0:15:08.97,Default,,0,0,0,,Менің атым
Dialogue: 0,0:15:08.97,0:15:09.91,Default,,0,0,0,,Сакура-кун
Dialogue: 0,0:15:09.91,0:15:11.13,Default,,0,0,0,,Мен сенің шкафты ашуыңды қалаймын
Dialogue: 0,0:15:11.13,0:15:13.27,Default,,0,0,0,,Мии Токоро-чанның досы
Dialogue: 0,0:15:13.27,0:15:14.09,Default,,0,0,0,,Одан да сорақы
Dialogue: 0,0:15:14.09,0:15:15.95,Default,,0,0,0,,Ой, бұл Токоро-чанның ерекше сыйы.
Dialogue: 0,0:15:15.95,0:15:16.85,Default,,0,0,0,,Уау
Dialogue: 0,0:15:16.85,0:15:19.34,Default,,0,0,0,,Токоро-чан осындай
Dialogue: 0,0:15:19.34,0:15:21.20,Default,,0,0,0,,Талаптарды тыңдайық.
Dialogue: 0,0:15:21.20,0:15:23.24,Default,,0,0,0,,Рахмет Дансу Сакура-кун
Dialogue: 0,0:15:23.24,0:15:24.98,Default,,0,0,0,,Мии - Токоро-чанның ең жақын досы
Dialogue: 0,0:15:24.98,0:15:27.24,Default,,0,0,0,,Есімі – Дансу.
Dialogue: 0,0:15:27.26,0:15:29.72,Default,,0,0,0,,Сен неге айналаға қарап тұрсың?
Dialogue: 0,0:15:29.72,0:15:30.82,Default,,0,0,0,,Токоро-чанның қол астында
Dialogue: 0,0:15:30.82,0:15:33.90,Default,,0,0,0,,Юудың жүрегін ашу өтірік.
Dialogue: 0,0:15:33.90,0:15:35.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:36.10,0:15:37.60,Default,,0,0,0,,Айтайын дегенім, үйге қайт.
Dialogue: 0,0:15:37.60,0:15:38.46,Default,,0,0,0,,Токороға оралу
Dialogue: 0,0:15:38.46,0:15:39.68,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:15:39.68,0:15:41.02,Default,,0,0,0,,Мен сөйлесе аламын ба?
Dialogue: 0,0:15:41.06,0:15:42.16,Default,,0,0,0,,Ауырады, ауырады, ауырады
Dialogue: 0,0:15:42.16,0:15:42.82,Default,,0,0,0,,Сэндвичтелген
Dialogue: 0,0:15:42.82,0:15:44.72,Default,,0,0,0,,Миидің әңгімесін тыңдаңыз.
Dialogue: 0,0:15:44.72,0:15:46.26,Default,,0,0,0,,Юу болашақ әлемнен
Dialogue: 0,0:15:46.26,0:15:48.18,Default,,0,0,0,,Өлмейтіндікті дамытқан тұлға ретінде
Dialogue: 0,0:15:48.18,0:15:49.70,Default,,0,0,0,,Менің өмірім нысанаға алынған
Dialogue: 0,0:15:49.70,0:15:51.20,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:15:51.20,0:15:53.34,Default,,0,0,0,,Мен мұны істеуге мүмкіндік жоқ.
Dialogue: 0,0:15:53.42,0:15:54.62,Default,,0,0,0,,Тек ерлерге арналған
Dialogue: 0,0:15:54.62,0:15:56.58,Default,,0,0,0,,Сеншоку корпусы әйелдерге жатпайтын қалай аталады?
Dialogue: 0,0:15:56.68,0:15:58.04,Default,,0,0,0,,Вай Сеншокутай
Dialogue: 0,0:15:58.04,0:15:59.10,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:15:59.36,0:16:01.42,Default,,0,0,0,,Ю бәрібір кінәлі болды.
Dialogue: 0,0:16:01.80,0:16:03.54,Default,,0,0,0,,Мен мұны өткен күні сабақта орындадым.
Dialogue: 0,0:16:03.54,0:16:05.88,Default,,0,0,0,,Жаңа есіме түсті.
Dialogue: 0,0:16:07.14,0:16:09.32,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:09.68,0:16:13.54,Default,,0,0,0,,Мен бүгін Шизуки-чанмен кездессем де.
Dialogue: 0,0:16:14.92,0:16:15.84,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:24.00,0:16:26.50,Default,,0,0,0,,Шизуки-чан
Dialogue: 0,0:16:33.45,0:16:34.51,Default,,0,0,0,,Шизуки-чан
Dialogue: 0,0:16:34.51,0:16:36.69,Default,,0,0,0,,Дегенмен, меніңше, Кира осы екі нәрсенің бірін білмейді.
Dialogue: 0,0:16:36.75,0:16:38.83,Default,,0,0,0,,Кеш болды, Сакура-кун.
Dialogue: 0,0:16:38.83,0:16:41.37,Default,,0,0,0,,Мен сені уже келеді деп ойладым.
Dialogue: 0,0:16:41.63,0:16:43.89,Default,,0,0,0,,Кешіріңіз, Шизуки-чан
Dialogue: 0,0:16:43.89,0:16:45.05,Default,,0,0,0,,Мен оятар екеніне сенімдімін
Dialogue: 0,0:16:45.05,0:16:46.25,Default,,0,0,0,,Токоро-чан күліп тұрса да
Dialogue: 0,0:16:46.25,0:16:49.73,Default,,0,0,0,,Менің ойымша, олар оны фотосезімталдықпен сәйкестендіру үшін өздігінен өзгертті.
Dialogue: 0,0:16:49.73,0:16:51.55,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:16:51.97,0:16:53.89,Default,,0,0,0,,Сакура-кун неге сонша шошып кетті?
Dialogue: 0,0:16:53.89,0:16:55.25,Default,,0,0,0,,Мүмкін мен бірінші рет көрдім
Dialogue: 0,0:16:55.25,0:16:56.65,Default,,0,0,0,,Жақында жағдай өзгерді.
Dialogue: 0,0:16:56.65,0:16:57.51,Default,,0,0,0,,Иә
Dialogue: 0,0:16:57.79,0:17:00.39,Default,,0,0,0,,Ең бастысы, бүгін мені шақырғаныңызға рахмет.
Dialogue: 0,0:17:01.53,0:17:01.89,Default,,0,0,0,,Иә
Dialogue: 0,0:17:01.89,0:17:04.23,Default,,0,0,0,,Қараңызшы, асықпасаңыз, кинотеатр толып қалады.
Dialogue: 0,0:17:04.23,0:17:05.67,Default,,0,0,0,,Кеттік, Сакура-кун
Dialogue: 0,0:17:05.67,0:17:06.33,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.33,0:17:12.80,Default,,0,0,0,,Ауырады, ауырады, ауырады
Dialogue: 0,0:17:12.80,0:17:14.30,Default,,0,0,0,,Жығылған көздері жаншылады
Dialogue: 0,0:17:14.30,0:17:17.66,Default,,0,0,0,,Токоро-чан Токоро-чан
Dialogue: 0,0:17:17.66,0:17:21.20,Default,,0,0,0,,Мұндай тыйым салынған қозғалысты тек Токоро-чан ғана жасай алады.
Dialogue: 0,0:17:23.50,0:17:24.72,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:24.72,0:17:28.14,Default,,0,0,0,,Бет-жүзімді жоғалтып, ешкімге айналуға жақын болдым.
Dialogue: 0,0:17:28.14,0:17:29.60,Default,,0,0,0,,Сакура-кун, жақсысың ба?
Dialogue: 0,0:17:29.86,0:17:30.58,Default,,0,0,0,,Иә, қалай болғанда да
Dialogue: 0,0:17:30.58,0:17:33.36,Default,,0,0,0,,Дәлірек айтсақ, Токоро-чан, ол неге мұнда?
Dialogue: 0,0:17:38.49,0:17:40.17,Default,,0,0,0,,Не айтып тұрсың, Токоро-чан?
Dialogue: 0,0:17:40.17,0:17:41.95,Default,,0,0,0,,Түсінбеген
Dialogue: 0,0:17:41.95,0:17:44.49,Default,,0,0,0,,Менің иісім де Сакура-кун.
Dialogue: 0,0:17:44.49,0:17:45.83,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:17:45.83,0:17:47.09,Default,,0,0,0,,Қалай?
Dialogue: 0,0:17:54.39,0:17:57.33,Default,,0,0,0,,Не болды, ішім ауырып тұр?
Dialogue: 0,0:18:03.12,0:18:06.18,Default,,0,0,0,,Ұйықтап жатқанда мықты бол, Токоро-чан
Dialogue: 0,0:18:07.72,0:18:09.18,Default,,0,0,0,,Мен көп ұйықтаймын.
Dialogue: 0,0:18:09.26,0:18:11.72,Default,,0,0,0,,Бұл не? Мұнда не үшін келдің?
Dialogue: 0,0:18:11.82,0:18:13.00,Default,,0,0,0,,Оян
Dialogue: 0,0:18:13.00,0:18:15.82,Default,,0,0,0,,Оян
Dialogue: 0,0:18:15.82,0:18:19.06,Default,,0,0,0,,Токоро-чанды осылай қалдыру үшін не істеуім керек?
Dialogue: 0,0:18:19.06,0:18:20.78,Default,,0,0,0,,Жарайды, мені қалдыр.
Dialogue: 0,0:18:20.78,0:18:23.04,Default,,0,0,0,,Менің ойымша, бұл қауіпті. Соңғы уақытта көп қиындық болды.
Dialogue: 0,0:18:23.04,0:18:26.96,Default,,0,0,0,,Мен не істерімді білмеймін, бірақ ол тиын салғышқа кірмейді.
Dialogue: 0,0:18:26.96,0:18:30.30,Default,,0,0,0,,Бұлай болса, Токоро-чанның менімен барудан басқа амалы қалмайды.
Dialogue: 0,0:18:30.30,0:18:30.94,Default,,0,0,0,,Иә
Dialogue: 0,0:18:31.04,0:18:33.66,Default,,0,0,0,,Жаңа ғана не айттыңыз?
Dialogue: 0,0:18:33.68,0:18:38.68,Default,,0,0,0,,Сондықтан үшеуміздің кинотеатрға барудан басқа амалымыз жоқ.
Dialogue: 0,0:18:43.23,0:18:45.11,Default,,0,0,0,,Иә Шизуки-чан Кола
Dialogue: 0,0:18:45.11,0:18:46.33,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:55.30,0:18:55.54,Default,,0,0,0,,Осымен
Dialogue: 0,0:18:55.72,0:18:58.00,Default,,0,0,0,,Алдымен Шизуки-чан.
Dialogue: 0,0:18:58.00,0:19:07.48,Default,,0,0,0,,Сакура-кун жақсы
Dialogue: 0,0:19:27.09,0:19:31.71,Default,,0,0,0,,Шизуки-чан
Dialogue: 0,0:19:33.03,0:19:37.16,Default,,0,0,0,,Өзіңізді қаншалықты кеш сезінесіз?
Dialogue: 0,0:19:37.16,0:19:38.88,Default,,0,0,0,,Нақты айтпасаң, болады.
Dialogue: 0,0:19:39.32,0:19:43.42,Default,,0,0,0,,Бұл Токоро-чан жасаған Токоро-чан тақырыбы
Dialogue: 0,0:19:43.42,0:19:44.68,Default,,0,0,0,,Қайдан
Dialogue: 0,0:19:44.68,0:19:48.36,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:19:53.22,0:19:57.10,Default,,0,0,0,,Тыныш жүрейік, Токоро-чан.
Dialogue: 0,0:19:59.62,0:20:02.10,Default,,0,0,0,,Мұны айтқан Сакура-кун.
Dialogue: 0,0:20:02.10,0:20:06.22,Default,,0,0,0,,Сол Токоро-чан
Dialogue: 0,0:20:06.84,0:20:09.18,Default,,0,0,0,,Күндізгі уақыт қорқынышты.
Dialogue: 0,0:20:09.18,0:20:11.14,Default,,0,0,0,,Мен саған оның не екенін айтайын.
Dialogue: 0,0:20:11.14,0:20:12.34,Default,,0,0,0,,Жарайды, сұрамаймын.
Dialogue: 0,0:20:12.34,0:20:14.40,Default,,0,0,0,,Сабато-чан сол жерде.
Dialogue: 0,0:20:20.18,0:20:22.74,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:20:22.74,0:20:24.96,Default,,0,0,0,,Бұл Сабато-чан
Dialogue: 0,0:20:33.44,0:20:34.82,Default,,0,0,0,,Эй, неге?
Dialogue: 0,0:20:34.82,0:20:35.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:35.70,0:20:37.44,Default,,0,0,0,,Футон киіңіз
Dialogue: 0,0:20:38.90,0:20:41.64,Default,,0,0,0,,Мен оны таптым, Сакура-кун.
Dialogue: 0,0:20:41.64,0:20:42.80,Default,,0,0,0,,Шисабато-чан
Dialogue: 0,0:20:44.62,0:20:46.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:46.42,0:20:48.76,Default,,0,0,0,,Сабато-чан да фильмді көруге келді.
Dialogue: 0,0:20:49.16,0:20:50.56,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:53.50,0:20:56.38,Default,,0,0,0,,Сабато-чанның отыратын орны да осы жерде.
Dialogue: 0,0:20:56.38,0:20:58.52,Default,,0,0,0,,Сонша бейқам не айтып тұрсың?
Dialogue: 0,0:20:58.52,0:21:00.94,Default,,0,0,0,,Сабато бүгін мені өлтіруге келді.
Dialogue: 0,0:21:00.94,0:21:02.20,Default,,0,0,0,,Кім
Dialogue: 0,0:21:02.20,0:21:04.52,Default,,0,0,0,,Бұл Сакура-кун болуы керек.
Dialogue: 0,0:21:04.52,0:21:07.30,Default,,0,0,0,,Сондықтан Сабато-чанның бұлай көздегенін қаламаймын.
Dialogue: 0,0:21:07.30,0:21:08.44,Default,,0,0,0,,Мұны ешқашан жасамаңыз
Dialogue: 0,0:21:08.44,0:21:09.74,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:09.74,0:21:11.34,Default,,0,0,0,,Сакура-кун сол лоликон тұғырын ұстап тұр.
Dialogue: 0,0:21:11.66,0:21:13.74,Default,,0,0,0,,Даусыңыз қатты, Сабато-чан
Dialogue: 0,0:21:13.74,0:21:15.80,Default,,0,0,0,,Бұл басқа тұтынушыларға кедергі болады.
Dialogue: 0,0:21:17.00,0:21:18.68,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:21:18.72,0:21:21.10,Default,,0,0,0,,Содан бері сенбі күні
Dialogue: 0,0:21:21.10,0:21:24.62,Default,,0,0,0,,Қараңғы, суық және жайлы көпір астында өмір сүру
Dialogue: 0,0:21:24.62,0:21:28.58,Default,,0,0,0,,Жақында мектеп жанындағы көпірдің астына қоныстанған сенімсіз адам.
Dialogue: 0,0:21:28.58,0:21:30.88,Default,,0,0,0,,Бұл Сабато-чан туралы болды.
Dialogue: 0,0:21:31.28,0:21:33.74,Default,,0,0,0,,Сондықтан мен саған өміріңді беремін.
Dialogue: 0,0:21:33.74,0:21:34.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:34.86,0:21:38.72,Default,,0,0,0,,Ауырғаны сонша, мен кейін ештеңе сезбеймін.
Dialogue: 0,0:21:38.94,0:21:43.31,Default,,0,0,0,,Жоқ, мен қорқыныштан өлемін.
Dialogue: 0,0:21:43.89,0:21:45.83,Default,,0,0,0,,Бұл электронды сиқыр
Dialogue: 0,0:21:45.99,0:21:48.57,Default,,0,0,0,,Олай болса, Сакура-кун
Dialogue: 0,0:21:48.57,0:21:55.99,Default,,0,0,0,,Оян, маған көмектес
Dialogue: 0,0:21:55.99,0:22:01.57,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:22:08.83,0:22:17.83,Default,,0,0,0,,Риппер
Dialogue: 0,0:22:30.08,0:22:30.96,Default,,0,0,0,,Сабато-чан
Dialogue: 0,0:22:33.89,0:22:37.71,Default,,0,0,0,,Иә, Сабато-чанның шаршағанын сезінді.
Dialogue: 0,0:22:37.71,0:22:40.27,Default,,0,0,0,,Мен әйтеуір аман қалдым.
Dialogue: 0,0:22:42.55,0:22:46.41,Default,,0,0,0,,Сакура-кун, сен тигіздің.
Dialogue: 0,0:22:48.34,0:22:50.04,Default,,0,0,0,,Бір минут күте тұрыңыз, Докуро-чан
Dialogue: 0,0:22:50.04,0:22:51.96,Default,,0,0,0,,Өйткені бұл мектеп күші.
Dialogue: 0,0:22:51.96,0:22:54.32,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:22:54.44,0:22:56.90,Default,,0,0,0,,Докуро-чан Кинотеатрда тыныш болыңыз
Dialogue: 0,0:22:56.90,0:22:59.92,Default,,0,0,0,,Қазірдің өзінде кеш, бірақ тұтынушылар кетіп қалды.
Dialogue: 0,0:22:59.92,0:23:02.96,Default,,0,0,0,,Қараңызшы, Мана, кешіріңіз, шынымен кешіріңіз.
Dialogue: 0,0:23:02.96,0:23:05.36,Default,,0,0,0,,Сабато-чан, оянып, сені тік тұрғызғаным үшін кешірім сұраймын.
Dialogue: 0,0:23:05.36,0:23:07.02,Default,,0,0,0,,Өмірге оралсам да
Dialogue: 0,0:23:07.02,0:23:08.56,Default,,0,0,0,,Қалғанының бәрі жақсы.
Dialogue: 0,0:23:08.56,0:23:11.68,Default,,0,0,0,,Бұл Докуро-чан, сондықтан бәрі.
Dialogue: 0,0:23:26.17,0:23:28.59,Default,,0,0,0,,Сайдың бақыты қашады
Dialogue: 0,0:23:28.59,0:23:30.71,Default,,0,0,0,,Докуро-чанға айтпа
Dialogue: 0,0:23:30.71,0:23:33.31,Default,,0,0,0,,Олай болса жеңіл киіммен қыдыруды доғар.
Dialogue: 0,0:23:33.31,0:23:35.27,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:23:36.03,0:23:38.91,Default,,0,0,0,,Жалғыз болу қызықсыз
Dialogue: 0,0:23:40.73,0:23:44.21,Default,,0,0,0,,Сосын мен Сакура-кунға кітап оқып берейін.
Dialogue: 0,0:23:44.25,0:23:45.35,Default,,0,0,0,,Иә? Қандай кітап?
Dialogue: 0,0:23:46.31,0:23:48.25,Default,,0,0,0,,Ал, Фландрия.
Dialogue: 0,0:23:48.25,0:23:50.61,Default,,0,0,0,,Сол соңғы көрініспен танымал
Dialogue: 0,0:23:50.61,0:23:52.41,Default,,0,0,0,,Фламанд иттерін үйрету
Dialogue: 0,0:23:52.41,0:23:53.79,Default,,0,0,0,,Иә? Бір минут күтіңіз.
Dialogue: 0,0:23:53.99,0:23:58.67,Default,,0,0,0,,Ертеде Нерон деген адам мен Патраше деген ит болған.
Dialogue: 0,0:23:59.87,0:24:01.63,Default,,0,0,0,,Нерон айтты
Dialogue: 0,0:24:02.43,0:24:07.04,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:24:07.04,0:24:09.04,Default,,0,0,0,,Бұл шынымен де жай ит пе?
Dialogue: 0,0:24:11.04,0:24:12.34,Default,,0,0,0,,Мастер
Dialogue: 0,0:24:12.44,0:24:14.12,Default,,0,0,0,,Тоқта, Докуро-чан
Dialogue: 0,0:24:14.12,0:24:15.90,Default,,0,0,0,,Өтінемін, ұйықтайыншы
Dialogue: 0,0:24:28.68,0:24:31.46,Default,,0,0,0,,Сакура-кундікі
Dialogue: 0,0:24:31.46,0:24:33.60,Default,,0,0,0,,Барка
Dialogue: 0,0:24:35.10,0:24:41.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
