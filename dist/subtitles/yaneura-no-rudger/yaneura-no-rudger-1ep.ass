Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:25.50,0:00:28.25,Default,,0,0,0,,Мен бұрын көрмеген құстар
Dialogue: 0,0:00:28.87,0:00:30.33,Default,,0,0,0,,Бұрын көрмеген гүлдер
Dialogue: 0,0:00:31.83,0:00:33.62,Default,,0,0,0,,Бұрын-соңды көрмеген жел
Dialogue: 0,0:00:34.95,0:00:36.91,Default,,0,0,0,,Бұрын көрмеген түн
Dialogue: 0,0:00:39.70,0:00:42.41,Default,,0,0,0,,Сіз соншалықты керемет нәрсені көрдіңіз бе?
Dialogue: 0,0:00:45.50,0:00:47.25,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:47.33,0:00:49.45,Default,,0,0,0,,Оу~
Dialogue: 0,0:00:55.45,0:00:57.95,Default,,0,0,0,,Менің атым Раджа
Dialogue: 0,0:00:59.00,0:01:02.20,Default,,0,0,0,,Жыл 3 ай, 3 апта және 3 күннен тұрады.
Dialogue: 0,0:01:04.00,0:01:07.37,Default,,0,0,0,,Жақсы... Жақсы.
Dialogue: 0,0:01:10.95,0:01:13.50,Default,,0,0,0,,Ооо
Dialogue: 0,0:01:14.50,0:01:16.50,Default,,0,0,0,,Мен осында тудым
Dialogue: 0,0:01:19.00,0:01:21.00,Default,,0,0,0,,Аманда елестететін әлемде
Dialogue: 0,0:01:31.20,0:01:36.37,Default,,0,0,0,,(плезиозавр айқайы)
Dialogue: 0,0:01:38.00,0:01:42.04,Default,,0,0,0,,(аспанда ұшқан айдаһардың дыбысы)
Dialogue: 0,0:01:52.08,0:01:54.50,Default,,0,0,0,,(аспанда ұшқан қарлығаштардың дыбысы)
Dialogue: 0,0:01:54.58,0:01:56.20,Default,,0,0,0,,Уау~
Dialogue: 0,0:01:57.08,0:01:58.75,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:00.66,0:02:01.91,Default,,0,0,0,,Уау~
Dialogue: 0,0:02:02.00,0:02:05.91,Default,,0,0,0,,Аманда әрқашан ғажайып әлемді елестетеді
Dialogue: 0,0:02:09.50,0:02:11.41,Default,,0,0,0,,Еңбекқор алып
Dialogue: 0,0:02:14.29,0:02:16.45,Default,,0,0,0,,Әңгімешіл тиін
Dialogue: 0,0:02:17.41,0:02:19.33,Default,,0,0,0,,Теңіз тәрізді кит
Dialogue: 0,0:02:20.04,0:02:22.91,Default,,0,0,0,,Бірақ кейде бұл шынымен қорқынышты.
Dialogue: 0,0:02:23.00,0:02:25.62,Default,,0,0,0,,(Найзағай дыбысы)
Dialogue: 0,0:02:26.50,0:02:28.25,Default,,0,0,0,,А... уф
Dialogue: 0,0:02:29.00,0:02:29.83,Default,,0,0,0,,Уау~
Dialogue: 0,0:02:30.41,0:02:31.75,Default,,0,0,0,,Раджа!
Dialogue: 0,0:02:33.16,0:02:35.04,Default,,0,0,0,,Бұл бала Аманда
Dialogue: 0,0:02:35.12,0:02:38.91,Default,,0,0,0,,Аманда мені елестетті, сондықтан мен дүниеге келдім.
Dialogue: 0,0:02:39.83,0:02:41.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:43.58,0:02:45.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:55.54,0:02:56.95,Default,,0,0,0,,Фаа~
Dialogue: 0,0:03:08.50,0:03:09.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:16.41,0:03:19.50,Default,,0,0,0,,Міне, Аманда екеуміз ант бердік.
Dialogue: 0,0:03:21.83,0:03:23.91,Default,,0,0,0,,Не болса да⸺
Dialogue: 0,0:03:24.00,0:03:25.66,Default,,0,0,0,,Өшпейді
Dialogue: 0,0:03:27.41,0:03:28.70,Default,,0,0,0,,Қорғау
Dialogue: 0,0:03:31.00,0:03:34.25,Default,,0,0,0,,Ешқашан жылама
Dialogue: 0,0:03:39.29,0:03:40.91,Default,,0,0,0,,Сіз де сондасыз ба?
Dialogue: 0,0:03:41.00,0:03:45.04,Default,,0,0,0,,Ешкім көрмейтін мен сияқты сырлас дос
Dialogue: 0,0:03:49.45,0:03:53.58,Default,,0,0,0,,Бала кезімізде үлкендер бізді осылай атайтын.
Dialogue: 0,0:03:55.54,0:03:57.75,Default,,0,0,0,,«Қиял»
Dialogue: 0,0:04:15.16,0:04:20.95,Default,,0,0,0,,Шатырдағы руль
Dialogue: 0,0:04:22.12,0:04:24.54,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,0:04:29.58,0:04:32.91,Default,,0,0,0,,Бір жерде емес пе? Жалғыз күн шуағы бар ел?
Dialogue: 0,0:04:33.00,0:04:36.87,Default,,0,0,0,,Жаңбырдан кейін кемпірқосақ, уәде етілген кемпірқосақ болуы мүмкін
Dialogue: 0,0:04:37.45,0:04:39.37,Default,,0,0,0,,Уәде? Бұл не?
Dialogue: 0,0:04:39.45,0:04:42.37,Default,,0,0,0,,Жаңбыр жауғанда кемпірқосақты көру
Dialogue: 0,0:04:42.45,0:04:44.87,Default,,0,0,0,,Маңызды уәделерді есте сақтай аламын.
Dialogue: 0,0:04:44.95,0:04:46.12,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:46.20,0:04:47.54,Default,,0,0,0,,Джулия-чан
Dialogue: 0,0:04:47.62,0:04:49.62,Default,,0,0,0,,Бұл ана! Мама
Dialogue: 0,0:04:51.83,0:04:52.62,Default,,0,0,0,,Ахаха...
Dialogue: 0,0:04:53.20,0:04:56.12,Default,,0,0,0,,Менің ата-анам кемпірқосақтан гөрі, полярлық сәулені жақсы көреді.
Dialogue: 0,0:04:56.70,0:04:58.45,Default,,0,0,0,,Әкем де солай.
Dialogue: 0,0:04:58.54,0:05:00.12,Default,,0,0,0,,Жазғы демалыста балетпен айналысасыз ба?
Dialogue: 0,0:05:00.20,0:05:02.29,Default,,0,0,0,,Иә, бірақ бұл басқаша.
Dialogue: 0,0:05:02.37,0:05:05.70,Default,,0,0,0,,Тыңдаңыз! Менің әкем қорқынышты.
Dialogue: 0,0:05:05.79,0:05:07.87,Default,,0,0,0,,Күні кеше, таңертең тұрған бойда
Dialogue: 0,0:05:07.95,0:05:11.87,Default,,0,0,0,,«Бүгін қандай күн? Бұл маңызды күн болуы керек».
Dialogue: 0,0:05:11.95,0:05:15.62,Default,,0,0,0,,«Мүмкін, бұл балеттік концерт шығар».
Dialogue: 0,0:05:15.70,0:05:18.12,Default,,0,0,0,,Сол күні менің туған күнім болатын.
Dialogue: 0,0:05:18.20,0:05:19.79,Default,,0,0,0,,Сене аласыз ба?
Dialogue: 0,0:05:20.70,0:05:24.75,Default,,0,0,0,,Неліктен үлкендер көптеген маңызды нәрселерді ұмытады?
Dialogue: 0,0:05:24.83,0:05:26.87,Default,,0,0,0,,Юлия, уақыт келді.
Dialogue: 0,0:05:26.95,0:05:28.87,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:05:28.95,0:05:30.62,Default,,0,0,0,,Джулия
Dialogue: 0,0:05:31.50,0:05:34.62,Default,,0,0,0,,Асығыңыз, асығыңыз, мен сабаққа кешігіп қаламын.
Dialogue: 0,0:05:36.45,0:05:38.66,Default,,0,0,0,,- (Қыз) Өтінемін! - (Бала) Сәлем.
Dialogue: 0,0:05:39.20,0:05:41.20,Default,,0,0,0,,- (1-дос) Дұрыс. - (Джонның әпкесі) Дұрыс.
Dialogue: 0,0:05:41.29,0:05:42.45,Default,,0,0,0,,Онда отырыңыз
Dialogue: 0,0:05:44.41,0:05:47.50,Default,,0,0,0,,Алдымен, қош келдіңіздер деп айтайын.
Dialogue: 0,0:05:49.41,0:05:50.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:54.58,0:05:56.12,Default,,0,0,0,,А? иә?
Dialogue: 0,0:05:56.20,0:05:58.12,Default,,0,0,0,,«Монстр энциклопедиясы»
Dialogue: 0,0:05:59.04,0:06:00.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:02.33,0:06:06.62,Default,,0,0,0,,Құбыжықтар барлық жерде, хаха...
Dialogue: 0,0:06:19.04,0:06:20.45,Default,,0,0,0,,Қанша рет айтсаң да түсінбейтін ақымақтар әрқашан болады.
Dialogue: 0,0:06:21.12,0:06:22.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:25.00,0:06:25.95,Default,,0,0,0,,A~
Dialogue: 0,0:06:30.83,0:06:32.16,Default,,0,0,0,,(Болады)
Dialogue: 0,0:06:48.87,0:06:50.37,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:06:54.37,0:06:57.04,Default,,0,0,0,,Иә, бүгін? Иә «Жабық сатылым 50% жеңілдік»
Dialogue: 0,0:06:57.04,0:06:57.58,Default,,0,0,0,,«Жабылатын сатылым 50% жеңілдік»
Dialogue: 0,0:06:58.16,0:06:59.20,Default,,0,0,0,,17.00.
Dialogue: 0,0:06:59.29,0:07:01.25,Default,,0,0,0,,- (Голди) Аманда ханшайым қош келдіңіз - мен үйдемін
Dialogue: 0,0:07:01.33,0:07:03.08,Default,,0,0,0,,Біз сізден міндетті түрде сұраймыз.
Dialogue: 0,0:07:04.29,0:07:05.75,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:07:05.83,0:07:07.70,Default,,0,0,0,,Голди мен өттім!
Dialogue: 0,0:07:07.79,0:07:09.16,Default,,0,0,0,,Сұхбаттасуға келіңіз.
Dialogue: 0,0:07:09.25,0:07:13.08,Default,,0,0,0,,Құттықтаймын, бұл жаңа өмірдің басы.
Dialogue: 0,0:07:13.87,0:07:17.62,Default,,0,0,0,,Мен тұрмысқа шыққаннан бері кітап дүкенінде ғана болған соң, жарайды ма деп ойлаймын.
Dialogue: 0,0:07:17.70,0:07:19.04,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:19.12,0:07:21.95,Default,,0,0,0,,Бұл Лиззи, Shuffle Up кітап дүкенінің атақты менеджері.
Dialogue: 0,0:07:22.04,0:07:23.37,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:23.45,0:07:24.70,Default,,0,0,0,,Сондықтан ол орта мектеп оқулықтары мен жұмыс дәптерлерін қалайтынын айтты.
Dialogue: 0,0:07:26.58,0:07:28.41,Default,,0,0,0,,Бүгін соңғы күн.
Dialogue: 0,0:07:28.50,0:07:29.20,Default,,0,0,0,,Лиззи
Dialogue: 0,0:07:29.79,0:07:33.75,Default,,0,0,0,,Осы уақытқа дейін жалғыз өзіңіз қиналғаныңызға сенімдімін, бірақ мен сізді жақсы көремін.
Dialogue: 0,0:07:33.83,0:07:35.33,Default,,0,0,0,,Рахмет саған Голди
Dialogue: 0,0:07:36.33,0:07:40.25,Default,,0,0,0,,А-а... Жарайды, мен сені қолдап жатқанда, бүгін кеш.
Dialogue: 0,0:07:40.33,0:07:42.66,Default,,0,0,0,,Аманда Жарайсың! Маған қалдырыңыз.
Dialogue: 0,0:07:42.75,0:07:43.79,Default,,0,0,0,,Көмек! (көлік сигналы)
Dialogue: 0,0:07:43.79,0:07:44.75,Default,,0,0,0,,(Автокөлік сигналы)
Dialogue: 0,0:07:43.87,0:07:44.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:47.33,0:07:49.70,Default,,0,0,0,,- (Лиззи) Ах! - (Голди) А...
Dialogue: 0,0:07:51.00,0:07:53.04,Default,,0,0,0,,Енді сөйлесе аламыз ба?
Dialogue: 0,0:07:54.16,0:07:55.16,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:55.25,0:07:57.62,Default,,0,0,0,,Фу ха ха ха
Dialogue: 0,0:07:57.70,0:08:00.91,Default,,0,0,0,,Тест! Сынақ! Микрофонды тексеру Сіз мені естисіз бе, Хьюстон?
Dialogue: 0,0:08:04.62,0:08:07.45,Default,,0,0,0,,Әй, неге мектепте сөйлесуге болмайды?
Dialogue: 0,0:08:07.54,0:08:11.54,Default,,0,0,0,,Мен сені бүгін ғана осында әкелдім, өйткені Раджа талап етті.
Dialogue: 0,0:08:13.04,0:08:15.45,Default,,0,0,0,,Раджаны мен ғана көре аламын.
Dialogue: 0,0:08:15.54,0:08:19.04,Default,,0,0,0,,Адамдар өздері көрмейтін адаммен сөйлессе таң қалады, солай ма?
Dialogue: 0,0:08:19.54,0:08:23.54,Default,,0,0,0,,Мені көрсең, ең жақсы сәлемдесуді шешемін.
Dialogue: 0,0:08:23.62,0:08:27.00,Default,,0,0,0,,«Йо-эй, эй, мен Раджамын!»
Dialogue: 0,0:08:24.12,0:08:27.79,Default,,0,0,0,,«Құрметті Раджа: бұл қорапты ашпа».
Dialogue: 0,0:08:27.08,0:08:30.25,Default,,0,0,0,,Иә! Сонымен, сіз кездесу жоқ дейсіз бе?
Dialogue: 0,0:08:30.33,0:08:32.41,Default,,0,0,0,,Лиззи де қиналып жатыр.
Dialogue: 0,0:08:32.50,0:08:35.41,Default,,0,0,0,,Мен Аманды жалғыз өсіріп жатырмын!
Dialogue: 0,0:08:38.33,0:08:40.33,Default,,0,0,0,,(Көліктің кетіп бара жатқан дыбысы)
Dialogue: 0,0:08:45.87,0:08:49.91,Default,,0,0,0,,(♪Музыка)
Dialogue: 0,0:08:50.54,0:08:54.00,Default,,0,0,0,,Раджа, мен бүгін таңғажайып шытырман оқиғаны ойлап таптым.
Dialogue: 0,0:08:55.54,0:08:57.62,Default,,0,0,0,,Аспаннан метеорит түсетін жер?
Dialogue: 0,0:08:58.20,0:08:59.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:59.12,0:09:02.29,Default,,0,0,0,,Ұзын пияз апай сізге шабуыл жасайтын сияқты емес, солай ма?
Dialogue: 0,0:09:02.37,0:09:04.12,Default,,0,0,0,,Бұл жақсы болмады
Dialogue: 0,0:09:04.20,0:09:05.33,Default,,0,0,0,,Ой…
Dialogue: 0,0:09:05.41,0:09:08.41,Default,,0,0,0,,Шұжық қосылған қазанда қайнатылады.
Dialogue: 0,0:09:08.50,0:09:10.50,Default,,0,0,0,,Маған бұл ұнамады.
Dialogue: 0,0:09:11.25,0:09:13.50,Default,,0,0,0,,Білесің бе, қанша елестетсең де...
Dialogue: 0,0:09:13.58,0:09:16.41,Default,,0,0,0,,Сіз сорпа болғыңыз келмейді! Дұрыс па?
Dialogue: 0,0:09:16.50,0:09:18.08,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:09:18.16,0:09:18.95,Default,,0,0,0,,Уау~ Аа...
Dialogue: 0,0:09:19.04,0:09:22.08,Default,,0,0,0,,(мускустың өгізі үреді)
Dialogue: 0,0:09:23.66,0:09:25.58,Default,,0,0,0,,- Уау! - (Реджер) Уау!
Dialogue: 0,0:09:25.66,0:09:26.87,Default,,0,0,0,,Бүгін жақсы көрінеді
Dialogue: 0,0:09:27.45,0:09:30.00,Default,,0,0,0,,Қасиетті шатырдың Раджа анты!
Dialogue: 0,0:09:31.20,0:09:33.75,Default,,0,0,0,,Жоғалып қалмау, қорғау
Dialogue: 0,0:09:33.83,0:09:35.75,Default,,0,0,0,,Ешқашан жылама
Dialogue: 0,0:09:36.95,0:09:38.25,Default,,0,0,0,,Кеттік, Раджа.
Dialogue: 0,0:09:38.33,0:09:41.20,Default,,0,0,0,,(♪Музыка)
Dialogue: 0,0:09:48.04,0:09:50.08,Default,,0,0,0,,Жүр! Ушимару~
Dialogue: 0,0:09:50.16,0:09:52.70,Default,,0,0,0,,Иә! Эй, тоқта!
Dialogue: 0,0:09:53.37,0:09:55.70,Default,,0,0,0,,(Музыка артқа бұрылады және тоқтайды)
Dialogue: 0,0:09:59.04,0:10:00.75,Default,,0,0,0,,Бұл не, Ушимару?
Dialogue: 0,0:10:00.83,0:10:03.00,Default,,0,0,0,,- (Раджа) Сиыр ғой, солай ма? - Иә...
Dialogue: 0,0:10:03.08,0:10:06.08,Default,,0,0,0,,Сізде шынымен нөлдік қиял бар.
Dialogue: 0,0:10:07.95,0:10:10.62,Default,,0,0,0,,А... кешіріңіз, кешіріңіз, әзілдеп тұрмын.
Dialogue: 0,0:10:10.70,0:10:13.83,Default,,0,0,0,,Сонымен, Аманда ханшайым не киер еді?
Dialogue: 0,0:10:15.66,0:10:16.75,Default,,0,0,0,,(♪Музыка түйіндемелері)
Dialogue: 0,0:10:16.83,0:10:19.66,Default,,0,0,0,,Жүгіру! Жасыл Лагер!
Dialogue: 0,0:10:19.75,0:10:22.41,Default,,0,0,0,,Бұл ананың сырасы!
Dialogue: 0,0:10:22.50,0:10:24.25,Default,,0,0,0,,Киахо
Dialogue: 0,0:10:30.41,0:10:31.66,Default,,0,0,0,,Аманда?
Dialogue: 0,0:10:36.91,0:10:38.91,Default,,0,0,0,,Ал... (♪Шатырдан музыка)
Dialogue: 0,0:10:38.91,0:10:41.45,Default,,0,0,0,,(♪Шатырдағы музыка)
Dialogue: 0,0:10:39.00,0:10:41.45,Default,,0,0,0,,Аманда қазірдің өзінде
Dialogue: 0,0:10:43.33,0:10:44.16,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:10:56.04,0:10:57.66,Default,,0,0,0,,Сәлем Аманда
Dialogue: 0,0:10:58.25,0:11:01.33,Default,,0,0,0,,Келесі жолы мен қабырға немесе есік жасаймын.
Dialogue: 0,0:11:01.41,0:11:03.87,Default,,0,0,0,,Сіз өтіп бара алатыныңызды елестете аласыз ба?
Dialogue: 0,0:11:03.95,0:11:06.16,Default,,0,0,0,,Тоқта! Бұл елес сияқты
Dialogue: 0,0:11:06.25,0:11:10.45,Default,,0,0,0,,Өйткені өткен күні мен шкафта екі сағат болдым.
Dialogue: 0,0:11:10.54,0:11:13.08,Default,,0,0,0,,Аманда есікті жауып кетіп қалады.
Dialogue: 0,0:11:13.16,0:11:16.70,Default,,0,0,0,,Жарайды, бұл Раджаның бөлмесі сияқты.
Dialogue: 0,0:11:16.79,0:11:19.62,Default,,0,0,0,,Қайтып келсем, көп жерлерге бара аламын.
Dialogue: 0,0:11:19.70,0:11:21.75,Default,,0,0,0,,Аманданың қасында болғаны керемет
Dialogue: 0,0:11:21.83,0:11:25.25,Default,,0,0,0,,Бірақ мен кейде басқа балалармен ойнаймын.
Dialogue: 0,0:11:25.33,0:11:28.66,Default,,0,0,0,,А...әрине мен көрмеймін, сондықтан сенімен ойнай алмаймын.
Dialogue: 0,0:11:29.25,0:11:31.25,Default,,0,0,0,,Қарап тұрудың өзі қызық
Dialogue: 0,0:11:31.33,0:11:32.29,Default,,0,0,0,,Бұл!
Dialogue: 0,0:11:33.25,0:11:35.45,Default,,0,0,0,,Күн суық, не болып жатыр?
Dialogue: 0,0:11:37.87,0:11:39.16,Default,,0,0,0,,Уау~
Dialogue: 0,0:11:39.91,0:11:43.29,Default,,0,0,0,,(Yeti қадамдары)
Dialogue: 0,0:11:44.41,0:11:46.62,Default,,0,0,0,,Раджа, мынаны қара.
Dialogue: 0,0:11:51.04,0:11:52.33,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:52.41,0:11:54.62,Default,,0,0,0,,Шырша емес!
Dialogue: 0,0:11:57.00,0:11:58.70,Default,,0,0,0,,(Гномдардың айқайы)
Dialogue: 0,0:11:58.79,0:12:01.95,Default,,0,0,0,,(Гномдардың дыбысы)
Dialogue: 0,0:12:04.37,0:12:05.79,Default,,0,0,0,,Әй, Аманда! Біз бір-бірімізге соқтығысамыз.
Dialogue: 0,0:12:07.79,0:12:10.04,Default,,0,0,0,,Уау~ Уау~
Dialogue: 0,0:12:13.37,0:12:14.12,Default,,0,0,0,,Уау~
Dialogue: 0,0:12:16.54,0:12:17.37,Default,,0,0,0,,Раджа!
Dialogue: 0,0:12:17.45,0:12:19.16,Default,,0,0,0,,А... Аманда!
Dialogue: 0,0:12:20.20,0:12:22.54,Default,,0,0,0,,Раджа!
Dialogue: 0,0:12:29.20,0:12:30.62,Default,,0,0,0,,(Музыка тоқтайды)
Dialogue: 0,0:12:30.70,0:12:33.33,Default,,0,0,0,,Аманда араластырыңыз!
Dialogue: 0,0:12:33.41,0:12:34.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:35.45,0:12:37.08,Default,,0,0,0,,Мен үйдемін, анашым.
Dialogue: 0,0:12:37.16,0:12:40.20,Default,,0,0,0,,Сіз «Бұл не?» Деп сұрайсыз ба?
Dialogue: 0,0:12:40.95,0:12:42.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:44.95,0:12:47.62,Default,,0,0,0,,Мама, мен не айтайын...
Dialogue: 0,0:12:47.70,0:12:51.12,Default,,0,0,0,,Кім деп айту дөрекі емес пе?
Dialogue: 0,0:12:51.70,0:12:52.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:55.45,0:12:58.45,Default,,0,0,0,,Аманда, бірінші қабаттағы қолшатырға қолшатырыңызды қойыңыз.
Dialogue: 0,0:12:58.54,0:13:00.20,Default,,0,0,0,,Түсінгенше мен неше рет айтуым керек?
Dialogue: 0,0:13:00.79,0:13:04.16,Default,,0,0,0,,Менің киімім де, еденім де су емес.
Dialogue: 0,0:13:04.95,0:13:07.33,Default,,0,0,0,,Мүмкін мұны Раджа жасаған шығар.
Dialogue: 0,0:13:07.41,0:13:08.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:08.37,0:13:11.45,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:11.54,0:13:13.95,Default,,0,0,0,,Мен қашан үйренемін?
Dialogue: 0,0:13:14.04,0:13:16.58,Default,,0,0,0,,Мектепке барғанда үйрен
Dialogue: 0,0:13:16.66,0:13:19.79,Default,,0,0,0,,Сіздің айтып тұрғаныңыз осы емес пе?
Dialogue: 0,0:13:18.45,0:13:22.58,Default,,0,0,0,,(есік қоңырауы)
Dialogue: 0,0:13:22.87,0:13:24.08,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:13:25.37,0:13:26.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:26.79,0:13:28.83,Default,,0,0,0,,Әй, ана, еден дымқыл.
Dialogue: 0,0:13:32.87,0:13:35.83,Default,,0,0,0,,Кейде мен саған шынымен сене алмаймын.
Dialogue: 0,0:13:40.33,0:13:42.87,Default,,0,0,0,,Мен саған жылы какао дайындаймын, түс.
Dialogue: 0,0:13:42.95,0:13:44.58,Default,,0,0,0,,Раджа Моне
Dialogue: 0,0:13:44.66,0:13:45.91,Default,,0,0,0,,Иә
Dialogue: 0,0:13:46.75,0:13:48.58,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:13:53.45,0:13:56.20,Default,,0,0,0,,Кешіріңіз, дүкен жабық.
Dialogue: 0,0:13:56.29,0:13:59.87,Default,,0,0,0,,Жоқ, жоқ, мен бұл саланы зерттеп жүрмін.
Dialogue: 0,0:14:01.37,0:14:04.62,Default,,0,0,0,,Ханым.... Араластыру
Dialogue: 0,0:14:04.70,0:14:07.87,Default,,0,0,0,,Тергеу? Бұл не туралы?
Dialogue: 0,0:14:07.95,0:14:10.12,Default,,0,0,0,,Бүгінгі әлем туралы
Dialogue: 0,0:14:10.20,0:14:13.12,Default,,0,0,0,,Ал бүгінгі балалар туралы.
Dialogue: 0,0:14:14.41,0:14:17.37,Default,,0,0,0,,Сізде дәлелдейтін нәрсе бар ма?
Dialogue: 0,0:14:17.45,0:14:18.62,Default,,0,0,0,,Дәлелдеу?
Dialogue: 0,0:14:18.70,0:14:21.37,Default,,0,0,0,,Иә, сіз кімсіз?
Dialogue: 0,0:14:22.12,0:14:25.62,Default,,0,0,0,,Бұл Бантинг, Мистер Бантинг.
Dialogue: 0,0:14:26.29,0:14:29.20,Default,,0,0,0,,Бұл кішкентай құстың атымен бірдей, білесің.
Dialogue: 0,0:14:29.70,0:14:34.37,Default,,0,0,0,,Бұл сүйкімді құстарды осы жерден жиі көруге болады...
Dialogue: 0,0:14:34.95,0:14:36.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:38.75,0:14:40.12,Default,,0,0,0,,О
Dialogue: 0,0:14:44.41,0:14:45.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:45.66,0:14:49.00,Default,,0,0,0,,Жаңбырда Айтуға қиын, бірақ менде бүгін көп жоспар бар.
Dialogue: 0,0:14:49.08,0:14:51.25,Default,,0,0,0,,Қаласаңыз, қағазды қалдырыңыз.
Dialogue: 0,0:14:51.33,0:14:52.66,Default,,0,0,0,,Мен сізге кейінірек жіберемін.
Dialogue: 0,0:14:52.75,0:14:56.25,Default,,0,0,0,,Жоқ, жоқ, мен біраз зерттеу жасадым.
Dialogue: 0,0:14:56.83,0:14:57.79,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:14:59.75,0:15:04.12,Default,,0,0,0,,Ескі дүние өліп барады, жаңа дүние әлі туған жоқ.
Dialogue: 0,0:15:04.20,0:15:06.25,Default,,0,0,0,,Сол жарық пен қараңғылықтың арасы...
Dialogue: 0,0:15:08.29,0:15:10.50,Default,,0,0,0,,Не дүниеге келді?
Dialogue: 0,0:15:10.58,0:15:11.83,Default,,0,0,0,,Мм...
Dialogue: 0,0:15:12.91,0:15:15.75,Default,,0,0,0,,Кешіріңіз, кітапты менің күйеуім таңдады.
Dialogue: 0,0:15:16.62,0:15:20.00,Default,,0,0,0,,Ах, кешіріңіз, бәрібір...
Dialogue: 0,0:15:22.41,0:15:26.04,Default,,0,0,0,,Бұл кітап дүкенінің иісі өте жақсы.
Dialogue: 0,0:15:31.12,0:15:32.54,Default,,0,0,0,,(құлыпты жабу дыбысы)
Dialogue: 0,0:15:32.62,0:15:35.83,Default,,0,0,0,,Балаларды тергейтін қызық іс.
Dialogue: 0,0:15:36.62,0:15:38.83,Default,,0,0,0,,Ол бала да басқаша болды.
Dialogue: 0,0:15:38.91,0:15:40.25,Default,,0,0,0,,Мына бала?
Dialogue: 0,0:15:40.33,0:15:41.87,Default,,0,0,0,,Менің қасымдағы қыз
Dialogue: 0,0:15:41.95,0:15:43.66,Default,,0,0,0,,Қай қыз?
Dialogue: 0,0:15:44.83,0:15:47.33,Default,,0,0,0,,Раджа Менің не ойлап тұрғанымды білесің бе?
Dialogue: 0,0:15:47.95,0:15:51.50,Default,,0,0,0,,Көрінбейтін достарым бар жалғыз мен емес...
Dialogue: 0,0:16:01.25,0:16:04.41,Default,,0,0,0,,Иә, дұрыс. Сұхбаттан бастайық.
Dialogue: 0,0:16:05.12,0:16:09.04,Default,,0,0,0,,Намаз оқысаң көктен нан түспейді.
Dialogue: 0,0:16:10.20,0:16:12.75,Default,,0,0,0,,Аманда? Мен жақсымын.
Dialogue: 0,0:16:13.79,0:16:16.58,Default,,0,0,0,,Дәл қазір мен Раджа есімді қызбен ойнап жүрмін.
Dialogue: 0,0:16:16.66,0:16:19.54,Default,,0,0,0,,Жоқ, жоқ, бұл Роджер емес, бұл Раджа!
Dialogue: 0,0:16:20.20,0:16:22.04,Default,,0,0,0,,La ja a!
Dialogue: 0,0:16:22.12,0:16:26.20,Default,,0,0,0,,Егер сіз жаңа достар туралы айтып жатсаңыз, бұл сөзсіз дұрыс.
Dialogue: 0,0:16:27.12,0:16:29.58,Default,,0,0,0,,Ей, анашым, күлмеңіз.
Dialogue: 0,0:16:29.66,0:16:31.83,Default,,0,0,0,,Бұл нақты емес. (Аманданың дауысы)
Dialogue: 0,0:16:31.83,0:16:36.04,Default,,0,0,0,,(Аманданың сөйлейтін дауысы)
Dialogue: 0,0:16:31.91,0:16:36.04,Default,,0,0,0,,Бұл тек Аманда ғана көре алатын қиял. Бұл өтірікші дос.
Dialogue: 0,0:16:36.12,0:16:38.29,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:16:38.37,0:16:40.29,Default,,0,0,0,,Сондықтан күлме!
Dialogue: 0,0:16:41.08,0:16:43.54,Default,,0,0,0,,Аманда оны шынымен көріп тұрған сияқты...
Dialogue: 0,0:16:43.62,0:16:45.54,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:16:45.62,0:16:48.66,Default,,0,0,0,,Өткендегі бірдеңені есіме түсірдім.
Dialogue: 0,0:16:48.75,0:16:50.20,Default,,0,0,0,,Баяғыда?
Dialogue: 0,0:16:50.75,0:16:52.29,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:16:52.87,0:16:55.20,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:16:55.83,0:16:59.04,Default,,0,0,0,,Дұрыс, тоңазытқыш, тоңазытқыш.
Dialogue: 0,0:16:59.70,0:17:01.87,Default,,0,0,0,,Оның есімі «Рейзуко»
Dialogue: 0,0:17:02.62,0:17:05.87,Default,,0,0,0,,Тоңазытқыш? Сіз не туралы айтып отырсыз?
Dialogue: 0,0:17:05.95,0:17:09.29,Default,,0,0,0,,Бұл сізді қатты жек көретін жыландардан құтылуға көмектеседі деп айтылады.
Dialogue: 0,0:17:09.37,0:17:13.45,Default,,0,0,0,,Біз барлық жерге бірге барамыз. Менің ойымша, бұл ит болды.
Dialogue: 0,0:17:13.54,0:17:14.50,Default,,0,0,0,,Ит?
Dialogue: 0,0:17:14.58,0:17:18.00,Default,,0,0,0,,Иә, келесі жолы ағаңнан сұрау керек.
Dialogue: 0,0:17:18.08,0:17:19.83,Default,,0,0,0,,Рейзуконың кесірінен мен қатты қиналдым...
Dialogue: 0,0:17:19.91,0:17:21.37,Default,,0,0,0,,Анашым! Пеш!
Dialogue: 0,0:17:21.45,0:17:23.50,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:17:25.12,0:17:26.75,Default,,0,0,0,,Әй, пеш!
Dialogue: 0,0:17:26.83,0:17:30.41,Default,,0,0,0,,Эй Аманда, пештің мәрмәрді жемейтініне көз жеткізіңіз.
Dialogue: 0,0:17:30.50,0:17:32.33,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:17:34.20,0:17:35.83,Default,,0,0,0,,«Рейзуко»...
Dialogue: 0,0:17:36.87,0:17:37.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:37.83,0:17:39.00,Default,,0,0,0,,Жұмыртқалар мен ұмытып қалдым
Dialogue: 0,0:17:39.08,0:17:42.75,Default,,0,0,0,,Сәлем Лиззи, не болды? Сәлем!
Dialogue: 0,0:17:42.83,0:17:45.58,Default,,0,0,0,,- (Лиззи) Голди Танысқаныма қуаныштымын - (Голди) Сәттілік!
Dialogue: 0,0:17:53.70,0:17:56.04,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:17:56.12,0:17:57.25,Default,,0,0,0,,Маадаё
Dialogue: 0,0:17:59.58,0:18:01.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:01.95,0:18:06.00,Default,,0,0,0,,Мен үстелдің астына тығыламын, лорд Раджа сол жаққа барады.
Dialogue: 0,0:18:06.08,0:18:07.37,Default,,0,0,0,,Мен де?
Dialogue: 0,0:18:07.45,0:18:10.00,Default,,0,0,0,,Мені таба алмайсың деп ойлаймын...
Dialogue: 0,0:18:10.08,0:18:12.00,Default,,0,0,0,,Жасырынсақ, біргеміз!
Dialogue: 0,0:18:12.62,0:18:14.70,Default,,0,0,0,,Раджа! Анам үйге келгенше
Dialogue: 0,0:18:14.79,0:18:17.25,Default,,0,0,0,,Ұстаңыз, майор.
Dialogue: 0,0:18:17.33,0:18:19.45,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:18:19.54,0:18:21.25,Default,,0,0,0,,Маадаё
Dialogue: 0,0:18:25.62,0:18:26.54,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:18:27.91,0:18:29.75,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:30.33,0:18:32.75,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:18:36.33,0:18:38.87,Default,,0,0,0,,Ах... ой
Dialogue: 0,0:18:40.66,0:18:43.70,Default,,0,0,0,,Аманда Аманда
Dialogue: 0,0:18:43.79,0:18:45.29,Default,,0,0,0,,Сіз не елестетесіз?
Dialogue: 0,0:18:45.37,0:18:47.79,Default,,0,0,0,,Барабан ырғағымен бірге қозғалып, ол жыртқыш жануардың тырнақ іздерінің пішінін алды.
Dialogue: 0,0:18:47.87,0:18:50.66,Default,,0,0,0,,Егер сіз асықпасаңыз, олар сізді табады.
Dialogue: 0,0:18:51.66,0:18:54.58,Default,,0,0,0,,Мен сонда жасырынамын.
Dialogue: 0,0:18:54.66,0:18:55.66,Default,,0,0,0,,А... иә
Dialogue: 0,0:18:57.62,0:18:58.66,Default,,0,0,0,,(тоқтың өшіп жатқан дыбысы)
Dialogue: 0,0:19:00.37,0:19:04.33,Default,,0,0,0,,Жарықты өшіру жақсы идея, майор.
Dialogue: 0,0:19:04.83,0:19:06.91,Default,,0,0,0,,Мен оны жойған жоқпын...
Dialogue: 0,0:19:07.00,0:19:08.29,Default,,0,0,0,,Не?
Dialogue: 0,0:19:08.37,0:19:09.91,Default,,0,0,0,,
Dialogue: 0,0:19:11.75,0:19:13.20,Default,,0,0,0,,
Dialogue: 0,0:19:13.29,0:19:14.66,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:19:16.66,0:19:18.29,Default,,0,0,0,,
Dialogue: 0,0:19:23.70,0:19:25.00,Default,,0,0,0,,
Dialogue: 0,0:19:25.08,0:19:26.75,Default,,0,0,0,,Амандер!
Dialogue: 0,0:19:27.58,0:19:28.37,Default,,0,0,0,,Раджа?
Dialogue: 0,0:19:28.45,0:19:31.66,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:19:33.75,0:19:36.37,Default,,0,0,0,,Кя!
Dialogue: 0,0:19:42.91,0:19:44.70,Default,,0,0,0,,Аманда ханшайымға қараңыз!
Dialogue: 0,0:19:44.79,0:19:47.29,Default,,0,0,0,,мен шынымен құрмет сезіндім.
Dialogue: 0,0:19:51.41,0:19:53.20,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:19:53.29,0:19:58.20,Default,,0,0,0,,Бұзылған жоқ, жөндеуге ақша төлеуге қарсы емеспін.
Dialogue: 0,0:19:58.29,0:20:02.25,Default,,0,0,0,,Бұл жер де біршама ескі, сондықтан ол жердің тоз-тозы шыға бастаса, таң қалмас еді.
Dialogue: 0,0:20:02.33,0:20:04.70,Default,,0,0,0,,- Бұл бала кінәлі - (Лиззи) Әлгі бала?
Dialogue: 0,0:20:06.29,0:20:10.20,Default,,0,0,0,,Қараңғы түсіп, найзағай жарқылдап, бір қыз бар!
Dialogue: 0,0:20:10.29,0:20:13.20,Default,,0,0,0,,- (Голди) Электр қуатының үзілуі шынымен болды - болды!
Dialogue: 0,0:20:13.29,0:20:15.37,Default,,0,0,0,,Бүгін келген ұзын шашты қыз
Dialogue: 0,0:20:15.45,0:20:19.16,Default,,0,0,0,,Ол шынымен қорқынышты кейіппен Раджаны ұстап алып, оны алып кетпек болды.
Dialogue: 0,0:20:23.54,0:20:25.75,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:20:25.83,0:20:27.29,Default,,0,0,0,,Аманда
Dialogue: 0,0:20:27.79,0:20:31.79,Default,,0,0,0,,Аманда кейде бір нәрсені артық ойлайды.
Dialogue: 0,0:20:31.87,0:20:33.20,Default,,0,0,0,,Менің басымда
Dialogue: 0,0:20:33.29,0:20:37.70,Default,,0,0,0,,Жоқ! Бұл менің басымда емес еді! Ол шынымен де сонда болды.
Dialogue: 0,0:20:38.20,0:20:42.20,Default,,0,0,0,,Кейде мұндай балаларды өзім ойлап табамын.
Dialogue: 0,0:20:42.29,0:20:43.79,Default,,0,0,0,,Ана...
Dialogue: 0,0:20:44.79,0:20:47.54,Default,,0,0,0,,Бүгін үйге келгендеріңізге рахмет.
Dialogue: 0,0:20:47.62,0:20:48.83,Default,,0,0,0,,Олардың бірі… Кира ғой, иә?
Dialogue: 0,0:20:49.45,0:20:50.66,Default,,0,0,0,,Иә
Dialogue: 0,0:20:51.87,0:20:54.08,Default,,0,0,0,,Кездескенше, Аманда ханшайым
Dialogue: 0,0:20:54.16,0:20:58.62,Default,,0,0,0,,Анашым, сеніңіз, бұл рас. Бүгін келген қыз ража...
Dialogue: 0,0:20:58.70,0:21:01.87,Default,,0,0,0,,Уайымдамаңыз! Ондай бала жоқ.
Dialogue: 0,0:21:03.50,0:21:04.75,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:21:04.83,0:21:07.95,Default,,0,0,0,,Бұл жерде немқұрайлылық танытпайтын баланы әбігерге салма.
Dialogue: 0,0:21:09.29,0:21:13.08,Default,,0,0,0,,Мен шаршадым, бүгін қиын күн болды.
Dialogue: 0,0:21:13.16,0:21:16.16,Default,,0,0,0,,Жұмыс сұхбаты жақсы болмады.
Dialogue: 0,0:21:16.25,0:21:17.45,Default,,0,0,0,,Егер бұл менің әкем болса!
Dialogue: 0,0:21:17.54,0:21:20.95,Default,,0,0,0,,Әкем болса жақсы болар еді.
Dialogue: 0,0:21:22.08,0:21:24.45,Default,,0,0,0,,Әкем маған сенер еді!
Dialogue: 0,0:21:35.70,0:21:36.87,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:21:36.95,0:21:39.08,Default,,0,0,0,,Өте жаман! Мен сене алар емеспін!
Dialogue: 0,0:21:39.16,0:21:42.12,Default,,0,0,0,,Мен өмірімде бірінші рет қорқамын.
Dialogue: 0,0:21:42.70,0:21:46.12,Default,,0,0,0,,Сол шірік иіс, мұздай салқын...
Dialogue: 0,0:21:46.20,0:21:49.41,Default,,0,0,0,,Мен анамның қиналғанын білемін.
Dialogue: 0,0:21:49.50,0:21:51.54,Default,,0,0,0,,- (Реджер) Бірақ кейде мен боламын - Руджер, үндеме
Dialogue: 0,0:21:51.62,0:21:54.12,Default,,0,0,0,,Кейде бұл қиын!
Dialogue: 0,0:21:54.70,0:21:57.29,Default,,0,0,0,,А... Әкем маған сенді.
Dialogue: 0,0:21:57.37,0:22:00.87,Default,,0,0,0,,Дұрыс! Әкем осында болса, мен кітап дүкенінен бас тартпас едім.
Dialogue: 0,0:22:00.95,0:22:02.25,Default,,0,0,0,,Шулы!
Dialogue: 0,0:22:02.33,0:22:04.87,Default,,0,0,0,,Раджа ештеңе түсінбесе де.
Dialogue: 0,0:22:05.66,0:22:06.95,Default,,0,0,0,,Аманда...
Dialogue: 0,0:22:07.04,0:22:08.83,Default,,0,0,0,,Тіпті сіз...
Dialogue: 0,0:22:08.91,0:22:11.58,Default,,0,0,0,,Тіпті Раджа да жоғалады.
Dialogue: 0,0:22:12.45,0:22:16.37,Default,,0,0,0,,Мен оны елестетуді тоқтатсам, ол жай ғана жоғалады.
Dialogue: 0,0:22:16.45,0:22:19.37,Default,,0,0,0,,Не... не айтып тұрсың? мен...
Dialogue: 0,0:22:19.45,0:22:20.45,Default,,0,0,0,,Кет!
Dialogue: 0,0:22:21.04,0:22:23.20,Default,,0,0,0,,Аманда! Маған шабуыл жасалды!
Dialogue: 0,0:22:23.29,0:22:25.79,Default,,0,0,0,,Сол елес сияқты нәрсе
Dialogue: 0,0:22:25.87,0:22:28.33,Default,,0,0,0,,Ол қазір ұсталған болуы мүмкін.
Dialogue: 0,0:22:28.41,0:22:29.62,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:23:16.75,0:23:17.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:30.37,0:23:32.20,Default,,0,0,0,,күрсіну
Dialogue: 0,0:23:33.54,0:23:36.75,Default,,0,0,0,,Ааа~
Dialogue: 0,0:23:37.58,0:23:39.45,Default,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:23:47.91,0:23:50.70,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:23:50.79,0:23:53.20,Default,,0,0,0,,Ол қазір ұсталған болуы мүмкін.
Dialogue: 0,0:23:54.08,0:23:57.66,Default,,0,0,0,,Анау қара шаш... Уау~
Dialogue: 0,0:24:02.75,0:24:03.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:22.66,0:24:23.79,Default,,0,0,0,,Бұл~
Dialogue: 0,0:24:25.91,0:24:27.79,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,0:24:28.62,0:24:32.29,Default,,0,0,0,,Иә, мен оны көріп тұрмын, бірақ ол әлсіз.
Dialogue: 0,0:24:32.87,0:24:37.79,Default,,0,0,0,,Сен де біреудің досысың ба? Бұл... қиял
Dialogue: 0,0:24:38.37,0:24:39.79,Default,,0,0,0,,Келесі күнге дейін
Dialogue: 0,0:24:41.08,0:24:42.29,Default,,0,0,0,,Келесі күнге дейін?
Dialogue: 0,0:24:42.37,0:24:45.79,Default,,0,0,0,,Иә, досым мені көре алмайды.
Dialogue: 0,0:24:47.37,0:24:50.41,Default,,0,0,0,,Мен саған енді керек емеспін
Dialogue: 0,0:24:53.87,0:24:56.08,Default,,0,0,0,,Керек болмаса... жоғалып кете ме?
Dialogue: 0,0:24:56.16,0:24:57.58,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:24:57.66,0:24:59.29,Default,,0,0,0,,Егер ол жоғалып кетсе не болады?
Dialogue: 0,0:24:59.87,0:25:01.04,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:25:01.83,0:25:02.95,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,0:25:04.37,0:25:05.79,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:25:11.87,0:25:17.16,Default,,0,0,0,,Мен де. Мен ешқашан жоғалып кеткен емеспін, бірақ жоғалып кетуден қорқамын.
Dialogue: 0,0:25:33.95,0:25:38.37,Default,,0,0,0,,Аманда, кешегі күн үшін кешірім сұраймын. Бұл менің кінәм болды.
Dialogue: 0,0:25:39.95,0:25:40.83,Default,,0,0,0,,Иә
Dialogue: 0,0:25:40.91,0:25:43.87,Default,,0,0,0,,Ертең бассейнге барамыз ба? Сіз қалай ойлайсыз?
Dialogue: 0,0:25:47.16,0:25:50.50,Default,,0,0,0,,Әлде мен Даунбит әжемнің үйіне баруым керек пе?
Dialogue: 0,0:25:50.58,0:25:52.58,Default,,0,0,0,,Печенье пісіріңіз. О иә.
Dialogue: 0,0:25:52.66,0:25:55.70,Default,,0,0,0,,Раджа, қаласаңыз бізге қосылыңыз.
Dialogue: 0,0:25:56.45,0:25:57.45,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:26:15.50,0:26:18.00,Default,,0,0,0,,Күте тұрыңыз, мен сіздің тұрақ билетіңізді аламын.
Dialogue: 0,0:26:19.95,0:26:21.83,Default,,0,0,0,,Сіз ешқашан кешірім сұрамауды жоспарлайсыз ба?
Dialogue: 0,0:26:22.50,0:26:23.62,Default,,0,0,0,,Эй!
Dialogue: 0,0:26:24.62,0:26:26.41,Default,,0,0,0,,Мен жоғалмаймын!
Dialogue: 0,0:26:26.95,0:26:28.41,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,0:26:28.50,0:26:30.83,Default,,0,0,0,,Жоғалып қалмау, қорғау
Dialogue: 0,0:26:30.91,0:26:32.04,Default,,0,0,0,,Жылама
Dialogue: 0,0:26:32.12,0:26:33.87,Default,,0,0,0,,Ант абсолютті!
Dialogue: 0,0:26:33.95,0:26:36.83,Default,,0,0,0,,Раджа Бұл шатыр емес.
Dialogue: 0,0:26:39.12,0:26:40.91,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:26:42.20,0:26:43.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:44.12,0:26:46.37,Default,,0,0,0,,Қараңызшы, ол жоғалып кетпейді!
Dialogue: 0,0:26:46.45,0:26:49.16,Default,,0,0,0,,Раджа, бұл қауіпті.
Dialogue: 0,0:26:49.75,0:26:51.66,Default,,0,0,0,,Алыста жүрсең де өшпейді
Dialogue: 0,0:26:52.25,0:26:53.58,Default,,0,0,0,,Керемет жаңалық!
Dialogue: 0,0:26:54.16,0:26:57.37,Default,,0,0,0,,Аманда жоғалып кетсе де, мен жоғалмаймын!
Dialogue: 0,0:26:57.45,0:27:00.08,Default,,0,0,0,,Түсіндім! Түсіндім, қайт.
Dialogue: 0,0:27:00.16,0:27:02.58,Default,,0,0,0,,Бұл менің кінәм болды
Dialogue: 0,0:27:04.75,0:27:06.91,Default,,0,0,0,,Кешіріңіз, Раджа!
Dialogue: 0,0:27:07.00,0:27:08.66,Default,,0,0,0,,Ой
Dialogue: 0,0:27:10.25,0:27:11.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:12.29,0:27:14.16,Default,,0,0,0,,Сәлем қыз
Dialogue: 0,0:27:14.95,0:27:17.16,Default,,0,0,0,,Сізді таң қалдырғаны үшін кешіріңіз.
Dialogue: 0,0:27:17.25,0:27:18.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:18.75,0:27:22.16,Default,,0,0,0,,Менің сенімен ісім жоқ сияқты, қыз.
Dialogue: 0,0:27:22.25,0:27:24.66,Default,,0,0,0,,Мен сенің досыңмен сөйлескім келеді.
Dialogue: 0,0:27:25.87,0:27:28.66,Default,,0,0,0,,Өкінішке орай, кассада ұзын-сонар кезек бар.
Dialogue: 0,0:27:28.75,0:27:31.12,Default,,0,0,0,,Біраз уақыт алатын сияқты.
Dialogue: 0,0:27:33.33,0:27:34.66,Default,,0,0,0,,Шах
Dialogue: 0,0:27:36.00,0:27:37.16,Default,,0,0,0,,Уау... аа...
Dialogue: 0,0:27:41.04,0:27:42.70,Default,,0,0,0,,Аманда, жүгір!
Dialogue: 0,0:27:50.08,0:27:51.25,Default,,0,0,0,,Раджа!?
Dialogue: 0,0:27:51.83,0:27:55.87,Default,,0,0,0,,Бұл сияқты ерекше қиялдар бұрыннан жойылған.
Dialogue: 0,0:27:55.95,0:27:59.20,Default,,0,0,0,,Хмм, өте жақсы иіс.
Dialogue: 0,0:28:39.91,0:28:41.33,Default,,0,0,0,,(Автокөлік сигналы)
Dialogue: 0,0:28:41.41,0:28:42.87,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:28:51.62,0:28:52.45,Default,,0,0,0,,Аманда!
Dialogue: 0,0:28:53.45,0:28:55.41,Default,,0,0,0,,- (Лиззи) Аманда! - (Қараушы) Жақсысың ба?
Dialogue: 0,0:28:58.62,0:28:59.75,Default,,0,0,0,,Аманда
Dialogue: 0,0:29:01.08,0:29:01.95,Default,,0,0,0,,Аманда!
Dialogue: 0,0:29:07.70,0:29:11.62,Default,,0,0,0,,(Жедел жәрдем сиренасының дыбысы)
Dialogue: 0,0:29:22.91,0:29:24.45,Default,,0,0,0,,Уау...
Dialogue: 0,0:29:27.87,0:29:30.37,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:29:38.33,0:29:39.91,Default,,0,0,0,,Уау
Dialogue: 0,0:29:47.87,0:29:50.41,Default,,0,0,0,,Кешір, Ииджичи-сан
Dialogue: 0,0:30:08.87,0:30:10.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:10.62,0:30:13.87,Default,,0,0,0,,Бала, мен сені көріп тұрмын.
Dialogue: 0,0:30:14.87,0:30:18.29,Default,,0,0,0,,Мен сен сияқты көп адамдарды білемін.
Dialogue: 0,0:30:19.00,0:30:20.08,Default,,0,0,0,,Уау
Dialogue: 0,0:30:22.37,0:30:24.79,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:30:27.87,0:30:32.08,Default,,0,0,0,,Ұмыту қиын болуы керек.
Dialogue: 0,0:30:33.37,0:30:36.75,Default,,0,0,0,,Бірақ бұл ерте ме, кеш пе болатыны сөзсіз.
Dialogue: 0,0:30:38.29,0:30:41.70,Default,,0,0,0,,Мен ұмытылған жоқпын. Апат болды.
Dialogue: 0,0:30:41.79,0:30:44.29,Default,,0,0,0,,Аманды көлік қағып кетті, сондықтан...
Dialogue: 0,0:30:44.37,0:30:45.91,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:30:48.00,0:30:50.91,Default,,0,0,0,,Арықтап, жоғалып бара жатырсың
Dialogue: 0,0:30:54.50,0:30:57.41,Default,,0,0,0,,Сізге аз ғана уақыт қалды.
Dialogue: 0,0:30:58.95,0:31:00.75,Default,,0,0,0,,Жүр, менің артымнан жүр.
Dialogue: 0,0:31:00.83,0:31:03.41,Default,,0,0,0,,Аманда... Аманда қайтыс болды.
Dialogue: 0,0:31:03.50,0:31:06.79,Default,,0,0,0,,Дұрыс, сондықтан келдің.
Dialogue: 0,0:31:11.75,0:31:13.33,Default,,0,0,0,,Құдай өлімде...
Dialogue: 0,0:31:14.04,0:31:17.04,Default,,0,0,0,,Мен өлім құдайы емеспін. Менің атым Джинзан.
Dialogue: 0,0:31:17.62,0:31:20.91,Default,,0,0,0,,Тағы да айтамын: Енді уақытың жоқ.
Dialogue: 0,0:31:21.00,0:31:25.04,Default,,0,0,0,,Жоғалып кетесің бе, әлде менімен келесің бе?
Dialogue: 0,0:31:25.62,0:31:29.04,Default,,0,0,0,,Мен Аманданың орнына барамын.
Dialogue: 0,0:31:29.62,0:31:31.58,Default,,0,0,0,,Сіз шешесіз.
Dialogue: 0,0:31:34.04,0:31:37.79,Default,,0,0,0,,Менің жоғалып кеткім келмейді
Dialogue: 0,0:31:42.08,0:31:44.04,Default,,0,0,0,,Сіз сәл жылдамырақ жүре аласыз ба?
Dialogue: 0,0:31:46.50,0:31:48.04,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:31:48.62,0:31:51.41,Default,,0,0,0,,Уайымдамаңыз, бұл қауіпсіз жер.
Dialogue: 0,0:31:51.50,0:31:53.54,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:31:54.33,0:31:57.79,Default,,0,0,0,,Керекті жерден дұрыс есікті табыңыз
Dialogue: 0,0:31:58.41,0:31:59.79,Default,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:31:59.87,0:32:03.79,Default,,0,0,0,,Маған үзіліс бере аласыз ба? Сіз тым көп сұрақ қоясыз.
Dialogue: 0,0:32:03.87,0:32:07.37,Default,,0,0,0,,Sorry, I was always asking Amanda questions.
Dialogue: 0,0:32:07.45,0:32:10.79,Default,,0,0,0,,Сонда сіздің Аманда әрқашан жауап берді ме?
Dialogue: 0,0:32:11.50,0:32:12.79,Default,,0,0,0,,Әрқашан емес
Dialogue: 0,0:32:13.37,0:32:15.25,Default,,0,0,0,,What did you do when you didn't have an answer?
Dialogue: 0,0:32:15.83,0:32:18.29,Default,,0,0,0,,Аманда өз жауаптарын құрастырады
Dialogue: 0,0:32:19.08,0:32:23.29,Default,,0,0,0,,Түсіндім, сондықтан Аманда сені елестетті.
Dialogue: 0,0:32:24.29,0:32:26.41,Default,,0,0,0,,Жауап сізсіз.
Dialogue: 0,0:32:26.95,0:32:30.79,Default,,0,0,0,,Жауабы? Мен Аманданың жауабымын ба?
Dialogue: 0,0:32:30.87,0:32:35.12,Default,,0,0,0,,Yes, you have fulfilled the role of the imaginary.
Dialogue: 0,0:32:36.41,0:32:38.45,Default,,0,0,0,,Тек алға қара.
Dialogue: 0,0:32:43.08,0:32:44.87,Default,,0,0,0,,- (Реджер) Тұйық ба? - Мұқият қара.
Dialogue: 0,0:32:44.95,0:32:48.12,Default,,0,0,0,,This is the door that will lead you to a new life.
Dialogue: 0,0:32:54.16,0:32:56.29,Default,,0,0,0,,Еш ойланбаңыз, барыңыз.
Dialogue: 0,0:33:01.29,0:33:04.16,Default,,0,0,0,,For those who have forgotten, you should also forget.
Dialogue: 0,0:33:06.08,0:33:07.16,Default,,0,0,0,,Цзиньзан
Dialogue: 0,0:33:07.83,0:33:10.16,Default,,0,0,0,,Менде әлі іздеу бар.
Dialogue: 0,0:33:11.54,0:33:15.08,Default,,0,0,0,,Жаңа өмірден ләззат алыңыз
Dialogue: 0,0:33:26.16,0:33:27.16,Default,,0,0,0,,Уау...
Dialogue: 0,0:33:43.75,0:33:48.04,Default,,0,0,0,,Um, excuse me, I asked Jinzan to bring me!
Dialogue: 0,0:33:48.12,0:33:50.75,Default,,0,0,0,,Ах... Уау.
Dialogue: 0,0:33:53.62,0:33:56.54,Default,,0,0,0,,Неліктен ол адаммен сөйлесіп тұрсың?
Dialogue: 0,0:33:56.62,0:33:58.04,Default,,0,0,0,,Уау...
Dialogue: 0,0:33:58.12,0:34:02.20,Default,,0,0,0,,That person is a real person, he can't see you.
Dialogue: 0,0:34:02.87,0:34:04.87,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:34:03.16,0:34:05.83,Default,,0,0,0,,(♪Орталық залдан музыка)
Dialogue: 0,0:34:06.20,0:34:07.87,Default,,0,0,0,,Бір сәтке алыстап кетіңіз.
Dialogue: 0,0:34:10.75,0:34:12.62,Default,,0,0,0,,Бұл концерт!
Dialogue: 0,0:34:15.75,0:34:21.75,Default,,0,0,0,,(♪ «Мен үй алғым келеді»)
Dialogue: 0,0:34:58.41,0:35:01.41,Default,,0,0,0,,Эмили
Dialogue: 0,0:35:03.79,0:35:06.29,Default,,0,0,0,,(микрофонның айқайлаған дыбысы)
Dialogue: 0,0:35:09.29,0:35:13.00,Default,,0,0,0,,Барлығы көңілді!
Dialogue: 0,0:35:13.08,0:35:15.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:35:18.08,0:35:20.58,Default,,0,0,0,,Адамдар туралы не деуге болады?
Dialogue: 0,0:35:23.66,0:35:25.58,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:35:25.66,0:35:29.08,Default,,0,0,0,,Hey everyone, what day of the week is tomorrow?
Dialogue: 0,0:35:29.16,0:35:31.58,Default,,0,0,0,,Сенбі!
Dialogue: 0,0:35:31.66,0:35:33.50,Default,,0,0,0,,Келесі күні ше?
Dialogue: 0,0:35:33.58,0:35:36.08,Default,,0,0,0,,жексенбі!
Dialogue: 0,0:35:36.16,0:35:38.83,Default,,0,0,0,,Бұл қай күн?
Dialogue: 0,0:35:38.91,0:35:41.83,Default,,0,0,0,,Қызықты күн!
Dialogue: 0,0:35:41.91,0:35:43.83,Default,,0,0,0,,Көптен күткен...
Dialogue: 0,0:35:43.91,0:35:46.33,Default,,0,0,0,,Жұмыс күні!
Dialogue: 0,0:35:47.00,0:35:49.33,Default,,0,0,0,,Барлығы көп жұмыс істейді және ойнайды.
Dialogue: 0,0:35:49.95,0:35:52.83,Default,,0,0,0,,Осыдан кейін барлығы онымен бөлісуі керек.
Dialogue: 0,0:35:58.33,0:35:59.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:12.83,0:36:13.58,Default,,0,0,0,,Әй!
Dialogue: 0,0:36:17.04,0:36:18.45,Default,,0,0,0,,О
Dialogue: 0,0:36:23.12,0:36:24.37,Default,,0,0,0,,Уф
Dialogue: 0,0:36:27.45,0:36:28.79,Default,,0,0,0,,Бұл сіз көрмеген бет
Dialogue: 0,0:36:32.58,0:36:33.75,Default,,0,0,0,,Жаңадан келген адам?
Dialogue: 0,0:36:34.75,0:36:35.62,Default,,0,0,0,,Ах... иә
Dialogue: 0,0:36:35.70,0:36:37.37,Default,,0,0,0,,Сіз бұл жер туралы қайдан білдіңіз?
Dialogue: 0,0:36:37.45,0:36:39.00,Default,,0,0,0,,Ум... Джинзанға.
Dialogue: 0,0:36:39.50,0:36:40.66,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:36:40.75,0:36:42.37,Default,,0,0,0,,Мен раджамын.
Dialogue: 0,0:36:42.95,0:36:44.87,Default,,0,0,0,,Рудж Сенің көзің қандай түсті?
Dialogue: 0,0:36:44.95,0:36:47.45,Default,,0,0,0,,- (Radja) Rudge? - Eye color
Dialogue: 0,0:36:49.75,0:36:53.08,Default,,0,0,0,,сенікі емес Джинзанның көзінің түсі қандай?
Dialogue: 0,0:36:53.16,0:36:55.37,Default,,0,0,0,,О, ммм.
Dialogue: 0,0:36:55.45,0:36:59.45,Default,,0,0,0,,Оң көз көк, сол көз... қызыл!
Dialogue: 0,0:37:06.91,0:37:08.00,Default,,0,0,0,,өту
Dialogue: 0,0:37:08.08,0:37:12.00,Default,,0,0,0,,Мен білдім, Коюки-чан, мен білдім.
Dialogue: 0,0:37:12.08,0:37:16.00,Default,,0,0,0,,Білдім, білдім.
Dialogue: 0,0:37:20.87,0:37:24.12,Default,,0,0,0,,Радж дәл Эмили сияқты адамға ұқсайды.
Dialogue: 0,0:37:24.20,0:37:26.00,Default,,0,0,0,,Гаргари
Dialogue: 0,0:37:26.70,0:37:29.29,Default,,0,0,0,,Рудж Бұл бала Коюки-чан
Dialogue: 0,0:37:29.37,0:37:32.62,Default,,0,0,0,,Мен, Коюки-чан, бегемотқа ұқсаймын
Dialogue: 0,0:37:33.54,0:37:37.08,Default,,0,0,0,,Бұл баланың сүйектері арық және «Танысқаныма қуаныштымын» дейді
Dialogue: 0,0:37:37.16,0:37:39.25,Default,,0,0,0,,Garigarigari...
Dialogue: 0,0:37:41.04,0:37:42.41,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:37:43.87,0:37:46.33,Default,,0,0,0,,Біз бәріміз қиялдағы доспыз ба?
Dialogue: 0,0:37:47.04,0:37:50.33,Default,,0,0,0,,Иә, бәрі қиял.
Dialogue: 0,0:37:51.25,0:37:52.33,Default,,0,0,0,,Imaginary?
Dialogue: 0,0:37:52.41,0:37:55.79,Default,,0,0,0,,Ересек адамдар бізді осылай атайды.
Dialogue: 0,0:37:55.87,0:37:57.70,Default,,0,0,0,,Garigarigari
Dialogue: 0,0:37:58.83,0:38:00.16,Default,,0,0,0,,Ha
Dialogue: 0,0:38:00.25,0:38:02.95,Default,,0,0,0,,Мүмкін Радж ештеңе білмейтін шығар?
Dialogue: 0,0:38:04.70,0:38:06.33,Default,,0,0,0,,You know, Rudge.
Dialogue: 0,0:38:06.41,0:38:08.75,Default,,0,0,0,,Қиялы өте бай балалар
Dialogue: 0,0:38:08.83,0:38:11.45,Default,,0,0,0,,Сіз өз басыңызда біз туралы армандайсыз
Dialogue: 0,0:38:11.54,0:38:14.08,Default,,0,0,0,,Біз сол баламен жақсы дос болдық.
Dialogue: 0,0:38:14.16,0:38:17.08,Default,,0,0,0,,Бәрі жақсы және бәрі жақсы.
Dialogue: 0,0:38:17.16,0:38:21.25,Default,,0,0,0,,Бірақ балалар өсіп, ақырында қызығушылықтары жоғалады.
Dialogue: 0,0:38:21.33,0:38:23.29,Default,,0,0,0,,Біз ұмытыламыз
Dialogue: 0,0:38:23.37,0:38:27.45,Default,,0,0,0,,Әдетте ол сонда аяқталады және біз өшіп, жоғалып кетеміз.
Dialogue: 0,0:38:27.54,0:38:30.20,Default,,0,0,0,,Бірақ Джинзан немесе басқа біреу сияқты
Dialogue: 0,0:38:30.29,0:38:33.37,Default,,0,0,0,,Ол жоғалып кетпес бұрын, оны осы кітапханаға әкеліңіз.
Dialogue: 0,0:38:33.45,0:38:36.08,Default,,0,0,0,,Кітаптар негізінен қиялдан жасалады, солай ма?
Dialogue: 0,0:38:37.45,0:38:39.45,Default,,0,0,0,,Қиял біз үшін нені білдіреді?
Dialogue: 0,0:38:40.04,0:38:42.70,Default,,0,0,0,,Бұл адам үшін оттегі сияқты.
Dialogue: 0,0:38:42.79,0:38:46.70,Default,,0,0,0,,Свуш хах
Dialogue: 0,0:38:46.79,0:38:49.41,Default,,0,0,0,,Мұнда көп нәрсе бар
Dialogue: 0,0:38:50.58,0:38:52.20,Default,,0,0,0,,Ах! Қараңдар!
Dialogue: 0,0:38:52.29,0:38:56.20,Default,,0,0,0,,Ол әйгілі суретшінің қиялындағы Леди Кабби болатын.
Dialogue: 0,0:38:56.95,0:38:59.37,Default,,0,0,0,,Дұрыс! Пикассо не айтар еді?
Dialogue: 0,0:38:59.45,0:39:03.20,Default,,0,0,0,,«Мен сені бір күні суретке түсіремін» дедім де, мен оған ғашық болып қалдым.
Dialogue: 0,0:39:03.29,0:39:05.45,Default,,0,0,0,,Ол метроном бароны
Dialogue: 0,0:39:05.54,0:39:11.12,Default,,0,0,0,,Мен ұлы саңырау композитормен бірге көптеген таңғажайып әндер жаздым.
Dialogue: 0,0:39:11.20,0:39:15.37,Default,,0,0,0,,Джаджаджаан
Dialogue: 0,0:39:15.95,0:39:18.83,Default,,0,0,0,,Тағдырлы кездесулер бар, солай ма?
Dialogue: 0,0:39:18.91,0:39:22.33,Default,,0,0,0,,Әлгі дірілдеп тұрған ата туралы аңыздардың ішінде аңыз бар.
Dialogue: 0,0:39:22.41,0:39:25.95,Default,,0,0,0,,Ең асыл, құрметті қиялдардың бірі.
Dialogue: 0,0:39:27.70,0:39:31.54,Default,,0,0,0,,Өмір сүруім керек пе, әлде өлуім керек пе?
Dialogue: 0,0:39:31.62,0:39:33.54,Default,,0,0,0,,Мәселе осында
Dialogue: 0,0:39:34.91,0:39:37.83,Default,,0,0,0,,Балалардың қиялынан туғанбыз.
Dialogue: 0,0:39:37.91,0:39:39.83,Default,,0,0,0,,Сол баламен жақын дос болыңыз
Dialogue: 0,0:39:39.91,0:39:43.50,Default,,0,0,0,,Ол адам әлемін керемет етеді.
Dialogue: 0,0:39:43.58,0:39:45.33,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:39:50.00,0:39:51.62,Default,,0,0,0,,Гаргаригари
Dialogue: 0,0:39:51.70,0:39:53.83,Default,,0,0,0,,Соңғы адам қайтып келеді
Dialogue: 0,0:39:54.50,0:39:56.91,Default,,0,0,0,,Кітапхана енді біздікі.
Dialogue: 0,0:39:58.45,0:40:01.66,Default,,0,0,0,,Рудж Көңілді қазір басталады.
Dialogue: 0,0:40:01.75,0:40:02.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:02.79,0:40:06.45,Default,,0,0,0,,Қиялдың ұлылығын ұға алсаң, осылай ойламас па едің?
Dialogue: 0,0:40:06.54,0:40:10.66,Default,,0,0,0,,Олар бізге жақсырақ тұруға болатынын айтты!
Dialogue: 0,0:40:55.04,0:40:56.29,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:40:56.91,0:40:58.95,Default,,0,0,0,,Қиялдағы қалаға
Dialogue: 0,0:41:09.12,0:41:11.79,Default,,0,0,0,,А... иісі кетіп қалды ма?
Dialogue: 0,0:41:12.37,0:41:15.16,Default,,0,0,0,,Адамдар өлгенде, қиял да жоғалады.
Dialogue: 0,0:41:15.25,0:41:19.04,Default,,0,0,0,,Өкініштісі, мұндайды сирек кездестіресің.
Dialogue: 0,0:41:19.12,0:41:21.54,Default,,0,0,0,,Матча латте және стақан
Dialogue: 0,0:41:25.04,0:41:26.91,Default,,0,0,0,,Маған тезірек тамақтану керек.
Dialogue: 0,0:41:27.50,0:41:29.70,Default,,0,0,0,,Сізге және мен үшін
Dialogue: 0,0:41:29.79,0:41:34.16,Default,,0,0,0,,Дәмді және ерекше жаңа тағам
Dialogue: 0,0:41:34.25,0:41:35.66,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:41:35.75,0:41:39.25,Default,,0,0,0,,Менің өте пайдалы мұрыным бар.
Dialogue: 0,0:41:39.33,0:41:40.54,Default,,0,0,0,,Атчитчи...
Dialogue: 0,0:41:41.12,0:41:43.12,Default,,0,0,0,,...
Dialogue: 0,0:41:57.25,0:41:58.12,Default,,0,0,0,,Иә
Dialogue: 0,0:41:58.20,0:41:59.20,Default,,0,0,0,,Grazie
Dialogue: 0,0:42:20.16,0:42:21.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:24.16,0:42:27.62,Default,,0,0,0,,Эмили Маған бірдеңе айтқым келеді...
Dialogue: 0,0:42:27.70,0:42:29.79,Default,,0,0,0,,Гаргаригари
Dialogue: 0,0:42:29.87,0:42:31.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:42:31.87,0:42:33.37,Default,,0,0,0,,Қиялдағы қала
Dialogue: 0,0:42:34.12,0:42:37.04,Default,,0,0,0,,Кітаптың ішіндегі қиял мен үшін оны жасауда.
Dialogue: 0,0:42:37.12,0:42:40.87,Default,,0,0,0,,Күн сайын басқа қалаға айналады, ертең және арғы күні.
Dialogue: 0,0:42:40.95,0:42:42.29,Default,,0,0,0,,Кеше Мачу Пикчу болды
Dialogue: 0,0:42:42.37,0:42:45.41,Default,,0,0,0,,Күні кеше мен Уандудл деген елге бардым.
Dialogue: 0,0:42:46.12,0:42:50.87,Default,,0,0,0,,Кітапхана біз үшін үй іспетті.
Dialogue: 0,0:42:50.95,0:42:54.87,Default,,0,0,0,,Бұл жерден кез келген жерге баруға және кез келген уақытта қайтып келуге болады.
Dialogue: 0,0:42:59.16,0:43:03.37,Default,,0,0,0,,Радж: Бұл біз ешқашан жасай алмайтын нәрсе.
Dialogue: 0,0:43:04.95,0:43:09.37,Default,,0,0,0,,Қиялмен әр түрлі нәрселерді жасау – адам баласының ісі.
Dialogue: 0,0:43:09.45,0:43:11.87,Default,,0,0,0,,Біз мұны істей алмаймыз.
Dialogue: 0,0:43:11.95,0:43:17.08,Default,,0,0,0,,Бірақ бізде тек өз қолымыздан келетін жұмыс бар.
Dialogue: 0,0:43:17.75,0:43:19.00,Default,,0,0,0,,Жұмыс?
Dialogue: 0,0:43:19.08,0:43:24.20,Default,,0,0,0,,Иә, балаларымыздың қиялын бірге зерттеп, ойнайық.
Dialogue: 0,0:43:24.29,0:43:27.33,Default,,0,0,0,,Бұл сэндвич, иә, зефир де.
Dialogue: 0,0:43:27.41,0:43:30.25,Default,,0,0,0,,Әркім мен үшін біраз жұмыс жасады, сондықтан мен оны сіздермен бөлісемін.
Dialogue: 0,0:43:30.33,0:43:32.50,Default,,0,0,0,,Балалардың қиялынан
Dialogue: 0,0:43:33.45,0:43:37.00,Default,,0,0,0,,Мен Руджға ертеңнен бастап көп жұмысты тапсырамын.
Dialogue: 0,0:43:37.08,0:43:41.54,Default,,0,0,0,,Эмили, бірақ... менің кетуім керек.
Dialogue: 0,0:43:42.08,0:43:43.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:45.29,0:43:48.62,Default,,0,0,0,,Бүгін менің досым Бантинг деп аталды.
Dialogue: 0,0:43:48.70,0:43:50.00,Default,,0,0,0,,Бунтинг?
Dialogue: 0,0:44:00.12,0:44:03.75,Default,,0,0,0,,Рудж Жаңа ғана ұруды айттыңыз ба?
Dialogue: 0,0:44:03.83,0:44:06.79,Default,,0,0,0,,Иә, сіз бірдеңе білесіз бе?
Dialogue: 0,0:44:10.08,0:44:12.08,Default,,0,0,0,,Ол бізге шабуыл жасады.
Dialogue: 0,0:44:12.16,0:44:13.16,Default,,0,0,0,,Оның арқасында
Dialogue: 0,0:44:13.25,0:44:15.54,Default,,0,0,0,,Менің досымды көлік қағып кетті.
Dialogue: 0,0:44:16.12,0:44:19.04,Default,,0,0,0,,Бантинг Мистер Бантинг
Dialogue: 0,0:44:20.25,0:44:22.16,Default,,0,0,0,,Сен жаман адамсың.
Dialogue: 0,0:44:22.25,0:44:24.50,Default,,0,0,0,,Қаптау менікі, қиялды же
Dialogue: 0,0:44:24.58,0:44:26.25,Default,,0,0,0,,Тірі бол
Dialogue: 0,0:44:26.75,0:44:28.16,Default,,0,0,0,,Жүздеген жүздеген жылдар
Dialogue: 0,0:44:28.25,0:44:30.08,Default,,0,0,0,,Менің достарым және менің адам достарым
Dialogue: 0,0:44:30.16,0:44:32.66,Default,,0,0,0,,Бір күні міндетті түрде қоштасамыз.
Dialogue: 0,0:44:33.25,0:44:35.95,Default,,0,0,0,,Бірақ маған Бантинг ұнамады.
Dialogue: 0,0:44:37.16,0:44:40.08,Default,,0,0,0,,Мен ересек болсам да, елестету күшін қалаймын.
Dialogue: 0,0:44:42.33,0:44:46.58,Default,,0,0,0,,Бір күні ол басқа баланың қиялын ұрлап, оны жұтып қойды!
Dialogue: 0,0:44:46.66,0:44:49.75,Default,,0,0,0,,Бунтинг кез келген жерде пайда болуы мүмкін.
Dialogue: 0,0:44:49.83,0:44:53.08,Default,,0,0,0,,Таксидің иісін иіскеп, олардан алда жүріңіз.
Dialogue: 0,0:44:53.16,0:44:56.87,Default,,0,0,0,,(Жалынның күркіреуі)
Dialogue: 0,0:44:58.66,0:45:01.79,Default,,0,0,0,,Қиял жеу арқылы тірі қалу
Dialogue: 0,0:45:02.66,0:45:05.87,Default,,0,0,0,,Елестету қабілетін жоғалтпа
Dialogue: 0,0:45:05.95,0:45:07.95,Default,,0,0,0,,Қазірдің өзінде, бір жерде
Dialogue: 0,0:45:08.04,0:45:09.58,Default,,0,0,0,,Бәріңе сәлем, тынышталыңдар.
Dialogue: 0,0:45:09.66,0:45:12.50,Default,,0,0,0,,Жарайды! Бұл кітапхана.
Dialogue: 0,0:45:12.58,0:45:15.58,Default,,0,0,0,,Бұл қауіпсіз және қауіпсіз қиялдағы қала.
Dialogue: 0,0:45:20.20,0:45:22.08,Default,,0,0,0,,Бұл жаман, бірақ Радж
Dialogue: 0,0:45:22.16,0:45:25.16,Default,,0,0,0,,Бантинг мырзаны бәрі біледі.
Dialogue: 0,0:45:25.25,0:45:27.58,Default,,0,0,0,,Өйткені бұл қалалық аңыз сияқты.
Dialogue: 0,0:45:28.16,0:45:30.20,Default,,0,0,0,,Кездестім деп өтірік айтпа.
Dialogue: 0,0:45:30.29,0:45:32.66,Default,,0,0,0,,Мистер Бантингпен кім кездесті?
Dialogue: 0,0:45:32.75,0:45:34.66,Default,,0,0,0,,Өйткені бірде-біреуі жоқ.
Dialogue: 0,0:45:40.50,0:45:41.70,Default,,0,0,0,,Біз кездестік
Dialogue: 0,0:45:41.79,0:45:44.33,Default,,0,0,0,,Амандаға шабуыл жасап, бізді жеуге тырысты.
Dialogue: 0,0:45:44.95,0:45:48.83,Default,,0,0,0,,Радж, әңгімеңізді бұзғаным үшін кешіріңіз! Бірақ қазір бітті.
Dialogue: 0,0:45:48.91,0:45:52.08,Default,,0,0,0,,Рас, Эмили, Аманда Бантингке барды...
Dialogue: 0,0:45:52.16,0:45:55.41,Default,,0,0,0,,Эй, Радж, мен не болғанын білмеймін.
Dialogue: 0,0:45:55.50,0:45:57.58,Default,,0,0,0,,Мен де сені аяймын.
Dialogue: 0,0:45:57.66,0:46:01.08,Default,,0,0,0,,Мен сенің достарың үшін неліктен алаңдайтыныңды түсінемін.
Dialogue: 0,0:46:01.75,0:46:04.58,Default,,0,0,0,,Эй, Радж, қайда бара жатырсың?
Dialogue: 0,0:46:04.66,0:46:06.04,Default,,0,0,0,,Аманданы іздеңіз
Dialogue: 0,0:46:06.12,0:46:08.66,Default,,0,0,0,,Ол баланы іздеу мүмкін емес.
Dialogue: 0,0:46:09.75,0:46:11.16,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:46:11.25,0:46:15.33,Default,,0,0,0,,Кітапханадан шықсаңыз, Радж бірден жоғалады.
Dialogue: 0,0:46:17.45,0:46:19.58,Default,,0,0,0,,Осыны түсіндіруге рұқсат етіңіз.
Dialogue: 0,0:46:20.16,0:46:22.58,Default,,0,0,0,,Радж баланы енді ешқашан көрмейді.
Dialogue: 0,0:46:23.16,0:46:25.04,Default,,0,0,0,,Бұлай жұмыс істемейді.
Dialogue: 0,0:46:25.12,0:46:29.16,Default,,0,0,0,,Ережені мен жасаған жоқпын, бірақ ережелер бар.
Dialogue: 0,0:46:29.66,0:46:33.66,Default,,0,0,0,,Рудж ұмытылды, кері қайтару жоқ.
Dialogue: 0,0:46:34.16,0:46:37.37,Default,,0,0,0,,Жоқ. Аманда мені ұмытпайды.
Dialogue: 0,0:46:37.45,0:46:40.08,Default,,0,0,0,,Достарың сені ұмытпаса
Dialogue: 0,0:46:40.16,0:46:43.08,Default,,0,0,0,,Сізді баяғыда сол бала шақырған, қазір жоқсыз.
Dialogue: 0,0:46:45.79,0:46:46.58,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:46:49.41,0:46:51.20,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:46:53.29,0:46:56.33,Default,,0,0,0,,Радж Радждан сұраңыз жауабы керісінше болды.
Dialogue: 0,0:46:56.41,0:46:59.20,Default,,0,0,0,,Джинзанның оң көзі қызыл, сол көзі көк.
Dialogue: 0,0:46:59.79,0:47:02.62,Default,,0,0,0,,Сіз көрген нәрсе дұрыс емес.
Dialogue: 0,0:47:04.79,0:47:06.62,Default,,0,0,0,,Иә, барлығы.
Dialogue: 0,0:47:07.79,0:47:10.70,Default,,0,0,0,,Тазаланып, ұйықтайтын кез келді.
Dialogue: 0,0:47:18.25,0:47:19.95,Default,,0,0,0,,Эмили, күте тұрыңыз.
Dialogue: 0,0:47:26.79,0:47:32.79,Default,,0,0,0,,(♪ «Мені жылатыңыз»)
Dialogue: 0,0:47:43.20,0:47:45.41,Default,,0,0,0,,Ұйқың келмей ме, бала?
Dialogue: 0,0:47:45.50,0:47:46.62,Default,,0,0,0,,Джинзан?
Dialogue: 0,0:47:51.29,0:47:55.58,Default,,0,0,0,,Бұл жақсы жер. Жұмыс істесең тамақ аласың.
Dialogue: 0,0:47:57.66,0:48:02.08,Default,,0,0,0,,Сіз мені Аманданың жауабы деп айттыңыз.
Dialogue: 0,0:48:02.16,0:48:05.20,Default,,0,0,0,,Бірақ мен енді Аманды көре алмаймын.
Dialogue: 0,0:48:06.50,0:48:10.04,Default,,0,0,0,,Бұл жауап па? Бұл Аманданың жауабы ма?
Dialogue: 0,0:48:11.62,0:48:14.04,Default,,0,0,0,,Қоштасу – әркім басынан өтетін жол
Dialogue: 0,0:48:15.20,0:48:18.04,Default,,0,0,0,,Менің досым менің ең жақсы досым болды
Dialogue: 0,0:48:18.62,0:48:22.54,Default,,0,0,0,,Бірақ баланың үйі онша бақытты емес.
Dialogue: 0,0:48:23.45,0:48:26.70,Default,,0,0,0,,Күннің соңында бала үнемі жақсылық сұрайды.
Dialogue: 0,0:48:27.54,0:48:30.58,Default,,0,0,0,,«Джинзан, ұйықтама, менің қасымда болып, мені бақылаңыз».
Dialogue: 0,0:48:32.66,0:48:35.83,Default,,0,0,0,,Бақылап тұрдым, балаға қарай бердім.
Dialogue: 0,0:48:35.91,0:48:38.87,Default,,0,0,0,,Сол бала мені ұмытатын күнге дейін
Dialogue: 0,0:48:38.95,0:48:43.62,Default,,0,0,0,,Сондықтан мен ұйықтамаймын, өйткені мен ұйықтаймын деп елестетпеймін.
Dialogue: 0,0:48:44.45,0:48:47.87,Default,,0,0,0,,Қиялдардың тууына себеп бар.
Dialogue: 0,0:48:50.37,0:48:54.37,Default,,0,0,0,,Ұйқың тыныш, балам, мен сені бақылаймын.
Dialogue: 0,0:48:54.45,0:48:55.70,Default,,0,0,0,,Цзиньзан
Dialogue: 0,0:48:56.29,0:48:58.58,Default,,0,0,0,,Мен жыламаймын
Dialogue: 0,0:48:58.66,0:49:01.29,Default,,0,0,0,,Аманда жыламасын деп елестеттім.
Dialogue: 0,0:49:16.79,0:49:19.62,Default,,0,0,0,,Рудж Рудж
Dialogue: 0,0:49:17.91,0:49:21.33,Default,,0,0,0,,(оятар қоңырауы)
Dialogue: 0,0:49:21.91,0:49:25.04,Default,,0,0,0,,- (Коюки-чан) Таң атты, ояну - (Сүйектері қытырлақ) Сай
Dialogue: 0,0:49:26.20,0:49:28.70,Default,,0,0,0,,- (Коюки-чан) Эмили сені күтіп отыр - (Қорқынышты сүйектер) Қорқынышты
Dialogue: 0,0:49:34.16,0:49:35.70,Default,,0,0,0,,Эмили
Dialogue: 0,0:49:36.41,0:49:40.20,Default,,0,0,0,,Радж, сен баяусың. Егер сіз мұны жасасаңыз, сіз жақсы жұмыс аласыз.
Dialogue: 0,0:49:40.95,0:49:42.70,Default,,0,0,0,,Қайырлы таң Эмили
Dialogue: 0,0:49:44.20,0:49:47.70,Default,,0,0,0,,Қайырлы таң Радж, көңіліңді көтерейік.
Dialogue: 0,0:49:50.37,0:49:55.70,Default,,0,0,0,,Рудж Негізгі «ki» - бұл хабарландыру тақтасына мұқият қарау
Dialogue: 0,0:49:59.33,0:50:02.29,Default,,0,0,0,,Дұрыс жұмыс келгенше.
Dialogue: 0,0:50:02.37,0:50:03.70,Default,,0,0,0,,Бұл сіздің жұмысыңыз ба?
Dialogue: 0,0:50:03.79,0:50:06.70,Default,,0,0,0,,Рудж Мұқият қараңыз
Dialogue: 0,0:50:11.87,0:50:13.20,Default,,0,0,0,,«Барлығының хабарландыру тақтасы»
Dialogue: 0,0:50:15.08,0:50:19.79,Default,,0,0,0,,«Нағыз досты таныстыру агенттігі»
Dialogue: 0,0:50:21.12,0:50:24.95,Default,,0,0,0,,Фото Эмили Фотосурет пайда болды.
Dialogue: 0,0:50:25.04,0:50:29.04,Default,,0,0,0,,Иә, бұл балалар бізбен ойнағысы келеді.
Dialogue: 0,0:50:29.62,0:50:32.33,Default,,0,0,0,,Радж осы бала деп ойлайтын баланың суретін алады.
Dialogue: 0,0:50:32.41,0:50:35.79,Default,,0,0,0,,Ең бастысы - әрқашан достарыңды таңдау
Dialogue: 0,0:50:35.87,0:50:39.79,Default,,0,0,0,,Ах! Бұл бала әрқашан дәмді тағамды елестетеді.
Dialogue: 0,0:50:39.87,0:50:41.79,Default,,0,0,0,,Уа! Сен жабайы баласың.
Dialogue: 0,0:50:44.37,0:50:47.37,Default,,0,0,0,,Жарайсың ба? Ойланба, сезін.
Dialogue: 0,0:50:48.37,0:50:49.54,Default,,0,0,0,,Джон мырза...
Dialogue: 0,0:50:49.33,0:50:51.79,Default,,0,0,0,,«Капитан Джон»
Dialogue: 0,0:50:52.91,0:50:54.20,Default,,0,0,0,,Бұл Джон.
Dialogue: 0,0:51:01.04,0:51:02.87,Default,,0,0,0,,Мұнда
Dialogue: 0,0:51:02.95,0:51:04.45,Default,,0,0,0,,Қайтадан ойнайық
Dialogue: 0,0:51:07.04,0:51:10.00,Default,,0,0,0,,- (Коюки-чан) Сәттілік! Rudge! - Іске сәт
Dialogue: 0,0:51:11.41,0:51:14.16,Default,,0,0,0,,Рудж Фото пойыз билетіне ұқсайды.
Dialogue: 0,0:51:14.25,0:51:15.45,Default,,0,0,0,,Оны ешқашан жоғалтпаңыз
Dialogue: 0,0:51:16.08,0:51:17.66,Default,,0,0,0,,Қазір алыңыз!
Dialogue: 0,0:51:28.79,0:51:32.91,Default,,0,0,0,,Мүшелер, бізде дайындық жеткілікті, кеттік!
Dialogue: 0,0:51:43.75,0:51:45.33,Default,,0,0,0,,(Радио сигналы)
Dialogue: 0,0:51:45.41,0:51:46.79,Default,,0,0,0,,Сіз ай тастарын жинадыңыз ба?
Dialogue: 0,0:51:47.75,0:51:49.08,Default,,0,0,0,,Тас?
Dialogue: 0,0:51:49.16,0:51:50.79,Default,,0,0,0,,Бұл сіздің міндетіңіз емес пе?
Dialogue: 0,0:51:51.58,0:51:54.79,Default,,0,0,0,,Бұл сирек кездесетін зат. Тез қайтар.
Dialogue: 0,0:51:54.87,0:51:56.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:04.04,0:52:05.29,Default,,0,0,0,,(Радио сигналы)
Dialogue: 0,0:52:05.37,0:52:07.41,Default,,0,0,0,,Артқа қайт! Жау келе жатыр!
Dialogue: 0,0:52:09.54,0:52:10.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:12.04,0:52:13.50,Default,,0,0,0,,Уау
Dialogue: 0,0:52:20.16,0:52:23.08,Default,,0,0,0,,Рудж Тез оралыңыз!
Dialogue: 0,0:52:23.16,0:52:24.87,Default,,0,0,0,,Уау...
Dialogue: 0,0:52:31.20,0:52:34.08,Default,,0,0,0,,Барлығына! Біз де сәулеге дайындалып жатырмыз.
Dialogue: 0,0:52:34.79,0:52:36.04,Default,,0,0,0,,Түсінікті! капитан
Dialogue: 0,0:52:37.58,0:52:40.00,Default,,0,0,0,,Рудж Жұмыс ойын емес.
Dialogue: 0,0:52:40.08,0:52:42.33,Default,,0,0,0,,Бұл жұмыс пен ойын.
Dialogue: 0,0:52:42.41,0:52:46.50,Default,,0,0,0,,Бұл сол баланың қиялының ойыны ғана, бірақ дұрыс жасамасаңыз, өмірге қауіп төнуі мүмкін.
Dialogue: 0,0:52:47.16,0:52:50.00,Default,,0,0,0,,Қиялымызда өлсек, жоқ боламыз.
Dialogue: 0,0:52:50.58,0:52:53.50,Default,,0,0,0,,Эй, Радж, сенің сүйектерің арық па?
Dialogue: 0,0:52:54.08,0:52:55.62,Default,,0,0,0,,Мен сенімен бірге емеспін
Dialogue: 0,0:52:55.70,0:52:57.75,Default,,0,0,0,,- (Коюки-чан) Иә? -Ол қайда кетті?
Dialogue: 0,0:53:07.25,0:53:09.41,Default,,0,0,0,,Радждың дос таңдауы сәтсіз болуы мүмкін
Dialogue: 0,0:53:09.50,0:53:13.16,Default,,0,0,0,,Шіркін-ай, осындай уақытта осында болса ғой.
Dialogue: 0,0:53:13.79,0:53:15.91,Default,,0,0,0,,Ғарыш қаһарманы Пунё Пунё
Dialogue: 0,0:53:16.83,0:53:22.41,Default,,0,0,0,,Дандан Дандан Дандан...
Dialogue: 0,0:53:22.50,0:53:29.50,Default,,0,0,0,,♪ Яан Яан Джаан
Dialogue: 0,0:53:32.25,0:53:34.79,Default,,0,0,0,,♪ Джажаан
Dialogue: 0,0:53:35.37,0:53:36.70,Default,,0,0,0,,Сүйектер?
Dialogue: 0,0:53:36.79,0:53:38.79,Default,,0,0,0,,Сүйектері арық.
Dialogue: 0,0:53:44.87,0:53:46.62,Default,,0,0,0,,Жүр! Пунё Пунё
Dialogue: 0,0:53:49.70,0:53:52.12,Default,,0,0,0,,Пунё
Dialogue: 0,0:53:59.08,0:54:01.00,Default,,0,0,0,,- Яй - (Коюки-чан) Пунё Пунё!
Dialogue: 0,0:54:15.45,0:54:19.08,Default,,0,0,0,,Күрсін... Рахмет
Dialogue: 0,0:54:21.20,0:54:22.41,Default,,0,0,0,,Пунё Пунё
Dialogue: 0,0:54:26.00,0:54:27.41,Default,,0,0,0,,Қиял аяқталады
Dialogue: 0,0:54:28.00,0:54:31.00,Default,,0,0,0,,Ах~ Ах!
Dialogue: 0,0:54:31.08,0:54:34.04,Default,,0,0,0,,Құбыжықтар барлық жерде.
Dialogue: 0,0:54:34.54,0:54:35.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:37.79,0:54:39.16,Default,,0,0,0,,Гари!
Dialogue: 0,0:54:40.20,0:54:42.12,Default,,0,0,0,,Рудж фотосы!
Dialogue: 0,0:54:43.41,0:54:44.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:46.04,0:54:48.04,Default,,0,0,0,,Гарри!
Dialogue: 0,0:54:53.91,0:54:55.45,Default,,0,0,0,,Кітапхана емес
Dialogue: 0,0:54:56.29,0:54:58.91,Default,,0,0,0,,Радж, сіз фотоны билет деп айттыңыз.
Dialogue: 0,0:54:59.00,0:55:02.37,Default,,0,0,0,,Біз тек бір күндік қиялымыз
Dialogue: 0,0:55:02.45,0:55:05.08,Default,,0,0,0,,Жұмыстан кейін мен кітапханаға қайта баруым керек.
Dialogue: 0,0:55:05.16,0:55:08.95,Default,,0,0,0,,Жоқ, ол жабық. Ха...
Dialogue: 0,0:55:09.04,0:55:12.00,Default,,0,0,0,,Эмили, терезе ашық!
Dialogue: 0,0:55:12.08,0:55:12.95,Default,,0,0,0,,Гари?
Dialogue: 0,0:55:13.58,0:55:15.91,Default,,0,0,0,,Менің ойымша, Коюки-чан да өте алады.
Dialogue: 0,0:55:17.04,0:55:18.37,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:55:18.45,0:55:22.45,Default,,0,0,0,,Рудж Егер оны осылай қамап тастаса, уақыт таусылғанда жоғалып кетер еді.
Dialogue: 0,0:55:22.54,0:55:24.62,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,0:55:24.70,0:55:27.45,Default,,0,0,0,,Мен бұған көмектесе алмаймын, Радж, бұл менің бірінші рет.
Dialogue: 0,0:55:27.54,0:55:31.54,Default,,0,0,0,,Иә, менің ойымша, оған көмектесу мүмкін емес.
Dialogue: 0,0:55:31.62,0:55:35.33,Default,,0,0,0,,Қане, бәріміз, ол жоғалып кетпей тұрып үйге қайтайық.
Dialogue: 0,0:55:37.04,0:55:38.87,Default,,0,0,0,,Гари
Dialogue: 0,0:55:38.95,0:55:41.95,Default,,0,0,0,,Гаригари Гари
Dialogue: 0,0:55:43.04,0:55:44.79,Default,,0,0,0,,Гаргари
Dialogue: 0,0:55:46.54,0:55:47.50,Default,,0,0,0,,Хехе
Dialogue: 0,0:55:47.58,0:55:50.45,Default,,0,0,0,,Гарири... Гарига Гарири
Dialogue: 0,0:55:51.04,0:55:54.54,Default,,0,0,0,,Е! Өтірік Мүмкін
Dialogue: 0,0:55:54.62,0:55:55.91,Default,,0,0,0,,Не болды?
Dialogue: 0,0:55:57.20,0:56:00.87,Default,,0,0,0,,Пунё Пунё ертең де бірге ойнайық...
Dialogue: 0,0:56:01.70,0:56:04.08,Default,,0,0,0,,Гаргаригари...
Dialogue: 0,0:56:04.16,0:56:07.12,Default,,0,0,0,,Пунё Пунёнё Пунёнё
Dialogue: 0,0:56:07.70,0:56:10.12,Default,,0,0,0,,Үлкен пунёпуньо болды
Dialogue: 0,0:56:11.00,0:56:13.87,Default,,0,0,0,,Пунё Пунё Пунё
Dialogue: 0,0:56:17.00,0:56:18.41,Default,,0,0,0,,Сізге жақсы!
Dialogue: 0,0:56:18.50,0:56:19.87,Default,,0,0,0,,Пунёнё
Dialogue: 0,0:56:22.91,0:56:25.83,Default,,0,0,0,,Дұрыс, жақсы, жақсы.
Dialogue: 0,0:56:28.95,0:56:30.87,Default,,0,0,0,,Қаңқа сүйектері
Dialogue: 0,0:56:30.95,0:56:35.37,Default,,0,0,0,,Бір күн ғана дос болған жоқпыз, мәңгілік дос болдық.
Dialogue: 0,0:56:35.45,0:56:38.41,Default,,0,0,0,,Мұндай жағдай сирек кездеседі.
Dialogue: 0,0:56:38.50,0:56:40.75,Default,,0,0,0,,Бүгін бәріміз тойлап жатырмыз.
Dialogue: 0,0:56:40.83,0:56:42.75,Default,,0,0,0,,Осы ғарыштық тағаммен.
Dialogue: 0,0:56:42.83,0:56:44.75,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:56:47.25,0:56:50.20,Default,,0,0,0,,Сәлем Эмили, Эмили де?
Dialogue: 0,0:56:50.29,0:56:51.20,Default,,0,0,0,,Не?
Dialogue: 0,0:56:51.29,0:56:53.66,Default,,0,0,0,,Эмили де адамның досына айналады
Dialogue: 0,0:56:53.75,0:56:57.75,Default,,0,0,0,,Сіз ұмыттыңыз ба? Менің ойымша, бұл солай.
Dialogue: 0,0:56:57.83,0:57:01.58,Default,,0,0,0,,Эмили досын ұмытты ма?
Dialogue: 0,0:57:03.08,0:57:07.37,Default,,0,0,0,,Иә, бұл баяғыда болды.
Dialogue: 0,0:57:08.66,0:57:12.66,Default,,0,0,0,,Мен Аманданың қиялын жақсы көрдім.
Dialogue: 0,0:57:13.66,0:57:16.04,Default,,0,0,0,,Аманда бөлмеге келгенде
Dialogue: 0,0:57:17.54,0:57:20.20,Default,,0,0,0,,Өмір көп нәрсеге дем береді.
Dialogue: 0,0:57:20.70,0:57:24.08,Default,,0,0,0,,Үстел шамы оңтүстік аралдағы ағашқа айналды.
Dialogue: 0,0:57:25.66,0:57:28.75,Default,,0,0,0,,Гардероб қарақшылық қазынаға толы.
Dialogue: 0,0:57:28.83,0:57:32.08,Default,,0,0,0,,Ұйықтап жатқан мысық бомбаға айналуы мүмкін.
Dialogue: 0,0:57:32.16,0:57:35.87,Default,,0,0,0,,Аманданың басының ішінде дүние жарқырап тұр.
Dialogue: 0,0:57:36.54,0:57:38.41,Default,,0,0,0,,Мен де бірге жарқ еттім.
Dialogue: 0,0:57:39.45,0:57:43.08,Default,,0,0,0,,Мен Аманданың тірі болғанын қалаймын.
Dialogue: 0,0:57:43.16,0:57:46.29,Default,,0,0,0,,Маған сені көрудің қажеті жоқ, сенің тірі болғаныңды қалаймын.
Dialogue: 0,0:57:49.66,0:57:50.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:53.25,0:57:56.00,Default,,0,0,0,,Уфуфу... Радж болса, бір күні кездескенше.
Dialogue: 0,0:57:56.08,0:57:58.66,Default,,0,0,0,,Сіз Аманда сияқты тамаша достарды кездестіресіз.
Dialogue: 0,0:57:58.75,0:58:03.20,Default,,0,0,0,,Ан, Коюки-чан алдымен дос табады.
Dialogue: 0,0:58:03.29,0:58:05.66,Default,,0,0,0,,Иә, Коюки-чан бірінші болуы мүмкін.
Dialogue: 0,0:58:05.75,0:58:08.08,Default,,0,0,0,,бірінші бірінші мен бірінші
Dialogue: 0,0:58:08.16,0:58:12.58,Default,,0,0,0,,Радждың сәтсіздігінің арқасында мен шын аспанды біраз уақыттан кейін алғаш рет көрдім.
Dialogue: 0,0:58:19.37,0:58:21.37,Default,,0,0,0,,Жүр, үйге тез қайтайық.
Dialogue: 0,0:58:23.33,0:58:25.62,Default,,0,0,0,,Оң жақ есік керек жерде
Dialogue: 0,0:58:25.70,0:58:27.87,Default,,0,0,0,,Оң жақ есік керек жерде
Dialogue: 0,0:58:27.95,0:58:30.95,Default,,0,0,0,,Оң жақ есік керек жерде
Dialogue: 0,0:58:34.58,0:58:35.54,Default,,0,0,0,,Ах хаха...
Dialogue: 0,0:58:35.62,0:58:37.37,Default,,0,0,0,,
Dialogue: 0,0:58:38.54,0:58:39.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:39.45,0:58:40.70,Default,,0,0,0,,Хун хун хун (металл дыбыс)
Dialogue: 0,0:58:40.70,0:58:42.75,Default,,0,0,0,,(металл дыбысы)
Dialogue: 0,0:58:40.79,0:58:42.75,Default,,0,0,0,,Не болды? Рудж
Dialogue: 0,0:58:45.33,0:58:47.00,Default,,0,0,0,,
Dialogue: 0,0:58:50.08,0:58:52.50,Default,,0,0,0,,- Мен жалғастырамын - (Пунё Пунё) Пунё
Dialogue: 0,0:58:52.58,0:58:54.00,Default,,0,0,0,,
Dialogue: 0,0:58:55.66,0:58:58.00,Default,,0,0,0,,Эмили, сәлем, сәлем.
Dialogue: 0,0:58:58.58,0:59:02.00,Default,,0,0,0,,Достарымыз ұмытқанның орнына бізді жеп қойса ше?
Dialogue: 0,0:59:02.58,0:59:05.50,Default,,0,0,0,,Бұл тағы да оқиға...
Dialogue: 0,0:59:05.58,0:59:09.75,Default,,0,0,0,,Сәлем! Біздің адамдық достарымыз жеп қойса не болады?
Dialogue: 0,0:59:11.25,0:59:15.00,Default,,0,0,0,,Сенің жүрегің өлген жоқ па? Тесік бар
Dialogue: 0,0:59:16.20,0:59:18.41,Default,,0,0,0,,Эмили, маған сеніңіз
Dialogue: 0,0:59:18.50,0:59:20.41,Default,,0,0,0,,Не!? Рудж не?
Dialogue: 0,0:59:20.50,0:59:22.16,Default,,0,0,0,,- (Реджер) Мен міндетті түрде қайтамын! - (Коюки-чан) Эмили
Dialogue: 0,0:59:22.25,0:59:24.70,Default,,0,0,0,,Бұл автобус. Автобус келді.
Dialogue: 0,0:59:28.91,0:59:30.16,Default,,0,0,0,,Рудж...
Dialogue: 0,0:59:32.20,0:59:33.29,Default,,0,0,0,,Бунтинг!
Dialogue: 0,0:59:34.12,0:59:38.54,Default,,0,0,0,,А, мынау, мынау мынау иіс.
Dialogue: 0,0:59:38.62,0:59:43.29,Default,,0,0,0,,Хмм, бұл шынымен ностальгиялық иіс. Менің ойымша, ол жоғалған жоқ.
Dialogue: 0,0:59:44.66,0:59:47.29,Default,,0,0,0,,Сіз қалай аман қалдыңыз?
Dialogue: 0,0:59:47.37,0:59:50.29,Default,,0,0,0,,Бұл жас ханымның тірі екенін білдіре ме?
Dialogue: 0,0:59:52.41,0:59:56.41,Default,,0,0,0,,Хмм, басқаша көрінеді. Хош иіс сәл өзгерді, Роджер.
Dialogue: 0,0:59:57.00,0:59:59.41,Default,,0,0,0,,Бұл сенсің! Бұл сенің кінәң
Dialogue: 0,0:59:59.50,1:00:04.62,Default,,0,0,0,,Мен ештеңе істемедім, сен кінәлісің, сен қашып кеттің.
Dialogue: 0,1:00:04.70,1:00:07.91,Default,,0,0,0,,Кішкентай қыз апатқа ұшырады, солай ма?
Dialogue: 0,1:00:09.33,1:00:10.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:00:10.50,1:00:12.87,Default,,0,0,0,,Ешқандай айырмашылық жоқ
Dialogue: 0,1:00:12.95,1:00:18.37,Default,,0,0,0,,Сіз көрдіңіз бе, әлде мен көрдім бе.
Dialogue: 0,1:00:19.16,1:00:21.45,Default,,0,0,0,,Әркім не көргісі келсе, соны көреді
Dialogue: 0,1:00:21.54,1:00:25.87,Default,,0,0,0,,Сіз көре алмайтын нәрсе, сайып келгенде, сіз көргіңіз келмейтін нәрсе.
Dialogue: 0,1:00:26.62,1:00:28.00,Default,,0,0,0,,Ресми құжаттарды жариялаған екен.
Dialogue: 0,1:00:30.16,1:00:34.54,Default,,0,0,0,,Роджер, сені ешкім көре алмайды деп қорқамын.
Dialogue: 0,1:00:34.62,1:00:36.58,Default,,0,0,0,,Даусыңды да естімеймін, яғни.
Dialogue: 0,1:00:36.66,1:00:39.95,Default,,0,0,0,,Себебі сені ешкім көргісі келмейді.
Dialogue: 0,1:00:40.04,1:00:42.29,Default,,0,0,0,,Сіз әлі де осында болғыңыз келе ме?
Dialogue: 0,1:00:42.37,1:00:47.12,Default,,0,0,0,,Төгілген көз жасыңды да ешкім көрмейтін бұл дүниеде
Dialogue: 0,1:00:47.20,1:00:49.79,Default,,0,0,0,,О... жоқ, Бантинг.
Dialogue: 0,1:00:49.87,1:00:53.54,Default,,0,0,0,,Бұл не? Агагагага...
Dialogue: 0,1:00:53.62,1:00:56.87,Default,,0,0,0,,Көз жасымды төкпеймін Жыламаймын!
Dialogue: 0,1:00:59.83,1:01:00.83,Default,,0,0,0,,Рудж?
Dialogue: 0,1:01:03.33,1:01:05.04,Default,,0,0,0,,Менің қасымда біреу бар
Dialogue: 0,1:01:08.00,1:01:11.75,Default,,0,0,0,,Хахаха... Ахахха
Dialogue: 0,1:01:24.33,1:01:25.33,Default,,0,0,0,,Ах
Dialogue: 0,1:01:27.04,1:01:30.58,Default,,0,0,0,,- (Лиззи) Голди Рахмет - (Голди) Маған қайта хабарласыңыз.
Dialogue: 0,1:01:30.66,1:01:32.66,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,1:01:40.95,1:01:43.20,Default,,0,0,0,,- (Лиззи) Сау болыңыз - (Голди жігіті) Қайырлы түн.
Dialogue: 0,1:01:44.12,1:01:47.62,Default,,0,0,0,,(көліктің кетіп бара жатқан дыбысы)
Dialogue: 0,1:01:58.41,1:02:01.83,Default,,0,0,0,,Ха ха...
Dialogue: 0,1:02:04.00,1:02:05.16,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,1:02:11.70,1:02:13.87,Default,,0,0,0,,Жарайды, неге кішкене демалмайсың?
Dialogue: 0,1:02:13.95,1:02:15.91,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,1:02:18.08,1:02:22.00,Default,,0,0,0,,Ауруханада бірге тұра аламыз ба деп ойлаймын.
Dialogue: 0,1:02:22.58,1:02:24.08,Default,,0,0,0,,Менің қолымнан келмейтін сияқты.
Dialogue: 0,1:02:26.58,1:02:30.20,Default,,0,0,0,,Оянғанда мені қатты құшақтап ал.
Dialogue: 0,1:02:30.29,1:02:35.37,Default,,0,0,0,,Жарайды, ол бала міндетті түрде оянады.
Dialogue: 0,1:02:36.00,1:02:39.75,Default,,0,0,0,,Бұл Аманда, ол маған қарай жүгіріп келеді.
Dialogue: 0,1:02:39.83,1:02:43.25,Default,,0,0,0,,Ол мені көріп, бірдеңе айтқысы келді.
Dialogue: 0,1:02:43.33,1:02:45.75,Default,,0,0,0,,Ол мені құшақтайтын сияқты
Dialogue: 0,1:02:45.83,1:02:48.41,Default,,0,0,0,,Өзің кінәлі деп ойлама
Dialogue: 0,1:02:50.20,1:02:52.20,Default,,0,0,0,,Лиззи, жақсысың ба?
Dialogue: 0,1:02:52.29,1:02:53.87,Default,,0,0,0,,Кешіріңіз анашым
Dialogue: 0,1:02:53.95,1:02:57.37,Default,,0,0,0,,Мен ертең ауруханаға апаратын нәрсе дайындаймын.
Dialogue: 0,1:02:57.45,1:02:59.25,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:03:34.70,1:03:39.37,Default,,0,0,0,,«Құрметті Раджа, бұл қорапты ашпа».
Dialogue: 0,1:03:39.45,1:03:41.95,Default,,0,0,0,,Мен раджа емеспін
Dialogue: 0,1:03:49.12,1:03:50.91,Default,,0,0,0,,күрсіну...
Dialogue: 0,1:04:06.33,1:04:07.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:20.62,1:04:25.75,Default,,0,0,0,,Иә, сенің сүйікті әкең мұны саған да сатып алды.
Dialogue: 0,1:04:34.91,1:04:36.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:35.41,1:04:36.87,Default,,0,0,0,,«Әкеңді ұмытпа»
Dialogue: 0,1:04:36.95,1:04:39.33,Default,,0,0,0,,«Ананы қорға, жылама»
Dialogue: 0,1:04:49.62,1:04:53.41,Default,,0,0,0,,(Лиззидің жылағаны)
Dialogue: 0,1:04:57.79,1:05:00.62,Default,,0,0,0,,Бұл туралы не деуге болады? Сіз үйрендіңіз бе?
Dialogue: 0,1:05:00.70,1:05:04.54,Default,,0,0,0,,Аа, бұл да кітап дүкені ме? Менің ойымша, бұл жақсы.
Dialogue: 0,1:05:04.62,1:05:08.25,Default,,0,0,0,,Күрделі кітаптар жақсы, бірақ қызықты кітаптарды да дұрыс орналастыру керек!
Dialogue: 0,1:05:08.33,1:05:10.58,Default,,0,0,0,,Сонда ол өте танымал болады.
Dialogue: 0,1:05:11.45,1:05:12.79,Default,,0,0,0,,Ана?
Dialogue: 0,1:05:12.87,1:05:15.41,Default,,0,0,0,,Анам сыра ішіп, түн ортасында жылады.
Dialogue: 0,1:05:15.50,1:05:17.58,Default,,0,0,0,,Иә Green Lager
Dialogue: 0,1:05:17.66,1:05:20.91,Default,,0,0,0,,Бірақ мен анамды дұрыс қорғаймын.
Dialogue: 0,1:05:21.00,1:05:24.29,Default,,0,0,0,,Мен? Мен жалғызбын, бірақ жыламаймын
Dialogue: 0,1:05:24.37,1:05:27.37,Default,,0,0,0,,Өйткені сен жыласаң, әкең уайымдайтын еді ғой, солай ма?
Dialogue: 0,1:05:28.58,1:05:33.16,Default,,0,0,0,,Әке, көп достар тап.
Dialogue: 0,1:05:33.25,1:05:38.91,Default,,0,0,0,,Кейде...
Dialogue: 0,1:05:39.50,1:05:41.25,Default,,0,0,0,,Маған хатыңызды беріңізші.
Dialogue: 0,1:05:50.29,1:05:52.54,Default,,0,0,0,,Әке, сен неге өлдің?
Dialogue: 0,1:06:18.20,1:06:20.25,Default,,0,0,0,,Әкеңді ұмытпа
Dialogue: 0,1:06:28.12,1:06:29.83,Default,,0,0,0,,Ананы қорғау
Dialogue: 0,1:06:36.20,1:06:37.33,Default,,0,0,0,,Содан кейін
Dialogue: 0,1:06:41.33,1:06:44.37,Default,,0,0,0,,Ешқашан жылама
Dialogue: 0,1:06:50.08,1:06:51.29,Default,,0,0,0,,Түсінікті!
Dialogue: 0,1:06:57.58,1:07:00.66,Default,,0,0,0,,Сол күні мен дүниеге келдім
Dialogue: 0,1:07:08.95,1:07:10.08,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,1:07:14.00,1:07:15.83,Default,,0,0,0,,Әке, өтінемін
Dialogue: 0,1:07:17.91,1:07:19.75,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:07:20.29,1:07:21.20,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,1:07:22.00,1:07:23.29,Default,,0,0,0,,Аманда...
Dialogue: 0,1:07:25.16,1:07:27.16,Default,,0,0,0,,Баланы қорғаңыз
Dialogue: 0,1:07:43.79,1:07:46.12,Default,,0,0,0,,Уф...
Dialogue: 0,1:07:46.20,1:07:47.87,Default,,0,0,0,,Уау...
Dialogue: 0,1:07:49.16,1:07:50.20,Default,,0,0,0,,Ой...
Dialogue: 0,1:07:50.29,1:07:54.41,Default,,0,0,0,,Түсіндім, неге ерекше екеніңді түсіндім.
Dialogue: 0,1:07:55.00,1:08:00.16,Default,,0,0,0,,Сізде құпия ингредиент, мұңның күшті дәмдеуіштері бар.
Dialogue: 0,1:08:00.75,1:08:04.66,Default,,0,0,0,,Сонда бәрі жақсы, сені мен жеуім керек емес пе?
Dialogue: 0,1:08:05.29,1:08:10.16,Default,,0,0,0,,Жоғалсаң, қыздың мұңы кетеді.
Dialogue: 0,1:08:10.25,1:08:12.66,Default,,0,0,0,,Жоқ, Роджер.
Dialogue: 0,1:08:34.45,1:08:37.16,Default,,0,0,0,,Балалар бәрібір жоғалып кетесіңдер.
Dialogue: 0,1:08:37.66,1:08:41.33,Default,,0,0,0,,Менің мұнда тамақ ішуімнің қандай айырмашылығы бар?
Dialogue: 0,1:08:46.75,1:08:48.25,Default,,0,0,0,,Ей!
Dialogue: 0,1:08:50.50,1:08:51.50,Default,,0,0,0,,Эмили!
Dialogue: 0,1:08:53.20,1:08:54.29,Default,,0,0,0,,Міне!
Dialogue: 0,1:08:54.87,1:08:56.25,Default,,0,0,0,,Бұл Бантинг
Dialogue: 0,1:08:56.75,1:08:57.79,Default,,0,0,0,,Мен білемін!
Dialogue: 0,1:09:04.50,1:09:05.79,Default,,0,0,0,,(Болады)
Dialogue: 0,1:09:10.58,1:09:13.45,Default,,0,0,0,,Эмили, сен тірісің!
Dialogue: 0,1:09:13.54,1:09:14.83,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,1:09:14.91,1:09:16.79,Default,,0,0,0,,Аманда тірі!
Dialogue: 0,1:09:16.87,1:09:18.16,Default,,0,0,0,,Не?
Dialogue: 0,1:09:18.25,1:09:21.29,Default,,0,0,0,,Аманда... Аманда ауруханада тірі!
Dialogue: 0,1:09:22.62,1:09:24.00,Default,,0,0,0,,Мен бәрібір қашып кетемін
Dialogue: 0,1:09:27.33,1:09:29.54,Default,,0,0,0,,Жұмыс біткен соң, үйге ерте қайт!
Dialogue: 0,1:09:29.62,1:09:30.54,Default,,0,0,0,,Цзиньзан
Dialogue: 0,1:09:30.62,1:09:31.91,Default,,0,0,0,,Коюки-чан ше?
Dialogue: 0,1:09:32.00,1:09:33.62,Default,,0,0,0,,Мен үйде жылап отырмын.
Dialogue: 0,1:09:35.04,1:09:36.54,Default,,0,0,0,,«Жақында оралуыңызды өтінемін.»
Dialogue: 0,1:09:37.37,1:09:39.66,Default,,0,0,0,,Бәріміз үйге қайтайық
Dialogue: 0,1:09:46.83,1:09:48.54,Default,,0,0,0,,Джинзан мұнда ма?
Dialogue: 0,1:09:49.12,1:09:50.58,Default,,0,0,0,,Бұл солай болуы керек.
Dialogue: 0,1:09:51.20,1:09:52.41,Default,,0,0,0,,Есік ше?
Dialogue: 0,1:09:56.75,1:09:58.95,Default,,0,0,0,,Бұл тас қараңғы, Джинзан.
Dialogue: 0,1:09:59.45,1:10:01.04,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,1:10:02.62,1:10:06.41,Default,,0,0,0,,Маған күн жарқырап тұрған сияқты
Dialogue: 0,1:10:09.12,1:10:13.62,Default,,0,0,0,,(♪Бантингтің гуілдеуі)
Dialogue: 0,1:10:14.12,1:10:15.87,Default,,0,0,0,,Бантинг
Dialogue: 0,1:10:15.95,1:10:17.54,Default,,0,0,0,,Джинзан Әлі емес пе?
Dialogue: 0,1:10:17.62,1:10:20.04,Default,,0,0,0,,Бұл біртүрлі. Бірдеңе дұрыс емес.
Dialogue: 0,1:10:20.62,1:10:24.00,Default,,0,0,0,,Маған қыз бен мысық қызық емес.
Dialogue: 0,1:10:24.54,1:10:28.54,Default,,0,0,0,,Өкінішке орай, мен тек жаңа заттарды қабылдаймын.
Dialogue: 0,1:10:29.12,1:10:30.12,Default,,0,0,0,,Зинзан!
Dialogue: 0,1:10:33.12,1:10:37.00,Default,,0,0,0,,Өніп бара жатқан қиял нағыз керемет хош иіс береді.
Dialogue: 0,1:10:40.45,1:10:43.37,Default,,0,0,0,,Роджер, мен сені жегенше.
Dialogue: 0,1:10:43.45,1:10:46.04,Default,,0,0,0,,Маған маңызды нәрсе айтайын
Dialogue: 0,1:10:46.12,1:10:51.54,Default,,0,0,0,,Сен екеуміз басқамыз. Сіз елестедіңіз.
Dialogue: 0,1:10:51.62,1:10:54.50,Default,,0,0,0,,Бірақ мен керісіншемін.
Dialogue: 0,1:10:55.54,1:11:00.75,Default,,0,0,0,,Түсіндің бе? Мен елестететін адаммын.
Dialogue: 0,1:11:06.50,1:11:07.79,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,1:11:07.87,1:11:11.12,Default,,0,0,0,,Мен сендер білмейтін әлемге саяхаттап барамын.
Dialogue: 0,1:11:11.20,1:11:13.66,Default,,0,0,0,,Мен көп нәрсені көрдім
Dialogue: 0,1:11:13.75,1:11:17.79,Default,,0,0,0,,Мен көптеген туындыларды көрдім, барлық жерде.
Dialogue: 0,1:11:18.37,1:11:20.79,Default,,0,0,0,,Көрінбейтіндерді жеп жатқанда.
Dialogue: 0,1:11:22.37,1:11:25.95,Default,,0,0,0,,Менен қаша алмайсың, беріл.
Dialogue: 0,1:11:27.54,1:11:28.54,Default,,0,0,0,,Рудж
Dialogue: 0,1:11:29.50,1:11:31.29,Default,,0,0,0,,Рудж Тыңдап жатырсың ба?
Dialogue: 0,1:11:33.95,1:11:36.41,Default,,0,0,0,,Неліктен бұл туралы ойламайсың?
Dialogue: 0,1:11:40.87,1:11:43.79,Default,,0,0,0,,Менің досым туылғаннан бері ауруханада жатыр.
Dialogue: 0,1:11:43.87,1:11:46.50,Default,,0,0,0,,Мен ұмытылған жоқпын
Dialogue: 0,1:11:46.58,1:11:50.12,Default,,0,0,0,,Менің досым кәмелетке толмағанша қайтыс болды.
Dialogue: 0,1:11:55.87,1:11:58.79,Default,,0,0,0,,Ұмыту мен алып кетудің айырмашылығы бар!
Dialogue: 0,1:11:58.87,1:12:00.62,Default,,0,0,0,,Ой-оу!
Dialogue: 0,1:12:05.12,1:12:07.20,Default,,0,0,0,,Радж Аманды әлі де көре алады.
Dialogue: 0,1:12:10.50,1:12:12.29,Default,,0,0,0,,Бала, есікті тап.
Dialogue: 0,1:12:12.37,1:12:15.33,Default,,0,0,0,,Есік Мен қайда қарауым керек...
Dialogue: 0,1:12:16.45,1:12:18.79,Default,,0,0,0,,Міне, келдің! Бар!
Dialogue: 0,1:12:18.87,1:12:20.29,Default,,0,0,0,,Иә
Dialogue: 0,1:12:23.87,1:12:24.79,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,1:12:26.25,1:12:28.25,Default,,0,0,0,,Құдай-ай!! Бұл да…
Dialogue: 0,1:12:41.41,1:12:42.83,Default,,0,0,0,,Ей!
Dialogue: 0,1:12:48.45,1:12:51.45,Default,,0,0,0,,(Жарғанат дыбысы)
Dialogue: 0,1:12:55.25,1:13:00.41,Default,,0,0,0,,Қашқаннан пайда жоқ Үміт іздеуден пайда жоқ
Dialogue: 0,1:13:00.50,1:13:04.29,Default,,0,0,0,,Соңында бәрің жалғыз жоғалып кетесіңдер.
Dialogue: 0,1:13:09.08,1:13:10.29,Default,,0,0,0,,не үшін шайқасып жүрсің?
Dialogue: 0,1:13:20.79,1:13:22.45,Default,,0,0,0,,Эмили! Зинзан!
Dialogue: 0,1:13:22.54,1:13:24.20,Default,,0,0,0,,Үлкен бала
Dialogue: 0,1:13:25.58,1:13:27.58,Default,,0,0,0,,Әлі түсінбедіңіз бе?
Dialogue: 0,1:13:31.45,1:13:34.00,Default,,0,0,0,,Хмм, бұл ұят.
Dialogue: 0,1:13:35.91,1:13:38.58,Default,,0,0,0,,Бұл да менің қиялым ғана.
Dialogue: 0,1:13:40.04,1:13:40.87,Default,,0,0,0,,Бан
Dialogue: 0,1:13:48.20,1:13:49.04,Default,,0,0,0,,Эмили!
Dialogue: 0,1:13:49.12,1:13:52.79,Default,,0,0,0,,Сіз қиялдар ештеңені өзгерте алмайсыз.
Dialogue: 0,1:13:53.37,1:13:54.45,Default,,0,0,0,,Маған кіруге рұқсат етіңіз.
Dialogue: 0,1:13:54.54,1:13:56.12,Default,,0,0,0,,Эмили фирмасы
Dialogue: 0,1:13:56.20,1:13:57.29,Default,,0,0,0,,Рудж
Dialogue: 0,1:13:58.25,1:14:02.62,Default,,0,0,0,,Бұл көзілдірік менің нағыз досым.
Dialogue: 0,1:14:02.70,1:14:04.62,Default,,0,0,0,,Сіз елестедіңіз...
Dialogue: 0,1:14:07.62,1:14:09.58,Default,,0,0,0,,- Эмилиді ояту - (Рэджер) Эмили
Dialogue: 0,1:14:10.70,1:14:12.70,Default,,0,0,0,,- Радж - (Рэджер) Иә.
Dialogue: 0,1:14:12.79,1:14:15.45,Default,,0,0,0,,Амандаға сәлем айтыңыз
Dialogue: 0,1:14:15.54,1:14:17.33,Default,,0,0,0,,Мен білемін, білемін
Dialogue: 0,1:14:17.41,1:14:18.79,Default,,0,0,0,,Эмили
Dialogue: 0,1:14:18.87,1:14:22.37,Default,,0,0,0,,Қиял ешқашан жеңе алмайтын нәрселер бар.
Dialogue: 0,1:14:22.45,1:14:24.45,Default,,0,0,0,,Бұл шындық.
Dialogue: 0,1:14:24.54,1:14:28.25,Default,,0,0,0,,Эмили... Эмили!
Dialogue: 0,1:14:43.75,1:14:46.29,Default,,0,0,0,,Рудж! Зинзаан!
Dialogue: 0,1:14:46.87,1:14:48.75,Default,,0,0,0,,Қайтып келдің!
Dialogue: 0,1:14:48.83,1:14:52.75,Default,,0,0,0,,Кеш болды. Бүгінгі қала - Нагасаки, Дежима.
Dialogue: 0,1:14:52.83,1:14:55.79,Default,,0,0,0,,Коюки-чан Эмили... Эмили жоғалып кетті.
Dialogue: 0,1:14:56.62,1:14:59.75,Default,,0,0,0,,Эмили мен үшін жоғалып кетті.
Dialogue: 0,1:14:59.83,1:15:01.54,Default,,0,0,0,,Радж, не болды?
Dialogue: 0,1:15:01.62,1:15:04.87,Default,,0,0,0,,Ол Эмилиді жойды.
Dialogue: 0,1:15:04.95,1:15:06.29,Default,,0,0,0,,Иә!
Dialogue: 0,1:15:07.29,1:15:11.41,Default,,0,0,0,,Ол? Эмили? Бұл кім?
Dialogue: 0,1:15:11.50,1:15:12.75,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,1:15:13.37,1:15:16.04,Default,,0,0,0,,Радждың жаңа досы!
Dialogue: 0,1:15:16.12,1:15:19.70,Default,,0,0,0,,Қызық, Коюки-чан маған да дос бола ала ма?
Dialogue: 0,1:15:20.58,1:15:23.54,Default,,0,0,0,,Не болды? Сіз кім туралы айтып тұрсыз?
Dialogue: 0,1:15:23.62,1:15:25.20,Default,,0,0,0,,Қызық, мен бір бола аламын ба?
Dialogue: 0,1:15:25.79,1:15:28.58,Default,,0,0,0,,Бантинг біреуді ұрды ма?
Dialogue: 0,1:15:28.66,1:15:32.54,Default,,0,0,0,,Джинзан, дәл қазір... көз алдымызда.
Dialogue: 0,1:15:33.25,1:15:38.04,Default,,0,0,0,,Құдай-ау, анау бала бізге жақын болды ма?
Dialogue: 0,1:15:38.12,1:15:41.37,Default,,0,0,0,,Дос бола аламыз ба деп ойлаймын
Dialogue: 0,1:15:45.37,1:15:46.54,Default,,0,0,0,,Не болды?
Dialogue: 0,1:15:47.20,1:15:48.50,Default,,0,0,0,,Амансың ба, балам?
Dialogue: 0,1:15:50.41,1:15:51.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:52.54,1:15:53.91,Default,,0,0,0,,Рудж
Dialogue: 0,1:16:00.58,1:16:03.83,Default,,0,0,0,,Жоқ, мен ол шетелдік қыз туралы білмеймін.
Dialogue: 0,1:16:03.91,1:16:04.75,Default,,0,0,0,,Хмм
Dialogue: 0,1:16:04.83,1:16:06.83,Default,,0,0,0,,Мұнда емес
Dialogue: 0,1:16:06.91,1:16:09.12,Default,,0,0,0,,А, мен оны ешқашан көрген емеспін.
Dialogue: 0,1:16:16.75,1:16:18.83,Default,,0,0,0,,That Кид was a good Кид.
Dialogue: 0,1:16:19.83,1:16:23.75,Default,,0,0,0,,Ол шыншыл, жарқын, күлкісі өте сүйкімді.
Dialogue: 0,1:16:24.33,1:16:26.25,Default,,0,0,0,,Have you not forgotten?
Dialogue: 0,1:16:27.04,1:16:32.25,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Есіңізде болса да, ол балаға не болған?
Dialogue: 0,1:16:33.29,1:16:35.75,Default,,0,0,0,,Бунтинг өшірілді
Dialogue: 0,1:16:36.33,1:16:40.91,Default,,0,0,0,,What does it mean to be erased? Бұлай болуы мүмкін емес.
Dialogue: 0,1:16:41.00,1:16:44.25,Default,,0,0,0,,Әңгіме Бантинг қиялға шабуыл жасайды.
Dialogue: 0,1:16:44.83,1:16:47.04,Default,,0,0,0,,You can't attack my Lizzie.
Dialogue: 0,1:16:47.12,1:16:50.25,Default,,0,0,0,,Who are you talking about?
Dialogue: 0,1:16:50.33,1:16:55.25,Default,,0,0,0,,Элизабет досым Лиззидің әңгімесі
Dialogue: 0,1:16:56.00,1:16:57.25,Default,,0,0,0,,Лиззи?
Dialogue: 0,1:16:57.33,1:17:01.29,Default,,0,0,0,,Менің досымның анасы да Лиззи деп аталады.
Dialogue: 0,1:17:02.00,1:17:04.25,Default,,0,0,0,,No doubt, it's true.
Dialogue: 0,1:17:05.37,1:17:07.91,Default,,0,0,0,,Ол бала қазір бақытты ма?
Dialogue: 0,1:17:08.41,1:17:11.00,Default,,0,0,0,,Сіз ересек адам ретінде бақытты болдыңыз ба?
Dialogue: 0,1:17:11.08,1:17:12.75,Default,,0,0,0,,Ана... Ана...
Dialogue: 0,1:17:14.58,1:17:18.87,Default,,0,0,0,,Жұмыс қиын болып көрінсе де, анам бақытты деп ойлаймын.
Dialogue: 0,1:17:18.95,1:17:22.83,Default,,0,0,0,,Сонда да ол бізді саябаққа, бассейнге апарады.
Dialogue: 0,1:17:22.91,1:17:25.58,Default,,0,0,0,,Mom's cookies are really delicious too.
Dialogue: 0,1:17:29.33,1:17:33.16,Default,,0,0,0,,So did he ever talk to you?
Dialogue: 0,1:17:33.25,1:17:34.41,Default,,0,0,0,,Мен ше?
Dialogue: 0,1:17:35.12,1:17:36.25,Default,,0,0,0,,Сіз ше?
Dialogue: 0,1:17:36.33,1:17:38.83,Default,,0,0,0,,Рейзуко туралы
Dialogue: 0,1:17:38.91,1:17:42.25,Default,,0,0,0,,Менің атым Рейзоко.
Dialogue: 0,1:17:43.66,1:17:48.87,Default,,0,0,0,,Аманданың анасы ас үйдегі үлкен жәшікке сенің атыңды берді.
Dialogue: 0,1:17:48.95,1:17:50.75,Default,,0,0,0,,Мен сенің атыңды күнде атаймын
Dialogue: 0,1:17:50.83,1:17:54.75,Default,,0,0,0,,Түсіндім, әлі есіңізде ме?
Dialogue: 0,1:17:54.83,1:17:57.08,Default,,0,0,0,,Менің досым
Dialogue: 0,1:17:59.20,1:18:01.83,Default,,0,0,0,,Кешіріңіз, анашым...
Dialogue: 0,1:18:01.91,1:18:05.04,Default,,0,0,0,,Анам жасайтын печенье дәмді ме?
Dialogue: 0,1:18:06.95,1:18:11.45,Default,,0,0,0,,Бұл жақсы. Рас па, өтірік пе, бәрібір.
Dialogue: 0,1:18:11.54,1:18:16.75,Default,,0,0,0,,Бір нәрсеге сенгің келсе, сенген жөн.
Dialogue: 0,1:18:18.50,1:18:22.75,Default,,0,0,0,,Маңыздысы сен сенетін оқиға.
Dialogue: 0,1:18:26.95,1:18:28.50,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,1:18:29.20,1:18:31.75,Default,,0,0,0,,Рахмет сізге Рейзуко
Dialogue: 0,1:18:38.08,1:18:41.75,Default,,0,0,0,,«Нағыз досты таныстыру агенттігі»
Dialogue: 0,1:18:45.70,1:18:47.20,Default,,0,0,0,,Қайырлы таң Радж
Dialogue: 0,1:18:47.83,1:18:50.50,Default,,0,0,0,,Бала, қайда бара жатырсың?
Dialogue: 0,1:18:50.58,1:18:55.00,Default,,0,0,0,,Аманданың ауруханасына барыңыз. Сізді адам досыңыз сонда апарсын.
Dialogue: 0,1:18:55.58,1:18:57.62,Default,,0,0,0,,Қай аурухана екенін де білмеймін.
Dialogue: 0,1:18:58.33,1:19:01.16,Default,,0,0,0,,Бұлт сіздің иісіңізді сезеді
Dialogue: 0,1:19:01.25,1:19:03.62,Default,,0,0,0,,Сіз ауруханаға жеткенше жейсіз.
Dialogue: 0,1:19:05.12,1:19:07.62,Default,,0,0,0,,Бала тірі болса да
Dialogue: 0,1:19:07.70,1:19:10.04,Default,,0,0,0,,Ол бала енді сені есіне түсірмейді.
Dialogue: 0,1:19:11.20,1:19:14.08,Default,,0,0,0,,Сол кезде жоғалып кеттің.
Dialogue: 0,1:19:14.16,1:19:16.45,Default,,0,0,0,,Баланы тауып алсам да
Dialogue: 0,1:19:16.54,1:19:18.62,Default,,0,0,0,,Сіз жоғалып кетесіз.
Dialogue: 0,1:19:19.37,1:19:24.04,Default,,0,0,0,,Адамдар бізді ұмытады, оған көмектесу мүмкін емес.
Dialogue: 0,1:19:24.12,1:19:26.25,Default,,0,0,0,,Өйткені біз қиялымыз
Dialogue: 0,1:19:26.79,1:19:30.62,Default,,0,0,0,,Бұл жақсы емес пе? Өтірік дос болған жақсы емес пе?
Dialogue: 0,1:19:30.70,1:19:33.37,Default,,0,0,0,,Бала, сен әлі...
Dialogue: 0,1:19:33.45,1:19:36.37,Default,,0,0,0,,Джинзан Мен де жоғалып кетуден қорқамын.
Dialogue: 0,1:19:36.45,1:19:38.87,Default,,0,0,0,,Мен де Бантинг жеп қоя ма деп қорқамын.
Dialogue: 0,1:19:39.62,1:19:40.91,Default,,0,0,0,,Бірақ мен барамын
Dialogue: 0,1:19:41.00,1:19:44.12,Default,,0,0,0,,Мен жоғалып кетсем де, мені ешкім көрмесе де
Dialogue: 0,1:19:44.20,1:19:46.62,Default,,0,0,0,,Амандамен өткізген уақытым өтірік емес еді.
Dialogue: 0,1:19:46.70,1:19:48.12,Default,,0,0,0,,Барлығы...
Dialogue: 0,1:19:48.20,1:19:51.75,Default,,0,0,0,,Бүкіл әлем өтірік десе де, мен сенемін.
Dialogue: 0,1:19:51.83,1:19:54.83,Default,,0,0,0,,Мен Аманданың досы болғаныма қуаныштымын.
Dialogue: 0,1:19:56.20,1:19:57.20,Default,,0,0,0,,Рудж...
Dialogue: 0,1:19:58.20,1:20:00.62,Default,,0,0,0,,Зинзан Мен Амандамен кездескім келеді.
Dialogue: 0,1:20:00.70,1:20:03.62,Default,,0,0,0,,Оянып, қолыңнан келгеннің бәрін жаса дегім келеді.
Dialogue: 0,1:20:04.20,1:20:06.29,Default,,0,0,0,,Мен әрқашан сонда боламын
Dialogue: 0,1:20:06.37,1:20:09.12,Default,,0,0,0,,«Мен сенің жағындамын» дегім келеді.
Dialogue: 0,1:20:09.87,1:20:12.08,Default,,0,0,0,,Мен жоғалып кетпес бұрын
Dialogue: 0,1:20:14.75,1:20:17.62,Default,,0,0,0,,«Прима балерина Юлия»
Dialogue: 0,1:20:17.04,1:20:19.83,Default,,0,0,0,,Джулия... Аманданың досы.
Dialogue: 0,1:20:22.70,1:20:25.25,Default,,0,0,0,,Бұл менің...
Dialogue: 0,1:20:25.33,1:20:28.12,Default,,0,0,0,,Бұл ешкім көре алмайтын біздің жекпе-жек
Dialogue: 0,1:20:29.12,1:20:31.95,Default,,0,0,0,,Джинзан, бұл менің жауабым.
Dialogue: 0,1:20:35.70,1:20:36.83,Default,,0,0,0,,Бала!
Dialogue: 0,1:20:36.91,1:20:37.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:46.79,1:20:50.66,Default,,0,0,0,,Хмм, жоқ, жоқ, не болып жатыр?
Dialogue: 0,1:20:51.29,1:20:53.91,Default,,0,0,0,,Бұл мүлдем орындалмады!
Dialogue: 0,1:20:54.50,1:20:59.00,Default,,0,0,0,,Жақында ән айтылады. Сіз басты кейіпкерсіз, Аврора ханшайым!
Dialogue: 0,1:20:59.50,1:21:03.91,Default,,0,0,0,,Иә, Аврора ханшайымы? Джулия, мен Раджамын.
Dialogue: 0,1:21:04.00,1:21:05.41,Default,,0,0,0,,Роджер?
Dialogue: 0,1:21:05.50,1:21:08.95,Default,,0,0,0,,Жоқ, бұл Аманданың досы Раджа.
Dialogue: 0,1:21:09.04,1:21:12.41,Default,,0,0,0,,Өтінемін, Джулия, мені Аманданың ауруханасына апарыңыз!
Dialogue: 0,1:21:12.50,1:21:13.95,Default,,0,0,0,,Аманданың досы ма?
Dialogue: 0,1:21:14.04,1:21:16.91,Default,,0,0,0,,Не айтып тұрсың, менің полярым?
Dialogue: 0,1:21:17.50,1:21:22.91,Default,,0,0,0,,Okay, you're going to charm the whole audience at the venue after this.
Dialogue: 0,1:21:23.00,1:21:24.91,Default,,0,0,0,,Юлия, өтінемін.
Dialogue: 0,1:21:25.00,1:21:28.16,Default,,0,0,0,,I'm in a hurry because I have an important request...
Dialogue: 0,1:21:28.75,1:21:30.25,Default,,0,0,0,,Иә? Менің өтінішім бар...
Dialogue: 0,1:21:30.33,1:21:34.16,Default,,0,0,0,,Менің...мм, мені ауруханаға апарасың ба?
Dialogue: 0,1:21:34.75,1:21:35.95,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,1:21:36.04,1:21:40.16,Default,,0,0,0,,Джулия өзінің шынайы қиялы ретінде Раджды таңдады.
Dialogue: 0,1:21:40.25,1:21:42.41,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,1:21:42.50,1:21:44.16,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,1:21:45.95,1:21:51.37,Default,,0,0,0,,Yes, come on, Aurora-chan, next is the awakening pas de deux.
Dialogue: 0,1:21:51.45,1:21:53.45,Default,,0,0,0,,Е... а!
Dialogue: 0,1:21:53.54,1:21:55.95,Default,,0,0,0,,Юлия, сен кешігіп бара жатырсың.
Dialogue: 0,1:21:56.45,1:21:58.91,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,1:22:04.12,1:22:05.87,Default,,0,0,0,,Бала, фотоны жібер.
Dialogue: 0,1:22:12.20,1:22:13.41,Default,,0,0,0,,Wow
Dialogue: 0,1:22:13.50,1:22:15.41,Default,,0,0,0,,Балам, берік бол.
Dialogue: 0,1:22:15.50,1:22:17.12,Default,,0,0,0,,Радж, барасың ба?
Dialogue: 0,1:22:17.70,1:22:20.50,Default,,0,0,0,,Аманданы көруге барасыз ба?
Dialogue: 0,1:22:20.58,1:22:21.62,Default,,0,0,0,,Amanda...
Dialogue: 0,1:22:22.20,1:22:24.00,Default,,0,0,0,,Who is Amanda?
Dialogue: 0,1:22:24.08,1:22:25.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:25.20,1:22:26.87,Default,,0,0,0,,Мен сенің досыңмын
Dialogue: 0,1:22:29.00,1:22:30.58,Default,,0,0,0,,Аманда?
Dialogue: 0,1:22:31.75,1:22:32.95,Default,,0,0,0,,Amanda...
Dialogue: 0,1:22:34.20,1:22:35.75,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,1:22:36.54,1:22:38.70,Default,,0,0,0,,Julia, let's go.
Dialogue: 0,1:22:39.70,1:22:41.29,Default,,0,0,0,,Бүгін әкем де келеді.
Dialogue: 0,1:22:41.37,1:22:45.37,Default,,0,0,0,,Иә? Бұл рас па? Қызының туған күнін де ұмытады.
Dialogue: 0,1:22:45.45,1:22:48.12,Default,,0,0,0,,Мен барамын, барамын
Dialogue: 0,1:22:50.70,1:22:51.70,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,1:22:57.41,1:22:59.04,Default,,0,0,0,,Julia, wait.
Dialogue: 0,1:23:00.37,1:23:02.04,Default,,0,0,0,,Рудж Асығыңыз, асығыңыз
Dialogue: 0,1:23:02.83,1:23:04.20,Default,,0,0,0,,Hurry, boy
Dialogue: 0,1:23:04.29,1:23:05.29,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:05.37,1:23:07.08,Default,,0,0,0,,Тез, тез
Dialogue: 0,1:23:09.54,1:23:10.91,Default,,0,0,0,,Коюки-чан Таноми
Dialogue: 0,1:23:11.00,1:23:12.41,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:23:15.00,1:23:16.91,Default,,0,0,0,,Уау~
Dialogue: 0,1:23:22.16,1:23:23.25,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:23.33,1:23:24.50,Default,,0,0,0,,Let's go, boy!
Dialogue: 0,1:23:29.37,1:23:31.50,Default,,0,0,0,,Come quickly! Сіз Амандамен кездесесіз, солай ма?
Dialogue: 0,1:23:31.58,1:23:35.58,Default,,0,0,0,,Аманда... Иә, мен... Джулиямын!
Dialogue: 0,1:23:37.70,1:23:38.83,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:23:38.91,1:23:40.66,Default,,0,0,0,,Boy, this is it.
Dialogue: 0,1:23:41.62,1:23:43.41,Default,,0,0,0,,Good luck Rudge
Dialogue: 0,1:24:04.00,1:24:06.16,Default,,0,0,0,,- Can you fly? - (Аврора ханшайым) Әрине!
Dialogue: 0,1:24:10.58,1:24:11.50,Default,,0,0,0,,Уау
Dialogue: 0,1:24:11.58,1:24:12.79,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,1:24:12.87,1:24:15.25,Default,,0,0,0,,Анашым, бұл қазір қандай дыбыс?
Dialogue: 0,1:24:15.83,1:24:19.58,Default,,0,0,0,,Sound? Julia, what is sound?
Dialogue: 0,1:24:19.66,1:24:20.91,Default,,0,0,0,,Юлия!
Dialogue: 0,1:24:21.00,1:24:21.79,Default,,0,0,0,,I!
Dialogue: 0,1:24:21.87,1:24:24.66,Default,,0,0,0,,Аурухана! Ауруханаға
Dialogue: 0,1:24:24.75,1:24:25.66,Default,,0,0,0,,Жыл!
Dialogue: 0,1:24:25.75,1:24:28.58,Default,,0,0,0,,(Аврора ханшайымының табанды дауысы)
Dialogue: 0,1:24:30.25,1:24:31.16,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:32.75,1:24:34.25,Default,,0,0,0,,О...
Dialogue: 0,1:24:36.41,1:24:39.66,Default,,0,0,0,,Джулия-чан, анашым, сіз таң қалдыңыз...
Dialogue: 0,1:24:41.58,1:24:44.04,Default,,0,0,0,,Ю... Юлия, өтінемін!
Dialogue: 0,1:24:44.95,1:24:47.58,Default,,0,0,0,,Аманды ауруханаға апарыңыз!
Dialogue: 0,1:24:47.66,1:24:49.66,Default,,0,0,0,,(Жедел жәрдем сиренасының дыбысы)
Dialogue: 0,1:24:54.75,1:24:56.25,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:59.58,1:25:02.20,Default,,0,0,0,,Жарайсың, балам.
Dialogue: 0,1:25:04.33,1:25:05.41,Default,,0,0,0,,Аманда!
Dialogue: 0,1:25:21.45,1:25:25.37,Default,,0,0,0,,Бұл Бантинг, Бантинг мырза.
Dialogue: 0,1:25:29.66,1:25:33.29,Default,,0,0,0,,Бұл ауруханада Аманда Шаффлюп есімді қыз бар.
Dialogue: 0,1:25:33.37,1:25:34.91,Default,,0,0,0,,Сіз ауруханадасыз, солай ма?
Dialogue: 0,1:25:35.00,1:25:36.29,Default,,0,0,0,,Сондықтан⸺
Dialogue: 0,1:25:36.37,1:25:39.29,Default,,0,0,0,,Мен сіздің қандай қарым-қатынасыңыз бар екенін сұраймын.
Dialogue: 0,1:25:45.04,1:25:45.70,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:45.79,1:25:47.58,Default,,0,0,0,,«Балалар бөлімі»
Dialogue: 0,1:26:00.50,1:26:03.45,Default,,0,0,0,,Ана жақта, ана жақта.
Dialogue: 0,1:26:03.54,1:26:05.83,Default,,0,0,0,,Мына жерде
Dialogue: 0,1:26:06.41,1:26:09.62,Default,,0,0,0,,Цзиньзан Кітапханаға оралу
Dialogue: 0,1:26:10.37,1:26:14.83,Default,,0,0,0,,Коюки-чан бұл жерден кетуге тым үлкен.
Dialogue: 0,1:26:14.91,1:26:18.04,Default,,0,0,0,,Радж Аманданы кездестірдіңіз бе?
Dialogue: 0,1:26:18.12,1:26:19.54,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,1:26:19.62,1:26:21.75,Default,,0,0,0,,Мен солай деп үміттенемін...
Dialogue: 0,1:26:21.83,1:26:25.58,Default,,0,0,0,,Ұйқыларыңыз тыныш, мен сізді бақылаймын.
Dialogue: 0,1:26:27.58,1:26:29.08,Default,,0,0,0,,Юлия! Мама!
Dialogue: 0,1:26:29.87,1:26:33.29,Default,,0,0,0,,Бүгін балет қойылымы екені есіме түсті.
Dialogue: 0,1:26:35.00,1:26:36.58,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,1:26:39.37,1:26:40.91,Default,,0,0,0,,Шуфлеп мырза
Dialogue: 0,1:26:42.25,1:26:44.37,Default,,0,0,0,,Жағдайы тыныш
Dialogue: 0,1:26:44.45,1:26:45.95,Default,,0,0,0,,Рахмет
Dialogue: 0,1:26:47.41,1:26:48.66,Default,,0,0,0,,Анашым!
Dialogue: 0,1:26:57.00,1:26:58.62,Default,,0,0,0,,Ой... иә!
Dialogue: 0,1:27:01.29,1:27:03.54,Default,,0,0,0,,Анашым, мен сізге какао сатып аламын.
Dialogue: 0,1:27:11.79,1:27:12.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:15.62,1:27:19.45,Default,,0,0,0,,(Медициналық бақылау сигналы)
Dialogue: 0,1:27:17.75,1:27:19.45,Default,,0,0,0,,Аманда!
Dialogue: 0,1:27:19.45,1:27:20.50,Default,,0,0,0,,(Медициналық бақылау сигналы)
Dialogue: 0,1:27:22.12,1:27:23.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:28.08,1:27:29.00,Default,,0,0,0,,Аманда
Dialogue: 0,1:27:30.04,1:27:33.00,Default,,0,0,0,,Бұл менің кінәм... Кешіріңіз.
Dialogue: 0,1:27:36.20,1:27:37.50,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,1:27:38.54,1:27:40.12,Default,,0,0,0,,Аманда тірі
Dialogue: 0,1:27:41.08,1:27:44.33,Default,,0,0,0,,Аманданың қиялы тірі, солай емес пе?
Dialogue: 0,1:27:46.75,1:27:48.20,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,1:27:50.75,1:27:53.91,Default,,0,0,0,,Мен оралдым, Аманда.
Dialogue: 0,1:27:55.00,1:27:56.95,Default,,0,0,0,,Көзіңді ашатын кез келді.
Dialogue: 0,1:27:57.91,1:27:59.87,Default,,0,0,0,,Оян
Dialogue: 0,1:27:59.95,1:28:00.83,Default,,0,0,0,,
Dialogue: 0,1:28:00.91,1:28:02.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:02.20,1:28:03.33,Default,,0,0,0,,не үшін шайқасып жүрсің?
Dialogue: 0,1:28:09.79,1:28:13.50,Default,,0,0,0,,(Канг Кан)
Dialogue: 0,1:28:13.58,1:28:16.87,Default,,0,0,0,,Жоғалып қалмау, қорғау
Dialogue: 0,1:28:16.95,1:28:18.87,Default,,0,0,0,,Ешқашан жылама
Dialogue: 0,1:28:19.66,1:28:21.37,Default,,0,0,0,,Мен енді қашпаймын!
Dialogue: 0,1:28:27.62,1:28:29.45,Default,,0,0,0,,Аманда, оян.
Dialogue: 0,1:28:30.95,1:28:32.95,Default,,0,0,0,,Сіз кімді ұстайсыз?
Dialogue: 0,1:28:35.29,1:28:37.70,Default,,0,0,0,,Бұл рас па? Бұл Роджер ме?
Dialogue: 0,1:28:38.91,1:28:42.79,Default,,0,0,0,,Сізді қайтадан көргеніме қуаныштымын. Мен сенің келеріңді күттім.
Dialogue: 0,1:28:43.29,1:28:44.70,Default,,0,0,0,,Аманда...
Dialogue: 0,1:28:44.79,1:28:47.04,Default,,0,0,0,,Уф...
Dialogue: 0,1:28:48.79,1:28:51.75,Default,,0,0,0,,(Медициналық бақылау сигналы)
Dialogue: 0,1:28:55.79,1:28:57.37,Default,,0,0,0,,Мен...
Dialogue: 0,1:29:02.00,1:29:03.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:03.29,1:29:06.70,Default,,0,0,0,,Кішкентай қыз, ояусың ба?
Dialogue: 0,1:29:06.79,1:29:09.20,Default,,0,0,0,,Кім? Дәрігер ме?
Dialogue: 0,1:29:09.79,1:29:11.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:11.37,1:29:13.70,Default,,0,0,0,,Эй, эй, сен мұндай зорлық-зомбылықты қоя аласың ба?
Dialogue: 0,1:29:14.62,1:29:17.70,Default,,0,0,0,,Барлығының жарамдылық мерзімі бар.
Dialogue: 0,1:29:18.29,1:29:23.70,Default,,0,0,0,,Your expiration date is today, Roger in a dress.
Dialogue: 0,1:29:26.25,1:29:27.70,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,1:29:27.79,1:29:29.20,Default,,0,0,0,,Хо
Dialogue: 0,1:29:29.29,1:29:33.20,Default,,0,0,0,,Сіз мұны естідіңіз бе? Бұл бала сені көре алмайды.
Dialogue: 0,1:29:33.83,1:29:36.12,Default,,0,0,0,,Менің есімде жоқ.
Dialogue: 0,1:29:36.20,1:29:39.20,Default,,0,0,0,,Ой! Бұл қайғылы емес пе?
Dialogue: 0,1:29:39.83,1:29:42.45,Default,,0,0,0,,Иә, Роджер.
Dialogue: 0,1:29:47.41,1:29:49.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:49.79,1:29:51.83,Default,,0,0,0,,Роджер... Роджер
Dialogue: 0,1:29:57.00,1:29:58.08,Default,,0,0,0,,не үшін шайқасып жүрсің?
Dialogue: 0,1:30:00.41,1:30:05.62,Default,,0,0,0,,Сіз кімсіз? Балалар сендер кімсіңдер? Неге ұрысып жатырсың?
Dialogue: 0,1:30:09.41,1:30:15.33,Default,,0,0,0,,I'll eat everything this child entrusts to you.
Dialogue: 0,1:30:16.04,1:30:19.25,Default,,0,0,0,,Қайғылы, азапты естеліктермен бірге.
Dialogue: 0,1:30:24.79,1:30:25.95,Default,,0,0,0,,Аманда!
Dialogue: 0,1:30:28.37,1:30:30.95,Default,,0,0,0,,Роджер... Роджер?
Dialogue: 0,1:30:31.62,1:30:32.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:35.54,1:30:37.95,Default,,0,0,0,,Жоқ, бұл Роджер емес.
Dialogue: 0,1:30:38.04,1:30:39.95,Default,,0,0,0,,Иә, бұл менмін!
Dialogue: 0,1:30:40.04,1:30:42.45,Default,,0,0,0,,Бұл бала раджа!
Dialogue: 0,1:30:43.20,1:30:45.12,Default,,0,0,0,,О, ой... ой...
Dialogue: 0,1:30:59.79,1:31:01.20,Default,,0,0,0,,Раджа, мұнда кел!
Dialogue: 0,1:31:01.29,1:31:03.75,Default,,0,0,0,,- (Реджер) Аманда! - Кәне!
Dialogue: 0,1:31:13.33,1:31:15.50,Default,,0,0,0,,Сіз күткендей, жас ханым.
Dialogue: 0,1:31:18.66,1:31:22.45,Default,,0,0,0,,Роджерді көздеу үшін жеткілікті күш болды.
Dialogue: 0,1:31:24.62,1:31:25.29,Default,,0,0,0,,Itetetete...
Dialogue: 0,1:31:27.54,1:31:29.41,Default,,0,0,0,,Кеттік, Раджа.
Dialogue: 0,1:31:29.50,1:31:30.54,Default,,0,0,0,,Раджа!
Dialogue: 0,1:31:33.20,1:31:34.62,Default,,0,0,0,,Мықтап ұстаңыз!
Dialogue: 0,1:31:34.70,1:31:35.87,Default,,0,0,0,,Мен білемін!
Dialogue: 0,1:31:48.87,1:31:51.95,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,1:32:16.75,1:32:20.45,Default,,0,0,0,,I've lived hundreds of years longer than you.
Dialogue: 0,1:32:21.20,1:32:24.66,Default,,0,0,0,,Аманда Бұл қайық ұша алмайды.
Dialogue: 0,1:32:24.75,1:32:25.62,Default,,0,0,0,,Әрине
Dialogue: 0,1:32:25.70,1:32:26.87,Default,,0,0,0,,Ұша алмайды
Dialogue: 0,1:32:27.66,1:32:29.29,Default,,0,0,0,,Бірақ бәрібір!
Dialogue: 0,1:32:42.08,1:32:43.79,Default,,0,0,0,,Киахо
Dialogue: 0,1:32:57.29,1:32:58.62,Default,,0,0,0,,Ах
Dialogue: 0,1:33:02.41,1:33:04.58,Default,,0,0,0,,- Қарғыс атсын... - (Реджер) Уау
Dialogue: 0,1:33:04.66,1:33:06.00,Default,,0,0,0,,Түсінікті!
Dialogue: 0,1:33:06.08,1:33:07.45,Default,,0,0,0,,Аманда!
Dialogue: 0,1:33:08.79,1:33:13.00,Default,,0,0,0,,(Екі адам ауырып айқайлайды)
Dialogue: 0,1:33:22.04,1:33:23.08,Default,,0,0,0,,Аманда?
Dialogue: 0,1:33:25.41,1:33:26.66,Default,,0,0,0,,Аманда!
Dialogue: 0,1:33:28.37,1:33:31.66,Default,,0,0,0,,Доктор Аманда! Бірдеңе жасаңыз.
Dialogue: 0,1:33:32.25,1:33:34.91,Default,,0,0,0,,Жоқ, жоқ, араластырыңыз
Dialogue: 0,1:33:35.00,1:33:38.66,Default,,0,0,0,,I'm talking about hospitals and children today.
Dialogue: 0,1:33:38.75,1:33:40.95,Default,,0,0,0,,Тек зерттеу жүргізу.
Dialogue: 0,1:33:41.75,1:33:44.16,Default,,0,0,0,,Сіз бізге бұрын...
Dialogue: 0,1:33:44.25,1:33:48.16,Default,,0,0,0,,Мен мұның ұмытылмағанына қуаныштымын.
Dialogue: 0,1:33:49.12,1:33:53.29,Default,,0,0,0,,Менің қызым қиналып жатыр, дәл қазір бұл жерден кетіңізші!
Dialogue: 0,1:33:53.37,1:33:54.66,Default,,0,0,0,,Анашым!
Dialogue: 0,1:33:54.75,1:33:56.45,Default,,0,0,0,,Аманда! Сіз ояусыз!
Dialogue: 0,1:33:56.54,1:33:58.66,Default,,0,0,0,,Анашым, ол кісіге сенбеңіз...
Dialogue: 0,1:33:59.25,1:34:00.87,Default,,0,0,0,,Мен қазір дәрігерді шақырамын.
Dialogue: 0,1:34:06.37,1:34:10.79,Default,,0,0,0,,Мама, ол раджаны жұтпақшы.
Dialogue: 0,1:34:12.87,1:34:16.79,Default,,0,0,0,,Кішкентай қыз, оны жұту дұрыс емес.
Dialogue: 0,1:34:17.58,1:34:21.66,Default,,0,0,0,,All I have to do is zero this child back to reality.
Dialogue: 0,1:34:21.75,1:34:23.29,Default,,0,0,0,,Сіз...
Dialogue: 0,1:34:24.29,1:34:27.54,Default,,0,0,0,,I won't do anything, as long as you don't interfere.
Dialogue: 0,1:34:27.62,1:34:28.75,Default,,0,0,0,,Мазасыздық?
Dialogue: 0,1:34:30.16,1:34:31.00,Default,,0,0,0,,Аманда?
Dialogue: 0,1:34:31.87,1:34:36.79,Default,,0,0,0,,Аманда! Мама саған сенеді! Ол сізге көмектеседі.
Dialogue: 0,1:34:37.45,1:34:39.83,Default,,0,0,0,,Анама Рейзуко туралы айтыңыз.
Dialogue: 0,1:34:40.37,1:34:43.29,Default,,0,0,0,,Анам қоңырау шалса, Рейзуко келеді.
Dialogue: 0,1:34:43.95,1:34:45.79,Default,,0,0,0,,Мама...Раджа.
Dialogue: 0,1:34:45.87,1:34:48.79,Default,,0,0,0,,- (Лиззи) Сөйлеме - Раджа
Dialogue: 0,1:34:49.50,1:34:51.79,Default,,0,0,0,,Рей... Рейзуко
Dialogue: 0,1:34:53.12,1:34:54.83,Default,,0,0,0,,Тоңазытқыш?
Dialogue: 0,1:34:55.87,1:35:00.29,Default,,0,0,0,,Ит Раджа кездескен Рейзоко деген ит.
Dialogue: 0,1:35:00.87,1:35:01.95,Default,,0,0,0,,Раджа...
Dialogue: 0,1:35:03.37,1:35:07.29,Default,,0,0,0,,Мен сені күтемін. Мама, Рейзокоға қоңырау шалыңыз.
Dialogue: 0,1:35:07.37,1:35:08.54,Default,,0,0,0,,Ана...
Dialogue: 0,1:35:14.33,1:35:15.70,Default,,0,0,0,,Snake?
Dialogue: 0,1:35:21.54,1:35:24.45,Default,,0,0,0,,Сізге қалай ұнайды? Shuffleup ханым
Dialogue: 0,1:35:25.12,1:35:29.70,Default,,0,0,0,,Қиял әлеміне қош келдіңіздер
Dialogue: 0,1:35:31.04,1:35:32.45,Default,,0,0,0,,Ана...
Dialogue: 0,1:35:33.08,1:35:33.95,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:34.04,1:35:36.25,Default,,0,0,0,,Amanda, it's okay!
Dialogue: 0,1:35:37.50,1:35:38.45,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:35:43.95,1:35:45.37,Default,,0,0,0,,Уау... уау
Dialogue: 0,1:35:48.37,1:35:50.20,Default,,0,0,0,,А... Анашым!
Dialogue: 0,1:36:10.75,1:36:11.95,Default,,0,0,0,,Анашым!
Dialogue: 0,1:36:12.54,1:36:14.54,Default,,0,0,0,,Help the Rajah!
Dialogue: 0,1:36:35.04,1:36:37.58,Default,,0,0,0,,“Elizabeth”
Dialogue: 0,1:36:48.70,1:36:52.95,Default,,0,0,0,,Баланы жібер!
Dialogue: 0,1:36:53.54,1:36:57.87,Default,,0,0,0,,Мен саған айтамын ол баланы жібер!
Dialogue: 0,1:36:59.87,1:37:03.79,Default,,0,0,0,,Бала бізбен бірге! Біздің досымыз...
Dialogue: 0,1:37:04.41,1:37:07.29,Default,,0,0,0,,Мен оны саған бермеймін!
Dialogue: 0,1:37:15.12,1:37:16.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:37:22.50,1:37:24.83,Default,,0,0,0,,Уау!
Dialogue: 0,1:37:25.50,1:37:28.33,Default,,0,0,0,,Мысалы, мұнда Құрылтайшы Титанның күшін қолдана алмайтыныңды білмегендей…
Dialogue: 0,1:37:40.33,1:37:42.62,Default,,0,0,0,,Бір-бір...
Dialogue: 0,1:37:43.79,1:37:46.45,Default,,0,0,0,,Жүр! Рейзуко
Dialogue: 0,1:38:00.00,1:38:01.37,Default,,0,0,0,,Mom... Mom
Dialogue: 0,1:38:01.95,1:38:03.00,Default,,0,0,0,,Аманда!
Dialogue: 0,1:38:07.62,1:38:11.37,Default,,0,0,0,,Қандай аңқау адамдар!
Dialogue: 0,1:38:11.45,1:38:14.29,Default,,0,0,0,,Бір ғана қиялдағы жануар үшін
Dialogue: 0,1:38:14.95,1:38:16.37,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,1:38:16.45,1:38:18.75,Default,,0,0,0,,Тек оны тамақтандырыңыз.
Dialogue: 0,1:38:26.79,1:38:28.04,Default,,0,0,0,,Раджа!
Dialogue: 0,1:38:29.20,1:38:32.87,Default,,0,0,0,,Аманда, сен анаңмен бірге тұрасың!
Dialogue: 0,1:38:32.95,1:38:34.87,Default,,0,0,0,,Раджа!
Dialogue: 0,1:39:05.12,1:39:10.37,Default,,0,0,0,,Қандай дәм! Қиялдан тыс болу деген осы ма?
Dialogue: 0,1:39:10.45,1:39:14.66,Default,,0,0,0,,Жаңа емес, сипаттау қиын.
Dialogue: 0,1:39:15.25,1:39:16.70,Default,,0,0,0,,Пу...
Dialogue: 0,1:39:17.37,1:39:19.37,Default,,0,0,0,,Like rotten
Dialogue: 0,1:39:19.95,1:39:24.50,Default,,0,0,0,,Жоқ, бірақ мен жедім! Ерекше қиял!
Dialogue: 0,1:39:24.58,1:39:26.87,Default,,0,0,0,,Иә, мен мұны қалаймын...
Dialogue: 0,1:39:27.79,1:39:28.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:30.95,1:39:32.00,Default,,0,0,0,,Game...
Dialogue: 0,1:39:35.12,1:39:41.20,Default,,0,0,0,,Ge... Genjitsuda
Dialogue: 0,1:39:48.37,1:39:52.83,Default,,0,0,0,,“Mr Bunting”
Dialogue: 0,1:40:07.87,1:40:09.75,Default,,0,0,0,,Иә...
Dialogue: 0,1:40:10.45,1:40:11.70,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,1:40:12.37,1:40:14.87,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:40:18.95,1:40:21.20,Default,,0,0,0,,Аманда қош келдіңіз
Dialogue: 0,1:40:22.66,1:40:24.12,Default,,0,0,0,,I’m home, Mom.
Dialogue: 0,1:40:25.08,1:40:28.12,Default,,0,0,0,,Rudge was right.
Dialogue: 0,1:40:28.70,1:40:32.91,Default,,0,0,0,,Ересек адам ретінде бұл бала өте бақытты көрінеді.
Dialogue: 0,1:40:33.00,1:40:35.12,Default,,0,0,0,,Иә, менің Аманда да.
Dialogue: 0,1:40:35.91,1:40:37.54,Default,,0,0,0,,Өте бақытты көрінеді
Dialogue: 0,1:40:48.20,1:40:49.83,Default,,0,0,0,,Не болды?
Dialogue: 0,1:40:49.91,1:40:51.37,Default,,0,0,0,,А, жоқ...
Dialogue: 0,1:40:51.45,1:40:53.91,Default,,0,0,0,,- (Медбике) Сіз ояусыз. - (Лиззи) Иә.
Dialogue: 0,1:40:54.00,1:40:56.62,Default,,0,0,0,,Керемет, мен мұғалімге хабарлаймын.
Dialogue: 0,1:40:56.70,1:40:57.87,Default,,0,0,0,,Иә
Dialogue: 0,1:41:04.79,1:41:08.87,Default,,0,0,0,,Рахмет Раджа Рахмет сізге Рейзуко
Dialogue: 0,1:41:28.29,1:41:31.58,Default,,0,0,0,,Келгеніңіз үшін рахмет, Раджа.
Dialogue: 0,1:41:32.25,1:41:34.08,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,1:41:34.16,1:41:36.54,Default,,0,0,0,,Кітапханадағылардың барлығы маған көмектесті.
Dialogue: 0,1:41:37.04,1:41:40.87,Default,,0,0,0,,Джинзан, Коюки-чан және Эмили де.
Dialogue: 0,1:41:41.75,1:41:43.37,Default,,0,0,0,,Иә
Dialogue: 0,1:41:43.45,1:41:46.33,Default,,0,0,0,,Аманда, сен
Dialogue: 0,1:41:46.41,1:41:50.87,Default,,0,0,0,,Қуаныш пен мұңды қайталап, Бір күні үлкен боласың.
Dialogue: 0,1:41:51.83,1:41:52.87,Default,,0,0,0,,Раджа...
Dialogue: 0,1:41:52.95,1:41:57.58,Default,,0,0,0,,Аманда Мен әрқашан боламын
Dialogue: 0,1:41:58.37,1:42:01.87,Default,,0,0,0,,Қандай жағдай болмасын мен әрқашан сенің ішіңде боламын
Dialogue: 0,1:42:05.91,1:42:07.79,Default,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,1:42:08.79,1:42:11.70,Default,,0,0,0,,3 ай, 3 апта және 3 күн бұрын
Dialogue: 0,1:42:12.95,1:42:14.20,Default,,0,0,0,,Аманда...
Dialogue: 0,1:42:19.08,1:42:21.91,Default,,0,0,0,,Жоғалып қалмау, қорғау
Dialogue: 0,1:42:22.62,1:42:25.37,Default,,0,0,0,,Және мүлдем
Dialogue: 0,1:42:26.12,1:42:29.37,Default,,0,0,0,,Never cry
Dialogue: 0,1:42:37.45,1:42:40.58,Default,,0,0,0,,Раджа, соңғы шытырманға барайық!
Dialogue: 0,1:42:41.16,1:42:42.41,Default,,0,0,0,,Иә!
Dialogue: 0,1:42:56.70,1:42:58.50,Default,,0,0,0,,Мен бұрын көрмеген құстар
Dialogue: 0,1:42:59.54,1:43:01.20,Default,,0,0,0,,Бұрын көрмеген гүлдер
Dialogue: 0,1:43:03.33,1:43:04.95,Default,,0,0,0,,Бұрын-соңды көрмеген жел
Dialogue: 0,1:43:06.37,1:43:07.95,Default,,0,0,0,,Бұрын-соңды көрмеген түн
Dialogue: 0,1:43:09.08,1:43:10.50,Default,,0,0,0,,Керемет нәрсе
Dialogue: 0,1:43:11.83,1:43:13.33,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,1:43:14.62,1:43:15.95,Default,,0,0,0,,I...
Dialogue: 0,1:43:16.70,1:43:18.16,Default,,0,0,0,,Иә!
Dialogue: 0,1:43:33.37,1:43:37.79,Default,,0,0,0,,Бұл дүниеде көптеген кереметтер
Dialogue: 0,1:43:39.37,1:43:44.37,Default,,0,0,0,,Жақын жерде, табылуын күтуде
Dialogue: 0,1:43:45.50,1:43:50.58,Default,,0,0,0,,Бұлттардың арғы жағындағы жарықта
Dialogue: 0,1:43:50.62,1:43:55.29,Default,,0,0,0,,А.Ф.Гарольдтың «Мен жоғалғанға дейін» түпнұсқа жұмысы
Dialogue: 0,1:43:51.87,1:43:56.62,Default,,0,0,0,,Дыбыста жасырылған тыныштықта
Dialogue: 0,1:43:57.16,1:44:02.62,Default,,0,0,0,,Сенбесең, көре алмайсың
Dialogue: 0,1:44:03.50,1:44:07.45,Default,,0,0,0,,Жүрегің шақырса, міндетті түрде көресің.
Dialogue: 0,1:44:11.41,1:44:18.41,Default,,0,0,0,,Сіз қалаған нәрсені жасай алатын жерде
Dialogue: 0,1:44:23.70,1:44:30.70,Default,,0,0,0,,Қалағаныңызша ойлаңыз.
Dialogue: 0,1:44:35.58,1:44:39.87,Default,,0,0,0,,Егер қатты қаласаңыз
Dialogue: 0,1:44:41.04,1:44:45.04,Default,,0,0,0,,Жарайды, мүмкін емес ештеңе жоқ.
Dialogue: 0,1:44:47.20,1:44:50.75,Default,,0,0,0,,Мүмкін емес ештеңе жоқ
Dialogue: 0,1:44:55.66,1:45:00.91,Default,,0,0,0,,Бар жаңбырмен бірге кемпірқосақты ұстап алайық
Dialogue: 0,1:45:02.00,1:45:07.75,Default,,0,0,0,,Бар ауыртпалықпен дауыстап күл
Dialogue: 0,1:45:07.83,1:45:13.37,Default,,0,0,0,,Сол кезде түсінесің
Dialogue: 0,1:45:14.16,1:45:20.00,Default,,0,0,0,,Қараңғыда жұлдыздар жарқырайды
Dialogue: 0,1:45:20.08,1:45:25.70,Default,,0,0,0,,Біздің айналамызда көптеген әдемі заттар бар
Dialogue: 0,1:45:25.79,1:45:31.91,Default,,0,0,0,,Сіз армандаған әлем шын мәнінде сіздің көз алдыңызда.
Dialogue: 0,1:45:32.54,1:45:39.54,Default,,0,0,0,,Сіз қалаған нәрсені жасай алатын жерде
Dialogue: 0,1:45:44.66,1:45:51.66,Default,,0,0,0,,Қалағаныңызша ойлаңыз.
Dialogue: 0,1:45:56.70,1:46:01.25,Default,,0,0,0,,Егер сіз қатты қаласаңыз
Dialogue: 0,1:46:02.08,1:46:06.16,Default,,0,0,0,,Жарайды, мүмкін емес ештеңе жоқ.
Dialogue: 0,1:46:08.20,1:46:11.29,Default,,0,0,0,,Мүмкін емес ештеңе жоқ
Dialogue: 0,1:46:11.37,1:46:16.04,Default,,0,0,0,,Бұл жіп бізді байланыстырады
Dialogue: 0,1:46:16.12,1:46:21.87,Default,,0,0,0,,Ол ешқашан шешілмейді
Dialogue: 0,1:46:21.95,1:46:25.08,Default,,0,0,0,,Ертең бірдеңе болса
Dialogue: 0,1:46:25.16,1:46:28.45,Default,,0,0,0,,Мен енді сенің жаныңда бола алмасам да
Dialogue: 0,1:46:28.54,1:46:34.62,Default,,0,0,0,,Жарайды, қоштасу емес.
Dialogue: 0,1:46:35.66,1:46:40.50,Default,,0,0,0,,Бұлттардың арғы жағындағы жарықта
