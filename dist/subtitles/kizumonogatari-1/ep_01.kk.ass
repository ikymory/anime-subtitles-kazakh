Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:08:15.41,0:08:16.51,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:17.21,0:08:19.54,Default,,0,0,0,,Мен...Мен оны көрген жоқпын.
Dialogue: 0,0:08:45.68,0:08:47.38,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:08:48.03,0:08:50.44,Default,,0,0,0,,Адамдардың көргісі келмейтін нәрсені жасыру
Dialogue: 0,0:08:50.68,0:08:54.18,Default,,0,0,0,,Юбкаларға қалай қарасаңыз да, олардың қауіпсіздігі төмен.
Dialogue: 0,0:08:54.47,0:08:58.72,Default,,0,0,0,,Менің ойымша, бізге spats деп аталатын брандмауэр керек.
Dialogue: 0,0:08:59.52,0:09:01.05,Default,,0,0,0,,Келіңіздер... келіңіздер.
Dialogue: 0,0:09:12.73,0:09:15.26,Default,,0,0,0,,олар сен сияқты жігітті көтереді. Ал содан кейін—
Dialogue: 0,0:09:17.45,0:09:18.89,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:09:33.86,0:09:38.22,Default,,0,0,0,,Мен ақыры жеттім. Сіз жылдам жүресіз.
Dialogue: 0,0:09:39.59,0:09:40.73,Default,,0,0,0,,Арараги-кун
Dialogue: 0,0:09:48.94,0:09:51.27,Default,,0,0,0,,Менің атымды қайдан білесің?
Dialogue: 0,0:09:53.00,0:09:56.24,Default,,0,0,0,,Білемін, біз бір мектептен емеспіз.
Dialogue: 0,0:09:58.39,0:10:00.39,Default,,0,0,0,,Мұны істеу мүмкін бе?
Dialogue: 0,0:10:01.15,0:10:06.25,Default,,0,0,0,,Жақсы балаға ``жақсы'' сөзін көбейтіп, ``ағаш ағашы'' деп Арараги-кун деп жаз.
Dialogue: 0,0:10:06.67,0:10:11.38,Default,,0,0,0,,Төмендегі атау жылдар мен айлардың күнтізбесі, солай ма?
Dialogue: 0,0:10:11.50,0:10:13.54,Default,,0,0,0,,Со Коёми Арараги-кун
Dialogue: 0,0:10:18.41,0:10:24.99,Default,,0,0,0,,Сіз... Ханекава Цубаса Ханекавасыз.
Dialogue: 0,0:10:34.62,0:10:38.12,Default,,0,0,0,,Уау, менің атымды да білесің!
Dialogue: 0,0:10:38.88,0:10:41.16,Default,,0,0,0,,Екінші курстың бірінші семестрінің қорытынды емтиханында
Dialogue: 0,0:10:41.42,0:10:44.74,Default,,0,0,0,,Барлық пәндер, соның ішінде денсаулық, дене шынықтыру және өнер пәндері
Dialogue: 0,0:10:45.10,0:10:48.99,Default,,0,0,0,,Цубаса Ханекава тек бір бос орынды толтыру сұрағын қате қойды
Dialogue: 0,0:10:50.11,0:10:54.98,Default,,0,0,0,,Күте тұрыңыз... жоқ, сіз мұны қайдан білесіз?
Dialogue: 0,0:10:56.44,0:11:01.45,Default,,0,0,0,,Арараги-кун менің аңдыушым бола ала ма?
Dialogue: 0,0:11:04.34,0:11:07.83,Default,,0,0,0,,Бұл тым параноидтық.
Dialogue: 0,0:11:08.55,0:11:09.40,Default,,0,0,0,,Бөлек
Dialogue: 0,0:11:10.77,0:11:12.91,Default,,0,0,0,,Мен шетелдік досымнан сұрадым
Dialogue: 0,0:11:12.95,0:11:15.63,Default,,0,0,0,,Арараги-кун, сенің достарың бар ма?
Dialogue: 0,0:11:18.43,0:11:21.57,Default,,0,0,0,,Алдымен шетелдіктер бар ма деп сұраңыз.
Dialogue: 0,0:11:21.75,0:11:25.85,Default,,0,0,0,,Жоқ, бұл Арараги-кун әрқашан жалғыз.
Dialogue: 0,0:11:25.85,0:11:29.02,Default,,0,0,0,,Себебі менде ол оқшау өмір сүрген сияқты әсер қалдырды.
Dialogue: 0,0:11:36.06,0:11:39.41,Default,,0,0,0,,Дұрыс айтасың, менің достарым жоқ.
Dialogue: 0,0:11:40.28,0:11:43.11,Default,,0,0,0,,Тіпті ондай досы жоқ адамдар да белгілі.
Dialogue: 0,0:11:43.67,0:11:46.00,Default,,0,0,0,,Бұл сіздің атақты екеніңізді білдіреді.
Dialogue: 0,0:11:46.50,0:11:48.64,Default,,0,0,0,,Тек тоқтаңыз.
Dialogue: 0,0:11:49.08,0:11:52.06,Default,,0,0,0,,Маған ондай әзілдер ұнамайды.
Dialogue: 0,0:11:59.07,0:12:01.30,Default,,0,0,0,,Эй, Арараги-кун
Dialogue: 0,0:12:07.11,0:12:10.43,Default,,0,0,0,,Сіз Арарагидің вампир екеніне сенесіз бе?
Dialogue: 0,0:12:13.96,0:12:16.28,Default,,0,0,0,,Вампирге не болды?
Dialogue: 0,0:12:17.45,0:12:21.39,Default,,0,0,0,,Соңғы кездері біраз өсек тарады.
Dialogue: 0,0:12:22.07,0:12:25.15,Default,,0,0,0,,Дәл қазір бұл қалада вампир бар.
Dialogue: 0,0:12:25.67,0:12:28.89,Default,,0,0,0,,Сондықтан түнде жалғыз шықпау керек.
Dialogue: 0,0:12:29.61,0:12:33.70,Default,,0,0,0,,Бұл түсініксіз және сенімсіз қауесет.
Dialogue: 0,0:12:34.44,0:12:38.28,Default,,0,0,0,,Өте әдемі аққұба әйел.
Dialogue: 0,0:12:38.86,0:12:43.56,Default,,0,0,0,,Ол сіздің омыртқаңызды салқындататын суық көздері бар вампир.
Dialogue: 0,0:12:43.92,0:12:47.08,Default,,0,0,0,,Сіздің вампир екеніңізді айту үшін бұл жеткіліксіз.
Dialogue: 0,0:12:47.93,0:12:51.60,Default,,0,0,0,,Ол ақшыл шашымен ерекшеленетін қарапайым адам емес пе?
Dialogue: 0,0:12:52.27,0:12:53.25,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:53.38,0:12:57.65,Default,,0,0,0,,Оның сары шашы көше жарығында жарқырап тұрса да.
Dialogue: 0,0:12:58.32,0:12:59.89,Default,,0,0,0,,Көлеңке болған жоқ
Dialogue: 0,0:13:04.66,0:13:07.76,Default,,0,0,0,,Бірақ, түн болды.
Dialogue: 0,0:13:08.51,0:13:12.63,Default,,0,0,0,,Көше шамымен жарықтандырылды деу қате болуы мүмкін.
Dialogue: 0,0:13:14.50,0:13:17.39,Default,,0,0,0,,Мен де бұл ақымақ қауесет деп ойлаймын.
Dialogue: 0,0:13:18.05,0:13:25.17,Default,,0,0,0,,Бірақ менің ойымша, егер вампирлер болса, мен олармен танысқым келеді.
Dialogue: 0,0:13:25.96,0:13:31.80,Default,,0,0,0,,Ондай адамнан жоғары біреу болса ғой.
Dialogue: 0,0:13:32.27,0:13:35.72,Default,,0,0,0,,Құдай сияқты адамдардан жоғары.
Dialogue: 0,0:13:35.72,0:13:38.83,Default,,0,0,0,,Бұл Құдай болуы міндетті емес.
Dialogue: 0,0:13:42.97,0:13:46.47,Default,,0,0,0,,Әйтпесе, көп жағынан марапатталмайсыз.
Dialogue: 0,0:13:58.54,0:13:59.72,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:14:00.47,0:14:03.70,Default,,0,0,0,,Арараги-кун, сіз таңқаларлықтай оңай сөйлесетін адамсыз.
Dialogue: 0,0:14:04.71,0:14:09.20,Default,,0,0,0,,Аузым сырғып, мағынасыз бірдеңе айттым.
Dialogue: 0,0:14:11.63,0:14:16.28,Default,,0,0,0,,Бір қызығы, сөйлесуге оңай Арараги-кунның досы жоқ.
Dialogue: 0,0:14:16.89,0:14:18.93,Default,,0,0,0,,Сен неге достаспайсың?
Dialogue: 0,0:14:20.83,0:14:24.15,Default,,0,0,0,,Өйткені дос болған кезде адам ретіндегі күш-қуатыңыз төмендейді.
Dialogue: 0,0:14:27.47,0:14:30.02,Default,,0,0,0,,Кешіріңіз, мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:14:30.15,0:14:34.58,Default,,0,0,0,,Жоқ, сондықтан бұлай.
Dialogue: 0,0:14:35.34,0:14:39.38,Default,,0,0,0,,Достарың болса, оларға қамқор болу керек.
Dialogue: 0,0:14:39.92,0:14:42.75,Default,,0,0,0,,Досым ренжісе, мен де ауырамын.
Dialogue: 0,0:14:43.15,0:14:45.64,Default,,0,0,0,,Достарым мұңайса, мен де мұңаямын.
Dialogue: 0,0:14:46.29,0:14:49.80,Default,,0,0,0,,Менің ойымша, бұл сіздің осал тұстарыңыз артады деген сөз.
Dialogue: 0,0:14:50.56,0:14:52.82,Default,,0,0,0,,Бұл бізді адам ретінде әлсіретеді.
Dialogue: 0,0:14:54.83,0:14:58.67,Default,,0,0,0,,Бірақ достарым көңілді болса, мен де көңілдімін.
Dialogue: 0,0:14:58.94,0:15:01.88,Default,,0,0,0,,Достарым қуанса, мен де қуанамын.
Dialogue: 0,0:15:02.15,0:15:05.06,Default,,0,0,0,,Жалпы әлсіреп бара жатқан сияқты емес пе?
Dialogue: 0,0:15:05.61,0:15:09.22,Default,,0,0,0,,Жоқ, достарым көңіл көтеріп жүргенде мен қызғанамын.
Dialogue: 0,0:15:09.45,0:15:11.86,Default,,0,0,0,,Достарым қуанса мен қызғанамын.
Dialogue: 0,0:15:14.53,0:15:16.33,Default,,0,0,0,,Адамдар кішкентай
Dialogue: 0,0:15:17.82,0:15:18.90,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:15:26.79,0:15:27.64,Default,,0,0,0,,Мен
Dialogue: 0,0:15:29.00,0:15:31.54,Default,,0,0,0,,Мен қазір кітапханаға баруды ойлап жүрмін.
Dialogue: 0,0:15:32.16,0:15:33.98,Default,,0,0,0,,Арараги-кун сенімен бірге барады ма?
Dialogue: 0,0:15:34.98,0:15:38.40,Default,,0,0,0,,Неге, сен кітапханада не істеп жүрсің?
Dialogue: 0,0:15:39.40,0:15:41.47,Default,,0,0,0,,Оқып жатқан шығарсың.
Dialogue: 0,0:15:42.48,0:15:43.82,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:44.91,0:15:50.71,Default,,0,0,0,,Өкінішке орай, көктемгі каникулда үй тапсырмасы болмаған соң өз бетімше оқуға да кеттім.
Dialogue: 0,0:15:50.71,0:15:51.92,Default,,0,0,0,,Бұл бірегей емес.
Dialogue: 0,0:15:52.32,0:15:55.93,Default,,0,0,0,,Бірақ келесі жылы мен үміткермін.
Dialogue: 0,0:15:56.52,0:16:01.84,Default,,0,0,0,,Ешқандай қабылдау емтихандары немесе ештеңе жоқ, тіпті менің бітіруім де қауіп төніп тұр.
Dialogue: 0,0:16:02.36,0:16:04.43,Default,,0,0,0,,Не істесем де, уақытында үлгермеймін.
Dialogue: 0,0:16:08.99,0:16:11.59,Default,,0,0,0,,Арараги-кун, сенде ұялы телефон бар ма?
Dialogue: 0,0:16:12.17,0:16:14.24,Default,,0,0,0,,Ал, ұялы телефон туралы.
Dialogue: 0,0:16:15.79,0:16:16.58,Default,,0,0,0,,...
Dialogue: 0,0:16:24.87,0:16:26.56,Default,,0,0,0,,Рахмет Иә Қайтарыңыз
Dialogue: 0,0:16:41.01,0:16:44.48,Default,,0,0,0,,Мен өз нөмірімді және электрондық пошта мекенжайымды тіркедім.
Dialogue: 0,0:16:48.26,0:16:51.96,Default,,0,0,0,,Ал, сен достастың.
Dialogue: 0,0:17:35.73,0:17:37.16,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:47.54,0:23:48.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:50.98,0:23:54.62,Default,,0,0,0,,Маған көмектесейін
Dialogue: 0,0:23:56.34,0:23:57.88,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:23:58.98,0:24:03.87,Default,,0,0,0,,Маған көмектесуге рұқсат етсеңіз, осылай айтып тұрсыз.
Dialogue: 0,0:24:09.69,0:24:11.38,Default,,0,0,0,,Көзіңіз көрмейді ме? Есіктің жазуын оқи алмайсыз ба?
Dialogue: 0,0:24:14.08,0:24:17.10,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:24:19.99,0:24:23.11,Default,,0,0,0,,Тез арада жедел жәрдем жіберіңіз...
Dialogue: 0,0:24:41.26,0:24:45.19,Default,,0,0,0,,Кюукюша? Маған бұл керек емес
Dialogue: 0,0:24:49.68,0:24:53.52,Default,,0,0,0,,Олай болса аттың қанын бер.
Dialogue: 0,0:25:01.76,0:25:04.70,Default,,0,0,0,,Сіз Арараги-кунның вампир екеніне сенесіз бе?
Dialogue: 0,0:25:05.62,0:25:08.76,Default,,0,0,0,,Өте әдемі аққұба әйел.
Dialogue: 0,0:25:09.16,0:25:13.60,Default,,0,0,0,,Ол сіздің омыртқаңызды дірілдететін суық көздері бар вампир.
Dialogue: 0,0:25:14.65,0:25:19.70,Default,,0,0,0,,Менің атым Kissshot Acerola Orion Heart Underblade
Dialogue: 0,0:25:20.53,0:25:24.55,Default,,0,0,0,,Темір қанды, ыстық қанды, суық қанды вампир.
Dialogue: 0,0:25:26.11,0:25:30.59,Default,,0,0,0,,Иттің қанын етім деп жұтамын.
Dialogue: 0,0:25:31.10,0:25:35.24,Default,,0,0,0,,Олай болса аттың қанын бер.
Dialogue: 0,0:25:40.90,0:25:46.68,Default,,0,0,0,,Вампирлер өлмейтін болуы керек емес пе?
Dialogue: 0,0:25:47.62,0:25:54.19,Default,,0,0,0,,Мен тым көп қан жоғалттым. Мен енді қайта қалпына келтіре алмаймын немесе өзгерте алмаймын.
Dialogue: 0,0:25:54.94,0:25:57.94,Default,,0,0,0,,Осылай кете берсек, өлеміз.
Dialogue: 0,0:26:04.12,0:26:06.67,Default,,0,0,0,,Елеусіз адамдар
Dialogue: 0,0:26:06.67,0:26:10.47,Default,,0,0,0,,Менің етім мен қаным болып абыройлы бол.
Dialogue: 0,0:26:11.61,0:26:16.38,Default,,0,0,0,,Қан...Қан, қан құюдың пайдасы жоқ емес пе?
Dialogue: 0,0:26:18.63,0:26:22.12,Default,,0,0,0,,Сіз мұнда қанша уақыт болдыңыз?
Dialogue: 0,0:26:23.03,0:26:28.51,Default,,0,0,0,,Әзірше мен бір адамның құнын алатын болсам, төтенше жағдайдан өте аламын.
Dialogue: 0,0:26:28.56,0:26:30.88,Default,,0,0,0,,Түсіндім, тек мен үшін...
Dialogue: 0,0:26:44.35,0:26:49.44,Default,,0,0,0,,Не болды? Маған қан берші... Тезірек...
Dialogue: 0,0:26:49.50,0:26:51.04,Default,,0,0,0,,Тез орындаңыз
Dialogue: 0,0:26:53.19,0:26:55.91,Default,,0,0,0,,Тез, баяу бейбақ.
Dialogue: 0,0:26:54.58,0:26:58.22,Default,,0,0,0,,Жарайды, қашып құтылу керек.
Dialogue: 0,0:26:56.46,0:27:00.05,Default,,0,0,0,,Қалай ойлайсың, тағы да осындай құрмет бар ма?
Dialogue: 0,0:27:00.07,0:27:01.55,Default,,0,0,0,,Сіз қашып құтылуыңыз керек.
Dialogue: 0,0:27:14.19,0:27:15.08,Default,,0,0,0,,Эй
Dialogue: 0,0:27:19.70,0:27:20.76,Default,,0,0,0,,Ух... бұл өтірік.
Dialogue: 0,0:27:25.57,0:27:29.08,Default,,0,0,0,,Маған көмектесе аласыз ба...?
Dialogue: 0,0:27:38.68,0:27:44.64,Default,,0,0,0,,Маған ұнамайды Маған ұнамайды Маған ұнамайды
Dialogue: 0,0:27:44.74,0:27:49.26,Default,,0,0,0,,Бірақ тұманнан өткенге дейін оны қашан және қай жерде кездестіретінімізді болжау мүмкін емес.
Dialogue: 0,0:27:49.34,0:27:52.78,Default,,0,0,0,,Маған көмектесіңізші, өтінемін
Dialogue: 0,0:27:57.32,0:28:00.24,Default,,0,0,0,,Өтінемін... өтінемін
Dialogue: 0,0:28:02.32,0:28:05.08,Default,,0,0,0,,Маған ұнамайды Маған ұнамайды
Dialogue: 0,0:28:16.13,0:28:42.97,Default,,0,0,0,,Кешіріңіз, кешіріңіз, кешіріңіз, кешіріңіз
Dialogue: 0,0:28:54.36,0:28:58.64,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:29:28.27,0:29:29.75,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:29:32.20,0:29:34.41,Default,,0,0,0,,Әйтпесе, бұл құбыжық.
Dialogue: 0,0:29:36.76,0:29:38.05,Default,,0,0,0,,Мен вампирмін
Dialogue: 0,0:29:40.55,0:29:42.23,Default,,0,0,0,,Көмек қажет емес
Dialogue: 0,0:29:44.14,0:29:45.46,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:29:57.61,0:30:00.59,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:30:34.21,0:30:36.11,Default,,0,0,0,,Берілме, ақымақ
Dialogue: 0,0:30:47.64,0:30:49.47,Default,,0,0,0,,Мен...жақсы ма?
Dialogue: 0,0:30:50.00,0:30:53.29,Default,,0,0,0,,Мына бейбақ жаман болса керек.
Dialogue: 0,0:30:55.98,0:30:58.33,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын.
Dialogue: 0,0:30:59.70,0:31:03.95,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:31:12.59,0:31:16.31,Default,,0,0,0,,Мен келесі өмірімде міндетті түрде жақсы жұмыс істеймін
Dialogue: 0,0:31:17.98,0:31:22.58,Default,,0,0,0,,Өзіңізге ұнамайтын нәрсенің бәріне басқаларды кінәлауға болады.
Dialogue: 0,0:31:23.96,0:31:30.26,Default,,0,0,0,,Сондықтан мен сондай адам болып қайта туамын
Dialogue: 0,0:31:31.66,0:31:35.88,Default,,0,0,0,,Мен саған көмектесемін, қанымды іш.
Dialogue: 0,0:31:37.15,0:31:41.87,Default,,0,0,0,,Барлығын орында, әрбір тамшысын сығып ал.
Dialogue: 0,0:31:48.89,0:31:50.47,Default,,0,0,0,,Рахмет
Dialogue: 0,0:32:57.83,0:32:58.73,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:33:29.59,0:33:33.25,Default,,0,0,0,,Ей, эй, эй, оян.
Dialogue: 0,0:33:38.07,0:33:39.63,Default,,0,0,0,,Бес минут қалды
Dialogue: 0,0:33:39.66,0:33:43.00,Default,,0,0,0,,Сонымен... ояныңыз.
Dialogue: 0,0:33:44.09,0:33:46.32,Default,,0,0,0,,Кейінгі сезім
Dialogue: 0,0:33:48.30,0:33:50.17,Default,,0,0,0,,Сіз қанша ұйықтайсыз?
Dialogue: 0,0:33:55.19,0:33:57.35,Default,,0,0,0,,Шамамен 4,6 млрд жыл
Dialogue: 0,0:33:59.55,0:34:02.21,Default,,0,0,0,,Басқа Жер жаратылады
Dialogue: 0,0:34:08.59,0:34:10.37,Default,,0,0,0,,Содан бері екі күн болды ма?
Dialogue: 0,0:34:50.47,0:34:51.55,Default,,0,0,0,,Таваке
Dialogue: 0,0:35:56.09,0:35:57.40,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:36:00.78,0:36:05.15,Default,,0,0,0,,Кенет күнге шығып кететін ақымақтар қайда?
Dialogue: 0,0:36:05.59,0:36:09.48,Default,,0,0,0,,Орташа вампир бір сәтте буланып кетер еді.
Dialogue: 0,0:36:14.96,0:36:18.25,Default,,0,0,0,,Күндізгі уақытта ешқашан көшеге шықпаңыз.
Dialogue: 0,0:36:18.84,0:36:20.88,Default,,0,0,0,,Сізде нағыз өлместік бар болғандықтан
Dialogue: 0,0:36:21.02,0:36:26.56,Default,,0,0,0,,Бұл күйіп қалу, қалпына келтіру, күйдіру және қалпына келтірудің мәңгілік қайталануы.
Dialogue: 0,0:36:37.86,0:36:43.72,Default,,0,0,0,,Егер сіз өлмейтін вампирлерді тірі деп анықтасаңыз, иә.
Dialogue: 0,0:36:46.25,0:36:49.48,Default,,0,0,0,,Кюсю...
Dialogue: 0,0:36:49.75,0:36:52.52,Default,,0,0,0,,Сонда сіз, кез келген жағдайда.
Dialogue: 0,0:36:55.87,0:37:04.17,Default,,0,0,0,,Иә, бұл Kissshot Acerola Orion Heart Underblade.
Dialogue: 0,0:37:04.87,0:37:07.34,Default,,0,0,0,,Оны Жүрек астындағы Жүрек деп атауға болады.
Dialogue: 0,0:37:09.77,0:37:12.79,Default,,0,0,0,,Туыстық құрғаныма 400 жыл болды.
Dialogue: 0,0:37:12.79,0:37:17.96,Default,,0,0,0,,Бұл менің екінші рет болды, бірақ оның төзімділігіне қарағанда.
Dialogue: 0,0:37:18.53,0:37:20.39,Default,,0,0,0,,Жақсы өткен сияқты.
Dialogue: 0,0:37:20.39,0:37:22.61,Default,,0,0,0,,Ке...кин
Dialogue: 0,0:37:22.61,0:37:24.98,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:37:28.33,0:37:32.71,Default,,0,0,0,,Ойланып қарасам, Уну есімін әлі естіген жоқпын.
Dialogue: 0,0:37:36.05,0:37:37.47,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:37:37.47,0:37:42.22,Default,,0,0,0,,Бұрынғы менің есімдерім енді Unu үшін мағынасы жоқ.
Dialogue: 0,0:37:43.27,0:37:45.05,Default,,0,0,0,,Қалай болғанда да, қызметші.
Dialogue: 0,0:37:46.90,0:37:50.16,Default,,0,0,0,,Түнгі әлемге қош келдіңіз
Dialogue: 0,0:38:16.76,0:38:18.55,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:38:24.18,0:38:27.47,Default,,0,0,0,,Оны «джуку» деп атайтын сияқты.
Dialogue: 0,0:38:27.96,0:38:30.27,Default,,0,0,0,,Ол бірнеше жыл бұрын тоқтап қалған сияқты.
Dialogue: 0,0:38:30.27,0:38:32.26,Default,,0,0,0,,Енді бұл жай ғана қиранды
Dialogue: 0,0:38:32.65,0:38:35.84,Default,,0,0,0,,Көріп отырғаныңыздай, жасыруға ыңғайлы.
Dialogue: 0,0:38:38.10,0:38:40.75,Default,,0,0,0,,Олай болса, Kiss Shot, келесі сұрақ.
Dialogue: 0,0:38:40.75,0:38:41.92,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:38:41.92,0:38:46.02,Default,,0,0,0,,Мен саған мені Heartunderblade деп ата деп айттым.
Dialogue: 0,0:38:46.02,0:38:47.64,Default,,0,0,0,,Бұл ұзақ көрінуі мүмкін, бірақ
Dialogue: 0,0:38:48.31,0:38:50.38,Default,,0,0,0,,Сүйісу қысқарақ
Dialogue: 0,0:38:51.11,0:38:53.95,Default,,0,0,0,,Әлде мен оны осылай атасам ба?
Dialogue: 0,0:38:56.01,0:38:59.37,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:38:59.37,0:39:02.35,Default,,0,0,0,,Егер Уну мұнымен жақсы болса, онда бұл жақсы.
Dialogue: 0,0:39:02.99,0:39:04.46,Default,,0,0,0,,Бас тартуға ешқандай себеп жоқ.
Dialogue: 0,0:39:06.56,0:39:10.09,Default,,0,0,0,,Сонымен, келесі сұрақ қандай?
Dialogue: 0,0:39:12.23,0:39:16.15,Default,,0,0,0,,Жарайды, мен вампирге айналдым.
Dialogue: 0,0:39:16.71,0:39:18.41,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:39:18.41,0:39:20.88,Default,,0,0,0,,Оны әрі қарай түсіндірудің қажеті жоқ.
Dialogue: 0,0:39:21.41,0:39:25.27,Default,,0,0,0,,Уну менің вассалым әрі қызметшім болды.
Dialogue: 0,0:39:25.72,0:39:26.96,Default,,0,0,0,,Құрметті болыңыз
Dialogue: 0,0:39:27.75,0:39:29.17,Default,,0,0,0,,Қызметші
Dialogue: 0,0:39:30.38,0:39:35.52,Default,,0,0,0,,Онда неге сенде баланың денесі осындай?
Dialogue: 0,0:39:35.52,0:39:38.63,Default,,0,0,0,,Екеуміз кездескенімізде сен одан да көп едің...
Dialogue: 0,0:39:38.63,0:39:40.11,Default,,0,0,0,,Ересек адамға ұқсайды
Dialogue: 0,0:39:41.39,0:39:43.72,Default,,0,0,0,,Бала болғаным үшін кінәлі болдым.
Dialogue: 0,0:39:43.72,0:39:46.05,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:39:56.43,0:39:59.85,Default,,0,0,0,,Иттің қаны сығып кетті, бірақ
Dialogue: 0,0:39:59.85,0:40:02.76,Default,,0,0,0,,Бұл жеткіліксіз болды.
Dialogue: 0,0:40:02.76,0:40:05.85,Default,,0,0,0,,Сонымен, солай көрінеді.
Dialogue: 0,0:40:06.31,0:40:08.41,Default,,0,0,0,,Өлмеген жақсы.
Dialogue: 0,0:40:08.90,0:40:12.39,Default,,0,0,0,,Дегенмен, сіз ең төменгі өлместік деңгейін ғана сақтай аласыз.
Dialogue: 0,0:40:12.39,0:40:16.04,Default,,0,0,0,,Сіздің вампир ретіндегі қабілеттеріңіздің көпшілігі шектеулі.
Dialogue: 0,0:40:16.58,0:40:18.58,Default,,0,0,0,,Бұл өте ыңғайсыз.
Dialogue: 0,0:40:22.01,0:40:24.25,Default,,0,0,0,,Мүшелер де осындай.
Dialogue: 0,0:40:24.25,0:40:26.61,Default,,0,0,0,,Шинобу, оны тек пішіні бойынша қалпына келтіруге болады
Dialogue: 0,0:40:27.34,0:40:30.26,Default,,0,0,0,,Жарайды, іші бос.
Dialogue: 0,0:40:30.64,0:40:34.04,Default,,0,0,0,,Дегенмен, бұл әзірге жақсы.
Dialogue: 0,0:40:34.04,0:40:38.92,Default,,0,0,0,,Дегенмен, солай болса да, иерархияны анық сақтайық.
Dialogue: 0,0:40:38.92,0:40:39.97,Default,,0,0,0,,Қызметші
Dialogue: 0,0:40:40.52,0:40:45.92,Default,,0,0,0,,Мен осындай болсам да, мен 500 жыл өмір сүрген вампирмін.
Dialogue: 0,0:40:46.43,0:40:49.22,Default,,0,0,0,,Уну - жаңа туған вампир.
Dialogue: 0,0:40:49.50,0:40:53.68,Default,,0,0,0,,Қалыпты жағдайда бұл сізбен тең дәрежеде сөйлесе алатын адам емес.
Dialogue: 0,0:40:55.56,0:40:56.09,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:40:56.64,0:40:58.22,Default,,0,0,0,,Бұл түсініксіз жауап.
Dialogue: 0,0:40:58.84,0:41:00.65,Default,,0,0,0,,Сіз шынымен түсінесіз бе?
Dialogue: 0,0:41:01.62,0:41:03.55,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:41:03.55,0:41:08.26,Default,,0,0,0,,Сосын мойынсұнушылық белгісі ретінде басымнан сипап қойыңыз.
Dialogue: 0,0:41:21.22,0:41:22.21,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:41:33.58,0:41:36.85,Default,,0,0,0,,Неге мені вампир еттің?
Dialogue: 0,0:41:38.69,0:41:43.29,Default,,0,0,0,,Мен сізден құрғап, өлтіруге дайындалдым.
Dialogue: 0,0:41:44.54,0:41:47.09,Default,,0,0,0,,Мен мұны істегім келмеді.
Dialogue: 0,0:41:47.85,0:41:52.33,Default,,0,0,0,,Егер вампир сіздің қаныңызды сорса, барлығы да вампирге айналады.
Dialogue: 0,0:41:53.10,0:41:54.16,Default,,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:41:54.80,0:41:56.91,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:41:57.80,0:42:01.63,Default,,0,0,0,,Бұл маған ыңғайлы.
Dialogue: 0,0:42:02.73,0:42:05.93,Default,,0,0,0,,Мен сендер үшін істеуім керек нәрселер бар.
Dialogue: 0,0:42:07.28,0:42:11.73,Default,,0,0,0,,Бір адамның қаны осыншама ғана қалпына келтіре алады.
Dialogue: 0,0:42:12.75,0:42:15.34,Default,,0,0,0,,Дәл қазір мен толық қуаттан алыспын.
Dialogue: 0,0:42:15.82,0:42:19.58,Default,,0,0,0,,Ендеше, бұдан былай мен Унудан көшуін сұрауым керек.
Dialogue: 0,0:42:21.28,0:42:22.58,Default,,0,0,0,,Мен үшін не?
Dialogue: 0,0:42:30.82,0:42:31.42,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:42:34.58,0:42:35.24,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:42:36.91,0:42:38.33,Default,,0,0,0,,Сіз адам болып қайта аласыз ба?
Dialogue: 0,0:42:42.53,0:42:43.14,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:42:43.62,0:42:44.68,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:42:45.05,0:42:47.10,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:42:47.40,0:42:49.84,Default,,0,0,0,,Сонда мен ше?
Dialogue: 0,0:42:49.87,0:42:50.64,Default,,0,0,0,,Мен қайтуға болады.
Dialogue: 0,0:42:52.57,0:42:53.62,Default,,0,0,0,,Мен сізге кепілдік беремін
Dialogue: 0,0:42:54.62,0:42:56.08,Default,,0,0,0,,Менің атымнан
Dialogue: 0,0:43:23.07,0:43:27.35,Default,,0,0,0,,Бұл үшеуі вампирлерді жоюға маманданған адамдар.
Dialogue: 0,0:43:27.88,0:43:30.60,Default,,0,0,0,,Сонда сені олар құртты ма?
Dialogue: 0,0:43:30.82,0:43:32.37,Default,,0,0,0,,Бос сөзді айтпа
Dialogue: 0,0:43:32.76,0:43:33.97,Default,,0,0,0,,Әлі орындалмады
Dialogue: 0,0:43:34.90,0:43:37.42,Default,,0,0,0,,аяқ-қолынан айырылғаны ауырады.
Dialogue: 0,0:43:38.12,0:43:40.26,Default,,0,0,0,,Менде қалпына келтіру күші қалмады.
Dialogue: 0,0:43:41.38,0:43:43.77,Default,,0,0,0,,Менің дәл қазір бұл күйде күресу мүмкін емес.
Dialogue: 0,0:43:44.55,0:43:45.13,Default,,0,0,0,,Сонымен
Dialogue: 0,0:43:47.05,0:43:49.25,Default,,0,0,0,,Уну сол үш адаммен соғысты.
Dialogue: 0,0:43:49.76,0:43:52.90,Default,,0,0,0,,Аяқ-қолымды қайтарып алсам ғой.
Dialogue: 0,0:43:59.14,0:44:01.26,Default,,0,0,0,,Ия...жақсы...
Dialogue: 0,0:44:01.97,0:44:03.23,Default,,0,0,0,,Бұл оңай
Dialogue: 0,0:44:04.00,0:44:09.34,Default,,0,0,0,,Унуды қайтадан адамға айналдыру үшін мен толық күш-қуатыма оралуым керек.
Dialogue: 0,0:44:09.70,0:44:11.82,Default,,0,0,0,,A complete body, so to speak.
Dialogue: 0,0:44:12.89,0:44:17.05,Default,,0,0,0,,Ол үшін бұл мүшелер өте қажет.
Dialogue: 0,0:44:18.33,0:44:23.35,Default,,0,0,0,,But... it's impossible for me to fight.
Dialogue: 0,0:44:24.52,0:44:27.32,Default,,0,0,0,,Ең нашар жағдайда, мен жойылып кетуім мүмкін.
Dialogue: 0,0:44:27.96,0:44:28.74,Default,,0,0,0,,Таваке
Dialogue: 0,0:44:29.21,0:44:32.72,Default,,0,0,0,,Бұл Уну адам болған кездегі оқиға болса керек.
Dialogue: 0,0:44:33.29,0:44:35.44,Default,,0,0,0,,Unu now is my dependent.
Dialogue: 0,0:44:36.34,0:44:39.61,Default,,0,0,0,,Қазіргі уақытта ол ең төменгі деңгейге дейін әлсіреген.
Dialogue: 0,0:44:40.14,0:44:44.73,Default,,0,0,0,,Мені өлтіру оңай болар еді, ол ең жоғары дәрежелі вампир.
Dialogue: 0,0:44:45.53,0:44:49.82,Default,,0,0,0,,Бұл сіздің вампир ретінде әлсіз жақта екеніңізді білдіре ме?
Dialogue: 0,0:44:50.10,0:44:51.25,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:45:05.54,0:45:10.48,Default,,0,0,0,,Жарайды, мен қазір сенен әлсірегеннен күшті болсам да.
Dialogue: 0,0:45:11.02,0:45:16.29,Default,,0,0,0,,Күш-қуатыңыз толық, мінсіз күйіңізде сол үш адам сенің қол-аяғыңды ұрлады.
Dialogue: 0,0:45:17.21,0:45:18.01,Default,,0,0,0,,Өзің бар
Dialogue: 0,0:45:18.45,0:45:21.40,Default,,0,0,0,,Бұл үш адамның ісі болғандықтан, мен ес-түссіз қалдым.
Dialogue: 0,0:45:22.00,0:45:23.32,Default,,0,0,0,,Мен жек көрдім
Dialogue: 0,0:45:25.59,0:45:30.16,Default,,0,0,0,,Басқаша айтқанда, біз бір уақытта бір адаммен айналысатын болсақ,
Dialogue: 0,0:45:30.17,0:45:32.51,Default,,0,0,0,,Those three are not Unu's enemies.
Dialogue: 0,0:45:33.13,0:45:35.94,Default,,0,0,0,,Frankly speaking, it's an easy job.
Dialogue: 0,0:47:04.23,0:47:06.23,Default,,0,0,0,,What...what should I do?
Dialogue: 0,0:48:10.71,0:48:13.78,Default,,0,0,0,,Let's talk about it, you guys.
Dialogue: 0,0:48:14.21,0:48:16.02,Default,,0,0,0,,Мен...Мен адаммын.
Dialogue: 0,0:48:17.12,0:48:17.95,Default,,0,0,0,,Балалар
Dialogue: 0,0:48:18.79,0:48:20.56,Default,,0,0,0,,Do you intend to commit murder?
Dialogue: 0,0:49:18.57,0:49:21.50,Default,,0,0,0,,You guys are really doing well.
Dialogue: 0,0:49:22.56,0:49:24.95,Default,,0,0,0,,Did something good happen?
Dialogue: 0,0:49:31.96,0:49:32.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:44.05,0:49:44.78,Default,,0,0,0,,Рахмет
Dialogue: 0,0:49:45.65,0:49:46.33,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:49:47.68,0:49:48.78,Default,,0,0,0,,It's good to be grateful
Dialogue: 0,0:49:49.24,0:49:51.16,Default,,0,0,0,,Сіз ғана құтқарылдыңыз.
Dialogue: 0,0:49:51.52,0:49:52.22,Default,,0,0,0,,Арараги-кун
Dialogue: 0,0:49:56.43,0:49:57.82,Default,,0,0,0,,Don't be so cautious.
Dialogue: 0,0:50:05.22,0:50:07.74,Default,,0,0,0,,You got those glaring eyes.
Dialogue: 0,0:50:08.30,0:50:09.44,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатырсыз.
Dialogue: 0,0:50:09.94,0:50:11.86,Default,,0,0,0,,Жақсы нәрсе болды ма?
Dialogue: 0,0:50:17.39,0:50:19.05,Default,,0,0,0,,Ал, қазір үйге қайтайық.
Dialogue: 0,0:50:19.51,0:50:20.38,Default,,0,0,0,,Арараги-кун
Dialogue: 0,0:50:21.24,0:50:22.27,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:50:25.08,0:50:27.36,Default,,0,0,0,,It's the ruins of that cram school.
Dialogue: 0,0:50:31.80,0:50:32.74,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:50:33.00,0:50:34.90,Default,,0,0,0,,What...how do you know that?
Dialogue: 0,0:50:36.43,0:50:37.40,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:50:38.29,0:50:42.34,Default,,0,0,0,,Сол балаға сол жерді айтқан мен едім ғой.
Dialogue: 0,0:50:44.86,0:50:48.38,Default,,0,0,0,,Жарайды, әділдікті көрмеу – батылдық.
Dialogue: 0,0:50:49.29,0:50:51.71,Default,,0,0,0,,Сол қыз, Жүрек астындағы Жүрек.
Dialogue: 0,0:50:51.72,0:50:55.23,Default,,0,0,0,,Денеңізді сүйретіп жүргенде көп қиындық көрген сияқтысыз.
Dialogue: 0,0:50:56.03,0:50:57.95,Default,,0,0,0,,I showed you a good place.
Dialogue: 0,0:51:00.28,0:51:03.27,Default,,0,0,0,,Сіз кімсіз...?
Dialogue: 0,0:51:04.27,0:51:06.88,Default,,0,0,0,,Мен қасынан өтіп бара жатқан қариямын
Dialogue: 0,0:51:11.07,0:51:12.33,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:51:13.21,0:51:16.50,Default,,0,0,0,,Мен вампирлерді жоюдың маманы емеспін.
Dialogue: 0,0:51:17.49,0:51:19.24,Default,,0,0,0,,Менің мамандығым кеңірек.
Dialogue: 0,0:51:19.65,0:51:21.30,Default,,0,0,0,,Маған кең ауқымды жұмыс берілді.
Dialogue: 0,0:51:22.34,0:51:25.46,Default,,0,0,0,,Ал, мен өзімді кейін таныстырамын.
Dialogue: 0,0:51:29.36,0:51:30.18,Default,,0,0,0,,Сіз қайтып келдіңіз бе?
Dialogue: 0,0:51:33.06,0:51:36.17,Default,,0,0,0,,Менің артымдағы жігіт таныс көрінеді.
Dialogue: 0,0:51:36.50,0:51:37.44,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:51:37.71,0:51:39.22,Default,,0,0,0,,Бұл сіздің түсінігіңіздің ауқымы ма?
Dialogue: 0,0:51:40.92,0:51:43.60,Default,,0,0,0,,Сонда бұл қалай болды?
Dialogue: 0,0:51:52.88,0:51:54.15,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:51:54.91,0:51:57.94,Default,,0,0,0,,Осы үшеуі әлі де араласып жүр ме?
Dialogue: 0,0:51:58.61,0:52:04.38,Default,,0,0,0,,Қалай болғанда да, толық қуат режимінде де сізді жеңу үшін үш адам қажет болды.
Dialogue: 0,0:52:05.42,0:52:09.36,Default,,0,0,0,,Сонда мен бұл үшеуін жеңе алмаймын.
Dialogue: 0,0:52:09.77,0:52:12.30,Default,,0,0,0,,So if it's one person at a time
Dialogue: 0,0:52:12.34,0:52:14.87,Default,,0,0,0,,Жай араласу мүмкін емес.
Dialogue: 0,0:52:15.77,0:52:19.06,Default,,0,0,0,,Сен өзіңді ұстай берсең жақсы болатынын айттың.
Dialogue: 0,0:52:19.76,0:52:21.71,Default,,0,0,0,,Біз бұл жерден қашан білеміз?
Dialogue: 0,0:52:21.71,0:52:23.64,Default,,0,0,0,,Бұл туралы мәселе жоқ.
Dialogue: 0,0:52:24.28,0:52:26.99,Default,,0,0,0,,Here while you were sleeping
Dialogue: 0,0:52:27.63,0:52:30.04,Default,,0,0,0,,Мен саған жасырын тосқауыл қойдым.
Dialogue: 0,0:52:31.18,0:52:31.99,Default,,0,0,0,,Тосқауыл
Dialogue: 0,0:52:32.71,0:52:34.15,Default,,0,0,0,,Бұл бөгет сияқты ма?
Dialogue: 0,0:52:34.89,0:52:36.48,Default,,0,0,0,,Well, it's like that.
Dialogue: 0,0:52:38.14,0:52:41.27,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:52:42.08,0:52:43.36,Default,,0,0,0,,Неліктен Kiss Shot?
Dialogue: 0,0:52:44.44,0:52:45.67,Default,,0,0,0,,Бізге көмектес
Dialogue: 0,0:52:46.99,0:52:48.87,Default,,0,0,0,,Біз жау емес екенімізді түсінсем де.
Dialogue: 0,0:52:49.80,0:52:52.76,Default,,0,0,0,,I don't think you're on my side.
Dialogue: 0,0:52:58.21,0:52:59.76,Default,,0,0,0,,Don't say cruel things
Dialogue: 0,0:52:59.77,0:53:00.48,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:53:01.22,0:53:03.98,Default,,0,0,0,,I'm trying to balance things out.
Dialogue: 0,0:53:04.68,0:53:07.16,Default,,0,0,0,,If you say so, that's my job.
Dialogue: 0,0:53:07.88,0:53:10.00,Default,,0,0,0,,Bridging here and there
Dialogue: 0,0:53:11.74,0:53:13.32,Default,,0,0,0,,Introduce yourself.
Dialogue: 0,0:53:14.03,0:53:15.48,Default,,0,0,0,,I said I'd do it later.
Dialogue: 0,0:53:20.36,0:53:21.41,Default,,0,0,0,,Ошино мемі
Dialogue: 0,0:53:22.56,0:53:24.26,Default,,0,0,0,,Free person of no fixed address
Dialogue: 0,0:53:25.15,0:53:28.34,Default,,0,0,0,,Сіз мені құбыжықты түрлендіру жөніндегі авторитетті деп ойлай аласыз.
Dialogue: 0,0:53:30.65,0:53:31.80,Default,,0,0,0,,Unlike those three people
Dialogue: 0,0:53:32.04,0:53:35.45,Default,,0,0,0,,Мен құбыжықтарды жоюда онша шебер емеспін.
Dialogue: 0,0:53:36.20,0:53:37.27,Default,,0,0,0,,Бұл жақсы емес
Dialogue: 0,0:53:38.56,0:53:40.34,Default,,0,0,0,,To put it more concretely,
Dialogue: 0,0:53:40.92,0:53:42.19,Default,,0,0,0,,Маған ұнамайды, солай ма?
Dialogue: 0,0:53:42.95,0:53:45.44,Default,,0,0,0,,Бірақ сіз сарапшы емессіз бе?
Dialogue: 0,0:53:46.26,0:53:48.90,Default,,0,0,0,,Менің мамандығым тепе-теңдік табу.
Dialogue: 0,0:53:49.75,0:53:50.89,Default,,0,0,0,,Бейтарап күйде
Dialogue: 0,0:53:51.09,0:53:52.48,Default,,0,0,0,,Келіссөздер жүргізу
Dialogue: 0,0:53:53.32,0:53:55.70,Default,,0,0,0,,Егер мен айту керек болсам, мен келіссөз жүргізушімін.
Dialogue: 0,0:53:57.14,0:53:57.91,Default,,0,0,0,,Келіссөздер?
Dialogue: 0,0:53:59.00,0:54:01.88,Default,,0,0,0,,Мұнда және мұнда көпір салу
Dialogue: 0,0:54:03.89,0:54:05.13,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:54:05.85,0:54:06.98,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:54:08.09,0:54:09.15,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:54:09.84,0:54:11.09,Default,,0,0,0,,Бұл құбыжықтар ма?
Dialogue: 0,0:54:15.49,0:54:16.28,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:54:16.95,0:54:17.57,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:54:18.19,0:54:19.92,Default,,0,0,0,,Мен оны құбыжық деп атаймын.
Dialogue: 0,0:54:22.41,0:54:25.56,Default,,0,0,0,,Ал бала «Елес өлтіруші» деп аталады.
Dialogue: 0,0:54:26.42,0:54:28.15,Default,,0,0,0,,Елестерден энергияны сорып алады
Dialogue: 0,0:54:28.51,0:54:30.28,Default,,0,0,0,,Сирек кездесетін вампир түрі.
Dialogue: 0,0:54:31.07,0:54:34.15,Default,,0,0,0,,Міне, сондықтан да ол атақты.
Dialogue: 0,0:54:38.04,0:54:42.29,Default,,0,0,0,,Мен сіздің пікірталасыңызды ертерек естідім.
Dialogue: 0,0:54:43.45,0:54:46.06,Default,,0,0,0,,Жағдай онша ауыр емес сияқты.
Dialogue: 0,0:54:46.92,0:54:49.62,Default,,0,0,0,,Мен мұндай күрделі нәрсе болады деп ешқашан күтпедім.
Dialogue: 0,0:54:50.19,0:54:51.44,Default,,0,0,0,,Бұл күрделі емес
Dialogue: 0,0:54:51.78,0:54:53.00,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:54:53.67,0:54:58.33,Default,,0,0,0,,Ұзақ өмір сүретін вампирдің ұзақтығын ескерсек, бұл дұрыс шығар.
Dialogue: 0,0:54:59.82,0:55:02.27,Default,,0,0,0,,Бұл біз адамдар үшін проблема.
Dialogue: 0,0:55:02.94,0:55:04.53,Default,,0,0,0,,Эй Арараги-кун
Dialogue: 0,0:55:10.37,0:55:13.99,Default,,0,0,0,,Маған Heart Under Blade ұнады.
Dialogue: 0,0:55:15.03,0:55:21.61,Default,,0,0,0,,Мен сіздің туысқандарыңыз ретінде қабылдаған Арараги-кунды қайтадан адам етіп қайтаруға бел байлағаныңызды бағалаймын.
Dialogue: 0,0:55:33.03,0:55:36.21,Default,,0,0,0,,Қаласаң, араларыңда тұра аламын.
Dialogue: 0,0:55:38.89,0:55:39.98,Default,,0,0,0,,Арасында тұру
Dialogue: 0,0:55:41.24,0:55:42.64,Default,,0,0,0,,Осы үш адамның арасында ма?
Dialogue: 0,0:55:43.55,0:55:44.52,Default,,0,0,0,,Оған ұқсас ештеңе жоқ.
Dialogue: 0,0:55:45.64,0:55:48.76,Default,,0,0,0,,Сіз маған көмектесесіз бе?
Dialogue: 0,0:55:49.77,0:55:51.92,Default,,0,0,0,,Көмек берме, тек күшіңді бер
Dialogue: 0,0:55:52.92,0:55:58.36,Default,,0,0,0,,Маған қазіргідей заттар сәл теңгерімсіз сияқты.
Dialogue: 0,0:55:58.95,0:56:01.00,Default,,0,0,0,,Бұл қорлау сияқты
Dialogue: 0,0:56:03.49,0:56:06.35,Default,,0,0,0,,Бірақ, әрине, мен де жұмыстамын.
Dialogue: 0,0:56:06.64,0:56:08.02,Default,,0,0,0,,Сіз мұны жай ғана жасай алмайсыз.
Dialogue: 0,0:56:09.09,0:56:10.04,Default,,0,0,0,,That's right.
Dialogue: 0,0:56:11.89,0:56:13.52,Default,,0,0,0,,2 миллион ше?
Dialogue: 0,0:56:13.94,0:56:15.45,Default,,0,0,0,,ни…нихьяку
Dialogue: 0,0:56:15.97,0:56:18.04,Default,,0,0,0,,Белгілі бір уақытта төлеу туралы ескерту жоқ
Dialogue: 0,0:56:18.74,0:56:20.56,Default,,0,0,0,,Бұлай көп сұраудың қажеті жоқ.
Dialogue: 0,0:56:21.04,0:56:23.96,Default,,0,0,0,,Бұл жағдайды теңестірмейді.
Dialogue: 0,0:56:24.80,0:56:27.17,Default,,0,0,0,,Сол сәтте брошьты алып, кокпитке қашып кетемін
Dialogue: 0,0:56:30.08,0:56:32.48,Default,,0,0,0,,Нақты жоспар туралы тыңдайық.
Dialogue: 0,0:56:35.91,0:56:38.41,Default,,0,0,0,,Келіссөз жүргізу оңай емес.
Dialogue: 0,0:56:39.19,0:56:41.90,Default,,0,0,0,,Бұл үш адамды сендіру мүмкін емес.
Dialogue: 0,0:56:42.52,0:56:46.19,Default,,0,0,0,,Менің қолымнан келгені – бас иіп, жалыну.
Dialogue: 0,0:56:48.71,0:56:49.86,Default,,0,0,0,,Құрметпен
Dialogue: 0,0:56:50.68,0:56:54.41,Default,,0,0,0,,Менен сұрай алмасаң, қауіпті оймен айналысудан басқа амалым қалмайды.
Dialogue: 0,0:56:55.24,0:56:57.40,Default,,0,0,0,,Бақытымызға орай, тілді түсінсек
Dialogue: 0,0:56:57.68,0:56:58.53,Default,,0,0,0,,Ойын ойнауға болады
Dialogue: 0,0:56:59.18,0:57:01.68,Default,,0,0,0,,Жато ойыны?
Dialogue: 0,0:57:03.75,0:57:06.99,Default,,0,0,0,,Ең алдымен сол үш адамды бөлшектеу керек.
Dialogue: 0,0:57:07.69,0:57:10.74,Default,,0,0,0,,Әр адаммен жеке қарым-қатынас жасасаңыз, ешқандай проблема болмайды.
Dialogue: 0,0:57:11.35,0:57:14.58,Default,,0,0,0,,Жүрек астындағы Жүрек Қызық, сіз оны қалай оқисыз?
Dialogue: 0,0:57:15.25,0:57:17.76,Default,,0,0,0,,Олай болса оны орындайық.
Dialogue: 0,0:57:18.34,0:57:20.34,Default,,0,0,0,,Бірақ қазір, кішкентай бала.
Dialogue: 0,0:57:20.87,0:57:23.68,Default,,0,0,0,,Осы үш адаммен қалай келіссөз жүргіземін?
Dialogue: 0,0:57:24.17,0:57:26.31,Default,,0,0,0,,Мәліметтер коммерциялық құпия болып табылады.
Dialogue: 0,0:57:27.25,0:57:29.45,Default,,0,0,0,,Мен өрісті түзетемін.
Dialogue: 0,0:57:30.26,0:57:34.40,Default,,0,0,0,,Ал Арараги-кун олардан аяқ-қолын алады.
Dialogue: 0,0:57:35.91,0:57:38.03,Default,,0,0,0,,Егер сіз қолдарыңыз бен аяқтарыңызды қауіпсіз қалпына келтірсеңіз
Dialogue: 0,0:57:38.57,0:57:41.00,Default,,0,0,0,,Heart Under Blade қуатты қалпына келтіре алады.
Dialogue: 0,0:57:41.35,0:57:46.17,Default,,0,0,0,,Осылайша, Арараги-кун адам болып аман-есен оралады.
Dialogue: 0,0:57:49.17,0:57:50.36,Default,,0,0,0,,Сәлем, қызметші
Dialogue: 0,0:57:51.95,0:57:54.38,Default,,0,0,0,,Мен адам ақшасын дайындай алмаймын.
Dialogue: 0,0:57:55.07,0:57:59.29,Default,,0,0,0,,Мен 2 миллион иен қарыздың қанша екенін білмеймін.
Dialogue: 0,0:58:00.25,0:58:03.18,Default,,0,0,0,,Уну бұл соманы көтере ала ма?
Dialogue: 0,0:58:06.93,0:58:08.01,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:58:08.80,0:58:10.64,Default,,0,0,0,,Бұл баланың өнері шынайы.
Dialogue: 0,0:58:11.61,0:58:14.81,Default,,0,0,0,,Қанша әлсіресем де, мен соншалықты түсінемін.
Dialogue: 0,0:58:17.48,0:58:19.06,Default,,0,0,0,,Менде мұндай жинақ жоқ.
Dialogue: 0,0:58:20.39,0:58:22.34,Default,,0,0,0,,Белгілі бір уақытта төлеу туралы ескерту жоқ
Dialogue: 0,0:58:23.00,0:58:26.47,Default,,0,0,0,,Айтпақшы, кепілгер де, кепіл де қажет емес десеңші.
Dialogue: 0,0:58:28.19,0:58:29.29,Default,,0,0,0,,Мен оны арқама көтеріп алайын
Dialogue: 0,0:58:31.49,0:58:33.23,Default,,0,0,0,,Шешілді.
Dialogue: 0,0:58:34.73,0:58:35.59,Default,,0,0,0,,Майдо бар
Dialogue: 0,0:58:36.77,0:58:37.63,Default,,0,0,0,,Әуе түрмесі!
Dialogue: 0,1:02:43.68,1:02:45.98,Default,,0,0,0,,Көзге көз, тіске тіс
Dialogue: 0,1:02:46.48,1:02:49.40,Default,,0,0,0,,Вампирлер - вампирлер
Dialogue: 0,1:02:50.54,1:02:52.28,Default,,0,0,0,,бастайық.
Dialogue: 0,1:02:53.35,1:02:54.54,Default,,0,0,0,,Өте танымал
Dialogue: 0,1:02:55.84,1:02:58.36,Default,,0,0,0,,Бұл жағымсыз.
Dialogue: 0,1:03:02.45,1:03:06.00,Default,,0,0,0,,Арараги-кун, мен үшін уайымдама.
Dialogue: 0,1:03:06.22,1:03:08.48,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес.
Dialogue: 0,1:03:08.91,1:03:10.53,Default,,0,0,0,,Мен де сені көре алмасам
Dialogue: 0,1:03:10.54,1:03:13.06,Default,,0,0,0,,Адамға қайта оралудың қажеті жоқ.
Dialogue: 0,1:03:13.84,1:03:14.70,Default,,0,0,0,,Арараги-кун
Dialogue: 0,1:03:16.35,1:03:18.07,Default,,0,0,0,,Адам болудан бас тарт
Dialogue: 0,1:03:19.57,1:03:24.57,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
