Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:26.65,0:00:29.26,Default-ja,,0,0,0,,Дүние қашан осылай болды?
Dialogue: 0,0:00:26.77,0:00:28.86,Default,,0,0,0,,Ешкім білмейді...
Dialogue: 0,0:00:29.72,0:00:31.23,Default-ja,,0,0,0,,Өте рахмет… Упс!
Dialogue: 0,0:00:29.82,0:00:31.28,Default,,0,0,0,,Дүние осылай болған кезде.
Dialogue: 0,0:00:34.80,0:00:38.20,Default-ja,,0,0,0,,Бір күні кенеттен инфекция басталды.
Dialogue: 0,0:00:34.90,0:00:37.91,Default,,0,0,0,,Бірде кенеттен жұқпалы ауру басталды...
Dialogue: 0,0:00:39.30,0:00:42.60,Default-ja,,0,0,0,,Адамдар қалаларға қосылу мүмкіндігінен айырылды.
Dialogue: 0,0:00:39.33,0:00:42.41,Default,,0,0,0,,және адамдар қаламен байланысу күшін жоғалтты.
Dialogue: 0,0:00:45.37,0:00:49.29,Default,,0,0,0,,Осыдан кейін қала өздігінен кеңейді...
Dialogue: 0,0:00:45.44,0:00:49.21,Default-ja,,0,0,0,,Содан бері қалалар өздігінен көбейе бастады.
Dialogue: 0,0:00:49.64,0:00:52.38,Default-ja,,0,0,0,,Адамдар заңсыз тұрғындар болып саналады
Dialogue: 0,0:00:49.88,0:00:54.63,Default,,0,0,0,,және адамдар заңсыз тұрғындар ретінде қарастырылды... және жойылды.
Dialogue: 0,0:00:52.78,0:00:55.08,Default-ja,,0,0,0,,Жойылып қалды дейді.
Dialogue: 0,0:01:00.22,0:01:01.62,Default-ja,,0,0,0,,Мен тудым -
Dialogue: 0,0:01:00.26,0:01:01.56,Default,,0,0,0,,Мұның бәрі болды...
Dialogue: 0,0:01:02.59,0:01:04.56,Default-ja,,0,0,0,,Бұрынғы оқиғалар
Dialogue: 0,0:01:02.64,0:01:04.35,Default,,0,0,0,,мен туылғаннан көп бұрын.
Dialogue: 0,0:01:15.34,0:01:18.61,Default-ja,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:58.61,0:01:59.48,Default-ja,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:01:58.91,0:02:00.20,Default,,0,0,0,,Сен оларды сондай-ақ тастап жібересің.
Dialogue: 0,0:02:00.62,0:02:05.52,Default-ja,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:02:14.90,0:02:16.80,Default-ja,,0,0,0,,Ха...
Dialogue: 0,0:02:26.64,0:02:27.58,Default-ja,,0,0,0,,Мұнда
Dialogue: 0,0:02:26.72,0:02:27.64,Default,,0,0,0,,Осы жолмен.
Dialogue: 0,0:02:32.75,0:02:34.75,Default-ja,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:02:34.85,0:02:36.58,Default-ja,,0,0,0,,Уау! Гррр...
Dialogue: 0,0:02:37.65,0:02:38.65,Default-ja,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:02:41.72,0:02:43.79,Default-ja,,0,0,0,,Ха... сақ болыңыз
Dialogue: 0,0:02:42.78,0:02:43.66,Default,,0,0,0,,Солай болар...
Dialogue: 0,0:02:45.39,0:02:48.73,Default-ja,,0,0,0,,Ой... жаман
Dialogue: 0,0:02:47.04,0:02:48.79,Default,,0,0,0,,Иә. Кешіріңіз.
Dialogue: 0,0:02:55.94,0:02:58.67,Default-ja,,0,0,0,,Хамф, сен тым қорқасың.
Dialogue: 0,0:02:57.21,0:02:58.76,Default,,0,0,0,,Сіз тым сергексіз.
Dialogue: 0,0:02:59.27,0:03:00.21,Default-ja,,0,0,0,,Мен сізді естимін
Dialogue: 0,0:02:59.30,0:03:00.26,Default,,0,0,0,,Біз сізді ести аламыз.
Dialogue: 0,0:03:01.22,0:03:03.85,Default,,0,0,0,,Бұл жерде бәрібір.
Dialogue: 0,0:03:01.28,0:03:03.78,Default-ja,,0,0,0,,Бұл жерде бәрібір.
Dialogue: 0,0:03:03.85,0:03:06.71,Default-ja,,0,0,0,,Мүмкін менің жолым болған шығар...
Dialogue: 0,0:03:03.93,0:03:06.39,Default,,0,0,0,,Осы уақытқа дейін біздің жолымыз болған шығар.
Dialogue: 0,0:03:06.78,0:03:07.65,Default-ja,,0,0,0,,Сақтықты төмендетпеңіз
Dialogue: 0,0:03:06.89,0:03:09.06,Default,,0,0,0,,-Сақтықты түсірмеңіз. -Бірақ...
Dialogue: 0,0:03:07.95,0:03:08.92,Default-ja,,0,0,0,,Бірақ…
Dialogue: 0,0:03:09.14,0:03:10.39,Default,,0,0,0,,Зурудың айтқаны дұрыс.
Dialogue: 0,0:03:09.22,0:03:10.32,Default-ja,,0,0,0,,Бұл Зуру айтқандай.
Dialogue: 0,0:03:14.96,0:03:17.53,Default-ja,,0,0,0,,Менің ойымша, бұл жол шынымен дұрыс па...
Dialogue: 0,0:03:15.11,0:03:17.36,Default,,0,0,0,,Бұл шынымен де дұрыс жол ма деп ойлаймын.
Dialogue: 0,0:03:18.23,0:03:20.86,Default,,0,0,0,,Картадан сәл басқаша.
Dialogue: 0,0:03:18.26,0:03:20.70,Default-ja,,0,0,0,,Бұл картадан сәл өзгеше болуы мүмкін.
Dialogue: 0,0:03:21.63,0:03:22.96,Default-ja,,0,0,0,,Өйткені бұл ескі карта
Dialogue: 0,0:03:21.70,0:03:25.24,Default,,0,0,0,,Бұл ескі карта. Бұл аумақты құрылысшылар қайта салған болуы керек.
Dialogue: 0,0:03:23.23,0:03:25.53,Default-ja,,0,0,0,,Оны құрылысшылар қайта салған.
Dialogue: 0,0:03:26.33,0:03:28.91,Default,,0,0,0,,Сіз шынымен біз өз бетімізше жақсы боламыз деп ойлайсыз ба?
Dialogue: 0,0:03:26.37,0:03:28.87,Default-ja,,0,0,0,,Біз шынымен өзімізбен жақсымыз ба?
Dialogue: 0,0:03:29.33,0:03:30.75,Default,,0,0,0,,Енді қайтайық.
Dialogue: 0,0:03:29.37,0:03:30.61,Default-ja,,0,0,0,,Енді қайтайық.
Dialogue: 0,0:03:31.41,0:03:33.92,Default,,0,0,0,,Осы уақытқа дейін жеткенде біз неге қайтамыз?
Dialogue: 0,0:03:31.44,0:03:33.58,Default-ja,,0,0,0,,Осы жерге келіп, кері қайтуға бола ма?
Dialogue: 0,0:03:35.25,0:03:37.42,Default,,0,0,0,,Бұл үзіндінің арғы жағында болуы керек.
Dialogue: 0,0:03:35.28,0:03:37.55,Default-ja,,0,0,0,,Осы жолдан өткен бойда...
Dialogue: 0,0:03:38.71,0:03:39.59,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:03:38.71,0:03:39.61,Default-ja,,0,0,0,,Онда тас, қағаз, қайшы ойнайық.
Dialogue: 0,0:03:41.34,0:03:42.93,Default,,0,0,0,,Зуру, жоғарыда.
Dialogue: 0,0:03:41.42,0:03:42.75,Default-ja,,0,0,0,,Зуру ана жерде!
Dialogue: 0,0:03:46.79,0:03:47.82,Default-ja,,0,0,0,,Шығу!
Dialogue: 0,0:03:46.85,0:03:47.72,Default,,0,0,0,,Шығу.
Dialogue: 0,0:04:15.82,0:04:18.29,Default-ja,,0,0,0,,Ах... Ах! Ха...!
Dialogue: 0,0:04:19.42,0:04:20.59,Default-ja,,0,0,0,,Ах! Тэ!
Dialogue: 0,0:04:19.67,0:04:20.71,Default,,0,0,0,,Тэ!
Dialogue: 0,0:04:23.52,0:04:25.76,Default-ja,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:04:27.68,0:04:29.56,Default,,0,0,0,,Амансың ба? Тэ?
Dialogue: 0,0:04:27.73,0:04:29.73,Default-ja,,0,0,0,,Амансың ба... Тэ?
Dialogue: 0,0:04:30.70,0:04:32.40,Default-ja,,0,0,0,,Рахмет сізге Фусата
Dialogue: 0,0:04:30.77,0:04:32.48,Default,,0,0,0,,Рахмет, Фусата.
Dialogue: 0,0:04:38.36,0:04:39.52,Default,,0,0,0,,Жақсысың ба, Тэ?
Dialogue: 0,0:04:38.41,0:04:39.71,Default-ja,,0,0,0,,Амансың ба? Тэ
Dialogue: 0,0:04:40.01,0:04:42.38,Default-ja,,0,0,0,,Кешіріңіз, сақтау батареясы...
Dialogue: 0,0:04:40.11,0:04:42.44,Default,,0,0,0,,Кешіріңіз, Зуру. Қосалқы батарея.
Dialogue: 0,0:04:42.53,0:04:44.32,Default,,0,0,0,,Қайтып оралғанымызда қиындыққа тап боламыз.
Dialogue: 0,0:04:42.68,0:04:44.35,Default-ja,,0,0,0,,Қайтсаң, ұрысады.
Dialogue: 0,0:04:44.40,0:04:45.82,Default,,0,0,0,,Бұл бір ғана батарея.
Dialogue: 0,0:04:44.41,0:04:46.05,Default-ja,,0,0,0,,Бір аккумулятор туралы
Dialogue: 0,0:04:46.32,0:04:50.08,Default,,0,0,0,,Егер біз лаймен оралсақ, бәрі қуанады. Кәне.
Dialogue: 0,0:04:46.38,0:04:49.28,Default-ja,,0,0,0,,Үйге балшық әкелсең бәрі қуанады дейді.
Dialogue: 0,0:04:49.35,0:04:50.35,Default-ja,,0,0,0,,Кеттік
Dialogue: 0,0:04:51.65,0:04:52.89,Default-ja,,0,0,0,,Зуру!
Dialogue: 0,0:04:51.66,0:04:52.54,Default,,0,0,0,,Зуру.
Dialogue: 0,0:04:54.02,0:04:55.82,Default-ja,,0,0,0,,Зуру не істеп жатырсың сонша тез...
Dialogue: 0,0:04:54.12,0:04:56.46,Default,,0,0,0,,Зуру, сен не істеп жатырсың? Асығыңыз.
Dialogue: 0,0:04:55.89,0:04:59.53,Default-ja,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:02.76,0:05:05.60,Default-ja,,0,0,0,,Хаа... Құрылысшы!
Dialogue: 0,0:05:03.92,0:05:05.17,Default,,0,0,0,,Құрылысшы!
Dialogue: 0,0:05:12.01,0:05:13.01,Default-ja,,0,0,0,,Жарайды
Dialogue: 0,0:05:12.14,0:05:13.02,Default,,0,0,0,,Не бұл, Хиёри? Жаңа жылдық әзіл ме?
Dialogue: 0,0:05:13.81,0:05:16.38,Default-ja,,0,0,0,,Бұл жігіттер адаммен араласпайды.
Dialogue: 0,0:05:13.85,0:05:16.44,Default,,0,0,0,,Бұл жігіттер адамға мән бермейді.
Dialogue: 0,0:05:29.42,0:05:32.66,Default-ja,,0,0,0,,Хаа... кеттік.
Dialogue: 0,0:05:30.87,0:05:34.41,Default,,0,0,0,,Жарайды, кеттік. Біз жақындап қалдық.
Dialogue: 0,0:05:33.46,0:05:34.70,Default-ja,,0,0,0,,Өйткені ол жақында келеді
Dialogue: 0,0:05:42.00,0:05:44.01,Default-ja,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:48.59,0:05:50.39,Default,,0,0,0,,Бұл одан да оғаш нәрселер жасайды.
Dialogue: 0,0:05:48.61,0:05:50.45,Default-ja,,0,0,0,,Мен тағы бір оғаш нәрсе жасап жатырмын.
Dialogue: 0,0:05:50.47,0:05:51.97,Default,,0,0,0,,Кеттік, Тэ.
Dialogue: 0,0:05:50.51,0:05:51.81,Default-ja,,0,0,0,,Кеттік, Тэ.
Dialogue: 0,0:05:58.89,0:06:00.66,Default-ja,,0,0,0,,Уау...
Dialogue: 0,0:05:59.02,0:06:00.44,Default,,0,0,0,,Ой, бұл...
Dialogue: 0,0:06:00.86,0:06:03.36,Default-ja,,0,0,0,,Мұндай үлкен жерді бірінші рет көруім
Dialogue: 0,0:06:00.90,0:06:03.40,Default,,0,0,0,,Мен мұндай үлкен жерді ешқашан көрген емеспін.
Dialogue: 0,0:06:03.56,0:06:06.73,Default-ja,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:06:09.46,0:06:11.77,Default-ja,,0,0,0,,Ха... Күзет мұнарасы!
Dialogue: 0,0:06:10.95,0:06:11.82,Default,,0,0,0,,Күзет мұнарасы!
Dialogue: 0,0:06:11.93,0:06:12.87,Default-ja,,0,0,0,,Ха…
Dialogue: 0,0:06:27.42,0:06:30.43,Default,,0,0,0,,Сондықтан үлкендер бізге келме деді.
Dialogue: 0,0:06:27.52,0:06:30.38,Default-ja,,0,0,0,,Сондықтан үлкендер бұл жерге жақындамаңдар...
Dialogue: 0,0:06:30.45,0:06:31.85,Default-ja,,0,0,0,,Бұл мүмкін емес. Қазір үйге барайық.
Dialogue: 0,0:06:30.51,0:06:32.01,Default,,0,0,0,,Міне, солай. Үйге барайық.
Dialogue: 0,0:06:32.02,0:06:34.02,Default-ja,,0,0,0,,Күзет мұнарасы сізді таппаса, бәрі жақсы!
Dialogue: 0,0:06:32.10,0:06:34.22,Default,,0,0,0,,Күзет мұнарасы бізді көрмейтініне көз жеткізіңіз.
Dialogue: 0,0:06:34.31,0:06:35.64,Default,,0,0,0,,Ал біз қалай істеуіміз керек?
Dialogue: 0,0:06:34.42,0:06:37.56,Default-ja,,0,0,0,,Осындай үлкен қарауыл мұнарасынан қашып аң аулайтын жерге қалай жетуге болады?
Dialogue: 0,0:06:35.72,0:06:38.39,Default,,0,0,0,,бұл үлкен нәрседен аулақ бола отырып, аң аулайтын жерге бару керек пе?
Dialogue: 0,0:06:38.56,0:06:39.73,Default,,0,0,0,,Басқа жолды алайық.
Dialogue: 0,0:06:38.56,0:06:39.73,Default-ja,,0,0,0,,Айналмалы жолмен жүрейік
Dialogue: 0,0:06:40.09,0:06:41.63,Default-ja,,0,0,0,,Осы жерден өтіңіз
Dialogue: 0,0:06:40.23,0:06:41.31,Default,,0,0,0,,Біз осы жерден өтеміз.
Dialogue: 0,0:06:42.44,0:06:44.36,Default,,0,0,0,,Бұл үлкен айналма жол.
Dialogue: 0,0:06:42.50,0:06:44.13,Default-ja,,0,0,0,,Қандай айналма жол...
Dialogue: 0,0:06:44.44,0:06:46.65,Default,,0,0,0,,Жолда көптеген кедергілер бар.
Dialogue: 0,0:06:44.50,0:06:46.63,Default-ja,,0,0,0,,Ол кедергілерге толы...
Dialogue: 0,0:06:46.70,0:06:48.77,Default-ja,,0,0,0,,Амал жоқ, жүр.
Dialogue: 0,0:06:46.73,0:06:48.90,Default,,0,0,0,,Жарайды, оған көмектесу мүмкін емес. Кәне.
Dialogue: 0,0:07:03.45,0:07:05.95,Default-ja,,0,0,0,,Егер осындай жағдайда қорғаушы шықса...
Dialogue: 0,0:07:03.58,0:07:06.09,Default,,0,0,0,,Егер қорғаныс құралы осындай жерде пайда болса...
Dialogue: 0,0:07:06.50,0:07:09.84,Default,,0,0,0,,Біз де электро-балықшылар ретінде дайындалдық.
Dialogue: 0,0:07:06.55,0:07:09.72,Default-ja,,0,0,0,,Тіпті біз электр балықшы ретінде дайындалдық.
Dialogue: 0,0:07:09.92,0:07:14.85,Default,,0,0,0,,Сутезо Зурудың толыққанды Электро-Фишер сияқты білікті екенін айтты.
Dialogue: 0,0:07:10.02,0:07:13.53,Default-ja,,0,0,0,,Зуруда толыққанды балықшының өнері бар дейді.
Dialogue: 0,0:07:13.59,0:07:14.80,Default-ja,,0,0,0,,Сутезо айтты
Dialogue: 0,0:07:14.86,0:07:17.10,Default-ja,,0,0,0,,Бірақ сіз жабдықты рұқсатсыз алып кеткенсіз...
Dialogue: 0,0:07:14.93,0:07:17.22,Default,,0,0,0,,Бірақ біз бұл құралды рұқсатсыз алдық.
Dialogue: 0,0:07:17.17,0:07:19.60,Default-ja,,0,0,0,,Маған міндетті түрде қария ұрысады.
Dialogue: 0,0:07:17.31,0:07:19.23,Default,,0,0,0,,Попс міндетті түрде жынды болады.
Dialogue: 0,0:07:20.77,0:07:22.60,Default-ja,,0,0,0,,Зуру… Кешіріңіз.
Dialogue: 0,0:07:20.85,0:07:22.77,Default,,0,0,0,,Зуру, кешіріңіз.
Dialogue: 0,0:07:23.00,0:07:24.21,Default-ja,,0,0,0,,Не? Тэ
Dialogue: 0,0:07:23.06,0:07:24.44,Default,,0,0,0,,Не? Тэ?
Dialogue: 0,0:07:24.77,0:07:27.11,Default-ja,,0,0,0,,Сіз мұны әпкеңіз үшін айттыңыз, солай ма?
Dialogue: 0,0:07:25.02,0:07:27.28,Default,,0,0,0,,Менің әпкем үшін дедіңіз ғой, солай ма?
Dialogue: 0,0:07:27.78,0:07:29.90,Default,,0,0,0,,Осылай жалғыз аңға шығуымыз үшін.
Dialogue: 0,0:07:27.81,0:07:29.78,Default-ja,,0,0,0,,Өзіміз аңшылыққа барайық.
Dialogue: 0,0:07:30.57,0:07:32.03,Default,,0,0,0,,Бұл тек Ито үшін ғана емес.
Dialogue: 0,0:07:30.58,0:07:31.88,Default-ja,,0,0,0,,Бұл тек Ито-Чан үшін емес.
Dialogue: 0,0:07:33.01,0:07:36.62,Default-ja,,0,0,0,,Ауылда енді жейтін ештеңе жоқ.
Dialogue: 0,0:07:33.07,0:07:36.33,Default,,0,0,0,,Ауылда жейтін ештеңе қалмады ғой.
Dialogue: 0,0:07:37.22,0:07:39.59,Default-ja,,0,0,0,,Рахмет... Зуру
Dialogue: 0,0:07:37.33,0:07:39.25,Default,,0,0,0,,Рахмет, Зуру.
Dialogue: 0,0:07:43.16,0:07:44.09,Default-ja,,0,0,0,,Ах...
Dialogue: 0,0:07:53.30,0:07:54.43,Default,,0,0,0,,Біз мұны жасадық.
Dialogue: 0,0:07:53.47,0:07:54.70,Default-ja,,0,0,0,,Иә!
Dialogue: 0,0:07:55.77,0:07:57.67,Default-ja,,0,0,0,,Қараңызшы
Dialogue: 0,0:07:55.80,0:07:57.35,Default,,0,0,0,,Қараңдаршы.
Dialogue: 0,0:08:03.78,0:08:05.55,Default-ja,,0,0,0,,Жәндіктер жиналып жатыр
Dialogue: 0,0:08:04.02,0:08:05.23,Default,,0,0,0,,Барлық қателерді қараңыз!
Dialogue: 0,0:08:05.75,0:08:07.48,Default-ja,,0,0,0,,Бұл лайлы құбыр!
Dialogue: 0,0:08:05.77,0:08:07.02,Default,,0,0,0,,Бұл шлам құбырлары!
Dialogue: 0,0:08:07.94,0:08:08.82,Default,,0,0,0,,Шынымен
Dialogue: 0,0:08:07.95,0:08:08.82,Default-ja,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:10.18,0:08:14.62,Default-ja,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:22.71,0:08:23.75,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:08:22.73,0:08:23.66,Default-ja,,0,0,0,,Жоқ...
Dialogue: 0,0:08:25.13,0:08:27.13,Default-ja,,0,0,0,,Ол әбден қурап қалды...
Dialogue: 0,0:08:25.21,0:08:27.34,Default,,0,0,0,,Ол мүлде кеуіп қалды.
Dialogue: 0,0:08:27.74,0:08:29.97,Default-ja,,0,0,0,,Бұл қалың түтік болса да...
Dialogue: 0,0:08:27.92,0:08:29.63,Default,,0,0,0,,Бірақ бұл сондай қалың құбыр.
Dialogue: 0,0:08:32.11,0:08:34.74,Default-ja,,0,0,0,,Ах... Зуру...
Dialogue: 0,0:08:33.42,0:08:34.55,Default,,0,0,0,,Зуру.
Dialogue: 0,0:08:39.05,0:08:44.82,Default-ja,,0,0,0,,(Ескерту дабылы)
Dialogue: 0,0:08:44.89,0:08:45.75,Default-ja,,0,0,0,,Күзет мұнарасы!
Dialogue: 0,0:08:45.19,0:08:46.44,Default,,0,0,0,,Күзет мұнарасы?
Dialogue: 0,0:08:51.89,0:08:52.89,Default-ja,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:09:02.83,0:09:03.91,Default,,0,0,0,,Қорғау!
Dialogue: 0,0:09:02.94,0:09:03.80,Default-ja,,0,0,0,,Сақтандыру!
Dialogue: 0,0:09:04.00,0:09:05.08,Default,,0,0,0,,Жоюшылар!
Dialogue: 0,0:09:04.07,0:09:04.94,Default-ja,,0,0,0,,Жою түрі!
Dialogue: 0,0:09:11.78,0:09:13.61,Default-ja,,0,0,0,,Yaichi top! Апыр-ай!
Dialogue: 0,0:09:11.80,0:09:12.92,Default,,0,0,0,,Яичи! Үстіңізде!
Dialogue: 0,0:09:16.68,0:09:17.55,Default-ja,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:09:19.69,0:09:20.96,Default-ja,,0,0,0,,Жоқ!
Dialogue: 0,0:09:30.44,0:09:31.32,Default,,0,0,0,,Шегін!
Dialogue: 0,0:09:30.63,0:09:31.30,Default-ja,,0,0,0,,Артқа қадам жасаңыз!
Dialogue: 0,0:09:36.70,0:09:37.61,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:09:36.70,0:09:37.57,Default-ja,,0,0,0,,Жүгіру!
Dialogue: 0,0:09:58.18,0:10:01.18,Default,,0,0,0,,Барлығыңыз, сабырлы болыңыздар! Біздің жаттығуларымызды есте сақтаңыз, оларды қызықтырыңыз
Dialogue: 0,0:09:58.29,0:09:59.73,Default-ja,,0,0,0,,Барлығың тынышталыңдар.
Dialogue: 0,0:09:59.79,0:10:02.06,Default-ja,,0,0,0,,Оларды азғырып, шабуыл жасау үшін жаттығуды орындаңыз!
Dialogue: 0,0:10:01.26,0:10:02.18,Default,,0,0,0,,содан кейін ат!
Dialogue: 0,0:10:02.13,0:10:03.97,Default-ja,,0,0,0,,Сіз мұны естідіңіз бе? Шизу! мені өз жеріңе шақыр
Dialogue: 0,0:10:02.26,0:10:04.31,Default,,0,0,0,,Сіз мұны естідіңіз бе, Шизу? Оларды маған тарт!
Dialogue: 0,0:10:04.03,0:10:05.30,Default-ja,,0,0,0,,Мен оны сілкіп тастай алмаймын!
Dialogue: 0,0:10:04.39,0:10:05.52,Default,,0,0,0,,Мен оларды қолымнан түсіре алмаймын!
Dialogue: 0,0:10:06.93,0:10:08.74,Default-ja,,0,0,0,,Жоқ! Шизу!
Dialogue: 0,0:10:07.73,0:10:08.98,Default,,0,0,0,,Шизу!
Dialogue: 0,0:10:08.97,0:10:11.37,Default-ja,,0,0,0,,Қарғыс атсын... Уау!
Dialogue: 0,0:10:09.06,0:10:10.10,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:10:11.64,0:10:13.24,Default-ja,,0,0,0,,Ширу! барлығы...!
Dialogue: 0,0:10:11.65,0:10:13.02,Default,,0,0,0,,Широ! Барлығына!
Dialogue: 0,0:10:15.91,0:10:17.11,Default-ja,,0,0,0,,Кяа~! Тэ!
Dialogue: 0,0:10:16.78,0:10:17.86,Default,,0,0,0,,Тэ!
Dialogue: 0,0:10:21.62,0:10:23.82,Default-ja,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,0:10:25.02,0:10:25.89,Default-ja,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:10:27.36,0:10:28.36,Default-ja,,0,0,0,,Уау!
Dialogue: 0,0:10:31.33,0:10:32.19,Default-ja,,0,0,0,,Тэ!
Dialogue: 0,0:10:31.88,0:10:32.92,Default,,0,0,0,,Тэ!
Dialogue: 0,0:10:43.84,0:10:45.67,Default-ja,,0,0,0,,Уф... Зуру!
Dialogue: 0,0:10:45.35,0:10:46.31,Default,,0,0,0,,Зуру!
Dialogue: 0,0:10:50.04,0:10:50.91,Default-ja,,0,0,0,,Уау!
Dialogue: 0,0:11:42.96,0:11:48.44,Default-ja,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:52.34,0:11:56.31,Default-ja,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:05.25,0:12:06.12,Default-ja,,0,0,0,,Уф...
Dialogue: 0,0:12:08.96,0:12:12.26,Default-ja,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:15.23,0:12:16.10,Default-ja,,0,0,0,,Әлі емес...!
Dialogue: 0,0:12:15.27,0:12:16.15,Default,,0,0,0,,Толығырақ!
Dialogue: 0,0:12:24.21,0:12:25.14,Default-ja,,0,0,0,,Зуру!
Dialogue: 0,0:12:24.24,0:12:25.07,Default,,0,0,0,,Зуру!
Dialogue: 0,0:12:34.01,0:12:36.05,Default-ja,,0,0,0,,Амансың ба? Зуру…
Dialogue: 0,0:12:34.08,0:12:35.21,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,0:12:35.29,0:12:36.13,Default,,0,0,0,,Зуру!
Dialogue: 0,0:12:36.82,0:12:38.75,Default-ja,,0,0,0,,Ой... иә...
Dialogue: 0,0:12:38.79,0:12:40.25,Default,,0,0,0,,Иә, бұл жоқ...
Dialogue: 0,0:12:38.82,0:12:40.29,Default-ja,,0,0,0,,Осыған дейін... Мен жақсымын.
Dialogue: 0,0:12:44.46,0:12:46.93,Default-ja,,0,0,0,,Ха...! Күте тұрыңыз, Фусата
Dialogue: 0,0:12:45.26,0:12:46.59,Default,,0,0,0,,Күте тұрыңыз, Фусата.
Dialogue: 0,0:13:05.11,0:13:06.25,Default-ja,,0,0,0,,Тоқтатылды...
Dialogue: 0,0:13:05.15,0:13:06.07,Default,,0,0,0,,Ол тоқтады.
Dialogue: 0,0:13:07.31,0:13:09.35,Default-ja,,0,0,0,,Бас жабдығыңызды шешіңіз (барлығыңыз) Ха...!
Dialogue: 0,0:13:07.36,0:13:08.91,Default,,0,0,0,,Бас киіміңізді шешіңіз.
Dialogue: 0,0:13:11.19,0:13:12.35,Default-ja,,0,0,0,,Көздеріңді көргім келеді
Dialogue: 0,0:13:11.20,0:13:12.37,Default,,0,0,0,,Көздеріңді көргім келеді.
Dialogue: 0,0:13:14.32,0:13:16.22,Default-ja,,0,0,0,,Бағана. ➡
Dialogue: 0,0:13:15.79,0:13:17.58,Default,,0,0,0,,-Сәлем. -Зуру.
Dialogue: 0,0:13:16.29,0:13:17.86,Default-ja,,0,0,0,,zu… zuru…
Dialogue: 0,0:13:23.56,0:13:25.30,Default-ja,,0,0,0,,Ха... Зуру!
Dialogue: 0,0:13:24.42,0:13:25.30,Default,,0,0,0,,Зуру!
Dialogue: 0,0:13:25.37,0:13:27.27,Default-ja,,0,0,0,,Сіз оны қарауыл мұнарасынан көре аласыз!
Dialogue: 0,0:13:25.38,0:13:27.18,Default,,0,0,0,,Біз әлі де күзет мұнарасының назарындамыз!
Dialogue: 0,0:13:46.95,0:13:47.82,Default-ja,,0,0,0,,Ха…
Dialogue: 0,0:13:48.29,0:13:50.29,Default-ja,,0,0,0,,А... неге?
Dialogue: 0,0:13:49.32,0:13:50.16,Default,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:13:51.16,0:13:55.00,Default-ja,,0,0,0,,Хелметталды алсам да, қарауыл мұнарасы жауап бермейді...?
Dialogue: 0,0:13:51.37,0:13:54.75,Default,,0,0,0,,Күзет мұнарасы дулығасын шешіп алған кезде де әрекет етпеді ме?
Dialogue: 0,0:13:58.57,0:13:59.43,Default-ja,,0,0,0,,Сен «Телефон ауқымын» айтып тұрсың ба? Иә
Dialogue: 0,0:14:00.57,0:14:04.34,Default-ja,,0,0,0,,Уа... Эй, Тэ! Уф...
Dialogue: 0,0:14:01.54,0:14:02.67,Default,,0,0,0,,Сәлем! Тэ!
Dialogue: 0,0:14:12.51,0:14:14.08,Default-ja,,0,0,0,,Осы жерде
Dialogue: 0,0:14:12.60,0:14:13.68,Default,,0,0,0,,Бар ма...
Dialogue: 0,0:14:14.68,0:14:19.56,Default,,0,0,0,,Мұнда таза терминал гені бар адамдар бар ма?
Dialogue: 0,0:14:14.85,0:14:19.39,Default-ja,,0,0,0,,Интернет терминалының гендері бар адамдар бар ма?
Dialogue: 0,0:14:20.35,0:14:23.09,Default-ja,,0,0,0,,Не... Нет Тамма...?
Dialogue: 0,0:14:21.31,0:14:22.77,Default,,0,0,0,,Таза термин...?
Dialogue: 0,0:14:23.29,0:14:25.03,Default-ja,,0,0,0,,Эх… Не?
Dialogue: 0,0:14:24.32,0:14:25.15,Default,,0,0,0,,Жер
Dialogue: 0,0:14:28.86,0:14:33.45,Default,,0,0,0,,Сіз бізді құтқардыңыз... сондықтан сізге көмектесу үшін бірдеңе жасасақ деп тілеймін...
Dialogue: 0,0:14:28.93,0:14:30.40,Default-ja,,0,0,0,,Мен біраз көмек алдым...
Dialogue: 0,0:14:31.37,0:14:33.37,Default-ja,,0,0,0,,Мен бірдеңе істей алғым келеді
Dialogue: 0,0:14:34.57,0:14:37.40,Default-ja,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:14:34.66,0:14:37.12,Default,,0,0,0,,бірақ сіз не туралы айтып жатқаныңызды білмейміз.
Dialogue: 0,0:14:46.01,0:14:49.97,Default,,0,0,0,,Күтіңіз. Үлкендердің бірі бірдеңе білуі мүмкін.
Dialogue: 0,0:14:46.11,0:14:46.98,Default-ja,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:14:47.38,0:14:50.02,Default-ja,,0,0,0,,Кейбір ересектер білуі мүмкін.
Dialogue: 0,0:14:54.66,0:14:56.46,Default-ja,,0,0,0,,Оған дейін айтып берші
Dialogue: 0,0:14:54.81,0:14:56.77,Default,,0,0,0,,Бірақ бұған дейін бізге айтыңызшы...
Dialogue: 0,0:14:59.16,0:15:00.93,Default-ja,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:59.18,0:15:00.56,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:06.27,0:15:07.33,Default-ja,,0,0,0,,Мен...
Dialogue: 0,0:15:06.28,0:15:09.24,Default,,0,0,0,,Мен Киллимін.
Dialogue: 0,0:15:08.47,0:15:09.54,Default-ja,,0,0,0,,Тұман шошқа
Dialogue: 0,0:15:13.31,0:15:14.61,Default-ja,,0,0,0,,Адам
Dialogue: 0,0:15:13.37,0:15:14.49,Default,,0,0,0,,Адам.
Dialogue: 0,0:15:55.38,0:15:58.95,Default-ja,,0,0,0,,Біздің ауыл бұдан арғы бөгеттің ішінде.
Dialogue: 0,0:15:55.45,0:15:58.54,Default,,0,0,0,,Біздің ауыл алдыңғы периметрдің ішінде.
Dialogue: 0,0:16:03.22,0:16:05.16,Default-ja,,0,0,0,,Ол жаққа қайтып барсаңыз, бәрі жақсы болады.
Dialogue: 0,0:16:03.33,0:16:05.25,Default,,0,0,0,,Ол жерге оралған соң бәріміз жақсы боламыз.
Dialogue: 0,0:16:07.49,0:16:08.70,Default-ja,,0,0,0,,Тосқауыл…
Dialogue: 0,0:16:07.54,0:16:08.46,Default,,0,0,0,,Периметр.
Dialogue: 0,0:16:12.05,0:16:14.55,Default,,0,0,0,,Бұл қауіпсіздік құралының кіре алмайтын жері.
Dialogue: 0,0:16:12.10,0:16:14.47,Default-ja,,0,0,0,,Бұл қауіпсіздік шараларын енгізуге болмайтын жалғыз орын.
Dialogue: 0,0:16:15.64,0:16:17.54,Default-ja,,0,0,0,,Неге екенін білмеймін, бірақ
Dialogue: 0,0:16:15.72,0:16:17.26,Default,,0,0,0,,Біз неге екенін білмейміз.
Dialogue: 0,0:16:36.19,0:16:38.53,Default-ja,,0,0,0,,Қараңызшы, бұдан арғы тосқауыл бар.
Dialogue: 0,0:16:36.24,0:16:38.33,Default,,0,0,0,,Қараңызшы, бұл алдыңғы периметр.
Dialogue: 0,0:16:43.26,0:16:45.10,Default-ja,,0,0,0,,А... тоқтаңдар!
Dialogue: 0,0:16:44.08,0:16:47.63,Default,,0,0,0,,Тоқта! Зуру, одан аулақ жүр!
Dialogue: 0,0:16:45.50,0:16:47.47,Default-ja,,0,0,0,,Зуру ол жігіттен кет!
Dialogue: 0,0:16:48.20,0:16:49.67,Default-ja,,0,0,0,,Сакузо күтіңіз!
Dialogue: 0,0:16:48.21,0:16:49.92,Default,,0,0,0,,Сутезо, күте тұрыңыз!
Dialogue: 0,0:16:50.04,0:16:52.04,Default-ja,,0,0,0,,О... балалар!
Dialogue: 0,0:16:51.09,0:16:54.68,Default,,0,0,0,,Неге бәрің өз беттеріңді көрсетіп жатырсыңдар? Сізді қарауыл мұнарасы көреді!
Dialogue: 0,0:16:52.11,0:16:54.51,Default-ja,,0,0,0,,Неге бетіңізді көрсетіп тұрсыз? Сіз күзет мұнарасынан табыласыз!
Dialogue: 0,0:16:55.21,0:16:56.31,Default-ja,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:16:55.26,0:16:58.72,Default,,0,0,0,,Себебі, біз онымен бірге болсақ, бәрібір.
Dialogue: 0,0:16:56.51,0:16:58.55,Default-ja,,0,0,0,,Мен осы адамның қасында болғанда өзімді жақсы сезінемін.
Dialogue: 0,0:16:58.80,0:17:00.18,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:16:59.05,0:17:00.15,Default-ja,,0,0,0,,Не? Сол
Dialogue: 0,0:17:00.21,0:17:02.22,Default-ja,,0,0,0,,Маған Кири-сан көмектесті.
Dialogue: 0,0:17:00.26,0:17:02.35,Default,,0,0,0,,Килли мырза бізді құтқарды.
Dialogue: 0,0:17:02.28,0:17:03.15,Default-ja,,0,0,0,,Адам!
Dialogue: 0,0:17:02.43,0:17:03.77,Default,,0,0,0,,Ол адам!
Dialogue: 0,0:17:03.22,0:17:05.35,Default-ja,,0,0,0,,Ха...? Адам...
Dialogue: 0,0:17:04.60,0:17:05.48,Default,,0,0,0,,Адам?
Dialogue: 0,0:17:06.32,0:17:07.55,Default-ja,,0,0,0,,Бұл өтірік
Dialogue: 0,0:17:06.40,0:17:07.31,Default,,0,0,0,,Ол болуы мүмкін емес.
Dialogue: 0,0:17:08.46,0:17:09.79,Default-ja,,0,0,0,,Егер ол адам болса...?
Dialogue: 0,0:17:08.61,0:17:10.02,Default,,0,0,0,,Адам дейсіз бе?
Dialogue: 0,0:17:10.11,0:17:11.86,Default,,0,0,0,,Ол қорғаушы емес пе?
Dialogue: 0,0:17:10.12,0:17:12.06,Default-ja,,0,0,0,,Бұл қорғаныс емес пе?
Dialogue: 0,0:17:12.36,0:17:15.24,Default,,0,0,0,,Мен адамдарға ұқсайтын қорғаныс құралдары бар екенін естідім.
Dialogue: 0,0:17:12.43,0:17:15.33,Default-ja,,0,0,0,,Адамдарға ұқсайтын қорғаныс құралдары бар деп естідім.
Dialogue: 0,0:17:15.80,0:17:17.60,Default-ja,,0,0,0,,Ей, ақсақал... Әй!
Dialogue: 0,0:17:15.95,0:17:17.32,Default,,0,0,0,,Дұрыс, Pops.
Dialogue: 0,0:17:22.70,0:17:24.20,Default-ja,,0,0,0,,Тек үш адам?
Dialogue: 0,0:17:22.79,0:17:24.04,Default,,0,0,0,,Сіз үшеусіз, иә?
Dialogue: 0,0:17:25.54,0:17:26.71,Default-ja,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:17:25.58,0:17:28.71,Default,,0,0,0,,Кешіріңіз. Жоюшылар...
Dialogue: 0,0:17:27.41,0:17:29.08,Default-ja,,0,0,0,,Барлығы қырып-жоюшы...
Dialogue: 0,0:17:29.24,0:17:31.11,Default-ja,,0,0,0,,Сол үшін айттым ғой! Зуру
Dialogue: 0,0:17:29.25,0:17:33.05,Default,,0,0,0,,Сондықтан біз саған айттық, Зуру, сендер мұны өз бетімен жасай алмайсыңдар!
Dialogue: 0,0:17:31.18,0:17:32.81,Default-ja,,0,0,0,,Балалар, сендер жалғыз істей алмайсыңдар.
Dialogue: 0,0:17:33.13,0:17:36.22,Default,,0,0,0,,Бірақ сіз бәрібір біздің рұқсатымыздысыз барып, әлгі құралды алдыңыз.
Dialogue: 0,0:17:33.45,0:17:36.35,Default-ja,,0,0,0,,Бірақ сіз жабдықты рұқсатсыз алып кеткенсіз... Уф!
Dialogue: 0,0:17:36.52,0:17:38.82,Default-ja,,0,0,0,,Қалай болғанда да, мұндай жерде мәңгі қалу қауіпті.
Dialogue: 0,0:17:36.63,0:17:38.68,Default,,0,0,0,,Қалай болғанда да, бұл жерде қалу қауіпті.
Dialogue: 0,0:17:39.42,0:17:40.79,Default-ja,,0,0,0,,Шлагбаумға жылдам кіріңіз
Dialogue: 0,0:17:39.47,0:17:41.14,Default,,0,0,0,,Тезірек периметрдің ішіне кіріңіз.
Dialogue: 0,0:17:49.10,0:17:51.07,Default-ja,,0,0,0,,Қарғыс атсын... қарт!
Dialogue: 0,0:17:50.06,0:17:51.11,Default,,0,0,0,,Поп!
Dialogue: 0,0:17:53.80,0:17:54.67,Default-ja,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:17:56.67,0:18:00.24,Default-ja,,0,0,0,,Бұл қорғаныс емес пе?
Dialogue: 0,0:17:56.78,0:17:59.95,Default,,0,0,0,,Демек, ол қорғаушы емес.
Dialogue: 0,0:18:01.03,0:18:02.03,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:18:01.11,0:18:01.78,Default-ja,,0,0,0,,Ах...
Dialogue: 0,0:18:04.50,0:18:06.87,Default,,0,0,0,,Сіз саяхатшысыз ба?
Dialogue: 0,0:18:04.51,0:18:07.25,Default-ja,,0,0,0,,Сіз... саяхатшысыз ба?
Dialogue: 0,0:18:08.08,0:18:09.21,Default,,0,0,0,,Қайдан келдің?
Dialogue: 0,0:18:08.32,0:18:09.32,Default-ja,,0,0,0,,Қайдан келдің?
Dialogue: 0,0:18:12.42,0:18:13.34,Default,,0,0,0,,Төменде...
Dialogue: 0,0:18:12.45,0:18:13.45,Default-ja,,0,0,0,,Төменде…
Dialogue: 0,0:18:15.42,0:18:16.38,Default,,0,0,0,,6000...
Dialogue: 0,0:18:15.42,0:18:18.23,Default-ja,,0,0,0,,6000… Деңгей
Dialogue: 0,0:18:17.30,0:18:18.18,Default,,0,0,0,,деңгейлері.
Dialogue: 0,0:18:21.43,0:18:22.47,Default,,0,0,0,,6000?
Dialogue: 0,0:18:21.43,0:18:22.66,Default-ja,,0,0,0,,6000...
Dialogue: 0,0:18:23.40,0:18:24.63,Default-ja,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:18:23.43,0:18:24.39,Default,,0,0,0,,Амал жоқ.
Dialogue: 0,0:18:25.27,0:18:26.64,Default,,0,0,0,,Ішінде көбірек сөйлесеміз.
Dialogue: 0,0:18:25.30,0:18:26.77,Default-ja,,0,0,0,,Іштей тыңдайық.
Dialogue: 0,0:18:27.50,0:18:28.37,Default-ja,,0,0,0,,Кеттік
Dialogue: 0,0:18:27.52,0:18:28.39,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:18:28.50,0:18:30.74,Default-ja,,0,0,0,,Уф... ақсақал!
Dialogue: 0,0:18:29.94,0:18:30.94,Default,,0,0,0,,Поп!
Dialogue: 0,0:18:33.54,0:18:34.41,Default-ja,,0,0,0,,Фу…
Dialogue: 0,0:18:53.38,0:18:55.05,Default,,0,0,0,,Бұл біздің ауыл.
Dialogue: 0,0:18:53.39,0:18:55.30,Default-ja,,0,0,0,,Бұл біздің ауыл.
Dialogue: 0,0:18:56.23,0:18:58.83,Default-ja,,0,0,0,,Ең шыңында 400-ге жуық адам тұрған.
Dialogue: 0,0:18:56.38,0:18:58.84,Default,,0,0,0,,Мұнда ең көп дегенде 400-ге жуық адам тұратын.
Dialogue: 0,0:19:00.18,0:19:02.68,Default,,0,0,0,,Бірақ қазір олардың саны 150-ге жуық.
Dialogue: 0,0:19:00.23,0:19:02.80,Default-ja,,0,0,0,,Қазір бар болғаны 150 адам бар.
Dialogue: 0,0:19:03.22,0:19:05.01,Default,,0,0,0,,Егер сіз саяхатшы болсаңыз, біз сізді қарсы аламыз.
Dialogue: 0,0:19:03.24,0:19:05.24,Default-ja,,0,0,0,,Саяхатшылар қабылданады.
Dialogue: 0,0:19:05.91,0:19:08.51,Default-ja,,0,0,0,,Бұл... дәстүр.
Dialogue: 0,0:19:06.01,0:19:08.23,Default,,0,0,0,,Бұл біздің әдетіміз.
Dialogue: 0,0:19:10.23,0:19:13.69,Default,,0,0,0,,Сіз біздің ұрпақ үшін бірінші болсаңыз да.
Dialogue: 0,0:19:10.24,0:19:13.81,Default-ja,,0,0,0,,Дегенмен, сіз біздің буынның біріншісісіз.
Dialogue: 0,0:19:14.19,0:19:17.23,Default,,0,0,0,,Ауылымызға сырттан келген бірінші адам.
Dialogue: 0,0:19:14.35,0:19:17.38,Default-ja,,0,0,0,,Ауылға сырттан келгендерді қарсы алу...
Dialogue: 0,0:19:20.82,0:19:24.32,Default-ja,,0,0,0,,Біздің электрмен балық аулаушылардың ата-бабаларымыз отырғызушылар деп аталды.
Dialogue: 0,0:19:20.90,0:19:24.74,Default,,0,0,0,,Біз Электро-балықшылар отырғызушылар деп аталатын адамдардан шыққанбыз
Dialogue: 0,0:19:24.69,0:19:28.63,Default-ja,,0,0,0,,Баяғыда сен сияқты қаланы кезіп жүрген сияқты.
Dialogue: 0,0:19:24.83,0:19:28.54,Default,,0,0,0,,сен сияқты қаланы кезген көрінеді.
Dialogue: 0,0:19:30.66,0:19:33.70,Default-ja,,0,0,0,,Олар бұл жерді шамамен 300 жыл бұрын тапқанын айтады...
Dialogue: 0,0:19:30.75,0:19:33.42,Default,,0,0,0,,Олар бұл жерді шамамен 300 жыл бұрын тапқан дейді.
Dialogue: 0,0:19:35.09,0:19:38.88,Default,,0,0,0,,Содан бері біз периметрдің ішінде өмір сүріп жатырмыз.
Dialogue: 0,0:19:35.20,0:19:39.27,Default-ja,,0,0,0,,Содан бері мен осы бөгеттің ішінде өмір сүріп келемін.
Dialogue: 0,0:19:42.26,0:19:45.60,Default,,0,0,0,,Сонымен, бізде бейтаныс адамдар сирек кездеседі.
Dialogue: 0,0:19:42.34,0:19:43.31,Default-ja,,0,0,0,,Сонымен...
Dialogue: 0,0:19:43.51,0:19:45.81,Default-ja,,0,0,0,,Мен басқа адамдарды сирек кездестіремін.
Dialogue: 0,0:19:48.27,0:19:49.73,Default,,0,0,0,,Қалада,
Dialogue: 0,0:19:48.32,0:19:50.52,Default-ja,,0,0,0,,Кейбір қалалар біз сияқты.
Dialogue: 0,0:19:49.81,0:19:53.81,Default,,0,0,0,,аман қалу үшін басқа адамдар болуы керек.
Dialogue: 0,0:19:50.58,0:19:53.89,Default-ja,,0,0,0,,Әрең дегенде аман қалған басқа адамдар болуы керек.
Dialogue: 0,0:19:54.62,0:19:57.86,Default-ja,,0,0,0,,Бірақ қанша адам бар?
Dialogue: 0,0:19:54.65,0:19:58.07,Default,,0,0,0,,Бірақ олардың қанша екенін білмейміз
Dialogue: 0,0:19:58.63,0:20:00.66,Default-ja,,0,0,0,,Сізді қай жерде кездестіруге болады?
Dialogue: 0,0:19:58.65,0:20:00.40,Default,,0,0,0,,немесе оларды қайдан табуға болады.
Dialogue: 0,0:20:01.32,0:20:02.78,Default,,0,0,0,,Біз ештеңе білмейміз.
Dialogue: 0,0:20:01.40,0:20:03.20,Default-ja,,0,0,0,,Біз ештеңе білмейміз
Dialogue: 0,0:20:05.73,0:20:09.64,Default-ja,,0,0,0,,Сондықтан саяхатшылардың әңгімелерін тыңдау өте құнды.
Dialogue: 0,0:20:05.78,0:20:09.75,Default,,0,0,0,,Сонымен, саяхатшыдан естіген кез келген әңгіме құнды болар еді.
Dialogue: 0,0:20:11.41,0:20:12.81,Default-ja,,0,0,0,,Қарт адам бар ма?
Dialogue: 0,0:20:11.41,0:20:14.00,Default,,0,0,0,,Поптар, сіз адамды кездестірдіңіз бе?
Dialogue: 0,0:20:12.87,0:20:14.27,Default-ja,,0,0,0,,Адаммен кездесу...
Dialogue: 0,0:20:14.58,0:20:15.44,Default-ja,,0,0,0,,Жоқ
Dialogue: 0,0:20:14.63,0:20:18.34,Default,,0,0,0,,Жоқ. Мен тек қалдықтарды таптым
Dialogue: 0,0:20:15.84,0:20:20.41,Default-ja,,0,0,0,,Мен тек адам тұратын жердің іздерін ғана таптым.
Dialogue: 0,0:20:18.42,0:20:20.09,Default,,0,0,0,,адам өмір сүрген жерлер.
Dialogue: 0,0:20:21.92,0:20:24.55,Default-ja,,0,0,0,,Иә...? Қарт адам!
Dialogue: 0,0:20:23.80,0:20:24.68,Default,,0,0,0,,Поп.
Dialogue: 0,0:20:26.92,0:20:28.76,Default-ja,,0,0,0,,Қарттар қайтып келді!
Dialogue: 0,0:20:27.01,0:20:28.93,Default,,0,0,0,,Поп және басқалары қайтып келді!
Dialogue: 0,0:20:28.82,0:20:31.59,Default-ja,,0,0,0,,Ей, балалар да сендермен!
Dialogue: 0,0:20:29.01,0:20:31.39,Default,,0,0,0,,Сәлем! Балалар онымен бірге!
Dialogue: 0,0:20:32.63,0:20:36.33,Default-ja,,0,0,0,,Ха... Эй! Балалар қайтып келді!
Dialogue: 0,0:20:33.31,0:20:36.40,Default,,0,0,0,,Сәлем! Балалар қайтып келді!
Dialogue: 0,0:20:38.23,0:20:41.24,Default-ja,,0,0,0,,Nu...? Бұл не...
Dialogue: 0,0:20:39.65,0:20:40.82,Default,,0,0,0,,түн
Dialogue: 0,0:20:42.30,0:20:47.54,Default-ja,,0,0,0,,(Ауыл тұрғындарының сөйлейтін дыбыстары)
Dialogue: 0,0:20:47.74,0:20:50.81,Default-ja,,0,0,0,,Қарт пен Сутезо балалармен оралды!
Dialogue: 0,0:20:47.78,0:20:50.99,Default,,0,0,0,,Попс пен Сутезо балаларды қайтарды!
Dialogue: 0,0:20:51.08,0:20:53.75,Default,,0,0,0,,Қанша бала? Олардың барлығы?
Dialogue: 0,0:20:51.28,0:20:53.65,Default-ja,,0,0,0,,Олардың неше баласы болды? Олардың барлығы?
Dialogue: 0,0:20:53.71,0:20:55.58,Default-ja,,0,0,0,,Жоқ, осы уақытқа дейін...
Dialogue: 0,0:20:53.83,0:20:55.46,Default,,0,0,0,,Мен нақты сенімді емеспін.
Dialogue: 0,0:20:55.95,0:20:58.62,Default-ja,,0,0,0,,Сондай-ақ... тағы бір оғаш адам бар.
Dialogue: 0,0:20:56.08,0:20:58.59,Default,,0,0,0,,Олардың арасында біртүрлі адам бар.
Dialogue: 0,0:20:58.67,0:21:00.71,Default,,0,0,0,,Сіз нені айтасыз, біртүрлі?
Dialogue: 0,0:20:58.69,0:21:00.82,Default-ja,,0,0,0,,Не қызық?
Dialogue: 0,0:21:00.89,0:21:02.96,Default-ja,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:21:01.00,0:21:02.76,Default,,0,0,0,,Ал...
Dialogue: 0,0:21:03.82,0:21:05.49,Default-ja,,0,0,0,,Қош келдіңіз, қария.
Dialogue: 0,0:21:03.92,0:21:05.80,Default,,0,0,0,,Қош келдіңіз, Поптар.
Dialogue: 0,0:21:05.56,0:21:06.43,Default-ja,,0,0,0,,Қария
Dialogue: 0,0:21:05.88,0:21:07.05,Default,,0,0,0,,Поп.
Dialogue: 0,0:21:08.43,0:21:09.43,Default,,0,0,0,,Жәй балалар?
Dialogue: 0,0:21:08.43,0:21:09.60,Default-ja,,0,0,0,,Тек сендер ме?
Dialogue: 0,0:21:09.93,0:21:11.27,Default-ja,,0,0,0,,Қалған үшеуі ше?
Dialogue: 0,0:21:10.06,0:21:11.31,Default,,0,0,0,,Қалған үшеуі қайда?
Dialogue: 0,0:21:13.70,0:21:16.87,Default-ja,,0,0,0,,Үш адамның техникасына келсек... соны да тастап кетті ме?
Dialogue: 0,0:21:13.73,0:21:16.73,Default,,0,0,0,,Ал олардың механизмдері? Оны да тастап кеттің бе?
Dialogue: 0,0:21:16.94,0:21:18.54,Default-ja,,0,0,0,,Хелметталға не болды?
Dialogue: 0,0:21:17.15,0:21:20.94,Default,,0,0,0,,Дулығалар ше? Тым болмаса дулығаларды қайтара алмадың ба?
Dialogue: 0,0:21:18.61,0:21:21.31,Default-ja,,0,0,0,,Жаңа ғана дулығаңызды әкелген жоқсыз ба?
Dialogue: 0,0:21:23.04,0:21:23.91,Default-ja,,0,0,0,,Хмм...
Dialogue: 0,0:21:25.55,0:21:26.61,Default-ja,,0,0,0,,Ах...
Dialogue: 0,0:21:28.75,0:21:30.42,Default-ja,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:21:28.82,0:21:30.16,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:21:30.82,0:21:34.59,Default-ja,,0,0,0,,Бізде енді оны жасайтын технология жоқ.
Dialogue: 0,0:21:30.87,0:21:34.20,Default,,0,0,0,,Білесіз бе, бізде енді мұндай заттарды жасауға техника жоқ.
Dialogue: 0,0:21:34.86,0:21:36.56,Default-ja,,0,0,0,,Сонымен, тамақ туралы не деуге болады?
Dialogue: 0,0:21:35.04,0:21:36.67,Default,,0,0,0,,Тамақ туралы не деуге болады?
Dialogue: 0,0:21:38.66,0:21:40.56,Default-ja,,0,0,0,,Бәрі солып қалды...
Dialogue: 0,0:21:38.71,0:21:40.25,Default,,0,0,0,,Бәрі кеуіп қалды.
Dialogue: 0,0:21:41.92,0:21:44.38,Default,,0,0,0,,Үшеуі тірі оралса болды.
Dialogue: 0,0:21:41.93,0:21:44.67,Default-ja,,0,0,0,,Үшеуміздің үйге аман-есен жетуіміздің өзі жетістік.
Dialogue: 0,0:21:45.26,0:21:49.18,Default,,0,0,0,,Ой, тағы бір айдан кейін бәріміз аштан өлеміз.
Dialogue: 0,0:21:45.33,0:21:49.37,Default-ja,,0,0,0,,Бәрібір бір айдан кейін бәріміз аштан өлеміз.
Dialogue: 0,0:21:49.87,0:21:50.74,Default-ja,,0,0,0,,Сәлем...
Dialogue: 0,0:21:49.93,0:21:52.10,Default,,0,0,0,,Сәлем, поптар.
Dialogue: 0,0:21:51.34,0:21:53.67,Default-ja,,0,0,0,,Қария, бұл кім?
Dialogue: 0,0:21:52.43,0:21:53.47,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:21:55.35,0:21:56.31,Default,,0,0,0,,Ол саяхатшы.
Dialogue: 0,0:21:55.38,0:21:56.58,Default-ja,,0,0,0,,Саяхатшы
Dialogue: 0,0:21:56.81,0:21:58.01,Default-ja,,0,0,0,,Саяхатшы?
Dialogue: 0,0:21:56.94,0:21:58.15,Default,,0,0,0,,Ол саяхатшы ма?
Dialogue: 0,0:21:58.08,0:22:00.98,Default-ja,,0,0,0,,Бізден басқа адамдар шынымен де болды.
Dialogue: 0,0:21:58.23,0:22:01.15,Default,,0,0,0,,Сонымен, шынымен де басқа адамдар бар.
Dialogue: 0,0:22:01.05,0:22:02.52,Default-ja,,0,0,0,,Оған сенуге бола ма?
Dialogue: 0,0:22:01.23,0:22:02.52,Default,,0,0,0,,Біз оған сене аламыз ба?
Dialogue: 0,0:22:02.58,0:22:04.32,Default-ja,,0,0,0,,Саяхатшыларды қарсы алу керек.
Dialogue: 0,0:22:02.61,0:22:04.32,Default,,0,0,0,,Ол саяхатшы болса, қарсы аламыз.
Dialogue: 0,0:22:04.38,0:22:06.65,Default-ja,,0,0,0,,Шаршасам да, мені тамақтандыратын ештеңе жоқ...
Dialogue: 0,0:22:04.40,0:22:06.65,Default,,0,0,0,,Бірақ оны тамақтандыратын ештеңеміз жоқ.
Dialogue: 0,0:22:06.72,0:22:08.59,Default-ja,,0,0,0,,Бұл қорғаныс емес, солай ма?
Dialogue: 0,0:22:06.74,0:22:08.57,Default,,0,0,0,,Ол қорғаушы емес, солай ма?
Dialogue: 0,0:22:08.66,0:22:11.09,Default-ja,,0,0,0,,Сақтандырушылар сізді бұл жерге кіргізбейді.
Dialogue: 0,0:22:08.66,0:22:11.28,Default,,0,0,0,,Қауіпсіздік қызметкері бұл жерге кіре алмайды.
Dialogue: 0,0:22:11.66,0:22:13.43,Default-ja,,0,0,0,,Уау~ (Анашым) Барма!
Dialogue: 0,0:22:12.28,0:22:13.29,Default,,0,0,0,,Артында бол, жаным.
Dialogue: 0,0:22:14.56,0:22:17.83,Default-ja,,0,0,0,,(Балалардың айқайы)
Dialogue: 0,0:22:21.67,0:22:22.90,Default-ja,,0,0,0,,А, жоқ!
Dialogue: 0,0:22:22.09,0:22:22.92,Default,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:22:30.41,0:22:31.38,Default-ja,,0,0,0,,Мықтырақ!
Dialogue: 0,0:22:33.41,0:22:34.51,Default-ja,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:22:34.85,0:22:36.02,Default-ja,,0,0,0,,Эй... (Қыз) Әй!
Dialogue: 0,0:22:42.36,0:22:43.46,Default-ja,,0,0,0,,Уау!
Dialogue: 0,0:22:44.99,0:22:47.06,Default-ja,,0,0,0,,Хмм...? бір нәрсе сызылған
Dialogue: 0,0:22:45.53,0:22:47.11,Default,,0,0,0,,Онда бір нәрсе сызылған.
Dialogue: 0,0:22:49.28,0:22:50.32,Default,,0,0,0,,Бір шелек су?
Dialogue: 0,0:22:49.36,0:22:50.60,Default-ja,,0,0,0,,Су шелек?
Dialogue: 0,0:22:52.80,0:22:53.67,Default-ja,,0,0,0,,Иә!
Dialogue: 0,0:23:00.54,0:23:03.54,Default-ja,,0,0,0,,(қайнаған судың дыбысы)
Dialogue: 0,0:23:04.01,0:23:06.48,Default-ja,,0,0,0,,Уау! (Ауылдастар) О...!
Dialogue: 0,0:23:06.88,0:23:08.65,Default-ja,,0,0,0,,Әй... (Сүтему) А...?
Dialogue: 0,0:23:08.92,0:23:11.92,Default-ja,,0,0,0,,(Ауыл тұрғындары айқайлайды)
Dialogue: 0,0:23:17.39,0:23:19.66,Default-ja,,0,0,0,,А... бұл таңқаларлық.
Dialogue: 0,0:23:18.10,0:23:19.39,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:23:19.93,0:23:21.76,Default-ja,,0,0,0,,Ей, бұл тамақтануға жақсы.
Dialogue: 0,0:23:19.94,0:23:21.73,Default,,0,0,0,,Ол шынымен қоректік болуы керек.
Dialogue: 0,0:23:21.81,0:23:22.85,Default,,0,0,0,,Маған біраз беріңізші.
Dialogue: 0,0:23:21.83,0:23:24.66,Default-ja,,0,0,0,,Маған да бер Маған да бер!
Dialogue: 0,0:23:22.94,0:23:24.19,Default,,0,0,0,,Ей, маған біраз беріңізші.
Dialogue: 0,0:23:25.10,0:23:27.97,Default-ja,,0,0,0,,Өте жақсы! Мен өзімді таусылғандай сезінемін
Dialogue: 0,0:23:25.27,0:23:27.73,Default,,0,0,0,,- Бұл тамаша! - Бұл сізге қуат береді.
Dialogue: 0,0:23:29.69,0:23:31.45,Default,,0,0,0,,Попс, Сутезо.
Dialogue: 0,0:23:29.74,0:23:31.57,Default-ja,,0,0,0,,Қарт... Сутезо
Dialogue: 0,0:23:34.84,0:23:36.54,Default-ja,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:23:39.95,0:23:41.01,Default-ja,,0,0,0,,Қарт...
Dialogue: 0,0:23:40.04,0:23:40.91,Default,,0,0,0,,Поп.
Dialogue: 0,0:23:47.88,0:23:48.76,Default,,0,0,0,,Тэ.
Dialogue: 0,0:23:47.89,0:23:50.02,Default-ja,,0,0,0,,Тэ... бұл
Dialogue: 0,0:23:49.30,0:23:50.13,Default,,0,0,0,,Жер
Dialogue: 0,0:23:50.62,0:23:52.59,Default-ja,,0,0,0,,Аа, сонша...
Dialogue: 0,0:23:51.30,0:23:52.51,Default,,0,0,0,,Бұл көп пе?
Dialogue: 0,0:23:52.59,0:23:54.14,Default,,0,0,0,,Әпкеңе арнап біраз нәрсе бар.
Dialogue: 0,0:23:52.66,0:23:54.46,Default-ja,,0,0,0,,Менің әпкемнің сыбағасы да кіреді.
Dialogue: 0,0:23:56.16,0:23:57.43,Default-ja,,0,0,0,,Рахмет
Dialogue: 0,0:23:56.22,0:23:57.14,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:23:58.85,0:24:00.68,Default,,0,0,0,,Зуру, Фусата.
Dialogue: 0,0:23:58.87,0:24:00.60,Default-ja,,0,0,0,,Зуру Фусата
Dialogue: 0,0:24:01.52,0:24:03.35,Default,,0,0,0,,Қайтып келгеніңізге қуаныштымын.
Dialogue: 0,0:24:01.57,0:24:03.04,Default-ja,,0,0,0,,Мен қайтып келдім.
Dialogue: 0,0:24:03.44,0:24:05.77,Default,,0,0,0,,Бірақ енді ондай ештеңе жасама, жарай ма?
Dialogue: 0,0:24:03.47,0:24:05.67,Default-ja,,0,0,0,,Бірақ соншалықты абай болма, жарай ма?
Dialogue: 0,0:24:06.40,0:24:07.40,Default,,0,0,0,,Мұнда.
Dialogue: 0,0:24:06.51,0:24:07.61,Default-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:24:08.40,0:24:09.94,Default,,0,0,0,,Сіз білетініңізге сенімдімін,
Dialogue: 0,0:24:08.51,0:24:12.05,Default-ja,,0,0,0,,Өздеріңіз білетіндей, мен жаңа аң аулайтын жер табуға бара жатырмын.
Dialogue: 0,0:24:10.03,0:24:12.28,Default,,0,0,0,,бірақ адамдар бұрын жаңа аң аулайтын жер іздеген
Dialogue: 0,0:24:12.11,0:24:14.65,Default-ja,,0,0,0,,Көптеген адамдар қазірдің өзінде қорғаныс құралдарынан жеңілді.
Dialogue: 0,0:24:12.36,0:24:14.32,Default,,0,0,0,,және олардың барлығын қорғаушылар өлтірді.
Dialogue: 0,0:24:15.45,0:24:17.91,Default,,0,0,0,,Шығысқа кеткен топ толығымен шығарылды.
Dialogue: 0,0:24:15.48,0:24:17.78,Default-ja,,0,0,0,,Шығысқа кеткендер жойылады.
Dialogue: 0,0:24:18.49,0:24:20.12,Default,,0,0,0,,Сондықтан бұл балалар
Dialogue: 0,0:24:18.55,0:24:20.45,Default-ja,,0,0,0,,Сондықтан бұл балалар
Dialogue: 0,0:24:20.70,0:24:22.96,Default,,0,0,0,,ауыл үшін бірдеңе істеу керек деп ойлады.
Dialogue: 0,0:24:20.75,0:24:23.02,Default-ja,,0,0,0,,Менің ойымша, сіз ауыл үшін бірдеңе істеу керек сияқты сезіндіңіз.
Dialogue: 0,0:24:23.16,0:24:24.02,Default-ja,,0,0,0,,Зуру
Dialogue: 0,0:24:23.37,0:24:24.21,Default,,0,0,0,,Зуру.
Dialogue: 0,0:24:25.67,0:24:28.50,Default,,0,0,0,,Сіз жабдықты орнына қойған кезде, менің бөлмеме келіңіз.
Dialogue: 0,0:24:25.69,0:24:28.80,Default-ja,,0,0,0,,Жабдықтарыңды қойған соң, менің бөлмеме келуге болады.
Dialogue: 0,0:24:28.86,0:24:29.83,Default-ja,,0,0,0,,Иә...
Dialogue: 0,0:24:28.92,0:24:29.80,Default,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:24:30.00,0:24:32.53,Default-ja,,0,0,0,,Сутезо Кеттік (Сутезо) Эй
Dialogue: 0,0:24:30.13,0:24:32.59,Default,,0,0,0,,-Сутезо, кеттік. -Дұрыс.
Dialogue: 0,0:24:33.13,0:24:36.00,Default-ja,,0,0,0,,Сіз де келіңіз, мен сіздің әңгімеңізді естігім келеді.
Dialogue: 0,0:24:33.26,0:24:35.80,Default,,0,0,0,,Сіз де келіңізші. Мен сенімен сөйлескім келеді.
Dialogue: 0,0:24:44.91,0:24:47.91,Default-ja,,0,0,0,,Сіз... Кириха сияқты бірдеңе айттыңыз.
Dialogue: 0,0:24:44.98,0:24:47.65,Default,,0,0,0,,Сіздің атыңыз Килли болды, солай ма?
Dialogue: 0,0:24:48.88,0:24:50.95,Default-ja,,0,0,0,,Тағамды менімен бөліскеніңіз үшін рахмет.
Dialogue: 0,0:24:48.90,0:24:50.69,Default,,0,0,0,,Тағамыңызды бізбен бөліскеніңізге рахмет.
Dialogue: 0,0:24:51.85,0:24:54.52,Default-ja,,0,0,0,,Негізі мен сені көңіл көтеруім керек.
Dialogue: 0,0:24:51.90,0:24:54.15,Default,,0,0,0,,Әдетте біз сізді тамақтандыратын едік...
Dialogue: 0,0:24:55.12,0:24:56.26,Default-ja,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:24:55.28,0:24:59.20,Default,,0,0,0,,бірақ көріп тұрғаныңыздай, тамақ таусылып қалды.
Dialogue: 0,0:24:56.52,0:24:59.53,Default-ja,,0,0,0,,Бұл ауылда азық-түлік таусылады.
Dialogue: 0,0:24:59.93,0:25:01.23,Default-ja,,0,0,0,,Эй, сен...
Dialogue: 0,0:24:59.99,0:25:01.45,Default,,0,0,0,,Та-да!
Dialogue: 0,0:25:02.00,0:25:03.80,Default-ja,,0,0,0,,Оны қайдан алдың?
Dialogue: 0,0:25:02.04,0:25:03.54,Default,,0,0,0,,Бұл затты қайдан алдың?
Dialogue: 0,0:25:05.23,0:25:06.90,Default-ja,,0,0,0,,200 қабат…
Dialogue: 0,0:25:05.33,0:25:06.79,Default,,0,0,0,,Екі жүз деңгей
Dialogue: 0,0:25:07.23,0:25:08.17,Default-ja,,0,0,0,,Төменгі…
Dialogue: 0,0:25:07.38,0:25:09.50,Default,,0,0,0,,-төменде. -Екі жүз?
Dialogue: 0,0:25:08.57,0:25:09.67,Default-ja,,0,0,0,,200...!
Dialogue: 0,0:25:11.20,0:25:12.74,Default-ja,,0,0,0,,Оны алуға бармаңыз.
Dialogue: 0,0:25:11.30,0:25:12.59,Default,,0,0,0,,Сонымен, біз көбірек ала алмаймыз.
Dialogue: 0,0:25:13.94,0:25:16.18,Default-ja,,0,0,0,,Бұл жер бөгетпен қорғалған, бірақ
Dialogue: 0,0:25:13.97,0:25:16.30,Default,,0,0,0,,Бұл жер периметрмен қорғалған,
Dialogue: 0,0:25:16.24,0:25:18.88,Default-ja,,0,0,0,,Ішінде тамақ алатын жер жоқ.
Dialogue: 0,0:25:16.38,0:25:18.64,Default,,0,0,0,,бірақ іште тамақ алатын жер жоқ.
Dialogue: 0,0:25:20.31,0:25:22.85,Default,,0,0,0,,Сонымен, біз Электр-балықшылар сыртқа шығамыз
Dialogue: 0,0:25:20.51,0:25:23.08,Default-ja,,0,0,0,,Сондықтан біз электр балықшылары аңға шықтық.
Dialogue: 0,0:25:23.43,0:25:24.98,Default,,0,0,0,,және қайтару үшін шламды алыңыз.
Dialogue: 0,0:25:23.52,0:25:25.15,Default-ja,,0,0,0,,Мен саңырауқұлақ әкелейін.
Dialogue: 0,0:25:27.92,0:25:30.69,Default-ja,,0,0,0,,Мен сол электр балықшылардың жетекшісімін.
Dialogue: 0,0:25:27.94,0:25:30.40,Default,,0,0,0,,Мен Электро-балықшылардың жетекшісімін.
Dialogue: 0,0:25:31.65,0:25:35.28,Default,,0,0,0,,Бірақ мұндағы аң аулайтын жерлер құрғап қалды
Dialogue: 0,0:25:31.73,0:25:35.56,Default-ja,,0,0,0,,Бірақ мұндағы аңшылық алқаптар құрғап қалды.
Dialogue: 0,0:25:35.86,0:25:37.41,Default,,0,0,0,,және біз алысырақ шығуымыз керек.
Dialogue: 0,0:25:35.86,0:25:37.66,Default-ja,,0,0,0,,Мен алысқа баруым керек.
Dialogue: 0,0:25:38.49,0:25:40.99,Default,,0,0,0,,Әр жолы достарымыз өлтіріледі,
Dialogue: 0,0:25:38.60,0:25:43.10,Default-ja,,0,0,0,,Әр жолы олардың достары өлтіріліп, электрмен балық аулаушылардың саны азайды.
Dialogue: 0,0:25:41.08,0:25:42.95,Default,,0,0,0,,бізді азырақ балықшылар қалдырады.
Dialogue: 0,0:25:43.97,0:25:45.17,Default-ja,,0,0,0,,Сонымен, тіпті балалар да...
Dialogue: 0,0:25:44.00,0:25:45.37,Default,,0,0,0,,Сонымен, тіпті балалар да...
Dialogue: 0,0:25:47.14,0:25:48.14,Default-ja,,0,0,0,,Кіріңіз.
Dialogue: 0,0:25:47.25,0:25:48.08,Default,,0,0,0,,Мұнда. Кіріңіз.
Dialogue: 0,0:25:54.63,0:25:56.09,Default,,0,0,0,,Бұл тағам керемет.
Dialogue: 0,0:25:54.68,0:25:56.28,Default-ja,,0,0,0,,Бұл тағам керемет
Dialogue: 0,0:25:57.05,0:25:58.92,Default-ja,,0,0,0,,Бұл қайда болды?
Dialogue: 0,0:25:57.13,0:25:59.84,Default,,0,0,0,,-Қызық, ол мұндай нәрсені қайдан алды. -Иә.
Dialogue: 0,0:25:58.99,0:25:59.85,Default-ja,,0,0,0,,Иә...
Dialogue: 0,0:26:00.65,0:26:02.02,Default-ja,,0,0,0,,Және сол қару
Dialogue: 0,0:26:00.68,0:26:04.64,Default,,0,0,0,,Және сол қару. Ол тіпті Экстерминатордың денесін кесіп өтуі мүмкін деп ойлау.
Dialogue: 0,0:26:02.19,0:26:04.93,Default-ja,,0,0,0,,Жоюшының қатты денесін қырып алу үшін...
Dialogue: 0,0:26:08.56,0:26:10.52,Default,,0,0,0,,6000 деңгей төмен.
Dialogue: 0,0:26:08.63,0:26:10.86,Default-ja,,0,0,0,,6000-шы қабаттың түбінен...
Dialogue: 0,0:26:11.03,0:26:11.90,Default-ja,,0,0,0,,Иә?
Dialogue: 0,0:26:11.97,0:26:15.84,Default-ja,,0,0,0,,Сонау алыстан жалғыз келдің бе?
Dialogue: 0,0:26:12.15,0:26:15.53,Default,,0,0,0,,Осылай жалғыз келді ме деп ойлаймын.
Dialogue: 0,0:26:16.49,0:26:17.36,Default,,0,0,0,,Кім біледі.
Dialogue: 0,0:26:16.57,0:26:17.57,Default-ja,,0,0,0,,Келіңіздер...
Dialogue: 0,0:26:18.95,0:26:21.41,Default,,0,0,0,,Тағы қанша адам бар деп ойлаймын.
Dialogue: 0,0:26:19.11,0:26:21.81,Default-ja,,0,0,0,,Тағы қанша адам бар?
Dialogue: 0,0:26:22.31,0:26:25.05,Default-ja,,0,0,0,,Осындай басқа ауылдар бар ма?
Dialogue: 0,0:26:22.37,0:26:24.83,Default,,0,0,0,,Бәлкім, басқа да осындай ауылдар бар шығар.
Dialogue: 0,0:26:26.25,0:26:27.35,Default-ja,,0,0,0,,Мүмкін
Dialogue: 0,0:26:26.33,0:26:27.25,Default,,0,0,0,,Бар болуы мүмкін.
Dialogue: 0,0:26:28.46,0:26:29.67,Default,,0,0,0,,Мен оны елестете де алмаймын.
Dialogue: 0,0:26:28.58,0:26:29.95,Default-ja,,0,0,0,,Мен елестете алмаймын
Dialogue: 0,0:26:31.22,0:26:32.29,Default-ja,,0,0,0,,Бұл қала…
Dialogue: 0,0:26:31.25,0:26:34.42,Default,,0,0,0,,Қалай ойлайсыңдар бұл қала қаншаға созылып жатыр?
Dialogue: 0,0:26:32.89,0:26:34.79,Default-ja,,0,0,0,,Бұл қанша уақытқа созылады деп ойлаймын
Dialogue: 0,0:26:35.51,0:26:38.47,Default,,0,0,0,,Неліктен қорғаныш адамдарды жояды?
Dialogue: 0,0:26:35.59,0:26:38.89,Default-ja,,0,0,0,,Неліктен Safeguard адамдарды өлтіреді?
Dialogue: 0,0:26:40.26,0:26:43.26,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған да емеспін.
Dialogue: 0,0:26:40.29,0:26:43.36,Default-ja,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін ...
Dialogue: 0,0:26:44.60,0:26:47.81,Default,,0,0,0,,Біз шынымен ештеңе білмейміз.
Dialogue: 0,0:26:44.66,0:26:45.67,Default-ja,,0,0,0,,Ана жақтағы бала өте шебер екен, бізге үйретсін бе?
Dialogue: 0,0:26:46.17,0:26:48.07,Default-ja,,0,0,0,,Мен білмейтін нәрселер өте көп.
Dialogue: 0,0:27:03.05,0:27:04.12,Default-ja,,0,0,0,,Сіз...
Dialogue: 0,0:27:03.12,0:27:08.08,Default,,0,0,0,,Сонымен, Зурудың айтуынша, сіз бірден төрт Жоюшыны шығардыңыз.
Dialogue: 0,0:27:04.18,0:27:07.95,Default-ja,,0,0,0,,Зурудың айтуынша, ол бірден төрт жоюшыны жеңген.
Dialogue: 0,0:27:09.62,0:27:12.54,Default,,0,0,0,,Жаныңызда сіз сияқты білікті адамның болғаны шынымен де көмектесер еді.
Dialogue: 0,0:27:09.69,0:27:12.26,Default-ja,,0,0,0,,Мұнда сіз сияқты білікті адам болса, пайдалы болар еді.
Dialogue: 0,0:27:12.63,0:27:16.17,Default,,0,0,0,,Бізге аң аулауға көмектесу үшін осында біраз тұруды ойлайсың ба?
Dialogue: 0,0:27:12.83,0:27:16.03,Default-ja,,0,0,0,,Осы жерде біраз қалып, аң аулауға көмектесе аласыз ба?
Dialogue: 0,0:27:18.03,0:27:19.10,Default-ja,,0,0,0,,Мен...
Dialogue: 0,0:27:18.05,0:27:23.26,Default,,0,0,0,,Мен... бар адамдарды іздеймін...
Dialogue: 0,0:27:19.87,0:27:23.70,Default-ja,,0,0,0,,Интернет терминал гендері бар адамдар
Dialogue: 0,0:27:24.14,0:27:25.71,Default-ja,,0,0,0,,Іздеу
Dialogue: 0,0:27:24.30,0:27:25.60,Default,,0,0,0,,таза терминал гені.
Dialogue: 0,0:27:26.41,0:27:29.11,Default-ja,,0,0,0,,Иә? Таза танма...
Dialogue: 0,0:27:27.60,0:27:28.77,Default,,0,0,0,,Таза термин--?
Dialogue: 0,0:27:29.71,0:27:31.01,Default-ja,,0,0,0,,Бұл не?
Dialogue: 0,0:27:29.73,0:27:30.77,Default,,0,0,0,,түн
Dialogue: 0,0:27:32.21,0:27:34.85,Default-ja,,0,0,0,,Инфекцияға дейін адам...
Dialogue: 0,0:27:32.31,0:27:34.61,Default,,0,0,0,,Бұл барлық адамдарда болды...
Dialogue: 0,0:27:35.25,0:27:38.95,Default-ja,,0,0,0,,Барлығында… бұл… болды.
Dialogue: 0,0:27:35.27,0:27:38.57,Default,,0,0,0,,жұқтырғанға дейін.
Dialogue: 0,0:27:40.12,0:27:41.79,Default-ja,,0,0,0,,Инфекцияға дейін...
Dialogue: 0,0:27:40.32,0:27:41.70,Default,,0,0,0,,Жұқпалы ауруға дейін.
Dialogue: 0,0:27:42.36,0:27:45.66,Default-ja,,0,0,0,,Бұл адамдар қалалардың қожасы болған кездегі оқиға емес пе?
Dialogue: 0,0:27:42.45,0:27:45.28,Default,,0,0,0,,Сіз қала адамдарға тиесілі болған уақытты айтасыз.
Dialogue: 0,0:27:46.70,0:27:47.74,Default,,0,0,0,,Құрылысшылар айтады
Dialogue: 0,0:27:46.76,0:27:48.40,Default-ja,,0,0,0,,Құрылысшылар да, қорғаушылар да
Dialogue: 0,0:27:47.83,0:27:50.83,Default,,0,0,0,,және қорғаныс сол кездегі адамдардың бұйрығын орындады.
Dialogue: 0,0:27:48.66,0:27:51.13,Default-ja,,0,0,0,,Адамдардың бұйрығымен әрекет етеді деп айтылды...
Dialogue: 0,0:27:52.17,0:27:53.87,Default-ja,,0,0,0,,Бұл көне аңыз.
Dialogue: 0,0:27:52.21,0:27:53.96,Default,,0,0,0,,Осындай көне аңыз.
Dialogue: 0,0:27:54.37,0:27:56.14,Default-ja,,0,0,0,,Бұл не...
Dialogue: 0,0:27:54.54,0:27:55.88,Default,,0,0,0,,Тағы бір қосымша сабақ па, иә...
Dialogue: 0,0:27:56.96,0:27:58.76,Default,,0,0,0,,Адамдарға тиесілі қала.
Dialogue: 0,0:27:56.97,0:27:58.97,Default-ja,,0,0,0,,Адам – қаланың қожайыны
Dialogue: 0,0:27:59.77,0:28:02.81,Default-ja,,0,0,0,,Интернет терминалының гені сияқты нәрсе бар.
Dialogue: 0,0:27:59.84,0:28:02.80,Default,,0,0,0,,Егер бізде сол Net Terminal Gene деген нәрсе болса дейсіз бе?
Dialogue: 0,0:28:02.88,0:28:05.43,Default,,0,0,0,,Біз қорғанысты тоқтата аламыз ба?
Dialogue: 0,0:28:02.88,0:28:05.31,Default-ja,,0,0,0,,Бұл қауіпсіздік шараларын тоқтата алатыныңызды білдіре ме?
Dialogue: 0,0:28:05.38,0:28:06.78,Default-ja,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:28:05.51,0:28:06.85,Default,,0,0,0,,Бұл ғана емес,
Dialogue: 0,0:28:06.93,0:28:08.97,Default,,0,0,0,,Құрылысшыларға бұйрық бере аламыз
Dialogue: 0,0:28:07.08,0:28:08.98,Default-ja,,0,0,0,,Құрылысшыға тапсырыс беріңіз
Dialogue: 0,0:28:09.05,0:28:11.89,Default-ja,,0,0,0,,Сіз тіпті ерікті құрылысты тоқтата аласыз.
Dialogue: 0,0:28:09.06,0:28:11.56,Default,,0,0,0,,және оларды өздігінен құрылысты тоқтатуға мәжбүр етіңіз.
Dialogue: 0,0:28:12.35,0:28:14.32,Default-ja,,0,0,0,,Біз бұл қаланың көбеюін тоқтата аламыз.
Dialogue: 0,0:28:12.44,0:28:14.52,Default,,0,0,0,,Біз қаланың кеңеюін тоқтата алар едік.
Dialogue: 0,0:28:14.60,0:28:16.19,Default,,0,0,0,,Мен сені таңдадым, себебі маған асталы дүниеде ауыр қару-жарақ қажет болады.
Dialogue: 0,0:28:14.72,0:28:16.12,Default-ja,,0,0,0,,Уау...
Dialogue: 0,0:28:17.61,0:28:21.07,Default,,0,0,0,,Бірақ бұл жерде мұндай нәрсе болуы мүмкін емес.
Dialogue: 0,0:28:17.76,0:28:21.19,Default-ja,,0,0,0,,Сонымен... бұл жерде мүмкін емес.
Dialogue: 0,0:28:21.82,0:28:22.78,Default,,0,0,0,,Ал...
Dialogue: 0,0:28:21.86,0:28:23.40,Default-ja,,0,0,0,,Жоқ (тоқтатылды) Иә?
Dialogue: 0,0:28:23.95,0:28:25.95,Default,,0,0,0,,Мен бұл туралы бұрын естігенмін.
Dialogue: 0,0:28:24.00,0:28:26.03,Default-ja,,0,0,0,,Негізі мен мұны бұрын естігенмін.
Dialogue: 0,0:28:26.27,0:28:30.04,Default-ja,,0,0,0,,Бұл... «Интернет терминал» сөзі
Dialogue: 0,0:28:26.37,0:28:29.87,Default,,0,0,0,,Бұл Net Terminal нәрсе.
Dialogue: 0,0:28:30.10,0:28:30.97,Default-ja,,0,0,0,,А...
Dialogue: 0,0:28:32.17,0:28:34.41,Default-ja,,0,0,0,,Мен әлдеқашан ұмытып кетіппін, бірақ
Dialogue: 0,0:28:32.25,0:28:34.29,Default,,0,0,0,,Мен бұл туралы әлдеқашан ұмытқан едім...
Dialogue: 0,0:28:35.21,0:28:37.67,Default,,0,0,0,,бірақ оның бұл туралы айтқанын естігенде есіме түсті.
Dialogue: 0,0:28:35.21,0:28:37.44,Default-ja,,0,0,0,,Бұл кісінің әңгімесін естігенде кенет есіме бір нәрсе түсті.
Dialogue: 0,0:28:38.41,0:28:41.88,Default-ja,,0,0,0,,Мен бұл сөзді бұрын естіген сияқтымын.
Dialogue: 0,0:28:38.55,0:28:41.80,Default,,0,0,0,,Мен бұл сөз тіркесін бұрыннан естігенімді білемін.
Dialogue: 0,0:28:42.35,0:28:43.45,Default-ja,,0,0,0,,Нақты қайда?
Dialogue: 0,0:28:42.47,0:28:43.68,Default,,0,0,0,,Бірақ қайда?
Dialogue: 0,0:28:44.72,0:28:47.22,Default,,0,0,0,,Осы ауылдың дәл астында.
Dialogue: 0,0:28:44.75,0:28:47.39,Default-ja,,0,0,0,,Осы ауылдың дәл астында...
Dialogue: 0,0:28:48.29,0:28:50.96,Default-ja,,0,0,0,,Тосқауылдың ішінде, бірақ көп ұрпақ бұрын
Dialogue: 0,0:28:48.35,0:28:49.85,Default,,0,0,0,,Периметр ішіндегі орын,
Dialogue: 0,0:28:49.93,0:28:53.85,Default,,0,0,0,,, бірақ бізге ұрпақтар бойы оған жақындамау керектігі айтылған.
Dialogue: 0,0:28:51.02,0:28:53.79,Default-ja,,0,0,0,,Жақын жүрме деген жер.
Dialogue: 0,0:28:54.77,0:28:58.27,Default,,0,0,0,,Сіз... Шіріген ғибадатхананы білдірмейсіз бе?
Dialogue: 0,0:28:54.79,0:28:56.03,Default-ja,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:28:57.00,0:28:58.47,Default-ja,,0,0,0,,Кусаре храмы?
Dialogue: 0,0:28:58.77,0:28:59.43,Default-ja,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:29:00.10,0:29:03.47,Default-ja,,0,0,0,,Ол жерде Safeguard-қа қарағанда қорқынышты елестер бар.
Dialogue: 0,0:29:00.15,0:29:03.74,Default,,0,0,0,,Әжем маған ешқашан оған жақындамау керектігін айтатын
Dialogue: 0,0:29:03.82,0:29:06.03,Default,,0,0,0,,өйткені ол жерде сақшыдан да қорқынышты елес бар.
Dialogue: 0,0:29:03.87,0:29:05.87,Default-ja,,0,0,0,,Әжем барма деді...
Dialogue: 0,0:29:05.94,0:29:08.44,Default-ja,,0,0,0,,Сыбыс... Сенесіз бе?
Dialogue: 0,0:29:06.11,0:29:08.70,Default,,0,0,0,,Сутезо. Сіз бұған шынымен сенесіз бе?
Dialogue: 0,0:29:08.51,0:29:09.38,Default-ja,,0,0,0,,Жоқ…
Dialogue: 0,0:29:10.31,0:29:11.98,Default-ja,,0,0,0,,Ах...
Dialogue: 0,0:29:13.21,0:29:14.45,Default-ja,,0,0,0,,Сәлем!
Dialogue: 0,0:29:13.29,0:29:14.66,Default,,0,0,0,,Эй, сен!
Dialogue: 0,0:29:15.98,0:29:16.98,Default-ja,,0,0,0,,Ауыл…
Dialogue: 0,0:29:16.00,0:29:16.88,Default,,0,0,0,,Оң жақта...
Dialogue: 0,0:29:18.25,0:29:19.12,Default-ja,,0,0,0,,Тікелей төменде…
Dialogue: 0,0:29:18.42,0:29:19.25,Default,,0,0,0,,ауыл.
Dialogue: 0,0:29:20.88,0:29:22.09,Default,,0,0,0,,Ол сонда баруды жоспарлап отыр.
Dialogue: 0,0:29:20.95,0:29:22.16,Default-ja,,0,0,0,,Сіз баруды жоспарлап отырсыз ба...!
Dialogue: 0,0:29:23.05,0:29:24.47,Default,,0,0,0,,Сутезо, оның артынан жүр.
Dialogue: 0,0:29:23.06,0:29:24.76,Default-ja,,0,0,0,,Сутеко Чейз
Dialogue: 0,0:29:24.97,0:29:27.55,Default,,0,0,0,,-Оған күтуін айт. Мен оған жол көрсетемін. -Дұрыс.
Dialogue: 0,0:29:24.99,0:29:26.39,Default-ja,,0,0,0,,Айтшы күтейін, мен саған айналамын.
Dialogue: 0,0:29:26.46,0:29:27.33,Default-ja,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:29:30.05,0:29:31.14,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,0:29:30.10,0:29:31.26,Default-ja,,0,0,0,,Мен де барамын!
Dialogue: 0,0:29:37.24,0:29:38.10,Default-ja,,0,0,0,,Тездетіңіз
Dialogue: 0,0:29:37.40,0:29:38.23,Default,,0,0,0,,Иә, маған қалдыр.
Dialogue: 0,0:29:39.31,0:29:40.17,Default-ja,,0,0,0,,Иә!
Dialogue: 0,0:29:49.95,0:29:51.33,Default,,0,0,0,,Гран айтты...
Dialogue: 0,0:29:50.02,0:29:51.48,Default-ja,,0,0,0,,деді әже
Dialogue: 0,0:29:52.42,0:29:54.42,Default-ja,,0,0,0,,Құсаре ғибадатханасына жақындағанда
Dialogue: 0,0:29:52.49,0:29:54.75,Default,,0,0,0,,егер сіз Шіріген храмға жақындасаңыз,
Dialogue: 0,0:29:54.82,0:29:57.26,Default-ja,,0,0,0,,Белгісіз біреу байланысты үзді.
Dialogue: 0,0:29:54.83,0:29:57.50,Default,,0,0,0,,бейтаныс адам сіздің байланысыңызды үзеді
Dialogue: 0,0:29:57.49,0:30:00.46,Default-ja,,0,0,0,,Бұл дауыс сіздің денеңізді басқара алады...
Dialogue: 0,0:29:57.58,0:30:00.25,Default,,0,0,0,,және олардың дауысы сізді қуыршақ сияқты басқара алады.
Dialogue: 0,0:30:00.84,0:30:02.63,Default,,0,0,0,,Ертегілерді айтуды доғарыңыз.
Dialogue: 0,0:30:00.89,0:30:02.96,Default-ja,,0,0,0,,Бос сөзді доғар
Dialogue: 0,0:30:05.57,0:30:08.87,Default-ja,,0,0,0,,Менің үлкен атам осылайша құлап өлді...
Dialogue: 0,0:30:05.63,0:30:08.59,Default,,0,0,0,,Менің арғы атам соның кесірінен қайтыс болды...
Dialogue: 0,0:30:09.76,0:30:10.72,Default,,0,0,0,,Гран бойынша.
Dialogue: 0,0:30:09.90,0:30:10.97,Default-ja,,0,0,0,,Әже...
Dialogue: 0,0:30:32.87,0:30:33.74,Default,,0,0,0,,Сол жерде.
Dialogue: 0,0:30:32.96,0:30:33.96,Default-ja,,0,0,0,,Сол жерде.
Dialogue: 0,0:30:36.03,0:30:36.90,Default-ja,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:30:39.07,0:30:41.53,Default-ja,,0,0,0,,
Dialogue: 0,0:30:41.90,0:30:42.57,Default-ja,,0,0,0,,А...?
Dialogue: 0,0:30:43.17,0:30:44.71,Default,,0,0,0,,-Бұл не? -Қараңдар!
Dialogue: 0,0:30:43.20,0:30:44.50,Default-ja,,0,0,0,,Не? Қараңдар!
Dialogue: 0,0:30:48.98,0:30:49.84,Default-ja,,0,0,0,,…Жоғарғы
Dialogue: 0,0:30:50.41,0:30:51.38,Default-ja,,0,0,0,,…Giso
Dialogue: 0,0:30:52.15,0:30:53.01,Default-ja,,0,0,0,,…nmatsu
Dialogue: 0,0:30:53.55,0:30:55.35,Default-ja,,0,0,0,,Уф... Хаааа...!
Dialogue: 0,0:30:55.60,0:30:56.60,Default,,0,0,0,,Таза...
Dialogue: 0,0:30:55.88,0:30:56.55,Default-ja,,0,0,0,,Таза...
Dialogue: 0,0:30:57.43,0:30:58.48,Default,,0,0,0,,терминал...
Dialogue: 0,0:30:57.52,0:30:58.38,Default-ja,,0,0,0,,Кімге...
Dialogue: 0,0:30:58.85,0:30:59.73,Default,,0,0,0,,байланыс.
Dialogue: 0,0:30:58.89,0:30:59.89,Default-ja,,0,0,0,,Қосылу…
Dialogue: 0,0:31:01.12,0:31:02.09,Default-ja,,0,0,0,,Басқару...
Dialogue: 0,0:31:02.62,0:31:05.09,Default-ja,,0,0,0,,Мен... Шибо...
Dialogue: 0,0:31:02.73,0:31:03.61,Default,,0,0,0,,Ой, Хиёри-я! Жаңа жылды әзілмен бастап жатырсың ғой, иә?
Dialogue: 0,0:31:04.32,0:31:05.15,Default,,0,0,0,,Cibo.
Dialogue: 0,0:31:17.57,0:31:18.44,Default-ja,,0,0,0,,Шығыңыз
Dialogue: 0,0:31:17.75,0:31:18.62,Default,,0,0,0,,Шық.
Dialogue: 0,0:31:22.61,0:31:23.48,Default-ja,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:31:25.21,0:31:26.38,Default-ja,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:31:25.25,0:31:26.42,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:31:26.55,0:31:29.88,Default-ja,,0,0,0,,(Шибоның ырылдауы)
Dialogue: 0,0:31:32.02,0:31:33.52,Default-ja,,0,0,0,,О... ой...
Dialogue: 0,0:31:33.89,0:31:38.89,Default-ja,,0,0,0,,(Шибоның ырылдауы)
Dialogue: 0,0:31:47.60,0:31:49.14,Default-ja,,0,0,0,,Иә...
Dialogue: 0,0:31:50.54,0:31:52.01,Default-ja,,0,0,0,,Күтуден шаршадым.
Dialogue: 0,0:31:50.61,0:31:52.07,Default,,0,0,0,,Мен көп күттім.
Dialogue: 0,0:31:52.16,0:31:53.49,Default,,0,0,0,,Әңгімеледі.
Dialogue: 0,0:31:52.34,0:31:53.44,Default-ja,,0,0,0,,Мен сөйледім...
Dialogue: 0,0:31:55.91,0:31:58.87,Default,,0,0,0,,Мен осы уақыт бойы көмекке шақырдым, бірақ ешкім келмеді.
Dialogue: 0,0:31:55.94,0:31:58.65,Default-ja,,0,0,0,,Мен көмекке шақырдым, бірақ ешкім келмеді.
Dialogue: 0,0:31:59.58,0:32:01.08,Default-ja,,0,0,0,,Бұл ұзақ болды.
Dialogue: 0,0:31:59.70,0:32:03.29,Default,,0,0,0,,Сен келгенше ұзақ болды.
Dialogue: 0,0:32:01.55,0:32:06.02,Default-ja,,0,0,0,,Сіз келгенше 17 526 000 сағат...
Dialogue: 0,0:32:03.37,0:32:07.55,Default,,0,0,0,,17 миллион 526 мың сағат күттім.
Dialogue: 0,0:32:06.32,0:32:07.65,Default-ja,,0,0,0,,Мен көптен бері күттім
Dialogue: 0,0:32:09.13,0:32:10.21,Default,,0,0,0,,Сенің атың кім?
Dialogue: 0,0:32:09.16,0:32:10.42,Default-ja,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:32:12.36,0:32:13.26,Default-ja,,0,0,0,,Тұман шошқа…
Dialogue: 0,0:32:12.38,0:32:13.38,Default,,0,0,0,,Килли.
Dialogue: 0,0:32:14.29,0:32:17.30,Default-ja,,0,0,0,,Мен Шибомын, ғалыммын.
Dialogue: 0,0:32:14.30,0:32:15.51,Default,,0,0,0,,Мен Сибомын.
Dialogue: 0,0:32:16.30,0:32:17.22,Default,,0,0,0,,Мен ғалыммын.
Dialogue: 0,0:32:17.97,0:32:19.27,Default,,0,0,0,,Танысқаныма қуаныштымын, Килли.
Dialogue: 0,0:32:18.00,0:32:19.17,Default-ja,,0,0,0,,Танысқаныма қуаныштымын, Кириха
Dialogue: 0,0:32:21.94,0:32:23.19,Default,,0,0,0,,Сонымен, ғалым
Dialogue: 0,0:32:22.07,0:32:23.44,Default-ja,,0,0,0,,Ғалымдар...
Dialogue: 0,0:32:23.98,0:32:25.94,Default,,0,0,0,,шынымен аман қалды.
Dialogue: 0,0:32:24.00,0:32:26.24,Default-ja,,0,0,0,,Ол шынымен аман қалды ма?
Dialogue: 0,0:32:27.69,0:32:31.53,Default,,0,0,0,,Бұл гравитациялық сәуле шығарғыш, солай ма?
Dialogue: 0,0:32:27.71,0:32:28.61,Default-ja,,0,0,0,,Бұл…
Dialogue: 0,0:32:29.11,0:32:31.64,Default-ja,,0,0,0,,Бұл гравитон сәулесін айдайтын құрылғы, солай ма?
Dialogue: 0,0:32:32.95,0:32:34.61,Default,,0,0,0,,Өте әсерлі мылтық.
Dialogue: 0,0:32:33.05,0:32:35.01,Default-ja,,0,0,0,,Сізде керемет мылтық бар.
Dialogue: 0,0:32:35.68,0:32:38.95,Default-ja,,0,0,0,,Біз жаңғырта алмаған жалғыз нәрсе сол технология болды.
Dialogue: 0,0:32:35.74,0:32:38.99,Default,,0,0,0,,Бұл тіпті біз қайта жасай алмаған технология.
Dialogue: 0,0:32:40.41,0:32:41.70,Default,,0,0,0,,Оны қайдан таптың?
Dialogue: 0,0:32:40.45,0:32:41.99,Default-ja,,0,0,0,,Оны қайдан таптың?
Dialogue: 0,0:32:44.49,0:32:47.06,Default-ja,,0,0,0,,Мен қару туралы білмеймін...
Dialogue: 0,0:32:44.58,0:32:46.79,Default,,0,0,0,,Мен мылтық туралы білмеймін.
Dialogue: 0,0:32:51.13,0:32:54.05,Default,,0,0,0,,Ірістеріңізде жұқпалы аурулардың қалдықтары бар.
Dialogue: 0,0:32:51.36,0:32:54.27,Default-ja,,0,0,0,,Иристегі инфекция іздері
Dialogue: 0,0:32:55.26,0:32:59.93,Default,,0,0,0,,Сізде... Net Terminal гені жоқ.
Dialogue: 0,0:32:55.30,0:32:56.50,Default-ja,,0,0,0,,Сіз...
Dialogue: 0,0:32:57.00,0:33:00.21,Default-ja,,0,0,0,,Таза терминалдық гені жоқ
Dialogue: 0,0:33:01.35,0:33:05.19,Default,,0,0,0,,Бұл не деген ақымақтық? Әрине жоқ.
Dialogue: 0,0:33:01.41,0:33:03.44,Default-ja,,0,0,0,,Қандай бос сөз айтып тұрсың?
Dialogue: 0,0:33:04.18,0:33:05.35,Default-ja,,0,0,0,,Айқын емес
Dialogue: 0,0:33:06.68,0:33:07.75,Default-ja,,0,0,0,,Ол соншалықты керемет пианист болса да—
Dialogue: 0,0:33:06.77,0:33:07.77,Default,,0,0,0,,Сен білесің бе?
Dialogue: 0,0:33:08.48,0:33:12.55,Default-ja,,0,0,0,,Интернет терминалының гені бар ешкімді білмейсіз бе?
Dialogue: 0,0:33:08.52,0:33:12.36,Default,,0,0,0,,Net Terminal гені бар адамдар бар ма?
Dialogue: 0,0:33:14.11,0:33:16.28,Default,,0,0,0,,Егер мұндай адамдар болса,
Dialogue: 0,0:33:14.19,0:33:16.02,Default-ja,,0,0,0,,Ондай адам болса
Dialogue: 0,0:33:16.36,0:33:19.20,Default,,0,0,0,,онда бұл қала ғасырлар бұрын қайтадан жұмыс істейтін болар еді.
Dialogue: 0,0:33:16.39,0:33:19.13,Default-ja,,0,0,0,,Қаланың функциялары әлдеқашан қалпына келді, солай емес пе?
Dialogue: 0,0:33:20.36,0:33:22.10,Default-ja,,0,0,0,,Бірақ жақсы нәрсе болады.
Dialogue: 0,0:33:20.37,0:33:21.83,Default,,0,0,0,,Бірақ менде жақсы нәрсе бар.
Dialogue: 0,0:33:22.76,0:33:23.66,Default-ja,,0,0,0,,Тұман шошқа
Dialogue: 0,0:33:22.91,0:33:26.71,Default,,0,0,0,,Килли, мені автоматтандырылған зауытқа апарыңыз.
Dialogue: 0,0:33:24.26,0:33:27.07,Default-ja,,0,0,0,,Мені автоматтандырылған зауытқа апарыңыз.
Dialogue: 0,0:33:28.29,0:33:29.46,Default,,0,0,0,,Автоматтандырылған зауыт?
Dialogue: 0,0:33:28.30,0:33:29.34,Default-ja,,0,0,0,,Автоматты зауыт?
Dialogue: 0,0:33:29.54,0:33:30.84,Default,,0,0,0,,түн
Dialogue: 0,0:33:29.74,0:33:32.14,Default-ja,,0,0,0,,Бұл не? (Сузузо) Жүр...
Dialogue: 0,0:33:31.21,0:33:32.09,Default,,0,0,0,,Кім біледі.
Dialogue: 0,0:33:33.31,0:33:35.11,Default-ja,,0,0,0,,Автоматты зауытқа барсаңыз
Dialogue: 0,0:33:33.38,0:33:35.22,Default,,0,0,0,,Егер сіз мені автоматтандырылған зауытқа апарсаңыз,
Dialogue: 0,0:33:35.21,0:33:39.08,Default-ja,,0,0,0,,Интернет терминалының генімен бірдей әсері бар жалған терминал жасаңыз.
Dialogue: 0,0:33:35.30,0:33:39.05,Default,,0,0,0,,Мен сізге бірдей әсер ететін синтетикалық терминал жасаймын
Dialogue: 0,0:33:39.14,0:33:40.56,Default,,0,0,0,,таза терминал гені ретінде.
Dialogue: 0,0:33:39.15,0:33:40.61,Default-ja,,0,0,0,,Мен оны сізге жасаймын
Dialogue: 0,0:33:43.68,0:33:45.35,Default-ja,,0,0,0,,Сенбейсің, солай ма?
Dialogue: 0,0:33:43.81,0:33:45.14,Default,,0,0,0,,Сіз маған сенбейсіз, солай ма?
Dialogue: 0,0:33:46.31,0:33:47.65,Default,,0,0,0,,Бірақ бұл шындық.
Dialogue: 0,0:33:46.32,0:33:48.05,Default-ja,,0,0,0,,Бірақ бұл рас.
Dialogue: 0,0:33:49.11,0:33:50.73,Default,,0,0,0,,Сол жерде...
Dialogue: 0,0:33:49.16,0:33:51.06,Default-ja,,0,0,0,,Сол жерде тұрған...
Dialogue: 0,0:33:51.52,0:33:54.69,Default-ja,,0,0,0,,Негізі бұл мен жасаған жалған терминалдың қалдықтары.
Dialogue: 0,0:33:51.57,0:33:54.74,Default,,0,0,0,,бұл шын мәнінде мен жасаған синтетикалық терминалдың сынықтары.
Dialogue: 0,0:33:55.70,0:33:58.30,Default-ja,,0,0,0,,Оның астында қосылым терминалы бар.
Dialogue: 0,0:33:55.82,0:33:58.03,Default,,0,0,0,,Оның астында қосылым порты бар.
Dialogue: 0,0:33:59.57,0:34:00.73,Default-ja,,0,0,0,,Мұнда NetSphere
Dialogue: 0,0:33:59.78,0:34:04.08,Default,,0,0,0,,Біз NetSphere қосылым портын осы жерден тапқан кезде,
Dialogue: 0,0:34:00.80,0:34:03.70,Default-ja,,0,0,0,,Біз қосылым терминалын тапқан кезде,
Dialogue: 0,0:34:04.16,0:34:08.12,Default,,0,0,0,,Біз қауіпсіздікті сақтау үшін аумақты электр тосқауылымен қоршадық
Dialogue: 0,0:34:04.20,0:34:08.17,Default-ja,,0,0,0,,Аймақтың айналасына қорғаныс құралдарының енуіне жол бермеу үшін электрлік қорғаныс жабынын жағыңыз.
Dialogue: 0,0:34:08.21,0:34:10.08,Default,,0,0,0,,басып кіруден және эксперименттерді бастады.
Dialogue: 0,0:34:08.24,0:34:09.81,Default-ja,,0,0,0,,Мен мұны сынақ алаңына айналдырдым.
Dialogue: 0,0:34:10.17,0:34:13.42,Default,,0,0,0,,Сақтандыруды басып кіруден сақтау үшін?
Dialogue: 0,0:34:10.24,0:34:13.58,Default-ja,,0,0,0,,Қорғаныс құралдарының енуін болдырмау...?
Dialogue: 0,0:34:14.41,0:34:16.08,Default-ja,,0,0,0,,Эксперимент жақсы өтті.
Dialogue: 0,0:34:14.42,0:34:16.13,Default,,0,0,0,,Тәжірибелер сәтті өтті.
Dialogue: 0,0:34:17.09,0:34:19.47,Default,,0,0,0,,Біз Биліктің кіреберісіне дейін жеттік.
Dialogue: 0,0:34:17.15,0:34:19.65,Default-ja,,0,0,0,,Үкімет кеңсесінің кіреберісіне жеттік.
Dialogue: 0,0:34:20.43,0:34:23.77,Default,,0,0,0,,Бірақ кейін бізді олардың қорғаныс механизмдері тапты...
Dialogue: 0,0:34:20.45,0:34:23.59,Default-ja,,0,0,0,,Бірақ жолда мені қорғаныс механизмі тапты...
Dialogue: 0,0:34:24.49,0:34:25.49,Default-ja,,0,0,0,,Бұл Зама
Dialogue: 0,0:34:24.56,0:34:26.23,Default,,0,0,0,,және сіз не болғанын көре аласыз.
Dialogue: 0,0:34:26.76,0:34:29.40,Default-ja,,0,0,0,,Басқару департаментімен диалог…
Dialogue: 0,0:34:26.81,0:34:29.52,Default,,0,0,0,,Сіз... уәкілетті органмен байланыста болдыңыз ба?
Dialogue: 0,0:34:30.46,0:34:31.50,Default-ja,,0,0,0,,мүмкін емес
Dialogue: 0,0:34:30.52,0:34:31.48,Default,,0,0,0,,Жоқ, біз алмадық.
Dialogue: 0,0:34:32.80,0:34:33.73,Default-ja,,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:34:32.90,0:34:35.15,Default,,0,0,0,,Бірақ біз ақпаратты талдадық
Dialogue: 0,0:34:34.27,0:34:38.67,Default-ja,,0,0,0,,Сол кезде мен кері ағып жатқан ақпараттан ену жолын талдадым.
Dialogue: 0,0:34:35.23,0:34:38.74,Default,,0,0,0,,қарсы ток арқылы келіп, кіру үшін пайдалана алатын арнаны тапты.
Dialogue: 0,0:34:39.32,0:34:42.37,Default,,0,0,0,,Сонымен, тағы бір мүмкіндік берілсе,
Dialogue: 0,0:34:39.34,0:34:40.31,Default-ja,,0,0,0,,Сонымен...
Dialogue: 0,0:34:40.64,0:34:44.28,Default-ja,,0,0,0,,Егер сіз тағы бір рет тырыссаңыз, сіз міндетті түрде табысқа жетесіз.
Dialogue: 0,0:34:42.45,0:34:43.95,Default,,0,0,0,,Мен міндетті түрде жетістікке жете аламын.
Dialogue: 0,0:34:44.68,0:34:48.11,Default-ja,,0,0,0,,Не айтып тұрғаныңызды түсінбеймін...
Dialogue: 0,0:34:44.70,0:34:45.87,Default,,0,0,0,,Менде ештеңе жоқ ...
Dialogue: 0,0:34:46.79,0:34:47.96,Default,,0,0,0,,ол не туралы айтып жатыр.
Dialogue: 0,0:34:48.68,0:34:49.72,Default-ja,,0,0,0,,Сәлем!
Dialogue: 0,0:34:48.79,0:34:49.67,Default,,0,0,0,,Эй, сен!
Dialogue: 0,0:34:50.38,0:34:51.35,Default-ja,,0,0,0,,Не?
Dialogue: 0,0:34:50.63,0:34:51.46,Default,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:34:52.72,0:34:57.62,Default-ja,,0,0,0,,Сіз қорғаныстың кіруіне жол бермеу үшін бірдеңе жасағаныңызды айттыңыз.
Dialogue: 0,0:34:52.75,0:34:53.80,Default,,0,0,0,,Дәл қазір,
Dialogue: 0,0:34:53.88,0:34:57.38,Default,,0,0,0,,Сіз қорғанысты басып алмауы үшін бірдеңе жасадыңыз деп айттыңыз, солай ма?
Dialogue: 0,0:34:58.17,0:35:02.01,Default,,0,0,0,,Бұл сіз осы периметрді орнатқаныңызды білдіре ме?
Dialogue: 0,0:34:58.22,0:35:02.30,Default-ja,,0,0,0,,Бұл сіздің бұл кедергіні қойғаныңызды білдіре ме?
Dialogue: 0,0:35:02.56,0:35:03.56,Default-ja,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:35:02.68,0:35:03.55,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:35:04.40,0:35:06.23,Default-ja,,0,0,0,,Бұл қалай болуы мүмкін...
Dialogue: 0,0:35:04.43,0:35:08.81,Default,,0,0,0,,-Сіз дәл осындай нәрсені қалай жасадыңыз? -Килли, анау үйіндіні жолдан шығар.
Dialogue: 0,0:35:06.30,0:35:09.10,Default-ja,,0,0,0,,Кириха, сол жердегі үйінділерді алып таста.
Dialogue: 0,0:35:18.85,0:35:22.72,Default-ja,,0,0,0,,Бұл мен жасаған электростатикалық жабын генераторы.
Dialogue: 0,0:35:18.99,0:35:22.91,Default,,0,0,0,,Бұл мен жасаған электр кедергі генераторы.
Dialogue: 0,0:35:27.20,0:35:29.29,Default,,0,0,0,,Соның арқасында біз тәжірибелерімізді жүргіздік
Dialogue: 0,0:35:27.29,0:35:29.29,Default-ja,,0,0,0,,Енді сізге қауіпсіздік шаралары кедергісіз болады.
Dialogue: 0,0:35:29.36,0:35:30.82,Default-ja,,0,0,0,,Мен байланыс тәжірибесін жасай алдым.
Dialogue: 0,0:35:29.37,0:35:32.38,Default,,0,0,0,,-Сақтандырудан үзіліссіз. -Қосылу?
Dialogue: 0,0:35:31.12,0:35:32.66,Default-ja,,0,0,0,,Қосылу…
Dialogue: 0,0:35:33.04,0:35:36.25,Default,,0,0,0,,Егер қолыңнан келсе, қалаға бұйрық бере аласың ба?
Dialogue: 0,0:35:33.13,0:35:36.53,Default-ja,,0,0,0,,Егер қолыңнан келсе, қаланы басқара аласың ба?
Dialogue: 0,0:35:36.66,0:35:37.70,Default-ja,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:35:36.75,0:35:37.63,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:35:38.30,0:35:41.63,Default,,0,0,0,,Баяғыда барлық адамдарда таза терминал гені болған
Dialogue: 0,0:35:38.33,0:35:41.57,Default-ja,,0,0,0,,Ежелгі адамдарда интернет терминалының гендері болған.
Dialogue: 0,0:35:41.63,0:35:43.20,Default-ja,,0,0,0,,Әркім мұны істей алды.
Dialogue: 0,0:35:41.72,0:35:43.26,Default,,0,0,0,,және олар мұны істей алды.
Dialogue: 0,0:35:44.50,0:35:45.91,Default-ja,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:35:44.51,0:35:45.89,Default,,0,0,0,,Мен бұған сенбеймін.
Dialogue: 0,0:35:46.57,0:35:48.91,Default-ja,,0,0,0,,Адамдар мұны істей ала ма?
Dialogue: 0,0:35:46.60,0:35:48.77,Default,,0,0,0,,Адамдар мұндай әрекетті қалай жасай алды?
Dialogue: 0,0:35:49.14,0:35:51.06,Default,,0,0,0,,Бірақ бұл рас, олар шынымен де мүмкін.
Dialogue: 0,0:35:49.18,0:35:51.44,Default-ja,,0,0,0,,Бірақ мен мұны істедім... шынымен.
Dialogue: 0,0:35:52.56,0:35:55.82,Default,,0,0,0,,Біз бұл қабілетті жасанды түрде машиналар арқылы қайта жасауға тырыстық.
Dialogue: 0,0:35:52.58,0:35:56.15,Default-ja,,0,0,0,,Біз оны машинаның көмегімен модельдеуге тырыстық.
Dialogue: 0,0:35:56.62,0:35:58.65,Default-ja,,0,0,0,,Қаланың дүрбелеңін тоқтату
Dialogue: 0,0:35:56.65,0:35:58.36,Default,,0,0,0,,Қаланың жабайы жүруін тоқтату.
Dialogue: 0,0:36:00.28,0:36:03.99,Default,,0,0,0,,Егер автоматтандырылған зауытқа барсақ, мен басқа терминал жасай аламын.
Dialogue: 0,0:36:00.32,0:36:01.85,Default-ja,,0,0,0,,Автоматты зауытқа барсаңыз
Dialogue: 0,0:36:02.32,0:36:04.32,Default-ja,,0,0,0,,Сондай-ақ жалған терминал жасауға болады
Dialogue: 0,0:36:05.53,0:36:06.49,Default,,0,0,0,,Кел, Килли.
Dialogue: 0,0:36:05.53,0:36:06.59,Default-ja,,0,0,0,,Эй, Кириха...
Dialogue: 0,0:36:07.29,0:36:09.12,Default,,0,0,0,,Сенің мақсатың менімен бірдей емес пе?
Dialogue: 0,0:36:07.29,0:36:09.33,Default-ja,,0,0,0,,Сіздің мақсатыңыз бір, солай емес пе?
Dialogue: 0,0:36:10.20,0:36:12.92,Default,,0,0,0,,Сіз қаланы адамдардың бақылауына қайтарғыңыз келеді, солай ма?
Dialogue: 0,0:36:10.30,0:36:12.80,Default-ja,,0,0,0,,Қаланы қайтадан адамның қолына алғың келеді, солай ма?
Dialogue: 0,0:36:16.67,0:36:17.54,Default-ja,,0,0,0,,Ах...
Dialogue: 0,0:36:16.71,0:36:17.55,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:36:18.60,0:36:19.61,Default-ja,,0,0,0,,Б-бұл не өзі?
Dialogue: 0,0:36:18.63,0:36:19.51,Default,,0,0,0,,Содан кейін шешім қабылданады.
Dialogue: 0,0:36:20.34,0:36:21.38,Default,,0,0,0,,Бірден барайық!
Dialogue: 0,0:36:20.34,0:36:21.61,Default-ja,,0,0,0,,Бірден барайық
Dialogue: 0,0:36:24.84,0:36:27.38,Default-ja,,0,0,0,,Эй, эй! Күте тұрыңыз
Dialogue: 0,0:36:25.89,0:36:27.14,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:36:28.26,0:36:31.06,Default,,0,0,0,,Мына автоматтандырылған зауыт қай жерде?
Dialogue: 0,0:36:28.31,0:36:31.58,Default-ja,,0,0,0,,Бұл автоматты зауыт қайда орналасқан?
Dialogue: 0,0:36:32.35,0:36:34.40,Default,,0,0,0,,Осы жерден алыс шығыс бөлігінде.
Dialogue: 0,0:36:32.39,0:36:34.62,Default-ja,,0,0,0,,Бұл жерден шығысқа қарай.
Dialogue: 0,0:36:35.15,0:36:36.90,Default,,0,0,0,,Шамамен 15 блок қашықтықта.
Dialogue: 0,0:36:35.22,0:36:37.19,Default-ja,,0,0,0,,Шамамен 15 блок қашықтықта.
Dialogue: 0,0:36:37.69,0:36:38.98,Default,,0,0,0,,Он бес блок.
Dialogue: 0,0:36:37.69,0:36:39.23,Default-ja,,0,0,0,,15 блок?
Dialogue: 0,0:36:39.86,0:36:41.53,Default-ja,,0,0,0,,Оған 2-3 күн қажет.
Dialogue: 0,0:36:39.98,0:36:41.40,Default,,0,0,0,,Бұл екі-үш күнді алады.
Dialogue: 0,0:36:42.28,0:36:44.45,Default,,0,0,0,,Біз де көмектесе аламыз ба?
Dialogue: 0,0:36:42.30,0:36:44.70,Default-ja,,0,0,0,,Сізге ынтымақтастық орнатуға рұқсат бере аласыз ба?
Dialogue: 0,0:36:45.33,0:36:47.63,Default-ja,,0,0,0,,Әй... қария! қалдықтарды салу
Dialogue: 0,0:36:45.36,0:36:47.78,Default,,0,0,0,,- Поп. -Сутезо.
Dialogue: 0,0:36:49.54,0:36:51.70,Default-ja,,0,0,0,,Бұл адамдар не істеуге тырысады
Dialogue: 0,0:36:49.54,0:36:53.92,Default,,0,0,0,,Бұл адамдардың әрекеті біздің ауылды сақтап қалуы мүмкін.
Dialogue: 0,0:36:51.77,0:36:54.27,Default-ja,,0,0,0,,Бұл ауылды құтқаруы мүмкін.
Dialogue: 0,0:36:55.41,0:36:57.54,Default-ja,,0,0,0,,Бұған сене аласыз ба?
Dialogue: 0,0:36:55.50,0:36:57.25,Default,,0,0,0,,Осының бәріне шынымен сендіңіз бе?
Dialogue: 0,0:36:58.63,0:37:01.34,Default,,0,0,0,,Қалай болғанда да, ауылда жағдай нашарлап барады.
Dialogue: 0,0:36:58.71,0:37:00.98,Default-ja,,0,0,0,,Ауыл бәрібір кедей.
Dialogue: 0,0:37:01.41,0:37:04.95,Default-ja,,0,0,0,,Шлагбаумды тастап кетесің бе, әлде ауылда қалып, аштан өлесің бе?
Dialogue: 0,0:37:01.42,0:37:03.51,Default,,0,0,0,,Шешім қабылдағанға дейін көп уақыт өтпейді
Dialogue: 0,0:37:03.59,0:37:08.22,Default,,0,0,0,,периметрді тастап кету немесе ішінде қалып, аштықтан өлу.
Dialogue: 0,0:37:05.22,0:37:08.45,Default-ja,,0,0,0,,Менің шешім қабылдауым керек күн келді.
Dialogue: 0,0:37:08.99,0:37:09.96,Default-ja,,0,0,0,,Егер солай болса...
Dialogue: 0,0:37:09.06,0:37:12.48,Default,,0,0,0,,Сонымен... мүмкіндікті пайдаланып қалудың қажеті жоқ деп ойлайсыз ба?
Dialogue: 0,0:37:10.56,0:37:12.39,Default-ja,,0,0,0,,Бұл құмар ойынға тұрарлық емес пе?
Dialogue: 0,0:37:12.49,0:37:14.26,Default-ja,,0,0,0,,Әрине!
Dialogue: 0,0:37:12.56,0:37:13.98,Default,,0,0,0,,Бұл солай болуы мүмкін...
Dialogue: 0,0:37:14.96,0:37:16.96,Default-ja,,0,0,0,,15 блок шығысқа қарай...
Dialogue: 0,0:37:15.10,0:37:16.90,Default,,0,0,0,,бірақ шығысқа қарай 15 блокқа барсақ...
Dialogue: 0,0:37:17.80,0:37:20.33,Default-ja,,0,0,0,,Тіпті жабдықтың аккумуляторы да жеткіліксіз болуы мүмкін.
Dialogue: 0,0:37:17.86,0:37:21.11,Default,,0,0,0,,біздің құрылғыдағы батареялар тіпті ұзаққа шыдамауы мүмкін...
Dialogue: 0,0:37:20.40,0:37:21.30,Default-ja,,0,0,0,,Бірінші…
Dialogue: 0,0:37:21.83,0:37:24.44,Default-ja,,0,0,0,,Қауіпсіздік шаралары анықталмайынша мен кете алмаймын.
Dialogue: 0,0:37:21.90,0:37:24.57,Default,,0,0,0,,және біз сақшыға ұсталмай-ақ жете алмаймыз.
Dialogue: 0,0:37:24.64,0:37:25.87,Default-ja,,0,0,0,,Сондықтан
Dialogue: 0,0:37:24.65,0:37:25.78,Default,,0,0,0,,Барлық басқа себептер.
Dialogue: 0,0:37:26.57,0:37:28.49,Default,,0,0,0,,Бұл адам қанша күшті болса да,
Dialogue: 0,0:37:26.61,0:37:28.47,Default-ja,,0,0,0,,Бұл адам қанша күшті болса да,
Dialogue: 0,0:37:28.54,0:37:31.28,Default-ja,,0,0,0,,Ол жерге жалғыз жетуге кепілдік жоқ.
Dialogue: 0,0:37:28.57,0:37:31.41,Default,,0,0,0,,Тіпті оның сонша алысқа жалғыз жетуіне кепілдік жоқ.
Dialogue: 0,0:37:31.64,0:37:34.41,Default-ja,,0,0,0,,Егер бізге көмектесе алатын болсақ...
Dialogue: 0,0:37:31.79,0:37:34.12,Default,,0,0,0,,Бірақ оған аз да болса көмектесе алсақ...
Dialogue: 0,0:37:34.85,0:37:35.92,Default-ja,,0,0,0,,Иә.
Dialogue: 0,0:37:34.91,0:37:38.25,Default,,0,0,0,,Рас. Арамызда көп адам болғаны дұрыс шығар.
Dialogue: 0,0:37:36.52,0:37:38.02,Default-ja,,0,0,0,,Адамдардың көп болғаны жақсы болуы мүмкін
Dialogue: 0,0:37:38.33,0:37:42.21,Default,,0,0,0,,Бірақ біз сапарға тамақ алуымыз керек
Dialogue: 0,0:37:38.35,0:37:39.35,Default-ja,,0,0,0,,Бірақ...
Dialogue: 0,0:37:39.42,0:37:42.46,Default-ja,,0,0,0,,Жорықтарға келгенде тамақты да әкелу керек.
Dialogue: 0,0:37:42.69,0:37:44.39,Default-ja,,0,0,0,,Көп нәрсе қалмаса да
Dialogue: 0,0:37:42.71,0:37:44.47,Default,,0,0,0,,және аз ғана қалды.
Dialogue: 0,0:37:45.22,0:37:49.01,Default,,0,0,0,,Автоматтандырылған зауытта біз кез келген нәрсені жасай аламыз.
Dialogue: 0,0:37:45.29,0:37:47.26,Default-ja,,0,0,0,,Автоматтандырылған зауыт дегеніміз не?
Dialogue: 0,0:37:47.63,0:37:49.30,Default-ja,,0,0,0,,Сіз кез келген нәрсені жасай аласыз.
Dialogue: 0,0:37:49.83,0:37:52.80,Default-ja,,0,0,0,,Онда барсаң, мен саған қалағаныңды жасап беремін.
Dialogue: 0,0:37:49.93,0:37:52.60,Default,,0,0,0,,Ол жерге жетсек, мен саған қалағанның бәрін жасаймын.
Dialogue: 0,0:37:53.39,0:37:54.52,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:37:53.43,0:37:54.43,Default-ja,,0,0,0,,Бірдеңе?
Dialogue: 0,0:37:54.60,0:37:57.65,Default,,0,0,0,,Иә, тіпті тамақ, не ұнайды.
Dialogue: 0,0:37:54.67,0:37:55.53,Default-ja,,0,0,0,,Иә
Dialogue: 0,0:37:55.94,0:37:57.87,Default-ja,,0,0,0,,Тамақ, бәрібір.
Dialogue: 0,0:37:58.35,0:37:59.48,Default,,0,0,0,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,0:37:58.44,0:37:59.41,Default-ja,,0,0,0,,Бұл рас па...
Dialogue: 0,0:37:59.91,0:38:00.81,Default-ja,,0,0,0,,Кири-сан
Dialogue: 0,0:38:00.06,0:38:00.98,Default,,0,0,0,,Килли.
Dialogue: 0,0:38:03.28,0:38:05.90,Default,,0,0,0,,Шынымды айтсам, біз тіпті түсінбейміз
Dialogue: 0,0:38:03.31,0:38:07.65,Default-ja,,0,0,0,,Шынымды айтсам, ол кісінің айтып отырғанының жартысын да түсінбейміз.
Dialogue: 0,0:38:05.99,0:38:07.53,Default,,0,0,0,,оның айтқанының жартысы.
Dialogue: 0,0:38:08.75,0:38:09.72,Default-ja,,0,0,0,,Бірақ...
Dialogue: 0,0:38:08.78,0:38:09.66,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:38:10.95,0:38:12.45,Default-ja,,0,0,0,,Мен бәс тігкім келеді
Dialogue: 0,0:38:11.03,0:38:14.45,Default,,0,0,0,,біз сізбен және онымен мүмкіндік алғымыз келеді.
Dialogue: 0,0:38:12.85,0:38:14.62,Default-ja,,0,0,0,,Сізге және сол адамға...!
Dialogue: 0,0:38:36.35,0:38:38.89,Default,,0,0,0,,-Асығыңыз! -Басқа аккумуляторлар жоқ па?
Dialogue: 0,0:38:36.48,0:38:38.48,Default-ja,,0,0,0,,Асығыңыз! Сізде қосымша батареялар жоқ па?
Dialogue: 0,0:38:38.81,0:38:41.31,Default-ja,,0,0,0,,Көбірек гарпун алып жүріңіз! Тағы бір жүк тасушы келіңізші.
Dialogue: 0,0:38:38.98,0:38:41.36,Default,,0,0,0,,-Барынша көп найза ал! - Бізге тағы бір адам керек!
Dialogue: 0,0:38:41.44,0:38:44.57,Default,,0,0,0,,-Ауылды қорғауға біраз қалдырыңыз. -Бізде дулығалар жеткілікті ме?
Dialogue: 0,0:38:41.55,0:38:44.58,Default-ja,,0,0,0,,Ауылға біраз қорғаныс қалдыру керек... Дулыға жеткілікті ме?
Dialogue: 0,0:38:44.65,0:38:46.57,Default,,0,0,0,,Тоқтаңдар, бәрің.
Dialogue: 0,0:38:44.65,0:38:46.82,Default-ja,,0,0,0,,Кешіктірмеңіздер, балалар!
Dialogue: 0,0:38:58.46,0:39:00.50,Default-ja,,0,0,0,,Хмм...? (Сутезо) Сәлем Зуру!
Dialogue: 0,0:38:59.33,0:39:00.58,Default,,0,0,0,,Сәлем, Зуру!
Dialogue: 0,0:39:02.50,0:39:04.42,Default,,0,0,0,,Біз Киллимен бірге болғанша жақсы боламыз.
Dialogue: 0,0:39:02.57,0:39:04.37,Default-ja,,0,0,0,,Кириханың қасында болғанша бәрі жақсы болады.
Dialogue: 0,0:39:07.38,0:39:08.92,Default,,0,0,0,,Кеттік. Маған жазыл.
Dialogue: 0,0:39:07.44,0:39:09.34,Default-ja,,0,0,0,,Кеттік, жалғастырайық!
Dialogue: 0,0:39:09.98,0:39:10.84,Default-ja,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:39:10.18,0:39:11.01,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:39:19.44,0:39:21.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:39:19.59,0:39:21.55,Default-ja,,0,0,0,,Бұл не?
Dialogue: 0,0:39:21.75,0:39:23.82,Default-ja,,0,0,0,,Құсаре ​​ғибадатханасынан табылған.
Dialogue: 0,0:39:21.77,0:39:23.81,Default,,0,0,0,,Мен олардың оны Шірік храмынан тапқанын естідім.
Dialogue: 0,0:39:24.59,0:39:28.53,Default-ja,,0,0,0,,Уау, ол шынымен тірі ме...
Dialogue: 0,0:39:26.03,0:39:28.28,Default,,0,0,0,,Бұл зат шынымен тірі ме?
Dialogue: 0,0:39:28.59,0:39:30.43,Default-ja,,0,0,0,,Ол тірі! Апыр-ай!
Dialogue: 0,0:39:28.65,0:39:29.78,Default,,0,0,0,,Иә, мен тірімін.
Dialogue: 0,0:39:31.76,0:39:34.87,Default-ja,,0,0,0,,Ей, бұл босқа... Бұл рас шығар.
Dialogue: 0,0:39:31.78,0:39:34.62,Default,,0,0,0,,Сәлем, Сутезо. Бұл рас па?
Dialogue: 0,0:39:34.97,0:39:37.70,Default-ja,,0,0,0,,Бұл жігітті автоматты зауыт деген жерге апарсақ.
Dialogue: 0,0:39:34.99,0:39:37.70,Default,,0,0,0,,Біз оны осы жерге апарсақ, ол шынымен бізге тамақ жасай ма?
Dialogue: 0,0:39:37.77,0:39:39.47,Default-ja,,0,0,0,,Маған тамақ жасап беремін деді.
Dialogue: 0,0:39:37.79,0:39:39.54,Default,,0,0,0,,Автоматтандырылған зауыт орны?
Dialogue: 0,0:39:40.04,0:39:41.91,Default-ja,,0,0,0,,Цк... менен сұрама
Dialogue: 0,0:39:40.33,0:39:41.71,Default,,0,0,0,,Мен саған айттым ғой, менен сұрама.
Dialogue: 0,0:39:42.44,0:39:43.44,Default-ja,,0,0,0,,Бұл рас (саншу) А...?
Dialogue: 0,0:39:42.46,0:39:43.50,Default,,0,0,0,,Бұл рас.
Мен
Dialogue: 0,0:39:43.94,0:39:46.81,Default-ja,,0,0,0,,Тіпті Кириха сияқты портативті тағам да болды.
Dialogue: 0,0:39:44.09,0:39:46.67,Default,,0,0,0,,Мен мыңдаған портативті рацион жасай аламын
Dialogue: 0,0:39:46.88,0:39:48.71,Default-ja,,0,0,0,,Олардың мыңдағанын жасауға болады.
Dialogue: 0,0:39:47.00,0:39:48.59,Default,,0,0,0,,Килли сияқты.
Dialogue: 0,0:39:49.12,0:39:50.55,Default-ja,,0,0,0,,Неше мың?
Dialogue: 0,0:39:49.22,0:39:50.34,Default,,0,0,0,,Мың?
Dialogue: 0,0:39:50.92,0:39:53.92,Default-ja,,0,0,0,,Олай болса, керемет болар еді, хехе
Dialogue: 0,0:39:50.97,0:39:52.84,Default,,0,0,0,,Бұл рас болса қандай тамаша.
Dialogue: 0,0:39:59.76,0:40:03.80,Default-ja,,0,0,0,,Мм... Қария, амансың ба?
Dialogue: 0,0:40:01.27,0:40:03.81,Default,,0,0,0,,Поп, бұл шынымен қауіпсіз бе?
Dialogue: 0,0:40:03.86,0:40:05.56,Default-ja,,0,0,0,,Мына жігіттің айтқанына сеніңіз
Dialogue: 0,0:40:03.90,0:40:05.65,Default,,0,0,0,,бұл нәрсенің айтқанына сену керек пе?
Dialogue: 0,0:40:06.10,0:40:08.97,Default-ja,,0,0,0,,Менің шешіміме шағымы бар кез келген адам
Dialogue: 0,0:40:06.23,0:40:10.11,Default,,0,0,0,,Егер сізде менің шешіміме қатысты мәселе туындаса, дәл қазір оралыңыз.
Dialogue: 0,0:40:09.03,0:40:09.94,Default-ja,,0,0,0,,Қазір үйге қайт
Dialogue: 0,0:40:10.47,0:40:11.97,Default-ja,,0,0,0,,(күрсіну)
Dialogue: 0,0:40:12.41,0:40:14.78,Default,,0,0,0,,Менде проблема жоқ.
Dialogue: 0,0:40:12.41,0:40:14.91,Default-ja,,0,0,0,,Шағымдар жоқ...
Dialogue: 0,0:40:15.53,0:40:16.49,Default,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:40:15.57,0:40:16.54,Default-ja,,0,0,0,,Эй?
Dialogue: 0,0:40:16.74,0:40:19.45,Default,,0,0,0,,Менде ешқашан проблема болған емес.
Dialogue: 0,0:40:16.84,0:40:19.41,Default-ja,,0,0,0,,Мен басынан бері шағымданған емеспін.
Dialogue: 0,0:40:19.54,0:40:21.08,Default,,0,0,0,,Үніңді жауып, жүр.
Dialogue: 0,0:40:19.85,0:40:21.05,Default-ja,,0,0,0,,Үніңді жап, жүр
Dialogue: 0,0:40:27.69,0:40:29.52,Default-ja,,0,0,0,,Жұппен шеңбер құрыңдар
Dialogue: 0,0:40:27.71,0:40:29.59,Default,,0,0,0,,Жұптасып, шеңберлі формацияға кіріңіз.
Dialogue: 0,0:40:30.12,0:40:32.06,Default-ja,,0,0,0,,Саңылауды жабыңыз.
Dialogue: 0,0:40:30.17,0:40:32.34,Default,,0,0,0,,-Араларыңызда көп орын қалдырмаңыз. -Иә, сэр.
Dialogue: 0,0:40:33.16,0:40:35.83,Default-ja,,0,0,0,,Мен сенің соңынан ермеймін, Тэ.
Dialogue: 0,0:40:33.18,0:40:35.59,Default,,0,0,0,,Сенің келуіңнің қажеті жоқ еді, Тэ.
Dialogue: 0,0:40:36.60,0:40:38.66,Default-ja,,0,0,0,,Кири-сан берген тамақпен
Dialogue: 0,0:40:36.72,0:40:40.18,Default,,0,0,0,,Әпкем Киллидің бізге берген тамағы арқасында жақсы болып жатыр.
Dialogue: 0,0:40:38.73,0:40:40.57,Default-ja,,0,0,0,,Әпкемнің энергиясы жақсарды.
Dialogue: 0,0:40:40.83,0:40:42.13,Default-ja,,0,0,0,,Мен жақсылықты қайтаруым керек
Dialogue: 0,0:40:40.89,0:40:42.02,Default,,0,0,0,,Мен оны өтеуім керек.
Dialogue: 0,0:40:43.00,0:40:44.00,Default-ja,,0,0,0,,Және...
Dialogue: 0,0:40:43.06,0:40:46.40,Default,,0,0,0,,Сонымен қатар, Зуру қайда барса да...
Dialogue: 0,0:40:44.70,0:40:46.84,Default-ja,,0,0,0,,Зуру қайда барса, мен барамын.
Dialogue: 0,0:40:46.77,0:40:48.11,Default,,0,0,0,,Мен онымен барамын.
Dialogue: 0,0:40:46.91,0:40:48.44,Default-ja,,0,0,0,,Мен сенімен кез келген жерге барамын
Dialogue: 0,0:40:50.04,0:40:50.94,Default-ja,,0,0,0,,Тэ…
Dialogue: 0,0:40:50.15,0:40:51.24,Default,,0,0,0,,Тэ.
Dialogue: 0,0:40:51.78,0:40:54.91,Default-ja,,0,0,0,,Бұл балаларды шығару қиын болуы керек.
Dialogue: 0,0:40:51.82,0:40:54.95,Default,,0,0,0,,Бұл балаларды өзіңізбен бірге алып келе жатқаныңыз үшін бәрі қиын болуы керек.
Dialogue: 0,0:40:55.48,0:40:56.72,Default-ja,,0,0,0,,Шынымды айтсам...
Dialogue: 0,0:40:55.66,0:40:56.87,Default,,0,0,0,,Шынымды айтсам,
Dialogue: 0,0:40:56.95,0:41:00.24,Default,,0,0,0,,Электро-Фишер тетігін пайдалана алатындар көп емес.
Dialogue: 0,0:40:56.95,0:40:58.98,Default-ja,,0,0,0,,Кейбір адамдар электронды балықшылардың жабдықтарын пайдалана алады.
Dialogue: 0,0:40:59.05,0:41:00.62,Default-ja,,0,0,0,,Көп нәрсе қалды.
Dialogue: 0,0:41:11.53,0:41:13.87,Default-ja,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:41:21.14,0:41:22.48,Default-ja,,0,0,0,,Күзет мұнарасы!
Dialogue: 0,0:41:21.39,0:41:22.31,Default,,0,0,0,,Күзет мұнарасы!
Dialogue: 0,0:41:22.91,0:41:24.04,Default-ja,,0,0,0,,О? (Сутезо) Эй!
Dialogue: 0,0:41:23.81,0:41:24.77,Default,,0,0,0,,Та-да!
Dialogue: 0,0:41:33.19,0:41:35.52,Default-ja,,0,0,0,,Соның арқасында...?
Dialogue: 0,0:41:33.32,0:41:35.15,Default,,0,0,0,,Бұл не істеп жатыр?
Dialogue: 0,0:42:01.15,0:42:04.28,Default-ja,,0,0,0,,Мұнда не болып жатыр? Керемет...
Dialogue: 0,0:42:01.22,0:42:02.64,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:42:04.52,0:42:05.39,Default,,0,0,0,,Сәлем, Килли.
Dialogue: 0,0:42:04.55,0:42:05.68,Default-ja,,0,0,0,,Сәлем Кирибо
Dialogue: 0,0:42:06.22,0:42:09.72,Default-ja,,0,0,0,,Сіз мені жарты жолда қалдырмас едіңіз, солай ма?
Dialogue: 0,0:42:06.35,0:42:09.81,Default,,0,0,0,,Сіз мені жолда бір жерге тастап кетпейсіз ғой, солай ма?
Dialogue: 0,0:42:46.16,0:42:47.19,Default-ja,,0,0,0,,Кири-сан
Dialogue: 0,0:42:46.27,0:42:47.14,Default,,0,0,0,,Килли.
Dialogue: 0,0:42:56.30,0:42:58.10,Default-ja,,0,0,0,,А... А?
Dialogue: 0,0:42:58.77,0:43:01.61,Default-ja,,0,0,0,,Кириханың зат алмасуы қалыпты адамдарға қарағанда басқаша.
Dialogue: 0,0:42:58.82,0:43:01.53,Default,,0,0,0,,Киллидің зат алмасуы қалыпты адамдардан өзгеше.
Dialogue: 0,0:43:01.62,0:43:03.74,Default,,0,0,0,,Ол өте сирек тамақтануды қажет етеді.
Dialogue: 0,0:43:01.67,0:43:03.98,Default-ja,,0,0,0,,Маған сирек тамақтану керек.
Dialogue: 0,0:43:04.58,0:43:05.83,Default,,0,0,0,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,0:43:04.64,0:43:05.61,Default-ja,,0,0,0,,Сонымен...
Dialogue: 0,0:43:05.88,0:43:08.58,Default-ja,,0,0,0,,Уфуфу... Сонда сен ше?
Dialogue: 0,0:43:06.91,0:43:08.25,Default,,0,0,0,,Ал, сен ше?
Dialogue: 0,0:43:10.08,0:43:12.62,Default-ja,,0,0,0,,Хмм... Мен одан аулақ боламын.
Dialogue: 0,0:43:11.17,0:43:12.33,Default,,0,0,0,,Мен өтемін.
Dialogue: 0,0:43:13.09,0:43:14.85,Default-ja,,0,0,0,,Бірақ мен өзімді бақытты сезінемін.
Dialogue: 0,0:43:13.13,0:43:14.55,Default,,0,0,0,,Бірақ мен ойды бағалаймын.
Dialogue: 0,0:43:45.78,0:43:46.65,Default-ja,,0,0,0,,Уф...
Dialogue: 0,0:43:47.85,0:43:49.66,Default-ja,,0,0,0,,Бұл қорқынышты болды ма? иә?
Dialogue: 0,0:43:47.87,0:43:49.08,Default,,0,0,0,,Хиёри-чан, сен жақында орта мектепке барасың, иә?
Dialogue: 0,0:43:54.76,0:43:57.63,Default-ja,,0,0,0,,Иә... бірақ бәрібір.
Dialogue: 0,0:43:54.79,0:43:57.30,Default,,0,0,0,,Иә. Бірақ мен жақсымын.
Dialogue: 0,0:43:58.84,0:44:01.05,Default,,0,0,0,,Бұл қорғаныс құралдары келгенде...
Dialogue: 0,0:43:58.86,0:44:01.30,Default-ja,,0,0,0,,Қауіпсіздік шаралары келгенде, олар
Dialogue: 0,0:44:01.68,0:44:04.47,Default,,0,0,0,,олардың айналасындағы ауа ион иісін сезеді.
Dialogue: 0,0:44:01.73,0:44:04.87,Default-ja,,0,0,0,,Айналадағы ауадан иондардың иісі бар.
Dialogue: 0,0:44:05.04,0:44:06.71,Default-ja,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:44:05.10,0:44:06.56,Default,,0,0,0,,Білесіз бе...
Dialogue: 0,0:44:07.24,0:44:09.64,Default-ja,,0,0,0,,Бұл мені тітіркендіреді, хмм...
Dialogue: 0,0:44:07.31,0:44:08.60,Default,,0,0,0,,мұрныңыз шағып тұр.
Dialogue: 0,0:44:10.28,0:44:11.28,Default-ja,,0,0,0,,Сіз оның иісін сездіңіз бе?
Dialogue: 0,0:44:10.31,0:44:11.52,Default,,0,0,0,,Сіз оның иісін сездіңіз бе?
Dialogue: 0,0:44:12.04,0:44:13.71,Default-ja,,0,0,0,,Себебі мен шарасыз едім...
Dialogue: 0,0:44:12.14,0:44:13.44,Default,,0,0,0,,Мен қатты ашуландым...
Dialogue: 0,0:44:14.18,0:44:15.85,Default-ja,,0,0,0,,Мен жақсы есімде жоқ.
Dialogue: 0,0:44:14.19,0:44:15.73,Default,,0,0,0,,Менің есімде жоқ.
Dialogue: 0,0:44:16.32,0:44:18.18,Default-ja,,0,0,0,,Бәлкім, солай болған шығар.
Dialogue: 0,0:44:16.44,0:44:18.36,Default,,0,0,0,,Шындығында, мен солай жасадым деп ойлаймын.
Dialogue: 0,0:44:20.19,0:44:22.78,Default,,0,0,0,,Енді сіз айтып отырсаңыз, біртүрлі иіс шықты.
Dialogue: 0,0:44:20.19,0:44:23.12,Default-ja,,0,0,0,,Ойлап қарасам, біртүрлі иіс шықты.
Dialogue: 0,0:44:24.29,0:44:27.23,Default-ja,,0,0,0,,Хмм... Түсіндім бе?
Dialogue: 0,0:44:25.57,0:44:26.53,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,0:44:27.43,0:44:31.00,Default-ja,,0,0,0,,Мұндай нәрселерді бастан кешіру арқылы ғана түсінуге болады.
Dialogue: 0,0:44:27.58,0:44:30.66,Default,,0,0,0,,Түсіну үшін бастан кешіру керек нәрсенің түрі.
Dialogue: 0,0:44:32.79,0:44:33.62,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:44:32.83,0:44:33.70,Default-ja,,0,0,0,,Иә...
Dialogue: 0,0:44:34.75,0:44:35.79,Default,,0,0,0,,Мұны есте сақтаңыз.
Dialogue: 0,0:44:34.80,0:44:36.04,Default-ja,,0,0,0,,Есте сақта
Dialogue: 0,0:44:36.27,0:44:38.77,Default-ja,,0,0,0,,Электр балықшылар лагеріне барғанда
Dialogue: 0,0:44:36.42,0:44:38.75,Default,,0,0,0,,Электро-балықшылар лагерінде,
Dialogue: 0,0:44:38.84,0:44:41.42,Default,,0,0,0,,біз үнемі осылай от жағып, оның жанында ұйықтаймыз.
Dialogue: 0,0:44:38.84,0:44:41.44,Default-ja,,0,0,0,,Сонымен сіз от жағып, оның жанында ұйықтайсыз.
Dialogue: 0,0:44:43.01,0:44:45.43,Default,,0,0,0,,Бұл біз әрқашан осылай істедік.
Dialogue: 0,0:44:43.01,0:44:45.24,Default-ja,,0,0,0,,Бұл ертеден келе жатқан әдет.
Dialogue: 0,0:44:47.01,0:44:48.01,Default,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:44:47.01,0:44:47.91,Default-ja,,0,0,0,,Неліктен?
Dialogue: 0,0:44:49.15,0:44:53.02,Default-ja,,0,0,0,,Аңшылық сізді күні бойы аяқтың ұшында ұстайды.
Dialogue: 0,0:44:49.18,0:44:50.31,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:44:50.77,0:44:53.27,Default,,0,0,0,,біз аңға шыққанда күні бойы шетте боламыз.
Dialogue: 0,0:44:53.82,0:44:55.69,Default-ja,,0,0,0,,Адам дегеніміз не?
Dialogue: 0,0:44:53.85,0:44:55.65,Default,,0,0,0,,Бұлай айтылған
Dialogue: 0,0:44:55.73,0:44:58.77,Default,,0,0,0,,отты көру адамды тыныштандырады.
Dialogue: 0,0:44:55.79,0:44:58.72,Default-ja,,0,0,0,,Шамасы, неге екені белгісіз, отты көргенде өзімді қауіпсіз сезінемін.
Dialogue: 0,0:44:59.43,0:45:01.23,Default-ja,,0,0,0,,Мен баяғыдан сенімдімін...
Dialogue: 0,0:44:59.57,0:45:01.40,Default,,0,0,0,,Мен бұл бұрыннан бері шындық екеніне сенімдімін.
Dialogue: 0,0:45:01.39,0:45:03.93,Default-ja,,0,0,0,,Қалалар бұрыннан осындай...
Dialogue: 0,0:45:01.49,0:45:04.03,Default,,0,0,0,,Қала бұл күйге келгеннен көп уақыт бұрын.
Dialogue: 0,0:45:04.74,0:45:08.20,Default,,0,0,0,,Күннің соңында адамдар отты тамашалайтын
Dialogue: 0,0:45:04.80,0:45:08.10,Default-ja,,0,0,0,,Адамдар күннің аяғында отқа осылай қарайды.
Dialogue: 0,0:45:08.17,0:45:10.84,Default-ja,,0,0,0,,Менің шиеленіскен жүрегімді емдеген болуы керек.
Dialogue: 0,0:45:08.28,0:45:10.41,Default,,0,0,0,,өздерін еркін ұстау.
Dialogue: 0,0:45:29.72,0:45:32.47,Default,,0,0,0,,Мен көп күттім.
Dialogue: 0,0:45:29.79,0:45:32.83,Default-ja,,0,0,0,,Мен... Көптен күттім.
Dialogue: 0,0:45:35.26,0:45:37.93,Default-ja,,0,0,0,,Мен мұнда келгенге дейін достарым болды, бірақ...
Dialogue: 0,0:45:35.27,0:45:37.56,Default,,0,0,0,,Бұрын менімен басқалар болды...
Dialogue: 0,0:45:38.50,0:45:40.20,Default-ja,,0,0,0,,Барлығы дүниеден өтті.
Dialogue: 0,0:45:38.56,0:45:40.02,Default,,0,0,0,,бірақ олардың бәрі қайтыс болды.
Dialogue: 0,0:45:42.19,0:45:45.24,Default,,0,0,0,,Қаланың қашаннан бері осылай болғанын ешкім білмейді.
Dialogue: 0,0:45:42.20,0:45:45.37,Default-ja,,0,0,0,,Қалалардың қашан осылай болғанын ешкім білмейді.
Dialogue: 0,0:45:46.14,0:45:48.47,Default-ja,,0,0,0,,Бір күні кенеттен инфекция басталды.
Dialogue: 0,0:45:46.16,0:45:48.62,Default,,0,0,0,,Бір күні кенеттен жұқпалы ауру басталды
Dialogue: 0,0:45:48.70,0:45:51.62,Default,,0,0,0,,және адамдар қаламен байланысу мүмкіндігінен айырылды.
Dialogue: 0,0:45:48.74,0:45:51.94,Default-ja,,0,0,0,,Адамдар қалаларға қосылу мүмкіндігінен айырылды.
Dialogue: 0,0:45:53.91,0:45:57.62,Default,,0,0,0,,Осыдан кейін қала кездейсоқ кеңейе бастады
Dialogue: 0,0:45:53.98,0:45:57.98,Default-ja,,0,0,0,,Содан бері қалалар ретсіз көбейе бастады.
Dialogue: 0,0:45:58.05,0:46:01.22,Default-ja,,0,0,0,,Қауіпсіздік органдары адамдарды заңсыз тұрғындар ретінде қарастырады.
Dialogue: 0,0:45:58.13,0:46:01.30,Default,,0,0,0,,және Қауіпсіздік органдары адамдарды заңсыз тұрғындар ретінде қарастырды
Dialogue: 0,0:46:01.29,0:46:02.99,Default-ja,,0,0,0,,Енді жойылады
Dialogue: 0,0:46:01.38,0:46:02.80,Default,,0,0,0,,және бізді құртуға кірісті.
Dialogue: 0,0:46:06.36,0:46:07.49,Default-ja,,0,0,0,,Мен...
Dialogue: 0,0:46:06.43,0:46:11.43,Default,,0,0,0,,Мен осы жерден шалғайдағы Кайто ауданының бас ғалымы болдым.
Dialogue: 0,0:46:07.76,0:46:11.80,Default-ja,,0,0,0,,Ол осы жерден шалғайдағы Блок қаласы деп аталатын қаланың бас ғалымы болды.
Dialogue: 0,0:46:13.27,0:46:15.02,Default,,0,0,0,,Сол ауданда,
Dialogue: 0,0:46:13.47,0:46:17.44,Default-ja,,0,0,0,,Сол қалада қала қирандыларынан мәліметтер қазылған.
Dialogue: 0,0:46:15.10,0:46:17.85,Default,,0,0,0,,біз қала қалдықтарынан кейбір мәліметтерді қазып алдық
Dialogue: 0,0:46:17.84,0:46:19.47,Default-ja,,0,0,0,,Оны қолдану арқылы
Dialogue: 0,0:46:17.94,0:46:19.56,Default,,0,0,0,,және оны пайдалана білді
Dialogue: 0,0:46:19.54,0:46:22.24,Default-ja,,0,0,0,,Біз адам өмірін сақтай алдық.
Dialogue: 0,0:46:19.65,0:46:21.90,Default,,0,0,0,,адам өмірін сақтау.
Dialogue: 0,0:46:23.34,0:46:26.21,Default-ja,,0,0,0,,Бірақ мұндай нәрселер ұзаққа бармайды.
Dialogue: 0,0:46:23.44,0:46:27.91,Default,,0,0,0,,Бірақ біз оның ұзаққа созыла алмайтынын білдік.
Dialogue: 0,0:46:26.28,0:46:28.21,Default-ja,,0,0,0,,Біз білдік
Dialogue: 0,0:46:31.15,0:46:33.32,Default-ja,,0,0,0,,Біз, бір топ ғалымдар,
Dialogue: 0,0:46:31.20,0:46:33.45,Default,,0,0,0,,Менің ғалымдар тобым
Dialogue: 0,0:46:33.45,0:46:37.12,Default-ja,,0,0,0,,Интернет терминалының гендерін жасыру әдісін ойлап тапты
Dialogue: 0,0:46:33.54,0:46:36.87,Default,,0,0,0,,Net Terminal генін имитациялау әдісін тапты.
Dialogue: 0,0:46:38.08,0:46:39.67,Default,,0,0,0,,Менің әріптестерім және мен
Dialogue: 0,0:46:38.09,0:46:39.99,Default-ja,,0,0,0,,Мен достарыммен біргемін
Dialogue: 0,0:46:40.09,0:46:43.26,Default-ja,,0,0,0,,Мен қосылым терминалдары бар басқа жерлерді табу үшін саяхатқа шықтым.
Dialogue: 0,0:46:40.13,0:46:43.13,Default,,0,0,0,,қосылым порты бар басқа орынды іздеуге шықты.
Dialogue: 0,0:46:46.17,0:46:47.76,Default,,0,0,0,,Міне, біз оны таптық.
Dialogue: 0,0:46:46.17,0:46:48.07,Default-ja,,0,0,0,,Міне, мен оны таптым ...
Dialogue: 0,0:46:52.57,0:46:54.01,Default-ja,,0,0,0,,Саяхат кезінде...
Dialogue: 0,0:46:52.72,0:46:53.72,Default,,0,0,0,,Біздің саяхатта...
Dialogue: 0,0:46:54.54,0:46:56.91,Default-ja,,0,0,0,,Олар бірінен соң бірі өлді.
Dialogue: 0,0:46:54.68,0:46:56.60,Default,,0,0,0,,біріміз, сосын тағы біріміз өлдік.
Dialogue: 0,0:46:58.38,0:47:02.35,Default-ja,,0,0,0,,Менің барлық достарым сол тәжірибенің арқасында...
Dialogue: 0,0:46:58.48,0:47:02.15,Default,,0,0,0,,Тіпті сол жерге жеткендер де, эксперимент кезінде олардың барлығы...
Dialogue: 0,0:47:08.39,0:47:11.89,Default-ja,,0,0,0,,Мен Блок Капитал қаласы енді жоқ екеніне сенімдімін.
Dialogue: 0,0:47:08.45,0:47:11.57,Default,,0,0,0,,Мен қазір Кайтоның да кеткеніне сенімдімін.
Dialogue: 0,0:48:04.21,0:48:06.11,Default-ja,,0,0,0,,Автоматтандырылған зауыт алда.
Dialogue: 0,0:48:04.25,0:48:06.04,Default,,0,0,0,,Автоматтандырылған зауыт осы жерден өтеді.
Dialogue: 0,0:48:07.05,0:48:09.35,Default-ja,,0,0,0,,Әй... қария
Dialogue: 0,0:48:08.38,0:48:09.30,Default,,0,0,0,,Поп.
Dialogue: 0,0:48:10.05,0:48:10.88,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:48:10.08,0:48:11.02,Default-ja,,0,0,0,,О
Dialogue: 0,0:48:11.42,0:48:15.59,Default-ja,,0,0,0,,Бұл жерден кетіп, қайтып келген адам жоқ.
Dialogue: 0,0:48:11.43,0:48:13.14,Default,,0,0,0,,Бұл жолмен кеткен ешкім жоқ
Dialogue: 0,0:48:13.64,0:48:15.47,Default,,0,0,0,,қайтып келді.
Dialogue: 0,0:48:16.19,0:48:17.12,Default-ja,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:48:18.39,0:48:20.66,Default-ja,,0,0,0,,Сіз зауыттың қорғаныс торына түсіп қалдыңыз, солай ма?
Dialogue: 0,0:48:18.47,0:48:20.56,Default,,0,0,0,,Оларды қорғаныс торы ұстап алған болуы керек.
Dialogue: 0,0:48:21.29,0:48:23.50,Default-ja,,0,0,0,,Бірақ Кириха екеуміз осында болғанша бәрібір.
Dialogue: 0,0:48:21.35,0:48:23.31,Default,,0,0,0,,Бірақ мен және Килли осында болса, бәрібір.
Dialogue: 0,0:48:24.27,0:48:25.23,Default,,0,0,0,,Сіз оны естідіңіз.
Dialogue: 0,0:48:24.30,0:48:25.40,Default-ja,,0,0,0,,Бұл...
Dialogue: 0,0:48:26.86,0:48:27.73,Default,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:48:26.90,0:48:27.57,Default-ja,,0,0,0,,Кеттік
Dialogue: 0,0:48:28.53,0:48:29.40,Default-ja,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:48:28.57,0:48:29.44,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:48:42.83,0:48:44.92,Default,,0,0,0,,Бұл автоматтандырылған зауыттың кіреберісі.
Dialogue: 0,0:48:42.95,0:48:45.12,Default-ja,,0,0,0,,Бұл автоматтандырылған зауыттың кіреберісі.
Dialogue: 0,0:48:47.17,0:48:50.71,Default,,0,0,0,,Қаланың төңірегінде әлі де автоматтандырылған зауыттар бар.
Dialogue: 0,0:48:47.19,0:48:50.46,Default-ja,,0,0,0,,Осындай автоматтандырылған зауыттар қаланың түкпір-түкпірінде қалды.
Dialogue: 0,0:48:51.62,0:48:54.96,Default-ja,,0,0,0,,Бұл сіздің ауылыңызға ең жақын зауыт.
Dialogue: 0,0:48:51.76,0:48:54.64,Default,,0,0,0,,Бұл сіздің ауылыңызға ең жақын жер.
Dialogue: 0,0:49:03.47,0:49:04.60,Default-ja,,0,0,0,,Уау...!
Dialogue: 0,0:49:06.02,0:49:06.98,Default,,0,0,0,,Ол ашылды!
Dialogue: 0,0:49:06.07,0:49:07.07,Default-ja,,0,0,0,,Қостаушылардың көбі Босс жағында—
Dialogue: 0,0:49:14.68,0:49:18.25,Default-ja,,0,0,0,,Сіз қосыла алдыңыз ба?
Dialogue: 0,0:49:14.78,0:49:17.99,Default,,0,0,0,,Сіз қосыла алдыңыз ба?
Dialogue: 0,0:49:19.05,0:49:19.72,Default-ja,,0,0,0,,Фу…
Dialogue: 0,0:49:20.15,0:49:21.22,Default-ja,,0,0,0,,Осы дәрежеде
Dialogue: 0,0:49:20.20,0:49:24.12,Default,,0,0,0,,Осыған ұқсас нәрсе үшін NetSphere-ге қосыла алудың қажеті жоқ.
Dialogue: 0,0:49:21.29,0:49:24.32,Default-ja,,0,0,0,,Мұны NetSphere қолданбасына қосылмай-ақ жасауға болады.
Dialogue: 0,0:49:27.53,0:49:32.26,Default-ja,,0,0,0,,(Барлығының таңқаларлық дауысы)
Dialogue: 0,0:49:32.33,0:49:33.33,Default-ja,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:49:34.84,0:49:36.47,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:49:34.97,0:49:36.60,Default-ja,,0,0,0,,Не? Сонымен...
Dialogue: 0,0:49:43.10,0:49:45.27,Default,,0,0,0,,Олай болса, зауыт деп атайды.
Dialogue: 0,0:49:43.11,0:49:45.38,Default-ja,,0,0,0,,Бұл зауыт...
Dialogue: 0,0:49:48.94,0:49:51.11,Default,,0,0,0,,Бұл бассейн заттары қандай?
Dialogue: 0,0:49:48.98,0:49:51.35,Default-ja,,0,0,0,,Бұл шалшық тәрізді нәрсе не?
Dialogue: 0,0:49:52.35,0:49:55.29,Default-ja,,0,0,0,,Кирихай, мені сол консольге отырғыз.
Dialogue: 0,0:49:52.36,0:49:55.11,Default,,0,0,0,,Килли, мені сол консольге отырғыз.
Dialogue: 0,0:50:06.60,0:50:07.73,Default-ja,,0,0,0,,Уау!
Dialogue: 0,0:50:09.13,0:50:10.00,Default-ja,,0,0,0,,Ах!
Dialogue: 0,0:50:10.59,0:50:12.46,Default,,0,0,0,,БАСТАУ
Dialogue: 0,0:50:13.64,0:50:14.51,Default-ja,,0,0,0,,Сонымен... мені ұмытып қалғың келе ме?
Dialogue: 0,0:50:13.76,0:50:14.67,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:50:34.23,0:50:35.49,Default-ja,,0,0,0,,О!
Dialogue: 0,0:50:35.69,0:50:38.03,Default-ja,,0,0,0,,О... мен жасадым!
Dialogue: 0,0:50:36.78,0:50:37.82,Default,,0,0,0,,(Тик-так, тик-так соғады сағат)
Dialogue: 0,0:50:40.40,0:50:41.70,Default-ja,,0,0,0,,Керемет!
Dialogue: 0,0:50:40.45,0:50:41.83,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:50:41.77,0:50:44.17,Default-ja,,0,0,0,,Енді тамақ туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:50:41.91,0:50:44.20,Default,,0,0,0,,Енді біз ешқашан тамақ туралы алаңдамаймыз!
Dialogue: 0,0:50:44.24,0:50:45.30,Default-ja,,0,0,0,,Ах!
Dialogue: 0,0:50:44.29,0:50:45.12,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:50:48.77,0:50:52.61,Default-ja,,0,0,0,,Ах... Зуру қараңыз! Бұл керемет
Dialogue: 0,0:50:50.38,0:50:52.50,Default,,0,0,0,,Зуру, қара! Бұл керемет.
Dialogue: 0,0:50:53.41,0:50:54.28,Default-ja,,0,0,0,,Иә
Dialogue: 0,0:50:53.42,0:50:54.25,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:51:11.44,0:51:12.86,Default,,0,0,0,,Килли, сен мені естисің бе?
Dialogue: 0,0:51:11.46,0:51:12.66,Default-ja,,0,0,0,,Кириха, сен мені естисің бе?
Dialogue: 0,0:51:16.70,0:51:18.24,Default-ja,,0,0,0,,Мен біраз қиналып жүрмін.
Dialogue: 0,0:51:16.78,0:51:18.07,Default,,0,0,0,,Мен аздап қиналып жүрмін.
Dialogue: 0,0:51:19.32,0:51:22.99,Default,,0,0,0,,Синтетикалық терминалды алыңыз да, қашуға дайындалыңыз.
Dialogue: 0,0:51:19.34,0:51:23.28,Default-ja,,0,0,0,,Сол жалған құрылғымен құтылуға дайындалыңыз.
Dialogue: 0,0:51:25.29,0:51:26.91,Default,,0,0,0,,Мен әлі қозғала алмаймын.
Dialogue: 0,0:51:25.31,0:51:27.15,Default-ja,,0,0,0,,Мен әлі қозғала алмаймын.
Dialogue: 0,0:51:28.78,0:51:30.82,Default-ja,,0,0,0,,Ах...
Dialogue: 0,0:51:38.05,0:51:39.01,Default,,0,0,0,,Солай болар...
Dialogue: 0,0:51:38.12,0:51:39.36,Default-ja,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:51:39.38,0:51:43.80,Default,,0,0,0,,Мен өте терең қаздым. Өткен жолы бұл жағдай өте нашар болды.
Dialogue: 0,0:51:39.42,0:51:41.49,Default-ja,,0,0,0,,Себебі мен бірдеңені тереңірек басқардым.
Dialogue: 0,0:51:41.86,0:51:43.83,Default-ja,,0,0,0,,Өткен жолы мен қорқынышты жағдайға тап болдым.
Dialogue: 0,0:51:46.01,0:51:49.02,Default,,0,0,0,,Бұл сіз айтқан синтетикалық терминалдардың бірі ме, Сибо?
Dialogue: 0,0:51:46.16,0:51:49.17,Default-ja,,0,0,0,,Бұл жалған терминал ба? Шибо мырза
Dialogue: 0,0:51:51.35,0:51:55.19,Default,,0,0,0,,Осы арқылы біз қаланы тоқтата аламыз, солай ма?
Dialogue: 0,0:51:51.40,0:51:52.70,Default-ja,,0,0,0,,Тек...
Dialogue: 0,0:51:53.21,0:51:55.44,Default-ja,,0,0,0,,Сіз қаланы тоқтата аласыз ба?
Dialogue: 0,0:52:03.88,0:52:04.75,Default-ja,,0,0,0,,Фалько…
Dialogue: 0,0:52:06.37,0:52:08.04,Default,,0,0,0,,Эй, сен.
Dialogue: 0,0:52:06.38,0:52:08.12,Default-ja,,0,0,0,,Сәлем!
Dialogue: 0,0:52:10.22,0:52:16.26,Default-ja,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:52:20.57,0:52:21.43,Default-ja,,0,0,0,,Ха…
Dialogue: 0,0:52:21.63,0:52:22.90,Default-ja,,0,0,0,,(Ескерту дабылы)
Dialogue: 0,0:52:23.44,0:52:24.30,Default-ja,,0,0,0,,Не!
Dialogue: 0,0:52:31.61,0:52:32.68,Default-ja,,0,0,0,,Қария!
Dialogue: 0,0:52:31.73,0:52:32.98,Default,,0,0,0,,Поп!
Dialogue: 0,0:52:34.31,0:52:36.65,Default,,0,0,0,,Екі топқа бөліну. Жүк командасы бірінші болып барады.
Dialogue: 0,0:52:34.31,0:52:36.68,Default-ja,,0,0,0,,Екінші қадам жасамаңыз. Жүктерді өңдеу бірінші орында.
Dialogue: 0,0:52:36.73,0:52:39.03,Default,,0,0,0,,Жауынгерлер, оларды ішке тарт және шығар.
Dialogue: 0,0:52:36.75,0:52:38.82,Default-ja,,0,0,0,,Атқыш, мені жақындат.
Dialogue: 0,0:52:39.52,0:52:42.19,Default-ja,,0,0,0,,Әй, жүк тасушы, асығыңыз!
Dialogue: 0,0:52:39.61,0:52:41.95,Default,,0,0,0,,Иә, сэр. Жүк командасы, асығыңыз!
Dialogue: 0,0:52:43.92,0:52:46.46,Default-ja,,0,0,0,,Кяаа... Тэ!
Dialogue: 0,0:52:45.91,0:52:46.74,Default,,0,0,0,,Тэ!
Dialogue: 0,0:52:48.03,0:52:49.12,Default,,0,0,0,,Түн
Dialogue: 0,0:52:48.19,0:52:48.89,Default-ja,,0,0,0,,Асығыңыз!
Dialogue: 0,0:52:53.16,0:52:56.37,Default-ja,,0,0,0,,(Зурудың ауыр тыныс алуы)
Dialogue: 0,0:52:56.47,0:52:58.17,Default-ja,,0,0,0,,Жою жүйесі! Сонша...
Dialogue: 0,0:52:56.54,0:52:58.21,Default,,0,0,0,,Жоюшылар! Сонша көп.
Dialogue: 0,0:52:59.60,0:53:00.47,Default-ja,,0,0,0,,Тэ!
Dialogue: 0,0:52:59.63,0:53:00.46,Default,,0,0,0,,Тэ!
Dialogue: 0,0:53:00.91,0:53:03.68,Default-ja,,0,0,0,,Жүгіңді алып кел! Бірақ...
Dialogue: 0,0:53:00.96,0:53:02.42,Default,,0,0,0,,Пакетіңді ұмыт, кел!
Dialogue: 0,0:53:02.92,0:53:03.76,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:53:06.61,0:53:07.48,Default-ja,,0,0,0,,Тэ!
Dialogue: 0,0:53:06.64,0:53:08.60,Default,,0,0,0,,-Тэ! -Зуру!
Dialogue: 0,0:53:07.75,0:53:09.92,Default-ja,,0,0,0,,Зуру! тез
Dialogue: 0,0:53:08.68,0:53:09.60,Default,,0,0,0,,Түн
Dialogue: 0,0:53:25.80,0:53:26.80,Default-ja,,0,0,0,,Бұл келе жатыр...
Dialogue: 0,0:53:25.86,0:53:26.74,Default,,0,0,0,,Міне, олар келді.
Dialogue: 0,0:53:30.77,0:53:32.47,Default-ja,,0,0,0,,Сурет салған соң
Dialogue: 0,0:53:30.95,0:53:32.25,Default,,0,0,0,,Алдымен оларды қызықтырыңыз.
Dialogue: 0,0:53:33.94,0:53:34.81,Default-ja,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:53:34.00,0:53:34.83,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:53:38.68,0:53:41.81,Default-ja,,0,0,0,,(Зурудың ауыр тыныс алуы)
Dialogue: 0,0:53:47.72,0:53:48.59,Default-ja,,0,0,0,,Ха!
Dialogue: 0,0:53:52.14,0:53:53.14,Default,,0,0,0,,Cibo!
Dialogue: 0,0:53:52.26,0:53:52.92,Default-ja,,0,0,0,,Шибо мырза!
Dialogue: 0,0:54:00.57,0:54:01.40,Default,,0,0,0,,Шегін!
Dialogue: 0,0:54:00.60,0:54:01.47,Default-ja,,0,0,0,,Артқа кет!
Dialogue: 0,0:54:14.25,0:54:18.82,Default-ja,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:54:35.73,0:54:37.39,Default,,0,0,0,,Керемет.
Dialogue: 0,0:54:35.77,0:54:37.40,Default-ja,,0,0,0,,Уау...
Dialogue: 0,0:54:39.40,0:54:40.23,Default,,0,0,0,,Біз барамыз!
Dialogue: 0,0:54:39.40,0:54:40.44,Default-ja,,0,0,0,,Ол төмендейді!
Dialogue: 0,0:54:50.41,0:54:51.28,Default,,0,0,0,,Түн
Dialogue: 0,0:54:50.48,0:54:51.48,Default-ja,,0,0,0,,Асығыңыз!
Dialogue: 0,0:54:54.33,0:54:58.58,Default,,0,0,0,,Тэ! Сен мені ести аласың ба? Тэ! Тэ! Сен қайдасың?
Dialogue: 0,0:54:54.42,0:54:56.66,Default-ja,,0,0,0,,Тэ, сен мені естисің бе? Тэ!
Dialogue: 0,0:54:57.06,0:54:58.76,Default-ja,,0,0,0,,Тэ! қайда?
Dialogue: 0,0:54:59.32,0:55:02.83,Default-ja,,0,0,0,,Уф... уау! Қарғыс атқыр...
Dialogue: 0,0:55:03.83,0:55:05.36,Default-ja,,0,0,0,,Уау!
Dialogue: 0,0:55:05.56,0:55:06.53,Default-ja,,0,0,0,,Қат!
Dialogue: 0,0:55:05.59,0:55:06.63,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:55:10.80,0:55:11.67,Default-ja,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:55:12.07,0:55:14.57,Default-ja,,0,0,0,,Ацудзи! Сенімен бәрі жақсы ма? Менің аяғым...
Dialogue: 0,0:55:12.14,0:55:14.60,Default,,0,0,0,,-Ацудзи! Сенімен бәрі жақсы ма? -Менің аяғым.
Dialogue: 0,0:55:14.64,0:55:15.57,Default-ja,,0,0,0,,Тэ ше?
Dialogue: 0,0:55:14.68,0:55:15.56,Default,,0,0,0,,Тэ қайда?
Dialogue: 0,0:55:18.23,0:55:19.31,Default,,0,0,0,,Қайда?!
Dialogue: 0,0:55:18.58,0:55:19.61,Default-ja,,0,0,0,,Қайда!
Dialogue: 0,0:55:20.40,0:55:23.86,Default,,0,0,0,,Жоғарыда. Оны Exterminator басып қалды.
Dialogue: 0,0:55:20.48,0:55:23.88,Default-ja,,0,0,0,,Осыдан кейін... Мені қыру жүйесі басып қалды.
Dialogue: 0,0:55:23.95,0:55:24.82,Default-ja,,0,0,0,,Зуру!
Dialogue: 0,0:55:24.15,0:55:24.98,Default,,0,0,0,,Зуру!
Dialogue: 0,0:55:25.72,0:55:26.75,Default-ja,,0,0,0,,Зуру Жоқ!
Dialogue: 0,0:55:25.78,0:55:26.90,Default,,0,0,0,,Зуру! Жоқ!
Dialogue: 0,0:55:27.53,0:55:29.15,Default,,0,0,0,,Зуру! Зуру!
Dialogue: 0,0:55:27.55,0:55:29.55,Default-ja,,0,0,0,,Зуру! Зуру!
Dialogue: 0,0:55:29.95,0:55:30.82,Default-ja,,0,0,0,,Ах...
Dialogue: 0,0:55:31.72,0:55:34.46,Default-ja,,0,0,0,,(Тэнің қатты тыныс алуы)
Dialogue: 0,0:55:34.53,0:55:36.09,Default-ja,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:55:37.36,0:55:38.03,Default-ja,,0,0,0,,Тэ…
Dialogue: 0,0:55:37.37,0:55:39.37,Default,,0,0,0,,Тэ! Тэ!
Dialogue: 0,0:55:38.53,0:55:40.43,Default-ja,,0,0,0,,Тэ! Уф...
Dialogue: 0,0:55:43.70,0:55:46.34,Default-ja,,0,0,0,,Тэ... Жақсы.
Dialogue: 0,0:55:43.75,0:55:44.59,Default,,0,0,0,,Тэ.
Dialogue: 0,0:55:45.30,0:55:46.13,Default,,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:55:49.47,0:55:50.30,Default,,0,0,0,,Зуру.
Dialogue: 0,0:55:49.51,0:55:51.74,Default-ja,,0,0,0,,Зуру… Кешіріңіз.
Dialogue: 0,0:55:50.84,0:55:53.60,Default,,0,0,0,,Кешіріңіз, менде қазір бәрі жақсы.
Dialogue: 0,0:55:52.41,0:55:53.71,Default-ja,,0,0,0,,Мен қазір жақсымын
Dialogue: 0,0:56:01.44,0:56:03.35,Default,,0,0,0,,Тэ, жақсысың ба?
Dialogue: 0,0:56:01.52,0:56:03.05,Default-ja,,0,0,0,,Тэ, жақсысың ба!
Dialogue: 0,0:56:03.72,0:56:05.72,Default-ja,,0,0,0,,Ух... иә
Dialogue: 0,0:56:04.77,0:56:05.65,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:56:09.93,0:56:12.43,Default-ja,,0,0,0,,Тэ! Жақсы...
Dialogue: 0,0:56:10.03,0:56:10.86,Default,,0,0,0,,Тэ!
Dialogue: 0,0:56:11.65,0:56:12.49,Default,,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:56:14.10,0:56:17.00,Default-ja,,0,0,0,,Сонымен... соншалықты қисынсыз.
Dialogue: 0,0:56:14.20,0:56:16.83,Default,,0,0,0,,Аға, сен соншалықты абайсыз.
Dialogue: 0,0:56:18.07,0:56:18.94,Default-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:56:18.16,0:56:19.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:56:36.55,0:56:37.96,Default-ja,,0,0,0,,(Тэнің қатты тыныс алуы)
Dialogue: 0,0:56:38.02,0:56:40.06,Default-ja,,0,0,0,,Балалар, жарақаттарың жақсы ма?
Dialogue: 0,0:56:38.18,0:56:39.85,Default,,0,0,0,,Бәріңіз жақсы ма? Сіз зардап шеккен жоқсыз ба?
Dialogue: 0,0:56:40.16,0:56:41.69,Default-ja,,0,0,0,,Тэдің қолы сынған.
Dialogue: 0,0:56:40.23,0:56:41.81,Default,,0,0,0,,Тэдің қолы сынған.
Dialogue: 0,0:56:43.09,0:56:45.03,Default-ja,,0,0,0,,Тэ... Сіз қозғала аласыз ба?
Dialogue: 0,0:56:43.14,0:56:44.90,Default,,0,0,0,,Тэ, сен қозғала аласың ба?
Dialogue: 0,0:56:47.00,0:56:49.47,Default-ja,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:56:47.15,0:56:49.36,Default,,0,0,0,,-Жарайды, кеттік. -Иә, сэр.
Dialogue: 0,0:56:49.44,0:56:50.32,Default,,0,0,0,,Сибо қайда?
Dialogue: 0,0:56:49.53,0:56:50.64,Default-ja,,0,0,0,,Шибо мырза ше?
Dialogue: 0,0:56:50.87,0:56:52.87,Default-ja,,0,0,0,,Ол кісі аяқ астынан жаншылды.
Dialogue: 0,0:56:50.90,0:56:52.78,Default,,0,0,0,,Ол жаншылды.
Dialogue: 0,0:56:52.94,0:56:53.94,Default-ja,,0,0,0,,Иә?
Dialogue: 0,0:56:59.33,0:57:00.33,Default,,0,0,0,,Сақтандыру!
Dialogue: 0,0:56:59.44,0:57:00.61,Default-ja,,0,0,0,,Сақтандыру!
Dialogue: 0,0:57:01.45,0:57:03.37,Default,,0,0,0,,Олар әлі де айналып жүр.
Dialogue: 0,0:57:01.51,0:57:03.65,Default-ja,,0,0,0,,Мына жігіттер тағы да қызғаншақ!
Dialogue: 0,0:57:06.75,0:57:07.75,Default,,0,0,0,,Эй, Килли!
Dialogue: 0,0:57:06.75,0:57:07.92,Default-ja,,0,0,0,,Кириганей!
Dialogue: 0,0:57:08.82,0:57:11.76,Default-ja,,0,0,0,,Ей, сен мені сол қарумен атып таста!
Dialogue: 0,0:57:08.84,0:57:11.59,Default,,0,0,0,,Эй, сен! Бұл қаруды бұрыннан ат!
Dialogue: 0,0:57:14.19,0:57:17.83,Default-ja,,0,0,0,,Не... неге атпайсың?
Dialogue: 0,0:57:14.34,0:57:15.72,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:57:16.09,0:57:17.60,Default,,0,0,0,,Неге атпайсың?
Dialogue: 0,0:57:23.74,0:57:24.60,Default-ja,,0,0,0,,Ха…
Dialogue: 0,0:57:24.67,0:57:26.60,Default-ja,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:57:26.67,0:57:31.44,Default-ja,,0,0,0,,Сіз кешігіп қалдыңыз. Мен саған көмектесуге келдім, Кириха.
Dialogue: 0,0:57:26.69,0:57:27.81,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,0:57:29.19,0:57:31.15,Default,,0,0,0,,Мен сені құтқаруға келдім, Килли.
Dialogue: 0,0:57:33.68,0:57:35.98,Default-ja,,0,0,0,,(Барлығының таңқаларлық дауысы)
Dialogue: 0,0:57:36.48,0:57:38.75,Default-ja,,0,0,0,,А... кім?
Dialogue: 0,0:57:37.66,0:57:38.87,Default,,0,0,0,,Кім?
Dialogue: 0,0:57:39.45,0:57:40.41,Default,,0,0,0,,Cibo?
Dialogue: 0,0:57:39.45,0:57:40.65,Default-ja,,0,0,0,,Шибо мырза...?
Dialogue: 0,0:57:41.19,0:57:44.22,Default-ja,,0,0,0,,Бұл қапталған электрлік қорғаныс бар болғаны 30 секундқа жетеді.
Dialogue: 0,0:57:41.37,0:57:43.96,Default,,0,0,0,,Бұл тосқауыл жабыны бар болғаны 30 секундқа созылады.
Dialogue: 0,0:57:45.06,0:57:46.06,Default-ja,,0,0,0,,Жүгіру!
Dialogue: 0,0:57:45.12,0:57:45.96,Default,,0,0,0,,Жүгіру.
Dialogue: 0,0:57:50.34,0:57:51.17,Default,,0,0,0,,Жүгіру.
Dialogue: 0,0:57:50.46,0:57:51.13,Default-ja,,0,0,0,,Менің шын атым Джеймс Рэтли
Dialogue: 0,0:57:55.51,0:57:56.47,Default,,0,0,0,,Түн
Dialogue: 0,0:57:55.57,0:57:56.23,Default-ja,,0,0,0,,Жүгір!
Dialogue: 0,0:57:57.47,0:57:58.85,Default,,0,0,0,,Мен біттім.
Dialogue: 0,0:57:57.60,0:58:00.54,Default-ja,,0,0,0,,Менің енді қолымнан келмейді... Бар!
Dialogue: 0,0:57:59.43,0:58:00.51,Default,,0,0,0,,Сіз жалғастырыңыз.
Dialogue: 0,0:58:00.60,0:58:03.81,Default,,0,0,0,,Не айтып тұрсың, Ацудзи? Жүгір!
Dialogue: 0,0:58:00.64,0:58:04.01,Default-ja,,0,0,0,,Сіз не туралы айтып отырсыз? Атсуджи, дұрыс жүгір
Dialogue: 0,0:58:10.98,0:58:12.22,Default-ja,,0,0,0,,Мына көлікке мін!
Dialogue: 0,0:58:11.02,0:58:12.15,Default,,0,0,0,,Мына көлікке отырыңыз.
Dialogue: 0,0:58:13.44,0:58:14.40,Default,,0,0,0,,Түн
Dialogue: 0,0:58:13.52,0:58:14.19,Default-ja,,0,0,0,,Асығыңыз!
Dialogue: 0,0:58:22.09,0:58:23.96,Default-ja,,0,0,0,,Ол сынған жоқ па?
Dialogue: 0,0:58:22.12,0:58:23.75,Default,,0,0,0,,Ол сынған жоқ па?
Dialogue: 0,0:58:24.41,0:58:26.25,Default,,0,0,0,,Мен оны қазір жұмыс істеп жатырмын.
Dialogue: 0,0:58:24.50,0:58:26.06,Default-ja,,0,0,0,,Мен қазір қозғалуға тырысамын.
Dialogue: 0,0:58:33.87,0:58:34.84,Default-ja,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:58:33.96,0:58:35.84,Default,,0,0,0,,-Әлі бара алмаймыз ба? -Бір сәт күте тұрыңыз.
Dialogue: 0,0:58:34.94,0:58:36.01,Default-ja,,0,0,0,,Тағы біраз!
Dialogue: 0,0:58:37.28,0:58:38.14,Default-ja,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:58:37.43,0:58:38.34,Default,,0,0,0,,Міне.
Dialogue: 0,0:58:45.89,0:58:46.73,Default,,0,0,0,,Міне, кеттік.
Dialogue: 0,0:58:45.92,0:58:46.78,Default-ja,,0,0,0,,Барайық
Dialogue: 0,0:58:47.02,0:58:48.52,Default-ja,,0,0,0,,О... қозғалды!
Dialogue: 0,0:58:47.69,0:58:48.56,Default,,0,0,0,,Ол қозғалды!
Dialogue: 0,0:58:48.65,0:58:49.65,Default,,0,0,0,,Вент ашылғалы үш күн өтті
Dialogue: 0,0:58:48.82,0:58:50.02,Default-ja,,0,0,0,,Жақсы (соққы дыбысы)
Dialogue: 0,0:58:55.69,0:58:57.11,Default,,0,0,0,,Менің найзам бітті.
Dialogue: 0,0:58:55.73,0:58:57.20,Default-ja,,0,0,0,,Енді гарпун жоқ!
Dialogue: 0,0:58:57.57,0:58:58.91,Default,,0,0,0,,Менде екі қалды.
Dialogue: 0,0:58:57.60,0:58:58.80,Default-ja,,0,0,0,,Тағы екеуі бар!
Dialogue: 0,0:58:58.99,0:59:00.78,Default,,0,0,0,,Менде тағы біреуі бар.
Dialogue: 0,0:58:59.16,0:59:00.70,Default-ja,,0,0,0,,Менде бір ғана қалды.
Dialogue: 0,0:59:00.80,0:59:02.07,Default-ja,,0,0,0,,Менде екі!
Dialogue: 0,0:59:00.87,0:59:01.99,Default,,0,0,0,,Менде екі.
Dialogue: 0,0:59:02.23,0:59:03.60,Default-ja,,0,0,0,,Берілмеңіз!
Dialogue: 0,0:59:02.33,0:59:03.33,Default,,0,0,0,,Юкки жазалануы керек...
Dialogue: 0,0:59:05.10,0:59:05.97,Default-ja,,0,0,0,,Тұман шошқа
Dialogue: 0,0:59:05.12,0:59:08.79,Default,,0,0,0,,Килли, біз синтетикалық терминалды және барлығын алдық.
Dialogue: 0,0:59:06.27,0:59:09.54,Default-ja,,0,0,0,,Мен жалған құрылғыны алып үлгерсем де...
Dialogue: 0,0:59:09.46,0:59:10.38,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:59:09.61,0:59:10.74,Default-ja,,0,0,0,,Бұл Миками растағанының белгісі
Dialogue: 0,0:59:21.89,0:59:22.75,Default-ja,,0,0,0,,Уф...
Dialogue: 0,0:59:30.83,0:59:31.70,Default-ja,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:59:35.07,0:59:39.00,Default-ja,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:59:41.27,0:59:43.07,Default-ja,,0,0,0,,(Бәрінен таң қалған дауыстар)
Dialogue: 0,0:59:43.27,0:59:45.64,Default-ja,,0,0,0,,Уа... аа...
Dialogue: 0,0:59:52.35,0:59:54.99,Default-ja,,0,0,0,,Хааааааааааа... ух...
Dialogue: 0,0:59:55.84,0:59:56.67,Default,,0,0,0,,Килли.
Dialogue: 0,0:59:55.92,0:59:56.79,Default-ja,,0,0,0,,Тұман шошқа?
Dialogue: 0,0:59:57.76,0:59:58.76,Default-ja,,0,0,0,,Тұман шошқа!
Dialogue: 0,0:59:57.96,0:59:58.80,Default,,0,0,0,,Килли!
Dialogue: 0,1:00:02.99,1:00:07.13,Default-ja,,0,0,0,,(Тастаудың дөрекі тынысы)
Dialogue: 0,1:00:11.64,1:00:15.36,Default,,0,0,0,,Why is this guy so heavy?
Dialogue: 0,1:00:11.74,1:00:15.64,Default-ja,,0,0,0,,Why is it so heavy! Бұл жігіт...
Dialogue: 0,1:00:26.88,1:00:28.89,Default-ja,,0,0,0,,It's already a village!
Dialogue: 0,1:00:26.91,1:00:29.00,Default,,0,0,0,,-We're almost at the village. -Иә.
Dialogue: 0,1:00:29.54,1:00:30.50,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,1:00:29.62,1:00:30.66,Default-ja,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,1:00:31.19,1:00:32.06,Default-ja,,0,0,0,,Уайымдамаңыз...
Dialogue: 0,1:00:31.58,1:00:32.79,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,1:00:36.26,1:00:38.30,Default-ja,,0,0,0,,Ах, Тэ...
Dialogue: 0,1:00:37.42,1:00:38.30,Default,,0,0,0,,Тэ.
Dialogue: 0,1:00:43.80,1:00:45.97,Default,,0,0,0,,Олар қайтып келді! Поптар және басқалар!
Dialogue: 0,1:00:43.80,1:00:46.17,Default-ja,,0,0,0,,Мен қайтып келдім! Бұл қарттар.
Dialogue: 0,1:00:49.37,1:00:52.34,Default-ja,,0,0,0,,Hey, get the hoist out! Жүк түсіру уақыты келді
Dialogue: 0,1:00:49.43,1:00:52.19,Default,,0,0,0,,Hey, bring out the crane. Жүкті түсіру уақыты!
Dialogue: 0,1:01:05.72,1:01:08.36,Default-ja,,0,0,0,,Welcome back, welcome back, old man.
Dialogue: 0,1:01:05.74,1:01:06.78,Default,,0,0,0,,Қайтадан қош келдіңіз.
Dialogue: 0,1:01:06.87,1:01:08.58,Default,,0,0,0,,Welcome back, Pops.
Dialogue: 0,1:01:08.43,1:01:10.83,Default-ja,,0,0,0,,Қалай болды? Тамақ болды ма?
Dialogue: 0,1:01:08.66,1:01:10.83,Default,,0,0,0,,-Қалай өтті? - Тамақты таптың ба?
Dialogue: 0,1:01:10.90,1:01:13.30,Default-ja,,0,0,0,,Hey, take that thing downstairs.
Dialogue: 0,1:01:10.91,1:01:13.33,Default,,0,0,0,,Hey, take that down below.
Dialogue: 0,1:01:13.36,1:01:14.87,Default-ja,,0,0,0,,Иә, қария.
Dialogue: 0,1:01:13.41,1:01:14.75,Default,,0,0,0,,Иә, Поптар.
Dialogue: 0,1:01:16.07,1:01:18.34,Default-ja,,0,0,0,,Don't worry, I'll take you there.
Dialogue: 0,1:01:16.08,1:01:18.25,Default,,0,0,0,,Don't worry, I'll take her.
Dialogue: 0,1:01:18.40,1:01:19.27,Default-ja,,0,0,0,,Иә...
Dialogue: 0,1:01:18.67,1:01:21.01,Default,,0,0,0,,-Жарайды. - Олар жарақат алды.
Dialogue: 0,1:01:19.44,1:01:22.77,Default-ja,,0,0,0,,You have a wound on your hand. Bring me the Molecular Gumte!
Dialogue: 0,1:01:21.09,1:01:22.38,Default,,0,0,0,,Get the molecular tape!
Dialogue: 0,1:01:23.84,1:01:26.09,Default,,0,0,0,,Ол өте үлкен қыз.
Dialogue: 0,1:01:23.84,1:01:25.98,Default-ja,,0,0,0,,Қандай үлкен қыз?
Dialogue: 0,1:01:26.04,1:01:29.78,Default-ja,,0,0,0,,Is this… that monster-like person?
Dialogue: 0,1:01:26.18,1:01:29.68,Default,,0,0,0,,Бұрын мәйітке ұқсаған адам осы ма?
Dialogue: 0,1:01:33.12,1:01:34.19,Default-ja,,0,0,0,,Ей, ей, ей! Бар дейсің бе? Қайда, нақты қай жерде?
Dialogue: 0,1:01:33.14,1:01:33.98,Default,,0,0,0,,Ол өлді ме?
Dialogue: 0,1:01:34.85,1:01:35.85,Default,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,1:01:34.89,1:01:36.15,Default-ja,,0,0,0,,Білмеймін.
Dialogue: 0,1:01:37.02,1:01:40.12,Default-ja,,0,0,0,,Баяу бұрылыңыз, бұл өте ауыр.
Dialogue: 0,1:01:37.06,1:01:38.56,Default,,0,0,0,,Оны баяу айналдырыңыз.
Dialogue: 0,1:01:38.65,1:01:39.94,Default,,0,0,0,,Бұл өте ауыр.
Dialogue: 0,1:01:41.16,1:01:42.33,Default-ja,,0,0,0,,Әй... иә?
Dialogue: 0,1:01:43.86,1:01:46.33,Default-ja,,0,0,0,,Уау! Хаа...
Dialogue: 0,1:01:47.33,1:01:50.90,Default-ja,,0,0,0,,Бұл қыздың керемет күші бар...
Dialogue: 0,1:01:47.49,1:01:50.99,Default,,0,0,0,,This girl sure is strong.
Dialogue: 0,1:01:57.38,1:02:00.28,Default-ja,,0,0,0,,Кириха жақсы, ұйықтап жатыр.
Dialogue: 0,1:01:57.46,1:02:00.13,Default,,0,0,0,,Килли жақсы. Ол жай ғана ұйықтап жатыр.
Dialogue: 0,1:02:02.95,1:02:05.15,Default-ja,,0,0,0,,Carry it to your room (Sutezo) Hey.
Dialogue: 0,1:02:02.96,1:02:04.09,Default,,0,0,0,,Оны ішке кіргізіңіз.
Dialogue: 0,1:02:04.47,1:02:05.34,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:02:27.61,1:02:30.95,Default,,0,0,0,,Осының барлығымен төрт-бес айға дейін жақсы болуымыз керек.
Dialogue: 0,1:02:27.81,1:02:30.31,Default-ja,,0,0,0,,Бар болғаны осы болса, 4-5 айға дейін жақсы боласыз.
Dialogue: 0,1:02:30.37,1:02:33.75,Default-ja,,0,0,0,,Құрал-жабдықтарды жинап, баруға тұрарлық болды.
Dialogue: 0,1:02:31.03,1:02:33.83,Default,,0,0,0,,Сонымен, барлық құрал-жабдықтарды жинаған жөн.
Dialogue: 0,1:02:33.81,1:02:36.15,Default-ja,,0,0,0,,Тойып жегеніме біраз болды.
Dialogue: 0,1:02:33.91,1:02:36.16,Default,,0,0,0,,Тойғанша жей аламыз!
Dialogue: 0,1:02:36.21,1:02:38.98,Default-ja,,0,0,0,,Соңында қанша адам қайтыс болды?
Dialogue: 0,1:02:36.25,1:02:38.96,Default,,0,0,0,,Барлығы нешеу өлді?
Dialogue: 0,1:02:39.04,1:02:41.46,Default,,0,0,0,,So, two more good workers died.
Dialogue: 0,1:02:39.05,1:02:41.89,Default-ja,,0,0,0,,Екі адам да өмірінің ең қызығында өлді ме?
Dialogue: 0,1:02:42.09,1:02:43.38,Default,,0,0,0,,Соңында!
Dialogue: 0,1:02:42.12,1:02:46.46,Default-ja,,0,0,0,,Мен тамақ пен ішімдік ішпегеніме көп болды.
Dialogue: 0,1:02:43.46,1:02:46.38,Default,,0,0,0,,Нағыз тамақ пен сусын!
Dialogue: 0,1:02:55.10,1:02:56.47,Default-ja,,0,0,0,,Жарықты азайтыңыз
Dialogue: 0,1:02:55.18,1:02:56.31,Default,,0,0,0,,Шамдарды өшіріңіз.
Dialogue: 0,1:03:01.11,1:03:05.81,Default-ja,,0,0,0,,Соңғы екі жылда қайтыс болғандардың барлығына арналған
Dialogue: 0,1:03:01.19,1:03:03.65,Default,,0,0,0,,Біз жоғалтқандардың барлығы үшін
Dialogue: 0,1:03:04.03,1:03:05.53,Default,,0,0,0,,соңғы екі жылда...
Dialogue: 0,1:03:07.11,1:03:08.15,Default,,0,0,0,,үнсіздік сәті.
Dialogue: 0,1:03:07.11,1:03:08.21,Default-ja,,0,0,0,,Тыныштық
Dialogue: 0,1:03:29.93,1:03:30.80,Default,,0,0,0,,Поп.
Dialogue: 0,1:03:30.03,1:03:31.04,Default-ja,,0,0,0,,Қария
Dialogue: 0,1:03:31.34,1:03:32.20,Default-ja,,0,0,0,,О
Dialogue: 0,1:03:31.39,1:03:32.22,Default,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,1:03:32.76,1:03:34.68,Default,,0,0,0,,Маған да тағы біреуін беріңізші.
Dialogue: 0,1:03:32.84,1:03:34.91,Default-ja,,0,0,0,,Маған да тағы бір сусын беріңіз.
Dialogue: 0,1:03:35.21,1:03:36.37,Default-ja,,0,0,0,,Тым көп ішіңіз
Dialogue: 0,1:03:35.22,1:03:36.56,Default,,0,0,0,,Сіз тым көп ішіп жатырсыз.
Dialogue: 0,1:03:37.28,1:03:38.48,Default-ja,,0,0,0,,Ішіңіз және ләззат алыңыз
Dialogue: 0,1:03:37.39,1:03:38.31,Default,,0,0,0,,Өйткені мен қалаймын.
Dialogue: 0,1:03:42.94,1:03:45.98,Default,,0,0,0,,Біз ақыры дұрыс жоқтауды аламыз.
Dialogue: 0,1:03:42.95,1:03:46.18,Default-ja,,0,0,0,,Мен ақыры жерлеу рәсімін өткізе алдым.
Dialogue: 0,1:03:46.35,1:03:50.96,Default-ja,,0,0,0,,А-а... Біраздан бері бұлай істеудің сәні болмады.
Dialogue: 0,1:03:46.48,1:03:47.40,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,1:03:47.99,1:03:51.03,Default,,0,0,0,,Біраз уақыттан бері біз мұны жасай алмадық.
Dialogue: 0,1:03:51.02,1:03:55.46,Default-ja,,0,0,0,,Ас алдық, ауыл аман қалды.
Dialogue: 0,1:03:51.11,1:03:55.41,Default,,0,0,0,,Бірақ қазір тамақ бар, ауыл аман қалды.
Dialogue: 0,1:03:56.23,1:03:58.83,Default-ja,,0,0,0,,Бірақ құрбандық керемет болды...
Dialogue: 0,1:03:56.29,1:03:58.87,Default,,0,0,0,,Бірақ жоғары бағамен.
Dialogue: 0,1:03:59.53,1:04:02.93,Default-ja,,0,0,0,,Біз бірнеше білікті телеграф балықшыларын жоғалттық.
Dialogue: 0,1:03:59.62,1:04:02.63,Default,,0,0,0,,Біз көптеген білікті Электр-балықшылардан айырылдық
Dialogue: 0,1:04:02.96,1:04:04.84,Default,,0,0,0,,және беріліс.
Dialogue: 0,1:04:03.00,1:04:05.07,Default-ja,,0,0,0,,Жабдықтардың саны да азайды.
Dialogue: 0,1:04:05.20,1:04:07.97,Default-ja,,0,0,0,,Сондай-ақ, сол автоматтандырылған зауыт.
Dialogue: 0,1:04:05.21,1:04:09.72,Default,,0,0,0,,Біз сол автоматтандырылған зауыт орнына қайта орала алмаймыз ба?
Dialogue: 0,1:04:08.04,1:04:09.51,Default-ja,,0,0,0,,Бару керек емес пе?
Dialogue: 0,1:04:09.80,1:04:11.80,Default,,0,0,0,,Онда сіз кез келген нәрсені жасай аласыз, солай ма?
Dialogue: 0,1:04:09.97,1:04:11.84,Default-ja,,0,0,0,,Сіз кез келген нәрсені жасай аласыз, солай ма?
Dialogue: 0,1:04:11.88,1:04:12.80,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,1:04:11.91,1:04:12.58,Default-ja,,0,0,0,,Жоқ…
Dialogue: 0,1:04:13.31,1:04:15.48,Default-ja,,0,0,0,,Енді ол жаққа қайту мүмкін емес.
Dialogue: 0,1:04:13.34,1:04:15.43,Default,,0,0,0,,Жоқ, біз ол жерге қайта орала алмаймыз.
Dialogue: 0,1:04:16.31,1:04:18.18,Default-ja,,0,0,0,,Көптеген жою жүйелері бар.
Dialogue: 0,1:04:16.39,1:04:18.22,Default,,0,0,0,,Ол Exterminators арқылы жүгіріп келеді.
Dialogue: 0,1:04:19.52,1:04:20.59,Default-ja,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:04:19.64,1:04:20.48,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,1:04:21.22,1:04:25.46,Default-ja,,0,0,0,,Сонда бұл тағам қанша уақытқа жетеді?
Dialogue: 0,1:04:21.27,1:04:25.52,Default,,0,0,0,,Сонымен... біз бұл тағамның қанша уақытқа созылатынын көруіміз керек.
Dialogue: 0,1:04:40.00,1:04:40.94,Default-ja,,0,0,0,,Тұман шошқа…
Dialogue: 0,1:04:40.16,1:04:41.00,Default,,0,0,0,,Килли.
Dialogue: 0,1:04:46.64,1:04:47.61,Default-ja,,0,0,0,,(күрсіну)
Dialogue: 0,1:04:48.96,1:04:51.09,Default,,0,0,0,,Ауыл құтқарылды дейді.
Dialogue: 0,1:04:49.18,1:04:51.25,Default-ja,,0,0,0,,Ауыл құтқарылды.
Dialogue: 0,1:04:51.84,1:04:53.18,Default,,0,0,0,,Барлығы шынымен бақытты.
Dialogue: 0,1:04:51.95,1:04:53.48,Default-ja,,0,0,0,,Барлығы бақытты
Dialogue: 0,1:04:55.22,1:04:59.06,Default-ja,,0,0,0,,Шибо мырзаның тәжірибесі сәтті болса
Dialogue: 0,1:04:55.26,1:04:58.64,Default,,0,0,0,,Егер Сибо тәжірибесі сәтті болса...
Dialogue: 0,1:04:59.59,1:05:01.33,Default-ja,,0,0,0,,Сонда да Кириха...
Dialogue: 0,1:04:59.72,1:05:01.02,Default,,0,0,0,,әлі де...
Dialogue: 0,1:05:01.66,1:05:03.66,Default-ja,,0,0,0,,Саяхатыңызды қайтадан жалғастырасыз ба?
Dialogue: 0,1:05:01.89,1:05:03.56,Default,,0,0,0,,саяхатыңды жалғастыр, Килли?
Dialogue: 0,1:05:17.34,1:05:19.41,Default-ja,,0,0,0,,Сәлем Кирибо
Dialogue: 0,1:05:17.37,1:05:19.20,Default,,0,0,0,,Сәлем, Килли.
Dialogue: 0,1:05:21.00,1:05:22.20,Default,,0,0,0,,Мүмкін...
Dialogue: 0,1:05:21.05,1:05:22.51,Default-ja,,0,0,0,,Қаласаңыз
Dialogue: 0,1:05:23.61,1:05:25.12,Default-ja,,0,0,0,,Әрқашан осында... (Есіктің ашылған дыбысы)
Dialogue: 0,1:05:23.75,1:05:24.92,Default,,0,0,0,,Сіз қала аласыз ба?
Dialogue: 0,1:05:28.29,1:05:29.92,Default-ja,,0,0,0,,Ах, Шибо-сан.
Dialogue: 0,1:05:28.75,1:05:29.63,Default,,0,0,0,,Cibo.
Dialogue: 0,1:05:36.09,1:05:36.93,Default,,0,0,0,,Килли.
Dialogue: 0,1:05:36.19,1:05:37.06,Default-ja,,0,0,0,,Тұман шошқа
Dialogue: 0,1:05:48.64,1:05:49.51,Default-ja,,0,0,0,,Бетперде…
Dialogue: 0,1:05:48.69,1:05:51.19,Default,,0,0,0,,Синтетикалық терминал.
Dialogue: 0,1:05:50.24,1:05:51.38,Default-ja,,0,0,0,,Терминал…
Dialogue: 0,1:05:52.99,1:05:57.03,Default,,0,0,0,,Мен оны қазір қосамын. Мен сіздің көмегіңізді қалайтын нәрсе бар.
Dialogue: 0,1:05:53.21,1:05:55.28,Default-ja,,0,0,0,,Оны қазір қосыңыз
Dialogue: 0,1:05:55.48,1:05:57.28,Default-ja,,0,0,0,,Маған бірдеңеде сенің көмегің керек.
Dialogue: 0,1:06:03.39,1:06:04.66,Default-ja,,0,0,0,,О... күте тұрыңыз.
Dialogue: 0,1:06:03.83,1:06:04.75,Default,,0,0,0,,Сен оларды сондай-ақ тастап жібересің.
Dialogue: 0,1:06:06.56,1:06:07.46,Default-ja,,0,0,0,,Ах...
Dialogue: 0,1:06:13.56,1:06:16.60,Default-ja,,0,0,0,,What are we going to do now? Қарт адам
Dialogue: 0,1:06:13.67,1:06:16.47,Default,,0,0,0,,What are we gonna do now, Pops?
Dialogue: 0,1:06:17.74,1:06:18.60,Default-ja,,0,0,0,,Хмм...
Dialogue: 0,1:06:19.47,1:06:23.56,Default,,0,0,0,,Now we just pray that Cibo's experiment works.
Dialogue: 0,1:06:19.47,1:06:23.74,Default-ja,,0,0,0,,All that's left to do now is hope that Shibo's experiment is a success.
Dialogue: 0,1:06:24.18,1:06:26.18,Default-ja,,0,0,0,,Then it's already a safeguard.
Dialogue: 0,1:06:24.18,1:06:28.81,Default,,0,0,0,,If it does, we won't have to live in fear of the Safeguard anymore.
Dialogue: 0,1:06:26.24,1:06:29.11,Default-ja,,0,0,0,,You don't have to live in fear. Жағдай жақсарады.
Dialogue: 0,1:06:31.02,1:06:33.32,Default,,0,0,0,,Менің басымды орап өте алмаймын.
Dialogue: 0,1:06:31.08,1:06:33.58,Default-ja,,0,0,0,,I just can't understand it.
Dialogue: 0,1:06:34.32,1:06:35.32,Default,,0,0,0,,Ненің айналасында?
Dialogue: 0,1:06:34.32,1:06:35.42,Default-ja,,0,0,0,,Бұл не?
Dialogue: 0,1:06:35.55,1:06:39.02,Default-ja,,0,0,0,,Humans connecting with machines...
Dialogue: 0,1:06:35.70,1:06:38.74,Default,,0,0,0,,The idea of humans connecting to machines.
Dialogue: 0,1:06:40.42,1:06:43.76,Default-ja,,0,0,0,,What do you mean... like this...
Dialogue: 0,1:06:40.62,1:06:43.91,Default,,0,0,0,,I mean, it's like...
Dialogue: 0,1:06:46.60,1:06:48.27,Default-ja,,0,0,0,,If the constructor or safeguard
Dialogue: 0,1:06:46.62,1:06:51.09,Default,,0,0,0,,They say the Builders and the Safeguard will do what the humans say.
Dialogue: 0,1:06:48.33,1:06:51.30,Default-ja,,0,0,0,,It moves according to human orders, right?
Dialogue: 0,1:06:52.17,1:06:53.50,Default,,0,0,0,,Бұл жақсы нәрсе, солай ма?
Dialogue: 0,1:06:52.20,1:06:53.74,Default-ja,,0,0,0,,Бұл жақсы нәрсе емес пе?
Dialogue: 0,1:07:00.21,1:07:01.65,Default-ja,,0,0,0,,Бұрынғы адамдар...
Dialogue: 0,1:07:00.22,1:07:04.60,Default,,0,0,0,,But why did people want to do that in the first place?
Dialogue: 0,1:07:02.35,1:07:04.45,Default-ja,,0,0,0,,Why did you decide to do that?
Dialogue: 0,1:07:05.78,1:07:07.69,Default-ja,,0,0,0,,I never said that.
Dialogue: 0,1:07:05.98,1:07:10.15,Default,,0,0,0,,I don't want to live long enough to find out.
Dialogue: 0,1:07:08.39,1:07:10.39,Default-ja,,0,0,0,,Менің тірі қалғым келмейді
Dialogue: 0,1:07:17.43,1:07:19.23,Default-ja,,0,0,0,,Мен көп жеймін.
Dialogue: 0,1:07:17.49,1:07:18.95,Default,,0,0,0,,You sure eat a lot.
Dialogue: 0,1:07:19.30,1:07:21.57,Default-ja,,0,0,0,,Well, Fusata did his best too.
Dialogue: 0,1:07:19.36,1:07:21.49,Default,,0,0,0,,Жарайды, сіз оны таптыңыз.
Dialogue: 0,1:07:21.63,1:07:24.74,Default-ja,,0,0,0,,А, жоқ... бұл менікі емес.
Dialogue: 0,1:07:22.74,1:07:24.58,Default,,0,0,0,,Жоқ, бұл мен үшін емес.
Dialogue: 0,1:07:25.16,1:07:27.33,Default,,0,0,0,,Мен Тэге апарайын деп ойладым.
Dialogue: 0,1:07:25.24,1:07:27.54,Default-ja,,0,0,0,,Мен оны Тэге апаруды ойладым...
Dialogue: 0,1:07:30.67,1:07:31.74,Default-ja,,0,0,0,,Ах~
Dialogue: 0,1:07:45.16,1:07:45.82,Default-ja,,0,0,0,,Иә?
Dialogue: 0,1:07:55.94,1:07:56.78,Default,,0,0,0,,Зуру.
Dialogue: 0,1:07:56.07,1:07:56.80,Default-ja,,0,0,0,,Зуру…
Dialogue: 0,1:08:37.15,1:08:40.15,Default,,0,0,0,,I won't be able to move while I'm connected.
Dialogue: 0,1:08:37.21,1:08:40.41,Default-ja,,0,0,0,,Қосылу Денемді қозғалта алмаймын
Dialogue: 0,1:08:44.28,1:08:47.28,Default,,0,0,0,,Мен сенің мені қорғағаныңды қалаймын.
Dialogue: 0,1:08:44.28,1:08:47.45,Default-ja,,0,0,0,,Осы арада мені қорғағаныңызды қалаймын.
Dialogue: 0,1:09:11.41,1:09:12.38,Default-ja,,0,0,0,,(күрсіну)
Dialogue: 0,1:09:12.44,1:09:14.25,Default-ja,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:09:14.48,1:09:16.31,Default-ja,,0,0,0,,Ах... қалдық
Dialogue: 0,1:09:14.56,1:09:16.06,Default,,0,0,0,,О, Сутезо.
Dialogue: 0,1:09:17.40,1:09:20.90,Default,,0,0,0,,Зуру, оянған сияқты.
Dialogue: 0,1:09:17.41,1:09:18.38,Default-ja,,0,0,0,,Зуру
Dialogue: 0,1:09:18.72,1:09:21.15,Default-ja,,0,0,0,,Ол оянған сияқты.
Dialogue: 0,1:09:22.22,1:09:22.92,Default-ja,,0,0,0,,Иә?
Dialogue: 0,1:09:23.52,1:09:25.86,Default-ja,,0,0,0,,Сен Кириханың орнында болдың... Зуру
Dialogue: 0,1:09:23.53,1:09:26.07,Default,,0,0,0,,Сіз Киллимен бірге болдыңыз, солай ма, Зуру?
Dialogue: 0,1:09:28.23,1:09:28.89,Default-ja,,0,0,0,,Иә...
Dialogue: 0,1:09:30.59,1:09:33.66,Default-ja,,0,0,0,,Сіз бірдеңе туралы айттыңыз ба?
Dialogue: 0,1:09:30.66,1:09:33.46,Default,,0,0,0,,Сіз онымен сөйлестіңіз бе?
Dialogue: 0,1:09:34.47,1:09:35.63,Default-ja,,0,0,0,,ештеңе
Dialogue: 0,1:09:34.54,1:09:35.46,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,1:09:35.77,1:09:37.94,Default-ja,,0,0,0,,Біз Отоишиден ақпарат алу үстіндеміз.
Dialogue: 0,1:09:37.17,1:09:38.13,Default,,0,0,0,,Та-да!
Dialogue: 0,1:09:40.60,1:09:41.54,Default-ja,,0,0,0,,Зуру!
Dialogue: 0,1:09:40.63,1:09:41.46,Default,,0,0,0,,Зуру!
Dialogue: 0,1:09:48.71,1:09:52.52,Default-ja,,0,0,0,,Иә? Ақсақал, маған көмектесе аласыз ба?
Dialogue: 0,1:09:48.72,1:09:50.43,Default,,0,0,0,,О, поптар.
Dialogue: 0,1:09:51.02,1:09:52.35,Default,,0,0,0,,Сіз көмектесуге келдіңіз бе?
Dialogue: 0,1:09:52.92,1:09:54.85,Default-ja,,0,0,0,,Мен аздап көп іштім
Dialogue: 0,1:09:53.02,1:09:54.81,Default,,0,0,0,,Менің ішуім тым көп болды.
Dialogue: 0,1:09:55.95,1:09:57.72,Default-ja,,0,0,0,,Бөлмеңізге қайтатын уақыт келді.
Dialogue: 0,1:09:56.06,1:09:58.02,Default,,0,0,0,,Мен мұны бөлмеме қайтып бара жатқанда апарамын.
Dialogue: 0,1:10:05.20,1:10:06.03,Default,,0,0,0,,Зуру.
Dialogue: 0,1:10:05.23,1:10:05.96,Default-ja,,0,0,0,,Зуру
Dialogue: 0,1:10:07.53,1:10:08.83,Default-ja,,0,0,0,,Күте тұрыңыз, Зуру!
Dialogue: 0,1:10:07.57,1:10:08.70,Default,,0,0,0,,Күте тұрыңыз, Зуру.
Dialogue: 0,1:10:11.70,1:10:12.57,Default-ja,,0,0,0,,Ах...
Dialogue: 0,1:10:15.37,1:10:18.21,Default,,0,0,0,,Бұл қалай өтті? Сіз оны бақытты еткеніңізге сенімдімін.
Dialogue: 0,1:10:15.44,1:10:17.98,Default-ja,,0,0,0,,Қалай болды? Тэ: сен бақытты болдың ғой, солай ма?
Dialogue: 0,1:10:19.41,1:10:20.48,Default-ja,,0,0,0,,Бөлмеңізге бармаңыз
Dialogue: 0,1:10:19.54,1:10:20.59,Default,,0,0,0,,Ол өз бөлмесінде жоқ.
Dialogue: 0,1:10:20.78,1:10:21.65,Default-ja,,0,0,0,,Иә?
Dialogue: 0,1:10:21.91,1:10:23.88,Default-ja,,0,0,0,,(металлдың соғылған дыбысы)
Dialogue: 0,1:10:30.22,1:10:30.89,Default-ja,,0,0,0,,Иә?
Dialogue: 0,1:10:31.89,1:10:32.76,Default-ja,,0,0,0,,Тэ?
Dialogue: 0,1:10:32.06,1:10:32.93,Default,,0,0,0,,Тэ?
Dialogue: 0,1:10:35.35,1:10:36.19,Default,,0,0,0,,Тэ?
Dialogue: 0,1:10:35.39,1:10:36.33,Default-ja,,0,0,0,,Тэ?
Dialogue: 0,1:10:36.49,1:10:38.33,Default-ja,,0,0,0,,Не болды? Тэ!
Dialogue: 0,1:10:36.64,1:10:38.31,Default,,0,0,0,,-Бұл не? -Тэ!
Dialogue: 0,1:10:55.48,1:10:56.45,Default-ja,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:11:04.30,1:11:06.59,Default,,0,0,0,,Тосқауыл генераторы бұзылған сияқты.
Dialogue: 0,1:11:04.39,1:11:06.49,Default-ja,,0,0,0,,Электрлік қорғаныс құрылғысы бұзылған сияқты.
Dialogue: 0,1:11:16.37,1:11:17.03,Default-ja,,0,0,0,,Тэ!
Dialogue: 0,1:11:16.39,1:11:17.23,Default,,0,0,0,,Тэ!
Dialogue: 0,1:11:17.94,1:11:19.35,Default,,0,0,0,,Саған не болды?
Dialogue: 0,1:11:17.97,1:11:20.77,Default-ja,,0,0,0,,Не болды... Тэ?
Dialogue: 0,1:11:19.98,1:11:20.81,Default,,0,0,0,,Тэ.
Dialogue: 0,1:11:21.04,1:11:22.77,Default-ja,,0,0,0,,Күте тұрыңыз! Барлығы аулақ жүр
Dialogue: 0,1:11:21.19,1:11:22.94,Default,,0,0,0,,Күте тұрыңыз! Жақын жүрме!
Dialogue: 0,1:11:22.94,1:11:25.31,Default-ja,,0,0,0,,Тэ... Тэ!
Dialogue: 0,1:11:23.02,1:11:23.86,Default,,0,0,0,,Тэ.
Dialogue: 0,1:11:24.32,1:11:26.07,Default,,0,0,0,,-Тэ. -Эй!
Dialogue: 0,1:11:31.38,1:11:32.05,Default-ja,,0,0,0,,Тэ…
Dialogue: 0,1:11:31.41,1:11:32.24,Default,,0,0,0,,Тэ.
Dialogue: 0,1:11:32.38,1:11:33.52,Default-ja,,0,0,0,,Иә! Ах!
Dialogue: 0,1:11:34.39,1:11:35.35,Default-ja,,0,0,0,,Ха...! Қарғыс атқыр...
Dialogue: 0,1:11:35.85,1:11:38.39,Default-ja,,0,0,0,,Гуаа! Уф...
Dialogue: 0,1:11:38.46,1:11:39.32,Default-ja,,0,0,0,,Қария!
Dialogue: 0,1:11:38.91,1:11:39.96,Default,,0,0,0,,Поп!
Dialogue: 0,1:11:44.56,1:11:45.86,Default-ja,,0,0,0,,Фусата!
Dialogue: 0,1:11:44.71,1:11:46.63,Default,,0,0,0,,Фусата! Онда тұрыңыз!
Dialogue: 0,1:11:46.76,1:11:48.83,Default-ja,,0,0,0,,Тэ… Тэ…
Dialogue: 0,1:11:47.01,1:11:49.01,Default,,0,0,0,,Тэ. Тэ!
Dialogue: 0,1:11:49.97,1:11:52.84,Default-ja,,0,0,0,,Тэ! Тэ!
Dialogue: 0,1:11:50.01,1:11:52.89,Default,,0,0,0,,Тэ! Тэ!
Dialogue: 0,1:11:57.31,1:11:59.69,Default,,0,0,0,,Жоқ! Оян!
Dialogue: 0,1:11:57.37,1:11:59.58,Default-ja,,0,0,0,,Шиге! Жоқ, оян!
Dialogue: 0,1:11:59.84,1:12:00.71,Default-ja,,0,0,0,,Ах...
Dialogue: 0,1:12:07.72,1:12:08.59,Default-ja,,0,0,0,,Уау!
Dialogue: 0,1:12:16.89,1:12:17.80,Default-ja,,0,0,0,,Тэ!
Dialogue: 0,1:12:16.95,1:12:17.79,Default,,0,0,0,,Тэ!
Dialogue: 0,1:12:39.60,1:12:40.85,Default,,0,0,0,,Мен Сана-канмын.
Dialogue: 0,1:12:39.62,1:12:41.02,Default-ja,,0,0,0,,Мен Санаканмын
Dialogue: 0,1:12:41.72,1:12:43.89,Default-ja,,0,0,0,,Прокси құрылымдарын қорғау
Dialogue: 0,1:12:41.81,1:12:43.73,Default,,0,0,0,,Қорғаныс құралының репрезентативті құрылымы.
Dialogue: 0,1:12:44.92,1:12:47.69,Default-ja,,0,0,0,,Біз, кепілдіктер, алып тастаймыз
Dialogue: 0,1:12:44.98,1:12:47.69,Default,,0,0,0,,Біз, қорғаушы, жоямыз
Dialogue: 0,1:12:48.09,1:12:52.10,Default-ja,,0,0,0,,Сіз Интернет терминалы гені жоқ заңсыз тұрғындарсыз.
Dialogue: 0,1:12:48.19,1:12:52.32,Default,,0,0,0,,Net Terminal гені жоқ барлық заңсыз тұрғындар.
Dialogue: 0,1:12:52.40,1:12:54.78,Default,,0,0,0,,-Тэ! Саған не болды?! -Фусата!
Dialogue: 0,1:12:52.46,1:12:53.73,Default-ja,,0,0,0,,Тэ! Не болды?
Dialogue: 0,1:12:53.80,1:12:54.67,Default-ja,,0,0,0,,Фусата!
Dialogue: 0,1:12:56.10,1:12:57.53,Default-ja,,0,0,0,,Қорғау?
Dialogue: 0,1:12:56.24,1:12:57.58,Default,,0,0,0,,Сақтандыру құралы?
Dialogue: 0,1:12:57.60,1:12:59.54,Default-ja,,0,0,0,,Тэ! Фусата жүр!
Dialogue: 0,1:12:57.66,1:12:58.49,Default,,0,0,0,,Тэ!
Dialogue: 0,1:12:58.58,1:12:59.62,Default,,0,0,0,,Фусата! Кәне!
Dialogue: 0,1:13:02.77,1:13:03.64,Default-ja,,0,0,0,,Қауіпті!
Dialogue: 0,1:13:02.92,1:13:03.75,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,1:13:04.78,1:13:05.84,Default-ja,,0,0,0,,Маған жауап бер.
Dialogue: 0,1:13:15.59,1:13:16.43,Default,,0,0,0,,Фусата!
Dialogue: 0,1:13:15.72,1:13:17.59,Default-ja,,0,0,0,,Фусата! (Сутезо) Зуру Жүр!
Dialogue: 0,1:13:16.68,1:13:17.68,Default,,0,0,0,,Зуру, жасама!
Dialogue: 0,1:13:22.81,1:13:23.81,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:13:22.86,1:13:24.73,Default-ja,,0,0,0,,Не? Не болды?
Dialogue: 0,1:13:23.89,1:13:24.73,Default,,0,0,0,,Жарылыс!
Dialogue: 0,1:13:24.80,1:13:27.06,Default-ja,,0,0,0,,Жарылыс! Не... не болды?
Dialogue: 0,1:13:24.81,1:13:25.69,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:13:26.27,1:13:27.27,Default,,0,0,0,,Не болды?
Dialogue: 0,1:13:37.11,1:13:40.08,Default-ja,,0,0,0,,(Абыржыған ауыл тұрғындарының дауысы)
Dialogue: 0,1:13:41.66,1:13:43.41,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:13:41.81,1:13:43.18,Default-ja,,0,0,0,,Бұл не сұмдық?!
Dialogue: 0,1:13:43.48,1:13:44.15,Default-ja,,0,0,0,,Кя!
Dialogue: 0,1:13:46.45,1:13:50.72,Default-ja,,0,0,0,,(Мылтық дыбыстары және қашып бара жатқан ауыл тұрғындарының дауыстары)
Dialogue: 0,1:13:55.51,1:13:59.10,Default,,0,0,0,,Заңсыз тұрғындардың рұқсат етілмеген үйлеріне сәтті ену.
Dialogue: 0,1:13:55.53,1:13:58.83,Default-ja,,0,0,0,,Заңсыз тұрғынның заңсыз ұзартылуына сәтті қол сұқты...
Dialogue: 0,1:13:59.10,1:14:00.86,Default-ja,,0,0,0,,Электрлік қорғаныс құралдарын бұзу
Dialogue: 0,1:13:59.18,1:14:01.01,Default,,0,0,0,,Тосқауыл генераторы жойылды.
Dialogue: 0,1:14:01.06,1:14:04.20,Default-ja,,0,0,0,,Барлығын дереу құрту...
Dialogue: 0,1:14:01.10,1:14:04.10,Default,,0,0,0,,Толық жою жүріп жатыр.
Dialogue: 0,1:14:04.69,1:14:06.52,Default,,0,0,0,,Заңсыз тұрғындардың сәтті енуі...
Dialogue: 0,1:14:08.73,1:14:09.57,Default,,0,0,0,,Мен сенің дірілдеп тұрған жеріңе асығып барамын
Dialogue: 0,1:14:08.77,1:14:09.74,Default-ja,,0,0,0,,Бұл...
Dialogue: 0,1:14:10.61,1:14:13.65,Default,,0,0,0,,Кедергіден өту үшін өзін адам ретінде көрсету.
Dialogue: 0,1:14:10.67,1:14:13.84,Default-ja,,0,0,0,,Біреудің адам болып көрінуі және қолданылатын электр қорғанысын бұзуы мүмкін емес...
Dialogue: 0,1:14:15.48,1:14:17.58,Default-ja,,0,0,0,,Бұл жоғары деңгейдегі қорғаныс.
Dialogue: 0,1:14:15.61,1:14:17.66,Default,,0,0,0,,Бұл жоғары деңгейдегі қорғаныс, Килли.
Dialogue: 0,1:14:18.85,1:14:20.72,Default-ja,,0,0,0,,Асыққан дұрыс сияқты.
Dialogue: 0,1:14:18.91,1:14:20.45,Default,,0,0,0,,Бізге асығу керек сияқты.
Dialogue: 0,1:14:32.50,1:14:33.46,Default,,0,0,0,,Килли!
Dialogue: 0,1:14:32.70,1:14:33.56,Default-ja,,0,0,0,,Тұман шошқа!
Dialogue: 0,1:14:59.74,1:15:00.66,Default,,0,0,0,,Фусата!
Dialogue: 0,1:14:59.79,1:15:00.66,Default-ja,,0,0,0,,Фусата!
Dialogue: 0,1:15:01.07,1:15:02.83,Default,,0,0,0,,Фусата, осылай!
Dialogue: 0,1:15:01.26,1:15:02.83,Default-ja,,0,0,0,,Фусата! Осы жолмен...
Dialogue: 0,1:15:03.62,1:15:04.66,Default,,0,0,0,,Тэ.
Dialogue: 0,1:15:04.75,1:15:05.62,Default,,0,0,0,,Тэ.
Dialogue: 0,1:15:04.80,1:15:05.66,Default-ja,,0,0,0,,Тэ…
Dialogue: 0,1:15:06.73,1:15:07.60,Default-ja,,0,0,0,,Уф...!
Dialogue: 0,1:15:06.79,1:15:07.62,Default,,0,0,0,,Тэ.
Dialogue: 0,1:15:08.03,1:15:10.67,Default-ja,,0,0,0,,Тэ... Тэ... Уф...!
Dialogue: 0,1:15:08.12,1:15:10.83,Default,,0,0,0,,Тэ. Тэ.
Dialogue: 0,1:15:11.71,1:15:12.54,Default,,0,0,0,,Тэ.
Dialogue: 0,1:15:11.74,1:15:12.67,Default-ja,,0,0,0,,Tae…
Dialogue: 0,1:15:16.24,1:15:17.14,Default-ja,,0,0,0,,Мм!
Dialogue: 0,1:15:56.05,1:15:58.58,Default-ja,,0,0,0,,5-бапқа сәйкес алып тастау туралы қаулы
Dialogue: 0,1:15:56.09,1:15:58.26,Default,,0,0,0,,Жою туралы 5 бұйрығына сәйкес,
Dialogue: 0,1:15:58.63,1:16:00.22,Default,,0,0,0,,көмекші жою.
Dialogue: 0,1:15:58.72,1:16:00.22,Default-ja,,0,0,0,,Көмекші алып тастауды бастау
Dialogue: 0,1:16:02.69,1:16:05.09,Default-ja,,0,0,0,,(Ауыл тұрғындарының айқайы)
Dialogue: 0,1:16:10.73,1:16:13.19,Default,,0,0,0,,Қарғыс атсын! Біздің ауыл.
Dialogue: 0,1:16:10.76,1:16:13.30,Default-ja,,0,0,0,,Тәтті, біздің ауыл...
Dialogue: 0,1:16:13.70,1:16:14.87,Default-ja,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:16:14.93,1:16:16.63,Default-ja,,0,0,0,,Қария!
Dialogue: 0,1:16:15.19,1:16:16.61,Default,,0,0,0,,Поп!
Dialogue: 0,1:16:16.93,1:16:17.97,Default-ja,,0,0,0,,Менде бәрі жақсы...
Dialogue: 0,1:16:16.94,1:16:19.36,Default,,0,0,0,,Мен үшін алаңдама. Алға.
Dialogue: 0,1:16:18.24,1:16:20.27,Default-ja,,0,0,0,,Алға, қария!
Dialogue: 0,1:16:19.44,1:16:20.28,Default,,0,0,0,,Поп.
Dialogue: 0,1:16:22.34,1:16:23.71,Default-ja,,0,0,0,,Тыңда, бұл босқа...
Dialogue: 0,1:16:22.41,1:16:23.95,Default,,0,0,0,,Тыңда, Сутезо.
Dialogue: 0,1:16:23.94,1:16:26.34,Default-ja,,0,0,0,,Барлығын жинап, мұнараға көтеріліңіз...
Dialogue: 0,1:16:24.03,1:16:26.49,Default,,0,0,0,,Барлығын жинап, мұнараға көтеріліңіз.
Dialogue: 0,1:16:26.58,1:16:28.41,Default,,0,0,0,,Мұнараның басынан кері оқ.
Dialogue: 0,1:16:26.68,1:16:28.65,Default-ja,,0,0,0,,Мені мұнараның үстінде қарсы алыңыздар!
Dialogue: 0,1:16:31.98,1:16:32.85,Default-ja,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,1:16:32.00,1:16:32.83,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:16:33.98,1:16:35.12,Default-ja,,0,0,0,,Қарияны сұра!
Dialogue: 0,1:16:34.25,1:16:35.79,Default,,0,0,0,,- Поптарға қамқорлық жасаңыз. -Мен аламын.
Dialogue: 0,1:16:38.80,1:16:40.01,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,1:16:38.86,1:16:41.26,Default-ja,,0,0,0,,Асығыңыз! Алдымен барайық!
Dialogue: 0,1:16:40.09,1:16:41.13,Default,,0,0,0,,Мен бірінші барамын!
Dialogue: 0,1:16:41.68,1:16:42.80,Default,,0,0,0,,Балалар, асығыңыздар!
Dialogue: 0,1:16:41.76,1:16:42.99,Default-ja,,0,0,0,,Асығыңыздар, балалар!
Dialogue: 0,1:16:45.33,1:16:46.33,Default-ja,,0,0,0,,Фусата!
Dialogue: 0,1:16:45.72,1:16:48.22,Default,,0,0,0,,Фусата! Құралдарыңызды киіңіз!
Dialogue: 0,1:16:46.63,1:16:48.00,Default-ja,,0,0,0,,Құрал!
Dialogue: 0,1:16:49.37,1:16:53.04,Default-ja,,0,0,0,,Ей, енді дулыға жоқ! Олардың саны жеткіліксіз.
Dialogue: 0,1:16:49.39,1:16:51.89,Default,,0,0,0,,Енді дулығалар жоқ!
Dialogue: 0,1:16:51.98,1:16:53.48,Default,,0,0,0,,Бізге жетпейді!
Dialogue: 0,1:16:53.10,1:16:53.97,Default-ja,,0,0,0,,Кешір… (Иура) Қайдағы жоқ.
Dialogue: 0,1:16:56.97,1:16:58.24,Default-ja,,0,0,0,,Зуру э...
Dialogue: 0,1:16:56.98,1:16:59.69,Default,,0,0,0,,Зуру... міне.
Dialogue: 0,1:16:58.98,1:16:59.91,Default-ja,,0,0,0,,Қараңыз
Dialogue: 0,1:17:02.18,1:17:03.68,Default-ja,,0,0,0,,Иә, бірақ...
Dialogue: 0,1:17:02.78,1:17:03.66,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,1:17:05.28,1:17:06.65,Default-ja,,0,0,0,,Жою…
Dialogue: 0,1:17:05.45,1:17:06.33,Default,,0,0,0,,Сутезо.
Dialogue: 0,1:17:17.75,1:17:20.84,Default,,0,0,0,,-Онда, оларды кіргізбе! -Қарғыс атсын, олар келе береді!
Dialogue: 0,1:17:18.00,1:17:20.80,Default-ja,,0,0,0,,Міне! Қарғыс атсын, мен мұны істей алмаймын!
Dialogue: 0,1:17:40.82,1:17:43.19,Default-ja,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:18:00.94,1:18:03.74,Default-ja,,0,0,0,,Хаа... Жақсы көрінеді.
Dialogue: 0,1:18:02.38,1:18:03.42,Default,,0,0,0,,Жақсы көрінеді.
Dialogue: 0,1:19:07.27,1:19:09.11,Default-ja,,0,0,0,,А... не болып жатыр?
Dialogue: 0,1:19:07.99,1:19:09.24,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:19:09.32,1:19:10.45,Default,,0,0,0,,Зуру?
Dialogue: 0,1:19:09.51,1:19:10.37,Default-ja,,0,0,0,,Зуру…
Dialogue: 0,1:19:11.44,1:19:13.38,Default-ja,,0,0,0,,Тэ қайда кетті?
Dialogue: 0,1:19:11.53,1:19:13.16,Default,,0,0,0,,Тэ қайда кетті?
Dialogue: 0,1:19:15.98,1:19:19.75,Default-ja,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:19:19.82,1:19:22.15,Default-ja,,0,0,0,,Ол қорғаныспен ауыстырылды.
Dialogue: 0,1:19:19.88,1:19:21.88,Default,,0,0,0,,Оны қорғаушы ауыстырды.
Dialogue: 0,1:19:23.09,1:19:24.71,Default,,0,0,0,,Оның енді тірі қалуы мүмкін емес.
Dialogue: 0,1:19:23.19,1:19:24.49,Default-ja,,0,0,0,,Енді өмір сүрме...
Dialogue: 0,1:19:27.29,1:19:29.29,Default-ja,,0,0,0,,А... Түсіндім...
Dialogue: 0,1:19:28.38,1:19:29.22,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,1:19:30.46,1:19:31.36,Default-ja,,0,0,0,,Тэ...
Dialogue: 0,1:19:30.59,1:19:31.47,Default,,0,0,0,,Тэ.
Dialogue: 0,1:19:32.33,1:19:33.93,Default-ja,,0,0,0,,Тэ өлмейді...
Dialogue: 0,1:19:32.39,1:19:34.06,Default,,0,0,0,,Тэ өлген болуы мүмкін емес!
Dialogue: 0,1:19:34.77,1:19:35.60,Default,,0,0,0,,Фусата!
Dialogue: 0,1:19:34.83,1:19:35.53,Default-ja,,0,0,0,,Фусата!
Dialogue: 0,1:19:39.44,1:19:40.84,Default-ja,,0,0,0,,Мен бірінші барамын.
Dialogue: 0,1:19:39.48,1:19:40.52,Default,,0,0,0,,Мен алға барамын.
Dialogue: 0,1:19:46.24,1:19:47.31,Default-ja,,0,0,0,,Зуру…
Dialogue: 0,1:19:46.28,1:19:47.19,Default,,0,0,0,,Зуру.
Dialogue: 0,1:20:11.94,1:20:15.34,Default-ja,,0,0,0,,(Қалдықтардың дөрекі демі)
Dialogue: 0,1:20:20.51,1:20:21.38,Default-ja,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,1:20:21.06,1:20:22.15,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,1:20:27.28,1:20:28.36,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,1:20:27.38,1:20:28.42,Default-ja,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:20:29.36,1:20:31.24,Default,,0,0,0,,Мен сені жақыннан жарып жіберемін!
Dialogue: 0,1:20:29.45,1:20:31.12,Default-ja,,0,0,0,,Мен сені бүйірден көбірек ұрамын!
Dialogue: 0,1:20:36.16,1:20:37.03,Default-ja,,0,0,0,,Аһ!
Dialogue: 0,1:20:46.50,1:20:47.37,Default-ja,,0,0,0,,Ха!
Dialogue: 0,1:20:58.98,1:20:59.85,Default-ja,,0,0,0,,Ах!
Dialogue: 0,1:21:00.35,1:21:03.02,Default,,0,0,0,,Қарғыс атсын! Олар құбыжықтар ма?
Dialogue: 0,1:21:00.45,1:21:03.09,Default-ja,,0,0,0,,Шүкір... бұл жігіттер құбыжық!
Dialogue: 0,1:21:21.07,1:21:22.31,Default-ja,,0,0,0,,Уф!
Dialogue: 0,1:21:30.28,1:21:31.21,Default-ja,,0,0,0,,Тұман шошқа!
Dialogue: 0,1:21:30.34,1:21:31.17,Default,,0,0,0,,Килли!
Dialogue: 0,1:21:32.25,1:21:34.02,Default-ja,,0,0,0,,Зуру! Эй Зуру!
Dialogue: 0,1:21:32.30,1:21:34.09,Default,,0,0,0,,Зуру! Эй, Зуру!
Dialogue: 0,1:21:41.16,1:21:46.03,Default-ja,,0,0,0,,(Шибоның терең тыныс алуы)
Dialogue: 0,1:22:20.46,1:22:24.47,Default-ja,,0,0,0,,(Ауыл тұрғындарының ауыр тыныс алуы)
Dialogue: 0,1:22:26.07,1:22:28.44,Default-ja,,0,0,0,,Уау! Ахх...!
Dialogue: 0,1:22:36.99,1:22:40.78,Default,,0,0,0,,Тезірек, осында! Барлығы, тезірек мұнда тұрыңдар!
Dialogue: 0,1:22:37.08,1:22:40.68,Default-ja,,0,0,0,,Асығыңыз! Барлығы тездетіп жоғарыға көтеріліңдер!
Dialogue: 0,1:22:40.87,1:22:41.83,Default,,0,0,0,,Түн
Dialogue: 0,1:22:40.95,1:22:41.62,Default-ja,,0,0,0,,Асығыңыз!
Dialogue: 0,1:22:54.97,1:22:55.97,Default-ja,,0,0,0,,Уф...
Dialogue: 0,1:23:07.18,1:23:08.11,Default-ja,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,1:23:21.39,1:23:24.43,Default-ja,,0,0,0,,Алып тастау туралы қаулы 3-баптың 2-тармағына негізделген
Dialogue: 0,1:23:21.45,1:23:24.58,Default,,0,0,0,,Жою туралы 3-тармақтың 2-тармағына сәйкес,
Dialogue: 0,1:23:24.59,1:23:27.03,Default-ja,,0,0,0,,Жою деңгейі 3 деңгейге көтерілді
Dialogue: 0,1:23:24.66,1:23:26.87,Default,,0,0,0,,Жою деңгейі үшке көтерілді.
Dialogue: 0,1:23:27.33,1:23:30.46,Default,,0,0,0,,Гравитациялық сәуле шығарғышты пайдалану рұқсатын сұрау.
Dialogue: 0,1:23:27.40,1:23:30.53,Default-ja,,0,0,0,,Гравитондық сәуле шығаратын құрылғыны пайдалануды талап етеді
Dialogue: 0,1:23:49.14,1:23:52.56,Default,,0,0,0,,Сен бізден ұрланған денесің, Қорғаушы.
Dialogue: 0,1:23:49.15,1:23:51.29,Default-ja,,0,0,0,,Сіз біздің қорғауымыздансыз.
Dialogue: 0,1:23:51.35,1:23:52.79,Default-ja,,0,0,0,,Бұл ұрланған дене.
Dialogue: 0,1:23:54.76,1:23:56.39,Default-ja,,0,0,0,,Бастауыш дене…
Dialogue: 0,1:23:54.86,1:23:56.19,Default,,0,0,0,,Дене.
Dialogue: 0,1:23:57.26,1:23:58.76,Default-ja,,0,0,0,,Қайту ниетіңіз бар ма?
Dialogue: 0,1:23:57.32,1:23:58.61,Default,,0,0,0,,Сіз қайтып оралғыңыз келе ме?
Dialogue: 0,1:23:59.24,1:24:00.70,Default,,0,0,0,,Дереу жауап беріңіз.
Dialogue: 0,1:23:59.26,1:24:00.66,Default-ja,,0,0,0,,Дереу жауап беріңіз
Dialogue: 0,1:24:09.57,1:24:11.24,Default-ja,,0,0,0,,Жарлыққа сәйкес
Dialogue: 0,1:24:09.66,1:24:11.42,Default,,0,0,0,,Жарлыққа сәйкес...
Dialogue: 0,1:24:12.25,1:24:14.00,Default,,0,0,0,,Мен сені осында құртамын.
Dialogue: 0,1:24:12.31,1:24:14.18,Default-ja,,0,0,0,,Мен сені осы жерде құртамын.
Dialogue: 0,1:24:29.23,1:24:30.29,Default-ja,,0,0,0,,Маған жауап бер.
Dialogue: 0,1:24:36.80,1:24:39.27,Default-ja,,0,0,0,,NetSphere-ге заңсыз қосылымдарды анықтау
Dialogue: 0,1:24:36.90,1:24:39.36,Default,,0,0,0,,NetSphere жүйесіне рұқсатсыз қосылу анықталды.
Dialogue: 0,1:24:45.58,1:24:47.54,Default,,0,0,0,,Жою деңгейі екіге көтерілді.
Dialogue: 0,1:24:45.58,1:24:47.74,Default-ja,,0,0,0,,Жою деңгейі 2 деңгейге көтерілді
Dialogue: 0,1:24:48.58,1:24:51.58,Default-ja,,0,0,0,,(Қалдықтардың дөрекі демі)
Dialogue: 0,1:24:53.75,1:24:55.52,Default-ja,,0,0,0,,Маған рұқсат етіңіз!
Dialogue: 0,1:24:53.92,1:24:55.25,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,1:25:08.53,1:25:09.40,Default-ja,,0,0,0,,Бас тарту!
Dialogue: 0,1:25:08.97,1:25:10.10,Default,,0,0,0,,Сутезо!
Dialogue: 0,1:25:16.47,1:25:19.64,Default-ja,,0,0,0,,Ха! Қарғыс атсын... Киригири!
Dialogue: 0,1:25:19.23,1:25:20.40,Default,,0,0,0,,Килли!
Dialogue: 0,1:25:33.39,1:25:35.69,Default-ja,,0,0,0,,Мм... Кууу!
Dialogue: 0,1:26:00.22,1:26:00.88,Default-ja,,0,0,0,,Фу…
Dialogue: 0,1:26:20.64,1:26:22.41,Default-ja,,0,0,0,,Ах...
Dialogue: 0,1:27:02.75,1:27:07.75,Default-ja,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:27:17.76,1:27:21.46,Default-ja,,0,0,0,,(Айна шошқасының дөрекі тынысы)
Dialogue: 0,1:27:26.67,1:27:27.64,Default-ja,,0,0,0,,Уф...
Dialogue: 0,1:27:46.79,1:27:49.39,Default-ja,,0,0,0,,Жақсы мақсат қойыңыз! Тартыңыз және түсіріңіз!
Dialogue: 0,1:27:46.92,1:27:49.43,Default,,0,0,0,,Мұқият көздеңіз! Оларды азғырып, атып тастаңыз!
Dialogue: 0,1:27:59.44,1:28:02.02,Default,,0,0,0,,Біз мұны жасадық! Бұл соңғы болды!
Dialogue: 0,1:27:59.54,1:28:02.37,Default-ja,,0,0,0,,Мен жасадым! Бұл соңғы!
Dialogue: 0,1:28:02.84,1:28:04.84,Default-ja,,0,0,0,,(Ауыл тұрғындары қолдайды)
Dialogue: 0,1:28:04.91,1:28:05.78,Default-ja,,0,0,0,,(күрсіну)
Dialogue: 0,1:28:13.05,1:28:14.28,Default-ja,,0,0,0,,Tae…
Dialogue: 0,1:28:13.28,1:28:14.12,Default,,0,0,0,,Тэ.
Dialogue: 0,1:28:45.82,1:28:48.05,Default-ja,,0,0,0,,Ха! Амал жоқ...
Dialogue: 0,1:28:47.15,1:28:48.28,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:28:49.32,1:28:50.24,Default,,0,0,0,,Билік!
Dialogue: 0,1:28:49.35,1:28:50.49,Default-ja,,0,0,0,,Басқару бюросы!
Dialogue: 0,1:28:54.72,1:28:58.33,Default-ja,,0,0,0,,Бұл... желісфераның ішінде.
Dialogue: 0,1:28:54.74,1:28:57.91,Default,,0,0,0,,Бұл NetSphere ішінде болуы керек.
Dialogue: 0,1:29:01.46,1:29:06.70,Default-ja,,0,0,0,,Бұл Нетсфера мен негізгі шындықты байланыстыратын алдын ала электрондық салалардың бірі.
Dialogue: 0,1:29:01.62,1:29:04.46,Default,,0,0,0,,Бұл қосылатын резервтік электрондық дүниелердің бірі
Dialogue: 0,1:29:04.54,1:29:06.59,Default,,0,0,0,,шындықты негіздеу үшін NetSphere.
Dialogue: 0,1:29:07.38,1:29:08.21,Default,,0,0,0,,Резерв?
Dialogue: 0,1:29:07.40,1:29:08.10,Default-ja,,0,0,0,,Резерв…
Dialogue: 0,1:29:09.07,1:29:10.04,Default-ja,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,1:29:09.13,1:29:12.51,Default,,0,0,0,,Маған NetSphere-ге қосылуға рұқсат етіңіз.
Dialogue: 0,1:29:10.57,1:29:12.64,Default-ja,,0,0,0,,Netsphere желісіне қосылу
Dialogue: 0,1:29:13.08,1:29:16.01,Default-ja,,0,0,0,,Сіз пайдаланған интернет терминалының тиімділігі қандай?
Dialogue: 0,1:29:13.22,1:29:16.10,Default,,0,0,0,,Сіз пайдаланған желілік терминал
Dialogue: 0,1:29:16.08,1:29:17.85,Default-ja,,0,0,0,,жаңа ғана жоғалып кетті
Dialogue: 0,1:29:16.18,1:29:17.89,Default,,0,0,0,,енді ғана өзінің тиімділігін жоғалтты.
Dialogue: 0,1:29:17.91,1:29:18.98,Default-ja,,0,0,0,,Бұл...
Dialogue: 0,1:29:17.97,1:29:18.89,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,1:29:19.43,1:29:21.81,Default,,0,0,0,,Негізгі шындықтағы миыңызбен байланыс
Dialogue: 0,1:29:19.48,1:29:21.78,Default-ja,,0,0,0,,Негізгі шындықтағы миыңызбен
Dialogue: 0,1:29:21.85,1:29:25.59,Default-ja,,0,0,0,,Қосылым бірнеше наносекундта мәжбүрлі түрде ажыратылады.
Dialogue: 0,1:29:21.89,1:29:25.40,Default,,0,0,0,,да бірнеше наносекундта кесіледі.
Dialogue: 0,1:29:26.81,1:29:28.48,Default,,0,0,0,,Бірақ сізде әлі уақыт бар.
Dialogue: 0,1:29:26.82,1:29:28.59,Default-ja,,0,0,0,,Бірақ әлі уақыт бар
Dialogue: 0,1:29:29.44,1:29:31.57,Default,,0,0,0,,Мұнда резервтік әлемде уақыт жылдам
Dialogue: 0,1:29:29.46,1:29:31.56,Default-ja,,0,0,0,,Үдететін алдын ала электрон өрісінде
Dialogue: 0,1:29:31.63,1:29:34.83,Default-ja,,0,0,0,,Сіздің субъективті уақытыңыз салыстырмалы түрде кешіктірілді.
Dialogue: 0,1:29:31.65,1:29:34.99,Default,,0,0,0,,сондықтан сіздің салыстырмалы көзқарасыңыз бойынша уақыт ұзартылған сияқты.
Dialogue: 0,1:29:36.87,1:29:37.90,Default-ja,,0,0,0,,Кем дегенде...
Dialogue: 0,1:29:36.95,1:29:41.87,Default,,0,0,0,,Өтінемін, тым болмағанда сол ауылға сақшылардың шабуылын тоқтатыңыз.
Dialogue: 0,1:29:38.47,1:29:41.67,Default-ja,,0,0,0,,Осы ауылға қорғаныс шабуылын тоқтатыңыз.
Dialogue: 0,1:29:42.87,1:29:46.71,Default-ja,,0,0,0,,Интернет терминал гені бар біреуден тапсырыс болмаса.
Dialogue: 0,1:29:42.91,1:29:46.67,Default,,0,0,0,,Net Terminal Gene бар біреудің бұйрығынсыз,
Dialogue: 0,1:29:46.75,1:29:50.46,Default,,0,0,0,,біз, уәкілетті орган, мұндай әрекетті жасай алмаймыз.
Dialogue: 0,1:29:46.78,1:29:50.78,Default-ja,,0,0,0,,Біз, Басқару бюросы, мұндай әрекеттерді жасай алмаймыз.
Dialogue: 0,1:29:51.78,1:29:52.88,Default-ja,,0,0,0,,Дұрыс...
Dialogue: 0,1:29:51.88,1:29:52.88,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,1:29:53.72,1:29:56.82,Default-ja,,0,0,0,,Бірақ осы алдын ала электрондық өріс рұқсат еткен дәрежеде.
Dialogue: 0,1:29:53.80,1:29:56.93,Default,,0,0,0,,Дегенмен, осы резервтік электрондық әлемде қанша рұқсат етілсе,
Dialogue: 0,1:29:56.89,1:30:00.46,Default-ja,,0,0,0,,Қазіргі уақытта қорғау құралдарымен бақыланбайтын жою деңгейлерінің координаттары
Dialogue: 0,1:29:57.01,1:29:59.93,Default,,0,0,0,,Мен сізге қалдырылған деңгейлердің координаталарын айта аламын
Dialogue: 0,1:30:00.01,1:30:02.18,Default,,0,0,0,,қорғау құралы қазіргі уақытта бақыланбайды.
Dialogue: 0,1:30:00.52,1:30:02.06,Default-ja,,0,0,0,,Оқытуға болады
Dialogue: 0,1:30:08.65,1:30:09.48,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,1:30:08.70,1:30:09.60,Default-ja,,0,0,0,,Бұл не?
Dialogue: 0,1:30:10.40,1:30:13.82,Default,,0,0,0,,Ол осы жерге жақын деңгейлердің картасын сақтайды.
Dialogue: 0,1:30:10.43,1:30:13.94,Default-ja,,0,0,0,,Осы жердегі деңгейдің картасы сонда сақталған.
Dialogue: 0,1:30:14.74,1:30:18.66,Default,,0,0,0,,Біз бұл ақпаратты негізгі шындыққа айналдыра алмаймыз...
Dialogue: 0,1:30:14.74,1:30:18.91,Default-ja,,0,0,0,,Біз бұл ақпаратты негізгі шындыққа келтіре алмаймыз, бірақ...
Dialogue: 0,1:30:19.91,1:30:23.81,Default-ja,,0,0,0,,Құрылғыға кіруді тоқтатуға ешқандай тапсырыстар алынған жоқ.
Dialogue: 0,1:30:20.03,1:30:23.58,Default,,0,0,0,,бірақ бізде оған қосылуды тоқтататын ешқандай бұйрық жоқ.
Dialogue: 0,1:30:44.13,1:30:48.84,Default-ja,,0,0,0,,(Ауыл тұрғындарының сөйлеген дыбыстары)
Dialogue: 0,1:30:54.74,1:30:56.45,Default,,0,0,0,,Зардап шеккендерді сол жаққа апарыңыз!
Dialogue: 0,1:30:54.88,1:30:56.48,Default-ja,,0,0,0,,Зардап шеккендер сол жаққа барыңыз!
Dialogue: 0,1:30:56.53,1:30:57.91,Default,,0,0,0,,Біреу оларды тасымалдауға көмектеседі!
Dialogue: 0,1:30:56.55,1:30:57.78,Default-ja,,0,0,0,,Біреу мені алып кетсін!
Dialogue: 0,1:30:58.58,1:31:00.12,Default-ja,,0,0,0,,Ах...
Dialogue: 0,1:31:01.58,1:31:02.45,Default-ja,,0,0,0,,Ха…
Dialogue: 0,1:31:06.82,1:31:08.22,Default-ja,,0,0,0,,Тез, осы жаққа кел!
Dialogue: 0,1:31:06.87,1:31:08.42,Default,,0,0,0,,Тез, осында.
Dialogue: 0,1:31:08.49,1:31:10.09,Default-ja,,0,0,0,,Маған молекулалық гумте әкеліңіз!
Dialogue: 0,1:31:08.50,1:31:10.13,Default,,0,0,0,,Молекулярлық таспаны әкеліңіз!
Dialogue: 0,1:31:11.59,1:31:13.46,Default-ja,,0,0,0,,А, Фусата...
Dialogue: 0,1:31:12.50,1:31:13.46,Default,,0,0,0,,Фусата.
Dialogue: 0,1:31:18.10,1:31:20.57,Default-ja,,0,0,0,,Ал... мен оны айналдырамын ба?
Dialogue: 0,1:31:18.26,1:31:20.26,Default,,0,0,0,,Мен оны орап аламын ба?
Dialogue: 0,1:31:23.04,1:31:23.91,Default-ja,,0,0,0,,О
Dialogue: 0,1:31:23.22,1:31:24.06,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,1:31:30.21,1:31:31.51,Default-ja,,0,0,0,,Кири-сан
Dialogue: 0,1:31:30.35,1:31:31.19,Default,,0,0,0,,Килли.
Dialogue: 0,1:31:35.36,1:31:37.20,Default,,0,0,0,,Біз сенің арқаңда құтқарылдық.
Dialogue: 0,1:31:35.48,1:31:37.55,Default-ja,,0,0,0,,Сіздің арқаңызда мен құтқарылдым.
Dialogue: 0,1:31:39.02,1:31:41.22,Default-ja,,0,0,0,,Зуру Шибоға не болды?
Dialogue: 0,1:31:39.07,1:31:41.45,Default,,0,0,0,,Зуру, Сибоға не болды?
Dialogue: 0,1:31:42.96,1:31:43.99,Default-ja,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:31:42.99,1:31:43.95,Default,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,1:31:45.06,1:31:46.16,Default-ja,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:31:45.20,1:31:46.08,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,1:31:47.90,1:31:49.73,Default-ja,,0,0,0,,Енді бітті
Dialogue: 0,1:31:48.00,1:31:49.62,Default,,0,0,0,,Бәрі бітті.
Dialogue: 0,1:31:50.67,1:31:51.92,Default,,0,0,0,,Бас тартуға әлі ерте.
Dialogue: 0,1:31:50.67,1:31:51.77,Default-ja,,0,0,0,,Бас тартуға әлі ерте
Dialogue: 0,1:31:51.90,1:31:52.84,Default-ja,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:31:55.17,1:31:56.01,Default-ja,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:31:55.25,1:31:56.13,Default,,0,0,0,,Шынымен
Dialogue: 0,1:31:56.07,1:31:57.04,Default-ja,,0,0,0,,Ах...
Dialogue: 0,1:32:06.25,1:32:07.12,Default-ja,,0,0,0,,Астық
Dialogue: 0,1:32:06.47,1:32:07.31,Default,,0,0,0,,Cibo.
Dialogue: 0,1:32:07.88,1:32:08.75,Default-ja,,0,0,0,,Ах...
Dialogue: 0,1:32:11.25,1:32:12.56,Default-ja,,0,0,0,,Шибо мырза...?
Dialogue: 0,1:32:11.40,1:32:12.36,Default,,0,0,0,,Cibo!
Dialogue: 0,1:32:14.16,1:32:16.09,Default-ja,,0,0,0,,Менің миым қолымда.
Dialogue: 0,1:32:14.27,1:32:16.28,Default,,0,0,0,,Менің миым қолымда.
Dialogue: 0,1:32:18.49,1:32:20.82,Default,,0,0,0,,Бұл жерді күзетші анықтады.
Dialogue: 0,1:32:18.53,1:32:21.06,Default-ja,,0,0,0,,Бұл жерді қорғаушылар тапты.
Dialogue: 0,1:32:21.13,1:32:23.27,Default-ja,,0,0,0,,Жоюшы бір күні тағы шабуыл жасайды.
Dialogue: 0,1:32:21.16,1:32:23.41,Default,,0,0,0,,Ерте ме, кеш пе, жоюшылар қайтып келеді.
Dialogue: 0,1:32:23.49,1:32:25.24,Default,,0,0,0,,Сонда не істеуіміз керек?
Dialogue: 0,1:32:23.53,1:32:25.07,Default-ja,,0,0,0,,Не істеуім керек...
Dialogue: 0,1:32:26.17,1:32:29.64,Default-ja,,0,0,0,,Осы қабат пен төменгі қабат арасындағы саңылауда
Dialogue: 0,1:32:26.24,1:32:29.62,Default,,0,0,0,,Бұл деңгейдің арасында қалдырылған деңгей бар
Dialogue: 0,1:32:29.71,1:32:31.42,Default,,0,0,0,,және оның астындағы.
Dialogue: 0,1:32:29.74,1:32:31.21,Default-ja,,0,0,0,,Қараусыз қалған қабат бар.
Dialogue: 0,1:32:33.31,1:32:35.31,Default-ja,,0,0,0,,Осы жерден солтүстікке
Dialogue: 0,1:32:33.38,1:32:35.29,Default,,0,0,0,,Оған төмендеу жолы бар
Dialogue: 0,1:32:35.75,1:32:38.17,Default,,0,0,0,,осы жерден солтүстікке қарай.
Dialogue: 0,1:32:35.78,1:32:38.05,Default-ja,,0,0,0,,Кіреберіске апаратын көтерілу және төмендеу жолы бар ма?
Dialogue: 0,1:32:38.11,1:32:38.98,Default-ja,,0,0,0,,А...?
Dialogue: 0,1:32:40.68,1:32:42.39,Default,,0,0,0,,Қалдырылған деңгей.
Dialogue: 0,1:32:40.72,1:32:42.75,Default-ja,,0,0,0,,Қолданылған иерархия…
Dialogue: 0,1:32:43.51,1:32:46.89,Default,,0,0,0,,Бұл NetSphere желісінен ажыратылған орын.
Dialogue: 0,1:32:43.55,1:32:46.79,Default-ja,,0,0,0,,Дәл осы жерде Netsphere-мен байланыс үзілген.
Dialogue: 0,1:32:47.32,1:32:50.23,Default-ja,,0,0,0,,Қорғаушы да, құрылысшы да кедергі жасамайды.
Dialogue: 0,1:32:47.52,1:32:50.14,Default,,0,0,0,,Қауіпсіздік шаралары мен құрылысшылар кедергі жасамайды.
Dialogue: 0,1:32:50.83,1:32:53.76,Default-ja,,0,0,0,,Не істеу керек? Мен оған сене аламын ба?
Dialogue: 0,1:32:50.85,1:32:51.85,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:32:51.94,1:32:53.48,Default,,0,0,0,,Біз оған сене аламыз ба?
Dialogue: 0,1:32:54.02,1:32:57.28,Default,,0,0,0,,Егер біз осында қалсақ, бізді экстерминаторлар өлтіреді.
Dialogue: 0,1:32:54.03,1:32:57.30,Default-ja,,0,0,0,,Мен осында қалсам да, өлтірушілер мені өлтіреді.
Dialogue: 0,1:32:57.90,1:32:58.87,Default-ja,,0,0,0,,Қария
Dialogue: 0,1:32:57.98,1:32:58.82,Default,,0,0,0,,Поп.
Dialogue: 0,1:32:59.97,1:33:01.04,Default-ja,,0,0,0,,Хмм...
Dialogue: 0,1:33:05.66,1:33:08.62,Default,,0,0,0,,Барлығың кетуге дайындалыңдар.
Dialogue: 0,1:33:05.68,1:33:06.64,Default-ja,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,1:33:06.81,1:33:08.58,Default-ja,,0,0,0,,Ұшуға дайындалу
Dialogue: 0,1:33:12.62,1:33:13.28,Default-ja,,0,0,0,,Ах...
Dialogue: 0,1:33:17.80,1:33:19.38,Default,,0,0,0,,Кеттік, Килли.
Dialogue: 0,1:33:17.85,1:33:19.19,Default-ja,,0,0,0,,Кеттік, Кириха.
Dialogue: 0,1:33:31.85,1:33:32.73,Default,,0,0,0,,Килли.
Dialogue: 0,1:33:31.87,1:33:32.77,Default-ja,,0,0,0,,Тұман шошқа…
Dialogue: 0,1:33:44.61,1:33:47.41,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,1:33:44.75,1:33:49.35,Default-ja,,0,0,0,,Әй, ауылға қайтайық. Сыртта қорқынышты.
Dialogue: 0,1:33:47.49,1:33:49.54,Default,,0,0,0,,Бұл жерде қорқынышты.
Dialogue: 0,1:33:49.62,1:33:51.66,Default,,0,0,0,,Біз ол жаққа қайта оралмаймыз.
Dialogue: 0,1:33:49.69,1:33:51.69,Default-ja,,0,0,0,,Мен енді ол жерге қайта алмаймын.
Dialogue: 0,1:33:51.75,1:33:54.08,Default,,0,0,0,,Сақтандырушы бізді сол жерден тапты.
Dialogue: 0,1:33:51.75,1:33:54.26,Default-ja,,0,0,0,,Қорғаныс мені тапты.
Dialogue: 0,1:33:56.92,1:33:59.13,Default,,0,0,0,,Попс, кешіріңіз.
Dialogue: 0,1:33:56.93,1:33:57.93,Default-ja,,0,0,0,,Қарт...
Dialogue: 0,1:33:58.66,1:33:59.33,Default-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,1:34:00.03,1:34:00.90,Default-ja,,0,0,0,,Иә?
Dialogue: 0,1:34:01.83,1:34:06.07,Default-ja,,0,0,0,,Өйткені мен бәрін аңға апардым...
Dialogue: 0,1:34:01.84,1:34:02.67,Default,,0,0,0,,Ой, Хиёри-я! Жаңа жылды әзілмен бастап жатырсың ғой, иә?
Dialogue: 0,1:34:03.47,1:34:05.93,Default,,0,0,0,,Барлығын аңға алып шыққаныма мен кінәлімін.
Dialogue: 0,1:34:06.37,1:34:07.30,Default-ja,,0,0,0,,Жоқ
Dialogue: 0,1:34:06.43,1:34:07.26,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,1:34:07.87,1:34:08.74,Default-ja,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,1:34:11.01,1:34:12.68,Default-ja,,0,0,0,,Сізге рахмет
Dialogue: 0,1:34:11.02,1:34:12.35,Default,,0,0,0,,Біз сізге алғыс айтуымыз керек.
Dialogue: 0,1:34:13.64,1:34:14.38,Default-ja,,0,0,0,,Ах...
Dialogue: 0,1:34:38.63,1:34:42.30,Default,,0,0,0,,Уау, Сибо, теміржол вагонына қоңырау шалуға болады!
Dialogue: 0,1:34:38.67,1:34:40.04,Default-ja,,0,0,0,,Бұл керемет, Шибо мырза.
Dialogue: 0,1:34:40.34,1:34:42.44,Default-ja,,0,0,0,,Бақыланатын көлікті шақыра аласыз ба?
Dialogue: 0,1:34:43.04,1:34:44.81,Default-ja,,0,0,0,,Балалар сендерге еліктемеу керек.
Dialogue: 0,1:34:43.05,1:34:44.88,Default,,0,0,0,,Оны өзіңіз сынамаңыз.
Dialogue: 0,1:34:55.22,1:34:56.79,Default-ja,,0,0,0,,Жүр, барлығы бортқа отыр.
Dialogue: 0,1:34:55.23,1:34:56.85,Default,,0,0,0,,Жарайды, барлығы ішке кірсін.
Dialogue: 0,1:34:57.42,1:35:01.06,Default-ja,,0,0,0,,Осы арқылы кәдеге жарату деңгейіне жете аласыз ба?
Dialogue: 0,1:34:57.52,1:35:01.19,Default,,0,0,0,,Біз шынымен тасталған деңгейге жете аламыз ба?
Dialogue: 0,1:35:02.02,1:35:03.79,Default-ja,,0,0,0,,Жүр, жүр (Қыз) Иә.
Dialogue: 0,1:35:02.11,1:35:03.53,Default,,0,0,0,,-Міне, кір. -Жарайды.
Dialogue: 0,1:35:03.86,1:35:04.86,Default,,0,0,0,,Солай болар...
Dialogue: 0,1:35:03.86,1:35:04.79,Default-ja,,0,0,0,,Абайлаңыз
Dialogue: 0,1:35:06.23,1:35:07.10,Default-ja,,0,0,0,,Ах...!
Dialogue: 0,1:35:08.95,1:35:10.03,Default,,0,0,0,,Бұл иіс.
Dialogue: 0,1:35:08.96,1:35:10.17,Default-ja,,0,0,0,,Бұл иіс...
Dialogue: 0,1:35:15.40,1:35:17.31,Default-ja,,0,0,0,,Міне! Барлығына асығыңыздар!
Dialogue: 0,1:35:15.41,1:35:17.16,Default,,0,0,0,,-Олар осында! - Асығыңыз, бәріңіз!
Dialogue: 0,1:35:19.48,1:35:21.84,Default-ja,,0,0,0,,Кириха, сен не істеп жатырсың? Тезірек жүріңіз.
Dialogue: 0,1:35:19.58,1:35:21.59,Default,,0,0,0,,Килли, сен не істеп жатырсың? Тезірек кіріңіз!
Dialogue: 0,1:35:22.04,1:35:23.05,Default,,0,0,0,,Килли!
Dialogue: 0,1:35:22.04,1:35:22.95,Default-ja,,0,0,0,,Тұман шошқа?
Dialogue: 0,1:35:29.12,1:35:30.09,Default-ja,,0,0,0,,Бұл өтірік...
Dialogue: 0,1:35:29.14,1:35:30.18,Default,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 0,1:35:31.89,1:35:34.01,Default,,0,0,0,,Не болды, Килли?
Dialogue: 0,1:35:31.95,1:35:34.12,Default-ja,,0,0,0,,Не болды? Тұман шошқа…
Dialogue: 0,1:35:52.14,1:35:53.01,Default-ja,,0,0,0,,Иә?
Dialogue: 0,1:36:02.35,1:36:03.29,Default-ja,,0,0,0,,Кири шошқа…
Dialogue: 0,1:36:02.46,1:36:03.34,Default,,0,0,0,,Килли.
Dialogue: 0,1:36:04.71,1:36:05.96,Default,,0,0,0,,Мен сені қайта көрмеймін бе?
Dialogue: 0,1:36:04.75,1:36:06.06,Default-ja,,0,0,0,,Қайта кездесе алмаймыз ба?
Dialogue: 0,1:36:12.14,1:36:15.68,Default,,0,0,0,,Мен... іздеймін...
Dialogue: 0,1:36:12.23,1:36:13.13,Default-ja,,0,0,0,,Мен...
Dialogue: 0,1:36:13.96,1:36:15.87,Default-ja,,0,0,0,,Таза терминалдық ген...
Dialogue: 0,1:36:16.30,1:36:17.37,Default-ja,,0,0,0,,Іздеу
Dialogue: 0,1:36:16.35,1:36:17.64,Default,,0,0,0,,Желілік терминал гені.
Dialogue: 0,1:36:28.11,1:36:29.03,Default,,0,0,0,,Мен оны қазір жауып жатырмын.
Dialogue: 0,1:36:28.14,1:36:29.01,Default-ja,,0,0,0,,Мен оны жабамын.
Dialogue: 0,1:36:48.33,1:36:50.23,Default-ja,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:37:03.81,1:37:09.49,Default,,0,0,0,,Бұл ауыл тұрғындары оны соңғы рет көрді.
Dialogue: 0,1:37:03.85,1:37:06.92,Default-ja,,0,0,0,,Ауыл тұрғындарының көргені...
Dialogue: 0,1:37:07.35,1:37:09.52,Default-ja,,0,0,0,,Бұл оның соңғы рет келуі еді.
Dialogue: 0,1:37:14.16,1:37:19.45,Default,,0,0,0,,Осыдан кейін әжем Зуру бәрімізді жаңа жерге апарды.
Dialogue: 0,1:37:14.19,1:37:19.30,Default-ja,,0,0,0,,Кейінірек әжем Зуру жаңа дүниеде барлығын басқарды.
Dialogue: 0,1:37:20.37,1:37:22.29,Default,,0,0,0,,Сіз үлкен болып өстіңіз.
Dialogue: 0,1:37:23.37,1:37:28.47,Default-ja,,0,0,0,,Әжем маған жас кезімде Кирихи туралы айтатын.
Dialogue: 0,1:37:23.50,1:37:24.88,Default,,0,0,0,,Менің әжем
Dialogue: 0,1:37:25.46,1:37:28.34,Default,,0,0,0,,жас кезімде маған әрқашан Кили туралы сөйлесетін.
Dialogue: 0,1:37:36.80,1:37:39.01,Default,,0,0,0,,Көп уақыт өтті, бірақ...
Dialogue: 0,1:37:36.88,1:37:39.22,Default-ja,,0,0,0,,Арада көп жылдар өтсе де...
Dialogue: 0,1:37:43.35,1:37:46.36,Default-ja,,0,0,0,,Қала функциялары қалыпты жағдайға оралғанының белгісі жоқ.
Dialogue: 0,1:37:43.44,1:37:46.52,Default,,0,0,0,,қала функцияларының қалыпты жағдайға оралуының белгісі жоқ.
Dialogue: 0,1:37:50.94,1:37:55.03,Default,,0,0,0,,Мен әлі күнге дейін Net Terminal Gene бар ешкім табылған жоқ деп ойлаймын.
Dialogue: 0,1:37:50.99,1:37:53.23,Default-ja,,0,0,0,,Интернет терминалының гені бар адамдар
Dialogue: 0,1:37:53.30,1:37:55.00,Default-ja,,0,0,0,,Мүмкін табылмаған шығар
Dialogue: 0,1:38:01.07,1:38:03.11,Default-ja,,0,0,0,,Бірақ мен сенемін
Dialogue: 0,1:38:01.08,1:38:02.83,Default,,0,0,0,,Бірақ мен сенемін.
Dialogue: 0,1:38:09.00,1:38:10.21,Default,,0,0,0,,Мен бір жерден білемін,
Dialogue: 0,1:38:09.01,1:38:12.88,Default-ja,,0,0,0,,Ол әлі шексіз қаланың бір жерінде
Dialogue: 0,1:38:10.30,1:38:12.51,Default,,0,0,0,,ол әлі де сол шексіз қалада...
Dialogue: 0,1:38:13.38,1:38:16.39,Default,,0,0,0,,іздеуді жалғастыруда.
Dialogue: 0,1:38:13.38,1:38:16.52,Default-ja,,0,0,0,,Ол өзінің барлау сапарын жалғастырып жатқан болуы керек...
Dialogue: 0,1:38:46.28,1:38:52.29,Default-ja,,0,0,0,,♪~
Dialogue: 0,1:39:39.34,1:39:45.34,Default-ja,,0,0,0,,~♪
Dialogue: 0,1:39:47.54,1:39:53.55,Default-ja,,0,0,0,,♪~
Dialogue: 0,1:45:17.64,1:45:23.65,Default-ja,,0,0,0,,~♪
Dialogue: 0,1:45:34.20,1:45:37.12,Default,,0,0,0,,Субтитр аудармасы Ходай Стернс
Dialogue: 0,1:45:38.62,1:45:44.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory