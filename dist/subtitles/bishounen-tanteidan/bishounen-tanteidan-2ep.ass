Dialogue: 0,0:16:49.20,0:16:50.03,Default,,0,0,0,,...
Dialogue: 0,0:18:36.43,0:18:38.43,Default,,0,0,0,,Бұл ғылым
Dialogue: 0,0:18:38.43,0:18:40.18,Default,,0,0,0,,Бұл ғылым
Dialogue: 0,0:00:00.00,0:00:01.48,Default,,0,0,0,,Комиссардың бақылауы және түсіндіруі
Dialogue: 0,0:02:02.98,0:02:04.98,Default,,0,0,0,,Таң
Dialogue: 0,0:04:29.83,0:04:31.33,Default,,0,0,0,,「」「」
Dialogue: 0,0:04:29.83,0:04:31.33,Default,,0,0,0,,Жоғалу
Dialogue: 0,0:05:52.83,0:05:54.33,Default,,0,0,0,,Бірге мінген екі адам
Dialogue: 0,0:06:14.35,0:06:15.86,Default,,0,0,0,,Нұсқаулар
Dialogue: 0,0:07:41.19,0:07:44.69,Default,,0,0,0,,...
Dialogue: 0,0:09:11.41,0:09:13.41,Default,,0,0,0,,Бастық орынбасарының түсініктемесі
Dialogue: 0,0:10:58.14,0:10:59.76,Default,,0,0,0,,Астрономиялық көрініс (ақ аспан)
Dialogue: 0,0:13:33.04,0:13:34.54,Default,,0,0,0,,Аспан шайқасы
Dialogue: 0,0:14:48.49,0:14:49.99,Default,,0,0,0,,Соқыр адам
Dialogue: 0,0:16:40.98,0:16:41.98,Default,,0,0,0,,Құпия есеп
Dialogue: 0,0:17:31.32,0:17:32.82,Default,,0,0,0,,Әдемі жігіттер тобының сұлулық тобы
Dialogue: 0,0:18:31.67,0:18:32.92,Default,,0,0,0,,Ең әдемі сезім
Dialogue: 0,0:21:03.33,0:21:05.33,Default,,0,0,0,,Тәртіпсіздік
Dialogue: 0,0:21:36.98,0:21:38.36,Default,,0,0,0,,Бірінші орта мектеп
Dialogue: 0,0:22:05.97,0:22:08.97,Default,,0,0,0,,Жай ғана қара қара жұлдыз
Dialogue: 0,0:22:05.97,0:22:08.97,Default,,0,0,0,,2-бөлім
Dialogue: 0,0:22:17.52,0:22:21.78,Default,,0,0,0,,Ашық аспан, дүбірге толы аспан, Қорқыныш осында.
Dialogue: 0,0:22:21.36,0:22:24.99,Default,,0,0,0,,Күнделікті оңай бояу түстері
Dialogue: 0,0:22:25.70,0:22:29.16,Default,,0,0,0,,Дүниені мазақ ететін ойдан шығарылған әңгіме
Dialogue: 0,0:22:29.45,0:22:33.16,Default,,0,0,0,,Дереу босану жеңіл, алақанымыздан қашып құтыла алмаймыз.
Dialogue: 0,0:22:35.42,0:22:41.72,Default,,0,0,0,,Егер шатасудың ортасында болса
Dialogue: 0,0:22:42.01,0:22:48.39,Default,,0,0,0,,Парасат пен талант, батыл дарын мен апат.
Dialogue: 0,0:22:49.93,0:22:53.06,Default,,0,0,0,,минут минут секунд секунд
Dialogue: 0,0:22:53.44,0:22:56.90,Default,,0,0,0,,...
Dialogue: 0,0:22:57.23,0:22:59.02,Default,,0,0,0,,Қанша адам, қандай орындар, қандай жетістіктер?
Dialogue: 0,0:22:59.02,0:23:05.20,Default,,0,0,0,,Бастапқы дизайн ешқашан ұмытылмайды.
Dialogue: 0,0:23:05.20,0:23:06.49,Default,,0,0,0,,Қажетті ақпарат
Dialogue: 0,0:23:06.66,0:23:09.99,Default,,0,0,0,,Мен зерттеуге келдім
Dialogue: 0,0:23:09.99,0:23:14.00,Default,,0,0,0,,Біртүрлі аралдың кенеттен келуі
Dialogue: 0,0:23:14.00,0:23:17.29,Default,,0,0,0,,Қазір бәрі іздеп жүрген жұмбақ
Dialogue: 0,0:23:17.29,0:23:20.92,Default,,0,0,0,,Кең көлемді үй шаруашылығы жүйесі, таңқаларлық және арандатушылық жұмбақ.
Dialogue: 0,0:23:20.92,0:23:24.93,Default,,0,0,0,,Ескертусіз құрмет
Dialogue: 0,0:23:24.93,0:23:28.85,Default,,0,0,0,,Айдың жан-жақты жарықтандыруы
Dialogue: 0,0:23:28.85,0:23:32.47,Default,,0,0,0,,Кешкі асқа қажетсіз индульгенция
Dialogue: 0,0:23:32.47,0:23:36.48,Default,,0,0,0,,Сіз оны көре алмайсыз, бірақ оны пайдалана алмайсыз.
Dialogue: 0,0:22:17.52,0:22:21.78,Default,,0,0,0,,Ашық аспандағы бұршақ пен бұршақ Оқиға таң қалдырды
Dialogue: 0,0:22:21.36,0:22:24.99,Default,,0,0,0,,Қызық күндеріңізді бояңыз
Dialogue: 0,0:22:25.70,0:22:29.16,Default,,0,0,0,,Көпшілікті алдайтын көркем әдебиет
Dialogue: 0,0:22:29.45,0:22:33.16,Default,,0,0,0,,Біз тіпті жарықтың өзімізден кетуіне жол бермейміз.
Dialogue: 0,0:22:35.42,0:22:41.72,Default,,0,0,0,,If лабиринтінде кідіруге тыйым салынады.
Dialogue: 0,0:22:42.01,0:22:48.39,Default,,0,0,0,,Дедукцияның кілті - батылдық.
Dialogue: 0,0:22:49.93,0:22:53.06,Default,,0,0,0,,Әр сәт, әр секунд туады және өтеді
Dialogue: 0,0:22:53.44,0:22:56.90,Default,,0,0,0,,Драма Карма Оны жіберіп алмаңыз
Dialogue: 0,0:22:57.23,0:22:59.02,Default,,0,0,0,,Кім қайда не істеді?
Dialogue: 0,0:22:59.02,0:23:05.20,Default,,0,0,0,,Қанша рет сынап көрсең де
Dialogue: 0,0:23:05.20,0:23:06.49,Default,,0,0,0,,Әдемі, эй
Dialogue: 0,0:23:06.66,0:23:09.99,Default,,0,0,0,,Сіз детективті шақырып жатырсыз.
Dialogue: 0,0:23:09.99,0:23:14.00,Default,,0,0,0,,Жұмбақ жерге апатты қону
Dialogue: 0,0:23:14.00,0:23:17.29,Default,,0,0,0,,Әлем қиын сынақтарды қалайды.
Dialogue: 0,0:23:17.29,0:23:20.92,Default,,0,0,0,,Тапсырыспен жасалған Жұмбақ тәсілдер
Dialogue: 0,0:23:20.92,0:23:24.93,Default,,0,0,0,,Жомарт құрметпен бәрін ашайық.
Dialogue: 0,0:23:24.93,0:23:28.85,Default,,0,0,0,,Айдың жасырын жағы
Dialogue: 0,0:23:28.85,0:23:32.47,Default,,0,0,0,,Кешкі асқа уақытында
Dialogue: 0,0:23:32.47,0:23:36.48,Default,,0,0,0,,Бірегей пайымдауды тексеріңіз
Dialogue: 0,0:00:02.48,0:00:06.49,Default,,0,0,0,,Менің арманым әдемі
Dialogue: 0,0:00:07.49,0:00:13.24,Default,,0,0,0,,...
Dialogue: 0,0:00:13.24,0:00:15.25,Default,,0,0,0,,Ғарышкер
Dialogue: 0,0:00:15.25,0:00:21.33,Default,,0,0,0,,Менің арманым, арманым, менің құралдарым.
Dialogue: 0,0:00:21.33,0:00:24.75,Default,,0,0,0,,Дегенмен, менің шынайы сезімім бұл сезімнен бөлек.
Dialogue: 0,0:00:25.42,0:00:28.76,Default,,0,0,0,,Мен өз армандарыма мән бермеймін
Dialogue: 0,0:00:29.30,0:00:33.01,Default,,0,0,0,,Тамағына көңілім толмайды.
Dialogue: 0,0:02:07.32,0:02:13.40,Default,,0,0,0,,Мен елге шектеусіз келдім 14 Цинчэн
Dialogue: 0,0:02:15.99,0:02:17.74,Default,,0,0,0,,Маған қазір ұнайды.
Dialogue: 0,0:02:20.16,0:02:21.79,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:02:22.50,0:02:26.38,Default,,0,0,0,,Қазір хабар таратуға әлі ерте
Dialogue: 0,0:02:28.50,0:02:30.76,Default,,0,0,0,,Ондық ниет Лао Дай
Dialogue: 0,0:02:30.76,0:02:34.88,Default,,0,0,0,,Ата-ана бір-біріне риза болуы керек.
Dialogue: 0,0:02:34.88,0:02:37.39,Default,,0,0,0,,Сіз туған жеріңізде туасыз.
Dialogue: 0,0:02:37.39,0:02:39.26,Default,,0,0,0,,...
Dialogue: 0,0:02:39.26,0:02:40.85,Default,,0,0,0,,Бұл бөлім
Dialogue: 0,0:02:40.85,0:02:43.02,Default,,0,0,0,,Жауап көрші үйде.
Dialogue: 0,0:02:43.94,0:02:45.23,Default,,0,0,0,,11-ші эпизод: Наланжияның аспан болатшысы
Dialogue: 0,0:02:45.23,0:02:47.48,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:02:47.48,0:02:48.11,Default,,0,0,0,,Түсіндірме қандай?
Dialogue: 0,0:02:48.61,0:02:52.49,Default,,0,0,0,,Кешке дейінгі уақыт мөлшері
Dialogue: 0,0:02:55.36,0:02:58.28,Default,,0,0,0,,Менің оқиғам мынау.
Dialogue: 0,0:02:58.28,0:03:01.70,Default,,0,0,0,,Түнде келу керек.
Dialogue: 0,0:03:01.70,0:03:04.41,Default,,0,0,0,,...
Dialogue: 0,0:03:04.41,0:03:08.63,Default,,0,0,0,,Есеп ақ аспан.
Dialogue: 0,0:03:08.63,0:03:11.50,Default,,0,0,0,,Мәселе күн мен айдың жарқырап тұрғанында.
Dialogue: 0,0:03:11.50,0:03:12.13,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:03:12.55,0:03:14.13,Default,,0,0,0,,...
Dialogue: 0,0:03:14.13,0:03:16.88,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:17.80,0:03:18.97,Default,,0,0,0,,...
Dialogue: 0,0:03:18.97,0:03:21.81,Default,,0,0,0,,Адамның ақымақ пікірі
Dialogue: 0,0:03:21.81,0:03:23.77,Default,,0,0,0,,Алайда түпнұсқа мәтінінің мағынасы анық емес.
Dialogue: 0,0:03:23.77,0:03:25.77,Default,,0,0,0,,...
Dialogue: 0,0:03:26.10,0:03:28.77,Default,,0,0,0,,Менің жеке басымдылығым
Dialogue: 0,0:03:29.27,0:03:31.02,Default,,0,0,0,,Менің талабым Шығыс
Dialogue: 0,0:03:31.02,0:03:32.07,Default,,0,0,0,,Хитомишима
Dialogue: 0,0:03:32.44,0:03:34.57,Default,,0,0,0,,Той күтіп тұрғанда
Dialogue: 0,0:03:34.57,0:03:37.78,Default,,0,0,0,,Ата-аналар мен ата-аналар
Dialogue: 0,0:03:37.78,0:03:41.03,Default,,0,0,0,,Мектепті бітіргеннен кейін Но өнер бөлмесіне оралады
Dialogue: 0,0:03:41.53,0:03:44.79,Default,,0,0,0,,Кездесуге қатысты сұрақтарыңыз болса, бізге хабарласыңыз.
Dialogue: 0,0:03:47.46,0:03:50.59,Default,,0,0,0,,Сен ең жақсысың, сенде үлкен үміт бар Хитомишима
Dialogue: 0,0:03:50.59,0:03:54.67,Default,,0,0,0,,Қытайда жүргенде бұл адам қалыпты емес.
Dialogue: 0,0:03:54.67,0:03:57.18,Default,,0,0,0,,Бастауыш мектептің бірінші сыныбында оқитын қыз баламен қарым-қатынас жасауға болады.
Dialogue: 0,0:03:57.18,0:03:58.68,Default,,0,0,0,,Бұл тегін лицензия.
Dialogue: 0,0:04:00.97,0:04:02.68,Default,,0,0,0,,Қажетсіз зиян
Dialogue: 0,0:04:02.68,0:04:07.06,Default,,0,0,0,,Тізімнен бір нәрсені алып тастаңыз.
Dialogue: 0,0:04:07.48,0:04:08.27,Default,,0,0,0,,Фуфуфу
Dialogue: 0,0:04:08.27,0:04:14.07,Default,,0,0,0,,Арнайы хирургиялық әдістерді қолдануға болмайды.
Dialogue: 0,0:04:14.07,0:04:15.07,Default,,0,0,0,,Жөтел жөтел
Dialogue: 0,0:04:15.40,0:04:17.90,Default,,0,0,0,,Мен ғашықпын, үйленбеген әйелмін.
Dialogue: 0,0:04:17.90,0:04:20.16,Default,,0,0,0,,Кемелдік – ата-ананың тағдыры
Dialogue: 0,0:04:20.16,0:04:21.82,Default,,0,0,0,,Әскери қолбасшы
Dialogue: 0,0:04:22.83,0:04:23.45,Default,,0,0,0,,Қателік
Dialogue: 0,0:04:25.45,0:04:29.83,Default,,0,0,0,,Үміт көп болса, өлесің
Dialogue: 0,0:04:31.79,0:04:34.84,Default,,0,0,0,,Ата-аналар оңай жазыла алады
Dialogue: 0,0:04:35.42,0:04:39.34,Default,,0,0,0,,Уақыт ұзаруы күннің соңына жетті.
Dialogue: 0,0:04:40.43,0:04:41.84,Default,,0,0,0,,Ұмытылған көзілдірік
Dialogue: 0,0:04:42.76,0:04:44.35,Default,,0,0,0,,Карталар аяқталды
Dialogue: 0,0:04:55.07,0:04:56.57,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:04:58.65,0:05:01.07,Default,,0,0,0,,Йошизуки мектепті тастап кетті
Dialogue: 0,0:05:01.82,0:05:04.58,Default,,0,0,0,,Дегенмен, жүгіру де мүмкін емес.
Dialogue: 0,0:05:13.46,0:05:14.09,Default,,0,0,0,,Екі адам?
Dialogue: 0,0:05:14.34,0:05:16.38,Default,,0,0,0,,...
Dialogue: 0,0:05:16.38,0:05:17.96,Default,,0,0,0,,...
Dialogue: 0,0:05:20.01,0:05:21.34,Default,,0,0,0,,Шынайы мағына
Dialogue: 0,0:05:21.84,0:05:22.59,Default,,0,0,0,,үшінңды өлтіреміз
Dialogue: 0,0:05:22.89,0:05:23.97,Default,,0,0,0,,үшінңды өлтіреміз
Dialogue: 0,0:05:23.97,0:05:24.72,Default,,0,0,0,,үшінңды өлтіреміз
Dialogue: 0,0:05:39.44,0:05:40.90,Default,,0,0,0,,Мона Кими...
Dialogue: 0,0:05:40.90,0:05:42.49,Default,,0,0,0,,Фуку
Dialogue: 0,0:05:42.49,0:05:44.70,Default,,0,0,0,,Маған бұл өте ұнамайды.
Dialogue: 0,0:05:51.96,0:05:52.83,Default,,0,0,0,,Алдағы
Dialogue: 0,0:05:56.04,0:05:57.04,Default,,0,0,0,,Бөлек Мацутея
Dialogue: 0,0:06:07.85,0:06:09.85,Default,,0,0,0,,Жамбастағы әдемі бала Тацута
Dialogue: 0,0:06:10.73,0:06:14.35,Default,,0,0,0,,Аспан бос, терісі тырналған.
Dialogue: 0,0:06:17.36,0:06:19.73,Default,,0,0,0,,...
Dialogue: 0,0:06:20.28,0:06:22.49,Default,,0,0,0,,Сатып алуға жауапты ата-аналар
Dialogue: 0,0:06:22.49,0:06:24.74,Default,,0,0,0,,Сондай-ақ есептеу мүмкін емес
Dialogue: 0,0:06:24.74,0:06:27.49,Default,,0,0,0,,Тоюки келісімі кейінге қалдырылды
Dialogue: 0,0:06:28.74,0:06:30.37,Default,,0,0,0,,Менің түсінгенім осы.
Dialogue: 0,0:06:30.37,0:06:32.16,Default,,0,0,0,,Сен жақсы баласың.
Dialogue: 0,0:06:32.16,0:06:33.87,Default,,0,0,0,,Жақсы бала? ондық ниет
Dialogue: 0,0:06:33.87,0:06:34.71,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:06:34.71,0:06:38.25,Default,,0,0,0,,Менің көргенім, мен келісетініме сенімдімін.
Dialogue: 0,0:06:38.67,0:06:42.76,Default,,0,0,0,,...
Dialogue: 0,0:06:43.55,0:06:45.38,Default,,0,0,0,,Әр түрлі уақытта қол жетімді басқа тілдер
Dialogue: 0,0:06:45.38,0:06:50.10,Default,,0,0,0,,Неке аяқталды
Dialogue: 0,0:06:50.10,0:06:55.27,Default,,0,0,0,,Отбасының балалар қоғамы болғандықтан, бірінші сынып осында.
Dialogue: 0,0:06:55.81,0:06:59.52,Default,,0,0,0,,...
Dialogue: 0,0:06:59.52,0:07:02.61,Default,,0,0,0,,Мен бұл туралы әртүрлі сын сәттерде ойлаймын.
Dialogue: 0,0:07:02.61,0:07:05.78,Default,,0,0,0,,Бөлек, мен қарызға ақша аламын.
Dialogue: 0,0:07:05.78,0:07:10.33,Default,,0,0,0,,...
Dialogue: 0,0:07:10.33,0:07:12.45,Default,,0,0,0,,...
Dialogue: 0,0:07:12.45,0:07:15.54,Default,,0,0,0,,...
Dialogue: 0,0:07:17.88,0:07:20.04,Default,,0,0,0,,Бұл оқиға менің бақылауымнан тыс.
Dialogue: 0,0:07:20.38,0:07:25.80,Default,,0,0,0,,...
Dialogue: 0,0:07:26.22,0:07:27.68,Default,,0,0,0,,Мо Фей
Dialogue: 0,0:07:27.68,0:07:33.68,Default,,0,0,0,,Егер сіздің көзіңізге басқа адамның келуін қаламасаңыз, оны тыңдай аласыз.
Dialogue: 0,0:07:35.85,0:07:38.44,Default,,0,0,0,,...
Dialogue: 0,0:07:40.31,0:07:41.19,Default,,0,0,0,,Бір сәттегі өлім
Dialogue: 0,0:07:42.07,0:07:43.53,Default,,0,0,0,,Екі адам арасындағы
Dialogue: 0,0:07:45.74,0:07:47.20,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:07:47.20,0:07:48.20,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:07:48.57,0:07:52.20,Default,,0,0,0,,Бірінші орта мектеп оқушысы және ересектерді бақылау тобы.
Dialogue: 0,0:07:52.20,0:07:53.62,Default,,0,0,0,,Өлім...Өлім...
Dialogue: 0,0:07:53.62,0:07:56.21,Default,,0,0,0,,Мен көмекке келдім.
Dialogue: 0,0:07:56.21,0:07:58.21,Default,,0,0,0,,Таң қалмау керек
Dialogue: 0,0:08:05.46,0:08:06.47,Default,,0,0,0,,Менің көпіршікті шыныаяқ қызыл шай
Dialogue: 0,0:08:06.47,0:08:08.72,Default,,0,0,0,,Сіз маған қонаққа келген жоқсыз.
Dialogue: 0,0:08:09.09,0:08:10.34,Default,,0,0,0,,Жол
Dialogue: 0,0:08:10.34,0:08:11.97,Default,,0,0,0,,Кім қажет?
Dialogue: 0,0:08:13.43,0:08:15.73,Default,,0,0,0,,Әңгіменің шығу тегі
Dialogue: 0,0:08:17.64,0:08:21.36,Default,,0,0,0,,Корекогоро, қарт Ямато және менің тобым
Dialogue: 0,0:08:21.36,0:08:22.98,Default,,0,0,0,,Хогакурёсайкай сапары
Dialogue: 0,0:08:22.98,0:08:23.98,Default,,0,0,0,,Когоро...
Dialogue: 0,0:08:24.32,0:08:25.23,Default,,0,0,0,,Дикано
Dialogue: 0,0:08:25.53,0:08:26.36,Default,,0,0,0,,...
Dialogue: 0,0:08:26.36,0:08:29.24,Default,,0,0,0,,Мектепке келгенде мен сенімен бірге болдым.
Dialogue: 0,0:08:30.32,0:08:35.04,Default,,0,0,0,,Ағымдағы жағдайларға байланысты мен басқа мәліметтерді атап өттім.
Dialogue: 0,0:08:35.75,0:08:37.25,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:08:37.54,0:08:42.13,Default,,0,0,0,,Бұл естігенім, бірақ естігім келмеді.
Dialogue: 0,0:08:42.50,0:08:46.38,Default,,0,0,0,,...
Dialogue: 0,0:08:46.76,0:08:51.14,Default,,0,0,0,,...
Dialogue: 0,0:08:51.14,0:08:54.89,Default,,0,0,0,,Мен бағдарламаны іске қосқаннан кейін мұны істей алатынымды білу қаупі бар.
Dialogue: 0,0:08:55.26,0:08:59.10,Default,,0,0,0,,Он жыл бұрын Жапониядағы алғашқы өндірістің жағдайлары мен жағдайлары
Dialogue: 0,0:08:59.10,0:09:01.90,Default,,0,0,0,,Су бетінде таңғаларлық оқиға пайда болады.
Dialogue: 0,0:09:01.90,0:09:04.40,Default,,0,0,0,,Төтенше... факт?
Dialogue: 0,0:09:04.65,0:09:05.52,Default,,0,0,0,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:09:05.52,0:09:08.90,Default,,0,0,0,,Барлық қатысушыларға арналған ақпарат
Dialogue: 0,0:09:09.95,0:09:11.41,Default,,0,0,0,,Мені тыңда
Dialogue: 0,0:09:13.70,0:09:16.16,Default,,0,0,0,,Құрметті әке!
Dialogue: 0,0:09:16.16,0:09:17.79,Default,,0,0,0,,Қажетсіз саяхат
Dialogue: 0,0:09:18.20,0:09:23.21,Default,,0,0,0,,...
Dialogue: 0,0:09:23.21,0:09:27.05,Default,,0,0,0,,Мен жұмысшы баламын.
Dialogue: 0,0:09:27.05,0:09:30.55,Default,,0,0,0,,Өздігінен жасалған жұлдызды атау
Dialogue: 0,0:09:30.84,0:09:34.18,Default,,0,0,0,,Сіз қанша адамға жатасыз?
Dialogue: 0,0:09:34.18,0:09:36.51,Default,,0,0,0,,Ваказе но Кан Камишо Айнохитоның аты мен тегі
Dialogue: 0,0:09:36.51,0:09:39.31,Default,,0,0,0,,Адам өміріндегі адам туралы не ойлайсың?
Dialogue: 0,0:09:39.31,0:09:39.93,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:09:40.06,0:09:42.81,Default,,0,0,0,,Бастауыш мектептің бірінші сыныбында менің қыз достарым жоқ.
Dialogue: 0,0:09:42.81,0:09:44.81,Default,,0,0,0,,Сіз де айтқыңыз келуі мүмкін
Dialogue: 0,0:09:45.27,0:09:47.23,Default,,0,0,0,,Мен бұл туралы не ойладым
Dialogue: 0,0:09:47.23,0:09:49.86,Default,,0,0,0,,Әдемі жұлдызды іздеу
Dialogue: 0,0:09:49.86,0:09:55.20,Default,,0,0,0,,Бұл дүниедегі адамдардың мәңгілік мұрасы.
Dialogue: 0,0:09:55.20,0:09:58.79,Default,,0,0,0,,Кеңістік уақытын бақылау
Dialogue: 0,0:09:58.79,0:10:03.25,Default,,0,0,0,,10
Dialogue: 0,0:10:03.25,0:10:04.96,Default,,0,0,0,,Бұл өмірде бір рет болатын оқиға.
Dialogue: 0,0:10:05.50,0:10:06.96,Default,,0,0,0,,...
Dialogue: 0,0:10:06.96,0:10:09.30,Default,,0,0,0,,Ең айқын шешім
Dialogue: 0,0:10:09.30,0:10:11.80,Default,,0,0,0,,Уақыты келгенде жоқ.
Dialogue: 0,0:10:11.80,0:10:15.97,Default,,0,0,0,,Бұл ағымдағы уақыт.
Dialogue: 0,0:10:17.35,0:10:22.14,Default,,0,0,0,,Дегенмен, қарияның осында екенін білу маңызды.
Dialogue: 0,0:10:22.14,0:10:24.60,Default,,0,0,0,,...
Dialogue: 0,0:10:26.11,0:10:29.86,Default,,0,0,0,,Ғарыштық уақытты бақылауды оқу үшін қолайлы
Dialogue: 0,0:10:29.86,0:10:32.57,Default,,0,0,0,,Заңның мәліметтері расталмаған.
Dialogue: 0,0:10:32.57,0:10:35.36,Default,,0,0,0,,Тұсаукесер - бұл үлкен ескі әзіл
Dialogue: 0,0:10:36.24,0:10:37.37,Default,,0,0,0,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:10:37.37,0:10:41.00,Default,,0,0,0,,Астрономиялық бақылау негізінен түнде жүргізіледі.
Dialogue: 0,0:10:41.00,0:10:44.58,Default,,0,0,0,,Ғаламның мәңгілік астрономиялық жазбаларының арқасында.
Dialogue: 0,0:10:44.58,0:10:46.88,Default,,0,0,0,,Көруге бір жарым сағат қана қол жетімді.
Dialogue: 0,0:10:47.54,0:10:48.13,Default,,0,0,0,,Түсіндірме қандай?
Dialogue: 0,0:10:48.71,0:10:51.30,Default,,0,0,0,,Енді мен өз ойымды жеткіздім.
Dialogue: 0,0:10:51.30,0:10:54.26,Default,,0,0,0,,Жұлдыздарды көрсем түн жартысы.
Dialogue: 0,0:10:54.26,0:10:58.14,Default,,0,0,0,,Кейбіреулері ақ.
Dialogue: 0,0:10:59.76,0:11:01.02,Default,,0,0,0,,Хакутен?
Dialogue: 0,0:11:01.68,0:11:03.98,Default,,0,0,0,,Бұл өлді
Dialogue: 0,0:11:03.98,0:11:06.73,Default,,0,0,0,,Менің жасым 4-те екенін айту
Dialogue: 0,0:11:06.73,0:11:09.40,Default,,0,0,0,,Жылдың құны жоқ.
Dialogue: 0,0:11:09.40,0:11:10.90,Default,,0,0,0,,...
Dialogue: 0,0:11:11.44,0:11:15.40,Default,,0,0,0,,Жапондық күндізгі жарық, белгілі бір тривиальды ұлттық рейс түн.
Dialogue: 0,0:11:15.40,0:11:18.91,Default,,0,0,0,,Аспаннан қашпайтын тағдыр.
Dialogue: 0,0:11:18.91,0:11:19.91,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:11:21.04,0:11:23.41,Default,,0,0,0,,Зерттеудің «ғалам» нұсқасы
Dialogue: 0,0:11:24.54,0:11:25.87,Default,,0,0,0,,Қысқаша әңгіме
Dialogue: 0,0:11:25.87,0:11:30.42,Default,,0,0,0,,Нәтижесінде Хитоми аралын Жерден қысқа қашықтықта көруге болады.
Dialogue: 0,0:11:30.88,0:11:35.17,Default,,0,0,0,,Бұрыш мәселесі: Жапониядан тыс жерде жергілікті ыңғайлылықтар қолжетімді емес.
Dialogue: 0,0:11:35.76,0:11:38.30,Default,,0,0,0,,Алайда Хакутеня бейнесін Цукишо байқаған
Dialogue: 0,0:11:38.30,0:11:43.31,Default,,0,0,0,,Шын себеп жақын жерде бар, Хакутеннің таланты көрінеді.
Dialogue: 0,0:11:43.31,0:11:44.81,Default,,0,0,0,,Оларды таба аламыз ба, Мелони?
Dialogue: 0,0:11:44.81,0:11:46.89,Default,,0,0,0,,...
Dialogue: 0,0:11:46.89,0:11:49.69,Default,,0,0,0,,Бұл ақ аспан қағидасы
Dialogue: 0,0:11:49.69,0:11:54.07,Default,,0,0,0,,На Хитоми аралы – оттың ортасында таусылып қала жаздаған жұлдыз?
Dialogue: 0,0:11:54.78,0:11:57.95,Default,,0,0,0,,Алайда бұл аспаннан келетін зат.
Dialogue: 0,0:11:57.95,0:12:03.20,Default,,0,0,0,,Жапонияда тұратын адамдардың саны да әлемнің көптеген жерлеріне жетті.
Dialogue: 0,0:12:04.12,0:12:08.33,Default,,0,0,0,,...
Dialogue: 0,0:12:09.04,0:12:10.00,Default,,0,0,0,,Манабу Сакигучи
Dialogue: 0,0:12:11.04,0:12:12.84,Default,,0,0,0,,...
Dialogue: 0,0:12:14.05,0:12:14.84,Default,,0,0,0,,Дұрыс себеп осындай
Dialogue: 0,0:12:15.63,0:12:17.34,Default,,0,0,0,,...
Dialogue: 0,0:12:18.59,0:12:20.59,Default,,0,0,0,,Мен жақсы психологияға дайынмын
Dialogue: 0,0:12:21.80,0:12:26.52,Default,,0,0,0,,Нәтижесінде, одан төменірек биіктікте ғарыш кеңістігінде орналасқан объект
Dialogue: 0,0:12:26.52,0:12:30.44,Default,,0,0,0,,Менің көзім көтерілген жұлдызға келгенде
Dialogue: 0,0:12:30.44,0:12:33.61,Default,,0,0,0,,...
Dialogue: 0,0:12:34.48,0:12:37.44,Default,,0,0,0,,Маған бұлай істеуге рұқсат жоқ.
Dialogue: 0,0:12:37.44,0:12:41.87,Default,,0,0,0,,Арманға ұқсайтын саяхат жұлдызы
Dialogue: 0,0:12:42.41,0:12:44.62,Default,,0,0,0,,Бұл біздің сіздермен кездесуіміз.
Dialogue: 0,0:12:44.62,0:12:51.13,Default,,0,0,0,,Менің 10 жыл өткеніме көп уақыт өтті
Dialogue: 0,0:12:51.13,0:12:54.59,Default,,0,0,0,,Сондықтан оны алу мүмкін емес.
Dialogue: 0,0:12:54.59,0:12:56.42,Default,,0,0,0,,Гатофукай Кай келу Сакигучи Гакучо басшысы
Dialogue: 0,0:12:58.38,0:13:00.38,Default,,0,0,0,,Жұмбақ жас баланы іздеуге жібереді
Dialogue: 0,0:13:01.76,0:13:04.39,Default,,0,0,0,,Бұл логикалық қорытынды екені даусыз.
Dialogue: 0,0:13:04.64,0:13:09.39,Default,,0,0,0,,Қаладағы қабылдауым бүгінгі менің міндетім.
Dialogue: 0,0:13:10.48,0:13:12.15,Default,,0,0,0,,...
Dialogue: 0,0:13:12.15,0:13:13.40,Default,,0,0,0,,Хабарлама
Dialogue: 0,0:13:14.15,0:13:17.57,Default,,0,0,0,,Шығыс пен Батыстың шетіне жеткеніме бір күн болды.
Dialogue: 0,0:13:21.41,0:13:24.41,Default,,0,0,0,,Бұл жалпы жұлдыз емес, жасанды жұлдыз.
Dialogue: 0,0:13:26.41,0:13:29.16,Default,,0,0,0,,Сондай-ақ жалпы жасанды жұлдыз емес
Dialogue: 0,0:13:31.42,0:13:33.04,Default,,0,0,0,,Бұл әскери жұлдыз
Dialogue: 0,0:13:35.04,0:13:37.84,Default,,0,0,0,,Біраз уақытқа жеке әскери бизнесті елестетіңіз
Dialogue: 0,0:13:37.84,0:13:42.55,Default,,0,0,0,,...
Dialogue: 0,0:13:43.09,0:13:46.06,Default,,0,0,0,,Әрине, басқа адамдар киіну үшін күш салуда.
Dialogue: 0,0:13:46.06,0:13:49.56,Default,,0,0,0,,Бұйрықтың мақсаты
Dialogue: 0,0:13:50.52,0:13:52.90,Default,,0,0,0,,Элемент жойылғаннан кейін
Dialogue: 0,0:13:52.90,0:13:53.94,Default,,0,0,0,,Бас тартылды ма?
Dialogue: 0,0:13:53.94,0:13:56.82,Default,,0,0,0,,Ниет - құлау.
Dialogue: 0,0:13:56.82,0:14:01.57,Default,,0,0,0,,Шабуыл аяқталды және жағдай дұрыс реттелмеді.
Dialogue: 0,0:14:02.49,0:14:05.03,Default,,0,0,0,,Na Мен жұлдызды бақылап отырдым
Dialogue: 0,0:14:05.03,0:14:10.08,Default,,0,0,0,,Жұлдыздар түскенде жарық түседі
Dialogue: 0,0:14:10.41,0:14:12.29,Default,,0,0,0,,Жауабы мынау.
Dialogue: 0,0:14:12.79,0:14:14.29,Default,,0,0,0,,...
Dialogue: 0,0:14:14.29,0:14:15.54,Default,,0,0,0,,Наказе Тайсора
Dialogue: 0,0:14:15.54,0:14:16.75,Default,,0,0,0,,Қолжетімсіз
Dialogue: 0,0:14:16.75,0:14:18.42,Default,,0,0,0,,Бастауыш мектепте білім алу ұсынылмайды.
Dialogue: 0,0:14:18.42,0:14:22.09,Default,,0,0,0,,Ыңғайлы және заңсыз жану
Dialogue: 0,0:14:23.05,0:14:26.10,Default,,0,0,0,,Бұл бастауыш мектептегі академиялық білім.
Dialogue: 0,0:14:26.64,0:14:29.85,Default,,0,0,0,,Бірден жеткізу – аспанның бар болуы
Dialogue: 0,0:14:29.85,0:14:34.10,Default,,0,0,0,,Бұған әсер етпейтін ерекше жану құбылыстары да бар.
Dialogue: 0,0:14:34.90,0:14:36.73,Default,,0,0,0,,Ядролық өзгеріс
Dialogue: 0,0:14:36.73,0:14:38.69,Default,,0,0,0,,Қолданылған ядролық қару
Dialogue: 0,0:14:38.69,0:14:41.40,Default,,0,0,0,,Бұл заңды басылым.
Dialogue: 0,0:14:41.40,0:14:43.78,Default,,0,0,0,,Жалпы
Dialogue: 0,0:14:43.78,0:14:48.49,Default,,0,0,0,,Оқиға белгісіз жағдайдың мән-жайында таң қалдыратын түрде аяқталды.
Dialogue: 0,0:14:50.49,0:14:52.75,Default,,0,0,0,,Мен сені кездестірдім
Dialogue: 0,0:14:54.00,0:14:54.75,Default,,0,0,0,,...
Dialogue: 0,0:14:56.08,0:14:57.04,Default,,0,0,0,,Ауыз қуысын кесу
Dialogue: 0,0:14:58.04,0:14:59.50,Default,,0,0,0,,...
Dialogue: 0,0:15:00.34,0:15:03.51,Default,,0,0,0,,Сіз осындасыз және сіз осындасыз.
Dialogue: 0,0:15:04.47,0:15:06.43,Default,,0,0,0,,...
Dialogue: 0,0:15:06.43,0:15:08.68,Default,,0,0,0,,Тегін кім?
Dialogue: 0,0:15:08.68,0:15:09.51,Default,,0,0,0,,Нәтиже – мен.
Dialogue: 0,0:15:10.43,0:15:12.02,Default,,0,0,0,,Накоре табиғаты
Dialogue: 0,0:15:12.43,0:15:15.52,Default,,0,0,0,,Үлкендердің қиналудан басқа амалы жоқ.
Dialogue: 0,0:15:16.06,0:15:18.52,Default,,0,0,0,,Мен ұлмын
Dialogue: 0,0:15:21.23,0:15:23.78,Default,,0,0,0,,Бұл тривиальды адам.
Dialogue: 0,0:15:24.32,0:15:26.66,Default,,0,0,0,,Мен жағдайға байланысты тапсырманы орындай алдым.
Dialogue: 0,0:15:28.95,0:15:30.66,Default,,0,0,0,,Әдемі балалар тобын іздеу
Dialogue: 0,0:15:32.16,0:15:33.91,Default,,0,0,0,,Өзімшілдік
Dialogue: 0,0:15:34.62,0:15:37.04,Default,,0,0,0,,Жақсы даму және басқа адамдардың қабілеттері
Dialogue: 0,0:15:37.79,0:15:40.79,Default,,0,0,0,,Менің жүрегім жақсы, басқа да қабілеттерім бар.
Dialogue: 0,0:15:45.51,0:15:49.05,Default,,0,0,0,,Шындық дегеніміз не?
Dialogue: 0,0:15:49.05,0:15:51.26,Default,,0,0,0,,Мүмкін кездесу күлді.
Dialogue: 0,0:15:51.81,0:15:56.52,Default,,0,0,0,,...
Dialogue: 0,0:15:56.52,0:15:59.77,Default,,0,0,0,,Полицейлер кездескісі келмейді
Dialogue: 0,0:16:00.11,0:16:02.02,Default,,0,0,0,,Менің бұдан әрі келісімім жоқ.
Dialogue: 0,0:16:02.44,0:16:04.99,Default,,0,0,0,,Құрылғаны туралы ешқандай дәлелдеме жасалмады.
Dialogue: 0,0:16:04.99,0:16:09.03,Default,,0,0,0,,...
Dialogue: 0,0:16:10.24,0:16:14.33,Default,,0,0,0,,Менің қолымнан келеді, бірақ мен басқалардың ортасында өмір сүруге келдім.
Dialogue: 0,0:16:14.33,0:16:16.29,Default,,0,0,0,,Менің өміріме көңілім толмайды.
Dialogue: 0,0:16:17.71,0:16:19.63,Default,,0,0,0,,Бұл әдіс қауіпті
Dialogue: 0,0:16:19.63,0:16:22.63,Default,,0,0,0,,Полиция қызметіне табиғи түрде қатысы бар басқа адамдар
Dialogue: 0,0:16:22.63,0:16:24.92,Default,,0,0,0,,Мүмкін қарулар
Dialogue: 0,0:16:25.17,0:16:25.92,Default,,0,0,0,,Қару
Dialogue: 0,0:16:25.92,0:16:27.67,Default,,0,0,0,,Мен мұнда келгенде
Dialogue: 0,0:16:28.22,0:16:31.18,Default,,0,0,0,,Қандай да бір сұрақтарыңыз болса, бізге хабарласудан тартынбаңыз.
Dialogue: 0,0:16:31.93,0:16:32.68,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:32.68,0:16:36.68,Default,,0,0,0,,Міне, сондықтан сіз мұнда тамақтанғанды ​​ұнатасыз.
Dialogue: 0,0:16:37.31,0:16:38.85,Default,,0,0,0,,Жалға беруші бейхабар
Dialogue: 0,0:16:38.85,0:16:40.98,Default,,0,0,0,,Менің жеке құпиям
Dialogue: 0,0:16:42.27,0:16:42.98,Default,,0,0,0,,...
Dialogue: 0,0:16:43.48,0:16:45.98,Default,,0,0,0,,Жақсы мектеп оқушыларымен таныстыру
Dialogue: 0,0:16:45.98,0:16:48.40,Default,,0,0,0,,Балаларды жоспарлау және жүзеге асыру
Dialogue: 0,0:16:50.41,0:16:53.70,Default,,0,0,0,,Негізгі жоспар
Dialogue: 0,0:16:53.70,0:16:55.79,Default,,0,0,0,,Келесіні алдын ала оқып шығыңыз.
Dialogue: 0,0:16:55.79,0:16:59.79,Default,,0,0,0,,Бұл менің дүрбелең кезінде басқаларды біріктіру жоспарым.
Dialogue: 0,0:17:00.33,0:17:03.79,Default,,0,0,0,,Дегенмен, басқалар менің жолды үйренгенімді растайды
Dialogue: 0,0:17:04.63,0:17:08.05,Default,,0,0,0,,Хитомишима Маюми Сен менмін.
Dialogue: 0,0:17:08.05,0:17:10.05,Default,,0,0,0,,Мен жолды білемін
Dialogue: 0,0:17:10.05,0:17:13.43,Default,,0,0,0,,Мен әдемі бала іздеймін.
Dialogue: 0,0:17:13.55,0:17:16.06,Default,,0,0,0,,Әдемі скаут 3-бөлім
Dialogue: 0,0:17:16.18,0:17:17.60,Default,,0,0,0,,Көру керек
Dialogue: 0,0:17:17.60,0:17:19.69,Default,,0,0,0,,Сіздің іздеуіңіз қалай аталады?
Dialogue: 0,0:17:19.69,0:17:21.56,Default,,0,0,0,,Мен жолды білемін.
Dialogue: 0,0:17:21.56,0:17:24.94,Default,,0,0,0,,Егер сіз сөйлесетін адамды іздесеңіз, әрине орнатуды аяқтай аласыз.
Dialogue: 0,0:17:25.44,0:17:26.86,Default,,0,0,0,,Сіз келген кезде
Dialogue: 0,0:17:27.32,0:17:28.03,Default,,0,0,0,,Шикізат қаптамасының дизайны
Dialogue: 0,0:17:29.90,0:17:31.32,Default,,0,0,0,,Буып-түю керек
Dialogue: 0,0:17:35.33,0:17:36.58,Default,,0,0,0,,Аяқталған орау
Dialogue: 0,0:17:39.08,0:17:41.33,Default,,0,0,0,,Бұл мен бе?
Dialogue: 0,0:17:41.79,0:17:43.88,Default,,0,0,0,,Сіз әдемі әйел емессіз.
Dialogue: 0,0:17:43.88,0:17:46.50,Default,,0,0,0,,Бұл…, әрине, мен ерекше сақтық шараларын қолдануым керек.
Dialogue: 0,0:17:47.75,0:17:50.26,Default,,0,0,0,,...
Dialogue: 0,0:17:50.55,0:17:51.01,Default,,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:17:51.01,0:17:53.01,Default,,0,0,0,,Өмірді сақтандыру полисі
Dialogue: 0,0:17:53.01,0:17:54.26,Default,,0,0,0,,...
Dialogue: 0,0:17:54.26,0:17:55.72,Default,,0,0,0,,Тәртіпсіздік
Dialogue: 0,0:17:55.72,0:17:56.64,Default,,0,0,0,,Елеулі тәртіп бұзушылық
Dialogue: 0,0:17:57.43,0:17:59.68,Default,,0,0,0,,Ұятсыз мінез-құлық
Dialogue: 0,0:17:59.68,0:18:01.69,Default,,0,0,0,,...
Dialogue: 0,0:18:01.69,0:18:05.23,Default,,0,0,0,,Қолыңызды пайдаланудың ең жақсы уақыты - сіздің ең ұзақ өмір сүруіңіз.
Dialogue: 0,0:18:05.23,0:18:06.40,Default,,0,0,0,,Бұл да сіздің бірегей нүктеңіз.
Dialogue: 0,0:18:06.40,0:18:10.40,Default,,0,0,0,,Сырт келбеті сәл өзгеше сұлу баланың бейнесі аяқталды.
Dialogue: 0,0:18:10.40,0:18:15.41,Default,,0,0,0,,Мектепте дүниеге келген әдемі жас бала көшеде қайтыс болды.
Dialogue: 0,0:18:15.82,0:18:17.41,Default,,0,0,0,,Тартымды адам
Dialogue: 0,0:18:17.95,0:18:20.37,Default,,0,0,0,,...
Dialogue: 0,0:18:20.37,0:18:24.83,Default,,0,0,0,,Қызметкерлердің сыртқы келбеті жақсы және бір сәтсіз болды.
Dialogue: 0,0:18:24.83,0:18:26.63,Default,,0,0,0,,Гарай Кай Сосуке
Dialogue: 0,0:18:26.63,0:18:28.71,Default,,0,0,0,,Болмыстың қажеттілігі
Dialogue: 0,0:18:28.71,0:18:31.67,Default,,0,0,0,,Жазғаныңыз дұрыс
Dialogue: 0,0:18:45.06,0:18:47.98,Default,,0,0,0,,Шуантуин мен саған сұрақ қоя аламын.
Dialogue: 0,0:18:47.98,0:18:49.82,Default,,0,0,0,,Сұлулық туралы сұрақ қандай?
Dialogue: 0,0:18:50.57,0:18:52.78,Default,,0,0,0,,Сен қайдан келдің?
Dialogue: 0,0:18:52.78,0:18:58.08,Default,,0,0,0,,Әдемі жігіт іздесеңіз, бұл дана таңдау.
Dialogue: 0,0:18:58.45,0:18:59.41,Default,,0,0,0,,Мен сенің жағындамын. Сен Диаволоны жеңуді жоспарлап жүрсің, иә?
Dialogue: 0,0:18:59.41,0:19:03.33,Default,,0,0,0,,Толық адасу - бұл анық таңдау.
Dialogue: 0,0:19:03.87,0:19:06.46,Default,,0,0,0,,Алайда заңның мұндай түрі әдемі емес.
Dialogue: 0,0:19:06.96,0:19:08.71,Default,,0,0,0,,Өзімшілдік эстетика
Dialogue: 0,0:19:10.55,0:19:13.05,Default,,0,0,0,,Абстиненция Хитоми Майуми
Dialogue: 0,0:19:13.05,0:19:16.72,Default,,0,0,0,,Мені комиссардың құпиялары қорғамайды.
Dialogue: 0,0:19:17.22,0:19:20.72,Default,,0,0,0,,Әдемі ұл киінген сұлу қыздың оқиғасы
Dialogue: 0,0:19:20.72,0:19:23.60,Default,,0,0,0,,Мен қай уақытта жауап бергім келетінін білмеймін.
Dialogue: 0,0:19:23.60,0:19:26.60,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:19:27.15,0:19:28.94,Default,,0,0,0,,...
Dialogue: 0,0:19:28.94,0:19:31.44,Default,,0,0,0,,Әдемі жігіттің терісі
Dialogue: 0,0:19:31.44,0:19:34.74,Default,,0,0,0,,Менің ішкі ойым мен үшін мүлдем жоғалып кетті.
Dialogue: 0,0:19:35.49,0:19:37.99,Default,,0,0,0,,Қарапайым тікелей бейне - Хайгу Мусуме Ичия
Dialogue: 0,0:19:39.07,0:19:41.33,Default,,0,0,0,,Бұл туралы үнемі ешкім айтып жатқан жоқ.
Dialogue: 0,0:19:41.33,0:19:44.75,Default,,0,0,0,,Кемпірге арналған сиқырлы ауыстыру костюмі
Dialogue: 0,0:19:44.75,0:19:47.08,Default,,0,0,0,,Займай-кай Камиши Оджи Ичиманшо
Dialogue: 0,0:19:47.08,0:19:49.75,Default,,0,0,0,,Сымға кристалдан жасалған аяқ киімдер бекітілген.
Dialogue: 0,0:19:49.75,0:19:53.51,Default,,0,0,0,,Ақиқат, ханзада өзінен тәуелсіз.
Dialogue: 0,0:19:53.92,0:19:57.09,Default,,0,0,0,,Енемнің өлімін көрмедім.
Dialogue: 0,0:19:57.09,0:20:00.47,Default,,0,0,0,,Ана көзінде қиналған бала
Dialogue: 0,0:20:00.47,0:20:03.01,Default,,0,0,0,,...
Dialogue: 0,0:20:03.01,0:20:05.52,Default,,0,0,0,,Аномалия
Dialogue: 0,0:20:06.06,0:20:11.82,Default,,0,0,0,,Жұлдыздан кеткеніңізге 10 жыл болды.
Dialogue: 0,0:20:11.82,0:20:16.19,Default,,0,0,0,,Себепке келсек, сізге осылай қарайды.
Dialogue: 0,0:20:16.19,0:20:18.41,Default,,0,0,0,,Белгілі бір уақытты алуға болады
Dialogue: 0,0:20:18.66,0:20:21.66,Default,,0,0,0,,Аспанда жұлдыз жоқ.
Dialogue: 0,0:20:22.12,0:20:25.79,Default,,0,0,0,,Гуаньюй Бай Гуньянның әңгімесі
Dialogue: 0,0:20:25.79,0:20:28.25,Default,,0,0,0,,Қызығушылық танытқан адам ұсынған 12 ұпай
Dialogue: 0,0:20:28.25,0:20:31.08,Default,,0,0,0,,Сиқырлы астананың жоғалуы
Dialogue: 0,0:20:31.08,0:20:36.51,Default,,0,0,0,,Немістің хрусталь сандалдары түсті.
Dialogue: 0,0:20:36.51,0:20:40.05,Default,,0,0,0,,Сіз білуіңіз керек нәрсе - мәселенің дұрыс екендігі.
Dialogue: 0,0:20:40.05,0:20:45.68,Default,,0,0,0,,Әрине, бұл Өлмейтін Бәйбішенің егжей-тегжейлі түсіндірмесі.
Dialogue: 0,0:20:45.68,0:20:47.31,Default,,0,0,0,,Жастар киінген
Dialogue: 0,0:20:47.77,0:20:49.31,Default,,0,0,0,,Отыратын ат арба
Dialogue: 0,0:20:49.60,0:20:52.11,Default,,0,0,0,,Ұнтақты қабықшада көрсетілгендей
Dialogue: 0,0:20:52.11,0:20:58.57,Default,,0,0,0,,Қамал қамалындағы би кешінің әдемі сұлулығы
Dialogue: 0,0:20:58.57,0:21:02.91,Default,,0,0,0,,Нада есебі немесе сиқырлы кітап
Dialogue: 0,0:21:05.66,0:21:10.33,Default,,0,0,0,,Бірақ мен өз үйімнен қашқан сымбатты жігіт пен сұлу әйелмін деймін.
Dialogue: 0,0:21:11.37,0:21:12.46,Default,,0,0,0,,Жалпы
Dialogue: 0,0:21:13.38,0:21:16.92,Default,,0,0,0,,Сезімтал екеніңіз дұрыс емес.
Dialogue: 0,0:21:16.92,0:21:19.97,Default,,0,0,0,,Жалпы қалаға келмеу туралы хабарлама
Dialogue: 0,0:21:19.97,0:21:21.72,Default,,0,0,0,,Жауап: мен абай емеспін.
Dialogue: 0,0:21:22.43,0:21:25.60,Default,,0,0,0,,...
Dialogue: 0,0:21:25.85,0:21:27.22,Default,,0,0,0,,Бұл баратын жер
Dialogue: 0,0:21:27.22,0:21:32.81,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:21:39.24,0:21:40.15,Default,,0,0,0,,Бірақ, бұл сәл қызығушылық болар…
Dialogue: 0,0:21:40.15,0:21:40.99,Default,,0,0,0,,Мен жолды аламын...
Dialogue: 0,0:21:48.25,0:21:49.04,Default,,0,0,0,,Шынайы оқиға
Dialogue: 0,0:21:49.04,0:21:50.71,Default,,0,0,0,,Алынбады Алынбады
Dialogue: 0,0:21:54.21,0:21:55.21,Default,,0,0,0,,Ол өлген
Dialogue: 0,0:21:55.75,0:21:58.46,Default,,0,0,0,,...
Dialogue: 0,0:21:58.96,0:22:00.22,Default,,0,0,0,,Ой, керемет екен.
Dialogue: 0,0:22:00.63,0:22:03.97,Default,,0,0,0,,Бастапқыда мен қайдамын.
Dialogue: 0,0:00:02.48,0:00:06.49,Default,,0,0,0,,Сотоин-кун менің түсімнің әдемі екенін айтты.
Dialogue: 0,0:00:07.49,0:00:13.24,Default,,0,0,0,,Қиындығымды осындай әдемі сөздермен безендірмесеңіз екен.
Dialogue: 0,0:00:13.24,0:00:15.25,Default,,0,0,0,,Ғарыш ұшағы
Dialogue: 0,0:00:15.25,0:00:21.33,Default,,0,0,0,,Менің мәселем, менің арманым сіз үшін уақытты өлтіретін құрал ғана.
Dialogue: 0,0:00:21.33,0:00:24.75,Default,,0,0,0,,Бірақ мен шынымен де олай емеспін.
Dialogue: 0,0:00:25.42,0:00:28.76,Default,,0,0,0,,Арманымды мазақ етуден алыс,
Dialogue: 0,0:00:29.30,0:00:33.01,Default,,0,0,0,,Олар тіпті оны ұсқынсыз деп санайды.
Dialogue: 0,0:02:07.32,0:02:13.40,Default,,0,0,0,,Ештеңе таппай 14 жасымның таңына жеттім.
Dialogue: 0,0:02:15.99,0:02:17.74,Default,,0,0,0,,Бұл уәде етілген таң
Dialogue: 0,0:02:20.16,0:02:21.79,Default,,0,0,0,,Уақыт аяқталды
Dialogue: 0,0:02:22.50,0:02:26.38,Default,,0,0,0,,Айта кету керек, бас тартуға әлі ерте.
Dialogue: 0,0:02:28.50,0:02:30.76,Default,,0,0,0,,Сіз нені айтасыз? Көшбасшы
Dialogue: 0,0:02:30.76,0:02:34.88,Default,,0,0,0,,Ата-анаңа берген уәдең 14 жасқа дейін болады.
Dialogue: 0,0:02:34.88,0:02:37.39,Default,,0,0,0,,Сіз нешеде дүниеге келдіңіз?
Dialogue: 0,0:02:37.39,0:02:39.26,Default,,0,0,0,,Туған уақыты?
Dialogue: 0,0:02:39.26,0:02:40.85,Default,,0,0,0,,Жақсы
Dialogue: 0,0:02:40.85,0:02:43.02,Default,,0,0,0,,Менің ойымша, кешке жақын болды.
Dialogue: 0,0:02:43.94,0:02:45.23,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:02:45.23,0:02:47.48,Default,,0,0,0,,Иә, мүмкін емес.
Dialogue: 0,0:02:47.48,0:02:48.11,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:02:48.61,0:02:52.49,Default,,0,0,0,,Бұл кешке дейін әлі біраз тоқтау уақыты бар дегенді білдіреді.
Dialogue: 0,0:02:55.36,0:02:58.28,Default,,0,0,0,,Бұл дұрыс болуы мүмкін.
Dialogue: 0,0:02:58.28,0:03:01.70,Default,,0,0,0,,Әйтеуір түнге дейін, әйтеуір, кеш.
Dialogue: 0,0:03:01.70,0:03:04.41,Default,,0,0,0,,Сіз түсінбейсіз, Майуми Хитомижима-кун.
Dialogue: 0,0:03:04.41,0:03:08.63,Default,,0,0,0,,Күнді, айды және басқа аспан денелерін күндіз де бақылауға болады емес пе?
Dialogue: 0,0:03:08.63,0:03:11.50,Default,,0,0,0,,Жоқ, әрине бұл күн мен ай.
Dialogue: 0,0:03:11.50,0:03:12.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:12.55,0:03:14.13,Default,,0,0,0,,Сәлем, Нагахиро
Dialogue: 0,0:03:14.13,0:03:16.88,Default,,0,0,0,,Менің ойымша, сіз мұндай ақымақ пікірді қабылдауға тырыспайсыз.
Dialogue: 0,0:03:17.80,0:03:18.97,Default,,0,0,0,,Жоқ, Мицуру-кун
Dialogue: 0,0:03:18.97,0:03:21.81,Default,,0,0,0,,Бұл жай ғана ақымақ айтқан пікір.
Dialogue: 0,0:03:21.81,0:03:23.77,Default,,0,0,0,,Бұл ақымақ пікір емес.
Dialogue: 0,0:03:23.77,0:03:25.77,Default,,0,0,0,,Нагахиро нені білдіреді?
Dialogue: 0,0:03:26.10,0:03:28.77,Default,,0,0,0,,Жоқ, гипотеза туды.
Dialogue: 0,0:03:29.27,0:03:31.02,Default,,0,0,0,,Менде бір нәрсе бар.
Dialogue: 0,0:03:31.02,0:03:32.07,Default,,0,0,0,,Хитомидзима-сан
Dialogue: 0,0:03:32.44,0:03:34.57,Default,,0,0,0,,Қалай болғанда да, мен үйге келе салысымен
Dialogue: 0,0:03:34.57,0:03:37.78,Default,,0,0,0,,Ата-анаңызды қазіргі басшының логикасын ұстануға мәжбүрлеңіз.
Dialogue: 0,0:03:37.78,0:03:41.03,Default,,0,0,0,,Сабақтан кейін өнер бөлмесіне қайта келе аласыз ба?
Dialogue: 0,0:03:41.53,0:03:44.79,Default,,0,0,0,,Мүмкін жақсы есеп шығарармыз.
Dialogue: 0,0:03:47.46,0:03:50.59,Default,,0,0,0,,Көп нәрсені күтпеу керек, Хитомиджима-чан.
Dialogue: 0,0:03:50.59,0:03:54.67,Default,,0,0,0,,Бұл адам бізге қалыпты болып көрінуі мүмкін, бірақ
Dialogue: 0,0:03:54.67,0:03:57.18,Default,,0,0,0,,Мен бастауыш мектептің бірінші сыныбында оқитын қызбен кездесіп жүрмін.
Dialogue: 0,0:03:57.18,0:03:58.68,Default,,0,0,0,,Өйткені ол лоликон
Dialogue: 0,0:04:00.97,0:04:02.68,Default,,0,0,0,,Бұлай қорықпа
Dialogue: 0,0:04:02.68,0:04:07.06,Default,,0,0,0,,Лоликоннан басқа, Нагахиро жақсы жігіт, оны қазіргі кезде табу қиын.
Dialogue: 0,0:04:07.48,0:04:08.27,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:04:08.27,0:04:14.07,Default,,0,0,0,,Тіпті ең озық хирургиялық әдістер де бұл мүмкіндікті жоя алмайды.
Dialogue: 0,0:04:14.07,0:04:15.07,Default,,0,0,0,,Кохон
Dialogue: 0,0:04:15.40,0:04:17.90,Default,,0,0,0,,Ғашық емес, күйеу жігіт.
Dialogue: 0,0:04:17.90,0:04:20.16,Default,,0,0,0,,Ата-аналар өз бетінше шешім қабылдады.
Dialogue: 0,0:04:20.16,0:04:21.82,Default,,0,0,0,,Көшбасшыны жақсы білетін шығарсыз.
Dialogue: 0,0:04:22.83,0:04:23.45,Default,,0,0,0,,«үшінн мен үшін» мұрагері…
Dialogue: 0,0:04:25.45,0:04:29.83,Default,,0,0,0,,Үлкен үміт күтпеген дұрыс екені рас шығар.
Dialogue: 0,0:04:31.79,0:04:34.84,Default,,0,0,0,,Ата-анам оңай көндірді.
Dialogue: 0,0:04:35.42,0:04:39.34,Default,,0,0,0,,Уәденің мерзімі бүгінгі күн батқанға дейін ұзартылды.
Dialogue: 0,0:04:40.43,0:04:41.84,Default,,0,0,0,,Мен көзілдірікті ұмытып кетіппін
Dialogue: 0,0:04:42.76,0:04:44.35,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:55.07,0:04:56.57,Default,,0,0,0,,Мен оны көремін
Dialogue: 0,0:04:58.65,0:05:01.07,Default,,0,0,0,,Әйтеуір, мектепке ерте бар.
Dialogue: 0,0:05:01.82,0:05:04.58,Default,,0,0,0,,Бірақ тым жылдам жүрмеңіз
Dialogue: 0,0:05:13.46,0:05:14.09,Default,,0,0,0,,Екі адам?
Dialogue: 0,0:05:14.34,0:05:16.38,Default,,0,0,0,,3 адам, соның ішінде артқы жағындағы
Dialogue: 0,0:05:16.38,0:05:17.96,Default,,0,0,0,,Ей, сен танымалсың.
Dialogue: 0,0:05:20.01,0:05:21.34,Default,,0,0,0,,Аа, қазірдің өзінде
Dialogue: 0,0:05:21.84,0:05:22.59,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:05:22.89,0:05:23.97,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:05:23.97,0:05:24.72,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:05:39.44,0:05:40.90,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:05:40.90,0:05:42.49,Default,,0,0,0,,Бұл әрине емес.
Dialogue: 0,0:05:42.49,0:05:44.70,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:05:51.96,0:05:52.83,Default,,0,0,0,,Жүру
Dialogue: 0,0:05:56.04,0:05:57.04,Default,,0,0,0,,Мені жіберме
Dialogue: 0,0:06:07.85,0:06:09.85,Default,,0,0,0,,Аяқтары әдемі Хиота
Dialogue: 0,0:06:10.73,0:06:14.35,Default,,0,0,0,,Сұлулық тек сыртқы көріністе ғана емес пе?
Dialogue: 0,0:06:17.36,0:06:19.73,Default,,0,0,0,,Қалай болды, Хитомиджима-чан?
Dialogue: 0,0:06:20.28,0:06:22.49,Default,,0,0,0,,Сіз қатал ата-анаңызды сендіре алдыңыз ба?
Dialogue: 0,0:06:22.49,0:06:24.74,Default,,0,0,0,,Сонда мен сені көндіре алдым ба?
Dialogue: 0,0:06:24.74,0:06:27.49,Default,,0,0,0,,Жарайды, олар маған уақыт берді.
Dialogue: 0,0:06:28.74,0:06:30.37,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:06:30.37,0:06:32.16,Default,,0,0,0,,Хитомиджима-чан жақсы қыз.
Dialogue: 0,0:06:32.16,0:06:33.87,Default,,0,0,0,,Жақсы қыз болу деген нені білдіреді?
Dialogue: 0,0:06:33.87,0:06:34.71,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:06:34.71,0:06:38.25,Default,,0,0,0,,Мен болсам, мұндай уәдені ешқашан орындамас едім.
Dialogue: 0,0:06:38.67,0:06:42.76,Default,,0,0,0,,Иә, менің ата-анам біраз уақыт бұрын ажырасып кеткен.
Dialogue: 0,0:06:43.55,0:06:45.38,Default,,0,0,0,,Сол кезде сол адамдар
Dialogue: 0,0:06:45.38,0:06:50.10,Default,,0,0,0,,Маған талай рет айтқаны сонша, ажырасып балаларымды аядым.
Dialogue: 0,0:06:50.10,0:06:55.27,Default,,0,0,0,,Жалғызбасты ата-ананың балаларына әйтеуір менсінбей қарайтындықтан шығатын жол.
Dialogue: 0,0:06:55.81,0:06:59.52,Default,,0,0,0,,Ажырассаң балаларың қиналады десең, түсінемін.
Dialogue: 0,0:06:59.52,0:07:02.61,Default,,0,0,0,,Міне, осындай маңызды шешім қабылдауға тура келгенде.
Dialogue: 0,0:07:02.61,0:07:05.78,Default,,0,0,0,,Ол менің ақымақ болғанымды қаламайтынын айтты.
Dialogue: 0,0:07:05.78,0:07:10.33,Default,,0,0,0,,Хитомиджима-чан өз армандарынан бас тартқысы келсе, ол өзінен бас тартуы керек.
Dialogue: 0,0:07:10.33,0:07:12.45,Default,,0,0,0,,Әкем мен анамды аяймын.
Dialogue: 0,0:07:12.45,0:07:15.54,Default,,0,0,0,,Әй, сүйкімді емес, тітіркендіргіш.
Dialogue: 0,0:07:17.88,0:07:20.04,Default,,0,0,0,,Мен шынымен білмеймін.
Dialogue: 0,0:07:20.38,0:07:25.80,Default,,0,0,0,,Неліктен Хитомидзиманың ата-анасы қызының ғарышкер болу арманына қарсы?
Dialogue: 0,0:07:26.22,0:07:27.68,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:07:27.68,0:07:33.68,Default,,0,0,0,,Бұл Хитомиджима-чанның біреу оның көзін айтқан кезде ашулануымен байланысты.
Dialogue: 0,0:07:35.85,0:07:38.44,Default,,0,0,0,,Маңызды емес...
Dialogue: 0,0:07:40.31,0:07:41.19,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:07:42.07,0:07:43.53,Default,,0,0,0,,Мынау не?
Dialogue: 0,0:07:45.74,0:07:47.20,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:07:47.20,0:07:48.20,Default,,0,0,0,,Batchsi
Dialogue: 0,0:07:48.57,0:07:52.20,Default,,0,0,0,,Орта сынып оқушыларының үлкендер қуып кетуіне не кінәлі?
Dialogue: 0,0:07:52.20,0:07:53.62,Default,,0,0,0,,Жоқ...жақсы.
Dialogue: 0,0:07:53.62,0:07:56.21,Default,,0,0,0,,Себебі Сота-кун маған оңай көмектесті.
Dialogue: 0,0:07:56.21,0:07:58.21,Default,,0,0,0,,Жоқ, өте нашар болды.
Dialogue: 0,0:08:05.46,0:08:06.47,Default,,0,0,0,,Маған шай қайнатып берші.
Dialogue: 0,0:08:06.47,0:08:08.72,Default,,0,0,0,,Сіз сондай ақымақсыз.
Dialogue: 0,0:08:09.09,0:08:10.34,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:08:10.34,0:08:11.97,Default,,0,0,0,,Басқалар Ішетін адам
Dialogue: 0,0:08:13.43,0:08:15.73,Default,,0,0,0,,Ойланып қарасам, басшы көрінбейді.
Dialogue: 0,0:08:17.64,0:08:21.36,Default,,0,0,0,,Біз мүшелерден айырмашылығымыз, көшбасшы - Когоро.
Dialogue: 0,0:08:21.36,0:08:22.98,Default,,0,0,0,,Мектептен кейін пайда болады
Dialogue: 0,0:08:22.98,0:08:23.98,Default,,0,0,0,,Когоро...
Dialogue: 0,0:08:24.32,0:08:25.23,Default,,0,0,0,,Бұл?
Dialogue: 0,0:08:25.53,0:08:26.36,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:08:26.36,0:08:29.24,Default,,0,0,0,,Сондықтан сабақ біткенше бізбен бірге болыңыз.
Dialogue: 0,0:08:30.32,0:08:35.04,Default,,0,0,0,,Бүгін таңертең болған оқиғаны барлығына тағы бір рет түсіндірдім.
Dialogue: 0,0:08:35.75,0:08:37.25,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:37.54,0:08:42.13,Default,,0,0,0,,Мен орындағым келмеген жаман болжам орындалғандай.
Dialogue: 0,0:08:42.50,0:08:46.38,Default,,0,0,0,,Нагахиро, сен бұлай болатынын әу бастан білдің бе?
Dialogue: 0,0:08:46.76,0:08:51.14,Default,,0,0,0,,Мен нәрселердің тез дамиды деп күтпедім.
Dialogue: 0,0:08:51.14,0:08:54.89,Default,,0,0,0,,Тексеру басталғаннан кейін ғана оның қауіпті екені анықталды.
Dialogue: 0,0:08:55.26,0:08:59.10,Default,,0,0,0,,Мен Сосаку-кунмен 10 жыл бұрынғы нәрселерді зерттеп жүргенімде,
Dialogue: 0,0:08:59.10,0:09:01.90,Default,,0,0,0,,Жантүршігерлік факті анықталды.
Dialogue: 0,0:09:01.90,0:09:04.40,Default,,0,0,0,,Ащы… факті?
Dialogue: 0,0:09:04.65,0:09:05.52,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:09:05.52,0:09:08.90,Default,,0,0,0,,Мен мұны енді түсіндіремін.
Dialogue: 0,0:09:09.95,0:09:11.41,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:09:13.70,0:09:16.16,Default,,0,0,0,,Тозайтозай
Dialogue: 0,0:09:16.16,0:09:17.79,Default,,0,0,0,,Сабаққа қатысу
Dialogue: 0,0:09:18.20,0:09:23.21,Default,,0,0,0,,Жұлдыздарды іздеу Көшбасшы айтқандай, бұл әдемі өтініш.
Dialogue: 0,0:09:23.21,0:09:27.05,Default,,0,0,0,,Мен өзім бала болғандықтан, толқудан басқаға болмайды.
Dialogue: 0,0:09:27.05,0:09:30.55,Default,,0,0,0,,Өз жұлдызыңды тауып, оны өзің ата
Dialogue: 0,0:09:30.84,0:09:34.18,Default,,0,0,0,,Өзіңізден басқа ешкімге тиесілі емес жұлдыз
Dialogue: 0,0:09:34.18,0:09:36.51,Default,,0,0,0,,Ал егер сүйікті адамыңыздың атын атасаңыз
Dialogue: 0,0:09:36.51,0:09:39.31,Default,,0,0,0,,Бала болған соң, оның мұндай шынайы сезімдері жоқ деп ойлаймын.
Dialogue: 0,0:09:39.31,0:09:39.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:40.06,0:09:42.81,Default,,0,0,0,,Ол бірінші сынып оқушысы, оған еш қатысы жоқ.
Dialogue: 0,0:09:42.81,0:09:44.81,Default,,0,0,0,,Өтінемін, үндеме, Сота-кун.
Dialogue: 0,0:09:45.27,0:09:47.23,Default,,0,0,0,,Қысқасы, менің айтқым келгені
Dialogue: 0,0:09:47.23,0:09:49.86,Default,,0,0,0,,Жұлдыздарды іздеуге арналған әдемі өтініш
Dialogue: 0,0:09:49.86,0:09:55.20,Default,,0,0,0,,Бұл сонымен бірге бүкіл әлемде шешіліп жатқан адамзатқа деген мәңгілік ұмтылыс.
Dialogue: 0,0:09:55.20,0:09:58.79,Default,,0,0,0,,Ғарыш үнемі бақыланады және бақыланады
Dialogue: 0,0:09:58.79,0:10:03.25,Default,,0,0,0,,Осыған қарамастан 10 жыл бойы жұлдыз табылмады.
Dialogue: 0,0:10:03.25,0:10:04.96,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:10:05.50,0:10:06.96,Default,,0,0,0,,Е, Мицуру-кун
Dialogue: 0,0:10:06.96,0:10:09.30,Default,,0,0,0,,Шынында да, егер табиғи түрде түсіндірілсе
Dialogue: 0,0:10:09.30,0:10:11.80,Default,,0,0,0,,Мұндай жұлдыз бірінші кезекте жоқ
Dialogue: 0,0:10:11.80,0:10:15.97,Default,,0,0,0,,Бұл сол кезде 4 жаста болған Хитомидзиманың түсінбестігі сияқты.
Dialogue: 0,0:10:17.35,0:10:22.14,Default,,0,0,0,,Бірақ егер басшы осында болса, мұндай түсіндіру мүлде әдемі болмас еді.
Dialogue: 0,0:10:22.14,0:10:24.60,Default,,0,0,0,,Бұл өте орынды түрде қабылданбайды.
Dialogue: 0,0:10:26.11,0:10:29.86,Default,,0,0,0,,Мен ғаламды үнемі бақылап тұратынын жоғарыда айттым.
Dialogue: 0,0:10:29.86,0:10:32.57,Default,,0,0,0,,Негізі бұл өрнекте қате бар.
Dialogue: 0,0:10:32.57,0:10:35.36,Default,,0,0,0,,Көшбасшының бүгін таңертең айтқан сөзі.
Dialogue: 0,0:10:36.24,0:10:37.37,Default,,0,0,0,,Иә
Dialogue: 0,0:10:37.37,0:10:41.00,Default,,0,0,0,,Астрономиялық бақылау негізінен түнде жүргізіледі, солай емес пе?
Dialogue: 0,0:10:41.00,0:10:44.58,Default,,0,0,0,,Сонымен, ғалам астрономиялық жолмен бақыланады.
Dialogue: 0,0:10:44.58,0:10:46.88,Default,,0,0,0,,Әрқашан емес, жарты күн.
Dialogue: 0,0:10:47.54,0:10:48.13,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:10:48.71,0:10:51.30,Default,,0,0,0,,Сол кездегі мен жасаған гипотеза
Dialogue: 0,0:10:51.30,0:10:54.26,Default,,0,0,0,,Хитомиджима жұлдыздарды көргенде түн ортасы емес еді.
Dialogue: 0,0:10:54.26,0:10:58.14,Default,,0,0,0,,Теория бойынша, бұл түскі ас кезінде болған болуы мүмкін.
Dialogue: 0,0:10:59.76,0:11:01.02,Default,,0,0,0,,Түсте не болды?
Dialogue: 0,0:11:01.68,0:11:03.98,Default,,0,0,0,,Иә, солай болды.
Dialogue: 0,0:11:03.98,0:11:06.73,Default,,0,0,0,,Біріншіден, ол 4 жасар бала.
Dialogue: 0,0:11:06.73,0:11:09.40,Default,,0,0,0,,Мен түнгі әрекеттерге өте нашар болатын жастамын.
Dialogue: 0,0:11:09.40,0:11:10.90,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:11:11.44,0:11:15.40,Default,,0,0,0,,Жапонияда күндіз болса да, шет елде түн ортасы.
Dialogue: 0,0:11:15.40,0:11:18.91,Default,,0,0,0,,Бұл аспан бәрінен бұрын байқауға жазылған емес пе?
Dialogue: 0,0:11:18.91,0:11:19.91,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:11:21.04,0:11:23.41,Default,,0,0,0,,Ғарыштан қай жерден бастауға байланысты
Dialogue: 0,0:11:24.54,0:11:25.87,Default,,0,0,0,,Қысқасы,
Dialogue: 0,0:11:25.87,0:11:30.42,Default,,0,0,0,,Хитомиджима көрген жұлдыз Жерге өте жақын болса.
Dialogue: 0,0:11:30.88,0:11:35.17,Default,,0,0,0,,Бұрыштың әсерінен Жапониядан басқа ешбір жерден байқау мүмкін емес деп айтуға болады.
Dialogue: 0,0:11:35.76,0:11:38.30,Default,,0,0,0,,Сондай-ақ, айды күндіз де көруге болады
Dialogue: 0,0:11:38.30,0:11:43.31,Default,,0,0,0,,Өте жақын болғандықтан, оны күндіз көруге болатын деуге болады.
Dialogue: 0,0:11:43.31,0:11:44.81,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:44.81,0:11:46.89,Default,,0,0,0,,Хмм, солай.
Dialogue: 0,0:11:46.89,0:11:49.69,Default,,0,0,0,,Метеоритті күндіз де көруге болады.
Dialogue: 0,0:11:49.69,0:11:54.07,Default,,0,0,0,,Сонда сіз атмосферада жанып жатқан метеоритті жұлдыз деп қателескен дейсіз бе?
Dialogue: 0,0:11:54.78,0:11:57.95,Default,,0,0,0,,Бірақ егер ол ғарыштан келетін зат болса
Dialogue: 0,0:11:57.95,0:12:03.20,Default,,0,0,0,,Құлау нүктесі Жапонияда болса да, оған бүкіл әлем куә болуы мүмкін.
Dialogue: 0,0:12:04.12,0:12:08.33,Default,,0,0,0,,Дегенмен, сіз негізінен күйіп кету туралы дұрыс айтасыз.
Dialogue: 0,0:12:09.04,0:12:10.00,Default,,0,0,0,,Сакигучи Сенпай
Dialogue: 0,0:12:11.04,0:12:12.84,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:12:14.05,0:12:14.84,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:12:15.63,0:12:17.34,Default,,0,0,0,,Түсіндіруімді сұрай аласыз.
Dialogue: 0,0:12:18.59,0:12:20.59,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:12:21.80,0:12:26.52,Default,,0,0,0,,Жалпы алғанда, ғарыш кеңістігі деп атауға болмайтын биіктіктегі объект
Dialogue: 0,0:12:26.52,0:12:30.44,Default,,0,0,0,,Мен куә болған жұлдыз осы болса
Dialogue: 0,0:12:30.44,0:12:33.61,Default,,0,0,0,,Менің ойымша, бұл енді жаңа деп аталатын нәрсе емес.
Dialogue: 0,0:12:34.48,0:12:37.44,Default,,0,0,0,,Бір күні сол планетаға саяхаттауды қалайтын сияқты.
Dialogue: 0,0:12:37.44,0:12:41.87,Default,,0,0,0,,Мұндай арманның объектісі жұлдыз емес шығар.
Dialogue: 0,0:12:42.41,0:12:44.62,Default,,0,0,0,,Мен қате жасадым
Dialogue: 0,0:12:44.62,0:12:51.13,Default,,0,0,0,,Мен қателесіп, 10 жылымды босқа өткізген болуым керек.
Dialogue: 0,0:12:51.13,0:12:54.59,Default,,0,0,0,,Сондықтан қандай қорытынды жасалса да,
Dialogue: 0,0:12:54.59,0:12:56.42,Default,,0,0,0,,Мен Сакигучи-сенпайды кінәламаймын.
Dialogue: 0,0:12:58.38,0:13:00.38,Default,,0,0,0,,Pretty Boy детективтерін айыптамаңыз
Dialogue: 0,0:13:01.76,0:13:04.39,Default,,0,0,0,,Кез келген қорытынды, кез келген шегерім
Dialogue: 0,0:13:04.64,0:13:09.39,Default,,0,0,0,,Мен оны қателіктерім үшін жауапкершілігім ретінде қабылдаймын.
Dialogue: 0,0:13:10.48,0:13:12.15,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:13:12.15,0:13:13.40,Default,,0,0,0,,Маған хабарлаңыз
Dialogue: 0,0:13:14.15,0:13:17.57,Default,,0,0,0,,Мен сол күні нақты не көрдім?
Dialogue: 0,0:13:21.41,0:13:24.41,Default,,0,0,0,,Жұлдыз жұлдыз болса да, ол жасанды серік.
Dialogue: 0,0:13:26.41,0:13:29.16,Default,,0,0,0,,Жасанды жер серігі де жасанды серік болып табылады.
Dialogue: 0,0:13:31.42,0:13:33.04,Default,,0,0,0,,Әскери спутник
Dialogue: 0,0:13:35.04,0:13:37.84,Default,,0,0,0,,Жеке әскери компания дербес
Dialogue: 0,0:13:37.84,0:13:42.55,Default,,0,0,0,,Жасырын әзірленген әскери спутникті ұшыруды елестетіңіз.
Dialogue: 0,0:13:43.09,0:13:46.06,Default,,0,0,0,,Мұқият алдаудан кейін, әрине.
Dialogue: 0,0:13:46.06,0:13:49.56,Default,,0,0,0,,Басқа мақсат ойлап тауып, аспанға ұшырды
Dialogue: 0,0:13:50.52,0:13:52.90,Default,,0,0,0,,және орындалмады
Dialogue: 0,0:13:52.90,0:13:53.94,Default,,0,0,0,,Сәтсіз қалды ма?
Dialogue: 0,0:13:53.94,0:13:56.82,Default,,0,0,0,,Ол атып түсірілді дегенді білдіреді.
Dialogue: 0,0:13:56.82,0:14:01.57,Default,,0,0,0,,Ол атып түсірілді, бұл да ашылмаған оқиға.
Dialogue: 0,0:14:02.49,0:14:05.03,Default,,0,0,0,,Сонда мен қандай жұлдыздарды көрдім?
Dialogue: 0,0:14:05.03,0:14:10.08,Default,,0,0,0,,Бұл спутник түсірілген кездегі жарық екенін білдіре ме?
Dialogue: 0,0:14:10.41,0:14:12.29,Default,,0,0,0,,Бұл солай болар еді.
Dialogue: 0,0:14:12.79,0:14:14.29,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:14:14.29,0:14:15.54,Default,,0,0,0,,Бұл ғарыш кеңістігі.
Dialogue: 0,0:14:15.54,0:14:16.75,Default,,0,0,0,,Өйткені оттегі жоқ
Dialogue: 0,0:14:16.75,0:14:18.42,Default,,0,0,0,,Сен оны бастауыш мектепте білдің ғой, солай ма?
Dialogue: 0,0:14:18.42,0:14:22.09,Default,,0,0,0,,Оттегісіз заттар жанбайды.
Dialogue: 0,0:14:23.05,0:14:26.10,Default,,0,0,0,,Дұрыс, біз оны бастауыш мектепте оқымаймыз.
Dialogue: 0,0:14:26.64,0:14:29.85,Default,,0,0,0,,Тіпті оттегісіз немесе ғарышта
Dialogue: 0,0:14:29.85,0:14:34.10,Default,,0,0,0,,Осындай ұсақ-түйек нәрселерге қарамастан пайда болатын ерекше жану құбылыстары бар.
Dialogue: 0,0:14:34.90,0:14:36.73,Default,,0,0,0,,Ядролық синтез.
Dialogue: 0,0:14:36.73,0:14:38.69,Default,,0,0,0,,Ядролық ату
Dialogue: 0,0:14:38.69,0:14:41.40,Default,,0,0,0,,Бұны жария ету мүмкін емес.
Dialogue: 0,0:14:41.40,0:14:43.78,Default,,0,0,0,,Ештеңе болмағандай
Dialogue: 0,0:14:43.78,0:14:48.49,Default,,0,0,0,,Іс ешкімге білмей тыныш жабылды.
Dialogue: 0,0:14:50.49,0:14:52.75,Default,,0,0,0,,Маған не болады?
Dialogue: 0,0:14:54.00,0:14:54.75,Default,,0,0,0,,Ұрланған ба?
Dialogue: 0,0:14:56.08,0:14:57.04,Default,,0,0,0,,Ол жойылады ма?
Dialogue: 0,0:14:58.04,0:14:59.50,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:15:00.34,0:15:03.51,Default,,0,0,0,,...
Dialogue: 0,0:15:04.47,0:15:06.43,Default,,0,0,0,,Жоқ, Нагахиро.
Dialogue: 0,0:15:06.43,0:15:08.68,Default,,0,0,0,,Басқа адамның кім екені маңызды емес.
Dialogue: 0,0:15:08.68,0:15:09.51,Default,,0,0,0,,Бұл біз.
Dialogue: 0,0:15:10.43,0:15:12.02,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:15:12.43,0:15:15.52,Default,,0,0,0,,Ересек адамның қандай жағдайда болғаны маңызды емес.
Dialogue: 0,0:15:16.06,0:15:18.52,Default,,0,0,0,,Біз ұлдармыз
Dialogue: 0,0:15:21.23,0:15:23.78,Default,,0,0,0,,Бұл қандай адамдар?
Dialogue: 0,0:15:24.32,0:15:26.66,Default,,0,0,0,,...
Dialogue: 0,0:15:28.95,0:15:30.66,Default,,0,0,0,,Әдемі бала детектив тобы
Dialogue: 0,0:15:32.16,0:15:33.91,Default,,0,0,0,,Жоқ, мен бақыттымын.
Dialogue: 0,0:15:34.62,0:15:37.04,Default,,0,0,0,,...
Dialogue: 0,0:15:37.79,0:15:40.79,Default,,0,0,0,,...
Dialogue: 0,0:15:45.51,0:15:49.05,Default,,0,0,0,,Шынымен полицияға хабарласуым керек пе?
Dialogue: 0,0:15:49.05,0:15:51.26,Default,,0,0,0,,Мені күлкіге қалдыруы мүмкін.
Dialogue: 0,0:15:51.81,0:15:56.52,Default,,0,0,0,,10 жыл бұрын мен әскери жерсерікті ядролық қарумен атып түсіргеніне куә болдым
Dialogue: 0,0:15:56.52,0:15:59.77,Default,,0,0,0,,Мен мұны айтсам да сенбейсіз деп ойлаймын.
Dialogue: 0,0:16:00.11,0:16:02.02,Default,,0,0,0,,...
Dialogue: 0,0:16:02.44,0:16:04.99,Default,,0,0,0,,Дәлеліңіз болмаса, неге дәлелдемеске?
Dialogue: 0,0:16:04.99,0:16:09.03,Default,,0,0,0,,...
Dialogue: 0,0:16:10.24,0:16:14.33,Default,,0,0,0,,Сол себепті, олардың біреуі ғана қолға түссе.
Dialogue: 0,0:16:14.33,0:16:16.29,Default,,0,0,0,,Бұл тірі дәлел емес.
Dialogue: 0,0:16:17.71,0:16:19.63,Default,,0,0,0,,Бұл қауіпті стратегия.
Dialogue: 0,0:16:19.63,0:16:22.63,Default,,0,0,0,,Қосарланған қалдық, әрине, сақ болу керек.
Dialogue: 0,0:16:22.63,0:16:24.92,Default,,0,0,0,,Олардың қарулы болу мүмкіндігі бар.
Dialogue: 0,0:16:25.17,0:16:25.92,Default,,0,0,0,,Қару-жарақ
Dialogue: 0,0:16:25.92,0:16:27.67,Default,,0,0,0,,Олай болса орындауға рұқсат етіңіз.
Dialogue: 0,0:16:28.22,0:16:31.18,Default,,0,0,0,,Мен осындай кездер үшін осындамын.
Dialogue: 0,0:16:31.93,0:16:32.68,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:16:32.68,0:16:36.68,Default,,0,0,0,,...
Dialogue: 0,0:16:37.31,0:16:38.85,Default,,0,0,0,,Сенімді болыңыз, мырзалар.
Dialogue: 0,0:16:38.85,0:16:40.98,Default,,0,0,0,,Менің құпия жоспарым бар
Dialogue: 0,0:16:42.27,0:16:42.98,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:43.48,0:16:45.98,Default,,0,0,0,,Енді, балалар, сыныпқа барыңдар.
Dialogue: 0,0:16:45.98,0:16:48.40,Default,,0,0,0,,Құпия жоспар - жаман балалармен жалғастыру.
Dialogue: 0,0:16:50.41,0:16:53.70,Default,,0,0,0,,Негізінен Тота әзірлеген стратегияны ұстанады.
Dialogue: 0,0:16:53.70,0:16:55.79,Default,,0,0,0,,Олар сені жоғалтып алсын
Dialogue: 0,0:16:55.79,0:16:59.79,Default,,0,0,0,,Менің ойым олардың ренжісіп қалмау болды.
Dialogue: 0,0:17:00.33,0:17:03.79,Default,,0,0,0,,Бірақ, әрине, мектептер бұзылды.
Dialogue: 0,0:17:04.63,0:17:08.05,Default,,0,0,0,,Бізді кім деп ойлайсың, Майуми Хитомиджима?
Dialogue: 0,0:17:08.05,0:17:10.05,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін.
Dialogue: 0,0:17:10.05,0:17:13.43,Default,,0,0,0,,Мықты болыңыз, бұл әдемі бала детектив тобы.
Dialogue: 0,0:17:13.55,0:17:16.06,Default,,0,0,0,,Әдемі бала детектив тобының ережелері 3-бөлім
Dialogue: 0,0:17:16.18,0:17:17.60,Default,,0,0,0,,Детектив болу
Dialogue: 0,0:17:17.60,0:17:19.69,Default,,0,0,0,,Ал детектив дегенді қалай түсінесіңдер?
Dialogue: 0,0:17:19.69,0:17:21.56,Default,,0,0,0,,Мен білмеймін. Бұл не?
Dialogue: 0,0:17:21.56,0:17:24.94,Default,,0,0,0,,Детективтерді ойлағанда, сіз бетперделерді ойлайсыз.
Dialogue: 0,0:17:25.44,0:17:26.86,Default,,0,0,0,,Жасау кезегі сізде
Dialogue: 0,0:17:27.32,0:17:28.03,Default,,0,0,0,,Оны аяқтаңыз
Dialogue: 0,0:17:29.90,0:17:31.32,Default,,0,0,0,,Аяқталды
Dialogue: 0,0:17:35.33,0:17:36.58,Default,,0,0,0,,аяқталды
Dialogue: 0,0:17:39.08,0:17:41.33,Default,,0,0,0,,Бұл... бұл мен бе?
Dialogue: 0,0:17:41.79,0:17:43.88,Default,,0,0,0,,Сіз әдемі адамдарды жек көрмейсіз бе?
Dialogue: 0,0:17:43.88,0:17:46.50,Default,,0,0,0,,Мен...Мен сені жек көремін, мен сені қатты жек көремін.
Dialogue: 0,0:17:47.75,0:17:50.26,Default,,0,0,0,,Маған бұлай қарауды жек көремін.
Dialogue: 0,0:17:50.55,0:17:51.01,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:51.01,0:17:53.01,Default,,0,0,0,,Өмірмен алмастырылмайтын заттар
Dialogue: 0,0:17:53.01,0:17:54.26,Default,,0,0,0,,Мен бүгін ғана қалдырамын
Dialogue: 0,0:17:54.26,0:17:55.72,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:17:55.72,0:17:56.64,Default,,0,0,0,,Өте нашар
Dialogue: 0,0:17:57.43,0:17:59.68,Default,,0,0,0,,Саған не болды, Сотоин-кун?
Dialogue: 0,0:17:59.68,0:18:01.69,Default,,0,0,0,,Бұл тым әдемі Жаратылыс
Dialogue: 0,0:18:01.69,0:18:05.23,Default,,0,0,0,,Мен әрқашан айтқанымдай, сіздің ең үлкен күшіңіз - сіз өте шеберсіз.
Dialogue: 0,0:18:05.23,0:18:06.40,Default,,0,0,0,,Жалғыз кемшілік
Dialogue: 0,0:18:06.40,0:18:10.40,Default,,0,0,0,,Біз сияқты қылықтары көп сұлу бала болса, жарайды.
Dialogue: 0,0:18:10.40,0:18:15.41,Default,,0,0,0,,Осындай православиелік сымбатты бала қасында қызсыз мектепті тастап кетсе, қызық емес пе?
Dialogue: 0,0:18:15.82,0:18:17.41,Default,,0,0,0,,Ол шын мәнінде назар аударады.
Dialogue: 0,0:18:17.95,0:18:20.37,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:18:20.37,0:18:24.83,Default,,0,0,0,,Сондай-ақ, басшының міндеті - мүшелердің нашар көрсеткіштерін емес, жақсы көрсеткіштерін қадағалау.
Dialogue: 0,0:18:24.83,0:18:26.63,Default,,0,0,0,,Мен терімді шешемін
Dialogue: 0,0:18:26.63,0:18:28.71,Default,,0,0,0,,Қажеттілік туындады
Dialogue: 0,0:18:28.71,0:18:31.67,Default,,0,0,0,,Мен сендерге басқа жұмысты тапсырамын.Жасау
Dialogue: 0,0:18:45.06,0:18:47.98,Default,,0,0,0,,Эй, Сотоин-кун, сен маған сұрақ қоя аласың.
Dialogue: 0,0:18:47.98,0:18:49.82,Default,,0,0,0,,Сұрақ әдемі болса
Dialogue: 0,0:18:50.57,0:18:52.78,Default,,0,0,0,,Неліктен мұндай әрекетке барар едіңіз?
Dialogue: 0,0:18:52.78,0:18:58.08,Default,,0,0,0,,Сізге, сүйкімді бала детектив тобына осында шегінгеніңіз дұрыс емес пе?
Dialogue: 0,0:18:58.45,0:18:59.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:59.41,0:19:03.33,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін, бірақ бұл, әрине, ақылды қадам.
Dialogue: 0,0:19:03.87,0:19:06.46,Default,,0,0,0,,Бірақ оның жасалу жолы әдемі емес.
Dialogue: 0,0:19:06.96,0:19:08.71,Default,,0,0,0,,Бұл менің эстетикама қайшы келеді.
Dialogue: 0,0:19:10.55,0:19:13.05,Default,,0,0,0,,Уайымдама, Майуми Хитомиджима-кун
Dialogue: 0,0:19:13.05,0:19:16.72,Default,,0,0,0,,Біз құпиялылықты қорғамаймыз, бірақ біздің клиенттеріміз қорғайды.
Dialogue: 0,0:19:17.22,0:19:20.72,Default,,0,0,0,,Маған әдемі ұл ғана емес, сұлу қыз да айтты.
Dialogue: 0,0:19:20.72,0:19:23.60,Default,,0,0,0,,Мен өзімді дәрменсіз сезіндім.
Dialogue: 0,0:19:23.60,0:19:26.60,Default,,0,0,0,,Бұл ұят па, әлде аянышты ма?
Dialogue: 0,0:19:27.15,0:19:28.94,Default,,0,0,0,,Оны әдемі етіп құрастырыңыз
Dialogue: 0,0:19:28.94,0:19:31.44,Default,,0,0,0,,Қатаңдықты сұлу бала бітірсе де
Dialogue: 0,0:19:31.44,0:19:34.74,Default,,0,0,0,,Өйткені, менің ішімдегі нәрсе тек мен ғана.
Dialogue: 0,0:19:35.49,0:19:37.99,Default,,0,0,0,,Дәл Золушка сияқты
Dialogue: 0,0:19:39.07,0:19:41.33,Default,,0,0,0,,Білесіз бе, бұл жиі айтылады.
Dialogue: 0,0:19:41.33,0:19:44.75,Default,,0,0,0,,Золушка әжесінің сиқырымен киінді.
Dialogue: 0,0:19:44.75,0:19:47.08,Default,,0,0,0,,Ханзада маған допқа қарады
Dialogue: 0,0:19:47.08,0:19:49.75,Default,,0,0,0,,Оларға әйнек тәпішке арқылы іздеуді сұраңыз.
Dialogue: 0,0:19:49.75,0:19:53.51,Default,,0,0,0,,Ол өзі ештеңе істемейтін пассивті ханшайым.
Dialogue: 0,0:19:53.92,0:19:57.09,Default,,0,0,0,,Менің ойымша Золушка ештеңе істеген жоқ.
Dialogue: 0,0:19:57.09,0:20:00.47,Default,,0,0,0,,Жаман анасының басынан өткен қиын күндерді
Dialogue: 0,0:20:00.47,0:20:03.01,Default,,0,0,0,,Бұл сізді марапаттау үшін жеткілікті.
Dialogue: 0,0:20:03.01,0:20:05.52,Default,,0,0,0,,Сауап алмасаң одан да жаман.
Dialogue: 0,0:20:06.06,0:20:11.82,Default,,0,0,0,,10々
Dialogue: 0,0:20:11.82,0:20:16.19,Default,,0,0,0,,Сондықтан біз кездестік, біз оны ешқашан босқа жібермейміз.
Dialogue: 0,0:20:16.19,0:20:18.41,Default,,0,0,0,,Сізге міндетті түрде сыйлық беріледі
Dialogue: 0,0:20:18.66,0:20:21.66,Default,,0,0,0,,Ол жұлдыз жоқ болса да
Dialogue: 0,0:20:22.12,0:20:25.79,Default,,0,0,0,,『』
Dialogue: 0,0:20:25.79,0:20:28.25,Default,,0,0,0,,12
