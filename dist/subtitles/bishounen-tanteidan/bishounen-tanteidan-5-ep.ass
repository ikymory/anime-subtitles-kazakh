Dialogue: 0,0:21:55.79,0:21:56.38,EDCN,,0,0,0,,«Қарсы алу күндері!»
Dialogue: 0,0:21:56.38,0:22:02.80,EDCN,,0,0,0,,Бұл әлемдегі ең үлкен үміт.
Dialogue: 0,0:22:02.80,0:22:04.80,EDCN,,0,0,0,,Бұл әлемдегі ең үлкен үміт.
Dialogue: 0,0:22:12.02,0:22:18.90,EDCN,,0,0,0,,Қарапайым күнделікті өмір
Dialogue: 0,0:22:18.90,0:22:25.82,EDCN,,0,0,0,,Ең таза емес жұмбақтардың бірі
Dialogue: 0,0:22:25.82,0:22:31.00,EDCN,,0,0,0,,Оның азды-көпті екені даусыз.
Dialogue: 0,0:22:31.00,0:22:38.38,EDCN,,0,0,0,,Батыл сөйлей алсаң, болашақта талантың дамиды.
Dialogue: 0,0:22:38.38,0:22:45.18,EDCN,,0,0,0,,Бұл бастапқы өмір - көктегі арман.
Dialogue: 0,0:22:45.18,0:22:53.06,EDCN,,0,0,0,,...
Dialogue: 0,0:22:53.06,0:22:55.10,EDCN,,0,0,0,,«Жүр, төмен түс».
Dialogue: 0,0:22:55.31,0:23:00.98,EDCN,,0,0,0,,Таусыз күндер мен түндер жұлдыздар жарығы
Dialogue: 0,0:23:00.98,0:23:07.32,EDCN,,0,0,0,,Болашақтағы оқиғаларды жазу
Dialogue: 0,0:23:07.32,0:23:08.99,EDCN,,0,0,0,,«Қарсы алу күндері!»
Dialogue: 0,0:23:08.99,0:23:09.62,EDCN,,0,0,0,,Эго туралы күмән жоқ
Dialogue: 0,0:23:09.62,0:23:11.91,EDCN,,0,0,0,,Эго туралы күмән жоқ
Dialogue: 0,0:23:11.91,0:23:14.21,EDCN,,0,0,0,,Эго туралы күмән жоқ
Dialogue: 0,0:23:14.21,0:23:15.12,EDCN,,0,0,0,,Эго туралы күмән жоқ
Dialogue: 0,0:23:15.12,0:23:16.50,EDCN,,0,0,0,,Сіз шексіз зергерлік бұйымдармен жүрегіңіздің құндылығын бөлісе аласыз
Dialogue: 0,0:23:16.50,0:23:18.08,EDCN,,0,0,0,,Жүрегіңіздегі асыл тастармен шексіз бөлісе аласыз.
Dialogue: 0,0:23:18.08,0:23:18.79,EDCN,,0,0,0,,Жүрегіңіздің асылын шексіз бөлісе аласыз.
Dialogue: 0,0:23:18.79,0:23:23.01,EDCN,,0,0,0,,Жүрегіңіздегі асыл тастармен шексіз бөлісе аласыз.
Dialogue: 1,0:00:11.05,0:00:11.76,Text - CN,,0,0,0,,Бұл кәрілік емес...
Dialogue: 1,0:00:12.56,0:00:15.46,Text - CN,,0,0,0,,Ойынды тамашалаған тағы бір тамақ
Dialogue: 1,0:00:16.47,0:00:18.20,Text - CN,,0,0,0,,Мүмкін... Нашар Дугаку мүмкін
Dialogue: 1,0:00:18.20,0:00:20.00,Text - CN,,0,0,0,,Нашар оқушы?
Dialogue: 1,0:00:20.00,0:00:24.58,Text - CN,,0,0,0,,Жұмысқа келгенде мен сені көрмеймін.
Dialogue: 1,0:00:24.58,0:00:27.65,Text - CN,,0,0,0,,Қазіргі уақытта...қазір қол жетімді емес
Dialogue: 1,0:00:27.65,0:00:29.88,Text - CN,,0,0,0,,Басқалар...басқа адамдар
Dialogue: 1,0:00:29.88,0:00:33.51,Text - CN,,0,0,0,,Ақаулы... Қолайсыздық үшін кешірім сұраймын.
Dialogue: 1,0:00:33.89,0:00:36.77,Text - CN,,0,0,0,,Менімен келіспегеніңізді естігеніме өкінемін.
Dialogue: 1,0:00:37.15,0:00:40.02,Text - CN,,0,0,0,,Өлген адамның тәжірибесі
Dialogue: 1,0:00:40.57,0:00:46.03,Text - CN,,0,0,0,,Жау қария болуы мүмкін.
Dialogue: 1,0:00:48.74,0:00:51.66,Text - CN,,0,0,0,,Шарттар мен талаптардың анық көрінісі.
Dialogue: 1,0:00:55.03,0:00:57.66,Text - CN,,0,0,0,,барлығында
Dialogue: 1,0:01:07.42,0:01:09.92,Text - CN,,0,0,0,,барлығы аяқталды!
Dialogue: 1,0:01:10.27,0:01:13.82,Text - CN,,0,0,0,,Бұл қарапайым плитка түрі.
Dialogue: 1,0:01:13.82,0:01:17.93,Text - CN,,0,0,0,,Алайда, бұл орын алғаннан кейін ұтыс картасы ауыстырылады
Dialogue: 1,0:01:17.93,0:01:20.44,Text - CN,,0,0,0,,Угая бір қарағанда анық көрінеді
Dialogue: 1,0:01:20.99,0:01:25.57,Text - CN,,0,0,0,,Сайып келгенде, бұл ерекше көзқарас.
Dialogue: 1,0:01:25.57,0:01:28.19,Text - CN,,0,0,0,,Инвестицияның сәттілігі туралы хабарландыру
Dialogue: 1,0:03:02.36,0:03:04.04,Text - CN,,0,0,0,,Рахмет жарық
Dialogue: 1,0:03:04.41,0:03:07.75,Text - CN,,0,0,0,,Күтілетін үй иесі екінші жарық
Dialogue: 1,0:03:07.75,0:03:11.03,Text - CN,,0,0,0,,Әдемі ұлдар мен қыздарды іздейтіндердің барлығына
Dialogue: 1,0:03:12.84,0:03:14.05,Text - CN,,0,0,0,,Басқалар
Dialogue: 1,0:03:16.49,0:03:18.30,Text - CN,,0,0,0,,Император Жиокадзудың жаңа киімдері
Dialogue: 1,0:03:19.27,0:03:22.85,Text - CN,,0,0,0,,Қара киім киген адам көзге көрінбейді.
Dialogue: 1,0:03:23.49,0:03:27.94,Text - CN,,0,0,0,,Алайда бір ғана адам бар, ол Хитоми, екіншісі бар.
Dialogue: 1,0:03:29.24,0:03:31.19,Text - CN,,0,0,0,,Дұрыс емес
Dialogue: 1,0:03:31.58,0:03:34.39,Text - CN,,0,0,0,,Мен саяхатты бастадым
Dialogue: 1,0:03:34.39,0:03:38.27,Text - CN,,0,0,0,,Жиналыс басталғанға дейінгі ағымдағы жағдайдың егжей-тегжейлері
Dialogue: 1,0:03:39.87,0:03:42.70,Text - CN,,0,0,0,,Сіз бұл туралы осылай ойлайсыз.
Dialogue: 1,0:03:43.60,0:03:46.96,Text - CN,,0,0,0,,Бұл бет сізге оқуға және түсінуге арналған.
Dialogue: 1,0:03:47.45,0:03:51.59,Text - CN,,0,0,0,,Кіріспе
Dialogue: 1,0:03:52.10,0:03:55.92,Text - CN,,0,0,0,,Бұл да сондай жақсы.
Dialogue: 1,0:03:58.97,0:04:00.72,Text - CN,,0,0,0,,Құрметті баршаңызға!
Dialogue: 1,0:04:01.27,0:04:03.63,Text - CN,,0,0,0,,Жұмысқа байланысты барлық оқу әрекеттері
Dialogue: 1,0:04:03.63,0:04:06.89,Text - CN,,0,0,0,,Мен әдемі ұлдар мен қыздар тобының мүшесімін.
Dialogue: 1,0:04:07.12,0:04:10.73,Text - CN,,0,0,0,,Бұл студенттер бірлестігінің ұзақ тарихы.
Dialogue: 1,0:04:10.97,0:04:16.36,Text - CN,,0,0,0,,Осыған байланысты бірінші жазбаны оқып шығыңыз.
Dialogue: 1,0:04:17.81,0:04:20.98,Text - CN,,0,0,0,,Басынан бері басқа мәселелер
Dialogue: 1,0:04:20.98,0:04:24.24,Text - CN,,0,0,0,,Кейбір нәтижелерге қол жеткізуге болады.
Dialogue: 1,0:04:24.24,0:04:27.15,Text - CN,,0,0,0,,Басқа фильмдер туралы айтайық.
Dialogue: 1,0:04:27.15,0:04:30.75,Text - CN,,0,0,0,,Басқа мектептің оқушысы, жеке өзі Моригучи Нёхай
Dialogue: 1,0:04:31.18,0:04:36.51,Text - CN,,0,0,0,,Мен өзімді өзімшіл адам екенімді көру оңай емес деп ойлаймын.
Dialogue: 1,0:04:38.54,0:04:42.84,Text - CN,,0,0,0,,Бірінші кіші орта мектеп оқушыларына ұқсамайды.
Dialogue: 1,0:04:42.84,0:04:46.47,Text - CN,,0,0,0,,Мен оны алғаш оқыған кездегі марапаттар мен шығындар
Dialogue: 1,0:04:46.47,0:04:49.52,Text - CN,,0,0,0,,Басқаларында еркін мектеп стилі бар.
Dialogue: 1,0:04:49.81,0:04:52.92,Text - CN,,0,0,0,,Өзіне және басқаларға қабылданғаннан кейінгі марапаттар мен жеңілдіктер
Dialogue: 1,0:04:52.92,0:04:57.78,Text - CN,,0,0,0,,Басқалары мектептің жалпы ережелерін орындады.
Dialogue: 1,0:04:58.27,0:05:01.53,Text - CN,,0,0,0,,Басқа ақпарат
Dialogue: 1,0:05:01.53,0:05:05.27,Text - CN,,0,0,0,,Мен жақында дарынды студенттік кеңестің президенті болдым.
Dialogue: 1,0:05:05.27,0:05:08.03,Text - CN,,0,0,0,,Дегенмен, басқаларды басқару қабілеті
Dialogue: 1,0:05:08.03,0:05:11.04,Text - CN,,0,0,0,,Мектепке қабылдаудың басталуы
Dialogue: 1,0:05:11.51,0:05:16.05,Text - CN,,0,0,0,,Басқа біліктілік және коммерциялық қабілет
Dialogue: 1,0:05:16.33,0:05:19.14,Text - CN,,0,0,0,,Жаңадан бастаушылар мен орта мектеп оқушылары үшін басқа қызметкерлер
Dialogue: 1,0:05:19.14,0:05:23.05,Text - CN,,0,0,0,,Өмірімнің басынан бастап мен басқа да кәсіпкерлік қызметпен айналыстым.
Dialogue: 1,0:05:23.58,0:05:28.68,Text - CN,,0,0,0,,Басқа адамдардың басқаруында
Dialogue: 1,0:05:30.82,0:05:33.25,Text - CN,,0,0,0,,Хитомишиманың өлімі
Dialogue: 1,0:05:33.25,0:05:38.07,Text - CN,,0,0,0,,Түлектердің студенттік кеңесінің төрағасы Мен сізбен бұрын байланыста болғанмын.
Dialogue: 1,0:05:38.67,0:05:42.57,Text - CN,,0,0,0,,Сондықтан мен таза басқа адаммын.
Dialogue: 1,0:05:42.86,0:05:49.91,Text - CN,,0,0,0,,Мектепте мектепке бару үшін жеткілікті адам болуы керек.
Dialogue: 1,0:05:49.91,0:05:54.58,Text - CN,,0,0,0,,Жақында басқа мектеп
Dialogue: 1,0:05:55.40,0:06:00.22,Text - CN,,0,0,0,,...
Dialogue: 1,0:06:00.22,0:06:02.72,Text - CN,,0,0,0,,Мен осындай ойға келдім.
Dialogue: 1,0:06:04.46,0:06:11.60,Text - CN,,0,0,0,,Сацуцукидің басқа улы тырнақтарының соңы мектепке дейін созылды.
Dialogue: 1,0:06:14.96,0:06:17.74,Text - CN,,0,0,0,,Мен Сатсуки жағдайын түсінемін.
Dialogue: 1,0:06:17.74,0:06:19.23,Text - CN,,0,0,0,,Дегенмен, Манабу Сакигучи
Dialogue: 1,0:06:22.57,0:06:24.49,Text - CN,,0,0,0,,Қорытынды – әңгіме
Dialogue: 1,0:06:25.16,0:06:27.24,Text - CN,,0,0,0,,...
Dialogue: 1,0:06:27.64,0:06:30.87,Text - CN,,0,0,0,,Егер сіз мұны қайта оқығыңыз келсе, келесі ақпаратты оқыңыз.
Dialogue: 1,0:06:31.20,0:06:34.12,Text - CN,,0,0,0,,Бұл идеяны менің де ойлап тапқаным емес.
Dialogue: 1,0:06:34.85,0:06:38.13,Text - CN,,0,0,0,,Хитомиджима 20 сабақ
Dialogue: 1,0:06:38.13,0:06:41.63,Text - CN,,0,0,0,,Жиырма жұп!? Жиырма жұп?
Dialogue: 1,0:06:42.16,0:06:45.89,Text - CN,,0,0,0,,Жиырма жұпты жоғалтып алғаныңызды естіп, өкінішті.
Dialogue: 1,0:06:45.89,0:06:49.03,Text - CN,,0,0,0,,...
Dialogue: 1,0:06:49.03,0:06:52.02,Text - CN,,0,0,0,,Әдемі әйел! Ашық киім киген әдемі әйел
Dialogue: 1,0:06:52.35,0:06:53.81,Text - CN,,0,0,0,,Көрінбеген тағы да келді
Dialogue: 1,0:06:53.81,0:06:55.77,Text - CN,,0,0,0,,Сондай-ақ қайта көрмеген
Dialogue: 1,0:06:55.77,0:07:01.60,Text - CN,,0,0,0,,Мен өзімнің талантым мен келіспеушілігім туралы қалай ойлаймын?
Dialogue: 1,0:07:04.72,0:07:07.06,Text - CN,,0,0,0,,...
Dialogue: 1,0:07:07.06,0:07:10.25,Text - CN,,0,0,0,,Сонымен қатар, Вана қайда барады?
Dialogue: 1,0:07:10.25,0:07:17.29,Text - CN,,0,0,0,,Осы уақытқа дейін мен 20 ауданына оралдым.
Dialogue: 1,0:07:17.65,0:07:22.58,Text - CN,,0,0,0,,Қайта кездескен кезде мен не туралы ойлаймын?
Dialogue: 1,0:07:22.58,0:07:29.04,Text - CN,,0,0,0,,Өйткені мен құрғаным осы, мен жасаған ұйым осы.
Dialogue: 1,0:07:29.78,0:07:32.06,Text - CN,,0,0,0,,...
Dialogue: 1,0:07:32.69,0:07:36.38,Text - CN,,0,0,0,,Оқуға оңай Басқа қызметкерлер жөнелтуші персонал болып табылады
Dialogue: 1,0:07:36.38,0:07:37.81,Text - CN,,0,0,0,,Адамдар және заттар
Dialogue: 1,0:07:37.81,0:07:42.07,Text - CN,,0,0,0,,Басқа жұмыстар тағайындалған «сатып алу» аудару нүктесі болып табылады
Dialogue: 1,0:07:44.35,0:07:51.73,Text - CN,,0,0,0,,Жазу кезінде қазіргі уақытта қатысып отырған адамның ақпараты туралы ақпарат.
Dialogue: 1,0:07:51.73,0:07:55.98,Text - CN,,0,0,0,,...
Dialogue: 1,0:07:55.98,0:07:59.10,Text - CN,,0,0,0,,Ariwa Twenty Groups арасындағы сауданың іздері
Dialogue: 1,0:07:59.10,0:08:00.29,Text - CN,,0,0,0,,Сауда?
Dialogue: 1,0:08:00.29,0:08:03.43,Text - CN,,0,0,0,,Ескі жолбарыс машинасы жапондық табақ
Dialogue: 1,0:08:03.43,0:08:04.91,Text - CN,,0,0,0,,...
Dialogue: 1,0:08:04.91,0:08:08.05,Text - CN,,0,0,0,,Алайда екпіннің жоқтығы тривиальды.
Dialogue: 1,0:08:08.35,0:08:13.56,Text - CN,,0,0,0,,Белгілі бір жеке компания Сатсукидегі жалпы даму процесі кезінде тауар алмасуды аяқтады.
Dialogue: 1,0:08:14.35,0:08:19.56,Text - CN,,0,0,0,,Қытай өнімдері үшін басқа айғақтар
Dialogue: 1,0:08:20.24,0:08:23.12,Text - CN,,0,0,0,,Сацукикаи ұзақ мерзімді негізгі табысы
Dialogue: 1,0:08:23.12,0:08:28.86,Text - CN,,0,0,0,,Жалпы емтихандарға арналған ұқсас өнім әсерлері бар.
Dialogue: 1,0:08:28.86,0:08:31.97,Text - CN,,0,0,0,,Ондық? Есеп алудың негізгі көзі ме?
Dialogue: 1,0:08:31.97,0:08:34.63,Text - CN,,0,0,0,,Еңбек қалауларының түрлері
Dialogue: 1,0:08:34.63,0:08:37.83,Text - CN,,0,0,0,,Жұмысқа орналасу үшін қайда өтініш беру керек
Dialogue: 1,0:08:37.83,0:08:42.48,Text - CN,,0,0,0,,Бұл не дұрыс емес?
Dialogue: 1,0:08:42.48,0:08:47.34,Text - CN,,0,0,0,,Қазіргі уақытта Сатсуки қабылдау комиссиясының өнімдері сынақтан өтуде.
Dialogue: 1,0:08:47.66,0:08:50.84,Text - CN,,0,0,0,,Дұрыс аты Хитомидзима ауыз, қара киім.
Dialogue: 1,0:08:51.05,0:08:54.85,Text - CN,,0,0,0,,Бұл жаттығуға қабілетті адамның қара шапаны.
Dialogue: 1,0:08:55.18,0:08:57.73,Text - CN,,0,0,0,,Барлық сертификаттауларды аяқтау
Dialogue: 1,0:08:58.05,0:09:00.73,Text - CN,,0,0,0,,Басқа орындардың көпшілігі пайдалануға болады.
Dialogue: 1,0:09:01.38,0:09:03.48,Text - CN,,0,0,0,,Қолдану көрінісі
Dialogue: 1,0:09:03.76,0:09:06.48,Text - CN,,0,0,0,,Тестке келуге арналған қара халаттар
Dialogue: 1,0:09:06.93,0:09:10.74,Text - CN,,0,0,0,,Байқап көріңіз және көріңіз.
Dialogue: 1,0:09:12.47,0:09:15.43,Text - CN,,0,0,0,,Сенде қандай киім бар?
Dialogue: 1,0:09:15.43,0:09:18.37,Text - CN,,0,0,0,,...
Dialogue: 1,0:09:19.01,0:09:20.96,Text - CN,,0,0,0,,Басқа уақытта ауа жоғалады.
Dialogue: 1,0:09:21.55,0:09:25.38,Text - CN,,0,0,0,,Мен оны пайдаланудан қорқамын.
Dialogue: 1,0:09:25.38,0:09:29.96,Text - CN,,0,0,0,,Дегенмен, бұл фантастикалық өнім.
Dialogue: 1,0:09:29.96,0:09:32.89,Text - CN,,0,0,0,,Арман қала – іскерлік құпия.
Dialogue: 1,0:09:34.93,0:09:38.39,Text - CN,,0,0,0,,Өйткені адал адамды қабылдауға болмайды.
Dialogue: 1,0:09:39.23,0:09:42.37,Text - CN,,0,0,0,,Ашылатын компанияда он фут қозғалатын техника бар.
Dialogue: 1,0:09:44.61,0:09:47.64,Text - CN,,0,0,0,,Қозғалтқышы таза емес, функционалды қара киім
Dialogue: 1,0:09:47.95,0:09:49.15,Text - CN,,0,0,0,,Теңгудің сауыты
Dialogue: 1,0:09:49.98,0:09:52.68,Text - CN,,0,0,0,,Технологияның ең озық түрі
Dialogue: 1,0:09:52.68,0:09:56.48,Text - CN,,0,0,0,,Бірден ыңғайлы және заңсыз немесе қажетті пайдалану туындайды
Dialogue: 1,0:09:56.48,0:10:00.66,Text - CN,,0,0,0,,Сұрақтар қойылмаған.
Dialogue: 1,0:10:01.00,0:10:02.67,Text - CN,,0,0,0,,Бұл әскери мақсатта қолданылады.
Dialogue: 1,0:10:05.33,0:10:07.57,Text - CN,,0,0,0,,Оянбайтын басқа адамдарды қараңыз
Dialogue: 1,0:10:07.57,0:10:10.67,Text - CN,,0,0,0,,Ит келгенде, ол тек ит ретінде ұйымдастырылды.
Dialogue: 1,0:10:11.15,0:10:14.00,Text - CN,,0,0,0,,...
Dialogue: 1,0:10:14.00,0:10:15.51,Text - CN,,0,0,0,,Құлау
Dialogue: 1,0:10:15.51,0:10:19.01,Text - CN,,0,0,0,,Жапон әскери өнеркәсібі мен басқа салаларын тең негізде өзара пайдалану.
Dialogue: 1,0:10:19.01,0:10:22.18,Text - CN,,0,0,0,,Мүмкін және қауіпті
Dialogue: 1,0:10:26.79,0:10:29.44,Text - CN,,0,0,0,,...
Dialogue: 1,0:10:30.78,0:10:35.64,Text - CN,,0,0,0,,...
Dialogue: 1,0:10:35.64,0:10:38.86,Text - CN,,0,0,0,,«Ақылға қонымды күдік» тағы да жауға қарсы шығады
Dialogue: 1,0:10:38.86,0:10:44.55,Text - CN,,0,0,0,,Сахнадағы ерекшеліктер
Dialogue: 1,0:10:44.55,0:10:50.37,Text - CN,,0,0,0,,Әскери қару мен қара киімге арналған арнайы ұнтақ
Dialogue: 1,0:10:50.37,0:10:52.46,Text - CN,,0,0,0,,Бұл сіздің ниетіңіз
Dialogue: 1,0:10:52.46,0:10:55.09,Text - CN,,0,0,0,,Менің жауабым ИӘ
Dialogue: 1,0:10:55.42,0:10:57.97,Text - CN,,0,0,0,,Өздігінен қажет емес мәлімдеме ИӘ
Dialogue: 1,0:10:58.31,0:11:02.35,Text - CN,,0,0,0,,Бұл сәттің эстетикасы бұдан еш айырмашылығы жоқ.
Dialogue: 1,0:11:02.58,0:11:05.35,Text - CN,,0,0,0,,Көрінбейтін Юя Муйя
Dialogue: 1,0:11:06.99,0:11:10.23,Text - CN,,0,0,0,,Гитомишима қастары
Dialogue: 1,0:11:10.23,0:11:11.73,Text - CN,,0,0,0,,Осымен
Dialogue: 1,0:11:12.11,0:11:13.69,Text - CN,,0,0,0,,...
Dialogue: 1,0:11:13.69,0:11:16.83,Text - CN,,0,0,0,,Жағдайды бақылау үшін бар күшіңізді салатын уақыт келді.
Dialogue: 1,0:11:25.00,0:11:29.84,Text - CN,,0,0,0,,Бұл мен ауруханаға барған жерім
Dialogue: 1,0:11:29.84,0:11:32.30,Text - CN,,0,0,0,,Бірақ қонақ ретінде ішке кіруге тыйым салынады.
Dialogue: 1,0:11:32.30,0:11:37.02,Text - CN,,0,0,0,,Бұл жасырын агенттердің енуі.
Dialogue: 1,0:11:37.02,0:11:41.76,Text - CN,,0,0,0,,Мұнда жұмыс істей алмайтын адамдардан сақ болыңыз.
Dialogue: 1,0:11:41.76,0:11:44.62,Text - CN,,0,0,0,,Алайда бұл талап етілмейді.
Dialogue: 1,0:11:44.62,0:11:47.31,Text - CN,,0,0,0,,Бірден жеткізуге болмайды
Dialogue: 1,0:11:48.03,0:11:50.81,Text - CN,,0,0,0,,Бірден жеткізу және басқа бес жұмысшы мүмкін емес.
Dialogue: 1,0:11:51.10,0:11:55.32,Text - CN,,0,0,0,,Тадая бір адамнан сахнаға шығып, іс-шараны ұйымдастыруды талап етті
Dialogue: 1,0:11:57.73,0:11:59.57,Text - CN,,0,0,0,,Бұл маған тиесілі жалғыз адам.
Dialogue: 1,0:12:08.83,0:12:10.82,Text - CN,,0,0,0,,Мұнда емес
Dialogue: 1,0:12:10.82,0:12:12.84,Text - CN,,0,0,0,,Кьюкиен
Dialogue: 1,0:12:24.61,0:12:27.35,Text - CN,,0,0,0,,Ойынға кіру
Dialogue: 1,0:12:47.93,0:12:49.29,Text - CN,,0,0,0,,Қосуке
Dialogue: 1,0:12:49.55,0:12:53.46,Text - CN,,0,0,0,,Сотуин Йосацуки шешімінің жиырма бір пункті
Dialogue: 1,0:12:53.46,0:12:55.45,Text - CN,,0,0,0,,Тестті орындауға 30 минут
Dialogue: 1,0:12:57.42,0:13:01.30,Text - CN,,0,0,0,,Шығаруды бақылау - қара түсті киім киген адамның сыртқы түрі.
Dialogue: 1,0:13:04.21,0:13:06.56,Text - CN,,0,0,0,,...
Dialogue: 1,0:13:06.56,0:13:08.81,Text - CN,,0,0,0,,Өлім...Өлім аяқталды
Dialogue: 1,0:13:09.25,0:13:11.57,Text - CN,,0,0,0,,Қарт адамдарға күтім жасаудың басқа түрлері
Dialogue: 1,0:13:11.57,0:13:14.62,Text - CN,,0,0,0,,Содан бері қара жамылған адам қайтыс болды.
Dialogue: 1,0:13:14.62,0:13:18.32,Text - CN,,0,0,0,,Вака да осындай жақсы.
Dialogue: 1,0:13:18.32,0:13:21.51,Text - CN,,0,0,0,,Нашар өндіріс туралы әңгімелер
Dialogue: 1,0:13:21.51,0:13:24.62,Text - CN,,0,0,0,,Кәрілік, үлкен еңбек, жер теңдігі, тағы бір жеңіс.
Dialogue: 1,0:13:27.30,0:13:29.18,Text - CN,,0,0,0,,...
Dialogue: 1,0:13:29.18,0:13:31.08,Text - CN,,0,0,0,,Нәзік прогресс пен шегініс
Dialogue: 1,0:13:31.33,0:13:34.42,Text - CN,,0,0,0,,Спектакльдің жалпы орындалуы
Dialogue: 1,0:13:36.34,0:13:39.09,Text - CN,,0,0,0,,Хитомиджима
Dialogue: 1,0:13:39.45,0:13:41.59,Text - CN,,0,0,0,,Көрінбеген
Dialogue: 1,0:13:41.89,0:13:46.76,Text - CN,,0,0,0,,Менің көзқарасым бойынша, менің көру және жұмыс істеу қабілетім
Dialogue: 1,0:13:47.34,0:13:49.77,Text - CN,,0,0,0,,тыныш тыныштық
Dialogue: 1,0:13:50.18,0:13:52.77,Text - CN,,0,0,0,,Біртүрлі жағдайлар
Dialogue: 1,0:13:53.27,0:13:56.27,Text - CN,,0,0,0,,Satsuki Ultimate қозғалысы қолдар мен аяқтармен аяқталады
Dialogue: 1,0:13:56.62,0:13:59.78,Text - CN,,0,0,0,,Дүрбі болу қандай?
Dialogue: 1,0:14:05.47,0:14:06.69,Text - CN,,0,0,0,,...
Dialogue: 1,0:14:19.74,0:14:21.55,Text - CN,,0,0,0,,Көңілді күліңіз
Dialogue: 1,0:14:21.98,0:14:26.32,Text - CN,,0,0,0,,Мен қазір мың бөлікке ұқсаймын.
Dialogue: 1,0:14:26.32,0:14:29.82,Text - CN,,0,0,0,,...
Dialogue: 1,0:14:29.82,0:14:31.93,Text - CN,,0,0,0,,...
Dialogue: 1,0:14:35.32,0:14:38.16,Text - CN,,0,0,0,,Эстетиканы оқуға ұқсастығы
Dialogue: 1,0:14:38.16,0:14:39.44,Text - CN,,0,0,0,,Иә.
Dialogue: 1,0:14:39.78,0:14:44.70,Text - CN,,0,0,0,,...
Dialogue: 1,0:14:45.06,0:14:49.95,Text - CN,,0,0,0,,Шығыс пен Батысқа назар аударатын ең маңызды нәрсе
Dialogue: 1,0:14:50.18,0:14:53.16,Text - CN,,0,0,0,,Керемет шығыс пен батыс осындай.
Dialogue: 1,0:14:53.16,0:14:56.28,Text - CN,,0,0,0,,Жалпы ауа ауасына бағытталған шынайы сұлулық
Dialogue: 1,0:14:56.28,0:14:59.71,Text - CN,,0,0,0,,Бұл жай көзге көрінбейді.
Dialogue: 1,0:15:00.12,0:15:02.71,Text - CN,,0,0,0,,Бұл ұстаным мені қанағаттандырмайды.
Dialogue: 1,0:15:02.96,0:15:06.35,Text - CN,,0,0,0,,Осының арқасында мен құтқарылдым.
Dialogue: 1,0:15:06.35,0:15:08.63,Text - CN,,0,0,0,,Мен де арзан нұсқасын оқыдым.
Dialogue: 1,0:15:08.63,0:15:12.83,Text - CN,,0,0,0,,Әлі әдемі жазбалар Мен оны жақсы көремін.
Dialogue: 1,0:15:12.83,0:15:16.73,Text - CN,,0,0,0,,Шығыс пен Батыс үшін ең маңызды ақпарат жұртшылыққа көрінбейді.
Dialogue: 1,0:15:17.14,0:15:20.26,Text - CN,,0,0,0,,Осы жерді көргенде менде бір сезім пайда болды
Dialogue: 1,0:15:21.30,0:15:25.67,Text - CN,,0,0,0,,Нәтиже – нағыз сұлулық.
Dialogue: 1,0:15:25.67,0:15:30.32,Text - CN,,0,0,0,,Сырты да, іші де жақсы, жазуы да жақсы, ауасы да жақсы
Dialogue: 1,0:15:30.32,0:15:32.99,Text - CN,,0,0,0,,Жиналыс көрінісі
Dialogue: 1,0:15:32.99,0:15:36.66,Text - CN,,0,0,0,,...
Dialogue: 1,0:15:36.66,0:15:40.66,Text - CN,,0,0,0,,Зейін мен жарық заттарға назар аудару
Dialogue: 1,0:15:40.66,0:15:44.00,Text - CN,,0,0,0,,Сапфир: Бұл әдемі әңгіме.
Dialogue: 1,0:15:44.00,0:15:46.63,Text - CN,,0,0,0,,Мен де осы бинокулярлы іздеуді қолданғым келеді.
Dialogue: 1,0:15:48.05,0:15:51.87,Text - CN,,0,0,0,,Осы декларация
Dialogue: 1,0:15:51.87,0:15:55.78,Text - CN,,0,0,0,,Оны көру жақсы идея емес.
Dialogue: 1,0:15:55.78,0:16:01.40,Text - CN,,0,0,0,,Өшпеген төрт адамның ғана дауысы.
Dialogue: 1,0:16:01.78,0:16:05.28,Text - CN,,0,0,0,,Ағымдағы позиция аяқталды.
Dialogue: 1,0:16:06.43,0:16:09.12,Text - CN,,0,0,0,,Қажетті терең ой Қажетті терең ой
Dialogue: 1,0:16:09.12,0:16:12.23,Text - CN,,0,0,0,,Жағымды ой Жағымды ой Жағымды ой Жақсы ой қажет.
Dialogue: 1,0:16:12.23,0:16:15.29,Text - CN,,0,0,0,,Мен оны мүлдем елемей қалдым.
Dialogue: 1,0:16:15.29,0:16:17.46,Text - CN,,0,0,0,,Менің көргенім – мен көргенім.
Dialogue: 1,0:16:17.46,0:16:19.80,Text - CN,,0,0,0,,Не болып жатқанын көру қиын
Dialogue: 1,0:16:19.80,0:16:22.10,Text - CN,,0,0,0,,Сіз нені айтасыз?
Dialogue: 1,0:16:24.13,0:16:25.30,Text - CN,,0,0,0,,Жауабы
Dialogue: 1,0:16:26.44,0:16:27.85,Text - CN,,0,0,0,,...
Dialogue: 1,0:16:28.64,0:16:29.57,Text - CN,,0,0,0,,Мен өзіммін
Dialogue: 1,0:16:30.23,0:16:33.42,Text - CN,,0,0,0,,Мен ненің дұрыс екенін көруім керек.
Dialogue: 1,0:16:33.98,0:16:38.19,Text - CN,,0,0,0,,...
Dialogue: 1,0:16:38.65,0:16:42.02,Text - CN,,0,0,0,,Басқа атаулар: Шонен Маюми
Dialogue: 1,0:16:42.52,0:16:43.69,Text - CN,,0,0,0,,Нарегаго
Dialogue: 1,0:16:46.94,0:16:50.50,Text - CN,,0,0,0,,...
Dialogue: 1,0:16:50.50,0:16:53.86,Text - CN,,0,0,0,,Бұл табиғи түрде мүмкін, менің ұзақ ғұмырым, еңбегім.
Dialogue: 1,0:16:53.86,0:16:59.11,Text - CN,,0,0,0,,Дегенмен, сонымен бірге бұл менің қысқаша әңгімем де.
Dialogue: 1,0:17:00.08,0:17:02.79,Text - CN,,0,0,0,,Менің бұрын-соңды болмаған өзім
Dialogue: 1,0:17:03.25,0:17:06.31,Text - CN,,0,0,0,,Шығыс пен Батыста ауа жалпы осылай байқалады.
Dialogue: 1,0:17:06.78,0:17:10.12,Text - CN,,0,0,0,,Бірінші ұрған ретінде өзін
Dialogue: 1,0:17:10.12,0:17:13.02,Text - CN,,0,0,0,,Қатысу кезінде костюм киген қоян болып киіну
Dialogue: 1,0:17:13.02,0:17:16.79,Text - CN,,0,0,0,,Терең зерттеу оқиғасы
Dialogue: 1,0:17:16.79,0:17:19.73,Text - CN,,0,0,0,,...
Dialogue: 1,0:17:20.02,0:17:21.10,Text - CN,,0,0,0,,Өзінің қажетсіз сөздері
Dialogue: 1,0:17:21.68,0:17:27.11,Text - CN,,0,0,0,,Сіздің өміріңізде орын жоқ екені анық.
Dialogue: 1,0:17:27.48,0:17:30.34,Text - CN,,0,0,0,,...
Dialogue: 1,0:17:30.34,0:17:33.47,Text - CN,,0,0,0,,Хякуя Юяко Лаоху Мечанияко
Dialogue: 1,0:17:33.47,0:17:36.64,Text - CN,,0,0,0,,Әрине, 21 тармақтан тұратын жан-жақты шолу
Dialogue: 1,0:17:36.64,0:17:38.81,Text - CN,,0,0,0,,Гатофудзинді түсіну
Dialogue: 1,0:17:38.81,0:17:40.37,Text - CN,,0,0,0,,Шындық ақылға қонымсыз
Dialogue: 1,0:17:41.35,0:17:43.55,Text - CN,,0,0,0,,Жоғалуға болатын және өз бет-бейнесі бар мен
Dialogue: 1,0:17:44.38,0:17:46.25,Text - CN,,0,0,0,,Сондай-ақ нақты шолу
Dialogue: 1,0:17:46.82,0:17:49.88,Text - CN,,0,0,0,,Қанша жас болса да, белгісіз декорация
Dialogue: 1,0:17:50.35,0:17:53.26,Text - CN,,0,0,0,,Көзге көрінетін немесе көрінетін ұсақ-түйек нәрсе
Dialogue: 1,0:17:53.26,0:17:55.05,Text - CN,,0,0,0,,Нәтижесінде ол көрінбейді.
Dialogue: 1,0:17:55.05,0:17:55.97,Text - CN,,0,0,0,,Бірақ мен көргенім осы.
Dialogue: 1,0:17:56.59,0:17:58.89,Text - CN,,0,0,0,,Байқамай сөйлеу...
Dialogue: 1,0:18:03.40,0:18:05.27,Text - CN,,0,0,0,,Манабу Сакигучи
Dialogue: 1,0:18:05.77,0:18:07.38,Text - CN,,0,0,0,,Жиырма бір ұпай
Dialogue: 1,0:18:07.38,0:18:13.16,Text - CN,,0,0,0,,Шо отбасының иесінің орта мерзімді ауыстыру мүмкіндігі бар.\N20-бөлім
Dialogue: 1,0:18:15.18,0:18:19.95,Text - CN,,0,0,0,,...
Dialogue: 1,0:18:19.95,0:18:22.66,Text - CN,,0,0,0,,Адамдарға не болатынын көру оңай
Dialogue: 1,0:18:23.67,0:18:27.13,Text - CN,,0,0,0,,Көрінбейтін қара киімді адам.
Dialogue: 1,0:18:27.13,0:18:29.13,Text - CN,,0,0,0,,Мен осылайша күшейдім.
Dialogue: 1,0:18:29.13,0:18:31.96,Text - CN,,0,0,0,,Дегенмен, бұл да ең тиімді әдіс.
Dialogue: 1,0:18:31.96,0:18:35.93,Text - CN,,0,0,0,,Осы мақсаттан басқа мен мұны істеуге ниетім жоқ.
Dialogue: 1,0:18:36.64,0:18:42.64,Text - CN,,0,0,0,,Машинаның артқы жағын көрмегенде
Dialogue: 1,0:18:42.64,0:18:44.94,Text - CN,,0,0,0,,Кім олардың бар уақытын көре алады?
Dialogue: 1,0:18:45.31,0:18:49.32,Text - CN,,0,0,0,,Жиналыста үстел үстіндегі тақтайшалар
Dialogue: 1,0:18:49.32,0:18:51.69,Text - CN,,0,0,0,,Көзді көру немесе қайта көру
Dialogue: 1,0:18:52.92,0:18:57.07,Text - CN,,0,0,0,,Мүмкін.
Dialogue: 1,0:18:58.46,0:19:00.20,Text - CN,,0,0,0,,Кешірілмейді.
Dialogue: 1,0:19:03.43,0:19:08.84,Text - CN,,0,0,0,,Жұмыс орны «Ақылға қонымды күдік» Кеше түнде жұмыс істеді.
Dialogue: 1,0:19:09.44,0:19:11.91,Text - CN,,0,0,0,,Барлығына ойын аяқталды.
Dialogue: 1,0:19:11.91,0:19:13.92,Text - CN,,0,0,0,,Сұлу болу үшін зейнетке шығу керек
Dialogue: 1,0:19:14.83,0:19:17.33,Text - CN,,0,0,0,,Келесі сәтті қойылым тоқтатылды.
Dialogue: 1,0:19:17.33,0:19:21.22,Text - CN,,0,0,0,,...
Dialogue: 1,0:19:21.22,0:19:25.12,Text - CN,,0,0,0,,Денеге арналған қара киімнің техникасын әзірлеу
Dialogue: 1,0:19:25.12,0:19:28.61,Text - CN,,0,0,0,,Қабілеттің пайда болуы
Dialogue: 1,0:19:29.02,0:19:35.50,Text - CN,,0,0,0,,Бұл мүмкін бе?
Dialogue: 1,0:19:35.50,0:19:38.62,Text - CN,,0,0,0,,Бұл да мәселенің түбірі.
Dialogue: 1,0:19:40.03,0:19:41.49,Text - CN,,0,0,0,,Йошиёши Хаяками
Dialogue: 1,0:19:42.23,0:19:43.62,Text - CN,,0,0,0,,Хитомишима Дугаку
Dialogue: 1,0:19:46.61,0:19:50.23,Text - CN,,0,0,0,,Ойдан тыс қалу
Dialogue: 1,0:19:50.23,0:19:52.50,Text - CN,,0,0,0,,Бұл жағдай.
Dialogue: 1,0:19:52.50,0:19:54.76,Text - CN,,0,0,0,,Міне, сіздің хабарламаңыз
Dialogue: 1,0:19:54.76,0:19:58.64,Text - CN,,0,0,0,,Мен сені жібермеймін, мен сені жібермеймін.
Dialogue: 1,0:19:59.87,0:20:05.49,Text - CN,,0,0,0,,Сұрақтарыңыз болса, маған хабарласыңыз.
Dialogue: 1,0:20:05.49,0:20:11.90,Text - CN,,0,0,0,,Мен айтып отырған сұлу қыздың эстетикалық сұлулығы да қызық.
Dialogue: 1,0:20:12.62,0:20:16.90,Text - CN,,0,0,0,,Органикалық әңгімелер Ойындарды қайта бастау
Dialogue: 1,0:20:16.90,0:20:21.91,Text - CN,,0,0,0,,Бұл сөз тіркесі басқа шынайы ойларға ұқсас.
Dialogue: 1,0:20:22.59,0:20:26.54,Text - CN,,0,0,0,,Әңгіменің шығу тегі Мен адамның толық аты-жөнін жазып қалдым.
Dialogue: 1,0:20:26.54,0:20:27.97,Text - CN,,0,0,0,,Бұл туралы хабарлауға бола ма?
Dialogue: 1,0:20:27.97,0:20:30.42,Text - CN,,0,0,0,,Жапонша бір өтірік Сацуки өтірік
Dialogue: 0,0:20:30.85,0:20:33.67,Ruby,,0,0,0,,Өтірік айту
Dialogue: 1,0:20:30.85,0:20:33.67,Text - CN,,0,0,0,,Lie
Dialogue: 1,0:20:34.02,0:20:38.86,Text - CN,,0,0,0,,Қандай азап көрдіңіз? Менімен қашан таныстың?
Dialogue: 1,0:20:38.86,0:20:43.56,Text - CN,,0,0,0,,Түрлі түсті көзілдірік туралы әңгімелеу.
Dialogue: 1,0:20:44.03,0:20:46.18,Text - CN,,0,0,0,,Бірінші жүгіруді аяқтауыңызбен құттықтаймыз
Dialogue: 1,0:20:47.54,0:20:48.76,Text - CN,,0,0,0,,және т.б.
Dialogue: 1,0:20:48.76,0:20:51.88,Text - CN,,0,0,0,,Менің ниетім орындалды, т.б.
Dialogue: 1,0:20:55.43,0:20:58.20,Text - CN,,0,0,0,,…
Dialogue: 1,0:20:58.81,0:21:02.82,Text - CN,,0,0,0,,Мен түсті көзілдірікті шешіп алдым.
Dialogue: 1,0:21:02.82,0:21:06.20,Text - CN,,0,0,0,,Қара киім киген Сатсукидің портреті
Dialogue: 1,0:21:06.99,0:21:07.95,Text - CN,,0,0,0,,Иә
Dialogue: 1,0:21:09.30,0:21:10.21,Text - CN,,0,0,0,,тақырып
Dialogue: 1,0:21:10.74,0:21:13.33,Text - CN,,0,0,0,,Үлкен дүрбі
Dialogue: 1,0:21:13.33,0:21:16.00,Text - CN,,0,0,0,,Қаралған декорация жоғалып, өзгереді
Dialogue: 1,0:21:16.00,0:21:19.17,Text - CN,,0,0,0,,Сатсукидің ашылмаған бейнесі
Dialogue: 1,0:21:19.86,0:21:22.62,Text - CN,,0,0,0,,Ұқсас алдау жалпы
Dialogue: 1,0:21:22.62,0:21:23.72,Text - CN,,0,0,0,,Усо Сатсуки және т.б.
Dialogue: 1,0:21:24.17,0:21:27.22,Text - CN,,0,0,0,,Керемет жер жоғалып кетті
Dialogue: 1,0:21:27.66,0:21:30.18,Text - CN,,0,0,0,,Шығыс пен Батыс үшін ең маңызды көрініс көзге көрінбейді.
Dialogue: 1,0:21:30.18,0:21:34.85,Text - CN,,0,0,0,,Басқа адамның өлген қолын көру
Dialogue: 1,0:21:34.85,0:21:37.35,Text - CN,,0,0,0,,Осымен спектакль аяқталады
Dialogue: 1,0:21:37.35,0:21:39.89,Text - CN,,0,0,0,,Эстетика мөлшері
Dialogue: 1,0:21:39.89,0:21:42.74,Text - CN,,0,0,0,,Баланың жүрегі мен ақылының шешімі
Dialogue: 1,0:21:43.19,0:21:46.19,Text - CN,,0,0,0,,Барлау және ұйымдастырушылық дау
Dialogue: 1,0:21:46.19,0:21:50.31,Text - CN,,0,0,0,,Кейбір өздігінен басталатын шынайы жағдай
Dialogue: 0,0:00:11.05,0:00:11.76,Text - JP,,0,0,0,,Бұл кальмар...
Dialogue: 0,0:00:12.56,0:00:15.46,Text - JP,,0,0,0,,Айқайлама, ақымақ, Атмосфераны оқы
Dialogue: 0,0:00:16.47,0:00:18.20,Text - JP,,0,0,0,,Өйткені... бұл жаман.
Dialogue: 0,0:00:18.20,0:00:20.00,Text - JP,,0,0,0,,Жаман ба?
Dialogue: 0,0:00:20.00,0:00:24.58,Text - JP,,0,0,0,,Жүрегіңде мені қорлау деп жүрсің бе?
Dialogue: 0,0:00:24.58,0:00:27.65,Text - JP,,0,0,0,,Ал... бұлай айтатын уақыт емес.
Dialogue: 0,0:00:27.65,0:00:29.88,Text - JP,,0,0,0,,Мен...мен алаяқпын, расында.
Dialogue: 0,0:00:29.88,0:00:33.51,Text - JP,,0,0,0,,Фурё... Фукурой-кун көре алмайтын шығар, бірақ
Dialogue: 0,0:00:33.89,0:00:36.77,Text - JP,,0,0,0,,Жарайды, жарайды, мен бұған күмәнданбаймын.
Dialogue: 0,0:00:37.15,0:00:40.02,Text - JP,,0,0,0,,Ешкім сені өтірік айтып жатыр деп ойламайды.
Dialogue: 0,0:00:40.57,0:00:46.03,Text - JP,,0,0,0,,Бірақ мұндай жаулардың ұясында мұндай сөздерді дауыстап айтудың қажеті жоқ.
Dialogue: 0,0:00:48.74,0:00:51.66,Text - JP,,0,0,0,,Қараңдаршы, лоликондар үлкен төбелесіп жатыр!
Dialogue: 0,0:00:55.03,0:00:57.66,Text - JP,,0,0,0,,Хмм, әдемі.
Dialogue: 0,0:01:07.42,0:01:09.92,Text - JP,,0,0,0,,Барлығында!
Dialogue: 0,0:01:10.27,0:01:13.82,Text - JP,,0,0,0,,Покер рөлдері туралы көп білмесем де.
Dialogue: 0,0:01:13.82,0:01:17.93,Text - JP,,0,0,0,,Сонда да ашылған екі қолдың қайсысы күштірек?
Dialogue: 0,0:01:17.93,0:01:20.44,Text - JP,,0,0,0,,Маған бұл туралы ойлаудың қажеті де болмады.
Dialogue: 0,0:01:20.99,0:01:25.57,Text - JP,,0,0,0,,Қорытындылай келе, бұл арнайы бағдарлама бүгін кешке жалғасады.
Dialogue: 0,0:01:25.57,0:01:28.19,Text - JP,,0,0,0,,Менеджердің жеңісімен аяқталды
Dialogue: 0,0:03:02.36,0:03:04.04,Text - JP,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:03:04.41,0:03:07.75,Text - JP,,0,0,0,,Біз сізді тағы да күтеміз.
Dialogue: 0,0:03:07.75,0:03:11.03,Text - JP,,0,0,0,,«Әдемі бала» детектив тобының мүшелері
Dialogue: 0,0:03:12.84,0:03:14.05,Text - JP,,0,0,0,,Бұл алаяқтық
Dialogue: 0,0:03:16.49,0:03:18.30,Text - JP,,0,0,0,,Жалаңаш патша сияқты.
Dialogue: 0,0:03:19.27,0:03:22.85,Text - JP,,0,0,0,,Менің ойымша, Куроконың кигені көрінбейтін киім еді.
Dialogue: 0,0:03:23.49,0:03:27.94,Text - JP,,0,0,0,,Оның бар екенін тек Майуми Хитомидзима ғана анықтай алды.
Dialogue: 0,0:03:29.24,0:03:31.19,Text - JP,,0,0,0,,Жоқ, шынымды айтсам.
Dialogue: 0,0:03:31.58,0:03:34.39,Text - JP,,0,0,0,,Мен басынан бастап білдім
Dialogue: 0,0:03:34.39,0:03:38.27,Text - JP,,0,0,0,,Мен осындай нәрсе болады деп күткен едім.
Dialogue: 0,0:03:39.87,0:03:42.70,Text - JP,,0,0,0,,Сенің ойыңда бірдеңе бар сияқты, Нагахиро.
Dialogue: 0,0:03:43.60,0:03:46.96,Text - JP,,0,0,0,,Енді бұл түсініктеме қайдан шықты?
Dialogue: 0,0:03:47.45,0:03:51.59,Text - JP,,0,0,0,,Басынан бастап, 1-ден бастап сөйлесейік.
Dialogue: 0,0:03:52.10,0:03:55.92,Text - JP,,0,0,0,,Бұл жалғыз жол.
Dialogue: 0,0:03:58.97,0:04:00.72,Text - JP,,0,0,0,,Шығыс-батыс шығыс-батыс
Dialogue: 0,0:04:01.27,0:04:03.63,Text - JP,,0,0,0,,Барлығын бастаған тергеу болды
Dialogue: 0,0:04:03.63,0:04:06.89,Text - JP,,0,0,0,,Бұл Әдемі бала детектив тобының мүшесі ретінде жасалмаған.
Dialogue: 0,0:04:07.12,0:04:10.73,Text - JP,,0,0,0,,Мен мұны Ring академиясының студенттер кеңесінің президенті ретінде істедім.
Dialogue: 0,0:04:10.97,0:04:16.36,Text - JP,,0,0,0,,Мен орта мектептің шаш аксессуарлары туралы қауесетті естідім.
Dialogue: 0,0:04:17.81,0:04:20.98,Text - JP,,0,0,0,,Сондықтан мен біраз уақыттан бері осындай зерттеулермен айналыстым.
Dialogue: 0,0:04:20.98,0:04:24.24,Text - JP,,0,0,0,,Алайда белгілі бір деңгейден жоғары нәтижеге қол жеткізілмеді.
Dialogue: 0,0:04:24.24,0:04:27.15,Text - JP,,0,0,0,,Бірлік сезімі күшті ме?
Dialogue: 0,0:04:27.15,0:04:30.75,Text - JP,,0,0,0,,Сол орта мектептің барлық оқушыларының ауыздары тар болды.
Dialogue: 0,0:04:31.18,0:04:36.51,Text - JP,,0,0,0,,Мен сияқты жалғыз таланты сөйлейтін адам үшін бұл сенгісіз.
Dialogue: 0,0:04:38.54,0:04:42.84,Text - JP,,0,0,0,,Дегенмен, кіші орта мектептерде шашқа арналған аксессуарлар әрқашан мұндай бола бермейді.
Dialogue: 0,0:04:42.84,0:04:46.47,Text - JP,,0,0,0,,Мен бірінші сыныпта оқып жүрген кезімде жақсы жағынан да, жаман жағынан да.
Dialogue: 0,0:04:46.47,0:04:49.52,Text - JP,,0,0,0,,Мектептің рухы көбірек болды.
Dialogue: 0,0:04:49.81,0:04:52.92,Text - JP,,0,0,0,,Жақсы ма, жаман ба, қазіргідей.
Dialogue: 0,0:04:52.92,0:04:57.78,Text - JP,,0,0,0,,Ол оқуға түскеннен кейін ғана мектепте жақсы тәртіп орнады.
Dialogue: 0,0:04:58.27,0:05:01.53,Text - JP,,0,0,0,,Ол Сатсуки-кун.
Dialogue: 0,0:05:01.53,0:05:05.27,Text - JP,,0,0,0,,Ол жақында ғана студенттік кеңестің президенті болды.
Dialogue: 0,0:05:05.27,0:05:08.03,Text - JP,,0,0,0,,Бұл үстемдік етуші күш немесе харизма
Dialogue: 0,0:05:08.03,0:05:11.04,Text - JP,,0,0,0,,Бұл мен мектепке келген кезден бастап көрсетілді.
Dialogue: 0,0:05:11.51,0:05:16.05,Text - JP,,0,0,0,,Харизманы тікелей коммерциялық рухқа аударуға болады.
Dialogue: 0,0:05:16.33,0:05:19.14,Text - JP,,0,0,0,,Шаш аксессуарлары орта мектебінің студенттері қызметкерлер ретінде
Dialogue: 0,0:05:19.14,0:05:23.05,Text - JP,,0,0,0,,Өз ісін орта мектепте оқып жүргенде бастаған.
Dialogue: 0,0:05:23.58,0:05:28.68,Text - JP,,0,0,0,,Дәл осылайша ол шаш аксессуарлары кіші орта мектебін тез бақылауға алды.
Dialogue: 0,0:05:30.82,0:05:33.25,Text - JP,,0,0,0,,Хитомиджима-сан болжағандай,
Dialogue: 0,0:05:33.25,0:05:38.07,Text - JP,,0,0,0,,Ол екеуміз біраз уақыттан бері студенттік кеңестің президенті ретінде араластық.
Dialogue: 0,0:05:38.67,0:05:42.57,Text - JP,,0,0,0,,Сондықтан мен оның қандай екенін білемін.
Dialogue: 0,0:05:42.86,0:05:49.91,Text - JP,,0,0,0,,Мен қателессем де, мен баратын мектепте ғана өз бақылауымды жүзеге асыруға қанағаттанатын адам емеспін.
Dialogue: 0,0:05:49.91,0:05:54.58,Text - JP,,0,0,0,,Мен олар жақын арада басқа мектептерді басқара бастайды деп алаңдадым.
Dialogue: 0,0:05:55.40,0:06:00.22,Text - JP,,0,0,0,,Өткен күні мен Хитомидзима мырзадан оның жалдамалы болып көрінетінін естігенде,
Dialogue: 0,0:06:00.22,0:06:02.72,Text - JP,,0,0,0,,Мен ақыры келдім деп ойладым, солай емес пе?
Dialogue: 0,0:06:04.46,0:06:11.60,Text - JP,,0,0,0,,Сацуки-кун өзінің улы азу тістерін Сақина академиясына қарай бастады ма деп ойлаймын...
Dialogue: 0,0:06:14.96,0:06:17.74,Text - JP,,0,0,0,,Мен Сатсуки-кун туралы түсінемін, бірақ
Dialogue: 0,0:06:17.74,0:06:19.23,Text - JP,,0,0,0,,Бірақ Сакигучи-сенпай
Dialogue: 0,0:06:22.57,0:06:24.49,Text - JP,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:06:25.16,0:06:27.24,Text - JP,,0,0,0,,Оны тіпті Сакигучи-сенпай да көре алмады.
Dialogue: 0,0:06:27.64,0:06:30.87,Text - JP,,0,0,0,,Бұл күтпеген жағдай болды ма?
Dialogue: 0,0:06:31.20,0:06:34.12,Text - JP,,0,0,0,,Жоқ, бұл күткен еді.
Dialogue: 0,0:06:34.85,0:06:38.13,Text - JP,,0,0,0,,Хитомиджима мырза, Жиырма есіңізде ме?
Dialogue: 0,0:06:38.13,0:06:41.63,Text - JP,,0,0,0,,Жиырма!? Лоликон жаңа ғана жиырма деп айтты ма?
Dialogue: 0,0:06:42.16,0:06:45.89,Text - JP,,0,0,0,,«Жиырма» дедім, бірақ лоликон деп айтпадым.
Dialogue: 0,0:06:45.89,0:06:49.03,Text - JP,,0,0,0,,Олай болса, тағы кездесеміз, Рей-сан.
Dialogue: 0,0:06:49.03,0:06:52.02,Text - JP,,0,0,0,,Сол сұлу әйелге! Көп экспозициясы бар әдемі әйел үшін
Dialogue: 0,0:06:52.35,0:06:53.81,Text - JP,,0,0,0,,Кездесу мүмкін емес
Dialogue: 0,0:06:53.81,0:06:55.77,Text - JP,,0,0,0,,Біз кездеспеуіміз керек.
Dialogue: 0,0:06:55.77,0:07:01.60,Text - JP,,0,0,0,,Керісінше, мен болашақта Twenty's-ке араласудан қалай аулақ боламын деп ойладым.
Dialogue: 0,0:07:04.72,0:07:07.06,Text - JP,,0,0,0,,Нагахирода, Жиырмалықтар
Dialogue: 0,0:07:07.06,0:07:10.25,Text - JP,,0,0,0,,Сіз бұл казино залына қалай араластыңыз?
Dialogue: 0,0:07:10.25,0:07:17.29,Text - JP,,0,0,0,,Күні кеше біз Жиырманы сәтті тойтарып алдық.
Dialogue: 0,0:07:17.65,0:07:22.58,Text - JP,,0,0,0,,Келесіде бұлай жақсы өтеді деп ойламадым.
Dialogue: 0,0:07:22.58,0:07:29.04,Text - JP,,0,0,0,,Сондықтан мен Сосу-куннан олардың ұйымын тексеруге көмек сұрауды жөн көрдім.
Dialogue: 0,0:07:29.78,0:07:32.06,Text - JP,,0,0,0,,Сонымен, бірдеңені түсіндің бе?
Dialogue: 0,0:07:32.69,0:07:36.38,Text - JP,,0,0,0,,Қарапайым тілмен айтқанда, жиырмалық тасымалдаушылар.
Dialogue: 0,0:07:36.38,0:07:37.81,Text - JP,,0,0,0,,Адам немесе зат
Dialogue: 0,0:07:37.81,0:07:42.07,Text - JP,,0,0,0,,Сіздің жұмысыңыз қалаған нәрсені қалаған жерге жылжыту сияқты.
Dialogue: 0,0:07:44.35,0:07:51.73,Text - JP,,0,0,0,,Иә, тергеу барысында жанама өнім ретінде күтпеген ақпарат шықты.
Dialogue: 0,0:07:51.73,0:07:55.98,Text - JP,,0,0,0,,Сатсуки-кун - шаш аксессуарлары кіші орта мектебінің қазіргі студенттер кеңесінің президенті.
Dialogue: 0,0:07:55.98,0:07:59.10,Text - JP,,0,0,0,,Twenty's-пен жасалған мәміленің дәлелі бар.
Dialogue: 0,0:07:59.10,0:08:00.29,Text - JP,,0,0,0,,Мәміле?
Dialogue: 0,0:08:00.29,0:08:03.43,Text - JP,,0,0,0,,Ойын автоматтары, покер автоматтары және т.б.
Dialogue: 0,0:08:03.43,0:08:04.91,Text - JP,,0,0,0,,Иә, Мицуру-кун.
Dialogue: 0,0:08:04.91,0:08:08.05,Text - JP,,0,0,0,,Бірақ бұл маңызды емес.
Dialogue: 0,0:08:08.35,0:08:13.56,Text - JP,,0,0,0,,Белгілі бір жеке компания өздері жасап жатқан өнімді бізге сеніп тапсырған сияқты.
Dialogue: 0,0:08:14.35,0:08:19.56,Text - JP,,0,0,0,,Әзірлеу үстіндегі өнімдерге монитор ретінде қызмет ету үшін сізге ақы алатын сияқтысыз.
Dialogue: 0,0:08:20.24,0:08:23.12,Text - JP,,0,0,0,,Сацуки Студенттік Кеңесінің төрағасының негізгі табыс көзі қандай?
Dialogue: 0,0:08:23.12,0:08:28.86,Text - JP,,0,0,0,,Бұл адамдар өнімді сынап көріп, алған әсерлері туралы есеп жазатын әрекет сияқты.
Dialogue: 0,0:08:28.86,0:08:31.97,Text - JP,,0,0,0,,Иә? Есептер сіздің негізгі табыс көзі ме?
Dialogue: 0,0:08:31.97,0:08:34.63,Text - JP,,0,0,0,,Пайдалану ыңғайлы ма, әлде ыңғайсыз ба?
Dialogue: 0,0:08:34.63,0:08:37.83,Text - JP,,0,0,0,,Казино залын осылай басқаруға болады ма?
Dialogue: 0,0:08:37.83,0:08:42.48,Text - JP,,0,0,0,,Шын мәнінде, біз осы мақсатта казино залдарын басқарамыз деп айта аласыз.
Dialogue: 0,0:08:42.48,0:08:47.34,Text - JP,,0,0,0,,Бұл дәл қазір Сатсуки-кунға сынауға тапсырылған өнім.
Dialogue: 0,0:08:47.66,0:08:50.84,Text - JP,,0,0,0,,Хитомиджима сипаттаған Куроконың киімдері
Dialogue: 0,0:08:51.05,0:08:54.85,Text - JP,,0,0,0,,Өйткені ол көрінбейтіннің қара шапаны.
Dialogue: 0,0:08:55.18,0:08:57.73,Text - JP,,0,0,0,,Сонымен бәрі түсінікті.
Dialogue: 0,0:08:58.05,0:09:00.73,Text - JP,,0,0,0,,Ол сол мүмкіндікті пайдаланған шығар.
Dialogue: 0,0:09:01.38,0:09:03.48,Text - JP,,0,0,0,,Галереяның көзін пайдалану
Dialogue: 0,0:09:03.76,0:09:06.48,Text - JP,,0,0,0,,Біз көрінбейтін қара жадағаймен тәжірибе жасап жатырмыз.
Dialogue: 0,0:09:06.93,0:09:10.74,Text - JP,,0,0,0,,Экспериментті іске асыру сынағы Бірақ
Dialogue: 0,0:09:12.47,0:09:15.43,Text - JP,,0,0,0,,Сенде осындай киім бар ма?
Dialogue: 0,0:09:15.43,0:09:18.37,Text - JP,,0,0,0,,Теңгенің тығылған жеріндей.
Dialogue: 0,0:09:19.01,0:09:20.96,Text - JP,,0,0,0,,Ауадай ғайып болған адам
Dialogue: 0,0:09:21.55,0:09:25.38,Text - JP,,0,0,0,,Мүмкін ол сол костюмді пайдаланған шығар.
Dialogue: 0,0:09:25.38,0:09:29.96,Text - JP,,0,0,0,,Дегенмен, мұндай СФ-тәрізді өнімдердің дамуы
Dialogue: 0,0:09:29.96,0:09:32.89,Text - JP,,0,0,0,,Қалай қарасаң да, бұл коммерциялық құпия.
Dialogue: 0,0:09:34.93,0:09:38.39,Text - JP,,0,0,0,,Өйткені есі дұрыс адам бақылаушы болуды қабылдамайды.
Dialogue: 0,0:09:39.23,0:09:42.37,Text - JP,,0,0,0,,Өйткені әзірлеуші ​​оны пайдалануға ниетті.
Dialogue: 0,0:09:44.61,0:09:47.64,Text - JP,,0,0,0,,Көрінбеушіліктің қара халаты
Dialogue: 0,0:09:47.95,0:09:49.15,Text - JP,,0,0,0,,Тенгудің жасырынуы
Dialogue: 0,0:09:49.98,0:09:52.68,Text - JP,,0,0,0,,Мұндай технология ең сұранысқа ие
Dialogue: 0,0:09:52.68,0:09:56.48,Text - JP,,0,0,0,,Заңсыз болса да қабылданады
Dialogue: 0,0:09:56.48,0:10:00.66,Text - JP,,0,0,0,,міндетті түрде ұрыс алаңы
Dialogue: 0,0:10:01.00,0:10:02.67,Text - JP,,0,0,0,,Әскери мақсатта пайдалану
Dialogue: 0,0:10:05.33,0:10:07.57,Text - JP,,0,0,0,,Бастық сияқты әрекет етіңіз
Dialogue: 0,0:10:07.57,0:10:10.67,Text - JP,,0,0,0,,Сол басшы ұйымның иті ғой.
Dialogue: 0,0:10:11.15,0:10:14.00,Text - JP,,0,0,0,,Менің ойымша, ол қосалқы мердігерлікке ниетті емес.
Dialogue: 0,0:10:14.00,0:10:15.51,Text - JP,,0,0,0,,Нақтырақ
Dialogue: 0,0:10:15.51,0:10:19.01,Text - JP,,0,0,0,,Олар мұндай әскери салалармен бәсекелесуге ниетті болуы мүмкін.
Dialogue: 0,0:10:19.01,0:10:22.18,Text - JP,,0,0,0,,Бірақ бұл қауіпті екенін айтудың қажеті жоқ.
Dialogue: 0,0:10:26.79,0:10:29.44,Text - JP,,0,0,0,,Сонымен не істеуіміз керек, көшбасшы?
Dialogue: 0,0:10:30.78,0:10:35.64,Text - JP,,0,0,0,,Бұл енді біз сол казино залына қайта ораламыз деген сөз.
Dialogue: 0,0:10:35.64,0:10:38.86,Text - JP,,0,0,0,,Ақылға қонымды күмәнді қайтарып, кек алыңыз
Dialogue: 0,0:10:38.86,0:10:44.55,Text - JP,,0,0,0,,Басқару құқығына ие болу үшін сахнада менеджермен бәсекелесетін арнайы бағдарламаны ұтып алыңыз.
Dialogue: 0,0:10:44.55,0:10:50.37,Text - JP,,0,0,0,,Әскери қаруға ұқсайтын қара халатты полигонның өзін талқандау керек деп ойламайсыз ба?\NМенің ойымша, сұрақ
Dialogue: 0,0:10:50.37,0:10:52.46,Text - JP,,0,0,0,,дегенді білдіреді.
Dialogue: 0,0:10:52.46,0:10:55.09,Text - JP,,0,0,0,,Сонда менің жауабым иә.
Dialogue: 0,0:10:55.42,0:10:57.97,Text - JP,,0,0,0,,Оның Иса болатыны анық.
Dialogue: 0,0:10:58.31,0:11:02.35,Text - JP,,0,0,0,,Бұл жерде мұны істемеу менің эстетикаға қайшы болар еді.
Dialogue: 0,0:11:02.58,0:11:05.35,Text - JP,,0,0,0,,Сұлулықты көрмеу - батылдықтың жоқтығы.
Dialogue: 0,0:11:06.99,0:11:10.23,Text - JP,,0,0,0,,Майуми Хитомиджима-кун Шулы сұлу Маюми
Dialogue: 0,0:11:10.23,0:11:11.73,Text - JP,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:11:12.11,0:11:13.69,Text - JP,,0,0,0,,Қуан
Dialogue: 0,0:11:13.69,0:11:16.83,Text - JP,,0,0,0,,Көру қабілетін пайдаланатын кез келген сияқты.
Dialogue: 0,0:11:25.00,0:11:29.84,Text - JP,,0,0,0,,Сотоин-кунның стратегиясы - біз казино залы Ақылға қонымды күмәнге барамыз.
Dialogue: 0,0:11:29.84,0:11:32.30,Text - JP,,0,0,0,,Шақырылған қонақ ретінде жасырын кірудің орнына
Dialogue: 0,0:11:32.30,0:11:37.02,Text - JP,,0,0,0,,Ондағы ойы қызметкердің атын жамылып, ішке кіріп кету еді.
Dialogue: 0,0:11:37.02,0:11:41.76,Text - JP,,0,0,0,,Бұл детектив жұмысын таңбасыз іштен еркін орындауға болатынын білдіреді.
Dialogue: 0,0:11:41.76,0:11:44.62,Text - JP,,0,0,0,,Ал сізге шақыру қажет емес
Dialogue: 0,0:11:44.62,0:11:47.31,Text - JP,,0,0,0,,Жоқ, сізге әлі де бір көшірме қажет.
Dialogue: 0,0:11:48.03,0:11:50.81,Text - JP,,0,0,0,,Қалған бес адам қызметкер ретінде бақылауға арналған болса да,
Dialogue: 0,0:11:51.10,0:11:55.32,Text - JP,,0,0,0,,Себебі бір адам сахнада менеджермен бетпе-бет келуі керек.
Dialogue: 0,0:11:57.73,0:11:59.57,Text - JP,,0,0,0,,Жарайды, мен ғана қалдым.
Dialogue: 0,0:12:08.83,0:12:10.82,Text - JP,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:12:10.82,0:12:12.84,Text - JP,,0,0,0,,Біздің тұтынушыларды құттықтаймыз
Dialogue: 0,0:12:24.61,0:12:27.35,Text - JP,,0,0,0,,Енді ойынды ашыңыз.
Dialogue: 0,0:12:47.93,0:12:49.29,Text - JP,,0,0,0,,Керемет
Dialogue: 0,0:12:49.55,0:12:53.46,Text - JP,,0,0,0,,Сотоин-кун мен Сатсуки-кун арасындағы блэкджек матчы басталды.
Dialogue: 0,0:12:53.46,0:12:55.45,Text - JP,,0,0,0,,30 минут өтті
Dialogue: 0,0:12:57.42,0:13:01.30,Text - JP,,0,0,0,,Осыған қарамастан Куроко сахнаға шықпады.
Dialogue: 0,0:13:04.21,0:13:06.56,Text - JP,,0,0,0,,Не болды, Хитомиджима-сан?
Dialogue: 0,0:13:06.56,0:13:08.81,Text - JP,,0,0,0,,Бұл ақымақ шығар...
Dialogue: 0,0:13:09.25,0:13:11.57,Text - JP,,0,0,0,,Алдап ұсталудан сақ болыңыз
Dialogue: 0,0:13:11.57,0:13:14.62,Text - JP,,0,0,0,,Мүмкін олар Куроконы бүгін қолданбауды шешкен шығар.
Dialogue: 0,0:13:14.62,0:13:18.32,Text - JP,,0,0,0,,Бұл жағдайда бұл жақсы даму болуы мүмкін.
Dialogue: 0,0:13:18.32,0:13:21.51,Text - JP,,0,0,0,,Егер Сатсуки-кун заңсыз қимылдарды тоқтатса
Dialogue: 0,0:13:21.51,0:13:24.62,Text - JP,,0,0,0,,Көшбасшы онымен тең дәрежеде бәсекелесе алады.
Dialogue: 0,0:13:27.30,0:13:29.18,Text - JP,,0,0,0,,Чиптер келеді және кетеді
Dialogue: 0,0:13:29.18,0:13:31.08,Text - JP,,0,0,0,,Керемет тактика
Dialogue: 0,0:13:31.33,0:13:34.42,Text - JP,,0,0,0,,Сценарий бойынша орындалып жатқандай.
Dialogue: 0,0:13:36.34,0:13:39.09,Text - JP,,0,0,0,,Сіз оны көре алмайтыныңызға сенімдісіз бе, Хитомижима-сан?
Dialogue: 0,0:13:39.45,0:13:41.59,Text - JP,,0,0,0,,Көрмегенді көре алмайсың
Dialogue: 0,0:13:41.89,0:13:46.76,Text - JP,,0,0,0,,Мен өз көзқарасымды дұрыс нәрсеге пайдалана аламын деп ойладым.
Dialogue: 0,0:13:47.34,0:13:49.77,Text - JP,,0,0,0,,Тыныштан, тыныштан.
Dialogue: 0,0:13:50.18,0:13:52.77,Text - JP,,0,0,0,,Осылай жалғаса берсе жаман болады.
Dialogue: 0,0:13:53.27,0:13:56.27,Text - JP,,0,0,0,,...
Dialogue: 0,0:13:56.62,0:13:59.78,Text - JP,,0,0,0,,Менің көзқарасымнан әйтеуір қашып
Dialogue: 0,0:14:05.47,0:14:06.69,Text - JP,,0,0,0,,тіпті Эден кампусында да — қайдағы қырағы көздердің қашан қарап тұрғанын білмейсің.
Dialogue: 0,0:14:19.74,0:14:21.55,Text - JP,,0,0,0,,Не болды?
Dialogue: 0,0:14:21.98,0:14:26.32,Text - JP,,0,0,0,,...
Dialogue: 0,0:14:26.32,0:14:29.82,Text - JP,,0,0,0,,...
Dialogue: 0,0:14:29.82,0:14:31.93,Text - JP,,0,0,0,,...
Dialogue: 0,0:14:35.32,0:14:38.16,Text - JP,,0,0,0,,...
Dialogue: 0,0:14:38.16,0:14:39.44,Text - JP,,0,0,0,,Бірақ, жас ханым
Dialogue: 0,0:14:39.78,0:14:44.70,Text - JP,,0,0,0,,Егер сіз көрінетін сұлулыққа тым көп көңіл бөлсеңіз, ақыры аяғыңыздан айырыласыз.
Dialogue: 0,0:14:45.06,0:14:49.95,Text - JP,,0,0,0,,Сент-Экзюпери маңызды нәрселерді көзбен көруге болмайды дейді.
Dialogue: 0,0:14:50.18,0:14:53.16,Text - JP,,0,0,0,,...
Dialogue: 0,0:14:53.16,0:14:56.28,Text - JP,,0,0,0,,...
Dialogue: 0,0:14:56.28,0:14:59.71,Text - JP,,0,0,0,,Бұл көзге көрінбейді.
Dialogue: 0,0:15:00.12,0:15:02.71,Text - JP,,0,0,0,,...
Dialogue: 0,0:15:02.96,0:15:06.35,Text - JP,,0,0,0,,...
Dialogue: 0,0:15:06.35,0:15:08.63,Text - JP,,0,0,0,,...
Dialogue: 0,0:15:08.63,0:15:12.83,Text - JP,,0,0,0,,...
Dialogue: 0,0:15:12.83,0:15:16.73,Text - JP,,0,0,0,,Маңызды нәрселерді көзбен көруге болмайтыны анық жазылған.
Dialogue: 0,0:15:17.14,0:15:20.26,Text - JP,,0,0,0,,Мен оны көріп, әсерлендім.
Dialogue: 0,0:15:21.30,0:15:25.67,Text - JP,,0,0,0,,Егер ол шынымен әдемі болса, оны көре алмау мүмкін емес.
Dialogue: 0,0:15:25.67,0:15:30.32,Text - JP,,0,0,0,,...
Dialogue: 0,0:15:30.32,0:15:32.99,Text - JP,,0,0,0,,Оған міндетті түрде куә боламын.
Dialogue: 0,0:15:32.99,0:15:36.66,Text - JP,,0,0,0,,Қаншалықты жарық болса да, ешқашан қарама
Dialogue: 0,0:15:36.66,0:15:40.66,Text - JP,,0,0,0,,Мен жарқырап, жарқыраған нәрселерге қараймын.
Dialogue: 0,0:15:40.66,0:15:44.00,Text - JP,,0,0,0,,Сатсуки-кун, өтірігің әдемі болса
Dialogue: 0,0:15:44.00,0:15:46.63,Text - JP,,0,0,0,,Мен саған оның қандай екенін көрсете аламын.
Dialogue: 0,0:15:48.05,0:15:51.87,Text - JP,,0,0,0,,Осы декларацияға Жоқ Соғыс жариялауға
Dialogue: 0,0:15:51.87,0:15:55.78,Text - JP,,0,0,0,,Әрине, галерея қызық емес еді.
Dialogue: 0,0:15:55.78,0:16:01.40,Text - JP,,0,0,0,,Шара алаңында бар-жоғы төрт адам қол соқты.
Dialogue: 0,0:16:01.78,0:16:05.28,Text - JP,,0,0,0,,Мұны шешудің жалғыз жолы - қазір.
Dialogue: 0,0:16:06.43,0:16:09.12,Text - JP,,0,0,0,,Ойламасаң, ойламасаң
Dialogue: 0,0:16:09.12,0:16:12.23,Text - JP,,0,0,0,,Ойлан, ойла, ойла, ойла
Dialogue: 0,0:16:12.23,0:16:15.29,Text - JP,,0,0,0,,Маған не жетіспейді?
Dialogue: 0,0:16:15.29,0:16:17.46,Text - JP,,0,0,0,,Мен не көріп тұрмын?
Dialogue: 0,0:16:17.46,0:16:19.80,Text - JP,,0,0,0,,Мен нені көрмеймін?
Dialogue: 0,0:16:19.80,0:16:22.10,Text - JP,,0,0,0,,Біз немен бетпе-бет келуіміз керек?
Dialogue: 0,0:16:24.13,0:16:25.30,Text - JP,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:16:26.44,0:16:27.85,Text - JP,,0,0,0,,Бұл туралы ойлаудың қажеті жоқ
Dialogue: 0,0:16:28.64,0:16:29.57,Text - JP,,0,0,0,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 0,0:16:30.23,0:16:33.42,Text - JP,,0,0,0,,...
Dialogue: 0,0:16:33.98,0:16:38.19,Text - JP,,0,0,0,,Сондықтан мен «Әдемі бала» детектив тобының мүшесі болдым.
Dialogue: 0,0:16:38.65,0:16:42.02,Text - JP,,0,0,0,,Сұлулықтың Маюми, осылай аталады
Dialogue: 0,0:16:42.52,0:16:43.69,Text - JP,,0,0,0,,Бұл мен бе?
Dialogue: 0,0:16:46.94,0:16:50.50,Text - JP,,0,0,0,,Иә, бірақ бұл бәрі емес.
Dialogue: 0,0:16:50.50,0:16:53.86,Text - JP,,0,0,0,,Бұл артықшылық болуы мүмкін, бірақ бұл жақсылық болуы мүмкін.
Dialogue: 0,0:16:53.86,0:16:59.11,Text - JP,,0,0,0,,Бірақ сонымен бірге бұл әлсіздік, кемшілік, кемшілік сезімі болды.
Dialogue: 0,0:17:00.08,0:17:02.79,Text - JP,,0,0,0,,Сіз көруге тырыспайтын өзін-өзі
Dialogue: 0,0:17:03.25,0:17:06.31,Text - JP,,0,0,0,,Біз нені ауадай елемейміз
Dialogue: 0,0:17:06.78,0:17:10.12,Text - JP,,0,0,0,,Қоян сияқты киінген бетіңізді көрсетіңіз
Dialogue: 0,0:17:10.12,0:17:13.02,Text - JP,,0,0,0,,...
Dialogue: 0,0:17:13.02,0:17:16.79,Text - JP,,0,0,0,,Егер сіз оған үлкенірек көзқараспен қарасаңыз, бұл табиғи емес.
Dialogue: 0,0:17:16.79,0:17:19.73,Text - JP,,0,0,0,,Сонда табиғаттан тыс деген не?
Dialogue: 0,0:17:20.02,0:17:21.10,Text - JP,,0,0,0,,Уааах! Ол өліп қалды!
Dialogue: 0,0:17:21.68,0:17:27.11,Text - JP,,0,0,0,,...
Dialogue: 0,0:17:27.48,0:17:30.34,Text - JP,,0,0,0,,...
Dialogue: 0,0:17:30.34,0:17:33.47,Text - JP,,0,0,0,,...
Dialogue: 0,0:17:33.47,0:17:36.64,Text - JP,,0,0,0,,...
Dialogue: 0,0:17:36.64,0:17:38.81,Text - JP,,0,0,0,,Мен оны дұрыс білемін деп айта алмаймын.
Dialogue: 0,0:17:38.81,0:17:40.37,Text - JP,,0,0,0,,Өте табиғи емес
Dialogue: 0,0:17:41.35,0:17:43.55,Text - JP,,0,0,0,,Өзіммен олай бетпе-бет келмеу
Dialogue: 0,0:17:44.38,0:17:46.25,Text - JP,,0,0,0,,Ережелерді есте сақтауға тырыспайды
Dialogue: 0,0:17:46.82,0:17:49.88,Text - JP,,0,0,0,,Білмейінше көре алмайтын пейзаждар бар.
Dialogue: 0,0:17:50.35,0:17:53.26,Text - JP,,0,0,0,,...
Dialogue: 0,0:17:53.26,0:17:55.05,Text - JP,,0,0,0,,Бұл мен оны көрмеймін деп емес.
Dialogue: 0,0:17:55.05,0:17:55.97,Text - JP,,0,0,0,,Мен оны көріп тұрсам да
Dialogue: 0,0:17:56.59,0:17:58.89,Text - JP,,0,0,0,,Егер сіз байқамаған болсаңыз...
Dialogue: 0,0:18:03.40,0:18:05.27,Text - JP,,0,0,0,,Сакигучи Сенпай
Dialogue: 0,0:18:05.77,0:18:07.38,Text - JP,,0,0,0,,Блэкджек дегеніміз не?
