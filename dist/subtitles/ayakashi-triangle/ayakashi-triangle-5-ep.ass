Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.21,0:00:03.25,Default,,0,0,0,,Мацури?
Dialogue: 0,0:00:04.42,0:00:05.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:08.59,0:00:09.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:12.80,0:00:13.88,Default,,0,0,0,,Мацури
Dialogue: 0,0:00:14.55,0:00:17.22,Default,,0,0,0,,Ха... Сузу?
Dialogue: 0,0:00:23.23,0:00:26.06,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:00:29.57,0:00:32.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:34.78,0:00:36.16,Default,,0,0,0,,Жұмсақ…
Dialogue: 0,0:00:36.66,0:00:38.83,Default,,0,0,0,,Бұл, осы сезім...
Dialogue: 0,0:00:39.70,0:00:43.54,Default,,0,0,0,,Сузу сені сүйіп жатыр ма? мен
Dialogue: 0,0:00:45.83,0:00:47.96,Default,,0,0,0,,H... Ұятсыз
Dialogue: 0,0:00:51.50,0:00:53.59,Default,,0,0,0,,Сузу! Сіз ше...
Dialogue: 0,0:00:53.67,0:00:54.30,Default,,0,0,0,,Ах
Dialogue: 0,0:00:56.55,0:00:57.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:58.22,0:00:59.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:00.76,0:01:01.68,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:01:06.19,0:01:07.56,Default,,0,0,0,,Ах
Dialogue: 0,0:01:09.11,0:01:11.15,Default,,0,0,0,,Сәлем (Мари) Сузу, жақсысың ба?
Dialogue: 0,0:01:11.23,0:01:12.19,Default,,0,0,0,,Мацури!
Dialogue: 0,0:01:12.28,0:01:14.99,Default,,0,0,0,,Сіз қауіпсізсіз бе? Жақсы
Dialogue: 0,0:01:15.49,0:01:17.95,Default,,0,0,0,,Бірдеңе болды ма...?
Dialogue: 0,0:01:18.03,0:01:20.99,Default,,0,0,0,,Жоқ, жақсы...
Dialogue: 0,0:01:21.08,0:01:23.45,Default,,0,0,0,,Бұл сен туралы аян сияқты...
Dialogue: 0,0:01:23.54,0:01:25.41,Default,,0,0,0,,Менің бөлмемде үлпілдек...
Dialogue: 0,0:01:26.00,0:01:27.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:30.84,0:01:32.59,Default,,0,0,0,,«Юкай»
Dialogue: 0,0:01:32.67,0:01:36.80,Default,,0,0,0,,Ол жұмбақ, адам көзіне көрінбейді.
Dialogue: 0,0:01:37.30,0:01:40.43,Default,,0,0,0,,Адамдардан кек алатын зұлым құбыжықты жою үшін
Dialogue: 0,0:01:40.93,0:01:44.68,Default,,0,0,0,,Ежелден соғысып келе жатқан ниндзялар бар.
Dialogue: 0,0:01:45.93,0:01:47.06,Default,,0,0,0,,Оның аты
Dialogue: 0,0:01:52.82,0:01:54.53,Default,,0,0,0,,Жын шығару
Dialogue: 0,0:01:55.03,0:01:57.03,Default,,0,0,0,,♪～
Dialogue: 0,0:03:22.91,0:03:24.91,Default,,0,0,0,,～♪
Dialogue: 0,0:03:26.49,0:03:27.45,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:27.54,0:03:30.41,Default,,0,0,0,,Бұл «омокаж» болуы мүмкін
Dialogue: 0,0:03:31.16,0:03:32.37,Default,,0,0,0,,Омокаж?
Dialogue: 0,0:03:32.46,0:03:34.54,Default,,0,0,0,,Бұл клондық жын.
Dialogue: 0,0:03:35.42,0:03:36.71,Default,,0,0,0,,«Аян»
Dialogue: 0,0:03:36.79,0:03:40.42,Default,,0,0,0,,Батыста доппелгангерлер деп те аталады.
Dialogue: 0,0:03:40.51,0:03:42.22,Default,,0,0,0,,Күйзеліс сияқты факторларға байланысты
Dialogue: 0,0:03:42.30,0:03:46.93,Default,,0,0,0,,Тәннің мәні денеден сырғып шығады.
Dialogue: 0,0:03:47.43,0:03:51.89,Default,,0,0,0,,Нағыз адамның сыртқы түрінен көпшілікке оңай көрінеді
Dialogue: 0,0:03:51.98,0:03:55.56,Default,,0,0,0,,Еріксіз елес боп айналамын.
Dialogue: 0,0:03:55.65,0:03:58.98,Default,,0,0,0,,Ақырында ол тарап кетеді және жоғалады.
Dialogue: 0,0:03:59.61,0:04:01.40,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:04:01.49,0:04:04.91,Default,,0,0,0,,Олай болса, бұл бұрыннан болған шығар...
Dialogue: 0,0:04:05.66,0:04:08.79,Default,,0,0,0,,Бұл... менің ойыншығым...
Dialogue: 0,0:04:09.29,0:04:11.62,Default,,0,0,0,,Сен Маридің бөлмесінде не істедің?
Dialogue: 0,0:04:11.70,0:04:12.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:12.62,0:04:14.46,Default,,0,0,0,,Ұятсыз
Dialogue: 0,0:04:14.54,0:04:18.67,Default,,0,0,0,,Ал... жарайды, ол кенет пайда болды, содан кейін жоғалып кетті.
Dialogue: 0,0:04:18.75,0:04:19.84,Default,,0,0,0,,Мүмкін емес — сен Шиндо емессің ғой…
Dialogue: 0,0:04:20.51,0:04:21.80,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:04:22.59,0:04:25.22,Default,,0,0,0,,«Мен сені сүйдім» деп айта алмаймын
Dialogue: 0,0:04:25.72,0:04:26.43,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:26.51,0:04:28.01,Default,,0,0,0,,Цуу~!
Dialogue: 0,0:04:28.10,0:04:29.93,Default,,0,0,0,,Сәлем! Сузуға не болды?
Dialogue: 0,0:04:30.01,0:04:32.77,Default,,0,0,0,,Менің басыма бірдеңе соқты.
Dialogue: 0,0:04:32.85,0:04:34.69,Default,,0,0,0,,Мен ештеңе істемесем де
Dialogue: 0,0:04:34.77,0:04:37.94,Default,,0,0,0,,Хмм? Мұндай жағдай бола ма?
Dialogue: 0,0:04:38.02,0:04:39.77,Default,,0,0,0,,Сіз нені айтасыз, ата?
Dialogue: 0,0:04:39.86,0:04:43.24,Default,,0,0,0,,Омокаджмен сезімдерін бөліседі
Dialogue: 0,0:04:43.32,0:04:44.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:44.53,0:04:45.61,Default,,0,0,0,,Егер...
Dialogue: 0,0:04:46.20,0:04:48.74,Default,,0,0,0,,Әлі кеткен жоқ
Dialogue: 0,0:04:49.45,0:04:53.71,Default,,0,0,0,,Сузу-чанның ойыншық торы әлі бір жерде кезіп жүр
Dialogue: 0,0:04:53.79,0:04:55.58,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:04:55.67,0:04:58.21,Default,,0,0,0,,Сізге қауіпті құбыжық шабуыл жасай ма?
Dialogue: 0,0:04:58.79,0:05:04.09,Default,,0,0,0,,Немесе жол апатына түссең, Сузу-чанның денесі де...
Dialogue: 0,0:05:06.18,0:05:07.18,Default,,0,0,0,,Ha
Dialogue: 0,0:05:07.26,0:05:08.43,Default,,0,0,0,,Айналаңды ізде!
Dialogue: 0,0:05:08.51,0:05:12.85,Default,,0,0,0,,Suzu-мен сөйлесу Оны маған байланыс тюнинг шанышқысы арқылы жеткізіңіз.
Dialogue: 0,0:05:16.64,0:05:17.90,Default,,0,0,0,,Ата
Dialogue: 0,0:05:17.98,0:05:20.36,Default,,0,0,0,,Анықтама бар ма, айтыңызшы!
Dialogue: 0,0:05:20.44,0:05:21.77,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:05:22.28,0:05:25.03,Default,,0,0,0,,Сіз бірдеңені сезесіз бе? Сузу-чан
Dialogue: 0,0:05:25.61,0:05:26.61,Default,,0,0,0,,Сезім?
Dialogue: 0,0:05:27.11,0:05:31.53,Default,,0,0,0,,Хм, көшеде жалаңаяқ келе жатқан сияқтымын.
Dialogue: 0,0:05:32.24,0:05:34.87,Default,,0,0,0,,Аяғымның табаны дірілдейді.
Dialogue: 0,0:05:34.95,0:05:36.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:36.91,0:05:38.79,Default,,0,0,0,,Әлі де көп орын бар сияқты.
Dialogue: 0,0:05:38.88,0:05:42.00,Default,,0,0,0,,Егер сіз қарапайым адам болсаңыз, тіпті омокаж пайда болса да.
Dialogue: 0,0:05:42.09,0:05:45.09,Default,,0,0,0,,Бұл ұзаққа созылмауы керек.
Dialogue: 0,0:05:45.17,0:05:49.89,Default,,0,0,0,,Священие... өмірдің артық секрециясы?
Dialogue: 0,0:05:52.43,0:05:54.14,Default,,0,0,0,,Сузу!
Dialogue: 0,0:05:55.89,0:05:58.69,Default,,0,0,0,,Тәтті, бұл жерде де жоқ.
Dialogue: 0,0:05:58.77,0:06:01.40,Default,,0,0,0,,Ақыр аяғында сіз жарты адамсыз.
Dialogue: 0,0:06:01.48,0:06:03.02,Default,,0,0,0,,Широган
Dialogue: 0,0:06:03.11,0:06:05.90,Default,,0,0,0,,Сіз бұған дейін бастық айтқан боларсыз.
Dialogue: 0,0:06:06.49,0:06:09.78,Default,,0,0,0,,«Мен Сузу қайда баратынын білемін.»
Dialogue: 0,0:06:09.86,0:06:10.53,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:11.03,0:06:13.74,Default,,0,0,0,,Бақсы – менің олжағым.
Dialogue: 0,0:06:14.33,0:06:16.25,Default,,0,0,0,,Мен тамақ ішпей тұрып өлгім келмейді.
Dialogue: 0,0:06:16.33,0:06:17.21,Default,,0,0,0,,Өйткені менің таңдауым жоқ
Dialogue: 0,0:06:17.29,0:06:20.63,Default,,0,0,0,,Мен сізге иіс сезу қабілетін беремін.
Dialogue: 0,0:06:21.63,0:06:22.84,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:22.92,0:06:27.88,Default,,0,0,0,,Жынның бес сезімі сіз адамдарға қарағанда басқа деңгейде.
Dialogue: 0,0:06:28.38,0:06:30.47,Default,,0,0,0,,Кункун Кункун…
Dialogue: 0,0:06:30.55,0:06:32.93,Default,,0,0,0,,Кункун Кункун Кункун Кункун…
Dialogue: 0,0:06:33.01,0:06:35.01,Default,,0,0,0,,Кункун Кункун...
Dialogue: 0,0:06:35.10,0:06:38.10,Default,,0,0,0,,Кункун, жақын, мына жақта!
Dialogue: 0,0:06:38.18,0:06:39.64,Default,,0,0,0,,О~
Dialogue: 0,0:06:41.56,0:06:42.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:42.48,0:06:44.11,Default,,0,0,0,,Бұл пайдасыз!
Dialogue: 0,0:06:44.19,0:06:46.28,Default,,0,0,0,,«Әртүрлі мәртебе» дегеніміз не?
Dialogue: 0,0:06:46.36,0:06:48.65,Default,,0,0,0,,Сен менің бала күнгі досымсың!
Dialogue: 0,0:06:48.74,0:06:51.32,Default,,0,0,0,,Қазір ұрысатын уақыт емес, Мари.
Dialogue: 0,0:06:51.41,0:06:53.37,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:06:53.45,0:06:57.33,Default,,0,0,0,,Сузу-чан сенде жүруден басқа сезім бар ма?
Dialogue: 0,0:06:58.45,0:06:59.66,Default,,0,0,0,,(Марио) Ж… Жуық келме. Бұл тұзақ.
Dialogue: 0,0:07:01.71,0:07:03.88,Default,,0,0,0,,Бетке ұру
Dialogue: 0,0:07:05.92,0:07:09.88,Default,,0,0,0,,Шөптің иісі бар... Шамасы.
Dialogue: 0,0:07:09.97,0:07:11.93,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:07:12.51,0:07:16.43,Default,,0,0,0,,Не? Бұл иіс... сиыр?
Dialogue: 0,0:07:16.51,0:07:17.93,Default,,0,0,0,,Сиыр?
Dialogue: 0,0:07:18.02,0:07:19.39,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:07:19.48,0:07:20.85,Default,,0,0,0,,Ранчо?
Dialogue: 0,0:07:24.77,0:07:25.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:26.19,0:07:28.28,Default,,0,0,0,,Сакура фермасының крепасы!
Dialogue: 0,0:07:30.32,0:07:31.49,Default,,0,0,0,,Мох?
Dialogue: 0,0:07:33.53,0:07:35.95,Default,,0,0,0,,Дұрыс, Сакура Ранч!
Dialogue: 0,0:07:36.03,0:07:39.33,Default,,0,0,0,,Жаңа сығылған сүт қосылған крептер - менің сүйікті!
Dialogue: 0,0:07:39.41,0:07:40.66,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:07:49.09,0:07:50.38,Default,,0,0,0,,(Масуридің ауыр тыныс алуы)
Dialogue: 0,0:07:50.97,0:07:54.09,Default,,0,0,0,,Сузу санасының әсерінен қозғала ма?
Dialogue: 0,0:07:54.18,0:07:58.35,Default,,0,0,0,,Қос дене, адам мен жын, екі дене...
Dialogue: 0,0:07:59.31,0:08:04.02,Default,,0,0,0,,Адамды да, жынды да біріктіретін болмыс деседі.
Dialogue: 0,0:08:04.52,0:08:05.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:06.36,0:08:07.02,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:07.11,0:08:09.57,Default,,0,0,0,,...
Dialogue: 0,0:08:09.65,0:08:10.74,Default,,0,0,0,,Не болды, Сузу!
Dialogue: 0,0:08:10.82,0:08:13.24,Default,,0,0,0,,Жоқ... мұнда не істеп жүрсің?
Dialogue: 0,0:08:13.82,0:08:17.95,Default,,0,0,0,,Жоқ! Бұл өте ауыр!
Dialogue: 0,0:08:18.83,0:08:21.04,Default,,0,0,0,,Сізге крептер қажет болуы мүмкін
Dialogue: 0,0:08:21.62,0:08:24.25,Default,,0,0,0,,Жалаң қолыңызбен ысырманы ашуға тырысасыз ба?
Dialogue: 0,0:08:24.33,0:08:25.88,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:08:25.96,0:08:27.38,Default,,0,0,0,,Тек араласып жүрсің...
Dialogue: 0,0:08:27.96,0:08:29.63,Default,,0,0,0,,Құбыжық Омокаж
Dialogue: 0,0:08:29.71,0:08:33.38,Default,,0,0,0,,Адам ағзасынан тыс күш көрсетуге қабілетті.
Dialogue: 0,0:08:33.47,0:08:36.84,Default,,0,0,0,,Дегенмен, сезімді бөлісетін адам
Dialogue: 0,0:08:36.93,0:08:39.43,Default,,0,0,0,,Мен бұл күшке шыдай алмаймын!
Dialogue: 0,0:08:39.51,0:08:41.39,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:08:41.47,0:08:45.39,Default,,0,0,0,,Тезірек жүр, Мари! Сузудың саусағы сынған
Dialogue: 0,0:08:45.48,0:08:48.15,Default,,0,0,0,,Сіз өте асығыссыз!
Dialogue: 0,0:08:51.28,0:08:54.78,Default,,0,0,0,,Алыста! Маған ұшуға рұқсат етіңіз, Мари!
Dialogue: 0,0:08:55.40,0:08:56.36,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:08:57.03,0:08:58.66,Default,,0,0,0,,Ниндзяларды тазарту техникасы
Dialogue: 0,0:08:59.41,0:09:01.62,Default,,0,0,0,,Гофудзин!
Dialogue: 0,0:09:03.12,0:09:04.96,Default,,0,0,0,,Өзгеріс өнері!
Dialogue: 0,0:09:05.67,0:09:08.25,Default,,0,0,0,,Сакура фермасының крепасы!
Dialogue: 0,0:09:14.76,0:09:15.88,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:09:18.26,0:09:19.47,Default,,0,0,0,,Гяаа!
Dialogue: 0,0:09:19.55,0:09:22.93,Default,,0,0,0,,Мияу, тез ұста, Марисато!
Dialogue: 0,0:09:23.02,0:09:24.14,Default,,0,0,0,,О
Dialogue: 0,0:09:24.77,0:09:27.60,Default,,0,0,0,,Гуджиджи Гуджиджи~!
Dialogue: 0,0:09:28.31,0:09:29.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:31.15,0:09:34.53,Default,,0,0,0,,Паку… қалайы пішінін жоғалтып, жоғалып кетті ме?
Dialogue: 0,0:09:36.78,0:09:37.66,Default,,0,0,0,,Ах
Dialogue: 0,0:09:39.57,0:09:42.70,Default,,0,0,0,,Тамақ ішейін деп тұрғанда жеп кете жаздадым.
Dialogue: 0,0:09:43.29,0:09:46.12,Default,,0,0,0,,Бірдеңе жесең, Сузудың іші бұзылады.
Dialogue: 0,0:09:46.62,0:09:49.58,Default,,0,0,0,,Хаа... ау менің.
Dialogue: 0,0:09:49.67,0:09:52.50,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:10:01.76,0:10:03.47,Default,,0,0,0,,Олай болса, ұйықтар алдында
Dialogue: 0,0:10:03.56,0:10:05.77,Default,,0,0,0,,«Мен креп жегім келеді» деп ойладыңыз ба?
Dialogue: 0,0:10:05.85,0:10:06.64,Default,,0,0,0,,Иә
Dialogue: 0,0:10:06.73,0:10:11.23,Default,,0,0,0,,Сонымен мақсат орындалып, омокаж тазартылды ма?
Dialogue: 0,0:10:11.90,0:10:15.03,Default,,0,0,0,,Рахмет, бәрі Широганның арқасында.
Dialogue: 0,0:10:15.11,0:10:18.07,Default,,0,0,0,,Хмф, бұл сізге арналмаған.
Dialogue: 0,0:10:18.70,0:10:19.70,Default,,0,0,0,,Саусағыңыз сынған болса
Dialogue: 0,0:10:19.78,0:10:22.66,Default,,0,0,0,,Үйдегі тары тұшпараларын да жей алмайсыз.
Dialogue: 0,0:10:22.74,0:10:24.83,Default,,0,0,0,,Оған ұнады.
Dialogue: 0,0:10:26.87,0:10:29.87,Default,,0,0,0,,Бұл жай ғана крептер туралы, солай ма?
Dialogue: 0,0:10:30.50,0:10:32.25,Default,,0,0,0,,Мен ұйықтар алдында осыны ойлап отыр едім
Dialogue: 0,0:10:32.34,0:10:34.42,Default,,0,0,0,,А... бұл анық.
Dialogue: 0,0:10:36.30,0:10:38.88,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:10:39.47,0:10:42.09,Default,,0,0,0,,Жоқ, ештеңе...
Dialogue: 0,0:10:43.47,0:10:48.06,Default,,0,0,0,,Бұл оқиға бақсы құдіретінің бір көрінісі ғана.
Dialogue: 0,0:10:48.56,0:10:51.98,Default,,0,0,0,,Бұл жігіттерге бұлай айтуға негіз жоқ.
Dialogue: 0,0:10:52.73,0:10:55.61,Default,,0,0,0,,Бірақ қазір түсінікті
Dialogue: 0,0:10:56.40,0:10:59.45,Default,,0,0,0,,Сузу әлі ұятсыз!
Dialogue: 0,0:11:02.41,0:11:05.79,Default,,0,0,0,,Сонымен Сузу Хананаде омокажды жасады ма?
Dialogue: 0,0:11:05.87,0:11:07.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:07.66,0:11:10.54,Default,,0,0,0,,Мен көрген жындар көп.
Dialogue: 0,0:11:10.62,0:11:11.67,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:12.96,0:11:13.88,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:13.96,0:11:16.00,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:11:16.09,0:11:17.34,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:11:17.96,0:11:19.26,Default,,0,0,0,,Қорқынышты~
Dialogue: 0,0:11:19.34,0:11:20.30,Default,,0,0,0,,Хун
Dialogue: 0,0:11:20.38,0:11:23.80,Default,,0,0,0,,Адамдар сыртқы түріне қарап тым көп баға береді.
Dialogue: 0,0:11:23.89,0:11:26.64,Default,,0,0,0,,Жаратқан Иенің іштей кемшілігі болмаса да.
Dialogue: 0,0:11:27.39,0:11:30.10,Default,,0,0,0,,Мен өзімнің қайратты екенімді білемін.
Dialogue: 0,0:11:30.18,0:11:31.48,Default,,0,0,0,,Маған қазір бәрібір
Dialogue: 0,0:11:31.56,0:11:34.81,Default,,0,0,0,,Бірақ оның арқасында мен мұны мүлдем істей алмадым.
Dialogue: 0,0:11:34.90,0:11:36.69,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:11:37.19,0:11:38.19,Default,,0,0,0,,Содан кейін олар жоғалады
Dialogue: 0,0:11:38.90,0:11:41.86,Default,,0,0,0,,Алайда құбыжық сияқты жағы ақырында пайда болады.
Dialogue: 0,0:11:41.95,0:11:44.91,Default,,0,0,0,,Сен күшейіп бара жатқан сияқтысың, Сузу Ханано
Dialogue: 0,0:11:45.41,0:11:47.37,Default,,0,0,0,,Бізге қазір бірдеңе істеу керек.
Dialogue: 0,0:11:47.45,0:11:48.33,Default,,0,0,0,,Нинокёку Сенпай
Dialogue: 0,0:11:48.41,0:11:49.08,Default,,0,0,0,,Ах
Dialogue: 0,0:11:50.20,0:11:50.96,Default,,0,0,0,,Сіз...
Dialogue: 0,0:11:51.46,0:11:54.42,Default,,0,0,0,,Бұл Мацуридің бала күнгі досы Сузу Ханасаде.
Dialogue: 0,0:11:55.25,0:11:56.79,Default,,0,0,0,,Менен не керек?
Dialogue: 0,0:11:57.29,0:12:00.30,Default,,0,0,0,,Мм... сабақтан кейін
Dialogue: 0,0:12:01.51,0:12:03.93,Default,,0,0,0,,Менімен араласуыңызды сұрай аламын ба?
Dialogue: 0,0:12:04.01,0:12:05.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:05.85,0:12:08.10,Default,,0,0,0,,Мен сенімен сөйлескім келеді
Dialogue: 0,0:12:09.01,0:12:13.06,Default,,0,0,0,,Көктем келді, Мырза!
Dialogue: 0,0:12:14.69,0:12:17.77,Default,,0,0,0,,Үлкеніңізбен бе? Сен не туралы айтып тұрсың?
Dialogue: 0,0:12:18.48,0:12:20.78,Default,,0,0,0,,Ол адам сенің жаныңда емес пе?
Dialogue: 0,0:12:21.28,0:12:25.20,Default,,0,0,0,,Мацури мен Широгане арасындағы қарым-қатынас үшін пайдалы болуы мүмкін.
Dialogue: 0,0:12:25.70,0:12:27.70,Default,,0,0,0,,Уақытты босқа кетіру
Dialogue: 0,0:12:28.83,0:12:32.96,Default,,0,0,0,,Сузу жындар мен жын шығарушылар әлеміне енеді.
Dialogue: 0,0:12:33.04,0:12:34.58,Default,,0,0,0,,Маған әсер еткен жоқ.
Dialogue: 0,0:12:34.67,0:12:35.71,Default,,0,0,0,,Мен оны итеріп жіберейін.
Dialogue: 0,0:12:35.79,0:12:36.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:36.67,0:12:39.34,Default,,0,0,0,,Ең болмағанда түсінгім келеді.
Dialogue: 0,0:12:39.84,0:12:42.80,Default,,0,0,0,,Мен Мацуриге қиындық туғызамын.
Dialogue: 0,0:12:43.84,0:12:45.18,Default,,0,0,0,,Юбе...
Dialogue: 0,0:12:45.26,0:12:46.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:49.81,0:12:52.02,Default,,0,0,0,,Қарғыс атсын, есіме түсті.
Dialogue: 0,0:12:52.10,0:12:55.19,Default,,0,0,0,,Мен Сузудың түрін дұрыс көре алмаймын.
Dialogue: 0,0:12:55.27,0:12:57.06,Default,,0,0,0,,Сабыр етіңіз, бұл сіздің клоныңыз.
Dialogue: 0,0:12:57.15,0:12:59.19,Default,,0,0,0,,мүмкін емес Бұл мүмкін емес болуы керек!
Dialogue: 0,0:12:59.27,0:13:00.27,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:13:00.36,0:13:01.28,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:13:01.36,0:13:03.74,Default,,0,0,0,,Қараңызшы, уақыт келді.
Dialogue: 0,0:13:03.82,0:13:05.11,Default,,0,0,0,,Екеуің кеттік.
Dialogue: 0,0:13:05.20,0:13:07.95,Default,,0,0,0,,Эй, мен қызық емеспін.
Dialogue: 0,0:13:08.03,0:13:10.03,Default,,0,0,0,,Тек қана қаңылтырмен жүріңіз
Dialogue: 0,0:13:12.62,0:13:13.87,Default,,0,0,0,,Поп... Поп
Dialogue: 0,0:13:13.95,0:13:16.17,Default,,0,0,0,,Бір адам...?
Dialogue: 0,0:13:16.79,0:13:20.34,Default,,0,0,0,,Ахаха... Жаңа ғана сонда болдым.
Dialogue: 0,0:13:21.50,0:13:23.09,Default,,0,0,0,,Егер осылай салқынқанды болып жүре берсең, сүйкімді жүзіңді бүлдіріп аласың.
Dialogue: 0,0:13:23.17,0:13:26.80,Default,,0,0,0,,Әрине, мен бұл Казамакиді қамтитын лента деп ойладым.
Dialogue: 0,0:13:27.30,0:13:29.93,Default,,0,0,0,,Аяғынан шалынған қыздар
Dialogue: 0,0:13:30.51,0:13:33.02,Default,,0,0,0,,Ах Сузу, сен мектеп бітірдің бе?
Dialogue: 0,0:13:33.10,0:13:33.81,Default,,0,0,0,,Иә
Dialogue: 0,0:13:33.89,0:13:37.39,Default,,0,0,0,,Сіз өткен күні ойлап тапқан жеміс парфеті.
Dialogue: 0,0:13:37.48,0:13:39.10,Default,,0,0,0,,Морецу танымал
Dialogue: 0,0:13:39.61,0:13:41.19,Default,,0,0,0,,Бұл шынымен көмектеседі
Dialogue: 0,0:13:41.27,0:13:42.90,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:13:42.98,0:13:45.65,Default,,0,0,0,,Мама, кәдімгі орныңыз жақсы ма?
Dialogue: 0,0:13:45.74,0:13:48.41,Default,,0,0,0,,Мен ағамнан мектеп туралы кеңес сұрадым.
Dialogue: 0,0:13:48.49,0:13:50.12,Default,,0,0,0,,Күрсін! (Әке) Нуо!
Dialogue: 0,0:13:52.33,0:13:55.12,Default,,0,0,0,,Кәмпиттер мәзірі кең, солай ма?
Dialogue: 0,0:13:55.20,0:13:58.42,Default,,0,0,0,,Мен ұсынамын...
Dialogue: 0,0:13:58.50,0:14:00.25,Default,,0,0,0,,Қара кофе
Dialogue: 0,0:14:00.33,0:14:03.17,Default,,0,0,0,,А, сен тәттілерді ұнатпайсың ба?
Dialogue: 0,0:14:03.25,0:14:04.21,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:04.30,0:14:08.38,Default,,0,0,0,,Биік және жабайы. Ол әкесіне мүлдем қарама-қайшы.
Dialogue: 0,0:14:08.88,0:14:11.05,Default,,0,0,0,,Олар үнсіз болуымен ұқсас.
Dialogue: 0,0:14:11.76,0:14:14.10,Default,,0,0,0,,Қараңдар! тыңдама
Dialogue: 0,0:14:14.18,0:14:15.43,Default,,0,0,0,,Сіздің тапсырысыңыз орындалды ма?
Dialogue: 0,0:14:15.52,0:14:16.52,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:14:18.39,0:14:22.48,Default,,0,0,0,,Боқ-ау, Сенпаймен не сөйлестің, Сузу?
Dialogue: 0,0:14:23.07,0:14:25.40,Default,,0,0,0,,Егер сізді қызықтырса, барыңыз.
Dialogue: 0,0:14:25.48,0:14:27.53,Default,,0,0,0,,Енді қайтып оралу жағымсыз болар еді.
Dialogue: 0,0:14:27.61,0:14:31.24,Default,,0,0,0,,Темпераментпен қашқанда жаман болды.
Dialogue: 0,0:14:31.32,0:14:32.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:32.70,0:14:33.78,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:14:33.87,0:14:37.66,Default,,0,0,0,,Ниномагари мен Сузу осыдан кейін дос болғанымен
Dialogue: 0,0:14:38.96,0:14:41.04,Default,,0,0,0,,Жоқ... жарайды.
Dialogue: 0,0:14:41.13,0:14:43.63,Default,,0,0,0,,Тіпті біреумен кездесіп жүрсе де
Dialogue: 0,0:14:43.71,0:14:45.71,Default,,0,0,0,,Оның маған қатысы жоқ.
Dialogue: 0,0:14:46.46,0:14:49.43,Default,,0,0,0,,Оны қорғау менің жын шығарушы ретіндегі міндетім.
Dialogue: 0,0:14:50.30,0:14:52.97,Default,,0,0,0,,Бұл жігіт Сузудан да көңілді және көңілді.
Dialogue: 0,0:14:53.47,0:14:55.93,Default,,0,0,0,,Мен сені тағы да мазақ етейін бе?
Dialogue: 0,0:14:56.68,0:14:59.31,Default,,0,0,0,,Күткендей, мен де алаңдаймын.
Dialogue: 0,0:14:59.39,0:15:03.48,Default,,0,0,0,,Дүкенге Сузу байқамай кіріңіз, менде жақсы идея бар.
Dialogue: 0,0:15:04.06,0:15:04.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:04.82,0:15:09.36,Default,,0,0,0,,Эй, пуритандық одақ деген ұйым бар.
Dialogue: 0,0:15:10.20,0:15:10.95,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:15:12.45,0:15:17.20,Default,,0,0,0,,Баяғыда Токугава сегунаты жасырын түрде құрылды
Dialogue: 0,0:15:17.70,0:15:19.91,Default,,0,0,0,,Біздің Жапонияда филиалдарымыз бар.
Dialogue: 0,0:15:20.00,0:15:24.71,Default,,0,0,0,,Бейтаныс заттар туралы ақпарат жинап, қоғамдық тәртіпті сақтау
Dialogue: 0,0:15:26.25,0:15:28.26,Default,,0,0,0,,Сонда сен ниндзясың ба?
Dialogue: 0,0:15:28.34,0:15:31.38,Default,,0,0,0,,Мари, сен маған ешқашан ондай ештеңе айтқан емессің.
Dialogue: 0,0:15:31.97,0:15:34.64,Default,,0,0,0,,Мырза, менің қолдарым қатты дірілдеп тұр.
Dialogue: 0,0:15:35.14,0:15:36.39,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:15:36.47,0:15:41.27,Default,,0,0,0,,Алайда бұл шиеленіс сезімі қызбен бетпе-бет кездескенде
Dialogue: 0,0:15:41.35,0:15:43.81,Default,,0,0,0,,Жындармен күрескен жақсы
Dialogue: 0,0:15:43.90,0:15:45.77,Default,,0,0,0,,Не, сыбырлап сөйлеп тұрсың ба?
Dialogue: 0,0:15:45.86,0:15:46.77,Default,,0,0,0,,Уф
Dialogue: 0,0:15:47.69,0:15:48.73,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:15:50.19,0:15:51.07,Default,,0,0,0,,Ах... (Поносуке) По...
Dialogue: 0,0:15:51.95,0:15:53.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:53.70,0:15:56.49,Default,,0,0,0,,Бұл Поносуке-чан болды ма?
Dialogue: 0,0:15:56.58,0:15:58.33,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:15:59.58,0:16:00.79,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:16:00.87,0:16:02.46,Default,,0,0,0,,Эххе~
Dialogue: 0,0:16:02.54,0:16:06.04,Default,,0,0,0,,Жүріп келе жатып, кенет ішке кіргім келді.
Dialogue: 0,0:16:06.13,0:16:09.80,Default,,0,0,0,,Торт жейік... Жеймін деп ойлаймын~
Dialogue: 0,0:16:09.88,0:16:12.72,Default,,0,0,0,,Мм... бос орынға отырыңыз.
Dialogue: 0,0:16:12.80,0:16:16.01,Default,,0,0,0,,Иә, мен сенің қалағаныңды істеймін.
Dialogue: 0,0:16:17.18,0:16:20.02,Default,,0,0,0,,Вау~ Терезе жанындағы салқын орын!
Dialogue: 0,0:16:20.10,0:16:21.89,Default,,0,0,0,,Бұл жер жақсы ма?
Dialogue: 0,0:16:22.73,0:16:24.14,Default,,0,0,0,,Сіз не істеп жатырсыз? Мацури
Dialogue: 0,0:16:24.23,0:16:25.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:25.69,0:16:27.69,Default,,0,0,0,,Көрініп тұр, бейбақ!
Dialogue: 0,0:16:27.77,0:16:29.44,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:16:29.53,0:16:31.86,Default,,0,0,0,,Менің стратегиям тамаша.
Dialogue: 0,0:16:31.94,0:16:35.78,Default,,0,0,0,,Бұл кім? Бұл басқа біреу сияқты емес пе?
Dialogue: 0,0:16:35.86,0:16:37.32,Default,,0,0,0,,Енді...
Dialogue: 0,0:16:37.91,0:16:39.83,Default,,0,0,0,,Тапсырыс беруге дайынсыз ба?
Dialogue: 0,0:16:39.91,0:16:40.62,Default,,0,0,0,,А...
Dialogue: 0,0:16:40.70,0:16:45.04,Default,,0,0,0,,...
Dialogue: 0,0:16:45.54,0:16:49.88,Default,,0,0,0,,«Апельсин қабығы... Маритозцо»?
Dialogue: 0,0:16:49.96,0:16:52.84,Default,,0,0,0,,«Бұл... Хатторте...»
Dialogue: 0,0:16:52.92,0:16:55.34,Default,,0,0,0,,«Пастел де ната...»
Dialogue: 0,0:16:56.34,0:16:57.72,Default,,0,0,0,,Мен бір нәрсені түсінбеймін.
Dialogue: 0,0:16:57.80,0:17:00.89,Default,,0,0,0,,А... Мен белгіленген уақытта қайтамын.
Dialogue: 0,0:17:01.39,0:17:03.52,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:04.23,0:17:07.77,Default,,0,0,0,,Бұл сенің маған қатты көңіл бөлгеніңді білдіреді, солай ма?
Dialogue: 0,0:17:08.86,0:17:10.40,Default,,0,0,0,,Сенің ағаң жақсы екен.
Dialogue: 0,0:17:10.48,0:17:12.94,Default,,0,0,0,,Менің елес досым бар
Dialogue: 0,0:17:13.03,0:17:14.45,Default,,0,0,0,,Бұл Шики Они
Dialogue: 0,0:17:14.95,0:17:18.07,Default,,0,0,0,,Дос емес, қызметші сияқты
Dialogue: 0,0:17:18.66,0:17:19.45,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:19.53,0:17:22.83,Default,,0,0,0,,Иә, бұл қыз бақсы.
Dialogue: 0,0:17:23.33,0:17:25.04,Default,,0,0,0,,Мен жындарды көріп тұрмын
Dialogue: 0,0:17:26.00,0:17:30.88,Default,,0,0,0,,Поносукенің мәліметі бойынша, кеше түнде көптеген жындар көрінді.
Dialogue: 0,0:17:31.42,0:17:34.76,Default,,0,0,0,,Кезбе қыздың омокажы
Dialogue: 0,0:17:35.88,0:17:38.26,Default,,0,0,0,,Казамаки әзірге шешілген сияқты.
Dialogue: 0,0:17:38.93,0:17:42.10,Default,,0,0,0,,Менің ойымша, бұл қасиетті қыздың күші емес.
Dialogue: 0,0:17:43.64,0:17:47.69,Default,,0,0,0,,Байқау керек адам! Сақтықты түсірме, Поносуке.
Dialogue: 0,0:17:47.77,0:17:50.15,Default,,0,0,0,,Сіз ағаңызға ризасыз ба?
Dialogue: 0,0:17:50.23,0:17:52.90,Default,,0,0,0,,Әрине.
Dialogue: 0,0:17:52.98,0:17:54.90,Default,,0,0,0,,Бірден құшақтау?
Dialogue: 0,0:17:54.99,0:17:59.07,Default,,0,0,0,,Ақыр соңында, сен мейірімді көрінесің, Нинокёку-сенпай.
Dialogue: 0,0:17:59.16,0:18:01.62,Default,,0,0,0,,Мен? Мейірімді көрінеді ме?
Dialogue: 0,0:18:01.70,0:18:06.16,Default,,0,0,0,,Әлгі Сузу жігіті, сөйлеп көңілді жүрген сияқты.
Dialogue: 0,0:18:06.25,0:18:09.46,Default,,0,0,0,,Хехе, қызық болып барады.
Dialogue: 0,0:18:10.92,0:18:14.80,Default,,0,0,0,,Мен... мен сенің не айтып тұрғаныңды түсінбеймін...
Dialogue: 0,0:18:15.88,0:18:19.22,Default,,0,0,0,,Иеміз ебедейсіз.
Dialogue: 0,0:18:19.30,0:18:22.97,Default,,0,0,0,,Бірақ ол өте мейірімді адам.
Dialogue: 0,0:18:23.06,0:18:24.01,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:18:25.27,0:18:26.56,Default,,0,0,0,,Поносуке...
Dialogue: 0,0:18:27.31,0:18:30.02,Default,,0,0,0,,Иә! Тоқта
Dialogue: 0,0:18:30.60,0:18:32.02,Default,,0,0,0,,Фугия~ (Суга) Кет!
Dialogue: 0,0:18:32.94,0:18:36.61,Default,,0,0,0,,Ол жын болса да, мысық шабуылдайтын әлі жетілмеген жігіт.
Dialogue: 0,0:18:36.69,0:18:39.82,Default,,0,0,0,,Ах... Рахмет По.
Dialogue: 0,0:18:39.91,0:18:42.83,Default,,0,0,0,,Сіз құтқарушысыз
Dialogue: 0,0:18:42.91,0:18:43.58,Default,,0,0,0,,Хун
Dialogue: 0,0:18:46.16,0:18:49.75,Default,,0,0,0,,Менің жындармен тіл табысу ойым жоқ. Артымнан ерме.
Dialogue: 0,0:18:49.83,0:18:53.96,Default,,0,0,0,,Тәңірім, мені өзіңе қызметші ет.
Dialogue: 0,0:18:54.80,0:18:57.26,Default,,0,0,0,,Ием!
Dialogue: 0,0:19:02.26,0:19:02.85,Default,,0,0,0,,Га
Dialogue: 0,0:19:04.10,0:19:05.97,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:19:09.14,0:19:11.27,Default,,0,0,0,,Маған қызметші болғың келсе
Dialogue: 0,0:19:11.35,0:19:13.36,Default,,0,0,0,,Жарақатыңызды емдеп, жылдамырақ болыңыз
Dialogue: 0,0:19:14.57,0:19:15.36,Default,,0,0,0,,Порт…
Dialogue: 0,0:19:18.74,0:19:20.24,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:19:20.32,0:19:23.91,Default,,0,0,0,,Тағы бір бейтаныс қыз айқайлап қашып кетті.
Dialogue: 0,0:19:23.99,0:19:25.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:25.66,0:19:26.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:27.91,0:19:31.54,Default,,0,0,0,,Мен білмей тұрып, мен тыңдадым.
Dialogue: 0,0:19:31.62,0:19:34.29,Default,,0,0,0,,Кейбір адамдар Раббының ұлылығын түсінеді.
Dialogue: 0,0:19:34.38,0:19:36.75,Default,,0,0,0,,Бір күні көрінейік, По...
Dialogue: 0,0:19:37.34,0:19:37.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:39.17,0:19:42.59,Default,,0,0,0,,Өйткені сен сондай мейірімді адамсың.
Dialogue: 0,0:19:43.64,0:19:44.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:45.60,0:19:49.73,Default,,0,0,0,,Мен әр түрлі жындармен ойнайтынмын.
Dialogue: 0,0:19:49.81,0:19:51.27,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:19:52.23,0:19:55.48,Default,,0,0,0,,Екеуінің ерекше байланысы бар екендігі
Dialogue: 0,0:19:55.56,0:19:56.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.02,0:19:57.82,Default,,0,0,0,,Попопопоп…
Dialogue: 0,0:19:57.90,0:20:01.95,Default,,0,0,0,,Осындай адамдардың бар екенін білгеніме қуаныштымын.
Dialogue: 0,0:20:03.70,0:20:04.82,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:07.99,0:20:09.37,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:20:09.45,0:20:12.25,Default,,0,0,0,,А-а-а-а... у...
Dialogue: 0,0:20:12.33,0:20:13.83,Default,,0,0,0,,Сонымен, мысық құтымен
Dialogue: 0,0:20:13.92,0:20:15.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:15.08,0:20:16.59,Default,,0,0,0,,Рұқсатсыз сөйлеспе
Dialogue: 0,0:20:16.67,0:20:18.17,Default,,0,0,0,,Тез шешім қабылдаңыз
Dialogue: 0,0:20:18.88,0:20:20.38,Default,,0,0,0,,Suzudango қолжетімді.
Dialogue: 0,0:20:20.46,0:20:21.42,Default,,0,0,0,,О
Dialogue: 0,0:20:21.92,0:20:24.80,Default,,0,0,0,,Мен тік тұрамын!
Dialogue: 0,0:20:26.39,0:20:27.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:27.10,0:20:28.39,Default,,0,0,0,,Аа (ана) А?
Dialogue: 0,0:20:28.47,0:20:30.10,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:31.85,0:20:35.90,Default,,0,0,0,,Олай болса, Нинокёку-сенпай, бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:20:36.48,0:20:38.48,Default,,0,0,0,,Жақында кездескенше, Поносуке-чан
Dialogue: 0,0:20:38.57,0:20:42.49,Default,,0,0,0,,Сау бол, Сузу-сама, Мари-доно.
Dialogue: 0,0:20:45.20,0:20:47.16,Default,,0,0,0,,Бұл қызық болды!
Dialogue: 0,0:20:47.24,0:20:51.37,Default,,0,0,0,,Мен жындар мен жын шығарушылар туралы көп әңгіме естідім.
Dialogue: 0,0:20:51.45,0:20:52.70,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:20:52.79,0:20:56.75,Default,,0,0,0,,Мен келгеннен бері көп сөйлеспедік, Нинокёку-сенпай.
Dialogue: 0,0:20:56.83,0:21:01.09,Default,,0,0,0,,Бұл сіздің актерлік шеберлігіңіздің нашарлығынан болса керек.
Dialogue: 0,0:21:01.76,0:21:06.34,Default,,0,0,0,,Хаа~ Мен мұны істеуге болады деп ешқашан ойламадым.
Dialogue: 0,0:21:06.43,0:21:09.51,Default,,0,0,0,,Ой! Сондықтан мен сізге бұл мүмкін емес екенін қайта-қайта айттым.
Dialogue: 0,0:21:09.60,0:21:12.14,Default,,0,0,0,,Бірақ сіз алаңдаушылықтан шықтыңыз.
Dialogue: 0,0:21:13.60,0:21:15.64,Default,,0,0,0,,Рахмет Мари
Dialogue: 0,0:21:18.65,0:21:22.19,Default,,0,0,0,,Мен жай ғана торт жегім келді.
Dialogue: 0,0:21:22.69,0:21:24.03,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:26.66,0:21:30.08,Default,,0,0,0,,Неліктен бұл аздап жақсы сезінеді?
Dialogue: 0,0:21:30.58,0:21:32.49,Default,,0,0,0,,Мен адамдарды түсінбеймін.
Dialogue: 0,0:21:33.58,0:21:38.42,Default,,0,0,0,,Ертерек үшін кешірім сұраймын, сэр.
Dialogue: 0,0:21:40.71,0:21:44.17,Default,,0,0,0,,Сол адамның қолын тигізгені сондай жақсы сезім.
Dialogue: 0,0:21:44.26,0:21:46.13,Default,,0,0,0,,Бір ұйықтап ал
Dialogue: 0,0:21:47.30,0:21:50.60,Default,,0,0,0,,Бұл сиқыршы. Басқа амал жоқ.
Dialogue: 0,0:21:52.01,0:21:53.31,Default,,0,0,0,,Мырза?
Dialogue: 0,0:21:56.89,0:21:58.06,Default,,0,0,0,,Уау
Dialogue: 0,0:21:58.56,0:22:01.77,Default,,0,0,0,,Бұл... құдай.
Dialogue: 0,0:22:02.44,0:22:03.94,Default,,0,0,0,,Иә
Dialogue: 0,0:22:05.94,0:22:07.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.66,0:23:34.66,Default,,0,0,0,,～♪
