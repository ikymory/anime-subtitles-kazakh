Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.38,0:00:07.67,Default,,0,0,0,,Уау! Эй Сузу
Dialogue: 0,0:00:08.29,0:00:10.17,Default,,0,0,0,,Мен болсам
Dialogue: 0,0:00:10.76,0:00:13.55,Default,,0,0,0,,Фестиваль ауылына қолданылған сиқырды шешу қабілеті болса
Dialogue: 0,0:00:14.05,0:00:16.80,Default,,0,0,0,,Сіз өзіңізді бірінші рет бақытты сезінуіңіз мүмкін.
Dialogue: 0,0:00:17.89,0:00:20.72,Default,,0,0,0,,Мен бақсымын!
Dialogue: 0,0:00:20.81,0:00:23.77,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:00:23.85,0:00:26.48,Default,,0,0,0,,Ештеңе өзгермейді.
Dialogue: 0,0:00:29.19,0:00:32.78,Default,,0,0,0,,Бірақ менің күшім дұрыс кірді.
Dialogue: 0,0:00:33.61,0:00:34.45,Default,,0,0,0,,Иә
Dialogue: 0,0:00:37.78,0:00:39.53,Default,,0,0,0,,«Юкай»
Dialogue: 0,0:00:39.62,0:00:44.21,Default,,0,0,0,,Ол жұмбақ және адам көзіне көрінбейді.
Dialogue: 0,0:00:44.29,0:00:47.79,Default,,0,0,0,,Адамдардан кек алатын зұлым құбыжықты жою үшін
Dialogue: 0,0:00:47.88,0:00:51.63,Default,,0,0,0,,Ежелден соғысып келе жатқан ниндзялар бар.
Dialogue: 0,0:00:52.92,0:00:54.01,Default,,0,0,0,,Оның аты
Dialogue: 0,0:00:59.64,0:01:01.89,Default,,0,0,0,,Жын шығару
Dialogue: 0,0:01:01.97,0:01:03.98,Default,,0,0,0,,♪～
Dialogue: 0,0:02:29.94,0:02:31.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:46.70,0:02:48.83,Default,,0,0,0,,Сузу-кун күткендей
Dialogue: 0,0:02:49.41,0:02:51.21,Default,,0,0,0,,Сіз оны танығаннан кейін
Dialogue: 0,0:02:51.29,0:02:54.67,Default,,0,0,0,,Осыншама күшті басқаруға бола ма?
Dialogue: 0,0:02:55.42,0:02:59.80,Default,,0,0,0,,Оның сезімталдығы адамға қарағанда жынға жақынырақ.
Dialogue: 0,0:03:00.59,0:03:02.39,Default,,0,0,0,,Егер дұрыс басқарылмаса
Dialogue: 0,0:03:02.47,0:03:05.35,Default,,0,0,0,,Ойыншықтар өздігінен пайда болатын сияқты.
Dialogue: 0,0:03:05.43,0:03:08.02,Default,,0,0,0,,Хмф, ол біраз уақыттан бері шықты.
Dialogue: 0,0:03:08.10,0:03:11.52,Default,,0,0,0,,А, бірақ сен маған айтпадың ба?
Dialogue: 0,0:03:11.60,0:03:13.56,Default,,0,0,0,,Бұл шынымен жаман.
Dialogue: 0,0:03:13.65,0:03:15.02,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:03:17.23,0:03:18.90,Default,,0,0,0,,Қызықты балалар
Dialogue: 0,0:03:19.49,0:03:21.40,Default,,0,0,0,,Широгане мырзаның мақсаты туралы айтыңыз.
Dialogue: 0,0:03:21.99,0:03:23.53,Default,,0,0,0,,Екеуміз жарасып тұрсақ жақсы емес пе?
Dialogue: 0,0:03:26.53,0:03:28.33,Default,,0,0,0,,Адамдармен байланысы жоқ
Dialogue: 0,0:03:34.92,0:03:37.25,Default,,0,0,0,,(Ойын жұмысының дыбысы)
Dialogue: 0,0:03:37.34,0:03:38.84,Default,,0,0,0,,(дыбыс үстінде ойын)
Dialogue: 0,0:03:40.51,0:03:42.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:50.18,0:03:53.19,Default,,0,0,0,,Бұл не болды? Сол сезім
Dialogue: 0,0:03:55.40,0:03:56.44,Default,,0,0,0,,Сәлем, Мари!
Dialogue: 0,0:03:57.69,0:03:59.90,Default,,0,0,0,,Кім кенеттен кіріп келеді?
Dialogue: 0,0:03:59.98,0:04:01.03,Default,,0,0,0,,А…?
Dialogue: 0,0:04:01.11,0:04:01.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.45,0:04:04.99,Default,,0,0,0,,Жаман нәрсе шыққан сияқты.
Dialogue: 0,0:04:06.62,0:04:08.28,Default,,0,0,0,,Ооооо~!
Dialogue: 0,0:04:10.58,0:04:12.91,Default,,0,0,0,,Ооооо~!
Dialogue: 0,0:04:16.08,0:04:19.34,Default,,0,0,0,,Бұл нысана... Тағы басқа жан?
Dialogue: 0,0:04:20.26,0:04:23.13,Default,,0,0,0,,Жын болғанына қарамастан, ол басқа жындарға шабуыл жасайды.
Dialogue: 0,0:04:23.76,0:04:25.76,Default,,0,0,0,,Ол қалыптаса бастады
Dialogue: 0,0:04:25.84,0:04:28.30,Default,,0,0,0,,Біз оны одан әрі өспей тұрып тоқтатуымыз керек.
Dialogue: 0,0:04:28.39,0:04:29.93,Default,,0,0,0,,жағымсыз
Dialogue: 0,0:04:30.43,0:04:34.06,Default,,0,0,0,,Егер мөрімді бұзсаң, мен сені жеңемін, Мацури.
Dialogue: 0,0:04:34.14,0:04:36.40,Default,,0,0,0,,Қауіпті жігіт не деді?
Dialogue: 0,0:04:36.48,0:04:39.77,Default,,0,0,0,,Неліктен бұл миссияда маған еріп жүрсің, Широган?
Dialogue: 0,0:04:39.86,0:04:42.24,Default,,0,0,0,,Мен атаммен ойын ойнасам екен.
Dialogue: 0,0:04:42.32,0:04:45.11,Default,,0,0,0,,Мен сізге түсіндіруге міндетті емеспін.
Dialogue: 0,0:04:45.20,0:04:49.62,Default,,0,0,0,,Мен сізге айтамын, мен сізге шиыршықты ұрлауға мүмкіндік бермеймін.
Dialogue: 0,0:04:55.16,0:04:55.71,Default,,0,0,0,,Не!
Dialogue: 0,0:05:01.30,0:05:02.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:02.96,0:05:06.76,Default,,0,0,0,,-ге... Ол азғын ниндзя!
Dialogue: 0,0:05:07.47,0:05:10.56,Default,,0,0,0,,Шүкір, сен осылай киіндің бе?
Dialogue: 0,0:05:10.64,0:05:11.68,Default,,0,0,0,,Ооо!
Dialogue: 0,0:05:12.77,0:05:13.89,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:05:16.39,0:05:18.52,Default,,0,0,0,,Жабдық бұзылса ше?
Dialogue: 0,0:05:19.23,0:05:20.73,Default,,0,0,0,,Бұл бола ма?
Dialogue: 0,0:05:20.82,0:05:23.90,Default,,0,0,0,,Әй, абай бол, Сенпай да.
Dialogue: 0,0:05:23.99,0:05:26.07,Default,,0,0,0,,Жамбас толығымен ашық болады.
Dialogue: 0,0:05:26.15,0:05:29.91,Default,,0,0,0,,Түсінікті болу үшін мен боксшының шорттарының жанкүйерімін.
Dialogue: 0,0:05:30.41,0:05:34.58,Default,,0,0,0,,Әзірше мен оны мектептен кейін Курогиге жөндеймін.
Dialogue: 0,0:05:35.08,0:05:36.29,Default,,0,0,0,,Сенің ағаң да келе ме?
Dialogue: 0,0:05:36.37,0:05:39.38,Default,,0,0,0,,Жоқ, мен үйге барып жаттығу жасаймын.
Dialogue: 0,0:05:40.21,0:05:43.34,Default,,0,0,0,,Мені Утагава Гараку таң қалдырды.
Dialogue: 0,0:05:43.42,0:05:45.97,Default,,0,0,0,,Сузу Хананоны қорғау үшін біліктілік жоқ
Dialogue: 0,0:05:47.84,0:05:49.89,Default,,0,0,0,,Әлі жетілмеген!
Dialogue: 0,0:05:49.97,0:05:53.43,Default,,0,0,0,,Біраздан бері солай болды.
Dialogue: 0,0:05:53.51,0:05:56.31,Default,,0,0,0,,Мен де көңілсізмін, Нинокёку-сенпай.
Dialogue: 0,0:05:57.14,0:05:59.27,Default,,0,0,0,,Егер Гагаку бұл туралы шындап айтса ше?
Dialogue: 0,0:05:59.35,0:06:01.98,Default,,0,0,0,,Бірінші соққан мен болдым.
Dialogue: 0,0:06:04.11,0:06:06.69,Default,,0,0,0,,Бірге күшті болайық
Dialogue: 0,0:06:09.16,0:06:10.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:11.37,0:06:15.54,Default,,0,0,0,,Казамаки Егер сізде костюм болмаса да, шайқасқа дайын болыңыз.
Dialogue: 0,0:06:16.50,0:06:20.38,Default,,0,0,0,,Қазіргі уақытта Омико қаласы тұрақсыз жағдайда тұрған сияқты.
Dialogue: 0,0:06:21.08,0:06:23.34,Default,,0,0,0,,Бұл қару.
Dialogue: 0,0:06:29.38,0:06:30.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:38.31,0:06:39.27,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:40.06,0:06:41.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:41.52,0:06:45.65,Default,,0,0,0,,...
Dialogue: 0,0:06:45.73,0:06:47.90,Default,,0,0,0,,Қозғалыстары да шатастырылған.
Dialogue: 0,0:06:47.99,0:06:50.66,Default,,0,0,0,,Тырна сияқты қозғалып жатқанын елестетіп, оны бүктеңіз.
Dialogue: 0,0:06:50.74,0:06:52.07,Default,,0,0,0,,Сіз ұмыттыңыз.
Dialogue: 0,0:06:52.57,0:06:56.16,Default,,0,0,0,,Хмм, бұл қиынырақ.
Dialogue: 0,0:06:56.24,0:07:00.62,Default,,0,0,0,,Уайымдама, тек әтешіңді басқаруды үйрен.
Dialogue: 0,0:07:00.71,0:07:02.79,Default,,0,0,0,,Оригами ұсынылады
Dialogue: 0,0:07:02.88,0:07:05.38,Default,,0,0,0,,Оны бүктеу арқылы зейінді шоғырландыруға болады.
Dialogue: 0,0:07:05.46,0:07:08.88,Default,,0,0,0,,Дәл қазіргідей сәтсіздікке ұшырасаңыз, бір қарағанда біле аласыз
Dialogue: 0,0:07:08.97,0:07:09.84,Default,,0,0,0,,Иә
Dialogue: 0,0:07:10.84,0:07:14.51,Default,,0,0,0,,Қасиетті қыздың қуатын емін-еркін пайдалана алсаң
Dialogue: 0,0:07:14.60,0:07:17.43,Default,,0,0,0,,Широганэ-санның техникасын шешу тек арман емес.
Dialogue: 0,0:07:17.93,0:07:18.64,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:07:18.72,0:07:21.27,Default,,0,0,0,,Көркем музыка сізге! Сіз қай жақтасыз?
Dialogue: 0,0:07:21.35,0:07:22.81,Default,,0,0,0,,Бұл екеуі де емес.
Dialogue: 0,0:07:22.90,0:07:23.86,Default,,0,0,0,,Фуня~!
Dialogue: 0,0:07:24.56,0:07:27.02,Default,,0,0,0,,Мен жай ғана аяқталған ведьманы қалаймын
Dialogue: 0,0:07:27.11,0:07:28.78,Default,,0,0,0,,Мен оны тек суретке салғым келеді
Dialogue: 0,0:07:29.28,0:07:31.61,Default,,0,0,0,,Бұл щетканың сиқырлы табиғаты ма?
Dialogue: 0,0:07:31.70,0:07:34.87,Default,,0,0,0,,Қарғыс атқыр, мына жігіттің түрі осындай.
Dialogue: 0,0:07:34.95,0:07:36.20,Default,,0,0,0,,Сенімсіз
Dialogue: 0,0:07:36.28,0:07:37.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:38.04,0:07:39.29,Default,,0,0,0,,Сәлем Сузу
Dialogue: 0,0:07:39.87,0:07:41.29,Default,,0,0,0,,Ах, Мари
Dialogue: 0,0:07:41.96,0:07:43.29,Default,,0,0,0,,Мен үйге бара жатырмын~
Dialogue: 0,0:07:43.37,0:07:44.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:44.75,0:07:45.59,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:47.38,0:07:48.30,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:49.01,0:07:51.34,Default,,0,0,0,,Мен де тезірек баруым керек деп ойлаймын.
Dialogue: 0,0:07:51.42,0:07:54.51,Default,,0,0,0,,Олай болса, жіберіңіз.
Dialogue: 0,0:07:55.51,0:07:57.01,Default,,0,0,0,,Ах Сузу-кун
Dialogue: 0,0:07:57.10,0:07:58.06,Default,,0,0,0,,Иә
Dialogue: 0,0:07:58.56,0:08:02.19,Default,,0,0,0,,Оригамиді алдын ала бүктеген дұрыс.
Dialogue: 0,0:08:02.94,0:08:06.65,Default,,0,0,0,,Егер сіз оған жүрегіңізді салсаңыз, ол бір сәтте пайдалы болуы мүмкін.
Dialogue: 0,0:08:07.23,0:08:08.11,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:08.82,0:08:12.95,Default,,0,0,0,,Менсіз өнерге араласпа, ұят.
Dialogue: 0,0:08:13.45,0:08:15.03,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:18.24,0:08:19.83,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:08:20.50,0:08:21.54,Default,,0,0,0,,Аздап
Dialogue: 0,0:08:24.08,0:08:24.75,Default,,0,0,0,,О!
Dialogue: 0,0:08:25.88,0:08:28.42,Default,,0,0,0,,«Sui ON» жаңа нұсқасы шықты.
Dialogue: 0,0:08:28.50,0:08:31.88,Default,,0,0,0,,Қайда барасың деп қызық болдым. Бұл ойыншықтар дүкені болды ма?
Dialogue: 0,0:08:33.01,0:08:34.68,Default,,0,0,0,,Көре алмайтындар үшін
Dialogue: 0,0:08:35.34,0:08:36.76,Default,,0,0,0,,Ішіне қараңыз.
Dialogue: 0,0:08:36.84,0:08:37.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:41.85,0:08:43.64,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:08:44.56,0:08:45.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:47.19,0:08:48.61,Default,,0,0,0,,Ойыншық астында
Dialogue: 0,0:08:48.69,0:08:51.78,Default,,0,0,0,,Нағыз жын шығару құралдары тізіліп тұр.
Dialogue: 0,0:08:52.40,0:08:56.86,Default,,0,0,0,,Ол сиқырмен өңделгендіктен, қарапайым адамдар оны көзге тигізсе де көре алмайды.
Dialogue: 0,0:08:56.95,0:08:58.03,Default,,0,0,0,,Я~
Dialogue: 0,0:08:59.03,0:09:03.16,Default,,0,0,0,,Дүкеннің артында арнайы құралдар жасайтын шеберхана бар.
Dialogue: 0,0:09:03.70,0:09:06.67,Default,,0,0,0,,«Куроги» - ойыншықтар дүкені және тазарту жабдықтары дүкені.
Dialogue: 0,0:09:07.25,0:09:08.67,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:09:09.75,0:09:13.92,Default,,0,0,0,,Йоторимочи? Менің шашым түсіп кететін сияқты
Dialogue: 0,0:09:14.42,0:09:15.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:16.38,0:09:18.39,Default,,0,0,0,,(шу)
Dialogue: 0,0:09:19.47,0:09:19.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:20.05,0:09:21.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:22.01,0:09:24.23,Default,,0,0,0,,Бұл таза емес!
Dialogue: 0,0:09:24.31,0:09:25.39,Default,,0,0,0,,Широган?
Dialogue: 0,0:09:25.48,0:09:26.85,Default,,0,0,0,,Вауавуа…
Dialogue: 0,0:09:26.94,0:09:27.81,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:27.90,0:09:29.15,Default,,0,0,0,,Тағы бір жат жан?
Dialogue: 0,0:09:29.73,0:09:32.32,Default,,0,0,0,,Бұл бұрын Луға ие болған жігіт пе?
Dialogue: 0,0:09:32.40,0:09:35.03,Default,,0,0,0,,Тәтті, қатарынан тым көп.
Dialogue: 0,0:09:35.11,0:09:38.24,Default,,0,0,0,,Мен күтемін!
Dialogue: 0,0:09:40.53,0:09:44.37,Default,,0,0,0,,Тазарту ниндзя құралы Idatenrin!
Dialogue: 0,0:09:51.67,0:09:53.55,Default,,0,0,0,,Ооо~
Dialogue: 0,0:09:53.63,0:09:54.38,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:54.46,0:09:55.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:58.88,0:10:01.39,Default,,0,0,0,,бастап
Dialogue: 0,0:10:02.89,0:10:04.68,Default,,0,0,0,,Түтік тығыздағыш!
Dialogue: 0,0:10:04.77,0:10:08.06,Default,,0,0,0,,Уау! Бұл сұмдық!
Dialogue: 0,0:10:09.69,0:10:10.61,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,0:10:10.69,0:10:12.36,Default,,0,0,0,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,0:10:12.44,0:10:13.98,Default,,0,0,0,,Бұл өніммен не шегуге болады?
Dialogue: 0,0:10:14.07,0:10:16.86,Default,,0,0,0,,Бөтен рухтар сияқты аморфты құбыжықтар ғана бар.
Dialogue: 0,0:10:16.94,0:10:17.61,Default,,0,0,0,,Мияу
Dialogue: 0,0:10:18.53,0:10:22.78,Default,,0,0,0,,Ішінде сиқырлы заклинание бар, сондықтан қашып құтыла алмайсың.
Dialogue: 0,0:10:23.37,0:10:25.87,Default,,0,0,0,,Құны төмен болғандықтан, бағаны төмендетуге болады...
Dialogue: 0,0:10:26.79,0:10:27.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:28.12,0:10:29.62,Default,,0,0,0,,Дұрысы, шошқа жын ба?
Dialogue: 0,0:10:29.71,0:10:31.79,Default,,0,0,0,,Асыл ақ мысық!
Dialogue: 0,0:10:32.38,0:10:35.67,Default,,0,0,0,,Мацури: Бұл бала пурист пе?
Dialogue: 0,0:10:35.76,0:10:37.51,Default,,0,0,0,,О, жай...
Dialogue: 0,0:10:37.59,0:10:40.47,Default,,0,0,0,,Солардың ішінде заттар жасауға маманданған.
Dialogue: 0,0:10:40.97,0:10:45.51,Default,,0,0,0,,Осы қалада ұрпақтар бойына жын шығару құралдарын жасап келе жатқан хош иісті түтетушілер отбасының мұрагері.
Dialogue: 0,0:10:47.18,0:10:47.98,Default,,0,0,0,,Аа...
Dialogue: 0,0:10:48.06,0:10:49.64,Default,,0,0,0,,Бұл хош иісті зат Койо.
Dialogue: 0,0:10:49.73,0:10:51.81,Default,,0,0,0,,Ах, Мацури-кун
Dialogue: 0,0:10:52.31,0:10:55.07,Default,,0,0,0,,Йо Койо, бөтен жанға не болды?
Dialogue: 0,0:10:55.15,0:10:55.90,Default,,0,0,0,,О
Dialogue: 0,0:10:55.98,0:10:58.78,Default,,0,0,0,,Сауда ауданында басқа спирттерге арналған тұзақ
Dialogue: 0,0:10:58.86,0:11:00.70,Default,,0,0,0,,Жаңа алғаным алынды.
Dialogue: 0,0:11:00.78,0:11:04.66,Default,,0,0,0,,Деректер аз болғандықтан, мен оны болашақта зерттеуге тырыстым.
Dialogue: 0,0:11:04.74,0:11:06.62,Default,,0,0,0,,Мен қашып кеттім
Dialogue: 0,0:11:06.70,0:11:10.08,Default,,0,0,0,,Әй... Айтпақшы, ол бала сенің досың ба?
Dialogue: 0,0:11:10.71,0:11:13.42,Default,,0,0,0,,А, біз бұл туралы бұрын да айтқанбыз.
Dialogue: 0,0:11:13.50,0:11:15.54,Default,,0,0,0,,Бала күнгі досы Ханасу Сузу
Dialogue: 0,0:11:15.63,0:11:17.21,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:11:17.30,0:11:20.42,Default,,0,0,0,,О! Сонда сен бақсысың!
Dialogue: 0,0:11:20.51,0:11:23.64,Default,,0,0,0,,Ха... Демек, бұл жын патша!
Dialogue: 0,0:11:23.72,0:11:27.39,Default,,0,0,0,,Уау~ Екеуі де қызықты!
Dialogue: 0,0:11:27.47,0:11:29.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:29.93,0:11:30.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:30.81,0:11:34.06,Default,,0,0,0,,Бұл жігіт мен ойлағаннан да күшті.
Dialogue: 0,0:11:34.15,0:11:34.86,Default,,0,0,0,,Койо, төмен түс
Dialogue: 0,0:11:35.52,0:11:38.07,Default,,0,0,0,,Зерттеу жойылды. Мен оны шашыратып жіберемін.
Dialogue: 0,0:11:40.95,0:11:41.90,Default,,0,0,0,,(Басқа жанның айқайы)
Dialogue: 0,0:11:41.99,0:11:43.57,Default,,0,0,0,,Фума шурикен!
Dialogue: 0,0:11:47.08,0:11:47.66,Default,,0,0,0,,Аа...
Dialogue: 0,0:11:47.74,0:11:49.91,Default,,0,0,0,,Кя~! (Мари) Уау...
Dialogue: 0,0:11:50.00,0:11:52.29,Default,,0,0,0,,Өте қызықты! (Мари) Әй, эй...
Dialogue: 0,0:11:52.37,0:11:54.46,Default,,0,0,0,,Эй, Койо, сен тым жақынсың!
Dialogue: 0,0:11:54.54,0:11:55.84,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:55.92,0:11:58.96,Default,,0,0,0,,Фума Шурикенді тамаша пайдалану
Dialogue: 0,0:11:59.05,0:12:00.80,Default,,0,0,0,,Мацури-кун күткендей!
Dialogue: 0,0:12:02.30,0:12:05.97,Default,,0,0,0,,Сондықтан сен менің... бірінші адамсың.
Dialogue: 0,0:12:10.27,0:12:12.73,Default,,0,0,0,,бірінші рет...
Dialogue: 0,0:12:13.89,0:12:16.23,Default,,0,0,0,,Не?
Dialogue: 0,0:12:22.82,0:12:25.32,Default,,0,0,0,,Жын шығару сақинасының параметрлерін өзгерту
Dialogue: 0,0:12:25.41,0:12:28.41,Default,,0,0,0,,Менің құрылғыма физикалық деректеріңізді бөлісіңіз
Dialogue: 0,0:12:29.62,0:12:32.00,Default,,0,0,0,,Дайынсың ба? Мацури-кун
Dialogue: 0,0:12:32.08,0:12:34.25,Default,,0,0,0,,Бұл тамаша Коио
Dialogue: 0,0:12:34.83,0:12:37.21,Default,,0,0,0,,...
Dialogue: 0,0:12:39.50,0:12:40.50,Default,,0,0,0,,Іске қосу!
Dialogue: 0,0:12:42.76,0:12:45.63,Default,,0,0,0,,Менің дизайнымда сұралғандай
Dialogue: 0,0:12:45.72,0:12:48.89,Default,,0,0,0,,Біз ең жоғары жекпе-жек өнері бар баланы дайындадық.
Dialogue: 0,0:12:52.31,0:12:53.39,Default,,0,0,0,,(Сатсуки) Наги! (Кохару) Уау!
Dialogue: 0,0:12:53.48,0:12:56.77,Default,,0,0,0,,Жалған шайқасты бастайық!
Dialogue: 0,0:12:56.85,0:12:57.69,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:00.27,0:13:03.24,Default,,0,0,0,,Уау! Әйел болу арқылы
Dialogue: 0,0:13:03.32,0:13:06.20,Default,,0,0,0,,Сіз қозғалыстарыңызға икемділік қостыңыз.
Dialogue: 0,0:13:06.78,0:13:09.16,Default,,0,0,0,,Қолжетімділік пен күш аздап төмендеді, бірақ
Dialogue: 0,0:13:09.24,0:13:10.95,Default,,0,0,0,,Жақсы толықтырылған
Dialogue: 0,0:13:11.66,0:13:14.87,Default,,0,0,0,,Ойыншықтар дүкенінің жертөлесінде мұндай мекеме бар екеніне сене алар емеспін.
Dialogue: 0,0:13:15.46,0:13:17.42,Default,,0,0,0,,Сіз не істеп жатырсыз? қазір
Dialogue: 0,0:13:18.50,0:13:21.00,Default,,0,0,0,,Бұзылған жабдықты жөндеу кезінде
Dialogue: 0,0:13:21.09,0:13:24.30,Default,,0,0,0,,Біз Мацури-кунның соңғы физикалық деректерін жинаймыз.
Dialogue: 0,0:13:25.22,0:13:27.55,Default,,0,0,0,,Тазарту ниндзясының костюмдері иесіне бейімделген.
Dialogue: 0,0:13:27.64,0:13:31.97,Default,,0,0,0,,Әртүрлі қорғаныс әдістері мен жасырын әдістер қолданылады.
Dialogue: 0,0:13:32.06,0:13:34.98,Default,,0,0,0,,Кондиционер функциясы бар жоғары технологиялық жабдық
Dialogue: 0,0:13:35.06,0:13:39.44,Default,,0,0,0,,Деректерді мерзімді түрде жинау және жүргізу қажет.
Dialogue: 0,0:13:39.52,0:13:43.82,Default,,0,0,0,,Мацури мырзаға жауапты шебер ретінде мен әрқашан басқалардан көбірек жұмыс істеймін.
Dialogue: 0,0:13:43.90,0:13:46.86,Default,,0,0,0,,Мацури-кунның денесі туралы білуіміз керек!
Dialogue: 0,0:13:46.95,0:13:47.78,Default,,0,0,0,,Дене?
Dialogue: 0,0:13:48.41,0:13:49.66,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:13:49.74,0:13:54.83,Default,,0,0,0,,Мен қыз болғаннан бері бірінші рет өлшеу жүргізіп жатырмын, сондықтан мен қатты толқып отырмын!
Dialogue: 0,0:13:55.33,0:13:59.54,Default,,0,0,0,,Әй, мұнда да сандар өзгерді.
Dialogue: 0,0:14:00.75,0:14:05.34,Default,,0,0,0,,Сондықтан сен менің... бірінші адамымсың.
Dialogue: 0,0:14:05.42,0:14:07.68,Default,,0,0,0,,Әй... Осыны меңзеп тұрсың ба?
Dialogue: 0,0:14:07.76,0:14:10.47,Default,,0,0,0,,Мари екеуміз жақындай бергенде...
Dialogue: 0,0:14:11.43,0:14:14.68,Default,,0,0,0,,Біз мұнда да өлшейміз.
Dialogue: 0,0:14:14.77,0:14:16.27,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:14:16.77,0:14:18.48,Default,,0,0,0,,Ахх!
Dialogue: 0,0:14:18.56,0:14:20.56,Default,,0,0,0,,Бұл... Короки мырза
Dialogue: 0,0:14:20.65,0:14:21.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:22.02,0:14:26.03,Default,,0,0,0,,Жарайды... Мацуриді қашаннан бері білемін деп ойлаймын.
Dialogue: 0,0:14:27.57,0:14:28.90,Default,,0,0,0,,Біз кездескеннен кейін
Dialogue: 0,0:14:28.99,0:14:32.62,Default,,0,0,0,,312 күн, 2 сағат, 10 минут, 3 секунд
Dialogue: 0,0:14:32.70,0:14:33.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:34.49,0:14:38.25,Default,,0,0,0,,Бұл мен үшін ұмытылмас күн.
Dialogue: 0,0:14:42.04,0:14:46.59,Default,,0,0,0,,Хохо~ Жел басқаратын шурикен?
Dialogue: 0,0:14:47.17,0:14:48.88,Default,,0,0,0,,Жел техникасымен танысу
Dialogue: 0,0:14:48.97,0:14:52.47,Default,,0,0,0,,Мен пішінді және жабу техникасын реттеуге тырыстым.
Dialogue: 0,0:14:52.55,0:14:53.55,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:54.18,0:14:59.02,Default,,0,0,0,,Шишимару мырзаның қызы қолөнерші болуды мақсат еткен жоқ деп ойлаймын.
Dialogue: 0,0:14:59.60,0:15:01.81,Default,,0,0,0,,Кешіріңіз, Казамаки-сан.
Dialogue: 0,0:15:01.90,0:15:03.90,Default,,0,0,0,,Өйткені оны жаңадан туған немересі пайдаланады.
Dialogue: 0,0:15:03.98,0:15:07.07,Default,,0,0,0,,Бұйрық маған дәмі жоқ бірдеңені қалайтын болдым.
Dialogue: 0,0:15:07.15,0:15:10.15,Default,,0,0,0,,Мен бұл жігітке соңғы нүктені қалдыруда аңғал болдым.
Dialogue: 0,0:15:11.07,0:15:14.49,Default,,0,0,0,,Оның таланты отбасындағы ең жақсылардың бірі.
Dialogue: 0,0:15:14.58,0:15:16.95,Default,,0,0,0,,Бірдеңені еріксіз істеп жүрген сияқтысың.
Dialogue: 0,0:15:17.04,0:15:20.04,Default,,0,0,0,,Койо әзірге шәкірт.
Dialogue: 0,0:15:21.00,0:15:23.00,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,0:15:23.08,0:15:26.42,Default,,0,0,0,,Сіз мені танымайсыз.
Dialogue: 0,0:15:26.92,0:15:28.84,Default,,0,0,0,,Жақсы емес пе, ата (3 адам)?
Dialogue: 0,0:15:32.76,0:15:33.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:36.56,0:15:38.02,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:15:38.52,0:15:40.27,Default,,0,0,0,,Оны Фума Шурикен деп атаңыз
Dialogue: 0,0:15:40.85,0:15:42.06,Default,,0,0,0,,Хохо
Dialogue: 0,0:15:42.56,0:15:44.44,Default,,0,0,0,,О, менде мынау болды!
Dialogue: 0,0:15:44.52,0:15:46.94,Default,,0,0,0,,Сіз оны кенеттен меңгересіз, солай емес пе?
Dialogue: 0,0:15:49.36,0:15:51.03,Default,,0,0,0,,Жарайды, мен шештім (Кио) Ах...
Dialogue: 0,0:15:51.11,0:15:53.49,Default,,0,0,0,,Хош иісті зат түтеткіш Renio... Солай ма?
Dialogue: 0,0:15:54.24,0:15:57.87,Default,,0,0,0,,Толық лицензия алып, ресми Пуранин болсам ше?
Dialogue: 0,0:15:58.66,0:16:00.87,Default,,0,0,0,,Сіз менің костюмімді жасайсыз.
Dialogue: 0,0:16:03.75,0:16:04.67,Default,,0,0,0,,Мацури-кун
Dialogue: 0,0:16:05.25,0:16:09.00,Default,,0,0,0,,Ол эксорцизм ниндзя құралының шебері Короги Ренионы таныды.
Dialogue: 0,0:16:09.09,0:16:11.47,Default,,0,0,0,,Ол менің «бірінші адамым»
Dialogue: 0,0:16:14.59,0:16:16.64,Default,,0,0,0,,Тазарту ниндзя костюмдерін жасау
Dialogue: 0,0:16:16.72,0:16:20.60,Default,,0,0,0,,Бастапқыда қожайыным әкемнің ардагер жұмысы болатын.
Dialogue: 0,0:16:22.27,0:16:26.11,Default,,0,0,0,,Жындармен күресу үшін өз өміріңізді қатерге тігіңіз, өйткені бұл маңызды.
Dialogue: 0,0:16:27.65,0:16:31.74,Default,,0,0,0,,Бірақ Мацури-кун мұны маған сеніп тапсырды.
Dialogue: 0,0:16:32.78,0:16:34.49,Default,,0,0,0,,Мен үшін де солай
Dialogue: 0,0:16:34.57,0:16:38.16,Default,,0,0,0,,Мен оны өміріммен қолдауға міндеттімін!
Dialogue: 0,0:16:39.91,0:16:41.20,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:16:41.87,0:16:43.33,Default,,0,0,0,,Жақсы! сурет?
Dialogue: 0,0:16:43.41,0:16:46.04,Default,,0,0,0,,Сіз осындай қозғалыстарды жасай аласыз!
Dialogue: 0,0:16:46.13,0:16:47.46,Default,,0,0,0,,Тізе буынының матасы
Dialogue: 0,0:16:47.54,0:16:50.88,Default,,0,0,0,,Оны шамамен 0,5%-ға жұқа ету керек пе?
Dialogue: 0,0:16:50.96,0:16:54.47,Default,,0,0,0,,Күрсіну~ Мацури-кун шынымен де қызықты!
Dialogue: 0,0:16:54.97,0:16:56.39,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:16:58.85,0:17:00.35,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:17:01.64,0:17:02.81,Default,,0,0,0,,Жарайды, Мацури-кун.
Dialogue: 0,0:17:03.77,0:17:07.40,Default,,0,0,0,,Деректерді тексергенше үзіліс жасаңыз.
Dialogue: 0,0:17:07.48,0:17:08.02,Default,,0,0,0,,О
Dialogue: 0,0:17:11.61,0:17:13.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:13.40,0:17:14.32,Default,,0,0,0,,Не!
Dialogue: 0,0:17:15.61,0:17:18.57,Default,,0,0,0,,Сәлем Койо! Мокуджин әлі қозғалуда!
Dialogue: 0,0:17:18.66,0:17:23.37,Default,,0,0,0,,Иә? Бұл біртүрлі. Көлік жүргізу техникасын тоқтату керек еді.
Dialogue: 0,0:17:23.91,0:17:25.96,Default,,0,0,0,,Жоқ... о... эй
Dialogue: 0,0:17:26.04,0:17:26.71,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:26.79,0:17:27.46,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:17:27.54,0:17:28.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:28.92,0:17:32.21,Default,,0,0,0,,Ахахаха хахаха...
Dialogue: 0,0:17:33.30,0:17:36.43,Default,,0,0,0,,Климакс қытықтау азаптау құрылғысы неге рұқсатсыз жасайды?
Dialogue: 0,0:17:36.51,0:17:38.01,Default,,0,0,0,,Оның қызметі қандай
Dialogue: 0,0:17:38.09,0:17:39.72,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:17:39.80,0:17:43.43,Default,,0,0,0,,Мокуджиннің ішіндегі техникалық қызмет көрсету кабинасында елес реакция бар ма?
Dialogue: 0,0:17:43.52,0:17:45.52,Default,,0,0,0,,(Джозефтің ауыр демі)
Dialogue: 0,0:17:45.60,0:17:48.94,Default,,0,0,0,,Біраз ойланып, әйтеуір жұмыс істеді.
Dialogue: 0,0:17:49.02,0:17:49.90,Default,,0,0,0,,Сен бе!
Dialogue: 0,0:17:49.98,0:17:52.86,Default,,0,0,0,,Мен шиыршықты аламын, Мацури.
Dialogue: 0,0:17:55.69,0:17:58.57,Default,,0,0,0,,Жоқ... Сора!
Dialogue: 0,0:17:58.66,0:18:00.49,Default,,0,0,0,,(Маризатоның күлкісі)
Dialogue: 0,0:18:00.57,0:18:03.70,Default,,0,0,0,,Climax қытықтайтын азаптау құрылғысы 2 нұсқасына дейін!
Dialogue: 0,0:18:03.79,0:18:05.29,Default,,0,0,0,,Сонымен қандай функция бар?
Dialogue: 0,0:18:05.95,0:18:07.71,Default,,0,0,0,,Мен уайымдаймын
Dialogue: 0,0:18:07.79,0:18:09.75,Default,,0,0,0,,Мен оны оңай көтере алмаймын.
Dialogue: 0,0:18:09.83,0:18:11.96,Default,,0,0,0,,Бастапқы түріне тез оралыңыз...
Dialogue: 0,0:18:12.04,0:18:16.09,Default,,0,0,0,,Scroll Scroll - бұл сізді үйрене алатын нәрсе.
Dialogue: 0,0:18:16.67,0:18:19.34,Default,,0,0,0,,Сіз қытықтайсыз ба, тіпті сиқырларды да қолдана алмайсыз ба?
Dialogue: 0,0:18:19.43,0:18:21.35,Default,,0,0,0,,Бұл қазірдің өзінде Широган!
Dialogue: 0,0:18:21.43,0:18:22.47,Default,,0,0,0,,Мен оны тоқтатамын.
Dialogue: 0,0:18:22.55,0:18:24.64,Default,,0,0,0,,Сузу Ханасаде қажет емес
Dialogue: 0,0:18:25.97,0:18:29.10,Default,,0,0,0,,Мацури-кун, оны қиратыңыз.
Dialogue: 0,0:18:29.19,0:18:32.65,Default,,0,0,0,,Не? Бірақ Койо оны жасау үшін көп еңбек етті.
Dialogue: 0,0:18:32.73,0:18:34.57,Default,,0,0,0,,Сондықтан... Мен мұны істей алмаймын.
Dialogue: 0,0:18:35.36,0:18:38.65,Default,,0,0,0,,О? Сіз бұрыннан білмейсіз бе?
Dialogue: 0,0:18:38.74,0:18:41.45,Default,,0,0,0,,Құрал сынғаннан басқа ештеңе емес.
Dialogue: 0,0:18:41.53,0:18:45.91,Default,,0,0,0,,Бұл маған ұнайтын нәрсе: жақсартуға арналған бөлме.
Dialogue: 0,0:18:48.54,0:18:53.00,Default,,0,0,0,,Әдеттегідей мен бұл шеберлікті құрметтеймін!
Dialogue: 0,0:18:57.59,0:18:58.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:59.30,0:19:01.18,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:19:01.26,0:19:02.30,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:03.05,0:19:04.01,Default,,0,0,0,,Мияу
Dialogue: 0,0:19:04.10,0:19:07.47,Default,,0,0,0,,Ня ня... Няаааа~!
Dialogue: 0,0:19:08.18,0:19:11.44,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:13.61,0:19:16.53,Default,,0,0,0,,Өте өкінішті, қажетсіз жұмыстың көлемін арттырдым.
Dialogue: 0,0:19:16.61,0:19:17.53,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:17.61,0:19:20.90,Default,,0,0,0,,Мен оны қалай түзетуге болатынын ойлап тұрмын.
Dialogue: 0,0:19:21.61,0:19:23.82,Default,,0,0,0,,Брекетті түнде қалдырыңыз.
Dialogue: 0,0:19:24.32,0:19:26.41,Default,,0,0,0,,Мен оны керемет түрде түзетемін.
Dialogue: 0,0:19:26.49,0:19:27.45,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:19:28.45,0:19:32.92,Default,,0,0,0,,Жын шығарушы және қолөнерші Мен білмеген дүние
Dialogue: 0,0:19:33.54,0:19:38.51,Default,,0,0,0,,Широгане пайда болмағанда, мен одан мәңгі бейхабар болар ма едім деп ойлаймын.
Dialogue: 0,0:19:40.47,0:19:44.43,Default,,0,0,0,,Короги-сан әрқашан Мацуриді сахна артындағы адам ретінде қолдады.
Dialogue: 0,0:19:45.72,0:19:47.64,Default,,0,0,0,,Мен де бар күшімді салуым керек
Dialogue: 0,0:19:48.39,0:19:50.14,Default,,0,0,0,,Аа, солай, Сузу-сан.
Dialogue: 0,0:19:50.23,0:19:50.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:51.39,0:19:54.90,Default,,0,0,0,,Неге байқап көрмеске? Тазарту ниндзя костюмі
Dialogue: 0,0:19:54.98,0:19:56.36,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:57.11,0:20:00.86,Default,,0,0,0,,Ал, мен не істеуім керек? Егер сүйкімді нәрсе болса ...
Dialogue: 0,0:20:00.94,0:20:02.91,Default,,0,0,0,,Иә Иә!
Dialogue: 0,0:20:02.99,0:20:07.41,Default,,0,0,0,,Осы жерді түртіп, қатты ойлаған кезде «кию» деңіз.
Dialogue: 0,0:20:07.49,0:20:08.54,Default,,0,0,0,,(Сузуно Секибараи)
Dialogue: 0,0:20:09.04,0:20:10.87,Default,,0,0,0,,Ал... киіңіз!
Dialogue: 0,0:20:14.33,0:20:16.46,Default,,0,0,0,,О... О!
Dialogue: 0,0:20:18.59,0:20:19.42,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:20:22.72,0:20:24.05,Default,,0,0,0,,Уау
Dialogue: 0,0:20:25.51,0:20:26.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:26.76,0:20:29.56,Default,,0,0,0,,Өте сүйкімді! Сексуалды киім!
Dialogue: 0,0:20:29.64,0:20:30.93,Default,,0,0,0,,Ұятсыз!
Dialogue: 0,0:20:31.02,0:20:35.23,Default,,0,0,0,,Сізге қалай ұнайды? Мацури-кун, жындар да түс схемасымен ең жақсы.
Dialogue: 0,0:20:35.31,0:20:37.65,Default,,0,0,0,,Құбыжықтармен не істейсің?
Dialogue: 0,0:20:37.73,0:20:38.65,Default,,0,0,0,,Дәлірек айтқанда...
Dialogue: 0,0:20:38.73,0:20:43.03,Default,,0,0,0,,Оны тез қалпына келтіріңіз!
Dialogue: 0,0:20:50.08,0:20:52.70,Default,,0,0,0,,Таку Койо жігіті
Dialogue: 0,0:20:52.79,0:20:56.00,Default,,0,0,0,,Мен бір қызық нәрсе жасаймын.
Dialogue: 0,0:20:58.50,0:21:00.05,Default,,0,0,0,,Айтпақшы, Мацури мырза
Dialogue: 0,0:21:00.13,0:21:01.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.42,0:21:04.01,Default,,0,0,0,,Сізге қандай жын шабуыл жасады?
Dialogue: 0,0:21:04.72,0:21:08.72,Default,,0,0,0,,Ортез қалай сынды Мен бұл ерекше болды деп алаңдадым.
Dialogue: 0,0:21:09.64,0:21:14.18,Default,,0,0,0,,Бөлшектенген киімді киімге айналдыру үшін қолданған техникам...
Dialogue: 0,0:21:14.27,0:21:16.31,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:21:16.90,0:21:20.02,Default,,0,0,0,,Оған қандай да бір сиқырлы күш түскен сияқты...
Dialogue: 0,0:21:26.45,0:21:30.45,Default,,0,0,0,,Өйткені, Сузудың күші жын-шайтандарды жақтайтын күш...
Dialogue: 0,0:21:33.83,0:21:36.50,Default,,0,0,0,,Сузу - жындардың патшасы, тіпті Широганенің техникасы
Dialogue: 0,0:21:36.58,0:21:40.42,Default,,0,0,0,,Шынымды айтсам, мәселені шеше алмаймын.
Dialogue: 0,0:21:41.67,0:21:45.01,Default,,0,0,0,,Бірақ егер бұл орын алса
Dialogue: 0,0:21:46.17,0:21:49.72,Default,,0,0,0,,Бұл, әрине, жын құдайы.
Dialogue: 0,0:21:52.97,0:21:54.64,Default,,0,0,0,,Басқа жандардың көбеюі
Dialogue: 0,0:21:55.43,0:21:58.31,Default,,0,0,0,,Өйткені, оның оған қатысы жоқ деп ойлаймын.
Dialogue: 0,0:21:59.23,0:22:04.07,Default,,0,0,0,,Кез келген жағдайда... келесің бе? осы қалада
Dialogue: 0,0:22:06.07,0:22:08.07,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.45,0:23:35.45,Default,,0,0,0,,～♪
