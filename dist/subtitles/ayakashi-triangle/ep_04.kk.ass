Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:04.42,Default,,0,0,0,,Хмм.
Dialogue: 0,0:00:05.83,0:00:08.59,Default,,0,0,0,,Сонда бұл Ни но Киоку Сенпай кім?
Dialogue: 0,0:00:08.67,0:00:11.38,Default,,0,0,0,,Сонда сіз Широганға сенімді болдыңыз ба?
Dialogue: 0,0:00:11.46,0:00:13.22,Default,,0,0,0,,Бұл күтуде.
Dialogue: 0,0:00:13.30,0:00:17.10,Default,,0,0,0,,Егер ол бірдеңе жамандық жасаса, оны бірден қуып жібереді деп ойлаймын.
Dialogue: 0,0:00:17.18,0:00:18.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:19.18,0:00:21.93,Default,,0,0,0,,Широганға жақсы қыз болсын деп айтуым керек.
Dialogue: 0,0:00:22.02,0:00:24.81,Default,,0,0,0,,Жақсы қыз... құбыжық.
Dialogue: 0,0:00:25.48,0:00:27.11,Default,,0,0,0,,Дәлірек айтқанда, жын шығару
Dialogue: 0,0:00:27.19,0:00:30.69,Default,,0,0,0,,Менің ойымша, Мацури мен Мацуридің атасы ғана емес.
Dialogue: 0,0:00:31.28,0:00:33.49,Default,,0,0,0,,Мен жалғыз бола алмаймын
Dialogue: 0,0:00:33.57,0:00:37.03,Default,,0,0,0,,Бұл жерде мен және менің ағаларым ғана.
Dialogue: 0,0:00:37.12,0:00:38.03,Default,,0,0,0,,Хмм.
Dialogue: 0,0:00:38.74,0:00:44.12,Default,,0,0,0,,Қазір ойлап қарасам, мен жын шығару туралы ештеңе білмеймін.
Dialogue: 0,0:00:44.21,0:00:47.83,Default,,0,0,0,,Бұл туралы Сузуға білудің қажеті жоқ.
Dialogue: 0,0:00:47.92,0:00:49.84,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:00:49.92,0:00:51.42,Default,,0,0,0,,Автобус келді.
Dialogue: 0,0:00:52.84,0:00:55.63,Default,,0,0,0,,Жындар мен жын-шайтан шығару туралы
Dialogue: 0,0:00:55.72,0:00:57.34,Default,,0,0,0,,Маған дұрыстап айтсаңыз
Dialogue: 0,0:00:57.43,0:01:00.85,Default,,0,0,0,,Мен көбірек көмектесер едім.
Dialogue: 0,0:01:06.98,0:01:10.48,Default,,0,0,0,,Мынау Сузу Ханасадэ... бақсы ма?
Dialogue: 0,0:01:13.82,0:01:15.57,Default,,0,0,0,,«Юкай»
Dialogue: 0,0:01:15.65,0:01:20.24,Default,,0,0,0,,Ол жұмбақ, адам көзіне көрінбейді.
Dialogue: 0,0:01:20.33,0:01:23.45,Default,,0,0,0,,Адамдардан кек алатын зұлым жындарды жою үшін
Dialogue: 0,0:01:23.95,0:01:27.67,Default,,0,0,0,,Ежелден соғысып келе жатқан ниндзялар бар.
Dialogue: 0,0:01:28.96,0:01:30.04,Default,,0,0,0,,Оның аты
Dialogue: 0,0:01:35.80,0:01:37.51,Default,,0,0,0,,Жын шығару
Dialogue: 0,0:01:38.01,0:01:40.01,Default,,0,0,0,,♪～
Dialogue: 0,0:03:05.89,0:03:07.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:08.64,0:03:11.35,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:03:11.44,0:03:12.85,Default,,0,0,0,,Шизуо-сан!
Dialogue: 0,0:03:14.44,0:03:15.65,Default,,0,0,0,,Кун
Dialogue: 0,0:03:17.61,0:03:18.61,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:18.69,0:03:20.95,Default,,0,0,0,,Мен соңғы кездері осы драмаға байланып қалдым.
Dialogue: 0,0:03:21.03,0:03:21.91,Default,,0,0,0,,Менің әдемі жігітім
Dialogue: 0,0:03:21.99,0:03:24.07,Default,,0,0,0,,Қарғыс мені Ши-цзы итіне айналдырады.
Dialogue: 0,0:03:24.16,0:03:27.49,Default,,0,0,0,,Бар... Ой, бұл біртүрлі драма.
Dialogue: 0,0:03:27.58,0:03:28.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:28.66,0:03:32.58,Default,,0,0,0,,Егер бәрі жақсы болса, сіз түкті құбыжықтарды да қабылдауға амбиция орнаттыңыз.
Dialogue: 0,0:03:32.67,0:03:34.75,Default,,0,0,0,,Ол сценарийге байланысты жұмыс істеуі мүмкін.
Dialogue: 0,0:03:35.34,0:03:37.88,Default,,0,0,0,,Бұл жай ғана қызықты.
Dialogue: 0,0:03:37.96,0:03:40.30,Default,,0,0,0,,Эй, Мацуриді де тексеріңіз.
Dialogue: 0,0:03:40.38,0:03:41.34,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:03:41.42,0:03:42.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:42.13,0:03:43.13,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:43.22,0:03:44.55,Default,,0,0,0,,♬~
Dialogue: 0,0:03:48.18,0:03:49.85,Default,,0,0,0,,Yayo!
Dialogue: 0,0:03:49.93,0:03:51.60,Default,,0,0,0,,(Үздіксіз ату дыбысы)
Dialogue: 0,0:03:51.68,0:03:53.35,Default,,0,0,0,,Нашар Матсури
Dialogue: 0,0:03:53.44,0:03:56.48,Default,,0,0,0,,Ка... Керемет. Белдік желдеткіш дегеніміз не?
Dialogue: 0,0:03:58.90,0:04:01.90,Default,,0,0,0,,Мен жабысқақ болғанды ​​ұнатпаймын.
Dialogue: 0,0:04:01.99,0:04:05.37,Default,,0,0,0,,А... А, жоқ, бұл әдейі болған жоқ.
Dialogue: 0,0:04:08.95,0:04:12.33,Default,,0,0,0,,Жоқ! Мацури мені жек көреді! Мен не істеуім керек Suzu?
Dialogue: 0,0:04:12.41,0:04:14.17,Default,,0,0,0,,Мүмкін мен таң қалдым.
Dialogue: 0,0:04:14.25,0:04:15.67,Default,,0,0,0,,(Яйойдың жылағаны)
Dialogue: 0,0:04:15.75,0:04:19.13,Default,,0,0,0,,Мен Яёны ұнатпаймын дедім.
Dialogue: 0,0:04:19.63,0:04:22.01,Default,,0,0,0,,(Ойын аудиосы)
Dialogue: 0,0:04:27.30,0:04:31.10,Default,,0,0,0,,Эй Мацури, сен Яйомен жақсы араласа аласың ба?
Dialogue: 0,0:04:31.77,0:04:34.85,Default,,0,0,0,,Неліктен? Сіз жақсы араласасыз, солай ма?
Dialogue: 0,0:04:34.94,0:04:36.77,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:04:36.85,0:04:39.36,Default,,0,0,0,,Мацури: Мен Яйо мен Лумен бірге болсам да.
Dialogue: 0,0:04:39.44,0:04:41.65,Default,,0,0,0,,Ешқандай әңгіме жоқ.
Dialogue: 0,0:04:41.73,0:04:43.49,Default,,0,0,0,,Тек ойын ойнаңыз
Dialogue: 0,0:04:43.57,0:04:44.90,Default,,0,0,0,,Ммм
Dialogue: 0,0:04:44.99,0:04:47.45,Default,,0,0,0,,Қыздармен не сөйлесерімді білмеймін.
Dialogue: 0,0:04:48.03,0:04:51.41,Default,,0,0,0,,Ендеше, ер достарыңызбен қандай әңгімелер болды?
Dialogue: 0,0:04:52.66,0:04:54.91,Default,,0,0,0,,Менің де ер достарым жоқ.
Dialogue: 0,0:04:55.00,0:04:57.04,Default,,0,0,0,,Уф... Шынайы ма?
Dialogue: 0,0:04:57.96,0:05:01.30,Default,,0,0,0,,Себебі мен бастауыш сыныпта оқып жүргенімде Сузуя және Сенімен ойнайтынмын.
Dialogue: 0,0:05:01.80,0:05:04.26,Default,,0,0,0,,Сіз орта мектептен бастап тазарту ниндзясы ретінде жаттығасыз, солай ма?
Dialogue: 0,0:05:04.34,0:05:06.76,Default,,0,0,0,,Менің достасуға уақытым жоқ
Dialogue: 0,0:05:09.18,0:05:09.89,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:10.81,0:05:11.89,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:11.97,0:05:15.94,Default,,0,0,0,,Менің Сузудың әйел досы болған себебім жындардан сақ болу еді.
Dialogue: 0,0:05:16.44,0:05:19.02,Default,,0,0,0,,Өзіңізді басқа адамдармен тіл табысуға мәжбүрлеудің қажеті жоқ...
Dialogue: 0,0:05:19.11,0:05:20.15,Default,,0,0,0,,Ах
Dialogue: 0,0:05:25.40,0:05:26.95,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:05:27.45,0:05:29.82,Default,,0,0,0,,Ей, эй, ынта-жігеріңді арттыр.
Dialogue: 0,0:05:29.91,0:05:32.33,Default,,0,0,0,,Яйо да, Ру да Маримен дос болғысы келеді
Dialogue: 0,0:05:32.41,0:05:36.29,Default,,0,0,0,,Мен сияқты адаммен дос болған жақсы емес деп ойлаймын.
Dialogue: 0,0:05:36.37,0:05:40.25,Default,,0,0,0,,Ах, Сузу Мацури, қараңызшы!
Dialogue: 0,0:05:40.92,0:05:44.17,Default,,0,0,0,,Бұл жігіт мектеп аумағына қоныстанған қаңғыбас мысыққа ұқсайды.
Dialogue: 0,0:05:44.26,0:05:45.47,Default,,0,0,0,,Өте сүйкімді емес пе?
Dialogue: 0,0:05:45.55,0:05:50.72,Default,,0,0,0,,Бұл ет сезімі мысықтан гөрі ҰМА-ның жаңа түріне көбірек ұқсайды.
Dialogue: 0,0:05:50.80,0:05:54.18,Default,,0,0,0,,Мияу мырр пыр
Dialogue: 0,0:05:54.27,0:05:58.14,Default,,0,0,0,,Иә? Бұл бет бір жерде...
Dialogue: 0,0:05:58.23,0:06:00.36,Default,,0,0,0,,Қарашы, қарашы, сүйкімді, солай емес пе?
Dialogue: 0,0:06:00.44,0:06:02.15,Default,,0,0,0,,Мацуриге де соққы.
Dialogue: 0,0:06:02.23,0:06:03.82,Default,,0,0,0,,Горонян
Dialogue: 0,0:06:03.90,0:06:04.53,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:04.61,0:06:06.15,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:06:06.24,0:06:07.65,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,0:06:10.03,0:06:12.87,Default,,0,0,0,,Мен күткендей, мені қатты жек көреді!
Dialogue: 0,0:06:12.95,0:06:15.24,Default,,0,0,0,,А... ол ит адам ғой.
Dialogue: 0,0:06:15.33,0:06:16.66,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:06:17.75,0:06:20.04,Default,,0,0,0,,Сіз мені жақсы таныдыңыз.
Dialogue: 0,0:06:20.63,0:06:23.67,Default,,0,0,0,,Ол барлық жерде жай ғана мысыққа айналып жатса да.
Dialogue: 0,0:06:23.75,0:06:26.34,Default,,0,0,0,,Сіз барлық жердесіз бе! Бұл мысық дарума
Dialogue: 0,0:06:26.42,0:06:30.22,Default,,0,0,0,,Бірақ жын-шайтандық қасиеттер жойылғаны рас.
Dialogue: 0,0:06:30.30,0:06:32.76,Default,,0,0,0,,Құлақ, құйрық, т.б.
Dialogue: 0,0:06:32.85,0:06:37.35,Default,,0,0,0,,Широган өзгерген кезде қарапайым адамдар оны көре ала ма?
Dialogue: 0,0:06:37.43,0:06:40.77,Default,,0,0,0,,Адамның солғын танымдық қабілетіне сай.
Dialogue: 0,0:06:41.35,0:06:45.36,Default,,0,0,0,,Трансформация өнері – бұл дүниеде бір нәрсеге айналу.
Dialogue: 0,0:06:45.86,0:06:48.65,Default,,0,0,0,,Адамдармен танысу менің ұстанымдарыма қайшы.
Dialogue: 0,0:06:48.74,0:06:52.53,Default,,0,0,0,,Мен мектепте тағы бір жын шығарушы бар екенін білдім.
Dialogue: 0,0:06:53.62,0:06:55.74,Default,,0,0,0,,үшін көре алатын сүйкімді мысық ретінде
Dialogue: 0,0:06:55.83,0:06:58.91,Default,,0,0,0,,Мектеп ішінде танылу қауіпсіз
Dialogue: 0,0:06:59.87,0:07:02.50,Default,,0,0,0,,Бұл өте күшті қорғаныс техникасы
Dialogue: 0,0:07:02.58,0:07:04.54,Default,,0,0,0,,О~
Dialogue: 0,0:07:04.63,0:07:09.26,Default,,0,0,0,,Тірі қалу үшін мақтаныш жоқ, Жын патшасы.
Dialogue: 0,0:07:10.51,0:07:11.68,Default,,0,0,0,,Сонымен
Dialogue: 0,0:07:11.76,0:07:15.43,Default,,0,0,0,,Ол өзінің сүйкімділігін мектептегі басқа оқушыларға да көрсетеді.
Dialogue: 0,0:07:15.51,0:07:17.77,Default,,0,0,0,,Эй, күте тұр! Кездейсоқ әрекеттер...
Dialogue: 0,0:07:17.85,0:07:18.85,Default,,0,0,0,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,0:07:18.93,0:07:22.77,Default,,0,0,0,,Қандай себеп болмасын, адамдармен араласқан жақсы.
Dialogue: 0,0:07:22.85,0:07:24.36,Default,,0,0,0,,Сәттілік Широган
Dialogue: 0,0:07:24.94,0:07:25.77,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:26.27,0:07:30.70,Default,,0,0,0,,Айтпақшы, сен шынымен де тончинкансың, Казамаки Мацури екенсің.
Dialogue: 0,0:07:30.78,0:07:33.45,Default,,0,0,0,,Иә? Бұл кенеттен.
Dialogue: 0,0:07:33.53,0:07:35.70,Default,,0,0,0,,Сіз мені құтқардыңыз, сондықтан мен сіздің қарызыңызды өтегім келеді.
Dialogue: 0,0:07:35.78,0:07:37.91,Default,,0,0,0,,Мен сергек емеспін, сондықтан айтайын.
Dialogue: 0,0:07:38.54,0:07:41.75,Default,,0,0,0,,Ертеректе мені сипап тұрған қиғаш көзді әйел
Dialogue: 0,0:07:42.29,0:07:44.63,Default,,0,0,0,,Саған жын кіріп кеткен.
Dialogue: 0,0:07:44.71,0:07:45.92,Default,,0,0,0,,Ha
Dialogue: 0,0:07:46.42,0:07:47.80,Default,,0,0,0,,Itte~
Dialogue: 0,0:07:47.88,0:07:49.38,Default,,0,0,0,,Гепард
Dialogue: 0,0:07:49.46,0:07:53.05,Default,,0,0,0,,Жиі құлап қалмаңыз. Бұл тамаша емес.
Dialogue: 0,0:07:53.13,0:07:54.80,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:54.89,0:07:57.01,Default,,0,0,0,,Бұл тек түстен кейін төртінші рет.
Dialogue: 0,0:07:57.10,0:08:00.52,Default,,0,0,0,,Эхехехе менің көңілім ауып кетті ғой.
Dialogue: 0,0:08:02.10,0:08:03.23,Default,,0,0,0,,Сәлем Лу
Dialogue: 0,0:08:03.73,0:08:06.65,Default,,0,0,0,,Мацуридің кеудесін уқалағаным жаман болды ма?
Dialogue: 0,0:08:06.73,0:08:08.73,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:08:09.32,0:08:11.90,Default,,0,0,0,,Бір-біріңмен танысқаннан кейін осылай әрекет етсеңдер.
Dialogue: 0,0:08:11.99,0:08:13.70,Default,,0,0,0,,Егер бұл Лу болса, мен сотқа беремін.
Dialogue: 0,0:08:13.78,0:08:17.03,Default,,0,0,0,,Уф~ Мариді келесі жолы көргенде кешірім сұраймын.
Dialogue: 0,0:08:17.12,0:08:18.66,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:08:22.25,0:08:24.58,Default,,0,0,0,,Яйо, мен жындарды көре алмаймын
Dialogue: 0,0:08:24.67,0:08:27.13,Default,,0,0,0,,Сондықтан қарапайым адамдар иеленеді.
Dialogue: 0,0:08:27.79,0:08:29.55,Default,,0,0,0,,Ауырған сияқты.
Dialogue: 0,0:08:29.63,0:08:32.47,Default,,0,0,0,,Әлсіз құбыжықты жел диірмені де қарсы алмайды.
Dialogue: 0,0:08:32.55,0:08:34.47,Default,,0,0,0,,Айналада олар өте көп.
Dialogue: 0,0:08:34.97,0:08:36.39,Default,,0,0,0,,Әлсіз болса қауіпсіз бе?
Dialogue: 0,0:08:36.47,0:08:39.31,Default,,0,0,0,,Бұл табиғатқа байланысты, сондықтан мен тексеруім керек.
Dialogue: 0,0:08:40.31,0:08:41.02,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:41.52,0:08:44.85,Default,,0,0,0,,Егер мен мұқият болғанымда, байқаған болар едім.
Dialogue: 0,0:08:45.39,0:08:47.48,Default,,0,0,0,,Широгане үйретеді
Dialogue: 0,0:08:47.98,0:08:48.90,Default,,0,0,0,,Ах
Dialogue: 0,0:08:48.98,0:08:51.28,Default,,0,0,0,,Мацури мырза және басқалар жоқ.
Dialogue: 0,0:08:51.36,0:08:52.99,Default,,0,0,0,,Төтенше жағдайда біз кездесе алмаймыз.
Dialogue: 0,0:08:53.07,0:08:53.90,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:08:53.99,0:08:56.86,Default,,0,0,0,,Бұл тұмарды жағу арқылы жасалған күл.
Dialogue: 0,0:08:56.95,0:08:58.70,Default,,0,0,0,,Егер сіз жасырынып жатсаңыз
Dialogue: 0,0:08:59.20,0:09:01.04,Default,,0,0,0,,Желмен бірге соғу
Dialogue: 0,0:09:01.66,0:09:04.62,Default,,0,0,0,,Экзорцизм Ниндзя Ашикадзе
Dialogue: 0,0:09:09.34,0:09:13.80,Default,,0,0,0,,Ах, Яйоның аяғында пішін пайда болды...
Dialogue: 0,0:09:13.88,0:09:14.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:14.88,0:09:18.34,Default,,0,0,0,,Ах, Мари, мен бірдеңе айтқым келді...
Dialogue: 0,0:09:18.43,0:09:19.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:19.26,0:09:20.39,Default,,0,0,0,,Ах
Dialogue: 0,0:09:20.97,0:09:21.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:21.81,0:09:22.47,Default,,0,0,0,,Yayo!
Dialogue: 0,0:09:23.98,0:09:24.77,Default,,0,0,0,,А...
Dialogue: 0,0:09:34.61,0:09:35.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:36.07,0:09:38.03,Default,,0,0,0,,Мацури Ниндзя мырза!
Dialogue: 0,0:09:38.11,0:09:38.99,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:09:41.41,0:09:42.83,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:09:42.91,0:09:44.45,Default,,0,0,0,,Бұзық болма
Dialogue: 0,0:09:44.54,0:09:45.91,Default,,0,0,0,,Кю…
Dialogue: 0,0:09:46.00,0:09:50.13,Default,,0,0,0,,Ахаха... Кешіріңіз, Мари, біз қайтадан тығыз байланыста болдық.
Dialogue: 0,0:09:50.21,0:09:51.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:51.96,0:09:53.92,Default,,0,0,0,,Неліктен Яйо кешірім сұрайды?
Dialogue: 0,0:09:54.51,0:09:56.51,Default,,0,0,0,,Әдейі бүлдірген сияқты емес.
Dialogue: 0,0:09:57.01,0:09:58.88,Default,,0,0,0,,Жоқ, себебі...
Dialogue: 0,0:10:00.18,0:10:01.93,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:10:02.01,0:10:04.27,Default,,0,0,0,,Бұл суық болды.
Dialogue: 0,0:10:04.77,0:10:06.10,Default,,0,0,0,,Дос болып қалсақ та
Dialogue: 0,0:10:06.18,0:10:07.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.85,0:10:10.73,Default,,0,0,0,,Осы уақытқа дейін менің достарым көп болған жоқ.
Dialogue: 0,0:10:11.23,0:10:14.90,Default,,0,0,0,,Смартфонында жалғыз атам тіркелген.
Dialogue: 0,0:10:15.40,0:10:19.28,Default,,0,0,0,,Мен түсінбеймін. Достар арасында қашықтық сезімі бар ма?
Dialogue: 0,0:10:20.74,0:10:23.66,Default,,0,0,0,,Сонымен, ...
Dialogue: 0,0:10:24.16,0:10:29.29,Default,,0,0,0,,Қолымнан келсе, жақсы аралассақ деп едім.
Dialogue: 0,0:10:29.79,0:10:31.71,Default,,0,0,0,,Мен бақыттымын... мүмкін?
Dialogue: 0,0:10:32.59,0:10:33.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:34.38,0:10:37.17,Default,,0,0,0,,Иә, мен де солай жасағым келеді.
Dialogue: 0,0:10:39.26,0:10:41.09,Default,,0,0,0,,Мен де роу алғым келеді
Dialogue: 0,0:10:44.10,0:10:45.26,Default,,0,0,0,,Мацури
Dialogue: 0,0:10:47.22,0:10:51.15,Default,,0,0,0,,Мен сізге жаңа ғана хабарлама жібердім, сондықтан тіркеліңіз.
Dialogue: 0,0:10:51.23,0:10:53.23,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:10:53.31,0:10:55.07,Default,,0,0,0,,Дәлірек айтқанда, бұл
Dialogue: 0,0:10:55.15,0:10:58.36,Default,,0,0,0,,4 адамнан топ құру жылдамырақ емес пе?
Dialogue: 0,0:10:58.44,0:11:00.28,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:11:00.36,0:11:01.82,Default,,0,0,0,,Топтың аты Не істеуіміз керек?
Dialogue: 0,0:11:02.41,0:11:07.16,Default,,0,0,0,,Ханасу Сузу Тоба Яйои Казамаки Мацури Цукиока Люси
Dialogue: 0,0:11:07.66,0:11:09.21,Default,,0,0,0,,Ах! Бұл...
Dialogue: 0,0:11:09.96,0:11:11.62,Default,,0,0,0,,«Качофуугецу» жақсы емес пе?
Dialogue: 0,0:11:11.71,0:11:13.21,Default,,0,0,0,,Қарсылық жоқ!
Dialogue: 0,0:11:13.29,0:11:14.34,Default,,0,0,0,,Лу
Dialogue: 0,0:11:14.42,0:11:16.42,Default,,0,0,0,,Тым оғаш суреттерді орналастырмаңыз
Dialogue: 0,0:11:16.50,0:11:17.84,Default,,0,0,0,,Ешқандай кепілдік беруге болмайды.
Dialogue: 0,0:11:17.92,0:11:19.26,Default,,0,0,0,,Бұл қандай оғаш бейне?
Dialogue: 0,0:11:19.34,0:11:20.47,Default,,0,0,0,,Әрине
Dialogue: 0,0:11:20.55,0:11:22.80,Default,,0,0,0,,Мен оның тері реңі ең қарқынды екеніне сенімдімін.
Dialogue: 0,0:11:22.89,0:11:25.43,Default,,0,0,0,,Жоқ... Достар осындай заттарды жібере ме?
Dialogue: 0,0:11:25.51,0:11:28.47,Default,,0,0,0,,Ахахха! Әрине олай емес
Dialogue: 0,0:11:28.56,0:11:31.27,Default,,0,0,0,,Бірақ мен оның ерекше тері реңіне аздап алаңдаймын.
Dialogue: 0,0:11:31.35,0:11:32.40,Default,,0,0,0,,Мияу!
Dialogue: 0,0:11:32.48,0:11:35.23,Default,,0,0,0,,Мм, сүйкімді!
Dialogue: 0,0:11:38.86,0:11:42.36,Default,,0,0,0,,(резонанттық жүз дыбысы)
Dialogue: 0,0:11:50.41,0:11:52.92,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:11:56.67,0:11:58.25,Default,,0,0,0,,Ио ха!
Dialogue: 0,0:11:58.34,0:12:00.63,Default,,0,0,0,,Әй, эй!
Dialogue: 0,0:12:00.72,0:12:02.43,Default,,0,0,0,,Ио ха!
Dialogue: 0,0:12:02.51,0:12:04.43,Default,,0,0,0,,Не? бұл ырым
Dialogue: 0,0:12:05.18,0:12:06.64,Default,,0,0,0,,Хороши ырымы жоқ
Dialogue: 0,0:12:06.72,0:12:09.47,Default,,0,0,0,,Қайта ортада жамандық жасама.
Dialogue: 0,0:12:09.56,0:12:12.52,Default,,0,0,0,,Оны тауға қайтармас бұрын қорқытыңыз.
Dialogue: 0,0:12:13.02,0:12:15.77,Default,,0,0,0,,Жын шығаруды күн көретіндердің көбі
Dialogue: 0,0:12:15.86,0:12:20.40,Default,,0,0,0,,Жындардың бәрін күнә деп санама, Сузу-чан
Dialogue: 0,0:12:20.48,0:12:23.95,Default,,0,0,0,,Бір сөз бар, 8 миллион құдай.
Dialogue: 0,0:12:24.03,0:12:28.08,Default,,0,0,0,,Табиғат, жануарлар мен өсімдіктер, адамның іс-әрекеті мен ойлары
Dialogue: 0,0:12:28.58,0:12:33.62,Default,,0,0,0,,Жындар – осы дүниенің кез келген жерінен туған ойлы тұлғалар.
Dialogue: 0,0:12:33.71,0:12:36.29,Default,,0,0,0,,Бар, енді келме!
Dialogue: 0,0:12:36.38,0:12:37.92,Default,,0,0,0,,Кю~!
Dialogue: 0,0:12:38.00,0:12:42.30,Default,,0,0,0,,Егер ол өте зиянды болмаса, оны жоймай «қуып шығарыңыз».
Dialogue: 0,0:12:42.38,0:12:44.43,Default,,0,0,0,,Бұл да жын шығару.
Dialogue: 0,0:12:45.05,0:12:47.85,Default,,0,0,0,,Hmph, менің ойымша, бұл адами стандарттар.
Dialogue: 0,0:12:48.85,0:12:52.56,Default,,0,0,0,,Сен маған мұндай маңызды нәрселер туралы айтпайсың, Мари.
Dialogue: 0,0:12:53.06,0:12:57.65,Default,,0,0,0,,Менің ойымша, бұл мені жындар әлемінен аулақ ұстау үшін.
Dialogue: 0,0:13:00.65,0:13:01.94,Default,,0,0,0,,Сидзуо мырза
Dialogue: 0,0:13:05.91,0:13:06.82,Default,,0,0,0,,Кун
Dialogue: 0,0:13:07.82,0:13:08.82,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:08.91,0:13:11.16,Default,,0,0,0,,Кеше, ақыры, батыр қыздың сүйісімен
Dialogue: 0,0:13:11.24,0:13:14.21,Default,,0,0,0,,Ши-цзы итінен әдемі адамға дейін
Dialogue: 0,0:13:14.96,0:13:16.71,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:13:16.79,0:13:20.13,Default,,0,0,0,,Бұл салыстырмалы түрде кең тараған пончлайн болды.
Dialogue: 0,0:13:22.17,0:13:24.76,Default,,0,0,0,,Мұндай нәрсе жиі кездеседі ме?
Dialogue: 0,0:13:24.84,0:13:27.09,Default,,0,0,0,,Бұл ең романтикалық нәрсе.
Dialogue: 0,0:13:27.18,0:13:30.93,Default,,0,0,0,,Сәлем? Мацури де мұндай нәрсеге таңданады.
Dialogue: 0,0:13:31.01,0:13:32.14,Default,,0,0,0,,Жоқ, мүмкін емес.
Dialogue: 0,0:13:32.22,0:13:34.68,Default,,0,0,0,,Не? Сіз шынымен ризасыз ба?
Dialogue: 0,0:13:34.77,0:13:36.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:36.64,0:13:39.81,Default,,0,0,0,,Некеге дейін ер мен әйелдің сүйісуі мүмкін емес.
Dialogue: 0,0:13:39.90,0:13:42.40,Default,,0,0,0,,Онда? (Яйои) Сіз байсалдысыз ба?
Dialogue: 0,0:13:44.90,0:13:49.11,Default,,0,0,0,,Бірақ егер сіз ит болып қалатын болсаңыз, сіздің неке тіркеуіңіз қабылданбауы мүмкін.
Dialogue: 0,0:13:49.20,0:13:53.08,Default,,0,0,0,,Сонда өмір бойы Ши-цзы иті болып шыдайтын адам.
Dialogue: 0,0:13:53.16,0:13:57.04,Default,,0,0,0,,Ахахха! Мари ерлерге қатал ~
Dialogue: 0,0:13:57.67,0:14:01.25,Default,,0,0,0,,Сенің Яёрумен сөйлесуге үйреніп бара жатқаныңа қуаныштымын.
Dialogue: 0,0:14:01.75,0:14:04.76,Default,,0,0,0,,Сіздің махаббат туралы ойыңыз күрделі емес пе?
Dialogue: 0,0:14:06.30,0:14:10.80,Default,,0,0,0,,Мені қорғауды жын шығарушы ретіндегі міндетім деп санаймын.
Dialogue: 0,0:14:13.56,0:14:14.47,Default,,0,0,0,,Ах
Dialogue: 0,0:14:14.56,0:14:16.27,Default,,0,0,0,,Казамаки-доно
Dialogue: 0,0:14:16.35,0:14:17.18,Default,,0,0,0,,Жын?
Dialogue: 0,0:14:17.27,0:14:20.02,Default,,0,0,0,,Менің Нинокёку Поносукем
Dialogue: 0,0:14:20.52,0:14:24.02,Default,,0,0,0,,По - Сога Ниномаға қызмет ететін шикиони.
Dialogue: 0,0:14:24.69,0:14:27.15,Default,,0,0,0,,Бұл Жаратқан Иенің хабары.
Dialogue: 0,0:14:27.24,0:14:28.95,Default,,0,0,0,,«Пурист ретінде менің айтар сөзім бар».
Dialogue: 0,0:14:29.03,0:14:31.57,Default,,0,0,0,,«Костюміңді ауыстыр да, дереу мектеп ауласына кел».
Dialogue: 0,0:14:31.66,0:14:34.95,Default,,0,0,0,,«О, мен жалғызбын».
Dialogue: 0,0:14:36.70,0:14:38.75,Default,,0,0,0,,Мен барамын. Мен бұған тапсырыс бердім.
Dialogue: 0,0:14:38.83,0:14:40.50,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:14:42.46,0:14:46.71,Default,,0,0,0,,Ниномари-сенпай... Широгане туралы тағы бірдеңе бар ма?
Dialogue: 0,0:14:48.67,0:14:52.60,Default,,0,0,0,,Қолөнер техникасының кристалдануы, бұл ниндзя костюмі
Dialogue: 0,0:14:52.68,0:14:56.02,Default,,0,0,0,,Құрамында адам танымайтын хирургиялық әдіс бар
Dialogue: 0,0:14:56.52,0:14:58.06,Default,,0,0,0,,Жын сияқты...
Dialogue: 0,0:14:58.93,0:15:03.27,Default,,0,0,0,,Бірақ оны бақсы Хананасузу көріп тұрған сияқты.
Dialogue: 0,0:15:03.90,0:15:05.52,Default,,0,0,0,,Бұл не, Сенпай?
Dialogue: 0,0:15:06.28,0:15:09.07,Default,,0,0,0,,Бұл жолы Широганның орнына Сузу туралы айтып отырмыз ба?
Dialogue: 0,0:15:09.15,0:15:12.49,Default,,0,0,0,,Бір саланың адамы ретінде мен сізге ескерту жасаймын деп ойладым.
Dialogue: 0,0:15:12.99,0:15:14.62,Default,,0,0,0,,Менімен сөйлесші, Поносуке.
Dialogue: 0,0:15:14.70,0:15:17.04,Default,,0,0,0,,Сізге көп рахмет, Ием.
Dialogue: 0,0:15:17.12,0:15:22.50,Default,,0,0,0,,Мен мырзамның разылығы үшін күн сайын тынымсыз еңбек етемін.
Dialogue: 0,0:15:22.58,0:15:25.21,Default,,0,0,0,,Мен де жындар туралы қауесеттер жинадым.
Dialogue: 0,0:15:25.29,0:15:28.84,Default,,0,0,0,,Өткенде бір саяхатшы жын мас болып есінен танып қалды.
Dialogue: 0,0:15:28.92,0:15:30.97,Default,,0,0,0,,Біз бұл туралы айтып отырмыз.
Dialogue: 0,0:15:32.76,0:15:35.60,Default,,0,0,0,,Бұл дүниеде таңғажайыптар көп
Dialogue: 0,0:15:36.31,0:15:38.47,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:15:38.56,0:15:41.39,Default,,0,0,0,,Бір кездері болған бақсы
Dialogue: 0,0:15:41.48,0:15:44.44,Default,,0,0,0,,Адам да, жын да болса керек.
Dialogue: 0,0:15:45.02,0:15:46.65,Default,,0,0,0,,Адам немесе жын ба?
Dialogue: 0,0:15:47.32,0:15:49.90,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:15:49.99,0:15:51.86,Default,,0,0,0,,Кейбір халық ертегілерінде
Dialogue: 0,0:15:51.95,0:15:56.78,Default,,0,0,0,,Адамды да, жынды да біріктіретін болмыс деседі.
Dialogue: 0,0:15:57.28,0:16:00.83,Default,,0,0,0,,Бұл тек өмірдің артықтығы емес.
Dialogue: 0,0:16:01.71,0:16:05.88,Default,,0,0,0,,Сузу Ханасаде бір уақытта адам да, жын да.
Dialogue: 0,0:16:08.00,0:16:11.09,Default,,0,0,0,,Сузу жын ба?
Dialogue: 0,0:16:11.63,0:16:13.13,Default,,0,0,0,,(Қыздардың күлкісі)
Dialogue: 0,0:16:13.22,0:16:15.51,Default,,0,0,0,,Өте сүйкімді~ (қыз) Эй~
Dialogue: 0,0:16:15.59,0:16:16.43,Default,,0,0,0,,Ня~
Dialogue: 0,0:16:16.51,0:16:20.22,Default,,0,0,0,,Кем дегенде Широган сияқты, бұл да сақ болу керек.
Dialogue: 0,0:16:20.89,0:16:25.69,Default,,0,0,0,,Егер сіз басқаларға зиян келтірсеңіз, сіз жын шығаруға ұшырауыңыз мүмкін...
Dialogue: 0,0:16:25.77,0:16:26.36,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:27.52,0:16:28.02,Default,,0,0,0,,По!
Dialogue: 0,0:16:30.03,0:16:33.28,Default,,0,0,0,,Жоқ! Тіпті менің үлкендерім де ашуланады.
Dialogue: 0,0:16:33.36,0:16:37.49,Default,,0,0,0,,Бұл мүмкіндік мәселесі. Сабыр сақта, тәжірибесіз адам.
Dialogue: 0,0:16:37.57,0:16:39.58,Default,,0,0,0,,Сондықтан мұндай мүмкіндік жоқ
Dialogue: 0,0:16:39.66,0:16:40.79,Default,,0,0,0,,Мен сәлем дедім!
Dialogue: 0,0:16:43.41,0:16:46.58,Default,,0,0,0,,Nu? Бұл сезім...
Dialogue: 0,0:16:47.96,0:16:49.38,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:16:52.92,0:16:54.76,Default,,0,0,0,,Реререр... Сабыр ет, мен!
Dialogue: 0,0:16:54.84,0:16:56.14,Default,,0,0,0,,Бұл жігіттің нағыз тұлғасы – ер адам.
Dialogue: 0,0:16:56.22,0:16:57.93,Default,,0,0,0,,Дұрыс түсінсең де, бәрібір.
Dialogue: 0,0:16:58.01,0:17:01.43,Default,,0,0,0,,Жоғалтпа, Суга Ниномагари, сен тәжірибесізсің!
Dialogue: 0,0:17:01.52,0:17:02.77,Default,,0,0,0,,Мырза?
Dialogue: 0,0:17:02.85,0:17:04.85,Default,,0,0,0,,Мен... мен саған ескерттім.
Dialogue: 0,0:17:04.94,0:17:06.69,Default,,0,0,0,,Қоңырау шырылдағалы тұр
Dialogue: 0,0:17:06.77,0:17:08.65,Default,,0,0,0,,Уа, Мырза~
Dialogue: 0,0:17:09.15,0:17:10.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:16.57,0:17:17.57,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:17:19.07,0:17:20.20,Default,,0,0,0,,Мацури, үйге қайт
Dialogue: 0,0:17:21.49,0:17:22.33,Default,,0,0,0,,О
Dialogue: 0,0:17:22.41,0:17:25.04,Default,,0,0,0,,Сіз түстен кейін өзіңізді жақсы сезінбедіңіз.
Dialogue: 0,0:17:25.12,0:17:27.75,Default,,0,0,0,,Ниномари-сенпай сізге бірдеңе деді ме?
Dialogue: 0,0:17:27.83,0:17:30.71,Default,,0,0,0,,Сіз Широганды қуып шығаруды шештіңіз бе?
Dialogue: 0,0:17:33.21,0:17:35.13,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:17:36.43,0:17:38.84,Default,,0,0,0,,Сузу алаңдайтын ештеңе жоқ.
Dialogue: 0,0:17:39.43,0:17:40.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:41.31,0:17:43.06,Default,,0,0,0,,Мияу! Няня~!
Dialogue: 0,0:17:43.14,0:17:44.64,Default,,0,0,0,,Широганның дауысы?
Dialogue: 0,0:17:44.73,0:17:47.56,Default,,0,0,0,,А, мен Нинокёку-сенпай деп ойладым ба?
Dialogue: 0,0:17:47.64,0:17:50.56,Default,,0,0,0,,Иняня~! (Сухимори) Маған мофу болуға рұқсат етіңіз~!
Dialogue: 0,0:17:50.65,0:17:52.44,Default,,0,0,0,,Қорықпа!
Dialogue: 0,0:17:52.52,0:17:54.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:57.49,0:17:58.28,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:58.91,0:18:02.03,Default,,0,0,0,,Ертеңгі Сузу Данго аяқталды!
Dialogue: 0,0:18:05.33,0:18:09.58,Default,,0,0,0,,Хмм! Мүмкін дәмі қайтадан жақсарады
Dialogue: 0,0:18:09.67,0:18:12.54,Default,,0,0,0,,Бұл материалдар балансына байланысты өзгере ме?
Dialogue: 0,0:18:12.63,0:18:16.72,Default,,0,0,0,,Хмм, жапон тәттілерінің әлемі де өте терең.
Dialogue: 0,0:18:17.80,0:18:21.47,Default,,0,0,0,,Менің мақсатым Широган мені жеуден бас тартатын деңгейге жету.
Dialogue: 0,0:18:21.55,0:18:23.10,Default,,0,0,0,,Ең жақсы тары Данго
Dialogue: 0,0:18:23.18,0:18:24.56,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:18:24.64,0:18:27.23,Default,,0,0,0,,Сузу Оны жеудің қажеті жоқ, солай ма?
Dialogue: 0,0:18:28.02,0:18:32.36,Default,,0,0,0,,Маридің ұл болу үшін қолымнан келгеннің бәрі осы.
Dialogue: 0,0:18:32.44,0:18:33.94,Default,,0,0,0,,Мен барынша тырысуым керек
Dialogue: 0,0:18:34.82,0:18:37.65,Default,,0,0,0,,Мен тағы не істей аламын?
Dialogue: 0,0:18:37.74,0:18:39.66,Default,,0,0,0,,Мен не қажет болса да істеймін
Dialogue: 0,0:18:40.36,0:18:42.53,Default,,0,0,0,,Сузу алаңдайтын ештеңе жоқ.
Dialogue: 0,0:18:43.62,0:18:45.79,Default,,0,0,0,,Сен менімен сөйлеспейсің ғой.
Dialogue: 0,0:18:45.87,0:18:47.37,Default,,0,0,0,,Қалайы?
Dialogue: 0,0:18:47.45,0:18:48.16,Default,,0,0,0,,Ах
Dialogue: 0,0:18:48.25,0:18:50.08,Default,,0,0,0,,Анашым, не?
Dialogue: 0,0:18:50.17,0:18:53.00,Default,,0,0,0,,Бүгін сіз кездейсоқ оданго жасадыңыз ба?
Dialogue: 0,0:18:53.09,0:18:56.00,Default,,0,0,0,,Иә, өте дәмді болып шықты.
Dialogue: 0,0:18:56.09,0:18:58.67,Default,,0,0,0,,Дәмін көргіңіз келе ме? ...Жоқ!
Dialogue: 0,0:18:58.76,0:19:00.34,Default,,0,0,0,,Мен оны қайта жасаймын.
Dialogue: 0,0:19:00.43,0:19:02.93,Default,,0,0,0,,Менің ақымақ!
Dialogue: 0,0:19:03.01,0:19:04.26,Default,,0,0,0,,Аха…
Dialogue: 0,0:19:07.14,0:19:10.77,Default,,0,0,0,,Хаа~ Мен шаршадым.
Dialogue: 0,0:19:12.23,0:19:16.28,Default,,0,0,0,,Мен тек жапондық тәттілерді жесем, мен де батыстың тәттісін жегім келмейді.
Dialogue: 0,0:19:16.78,0:19:19.44,Default,,0,0,0,,Мен Сакура Farm Crepe жегім келеді
Dialogue: 0,0:19:24.49,0:19:30.12,Default,,0,0,0,,Маридің техникасын драмадағыдай сүйісу арқылы шешуге болатын болса
Dialogue: 0,0:19:32.04,0:19:35.21,Default,,0,0,0,,Бұл оңай болса да...
Dialogue: 0,0:19:36.80,0:19:40.97,Default,,0,0,0,,Мен бірден...
Dialogue: 0,0:19:41.05,0:19:44.51,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:19:48.97,0:19:50.31,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:50.39,0:19:53.85,Default,,0,0,0,,Үйреніп алғаннан кейін қаңғыбас мысық болып көріну жаман емес.
Dialogue: 0,0:19:54.52,0:19:57.48,Default,,0,0,0,,Студент қыздар түрлі тағамдар береді.
Dialogue: 0,0:19:57.57,0:20:01.61,Default,,0,0,0,,Тек сол бұлшық ет мұғалімі қиын.
Dialogue: 0,0:20:02.20,0:20:03.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:03.66,0:20:04.82,Default,,0,0,0,,Не?
Dialogue: 0,0:20:05.53,0:20:06.70,Default,,0,0,0,,Жек көру...
Dialogue: 0,0:20:07.28,0:20:10.58,Default,,0,0,0,,Бір сәт өзімді бірдеңе дұрыс емес деп сезіндім.
Dialogue: 0,0:20:11.21,0:20:12.66,Default,,0,0,0,,Бұл тек менің қиялым ба?
Dialogue: 0,0:20:15.08,0:20:16.59,Default,,0,0,0,,(Бетті айналдыру дыбысы)
Dialogue: 0,0:20:24.97,0:20:26.30,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:20:26.39,0:20:29.43,Default,,0,0,0,,Мен уайымдап, ойымды жинақтай алмаймын
Dialogue: 0,0:20:30.43,0:20:33.77,Default,,0,0,0,,Нино әні, сіз біртүрлі нәрсе айттыңыз.
Dialogue: 0,0:20:34.60,0:20:38.11,Default,,0,0,0,,Сузу жын ба? Ақымақ сияқты
Dialogue: 0,0:20:39.40,0:20:41.78,Default,,0,0,0,,Оның тіпті ата-анасы бар.
Dialogue: 0,0:20:42.28,0:20:46.11,Default,,0,0,0,,Мен онымен көп жылдар бойы айналыстым, сондықтан мен оны жақсы білемін.
Dialogue: 0,0:20:47.03,0:20:49.83,Default,,0,0,0,,Мари: Қарашы, мен шашымды қидым.
Dialogue: 0,0:20:49.91,0:20:52.04,Default,,0,0,0,,Себебі Мари "бұл кедергі болатын сияқты" дейді
Dialogue: 0,0:20:52.12,0:20:54.71,Default,,0,0,0,,Мен анама ұқсадым, хехехе
Dialogue: 0,0:20:56.17,0:20:59.67,Default,,0,0,0,,Бұл балаға Биллюко деген сүйкімді есім беріңіз.
Dialogue: 0,0:21:05.51,0:21:08.18,Default,,0,0,0,,Мен осындамын, Мари
Dialogue: 0,0:21:09.81,0:21:11.18,Default,,0,0,0,,Нитеба
Dialogue: 0,0:21:12.89,0:21:13.89,Default,,0,0,0,,Мацури?
Dialogue: 0,0:21:15.10,0:21:16.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:20.94,0:21:22.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:25.70,0:21:26.78,Default,,0,0,0,,Мацури
Dialogue: 0,0:21:27.36,0:21:30.12,Default,,0,0,0,,А... Сузу?
Dialogue: 0,0:21:31.45,0:21:33.25,Default,,0,0,0,,Неліктен Сузу мұнда?
Dialogue: 0,0:21:33.75,0:21:35.21,Default,,0,0,0,,Широгандағы тағы бір өзгеріс?
Dialogue: 0,0:21:36.50,0:21:41.59,Default,,0,0,0,,Жоқ, түсіндім, өйткені мен фейк болуды бастан кешірдім.
Dialogue: 0,0:21:43.67,0:21:47.43,Default,,0,0,0,,Сузу дене температурасы Сусабынның иісі
Dialogue: 0,0:21:48.68,0:21:51.39,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:21:52.39,0:21:55.52,Default,,0,0,0,,Тіпті тыныс алу да шынайы...
Dialogue: 0,0:21:58.60,0:22:01.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:01.57,0:22:04.44,Default,,0,0,0,,Жоқ... бұл не?
Dialogue: 0,0:22:05.94,0:22:07.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.78,0:23:34.78,Default,,0,0,0,,～♪
