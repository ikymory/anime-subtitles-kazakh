Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.83,0:00:03.83,Default,,0,0,0,,Мацури мырза
Dialogue: 0,0:00:03.92,0:00:07.21,Default,,0,0,0,,Мацури кейде ойнайтын қолданба ойыны
Dialogue: 0,0:00:07.29,0:00:09.55,Default,,0,0,0,,Бұл "Switch ON Yoji!"
Dialogue: 0,0:00:09.63,0:00:11.17,Default,,0,0,0,,Не? Лу, сен білесің бе?
Dialogue: 0,0:00:11.76,0:00:13.38,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:00:13.47,0:00:17.43,Default,,0,0,0,,Сайпей Юкидің мангасы оның дебюттік жұмысынан бері аяқталды.
Dialogue: 0,0:00:17.93,0:00:20.52,Default,,0,0,0,,Әрине, электронды нұсқасы да бар.
Dialogue: 0,0:00:20.60,0:00:23.89,Default,,0,0,0,,Шынайы ма? 100-ден астам кітап бар екеніне сенімдімін.
Dialogue: 0,0:00:24.39,0:00:27.23,Default,,0,0,0,,Мазмұны негізінен ер адамдарға арналған деп ойлаймын.
Dialogue: 0,0:00:27.31,0:00:31.03,Default,,0,0,0,,Жастар журналдарына да түбегейлі дүниелер жазды.
Dialogue: 0,0:00:31.69,0:00:35.95,Default,,0,0,0,,Эро-Гуро қош келдіңіз. Жыныстың көңіл көтеруге ешқандай қатысы жоқ.
Dialogue: 0,0:00:36.03,0:00:39.28,Default,,0,0,0,,«Sui ON» қызық екеніне сенімдімін.
Dialogue: 0,0:00:39.37,0:00:41.58,Default,,0,0,0,,«SuiON» сөзін түсінетін қыздар
Dialogue: 0,0:00:41.66,0:00:42.62,Default,,0,0,0,,Бірінші рет
Dialogue: 0,0:00:42.70,0:00:44.91,Default,,0,0,0,,Мен де, олай етпе, Лу!
Dialogue: 0,0:00:45.00,0:00:48.75,Default,,0,0,0,,Эй, Мари, менде Лу сияқты қызығушылықтар бар.
Dialogue: 0,0:00:50.05,0:00:52.26,Default,,0,0,0,,Хехе, біз жақсы араласамыз.
Dialogue: 0,0:00:52.34,0:00:53.67,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:00:53.76,0:00:56.55,Default,,0,0,0,,Баратын уақыт болды ма? Келесі кезекте дене шынықтыру.
Dialogue: 0,0:00:56.63,0:00:57.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:57.59,0:00:59.14,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:00:59.22,0:01:01.97,Default,,0,0,0,,Әңгімеге сіңісіп кеттім.
Dialogue: 0,0:01:02.06,0:01:03.43,Default,,0,0,0,,Ой~ (Мари) Иә.
Dialogue: 0,0:01:03.52,0:01:05.94,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін, Мацури
Dialogue: 0,0:01:06.02,0:01:08.98,Default,,0,0,0,,ЖТ кезінде мен әрқашан киімімді білмей тұрып ауыстырамын.
Dialogue: 0,0:01:09.06,0:01:10.65,Default,,0,0,0,,Бүгін бірге киім ауыстырамыз~
Dialogue: 0,0:01:10.73,0:01:12.32,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:01:12.40,0:01:17.57,Default,,0,0,0,,Мацури мырза: Біз гүлдер, құстар, жел және ай, жалаңаш араласу маңызды.
Dialogue: 0,0:01:21.91,0:01:24.25,Default,,0,0,0,,- бұл... жалаңаш араласу!
Dialogue: 0,0:01:24.75,0:01:26.50,Default,,0,0,0,,Не істеу керек? Мацури
Dialogue: 0,0:01:29.83,0:01:31.17,Default,,0,0,0,,«Юкай»
Dialogue: 0,0:01:31.67,0:01:35.80,Default,,0,0,0,,Ол жұмбақ және адам көзіне көрінбейді.
Dialogue: 0,0:01:36.30,0:01:39.47,Default,,0,0,0,,Адамдардан кек алатын зұлым жындарды жою үшін
Dialogue: 0,0:01:39.97,0:01:43.68,Default,,0,0,0,,Ежелден соғысып келе жатқан ниндзялар бар.
Dialogue: 0,0:01:44.89,0:01:46.06,Default,,0,0,0,,Оның аты
Dialogue: 0,0:01:51.82,0:01:53.53,Default,,0,0,0,,Жын шығару
Dialogue: 0,0:01:54.03,0:01:56.03,Default,,0,0,0,,♪～
Dialogue: 0,0:03:21.91,0:03:23.91,Default,,0,0,0,,～♪
Dialogue: 0,0:03:25.33,0:03:26.62,Default,,0,0,0,,Бүгін мектептің айналасында
Dialogue: 0,0:03:26.70,0:03:28.33,Default,,0,0,0,,Жеңіл жүгіруге барасыз ба?
Dialogue: 0,0:03:28.41,0:03:30.21,Default,,0,0,0,,Уе~ Таруиссу
Dialogue: 0,0:03:30.29,0:03:31.37,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:03:31.46,0:03:33.37,Default,,0,0,0,,Жел жақсы көрінеді.
Dialogue: 0,0:03:33.46,0:03:35.42,Default,,0,0,0,,Бәріміз бірдей қарқынмен жүгірейік
Dialogue: 0,0:03:35.50,0:03:36.71,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:37.30,0:03:39.88,Default,,0,0,0,,Алдымен жүгіру дұрыс емес.
Dialogue: 0,0:03:39.96,0:03:41.17,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:03:41.93,0:03:43.30,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:03:43.38,0:03:45.72,Default,,0,0,0,,Бұрынғы шыдамсыздық қайдан шықты?
Dialogue: 0,0:03:45.80,0:03:48.01,Default,,0,0,0,,Қызға ұқсайтыны жақсы.
Dialogue: 0,0:03:48.10,0:03:50.56,Default,,0,0,0,,Бірге киім ауыстыруды жоспарлайсыз ба?
Dialogue: 0,0:03:50.64,0:03:52.35,Default,,0,0,0,,Бұл жақсы емес, солай ма?
Dialogue: 0,0:03:52.44,0:03:54.10,Default,,0,0,0,,Бұл орын алса ше...
Dialogue: 0,0:03:57.07,0:03:58.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:58.69,0:03:59.82,Default,,0,0,0,,Ел көлеміндегі ең ізденетін Зұлымдар Альянсы
Dialogue: 0,0:04:01.78,0:04:04.99,Default,,0,0,0,,Бәрін де қалқандай қорғаудан басқа амалым жоқ!
Dialogue: 0,0:04:05.70,0:04:08.24,Default,,0,0,0,,Қарайтын болсаң, маған қара
Dialogue: 0,0:04:08.74,0:04:10.25,Default,,0,0,0,,Уф
Dialogue: 0,0:04:10.33,0:04:12.12,Default,,0,0,0,,Сузу жігіті
Dialogue: 0,0:04:12.21,0:04:15.67,Default,,0,0,0,,Әлгі бет тағы да ұятсыз нәрсені ойлап отыр.
Dialogue: 0,0:04:16.33,0:04:19.13,Default,,0,0,0,,Шамадан тыс өміршеңдіктен ұятсыз ба?
Dialogue: 0,0:04:19.21,0:04:22.67,Default,,0,0,0,,Оның бақсы болғаны сондай болғандықтан ба?
Dialogue: 0,0:04:23.17,0:04:24.13,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:04:25.26,0:04:26.43,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:04:26.51,0:04:30.18,Default,,0,0,0,,Фестиваль ауылында ашылған жерді көріп, Фудзиннің шиыршығын ұрлап алдым.
Dialogue: 0,0:04:30.81,0:04:33.77,Default,,0,0,0,,Бастапқы пішінге оралыңыз және қалайы жеңіз
Dialogue: 0,0:04:34.27,0:04:36.15,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:04:36.73,0:04:38.40,Default,,0,0,0,,Мари формада болғанда
Dialogue: 0,0:04:38.48,0:04:42.24,Default,,0,0,0,,Үйде оның арқасында шиыршық бар екені расталды.
Dialogue: 0,0:04:42.74,0:04:44.95,Default,,0,0,0,,Ой, оқушылар көп екен.
Dialogue: 0,0:04:45.03,0:04:48.62,Default,,0,0,0,,Жақсы мүмкіндік - киім ауыстыру, ол алаңдатуы мүмкін.
Dialogue: 0,0:04:51.66,0:04:53.20,Default,,0,0,0,,Мен келе жатырмын!
Dialogue: 0,0:04:53.83,0:04:55.42,Default,,0,0,0,,Бос орындар жоқ па?
Dialogue: 0,0:04:55.50,0:04:57.54,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:57.63,0:05:00.46,Default,,0,0,0,,Мен сізге еріп келемін! (Әйел) Өте сүйкімді~
Dialogue: 0,0:05:00.96,0:05:03.46,Default,,0,0,0,,Түсіндім, тез киім ауыстыр.
Dialogue: 0,0:05:03.55,0:05:05.68,Default,,0,0,0,,Ол өзінше ойланып отырды.
Dialogue: 0,0:05:05.76,0:05:09.43,Default,,0,0,0,,Менде біртүрлі адасушылықтар бар, мен ақымақпын
Dialogue: 0,0:05:09.51,0:05:10.93,Default,,0,0,0,,Көрдіңіз бе? Сузу мырза
Dialogue: 0,0:05:11.01,0:05:11.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:12.39,0:05:13.77,Default,,0,0,0,,Мацури мырзаның асқазаны...
Dialogue: 0,0:05:13.85,0:05:15.06,Default,,0,0,0,,Не?
Dialogue: 0,0:05:15.89,0:05:17.44,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:05:17.52,0:05:20.23,Default,,0,0,0,,Өйткені жынысты өзгерту белгісін жын берген.
Dialogue: 0,0:05:20.32,0:05:23.36,Default,,0,0,0,,Марисато қарапайым адамдар оны көре алмайды деп айтса да.
Dialogue: 0,0:05:23.44,0:05:24.49,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:05:24.57,0:05:27.70,Default,,0,0,0,,Мен сүйкімді ішімді суретке түсіруге рұқсат етемін деп ойладым.
Dialogue: 0,0:05:27.78,0:05:28.82,Default,,0,0,0,,Мен кеттім
Dialogue: 0,0:05:28.91,0:05:32.29,Default,,0,0,0,,Дәлірек айтқанда, смартфонды киім ауыстыратын бөлмеде пайдалана алмайсыз!
Dialogue: 0,0:05:32.37,0:05:33.54,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:05:33.62,0:05:36.16,Default,,0,0,0,,А... Мен бірдеңені түсіріп алдым.
Dialogue: 0,0:05:36.25,0:05:38.58,Default,,0,0,0,,Бұл не? Шиыршық сияқты
Dialogue: 0,0:05:38.67,0:05:39.79,Default,,0,0,0,,Иә? (Яйои) Иә?
Dialogue: 0,0:05:40.46,0:05:42.00,Default,,0,0,0,,Фудзиннің томы…
Dialogue: 0,0:05:42.71,0:05:44.59,Default,,0,0,0,,Оны қалай түсіндіремін?
Dialogue: 0,0:05:45.92,0:05:48.97,Default,,0,0,0,,Ах~ Өйткені мен ниндзялардың ұрпағымын.
Dialogue: 0,0:05:49.05,0:05:50.68,Default,,0,0,0,,Бұл құпия шиыршық.
Dialogue: 0,0:05:50.76,0:05:53.14,Default,,0,0,0,,Бұл отбасылық мұра, сондықтан мен оны өз басыма кию арқылы қорғаймын.
Dialogue: 0,0:05:53.22,0:05:54.43,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:05:54.52,0:05:56.27,Default,,0,0,0,,Мен ұпай жинадым
Dialogue: 0,0:05:56.35,0:05:59.35,Default,,0,0,0,,Мен бұл параметр екенін түсіне алмадым.
Dialogue: 0,0:05:59.85,0:06:01.81,Default,,0,0,0,,Жасай бер, Мацури
Dialogue: 0,0:06:01.90,0:06:06.53,Default,,0,0,0,,Тазарту ниндзясы ретінде мен жындарды сөндіретін шиыршық бар деп айта алмаймын.
Dialogue: 0,0:06:07.86,0:06:10.24,Default,,0,0,0,,Маған сену мүмкін емес.
Dialogue: 0,0:06:11.28,0:06:13.79,Default,,0,0,0,,Әлгі бала елестерді көретінін айтады.
Dialogue: 0,0:06:13.87,0:06:15.20,Default,,0,0,0,,Өтірікке толы
Dialogue: 0,0:06:16.08,0:06:19.96,Default,,0,0,0,,Жарайды Сузу, елес жоқ.
Dialogue: 0,0:06:20.54,0:06:23.96,Default,,0,0,0,,Көрмейтін адамға ештеңе айта алмайсың.
Dialogue: 0,0:06:26.13,0:06:27.26,Default,,0,0,0,,Suzu…
Dialogue: 0,0:06:30.89,0:06:33.43,Default,,0,0,0,,(Судзудің ауыр тыныс алуы)
Dialogue: 0,0:06:34.01,0:06:36.39,Default,,0,0,0,,Қызық, Сузу жігіті ойлайды ма?
Dialogue: 0,0:06:37.14,0:06:39.85,Default,,0,0,0,,Мен достарыма өтірік айтамын.
Dialogue: 0,0:06:42.94,0:06:45.57,Default,,0,0,0,,Қарқынды бұзу - бұл бұзушылық.
Dialogue: 0,0:06:45.65,0:06:48.03,Default,,0,0,0,,(Ерлердің ауыр тыныс алуы)
Dialogue: 0,0:06:50.32,0:06:50.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:51.41,0:06:52.78,Default,,0,0,0,,Керемет
Dialogue: 0,0:06:52.87,0:06:54.99,Default,,0,0,0,,Не... ұлы күш
Dialogue: 0,0:06:55.08,0:06:56.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:58.04,0:07:01.25,Default,,0,0,0,,Мына жігіттер менің кеудеме қарауы керек.
Dialogue: 0,0:07:01.33,0:07:03.71,Default,,0,0,0,,Сіздің көзқарасыңыз анық
Dialogue: 0,0:07:03.79,0:07:06.17,Default,,0,0,0,,Түсінбедім деп ойлайсың ба, бала?
Dialogue: 0,0:07:06.80,0:07:09.09,Default,,0,0,0,,...Не? Мен де ұл баламын ба?
Dialogue: 0,0:07:09.17,0:07:13.14,Default,,0,0,0,,Хмм, мүмкін мен мұнда бір нәрсе істеуім керек.
Dialogue: 0,0:07:13.22,0:07:14.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:14.10,0:07:15.26,Default,,0,0,0,,Сәлем, балалар! (Мари) А...
Dialogue: 0,0:07:15.35,0:07:17.31,Default,,0,0,0,,Мацуриге біртүрлі қарама! (Ұлдар) Уф
Dialogue: 0,0:07:17.39,0:07:19.52,Default,,0,0,0,,Бұл күндері жағдай қиын.
Dialogue: 0,0:07:19.60,0:07:21.35,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:07:21.44,0:07:23.81,Default,,0,0,0,,Ооо, кет!
Dialogue: 0,0:07:23.90,0:07:26.65,Default,,0,0,0,,Бұл гүлдердің, құстардың, желдің және айдың байланысы
Dialogue: 0,0:07:26.73,0:07:27.69,Default,,0,0,0,,Уау
Dialogue: 0,0:07:29.82,0:07:31.45,Default,,0,0,0,,Сузуды түсіндім
Dialogue: 0,0:07:31.53,0:07:33.70,Default,,0,0,0,,Өтірік айту қиын емес пе?
Dialogue: 0,0:07:34.28,0:07:37.70,Default,,0,0,0,,Дос болсақ та, барлығын айта алмайтынымыз қынжылтады.
Dialogue: 0,0:07:38.24,0:07:41.58,Default,,0,0,0,,Қарапайым адамдар жындарды көре алмайды, бұл жақсы.
Dialogue: 0,0:07:42.08,0:07:45.96,Default,,0,0,0,,Бұрын бұл қазіргі әлемде қалыпты жағдай.
Dialogue: 0,0:07:46.54,0:07:47.63,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:07:50.26,0:07:51.88,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:07:52.80,0:07:57.60,Default,,0,0,0,,Осы екеуі біздің әлемді де көрсе екен.
Dialogue: 0,0:07:58.26,0:08:00.35,Default,,0,0,0,,Жарайды, бұл соңғы серпіліс.
Dialogue: 0,0:08:00.43,0:08:02.14,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:02.23,0:08:04.81,Default,,0,0,0,,Жоқ, мен тек жарты жолдан өттім.
Dialogue: 0,0:08:04.90,0:08:05.90,Default,,0,0,0,,Хехехе
Dialogue: 0,0:08:06.40,0:08:09.07,Default,,0,0,0,,Мияу
Dialogue: 0,0:08:09.65,0:08:12.07,Default,,0,0,0,,Иә Snack Сізге бұл ұнайды, солай емес пе?
Dialogue: 0,0:08:12.15,0:08:14.11,Default,,0,0,0,,Мияу мияу
Dialogue: 0,0:08:15.11,0:08:16.57,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:08:17.07,0:08:18.41,Default,,0,0,0,,Мияу мияу
Dialogue: 0,0:08:19.29,0:08:23.12,Default,,0,0,0,,Фу~ Мен де бүгін сүйкімділікті тараттым
Dialogue: 0,0:08:23.21,0:08:24.25,Default,,0,0,0,,Широган
Dialogue: 0,0:08:24.33,0:08:26.25,Default,,0,0,0,,Осузу Мацури
Dialogue: 0,0:08:28.00,0:08:31.51,Default,,0,0,0,,Мұны сөмкеңізге салыңыз. Бұл бүгінгі құрмет.
Dialogue: 0,0:08:31.59,0:08:35.13,Default,,0,0,0,,Құбыжық болуды қойып, қаңғыбас мысық сияқты өмір сүру керек.
Dialogue: 0,0:08:35.22,0:08:36.34,Default,,0,0,0,,Ах
Dialogue: 0,0:08:36.43,0:08:37.09,Default,,0,0,0,,Не?
Dialogue: 0,0:08:37.97,0:08:40.77,Default,,0,0,0,,Бұл exorcist қолданбасы үшін құбыжық туралы ескерту.
Dialogue: 0,0:08:40.85,0:08:42.39,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:08:42.48,0:08:46.52,Default,,0,0,0,,«Омико қаласындағы Китасай орта мектебінің жанында кеңістіктік бұрмалану байқалды»
Dialogue: 0,0:08:46.60,0:08:49.52,Default,,0,0,0,,«Тиісті аймақтағы мүшелерге ескерту жасалды».
Dialogue: 0,0:08:49.61,0:08:50.86,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:50.94,0:08:53.53,Default,,0,0,0,,Жаман жындардың пайда болуы оңайырақ.
Dialogue: 0,0:08:53.61,0:08:54.99,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:55.07,0:08:56.66,Default,,0,0,0,,Біздің кінәміз бе?
Dialogue: 0,0:08:56.74,0:08:58.99,Default,,0,0,0,,Мацури мырза, Сузу мырза Бұл қиын!
Dialogue: 0,0:08:59.08,0:08:59.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:02.62,0:09:06.58,Default,,0,0,0,,Мен жаңа ғана Сухимори мырзаның мектеп ауласында бұлшықет жаттығуларын жасап жатқанын суретке түсірдім.
Dialogue: 0,0:09:06.67,0:09:09.04,Default,,0,0,0,,Мен таңғажайып суреттерді түсіре алдым.
Dialogue: 0,0:09:09.13,0:09:09.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:09.96,0:09:12.26,Default,,0,0,0,,Күн сайын 300 суретке түсемін.
Dialogue: 0,0:09:12.34,0:09:15.51,Default,,0,0,0,,Мен мұндай нәрсені бірінші рет жасап тұрмын. Мен сондай қуаныштымын!
Dialogue: 0,0:09:15.59,0:09:17.64,Default,,0,0,0,,Рухтың суреті дегеніміз не?
Dialogue: 0,0:09:17.72,0:09:20.22,Default,,0,0,0,,Бұл біраз ауыр, солай емес пе?
Dialogue: 0,0:09:21.97,0:09:24.23,Default,,0,0,0,,Мм, Мари.
Dialogue: 0,0:09:24.31,0:09:26.39,Default,,0,0,0,,Әй, қалай қарасаң да...
Dialogue: 0,0:09:27.02,0:09:30.11,Default,,0,0,0,,Жоқ, бұл қазына.
Dialogue: 0,0:09:30.19,0:09:32.28,Default,,0,0,0,,(Ертегінің айқайы)
Dialogue: 0,0:09:32.98,0:09:34.44,Default,,0,0,0,,Қауіпті жігіт
Dialogue: 0,0:09:35.24,0:09:38.20,Default,,0,0,0,,Ол құбыжық – «басқа жан».
Dialogue: 0,0:09:38.70,0:09:41.53,Default,,0,0,0,,Адамның жағымсыз қалдық ойларының жинағы
Dialogue: 0,0:09:41.62,0:09:42.91,Default,,0,0,0,,Жиренішті
Dialogue: 0,0:09:43.87,0:09:46.16,Default,,0,0,0,,Мен оны кездейсоқ фотоға түсіріп алдым.
Dialogue: 0,0:09:46.25,0:09:47.29,Default,,0,0,0,,Оның бар болуы
Dialogue: 0,0:09:47.37,0:09:50.50,Default,,0,0,0,,Бұл Лу сиқырлы түрде түсірген пішінге айналды ма?
Dialogue: 0,0:09:50.59,0:09:53.80,Default,,0,0,0,,Lou Бұл камерада ақау болуы керек.
Dialogue: 0,0:09:53.88,0:09:54.59,Default,,0,0,0,,Сөндіру
Dialogue: 0,0:09:54.67,0:09:57.47,Default,,0,0,0,,Мен... жек көремін. Мен енді ешқашан суретке түсе алмайтын шығармын.
Dialogue: 0,0:09:57.55,0:10:00.39,Default,,0,0,0,,Мен мұны плакат жасап, бөлмеме іліп қоямын.
Dialogue: 0,0:10:00.47,0:10:02.35,Default,,0,0,0,,Ғарыштан келген хабаршы болуы керек
Dialogue: 0,0:10:02.43,0:10:04.47,Default,,0,0,0,,4-өлшемнен хабар
Dialogue: 0,0:10:04.56,0:10:06.02,Default,,0,0,0,,Менің жүрегім ыстық!
Dialogue: 0,0:10:06.10,0:10:06.60,Default,,0,0,0,,Күте тұрыңыз…
Dialogue: 0,0:10:06.68,0:10:11.19,Default,,0,0,0,,Лу осылай дейді, бірақ ол елес сияқты~
Dialogue: 0,0:10:11.27,0:10:13.48,Default,,0,0,0,,Мен бүгін қорқып ұйықтай алмайтын шығармын.
Dialogue: 0,0:10:14.19,0:10:14.82,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:10:15.48,0:10:18.49,Default,,0,0,0,,Басқа рухтардың адамдарға қарсы сыртқы шабуыл күші жоқ, бірақ
Dialogue: 0,0:10:18.57,0:10:19.95,Default,,0,0,0,,Иеленген түрі
Dialogue: 0,0:10:20.45,0:10:22.99,Default,,0,0,0,,Егер сіз оны сол күйінде қалдырсаңыз, рудың ішінен.
Dialogue: 0,0:10:23.08,0:10:25.95,Default,,0,0,0,,Мен сенің энергияңды ақырын жұтып, өсемін.
Dialogue: 0,0:10:27.00,0:10:29.00,Default,,0,0,0,,Мен оны қуып, әйтеуір қуып шығуым керек.
Dialogue: 0,0:10:29.50,0:10:30.58,Default,,0,0,0,,Не істеу керек? Мацури
Dialogue: 0,0:10:31.63,0:10:32.63,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:33.59,0:10:35.17,Default,,0,0,0,,Ах Лу
Dialogue: 0,0:10:35.25,0:10:38.01,Default,,0,0,0,,Менің Лудың манга жинағын қараңыз.
Dialogue: 0,0:10:38.09,0:10:40.13,Default,,0,0,0,,Ах, мен де!
Dialogue: 0,0:10:40.22,0:10:43.01,Default,,0,0,0,,Мен сіздің үйіңізге біраз уақыттан кейін бірінші рет барғым келеді.
Dialogue: 0,0:10:43.10,0:10:44.43,Default,,0,0,0,,Кенеттен
Dialogue: 0,0:10:44.51,0:10:46.39,Default,,0,0,0,,Бұл жақсы, жақсы!
Dialogue: 0,0:10:46.47,0:10:49.77,Default,,0,0,0,,Әйтеуір, бүгін кешке пижама кешін өткізейік.
Dialogue: 0,0:10:49.85,0:10:51.60,Default,,0,0,0,,Сонда бұл қорқынышты емес
Dialogue: 0,0:10:51.69,0:10:52.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:53.15,0:10:54.07,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:54.90,0:10:58.03,Default,,0,0,0,,Бұл жақсы. Ертең бәрібір менің демалыс күнім.
Dialogue: 0,0:11:00.03,0:11:02.66,Default,,0,0,0,,Мацури мырзамен бірінші рет кездесіп отырсыз.
Dialogue: 0,0:11:02.74,0:11:06.62,Default,,0,0,0,,Үйіміз кең, сондықтан бәріміз бірге шомылайық.
Dialogue: 0,0:11:06.70,0:11:09.50,Default,,0,0,0,,Бәріміз шомылайық~? (Ерлер мерекесі) Барлығымыз шомылайық~?
Dialogue: 0,0:11:11.83,0:11:14.46,Default,,0,0,0,,Ұятсыз алдын ала ескерту
Dialogue: 0,0:11:19.09,0:11:20.05,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:20.13,0:11:23.26,Default,,0,0,0,,Я~ Барлығымыз шомылуды асыға күтеміз~
Dialogue: 0,0:11:23.84,0:11:26.18,Default,,0,0,0,,Бәріміз арқамызды жуамыз ба?
Dialogue: 0,0:11:26.26,0:11:28.31,Default,,0,0,0,,Ой, жоқ, бұл жаман. Бұл шынымен де жаман.
Dialogue: 0,0:11:28.39,0:11:31.89,Default,,0,0,0,,Таза нин болып үйге барсаң да, шомылу жаман!
Dialogue: 0,0:11:31.98,0:11:34.19,Default,,0,0,0,,Ах, мен сені алып кетуге келдім (Мари) О...
Dialogue: 0,0:11:37.73,0:11:39.57,Default,,0,0,0,,өте ұзақ!
Dialogue: 0,0:11:39.65,0:11:42.70,Default,,0,0,0,,Лу өте жас ханым, солай емес пе?
Dialogue: 0,0:11:46.20,0:11:50.12,Default,,0,0,0,,Уау, бұл көліктің ішінде!
Dialogue: 0,0:11:50.20,0:11:51.83,Default,,0,0,0,,Басында солай болды.
Dialogue: 0,0:11:53.29,0:11:54.29,Default,,0,0,0,,Ішкім келеді ме?
Dialogue: 0,0:11:54.38,0:11:55.71,Default,,0,0,0,,Іш!
Dialogue: 0,0:11:55.79,0:11:58.50,Default,,0,0,0,,Тым қызық
Dialogue: 0,0:11:58.59,0:11:59.21,Default,,0,0,0,,Nu
Dialogue: 0,0:11:59.30,0:12:00.92,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:12:01.51,0:12:02.63,Default,,0,0,0,,Мацури
Dialogue: 0,0:12:02.72,0:12:04.14,Default,,0,0,0,,Бөтен рухтарды қалай қуу керек
Dialogue: 0,0:12:04.22,0:12:07.26,Default,,0,0,0,,Иеленген адам ұйықтағаннан кейін ыңғайлы.
Dialogue: 0,0:12:07.76,0:12:10.43,Default,,0,0,0,,Сондықтан оған дейін күтуіміз керек.
Dialogue: 0,0:12:10.93,0:12:13.10,Default,,0,0,0,,Мен сенемін, бірақ
Dialogue: 0,0:12:13.19,0:12:14.90,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:14.98,0:12:17.48,Default,,0,0,0,,Екеуміз жақсы доспыз ғой.
Dialogue: 0,0:12:17.57,0:12:18.69,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:22.15,0:12:25.03,Default,,0,0,0,,Уақытыңызды алыңыз, ханымдар.
Dialogue: 0,0:12:25.61,0:12:28.24,Default,,0,0,0,,Уау! Ашық монша Анжан
Dialogue: 0,0:12:28.33,0:12:30.04,Default,,0,0,0,,Жапондық ыстық бұлақтың әуесқойы
Dialogue: 0,0:12:30.12,0:12:31.79,Default,,0,0,0,,Әке, мен бұған ерекше мән беремін.
Dialogue: 0,0:12:32.79,0:12:34.25,Default,,0,0,0,,Біз кіреміз бе?
Dialogue: 0,0:12:34.33,0:12:36.75,Default,,0,0,0,,Жоқ, ол тым тез ашылды!
Dialogue: 0,0:12:36.83,0:12:39.09,Default,,0,0,0,,Үлкен зәулім сарай, үйші, т.б.
Dialogue: 0,0:12:39.17,0:12:42.21,Default,,0,0,0,,Менің жауап беруге уақытым жоқ, алдымен жуынып алайық.
Dialogue: 0,0:12:42.30,0:12:44.22,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:12:44.30,0:12:45.13,Default,,0,0,0,,А...
Dialogue: 0,0:12:46.39,0:12:48.14,Default,,0,0,0,,Алдымен ваннаны қабылдаған дұрыс
Dialogue: 0,0:12:48.22,0:12:51.06,Default,,0,0,0,,Кейінірек демалуға болады, Мацури мырза.
Dialogue: 0,0:12:52.85,0:12:53.77,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:12:53.85,0:12:56.56,Default,,0,0,0,,Қыздармен бірге кіре алмаймын ғой...
Dialogue: 0,0:12:58.15,0:13:00.61,Default,,0,0,0,,Ой... Мен мұны кейінірек істей аламын деп ойлаймын.
Dialogue: 0,0:13:02.94,0:13:05.86,Default,,0,0,0,,Бірдеңе болып қалса, Мариге хабарласамын.
Dialogue: 0,0:13:06.74,0:13:08.49,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін, Мацури
Dialogue: 0,0:13:08.57,0:13:09.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:12.45,0:13:15.37,Default,,0,0,0,,Осы уақытқа дейін келгенім ұят болса, не істеуім керек?
Dialogue: 0,0:13:15.46,0:13:19.00,Default,,0,0,0,,Енді шынайы жалаңаш қарым-қатынастың уақыты келді.
Dialogue: 0,0:13:19.08,0:13:21.80,Default,,0,0,0,,Гүлдің, құстың, жел мен айдың достығын тереңдету
Dialogue: 0,0:13:21.88,0:13:25.09,Default,,0,0,0,,Яйорудың көзі, құмарлығы...
Dialogue: 0,0:13:25.59,0:13:27.76,Default,,0,0,0,,Әй, шеш! Оны шешіңіз!
Dialogue: 0,0:13:27.84,0:13:29.26,Default,,0,0,0,,Бұл да бір нүкте
Dialogue: 0,0:13:29.35,0:13:31.43,Default,,0,0,0,,А, міне, тоқта...
Dialogue: 0,0:13:31.51,0:13:32.72,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:13:33.93,0:13:36.23,Default,,0,0,0,,Белдіктің түрі осылай болды
Dialogue: 0,0:13:36.31,0:13:37.69,Default,,0,0,0,,Бір минут, Ұсуке.
Dialogue: 0,0:13:37.77,0:13:40.77,Default,,0,0,0,,Түсіндім, өзің шеш!
Dialogue: 0,0:13:46.53,0:13:49.62,Default,,0,0,0,,Мацури асығыңыз! Сіз бәрін дұрыс жудыңыз ба?
Dialogue: 0,0:13:49.70,0:13:51.03,Default,,0,0,0,,Мен оны жудым!
Dialogue: 0,0:13:54.83,0:13:55.37,Default,,0,0,0,,Мацури…
Dialogue: 0,0:13:55.45,0:13:56.33,Default,,0,0,0,,Ha
Dialogue: 0,0:13:56.41,0:13:59.17,Default,,0,0,0,,Қыздар міндетті түрде көрмеуі керек.
Dialogue: 0,0:13:59.25,0:14:00.84,Default,,0,0,0,,Мен... білемін.
Dialogue: 0,0:14:10.09,0:14:13.56,Default,,0,0,0,,Сіз оны әлі қуып жібере алмайсыз, солай ма? Бұл Лу
Dialogue: 0,0:14:13.64,0:14:16.89,Default,,0,0,0,,Маған дайындалу керек, бірақ қазір істей алмаймын.
Dialogue: 0,0:14:20.77,0:14:21.56,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:14:22.90,0:14:27.07,Default,,0,0,0,,Маримен тағы да осылай шомылатыныма сене алар емеспін.
Dialogue: 0,0:14:27.15,0:14:30.16,Default,,0,0,0,,О, бұл мұраға қалдырылған шиыршық.
Dialogue: 0,0:14:31.37,0:14:32.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:32.41,0:14:34.24,Default,,0,0,0,,Мацуриге қарама!
Dialogue: 0,0:14:36.45,0:14:37.04,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:37.12,0:14:40.12,Default,,0,0,0,,(Басқа жанның айқайы)
Dialogue: 0,0:14:40.21,0:14:41.08,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:14:41.75,0:14:43.75,Default,,0,0,0,,Тек жасырыну
Dialogue: 0,0:14:43.84,0:14:46.51,Default,,0,0,0,,Ақылсыз, өсіп жатыр.
Dialogue: 0,0:14:46.59,0:14:49.68,Default,,0,0,0,,Ахаха! Сіз қазірдің өзінде не істеп жатырсыз?
Dialogue: 0,0:14:49.76,0:14:51.97,Default,,0,0,0,,Екеуің жақсы араласасыңдар.
Dialogue: 0,0:14:52.05,0:14:53.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:54.85,0:14:55.60,Default,,0,0,0,,Не!
Dialogue: 0,0:14:55.68,0:14:57.60,Default,,0,0,0,,Нонононо... Мен қызып кетемін, өйткені мен ыстықпын!
Dialogue: 0,0:14:57.68,0:15:00.81,Default,,0,0,0,,Ал... Мацури! Ал, қазіргі жағдай форс-мажорлық жағдайға байланысты...
Dialogue: 0,0:15:00.90,0:15:04.11,Default,,0,0,0,,Сузу Қорқынышты бала!
Dialogue: 0,0:15:04.19,0:15:07.03,Default,,0,0,0,,Бұл жолы мен шиыршықты нысанаға алуға мүмкіндік алдым.
Dialogue: 0,0:15:07.11,0:15:09.40,Default,,0,0,0,,Мені таң қалдырды.
Dialogue: 0,0:15:10.91,0:15:14.87,Default,,0,0,0,,Солай болса да, бұл өте жағымсыз көрініс.
Dialogue: 0,0:15:15.87,0:15:19.96,Default,,0,0,0,,Бірақ қазір менің сиқырлы күштерім жабылғандықтан,
Dialogue: 0,0:15:20.04,0:15:23.88,Default,,0,0,0,,Тіпті бөтен жандардың ол деңгейінде де аң аулау мүмкін емес.
Dialogue: 0,0:15:23.96,0:15:25.50,Default,,0,0,0,,Қандай ұят!
Dialogue: 0,0:15:26.09,0:15:27.13,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:27.21,0:15:28.30,Default,,0,0,0,,Уф
Dialogue: 0,0:15:29.30,0:15:31.30,Default,,0,0,0,,Лу! Сенімен бәрі жақсы ма?
Dialogue: 0,0:15:31.38,0:15:35.14,Default,,0,0,0,,өтіңіз... Менде бәрі жақсы. Менің басым айналып кетті...
Dialogue: 0,0:15:35.22,0:15:39.31,Default,,0,0,0,,Ей, мен оның физикалық күшін бұдан былай пайдалануын тоқтатуым керек.
Dialogue: 0,0:15:39.85,0:15:42.69,Default,,0,0,0,,Бүгін моншадан шығып, ерте демалу керек.
Dialogue: 0,0:15:43.27,0:15:48.03,Default,,0,0,0,,Я...бірақ мен Мацури мырзаға манга топтамамды көрсетуім керек.
Dialogue: 0,0:15:48.53,0:15:51.07,Default,,0,0,0,,Мұны істеу үшін өзіңізді жақсы сезінгенше күте аласыз.
Dialogue: 0,0:15:51.15,0:15:53.45,Default,,0,0,0,,Лудың денесі маңыздырақ!
Dialogue: 0,0:15:55.37,0:15:57.74,Default,,0,0,0,,Керемет...
Dialogue: 0,0:15:57.83,0:15:58.87,Default,,0,0,0,,Лу!
Dialogue: 0,0:15:58.95,0:16:00.08,Default,,0,0,0,,Тек берік бол!
Dialogue: 0,0:16:00.16,0:16:01.96,Default,,0,0,0,,Үйдегілерге айтуым керек!
Dialogue: 0,0:16:07.50,0:16:11.13,Default,,0,0,0,,Мен оны Мацури мырзаға көрсетуді ойладым.
Dialogue: 0,0:16:11.22,0:16:12.55,Default,,0,0,0,,Лу жинағы
Dialogue: 0,0:16:14.68,0:16:16.26,Default,,0,0,0,,Иә? Мұнда...
Dialogue: 0,0:16:17.43,0:16:19.72,Default,,0,0,0,,Бұл Лудың кітапханасы.
Dialogue: 0,0:16:19.81,0:16:23.69,Default,,0,0,0,,Иә, мен оны Мацури мырзаға көрсетуді жоспарлап едім.
Dialogue: 0,0:16:23.77,0:16:25.52,Default,,0,0,0,,Мұндағы қазыналар
Dialogue: 0,0:16:30.65,0:16:33.99,Default,,0,0,0,,Мацури мырза көп нәрсені түсінеді деп ойлаймын.
Dialogue: 0,0:16:34.49,0:16:38.33,Default,,0,0,0,,Иә? Ойлап қарасаңыз, бәрі қайда кетті?
Dialogue: 0,0:16:39.03,0:16:40.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:42.00,0:16:44.37,Default,,0,0,0,,(Басқа жанның ырылдаған дауысы)
Dialogue: 0,0:16:44.46,0:16:45.04,Default,,0,0,0,,Уау
Dialogue: 0,0:16:50.96,0:16:51.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:53.30,0:16:54.88,Default,,0,0,0,,Лу қатты ауырады
Dialogue: 0,0:16:55.38,0:16:58.60,Default,,0,0,0,,Үйдегі адамдардан сподори бар ма деп сұраймын.
Dialogue: 0,0:16:58.68,0:16:59.35,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:16:59.43,0:17:01.27,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:01.35,0:17:02.68,Default,,0,0,0,,Мацури (Мари) Иә
Dialogue: 0,0:17:02.77,0:17:04.06,Default,,0,0,0,,Кию
Dialogue: 0,0:17:07.15,0:17:08.56,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:17:09.15,0:17:11.53,Default,,0,0,0,,Сәл шыдамдылық таныт, Лу.
Dialogue: 0,0:17:17.61,0:17:19.28,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:19.87,0:17:23.04,Default,,0,0,0,,Omaenookage…
Dialogue: 0,0:17:23.12,0:17:26.04,Default,,0,0,0,,Ұлы Чикнатта
Dialogue: 0,0:17:26.54,0:17:30.54,Default,,0,0,0,,Омаэно өмірі... Дәмді
Dialogue: 0,0:17:31.05,0:17:34.67,Default,,0,0,0,,Мотт Йокосе~!
Dialogue: 0,0:17:34.76,0:17:36.59,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:17:36.68,0:17:38.47,Default,,0,0,0,,Гяаа~!
Dialogue: 0,0:17:42.85,0:17:45.23,Default,,0,0,0,,А... бұл кім?
Dialogue: 0,0:17:46.48,0:17:47.06,Default,,0,0,0,,Kiii~
Dialogue: 0,0:17:47.14,0:17:49.06,Default,,0,0,0,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:17:49.15,0:17:50.81,Default,,0,0,0,,(Өзге жанның айқайы)
Dialogue: 0,0:17:53.90,0:17:54.99,Default,,0,0,0,,Гаа~!
Dialogue: 0,0:17:58.74,0:18:01.20,Default,,0,0,0,,Жиі~!
Dialogue: 0,0:18:03.04,0:18:03.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:07.16,0:18:11.00,Default,,0,0,0,,Иә? Жел диірмені Мацури мырза...
Dialogue: 0,0:18:11.63,0:18:13.05,Default,,0,0,0,,Не?
Dialogue: 0,0:18:15.84,0:18:19.64,Default,,0,0,0,,Мынаны аузыма сал дейсің бе?
Dialogue: 0,0:18:27.73,0:18:31.11,Default,,0,0,0,,Жан күшімді жел диірменіне салуға уақытым таусылды.
Dialogue: 0,0:18:34.57,0:18:35.69,Default,,0,0,0,,Күте тұрыңыз, Лу.
Dialogue: 0,0:18:36.19,0:18:39.36,Default,,0,0,0,,Мен оны қазір желмен сорамын.
Dialogue: 0,0:18:40.16,0:18:42.57,Default,,0,0,0,,Тазарту Ninja Technique Impure Fan!
Dialogue: 0,0:18:45.83,0:18:49.58,Default,,0,0,0,,(Өзге жанның айқайы)
Dialogue: 0,0:19:00.84,0:19:02.76,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:19:02.85,0:19:05.68,Default,,0,0,0,,(Өзге жанның айқайы)
Dialogue: 0,0:19:12.44,0:19:15.57,Default,,0,0,0,,Мені қуып жібердің бе?
Dialogue: 0,0:19:17.86,0:19:18.61,Default,,0,0,0,,Ум...
Dialogue: 0,0:19:25.70,0:19:26.87,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:19:26.95,0:19:28.66,Default,,0,0,0,,Жақсы болды.
Dialogue: 0,0:19:28.75,0:19:31.33,Default,,0,0,0,,Түнгі ұйқыдан кейін өңіңіз қалыпқа келеді.
Dialogue: 0,0:19:31.42,0:19:32.46,Default,,0,0,0,,Лу?
Dialogue: 0,0:19:33.00,0:19:35.00,Default,,0,0,0,,Мен біртүрлі түс көрдім
Dialogue: 0,0:19:35.09,0:19:38.63,Default,,0,0,0,,Жұмбақ ниндзя баласы елестерді жеңетін түс
Dialogue: 0,0:19:38.71,0:19:40.34,Default,,0,0,0,,Хаха, солай.
Dialogue: 0,0:19:42.43,0:19:44.76,Default,,0,0,0,,Жел диірменіне салған жан қуатым
Dialogue: 0,0:19:44.85,0:19:47.39,Default,,0,0,0,,Өйткені ол менің денеме аздап кірді.
Dialogue: 0,0:19:48.10,0:19:51.69,Default,,0,0,0,,Бұл менің жүрегім әлі де еркектікін білдіре ме?
Dialogue: 0,0:19:52.27,0:19:53.15,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:53.23,0:19:57.15,Default,,0,0,0,,Мен оны бір жерден көргендей сезінемін, бірақ бұл кім екен деп ойлаймын.
Dialogue: 0,0:19:57.86,0:19:59.90,Default,,0,0,0,,Бұл тамаша болды.
Dialogue: 0,0:20:01.20,0:20:04.99,Default,,0,0,0,,Бұл сіз бұрыннан көрген манга кейіпкері емес пе?
Dialogue: 0,0:20:05.07,0:20:06.91,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:20:06.99,0:20:08.37,Default,,0,0,0,,Бірақ елестер
Dialogue: 0,0:20:08.45,0:20:10.91,Default,,0,0,0,,Мен бұл фотодағыдай сезінемін.
Dialogue: 0,0:20:11.00,0:20:13.83,Default,,0,0,0,,Ах! Елес кетті
Dialogue: 0,0:20:13.92,0:20:15.04,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:20:15.13,0:20:17.59,Default,,0,0,0,,Бұл тек Суджимори мырза.
Dialogue: 0,0:20:17.67,0:20:20.26,Default,,0,0,0,,Бұл жай ғана суреттегі қате емес пе?
Dialogue: 0,0:20:20.34,0:20:22.88,Default,,0,0,0,,Қарғыс атсын... Кешіріңіз.
Dialogue: 0,0:20:22.97,0:20:26.51,Default,,0,0,0,,Жақсы. Мацури мырзаның жүзін әдемі суретке түсіре алдым.
Dialogue: 0,0:20:26.60,0:20:27.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:28.97,0:20:31.43,Default,,0,0,0,,Лимузин жүретін уақыт емес пе?
Dialogue: 0,0:20:31.52,0:20:34.69,Default,,0,0,0,,Ең жақсысы - ол сонша жоғары көтеріліп, сілекейіңіз ағып жатқанда.
Dialogue: 0,0:20:34.77,0:20:36.19,Default,,0,0,0,,Әй, эй... Өшір!
Dialogue: 0,0:20:36.27,0:20:38.73,Default,,0,0,0,,Бұл өте қызық, маған жібер
Dialogue: 0,0:20:38.82,0:20:40.28,Default,,0,0,0,,Мен де соны қалаймын!
Dialogue: 0,0:20:40.36,0:20:41.40,Default,,0,0,0,,Жіберу
Dialogue: 0,0:20:41.49,0:20:43.65,Default,,0,0,0,,Вааааа~ Тоқта!
Dialogue: 0,0:20:43.74,0:20:45.49,Default,,0,0,0,,Ммм~
Dialogue: 0,0:20:46.53,0:20:48.74,Default,,0,0,0,,Бұл сөзсіз ең жақсысы
Dialogue: 0,0:20:48.83,0:20:50.79,Default,,0,0,0,,Қызық емес!
Dialogue: 0,0:20:51.37,0:20:52.87,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:20:53.41,0:20:55.54,Default,,0,0,0,,Ұятсыз жүз жасауды доғарамыз ба?
Dialogue: 0,0:20:55.62,0:20:56.42,Default,,0,0,0,,А…?
Dialogue: 0,0:21:00.00,0:21:01.26,Default,,0,0,0,,Эххе
Dialogue: 0,0:21:02.17,0:21:03.22,Default,,0,0,0,,Лу
Dialogue: 0,0:21:04.34,0:21:07.18,Default,,0,0,0,,Бұл пижама кешінің кезекті кек алуы.
Dialogue: 0,0:21:07.26,0:21:09.26,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:21:09.89,0:21:11.89,Default,,0,0,0,,Діни әйел?
Dialogue: 0,0:21:11.97,0:21:14.85,Default,,0,0,0,,Хмм, мен шынымен түсінбеймін.
Dialogue: 0,0:21:15.44,0:21:18.52,Default,,0,0,0,,Бірақ егер Сузу жындарды көре алатын адам болса.
Dialogue: 0,0:21:18.61,0:21:19.98,Default,,0,0,0,,Мен сізді жақсы білемін.
Dialogue: 0,0:21:20.61,0:21:23.07,Default,,0,0,0,,Мен көп ойнайтынмын.
Dialogue: 0,0:21:23.15,0:21:25.70,Default,,0,0,0,,Ааа~ Қазір басқаша ма?
Dialogue: 0,0:21:26.28,0:21:28.03,Default,,0,0,0,,Менімен бірге болған Мари
Dialogue: 0,0:21:28.12,0:21:30.95,Default,,0,0,0,,«Сузудан аулақ бол!» дедім.
Dialogue: 0,0:21:31.45,0:21:33.70,Default,,0,0,0,,Адамдар өзімшіл адамдар.
Dialogue: 0,0:21:33.79,0:21:35.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:36.54,0:21:38.92,Default,,0,0,0,,Маған көп нәрсені білгеніңіз үшін рахмет.
Dialogue: 0,0:21:39.00,0:21:42.63,Default,,0,0,0,,Мұны келуіңіздің белгісі ретінде пайдаланыңыз.
Dialogue: 0,0:21:45.09,0:21:45.97,Default,,0,0,0,,Хмм?
Dialogue: 0,0:21:47.47,0:21:49.22,Default,,0,0,0,,Тым шынайы және қорқынышты
Dialogue: 0,0:21:50.47,0:21:52.76,Default,,0,0,0,,Текстураға ерекше мән берсем де!
Dialogue: 0,0:21:53.27,0:21:55.68,Default,,0,0,0,,Айтпақшы, сен кімсің?
Dialogue: 0,0:21:55.77,0:21:58.48,Default,,0,0,0,,Бұл жерде сіз көрмеген бет бар.
Dialogue: 0,0:21:58.56,0:21:59.48,Default,,0,0,0,,О
Dialogue: 0,0:22:00.73,0:22:04.44,Default,,0,0,0,,Ол ешқашан саяхаттамайтын суретші.
Dialogue: 0,0:22:05.94,0:22:07.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.86,0:23:34.87,Default,,0,0,0,,～♪
