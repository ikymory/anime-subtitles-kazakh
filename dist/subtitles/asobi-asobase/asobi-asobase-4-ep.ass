Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:41.70,0:01:43.70,Default,,0,0,0,,｟Ханако: Эй Маэда, бұл не?
Dialogue: 0,0:01:43.70,0:01:46.20,Default,,0,0,0,,Бұл менің немеремнің қолы.
Dialogue: 0,0:01:46.20,0:01:49.37,Default,,0,0,0,,Оны қалай пайдаланамын? Осылай...
Dialogue: 0,0:01:49.37,0:01:51.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:51.54,0:01:55.04,Default,,0,0,0,,Керемет! Маэда бәрін біледі! ｠
Dialogue: 0,0:01:55.04,0:01:57.05,Default,,0,0,0,,《Мен Ханако-самамын➡
Dialogue: 0,0:01:57.05,0:01:59.88,Default,,0,0,0,,Мен саған бәрін үйретуім керек.
Dialogue: 0,0:01:59.88,0:02:04.15,Default,,0,0,0,,Сіз ешқашан Ханако-самаға «білмеймін» деп айтпауыңыз керек.
Dialogue: 0,0:02:04.15,0:02:06.66,Default,,0,0,0,,Сондықтан ол кезде...》 ｟Эй, Маэда.
Dialogue: 0,0:02:06.66,0:02:10.16,Default,,0,0,0,,Бұл не, Ханако-сама? Шоги дегеніміз не?
Dialogue: 0,0:02:10.16,0:02:12.16,Default,,0,0,0,,Аа….
Dialogue: 0,0:02:12.16,0:02:17.00,Default,,0,0,0,,[Шоги – қарсыластың патшасын алу үшін фигураларды жылжытатын ойын.\NМен оны
Dialogue: 0,0:02:17.00,0:02:21.67,Default,,0,0,0,,деп түсіндіре алғым келеді, бірақ мен мүмкін емес.
Dialogue: 0,0:02:21.67,0:02:23.67,Default,,0,0,0,,Егер... десем...》
Dialogue: 0,0:02:23.67,0:02:28.34,Default,,0,0,0,,Олай болса маған сол ойын туралы айтып бер. ''Ханако-сама осылай айтар еді''
Dialogue: 0,0:02:28.34,0:02:35.02,Default,,0,0,0,,Бірақ... мен шоги ережесін білмеймін.
Dialogue: 0,0:02:35.02,0:02:38.19,Default,,0,0,0,,Сонымен...》 Эй, эй, шоги деген не?
Dialogue: 0,0:02:38.19,0:02:41.36,Default,,0,0,0,,Бұл бөкседен сәуле шығатын жарыс.
Dialogue: 0,0:02:41.36,0:02:43.56,Default,,0,0,0,,Байқап көріңіз! иә.
Dialogue: 0,0:02:45.53,0:02:48.53,Default,,0,0,0,,Эй Маэда-сан, сен не істеп жатырсың!? ? ｠
Dialogue: 0,0:02:48.53,0:02:51.70,Default,,0,0,0,,《Одан кейін Ханако-сама➡
Dialogue: 0,0:02:51.70,0:02:54.04,Default,,0,0,0,,Ол мені жиі ренжіте бастады》
Dialogue: 0,0:02:54.04,0:02:56.37,Default,,0,0,0,,｟Эй, Маэда, шоги ойнайық! ｠
Dialogue: 0,0:02:56.37,0:03:00.98,Default,,0,0,0,,｟Бөмсегімнен сәуле жібермейінше, мен ұйықтай алмаймын｠
Dialogue: 0,0:03:00.98,0:03:04.48,Default,,0,0,0,,｟Маэда Мен сәулені көрдім! ｠
Dialogue: 0,0:03:04.48,0:03:10.65,Default,,0,0,0,,《Алайда шамамен бір апта бұрын Ханако-саманың көзқарасы кенет өзгерді.》
Dialogue: 0,0:03:10.65,0:03:13.32,Default,,0,0,0,,｟Аа, сәулені жіберу жеткілікті｠
Dialogue: 0,0:03:13.32,0:03:16.32,Default,,0,0,0,,｟Ей, сенің ішіңде не болып жатыр? ｠
Dialogue: 0,0:03:16.32,0:03:20.33,Default,,0,0,0,,｜Мен сізге оны хирургиялық жолмен алып тастау үшін төлеймін｠
Dialogue: 0,0:03:20.33,0:03:22.83,Default,,0,0,0,,Құрметті Ханако... 1 апта бұрын➡
Dialogue: 0,0:03:22.83,0:03:25.83,Default,,0,0,0,,Бөкседен нұр Мен қуандым.
Dialogue: 0,0:03:25.83,0:03:28.34,Default,,0,0,0,,《Кентаро: Мен бұған бір апта бұрын қуаныштымын➡
Dialogue: 0,0:03:28.34,0:03:30.34,Default,,0,0,0,,Мен әпкемнің психикалық денсаулығына қатты алаңдаймын.
Dialogue: 0,0:03:30.34,0:03:33.68,Default,,0,0,0,,Хмм... Қайтадан қош келдіңіз, Кентаро-сама.
Dialogue: 0,0:03:33.68,0:03:37.18,Default,,0,0,0,,Айтпақшы, Ханако-сама қолшатырын алып кетті ме?
Dialogue: 0,0:03:37.18,0:03:40.68,Default,,0,0,0,,Ал... ауа райы болжамы бүгін күн ашық болатынын айтты➡
Dialogue: 0,0:03:40.68,0:03:43.35,Default,,0,0,0,,Сізде жоқ, солай ма?
Dialogue: 0,0:03:43.35,0:03:47.19,Default,,0,0,0,,Жүргізуші куәлігім болмағандықтан, мен сені жаяу алып кетемін.
Dialogue: 0,0:03:47.19,0:03:50.69,Default,,0,0,0,,《Бұл адам менің үйімде бұрыннан бар, бірақ не істейді екен деп ойлаймын.》
Dialogue: 0,0:03:52.69,0:03:55.86,Default,,0,0,0,,А, мен қолшатыр әкелген жоқпын.
Dialogue: 0,0:03:55.86,0:03:57.87,Default,,0,0,0,,Ханако мен Касуми ше?
Dialogue: 0,0:03:57.87,0:04:00.30,Default,,0,0,0,,Мен әрқашан жиналмалы қолшатырды алып жүремін.
Dialogue: 0,0:04:00.30,0:04:02.47,Default,,0,0,0,,Ханако ше? Мен ұмыттым.
Dialogue: 0,0:04:02.47,0:04:04.81,Default,,0,0,0,,Не істеу керек? Хмм.
Dialogue: 0,0:04:04.81,0:04:08.14,Default,,0,0,0,,Сіз қоқыс салатын дорбаны киесіз бе? (2 адам) Ух...
Dialogue: 0,0:04:08.14,0:04:10.65,Default,,0,0,0,,《Ханако...ол бай адамға ұқсайды➡
Dialogue: 0,0:04:10.65,0:04:13.65,Default,,0,0,0,,Неліктен идеялар соншалықты кедей?
Dialogue: 0,0:04:13.65,0:04:17.15,Default,,0,0,0,,W-Менің қолшатырымның астына үш адам сыйдыра ма?
Dialogue: 0,0:04:17.15,0:04:19.82,Default,,0,0,0,,Жоқ, оны үш адамға бүктеу қиын болады деп ойлаймын.
Dialogue: 0,0:04:19.82,0:04:23.49,Default,,0,0,0,,А, біреу маған қолшатыр бере алады ма?
Dialogue: 0,0:04:23.49,0:04:25.49,Default,,0,0,0,,Ханако ханым. Гах! (2 адам) Әй! ?
Dialogue: 0,0:04:25.49,0:04:30.17,Default,,0,0,0,,бұл... Ханако-чан! Мені осымен пышақтап, тез, тез істе!
Dialogue: 0,0:04:30.17,0:04:33.67,Default,,0,0,0,,Касуми-сан, сабыр ет!
Dialogue: 0,0:04:33.67,0:04:37.01,Default,,0,0,0,,Бұл адам үйде жұмыс істейді➡
Dialogue: 0,0:04:37.01,0:04:40.01,Default,,0,0,0,,Бір нәрсе. Бұл Маэда. 《Не нәрсе? 》
Dialogue: 0,0:04:40.01,0:04:43.35,Default,,0,0,0,,Құрметті Ханако, мен сізге қолшатыр әкелдім. Ах, рахмет.
Dialogue: 0,0:04:43.35,0:04:45.35,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:04:45.35,0:04:49.35,Default,,0,0,0,,Касуми-сан, жақсысың ба? Кешіріңіз, кешіріңіз!
Dialogue: 0,0:04:49.35,0:04:51.35,Default,,0,0,0,,Маған ер адамдар ұнамайды.
Dialogue: 0,0:04:53.36,0:04:55.52,Default,,0,0,0,,Бұл дұрыс па? Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:04:55.52,0:04:57.53,Default,,0,0,0,,Мен де бұзықтарды ұнатпаймын.
Dialogue: 0,0:04:59.53,0:05:03.80,Default,,0,0,0,,Бұл Ханако-саманың сыныптастары ма? Дұрыс, Оливия мен Касуми.
Dialogue: 0,0:05:03.80,0:05:08.47,Default,,0,0,0,,Оливия... Бұл шетелдік есім. Менің хоббиім шетелге саяхаттау.
Dialogue: 0,0:05:08.47,0:05:10.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:10.64,0:05:12.64,Default,,0,0,0,,Сіз қай елдесіз?
Dialogue: 0,0:05:12.64,0:05:15.34,Default,,0,0,0,,А... бұл құпия.
Dialogue: 0,0:05:17.65,0:05:20.32,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:20.32,0:05:23.82,Default,,0,0,0,,Ханако-саманың кесірінен сыныптастарым менен қорқатын сияқтымын!
Dialogue: 0,0:05:23.82,0:05:26.62,Default,,0,0,0,,Ха! ? Бұл сіздің жеке балықшыл болғандықтан шығар!
Dialogue: 0,0:05:28.66,0:05:30.83,Default,,0,0,0,,Қолшатыр үшін рахмет. Уф.
Dialogue: 0,0:05:30.83,0:05:33.66,Default,,0,0,0,,Ханако әрқашан осындай адамдармен бірге тұрады➡
Dialogue: 0,0:05:33.66,0:05:36.00,Default,,0,0,0,,Сіз шыдамсыз ба? 《Мұндай нәрсе...》
Dialogue: 0,0:05:36.00,0:05:39.17,Default,,0,0,0,,Мен Касуми-санның ер адамдармен соншалықты жаман қарым-қатынаста болады деп күтпедім.
Dialogue: 0,0:05:39.17,0:05:41.67,Default,,0,0,0,,Өйткені... еркектер➡
Dialogue: 0,0:05:41.67,0:05:44.84,Default,,0,0,0,,Ыстық болған кезде иығыңнан бөрене тәрізді бірдеңе шығады деп естідім.
Dialogue: 0,0:05:44.84,0:05:46.84,Default,,0,0,0,,Не? Сіз Касуми-санды білмейсіз бе?
Dialogue: 0,0:05:46.84,0:05:50.35,Default,,0,0,0,,Бөрене бөкседен шығады. иә? Солай ма?
Dialogue: 0,0:05:50.35,0:05:53.01,Default,,0,0,0,,《Білмедім, ұят болды》
Dialogue: 0,0:05:53.01,0:05:55.02,Default,,0,0,0,,Жарайды, кейде шатырды сындырып аламын➡
Dialogue: 0,0:05:55.02,0:05:57.02,Default,,0,0,0,,Бұл өте қауіпті. (2 адам) Әй! ?
Dialogue: 0,0:05:57.02,0:05:59.52,Default,,0,0,0,,Барлығыңыз, кешіккеніңіз үшін кешіріңіз...
Dialogue: 0,0:05:59.52,0:06:01.52,Default,,0,0,0,,Пигья! ДДСҰ?
Dialogue: 0,0:06:06.96,0:06:11.13,Default,,0,0,0,,Чисато~ Көптен бері көрмегелі! Иә, біраз уақыт өтті.
Dialogue: 0,0:06:11.13,0:06:14.64,Default,,0,0,0,,6 жылдай уақыт өтті. Ол мүлдем өзгермейді.
Dialogue: 0,0:06:14.64,0:06:18.14,Default,,0,0,0,,Менің ойымша. Иә, дәл колледжде жүрген кездегідей.
Dialogue: 0,0:06:18.14,0:06:20.64,Default,,0,0,0,,Қалғандарымен не болып жатыр деп ойлаймын.
Dialogue: 0,0:06:20.64,0:06:23.65,Default,,0,0,0,,Аа, мүмкін 60% үйленді.
Dialogue: 0,0:06:23.65,0:06:25.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:25.65,0:06:27.65,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:27.65,0:06:32.15,Default,,0,0,0,,Иә. 《Екі адам: ұзақ күрсіну》
Dialogue: 0,0:06:32.15,0:06:35.49,Default,,0,0,0,,Чиса-чан, сен қыздар орта мектебінде жұмыс істейсің бе? Кездесулер бар ма?
Dialogue: 0,0:06:35.49,0:06:38.16,Default,,0,0,0,,Ер адаммен? Жоқ, жоқ, мүлде емес!
Dialogue: 0,0:06:38.16,0:06:41.50,Default,,0,0,0,,Аа, бірақ мен үйірме жұмыстары бойынша кеңесші болып жұмыс істей бастадым.
Dialogue: 0,0:06:41.50,0:06:44.00,Default,,0,0,0,,Уау, мектеп мұғаліміне ұқсайсың! Қандай клуб қызметі?
Dialogue: 0,0:06:44.00,0:06:47.00,Default,,0,0,0,,Баскетбол? алқап? Үрмелі оркестр немесе хор да қолайлы болады.
Dialogue: 0,0:06:47.00,0:06:50.17,Default,,0,0,0,,Бұл Playboy Study Group деп аталатын клуб.
Dialogue: 0,0:06:50.17,0:06:53.34,Default,,0,0,0,,Иә? Уау... бұл керемет.
Dialogue: 0,0:06:53.34,0:06:56.51,Default,,0,0,0,,Мен де соңғы үш жыл бойы қыздар орта мектебінде жұмыс істеймін.
Dialogue: 0,0:06:56.51,0:06:58.51,Default,,0,0,0,,Иә? Солай ма? қайда?
Dialogue: 0,0:06:58.51,0:07:01.78,Default,,0,0,0,,Әулие ханым академиясы туралы білесіз бе? Білемін, білемін.
Dialogue: 0,0:07:01.78,0:07:03.79,Default,,0,0,0,,Мұнда тек жас ханымдар бар.
Dialogue: 0,0:07:03.79,0:07:08.79,Default,,0,0,0,,Менің мектебімде төрт ойыншының бірі бар.
Dialogue: 0,0:07:08.79,0:07:11.63,Default,,0,0,0,,Келесі кездескенше. Алақай.
Dialogue: 0,0:07:11.63,0:07:19.80,Default,,0,0,0,,♬～
Dialogue: 0,0:07:19.80,0:07:21.80,Default,,0,0,0,,Уф….
Dialogue: 0,0:07:23.81,0:07:26.61,Default,,0,0,0,,《Плейбойлардың төрт аспан патшасы дегеніміз не?》
Dialogue: 0,0:07:28.64,0:07:30.65,Default,,0,0,0,,Ах. (жылжымалы есіктің ашылған дыбысы)
Dialogue: 0,0:07:30.65,0:07:32.65,Default,,0,0,0,,Барлығы~ Кешіктіргеніміз үшін кешіріңіз.
Dialogue: 0,0:07:32.65,0:07:34.82,Default,,0,0,0,,Сіз не істеп жатырсыз? Кемпірді алып тастау.
Dialogue: 0,0:07:34.82,0:07:37.49,Default,,0,0,0,,Аа...
Dialogue: 0,0:07:37.49,0:07:39.65,Default,,0,0,0,,Бәріңе сәлем.
Dialogue: 0,0:07:39.65,0:07:43.66,Default,,0,0,0,,Білесіз бе... Сіз Playboys ойынының төрт аспан патшасын білесіз бе?
Dialogue: 0,0:07:45.66,0:07:49.16,Default,,0,0,0,,Бұл не? сол. А, менің ойымша, бәрі білмейді?
Dialogue: 0,0:07:49.16,0:07:51.17,Default,,0,0,0,,көремін.
Dialogue: 0,0:07:51.17,0:07:54.67,Default,,0,0,0,,Негізі менің ұстазымның бір досы да қыздар орта мектебінде жұмыс істейді.
Dialogue: 0,0:07:54.67,0:07:57.51,Default,,0,0,0,,Өткенде біз алғаш рет кездескен кезде сол қыздың орта мектебіне бардық➡
Dialogue: 0,0:07:57.51,0:08:00.61,Default,,0,0,0,,Плейбойлардың төрт аспан патшасының бірі болған деседі...
Dialogue: 0,0:08:00.61,0:08:04.11,Default,,0,0,0,,《Мұғалім, сенің әдеттен тыс досың бар екенін көріп тұрмын》
Dialogue: 0,0:08:04.11,0:08:06.11,Default,,0,0,0,,Плейбойлардың төрт аспан патшасы қандай?
Dialogue: 0,0:08:06.11,0:08:08.12,Default,,0,0,0,,ақымақ көрінеді. 《Әй! 》
Dialogue: 0,0:08:08.12,0:08:10.12,Default,,0,0,0,,Тек сол адамның миында➡
Dialogue: 0,0:08:10.12,0:08:12.62,Default,,0,0,0,,Ол жоқ па? Мүмкін ➡
Dialogue: 0,0:08:12.62,0:08:17.63,Default,,0,0,0,,Сіздің досыңыз өзінен екі есе жаста Чуунибиоды дамытты ма?
Dialogue: 0,0:08:17.63,0:08:20.63,Default,,0,0,0,,《Оны маған жаман адам айтып жатыр》
Dialogue: 0,0:08:20.63,0:08:24.97,Default,,0,0,0,,Кендаманың ұлттық турнирінде жеңіске жету сияқты стандарт бар емес пе?
Dialogue: 0,0:08:24.97,0:08:26.97,Default,,0,0,0,,Бірақ ойынның түрлері көп емес пе?
Dialogue: 0,0:08:26.97,0:08:28.97,Default,,0,0,0,,Сіз тек Кендаманың көмегімен Төрт Аспан Патшасына кіре аласыз ба?
Dialogue: 0,0:08:28.97,0:08:31.47,Default,,0,0,0,,Тек Кендаманы орындау қиын болуы мүмкін.
Dialogue: 0,0:08:31.47,0:08:33.48,Default,,0,0,0,,Сонда мен қанша жеңуім керек?
Dialogue: 0,0:08:33.48,0:08:35.81,Default,,0,0,0,,Хмм, қызық... 《Бірдеңе➡
Dialogue: 0,0:08:35.81,0:08:39.31,Default,,0,0,0,,Дұрыс клуб жиналысы сияқты》 📱
Dialogue: 0,0:08:39.31,0:08:41.82,Default,,0,0,0,,Иә. 📱 (Андо) А, Чисато? Қазір мектеп пе?
Dialogue: 0,0:08:41.82,0:08:43.82,Default,,0,0,0,,Иә, мен үйірме жұмыстарындамын.
Dialogue: 0,0:08:43.82,0:08:47.16,Default,,0,0,0,,📱Білесіз бе, мен кеше Көктегі Төрт Патша туралы айтқан болатынмын.
Dialogue: 0,0:08:47.16,0:08:49.99,Default,,0,0,0,,Иә. 📱Мен сонда ғана бардым➡
Dialogue: 0,0:08:49.99,0:08:53.16,Default,,0,0,0,,Жақында жетуіміз мүмкін. Эй, түсіндім.
Dialogue: 0,0:08:53.16,0:08:56.83,Default,,0,0,0,,Иә, түсіндім, рахмет.
Dialogue: 0,0:08:56.83,0:08:59.33,Default,,0,0,0,,Аспандағы төрт патша келе жатыр. (3 адам) Әй!
Dialogue: 0,0:08:59.33,0:09:02.94,Default,,0,0,0,,Сіз бұл туралы қазір айтып отырсыз ба? Иә иә.
Dialogue: 0,0:09:02.94,0:09:06.27,Default,,0,0,0,,Айтпақшы, сіз қай мектепте оқисыз? Әулие ханым академиясы.
Dialogue: 0,0:09:06.27,0:09:10.28,Default,,0,0,0,,Уау, мына жақтағы керемет жас ханым! ? Сонда көктегі төрт патша болуы мүмкін!
Dialogue: 0,0:09:10.28,0:09:12.45,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:12.45,0:09:14.78,Default,,0,0,0,,《Ой, мен сенің атыңды атаған бойда сене бастадың➡
Dialogue: 0,0:09:14.78,0:09:16.79,Default,,0,0,0,,Билікке қарсы бәрі әлсіз》
Dialogue: 0,0:09:18.79,0:09:25.63,Default,,0,0,0,,(сағыз дыбысы)
Dialogue: 0,0:09:25.63,0:09:28.63,Default,,0,0,0,,《Су… ғажайып нәрсе келді》
Dialogue: 0,0:09:28.63,0:09:32.47,Default,,0,0,0,,Мм... Бұл көрініс мектеп ережесіне сай ма?
Dialogue: 0,0:09:32.47,0:09:34.47,Default,,0,0,0,,Бұл табиғи шаш.
Dialogue: 0,0:09:34.47,0:09:36.47,Default,,0,0,0,,Көбелектер тірі заттармен байланысады.
Dialogue: 0,0:09:36.47,0:09:38.47,Default,,0,0,0,,《Бұл өтірік! 》
Dialogue: 0,0:09:38.47,0:09:40.48,Default,,0,0,0,,Макияж... Макияжсыз.
Dialogue: 0,0:09:40.48,0:09:42.48,Default,,0,0,0,,《Бұл да өтірік! 》
Dialogue: 0,0:09:42.48,0:09:44.48,Default,,0,0,0,,Сіздің формаңызды кимегеніңізді көріп тұрмын.
Dialogue: 0,0:09:44.48,0:09:46.48,Default,,0,0,0,,Аа, мен түсінбедім.
Dialogue: 0,0:09:46.48,0:09:48.48,Default,,0,0,0,,Бірыңғай форма Оны мектеп ережелеріне сәйкес кию дұрыс емес пе?
Dialogue: 0,0:09:48.48,0:09:50.49,Default,,0,0,0,,《Неге ол жерді тек адалдықпен қорғайсың!? ? 》
Dialogue: 0,0:09:50.49,0:09:55.32,Default,,0,0,0,,Бұл мен, Андо Сенсейдің досы. Иә, Андо-чан.
Dialogue: 0,0:09:55.32,0:09:57.83,Default,,0,0,0,,Бұл азап болды, бірақ менің әлсіздігім ұсталғандықтан келдім.
Dialogue: 0,0:09:57.83,0:10:01.33,Default,,0,0,0,,Мен оны Playboys төрт аспан патшасының бірі деп естідім.
Dialogue: 0,0:10:01.33,0:10:03.33,Default,,0,0,0,,Аа, солай.
Dialogue: 0,0:10:03.33,0:10:06.67,Default,,0,0,0,,Көрші мектеп оқушыларының көпшілігімен жатсам ше?
Dialogue: 0,0:10:06.67,0:10:08.67,Default,,0,0,0,,Мен оны рұқсатсыз осылай атадым.
Dialogue: 0,0:10:08.67,0:10:11.17,Default,,0,0,0,,《Ей, эй, сен Аспандағы Төрт Патшаның бірісің бе?
Dialogue: 0,0:10:11.17,0:10:13.51,Default,,0,0,0,,Ханаконың реакциясы қандай болды? 》
Dialogue: 0,0:10:13.51,0:10:18.68,Default,,0,0,0,,｟Бұл таңқаларлық~ Бұл таңқаларлық~ ｟Жоқ, жоқ, бұл қаншық Қаншық Қаншық...｠
Dialogue: 0,0:10:18.68,0:10:21.52,Default,,0,0,0,,《Менің басымның үстінде екі оғаш жаратылыс бар.
Dialogue: 0,0:10:21.52,0:10:25.19,Default,,0,0,0,,Касумидің жаны аузынан шығып жатыр.
Dialogue: 0,0:10:25.19,0:10:29.02,Default,,0,0,0,,Бірақ сонша ойнасаң, оқуыңа кедергі келтірмей ме?
Dialogue: 0,0:10:29.02,0:10:32.36,Default,,0,0,0,,Иә? Үйде отырып оқу ақсақтық емес пе?
Dialogue: 0,0:10:32.36,0:10:36.36,Default,,0,0,0,,《Ой, сен ақымақсың》 《Дұрыс, сен ақымақ боласың.》
Dialogue: 0,0:10:36.36,0:10:40.54,Default,,0,0,0,,Сабақта бір рет осындай нәрсені тыңдасаңыз, есіңізде қалатын шығар, солай ма?
Dialogue: 0,0:10:40.54,0:10:43.20,Default,,0,0,0,,Өткен күні ұлттық сынақ емтиханында үздік 100-ге кірдім.
Dialogue: 0,0:10:43.20,0:10:46.71,Default,,0,0,0,,｟Шырылдау Мен қызғаныштан жынданып бара жатқандай болдым! ｠
Dialogue: 0,0:10:46.71,0:10:49.88,Default,,0,0,0,,Ке... Сіз Кендаманы ойнай аласыз ба? 《Оливия! ?
Dialogue: 0,0:10:49.88,0:10:52.58,Default,,0,0,0,,Бұдан артықшылыққа ие болу бекер емес пе? ? 》
Dialogue: 0,0:10:58.89,0:11:02.32,Default,,0,0,0,,Оған жай ғана доп қою қызықсыз. Мен көремін...
Dialogue: 0,0:11:02.32,0:11:04.33,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:04.33,0:11:07.50,Default,,0,0,0,,Оливия Касуми-сан, маған да сол макияжды салып бер!
Dialogue: 0,0:11:07.50,0:11:09.50,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:11:09.50,0:11:11.50,Default,,0,0,0,,Қазірдің өзінде... Тоқтаған дұрыс.
Dialogue: 0,0:11:11.50,0:11:13.50,Default,,0,0,0,,Жоқ, біз, Суппин тайпасы,➡
Dialogue: 0,0:11:13.50,0:11:16.17,Default,,0,0,0,,Қарусыз жалаңаш солдат болғандай!
Dialogue: 0,0:11:16.17,0:11:19.17,Default,,0,0,0,,Өзі сияқты темір сауыт киіп➡
Dialogue: 0,0:11:19.17,0:11:21.84,Default,,0,0,0,,Сіз бірінші рет бірдей деңгейде күресе аласыз!
Dialogue: 0,0:11:21.84,0:11:24.01,Default,,0,0,0,,Жарайды... осынша айтсаң➡
Dialogue: 0,0:11:24.01,0:11:26.01,Default,,0,0,0,,Жарайды. Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:11:26.01,0:11:28.02,Default,,0,0,0,,Аа….
Dialogue: 0,0:11:28.02,0:11:31.19,Default,,0,0,0,,Ханако барын салды. Ол тіпті түрлі-түсті линзаларды кигізді.
Dialogue: 0,0:11:31.19,0:11:35.02,Default,,0,0,0,,Уау, біздің қазіргі қабілеттерімізбен бұл ең жақсы макияж!
Dialogue: 0,0:11:35.02,0:11:37.53,Default,,0,0,0,,Яй Маджи Чобелибар.
Dialogue: 0,0:11:40.19,0:11:44.20,Default,,0,0,0,,Бэтменнің мұндай жауы болған жоқ па? (2 адам) Уау, мінекей!
Dialogue: 0,0:11:44.20,0:11:49.87,Default,,0,0,0,,Хехехехе, плейбойлардың төрт аспан патшасы, сен мені жеңе аласың ба?
Dialogue: 0,0:11:49.87,0:11:52.71,Default,,0,0,0,,Касуми-сан мен Оливия-чан ол жерде болмайтын шығар.
Dialogue: 0,0:11:52.71,0:11:54.71,Default,,0,0,0,,《Ой, тоқта~ Анау сызық➡
Dialogue: 0,0:11:54.71,0:11:56.91,Default,,0,0,0,,Ол кішкентай қуыршақ кейіпкерге ұқсайды! 》
Dialogue: 0,0:11:58.88,0:12:02.32,Default,,0,0,0,,Хана-чан мен саған тазалық беремін. Эх, аа...рахмет.
Dialogue: 0,0:12:02.32,0:12:05.02,Default,,0,0,0,,Онда мен қазір үйге қайтайын. мм...
Dialogue: 0,0:12:06.99,0:12:09.99,Default,,0,0,0,,Ол жақсы адам сияқты көрінді. Иә. иә.
Dialogue: 0,0:12:09.99,0:12:12.49,Default,,0,0,0,,Хонда мырза, айнаға қарамаңыз және бірден киіміңізді жуыңыз.
Dialogue: 0,0:12:18.83,0:12:20.84,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:12:20.84,0:12:22.84,Default,,0,0,0,,Сіз не қарап тұрсыз? Оливия. Чоджугига.
Dialogue: 0,0:12:22.84,0:12:25.01,Default,,0,0,0,,Жануарлардың суреттері сондай сүйкімді.
Dialogue: 0,0:12:25.01,0:12:27.34,Default,,0,0,0,,Оливия, саған мұндай нәрсе ұнай ма?
Dialogue: 0,0:12:27.34,0:12:30.18,Default,,0,0,0,,Иә, мен де укио-эді жақсы көремін! Хмм.
Dialogue: 0,0:12:30.18,0:12:33.68,Default,,0,0,0,,Чоджу Гига Жапониядағы ең көне манга емес пе?
Dialogue: 0,0:12:33.68,0:12:37.35,Default,,0,0,0,,Оливия Бұл өте керемет. Мен орта мектеп оқушысына мұндай нәрсені ұнататынына сене алмаймын.
Dialogue: 0,0:12:37.35,0:12:39.35,Default,,0,0,0,,Эй, бұл не істеп жатыр?
Dialogue: 0,0:12:39.35,0:12:42.86,Default,,0,0,0,,Сумо? Мүмкін? Қызық, екеуі де еркек пе?
Dialogue: 0,0:12:42.86,0:12:44.86,Default,,0,0,0,,Оның еркек екенін қайдан білуге ​​болады?
Dialogue: 0,0:12:44.86,0:12:47.70,Default,,0,0,0,,Не? Сумомен тек ер адамдар ғана айналыса алады, солай емес пе?
Dialogue: 0,0:12:47.70,0:12:50.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:50.37,0:12:52.37,Default,,0,0,0,,Болашақ➡
Dialogue: 0,0:12:52.37,0:12:56.04,Default,,0,0,0,,Мен сумо балуаны болғым келді. Иә, дұрыс! ?
Dialogue: 0,0:12:56.04,0:12:58.54,Default,,0,0,0,,Теледидардан байқамадыңыз ба?
Dialogue: 0,0:12:58.54,0:13:00.48,Default,,0,0,0,,Өйткені дененің үстіңгі жағы жалаңаш➡
Dialogue: 0,0:13:00.48,0:13:04.65,Default,,0,0,0,,Мен тек еркек нұсқасын эфирге шығарып жатыр деп ойладым.
Dialogue: 0,0:13:04.65,0:13:08.48,Default,,0,0,0,,Қыз жұмақтай жерде жасырын➡
Dialogue: 0,0:13:08.48,0:13:12.65,Default,,0,0,0,,Мен оны үстіңгі денесі жоқ сумо балуаны деп ойладым.
Dialogue: 0,0:13:12.65,0:13:14.66,Default,,0,0,0,,《Оливия-сан, сенің жұмақтан үмітің бар! ? 》
Dialogue: 0,0:13:14.66,0:13:16.82,Default,,0,0,0,,Мамандық ретінде бұл мүмкін емес➡
Dialogue: 0,0:13:16.82,0:13:20.16,Default,,0,0,0,,Кез келген адам көңіл көтеру үшін сумо ойнай алады. ойнау?
Dialogue: 0,0:13:20.16,0:13:24.17,Default,,0,0,0,,Сіз нағыз сумоны көңіл көтеру үшін ойнайсыз ба? Жақсы ғой➡
Dialogue: 0,0:13:24.17,0:13:26.83,Default,,0,0,0,,Қазіргі уақытта мавашиді алмастыратын ештеңе жоқ.
Dialogue: 0,0:13:26.83,0:13:30.17,Default,,0,0,0,,Мм, қол күресі, саусақ күресі, қағаз күресі.
Dialogue: 0,0:13:30.17,0:13:32.84,Default,,0,0,0,,Сумо деп аталатын көптеген ойындар бар.
Dialogue: 0,0:13:32.84,0:13:35.01,Default,,0,0,0,,Қолмен «сол» деп айта алсаңыз жақсы!
Dialogue: 0,0:13:35.01,0:13:37.01,Default,,0,0,0,,А, қолыңмен күрескің келе ме?
Dialogue: 0,0:13:37.01,0:13:39.51,Default,,0,0,0,,Push sumo дегеніміз не? ОЛИВИЯ Сіз білмейсіз бе?
Dialogue: 0,0:13:39.51,0:13:41.68,Default,,0,0,0,,Касуми-сан, бір сәт менің алдымда тұр.
Dialogue: 0,0:13:41.68,0:13:45.69,Default,,0,0,0,,Қолдарыңызды осылай біріктіріп, бір-біріңізді итеріп, жалтарыңыз➡
Dialogue: 0,0:13:45.69,0:13:48.19,Default,,0,0,0,,Тепе-теңдікті жоғалтып, аяғын қимылдатқан адам жеңіледі.
Dialogue: 0,0:13:48.19,0:13:51.19,Default,,0,0,0,,Қолыңыздан басқа ештеңені ұстамаңыз. Эй.
Dialogue: 0,0:13:51.19,0:13:54.53,Default,,0,0,0,,《Жұмақтағы ойынға ұқсайды және қызықты көрінеді》
Dialogue: 0,0:13:54.53,0:13:57.20,Default,,0,0,0,,Әзірше Касуми екеуміз сынап көреміз➡
Dialogue: 0,0:13:57.20,0:13:59.20,Default,,0,0,0,,Қараңыз. иә!
Dialogue: 0,0:14:01.80,0:14:03.81,Default,,0,0,0,,Уау. Хмм….
Dialogue: 0,0:14:03.81,0:14:05.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:09.98,0:14:12.78,Default,,0,0,0,,А... А...
Dialogue: 0,0:14:14.82,0:14:17.15,Default,,0,0,0,,《Бұрын берген түсініктемеден еш айырмашылығы жоқ➡
Dialogue: 0,0:14:17.15,0:14:19.15,Default,,0,0,0,,Мен өзімді мүлде басқа сезінемін》
Dialogue: 0,0:14:19.15,0:14:21.66,Default,,0,0,0,,《Касуми-сан… күшті》
Dialogue: 0,0:14:21.66,0:14:26.16,Default,,0,0,0,,Ханако-сан, мен күткеннен де жақсы болды... иә?
Dialogue: 0,0:14:26.16,0:14:30.50,Default,,0,0,0,,Сіздің денеңіздің жоғарғы бөлігінде тұрақтылық жеткіліксіз деп ойлайсыз ба?
Dialogue: 0,0:14:30.50,0:14:32.50,Default,,0,0,0,,Хмм! 《Мен сені арандаттым! 》
Dialogue: 0,0:14:34.50,0:14:36.50,Default,,0,0,0,,Азу тістер!
Dialogue: 0,0:14:36.50,0:14:40.34,Default,,0,0,0,,《Егер ұсталып қалсаңыз, одан аулақ болыңыз.
Dialogue: 0,0:14:40.34,0:14:43.34,Default,,0,0,0,,Не... Сіз оны әлі де итермелейсіз бе?
Dialogue: 0,0:14:43.34,0:14:45.35,Default,,0,0,0,,Олай болса! 》
Dialogue: 0,0:14:45.35,0:14:49.02,Default,,0,0,0,,《Касуми-сан тағы да қытайлық акробатикалық труппа сияқты еліктейді!
Dialogue: 0,0:14:49.02,0:14:51.52,Default,,0,0,0,,Бірақ мен... мен жеңілмеймін! 》
Dialogue: 0,0:14:51.52,0:14:54.02,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:56.69,0:15:00.96,Default,,0,0,0,,О... Оливия... Бұл қауіпсіз емес пе?
Dialogue: 0,0:15:00.96,0:15:03.97,Default,,0,0,0,,《Бұл адамдар не істеп жатыр? 》
Dialogue: 0,0:15:03.97,0:15:08.14,Default,,0,0,0,,Сіз қауіпсізсіз бе? 《Өте орынды болса да》
Dialogue: 0,0:15:08.14,0:15:10.30,Default,,0,0,0,,Бірақ... қазірдің өзінде...
Dialogue: 0,0:15:10.30,0:15:13.47,Default,,0,0,0,,Барлығы~ Кешіктіргеніміз үшін кешіріңіз. Бұл мүмкін емес шығар...
Dialogue: 0,0:15:13.47,0:15:16.81,Default,,0,0,0,,Хонда-сан, берілме!
Dialogue: 0,0:15:16.81,0:15:19.48,Default,,0,0,0,,《Не? Мұғалім, сіз не айтып тұрсыз? 》
Dialogue: 0,0:15:19.48,0:15:22.65,Default,,0,0,0,,Бұл мүмкін емес! Бас тартсаң жақсы емес!
Dialogue: 0,0:15:22.65,0:15:28.82,Default,,0,0,0,,Мен бара аламын! Мен бара аламын! Сіз әлі кете аласыз, Хонда мырза, күте тұрыңыз!
Dialogue: 0,0:15:28.82,0:15:31.99,Default,,0,0,0,,Ха... Хакши!
Dialogue: 0,0:15:31.99,0:15:33.10,Default,,0,0,0,,Иә! Бұл менің көзіме түсті...
Dialogue: 0,0:15:38.00,0:15:41.67,Default,,0,0,0,,《Е... қандай үлкен мәселе...》
Dialogue: 0,0:15:41.67,0:15:45.34,Default,,0,0,0,,Сіздің мұғаліміңіз Ханаконы жақсы көрді ме?
Dialogue: 0,0:15:45.34,0:15:47.34,Default,,0,0,0,,Жоқ, шын мәнінде олай емес.
Dialogue: 0,0:15:47.34,0:15:50.18,Default,,0,0,0,,Мен жай ғана құмар ұстаз сияқты айтқым келді.
Dialogue: 0,0:15:50.18,0:15:52.35,Default,,0,0,0,,Ей, не дейсің! ? Мен таң қалдым!
Dialogue: 0,0:15:52.35,0:15:54.85,Default,,0,0,0,,Содан кейін, келесі Оливия-санның көптен күткен ➡
Dialogue: 0,0:15:54.85,0:15:57.15,Default,,0,0,0,,Біз жұмақта көңіл көтеруді көреміз бе? Ха!
Dialogue: 0,0:16:05.79,0:16:07.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:07.80,0:16:10.00,Default,,0,0,0,,《Ешкім...》
Dialogue: 0,0:16:15.97,0:16:19.97,Default,,0,0,0,,《Ешкім жоқ болса, жасырын》
Dialogue: 0,0:16:19.97,0:16:22.81,Default,,0,0,0,,｟Мен саған сиқырлаймын.
Dialogue: 0,0:16:22.81,0:16:26.51,Default,,0,0,0,,Хмм... аа... киіңіз
Dialogue: 0,0:16:29.82,0:16:32.65,Default,,0,0,0,,Сәлем! Ия, Касуми-сан мұнда бірінші келді ме?
Dialogue: 0,0:16:32.65,0:16:35.82,Default,,0,0,0,,Не, не жазып едің? Сіз не істеп жүрсіз?
Dialogue: 0,0:16:35.82,0:16:39.33,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:16:39.33,0:16:42.16,Default,,0,0,0,,Бұл...дәріс есебі.
Dialogue: 0,0:16:42.16,0:16:44.50,Default,,0,0,0,,Эй, бұл қиын, Касуми-сан.
Dialogue: 0,0:16:44.50,0:16:47.00,Default,,0,0,0,,Не, кіші мектеп оқушылары дәріс демейді!
Dialogue: 0,0:16:47.00,0:16:49.00,Default,,0,0,0,,Аа...
Dialogue: 0,0:16:49.00,0:16:51.34,Default,,0,0,0,,«Кәке»?
Dialogue: 0,0:16:51.34,0:16:53.84,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:16:53.84,0:16:56.01,Default,,0,0,0,,Ал, Касуми-сан. Бұл дұрыс емес!
Dialogue: 0,0:16:56.01,0:16:59.35,Default,,0,0,0,,Бұл дұрыс емес! Мен бұны жазған жоқпын!
Dialogue: 0,0:16:59.35,0:17:01.78,Default,,0,0,0,,Жоқ! Жарайды, кешіріңіз, мен түсінемін.
Dialogue: 0,0:17:01.78,0:17:04.45,Default,,0,0,0,,Ей, мен өлгім келеді!
Dialogue: 0,0:17:04.45,0:17:06.79,Default,,0,0,0,,Жарайды! Бұл шынымен жақсы, сондықтан өлме!
Dialogue: 0,0:17:06.79,0:17:09.46,Default,,0,0,0,,Тікелей эфир! Тірі! Сен сұлусын!
Dialogue: 0,0:17:09.46,0:17:12.56,Default,,0,0,0,,Мен мұғалімді жолда кездестірдім. Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:17:15.46,0:17:19.63,Default,,0,0,0,,《Бұл қандай жағдайда болғанын білмеймін》
Dialogue: 0,0:17:19.63,0:17:21.80,Default,,0,0,0,,Ух... ой...
Dialogue: 0,0:17:21.80,0:17:25.64,Default,,0,0,0,,《Жоқ! Мен айта алмаймын! Мен мұны айтсам, Касуми міндетті түрде өледі!
Dialogue: 0,0:17:25.64,0:17:28.48,Default,,0,0,0,,Басқа сылтау, басқа…》
Dialogue: 0,0:17:28.48,0:17:33.31,Default,,0,0,0,,Немесе... Касуми-сан, мен Оскар Уайлдқа ұқсайтын роман жазып жатыр едім.
Dialogue: 0,0:17:33.31,0:17:35.32,Default,,0,0,0,,《Ханако-сан! 》
Dialogue: 0,0:17:35.32,0:17:38.49,Default,,0,0,0,,Әй, бұл қандай роман? А... жоқ.
Dialogue: 0,0:17:38.49,0:17:41.49,Default,,0,0,0,,Бұл өте жабайы және шатастыруы мүмкін.
Dialogue: 0,0:17:41.49,0:17:43.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:43.49,0:17:46.99,Default,,0,0,0,,Мүмкін бұл үлкен сайтта қолмен сататын нәрсе шығар?
Dialogue: 0,0:17:46.99,0:17:49.00,Default,,0,0,0,,Иә? Иә... Иә.
Dialogue: 0,0:17:49.00,0:17:52.17,Default,,0,0,0,,Жабайы қолмен сату түрі. Мен көремін...
Dialogue: 0,0:17:52.17,0:17:54.84,Default,,0,0,0,,Мен оны аяқтаған кезде оқуыңызды қалаймын. Жоқ!
Dialogue: 0,0:17:54.84,0:17:57.17,Default,,0,0,0,,Ах~ Біреуді өлтіріп тастаңыз~!
Dialogue: 0,0:17:57.17,0:17:59.51,Default,,0,0,0,,Менің жалғыз өлуге батылым жетпейді! Касуми-сан...
Dialogue: 0,0:17:59.51,0:18:01.44,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы хат жазып, өзін-өзі өлтірген сияқты➡
Dialogue: 0,0:18:01.44,0:18:03.95,Default,,0,0,0,,Бұл атмосфера жасайды! Жарайды.
Dialogue: 0,0:18:03.95,0:18:06.28,Default,,0,0,0,,Маған ұлдардың мектеп соғыстары да ұнайды.
Dialogue: 0,0:18:06.28,0:18:10.28,Default,,0,0,0,,Соңғы кездері мені осындай нәрсе қызықтырады. Ха... Ханако-чан….
Dialogue: 0,0:18:10.28,0:18:15.46,Default,,0,0,0,,Мусаши х Билли, солай ма? Ол кім? Сол екеуі...
Dialogue: 0,0:18:15.46,0:18:17.46,Default,,0,0,0,,Мен ағынды мүлдем түсінбеймін➡
Dialogue: 0,0:18:17.46,0:18:20.63,Default,,0,0,0,,Касуми роман жаза ма? Иә….
Dialogue: 0,0:18:20.63,0:18:23.63,Default,,0,0,0,,Сіз әлі атақ туралы шешім қабылдадыңыз ба? Е, жоқ, әлі емес...
Dialogue: 0,0:18:23.63,0:18:25.80,Default,,0,0,0,,А, мен бірдеңені ойладым.
Dialogue: 0,0:18:25.80,0:18:29.14,Default,,0,0,0,,Не? Бұл не? «Есігімді қорғаңыз».
Dialogue: 0,0:18:29.14,0:18:31.14,Default,,0,0,0,,Сәлем! (2 адам) Иә?
Dialogue: 0,0:18:31.14,0:18:33.81,Default,,0,0,0,,Хонда мырза! Мұғалімнің киелі кітабын ластамаңыз!
Dialogue: 0,0:18:33.81,0:18:36.48,Default,,0,0,0,,Мұғалім, сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:36.48,0:18:40.48,Default,,0,0,0,,Мм... байыптырақ. Мен байсалды болдым.
Dialogue: 0,0:18:40.48,0:18:43.99,Default,,0,0,0,,Бір күні басты кейіпкердің кенет бөксесінен сәулелер шыға бастайды.
Dialogue: 0,0:18:43.99,0:18:45.99,Default,,0,0,0,,《Сен мүлде байсалды емессің! 》
Dialogue: 0,0:18:45.99,0:18:48.49,Default,,0,0,0,,Ханако-сама, сен қоңырау шалдың ба? Гах! Эй!
Dialogue: 0,0:18:48.49,0:18:52.16,Default,,0,0,0,,Ханако Ша~ Мені өшіргішпен пышақтап таста! Касуми-сан!
Dialogue: 0,0:18:52.16,0:18:55.16,Default,,0,0,0,,Касуми-сама романы бойынша көмектесе аламын ба?
Dialogue: 0,0:18:55.16,0:18:57.16,Default,,0,0,0,,Егер солай болса, мен оны қуана-қуана көрсетемін.
Dialogue: 0,0:18:57.16,0:18:59.33,Default,,0,0,0,,Айтпақшы, сізге шабуыл жасалды ма?
Dialogue: 0,0:18:59.33,0:19:02.44,Default,,0,0,0,,Е, бұл роман жанры ма?
Dialogue: 0,0:19:02.44,0:19:04.44,Default,,0,0,0,,Кешірім сұраймыз.
Dialogue: 0,0:19:04.44,0:19:06.61,Default,,0,0,0,,Мен ол дүниемен онша таныс емеспін.
Dialogue: 0,0:19:06.61,0:19:09.94,Default,,0,0,0,,Алайда, егер Ханако-сама сұраса, мен Ни-хомеге вазелин әкелетін едім.
Dialogue: 0,0:19:09.94,0:19:11.95,Default,,0,0,0,,А, бұл соншалықты маңызды емес.
Dialogue: 0,0:19:11.95,0:19:13.95,Default,,0,0,0,,Бұл жеңілірек қиялға ұқсайды, сондықтан жақсы.
Dialogue: 0,0:19:13.95,0:19:15.95,Default,,0,0,0,,Қиял….
Dialogue: 0,0:19:15.95,0:19:20.62,Default,,0,0,0,,Гоблин х гном сияқты нәрсе ме? Бұл не деген лас сурет?
Dialogue: 0,0:19:20.62,0:19:22.62,Default,,0,0,0,,Қиял басқа! Болды➡
Dialogue: 0,0:19:22.62,0:19:25.29,Default,,0,0,0,,Сіз бас тартқан адамдарды ғана көресіз!
Dialogue: 0,0:19:25.29,0:19:28.13,Default,,0,0,0,,Е... менің досымның жиенінде ондай типтегі қатты дужинши бар...
Dialogue: 0,0:19:28.13,0:19:30.80,Default,,0,0,0,,Тоқта~ Мен енді естігім келмейді! Гобудва.
Dialogue: 0,0:19:30.80,0:19:33.30,Default,,0,0,0,,Сәлем! Сіз түсінген сияқтысыз, сондықтан қысқартпаңыз! ?
Dialogue: 0,0:19:33.30,0:19:36.80,Default,,0,0,0,,Кешіріңіз, Касуми-сан, маған осындай оғаш оқиғаны айтып беруіңізді сұрағаным үшін.
Dialogue: 0,0:19:36.80,0:19:39.81,Default,,0,0,0,,Ух... Касуми-сан, жақсылап ойлансаң➡
Dialogue: 0,0:19:39.81,0:19:42.81,Default,,0,0,0,,Мен еркектермен жақсы емеспін, бірақ еркектермен болған дұрыс па?
Dialogue: 0,0:19:42.81,0:19:45.15,Default,,0,0,0,,... 2D жақсы...
Dialogue: 0,0:19:45.15,0:19:49.65,Default,,0,0,0,,2D қағаздан шықпайды, сондықтан қауіпсіз, солай емес пе?
Dialogue: 0,0:19:49.65,0:19:52.49,Default,,0,0,0,,Ал егер сізді әйелдер қызықтырмаса, одан да жақсы.
Dialogue: 0,0:19:52.49,0:19:54.66,Default,,0,0,0,,《Мен...》
Dialogue: 0,0:19:54.66,0:19:56.99,Default,,0,0,0,,Касуми~ Бірақ мұндай сөздерді айтқанда➡
Dialogue: 0,0:19:56.99,0:19:59.59,Default,,0,0,0,,Сіз мұғалім сияқты боласыз, солай ма? 《Гаан》
Dialogue: 0,0:20:01.83,0:20:06.17,Default,,0,0,0,,Бұл ұят. Мен онымен өмір сүре аламын.
Dialogue: 0,0:20:06.17,0:20:08.67,Default,,0,0,0,,《Шыдауға тура келетін жағдай! ? 》
Dialogue: 0,0:20:08.67,0:20:12.34,Default,,0,0,0,,Мм... БЛ романдарына пайдалы ма, білмеймін➡
Dialogue: 0,0:20:12.34,0:20:14.34,Default,,0,0,0,,Мен сендерге шағын әңгіме айтып берейін бе?
Dialogue: 0,0:20:14.34,0:20:16.84,Default,,0,0,0,,Жарайды. рақмет сізге.
Dialogue: 0,0:20:16.84,0:20:22.18,Default,,0,0,0,,Ертеде бір университетте алты жыл оқыған студент болыпты.
Dialogue: 0,0:20:22.18,0:20:25.19,Default,,0,0,0,,Университеттегі 3-сыныпқа арналған лекция емтиханының таңы➡
Dialogue: 0,0:20:25.19,0:20:29.69,Default,,0,0,0,,Мені кенеттен қара киінген адамдар көшеден алып кетті.
Dialogue: 0,0:20:29.69,0:20:31.69,Default,,0,0,0,,Қара киінген ер адамдар➡
Dialogue: 0,0:20:31.69,0:20:36.53,Default,,0,0,0,,Олар университет студентін төртбұрышты бөлмеде ұстап, оның бөксесін тексере бастады.
Dialogue: 0,0:20:36.53,0:20:43.04,Default,,0,0,0,,｟Кореха Субарашии Кецуда. Жою қаруы, жою қаруы, Какусу
Dialogue: 0,0:20:43.04,0:20:46.04,Default,,0,0,0,,Мен оянсам, мен сол орнындамын➡
Dialogue: 0,0:20:46.04,0:20:48.04,Default,,0,0,0,,Бір күн өткен сияқты➡
Dialogue: 0,0:20:48.04,0:20:50.71,Default,,0,0,0,,3-ші бекетте қалғаныма қуаныштымын.
Dialogue: 0,0:20:50.71,0:20:54.92,Default,,0,0,0,,Содан кейін оның өмірі тозаққа айналды.
Dialogue: 0,0:20:56.88,0:20:59.89,Default,,0,0,0,,Мен дәрет шығарған сайын дәретхананы қиратамын➡
Dialogue: 0,0:20:59.89,0:21:02.66,Default,,0,0,0,,Толық емес жұмыс күнімен жұмыс істесеңіз де, жұмыс орныңыздағы дәретхананы бұзу себебі➡
Dialogue: 0,0:21:02.66,0:21:04.66,Default,,0,0,0,,Мен жұмыстан шыға бердім.
Dialogue: 0,0:21:04.66,0:21:09.16,Default,,0,0,0,,Бір күні өзімді үмітсіз сезініп, баспанасыз қалудан басқа амалым жоқ екенін түсіндім.
Dialogue: 0,0:21:09.16,0:21:11.33,Default,,0,0,0,,｟Сен кімсің...?
Dialogue: 0,0:21:11.33,0:21:14.00,Default,,0,0,0,,Не болды? Кетіңіз, қария.
Dialogue: 0,0:21:14.00,0:21:17.17,Default,,0,0,0,,Бір минут күтіңіз. Мен сізге көрсетейін.
Dialogue: 0,0:21:17.17,0:21:20.17,Default,,0,0,0,,Неліктен тек бөксе аймағында жыртылады? ?
Dialogue: 0,0:21:20.17,0:21:22.18,Default,,0,0,0,,Ұстамаңыз! Бұл қауіпті.
Dialogue: 0,0:21:22.18,0:21:24.68,Default,,0,0,0,,Егер кенеттен сәуле пайда болса, не істеу керек?
Dialogue: 0,0:21:24.68,0:21:28.18,Default,,0,0,0,,Мен оның не екенін білмей тұрып, менің ішімде осындай бір нәрсе ендірілген➡
Dialogue: 0,0:21:28.18,0:21:30.85,Default,,0,0,0,,Тіпті мен оны мүлде басқара алмаймын.
Dialogue: 0,0:21:30.85,0:21:37.02,Default,,0,0,0,,Мен қазір өмір сүріп жатқан өмірді сүру мүмкін емес шығар...
Dialogue: 0,0:21:37.02,0:21:39.86,Default,,0,0,0,,Жарайды, менімен бірге жүр.
Dialogue: 0,0:21:39.86,0:21:44.53,Default,,0,0,0,,Мен саған есегіңді басқаруды үйретемін｠
Dialogue: 0,0:21:44.53,0:21:48.20,Default,,0,0,0,,Соны айтып көмектессеңіз жақсы болар еді...
Dialogue: 0,0:21:48.20,0:21:50.20,Default,,0,0,0,,Бұл Ханако-саманың атасы.
Dialogue: 0,0:21:50.20,0:21:53.21,Default,,0,0,0,,《Не, өтірік пе? Бұл шынайы оқиға ма? Өте қорқынышты! 》
Dialogue: 0,0:21:53.21,0:21:56.71,Default,,0,0,0,,Қазір жақсысың ба? Иә, рахмет.
Dialogue: 0,0:21:56.71,0:21:59.21,Default,,0,0,0,,Мен дәретхананы тек ішім өткенде ғана бұзады.
Dialogue: 0,0:21:59.21,0:22:01.82,Default,,0,0,0,,Бұл өте ыңғайсыз, себебі мен дәретхана әр жолы жөнделмейінше, оны пайдалана алмаймын.
Dialogue: 0,0:22:01.82,0:22:03.82,Default,,0,0,0,,《Ақыр соңында, сен оны құртып жатырсың! 》
Dialogue: 0,0:22:03.82,0:22:06.32,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл сізге шығармашылық идеялар берді ме?
Dialogue: 0,0:22:06.32,0:22:09.16,Default,,0,0,0,,Е... у...
Dialogue: 0,0:22:09.16,0:22:11.83,Default,,0,0,0,,Бұл жиіркенішті...
Dialogue: 0,0:22:11.83,0:22:16.00,Default,,0,0,0,,<Касуми Номураның еркектерге деген өшпенділігі осылайша қарқын алды>
Dialogue: 0,0:22:16.00,0:22:18.00,Default,,0,0,0,,Oe….
Dialogue: 0,0:22:19.50,0:22:25.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
