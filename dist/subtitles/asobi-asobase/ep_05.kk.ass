Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:42.03,0:01:48.34,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:01:50.37,0:01:52.87,Default,,0,0,0,,Сәлем Маэда. (Маэда) Иә?
Dialogue: 0,0:01:52.87,0:01:57.38,Default,,0,0,0,,Үй жануарлары иелеріне ұқсайды дейді, бірақ бұл➡
Dialogue: 0,0:01:57.38,0:01:59.55,Default,,0,0,0,,Олар бір-біріне мүлде ұқсамайды.
Dialogue: 0,0:01:59.55,0:02:01.82,Default,,0,0,0,,Сіз айтқандай.
Dialogue: 0,0:02:01.82,0:02:04.99,Default,,0,0,0,,《Өлсем де Ханако-самаға айта алмаймын➡
Dialogue: 0,0:02:04.99,0:02:07.99,Default,,0,0,0,,Ханако ханым бір күні диванда ұйықтап жатқан еді➡
Dialogue: 0,0:02:07.99,0:02:12.16,Default,,0,0,0,,Дәл солай көрінді! 》
Dialogue: 0,0:02:12.16,0:02:15.16,Default,,0,0,0,,Уау! Мен мұны істеп жатқанда, мен кездесуге кешігіп қаламын!
Dialogue: 0,0:02:15.16,0:02:17.67,Default,,0,0,0,,Бүгін қайда барасыз? Оливия және Касумимен➡
Dialogue: 0,0:02:17.67,0:02:20.00,Default,,0,0,0,,Әлеуметтік зерттеулер тобының презентация тапсырмасын орындаңыз!
Dialogue: 0,0:02:20.00,0:02:22.50,Default,,0,0,0,,Кеттік! О, Ханако-сама.
Dialogue: 0,0:02:22.50,0:02:25.17,Default,,0,0,0,,Иә? а….
Dialogue: 0,0:02:25.17,0:02:27.68,Default,,0,0,0,,Ханако ханым тым сәнді➡
Dialogue: 0,0:02:27.68,0:02:30.88,Default,,0,0,0,,Мен мені аңдып кететіндей болдым. Дұрыс!
Dialogue: 0,0:02:33.02,0:02:35.02,Default,,0,0,0,,Касуми~. (Касуми) Ах...
Dialogue: 0,0:02:35.02,0:02:38.19,Default,,0,0,0,,Күтесіз бе? Жоқ, мен 10 минут бұрын келдім.
Dialogue: 0,0:02:38.19,0:02:41.86,Default,,0,0,0,,Уфуфу Мен сені қарапайым киіммен бірінші рет кездестіруім. Мен келісемін.
Dialogue: 0,0:02:41.86,0:02:46.36,Default,,0,0,0,,Әй, ұзын юбкалар сондай жетілген! А... Солай ма?
Dialogue: 0,0:02:46.36,0:02:49.36,Default,,0,0,0,,Оливия-сан да... Бұл тамаша.
Dialogue: 0,0:02:49.36,0:02:52.03,Default,,0,0,0,,А, жай ғана футболка мен шорт?
Dialogue: 0,0:02:52.03,0:02:54.37,Default,,0,0,0,,Иә... бірақ...
Dialogue: 0,0:02:54.37,0:02:56.37,Default,,0,0,0,,《Қарапайым комбинация –➡
Dialogue: 0,0:02:56.37,0:02:59.21,Default,,0,0,0,,Мен өзімнің сыртқы келбетіме сенімді болмасам, мұны істей алмайтындай сезінемін.
Dialogue: 0,0:02:59.21,0:03:01.81,Default,,0,0,0,,Маған қызық, Ханако қандай киім киеді?
Dialogue: 0,0:03:01.81,0:03:04.65,Default,,0,0,0,,Бір қызығы, ол юкатамен келді. О, мүмкін сияқты!
Dialogue: 0,0:03:04.65,0:03:07.48,Default,,0,0,0,,Немесе бүкіл дене бренді! Мен баймын.
Dialogue: 0,0:03:07.48,0:03:10.32,Default,,0,0,0,,Күткеніңізге рахмет! Ах Хана...
Dialogue: 0,0:03:10.32,0:03:12.32,Default,,0,0,0,,Бала…. Эх...
Dialogue: 0,0:03:12.32,0:03:17.33,Default,,0,0,0,,Эххе.
Dialogue: 0,0:03:17.33,0:03:19.49,Default,,0,0,0,,Кешіріңіз, бұл ұзақ болды.
Dialogue: 0,0:03:19.49,0:03:21.50,Default,,0,0,0,,Ханако…. иә?
Dialogue: 0,0:03:21.50,0:03:24.00,Default,,0,0,0,,Жолда басыңды ұрдың ба? иә?
Dialogue: 0,0:03:24.00,0:03:26.00,Default,,0,0,0,,Бұл нені білдіретіні маған қызық! ?
Dialogue: 0,0:03:26.00,0:03:29.67,Default,,0,0,0,,Жоқ, өйткені сіздің ақыл-ойыңыз дұрыс болса, сіз ондай болмас едіңіз.
Dialogue: 0,0:03:29.67,0:03:31.67,Default,,0,0,0,,Ahreareare~?
Dialogue: 0,0:03:31.67,0:03:35.34,Default,,0,0,0,,Бұл әмбебап дүкендерден алуға болатын дайын киімдерден сәл өзгеше➡
Dialogue: 0,0:03:35.34,0:03:39.01,Default,,0,0,0,,Болашақ суретшінің бірегей жоғары сән үлгісі!
Dialogue: 0,0:03:39.01,0:03:41.35,Default,,0,0,0,,Бұл жоғары сән!
Dialogue: 0,0:03:41.35,0:03:43.85,Default,,0,0,0,,Ｏｈｈ～
Dialogue: 0,0:03:43.85,0:03:46.69,Default,,0,0,0,,《Бұл дүниежүзілік тарихқа қатысты сөз тіркесі сияқты және ол бірден ақсақ болып көрінеді! 》
Dialogue: 0,0:03:46.69,0:03:50.53,Default,,0,0,0,,керемет, Ханаконың ерекше сезімі бар.
Dialogue: 0,0:03:50.53,0:03:53.53,Default,,0,0,0,,Е, бұл қазір Хараджуку стилі.
Dialogue: 0,0:03:53.53,0:03:57.20,Default,,0,0,0,,《Не! ? Жоқ, сіз дұрыс түсінбедіңіз! 》
Dialogue: 0,0:03:57.20,0:03:59.37,Default,,0,0,0,,Олай болса, қазір тапсырманы орындайық.
Dialogue: 0,0:03:59.37,0:04:01.47,Default,,0,0,0,,Жарайды. Иә, оған дейін➡
Dialogue: 0,0:04:01.47,0:04:03.47,Default,,0,0,0,,Екеуіңнен бірдеңе сұрайын ба?
Dialogue: 0,0:04:07.14,0:04:09.81,Default,,0,0,0,,《жарқырау》 《жылтыр…》
Dialogue: 0,0:04:09.81,0:04:13.48,Default,,0,0,0,,《Қорқынышты...》 《Мен мүлде шоғырлана алмаймын》
Dialogue: 0,0:04:13.48,0:04:17.99,Default,,0,0,0,,Бұл не? Жоқ, жоқ, білмеймін.
Dialogue: 0,0:04:20.82,0:04:22.82,Default,,0,0,0,,《Иә! 》
Dialogue: 0,0:04:22.82,0:04:25.83,Default,,0,0,0,,Кешіріңіз! иә? О, шаншып кетті ме?
Dialogue: 0,0:04:25.83,0:04:30.33,Default,,0,0,0,,Эй Касуми-сан, соны да айтшы. Әй... Қаламыңды айналдырасың ба?
Dialogue: 0,0:04:30.33,0:04:34.50,Default,,0,0,0,,Әй... Бас бармағыңыздың түбіне қарай айналдырған сияқтысыз.
Dialogue: 0,0:04:34.50,0:04:36.51,Default,,0,0,0,,Хмф... Жарайды!
Dialogue: 0,0:04:36.51,0:04:40.34,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:04:40.34,0:04:43.35,Default,,0,0,0,,Бұл не! Өте қиын!
Dialogue: 0,0:04:43.35,0:04:45.51,Default,,0,0,0,,Ах... қолды түгел айналдырмаңыз... Мүмкін емес, мүмкін емес!
Dialogue: 0,0:04:45.51,0:04:50.62,Default,,0,0,0,,Ортаңғы саусағыңызды бас бармақ жағына қарай қатты бассаңыз, қалам өздігінен айналады.
Dialogue: 0,0:04:53.02,0:04:55.52,Default,,0,0,0,,А, дұрыс! Осылай көп рет жасасаңыз➡
Dialogue: 0,0:04:55.52,0:04:59.63,Default,,0,0,0,,Енді сіз аласыз! «Жақсы! Келесі рет! 》
Dialogue: 0,0:05:01.63,0:05:03.83,Default,,0,0,0,,Сонымен... ыстық!
Dialogue: 0,0:05:06.30,0:05:08.30,Default,,0,0,0,,⚟Өрт болып жатыр!
Dialogue: 0,0:05:08.30,0:05:11.31,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:13.81,0:05:18.48,Default,,0,0,0,,Ібіліс! Ібіліс кейпіндегі қыз кенет маған бірдеңе лақтырды!
Dialogue: 0,0:05:18.48,0:05:22.48,Default,,0,0,0,,Сіз оны көрмедіңіз бе? Мүйізді шайтанға ұқсайтын қыз!
Dialogue: 0,0:05:22.48,0:05:25.15,Default,,0,0,0,,Жоқ, жоқ... Эй, Оливия.
Dialogue: 0,0:05:25.15,0:05:27.66,Default,,0,0,0,,Мен… Осы мүмкіндікті пайдаланып➡
Dialogue: 0,0:05:27.66,0:05:31.56,Default,,0,0,0,,Мен Хараджуку мектебін бітіремін. Сондықтан бұл хараджуку стилінде емес.
Dialogue: 0,0:05:38.83,0:05:43.84,Default,,0,0,0,,Ах, Оливия, тым кеш. Тазалық қызметіндегі ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:05:43.84,0:05:46.84,Default,,0,0,0,,Ойлап қарасам, мен бүгін аңырап қалдым.
Dialogue: 0,0:05:46.84,0:05:52.51,Default,,0,0,0,,Ей, екеуің де маңызды бір нәрсе айтамын, тыңдаңдар.
Dialogue: 0,0:05:52.51,0:05:55.18,Default,,0,0,0,,Осы мектепке➡
Dialogue: 0,0:05:55.18,0:05:58.35,Default,,0,0,0,,Бір ұл бар.
Dialogue: 0,0:05:58.35,0:06:00.29,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:06:00.29,0:06:02.79,Default,,0,0,0,,Күте тұрыңыз~ Бұл әзіл емес. Бұл рас!
Dialogue: 0,0:06:02.79,0:06:05.46,Default,,0,0,0,,А... ха... Сіз кенеттен осындай нәрсені айтса да.
Dialogue: 0,0:06:05.46,0:06:08.80,Default,,0,0,0,,Бірдеңе болды ма? Ха... міне осы➡
Dialogue: 0,0:06:08.80,0:06:12.47,Default,,0,0,0,,Кеше түнде ұйықтап жатқанда, терезе шу болды.
Dialogue: 0,0:06:12.47,0:06:15.30,Default,,0,0,0,,｟⚟Бұл дұрыс емес! 《Мен ұйықтай алмаймын...》｠
Dialogue: 0,0:06:15.30,0:06:17.47,Default,,0,0,0,,Тез қарасаңыз➡
Dialogue: 0,0:06:17.47,0:06:20.48,Default,,0,0,0,,Ерлі-зайыптылар жанжалға ұқсайды.
Dialogue: 0,0:06:20.48,0:06:23.14,Default,,0,0,0,,｟Бұл нені білдіреді? Эй, біз кенеттен айырылысып қаламыз➡
Dialogue: 0,0:06:23.14,0:06:26.15,Default,,0,0,0,,Мағынасыз мен сені сүйемін!
Dialogue: 0,0:06:26.15,0:06:30.15,Default,,0,0,0,,Кешіріңіз, бірақ енді өтірік айтудың қажеті жоқ.
Dialogue: 0,0:06:30.15,0:06:33.15,Default,,0,0,0,,Мен… төмен….
Dialogue: 0,0:06:33.15,0:06:36.66,Default,,0,0,0,,Мен де сен сияқты киім киемін.
Dialogue: 0,0:06:36.66,0:06:38.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:43.50,0:06:46.50,Default,,0,0,0,,Өйткені, бұл реакция.
Dialogue: 0,0:06:46.50,0:06:48.50,Default,,0,0,0,,Кешіріңіз. Күте тұрыңыз!
Dialogue: 0,0:06:48.50,0:06:51.34,Default,,0,0,0,,Қосулы болса да... Маған ұнайды!
Dialogue: 0,0:06:51.34,0:06:53.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:53.34,0:06:56.68,Default,,0,0,0,,《Уау, бұл жақсы әңгіме~.
Dialogue: 0,0:06:56.68,0:06:59.68,Default,,0,0,0,,Бұл Касумиге ұнайтыны》｠
Dialogue: 0,0:06:59.68,0:07:01.95,Default,,0,0,0,,Мен солай ойладым. Сәл күте тұрыңыз!
Dialogue: 0,0:07:01.95,0:07:04.79,Default,,0,0,0,,Эй Касуми, мен еске түсіріп жатқанда кірмеші.
Dialogue: 0,0:07:04.79,0:07:07.29,Default,,0,0,0,,Жоқ! Мен мұнда дұрыс түзету жасауым керек!
Dialogue: 0,0:07:07.29,0:07:10.29,Default,,0,0,0,,Бірақ сізге мұндай нәрсе ұнайды, солай ма? Ол кісінің қызы➡
Dialogue: 0,0:07:10.29,0:07:13.80,Default,,0,0,0,,Бұл BL-ге ұқсас, бірақ басқаша! Бұл менің қорғаныс ауқымым емес!
Dialogue: 0,0:07:13.80,0:07:17.13,Default,,0,0,0,,Е, бұл азап. Бұл мүлдем қиындық тудырмайды!
Dialogue: 0,0:07:17.13,0:07:20.64,Default,,0,0,0,,Сол кезде мен бір ғажайып нәрсені түсіндім.
Dialogue: 0,0:07:20.64,0:07:22.80,Default,,0,0,0,,Бала➡
Dialogue: 0,0:07:22.80,0:07:26.14,Default,,0,0,0,,Бұл менің формасым болатын. 《Екі адам: қорқынышты...》
Dialogue: 0,0:07:26.14,0:07:29.48,Default,,0,0,0,,Жоқ. Бұл түсінбеушілік емес пе? Сіз қателесе алмайсыз!
Dialogue: 0,0:07:29.48,0:07:31.65,Default,,0,0,0,,Ол бөтен адам сияқты, сөзсіз араласады!
Dialogue: 0,0:07:31.65,0:07:35.48,Default,,0,0,0,,А... Бұл мектепте күдікті біреу болды ма?
Dialogue: 0,0:07:35.48,0:07:39.49,Default,,0,0,0,,Ха, мүмкін сол адам. (2 адам) Гүлім...
Dialogue: 0,0:07:39.49,0:07:42.82,Default,,0,0,0,,Үшінші курс студенті Такаянаги-сенпай біраз күдіктеніп тұрған жоқ па?
Dialogue: 0,0:07:42.82,0:07:44.83,Default,,0,0,0,,Әй, сұрасаң.
Dialogue: 0,0:07:44.83,0:07:47.83,Default,,0,0,0,,Еркектік атмосфераға ұқсайды, солай емес пе? о иә.
Dialogue: 0,0:07:47.83,0:07:51.33,Default,,0,0,0,,Ол жүзу үйірмесінің меңгерушісі, бірақ ол күдіктенеді. Оливия!
Dialogue: 0,0:07:51.33,0:07:55.17,Default,,0,0,0,,Жүзу үйірмесі болса, сөзсіз басқаша болар еді. Енді неге ат қойдыңыз? ?
Dialogue: 0,0:07:55.17,0:07:57.37,Default,,0,0,0,,Сосын... анау бала.
Dialogue: 0,0:07:59.34,0:08:01.61,Default,,0,0,0,,Иә? Келесі кім?
Dialogue: 0,0:08:01.61,0:08:04.78,Default,,0,0,0,,Жоқ, келесі бала сөзсіз күдікті. Ол кім?
Dialogue: 0,0:08:04.78,0:08:06.78,Default,,0,0,0,,Ока мырза, 2 курс 4 сынып студенті.
Dialogue: 0,0:08:06.78,0:08:09.62,Default,,0,0,0,,Бұл басқа вектор, жай ғана күдікті!
Dialogue: 0,0:08:09.62,0:08:13.29,Default,,0,0,0,,А, қазірдің өзінде... Оливияның түсінбестігі болуы керек, солай ма?
Dialogue: 0,0:08:13.29,0:08:15.62,Default,,0,0,0,,Сіз әпкеңіздің формасын қарызға алғансыз, солай ма?
Dialogue: 0,0:08:15.62,0:08:17.63,Default,,0,0,0,,А, солай шығар. бұл….
Dialogue: 0,0:08:17.63,0:08:21.30,Default,,0,0,0,,Менің сыныбымдағы дене шынықтыруға арналған киім ауыстырғанда➡
Dialogue: 0,0:08:21.30,0:08:23.80,Default,,0,0,0,,Жуынатын бөлмеде үнемі киімін ауыстырған жоқ па?
Dialogue: 0,0:08:23.80,0:08:25.80,Default,,0,0,0,,Ах…. Ол болған шығар.
Dialogue: 0,0:08:25.80,0:08:28.14,Default,,0,0,0,,Сондай-ақ мен үнемі жүзу сабақтарын бақылаймын.
Dialogue: 0,0:08:28.14,0:08:31.31,Default,,0,0,0,,А, бұл күдікті болуы мүмкін. Мен бұл хлорға аллергия деп естідім.
Dialogue: 0,0:08:31.31,0:08:33.81,Default,,0,0,0,,Ал ол адам сенің қызың, солай ма?
Dialogue: 0,0:08:33.81,0:08:35.81,Default,,0,0,0,,Мен олай сезінбеймін.
Dialogue: 0,0:08:35.81,0:08:38.48,Default,,0,0,0,,Эй, сенімді болу үшін сұрайын. Мен келісемін. Иә.
Dialogue: 0,0:08:38.48,0:08:40.65,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:08:40.65,0:08:42.65,Default,,0,0,0,,Аозора мырза. иә?
Dialogue: 0,0:08:45.49,0:08:47.49,Default,,0,0,0,,Жоқ, бұл сөзсіз басқаша!
Dialogue: 0,0:08:47.49,0:08:49.99,Default,,0,0,0,,Цугуми Аозора – оқу жылындағы ең сүйкімді.
Dialogue: 0,0:08:49.99,0:08:52.49,Default,,0,0,0,,Бірақ... Біріншіден, қалай сұраймын?
Dialogue: 0,0:08:52.49,0:08:55.66,Default,,0,0,0,,Сіз өзіңізді еркекпін деп анық айта аласыз ба? Хмм….
Dialogue: 0,0:08:55.66,0:08:58.67,Default,,0,0,0,,Эй, ойын ойнағың келе ме?
Dialogue: 0,0:08:58.67,0:09:00.60,Default,,0,0,0,,Ойын ба?
Dialogue: 0,0:09:00.60,0:09:05.77,Default,,0,0,0,,Бұл менің Аозора-санға неліктен шақырғанымды болжайтын ойын!
Dialogue: 0,0:09:05.77,0:09:10.78,Default,,0,0,0,,《Оливия қатты қобалжығанда, ол жалған шетелдікке ұқсай бастайды.》
Dialogue: 0,0:09:10.78,0:09:12.78,Default,,0,0,0,,Жарайды, қызықты көрінеді.
Dialogue: 0,0:09:12.78,0:09:15.62,Default,,0,0,0,,Жақсы жұмыс, Оливия. Әзірге➡
Dialogue: 0,0:09:15.62,0:09:18.29,Default,,0,0,0,,Мен сөйлесуге мүмкіндік жасай алдым! Иә.
Dialogue: 0,0:09:18.29,0:09:22.46,Default,,0,0,0,,Олай болса, Аозора-сан, мен саған сұрақ қоюдан бастайын.
Dialogue: 0,0:09:22.46,0:09:24.96,Default,,0,0,0,,Ол бойынша сұрақтар қойыңыз.
Dialogue: 0,0:09:24.96,0:09:28.13,Default,,0,0,0,,''ИӘ'', ''ЖОҚ'' немесе ''Маңызды емес'' деп жауап беріңіз.
Dialogue: 0,0:09:28.13,0:09:30.13,Default,,0,0,0,,-ға көшейік.
Dialogue: 0,0:09:30.13,0:09:33.47,Default,,0,0,0,,Мен кеше түнде ұйықтай алмадым.
Dialogue: 0,0:09:33.47,0:09:35.47,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:35.47,0:09:39.81,Default,,0,0,0,,Мұның мені не үшін шақырғаныңызға қатысы бар ма?
Dialogue: 0,0:09:39.81,0:09:41.98,Default,,0,0,0,,Мен… Иса….
Dialogue: 0,0:09:41.98,0:09:44.65,Default,,0,0,0,,《Айсора-сан, бұл бірінші жақтағы мен бе? 》
Dialogue: 0,0:09:44.65,0:09:46.65,Default,,0,0,0,,《Осы кезде ол әлдеқашан шығып кеткен сияқты》
Dialogue: 0,0:09:46.65,0:09:49.65,Default,,0,0,0,,《Бұл менің қызым болуы мүмкін, сондықтан мен әлі де сенімді емеспін...》
Dialogue: 0,0:09:49.65,0:09:51.65,Default,,0,0,0,,Шу болды ма?
Dialogue: 0,0:09:51.65,0:09:54.99,Default,,0,0,0,,Сол дүрбелең. Мен… Иса….
Dialogue: 0,0:09:54.99,0:09:57.83,Default,,0,0,0,,Әңгіменің мазмұны Сіз естідіңіз бе?
Dialogue: 0,0:09:57.83,0:10:00.16,Default,,0,0,0,,Мен… Мен… Жоқ….
Dialogue: 0,0:10:00.16,0:10:02.16,Default,,0,0,0,,№.
Dialogue: 0,0:10:02.16,0:10:04.50,Default,,0,0,0,,Эй, Оливия, сен неге сонша шуақсың! ?
Dialogue: 0,0:10:04.50,0:10:06.50,Default,,0,0,0,,Жоқ, кешіріңіз, мен біраз қорықтым.
Dialogue: 0,0:10:06.50,0:10:08.50,Default,,0,0,0,,Қанша жерден естідің?
Dialogue: 0,0:10:08.50,0:10:12.01,Default,,0,0,0,,А... сен... от...
Dialogue: 0,0:10:12.01,0:10:15.51,Default,,0,0,0,,Тыныш. Уф….
Dialogue: 0,0:10:15.51,0:10:19.68,Default,,0,0,0,,Жоқ! Мен енді мұны істей алмаймын, мен бұл шиеленісті көтере алмаймын!
Dialogue: 0,0:10:19.68,0:10:21.68,Default,,0,0,0,,Маған не үшін шақырғаныңызды түсіндім.
Dialogue: 0,0:10:21.68,0:10:23.85,Default,,0,0,0,,Бірақ бұл түсінбеушілік.
Dialogue: 0,0:10:23.85,0:10:27.52,Default,,0,0,0,,Мен ол жігітпен ажырасқым келгендіктен өтірік айттым.
Dialogue: 0,0:10:27.52,0:10:29.86,Default,,0,0,0,,Мен мүлде сәтсіз болдым.
Dialogue: 0,0:10:29.86,0:10:33.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:33.70,0:10:36.70,Default,,0,0,0,,Біртүрлі түсінбеушілік үшін кешіріңіз. 《Қорқынышты》
Dialogue: 0,0:10:36.70,0:10:41.20,Default,,0,0,0,,Бірақ неліктен дене шынықтыру кезінде ваннада үнемі киім ауыстырасың?
Dialogue: 0,0:10:41.20,0:10:43.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.20,0:10:47.54,Default,,0,0,0,,Өйткені... жұрттың көзінше киім ауыстыру ұят.
Dialogue: 0,0:10:47.54,0:10:49.71,Default,,0,0,0,,《сүйкімді》 《кюн》
Dialogue: 0,0:10:49.71,0:10:51.71,Default,,0,0,0,,《Балықтың иісі бар》
Dialogue: 0,0:10:51.71,0:10:55.62,Default,,0,0,0,,<Жануарлар дағдарысын басқару тек Ханако үшін белсендірілген>
Dialogue: 0,0:11:02.49,0:11:06.66,Default,,0,0,0,,Ока мырза... Кешіріңіз, бірақ➡
Dialogue: 0,0:11:06.66,0:11:10.33,Default,,0,0,0,,Енді сіз Паранормальды ғылым клубында жалғызсыз➡
Dialogue: 0,0:11:10.33,0:11:12.50,Default,,0,0,0,,Осы маусымда 5 адам жинай алмасақ➡
Dialogue: 0,0:11:12.50,0:11:16.17,Default,,0,0,0,,Біз келесі тоқсанда клуб өткіземіз.
Dialogue: 0,0:11:16.17,0:11:18.17,Default,,0,0,0,,Тіпті клубта➡
Dialogue: 0,0:11:18.17,0:11:20.88,Default,,0,0,0,,Біз сынып ақысы үшін 10 000 иен төлейміз.
Dialogue: 0,0:11:27.52,0:11:30.32,Default,,0,0,0,,《Бұл... қорқынышты болды》
Dialogue: 0,0:11:32.35,0:11:34.86,Default,,0,0,0,,《Ока: Өйткені менің таңдауым жоқ.
Dialogue: 0,0:11:34.86,0:11:39.03,Default,,0,0,0,,Екеуміз мектеп бітірдік, біріміз басқа мектепке ауыстық➡
Dialogue: 0,0:11:39.03,0:11:42.20,Default,,0,0,0,,Соңғысы ауыстырылды.
Dialogue: 0,0:11:42.20,0:11:48.04,Default,,0,0,0,,Мен бір жерде оккультизмге қызығатын біреу бар ма деп ойлаймын.
Dialogue: 0,0:11:48.04,0:11:51.04,Default,,0,0,0,,⚟Кеттік~ Коккури-сан Коккури-сан➡
Dialogue: 0,0:11:51.04,0:11:54.54,Default,,0,0,0,,Келгіңіз келсе, «Иә» түймесін басыңыз.
Dialogue: 0,0:11:54.54,0:11:56.54,Default,,0,0,0,,Хмм….
Dialogue: 0,0:11:59.71,0:12:04.42,Default,,0,0,0,,Менің жыртық шалбарыма біртүрлі аппликацияны кім салды?
Dialogue: 0,0:12:07.66,0:12:09.82,Default,,0,0,0,,Тәтті, менің ойымша!
Dialogue: 0,0:12:09.82,0:12:12.33,Default,,0,0,0,,《Жақсы, мен бұл Маэда мырза деп ойладым, бірақ мен оны жылжыттым➡
Dialogue: 0,0:12:12.33,0:12:15.33,Default,,0,0,0,,Олардың бәрі бірдей болғанына қуаныштымын.》 《Мен де Маэда Чан деп ойладым.》
Dialogue: 0,0:12:15.33,0:12:17.83,Default,,0,0,0,,Келесіде, Оливия, менен сұрағың келетін нәрсе бар ма?
Dialogue: 0,0:12:17.83,0:12:20.17,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:12:20.17,0:12:22.67,Default,,0,0,0,,Мм... бұл!
Dialogue: 0,0:12:22.67,0:12:25.01,Default,,0,0,0,,Сәлем! Кешіріңіз!
Dialogue: 0,0:12:25.01,0:12:27.68,Default,,0,0,0,,Жай ғана қыңырлық! Бұл Коккури-сан, солай ма?
Dialogue: 0,0:12:27.68,0:12:30.01,Default,,0,0,0,,Не? Жоқ... 4 жұп...
Dialogue: 0,0:12:30.01,0:12:32.01,Default,,0,0,0,,Жоқ... у...
Dialogue: 0,0:12:32.01,0:12:34.68,Default,,0,0,0,,Оккультизм... Сізге ұнай ма? иә?
Dialogue: 0,0:12:34.68,0:12:37.02,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:37.02,0:12:39.85,Default,,0,0,0,,Эх!
Dialogue: 0,0:12:39.85,0:12:41.86,Default,,0,0,0,,《Не? « «не? 》
Dialogue: 0,0:12:41.86,0:12:45.19,Default,,0,0,0,,Менімен ойнағың келе ме? иә?
Dialogue: 0,0:12:45.19,0:12:47.20,Default,,0,0,0,,Ал, сәл ғана.
Dialogue: 0,0:12:47.20,0:12:50.03,Default,,0,0,0,,А, мұқият қарасаңыз, бұл 4-сыныптағы Ока-сан!
Dialogue: 0,0:12:50.03,0:12:52.37,Default,,0,0,0,,《Жақыннан қарамай-ақ айтуға болады! 》
Dialogue: 0,0:12:52.37,0:12:58.04,Default,,0,0,0,,Иә... Мен әдетте табиғаттан тыс ғылым бөлімі ретінде белгілі Паранормальды ғылым бөлімінің мүшесімін.
Dialogue: 0,0:12:58.04,0:13:01.48,Default,,0,0,0,,Бірақ қазір мен клубтың жалғыз мүшесімін➡
Dialogue: 0,0:13:01.48,0:13:04.48,Default,,0,0,0,,Бұлай жалғаса берсе, келесі тоқсан клубқа айналады.
Dialogue: 0,0:13:04.48,0:13:09.48,Default,,0,0,0,,Уфуфу... Сонда сіздің Асокеніңізбен бірдей болар еді.
Dialogue: 0,0:13:11.49,0:13:14.16,Default,,0,0,0,,《Үш адам: Ой, біз де клубпыз➡
Dialogue: 0,0:13:14.16,0:13:16.16,Default,,0,0,0,,Бұл рұқсат етілмеген бе? 》
Dialogue: 0,0:13:16.16,0:13:18.99,Default,,0,0,0,,Олай болса, сіз басқа оккультизмге ұқсас ойындарды білесіз бе?
Dialogue: 0,0:13:18.99,0:13:23.33,Default,,0,0,0,,Бұл оккультизмге ұқсас ойын ма? Хмм, дұрыс.
Dialogue: 0,0:13:23.33,0:13:25.33,Default,,0,0,0,,Жалғыз жасырынбақ ойнау.
Dialogue: 0,0:13:25.33,0:13:28.34,Default,,0,0,0,,Бұл қандай нәрсе? А, сізде тұлыптар бар ма?
Dialogue: 0,0:13:28.34,0:13:30.34,Default,,0,0,0,,Бұл жақсы ма?\NҚысқаша түсініктеме
Dialogue: 0,0:13:30.34,0:13:32.34,Default,,0,0,0,,-да берілген.
Dialogue: 0,0:13:32.34,0:13:34.51,Default,,0,0,0,,Негізі түнде жасаймын➡
Dialogue: 0,0:13:34.51,0:13:37.35,Default,,0,0,0,,Бұл жай ғана көңіл көтеру үшін, сондықтан оны әзірге елемейміз.
Dialogue: 0,0:13:37.35,0:13:40.68,Default,,0,0,0,,1 Ішіндегі мақтаны алыңыз.
Dialogue: 0,0:13:40.68,0:13:44.19,Default,,0,0,0,,2 Оның орнына күріш пен шеге қосыңыз➡
Dialogue: 0,0:13:44.19,0:13:46.35,Default,,0,0,0,,Қызыл жіппен тігу.
Dialogue: 0,0:13:46.35,0:13:51.53,Default,,0,0,0,,3 Қалған жіпті орап, осы балаға ат таңдаңыз.
Dialogue: 0,0:13:51.53,0:13:55.03,Default,,0,0,0,,Сіз қандай есімді қалар едіңіз? Жарайды, Маэда.
Dialogue: 0,0:13:55.03,0:13:58.03,Default,,0,0,0,,Төрт адамнан топ құрайық.
Dialogue: 0,0:13:58.03,0:13:59.97,Default,,0,0,0,,Ал, Асокен командасына қосылайық!
Dialogue: 0,0:13:59.97,0:14:04.31,Default,,0,0,0,,Бірінші жын - Асокен тобы Бірінші жын - Асокен командасы.
Dialogue: 0,0:14:04.31,0:14:06.97,Default,,0,0,0,,Бірінші жын – Оқакен командасы.
Dialogue: 0,0:14:06.97,0:14:08.98,Default,,0,0,0,,《Иә? 》 《Ұрлап алды ма? 》
Dialogue: 0,0:14:08.98,0:14:11.98,Default,,0,0,0,,Енді мұны раковинаның ішіне салыңыз.
Dialogue: 0,0:14:11.98,0:14:14.28,Default,,0,0,0,,Барлығымыз жуынатын бөлмеге барайық.
Dialogue: 0,0:14:16.32,0:14:21.52,Default,,0,0,0,,Бір жерде теледидар... А, сосын ұялы телефон 1сек.
Dialogue: 0,0:14:23.49,0:14:25.66,Default,,0,0,0,,10 секундқа көзіңізді жұмыңыз.
Dialogue: 0,0:14:25.66,0:14:27.66,Default,,0,0,0,,Және кері….
Dialogue: 0,0:14:27.66,0:14:30.87,Default,,0,0,0,,Маэда мен таптым.
Dialogue: 0,0:14:34.84,0:14:37.67,Default,,0,0,0,,Келесі - Маэда Они.
Dialogue: 0,0:14:37.67,0:14:43.01,Default,,0,0,0,,Сосын бір стақан тұзды су алып, бір жерге тығыл.
Dialogue: 0,0:14:43.01,0:14:48.62,Default,,0,0,0,,Қайсысы жақсы? А... сосын клуб бөлмесіндегі партаның астында шығар.
Dialogue: 0,0:14:52.02,0:14:57.36,Default,,0,0,0,,《Ессіз... өте қызық》
Dialogue: 0,0:14:57.36,0:15:00.13,Default,,0,0,0,,А... Не?
Dialogue: 0,0:15:00.13,0:15:03.46,Default,,0,0,0,,Әй, мұның не құпиясы бар? Ах.
Dialogue: 0,0:15:03.46,0:15:05.47,Default,,0,0,0,,Менің естігенім бойынша➡
Dialogue: 0,0:15:05.47,0:15:08.64,Default,,0,0,0,,Бізді іздеп келе жатқан тұлыптар сияқты бірдеңе.
Dialogue: 0,0:15:08.64,0:15:10.64,Default,,0,0,0,,Иә! ? Гах!
Dialogue: 0,0:15:10.64,0:15:13.14,Default,,0,0,0,,Бұл қарғыс ойыны емес пе? ?
Dialogue: 0,0:15:13.14,0:15:15.14,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:15:15.14,0:15:19.48,Default,,0,0,0,,Егер біз оны іздейтін болсақ, бәріміз тұзды суды айналып өтіп, оны ішуіміз керек.
Dialogue: 0,0:15:19.48,0:15:22.82,Default,,0,0,0,,Иә, иә, иә! Іштей жұт... Әй, бір-бір тістесе жарайды.
Dialogue: 0,0:15:22.82,0:15:25.32,Default,,0,0,0,,Мен тұлыпқа ақша қалдыруым керек.
Dialogue: 0,0:15:25.32,0:15:27.82,Default,,0,0,0,,Ха ха ха ха... Маэда!
Dialogue: 0,0:15:34.16,0:15:38.50,Default,,0,0,0,,Не? Шынымен кетті ме?
Dialogue: 0,0:15:38.50,0:15:41.84,Default,,0,0,0,,Не істеуім керек... Тезірек табуым керек➡
Dialogue: 0,0:15:41.84,0:15:45.34,Default,,0,0,0,,Ол зат бізді іздей береді.
Dialogue: 0,0:15:45.34,0:15:47.34,Default,,0,0,0,,Uiii~!
Dialogue: 0,0:15:47.34,0:15:50.34,Default,,0,0,0,,Кескіште тұрып қалған тезек туралы біреу біледі ме?
Dialogue: 0,0:15:50.34,0:15:53.01,Default,,0,0,0,,Кескішке тезек кептеліп қалды! Ха, Ханако-сан!
Dialogue: 0,0:15:53.01,0:15:56.52,Default,,0,0,0,,Уф…. Эй, Оливия, жақсысың ба?
Dialogue: 0,0:15:56.52,0:16:01.62,Default,,0,0,0,,Мен өзімді керемет деп ойладым, бірақ мен қорқынышты ұнатпаймын!
Dialogue: 0,0:16:01.62,0:16:04.79,Default,,0,0,0,,А, мен түсіндім. Бұл кейіпкердің бұзылуына себеп болатындай қорқынышты.
Dialogue: 0,0:16:04.79,0:16:06.79,Default,,0,0,0,,Ах, кешіккенім үшін кешіріңіз.
Dialogue: 0,0:16:06.79,0:16:08.80,Default,,0,0,0,,Мұғалім! Маэда: Мен көрмедім! ?
Dialogue: 0,0:16:08.80,0:16:11.13,Default,,0,0,0,,Кио мен оны бүгін көрмедім, бірақ...
Dialogue: 0,0:16:11.13,0:16:14.64,Default,,0,0,0,,Мұғалім! Үстінде тезегі бар кескіш - Маэда ➡
Dialogue: 0,0:16:14.64,0:16:17.97,Default,,0,0,0,,Таптым деген соң, өртеп жіберіңізші!
Dialogue: 0,0:16:17.97,0:16:20.48,Default,,0,0,0,,《Хонда-сан, сен қалпақ ұнтағын тым көп жұттың деп ойлаймын》
Dialogue: 0,0:16:20.48,0:16:22.48,Default,,0,0,0,,Мұғалім Оливия...
Dialogue: 0,0:16:22.48,0:16:26.31,Default,,0,0,0,,Нәжістен қалай құтылуға болады?
Dialogue: 0,0:16:26.31,0:16:28.82,Default,,0,0,0,,Оливия-сан, дәрігермен бірге медбикенің кабинетіне барғың келе ме?
Dialogue: 0,0:16:28.82,0:16:33.32,Default,,0,0,0,,А, мен өзім жасыруға тырыспауым керек еді!
Dialogue: 0,0:16:33.32,0:16:35.32,Default,,0,0,0,,Бұл белгілі бір телеарнадағы тамақ әзірлеу бағдарламасы ма?
Dialogue: 0,0:16:35.32,0:16:37.49,Default,,0,0,0,,⚟Бұл сіздің өміріңіздің соңы! Аа….
Dialogue: 0,0:16:37.49,0:16:40.83,Default,,0,0,0,,Раковинаға нәжім түскенім үшін кешіруіңізді қалаймын.
Dialogue: 0,0:16:40.83,0:16:43.33,Default,,0,0,0,,Мен қайта жуған жігіт өте жақсы жігіт екен.
Dialogue: 0,0:16:43.33,0:16:45.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:54.01,0:16:56.01,Default,,0,0,0,,Әй, біз бүгін қайда тоқтаймыз?
Dialogue: 0,0:16:56.01,0:16:58.51,Default,,0,0,0,,Аа, кешіріңіз, мен бүгін кешке жігітіммен боламын.
Dialogue: 0,0:16:58.51,0:17:00.45,Default,,0,0,0,,Иә? Солай ма? А, мүмкін➡
Dialogue: 0,0:17:00.45,0:17:02.62,Default,,0,0,0,,Сіз өткен күні алып кеткен адам? о иә.
Dialogue: 0,0:17:02.62,0:17:04.62,Default,,0,0,0,,Соңында біз осыдан кейін дұрыс танысуды аяқтадық.
Dialogue: 0,0:17:04.62,0:17:06.62,Default,,0,0,0,,Керемет~ Мен келесі аптада боламын➡
Dialogue: 0,0:17:06.62,0:17:09.62,Default,,0,0,0,,Мен жігітіммен Майхамада теңізге барамын. Әй, жақсы.
Dialogue: 0,0:17:09.62,0:17:11.96,Default,,0,0,0,,Мен де қайыр сұрап көрейін деп ойлаймын. Қанекей мынаны істейік. Қанекей мынаны істейік.
Dialogue: 0,0:17:11.96,0:17:14.96,Default,,0,0,0,,Жақсырақ, неге қос кездесуге бармасқа? О, бұл өте жақсы!
Dialogue: 0,0:17:14.96,0:17:18.97,Default,,0,0,0,,А... Мен жігітті қалаймын.
Dialogue: 0,0:17:21.47,0:17:23.97,Default,,0,0,0,,Неліктен? Неліктен? Дұрыс, сен➡
Dialogue: 0,0:17:23.97,0:17:27.07,Default,,0,0,0,,Егер сіз әйел болып туылған болсаңыз, бір-екі жігітті қалайтын шығарсыз!
Dialogue: 0,0:17:29.14,0:17:31.65,Default,,0,0,0,,Бұл ауыртпалық емес пе? Бұл қиындық емес!
Dialogue: 0,0:17:31.65,0:17:34.48,Default,,0,0,0,,Менің де жігітіммен жағаға барғым келеді! Ханако….
Dialogue: 0,0:17:34.48,0:17:36.82,Default,,0,0,0,,Еркек келсе, Маэда-чанмен бірге бару керек.
Dialogue: 0,0:17:36.82,0:17:39.32,Default,,0,0,0,,Маэдамен бірге жүрудің не қызығы бар деп ойлаймын! ?
Dialogue: 0,0:17:39.32,0:17:44.49,Default,,0,0,0,,Маған бір жастағы ұлдар ұнайды! Иә, иә.
Dialogue: 0,0:17:44.49,0:17:48.00,Default,,0,0,0,,Ах Касуми. Кеш болды. Өйткені мен қызметте болдым.
Dialogue: 0,0:17:48.00,0:17:50.67,Default,,0,0,0,,Сіз не туралы айттыңыз?
Dialogue: 0,0:17:50.67,0:17:52.67,Default,,0,0,0,,Жігіт! иә?
Dialogue: 0,0:17:54.84,0:17:56.84,Default,,0,0,0,,Өмір бойы сәл артық➡
Dialogue: 0,0:17:56.84,0:17:59.34,Default,,0,0,0,,Мағыналы әңгімелер болғаны дұрыс емес пе?
Dialogue: 0,0:17:59.34,0:18:03.11,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:03.11,0:18:05.95,Default,,0,0,0,,Бірақ Касуми-сан, сен солай айттың➡
Dialogue: 0,0:18:05.95,0:18:07.95,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:18:07.95,0:18:12.29,Default,,0,0,0,,Касуми сияқты адамдар тез үйленеді!
Dialogue: 0,0:18:12.29,0:18:14.29,Default,,0,0,0,,Статистика кімдікі?
Dialogue: 0,0:18:14.29,0:18:17.46,Default,,0,0,0,,Бірақ Ханаконың жігіті болуы мүмкін емес деп ойлаймын.
Dialogue: 0,0:18:17.46,0:18:20.80,Default,,0,0,0,,Бұл нені білдіреді? ? Өйткені оның мінезі нашар.
Dialogue: 0,0:18:20.80,0:18:26.47,Default,,0,0,0,,Жігіт алғың келсе, қарапайым болу керек.
Dialogue: 0,0:18:26.47,0:18:28.97,Default,,0,0,0,,Көрдім, ол сондай үлпілдек.
Dialogue: 0,0:18:28.97,0:18:31.31,Default,,0,0,0,,Жарайды, жігіті жоқ адамның пікірі➡
Dialogue: 0,0:18:31.31,0:18:33.81,Default,,0,0,0,,Оның құны сіз тезекпен сүрткен дәретхана қағазымен бірдей➡
Dialogue: 0,0:18:33.81,0:18:35.81,Default,,0,0,0,,Мен оны тек анықтама ретінде қолданамын. Жасыру!
Dialogue: 0,0:18:35.81,0:18:37.81,Default,,0,0,0,,Айтайын дегенім, міне, міне, мінекей!
Dialogue: 0,0:18:37.81,0:18:42.65,Default,,0,0,0,,Жарайды, мен әлемдегі ең жақсы жігітке ие боламын!
Dialogue: 0,0:18:42.65,0:18:45.99,Default,,0,0,0,,《2 адам: Иә? Сіз осындай шкала туралы айттыңыз ба? 》
Dialogue: 0,0:18:45.99,0:18:48.49,Default,,0,0,0,,Ең алдымен жігітке не алғың келеді?
Dialogue: 0,0:18:48.49,0:18:50.66,Default,,0,0,0,,Ал...
Dialogue: 0,0:18:50.66,0:18:54.16,Default,,0,0,0,,Бұл сәл ертерек болуы мүмкін➡
Dialogue: 0,0:18:54.16,0:18:57.67,Default,,0,0,0,,Уууу, бұл ұят.
Dialogue: 0,0:18:57.67,0:19:02.57,Default,,0,0,0,,Қол ұстасып бірге жүргім келеді.
Dialogue: 0,0:19:04.44,0:19:09.44,Default,,0,0,0,,Одан кейін 25 жасымда тұрмысқа шығып, екі балалы болғым келеді.
Dialogue: 0,0:19:09.44,0:19:13.28,Default,,0,0,0,,Балалы болуды білесіз бе? Мен білемін.
Dialogue: 0,0:19:13.28,0:19:15.62,Default,,0,0,0,,Сіз мұны француз сүйіспеншілігімен жасай аласыз, солай ма?
Dialogue: 0,0:19:15.62,0:19:19.95,Default,,0,0,0,,Француз поцелуінің не екенін білесіз бе? Ол Kiss ➡ деп аталады
Dialogue: 0,0:19:19.95,0:19:22.62,Default,,0,0,0,,Бұл сүйісу емес пе? Жоқ... бұл поцелу.
Dialogue: 0,0:19:22.62,0:19:25.46,Default,,0,0,0,,Иә? Солай ма? Сонымен, француз дегеніміз не?
Dialogue: 0,0:19:25.46,0:19:27.80,Default,,0,0,0,,Ал... А, түсіндім!
Dialogue: 0,0:19:27.80,0:19:30.63,Default,,0,0,0,,Фуручинкис сленг емес пе?
Dialogue: 0,0:19:30.63,0:19:32.97,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:19:32.97,0:19:36.30,Default,,0,0,0,,Сонымен... Иегіңді толық сүйсең, балалы болады.
Dialogue: 0,0:19:36.30,0:19:38.31,Default,,0,0,0,,Е. Мен түсінемін. Эй, эй!
Dialogue: 0,0:19:38.31,0:19:41.14,Default,,0,0,0,,Мүлде жоқ! Толық... Қандай да бір жолмен?➡
Dialogue: 0,0:19:41.14,0:19:43.31,Default,,0,0,0,,Бұл мүлдем маңызды емес! (Ханако/Оливия) Иә?
Dialogue: 0,0:19:43.31,0:19:46.98,Default,,0,0,0,,Баланы осылай жасайсың...
Dialogue: 0,0:19:46.98,0:19:49.82,Default,,0,0,0,,Бұл… бұл….
Dialogue: 0,0:19:49.82,0:19:53.32,Default,,0,0,0,,Гах... Гатчин...
Dialogue: 0,0:19:53.32,0:19:55.82,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:19:55.82,0:19:59.16,Default,,0,0,0,,Уау! Менің еркектерді жек көруімнің себебі осы!
Dialogue: 0,0:19:59.16,0:20:01.16,Default,,0,0,0,,Енді ше? Роботтардың деформацияланған комбинациясы?
Dialogue: 0,0:20:01.16,0:20:03.16,Default,,0,0,0,,Олай болса мына екі қуыршақты пайдаланыңыз➡
Dialogue: 0,0:20:03.16,0:20:08.17,Default,,0,0,0,,Баланы қалай жасау керектігін айтыңызшы. Бұл қуыршақ па? Содан кейін...
Dialogue: 0,0:20:08.17,0:20:13.37,Default,,0,0,0,,Ах... у... Хмм... Хм....
Dialogue: 0,0:20:15.84,0:20:18.51,Default,,0,0,0,,Кешіріңіз, бұл шектеу.
Dialogue: 0,0:20:18.51,0:20:21.35,Default,,0,0,0,,《Мен енді түсінбеймін》 Бұл не?
Dialogue: 0,0:20:21.35,0:20:23.35,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:20:23.35,0:20:27.02,Default,,0,0,0,,Ер адам әйелдің үстіне шығады. Сіз билікке алған кезде не істейсіз?
Dialogue: 0,0:20:27.02,0:20:30.69,Default,,0,0,0,,Үстіндегі адам радиотолқындарды төмендегі адамның миына тікелей жібереді.
Dialogue: 0,0:20:30.69,0:20:36.53,Default,,0,0,0,,Балалар декиро ыдысы, балалар тукуры. Ужас! Өйткені бұл мүлдем қорқынышты!
Dialogue: 0,0:20:36.53,0:20:40.20,Default,,0,0,0,,Барлығы~ Кешіктіргеніміз үшін кешіріңіз. Әй, ұстаз, дәл солай болды.
Dialogue: 0,0:20:40.20,0:20:42.20,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім. иә?
Dialogue: 0,0:20:42.20,0:20:44.21,Default,,0,0,0,,Сіз баланы қалай жасайсыз? Эх...
Dialogue: 0,0:20:44.21,0:20:47.37,Default,,0,0,0,,Бұл туралы бәрің де денсаулық сабағында білген жоқсыңдар ма?
Dialogue: 0,0:20:47.37,0:20:50.21,Default,,0,0,0,,Ах…. (Ханако/Оливия) № 《Ача~》
Dialogue: 0,0:20:50.21,0:20:52.71,Default,,0,0,0,,Көрдіңіз бе...
Dialogue: 0,0:20:52.71,0:20:59.05,Default,,0,0,0,,Әй... адам... Әй, адам...
Dialogue: 0,0:20:59.05,0:21:01.66,Default,,0,0,0,,《Сөзбен түсіндіру мүмкін емес~》
Dialogue: 0,0:21:01.66,0:21:03.66,Default,,0,0,0,,Мұғалім де білмейді...
Dialogue: 0,0:21:03.66,0:21:05.99,Default,,0,0,0,,көремін. Жарайды, көмектесу мүмкін емес➡
Dialogue: 0,0:21:05.99,0:21:08.83,Default,,0,0,0,,Мұғалім мен үйленбегенмін. 《Мен оңай келісемін! 》
Dialogue: 0,0:21:08.83,0:21:12.17,Default,,0,0,0,,Маған осы қуыршақты қалай пайдалану керектігін біреу үйрете ме деп ойлаймын.
Dialogue: 0,0:21:12.17,0:21:14.17,Default,,0,0,0,,Аа, егер ол ауызша емес болса, сіз мұны істей аласыз.
Dialogue: 0,0:21:14.17,0:21:16.17,Default,,0,0,0,,Не? Мен қазір білмеймін ...
Dialogue: 0,0:21:16.17,0:21:18.34,Default,,0,0,0,,А, жауап кенет келді.
Dialogue: 0,0:21:18.34,0:21:20.34,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:21:20.34,0:21:23.68,Default,,0,0,0,,《Менің ойымша, бұл туралы досым кеше айтты...》
Dialogue: 0,0:21:23.68,0:21:28.18,Default,,0,0,0,,｟Уау, бұл ең жақсы болды. Эй~
Dialogue: 0,0:21:28.18,0:21:30.18,Default,,0,0,0,,《Мен сенімдімін...》
Dialogue: 0,0:21:32.19,0:21:34.19,Default,,0,0,0,,Иә? Цирк?
Dialogue: 0,0:21:34.19,0:21:37.53,Default,,0,0,0,,Иә...бірақ менің досым бұл өте жақсы сезінді деді.
Dialogue: 0,0:21:37.53,0:21:39.86,Default,,0,0,0,,Иә? «мұғалім...
Dialogue: 0,0:21:39.86,0:21:41.86,Default,,0,0,0,,Мен бұл қалыпты болғанын қалаймын》
Dialogue: 0,0:21:41.86,0:21:46.03,Default,,0,0,0,,Мұғалім: Мен мұны мүлдем түсінбеймін. Жарайды, тағы бір нәрсе.
Dialogue: 0,0:21:46.03,0:21:48.04,Default,,0,0,0,,Түсінуге оңай басқасын жасаңыз.
Dialogue: 0,0:21:50.70,0:21:52.71,Default,,0,0,0,,Иә? қарақат….
Dialogue: 0,0:21:52.71,0:21:55.71,Default,,0,0,0,,Мынаны көргенде солай ойладым➡
Dialogue: 0,0:21:55.71,0:21:58.05,Default,,0,0,0,,Балалы болудың қажеті жоқ.
Dialogue: 0,0:21:58.05,0:21:59.98,Default,,0,0,0,,Оқу ақысы да қымбат. Иә.
Dialogue: 0,0:21:59.98,0:22:03.48,Default,,0,0,0,,Мен біраз алғым келеді, сэр. а….
Dialogue: 0,0:22:03.48,0:22:06.65,Default,,0,0,0,,＜Кішкентай балалардың мәселесі күрделі бола ма?➡
Dialogue: 0,0:22:06.65,0:22:09.66,Default,,0,0,0,,Біз оны тоқтататын күн келе ме? ＞
Dialogue: 0,0:22:11.16,0:22:17.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
