Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.62,0:00:30.64,Default,,0,0,0,,♪
Dialogue: 0,0:00:30.64,0:00:50.66,Default,,0,0,0,,♪
Dialogue: 0,0:00:50.66,0:00:59.67,Default,,0,0,0,,♪
Dialogue: 0,0:00:59.67,0:01:01.61,Default,,0,0,0,,Иә, қош келдіңіз!
Dialogue: 0,0:01:01.61,0:01:05.61,Default,,0,0,0,,А? Ах, сурет ше?
Dialogue: 0,0:01:07.61,0:01:10.62,Default,,0,0,0,,Виртуалды шындық технологиясы
Dialogue: 0,0:01:10.62,0:01:12.62,Default,,0,0,0,,Виртуалды шындық?
Dialogue: 0,0:01:12.62,0:01:16.62,Default,,0,0,0,,Ауада сурет салған нәрсе шын мәнінде сол жерде сияқты.
Dialogue: 0,0:01:16.62,0:01:19.63,Default,,0,0,0,,Технология (Масао) керемет, солай емес пе?
Dialogue: 0,0:01:19.63,0:01:21.63,Default,,0,0,0,,Менің суретім тірі болғандай болды.
Dialogue: 0,0:01:21.63,0:01:23.63,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:01:23.63,0:01:26.63,Default,,0,0,0,,Казама-кун, сен мұны бұрын ешқашан істеген емессің, солай ма?
Dialogue: 0,0:01:26.63,0:01:28.64,Default,,0,0,0,,Жоқ, бұл шындық болуы мүмкін емес!
Dialogue: 0,0:01:28.64,0:01:31.64,Default,,0,0,0,,Бұл сыныпты лас қалдырмайтын пайдалы құрал.
Dialogue: 0,0:01:31.64,0:01:33.64,Default,,0,0,0,,Иә, келіңіз.
Dialogue: 0,0:01:33.64,0:01:36.64,Default,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені сала аласыз.
Dialogue: 0,0:01:36.64,0:01:38.65,Default,,0,0,0,,Сөздеріңізді бағалаймын.
Dialogue: 0,0:01:38.65,0:01:40.65,Default,,0,0,0,,Жарайды, жарайды~
Dialogue: 0,0:01:40.65,0:01:44.65,Default,,0,0,0,,Хохо хой хой аа!
Dialogue: 0,0:01:44.65,0:01:46.65,Default,,0,0,0,,Қазірдің өзінде! Мұндай жерлерде сурет салуға болмайды, солай ма?
Dialogue: 0,0:01:46.65,0:01:50.66,Default,,0,0,0,,Қалағаныңды сала аласың дедім!
Dialogue: 0,0:01:50.66,0:01:53.66,Default,,0,0,0,,Ах! Кәне! иә?
Dialogue: 0,0:01:53.66,0:01:56.66,Default,,0,0,0,,Айтпақшы... Бұл не?
Dialogue: 0,0:01:56.66,0:01:58.67,Default,,0,0,0,,Әкем шешіп алған шалбар
Dialogue: 0,0:01:58.67,0:02:02.60,Default,,0,0,0,,Хааааааааа...
Dialogue: 0,0:02:02.60,0:02:04.60,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:02:04.60,0:02:24.62,Default,,0,0,0,,♪
Dialogue: 0,0:02:24.62,0:02:29.63,Default,,0,0,0,,♪
Dialogue: 0,0:02:29.63,0:02:32.63,Default,,0,0,0,,()
Dialogue: 0,0:02:32.63,0:02:34.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:34.63,0:02:38.64,Default,,0,0,0,,Бұл қандай керемет дудл!
Dialogue: 0,0:02:38.64,0:02:41.64,Default,,0,0,0,,Жақсы! (Тас дәуірінің адамы) Бұл мені тоңазытады.
Dialogue: 0,0:02:41.64,0:02:44.64,Default,,0,0,0,,Бұл алаңсыз дудл
Dialogue: 0,0:02:44.64,0:02:46.65,Default,,0,0,0,,) Ммм Дәмді
Dialogue: 0,0:02:46.65,0:02:49.65,Default,,0,0,0,,) Бум! Бум! Бум! Бум!
Dialogue: 0,0:02:49.65,0:02:52.65,Default,,0,0,0,,Керемет!
Dialogue: 0,0:02:55.66,0:02:58.66,Default,,0,0,0,,) Әй, сен баланы тастап жібердің!
Dialogue: 0,0:02:58.66,0:03:00.66,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:03:00.66,0:03:03.60,Default,,0,0,0,,Балалар дудл жасағылары келеді.
Dialogue: 0,0:03:03.60,0:03:05.60,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:03:05.60,0:03:07.60,Default,,0,0,0,,… ()
Dialogue: 0,0:03:07.60,0:03:09.60,Default,,0,0,0,,Кешірмейтін үлкендер!
Dialogue: 0,0:03:09.60,0:03:11.61,Default,,0,0,0,,Үлкендердің аузын жап
Dialogue: 0,0:03:11.61,0:03:14.61,Default,,0,0,0,,Балаларға дудл жасауға рұқсат беруден басқа амалыңыз болмайды!
Dialogue: 0,0:03:14.61,0:03:18.61,Default,,0,0,0,,Үлкендердің үнін өшіру керек пе? (Қорғаныс министрі) Иә.
Dialogue: 0,0:03:18.61,0:03:22.62,Default,,0,0,0,,Егер балалар әлі де дудл жасамаса ше?
Dialogue: 0,0:03:22.62,0:03:26.62,Default,,0,0,0,,Хехе, сен оны дудль жасауға мәжбүрлесең болғаны.
Dialogue: 0,0:03:26.62,0:03:29.62,Default,,0,0,0,,Жоқ... Мен бұған жол бермеймін!
Dialogue: 0,0:03:29.62,0:03:31.63,Default,,0,0,0,,Олай болса шешім қабылдап алайық.
Dialogue: 0,0:03:31.63,0:03:35.63,Default,,0,0,0,,Ересектердің үнін өшіру және балаларды дүлділдету стратегиясы
Dialogue: 0,0:03:35.63,0:03:37.63,Default,,0,0,0,,Атаңыз
Dialogue: 0,0:03:37.63,0:03:43.64,Default,,0,0,0,,Егер сіз Каки Каки операциясымен келіссеңіз, қолыңызды көтеріңіз.
Dialogue: 0,0:03:43.64,0:03:45.64,Default,,0,0,0,,Иә
Dialogue: 0,0:03:45.64,0:03:48.64,Default,,0,0,0,,) Эй, балалар...
Dialogue: 0,0:03:50.64,0:03:53.65,Default,,0,0,0,,Бұл жігіттер Хамонның қағидаларын біледі
Dialogue: 0,0:03:53.65,0:03:56.65,Default,,0,0,0,,Министрлер кабинетінің шешімдерін орындамағандар
Dialogue: 0,0:03:56.65,0:03:59.65,Default,,0,0,0,,Тіпті патшаны да тұтқынға алуға болады.
Dialogue: 0,0:03:59.65,0:04:01.59,Default,,0,0,0,,Әке!
Dialogue: 0,0:04:01.59,0:04:04.59,Default,,0,0,0,,Ха! (Солдат) Ханшайым... Мені кешіріңізші.
Dialogue: 0,0:04:04.59,0:04:08.59,Default,,0,0,0,,Хмм! (Солдат) Ханшайым! Ханшайым~!
Dialogue: 0,0:04:12.60,0:04:15.60,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:04:15.60,0:04:17.60,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:04:17.60,0:04:20.61,Default,,0,0,0,,Ааан
Dialogue: 0,0:04:20.61,0:04:23.61,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:04:27.61,0:04:30.62,Default,,0,0,0,,… ()～
Dialogue: 0,0:04:30.62,0:04:32.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:35.62,0:04:38.63,Default,,0,0,0,,Ммм (Сот суретшісі) О?
Dialogue: 0,0:04:38.63,0:04:40.63,Default,,0,0,0,,Мынау, ханшайым.
Dialogue: 0,0:04:40.63,0:04:42.63,Default,,0,0,0,,() ～
Dialogue: 0,0:04:42.63,0:04:46.63,Default,,0,0,0,,Кел! Қорғаныс министрі мұны іске асырды.
Dialogue: 0,0:04:46.63,0:04:48.63,Default,,0,0,0,,Оу, бұ да керемет екен. Сендер тез жеп қойыңдар.
Dialogue: 0,0:04:54.64,0:04:56.64,Default,,0,0,0,,Ой...
Dialogue: 0,0:04:56.64,0:05:05.59,Default,,0,0,0,,♪
Dialogue: 0,0:05:05.59,0:05:07.59,Default,,0,0,0,,Я...
Dialogue: 0,0:05:11.59,0:05:14.59,Default,,0,0,0,,Ханшайым! Не айтқың келеді?
Dialogue: 0,0:05:14.59,0:05:16.60,Default,,0,0,0,,Тек Кингтің қатысуымен
Dialogue: 0,0:05:16.60,0:05:18.60,Default,,0,0,0,,Сіз оны пайдаланбауыңыз керек! (Ханшайым) Уау!
Dialogue: 0,0:05:18.60,0:05:21.60,Default,,0,0,0,,Ух... (Сот суретшісі) Ах... Ах...
Dialogue: 0,0:05:27.61,0:05:29.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:36.62,0:05:38.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:38.62,0:05:40.62,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:05:40.62,0:05:43.62,Default,,0,0,0,,Қорғаныс министрінің қорқынышты стратегиясын тоқтатыңыз!
Dialogue: 0,0:05:43.62,0:05:46.63,Default,,0,0,0,,Ал мынау жердің батырына
Dialogue: 0,0:05:46.63,0:05:49.63,Default,,0,0,0,,Батыр? (Ханшайым) Мен жерде жатырмын.
Dialogue: 0,0:05:49.63,0:05:51.63,Default,,0,0,0,,Сол қарындашты қолдануға болады.
Dialogue: 0,0:05:51.63,0:05:55.64,Default,,0,0,0,,Бала алаңсыз дудлдар салады!
Dialogue: 0,0:05:55.64,0:05:58.64,Default,,0,0,0,,Уайымсыз дудлдер...
Dialogue: 0,0:06:01.57,0:06:03.58,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:06:03.58,0:06:05.58,Default,,0,0,0,,Ха, асығыңыз!
Dialogue: 0,0:06:05.58,0:06:07.58,Default,,0,0,0,,Ханшайым~!
Dialogue: 0,0:06:07.58,0:06:09.58,Default,,0,0,0,,Тоқтаңыз!
Dialogue: 0,0:06:09.58,0:06:13.59,Default,,0,0,0,,1 2 3… Да!!
Dialogue: 0,0:06:13.59,0:06:16.59,Default,,0,0,0,,Уау!! Апыр-ай! Апыр-ай!
Dialogue: 0,0:06:16.59,0:06:18.59,Default,,0,0,0,,Сенің арқаңдағы бұл парашют.
Dialogue: 0,0:06:18.59,0:06:20.59,Default,,0,0,0,,Парашу... (Сот суретшісі) Әй!
Dialogue: 0,0:06:20.59,0:06:22.60,Default,,0,0,0,,Ах…
Dialogue: 0,0:06:22.60,0:06:31.60,Default,,0,0,0,,♪
Dialogue: 0,0:06:31.60,0:06:35.61,Default,,0,0,0,,Ооо, ааа...
Dialogue: 0,0:06:35.61,0:06:40.61,Default,,0,0,0,,Ах!? Гах!
Dialogue: 0,0:06:40.61,0:06:42.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:42.62,0:06:46.62,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:06:46.62,0:06:48.62,Default,,0,0,0,,(сақинаны тарту дыбысы)
Dialogue: 0,0:06:48.62,0:06:51.62,Default,,0,0,0,,...
Dialogue: 0,0:06:51.62,0:06:55.62,Default,,0,0,0,,Ахаха міне, міне! Ахаха
Dialogue: 0,0:07:02.57,0:07:05.57,Default,,0,0,0,,Диеее...
Dialogue: 0,0:07:11.58,0:07:13.58,Default,,0,0,0,,Осы негізде
Dialogue: 0,0:07:13.58,0:07:16.58,Default,,0,0,0,,Батыр...
Dialogue: 0,0:07:16.58,0:07:20.59,Default,,0,0,0,,Бури Бури~ Бури Бури~ Сен ақымақсың. Жақсырақ болыңыз.
Dialogue: 0,0:07:20.59,0:07:22.59,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:32.60,0:07:36.60,Default,,0,0,0,,♪ Тұрақты кванттық робот
Dialogue: 0,0:07:36.60,0:07:38.61,Default,,0,0,0,,♪ ～
Dialogue: 0,0:07:38.61,0:07:42.61,Default,,0,0,0,,Аа... Эй, Шин Чан, өтінем, тез тамақтанып ал.
Dialogue: 0,0:07:42.61,0:07:47.61,Default,,0,0,0,,♪
Dialogue: 0,0:07:47.61,0:07:52.62,Default,,0,0,0,,Эй, мен бүгін тағы да ойын-сауық өткізіп жатырмын. Менеджермен барсам, көп уақыт кетеді.
Dialogue: 0,0:07:52.62,0:07:54.62,Default,,0,0,0,,Біз бұл шайқаста жеңіле алмаймыз!
Dialogue: 0,0:07:54.62,0:07:58.63,Default,,0,0,0,,Дұрыс~ Мен бұл жолы келісім-шарт алуым керек...
Dialogue: 0,0:07:58.63,0:08:00.63,Default,,0,0,0,,Менің де ішкім келсе де
Dialogue: 0,0:08:00.63,0:08:02.56,Default,,0,0,0,,Жоқ, барғым келмейді.
Dialogue: 0,0:08:02.56,0:08:05.57,Default,,0,0,0,,Сіз шайқастан қашып жүрсіз бе!? Кванттық кіші!
Dialogue: 0,0:08:05.57,0:08:07.57,Default,,0,0,0,,Кванттық кіші... деген кім?
Dialogue: 0,0:08:07.57,0:08:10.57,Default,,0,0,0,,Ааааааааааа! А, қазірдің өзінде!
Dialogue: 0,0:08:10.57,0:08:12.57,Default,,0,0,0,,Жылама! Жауынгерлерге тыныштық жоқ
Dialogue: 0,0:08:12.57,0:08:15.58,Default,,0,0,0,,Бұл сен кінәлісің! Ах!?
Dialogue: 0,0:08:15.58,0:08:18.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:18.58,0:08:20.58,Default,,0,0,0,,Су тасқыны! А, мен жасадым!
Dialogue: 0,0:08:20.58,0:08:22.58,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:08:22.58,0:08:24.58,Default,,0,0,0,,(ﾊﾞｽｸﾗｸｼｮﾝ)  ～
Dialogue: 0,0:08:24.58,0:08:27.59,Default,,0,0,0,,Автобус осында! Е!?
Dialogue: 0,0:08:27.59,0:08:30.59,Default,,0,0,0,,А, бұл жақсы емес. Миса, менің жаңа көйлегім қайда?
Dialogue: 0,0:08:30.59,0:08:32.59,Default,,0,0,0,,(ﾊﾞｽｸﾗｸｼｮﾝ)
Dialogue: 0,0:08:32.59,0:08:36.60,Default,,0,0,0,,Ах! Ой, бұл үй шулы.
Dialogue: 0,0:08:36.60,0:08:39.60,Default,,0,0,0,,Сіз айтасыз!
Dialogue: 0,0:08:39.60,0:08:41.60,Default,,0,0,0,,Кун…
Dialogue: 0,0:08:41.60,0:08:46.61,Default,,0,0,0,,Қазірдің өзінде! Неліктен бұл күнде таңертең болады?
Dialogue: 0,0:08:46.61,0:08:48.61,Default,,0,0,0,,Иә? Е!?
Dialogue: 0,0:08:48.61,0:08:50.61,Default,,0,0,0,,Шинчан
Dialogue: 0,0:08:50.61,0:08:54.61,Default,,0,0,0,,Қайырлы таң~ Нанако апа~ Ахаха
Dialogue: 0,0:08:54.61,0:08:57.62,Default,,0,0,0,,Шин-чан, сен қазір балабақшаға барасың ба?
Dialogue: 0,0:08:57.62,0:09:01.55,Default,,0,0,0,,Балабақша? Балалар сонда баратын шығар.
Dialogue: 0,0:09:01.55,0:09:03.56,Default,,0,0,0,,Уфуфу... Иә.
Dialogue: 0,0:09:03.56,0:09:06.56,Default,,0,0,0,,Осы жерде қандай да бір байланыстың арқасында кездестік.
Dialogue: 0,0:09:06.56,0:09:09.56,Default,,0,0,0,,Келесі жолы тамақ алғыңыз келе ме?
Dialogue: 0,0:09:09.56,0:09:11.56,Default,,0,0,0,,О, бұл керемет!
Dialogue: 0,0:09:11.56,0:09:14.57,Default,,0,0,0,,Мен қызықсыз нәрсе жасаймын
Dialogue: 0,0:09:14.57,0:09:16.57,Default,,0,0,0,,Эй хехе, жексенбі жақсы.
Dialogue: 0,0:09:16.57,0:09:18.57,Default,,0,0,0,,Шынымен бе? Иә
Dialogue: 0,0:09:18.57,0:09:21.57,Default,,0,0,0,,Шинобу-чанның келе алмайтыны ұят.
Dialogue: 0,0:09:21.57,0:09:24.58,Default,,0,0,0,,Мен ештеңе айтқан жоқпын...
Dialogue: 0,0:09:24.58,0:09:27.58,Default,,0,0,0,,Ал, келесі жексенбі.
Dialogue: 0,0:09:27.58,0:09:29.58,Default,,0,0,0,,Сәнге келейік
Dialogue: 0,0:09:29.58,0:09:33.58,Default,,0,0,0,,О... о... сәнді!?
Dialogue: 0,0:09:40.59,0:09:42.60,Default,,0,0,0,,Ахаха ааан
Dialogue: 0,0:09:42.60,0:09:46.60,Default,,0,0,0,,Ахххх
Dialogue: 0,0:09:46.60,0:09:48.60,Default,,0,0,0,,Дәмді хехехе
Dialogue: 0,0:09:50.60,0:09:52.61,Default,,0,0,0,,Мен Шин Чанды жақсы көремін
Dialogue: 0,0:09:52.61,0:09:55.61,Default,,0,0,0,,Поппо! Шушупопо Шушупопо
Dialogue: 0,0:09:55.61,0:09:57.61,Default,,0,0,0,,Шушупоппо Шушупоппо…
Dialogue: 0,0:09:57.61,0:10:01.61,Default,,0,0,0,,Жүр, Нанако-чанға рахмет, қазір барайық.
Dialogue: 0,0:10:01.61,0:10:04.61,Default,,0,0,0,,Поппо! Хехе
Dialogue: 0,0:10:10.62,0:10:12.63,Default,,0,0,0,,Жүр!
Dialogue: 0,0:10:12.63,0:10:18.63,Default,,0,0,0,,Бар, бар, бар! Жүр кет кет кет кет!
Dialogue: 0,0:10:18.63,0:10:21.63,Default,,0,0,0,,Операция басталды
Dialogue: 0,0:10:21.63,0:10:24.64,Default,,0,0,0,,Қызықты Каки Каки операциясын қалай сәтті орындауға болады
Dialogue: 0,0:10:24.64,0:10:27.64,Default,,0,0,0,,Бізге әлі де керек-жарақтар қажет.
Dialogue: 0,0:10:27.64,0:10:29.64,Default,,0,0,0,,Сіз бұл қымбат патшалықты өшіргіңіз келмейді.
Dialogue: 0,0:10:29.64,0:10:31.64,Default,,0,0,0,,Нуу...
Dialogue: 0,0:10:31.64,0:10:34.65,Default,,0,0,0,,Біріншіден, сіз маған көбірек қару бере аласыз ба, патша?
Dialogue: 0,0:10:34.65,0:10:37.65,Default,,0,0,0,,Сол қарындашпен
Dialogue: 0,0:10:37.65,0:10:40.65,Default,,0,0,0,,О, керемет түсті қарындаш тез
Dialogue: 0,0:10:40.65,0:10:42.66,Default,,0,0,0,,Кешіріңіз... (Қорғаныс министрі) А?
Dialogue: 0,0:10:42.66,0:10:46.66,Default,,0,0,0,,Мен іздедім, бірақ қарындаш тұрған жерде.
Dialogue: 0,0:10:46.66,0:10:48.66,Default,,0,0,0,,Бұл жалғыз нәрсе...
Dialogue: 0,0:10:48.66,0:10:51.66,Default,,0,0,0,,Не... Бұл не!
Dialogue: 0,0:10:51.66,0:10:53.67,Default,,0,0,0,,Қар бұршақ... (Қорғаныс министрі) Қар бұршақ...
Dialogue: 0,0:10:53.67,0:10:55.67,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:10:55.67,0:10:59.67,Default,,0,0,0,,Дудл еш жерде жоқ.
Dialogue: 0,0:11:03.61,0:11:05.61,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:11:05.61,0:11:07.61,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:11:07.61,0:11:10.62,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:11:10.62,0:11:13.62,Default,,0,0,0,,Оны үлкенірек салуым керек пе? (Сот суретшісі) Иә?
Dialogue: 0,0:11:13.62,0:11:15.62,Default,,0,0,0,,Уау, жақсы, жақсы!
Dialogue: 0,0:11:15.62,0:11:18.62,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:11:18.62,0:11:21.63,Default,,0,0,0,,Шин-чан, сен ненің суретін салып жатырсың?
Dialogue: 0,0:11:21.63,0:11:24.63,Default,,0,0,0,,Ментайко! Нанако Они-сан
Dialogue: 0,0:11:24.63,0:11:27.63,Default,,0,0,0,,Мен саған ас әзірлеп қойдым~ Өтінемін, көп тамақтанып ал~
Dialogue: 0,0:11:27.63,0:11:30.64,Default,,0,0,0,,Білесің бе... мұнда не бар екенін салайық.
Dialogue: 0,0:11:30.64,0:11:34.64,Default,,0,0,0,,Сіз не істеп жатырсыз? Ол (Масао) бақытты көрінеді.
Dialogue: 0,0:11:34.64,0:11:37.64,Default,,0,0,0,,Ер адамдар қарапайым (сот суретшісі)...
Dialogue: 0,0:11:37.64,0:11:41.64,Default,,0,0,0,,Олардың арасында батыр да бар шығар... А?
Dialogue: 0,0:11:43.65,0:11:46.65,Default,,0,0,0,,Олай болса бәріміз жинастырып алайық.
Dialogue: 0,0:11:46.65,0:11:48.65,Default,,0,0,0,,Иә! (Тағзым) Бо?
Dialogue: 0,0:11:51.66,0:11:56.66,Default,,0,0,0,,Не... қандай тегін!
Dialogue: 0,0:11:56.66,0:11:58.66,Default,,0,0,0,,Сен... сен! (Тағзым) А?
Dialogue: 0,0:11:58.66,0:12:01.56,Default,,0,0,0,,Осыны салып көргіңіз келе ме?
Dialogue: 0,0:12:03.60,0:12:07.61,Default,,0,0,0,,Бұл тек таңдаулылар ғана сурет сала алатын қарындаш.
Dialogue: 0,0:12:07.61,0:12:10.61,Default,,0,0,0,,Таңдалған... (Сот суретшісі) Ах!
Dialogue: 0,0:12:10.61,0:12:13.61,Default,,0,0,0,,Бо~
Dialogue: 0,0:12:13.61,0:12:15.61,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:12:17.62,0:12:19.62,Default,,0,0,0,,Бо...
Dialogue: 0,0:12:19.62,0:12:21.62,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:21.62,0:12:23.62,Default,,0,0,0,,Таңдалған...
Dialogue: 0,0:12:23.62,0:12:25.63,Default,,0,0,0,,Ннн! (Сот суретшісі) О!
Dialogue: 0,0:12:25.63,0:12:29.63,Default,,0,0,0,,Амансың ба? Біртүрлі нәрсе болды ма?
Dialogue: 0,0:12:29.63,0:12:31.63,Default,,0,0,0,,Енді барайық.
Dialogue: 0,0:12:31.63,0:12:35.64,Default,,0,0,0,,Бәріміз балабақшаға қайтайық~ (Балалар) Иә~
Dialogue: 0,0:12:35.64,0:12:38.64,Default,,0,0,0,,Ах…
Dialogue: 0,0:12:38.64,0:12:42.64,Default,,0,0,0,,Дұрыс. (Көрші әйел) кенет осында келді.
Dialogue: 0,0:12:42.64,0:12:46.65,Default,,0,0,0,,Тыңдаңыз! Біреудің үйінде не істеп жүрсің?
Dialogue: 0,0:12:46.65,0:12:49.65,Default,,0,0,0,,Додл суретін салайық (көрші әйел) Иә?
Dialogue: 0,0:12:49.65,0:12:51.65,Default,,0,0,0,,Маған ұнамайды! иә?
Dialogue: 0,0:12:51.65,0:12:54.65,Default,,0,0,0,,Ангия!
Dialogue: 0,0:12:54.65,0:13:04.60,Default,,0,0,0,,♪
Dialogue: 0,0:13:04.60,0:13:07.60,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:13:09.60,0:13:11.60,Default,,0,0,0,,Жаман!
Dialogue: 0,0:13:13.61,0:13:15.61,Default,,0,0,0,,Һм?
Dialogue: 0,0:13:18.61,0:13:20.61,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:20.61,0:13:22.62,Default,,0,0,0,,Жасырын ~ Сергіту ~
Dialogue: 0,0:13:22.62,0:13:24.62,Default,,0,0,0,,Сіз! О?
Dialogue: 0,0:13:24.62,0:13:27.62,Default,,0,0,0,,Сіз бұл дудлды салдыңыз, солай ма?
Dialogue: 0,0:13:27.62,0:13:29.62,Default,,0,0,0,,Бұл дудл емес, ментайко!
Dialogue: 0,0:13:29.62,0:13:33.63,Default,,0,0,0,,Керемет...
Dialogue: 0,0:13:33.63,0:13:36.63,Default,,0,0,0,,Осымен бірдеңе салғыңыз келе ме?
Dialogue: 0,0:13:36.63,0:13:38.63,Default,,0,0,0,,Бұл сәнді берет.
Dialogue: 0,0:13:38.63,0:13:40.63,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:40.63,0:13:43.64,Default,,0,0,0,,Ментайко ұнаса, мен саған беремін~
Dialogue: 0,0:13:43.64,0:13:46.64,Default,,0,0,0,,Ааа, күте тұр! Ха ха...
Dialogue: 0,0:13:46.64,0:13:48.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:48.64,0:13:51.64,Default,,0,0,0,,Шыршаның сүйір болғаны жақсы.
Dialogue: 0,0:13:51.64,0:13:54.65,Default,,0,0,0,,Мұндай жерлерде шаш өсуі мүмкін бе? Жарайды, асығыңыз!
Dialogue: 0,0:13:54.65,0:13:58.65,Default,,0,0,0,,Бұл тым күшті.
Dialogue: 0,0:13:58.65,0:14:01.59,Default,,0,0,0,,О!
Dialogue: 0,0:14:01.59,0:14:04.59,Default,,0,0,0,,Немесе... Мен оны сыза алдым!
Dialogue: 0,0:14:08.59,0:14:11.59,Default,,0,0,0,,Уау! О?
Dialogue: 0,0:14:14.60,0:14:18.60,Default,,0,0,0,,Бірдеңе шықты (Сот суретшісі) Керемет!
Dialogue: 0,0:14:18.60,0:14:20.61,Default,,0,0,0,,Мұны ненің суретін салдыңыз?
Dialogue: 0,0:14:20.61,0:14:22.61,Default,,0,0,0,,Әкемнің шұлығы сасып тұр!
Dialogue: 0,0:14:22.61,0:14:26.61,Default,,0,0,0,,Қозғалмаңыз! ғұн хун хун хун хун хун
Dialogue: 0,0:14:26.61,0:14:28.61,Default,,0,0,0,,Балада не бар
Dialogue: 0,0:14:28.61,0:14:31.62,Default,,0,0,0,,Бұл ғажайып қарындаш болуы мүмкін бе?
Dialogue: 0,0:14:31.62,0:14:33.62,Default,,0,0,0,,Ағай, бұл шын!
Dialogue: 0,0:14:33.62,0:14:36.62,Default,,0,0,0,,Шинигами қалай өледі екен.
Dialogue: 0,0:14:36.62,0:14:38.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:38.62,0:14:41.63,Default,,0,0,0,,Ха ха ха жоқ рахмет!
Dialogue: 0,0:14:41.63,0:14:43.63,Default,,0,0,0,,Не? (Сот суретшісі) Көмегіңе рахмет.
Dialogue: 0,0:14:43.63,0:14:46.63,Default,,0,0,0,,Учаскені тексеруге келсем, жау қуды.
Dialogue: 0,0:14:46.63,0:14:49.64,Default,,0,0,0,,Жарайсың, сен (Солдат), тоқта!
Dialogue: 0,0:14:49.64,0:14:52.64,Default,,0,0,0,,Жоқ, сіз қате түсіндіңіз.
Dialogue: 0,0:14:52.64,0:14:54.64,Default,,0,0,0,,Ах! (ысырма дыбысы)
Dialogue: 0,0:14:58.64,0:15:01.58,Default,,0,0,0,,Ах, сасық!
Dialogue: 0,0:15:01.58,0:15:04.58,Default,,0,0,0,,Ангия!
Dialogue: 0,0:15:04.58,0:15:06.59,Default,,0,0,0,,Уау, шынайы нәрсеге ұқсайды
Dialogue: 0,0:15:06.59,0:15:09.59,Default,,0,0,0,,Бұл шын, көмектесіңізші! (Сот суретшісі) Қашайық!
Dialogue: 0,0:15:09.59,0:15:12.59,Default,,0,0,0,,Танымайтын ағайдың соңынан ерме
Dialogue: 0,0:15:12.59,0:15:14.59,Default,,0,0,0,,Жарайды, анашым.
Dialogue: 0,0:15:14.59,0:15:16.60,Default,,0,0,0,,Мен сені анаңа апарайын.
Dialogue: 0,0:15:16.60,0:15:18.60,Default,,0,0,0,,Шынымен бе? О!
Dialogue: 0,0:15:18.60,0:15:20.60,Default,,0,0,0,,() ()
Dialogue: 0,0:15:20.60,0:15:25.60,Default,,0,0,0,,Сурет салайық~ (Ана) Тоқтаңызшы!
Dialogue: 0,0:15:25.60,0:15:27.61,Default,,0,0,0,,Ангия!
Dialogue: 0,0:15:27.61,0:15:29.61,Default,,0,0,0,,Анашым!? Жақында кездескенше~
Dialogue: 0,0:15:29.61,0:15:32.61,Default,,0,0,0,,Ах Чочочочо!
Dialogue: 0,0:15:32.61,0:15:36.62,Default,,0,0,0,,Тоқта, мен сені анаңа апарамын.
Dialogue: 0,0:15:36.62,0:15:38.62,Default,,0,0,0,,Жақсы, өйткені сіз жолды бұрыннан білесіз
Dialogue: 0,0:15:38.62,0:15:40.62,Default,,0,0,0,,Жоқ, жоқ, жоқ! Ағай, мүмкін...
Dialogue: 0,0:15:40.62,0:15:43.62,Default,,0,0,0,,Мен саған тәттілер алып берейін, жарай ма?
Dialogue: 0,0:15:43.62,0:15:45.62,Default,,0,0,0,,Кеттік! Ағаймен барайық!
Dialogue: 0,0:15:45.62,0:15:47.63,Default,,0,0,0,,Ұрлаушы! Тарту!
Dialogue: 0,0:15:47.63,0:15:49.63,Default,,0,0,0,,Қалай!
Dialogue: 0,0:15:51.63,0:15:54.63,Default,,0,0,0,,Күте тұрыңыз! Күтіңіз, күтіңіз, күтіңіз!
Dialogue: 0,0:15:56.64,0:15:59.64,Default,,0,0,0,,Күте тұрыңыз! Ха ха ха ха...а
Dialogue: 0,0:15:59.64,0:16:02.58,Default,,0,0,0,,Уау! Ха ха ха ха...
Dialogue: 0,0:16:02.58,0:16:04.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:04.58,0:16:06.58,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:08.58,0:16:10.58,Default,,0,0,0,,О? Ан
Dialogue: 0,0:16:10.58,0:16:12.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.59,0:16:15.59,Default,,0,0,0,,Мен суретке түсемін~ Иә ірімшік
Dialogue: 0,0:16:15.59,0:16:17.59,Default,,0,0,0,,Hahaan (ысырма дыбысы)
Dialogue: 0,0:16:17.59,0:16:19.59,Default,,0,0,0,,Ангия!
Dialogue: 0,0:16:24.60,0:16:27.60,Default,,0,0,0,,Иә? Шин Чан ше? (Балалар) А?
Dialogue: 0,0:16:27.60,0:16:29.60,Default,,0,0,0,,Олай емес... Ах!
Dialogue: 0,0:16:29.60,0:16:32.61,Default,,0,0,0,,(４)
Dialogue: 0,0:16:32.61,0:16:34.61,Default,,0,0,0,,Бар, бар, бар, бар!
Dialogue: 0,0:16:34.61,0:16:37.61,Default,,0,0,0,,Біраз сызбалар салайық (Ана) Дудлдар?
Dialogue: 0,0:16:37.61,0:16:40.61,Default,,0,0,0,,Қызық~ (Анашым) Ангия!
Dialogue: 0,0:16:40.61,0:16:43.62,Default,,0,0,0,,Алға Алға Алға Алға Алға (Солдат) Келіңіз, сурет салайық
Dialogue: 0,0:16:43.62,0:16:45.62,Default,,0,0,0,,Не? (Солдат) Мм!
Dialogue: 0,0:16:45.62,0:16:47.62,Default,,0,0,0,,Кел! Сол балаға дудл беріңіз!
Dialogue: 0,0:16:47.62,0:16:51.62,Default,,0,0,0,,Ха-ха... Нһ...
Dialogue: 0,0:16:51.62,0:16:53.63,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:16:53.63,0:16:55.63,Default,,0,0,0,,Бұл сізде бар қарындаш
Dialogue: 0,0:16:55.63,0:16:57.63,Default,,0,0,0,,Оны ғажайып қарындаш деп атайды.
Dialogue: 0,0:16:57.63,0:17:00.63,Default,,0,0,0,,Аспандағы елге жатады.
Dialogue: 0,0:17:00.63,0:17:03.57,Default,,0,0,0,,Бұл ел Ракуга патшалығы деп аталады.
Dialogue: 0,0:17:03.57,0:17:06.57,Default,,0,0,0,,Дудлдың бос жолдары өмірдің қайнар көзі.
Dialogue: 0,0:17:06.57,0:17:09.58,Default,,0,0,0,,Бұл дәстүрлі емес және батыл дудл.
Dialogue: 0,0:17:09.58,0:17:12.58,Default,,0,0,0,,Ол күшті дудл энергиясын шығарады.
Dialogue: 0,0:17:12.58,0:17:16.58,Default,,0,0,0,,Ракуга патшалығы бұл энергияны сіңіреді.
Dialogue: 0,0:17:16.58,0:17:18.58,Default,,0,0,0,,Ол үлкейді
Dialogue: 0,0:17:20.59,0:17:22.59,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:17:22.59,0:17:26.59,Default,,0,0,0,,Ракуга патшалығы ыдырай бастады.
Dialogue: 0,0:17:30.60,0:17:35.60,Default,,0,0,0,,Өйткені жерде сызбалар дерлік қалмады...
Dialogue: 0,0:17:35.60,0:17:39.61,Default,,0,0,0,,Жақсы ұсталған қалалар мен таза саябақтарда сызбалар жоқ.
Dialogue: 0,0:17:39.61,0:17:41.61,Default,,0,0,0,,Балалар ойыны – ойын
Dialogue: 0,0:17:41.61,0:17:45.61,Default,,0,0,0,,Қазір мектепте барлығы планшет пайдаланады.
Dialogue: 0,0:17:45.61,0:17:47.61,Default,,0,0,0,,Өтінемін, Батыр-доно.
Dialogue: 0,0:17:47.61,0:17:49.62,Default,,0,0,0,,Ұсақтау операциясы қызықты Каки Каки
Dialogue: 0,0:17:49.62,0:17:52.62,Default,,0,0,0,,Қорғаныс министрінің ашуын тоқтатыңыз!
Dialogue: 0,0:17:55.62,0:17:57.62,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:17:57.62,0:18:00.63,Default,,0,0,0,,Бүгін күн жылы, солай емес пе?
Dialogue: 0,0:18:00.63,0:18:03.56,Default,,0,0,0,,Оян! сен бұл жер бетіндегі жалғыз адамсың
Dialogue: 0,0:18:03.56,0:18:08.57,Default,,0,0,0,,Ғажайып қарындаштарды қолдана алатын батыр! Ол батыр!
Dialogue: 0,0:18:08.57,0:18:11.57,Default,,0,0,0,,Батыр? Әділдік одақтасы сияқты ма?
Dialogue: 0,0:18:11.57,0:18:13.57,Default,,0,0,0,,Иә! Харизматикалық түйнек сияқты ма?
Dialogue: 0,0:18:13.57,0:18:16.58,Default,,0,0,0,,Менің ойымша, бұл сәл басқаша ...
Dialogue: 0,0:18:16.58,0:18:18.58,Default,,0,0,0,,Әділдіктің одақтасы әрекет маскасы!
Dialogue: 0,0:18:18.58,0:18:20.58,Default,,0,0,0,,Өте жақын! Мүмкін
Dialogue: 0,0:18:20.58,0:18:23.58,Default,,0,0,0,,Вахахаха! Ола әрекет маскасы!
Dialogue: 0,0:18:23.58,0:18:26.59,Default,,0,0,0,,Батыр... Хохо
Dialogue: 0,0:18:26.59,0:18:28.59,Default,,0,0,0,,Ах! (Солдат) А?
Dialogue: 0,0:18:28.59,0:18:30.59,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:18:30.59,0:18:34.59,Default,,0,0,0,,Хмм... Мм, мен батырмын!
Dialogue: 0,0:18:34.59,0:18:36.60,Default,,0,0,0,,Бір бетке сәйкес келеді О?
Dialogue: 0,0:18:36.60,0:18:38.60,Default,,0,0,0,,О... эй...
Dialogue: 0,0:18:38.60,0:18:40.60,Default,,0,0,0,,Оо?
Dialogue: 0,0:18:40.60,0:18:43.60,Default,,0,0,0,,Мен сурет дәптерін де қостым.
Dialogue: 0,0:18:45.60,0:18:48.61,Default,,0,0,0,,О? Өтінемін, қашып кетіңіз, батыр-доно.
Dialogue: 0,0:18:48.61,0:18:50.61,Default,,0,0,0,,Хохоу (сот суретшісі) Жарайды ма?
Dialogue: 0,0:18:50.61,0:18:52.61,Default,,0,0,0,,Жерге түскенде
Dialogue: 0,0:18:52.61,0:18:56.62,Default,,0,0,0,,Егер сіз өзіңізді сол қарындаштармен қоршасаңыз, сіз шыға аласыз.
Dialogue: 0,0:18:56.62,0:18:59.62,Default,,0,0,0,,Мм! Түсінікті!?
Dialogue: 0,0:19:01.55,0:19:04.56,Default,,0,0,0,,О! Керемет...
Dialogue: 0,0:19:04.56,0:19:07.56,Default,,0,0,0,,О... ай! (Сарбаздар) Уау!
Dialogue: 0,0:19:07.56,0:19:09.56,Default,,0,0,0,,Мен оны сұрадым! Ооо!
Dialogue: 0,0:19:09.56,0:19:13.57,Default,,0,0,0,,Уа, уау, ау!
Dialogue: 0,0:19:13.57,0:19:16.57,Default,,0,0,0,,… … ()
Dialogue: 0,0:19:16.57,0:19:18.57,Default,,0,0,0,,О? (Солдат) Кеттік!
Dialogue: 0,0:19:18.57,0:19:23.58,Default,,0,0,0,,Уау! Анашым!
Dialogue: 0,0:19:23.58,0:19:25.58,Default,,0,0,0,,Ангия!
Dialogue: 0,0:19:25.58,0:19:27.58,Default,,0,0,0,,Анашым! (Мұғалім) Ангия!
Dialogue: 0,0:19:27.58,0:19:33.59,Default,,0,0,0,,(балалар жылайды)
Dialogue: 0,0:19:33.59,0:19:36.59,Default,,0,0,0,,Бір қорқынышты нәрсе болды...
Dialogue: 0,0:19:36.59,0:19:39.59,Default,,0,0,0,,О? (Канда Тори) Ах...
Dialogue: 0,0:19:39.59,0:19:41.59,Default,,0,0,0,,Шинобу-чан?
Dialogue: 0,0:19:41.59,0:19:43.59,Default,,0,0,0,,О? Ой!?
Dialogue: 0,0:19:46.60,0:19:49.60,Default,,0,0,0,,Шинчан
Dialogue: 0,0:19:49.60,0:19:55.60,Default,,0,0,0,,Нана... Нана... Нанако-нисан!
Dialogue: 0,0:19:59.61,0:20:03.62,Default,,0,0,0,,Коконокадо жаулап алды! Коконокадо жеңді!
Dialogue: 0,0:20:03.62,0:20:07.62,Default,,0,0,0,,Біз Ракуга патшалығының халқымыз!
Dialogue: 0,0:20:07.62,0:20:11.62,Default,,0,0,0,,Бұдан былай мен сізден дудлдарды жалғастыруыңызды сұраймын.
Dialogue: 0,0:20:11.62,0:20:15.63,Default,,0,0,0,,Бұл міндетті. Ұстаз, алға!
Dialogue: 0,0:20:15.63,0:20:17.63,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:17.63,0:20:20.63,Default,,0,0,0,,Сәлем~ Қалайсыңдар?
Dialogue: 0,0:20:20.63,0:20:24.64,Default,,0,0,0,,Мені Ринго-оне-сан деп атаңыз.
Dialogue: 0,0:20:24.64,0:20:28.64,Default,,0,0,0,,Олай болса барлығымыз қалаған суретімізді салайық!
Dialogue: 0,0:20:28.64,0:20:30.64,Default,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені сала аласыз.
Dialogue: 0,0:20:30.64,0:20:32.65,Default,,0,0,0,,Бастау!
Dialogue: 0,0:20:32.65,0:20:35.65,Default,,0,0,0,,Барлығы~ Қызық, не болды?
Dialogue: 0,0:20:35.65,0:20:38.65,Default,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені сала аласыз.
Dialogue: 0,0:20:38.65,0:20:40.65,Default,,0,0,0,,Сіз боссыз~
Dialogue: 0,0:20:40.65,0:20:42.66,Default,,0,0,0,,Уау... көзім қорқынышты~
Dialogue: 0,0:20:42.66,0:20:45.66,Default,,0,0,0,,Йошинага-сенсэйге не болды?
Dialogue: 0,0:20:45.66,0:20:48.66,Default,,0,0,0,,Жоғалған (бала) Мен үйге барғым келеді.
Dialogue: 0,0:20:48.66,0:20:51.66,Default,,0,0,0,,Мен үйге барғым келеді~ (Бала) Мама~
Dialogue: 0,0:20:51.66,0:20:54.67,Default,,0,0,0,,Неліктен мен сурет салуым керек?
Dialogue: 0,0:20:54.67,0:20:56.67,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:20:56.67,0:20:59.67,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:20:59.67,0:21:02.61,Default,,0,0,0,,Е... Ангия!
Dialogue: 0,0:21:05.61,0:21:08.61,Default,,0,0,0,,Кәне, бәріміз~ (Балалар) Уф...
Dialogue: 0,0:21:08.61,0:21:11.62,Default,,0,0,0,,Көңіл-күйімізді көтеріп, дудлдар салайық!
Dialogue: 0,0:21:11.62,0:21:14.62,Default,,0,0,0,,Бұрынғы қыз сияқты болғың келе ме?
Dialogue: 0,0:21:14.62,0:21:18.62,Default,,0,0,0,,Барлығымыз, сурет салайық! Сурет салайық! сызу! Атататата!
Dialogue: 0,0:21:18.62,0:21:20.63,Default,,0,0,0,,Тая~ (Ичиго) Егер мен сурет сала алсам, мен үлкен апа болар едім.
Dialogue: 0,0:21:20.63,0:21:22.63,Default,,0,0,0,,Маған көрсету~
Dialogue: 0,0:21:22.63,0:21:27.63,Default,,0,0,0,,Бұл керемет! Бұл өте жақсы~ Ахаха
Dialogue: 0,0:21:27.63,0:21:31.64,Default,,0,0,0,,Мм... иә?
Dialogue: 0,0:21:31.64,0:21:33.64,Default,,0,0,0,,Маған үйге баруға рұқсат бере аласыз ба?
Dialogue: 0,0:21:33.64,0:21:36.64,Default,,0,0,0,,Үлкен баламның үйге келетін уақыты жақындап қалды.
Dialogue: 0,0:21:36.64,0:21:38.64,Default,,0,0,0,,Мм!?
Dialogue: 0,0:21:38.64,0:21:40.65,Default,,0,0,0,,Кәне, сурет салайық~
Dialogue: 0,0:21:40.65,0:21:43.65,Default,,0,0,0,,Сәлем! иә?
Dialogue: 0,0:21:43.65,0:21:46.65,Default,,0,0,0,,Ангия!
Dialogue: 0,0:21:46.65,0:21:48.65,Default,,0,0,0,,Ол ол ол ол ол ол (Солдат) Жүр.
Dialogue: 0,0:21:48.65,0:21:51.66,Default,,0,0,0,,Қалағаныңызша сурет сала аласыз~ Таяя~
Dialogue: 0,0:21:51.66,0:21:54.66,Default,,0,0,0,,Әй, эй... ей!
Dialogue: 0,0:21:54.66,0:21:58.66,Default,,0,0,0,,А... Бұл не?!
Dialogue: 0,0:21:58.66,0:22:01.56,Default,,0,0,0,,Таяя~
Dialogue: 0,0:22:04.60,0:22:09.61,Default,,0,0,0,,♪(Қуаныш әні, уау!)
Dialogue: 0,0:22:09.61,0:22:22.62,Default,,0,0,0,,♪～
Dialogue: 0,0:22:22.62,0:22:28.63,Default,,0,0,0,,♪Бізді қорғайтын сенсің
Dialogue: 0,0:22:28.63,0:22:32.63,Default,,0,0,0,,♪Ең әдемі (Ракугаки)♪Ең күшті
Dialogue: 0,0:22:32.63,0:22:39.64,Default,,0,0,0,,♪Ең мейірімді және өшпенділіксіз бола алатын адам.
Dialogue: 0,0:22:39.64,0:22:45.64,Default,,0,0,0,,♪Бізді бақытты ететін сенсің
Dialogue: 0,0:22:45.64,0:22:49.65,Default,,0,0,0,,Ең биік және ең жіңішке
Dialogue: 0,0:22:49.65,0:22:56.66,Default,,0,0,0,,♪Арықтаудың пайдалы жолы
Dialogue: 0,0:22:56.66,0:22:59.66,Default,,0,0,0,,♪Ең жылдам
Dialogue: 0,0:22:59.66,0:23:03.60,Default,,0,0,0,,♪Ең жарқыраған тері
Dialogue: 0,0:23:03.60,0:23:07.60,Default,,0,0,0,,♪Ең әзіл-оспақ
Dialogue: 0,0:23:07.60,0:23:09.60,Default,,0,0,0,,Бастық болмаңыз!
Dialogue: 0,0:23:09.60,0:23:11.60,Default,,0,0,0,,♪Сәнді болыңыз♪Жасыңызды көрсетіңіз
Dialogue: 0,0:23:11.60,0:23:13.61,Default,,0,0,0,,♪Алдамаңыз
Dialogue: 0,0:23:13.61,0:23:22.61,Default,,0,0,0,,♪Сіз көзілдірікпен жақсы көрінесіз.
Dialogue: 0,0:23:22.61,0:23:25.62,Default,,0,0,0,,(ﾗｸｶﾞｷ) ♪
Dialogue: 0,0:23:25.62,0:23:30.62,Default,,0,0,0,,Сіз мені естисіз бе, патша? Халық бақытты.
Dialogue: 0,0:23:30.62,0:23:33.63,Default,,0,0,0,,Сіз мұны түсіндіңіз бе? (Түртіп) Жарайды...
Dialogue: 0,0:23:33.63,0:23:35.63,Default,,0,0,0,,Дудлдар – бұл...
Dialogue: 0,0:23:35.63,0:23:37.63,Default,,0,0,0,,«Дудл дегеніміз не?
Dialogue: 0,0:23:37.63,0:23:39.63,Default,,0,0,0,,Еркін рухтан туу керек! »
Dialogue: 0,0:23:39.63,0:23:42.63,Default,,0,0,0,,дейсіз бе? (Түртіп) Дұрыс!
Dialogue: 0,0:23:42.63,0:23:44.63,Default,,0,0,0,,Уағыздар жеткілікті!
Dialogue: 0,0:23:46.64,0:23:48.64,Default,,0,0,0,,Ngggggggg...
Dialogue: 0,0:23:48.64,0:23:52.64,Default,,0,0,0,,Сіз қателесесіз! (Солдат) Көкек!
Dialogue: 0,0:23:52.64,0:23:55.65,Default,,0,0,0,,Жер бетіне қашып кеткен сот суретшісі ұсталды!
Dialogue: 0,0:23:55.65,0:23:57.65,Default,,0,0,0,,О! Бұл үлкен!
Dialogue: 0,0:24:02.59,0:24:05.59,Default,,0,0,0,,Енді міне, ғажайып қарындаш.
Dialogue: 0,0:24:05.59,0:24:10.60,Default,,0,0,0,,Бұл қарындашты жердегі дудл аумағын кеңейту үшін пайдаланыңыз.
Dialogue: 0,0:24:10.60,0:24:14.60,Default,,0,0,0,,Сайып келгенде, бүкіл Жапония, жоқ, бүкіл дүние жүзіндегі адамдар
Dialogue: 0,0:24:14.60,0:24:17.60,Default,,0,0,0,,Сіз Ракуга патшалығында жұмыс істейсіз!
Dialogue: 0,0:24:17.60,0:24:20.61,Default,,0,0,0,,Мм... (Қорғаныс министрі) А?
Dialogue: 0,0:24:20.61,0:24:23.61,Default,,0,0,0,,Менің қалтамда мынау...
Dialogue: 0,0:24:23.61,0:24:25.61,Default,,0,0,0,,Не!
Dialogue: 0,0:24:25.61,0:24:27.61,Default,,0,0,0,,Спаржа…
Dialogue: 0,0:24:27.61,0:24:29.62,Default,,0,0,0,,Ғажайып қарындашты іздеңіз!
Dialogue: 0,0:24:29.62,0:24:31.62,Default,,0,0,0,,Овавава!
Dialogue: 0,0:24:31.62,0:24:33.62,Default,,0,0,0,,Nnnnnnn…
Dialogue: 0,0:24:33.62,0:24:36.62,Default,,0,0,0,,Нининни... Доват
Dialogue: 0,0:24:36.62,0:24:38.62,Default,,0,0,0,,Аха аха аха
Dialogue: 0,0:24:40.63,0:24:42.63,Default,,0,0,0,,Ннн…
Dialogue: 0,0:24:42.63,0:24:44.63,Default,,0,0,0,,Хохой
Dialogue: 0,0:24:44.63,0:24:48.63,Default,,0,0,0,,Ой! Ой
Dialogue: 0,0:24:48.63,0:24:50.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:24:50.64,0:24:53.64,Default,,0,0,0,,О...
Dialogue: 0,0:24:53.64,0:24:55.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:24:55.64,0:25:03.58,Default,,0,0,0,,♪
Dialogue: 0,0:25:03.58,0:25:06.59,Default,,0,0,0,,Хохо~
Dialogue: 0,0:25:06.59,0:25:09.59,Default,,0,0,0,,Жақыннан қарасаң әдемі.
Dialogue: 0,0:25:09.59,0:25:12.59,Default,,0,0,0,,Сіз қанша жерге келдіңіз? Ора
Dialogue: 0,0:25:12.59,0:25:15.59,Default,,0,0,0,,Вава! Пухаа!
Dialogue: 0,0:25:15.59,0:25:17.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:17.60,0:25:21.60,Default,,0,0,0,,Үлкен тау болды.
Dialogue: 0,0:25:21.60,0:25:24.60,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:25:24.60,0:25:27.61,Default,,0,0,0,,Бұл таудан да артық.
Dialogue: 0,0:25:27.61,0:25:30.61,Default,,0,0,0,,Шалбар шалбар~
Dialogue: 0,0:25:30.61,0:25:33.61,Default,,0,0,0,,Хойхой Ахахахаха
Dialogue: 0,0:25:33.61,0:25:35.61,Default,,0,0,0,,Хойт Хой
Dialogue: 0,0:25:35.61,0:25:38.61,Default,,0,0,0,,О? Ой!
Dialogue: 0,0:25:40.62,0:25:42.62,Default,,0,0,0,,Оо?
Dialogue: 0,0:25:42.62,0:25:44.62,Default,,0,0,0,,Танысқаныма қуаныштымын, мен қысқаша.
Dialogue: 0,0:25:44.62,0:25:47.63,Default,,0,0,0,,Мен сізге қызмет етемін
Dialogue: 0,0:25:47.63,0:25:49.63,Default,,0,0,0,,Көңілді шалбар... (Трускалар) Осындай жерде
Dialogue: 0,0:25:49.63,0:25:52.63,Default,,0,0,0,,Жалқау болсаң, күн тез батады.
Dialogue: 0,0:25:52.63,0:25:55.63,Default,,0,0,0,,Енді кеттік, батыр!
Dialogue: 0,0:25:55.63,0:25:57.64,Default,,0,0,0,,Эскиз дәптеріңізді ұмытпаңыз
Dialogue: 0,0:25:57.64,0:25:59.64,Default,,0,0,0,,Ғажайып қарындаштармен жалғыз сурет сала алмайсың.
Dialogue: 0,0:25:59.64,0:26:01.57,Default,,0,0,0,,Хой
Dialogue: 0,0:26:01.57,0:26:04.58,Default,,0,0,0,,О! (Қысқаша) Не болды?
Dialogue: 0,0:26:04.58,0:26:06.58,Default,,0,0,0,,Екінші күнгі иіс (қысқаша) а!?
Dialogue: 0,0:26:06.58,0:26:08.58,Default,,0,0,0,,Мен жаңа емеспін бе?
Dialogue: 0,0:26:08.58,0:26:10.58,Default,,0,0,0,,Бұл... иіс...
Dialogue: 0,0:26:10.58,0:26:12.58,Default,,0,0,0,,Сіз оны салдыңыз!
Dialogue: 0,0:26:12.58,0:26:14.59,Default,,0,0,0,,Сәлем! Келме!
Dialogue: 0,0:26:14.59,0:26:16.59,Default,,0,0,0,,Сіз оны салдыңыз!
Dialogue: 0,0:26:16.59,0:26:18.59,Default,,0,0,0,,Келме! (Қысқаша) Міне!
Dialogue: 0,0:26:18.59,0:26:22.59,Default,,0,0,0,,Ха ха... Жататын жерді тез тауып алайық!
Dialogue: 0,0:26:22.59,0:26:25.60,Default,,0,0,0,,Әй, мұнда бәрі жақсы. Бұл жақсы емес!
Dialogue: 0,0:26:25.60,0:26:27.60,Default,,0,0,0,,Жаңбыр жауса не істейсің?
Dialogue: 0,0:26:27.60,0:26:29.60,Default,,0,0,0,,Ойлан
Dialogue: 0,0:26:29.60,0:26:32.60,Default,,0,0,0,,Сіз батырсыз, көбірек хабардар болыңыз.
Dialogue: 0,0:26:32.60,0:26:35.61,Default,,0,0,0,,Мен байсалдымын. Сасық, бірақ...
Dialogue: 0,0:26:35.61,0:26:37.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:37.61,0:26:39.61,Default,,0,0,0,,Осы жерде жасайық
Dialogue: 0,0:26:42.61,0:26:46.62,Default,,0,0,0,,Ертең, таң ата әрекетті бастайық.
Dialogue: 0,0:26:46.62,0:26:49.62,Default,,0,0,0,,Хой (қысқаша) Біздің мақсатымыз
Dialogue: 0,0:26:49.62,0:26:51.62,Default,,0,0,0,,Касукабе тұрғындарына көмектесу
Dialogue: 0,0:26:51.62,0:26:54.63,Default,,0,0,0,,Бұл Патшалықтың стратегиясын тоқтататын жалғыз нәрсе.
Dialogue: 0,0:26:54.63,0:27:00.63,Default,,0,0,0,,Бізді жау байқамауы керек, бірақ тезірек Касукабеге оралайық.
Dialogue: 0,0:27:00.63,0:27:02.57,Default,,0,0,0,,Нанако Они-сан…
Dialogue: 0,0:27:02.57,0:27:06.57,Default,,0,0,0,,Шешуші шайқас алдында сізге көп дудл қажет болуы мүмкін.
Dialogue: 0,0:27:06.57,0:27:10.58,Default,,0,0,0,,Жерден және әуеден шабуыл жасау үшін, алғашқы 50 ұшақ пен 50 танк.
Dialogue: 0,0:27:10.58,0:27:14.58,Default,,0,0,0,,Хмм! (Қысқаша) Шинносуке-сан?
Dialogue: 0,0:27:14.58,0:27:17.58,Default,,0,0,0,,Ахахаха хохо~
Dialogue: 0,0:27:17.58,0:27:20.59,Default,,0,0,0,,Хой Хой!
Dialogue: 0,0:27:20.59,0:27:23.59,Default,,0,0,0,,А, жеткіліксіз
Dialogue: 0,0:27:23.59,0:27:26.59,Default,,0,0,0,,Сіз ненің суретін салып жатырсыз? Сәлем
Dialogue: 0,0:27:26.59,0:27:29.59,Default,,0,0,0,,Оланың құрбысы (қысқаша) иә...
Dialogue: 0,0:27:29.59,0:27:32.60,Default,,0,0,0,,Нанако Они-санның көздері сүйкімді.
Dialogue: 0,0:27:32.60,0:27:34.60,Default,,0,0,0,,Хохой!
Dialogue: 0,0:27:34.60,0:27:38.60,Default,,0,0,0,,Кеуделеріңізді үлкейтіңіз! Ахахха
Dialogue: 0,0:27:38.60,0:27:42.61,Default,,0,0,0,,Аха, мынаны айтқың келеді~
Dialogue: 0,0:27:42.61,0:27:45.61,Default,,0,0,0,,Хохой Хохой!
Dialogue: 0,0:27:45.61,0:27:47.61,Default,,0,0,0,,N!?
Dialogue: 0,0:27:49.61,0:27:53.62,Default,,0,0,0,,О, ой
Dialogue: 0,0:27:53.62,0:27:56.62,Default,,0,0,0,,Нанако Они-сан!
Dialogue: 0,0:28:01.56,0:28:03.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:09.57,0:28:13.57,Default,,0,0,0,,Хмм… уа уа…
Dialogue: 0,0:28:16.58,0:28:18.58,Default,,0,0,0,,Мен Шин Чанды жақсы көремін
Dialogue: 0,0:28:18.58,0:28:20.58,Default,,0,0,0,,Келме!
Dialogue: 0,0:28:20.58,0:28:22.58,Default,,0,0,0,,Мен Шин Чанды жақсы көремін
Dialogue: 0,0:28:22.58,0:28:24.58,Default,,0,0,0,,Сен маған ұнамайсың!
Dialogue: 0,0:28:24.58,0:28:27.59,Default,,0,0,0,,Мен Шин Чанды жақсы көремін Уау!
Dialogue: 0,0:28:27.59,0:28:31.59,Default,,0,0,0,,Ха ха ха ха... Уау! Дауа!
Dialogue: 0,0:28:31.59,0:28:34.59,Default,,0,0,0,,Шинносуке-сан! О!
Dialogue: 0,0:28:34.59,0:28:36.59,Default,,0,0,0,,Уф!?
Dialogue: 0,0:28:38.60,0:28:42.60,Default,,0,0,0,,О... (Қысқаша) Керемет!
Dialogue: 0,0:28:42.60,0:28:45.60,Default,,0,0,0,,Мен Шин Чанды жақсы көремін
Dialogue: 0,0:28:47.61,0:28:50.61,Default,,0,0,0,,Кун
Dialogue: 0,0:28:50.61,0:28:52.61,Default,,0,0,0,,Энн! Ммм
Dialogue: 0,0:28:52.61,0:28:55.61,Default,,0,0,0,,Н-н-н-ун…
Dialogue: 0,0:28:55.61,0:28:57.61,Default,,0,0,0,,Энн!
Dialogue: 0,0:29:00.62,0:29:02.55,Default,,0,0,0,,Көмек!
Dialogue: 0,0:29:02.55,0:29:04.55,Default,,0,0,0,,Оны алыңыз~!
Dialogue: 0,0:29:05.56,0:29:08.56,Default,,0,0,0,,Біз хик...
Dialogue: 0,0:29:08.56,0:29:10.56,Default,,0,0,0,,Ангия! Ангия!
Dialogue: 0,0:29:10.56,0:29:12.56,Default,,0,0,0,,Ангия! (Жалақышы) Ангия!
Dialogue: 0,0:29:12.56,0:29:15.57,Default,,0,0,0,,Хмм? Не?
Dialogue: 0,0:29:15.57,0:29:19.57,Default,,0,0,0,,Бүгін мереке ме?
Dialogue: 0,0:29:19.57,0:29:21.57,Default,,0,0,0,,Дудл суретін салайық
Dialogue: 0,0:29:21.57,0:29:25.58,Default,,0,0,0,,Хмм? не? Doodle?
Dialogue: 0,0:29:25.58,0:29:27.58,Default,,0,0,0,,Келіңіздер! Хмм
Dialogue: 0,0:29:27.58,0:29:30.58,Default,,0,0,0,,Міне міне~кей
Dialogue: 0,0:29:30.58,0:29:32.58,Default,,0,0,0,,Жақсы! Хмм?
Dialogue: 0,0:29:32.58,0:29:34.59,Default,,0,0,0,,Маған жібере аласыз ба?
Dialogue: 0,0:29:34.59,0:29:37.59,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:29:37.59,0:29:39.59,Default,,0,0,0,,Энн! Энн!
Dialogue: 0,0:29:39.59,0:29:42.59,Default,,0,0,0,,(Жүк машинасының жүгіру дыбысы)
Dialogue: 0,0:29:44.60,0:29:46.60,Default,,0,0,0,,Кун…
Dialogue: 0,0:30:01.61,0:30:07.62,Default,,0,0,0,,Уу… Уу…
Dialogue: 0,0:30:07.62,0:30:11.62,Default,,0,0,0,,Nnn… nnnn…
Dialogue: 0,0:30:11.62,0:30:13.63,Default,,0,0,0,,А... а?
Dialogue: 0,0:30:13.63,0:30:18.63,Default,,0,0,0,,Уу… Уу…
Dialogue: 0,0:30:18.63,0:30:21.63,Default,,0,0,0,,Уууу (балалар) Ах...
Dialogue: 0,0:30:21.63,0:30:25.64,Default,,0,0,0,,Не істеп жатырсың... сен~
Dialogue: 0,0:30:25.64,0:30:27.64,Default,,0,0,0,,Иә? Мисае!
Dialogue: 0,0:30:27.64,0:30:30.64,Default,,0,0,0,,Тая~ Тая~ Күнбағыс!
Dialogue: 0,0:30:30.64,0:30:32.64,Default,,0,0,0,,Тая~
Dialogue: 0,0:30:32.64,0:30:36.65,Default,,0,0,0,,Шинносуке ше!? Біз бірге емеспіз бе!?
Dialogue: 0,0:30:36.65,0:30:39.65,Default,,0,0,0,,Ах! Гаа…
Dialogue: 0,0:30:39.65,0:30:42.65,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:30:52.66,0:30:55.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:55.67,0:30:59.67,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:30:59.67,0:31:01.61,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:31:01.61,0:31:06.61,Default,,0,0,0,,Ух... (балалар) Ой...
Dialogue: 0,0:31:06.61,0:31:10.61,Default,,0,0,0,,Сіз өзіңізге ұнайтын суретті сала аласыз.
Dialogue: 0,0:31:12.62,0:31:14.62,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:31:14.62,0:31:16.62,Default,,0,0,0,,Doodle энергиясы төмендейді!
Dialogue: 0,0:31:16.62,0:31:19.62,Default,,0,0,0,,Неліктен жер бетіндегі адамдар сурет салады?
Dialogue: 0,0:31:19.62,0:31:23.63,Default,,0,0,0,,Құлып құласа, бұл біз үшін де ақырет~ Бум!
Dialogue: 0,0:31:23.63,0:31:25.63,Default,,0,0,0,,Қорғаныс министрі не істеуді жоспарлап отыр?
Dialogue: 0,0:31:25.63,0:31:28.63,Default,,0,0,0,,Сізге Патшалықтың жойылуы жақсы ма?
Dialogue: 0,0:31:28.63,0:31:30.64,Default,,0,0,0,,Менің бір ойым бар
Dialogue: 0,0:31:30.64,0:31:32.64,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:31:32.64,0:31:35.64,Default,,0,0,0,,Нху фуфуфуфу
Dialogue: 0,0:31:35.64,0:31:37.64,Default,,0,0,0,,Бұл! (Қорғаныс министрі)
Dialogue: 0,0:31:37.64,0:31:41.65,Default,,0,0,0,,Ежелгі құралдарды пайдаланамыз. Бізде уақыт жоқ.
Dialogue: 0,0:31:41.65,0:31:44.65,Default,,0,0,0,,Мен барлығынан ұйықтамай дудл жасауды сұраймын.
Dialogue: 0,0:31:44.65,0:31:48.65,Default,,0,0,0,,Егер мұны жасасаңыз, табиғи түрде бос жол пайда болады.
Dialogue: 0,0:31:48.65,0:31:50.66,Default,,0,0,0,,Мүмкін емес! Мұндай нәрсе
Dialogue: 0,0:31:50.66,0:31:53.66,Default,,0,0,0,,Балаларға бұлай істеуге болады... (Қорғаныс министрі) Тыныш!
Dialogue: 0,0:31:57.66,0:32:01.56,Default,,0,0,0,,Мен бұл елді қорғағым келеді.
Dialogue: 0,0:32:03.60,0:32:05.60,Default,,0,0,0,,Енді, Касукабеге оралайық!
Dialogue: 0,0:32:05.60,0:32:09.61,Default,,0,0,0,,О! Ақырында батыр болу санасын қалыптастырған сияқтысың.
Dialogue: 0,0:32:09.61,0:32:12.61,Default,,0,0,0,,Кеттік. Біз қайтып оралып, шайқасқа дайындалуымыз керек.
Dialogue: 0,0:32:12.61,0:32:15.61,Default,,0,0,0,,Ең алдымен, Нанако Они-сан...
Dialogue: 0,0:32:15.61,0:32:17.62,Default,,0,0,0,,Не айтып тұрсың! Сіз батырсыз!
Dialogue: 0,0:32:17.62,0:32:21.62,Default,,0,0,0,,Менің міндетім - барлығына көмектесу! Шуппацу Ошинко!
Dialogue: 0,0:32:21.62,0:32:24.62,Default,,0,0,0,,Мен саған көмектесемін Нанако-нисан!
Dialogue: 0,0:32:24.62,0:32:28.63,Default,,0,0,0,,О! Уау!!
Dialogue: 0,0:32:28.63,0:32:32.63,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:32:32.63,0:32:35.63,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:32:35.63,0:32:39.64,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:32:39.64,0:32:41.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:41.64,0:32:44.64,Default,,0,0,0,,Дұрыс, мен кешеден бері ештеңе жеген жоқпын.
Dialogue: 0,0:32:44.64,0:32:46.64,Default,,0,0,0,,Алайда...
Dialogue: 0,0:32:46.64,0:32:51.65,Default,,0,0,0,,(Айдаһар шақыруы)
Dialogue: 0,0:32:51.65,0:32:55.65,Default,,0,0,0,,Бізді құтқаратын батырды шақырайық.
Dialogue: 0,0:32:55.65,0:32:58.66,Default,,0,0,0,,Құтқарушы батыр? иә?
Dialogue: 0,0:32:58.66,0:33:00.66,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:33:02.59,0:33:04.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:04.60,0:33:08.60,Default,,0,0,0,,Хохо... у...
Dialogue: 0,0:33:08.60,0:33:10.60,Default,,0,0,0,,Хохой...
Dialogue: 0,0:33:14.61,0:33:18.61,Default,,0,0,0,,Хой Хой!
Dialogue: 0,0:33:21.61,0:33:25.61,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааа...
Dialogue: 0,0:33:27.62,0:33:30.62,Default,,0,0,0,,Батыр Бури Бури Заемоны құтқару
Dialogue: 0,0:33:30.62,0:33:32.62,Default,,0,0,0,,Сукетачи шығарылымы
Dialogue: 0,0:33:32.62,0:33:34.63,Default,,0,0,0,,Бонд! Бүгін кешкі асқа не берілетінін болжа!
Dialogue: 0,0:33:34.63,0:33:38.63,Default,,0,0,0,,Алдымен маған тамақ беріңіз.
Dialogue: 0,0:33:38.63,0:33:40.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:40.63,0:33:44.64,Default,,0,0,0,,Ах! Балық бар, оны ұстайық
Dialogue: 0,0:33:44.64,0:33:46.64,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммм
Dialogue: 0,0:33:46.64,0:33:50.64,Default,,0,0,0,,Хохой! Ахахха О?
Dialogue: 0,0:33:50.64,0:33:52.64,Default,,0,0,0,,Қаш
Dialogue: 0,0:33:52.64,0:33:54.65,Default,,0,0,0,,Енді қармақ салайық.
Dialogue: 0,0:33:54.65,0:33:58.65,Default,,0,0,0,,Хмм, оны сызу жылдамырақ емес пе?
Dialogue: 0,0:33:58.65,0:34:00.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:34:00.65,0:34:03.59,Default,,0,0,0,,Хохой Хохой
Dialogue: 0,0:34:03.59,0:34:07.59,Default,,0,0,0,,О! Рельеф
Dialogue: 0,0:34:07.59,0:34:10.60,Default,,0,0,0,,Бұл Чокоби! Не!?
Dialogue: 0,0:34:10.60,0:34:13.60,Default,,0,0,0,,Аммм! Ах...
Dialogue: 0,0:34:13.60,0:34:15.60,Default,,0,0,0,,Дәмі құм тұшпара сияқты~
Dialogue: 0,0:34:15.60,0:34:18.60,Default,,0,0,0,,Бәрі жақсы, маған тамақ бер.
Dialogue: 0,0:34:18.60,0:34:20.61,Default,,0,0,0,,Сол адам (қысқаша), ештеңе жоқ.
Dialogue: 0,0:34:20.61,0:34:22.61,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:34:22.61,0:34:26.61,Default,,0,0,0,,(ﾍﾘｺﾌﾟﾀｰ) (/ﾌﾞﾘｰﾌ)
Dialogue: 0,0:34:26.61,0:34:28.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:34:34.62,0:34:38.62,Default,,0,0,0,,Мен оның ғажайып қарындашты іздеп жүргеніне сенімдімін.
Dialogue: 0,0:34:38.62,0:34:41.63,Default,,0,0,0,,Жарайды, осы жерден басқа нәрсе жасайық.
Dialogue: 0,0:34:41.63,0:34:44.63,Default,,0,0,0,,Біз Ғажайып қарындашты қорғаймыз!
Dialogue: 0,0:34:44.63,0:34:46.63,Default,,0,0,0,,Сол қылышпен де соғыс!
Dialogue: 0,0:34:46.63,0:34:51.64,Default,,0,0,0,,Мен біреудің иығынан сипау сияқты жерлерде адамдарды құтқаруды жақсы білемін!
Dialogue: 0,0:34:51.64,0:34:55.64,Default,,0,0,0,,Хмф! Және бұл қылыш емес
Dialogue: 0,0:34:55.64,0:34:57.64,Default,,0,0,0,,Хитоза Ам! Әмин!
Dialogue: 0,0:34:57.64,0:35:01.58,Default,,0,0,0,,Ей, мені жалама!
Dialogue: 0,0:35:01.58,0:35:03.58,Default,,0,0,0,,Тікұшақ кетіп қалған сияқты.
Dialogue: 0,0:35:03.58,0:35:07.59,Default,,0,0,0,,Менің күшімнен қорқып қаштың ба?
Dialogue: 0,0:35:07.59,0:35:10.59,Default,,0,0,0,,Бірақ бұл жылдамдықпен оны ашуға болады.
Dialogue: 0,0:35:10.59,0:35:12.59,Default,,0,0,0,,Сіз батылдықпен қозғалуыңыз керек.
Dialogue: 0,0:35:12.59,0:35:15.59,Default,,0,0,0,,Егер мен ақшаның суретін салсам, үйге таксимен баруға болады ма?
Dialogue: 0,0:35:15.59,0:35:20.60,Default,,0,0,0,,Сіздің сызбаларыңыз мұны істемейді. Мен көліктерге жақсымын.
Dialogue: 0,0:35:20.60,0:35:22.60,Default,,0,0,0,,Хой
Dialogue: 0,0:35:22.60,0:35:24.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:27.61,0:35:30.61,Default,,0,0,0,,Хохохохой!
Dialogue: 0,0:35:30.61,0:35:32.61,Default,,0,0,0,,О! Мен жақында кетемін
Dialogue: 0,0:35:32.61,0:35:34.61,Default,,0,0,0,,Мен Шин Чанды жақсы көремін
Dialogue: 0,0:35:34.61,0:35:36.61,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:35:36.61,0:35:40.62,Default,,0,0,0,,Шуппацу Ошинко~! Тұздалған қияр!
Dialogue: 0,0:35:40.62,0:35:42.62,Default,,0,0,0,,Айтпақшы, бұл машина қозғала ма?
Dialogue: 0,0:35:42.62,0:35:44.62,Default,,0,0,0,,Мүмкін?
Dialogue: 0,0:35:44.62,0:35:46.62,Default,,0,0,0,,Эй, тежегіштер ше?
Dialogue: 0,0:35:46.62,0:35:50.63,Default,,0,0,0,,«Мм?»
Dialogue: 0,0:35:50.63,0:35:53.63,Default,,0,0,0,,Әй (қысқаша) Уау! Ааа!
Dialogue: 0,0:35:53.63,0:35:55.63,Default,,0,0,0,,О! Мен тоқтай алмаймын!
Dialogue: 0,0:35:55.63,0:35:58.64,Default,,0,0,0,,Ақымақ! (Қысқаша) Неліктен оны бастыңыз?
Dialogue: 0,0:35:58.64,0:36:01.57,Default,,0,0,0,,Уа уа уа уа!
Dialogue: 0,0:36:01.57,0:36:03.58,Default,,0,0,0,,У-у-у!
Dialogue: 0,0:36:03.58,0:36:07.58,Default,,0,0,0,,О! Өтінемін маған көмектесіңіз!
Dialogue: 0,0:36:07.58,0:36:11.58,Default,,0,0,0,,Оны таптым! Орманға кіріңіз! Орманға кіріңіз!
Dialogue: 0,0:36:11.58,0:36:14.59,Default,,0,0,0,,Үлкен порция Орташа порция Кіші порция ~?
Dialogue: 0,0:36:14.59,0:36:16.59,Default,,0,0,0,,Ол сонда! Бұл сіздің алдыңызда орман!
Dialogue: 0,0:36:16.59,0:36:18.59,Default,,0,0,0,,Хохохой
Dialogue: 0,0:36:18.59,0:36:22.59,Default,,0,0,0,,Иә! Хохо!
Dialogue: 0,0:36:22.59,0:36:26.60,Default,,0,0,0,,Уа уа уа уа!
Dialogue: 0,0:36:26.60,0:36:29.60,Default,,0,0,0,,Шинносуке! (Қысқаша) Маған көмектес!
Dialogue: 0,0:36:29.60,0:36:32.60,Default,,0,0,0,,Уау! (Әйел) Уау!
Dialogue: 0,0:36:32.60,0:36:36.61,Default,,0,0,0,,Мен сені әлі де бақылап жүрмін. Сіз сондай табандысыз.
Dialogue: 0,0:36:36.61,0:36:38.61,Default,,0,0,0,,Әй?
Dialogue: 0,0:36:38.61,0:36:41.61,Default,,0,0,0,,«Осуна»? Эй
Dialogue: 0,0:36:41.61,0:36:43.62,Default,,0,0,0,,Ааааааааа! Ахх!
Dialogue: 0,0:36:43.62,0:36:46.62,Default,,0,0,0,,Ах! Өтінемін маған көмектесіңіз!
Dialogue: 0,0:36:46.62,0:36:49.62,Default,,0,0,0,,Осы жылдамдықпен сіз қуырылған шошқаға айналасыз!
Dialogue: 0,0:36:49.62,0:36:51.62,Default,,0,0,0,,Хмм, жақсы иіс.
Dialogue: 0,0:36:51.62,0:36:54.63,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:36:54.63,0:36:57.63,Default,,0,0,0,,О! (Қысқаша) Ааа! Ааа!
Dialogue: 0,0:36:57.63,0:36:59.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:59.63,0:37:02.57,Default,,0,0,0,,Нанако Они-сан, мен саған міндетті түрде көмектесемін!
Dialogue: 0,0:37:02.57,0:37:04.57,Default,,0,0,0,,Алдымен маған көмектес!
Dialogue: 0,0:37:04.57,0:37:08.57,Default,,0,0,0,,Уау! Мүмкін емес!
Dialogue: 0,0:37:08.57,0:37:12.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:12.58,0:37:14.58,Default,,0,0,0,,Әй
Dialogue: 0,0:37:14.58,0:37:17.58,Default,,0,0,0,,Әдемі жүзіңде тыртық!
Dialogue: 0,0:37:25.59,0:37:28.59,Default,,0,0,0,,Ууууууууууууууу...
Dialogue: 0,0:37:28.59,0:37:33.60,Default,,0,0,0,,Да! Сіз қанша өмір сүрсеңіз де, сіздің көлік жүргізуіңіз жеткіліксіз болады.
Dialogue: 0,0:37:33.60,0:37:35.60,Default,,0,0,0,,Жоқ, онша емес.
Dialogue: 0,0:37:35.60,0:37:38.60,Default,,0,0,0,,Мен сені мақтап тұрғаным жоқ! О?
Dialogue: 0,0:37:38.60,0:37:40.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:43.61,0:37:47.61,Default,,0,0,0,,Мм... Ғажайып қарындашпен не жаратылған?
Dialogue: 0,0:37:47.61,0:37:49.61,Default,,0,0,0,,Сумен суланғанда ериді.
Dialogue: 0,0:37:49.61,0:37:51.62,Default,,0,0,0,,О...
Dialogue: 0,0:37:51.62,0:37:54.62,Default,,0,0,0,,Ракуга патшалығында тұратындар
Dialogue: 0,0:37:54.62,0:37:56.62,Default,,0,0,0,,Барлығы дұрыс.
Dialogue: 0,0:38:01.56,0:38:05.56,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:38:05.56,0:38:09.57,Default,,0,0,0,,Еден суық (Ageo) Хехе... хехехе...
Dialogue: 0,0:38:09.57,0:38:11.57,Default,,0,0,0,,Диван жұмсақ.
Dialogue: 0,0:38:11.57,0:38:16.57,Default,,0,0,0,,Сіз еркін сурет сала аласыз. Сурет салуды өтінемін.
Dialogue: 0,0:38:16.57,0:38:19.58,Default,,0,0,0,,Тек сурет салғыңыз келетін нәрсені салыңыз.
Dialogue: 0,0:38:19.58,0:38:22.58,Default,,0,0,0,,Қолымызды көбірек қозғалтайық!
Dialogue: 0,0:38:22.58,0:38:24.58,Default,,0,0,0,,Жылдам сурет салу~
Dialogue: 0,0:38:24.58,0:38:26.58,Default,,0,0,0,,Менің қолым ауырады...
Dialogue: 0,0:38:26.58,0:38:28.59,Default,,0,0,0,,Барлығына сәттілік!
Dialogue: 0,0:38:28.59,0:38:32.59,Default,,0,0,0,,Казама-кун жақсы, ол сонда ғана.
Dialogue: 0,0:38:32.59,0:38:35.59,Default,,0,0,0,,Иә, иә (Казама) Міне...
Dialogue: 0,0:38:35.59,0:38:38.60,Default,,0,0,0,,Хехе, қандай сурет салып жатырсың?
Dialogue: 0,0:38:38.60,0:38:40.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:38:40.60,0:38:44.60,Default,,0,0,0,,Бұл Фубукимару, Йоши-сенсэйден келген ниндзя бала.
Dialogue: 0,0:38:44.60,0:38:46.60,Default,,0,0,0,,Менің сурет салғаныңды қалаймын, ол тегін сурет!
Dialogue: 0,0:38:46.60,0:38:48.61,Default,,0,0,0,,Мұндай қызықсыз суреттер салмаңыз!
Dialogue: 0,0:38:48.61,0:38:53.61,Default,,0,0,0,,Бітті! Маған көмектесіңізші...
Dialogue: 0,0:38:53.61,0:38:57.62,Default,,0,0,0,,О? О...
Dialogue: 0,0:38:57.62,0:38:59.62,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:39:02.55,0:39:05.56,Default,,0,0,0,,Егер сіз осы жерден айналма жолмен жүрсеңіз, біраз артқа қайтуыңыз керек еді.
Dialogue: 0,0:39:05.56,0:39:08.56,Default,,0,0,0,,Жұмсақ еңіс таппасаң...
Dialogue: 0,0:39:08.56,0:39:10.56,Default,,0,0,0,,Бірақ бұл су...
Dialogue: 0,0:39:10.56,0:39:12.56,Default,,0,0,0,,Онда сіз ұшақтың суретін сала алмайсыз!
Dialogue: 0,0:39:12.56,0:39:14.57,Default,,0,0,0,,Жаудың тікұшағы болса не істер едің?
Dialogue: 0,0:39:14.57,0:39:17.57,Default,,0,0,0,,Өйткені Нанако-оне-сан асығуы керек!
Dialogue: 0,0:39:17.57,0:39:19.57,Default,,0,0,0,,Табылса, бала болмайды.
Dialogue: 0,0:39:19.57,0:39:21.57,Default,,0,0,0,,Мен аман-есен оралып, Касукабені құтқаруым керек.
Dialogue: 0,0:39:21.57,0:39:26.58,Default,,0,0,0,,Менің Нанакомен жексенбілік кездесуім де жойылады, солай ма?
Dialogue: 0,0:39:26.58,0:39:28.58,Default,,0,0,0,,Бұл...
Dialogue: 0,0:39:30.58,0:39:33.58,Default,,0,0,0,,Сорори Сорори... (Қысқаша) Қайда бара жатырсың?
Dialogue: 0,0:39:33.58,0:39:37.58,Default,,0,0,0,,Жоқ, тек дәретханаға барыңыз... (Қысқаша) Дәретхана қайда!?
Dialogue: 0,0:39:42.59,0:39:46.60,Default,,0,0,0,,Мен де барамын! Ннннн
Dialogue: 0,0:39:46.60,0:39:49.60,Default,,0,0,0,,Ммм... мммм
Dialogue: 0,0:39:49.60,0:39:52.60,Default,,0,0,0,,Менің қолымнан ұста!
Dialogue: 0,0:39:54.61,0:39:57.61,Default,,0,0,0,,Ннн-аа! Ааа!
Dialogue: 0,0:39:57.61,0:40:01.61,Default,,0,0,0,,Ха! Бұл мүмкін емес. Мен көтеріле алмаймын.
Dialogue: 0,0:40:01.61,0:40:04.62,Default,,0,0,0,,А... Мен бір рет түсемін.
Dialogue: 0,0:40:04.62,0:40:06.62,Default,,0,0,0,,О? иә?
Dialogue: 0,0:40:06.62,0:40:09.62,Default,,0,0,0,,Құтқарушы кейіпкер Бури Бури Заемон!
Dialogue: 0,0:40:09.62,0:40:13.62,Default,,0,0,0,,Ах! Мен көмек үшін 1 миллиард иен төлеймін!
Dialogue: 0,0:40:15.63,0:40:19.63,Default,,0,0,0,,Мен шынымен төлеймін! Ха...
Dialogue: 0,0:40:19.63,0:40:21.63,Default,,0,0,0,,Саяхат – сапар, дүние – рақым
Dialogue: 0,0:40:21.63,0:40:24.64,Default,,0,0,0,,Достарыңызды мұқтаждықта қалдырмаңыз
Dialogue: 0,0:40:24.64,0:40:28.64,Default,,0,0,0,,Не дейсің, ақымақ! Сау бол! Апыр-ай!
Dialogue: 0,0:40:28.64,0:40:30.64,Default,,0,0,0,,Сукетачи шығарылымы
Dialogue: 0,0:40:30.64,0:40:33.64,Default,,0,0,0,,Жоғарыға өтіңіз. Мен түссіндім.
Dialogue: 0,0:40:35.65,0:40:38.65,Default,,0,0,0,,Nnnnnnn…
Dialogue: 0,0:40:38.65,0:40:40.65,Default,,0,0,0,,Ннн!
Dialogue: 0,0:40:40.65,0:40:43.65,Default,,0,0,0,,Nnnnnnnnnnn… Эй.
Dialogue: 0,0:40:43.65,0:40:48.66,Default,,0,0,0,,Хммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:40:48.66,0:40:52.66,Default,,0,0,0,,Жүр, саған бірдеңе алып берейін.
Dialogue: 0,0:40:52.66,0:40:56.67,Default,,0,0,0,,Хмм? О!
Dialogue: 0,0:40:56.67,0:40:59.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:59.67,0:41:01.61,Default,,0,0,0,,1 миллиард иен
Dialogue: 0,0:41:01.61,0:41:03.61,Default,,0,0,0,,Бар болғаны 0...
Dialogue: 0,0:41:03.61,0:41:06.61,Default,,0,0,0,,Ах, Хэйсейдің ақшасы жақсы болды ма?
Dialogue: 0,0:41:06.61,0:41:09.61,Default,,0,0,0,,Көшедегі төбелесте ешқашан жеңілген емеспін.
Dialogue: 0,0:41:09.61,0:41:12.62,Default,,0,0,0,,Мен сені ашуландырған сияқтымын...
Dialogue: 0,0:41:12.62,0:41:15.62,Default,,0,0,0,,Мені кешіріңіз! Хохой
Dialogue: 0,0:41:15.62,0:41:17.62,Default,,0,0,0,,Осы жерде күтіңіз! (Қысқаша) О, менің...
Dialogue: 0,0:41:17.62,0:41:37.64,Default,,0,0,0,,♪
Dialogue: 0,0:41:37.64,0:41:57.66,Default,,0,0,0,,♪
Dialogue: 0,0:41:57.66,0:42:17.62,Default,,0,0,0,,♪
Dialogue: 0,0:42:17.62,0:42:37.64,Default,,0,0,0,,♪
Dialogue: 0,0:42:37.64,0:42:49.65,Default,,0,0,0,,♪
Dialogue: 0,0:42:49.65,0:42:52.65,Default,,0,0,0,,Иә!?
Dialogue: 0,0:42:52.65,0:42:54.65,Default,,0,0,0,,Тамақ!
Dialogue: 0,0:42:54.65,0:42:59.66,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:42:59.66,0:43:02.59,Default,,0,0,0,,О, бұл қала ғой.
Dialogue: 0,0:43:02.59,0:43:05.60,Default,,0,0,0,,О! Күріштің иісі бар!
Dialogue: 0,0:43:05.60,0:43:07.60,Default,,0,0,0,,Мен есептегендей!
Dialogue: 0,0:43:07.60,0:43:10.60,Default,,0,0,0,,Төмен қарай жүгіру қауіпті!
Dialogue: 0,0:43:14.61,0:43:18.61,Default,,0,0,0,,Бүгін мен сені Фута үкімен таныстырғым келеді.
Dialogue: 0,0:43:18.61,0:43:21.61,Default,,0,0,0,,Бұл өткір тырнақтар менің сүйкімділігім.
Dialogue: 0,0:43:21.61,0:43:23.61,Default,,0,0,0,,Міне, Фута-кунның Могумогу уақыты.
Dialogue: 0,0:43:23.61,0:43:26.62,Default,,0,0,0,,Ләззат алыңыз
Dialogue: 0,0:43:26.62,0:43:28.62,Default,,0,0,0,,«Юмаға, Касукабенің әжесіне.
Dialogue: 0,0:43:28.62,0:43:32.62,Default,,0,0,0,,Мен келемін. Мен кешке үйде боламын».
Dialogue: 0,0:43:32.62,0:43:34.63,Default,,0,0,0,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,0:43:34.63,0:43:36.63,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:43:36.63,0:43:39.63,Default,,0,0,0,,Күріш, күріш, күріш, күріш, күріш! Күріш, күріш, күріш, күріш!
Dialogue: 0,0:43:39.63,0:43:42.63,Default,,0,0,0,,Күріш, күріш, күріш! Күріш, күріш, күріш, күріш!
Dialogue: 0,0:43:42.63,0:43:44.64,Default,,0,0,0,,Күріш, күріш, күріш, күріш, күріш, күріш!
Dialogue: 0,0:43:44.64,0:43:49.64,Default,,0,0,0,,Күріш, күріш, күріш, күріш! Күріш, күріш, күріш!
Dialogue: 0,0:43:49.64,0:43:51.64,Default,,0,0,0,,О!
Dialogue: 0,0:43:51.64,0:43:53.64,Default,,0,0,0,,О, мінекей!
Dialogue: 0,0:43:53.64,0:43:55.65,Default,,0,0,0,,Қош келдіңіз! Анашым!?
Dialogue: 0,0:43:55.65,0:43:57.65,Default,,0,0,0,,О? Ах...
Dialogue: 0,0:43:57.65,0:44:01.59,Default,,0,0,0,,Ола, бұл менің анам емес.
Dialogue: 0,0:44:01.59,0:44:04.59,Default,,0,0,0,,Дүкен Мен мұны істемеймін.
Dialogue: 0,0:44:04.59,0:44:06.59,Default,,0,0,0,,Жақсы иіс
Dialogue: 0,0:44:06.59,0:44:08.59,Default,,0,0,0,,Карри өте жақсы.
Dialogue: 0,0:44:08.59,0:44:11.60,Default,,0,0,0,,Карри жеген дұрыс!
Dialogue: 0,0:44:11.60,0:44:13.60,Default,,0,0,0,,Нмм...
Dialogue: 0,0:44:13.60,0:44:15.60,Default,,0,0,0,,Маған тамақ ішуге рұқсат етіңіз!
Dialogue: 0,0:44:15.60,0:44:18.60,Default,,0,0,0,,Мен оны аламын! (Жақсы Нанако) Мен Шин Чанды жақсы көремін
Dialogue: 0,0:44:18.60,0:44:21.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:21.61,0:44:24.61,Default,,0,0,0,,Нмм...
Dialogue: 0,0:44:24.61,0:44:26.61,Default,,0,0,0,,Карри ең жақсысы!
Dialogue: 0,0:44:26.61,0:44:30.61,Default,,0,0,0,,Өте дәмді! (Қысқаша) Мен өмірге қайта ораламын.
Dialogue: 0,0:44:30.61,0:44:32.62,Default,,0,0,0,,Бұл ет шошқа емес пе?
Dialogue: 0,0:44:32.62,0:44:35.62,Default,,0,0,0,,Мен Шин Чанды жақсы көремін~
Dialogue: 0,0:44:35.62,0:44:37.62,Default,,0,0,0,,Ха, өте дәмді болды!
Dialogue: 0,0:44:37.62,0:44:40.62,Default,,0,0,0,,А, бұл ұят.
Dialogue: 0,0:44:40.62,0:44:43.63,Default,,0,0,0,,Дем алған соң, Касукабеге жол тартайық.
Dialogue: 0,0:44:43.63,0:44:45.63,Default,,0,0,0,,Ха Касукабе?
Dialogue: 0,0:44:45.63,0:44:48.63,Default,,0,0,0,,Оны жау басып алған болуы мүмкін.
Dialogue: 0,0:44:48.63,0:44:51.64,Default,,0,0,0,,Өте сақ болу керек.
Dialogue: 0,0:44:51.64,0:44:54.64,Default,,0,0,0,,Ей, сен сарапшысың (Қысқаша)!
Dialogue: 0,0:44:54.64,0:44:56.64,Default,,0,0,0,,Касукабе халқы қиыншылықта.
Dialogue: 0,0:44:56.64,0:44:58.64,Default,,0,0,0,,Сіз құтқарылу кейіпкерісіз бе?
Dialogue: 0,0:44:58.64,0:45:02.58,Default,,0,0,0,,Құтқару батыры күніне 3 сағат қана жұмыс істей алады!
Dialogue: 0,0:45:02.58,0:45:05.58,Default,,0,0,0,,Касукабе қаласында шамамен 230 000 адам тұрады.
Dialogue: 0,0:45:05.58,0:45:08.59,Default,,0,0,0,,Көмек ақысы ретінде әр адамға 100 иен алсаңыз да.
Dialogue: 0,0:45:08.59,0:45:10.59,Default,,0,0,0,,23 миллион? Эй
Dialogue: 0,0:45:10.59,0:45:13.59,Default,,0,0,0,,Дайын бол, біз Касукабеге бара жатырмыз.
Dialogue: 0,0:45:13.59,0:45:15.59,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:45:15.59,0:45:17.60,Default,,0,0,0,,Менің де барғым келеді (қысқаша) иә?
Dialogue: 0,0:45:17.60,0:45:20.60,Default,,0,0,0,,«Мен Касукабенің әжесінің үйіне барамын».
Dialogue: 0,0:45:20.60,0:45:23.60,Default,,0,0,0,,Қашан бардыңыз? Кеше...
Dialogue: 0,0:45:23.60,0:45:26.60,Default,,0,0,0,,Бұл алаңдатады. Әкең ше?
Dialogue: 0,0:45:26.60,0:45:29.61,Default,,0,0,0,,Үйде тек анам екеуміз.
Dialogue: 0,0:45:29.61,0:45:31.61,Default,,0,0,0,,Сіз төбелесе аласыз ба?
Dialogue: 0,0:45:31.61,0:45:33.61,Default,,0,0,0,,Баратын жеріміз – ұрыс алаңы.
Dialogue: 0,0:45:33.61,0:45:35.61,Default,,0,0,0,,Шайқас…
Dialogue: 0,0:45:35.61,0:45:38.62,Default,,0,0,0,,Неге мені олай қорқытасың?
Dialogue: 0,0:45:38.62,0:45:41.62,Default,,0,0,0,,Қорқудың қажеті жоқ. Уайымдама.
Dialogue: 0,0:45:41.62,0:45:44.62,Default,,0,0,0,,Бұл адам Касукабені құтқаратын батыр.
Dialogue: 0,0:45:44.62,0:45:46.62,Default,,0,0,0,,Иә, мен батырмын!
Dialogue: 0,0:45:46.62,0:45:50.63,Default,,0,0,0,,Әділдіктің одақтасы әрекет маскасы! Вахахаха!
Dialogue: 0,0:45:50.63,0:45:52.63,Default,,0,0,0,,Оны бізге қалдырыңыз!
Dialogue: 0,0:45:52.63,0:45:55.63,Default,,0,0,0,,Ола Синносуке Нохара
Dialogue: 0,0:45:55.63,0:45:58.64,Default,,0,0,0,,Ал екінші күнгі сасық шалбар.
Dialogue: 0,0:45:58.64,0:46:01.57,Default,,0,0,0,,«Иістің» қажеті жоқ! Батыр Бури Бури Заемоны құтқару
Dialogue: 0,0:46:01.57,0:46:05.58,Default,,0,0,0,,Хун... мүмкін Нанако Они-сан
Dialogue: 0,0:46:05.58,0:46:10.58,Default,,0,0,0,,Мына қарындашпен сурет салғанда үшеуі де суреттен шықты.
Dialogue: 0,0:46:10.58,0:46:12.58,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:46:12.58,0:46:15.59,Default,,0,0,0,,Мен Юумамын, пойыз әлі жүріп жатыр.
Dialogue: 0,0:46:15.59,0:46:18.59,Default,,0,0,0,,Қасукабеге барайық. Егер сізде ақша болса, бұл.
Dialogue: 0,0:46:18.59,0:46:21.59,Default,,0,0,0,,Оны қазір лақтырып тастаңыз!
Dialogue: 0,0:46:21.59,0:46:24.60,Default,,0,0,0,,Шуппацу Ошинко~!
Dialogue: 0,0:46:24.60,0:46:26.60,Default,,0,0,0,,Мен пойызға мінемін.
Dialogue: 0,0:46:26.60,0:46:29.60,Default,,0,0,0,,Иә, Юума-кунның қалталы ақшасымен.
Dialogue: 0,0:46:29.60,0:46:31.60,Default,,0,0,0,,Барлығы тым ерекшеленеді
Dialogue: 0,0:46:34.61,0:46:36.61,Default,,0,0,0,,Әй, бұл не!
Dialogue: 0,0:46:36.61,0:46:40.61,Default,,0,0,0,,Юуманың анасының қалпағы жарқыраған.
Dialogue: 0,0:46:40.61,0:46:42.61,Default,,0,0,0,,Шляпалар мен бетперделер жасырынудың жақсы тәсілі.
Dialogue: 0,0:46:42.61,0:46:44.62,Default,,0,0,0,,Жарайды, қой!
Dialogue: 0,0:46:44.62,0:46:48.62,Default,,0,0,0,,Мм, сен неше минутта келесің?
Dialogue: 0,0:46:48.62,0:46:51.62,Default,,0,0,0,,Мен бұған ұзақ шыдай алмаймын.
Dialogue: 0,0:46:51.62,0:46:55.63,Default,,0,0,0,,Жылдам пойыз келе жатыр, қауіпті.
Dialogue: 0,0:46:55.63,0:46:58.63,Default,,0,0,0,,Сары аялдама сызығына тоқтаңыз.
Dialogue: 0,0:46:58.63,0:47:03.57,Default,,0,0,0,,Есікті жапқан кезде артыңыздағы жолаушылардан сақ болыңыз.
Dialogue: 0,0:47:03.57,0:47:05.57,Default,,0,0,0,,Соңғы минутта отырғызудан аулақ болыңыз.
Dialogue: 0,0:47:05.57,0:47:07.57,Default,,0,0,0,,Есік жабылады
Dialogue: 0,0:47:07.57,0:47:09.57,Default,,0,0,0,,Нмм...
Dialogue: 0,0:47:09.57,0:47:11.58,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:47:11.58,0:47:14.58,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:47:14.58,0:47:19.58,Default,,0,0,0,,Бо! Масао-кун Нене-чан!
Dialogue: 0,0:47:19.58,0:47:22.59,Default,,0,0,0,,Нмм...
Dialogue: 0,0:47:22.59,0:47:24.59,Default,,0,0,0,,Оян! (Қазама) Әй!
Dialogue: 0,0:47:24.59,0:47:27.59,Default,,0,0,0,,♪(ысқырық)
Dialogue: 0,0:47:27.59,0:47:29.59,Default,,0,0,0,,Масао-кун
Dialogue: 0,0:47:29.59,0:47:31.60,Default,,0,0,0,,♪(ﾏﾂｹﾝｻﾝﾊﾞ) ()
Dialogue: 0,0:47:31.60,0:47:34.60,Default,,0,0,0,,Бо?
Dialogue: 0,0:47:34.60,0:47:37.60,Default,,0,0,0,,Не... не!? Бұл не!
Dialogue: 0,0:47:37.60,0:47:40.60,Default,,0,0,0,,Ааааааааа... (қауын) хехехехе
Dialogue: 0,0:47:40.60,0:47:42.61,Default,,0,0,0,,Бұл «Oekaki SUN»
Dialogue: 0,0:47:42.61,0:47:46.61,Default,,0,0,0,,Сурет салуды қызықты өткізуге мүмкіндік беретін құрал!
Dialogue: 0,0:47:46.61,0:47:48.61,Default,,0,0,0,,Не істеп жатырсың?!
Dialogue: 0,0:47:48.61,0:47:51.62,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:47:51.62,0:47:58.62,Default,,0,0,0,,♪О-э-ка-ки самба~! О~ле~ О~ле~
Dialogue: 0,0:47:58.62,0:48:01.56,Default,,0,0,0,,♪ Келіңіздер! Оэкаки самба!
Dialogue: 0,0:48:01.56,0:48:04.56,Default,,0,0,0,,Тоқта! Маған көмектесші!
Dialogue: 0,0:48:04.56,0:48:07.56,Default,,0,0,0,,Егер сіз дудльдеріңізді аяқтасаңыз, мен сізді тастап кетемін.
Dialogue: 0,0:48:07.56,0:48:12.57,Default,,0,0,0,,Бұл сізді ұйықтатпайды, солай ма?
Dialogue: 0,0:48:12.57,0:48:16.57,Default,,0,0,0,,Балалар, сендер де осыған мінгілерің келе ме?
Dialogue: 0,0:48:16.57,0:48:20.58,Default,,0,0,0,,Кәне, бәріміз, жігерлі сурет салайық!
Dialogue: 0,0:48:20.58,0:48:24.58,Default,,0,0,0,,Мен қатты дірілдеп тұрғандықтан сурет сала алмаймын!
Dialogue: 0,0:48:24.58,0:48:28.59,Default,,0,0,0,,Шинчан! Қайда бардың!?
Dialogue: 0,0:48:28.59,0:48:33.59,Default,,0,0,0,,Нанако Они-сан, мен саған көмектесемін (Қысқаша) Шинносуке-сан!
Dialogue: 0,0:48:33.59,0:48:38.60,Default,,0,0,0,,Шинносуке-сан! Мен өз шегімдемін, мені шығарып жіберіңізші...
Dialogue: 0,0:48:38.60,0:48:40.60,Default,,0,0,0,,Пойыз Минамикошигаяда тоқтады.
Dialogue: 0,0:48:40.60,0:48:44.60,Default,,0,0,0,,Ол жерден Касукабеге дейін 10 км... Бұл алыс.
Dialogue: 0,0:48:44.60,0:48:46.60,Default,,0,0,0,,Оны алыңыз!
Dialogue: 0,0:48:46.60,0:48:49.60,Default,,0,0,0,,Ангия! Ангия! Ангия!
Dialogue: 0,0:48:55.61,0:48:57.61,Default,,0,0,0,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,0:48:57.61,0:49:00.62,Default,,0,0,0,,Не? Не болып жатыр?
Dialogue: 0,0:49:00.62,0:49:03.55,Default,,0,0,0,,Бұл жерде не болып жатыр?
Dialogue: 0,0:49:03.55,0:49:05.56,Default,,0,0,0,,Біз әлі ештеңе білмейміз.
Dialogue: 0,0:49:05.56,0:49:08.56,Default,,0,0,0,,Артқа тұрыңыз. (Топ) Көп адам
Dialogue: 0,0:49:08.56,0:49:11.56,Default,,0,0,0,,Жоғалып кетті дейді. Бұл рас па?
Dialogue: 0,0:49:11.56,0:49:14.57,Default,,0,0,0,,Әлі ештеңе анық емес.
Dialogue: 0,0:49:14.57,0:49:17.57,Default,,0,0,0,,Кейбір ақпарат! (SDF) Артқа тұрыңыз!
Dialogue: 0,0:49:27.58,0:49:29.58,Default,,0,0,0,,Егер бұл жақсы болса, онда жақын жерде...
Dialogue: 0,0:49:29.58,0:49:32.58,Default,,0,0,0,,()
Dialogue: 0,0:49:32.58,0:49:36.58,Default,,0,0,0,,Хохой! Юума-кун сенімді~
Dialogue: 0,0:49:38.59,0:49:40.59,Default,,0,0,0,,О!?
Dialogue: 0,0:49:40.59,0:50:00.61,Default,,0,0,0,,♪
Dialogue: 0,0:50:00.61,0:50:03.61,Default,,0,0,0,,Шуппацу Ошинко~! ақымақ!
Dialogue: 0,0:50:03.61,0:50:05.61,Default,,0,0,0,,Қараңызшы (2 адам) Иә?
Dialogue: 0,0:50:08.62,0:50:10.62,Default,,0,0,0,,Қазіргі уақытта
Dialogue: 0,0:50:10.62,0:50:13.62,Default,,0,0,0,,Касукабе төңірегінде пайда болатын тұманның құрамы белгісіз.
Dialogue: 0,0:50:13.62,0:50:16.63,Default,,0,0,0,,Бізден бұрынғы Омия бөлімімен байланысу мүмкін емес.
Dialogue: 0,0:50:16.63,0:50:18.63,Default,,0,0,0,,Жағдайыңызды жіберіңіз
Dialogue: 0,0:50:18.63,0:50:21.63,Default,,0,0,0,,Мұнда басыңыз Шингагава OP қазір Комакадодан
Dialogue: 0,0:50:21.63,0:50:25.64,Default,,0,0,0,,Тіреу цистернасының көлігі жиналатын жерге қарай өтіп жатыр.
Dialogue: 0,0:50:25.64,0:50:28.64,Default,,0,0,0,,1130 Касукабе аймағына кіру жоспарланған Жіберу
Dialogue: 0,0:50:28.64,0:50:30.64,Default,,0,0,0,,Шамамен айналмалы даму
Dialogue: 0,0:50:30.64,0:50:34.65,Default,,0,0,0,,Желдің ағымдағы жылдамдығы 5м Тұманға жел әсер етпейді
Dialogue: 0,0:50:34.65,0:50:37.65,Default,,0,0,0,,Ха, мен оны шешіп аламын.
Dialogue: 0,0:50:37.65,0:50:40.65,Default,,0,0,0,,Екінші күні шалбар
Dialogue: 0,0:50:40.65,0:50:42.65,Default,,0,0,0,,Сасық!
Dialogue: 0,0:50:42.65,0:50:45.66,Default,,0,0,0,,Неге маған жаңасын бермедің?
Dialogue: 0,0:50:45.66,0:50:48.66,Default,,0,0,0,,Енді шайқасқа дайындал.
Dialogue: 0,0:50:48.66,0:50:51.66,Default,,0,0,0,,Ақырында Касукабені қайтарып алатын кез келді
Dialogue: 0,0:50:51.66,0:50:54.67,Default,,0,0,0,,Оны маған жапсырғың келе ме!?》
Dialogue: 0,0:50:54.67,0:50:56.67,Default,,0,0,0,,Жоқ... (Қысқаша) Иә?
Dialogue: 0,0:50:56.67,0:50:59.67,Default,,0,0,0,,Менде сурет дәптері жоқ.
Dialogue: 0,0:50:59.67,0:51:01.61,Default,,0,0,0,,Сіз ебедейсіз! Соны айтсаң да
Dialogue: 0,0:51:01.61,0:51:03.61,Default,,0,0,0,,Онда жоқ нәрсе жоқ!
Dialogue: 0,0:51:03.61,0:51:06.61,Default,,0,0,0,,Сіз мені кінәлап отырсыз ба?! Жүрексіз адам!
Dialogue: 0,0:51:06.61,0:51:08.61,Default,,0,0,0,,О?
Dialogue: 0,0:51:08.61,0:51:11.62,Default,,0,0,0,,Шин-чан, мен сені сүйемін, Нанако-оне-сан!
Dialogue: 0,0:51:11.62,0:51:14.62,Default,,0,0,0,,Шушупоппо Шушупоппо Шушупоппо Шушупоппо
Dialogue: 0,0:51:14.62,0:51:17.62,Default,,0,0,0,,Поппо! Шушупопо Шушупопо
Dialogue: 0,0:51:17.62,0:51:20.62,Default,,0,0,0,,Шушупоппо Шушупоппо Поппо!
Dialogue: 0,0:51:20.62,0:51:22.63,Default,,0,0,0,,Шушупоппо Шушупоппо Шушупоппо Шушупоппо
Dialogue: 0,0:51:22.63,0:51:25.63,Default,,0,0,0,,Поппо! Батыр!
Dialogue: 0,0:51:25.63,0:51:27.63,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:51:27.63,0:51:29.63,Default,,0,0,0,,Қарындаштар таусылады ма?
Dialogue: 0,0:51:29.63,0:51:33.64,Default,,0,0,0,,Ештеңе етпейді, мен осы операцияға оралдым.
Dialogue: 0,0:51:33.64,0:51:37.64,Default,,0,0,0,,Шушупоппо Шушупоппо Шушупоппо Шушупоппо...
Dialogue: 0,0:51:37.64,0:51:40.64,Default,,0,0,0,,Хмм! Жарайды, орындалды!
Dialogue: 0,0:51:43.65,0:51:45.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:45.65,0:51:49.65,Default,,0,0,0,,Сіз оны көрдіңіз бе? бұл біздің күшіміз
Dialogue: 0,0:51:49.65,0:51:54.66,Default,,0,0,0,,Ғажайып... Шинносуке шынымен де батыр еді.
Dialogue: 0,0:51:54.66,0:51:56.66,Default,,0,0,0,,Мен құтқарылу батырымын!
Dialogue: 0,0:51:56.66,0:51:58.66,Default,,0,0,0,,Барлығы, зарядтаңыз!
Dialogue: 0,0:51:58.66,0:52:02.56,Default,,0,0,0,,Ах! Дәмді жер! иә?
Dialogue: 0,0:52:09.61,0:52:12.61,Default,,0,0,0,,Көмектесіңіз! (Сарбаздар) А?
Dialogue: 0,0:52:15.61,0:52:17.61,Default,,0,0,0,,Уау! (Солдат) Бұл кім?
Dialogue: 0,0:52:17.61,0:52:20.62,Default,,0,0,0,,Қайта алу операциясы басталады!
Dialogue: 0,0:52:20.62,0:52:22.62,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:52:22.62,0:52:24.62,Default,,0,0,0,,Ах!?
Dialogue: 0,0:52:24.62,0:52:27.62,Default,,0,0,0,,Уау! (Қысқаша) Ааааааааааа!
Dialogue: 0,0:52:27.62,0:52:29.62,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:52:31.63,0:52:33.63,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:52:33.63,0:52:37.63,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:52:37.63,0:52:39.64,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:52:39.64,0:52:41.64,Default,,0,0,0,,Сіз дудле жасаған кезде
Dialogue: 0,0:52:41.64,0:52:44.64,Default,,0,0,0,,Қандай ұят! Хохо~ Әдемі~
Dialogue: 0,0:52:44.64,0:52:46.64,Default,,0,0,0,,А... бітті.
Dialogue: 0,0:52:46.64,0:52:49.65,Default,,0,0,0,,Қаншама қарындашты босқа жұмсадым.
Dialogue: 0,0:52:49.65,0:52:51.65,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:52:51.65,0:52:53.65,Default,,0,0,0,,Сонда... мына қарындаш ше!?
Dialogue: 0,0:52:53.65,0:52:55.65,Default,,0,0,0,,Аа... Нннннннннннннннннннннннннннннннннннннннннннннннн
Dialogue: 0,0:52:55.65,0:52:59.65,Default,,0,0,0,,Уау! (жарылыс дыбысы)
Dialogue: 0,0:53:02.59,0:53:04.60,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:53:04.60,0:53:07.60,Default,,0,0,0,,Сіз күресуге болатын нәрсені салыңыз.
Dialogue: 0,0:53:07.60,0:53:11.60,Default,,0,0,0,,Қазірдің өзінде! Сіз осындай кішкентай кеңістікте сурет сала аласыз деп айтасыз ба?
Dialogue: 0,0:53:11.60,0:53:14.61,Default,,0,0,0,,Дөрекі шалбар
Dialogue: 0,0:53:14.61,0:53:16.61,Default,,0,0,0,,Бұл не? Ментайко
Dialogue: 0,0:53:16.61,0:53:19.61,Default,,0,0,0,,Мен сізге күресе алатын нәрсені қалайтынымды айттым!
Dialogue: 0,0:53:19.61,0:53:21.61,Default,,0,0,0,,Балалар!
Dialogue: 0,0:53:23.61,0:53:26.62,Default,,0,0,0,,Тыныш шығыңыз! (Қысқаша) Қорқақ!
Dialogue: 0,0:53:26.62,0:53:29.62,Default,,0,0,0,,Мен әрқашан мықтының жағындамын.
Dialogue: 0,0:53:29.62,0:53:32.62,Default,,0,0,0,,Осы ментайкоға "бомба" деп жазып көріңіз.
Dialogue: 0,0:53:32.62,0:53:35.63,Default,,0,0,0,,«Бомба»!? Ба Ба Ба…
Dialogue: 0,0:53:35.63,0:53:38.63,Default,,0,0,0,,“Ba” – “Ba”! Бабибубебоның «ба»!
Dialogue: 0,0:53:38.63,0:53:41.63,Default,,0,0,0,,Иә? Хмм? Бабибубебононың «Ба»
Dialogue: 0,0:53:41.63,0:53:44.64,Default,,0,0,0,,Хмм? Бабибубебоның «ба»!
Dialogue: 0,0:53:44.64,0:53:48.64,Default,,0,0,0,,Шинносуке, мінеки!
Dialogue: 0,0:53:48.64,0:53:50.64,Default,,0,0,0,,Тыныш шықсаң
Dialogue: 0,0:53:50.64,0:53:53.64,Default,,0,0,0,,Мен сені кешіремін.
Dialogue: 0,0:53:53.64,0:53:56.65,Default,,0,0,0,,Иә? «Бакудан»…
Dialogue: 0,0:53:56.65,0:53:59.65,Default,,0,0,0,,Ах!!
Dialogue: 0,0:53:59.65,0:54:04.59,Default,,0,0,0,,Көбірек сурет сал! Өйткені ол адамдармен қатал!
Dialogue: 0,0:54:04.59,0:54:08.59,Default,,0,0,0,,Уау! (жарылыс дыбысы)
Dialogue: 0,0:54:08.59,0:54:10.59,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:54:10.59,0:54:13.60,Default,,0,0,0,,Юума-кун керемет! Сол қарындаштың арқасында
Dialogue: 0,0:54:13.60,0:54:15.60,Default,,0,0,0,,Жоспармен бірдей.
Dialogue: 0,0:54:15.60,0:54:18.60,Default,,0,0,0,,...
Dialogue: 0,0:54:18.60,0:54:20.60,Default,,0,0,0,,Бұл сатқын! мен әрқашан
Dialogue: 0,0:54:20.60,0:54:23.61,Default,,0,0,0,,Мен мықтылардың одақтасымын! (Қысқаша) Бұл! Бұл~!
Dialogue: 0,0:54:23.61,0:54:26.61,Default,,0,0,0,,Ах! Біреу!
Dialogue: 0,0:54:26.61,0:54:29.61,Default,,0,0,0,,Йошинага Сенсэй! Шин-чан!?
Dialogue: 0,0:54:29.61,0:54:32.62,Default,,0,0,0,,...
Dialogue: 0,0:54:32.62,0:54:35.62,Default,,0,0,0,,Хохо, мен батырмын!
Dialogue: 0,0:54:35.62,0:54:38.62,Default,,0,0,0,,Көмектесіңіз! Крутто
Dialogue: 0,0:54:38.62,0:54:41.63,Default,,0,0,0,,Ах... Шин-чан, бұл керемет!
Dialogue: 0,0:54:41.63,0:54:43.63,Default,,0,0,0,,...
Dialogue: 0,0:54:43.63,0:54:45.63,Default,,0,0,0,,Үлкен қаруды тартуға болмайды
Dialogue: 0,0:54:45.63,0:54:48.63,Default,,0,0,0,,...
Dialogue: 0,0:54:48.63,0:54:52.64,Default,,0,0,0,,… (ﾕｳﾏ)
Dialogue: 0,0:54:52.64,0:54:55.64,Default,,0,0,0,,Жақсы! Біраз дудлдар жасайық~
Dialogue: 0,0:54:55.64,0:54:57.64,Default,,0,0,0,,Какикакикакикакикакикаки~!
Dialogue: 0,0:54:57.64,0:55:00.64,Default,,0,0,0,,♪～ (ﾏｻｵ)…
Dialogue: 0,0:55:00.64,0:55:05.58,Default,,0,0,0,,～
Dialogue: 0,0:55:05.58,0:55:08.59,Default,,0,0,0,,♪～ (ﾎﾞｰ)
Dialogue: 0,0:55:08.59,0:55:10.59,Default,,0,0,0,,Иә! (Жоқ) Уау!
Dialogue: 0,0:55:10.59,0:55:14.59,Default,,0,0,0,,～ (ﾏｻｵ)～
Dialogue: 0,0:55:14.59,0:55:17.59,Default,,0,0,0,,Бітті!
Dialogue: 0,0:55:17.59,0:55:19.60,Default,,0,0,0,,(ﾏｻｵ)
Dialogue: 0,0:55:19.60,0:55:23.60,Default,,0,0,0,,Масао-сан (Масао) Иә?
Dialogue: 0,0:55:23.60,0:55:25.60,Default,,0,0,0,,Хэхе (жоқ) Уау!
Dialogue: 0,0:55:25.60,0:55:28.61,Default,,0,0,0,,Уау! Мен біртүрлі нәрсе көрдім!
Dialogue: 0,0:55:28.61,0:55:30.61,Default,,0,0,0,,Уау! (Кішкентай трикотаж) Нене-сан!
Dialogue: 0,0:55:30.61,0:55:32.61,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:55:32.61,0:55:34.61,Default,,0,0,0,,Ішінде не болып жатқанын білу үшін келдім.
Dialogue: 0,0:55:34.61,0:55:38.62,Default,,0,0,0,,...
Dialogue: 0,0:55:38.62,0:55:40.62,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:55:40.62,0:55:42.62,Default,,0,0,0,,Бұл шынымен де...
Dialogue: 0,0:55:42.62,0:55:45.62,Default,,0,0,0,,...
Dialogue: 0,0:55:45.62,0:55:47.62,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,0:55:47.62,0:55:49.63,Default,,0,0,0,,Йо
Dialogue: 0,0:55:49.63,0:55:51.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:51.63,0:55:54.63,Default,,0,0,0,,Ха! (Қауын) Гуха!
Dialogue: 0,0:55:54.63,0:55:56.63,Default,,0,0,0,,Зарядтау~! Шин Чан!
Dialogue: 0,0:55:56.63,0:55:58.64,Default,,0,0,0,,Oketsu Hammer Tow! (Солдат) Сасық!
Dialogue: 0,0:55:58.64,0:56:00.64,Default,,0,0,0,,Сасық!
Dialogue: 0,0:56:00.64,0:56:02.57,Default,,0,0,0,,Иә! Ха! (Солдат) Сасық!
Dialogue: 0,0:56:02.57,0:56:05.58,Default,,0,0,0,,Өте!
Dialogue: 0,0:56:05.58,0:56:08.58,Default,,0,0,0,,Тоу! Тарту! Сондай-ақ!
Dialogue: 0,0:56:08.58,0:56:10.58,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:56:13.58,0:56:16.59,Default,,0,0,0,,Қазірдің өзінде! Мен үлкен дудтер жоқ дедім...
Dialogue: 0,0:56:16.59,0:56:19.59,Default,,0,0,0,,Ей, мынау, мынау!
Dialogue: 0,0:56:19.59,0:56:21.59,Default,,0,0,0,,Қарғыс атқыр, сасық!
Dialogue: 0,0:56:21.59,0:56:24.59,Default,,0,0,0,,Шинносуке, тезірек көмектесші... Е-е!
Dialogue: 0,0:56:24.59,0:56:27.60,Default,,0,0,0,,Эй, сасық. Бірдеңе жасаңыз.
Dialogue: 0,0:56:27.60,0:56:29.60,Default,,0,0,0,,​​О?
Dialogue: 0,0:56:29.60,0:56:32.60,Default,,0,0,0,,Уау!!
Dialogue: 0,0:56:32.60,0:56:34.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:34.60,0:56:37.61,Default,,0,0,0,,Уау! Өтінемін маған көмектесіңіз!
Dialogue: 0,0:56:37.61,0:56:39.61,Default,,0,0,0,,Әбеши! (Сарбаздар) Уау!
Dialogue: 0,0:56:39.61,0:56:41.61,Default,,0,0,0,,Жоспарланғандай
Dialogue: 0,0:56:41.61,0:56:43.61,Default,,0,0,0,,Осы жерге оралыңыз!
Dialogue: 0,0:56:43.61,0:56:45.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:45.62,0:56:47.62,Default,,0,0,0,,Казама-кун, сен не істеп жатырсың?
Dialogue: 0,0:56:47.62,0:56:50.62,Default,,0,0,0,,Көріп тұрсың, мен қозғала алмаймын!
Dialogue: 0,0:56:50.62,0:56:52.62,Default,,0,0,0,,Ааа~ Мен қозғала алмаймын~
Dialogue: 0,0:56:52.62,0:56:55.63,Default,,0,0,0,,Фу Хахун
Dialogue: 0,0:56:55.63,0:56:57.63,Default,,0,0,0,,Тоқта! Апыр-ай!
Dialogue: 0,0:56:57.63,0:56:59.63,Default,,0,0,0,,Көмектесіңіз! Шеңберде
Dialogue: 0,0:56:59.63,0:57:02.57,Default,,0,0,0,,Уау, сен сондай батылсың!
Dialogue: 0,0:57:02.57,0:57:05.57,Default,,0,0,0,,Ол секіргеннен бері көмектесу мүмкін емес!
Dialogue: 0,0:57:05.57,0:57:07.57,Default,,0,0,0,,～ ()
Dialogue: 0,0:57:07.57,0:57:09.57,Default,,0,0,0,,～
Dialogue: 0,0:57:09.57,0:57:11.58,Default,,0,0,0,,Кешіріңіз, мені кешіріңіз! (Қазама) Әй!
Dialogue: 0,0:57:11.58,0:57:13.58,Default,,0,0,0,,(ｼﾛ)  (３)
Dialogue: 0,0:57:13.58,0:57:16.58,Default,,0,0,0,,...
Dialogue: 0,0:57:16.58,0:57:18.58,Default,,0,0,0,,А, шығып жатыр! Ааа!
Dialogue: 0,0:57:18.58,0:57:20.58,Default,,0,0,0,,(Құмырсқа дыбысы)
Dialogue: 0,0:57:20.58,0:57:23.59,Default,,0,0,0,,Ғұн Ауыздай үлкен емес
Dialogue: 0,0:57:23.59,0:57:25.59,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:57:25.59,0:57:28.59,Default,,0,0,0,,Широ~! Ахахха
Dialogue: 0,0:57:28.59,0:57:30.59,Default,,0,0,0,,Қалайсың? Энн!
Dialogue: 0,0:57:30.59,0:57:33.60,Default,,0,0,0,,Сенің әкеңмен және анаңмен қанша уақыт бар? Кун…
Dialogue: 0,0:57:33.60,0:57:35.60,Default,,0,0,0,,Шинчан! (Казама) Шинносуке!
Dialogue: 0,0:57:35.60,0:57:39.60,Default,,0,0,0,,Ауырды (Басшы) Йошинага-сенсэй!
Dialogue: 0,0:57:39.60,0:57:42.61,Default,,0,0,0,,Барлығына! Ах, жақсы
Dialogue: 0,0:57:42.61,0:57:45.61,Default,,0,0,0,,Бұл қарындаш шынымен де керемет.
Dialogue: 0,0:57:45.61,0:57:47.61,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:57:47.61,0:57:51.62,Default,,0,0,0,,Бұл қарындаш - дудл энергиясының кристалы.
Dialogue: 0,0:57:51.62,0:57:53.62,Default,,0,0,0,,Дудл энергиясы? (Қысқаша) Иә
Dialogue: 0,0:57:53.62,0:57:57.62,Default,,0,0,0,,Ол еркіндік сезімінен туындайды.
Dialogue: 0,0:57:57.62,0:58:03.56,Default,,0,0,0,,Сол сезім дүлд еліндегі ең құнды нәрсе.
Dialogue: 0,0:58:03.56,0:58:05.56,Default,,0,0,0,,Хмм…
Dialogue: 0,0:58:05.56,0:58:08.57,Default,,0,0,0,,Ахахха аха
Dialogue: 0,0:58:08.57,0:58:11.57,Default,,0,0,0,,Құнды...
Dialogue: 0,0:58:11.57,0:58:13.57,Default,,0,0,0,,Қалпақшы!
Dialogue: 0,0:58:13.57,0:58:15.57,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:58:15.57,0:58:18.58,Default,,0,0,0,,Біз мұны жасадық! (Солдат) Мені кешіріңізші!
Dialogue: 0,0:58:18.58,0:58:20.58,Default,,0,0,0,,Бо! (Жоқ) Уау!
Dialogue: 0,0:58:20.58,0:58:22.58,Default,,0,0,0,,Оля Оля Оля Оля!
Dialogue: 0,0:58:22.58,0:58:24.58,Default,,0,0,0,,Уф, сасық! (Солдат) Эй
Dialogue: 0,0:58:24.58,0:58:27.58,Default,,0,0,0,,Уф, сасық! Устрица, устрица, устрица!
Dialogue: 0,0:58:27.58,0:58:30.59,Default,,0,0,0,,Уау! Көмектесіңіздер!
Dialogue: 0,0:58:30.59,0:58:33.59,Default,,0,0,0,,Көмектесіңіз! Көмектесіңіздер! Көмектесіңіздер!
Dialogue: 0,0:58:33.59,0:58:35.59,Default,,0,0,0,,Көмектесіңіз! (Еркек) Мен құтқарылдым.
Dialogue: 0,0:58:35.59,0:58:37.59,Default,,0,0,0,,Сіз! (Еркек) Аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,0:58:37.59,0:58:39.60,Default,,0,0,0,,Рахмет сізге Шинносуке-кун
Dialogue: 0,0:58:39.60,0:58:42.60,Default,,0,0,0,,Рахмет! (Ер) Бұл маған шынымен көмектесті.
Dialogue: 0,0:58:42.60,0:58:45.60,Default,,0,0,0,,Сіз батырсыз ба? (Мектеп оқушысы) Керемет!
Dialogue: 0,0:58:45.60,0:58:48.61,Default,,0,0,0,,Бұл кішкентай, бірақ тамаша. Жоқ, онша емес.
Dialogue: 0,0:58:48.61,0:58:52.61,Default,,0,0,0,,Енді қандай да бір жолмен алғысымды білдіруге рұқсат етіңіздер.
Dialogue: 0,0:58:52.61,0:58:54.61,Default,,0,0,0,,Шошқа... сөйлеп тұр.
Dialogue: 0,0:58:54.61,0:58:56.61,Default,,0,0,0,,Шошқа кім! (Мектеп оқушысы) Уау!
Dialogue: 0,0:58:56.61,0:58:58.62,Default,,0,0,0,,Анашым! (Мама Казама) Тоору-чан!
Dialogue: 0,0:58:58.62,0:59:02.55,Default,,0,0,0,,Уууу... (Қазама) Мама~!
Dialogue: 0,0:59:02.55,0:59:04.55,Default,,0,0,0,,Ахахха (юм) Шинносуке!
Dialogue: 0,0:59:04.55,0:59:07.56,Default,,0,0,0,,О? Не болды?
Dialogue: 0,0:59:07.56,0:59:10.56,Default,,0,0,0,,Мен анам жатқан әжемнің үйіне барғым келеді.
Dialogue: 0,0:59:10.56,0:59:13.56,Default,,0,0,0,,Егер солай болса, мен де сенімен бірге барамын.
Dialogue: 0,0:59:13.56,0:59:15.57,Default,,0,0,0,,Жоқ, бірақ... (Казама Мама) Эй Шин Чан
Dialogue: 0,0:59:15.57,0:59:17.57,Default,,0,0,0,,Сато Коконокадодағы қала тұрғындары
Dialogue: 0,0:59:17.57,0:59:19.57,Default,,0,0,0,,Бұл қақпанға түскендей.
Dialogue: 0,0:59:19.57,0:59:21.57,Default,,0,0,0,,Маған барып көмектесіңізші.
Dialogue: 0,0:59:21.57,0:59:24.57,Default,,0,0,0,,Шин Чанның анасы да сонда болуы мүмкін.
Dialogue: 0,0:59:24.57,0:59:26.58,Default,,0,0,0,,Анашым...
Dialogue: 0,0:59:26.58,0:59:28.58,Default,,0,0,0,,Мен мүлдем ұмытып кеттім
Dialogue: 0,0:59:28.58,0:59:30.58,Default,,0,0,0,,Олай десеңіз, дұрыс айтасыз!
Dialogue: 0,0:59:30.58,0:59:33.58,Default,,0,0,0,,Дұрыс, сені сүйемін
Dialogue: 0,0:59:33.58,0:59:38.59,Default,,0,0,0,,… ()～
Dialogue: 0,0:59:38.59,0:59:40.59,Default,,0,0,0,,Шинобу-чан!
Dialogue: 0,0:59:40.59,0:59:44.59,Default,,0,0,0,,Нанако Они-сан! Ха ха...
Dialogue: 0,0:59:44.59,0:59:47.60,Default,,0,0,0,,Нанако Они-сан! Ааа!
Dialogue: 0,0:59:47.60,0:59:50.60,Default,,0,0,0,,Нанако... жоқ
Dialogue: 0,0:59:50.60,0:59:52.60,Default,,0,0,0,,Көмек!
Dialogue: 0,0:59:52.60,0:59:55.61,Default,,0,0,0,,Мен... құтқарылдым...
Dialogue: 0,0:59:55.61,0:59:57.61,Default,,0,0,0,,Нанако Они-сан!?
Dialogue: 0,0:59:57.61,1:00:01.61,Default,,0,0,0,,Мен Нанаконы соңғы рет вокзалдың жанында көрдім...
Dialogue: 0,1:00:01.61,1:00:04.61,Default,,0,0,0,,Менің ойымша, бұл Сато Коконокадоның орны болды.
Dialogue: 0,1:00:04.61,1:00:06.62,Default,,0,0,0,,Сато Коконокадо! (Кадзама/Кадзама Mama) Уау...
Dialogue: 0,1:00:06.62,1:00:08.62,Default,,0,0,0,,Хмм! (Қысқаша) Юума-сан!
Dialogue: 0,1:00:08.62,1:00:10.62,Default,,0,0,0,,Жалғыз әрекет ету жаман
Dialogue: 0,1:00:10.62,1:00:13.62,Default,,0,0,0,,Жаудың қайда екенін білмейсің бе?
Dialogue: 0,1:00:13.62,1:00:15.63,Default,,0,0,0,,Мен анамды жақсы көремін...
Dialogue: 0,1:00:15.63,1:00:20.63,Default,,0,0,0,,Қазір күш біріктіретін уақыт. Бәріміз бірге күресейік.
Dialogue: 0,1:00:20.63,1:00:23.63,Default,,0,0,0,,Барғың келсе, бар.
Dialogue: 0,1:00:23.63,1:00:26.63,Default,,0,0,0,,Иә! (Қысқаша) Ах!
Dialogue: 0,1:00:28.64,1:00:30.64,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:00:30.64,1:00:32.64,Default,,0,0,0,,) Батыр пайда болды!?
Dialogue: 0,1:00:32.64,1:00:35.65,Default,,0,0,0,,Oekaki SUN - бұл үлкен сәтсіздік!
Dialogue: 0,1:00:35.65,1:00:38.65,Default,,0,0,0,,Батыр Касукабе халқын азат етуге кіріседі.
Dialogue: 0,1:00:38.65,1:00:41.65,Default,,0,0,0,,Эх! Бұл ақылсыз. Бұл туралы не істеуіміз керек?
Dialogue: 0,1:00:41.65,1:00:45.66,Default,,0,0,0,,А... Бұл жақсы жаңалық емес пе?
Dialogue: 0,1:00:45.66,1:00:49.66,Default,,0,0,0,,Ғажайып қарындаш арғы жақтан келді.
Dialogue: 0,1:00:49.66,1:00:52.66,Default,,0,0,0,,Не айтып тұрсың! Осы қарқынмен мен жүзіп кетуім мүмкін ...
Dialogue: 0,1:00:52.66,1:00:54.66,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,1:00:54.66,1:00:56.67,Default,,0,0,0,,) Бітті!
Dialogue: 0,1:00:56.67,1:00:59.67,Default,,0,0,0,,Мен де жерге түсейін.
Dialogue: 0,1:01:02.61,1:01:04.61,Default,,0,0,0,,Ханшайым, сен де жерге түс
Dialogue: 0,1:01:04.61,1:01:06.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:09.61,1:01:12.62,Default,,0,0,0,,Иә! Мм... (Сот суретшісі) Патшалық қазірдің өзінде келді.
Dialogue: 0,1:01:12.62,1:01:15.62,Default,,0,0,0,,Суда тұру да қиындап барады.
Dialogue: 0,1:01:15.62,1:01:18.62,Default,,0,0,0,,Әзірше қашып кет, ханшайым.
Dialogue: 0,1:01:18.62,1:01:20.62,Default,,0,0,0,,Бірақ... (Сот суретшісі) Батыр болуы керек
Dialogue: 0,1:01:20.62,1:01:22.63,Default,,0,0,0,,Мен бұл туралы бірдеңе істеймін.
Dialogue: 0,1:01:22.63,1:01:25.63,Default,,0,0,0,,Ханшайым, тез қашып кет!
Dialogue: 0,1:01:25.63,1:01:27.63,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,1:01:27.63,1:01:30.63,Default,,0,0,0,,Ха! (Барлығы) Ах...
Dialogue: 0,1:01:30.63,1:01:32.64,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:32.64,1:01:37.64,Default,,0,0,0,,Сато Коконокадоның көптеген жаулары болады деп күтілуде.
Dialogue: 0,1:01:37.64,1:01:40.64,Default,,0,0,0,,Бірақ ғажайып қарындаштар аз ғана қалды.
Dialogue: 0,1:01:40.64,1:01:43.65,Default,,0,0,0,,Бетпе-бет зарядтау абайсыз ба...
Dialogue: 0,1:01:43.65,1:01:46.65,Default,,0,0,0,,Иә, біз кепілге алынғандарға ештеңе болғанын қаламаймыз.
Dialogue: 0,1:01:46.65,1:01:49.65,Default,,0,0,0,,Барлығымыз бортқа мінсек, бәріміз жақсы боламыз!
Dialogue: 0,1:01:49.65,1:01:53.66,Default,,0,0,0,,Е! (Казама) Шинносуке, не істеуіміз керек?
Dialogue: 0,1:01:53.66,1:01:56.66,Default,,0,0,0,,Хмм...
Dialogue: 0,1:01:56.66,1:01:58.66,Default,,0,0,0,,Ннн…
Dialogue: 0,1:01:58.66,1:02:00.66,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:00.66,1:02:02.60,Default,,0,0,0,,(асқазан дыбыстары)
Dialogue: 0,1:02:02.60,1:02:05.60,Default,,0,0,0,,Алдымен мен ваннаға барғым келеді.
Dialogue: 0,1:02:05.60,1:02:07.60,Default,,0,0,0,,Ах... (Қысқаша) Иә?
Dialogue: 0,1:02:07.60,1:02:10.61,Default,,0,0,0,,Міне, солай!
Dialogue: 0,1:02:10.61,1:02:13.61,Default,,0,0,0,,()
Dialogue: 0,1:02:13.61,1:02:15.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:17.61,1:02:20.62,Default,,0,0,0,,Ун ун ун ун ун ун ун...
Dialogue: 0,1:02:20.62,1:02:22.62,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:22.62,1:02:24.62,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,1:02:26.62,1:02:29.63,Default,,0,0,0,,Жаудың алдыңғы кіреберісте шабуылы! Жау алдыңғы кіреберісте шабуыл жасайды!
Dialogue: 0,1:02:29.63,1:02:32.63,Default,,0,0,0,,Әскери тұтқындардан басқа барлық қызметкерлер, қолдау көрсетіңіздер!
Dialogue: 0,1:02:32.63,1:02:36.63,Default,,0,0,0,,Алдыңғы кіреберісте жау шабуылы! Жау алдыңғы кіреберісте шабуыл жасайды!
Dialogue: 0,1:02:36.63,1:02:39.64,Default,,0,0,0,,Әскери тұтқыннан басқа барлық қызметкерлер, қолдау көрсетіңіздер!
Dialogue: 0,1:02:39.64,1:02:41.64,Default,,0,0,0,,Жарайды, кіру!
Dialogue: 0,1:02:41.64,1:02:44.64,Default,,0,0,0,,Шпиондық фильм сияқты (бу) Кеттік!
Dialogue: 0,1:02:47.64,1:02:50.65,Default,,0,0,0,,Бұл шабуылды мүмкіндік ретінде қарастырыңыз.
Dialogue: 0,1:02:50.65,1:02:54.65,Default,,0,0,0,,Ғажайып түсті қарындашты пайдаланатын кейіпкерді тартып, оны қолға түсіріңіз.
Dialogue: 0,1:02:54.65,1:02:59.65,Default,,0,0,0,,Жақсы, батырды қолға түсір!
Dialogue: 0,1:03:02.59,1:03:04.59,Default,,0,0,0,,Бот
Dialogue: 0,1:03:04.59,1:03:07.60,Default,,0,0,0,,Әй, кім бар?
Dialogue: 0,1:03:07.60,1:03:09.60,Default,,0,0,0,,(шашыратқыштың шайқалған дыбысы)
Dialogue: 0,1:03:14.60,1:03:19.61,Default,,0,0,0,,Уау! (Жоқ) Вааа!
Dialogue: 0,1:03:19.61,1:03:21.61,Default,,0,0,0,,Бо~ Сәлем!
Dialogue: 0,1:03:21.61,1:03:25.62,Default,,0,0,0,,Шин Чанды нысанаға алып жатыр. Мен оған жол бермеймін!
Dialogue: 0,1:03:25.62,1:03:27.62,Default,,0,0,0,,Уау! Ооо
Dialogue: 0,1:03:27.62,1:03:30.62,Default,,0,0,0,,Мм... Бұл не?
Dialogue: 0,1:03:30.62,1:03:32.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:32.62,1:03:34.62,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:03:34.62,1:03:36.63,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:03:36.63,1:03:38.63,Default,,0,0,0,,Ол… қауіпті болар ма?
Dialogue: 0,1:03:38.63,1:03:41.63,Default,,0,0,0,,Уау! Масао-кун!
Dialogue: 0,1:03:41.63,1:03:44.63,Default,,0,0,0,,Уау! (су мылтығының ату дыбысы)
Dialogue: 0,1:03:48.64,1:03:50.64,Default,,0,0,0,,Ех!
Dialogue: 0,1:03:53.64,1:03:57.65,Default,,0,0,0,,Иә! Казама-кун, бұл ұры.
Dialogue: 0,1:03:57.65,1:03:59.65,Default,,0,0,0,,Ақша болса, мен төлеймін!
Dialogue: 0,1:04:02.59,1:04:06.59,Default,,0,0,0,,Не... не? Тая?
Dialogue: 0,1:04:06.59,1:04:08.59,Default,,0,0,0,,Ана әже!
Dialogue: 0,1:04:10.59,1:04:13.60,Default,,0,0,0,,Ана әже!
Dialogue: 0,1:04:13.60,1:04:17.60,Default,,0,0,0,,Анашым! Ах...
Dialogue: 0,1:04:17.60,1:04:20.60,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:04:20.60,1:04:22.60,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:30.61,1:04:33.62,Default,,0,0,0,,Ах, аа...
Dialogue: 0,1:04:33.62,1:04:35.62,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:04:35.62,1:04:38.62,Default,,0,0,0,,О, балалар! Эй! (Унчи) Ум!
Dialogue: 0,1:04:38.62,1:04:41.62,Default,,0,0,0,,()
Dialogue: 0,1:04:41.62,1:04:45.63,Default,,0,0,0,,Әке! Кук... нннн...
Dialogue: 0,1:04:45.63,1:04:47.63,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:04:47.63,1:04:49.63,Default,,0,0,0,,Тая? (Роликті солдат) Бұл бала
Dialogue: 0,1:04:49.63,1:04:52.64,Default,,0,0,0,,Не болады?
Dialogue: 0,1:04:52.64,1:04:55.64,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,1:04:55.64,1:04:58.64,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:58.64,1:05:00.64,Default,,0,0,0,,Қайтадан тыңдаңыз
Dialogue: 0,1:05:00.64,1:05:03.58,Default,,0,0,0,,Бұл балаға не болатыны маған бәрібір... Дұрыс!
Dialogue: 0,1:05:03.58,1:05:05.58,Default,,0,0,0,,Сізге бұл баланың не болғаны қызықты ма?
Dialogue: 0,1:05:05.58,1:05:08.58,Default,,0,0,0,,Жолдан кет! Су мылтығымен атуға болмайды!
Dialogue: 0,1:05:08.58,1:05:11.59,Default,,0,0,0,,Күнбағыс~! Кук... Хмф
Dialogue: 0,1:05:11.59,1:05:13.59,Default,,0,0,0,,О...
Dialogue: 0,1:05:13.59,1:05:16.59,Default,,0,0,0,,Иә! Йойшо
Dialogue: 0,1:05:16.59,1:05:18.59,Default,,0,0,0,,Күнбағыс~!
Dialogue: 0,1:05:18.59,1:05:21.60,Default,,0,0,0,,Анна аа! Гуго!
Dialogue: 0,1:05:21.60,1:05:25.60,Default,,0,0,0,,Дея! Ннннн
Dialogue: 0,1:05:25.60,1:05:28.60,Default,,0,0,0,,Сасық! Тая~
Dialogue: 0,1:05:28.60,1:05:31.60,Default,,0,0,0,,Күнбағыс! Өте ыстық…
Dialogue: 0,1:05:33.61,1:05:35.61,Default,,0,0,0,,Мен батырмын!
Dialogue: 0,1:05:37.61,1:05:39.62,Default,,0,0,0,,Хэхехехе (Широ) Энн!
Dialogue: 0,1:05:39.62,1:05:41.62,Default,,0,0,0,,Жоспармен бірдей.
Dialogue: 0,1:05:41.62,1:05:43.62,Default,,0,0,0,,Сен маған опасыздық жасадың!
Dialogue: 0,1:05:43.62,1:05:45.62,Default,,0,0,0,,Бұл стратегияның бір бөлігі!
Dialogue: 0,1:05:45.62,1:05:47.62,Default,,0,0,0,,Кәне, барлығынан көмек алыңыз.
Dialogue: 0,1:05:47.62,1:05:49.63,Default,,0,0,0,,Сіз ештеңе істеген жоқсыз, солай ма?
Dialogue: 0,1:05:49.63,1:05:51.63,Default,,0,0,0,,Иә, бұл сізге қажет емес!
Dialogue: 0,1:05:51.63,1:05:54.63,Default,,0,0,0,,Касукабеге келсең көмек аласың деп кім айтты?
Dialogue: 0,1:05:54.63,1:05:56.63,Default,,0,0,0,,Бұл сенсің! (Қысқаша) Маған көмектессеңіз
Dialogue: 0,1:05:56.63,1:05:58.63,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,1:05:58.63,1:06:02.57,Default,,0,0,0,,Шинносуке Мына жігіт осылай деді, солай ма? Менің көмегім үшін төлеймін дедіңіз!?
Dialogue: 0,1:06:02.57,1:06:06.58,Default,,0,0,0,,Шин-чан... Шин-чан! Шин Чан...
Dialogue: 0,1:06:06.58,1:06:09.58,Default,,0,0,0,,Анашым! Шинносуке!
Dialogue: 0,1:06:09.58,1:06:13.58,Default,,0,0,0,,Бейшара қыз... онсыз да жалпақ кеудесі жалпақ болып кеткен...
Dialogue: 0,1:06:13.58,1:06:16.59,Default,,0,0,0,,Джакаашии! О? Ооо
Dialogue: 0,1:06:16.59,1:06:19.59,Default,,0,0,0,,Сәлем~
Dialogue: 0,1:06:19.59,1:06:23.59,Default,,0,0,0,,Көмектесіңіз! Крутто
Dialogue: 0,1:06:23.59,1:06:25.60,Default,,0,0,0,,Ахх, Шинносуке! Анашым!
Dialogue: 0,1:06:25.60,1:06:28.60,Default,,0,0,0,,Энн Энн! Энн! Хахаха
Dialogue: 0,1:06:28.60,1:06:32.60,Default,,0,0,0,,Жақсы болды ма? Сіз жарақат алдыңыз ба? Мен көптен бері уайымдап жүрмін
Dialogue: 0,1:06:32.60,1:06:35.61,Default,,0,0,0,,Ухихи…
Dialogue: 0,1:06:35.61,1:06:38.61,Default,,0,0,0,,Жақсы ма? Жау жағына кетсем де
Dialogue: 0,1:06:38.61,1:06:40.61,Default,,0,0,0,,Сіз әрқашан сонда барасыз, солай ма?
Dialogue: 0,1:06:40.61,1:06:42.61,Default,,0,0,0,,Бұл шынымен де жақсы ма?
Dialogue: 0,1:06:42.61,1:06:46.62,Default,,0,0,0,,Ах... Нанако-оне-сан ше? Ол бұл қабатта жоқ сияқты.
Dialogue: 0,1:06:46.62,1:06:50.62,Default,,0,0,0,,Біз де жоғарғы қабатқа барайық!
Dialogue: 0,1:06:50.62,1:06:55.63,Default,,0,0,0,,Хм... Ей, бұл шынымен жақсы!?
Dialogue: 0,1:06:55.63,1:06:58.63,Default,,0,0,0,,Мен шынымен барамын!
Dialogue: 0,1:06:58.63,1:07:03.57,Default,,0,0,0,,N... Nnn...
Dialogue: 0,1:07:03.57,1:07:05.57,Default,,0,0,0,,Әй?
Dialogue: 0,1:07:12.58,1:07:17.58,Default,,0,0,0,,Додлдар елінде ең құндысы
Dialogue: 0,1:07:17.58,1:07:20.58,Default,,0,0,0,,Сызықша! (Қысқаша) Бурибури-сан!
Dialogue: 0,1:07:20.58,1:07:22.59,Default,,0,0,0,,Сіз мұны істей алмайсыз!
Dialogue: 0,1:07:22.59,1:07:24.59,Default,,0,0,0,,Бурибурисан!
Dialogue: 0,1:07:24.59,1:07:26.59,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,1:07:26.59,1:07:31.59,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,1:07:31.59,1:07:33.59,Default,,0,0,0,,Уф…
Dialogue: 0,1:07:35.60,1:07:39.60,Default,,0,0,0,,Алға, дудл жасаңыз! (Балалар) Хи!
Dialogue: 0,1:07:39.60,1:07:41.60,Default,,0,0,0,,Кешіріңіз, екінші қабат бақылауда!
Dialogue: 0,1:07:41.60,1:07:43.61,Default,,0,0,0,,Хех хех хех. Пфу.
Dialogue: 0,1:07:43.61,1:07:45.61,Default,,0,0,0,,Сіз керемет біреуді тыңдайсыз ба?
Dialogue: 0,1:07:45.61,1:07:47.61,Default,,0,0,0,,Керемет біреу
Dialogue: 0,1:07:47.61,1:07:50.61,Default,,0,0,0,,Сізге ғажайып қарындаш керек емес пе?
Dialogue: 0,1:07:50.61,1:07:53.62,Default,,0,0,0,,Сізге ғажайып қарындаш керек емес пе?
Dialogue: 0,1:07:53.62,1:07:56.62,Default,,0,0,0,,Нанако, қымбаттым!
Dialogue: 0,1:07:56.62,1:08:01.56,Default,,0,0,0,,Егер сіз қарындаш алғыңыз келсе
Dialogue: 0,1:08:01.56,1:08:04.56,Default,,0,0,0,,Касукабе ауруханасына келіңіз. Бұл Касукабе ауруханасы.
Dialogue: 0,1:08:04.56,1:08:07.56,Default,,0,0,0,,Дорья!
Dialogue: 0,1:08:07.56,1:08:09.57,Default,,0,0,0,,Уф…!
Dialogue: 0,1:08:09.57,1:08:12.57,Default,,0,0,0,,Сіз кейіпкерді білесіз бе?
Dialogue: 0,1:08:12.57,1:08:14.57,Default,,0,0,0,,Біз осы уақытқа дейін бірге болдық.
Dialogue: 0,1:08:14.57,1:08:16.57,Default,,0,0,0,,Енді мені өзіңізбен бірге алып кетіңізші.
Dialogue: 0,1:08:16.57,1:08:19.58,Default,,0,0,0,,Ғажайып қарындашты батырға
Dialogue: 0,1:08:19.58,1:08:22.58,Default,,0,0,0,,Кешіріңіз, мен қазір анамды іздеп жүрмін.
Dialogue: 0,1:08:22.58,1:08:25.58,Default,,0,0,0,,Ракугакинг бөгетін сол адам ғана құтқара алады!
Dialogue: 0,1:08:25.58,1:08:28.58,Default,,0,0,0,,Иә, иә, кейінірек.
Dialogue: 0,1:08:28.58,1:08:32.59,Default,,0,0,0,,Мені батырға апарыңызшы!
Dialogue: 0,1:08:32.59,1:08:35.59,Default,,0,0,0,,(ﾕｳﾏ)～
Dialogue: 0,1:08:35.59,1:08:38.59,Default,,0,0,0,,Иә? (Юманың анасы) Біреу маған көмектесіңізші~
Dialogue: 0,1:08:38.59,1:08:41.60,Default,,0,0,0,,Анашым! (Юманың анасы) Юума!
Dialogue: 0,1:08:41.60,1:08:44.60,Default,,0,0,0,,Уау! Мен сені жақсы көремін Юма!
Dialogue: 0,1:08:44.60,1:08:46.60,Default,,0,0,0,,Бірақ бұл мүмкін емес, өйткені Юума
Dialogue: 0,1:08:46.60,1:08:48.60,Default,,0,0,0,,Сіз Касукабеде болуыңыз мүмкін емес.
Dialogue: 0,1:08:48.60,1:08:50.61,Default,,0,0,0,,Ол бала небәрі 6 жаста. Бұл иллюзия.
Dialogue: 0,1:08:50.61,1:08:53.61,Default,,0,0,0,,Менің өмірім осылай аяқталады!
Dialogue: 0,1:08:53.61,1:08:55.61,Default,,0,0,0,,Бітті... (Юм) Мықтап ұстаңыз.
Dialogue: 0,1:08:55.61,1:08:57.61,Default,,0,0,0,,Бұл шынымен Юума ма?
Dialogue: 0,1:08:57.61,1:09:01.55,Default,,0,0,0,,Ха! Tsk...кеш болды
Dialogue: 0,1:09:01.55,1:09:03.55,Default,,0,0,0,,Бұл! (Им) Не?
Dialogue: 0,1:09:03.55,1:09:05.56,Default,,0,0,0,,Онда біртүрлі шошқа бар... (Юм) Иә?
Dialogue: 0,1:09:05.56,1:09:07.56,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,1:09:07.56,1:09:11.56,Default,,0,0,0,,Ой... Юума (Юма), тым кеш Эй, көмектесші!
Dialogue: 0,1:09:11.56,1:09:14.56,Default,,0,0,0,,Менің анам табылды, бірақ ол айқышқа шегеленді.
Dialogue: 0,1:09:14.56,1:09:17.57,Default,,0,0,0,,Егер менде сол қарындаш болса, оны саған берер едім.
Dialogue: 0,1:09:17.57,1:09:24.57,Default,,0,0,0,,Ах... қарындаштар... иә...
Dialogue: 0,1:09:24.57,1:09:27.58,Default,,0,0,0,,Шинносуке, мені әкеліңізші...
Dialogue: 0,1:09:27.58,1:09:29.58,Default,,0,0,0,,Өтінемін, маған қарындаш керек.
Dialogue: 0,1:09:29.58,1:09:33.58,Default,,0,0,0,,А... у... (ханшайым) Мені де сонда апарыңыз.
Dialogue: 0,1:09:33.58,1:09:36.59,Default,,0,0,0,,Иә? Ол кім? Сіз
Dialogue: 0,1:09:36.59,1:09:39.59,Default,,0,0,0,,Сол қарындаш менде болса ғой... Ах...
Dialogue: 0,1:09:39.59,1:09:41.59,Default,,0,0,0,,() (３)!?
Dialogue: 0,1:09:41.59,1:09:44.59,Default,,0,0,0,,Жасыру! (Құмырсқалар жылайды)
Dialogue: 0,1:09:44.59,1:09:47.60,Default,,0,0,0,,Ха-ха...
Dialogue: 0,1:09:47.60,1:09:58.61,Default,,0,0,0,,♪
Dialogue: 0,1:09:58.61,1:10:01.61,Default,,0,0,0,,Сіз ғажайып қарындашты әкелдіңіз бе?
Dialogue: 0,1:10:01.61,1:10:03.61,Default,,0,0,0,,Е! Ах...
Dialogue: 0,1:10:03.61,1:10:05.62,Default,,0,0,0,,Хмм, не айтайын...
Dialogue: 0,1:10:05.62,1:10:08.62,Default,,0,0,0,,Бізге ештеңе қалмады
Dialogue: 0,1:10:08.62,1:10:11.62,Default,,0,0,0,,Сондықтан мен жақсырақ болуы мүмкін емес шарттарды ойлап таптым.
Dialogue: 0,1:10:11.62,1:10:16.63,Default,,0,0,0,,Егер сіз маған қарындашты берсеңіз, мен сізге патша ретінде келесі лауазымға уәде беремін.
Dialogue: 0,1:10:16.63,1:10:19.63,Default,,0,0,0,,Корольден кейін... (Қорғаныс министрі) №2.
Dialogue: 0,1:10:19.63,1:10:21.63,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:10:21.63,1:10:25.64,Default,,0,0,0,,Ғажайып қарындаштар біз үшін өте құнды.
Dialogue: 0,1:10:25.64,1:10:27.64,Default,,0,0,0,,Ха! Кеттік... Нх!
Dialogue: 0,1:10:27.64,1:10:30.64,Default,,0,0,0,,№2…
Dialogue: 0,1:10:30.64,1:10:34.64,Default,,0,0,0,,Иә, бәрі сіздің қалауыңыз бойынша болады.
Dialogue: 0,1:10:37.65,1:10:40.65,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:10:40.65,1:10:44.65,Default,,0,0,0,,Енді оны маған беріңіз.
Dialogue: 0,1:10:51.66,1:10:54.66,Default,,0,0,0,,Ум...
Dialogue: 0,1:10:54.66,1:10:56.67,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,1:10:56.67,1:11:00.67,Default,,0,0,0,,Менің ішім кенет ауырып кетті! (2 адам) Иә?
Dialogue: 0,1:11:00.67,1:11:02.61,Default,,0,0,0,,Бұл сәл үлкен.
Dialogue: 0,1:11:02.61,1:11:04.61,Default,,0,0,0,,Бұл уақытты талап етеді (Қорғаныс министрі/Сержант Демон) Ух...
Dialogue: 0,1:11:04.61,1:11:07.61,Default,,0,0,0,,Сіз мұны сыртта жасауды жоспарлап отырсыз ба!? (Жын сержанты) Есегіңді дұрыстап сүрт!
Dialogue: 0,1:11:07.61,1:11:11.61,Default,,0,0,0,,Иә! Ааа чибиру~!
Dialogue: 0,1:11:11.61,1:11:13.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:13.62,1:11:16.62,Default,,0,0,0,,Менің ойымша, мұндай жерде бұл мүмкін емес.
Dialogue: 0,1:11:16.62,1:11:20.62,Default,,0,0,0,,Тартыңыз! Мен жуынатын бөлмеге барамын, сәл күте тұрыңыз.
Dialogue: 0,1:11:20.62,1:11:23.63,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:11:23.63,1:11:26.63,Default,,0,0,0,,Күте тұрыңыз, шошқа!
Dialogue: 0,1:11:31.63,1:11:35.63,Default,,0,0,0,,Бұл... Шынымен, ғажайып қарындаш па?
Dialogue: 0,1:11:38.64,1:11:41.64,Default,,0,0,0,,Вааа (ханшайым) Анаңа көмектесейік.
Dialogue: 0,1:11:41.64,1:11:52.66,Default,,0,0,0,,♪
Dialogue: 0,1:11:52.66,1:11:55.66,Default,,0,0,0,,Уау! (Юманың анасы) А...
Dialogue: 0,1:11:55.66,1:11:57.66,Default,,0,0,0,,Анашым! (Юманың анасы) Юума!
Dialogue: 0,1:11:57.66,1:12:01.60,Default,,0,0,0,,Анашым! (Ханшайым) Хехе
Dialogue: 0,1:12:01.60,1:12:03.60,Default,,0,0,0,,Рахмет (ханшайым) хехе
Dialogue: 0,1:12:03.60,1:12:08.60,Default,,0,0,0,,Бірақ неге Miracle Crayon қолдануға болады?
Dialogue: 0,1:12:08.60,1:12:12.61,Default,,0,0,0,,Сіз де батырсыз ба? (Ханшайым) Ой-оу.
Dialogue: 0,1:12:12.61,1:12:14.61,Default,,0,0,0,,Бұл таңдалған кейіпкер.
Dialogue: 0,1:12:14.61,1:12:17.61,Default,,0,0,0,,Бұл Ракуга патшалығының корольдік отбасы ғана сала алатын қарындаш.
Dialogue: 0,1:12:17.61,1:12:20.62,Default,,0,0,0,,… ()
Dialogue: 0,1:12:20.62,1:12:23.62,Default,,0,0,0,,Менің елім...
Dialogue: 0,1:12:23.62,1:12:25.62,Default,,0,0,0,,Не?
Dialogue: 0,1:12:25.62,1:12:29.63,Default,,0,0,0,,Әй, мені батырға апар.
Dialogue: 0,1:12:29.63,1:12:31.63,Default,,0,0,0,,Ааааааааааааа
Dialogue: 0,1:12:31.63,1:12:34.63,Default,,0,0,0,,Түкір! Ғажайып қарындаш қайда?
Dialogue: 0,1:12:34.63,1:12:38.63,Default,,0,0,0,,Жоқ! (Жын сержанты) Өтірік айтпа, түкір!
Dialogue: 0,1:12:38.63,1:12:40.64,Default,,0,0,0,,Бұл рас!
Dialogue: 0,1:12:40.64,1:12:45.64,Default,,0,0,0,,Қарындаштар жоқ...
Dialogue: 0,1:12:45.64,1:12:47.64,Default,,0,0,0,,Какки 4-тен Какки 1-ге дейін
Dialogue: 0,1:12:47.64,1:12:51.65,Default,,0,0,0,,Какки 4-тен Какки 1-ге дейін Коконокадоға оралыңыз.
Dialogue: 0,1:12:51.65,1:12:55.65,Default,,0,0,0,,Біз шыдай алмаймыз! (Жын сержанты) Мына жігітті жайына қалдыр.
Dialogue: 0,1:12:55.65,1:12:57.65,Default,,0,0,0,,Коконокадо дегенге қайта келу
Dialogue: 0,1:12:57.65,1:13:02.59,Default,,0,0,0,,Сәлем! Мен оны артқа қалдырдым! Эй!
Dialogue: 0,1:13:02.59,1:13:06.60,Default,,0,0,0,,Қайтып кел! Эй!
Dialogue: 0,1:13:06.60,1:13:09.60,Default,,0,0,0,,(Жаңбыр дыбысы)
Dialogue: 0,1:13:09.60,1:13:11.60,Default,,0,0,0,,Ха!
Dialogue: 0,1:13:14.60,1:13:16.61,Default,,0,0,0,,Ах! Ах... (йум) Не болды?
Dialogue: 0,1:13:16.61,1:13:18.61,Default,,0,0,0,,Жаңбыр жаумайды!
Dialogue: 0,1:13:18.61,1:13:21.61,Default,,0,0,0,,Қиямет! Мен кептеліп қалдым
Dialogue: 0,1:13:21.61,1:13:24.61,Default,,0,0,0,,Уф…!
Dialogue: 0,1:13:24.61,1:13:26.62,Default,,0,0,0,,Ннн!
Dialogue: 0,1:13:26.62,1:13:29.62,Default,,0,0,0,,Ах... аһ Жау кім?
Dialogue: 0,1:13:29.62,1:13:33.62,Default,,0,0,0,,Жоқ... Нанако-нисан!
Dialogue: 0,1:13:33.62,1:13:37.63,Default,,0,0,0,,Ха ха ха... Нанако-оне-сан!
Dialogue: 0,1:13:37.63,1:13:40.63,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:40.63,1:13:45.63,Default,,0,0,0,,♪(тартымды музыка)
Dialogue: 0,1:13:45.63,1:13:49.64,Default,,0,0,0,,♪～
Dialogue: 0,1:13:49.64,1:13:52.64,Default,,0,0,0,,Нанако, қымбаттым!
Dialogue: 0,1:13:59.65,1:14:03.59,Default,,0,0,0,,Күте тұрыңыз! Шинносуке-сан, күте тұрыңыз!
Dialogue: 0,1:14:03.59,1:14:06.59,Default,,0,0,0,,Қарындаштар ұрланды!
Dialogue: 0,1:14:08.59,1:14:10.59,Default,,0,0,0,,Оны тек шектеулі адамдар ғана орындай алатын сиқыр деп болжауға болады.
Dialogue: 0,1:14:10.59,1:14:13.59,Default,,0,0,0,,Нанако Они-санды қайтарыңыз!
Dialogue: 0,1:14:15.60,1:14:18.60,Default,,0,0,0,,Хехе... хехе
Dialogue: 0,1:14:18.60,1:14:21.60,Default,,0,0,0,,Ой! иә?
Dialogue: 0,1:14:25.61,1:14:28.61,Default,,0,0,0,,Хехе…
Dialogue: 0,1:14:28.61,1:14:32.62,Default,,0,0,0,,Уу… Уу…
Dialogue: 0,1:14:32.62,1:14:35.62,Default,,0,0,0,,Ууууууууууууууууууу!
Dialogue: 0,1:14:35.62,1:14:38.62,Default,,0,0,0,,Егер сіз сол камерамен суретке түссеңіз, бәрі бітті.
Dialogue: 0,1:14:41.62,1:14:45.63,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:45.63,1:14:47.63,Default,,0,0,0,,Шин-чан, мен сені жақсы көремін!
Dialogue: 0,1:14:50.63,1:14:54.64,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:54.64,1:14:57.64,Default,,0,0,0,,Хи! (Жалған Нанако) Шин-чан!
Dialogue: 0,1:14:57.64,1:14:59.64,Default,,0,0,0,,Нанако!
Dialogue: 0,1:15:06.58,1:15:08.58,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:08.58,1:15:10.59,Default,,0,0,0,,Ангия!
Dialogue: 0,1:15:10.59,1:15:13.59,Default,,0,0,0,,Иә! (Жалған Нанако) Шин-чан...
Dialogue: 0,1:15:13.59,1:15:16.59,Default,,0,0,0,,О? Ааа!
Dialogue: 0,1:15:18.59,1:15:21.60,Default,,0,0,0,,Шин-чан... Жақсы...
Dialogue: 0,1:15:21.60,1:15:23.60,Default,,0,0,0,,Иә, қарындаштар!
Dialogue: 0,1:15:23.60,1:15:25.60,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,1:15:25.60,1:15:40.62,Default,,0,0,0,,♪
Dialogue: 0,1:15:47.62,1:15:50.63,Default,,0,0,0,,Хаха...
Dialogue: 0,1:15:50.63,1:15:52.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:00.64,1:16:02.57,Default,,0,0,0,,Не... не? (Әйел) Не?
Dialogue: 0,1:16:02.57,1:16:04.57,Default,,0,0,0,,Құлып?
Dialogue: 0,1:16:04.57,1:16:07.58,Default,,0,0,0,,Мына біртүрлі жігіттерден кейінгі сарай ма...
Dialogue: 0,1:16:07.58,1:16:11.58,Default,,0,0,0,,Не болып жатыр? Ей, тезірек қашайық!
Dialogue: 0,1:16:11.58,1:16:14.58,Default,,0,0,0,,О, эй, Шинносуке, өзіңді ұста!
Dialogue: 0,1:16:16.59,1:16:18.59,Default,,0,0,0,,Мен батырмын... (Еркек) Ей, сен!
Dialogue: 0,1:16:18.59,1:16:22.59,Default,,0,0,0,,Бізді құтқарған қарындашпен зымыранды сал!
Dialogue: 0,1:16:22.59,1:16:24.59,Default,,0,0,0,,Бізге ұшақтармен қарсы тұру керек!
Dialogue: 0,1:16:24.59,1:16:27.60,Default,,0,0,0,,Тез күресуге арналған құралдар!
Dialogue: 0,1:16:27.60,1:16:31.60,Default,,0,0,0,,Мен қарындашымды жоғалтып алдым.
Dialogue: 0,1:16:31.60,1:16:33.60,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,1:16:33.60,1:16:35.60,Default,,0,0,0,,Сонда сіз төбелесе алмайсыз!
Dialogue: 0,1:16:35.60,1:16:38.61,Default,,0,0,0,,Бітті! Ахх...
Dialogue: 0,1:16:38.61,1:16:40.61,Default,,0,0,0,,Мен қорқамын, мама!
Dialogue: 0,1:16:42.61,1:16:45.61,Default,,0,0,0,,Қалай болғанда да, аз ғана қарындаштар қалды!
Dialogue: 0,1:16:45.61,1:16:47.62,Default,,0,0,0,,Бұл не, балалар!
Dialogue: 0,1:16:47.62,1:16:50.62,Default,,0,0,0,,Менің балам не істеді? (Еркек) Креонды жоғалтып алдыңыз, солай ма?
Dialogue: 0,1:16:50.62,1:16:53.62,Default,,0,0,0,,Ата-анаң не істеп жатыр? (Еркек) Тым бос.
Dialogue: 0,1:16:53.62,1:16:57.63,Default,,0,0,0,,Е... сәл күте тұрыңыз, менде ұрысқа арналған құрал жоқ.
Dialogue: 0,1:16:57.63,1:17:00.63,Default,,0,0,0,,Мен оны сала алмадым! (Еркек) Сонда біз не істейміз?
Dialogue: 0,1:17:00.63,1:17:03.57,Default,,0,0,0,,Неліктен оны жоғалттың? (Ер) Егер бұл жаудың шабуылы болса.
Dialogue: 0,1:17:03.57,1:17:05.57,Default,,0,0,0,,Мен не істеуім керек? Шулы!
Dialogue: 0,1:17:05.57,1:17:07.57,Default,,0,0,0,,Балалар сендер балаларға сенбейсіңдер!
Dialogue: 0,1:17:07.57,1:17:11.57,Default,,0,0,0,,Өзіңіз бірдеңе жасаңыз!
Dialogue: 0,1:17:11.57,1:17:16.58,Default,,0,0,0,,(Күнбағыс жылайды)
Dialogue: 0,1:17:16.58,1:17:19.58,Default,,0,0,0,,Шинносуке О? Ооо
Dialogue: 0,1:17:19.58,1:17:22.58,Default,,0,0,0,,Бұл адам батыр ма? (Иә) Иә
Dialogue: 0,1:17:22.58,1:17:24.59,Default,,0,0,0,,Маған күш-қуатыңызды беріңізші!
Dialogue: 0,1:17:24.59,1:17:28.59,Default,,0,0,0,,Егер бәрі дудл жасаса, ел өзінің қалыпты жағдайына оралуы мүмкін.
Dialogue: 0,1:17:28.59,1:17:32.59,Default,,0,0,0,,Бірақ, мен қарындашымды жоғалтып алдым...
Dialogue: 0,1:17:32.59,1:17:35.60,Default,,0,0,0,,Мен бұл қарындашты Бури Буриден алдым...
Dialogue: 0,1:17:35.60,1:17:38.60,Default,,0,0,0,,Бури Бури мырза? (Әйел) Бұл шошқа кінәлі ме?
Dialogue: 0,1:17:38.60,1:17:42.60,Default,,0,0,0,,Жоқ, мен кінәлі емеспін... (Ер) Бірақ қазір...
Dialogue: 0,1:17:42.60,1:17:45.61,Default,,0,0,0,,Сізде қарындаш бар, солай ма? (Еркек) Олай болса, қазір зымырандар!
Dialogue: 0,1:17:45.61,1:17:47.61,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:17:47.61,1:17:49.61,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,1:17:49.61,1:17:53.62,Default,,0,0,0,,Мен түсті қарындаш қолдандым... (Азаматтар) А!?
Dialogue: 0,1:17:53.62,1:17:55.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:17:55.62,1:17:58.62,Default,,0,0,0,,Барлығының ынтымақтасатын уақыты келді!
Dialogue: 0,1:17:58.62,1:18:00.62,Default,,0,0,0,,Оны не үшін пайдаландың?
Dialogue: 0,1:18:00.62,1:18:03.52,Default,,0,0,0,,Анашым, мен көмектескім келеді...
Dialogue: 0,1:18:05.56,1:18:07.56,Default,,0,0,0,,Қарындаштар кеткеннен кейін
Dialogue: 0,1:18:07.56,1:18:11.56,Default,,0,0,0,,Нанако-сан еріп кетті.
Dialogue: 0,1:18:15.57,1:18:19.58,Default,,0,0,0,,Кешіріңіз! Мен жаңа ғана ұсталдым
Dialogue: 0,1:18:19.58,1:18:21.58,Default,,0,0,0,,Ола да анама көмектесті
Dialogue: 0,1:18:21.58,1:18:25.58,Default,,0,0,0,,Юума-кун, сенің де анаңды тапқаныңа қуаныштымын.
Dialogue: 0,1:18:28.58,1:18:33.59,Default,,0,0,0,,(Жақындап келе жатқан қамалдың дыбысы)
Dialogue: 0,1:18:33.59,1:18:37.59,Default,,0,0,0,,Егер сіз дудльдер жасасаңыз, ол ел қайтадан аспанға оралуы мүмкін.
Dialogue: 0,1:18:37.59,1:18:39.60,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,1:18:39.60,1:18:41.60,Default,,0,0,0,,Өтінемін! Біраз дудл жасаңыз!
Dialogue: 0,1:18:41.60,1:18:44.60,Default,,0,0,0,,Өтінемін! (Әйел) Менің балам қазірдің өзінде
Dialogue: 0,1:18:44.60,1:18:46.60,Default,,0,0,0,,Сіз сурет салғыңыз келмейді дейсіз бе?
Dialogue: 0,1:18:46.60,1:18:50.61,Default,,0,0,0,,Осылай жалғаса берсе, ол ел суда тұра алмайды.
Dialogue: 0,1:18:50.61,1:18:53.61,Default,,0,0,0,,Суда тұра алмау туралы...
Dialogue: 0,1:18:53.61,1:18:56.61,Default,,0,0,0,,Менің ойымша, бұл жерге түседі (бәрі) Е!
Dialogue: 0,1:18:56.61,1:18:59.62,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:18:59.62,1:19:04.55,Default,,0,0,0,,Күте тұрыңыз! Егер сіз дудльдер жасасаңыз, бұл ел қалыпты жағдайға оралады!
Dialogue: 0,1:19:04.55,1:19:06.56,Default,,0,0,0,,Иә! Бәріміз бірге жұмыс жасайық
Dialogue: 0,1:19:06.56,1:19:09.56,Default,,0,0,0,,Додл жасайық! (Еркек) Мені жіберіңіз!
Dialogue: 0,1:19:09.56,1:19:13.56,Default,,0,0,0,,Шинносуке! Анашым!
Dialogue: 0,1:19:13.56,1:19:16.57,Default,,0,0,0,,Шинносуке! Әке!
Dialogue: 0,1:19:16.57,1:19:20.57,Default,,0,0,0,,Барлығың, қашпаңдар! Егер сіз дудле жасасаңыз, сол ел сонда болады!
Dialogue: 0,1:19:20.57,1:19:24.57,Default,,0,0,0,,Дудльдер беріңізші! Өтінемін... Аа!
Dialogue: 0,1:19:24.57,1:19:28.58,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,1:19:28.58,1:19:31.58,Default,,0,0,0,,Өтінемін! Менің...
Dialogue: 0,1:19:31.58,1:19:38.59,Default,,0,0,0,,Менің... Менің отбасыма және достарыма көмектес!
Dialogue: 0,1:19:38.59,1:19:41.59,Default,,0,0,0,,Уау! Мен құлап жатырмын!
Dialogue: 0,1:19:41.59,1:19:44.59,Default,,0,0,0,,Қорықпа, ағайын!
Dialogue: 0,1:19:44.59,1:19:48.60,Default,,0,0,0,,Жанымыз біткенше, Патшамен
Dialogue: 0,1:19:48.60,1:19:50.60,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:19:56.61,1:20:01.61,Default,,0,0,0,,(ｸﾗｸｼｮﾝ)
Dialogue: 0,1:20:01.61,1:20:03.61,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:20:03.61,1:20:05.61,Default,,0,0,0,,Осындай күйде тежеліп тұру аса жағымды емес
Dialogue: 0,1:20:05.61,1:20:09.62,Default,,0,0,0,,Иә! Нннн (Масао) Казама-кун, тез қашу керек!
Dialogue: 0,1:20:09.62,1:20:11.62,Default,,0,0,0,,Дұрыс айтасың, Тоору-чан! Барайық!
Dialogue: 0,1:20:11.62,1:20:15.62,Default,,0,0,0,,Не айтып тұрсың! Біз Касукабе қорғаныс күштеріміз!?
Dialogue: 0,1:20:15.62,1:20:17.63,Default,,0,0,0,,Біз сені қорғамасақ не істейсің!
Dialogue: 0,1:20:17.63,1:20:19.63,Default,,0,0,0,,Иә! (Тағзым) Бо!
Dialogue: 0,1:20:19.63,1:20:22.63,Default,,0,0,0,,Ах! (Казама) Дудльдер өтінемін!
Dialogue: 0,1:20:22.63,1:20:24.63,Default,,0,0,0,,Дудльдер беріңізші!
Dialogue: 0,1:20:24.63,1:20:28.64,Default,,0,0,0,,Дудльдер беріңізші! (Тағзым) Өтінемін!
Dialogue: 0,1:20:28.64,1:20:32.64,Default,,0,0,0,,Дудлдер жасаңыз! (Масао) Ұстаз!
Dialogue: 0,1:20:32.64,1:20:34.64,Default,,0,0,0,,Дудльдер беріңізші!
Dialogue: 0,1:20:34.64,1:20:36.65,Default,,0,0,0,,Дудльдер беріңізші!
Dialogue: 0,1:20:36.65,1:20:38.65,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:20:44.65,1:20:46.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:46.66,1:20:51.66,Default,,0,0,0,,Құлап жатырмын... Менің өлгім келмейді!
Dialogue: 0,1:20:51.66,1:20:54.66,Default,,0,0,0,,Бірге сурет салайық! (Жоқ) Бірақ бұл қорқынышты!
Dialogue: 0,1:20:54.66,1:20:58.67,Default,,0,0,0,,Дудл суретін сал!
Dialogue: 0,1:20:58.67,1:21:01.60,Default,,0,0,0,,Уау! (Жын сержанты) Ей, қашпа!
Dialogue: 0,1:21:01.60,1:21:03.61,Default,,0,0,0,,Әй, маған ғажайып қарындаш қайда екенін айт.
Dialogue: 0,1:21:03.61,1:21:06.61,Default,,0,0,0,,Әй... (Қорғаныс министрі) Сіз мұны білесіз.
Dialogue: 0,1:21:06.61,1:21:08.61,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,1:21:08.61,1:21:11.61,Default,,0,0,0,,Бұл қарындаштар жоғалып кетті!
Dialogue: 0,1:21:11.61,1:21:14.61,Default,,0,0,0,,Бала мұның бәрін қолданды!
Dialogue: 0,1:21:17.62,1:21:21.62,Default,,0,0,0,,Тез қашу керек! Хмм
Dialogue: 0,1:21:21.62,1:21:27.63,Default,,0,0,0,,Энергияны сызба жасайтын адамдарсыз өндіру мүмкін емес.
Dialogue: 0,1:21:27.63,1:21:31.63,Default,,0,0,0,,А, күте тұрыңыз! Кейбір дудлдар жасаңыз!
Dialogue: 0,1:21:31.63,1:21:34.63,Default,,0,0,0,,Шулы! Қамал құлап жатыр!
Dialogue: 0,1:21:38.64,1:21:42.64,Default,,0,0,0,,Ел... жойылады...
Dialogue: 0,1:21:42.64,1:21:45.65,Default,,0,0,0,,О! Вававава…
Dialogue: 0,1:21:45.65,1:21:48.65,Default,,0,0,0,,Ой! Хмм... қазірдің өзінде!
Dialogue: 0,1:21:48.65,1:21:51.65,Default,,0,0,0,,Бәріне де мән бермейді...
Dialogue: 0,1:21:51.65,1:21:53.66,Default,,0,0,0,,Әй, ә?
Dialogue: 0,1:21:53.66,1:21:58.66,Default,,0,0,0,,Эй!
Dialogue: 0,1:21:58.66,1:22:01.56,Default,,0,0,0,,Эй
Dialogue: 0,1:22:03.60,1:22:06.60,Default,,0,0,0,,Мен саған кешпеймін…
Dialogue: 0,1:22:06.60,1:22:18.61,Default,,0,0,0,,♪
Dialogue: 0,1:22:18.61,1:22:20.62,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:22:20.62,1:22:22.62,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,1:22:22.62,1:22:24.62,Default,,0,0,0,,Жоғалуға жақын.
Dialogue: 0,1:22:24.62,1:22:27.62,Default,,0,0,0,,Ааа, су моншасы өте жақсы~
Dialogue: 0,1:22:27.62,1:22:30.63,Default,,0,0,0,,Бури Бури Заемон да жоғалып кете ме?
Dialogue: 0,1:22:30.63,1:22:33.63,Default,,0,0,0,,Иә? Біреу жоқ па?
Dialogue: 0,1:22:33.63,1:22:36.63,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,1:22:36.63,1:22:39.63,Default,,0,0,0,,Юума-кунға қарындаш бердіңіз ғой, солай ма?
Dialogue: 0,1:22:39.63,1:22:41.64,Default,,0,0,0,,Олар, мен.
Dialogue: 0,1:22:41.64,1:22:43.64,Default,,0,0,0,,Ол мені 2-ші нөмір болуды өтінді.
Dialogue: 0,1:22:43.64,1:22:46.64,Default,,0,0,0,,Ха!? Ол 2 саны.
Dialogue: 0,1:22:46.64,1:22:50.65,Default,,0,0,0,,Біреу жалап кетсе, қиналып қалар едім.
Dialogue: 0,1:22:50.65,1:22:54.65,Default,,0,0,0,,Өйткені, ол құтқарушы батыр.
Dialogue: 0,1:22:57.65,1:23:01.59,Default,,0,0,0,,Шинносуке-сан, бәрімізге оралайық.
Dialogue: 0,1:23:01.59,1:23:03.59,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:14.60,1:23:18.61,Default,,0,0,0,,Ммм... Нмм...
Dialogue: 0,1:23:18.61,1:23:21.61,Default,,0,0,0,,Шинносуке-сан?
Dialogue: 0,1:23:27.62,1:23:29.62,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:23:29.62,1:23:32.62,Default,,0,0,0,,Хохохохо! Хохохо!
Dialogue: 0,1:23:32.62,1:23:37.63,Default,,0,0,0,,Не болды? Хохохо!
Dialogue: 0,1:23:37.63,1:23:41.63,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,1:23:41.63,1:23:44.63,Default,,0,0,0,,Кяах! (Директор) Уау!
Dialogue: 0,1:23:44.63,1:23:47.64,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,1:23:47.64,1:23:51.64,Default,,0,0,0,,Шинносуке! Сен қайдасың!?
Dialogue: 0,1:23:54.64,1:23:58.65,Default,,0,0,0,,Ах... патшалық өте кішкентай...
Dialogue: 0,1:23:58.65,1:24:00.65,Default,,0,0,0,,Ух... Ой...
Dialogue: 0,1:24:00.65,1:24:03.59,Default,,0,0,0,,Әзірге ғимарат ішінде
Dialogue: 0,1:24:03.59,1:24:07.59,Default,,0,0,0,,Шинносуке әрқашан жақын жерде. Додлдарды жалғастырайық.
Dialogue: 0,1:24:07.59,1:24:11.59,Default,,0,0,0,,Бірақ қазір барлық адамдар кетті, біз енді жалғыз емеспіз...
Dialogue: 0,1:24:11.59,1:24:14.60,Default,,0,0,0,,Шинносуке бұл туралы бірдеңе жасайды!
Dialogue: 0,1:24:14.60,1:24:16.60,Default,,0,0,0,,Шинносуке бұл туралы бірдеңе жасайды.
Dialogue: 0,1:24:16.60,1:24:18.60,Default,,0,0,0,,Ол батыр!
Dialogue: 0,1:24:18.60,1:24:21.60,Default,,0,0,0,,～
Dialogue: 0,1:24:21.60,1:24:23.61,Default,,0,0,0,,Шинносуке?
Dialogue: 0,1:24:23.61,1:24:25.61,Default,,0,0,0,,Жақын жерде емес пе?
Dialogue: 0,1:24:25.61,1:24:28.61,Default,,0,0,0,,Биіктен шақырсам, мүмкін тауып алармын.
Dialogue: 0,1:24:31.61,1:24:35.62,Default,,0,0,0,,Хохо! Хохохо!
Dialogue: 0,1:24:35.62,1:24:38.62,Default,,0,0,0,,Шинносукесан! Хохохо!
Dialogue: 0,1:24:38.62,1:24:41.62,Default,,0,0,0,,Күте тұрыңыз! Ха ха ха ха...
Dialogue: 0,1:24:41.62,1:24:44.63,Default,,0,0,0,,Хойхой! Хой хой!
Dialogue: 0,1:24:44.63,1:24:47.63,Default,,0,0,0,,Сәлем! Әй, Шинносукесан!
Dialogue: 0,1:24:47.63,1:24:49.63,Default,,0,0,0,,Хойхой!
Dialogue: 0,1:24:49.63,1:24:52.63,Default,,0,0,0,,Күте тұрыңыз! Ха ха...
Dialogue: 0,1:24:52.63,1:24:55.64,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,1:24:55.64,1:24:57.64,Default,,0,0,0,,Бұл... Ах!
Dialogue: 0,1:24:57.64,1:25:00.64,Default,,0,0,0,,Күте тұрыңыз! Шинносуке!
Dialogue: 0,1:25:00.64,1:25:03.58,Default,,0,0,0,,Шинносуке! Шинносуке!
Dialogue: 0,1:25:03.58,1:25:06.58,Default,,0,0,0,,Хохохохой!
Dialogue: 0,1:25:06.58,1:25:09.58,Default,,0,0,0,,Әй, Шинносуке! Хохохохо!
Dialogue: 0,1:25:09.58,1:25:11.59,Default,,0,0,0,,Шинносуке-сан!
Dialogue: 0,1:25:11.59,1:25:13.59,Default,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,1:25:13.59,1:25:16.59,Default,,0,0,0,,Ах! (құлап түскен дыбыс)
Dialogue: 0,1:25:24.60,1:25:26.60,Default,,0,0,0,,Юума Микрофон төменде.
Dialogue: 0,1:25:26.60,1:25:30.61,Default,,0,0,0,,Барлығың тыңдаңдар!
Dialogue: 0,1:25:30.61,1:25:33.61,Default,,0,0,0,,Өтінемін! Ракуга патшалығы құлап жатыр
Dialogue: 0,1:25:33.61,1:25:35.61,Default,,0,0,0,,Барлығы дудл жасайды
Dialogue: 0,1:25:35.61,1:25:39.61,Default,,0,0,0,,Ынтымақтасуыңызды сұраймыз!
Dialogue: 0,1:25:39.61,1:25:41.62,Default,,0,0,0,,Коконокадодан
Dialogue: 0,1:25:41.62,1:25:43.62,Default,,0,0,0,,Қызық, Шинносуке де бар ма?
Dialogue: 0,1:25:43.62,1:25:47.62,Default,,0,0,0,,Егер бәрі дудл жасаса, ол ел қалыпты жағдайға оралады!
Dialogue: 0,1:25:47.62,1:25:51.63,Default,,0,0,0,,Ынтымақтастық жасаңыз!
Dialogue: 0,1:25:51.63,1:25:53.63,Default,,0,0,0,,Тез қашайық!
Dialogue: 0,1:25:53.63,1:25:55.63,Default,,0,0,0,,Дұрыс, Касукабе аяқталды.
Dialogue: 0,1:25:55.63,1:25:58.63,Default,,0,0,0,,Дұрыс, өлсең бала болмайды.
Dialogue: 0,1:25:58.63,1:26:00.64,Default,,0,0,0,,Осы уақытқа дейін келдім, қайта алмаймын...
Dialogue: 0,1:26:00.64,1:26:02.57,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:26:02.57,1:26:05.57,Default,,0,0,0,,Кеттік! (Анашым) Жүр, тез!
Dialogue: 0,1:26:05.57,1:26:07.57,Default,,0,0,0,,Мм... (Әке) Кеттік!
Dialogue: 0,1:26:14.58,1:26:17.59,Default,,0,0,0,,Әйтеуір, мен қайтып келдім...
Dialogue: 0,1:26:17.59,1:26:20.59,Default,,0,0,0,,Мен көмектесе алмаймын (ер) Бұл мүмкін емес
Dialogue: 0,1:26:20.59,1:26:23.59,Default,,0,0,0,,Мен бұл балаға қауіп төндіре алмаймын.
Dialogue: 0,1:26:23.59,1:26:26.60,Default,,0,0,0,,Дәл осы қамал не...
Dialogue: 0,1:26:26.60,1:26:28.60,Default,,0,0,0,,Бұл үлкен мазасыздық.
Dialogue: 0,1:26:28.60,1:26:33.60,Default,,0,0,0,,Біріншіден, ол бала барлық түсті қарындаштарды түгелдей пайдаланды.
Dialogue: 0,1:26:35.60,1:26:38.61,Default,,0,0,0,,Балалар, сендер не деген сұмсыңдар!!
Dialogue: 0,1:26:38.61,1:26:42.61,Default,,0,0,0,,Барлығымыз ынтымақтасуымыз керек емес пе?
Dialogue: 0,1:26:42.61,1:26:44.61,Default,,0,0,0,,Барлығы маған көмектесті!
Dialogue: 0,1:26:44.61,1:26:48.62,Default,,0,0,0,,Шинносуке мен оның достары маған көмектесті деп ойлаймын!
Dialogue: 0,1:26:48.62,1:26:51.62,Default,,0,0,0,,Саған бәрі көмектеспеді ме?
Dialogue: 0,1:26:51.62,1:26:54.62,Default,,0,0,0,,Маған көмектессең де, қашып барасың ба?
Dialogue: 0,1:26:54.62,1:26:57.63,Default,,0,0,0,,Бұл өте жаман... бәрі сондай жаман!
Dialogue: 0,1:26:57.63,1:26:59.63,Default,,0,0,0,,Шинносукеге көмектесіңіз!
Dialogue: 0,1:26:59.63,1:27:01.56,Default,,0,0,0,,Әлі уақыт бар
Dialogue: 0,1:27:01.56,1:27:06.57,Default,,0,0,0,,Егер сіз дудльдер жасасаңыз, Корольдік те, Касукабе де сақталады.
Dialogue: 0,1:27:06.57,1:27:09.57,Default,,0,0,0,,Шинносуке салып жатқан суретіне көмектесіңізші.
Dialogue: 0,1:27:09.57,1:27:13.58,Default,,0,0,0,,Шинносукенің суреті? (Тағзым) Коконокадоға қайтайық.
Dialogue: 0,1:27:13.58,1:27:16.58,Default,,0,0,0,,Әлі уақыт бар! Егер сіз дуд жасасаңыз
Dialogue: 0,1:27:16.58,1:27:19.58,Default,,0,0,0,,Патшалық та, Касукабе де құтқарылады!
Dialogue: 0,1:27:19.58,1:27:21.58,Default,,0,0,0,,Мен қайтып келдім! (Бала) Мен де!
Dialogue: 0,1:27:21.58,1:27:24.59,Default,,0,0,0,,Эй... Эй! (Анашым) Күте тұрыңыз!
Dialogue: 0,1:27:24.59,1:27:27.59,Default,,0,0,0,,Касукабеге оралыңыз! (Юма) Шинносукемен
Dialogue: 0,1:27:27.59,1:27:31.59,Default,,0,0,0,,Үлкен суретті сал!
Dialogue: 0,1:27:31.59,1:27:34.60,Default,,0,0,0,,Юума-кун! Эй!
Dialogue: 0,1:27:34.60,1:27:37.60,Default,,0,0,0,,Шинносуке қауіпсіз бе!? (Юма) Иә.
Dialogue: 0,1:27:37.60,1:27:40.60,Default,,0,0,0,,Деректерді жіберу (дыбысты қабылдау)
Dialogue: 0,1:27:40.60,1:27:43.61,Default,,0,0,0,,Бұл суретте Шинносуке!
Dialogue: 0,1:27:43.61,1:27:46.61,Default,,0,0,0,,Хохохохой! (Қысқаша) Күте тұрыңыз!
Dialogue: 0,1:27:46.61,1:27:48.61,Default,,0,0,0,,Оля оля оля оля! О!
Dialogue: 0,1:27:48.61,1:27:50.61,Default,,0,0,0,,Жарайды, сурет салайық!
Dialogue: 0,1:27:50.61,1:27:53.62,Default,,0,0,0,,Уау! Жігіттер, дәл қазір...
Dialogue: 0,1:27:53.62,1:27:57.62,Default,,0,0,0,,Сезіміміз бір, біз де ынтымақтасайық.
Dialogue: 0,1:27:59.62,1:28:03.56,Default,,0,0,0,,Иә! Бұл өте ыңғайлы!
Dialogue: 0,1:28:03.56,1:28:06.56,Default,,0,0,0,,Олардың жүздері жақын! Барайық!
Dialogue: 0,1:28:06.56,1:28:08.56,Default,,0,0,0,,Бет~!
Dialogue: 0,1:28:08.56,1:28:12.57,Default,,0,0,0,,Шинносуке қазір денені сызып жатыр. Біз бетті аяқтаймыз!
Dialogue: 0,1:28:12.57,1:28:15.57,Default,,0,0,0,,Бірақ жол жоқ жерде қалай сурет салуға болады?
Dialogue: 0,1:28:15.57,1:28:18.57,Default,,0,0,0,,Иә, сурет біздің қолымызға тым үлкен...
Dialogue: 0,1:28:18.57,1:28:20.58,Default,,0,0,0,,Жете алмаймын (Казама) хехе
Dialogue: 0,1:28:20.58,1:28:23.58,Default,,0,0,0,,Жол болмаса да, сурет салуға болады!
Dialogue: 0,1:28:23.58,1:28:26.58,Default,,0,0,0,,Хохохо! О? О?
Dialogue: 0,1:28:26.58,1:28:30.59,Default,,0,0,0,,Хохохо! Хой хой!
Dialogue: 0,1:28:30.59,1:28:33.59,Default,,0,0,0,,Иә? Ахаха
Dialogue: 0,1:28:33.59,1:28:35.59,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:28:35.59,1:28:37.59,Default,,0,0,0,,♪Жасаймыз, жасайық, жасайық~?
Dialogue: 0,1:28:37.59,1:28:39.59,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:28:39.59,1:28:41.60,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:28:41.60,1:28:44.60,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:28:44.60,1:28:46.60,Default,,0,0,0,,♪Жасаймыз, жасайық, жасайық~?
Dialogue: 0,1:28:46.60,1:28:50.61,Default,,0,0,0,,Көзді салайық! (2 адам) ♪ Ауырған жара
Dialogue: 0,1:28:50.61,1:28:52.61,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:28:52.61,1:28:55.61,Default,,0,0,0,,Неліктен үлкенін салуым керек?
Dialogue: 0,1:28:55.61,1:28:57.61,Default,,0,0,0,,Оля оля оля!
Dialogue: 0,1:28:57.61,1:29:00.62,Default,,0,0,0,,Қастарыңды маған қалдыр! Урья!
Dialogue: 0,1:29:00.62,1:29:11.56,Default,,0,0,0,,♪
Dialogue: 0,1:29:11.56,1:29:15.56,Default,,0,0,0,,Ракуга патшалығының ақырына куә болайық...
Dialogue: 0,1:29:15.56,1:29:17.57,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:29:17.57,1:29:20.57,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:29:20.57,1:29:22.57,Default,,0,0,0,,♪Неге ағайларды да салмайсыз?
Dialogue: 0,1:29:22.57,1:29:24.57,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:29:24.57,1:29:26.57,Default,,0,0,0,,Не? (Балалар) ♪ Табаны жаралы
Dialogue: 0,1:29:26.57,1:29:28.58,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:29:28.58,1:29:31.58,Default,,0,0,0,,А... мынау!
Dialogue: 0,1:29:31.58,1:29:33.58,Default,,0,0,0,,Хохой! (Балалар)♪Неге жасамайсыңдар?
Dialogue: 0,1:29:33.58,1:29:36.58,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:29:36.58,1:29:38.59,Default,,0,0,0,,Дудл энергиясы
Dialogue: 0,1:29:38.59,1:29:41.59,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:29:41.59,1:29:43.59,Default,,0,0,0,,♪Жасаймыз, жасайық, жасайық~?
Dialogue: 0,1:29:43.59,1:29:45.59,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:29:45.59,1:29:48.60,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:29:48.60,1:29:50.60,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:29:50.60,1:29:52.60,Default,,0,0,0,,♪  ～
Dialogue: 0,1:29:52.60,1:29:54.60,Default,,0,0,0,,♪
Dialogue: 0,1:29:54.60,1:29:56.60,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:29:56.60,1:29:59.61,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:29:59.61,1:30:01.61,Default,,0,0,0,,♪
Dialogue: 0,1:30:01.61,1:30:03.61,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:30:03.61,1:30:05.61,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:30:05.61,1:30:08.62,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:30:08.62,1:30:10.62,Default,,0,0,0,,♪  ～
Dialogue: 0,1:30:10.62,1:30:12.62,Default,,0,0,0,,♪
Dialogue: 0,1:30:12.62,1:30:15.62,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:30:15.62,1:30:17.63,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:30:17.63,1:30:19.63,Default,,0,0,0,,♪  ～
Dialogue: 0,1:30:19.63,1:30:21.63,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:30:21.63,1:30:23.63,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:30:23.63,1:30:25.63,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:30:25.63,1:30:28.64,Default,,0,0,0,,♪  ～
Dialogue: 0,1:30:28.64,1:30:30.64,Default,,0,0,0,,♪Жаса, істе, істе, істе
Dialogue: 0,1:30:30.64,1:30:32.64,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:30:32.64,1:30:34.64,Default,,0,0,0,,Хохохохой!
Dialogue: 0,1:30:34.64,1:30:37.65,Default,,0,0,0,,♪Жасаймыз, жасайық, жасайық~?
Dialogue: 0,1:30:37.65,1:30:39.65,Default,,0,0,0,,♪Егер мен мұны істесем ше? Мен мұны істесем ше?
Dialogue: 0,1:30:39.65,1:30:42.65,Default,,0,0,0,,Жақсы! (Қазама) Сурет бітуге жақын!
Dialogue: 0,1:30:42.65,1:30:44.65,Default,,0,0,0,,Хохохохой!
Dialogue: 0,1:30:44.65,1:30:46.65,Default,,0,0,0,,♪Жаса, істе... Хохо!
Dialogue: 0,1:30:46.65,1:30:48.66,Default,,0,0,0,,♪
Dialogue: 0,1:30:48.66,1:30:50.66,Default,,0,0,0,,♪ Ауырған жара
Dialogue: 0,1:30:50.66,1:30:53.66,Default,,0,0,0,,О? О...
Dialogue: 0,1:30:53.66,1:30:56.66,Default,,0,0,0,,Шинносуке-сан! О?
Dialogue: 0,1:30:56.66,1:31:00.67,Default,,0,0,0,,Денемді созып, суретке қос!
Dialogue: 0,1:31:00.67,1:31:04.61,Default,,0,0,0,,Мен осылай болсам да, Мен ғажайып қарындаштардан жаралғанмын.
Dialogue: 0,1:31:04.61,1:31:06.61,Default,,0,0,0,,Егер мен суреттің бір бөлігіне айналсам
Dialogue: 0,1:31:06.61,1:31:10.61,Default,,0,0,0,,...
Dialogue: 0,1:31:10.61,1:31:13.62,Default,,0,0,0,,Суреттің бөлігі болу деген нені білдіреді?
Dialogue: 0,1:31:13.62,1:31:15.62,Default,,0,0,0,,Жүр, асығыңыз! Мүмкін емес!
Dialogue: 0,1:31:15.62,1:31:18.62,Default,,0,0,0,,Мен үшін уайымдама, жүр!
Dialogue: 0,1:31:18.62,1:31:21.62,Default,,0,0,0,,Мен оны жек көремін! Сіз Касукабені құтқарасыз ба?
Dialogue: 0,1:31:21.62,1:31:23.62,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,1:31:23.62,1:31:25.63,Default,,0,0,0,,Сізге не ұнамайды? Сіз түсінбейсіз!
Dialogue: 0,1:31:25.63,1:31:29.63,Default,,0,0,0,,Мен енді ешкіммен қоштасқым келмейді!
Dialogue: 0,1:31:34.64,1:31:37.64,Default,,0,0,0,,Дудл жақында аяқталады.
Dialogue: 0,1:31:37.64,1:31:42.64,Default,,0,0,0,,Суреттің аяқталмай біткеніне өкінемін.
Dialogue: 0,1:31:42.64,1:31:45.65,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:31:45.65,1:31:48.65,Default,,0,0,0,,Резеңке Ол босап қалады.
Dialogue: 0,1:31:48.65,1:31:50.65,Default,,0,0,0,,(Браффорд) Лорд Дио маған өмір сыйлады—
Dialogue: 0,1:31:50.65,1:31:52.65,Default,,0,0,0,,Шалбар екінші күннен бері болса да...
Dialogue: 0,1:31:52.65,1:31:56.66,Default,,0,0,0,,Иә, қарсы емеспін!
Dialogue: 0,1:31:56.66,1:31:59.66,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,1:32:01.60,1:32:05.60,Default,,0,0,0,,Хмм... Нуаааа!
Dialogue: 0,1:32:05.60,1:32:08.60,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:32:08.60,1:32:11.61,Default,,0,0,0,,Нуер! Тартыңыз!
Dialogue: 0,1:32:11.61,1:32:14.61,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:32:14.61,1:32:17.61,Default,,0,0,0,,Нуах!
Dialogue: 0,1:32:17.61,1:32:21.62,Default,,0,0,0,,Ооо... аа!
Dialogue: 0,1:32:21.62,1:32:23.62,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:32:23.62,1:32:25.62,Default,,0,0,0,,Нуах!!
Dialogue: 0,1:32:25.62,1:32:29.62,Default,,0,0,0,,Ааа! Ммм... ммм!
Dialogue: 0,1:32:29.62,1:32:31.62,Default,,0,0,0,,Ой!
Dialogue: 0,1:32:47.64,1:32:49.64,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:32:53.65,1:32:56.65,Default,,0,0,0,,Уау! Ааа!
Dialogue: 0,1:32:56.65,1:32:58.65,Default,,0,0,0,,Ахх...
Dialogue: 0,1:32:58.65,1:33:03.55,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,1:33:07.59,1:33:10.60,Default,,0,0,0,,Иә? Не?
Dialogue: 0,1:33:10.60,1:33:12.60,Default,,0,0,0,,Хаува!
Dialogue: 0,1:33:12.60,1:33:15.60,Default,,0,0,0,,Дедеде! Кәне! Деде деде деде~!
Dialogue: 0,1:33:15.60,1:33:19.61,Default,,0,0,0,,Кел, кел!
Dialogue: 0,1:33:19.61,1:33:23.61,Default,,0,0,0,,Бұл кім!? Мені ойламаған жерден шақырған адам!
Dialogue: 0,1:33:23.61,1:33:25.61,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:33:25.61,1:33:29.62,Default,,0,0,0,,Ммм!
Dialogue: 0,1:33:29.62,1:33:33.62,Default,,0,0,0,,Бури Бури Заемон, бар күшіңді сал!
Dialogue: 0,1:33:33.62,1:33:36.62,Default,,0,0,0,,Сәттілік! (4 адам) Сәттілік!
Dialogue: 0,1:33:36.62,1:33:38.63,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:33:38.63,1:33:41.63,Default,,0,0,0,,Сәттілік! (2 адам) Сәттілік!
Dialogue: 0,1:33:41.63,1:33:46.63,Default,,0,0,0,,Сәттілік! Іске сәт! Іске сәт!
Dialogue: 0,1:33:46.63,1:33:51.64,Default,,0,0,0,,Айтпасаң да барымды саламын! Хунну!
Dialogue: 0,1:33:51.64,1:33:55.64,Default,,0,0,0,,Йо... Ио... Йойшо~!
Dialogue: 0,1:33:55.64,1:33:59.65,Default,,0,0,0,,Ио... Йойшо~! Тая~!
Dialogue: 0,1:33:59.65,1:34:01.58,Default,,0,0,0,,Энн Ах!
Dialogue: 0,1:34:01.58,1:34:03.58,Default,,0,0,0,,Йойшо~!
Dialogue: 0,1:34:03.58,1:34:06.59,Default,,0,0,0,,Йойшо~! (4 адам) Йойшо!
Dialogue: 0,1:34:06.59,1:34:08.59,Default,,0,0,0,,Йойшо~!
Dialogue: 0,1:34:08.59,1:34:12.59,Default,,0,0,0,,Ууууууууууууу!
Dialogue: 0,1:34:12.59,1:34:17.60,Default,,0,0,0,,Нууууу!
Dialogue: 0,1:34:17.60,1:34:21.60,Default,,0,0,0,,Йойшо~!
Dialogue: 0,1:34:21.60,1:34:24.61,Default,,0,0,0,,Йойшо~!!
Dialogue: 0,1:34:24.61,1:34:27.61,Default,,0,0,0,,Ууууу...
Dialogue: 0,1:34:27.61,1:34:32.61,Default,,0,0,0,,Уау!!
Dialogue: 0,1:34:32.61,1:34:52.63,Default,,0,0,0,,♪
Dialogue: 0,1:34:52.63,1:35:06.58,Default,,0,0,0,,♪
Dialogue: 0,1:35:06.58,1:35:10.58,Default,,0,0,0,,Көмек ақысы 10 миллиард иен
Dialogue: 0,1:35:10.58,1:35:13.58,Default,,0,0,0,,Қолма-қол ақшасыз төлем де мүмкін
Dialogue: 0,1:35:19.59,1:35:22.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:25.60,1:35:27.60,Default,,0,0,0,,О!
Dialogue: 0,1:35:27.60,1:35:38.61,Default,,0,0,0,,♪
Dialogue: 0,1:35:38.61,1:35:40.61,Default,,0,0,0,,Шинносуке! Шин Чан!
Dialogue: 0,1:35:40.61,1:35:43.62,Default,,0,0,0,,Әке, ана, Широ
Dialogue: 0,1:35:43.62,1:35:45.62,Default,,0,0,0,,Анан! Хехехе
Dialogue: 0,1:35:45.62,1:35:47.62,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын!
Dialogue: 0,1:35:49.62,1:35:52.63,Default,,0,0,0,,Сондай-ақ... Кешіріңіз!
Dialogue: 0,1:35:52.63,1:35:56.63,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууу...
Dialogue: 0,1:36:06.57,1:36:09.58,Default,,0,0,0,,Ол мұны Патшалық туралы ойлап жасаған шығар.
Dialogue: 0,1:36:09.58,1:36:12.58,Default,,0,0,0,,Аа... аа...
Dialogue: 0,1:36:12.58,1:36:17.58,Default,,0,0,0,,Уау!!
Dialogue: 0,1:36:17.58,1:36:19.59,Default,,0,0,0,,Енді қаламды таңдаңыз
Dialogue: 0,1:36:19.59,1:36:22.59,Default,,0,0,0,,Осылай (ханшайым) Уау!
Dialogue: 0,1:36:22.59,1:36:25.59,Default,,0,0,0,,Оны қолданып көргіңіз келе ме? (Ханшайым) Иә, иә
Dialogue: 0,1:36:25.59,1:36:29.60,Default,,0,0,0,,♪(мырылдау)
Dialogue: 0,1:36:29.60,1:36:32.60,Default,,0,0,0,,Ненің суретін салдыңыз? (Ханшайым) Әке!
Dialogue: 0,1:36:32.60,1:36:34.60,Default,,0,0,0,,Аа... (ханшайым) Хехе
Dialogue: 0,1:36:34.60,1:36:37.60,Default,,0,0,0,,Ал, құтқарамыз ба? (Ханшайым) «Хозон»?
Dialogue: 0,1:36:37.60,1:36:42.60,Default,,0,0,0,,Иә, көптеген адамдар сақталған суреттерін жалпыға ортақ етеді.
Dialogue: 0,1:36:44.61,1:36:49.62,Default,,0,0,0,,Уау, әкеңе де көрсеткім келеді.
Dialogue: 0,1:36:49.62,1:36:51.62,Default,,0,0,0,,Уау! (Сот суретшісі) Ханшайым
Dialogue: 0,1:36:51.62,1:36:54.62,Default,,0,0,0,,Тезірек оралыңыз! (Ханшайым) Мен білемін
Dialogue: 0,1:36:54.62,1:36:59.63,Default,,0,0,0,,Король мен Қорғаныс министріне қалдырсақ не болады?
Dialogue: 0,1:36:59.63,1:37:01.56,Default,,0,0,0,,Жарайды
Dialogue: 0,1:37:01.56,1:37:03.56,Default,,0,0,0,,Ах (ханшайым) қарашы
Dialogue: 0,1:37:03.56,1:37:06.57,Default,,0,0,0,,Бұл да дудлдармен толтырылған.
Dialogue: 0,1:37:06.57,1:37:09.57,Default,,0,0,0,,Өте еркін және көңілді көрінеді
Dialogue: 0,1:37:09.57,1:37:12.57,Default,,0,0,0,,Ах, ах…
Dialogue: 0,1:37:12.57,1:37:14.58,Default,,0,0,0,,​​Барлығыңызға рахмет!
Dialogue: 0,1:37:14.58,1:37:16.58,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,1:37:16.58,1:37:19.58,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,1:37:19.58,1:37:21.58,Default,,0,0,0,,Фуфуфу таяяя~
Dialogue: 0,1:37:21.58,1:37:23.58,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,1:37:23.58,1:37:27.58,Default,,0,0,0,,Сау болыңыз, сау болыңыз! (Әйел) Жақында кездескенше!
Dialogue: 0,1:37:30.59,1:37:33.59,Default,,0,0,0,,Сонымен, үйге барасың ба? (Иә) Иә
Dialogue: 0,1:37:35.60,1:37:38.60,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,1:37:38.60,1:37:41.60,Default,,0,0,0,,Міне! Абайлаңыз, Бури Бури~ Бури Бури~
Dialogue: 0,1:37:41.60,1:37:43.60,Default,,0,0,0,,Рахмет
Dialogue: 0,1:37:46.61,1:37:49.61,Default,,0,0,0,,Юума-кун, сау бол!
Dialogue: 0,1:37:49.61,1:37:52.61,Default,,0,0,0,,Анашым! О!
Dialogue: 0,1:37:52.61,1:37:55.62,Default,,0,0,0,,Юума, мен білемін!
Dialogue: 0,1:37:55.62,1:37:57.62,Default,,0,0,0,,Әй?
Dialogue: 0,1:38:01.56,1:38:03.56,Default,,0,0,0,,Ах! Нанако-нисан!
Dialogue: 0,1:38:03.56,1:38:06.56,Default,,0,0,0,,Иә? О, Шин Чан
Dialogue: 0,1:38:06.56,1:38:10.56,Default,,0,0,0,,Нанако Они-сан! Аман жүргеніңізге қуаныштымын.
Dialogue: 0,1:38:10.56,1:38:13.57,Default,,0,0,0,,Саңырауқұлақ аулауға бардым, қайта орала алмадым...
Dialogue: 0,1:38:13.57,1:38:16.57,Default,,0,0,0,,Нанако-чан, ол Касукабеде емес пе еді?
Dialogue: 0,1:38:16.57,1:38:19.57,Default,,0,0,0,,Дұрыс, Нанако Они-сан.
Dialogue: 0,1:38:19.57,1:38:23.58,Default,,0,0,0,,Олаға берген уәдеңіз есіңізде ме?
Dialogue: 0,1:38:23.58,1:38:26.58,Default,,0,0,0,,Әрине, бірге тамақтанайық.
Dialogue: 0,1:38:26.58,1:38:30.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:38:30.58,1:38:32.59,Default,,0,0,0,,Шин-чан! Шинносуке!?
Dialogue: 0,1:38:32.59,1:38:35.59,Default,,0,0,0,,Себебі мен тек қызықсыз нәрселер жасаймын.
Dialogue: 0,1:38:35.59,1:38:37.59,Default,,0,0,0,,Сәлем! Эй
Dialogue: 0,1:38:37.59,1:38:39.59,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,1:38:39.59,1:38:42.60,Default,,0,0,0,,А, мен көп демалдым.
Dialogue: 0,1:38:42.60,1:38:45.60,Default,,0,0,0,,Біраз уақытқа демалуға болмайды. Бос емес!
Dialogue: 0,1:38:45.60,1:38:48.60,Default,,0,0,0,,Эй Юума, бұл не?
Dialogue: 0,1:38:48.60,1:38:50.60,Default,,0,0,0,,Бос емес
Dialogue: 0,1:38:50.60,1:38:53.61,Default,,0,0,0,,Енді орындайық.
Dialogue: 0,1:38:53.61,1:38:56.61,Default,,0,0,0,,Соя соусы...
Dialogue: 0,1:38:56.61,1:38:59.61,Default,,0,0,0,,Шинносуке, сен бұл жерде ұмыттың ба?
Dialogue: 0,1:38:59.61,1:39:03.55,Default,,0,0,0,,Итадакимасу! (Жақсы Нанако) Мен Шин Чанды жақсы көремін
Dialogue: 0,1:39:03.55,1:39:07.55,Default,,0,0,0,,Өте дәмді! (Қысқаша) Мен өмірге қайта ораламын.
Dialogue: 0,1:39:07.55,1:39:09.56,Default,,0,0,0,,Бұл ет шошқа емес пе?
Dialogue: 0,1:39:09.56,1:39:12.56,Default,,0,0,0,,Мен Шин Чанды жақсы көремін~
Dialogue: 0,1:39:12.56,1:39:15.56,Default,,0,0,0,,Бероберо Беро Беро
Dialogue: 0,1:39:19.57,1:39:21.57,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,1:39:28.58,1:39:31.58,Default,,0,0,0,,Хаха... хахаха
Dialogue: 0,1:39:34.58,1:39:37.58,Default,,0,0,0,,Рахмет сізге Шинносуке
Dialogue: 0,1:39:37.58,1:39:39.59,Default,,0,0,0,,Бұл жерде!
Dialogue: 0,1:39:39.59,1:39:41.59,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,1:39:41.59,1:39:46.59,Default,,0,0,0,,Ммм, эй, мен осы күні көп еңбек еттім!
Dialogue: 0,1:39:46.59,1:39:48.60,Default,,0,0,0,,Хехехе, асыра сілтеу.
Dialogue: 0,1:39:48.60,1:39:51.60,Default,,0,0,0,,Иә? Эй Шин Чан
Dialogue: 0,1:39:51.60,1:39:53.60,Default,,0,0,0,,Бұл балалар кім?
Dialogue: 0,1:39:53.60,1:39:56.60,Default,,0,0,0,,Ол Оланың құтқарушы кейіпкері.
Dialogue: 0,1:39:56.60,1:40:16.62,Default,,0,0,0,,♪
Dialogue: 0,1:40:16.62,1:40:36.64,Default,,0,0,0,,♪
