Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.01,0:00:15.01,Default,,0,0,0,,(сырылдаған беріліс дыбысы)
Dialogue: 0,0:00:16.89,0:00:20.89,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:22.06,0:00:22.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:22.98,0:00:25.35,Default,,0,0,0,,А-а-а...
Dialogue: 0,0:00:28.27,0:00:31.40,Default,,0,0,0,,Неліктен... бұл болып жатыр...
Dialogue: 0,0:00:31.94,0:00:33.32,Default,,0,0,0,,Казама... (Казама-кун) Уф!
Dialogue: 0,0:00:33.40,0:00:35.16,Default,,0,0,0,,Тоору…
Dialogue: 0,0:00:35.24,0:00:36.45,Default,,0,0,0,,Рұқсатсыз маған қарама.
Dialogue: 0,0:00:43.46,0:00:46.33,Default,,0,0,0,,Уф... (Жұмбақ адам) Омаэно негай...
Dialogue: 0,0:00:46.42,0:00:48.92,Default,,0,0,0,,Канае Теяр…
Dialogue: 0,0:00:49.96,0:00:50.80,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:50.88,0:00:51.88,Default,,0,0,0,,Вааах!
Dialogue: 0,0:00:51.96,0:00:53.84,Default,,0,0,0,,Тынш!
Dialogue: 0,0:00:53.92,0:00:57.26,Default,,0,0,0,,Шинносуке!
Dialogue: 0,0:00:57.34,0:00:58.72,Default,,0,0,0,,(Амон) Аогири ағашы туралы не білесің?
Dialogue: 0,0:00:58.80,0:01:02.81,Default,,0,0,0,,(Кейн дыбысы)
Dialogue: 0,0:01:18.82,0:01:23.16,Default,,0,0,0,,♪～
Dialogue: 0,0:02:14.80,0:02:19.80,Default,,0,0,0,,～♪
Dialogue: 0,0:02:19.88,0:02:22.26,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:02:23.10,0:02:24.81,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:02:24.89,0:02:25.72,Default,,0,0,0,,Анн?
Dialogue: 0,0:02:25.81,0:02:29.19,Default,,0,0,0,,Оланың жаңа маска шалбары~
Dialogue: 0,0:02:29.27,0:02:31.65,Default,,0,0,0,,Шинносуке, сен әлі киіміңді ауыстырмадың ба?
Dialogue: 0,0:02:31.73,0:02:33.69,Default,,0,0,0,,Қош келдіңіз, мен келемін!
Dialogue: 0,0:02:33.77,0:02:34.61,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:34.69,0:02:37.07,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:02:37.15,0:02:39.28,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:02:39.36,0:02:42.99,Default,,0,0,0,,О, түсіндім! Хань халқы ~
Dialogue: 0,0:02:43.07,0:02:44.03,Default,,0,0,0,,Бұл анам!
Dialogue: 0,0:02:44.12,0:02:44.95,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:02:45.03,0:02:46.37,Default,,0,0,0,,Анам
Dialogue: 0,0:02:46.45,0:02:48.91,Default,,0,0,0,,Оланың шалбары сондай керемет...
Dialogue: 0,0:02:49.00,0:02:51.50,Default,,0,0,0,,Уау, мен оны киіп көрейін.
Dialogue: 0,0:02:51.58,0:02:52.96,Default,,0,0,0,,Хмф, хмф!
Dialogue: 0,0:02:54.00,0:02:55.13,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:02:55.21,0:02:57.55,Default,,0,0,0,,Оланың болашағы жарқын!
Dialogue: 0,0:02:57.63,0:02:59.59,Default,,0,0,0,,Широ Джоширо Мисаенің үлкен жоғы!
Dialogue: 0,0:02:59.67,0:03:01.05,Default,,0,0,0,,(Генкоцу дыбысы)
Dialogue: 0,0:03:01.13,0:03:03.76,Default,,0,0,0,,Мен мұны өзім жасай алар едім!
Dialogue: 0,0:03:03.85,0:03:05.10,Default,,0,0,0,,О, дұрыс~
Dialogue: 0,0:03:05.18,0:03:08.47,Default,,0,0,0,,Мүлдем... Жақында сынға ұшыраймын.
Dialogue: 0,0:03:09.23,0:03:11.98,Default,,0,0,0,,Жарайды, жүктеріңді тексерейік.
Dialogue: 0,0:03:12.06,0:03:12.94,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:13.94,0:03:18.23,Default,,0,0,0,,Жеке біріктіру Касукабе академиясы Тенкасу академиясына барайық
Dialogue: 0,0:03:18.82,0:03:22.70,Default,,0,0,0,,Барлық бастауыш және кіші орта мектептер элиталық мектептер болып табылады.
Dialogue: 0,0:03:23.28,0:03:26.37,Default,,0,0,0,,Күнбағыс! Бауырым, сен элита болып кетерсің?
Dialogue: 0,0:03:26.45,0:03:27.29,Default,,0,0,0,,Ая?
Dialogue: 0,0:03:27.37,0:03:30.25,Default,,0,0,0,,Ех! Немесе сіз Де Ниро болғыңыз келе ме?
Dialogue: 0,0:03:30.33,0:03:31.16,Default,,0,0,0,,Элита
Dialogue: 0,0:03:31.25,0:03:35.42,Default,,0,0,0,,Элита - ең жақсылардың ең жақсысы.
Dialogue: 0,0:03:35.50,0:03:37.63,Default,,0,0,0,,Қияр
Dialogue: 0,0:03:37.71,0:03:39.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:39.63,0:03:41.09,Default,,0,0,0,,Ух ха ха~
Dialogue: 0,0:03:41.17,0:03:42.63,Default,,0,0,0,,Гаппогапо~
Dialogue: 0,0:03:42.72,0:03:44.76,Default,,0,0,0,,Мотемоте~ухаха~
Dialogue: 0,0:03:44.76,0:03:46.01,Default,,0,0,0,,Motemote~uuhaha~
Dialogue: 0,0:03:44.76,0:03:46.01,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:03:46.10,0:03:50.77,Default,,0,0,0,,Сіз тек бір апталық сынақ нұсқасына жазылу арқылы элита бола алмайсыз, солай ма?
Dialogue: 0,0:03:50.85,0:03:52.98,Default,,0,0,0,,Балалар жылдам.
Dialogue: 0,0:03:53.06,0:03:55.94,Default,,0,0,0,,Дұрыс, ол аз уақытта үлкен болады!
Dialogue: 0,0:03:56.02,0:03:58.32,Default,,0,0,0,,Анамның бөксесі сияқты~
Dialogue: 0,0:03:58.40,0:03:59.28,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:59.36,0:04:00.69,Default,,0,0,0,,Иә, мен мұны істегім келеді!
Dialogue: 0,0:04:00.78,0:04:02.90,Default,,0,0,0,,Ой
Dialogue: 0,0:04:02.99,0:04:05.57,Default,,0,0,0,,Шинносуке, қазір көңіл күйің қалай?
Dialogue: 0,0:04:05.66,0:04:08.95,Default,,0,0,0,,Өте ауыр~ Ннуну...!
Dialogue: 0,0:04:09.04,0:04:12.62,Default,,0,0,0,,Ылғал тіндер де қажет, жәндіктерге қарсы спрей.
Dialogue: 0,0:04:12.71,0:04:14.00,Default,,0,0,0,,Дұрыс тамақтанбағандықтан...
Dialogue: 0,0:04:14.08,0:04:15.92,Default,,0,0,0,,Бұл бір апта ғана.
Dialogue: 0,0:04:16.00,0:04:17.46,Default,,0,0,0,,Анан!
Dialogue: 0,0:04:17.54,0:04:18.38,Default,,0,0,0,,Желдей жылдам шабуыл!
Dialogue: 0,0:04:19.00,0:04:20.84,Default,,0,0,0,,Тенкасу академиясына қош келдіңіз
Dialogue: 0,0:04:23.42,0:04:24.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:24.34,0:04:26.72,Default,,0,0,0,,Жүргізуші кім? иә?
Dialogue: 0,0:04:29.06,0:04:30.18,Default,,0,0,0,,Иә? иә? ау
Dialogue: 0,0:04:36.23,0:04:37.27,Default,,0,0,0,,Бұл не! Ха!
Dialogue: 0,0:04:37.36,0:04:39.11,Default,,0,0,0,,О! Энн! Энн!
Dialogue: 0,0:04:39.19,0:04:40.82,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:04:40.90,0:04:44.53,Default,,0,0,0,,Мен Отсумунмын, Тенкасу академиясының орталық АИ.
Dialogue: 0,0:04:45.15,0:04:48.07,Default,,0,0,0,,Мен Шинносуке Нохараға бардым.
Dialogue: 0,0:04:48.16,0:04:48.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:49.08,0:04:52.37,Default,,0,0,0,,AI… Автокөліктер де өздігінен жүретін болады ма?
Dialogue: 0,0:04:52.45,0:04:54.08,Default,,0,0,0,,Е, жақсысың ба?
Dialogue: 0,0:04:54.16,0:04:55.04,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:04:55.12,0:04:55.96,Default,,0,0,0,,А...
Dialogue: 0,0:04:56.58,0:04:58.67,Default,,0,0,0,,Мен бәрін қолдаймын
Dialogue: 0,0:04:58.75,0:05:00.84,Default,,0,0,0,,Ешқашан дәнекерлеу кезінде қателеспеңіз
Dialogue: 0,0:05:00.92,0:05:03.80,Default,,0,0,0,,Шинноске, асығыңыз!
Dialogue: 0,0:05:03.88,0:05:06.26,Default,,0,0,0,,О~ Казама-кун!
Dialogue: 0,0:05:06.76,0:05:08.47,Default,,0,0,0,,Бір минут күтіңіз! Ах...
Dialogue: 0,0:05:08.55,0:05:10.76,Default,,0,0,0,,Әлі де бірдеңе бар... уф...
Dialogue: 0,0:05:11.47,0:05:13.64,Default,,0,0,0,,Анашым, ауырып тұр...
Dialogue: 0,0:05:14.14,0:05:16.10,Default,,0,0,0,,Бұл бір аптаға.
Dialogue: 0,0:05:16.19,0:05:18.10,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:05:18.19,0:05:20.11,Default,,0,0,0,,Жалғыздық сезінсеңіз, маған қоңырау шалыңыз.
Dialogue: 0,0:05:20.19,0:05:21.73,Default,,0,0,0,,Энн! Мен оны тілеймін!
Dialogue: 0,0:05:21.82,0:05:22.82,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:05:22.90,0:05:24.44,Default,,0,0,0,,Барлығы асыра айтып жатыр.
Dialogue: 0,0:05:25.03,0:05:27.66,Default,,0,0,0,,Казама-кун! Шинносукеге қамқорлық жасаңыз
Dialogue: 0,0:05:27.74,0:05:28.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:28.91,0:05:31.78,Default,,0,0,0,,Ал, ваннаны сал! Тістеріңізді тазалаңыз!
Dialogue: 0,0:05:31.87,0:05:35.87,Default,,0,0,0,,Қайызғақ! Келесі аптада кездескенше~
Dialogue: 0,0:05:38.67,0:05:40.42,Default,,0,0,0,,Хм, мен кеттім...
Dialogue: 0,0:05:40.50,0:05:41.50,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:05:41.59,0:05:43.55,Default,,0,0,0,,Уууу~ Эй...
Dialogue: 0,0:05:45.92,0:05:48.51,Default,,0,0,0,,Хаааааааааааааааааааааооон!
Dialogue: 0,0:05:51.68,0:05:52.89,Default,,0,0,0,,Тенкасу академиясы
Dialogue: 0,0:05:52.97,0:05:55.35,Default,,0,0,0,,Сайсентанның Гиджуцу таныстырылды.
Dialogue: 0,0:05:55.43,0:05:56.98,Default,,0,0,0,,Бұл элиталық мектеп.
Dialogue: 0,0:05:57.06,0:05:57.89,Default,,0,0,0,,Я~
Dialogue: 0,0:05:57.98,0:06:00.73,Default,,0,0,0,,Мен сенің маған тәнті болғаныңды қалаймын
Dialogue: 0,0:06:00.81,0:06:03.69,Default,,0,0,0,,Өйткені бұл бес адамнан тұратын топ болатын.
Dialogue: 0,0:06:03.78,0:06:06.11,Default,,0,0,0,,Біз сізбен бірге боламыз!
Dialogue: 0,0:06:06.19,0:06:07.99,Default,,0,0,0,,Міне.
Dialogue: 0,0:06:08.07,0:06:09.03,Default,,0,0,0,,Сәлем? Шинносуке
Dialogue: 0,0:06:09.11,0:06:12.99,Default,,0,0,0,,Эй, мен бұл мұғалімнен көп нәрсені үйренгім келеді.
Dialogue: 0,0:06:13.08,0:06:14.20,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:14.29,0:06:17.16,Default,,0,0,0,,Иә, сәл қараңғы, бірақ мейірімді көрінеді...
Dialogue: 0,0:06:17.25,0:06:18.96,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:19.04,0:06:20.63,Default,,0,0,0,,Сен қатты толқыдың
Dialogue: 0,0:06:20.71,0:06:22.96,Default,,0,0,0,,Масао-кун, жақсысың ба?
Dialogue: 0,0:06:23.04,0:06:24.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:25.13,0:06:27.97,Default,,0,0,0,,Үйіңізді сағынып жүрсіз бе? Мықты бол
Dialogue: 0,0:06:28.05,0:06:29.22,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:06:29.30,0:06:32.18,Default,,0,0,0,,Жастық шақ енді басталады!
Dialogue: 0,0:06:32.26,0:06:34.14,Default,,0,0,0,,Сейшун? иә!
Dialogue: 0,0:06:34.22,0:06:37.68,Default,,0,0,0,,Амазобай Кел! Ыстық достар!
Dialogue: 0,0:06:37.77,0:06:39.35,Default,,0,0,0,,Мен арманымды ұстай алмаймын!
Dialogue: 0,0:06:39.44,0:06:41.56,Default,,0,0,0,,Сіздің өміріңіздегі ең жарқын сәт!
Dialogue: 0,0:06:41.65,0:06:43.11,Default,,0,0,0,,Бұл жастық шақ!
Dialogue: 0,0:06:43.19,0:06:44.23,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:06:44.32,0:06:45.57,Default,,0,0,0,,Жақсы нәрсе
Dialogue: 0,0:06:45.65,0:06:48.40,Default,,0,0,0,,Дұрыс? Мен өзімді барынша ләззат алуым керек
Dialogue: 0,0:06:48.49,0:06:50.07,Default,,0,0,0,,Жақсы, өте жақсы!
Dialogue: 0,0:06:50.15,0:06:52.66,Default,,0,0,0,,Бәріміз жас болайық!
Dialogue: 0,0:06:52.74,0:06:56.12,Default,,0,0,0,,Касукабе қорғаныс күштерінің жастар өрті!
Dialogue: 0,0:06:56.20,0:06:57.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:57.12,0:06:59.50,Default,,0,0,0,,Енді бәрі де солай істесін!
Dialogue: 0,0:06:59.58,0:07:03.58,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,0:07:14.47,0:07:16.76,Default,,0,0,0,,Осы жерде күтіңіз
Dialogue: 0,0:07:18.35,0:07:19.35,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:21.48,0:07:22.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:25.61,0:07:27.23,Default,,0,0,0,,Оның күші көп.
Dialogue: 0,0:07:29.19,0:07:30.99,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:07:32.28,0:07:34.66,Default,,0,0,0,,Неге мектеп формаңды киіп жүрсің? Одан кейін мектепке барасың ба?
Dialogue: 0,0:07:34.74,0:07:37.12,Default,,0,0,0,,Тенкасу Гакуен орта мектебі 2 курс
Dialogue: 0,0:07:37.20,0:07:42.54,Default,,0,0,0,,Мен Чишио Атсукимін, Seito төрағасымын, оған барлығына қамқорлық сеніп тапсырылған!
Dialogue: 0,0:07:42.62,0:07:44.50,Default,,0,0,0,,Төраға Сейто?
Dialogue: 0,0:07:44.58,0:07:47.46,Default,,0,0,0,,Оланың әкесі миллион жыл бөлім бастығы.
Dialogue: 0,0:07:47.55,0:07:48.67,Default,,0,0,0,,Ұстап қалмаңдар және ұрыспаңдар!
Dialogue: 0,0:07:48.67,0:07:49.51,Default,,0,0,0,,Ұсталмаңдар және ұрыспаңдар!
Dialogue: 0,0:07:48.67,0:07:49.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:50.13,0:07:52.55,Default,,0,0,0,,Ақымақ болғаным үшін кешіріңіз.
Dialogue: 0,0:07:52.63,0:07:54.76,Default,,0,0,0,,Эй, бұл Шинносуке Нохара!
Dialogue: 0,0:07:54.84,0:07:55.80,Default,,0,0,0,,Йорочикуби~
Dialogue: 0,0:07:55.89,0:07:56.72,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:56.80,0:07:59.81,Default,,0,0,0,,Ахаха... Жақсы екеніңізге қуаныштымын!
Dialogue: 0,0:07:59.89,0:08:00.77,Default,,0,0,0,,Енді кеттік!
Dialogue: 0,0:08:00.85,0:08:03.23,Default,,0,0,0,,Иә! Ол №1!
Dialogue: 0,0:08:03.31,0:08:04.98,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:08:05.06,0:08:07.65,Default,,0,0,0,,Мен біріншімін!
Dialogue: 0,0:08:08.65,0:08:10.69,Default,,0,0,0,,Мен оны жек көремін! Уау~
Dialogue: 0,0:08:10.78,0:08:13.74,Default,,0,0,0,,Тенкасу академиясына қош келдіңіз!
Dialogue: 0,0:08:19.66,0:08:23.58,Default,,0,0,0,,(Сейтоның сөйлейтін дауысы)
Dialogue: 0,0:08:26.67,0:08:27.96,Default,,0,0,0,,Керемет...
Dialogue: 0,0:08:28.04,0:08:30.00,Default,,0,0,0,,Мектеп директорымен амандаспас бұрын
Dialogue: 0,0:08:30.09,0:08:31.63,Default,,0,0,0,,Жаңа киімдерімізді ауыстырайық.
Dialogue: 0,0:08:31.71,0:08:32.55,Default,,0,0,0,,Киім?
Dialogue: 0,0:08:33.34,0:08:35.51,Default,,0,0,0,,Жоқ! (Казама-кун) Бұл Тенкасу академиясы...
Dialogue: 0,0:08:42.10,0:08:42.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:43.02,0:08:44.35,Default,,0,0,0,,Хмф~ Ах...
Dialogue: 0,0:08:44.44,0:08:47.65,Default,,0,0,0,,Ахахаха Нене сүйкімді ме?
Dialogue: 0,0:08:47.73,0:08:48.90,Default,,0,0,0,,А... иә
Dialogue: 0,0:08:49.52,0:08:51.86,Default,,0,0,0,,Барлығы өте жақсы араласады.
Dialogue: 0,0:08:51.94,0:08:53.57,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:08:53.65,0:08:56.28,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:08:56.36,0:09:00.66,Default,,0,0,0,,Мен Касукабе Ұлтты біріктіру академиясының директорымын.
Dialogue: 0,0:09:00.74,0:09:03.12,Default,,0,0,0,,Бұл Хаги Мукуми!
Dialogue: 0,0:09:03.20,0:09:05.41,Default,,0,0,0,,Біз Футаба балабақшасынан келдік...
Dialogue: 0,0:09:05.50,0:09:07.08,Default,,0,0,0,,Бұл Шоряку! (Казама-кун) Ах...
Dialogue: 0,0:09:07.17,0:09:09.54,Default,,0,0,0,,Әзірше оны киіңіз.
Dialogue: 0,0:09:11.21,0:09:12.59,Default,,0,0,0,,Уау~
Dialogue: 0,0:09:12.67,0:09:15.13,Default,,0,0,0,,Бұл элиталық ұпай белгісі.
Dialogue: 0,0:09:15.22,0:09:17.84,Default,,0,0,0,,Эй, сен оқисың ба? (Казама-кун) Иә!
Dialogue: 0,0:09:18.43,0:09:19.55,Default,,0,0,0,,Отсумун
Dialogue: 0,0:09:21.89,0:09:24.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:25.52,0:09:27.48,Default,,0,0,0,,Элиталық ұпайларды көбейту
Dialogue: 0,0:09:28.23,0:09:29.44,Default,,0,0,0,,Уау (Казама-кун) Уау, а?
Dialogue: 0,0:09:29.52,0:09:31.65,Default,,0,0,0,,Оқуға түскен кезде 1000 ұпай
Dialogue: 0,0:09:31.73,0:09:34.49,Default,,0,0,0,,Бұл элита болудың алғашқы қадамы.
Dialogue: 0,0:09:36.53,0:09:38.16,Default,,0,0,0,,Тенкасу академиясы
Dialogue: 0,0:09:38.24,0:09:41.12,Default,,0,0,0,,Мен жасаған тәрбиелік А.И.Оцумын арқылы
Dialogue: 0,0:09:41.20,0:09:42.33,Default,,0,0,0,,Бұл ұпайлардың арқасында.
Dialogue: 0,0:09:42.41,0:09:43.29,Default,,0,0,0,,Академиялық зерттеулер
Dialogue: 0,0:09:43.37,0:09:44.25,Default,,0,0,0,,Спорт
Dialogue: 0,0:09:44.33,0:09:45.20,Default,,0,0,0,,Гейджуцу
Dialogue: 0,0:09:45.29,0:09:46.16,Default,,0,0,0,,Гейну
Dialogue: 0,0:09:46.25,0:09:47.12,Default,,0,0,0,,Мінез-құлық
Dialogue: 0,0:09:47.71,0:09:50.29,Default,,0,0,0,,Бүкіл мектеппен элиталық істер мен шағымдар.
Dialogue: 0,0:09:50.38,0:09:53.13,Default,,0,0,0,,Отсумун үй шаруашылығына айналды...
Dialogue: 0,0:09:56.01,0:09:57.72,Default,,0,0,0,,Ұпайлар артады
Dialogue: 0,0:09:57.80,0:09:58.80,Default,,0,0,0,,Я~
Dialogue: 0,0:09:58.88,0:10:01.14,Default,,0,0,0,,Біздің мектеп жоғары деңгейде!
Dialogue: 0,0:10:01.72,0:10:04.10,Default,,0,0,0,,Толығымен кондиционері бар кең гимназия
Dialogue: 0,0:10:04.18,0:10:07.06,Default,,0,0,0,,Еркін қолжетімді суперкомпьютер бөлмесі
Dialogue: 0,0:10:07.14,0:10:08.02,Default,,0,0,0,,Спорт залы
Dialogue: 0,0:10:08.10,0:10:08.98,Default,,0,0,0,,Жоқ, мен ауылдағы үшінші сортты мектепке бардым.
Dialogue: 0,0:10:09.06,0:10:09.94,Default,,0,0,0,,Қалай тамақтану керек
Dialogue: 0,0:10:10.02,0:10:12.40,Default,,0,0,0,,Және кітапхана!
Dialogue: 0,0:10:12.48,0:10:13.90,Default,,0,0,0,,О~
Dialogue: 0,0:10:16.61,0:10:18.90,Default,,0,0,0,,Енді ол электронды,
Dialogue: 0,0:10:18.99,0:10:21.82,Default,,0,0,0,,Хикарицу өте кедей.
Dialogue: 0,0:10:22.49,0:10:23.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:23.95,0:10:26.04,Default,,0,0,0,,Сіз қалай ойлайсыз? Тенкасу Гакуен
Dialogue: 0,0:10:26.12,0:10:27.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:27.25,0:10:28.66,Default,,0,0,0,,Ол соншалықты үлкен, мен шаршадым~
Dialogue: 0,0:10:28.66,0:10:29.50,Default,,0,0,0,,Үлкен болғаны сонша, шаршадым~
Dialogue: 0,0:10:28.66,0:10:29.50,Default,,0,0,0,,Не!
Dialogue: 0,0:10:29.58,0:10:30.92,Default,,0,0,0,,Мм! ау
Dialogue: 0,0:10:31.00,0:10:33.63,Default,,0,0,0,,Әй, менің сұлу ұстазым қайда?
Dialogue: 0,0:10:33.71,0:10:34.96,Default,,0,0,0,,Прикецу ағай
Dialogue: 0,0:10:35.05,0:10:36.38,Default,,0,0,0,,P… Прикет?
Dialogue: 0,0:10:36.46,0:10:38.09,Default,,0,0,0,,Шинносуке!
Dialogue: 0,0:10:38.17,0:10:40.93,Default,,0,0,0,,Сен, сөзіңе абай бол.
Dialogue: 0,0:10:41.01,0:10:42.05,Default,,0,0,0,,Қастар таң қалдырады
Dialogue: 0,0:10:43.18,0:10:44.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:45.60,0:10:46.97,Default,,0,0,0,,Элита жоқ
Dialogue: 0,0:10:47.06,0:10:48.77,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:10:48.85,0:10:49.69,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:49.77,0:10:52.73,Default,,0,0,0,,Бәріміз де әдепті адамдармыз.
Dialogue: 0,0:10:52.81,0:10:56.65,Default,,0,0,0,,Желді сездіретін осындай нәрсе болса ше...
Dialogue: 0,0:10:56.73,0:10:57.90,Default,,0,0,0,,Уф… Бұған қуануым керек пе?
Dialogue: 0,0:10:57.99,0:10:59.45,Default,,0,0,0,,Ей, мені кешір!
Dialogue: 0,0:10:59.53,0:11:01.03,Default,,0,0,0,,Сенің баяу жүргенің үшін!
Dialogue: 0,0:11:01.11,0:11:01.95,Default,,0,0,0,,Не!
Dialogue: 0,0:11:02.03,0:11:03.16,Default,,0,0,0,,Сәлем! (Казама-кун) Ах!
Dialogue: 0,0:11:02.03,0:11:03.16,Default,,0,0,0,,Сөйле!
Dialogue: 0,0:11:03.24,0:11:05.03,Default,,0,0,0,,А, ә...
Dialogue: 0,0:11:05.12,0:11:06.62,Default,,0,0,0,,Элита жоқ
Dialogue: 0,0:11:07.41,0:11:11.08,Default,,0,0,0,,Ұшақпен күресудің ең ысырапты әдісі.
Dialogue: 0,0:11:11.79,0:11:12.79,Default,,0,0,0,,Ұпайлар азаяды
Dialogue: 0,0:11:12.88,0:11:15.04,Default,,0,0,0,,Ранранранранранранранран…
Dialogue: 0,0:11:15.13,0:11:19.01,Default,,0,0,0,,Ал енді ұрыс-керіс болмады, мектеп өте тыныш болды.
Dialogue: 0,0:11:19.09,0:11:20.93,Default,,0,0,0,,Я~
Dialogue: 0,0:11:21.55,0:11:24.76,Default,,0,0,0,,Осылайша рухтар Отсумунның жетегінде болды.
Dialogue: 0,0:11:24.85,0:11:26.93,Default,,0,0,0,,Жан тыныштығы бар элита болыңыз
Dialogue: 0,0:11:27.01,0:11:29.85,Default,,0,0,0,,Бұдан былай ұпайлар ең жоғары болып табылады.
Dialogue: 0,0:11:29.93,0:11:31.98,Default,,0,0,0,,Мен сізге элитаның элитасын көрсетейін.
Dialogue: 0,0:11:32.06,0:11:32.90,Default,,0,0,0,,Не!
Dialogue: 0,0:11:33.52,0:11:35.69,Default,,0,0,0,,Тенкасу академиясы осында.
Dialogue: 0,0:11:35.77,0:11:37.86,Default,,0,0,0,,Супер элиталық класс!
Dialogue: 0,0:11:37.94,0:11:39.65,Default,,0,0,0,,Он сынып!
Dialogue: 0,0:11:40.40,0:11:43.03,Default,,0,0,0,,Бұл сынып па?
Dialogue: 0,0:11:43.11,0:11:44.66,Default,,0,0,0,,20 миллион ұпай бар.
Dialogue: 0,0:11:44.74,0:11:46.28,Default,,0,0,0,,Бұл Сейтоның сыныбы.
Dialogue: 0,0:11:46.37,0:11:48.24,Default,,0,0,0,,20 миллион?
Dialogue: 0,0:11:48.33,0:11:49.20,Default,,0,0,0,,Жазу саласы бойынша
Dialogue: 0,0:11:49.29,0:11:52.16,Default,,0,0,0,,Мен көп энергия жинап жатырмын.
Dialogue: 0,0:11:52.25,0:11:54.13,Default,,0,0,0,,Мұнда, сынып деңгейіне қарамастан—
Dialogue: 0,0:11:54.21,0:11:57.13,Default,,0,0,0,,Бұл сіздің талантыңызды кеңейтетін білімге арналған сынып.
Dialogue: 0,0:11:57.21,0:11:58.05,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:58.13,0:12:00.01,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:12:00.09,0:12:02.97,Default,,0,0,0,,Қайырлы таң! Бүгін элита үшін тағы бір тамаша күн.
Dialogue: 0,0:12:03.84,0:12:05.47,Default,,0,0,0,,Иә? Чизио!
Dialogue: 0,0:12:05.55,0:12:06.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.47,0:12:10.60,Default,,0,0,0,,Тағы бала күту? Төраға Сейто, адамдар өте көп~
Dialogue: 0,0:12:10.68,0:12:12.10,Default,,0,0,0,,Агеха мырза
Dialogue: 0,0:12:12.18,0:12:13.56,Default,,0,0,0,,Бұл адам да 10-сыныпта ма?
Dialogue: 0,0:12:13.64,0:12:15.15,Default,,0,0,0,,Жол~y
Dialogue: 0,0:12:15.23,0:12:16.36,Default,,0,0,0,,Жол?
Dialogue: 0,0:12:16.44,0:12:17.31,Default,,0,0,0,,Вей
Dialogue: 0,0:12:17.40,0:12:18.27,Default,,0,0,0,,Weweweeeee
Dialogue: 0,0:12:18.36,0:12:21.11,Default,,0,0,0,,Жол жолы жол жолы
Dialogue: 0,0:12:21.19,0:12:22.95,Default,,0,0,0,,Біз сөйлесіп жатырмыз...
Dialogue: 0,0:12:23.03,0:12:25.99,Default,,0,0,0,,Бұл кішкентай нәрсе не? Бұл шынымен де күлкілі
Dialogue: 0,0:12:26.07,0:12:27.95,Default,,0,0,0,,Сеито Төраға! Ах
Dialogue: 0,0:12:28.03,0:12:31.12,Default,,0,0,0,,Бұл сенің сыныбың емес.
Dialogue: 0,0:12:31.20,0:12:34.42,Default,,0,0,0,,А... Мен қазір сотқа қабылданатын баланы қабылдап жатырмын.
Dialogue: 0,0:12:35.04,0:12:37.38,Default,,0,0,0,,Сасуга-кунның 1 элиталық ұпайы бар!
Dialogue: 0,0:12:37.46,0:12:39.42,Default,,0,0,0,,Менде 1 ұпай бар!
Dialogue: 0,0:12:39.50,0:12:40.34,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:12:40.42,0:12:41.88,Default,,0,0,0,,1?
Dialogue: 0,0:12:41.96,0:12:43.13,Default,,0,0,0,,қанша тұрады?
Dialogue: 0,0:12:43.22,0:12:44.30,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:44.38,0:12:47.60,Default,,0,0,0,,Ичи Рей Рей Нии Хачи
Dialogue: 0,0:12:47.68,0:12:49.22,Default,,0,0,0,,Уау~ 1 иен - 1 иен
Dialogue: 0,0:12:49.31,0:12:52.68,Default,,0,0,0,,Бұл! Мұндай ұпайға қалай қол жеткізесіз?
Dialogue: 0,0:12:52.77,0:12:54.52,Default,,0,0,0,,Жай ғана қалыпты өмір сүру
Dialogue: 0,0:12:54.60,0:12:55.44,Default,,0,0,0,,Әдетте?
Dialogue: 0,0:12:55.52,0:12:59.36,Default,,0,0,0,,Қалыпты түрде оқыңыз және қалыпты ұпайлары бар барлық пәндер бойынша тест жасаңыз.
Dialogue: 0,0:13:00.11,0:13:01.82,Default,,0,0,0,,Әдетте 10 минут бұрын әрекет етеді
Dialogue: 0,0:13:01.90,0:13:03.78,Default,,0,0,0,,Әдетте таза
Dialogue: 0,0:13:03.86,0:13:05.74,Default,,0,0,0,,Әдетте таңқаларлық...
Dialogue: 0,0:13:05.82,0:13:08.87,Default,,0,0,0,,Сасуга-кун – Тенкасу академиясының шаңы.
Dialogue: 0,0:13:09.49,0:13:12.04,Default,,0,0,0,,Мен одан да солай ләззат аламын.
Dialogue: 0,0:13:12.12,0:13:13.75,Default,,0,0,0,,Оны қалыпты түрде тоқтатыңыз.
Dialogue: 0,0:13:13.83,0:13:14.83,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:13:14.91,0:13:16.29,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:13:16.37,0:13:18.88,Default,,0,0,0,,О? не? сол көздер
Dialogue: 0,0:13:18.96,0:13:20.21,Default,,0,0,0,,Көздер?
Dialogue: 0,0:13:20.29,0:13:22.09,Default,,0,0,0,,Яббе! Мен масканы жоғалтып алдым!
Dialogue: 0,0:13:22.17,0:13:24.47,Default,,0,0,0,,Бұл өте көп...
Dialogue: 0,0:13:24.55,0:13:25.55,Default,,0,0,0,,Вей
Dialogue: 0,0:13:27.76,0:13:30.30,Default,,0,0,0,,Элита жоқ!
Dialogue: 0,0:13:30.39,0:13:32.47,Default,,0,0,0,,Отсумун, бұл шынымен де тітіркендіргіш.
Dialogue: 0,0:13:32.56,0:13:34.93,Default,,0,0,0,,Ұпайлар азайса да...
Dialogue: 0,0:13:35.02,0:13:38.27,Default,,0,0,0,,Агеха-санда 90 миллион ұпай бар.
Dialogue: 0,0:13:38.35,0:13:39.94,Default,,0,0,0,,2 мектеп жақсы
Dialogue: 0,0:13:40.02,0:13:41.23,Default,,0,0,0,,Жол
Dialogue: 0,0:13:42.32,0:13:44.61,Default,,0,0,0,,Учи математика академиясының турнирі және
Dialogue: 0,0:13:44.69,0:13:47.70,Default,,0,0,0,,Мен ашкөздік турнирін жеңдім
Dialogue: 0,0:13:47.78,0:13:49.74,Default,,0,0,0,,Хаха!
Dialogue: 0,0:13:49.82,0:13:52.66,Default,,0,0,0,,Мен World Junior 2 Renpa турнирінде де семсерлесумен айналыстым.
Dialogue: 0,0:13:52.74,0:13:54.29,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:13:54.37,0:13:56.62,Default,,0,0,0,,Мен макияж жасау арқылы ғана ұпай алдым.
Dialogue: 0,0:13:56.71,0:13:59.75,Default,,0,0,0,,Сіз элитасыз, солай ма?
Dialogue: 0,0:13:59.83,0:14:01.59,Default,,0,0,0,,Дұрыс... дұрыс.
Dialogue: 0,0:14:01.67,0:14:03.17,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:14:03.25,0:14:05.76,Default,,0,0,0,,Уа! Тырнақтар! Қазірдің өзінде
Dialogue: 0,0:14:06.47,0:14:07.97,Default,,0,0,0,,Сіз оны бірден ала аласыз.
Dialogue: 0,0:14:08.05,0:14:09.89,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:14:09.97,0:14:11.55,Default,,0,0,0,,Адамдардың әр түрі бар...
Dialogue: 0,0:14:11.64,0:14:13.76,Default,,0,0,0,,Эй, бұл Чишио-чан.
Dialogue: 0,0:14:14.60,0:14:17.23,Default,,0,0,0,,Марафон бойынша әлем чемпионатының жеңімпазы
Dialogue: 0,0:14:17.31,0:14:18.85,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:14:18.94,0:14:20.65,Default,,0,0,0,,Бұл қулық
Dialogue: 0,0:14:20.73,0:14:22.36,Default,,0,0,0,,Жоқ... Мен бас тарттым.
Dialogue: 0,0:14:22.36,0:14:23.19,Default,,0,0,0,,Жоқ... Мен бас тарттым.
Dialogue: 0,0:14:22.36,0:14:23.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.27,0:14:26.69,Default,,0,0,0,,Менің аяғым... жарақаттанды, енді жүгіре алмаймын.
Dialogue: 0,0:14:26.78,0:14:27.61,Default,,0,0,0,,Сіз Шизукудың жерлеуіне келмедіңіз бе?
Dialogue: 0,0:14:27.70,0:14:29.32,Default,,0,0,0,,Өте нашар
Dialogue: 0,0:14:29.41,0:14:31.45,Default,,0,0,0,,Бұрын бұл он топ болатын.
Dialogue: 0,0:14:31.45,0:14:32.58,Default,,0,0,0,,Бұрын бұл он топ болатын.
Dialogue: 0,0:14:31.45,0:14:32.58,Default,,0,0,0,,Марлей әскері емес.
Dialogue: 0,0:14:33.28,0:14:34.54,Default,,0,0,0,,Қазір ше?
Dialogue: 0,0:14:35.45,0:14:36.37,Default,,0,0,0,,Бұл сынып!
Dialogue: 0,0:14:36.45,0:14:37.50,Default,,0,0,0,,Иә? Жақсы! Жақсы!
Dialogue: 0,0:14:37.58,0:14:40.46,Default,,0,0,0,,О! Бен Бен Бен Бен Бен Бен Бен Бен Бен Бен Бен Бен Бен
Dialogue: 0,0:14:40.54,0:14:42.88,Default,,0,0,0,,Бұл жанды.
Dialogue: 0,0:14:42.96,0:14:46.34,Default,,0,0,0,,Бұл теріс ұпайлары бар сынып.
Dialogue: 0,0:14:46.42,0:14:48.22,Default,,0,0,0,,Өтейік, бұл «шұбар топ»
Dialogue: 0,0:14:48.30,0:14:49.13,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:14:49.22,0:14:52.18,Default,,0,0,0,,Уау, шынымен! Гакуенчо иә
Dialogue: 0,0:14:52.26,0:14:53.80,Default,,0,0,0,,Хорея Паши! (ысырма дыбысы)
Dialogue: 0,0:14:53.89,0:14:56.31,Default,,0,0,0,,Иә Гачон Ахахахха...!
Dialogue: 0,0:14:56.39,0:14:58.64,Default,,0,0,0,,О? Кішкентай балалар!
Dialogue: 0,0:14:59.18,0:15:01.81,Default,,0,0,0,,Сәл күте тұрыңыз, сізде бас пен дене ақауы жоқ па?
Dialogue: 0,0:15:01.90,0:15:02.86,Default,,0,0,0,,Аха~
Dialogue: 0,0:15:02.94,0:15:03.77,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:15:03.86,0:15:05.36,Default,,0,0,0,,Жоқ! Ол ағып кетті
Dialogue: 0,0:15:05.44,0:15:06.73,Default,,0,0,0,,Чачака Чачака Чачака
Dialogue: 0,0:15:06.82,0:15:11.07,Default,,0,0,0,,Орейо~ Бүгін таңертең мен Шибафуда жүрдім.
Dialogue: 0,0:15:11.16,0:15:13.95,Default,,0,0,0,,Мен жуынатын бөлмеге барып, суды жудым.
Dialogue: 0,0:15:14.03,0:15:16.16,Default,,0,0,0,,Уа! Бұл керемет!
Dialogue: 0,0:15:16.24,0:15:17.62,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:15:17.70,0:15:19.91,Default,,0,0,0,,Мен жаман екенімді мойындаймын!
Dialogue: 0,0:15:20.00,0:15:22.58,Default,,0,0,0,,Сіз өз өміріңізді теріс жолмен өткізіп жатырсыз...
Dialogue: 0,0:15:22.67,0:15:23.58,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:23.67,0:15:25.54,Default,,0,0,0,,Төраға Сейто, солай ма?
Dialogue: 0,0:15:25.63,0:15:26.50,Default,,0,0,0,,Иә
Dialogue: 0,0:15:26.59,0:15:31.01,Default,,0,0,0,,Бірақ мен жүгіргенді мүлдем ұнатпаймын.
Dialogue: 0,0:15:31.09,0:15:33.47,Default,,0,0,0,,Минус 12 000?
Dialogue: 0,0:15:33.55,0:15:38.56,Default,,0,0,0,,Төраға Сейто да жұмысшы болып жұмыс істеуге мәжбүр болды...
Dialogue: 0,0:15:38.64,0:15:40.02,Default,,0,0,0,,Қолдану үшін…
Dialogue: 0,0:15:40.73,0:15:43.94,Default,,0,0,0,,Бірақ Касугумидің бәрі өте жақсы адамдар.
Dialogue: 0,0:15:44.02,0:15:46.86,Default,,0,0,0,,Эй, ол не дейді?
Dialogue: 0,0:15:46.94,0:15:48.03,Default,,0,0,0,,Түнгі шық ауруы!
Dialogue: 0,0:15:48.11,0:15:49.28,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:15:49.36,0:15:52.45,Default,,0,0,0,,Ал, қоқыс кез келген әлемге келеді.
Dialogue: 0,0:15:52.53,0:15:53.61,Default,,0,0,0,,(Чисионың азабы)
Dialogue: 0,0:15:53.70,0:15:55.37,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:15:55.87,0:15:57.74,Default,,0,0,0,,Мм... Директор
Dialogue: 0,0:15:57.83,0:15:59.24,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:15:59.33,0:16:01.41,Default,,0,0,0,,Осы сынаққа тіркелу кезінде
Dialogue: 0,0:16:01.50,0:16:04.00,Default,,0,0,0,,Егер сіз көп элиталық ұпай жинасаңыз...
Dialogue: 0,0:16:05.08,0:16:08.21,Default,,0,0,0,,Тенкасу академиясына түсуге болатыным рас па?
Dialogue: 0,0:16:08.30,0:16:12.26,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,0:16:12.34,0:16:13.18,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:13.26,0:16:16.72,Default,,0,0,0,,Хмм... жарайды, тым болмаса бар күшіңізді салып көріңіз.
Dialogue: 0,0:16:16.80,0:16:17.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:18.26,0:16:20.56,Default,,0,0,0,,Төраға Сейто, қалғанын сізге қалдырамын.
Dialogue: 0,0:16:20.64,0:16:21.52,Default,,0,0,0,,Иә
Dialogue: 0,0:16:21.60,0:16:24.14,Default,,0,0,0,,Қош болдың киіктің қытығы
Dialogue: 0,0:16:24.23,0:16:24.81,Default,,0,0,0,,Сәлем! о?
Dialogue: 0,0:16:24.81,0:16:25.69,Default,,0,0,0,,Сәлем! о? (нүкте дыбысы төмендейді)
Dialogue: 0,0:16:25.69,0:16:26.48,Default,,0,0,0,,(құлаған нүктелердің дыбысы)
Dialogue: 0,0:16:26.56,0:16:28.11,Default,,0,0,0,,Мен бұл жолы жеңілемін бе...
Dialogue: 0,0:16:28.19,0:16:30.32,Default,,0,0,0,,Ей, «Тоқутай өмір» деген не?
Dialogue: 0,0:16:30.40,0:16:34.91,Default,,0,0,0,,А, мен Тенкасу академиясына мерзімінен бұрын түсе аламын.
Dialogue: 0,0:16:34.99,0:16:35.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:35.91,0:16:38.45,Default,,0,0,0,,Сондықтан барлығы элиталық ұпайларды пайдаланады...
Dialogue: 0,0:16:38.53,0:16:39.58,Default,,0,0,0,,Бо Чан ше?
Dialogue: 0,0:16:43.12,0:16:44.50,Default,,0,0,0,,3 сағат
Dialogue: 0,0:16:44.58,0:16:46.54,Default,,0,0,0,,Әлі таң ба?
Dialogue: 0,0:16:46.63,0:16:48.96,Default,,0,0,0,,Бұл сағат бұзылған.
Dialogue: 0,0:16:49.59,0:16:51.55,Default,,0,0,0,,Тым жақындамаңыз
Dialogue: 0,0:16:52.55,0:16:53.92,Default,,0,0,0,,Вампирлер болады!
Dialogue: 0,0:16:54.01,0:16:56.39,Default,,0,0,0,,Ех! вампир? Эх!
Dialogue: 0,0:16:56.47,0:16:58.93,Default,,0,0,0,,Бұл қан емес.
Dialogue: 0,0:16:59.01,0:17:00.43,Default,,0,0,0,,Менің есегімді сор!
Dialogue: 0,0:17:00.51,0:17:03.10,Default,,0,0,0,,Ооо, сенің есегің...
Dialogue: 0,0:17:03.18,0:17:06.15,Default,,0,0,0,,Көшеңді сормай, шығарасың!
Dialogue: 0,0:17:06.23,0:17:07.19,Default,,0,0,0,,Пурипури Пурипури!
Dialogue: 0,0:17:07.27,0:17:09.40,Default,,0,0,0,,Оны шығармаңыз! Ұпайлар төмендейді!
Dialogue: 0,0:17:12.36,0:17:14.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:14.90,0:17:17.41,Default,,0,0,0,,Джугио басталғалы жатыр! Асығыңыз!
Dialogue: 0,0:17:17.49,0:17:19.49,Default,,0,0,0,,Не? Хой~и
Dialogue: 0,0:17:24.33,0:17:26.46,Default,,0,0,0,,Баршаңызға қайырлы таң
Dialogue: 0,0:17:26.54,0:17:28.92,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:17:29.00,0:17:32.13,Default,,0,0,0,,Бұл Сумико Вакино, сіздің досыңыз.
Dialogue: 0,0:17:32.21,0:17:34.34,Default,,0,0,0,,Түсінбесең, Отсумуннан сұра...
Dialogue: 0,0:17:34.42,0:17:35.84,Default,,0,0,0,,Мұғалім! (Вакино) Иә?
Dialogue: 0,0:17:35.92,0:17:40.39,Default,,0,0,0,,Маған осы ақылсыз сезімді қалай тоқтатуға болатынын айтыңызшы!
Dialogue: 0,0:17:40.47,0:17:42.89,Default,,0,0,0,,Мүмкін болса, бөлмеде екеуміз ғана болайық.
Dialogue: 0,0:17:42.97,0:17:43.81,Default,,0,0,0,,О.
Dialogue: 0,0:17:43.89,0:17:45.73,Default,,0,0,0,,О
Dialogue: 0,0:17:45.81,0:17:46.64,Default,,0,0,0,,Уау
Dialogue: 0,0:17:46.73,0:17:49.31,Default,,0,0,0,,Киошидің таңдауы жоқ
Dialogue: 0,0:17:49.40,0:17:51.77,Default,,0,0,0,,Сен не істеп жатырсың, Шинносуке?
Dialogue: 0,0:17:52.44,0:17:54.49,Default,,0,0,0,,Жөтелді дұрыстап алайық.
Dialogue: 0,0:17:54.57,0:17:55.49,Default,,0,0,0,,Хой
Dialogue: 0,0:17:56.70,0:17:59.20,Default,,0,0,0,,Енді сабақты бастайық.
Dialogue: 0,0:17:59.28,0:18:01.66,Default,,0,0,0,,О? Ал Сумико мырза ше?
Dialogue: 0,0:18:01.74,0:18:05.08,Default,,0,0,0,,Отсумун барлық джугионы басқарады.
Dialogue: 0,0:18:05.16,0:18:06.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:06.83,0:18:09.37,Default,,0,0,0,,Маған Ола Сумико мырза ұнайды~
Dialogue: 0,0:18:09.46,0:18:11.13,Default,,0,0,0,,Тыныш отырайық.
Dialogue: 0,0:18:11.21,0:18:13.42,Default,,0,0,0,,Бірінші кезең ағылшын тілі.
Dialogue: 0,0:18:14.92,0:18:16.17,Default,,0,0,0,,Мәселе
Dialogue: 0,0:18:16.26,0:18:18.55,Default,,0,0,0,,Мұны ағылшын тілінде қалай айтасыз?
Dialogue: 0,0:18:18.63,0:18:19.72,Default,,0,0,0,,Масао мырза
Dialogue: 0,0:18:19.80,0:18:20.97,Default,,0,0,0,,Иә, у...
Dialogue: 0,0:18:21.05,0:18:23.72,Default,,0,0,0,,Иә! Мм...Рингоо~
Dialogue: 0,0:18:23.81,0:18:25.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:25.72,0:18:27.02,Default,,0,0,0,,Казама мырза?
Dialogue: 0,0:18:27.10,0:18:28.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:28.19,0:18:30.31,Default,,0,0,0,,Бұл Appo!
Dialogue: 0,0:18:30.40,0:18:32.77,Default,,0,0,0,,Бұл өте дәмді көрінеді
Dialogue: 0,0:18:32.86,0:18:34.48,Default,,0,0,0,,(көтерілген нүктелер дыбысы)
Dialogue: 0,0:18:34.57,0:18:36.44,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:36.53,0:18:38.07,Default,,0,0,0,,Бұл таңдаулы жауап болды.
Dialogue: 0,0:18:38.15,0:18:39.45,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:39.53,0:18:42.28,Default,,0,0,0,,Кадзама-kun English Tokudamonne
Dialogue: 0,0:18:42.37,0:18:43.74,Default,,0,0,0,,Сіздің де қолыңыздан келеді!
Dialogue: 0,0:18:43.83,0:18:45.70,Default,,0,0,0,,Aupfo~
Dialogue: 0,0:18:46.20,0:18:47.04,Default,,0,0,0,,Ар...
Dialogue: 0,0:18:47.12,0:18:49.50,Default,,0,0,0,,Бұл Алып Баба, солай ма?
Dialogue: 0,0:18:49.58,0:18:50.96,Default,,0,0,0,,Бұл ақымақ~ Хахаха...
Dialogue: 0,0:18:50.96,0:18:52.33,Default,,0,0,0,,Бұл ақымақ~ Хахаха...
Dialogue: 0,0:18:50.96,0:18:52.33,Default,,0,0,0,,(құлаған нүктелердің дыбысы)
Dialogue: 0,0:18:52.33,0:18:52.42,Default,,0,0,0,,(Нүктелердің дыбысы төмендейді)
Dialogue: 0,0:18:52.42,0:18:53.42,Default,,0,0,0,,(Казама-кун) Иә? Ах
Dialogue: 0,0:18:53.50,0:18:56.88,Default,,0,0,0,,Қойдың ортасында қыдырып жүргені - элита емес!
Dialogue: 0,0:18:56.96,0:18:58.30,Default,,0,0,0,,Хой
Dialogue: 0,0:18:58.38,0:19:00.09,Default,,0,0,0,,Мұны көргенде уайымдайтындар да
Dialogue: 0,0:19:00.18,0:19:01.43,Default,,0,0,0,,Элита жоқ
Dialogue: 0,0:19:01.51,0:19:02.85,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:02.93,0:19:04.39,Default,,0,0,0,,Келесі сұрақ
Dialogue: 0,0:19:02.93,0:19:04.39,Default,,0,0,0,,Ха, көбейсе де...
Dialogue: 0,0:19:04.39,0:19:04.47,Default,,0,0,0,,Ха, көбейсе де...
Dialogue: 0,0:19:04.47,0:19:05.39,Default,,0,0,0,,Ха, көбейсе де...
Dialogue: 0,0:19:04.47,0:19:05.39,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:19:05.39,0:19:05.47,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:19:05.47,0:19:06.31,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:19:05.47,0:19:06.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:06.39,0:19:07.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:07.35,0:19:09.81,Default,,0,0,0,,Ол таңғы ас ішіп отыр
Dialogue: 0,0:19:09.89,0:19:10.73,Default,,0,0,0,,—«Золушка» сұлулық салонында басқа біреумен алмастырылған болса—
Dialogue: 0,0:19:10.81,0:19:12.48,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:19:12.56,0:19:13.69,Default,,0,0,0,,Келесі сұрақ
Dialogue: 0,0:19:13.77,0:19:16.23,Default,,0,0,0,,Иә! Бұл апельсин!
Dialogue: 0,0:19:16.32,0:19:18.15,Default,,0,0,0,,Фуфуфу (көтерілген нүктелердің дыбысы)
Dialogue: 0,0:19:16.32,0:19:18.15,Default,,0,0,0,,Элита!
Dialogue: 0,0:19:26.20,0:19:28.16,Default,,0,0,0,,Менің ішім тегіс!
Dialogue: 0,0:19:28.25,0:19:30.16,Default,,0,0,0,,Бұл жерде!
Dialogue: 0,0:19:30.66,0:19:33.83,Default,,0,0,0,,Бұл жай ғана Казама-кун емес пе?
Dialogue: 0,0:19:33.92,0:19:37.50,Default,,0,0,0,,Бұл көптеген элиталық ұпайларды талап етеді.
Dialogue: 0,0:19:37.59,0:19:40.30,Default,,0,0,0,,Ұпайларды мектептегі түскі асты өзгерту үшін пайдалануға болады...
Dialogue: 0,0:19:40.38,0:19:41.84,Default,,0,0,0,,Он топ, қараңдар.
Dialogue: 0,0:19:41.93,0:19:42.97,Default,,0,0,0,,Не? а?
Dialogue: 0,0:19:43.05,0:19:44.55,Default,,0,0,0,,Бұл Франция Рюри!
Dialogue: 0,0:19:44.64,0:19:45.93,Default,,0,0,0,,Хааа~
Dialogue: 0,0:19:46.97,0:19:48.89,Default,,0,0,0,,Бұл мейрамхана сияқты.
Dialogue: 0,0:19:50.10,0:19:52.19,Default,,0,0,0,,Бо... Шаян
Dialogue: 0,0:19:52.27,0:19:54.27,Default,,0,0,0,,Шабу-шабу?
Dialogue: 0,0:19:54.81,0:19:58.61,Default,,0,0,0,,1. Бұл тек Ино Сейтоға арналған арнайы түскі ас.
Dialogue: 0,0:19:58.69,0:19:59.78,Default,,0,0,0,,Хааа~
Dialogue: 0,0:19:59.86,0:20:02.74,Default,,0,0,0,,Элита бәрінен де жақсы~
Dialogue: 0,0:20:02.82,0:20:03.74,Default,,0,0,0,,Амммм...
Dialogue: 0,0:20:03.82,0:20:06.99,Default,,0,0,0,,Дәлірек айтсақ, біздің тағамдарымыз ше?
Dialogue: 0,0:20:07.08,0:20:08.20,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:20:09.62,0:20:12.33,Default,,0,0,0,,Ах! Кешіріңіз, мен ұмытып кеттім!
Dialogue: 0,0:20:12.41,0:20:13.96,Default,,0,0,0,,Ұпайлар дәл осы жерде!
Dialogue: 0,0:20:14.04,0:20:14.88,Default,,0,0,0,,Не? о?
Dialogue: 0,0:20:14.96,0:20:17.84,Default,,0,0,0,,Эй, менде карри наны бар!
Dialogue: 0,0:20:17.92,0:20:20.80,Default,,0,0,0,,Уау! Мұнда не! Уф...
Dialogue: 0,0:20:20.88,0:20:22.47,Default,,0,0,0,,Ұпайлар азайған кезде
Dialogue: 0,0:20:22.55,0:20:25.09,Default,,0,0,0,,Мен осы жерден түскі ас ішуім керек!
Dialogue: 0,0:20:25.18,0:20:28.76,Default,,0,0,0,,Жастық шақтың ең танымал белгісі...
Dialogue: 0,0:20:28.85,0:20:30.81,Default,,0,0,0,,Якисоба наны!
Dialogue: 0,0:20:31.81,0:20:34.39,Default,,0,0,0,,О! Маған якисоба наны қатты ұнайды
Dialogue: 0,0:20:34.48,0:20:35.69,Default,,0,0,0,,Уа!
Dialogue: 0,0:20:35.77,0:20:38.15,Default,,0,0,0,,Бұл мүмкін емес, былай~
Dialogue: 0,0:20:38.23,0:20:40.65,Default,,0,0,0,,Масао-кун Шин-чан! Жарайды ма?
Dialogue: 0,0:20:41.44,0:20:42.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.36,0:20:43.61,Default,,0,0,0,,Маған бір ой келді!
Dialogue: 0,0:20:43.70,0:20:46.07,Default,,0,0,0,,Уау! Не?
Dialogue: 0,0:20:46.16,0:20:48.62,Default,,0,0,0,,Айналмалы найзағай!
Dialogue: 0,0:20:48.70,0:20:50.37,Default,,0,0,0,,Якисоба... Нан!
Dialogue: 0,0:20:50.45,0:20:51.87,Default,,0,0,0,,Якисоба... Нан!
Dialogue: 0,0:20:51.95,0:20:53.58,Default,,0,0,0,,Якисоба... Нан!
Dialogue: 0,0:20:55.12,0:20:57.04,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:20:57.13,0:20:58.75,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:20:58.84,0:21:00.21,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:00.30,0:21:02.38,Default,,0,0,0,,Иә! Сіз жасадыңыз
Dialogue: 0,0:21:02.46,0:21:04.68,Default,,0,0,0,,Якисоба наны да жақсы.
Dialogue: 0,0:21:04.76,0:21:08.68,Default,,0,0,0,,Ха, көптен бері қызық көрмедім!
Dialogue: 0,0:21:08.76,0:21:10.14,Default,,0,0,0,,Йойо!
Dialogue: 0,0:21:10.22,0:21:13.10,Default,,0,0,0,,Балалар сендерде жақсы заттар бар.
Dialogue: 0,0:21:13.18,0:21:14.85,Default,,0,0,0,,Мына нанды маған бер!
Dialogue: 0,0:21:14.94,0:21:15.85,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:15.94,0:21:16.98,Default,,0,0,0,,Сәлем, балалар!
Dialogue: 0,0:21:17.06,0:21:18.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:18.27,0:21:20.61,Default,,0,0,0,,Бұл жақсы зерттеу!
Dialogue: 0,0:21:20.69,0:21:22.40,Default,,0,0,0,,Қатаң Генджи жоқ Йо!
Dialogue: 0,0:21:22.48,0:21:24.36,Default,,0,0,0,,О... Ахх! Ахх!
Dialogue: 0,0:21:24.44,0:21:27.11,Default,,0,0,0,,Уау! Эй, жібер!
Dialogue: 0,0:21:27.20,0:21:28.03,Default,,0,0,0,,Бваааа
Dialogue: 0,0:21:28.12,0:21:30.20,Default,,0,0,0,,Ах... Иә!
Dialogue: 0,0:21:30.28,0:21:31.12,Default,,0,0,0,,Темера!
Dialogue: 0,0:21:31.20,0:21:33.33,Default,,0,0,0,,Мен саған айтайын~
Dialogue: 0,0:21:33.41,0:21:34.41,Default,,0,0,0,,Ах! Ававуа!
Dialogue: 0,0:21:34.50,0:21:35.87,Default,,0,0,0,,Эх, ха... ха ха...
Dialogue: 0,0:21:35.96,0:21:37.37,Default,,0,0,0,,Чишио-чан!
Dialogue: 0,0:21:37.46,0:21:40.34,Default,,0,0,0,,Жарайды, қаш!
Dialogue: 0,0:21:40.42,0:21:44.13,Default,,0,0,0,,Чишио-чан, мен жүгіре алмаймын, себебі аяғым жарақаттанды!
Dialogue: 0,0:21:44.21,0:21:45.30,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:21:46.55,0:21:50.43,Default,,0,0,0,,Хе хе хе, кел, Пан, зұлым йо!
Dialogue: 0,0:21:50.51,0:21:53.06,Default,,0,0,0,,Эй (йоё) рахмет саған
Dialogue: 0,0:21:53.14,0:21:54.64,Default,,0,0,0,,Иә? А?
Dialogue: 0,0:21:54.73,0:21:56.85,Default,,0,0,0,,Якисоба, иә!
Dialogue: 0,0:21:58.77,0:22:00.61,Default,,0,0,0,,Ммм...
Dialogue: 0,0:22:00.69,0:22:01.82,Default,,0,0,0,,Шин-чан?
Dialogue: 0,0:22:01.90,0:22:03.98,Default,,0,0,0,,Якисоба нанына якисоба болмаса ше?
Dialogue: 0,0:22:04.07,0:22:05.69,Default,,0,0,0,,Бұл жай ғана нан!
Dialogue: 0,0:22:05.78,0:22:07.57,Default,,0,0,0,,Өйткені мен: «Маған нан бер» дедім.
Dialogue: 0,0:22:07.65,0:22:08.95,Default,,0,0,0,,Әзіл!
Dialogue: 0,0:22:09.91,0:22:11.16,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:22:11.24,0:22:12.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:14.41,0:22:16.00,Default,,0,0,0,,Банчо!
Dialogue: 0,0:22:16.08,0:22:17.96,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:22:18.04,0:22:21.88,Default,,0,0,0,,Тенкасу Гакуэн 33-ші Банчо
Dialogue: 0,0:22:21.96,0:22:23.92,Default,,0,0,0,,Ханкоги Киритару
Dialogue: 0,0:22:24.00,0:22:26.88,Default,,0,0,0,,Әлсіз адамдардан балық...
Dialogue: 0,0:22:26.97,0:22:29.05,Default,,0,0,0,,Бұл бейбақтардың істеп жүргені!
Dialogue: 0,0:22:29.13,0:22:31.51,Default,,0,0,0,,Сондай-ақ... Кешіріңіз!
Dialogue: 0,0:22:32.72,0:22:33.72,Default,,0,0,0,,О~
Dialogue: 0,0:22:33.81,0:22:35.68,Default,,0,0,0,,Сен мұны не үшін киіп жүрсің?
Dialogue: 0,0:22:35.77,0:22:37.02,Default,,0,0,0,,Шин-чан! (йоё) тақырып
Dialogue: 0,0:22:37.10,0:22:38.64,Default,,0,0,0,,Банчоға не істеп жатырсың?
Dialogue: 0,0:22:39.39,0:22:40.81,Default,,0,0,0,,Әңгімелесіңдер және төбелесіңдер!
Dialogue: 0,0:22:40.90,0:22:42.15,Default,,0,0,0,,Жоқ Эли…
Dialogue: 0,0:22:42.23,0:22:43.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:44.44,0:22:45.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:47.24,0:22:50.07,Default,,0,0,0,,Мұнда кішкентай шыбындар тітіркендіреді.
Dialogue: 0,0:22:53.12,0:22:54.33,Default,,0,0,0,,Уау
Dialogue: 0,0:22:55.08,0:22:57.20,Default,,0,0,0,,33-ші буын...
Dialogue: 0,0:22:57.29,0:22:59.00,Default,,0,0,0,,Тенкасу академиясының жетекшісі
Dialogue: 0,0:22:59.08,0:23:02.71,Default,,0,0,0,,Сол темір маска ұрпақтан-ұрпаққа беріледі.
Dialogue: 0,0:23:02.79,0:23:04.71,Default,,0,0,0,,Бұл өте нашар болды.
Dialogue: 0,0:23:09.97,0:23:12.09,Default,,0,0,0,,Қош бол ұстаз
Dialogue: 0,0:23:12.18,0:23:13.85,Default,,0,0,0,,Сонымен қатар актриса Эми де келеді. Ә? Шынымен бе!?
Dialogue: 0,0:23:13.93,0:23:16.56,Default,,0,0,0,,Эй, мен Инокориді оқығым келеді!
Dialogue: 0,0:23:16.64,0:23:18.43,Default,,0,0,0,,Мұғаліммен жалғыз ~
Dialogue: 0,0:23:18.52,0:23:19.35,Default,,0,0,0,,О.
Dialogue: 0,0:23:19.43,0:23:21.52,Default,,0,0,0,,Жүр, тез Риоға барайық.
Dialogue: 0,0:23:21.60,0:23:23.31,Default,,0,0,0,,Мен шыдамсызмын
Dialogue: 0,0:23:23.40,0:23:24.90,Default,,0,0,0,,Қош бол~ Н~м~м
Dialogue: 0,0:23:24.98,0:23:26.78,Default,,0,0,0,,Тағы да
Dialogue: 0,0:23:27.40,0:23:28.40,Default,,0,0,0,,Хехе
Dialogue: 0,0:23:29.32,0:23:32.32,Default,,0,0,0,,Хмм, ақыры басталды.
Dialogue: 0,0:23:32.41,0:23:33.32,Default,,0,0,0,,Не?
Dialogue: 0,0:23:33.41,0:23:35.20,Default,,0,0,0,,Бұл біздің жастық шағымыз!
Dialogue: 0,0:23:35.78,0:23:36.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:38.29,0:23:40.16,Default,,0,0,0,,А... Әй?
Dialogue: 0,0:23:40.25,0:23:41.87,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:23:41.96,0:23:43.21,Default,,0,0,0,,Үлкен ме?
Dialogue: 0,0:23:43.29,0:23:44.71,Default,,0,0,0,,Мен таң қалдым~
Dialogue: 0,0:23:44.79,0:23:47.13,Default,,0,0,0,,Бұл мені таң қалдырды!
Dialogue: 0,0:23:47.21,0:23:48.30,Default,,0,0,0,,Бірақ~
Dialogue: 0,0:23:48.38,0:23:49.67,Default,,0,0,0,,Бұл өнер
Dialogue: 0,0:23:50.47,0:23:53.14,Default,,0,0,0,,Гейджуцу да элитаның нормасы.
Dialogue: 0,0:23:53.22,0:23:55.76,Default,,0,0,0,,О, керемет!
Dialogue: 0,0:23:55.85,0:23:57.60,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:23:57.68,0:23:59.18,Default,,0,0,0,,Бұл шынайы
Dialogue: 0,0:23:59.27,0:24:00.56,Default,,0,0,0,,Ол қозғала бастаған сияқты...
Dialogue: 0,0:24:00.64,0:24:04.69,Default,,0,0,0,,Сондықтан өнер қозғалады...
Dialogue: 0,0:24:04.77,0:24:06.52,Default,,0,0,0,,Иә! Гашер!
Dialogue: 0,0:24:06.61,0:24:08.82,Default,,0,0,0,,Кя! Апыр-ай!
Dialogue: 0,0:24:08.90,0:24:11.24,Default,,0,0,0,,(Касукабе қорғаныс күштерінің айқайы)
Dialogue: 0,0:24:15.24,0:24:17.12,Default,,0,0,0,,Қабан! Бо-бо-бо-бо…
Dialogue: 0,0:24:17.91,0:24:19.04,Default,,0,0,0,,Боа…
Dialogue: 0,0:24:21.96,0:24:22.79,Default,,0,0,0,,Бо…
Dialogue: 0,0:24:22.87,0:24:24.33,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,0:24:24.42,0:24:25.92,Default,,0,0,0,,Уф! Уф
Dialogue: 0,0:24:26.79,0:24:28.88,Default,,0,0,0,,Бұл жем емес
Dialogue: 0,0:24:29.63,0:24:30.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:31.55,0:24:32.84,Default,,0,0,0,,По…
Dialogue: 0,0:24:34.47,0:24:35.47,Default,,0,0,0,,Хмм
Dialogue: 0,0:24:37.01,0:24:40.93,Default,,0,0,0,,Барлығы осы жерде болды! Мен оны қазірдің өзінде іздедім
Dialogue: 0,0:24:41.02,0:24:43.23,Default,,0,0,0,,Мм... бұл адам кім? иә?
Dialogue: 0,0:24:43.31,0:24:45.98,Default,,0,0,0,,Ах, Роро мырза, биология кафедрасының меңгерушісі.
Dialogue: 0,0:24:46.06,0:24:47.19,Default,,0,0,0,,Тәубе
Dialogue: 0,0:24:47.27,0:24:50.78,Default,,0,0,0,,Мен тірі табиғатты жақсы көремін, сондықтан мен осы орманда тұрамын.
Dialogue: 0,0:24:50.86,0:24:52.15,Default,,0,0,0,,Не, орманда?
Dialogue: 0,0:24:54.36,0:24:56.11,Default,,0,0,0,,Адамдар жиіркенішті.
Dialogue: 0,0:24:56.20,0:24:58.74,Default,,0,0,0,,Ол жабайы хикикомори.
Dialogue: 0,0:24:58.83,0:25:00.41,Default,,0,0,0,,Бұл сәл басқаша, солай емес пе?
Dialogue: 0,0:25:00.49,0:25:01.62,Default,,0,0,0,,А...
Dialogue: 0,0:25:04.66,0:25:07.00,Default,,0,0,0,,Ем... А, жоқ, жоқ...
Dialogue: 0,0:25:07.08,0:25:09.92,Default,,0,0,0,,Шин Чан неше крокет жейді?
Dialogue: 0,0:25:11.05,0:25:13.92,Default,,0,0,0,,Көрдім, сенің ағаң мұнда жоқ.
Dialogue: 0,0:25:14.01,0:25:15.43,Default,,0,0,0,,Хмм, жоқ, жоқ.
Dialogue: 0,0:25:16.76,0:25:17.64,Default,,0,0,0,,Нохара мырза
Dialogue: 0,0:25:17.72,0:25:20.01,Default,,0,0,0,,О, Казама-кунның анасы
Dialogue: 0,0:25:20.10,0:25:22.39,Default,,0,0,0,,Жарайды, Казама-кун.
Dialogue: 0,0:25:22.47,0:25:24.60,Default,,0,0,0,,Бастауыш сыныпқа қабылдау емтихандарын тапсырасыз ба?
Dialogue: 0,0:25:24.68,0:25:26.35,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:25:26.44,0:25:29.56,Default,,0,0,0,,Тенкасу Гакуэн де Коухоның бірі.
Dialogue: 0,0:25:31.19,0:25:34.28,Default,,0,0,0,,Бастауыш мектептің айырмашылығы бар ма?
Dialogue: 0,0:25:34.36,0:25:37.24,Default,,0,0,0,,Я, біз жақсы доспыз, бірге бола аламыз...
Dialogue: 0,0:25:38.11,0:25:39.70,Default,,0,0,0,,Мүмкін бұл қазір ғана шығар.
Dialogue: 0,0:25:41.70,0:25:44.12,Default,,0,0,0,,Сонда да тыныш.
Dialogue: 0,0:25:44.20,0:25:47.37,Default,,0,0,0,,Шин-чан, сен жалғыз болған шығарсың.
Dialogue: 0,0:25:48.21,0:25:49.67,Default,,0,0,0,,Кун
Dialogue: 0,0:25:53.42,0:25:55.05,Default,,0,0,0,,Хохой! Ахаха
Dialogue: 0,0:25:55.92,0:25:57.26,Default,,0,0,0,,Ой... қараңдаршы!
Dialogue: 0,0:25:57.34,0:25:58.93,Default,,0,0,0,,Ааа! сәуле!
Dialogue: 0,0:25:59.01,0:26:00.55,Default,,0,0,0,,Бұл! Уау~
Dialogue: 0,0:26:00.64,0:26:02.35,Default,,0,0,0,,Аха~ Бох!
Dialogue: 0,0:26:02.43,0:26:04.18,Default,,0,0,0,,Ах! Ой!
Dialogue: 0,0:26:04.27,0:26:07.64,Default,,0,0,0,,Бала сияқты әрекет етуді қойып, тез ұйықтаңыз!
Dialogue: 0,0:26:07.73,0:26:09.90,Default,,0,0,0,,Элиталық ұпайлар төмендейді, солай ма?
Dialogue: 0,0:26:09.98,0:26:13.82,Default,,0,0,0,,Рио бөлмесі мен дәретхана сияқты жеке орындар
Dialogue: 0,0:26:13.90,0:26:15.86,Default,,0,0,0,,Отсумун қарап тұрған жоқ!
Dialogue: 0,0:26:15.94,0:26:17.28,Default,,0,0,0,,Сол себепті...
Dialogue: 0,0:26:17.36,0:26:18.86,Default,,0,0,0,,Ертең де ерте... Уау
Dialogue: 0,0:26:19.57,0:26:21.87,Default,,0,0,0,,Жоқ, менің бөксем сырғып жатыр...
Dialogue: 0,0:26:21.95,0:26:23.24,Default,,0,0,0,,Мм...!
Dialogue: 0,0:26:25.75,0:26:26.71,Default,,0,0,0,,Сіз мұны істедіңіз бе?
Dialogue: 0,0:26:26.79,0:26:27.87,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:26:27.96,0:26:31.67,Default,,0,0,0,,(сыбырлаған дауыс)
Dialogue: 0,0:26:39.97,0:26:44.51,Default,,0,0,0,,♪ «Тенкасу академиясының мектеп әні»
Dialogue: 0,0:26:50.10,0:26:54.77,Default,,0,0,0,,♪ Асқақ армандарымды жүрегіме жақын ұстаймын
Dialogue: 0,0:26:54.86,0:26:59.53,Default,,0,0,0,,♪ Атақтылардың көздері жыпылықтайды
Dialogue: 0,0:26:59.61,0:27:03.78,Default,,0,0,0,,♪ Жаһандық басқаруды құру
Dialogue: 0,0:27:03.87,0:27:08.62,Default,,0,0,0,,♪ Advance ~көп~
Dialogue: 0,0:27:08.71,0:27:13.13,Default,,0,0,0,,♪ Іргетасқа қадам басу~
Dialogue: 0,0:27:13.21,0:27:23.14,Default,,0,0,0,,♪ Біріктіру Касукабе академиясы
Dialogue: 0,0:27:26.01,0:27:28.60,Default,,0,0,0,,Барлығың орындадыңдар ма?
Dialogue: 0,0:27:28.68,0:27:30.27,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,0:27:30.35,0:27:32.35,Default,,0,0,0,,Экшн Маска дайын!
Dialogue: 0,0:27:32.44,0:27:33.27,Default,,0,0,0,,Вах ха ха ха…
Dialogue: 0,0:27:33.27,0:27:34.36,Default,,0,0,0,,Вах ха ха ха…
Dialogue: 0,0:27:33.27,0:27:34.36,Default,,0,0,0,,Сіз көп жұмыс істедіңіз!
Dialogue: 0,0:27:34.44,0:27:34.98,Default,,0,0,0,,Вах ха ха…
Dialogue: 0,0:27:34.98,0:27:36.11,Default,,0,0,0,,Вах ха ха…
Dialogue: 0,0:27:34.98,0:27:36.11,Default,,0,0,0,,Егер бұл орын алса
Dialogue: 0,0:27:36.11,0:27:36.19,Default,,0,0,0,,Вах ха ха…
Dialogue: 0,0:27:36.19,0:27:37.03,Default,,0,0,0,,Вах ха ха…
Dialogue: 0,0:27:36.19,0:27:37.03,Default,,0,0,0,,Элиталық ұпайлар айтарлықтай көтеріледі.
Dialogue: 0,0:27:37.03,0:27:39.15,Default,,0,0,0,,Элиталық ұпайлар айтарлықтай көтеріледі.
Dialogue: 0,0:27:39.24,0:27:41.91,Default,,0,0,0,,Мені балам десең де.
Dialogue: 0,0:27:41.99,0:27:42.82,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:27:43.82,0:27:46.62,Default,,0,0,0,,«Камен» деп канжимен жаздым.
Dialogue: 0,0:27:46.70,0:27:48.04,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:27:49.33,0:27:50.46,Default,,0,0,0,,Элита жоқ
Dialogue: 0,0:27:50.54,0:27:52.42,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:27:53.04,0:27:54.88,Default,,0,0,0,,Бұл «тақта беті»
Dialogue: 0,0:27:54.96,0:27:55.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:55.96,0:27:57.63,Default,,0,0,0,,Сіз канжиді қате жаздыңыз ба?
Dialogue: 0,0:27:57.71,0:27:59.67,Default,,0,0,0,,Казама-кун сондай сүйкімді
Dialogue: 0,0:27:59.76,0:28:02.34,Default,,0,0,0,,Әрекет Итамен!
Dialogue: 0,0:28:02.43,0:28:04.30,Default,,0,0,0,,Вахахаха...!
Dialogue: 0,0:28:04.39,0:28:05.39,Default,,0,0,0,,А, иттамен, иттамен, иттамен~
Dialogue: 0,0:28:05.39,0:28:06.64,Default,,0,0,0,,А, иттамен, иттамен, иттамен~
Dialogue: 0,0:28:05.39,0:28:06.64,Default,,0,0,0,,Сондықтан мен сол болашақты өзгерту үшін өткенге ораламын.
Dialogue: 0,0:28:06.64,0:28:07.26,Default,,0,0,0,,А, иттамен, иттамен, иттамен~
Dialogue: 0,0:28:10.98,0:28:13.90,Default,,0,0,0,,Өткен аптада Масуо-кун қобалжыды.
Dialogue: 0,0:28:13.98,0:28:16.40,Default,,0,0,0,,Өтірік! Басқа вампир?
Dialogue: 0,0:28:16.48,0:28:18.36,Default,,0,0,0,,А, мен шаршадым.
Dialogue: 0,0:28:18.44,0:28:20.44,Default,,0,0,0,,Түскі асқа дейін не істейсің?
Dialogue: 0,0:28:20.53,0:28:22.82,Default,,0,0,0,,Аха, дайындалайық!
Dialogue: 0,0:28:22.90,0:28:24.86,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:28:24.95,0:28:27.66,Default,,0,0,0,,Ертеңгі сабаққа оқу.
Dialogue: 0,0:28:27.74,0:28:28.95,Default,,0,0,0,,Иә~
Dialogue: 0,0:28:29.04,0:28:31.83,Default,,0,0,0,,Біз сынақты қабылдаудамыз.
Dialogue: 0,0:28:31.91,0:28:33.29,Default,,0,0,0,,Сондықтан!
Dialogue: 0,0:28:33.37,0:28:35.17,Default,,0,0,0,,Директор да солай айтты!
Dialogue: 0,0:28:35.25,0:28:37.71,Default,,0,0,0,,Егер сіз сынаққа қабылдансаңыз да жоғары элиталық ұпайларыңыз болса
Dialogue: 0,0:28:37.79,0:28:40.21,Default,,0,0,0,,Тенкасу академиясына түсуге болады!
Dialogue: 0,0:28:40.30,0:28:41.42,Default,,0,0,0,,Сонда... мынаны қара!
Dialogue: 0,0:28:42.13,0:28:43.26,Default,,0,0,0,,Чирлидер!
Dialogue: 0,0:28:43.34,0:28:45.14,Default,,0,0,0,,Ой, қызық сияқты!
Dialogue: 0,0:28:45.22,0:28:47.60,Default,,0,0,0,,Кеттік! Хохой!
Dialogue: 0,0:28:45.22,0:28:47.60,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:28:48.64,0:28:52.56,Default,,0,0,0,,Эй Казама-кун, сен не айттың?
Dialogue: 0,0:28:53.69,0:28:56.56,Default,,0,0,0,,Бұл ештеңе емес...
Dialogue: 0,0:29:00.61,0:29:02.07,Default,,0,0,0,,Сіз бір нәрседен шаршадыңыз ба?
Dialogue: 0,0:29:02.15,0:29:02.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:03.07,0:29:04.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:05.07,0:29:06.41,Default,,0,0,0,,Сіздің жүзіңізден
Dialogue: 0,0:29:06.49,0:29:09.99,Default,,0,0,0,,Мен бір нәрсеге алаңдағанда, мен дәнекерледім.
Dialogue: 0,0:29:10.08,0:29:11.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:12.08,0:29:13.54,Default,,0,0,0,,Элита болғыңыз келе ме?
Dialogue: 0,0:29:13.62,0:29:14.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:15.33,0:29:17.42,Default,,0,0,0,,Сіз элита болғыңыз келеді, солай ма?
Dialogue: 0,0:29:18.63,0:29:19.88,Default,,0,0,0,,Мен болғым келеді
Dialogue: 0,0:29:19.96,0:29:22.92,Default,,0,0,0,,Элита болудың ешқандай төте жолы жоқ.
Dialogue: 0,0:29:23.01,0:29:23.84,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:29:23.92,0:29:26.89,Default,,0,0,0,,Элита болудың жолы бар
Dialogue: 0,0:29:26.97,0:29:27.84,Default,,0,0,0,,Сахна артында!
Dialogue: 0,0:29:27.93,0:29:28.80,Default,,0,0,0,,Тыныш
Dialogue: 0,0:29:28.89,0:29:32.77,Default,,0,0,0,,Ұпайларды оңай көбейтетін айла бар.
Dialogue: 0,0:29:32.85,0:29:33.81,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:29:33.89,0:29:34.73,Default,,0,0,0,,Иә
Dialogue: 0,0:29:34.81,0:29:38.06,Default,,0,0,0,,Иә! Мен де бәріне айтамын.
Dialogue: 0,0:29:38.15,0:29:39.31,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:29:39.40,0:29:40.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:40.32,0:29:43.82,Default,,0,0,0,,Тек сіз сияқты босаңсыған адамдар
Dialogue: 0,0:29:43.90,0:29:46.20,Default,,0,0,0,,Оны үйретуге болады.
Dialogue: 0,0:29:46.28,0:29:48.74,Default,,0,0,0,,А... тек мен бе?
Dialogue: 0,0:29:48.82,0:29:49.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:49.74,0:29:51.45,Default,,0,0,0,,Бар, кеттік!
Dialogue: 0,0:29:51.53,0:29:52.62,Default,,0,0,0,,Бар, кеттік!
Dialogue: 0,0:29:52.70,0:29:57.75,Default,,0,0,0,,Казама Тору-кун Демалу – уақытты босқа өткізу
Dialogue: 0,0:29:57.83,0:30:00.42,Default,,0,0,0,,Элита болудың құпия жолымен жүргіңіз келсе
Dialogue: 0,0:30:00.50,0:30:03.34,Default,,0,0,0,,Маған кез келген уақытта қоңырау шалыңыз
Dialogue: 0,0:30:06.17,0:30:07.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:08.64,0:30:09.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:13.01,0:30:14.31,Default,,0,0,0,,Иә
Dialogue: 0,0:30:16.81,0:30:21.02,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:30:21.11,0:30:22.57,Default,,0,0,0,,Иегіңізді көтермеңіз
Dialogue: 0,0:30:22.65,0:30:25.19,Default,,0,0,0,,Дұрыс мінез-құлық үшін қолдарыңызды қатты шайқаңыз
Dialogue: 0,0:30:25.86,0:30:30.20,Default,,0,0,0,,Енді жүгіруге болмайды!
Dialogue: 0,0:30:31.16,0:30:32.20,Default,,0,0,0,,Иә? ау
Dialogue: 0,0:30:32.28,0:30:34.24,Default,,0,0,0,,Эй Казама-кун
Dialogue: 0,0:30:34.33,0:30:35.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:35.25,0:30:36.16,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:30:36.25,0:30:38.62,Default,,0,0,0,,Бұл қызық~
Dialogue: 0,0:30:39.67,0:30:40.58,Default,,0,0,0,,Бұл медициналық тексеру.
Dialogue: 0,0:30:40.67,0:30:41.75,Default,,0,0,0,,(синго дыбысы)
Dialogue: 0,0:30:41.75,0:30:42.59,Default,,0,0,0,,(синго дыбысы)
Dialogue: 0,0:30:41.75,0:30:42.59,Default,,0,0,0,,Әй?
Dialogue: 0,0:30:42.59,0:30:42.67,Default,,0,0,0,,(Шингоу дыбысы)
Dialogue: 0,0:30:42.67,0:30:44.59,Default,,0,0,0,,(синго дыбысы)
Dialogue: 0,0:30:42.67,0:30:44.59,Default,,0,0,0,,Сіз не істеп жатырсыз? Асықшы!
Dialogue: 0,0:30:44.67,0:30:45.55,Default,,0,0,0,,Е...
Dialogue: 0,0:30:45.63,0:30:47.47,Default,,0,0,0,,Элиталық ұпайлар қайтадан төмендейді!
Dialogue: 0,0:30:47.55,0:30:48.51,Default,,0,0,0,,Ой
Dialogue: 0,0:30:49.26,0:30:50.47,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:30:52.30,0:30:53.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:53.22,0:30:54.93,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:30:55.64,0:30:57.18,Default,,0,0,0,,Сеигё фуну
Dialogue: 0,0:30:57.89,0:30:58.89,Default,,0,0,0,,Уау, Казама-кун!
Dialogue: 0,0:30:58.98,0:31:01.27,Default,,0,0,0,,Шинчан!
Dialogue: 0,0:31:01.35,0:31:03.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:03.36,0:31:05.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:05.32,0:31:06.19,Default,,0,0,0,,Разряд дегеніміз не? Жиналған электр энергиясы ағып жатыр...
Dialogue: 0,0:31:06.19,0:31:08.40,Default,,0,0,0,,Разряд дегеніміз не? Жиналған электр энергиясы ағып жатыр...
Dialogue: 0,0:31:06.19,0:31:08.40,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:31:08.49,0:31:11.41,Default,,0,0,0,,Сәлем! Балалар, не істеп жатырсыңдар?
Dialogue: 0,0:31:11.49,0:31:14.24,Default,,0,0,0,,Ой! Ой, тоқтат! Келме!
Dialogue: 0,0:31:14.33,0:31:15.37,Default,,0,0,0,,Тоқта! (Шинносуке/Казама-кун) Уау!
Dialogue: 0,0:31:16.49,0:31:17.33,Default,,0,0,0,,Әй?
Dialogue: 0,0:31:18.08,0:31:20.67,Default,,0,0,0,,О ~ Сумико мырза ~
Dialogue: 0,0:31:20.75,0:31:22.63,Default,,0,0,0,,Қол! Қолымды жібер!
Dialogue: 0,0:31:22.71,0:31:25.09,Default,,0,0,0,,Уау! (Казама-кун) Бұл мүмкін емес!
Dialogue: 0,0:31:25.67,0:31:27.01,Default,,0,0,0,,Он… бе… с…
Dialogue: 0,0:31:27.09,0:31:28.55,Default,,0,0,0,,Фу~ (Казама-кун) Ахии~
Dialogue: 0,0:31:30.09,0:31:32.47,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:31:32.55,0:31:35.43,Default,,0,0,0,,Казама-кун! Нохара-кун! Жарайды ма?
Dialogue: 0,0:31:35.51,0:31:38.14,Default,,0,0,0,,Ах... Сумико мырза...
Dialogue: 0,0:31:38.22,0:31:39.23,Default,,0,0,0,,Itata... (Вакино) Не?
Dialogue: 0,0:31:39.31,0:31:41.98,Default,,0,0,0,,Ол «Нохара-кун» орнына «Шин-чан» деп аталады.
Dialogue: 0,0:31:42.06,0:31:42.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:43.86,0:31:46.86,Default,,0,0,0,,Кибутсу Сонкай және мектеп серуені
Dialogue: 0,0:31:46.94,0:31:48.82,Default,,0,0,0,,...
Dialogue: 0,0:31:50.61,0:31:52.28,Default,,0,0,0,,Элита жоқ!
Dialogue: 0,0:31:53.07,0:31:54.78,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:31:54.87,0:31:58.95,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:31:59.04,0:32:02.42,Default,,0,0,0,,(Сейтоның сөйлейтін дауысы)
Dialogue: 0,0:32:02.50,0:32:06.88,Default,,0,0,0,,Жарайды...ертең тағы да бар күшімізді салайық!
Dialogue: 0,0:32:08.67,0:32:11.63,Default,,0,0,0,,Ой! Нанның құлағы: Шаяндарды көріп отырып жеу
Dialogue: 0,0:32:11.72,0:32:12.88,Default,,0,0,0,,Дәмі краб сияқты!
Dialogue: 0,0:32:12.97,0:32:14.89,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:32:17.47,0:32:19.10,Default,,0,0,0,,Бұл рас! Мен айтайын деп жатырмын
Dialogue: 0,0:32:19.18,0:32:19.77,Default,,0,0,0,,Мүмкін мен данышпан шығармын~
Dialogue: 0,0:32:19.77,0:32:21.85,Default,,0,0,0,,Мүмкін мен данышпан шығармын~
Dialogue: 0,0:32:19.77,0:32:21.85,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:32:21.85,0:32:23.06,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:32:26.11,0:32:27.40,Default,,0,0,0,,Сәлем! Way~y
Dialogue: 0,0:32:27.48,0:32:28.98,Default,,0,0,0,,Ей! (Казама-кун) Уф!
Dialogue: 0,0:32:29.07,0:32:30.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:32:30.78,0:32:33.70,Default,,0,0,0,,Қазірдің өзінде! Барлығымыз дұрыс оқиық!
Dialogue: 0,0:32:33.78,0:32:35.91,Default,,0,0,0,,Неге?
Dialogue: 0,0:32:35.99,0:32:38.91,Default,,0,0,0,,Бұл элита болу орны!
Dialogue: 0,0:32:38.99,0:32:41.91,Default,,0,0,0,,Бірақ біз сынақ негізінде тіркелдік...
Dialogue: 0,0:32:42.00,0:32:45.88,Default,,0,0,0,,Сонымен! Егер сіз оны жақсы меңгерсеңіз, сіз шынымен мектепке түсе аласыз.
Dialogue: 0,0:32:46.63,0:32:48.34,Default,,0,0,0,,Барлығымыз қолымыздан келгеннің бәрін жасайық!
Dialogue: 0,0:32:48.42,0:32:51.63,Default,,0,0,0,,Эй, мен мұнда бітірдім.
Dialogue: 0,0:32:51.71,0:32:54.30,Default,,0,0,0,,Үйге барып, Әрекет Кәменді көргім келеді.
Dialogue: 0,0:32:54.88,0:32:56.09,Default,,0,0,0,,Ондай сөздерді айтпа!
Dialogue: 0,0:32:56.18,0:32:57.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:32:58.51,0:32:59.72,Default,,0,0,0,,Ахан~н
Dialogue: 0,0:32:59.81,0:33:00.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:00.77,0:33:03.64,Default,,0,0,0,,Тоору-чан да жалқау емес.
Dialogue: 0,0:33:03.73,0:33:05.31,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:33:05.40,0:33:09.27,Default,,0,0,0,,Ммм~ Казама-кун да үйге қайтқысы келеді, солай ма?
Dialogue: 0,0:33:09.36,0:33:11.11,Default,,0,0,0,,Аму (Казама-кун) Ах
Dialogue: 0,0:33:11.19,0:33:12.53,Default,,0,0,0,,Шокоби?
Dialogue: 0,0:33:12.61,0:33:15.03,Default,,0,0,0,,Сіз тағамдар әкеле алмайсыз!
Dialogue: 0,0:33:15.74,0:33:18.66,Default,,0,0,0,,Анам оны мен үшін жасырып сақтаған.
Dialogue: 0,0:33:18.74,0:33:20.87,Default,,0,0,0,,Күткендей, бұл Оланың анасы~
Dialogue: 0,0:33:20.95,0:33:23.41,Default,,0,0,0,,Казама-кун да тамақ іше ме?
Dialogue: 0,0:33:23.50,0:33:24.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:24.41,0:33:26.42,Default,,0,0,0,,Уайымдамаңыз! Уау
Dialogue: 0,0:33:26.50,0:33:27.75,Default,,0,0,0,,Мынадай нәрсе...! Біраз
Dialogue: 0,0:33:27.83,0:33:31.21,Default,,0,0,0,,Оны әкелме! Апыр-ай!
Dialogue: 0,0:33:33.80,0:33:35.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:36.43,0:33:38.76,Default,,0,0,0,,Бұл сұмдық, Казама-кун!
Dialogue: 0,0:33:38.85,0:33:40.51,Default,,0,0,0,,Қайсысы нашар!
Dialogue: 0,0:33:40.60,0:33:42.77,Default,,0,0,0,,Екеуің де тоқтаңдар!
Dialogue: 0,0:33:42.85,0:33:45.73,Default,,0,0,0,,Менің анам ешқашан ереже бұзбайды!
Dialogue: 0,0:33:45.81,0:33:48.44,Default,,0,0,0,,Шинносукенің анасы жақсы емес!
Dialogue: 0,0:33:48.52,0:33:50.90,Default,,0,0,0,,Гррр… Хм!
Dialogue: 0,0:33:50.98,0:33:54.69,Default,,0,0,0,,Оланың анасы 3-данбара мен Обенпи екені рас.
Dialogue: 0,0:33:54.78,0:33:59.16,Default,,0,0,0,,Мен күнде жалқау жүретін үлкен құланмын.
Dialogue: 0,0:33:59.24,0:34:01.41,Default,,0,0,0,,Бұл мүлдем жаман емес!
Dialogue: 0,0:34:02.49,0:34:03.87,Default,,0,0,0,,Бұл сен кінәлісің...
Dialogue: 0,0:34:04.45,0:34:06.41,Default,,0,0,0,,Бәріне сен кінәлісің
Dialogue: 0,0:34:06.91,0:34:08.42,Default,,0,0,0,,Бұл үлкен мәселе!
Dialogue: 0,0:34:08.50,0:34:12.67,Default,,0,0,0,,Мен тіпті осындай жерге әкелінгеніме өте қуаныштымын!
Dialogue: 0,0:34:12.75,0:34:15.63,Default,,0,0,0,,Менің таңдаулы өміріме араласпа!
Dialogue: 0,0:34:15.72,0:34:18.59,Default,,0,0,0,,Элиталар мүлдем қызықсыз!
Dialogue: 0,0:34:18.68,0:34:21.05,Default,,0,0,0,,Қызықсыз Кайдзин Казама!
Dialogue: 0,0:34:21.14,0:34:24.18,Default,,0,0,0,,Әрекет сәулесі! Бибібибі…
Dialogue: 0,0:34:24.27,0:34:28.27,Default,,0,0,0,,Дәл осылай өмір бойы ақымақ болып өт!
Dialogue: 0,0:34:28.35,0:34:30.98,Default,,0,0,0,,Мен сенімен біттім!
Dialogue: 0,0:34:31.06,0:34:32.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:32.40,0:34:34.94,Default,,0,0,0,,Керемет! Бүгін түсінесіз.
Dialogue: 0,0:34:36.03,0:34:38.70,Default,,0,0,0,,Ха, мен сергіп қалдым...
Dialogue: 0,0:34:38.78,0:34:40.70,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,0:34:40.78,0:34:42.91,Default,,0,0,0,,Мен Казама-кунды жек көремін!
Dialogue: 0,0:34:42.99,0:34:45.37,Default,,0,0,0,,Кет!
Dialogue: 0,0:34:51.33,0:34:53.96,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:34:57.67,0:35:00.18,Default,,0,0,0,,Осы сағатта не істедің?
Dialogue: 0,0:35:01.76,0:35:05.14,Default,,0,0,0,,Мен... элита болғым келеді
Dialogue: 0,0:35:06.39,0:35:10.10,Default,,0,0,0,,Маған элита болудың құпия жолын айтыңызшы.
Dialogue: 0,0:35:12.02,0:35:13.65,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:35:18.36,0:35:20.24,Default,,0,0,0,,Шин-чан! Шин Чан!
Dialogue: 0,0:35:20.86,0:35:22.53,Default,,0,0,0,,Казама-кун кетті!
Dialogue: 0,0:35:22.62,0:35:23.99,Default,,0,0,0,,Әй?
Dialogue: 0,0:35:24.08,0:35:24.91,Default,,0,0,0,,Char!
Dialogue: 0,0:35:24.99,0:35:27.04,Default,,0,0,0,,Шинносуке!
Dialogue: 0,0:35:27.12,0:35:28.25,Default,,0,0,0,,А, тоқта! Жіберу! Апыр-ай!
Dialogue: 0,0:35:28.25,0:35:31.00,Default,,0,0,0,,А, тоқта! Жіберу! Апыр-ай!
Dialogue: 0,0:35:28.25,0:35:31.00,Default,,0,0,0,,Фуфухаха...!
Dialogue: 0,0:35:31.08,0:35:32.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:35.34,0:35:36.59,Default,,0,0,0,,А, сен...
Dialogue: 0,0:35:36.67,0:35:38.17,Default,,0,0,0,,Бұл әжетхана емес пе?
Dialogue: 0,0:35:38.26,0:35:39.55,Default,,0,0,0,,Ол жоқ еді!
Dialogue: 0,0:35:39.63,0:35:40.55,Default,,0,0,0,,Мұғалімге асығыңыз...
Dialogue: 0,0:35:40.63,0:35:41.47,Default,,0,0,0,,(Кейн дыбысы)
Dialogue: 0,0:35:41.47,0:35:42.59,Default,,0,0,0,,(Кейн дыбысы)
Dialogue: 0,0:35:41.47,0:35:42.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:42.59,0:35:44.64,Default,,0,0,0,,(Кейн дыбысы)
Dialogue: 0,0:35:48.68,0:35:50.56,Default,,0,0,0,,Вампир…
Dialogue: 0,0:35:51.14,0:35:52.77,Default,,0,0,0,,Иә! Шин Чан!
Dialogue: 0,0:35:52.85,0:35:54.23,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:35:54.31,0:35:56.27,Default,,0,0,0,,Мұғалімге айтайық!
Dialogue: 0,0:35:56.36,0:35:57.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:35:59.74,0:36:01.36,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:36:04.53,0:36:05.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:36:06.87,0:36:08.74,Default,,0,0,0,,Барлығыңыз күтіңіздер!
Dialogue: 0,0:36:11.96,0:36:15.96,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:36:19.46,0:36:20.84,Default,,0,0,0,,Казама-кун...?
Dialogue: 0,0:36:24.80,0:36:28.26,Default,,0,0,0,,Иә! Бөкседе...
Dialogue: 0,0:36:28.35,0:36:30.18,Default,,0,0,0,,Менің бөксем ашық!
Dialogue: 0,0:36:30.27,0:36:34.27,Default,,0,0,0,,(Ямабико)
Dialogue: 0,0:36:45.20,0:36:47.12,Default,,0,0,0,,Ол өлді ме...?
Dialogue: 0,0:36:47.20,0:36:49.62,Default,,0,0,0,,Казама-кун!
Dialogue: 0,0:36:49.70,0:36:50.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:36:50.62,0:36:52.00,Default,,0,0,0,,Ах! Ха...
Dialogue: 0,0:36:52.08,0:36:54.46,Default,,0,0,0,,Бұл тірі!
Dialogue: 0,0:36:54.54,0:36:55.88,Default,,0,0,0,,Жол! Казама-кун?
Dialogue: 0,0:36:55.96,0:36:57.84,Default,,0,0,0,,Жақсы (Казама-кун) Поёнг
Dialogue: 0,0:36:57.92,0:36:59.92,Default,,0,0,0,,Уау! (Казама-кун) Жер бетіндегі барлық адамдар!
Dialogue: 0,0:37:00.00,0:37:02.80,Default,,0,0,0,,Қайырлы таң Мангус!
Dialogue: 0,0:37:02.88,0:37:05.76,Default,,0,0,0,,Kyahoo! Таң атты!
Dialogue: 0,0:37:05.84,0:37:07.05,Default,,0,0,0,,Казама-кун?
Dialogue: 0,0:37:07.14,0:37:09.72,Default,,0,0,0,,Жоқ
Dialogue: 0,0:37:09.81,0:37:12.18,Default,,0,0,0,,Кәдімгі Казама-кун емес
Dialogue: 0,0:37:12.27,0:37:14.64,Default,,0,0,0,,Казама-кун ақымақ болып кетті ме?
Dialogue: 0,0:37:14.73,0:37:16.60,Default,,0,0,0,,Сіз бізді түсінесіз бе?
Dialogue: 0,0:37:16.69,0:37:19.57,Default,,0,0,0,,Иә? Хехе... Иә!
Dialogue: 0,0:37:20.19,0:37:21.53,Default,,0,0,0,,Бо-чан (Бо-чан) Бо
Dialogue: 0,0:37:21.61,0:37:22.86,Default,,0,0,0,,Масао-кун...
Dialogue: 0,0:37:22.94,0:37:24.49,Default,,0,0,0,,Нене-чан уф!
Dialogue: 0,0:37:25.11,0:37:26.99,Default,,0,0,0,,Шин-чан! Уф!
Dialogue: 0,0:37:27.57,0:37:29.45,Default,,0,0,0,,Пинг-понг Пинг-понг!
Dialogue: 0,0:37:27.57,0:37:29.45,Default,,0,0,0,,Жоқ! Казама-кун мені «Шинносуке» деп атайды!
Dialogue: 0,0:37:29.45,0:37:29.53,Default,,0,0,0,,Жоқ! Казама-кун мені «Шинносуке» деп атайды!
Dialogue: 0,0:37:29.53,0:37:31.24,Default,,0,0,0,,Жоқ! Казама-кун мені «Шинносуке» деп атайды!
Dialogue: 0,0:37:29.53,0:37:31.24,Default,,0,0,0,,Опупупу...!
Dialogue: 0,0:37:31.24,0:37:31.33,Default,,0,0,0,,Опупупу...!
Dialogue: 0,0:37:31.33,0:37:32.95,Default,,0,0,0,,Опупупу...!
Dialogue: 0,0:37:31.33,0:37:32.95,Default,,0,0,0,,Олай болса, сен жалғансың!
Dialogue: 0,0:37:33.04,0:37:35.71,Default,,0,0,0,,Мен, Тоору Казама, 5 жаста!
Dialogue: 0,0:37:35.79,0:37:37.92,Default,,0,0,0,,Натто – құрамында тұтас жасыл пияз бар түрі.
Dialogue: 0,0:37:38.00,0:37:40.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:38.00,0:37:40.00,Default,,0,0,0,,Т (Ти) ТТ ТТТ Т!
Dialogue: 0,0:37:40.00,0:37:40.09,Default,,0,0,0,,Т (Ти) ТТ ТТТ Т!
Dialogue: 0,0:37:40.09,0:37:42.00,Default,,0,0,0,,Т (Ти) ТТ ТТТ Т!
Dialogue: 0,0:37:40.09,0:37:42.00,Default,,0,0,0,,Өйткені, бұл вампир...
Dialogue: 0,0:37:42.00,0:37:42.09,Default,,0,0,0,,Өйткені, бұл вампир...
Dialogue: 0,0:37:42.09,0:37:43.30,Default,,0,0,0,,Өйткені, бұл вампир...
Dialogue: 0,0:37:42.09,0:37:43.30,Default,,0,0,0,,Ｔ ＴＴ ＴＴＴ Ｔ！
Dialogue: 0,0:37:43.30,0:37:44.84,Default,,0,0,0,,Ｔ ＴＴ ＴＴＴ Ｔ！
Dialogue: 0,0:37:44.92,0:37:46.30,Default,,0,0,0,,бірнеше ондаған күн ғана созылғанымен, біз бір толқында болдық—
Dialogue: 0,0:37:46.38,0:37:50.26,Default,,0,0,0,,Вампирлер, т.б.... Бұл мектепте қарапайым әңгіме!
Dialogue: 0,0:37:50.35,0:37:52.77,Default,,0,0,0,,Отсумунның айтып тұрғаны осы!
Dialogue: 0,0:37:50.35,0:37:52.77,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:37:52.85,0:37:55.23,Default,,0,0,0,,Жаңа ғана есек айттыңыз ба? Асс? Асс~?
Dialogue: 0,0:37:55.31,0:37:58.19,Default,,0,0,0,,Мен вампирді көрдім!
Dialogue: 0,0:37:58.27,0:37:59.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:59.73,0:38:02.61,Default,,0,0,0,,(Кейн дыбысы)
Dialogue: 0,0:38:02.69,0:38:03.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:05.70,0:38:06.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:06.61,0:38:08.24,Default,,0,0,0,,Түн болды
Dialogue: 0,0:38:08.32,0:38:11.03,Default,,0,0,0,,Мен оны анық көре алмадым, бірақ...
Dialogue: 0,0:38:11.12,0:38:12.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:12.54,0:38:17.42,Default,,0,0,0,,Келесі күні Касүгумиден келген Сузуки-кунның бейшара күйде табылды...
Dialogue: 0,0:38:17.50,0:38:18.87,Default,,0,0,0,,Гакинчо? сурет?
Dialogue: 0,0:38:18.96,0:38:22.30,Default,,0,0,0,,Қайта қош келдіңіз apple ~ қош келдіңіз манго ~
Dialogue: 0,0:38:22.38,0:38:24.01,Default,,0,0,0,,Элиталық Осиданго!
Dialogue: 0,0:38:24.01,0:38:24.84,Default,,0,0,0,,Элиталық Осиданго!
Dialogue: 0,0:38:24.01,0:38:24.84,Default,,0,0,0,,Мм...!
Dialogue: 0,0:38:24.92,0:38:26.80,Default,,0,0,0,,Түрмеге түскен дұрыс...
Dialogue: 0,0:38:26.88,0:38:28.80,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:38:28.88,0:38:31.55,Default,,0,0,0,,Осындай ақымақ әңгіме сыртқа шығып кетсе...
Dialogue: 0,0:38:32.64,0:38:35.27,Default,,0,0,0,,Тенкасу академиясының беделіне нұқсан келді!
Dialogue: 0,0:38:35.35,0:38:36.60,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:38:36.68,0:38:37.73,Default,,0,0,0,,Міне!
Dialogue: 0,0:38:37.81,0:38:39.48,Default,,0,0,0,,Мм... алтын доп
Dialogue: 0,0:38:39.56,0:38:41.23,Default,,0,0,0,,Бұл өте кең таралған...
Dialogue: 0,0:38:41.31,0:38:43.69,Default,,0,0,0,,Хехехехе~ Хэхе?
Dialogue: 0,0:38:44.48,0:38:47.70,Default,,0,0,0,,Мен қысымға көніп, элитаға айналуым керек.
Dialogue: 0,0:38:47.78,0:38:50.16,Default,,0,0,0,,Менің психикалық тепе-теңдігім бұзылды...
Dialogue: 0,0:38:50.24,0:38:51.07,Default,,0,0,0,,Хаха...
Dialogue: 0,0:38:51.16,0:38:53.12,Default,,0,0,0,,Ол әлсіз болды...
Dialogue: 0,0:38:53.78,0:38:55.58,Default,,0,0,0,,Ей, Карс, неге ашуланып қарап тұрсың?
Dialogue: 0,0:38:55.66,0:38:56.54,Default,,0,0,0,,Мм...!
Dialogue: 0,0:38:56.62,0:38:58.29,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:38:58.37,0:38:59.71,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:38:59.79,0:39:00.71,Default,,0,0,0,,Казама-кун
Dialogue: 0,0:39:00.79,0:39:02.46,Default,,0,0,0,,Аманбо де Окоринбоу де
Dialogue: 0,0:39:02.54,0:39:03.79,Default,,0,0,0,,Қыңыр көрінеді
Dialogue: 0,0:39:03.88,0:39:05.21,Default,,0,0,0,,Ол керемет жігіт!
Dialogue: 0,0:39:05.30,0:39:07.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:07.09,0:39:09.34,Default,,0,0,0,,Мен сізге ермеймін!
Dialogue: 0,0:39:09.43,0:39:11.26,Default,,0,0,0,,Жоқ, онша емес.
Dialogue: 0,0:39:11.34,0:39:12.97,Default,,0,0,0,,Мен сені мақтап тұрғаным жоқ, бірақ...
Dialogue: 0,0:39:13.05,0:39:14.43,Default,,0,0,0,,Уф... Боха! Қарғыс атсын!
Dialogue: 0,0:39:14.51,0:39:18.14,Default,,0,0,0,,Бұл кім? Акварельді кім салған?
Dialogue: 0,0:39:18.23,0:39:19.39,Default,,0,0,0,,Сіз бе? (Казама-кун) Әй?
Dialogue: 0,0:39:21.44,0:39:23.31,Default,,0,0,0,,Хмм.
Dialogue: 0,0:39:24.44,0:39:26.03,Default,,0,0,0,,Менің бөксесім... Ах!
Dialogue: 0,0:39:26.11,0:39:28.24,Default,,0,0,0,,Ой... Түсіндім!
Dialogue: 0,0:39:28.32,0:39:32.20,Default,,0,0,0,,Skyship адамы...
Dialogue: 0,0:39:33.07,0:39:34.66,Default,,0,0,0,,Бұл мектеп директоры!
Dialogue: 0,0:39:34.74,0:39:36.79,Default,,0,0,0,,Гаа!
Dialogue: 0,0:39:36.87,0:39:38.37,Default,,0,0,0,,Не...?
Dialogue: 0,0:39:38.45,0:39:40.33,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:39:40.41,0:39:44.29,Default,,0,0,0,,Мына су бөтелкесінің иісі гүл сияқты.
Dialogue: 0,0:39:45.21,0:39:46.34,Default,,0,0,0,,Иісі Окочаның иісімен бірдей.
Dialogue: 0,0:39:46.34,0:39:48.21,Default,,0,0,0,,Иісі Окочаның иісімен бірдей.
Dialogue: 0,0:39:46.34,0:39:48.21,Default,,0,0,0,,Хмм...!
Dialogue: 0,0:39:48.21,0:39:48.80,Default,,0,0,0,,Иісі Окочаның иісімен бірдей.
Dialogue: 0,0:39:48.88,0:39:51.59,Default,,0,0,0,,Не! Бұл жай ғана кездейсоқтық!
Dialogue: 0,0:39:51.68,0:39:54.72,Default,,0,0,0,,Сондай-ақ, сіз мұны ертерек жасадыңыз, солай ма?
Dialogue: 0,0:39:54.80,0:39:56.93,Default,,0,0,0,,Бұл анамның жиі жасайтын айласы.
Dialogue: 0,0:39:57.72,0:39:59.56,Default,,0,0,0,,Бірақ бұл анық~
Dialogue: 0,0:39:59.64,0:40:02.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:05.56,0:40:08.94,Default,,0,0,0,,Skyship, сен мұны істедің, солай ма?
Dialogue: 0,0:40:09.61,0:40:13.07,Default,,0,0,0,,Мен... кенет ұйқым келіп кетті...
Dialogue: 0,0:40:13.16,0:40:13.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:14.07,0:40:15.41,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:40:16.53,0:40:18.95,Default,,0,0,0,,Иә! Мені не қылмақшысың?
Dialogue: 0,0:40:19.58,0:40:21.37,Default,,0,0,0,,Ғажайып күш...
Dialogue: 0,0:40:21.46,0:40:23.21,Default,,0,0,0,,Әй, директор!
Dialogue: 0,0:40:23.29,0:40:24.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:24.21,0:40:25.54,Default,,0,0,0,,Осы балалармен
Dialogue: 0,0:40:25.63,0:40:28.42,Default,,0,0,0,,Касукабе детектив клубының басталуын қарастырайық!
Dialogue: 0,0:40:28.50,0:40:29.38,Default,,0,0,0,,Не? Бо?
Dialogue: 0,0:40:29.46,0:40:30.59,Default,,0,0,0,,Детектив клубы?
Dialogue: 0,0:40:30.67,0:40:33.76,Default,,0,0,0,,Иә! Балалардың жұмсақ бастары
Dialogue: 0,0:40:33.84,0:40:37.30,Default,,0,0,0,,Сіз бұл жынды жеңе аласыз!
Dialogue: 0,0:40:37.39,0:40:39.68,Default,,0,0,0,,Ха! Балалар не істей алады?
Dialogue: 0,0:40:39.77,0:40:41.27,Default,,0,0,0,,Су кемелерін алдау —
Dialogue: 0,0:40:41.35,0:40:44.23,Default,,0,0,0,,Сіз алдап жүрген ересек адамды таптыңыз ба?
Dialogue: 0,0:40:44.31,0:40:46.73,Default,,0,0,0,,Гах... Гохон!
Dialogue: 0,0:40:46.81,0:40:48.07,Default,,0,0,0,,Бұл жағдайда –
Dialogue: 0,0:40:50.78,0:40:53.99,Default,,0,0,0,,Касукабе детектив клубының орналасуы!
Dialogue: 0,0:40:56.12,0:40:59.45,Default,,0,0,0,,Бүгіннен бастап бұл Касукабе детектив клубының бөлмесі!
Dialogue: 0,0:41:00.87,0:41:02.91,Default,,0,0,0,,Ооо
Dialogue: 0,0:41:03.00,0:41:05.58,Default,,0,0,0,,Кітап жазу~
Dialogue: 0,0:41:05.67,0:41:08.00,Default,,0,0,0,,Көңіл күйлеріңіз тамаша!
Dialogue: 0,0:41:09.21,0:41:10.96,Default,,0,0,0,,О~
Dialogue: 0,0:41:11.05,0:41:13.13,Default,,0,0,0,,Клуб бөлмесі Клуб бөлмесі ~ Клуб бөлмесі Клуб бөлмесі ~
Dialogue: 0,0:41:13.22,0:41:14.88,Default,,0,0,0,,Клуб бөлмесі Клуб бөлмесі ~
Dialogue: 0,0:41:14.97,0:41:17.14,Default,,0,0,0,,Бұл мүлдем ақымақ және мені мазалайды.
Dialogue: 0,0:41:17.22,0:41:18.55,Default,,0,0,0,,Жақсы... бұл дұрыс.
Dialogue: 0,0:41:18.64,0:41:20.60,Default,,0,0,0,,Хехе... Иә? Нене-чан?
Dialogue: 0,0:41:20.68,0:41:24.44,Default,,0,0,0,,Нененің сури күші 2 сағаттық драмада дамыды
Dialogue: 0,0:41:24.52,0:41:26.56,Default,,0,0,0,,Оны көрсетудің уақыты келді!
Dialogue: 0,0:41:27.15,0:41:30.02,Default,,0,0,0,,Барлығына! Мен Казама-кунның Катакисін аламын!
Dialogue: 0,0:41:30.11,0:41:31.19,Default,,0,0,0,,Оу!
Dialogue: 0,0:41:31.28,0:41:34.11,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:41:34.20,0:41:35.03,Default,,0,0,0,,Оу!
Dialogue: 0,0:41:35.11,0:41:37.99,Default,,0,0,0,,Олай десеңіз, ақымақсыз.
Dialogue: 0,0:41:41.54,0:41:44.83,Default,,0,0,0,,Адамдар оқиға орнына қайта ораламыз дейді...
Dialogue: 0,0:41:44.91,0:41:46.42,Default,,0,0,0,,Ең алдымен сайтта бар күшімізді салайық!
Dialogue: 0,0:41:49.59,0:41:53.63,Default,,0,0,0,,Осы сағатта барлық зұлым адамдар өлтіріледі.
Dialogue: 0,0:41:55.55,0:41:58.22,Default,,0,0,0,,Мүмкін мені вампир әкелген шығар.
Dialogue: 0,0:41:58.30,0:42:01.14,Default,,0,0,0,,Адамның өзінен сұрап көрейік~
Dialogue: 0,0:42:01.22,0:42:02.43,Default,,0,0,0,,Казама-кун?
Dialogue: 0,0:42:02.51,0:42:03.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:03.97,0:42:05.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:05.48,0:42:06.85,Default,,0,0,0,,Казама-кун…
Dialogue: 0,0:42:06.94,0:42:08.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:08.15,0:42:10.31,Default,,0,0,0,,Мүмкін Шойбилл
Dialogue: 0,0:42:10.40,0:42:12.90,Default,,0,0,0,,Сирек қозғалады
Dialogue: 0,0:42:13.57,0:42:15.78,Default,,0,0,0,,Мен реакциядан абдырап қалдым.
Dialogue: 0,0:42:15.86,0:42:17.20,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:42:18.49,0:42:21.16,Default,,0,0,0,,Казама-кун осында жатты...
Dialogue: 0,0:42:21.24,0:42:24.33,Default,,0,0,0,,Казама-кун дымқылдап тұрды.
Dialogue: 0,0:42:24.41,0:42:26.29,Default,,0,0,0,,Кеше жаңбыр жауды ма?
Dialogue: 0,0:42:26.37,0:42:27.71,Default,,0,0,0,,Күн ашық болды ма?
Dialogue: 0,0:42:27.79,0:42:29.12,Default,,0,0,0,,Сіз зәр шығарып жатырсыз ба?
Dialogue: 0,0:42:29.21,0:42:32.75,Default,,0,0,0,,Жоқ, менің бүкіл денем суланып кетті...
Dialogue: 0,0:42:32.84,0:42:34.09,Default,,0,0,0,,Хмм…
Dialogue: 0,0:42:34.17,0:42:36.30,Default,,0,0,0,,Кейн де шырылдады, солай ма?
Dialogue: 0,0:42:36.38,0:42:37.38,Default,,0,0,0,,Садақ…
Dialogue: 0,0:42:37.47,0:42:39.30,Default,,0,0,0,,Бірақ ол сынған, солай ма?
Dialogue: 0,0:42:39.39,0:42:41.93,Default,,0,0,0,,Иә, оны бұзу туралы шешім қабылданған.
Dialogue: 0,0:42:42.01,0:42:44.06,Default,,0,0,0,,Мен әдетте кірмеймін... А?
Dialogue: 0,0:42:45.35,0:42:48.10,Default,,0,0,0,,Казама-кун, сен осы күйде құлап қалдың.
Dialogue: 0,0:42:48.19,0:42:51.02,Default,,0,0,0,,Шин-чан, бөксеңді көрсетудің қажеті жоқ...
Dialogue: 0,0:42:51.11,0:42:52.11,Default,,0,0,0,,Әй?
Dialogue: 0,0:42:55.69,0:42:56.94,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:42:58.03,0:42:59.41,Default,,0,0,0,,Екі бөкселер?
Dialogue: 0,0:42:59.49,0:43:01.37,Default,,0,0,0,,Бұл солай емес пе? (Нене-чан/Шинносуке) Иә?
Dialogue: 0,0:43:02.62,0:43:03.83,Default,,0,0,0,,О~ Ой!
Dialogue: 0,0:43:03.91,0:43:05.58,Default,,0,0,0,,33！
Dialogue: 0,0:43:06.50,0:43:08.04,Default,,0,0,0,,Мен оны қарындашпен жаздым.
Dialogue: 0,0:43:08.12,0:43:08.96,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:43:09.04,0:43:10.79,Default,,0,0,0,,Өлім туралы хабар!
Dialogue: 0,0:43:10.87,0:43:13.17,Default,,0,0,0,,Тамақтану массажы?
Dialogue: 0,0:43:13.25,0:43:15.05,Default,,0,0,0,,Өлім туралы хабар!
Dialogue: 0,0:43:15.13,0:43:17.72,Default,,0,0,0,,Казама-кун соңғы күшін салады
Dialogue: 0,0:43:17.80,0:43:20.22,Default,,0,0,0,,Сіз жазып алған анықтама!
Dialogue: 0,0:43:20.30,0:43:22.34,Default,,0,0,0,,Казама-кун тірі
Dialogue: 0,0:43:22.43,0:43:23.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:43:24.31,0:43:26.81,Default,,0,0,0,,Мұны Казама-кун жазды ма?
Dialogue: 0,0:43:26.89,0:43:28.56,Default,,0,0,0,,Ой... Уау.
Dialogue: 0,0:43:28.64,0:43:30.60,Default,,0,0,0,,А... а... мен оны білдім!
Dialogue: 0,0:43:30.69,0:43:32.48,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:43:33.31,0:43:34.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:41.03,0:43:42.87,Default,,0,0,0,,Мм...!
Dialogue: 0,0:43:42.95,0:43:44.45,Default,,0,0,0,,Гуарг! Гвааааааааааааааааааааааааааааааа...
Dialogue: 0,0:43:44.45,0:43:45.83,Default,,0,0,0,,Гуарг! Гвааааааааааааааааааааааааааааааа...
Dialogue: 0,0:43:44.45,0:43:45.83,Default,,0,0,0,,Казама-кун!
Dialogue: 0,0:43:46.79,0:43:48.12,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:43:48.20,0:43:50.54,Default,,0,0,0,,Гваг гваг...!
Dialogue: 0,0:43:50.62,0:43:51.54,Default,,0,0,0,,Мен оны жоғалтып алдым...
Dialogue: 0,0:43:51.62,0:43:54.34,Default,,0,0,0,,Бұл өте қиын болса керек...
Dialogue: 0,0:43:54.42,0:43:55.25,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:43:55.34,0:43:58.71,Default,,0,0,0,,Оны Казама-кун жазғанына күмән жоқ...
Dialogue: 0,0:43:58.80,0:44:01.05,Default,,0,0,0,,Қандай да бір мағына болуы керек.
Dialogue: 0,0:44:01.13,0:44:03.05,Default,,0,0,0,,33…
Dialogue: 0,0:44:03.14,0:44:04.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:04.30,0:44:07.68,Default,,0,0,0,,33… Ал бөкселердегі тістер…
Dialogue: 0,0:44:07.77,0:44:11.39,Default,,0,0,0,,Ах! Мен оны түсіндім!
Dialogue: 0,0:44:11.48,0:44:14.81,Default,,0,0,0,,Паралила паралила буон буон...
Dialogue: 0,0:44:14.90,0:44:18.07,Default,,0,0,0,,Мына кісіні қарашы, темір масканы!
Dialogue: 0,0:44:18.15,0:44:19.49,Default,,0,0,0,,Хамф!
Dialogue: 0,0:44:19.57,0:44:21.36,Default,,0,0,0,,«33-ші» Банчо!
Dialogue: 0,0:44:21.45,0:44:25.53,Default,,0,0,0,,Ауыз бөлігі ирек, соны шайнадым.
Dialogue: 0,0:44:25.62,0:44:27.33,Default,,0,0,0,,Менеджер сорғыш!
Dialogue: 0,0:44:27.91,0:44:28.95,Default,,0,0,0,,Ол кіріп кететін сияқты
Dialogue: 0,0:44:29.04,0:44:32.00,Default,,0,0,0,,Шоконы тауып алсам ғой...
Dialogue: 0,0:44:32.08,0:44:33.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:44:34.21,0:44:35.29,Default,,0,0,0,,Не? Уху
Dialogue: 0,0:44:36.00,0:44:37.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:37.67,0:44:39.00,Default,,0,0,0,,Ахх...
Dialogue: 0,0:44:39.09,0:44:40.13,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:44:40.21,0:44:41.67,Default,,0,0,0,,Сәлем! Мен алмаймын... алмаймын!
Dialogue: 0,0:44:41.67,0:44:42.55,Default,,0,0,0,,Сәлем! Мен алмаймын... алмаймын!
Dialogue: 0,0:44:41.67,0:44:42.55,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,0:44:42.55,0:44:42.63,Default,,0,0,0,,Сәлем! Мен алмаймын... алмаймын!
Dialogue: 0,0:44:42.63,0:44:43.47,Default,,0,0,0,,Сәлем! Мен алмаймын... алмаймын!
Dialogue: 0,0:44:42.63,0:44:43.47,Default,,0,0,0,,Масао-кун!
Dialogue: 0,0:44:43.55,0:44:45.34,Default,,0,0,0,,Жоқ! Мен қатты толқып тұрмын! Жоқ, жоқ, жоқ, жоқ...
Dialogue: 0,0:44:43.55,0:44:45.34,Default,,0,0,0,,Бұл Казама-кун үшін!
Dialogue: 0,0:44:45.43,0:44:46.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:46.51,0:44:48.43,Default,,0,0,0,,Сәлем! Сіз ақымақ!
Dialogue: 0,0:44:48.51,0:44:50.89,Default,,0,0,0,,Бұл Маса, күріш шары!
Dialogue: 0,0:44:50.97,0:44:52.48,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:44:52.56,0:44:53.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:44:53.48,0:44:55.85,Default,,0,0,0,,Анда? Эй Пии!
Dialogue: 0,0:44:55.94,0:44:58.32,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:44:58.40,0:45:01.32,Default,,0,0,0,,Сенің тамырың жақсы емес пе?
Dialogue: 0,0:45:01.40,0:45:04.28,Default,,0,0,0,,О! Эй! Уф...
Dialogue: 0,0:45:04.36,0:45:06.37,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:45:06.37,0:45:07.87,Default,,0,0,0,,Сәлем! Жарайды ма?
Dialogue: 0,0:45:07.87,0:45:07.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:45:07.95,0:45:08.83,Default,,0,0,0,,Сәлем! Масао-кун тамаша жұмыс
Dialogue: 0,0:45:08.83,0:45:09.62,Default,,0,0,0,,Өте жақсы жұмыс Масао-кун
Dialogue: 0,0:45:09.70,0:45:11.83,Default,,0,0,0,,А, мен сенің ақымақ екеніңді көріп тұрмын.
Dialogue: 0,0:45:11.91,0:45:12.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:14.79,0:45:17.42,Default,,0,0,0,,Мені қызықтыратын тағы бір нәрсе бар...
Dialogue: 0,0:45:18.04,0:45:19.80,Default,,0,0,0,,Que~!
Dialogue: 0,0:45:21.21,0:45:22.21,Default,,0,0,0,,Бо…
Dialogue: 0,0:45:22.97,0:45:25.84,Default,,0,0,0,,Роро осында тұра ма?
Dialogue: 0,0:45:25.93,0:45:28.80,Default,,0,0,0,,А, түсіндім. Егер сіз оны хираганада жазсаңыз ...
Dialogue: 0,0:45:28.89,0:45:31.60,Default,,0,0,0,,«33» «Ророға» ұқсайды!
Dialogue: 0,0:45:31.68,0:45:32.77,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:45:32.85,0:45:34.35,Default,,0,0,0,,Уау! иә?
Dialogue: 0,0:45:35.31,0:45:36.48,Default,,0,0,0,,Уау! Гах!
Dialogue: 0,0:45:36.56,0:45:39.31,Default,,0,0,0,,Не? Келме!
Dialogue: 0,0:45:39.40,0:45:40.44,Default,,0,0,0,,О, итата
Dialogue: 0,0:45:40.52,0:45:43.74,Default,,0,0,0,,Тіс профилін тексеру үшін осы жерде шайнаңыз.
Dialogue: 0,0:45:43.82,0:45:44.70,Default,,0,0,0,,Уаааа! Эй!
Dialogue: 0,0:45:44.70,0:45:45.53,Default,,0,0,0,,Уаааа! Эй!
Dialogue: 0,0:45:44.70,0:45:45.53,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:45:45.61,0:45:47.57,Default,,0,0,0,,Біртүрлі заттарды бермеңіз
Dialogue: 0,0:45:47.66,0:45:48.49,Default,,0,0,0,,Мұқаба…
Dialogue: 0,0:45:49.53,0:45:50.95,Default,,0,0,0,,Мен сізден бірнәрсе сұрайын деп едім...
Dialogue: 0,0:45:51.62,0:45:54.29,Default,,0,0,0,,Роро-сан, сен кеше түнде қайда болдың?
Dialogue: 0,0:45:54.37,0:45:55.71,Default,,0,0,0,,осында
Dialogue: 0,0:45:55.79,0:45:57.54,Default,,0,0,0,,Сіз кіммен болдыңыз?
Dialogue: 0,0:45:57.62,0:45:58.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:59.46,0:46:00.50,Default,,0,0,0,,Осы баламен...
Dialogue: 0,0:46:00.59,0:46:02.46,Default,,0,0,0,,Гррррррр… Эй!
Dialogue: 0,0:46:03.05,0:46:06.05,Default,,0,0,0,,Біз Suuketsu Demon Jiken туралы зерттеу жүргіздік.
Dialogue: 0,0:46:06.13,0:46:07.51,Default,,0,0,0,,Бүгін көрмеген
Dialogue: 0,0:46:09.09,0:46:11.97,Default,,0,0,0,,Бұл жабайы элита~
Dialogue: 0,0:46:12.06,0:46:13.35,Default,,0,0,0,,Бо... Роро-сан алмастырушы ретінде танымал.
Dialogue: 0,0:46:13.35,0:46:15.43,Default,,0,0,0,,Роро-сан алмастырушы ретінде танымал.
Dialogue: 0,0:46:15.52,0:46:17.39,Default,,0,0,0,,Биология үйірмесін мектеп директоры жүргізеді.
Dialogue: 0,0:46:17.48,0:46:20.06,Default,,0,0,0,,Иә, сіз клубты аңдып жүрген сияқтысыз.
Dialogue: 0,0:46:21.82,0:46:23.40,Default,,0,0,0,,Күдікті...
Dialogue: 0,0:46:23.48,0:46:24.53,Default,,0,0,0,,Уу хи хи...
Dialogue: 0,0:46:24.61,0:46:25.86,Default,,0,0,0,,Допён!
Dialogue: 0,0:46:25.94,0:46:29.41,Default,,0,0,0,,(гангстерлердің қатты дауыстары)
Dialogue: 0,0:46:29.49,0:46:32.58,Default,,0,0,0,,Бұл бандитке айналған Сейто мен оның достарының класы...
Dialogue: 0,0:46:32.66,0:46:33.79,Default,,0,0,0,,Иә, соншама?
Dialogue: 0,0:46:33.87,0:46:36.12,Default,,0,0,0,,Иә... Сузуки-кун ақымақ топта болды.
Dialogue: 0,0:46:36.21,0:46:38.08,Default,,0,0,0,,Ахх!
Dialogue: 0,0:46:38.17,0:46:39.96,Default,,0,0,0,,Масуо-кун Юшу болды, бірақ
Dialogue: 0,0:46:40.04,0:46:42.75,Default,,0,0,0,,Менің элиталық ұпайларым көбеймейді...
Dialogue: 0,0:46:42.84,0:46:46.72,Default,,0,0,0,,Сонымен, барлық төменгілер ұпайларға алаңдады.
Dialogue: 0,0:46:46.80,0:46:48.68,Default,,0,0,0,,Иә және...
Dialogue: 0,0:46:48.76,0:46:51.64,Default,,0,0,0,,Барлығының бөксесін шағып жатыр...
Dialogue: 0,0:46:51.72,0:46:53.60,Default,,0,0,0,,Уууу (директор) Вакино мырза!
Dialogue: 0,0:46:53.68,0:46:58.06,Default,,0,0,0,,Сіз жасаған тест сұрағында қате табылды.
Dialogue: 0,0:46:58.14,0:46:59.48,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:46:59.56,0:47:01.52,Default,,0,0,0,,Барлық оқуды Отсумунға қалдыр!
Dialogue: 0,0:47:02.31,0:47:05.11,Default,,0,0,0,,Тенкасу академиясы осылай жұмыс істейді!
Dialogue: 0,0:47:07.32,0:47:08.99,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:47:09.53,0:47:13.41,Default,,0,0,0,,Вакино мырза орта мектепте мұғалім болған, солай ма?
Dialogue: 0,0:47:14.08,0:47:18.37,Default,,0,0,0,,Отсумунмен болған оқиғадан кейін мен оны бұдан былай үйрете алмадым...
Dialogue: 0,0:47:18.46,0:47:19.83,Default,,0,0,0,,Фу…
Dialogue: 0,0:47:20.42,0:47:22.79,Default,,0,0,0,,Хмм, бұл күдікті...
Dialogue: 0,0:47:26.67,0:47:29.22,Default,,0,0,0,,Әзірше көмектесе алатын жалғыз адам... Роро!
Dialogue: 0,0:47:29.30,0:47:31.68,Default,,0,0,0,,кеуделер! Уф...
Dialogue: 0,0:47:31.76,0:47:34.30,Default,,0,0,0,,Казама-кунның артына қалдырған «33».
Dialogue: 0,0:47:34.39,0:47:36.31,Default,,0,0,0,,Бұл Роро-санның аты болуы мүмкін.
Dialogue: 0,0:47:36.39,0:47:38.64,Default,,0,0,0,,Бөлме жануарлардың тістерінің ізіне толы болды.
Dialogue: 0,0:47:38.73,0:47:42.35,Default,,0,0,0,,Әлгі біртүрлі кесіртке мені тістеп алған шығар!
Dialogue: 0,0:47:43.15,0:47:45.32,Default,,0,0,0,,Иә! Хмф
Dialogue: 0,0:47:45.40,0:47:47.78,Default,,0,0,0,,Бұл біртүрлі кесіртке емес! комодо айдаһары
Dialogue: 0,0:47:47.86,0:47:49.44,Default,,0,0,0,,Немесе Комодо айдаһары!
Dialogue: 0,0:47:49.53,0:47:51.78,Default,,0,0,0,,Тістің ізі бар болғаны сізді шуко етпейді!
Dialogue: 0,0:47:51.86,0:47:55.12,Default,,0,0,0,,Сонымен қатар, Роро-сан мектеп өмірінен ләззат алады.
Dialogue: 0,0:47:55.20,0:47:56.03,Default,,0,0,0,,Мен ештеңе істей алмаймын!
Dialogue: 0,0:47:56.12,0:47:58.04,Default,,0,0,0,,Не... не болды? Бо-чан
Dialogue: 0,0:47:58.12,0:47:59.75,Default,,0,0,0,,Сіз әдеттегіден жылдам сөйлейсіз бе?
Dialogue: 0,0:47:59.83,0:48:00.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:01.67,0:48:03.21,Default,,0,0,0,,қоспағанда...
Dialogue: 0,0:48:03.29,0:48:07.17,Default,,0,0,0,,Казама-кунның артында қалдырған хабары «33» болса—
Dialogue: 0,0:48:08.59,0:48:11.01,Default,,0,0,0,,33-ші Банчо күдікті.
Dialogue: 0,0:48:11.09,0:48:13.30,Default,,0,0,0,,Темір масканың да тістері бар.
Dialogue: 0,0:48:14.26,0:48:16.26,Default,,0,0,0,,Хмф!
Dialogue: 0,0:48:16.85,0:48:19.73,Default,,0,0,0,,Иә, күдікті адамдар туралы айтатын болсақ, тағы бір адам бар!
Dialogue: 0,0:48:21.39,0:48:22.69,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:48:22.77,0:48:24.27,Default,,0,0,0,,Иә, Масао-кун?
Dialogue: 0,0:48:24.35,0:48:25.56,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:48:25.65,0:48:27.90,Default,,0,0,0,,Ең қалыпты адам - ​​Хан!
Dialogue: 0,0:48:27.98,0:48:29.74,Default,,0,0,0,,Екі сағаттық драма бар.
Dialogue: 0,0:48:29.82,0:48:30.65,Default,,0,0,0,,Иә
Dialogue: 0,0:48:32.95,0:48:34.03,Default,,0,0,0,,Біз не білеміз
Dialogue: 0,0:48:34.11,0:48:37.12,Default,,0,0,0,,Алдыңғы түнде Казама-күн біреуден шошып кетті.
Dialogue: 0,0:48:37.20,0:48:39.62,Default,,0,0,0,,Суланып, бар күшімді салып
Dialogue: 0,0:48:39.70,0:48:41.83,Default,,0,0,0,,Мен өлетін хабар қалдырдым...
Dialogue: 0,0:48:44.25,0:48:46.46,Default,,0,0,0,,Казама-кун тірі...
Dialogue: 0,0:48:46.54,0:48:49.21,Default,,0,0,0,,Хабардың құпиясын түсінсең...
Dialogue: 0,0:48:50.26,0:48:51.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:48:51.47,0:48:53.38,Default,,0,0,0,,Шин-чан, сенің ойың бар ма?
Dialogue: 0,0:48:53.47,0:48:57.10,Default,,0,0,0,,Һмм…!
Dialogue: 0,0:48:57.18,0:48:59.81,Default,,0,0,0,,О, түсіндім!
Dialogue: 0,0:49:02.23,0:49:05.94,Default,,0,0,0,,Егер сізде қиын сұрақтар болса, бірінші адамға сұраңыз!
Dialogue: 0,0:49:06.02,0:49:07.27,Default,,0,0,0,,Оны басқаларға қалдырыңыз!
Dialogue: 0,0:49:08.27,0:49:10.23,Default,,0,0,0,,Касукабе детектив клубы?
Dialogue: 0,0:49:10.32,0:49:13.53,Default,,0,0,0,,Иә, мен Suuketsu Demon Jiken-ді қарап жатырмын.
Dialogue: 0,0:49:13.61,0:49:16.20,Default,,0,0,0,,Сасуга-кун бірдеңені түсінер ме екен...
Dialogue: 0,0:49:16.28,0:49:18.16,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:49:18.24,0:49:23.41,Default,,0,0,0,,Бұрынғы Ханагата Рикуджо Сенте қазір Ючи Енджимен детектив рөлін ойнап жатыр ма?
Dialogue: 0,0:49:24.00,0:49:26.33,Default,,0,0,0,,Мені осы мектепке берген ата-ана
Dialogue: 0,0:49:26.42,0:49:30.13,Default,,0,0,0,,Егер мен сені қазіргідей көрсем, көңілім қалар еді.
Dialogue: 0,0:49:31.21,0:49:33.09,Default,,0,0,0,,Мен қайтадан жүгіріп кетсем екен...
Dialogue: 0,0:49:33.17,0:49:36.05,Default,,0,0,0,,Дұрыс! Ахахахха...
Dialogue: 0,0:49:36.13,0:49:38.43,Default,,0,0,0,,-де? Менен не сұрағың келеді?
Dialogue: 0,0:49:38.51,0:49:40.06,Default,,0,0,0,,Енді бұл мәселе! иә?
Dialogue: 0,0:49:40.14,0:49:41.56,Default,,0,0,0,,Деден
Dialogue: 0,0:49:41.64,0:49:42.52,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:49:42.60,0:49:46.14,Default,,0,0,0,,Бұл Казама-кунның артында қалған хабары.
Dialogue: 0,0:49:46.23,0:49:48.11,Default,,0,0,0,,Менің не айтқым келгенін білесің бе?
Dialogue: 0,0:49:49.19,0:49:50.40,Default,,0,0,0,,33？
Dialogue: 0,0:49:50.48,0:49:54.15,Default,,0,0,0,,Ммм~ Сен небәрі 1 жаста болсаң да әлі түсінбейсің~?
Dialogue: 0,0:49:54.24,0:49:55.99,Default,,0,0,0,,Ал, екінші адамнан сұрайық.
Dialogue: 0,0:49:56.07,0:49:57.66,Default,,0,0,0,,Агеха-чан
Dialogue: 0,0:49:57.74,0:49:58.82,Default,,0,0,0,,А? Эй!
Dialogue: 0,0:49:58.91,0:49:59.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:49:59.87,0:50:01.70,Default,,0,0,0,,Мен шеше алмайтын мәселелер бар ма?
Dialogue: 0,0:50:02.33,0:50:04.75,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:50:04.83,0:50:05.66,Default,,0,0,0,,Хмм…
Dialogue: 0,0:50:05.75,0:50:07.42,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:50:07.50,0:50:09.50,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:50:09.58,0:50:11.92,Default,,0,0,0,,Әлі жоқ. Анықтап көрейік.
Dialogue: 0,0:50:12.00,0:50:13.46,Default,,0,0,0,,Ертең тағы келіңіз.
Dialogue: 0,0:50:14.09,0:50:15.13,Default,,0,0,0,,Фалько…
Dialogue: 0,0:50:17.68,0:50:20.01,Default,,0,0,0,,Менің ойымша, біз ертең бір анықтама аламыз!
Dialogue: 0,0:50:20.10,0:50:20.93,Default,,0,0,0,,Иә
Dialogue: 0,0:50:21.01,0:50:23.01,Default,,0,0,0,,Қайта кездескенше.
Dialogue: 0,0:50:23.10,0:50:25.85,Default,,0,0,0,,Уууу, тағы кездескенше...
Dialogue: 0,0:50:25.93,0:50:26.98,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:50:37.99,0:50:38.57,Default,,0,0,0,,(Кейн дыбысы)
Dialogue: 0,0:50:38.57,0:50:39.91,Default,,0,0,0,,(Кейн дыбысы)
Dialogue: 0,0:50:38.57,0:50:39.91,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:50:39.91,0:50:41.91,Default,,0,0,0,,(Кейн дыбысы)
Dialogue: 0,0:50:41.99,0:50:43.87,Default,,0,0,0,,Бұл...!
Dialogue: 0,0:50:52.13,0:50:53.30,Default,,0,0,0,,О! Уф!
Dialogue: 0,0:50:53.38,0:50:54.42,Default,,0,0,0,,Boh!
Dialogue: 0,0:51:01.43,0:51:02.85,Default,,0,0,0,,Сәлем! Уф...!
Dialogue: 0,0:51:02.93,0:51:05.77,Default,,0,0,0,,Сасуга-кун! Жарайды ма?
Dialogue: 0,0:51:05.85,0:51:08.23,Default,,0,0,0,,Бұл вампир! Сасуга-кун, мықты бол!
Dialogue: 0,0:51:14.23,0:51:16.11,Default,,0,0,0,,Бо…
Dialogue: 0,0:51:24.16,0:51:26.54,Default,,0,0,0,,Н~копуппо!
Dialogue: 0,0:51:26.62,0:51:29.79,Default,,0,0,0,,Сасуга-кун, түс!
Dialogue: 0,0:51:29.87,0:51:31.71,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:51:31.79,0:51:34.80,Default,,0,0,0,,Попкорн Төңкеріп оқығанда
Dialogue: 0,0:51:34.88,0:51:36.92,Default,,0,0,0,,N~kopppo!
Dialogue: 0,0:51:37.01,0:51:38.88,Default,,0,0,0,,Ах... пупупу...
Dialogue: 0,0:51:38.97,0:51:42.84,Default,,0,0,0,,Сасуга-кун, сен №1сің! Мықты болыңыз!
Dialogue: 0,0:51:42.93,0:51:44.81,Default,,0,0,0,,Н~копуппо
Dialogue: 0,0:51:44.89,0:51:46.85,Default,,0,0,0,,Puppoppoppuppoppup~!
Dialogue: 0,0:51:46.93,0:51:48.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:48.93,0:51:50.81,Default,,0,0,0,,Не деген...
Dialogue: 0,0:51:51.60,0:51:52.77,Default,,0,0,0,,Джан!
Dialogue: 0,0:51:53.44,0:51:55.73,Default,,0,0,0,,Біз мұны жасадық.
Dialogue: 0,0:51:55.82,0:51:57.19,Default,,0,0,0,,Шоккаке~!
Dialogue: 0,0:51:57.28,0:51:58.86,Default,,0,0,0,,Келіңіздер, біз де жасайық!
Dialogue: 0,0:51:58.94,0:52:00.24,Default,,0,0,0,,Мен де!
Dialogue: 0,0:52:05.45,0:52:06.58,Default,,0,0,0,,Сасуга-кун —
Dialogue: 0,0:52:06.66,0:52:09.33,Default,,0,0,0,,Менің ойымша, сіз 33-тің құпиясын аштыңыз.
Dialogue: 0,0:52:09.41,0:52:10.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:10.33,0:52:13.21,Default,,0,0,0,,...
Dialogue: 0,0:52:13.29,0:52:16.67,Default,,0,0,0,,Бұл не? 33!
Dialogue: 0,0:52:23.64,0:52:25.51,Default,,0,0,0,,Ухихи…
Dialogue: 0,0:52:25.60,0:52:26.89,Default,,0,0,0,,Аму
Dialogue: 0,0:52:26.97,0:52:28.97,Default,,0,0,0,,Сасуга-кун әлі тек 1
Dialogue: 0,0:52:29.06,0:52:31.81,Default,,0,0,0,,Кани хмм...
Dialogue: 0,0:52:29.06,0:52:31.81,Default,,0,0,0,,(Нүктелердің дыбысы төмендейді)
Dialogue: 0,0:52:31.81,0:52:31.89,Default,,0,0,0,,(нүктелердің дыбысы төмендейді)
Dialogue: 0,0:52:31.89,0:52:33.19,Default,,0,0,0,,(Нүктелердің түсу дыбысы)
Dialogue: 0,0:52:31.89,0:52:33.19,Default,,0,0,0,,(сорғыш дыбыс)
Dialogue: 0,0:52:34.31,0:52:36.27,Default,,0,0,0,,Бұл тек уақыт мәселесі...
Dialogue: 0,0:52:36.82,0:52:40.19,Default,,0,0,0,,Ах! Келесі жолы мен 1-ші боламын...
Dialogue: 0,0:52:41.95,0:52:46.03,Default,,0,0,0,,１ …
Dialogue: 0,0:52:46.91,0:52:48.58,Default,,0,0,0,,Күдікті...
Dialogue: 0,0:52:52.04,0:52:55.00,Default,,0,0,0,,...
Dialogue: 0,0:52:55.08,0:52:56.92,Default,,0,0,0,,Нуо~! иә?
Dialogue: 0,0:52:58.09,0:52:59.38,Default,,0,0,0,,Жүгіруге болмайды
Dialogue: 0,0:52:59.46,0:53:02.92,Default,,0,0,0,,...
Dialogue: 0,0:53:03.01,0:53:03.84,Default,,0,0,0,,Якисоба!
Dialogue: 0,0:53:03.93,0:53:05.93,Default,,0,0,0,,Пан! Бенбенбенбен!
Dialogue: 0,0:53:06.01,0:53:07.55,Default,,0,0,0,,Паралила Паралила~!
Dialogue: 0,0:53:07.64,0:53:10.02,Default,,0,0,0,,Паралила Паралила…
Dialogue: 0,0:53:10.10,0:53:11.98,Default,,0,0,0,,Енді, Масао-кун?
Dialogue: 0,0:53:12.06,0:53:13.64,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:53:12.06,0:53:13.64,Default,,0,0,0,,Паралила Паралила...!
Dialogue: 0,0:53:13.64,0:53:14.44,Default,,0,0,0,,Паралила Паралила...!
Dialogue: 0,0:53:14.52,0:53:17.40,Default,,0,0,0,,...
Dialogue: 0,0:53:17.48,0:53:20.48,Default,,0,0,0,,...
Dialogue: 0,0:53:20.57,0:53:22.36,Default,,0,0,0,,Бенбебенбене!
Dialogue: 0,0:53:22.90,0:53:24.78,Default,,0,0,0,,Уау, жай...!
Dialogue: 0,0:53:24.86,0:53:26.49,Default,,0,0,0,,Жоғары!
Dialogue: 0,0:53:26.57,0:53:27.41,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:53:27.49,0:53:29.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:29.12,0:53:32.45,Default,,0,0,0,,Якисоба Пан!
Dialogue: 0,0:53:35.25,0:53:37.54,Default,,0,0,0,,Не... неге...
Dialogue: 0,0:53:37.63,0:53:39.04,Default,,0,0,0,,Банчо-кун...
Dialogue: 0,0:53:43.26,0:53:45.47,Default,,0,0,0,,Сіз алдап жатырсыз, бастық!
Dialogue: 0,0:53:45.55,0:53:47.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:47.18,0:53:48.55,Default,,0,0,0,,Мм...!
Dialogue: 0,0:53:49.76,0:53:50.76,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:53:51.60,0:53:53.98,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:53:56.56,0:53:58.19,Default,,0,0,0,,Якисоба наны...
Dialogue: 0,0:53:59.36,0:54:00.44,Default,,0,0,0,,Айтпақшы...
Dialogue: 0,0:54:00.52,0:54:03.90,Default,,0,0,0,,...
Dialogue: 0,0:54:04.69,0:54:07.86,Default,,0,0,0,,～  “”
Dialogue: 0,0:54:07.95,0:54:09.87,Default,,0,0,0,,Мен...
Dialogue: 0,0:54:09.95,0:54:12.83,Default,,0,0,0,,Бұл күріш шары маса! Түнгі шық ауырады!
Dialogue: 0,0:54:12.91,0:54:15.08,Default,,0,0,0,,Ах... хмм.
Dialogue: 0,0:54:15.16,0:54:17.62,Default,,0,0,0,,Шоко бірдеңе таптыңыз ба?
Dialogue: 0,0:54:17.71,0:54:19.83,Default,,0,0,0,,...
Dialogue: 0,0:54:19.92,0:54:21.09,Default,,0,0,0,,Ха…
Dialogue: 0,0:54:21.17,0:54:24.30,Default,,0,0,0,,...
Dialogue: 0,0:54:24.38,0:54:26.76,Default,,0,0,0,,А... Аники?
Dialogue: 0,0:54:29.26,0:54:30.22,Default,,0,0,0,,Өз баламды ешқашан қателеспес едім.
Dialogue: 0,0:54:30.30,0:54:33.18,Default,,0,0,0,,Банчо~!
Dialogue: 0,0:54:34.02,0:54:35.18,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:54:35.27,0:54:38.14,Default,,0,0,0,,Тәтті картоп бөлігінің мәні - ол әлсіз адам.
Dialogue: 0,0:54:38.23,0:54:40.19,Default,,0,0,0,,Аники кейде
Dialogue: 0,0:54:40.27,0:54:43.61,Default,,0,0,0,,Якисоба нанын осылай бөлісеміз.
Dialogue: 0,0:54:45.03,0:54:46.57,Default,,0,0,0,,Аники айтты...
Dialogue: 0,0:54:47.45,0:54:52.12,Default,,0,0,0,,Бұл мектеп бұрындары тыныш және тыныш болған...
Dialogue: 0,0:54:52.62,0:54:54.37,Default,,0,0,0,,Сол мектеп директоры
Dialogue: 0,0:54:54.45,0:54:57.50,Default,,0,0,0,,Elite Points деп аталатын нәрсені жасағаннан кейін...
Dialogue: 0,0:54:57.58,0:54:59.67,Default,,0,0,0,,Мен жынды болдым
Dialogue: 0,0:55:00.54,0:55:05.42,Default,,0,0,0,,Тек таңдаулылар ғана қудаланады, ал әлсіздерге жәндік сияқты қарайды.
Dialogue: 0,0:55:05.51,0:55:06.97,Default,,0,0,0,,(Таңдаулылардың ащы дауыстары)
Dialogue: 0,0:55:07.05,0:55:07.88,Default,,0,0,0,,Әй!
Dialogue: 0,0:55:07.97,0:55:10.84,Default,,0,0,0,,Тыныс алу қиын...
Dialogue: 0,0:55:10.93,0:55:13.97,Default,,0,0,0,,Бәрі бұзылып, мен ырылдаймын
Dialogue: 0,0:55:17.77,0:55:20.73,Default,,0,0,0,,Жаға Менің де ерік-жігерім бар.
Dialogue: 0,0:55:20.81,0:55:23.90,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:55:24.82,0:55:27.15,Default,,0,0,0,,Аники~!
Dialogue: 0,0:55:27.24,0:55:29.45,Default,,0,0,0,,«Сіз не істей аласыз»…
Dialogue: 0,0:55:29.53,0:55:32.12,Default,,0,0,0,,Бәрінің көкесін сорып жатыр дейсің бе?
Dialogue: 0,0:55:32.20,0:55:33.62,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:55:33.70,0:55:36.62,Default,,0,0,0,,Аники - Ханстың ішіндегі хань!
Dialogue: 0,0:55:36.70,0:55:39.08,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:55:39.16,0:55:42.04,Default,,0,0,0,,(Жануарлардың дыбыстары)
Dialogue: 0,0:55:42.13,0:55:43.71,Default,,0,0,0,,Бо…
Dialogue: 0,0:55:47.01,0:55:48.67,Default,,0,0,0,,Эй (Бо-чан) Бо!
Dialogue: 0,0:55:48.76,0:55:51.97,Default,,0,0,0,,Саған бірдеңе керек пе...?
Dialogue: 0,0:55:52.05,0:55:53.93,Default,,0,0,0,,Ум... у...
Dialogue: 0,0:55:55.26,0:55:57.39,Default,,0,0,0,,Мен... мен кеше...
Dialogue: 0,0:55:57.47,0:56:00.35,Default,,0,0,0,,Ророға сағатқа қара...
Dialogue: 0,0:56:01.31,0:56:04.90,Default,,0,0,0,,Не көрдің? (Бо-чан) Боаа~!
Dialogue: 0,0:56:04.98,0:56:06.02,Default,,0,0,0,,Боа!
Dialogue: 0,0:56:06.11,0:56:09.49,Default,,0,0,0,,Сағат қорабынан қай жерден шығады
Dialogue: 0,0:56:09.57,0:56:11.95,Default,,0,0,0,,Оны көрген жалғыз сен бе?
Dialogue: 0,0:56:12.03,0:56:13.91,Default,,0,0,0,,Бобобобобобобо…
Dialogue: 0,0:56:15.03,0:56:16.37,Default,,0,0,0,,Сіз біреумен сөйлестіңіз бе?
Dialogue: 0,0:56:16.45,0:56:18.33,Default,,0,0,0,,Бобобобобобобо…
Dialogue: 0,0:56:19.37,0:56:21.08,Default,,0,0,0,,Ешкіммен сөйлеспе
Dialogue: 0,0:56:22.12,0:56:23.17,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:56:25.42,0:56:26.75,Default,,0,0,0,,Бо…
Dialogue: 0,0:56:26.84,0:56:28.46,Default,,0,0,0,,Біз тамаққа қалай барамыз?
Dialogue: 0,0:56:30.80,0:56:34.30,Default,,0,0,0,,(Қарлығаштың гуілдеуі)
Dialogue: 0,0:56:34.39,0:56:36.14,Default,,0,0,0,,～
Dialogue: 0,0:56:36.22,0:56:38.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:56:38.72,0:56:42.06,Default,,0,0,0,,Қалай ойлайсың, мені ақымақпын ба?
Dialogue: 0,0:56:42.14,0:56:45.52,Default,,0,0,0,,Иә! Не... не дейсіз?
Dialogue: 0,0:56:45.61,0:56:49.48,Default,,0,0,0,,Сіз оны зерттеп жатырсыз, солай емес пе? Каслов мырза
Dialogue: 0,0:56:50.24,0:56:51.15,Default,,0,0,0,,Каслав?
Dialogue: 0,0:56:51.24,0:56:54.07,Default,,0,0,0,,Касукабе детектив клубы Рякуши Касулове
Dialogue: 0,0:56:54.16,0:56:56.70,Default,,0,0,0,,Мен адам емеспін.
Dialogue: 0,0:56:56.78,0:56:57.62,Default,,0,0,0,,Бұл басқаша ма?
Dialogue: 0,0:56:57.70,0:56:59.33,Default,,0,0,0,,Қараңдар! Ол әлі де ән айтып жатыр
Dialogue: 0,0:56:59.41,0:57:00.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:01.87,0:57:02.96,Default,,0,0,0,,Эххе... хехе
Dialogue: 0,0:57:04.00,0:57:05.92,Default,,0,0,0,,Ал, Чишио да қауіпті~
Dialogue: 0,0:57:06.00,0:57:08.38,Default,,0,0,0,,Он топтан қалдық топқа түсу?
Dialogue: 0,0:57:08.46,0:57:11.59,Default,,0,0,0,,Мен болсам, мен мектепті тастар едім.
Dialogue: 0,0:57:11.67,0:57:13.84,Default,,0,0,0,,Чишио-чан, сен жараланып қалдың.
Dialogue: 0,0:57:13.93,0:57:16.89,Default,,0,0,0,,А... Мен айттым, бірақ...
Dialogue: 0,0:57:16.97,0:57:18.81,Default,,0,0,0,,Чишио түнде жасырын жүгіретін сияқты.
Dialogue: 0,0:57:18.81,0:57:20.31,Default,,0,0,0,,Чишио түнде жасырын жүгіретін сияқты.
Dialogue: 0,0:57:18.81,0:57:20.31,Default,,0,0,0,,(дәретхананың ағу дыбысы)
Dialogue: 0,0:57:21.02,0:57:22.77,Default,,0,0,0,,Уау! Апыр-ай! Ах...
Dialogue: 0,0:57:23.81,0:57:25.35,Default,,0,0,0,,Агеха мырза...
Dialogue: 0,0:57:25.44,0:57:27.73,Default,,0,0,0,,Біртүрлі өсек таратпау
Dialogue: 0,0:57:27.81,0:57:31.19,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:57:33.65,0:57:34.65,Default,,0,0,0,,Мен қорықтым~
Dialogue: 0,0:57:36.36,0:57:37.62,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:57:37.70,0:57:41.54,Default,,0,0,0,,Мен элиталық курстан құладым...
Dialogue: 0,0:57:41.62,0:57:43.50,Default,,0,0,0,,Неге тек мен?
Dialogue: 0,0:57:43.58,0:57:46.04,Default,,0,0,0,,Қиын! Бұл жабу қиын!
Dialogue: 0,0:57:46.12,0:57:49.75,Default,,0,0,0,,Одан да жақсырақ... Бәрін төбелеске айналдырамын!
Dialogue: 0,0:57:51.09,0:57:55.97,Default,,0,0,0,,Нуахахахха...! Мұның бәрі құбыжыққа айналу жоспарында!
Dialogue: 0,0:57:56.05,0:57:58.89,Default,,0,0,0,,Нуахахахха...!
Dialogue: 0,0:57:58.97,0:58:00.18,Default,,0,0,0,,...Сондықтан
Dialogue: 0,0:58:00.26,0:58:03.14,Default,,0,0,0,,Чишио-чанның адам болуы мүмкін емес...
Dialogue: 0,0:58:03.22,0:58:05.64,Default,,0,0,0,,Сіз мұны түсінбейсіз.
Dialogue: 0,0:58:05.73,0:58:09.02,Default,,0,0,0,,Шин-чан - Чишио-чан, солай ма?
Dialogue: 0,0:58:09.11,0:58:10.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:10.19,0:58:13.15,Default,,0,0,0,,Сәлем! Шин Чан, тыңдап тұрсың ба?
Dialogue: 0,0:58:13.23,0:58:15.07,Default,,0,0,0,,Хой
Dialogue: 0,0:58:17.32,0:58:19.87,Default,,0,0,0,,Бо-чан - Роро-сан!
Dialogue: 0,0:58:20.37,0:58:21.33,Default,,0,0,0,,Сұлу…
Dialogue: 0,0:58:21.91,0:58:26.33,Default,,0,0,0,,Ертең сенбі, баршаңыз хабардар болыңыздар!
Dialogue: 0,0:58:29.42,0:58:31.29,Default,,0,0,0,,Бір таңқаларлығы, сіз мұны істейсіз ...
Dialogue: 0,0:58:32.34,0:58:34.30,Default,,0,0,0,,Касукабе детектив клубы
Dialogue: 0,0:58:35.22,0:58:37.34,Default,,0,0,0,,Келесі жануар...
Dialogue: 0,0:58:39.39,0:58:40.85,Default,,0,0,0,,Бо…
Dialogue: 0,0:58:56.95,0:58:58.40,Default,,0,0,0,,Итайта ~
Dialogue: 0,0:58:58.49,0:59:01.82,Default,,0,0,0,,Чишио-чан, Оланың бөксесін тістеп ал.
Dialogue: 0,0:59:01.91,0:59:05.37,Default,,0,0,0,,Ола Чишио-чан, бәрі жақсы...
Dialogue: 0,0:59:05.45,0:59:06.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:06.37,0:59:10.08,Default,,0,0,0,,(Рику аға мүшелерінің дауыстары)
Dialogue: 0,0:59:10.17,0:59:11.21,Default,,0,0,0,,Чишио-чан?
Dialogue: 0,0:59:11.29,0:59:12.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:12.67,0:59:13.71,Default,,0,0,0,,О Шин Чан
Dialogue: 0,0:59:13.80,0:59:15.38,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:59:16.76,0:59:18.76,Default,,0,0,0,,Қалаған ғылымыңызды жеткізіңіз...
Dialogue: 0,0:59:18.84,0:59:21.14,Default,,0,0,0,,Мен мектепті тастауым керек деп ойлаймын.
Dialogue: 0,0:59:21.22,0:59:22.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:59:24.64,0:59:26.02,Default,,0,0,0,,Әкесі де, анасы да
Dialogue: 0,0:59:26.10,0:59:31.06,Default,,0,0,0,,Мен осы мектепке бару үшін өмір бойы көп еңбек еттім.
Dialogue: 0,0:59:31.15,0:59:33.52,Default,,0,0,0,,Мен құладым...
Dialogue: 0,0:59:35.57,0:59:40.45,Default,,0,0,0,,Мен енді жүгіре алмаймын және бас тартуды ойлап жүрмін...
Dialogue: 0,0:59:40.53,0:59:42.20,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:59:42.28,0:59:45.41,Default,,0,0,0,,Жоқ, мен Шин-чанға ыңырсыдым...
Dialogue: 0,0:59:45.49,0:59:47.62,Default,,0,0,0,,Джанжан, жүр.
Dialogue: 0,0:59:47.70,0:59:48.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:49.46,0:59:52.38,Default,,0,0,0,,Йоване мен Ничийойға барсаң жеңіл болады дейді.
Dialogue: 0,0:59:52.46,0:59:54.29,Default,,0,0,0,,Әкем солай деді.
Dialogue: 0,0:59:56.80,1:00:00.13,Default,,0,0,0,,Шинносуке Нохара мен Сумико мырза және
Dialogue: 0,1:00:00.22,1:00:02.09,Default,,0,0,0,,Иә!
Dialogue: 0,1:00:02.18,1:00:06.06,Default,,0,0,0,,(Синносукенің гуілдеуі)
Dialogue: 0,1:00:06.14,1:00:08.52,Default,,0,0,0,,О~ Әрекет маскасы!
Dialogue: 0,1:00:08.60,1:00:11.94,Default,,0,0,0,,Ола және басқалар жасаған...
Dialogue: 0,1:00:12.02,1:00:12.98,Default,,0,0,0,,Әй?
Dialogue: 0,1:00:16.02,1:00:17.65,Default,,0,0,0,,Өтінемін, асығыңыз
Dialogue: 0,1:00:17.73,1:00:18.78,Default,,0,0,0,,Әй?
Dialogue: 0,1:00:18.86,1:00:21.90,Default,,0,0,0,,Құпия жеке сабақ бар деп естідім.
Dialogue: 0,1:00:21.99,1:00:22.91,Default,,0,0,0,,Нуееее!
Dialogue: 0,1:00:22.99,1:00:24.53,Default,,0,0,0,,Ахаха~
Dialogue: 0,1:00:24.62,1:00:29.20,Default,,0,0,0,,Жеке сабақ Эмманье Кристе
Dialogue: 0,1:00:29.70,1:00:30.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:33.92,1:00:37.80,Default,,0,0,0,,Мен Шин Чан мен басқалары мұны дұрыс істеп жатыр ма деп ойлаймын...
Dialogue: 0,1:00:40.34,1:00:42.88,Default,,0,0,0,,Вампирлердің көздері қандай?
Dialogue: 0,1:00:45.26,1:00:47.72,Default,,0,0,0,,Неліктен сағат?
Dialogue: 0,1:00:49.22,1:00:51.18,Default,,0,0,0,,Бо... у...
Dialogue: 0,1:00:54.06,1:00:55.06,Default,,0,0,0,,Бо!
Dialogue: 0,1:00:55.15,1:00:57.52,Default,,0,0,0,,Иә! (Бо-чан) Боа!
Dialogue: 0,1:00:57.61,1:01:00.49,Default,,0,0,0,,Менің сырымды білдің бе?
Dialogue: 0,1:01:00.57,1:01:01.78,Default,,0,0,0,,Роро-сан...!
Dialogue: 0,1:01:01.86,1:01:03.95,Default,,0,0,0,,Тыныш! (Бо Чан) Уф! Уф...
Dialogue: 0,1:01:05.03,1:01:09.37,Default,,0,0,0,,Мен сені үйге жібере алмайтынымды білемін.
Dialogue: 0,1:01:09.45,1:01:11.87,Default,,0,0,0,,Неге... неге бұлай істеп жатырсың?
Dialogue: 0,1:01:12.96,1:01:14.62,Default,,0,0,0,,Тірі қалу үшін...
Dialogue: 0,1:01:14.71,1:01:16.33,Default,,0,0,0,,Роро-сан!
Dialogue: 0,1:01:17.42,1:01:19.46,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,1:01:19.96,1:01:20.96,Default,,0,0,0,,Бо…
Dialogue: 0,1:01:23.80,1:01:24.80,Default,,0,0,0,,Бо?
Dialogue: 0,1:01:28.10,1:01:30.97,Default,,0,0,0,,Дыбыстық сигнал! Дыбыс...
Dialogue: 0,1:01:31.81,1:01:34.10,Default,,0,0,0,,Бұл жерде өсіріледі.
Dialogue: 0,1:01:34.19,1:01:37.40,Default,,0,0,0,,Директор білсе, шу болады.
Dialogue: 0,1:01:38.61,1:01:39.44,Default,,0,0,0,,Эй
Dialogue: 0,1:01:44.90,1:01:48.03,Default,,0,0,0,,Енді біз бүгінгі күннің адамдарымыз
Dialogue: 0,1:01:48.66,1:01:49.87,Default,,0,0,0,,Хехе
Dialogue: 0,1:01:53.16,1:01:54.29,Default,,0,0,0,,Бо…
Dialogue: 0,1:01:56.58,1:01:57.75,Default,,0,0,0,,Роро-сан!
Dialogue: 0,1:01:57.83,1:02:01.25,Default,,0,0,0,,Мен... Роро туралы айтып отырмын...
Dialogue: 0,1:02:01.34,1:02:04.22,Default,,0,0,0,,Су... Су... Су...!
Dialogue: 0,1:02:04.30,1:02:06.22,Default,,0,0,0,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,1:02:10.22,1:02:11.18,Default,,0,0,0,,Мен...
Dialogue: 0,1:02:11.89,1:02:13.73,Default,,0,0,0,,Мен адамдарды ұнатпаймын...
Dialogue: 0,1:02:15.52,1:02:16.52,Default,,0,0,0,,А...
Dialogue: 0,1:02:24.24,1:02:26.24,Default,,0,0,0,,Осыны оқып, күтіңіз.
Dialogue: 0,1:02:26.32,1:02:27.32,Default,,0,0,0,,Әй?
Dialogue: 0,1:02:28.66,1:02:30.53,Default,,0,0,0,,Мұның бәрі?
Dialogue: 0,1:02:30.62,1:02:34.79,Default,,0,0,0,,Сіз оқып біткенше Сумико-сенсей келмейді.
Dialogue: 0,1:02:34.87,1:02:36.00,Default,,0,0,0,,Иә~
Dialogue: 0,1:02:36.08,1:02:37.75,Default,,0,0,0,,Ммм!
Dialogue: 0,1:02:38.62,1:02:40.71,Default,,0,0,0,,«қа»! «Сонымен»!
Dialogue: 0,1:02:40.79,1:02:43.67,Default,,0,0,0,,«айт»! «тіс»! «ның»!
Dialogue: 0,1:02:43.76,1:02:45.72,Default,,0,0,0,,«бұл»
Dialogue: 0,1:02:46.72,1:02:50.26,Default,,0,0,0,,«Сонымен»… «Сонымен»…
Dialogue: 0,1:02:51.68,1:02:53.14,Default,,0,0,0,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,1:02:56.18,1:02:57.27,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:57.85,1:03:00.61,Default,,0,0,0,,Неліктен вампирлер сені мазақ етеді?
Dialogue: 0,1:03:00.69,1:03:03.73,Default,,0,0,0,,Казама-кун 33-ті не үшін жазды?
Dialogue: 0,1:03:04.36,1:03:06.99,Default,,0,0,0,,Мен енді түсінбеймін!
Dialogue: 0,1:03:07.07,1:03:08.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:08.70,1:03:12.66,Default,,0,0,0,,Казама-кун бұл қарындашты бірінші кезекте не үшін пайдаланды?
Dialogue: 0,1:03:14.33,1:03:15.37,Default,,0,0,0,,«Йокан»?
Dialogue: 0,1:03:17.46,1:03:18.62,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:22.29,1:03:24.63,Default,,0,0,0,,А... иә?
Dialogue: 0,1:03:26.13,1:03:27.09,Default,,0,0,0,,Қарау?
Dialogue: 0,1:03:27.17,1:03:28.84,Default,,0,0,0,,О? Апыр-ай!
Dialogue: 0,1:03:29.43,1:03:31.05,Default,,0,0,0,,Бұл не!
Dialogue: 0,1:03:31.14,1:03:32.26,Default,,0,0,0,,Әй?
Dialogue: 0,1:03:34.81,1:03:36.77,Default,,0,0,0,,Вампир?
Dialogue: 0,1:03:36.85,1:03:37.68,Default,,0,0,0,,Әй?
Dialogue: 0,1:03:39.73,1:03:43.11,Default,,0,0,0,,О... Ой... Ой...
Dialogue: 0,1:03:50.53,1:03:51.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:55.45,1:03:58.33,Default,,0,0,0,,Мен бірінші рет мұндай ақымақ болып тұрмын.
Dialogue: 0,1:03:58.41,1:04:00.50,Default,,0,0,0,,Сумико мырза қайда?
Dialogue: 0,1:04:00.58,1:04:02.79,Default,,0,0,0,,Оланың жеке сабағы!
Dialogue: 0,1:04:02.88,1:04:05.71,Default,,0,0,0,,Менде сабақ болды! Жақында сабақ!
Dialogue: 0,1:04:05.80,1:04:08.01,Default,,0,0,0,,Уау! Жақында-күн-күн!
Dialogue: 0,1:04:09.80,1:04:10.80,Default,,0,0,0,,Әй?
Dialogue: 0,1:04:11.68,1:04:12.68,Default,,0,0,0,,А... кітап па?
Dialogue: 0,1:04:13.34,1:04:14.35,Default,,0,0,0,,Тс!
Dialogue: 0,1:04:17.22,1:04:19.48,Default,,0,0,0,,Ой! о?
Dialogue: 0,1:04:19.56,1:04:21.31,Default,,0,0,0,,Ка~шите~!
Dialogue: 0,1:04:21.39,1:04:22.48,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:04:22.56,1:04:24.44,Default,,0,0,0,,Мен мұны білемін!
Dialogue: 0,1:04:26.65,1:04:28.48,Default,,0,0,0,,Мұны істе!
Dialogue: 0,1:04:28.57,1:04:30.03,Default,,0,0,0,,Қосыңыз!
Dialogue: 0,1:04:32.32,1:04:34.24,Default,,0,0,0,,Ахехе ахе~!
Dialogue: 0,1:04:34.32,1:04:35.70,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,1:04:35.78,1:04:37.16,Default,,0,0,0,,Аха~ Тыңдаңыз~!
Dialogue: 0,1:04:37.24,1:04:38.74,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:04:38.83,1:04:40.75,Default,,0,0,0,,Охо охохо~!
Dialogue: 0,1:04:45.54,1:04:46.71,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:46.79,1:04:48.80,Default,,0,0,0,,Брон Брон!
Dialogue: 0,1:04:48.88,1:04:50.38,Default,,0,0,0,,Кикие!
Dialogue: 0,1:04:52.26,1:04:53.59,Default,,0,0,0,,Бо... (Бо-чан) Уф...
Dialogue: 0,1:04:54.34,1:04:55.55,Default,,0,0,0,,солай емес пе?
Dialogue: 0,1:04:57.51,1:05:00.52,Default,,0,0,0,,Жоқ! Менің көзімнен мұрын ағады!
Dialogue: 0,1:05:00.60,1:05:02.06,Default,,0,0,0,,Хаха...
Dialogue: 0,1:05:02.14,1:05:03.64,Default,,0,0,0,,Не болды?
Dialogue: 0,1:05:03.73,1:05:06.02,Default,,0,0,0,,Мен бұл сағат деп ойладым, бірақ олай емес!
Dialogue: 0,1:05:06.11,1:05:08.48,Default,,0,0,0,,Жұмыс орны сағат сияқты емес!
Dialogue: 0,1:05:08.57,1:05:09.94,Default,,0,0,0,,Не!
Dialogue: 0,1:05:11.49,1:05:14.36,Default,,0,0,0,,Ухахаха~! Уфххххх
Dialogue: 0,1:05:14.45,1:05:15.66,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:05:23.08,1:05:24.83,Default,,0,0,0,,Мфффф...
Dialogue: 0,1:05:24.92,1:05:27.71,Default,,0,0,0,,Муфуфу муфумуфу муфуфу~!
Dialogue: 0,1:05:27.79,1:05:29.21,Default,,0,0,0,,Хмм...
Dialogue: 0,1:05:29.30,1:05:30.92,Default,,0,0,0,,О!
Dialogue: 0,1:05:33.47,1:05:34.88,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,1:05:34.97,1:05:37.09,Default,,0,0,0,,Түсіндім, сенің айтқың келгені осы!
Dialogue: 0,1:05:37.97,1:05:40.06,Default,,0,0,0,,Бұл күтпеген апат болды.
Dialogue: 0,1:05:40.14,1:05:41.52,Default,,0,0,0,,Соңында...!
Dialogue: 0,1:05:41.60,1:05:43.43,Default,,0,0,0,,О...!
Dialogue: 0,1:05:43.52,1:05:44.48,Default,,0,0,0,,Даа!
Dialogue: 0,1:05:47.98,1:05:49.90,Default,,0,0,0,,Ақырында, уақыт келді!
Dialogue: 0,1:05:49.98,1:05:51.36,Default,,0,0,0,,Тоқта, күт!
Dialogue: 0,1:05:52.49,1:05:54.07,Default,,0,0,0,,Казама-кун! Шин Чан!
Dialogue: 0,1:05:54.15,1:05:56.78,Default,,0,0,0,,Барлығының назарын сағатқа аударыңыз
Dialogue: 0,1:05:56.86,1:06:01.62,Default,,0,0,0,,Ешкім келмейтін кітапхана нағыз баратын жер еді!
Dialogue: 0,1:06:01.70,1:06:05.41,Default,,0,0,0,,Сіз қалай ойлайсыз? Нененің Суири 2 сағаттық драмаға айналды!
Dialogue: 0,1:06:05.50,1:06:07.25,Default,,0,0,0,,Бұл өзімшіл болатын уақыт емес!
Dialogue: 0,1:06:07.33,1:06:08.63,Default,,0,0,0,,Бо!
Dialogue: 0,1:06:09.25,1:06:11.13,Default,,0,0,0,,Не? өрт?
Dialogue: 0,1:06:11.21,1:06:14.09,Default,,0,0,0,,Сау бол, сорғыш!
Dialogue: 0,1:06:14.17,1:06:15.38,Default,,0,0,0,,Тс!
Dialogue: 0,1:06:16.13,1:06:17.51,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:19.39,1:06:21.43,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:06:36.53,1:06:37.91,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:06:38.86,1:06:41.83,Default,,0,0,0,,Уау!
Dialogue: 0,1:06:41.91,1:06:43.79,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:06:45.66,1:06:46.75,Default,,0,0,0,,Онигири!
Dialogue: 0,1:06:46.83,1:06:48.29,Default,,0,0,0,,Не? иә!
Dialogue: 0,1:06:49.08,1:06:51.04,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:06:51.13,1:06:52.80,Default,,0,0,0,,Жақсы сезінеді~
Dialogue: 0,1:06:54.34,1:06:56.80,Default,,0,0,0,,Уау!
Dialogue: 0,1:06:56.88,1:06:59.14,Default,,0,0,0,,Ах~ Ах~...!
Dialogue: 0,1:06:59.22,1:07:02.81,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:07:06.85,1:07:09.56,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:13.61,1:07:15.82,Default,,0,0,0,,Эй!
Dialogue: 0,1:07:17.86,1:07:20.07,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:20.16,1:07:23.78,Default,,0,0,0,,Гуе! Жақсы! Жақсы!
Dialogue: 0,1:07:23.87,1:07:26.37,Default,,0,0,0,,Күте тұрыңыз, сорғыш!
Dialogue: 0,1:07:28.37,1:07:29.46,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,1:07:33.21,1:07:35.84,Default,,0,0,0,,(заттың дыбысы)
Dialogue: 0,1:07:35.92,1:07:38.76,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:07:38.84,1:07:40.05,Default,,0,0,0,,Уф!
Dialogue: 0,1:07:40.13,1:07:43.89,Default,,0,0,0,,Иә! Ах! (ақша дыбысы)
Dialogue: 0,1:07:43.97,1:07:46.10,Default,,0,0,0,,Ахаха…
Dialogue: 0,1:07:48.14,1:07:49.85,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:49.94,1:07:50.77,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:52.06,1:07:54.07,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:55.61,1:07:57.28,Default,,0,0,0,,Ой... ой...
Dialogue: 0,1:07:57.36,1:07:58.86,Default,,0,0,0,,Сағат…
Dialogue: 0,1:07:58.94,1:08:02.20,Default,,0,0,0,,Нағашы ағаларыңды кітапханадан осылай босаттыңдар.
Dialogue: 0,1:08:02.28,1:08:04.45,Default,,0,0,0,,Қылмыс болған жерді алдау үшін!
Dialogue: 0,1:08:04.53,1:08:07.04,Default,,0,0,0,,Сол себепті мен сіңіп кеттім!
Dialogue: 0,1:08:07.83,1:08:09.50,Default,,0,0,0,,Не? иә?
Dialogue: 0,1:08:09.58,1:08:11.00,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:12.12,1:08:13.79,Default,,0,0,0,,А... Казама-кун?
Dialogue: 0,1:08:13.88,1:08:14.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:16.75,1:08:19.13,Default,,0,0,0,,Ннуну...! Казама-кун...
Dialogue: 0,1:08:19.22,1:08:20.67,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,1:08:20.76,1:08:21.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:21.68,1:08:25.05,Default,,0,0,0,,Мына лас нәрсені алыс ұстаңыз.
Dialogue: 0,1:08:25.14,1:08:26.51,Default,,0,0,0,,«Тамае»?
Dialogue: 0,1:08:27.43,1:08:30.48,Default,,0,0,0,,Ол бұрынғыдай ақымақ Казама-кун емес.
Dialogue: 0,1:08:30.56,1:08:35.44,Default,,0,0,0,,Менің жігітім - Super Elite Кадзама!
Dialogue: 0,1:08:37.07,1:08:38.40,Default,,0,0,0,,Ақымақпен ақымақ ойнағанда
Dialogue: 0,1:08:38.48,1:08:40.78,Default,,0,0,0,,Сен сондай ақымақсың! Бұл мені ақымақ етіп көрсете жаздады.
Dialogue: 0,1:08:40.86,1:08:44.82,Default,,0,0,0,,Күлкілі, күлкілі супер элита бол!
Dialogue: 0,1:08:44.91,1:08:46.20,Default,,0,0,0,,осылайша өлу – табиғи нәрсе шығар, деп ойлаймын.
Dialogue: 0,1:08:46.28,1:08:49.79,Default,,0,0,0,,Бұл кез келген адамды супер элита етеді!
Dialogue: 0,1:08:50.58,1:08:52.12,Default,,0,0,0,,Казама-кун…
Dialogue: 0,1:08:52.21,1:08:56.96,Default,,0,0,0,,Менің есептеулерім бойынша, бұл сағат бірнеше минуттан кейін өледі.
Dialogue: 0,1:08:57.04,1:08:59.42,Default,,0,0,0,,Уау! Я~!
Dialogue: 0,1:09:00.05,1:09:01.26,Default,,0,0,0,,Балақай!
Dialogue: 0,1:09:05.30,1:09:08.18,Default,,0,0,0,,Сіз де супер элита болыңыз!
Dialogue: 0,1:09:08.26,1:09:09.93,Default,,0,0,0,,Эй, гах!
Dialogue: 0,1:09:10.02,1:09:11.14,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:12.69,1:09:14.10,Default,,0,0,0,,Шин-чан!
Dialogue: 0,1:09:14.19,1:09:16.40,Default,,0,0,0,,Біздің досымыз бол...
Dialogue: 0,1:09:16.48,1:09:20.07,Default,,0,0,0,,Иә! болып табылады! болып табылады! Сонымен...
Dialogue: 0,1:09:20.15,1:09:21.40,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:21.49,1:09:22.53,Default,,0,0,0,,Әй?
Dialogue: 0,1:09:26.16,1:09:29.83,Default,,0,0,0,,Шинносукэ Super Elite жақсы.
Dialogue: 0,1:09:29.91,1:09:31.45,Default,,0,0,0,,Ақымақ болу - бұл алдау!
Dialogue: 0,1:09:31.54,1:09:32.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:36.50,1:09:39.50,Default,,0,0,0,,Иә!
Dialogue: 0,1:09:41.63,1:09:43.51,Default,,0,0,0,,Біз доспыз!
Dialogue: 0,1:09:43.59,1:09:45.55,Default,,0,0,0,,Жұмысты оңаша қалдыр, Шинносуке.
Dialogue: 0,1:09:45.63,1:09:48.14,Default,,0,0,0,,Сіз мұны өткен күні жасаған жоқсыз ба?
Dialogue: 0,1:09:48.97,1:09:51.10,Default,,0,0,0,,А, жоқ!
Dialogue: 0,1:09:51.18,1:09:54.81,Default,,0,0,0,,Бастауыш мектеп, орта мектеп, орта мектеп: Мен элитаның жолын ұстанамын!
Dialogue: 0,1:09:56.06,1:09:59.40,Default,,0,0,0,,Сіздермен... Қош болыңыздар!
Dialogue: 0,1:09:59.48,1:10:00.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:00.82,1:10:04.19,Default,,0,0,0,,Әртүрлі деңгейлі достар - бұл босқа!
Dialogue: 0,1:10:04.28,1:10:05.45,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:05.53,1:10:07.11,Default,,0,0,0,,Мен ақыры түсіндім
Dialogue: 0,1:10:07.20,1:10:08.24,Default,,0,0,0,,Сонымен...!
Dialogue: 0,1:10:12.20,1:10:15.00,Default,,0,0,0,,Сіз де супер элита бола аласыз.
Dialogue: 0,1:10:15.08,1:10:17.46,Default,,0,0,0,,Сіз мен сияқты жүре аласыз.
Dialogue: 0,1:10:17.54,1:10:21.09,Default,,0,0,0,,Казама-кун! Не айтып тұрғаныңызды түсінбеймін!
Dialogue: 0,1:10:21.17,1:10:22.05,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:10:22.96,1:10:26.01,Default,,0,0,0,,Идиоттар супер элиталардың айтқанын түсінбейді.
Dialogue: 0,1:10:26.97,1:10:29.05,Default,,0,0,0,,Мен де сені сорамын!
Dialogue: 0,1:10:29.18,1:10:30.26,Default,,0,0,0,,Бучу~! (Вампир) Уау!
Dialogue: 0,1:10:30.35,1:10:32.97,Default,,0,0,0,,Ба... ақымақ, тоқтат! Эй! Эй!
Dialogue: 0,1:10:37.23,1:10:38.40,Default,,0,0,0,,Бетіңізді көрсетіңіз!
Dialogue: 0,1:10:38.48,1:10:40.36,Default,,0,0,0,,Не! Апыр-ай!
Dialogue: 0,1:10:40.44,1:10:42.15,Default,,0,0,0,,Ннунуну...!
Dialogue: 0,1:10:42.23,1:10:43.78,Default,,0,0,0,,Не! Ах!
Dialogue: 0,1:10:43.86,1:10:47.95,Default,,0,0,0,,Ммм...!
Dialogue: 0,1:10:48.03,1:10:48.86,Default,,0,0,0,,Буха!
Dialogue: 0,1:10:49.74,1:10:50.70,Default,,0,0,0,,Эй!
Dialogue: 0,1:10:50.78,1:10:52.28,Default,,0,0,0,,Шин-чан!
Dialogue: 0,1:10:57.96,1:10:59.92,Default,,0,0,0,,Шин-чан, асығыңыз!
Dialogue: 0,1:11:00.92,1:11:02.29,Default,,0,0,0,,Гя~ Казама-кун!
Dialogue: 0,1:11:03.84,1:11:07.84,Default,,0,0,0,,(Сейтоның айқайы)
Dialogue: 0,1:11:17.81,1:11:20.02,Default,,0,0,0,,Ittatata...
Dialogue: 0,1:11:20.77,1:11:21.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:21.77,1:11:23.65,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:11:23.73,1:11:25.23,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:25.32,1:11:27.19,Default,,0,0,0,,Бүгін ойын ойнаймыз ба?
Dialogue: 0,1:11:30.74,1:11:31.57,Default,,0,0,0,,Шин-чан!
Dialogue: 0,1:11:32.57,1:11:34.49,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:11:35.62,1:11:37.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:37.58,1:11:39.96,Default,,0,0,0,,Гуг! Гуг!
Dialogue: 0,1:11:40.04,1:11:43.17,Default,,0,0,0,,Иә! Хмм...
Dialogue: 0,1:11:43.25,1:11:44.92,Default,,0,0,0,,Роро-сан, иә?
Dialogue: 0,1:11:45.00,1:11:46.55,Default,,0,0,0,,Дыбыстық сигнал! Дыбыс...
Dialogue: 0,1:11:46.63,1:11:48.88,Default,,0,0,0,,Бала Буджи
Dialogue: 0,1:11:48.97,1:11:50.38,Default,,0,0,0,,А...
Dialogue: 0,1:11:55.72,1:11:57.31,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,1:11:57.39,1:12:00.27,Default,,0,0,0,,Жақсы... Жақсы!
Dialogue: 0,1:12:09.07,1:12:11.16,Default,,0,0,0,,Шин-чан! барлығы!
Dialogue: 0,1:12:11.24,1:12:12.66,Default,,0,0,0,,Мен жаңа ғана сағат көрдім...
Dialogue: 0,1:12:12.74,1:12:15.62,Default,,0,0,0,,Казама-кун және вампир...
Dialogue: 0,1:12:15.70,1:12:16.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:16.74,1:12:18.58,Default,,0,0,0,,Ол сонда қашып кетті.
Dialogue: 0,1:12:21.29,1:12:22.12,Default,,0,0,0,,Әй!
Dialogue: 0,1:12:23.67,1:12:26.13,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? Бітті
Dialogue: 0,1:12:26.21,1:12:28.09,Default,,0,0,0,,Сабырлы болыңыз. Бұл жақсы емес.
Dialogue: 0,1:12:28.17,1:12:32.05,Default,,0,0,0,,(Қатты дауыс)
Dialogue: 0,1:12:32.89,1:12:34.39,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:35.26,1:12:36.39,Default,,0,0,0,,Чишио-чан?
Dialogue: 0,1:12:36.47,1:12:37.60,Default,,0,0,0,,Не болды?
Dialogue: 0,1:12:37.68,1:12:38.85,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,1:12:38.93,1:12:41.60,Default,,0,0,0,,Мен әлі де жүгіре алмаймын
Dialogue: 0,1:12:41.69,1:12:42.77,Default,,0,0,0,,Чишио-чан...
Dialogue: 0,1:12:42.85,1:12:44.31,Default,,0,0,0,,Мен жүгіре алмаймын...
Dialogue: 0,1:12:44.40,1:12:46.94,Default,,0,0,0,,Өйткені мен...
Dialogue: 0,1:12:48.36,1:12:51.32,Default,,0,0,0,,Мен жүгірсем, біртүрлі көрінемін!
Dialogue: 0,1:12:51.40,1:12:52.24,Default,,0,0,0,,Не!
Dialogue: 0,1:12:52.32,1:12:54.45,Default,,0,0,0,,Біртүрлі тұлға?
Dialogue: 0,1:12:54.53,1:12:57.03,Default,,0,0,0,,Мм... нені айтып тұрсың?
Dialogue: 0,1:12:58.49,1:13:01.75,Default,,0,0,0,,Мен кішкентай кезімнен жүгіруді жақсы көремін.
Dialogue: 0,1:13:01.83,1:13:05.42,Default,,0,0,0,,Егер мен марафонға қатысса, жаңа рекорд жазар едім.
Dialogue: 0,1:13:05.50,1:13:08.75,Default,,0,0,0,,Әкем мен шешем де қуанып қалды.
Dialogue: 0,1:13:09.46,1:13:11.76,Default,,0,0,0,,Бірақ сіз неғұрлым жылдам жүгірсеңіз
Dialogue: 0,1:13:11.76,1:13:13.26,Default,,0,0,0,,Бірақ сіз неғұрлым жылдам жүгірсеңіз
Dialogue: 0,1:13:11.76,1:13:13.26,Default,,0,0,0,,(Қатты дауыс)
Dialogue: 0,1:13:13.26,1:13:13.34,Default,,0,0,0,,(Қатты дауыс)
Dialogue: 0,1:13:13.34,1:13:16.35,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,1:13:13.34,1:13:16.35,Default,,0,0,0,,Менің түрім біртүрлі болса да, олар мені мазақтайды
Dialogue: 0,1:13:17.30,1:13:20.22,Default,,0,0,0,,Ол гей жүзімен жүгіретін гей...
Dialogue: 0,1:13:20.31,1:13:22.27,Default,,0,0,0,,(Дауыс)
Dialogue: 0,1:13:22.35,1:13:25.60,Default,,0,0,0,,Қорыққаным сонша, енді басқалардың алдынан жүгіре алмаймын.
Dialogue: 0,1:13:25.69,1:13:28.19,Default,,0,0,0,,Бірақ мен жүгіргенді жақсы көремін...
Dialogue: 0,1:13:28.27,1:13:31.82,Default,,0,0,0,,Түн ортасында жалғыз жасырынып жүрдің.
Dialogue: 0,1:13:31.90,1:13:33.70,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,1:13:33.78,1:13:36.57,Default,,0,0,0,,Мен сені қатты жақсы көрсем де, бас тартқаныңа сене алар емеспін!
Dialogue: 0,1:13:36.66,1:13:38.87,Default,,0,0,0,,Нуо~!
Dialogue: 0,1:13:38.95,1:13:41.75,Default,,0,0,0,,Мен Казама-куннан ешқашан бас тартпаймын!
Dialogue: 0,1:13:43.79,1:13:44.71,Default,,0,0,0,,Әй?
Dialogue: 0,1:13:44.79,1:13:46.75,Default,,0,0,0,,Не болды?
Dialogue: 0,1:13:46.83,1:13:48.67,Default,,0,0,0,,Бұл не? Тырнақтар?
Dialogue: 0,1:13:53.17,1:13:54.55,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:13:58.14,1:14:01.97,Default,,0,0,0,,Оххх...!
Dialogue: 0,1:14:02.06,1:14:04.02,Default,,0,0,0,,Тоқта... Тоқта, Шин Чан?
Dialogue: 0,1:14:04.10,1:14:04.94,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:14:05.02,1:14:07.40,Default,,0,0,0,,Шин Чан ойланып отыр!
Dialogue: 0,1:14:10.69,1:14:12.57,Default,,0,0,0,,Шин-чан бас емес!
Dialogue: 0,1:14:15.15,1:14:17.53,Default,,0,0,0,,Аяқпен ойлайтын тип бол!
Dialogue: 0,1:14:26.46,1:14:30.09,Default,,0,0,0,,Окайкецу~!
Dialogue: 0,1:14:34.17,1:14:38.18,Default,,0,0,0,,～…
Dialogue: 0,1:14:44.60,1:14:47.10,Default,,0,0,0,,О, мен түсіндім.
Dialogue: 0,1:14:48.02,1:14:49.15,Default,,0,0,0,,Е...
Dialogue: 0,1:14:49.23,1:14:51.36,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:53.90,1:14:55.78,Default,,0,0,0,,(Миса күрсінуі)
Dialogue: 0,1:14:55.86,1:14:59.07,Default,,0,0,0,,Шинносуке маған мүлдем телефон соқпайды...
Dialogue: 0,1:14:59.16,1:15:00.99,Default,,0,0,0,,Жалғыздық сезілмейді ме екен...
Dialogue: 0,1:15:01.07,1:15:03.16,Default,,0,0,0,,Дәлірек айтсақ, өзімді жалғыз сезінемін.
Dialogue: 0,1:15:03.24,1:15:04.75,Default,,0,0,0,,Эй, эй... Эй, эй~
Dialogue: 0,1:15:04.83,1:15:07.92,Default,,0,0,0,,Тағы бір синбо
Dialogue: 0,1:15:08.00,1:15:10.21,Default,,0,0,0,,Ертең мен гриль ет жеймін!
Dialogue: 0,1:15:10.29,1:15:11.96,Default,,0,0,0,,Не? Жақсы!
Dialogue: 0,1:15:12.04,1:15:13.34,Default,,0,0,0,,О, жоқ, жоқ!
Dialogue: 0,1:15:13.42,1:15:16.80,Default,,0,0,0,,Ертең келетін уақыт болды, ағайын.
Dialogue: 0,1:15:16.88,1:15:19.05,Default,,0,0,0,,…
Dialogue: 0,1:15:25.02,1:15:28.31,Default,,0,0,0,,Нақты сағат пен сағатқа келетін болсақ.
Dialogue: 0,1:15:28.39,1:15:30.23,Default,,0,0,0,,Гензай қызу жүріп жатыр
Dialogue: 0,1:15:30.85,1:15:35.19,Default,,0,0,0,,Элиталардың жұмыртқалары ретінде мен сіз мұны түсінетініңізге сенімдімін, бірақ...
Dialogue: 0,1:15:35.28,1:15:39.15,Default,,0,0,0,,Ешқашан бөгде адамдарға өсек таратпаңыз.
Dialogue: 0,1:15:39.24,1:15:42.32,Default,,0,0,0,,Бұл элита болудың төте жолы.
Dialogue: 0,1:15:42.41,1:15:44.12,Default,,0,0,0,,～ （）
Dialogue: 0,1:15:46.50,1:15:47.33,Default,,0,0,0,,...
Dialogue: 0,1:15:47.41,1:15:49.29,Default,,0,0,0,,Касукабе детектив клубы!
Dialogue: 0,1:15:49.37,1:15:51.17,Default,,0,0,0,,Сукиецу Демон Джикен!
Dialogue: 0,1:15:51.25,1:15:52.71,Default,,0,0,0,,Сенің есегің жарылып кетеді~
Dialogue: 0,1:15:52.79,1:15:53.84,Default,,0,0,0,,Уф...
Dialogue: 0,1:15:53.92,1:15:54.92,Default,,0,0,0,,Бұл сүйкімді!
Dialogue: 0,1:15:55.00,1:15:55.84,Default,,0,0,0,,Әй?
Dialogue: 0,1:16:03.35,1:16:06.22,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар? Не айтқың келеді?
Dialogue: 0,1:16:06.85,1:16:08.48,Default,,0,0,0,,Түсіңіз!
Dialogue: 0,1:16:09.39,1:16:11.56,Default,,0,0,0,,Барлығың тыңдаңдар!
Dialogue: 0,1:16:11.65,1:16:12.94,Default,,0,0,0,,Вампир бұл...
Dialogue: 0,1:16:13.02,1:16:15.90,Default,,0,0,0,,Ол осында.
Dialogue: 0,1:16:15.98,1:16:17.15,Default,,0,0,0,,Не!
Dialogue: 0,1:16:23.32,1:16:25.12,Default,,0,0,0,,...
Dialogue: 0,1:16:31.04,1:16:33.42,Default,,0,0,0,,Е, мен... Мен емеспін.
Dialogue: 0,1:16:35.29,1:16:38.42,Default,,0,0,0,,～
Dialogue: 0,1:16:39.05,1:16:40.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:41.22,1:16:42.34,Default,,0,0,0,,О...
Dialogue: 0,1:16:42.43,1:16:43.97,Default,,0,0,0,,～
Dialogue: 0,1:16:44.05,1:16:45.93,Default,,0,0,0,,Очичи Очичи~ (Сейтоның айқайы)
Dialogue: 0,1:16:46.01,1:16:46.85,Default,,0,0,0,,Ошиочичи~ Эй, бұл...!
Dialogue: 0,1:16:46.93,1:16:48.39,Default,,0,0,0,,Сасуга вампир ме?
Dialogue: 0,1:16:48.47,1:16:50.64,Default,,0,0,0,,...
Dialogue: 0,1:16:50.73,1:16:52.60,Default,,0,0,0,,Очи Очичи~ Очи Очичи~
Dialogue: 0,1:16:52.69,1:16:54.69,Default,,0,0,0,,Очичи Очичи~
Dialogue: 0,1:16:54.77,1:16:57.52,Default,,0,0,0,,～ ～
Dialogue: 0,1:16:57.61,1:16:59.94,Default,,0,0,0,,Әй, әрекет маскасы!
Dialogue: 0,1:17:00.03,1:17:02.07,Default,,0,0,0,,Оны Сасуга-кун жасаған.
Dialogue: 0,1:17:02.15,1:17:02.99,Default,,0,0,0,,Иә
Dialogue: 0,1:17:04.53,1:17:06.53,Default,,0,0,0,,Біз мұны жасадық.
Dialogue: 0,1:17:06.62,1:17:07.95,Default,,0,0,0,,Әрекет маскасы!
Dialogue: 0,1:17:08.04,1:17:09.41,Default,,0,0,0,,Дәл солай
Dialogue: 0,1:17:10.12,1:17:13.87,Default,,0,0,0,,Сіз Action Mask бағдарламасын білмейсіз, сондықтан сіз біздікін көшіріп алдыңыз.
Dialogue: 0,1:17:13.96,1:17:16.59,Default,,0,0,0,,Эхехе ~ уккки ~ еліктеді
Dialogue: 0,1:17:16.67,1:17:17.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:17:17.92,1:17:20.38,Default,,0,0,0,,Қарап көріңізші!
Dialogue: 0,1:17:20.46,1:17:23.05,Default,,0,0,0,,Біздің әрекет тақтасы!
Dialogue: 0,1:17:23.13,1:17:26.30,Default,,0,0,0,,Сасуга-кунның әрекет маскасы
Dialogue: 0,1:17:26.39,1:17:28.31,Default,,0,0,0,,Мен оны дәл көшіріп жатырмын деп ойладым, бірақ...
Dialogue: 0,1:17:28.39,1:17:32.77,Default,,0,0,0,,Оның ақылды болғаны сонша, ол тек дұрыс канжиді жазды.
Dialogue: 0,1:17:32.85,1:17:35.48,Default,,0,0,0,,Сонда сіз гек болып көріндіңіз бе?
Dialogue: 0,1:17:36.52,1:17:38.19,Default,,0,0,0,,Бұл не? иә?
Dialogue: 0,1:17:38.94,1:17:41.57,Default,,0,0,0,,Ол вампирдің денесіне бекітілген.
Dialogue: 0,1:17:42.40,1:17:44.15,Default,,0,0,0,,Сені басып озғым келеді.
Dialogue: 0,1:17:44.95,1:17:45.78,Default,,0,0,0,,Шаянның жағасы?
Dialogue: 0,1:17:45.86,1:17:47.45,Default,,0,0,0,,Пинг Донг!
Dialogue: 0,1:17:47.53,1:17:52.04,Default,,0,0,0,,Сасуга-кун бұл мектепте краб жей алатын жалғыз адам!
Dialogue: 0,1:17:52.12,1:17:53.50,Default,,0,0,0,,Шаян... Шаян краб~!
Dialogue: 0,1:17:53.58,1:17:55.96,Default,,0,0,0,,Сіз ақымақ болып көрінсеңіз де, қажетсіз шашыңыз қалады!
Dialogue: 0,1:17:56.58,1:18:00.21,Default,,0,0,0,,Бұл хабарды Казама-кун қалдырған
Dialogue: 0,1:18:00.96,1:18:02.84,Default,,0,0,0,,33？
Dialogue: 0,1:18:02.92,1:18:05.68,Default,,0,0,0,,Бұл 33 емес
Dialogue: 0,1:18:05.76,1:18:06.59,Default,,0,0,0,,Қараңдар!
Dialogue: 0,1:18:12.02,1:18:14.27,Default,,0,0,0,,Бұл Сасуга-кунның көзі!
Dialogue: 0,1:18:14.35,1:18:15.19,Default,,0,0,0,,Жоқ! Хм... Иә? Апыр-ай!
Dialogue: 0,1:18:15.19,1:18:17.73,Default,,0,0,0,,Жоқ! Хм... Иә? Апыр-ай!
Dialogue: 0,1:18:15.19,1:18:17.73,Default,,0,0,0,,Казама-кун көрді!
Dialogue: 0,1:18:20.07,1:18:20.94,Default,,0,0,0,,Мына көздер!
Dialogue: 0,1:18:21.02,1:18:23.44,Default,,0,0,0,,Гах...
Dialogue: 0,1:18:23.53,1:18:27.11,Default,,0,0,0,,Сіз менің барлық бөкселерімді анық көре аласыз!
Dialogue: 0,1:18:27.20,1:18:29.41,Default,,0,0,0,,Бұл нағыз ақымақ!
Dialogue: 0,1:18:29.49,1:18:30.49,Default,,0,0,0,,Уау...
Dialogue: 0,1:18:30.58,1:18:32.99,Default,,0,0,0,,Шынайы нәрсе басқаша.
Dialogue: 0,1:18:33.58,1:18:35.37,Default,,0,0,0,,Сондай-ақ бонус~ Иә? Апыр-ай!
Dialogue: 0,1:18:36.71,1:18:38.83,Default,,0,0,0,,Кешегі хикки
Dialogue: 0,1:18:40.92,1:18:43.55,Default,,0,0,0,,Сөйле! Арх... ха ха...
Dialogue: 0,1:18:43.63,1:18:45.38,Default,,0,0,0,,Сасуга-кун...
Dialogue: 0,1:18:47.09,1:18:49.47,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,1:18:50.97,1:18:52.35,Default,,0,0,0,,Бұл...
Dialogue: 0,1:18:54.93,1:18:57.39,Default,,0,0,0,,Сіз туралы!
Dialogue: 0,1:18:57.48,1:18:59.86,Default,,0,0,0,,Өйткені маған ұнайды!
Dialogue: 0,1:18:59.94,1:19:02.82,Default,,0,0,0,,(жаңғырық дауыс)
Dialogue: 0,1:19:04.61,1:19:05.78,Default,,0,0,0,,Не!
Dialogue: 0,1:19:05.86,1:19:10.28,Default,,0,0,0,,Не? иә? иә? Дододо... Не айтып тұрсың?
Dialogue: 0,1:19:11.83,1:19:13.49,Default,,0,0,0,,Барлығы біле бермейді...
Dialogue: 0,1:19:14.12,1:19:16.46,Default,,0,0,0,,1. Мен жалғызбын...
Dialogue: 0,1:19:16.54,1:19:17.71,Default,,0,0,0,,Әй, мына кісіні қарашы! Эй...
Dialogue: 0,1:19:17.71,1:19:19.04,Default,,0,0,0,,Әй, мына кісіні қарашы! Эй…
Dialogue: 0,1:19:17.71,1:19:19.04,Default,,0,0,0,,Барлығы мен туралы
Dialogue: 0,1:19:19.12,1:19:20.79,Default,,0,0,0,,Иә...
Dialogue: 0,1:19:19.12,1:19:20.79,Default,,0,0,0,,Мен сені тек жақсы адам ретінде көремін...
Dialogue: 0,1:19:20.79,1:19:22.00,Default,,0,0,0,,Мен сені тек жақсы адам ретінде көремін...
Dialogue: 0,1:19:22.09,1:19:25.63,Default,,0,0,0,,Мен мұндай ортаға үйреніп қалдым.
Dialogue: 0,1:19:28.01,1:19:29.43,Default,,0,0,0,,Осындай кезде...
Dialogue: 0,1:19:29.51,1:19:32.85,Default,,0,0,0,,Иә? Сасуга-кун, сен не оқып жатырсың?
Dialogue: 0,1:19:32.93,1:19:34.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:34.89,1:19:37.23,Default,,0,0,0,,1.
Dialogue: 0,1:19:37.31,1:19:40.31,Default,,0,0,0,,Сізбен әдеттегідей сөйлесуге рұқсат берген жалғыз адамсыз...
Dialogue: 0,1:19:41.19,1:19:43.15,Default,,0,0,0,,Сасуга-кун, сен мұны істей аласың ба?
Dialogue: 0,1:19:43.23,1:19:44.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:45.32,1:19:46.78,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,1:19:47.94,1:19:50.20,Default,,0,0,0,,Сіз енді жүгіре алмайсыз
Dialogue: 0,1:19:50.28,1:19:52.62,Default,,0,0,0,,Ол он топтан жоғалып кеткенше...
Dialogue: 0,1:19:56.20,1:19:59.66,Default,,0,0,0,,Мен бас тарта алмадым...
Dialogue: 0,1:20:01.04,1:20:02.63,Default,,0,0,0,,Сіз бір нәрседен шаршадыңыз ба?
Dialogue: 0,1:20:02.71,1:20:05.21,Default,,0,0,0,,Мен Отсумунмен кеңестім.
Dialogue: 0,1:20:05.30,1:20:07.59,Default,,0,0,0,,Мен сені 10-сыныпқа қайтарғаным жөн.
Dialogue: 0,1:20:08.26,1:20:09.59,Default,,0,0,0,,Мен оны жинадым
Dialogue: 0,1:20:09.67,1:20:12.68,Default,,0,0,0,,Құпия супер элиталық бағдарлама бар
Dialogue: 0,1:20:12.76,1:20:14.55,Default,,0,0,0,,Супер элита?
Dialogue: 0,1:20:14.64,1:20:15.64,Default,,0,0,0,,Үміттенемін
Dialogue: 0,1:20:15.72,1:20:18.10,Default,,0,0,0,,Чишио-сан 10-сыныпқа орала алады.
Dialogue: 0,1:20:18.18,1:20:19.02,Default,,0,0,0,,Уау...!
Dialogue: 0,1:20:19.10,1:20:21.98,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,1:20:22.06,1:20:23.77,Default,,0,0,0,,Және мен
Dialogue: 0,1:20:23.86,1:20:26.44,Default,,0,0,0,,Кітапханаға ешкім сене алмайтын үй сал.
Dialogue: 0,1:20:27.19,1:20:28.90,Default,,0,0,0,,Барлығының көзі сағатпен жүруі үшін.
Dialogue: 0,1:20:30.11,1:20:32.82,Default,,0,0,0,,Мен вампирлер туралы өсек таратамын.
Dialogue: 0,1:20:33.91,1:20:36.83,Default,,0,0,0,,Допты жұлып алған адам — біздің Хью Хадсон мектебінің мақтанышы —
Dialogue: 0,1:20:36.91,1:20:38.83,Default,,0,0,0,,Бұл...
Dialogue: 0,1:20:38.91,1:20:41.79,Default,,0,0,0,,Сол себепті бәрін жеміс ұстаушыға айналдырдыңыз ба?
Dialogue: 0,1:20:41.87,1:20:42.79,Default,,0,0,0,,Казама-кун да!
Dialogue: 0,1:20:43.96,1:20:46.17,Default,,0,0,0,,Мен ештеңе істей алмадым ...
Dialogue: 0,1:20:46.92,1:20:47.75,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:20:49.26,1:20:51.34,Default,,0,0,0,,Сіз туралы!
Dialogue: 0,1:20:51.42,1:20:53.30,Default,,0,0,0,,Өйткені маған ұнайды!
Dialogue: 0,1:20:53.39,1:20:54.59,Default,,0,0,0,,Әй!
Dialogue: 0,1:20:57.14,1:20:59.27,Default,,0,0,0,,Ах!Уф...
Dialogue: 0,1:21:00.18,1:21:02.02,Default,,0,0,0,,Сен үлкен ақымақ!
Dialogue: 0,1:21:02.10,1:21:04.98,Default,,0,0,0,,(дауыссыз)
Dialogue: 0,1:21:05.06,1:21:07.52,Default,,0,0,0,,Шық!
Dialogue: 0,1:21:07.61,1:21:08.44,Default,,0,0,0,,Бұл...
Dialogue: 0,1:21:08.53,1:21:10.24,Default,,0,0,0,,Сіз не қалайсыз
Dialogue: 0,1:21:10.32,1:21:13.74,Default,,0,0,0,,Бұл жердің асқан шеберлікпен элита жасайтын түрі.
Dialogue: 0,1:21:13.82,1:21:16.41,Default,,0,0,0,,Не? Мен осындай нәрсе жасағым келді ...
Dialogue: 0,1:21:16.49,1:21:18.37,Default,,0,0,0,,Сіз айтқандай
Dialogue: 0,1:21:19.87,1:21:22.83,Default,,0,0,0,,Отсумун! Курицу әлі нашар!
Dialogue: 0,1:21:22.91,1:21:24.25,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:22.91,1:21:24.25,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:21:24.25,1:21:25.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:21:25.13,1:21:26.46,Default,,0,0,0,,Қосымша чача
Dialogue: 0,1:21:26.54,1:21:29.25,Default,,0,0,0,,Сейто мен оның достарының академиялық деңгейін көтеріңіз!
Dialogue: 0,1:21:29.34,1:21:30.55,Default,,0,0,0,,Қалай?
Dialogue: 0,1:21:30.63,1:21:34.01,Default,,0,0,0,,Ха... Соны ойлау сенің міндетің!
Dialogue: 0,1:21:34.09,1:21:35.97,Default,,0,0,0,,Мен көмек сұрадым
Dialogue: 0,1:21:36.05,1:21:37.43,Default,,0,0,0,,Чача тона!
Dialogue: 0,1:21:37.51,1:21:38.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:38.51,1:21:40.10,Default,,0,0,0,,Бұл рас.
Dialogue: 0,1:21:40.18,1:21:42.02,Default,,0,0,0,,Қарғыс атсын... бірақ
Dialogue: 0,1:21:42.10,1:21:44.31,Default,,0,0,0,,Осындай нәрсе сізді шынымен элита етеді...
Dialogue: 0,1:21:45.02,1:21:46.77,Default,,0,0,0,,Дос болайық!
Dialogue: 0,1:21:53.36,1:21:54.65,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:22:00.66,1:22:02.04,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:22:02.12,1:22:03.83,Default,,0,0,0,,Рахмет! (Масуо) Ия!
Dialogue: 0,1:22:04.66,1:22:05.50,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:05.58,1:22:08.96,Default,,0,0,0,,Алу, бөлу, лақтыру?
Dialogue: 0,1:22:09.04,1:22:11.21,Default,,0,0,0,,Супер элиталық заттар.
Dialogue: 0,1:22:12.38,1:22:14.42,Default,,0,0,0,,Менің жігітіме қарашы.
Dialogue: 0,1:22:14.51,1:22:15.88,Default,,0,0,0,,Ах! а?
Dialogue: 0,1:22:17.68,1:22:20.31,Default,,0,0,0,,О, элита! Бұл керемет!
Dialogue: 0,1:22:24.60,1:22:25.77,Default,,0,0,0,,Раушан
Dialogue: 0,1:22:25.85,1:22:27.69,Default,,0,0,0,,Еш ойланбастан, тегіс...
Dialogue: 0,1:22:27.69,1:22:28.98,Default,,0,0,0,,Еш ойланбастан, тегіс...
Dialogue: 0,1:22:29.06,1:22:31.73,Default,,0,0,0,,Мен супер элитамын
Dialogue: 0,1:22:31.82,1:22:34.90,Default,,0,0,0,,Казама-кун Касукабе қорғаныс күштерінен, солай ма?
Dialogue: 0,1:22:34.99,1:22:37.20,Default,,0,0,0,,О, тәңірім.
Dialogue: 0,1:22:40.20,1:22:43.37,Default,,0,0,0,,Балаларымның ойынына ілесе алмаймын.
Dialogue: 0,1:22:43.45,1:22:46.96,Default,,0,0,0,,Сіз де супер элита болған кезде түсінесіз.
Dialogue: 0,1:22:47.04,1:22:48.17,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,1:22:48.88,1:22:50.59,Default,,0,0,0,,Мен достарыммен ұрысып қалдым.
Dialogue: 0,1:22:50.67,1:22:53.17,Default,,0,0,0,,Басқамен салыстырғанда күрделі сезім
Dialogue: 0,1:22:53.25,1:22:56.01,Default,,0,0,0,,Қиын болу, қиналу, уайымдау
Dialogue: 0,1:22:56.09,1:22:59.01,Default,,0,0,0,,Енді босқа кететін уақыт болмайды.
Dialogue: 0,1:22:59.80,1:23:02.35,Default,,0,0,0,,Тікелей элитаға
Dialogue: 0,1:23:02.43,1:23:06.23,Default,,0,0,0,,Бұл құралды пайдалансаңыз, сіз де ол сияқты бірінші нөмірлі элита бола аласыз...
Dialogue: 0,1:23:06.31,1:23:07.98,Default,,0,0,0,,Жоқ! (Казама-кун) А?
Dialogue: 0,1:23:08.06,1:23:10.94,Default,,0,0,0,,Казама-кун әлі бірінші нөмір емес!
Dialogue: 0,1:23:11.02,1:23:12.69,Default,,0,0,0,,Бірақ… маған сәл ертерек айтсаң жақсы болар еді.
Dialogue: 0,1:23:13.23,1:23:15.61,Default,,0,0,0,,Якисоба нанын алған сол.
Dialogue: 0,1:23:15.69,1:23:16.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:16.99,1:23:18.74,Default,,0,0,0,,Якисоба наны?
Dialogue: 0,1:23:18.82,1:23:20.87,Default,,0,0,0,,Мен оны Кобай клубынан ала аламын ба?
Dialogue: 0,1:23:20.95,1:23:22.78,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,1:23:22.87,1:23:24.79,Default,,0,0,0,,Элита болудан гөрі
Dialogue: 0,1:23:24.87,1:23:26.71,Default,,0,0,0,,Якисоба нанын алған дұрыс
Dialogue: 0,1:23:26.79,1:23:28.83,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,1:23:28.92,1:23:31.00,Default,,0,0,0,,Сіз жаялық туралы білмейсіз бе?
Dialogue: 0,1:23:31.08,1:23:32.29,Default,,0,0,0,,Бұл Отсумун.
Dialogue: 0,1:23:32.38,1:23:34.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:23:34.09,1:23:37.30,Default,,0,0,0,,Мен саған сол якисоба нанын қалай алуға болатынын көрсетемін.
Dialogue: 0,1:23:37.38,1:23:39.26,Default,,0,0,0,,Сіз алатын нәрсе - Ола!
Dialogue: 0,1:23:39.34,1:23:42.22,Default,,0,0,0,,Мен супер элитамын.
Dialogue: 0,1:23:42.30,1:23:45.18,Default,,0,0,0,,Менің атым Шинносуке Нохара!
Dialogue: 0,1:23:45.27,1:23:47.64,Default,,0,0,0,,Аа, мен жеңсем ше?
Dialogue: 0,1:23:47.73,1:23:51.19,Default,,0,0,0,,Бүкіл мектепті супер элитаға айналдырайық.
Dialogue: 0,1:23:51.27,1:23:52.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:52.98,1:23:55.86,Default,,0,0,0,,Әрине сен де, Шинносуке.
Dialogue: 0,1:23:55.94,1:23:58.61,Default,,0,0,0,,Жақсы, бірақ Ола жеңсе.
Dialogue: 0,1:23:58.70,1:24:02.20,Default,,0,0,0,,Казама-кун Касукабе қорғаныс күштеріне қайтып келеді!
Dialogue: 0,1:24:02.28,1:24:03.95,Default,,0,0,0,,Ашуланайық
Dialogue: 0,1:24:04.78,1:24:06.66,Default,,0,0,0,,Олай болса бүгін 12:00-ден бастап
Dialogue: 0,1:24:06.75,1:24:10.87,Default,,0,0,0,,Біз «Якисоба нан сатып алу марафонын» өткіземіз
Dialogue: 0,1:24:10.96,1:24:13.92,Default,,0,0,0,,Айтпақшы, Қобай клубы осында.
Dialogue: 0,1:24:16.21,1:24:18.01,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:18.09,1:24:20.18,Default,,0,0,0,,Мен марафонға қатыса алмаймын.
Dialogue: 0,1:24:20.26,1:24:21.38,Default,,0,0,0,,Керемет жұмыс
Dialogue: 0,1:24:21.47,1:24:24.60,Default,,0,0,0,,Казама-кун 5 жаста, Ора мен басқалар сияқты!
Dialogue: 0,1:24:24.68,1:24:27.85,Default,,0,0,0,,Бұл бірдей емес. Ол...
Dialogue: 0,1:24:50.54,1:24:53.00,Default,,0,0,0,,Мерзімі аяқталуға дәл соңғы сәтте болса да—
Dialogue: 0,1:24:57.50,1:24:58.67,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:24:58.76,1:25:01.38,Default,,0,0,0,,Бұл Super Elite Кадзама-san!
Dialogue: 0,1:25:01.47,1:25:03.59,Default,,0,0,0,,Әлде... Казама-сан?
Dialogue: 0,1:25:03.68,1:25:05.85,Default,,0,0,0,,Бұл алдау, сен жалғыз роботсың!
Dialogue: 0,1:25:05.93,1:25:08.56,Default,,0,0,0,,Бұл алдау емес, бұл шындық.
Dialogue: 0,1:25:08.64,1:25:11.06,Default,,0,0,0,,Оған ие болғандар күшейе алады
Dialogue: 0,1:25:11.14,1:25:14.02,Default,,0,0,0,,Бұл дүниеде ең мықтысы аман қалады!
Dialogue: 0,1:25:14.10,1:25:16.82,Default,,0,0,0,,Бұлай жеңу мүмкін емес...
Dialogue: 0,1:25:16.90,1:25:17.73,Default,,0,0,0,,Бо…
Dialogue: 0,1:25:17.82,1:25:19.48,Default,,0,0,0,,Мм...!
Dialogue: 0,1:25:25.82,1:25:27.45,Default,,0,0,0,,Бұл робот тәрізді нәрсе.
Dialogue: 0,1:25:27.53,1:25:29.20,Default,,0,0,0,,Марафон...
Dialogue: 0,1:25:29.70,1:25:32.58,Default,,0,0,0,,Жеңілме, жеңесің
Dialogue: 0,1:25:32.66,1:25:34.46,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:25:34.54,1:25:36.00,Default,,0,0,0,,Егер біз жеңілсек, біз
Dialogue: 0,1:25:36.08,1:25:38.25,Default,,0,0,0,,Сіз супер элита боласыз ба?
Dialogue: 0,1:25:38.34,1:25:39.63,Default,,0,0,0,,Маған бұл ұнамайды!
Dialogue: 0,1:25:39.71,1:25:40.55,Default,,0,0,0,,Бо…
Dialogue: 0,1:25:40.63,1:25:43.17,Default,,0,0,0,,Біз Казама-кунды қайтаруымыз керек!
Dialogue: 0,1:25:43.26,1:25:45.72,Default,,0,0,0,,Қайтпасам жақсы болар деп ойлаймын.
Dialogue: 0,1:25:45.80,1:25:46.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:46.72,1:25:49.51,Default,,0,0,0,,Казама-кун элита болғысы келді.
Dialogue: 0,1:25:49.60,1:25:52.52,Default,,0,0,0,,Супер элита болып қалған дұрыс
Dialogue: 0,1:25:52.60,1:25:55.06,Default,,0,0,0,,Казама-кун бақытты болуы керек...
Dialogue: 0,1:25:55.14,1:25:55.98,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:57.52,1:25:59.44,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:02.49,1:26:05.36,Default,,0,0,0,,Сумико мырза! О...
Dialogue: 0,1:26:07.53,1:26:10.83,Default,,0,0,0,,Мен қазір жеке сабақтарды бастап жатырмын.
Dialogue: 0,1:26:10.91,1:26:12.04,Default,,0,0,0,,Не? иә! Сол сияқты...
Dialogue: 0,1:26:12.04,1:26:12.91,Default,,0,0,0,,Иә! Сол сияқты...
Dialogue: 0,1:26:13.00,1:26:14.79,Default,,0,0,0,,Ола, жүрегімнің қуанышы...
Dialogue: 0,1:26:15.46,1:26:19.75,Default,,0,0,0,,Мен барлығына айтқым келетін бір нәрсе бар.
Dialogue: 0,1:26:20.59,1:26:24.55,Default,,0,0,0,,Казама-кун сынаққа қатысуға өтініш бергенде,
Dialogue: 0,1:26:24.63,1:26:27.22,Default,,0,0,0,,Ол маған хат жазды.
Dialogue: 0,1:26:27.30,1:26:28.64,Default,,0,0,0,,Е...
Dialogue: 0,1:26:28.72,1:26:31.64,Default,,0,0,0,,Негізі мен бәріне айтпауым керек...
Dialogue: 0,1:26:31.72,1:26:36.52,Default,,0,0,0,,Мұғалімдер адам, сондықтан олар кейде қателеседі, солай емес пе?
Dialogue: 0,1:26:37.02,1:26:37.85,Default,,0,0,0,,Хехехе
Dialogue: 0,1:26:41.02,1:26:45.90,Default,,0,0,0,,«Бәріміз бірге осы мектепке жазылсақ, мен бақытты болар едім».
Dialogue: 0,1:26:48.70,1:26:51.70,Default,,0,0,0,,«Мен досымды таныстырамын»
Dialogue: 0,1:26:52.79,1:26:55.54,Default,,0,0,0,,«Бо-чан бәріне мейірімді бола алады».
Dialogue: 0,1:26:55.62,1:26:57.17,Default,,0,0,0,,«Бұл мейірімді элита».
Dialogue: 0,1:26:58.25,1:27:02.63,Default,,0,0,0,,«Масао-кун - өз ойығына кіргенде бағынбайтын болуы мүмкін элиталық адам».
Dialogue: 0,1:27:03.38,1:27:05.88,Default,,0,0,0,,«Мен Нене-чанның қиялы көп пе деп ойлаймын».
Dialogue: 0,1:27:05.97,1:27:08.09,Default,,0,0,0,,«Мен достарымды ойлайтын элитамын».
Dialogue: 0,1:27:09.22,1:27:13.51,Default,,0,0,0,,«Шинносуке үнемі қалжыңдап, ақымақ жігіт болады, бірақ...»
Dialogue: 0,1:27:14.93,1:27:16.56,Default,,0,0,0,,«Жүрек элита»
Dialogue: 0,1:27:17.44,1:27:20.61,Default,,0,0,0,,«Мен барлығымен өте көңілдімін».
Dialogue: 0,1:27:21.61,1:27:24.07,Default,,0,0,0,,«Мен мәңгілік дос болғым келеді».
Dialogue: 0,1:27:24.61,1:27:27.15,Default,,0,0,0,,О! келді!
Dialogue: 0,1:27:27.24,1:27:30.24,Default,,0,0,0,,Хм... Егер мұны істегіңіз келсе, қазір.
Dialogue: 0,1:27:31.78,1:27:33.20,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,1:27:33.28,1:27:35.37,Default,,0,0,0,,Мен олар жеңілсе екен...
Dialogue: 0,1:27:35.45,1:27:37.41,Default,,0,0,0,,Мен де супер элита болғым келеді
Dialogue: 0,1:27:37.50,1:27:39.37,Default,,0,0,0,,Жеңіске жету мүмкін емес!
Dialogue: 0,1:27:39.46,1:27:41.08,Default,,0,0,0,,Пайдасыз істермен айналысуды доғар!
Dialogue: 0,1:27:41.17,1:27:43.09,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,1:27:43.17,1:27:44.34,Default,,0,0,0,,О, ау
Dialogue: 0,1:27:45.13,1:27:47.05,Default,,0,0,0,,Толықтыққа дейін
Dialogue: 0,1:27:47.13,1:27:49.51,Default,,0,0,0,,Хе! Шаба пілдері...
Dialogue: 0,1:27:49.59,1:27:51.22,Default,,0,0,0,,Сәлем~
Dialogue: 0,1:27:51.30,1:27:52.47,Default,,0,0,0,,Чишио-чан...
Dialogue: 0,1:27:52.55,1:27:54.22,Default,,0,0,0,,Хмм...
Dialogue: 0,1:27:54.72,1:27:55.93,Default,,0,0,0,,Ичи туралы
Dialogue: 0,1:27:59.85,1:28:01.06,Default,,0,0,0,,Дайындау…
Dialogue: 0,1:28:07.32,1:28:08.19,Default,,0,0,0,,Қазір мен сөйлесіп тұрған адам – басқа емес,
Dialogue: 0,1:28:09.74,1:28:11.82,Default,,0,0,0,,Якисоба нанын сатып ал!
Dialogue: 0,1:28:11.91,1:28:13.12,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:28:14.24,1:28:16.08,Default,,0,0,0,,Барлығымыз жеңеміз!
Dialogue: 0,1:28:16.66,1:28:18.04,Default,,0,0,0,,Шоши!
Dialogue: 0,1:28:18.12,1:28:20.50,Default,,0,0,0,,Жылыту аяқталды!
Dialogue: 0,1:28:20.58,1:28:21.50,Default,,0,0,0,,Не?!
Dialogue: 0,1:28:21.58,1:28:23.67,Default,,0,0,0,,(Мама Казама мен Мисэйдің қарлығыған дауыстары)
Dialogue: 0,1:28:23.75,1:28:26.21,Default,,0,0,0,,Мен бір апта тез болады деп ойладым.
Dialogue: 0,1:28:26.30,1:28:28.46,Default,,0,0,0,,Бұл таңқаларлық ұзақ болды.
Dialogue: 0,1:28:28.55,1:28:32.51,Default,,0,0,0,,Мен сенің ата-анаң қалағаннан да ұзақ өмір сүретініне сенімдімін.
Dialogue: 0,1:28:32.59,1:28:33.43,Default,,0,0,0,,Иә
Dialogue: 0,1:28:33.51,1:28:35.31,Default,,0,0,0,,Міне келдік!
Dialogue: 0,1:28:36.47,1:28:38.85,Default,,0,0,0,,Хахаха...!
Dialogue: 0,1:28:38.93,1:28:40.02,Default,,0,0,0,,Уа! (Казама мама) Е...
Dialogue: 0,1:28:40.10,1:28:41.98,Default,,0,0,0,,Хахаха...!
Dialogue: 0,1:28:42.06,1:28:43.98,Default,,0,0,0,,Менің ойымша, бұл тым қатты!
Dialogue: 0,1:28:44.06,1:28:45.57,Default,,0,0,0,,Тоору...чан Ах!
Dialogue: 0,1:28:45.65,1:28:46.94,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:28:47.03,1:28:49.15,Default,,0,0,0,,О! Әке, ана!
Dialogue: 0,1:28:49.24,1:28:50.86,Default,,0,0,0,,Шинносуке? жақсы
Dialogue: 0,1:28:50.95,1:28:51.90,Default,,0,0,0,,Не... иә?
Dialogue: 0,1:28:51.99,1:28:54.12,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,1:28:54.20,1:28:55.74,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,1:28:55.83,1:28:56.83,Default,,0,0,0,,Марафон
Dialogue: 0,1:28:56.91,1:28:58.79,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:28:58.87,1:29:00.54,Default,,0,0,0,,Қазірдің өзінде! Ола Казама-кун
Dialogue: 0,1:29:00.62,1:29:02.00,Default,,0,0,0,,Біз жеңуіміз керек!
Dialogue: 0,1:29:02.08,1:29:03.08,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,1:29:03.17,1:29:05.71,Default,,0,0,0,,Мен мүлде түсінбеймін...
Dialogue: 0,1:29:05.79,1:29:07.55,Default,,0,0,0,,Бірақ сенің жүгіргің келеді, солай емес пе?
Dialogue: 0,1:29:07.63,1:29:08.50,Default,,0,0,0,,Иә
Dialogue: 0,1:29:08.59,1:29:09.96,Default,,0,0,0,,Сіз жеңгіңіз келеді, солай ма?
Dialogue: 0,1:29:10.05,1:29:10.92,Default,,0,0,0,,Иә!
Dialogue: 0,1:29:11.01,1:29:12.38,Default,,0,0,0,,Казама-кун үшін?
Dialogue: 0,1:29:12.47,1:29:13.59,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,1:29:13.68,1:29:16.47,Default,,0,0,0,,Жарайды, кеттік, Шинносуке!
Dialogue: 0,1:29:16.55,1:29:18.14,Default,,0,0,0,,Құлап қалмаңыз!
Dialogue: 0,1:29:18.22,1:29:19.06,Default,,0,0,0,,Эй!
Dialogue: 0,1:29:19.14,1:29:22.52,Default,,0,0,0,,Ошинко кет! Баклажан кебек!
Dialogue: 0,1:29:22.60,1:29:24.73,Default,,0,0,0,,Алға қара!
Dialogue: 0,1:29:24.81,1:29:26.98,Default,,0,0,0,,Ха, бұл ұят.
Dialogue: 0,1:29:27.07,1:29:29.19,Default,,0,0,0,,Бұл жақсы емес хахаха...
Dialogue: 0,1:29:29.28,1:29:30.44,Default,,0,0,0,,Дасса!
Dialogue: 0,1:29:31.24,1:29:32.49,Default,,0,0,0,,Ум... (Мисаэ/Хироши) Иә?
Dialogue: 0,1:29:32.57,1:29:35.70,Default,,0,0,0,,Амансың ба? Сондай кішкентай бала...
Dialogue: 0,1:29:35.78,1:29:36.74,Default,,0,0,0,,Хмм…
Dialogue: 0,1:29:36.82,1:29:39.41,Default,,0,0,0,,Олай қарасаң, мені тыңдамайсың.
Dialogue: 0,1:29:40.75,1:29:42.91,Default,,0,0,0,,Барлығы мені қорлауда.
Dialogue: 0,1:29:43.00,1:29:44.00,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:44.08,1:29:46.04,Default,,0,0,0,,Бұл әдеттегі нәрсе.
Dialogue: 0,1:29:46.13,1:29:49.25,Default,,0,0,0,,Мен өмір бойы достарым үшін аянбай еңбек еттім.
Dialogue: 0,1:29:49.34,1:29:51.30,Default,,0,0,0,,Шаңға ұқсайды.
Dialogue: 0,1:29:51.38,1:29:55.30,Default,,0,0,0,,Бір нәрсеге жан-тәнімен берілген адамды қандай адам мазақтайды?
Dialogue: 0,1:29:55.39,1:29:58.01,Default,,0,0,0,,Басыңды лашын жұлып ал.
Dialogue: 0,1:29:58.10,1:29:59.22,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,1:29:59.31,1:30:02.93,Default,,0,0,0,,Жарайды... ата-ана ретінде жеңілсең де, қорлық көрсең де бәрібір.
Dialogue: 0,1:30:03.02,1:30:06.56,Default,,0,0,0,,Емделіп, тірі қалсаң болғаны, жақсы!
Dialogue: 0,1:30:10.11,1:30:13.95,Default,,0,0,0,,Хаха...
Dialogue: 0,1:30:15.99,1:30:19.87,Default,,0,0,0,,Сіз әлі де тыныссыз ба? Ахххх...!
Dialogue: 0,1:30:19.95,1:30:22.33,Default,,0,0,0,,Тез! Және бұл тітіркендіргіш!
Dialogue: 0,1:30:22.41,1:30:24.41,Default,,0,0,0,,Бұл мүмкін емес~
Dialogue: 0,1:30:24.50,1:30:26.00,Default,,0,0,0,,Өзгермеңіз!
Dialogue: 0,1:30:26.08,1:30:27.83,Default,,0,0,0,,Онигири айналады
Dialogue: 0,1:30:29.42,1:30:32.30,Default,,0,0,0,,Барлығына! Кеудеңізді көбірек созыңыз!
Dialogue: 0,1:30:32.38,1:30:34.09,Default,,0,0,0,,Не? Чишио-чан?
Dialogue: 0,1:30:34.17,1:30:35.01,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:30:35.09,1:30:37.22,Default,,0,0,0,,Қазірдің өзінде кеш~
Dialogue: 0,1:30:37.30,1:30:38.34,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,1:30:38.43,1:30:39.47,Default,,0,0,0,,Сіз жүгіре аласыз ба?
Dialogue: 0,1:30:39.55,1:30:42.56,Default,,0,0,0,,Иә! Мен мұнда барлығымен бірге жүгіруім керек.
Dialogue: 0,1:30:42.64,1:30:45.02,Default,,0,0,0,,Жорғалаумен өмір сүре алмайсың!
Dialogue: 0,1:30:45.10,1:30:46.10,Default,,0,0,0,,Әй?
Dialogue: 0,1:30:46.19,1:30:48.65,Default,,0,0,0,,Ал, мақсат әлі алыс.
Dialogue: 0,1:30:48.73,1:30:50.48,Default,,0,0,0,,Шаршасаң, мені ұста!
Dialogue: 0,1:30:50.57,1:30:51.61,Default,,0,0,0,,Сәлем! алақай!
Dialogue: 0,1:30:51.69,1:30:53.44,Default,,0,0,0,,Иә! (Бо-чан) Бо!
Dialogue: 0,1:30:53.53,1:30:54.99,Default,,0,0,0,,Гррр... ой
Dialogue: 0,1:30:55.78,1:30:56.95,Default,,0,0,0,,Жарай ма?
Dialogue: 0,1:30:57.03,1:30:57.95,Default,,0,0,0,,Иә!
Dialogue: 0,1:31:00.66,1:31:02.54,Default,,0,0,0,,Нүүүх!
Dialogue: 0,1:31:02.62,1:31:04.00,Default,,0,0,0,,Хаха...
Dialogue: 0,1:31:04.08,1:31:07.50,Default,,0,0,0,,Ммм...!
Dialogue: 0,1:31:07.58,1:31:09.96,Default,,0,0,0,,Нуора!
Dialogue: 0,1:31:10.04,1:31:11.54,Default,,0,0,0,,Чишио-чан керемет!
Dialogue: 0,1:31:11.63,1:31:12.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:12.55,1:31:14.51,Default,,0,0,0,,Ол мүлдем оғаш көрінбейді!
Dialogue: 0,1:31:14.59,1:31:16.09,Default,,0,0,0,,Керісінше... бұл керемет!
Dialogue: 0,1:31:16.17,1:31:18.43,Default,,0,0,0,,Аха... Иә!
Dialogue: 0,1:31:18.51,1:31:21.39,Default,,0,0,0,,Хаха...
Dialogue: 0,1:31:21.47,1:31:23.60,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,1:31:23.68,1:31:24.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:24.60,1:31:25.85,Default,,0,0,0,,Кукей!
Dialogue: 0,1:31:26.48,1:31:28.81,Default,,0,0,0,,Чишио!
Dialogue: 0,1:31:31.44,1:31:32.27,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:32.36,1:31:33.73,Default,,0,0,0,,Артқы жағы Абайлаңыз!
Dialogue: 0,1:31:33.82,1:31:35.69,Default,,0,0,0,,Паралила Паралила Паралила...!
Dialogue: 0,1:31:35.78,1:31:38.15,Default,,0,0,0,,Не? Не~!
Dialogue: 0,1:31:38.91,1:31:41.57,Default,,0,0,0,,Бұл күтпеген жағдай, бірақ керісінше.
Dialogue: 0,1:31:46.08,1:31:47.96,Default,,0,0,0,,(Нене-чанның айқайы)
Dialogue: 0,1:31:48.04,1:31:49.42,Default,,0,0,0,,Бор? Оу!
Dialogue: 0,1:31:49.50,1:31:51.83,Default,,0,0,0,,Итатат! Апыр-ай!
Dialogue: 0,1:31:53.96,1:31:55.84,Default,,0,0,0,,Сәлем! Бұл алдау!
Dialogue: 0,1:31:55.92,1:31:58.84,Default,,0,0,0,,Бұл сөзсіз алдау емес пе?
Dialogue: 0,1:31:59.72,1:32:02.30,Default,,0,0,0,,Жоқ. Жеңіске жету үшін барлық құралдарды қолданыңыз.
Dialogue: 0,1:32:02.39,1:32:04.76,Default,,0,0,0,,Бұл супер элита.
Dialogue: 0,1:32:04.85,1:32:06.56,Default,,0,0,0,,Қандай логика...
Dialogue: 0,1:32:06.64,1:32:09.23,Default,,0,0,0,,Сен қандай ақымақсың? Мен осындай нәрсе жасадым
Dialogue: 0,1:32:12.31,1:32:13.15,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:13.23,1:32:15.61,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:15.69,1:32:17.57,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:32:18.36,1:32:20.45,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,1:32:21.32,1:32:22.45,Default,,0,0,0,,Аники?
Dialogue: 0,1:32:22.53,1:32:24.87,Default,,0,0,0,,Масао! Айналаңыздағылардың мазақ етуіне тырысу
Dialogue: 0,1:32:24.95,1:32:26.95,Default,,0,0,0,,Досқа жүгіру рухы
Dialogue: 0,1:32:27.04,1:32:28.70,Default,,0,0,0,,Маған қатты ұнады!
Dialogue: 0,1:32:28.79,1:32:31.75,Default,,0,0,0,,Біз сенің письмаңа сәкелейтін боламыз!
Dialogue: 0,1:32:31.83,1:32:33.17,Default,,0,0,0,,О!
Dialogue: 0,1:32:36.46,1:32:38.34,Default,,0,0,0,,Йо-йо Менімен араласпа, йо!
Dialogue: 0,1:32:39.01,1:32:40.80,Default,,0,0,0,,Нуора!
Dialogue: 0,1:32:40.88,1:32:41.93,Default,,0,0,0,,Көңіл-күйлеріңіз көтеріңкі болсын!
Dialogue: 0,1:32:42.01,1:32:43.76,Default,,0,0,0,,Балибари Бенбен...!
Dialogue: 0,1:32:43.84,1:32:46.22,Default,,0,0,0,,Аники Мен де күресемін!
Dialogue: 0,1:32:46.31,1:32:47.27,Default,,0,0,0,,Масао!
Dialogue: 0,1:32:47.35,1:32:50.27,Default,,0,0,0,,Мына тұншықтыратын дүниені өзгерту керек!
Dialogue: 0,1:32:50.35,1:32:51.19,Default,,0,0,0,,Әй!
Dialogue: 0,1:32:54.73,1:32:56.11,Default,,0,0,0,,Фу…
Dialogue: 0,1:32:56.19,1:32:57.19,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:57.73,1:32:58.57,Default,,0,0,0,,Уф!
Dialogue: 0,1:32:58.65,1:33:02.61,Default,,0,0,0,,Сіз Тенкасу академиясының 34-басшысысыз!
Dialogue: 0,1:33:02.70,1:33:03.53,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,1:33:03.61,1:33:04.53,Default,,0,0,0,,Еркек!
Dialogue: 0,1:33:04.62,1:33:07.70,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:33:07.79,1:33:11.16,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,1:33:11.25,1:33:14.21,Default,,0,0,0,,Онигири күріш шарын орау
Dialogue: 0,1:33:15.75,1:33:17.59,Default,,0,0,0,,О және... Эй!
Dialogue: 0,1:33:17.67,1:33:19.51,Default,,0,0,0,,Әй, уау!
Dialogue: 0,1:33:19.59,1:33:22.34,Default,,0,0,0,,Хмм... жақсы... майдан! Алдынан!
Dialogue: 0,1:33:22.43,1:33:23.55,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,1:33:23.63,1:33:25.51,Default,,0,0,0,,Бобобобобобобо…
Dialogue: 0,1:33:25.60,1:33:26.76,Default,,0,0,0,,Қабан!
Dialogue: 0,1:33:32.23,1:33:33.39,Default,,0,0,0,,Роро-сан…
Dialogue: 0,1:33:33.48,1:33:35.60,Default,,0,0,0,,Мен адамдарды ұнатпаймын
Dialogue: 0,1:33:35.69,1:33:38.57,Default,,0,0,0,,Бірақ... сен маған ұнайсың!
Dialogue: 0,1:33:40.32,1:33:41.53,Default,,0,0,0,,По~
Dialogue: 0,1:33:41.61,1:33:42.78,Default,,0,0,0,,Поп-поп-поп…
Dialogue: 0,1:33:42.86,1:33:44.99,Default,,0,0,0,,Уаааа! (Балалар) Угя!
Dialogue: 0,1:33:45.07,1:33:46.37,Default,,0,0,0,,Менің шын атым Джеймс Рэтли
Dialogue: 0,1:33:48.33,1:33:50.70,Default,,0,0,0,,Уф...
Dialogue: 0,1:33:50.79,1:33:53.37,Default,,0,0,0,,Мен... не болды?
Dialogue: 0,1:33:53.46,1:33:54.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:54.67,1:33:57.67,Default,,0,0,0,,Бұл үлкен қателік болды.
Dialogue: 0,1:33:57.75,1:34:00.42,Default,,0,0,0,,Бірақ бір күні мен қайтадан әрекет жасай аламын.
Dialogue: 0,1:34:00.50,1:34:03.22,Default,,0,0,0,,Қайта-қайта қателесу
Dialogue: 0,1:34:03.30,1:34:04.63,Default,,0,0,0,,Бұл жастық шақ
Dialogue: 0,1:34:05.51,1:34:07.85,Default,,0,0,0,,Ненепайсен…
Dialogue: 0,1:34:10.89,1:34:13.77,Default,,0,0,0,,Ой! Тек... Аа!
Dialogue: 0,1:34:13.85,1:34:15.81,Default,,0,0,0,,Уау! Иә! Де! Не!
Dialogue: 0,1:34:15.90,1:34:16.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:34:16.81,1:34:18.73,Default,,0,0,0,,Ха ха ха... уф!
Dialogue: 0,1:34:19.77,1:34:21.53,Default,,0,0,0,,Поп-поп-поп... Уф!
Dialogue: 0,1:34:21.61,1:34:22.65,Default,,0,0,0,,Пух!
Dialogue: 0,1:34:26.70,1:34:30.12,Default,,0,0,0,,Ха ха ха... мммм
Dialogue: 0,1:34:30.20,1:34:31.04,Default,,0,0,0,,Сәттілік...
Dialogue: 0,1:34:31.12,1:34:32.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:34:33.12,1:34:33.95,Default,,0,0,0,,Сәттілік...!
Dialogue: 0,1:34:34.04,1:34:35.41,Default,,0,0,0,,Хаха...
Dialogue: 0,1:34:35.50,1:34:36.87,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:34:36.96,1:34:38.33,Default,,0,0,0,,Төбет...
Dialogue: 0,1:34:38.42,1:34:40.29,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:34:42.84,1:34:46.72,Default,,0,0,0,,(дауыс)
Dialogue: 0,1:34:48.22,1:34:49.68,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:34:49.76,1:34:53.22,Default,,0,0,0,,Алға Алға! Касукабе детектив клубы!
Dialogue: 0,1:34:53.31,1:34:54.14,Default,,0,0,0,,Уф!
Dialogue: 0,1:34:54.23,1:34:56.10,Default,,0,0,0,,(Суйсу Гакубу музыкасы)
Dialogue: 0,1:34:56.19,1:34:58.06,Default,,0,0,0,,Барыңыз, жетіңіз!
Dialogue: 0,1:34:58.15,1:35:00.02,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,1:35:00.11,1:35:01.98,Default,,0,0,0,,Фуфуфуфуфу!
Dialogue: 0,1:35:02.07,1:35:03.36,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,1:35:03.44,1:35:05.95,Default,,0,0,0,,Неліктен мұндай ысырапшылдықпен айналысасың?
Dialogue: 0,1:35:06.03,1:35:08.03,Default,,0,0,0,,Егер біз жеңсек
Dialogue: 0,1:35:08.11,1:35:10.87,Default,,0,0,0,,Сіз супер элита бола аласыз!
Dialogue: 0,1:35:10.95,1:35:14.79,Default,,0,0,0,,Неге өзіңнің ойын-сауықыңды лақтырып, өзгеге ұнайсың!
Dialogue: 0,1:35:14.87,1:35:16.33,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:35:16.41,1:35:17.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:17.33,1:35:19.71,Default,,0,0,0,,Касукабе детектив клубы!
Dialogue: 0,1:35:19.79,1:35:22.67,Default,,0,0,0,,Жастар оты!
Dialogue: 0,1:35:22.75,1:35:25.63,Default,,0,0,0,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,1:35:26.30,1:35:27.13,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:35:27.22,1:35:28.09,Default,,0,0,0,,Жастар?
Dialogue: 0,1:35:29.64,1:35:31.10,Default,,0,0,0,,Боу! Боу!
Dialogue: 0,1:35:31.18,1:35:34.56,Default,,0,0,0,,Боб боа! Сиськи!
Dialogue: 0,1:35:34.64,1:35:35.52,Default,,0,0,0,,Бо-чан!
Dialogue: 0,1:35:35.60,1:35:37.73,Default,,0,0,0,,Жүр! Боа!
Dialogue: 0,1:35:38.85,1:35:39.69,Default,,0,0,0,,(Киришима & Сейро) Хахаха… Шынымен бе? Шынымен бе? Бакуго!
Dialogue: 0,1:35:39.77,1:35:41.94,Default,,0,0,0,,34-ші Банчо
Dialogue: 0,1:35:42.02,1:35:44.15,Default,,0,0,0,,Маса, жын-гиши, менің қарсыласым!
Dialogue: 0,1:35:44.23,1:35:47.78,Default,,0,0,0,,Нүүүх!
Dialogue: 0,1:35:47.86,1:35:50.70,Default,,0,0,0,,Кедергі жасамаңыз! Алақай!
Dialogue: 0,1:35:51.28,1:35:52.12,Default,,0,0,0,,Иә!
Dialogue: 0,1:35:52.20,1:35:53.16,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:53.66,1:35:55.62,Default,,0,0,0,,Корокоро Корокоро…
Dialogue: 0,1:35:55.70,1:35:57.54,Default,,0,0,0,,Шин-чан, бірінші бар!
Dialogue: 0,1:35:57.62,1:35:59.50,Default,,0,0,0,,Эй!
Dialogue: 0,1:36:00.17,1:36:01.46,Default,,0,0,0,,Чишио Атсуки
Dialogue: 0,1:36:03.75,1:36:06.80,Default,,0,0,0,,Сізде біртүрлі тұлғалар туралы кешен бар.
Dialogue: 0,1:36:06.88,1:36:08.63,Default,,0,0,0,,Мен үйрендім
Dialogue: 0,1:36:08.72,1:36:11.43,Default,,0,0,0,,Чишио-чанның біртүрлі түрі жоқ!
Dialogue: 0,1:36:11.51,1:36:13.10,Default,,0,0,0,,Сіз көп жұмыс істеп жатқан сияқтысыз!
Dialogue: 0,1:36:14.10,1:36:15.39,Default,,0,0,0,,Шин-чан...
Dialogue: 0,1:36:15.47,1:36:17.77,Default,,0,0,0,,Иә, бұл менмін!
Dialogue: 0,1:36:17.85,1:36:20.27,Default,,0,0,0,,Мен Шин Чанмен жүгіріп келемін!
Dialogue: 0,1:36:20.35,1:36:22.56,Default,,0,0,0,,Мен қазір! Мен оны өте жақсы көремін!
Dialogue: 0,1:36:23.36,1:36:25.48,Default,,0,0,0,,Мен сені жақсы көремін! Мен кереметпін!
Dialogue: 0,1:36:25.57,1:36:26.94,Default,,0,0,0,,Мен оны өте жақсы көремін!
Dialogue: 0,1:36:28.28,1:36:30.53,Default,,0,0,0,,Шин Чан, рахмет...
Dialogue: 0,1:36:30.61,1:36:32.24,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:34.99,1:36:36.33,Default,,0,0,0,,Чишио-чан!
Dialogue: 0,1:36:36.41,1:36:38.29,Default,,0,0,0,,Шин…чан…
Dialogue: 0,1:36:38.91,1:36:41.25,Default,,0,0,0,,Маңызды нәрсе... Қайтарыңыз...
Dialogue: 0,1:36:42.25,1:36:43.71,Default,,0,0,0,,Ух... Мм!
Dialogue: 0,1:36:43.79,1:36:45.17,Default,,0,0,0,,Жүгіру!
Dialogue: 0,1:36:46.38,1:36:49.22,Default,,0,0,0,,Бюстгалтер!
Dialogue: 0,1:36:51.13,1:36:52.34,Default,,0,0,0,,Не болды!
Dialogue: 0,1:36:52.43,1:36:55.30,Default,,0,0,0,,Барлығыңыз супер элита болғыңыз келмейді ме?
Dialogue: 0,1:36:55.39,1:36:58.60,Default,,0,0,0,,Касулов! Менің кеудем ыстық! Жастық шақ қауіпті!
Dialogue: 0,1:36:58.68,1:36:59.77,Default,,0,0,0,,Бучиж!
Dialogue: 0,1:36:59.85,1:37:02.23,Default,,0,0,0,,Жастық шақ дегеніміз не?
Dialogue: 0,1:37:02.31,1:37:03.19,Default,,0,0,0,,Жастар – бұл...
Dialogue: 0,1:37:03.27,1:37:04.40,Default,,0,0,0,,Темір маска!
Dialogue: 0,1:37:04.48,1:37:05.36,Default,,0,0,0,,Жастар – бұл...
Dialogue: 0,1:37:05.44,1:37:06.57,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:37:06.65,1:37:07.53,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:07.61,1:37:08.73,Default,,0,0,0,,Жарқыраған!
Dialogue: 0,1:37:08.82,1:37:09.69,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:09.78,1:37:10.90,Default,,0,0,0,,Кешен!
Dialogue: 0,1:37:10.99,1:37:11.86,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:11.95,1:37:13.07,Default,,0,0,0,,Қайтып кел!
Dialogue: 0,1:37:13.16,1:37:14.03,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:14.11,1:37:15.24,Default,,0,0,0,,Қайын жұрт!
Dialogue: 0,1:37:15.32,1:37:16.20,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:16.28,1:37:17.41,Default,,0,0,0,,Балалар
Dialogue: 0,1:37:17.49,1:37:18.37,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:18.45,1:37:19.58,Default,,0,0,0,,Жол жолы!
Dialogue: 0,1:37:19.66,1:37:20.54,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:20.62,1:37:21.75,Default,,0,0,0,,Онда...
Dialogue: 0,1:37:21.83,1:37:22.71,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:22.79,1:37:23.92,Default,,0,0,0,,Қазір
Dialogue: 0,1:37:24.00,1:37:24.88,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:24.96,1:37:26.09,Default,,0,0,0,,Пайпай
Dialogue: 0,1:37:26.17,1:37:27.04,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:27.13,1:37:28.25,Default,,0,0,0,,Хаха...
Dialogue: 0,1:37:28.34,1:37:29.21,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:29.30,1:37:30.42,Default,,0,0,0,,Хаха...
Dialogue: 0,1:37:30.51,1:37:31.38,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:31.47,1:37:32.59,Default,,0,0,0,,Хаха...
Dialogue: 0,1:37:32.68,1:37:33.55,Default,,0,0,0,,Жастар дегеніміз...
Dialogue: 0,1:37:36.18,1:37:38.51,Default,,0,0,0,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,1:37:47.94,1:37:49.94,Default,,0,0,0,,Сейшунха…
Dialogue: 0,1:37:50.03,1:37:52.11,Default,,0,0,0,,Жұмбақ!
Dialogue: 0,1:37:52.19,1:37:54.32,Default,,0,0,0,,Охохохо...!
Dialogue: 0,1:38:00.54,1:38:01.62,Default,,0,0,0,,Ах!
Dialogue: 0,1:38:01.70,1:38:02.71,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:38:02.79,1:38:04.50,Default,,0,0,0,,О...
Dialogue: 0,1:38:06.38,1:38:07.21,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,1:38:07.29,1:38:09.17,Default,,0,0,0,,Хахи~н
Dialogue: 0,1:38:09.25,1:38:12.34,Default,,0,0,0,,Құлағыңызға үрлемеңіз!
Dialogue: 0,1:38:12.42,1:38:14.93,Default,,0,0,0,,О! Бұл кәдімгі Казама-кун~ Уа
Dialogue: 0,1:38:15.01,1:38:16.30,Default,,0,0,0,,Келме! о?
Dialogue: 0,1:38:16.39,1:38:18.18,Default,,0,0,0,,Бәріне сен кінәлісің!
Dialogue: 0,1:38:18.26,1:38:19.14,Default,,0,0,0,,Не?!
Dialogue: 0,1:38:19.22,1:38:21.22,Default,,0,0,0,,Қалыпты күйге оралды...
Dialogue: 0,1:38:21.31,1:38:22.60,Default,,0,0,0,,Бұрынғы соққыдан?
Dialogue: 0,1:38:22.68,1:38:26.56,Default,,0,0,0,,Мен бәріміз бірге бір мектепте оқимыз деп ойладым!
Dialogue: 0,1:38:26.65,1:38:28.52,Default,,0,0,0,,Мен туралы білмейсің!
Dialogue: 0,1:38:28.61,1:38:31.48,Default,,0,0,0,,Біз Касукабе қорғаныс күштеріміз!
Dialogue: 0,1:38:31.57,1:38:33.94,Default,,0,0,0,,Бұл әзірге ғана!
Dialogue: 0,1:38:34.03,1:38:37.20,Default,,0,0,0,,Бір күні бәріміз құлап қаламыз!
Dialogue: 0,1:38:37.28,1:38:40.66,Default,,0,0,0,,Мен жаңа достар табуды жалғастырамын!
Dialogue: 0,1:38:40.74,1:38:42.45,Default,,0,0,0,,Түсінесіз бе!
Dialogue: 0,1:38:42.54,1:38:44.62,Default,,0,0,0,,Мен мүлде түсінбеймін!
Dialogue: 0,1:38:44.71,1:38:46.92,Default,,0,0,0,,О, мен енді ғана түсіндім!
Dialogue: 0,1:38:47.00,1:38:49.38,Default,,0,0,0,,О, әрине!
Dialogue: 0,1:38:52.92,1:38:55.42,Default,,0,0,0,,Неге екенін білмеймін, бірақ бар күшіңді сал!
Dialogue: 0,1:38:55.51,1:38:57.09,Default,,0,0,0,,Бар, Шинносуке!
Dialogue: 0,1:38:57.18,1:38:58.80,Default,,0,0,0,,Тоору-чан!
Dialogue: 0,1:38:58.89,1:39:02.89,Default,,0,0,0,,Сіз өмір бойы өмір сүруіңіз керек!
Dialogue: 0,1:39:02.97,1:39:06.27,Default,,0,0,0,,Казама-кун бақытты өмір сүрсе ғой!
Dialogue: 0,1:39:06.35,1:39:07.90,Default,,0,0,0,,Керемет көрінеді!
Dialogue: 0,1:39:07.98,1:39:10.56,Default,,0,0,0,,Мен элиталық өмір сүремін!
Dialogue: 0,1:39:10.65,1:39:12.73,Default,,0,0,0,,Сіз алдай алмайсыз!
Dialogue: 0,1:39:12.82,1:39:15.19,Default,,0,0,0,,Сен де алдадың, ақымақ!
Dialogue: 0,1:39:15.28,1:39:17.66,Default,,0,0,0,,Мені ақымақ дегенің жақсы!
Dialogue: 0,1:39:17.74,1:39:21.49,Default,,0,0,0,,Иә, мен екі рет «ақымақ» дедім. Бұл ақымақ!
Dialogue: 0,1:39:21.58,1:39:22.66,Default,,0,0,0,,Мен берілмеймін!
Dialogue: 0,1:39:22.74,1:39:24.50,Default,,0,0,0,,Шулы!
Dialogue: 0,1:39:26.21,1:39:28.08,Default,,0,0,0,,(Әркімнің дауысы)
Dialogue: 0,1:39:28.17,1:39:30.00,Default,,0,0,0,,Мен біріншімін!
Dialogue: 0,1:39:30.08,1:39:31.54,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,1:39:38.05,1:39:39.89,Default,,0,0,0,,Якисоба паан!
Dialogue: 0,1:39:39.97,1:39:45.72,Default,,0,0,0,,Керемет!
Dialogue: 0,1:39:50.23,1:39:54.36,Default,,0,0,0,,Не! Уф...!
Dialogue: 0,1:39:54.44,1:39:55.61,Default,,0,0,0,,Иә
Dialogue: 0,1:39:55.69,1:39:59.70,Default,,0,0,0,,(Үлкен айқай)
Dialogue: 0,1:40:01.62,1:40:03.78,Default,,0,0,0,,Касулове Гекия Екі!
Dialogue: 0,1:40:03.87,1:40:04.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:04.87,1:40:06.41,Default,,0,0,0,,Мектеп директоры
Dialogue: 0,1:40:06.50,1:40:11.54,Default,,0,0,0,,Балаларға ештеңе босқа кетпейді деп ойлаймын.
Dialogue: 0,1:40:11.63,1:40:13.59,Default,,0,0,0,,Мен қателесіппін
Dialogue: 0,1:40:13.67,1:40:15.88,Default,,0,0,0,,Ысырапшылдық маңызды!
Dialogue: 0,1:40:17.42,1:40:18.97,Default,,0,0,0,,Кез келген жас
Dialogue: 0,1:40:20.26,1:40:23.89,Default,,0,0,0,,Бір күні есіңізде болар деп үміттенемін...
Dialogue: 0,1:40:23.97,1:40:26.85,Default,,0,0,0,,Хаха...
Dialogue: 0,1:40:29.60,1:40:32.69,Default,,0,0,0,,Бүгін... Мен оны ұтыспен қалдырамын.
Dialogue: 0,1:40:33.61,1:40:34.44,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:34.52,1:40:37.94,Default,,0,0,0,,Бір күні нағыз элитаға айналсам
Dialogue: 0,1:40:38.03,1:40:41.28,Default,,0,0,0,,Олай болса тағы да жарысатын кез келді.
Dialogue: 0,1:40:47.70,1:40:50.62,Default,,0,0,0,,Казама-кун, кешіріңіз.
Dialogue: 0,1:40:52.50,1:40:55.00,Default,,0,0,0,,Шинносуке... Кешіріңіз.
Dialogue: 0,1:40:56.42,1:40:59.84,Default,,0,0,0,,(жұтатын дыбыс)
Dialogue: 0,1:40:59.92,1:41:00.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:41:02.01,1:41:03.05,Default,,0,0,0,,Ах!
Dialogue: 0,1:41:03.14,1:41:05.80,Default,,0,0,0,,Хмм...
Dialogue: 0,1:41:05.89,1:41:09.10,Default,,0,0,0,,Менің якисоба наным!
Dialogue: 0,1:41:09.18,1:41:11.44,Default,,0,0,0,,Уау, бұл үлкен мәселе!
Dialogue: 0,1:41:11.52,1:41:14.27,Default,,0,0,0,,Жоқ, бұл сенсің, Шинносуке!
Dialogue: 0,1:41:14.35,1:41:15.40,Default,,0,0,0,,Иә!
Dialogue: 0,1:41:15.48,1:41:17.15,Default,,0,0,0,,Сіз не ойладыңыз!
Dialogue: 0,1:41:17.23,1:41:18.90,Default,,0,0,0,,Жапонияның Мираи туралы
Dialogue: 0,1:41:18.98,1:41:19.90,Default,,0,0,0,,Өтірікші!
Dialogue: 0,1:41:19.99,1:41:22.03,Default,,0,0,0,,Өте жабысқақ
Dialogue: 0,1:41:22.11,1:41:22.95,Default,,0,0,0,,Ха~
Dialogue: 0,1:41:23.03,1:41:24.32,Default,,0,0,0,,Петтан Петтан
Dialogue: 0,1:41:24.41,1:41:25.78,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:24.41,1:41:25.78,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,1:41:25.78,1:41:26.91,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,1:41:26.99,1:41:27.99,Default,,0,0,0,,Әй?
Dialogue: 0,1:41:30.00,1:41:35.00,Default,,0,0,0,,♪～
Dialogue: 0,1:44:33.01,1:44:38.02,Default,,0,0,0,,～♪
