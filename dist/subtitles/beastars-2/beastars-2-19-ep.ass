Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:08.09,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.91,0:01:29.17,Default,,0,0,0,,～♪
Dialogue: 0,0:01:33.30,0:01:35.92,Default,,0,0,0,,Менің жаттығуларым алға жылжуы керек.
Dialogue: 0,0:01:37.47,0:01:40.09,Default,,0,0,0,,Неліктен иегіме күш сала алмаймын?
Dialogue: 0,0:01:45.48,0:01:46.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:47.19,0:01:50.27,Default,,0,0,0,,Бірақ бұл мүмкіндік емес пе?
Dialogue: 0,0:01:56.36,0:01:59.61,Default,,0,0,0,,Менде қылмыскердің сілекейі туралы мәлімет бар.
Dialogue: 0,0:02:02.95,0:02:05.91,Default,,0,0,0,,Хмм... жоқ.
Dialogue: 0,0:02:06.54,0:02:08.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:09.54,0:02:11.46,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:02:12.46,0:02:14.21,Default,,0,0,0,,Жоқ, бұл да...
Dialogue: 0,0:02:15.63,0:02:17.67,Default,,0,0,0,,Бұл да басқа
Dialogue: 0,0:02:20.64,0:02:21.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:22.18,0:02:25.14,Default,,0,0,0,,Мені бір қолмен айналдырған сол күш
Dialogue: 0,0:02:27.64,0:02:30.48,Default,,0,0,0,,Бұл мен үшін хабар
Dialogue: 0,0:02:31.40,0:02:33.69,Default,,0,0,0,,«Темді жеген мен болдым».
Dialogue: 0,0:02:33.77,0:02:35.90,Default,,0,0,0,,«Егер сіз ары қарай іздегіңіз келсе»
Dialogue: 0,0:02:35.98,0:02:37.86,Default,,0,0,0,,«Мен сені өлтіремін»
Dialogue: 0,0:02:40.45,0:02:42.53,Default,,0,0,0,,Иә, сәттілік
Dialogue: 0,0:02:43.32,0:02:45.58,Default,,0,0,0,,Баяу дем шығару
Dialogue: 0,0:02:46.16,0:02:47.91,Default,,0,0,0,,Иә 20 секунд ұстап тұрыңыз
Dialogue: 0,0:02:48.00,0:02:48.83,Default,,0,0,0,,Мүмкін емес Мүмкін емес Мүмкін емес...
Dialogue: 0,0:02:48.91,0:02:50.08,Default,,0,0,0,,Бұл мүмкін емес, мүмкін емес, мүмкін емес.
Dialogue: 0,0:02:50.16,0:02:51.50,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:02:51.58,0:02:52.42,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:02:52.50,0:02:54.17,Default,,0,0,0,,Баяу дем шығарыңыз
Dialogue: 0,0:02:54.84,0:02:57.42,Default,,0,0,0,,Өйткені, бізге бұл жерде жабылатын перде керек.
Dialogue: 0,0:02:57.51,0:03:00.05,Default,,0,0,0,,Кесу таяқшасымен жүзімнен тығылып қалмай ма?
Dialogue: 0,0:03:00.13,0:03:01.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:01.30,0:03:02.43,Default,,0,0,0,,Ах... Күмбез-сенпай (Күмбез) Не?
Dialogue: 0,0:03:02.43,0:03:03.39,Default,,0,0,0,,Ах... Күмбез-сенпай (Күмбез) Не?
Dialogue: 0,0:03:02.43,0:03:03.39,Default,,0,0,0,,Иә, онда қолтықтарыңызды созыңыз.
Dialogue: 0,0:03:03.39,0:03:03.47,Default,,0,0,0,,Иә, онда қолтықтарыңызды созыңыз.
Dialogue: 0,0:03:03.47,0:03:05.39,Default,,0,0,0,,Иә, онда қолтықтарыңызды созыңыз.
Dialogue: 0,0:03:03.47,0:03:05.39,Default,,0,0,0,,Сол Пина-кунның назар аударатын орны
Dialogue: 0,0:03:05.47,0:03:07.85,Default,,0,0,0,,Менің ойымша, бір қызыл сүзгіні қолданған дұрыс.
Dialogue: 0,0:03:07.93,0:03:10.31,Default,,0,0,0,,Ах~ Хмм...
Dialogue: 0,0:03:10.39,0:03:11.85,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:11.94,0:03:14.06,Default,,0,0,0,,Менің денем таза аппақ
Dialogue: 0,0:03:14.15,0:03:17.03,Default,,0,0,0,,Сіздің өңіңіз жақсы көрінеді, сондықтан менің ойымша, бұл жақсы.
Dialogue: 0,0:03:17.11,0:03:18.86,Default,,0,0,0,,Денені тексеру? Неге ондай істегіңіз келеді?
Dialogue: 0,0:03:19.69,0:03:20.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:21.78,0:03:23.66,Default,,0,0,0,,Жоқ... О, жоқ.
Dialogue: 0,0:03:23.74,0:03:26.08,Default,,0,0,0,,Е... Мен... Жоқ, жоқ, жоқ, жоқ...
Dialogue: 0,0:03:26.16,0:03:28.49,Default,,0,0,0,,Чи... чичичи... жоқ!
Dialogue: 0,0:03:28.58,0:03:32.08,Default,,0,0,0,,Ой... қолым... қолым...
Dialogue: 0,0:03:35.42,0:03:36.79,Default,,0,0,0,,Шөпқоректілер азайды
Dialogue: 0,0:03:36.88,0:03:38.84,Default,,0,0,0,,А... Мен... жоқпын.
Dialogue: 0,0:03:38.92,0:03:40.55,Default,,0,0,0,,Мен... Сабыр ет, Тао.
Dialogue: 0,0:03:40.63,0:03:42.18,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:03:42.26,0:03:43.55,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,0:03:43.64,0:03:45.14,Default,,0,0,0,,Кяаа...
Dialogue: 0,0:03:45.22,0:03:46.26,Default,,0,0,0,,Ми... мими... сіз оны көрдіңіз.
Dialogue: 0,0:03:46.26,0:03:46.60,Default,,0,0,0,,Ми... мими... сіз оны көрдіңіз.
Dialogue: 0,0:03:46.26,0:03:46.60,Default,,0,0,0,,Эй... тоқта!
Dialogue: 0,0:03:46.60,0:03:46.68,Default,,0,0,0,,Эй... тоқта!
Dialogue: 0,0:03:46.68,0:03:48.47,Default,,0,0,0,,Эй... тоқта!
Dialogue: 0,0:03:46.68,0:03:48.47,Default,,0,0,0,,Бұл әдейі емес, маған сеніңіз.
Dialogue: 0,0:03:48.56,0:03:49.77,Default,,0,0,0,,Тынышталыңыз Ах... мен...
Dialogue: 0,0:03:49.85,0:03:51.68,Default,,0,0,0,,Барлығы қорқады, өйткені мен...
Dialogue: 0,0:03:51.77,0:03:53.52,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:03:53.60,0:03:55.73,Default,,0,0,0,,Уф, менің қолым... менің қолым...
Dialogue: 0,0:03:55.81,0:03:58.90,Default,,0,0,0,,Әйтеуір, бәріңіз Миллетті емханаға апарыңыз.
Dialogue: 0,0:03:58.98,0:04:03.11,Default,,0,0,0,,Шындығында, өзін ұстайтын жыртқыш аң
Dialogue: 0,0:04:03.20,0:04:06.66,Default,,0,0,0,,Шөпқоректінің аяқ-қолы түсіп қалатындай жара салуға болмайды.
Dialogue: 0,0:04:06.74,0:04:08.53,Default,,0,0,0,,Сирек емес
Dialogue: 0,0:04:09.24,0:04:13.54,Default,,0,0,0,,Дегенмен, тігу технологиясы да сәйкесінше дамыды.
Dialogue: 0,0:04:13.62,0:04:16.33,Default,,0,0,0,,Асықсаң, Кибі қолы да қосылсын.
Dialogue: 0,0:04:17.13,0:04:18.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:18.71,0:04:20.34,Default,,0,0,0,,Тары №!
Dialogue: 0,0:04:20.42,0:04:22.42,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,0:04:22.51,0:04:23.97,Default,,0,0,0,,Ет жегенге қол тигізбеу
Dialogue: 0,0:04:24.05,0:04:25.89,Default,,0,0,0,,Екіншісі де ыдырап қалады.
Dialogue: 0,0:04:25.97,0:04:27.47,Default,,0,0,0,,Маған сен, тары.
Dialogue: 0,0:04:27.55,0:04:29.72,Default,,0,0,0,,Мұны күшті жыртқыштарға қалдырыңыз.
Dialogue: 0,0:04:29.81,0:04:31.60,Default,,0,0,0,,Бұл мүмкін емес, балам...
Dialogue: 0,0:04:31.68,0:04:32.98,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:04:33.06,0:04:34.64,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:04:35.44,0:04:37.81,Default,,0,0,0,,Тары Бірақ...
Dialogue: 0,0:04:37.90,0:04:40.28,Default,,0,0,0,,Легоши?
Dialogue: 0,0:04:40.36,0:04:41.65,Default,,0,0,0,,Легоши жақсы.
Dialogue: 0,0:04:41.73,0:04:44.82,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:04:46.16,0:04:47.20,Default,,0,0,0,,Кеттік
Dialogue: 0,0:04:47.28,0:04:49.08,Default,,0,0,0,,Хмм... жарайды ма? Мен ұстаймын, иә
Dialogue: 0,0:04:49.16,0:04:50.03,Default,,0,0,0,,Себебі ол шайқалады
Dialogue: 0,0:04:50.12,0:04:51.66,Default,,0,0,0,,Хмм... Уф...
Dialogue: 0,0:04:52.33,0:04:55.62,Default,,0,0,0,,Жарайды, мен емханаға барамын.
Dialogue: 0,0:04:55.71,0:04:57.50,Default,,0,0,0,,Қалғаны үшін рахмет.
Dialogue: 0,0:04:57.58,0:04:58.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:58.84,0:05:00.55,Default,,0,0,0,,Сізге де қару қажет
Dialogue: 0,0:05:01.21,0:05:03.26,Default,,0,0,0,,Біреу оны өзіңізбен бірге алып кетіңіз.
Dialogue: 0,0:05:08.76,0:05:09.60,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:10.35,0:05:11.68,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:05:13.35,0:05:16.64,Default,,0,0,0,,Көрінбейтін етіп орап ал, сонда бәрі жақсы болады.
Dialogue: 0,0:05:17.85,0:05:19.19,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:19.27,0:05:20.65,Default,,0,0,0,,Кеттік
Dialogue: 0,0:05:22.19,0:05:22.86,Default,,0,0,0,,Тары... Ах...
Dialogue: 0,0:05:22.86,0:05:23.86,Default,,0,0,0,,Тары... Ах...
Dialogue: 0,0:05:22.86,0:05:23.86,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:23.94,0:05:26.20,Default,,0,0,0,,Бүгінгі клуб іс-шаралары тоқтатылды.
Dialogue: 0,0:05:26.28,0:05:26.95,Default,,0,0,0,,Тыңдаңыздар, ренжімеңіздер.
Dialogue: 0,0:05:26.95,0:05:28.32,Default,,0,0,0,,Тыңдаңыздар, ренжімеңіздер.
Dialogue: 0,0:05:26.95,0:05:28.32,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:28.32,0:05:29.24,Default,,0,0,0,,Тыңдаңыздар, ренжімеңіздер.
Dialogue: 0,0:05:35.62,0:05:39.25,Default,,0,0,0,,Мені ауруханаға апарып жатыр ма?
Dialogue: 0,0:05:39.33,0:05:40.75,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:05:41.54,0:05:43.84,Default,,0,0,0,,Ауруханадан шықсаң, Әлішейх, сусын ішейік.
Dialogue: 0,0:05:43.92,0:05:45.21,Default,,0,0,0,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,0:05:48.84,0:05:53.01,Default,,0,0,0,,Ах... Киби Бұл... ауырды.
Dialogue: 0,0:05:53.10,0:05:56.18,Default,,0,0,0,,Мен не істеуім керек? Ол аяқтады.
Dialogue: 0,0:05:57.52,0:06:00.73,Default,,0,0,0,,Мұның әдейі емес екенін бәрі біледі.
Dialogue: 0,0:06:00.81,0:06:02.73,Default,,0,0,0,,Қажет болса, куәлік беремін.
Dialogue: 0,0:06:02.82,0:06:05.15,Default,,0,0,0,,Жоқ... бұл дұрыс емес.
Dialogue: 0,0:06:06.07,0:06:08.40,Default,,0,0,0,,Қолыңызды жұлып алу сезімінен де артық
Dialogue: 0,0:06:08.49,0:06:10.66,Default,,0,0,0,,Барлығының көздері маған үрейлене қарайды
Dialogue: 0,0:06:11.24,0:06:13.08,Default,,0,0,0,,Барлығының сенгеніне сенімдімін.
Dialogue: 0,0:06:13.66,0:06:15.29,Default,,0,0,0,,Сол оқиға...
Dialogue: 0,0:06:15.37,0:06:18.37,Default,,0,0,0,,Те... Темуді жеген мен едім.
Dialogue: 0,0:06:18.46,0:06:19.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:21.21,0:06:22.13,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:06:22.21,0:06:23.67,Default,,0,0,0,,Жоқ! Бұл басқаша
Dialogue: 0,0:06:24.63,0:06:28.80,Default,,0,0,0,,Мен барлығын қорқытып алмас үшін сабырлы болуға тырыстым.
Dialogue: 0,0:06:28.88,0:06:30.13,Default,,0,0,0,,Бірақ бұл мүмкін емес.
Dialogue: 0,0:06:30.22,0:06:34.06,Default,,0,0,0,,Досыңның қолын жұлып алсаң да, өзіңді еркін ұстай алмайсың.
Dialogue: 0,0:06:34.14,0:06:35.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:35.22,0:06:36.52,Default,,0,0,0,,Тіпті мен және Аоба
Dialogue: 0,0:06:37.39,0:06:41.77,Default,,0,0,0,,Мен шабуыл жасадым деп, терлеуді тоқтата алмадым.
Dialogue: 0,0:06:42.31,0:06:43.65,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:45.86,0:06:47.65,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:06:50.07,0:06:51.82,Default,,0,0,0,,Менің формамда қан бар.
Dialogue: 0,0:06:51.91,0:06:53.83,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:06:53.91,0:06:56.12,Default,,0,0,0,,А... бұл рас.
Dialogue: 0,0:06:57.41,0:07:00.29,Default,,0,0,0,,Мынаны орамалға қарағанда жуған дұрыс сияқты.
Dialogue: 0,0:07:00.37,0:07:01.21,Default,,0,0,0,,Иә
Dialogue: 0,0:07:01.29,0:07:02.96,Default,,0,0,0,,Бұл жағы...
Dialogue: 0,0:07:04.21,0:07:07.67,Default,,0,0,0,,Сол күні Темді жеген сен едің ғой?
Dialogue: 0,0:07:07.76,0:07:08.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:11.09,0:07:13.14,Default,,0,0,0,,Бұл жерде енді алдаудың қажеті жоқ.
Dialogue: 0,0:07:13.22,0:07:14.39,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:14.97,0:07:16.60,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:18.68,0:07:22.23,Default,,0,0,0,,Сол терең сүйіс шешуші фактор болды ма?
Dialogue: 0,0:07:23.06,0:07:25.86,Default,,0,0,0,,Бұл сізді іздеудің жалғыз жолы болды.
Dialogue: 0,0:07:26.44,0:07:28.11,Default,,0,0,0,,Мен кешірім сұрамаймын.
Dialogue: 0,0:07:28.86,0:07:32.70,Default,,0,0,0,,Мен сені кесіп тастайды деп ешқашан ойламаппын.
Dialogue: 0,0:07:33.53,0:07:36.37,Default,,0,0,0,,Мен Тимді жегенім де менің қиялымнан шықты.
Dialogue: 0,0:07:37.24,0:07:39.25,Default,,0,0,0,,Жаңа ғана қате болды.
Dialogue: 0,0:07:40.00,0:07:42.29,Default,,0,0,0,,Егер сіз жай ғана «тамақ өлтіруді» елемесеңіз
Dialogue: 0,0:07:42.37,0:07:43.92,Default,,0,0,0,,Сіз солай ойладыңыз ба?
Dialogue: 0,0:07:44.00,0:07:47.25,Default,,0,0,0,,Хмм... солай емес пе?
Dialogue: 0,0:07:47.34,0:07:48.55,Default,,0,0,0,,Ийда…
Dialogue: 0,0:07:49.26,0:07:52.80,Default,,0,0,0,,Мен қазірден бастап аузымды жабуым керек.
Dialogue: 0,0:07:52.88,0:07:54.72,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:55.43,0:07:58.14,Default,,0,0,0,,Ақымақ болма… Мен сенің бәрін көріп тұрмын
Dialogue: 0,0:07:58.72,0:08:01.48,Default,,0,0,0,,Тырнақ өспейді, шаш тұрмайды
Dialogue: 0,0:08:01.56,0:08:05.10,Default,,0,0,0,,Жеңіске жету мүмкіндігі нөлге тең бе?
Dialogue: 0,0:08:06.36,0:08:07.44,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:08:07.52,0:08:10.07,Default,,0,0,0,,А, мен бұдан былай күте алмаймын.
Dialogue: 0,0:08:10.15,0:08:11.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:14.24,0:08:17.49,Default,,0,0,0,,Қибі-сенпайдың жүгімен еріксіз тастым.
Dialogue: 0,0:08:18.33,0:08:20.24,Default,,0,0,0,,О, құдайым.
Dialogue: 0,0:08:21.70,0:08:23.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:23.25,0:08:26.04,Default,,0,0,0,,Бұл Пина, драма үйірмесінің бірінші курс студенті (есіктің ашылған дыбысы)
Dialogue: 0,0:08:26.13,0:08:28.38,Default,,0,0,0,,Мынау Кибі-сенпайдың сөмкесі.
Dialogue: 0,0:08:28.46,0:08:30.42,Default,,0,0,0,,Оны сол жерде қалдырыңыз Иә
Dialogue: 0,0:08:30.51,0:08:32.92,Default,,0,0,0,,Жарайды, сондықтан шу шығармаңыз.
Dialogue: 0,0:08:33.01,0:08:34.68,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:34.76,0:08:37.26,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:08:39.89,0:08:42.31,Default,,0,0,0,,Тапсырманы орындау
Dialogue: 0,0:08:44.89,0:08:49.07,Default,,0,0,0,,Бұл жөндеу құны емес пе?
Dialogue: 0,0:08:49.15,0:08:50.53,Default,,0,0,0,,Мен үндемеймін.
Dialogue: 0,0:08:50.61,0:08:52.36,Default,,0,0,0,,Эй... Эй, күте тұр!
Dialogue: 0,0:08:53.32,0:08:55.07,Default,,0,0,0,,Сіз ештеңе естіген жоқсыз, солай ма?
Dialogue: 0,0:08:55.15,0:08:56.41,Default,,0,0,0,,Тыңдамағаныңды айт
Dialogue: 0,0:08:56.49,0:08:58.45,Default,,0,0,0,,Мм! Ах...
Dialogue: 0,0:08:58.53,0:08:59.37,Default,,0,0,0,,Хаа…
Dialogue: 0,0:08:59.45,0:09:02.37,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:09:03.00,0:09:07.04,Default,,0,0,0,,Кісі өлтіру ісі бойынша кінәлі Лиз-сенпай болды.
Dialogue: 0,0:09:07.12,0:09:09.25,Default,,0,0,0,,Маған қатысы жоқ
Dialogue: 0,0:09:10.42,0:09:13.80,Default,,0,0,0,,...Сен олай айтпадың деп ойладым.
Dialogue: 0,0:09:13.88,0:09:17.01,Default,,0,0,0,,Мен өзім араласу үшін келдім.
Dialogue: 0,0:09:18.05,0:09:22.27,Default,,0,0,0,,Етқоректілердің ұтымдылығын не бұзуы немесе сақтауы мүмкін?
Dialogue: 0,0:09:23.60,0:09:25.81,Default,,0,0,0,,Бұл шөпқоректі жануар.
Dialogue: 0,0:09:33.03,0:09:35.03,Default,,0,0,0,,Кяапина-кун
Dialogue: 0,0:09:35.11,0:09:36.61,Default,,0,0,0,,Пина-кун (Б студент қыз) Мына жаққа қара.
Dialogue: 0,0:09:36.70,0:09:38.16,Default,,0,0,0,,Көз қысу
Dialogue: 0,0:09:38.24,0:09:40.28,Default,,0,0,0,,иә... иә (студент қыздардың қошеметі)
Dialogue: 0,0:09:41.87,0:09:45.96,Default,,0,0,0,,Жарайды, мен жай ғана бейбіт талқылауды қалаймын.
Dialogue: 0,0:09:47.29,0:09:51.00,Default,,0,0,0,,Өтінемін, маған олай қарап тұрғандай қарама.
Dialogue: 0,0:09:51.09,0:09:52.30,Default,,0,0,0,,Лиз-сенпай
Dialogue: 0,0:09:52.38,0:09:53.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:54.01,0:09:55.59,Default,,0,0,0,,Мен ренжідім.
Dialogue: 0,0:09:55.67,0:09:57.26,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:09:57.34,0:10:01.10,Default,,0,0,0,,Менің қылмысымды екі студент ашты.
Dialogue: 0,0:10:01.76,0:10:04.77,Default,,0,0,0,,Қоңыр аюдың өзін қауіпсіз сезінуінің бір ғана жолы бар.
Dialogue: 0,0:10:04.85,0:10:06.93,Default,,0,0,0,,Менің сенен құтылудан басқа амалым жоқ.
Dialogue: 0,0:10:07.02,0:10:08.19,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:10:08.27,0:10:10.81,Default,,0,0,0,,Маған зиян келтіруді ұсынбаймын.
Dialogue: 0,0:10:11.40,0:10:14.32,Default,,0,0,0,,Шөпқоректі театр клубының мүшесі екі рет өлтірілсе ше?
Dialogue: 0,0:10:14.40,0:10:17.36,Default,,0,0,0,,Күтілгендей, полиция да мұқият тексереді.
Dialogue: 0,0:10:17.45,0:10:18.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:18.86,0:10:22.53,Default,,0,0,0,,Бар болғаны зерттеуіңізді драма үйірмесінің ет жейтін мүшелеріне бағыттау керек.
Dialogue: 0,0:10:22.62,0:10:24.87,Default,,0,0,0,,Мұны тіпті бастауыш сынып оқушылары да орындай алады
Dialogue: 0,0:10:24.95,0:10:26.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:26.12,0:10:27.71,Default,,0,0,0,,О, менің...
Dialogue: 0,0:10:27.79,0:10:29.08,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:10:30.79,0:10:34.05,Default,,0,0,0,,Мен дірілдеген жоқпын.
Dialogue: 0,0:10:34.67,0:10:38.38,Default,,0,0,0,,Мазасыз жағдай екеумізде.
Dialogue: 0,0:10:39.43,0:10:42.47,Default,,0,0,0,,Әзірше әділдік бүгін жеңіске жетті.
Dialogue: 0,0:10:42.55,0:10:43.39,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:44.76,0:10:47.35,Default,,0,0,0,,Ұйқысыз түн болсын
Dialogue: 0,0:10:48.52,0:10:50.44,Default,,0,0,0,,Кеттік, Легоши-сенпай.
Dialogue: 0,0:10:50.52,0:10:51.35,Default,,0,0,0,,Е... а...
Dialogue: 0,0:10:52.65,0:10:53.73,Default,,0,0,0,,Иә
Dialogue: 0,0:10:55.98,0:10:57.90,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:10:58.57,0:11:02.37,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:04.08,0:11:07.16,Default,,0,0,0,,Мектеп неге кенеттен жабылды?
Dialogue: 0,0:11:07.24,0:11:09.96,Default,,0,0,0,,Олар үнемі қызметкерлер жиналыстарын өткізетін сияқты.
Dialogue: 0,0:11:10.04,0:11:11.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:11.58,0:11:14.25,Default,,0,0,0,,...Менің айтайын дегенім, үй тапсырмасының көлемі тым қатал.
Dialogue: 0,0:11:14.34,0:11:16.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:17.67,0:11:19.59,Default,,0,0,0,,Төтенше жағдайдағы байланыс
Dialogue: 0,0:11:19.67,0:11:21.18,Default,,0,0,0,,Е... Е!
Dialogue: 0,0:11:21.97,0:11:25.76,Default,,0,0,0,,«Келесі жылдан бастап, біздің мектеп, Черритон академиясы»
Dialogue: 0,0:11:25.85,0:11:28.27,Default,,0,0,0,,«Етқоректі және шөпқоректілер класына бөлінеді»...
Dialogue: 0,0:11:28.93,0:11:30.85,Default,,0,0,0,,«Толығымен бөлек мектеп»?
Dialogue: 0,0:11:30.94,0:11:31.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.69,0:11:36.52,Default,,0,0,0,,Келесі айдан бастап драма үйірмесі де жұмысын тоқтатады.
Dialogue: 0,0:11:36.61,0:11:39.61,Default,,0,0,0,,Бұл етқоректі-шөпқоректілерді біріктіретін мектеп.
Dialogue: 0,0:11:39.69,0:11:41.28,Default,,0,0,0,,Қазір азайып барады.
Dialogue: 0,0:11:41.36,0:11:42.78,Default,,0,0,0,,тым кеш болды.
Dialogue: 0,0:11:42.86,0:11:45.49,Default,,0,0,0,,Менің анам да мектепке шағым түсірді.
Dialogue: 0,0:11:45.57,0:11:47.62,Default,,0,0,0,,Шөпқоректі туыстарының бәрі де солай емес пе?
Dialogue: 0,0:11:48.58,0:11:52.16,Default,,0,0,0,,«Мен аштыққа ұшыраған сыныптастарыммен сабаққа қатыса алмаймын».
Dialogue: 0,0:11:53.17,0:11:58.80,Default,,0,0,0,,Мен сияқты жыртқыштың пікір айтуға құқығы жоқ шығар...
Dialogue: 0,0:12:01.13,0:12:02.43,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:02.51,0:12:05.89,Default,,0,0,0,,Жоқ, жоқ, мен драма үйірмесіндегі ең позитивті адаммын.
Dialogue: 0,0:12:05.97,0:12:08.18,Default,,0,0,0,,Қараңғы түскенде не істеуім керек?
Dialogue: 0,0:12:08.26,0:12:09.89,Default,,0,0,0,,Билл...
Dialogue: 0,0:12:12.10,0:12:14.40,Default,,0,0,0,,Бұл не, Элс?
Dialogue: 0,0:12:14.48,0:12:16.56,Default,,0,0,0,,Мен таң қалдым хахаха
Dialogue: 0,0:12:16.65,0:12:18.40,Default,,0,0,0,,Үйірме жұмыстарына бірге барғыңыз келе ме?
Dialogue: 0,0:12:18.48,0:12:20.44,Default,,0,0,0,,Сіз естідіңіз бе? Үйірме жұмыстары...
Dialogue: 0,0:12:20.53,0:12:21.65,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:12:22.95,0:12:25.57,Default,,0,0,0,,Осы айдың соңында іс-шаралар тоқтатылады ма?
Dialogue: 0,0:12:25.66,0:12:28.37,Default,,0,0,0,,Мен оның кенеттен болғанына таң қалдым.
Dialogue: 0,0:12:28.45,0:12:31.00,Default,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,0:12:31.08,0:12:32.25,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:12:32.33,0:12:34.67,Default,,0,0,0,,А... көмектесе алмаймыз ба?
Dialogue: 0,0:12:34.75,0:12:36.71,Default,,0,0,0,,Елдер қуансын
Dialogue: 0,0:12:36.79,0:12:39.92,Default,,0,0,0,,Сіздің қауіпсіздігіңіз қамтамасыз етіледі.
Dialogue: 0,0:12:40.00,0:12:41.71,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:12:44.09,0:12:45.43,Default,,0,0,0,,Әй... әйтеуір
Dialogue: 0,0:12:46.22,0:12:48.80,Default,,0,0,0,,Мұны қай ауызда айтады?
Dialogue: 0,0:12:48.89,0:12:50.18,Default,,0,0,0,,E… Els?
Dialogue: 0,0:12:50.26,0:12:53.10,Default,,0,0,0,,Мен Биллдің қауіпсіздік туралы айтқанын қаламаймын.
Dialogue: 0,0:12:54.02,0:12:55.48,Default,,0,0,0,,«Урайчи» деп аталатын жерде
Dialogue: 0,0:12:55.56,0:12:57.15,Default,,0,0,0,,Мен шөпқоректілерден жасырын ет сатып алып жесем де.
Dialogue: 0,0:12:57.15,0:12:58.19,Default,,0,0,0,,Мен шөпқоректілерден жасырын ет сатып алып жесем де.
Dialogue: 0,0:12:57.15,0:12:58.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:58.27,0:13:00.07,Default,,0,0,0,,А... неге олай істедің?
Dialogue: 0,0:13:00.73,0:13:02.99,Default,,0,0,0,,Бөлім ішінде қауесеттер таралып үлгерді.
Dialogue: 0,0:13:03.65,0:13:05.24,Default,,0,0,0,,Сіз ет жеп көрдіңіз бе?
Dialogue: 0,0:13:05.32,0:13:08.16,Default,,0,0,0,,«Егер Эльс Местра болса, мен оны шынымен де ұстай аламын».
Dialogue: 0,0:13:08.24,0:13:09.70,Default,,0,0,0,,Менің киім ауыстыратын бөлмеде айтқаным
Dialogue: 0,0:13:09.78,0:13:13.54,Default,,0,0,0,,Сіздің барлық бұзақылықтарыңыз әшкере болады.
Dialogue: 0,0:13:13.62,0:13:14.46,Default,,0,0,0,,Е...
Dialogue: 0,0:13:14.54,0:13:16.96,Default,,0,0,0,,Дегенмен, біз оны жеңдік.
Dialogue: 0,0:13:17.04,0:13:18.88,Default,,0,0,0,,Жабайы жүрме, шөпқоректілер қорқады.
Dialogue: 0,0:13:18.96,0:13:20.92,Default,,0,0,0,,Бұл ұсынылған манга
Dialogue: 0,0:13:21.00,0:13:22.05,Default,,0,0,0,,Адамның жаман және жақсы жақтары
Dialogue: 0,0:13:22.05,0:13:23.96,Default,,0,0,0,,Адамның жаман және жақсы жақтары
Dialogue: 0,0:13:22.05,0:13:23.96,Default,,0,0,0,,Етқоректілерді шөпқоректілермен қоршап, қорғаңыз!
Dialogue: 0,0:13:24.05,0:13:26.01,Default,,0,0,0,,Барлығы көзге түседі...
Dialogue: 0,0:13:26.72,0:13:28.59,Default,,0,0,0,,Бұл клуб әрекеті!
Dialogue: 0,0:13:28.68,0:13:30.14,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:13:30.22,0:13:32.18,Default,,0,0,0,,Неліктен мұндай уақытта?
Dialogue: 0,0:13:32.26,0:13:34.64,Default,,0,0,0,,Шығару оңай болды...
Dialogue: 0,0:13:34.73,0:13:37.10,Default,,0,0,0,,Аа, бұл жеткілікті Эльс
Dialogue: 0,0:13:37.19,0:13:39.19,Default,,0,0,0,,Сен маған айқайлауға үйренбегенсің ғой?
Dialogue: 0,0:13:39.77,0:13:42.82,Default,,0,0,0,,Кешіріңіз, бұл менің кінәм болды.
Dialogue: 0,0:13:42.90,0:13:44.19,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:13:45.74,0:13:47.28,Default,,0,0,0,,Қарсылық білдірейік
Dialogue: 0,0:13:47.36,0:13:49.74,Default,,0,0,0,,Мен де үйірме жұмыстарын жалғастырғым келеді.
Dialogue: 0,0:13:49.82,0:13:51.70,Default,,0,0,0,,Дайындық залына барайық
Dialogue: 0,0:13:52.28,0:13:55.29,Default,,0,0,0,,Бірақ, бұл оңай емес.
Dialogue: 0,0:13:56.04,0:13:57.37,Default,,0,0,0,,Бүгінгі хабарламаға қатысты.
Dialogue: 0,0:13:57.46,0:13:58.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:59.63,0:14:01.67,Default,,0,0,0,,Әй, екеуі де баяу болды.
Dialogue: 0,0:14:01.75,0:14:03.38,Default,,0,0,0,,Қазір барлығы осында
Dialogue: 0,0:14:03.46,0:14:04.38,Default,,0,0,0,,Сонымен... бұл
Dialogue: 0,0:14:04.46,0:14:06.47,Default,,0,0,0,,Мен үйірме жұмыстарын жалғастыру керек деп ойлаймын.
Dialogue: 0,0:14:06.55,0:14:07.55,Default,,0,0,0,,О
Dialogue: 0,0:14:08.30,0:14:11.05,Default,,0,0,0,,Жарайды, бұл жерден не істеу керек деген сұрақ туындайды.
Dialogue: 0,0:14:11.14,0:14:13.10,Default,,0,0,0,,(мүшелердің сөйлейтін дыбыстары)
Dialogue: 0,0:14:13.18,0:14:14.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:14.52,0:14:17.18,Default,,0,0,0,,(мүшелердің сөйлейтін дыбыстары)
Dialogue: 0,0:14:17.27,0:14:19.02,Default,,0,0,0,,Сіз Елспен ұрысып қалдыңыз ба?
Dialogue: 0,0:14:19.10,0:14:20.40,Default,,0,0,0,,Қарғыс атсын, ақымақ.
Dialogue: 0,0:14:22.23,0:14:24.19,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:14:26.15,0:14:28.95,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:14:29.82,0:14:32.45,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:14:32.53,0:14:34.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:34.29,0:14:35.29,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:35.95,0:14:37.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:37.79,0:14:39.83,Default,,0,0,0,,Мен төзімдісін сатып алдым.
Dialogue: 0,0:14:40.42,0:14:42.71,Default,,0,0,0,,Ұйқысыз түн болсын
Dialogue: 0,0:14:43.29,0:14:47.01,Default,,0,0,0,,Пина-кун, сен айтпасаң да
Dialogue: 0,0:14:47.09,0:14:52.30,Default,,0,0,0,,Мен көптен бері тыныш ұйықтай алмадым.
Dialogue: 0,0:14:52.89,0:14:55.10,Default,,0,0,0,,Амансың ба? Ах...
Dialogue: 0,0:14:55.18,0:14:57.06,Default,,0,0,0,,Лиз - ауыр жанама әсер.
Dialogue: 0,0:14:57.14,0:15:00.48,Default,,0,0,0,,Уф... Чикушо соғып жатыр.
Dialogue: 0,0:15:00.56,0:15:02.73,Default,,0,0,0,,Сабырлы бол, сабырлы бол.
Dialogue: 0,0:15:02.81,0:15:04.82,Default,,0,0,0,,Біз үлкен аюмыз...
Dialogue: 0,0:15:05.57,0:15:08.74,Default,,0,0,0,,Биіктігі 2 метрден асатын аюлар
Dialogue: 0,0:15:08.82,0:15:13.07,Default,,0,0,0,,Бұлшықет атрофиясын тудыратын препараттарды қабылдау үшін қажет
Dialogue: 0,0:15:13.16,0:15:16.70,Default,,0,0,0,,Өйткені аюлар тұқымдасының басым күші қауіп төндіреді.
Dialogue: 0,0:15:16.79,0:15:18.83,Default,,0,0,0,,Ірі жазатайым оқиғаларды болдырмау үшін.
Dialogue: 0,0:15:18.91,0:15:20.08,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:15:21.46,0:15:22.50,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:15:23.25,0:15:27.21,Default,,0,0,0,,Әр түнде нашақор болғанның қорлығы...
Dialogue: 0,0:15:43.40,0:15:48.11,Default,,0,0,0,,Бұл симптомды басатын жалғыз нәрсе бал.
Dialogue: 0,0:15:49.32,0:15:50.69,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:50.78,0:15:53.28,Default,,0,0,0,,Лиз мені үнемі жұбатады.
Dialogue: 0,0:15:53.36,0:15:55.16,Default,,0,0,0,,Лиз жаңғақты жарып жіберді.
Dialogue: 0,0:15:55.24,0:15:57.53,Default,,0,0,0,,Эй, Лиз мейірімді болғандықтан...
Dialogue: 0,0:15:57.53,0:15:57.91,Default,,0,0,0,,Эй, Лиз мейірімді болғандықтан...
Dialogue: 0,0:15:57.53,0:15:57.91,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:15:57.91,0:15:57.99,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:15:57.99,0:15:59.95,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:15:57.99,0:15:59.95,Default,,0,0,0,,Мені бәрі қалай көреді
Dialogue: 0,0:15:59.95,0:16:00.04,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:16:00.04,0:16:01.37,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:16:00.04,0:16:01.37,Default,,0,0,0,,Балды ұнататын нәзік және үлкен аю.
Dialogue: 0,0:16:01.37,0:16:03.58,Default,,0,0,0,,Балды жақсы көретін нәзік және үлкен аю.
Dialogue: 0,0:16:04.58,0:16:08.05,Default,,0,0,0,,Менің кім екенімді ешкім білмеді.
Dialogue: 0,0:16:08.96,0:16:10.46,Default,,0,0,0,,Тек бір...
Dialogue: 0,0:16:11.26,0:16:12.93,Default,,0,0,0,,Ол жігіттен басқа
Dialogue: 0,0:16:15.80,0:16:18.35,Default,,0,0,0,,Лизде қорқынышты нәрсе бар.
Dialogue: 0,0:16:18.43,0:16:19.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:19.72,0:16:21.52,Default,,0,0,0,,Тем не деді?
Dialogue: 0,0:16:22.18,0:16:23.06,Default,,0,0,0,,Иә
Dialogue: 0,0:16:23.14,0:16:27.31,Default,,0,0,0,,Қайта қарағанымда оның шынымен де үлкен екенін түсіндім.
Dialogue: 0,0:16:27.90,0:16:30.48,Default,,0,0,0,,Ой... біртүрлі айттым ба? Кешіріңіз
Dialogue: 0,0:16:30.57,0:16:33.65,Default,,0,0,0,,Мен таң қалдым, өйткені бұл сөзді бірінші рет естіп тұрмын.
Dialogue: 0,0:16:33.74,0:16:35.53,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:16:35.61,0:16:37.16,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:37.24,0:16:40.74,Default,,0,0,0,,А... жоқ, кешіріңіз, мен дұрыс айтпаған шығармын.
Dialogue: 0,0:16:41.29,0:16:44.92,Default,,0,0,0,,Мен бәрінің жанды екенін көргенде сенің жүзіңе қызығамын.
Dialogue: 0,0:16:49.09,0:16:53.01,Default,,0,0,0,,Жоғары деңгейдегі перспектива шынымен қауіпті ме?
Dialogue: 0,0:16:53.92,0:16:55.72,Default,,0,0,0,,Сіз әрқашан не туралы ойлайсыз?
Dialogue: 0,0:16:56.34,0:16:59.56,Default,,0,0,0,,Балдан тәтті сөздер
Dialogue: 0,0:16:59.64,0:17:02.98,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:03.06,0:17:07.31,Default,,0,0,0,,Мен кенеттен енді жеңілдеп қалдым.
Dialogue: 0,0:17:07.40,0:17:10.52,Default,,0,0,0,,А... бірдеңе уайымдап жүрсе, сұрайын деп едім.
Dialogue: 0,0:17:10.61,0:17:12.23,Default,,0,0,0,,Сыртта шырын ішкіңіз келе ме?
Dialogue: 0,0:17:12.32,0:17:13.90,Default,,0,0,0,,Е... бұл жақсы.
Dialogue: 0,0:17:13.99,0:17:15.40,Default,,0,0,0,,Сіз маған жаңа ғана айттыңыз...
Dialogue: 0,0:17:15.49,0:17:18.41,Default,,0,0,0,,Мен қорқамын дедім, бірақ жаман сөз деп айтпадым.
Dialogue: 0,0:17:20.62,0:17:23.54,Default,,0,0,0,,Тем көргенін айтатын адам еді.
Dialogue: 0,0:17:24.16,0:17:25.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:26.04,0:17:29.63,Default,,0,0,0,,Мен аюлардың осылай есірткі қабылдағанын білмедім.
Dialogue: 0,0:17:29.71,0:17:31.21,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:17:31.30,0:17:36.01,Default,,0,0,0,,Осы уақытқа дейін дәрі туралы отбасымнан басқа ешкімге айтқан емеспін.
Dialogue: 0,0:17:36.09,0:17:39.30,Default,,0,0,0,,Шөпқоректіге сыр бермейік.
Dialogue: 0,0:17:39.39,0:17:40.35,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:40.43,0:17:42.47,Default,,0,0,0,,Оны жай айту оңай емес пе?
Dialogue: 0,0:17:42.56,0:17:43.43,Default,,0,0,0,,Төтенше
Dialogue: 0,0:17:43.52,0:17:47.77,Default,,0,0,0,,Мен оның шынымен де адамнан тыс күші бар екенін білгенде, ол оны дәрі-дәрмекпен басып тастады.
Dialogue: 0,0:17:47.85,0:17:49.56,Default,,0,0,0,,Барлығы тартады.
Dialogue: 0,0:17:49.65,0:17:51.36,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:51.94,0:17:54.61,Default,,0,0,0,,Лиздің мейірімді екенін бәрі біледі.
Dialogue: 0,0:17:54.69,0:17:56.07,Default,,0,0,0,,Ешқандай проблема жоқ.
Dialogue: 0,0:17:56.15,0:17:56.99,Default,,0,0,0,,Түрлі?
Dialogue: 0,0:17:57.07,0:17:58.70,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:58.78,0:18:01.78,Default,,0,0,0,,Нағыз мен мейірімді емес
Dialogue: 0,0:18:02.33,0:18:06.29,Default,,0,0,0,,Мен мейірімділіктің не екенін түсінбеймін.
Dialogue: 0,0:18:06.37,0:18:07.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:07.66,0:18:08.87,Default,,0,0,0,,Әй, эй
Dialogue: 0,0:18:08.96,0:18:12.46,Default,,0,0,0,,Сіз менімен бұрын сөйлескенде, сіз өзіңізді жеңіл сезінетінін айттыңыз.
Dialogue: 0,0:18:12.54,0:18:15.26,Default,,0,0,0,,Енді үйірме жұмыстарынан тыс уақытта жиі кездесейік.
Dialogue: 0,0:18:15.34,0:18:17.34,Default,,0,0,0,,Жанама әсерлер толығымен жойылуы мүмкін.
Dialogue: 0,0:18:19.43,0:18:21.76,Default,,0,0,0,,Тимнің ұсынысы дұрыс болды.
Dialogue: 0,0:18:22.35,0:18:24.26,Default,,0,0,0,,Тиммен бірнеше күн бос сөз сөйлесе де.
Dialogue: 0,0:18:24.26,0:18:25.64,Default,,0,0,0,,Тиммен бірнеше күн бос сөз сөйлесе де.
Dialogue: 0,0:18:24.26,0:18:25.64,Default,,0,0,0,,(Темнің дауысы мен Лиздің күлкісі)
Dialogue: 0,0:18:25.64,0:18:25.72,Default,,0,0,0,,(Темнің дауысы және Лиздің күлкісі)
Dialogue: 0,0:18:25.72,0:18:28.35,Default,,0,0,0,,(Темнің дауысы және Лиздің күлкісі)
Dialogue: 0,0:18:25.72,0:18:28.35,Default,,0,0,0,,Менің бал тұтынуым азайды.
Dialogue: 0,0:18:29.73,0:18:31.44,Default,,0,0,0,,Мұның бәрі оның арқасында.
Dialogue: 0,0:18:31.52,0:18:34.15,Default,,0,0,0,,Дәрі қабылдау да көңіл күйді түсірмейді.
Dialogue: 0,0:18:36.15,0:18:37.19,Default,,0,0,0,,Бұл…
Dialogue: 0,0:18:37.78,0:18:40.53,Default,,0,0,0,,Бұл маған қазір керек пе?
Dialogue: 0,0:18:41.78,0:18:44.24,Default,,0,0,0,,Мен жақынырақ болғым келеді
Dialogue: 0,0:18:44.33,0:18:45.99,Default,,0,0,0,,Темаға дейінгі қашықтық
Dialogue: 0,0:18:46.08,0:18:47.75,Default,,0,0,0,,Өзіңізге адал болыңыз
Dialogue: 0,0:18:54.96,0:18:56.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:56.59,0:18:59.88,Default,,0,0,0,,Бүгін Лизге бірдеңе болды ма?
Dialogue: 0,0:18:59.97,0:19:01.93,Default,,0,0,0,,Менің денем ісіп кетті...
Dialogue: 0,0:19:02.01,0:19:02.97,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:19:03.05,0:19:05.26,Default,,0,0,0,,Мен алғаш рет дәрі-дәрмектен бас тартуға тырыстым.
Dialogue: 0,0:19:05.35,0:19:07.18,Default,,0,0,0,,Не істеп жатырсың?
Dialogue: 0,0:19:07.27,0:19:08.35,Default,,0,0,0,,Бұл жаман болар еді.
Dialogue: 0,0:19:08.43,0:19:11.35,Default,,0,0,0,,Маған бұл енді керек емес.
Dialogue: 0,0:19:12.94,0:19:14.02,Default,,0,0,0,,Неге қашып бара жатырсың?
Dialogue: 0,0:19:14.11,0:19:15.11,Default,,0,0,0,,Уау
Dialogue: 0,0:19:15.19,0:19:16.11,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:16.19,0:19:18.03,Default,,0,0,0,,Ха ха ха... Уф!
Dialogue: 0,0:19:19.90,0:19:21.82,Default,,0,0,0,,Күту.
Dialogue: 0,0:19:21.91,0:19:25.41,Default,,0,0,0,,Тем, мен сенің нағыз мені көргім келді.
Dialogue: 0,0:19:31.50,0:19:32.88,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:32.96,0:19:34.96,Default,,0,0,0,,Біз бір-бірімізді түсінуіміз керек, солай ма? біз
Dialogue: 0,0:19:35.63,0:19:37.25,Default,,0,0,0,,Бұл солай болуы керек пе?
Dialogue: 0,0:19:38.21,0:19:41.76,Default,,0,0,0,,Етқоректілердің бәрі - құбыжықтар!
Dialogue: 0,0:19:42.89,0:19:46.05,Default,,0,0,0,,Темнің сөзі де, көзі де солай деді.
Dialogue: 0,0:19:46.14,0:19:48.89,Default,,0,0,0,,Ең әдемі нәрсе
Dialogue: 0,0:19:48.97,0:19:51.02,Default,,0,0,0,,Нағыз достық сияқты
Dialogue: 0,0:19:51.69,0:19:52.77,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:53.40,0:19:55.65,Default,,0,0,0,,Енді ештеңені жасырудың қажеті жоқ
Dialogue: 0,0:19:56.52,0:19:58.28,Default,,0,0,0,,Біз ең жақсы достармыз
Dialogue: 0,0:19:58.36,0:19:59.74,Default,,0,0,0,,А...
Dialogue: 0,0:20:00.53,0:20:02.24,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:20:02.32,0:20:04.20,Default,,0,0,0,,Осыншама адамдық күш
Dialogue: 0,0:20:04.70,0:20:07.08,Default,,0,0,0,,Сіздің керемет даралығыңыз
Dialogue: 0,0:20:08.91,0:20:12.25,Default,,0,0,0,,Мен сен туралы бәрін қабылдаймын, Лиз.
Dialogue: 0,0:20:13.37,0:20:15.58,Default,,0,0,0,,Енді азап шегудің қажеті жоқ
Dialogue: 0,0:20:17.00,0:20:18.38,Default,,0,0,0,,Тем…
Dialogue: 0,0:20:30.93,0:20:32.18,Default,,0,0,0,,Тем
Dialogue: 0,0:20:37.36,0:20:38.61,Default,,0,0,0,,Тем?
Dialogue: 0,0:20:39.65,0:20:43.28,Default,,0,0,0,,Қан мен ет кесектері әр жерде шашыранды.
Dialogue: 0,0:20:43.86,0:20:46.37,Default,,0,0,0,,Шарасыз қарсылықтың іздері
Dialogue: 0,0:20:47.12,0:20:49.83,Default,,0,0,0,,Тіпті менің Теммен болған естеліктерім
Dialogue: 0,0:20:49.91,0:20:52.37,Default,,0,0,0,,Барлығы иллюзияға айналады
Dialogue: 0,0:20:52.45,0:20:55.62,Default,,0,0,0,,Кез келген жағдайда аулақ болу керек
Dialogue: 0,0:20:56.63,0:20:59.42,Default,,0,0,0,,Текстура түсі…
Dialogue: 0,0:20:59.50,0:21:03.01,Default,,0,0,0,,Жылу дәмі…
Dialogue: 0,0:21:03.09,0:21:07.22,Default,,0,0,0,,Менің жарқын жастық шағым туралы
Dialogue: 0,0:21:08.97,0:21:10.93,Default,,0,0,0,,Өлгенше ұмытпа
Dialogue: 0,0:21:10.93,0:21:11.43,Default,,0,0,0,,Өлгенше ұмытпа
Dialogue: 0,0:21:10.93,0:21:11.43,Default,,0,0,0,,Ах~ Дәмді Әдеттегідей рахмет
Dialogue: 0,0:21:11.43,0:21:12.06,Default,,0,0,0,,Ах~ Дәмді Әдеттегідей рахмет
Dialogue: 0,0:21:12.06,0:21:13.93,Default,,0,0,0,,Ах~ Дәмді Әдеттегідей рахмет
Dialogue: 0,0:21:12.06,0:21:13.93,Default,,0,0,0,,Менің қазынам
Dialogue: 0,0:21:13.93,0:21:14.89,Default,,0,0,0,,Ах~ Дәмді Әдеттегідей рахмет
Dialogue: 0,0:21:22.03,0:21:28.03,Default,,0,0,0,,♪～
Dialogue: 0,0:22:42.31,0:22:48.32,Default,,0,0,0,,～♪
