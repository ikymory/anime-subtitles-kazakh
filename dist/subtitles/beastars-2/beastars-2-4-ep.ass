Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.09,0:00:18.10,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.92,0:01:39.18,Default,,0,0,0,,～♪
Dialogue: 0,0:01:48.02,0:01:49.31,Default,,0,0,0,,Сәлем, Тим?
Dialogue: 0,0:01:49.40,0:01:53.02,Default,,0,0,0,,Альпака жүнінің қой жүнінен айырмашылығы бар ма?
Dialogue: 0,0:01:53.11,0:01:56.86,Default,,0,0,0,,Хехехе, альпакалардың жүні нәзік.
Dialogue: 0,0:01:57.61,0:01:58.82,Default,,0,0,0,,Оны түртуге болады.
Dialogue: 0,0:01:58.91,0:02:00.74,Default,,0,0,0,,Мен оған қол тигіземін
Dialogue: 0,0:02:00.82,0:02:01.99,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:03.91,0:02:05.37,Default,,0,0,0,,Әрине
Dialogue: 0,0:02:07.29,0:02:08.29,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:02:08.37,0:02:09.92,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:02:10.00,0:02:13.38,Default,,0,0,0,,Жоқ, жоқ, бұл не естелік?
Dialogue: 0,0:02:14.46,0:02:18.84,Default,,0,0,0,,Бірақ шындығында ол Тем екеуі соншалықты жақын болды.
Dialogue: 0,0:02:18.93,0:02:21.97,Default,,0,0,0,,Мен Темді жеген қылмыскерді тапқым келеді.
Dialogue: 0,0:02:22.05,0:02:25.77,Default,,0,0,0,,Бірақ бұл жеке міндеттілік сезімі емес...
Dialogue: 0,0:02:25.85,0:02:27.14,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:27.23,0:02:28.81,Default,,0,0,0,,Уау
Dialogue: 0,0:02:31.10,0:02:32.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:33.48,0:02:36.78,Default,,0,0,0,,Ха... бұл үлкен және жаман.
Dialogue: 0,0:02:36.86,0:02:40.49,Default,,0,0,0,,Уф... бұл кім! Эй
Dialogue: 0,0:02:40.57,0:02:41.87,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:02:41.95,0:02:43.49,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:02:43.58,0:02:45.16,Default,,0,0,0,,Гах...
Dialogue: 0,0:02:47.25,0:02:48.96,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:49.04,0:02:51.25,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:02:52.58,0:02:56.92,Default,,0,0,0,,Иә? Не... не болып жатыр?
Dialogue: 0,0:02:57.67,0:02:59.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:00.01,0:03:01.59,Default,,0,0,0,,（）
Dialogue: 0,0:03:01.68,0:03:05.01,Default,,0,0,0,,Жоқ, суық тиіп қалдым, мұрным істемейді.
Dialogue: 0,0:03:05.51,0:03:09.31,Default,,0,0,0,,Сіз Тимді өлтірген кінәлісіз.
Dialogue: 0,0:03:09.89,0:03:14.40,Default,,0,0,0,,Уф... у...
Dialogue: 0,0:03:17.36,0:03:19.53,Default,,0,0,0,,Ой... сен мені қорқытпақшысың ба?
Dialogue: 0,0:03:20.07,0:03:22.57,Default,,0,0,0,,Енді иіскеуді доғар.
Dialogue: 0,0:03:24.49,0:03:27.29,Default,,0,0,0,,Өз күшіңізді көрсетуді ұнататын сияқтысыз.
Dialogue: 0,0:03:29.45,0:03:30.62,Default,,0,0,0,,Етқоректі жануар ретінде...
Dialogue: 0,0:03:30.71,0:03:32.29,Default,,0,0,0,,Гррр…
Dialogue: 0,0:03:32.37,0:03:35.13,Default,,0,0,0,,Ah... uh...
Dialogue: 0,0:03:36.21,0:03:39.01,Default,,0,0,0,,Альпакалардың нәзік пальтолары бар.
Dialogue: 0,0:03:39.80,0:03:41.38,Default,,0,0,0,,Оны түртуге болады.
Dialogue: 0,0:03:42.18,0:03:43.64,Default,,0,0,0,,Тем
Dialogue: 0,0:03:43.72,0:03:46.64,Default,,0,0,0,,Екеуміз жақын болғанымызға өкінемін.
Dialogue: 0,0:03:47.89,0:03:52.27,Default,,0,0,0,,Шөпқоректілер бізді жыртқыштарға жақындатады.
Dialogue: 0,0:03:52.94,0:03:55.86,Default,,0,0,0,,Бұл өте ерекше нәрсе.
Dialogue: 0,0:03:56.86,0:04:00.19,Default,,0,0,0,,Бұл біз ет жейтіндер үшін ұмытатын ең маңызды нәрсе.
Dialogue: 0,0:04:00.28,0:04:04.07,Default,,0,0,0,,Жануардың үнемі өлім аузында болуы қандай сезімде болады?
Dialogue: 0,0:04:04.61,0:04:06.16,Default,,0,0,0,,Білмесем де
Dialogue: 0,0:04:07.41,0:04:11.54,Default,,0,0,0,,Дұрыс, Хару-чан қатал.
Dialogue: 0,0:04:12.33,0:04:15.33,Default,,0,0,0,,Бірақ қазір аздап түсіндім.
Dialogue: 0,0:04:15.42,0:04:20.21,Default,,0,0,0,,Мен шөпқоректілердің барлығын өтеу үшін бірдеңе істеймін.
Dialogue: 0,0:04:20.80,0:04:21.63,Default,,0,0,0,,(шағу дыбысы)
Dialogue: 0,0:04:21.71,0:04:26.18,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:04:27.05,0:04:29.31,Default,,0,0,0,,Ол туралы мәліметтерді табыңыз.
Dialogue: 0,0:04:29.39,0:04:31.98,Default,,0,0,0,,Дәмі бойынша Түрту арқылы
Dialogue: 0,0:04:32.73,0:04:34.48,Default,,0,0,0,,Тіс сауыты ше?
Dialogue: 0,0:04:34.56,0:04:36.65,Default,,0,0,0,,Еттің дәмін көре аласыз ба?
Dialogue: 0,0:04:37.73,0:04:39.52,Default,,0,0,0,,Мені бер
Dialogue: 0,0:04:39.61,0:04:40.57,Default,,0,0,0,,Беріңіз!
Dialogue: 0,0:04:40.65,0:04:42.15,Default,,0,0,0,,Сілекей
Dialogue: 0,0:04:42.24,0:04:43.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:43.15,0:04:45.07,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:45.66,0:04:46.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:46.78,0:04:48.49,Default,,0,0,0,,Бұл не екенін білесің бе?
Dialogue: 0,0:04:48.57,0:04:49.41,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:49.49,0:04:52.70,Default,,0,0,0,,（）
Dialogue: 0,0:04:54.12,0:04:56.29,Default,,0,0,0,,Өз санаңызды нақтылаңыз
Dialogue: 0,0:04:57.13,0:05:00.84,Default,,0,0,0,,Бұл дәмді жақсы есте сақтаңыз.
Dialogue: 0,0:05:02.96,0:05:05.09,Default,,0,0,0,,...Шынымен айтайын дегенім.
Dialogue: 0,0:05:05.17,0:05:07.18,Default,,0,0,0,,Егер солай болса, дәл қазір
Dialogue: 0,0:05:07.76,0:05:11.26,Default,,0,0,0,,Мен Хару-чанмен бірінші сүйісуім керек еді.
Dialogue: 0,0:05:12.02,0:05:14.27,Default,,0,0,0,,(Ойынның дыбыс әсерлері)
Dialogue: 0,0:05:14.35,0:05:16.52,Default,,0,0,0,,Уау, рас па?
Dialogue: 0,0:05:16.60,0:05:17.98,Default,,0,0,0,,Бұл қорлау
Dialogue: 0,0:05:18.06,0:05:19.06,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:05:19.15,0:05:19.90,Default,,0,0,0,,Сол құйрықтың соққыларына абай болу керек.
Dialogue: 0,0:05:19.90,0:05:21.44,Default,,0,0,0,,Сол құйрықтан келетін соққыларға абай болу керек.
Dialogue: 0,0:05:19.90,0:05:21.44,Default,,0,0,0,,(Ойынның дыбыс әсерлері)
Dialogue: 0,0:05:21.44,0:05:22.28,Default,,0,0,0,,Сол құйрықтың соққыларына абай болу керек.
Dialogue: 0,0:05:23.28,0:05:24.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:24.78,0:05:27.16,Default,,0,0,0,,Бұл Джектің ұялы телефоны емес пе?
Dialogue: 0,0:05:27.24,0:05:30.83,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:05:35.16,0:05:36.50,Default,,0,0,0,,Сәлеметсіз бе, Легоси?
Dialogue: 0,0:05:36.58,0:05:40.50,Default,,0,0,0,,(Легошидің күрсінуі)
Dialogue: 0,0:05:41.84,0:05:43.76,Default,,0,0,0,,Оған бар күшімді салуым керек.
Dialogue: 0,0:05:43.84,0:05:46.97,Default,,0,0,0,,Бұл Легосидің мұрны нашар сезінгендегі ырылдауы.
Dialogue: 0,0:05:47.51,0:05:49.43,Default,,0,0,0,,Бұл ұлпаларды сұрайтын SOS ме?
Dialogue: 0,0:05:49.51,0:05:50.80,Default,,0,0,0,,Не, түсіндің бе?
Dialogue: 0,0:05:50.89,0:05:52.56,Default,,0,0,0,,Біз бір-бірімізді бұрыннан танимыз.
Dialogue: 0,0:05:56.48,0:05:59.02,Default,,0,0,0,,Легоси, сәлем
Dialogue: 0,0:06:00.90,0:06:03.44,Default,,0,0,0,,Не болды? Жауап беру.
Dialogue: 0,0:06:03.52,0:06:05.36,Default,,0,0,0,,Легоши? Эй
Dialogue: 0,0:06:05.44,0:06:07.20,Default,,0,0,0,,(жел диірменінің айналу дыбысы)
Dialogue: 0,0:06:07.20,0:06:10.16,Default,,0,0,0,,(Жел диірменінің айналу дыбысы)
Dialogue: 0,0:06:07.20,0:06:10.16,Default,,0,0,0,,Иә? Бұл дыбыс...
Dialogue: 0,0:06:14.74,0:06:16.16,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:06:16.25,0:06:18.50,Default,,0,0,0,,Мен Легоси үшін не істей аламын
Dialogue: 0,0:06:19.00,0:06:21.38,Default,,0,0,0,,Қартайған сайын ол жоғалады.
Dialogue: 0,0:06:22.21,0:06:24.09,Default,,0,0,0,,Шын мәнінде, барлық уақытта
Dialogue: 0,0:06:24.75,0:06:26.88,Default,,0,0,0,,Мен бұл туралы білемін
Dialogue: 0,0:06:28.72,0:06:31.55,Default,,0,0,0,,Мен сізге орынды айтып үлгермедім.
Dialogue: 0,0:06:32.26,0:06:35.35,Default,,0,0,0,,Ол мені көргенде үрейленбейді деп үміттенемін.
Dialogue: 0,0:06:35.43,0:06:38.56,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:38.64,0:06:39.56,Default,,0,0,0,,(бір нәрсені құлатқан дыбыс)
Dialogue: 0,0:06:39.64,0:06:42.27,Default,,0,0,0,,(Джектің ауыр тыныс алуы)
Dialogue: 0,0:06:42.36,0:06:43.52,Default,,0,0,0,,Легоши…
Dialogue: 0,0:06:44.32,0:06:45.73,Default,,0,0,0,,Эй...
Dialogue: 0,0:06:45.82,0:06:48.44,Default,,0,0,0,,О, Джек, рахмет.
Dialogue: 0,0:06:48.53,0:06:51.99,Default,,0,0,0,,Бұл... Жоқ, өлме, Легоси.
Dialogue: 0,0:06:52.07,0:06:53.03,Default,,0,0,0,,Сіз мені түсінесіз бе?
Dialogue: 0,0:06:53.12,0:06:56.70,Default,,0,0,0,,А, түсіндім, түсіндім, мені шеше аласың ба?
Dialogue: 0,0:06:56.79,0:06:58.58,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:06:58.66,0:07:01.25,Default,,0,0,0,,Хмм... Қызық, бұл кім?
Dialogue: 0,0:07:05.09,0:07:06.46,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:07.05,0:07:09.97,Default,,0,0,0,,Мен мектепке біраз уақыт келе алмаймын.
Dialogue: 0,0:07:10.05,0:07:10.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:10.97,0:07:13.68,Default,,0,0,0,,Ата-анамның үйіндегі атам құлап қалды, мен оған қарауға бардым.
Dialogue: 0,0:07:13.76,0:07:14.93,Default,,0,0,0,,Мұғалімге айтыңыз
Dialogue: 0,0:07:15.01,0:07:17.43,Default,,0,0,0,,Иә? неге?
Dialogue: 0,0:07:17.52,0:07:19.23,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:07:19.31,0:07:21.77,Default,,0,0,0,,Математика оқулығы мен Кородан алдым
Dialogue: 0,0:07:21.85,0:07:25.48,Default,,0,0,0,,Мен оны сыныптағы партаның үстіне қалдырдым, қайтарып бере аласыз ба?
Dialogue: 0,0:07:27.15,0:07:29.36,Default,,0,0,0,,Осы екі хабарламаны қабылдаңыз.
Dialogue: 0,0:07:29.44,0:07:32.36,Default,,0,0,0,,Мен сені көргенде әйтеуір бір жақсырақ болдым.
Dialogue: 0,0:07:33.07,0:07:35.95,Default,,0,0,0,,Әй, медициналық кабинетке барайық.
Dialogue: 0,0:07:36.03,0:07:38.79,Default,,0,0,0,,Дәрігерге қаралу керек.
Dialogue: 0,0:07:38.87,0:07:40.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:40.08,0:07:43.54,Default,,0,0,0,,Мектепте қалсаң, келесі жолы сені өлтіреді.
Dialogue: 0,0:07:43.62,0:07:47.17,Default,,0,0,0,,А... сонда қайда бара жатырсың?
Dialogue: 0,0:07:50.92,0:07:53.76,Default,,0,0,0,,Джекке білудің қажеті жоқ.
Dialogue: 0,0:07:53.84,0:07:57.43,Default,,0,0,0,,Мен міндетті түрде қайтамын.
Dialogue: 0,0:07:58.10,0:07:59.89,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:01.81,0:08:04.06,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:05.56,0:08:07.06,Default,,0,0,0,,Легоши бұл...
Dialogue: 0,0:08:08.23,0:08:12.78,Default,,0,0,0,,Менің кеткеніме бірнеше ай болды.
Dialogue: 0,0:08:14.20,0:08:17.58,Default,,0,0,0,,Сіз қайтып келмейсіз.
Dialogue: 0,0:08:21.04,0:08:24.04,Default,,0,0,0,,Сіз әрқашан ебедейсіз болдыңыз ...
Dialogue: 0,0:08:24.75,0:08:28.54,Default,,0,0,0,,Мен қалыпты бақытқа үміттендім.
Dialogue: 0,0:08:30.21,0:08:33.55,Default,,0,0,0,,Бұл қашан болды?
Dialogue: 0,0:08:34.59,0:08:39.22,Default,,0,0,0,,Күшті болған сайын бақытсыз боласың.
Dialogue: 0,0:08:40.68,0:08:43.64,Default,,0,0,0,,Мен енді қарай алмаймын
Dialogue: 0,0:08:43.73,0:08:45.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:46.19,0:08:52.57,Default,,0,0,0,,Осы кезде Джек өзін сондай жарқын әрі алыс сезінді.
Dialogue: 0,0:08:53.86,0:08:57.03,Default,,0,0,0,,Мынау алтын шашы бар жігіт достарын ойлап жылайды.
Dialogue: 0,0:08:57.03,0:08:58.24,Default,,0,0,0,,Мынау алтын шашы бар жігіт достарын ойлап жылайды.
Dialogue: 0,0:08:57.03,0:08:58.24,Default,,0,0,0,,♪～
Dialogue: 0,0:08:58.24,0:08:58.82,Default,,0,0,0,,♪～
Dialogue: 0,0:08:58.82,0:09:01.54,Default,,0,0,0,,♪～
Dialogue: 0,0:08:58.82,0:09:01.54,Default,,0,0,0,,Мен үнсіз қара қызыл массамын.
Dialogue: 0,0:09:01.54,0:09:02.08,Default,,0,0,0,,♪～
Dialogue: 0,0:09:02.08,0:09:03.04,Default,,0,0,0,,♪～
Dialogue: 0,0:09:02.08,0:09:03.04,Default,,0,0,0,,Олар енді жаратылысқа ұқсамайды.
Dialogue: 0,0:09:03.04,0:09:04.41,Default,,0,0,0,,Олар енді жаратылысқа да ұқсамайды.
Dialogue: 0,0:09:05.67,0:09:07.33,Default,,0,0,0,,Менің күшім
Dialogue: 0,0:09:08.46,0:09:11.17,Default,,0,0,0,,Бұл сізді бақытты ету үшін емес.
Dialogue: 0,0:09:11.96,0:09:13.38,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:09:20.26,0:09:22.14,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:09:22.22,0:09:23.52,Default,,0,0,0,,Легоши…
Dialogue: 0,0:09:25.27,0:09:30.19,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:09:33.53,0:09:36.57,Default,,0,0,0,,Ол мен сенім арта алатын жалғыз ересек адам.
Dialogue: 0,0:09:37.15,0:09:39.82,Default,,0,0,0,,Маған дәл қазір кеңес керек.
Dialogue: 0,0:09:40.45,0:09:43.87,Default,,0,0,0,,Тілекпен жабылған осы «артқы нарықты» сақтаушыға
Dialogue: 0,0:09:43.95,0:09:45.62,Default,,0,0,0,,Бір сөз жеткілікті
Dialogue: 0,0:09:48.87,0:09:50.67,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:51.34,0:09:53.84,Default,,0,0,0,,Ал... сіз бамбук сатасыз ба?
Dialogue: 0,0:09:53.92,0:09:55.59,Default,,0,0,0,,Қанша бума?
Dialogue: 0,0:09:55.67,0:09:57.97,Default,,0,0,0,,А... жоқ... у...
Dialogue: 0,0:09:58.05,0:09:59.93,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,0:10:00.72,0:10:04.10,Default,,0,0,0,,Тұтынушы? Не болды?
Dialogue: 0,0:10:04.64,0:10:06.23,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:04.64,0:10:06.23,Default,,0,0,0,,～♪
Dialogue: 0,0:10:06.23,0:10:06.31,Default,,0,0,0,,～♪
Dialogue: 0,0:10:06.31,0:10:08.94,Default,,0,0,0,,～♪
Dialogue: 0,0:10:06.31,0:10:08.94,Default,,0,0,0,,Кеңес алғыңыз келетіні анық.
Dialogue: 0,0:10:08.94,0:10:09.02,Default,,0,0,0,,～♪
Dialogue: 0,0:10:09.02,0:10:10.65,Default,,0,0,0,,～♪
Dialogue: 0,0:10:09.02,0:10:10.65,Default,,0,0,0,,Мен жай ғана демалатын жер іздеп жүрмін.
Dialogue: 0,0:10:10.65,0:10:13.15,Default,,0,0,0,,Мен жай ғана демалатын жер іздеп жүрмін.
Dialogue: 0,0:10:13.23,0:10:16.15,Default,,0,0,0,,Апай, алдымен осыған тапсырыс беріңіз.
Dialogue: 0,0:10:16.24,0:10:17.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:19.11,0:10:22.45,Default,,0,0,0,,50 кг үлкен бамбук және 5 байлам Нарихира бамбук
Dialogue: 0,0:10:22.53,0:10:27.12,Default,,0,0,0,,Сондай-ақ, мен өткен күні 30 кг кептірілген Окаме бамбукына тапсырыс бердім.
Dialogue: 0,0:10:27.20,0:10:31.21,Default,,0,0,0,,Иә, иә, сен жақсы тамақтаныпсың, Гухин-сан.
Dialogue: 0,0:10:31.29,0:10:33.04,Default,,0,0,0,,Бүгін бәрін үйге апарасың ба?
Dialogue: 0,0:10:33.71,0:10:35.13,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:10:35.92,0:10:39.01,Default,,0,0,0,,Хехе, бұл сенсің ғой.
Dialogue: 0,0:10:39.09,0:10:41.72,Default,,0,0,0,,Жарақаттан басқа, сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:10:43.64,0:10:47.98,Default,,0,0,0,,Қалағаным ақыл-кеңес те, жүрегіме орын да емес.
Dialogue: 0,0:10:49.31,0:10:50.19,Default,,0,0,0,,Гохин мырза
Dialogue: 0,0:10:51.15,0:10:52.81,Default,,0,0,0,,Мені өзіңе шәкірт ет
Dialogue: 0,0:10:54.27,0:10:55.23,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:10:56.36,0:10:57.78,Default,,0,0,0,,Мен тағы келемін
Dialogue: 0,0:11:13.63,0:11:14.67,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:14.75,0:11:19.05,Default,,0,0,0,,Шөпқоректі оқушыны жеп қойды. Бұл жыртқыш аңдар жасырынған мектеп пе?
Dialogue: 0,0:11:19.13,0:11:22.26,Default,,0,0,0,,Бұл сіз де болған драма үйірмесінде.
Dialogue: 0,0:11:22.34,0:11:25.10,Default,,0,0,0,,Бұл оқиға болды...
Dialogue: 0,0:11:25.18,0:11:28.39,Default,,0,0,0,,Сізде бақытсыздықты тудыратын конституция бар.
Dialogue: 0,0:11:28.47,0:11:32.14,Default,,0,0,0,,Бүгін маған шабуыл жасаған адам міндетті түрде кінәлі.
Dialogue: 0,0:11:32.81,0:11:34.61,Default,,0,0,0,,Оның үстіне ол ақылсыз күшті болды.
Dialogue: 0,0:11:35.27,0:11:38.03,Default,,0,0,0,,Оны осылай жалғыз қалдыру өте қауіпті.
Dialogue: 0,0:11:41.11,0:11:41.95,Default,,0,0,0,,...және?
Dialogue: 0,0:11:42.03,0:11:44.12,Default,,0,0,0,,Е... жоқ, бұл...
Dialogue: 0,0:11:44.20,0:11:45.62,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:45.70,0:11:47.62,Default,,0,0,0,,Мен күштірек болғым келеді
Dialogue: 0,0:11:47.70,0:11:49.29,Default,,0,0,0,,Маған күресуді үйретші...
Dialogue: 0,0:11:49.37,0:11:50.29,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:11:50.37,0:11:51.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:51.50,0:11:53.75,Default,,0,0,0,,Мен ұмытып кеткен шығармын
Dialogue: 0,0:11:53.83,0:11:57.00,Default,,0,0,0,,Менің негізгі жұмысым - бэк-рыноктағы психосоматикалық дәрігер.
Dialogue: 0,0:11:57.59,0:12:00.92,Default,,0,0,0,,Күлкілі бомба алып жүрсеңіз, жұмыс істеу қиын болар еді.
Dialogue: 0,0:12:02.43,0:12:03.72,Default,,0,0,0,,Бомба?
Dialogue: 0,0:12:03.80,0:12:07.22,Default,,0,0,0,,Жоқ, мен кенеттен бұлай айқайламаймын.
Dialogue: 0,0:12:07.30,0:12:10.35,Default,,0,0,0,,Сіз бастығын жеңген Шиши тобы
Dialogue: 0,0:12:10.43,0:12:13.06,Default,,0,0,0,,Енді олар астыртын нарықта өз билігін нығайтып жатыр.
Dialogue: 0,0:12:13.14,0:12:14.23,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:12:14.31,0:12:16.81,Default,,0,0,0,,Мұндай жағдайда сіздің жаттығуларыңыз үшін,
Dialogue: 0,0:12:16.90,0:12:19.44,Default,,0,0,0,,Осы жерден келе жатқанда ұсталған күні.
Dialogue: 0,0:12:19.53,0:12:21.90,Default,,0,0,0,,Бір соққы оны орындамайды.
Dialogue: 0,0:12:22.74,0:12:24.61,Default,,0,0,0,,Олар сізді қалай пісірсе де
Dialogue: 0,0:12:24.70,0:12:26.16,Default,,0,0,0,,Мен мұны білмеймін, бірақ
Dialogue: 0,0:12:26.78,0:12:30.29,Default,,0,0,0,,Мен сенің одан әрі тереңдеп, менің жағдайымды нашарлатуыңды қаламаймын.
Dialogue: 0,0:12:30.37,0:12:31.75,Default,,0,0,0,,Бамбук шайын ішіп, үйге қайт.
Dialogue: 0,0:12:31.83,0:12:35.12,Default,,0,0,0,,Аа, мен кішкентай кезімнен әлсіз болдым, сондықтан бәрі жақсы.
Dialogue: 0,0:12:35.21,0:12:37.50,Default,,0,0,0,,Ол бар күшін салып сытылып шығады.
Dialogue: 0,0:12:37.59,0:12:40.38,Default,,0,0,0,,Бұл әнді қалай жасыра аласыз?
Dialogue: 0,0:12:40.46,0:12:43.55,Default,,0,0,0,,Мм... онда мен мұнда жұмысшы болып жұмыс істеймін.
Dialogue: 0,0:12:43.63,0:12:44.84,Default,,0,0,0,,(Цубаки) Шынын айтсам, мен оның бармағанын қалаймын.
Dialogue: 0,0:12:45.38,0:12:46.55,Default,,0,0,0,,Мен біраз үзіліс жасаймын...
Dialogue: 0,0:12:46.64,0:12:48.76,Default,,0,0,0,,Төтенше!
Dialogue: 0,0:12:48.85,0:12:50.56,Default,,0,0,0,,Жұмыс қиын кезде
Dialogue: 0,0:12:50.64,0:12:53.27,Default,,0,0,0,,Оқуды бітіру үшін кредиттерім жеткіліксіз болса не істеуім керек?
Dialogue: 0,0:12:54.27,0:12:57.86,Default,,0,0,0,,Сонымен, сіз ештеңені өзгерте алмайсыз ба?
Dialogue: 0,0:12:58.56,0:13:02.44,Default,,0,0,0,,Мен енді қараушы болғым келмейді.
Dialogue: 0,0:13:02.53,0:13:03.44,Default,,0,0,0,,(Гухиннің тілін шертеді)
Dialogue: 0,0:13:03.53,0:13:04.78,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:13:05.40,0:13:08.53,Default,,0,0,0,,Сіз өте сөйлейтін болып кеттіңіз.
Dialogue: 0,0:13:08.62,0:13:12.04,Default,,0,0,0,,Әй, бірақ мен бұл жасыл иісті жек көрмеймін.
Dialogue: 0,0:13:12.12,0:13:13.12,Default,,0,0,0,,Ал, тынышталып, отырыңыз.
Dialogue: 0,0:13:13.20,0:13:14.75,Default,,0,0,0,,Маған тамаша ой келді.
Dialogue: 0,0:13:15.33,0:13:17.12,Default,,0,0,0,,Не? Қандай тамаша идея
Dialogue: 0,0:13:17.79,0:13:18.71,Default,,0,0,0,,А...
Dialogue: 0,0:13:19.88,0:13:22.42,Default,,0,0,0,,А... не... не істеуді жоспарлап отырсың?
Dialogue: 0,0:13:22.51,0:13:25.72,Default,,0,0,0,,Егер сіз шындап менің қол астында жаттығыңыз келсе, табандылығыңызды көрсетіңіз.
Dialogue: 0,0:13:25.72,0:13:26.43,Default,,0,0,0,,Егер сіз менің қол астында жаттығуға шындап ниет білдірсеңіз, жігеріңізді көрсетіңіз.
Dialogue: 0,0:13:25.72,0:13:26.43,Default,,0,0,0,,А... а
Dialogue: 0,0:13:26.43,0:13:26.51,Default,,0,0,0,,А... а
Dialogue: 0,0:13:26.51,0:13:27.05,Default,,0,0,0,,А... а
Dialogue: 0,0:13:26.51,0:13:27.05,Default,,0,0,0,,Бұл жер асты әлемінің ережелері.
Dialogue: 0,0:13:27.05,0:13:28.18,Default,,0,0,0,,Бұл жер асты әлемінің ережелері.
Dialogue: 0,0:13:28.18,0:13:29.09,Default,,0,0,0,,Бұл жер асты әлемінің ережелері.
Dialogue: 0,0:13:28.18,0:13:29.09,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:29.18,0:13:31.22,Default,,0,0,0,,Нашар қозғалмаңыз
Dialogue: 0,0:13:31.31,0:13:34.18,Default,,0,0,0,,Мұны ант қабылдау рәсімі деп түсініңіз.
Dialogue: 0,0:13:34.27,0:13:37.73,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:38.60,0:13:40.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:41.02,0:13:42.98,Default,,0,0,0,,Бүгін болды ма?
Dialogue: 0,0:13:43.69,0:13:45.69,Default,,0,0,0,,Менің соңғы сәттерім
Dialogue: 0,0:13:45.78,0:13:50.53,Default,,0,0,0,,(Сахналық музыка)
Dialogue: 0,0:13:50.62,0:13:52.87,Default,,0,0,0,,(Қонақтар айқайлайды)
Dialogue: 0,0:13:59.88,0:14:00.92,Default,,0,0,0,,Мұнда-
Dialogue: 0,0:14:01.59,0:14:03.80,Default,,0,0,0,,Биші киімін шешкен сайын
Dialogue: 0,0:14:03.88,0:14:07.63,Default,,0,0,0,,Жыртқыш қонақтардың арылдаған дауыстары жаңғырық.
Dialogue: 0,0:14:13.68,0:14:15.56,Default,,0,0,0,,О Космо
Dialogue: 0,0:14:15.64,0:14:17.73,Default,,0,0,0,,(аудиторияның қол шапалақтауы)
Dialogue: 0,0:14:17.81,0:14:18.77,Default,,0,0,0,,Не?
Dialogue: 0,0:14:18.85,0:14:20.60,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:14:20.69,0:14:23.32,Default,,0,0,0,,Бүгін де сені бәрі іздейді.
Dialogue: 0,0:14:24.07,0:14:27.28,Default,,0,0,0,,Тәбет пен жыныстық құмарлықты бір уақытта ынталандыруға болады.
Dialogue: 0,0:14:27.36,0:14:29.61,Default,,0,0,0,,Мен жай ғана ыңғайлы шоу іздеп жүрмін.
Dialogue: 0,0:14:29.70,0:14:32.45,Default,,0,0,0,,Хехе, жағдайың жақсы ғой, солай ма?
Dialogue: 0,0:14:32.53,0:14:33.66,Default,,0,0,0,,Тіпті күш жұмсамай-ақ
Dialogue: 0,0:14:33.74,0:14:36.83,Default,,0,0,0,,Сіз шөпқоректі болғандықтан ғана сізге көп көңіл бөлінеді.
Dialogue: 0,0:14:36.91,0:14:40.04,Default,,0,0,0,,Етқоректі бидің орнын ауыстыратындар көп.
Dialogue: 0,0:14:40.12,0:14:41.58,Default,,0,0,0,,Осылай жүре берсең, жұмыстан қуылады.
Dialogue: 0,0:14:42.75,0:14:44.25,Default,,0,0,0,,Hmph… Иесі
Dialogue: 0,0:14:44.34,0:14:45.71,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:14:45.80,0:14:47.80,Default,,0,0,0,,А... жоқ, бұл...
Dialogue: 0,0:14:47.88,0:14:51.97,Default,,0,0,0,,Көрермендер торды алып тастауды сұрай берді.
Dialogue: 0,0:14:52.05,0:14:53.64,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:14:53.72,0:14:56.56,Default,,0,0,0,,Иә... жақсы, тоқтайық.
Dialogue: 0,0:14:56.64,0:14:58.48,Default,,0,0,0,,Сонымен қатар, қисынсыз тұтынушыға
Dialogue: 0,0:14:58.56,0:15:01.85,Default,,0,0,0,,Бидің жегенін көргім келмейді.
Dialogue: 0,0:15:02.81,0:15:04.57,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:15:04.65,0:15:08.53,Default,,0,0,0,,Үлкен құс - Космо-чан, артқы базардағы жалғыз шөпқоректі биші.
Dialogue: 0,0:15:09.36,0:15:12.70,Default,,0,0,0,,Барлығыңыз, тырнақтарыңыз бен тістеріңізді жасырып, ләззат алыңыз.
Dialogue: 0,0:15:15.49,0:15:19.29,Default,,0,0,0,,Артқы нарықтағы шөпқоректілер өлімнің алдыңғы қатарында.
Dialogue: 0,0:15:20.83,0:15:23.33,Default,,0,0,0,,Сонда да бұл қалада адамдар бар
Dialogue: 0,0:15:23.42,0:15:26.50,Default,,0,0,0,,Өйткені мен өзім бола аламын
Dialogue: 0,0:15:28.01,0:15:31.80,Default,,0,0,0,,Етқоректілердің барлық ақшасын қазір сығып ал
Dialogue: 0,0:15:31.88,0:15:35.05,Default,,0,0,0,,Өлсем, жегенше жеп, өлемін.
Dialogue: 0,0:15:35.76,0:15:40.85,Default,,0,0,0,,Жүріңдер, аңдар, біз күте алмаймыз.
Dialogue: 0,0:15:41.52,0:15:46.32,Default,,0,0,0,,Матадан өтпейтін аналық шөпқоректілер. Табиғи иісі
Dialogue: 0,0:15:47.23,0:15:48.32,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:15:47.23,0:15:48.32,Default,,0,0,0,,Тамаққа кесілген еттен гөрі.
Dialogue: 0,0:15:48.32,0:15:50.19,Default,,0,0,0,,Жеуге туралған еттен артық
Dialogue: 0,0:15:50.28,0:15:54.37,Default,,0,0,0,,Интенсивті балғын және тәтті
Dialogue: 0,0:15:55.62,0:15:59.16,Default,,0,0,0,,Тәбет Жыныстық құмарлықтың хаосы
Dialogue: 0,0:15:59.24,0:16:01.21,Default,,0,0,0,,(қатты тыныс алу және жұтыну дыбысы)
Dialogue: 0,0:15:59.24,0:16:01.21,Default,,0,0,0,,Мен оны араластырамын.
Dialogue: 0,0:16:01.21,0:16:02.12,Default,,0,0,0,,Мен оны араластырамын.
Dialogue: 0,0:16:09.59,0:16:12.30,Default,,0,0,0,,Сіз тордағыларсыз
Dialogue: 0,0:16:12.30,0:16:13.51,Default,,0,0,0,,Сіз тордағыларсыз
Dialogue: 0,0:16:12.30,0:16:13.51,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:16:13.51,0:16:13.59,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:16:13.59,0:16:16.47,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:16:13.59,0:16:16.47,Default,,0,0,0,,Мен мұнда билеушімін.
Dialogue: 0,0:16:18.64,0:16:20.68,Default,,0,0,0,,А...
Dialogue: 0,0:16:24.23,0:16:25.60,Default,,0,0,0,,(Қонақтар еңіреп)
Dialogue: 0,0:16:26.40,0:16:28.15,Default,,0,0,0,,А... а... а?
Dialogue: 0,0:16:28.23,0:16:30.78,Default,,0,0,0,,(Жолбарыстың үруі)
Dialogue: 0,0:16:31.49,0:16:35.28,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:35.36,0:16:37.78,Default,,0,0,0,,Бұл кім? Менде болған қадам
Dialogue: 0,0:16:37.87,0:16:40.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:40.24,0:16:42.04,Default,,0,0,0,,Бүгін болды ма?
Dialogue: 0,0:16:42.12,0:16:43.71,Default,,0,0,0,,Менің соңғы сәтім болды
Dialogue: 0,0:16:44.29,0:16:45.58,Default,,0,0,0,,(Жолбарыстың үруі)
Dialogue: 0,0:16:45.67,0:16:46.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:46.92,0:16:47.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:47.84,0:16:48.79,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:48.88,0:16:50.92,Default,,0,0,0,,Уф... не?
Dialogue: 0,0:16:51.01,0:16:53.59,Default,,0,0,0,,Бұл өте қызықты бола бастады, солай емес пе?
Dialogue: 0,0:16:54.30,0:16:57.47,Default,,0,0,0,,Бірақ сахна – киелі жер.
Dialogue: 0,0:16:57.55,0:16:58.51,Default,,0,0,0,,Е...
Dialogue: 0,0:16:58.60,0:17:00.89,Default,,0,0,0,,Сахнаға кедергі келтіретін дөрекі адамдарға
Dialogue: 0,0:17:00.89,0:17:01.39,Default,,0,0,0,,Сахнаны бұзатын дөрекі адамдарға
Dialogue: 0,0:17:00.89,0:17:01.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:01.39,0:17:01.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:01.47,0:17:02.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:01.47,0:17:02.31,Default,,0,0,0,,Сахнаға шығуға жарамды емес
Dialogue: 0,0:17:02.31,0:17:03.85,Default,,0,0,0,,Сахнаға шығуға жарамды емес
Dialogue: 0,0:17:04.81,0:17:09.02,Default,,0,0,0,,Әдепті білмейтін қонақтарды жазалаймыз.
Dialogue: 0,0:17:09.11,0:17:11.94,Default,,0,0,0,,Уф... аааааа...
Dialogue: 0,0:17:11.94,0:17:12.61,Default,,0,0,0,,Уф... аааааа...
Dialogue: 0,0:17:11.94,0:17:12.61,Default,,0,0,0,,Рас, бұл Шиши-гуми.
Dialogue: 0,0:17:12.61,0:17:12.69,Default,,0,0,0,,Рас, бұл Шиши-гуми.
Dialogue: 0,0:17:12.69,0:17:13.94,Default,,0,0,0,,Рас, бұл Шиши-гуми.
Dialogue: 0,0:17:12.69,0:17:13.94,Default,,0,0,0,,Ей, тыныш бол, а...
Dialogue: 0,0:17:13.94,0:17:14.82,Default,,0,0,0,,Ей, тыныш бол, а...
Dialogue: 0,0:17:14.90,0:17:15.49,Default,,0,0,0,,Ах... (Шиши В тобы) Ой!
Dialogue: 0,0:17:15.49,0:17:15.99,Default,,0,0,0,,Ахх... (Шиши В тобы) Ой!
Dialogue: 0,0:17:15.49,0:17:15.99,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:15.99,0:17:16.07,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:16.07,0:17:18.16,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:16.07,0:17:18.16,Default,,0,0,0,,Амансың ба? Ах...
Dialogue: 0,0:17:20.08,0:17:23.20,Default,,0,0,0,,Неліктен бұл жерде шөпқоректілер кездеседі?
Dialogue: 0,0:17:24.54,0:17:27.46,Default,,0,0,0,,Менің ең жек көретінім
Dialogue: 0,0:17:27.54,0:17:30.92,Default,,0,0,0,,Мен мені жегім келетін жыртқыш емеспін
Dialogue: 0,0:17:31.00,0:17:33.88,Default,,0,0,0,,Мені шын аяйтын ет жейтін тұтынушымен.
Dialogue: 0,0:17:33.96,0:17:36.68,Default,,0,0,0,,Бізді көруге келген шөпқоректі қонақтар.
Dialogue: 0,0:17:37.22,0:17:39.55,Default,,0,0,0,,Ойсыз қалсаң, сені де жейді.
Dialogue: 0,0:17:39.64,0:17:41.72,Default,,0,0,0,,Бала үйіне барып ұйықтауы керек.
Dialogue: 0,0:17:41.81,0:17:42.64,Default,,0,0,0,,Босс
Dialogue: 0,0:17:42.72,0:17:43.77,Default,,0,0,0,,Не?
Dialogue: 0,0:17:43.85,0:17:45.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.52,0:17:50.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:50.31,0:17:53.44,Default,,0,0,0,,Шиши-гумиден бәрі келмесе...
Dialogue: 0,0:17:53.53,0:17:55.94,Default,,0,0,0,,Әлсізге көмектесіп, күштінің көңілін қалдыр
Dialogue: 0,0:17:56.03,0:17:58.03,Default,,0,0,0,,Бұл қазіргі Шиши-гуми.
Dialogue: 0,0:17:58.78,0:18:01.45,Default,,0,0,0,,Сен реніштен істедің бе?
Dialogue: 0,0:18:01.53,0:18:05.70,Default,,0,0,0,,Сен сияқты жыртқыштар қайда барсаң да бар.
Dialogue: 0,0:18:06.50,0:18:10.21,Default,,0,0,0,,Сіз Шиши-гумидің бастығысыз ба?
Dialogue: 0,0:18:10.83,0:18:13.34,Default,,0,0,0,,Мен саған үйге қайт дедім, әпке.
Dialogue: 0,0:18:13.42,0:18:14.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:15.09,0:18:18.09,Default,,0,0,0,,Артқы базар – менің үйім
Dialogue: 0,0:18:18.72,0:18:22.26,Default,,0,0,0,,Шөпқоректілерге қамқорлық жасаңыз.
Dialogue: 0,0:18:23.22,0:18:24.39,Default,,0,0,0,,(Шишигумидің сөйлейтін дауысы)
Dialogue: 0,0:18:24.47,0:18:25.60,Default,,0,0,0,,Пухат
Dialogue: 0,0:18:25.68,0:18:28.73,Default,,0,0,0,,Уау, саке дәмді екен.
Dialogue: 0,0:18:28.81,0:18:32.69,Default,,0,0,0,,Маған қайтадан оққағар болып жұмыс істеуді сұрады.
Dialogue: 0,0:18:32.77,0:18:36.78,Default,,0,0,0,,Бұл иесінің денесі кішкентай, бірақ кең жүзді.
Dialogue: 0,0:18:36.86,0:18:40.66,Default,,0,0,0,,Бастық болса, Шиши-гумидің күші тез кеңейеді.
Dialogue: 0,0:18:40.74,0:18:44.41,Default,,0,0,0,,Біздің реформа ең дұрыс іс болды.
Dialogue: 0,0:18:44.49,0:18:47.83,Default,,0,0,0,,Мен болмасам, бұл топ баяғыда жаншып кетер еді.
Dialogue: 0,0:18:47.91,0:18:49.33,Default,,0,0,0,,Хахаха
Dialogue: 0,0:18:49.41,0:18:52.38,Default,,0,0,0,,Сіз дөрекі сөздер айтасыз.
Dialogue: 0,0:18:52.46,0:18:56.71,Default,,0,0,0,,Жоқ, бірақ мен мұндай дәмді тағамды жегеніме біраз болды.
Dialogue: 0,0:18:56.80,0:18:58.80,Default,,0,0,0,,Сәлем, бастық
Dialogue: 0,0:18:59.34,0:19:02.05,Default,,0,0,0,,Мен ет жеуге оң көзқарас танытпаймын.
Dialogue: 0,0:19:02.14,0:19:06.27,Default,,0,0,0,,Енді осы жерге аяқ басқан соң, қалаға кірсең, қаланың соңынан еріп кетесің.
Dialogue: 0,0:19:06.35,0:19:07.64,Default,,0,0,0,,Осымен
Dialogue: 0,0:19:18.44,0:19:20.49,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:19:20.57,0:19:23.28,Default,,0,0,0,,Иә? Қазір жақсысың ба, бастық?
Dialogue: 0,0:19:23.37,0:19:26.29,Default,,0,0,0,,Оны асқазанның көлемімен салыстырмаңыз.
Dialogue: 0,0:19:26.37,0:19:27.24,Default,,0,0,0,,Қалағаныңды же.
Dialogue: 0,0:19:28.87,0:19:30.37,Default,,0,0,0,,Маған сенуге болады, бастық.
Dialogue: 0,0:19:30.46,0:19:32.21,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:19:33.58,0:19:36.30,Default,,0,0,0,,(құсу дыбысы)
Dialogue: 0,0:19:38.13,0:19:39.13,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:39.72,0:19:41.76,Default,,0,0,0,,Мұның бәрі...
Dialogue: 0,0:19:41.84,0:19:45.35,Default,,0,0,0,,Менің денем оны мүлдем көтере алмайтыны таң қалдырады.
Dialogue: 0,0:19:46.05,0:19:50.31,Default,,0,0,0,,Әзірше мен оны энергетикалық сусындармен толтырып жатырмын...
Dialogue: 0,0:19:51.31,0:19:52.35,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:53.73,0:19:54.90,Default,,0,0,0,,Босс
Dialogue: 0,0:19:55.48,0:19:58.94,Default,,0,0,0,,Бұл не, Ибуки, қағып сосын аш?
Dialogue: 0,0:19:59.03,0:19:59.90,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:20:01.20,0:20:02.74,Default,,0,0,0,,Бозғылт көрінеді
Dialogue: 0,0:20:02.82,0:20:04.53,Default,,0,0,0,,Мен мұнымен жақсымын.
Dialogue: 0,0:20:05.03,0:20:06.33,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:20:07.41,0:20:10.45,Default,,0,0,0,,Барған сайын арықтайсың.
Dialogue: 0,0:20:11.25,0:20:15.33,Default,,0,0,0,,Нашар Менің әлсіреп бара жатқанымды байқадың ба?
Dialogue: 0,0:20:15.96,0:20:19.25,Default,,0,0,0,,Мен сені жоғарылатуды ұсынғанмын.
Dialogue: 0,0:20:19.34,0:20:21.63,Default,,0,0,0,,Мен жауапкершілікті сезінемін
Dialogue: 0,0:20:21.72,0:20:23.76,Default,,0,0,0,,Не... нені айтасыз?
Dialogue: 0,0:20:24.68,0:20:28.89,Default,,0,0,0,,Көкөністерді бірінші рет сатып алдым, сондықтан мен біраз қобалжыдым.
Dialogue: 0,0:20:28.97,0:20:30.89,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:20:30.97,0:20:33.94,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:20:35.15,0:20:37.15,Default,,0,0,0,,Одан әрі өзіңізді кесіп алмаңыз.
Dialogue: 0,0:20:37.81,0:20:41.57,Default,,0,0,0,,Сіз енді тек Шиши-гумидің бастығы емессіз.
Dialogue: 0,0:20:43.11,0:20:45.41,Default,,0,0,0,,Оңай өлсем қиын болар еді
Dialogue: 0,0:20:45.91,0:20:46.74,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:20:47.66,0:20:50.62,Default,,0,0,0,,Жас бастық біздің кесірімізден әлсіреп барады.
Dialogue: 0,0:20:50.70,0:20:53.08,Default,,0,0,0,,Шынымды айтсам, қарауға шыдамаймын.
Dialogue: 0,0:20:53.75,0:20:55.67,Default,,0,0,0,,Дене – капитал
Dialogue: 0,0:20:55.75,0:20:57.79,Default,,0,0,0,,Аздап тамақтаныңыз
Dialogue: 0,0:20:58.84,0:21:01.67,Default,,0,0,0,,Менің көкөністерге байғұс жабысқанымды қараңыз
Dialogue: 0,0:21:02.51,0:21:04.42,Default,,0,0,0,,Жүрегіңізде күлімсіреу ниетіңіз бар ма?
Dialogue: 0,0:21:04.51,0:21:06.01,Default,,0,0,0,,ше? Атап айтқанда, ақыр соңында
Dialogue: 0,0:21:06.09,0:21:08.18,Default,,0,0,0,,Жоқ, сен...
Dialogue: 0,0:21:11.06,0:21:14.56,Default,,0,0,0,,Бастық Қонаққа жас қасқыр келді.
Dialogue: 0,0:21:15.44,0:21:17.06,Default,,0,0,0,,Маған бастықпен кездесуге рұқсат етіңіз
Dialogue: 0,0:21:17.81,0:21:19.31,Default,,0,0,0,,Қасқыр…
Dialogue: 0,0:21:22.44,0:21:23.78,Default,,0,0,0,,Са...
Dialogue: 0,0:21:23.86,0:21:26.41,Default,,0,0,0,,Маған тисең, мен сені тістеймін.
Dialogue: 0,0:21:27.11,0:21:29.41,Default,,0,0,0,,Бәрібір кездесуге рұқсат етіңіз.
Dialogue: 0,0:21:32.04,0:21:38.04,Default,,0,0,0,,♪～
Dialogue: 0,0:22:52.32,0:22:58.33,Default,,0,0,0,,～♪
