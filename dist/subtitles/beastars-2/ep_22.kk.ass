Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:08.09,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.91,0:01:29.17,Default,,0,0,0,,～♪
Dialogue: 0,0:01:36.84,0:01:39.43,Default,,0,0,0,,Жаз қызанақ үшін ең жақсы маусым болып саналады, бірақ
Dialogue: 0,0:01:40.09,0:01:43.60,Default,,0,0,0,,Негізі күзден қыстың басына дейін ең дәмді.
Dialogue: 0,0:01:48.10,0:01:48.98,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:49.06,0:01:50.69,Default,,0,0,0,,Иә? (Аю В) Не?
Dialogue: 0,0:01:50.77,0:01:52.65,Default,,0,0,0,,Бұл біраз уақыт алуы мүмкін
Dialogue: 0,0:01:52.73,0:01:53.98,Default,,0,0,0,,А... мен күтемін.
Dialogue: 0,0:01:54.07,0:01:55.36,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:01:55.44,0:01:57.11,Default,,0,0,0,,Эххе
Dialogue: 0,0:01:57.20,0:01:59.03,Default,,0,0,0,,Маған тамақ пісірген ұнайды
Dialogue: 0,0:01:59.99,0:02:01.70,Default,,0,0,0,,Осылайша, кейде менің бөлмедегі достарым
Dialogue: 0,0:02:01.78,0:02:03.74,Default,,0,0,0,,Тамақты ұсыну
Dialogue: 0,0:02:03.83,0:02:07.66,Default,,0,0,0,,Мен тамақ жасағанда өзімді тыныш сезінемін.
Dialogue: 0,0:02:14.05,0:02:15.63,Default,,0,0,0,,Иә, ләззат алыңыз.
Dialogue: 0,0:02:15.71,0:02:19.05,Default,,0,0,0,,Ооо, итадагымасу
Dialogue: 0,0:02:20.47,0:02:23.93,Default,,0,0,0,,Лиздің тамағы дәмді ғой, хаха
Dialogue: 0,0:02:24.01,0:02:28.18,Default,,0,0,0,,Бірақ ол әрқашан дәмді, иә?
Dialogue: 0,0:02:28.27,0:02:30.44,Default,,0,0,0,,А... Мен тағы да жасадым.
Dialogue: 0,0:02:31.15,0:02:32.65,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:02:33.73,0:02:35.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:35.69,0:02:39.61,Default,,0,0,0,,Сол түннен бері дәм сезуден айырылдым.
Dialogue: 0,0:02:40.66,0:02:44.33,Default,,0,0,0,,Мен келісіммен альпака темесін жедім.
Dialogue: 0,0:02:45.16,0:02:48.75,Default,,0,0,0,,Шөпқоректі жануармен шынайы достық орнатқан жалғыз аю.
Dialogue: 0,0:02:54.29,0:02:58.59,Default,,0,0,0,,Ингредиенттер маған берілгендей...
Dialogue: 0,0:02:58.67,0:03:01.43,Default,,0,0,0,,Бейбітшілікте бірге балқыған
Dialogue: 0,0:03:02.39,0:03:04.35,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:03:04.43,0:03:07.47,Default,,0,0,0,,Әдемі болып, естеліктерім
Dialogue: 0,0:03:08.14,0:03:10.18,Default,,0,0,0,,Темнің дәмін ұмытпа
Dialogue: 0,0:03:10.27,0:03:12.85,Default,,0,0,0,,Біз ең жақсы достармыз
Dialogue: 0,0:03:12.94,0:03:15.23,Default,,0,0,0,,Теммен болған түннен естелік
Dialogue: 0,0:03:15.32,0:03:17.11,Default,,0,0,0,,Өйткені әдемі қайта тірілесің
Dialogue: 0,0:03:17.19,0:03:20.82,Default,,0,0,0,,Мен сен туралы бәрін қабылдаймын, Лиз.
Dialogue: 0,0:03:29.20,0:03:31.83,Default,,0,0,0,,Ас – өмірдің қуанышы.
Dialogue: 0,0:03:32.37,0:03:35.42,Default,,0,0,0,,Тем Менің аузыма кіргенде
Dialogue: 0,0:03:35.50,0:03:36.96,Default,,0,0,0,,Сіз күлдіңіз ғой, солай ма?
Dialogue: 0,0:03:37.05,0:03:37.88,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:39.51,0:03:43.18,Default,,0,0,0,,Сол күні Темді жеген сен едің ғой?
Dialogue: 0,0:03:43.26,0:03:48.22,Default,,0,0,0,,Мен өмір сүргенше, мен «жеу мен өлтірудің» алдын аламын.
Dialogue: 0,0:03:48.31,0:03:51.18,Default,,0,0,0,,Мен де Темнің үлесін жоямын.
Dialogue: 0,0:03:51.27,0:03:52.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:53.44,0:03:56.56,Default,,0,0,0,,Әшкерелеген... ол
Dialogue: 0,0:03:56.65,0:03:58.02,Default,,0,0,0,,ластанған
Dialogue: 0,0:03:58.11,0:04:02.45,Default,,0,0,0,,Тем екеуміздің достық, жастық шағым...
Dialogue: 0,0:04:03.11,0:04:04.99,Default,,0,0,0,,Дыбысты өшіру керек
Dialogue: 0,0:04:05.07,0:04:07.91,Default,,0,0,0,,Әлгі тітіркендіргіш қой мен азғын қасқыр
Dialogue: 0,0:04:11.04,0:04:13.00,Default,,0,0,0,,Не болды, Рюзаки?
Dialogue: 0,0:04:13.75,0:04:15.79,Default,,0,0,0,,Мен Луи-сенпайды да кездестірдім.
Dialogue: 0,0:04:15.88,0:04:19.71,Default,,0,0,0,,Маған Лизмен қалай әрекет ету керектігін ойлайтын кез келді.
Dialogue: 0,0:04:19.80,0:04:24.59,Default,,0,0,0,,Кеше түнде мен Хару-чан туралы жаман түс көрдім.
Dialogue: 0,0:04:24.68,0:04:26.97,Default,,0,0,0,,Түптеп келгенде, ол тілекке толы
Dialogue: 0,0:04:27.68,0:04:29.35,Default,,0,0,0,,Бұл бірінші рет емес.
Dialogue: 0,0:04:29.43,0:04:32.10,Default,,0,0,0,,Жағдайлар мен түрлері көбейіп бара жатқандай сезінемін.
Dialogue: 0,0:04:32.18,0:04:35.10,Default,,0,0,0,,Хмм... бұл өте графикалық.
Dialogue: 0,0:04:35.19,0:04:38.02,Default,,0,0,0,,Қалау массасы!
Dialogue: 0,0:04:38.73,0:04:40.07,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:04:40.15,0:04:43.15,Default,,0,0,0,,Менің басым қайда жасалған?
Dialogue: 0,0:04:43.24,0:04:46.03,Default,,0,0,0,,Денемнің еш жерінде жоқ
Dialogue: 0,0:04:46.11,0:04:48.16,Default,,0,0,0,,Жұмсақ...
Dialogue: 0,0:04:48.24,0:04:49.28,Default,,0,0,0,,Rohan-нан басқа тағы бірнеше адамға айтқансың—
Dialogue: 0,0:04:49.37,0:04:50.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:50.37,0:04:52.16,Default,,0,0,0,,Қолдарың тентек, Легоси-кун.
Dialogue: 0,0:04:52.25,0:04:54.08,Default,,0,0,0,,Уау, бұл шын ба?
Dialogue: 0,0:04:54.79,0:04:56.33,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:04:56.42,0:04:59.13,Default,,0,0,0,,А... бұл сирек... бұл сирек 2-сынып кабинеті
Dialogue: 0,0:04:59.21,0:05:01.05,Default,,0,0,0,,Хехехе, осында.
Dialogue: 0,0:05:01.13,0:05:03.05,Default,,0,0,0,,Сабақ аяқталды, солай ма?
Dialogue: 0,0:05:03.13,0:05:04.92,Default,,0,0,0,,Мен де сенің жүзіңді көргім келді
Dialogue: 0,0:05:05.01,0:05:06.93,Default,,0,0,0,,Мен дұрыс сөйлескім келді.
Dialogue: 0,0:05:07.01,0:05:08.39,Default,,0,0,0,,Осыдан кейін боссың ба?
Dialogue: 0,0:05:08.89,0:05:10.01,Default,,0,0,0,,Иә
Dialogue: 0,0:05:10.10,0:05:11.85,Default,,0,0,0,,Эй... сәл қозғалайық.
Dialogue: 0,0:05:11.93,0:05:12.77,Default,,0,0,0,,Иә
Dialogue: 0,0:05:15.81,0:05:17.23,Default,,0,0,0,,Иә
Dialogue: 0,0:05:17.31,0:05:18.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:20.57,0:05:24.94,Default,,0,0,0,,Сен, Легоши, өзіңе ант бересің бе?
Dialogue: 0,0:05:25.03,0:05:26.49,Default,,0,0,0,,Өте мейірімді
Dialogue: 0,0:05:26.57,0:05:29.45,Default,,0,0,0,,Хару-чан, сабақта көңілді жүрсің бе?
Dialogue: 0,0:05:29.53,0:05:32.08,Default,,0,0,0,,Хмм, ерекше ештеңе жоқ па? Қалыпты
Dialogue: 0,0:05:32.16,0:05:33.87,Default,,0,0,0,,Менен кіші болсаң да
Dialogue: 0,0:05:33.95,0:05:37.29,Default,,0,0,0,,Біртүрлі, өйткені сен кейде әкеңе ұқсайсың.
Dialogue: 0,0:05:38.58,0:05:41.17,Default,,0,0,0,,Луи мүлде қарама-қарсы және бұзылған брат болды.
Dialogue: 0,0:05:42.42,0:05:46.55,Default,,0,0,0,,Тұрақсыз болса да, ол да күшті, арамза...
Dialogue: 0,0:05:46.63,0:05:49.14,Default,,0,0,0,,Ол әрқашан жалғыз болып көрінетін
Dialogue: 0,0:05:49.72,0:05:51.80,Default,,0,0,0,,Бүгін ауа-райы жақсы.
Dialogue: 0,0:05:53.01,0:05:54.18,Default,,0,0,0,,Легоси-кун, иә?
Dialogue: 0,0:05:54.85,0:05:56.35,Default,,0,0,0,,А... Маған ұнады
Dialogue: 0,0:05:56.43,0:05:57.85,Default,,0,0,0,,Не? Мен оны жақсы көремін
Dialogue: 0,0:05:57.94,0:06:00.48,Default,,0,0,0,,А-а, өтірік... Шынымен бе?
Dialogue: 0,0:06:00.56,0:06:01.52,Default,,0,0,0,,Иә
Dialogue: 0,0:06:01.61,0:06:04.28,Default,,0,0,0,,Маған бұл туралы бірінші рет дұрыс айтылғандай сезінемін.
Dialogue: 0,0:06:04.36,0:06:05.86,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:06:05.94,0:06:11.74,Default,,0,0,0,,Күшті, жұмсақ, үлкен және сенімді
Dialogue: 0,0:06:12.58,0:06:13.70,Default,,0,0,0,,Оны түсініп-ақ болмайды.
Dialogue: 0,0:06:14.29,0:06:16.91,Default,,0,0,0,,Легоши маған қаншалықты ұнаса, соғұрлым оны ұнатамын.
Dialogue: 0,0:06:17.46,0:06:18.87,Default,,0,0,0,,Мен Луи үшін алаңдаймын.
Dialogue: 0,0:06:20.46,0:06:22.04,Default,,0,0,0,,А... Ха!
Dialogue: 0,0:06:22.13,0:06:25.05,Default,,0,0,0,,А... Мен оны дәл қазір біртүрлі етіп айтқан шығармын.
Dialogue: 0,0:06:25.13,0:06:26.09,Default,,0,0,0,,О... жоқ.
Dialogue: 0,0:06:26.17,0:06:27.97,Default,,0,0,0,,Бұл менің өкінгенім емес.
Dialogue: 0,0:06:28.05,0:06:29.93,Default,,0,0,0,,Ах, Легоси-кун, мені тыңда.
Dialogue: 0,0:06:30.01,0:06:32.10,Default,,0,0,0,,А... мен және Луис бітті.
Dialogue: 0,0:06:32.18,0:06:34.06,Default,,0,0,0,,Бұл махаббат емес
Dialogue: 0,0:06:35.06,0:06:38.02,Default,,0,0,0,,Бірақ мен уайымдадым.
Dialogue: 0,0:06:38.56,0:06:41.60,Default,,0,0,0,,Жауап жоқ, телефон қоңыраулары жоқ
Dialogue: 0,0:06:45.57,0:06:50.78,Default,,0,0,0,,Шөпқоректілер мен жыртқыштар арасында байланыс жоғалуының ауырлығы мүлде басқаша.
Dialogue: 0,0:06:51.66,0:06:55.20,Default,,0,0,0,,Мүмкін сізге қауіп төніп тұрған шығар.
Dialogue: 0,0:06:55.28,0:06:56.83,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:06:56.91,0:06:58.25,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:06:58.33,0:06:59.37,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:06:59.46,0:07:00.50,Default,,0,0,0,,Бұл көңілсіз...
Dialogue: 0,0:07:00.58,0:07:06.09,Default,,0,0,0,,Мен... мен сені құшақтағым келеді... Оны қайтарғым келеді.
Dialogue: 0,0:07:07.55,0:07:10.17,Default,,0,0,0,,Түсімде мен сені бар күшіммен құшақтаймын
Dialogue: 0,0:07:10.17,0:07:13.34,Default,,0,0,0,,Түсімде мен сені бар күшіммен құшақтаймын
Dialogue: 0,0:07:10.17,0:07:13.34,Default,,0,0,0,,(Харудың айқайы)
Dialogue: 0,0:07:13.34,0:07:13.43,Default,,0,0,0,,(Харудың айқайы)
Dialogue: 0,0:07:13.43,0:07:15.81,Default,,0,0,0,,(Харудың айқайы)
Dialogue: 0,0:07:13.43,0:07:15.81,Default,,0,0,0,,Сіз мен қалағандай...
Dialogue: 0,0:07:15.89,0:07:17.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:17.97,0:07:19.35,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:07:20.14,0:07:20.98,Default,,0,0,0,,Бұл кішкентай.
Dialogue: 0,0:07:21.06,0:07:22.77,Default,,0,0,0,,Бұл дене өлшемі менің өмірімнің кілті.
Dialogue: 0,0:07:22.77,0:07:24.27,Default,,0,0,0,,Бұл дене өлшемі менің өмірімнің кілті.
Dialogue: 0,0:07:22.77,0:07:24.27,Default,,0,0,0,,Жарайды, алдымен осыны оқимын, бітірген соң екіншісін де оқимыз ба?
Dialogue: 0,0:07:24.27,0:07:25.73,Default,,0,0,0,,Бұл дене өлшемі менің өмірімнің кілті.
Dialogue: 0,0:07:26.48,0:07:29.61,Default,,0,0,0,,Саған шабуыл жасаған күннен бастап мен
Dialogue: 0,0:07:29.69,0:07:33.74,Default,,0,0,0,,Мен сіз бен менің арамыздағы физикалық айырмашылықтармен бетпе-бет келемін.
Dialogue: 0,0:07:33.82,0:07:35.07,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:35.16,0:07:36.99,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:07:37.08,0:07:39.04,Default,,0,0,0,,Бір жануардың да бақытсыз болуына жол бермеймін.
Dialogue: 0,0:07:40.29,0:07:42.29,Default,,0,0,0,,Легоши-кун?
Dialogue: 0,0:07:43.12,0:07:45.04,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:07:45.13,0:07:49.84,Default,,0,0,0,,А... Сен қандайсың, біртүрлі бала?
Dialogue: 0,0:07:52.63,0:07:57.14,Default,,0,0,0,,Мен бәрін өз қолыммен шешемін, сосын сені құшақтаймын.
Dialogue: 0,0:08:02.77,0:08:06.06,Default,,0,0,0,,Бүгінгі бұрышта бір нәрсенің иісі шығып тұр.
Dialogue: 0,0:08:06.77,0:08:09.11,Default,,0,0,0,,Бал қосылған балауыз
Dialogue: 0,0:08:09.19,0:08:10.19,Default,,0,0,0,,Жылтыр береді.
Dialogue: 0,0:08:10.28,0:08:11.94,Default,,0,0,0,,А...
Dialogue: 0,0:08:12.03,0:08:13.86,Default,,0,0,0,,Маған бұл өте ұнайды
Dialogue: 0,0:08:13.95,0:08:15.32,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:15.41,0:08:17.70,Default,,0,0,0,,Пина-кун, сен драма үйірмесіне қатысасың, солай ма?
Dialogue: 0,0:08:17.78,0:08:18.83,Default,,0,0,0,,Бұл көңілді ме?
Dialogue: 0,0:08:18.91,0:08:21.83,Default,,0,0,0,,Жыл басындағы қойылымда маған үлкен рөл берілді.
Dialogue: 0,0:08:21.91,0:08:24.17,Default,,0,0,0,,Хмм... мені көруге келе аласыз ба?
Dialogue: 0,0:08:24.25,0:08:26.71,Default,,0,0,0,,Го Го қандай рөл атқарады?
Dialogue: 0,0:08:26.79,0:08:31.30,Default,,0,0,0,,Жанын Орақ алған сұлу баланың рөлі
Dialogue: 0,0:08:31.38,0:08:33.63,Default,,0,0,0,,Өйткені мен ақырында өлемін
Dialogue: 0,0:08:33.72,0:08:35.13,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:08:35.22,0:08:38.01,Default,,0,0,0,,Иә, сен өлесің.
Dialogue: 0,0:08:39.22,0:08:41.31,Default,,0,0,0,,Арыстан-чан... иә?
Dialogue: 0,0:08:41.39,0:08:44.98,Default,,0,0,0,,Мен шынымен өлсем, сен қайғырасың ба?
Dialogue: 0,0:08:45.06,0:08:46.31,Default,,0,0,0,,Ой… бұл қорқынышты!
Dialogue: 0,0:08:46.40,0:08:49.40,Default,,0,0,0,,Мен күлетін шығармын
Dialogue: 0,0:08:49.48,0:08:52.07,Default,,0,0,0,,Ал, Риона деген кім?
Dialogue: 0,0:08:52.15,0:08:53.36,Default,,0,0,0,,Уау...
Dialogue: 0,0:08:53.44,0:08:54.86,Default,,0,0,0,,Жарайды... у...
Dialogue: 0,0:08:54.95,0:08:57.74,Default,,0,0,0,,Әйелдің аты араласып кетеді, сенің жаназаң ше?
Dialogue: 0,0:08:57.82,0:08:58.91,Default,,0,0,0,,Ешкім келмейді, солай ма?
Dialogue: 0,0:08:58.99,0:09:00.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:02.16,0:09:03.54,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:09:03.62,0:09:05.87,Default,,0,0,0,,Мен мұны қайтадан жасадым
Dialogue: 0,0:09:06.54,0:09:10.34,Default,,0,0,0,,Қыздар сөздерімен мені өлтірмекші болады.
Dialogue: 0,0:09:11.71,0:09:14.01,Default,,0,0,0,,Мықты бол, мен.
Dialogue: 0,0:09:14.09,0:09:16.59,Default,,0,0,0,,Мен соңғы кездері ессіз әрекет жасап жүрмін.
Dialogue: 0,0:09:16.68,0:09:20.60,Default,,0,0,0,,Бірақ соңында әдемі өлетін рөл?
Dialogue: 0,0:09:20.68,0:09:23.43,Default,,0,0,0,,Қазір бұл мен үшін тамаша емес пе?
Dialogue: 0,0:09:23.52,0:09:24.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:28.77,0:09:34.32,Default,,0,0,0,,Мен бүгінгі жаттығуды асыға күтемін, Пина-кун.
Dialogue: 0,0:09:36.78,0:09:38.95,Default,,0,0,0,,Ах... хаха
Dialogue: 0,0:09:39.03,0:09:41.20,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:09:41.28,0:09:44.16,Default,,0,0,0,,Тамақ өлтірушілер дәретханаға да бара ма?
Dialogue: 0,0:09:44.25,0:09:45.08,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:09:45.16,0:09:46.41,Default,,0,0,0,,Ура!
Dialogue: 0,0:09:46.50,0:09:47.62,Default,,0,0,0,,Ах
Dialogue: 0,0:09:48.79,0:09:50.00,Default,,0,0,0,,Легоши-кунға
Dialogue: 0,0:09:50.08,0:09:53.46,Default,,0,0,0,,Маған енді араласпауымды айта аласыз ба?
Dialogue: 0,0:09:54.38,0:09:55.84,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:55.92,0:09:58.47,Default,,0,0,0,,Балалар, мені жалғыз қалдырсаңдаршы
Dialogue: 0,0:09:58.55,0:10:02.51,Default,,0,0,0,,Уақытымды жүрегімдегі Тем туралы естеліктермен тыныш өткізе аламын.
Dialogue: 0,0:10:03.31,0:10:07.89,Default,,0,0,0,,Бірақ егер сіз менің Теммен достығымды қорлайтын болсаңыз.
Dialogue: 0,0:10:07.98,0:10:10.73,Default,,0,0,0,,Мен Легоши-кунның аузын жауып тастаймын.
Dialogue: 0,0:10:10.81,0:10:13.73,Default,,0,0,0,,Мен де сені жеуім мүмкін.
Dialogue: 0,0:10:14.44,0:10:16.86,Default,,0,0,0,,Басынан
Dialogue: 0,0:10:17.45,0:10:18.36,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:18.45,0:10:21.24,Default,,0,0,0,,Олай істеуді тоқтатқан дұрыс емес пе?
Dialogue: 0,0:10:21.32,0:10:24.45,Default,,0,0,0,,Бұл бұрыш ыңғайсыздық тудыратыны анық және дәмі жақсы емес...
Dialogue: 0,0:10:24.54,0:10:25.37,Default,,0,0,0,,Уф
Dialogue: 0,0:10:25.45,0:10:27.41,Default,,0,0,0,,А... аа...
Dialogue: 0,0:10:27.50,0:10:31.42,Default,,0,0,0,,Жоқ, жоқ... а...
Dialogue: 0,0:10:37.67,0:10:42.64,Default,,0,0,0,,(саусақтарды соратын дыбыс)
Dialogue: 0,0:10:44.39,0:10:46.81,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:10:47.68,0:10:51.81,Default,,0,0,0,,Саусақтарымның иісі шыққаны соншалық, мен...
Dialogue: 0,0:10:51.90,0:10:52.98,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:53.90,0:10:54.86,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:10:54.94,0:10:57.03,Default,,0,0,0,,Ха… га…
Dialogue: 0,0:10:57.11,0:10:58.32,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:59.74,0:11:03.03,Default,,0,0,0,,Саусақтар… Бар…
Dialogue: 0,0:11:04.58,0:11:06.29,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:06.37,0:11:07.50,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:11:08.70,0:11:12.75,Default,,0,0,0,,Жуынатын бөлменің еденінде босаңсып, жеңілдеп қалдым...
Dialogue: 0,0:11:13.63,0:11:17.71,Default,,0,0,0,,Мен өмір сүргім келеді.
Dialogue: 0,0:11:20.09,0:11:22.30,Default,,0,0,0,,«Мен бүгін түнде-»
Dialogue: 0,0:11:22.39,0:11:26.76,Default,,0,0,0,,«Адлер, сенің жаныңды аулауға келген өлім құдайы»
Dialogue: 0,0:11:26.85,0:11:29.98,Default,,0,0,0,,«Егер айтатын соңғы сөздер болса»
Dialogue: 0,0:11:30.06,0:11:33.15,Default,,0,0,0,,«Мен оны осы ораққа саламын»
Dialogue: 0,0:11:33.23,0:11:36.07,Default,,0,0,0,,Менде бір сүйкімді нәрсе бар.
Dialogue: 0,0:11:36.15,0:11:38.03,Default,,0,0,0,,Бір нәрсе жақсырақ сезіледі.
Dialogue: 0,0:11:39.28,0:11:40.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:47.58,0:11:49.95,Default,,0,0,0,,«Егер сен өміріңді сұрасаң»
Dialogue: 0,0:11:50.04,0:11:52.83,Default,,0,0,0,,«Сендер өлім құдайлары ризасыңдар ма?»
Dialogue: 0,0:11:52.92,0:11:54.25,Default,,0,0,0,,«Не?»
Dialogue: 0,0:11:55.21,0:11:58.42,Default,,0,0,0,,«Менің өмірім түкке тұрғысыз».
Dialogue: 0,0:11:58.50,0:12:00.80,Default,,0,0,0,,«Бірақ бұл тек менікі».
Dialogue: 0,0:12:00.88,0:12:03.76,Default,,0,0,0,,Жарайды, жарайды, сценарий есімде.
Dialogue: 0,0:12:04.89,0:12:09.22,Default,,0,0,0,,«Менің өлімнен қорқуым жалғыз менікі».
Dialogue: 0,0:12:09.31,0:12:10.56,Default,,0,0,0,,О...
Dialogue: 0,0:12:11.64,0:12:13.60,Default,,0,0,0,,«Өсиет емес»
Dialogue: 0,0:12:13.69,0:12:16.52,Default,,0,0,0,,«Егер бұл сенің жүрегіңнің зары болса, оны тыңдауға рұқсат ет».
Dialogue: 0,0:12:17.44,0:12:19.15,Default,,0,0,0,,«Мені өлтір!»
Dialogue: 0,0:12:19.23,0:12:21.86,Default,,0,0,0,,«Мен сенен қорықпаймын».
Dialogue: 0,0:12:23.57,0:12:25.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:25.78,0:12:27.53,Default,,0,0,0,,Ой, уау, жақсысың ба?
Dialogue: 0,0:12:27.62,0:12:29.41,Default,,0,0,0,,А...біреу маған шүберек әкелсін.
Dialogue: 0,0:12:29.49,0:12:31.58,Default,,0,0,0,,Кешіріңіз, жаттығуды әзірге тоқтату керек.
Dialogue: 0,0:12:31.58,0:12:31.95,Default,,0,0,0,,Кешіріңіз, жаттығуды әзірге тоқтату керек.
Dialogue: 0,0:12:31.58,0:12:31.95,Default,,0,0,0,,А, мен саған шүберек әкелемін.
Dialogue: 0,0:12:31.95,0:12:32.46,Default,,0,0,0,,А, мен шүберек әкелемін.
Dialogue: 0,0:12:32.46,0:12:32.71,Default,,0,0,0,,А, мен саған шүберек әкелемін.
Dialogue: 0,0:12:32.46,0:12:32.71,Default,,0,0,0,,Пина-кун, не болды?
Dialogue: 0,0:12:32.71,0:12:32.79,Default,,0,0,0,,Пина-кун, не болды?
Dialogue: 0,0:12:32.79,0:12:34.42,Default,,0,0,0,,Пина-кун, не болды?
Dialogue: 0,0:12:32.79,0:12:34.42,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:34.42,0:12:35.37,Default,,0,0,0,,Пина-кун, не болды?
Dialogue: 0,0:12:35.46,0:12:39.00,Default,,0,0,0,,Аха... не? Ха
Dialogue: 0,0:12:47.05,0:12:48.72,Default,,0,0,0,,Сіз оны дұрыс көрдіңіз бе?
Dialogue: 0,0:12:48.80,0:12:52.73,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:12:52.81,0:12:57.69,Default,,0,0,0,,Иә, айтарға ештеңе қалмаған сияқты.
Dialogue: 0,0:12:59.98,0:13:00.94,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:13:02.49,0:13:06.45,Default,,0,0,0,,Тегін, мылтықты бүгіннен бастап алуға болады.
Dialogue: 0,0:13:06.53,0:13:08.03,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:13:08.12,0:13:10.53,Default,,0,0,0,,Тек мені атып таста.
Dialogue: 0,0:13:10.62,0:13:15.16,Default,,0,0,0,,Мен жынды болып, бастықты жей жаздасам
Dialogue: 0,0:13:15.25,0:13:19.00,Default,,0,0,0,,Бастық екеуміз жай ғана арыстан мен киік болып кеткенімізде
Dialogue: 0,0:13:19.08,0:13:21.59,Default,,0,0,0,,Мені атып тастаудан тартынба.
Dialogue: 0,0:13:21.67,0:13:23.30,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:24.17,0:13:27.13,Default,,0,0,0,,Түсіндім... хехехе
Dialogue: 0,0:13:27.22,0:13:30.76,Default,,0,0,0,,Жұмыс орнында нағыз шиеленіс бар.
Dialogue: 0,0:13:30.85,0:13:33.56,Default,,0,0,0,,Біз бір-біріміз сияқты дайын емеспіз.
Dialogue: 0,0:13:34.56,0:13:36.23,Default,,0,0,0,,Жаман емес, солай ма?
Dialogue: 0,0:13:36.81,0:13:41.19,Default,,0,0,0,,Сол бастықтың қасында өмірімізді толықтай өткізейік.
Dialogue: 0,0:13:45.28,0:13:46.45,Default,,0,0,0,,Бұл болды ма? Шш!
Dialogue: 0,0:13:46.53,0:13:47.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:48.61,0:13:52.41,Default,,0,0,0,,Сіз клубтық іс-шараларды өткізіп, «артқы нарыққа» бара жатқанда
Dialogue: 0,0:13:52.49,0:13:56.41,Default,,0,0,0,,Жарайды, мен оны өз жолыммен шештім, уайымдамаңыз.
Dialogue: 0,0:13:56.50,0:13:57.92,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:58.62,0:14:00.21,Default,,0,0,0,,Өйткені, ол қауіпті.
Dialogue: 0,0:14:00.29,0:14:02.88,Default,,0,0,0,,Біз біреуге шабуыл жасамас бұрын бірдеңе істеуіміз керек.
Dialogue: 0,0:14:02.96,0:14:05.05,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:14:05.13,0:14:07.22,Default,,0,0,0,,Сондықтан мен стратегияны ойладым.
Dialogue: 0,0:14:07.30,0:14:08.80,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:14:08.88,0:14:10.80,Default,,0,0,0,,Алдаушы тергеу сияқты ма?
Dialogue: 0,0:14:10.89,0:14:11.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:12.01,0:14:14.27,Default,,0,0,0,,Мен дәмді көрінемін, солай емес пе?
Dialogue: 0,0:14:14.35,0:14:17.18,Default,,0,0,0,,Мен Лизді шақырамын, сондықтан Легоси-сенпай...
Dialogue: 0,0:14:17.27,0:14:19.14,Default,,0,0,0,,Уа, ау... Жоқ, жоқ, жоқ.
Dialogue: 0,0:14:19.23,0:14:20.10,Default,,0,0,0,,Тым қауіпті
Dialogue: 0,0:14:20.19,0:14:21.52,Default,,0,0,0,,Мүлдем жоқ.
Dialogue: 0,0:14:21.61,0:14:23.65,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:14:23.73,0:14:24.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:25.07,0:14:27.32,Default,,0,0,0,,Мен оны жазып қойдым.
Dialogue: 0,0:14:27.40,0:14:28.57,Default,,0,0,0,,Не!
Dialogue: 0,0:14:30.16,0:14:31.66,Default,,0,0,0,,Бос шашпен жабылған жатақхананың едені
Dialogue: 0,0:14:31.74,0:14:33.66,Default,,0,0,0,,Кілем сияқты. Кешіріңіз.
Dialogue: 0,0:14:33.74,0:14:35.29,Default,,0,0,0,,Лас... о...
Dialogue: 0,0:14:35.37,0:14:36.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:36.79,0:14:38.04,Default,,0,0,0,,Үйге бармадың ба?
Dialogue: 0,0:14:38.12,0:14:40.04,Default,,0,0,0,,Хаха... Мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:14:40.12,0:14:41.88,Default,,0,0,0,,Жоқ, сіз өте асығыссыз.
Dialogue: 0,0:14:41.96,0:14:43.46,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:14:43.54,0:14:45.50,Default,,0,0,0,,Жаңа жыл құтты болсын
Dialogue: 0,0:14:49.51,0:14:51.18,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:51.26,0:14:52.80,Default,,0,0,0,,А-а... мен оны дер кезінде жасадым.
Dialogue: 0,0:14:54.85,0:14:58.52,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:58.60,0:15:00.10,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:15:00.19,0:15:03.23,Default,,0,0,0,,Сіз мені Пина-кунның атын пайдаланып шақыруға қалай батылыңыз бар?
Dialogue: 0,0:15:03.31,0:15:05.86,Default,,0,0,0,,Ол таңқаларлық қорқақ.
Dialogue: 0,0:15:06.44,0:15:10.11,Default,,0,0,0,,Сіз мені жеңе аламын деп ойладыңыз ба? Легоши-кун
Dialogue: 0,0:15:10.82,0:15:14.70,Default,,0,0,0,,Уф... Жыртқыш сияқты маған қарап атымды атама.
Dialogue: 0,0:15:14.78,0:15:16.29,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін
Dialogue: 0,0:15:16.37,0:15:18.75,Default,,0,0,0,,Мына сұр қасқыр
Dialogue: 0,0:15:18.83,0:15:21.83,Default,,0,0,0,,Өйткені, оның басқа жыртқыштардан айырмашылығы бар.
Dialogue: 0,0:15:21.92,0:15:25.46,Default,,0,0,0,,Сіз мені жақсы білесіз.
Dialogue: 0,0:15:25.54,0:15:30.09,Default,,0,0,0,,Мен сенімен диалогтан гөрі жыртқыштық арқылы байланысқанды ұнатамын, Легоши-кун.
Dialogue: 0,0:15:30.17,0:15:32.93,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:15:33.01,0:15:34.60,Default,,0,0,0,,Бал...
Dialogue: 0,0:15:34.68,0:15:35.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:35.76,0:15:37.14,Default,,0,0,0,,Тек осы бас ауруы...
Dialogue: 0,0:15:40.23,0:15:42.06,Default,,0,0,0,,Мен аюлар отбасының жағдайын білемін.
Dialogue: 0,0:15:42.14,0:15:43.56,Default,,0,0,0,,Немесе… оны қайтарыңыз.
Dialogue: 0,0:15:43.65,0:15:47.57,Default,,0,0,0,,Жаман бас... бас...
Dialogue: 0,0:15:47.65,0:15:50.03,Default,,0,0,0,,Ол бұзылғалы тұр.
Dialogue: 0,0:15:50.11,0:15:51.86,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:15:51.95,0:15:53.66,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:15:53.74,0:15:58.70,Default,,0,0,0,,Күшті бақылайтын дәрілердің ауыр жанама әсерлері
Dialogue: 0,0:15:59.33,0:16:00.87,Default,,0,0,0,,Күйзеліс
Dialogue: 0,0:16:01.54,0:16:03.33,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:16:03.42,0:16:05.38,Default,,0,0,0,,Сен маған сол көздеріңмен ұнайсың.
Dialogue: 0,0:16:05.38,0:16:05.83,Default,,0,0,0,,Сен маған сол көздеріңмен ұнайсың.
Dialogue: 0,0:16:05.38,0:16:05.83,Default,,0,0,0,,Ш… Шынында да.
Dialogue: 0,0:16:05.83,0:16:07.13,Default,,0,0,0,,Ш… Шынында да.
Dialogue: 0,0:16:08.88,0:16:12.30,Default,,0,0,0,,Маған барлық аңдарыңды көрсет
Dialogue: 0,0:16:13.30,0:16:15.30,Default,,0,0,0,,Менің шынайы тұлғам қандай?
Dialogue: 0,0:16:16.05,0:16:18.56,Default,,0,0,0,,Мені ешкім қабылдамайды
Dialogue: 0,0:16:24.69,0:16:26.73,Default,,0,0,0,,Хэхехехехе...
Dialogue: 0,0:16:26.81,0:16:29.23,Default,,0,0,0,,Тырнақтар да, тістер де...
Dialogue: 0,0:16:29.32,0:16:32.61,Default,,0,0,0,,Біз шынымен қорқынышты жаратылыстармыз.
Dialogue: 0,0:16:33.49,0:16:35.91,Default,,0,0,0,,Сондықтан мен оны жасыруым керек.
Dialogue: 0,0:16:37.07,0:16:38.87,Default,,0,0,0,,Эй, Легоши-кун
Dialogue: 0,0:16:38.95,0:16:41.50,Default,,0,0,0,,Сіз түсінесіз деп ойламайсыз ба?
Dialogue: 0,0:16:41.58,0:16:42.87,Default,,0,0,0,,Менің жалғыздығым
Dialogue: 0,0:16:50.50,0:16:52.46,Default,,0,0,0,,Уау, көру қиын...
Dialogue: 0,0:16:55.72,0:17:00.01,Default,,0,0,0,,Бұл ас бәрінен бұрын қасиетті іс.
Dialogue: 0,0:17:00.10,0:17:02.77,Default,,0,0,0,,Ешкім байқамайтын жерге
Dialogue: 0,0:17:02.85,0:17:05.48,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:17:13.49,0:17:14.86,Default,,0,0,0,,Хаа... міне.
Dialogue: 0,0:17:14.95,0:17:17.66,Default,,0,0,0,,Бұл сіз қалағаныңызша қан кете аласыз дегенді білдіре ме?
Dialogue: 0,0:17:19.07,0:17:22.16,Default,,0,0,0,,Бір рет тірі ет жейсің
Dialogue: 0,0:17:22.24,0:17:25.21,Default,,0,0,0,,Кінә мен аштықтан өзіне зиян келтіру
Dialogue: 0,0:17:26.08,0:17:28.38,Default,,0,0,0,,Бұл мұңды орта мектеп өмірі.
Dialogue: 0,0:17:29.21,0:17:31.34,Default,,0,0,0,,Жастық шағыңызды өзіңізбен бірге қалпына келтіру
Dialogue: 0,0:17:34.01,0:17:37.89,Default,,0,0,0,,Кел, жастық шағыңның рахатын көр.
Dialogue: 0,0:17:38.43,0:17:40.76,Default,,0,0,0,,Дегенмен, ескі жаралар кесіледі.
Dialogue: 0,0:17:41.39,0:17:42.81,Default,,0,0,0,,Темнің жастығын қайтар!
Dialogue: 0,0:17:42.89,0:17:44.06,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:17:45.35,0:17:47.35,Default,,0,0,0,,Бұл ескі жара емес.
Dialogue: 0,0:17:47.44,0:17:48.15,Default,,0,0,0,,Менің қымбат естеліктерімді ұстама
Dialogue: 0,0:17:48.15,0:17:49.90,Default,,0,0,0,,Менің қымбат естеліктерімді ұстама
Dialogue: 0,0:17:48.15,0:17:49.90,Default,,0,0,0,,Уф Уау Уау
Dialogue: 0,0:17:49.98,0:17:51.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:52.86,0:17:54.49,Default,,0,0,0,,Тек Тем мені қабылдады.
Dialogue: 0,0:17:54.57,0:17:57.74,Default,,0,0,0,,Жоқ! сен тимді жедің
Dialogue: 0,0:17:57.82,0:18:01.12,Default,,0,0,0,,Тем екеуміз нәсілден асып, дос болдық.
Dialogue: 0,0:18:01.20,0:18:03.49,Default,,0,0,0,,Сіз Темді жедіңіз
Dialogue: 0,0:18:03.58,0:18:06.00,Default,,0,0,0,,Жыртқыштық нәсілдік кедергілерді бұзатын жалғыз нәрсе.
Dialogue: 0,0:18:06.08,0:18:07.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:07.08,0:18:09.12,Default,,0,0,0,,Нәсілдік кедергілерді кім бұза алады?
Dialogue: 0,0:18:10.04,0:18:11.13,Default,,0,0,0,,Тек махаббат
Dialogue: 0,0:18:13.09,0:18:14.38,Default,,0,0,0,,Махаббат?
Dialogue: 0,0:18:15.34,0:18:17.97,Default,,0,0,0,,Біз үшін ондай нәрсе жоқ.
Dialogue: 0,0:18:18.55,0:18:21.10,Default,,0,0,0,,Жек көрушілік пен жалғыздық
Dialogue: 0,0:18:21.18,0:18:23.56,Default,,0,0,0,,Тырнақтар мен азу тістермен не алуға болады?
Dialogue: 0,0:18:26.98,0:18:29.90,Default,,0,0,0,,Бұлай жалғаса берсе, еден құлап қалады.
Dialogue: 0,0:18:29.98,0:18:32.90,Default,,0,0,0,,Маған көбірек тиюге рұқсат етіңіз
Dialogue: 0,0:18:36.65,0:18:37.90,Default,,0,0,0,,(айнаның сынған дыбысы)
Dialogue: 0,0:18:37.99,0:18:38.82,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:39.91,0:18:42.78,Default,,0,0,0,,Сіз бәрібір шөпқоректілердің жұмсақ етін ғана жейсіз.
Dialogue: 0,0:18:42.87,0:18:44.87,Default,,0,0,0,,Сіз басқа адамды түсінемін деп ойлайсыз, солай ма?
Dialogue: 0,0:18:44.95,0:18:48.37,Default,,0,0,0,,Жыртқыштың еті мен қанын же!
Dialogue: 0,0:18:48.46,0:18:50.33,Default,,0,0,0,,Оның қолына қара!
Dialogue: 0,0:18:50.42,0:18:53.00,Default,,0,0,0,,Қасқырдың етін жеп көріңіз.
Dialogue: 0,0:18:53.09,0:18:55.46,Default,,0,0,0,,Мен сенің иегіңді қайтадан жарамсыз етемін
Dialogue: 0,0:18:56.13,0:18:58.47,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:19:01.84,0:19:03.51,Default,,0,0,0,,Лиз, тоқтат.
Dialogue: 0,0:19:05.43,0:19:08.10,Default,,0,0,0,,А... Апай, кешіріңіз.
Dialogue: 0,0:19:08.18,0:19:09.35,Default,,0,0,0,,Оны әлі де пайдалануда
Dialogue: 0,0:19:09.43,0:19:11.69,Default,,0,0,0,,Не? Кешіріңіз
Dialogue: 0,0:19:11.77,0:19:14.44,Default,,0,0,0,,Мен жақында шығамын, күте тұрыңыз.
Dialogue: 0,0:19:14.52,0:19:17.53,Default,,0,0,0,,Мен енді ештеңе істей алмаймын.
Dialogue: 0,0:19:17.61,0:19:19.07,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:19.86,0:19:21.36,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:21.45,0:19:22.36,Default,,0,0,0,,Аа...
Dialogue: 0,0:19:23.82,0:19:27.74,Default,,0,0,0,,Әзірге едендегі қанды жуып алайық.
Dialogue: 0,0:19:27.83,0:19:30.21,Default,,0,0,0,,Ю... Еден тоз-тоз.
Dialogue: 0,0:19:30.79,0:19:32.25,Default,,0,0,0,,Мұнымен не істеуім керек?
Dialogue: 0,0:19:32.33,0:19:34.79,Default,,0,0,0,,Апай байқамай қашу.
Dialogue: 0,0:19:34.88,0:19:36.92,Default,,0,0,0,,Білмейтіндей кейіп таныту
Dialogue: 0,0:19:38.88,0:19:40.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:41.22,0:19:43.97,Default,,0,0,0,,Жай ғана жауыз болсаң ғой.
Dialogue: 0,0:19:44.05,0:19:46.89,Default,,0,0,0,,Мен сені одан бетер жек көруім мүмкін
Dialogue: 0,0:19:47.60,0:19:51.56,Default,,0,0,0,,Бір жыл бұрын мен болсам, осылай ажырасатын едім.
Dialogue: 0,0:19:51.64,0:19:54.40,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:19:54.48,0:19:55.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:55.48,0:19:57.40,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:19:58.23,0:20:01.86,Default,,0,0,0,,Мен сені ешқашан кешіре алмаймын.
Dialogue: 0,0:20:03.07,0:20:05.78,Default,,0,0,0,,(Екі айқайлау)
Dialogue: 0,0:20:05.87,0:20:07.12,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:07.20,0:20:08.45,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:20:08.54,0:20:10.87,Default,,0,0,0,,Әзірше осы, Легоси-кун.
Dialogue: 0,0:20:12.21,0:20:15.21,Default,,0,0,0,,Есеп айырысу Жаңа жыл қарсаңында
Dialogue: 0,0:20:15.29,0:20:16.59,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:18.92,0:20:22.26,Default,,0,0,0,,Жаңа жыл түні... Жарайды.
Dialogue: 0,0:20:22.84,0:20:26.22,Default,,0,0,0,,Мен сені сыпайы түрде өлтіруге дайынмын
Dialogue: 0,0:20:26.30,0:20:29.56,Default,,0,0,0,,Етқоректі деп шешейік
Dialogue: 0,0:20:33.19,0:20:35.31,Default,,0,0,0,,Керемет емес пе? Түсіну оңай.
Dialogue: 0,0:20:36.06,0:20:39.52,Default,,0,0,0,,Әй, мен бірден полицияға не беруім керек?
Dialogue: 0,0:20:39.61,0:20:42.24,Default,,0,0,0,,Ал... жарайды, сізге ұқсайды.
Dialogue: 0,0:20:42.32,0:20:43.74,Default,,0,0,0,,Хахахахахахахаха...
Dialogue: 0,0:20:43.82,0:20:46.07,Default,,0,0,0,,Гухин мырзаның саясаты туралы бұрын естігенмін.
Dialogue: 0,0:20:46.16,0:20:47.66,Default,,0,0,0,,Тек басқару
Dialogue: 0,0:20:48.62,0:20:52.20,Default,,0,0,0,,Мен шөпқоректі жеуге жақын қалдым.
Dialogue: 0,0:20:53.04,0:20:55.17,Default,,0,0,0,,Жазалаудың орнына
Dialogue: 0,0:20:55.25,0:20:58.21,Default,,0,0,0,,Мен онымен өзім кездескім келеді.
Dialogue: 0,0:20:59.13,0:21:02.13,Default,,0,0,0,,Хаа... Бірақ қазір онсыз да тоз-тоз болып кетті.
Dialogue: 0,0:21:02.21,0:21:04.30,Default,,0,0,0,,Жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:21:04.97,0:21:07.72,Default,,0,0,0,,Дәл қазір күшейіп кетсем екен
Dialogue: 0,0:21:08.51,0:21:10.01,Default,,0,0,0,,Бірдеңені айтыңыз...
Dialogue: 0,0:21:10.10,0:21:12.64,Default,,0,0,0,,Жәндіктер туралы мұндай жақсы әңгімелер жоқ.
Dialogue: 0,0:21:14.23,0:21:15.94,Default,,0,0,0,,Жоқ... Иә?
Dialogue: 0,0:21:17.15,0:21:19.15,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:21:19.23,0:21:20.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:22.03,0:21:28.03,Default,,0,0,0,,♪～
Dialogue: 0,0:22:42.31,0:22:48.32,Default,,0,0,0,,～♪
Dialogue: 0,0:22:49.82,0:22:55.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory