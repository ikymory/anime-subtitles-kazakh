Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.05,0:00:18.05,Default,,0,0,0,,♪～
Dialogue: 0,0:01:32.34,0:01:38.34,Default,,0,0,0,,～♪
Dialogue: 0,0:01:54.32,0:01:56.32,Default,,0,0,0,,Қайсарлық таусылғанда
Dialogue: 0,0:01:56.40,0:02:00.28,Default,,0,0,0,,Өйткені, менің ішімдегі нәрсе Шиши-гумиден шыққан арыстан.
Dialogue: 0,0:02:00.37,0:02:02.41,Default,,0,0,0,,Тек осылай
Dialogue: 0,0:02:02.49,0:02:05.95,Default,,0,0,0,,Мен сенімен қарым-қатынасымды реттей алмаймын.
Dialogue: 0,0:02:07.87,0:02:08.87,Default,,0,0,0,,Босс
Dialogue: 0,0:02:08.96,0:02:09.79,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:10.67,0:02:13.42,Default,,0,0,0,,Мен сенімен өткен күндерім жайлы болды дедім.
Dialogue: 0,0:02:13.50,0:02:15.30,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:15.38,0:02:18.68,Default,,0,0,0,,Мен шынымен «бақытты» болдым
Dialogue: 0,0:02:19.43,0:02:20.55,Default,,0,0,0,,Луис…
Dialogue: 0,0:02:20.64,0:02:22.72,Default,,0,0,0,,Сіз мені құтқардыңыз
Dialogue: 0,0:02:28.06,0:02:29.10,Default,,0,0,0,,(Мылтық көрсету дыбысы)
Dialogue: 0,0:02:30.23,0:02:31.06,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:31.15,0:02:33.44,Default,,0,0,0,,Егер сіз шешпесеңіз
Dialogue: 0,0:02:33.52,0:02:35.32,Default,,0,0,0,,Мен жеймін.
Dialogue: 0,0:02:36.11,0:02:38.36,Default,,0,0,0,,Дауыс шыққан жаққа қарай ату.
Dialogue: 0,0:02:38.44,0:02:40.45,Default,,0,0,0,,Хм... Бұл мүмкін емес, Ибуки.
Dialogue: 0,0:02:41.03,0:02:43.16,Default,,0,0,0,,Мен сені ата алмаймын.
Dialogue: 0,0:02:43.24,0:02:44.58,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:45.16,0:02:46.49,Default,,0,0,0,,Ийда…
Dialogue: 0,0:02:48.50,0:02:50.17,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:02:51.50,0:02:54.29,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:57.09,0:02:58.59,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:03:01.89,0:03:03.47,Default,,0,0,0,,Ибуки?
Dialogue: 0,0:03:04.60,0:03:05.93,Default,,0,0,0,,Ибуки?
Dialogue: 0,0:03:06.56,0:03:08.64,Default,,0,0,0,,Әй, көзіңді аш.
Dialogue: 0,0:03:08.73,0:03:11.39,Default,,0,0,0,,Бұл арыстан, өлме.
Dialogue: 0,0:03:11.48,0:03:12.77,Default,,0,0,0,,Ибуки!
Dialogue: 0,0:03:13.81,0:03:15.11,Default,,0,0,0,,Бұл тегін
Dialogue: 0,0:03:15.77,0:03:18.28,Default,,0,0,0,,Мен бастықты қорғай алдым.
Dialogue: 0,0:03:20.15,0:03:21.61,Default,,0,0,0,,Неге...
Dialogue: 0,0:03:22.78,0:03:23.95,Default,,0,0,0,,Ибуки
Dialogue: 0,0:03:24.03,0:03:27.04,Default,,0,0,0,,Мен сені түсіргеніме өкінбеймін.
Dialogue: 0,0:03:27.12,0:03:29.41,Default,,0,0,0,,Сіз уәде бердіңіз.
Dialogue: 0,0:03:29.50,0:03:30.71,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,0:03:30.79,0:03:34.25,Default,,0,0,0,,Біртүрлі сезініп, бастықты жей жаздаған кезде
Dialogue: 0,0:03:34.33,0:03:36.54,Default,,0,0,0,,Мені ойланбастан атып жіберіңізші
Dialogue: 0,0:03:36.63,0:03:39.96,Default,,0,0,0,,Бұл жігіт жынды болып, мені жеуге тырыспады.
Dialogue: 0,0:03:40.05,0:03:42.68,Default,,0,0,0,,Себебі мен топтан кетемін дедім.
Dialogue: 0,0:03:43.93,0:03:46.43,Default,,0,0,0,,Соңына дейін Шиши-гуми арыстаны болып
Dialogue: 0,0:03:46.51,0:03:49.47,Default,,0,0,0,,Менің бастықпен бетпе-бет келуден басқа амалым жоқ шығар.
Dialogue: 0,0:03:51.85,0:03:55.15,Default,,0,0,0,,"Урайчиге" енді қайтып келмеңіз.
Dialogue: 0,0:03:55.94,0:04:00.86,Default,,0,0,0,,Мен сені осы жерде өлтірсем, Ибукидің өлімі бекер болады.
Dialogue: 0,0:04:08.20,0:04:10.16,Default,,0,0,0,,Біз не істеуіміз керек? Легоши-кун
Dialogue: 0,0:04:10.25,0:04:12.41,Default,,0,0,0,,Әлгі әдемі жігіт қазірдің өзінде...
Dialogue: 0,0:04:12.50,0:04:14.29,Default,,0,0,0,,Менің ішімде.
Dialogue: 0,0:04:14.37,0:04:16.96,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:04:18.21,0:04:24.80,Default,,0,0,0,,（）
Dialogue: 0,0:04:24.88,0:04:26.93,Default,,0,0,0,,2 километр 100 метр қашықтықта
Dialogue: 0,0:04:27.01,0:04:28.47,Default,,0,0,0,,Бұл эстакаданың астындағы қоқыс үйіндісі.
Dialogue: 0,0:04:28.55,0:04:29.93,Default,,0,0,0,,(Пинаның ыңырануы)
Dialogue: 0,0:04:30.01,0:04:32.89,Default,,0,0,0,,Және сол қолында кесілген
Dialogue: 0,0:04:33.56,0:04:34.64,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:35.23,0:04:39.19,Default,,0,0,0,,Сіз мені алдау үшін оған Пинаның қанын құйған шығарсыз.
Dialogue: 0,0:04:39.27,0:04:41.57,Default,,0,0,0,,Салмасы тым тәтті.
Dialogue: 0,0:04:41.65,0:04:46.82,Default,,0,0,0,,Менің ішімдегі иіс сақтау орны мен қорғағым келетін жануарларға арналған.
Dialogue: 0,0:04:48.99,0:04:52.87,Default,,0,0,0,,Екеуіміз де шөпқоректілерге қызығатын жыртқышпыз.
Dialogue: 0,0:04:52.95,0:04:54.21,Default,,0,0,0,,Олар ұқсас.
Dialogue: 0,0:04:54.29,0:04:56.67,Default,,0,0,0,,Мұны бірге жасамаңыз!
Dialogue: 0,0:05:01.55,0:05:03.21,Default,,0,0,0,,Легоши-кун...
Dialogue: 0,0:05:03.30,0:05:06.05,Default,,0,0,0,,Шөпқоректілерді қорғайсың ба, әлде жейсің бе
Dialogue: 0,0:05:06.13,0:05:08.55,Default,,0,0,0,,Біздің жыртқыштардың күші
Dialogue: 0,0:05:08.64,0:05:10.76,Default,,0,0,0,,Өйткені, бұл жалғыздықтың орнына.
Dialogue: 0,0:05:10.85,0:05:12.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:12.93,0:05:14.39,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:05:14.48,0:05:16.56,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:05:14.48,0:05:16.56,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:05:16.56,0:05:16.64,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:05:16.64,0:05:19.94,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:05:16.64,0:05:19.94,Default,,0,0,0,,Сенің етің мен қаның менің жалғыздығымды толтырады.
Dialogue: 0,0:05:19.94,0:05:20.90,Default,,0,0,0,,Сенің етің мен қаның менің жалғыздығымды толтырады.
Dialogue: 0,0:05:21.90,0:05:25.36,Default,,0,0,0,,Лиздің жалғыздығы және менің эго
Dialogue: 0,0:05:26.15,0:05:28.03,Default,,0,0,0,,Менің эгомды тамақтандырмаңыз
Dialogue: 0,0:05:28.91,0:05:30.28,Default,,0,0,0,,Уф... Гах...
Dialogue: 0,0:05:30.37,0:05:33.87,Default,,0,0,0,,Бұл өте қиын емес пе?
Dialogue: 0,0:05:36.62,0:05:39.88,Default,,0,0,0,,Кез келген жағдайда... сізде де ет бар ма?
Dialogue: 0,0:05:39.96,0:05:44.09,Default,,0,0,0,,Сіз ешқашан түсінбейсіз, Лиз.
Dialogue: 0,0:05:44.17,0:05:46.76,Default,,0,0,0,,Бір ғана нәрсе маңызды
Dialogue: 0,0:05:47.34,0:05:49.34,Default,,0,0,0,,Өмірді құрметтеу
Dialogue: 0,0:05:51.60,0:05:52.93,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:05:57.31,0:06:00.35,Default,,0,0,0,,Ах... ах... хмм...
Dialogue: 0,0:06:00.44,0:06:01.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:03.78,0:06:06.15,Default,,0,0,0,,Уф! Арх...
Dialogue: 0,0:06:10.07,0:06:12.66,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:13.95,0:06:15.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:16.04,0:06:17.29,Default,,0,0,0,,Уау, аа... хмм...
Dialogue: 0,0:06:17.37,0:06:19.17,Default,,0,0,0,,Қарғыс атсын... Уау Уау...
Dialogue: 0,0:06:19.25,0:06:19.96,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:06:19.96,0:06:23.04,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:06:19.96,0:06:23.04,Default,,0,0,0,,Тем екеуміздің арамыздағы шынайы достық
Dialogue: 0,0:06:23.04,0:06:23.13,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:06:23.13,0:06:25.09,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:06:23.13,0:06:25.09,Default,,0,0,0,,Мен үшінші тұлғаның қорлауына шыдай алмаймын.
Dialogue: 0,0:06:25.09,0:06:27.34,Default,,0,0,0,,Мен үшінші тұлғаның қорлауына шыдай алмаймын.
Dialogue: 0,0:06:27.42,0:06:29.59,Default,,0,0,0,,Темді сіз «өлгенше жеп қойдыңыз».
Dialogue: 0,0:06:29.68,0:06:31.80,Default,,0,0,0,,Сіз бәрін жойдыңыз.
Dialogue: 0,0:06:31.89,0:06:34.81,Default,,0,0,0,,Тем, бәрі жақсы.
Dialogue: 0,0:06:34.89,0:06:35.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:35.93,0:06:38.35,Default,,0,0,0,,Мен оның аузын жауып тастаймын.
Dialogue: 0,0:06:38.43,0:06:40.02,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:06:40.10,0:06:42.61,Default,,0,0,0,,А-а... (шапалақ дыбысы)
Dialogue: 0,0:06:42.69,0:06:45.48,Default,,0,0,0,,Легоши... Легоши!
Dialogue: 0,0:06:45.57,0:06:47.36,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:06:47.44,0:06:50.74,Default,,0,0,0,,Дұрыс, бұл сезім
Dialogue: 0,0:06:50.82,0:06:53.20,Default,,0,0,0,,Өлім алдында тұрған тірі заттар
Dialogue: 0,0:06:53.28,0:06:56.54,Default,,0,0,0,,Ол сұйық тәрізді қоюланады.
Dialogue: 0,0:06:56.62,0:06:58.08,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:07:00.46,0:07:01.79,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:07:04.63,0:07:07.67,Default,,0,0,0,,Бірақ сен де қаталсың.
Dialogue: 0,0:07:10.01,0:07:11.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:11.13,0:07:13.26,Default,,0,0,0,,Легоши?
Dialogue: 0,0:07:13.34,0:07:14.72,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:07:14.80,0:07:17.35,Default,,0,0,0,,Хаха... сен тірі ме едің?
Dialogue: 0,0:07:17.43,0:07:19.27,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:19.35,0:07:22.85,Default,,0,0,0,,Мен... Енді уайымдаудың не керегі бар? Ах...
Dialogue: 0,0:07:22.94,0:07:26.48,Default,,0,0,0,,Хаха, бұл рас.
Dialogue: 0,0:07:27.32,0:07:31.53,Default,,0,0,0,,Бірақ мен сізге мынаны айтуым керек.
Dialogue: 0,0:07:32.24,0:07:34.82,Default,,0,0,0,,Мен оны шынымен байқадым.
Dialogue: 0,0:07:34.91,0:07:35.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:35.83,0:07:40.83,Default,,0,0,0,,Темді жесем, достық жоқ.
Dialogue: 0,0:07:41.62,0:07:45.84,Default,,0,0,0,,Бұл мен үшін біржақты өлтіру болды.
Dialogue: 0,0:07:45.92,0:07:49.34,Default,,0,0,0,,Лиз... Лиз! Бір минут күте тұрыңыз...
Dialogue: 0,0:07:49.42,0:07:51.38,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:07:51.47,0:07:53.76,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:07:53.84,0:07:55.76,Default,,0,0,0,,Сол оқиға...
Dialogue: 0,0:07:55.85,0:07:58.10,Default,,0,0,0,,Сондай-ақ... толығырақ айтып беріңізші
Dialogue: 0,0:07:58.18,0:08:01.73,Default,,0,0,0,,ше? Енді бір-бірімізді өлтіреміз
Dialogue: 0,0:08:01.81,0:08:03.64,Default,,0,0,0,,Мен білемін, бірақ... хмм...
Dialogue: 0,0:08:03.73,0:08:06.27,Default,,0,0,0,,Дәл қазір мен Лиздің әңгімесін тыңдағым келеді.
Dialogue: 0,0:08:07.19,0:08:08.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:12.40,0:08:13.28,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:14.24,0:08:16.32,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:17.07,0:08:19.62,Default,,0,0,0,,Бірақ мен біреумен сөйлескім келді.
Dialogue: 0,0:08:20.16,0:08:22.79,Default,,0,0,0,,Уақытша тоқтату бар ма?
Dialogue: 0,0:08:23.54,0:08:26.83,Default,,0,0,0,,Қатар жатқан құбыжықтар
Dialogue: 0,0:08:26.92,0:08:28.38,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:08:28.46,0:08:31.63,Default,,0,0,0,,Құбыжықтар... біз бе?
Dialogue: 0,0:08:32.34,0:08:35.01,Default,,0,0,0,,Тем маған сол түні айтты.
Dialogue: 0,0:08:36.05,0:08:40.18,Default,,0,0,0,,«Сендер жыртқыштардың бәрі құбыжықтарсыңдар!»
Dialogue: 0,0:08:41.14,0:08:43.35,Default,,0,0,0,,Бір қызығы, мен шошыған жоқпын.
Dialogue: 0,0:08:43.43,0:08:49.11,Default,,0,0,0,,Бұл менің шынайы болмысымды көрген сөздердің құшағында болды.
Dialogue: 0,0:08:49.19,0:08:51.36,Default,,0,0,0,,Өйткені мен өте қуаныштымын
Dialogue: 0,0:08:51.44,0:08:57.53,Default,,0,0,0,,Темді жегендегі естелік әдемі естелікке айналды.
Dialogue: 0,0:08:58.87,0:09:03.33,Default,,0,0,0,,Етқоректілердің мәні - құбыжықтар, Легоси-кун.
Dialogue: 0,0:09:04.12,0:09:07.58,Default,,0,0,0,,Себебі мен қайғылымын.
Dialogue: 0,0:09:08.21,0:09:11.63,Default,,0,0,0,,Тимнің жүзі мен дауысы әлі есімде жоқ болса да.
Dialogue: 0,0:09:12.30,0:09:13.92,Default,,0,0,0,,Дәмі мен иісі
Dialogue: 0,0:09:14.01,0:09:17.43,Default,,0,0,0,,Мен оны әлі күнге дейін анық есімде сақтаймын
Dialogue: 0,0:09:18.64,0:09:23.10,Default,,0,0,0,,Мен Лиз сияқты болған шығармын.
Dialogue: 0,0:09:23.18,0:09:25.69,Default,,0,0,0,,Айналамдағылардың көмегінсіз мен...
Dialogue: 0,0:09:26.39,0:09:31.02,Default,,0,0,0,,Ол Хару-чанды қатты жақсы көргендіктен, оны жеп қойған шығар.
Dialogue: 0,0:09:33.36,0:09:38.24,Default,,0,0,0,,А... енді жыртқыштың жастық шағы.
Dialogue: 0,0:09:39.24,0:09:40.07,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:40.74,0:09:43.66,Default,,0,0,0,,Мен енді өз сенімдерімді өзгерте алмаймын
Dialogue: 0,0:09:45.12,0:09:45.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:46.04,0:09:47.25,Default,,0,0,0,,Жақында қайта бастаймыз.
Dialogue: 0,0:09:48.46,0:09:51.79,Default,,0,0,0,,Жыртқыштардың тырнақтары мен азу тістері болады
Dialogue: 0,0:09:51.88,0:09:54.38,Default,,0,0,0,,олжадан басқа ештеңе жоқ.
Dialogue: 0,0:09:54.46,0:09:55.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:55.38,0:09:58.68,Default,,0,0,0,,Мен де сенің дәміңді ұмытпаймын.
Dialogue: 0,0:09:59.26,0:10:01.68,Default,,0,0,0,,Жоқ, Лиз.
Dialogue: 0,0:10:02.22,0:10:07.31,Default,,0,0,0,,Біздің тырнақтарымыз бен тістеріміз біз үшін маңызды нәрсені қорғауға арналған.
Dialogue: 0,0:10:07.98,0:10:08.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:09.73,0:10:11.61,Default,,0,0,0,,Уа, ау, ау... (түскен дыбыс)
Dialogue: 0,0:10:11.69,0:10:13.07,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:10:13.15,0:10:14.94,Default,,0,0,0,,(шарбақ қағу дыбысы)
Dialogue: 0,0:10:15.03,0:10:16.03,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:17.40,0:10:20.95,Default,,0,0,0,,(Луидің ауыр тыныс алуы)
Dialogue: 0,0:10:21.03,0:10:23.45,Default,,0,0,0,,Мен өте көңілді жүрмін.
Dialogue: 0,0:10:24.54,0:10:25.70,Default,,0,0,0,,Луи-сенпай?
Dialogue: 0,0:10:25.79,0:10:26.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:28.33,0:10:31.00,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:10:31.54,0:10:34.84,Default,,0,0,0,,Сойысты көре алмадым ғой.
Dialogue: 0,0:10:34.92,0:10:36.59,Default,,0,0,0,,Шулы!
Dialogue: 0,0:10:36.67,0:10:39.01,Default,,0,0,0,,Ууууууууууууууууу...
Dialogue: 0,0:10:39.09,0:10:40.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:41.01,0:10:42.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:48.60,0:10:50.81,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:11:01.82,0:11:04.58,Default,,0,0,0,,(Пинаның ыңырсыуы)
Dialogue: 0,0:11:05.58,0:11:07.87,Default,,0,0,0,,Ха... мен жасадым
Dialogue: 0,0:11:08.41,0:11:09.37,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:09.46,0:11:10.71,Default,,0,0,0,,Қыз Түсіруден басқа
Dialogue: 0,0:11:10.79,0:11:13.71,Default,,0,0,0,,Мен бұл мүйіздің пайдалы болатын күні келеді деп ойламаппын.
Dialogue: 0,0:11:14.38,0:11:15.80,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:11:18.34,0:11:20.93,Default,,0,0,0,,Сен келдің, Луи-сенпай.
Dialogue: 0,0:11:22.05,0:11:23.72,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:24.51,0:11:27.89,Default,,0,0,0,,Ақырында, мен жаңа жыл кешін осылай өткізе алғаныма сене алар емеспін.
Dialogue: 0,0:11:29.18,0:11:30.35,Default,,0,0,0,,Мм... бірақ...
Dialogue: 0,0:11:30.43,0:11:32.60,Default,,0,0,0,,Неліктен әлі шешілмеді? Мен қайтуым керек.
Dialogue: 0,0:11:32.69,0:11:34.19,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:11:34.27,0:11:37.69,Default,,0,0,0,,Мәміле қандай? Бүкіл денең тозған емес пе?
Dialogue: 0,0:11:37.78,0:11:39.94,Default,,0,0,0,,Ол үшін де, мен үшін де.
Dialogue: 0,0:11:40.03,0:11:43.03,Default,,0,0,0,,Жеңіс немесе жеңілу енді маңызды емес
Dialogue: 0,0:11:43.78,0:11:46.28,Default,,0,0,0,,Екеуміз де жыртқыш ретінде өмір сүреміз.
Dialogue: 0,0:11:46.37,0:11:48.79,Default,,0,0,0,,Менің ойымша, сіз олар бір-бірімен соқтығысады деп айта аласыз ...
Dialogue: 0,0:11:49.79,0:11:53.17,Default,,0,0,0,,Мен онымен соңына дейін қарсы тұруым керек...
Dialogue: 0,0:11:54.17,0:11:58.05,Default,,0,0,0,,Мен ашуыма жауаптымын.
Dialogue: 0,0:11:58.13,0:11:59.55,Default,,0,0,0,,Жауапкершілік…
Dialogue: 0,0:12:00.71,0:12:03.88,Default,,0,0,0,,Неліктен күшіңізге жауапкершілік алмайсыз?
Dialogue: 0,0:12:05.59,0:12:09.14,Default,,0,0,0,,Бұл сөздерді қашанға дейін есте сақтайсыз?
Dialogue: 0,0:12:10.47,0:12:11.64,Default,,0,0,0,,Луи Сенпай
Dialogue: 0,0:12:12.52,0:12:18.27,Default,,0,0,0,,Сенің кесіріңнен құбыжық болмадым.
Dialogue: 0,0:12:18.36,0:12:21.53,Default,,0,0,0,,Луи, сен мені құтқардың.
Dialogue: 0,0:12:23.36,0:12:26.99,Default,,0,0,0,,Бөлінбе, өзіңді сақта
Dialogue: 0,0:12:27.07,0:12:28.78,Default,,0,0,0,,Себебі
Dialogue: 0,0:12:28.87,0:12:31.75,Default,,0,0,0,,Сен оны дәлелдеу үшін өлесің бе?
Dialogue: 0,0:12:31.83,0:12:33.58,Default,,0,0,0,,Шынайы сезімдеріңізді жасырыңыз
Dialogue: 0,0:12:33.66,0:12:37.08,Default,,0,0,0,,«Өмірлерін жыртқыш ретінде күресу» дегеніміз не?
Dialogue: 0,0:12:37.17,0:12:39.17,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:12:39.25,0:12:40.55,Default,,0,0,0,,Жүрегіңді қатайт
Dialogue: 0,0:12:41.38,0:12:43.09,Default,,0,0,0,,Сіз жыртқышсыз ба?
Dialogue: 0,0:12:43.17,0:12:46.43,Default,,0,0,0,,Менің денем күшті болғандықтан, өмір сүруге деген жігерім тым әлсіз.
Dialogue: 0,0:12:47.09,0:12:50.51,Default,,0,0,0,,Сонша өлгің келсе, өзің өл.
Dialogue: 0,0:12:52.18,0:12:54.48,Default,,0,0,0,,Руи… Луи Сен…
Dialogue: 0,0:12:54.56,0:12:56.65,Default,,0,0,0,,(Луидің айқайы)
Dialogue: 0,0:12:56.73,0:12:59.57,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,0:12:59.65,0:13:03.53,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:03.61,0:13:04.70,Default,,0,0,0,,Не?
Dialogue: 0,0:13:04.78,0:13:07.16,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:07.24,0:13:09.91,Default,,0,0,0,,Кейінірек, кейінірек, жылы...
Dialogue: 0,0:13:09.99,0:13:10.83,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:10.91,0:13:12.08,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:13:12.16,0:13:13.87,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:13.95,0:13:16.83,Default,,0,0,0,,Ах... Мм... Мен...
Dialogue: 0,0:13:16.92,0:13:19.00,Default,,0,0,0,,(Луидің айқайы)
Dialogue: 0,0:13:19.08,0:13:20.71,Default,,0,0,0,,Мен осында тағы біраз уақыт боламын.
Dialogue: 0,0:13:20.79,0:13:24.84,Default,,0,0,0,,(Луидің айқайы)
Dialogue: 0,0:13:27.76,0:13:31.68,Default,,0,0,0,,Бұл менің есімде бірінші рет көз жасым.
Dialogue: 0,0:13:32.64,0:13:35.35,Default,,0,0,0,,Бұл соншалықты тоқтаусыз ба?
Dialogue: 0,0:13:35.43,0:13:38.65,Default,,0,0,0,,Жылау қолайлы орта емес еді.
Dialogue: 0,0:13:38.73,0:13:42.44,Default,,0,0,0,,Күшті болу, аман қалу
Dialogue: 0,0:13:42.53,0:13:44.36,Default,,0,0,0,,Қайталанатын күнәлар
Dialogue: 0,0:13:44.44,0:13:45.95,Default,,0,0,0,,Соңында...
Dialogue: 0,0:13:46.57,0:13:49.45,Default,,0,0,0,,Асыл адамымды құрбан еттім.
Dialogue: 0,0:13:50.66,0:13:53.41,Default,,0,0,0,,Өйткені мен өте әлсізмін
Dialogue: 0,0:13:55.96,0:13:57.54,Default,,0,0,0,,Легоши
Dialogue: 0,0:13:58.37,0:13:59.96,Default,,0,0,0,,Сен мықтысың
Dialogue: 0,0:14:00.58,0:14:03.21,Default,,0,0,0,,Сіз Лизбен бір мәселені шешетін боласыз.
Dialogue: 0,0:14:03.30,0:14:06.01,Default,,0,0,0,,Менің оны тоқтатуға құқығым жоқ
Dialogue: 0,0:14:06.72,0:14:08.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:08.22,0:14:09.68,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:09.76,0:14:10.89,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:10.97,0:14:14.10,Default,,0,0,0,,Осындай басың айналса, өлетін шығарсың.
Dialogue: 0,0:14:14.18,0:14:16.98,Default,,0,0,0,,Мен оны енді көргім келмейді
Dialogue: 0,0:14:17.06,0:14:19.52,Default,,0,0,0,,Аяулы дос қайтыс болғанда
Dialogue: 0,0:14:20.31,0:14:21.90,Default,,0,0,0,,Мен де баламын
Dialogue: 0,0:14:21.98,0:14:24.78,Default,,0,0,0,,Артқы базарда сол торда әлі жылап отыр
Dialogue: 0,0:14:25.65,0:14:27.70,Default,,0,0,0,,Мен сені босатамын
Dialogue: 0,0:14:28.65,0:14:30.70,Default,,0,0,0,,Сіз енді боссыз.
Dialogue: 0,0:14:31.24,0:14:32.53,Default,,0,0,0,,Мен әлсіз емеспін
Dialogue: 0,0:14:33.70,0:14:34.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:35.20,0:14:36.75,Default,,0,0,0,,Легоши жеңіз
Dialogue: 0,0:14:36.83,0:14:38.62,Default,,0,0,0,,Күресуге күш жинаңыз
Dialogue: 0,0:14:38.71,0:14:39.92,Default,,0,0,0,,Не... не?
Dialogue: 0,0:14:40.54,0:14:42.59,Default,,0,0,0,,Мен де сенің өлгеніңді көргім келмейді.
Dialogue: 0,0:14:42.67,0:14:44.46,Default,,0,0,0,,Ұрыс алдында тез тамақтаныңыз
Dialogue: 0,0:14:44.55,0:14:47.38,Default,,0,0,0,,Әй... Мен ет жемей-ақ күшейгім келеді.
Dialogue: 0,0:14:47.46,0:14:48.47,Default,,0,0,0,,Мен жаттығып жүрмін.
Dialogue: 0,0:14:48.55,0:14:51.39,Default,,0,0,0,,Сіз шектеулер бар екенін білесіз.
Dialogue: 0,0:14:51.47,0:14:53.22,Default,,0,0,0,,Көптеген шағымдар бар.
Dialogue: 0,0:14:53.80,0:14:55.18,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:55.26,0:14:56.85,Default,,0,0,0,,Мен сенің сілекейіңді ағызамын
Dialogue: 0,0:14:59.73,0:15:01.65,Default,,0,0,0,,Бұл нөмір...
Dialogue: 0,0:15:01.73,0:15:03.40,Default,,0,0,0,,Бұл менің қарғысым
Dialogue: 0,0:15:05.07,0:15:08.32,Default,,0,0,0,,Қарғысты бұз, Легоши.
Dialogue: 0,0:15:10.20,0:15:12.45,Default,,0,0,0,,Бұл сұмдық, Луи-сенпай.
Dialogue: 0,0:15:12.53,0:15:16.74,Default,,0,0,0,,Бірақ Луи-сенпай ақыры әшкерелеген әлсіздік
Dialogue: 0,0:15:17.29,0:15:19.50,Default,,0,0,0,,Мен мұны қабылдауым керек...
Dialogue: 0,0:15:23.08,0:15:28.26,Default,,0,0,0,,«Сіз сұрағаныңыз үшін жедім» деген сылтау.
Dialogue: 0,0:15:28.34,0:15:31.34,Default,,0,0,0,,Мен қаламаймын, Луи-сенпай.
Dialogue: 0,0:15:32.30,0:15:34.51,Default,,0,0,0,,Етпен барлық байланысты кесіңіз
Dialogue: 0,0:15:34.60,0:15:40.98,Default,,0,0,0,,Мен зиянсыз қасқырға айналу жолын тұрақты түрде жасап келе жатқаныма сенемін.
Dialogue: 0,0:15:41.69,0:15:43.65,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,0:15:43.73,0:15:44.73,Default,,0,0,0,,(қабылдау дыбысы)
Dialogue: 0,0:15:45.44,0:15:48.78,Default,,0,0,0,,Мен Луи-сенпайды жегім келеді, сондықтан жеймін.
Dialogue: 0,0:15:49.36,0:15:51.40,Default,,0,0,0,,Бұл жағдайда дұрыс па?
Dialogue: 0,0:15:52.45,0:15:56.83,Default,,0,0,0,,Осымен келісе алсаңыз.
Dialogue: 0,0:15:57.95,0:15:59.33,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:15:59.41,0:16:01.79,Default,,0,0,0,,Оны ешқашан ысырап етпеңіз
Dialogue: 0,0:16:05.33,0:16:12.34,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:15.93,0:16:17.72,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:16:17.81,0:16:22.89,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:22.98,0:16:25.48,Default,,0,0,0,,Содан кейін... содан кейін...
Dialogue: 0,0:16:25.56,0:16:27.19,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:16:29.90,0:16:33.03,Default,,0,0,0,,Сіз не қажет болса да жасайсыз.
Dialogue: 0,0:16:33.11,0:16:36.66,Default,,0,0,0,,Сіз оны шынымен жедіңіз бе? Әлгі Луи-сенпай?
Dialogue: 0,0:16:37.37,0:16:39.16,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:16:39.24,0:16:42.41,Default,,0,0,0,,Луи-сенпай екеуің өте жақын едіңдер, солай емес пе?
Dialogue: 0,0:16:43.12,0:16:46.67,Default,,0,0,0,,Бірақ қазір сен де мен сияқтысың.
Dialogue: 0,0:16:47.29,0:16:50.21,Default,,0,0,0,,Луи-сенпай да көкте осылай деді.
Dialogue: 0,0:16:50.30,0:16:51.71,Default,,0,0,0,,Не болды? Егер айтатын сөзің болса, мен тыңдап тұрмын
Dialogue: 0,0:16:51.80,0:16:54.84,Default,,0,0,0,,Луи-сенпай осында.
Dialogue: 0,0:16:54.93,0:16:56.43,Default,,0,0,0,,Және…
Dialogue: 0,0:16:57.01,0:16:57.97,Default,,0,0,0,,Менің ішімде!
Dialogue: 0,0:16:58.05,0:17:01.02,Default,,0,0,0,,Жүр! легоши
Dialogue: 0,0:17:02.47,0:17:05.19,Default,,0,0,0,,Луи-сенпай, сенің бір бөлігің
Dialogue: 0,0:17:05.27,0:17:07.06,Default,,0,0,0,,Ол сіздің денеңізде өркендеп жатқаны сөзсіз.
Dialogue: 0,0:17:07.98,0:17:09.73,Default,,0,0,0,,Бұл тыйым салынған сиқыр сияқты
Dialogue: 0,0:17:09.82,0:17:13.53,Default,,0,0,0,,Мен бүгін кешке бұл сиқырды қолдана аламын.
Dialogue: 0,0:17:14.15,0:17:15.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:15.57,0:17:17.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:24.16,0:17:25.25,Default,,0,0,0,,Легоши
Dialogue: 0,0:17:26.87,0:17:28.63,Default,,0,0,0,,Батыр бол
Dialogue: 0,0:17:35.67,0:17:38.84,Default,,0,0,0,,Етқоректілер мен шөпқоректілер арасындағы байланыс
Dialogue: 0,0:17:39.80,0:17:42.89,Default,,0,0,0,,Менің достығым жауапсыз болды
Dialogue: 0,0:17:44.43,0:17:49.02,Default,,0,0,0,,Сондықтан мен оны кез келген ойдан күшті деп ойладым.
Dialogue: 0,0:17:49.77,0:17:50.61,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:17:51.77,0:17:57.86,Default,,0,0,0,,Олар жесе де, жесе де, бұл екеуінің арасындағы байланыс күшейе түседі...
Dialogue: 0,0:17:59.03,0:18:00.07,Default,,0,0,0,,Тем
Dialogue: 0,0:18:00.66,0:18:02.99,Default,,0,0,0,,Тіпті сен менімен сөйлескенде
Dialogue: 0,0:18:03.08,0:18:05.87,Default,,0,0,0,,Өлімнің қасында тұрғанымда да сол күлкіңді көрсеттің.
Dialogue: 0,0:18:06.91,0:18:12.84,Default,,0,0,0,,Тым болмаса, тірі кезінде айтқаным өзгерер ме еді?
Dialogue: 0,0:18:17.42,0:18:21.05,Default,,0,0,0,,«Рахмет, Тим.»
Dialogue: 0,0:18:24.56,0:18:30.56,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:18:35.86,0:18:36.69,Default,,0,0,0,,Эй
Dialogue: 0,0:18:37.61,0:18:39.66,Default,,0,0,0,,Лиз... Лиз!
Dialogue: 0,0:18:39.74,0:18:41.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:41.20,0:18:43.37,Default,,0,0,0,,Жыл таңы атқан сияқты.
Dialogue: 0,0:18:44.03,0:18:47.16,Default,,0,0,0,,Жаңа жыл құтты болсын
Dialogue: 0,0:18:47.25,0:18:49.71,Default,,0,0,0,,Дуэль кезінде не айтасыз?
Dialogue: 0,0:18:52.42,0:18:56.09,Default,,0,0,0,,Аха... Ахахахаха...
Dialogue: 0,0:18:56.17,0:18:59.17,Default,,0,0,0,,Сен жеңдің, Легоси-кун.
Dialogue: 0,0:18:59.26,0:19:00.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:00.97,0:19:06.68,Default,,0,0,0,,Бір жылдан бері жаралы жүрегім бүгін түнде қайта дем алды.
Dialogue: 0,0:19:07.47,0:19:09.60,Default,,0,0,0,,Ет жесең де
Dialogue: 0,0:19:09.69,0:19:13.19,Default,,0,0,0,,Осындай әдемі көзі бар адам бар ма?
Dialogue: 0,0:19:13.27,0:19:16.61,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:17.23,0:19:20.86,Default,,0,0,0,,Етқоректілер мен шөпқоректілердің шынайы достығы
Dialogue: 0,0:19:21.86,0:19:22.70,Default,,0,0,0,,Сәлем Лиз
Dialogue: 0,0:19:23.95,0:19:28.66,Default,,0,0,0,,Осындай жағдайда қандай сөздер айтуым керек?
Dialogue: 0,0:19:29.33,0:19:34.13,Default,,0,0,0,,Мәжбүрлі сөздер Басқа адамды қорқытатын сөздер...
Dialogue: 0,0:19:35.09,0:19:36.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:36.59,0:19:41.13,Default,,0,0,0,,Етқоректілерге енді сөздермен бетпе-бет келуге болмайды
Dialogue: 0,0:19:41.22,0:19:44.55,Default,,0,0,0,,Сіздің істегеніңіз кешірілмейді.
Dialogue: 0,0:19:45.43,0:19:48.39,Default,,0,0,0,,Сенің жалғыздығыңды байқай алмадым.
Dialogue: 0,0:19:48.47,0:19:50.02,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:50.64,0:19:52.06,Default,,0,0,0,,Луи-сенпай...
Dialogue: 0,0:19:52.14,0:19:52.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:53.06,0:19:55.36,Default,,0,0,0,,Аға
Dialogue: 0,0:19:55.44,0:19:57.07,Default,,0,0,0,,Ауруханаға асығыңыз...
Dialogue: 0,0:19:57.15,0:19:58.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:58.69,0:20:01.78,Default,,0,0,0,,Сонымен қатар, сыпайылық ретінде мынаны айтайын.
Dialogue: 0,0:20:03.45,0:20:04.78,Default,,0,0,0,,Луи Сенпай
Dialogue: 0,0:20:06.12,0:20:07.70,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:20:08.62,0:20:11.54,Default,,0,0,0,,Өмірімдегі алғашқы және соңғы ет сен болғаныңа қуаныштымын.
Dialogue: 0,0:20:13.87,0:20:15.13,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,0:20:15.75,0:20:19.59,Default,,0,0,0,,Мен араласқан етқоректілер
Dialogue: 0,0:20:19.67,0:20:23.88,Default,,0,0,0,,Сен менің өміріме осылай араласа бересің.
Dialogue: 0,0:20:23.97,0:20:25.51,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,0:20:27.05,0:20:28.35,Default,,0,0,0,,А... аа...
Dialogue: 0,0:20:28.43,0:20:30.72,Default,,0,0,0,,Бетіңізді дұрыстап сүртіңіз және күліңіз
Dialogue: 0,0:20:30.81,0:20:32.27,Default,,0,0,0,,Ол бұзақыға ұқсайды.
Dialogue: 0,0:20:32.35,0:20:34.52,Default,,0,0,0,,Хмм... аа... кешіріңіз.
Dialogue: 0,0:20:38.02,0:20:41.49,Default,,0,0,0,,Жегендердің әлсіздігі мен азабы
Dialogue: 0,0:20:42.57,0:20:45.74,Default,,0,0,0,,Етқоректілердің азуының қарғысы
Dialogue: 0,0:20:46.41,0:20:49.62,Default,,0,0,0,,Оны тек жыртқыштардың азу тістері шеше алды.
Dialogue: 0,0:20:50.66,0:20:52.16,Default,,0,0,0,,Бұл азу тіске...
Dialogue: 0,0:20:52.83,0:20:54.54,Default,,0,0,0,,Менің қарғысым ақыры жойылды.
Dialogue: 0,0:20:54.54,0:20:57.38,Default,,0,0,0,,Менің қарғысым ақыры жойылды.
Dialogue: 0,0:20:54.54,0:20:57.38,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:20:57.38,0:21:01.55,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:21:07.80,0:21:13.81,Default,,0,0,0,,♪～
Dialogue: 0,0:21:16.85,0:21:22.07,Default,,0,0,0,,Осыдан кейін Луи-сенпай ауруханаға жеткізіліп, аман қалды.
Dialogue: 0,0:21:22.94,0:21:26.74,Default,,0,0,0,,Лиз екеумізді өлтіруші ретінде қамауға алды.
Dialogue: 0,0:21:27.61,0:21:28.45,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:29.16,0:21:33.00,Default,,0,0,0,,Барлығының айғақтарының арқасында мен босатылдым.
Dialogue: 0,0:21:34.79,0:21:37.46,Default,,0,0,0,,Менің сотталған өмірім
Dialogue: 0,0:21:37.54,0:21:40.54,Default,,0,0,0,,Қиын болатын сияқты.
Dialogue: 0,0:21:41.67,0:21:45.63,Default,,0,0,0,,Хару-чанмен кездесу, Луи-сенпаймен кездесу
Dialogue: 0,0:21:45.72,0:21:50.35,Default,,0,0,0,,Өзіме таққан байларым – қазынам.
Dialogue: 0,0:21:51.97,0:21:54.22,Default,,0,0,0,,Хару-чан, көріп тұрсың ба.
Dialogue: 0,0:21:54.31,0:21:55.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:58.69,0:22:01.65,Default,,0,0,0,,Мен мектепті тастаймын.
Dialogue: 0,0:22:01.73,0:22:03.73,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:22:04.82,0:22:07.24,Default,,0,0,0,,Мен... Аударма... Эй...
Dialogue: 0,0:22:07.32,0:22:08.16,Default,,0,0,0,,Хаа…
Dialogue: 0,0:22:09.07,0:22:11.37,Default,,0,0,0,,Бұл өте жаман.
Dialogue: 0,0:22:11.45,0:22:13.58,Default,,0,0,0,,Бетімде тыртық көбейіп барады.
Dialogue: 0,0:22:14.29,0:22:16.66,Default,,0,0,0,,Сіз маған жұмыстан шығу себебін де айтпайсыз.
Dialogue: 0,0:22:16.75,0:22:19.88,Default,,0,0,0,,Ум... уһ, кешіріңіз.
Dialogue: 0,0:22:19.96,0:22:21.88,Default,,0,0,0,,Енді...
Dialogue: 0,0:22:21.96,0:22:25.34,Default,,0,0,0,,Мен сені уайымдаудан шаршадым, Легоши.
Dialogue: 0,0:22:25.42,0:22:26.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:28.26,0:22:31.64,Default,,0,0,0,,Бірақ мен өмірімді осылай өткіземін.
Dialogue: 0,0:22:32.22,0:22:35.39,Default,,0,0,0,,Құйрығымды бұлғап, бөтен болып өмір сүре аламын.
Dialogue: 0,0:22:36.73,0:22:38.85,Default,,0,0,0,,Әлемде әлі де көп нәрсе бар
Dialogue: 0,0:22:38.94,0:22:40.35,Default,,0,0,0,,Үйренетін нәрселер өте көп
Dialogue: 0,0:22:40.35,0:22:41.69,Default,,0,0,0,,Үйренетін нәрселер өте көп
Dialogue: 0,0:22:40.35,0:22:41.69,Default,,0,0,0,,Хаа…
Dialogue: 0,0:22:42.77,0:22:44.78,Default,,0,0,0,,Менің өмір жолымды табайық
Dialogue: 0,0:22:44.86,0:22:47.24,Default,,0,0,0,,Мен жігіт тауып аламын
Dialogue: 0,0:22:47.32,0:22:49.61,Default,,0,0,0,,Не, күте тұр... дұрыс.
Dialogue: 0,0:22:49.70,0:22:51.36,Default,,0,0,0,,''Дұрыс''
Dialogue: 0,0:22:51.45,0:22:53.24,Default,,0,0,0,,Сонымен не істеуіміз керек? Легоши-кун
Dialogue: 0,0:22:53.33,0:22:53.78,Default,,0,0,0,,Хмм... ``Мен не істеуім керек?''...
Dialogue: 0,0:22:53.78,0:22:55.20,Default,,0,0,0,,Хмм... ``Мен не істеуім керек?''... ~♪
Dialogue: 0,0:22:55.20,0:22:55.29,Default,,0,0,0,,～♪
Dialogue: 0,0:22:55.29,0:22:57.33,Default,,0,0,0,,~♪ Мен бұл туралы қазірден бастап ақырын ойлайтын боламын.
Dialogue: 0,0:22:57.33,0:22:57.41,Default,,0,0,0,,～♪
Dialogue: 0,0:22:57.41,0:22:59.79,Default,,0,0,0,,～♪ ``Ойлау''...
Dialogue: 0,0:23:01.29,0:23:07.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory