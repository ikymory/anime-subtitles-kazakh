Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:08.09,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.91,0:01:29.17,Default,,0,0,0,,～♪
Dialogue: 0,0:01:37.18,0:01:38.43,Default,,0,0,0,,Мен суретке түсемін
Dialogue: 0,0:01:38.51,0:01:39.34,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:39.43,0:01:40.85,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:40.93,0:01:43.26,Default,,0,0,0,,Жоқ, бұл керемет емес.
Dialogue: 0,0:01:43.35,0:01:45.35,Default,,0,0,0,,Хаха, сүйкімділік сүзгісін қолдануым керек пе?
Dialogue: 0,0:01:45.43,0:01:47.52,Default,,0,0,0,,Барыс аналығы 18 жаста
Dialogue: 0,0:01:45.43,0:01:47.52,Default,,0,0,0,,(Есек пен Шабдалы сөйлеседі)
Dialogue: 0,0:01:47.52,0:01:47.60,Default,,0,0,0,,(Есек пен Шабдалы сөйлеседі)
Dialogue: 0,0:01:47.60,0:01:50.36,Default,,0,0,0,,(Есек пен шабдалы сөйлеседі)
Dialogue: 0,0:01:47.60,0:01:50.36,Default,,0,0,0,,Бұл әлі де әсерлі кезең.
Dialogue: 0,0:01:50.36,0:01:50.44,Default,,0,0,0,,(Есек пен Шабдалы сөйлеседі)
Dialogue: 0,0:01:50.44,0:01:52.23,Default,,0,0,0,,(Есек пен Шабдалы сөйлеседі)
Dialogue: 0,0:01:50.44,0:01:52.23,Default,,0,0,0,,Сәлем, Печ-чан
Dialogue: 0,0:01:52.32,0:01:54.69,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:01:54.78,0:01:57.20,Default,,0,0,0,,Мүмкін сізге ұнамаған шығар?
Dialogue: 0,0:01:57.28,0:01:59.78,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:01:59.86,0:02:02.33,Default,,0,0,0,,О, шынымен бе? Бұл жақсы, бірақ
Dialogue: 0,0:02:03.58,0:02:05.08,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:02:05.16,0:02:07.54,Default,,0,0,0,,Шынымды айтсам, бұл ең нашар уақыт.
Dialogue: 0,0:02:07.62,0:02:09.83,Default,,0,0,0,,Қасқыр болсаң, түсінерсің.
Dialogue: 0,0:02:09.92,0:02:11.08,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:02:11.17,0:02:14.25,Default,,0,0,0,,Етқоректілер мен шөпқоректілерді бірге суретке түсірген дұрыс.
Dialogue: 0,0:02:14.34,0:02:16.55,Default,,0,0,0,,Бұл жақсы қабылданды.
Dialogue: 0,0:02:17.22,0:02:20.59,Default,,0,0,0,,Джуно көп жұмыс істеп жатқан сияқты «Аң кітабы»
Dialogue: 0,0:02:20.68,0:02:22.26,Default,,0,0,0,,Эххе
Dialogue: 0,0:02:22.35,0:02:26.35,Default,,0,0,0,,Бірақ мен шын тіл табысатын кейбір қыздармен ғана байланысамын.
Dialogue: 0,0:02:26.43,0:02:27.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:27.81,0:02:31.90,Default,,0,0,0,,Хмм... Бұл рас.
Dialogue: 0,0:02:31.98,0:02:37.82,Default,,0,0,0,,Ізбасарлары көп адамдардың барлығы шөпқоректілер.
Dialogue: 0,0:02:37.90,0:02:40.53,Default,,0,0,0,,Хмм, бұған көмектесу мүмкін емес.
Dialogue: 0,0:02:40.61,0:02:44.74,Default,,0,0,0,,Көптеген шөпқоректі жануарлар айналасындағылардың не көретініне алаңдайды.
Dialogue: 0,0:02:44.83,0:02:46.74,Default,,0,0,0,,Біз түсінбейміз...
Dialogue: 0,0:02:46.83,0:02:50.67,Default,,0,0,0,,Қорғаныс инстинкті жұмыс істеп тұрғандықтан ба деп ойлаймын.
Dialogue: 0,0:02:50.75,0:02:52.38,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:53.08,0:02:56.05,Default,,0,0,0,,Хехе, бірге суретке түсейік
Dialogue: 0,0:02:56.13,0:02:59.42,Default,,0,0,0,,Біз жыртқыштарға жолдастық керек.
Dialogue: 0,0:03:00.09,0:03:02.97,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:03:05.47,0:03:07.22,Default,,0,0,0,,Мен суретке түсіремін, иә.
Dialogue: 0,0:03:07.31,0:03:08.27,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:08.89,0:03:09.64,Default,,0,0,0,,Джуно... Мен қалай сендей жақсы боламын?
Dialogue: 0,0:03:09.64,0:03:10.48,Default,,0,0,0,,Джуно... Мен қалай сендей жақсы боламын?
Dialogue: 0,0:03:09.64,0:03:10.48,Default,,0,0,0,,Иә
Dialogue: 0,0:03:10.48,0:03:12.48,Default,,0,0,0,,Джуно... Мен қалай сендей жақсы боламын?
Dialogue: 0,0:03:12.48,0:03:13.06,Default,,0,0,0,,Джуно... Мен қалай сендей жақсы боламын?
Dialogue: 0,0:03:12.48,0:03:13.06,Default,,0,0,0,,Мен оны аңдар кітабына орналастырамын.
Dialogue: 0,0:03:13.06,0:03:13.69,Default,,0,0,0,,Мен оны аңдар кітабына орналастырамын.
Dialogue: 0,0:03:13.69,0:03:14.36,Default,,0,0,0,,Мен оны аңдар кітабына орналастырамын.
Dialogue: 0,0:03:13.69,0:03:14.36,Default,,0,0,0,,...дәлірек айтқанда, қорғаныс инстинкті дегеніміз не?
Dialogue: 0,0:03:14.36,0:03:16.94,Default,,0,0,0,,...дәлірек айтқанда, қорғаныс инстинкті дегеніміз не?
Dialogue: 0,0:03:17.03,0:03:19.07,Default,,0,0,0,,Барлығын жыртқыштарды кінәлауға болады.
Dialogue: 0,0:03:19.15,0:03:20.95,Default,,0,0,0,,Бұл мен жинаған нәрсе емес.
Dialogue: 0,0:03:21.03,0:03:22.95,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:03:22.95,0:03:23.28,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:03:22.95,0:03:23.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:23.28,0:03:23.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:23.36,0:03:24.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:23.36,0:03:24.03,Default,,0,0,0,,Барыс болып, әйел боп...
Dialogue: 0,0:03:24.03,0:03:25.66,Default,,0,0,0,,Барыс болып, әйел боп...
Dialogue: 0,0:03:25.66,0:03:26.53,Default,,0,0,0,,Барыс болып, әйел боп...
Dialogue: 0,0:03:25.66,0:03:26.53,Default,,0,0,0,,Аа, ол қазірдің өзінде «ұнайды».
Dialogue: 0,0:03:26.53,0:03:26.62,Default,,0,0,0,,Аа, ол қазірдің өзінде ''ұнайды''.
Dialogue: 0,0:03:26.62,0:03:28.16,Default,,0,0,0,,Аа, ол қазірдің өзінде "ұнайды".
Dialogue: 0,0:03:26.62,0:03:28.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:28.16,0:03:28.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:28.24,0:03:28.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:28.24,0:03:28.87,Default,,0,0,0,,Ахаха хехехе иә
Dialogue: 0,0:03:28.87,0:03:28.95,Default,,0,0,0,,Ахаха хехехе иә
Dialogue: 0,0:03:28.95,0:03:32.25,Default,,0,0,0,,Ахаха хехехе иә
Dialogue: 0,0:03:28.95,0:03:32.25,Default,,0,0,0,,Мен енді мұндай қарым-қатынасты қаламаймын!
Dialogue: 0,0:03:33.33,0:03:34.17,Default,,0,0,0,,Шабдалы-чан
Dialogue: 0,0:03:35.04,0:03:37.34,Default,,0,0,0,,Енді екеуіңмен бірге қыдырғыларың келе ме?
Dialogue: 0,0:03:37.42,0:03:38.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:38.80,0:03:40.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:40.30,0:03:42.63,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:03:42.72,0:03:44.09,Default,,0,0,0,,А...
Dialogue: 0,0:03:51.98,0:03:55.56,Default,,0,0,0,,Мен оны еріксіз шақырдым.
Dialogue: 0,0:03:55.65,0:04:00.07,Default,,0,0,0,,Сіз қорықпайсыз ба? Ол қамқор болды ма?
Dialogue: 0,0:04:00.15,0:04:03.53,Default,,0,0,0,,Мм... мен қыстық киімдерді қарай аламын ба?
Dialogue: 0,0:04:03.61,0:04:05.53,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:04:06.70,0:04:10.16,Default,,0,0,0,,А, бірақ ауа қатты.
Dialogue: 0,0:04:10.25,0:04:13.37,Default,,0,0,0,,Кешіріңіз, мен сізді бірден үйге жіберемін.
Dialogue: 0,0:04:14.67,0:04:16.63,Default,,0,0,0,,О... Әй, эй?
Dialogue: 0,0:04:16.71,0:04:17.67,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:17.75,0:04:19.84,Default,,0,0,0,,Керемет пропорциялар
Dialogue: 0,0:04:19.92,0:04:20.96,Default,,0,0,0,,Бұл үлгі ме?
Dialogue: 0,0:04:21.05,0:04:21.97,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:04:22.05,0:04:24.13,Default,,0,0,0,,Мүмкін емес Мүмкін емес Иә...
Dialogue: 0,0:04:24.22,0:04:26.59,Default,,0,0,0,,Шира-чан танымал, солай ма?
Dialogue: 0,0:04:26.68,0:04:28.26,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:04:28.35,0:04:30.14,Default,,0,0,0,,Жоқ, мен танымал емеспін.
Dialogue: 0,0:04:30.22,0:04:32.35,Default,,0,0,0,,Не? Бұл стильді және сәнді ме?
Dialogue: 0,0:04:32.43,0:04:33.27,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:33.35,0:04:34.77,Default,,0,0,0,,Хехе, жоқ...
Dialogue: 0,0:04:34.85,0:04:37.81,Default,,0,0,0,,Бұл дене пішіні енді тұлға емес.
Dialogue: 0,0:04:37.90,0:04:41.65,Default,,0,0,0,,Барлық қабыландардың бастары кішкентай, аяқтары ұзын, жіңішке.
Dialogue: 0,0:04:41.73,0:04:45.45,Default,,0,0,0,,Сонымен қатар мен өрнекті киім кие алмаймын.
Dialogue: 0,0:04:45.53,0:04:47.32,Default,,0,0,0,,Иә? неге?
Dialogue: 0,0:04:47.41,0:04:49.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:49.87,0:04:53.50,Default,,0,0,0,,Маған жараспайды, өйткені мен өзім өрнекті киім киемін.
Dialogue: 0,0:04:53.58,0:04:57.33,Default,,0,0,0,,Аа~ түсіндім.
Dialogue: 0,0:04:57.42,0:05:00.30,Default,,0,0,0,,Шира-чанның да уайымы бар.
Dialogue: 0,0:05:00.38,0:05:02.09,Default,,0,0,0,,Иә
Dialogue: 0,0:05:02.17,0:05:05.38,Default,,0,0,0,,Қарапайым киімді ғана таңдағанда қызықсыз.
Dialogue: 0,0:05:05.47,0:05:09.01,Default,,0,0,0,,Бұл жақсы. Таза ақ түсте бәрі жақсы көрінеді.
Dialogue: 0,0:05:09.10,0:05:10.14,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:05:10.22,0:05:12.14,Default,,0,0,0,,Мм... (Шабдалы) А?
Dialogue: 0,0:05:12.22,0:05:15.77,Default,,0,0,0,,Мен Печ-чанға жақсы көрінетінін таңдай аламын ба?
Dialogue: 0,0:05:15.85,0:05:17.10,Default,,0,0,0,,Иә? Бұл жақсы ма?
Dialogue: 0,0:05:17.19,0:05:18.69,Default,,0,0,0,,Әрине, әрине
Dialogue: 0,0:05:22.48,0:05:23.74,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:05:23.82,0:05:24.86,Default,,0,0,0,,Ах
Dialogue: 0,0:05:24.94,0:05:28.03,Default,,0,0,0,,Полиэстер жақсы емес, өйткені ол статикалық электр энергиясын шығарады.
Dialogue: 0,0:05:28.11,0:05:31.28,Default,,0,0,0,,Не? (Шабдалы) А... Мен жүнмін.
Dialogue: 0,0:05:31.37,0:05:35.29,Default,,0,0,0,,күрсіну... Ондай жағдай бар ма?
Dialogue: 0,0:05:35.37,0:05:38.12,Default,,0,0,0,,Ахахахха Екеумізге де қиын.
Dialogue: 0,0:05:38.21,0:05:39.46,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:05:39.54,0:05:40.38,Default,,0,0,0,,Әй, аудан жақсы ма?
Dialogue: 0,0:05:40.38,0:05:41.92,Default,,0,0,0,,Әй, аудан жақсы ма?
Dialogue: 0,0:05:40.38,0:05:41.92,Default,,0,0,0,,Шира-чан…
Dialogue: 0,0:05:42.00,0:05:45.01,Default,,0,0,0,,Мені таңдау үшін көп еңбек еттіңіз.
Dialogue: 0,0:05:42.00,0:05:45.01,Default,,0,0,0,,Эй, бұл сүйкімді емес пе?
Dialogue: 0,0:05:45.09,0:05:47.68,Default,,0,0,0,,Ах, бірақ бұл да жақсы көрінеді.
Dialogue: 0,0:05:47.76,0:05:51.76,Default,,0,0,0,,Сол кезде мен іштей қорқып кеттім.
Dialogue: 0,0:05:51.85,0:05:53.85,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:05:56.14,0:05:58.31,Default,,0,0,0,,Глушитель киюге әлі ерте емес пе?
Dialogue: 0,0:05:58.39,0:06:01.27,Default,,0,0,0,,Не, бұл сүйкімді, сондықтан мен оны тезірек кигім келді.
Dialogue: 0,0:06:01.36,0:06:02.40,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:06:04.94,0:06:06.11,Default,,0,0,0,,Шабдалы-чан (Шабдалы) Иә?
Dialogue: 0,0:06:06.19,0:06:07.45,Default,,0,0,0,,Бүгін қалайсың?
Dialogue: 0,0:06:07.53,0:06:08.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:08.45,0:06:10.49,Default,,0,0,0,,Әй, уау... ұмытып кетіппін.
Dialogue: 0,0:06:10.57,0:06:13.79,Default,,0,0,0,,Мен... сен оны жек көрмейсің бе?
Dialogue: 0,0:06:13.87,0:06:16.04,Default,,0,0,0,,Мм... суретке түсейік.
Dialogue: 0,0:06:16.12,0:06:17.71,Default,,0,0,0,,Менің алғашқы саяхатымды еске алу
Dialogue: 0,0:06:17.79,0:06:19.46,Default,,0,0,0,,Нихи
Dialogue: 0,0:06:19.54,0:06:21.00,Default,,0,0,0,,Мен суретке түсемін (Шабдалы) Иә.
Dialogue: 0,0:06:21.08,0:06:22.46,Default,,0,0,0,,Хмм... осы жерде ме?
Dialogue: 0,0:06:22.54,0:06:23.59,Default,,0,0,0,,Барайық (Шабдалы) Иә.
Dialogue: 0,0:06:23.67,0:06:24.96,Default,,0,0,0,,Иә (ысырма дыбысы)
Dialogue: 0,0:06:25.05,0:06:27.42,Default,,0,0,0,,Маған ұзақ жету өте ұнайды.
Dialogue: 0,0:06:27.51,0:06:28.72,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:06:28.80,0:06:31.30,Default,,0,0,0,,Ах... бірақ
Dialogue: 0,0:06:31.39,0:06:34.97,Default,,0,0,0,,Бұл әдемі фото, сондықтан оны бәріне көрсету босқа кетеді.
Dialogue: 0,0:06:35.06,0:06:36.22,Default,,0,0,0,,Уа, тоқтайсың ба?
Dialogue: 0,0:06:36.31,0:06:38.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:38.56,0:06:39.77,Default,,0,0,0,,Оны ақырында жариялаңыз
Dialogue: 0,0:06:39.85,0:06:41.31,Default,,0,0,0,,Қазірдің өзінде! (Шабдалы) Әйте
Dialogue: 0,0:06:41.40,0:06:43.86,Default,,0,0,0,,(Дельфин мен Шабдалы күлкісі)
Dialogue: 0,0:06:43.94,0:06:44.77,Default,,0,0,0,,«Ұнады»
Dialogue: 0,0:06:44.86,0:06:45.86,Default,,0,0,0,,Ой, ерте.
Dialogue: 0,0:06:45.94,0:06:47.32,Default,,0,0,0,,(Дельфин мен Шабдалы күлкісі)
Dialogue: 0,0:06:47.40,0:06:48.74,Default,,0,0,0,,Әлі ерте емес пе?
Dialogue: 0,0:06:48.82,0:06:53.74,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:06:54.70,0:06:56.08,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:06:56.16,0:06:57.29,Default,,0,0,0,,Бұл жаңбыр бизнесті арттырады.
Dialogue: 0,0:06:57.29,0:06:58.58,Default,,0,0,0,,Бұл жаңбыр бизнесті арттырады.
Dialogue: 0,0:06:57.29,0:06:58.58,Default,,0,0,0,,(гиена ыңылайды)
Dialogue: 0,0:06:58.66,0:07:00.41,Default,,0,0,0,,Ол шіріп кетеді
Dialogue: 0,0:07:07.00,0:07:08.88,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:07:08.97,0:07:12.51,Default,,0,0,0,,(сорғыш сүйектердің дыбысы)
Dialogue: 0,0:07:16.26,0:07:17.22,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:18.18,0:07:19.64,Default,,0,0,0,,Бұл жолақты гиена.
Dialogue: 0,0:07:19.64,0:07:20.31,Default,,0,0,0,,Бұл жолақты гиена.
Dialogue: 0,0:07:19.64,0:07:20.31,Default,,0,0,0,,Ух... Аон
Dialogue: 0,0:07:20.31,0:07:20.39,Default,,0,0,0,,Ух... Аон
Dialogue: 0,0:07:20.39,0:07:22.44,Default,,0,0,0,,Ух... Аон
Dialogue: 0,0:07:20.39,0:07:22.44,Default,,0,0,0,,Бұл әдеттегі ет жейтін улану.
Dialogue: 0,0:07:22.44,0:07:23.19,Default,,0,0,0,,Бұл әдеттегі ет жейтін улану.
Dialogue: 0,0:07:23.27,0:07:25.65,Default,,0,0,0,,Сүйегім сынды, бірақ
Dialogue: 0,0:07:25.73,0:07:28.94,Default,,0,0,0,,Өлтіруден ләззат алуды үйренген гиена.
Dialogue: 0,0:07:29.03,0:07:31.40,Default,,0,0,0,,Жақ сүйегінің күші өлшеусіз
Dialogue: 0,0:07:31.99,0:07:36.37,Default,,0,0,0,,Мен жасай алатын ең жақсы нәрсе - алмада тіс іздерін қалдыру ...
Dialogue: 0,0:07:36.45,0:07:39.54,Default,,0,0,0,,Мен өз денемді мүлде түсінбеймін
Dialogue: 0,0:07:41.04,0:07:42.75,Default,,0,0,0,,Менің ойымша, бұл 2016 жыл.
Dialogue: 0,0:07:42.83,0:07:45.42,Default,,0,0,0,,О? Сізге ұнамайды ма?
Dialogue: 0,0:07:46.00,0:07:48.30,Default,,0,0,0,,Сіздің иегіңіз әлсіреп қалды.
Dialogue: 0,0:07:48.38,0:07:51.38,Default,,0,0,0,,Бұл ет зазен жаттығуларының сәтті өткенінің дәлелі.
Dialogue: 0,0:07:51.47,0:07:52.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:52.43,0:07:53.26,Default,,0,0,0,,Эй
Dialogue: 0,0:07:53.93,0:07:55.01,Default,,0,0,0,,Бұл кезде
Dialogue: 0,0:07:55.09,0:07:58.18,Default,,0,0,0,,Біреуді өз қолыммен өлтірмесем, көңілім толмайды.
Dialogue: 0,0:07:58.26,0:08:00.77,Default,,0,0,0,,Жәбірленушінің сүйектерін тістеуді жалғастырыңыз
Dialogue: 0,0:08:00.85,0:08:02.98,Default,,0,0,0,,Келесі мақсатты табыңыз
Dialogue: 0,0:08:04.48,0:08:06.48,Default,,0,0,0,,Жарайды, мен түсіремін.
Dialogue: 0,0:08:06.56,0:08:07.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.48,0:08:09.32,Default,,0,0,0,,Менің ауруханама осындай нәрсені лақтырыңыз.
Dialogue: 0,0:08:09.40,0:08:11.90,Default,,0,0,0,,Менің жұмысым сені оңалту.
Dialogue: 0,0:08:12.57,0:08:15.66,Default,,0,0,0,,Легоши, менің саған бір сұрағым бар.
Dialogue: 0,0:08:15.74,0:08:16.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.53,0:08:20.79,Default,,0,0,0,,Менің иегімнің әлсірегенін байқадым
Dialogue: 0,0:08:20.87,0:08:22.41,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:08:22.50,0:08:23.75,Default,,0,0,0,,Сіз депрессиядасыз ба?
Dialogue: 0,0:08:23.83,0:08:26.13,Default,,0,0,0,,Е... жоқ...
Dialogue: 0,0:08:26.21,0:08:28.29,Default,,0,0,0,,Бір қызығы, олай емес.
Dialogue: 0,0:08:28.38,0:08:29.42,Default,,0,0,0,,Иә
Dialogue: 0,0:08:29.50,0:08:30.96,Default,,0,0,0,,Бұл сізге жақсы.
Dialogue: 0,0:08:31.05,0:08:32.17,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:08:32.26,0:08:33.97,Default,,0,0,0,,Жоқ... жоқ... а... бұл
Dialogue: 0,0:08:34.05,0:08:36.64,Default,,0,0,0,,Ааа аааа аааа...
Dialogue: 0,0:08:36.72,0:08:38.30,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:08:38.39,0:08:39.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:39.85,0:08:41.27,Default,,0,0,0,,Те...
Dialogue: 0,0:08:41.35,0:08:42.18,Default,,0,0,0,,Ей!
Dialogue: 0,0:08:42.27,0:08:45.02,Default,,0,0,0,,Бұл мысық емес, сондықтан қона алмайды.
Dialogue: 0,0:08:45.10,0:08:46.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:46.60,0:08:48.06,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:08:48.15,0:08:50.69,Default,,0,0,0,,（）
Dialogue: 0,0:08:50.78,0:08:54.40,Default,,0,0,0,,Фу~! Бұл жас иттің иісіне ұқсайды.
Dialogue: 0,0:08:55.07,0:08:56.70,Default,,0,0,0,,Бұл жағдайда...
Dialogue: 0,0:08:57.37,0:08:59.58,Default,,0,0,0,,Ит етін қолдануға бола ма?
Dialogue: 0,0:08:59.66,0:09:01.49,Default,,0,0,0,,Ах хехехе
Dialogue: 0,0:09:01.58,0:09:02.62,Default,,0,0,0,,«Шоқусай»…
Dialogue: 0,0:09:03.87,0:09:05.00,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:09:12.26,0:09:13.34,Default,,0,0,0,,Ах~
Dialogue: 0,0:09:13.42,0:09:17.59,Default,,0,0,0,,Аа, шөпқоректіні өлтіру қиын.
Dialogue: 0,0:09:17.68,0:09:21.85,Default,,0,0,0,,Өйткені ол жігіттердің қолдары мен аяқтары шынымен күшті.
Dialogue: 0,0:09:21.93,0:09:23.64,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:09:23.72,0:09:28.06,Default,,0,0,0,,Менің ойымша, олар біздің тістерімізге қарсы тұру үшін...
Dialogue: 0,0:09:28.69,0:09:30.82,Default,,0,0,0,,Егер байсалды болсақ
Dialogue: 0,0:09:31.73,0:09:33.23,Default,,0,0,0,,Бұл ойын емес!
Dialogue: 0,0:09:33.32,0:09:35.07,Default,,0,0,0,,Уггааааа (шағу дыбысы)
Dialogue: 0,0:09:35.15,0:09:36.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:36.82,0:09:39.57,Default,,0,0,0,,(Гена күлді)
Dialogue: 0,0:09:49.83,0:09:51.42,Default,,0,0,0,,Мфффффффф...
Dialogue: 0,0:09:52.42,0:09:54.34,Default,,0,0,0,,Ммм... уф...
Dialogue: 0,0:09:54.42,0:09:56.26,Default,,0,0,0,,Қаттылық…
Dialogue: 0,0:09:57.34,0:09:59.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:59.97,0:10:03.51,Default,,0,0,0,,Мен... аяқ-қолдарды көремін?
Dialogue: 0,0:10:04.14,0:10:07.27,Default,,0,0,0,,Азу тістері... ну... шықпайды.
Dialogue: 0,0:10:07.35,0:10:10.23,Default,,0,0,0,,Неліктен азу тістері ашылған жыртқыштың беті ашылады?
Dialogue: 0,0:10:10.31,0:10:11.77,Default,,0,0,0,,Менің ойымша, бәрі бірдей болады
Dialogue: 0,0:10:11.86,0:10:15.57,Default,,0,0,0,,Тіршілік үшін күресетін шөпқоректілердің аяқ-қолдарында,
Dialogue: 0,0:10:15.65,0:10:16.99,Default,,0,0,0,,Сезімдері бар
Dialogue: 0,0:10:17.07,0:10:18.24,Default,,0,0,0,,Уф! Ахх...
Dialogue: 0,0:10:18.32,0:10:20.41,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:10:22.87,0:10:25.33,Default,,0,0,0,,Эмоцияларыңызды аяқ-қолдарыңызға қалдырыңыз
Dialogue: 0,0:10:26.20,0:10:28.25,Default,,0,0,0,,Маған азу тістері керек емес
Dialogue: 0,0:10:29.96,0:10:31.42,Default,,0,0,0,,Ха! Ахх...
Dialogue: 0,0:10:40.72,0:10:42.09,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:10:43.14,0:10:44.93,Default,,0,0,0,,Мен ит емеспін
Dialogue: 0,0:10:49.06,0:10:50.39,Default,,0,0,0,,Бұл қасқыр.
Dialogue: 0,0:10:52.65,0:10:53.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.69,0:10:57.44,Default,,0,0,0,,Мен басты кейіпкермін бе, Адлер?
Dialogue: 0,0:10:57.53,0:11:01.45,Default,,0,0,0,,А... Мен бірінші курс студентімін, ал мен қызбын, солай ма?
Dialogue: 0,0:11:01.53,0:11:02.37,Default,,0,0,0,,Неге...
Dialogue: 0,0:11:02.45,0:11:04.49,Default,,0,0,0,,Сондықтан Джуно
Dialogue: 0,0:11:04.58,0:11:07.54,Default,,0,0,0,,Осы уақытқа дейін ер адамдар Адлердің рөлін ерлікпен ойнады.
Dialogue: 0,0:11:07.62,0:11:09.21,Default,,0,0,0,,Әйелдің орындауы арқылы
Dialogue: 0,0:11:09.29,0:11:13.29,Default,,0,0,0,,Біз драма үйірмесінің табандылығы мен бүлікшіл рухын көрсетеміз.
Dialogue: 0,0:11:13.92,0:11:17.92,Default,,0,0,0,,Клубтың басқа түрлері де бұрынғыдан да жақсы нәтижелерге қол жеткізуге тырысады.
Dialogue: 0,0:11:18.01,0:11:20.76,Default,,0,0,0,,Жаңа жылдық қойылымда қолымыздан келгенін жасайық.
Dialogue: 0,0:11:21.47,0:11:22.43,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:22.51,0:11:26.22,Default,,0,0,0,,А... Осыны айтып тұрсың ба?
Dialogue: 0,0:11:26.31,0:11:28.72,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:11:28.81,0:11:32.02,Default,,0,0,0,,Джуно солай айтады деп ойладым.
Dialogue: 0,0:11:32.85,0:11:35.27,Default,,0,0,0,,Фуфуфуфуфу…
Dialogue: 0,0:11:35.36,0:11:38.82,Default,,0,0,0,,Олардың әрекеттерін тоқтату ересектерге байланысты.
Dialogue: 0,0:11:38.90,0:11:40.44,Default,,0,0,0,,Алдын алу керек
Dialogue: 0,0:11:40.53,0:11:42.61,Default,,0,0,0,,Мектептер де өзгерді, солай емес пе?
Dialogue: 0,0:11:42.70,0:11:43.61,Default,,0,0,0,,Етқоректілер мен шөпқоректілер бірлесе білім алу керек екенін бәрі түсінді.
Dialogue: 0,0:11:43.61,0:11:45.07,Default,,0,0,0,,Етқоректілер мен шөпқоректілер бірлесе білім алу керек екенін бәрі түсінді.
Dialogue: 0,0:11:43.61,0:11:45.07,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:11:45.07,0:11:46.41,Default,,0,0,0,,Етқоректілер мен шөпқоректілер бірлесе білім алу керек екенін бәрі түсінді.
Dialogue: 0,0:11:46.49,0:11:47.49,Default,,0,0,0,,Сәлем Джуно
Dialogue: 0,0:11:48.49,0:11:49.79,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:11:49.87,0:11:51.33,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:51.41,0:11:52.87,Default,,0,0,0,,Өйткені, біз бар күшімізді салуымыз керек.
Dialogue: 0,0:11:52.96,0:11:53.83,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:11:53.92,0:11:55.38,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:55.46,0:11:57.38,Default,,0,0,0,,Бөлек мектеп жақсы.
Dialogue: 0,0:11:57.46,0:11:59.46,Default,,0,0,0,,Неліктен бәрі түсінбейді?
Dialogue: 0,0:11:59.55,0:12:03.80,Default,,0,0,0,,Бізге қашықтық керек. Бізге қашықтық керек...
Dialogue: 0,0:12:07.22,0:12:09.22,Default,,0,0,0,,Ах Джуно Ах...
Dialogue: 0,0:12:09.31,0:12:12.14,Default,,0,0,0,,Біз сізді қолдауға бар күшімізді саламыз.
Dialogue: 0,0:12:12.23,0:12:14.23,Default,,0,0,0,,Хехе, бір жылдың ішінде басты кейіпкер болу ғажап.
Dialogue: 0,0:12:14.31,0:12:17.31,Default,,0,0,0,,Иә... Рахмет
Dialogue: 0,0:12:17.40,0:12:19.11,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:12:19.19,0:12:22.11,Default,,0,0,0,,Мен бұған қуаныштымын.
Dialogue: 0,0:12:22.19,0:12:26.16,Default,,0,0,0,,Егер сіз мейіріммен күлсеңіз, қашықтықты сақтай аласыз.
Dialogue: 0,0:12:26.24,0:12:30.29,Default,,0,0,0,,Шөпқоректілерге қатысты неге бәрі тыныш бола алмайды?
Dialogue: 0,0:12:30.37,0:12:32.79,Default,,0,0,0,,Қатнасым жоқ деп айтуыңыз тым ашық, сондықтан оған сену мүмкін емес!
Dialogue: 0,0:12:33.71,0:12:34.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:35.92,0:12:38.88,Default,,0,0,0,,Міне болды! Мен сонда болдым... Мен сонда болдым
Dialogue: 0,0:12:38.96,0:12:42.17,Default,,0,0,0,,Мені алаңдататын жалғыз шөпқоректі жануар...
Dialogue: 0,0:12:43.17,0:12:48.39,Default,,0,0,0,,Легоши-сенпай, бұл шынымен де сенің түрің.
Dialogue: 0,0:12:52.81,0:12:56.77,Default,,0,0,0,,Ол соншалықты кішкентай болса да, ол әрқашан жалғыз әрекет етеді
Dialogue: 0,0:12:58.19,0:13:00.65,Default,,0,0,0,,Достарың жоқ па?
Dialogue: 0,0:13:04.70,0:13:09.20,Default,,0,0,0,,Бау-бақша бөлімі? Мен оның бар екенін де білмедім
Dialogue: 0,0:13:09.28,0:13:10.62,Default,,0,0,0,,Ол жыртылған.
Dialogue: 0,0:13:10.70,0:13:11.66,Default,,0,0,0,,А...
Dialogue: 0,0:13:11.74,0:13:13.16,Default,,0,0,0,,Ах
Dialogue: 0,0:13:13.25,0:13:17.67,Default,,0,0,0,,О, сен бе? Мен бұл Легоси-кун деп ойладым.
Dialogue: 0,0:13:17.75,0:13:20.25,Default,,0,0,0,,Қадамдардың салмағы ұқсас
Dialogue: 0,0:13:20.34,0:13:22.09,Default,,0,0,0,,Бұл соншалықты ауыр емес.
Dialogue: 0,0:13:22.17,0:13:23.42,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,0:13:23.51,0:13:25.88,Default,,0,0,0,,А, менің атым көрінбейді.
Dialogue: 0,0:13:25.97,0:13:28.76,Default,,0,0,0,,Бірақ мен түсіндім, сен Легоси-кунмен жақсы доссың, солай ма?
Dialogue: 0,0:13:28.84,0:13:29.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:29.76,0:13:32.72,Default,,0,0,0,,Сіз сияқты жақсы емес
Dialogue: 0,0:13:32.81,0:13:34.68,Default,,0,0,0,,Қасқыр-чан... Мм...
Dialogue: 0,0:13:34.77,0:13:35.89,Default,,0,0,0,,Юно
Dialogue: 0,0:13:35.98,0:13:37.44,Default,,0,0,0,,Джуно-чан
Dialogue: 0,0:13:37.52,0:13:39.40,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:13:39.48,0:13:42.15,Default,,0,0,0,,Менің атым Хал. Мен өз атымды бұрын айттым ба?
Dialogue: 0,0:13:42.23,0:13:44.36,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:13:44.44,0:13:48.28,Default,,0,0,0,,Жоқ... Мен тіпті білмеймін.
Dialogue: 0,0:13:48.36,0:13:50.24,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:13:50.32,0:13:51.70,Default,,0,0,0,,Аа, күте тұрыңыз, а...
Dialogue: 0,0:13:53.12,0:13:56.29,Default,,0,0,0,,Уфуфуфуфуфуфуфуфу…
Dialogue: 0,0:14:00.63,0:14:01.54,Default,,0,0,0,,Уау, жауын құрты
Dialogue: 0,0:14:01.63,0:14:04.63,Default,,0,0,0,,Әй, мені өлтірме, мені тірі қалдыр.
Dialogue: 0,0:14:04.71,0:14:05.67,Default,,0,0,0,,А...
Dialogue: 0,0:14:05.76,0:14:07.42,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:07.51,0:14:09.26,Default,,0,0,0,,Эй, осы күйіңде мәңгі қалсаң қалай?
Dialogue: 0,0:14:09.34,0:14:12.01,Default,,0,0,0,,Мен оны қабылдайды деп ойламадым.
Dialogue: 0,0:14:12.76,0:14:14.35,Default,,0,0,0,,Бір нәрсе айтыңыз...
Dialogue: 0,0:14:14.43,0:14:18.69,Default,,0,0,0,,Сіз сұрағанда бас тарта алмайтын азу тістерді қалай ұстау керектігін білесіз.
Dialogue: 0,0:14:18.77,0:14:20.56,Default,,0,0,0,,Мен күрек әкелемін.
Dialogue: 0,0:14:21.52,0:14:25.07,Default,,0,0,0,,Хаа... Мен не істеп жатырмын?
Dialogue: 0,0:14:27.07,0:14:29.95,Default,,0,0,0,,Бір ғана жануармен бау-бақша клубы
Dialogue: 0,0:14:30.03,0:14:34.95,Default,,0,0,0,,Бұл менмендік Легоси-сенпайды тартудың кілті ме?
Dialogue: 0,0:14:35.58,0:14:37.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:37.16,0:14:39.50,Default,,0,0,0,,Тағы біраз... Уф.
Dialogue: 0,0:14:39.58,0:14:40.42,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:14:41.83,0:14:43.59,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:14:43.67,0:14:45.63,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:45.71,0:14:49.38,Default,,0,0,0,,Баспалдақпен жүріңіз! Бұл дәл сіздің алдыңызда
Dialogue: 0,0:14:49.47,0:14:52.47,Default,,0,0,0,,Немесе маған қоңырау шалыңыз
Dialogue: 0,0:14:52.55,0:14:54.68,Default,,0,0,0,,Жоғарыдан құласаң, өлесің.
Dialogue: 0,0:14:54.76,0:14:57.77,Default,,0,0,0,,Иә... өйткені мен сені күттіргім келмейді.
Dialogue: 0,0:14:57.85,0:15:01.44,Default,,0,0,0,,Жарайды, менің жағым үнемі желіде.
Dialogue: 0,0:15:01.52,0:15:04.06,Default,,0,0,0,,Өз өміріңізге қауіп төндірмеңіз
Dialogue: 0,0:15:04.15,0:15:05.73,Default,,0,0,0,,Ахх...
Dialogue: 0,0:15:06.86,0:15:12.11,Default,,0,0,0,,Кіп-кішкентай, жалғыз кете алмайтын Харумен осылай таныстым.
Dialogue: 0,0:15:12.20,0:15:14.58,Default,,0,0,0,,Легоши-сенпайға да тиді ме?
Dialogue: 0,0:15:15.87,0:15:16.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:16.79,0:15:17.91,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:15:18.00,0:15:21.04,Default,,0,0,0,,Джуно мырза, мені қызықтырды ма?
Dialogue: 0,0:15:21.12,0:15:24.08,Default,,0,0,0,,Не? Жоқ... жоқ, мен олай айтқым келмейді.
Dialogue: 0,0:15:24.17,0:15:27.71,Default,,0,0,0,,хехехе әзіл әзіл
Dialogue: 0,0:15:27.80,0:15:29.76,Default,,0,0,0,,Оның әңгімесі жақсы.
Dialogue: 0,0:15:29.84,0:15:32.93,Default,,0,0,0,,Мен қазір қыздармен сөйлескеніме қуаныштымын.
Dialogue: 0,0:15:38.89,0:15:40.89,Default,,0,0,0,,Иә, жартысын илеңіз
Dialogue: 0,0:15:45.73,0:15:50.53,Default,,0,0,0,,Дәл қазір менің ішімде неше сезім айнып тұр?
Dialogue: 0,0:15:51.61,0:15:55.28,Default,,0,0,0,,Мен білгім келмеді.
Dialogue: 0,0:15:55.37,0:15:57.95,Default,,0,0,0,,Шөпқоректілердің сүйкімділігі неде?
Dialogue: 0,0:15:59.16,0:16:01.21,Default,,0,0,0,,Бөлек мектеп жақсырақ
Dialogue: 0,0:16:01.29,0:16:04.79,Default,,0,0,0,,Өйткені, мен жыртқыштар мен шөпқоректілердің бір-бірінен ажырағанын қалаймын.
Dialogue: 0,0:16:04.88,0:16:06.34,Default,,0,0,0,,Бұл сіздің аузыңызда.
Dialogue: 0,0:16:06.42,0:16:07.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:08.25,0:16:11.67,Default,,0,0,0,,Мен оны енді ала алмаймын...
Dialogue: 0,0:16:14.72,0:16:18.68,Default,,0,0,0,,Енді мен нақты себебін білдім
Dialogue: 0,0:16:19.47,0:16:24.77,Default,,0,0,0,,Өйткені етқоректілер шөпқоректілерге тең келмейді.
Dialogue: 0,0:16:26.90,0:16:28.44,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:16:28.52,0:16:30.94,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:16:32.49,0:16:35.03,Default,,0,0,0,,Жоқ, I
Dialogue: 0,0:16:35.11,0:16:37.74,Default,,0,0,0,,«Beastar» кемесі мүлде емес
Dialogue: 0,0:16:38.99,0:16:42.87,Default,,0,0,0,,Біз Луи-сенпай сияқты тең нәсілге айналуымыз мүмкін емес.
Dialogue: 0,0:16:42.96,0:16:45.42,Default,,0,0,0,,Бұл мен үшін мүмкін емес.
Dialogue: 0,0:16:47.63,0:16:49.38,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:16:50.17,0:16:51.34,Default,,0,0,0,,Сен Луи-сенпайдың қайда екенін білесің бе?
Dialogue: 0,0:16:51.34,0:16:52.46,Default,,0,0,0,,Сен Луи-сенпайдың қайда екенін білесің бе?
Dialogue: 0,0:16:51.34,0:16:52.46,Default,,0,0,0,,А...
Dialogue: 0,0:16:52.55,0:16:54.76,Default,,0,0,0,,Луи, сен білесің бе?
Dialogue: 0,0:16:54.84,0:16:57.43,Default,,0,0,0,,Мен сені ойладым.
Dialogue: 0,0:16:57.51,0:16:59.68,Default,,0,0,0,,Менімен дереу хабарласыңыз
Dialogue: 0,0:17:00.39,0:17:01.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:04.44,0:17:09.27,Default,,0,0,0,,Тағдырымды ұлдардай ренжіткенше.
Dialogue: 0,0:17:11.07,0:17:12.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:17.07,0:17:19.70,Default,,0,0,0,,Луи тамақ ішкенде дәмді бола ма?
Dialogue: 0,0:17:19.78,0:17:21.74,Default,,0,0,0,,Шөпқоректілердің арасындағы қара қалжың ба?
Dialogue: 0,0:17:21.83,0:17:23.66,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:17:23.75,0:17:24.87,Default,,0,0,0,,Бұл күлкілі ме?
Dialogue: 0,0:17:26.08,0:17:27.88,Default,,0,0,0,,Егер мен жыртқыш болсам
Dialogue: 0,0:17:27.96,0:17:30.71,Default,,0,0,0,,Менің ойымша, Хару сөзсіз жақсырақ көрінеді.
Dialogue: 0,0:17:31.55,0:17:34.09,Default,,0,0,0,,Міне, хехехехехехе
Dialogue: 0,0:17:34.17,0:17:37.51,Default,,0,0,0,,Мен Луидің жыртқыш екенін елестете алмаймын.
Dialogue: 0,0:17:38.64,0:17:39.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:40.89,0:17:43.85,Default,,0,0,0,,Екеуіміздің қолдарымыз нәзік, жұмсақ.
Dialogue: 0,0:17:45.14,0:17:48.48,Default,,0,0,0,,Екеуміздің де дәм тататынымызға сенімдімін.
Dialogue: 0,0:17:49.94,0:17:53.11,Default,,0,0,0,,Мен жеңілдеп қалдым, біз әлсіз адамдармыз
Dialogue: 0,0:17:55.82,0:17:58.57,Default,,0,0,0,,Бастық... Бастық!
Dialogue: 0,0:17:58.66,0:18:00.07,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:18:00.16,0:18:01.91,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:18:02.58,0:18:03.66,Default,,0,0,0,,О
Dialogue: 0,0:18:03.74,0:18:07.04,Default,,0,0,0,,Мен Харуды армандағаныма біраз болды.
Dialogue: 0,0:18:07.12,0:18:09.17,Default,,0,0,0,,Неліктен бұл уақыт?
Dialogue: 0,0:18:09.79,0:18:15.13,Default,,0,0,0,,Мен шөпқоректі еттің сатылып жатқанын енді сезбеймін.
Dialogue: 0,0:18:15.21,0:18:19.64,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:18:19.72,0:18:22.81,Default,,0,0,0,,Оны шынымен емдеуге бола ма?
Dialogue: 0,0:18:22.89,0:18:24.01,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:18:24.10,0:18:27.02,Default,,0,0,0,,«Құбыжық медицинаның» әсері өте зор.
Dialogue: 0,0:18:27.10,0:18:29.39,Default,,0,0,0,,Тапсырыс берушінің де жолы болды.
Dialogue: 0,0:18:29.48,0:18:31.98,Default,,0,0,0,,Кайман денелері сирек кездеседі
Dialogue: 0,0:18:32.06,0:18:34.32,Default,,0,0,0,,Бұл бұрынғыдай күдікті.
Dialogue: 0,0:18:34.40,0:18:35.78,Default,,0,0,0,,Эй, аа...
Dialogue: 0,0:18:35.86,0:18:37.32,Default,,0,0,0,,Бизнеске араласу жақсы емес.
Dialogue: 0,0:18:37.40,0:18:38.24,Default,,0,0,0,,А... иә
Dialogue: 0,0:18:38.32,0:18:39.61,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:39.70,0:18:42.07,Default,,0,0,0,,Мен мұнда келдім, өйткені ингредиенттер жабайы болды.
Dialogue: 0,0:18:42.16,0:18:43.83,Default,,0,0,0,,Сіз тынышсыз, солай емес пе?
Dialogue: 0,0:18:43.91,0:18:47.79,Default,,0,0,0,,Ой... Мен де ақша алғым келгендіктен осылай істеп жатырмын.
Dialogue: 0,0:18:47.87,0:18:51.92,Default,,0,0,0,,Өмір сүруді жалғастыру үшін жеткілікті орынды алып тастаңыз.
Dialogue: 0,0:18:52.00,0:18:54.29,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:18:54.38,0:18:57.26,Default,,0,0,0,,Жасың нешеде? Ингредиенттер
Dialogue: 0,0:18:57.34,0:18:59.13,Default,,0,0,0,,Ах… 37.
Dialogue: 0,0:18:59.22,0:19:00.55,Default,,0,0,0,,Кейбір жағдайларға байланысты мен несие ақшасын пайдалануды шештім.
Dialogue: 0,0:19:00.55,0:19:01.76,Default,,0,0,0,,Егер жағдай болып, мен ақшамды несиеге салсам,
Dialogue: 0,0:19:00.55,0:19:01.76,Default,,0,0,0,,Позицияны өзгертудің бұрмалануы…
Dialogue: 0,0:19:01.76,0:19:01.84,Default,,0,0,0,,Позицияны өзгертудің бұрмалануы…
Dialogue: 0,0:19:01.84,0:19:02.97,Default,,0,0,0,,Позицияны өзгертудің бұрмалануы…
Dialogue: 0,0:19:01.84,0:19:02.97,Default,,0,0,0,,Мен кептеліп қалдым
Dialogue: 0,0:19:02.97,0:19:03.05,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:19:03.05,0:19:04.01,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:19:03.05,0:19:04.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:04.10,0:19:07.39,Default,,0,0,0,,Түсіндім, сен жассың...
Dialogue: 0,0:19:09.14,0:19:10.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:11.56,0:19:17.90,Default,,0,0,0,,Менің төменгі денем соңғы 10 жыл бойы сал болып, қозғала алмаймын.
Dialogue: 0,0:19:17.99,0:19:21.24,Default,,0,0,0,,Өлім алдында бір рет
Dialogue: 0,0:19:21.32,0:19:24.37,Default,,0,0,0,,Мен отбасылық өмірімді қалпына келтіргім келеді
Dialogue: 0,0:19:24.45,0:19:25.45,Default,,0,0,0,,А...
Dialogue: 0,0:19:25.53,0:19:26.45,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:19:26.54,0:19:29.04,Default,,0,0,0,,Хмм... (Дәрігер) Жыныс мүшелерін алуға дайынсыз ба?
Dialogue: 0,0:19:29.12,0:19:31.83,Default,,0,0,0,,Иә, жарайды... күте тұрыңыз, сіз жаңа ғана не айттыңыз?
Dialogue: 0,0:19:31.92,0:19:33.33,Default,,0,0,0,,Анестезия... Уау...
Dialogue: 0,0:19:33.42,0:19:34.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:34.54,0:19:38.59,Default,,0,0,0,,Ибуки, қазір сенде қандай ата-ана махаббаты бар?
Dialogue: 0,0:19:34.54,0:19:38.59,Default,,0,0,0,,(Кайманның айқайы)
Dialogue: 0,0:19:38.59,0:19:38.67,Default,,0,0,0,,(Кайманның айқайы)
Dialogue: 0,0:19:38.67,0:19:41.26,Default,,0,0,0,,(Кайманның айқайы)
Dialogue: 0,0:19:38.67,0:19:41.26,Default,,0,0,0,,Бала кезімде болған Аназурадан әлдеқайда жақсы.
Dialogue: 0,0:19:41.26,0:19:41.72,Default,,0,0,0,,Бала кезімде болған Аназурадан әлдеқайда жақсы.
Dialogue: 0,0:19:41.80,0:19:48.47,Default,,0,0,0,,(Кайманның айқайы)
Dialogue: 0,0:19:53.90,0:19:58.78,Default,,0,0,0,,Олардың бәрі қоғамнан алшақтайтын әлсіз адамдар.
Dialogue: 0,0:19:59.86,0:20:01.32,Default,,0,0,0,,Босс
Dialogue: 0,0:20:01.40,0:20:04.66,Default,,0,0,0,,Өзіңізді лақтырудан аулақ болыңыз.
Dialogue: 0,0:20:04.74,0:20:07.66,Default,,0,0,0,,Суицид? неге мен
Dialogue: 0,0:20:12.83,0:20:14.42,Default,,0,0,0,,Бұл күлкілі, солай емес пе?
Dialogue: 0,0:20:14.50,0:20:16.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:16.13,0:20:19.92,Default,,0,0,0,,Лай судың дәмін сен де, мен де білеміз.
Dialogue: 0,0:20:20.80,0:20:25.39,Default,,0,0,0,,Бір жануар ғана қашып, осы уақытқа дейін жетті.
Dialogue: 0,0:20:26.93,0:20:28.31,Default,,0,0,0,,Біз ұқсаспыз
Dialogue: 0,0:20:33.48,0:20:37.02,Default,,0,0,0,,Мен тірі жем ретінде сатылған бала едім
Dialogue: 0,0:20:37.11,0:20:39.94,Default,,0,0,0,,Енді «артқы нарыққа» назар аудармайды
Dialogue: 0,0:20:41.57,0:20:43.32,Default,,0,0,0,,Мен бұрыннан білуім керек еді
Dialogue: 0,0:20:43.32,0:20:44.36,Default,,0,0,0,,Мен бұрыннан білуім керек еді
Dialogue: 0,0:20:43.32,0:20:44.36,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:44.36,0:20:46.32,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:46.32,0:20:49.41,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:46.32,0:20:49.41,Default,,0,0,0,,Дәл қазір мен бүкіл денемде шындық сезімін сезінемін.
Dialogue: 0,0:20:50.24,0:20:55.00,Default,,0,0,0,,Әлсіз өмір салты қаншалықты күнә?
Dialogue: 0,0:21:00.71,0:21:01.55,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:21:02.34,0:21:04.30,Default,,0,0,0,,Суықпа, Ибуки
Dialogue: 0,0:21:04.88,0:21:05.97,Default,,0,0,0,,Ішкім келеді ме?
Dialogue: 0,0:21:06.64,0:21:08.51,Default,,0,0,0,,Мен сенімен таңға дейін боламын.
Dialogue: 0,0:21:09.05,0:21:14.18,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:21:17.19,0:21:18.52,Default,,0,0,0,,Польнарефф!
Dialogue: 0,0:21:22.03,0:21:28.03,Default,,0,0,0,,♪～
Dialogue: 0,0:22:42.23,0:22:48.24,Default,,0,0,0,,～♪
