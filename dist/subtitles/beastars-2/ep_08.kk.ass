Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.09,0:00:18.10,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.92,0:01:39.18,Default,,0,0,0,,～♪
Dialogue: 0,0:01:47.19,0:01:48.44,Default,,0,0,0,,Мен суретке түсемін
Dialogue: 0,0:01:48.52,0:01:49.35,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:49.44,0:01:50.86,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:50.94,0:01:53.27,Default,,0,0,0,,Жоқ, бұл керемет емес.
Dialogue: 0,0:01:53.36,0:01:55.36,Default,,0,0,0,,Хаха, сүйкімділік сүзгісін қолдануым керек пе?
Dialogue: 0,0:01:55.44,0:01:57.53,Default,,0,0,0,,Барыс аналығы 18 жаста
Dialogue: 0,0:01:55.44,0:01:57.53,Default,,0,0,0,,(Есек пен Шабдалы сөйлеседі)
Dialogue: 0,0:01:57.53,0:01:57.61,Default,,0,0,0,,(Есек пен Шабдалы сөйлеседі)
Dialogue: 0,0:01:57.61,0:02:00.37,Default,,0,0,0,,(Есек пен шабдалы сөйлеседі)
Dialogue: 0,0:01:57.61,0:02:00.37,Default,,0,0,0,,Бұл әлі де әсерлі кезең.
Dialogue: 0,0:02:00.37,0:02:00.45,Default,,0,0,0,,(Есек пен Шабдалы сөйлеседі)
Dialogue: 0,0:02:00.45,0:02:02.24,Default,,0,0,0,,(Есек пен Шабдалы сөйлеседі)
Dialogue: 0,0:02:00.45,0:02:02.24,Default,,0,0,0,,Сәлем, Печ-чан
Dialogue: 0,0:02:02.33,0:02:04.70,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:02:04.79,0:02:07.21,Default,,0,0,0,,Мүмкін сізге ұнамаған шығар?
Dialogue: 0,0:02:07.29,0:02:09.79,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:02:09.87,0:02:12.34,Default,,0,0,0,,О, шынымен бе? Бұл жақсы, бірақ
Dialogue: 0,0:02:13.59,0:02:15.09,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:02:15.17,0:02:17.55,Default,,0,0,0,,Шынымды айтсам, бұл ең нашар уақыт.
Dialogue: 0,0:02:17.63,0:02:19.84,Default,,0,0,0,,Қасқыр болсаң, түсінерсің.
Dialogue: 0,0:02:19.93,0:02:21.09,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:02:21.18,0:02:24.26,Default,,0,0,0,,Етқоректілер мен шөпқоректілерді бірге суретке түсірген дұрыс.
Dialogue: 0,0:02:24.35,0:02:26.56,Default,,0,0,0,,Бұл жақсы қабылданды.
Dialogue: 0,0:02:27.23,0:02:30.60,Default,,0,0,0,,Джуно көп жұмыс істеп жатқан сияқты «Аң кітабы»
Dialogue: 0,0:02:30.69,0:02:32.27,Default,,0,0,0,,Эххе
Dialogue: 0,0:02:32.36,0:02:36.36,Default,,0,0,0,,Бірақ мен шын тіл табысатын кейбір қыздармен ғана байланысамын.
Dialogue: 0,0:02:36.44,0:02:37.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:37.82,0:02:41.91,Default,,0,0,0,,Хмм... Бұл рас.
Dialogue: 0,0:02:41.99,0:02:47.83,Default,,0,0,0,,Ізбасарлары көп адамдардың барлығы шөпқоректілер.
Dialogue: 0,0:02:47.91,0:02:50.54,Default,,0,0,0,,Хмм, бұған көмектесу мүмкін емес.
Dialogue: 0,0:02:50.62,0:02:54.75,Default,,0,0,0,,Көптеген шөпқоректі жануарлар айналасындағылардың не көретініне алаңдайды.
Dialogue: 0,0:02:54.84,0:02:56.75,Default,,0,0,0,,Біз түсінбейміз...
Dialogue: 0,0:02:56.84,0:03:00.68,Default,,0,0,0,,Қорғаныс инстинкті жұмыс істеп тұрғандықтан ба деп ойлаймын.
Dialogue: 0,0:03:00.76,0:03:02.39,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:03.09,0:03:06.06,Default,,0,0,0,,Хехе, бірге суретке түсейік
Dialogue: 0,0:03:06.14,0:03:09.43,Default,,0,0,0,,Біз жыртқыштарға жолдастық керек.
Dialogue: 0,0:03:10.10,0:03:12.98,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:03:15.48,0:03:17.23,Default,,0,0,0,,Мен суретке түсіремін, иә.
Dialogue: 0,0:03:17.32,0:03:18.28,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:18.90,0:03:19.65,Default,,0,0,0,,Джуно... Мен қалай сендей жақсы боламын?
Dialogue: 0,0:03:19.65,0:03:20.49,Default,,0,0,0,,Джуно... Мен қалай сендей жақсы боламын?
Dialogue: 0,0:03:19.65,0:03:20.49,Default,,0,0,0,,Иә
Dialogue: 0,0:03:20.49,0:03:22.49,Default,,0,0,0,,Джуно... Мен қалай сендей жақсы боламын?
Dialogue: 0,0:03:22.49,0:03:23.07,Default,,0,0,0,,Джуно... Мен қалай сендей жақсы боламын?
Dialogue: 0,0:03:22.49,0:03:23.07,Default,,0,0,0,,Мен оны аңдар кітабына орналастырамын.
Dialogue: 0,0:03:23.07,0:03:23.70,Default,,0,0,0,,Мен оны аңдар кітабына орналастырамын.
Dialogue: 0,0:03:23.70,0:03:24.37,Default,,0,0,0,,Мен оны аңдар кітабына орналастырамын.
Dialogue: 0,0:03:23.70,0:03:24.37,Default,,0,0,0,,...дәлірек айтқанда, қорғаныс инстинкті дегеніміз не?
Dialogue: 0,0:03:24.37,0:03:26.95,Default,,0,0,0,,...дәлірек айтқанда, қорғаныс инстинкті дегеніміз не?
Dialogue: 0,0:03:27.04,0:03:29.08,Default,,0,0,0,,Барлығын жыртқыштарды кінәлауға болады.
Dialogue: 0,0:03:29.16,0:03:30.96,Default,,0,0,0,,Бұл мен жинаған нәрсе емес.
Dialogue: 0,0:03:31.04,0:03:32.96,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:03:32.96,0:03:33.29,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:03:32.96,0:03:33.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:33.29,0:03:33.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:33.37,0:03:34.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:33.37,0:03:34.04,Default,,0,0,0,,Барыс болып, әйел боп...
Dialogue: 0,0:03:34.04,0:03:35.67,Default,,0,0,0,,Барыс болып, әйел боп...
Dialogue: 0,0:03:35.67,0:03:36.54,Default,,0,0,0,,Барыс болып, әйел боп...
Dialogue: 0,0:03:35.67,0:03:36.54,Default,,0,0,0,,Аа, ол қазірдің өзінде «ұнайды».
Dialogue: 0,0:03:36.54,0:03:36.63,Default,,0,0,0,,Аа, ол қазірдің өзінде ''ұнайды''.
Dialogue: 0,0:03:36.63,0:03:38.17,Default,,0,0,0,,Аа, ол қазірдің өзінде "ұнайды".
Dialogue: 0,0:03:36.63,0:03:38.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:38.17,0:03:38.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:38.25,0:03:38.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:38.25,0:03:38.88,Default,,0,0,0,,Ахаха хехехе иә
Dialogue: 0,0:03:38.88,0:03:38.96,Default,,0,0,0,,Ахаха хехехе иә
Dialogue: 0,0:03:38.96,0:03:42.26,Default,,0,0,0,,Ахаха хехехе иә
Dialogue: 0,0:03:38.96,0:03:42.26,Default,,0,0,0,,Мен енді мұндай қарым-қатынасты қаламаймын!
Dialogue: 0,0:03:43.34,0:03:44.18,Default,,0,0,0,,Шабдалы-чан
Dialogue: 0,0:03:45.05,0:03:47.35,Default,,0,0,0,,Енді екеуіңмен бірге қыдырғыларың келе ме?
Dialogue: 0,0:03:47.43,0:03:48.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:48.81,0:03:50.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:50.31,0:03:52.64,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:03:52.73,0:03:54.10,Default,,0,0,0,,А...
Dialogue: 0,0:04:01.99,0:04:05.57,Default,,0,0,0,,Мен оны еріксіз шақырдым.
Dialogue: 0,0:04:05.66,0:04:10.08,Default,,0,0,0,,Сіз қорықпайсыз ба? Ол қамқор болды ма?
Dialogue: 0,0:04:10.16,0:04:13.54,Default,,0,0,0,,Мм... мен қыстық киімдерді қарай аламын ба?
Dialogue: 0,0:04:13.62,0:04:15.54,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:04:16.71,0:04:20.17,Default,,0,0,0,,А, бірақ ауа қатты.
Dialogue: 0,0:04:20.26,0:04:23.38,Default,,0,0,0,,Кешіріңіз, мен сізді бірден үйге жіберемін.
Dialogue: 0,0:04:24.68,0:04:26.64,Default,,0,0,0,,О... Әй, эй?
Dialogue: 0,0:04:26.72,0:04:27.68,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:27.76,0:04:29.85,Default,,0,0,0,,Керемет пропорциялар
Dialogue: 0,0:04:29.93,0:04:30.97,Default,,0,0,0,,Бұл үлгі ме?
Dialogue: 0,0:04:31.06,0:04:31.98,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:04:32.06,0:04:34.14,Default,,0,0,0,,Мүмкін емес Мүмкін емес Иә...
Dialogue: 0,0:04:34.23,0:04:36.60,Default,,0,0,0,,Шира-чан танымал, солай ма?
Dialogue: 0,0:04:36.69,0:04:38.27,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:04:38.36,0:04:40.15,Default,,0,0,0,,Жоқ, мен танымал емеспін.
Dialogue: 0,0:04:40.23,0:04:42.36,Default,,0,0,0,,Не? Бұл стильді және сәнді ме?
Dialogue: 0,0:04:42.44,0:04:43.28,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:43.36,0:04:44.78,Default,,0,0,0,,Хехе, жоқ...
Dialogue: 0,0:04:44.86,0:04:47.82,Default,,0,0,0,,Бұл дене пішіні енді тұлға емес.
Dialogue: 0,0:04:47.91,0:04:51.66,Default,,0,0,0,,Барлық қабыландардың бастары кішкентай, аяқтары ұзын, жіңішке.
Dialogue: 0,0:04:51.74,0:04:55.46,Default,,0,0,0,,Сонымен қатар мен өрнекті киім кие алмаймын.
Dialogue: 0,0:04:55.54,0:04:57.33,Default,,0,0,0,,Иә? неге?
Dialogue: 0,0:04:57.42,0:04:59.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:59.88,0:05:03.51,Default,,0,0,0,,Маған жараспайды, өйткені мен өзім өрнекті киім киемін.
Dialogue: 0,0:05:03.59,0:05:07.34,Default,,0,0,0,,Аа~ түсіндім.
Dialogue: 0,0:05:07.43,0:05:10.31,Default,,0,0,0,,Шира-чанның да уайымы бар.
Dialogue: 0,0:05:10.39,0:05:12.10,Default,,0,0,0,,Иә
Dialogue: 0,0:05:12.18,0:05:15.39,Default,,0,0,0,,Қарапайым киімді ғана таңдағанда қызықсыз.
Dialogue: 0,0:05:15.48,0:05:19.02,Default,,0,0,0,,Бұл жақсы. Таза ақ түсте бәрі жақсы көрінеді.
Dialogue: 0,0:05:19.11,0:05:20.15,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:05:20.23,0:05:22.15,Default,,0,0,0,,Мм... (Шабдалы) А?
Dialogue: 0,0:05:22.23,0:05:25.78,Default,,0,0,0,,Мен Печ-чанға жақсы көрінетінін таңдай аламын ба?
Dialogue: 0,0:05:25.86,0:05:27.11,Default,,0,0,0,,Иә? Бұл жақсы ма?
Dialogue: 0,0:05:27.20,0:05:28.70,Default,,0,0,0,,Әрине, әрине
Dialogue: 0,0:05:32.49,0:05:33.75,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:05:33.83,0:05:34.87,Default,,0,0,0,,Ах
Dialogue: 0,0:05:34.95,0:05:38.04,Default,,0,0,0,,Полиэстер жақсы емес, өйткені ол статикалық электр энергиясын шығарады.
Dialogue: 0,0:05:38.12,0:05:41.29,Default,,0,0,0,,Не? (Шабдалы) А... Мен жүнмін.
Dialogue: 0,0:05:41.38,0:05:45.30,Default,,0,0,0,,күрсіну... Ондай жағдай бар ма?
Dialogue: 0,0:05:45.38,0:05:48.13,Default,,0,0,0,,Ахахахха Екеумізге де қиын.
Dialogue: 0,0:05:48.22,0:05:49.47,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:05:49.55,0:05:50.39,Default,,0,0,0,,Әй, аудан жақсы ма?
Dialogue: 0,0:05:50.39,0:05:51.93,Default,,0,0,0,,Әй, аудан жақсы ма?
Dialogue: 0,0:05:50.39,0:05:51.93,Default,,0,0,0,,Шира-чан…
Dialogue: 0,0:05:52.01,0:05:55.02,Default,,0,0,0,,Мені таңдау үшін көп еңбек еттіңіз.
Dialogue: 0,0:05:52.01,0:05:55.02,Default,,0,0,0,,Эй, бұл сүйкімді емес пе?
Dialogue: 0,0:05:55.10,0:05:57.69,Default,,0,0,0,,Ах, бірақ бұл да жақсы көрінеді.
Dialogue: 0,0:05:57.77,0:06:01.77,Default,,0,0,0,,Сол кезде мен іштей қорқып кеттім.
Dialogue: 0,0:06:01.86,0:06:03.86,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:06:06.15,0:06:08.32,Default,,0,0,0,,Глушитель киюге әлі ерте емес пе?
Dialogue: 0,0:06:08.40,0:06:11.28,Default,,0,0,0,,Не, бұл сүйкімді, сондықтан мен оны тезірек кигім келді.
Dialogue: 0,0:06:11.37,0:06:12.41,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:06:14.95,0:06:16.12,Default,,0,0,0,,Шабдалы-чан (Шабдалы) Иә?
Dialogue: 0,0:06:16.20,0:06:17.46,Default,,0,0,0,,Бүгін қалайсың?
Dialogue: 0,0:06:17.54,0:06:18.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:18.46,0:06:20.50,Default,,0,0,0,,Әй, уау... ұмытып кетіппін.
Dialogue: 0,0:06:20.58,0:06:23.80,Default,,0,0,0,,Мен... сен оны жек көрмейсің бе?
Dialogue: 0,0:06:23.88,0:06:26.05,Default,,0,0,0,,Мм... суретке түсейік.
Dialogue: 0,0:06:26.13,0:06:27.72,Default,,0,0,0,,Менің алғашқы саяхатымды еске алу
Dialogue: 0,0:06:27.80,0:06:29.47,Default,,0,0,0,,Нихи
Dialogue: 0,0:06:29.55,0:06:31.01,Default,,0,0,0,,Мен суретке түсемін (Шабдалы) Иә.
Dialogue: 0,0:06:31.09,0:06:32.47,Default,,0,0,0,,Хмм... осы жерде ме?
Dialogue: 0,0:06:32.55,0:06:33.60,Default,,0,0,0,,Барайық (Шабдалы) Иә.
Dialogue: 0,0:06:33.68,0:06:34.97,Default,,0,0,0,,Иә (ысырма дыбысы)
Dialogue: 0,0:06:35.06,0:06:37.43,Default,,0,0,0,,Маған ұзақ жету өте ұнайды.
Dialogue: 0,0:06:37.52,0:06:38.73,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:06:38.81,0:06:41.31,Default,,0,0,0,,Ах... бірақ
Dialogue: 0,0:06:41.40,0:06:44.98,Default,,0,0,0,,Бұл әдемі фото, сондықтан оны бәріне көрсету босқа кетеді.
Dialogue: 0,0:06:45.07,0:06:46.23,Default,,0,0,0,,Уа, тоқтайсың ба?
Dialogue: 0,0:06:46.32,0:06:48.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:48.57,0:06:49.78,Default,,0,0,0,,Оны ақырында жариялаңыз
Dialogue: 0,0:06:49.86,0:06:51.32,Default,,0,0,0,,Қазірдің өзінде! (Шабдалы) Әйте
Dialogue: 0,0:06:51.41,0:06:53.87,Default,,0,0,0,,(Дельфин мен Шабдалы күлкісі)
Dialogue: 0,0:06:53.95,0:06:54.78,Default,,0,0,0,,«Ұнады»
Dialogue: 0,0:06:54.87,0:06:55.87,Default,,0,0,0,,Ой, ерте.
Dialogue: 0,0:06:55.95,0:06:57.33,Default,,0,0,0,,(Дельфин мен Шабдалы күлкісі)
Dialogue: 0,0:06:57.41,0:06:58.75,Default,,0,0,0,,Әлі ерте емес пе?
Dialogue: 0,0:06:58.83,0:07:03.75,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:07:04.71,0:07:06.09,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:07:06.17,0:07:07.30,Default,,0,0,0,,Бұл жаңбыр бизнесті арттырады.
Dialogue: 0,0:07:07.30,0:07:08.59,Default,,0,0,0,,Бұл жаңбыр бизнесті арттырады.
Dialogue: 0,0:07:07.30,0:07:08.59,Default,,0,0,0,,(гиена ыңылайды)
Dialogue: 0,0:07:08.67,0:07:10.42,Default,,0,0,0,,Ол шіріп кетеді
Dialogue: 0,0:07:17.01,0:07:18.89,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:07:18.98,0:07:22.52,Default,,0,0,0,,(сорғыш сүйектердің дыбысы)
Dialogue: 0,0:07:26.27,0:07:27.23,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:28.19,0:07:29.65,Default,,0,0,0,,Бұл жолақты гиена.
Dialogue: 0,0:07:29.65,0:07:30.32,Default,,0,0,0,,Бұл жолақты гиена.
Dialogue: 0,0:07:29.65,0:07:30.32,Default,,0,0,0,,Ух... Аон
Dialogue: 0,0:07:30.32,0:07:30.40,Default,,0,0,0,,Ух... Аон
Dialogue: 0,0:07:30.40,0:07:32.45,Default,,0,0,0,,Ух... Аон
Dialogue: 0,0:07:30.40,0:07:32.45,Default,,0,0,0,,Бұл әдеттегі ет жейтін улану.
Dialogue: 0,0:07:32.45,0:07:33.20,Default,,0,0,0,,Бұл әдеттегі ет жейтін улану.
Dialogue: 0,0:07:33.28,0:07:35.66,Default,,0,0,0,,Сүйегім сынды, бірақ
Dialogue: 0,0:07:35.74,0:07:38.95,Default,,0,0,0,,Өлтіруден ләззат алуды үйренген гиена.
Dialogue: 0,0:07:39.04,0:07:41.41,Default,,0,0,0,,Жақ сүйегінің күші өлшеусіз
Dialogue: 0,0:07:42.00,0:07:46.38,Default,,0,0,0,,Мен жасай алатын ең жақсы нәрсе - алмада тіс іздерін қалдыру ...
Dialogue: 0,0:07:46.46,0:07:49.55,Default,,0,0,0,,Мен өз денемді мүлде түсінбеймін
Dialogue: 0,0:07:51.05,0:07:52.76,Default,,0,0,0,,Менің ойымша, бұл 2016 жыл.
Dialogue: 0,0:07:52.84,0:07:55.43,Default,,0,0,0,,О? Сізге ұнамайды ма?
Dialogue: 0,0:07:56.01,0:07:58.31,Default,,0,0,0,,Сіздің иегіңіз әлсіреп қалды.
Dialogue: 0,0:07:58.39,0:08:01.39,Default,,0,0,0,,Бұл ет зазен жаттығуларының сәтті өткенінің дәлелі.
Dialogue: 0,0:08:01.48,0:08:02.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.44,0:08:03.27,Default,,0,0,0,,Эй
Dialogue: 0,0:08:03.94,0:08:05.02,Default,,0,0,0,,Бұл кезде
Dialogue: 0,0:08:05.10,0:08:08.19,Default,,0,0,0,,Біреуді өз қолыммен өлтірмесем, көңілім толмайды.
Dialogue: 0,0:08:08.27,0:08:10.78,Default,,0,0,0,,Жәбірленушінің сүйектерін тістеуді жалғастырыңыз
Dialogue: 0,0:08:10.86,0:08:12.99,Default,,0,0,0,,Келесі мақсатты табыңыз
Dialogue: 0,0:08:14.49,0:08:16.49,Default,,0,0,0,,Жарайды, мен түсіремін.
Dialogue: 0,0:08:16.57,0:08:17.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.49,0:08:19.33,Default,,0,0,0,,Менің ауруханама осындай нәрсені лақтырыңыз.
Dialogue: 0,0:08:19.41,0:08:21.91,Default,,0,0,0,,Менің жұмысым сені оңалту.
Dialogue: 0,0:08:22.58,0:08:25.67,Default,,0,0,0,,Легоши, менің саған бір сұрағым бар.
Dialogue: 0,0:08:25.75,0:08:26.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:27.54,0:08:30.80,Default,,0,0,0,,Менің иегімнің әлсірегенін байқадым
Dialogue: 0,0:08:30.88,0:08:32.42,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:08:32.51,0:08:33.76,Default,,0,0,0,,Сіз депрессиядасыз ба?
Dialogue: 0,0:08:33.84,0:08:36.14,Default,,0,0,0,,Е... жоқ...
Dialogue: 0,0:08:36.22,0:08:38.30,Default,,0,0,0,,Бір қызығы, олай емес.
Dialogue: 0,0:08:38.39,0:08:39.43,Default,,0,0,0,,Иә
Dialogue: 0,0:08:39.51,0:08:40.97,Default,,0,0,0,,Бұл сізге жақсы.
Dialogue: 0,0:08:41.06,0:08:42.18,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:08:42.27,0:08:43.98,Default,,0,0,0,,Жоқ... жоқ... а... бұл
Dialogue: 0,0:08:44.06,0:08:46.65,Default,,0,0,0,,Ааа аааа аааа...
Dialogue: 0,0:08:46.73,0:08:48.31,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:08:48.40,0:08:49.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:49.86,0:08:51.28,Default,,0,0,0,,Те...
Dialogue: 0,0:08:51.36,0:08:52.19,Default,,0,0,0,,Ей!
Dialogue: 0,0:08:52.28,0:08:55.03,Default,,0,0,0,,Бұл мысық емес, сондықтан қона алмайды.
Dialogue: 0,0:08:55.11,0:08:56.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:56.61,0:08:58.07,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:08:58.16,0:09:00.70,Default,,0,0,0,,（）
Dialogue: 0,0:09:00.79,0:09:04.41,Default,,0,0,0,,Фу~! Бұл жас иттің иісіне ұқсайды.
Dialogue: 0,0:09:05.08,0:09:06.71,Default,,0,0,0,,Бұл жағдайда...
Dialogue: 0,0:09:07.38,0:09:09.59,Default,,0,0,0,,Ит етін қолдануға бола ма?
Dialogue: 0,0:09:09.67,0:09:11.50,Default,,0,0,0,,Ах хехехе
Dialogue: 0,0:09:11.59,0:09:12.63,Default,,0,0,0,,«Шоқусай»…
Dialogue: 0,0:09:13.88,0:09:15.01,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:09:22.27,0:09:23.35,Default,,0,0,0,,Ах~
Dialogue: 0,0:09:23.43,0:09:27.60,Default,,0,0,0,,Аа, шөпқоректіні өлтіру қиын.
Dialogue: 0,0:09:27.69,0:09:31.86,Default,,0,0,0,,Өйткені ол жігіттердің қолдары мен аяқтары шынымен күшті.
Dialogue: 0,0:09:31.94,0:09:33.65,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:09:33.73,0:09:38.07,Default,,0,0,0,,Менің ойымша, олар біздің тістерімізге қарсы тұру үшін...
Dialogue: 0,0:09:38.70,0:09:40.83,Default,,0,0,0,,Егер байсалды болсақ
Dialogue: 0,0:09:41.74,0:09:43.24,Default,,0,0,0,,Бұл ойын емес!
Dialogue: 0,0:09:43.33,0:09:45.08,Default,,0,0,0,,Уггааааа (шағу дыбысы)
Dialogue: 0,0:09:45.16,0:09:46.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:46.83,0:09:49.58,Default,,0,0,0,,(Гена күлді)
Dialogue: 0,0:09:59.84,0:10:01.43,Default,,0,0,0,,Мфффффффф...
Dialogue: 0,0:10:02.43,0:10:04.35,Default,,0,0,0,,Ммм... уф...
Dialogue: 0,0:10:04.43,0:10:06.27,Default,,0,0,0,,Қаттылық…
Dialogue: 0,0:10:07.35,0:10:09.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:09.98,0:10:13.52,Default,,0,0,0,,Мен... аяқ-қолдарды көремін?
Dialogue: 0,0:10:14.15,0:10:17.28,Default,,0,0,0,,Азу тістері... ну... шықпайды.
Dialogue: 0,0:10:17.36,0:10:20.24,Default,,0,0,0,,Неліктен азу тістері ашылған жыртқыштың беті ашылады?
Dialogue: 0,0:10:20.32,0:10:21.78,Default,,0,0,0,,Менің ойымша, бәрі бірдей болады
Dialogue: 0,0:10:21.87,0:10:25.58,Default,,0,0,0,,Тіршілік үшін күресетін шөпқоректілердің аяқ-қолдарында,
Dialogue: 0,0:10:25.66,0:10:27.00,Default,,0,0,0,,Сезімдері бар
Dialogue: 0,0:10:27.08,0:10:28.25,Default,,0,0,0,,Уф! Ахх...
Dialogue: 0,0:10:28.33,0:10:30.42,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:10:32.88,0:10:35.34,Default,,0,0,0,,Эмоцияларыңызды аяқ-қолдарыңызға қалдырыңыз
Dialogue: 0,0:10:36.21,0:10:38.26,Default,,0,0,0,,Маған азу тістері керек емес
Dialogue: 0,0:10:39.97,0:10:41.43,Default,,0,0,0,,Ха! Ахх...
Dialogue: 0,0:10:50.73,0:10:52.10,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:10:53.15,0:10:54.94,Default,,0,0,0,,Мен ит емеспін
Dialogue: 0,0:10:59.07,0:11:00.40,Default,,0,0,0,,Бұл қасқыр.
Dialogue: 0,0:11:02.66,0:11:03.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:03.70,0:11:07.45,Default,,0,0,0,,Мен басты кейіпкермін бе, Адлер?
Dialogue: 0,0:11:07.54,0:11:11.46,Default,,0,0,0,,А... Мен бірінші курс студентімін, ал мен қызбын, солай ма?
Dialogue: 0,0:11:11.54,0:11:12.38,Default,,0,0,0,,Неге...
Dialogue: 0,0:11:12.46,0:11:14.50,Default,,0,0,0,,Сондықтан Джуно
Dialogue: 0,0:11:14.59,0:11:17.55,Default,,0,0,0,,Осы уақытқа дейін ер адамдар Адлердің рөлін ерлікпен ойнады.
Dialogue: 0,0:11:17.63,0:11:19.22,Default,,0,0,0,,Әйелдің орындауы арқылы
Dialogue: 0,0:11:19.30,0:11:23.30,Default,,0,0,0,,Біз драма үйірмесінің табандылығы мен бүлікшіл рухын көрсетеміз.
Dialogue: 0,0:11:23.93,0:11:27.93,Default,,0,0,0,,Клубтың басқа түрлері де бұрынғыдан да жақсы нәтижелерге қол жеткізуге тырысады.
Dialogue: 0,0:11:28.02,0:11:30.77,Default,,0,0,0,,Жаңа жылдық қойылымда қолымыздан келгенін жасайық.
Dialogue: 0,0:11:31.48,0:11:32.44,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:32.52,0:11:36.23,Default,,0,0,0,,А... Осыны айтып тұрсың ба?
Dialogue: 0,0:11:36.32,0:11:38.73,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:11:38.82,0:11:42.03,Default,,0,0,0,,Джуно солай айтады деп ойладым.
Dialogue: 0,0:11:42.86,0:11:45.28,Default,,0,0,0,,Фуфуфуфуфу…
Dialogue: 0,0:11:45.37,0:11:48.83,Default,,0,0,0,,Олардың әрекеттерін тоқтату ересектерге байланысты.
Dialogue: 0,0:11:48.91,0:11:50.45,Default,,0,0,0,,Алдын алу керек
Dialogue: 0,0:11:50.54,0:11:52.62,Default,,0,0,0,,Мектептер де өзгерді, солай емес пе?
Dialogue: 0,0:11:52.71,0:11:53.62,Default,,0,0,0,,Етқоректілер мен шөпқоректілер бірлесе білім алу керек екенін бәрі түсінді.
Dialogue: 0,0:11:53.62,0:11:55.08,Default,,0,0,0,,Етқоректілер мен шөпқоректілер бірлесе білім алу керек екенін бәрі түсінді.
Dialogue: 0,0:11:53.62,0:11:55.08,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:11:55.08,0:11:56.42,Default,,0,0,0,,Етқоректілер мен шөпқоректілер бірлесе білім алу керек екенін бәрі түсінді.
Dialogue: 0,0:11:56.50,0:11:57.50,Default,,0,0,0,,Сәлем Джуно
Dialogue: 0,0:11:58.50,0:11:59.80,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:11:59.88,0:12:01.34,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:01.42,0:12:02.88,Default,,0,0,0,,Өйткені, біз бар күшімізді салуымыз керек.
Dialogue: 0,0:12:02.97,0:12:03.84,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:12:03.93,0:12:05.39,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:05.47,0:12:07.39,Default,,0,0,0,,Бөлек мектеп жақсы.
Dialogue: 0,0:12:07.47,0:12:09.47,Default,,0,0,0,,Неліктен бәрі түсінбейді?
Dialogue: 0,0:12:09.56,0:12:13.81,Default,,0,0,0,,Бізге қашықтық керек. Бізге қашықтық керек...
Dialogue: 0,0:12:17.23,0:12:19.23,Default,,0,0,0,,Ах Джуно Ах...
Dialogue: 0,0:12:19.32,0:12:22.15,Default,,0,0,0,,Біз сізді қолдауға бар күшімізді саламыз.
Dialogue: 0,0:12:22.24,0:12:24.24,Default,,0,0,0,,Хехе, бір жылдың ішінде басты кейіпкер болу ғажап.
Dialogue: 0,0:12:24.32,0:12:27.32,Default,,0,0,0,,Иә... Рахмет
Dialogue: 0,0:12:27.41,0:12:29.12,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:12:29.20,0:12:32.12,Default,,0,0,0,,Мен бұған қуаныштымын.
Dialogue: 0,0:12:32.20,0:12:36.17,Default,,0,0,0,,Егер сіз мейіріммен күлсеңіз, қашықтықты сақтай аласыз.
Dialogue: 0,0:12:36.25,0:12:40.30,Default,,0,0,0,,Шөпқоректілерге қатысты неге бәрі тыныш бола алмайды?
Dialogue: 0,0:12:40.38,0:12:42.80,Default,,0,0,0,,Қатнасым жоқ деп айтуыңыз тым ашық, сондықтан оған сену мүмкін емес!
Dialogue: 0,0:12:43.72,0:12:44.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:45.93,0:12:48.89,Default,,0,0,0,,Міне болды! Мен сонда болдым... Мен сонда болдым
Dialogue: 0,0:12:48.97,0:12:52.18,Default,,0,0,0,,Мені алаңдататын жалғыз шөпқоректі жануар...
Dialogue: 0,0:12:53.18,0:12:58.40,Default,,0,0,0,,Легоши-сенпай, бұл шынымен де сенің түрің.
Dialogue: 0,0:13:02.82,0:13:06.78,Default,,0,0,0,,Ол соншалықты кішкентай болса да, ол әрқашан жалғыз әрекет етеді
Dialogue: 0,0:13:08.20,0:13:10.66,Default,,0,0,0,,Достарың жоқ па?
Dialogue: 0,0:13:14.71,0:13:19.21,Default,,0,0,0,,Бау-бақша бөлімі? Мен оның бар екенін де білмедім
Dialogue: 0,0:13:19.29,0:13:20.63,Default,,0,0,0,,Ол жыртылған.
Dialogue: 0,0:13:20.71,0:13:21.67,Default,,0,0,0,,А...
Dialogue: 0,0:13:21.75,0:13:23.17,Default,,0,0,0,,Ах
Dialogue: 0,0:13:23.26,0:13:27.68,Default,,0,0,0,,О, сен бе? Мен бұл Легоси-кун деп ойладым.
Dialogue: 0,0:13:27.76,0:13:30.26,Default,,0,0,0,,Қадамдардың салмағы ұқсас
Dialogue: 0,0:13:30.35,0:13:32.10,Default,,0,0,0,,Бұл соншалықты ауыр емес.
Dialogue: 0,0:13:32.18,0:13:33.43,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,0:13:33.52,0:13:35.89,Default,,0,0,0,,А, менің атым көрінбейді.
Dialogue: 0,0:13:35.98,0:13:38.77,Default,,0,0,0,,Бірақ мен түсіндім, сен Легоси-кунмен жақсы доссың, солай ма?
Dialogue: 0,0:13:38.85,0:13:39.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:39.77,0:13:42.73,Default,,0,0,0,,Сіз сияқты жақсы емес
Dialogue: 0,0:13:42.82,0:13:44.69,Default,,0,0,0,,Қасқыр-чан... Мм...
Dialogue: 0,0:13:44.78,0:13:45.90,Default,,0,0,0,,Юно
Dialogue: 0,0:13:45.99,0:13:47.45,Default,,0,0,0,,Джуно-чан
Dialogue: 0,0:13:47.53,0:13:49.41,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:13:49.49,0:13:52.16,Default,,0,0,0,,Менің атым Хал. Мен өз атымды бұрын айттым ба?
Dialogue: 0,0:13:52.24,0:13:54.37,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:13:54.45,0:13:58.29,Default,,0,0,0,,Жоқ... Мен тіпті білмеймін.
Dialogue: 0,0:13:58.37,0:14:00.25,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:14:00.33,0:14:01.71,Default,,0,0,0,,Аа, күте тұрыңыз, а...
Dialogue: 0,0:14:03.13,0:14:06.30,Default,,0,0,0,,Уфуфуфуфуфуфуфуфу…
Dialogue: 0,0:14:10.64,0:14:11.55,Default,,0,0,0,,Уау, жауын құрты
Dialogue: 0,0:14:11.64,0:14:14.64,Default,,0,0,0,,Әй, мені өлтірме, мені тірі қалдыр.
Dialogue: 0,0:14:14.72,0:14:15.68,Default,,0,0,0,,А...
Dialogue: 0,0:14:15.77,0:14:17.43,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:17.52,0:14:19.27,Default,,0,0,0,,Эй, осы күйіңде мәңгі қалсаң қалай?
Dialogue: 0,0:14:19.35,0:14:22.02,Default,,0,0,0,,Мен оны қабылдайды деп ойламадым.
Dialogue: 0,0:14:22.77,0:14:24.36,Default,,0,0,0,,Бір нәрсе айтыңыз...
Dialogue: 0,0:14:24.44,0:14:28.70,Default,,0,0,0,,Сіз сұрағанда бас тарта алмайтын азу тістерді қалай ұстау керектігін білесіз.
Dialogue: 0,0:14:28.78,0:14:30.57,Default,,0,0,0,,Мен күрек әкелемін.
Dialogue: 0,0:14:31.53,0:14:35.08,Default,,0,0,0,,Хаа... Мен не істеп жатырмын?
Dialogue: 0,0:14:37.08,0:14:39.96,Default,,0,0,0,,Бір ғана жануармен бау-бақша клубы
Dialogue: 0,0:14:40.04,0:14:44.96,Default,,0,0,0,,Бұл менмендік Легоси-сенпайды тартудың кілті ме?
Dialogue: 0,0:14:45.59,0:14:47.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:47.17,0:14:49.51,Default,,0,0,0,,Тағы біраз... Уф.
Dialogue: 0,0:14:49.59,0:14:50.43,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:14:51.84,0:14:53.60,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:14:53.68,0:14:55.64,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:55.72,0:14:59.39,Default,,0,0,0,,Баспалдақпен жүріңіз! Бұл дәл сіздің алдыңызда
Dialogue: 0,0:14:59.48,0:15:02.48,Default,,0,0,0,,Немесе маған қоңырау шалыңыз
Dialogue: 0,0:15:02.56,0:15:04.69,Default,,0,0,0,,Жоғарыдан құласаң, өлесің.
Dialogue: 0,0:15:04.77,0:15:07.78,Default,,0,0,0,,Иә... өйткені мен сені күттіргім келмейді.
Dialogue: 0,0:15:07.86,0:15:11.45,Default,,0,0,0,,Жарайды, менің жағым үнемі желіде.
Dialogue: 0,0:15:11.53,0:15:14.07,Default,,0,0,0,,Өз өміріңізге қауіп төндірмеңіз
Dialogue: 0,0:15:14.16,0:15:15.74,Default,,0,0,0,,Ахх...
Dialogue: 0,0:15:16.87,0:15:22.12,Default,,0,0,0,,Кіп-кішкентай, жалғыз кете алмайтын Харумен осылай таныстым.
Dialogue: 0,0:15:22.21,0:15:24.59,Default,,0,0,0,,Легоши-сенпайға да тиді ме?
Dialogue: 0,0:15:25.88,0:15:26.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:26.80,0:15:27.92,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:15:28.01,0:15:31.05,Default,,0,0,0,,Джуно мырза, мені қызықтырды ма?
Dialogue: 0,0:15:31.13,0:15:34.09,Default,,0,0,0,,Не? Жоқ... жоқ, мен олай айтқым келмейді.
Dialogue: 0,0:15:34.18,0:15:37.72,Default,,0,0,0,,хехехе әзіл әзіл
Dialogue: 0,0:15:37.81,0:15:39.77,Default,,0,0,0,,Оның әңгімесі жақсы.
Dialogue: 0,0:15:39.85,0:15:42.94,Default,,0,0,0,,Мен қазір қыздармен сөйлескеніме қуаныштымын.
Dialogue: 0,0:15:48.90,0:15:50.90,Default,,0,0,0,,Иә, жартысын илеңіз
Dialogue: 0,0:15:55.74,0:16:00.54,Default,,0,0,0,,Дәл қазір менің ішімде неше сезім айнып тұр?
Dialogue: 0,0:16:01.62,0:16:05.29,Default,,0,0,0,,Мен білгім келмеді.
Dialogue: 0,0:16:05.38,0:16:07.96,Default,,0,0,0,,Шөпқоректілердің сүйкімділігі неде?
Dialogue: 0,0:16:09.17,0:16:11.22,Default,,0,0,0,,Бөлек мектеп жақсырақ
Dialogue: 0,0:16:11.30,0:16:14.80,Default,,0,0,0,,Өйткені, мен жыртқыштар мен шөпқоректілердің бір-бірінен ажырағанын қалаймын.
Dialogue: 0,0:16:14.89,0:16:16.35,Default,,0,0,0,,Бұл сіздің аузыңызда.
Dialogue: 0,0:16:16.43,0:16:17.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:18.26,0:16:21.68,Default,,0,0,0,,Мен оны енді ала алмаймын...
Dialogue: 0,0:16:24.73,0:16:28.69,Default,,0,0,0,,Енді мен нақты себебін білдім
Dialogue: 0,0:16:29.48,0:16:34.78,Default,,0,0,0,,Өйткені етқоректілер шөпқоректілерге тең келмейді.
Dialogue: 0,0:16:36.91,0:16:38.45,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:16:38.53,0:16:40.95,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:16:42.50,0:16:45.04,Default,,0,0,0,,Жоқ, I
Dialogue: 0,0:16:45.12,0:16:47.75,Default,,0,0,0,,«Beastar» кемесі мүлде емес
Dialogue: 0,0:16:49.00,0:16:52.88,Default,,0,0,0,,Біз Луи-сенпай сияқты тең нәсілге айналуымыз мүмкін емес.
Dialogue: 0,0:16:52.97,0:16:55.43,Default,,0,0,0,,Бұл мен үшін мүмкін емес.
Dialogue: 0,0:16:57.64,0:16:59.39,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:17:00.18,0:17:01.35,Default,,0,0,0,,Сен Луи-сенпайдың қайда екенін білесің бе?
Dialogue: 0,0:17:01.35,0:17:02.47,Default,,0,0,0,,Сен Луи-сенпайдың қайда екенін білесің бе?
Dialogue: 0,0:17:01.35,0:17:02.47,Default,,0,0,0,,А...
Dialogue: 0,0:17:02.56,0:17:04.77,Default,,0,0,0,,Луи, сен білесің бе?
Dialogue: 0,0:17:04.85,0:17:07.44,Default,,0,0,0,,Мен сені ойладым.
Dialogue: 0,0:17:07.52,0:17:09.69,Default,,0,0,0,,Менімен дереу хабарласыңыз
Dialogue: 0,0:17:10.40,0:17:11.78,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:14.45,0:17:19.28,Default,,0,0,0,,Тағдырымды ұлдардай ренжіткенше.
Dialogue: 0,0:17:21.08,0:17:22.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.08,0:17:29.71,Default,,0,0,0,,Луи тамақ ішкенде дәмді бола ма?
Dialogue: 0,0:17:29.79,0:17:31.75,Default,,0,0,0,,Шөпқоректілердің арасындағы қара қалжың ба?
Dialogue: 0,0:17:31.84,0:17:33.67,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:17:33.76,0:17:34.88,Default,,0,0,0,,Бұл күлкілі ме?
Dialogue: 0,0:17:36.09,0:17:37.89,Default,,0,0,0,,Егер мен жыртқыш болсам
Dialogue: 0,0:17:37.97,0:17:40.72,Default,,0,0,0,,Менің ойымша, Хару сөзсіз жақсырақ көрінеді.
Dialogue: 0,0:17:41.56,0:17:44.10,Default,,0,0,0,,Міне, хехехехехехе
Dialogue: 0,0:17:44.18,0:17:47.52,Default,,0,0,0,,Мен Луидің жыртқыш екенін елестете алмаймын.
Dialogue: 0,0:17:48.65,0:17:49.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:50.90,0:17:53.86,Default,,0,0,0,,Екеуіміздің қолдарымыз нәзік, жұмсақ.
Dialogue: 0,0:17:55.15,0:17:58.49,Default,,0,0,0,,Екеуміздің де дәм тататынымызға сенімдімін.
Dialogue: 0,0:17:59.95,0:18:03.12,Default,,0,0,0,,Мен жеңілдеп қалдым, біз әлсіз адамдармыз
Dialogue: 0,0:18:05.83,0:18:08.58,Default,,0,0,0,,Бастық... Бастық!
Dialogue: 0,0:18:08.67,0:18:10.08,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:18:10.17,0:18:11.92,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:18:12.59,0:18:13.67,Default,,0,0,0,,О
Dialogue: 0,0:18:13.75,0:18:17.05,Default,,0,0,0,,Мен Харуды армандағаныма біраз болды.
Dialogue: 0,0:18:17.13,0:18:19.18,Default,,0,0,0,,Неліктен бұл уақыт?
Dialogue: 0,0:18:19.80,0:18:25.14,Default,,0,0,0,,Мен шөпқоректі еттің сатылып жатқанын енді сезбеймін.
Dialogue: 0,0:18:25.22,0:18:29.65,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:18:29.73,0:18:32.82,Default,,0,0,0,,Оны шынымен емдеуге бола ма?
Dialogue: 0,0:18:32.90,0:18:34.02,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:18:34.11,0:18:37.03,Default,,0,0,0,,«Құбыжық медицинаның» әсері өте зор.
Dialogue: 0,0:18:37.11,0:18:39.40,Default,,0,0,0,,Тапсырыс берушінің де жолы болды.
Dialogue: 0,0:18:39.49,0:18:41.99,Default,,0,0,0,,Кайман денелері сирек кездеседі
Dialogue: 0,0:18:42.07,0:18:44.33,Default,,0,0,0,,Бұл бұрынғыдай күдікті.
Dialogue: 0,0:18:44.41,0:18:45.79,Default,,0,0,0,,Эй, аа...
Dialogue: 0,0:18:45.87,0:18:47.33,Default,,0,0,0,,Бизнеске араласу жақсы емес.
Dialogue: 0,0:18:47.41,0:18:48.25,Default,,0,0,0,,А... иә
Dialogue: 0,0:18:48.33,0:18:49.62,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:49.71,0:18:52.08,Default,,0,0,0,,Мен мұнда келдім, өйткені ингредиенттер жабайы болды.
Dialogue: 0,0:18:52.17,0:18:53.84,Default,,0,0,0,,Сіз тынышсыз, солай емес пе?
Dialogue: 0,0:18:53.92,0:18:57.80,Default,,0,0,0,,Ой... Мен де ақша алғым келгендіктен осылай істеп жатырмын.
Dialogue: 0,0:18:57.88,0:19:01.93,Default,,0,0,0,,Өмір сүруді жалғастыру үшін жеткілікті орынды алып тастаңыз.
Dialogue: 0,0:19:02.01,0:19:04.30,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:19:04.39,0:19:07.27,Default,,0,0,0,,Жасың нешеде? Ингредиенттер
Dialogue: 0,0:19:07.35,0:19:09.14,Default,,0,0,0,,Ах… 37.
Dialogue: 0,0:19:09.23,0:19:10.56,Default,,0,0,0,,Кейбір жағдайларға байланысты мен несие ақшасын пайдалануды шештім.
Dialogue: 0,0:19:10.56,0:19:11.77,Default,,0,0,0,,Егер жағдай болып, мен ақшамды несиеге салсам,
Dialogue: 0,0:19:10.56,0:19:11.77,Default,,0,0,0,,Позицияны өзгертудің бұрмалануы…
Dialogue: 0,0:19:11.77,0:19:11.85,Default,,0,0,0,,Позицияны өзгертудің бұрмалануы…
Dialogue: 0,0:19:11.85,0:19:12.98,Default,,0,0,0,,Позицияны өзгертудің бұрмалануы…
Dialogue: 0,0:19:11.85,0:19:12.98,Default,,0,0,0,,Мен кептеліп қалдым
Dialogue: 0,0:19:12.98,0:19:13.06,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:19:13.06,0:19:14.02,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:19:13.06,0:19:14.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:14.11,0:19:17.40,Default,,0,0,0,,Түсіндім, сен жассың...
Dialogue: 0,0:19:19.15,0:19:20.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:21.57,0:19:27.91,Default,,0,0,0,,Менің төменгі денем соңғы 10 жыл бойы сал болып, қозғала алмаймын.
Dialogue: 0,0:19:28.00,0:19:31.25,Default,,0,0,0,,Өлім алдында бір рет
Dialogue: 0,0:19:31.33,0:19:34.38,Default,,0,0,0,,Мен отбасылық өмірімді қалпына келтіргім келеді
Dialogue: 0,0:19:34.46,0:19:35.46,Default,,0,0,0,,А...
Dialogue: 0,0:19:35.54,0:19:36.46,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:19:36.55,0:19:39.05,Default,,0,0,0,,Хмм... (Дәрігер) Жыныс мүшелерін алуға дайынсыз ба?
Dialogue: 0,0:19:39.13,0:19:41.84,Default,,0,0,0,,Иә, жарайды... күте тұрыңыз, сіз жаңа ғана не айттыңыз?
Dialogue: 0,0:19:41.93,0:19:43.34,Default,,0,0,0,,Анестезия... Уау...
Dialogue: 0,0:19:43.43,0:19:44.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.55,0:19:48.60,Default,,0,0,0,,Ибуки, қазір сенде қандай ата-ана махаббаты бар?
Dialogue: 0,0:19:44.55,0:19:48.60,Default,,0,0,0,,(Кайманның айқайы)
Dialogue: 0,0:19:48.60,0:19:48.68,Default,,0,0,0,,(Кайманның айқайы)
Dialogue: 0,0:19:48.68,0:19:51.27,Default,,0,0,0,,(Кайманның айқайы)
Dialogue: 0,0:19:48.68,0:19:51.27,Default,,0,0,0,,Бала кезімде болған Аназурадан әлдеқайда жақсы.
Dialogue: 0,0:19:51.27,0:19:51.73,Default,,0,0,0,,Бала кезімде болған Аназурадан әлдеқайда жақсы.
Dialogue: 0,0:19:51.81,0:19:58.48,Default,,0,0,0,,(Кайманның айқайы)
Dialogue: 0,0:20:03.91,0:20:08.79,Default,,0,0,0,,Олардың бәрі қоғамнан алшақтайтын әлсіз адамдар.
Dialogue: 0,0:20:09.87,0:20:11.33,Default,,0,0,0,,Босс
Dialogue: 0,0:20:11.41,0:20:14.67,Default,,0,0,0,,Өзіңізді лақтырудан аулақ болыңыз.
Dialogue: 0,0:20:14.75,0:20:17.67,Default,,0,0,0,,Суицид? неге мен
Dialogue: 0,0:20:22.84,0:20:24.43,Default,,0,0,0,,Бұл күлкілі, солай емес пе?
Dialogue: 0,0:20:24.51,0:20:26.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:26.14,0:20:29.93,Default,,0,0,0,,Лай судың дәмін сен де, мен де білеміз.
Dialogue: 0,0:20:30.81,0:20:35.40,Default,,0,0,0,,Бір жануар ғана қашып, осы уақытқа дейін жетті.
Dialogue: 0,0:20:36.94,0:20:38.32,Default,,0,0,0,,Біз ұқсаспыз
Dialogue: 0,0:20:43.49,0:20:47.03,Default,,0,0,0,,Мен тірі жем ретінде сатылған бала едім
Dialogue: 0,0:20:47.12,0:20:49.95,Default,,0,0,0,,Енді «артқы нарыққа» назар аудармайды
Dialogue: 0,0:20:51.58,0:20:53.33,Default,,0,0,0,,Мен бұрыннан білуім керек еді
Dialogue: 0,0:20:53.33,0:20:54.37,Default,,0,0,0,,Мен бұрыннан білуім керек еді
Dialogue: 0,0:20:53.33,0:20:54.37,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:54.37,0:20:56.33,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:56.33,0:20:59.42,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:56.33,0:20:59.42,Default,,0,0,0,,Дәл қазір мен бүкіл денемде шындық сезімін сезінемін.
Dialogue: 0,0:21:00.25,0:21:05.01,Default,,0,0,0,,Әлсіз өмір салты қаншалықты күнә?
Dialogue: 0,0:21:10.72,0:21:11.56,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:21:12.35,0:21:14.31,Default,,0,0,0,,Суықпа, Ибуки
Dialogue: 0,0:21:14.89,0:21:15.98,Default,,0,0,0,,Ішкім келеді ме?
Dialogue: 0,0:21:16.65,0:21:18.52,Default,,0,0,0,,Мен сенімен таңға дейін боламын.
Dialogue: 0,0:21:19.06,0:21:24.19,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:21:27.20,0:21:28.53,Default,,0,0,0,,Польнарефф!
Dialogue: 0,0:21:32.04,0:21:38.04,Default,,0,0,0,,♪～
Dialogue: 0,0:22:52.24,0:22:58.25,Default,,0,0,0,,～♪
