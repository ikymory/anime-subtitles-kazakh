Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.09,0:00:18.10,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.92,0:01:39.18,Default,,0,0,0,,～♪
Dialogue: 0,0:01:42.93,0:01:46.73,Default,,0,0,0,,（）
Dialogue: 0,0:01:46.81,0:01:47.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:47.85,0:01:52.48,Default,,0,0,0,,Үлпілдек көбелекте өмірдің иісі бар
Dialogue: 0,0:01:54.40,0:01:56.99,Default,,0,0,0,,Маған сөйлеңдер, жәндіктер.
Dialogue: 0,0:01:57.95,0:02:00.24,Default,,0,0,0,,Бізге сіздің көмегіңіз қажет.
Dialogue: 0,0:02:07.83,0:02:10.04,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:02:10.13,0:02:11.17,Default,,0,0,0,,Иә
Dialogue: 0,0:02:11.25,0:02:13.96,Default,,0,0,0,,Мен оны тірідей жеймін
Dialogue: 0,0:02:14.55,0:02:15.63,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:16.84,0:02:20.59,Default,,0,0,0,,Хаа... Мен қобалжыдым.
Dialogue: 0,0:02:21.39,0:02:24.06,Default,,0,0,0,,Гохин мырзаның жәндіктерді жеу тәжірибесі жоқ...
Dialogue: 0,0:02:24.14,0:02:25.85,Default,,0,0,0,,Жоқ, олай емеспін.
Dialogue: 0,0:02:25.93,0:02:28.56,Default,,0,0,0,,Пандалар ақуызға қызықпайды.
Dialogue: 0,0:02:29.60,0:02:33.23,Default,,0,0,0,,Жәндіктерді жеу тірі жәндіктерге ұқсайды.
Dialogue: 0,0:02:33.98,0:02:35.82,Default,,0,0,0,,Әркім одан аулақ болғысы келеді
Dialogue: 0,0:02:35.90,0:02:39.78,Default,,0,0,0,,Мен оны кінәлі сезінбей жегім келмейді.
Dialogue: 0,0:02:42.28,0:02:44.99,Default,,0,0,0,,Өмірді жеу…
Dialogue: 0,0:02:46.74,0:02:48.45,Default,,0,0,0,,Қылмыс
Dialogue: 0,0:02:51.37,0:02:53.63,Default,,0,0,0,,Бұл менмендік.
Dialogue: 0,0:02:54.88,0:02:57.30,Default,,0,0,0,,Қатты өмір сүрсем де
Dialogue: 0,0:02:57.38,0:02:59.38,Default,,0,0,0,,Егер жәндік болса, оны жеуге болады.
Dialogue: 0,0:02:59.47,0:03:01.47,Default,,0,0,0,,Мен неге ойлаймын
Dialogue: 0,0:03:01.55,0:03:02.39,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:02.47,0:03:04.80,Default,,0,0,0,,Қазір не айтып тұрсың?
Dialogue: 0,0:03:04.89,0:03:07.93,Default,,0,0,0,,Басында тәкаппар адам болсаң керек.
Dialogue: 0,0:03:08.02,0:03:09.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:09.10,0:03:13.52,Default,,0,0,0,,Қыз болсам да, Кешіре алмаған адамды ұрамын.
Dialogue: 0,0:03:13.61,0:03:15.69,Default,,0,0,0,,Айналадағыларға әділеттілік сезімін таңу
Dialogue: 0,0:03:15.77,0:03:19.40,Default,,0,0,0,,Қоянның бөксесін мәңгілікке қуу...
Dialogue: 0,0:03:19.49,0:03:23.57,Default,,0,0,0,,Сөзбен айтсам, мен азапты адаммын ба?
Dialogue: 0,0:03:23.66,0:03:24.82,Default,,0,0,0,,Бірақ бұл жақсы.
Dialogue: 0,0:03:24.91,0:03:26.08,Default,,0,0,0,,Е...
Dialogue: 0,0:03:26.16,0:03:30.25,Default,,0,0,0,,Сіздің жауынгерлік рухыңыз тек жыртқыштарға ғана тән.
Dialogue: 0,0:03:30.33,0:03:32.79,Default,,0,0,0,,Біреу үшін ғана өседі
Dialogue: 0,0:03:34.75,0:03:36.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:36.67,0:03:40.13,Default,,0,0,0,,Иә, оған көмектесу мүмкін емес.
Dialogue: 0,0:03:45.09,0:03:47.06,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:03:47.72,0:03:49.10,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,0:03:49.68,0:03:52.02,Default,,0,0,0,,Өмірді алудың мәні
Dialogue: 0,0:03:52.10,0:03:53.81,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:03:56.15,0:03:57.48,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:04:00.74,0:04:03.82,Default,,0,0,0,,Хмм... Мен күткеннен де серпімді.
Dialogue: 0,0:04:03.91,0:04:07.41,Default,,0,0,0,,Бұл сыртқы тері ме?
Dialogue: 0,0:04:07.49,0:04:10.08,Default,,0,0,0,,А... аяғым тіліммен қозғалады.
Dialogue: 0,0:04:10.16,0:04:11.00,Default,,0,0,0,,Уау Уау...
Dialogue: 0,0:04:13.12,0:04:17.04,Default,,0,0,0,,Ащы мен тұзды...
Dialogue: 0,0:04:17.13,0:04:19.67,Default,,0,0,0,,Шөп және жер иісі
Dialogue: 0,0:04:19.75,0:04:21.76,Default,,0,0,0,,Желдің иісі
Dialogue: 0,0:04:21.84,0:04:24.43,Default,,0,0,0,,Концентрленген және күрделі…
Dialogue: 0,0:04:24.51,0:04:26.39,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:27.43,0:04:28.93,Default,,0,0,0,,Өмірдің дәмі!
Dialogue: 0,0:04:30.10,0:04:31.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:31.85,0:04:32.73,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:04:33.89,0:04:36.23,Default,,0,0,0,,Сіз мені түкіргіңіз келе ме?
Dialogue: 0,0:04:36.31,0:04:38.65,Default,,0,0,0,,Көбелек...
Dialogue: 0,0:04:38.73,0:04:41.11,Default,,0,0,0,,Бұл сен кінәлі
Dialogue: 0,0:04:41.19,0:04:45.07,Default,,0,0,0,,Дернәсілден өсу мүмкін болмаса да.
Dialogue: 0,0:04:46.57,0:04:48.91,Default,,0,0,0,,Мен... Кешіріңіз.
Dialogue: 0,0:04:49.83,0:04:53.33,Default,,0,0,0,,Мен сені... менсінбеген шығармын.
Dialogue: 0,0:04:53.41,0:04:58.04,Default,,0,0,0,,Мен күшті болғым келді, сондықтан өмірді кемсіттім.
Dialogue: 0,0:04:58.13,0:05:00.63,Default,,0,0,0,,Маған қарғыс айтуыңызды өтінемін
Dialogue: 0,0:05:00.71,0:05:02.84,Default,,0,0,0,,Кез келген жазаны қабылдаңыз
Dialogue: 0,0:05:02.92,0:05:05.05,Default,,0,0,0,,Бұл қабылданбайды
Dialogue: 0,0:05:05.13,0:05:11.35,Default,,0,0,0,,Құрметсіздік Кемсіту Жаза Кешіру…
Dialogue: 0,0:05:11.43,0:05:16.31,Default,,0,0,0,,Мұндай сөздер бізге жәндіктер үшін мағынасыз.
Dialogue: 0,0:05:17.23,0:05:21.36,Default,,0,0,0,,Бізде сендер сияқты тілек жоқ.
Dialogue: 0,0:05:21.44,0:05:24.82,Default,,0,0,0,,Бір ғана нәрсе маңызды
Dialogue: 0,0:05:24.90,0:05:26.95,Default,,0,0,0,,Өмірді құрметтеу
Dialogue: 0,0:05:28.24,0:05:31.53,Default,,0,0,0,,Өмірді құрметтеу...
Dialogue: 0,0:05:32.29,0:05:37.21,Default,,0,0,0,,Тамақтану басқа адамды түсіну және құрметтеу дегенді білдіреді.
Dialogue: 0,0:05:37.29,0:05:41.04,Default,,0,0,0,,Бірегей жанды қабылдау
Dialogue: 0,0:05:42.80,0:05:46.47,Default,,0,0,0,,(Легошидің жылауы)
Dialogue: 0,0:05:46.55,0:05:48.47,Default,,0,0,0,,Көз жасы...
Dialogue: 0,0:05:48.55,0:05:51.01,Default,,0,0,0,,Көз жасын төкпейміз
Dialogue: 0,0:05:51.68,0:05:55.06,Default,,0,0,0,,Мен де... Мен жәндік болып туғым келді.
Dialogue: 0,0:05:56.39,0:05:59.10,Default,,0,0,0,,Қасқыр болып туған
Dialogue: 0,0:05:59.85,0:06:01.94,Default,,0,0,0,,Себебі мен ойға толымын
Dialogue: 0,0:06:02.02,0:06:04.28,Default,,0,0,0,,Тірі болғанның жаны ауырады.
Dialogue: 0,0:06:04.36,0:06:06.03,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:06:06.11,0:06:08.40,Default,,0,0,0,,Жәндіктер де айтарлықтай қиын.
Dialogue: 0,0:06:08.49,0:06:11.20,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:06:11.28,0:06:12.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:12.53,0:06:14.79,Default,,0,0,0,,Мен уақытты жақсы өткіздім
Dialogue: 0,0:06:15.37,0:06:18.50,Default,,0,0,0,,Қош бол, күшті жаратылыс.
Dialogue: 0,0:06:18.58,0:06:20.08,Default,,0,0,0,,Шынайы өмір сүр
Dialogue: 0,0:06:21.21,0:06:23.59,Default,,0,0,0,,Мен ет пен қан сияқтымын
Dialogue: 0,0:06:29.55,0:06:31.26,Default,,0,0,0,,О, ояусың ба?
Dialogue: 0,0:06:31.34,0:06:32.72,Default,,0,0,0,,Енді бұл – қабілетке қарсы қабілет, техникаға қарсы техника, рухқа қарсы рух!
Dialogue: 0,0:06:32.80,0:06:36.10,Default,,0,0,0,,Мен дернәсілді жегенде есінен танып қалдым.
Dialogue: 0,0:06:36.18,0:06:38.77,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл тәуелділік пе?
Dialogue: 0,0:06:38.85,0:06:42.11,Default,,0,0,0,,Жоқ, жоқ... осының бәрі...
Dialogue: 0,0:06:42.19,0:06:43.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:44.48,0:06:47.36,Default,,0,0,0,,Бұл түс сияқты болды
Dialogue: 0,0:06:47.44,0:06:49.65,Default,,0,0,0,,Мен шынымен жақсы сөздер естігендей болдым.
Dialogue: 0,0:06:50.66,0:06:51.66,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:06:51.74,0:06:53.95,Default,,0,0,0,,Ал, бетіңізге қараңыз.
Dialogue: 0,0:06:54.49,0:06:56.04,Default,,0,0,0,,Сіз өте жақсы көрінесіз.
Dialogue: 0,0:06:56.12,0:06:57.95,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:06:58.58,0:07:02.00,Default,,0,0,0,,Иә? А... шаш...
Dialogue: 0,0:07:03.29,0:07:04.54,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:05.29,0:07:07.67,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:07:07.76,0:07:11.22,Default,,0,0,0,,Мен Луи-сенпайға барып, шешімімді білдіргім келеді.
Dialogue: 0,0:07:12.14,0:07:13.51,Default,,0,0,0,,Егер бұл орын алса, сіз білесіз.
Dialogue: 0,0:07:13.59,0:07:15.47,Default,,0,0,0,,Хмм…
Dialogue: 0,0:07:15.56,0:07:16.39,Default,,0,0,0,,А... (Гухин тілін шертеді)
Dialogue: 0,0:07:16.47,0:07:17.60,Default,,0,0,0,,Бұл жалғыз нұсқа
Dialogue: 0,0:07:17.68,0:07:19.10,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:07:19.18,0:07:20.02,Default,,0,0,0,,А...
Dialogue: 0,0:07:23.98,0:07:27.15,Default,,0,0,0,,Тұз тұзды
Dialogue: 0,0:07:27.23,0:07:30.03,Default,,0,0,0,,Қант тәтті
Dialogue: 0,0:07:30.11,0:07:32.53,Default,,0,0,0,,Сірке суы қышқыл
Dialogue: 0,0:07:33.36,0:07:35.32,Default,,0,0,0,,Дәм қайта келеді
Dialogue: 0,0:07:35.41,0:07:37.79,Default,,0,0,0,,Лиз, менің қарным ашты.
Dialogue: 0,0:07:37.87,0:07:40.83,Default,,0,0,0,,Мен бүгін сенімдімін, сондықтан оны асыға күтіңіздер.
Dialogue: 0,0:07:40.91,0:07:42.96,Default,,0,0,0,,Иә? Бірдеңе Лиз... (Аю В) Иә?
Dialogue: 0,0:07:43.04,0:07:45.88,Default,,0,0,0,,Соңғы аптада денеңіз өсті ме?
Dialogue: 0,0:07:45.96,0:07:47.59,Default,,0,0,0,,Сіз дәрі қабылдайсыз ба?
Dialogue: 0,0:07:47.67,0:07:49.67,Default,,0,0,0,,Менің ойымша, сіз ішіп отырсыз.
Dialogue: 0,0:07:49.76,0:07:53.38,Default,,0,0,0,,Дәрі-дәрмек жинадым, бұл жай ғана вегетациялық кезең.
Dialogue: 0,0:07:53.47,0:07:54.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:54.39,0:07:56.39,Default,,0,0,0,,Не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:58.01,0:07:58.64,Default,,0,0,0,,(құбырдың құлаған дыбысы)
Dialogue: 0,0:07:58.64,0:07:59.10,Default,,0,0,0,,(құбырдың құлаған дыбысы)
Dialogue: 0,0:07:58.64,0:07:59.10,Default,,0,0,0,,Менің жан дүнием қозғалады
Dialogue: 0,0:07:59.10,0:08:01.35,Default,,0,0,0,,Менің жан дүнием қозғалады
Dialogue: 0,0:08:01.43,0:08:04.90,Default,,0,0,0,,Мен саған қандай болсам, солай қараймын.
Dialogue: 0,0:08:04.98,0:08:06.36,Default,,0,0,0,,Легоши-кун
Dialogue: 0,0:08:06.44,0:08:07.90,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:07.98,0:08:10.11,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:08:13.65,0:08:14.86,Default,,0,0,0,,Босс
Dialogue: 0,0:08:14.95,0:08:18.70,Default,,0,0,0,,Мүйізді бас және жалды бас
Dialogue: 0,0:08:18.78,0:08:21.29,Default,,0,0,0,,Сіздің ойыңызша, таксидермия қайсысына тұрарлық?
Dialogue: 0,0:08:21.91,0:08:23.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:23.12,0:08:24.75,Default,,0,0,0,,Біз астыртын ұйымбыз.
Dialogue: 0,0:08:24.83,0:08:28.21,Default,,0,0,0,,Сіз жасырынған жеріңізді медальдармен безендіргіңіз келеді, солай ма?
Dialogue: 0,0:08:28.29,0:08:30.76,Default,,0,0,0,,Мысалы, жау бастықтың басы
Dialogue: 0,0:08:30.84,0:08:32.55,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:08:32.63,0:08:34.84,Default,,0,0,0,,Қызық, мұндай кішкентай басты интерьерді безендіруге бола ма?
Dialogue: 0,0:08:34.93,0:08:35.76,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:35.84,0:08:38.26,Default,,0,0,0,,Бұл әзіл емес
Dialogue: 0,0:08:38.35,0:08:40.85,Default,,0,0,0,,Бізді қауіп төндіретін ұйым.
Dialogue: 0,0:08:40.93,0:08:42.64,Default,,0,0,0,,Бастықтың басына келсең...
Dialogue: 0,0:08:42.73,0:08:44.19,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:08:44.27,0:08:47.15,Default,,0,0,0,,Оның орнына сені өлтіру керек, Ибуки.
Dialogue: 0,0:08:48.27,0:08:50.11,Default,,0,0,0,,Мен өлсем ше?
Dialogue: 0,0:08:50.19,0:08:53.95,Default,,0,0,0,,Қол астындағы қызметкер бастықты жеп қойды деген қауесет тез тарады.
Dialogue: 0,0:08:55.03,0:08:58.07,Default,,0,0,0,,Мұндай жақсы толқынға міну босқа кетті.
Dialogue: 0,0:08:58.16,0:08:59.62,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:59.70,0:09:01.08,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:09:01.16,0:09:03.41,Default,,0,0,0,,Мен өзімді қуана құрбан етемін, бастық.
Dialogue: 0,0:09:07.12,0:09:09.38,Default,,0,0,0,,Мен біраз уақыт ваннаға барамын.
Dialogue: 0,0:09:09.46,0:09:10.63,Default,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:09:10.71,0:09:12.92,Default,,0,0,0,,Әй, екі виски тастары.
Dialogue: 0,0:09:13.01,0:09:15.17,Default,,0,0,0,,Эй, мен күшті алкогольді ұнатпаймын.
Dialogue: 0,0:09:15.26,0:09:16.80,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:09:16.88,0:09:18.55,Default,,0,0,0,,Олай болса, тәтті коктейль.
Dialogue: 0,0:09:18.64,0:09:19.85,Default,,0,0,0,,Аты жоқ.
Dialogue: 0,0:09:20.72,0:09:22.68,Default,,0,0,0,,Ыстық сумен араластырылған қара өрік шарабы
Dialogue: 0,0:09:27.60,0:09:30.31,Default,,0,0,0,,Бастықтың ішімдігі әлсіз болды ма?
Dialogue: 0,0:09:30.90,0:09:34.24,Default,,0,0,0,,Сіз мені кешіре аласыз деп ойлаймын.
Dialogue: 0,0:09:35.86,0:09:37.66,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:47.87,0:09:50.59,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:09:50.67,0:09:51.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:52.80,0:09:56.30,Default,,0,0,0,,Өтінемін, айқайлама, Луи-сенпай.
Dialogue: 0,0:10:04.97,0:10:08.10,Default,,0,0,0,,Мұның әртүрлі себептері бар.
Dialogue: 0,0:10:08.19,0:10:10.06,Default,,0,0,0,,А... мен мұны түсіндірмес бұрын.
Dialogue: 0,0:10:10.15,0:10:12.23,Default,,0,0,0,,Қарапайым тілмен айтқанда, бұл Легоши.
Dialogue: 0,0:10:12.32,0:10:14.44,Default,,0,0,0,,...Түсіндің бе? Хахаха
Dialogue: 0,0:10:14.53,0:10:16.82,Default,,0,0,0,,Мына кроссовка жаман емес пе?
Dialogue: 0,0:10:16.90,0:10:18.45,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:10:18.53,0:10:21.16,Default,,0,0,0,,Мен оны өлтірмесем, ақымақ бола беретін адам ма?
Dialogue: 0,0:10:21.24,0:10:21.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.74,0:10:22.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.74,0:10:22.37,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:22.37,0:10:23.16,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:23.24,0:10:25.12,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:26.95,0:10:29.71,Default,,0,0,0,,Бастықты қандай да бір үлкен әйел нысанаға алады.
Dialogue: 0,0:10:29.79,0:10:32.21,Default,,0,0,0,,Мен сені кездестірдім, бірақ...
Dialogue: 0,0:10:32.79,0:10:34.13,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:10:34.21,0:10:37.26,Default,,0,0,0,,Мен Луи-сенпайдың ашулы атмосферасын шынымен сезінемін.
Dialogue: 0,0:10:37.34,0:10:41.34,Default,,0,0,0,,Бұл ақымақ киімнің мақсаты не?
Dialogue: 0,0:10:41.43,0:10:44.22,Default,,0,0,0,,Мен сені ренжітейін бе, ақымақ?
Dialogue: 0,0:10:44.31,0:10:46.35,Default,,0,0,0,,Бастық да 18-де ер адам.
Dialogue: 0,0:10:46.43,0:10:49.98,Default,,0,0,0,,Мен сіздің жеке өміріңізге араласпаймын, бірақ шынымды айтсам...
Dialogue: 0,0:10:50.06,0:10:52.81,Default,,0,0,0,,Бұл әйел өте ұсқынсыз.
Dialogue: 0,0:10:52.90,0:10:55.65,Default,,0,0,0,,Бұл жағдайда не істеу керек
Dialogue: 0,0:10:56.86,0:10:58.82,Default,,0,0,0,,Ибуки ха
Dialogue: 0,0:10:59.45,0:11:00.53,Default,,0,0,0,,Оны алып тастаңыз
Dialogue: 0,0:11:00.61,0:11:02.11,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:11:02.20,0:11:05.70,Default,,0,0,0,,Соққы аймағы күткендей кең.
Dialogue: 0,0:11:06.41,0:11:08.41,Default,,0,0,0,,Сенпай мен бақыттымын
Dialogue: 0,0:11:08.50,0:11:09.71,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:11:13.50,0:11:15.29,Default,,0,0,0,,Сөзге тікелей көшейік.
Dialogue: 0,0:11:15.38,0:11:16.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:16.30,0:11:18.76,Default,,0,0,0,,Сіз қылмыскерді білесіз.
Dialogue: 0,0:11:18.84,0:11:20.59,Default,,0,0,0,,Сіз айтып отырғаныңыз осы емес пе?
Dialogue: 0,0:11:20.67,0:11:23.55,Default,,0,0,0,,Ах... мм... бұл Лиз еді.
Dialogue: 0,0:11:23.64,0:11:28.27,Default,,0,0,0,,Қарасам, қоңыр аю...
Dialogue: 0,0:11:28.35,0:11:30.06,Default,,0,0,0,,Сен сол тұмарға ұқсайсың.
Dialogue: 0,0:11:30.14,0:11:32.40,Default,,0,0,0,,Сізде тыныш мектеп өмірі болды ма?
Dialogue: 0,0:11:32.48,0:11:34.56,Default,,0,0,0,,Дұрыс. Сен мені кешіре алмайсың.
Dialogue: 0,0:11:35.27,0:11:37.27,Default,,0,0,0,,Сондықтан мен дуэльге шығамын.
Dialogue: 0,0:11:37.36,0:11:40.11,Default,,0,0,0,,ше? Жоқ, полиция, оларды тапсырыңыз.
Dialogue: 0,0:11:40.19,0:11:42.95,Default,,0,0,0,,Бұл мен және оның арасындағы ұрыс.
Dialogue: 0,0:11:43.03,0:11:44.62,Default,,0,0,0,,Луи Сенпай
Dialogue: 0,0:11:44.70,0:11:46.87,Default,,0,0,0,,Онда болыңыз.
Dialogue: 0,0:11:52.12,0:11:52.96,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:11:53.04,0:11:54.13,Default,,0,0,0,,А...
Dialogue: 0,0:11:54.21,0:11:56.79,Default,,0,0,0,,Мен үшін сенің өміріңді қалай өткізетінің маңызды емес.
Dialogue: 0,0:11:57.42,0:11:59.42,Default,,0,0,0,,Сенің енді маған қатысың жоқ.
Dialogue: 0,0:12:00.38,0:12:01.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:01.59,0:12:05.64,Default,,0,0,0,,Мен енді сізден қоғамдық қоғамға қайта келуіңізді сұрамаймын.
Dialogue: 0,0:12:05.72,0:12:09.31,Default,,0,0,0,,Мен оны мен құрметтейтін Луи-сенпай көрсе екен деймін.
Dialogue: 0,0:12:09.39,0:12:11.06,Default,,0,0,0,,Менің өмір жолым
Dialogue: 0,0:12:11.14,0:12:13.73,Default,,0,0,0,,Ал... Мен өліп жатқан шығармын.
Dialogue: 0,0:12:14.73,0:12:17.86,Default,,0,0,0,,Сенің арқаңда осы уақытқа дейін келдім.
Dialogue: 0,0:12:18.98,0:12:23.07,Default,,0,0,0,,Бұл менің соңғы сәтім болса, соған куә болғаныңызды қалаймын.
Dialogue: 0,0:12:25.03,0:12:25.87,Default,,0,0,0,,Менің тамырларым жарылып кетеді?
Dialogue: 0,0:12:26.87,0:12:28.74,Default,,0,0,0,,Жоқ, сіз...
Dialogue: 0,0:12:28.83,0:12:31.70,Default,,0,0,0,,Бұл бет әлпет, ә...
Dialogue: 0,0:12:31.79,0:12:33.41,Default,,0,0,0,,Мен күлдім мен күлдім.
Dialogue: 0,0:12:33.50,0:12:34.33,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:12:34.42,0:12:35.79,Default,,0,0,0,,Жарайды деп есептелді
Dialogue: 0,0:12:38.34,0:12:42.30,Default,,0,0,0,,Жаңа жыл түні сағат 23:00-де Ғасра эстакадасының астында
Dialogue: 0,0:12:42.38,0:12:43.22,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:12:43.30,0:12:45.76,Default,,0,0,0,,Эй Корра, бармайық.
Dialogue: 0,0:12:46.64,0:12:47.47,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:12:48.18,0:12:49.76,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:12:49.85,0:12:51.14,Default,,0,0,0,,Босс
Dialogue: 0,0:12:51.89,0:12:53.89,Default,,0,0,0,,Бұл үлкен әйел қайда?
Dialogue: 0,0:12:53.98,0:12:55.44,Default,,0,0,0,,Хутта
Dialogue: 0,0:12:55.52,0:12:58.61,Default,,0,0,0,,Мм... Менің ойымша, бұл дұрыс.
Dialogue: 0,0:13:00.48,0:13:02.19,Default,,0,0,0,,Кім барады?
Dialogue: 0,0:13:02.90,0:13:04.32,Default,,0,0,0,,Ақымақ жігіт
Dialogue: 0,0:13:10.20,0:13:11.95,Default,,0,0,0,,（）
Dialogue: 0,0:13:12.70,0:13:16.46,Default,,0,0,0,,Бұл сенің иісің ғой, Пина-кун.
Dialogue: 0,0:13:17.96,0:13:19.63,Default,,0,0,0,,Бүгін түнде дуэль бар ма?
Dialogue: 0,0:13:19.71,0:13:21.75,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:13:21.84,0:13:23.76,Default,,0,0,0,,Сіз мені қолдауға келесіз бе?
Dialogue: 0,0:13:23.84,0:13:25.17,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:25.26,0:13:27.22,Default,,0,0,0,,Сонда бұл не үшін?
Dialogue: 0,0:13:27.89,0:13:29.80,Default,,0,0,0,,Легоши-сенпайға жеңіліп қалсаңыз
Dialogue: 0,0:13:29.89,0:13:32.35,Default,,0,0,0,,Өйткені біз енді ешқашан кездеспеуіміз мүмкін
Dialogue: 0,0:13:32.43,0:13:34.85,Default,,0,0,0,,Мен мұны болашақта анықтама ретінде сұрағым келді.
Dialogue: 0,0:13:35.98,0:13:40.31,Default,,0,0,0,,Досым, мен ет жейтіндерді жиі көре алмаймын.
Dialogue: 0,0:13:41.61,0:13:46.03,Default,,0,0,0,,Сіз бұрын Тем мырзаны жеуді жоспарлағансыз ба?
Dialogue: 0,0:13:46.11,0:13:49.53,Default,,0,0,0,,Әлде сіз импульсивті тамақтандыңыз ба?
Dialogue: 0,0:13:49.62,0:13:53.33,Default,,0,0,0,,Хмм... Солай деп ойлаймын.
Dialogue: 0,0:13:53.41,0:13:55.83,Default,,0,0,0,,Мен бұл туралы айтқым келмейді.
Dialogue: 0,0:13:56.75,0:13:58.21,Default,,0,0,0,,Пина-кун
Dialogue: 0,0:13:58.29,0:13:59.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:59.54,0:14:00.54,Default,,0,0,0,,Вуайеризм
Dialogue: 0,0:14:00.63,0:14:02.04,Default,,0,0,0,,Бұл қылмыс
Dialogue: 0,0:14:02.13,0:14:02.96,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:04.42,0:14:06.63,Default,,0,0,0,,«Мені өлтір!»
Dialogue: 0,0:14:06.72,0:14:09.59,Default,,0,0,0,,«Мен сенен қорықпаймын».
Dialogue: 0,0:14:09.68,0:14:11.10,Default,,0,0,0,,Бұл сөздер...
Dialogue: 0,0:14:11.18,0:14:12.72,Default,,0,0,0,,(Пинаның үрейлі дауысы)
Dialogue: 0,0:14:12.81,0:14:14.68,Default,,0,0,0,,Сіз мұны шынымен айтқыңыз келді, солай емес пе?
Dialogue: 0,0:14:14.77,0:14:17.77,Default,,0,0,0,,(Пинаның үрейлі дауысы)
Dialogue: 0,0:14:26.07,0:14:29.11,Default,,0,0,0,,Бұл қалатын нәрсе ме?
Dialogue: 0,0:14:29.20,0:14:34.03,Default,,0,0,0,,Бет таңбаларының өзгеруі сол адамның өміріндегі бетбұрысты білдіреді.
Dialogue: 0,0:14:34.83,0:14:36.62,Default,,0,0,0,,Жеңіңіз немесе жеңіліңіз
Dialogue: 0,0:14:36.70,0:14:38.29,Default,,0,0,0,,Сол шайқастан
Dialogue: 0,0:14:38.37,0:14:41.46,Default,,0,0,0,,Сіздің өміріңіз түбегейлі өзгеруі мүмкін.
Dialogue: 0,0:14:42.29,0:14:46.17,Default,,0,0,0,,Өмір де, өлім де қатал.
Dialogue: 0,0:14:46.80,0:14:51.09,Default,,0,0,0,,Ет пен шөпқоректі, Екі ауруды да ойлап.
Dialogue: 0,0:14:51.18,0:14:55.18,Default,,0,0,0,,Міне, ол күшті болды, бір бөлек жыртқыш.
Dialogue: 0,0:14:56.02,0:14:57.35,Default,,0,0,0,,Өзіңізге сенімді болыңыз
Dialogue: 0,0:15:01.56,0:15:02.61,Default,,0,0,0,,Гохин мырза
Dialogue: 0,0:15:03.86,0:15:05.36,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:13.37,0:15:18.58,Default,,0,0,0,,Қазір ойлап қарасам, әр Жаңа жыл түні Джекпен бірге өтті.
Dialogue: 0,0:15:19.87,0:15:24.13,Default,,0,0,0,,Егер мен бүгін түнде өлсем, Джек қайғыруы мүмкін.
Dialogue: 0,0:15:24.21,0:15:26.34,Default,,0,0,0,,Бірдеңе болса жылап жіберуім мүмкін
Dialogue: 0,0:15:26.42,0:15:28.88,Default,,0,0,0,,701-бөлмедегі жігіттер де.
Dialogue: 0,0:15:28.96,0:15:31.43,Default,,0,0,0,,Барлығы да драма үйірмесіне қатысады
Dialogue: 0,0:15:32.34,0:15:33.80,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:34.43,0:15:37.85,Default,,0,0,0,,Соңғы бір жылда өзіме ұнайтын көптеген адамдарды кездестірдім.
Dialogue: 0,0:15:40.68,0:15:43.60,Default,,0,0,0,,Мен Хару-чанның мұңайып тұрғанын елестеткім келмейді.
Dialogue: 0,0:15:44.73,0:15:47.44,Default,,0,0,0,,Жасымнан өтіп кетсем
Dialogue: 0,0:15:48.65,0:15:50.40,Default,,0,0,0,,Даусыңды тыңдайық
Dialogue: 0,0:15:55.41,0:15:56.49,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:02.46,0:16:03.29,Default,,0,0,0,,Босс
Dialogue: 0,0:16:03.37,0:16:05.00,Default,,0,0,0,,Бұл толық ай
Dialogue: 0,0:16:05.08,0:16:07.25,Default,,0,0,0,,Толық ай...
Dialogue: 0,0:16:07.34,0:16:09.34,Default,,0,0,0,,Бұл сәттілік пе, әлде жамандық па?
Dialogue: 0,0:16:09.42,0:16:11.26,Default,,0,0,0,,Мен жақсы екеніне сенімдімін.
Dialogue: 0,0:16:11.34,0:16:14.09,Default,,0,0,0,,Біз қаскөйлерді бірден өлтіреміз.
Dialogue: 0,0:16:14.18,0:16:16.51,Default,,0,0,0,,Бұл бірден өлтіру емес еді.
Dialogue: 0,0:16:16.60,0:16:17.76,Default,,0,0,0,,Ах... бірақ
Dialogue: 0,0:16:17.85,0:16:21.89,Default,,0,0,0,,Бастықтың бетіндегі тыртық менің абайсыздығымнан екені анық.
Dialogue: 0,0:16:21.98,0:16:23.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:23.23,0:16:24.81,Default,,0,0,0,,О? жиіркенішті
Dialogue: 0,0:16:24.90,0:16:27.52,Default,,0,0,0,,Хехехе Хидена
Dialogue: 0,0:16:28.40,0:16:30.23,Default,,0,0,0,,Келесіде солай айтсаң, атып саламын.
Dialogue: 0,0:16:30.32,0:16:33.53,Default,,0,0,0,,(Еркін күлкі)
Dialogue: 0,0:16:33.61,0:16:36.07,Default,,0,0,0,,Шишигуми өзгерді
Dialogue: 0,0:16:36.70,0:16:41.16,Default,,0,0,0,,Жыртқыштар қорғайтын бірдеңесі болған кезде күшті болады.
Dialogue: 0,0:16:42.54,0:16:45.96,Default,,0,0,0,,Мұны ешкім білмеді.
Dialogue: 0,0:16:46.58,0:16:51.38,Default,,0,0,0,,Денем күшті болғандықтан, жүрегім терең, достарыма қамқормын.
Dialogue: 0,0:16:52.80,0:16:57.85,Default,,0,0,0,,Етке құмар болғандықтан, оның бетінде үнемі аздап ауырған көрініс бар.
Dialogue: 0,0:16:59.22,0:17:02.73,Default,,0,0,0,,Мен жыртқыштарды жақсы көремін
Dialogue: 0,0:17:03.39,0:17:05.69,Default,,0,0,0,,Осындай уақытта қалай түсіне аласыз?
Dialogue: 0,0:17:06.73,0:17:10.90,Default,,0,0,0,,Содан бері көп уақыт өткен шығар...
Dialogue: 0,0:17:11.53,0:17:15.65,Default,,0,0,0,,Өйткені ол... сол ақымақ сонда болды.
Dialogue: 0,0:17:19.45,0:17:21.62,Default,,0,0,0,,Мен Ибукимін
Dialogue: 0,0:17:22.95,0:17:24.25,Default,,0,0,0,,Шишигумиден кету
Dialogue: 0,0:17:24.33,0:17:26.54,Default,,0,0,0,,ше? Ол шығады ма?
Dialogue: 0,0:17:27.25,0:17:28.58,Default,,0,0,0,,Не болды, бастық?
Dialogue: 0,0:17:28.67,0:17:30.04,Default,,0,0,0,,Мен сені көруге баруым керек.
Dialogue: 0,0:17:30.13,0:17:31.05,Default,,0,0,0,,Қазір
Dialogue: 0,0:17:31.13,0:17:33.17,Default,,0,0,0,,Сізді жақсы көретін адам өлуі мүмкін.
Dialogue: 0,0:17:33.26,0:17:35.59,Default,,0,0,0,,Сондықтан топтан шығудың қажеті жоқ.
Dialogue: 0,0:17:35.67,0:17:36.88,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:36.97,0:17:40.85,Default,,0,0,0,,«Артқы базарға» қашқан мен оның қайсарлығына куә бола алмаймын.
Dialogue: 0,0:17:40.93,0:17:45.23,Default,,0,0,0,,Бұл Шиши-гумиден маңыздырақ па?
Dialogue: 0,0:17:45.31,0:17:47.14,Default,,0,0,0,,Салыстыру мүмкін емес
Dialogue: 0,0:17:47.23,0:17:50.40,Default,,0,0,0,,Бірақ мен кетуім керек.
Dialogue: 0,0:17:50.48,0:17:52.52,Default,,0,0,0,,Мен қашып жүрген нәрсеге
Dialogue: 0,0:17:52.61,0:17:54.94,Default,,0,0,0,,Ол маған қарсы тұруға тырысады.
Dialogue: 0,0:17:56.36,0:17:58.66,Default,,0,0,0,,Ол тым керемет
Dialogue: 0,0:17:59.57,0:18:00.74,Default,,0,0,0,,зұлым қылмыстарды болдырмау үшін, бірақ —
Dialogue: 0,0:18:00.82,0:18:02.08,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:02.16,0:18:06.29,Default,,0,0,0,,Сіз досыңызды қалауыңыз бойынша құтқарып, кейін қайтып оралуды жоспарлап отырсыз ба?
Dialogue: 0,0:18:06.37,0:18:08.54,Default,,0,0,0,,Сіз түсіндім деп жатырсыз, солай емес пе?
Dialogue: 0,0:18:09.50,0:18:11.21,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:12.96,0:18:17.13,Default,,0,0,0,,Ибуки, сен сондай үлкен болдың ба?
Dialogue: 0,0:18:17.84,0:18:22.10,Default,,0,0,0,,Маған қамқорлық жасау үшін ылғи еңкейетін едің.
Dialogue: 0,0:18:29.98,0:18:33.11,Default,,0,0,0,,Кішкене көлікпен жүргіңіз келе ме?
Dialogue: 0,0:18:43.87,0:18:47.54,Default,,0,0,0,,Сізді күтуге мәжбүрлегенім үшін кешіріңіз.
Dialogue: 0,0:18:47.62,0:18:49.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:49.54,0:18:51.46,Default,,0,0,0,,Уақыт тамаша.
Dialogue: 0,0:18:51.54,0:18:54.46,Default,,0,0,0,,Сіз тіпті осындай сәттерде өте байсалдысыз.
Dialogue: 0,0:18:54.55,0:18:57.88,Default,,0,0,0,,Жоқ, жарайды... Оны бастаған менмін.
Dialogue: 0,0:18:57.97,0:19:01.76,Default,,0,0,0,,Луи-сенпай келмеді.
Dialogue: 0,0:19:01.84,0:19:03.97,Default,,0,0,0,,...және қашан бастау керек?
Dialogue: 0,0:19:04.05,0:19:05.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:05.10,0:19:08.48,Default,,0,0,0,,Мен старттық гонгты осында дайындадым.
Dialogue: 0,0:19:08.56,0:19:11.48,Default,,0,0,0,,Байқамасаң мағынасыз.
Dialogue: 0,0:19:11.56,0:19:12.94,Default,,0,0,0,,Гонг?
Dialogue: 0,0:19:13.69,0:19:16.36,Default,,0,0,0,,Сіздің ашу-ызаңыздың өшуі...
Dialogue: 0,0:19:16.44,0:19:17.28,Default,,0,0,0,,（）
Dialogue: 0,0:19:17.36,0:19:18.86,Default,,0,0,0,,Егер баспасаңыз
Dialogue: 0,0:19:18.94,0:19:21.07,Default,,0,0,0,,（）
Dialogue: 0,0:19:18.94,0:19:21.07,Default,,0,0,0,,Күрделі қақтығыс бола алмаймын деп ойлаңыз.
Dialogue: 0,0:19:21.07,0:19:21.95,Default,,0,0,0,,Күрделі қақтығыс бола алмаймын деп ойлаңыз.
Dialogue: 0,0:19:22.03,0:19:23.12,Default,,0,0,0,,Қанның иісі...
Dialogue: 0,0:19:23.12,0:19:24.12,Default,,0,0,0,,Қанның иісі...
Dialogue: 0,0:19:23.12,0:19:24.12,Default,,0,0,0,,(сыдырманың ашылған дыбысы)
Dialogue: 0,0:19:26.70,0:19:29.37,Default,,0,0,0,,Бір қуыршақ Биггорн
Dialogue: 0,0:19:30.58,0:19:33.08,Default,,0,0,0,,Мен күткендей қарным ашты.
Dialogue: 0,0:19:35.25,0:19:36.46,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:19:37.21,0:19:39.17,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:19:48.77,0:19:51.23,Default,,0,0,0,,Шынымды айтсам, сәл таң қалсаңыз.
Dialogue: 0,0:19:51.31,0:19:53.77,Default,,0,0,0,,Мен сені дірілдеп, шегініп кетесің деп ойладым.
Dialogue: 0,0:19:54.81,0:19:57.44,Default,,0,0,0,,Бастық қабағын да татырмады.
Dialogue: 0,0:19:58.03,0:20:01.45,Default,,0,0,0,,Бастық Сіздей күшті аң жоқ.
Dialogue: 0,0:20:02.40,0:20:03.61,Default,,0,0,0,,Мен бұрыннан…
Dialogue: 0,0:20:03.70,0:20:06.16,Default,,0,0,0,,Мен сізден басқа ешкімді бастық деп санай алмаймын.
Dialogue: 0,0:20:07.53,0:20:09.41,Default,,0,0,0,,Күшті аң?
Dialogue: 0,0:20:09.49,0:20:13.29,Default,,0,0,0,,...Арыстан маған бұл сөзді айтса, мен мүлдем қуанбаймын.
Dialogue: 0,0:20:14.00,0:20:16.59,Default,,0,0,0,,Арыстанның күші – қару ғана.
Dialogue: 0,0:20:17.21,0:20:18.92,Default,,0,0,0,,Мен сені кездестіргенге дейін
Dialogue: 0,0:20:19.00,0:20:22.55,Default,,0,0,0,,Мен тіпті сол қарумен өзімді жараладым.
Dialogue: 0,0:20:23.22,0:20:24.05,Default,,0,0,0,,Ибуки
Dialogue: 0,0:20:24.13,0:20:27.10,Default,,0,0,0,,Аңдар патшасының рөлін ойнай бер
Dialogue: 0,0:20:27.18,0:20:31.18,Default,,0,0,0,,Бұл жыртқыштың «бақыты».
Dialogue: 0,0:20:33.52,0:20:36.19,Default,,0,0,0,,Мен кейіп танытып жүрмін
Dialogue: 0,0:20:36.27,0:20:39.15,Default,,0,0,0,,Айналаңыздағылардың қорқынышты көзқарасы арқылы үлкейген.
Dialogue: 0,0:20:39.23,0:20:41.69,Default,,0,0,0,,Көп ұзамай бұл тіпті мен үшін тым ауыр болды.
Dialogue: 0,0:20:41.78,0:20:45.11,Default,,0,0,0,,Үлкен қара кесекке айналды
Dialogue: 0,0:20:46.57,0:20:52.08,Default,,0,0,0,,Сол кезде маған қараған түрің біртүрлі еді.
Dialogue: 0,0:20:52.91,0:20:54.50,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:20:55.04,0:20:57.92,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:20:59.50,0:21:03.97,Default,,0,0,0,,Сізбен өткен күндерім менің 35 жылдық өмірімдегі ең қолайлы күн болды.
Dialogue: 0,0:21:04.72,0:21:06.55,Default,,0,0,0,,Біртекті емес өмір сүру дегеніміз не?
Dialogue: 0,0:21:06.64,0:21:07.80,Default,,0,0,0,,Хаха
Dialogue: 0,0:21:07.89,0:21:09.05,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:09.14,0:21:12.98,Default,,0,0,0,,Менің ондай күндерде өмір сүруім маған жараспайды.
Dialogue: 0,0:21:15.44,0:21:20.19,Default,,0,0,0,,Менің орным мына туннель сияқты қараңғы.
Dialogue: 0,0:21:21.53,0:21:24.24,Default,,0,0,0,,Мұнда өмір сүруге кепілдік жоқ.
Dialogue: 0,0:21:26.24,0:21:29.87,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:32.04,0:21:38.04,Default,,0,0,0,,♪～
Dialogue: 0,0:22:52.24,0:22:58.25,Default,,0,0,0,,～♪
