Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.24,0:00:44.48,Default,,0,0,0,,Аспандағы жеті жұлдыздың астында
Dialogue: 0,0:00:44.48,0:00:48.12,Default,,0,0,0,,1800 жыл бойы
Dialogue: 0,0:00:48.12,0:00:51.05,Default,,0,0,0,,Ұзақ уақыт бойы мұраға қалдырылды.
Dialogue: 0,0:00:51.05,0:00:54.36,Default,,0,0,0,,Хокуто Шинкен
Dialogue: 0,0:00:54.36,0:00:57.99,Default,,0,0,0,,Барлық күш-қуатыңызды бір жұдырыққа жинаңыз
Dialogue: 0,0:00:57.99,0:01:02.16,Default,,0,0,0,,Дененің меридиандық тесіктерін соғу
Dialogue: 0,0:01:02.16,0:01:05.40,Default,,0,0,0,,Оның сыры оны ішінен жою еді.
Dialogue: 0,0:01:05.40,0:01:08.50,Default,,0,0,0,,Бір атудан сенімді жекпе-жек
Dialogue: 0,0:01:14.11,0:01:17.38,Default,,0,0,0,,Аса жойқын күші бар қастандық
Dialogue: 0,0:01:17.38,0:01:22.15,Default,,0,0,0,,Оқиғаны жұртшылықтан жасыру үшін бір ғана адам жеткізу керек.
Dialogue: 0,0:01:22.15,0:01:25.65,Default,,0,0,0,,Мен бір баладан екінші балаға мұрагер болу ережесін ұстануды жалғастырдым.
Dialogue: 0,0:01:27.66,0:01:31.89,Default,,0,0,0,,Алайда, алдыңғы Рюкең ұл тудырған жоқ.
Dialogue: 0,0:01:31.89,0:01:36.09,Default,,0,0,0,,Үш баланы асырап алды
Dialogue: 0,0:01:45.04,0:01:47.14,Default,,0,0,0,,Гувахаа!
Dialogue: 0,0:01:52.21,0:01:54.62,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:01:54.62,0:01:56.92,Default,,0,0,0,,Хо атаа!
Dialogue: 0,0:02:03.06,0:02:06.73,Default,,0,0,0,,Раох, сен не ойлап тұрсың?
Dialogue: 0,0:02:06.73,0:02:09.73,Default,,0,0,0,,Баланың күшті болғанын қалайсың ба?
Dialogue: 0,0:02:09.73,0:02:13.54,Default,,0,0,0,,Әлде бұл кедергі болды ма?
Dialogue: 0,0:02:13.54,0:02:16.31,Default,,0,0,0,,Хмф, егер бала жеңілсе.
Dialogue: 0,0:02:16.31,0:02:19.34,Default,,0,0,0,,Бұл жерден тірі шыға алмайсың.
Dialogue: 0,0:02:19.34,0:02:23.08,Default,,0,0,0,,Бұл Нанто Джунин Кумите заңы.
Dialogue: 0,0:02:23.08,0:02:26.68,Default,,0,0,0,,Хокуто Шинкеннің жігіттері де ерекше емес.
Dialogue: 0,0:02:30.49,0:02:34.36,Default,,0,0,0,,Мен білемін. Сіз Кеншироның қасиеттеріне ғашық болдыңыз ба?
Dialogue: 0,0:02:34.36,0:02:37.36,Default,,0,0,0,,Оңтүстiк, үнiңдi жап, бақылап тұр.
Dialogue: 0,0:02:39.33,0:02:43.63,Default,,0,0,0,,Сіз естідіңіз бе? Шу, бұл қызық болып барады.
Dialogue: 0,0:02:43.63,0:02:45.97,Default,,0,0,0,,Эй, хе!
Dialogue: 0,0:02:45.97,0:02:49.07,Default,,0,0,0,,Әй, жылы!
Dialogue: 0,0:03:07.99,0:03:11.86,Default,,0,0,0,,Сіз қайда қарап тұрсыз? Бұл сіздің қарсыласыңыз!
Dialogue: 0,0:03:11.86,0:03:14.26,Default,,0,0,0,,Ватаа! Апыр-ай!
Dialogue: 0,0:03:18.70,0:03:21.47,Default,,0,0,0,,Сіз мұнымен күресетін адам боламын деп айтасыз ба?
Dialogue: 0,0:03:21.47,0:03:25.34,Default,,0,0,0,,Мен босатқан энергияны ұстадым
Dialogue: 0,0:03:25.34,0:03:27.94,Default,,0,0,0,,Мен жауап беруім керек
Dialogue: 0,0:03:37.32,0:03:40.59,Default,,0,0,0,,Соңғы оныншы адам менмін.
Dialogue: 0,0:03:40.59,0:03:43.13,Default,,0,0,0,,Әрине, ол заңды бұзып жатыр ғой.
Dialogue: 0,0:03:43.13,0:03:46.83,Default,,0,0,0,,Иә! Ыстық болды!
Dialogue: 0,0:03:48.86,0:03:53.76,Default,,0,0,0,,Гах! Уф! Арх! Ах! Гах!
Dialogue: 0,0:03:55.77,0:03:57.87,Default,,0,0,0,,Арх! Гах...
Dialogue: 0,0:04:01.91,0:04:06.11,Default,,0,0,0,,Соңғы қарсылас тым нашар болды. Еш нәрсе істей алмайсың.
Dialogue: 0,0:04:11.59,0:04:15.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:15.46,0:04:20.30,Default,,0,0,0,,Да… га… га…
Dialogue: 0,0:04:20.30,0:04:22.63,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:04:22.63,0:04:28.04,Default,,0,0,0,,Менің соңғы қарсыласым сен болғанына қуаныштымын.
Dialogue: 0,0:04:28.04,0:04:31.67,Default,,0,0,0,,Басқа мектептерден жеңілгендер бұл жерден тірі шыға алмайды.
Dialogue: 0,0:04:31.67,0:04:34.38,Default,,0,0,0,,Соқуды аяқтаңыз
Dialogue: 0,0:04:34.38,0:04:37.85,Default,,0,0,0,,Күте тұрыңыз! Мен бұған қарағанда көбірек қарсыласпын.
Dialogue: 0,0:04:37.85,0:04:41.72,Default,,0,0,0,,Хмм... Хокутоның екінші ұлы Бо пайда болды ма?
Dialogue: 0,0:04:41.72,0:04:47.22,Default,,0,0,0,,Токи! Қарсы болсаң, сен де өлесің.
Dialogue: 0,0:04:47.22,0:04:50.13,Default,,0,0,0,,Жақсы, егер мүмкін болса.
Dialogue: 0,0:04:50.13,0:04:52.13,Default,,0,0,0,,Мен бұл баланың өлуіне жол бермеймін
Dialogue: 0,0:04:52.13,0:04:54.56,Default,,0,0,0,,Нанто ережелеріне бағынбауды жоспарлап отырсыз ба?
Dialogue: 0,0:04:54.56,0:04:59.50,Default,,0,0,0,,Бұл баланың басқаларға қарағанда жарқырап, жарқырауға мүмкіндігі бар.
Dialogue: 0,0:04:59.50,0:05:03.77,Default,,0,0,0,,Шу, сен болсаң да, маған еліктегеніңді кешірмеймін.
Dialogue: 0,0:05:03.77,0:05:07.64,Default,,0,0,0,,Мен сенен өміріңді тегін бер деп сұрамаймын.
Dialogue: 0,0:05:07.64,0:05:09.74,Default,,0,0,0,,орнына
Dialogue: 0,0:05:14.98,0:05:17.08,Default,,0,0,0,,Га
Dialogue: 0,0:05:21.82,0:05:26.03,Default,,0,0,0,,Мен саған шамымды беремін
Dialogue: 0,0:05:26.03,0:05:28.43,Default,,0,0,0,,Шағымданатын нәрсе бар ма?
Dialogue: 0,0:05:30.80,0:05:32.90,Default,,0,0,0,,Жарайды, мен оны қазір суға толтырамын.
Dialogue: 0,0:05:48.18,0:05:53.02,Default,,0,0,0,,Мен оның «Джинсей» адамы екенін ұмытып қалдым.
Dialogue: 0,0:05:53.02,0:05:55.92,Default,,0,0,0,,Солай болса да Шудың жүрегінде тығылып тұрды.
Dialogue: 0,0:05:55.92,0:05:59.43,Default,,0,0,0,,Джинсейдің қожайын жұлдызының оянуы қандай?
Dialogue: 0,0:05:59.43,0:06:01.83,Default,,0,0,0,,Сол бала
Dialogue: 0,0:06:09.07,0:06:13.08,Default,,0,0,0,,Уақыт өтті, екеуі де жұдырықтай жарады.
Dialogue: 0,0:06:13.08,0:06:17.38,Default,,0,0,0,,Ағайынды үш Раох, Токи және Кенширо арқылы
Dialogue: 0,0:06:17.38,0:06:24.19,Default,,0,0,0,,Хокуто Шинкеннің 1800 жылдық тарихы өзінің ең күшті дәуіріне қадам басуға жақын болды.
Dialogue: 0,0:06:24.19,0:06:30.86,Default,,0,0,0,,Бірақ бұл трагедияның басы да болды.
Dialogue: 0,0:06:30.86,0:06:36.27,Default,,0,0,0,,Заман да қайта-қайта менмен болды.
Dialogue: 0,0:06:36.27,0:06:40.50,Default,,0,0,0,,Көптеген өркениеттерді жойған тарихты ұмытыңыз.
Dialogue: 0,0:06:40.50,0:06:43.40,Default,,0,0,0,,Біз тағы да соғыс дәуіріне қадам басатын болдық.
Dialogue: 0,0:06:45.34,0:06:48.38,Default,,0,0,0,,Этникалық және діни қақтығыстар
Dialogue: 0,0:06:48.38,0:06:51.78,Default,,0,0,0,,Ұлы державалардың гегемонияға деген амбициясы
Dialogue: 0,0:06:51.78,0:06:55.98,Default,,0,0,0,,Адамзаттың тоқтаусыз ессіздігі бітпейтін тізбек.
Dialogue: 0,0:06:55.98,0:06:59.88,Default,,0,0,0,,Ақырында әлемді жойылуға әкелді
Dialogue: 0,0:07:03.53,0:07:06.13,Default,,0,0,0,,Теңіз құрғап, жер жарылған.
Dialogue: 0,0:07:06.13,0:07:09.93,Default,,0,0,0,,Барлық тіршілік түрлері жойылып кеткендей болды.
Dialogue: 0,0:07:09.93,0:07:14.40,Default,,0,0,0,,Бірақ адамзат жойылған жоқ.
Dialogue: 0,0:07:14.40,0:07:20.08,Default,,0,0,0,,Барлық өркениеттер күйреді, зорлық-зомбылық тағы да әлемді биледі.
Dialogue: 0,0:07:20.08,0:07:23.31,Default,,0,0,0,,Тірі тозақтағы дәрменсіздер
Dialogue: 0,0:07:23.31,0:07:26.22,Default,,0,0,0,,Мен жай ғана дұға еттім.
Dialogue: 0,0:07:26.22,0:07:29.69,Default,,0,0,0,,Мәсіхтің пайда болуы
Dialogue: 0,0:07:29.69,0:07:31.99,Default,,0,0,0,,Жай... жай...
Dialogue: 0,0:07:34.02,0:07:38.36,Default,,0,0,0,,Бір күні жұдырықтасып қалатынымыз сөзсіз тағдыр.
Dialogue: 0,0:07:38.36,0:07:40.86,Default,,0,0,0,,Үш адам да
Dialogue: 0,0:07:40.86,0:07:45.30,Default,,0,0,0,,Аумалы-төкпелі заманда жарқырап тұратын Солтүстік жұлдыздың басшылығымен
Dialogue: 0,0:07:45.30,0:07:49.07,Default,,0,0,0,,Бір-біріміздің жолымызда жүрдік.
Dialogue: 0,0:07:49.07,0:07:51.47,Default,,0,0,0,,Кенширо дәстүрді жалғастырушы болды.
Dialogue: 0,0:07:51.47,0:07:53.41,Default,,0,0,0,,Көп қайғыны арқалаған
Dialogue: 0,0:07:53.41,0:07:55.81,Default,,0,0,0,,Оны күшке айналдыру арқылы
Dialogue: 0,0:07:55.81,0:08:02.32,Default,,0,0,0,,Ол шынымен Хокуто Шинкеннің мұрагері болуға лайықты адамға айналды.
Dialogue: 0,0:08:02.32,0:08:04.25,Default,,0,0,0,,Ібіс өлімнің күліне шомылды
Dialogue: 0,0:08:04.25,0:08:07.02,Default,,0,0,0,,Хокуто Шинкенді дәрі ретінде қолдану
Dialogue: 0,0:08:07.02,0:08:12.83,Default,,0,0,0,,Ол өмірінің соңына дейін жарақат алған адамдарды емдеумен айналысты.
Dialogue: 0,0:08:12.83,0:08:15.83,Default,,0,0,0,,Раох Кен-Қорқыныш патшасы ретінде белгілі болды.
Dialogue: 0,0:08:15.83,0:08:20.47,Default,,0,0,0,,Осы бейберекет дүниенің билеушісі ретінде билік ету үшін өз күшімді пайдалану
Dialogue: 0,0:08:20.47,0:08:23.97,Default,,0,0,0,,Сойысқан күндерім өтті, енді
Dialogue: 0,0:08:23.97,0:08:29.27,Default,,0,0,0,,Жеңіске жеткен күн сәт сайын жақындай берді.
Dialogue: 0,0:08:49.10,0:08:54.37,Default,,0,0,0,,Хи хи... Хахаха... Не істеп жатырсың?
Dialogue: 0,0:08:54.37,0:08:56.84,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:56.84,0:09:00.71,Default,,0,0,0,,Ой! Nu! Апыр-ай!
Dialogue: 0,0:09:00.71,0:09:04.21,Default,,0,0,0,,Тезірек, ол баланы жараламай тұрғанда маған беріңіз.
Dialogue: 0,0:09:07.42,0:09:12.25,Default,,0,0,0,,Үлкен аға! Мен бұл баланы жібермеймін, сондықтан...
Dialogue: 0,0:09:12.25,0:09:16.25,Default,,0,0,0,,О, хи хи...
Dialogue: 0,0:09:18.19,0:09:21.40,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:09:21.40,0:09:25.03,Default,,0,0,0,,Сіз өліп бара жатқан сияқтысыз
Dialogue: 0,0:09:25.03,0:09:27.44,Default,,0,0,0,,Хамф!
Dialogue: 0,0:09:27.44,0:09:30.14,Default,,0,0,0,,Ах! Тататата! ол аурады! ол аурады! Үлкен аға!
Dialogue: 0,0:09:30.14,0:09:32.41,Default,,0,0,0,,Ой! Эй! Мынаны қара!
Dialogue: 0,0:09:32.41,0:09:35.31,Default,,0,0,0,,Уау! Қозғалайық!
Dialogue: 0,0:09:35.31,0:09:38.68,Default,,0,0,0,,Бұл Токи жігіттері! Tsk, бақытты бейбақ.
Dialogue: 0,0:09:38.68,0:09:43.52,Default,,0,0,0,,Сонда жолы болмай қалады
Dialogue: 0,0:09:43.52,0:09:46.99,Default,,0,0,0,,Сіз әлдеқашан өлдіңіз
Dialogue: 0,0:09:46.99,0:09:50.46,Default,,0,0,0,,Не, мына жігіт жынды емес пе? Эй!
Dialogue: 0,0:09:50.46,0:09:54.46,Default,,0,0,0,,Үлкен аға! тез! Хахаха...
Dialogue: 0,0:09:56.37,0:09:58.53,Default,,0,0,0,,Кен! Сен не істеп жатырсың?
Dialogue: 0,0:09:58.53,0:10:01.44,Default,,0,0,0,,Егер сіз кенеттен жоғалып кетсеңіз ше?
Dialogue: 0,0:10:01.44,0:10:05.37,Default,,0,0,0,,Қандай арам бала! батпырауық!
Dialogue: 0,0:10:05.37,0:10:10.67,Default,,0,0,0,,Ба... Бат-нии-чан, ауыл... Көмектесші, ауыл...
Dialogue: 0,0:10:12.85,0:10:15.28,Default,,0,0,0,,Әй, өтінемін, қария.
Dialogue: 0,0:10:15.28,0:10:17.29,Default,,0,0,0,,Осылай басыңды иіп тұрсың.
Dialogue: 0,0:10:17.29,0:10:19.45,Default,,0,0,0,,Кішкене айналма жолмен жүру дұрыс емес пе?
Dialogue: 0,0:10:19.45,0:10:22.66,Default,,0,0,0,,Мен бұл баланы ұстауға қарсы емеспін.
Dialogue: 0,0:10:22.66,0:10:25.56,Default,,0,0,0,,Ауылыңызға айналма жолмен баруға уақытым жоқ.
Dialogue: 0,0:10:25.56,0:10:29.16,Default,,0,0,0,,Науқастарды мүмкіндігінше тезірек ибиспен емдеу керек.
Dialogue: 0,0:10:29.16,0:10:34.30,Default,,0,0,0,,Бірақ ей, адам! Менің ауылым менің ауылым
Dialogue: 0,0:10:34.30,0:10:37.04,Default,,0,0,0,,Эй Кен, қайда бара жатырсың?
Dialogue: 0,0:10:37.04,0:10:39.91,Default,,0,0,0,,Науқастарды Токиге тез жеткізіңіз
Dialogue: 0,0:10:39.91,0:10:43.78,Default,,0,0,0,,Ал, күте тұр, мен саған жол көрсетемін! Мен де барамын!
Dialogue: 0,0:10:43.78,0:10:48.02,Default,,0,0,0,,Бұл толығымен сізге байланысты, Қасиетті император, баланы тапсырыңыз.
Dialogue: 0,0:10:48.02,0:10:50.82,Default,,0,0,0,,Үйрек дәмді тамақ жейді.
Dialogue: 0,0:10:50.82,0:10:54.69,Default,,0,0,0,,Fufufuhyo no Shakeranrei Үлкен аға! Сен не туралы айтып тұрсың?
Dialogue: 0,0:10:54.69,0:10:58.23,Default,,0,0,0,,Жоқ, біраз уақыттан бері аузым дұрыс жабылмайды.
Dialogue: 0,0:10:58.23,0:11:02.66,Default,,0,0,0,,О? А... аа!
Dialogue: 0,0:11:02.66,0:11:04.66,Default,,0,0,0,,Сәлем Сәлем...
Dialogue: 0,0:11:07.50,0:11:11.37,Default,,0,0,0,,Біз мұнда жасырынбақ ойнайтынбыз.
Dialogue: 0,0:11:11.37,0:11:13.64,Default,,0,0,0,,Бұрынғыдан мүлде өзгерген жоқ.
Dialogue: 0,0:11:13.64,0:11:15.61,Default,,0,0,0,,Үйден неге қашып кеттің?
Dialogue: 0,0:11:15.61,0:11:19.01,Default,,0,0,0,,Шешілген жоқ па? Мен мұндай жерде тұра алмаймын...
Dialogue: 0,0:11:19.01,0:11:21.78,Default,,0,0,0,,Сіздің туған қалаңыз, солай ма? Жоқ... ол не?
Dialogue: 0,0:11:21.78,0:11:25.65,Default,,0,0,0,,Үйге баратын жердің болуы мені қуантады.
Dialogue: 0,0:11:25.65,0:11:28.92,Default,,0,0,0,,Түсіндім, сенің ауылың әлдеқашан...
Dialogue: 0,0:11:28.92,0:11:32.29,Default,,0,0,0,,Уау! ?
Dialogue: 0,0:11:32.29,0:11:36.16,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,0:11:36.16,0:11:38.80,Default,,0,0,0,,Та... өтінемін! Өйткені өтінемін
Dialogue: 0,0:11:38.80,0:11:41.30,Default,,0,0,0,,Ол... өтінемін, мені өлтірме!
Dialogue: 0,0:11:45.37,0:11:47.77,Default,,0,0,0,,Ой... уау!
Dialogue: 0,0:11:57.92,0:12:00.29,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:00.29,0:12:02.22,Default,,0,0,0,,Бұл жауыз
Dialogue: 0,0:12:02.22,0:12:07.16,Default,,0,0,0,,Ол кісі бізді мына жігіттерден құтқарды.
Dialogue: 0,0:12:07.16,0:12:09.56,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:16.41,0:12:18.34,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:12:18.34,0:12:20.34,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:23.08,0:12:25.98,Default,,0,0,0,,Жарқанат! Хаг!
Dialogue: 0,0:12:25.98,0:12:27.92,Default,,0,0,0,,Мен оны баяғыда бокқа толы деп ойладым.
Dialogue: 0,0:12:27.92,0:12:30.52,Default,,0,0,0,,Сіз қазір оралуыңыз керек.
Dialogue: 0,0:12:30.52,0:12:32.75,Default,,0,0,0,,Жарқанат аға!
Dialogue: 0,0:12:32.75,0:12:35.16,Default,,0,0,0,,Аха, сен жақсы көрінесің, солай емес пе?
Dialogue: 0,0:12:35.16,0:12:37.96,Default,,0,0,0,,Қайтадан қош келдіңіз! Сәлем де
Dialogue: 0,0:12:46.77,0:12:52.11,Default,,0,0,0,,Хехе, менің қолым шырылдап тұр. Кенох армиясы осар емес.
Dialogue: 0,0:12:52.11,0:12:56.88,Default,,0,0,0,,Бұл таңғажайып сан. Бізден екі есе көп болуы керек.
Dialogue: 0,0:12:56.88,0:13:00.48,Default,,0,0,0,,Қашайық. О, егер біз бұл нәрсемен күрессек.
Dialogue: 0,0:13:00.48,0:13:04.09,Default,,0,0,0,,Сізді өлтіреді!
Dialogue: 0,0:13:04.09,0:13:08.19,Default,,0,0,0,,Сәлем! Ах... Ке... Кенох!
Dialogue: 0,0:13:16.03,0:13:20.37,Default,,0,0,0,,Қараңғы патшаның әскері бізге қарсы соңғы қарсы шабуылға дайындалуда.
Dialogue: 0,0:13:20.37,0:13:23.04,Default,,0,0,0,,Мүмкіндігінше көп сарбаз жинаған сияқтысыз.
Dialogue: 0,0:13:23.04,0:13:25.74,Default,,0,0,0,,Өйткені, бұл жасанды қағаз жолбарыс
Dialogue: 0,0:13:25.74,0:13:29.24,Default,,0,0,0,,Керісінше, Суга, Сауттердің қимылдары қандай?
Dialogue: 0,0:13:29.24,0:13:31.61,Default,,0,0,0,,Әзірге қозғалыс жоқ...
Dialogue: 0,0:13:31.61,0:13:35.88,Default,,0,0,0,,Сақтықты төмендетпеңіз. Ол өзін Қасиетті император деп атайды.
Dialogue: 0,0:13:35.88,0:13:38.59,Default,,0,0,0,,Жолбарыс үстемдік іздейді
Dialogue: 0,0:13:38.59,0:13:43.19,Default,,0,0,0,,Мен оның басын бір күні алуым керек, әйтпесе менің үстемдігіме қауіп төнеді.
Dialogue: 0,0:13:43.19,0:13:47.03,Default,,0,0,0,,Мен түсінемін, бірақ егер біз Аидтың әскерін жеңсек,
Dialogue: 0,0:13:47.03,0:13:50.07,Default,,0,0,0,,Бірге армандаған бағындыруымыз аяқталуға жақын.
Dialogue: 0,0:13:50.07,0:13:53.80,Default,,0,0,0,,Осы шайқастағы ерлігіңді еске алуым керек.
Dialogue: 0,0:13:53.80,0:13:56.44,Default,,0,0,0,,Бұл соға, өмір бойы надандық
Dialogue: 0,0:13:56.44,0:13:59.74,Default,,0,0,0,,Майдан даласында айырылған оң аяғым үшін жылағым келеді.
Dialogue: 0,0:13:59.74,0:14:02.51,Default,,0,0,0,,А... нені қалдыруым керек?
Dialogue: 0,0:14:02.51,0:14:05.25,Default,,0,0,0,,Біріншіден, Аид өлгендердің патшасы.
Dialogue: 0,0:14:05.25,0:14:09.45,Default,,0,0,0,,Егер сен о дүниеде патша болсаң, қарсыласыңмен күресуге тура келеді.
Dialogue: 0,0:14:09.45,0:14:13.05,Default,,0,0,0,,Ешқандай батылдық та, боқтық та жоқ. Хмф.
Dialogue: 0,0:14:15.76,0:14:17.69,Default,,0,0,0,,Жарай ма? үшінна!
Dialogue: 0,0:14:17.69,0:14:21.70,Default,,0,0,0,,Жаудан қорқып, әлсіздер шықсын.
Dialogue: 0,0:14:21.70,0:14:25.50,Default,,0,0,0,,Мына Кен-О сені дәл осы жерде өлтіреді.
Dialogue: 0,0:14:25.50,0:14:28.27,Default,,0,0,0,,Бірде бұзылған жер бетінде
Dialogue: 0,0:14:28.27,0:14:34.41,Default,,0,0,0,,Осы жұдырықтағы күш қана жаңа тәртіп жасай алады.
Dialogue: 0,0:14:34.41,0:14:38.01,Default,,0,0,0,,Ал аспан маған сол күшті берді.
Dialogue: 0,0:14:38.01,0:14:40.95,Default,,0,0,0,,Себеп біздің үстемдігімізде!
Dialogue: 0,0:14:40.95,0:14:47.46,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:14:47.46,0:14:49.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.07,0:15:02.84,Default,,0,0,0,,Керемет, Рейна, менің корольдік гвардиямды басқарады.
Dialogue: 0,0:15:02.84,0:15:05.61,Default,,0,0,0,,Мына жартас дегенді қалай түсінесіңдер?
Dialogue: 0,0:15:05.61,0:15:11.18,Default,,0,0,0,,Менің қаным қайнап жатыр! Қара патша, біз де барайық!
Dialogue: 0,0:15:11.18,0:15:14.28,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:18.62,0:15:22.06,Default,,0,0,0,,Күрсін, мен мұндай тамақты үнемі жей аламын.
Dialogue: 0,0:15:22.06,0:15:25.66,Default,,0,0,0,,Оны жай қалдырыңыз. Енді оны жылы кезде жеп қойыңыз.
Dialogue: 0,0:15:27.83,0:15:30.43,Default,,0,0,0,,Бұл балаларды өзіңіз бағып отырсыз ба?
Dialogue: 0,0:15:32.53,0:15:35.17,Default,,0,0,0,,Ауыл тұрғындарымен ынтымақтасу.
Dialogue: 0,0:15:35.17,0:15:37.11,Default,,0,0,0,,үшінның ата-анасы өлтірілген.
Dialogue: 0,0:15:37.11,0:15:40.68,Default,,0,0,0,,Мен аяғымды байлап тастаған баламын.
Dialogue: 0,0:15:40.68,0:15:43.28,Default,,0,0,0,,Тіпті жаңадан келген ақымақ.
Dialogue: 0,0:15:43.28,0:15:45.98,Default,,0,0,0,,Балалар әрқашан бағаны төлейді
Dialogue: 0,0:15:45.98,0:15:48.32,Default,,0,0,0,,Әулие Император Оңтүстік деген не?
Dialogue: 0,0:15:48.32,0:15:52.19,Default,,0,0,0,,«Мінсіз балалар өз бейіттерін салады» дейді.
Dialogue: 0,0:15:52.19,0:15:54.59,Default,,0,0,0,,Жылқы сияқты еңбек ет
Dialogue: 0,0:15:54.59,0:15:57.99,Default,,0,0,0,,Осындай нәрсе үшін балаларды аулау?
Dialogue: 0,0:15:57.99,0:16:02.60,Default,,0,0,0,,Сендердің арқаларыңда әлгі гиеналар әр жерде қыдырып жүр.
Dialogue: 0,0:16:02.60,0:16:08.34,Default,,0,0,0,,Балаңызды Қасиетті император әскеріне берсеңіз, қалағаныңызды оңай ала аласыз.
Dialogue: 0,0:16:08.34,0:16:11.94,Default,,0,0,0,,Қазіргі уақытта қалалардың баласыз болуы ғажап емес.
Dialogue: 0,0:16:11.94,0:16:16.78,Default,,0,0,0,,Бәрі де сол шайтанның кесірінен.
Dialogue: 0,0:16:16.78,0:16:18.71,Default,,0,0,0,,Оңтүстік…
Dialogue: 0,0:16:18.71,0:16:22.28,Default,,0,0,0,,Кен, сен білесің бе?
Dialogue: 0,0:16:22.28,0:16:25.05,Default,,0,0,0,,Күрсініп... Одан да оңтүстікте
Dialogue: 0,0:16:25.05,0:16:27.96,Default,,0,0,0,,Кенох әскері қайтадан соғыса бастаған сияқты.
Dialogue: 0,0:16:27.96,0:16:29.96,Default,,0,0,0,,Мен қанша уақыт қорқынышпен өмір сүруім керек?
Dialogue: 0,0:16:29.96,0:16:33.09,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес.
Dialogue: 0,0:16:33.09,0:16:35.73,Default,,0,0,0,,Раохтан оңтүстікке...
Dialogue: 0,0:16:35.73,0:16:39.73,Default,,0,0,0,,Олар қандай? Боқ...
Dialogue: 0,0:16:49.91,0:16:53.42,Default,,0,0,0,,Ренжіген жалғыз сен емессің.
Dialogue: 0,0:16:53.42,0:16:55.78,Default,,0,0,0,,Тез кел! Мен оны сонда қалдырамын.
Dialogue: 0,0:16:55.78,0:16:58.08,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:05.13,0:17:07.86,Default,,0,0,0,,Хаха!
Dialogue: 0,0:17:07.86,0:17:10.26,Default,,0,0,0,,Га!
Dialogue: 0,0:17:12.27,0:17:16.67,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:17:16.67,0:17:19.24,Default,,0,0,0,,Өл!
Dialogue: 0,0:17:19.24,0:17:21.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:23.68,0:17:27.55,Default,,0,0,0,,Аид, қарсылық бекер.
Dialogue: 0,0:17:27.55,0:17:30.45,Default,,0,0,0,,Шизуку Каваками, Курона Анку, Наширо
Dialogue: 0,0:17:30.45,0:17:33.55,Default,,0,0,0,,Мен сені жеңсем, болды.
Dialogue: 0,0:17:38.09,0:17:40.69,Default,,0,0,0,,Нуваха!
Dialogue: 0,0:17:43.00,0:17:46.20,Default,,0,0,0,,Рейна Қажетсіз араласудың қажеті жоқ.
Dialogue: 0,0:17:50.67,0:17:54.51,Default,,0,0,0,,Сіз артық нәрсені жасайсыз! әйел?
Dialogue: 0,0:17:54.51,0:17:58.81,Default,,0,0,0,,Ажал! Дайын болыңыз! О!
Dialogue: 0,0:18:01.68,0:18:03.68,Default,,0,0,0,,Өл!
Dialogue: 0,0:18:05.59,0:18:07.89,Default,,0,0,0,,Қалай! Nu!
Dialogue: 0,0:18:10.13,0:18:14.86,Default,,0,0,0,,Хэ-хэ-хэ, бұл ет пен қанды жекпе-жек өнері ғой, болат сынбайтын.
Dialogue: 0,0:18:14.86,0:18:16.80,Default,,0,0,0,,...
Dialogue: 0,0:18:16.80,0:18:20.00,Default,,0,0,0,,Қалағаныңызша өлілер еліне барыңыз.
Dialogue: 0,0:18:20.00,0:18:22.90,Default,,0,0,0,,Не? Уф...
Dialogue: 0,0:18:22.90,0:18:25.81,Default,,0,0,0,,Мен әлі
Dialogue: 0,0:18:25.81,0:18:29.91,Default,,0,0,0,,Жасыру... Буу!
Dialogue: 0,0:18:33.92,0:18:40.05,Default,,0,0,0,,Рейна, сен және ағаң Суга тезірек қамалға оралуларың керек.
Dialogue: 0,0:18:40.05,0:18:43.36,Default,,0,0,0,,Га
Dialogue: 0,0:18:43.36,0:18:47.53,Default,,0,0,0,,Раох Рейна сіздің батылдығыңыз
Dialogue: 0,0:18:47.53,0:18:50.43,Default,,0,0,0,,Шикато, бұл менің көзіме күйіп кетті.
Dialogue: 0,0:18:50.43,0:18:55.64,Default,,0,0,0,,Токи мен Кеншироның жоқтығы ұят.
Dialogue: 0,0:18:55.64,0:19:00.84,Default,,0,0,0,,Осы екеуі сол жерде болса, ерлік оңайырақ болар еді.
Dialogue: 0,0:19:02.78,0:19:05.65,Default,,0,0,0,,Соңғы кездері әскери тәртіптің әлсірегендігі байқалады.
Dialogue: 0,0:19:05.65,0:19:08.85,Default,,0,0,0,,Жаулап алайын деп жатқанда, мынандай нәрсе...
Dialogue: 0,0:19:08.85,0:19:12.25,Default,,0,0,0,,Рао не ойлайды?
Dialogue: 0,0:19:12.25,0:19:16.16,Default,,0,0,0,,Уайымдама, сенесің, солай ма?
Dialogue: 0,0:19:16.16,0:19:19.26,Default,,0,0,0,,Раох туралы басқаларға қарағанда
Dialogue: 0,0:19:23.40,0:19:26.80,Default,,0,0,0,,Суга мырза, келісімдер жасалды.
Dialogue: 0,0:19:26.80,0:19:29.37,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:19:29.37,0:19:34.21,Default,,0,0,0,,Оны көргенде білесің. үшінна айналаны жылдам көрсетіңіз.
Dialogue: 0,0:19:34.21,0:19:36.41,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:19:38.58,0:19:42.45,Default,,0,0,0,,Ағамның ойы
Dialogue: 0,0:19:42.45,0:19:44.55,Default,,0,0,0,,Ағай...
Dialogue: 0,0:19:55.36,0:19:58.86,Default,,0,0,0,,Аидтың да көңілі қалды. Хмм.
Dialogue: 0,0:20:04.54,0:20:07.98,Default,,0,0,0,,Керемет жеңісті тойлауда, бұл Суга
Dialogue: 0,0:20:07.98,0:20:10.68,Default,,0,0,0,,Біз сіздердің назарларыңызға бірнеше идеялар дайындадық.
Dialogue: 0,0:20:14.32,0:20:17.85,Default,,0,0,0,,Қалай ойлайсыңдар, тік тоқылған Суга-дононың талғамы ерекше ме?
Dialogue: 0,0:20:17.85,0:20:21.29,Default,,0,0,0,,Мен мұндай нәрсенің бұрын болғанына сенімдімін...
Dialogue: 0,0:20:21.29,0:20:23.76,Default,,0,0,0,,Бұл жағдайда мойынның физикалық тексеруі деп аталады.
Dialogue: 0,0:20:23.76,0:20:27.36,Default,,0,0,0,,Маған жау генералының отбасы мүшесінің кесілген басын көрсетті.
Dialogue: 0,0:20:27.36,0:20:29.33,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:20:29.33,0:20:32.23,Default,,0,0,0,,Мен одан тезірек босатылғым келеді.
Dialogue: 0,0:20:32.23,0:20:36.04,Default,,0,0,0,,Әйелдер менің қайтуымды күтіп отыр.
Dialogue: 0,0:20:36.04,0:20:40.48,Default,,0,0,0,,Келісемін! Маған кесілген басыңды көрсетсең, мен саған деген ықыласымды жоғалтамын.
Dialogue: 0,0:20:40.48,0:20:45.81,Default,,0,0,0,,Уха...
Dialogue: 0,0:20:45.81,0:20:48.05,Default,,0,0,0,,Бұл жігіттердің ашкөздігі таяз.
Dialogue: 0,0:20:48.05,0:20:50.55,Default,,0,0,0,,Үлкен тілексіз әлемді басқару мүмкін емес.
Dialogue: 0,0:20:52.49,0:20:57.16,Default,,0,0,0,,Адамдарда артықшылық жоқ, ал жаулау алыс...
Dialogue: 0,0:20:57.16,0:21:01.06,Default,,0,0,0,,Суга мерекелер мен жаулап алудың басқа уақыттары үшін қолайлы.
Dialogue: 0,0:21:01.06,0:21:03.70,Default,,0,0,0,,Мойынды тексеруден басқа артықшылықтар пайдасыз.
Dialogue: 0,0:21:03.70,0:21:07.10,Default,,0,0,0,,Алдымен қарап шығыңыз.
Dialogue: 0,0:21:15.34,0:21:20.34,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:21:23.69,0:21:27.16,Default,,0,0,0,,Бүгін түнде Шура елінен би ханшайымы келді.
Dialogue: 0,0:21:27.16,0:21:31.03,Default,,0,0,0,,Ел биін тамашалайық
Dialogue: 0,0:21:31.03,0:21:35.46,Default,,0,0,0,,Шура елі осы Суга, Кен патша туып өскен ел.
Dialogue: 0,0:21:35.46,0:21:38.20,Default,,0,0,0,,Не? Мен Кен патшаға деген ностальгияны сезінемін
Dialogue: 0,0:21:38.20,0:21:40.80,Default,,0,0,0,,Менің ойымша, бұл тыныштандырады.
Dialogue: 0,0:21:40.80,0:21:43.34,Default,,0,0,0,,Шура елі...
Dialogue: 0,0:21:43.34,0:21:46.64,Default,,0,0,0,,Кешіріңіз! Би билеп, ән айт!
Dialogue: 0,0:23:11.76,0:23:14.70,Default,,0,0,0,,Суга! Сіз не жоспарладыңыз?
Dialogue: 0,0:23:14.70,0:23:17.20,Default,,0,0,0,,Сіз менің өмірімді мақсат еттіңіз! ?
Dialogue: 0,0:23:17.20,0:23:21.07,Default,,0,0,0,,Өтінемін... бұл түсінбеушілік. Бұл қандай да бір қателік.
Dialogue: 0,0:23:21.07,0:23:25.47,Default,,0,0,0,,Маған сенбейсіз бе? Рау! Жоқ, патша жұдырық!
Dialogue: 0,0:23:25.47,0:23:28.18,Default,,0,0,0,,Қателік болса, одан да кешірілмейді.
Dialogue: 0,0:23:28.18,0:23:30.65,Default,,0,0,0,,Жаулап алудың ортасында не жексұрын
Dialogue: 0,0:23:30.65,0:23:34.82,Default,,0,0,0,,Ха! Күте тұрыңыз, Рао! Ха!
Dialogue: 0,0:23:34.82,0:23:39.05,Default,,0,0,0,,Босаңдық пен немқұрайлылық үстемдіктің ең үлкен жауы.
Dialogue: 0,0:23:39.05,0:23:42.05,Default,,0,0,0,,Бұл қылмыс өлімге лайық!
Dialogue: 0,0:23:43.99,0:23:46.09,Default,,0,0,0,,Сен
Dialogue: 0,0:23:53.10,0:23:56.10,Default,,0,0,0,,Ах... бұл адал қызметші, Суга-доно...
Dialogue: 0,0:23:56.10,0:23:58.74,Default,,0,0,0,,Құбыжық Өйткені, Кенох құбыжық.
Dialogue: 0,0:23:58.74,0:24:03.44,Default,,0,0,0,,Егер сіз сақтықты төмендетсеңіз, сіз өлтіресіз. Бұл жұдырықтай патшаға қарсы шыға алмайсың.
Dialogue: 0,0:24:08.42,0:24:13.19,Default,,0,0,0,,Раох... Жаулауыңның қайсар тұлғасы
Dialogue: 0,0:24:13.19,0:24:16.49,Default,,0,0,0,,Өз көзіммен көргім келді
Dialogue: 0,0:24:23.46,0:24:26.77,Default,,0,0,0,,Рейна, жұмысыңызға рахмет.
Dialogue: 0,0:24:26.77,0:24:29.97,Default,,0,0,0,,Мен Сугаға аза тұтуға рұқсат етемін.
Dialogue: 0,0:24:29.97,0:24:33.67,Default,,0,0,0,,Бірақ сен жалғызсың.
Dialogue: 0,0:24:54.13,0:24:56.23,Default,,0,0,0,,Раох…
Dialogue: 0,0:25:02.60,0:25:06.07,Default,,0,0,0,,Не? Не үшін келдің?
Dialogue: 0,0:25:06.07,0:25:10.01,Default,,0,0,0,,Неге мен жалғыз ағамды жоқтауым керек еді? ?
Dialogue: 0,0:25:10.01,0:25:12.55,Default,,0,0,0,,Мен оның өлтіруші екенін түсінбедім.
Dialogue: 0,0:25:12.55,0:25:15.52,Default,,0,0,0,,Ағаңыз ретінде бұл өлімге лайық күнә болды ма?
Dialogue: 0,0:25:15.52,0:25:19.32,Default,,0,0,0,,Өзіңізді абайсызда кінәласаңыз, өзіңізді кінәлау керек.
Dialogue: 0,0:25:19.32,0:25:21.29,Default,,0,0,0,,Ұйықтап жатқандай қабақтарыңызды жабыңыз.
Dialogue: 0,0:25:21.29,0:25:23.96,Default,,0,0,0,,Ассасиннің жүзінен қашып құтыла алмады
Dialogue: 0,0:25:23.96,0:25:26.49,Default,,0,0,0,,Өзің!
Dialogue: 0,0:25:26.49,0:25:29.09,Default,,0,0,0,,Неге жауап бермейсің? Рау!
Dialogue: 0,0:25:31.20,0:25:35.40,Default,,0,0,0,,Шура елінен келгеніңізге қанша уақыт болды?
Dialogue: 0,0:25:35.40,0:25:39.71,Default,,0,0,0,,Шектенбеңіз! сен...
Dialogue: 0,0:25:39.71,0:25:42.94,Default,,0,0,0,,Саған сен, ағам екеуміз ердік.
Dialogue: 0,0:25:42.94,0:25:46.21,Default,,0,0,0,,Шура елін өз үйің десең
Dialogue: 0,0:25:46.21,0:25:50.42,Default,,0,0,0,,Бір күні Шура елін құтқарарыңа сенемін.
Dialogue: 0,0:25:50.42,0:25:53.25,Default,,0,0,0,,Жеңістерің орындалатын күнге дейін күтіңдер дедіңдер.
Dialogue: 0,0:25:53.25,0:25:55.19,Default,,0,0,0,,Сөзге сену
Dialogue: 0,0:25:55.19,0:25:57.96,Default,,0,0,0,,Менің ағам саған бәрін берді.
Dialogue: 0,0:25:57.96,0:26:02.60,Default,,0,0,0,,Ұрыста ағам жеңіліп, бір аяғынан артық лақтырып жіберді.
Dialogue: 0,0:26:02.60,0:26:05.50,Default,,0,0,0,,Адамның жүріп өткен жолы мен сезімі
Dialogue: 0,0:26:05.50,0:26:07.70,Default,,0,0,0,,Ал дегенмен!
Dialogue: 0,0:26:13.37,0:26:15.67,Default,,0,0,0,,Сондықтан мен мұнда келдім
Dialogue: 0,0:26:18.15,0:26:21.95,Default,,0,0,0,,Ағаңды бір сәтте өлтірдім дейсің! ?
Dialogue: 0,0:26:21.95,0:26:23.88,Default,,0,0,0,,Сіз мұнда неге келдіңіз?
Dialogue: 0,0:26:23.88,0:26:26.82,Default,,0,0,0,,Уф, егер мені пышақтайтын болсаң, мына сол кеудеге пышақ сал.
Dialogue: 0,0:26:26.82,0:26:30.12,Default,,0,0,0,,Бұл кісі өлтіруші көздеген жүрек
Dialogue: 0,0:26:34.56,0:26:36.66,Default,,0,0,0,,Уф!
Dialogue: 0,0:26:40.20,0:26:43.60,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:26:47.94,0:26:49.91,Default,,0,0,0,,Ахх...
Dialogue: 0,0:26:49.91,0:26:55.45,Default,,0,0,0,,Мен үстемдікке қол жеткізбейінше, менің өмірімді ешкім тартып ала алмайды.
Dialogue: 0,0:26:55.45,0:26:58.35,Default,,0,0,0,,Мен де бәрін тастадым.
Dialogue: 0,0:26:58.35,0:27:02.55,Default,,0,0,0,,Мен сенімен үстемдік үшін ант бердім.
Dialogue: 0,0:27:13.80,0:27:15.80,Default,,0,0,0,,Ол ашық.
Dialogue: 0,0:27:18.41,0:27:21.91,Default,,0,0,0,,Менің саған бір нәрсе беремін.
Dialogue: 0,0:27:25.58,0:27:29.55,Default,,0,0,0,,Бұл не? Бұл маған Суга-сама сеніп тапсырған нәрсе.
Dialogue: 0,0:27:29.55,0:27:33.32,Default,,0,0,0,,Осыны оқысаң, қасіретіңді жеңілдетеді деп сенемін.
Dialogue: 0,0:27:33.32,0:27:35.42,Default,,0,0,0,,Менің азап шегуім?
Dialogue: 0,0:27:37.59,0:27:42.06,Default,,0,0,0,,Бұл кісі өлтіруді Суга-сама ұйымдастырған.
Dialogue: 0,0:27:42.06,0:27:46.60,Default,,0,0,0,,Лорд Суга аурудан зардап шекті және оның өмір сүруге көп уақыты қалмағанын білді.
Dialogue: 0,0:27:46.60,0:27:49.90,Default,,0,0,0,,Жеңіске жете алмаудың орнына
Dialogue: 0,0:27:49.90,0:27:52.57,Default,,0,0,0,,Енді Қасиетті Императордың әскерін жеңу
Dialogue: 0,0:27:52.57,0:27:57.14,Default,,0,0,0,,Ол бүкіл әскерге тәртіп орнату жоспарын жасады.
Dialogue: 0,0:27:57.14,0:28:02.78,Default,,0,0,0,,Кен патша да Суга-саманың тілегін тыңдап, қиын шешім қабылдады.
Dialogue: 0,0:28:02.78,0:28:05.69,Default,,0,0,0,,Бауырым, кешірші мені.
Dialogue: 0,0:28:05.69,0:28:07.72,Default,,0,0,0,,Сондай-ақ Суга-саманы тоқтатуға болады.
Dialogue: 0,0:28:07.72,0:28:11.09,Default,,0,0,0,,Мен сізге алдын ала айта да алмадым.
Dialogue: 0,0:28:11.09,0:28:13.79,Default,,0,0,0,,Міне, мен өлтірген биші ханшайым...
Dialogue: 0,0:28:13.79,0:28:17.06,Default,,0,0,0,,Түсіну керек.
Dialogue: 0,0:28:17.06,0:28:22.24,Default,,0,0,0,,Соңында, Суга-сама, Кен патшаның жаулап алуы үшін.
Dialogue: 0,0:28:22.24,0:28:26.84,Default,,0,0,0,,Ол үш ағайынды Хокуто бірге болады деп үміттенді.
Dialogue: 0,0:28:41.66,0:28:44.33,Default,,0,0,0,,Қара патша, мен...
Dialogue: 0,0:28:44.33,0:28:49.13,Default,,0,0,0,,Мен тағы бір досымнан айырылдым.
Dialogue: 0,0:28:54.00,0:28:56.00,Default,,0,0,0,,Раох…
Dialogue: 0,0:29:04.28,0:29:08.45,Default,,0,0,0,,Соңында, Суга-сама, Кен патшаның жаулап алуы үшін.
Dialogue: 0,0:29:08.45,0:29:13.25,Default,,0,0,0,,Ол үш ағайынды Хокуто бірге болады деп үміттенді.
Dialogue: 0,0:29:13.25,0:29:16.25,Default,,0,0,0,,Ол Кенширо болса, Токидің орны да...
Dialogue: 0,0:29:18.09,0:29:20.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:29:23.86,0:29:26.63,Default,,0,0,0,,Бұл күтпеген жер.
Dialogue: 0,0:29:26.63,0:29:30.04,Default,,0,0,0,,Тырна қарғаның торына түсіп қалды.
Dialogue: 0,0:29:30.04,0:29:31.97,Default,,0,0,0,,Сіз Қасиетті Императордың әскерісіз! ?
Dialogue: 0,0:29:31.97,0:29:35.51,Default,,0,0,0,,Мен Оңтүстіктер мырзаға ең жақсы кәдесый алдым.
Dialogue: 0,0:29:35.51,0:29:38.01,Default,,0,0,0,,Түсіріңіз! Ха!
Dialogue: 0,0:29:41.72,0:29:44.35,Default,,0,0,0,,Кез келген уақытта тағы бір балалар аңы болуы мүмкін.
Dialogue: 0,0:29:44.35,0:29:48.56,Default,,0,0,0,,Сен қыңыр бала екенсің. Мен сізге су әкелуге көмектесейін.
Dialogue: 0,0:29:48.56,0:29:52.43,Default,,0,0,0,,Одан да, Баттың айтқанына өкінемін.
Dialogue: 0,0:29:52.43,0:29:55.30,Default,,0,0,0,,Хе, анау ақымақ.
Dialogue: 0,0:29:55.30,0:29:58.77,Default,,0,0,0,,Бұл қосымша жүкке айналмайды деп үміттенемін.
Dialogue: 0,0:29:58.77,0:30:01.80,Default,,0,0,0,,Ол мені және балаларды ойлап отырды.
Dialogue: 0,0:30:01.80,0:30:04.17,Default,,0,0,0,,Мен ауылдан шықтым, а?
Dialogue: 0,0:30:04.17,0:30:07.07,Default,,0,0,0,,Жасы үлкен, денесі үлкен.
Dialogue: 0,0:30:07.07,0:30:10.95,Default,,0,0,0,,Егер сіз кеткен болсаңыз, тамақты басқа балаларға беруге болады.
Dialogue: 0,0:30:10.95,0:30:13.91,Default,,0,0,0,,Сіз мені аз сөйлеуге мәжбүр еттіңіз.
Dialogue: 0,0:30:13.91,0:30:17.42,Default,,0,0,0,,Дәл солай, ол намысқой, аузы нашар.
Dialogue: 0,0:30:17.42,0:30:20.15,Default,,0,0,0,,Ол таңқаларлық мейірімді бала.
Dialogue: 0,0:30:20.15,0:30:23.56,Default,,0,0,0,,Мені тастама
Dialogue: 0,0:30:23.56,0:30:26.29,Default,,0,0,0,,Жарқанаттар маңызды достар
Dialogue: 0,0:30:26.29,0:30:29.19,Default,,0,0,0,,Бала неғұрлым нашар болса, соғұрлым сүйкімді дейді.
Dialogue: 0,0:30:31.73,0:30:33.83,Default,,0,0,0,,Ах
Dialogue: 0,0:30:48.18,0:30:50.78,Default,,0,0,0,,Кит қайтып келді! батпырауық!
Dialogue: 0,0:30:52.95,0:30:54.89,Default,,0,0,0,,Батпырауық!
Dialogue: 0,0:30:54.89,0:30:57.79,Default,,0,0,0,,Анашым! батпырауық!
Dialogue: 0,0:30:57.79,0:31:00.23,Default,,0,0,0,,Токидің ауылы Токидің?
Dialogue: 0,0:31:00.23,0:31:02.50,Default,,0,0,0,,Иә! Токи ауылы
Dialogue: 0,0:31:02.50,0:31:05.20,Default,,0,0,0,,Токи сізді міндетті түрде емдейді.
Dialogue: 0,0:31:27.22,0:31:30.52,Default,,0,0,0,,Хмм, мына бала ше?
Dialogue: 0,0:31:32.49,0:31:36.96,Default,,0,0,0,,Жақсы, сіз байқадыңыз.
Dialogue: 0,0:31:36.96,0:31:39.80,Default,,0,0,0,,Бұл қай жерде? Түсіндіру кейінірек
Dialogue: 0,0:31:39.80,0:31:42.00,Default,,0,0,0,,Жоқ, әлі қозғалма.
Dialogue: 0,0:31:55.92,0:31:58.02,Default,,0,0,0,,Уф
Dialogue: 0,0:32:09.93,0:32:11.93,Default,,0,0,0,,Уау... Ахаха
Dialogue: 0,0:32:18.37,0:32:21.34,Default,,0,0,0,,Аа, тез, тез
Dialogue: 0,0:32:21.34,0:32:24.24,Default,,0,0,0,,Мен енді қозғала алмаймын десем де.
Dialogue: 0,0:32:24.24,0:32:28.12,Default,,0,0,0,,Токи маған ашуланады, иә?
Dialogue: 0,0:32:28.12,0:32:32.29,Default,,0,0,0,,Біраз уақыт болды, Рейна! Токи!
Dialogue: 0,0:32:32.29,0:32:36.16,Default,,0,0,0,,Рин, Райнаның денесін мықтап ұста.
Dialogue: 0,0:32:36.16,0:32:38.26,Default,,0,0,0,,Бұл аздап ауырады.
Dialogue: 0,0:32:40.56,0:32:43.60,Default,,0,0,0,,Суга... сендер менің ағаларымсыңдар.
Dialogue: 0,0:32:43.60,0:32:46.87,Default,,0,0,0,,Мен сені менімен бірге шайқасасың деп үміттенген едім.
Dialogue: 0,0:32:46.87,0:32:50.74,Default,,0,0,0,,Токи, маған сенің көмегің керек.
Dialogue: 0,0:32:50.74,0:32:52.77,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:32:52.77,0:32:55.91,Default,,0,0,0,,Раох бұл дүниедегі ең кешірімді кім?
Dialogue: 0,0:32:55.91,0:32:57.91,Default,,0,0,0,,Бұл сіз екенсіз
Dialogue: 0,0:32:57.91,0:33:00.18,Default,,0,0,0,,Қасымда болсаң
Dialogue: 0,0:33:00.18,0:33:03.12,Default,,0,0,0,,Раох қаншалықты сенімді?
Dialogue: 0,0:33:03.12,0:33:06.69,Default,,0,0,0,,Жұдырық жолынан бас тарттым.
Dialogue: 0,0:33:06.69,0:33:10.69,Default,,0,0,0,,Мен енді сіздің күшіңізге сене алмаймын.
Dialogue: 0,0:33:10.69,0:33:14.50,Default,,0,0,0,,Менің ерлігімді тезірек орындауың керек!
Dialogue: 0,0:33:14.50,0:33:18.17,Default,,0,0,0,,Гегемония? Мұның мәні неде?
Dialogue: 0,0:33:18.17,0:33:23.50,Default,,0,0,0,,Мағынасы? Осы мазасыз дүниеде тыныштықты қаламайсыз ба?
Dialogue: 0,0:33:23.50,0:33:27.98,Default,,0,0,0,,Біз күшпен үстемдікке ұмтылып, бір рет бағындырсақ та
Dialogue: 0,0:33:27.98,0:33:30.08,Default,,0,0,0,,Өйткені, ол нәзік.
Dialogue: 0,0:33:31.98,0:33:35.58,Default,,0,0,0,,Нағыз тыныштық қорқыныш билеген кезде мүмкін емес.
Dialogue: 0,0:33:35.58,0:33:38.99,Default,,0,0,0,,Қорқыныш болса да, бұл дүниені біреу тыныштандырады.
Dialogue: 0,0:33:38.99,0:33:40.99,Default,,0,0,0,,Егер тәртіп орнатылмаса.
Dialogue: 0,0:33:40.99,0:33:44.53,Default,,0,0,0,,Бейбітшілік ешқашан келмейді, яғни
Dialogue: 0,0:33:44.53,0:33:47.16,Default,,0,0,0,,Бұл Раох емес шығар, иә?
Dialogue: 0,0:33:47.16,0:33:49.10,Default,,0,0,0,,Қорқыныш емес
Dialogue: 0,0:33:49.10,0:33:51.93,Default,,0,0,0,,Адамдық жүрегіңді оят
Dialogue: 0,0:33:51.93,0:33:55.70,Default,,0,0,0,,Адамдарды татулыққа жетелейтін адам болса
Dialogue: 0,0:33:55.70,0:33:59.41,Default,,0,0,0,,Бұл адам нағыз құтқарушы
Dialogue: 0,0:33:59.41,0:34:03.11,Default,,0,0,0,,Гохого...
Dialogue: 0,0:34:03.11,0:34:05.05,Default,,0,0,0,,Сіздің денеңіз туралы не айтасыз?
Dialogue: 0,0:34:05.05,0:34:07.92,Default,,0,0,0,,Ақырында түсінесіз
Dialogue: 0,0:34:07.92,0:34:10.82,Default,,0,0,0,,Мұны Раох да білетініне сенімдімін.
Dialogue: 0,0:34:14.39,0:34:18.76,Default,,0,0,0,,Мен билік бәрін билеген жерде туып-өстім.
Dialogue: 0,0:34:18.76,0:34:21.56,Default,,0,0,0,,Тек өлтіруді үйретті
Dialogue: 0,0:34:21.56,0:34:25.43,Default,,0,0,0,,Өмір сүрудің басқа жолы жоқ жер.
Dialogue: 0,0:34:25.43,0:34:30.17,Default,,0,0,0,,Сонда да бір күні мен осылай бейбіт өмір сүрермін.
Dialogue: 0,0:34:30.17,0:34:33.57,Default,,0,0,0,,Бұл кулон әдемі көрінеді.
Dialogue: 0,0:34:33.57,0:34:36.84,Default,,0,0,0,,Осы уақытқа дейін аман қалуымыздың себебі...
Dialogue: 0,0:34:36.84,0:34:40.08,Default,,0,0,0,,Я, мен сенімен жүргенімде біртүрлі
Dialogue: 0,0:34:40.08,0:34:42.98,Default,,0,0,0,,Тіпті мен көп адамның өмірін қидым
Dialogue: 0,0:34:42.98,0:34:46.02,Default,,0,0,0,,Мен ұмытайын деп тұрмын Иә?
Dialogue: 0,0:34:46.02,0:34:50.62,Default,,0,0,0,,Өкінбеймін, сол жолды таңдадым
Dialogue: 0,0:34:50.62,0:34:54.32,Default,,0,0,0,,Сондықтан мен күштірек болуым керек
Dialogue: 0,0:35:00.90,0:35:03.77,Default,,0,0,0,,Рейна-сан, шынымен жақсысың ба?
Dialogue: 0,0:35:03.77,0:35:07.34,Default,,0,0,0,,Жара жазылды
Dialogue: 0,0:35:07.34,0:35:11.65,Default,,0,0,0,,Мен енді оңайлықпен қарай алмаймын.
Dialogue: 0,0:35:11.65,0:35:14.11,Default,,0,0,0,,Ах
Dialogue: 0,0:35:14.11,0:35:17.02,Default,,0,0,0,,Токи Ауырсыну қатты болған кезде
Dialogue: 0,0:35:17.02,0:35:19.05,Default,,0,0,0,,Осы дәріні қолданыңыз
Dialogue: 0,0:35:19.05,0:35:22.76,Default,,0,0,0,,Рахмет, мен бір күні сенімдімін
Dialogue: 0,0:35:22.76,0:35:26.39,Default,,0,0,0,,Сен біздің күшіміз болады деп сенемін.
Dialogue: 0,0:35:26.39,0:35:29.10,Default,,0,0,0,,Мен сені таңдаған жолыңнан тоқтатпаймын.
Dialogue: 0,0:35:29.10,0:35:32.63,Default,,0,0,0,,Бұл да сенің тағдырың
Dialogue: 0,0:35:32.63,0:35:36.30,Default,,0,0,0,,Иә, бірақ мен сізге бір нәрсені айтайын.
Dialogue: 0,0:35:36.30,0:35:38.64,Default,,0,0,0,,Қазіргі Раох Оңтүстіктерді жеңе алмайды.
Dialogue: 0,0:35:38.64,0:35:40.67,Default,,0,0,0,,Не? Оған
Dialogue: 0,0:35:40.67,0:35:43.94,Default,,0,0,0,,Императордың жұлдызы деуге болатын жұмбақ бар.
Dialogue: 0,0:35:43.94,0:35:47.82,Default,,0,0,0,,Біз бұл жұмбақты шешпесек, Раох қалай болуы мүмкін?
Dialogue: 0,0:35:47.82,0:35:50.72,Default,,0,0,0,,Маған неге олай айттың?
Dialogue: 0,0:35:50.72,0:35:53.15,Default,,0,0,0,,Себебі сен Раохты ойлайсың
Dialogue: 0,0:35:53.15,0:35:56.72,Default,,0,0,0,,Тәуекелдерді елемей, ақымақтықпен жалғыз қозғалдым.
Dialogue: 0,0:35:56.72,0:36:01.03,Default,,0,0,0,,Бұл Раоға деген махаббат хаха
Dialogue: 0,0:36:01.03,0:36:05.13,Default,,0,0,0,,Мен бұл махаббатқа жаңа ғана жауап бердім.
Dialogue: 0,0:36:11.64,0:36:14.04,Default,,0,0,0,,Құт
Dialogue: 0,0:36:20.21,0:36:23.05,Default,,0,0,0,,Бала бар, оны ұрлап ал.
Dialogue: 0,0:36:23.05,0:36:25.35,Default,,0,0,0,,Ересектерді өлтіріңіз!
Dialogue: 0,0:36:29.72,0:36:32.22,Default,,0,0,0,,Ах! сен-!
Dialogue: 0,0:36:35.30,0:36:37.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:41.74,0:36:44.47,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:36:44.47,0:36:46.77,Default,,0,0,0,,Гргхх...
Dialogue: 0,0:36:48.81,0:36:50.74,Default,,0,0,0,,Джотаро Куджо мен оның достары
Dialogue: 0,0:36:50.74,0:36:52.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:52.78,0:36:56.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:03.46,0:37:07.96,Default,,0,0,0,,Империяға қарсы күш Шудың қарсылығы!
Dialogue: 0,0:37:13.73,0:37:16.24,Default,,0,0,0,,Нанто алты Сейкеннің бірі болғанына қарамастан
Dialogue: 0,0:37:16.24,0:37:19.14,Default,,0,0,0,,Қасиетті император Оңтүстікке қарсы шыққан сатқын.
Dialogue: 0,0:37:19.14,0:37:22.14,Default,,0,0,0,,Мен сенен кек аламын! Уф!
Dialogue: 0,0:37:24.81,0:37:29.18,Default,,0,0,0,,Шынында да, бұл жігіт жақсы адам болуы мүмкін, білесің бе?
Dialogue: 0,0:37:29.18,0:37:32.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:32.22,0:37:34.52,Default,,0,0,0,,Нанто Сейкен
Dialogue: 0,0:37:39.43,0:37:43.33,Default,,0,0,0,,Өз планетасының тағдырымен өмір сүріп, аласапыран әлемде шашыраңқы.
Dialogue: 0,0:37:43.33,0:37:46.77,Default,,0,0,0,,Нантоның алты әулиесінің бірі
Dialogue: 0,0:37:46.77,0:37:50.47,Default,,0,0,0,,Адамдар мені соқыр жауынгер дейді.
Dialogue: 0,0:37:53.57,0:37:55.67,Default,,0,0,0,,Әй!
Dialogue: 0,0:38:01.11,0:38:04.42,Default,,0,0,0,,Сіз де осы беймаза дүниеде амбициясы бар адамсыз ба?
Dialogue: 0,0:38:04.42,0:38:08.22,Default,,0,0,0,,Нанто көтеріліс жасағанда, Хокуто пайда болады
Dialogue: 0,0:38:08.22,0:38:10.56,Default,,0,0,0,,Мені жеңгісі келетіндерге
Dialogue: 0,0:38:10.56,0:38:12.63,Default,,0,0,0,,Осы жұдырықпен жауап беріңіз!
Dialogue: 0,0:38:12.63,0:38:16.36,Default,,0,0,0,,Олай болса, жауап беріңіз.
Dialogue: 0,0:38:16.36,0:38:18.87,Default,,0,0,0,,Нанто Ширасаги жұдырықтай құпия техникасы
Dialogue: 0,0:38:18.87,0:38:21.07,Default,,0,0,0,,Азғыру алақаны
Dialogue: 0,0:38:23.07,0:38:25.57,Default,,0,0,0,,Бұл ұстаным...
Dialogue: 0,0:38:30.88,0:38:33.35,Default,,0,0,0,,Белгілерді оқу мүмкін емес
Dialogue: 0,0:38:33.35,0:38:38.22,Default,,0,0,0,,Мен соқыр болғандықтан, сенің жұдырығыңнан қорықпаймын.
Dialogue: 0,0:38:38.22,0:38:40.62,Default,,0,0,0,,Қорқыныш адамдардың белгісіне айналады.
Dialogue: 0,0:38:40.62,0:38:43.62,Default,,0,0,0,,Қарсыластың қашықтығына оңай жетуге мүмкіндік береді.
Dialogue: 0,0:38:54.07,0:38:56.30,Default,,0,0,0,,Не!
Dialogue: 0,0:38:56.30,0:38:59.21,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:38:59.21,0:39:02.11,Default,,0,0,0,,Бұл Нанто алты әулие Ширасаги жұдырықтың мәні
Dialogue: 0,0:39:02.11,0:39:04.51,Default,,0,0,0,,Рецукьяку аспан биі!
Dialogue: 0,0:39:06.95,0:39:09.15,Default,,0,0,0,,Nu! Апыр-ай!
Dialogue: 0,0:39:18.66,0:39:22.50,Default,,0,0,0,,Сіз бұл жұдырықтан жалтарған бірінші адамсыз.
Dialogue: 0,0:39:22.50,0:39:25.90,Default,,0,0,0,,Бірақ сіз қаншалықты қашып құтыла аласыз?
Dialogue: 0,0:39:31.17,0:39:34.84,Default,,0,0,0,,Балалар, сендер неге Хокуто Шинкенді пайдаланасыңдар?
Dialogue: 0,0:39:34.84,0:39:38.38,Default,,0,0,0,,Бір баладан екінші балаға берілетін ең күшті жекпе-жек өнері екенін білмеймін.
Dialogue: 0,0:39:38.38,0:39:40.58,Default,,0,0,0,,Соны айтайын!
Dialogue: 0,0:39:43.62,0:39:45.55,Default,,0,0,0,,Әй!
Dialogue: 0,0:39:45.55,0:39:47.99,Default,,0,0,0,,Арх! аа!
Dialogue: 0,0:39:47.99,0:39:51.39,Default,,0,0,0,,Бұл! Сіз, Нанто Сейкен!
Dialogue: 0,0:39:51.39,0:39:54.29,Default,,0,0,0,,Қарсыластың жұдырығын өзіңіздің клоныңызға айналдырыңыз
Dialogue: 0,0:39:54.29,0:39:57.20,Default,,0,0,0,,Хокуто Шинкеннің «Мизукаге Шин» құпия техникасы
Dialogue: 0,0:39:57.20,0:40:00.10,Default,,0,0,0,,Не! ? сәлем! сәлем!
Dialogue: 0,0:40:00.10,0:40:03.44,Default,,0,0,0,,Қарғыс атсын! Қарғыс атсын!
Dialogue: 0,0:40:03.44,0:40:07.44,Default,,0,0,0,,Жердің жыртылған дыбысы соқырлар үшін қорқынышты болса керек.
Dialogue: 0,0:40:07.44,0:40:11.48,Default,,0,0,0,,Енді маған жақындай да алмайсың.
Dialogue: 0,0:40:11.48,0:40:15.68,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:40:19.69,0:40:22.16,Default,,0,0,0,,Уааа! Гррр!
Dialogue: 0,0:40:22.16,0:40:26.63,Default,,0,0,0,,Ооо, атаа!
Dialogue: 0,0:40:26.63,0:40:29.53,Default,,0,0,0,,Ах! Шу мырза!
Dialogue: 0,0:40:34.40,0:40:39.07,Default,,0,0,0,,Бұл өте тәтті. Неге дәл қазір бір соққымен аяқтамасқа?
Dialogue: 0,0:40:39.07,0:40:42.94,Default,,0,0,0,,Олай болса мен сізден сұрайын, неге сіздің техникаңызда өлтіру ниеті жоқ?
Dialogue: 0,0:40:42.94,0:40:46.81,Default,,0,0,0,,Кенширо күткендей
Dialogue: 0,0:40:46.81,0:40:50.31,Default,,0,0,0,,Кешіріңіз, мен сіздің күшіңізді білгім келді.
Dialogue: 0,0:40:52.29,0:40:54.89,Default,,0,0,0,,Мен Цзинсейдің Шумын
Dialogue: 0,0:40:54.89,0:40:58.26,Default,,0,0,0,,Мен сені күттім, Кенширо.
Dialogue: 0,0:40:58.26,0:41:03.36,Default,,0,0,0,,Хокуто Шинкеннің мұрагері Қасиетті императорды жеңе алатын жалғыз адам
Dialogue: 0,0:41:05.37,0:41:08.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:41:08.70,0:41:13.14,Default,,0,0,0,,Сен... Біраз уақыт болды, Кенширо.
Dialogue: 0,0:41:13.14,0:41:17.64,Default,,0,0,0,,Мен сенен өміріңді тегін бер деп сұрамаймын.
Dialogue: 0,0:41:17.64,0:41:19.84,Default,,0,0,0,,орнына
Dialogue: 0,0:41:21.85,0:41:25.15,Default,,0,0,0,,Мен саған шамымды беремін
Dialogue: 0,0:41:27.39,0:41:31.26,Default,,0,0,0,,Сол кезде менің өмірімнің орнына
Dialogue: 0,0:41:31.26,0:41:35.10,Default,,0,0,0,,Мына көздер! мен қателескен жоқпын
Dialogue: 0,0:41:35.10,0:41:37.46,Default,,0,0,0,,Мен жоғалтқан жарықтан артық
Dialogue: 0,0:41:37.46,0:41:40.77,Default,,0,0,0,,Жарқын және қарқынды жарқырай бастадыңыз
Dialogue: 0,0:41:40.77,0:41:42.70,Default,,0,0,0,,Мен қалай білейін, иә?
Dialogue: 0,0:41:42.70,0:41:45.71,Default,,0,0,0,,Соқыр болудың орнына жүрегім ашық.
Dialogue: 0,0:41:45.71,0:41:48.14,Default,,0,0,0,,Бұл да Джинсей
Dialogue: 0,0:41:48.14,0:41:51.54,Default,,0,0,0,,Болашаққа үмітпен өмір сүру тағдыры
Dialogue: 0,0:42:06.53,0:42:10.06,Default,,0,0,0,,Ей, жасырынатын жер ретінде осындай орынды пайдаланыңыз.
Dialogue: 0,0:42:10.06,0:42:12.86,Default,,0,0,0,,Қоңыр егеуқұйрықты қараңдар.
Dialogue: 0,0:42:15.34,0:42:18.24,Default,,0,0,0,,Қош келдіңіз, Шу-сама.
Dialogue: 0,0:42:18.24,0:42:23.74,Default,,0,0,0,,Бұл... Иә, мен төбелесемін.
Dialogue: 0,0:42:23.74,0:42:27.31,Default,,0,0,0,,Одан да нұрлануға тырысқан балалардың нұрын алу
Dialogue: 0,0:42:27.31,0:42:29.62,Default,,0,0,0,,Кім болсаң да, кешір мені.
Dialogue: 0,0:42:29.62,0:42:32.05,Default,,0,0,0,,Шу
Dialogue: 0,0:42:32.05,0:42:36.59,Default,,0,0,0,,Оңтүстік екеуіміз де бір Нанто Сикс Сейкеннің біріміз
Dialogue: 0,0:42:36.59,0:42:39.49,Default,,0,0,0,,Бірақ Оңтүстіктің жұлдызы полярлық жұлдыз
Dialogue: 0,0:42:39.49,0:42:42.40,Default,,0,0,0,,Ешқандай өшпенділік жоқ, дос жоқ, аяушылық жоқ
Dialogue: 0,0:42:42.40,0:42:46.97,Default,,0,0,0,,Императордың жұлдызымен туылған жалғыз сенсің.
Dialogue: 0,0:42:46.97,0:42:49.94,Default,,0,0,0,,Императордың Нанто Феникс жұдырығы
Dialogue: 0,0:42:49.94,0:42:53.74,Default,,0,0,0,,Хокуто Шинкен сияқты
Dialogue: 0,0:42:53.74,0:42:58.41,Default,,0,0,0,,Оның күші біздің қолымыздан келмейді, қалған бес жұлдыз.
Dialogue: 0,0:42:58.41,0:43:01.08,Default,,0,0,0,,Тым болмаса партизан болып, қарсылық көрсет.
Dialogue: 0,0:43:01.08,0:43:04.35,Default,,0,0,0,,Ол балаларды қорғаудың жолы жоқ.
Dialogue: 0,0:43:04.35,0:43:06.42,Default,,0,0,0,,Шу мырза, өтінемін
Dialogue: 0,0:43:06.42,0:43:09.56,Default,,0,0,0,,Ой, мен тамақты алдым.
Dialogue: 0,0:43:09.56,0:43:11.49,Default,,0,0,0,,Сіз тамақ жедіңіз бе? Рио
Dialogue: 0,0:43:11.49,0:43:14.36,Default,,0,0,0,,Не? А... иә
Dialogue: 0,0:43:14.36,0:43:17.06,Default,,0,0,0,,Өтірік айтпа
Dialogue: 0,0:43:17.06,0:43:21.00,Default,,0,0,0,,Көрмесем де, түсінемін
Dialogue: 0,0:43:21.00,0:43:23.24,Default,,0,0,0,,Бірге тамақтаныңыз
Dialogue: 0,0:43:23.24,0:43:27.11,Default,,0,0,0,,Дегенмен, Шу-сама мен оның достары негізінен...
Dialogue: 0,0:43:27.11,0:43:31.88,Default,,0,0,0,,Уайымдама, жарай ма? Ах...
Dialogue: 0,0:43:31.88,0:43:35.38,Default,,0,0,0,,Рахмет Шуу-сама О! Мен оралдым
Dialogue: 0,0:43:35.38,0:43:38.22,Default,,0,0,0,,үшін, мынаны қараңдар!
Dialogue: 0,0:43:38.22,0:43:40.55,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:43:40.55,0:43:44.72,Default,,0,0,0,,Егер сіз Қасиетті Император әскерінің взводына шабуыл жасасаңыз, сіз тамақ аласыз.
Dialogue: 0,0:43:44.72,0:43:46.66,Default,,0,0,0,,Жүр, тамақтан, Райо.
Dialogue: 0,0:43:46.66,0:43:49.36,Default,,0,0,0,,Хаха! Аму
Dialogue: 0,0:43:49.36,0:43:53.20,Default,,0,0,0,,Ия, мен бұл жолы жей аламын. Маған бер, маған бер!
Dialogue: 0,0:43:53.20,0:43:55.27,Default,,0,0,0,,Дүрбелең болма, Шуу-сама да өтінемін.
Dialogue: 0,0:43:55.27,0:43:57.87,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:43:59.97,0:44:01.98,Default,,0,0,0,,Күте тұрыңыз! Оны жеме!
Dialogue: 0,0:44:01.98,0:44:04.64,Default,,0,0,0,,Құрамында улы бар!
Dialogue: 0,0:44:04.64,0:44:07.61,Default,,0,0,0,,Уф! Ахххх! Райо!
Dialogue: 0,0:44:07.61,0:44:11.61,Default,,0,0,0,,Уф! Түкіріңіз! Түкіріңіз!
Dialogue: 0,0:44:15.29,0:44:18.06,Default,,0,0,0,,Хмм... енді жоқ
Dialogue: 0,0:44:18.06,0:44:21.16,Default,,0,0,0,,Әке, ауырып тұр... Рё
Dialogue: 0,0:44:23.20,0:44:26.90,Default,,0,0,0,,Рио! Райо!
Dialogue: 0,0:44:30.74,0:44:36.58,Default,,0,0,0,,Кешіріңіз! Мен алдымен оны қарап шығуым керек еді.
Dialogue: 0,0:44:36.58,0:44:41.38,Default,,0,0,0,,Кен Бұл Саутердің әдісі.
Dialogue: 0,0:44:41.38,0:44:44.15,Default,,0,0,0,,Жарығынан айырылған мына көздермен де
Dialogue: 0,0:44:44.15,0:44:48.02,Default,,0,0,0,,Тек көз жасын төгуге болмайды
Dialogue: 0,0:44:48.02,0:44:52.26,Default,,0,0,0,,Мен сені кешіре алмаймын! Оңтүстіктер жеңіліп қалмаса
Dialogue: 0,0:44:52.26,0:44:55.76,Default,,0,0,0,,Бұл трагедия мәңгі қайталанады!
Dialogue: 0,0:45:01.53,0:45:03.53,Default,,0,0,0,,Бұл тістерімді қақыратады, ақымақ! Ал, ал да кет.
Dialogue: 0,0:45:06.34,0:45:08.44,Default,,0,0,0,,Оңтүстік
Dialogue: 0,0:45:10.28,0:45:13.11,Default,,0,0,0,,Қасиетті император өтіп бара жатыр!
Dialogue: 0,0:45:13.11,0:45:18.11,Default,,0,0,0,,Ластануды дезинфекциялаңыз! Жолды босат!
Dialogue: 0,0:45:27.53,0:45:30.80,Default,,0,0,0,,Сіз ақымақ! Ә? Ол дезинфекцияланды ма?
Dialogue: 0,0:45:30.80,0:45:33.57,Default,,0,0,0,,Уау! Оу!
Dialogue: 0,0:45:33.57,0:45:37.54,Default,,0,0,0,,Дұрыс айтасыз, кірді дезинфекциялау керек.
Dialogue: 0,0:45:37.54,0:45:40.14,Default,,0,0,0,,Бұхаа! Аха!
Dialogue: 0,0:45:44.21,0:45:47.55,Default,,0,0,0,,О, сен үлкен болып кеткенсің, балам.
Dialogue: 0,0:45:47.55,0:45:51.42,Default,,0,0,0,,Сіздің үлкен маршыңыз осында аяқталады.
Dialogue: 0,0:45:51.42,0:45:55.39,Default,,0,0,0,,Енді сенің аузың үлкен, балам.
Dialogue: 0,0:45:55.39,0:45:59.46,Default,,0,0,0,,Раохтың ғашық болған қасиеті оянған сияқты.
Dialogue: 0,0:45:59.46,0:46:02.86,Default,,0,0,0,,Бірақ сен мені жеңе аласың ба?
Dialogue: 0,0:46:04.90,0:46:08.57,Default,,0,0,0,,Қасиетті император, сіз бізге көмектеспесеңіз де, біз сізге қамқорлық жасаймыз.
Dialogue: 0,0:46:08.57,0:46:10.84,Default,,0,0,0,,Хокуто Шинкен мұрагері
Dialogue: 0,0:46:10.84,0:46:14.14,Default,,0,0,0,,Қасиетті Императордың крест кесенесінің адам бағанасы үшін өте қолайлы.
Dialogue: 0,0:46:16.64,0:46:19.58,Default,,0,0,0,,Кішкентай бала, маған қоңырау шалыңыз.
Dialogue: 0,0:46:19.58,0:46:23.98,Default,,0,0,0,,Неге дайындалмайсың? Нанто Феникс Фисттің ұстанымы жоқ.
Dialogue: 0,0:46:23.98,0:46:25.92,Default,,0,0,0,,Позиция қорғаныс түрі болып табылады.
Dialogue: 0,0:46:25.92,0:46:29.36,Default,,0,0,0,,Менің жұдырығымдағы нәрсе тек қана басатын ілгерілеу.
Dialogue: 0,0:46:29.36,0:46:32.26,Default,,0,0,0,,Иә! Таа!
Dialogue: 0,0:46:32.26,0:46:34.26,Default,,0,0,0,,Қандай жылдам!
Dialogue: 0,0:46:34.26,0:46:36.50,Default,,0,0,0,,Иә! Ватаа!
Dialogue: 0,0:46:36.50,0:46:38.43,Default,,0,0,0,,Нурия!
Dialogue: 0,0:46:38.43,0:46:40.77,Default,,0,0,0,,Ga!
Dialogue: 0,0:46:40.77,0:46:45.17,Default,,0,0,0,,Қозғалыстарың менің жұдырығымның алдында тоқтағандай.
Dialogue: 0,0:46:45.17,0:46:47.91,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:46:47.91,0:46:50.58,Default,,0,0,0,,Жұдырығың бас тартқан.
Dialogue: 0,0:46:50.58,0:46:52.81,Default,,0,0,0,,Сіз бас тарттыңыз ба?
Dialogue: 0,0:46:52.81,0:46:57.61,Default,,0,0,0,,Егер бұл жақсы болса, Gokusei Cross Fist-ті алып көріңіз.
Dialogue: 0,0:47:04.42,0:47:08.26,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:47:08.26,0:47:11.00,Default,,0,0,0,,Ататататата!
Dialogue: 0,0:47:11.00,0:47:13.10,Default,,0,0,0,,Қасиетті император!
Dialogue: 0,0:47:16.37,0:47:21.21,Default,,0,0,0,,Құпия саңылаулардың ішіндегі ең жойқын күш, адамның ортаңғы полюсі соғылды.
Dialogue: 0,0:47:21.21,0:47:26.05,Default,,0,0,0,,Оңтүстік! Сіздің өмір сүруіңізге 3 секунд қалды
Dialogue: 0,0:47:26.05,0:47:29.92,Default,,0,0,0,,3 секунд? Ха
Dialogue: 0,0:47:29.92,0:47:32.82,Default,,0,0,0,,Не дегенің? Маған түсіндірші!
Dialogue: 0,0:47:32.82,0:47:35.72,Default,,0,0,0,,(Сувенир дүкенінің иесі) Онда бонус ретінде тегін гидпен экскурсия жасап берейін.
Dialogue: 0,0:47:35.72,0:47:39.49,Default,,0,0,0,,Акихабарадан кет, түсіндің бе?!
Dialogue: 0,0:47:39.49,0:47:42.16,Default,,0,0,0,,Мм! ? Фуфуфу…
Dialogue: 0,0:47:42.16,0:47:45.43,Default,,0,0,0,,Уау! Жоқ...
Dialogue: 0,0:47:45.43,0:47:47.43,Default,,0,0,0,,Сол сөзге шебер, жалған мейірімді жігіт➡
Dialogue: 0,0:47:47.43,0:47:52.11,Default,,0,0,0,,Ба... Идиот, сенің құпия тесікке түскеніңе сенімдімін.
Dialogue: 0,0:47:52.11,0:47:55.11,Default,,0,0,0,,Хокуто Шинкен бұл денеде жұмыс істемейді!
Dialogue: 0,0:48:03.18,0:48:07.05,Default,,0,0,0,,Мен императормын, сендерден бәрі басқаша.
Dialogue: 0,0:48:07.05,0:48:10.92,Default,,0,0,0,,Құдай маған тіпті өлмейтін дене берді.
Dialogue: 0,0:48:10.92,0:48:13.69,Default,,0,0,0,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:48:13.69,0:48:17.56,Default,,0,0,0,,О! Жылы...
Dialogue: 0,0:48:17.56,0:48:22.14,Default,,0,0,0,,Ой!
Dialogue: 0,0:48:22.14,0:48:24.07,Default,,0,0,0,,Қасиетті император...
Dialogue: 0,0:48:24.07,0:48:29.74,Default,,0,0,0,,Фуфуфу... Жұдырықтың жылдамдығы, жынды болмай құпия тесікке соғуы.
Dialogue: 0,0:48:29.74,0:48:34.58,Default,,0,0,0,,Мұрагер күткендей, сіз жұдырықтасуда жеңдіңіз.
Dialogue: 0,0:48:34.58,0:48:39.08,Default,,0,0,0,,Бірақ сен мен ұстаған император тағынан жеңілдің!
Dialogue: 0,0:48:49.63,0:48:54.23,Default,,0,0,0,,Тіпті Кенширо да Сауттердің жұмбағын шеше алмайды ма?
Dialogue: 0,0:48:54.23,0:48:58.33,Default,,0,0,0,,Бірақ Суга, сенің өлімің ешқашан бекер болмайды.
Dialogue: 0,0:49:02.01,0:49:05.85,Default,,0,0,0,,Хехехе хахаха...
Dialogue: 0,0:49:05.85,0:49:09.95,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:49:17.16,0:49:20.26,Default,,0,0,0,,Мм, бүгінгі әңгіме менің талғамыма сай емес.
Dialogue: 0,0:49:29.47,0:49:32.67,Default,,0,0,0,,Ах
Dialogue: 0,0:49:32.67,0:49:37.21,Default,,0,0,0,,Уф! Ах!
Dialogue: 0,0:49:37.21,0:49:39.55,Default,,0,0,0,,Аштан өлсең де патша аштан өлмейді.
Dialogue: 0,0:49:39.55,0:49:42.48,Default,,0,0,0,,Сен өлсең де, Император әлі өлген!
Dialogue: 0,0:49:42.48,0:49:47.18,Default,,0,0,0,,Бұл таңдалған патша! Кәне! Оны тазалаңыз!
Dialogue: 0,0:50:07.94,0:50:11.44,Default,,0,0,0,,Әй?
Dialogue: 0,0:50:11.44,0:50:13.94,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:50:19.49,0:50:22.82,Default,,0,0,0,,Мен көмектесуге келдім. Менің атым Шива.
Dialogue: 0,0:50:22.82,0:50:25.82,Default,,0,0,0,,Мен Шудың ұлымын, Шиба...
Dialogue: 0,0:50:31.66,0:50:33.66,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:50:35.84,0:50:38.44,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:50:40.41,0:50:43.11,Default,,0,0,0,,Әкем маған үнемі айтып отыратын
Dialogue: 0,0:50:43.11,0:50:46.35,Default,,0,0,0,,Бұл дүниеде тек бір адам Оңтүстікті жеңе алады.
Dialogue: 0,0:50:46.35,0:50:49.25,Default,,0,0,0,,Кенширо есімді адам болу
Dialogue: 0,0:51:03.40,0:51:07.27,Default,,0,0,0,,Менімен бірге қаша алмайсың.
Dialogue: 0,0:51:07.27,0:51:11.37,Default,,0,0,0,,Егер ол сізге көмектессе, мен өкінбеймін.
Dialogue: 0,0:51:13.67,0:51:16.04,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:51:16.04,0:51:18.95,Default,,0,0,0,,Мен жем боламын
Dialogue: 0,0:51:18.95,0:51:22.35,Default,,0,0,0,,Ба... ақымақ болуды доғар.
Dialogue: 0,0:51:22.35,0:51:25.32,Default,,0,0,0,,Кенширо-сан
Dialogue: 0,0:51:25.32,0:51:27.52,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:51:33.36,0:51:36.13,Default,,0,0,0,,Күтіңіз, күтіңіз!
Dialogue: 0,0:51:36.13,0:51:39.97,Default,,0,0,0,,Шива!
Dialogue: 0,0:51:39.97,0:51:43.67,Default,,0,0,0,,Қалтырау!
Dialogue: 0,0:52:02.59,0:52:06.09,Default,,0,0,0,,Бала! Оны қайда жасырдың? ?
Dialogue: 0,0:52:06.09,0:52:10.29,Default,,0,0,0,,О? Уф!
Dialogue: 0,0:52:21.24,0:52:26.04,Default,,0,0,0,,Қалтырау!
Dialogue: 0,0:52:51.74,0:52:54.57,Default,,0,0,0,,Мен сенің бұл жерде өлуіңе жол бермеймін.
Dialogue: 0,0:52:54.57,0:52:59.77,Default,,0,0,0,,Сені менің жұдырығым ғана жеңе алады
Dialogue: 0,0:53:08.49,0:53:12.49,Default,,0,0,0,,Раох Күткендей, сен Кенширосың...
Dialogue: 0,0:53:17.73,0:53:20.63,Default,,0,0,0,,Джотаро Куджо мен оның достары
Dialogue: 0,0:53:20.63,0:53:22.94,Default,,0,0,0,,Кен, әлі оянба.
Dialogue: 0,0:53:22.94,0:53:26.94,Default,,0,0,0,,Хмм... сендер мұны істедіңдер ме?
Dialogue: 0,0:53:26.94,0:53:30.21,Default,,0,0,0,,Сонда кім? Жақын жерде тұяқ іздері болды.
Dialogue: 0,0:53:30.21,0:53:32.14,Default,,0,0,0,,Бұл жылқы емес пе? Жылқы...
Dialogue: 0,0:53:32.14,0:53:34.71,Default,,0,0,0,,Уау...
Dialogue: 0,0:53:34.71,0:53:37.68,Default,,0,0,0,,Бейшара Шебаның денесін қазу
Dialogue: 0,0:53:37.68,0:53:40.02,Default,,0,0,0,,Мүмкін емес сияқты
Dialogue: 0,0:53:40.02,0:53:42.12,Default,,0,0,0,,Шива…
Dialogue: 0,0:53:51.63,0:53:54.33,Default,,0,0,0,,Шу Иә?
Dialogue: 0,0:53:54.33,0:53:56.43,Default,,0,0,0,,Әлі қозғалмайды
Dialogue: 0,0:54:02.61,0:54:05.51,Default,,0,0,0,,Өтінемін, артық жасамай демалыңыз.
Dialogue: 0,0:54:05.51,0:54:09.81,Default,,0,0,0,,Кешіріңіз Шу, мен сөздерді таба алмаймын.
Dialogue: 0,0:54:11.88,0:54:14.08,Default,,0,0,0,,Маған мақтауларыңызды өтінемін.
Dialogue: 0,0:54:16.69,0:54:21.13,Default,,0,0,0,,Мен де дәл қазір ұлымды мақтап отырдым.
Dialogue: 0,0:54:21.13,0:54:24.80,Default,,0,0,0,,Жұлдыздың жаны Шивадан да өтіп жатты.
Dialogue: 0,0:54:24.80,0:54:28.67,Default,,0,0,0,,Мен Шиваны мақтан тұтамын
Dialogue: 0,0:54:28.67,0:54:30.77,Default,,0,0,0,,Шу
Dialogue: 0,0:54:54.63,0:54:57.90,Default,,0,0,0,,Дәрі жұмыс істеп тұрған сияқты, мен жақсы ұйықтап жатырмын.
Dialogue: 0,0:54:57.90,0:55:02.00,Default,,0,0,0,,Жақсы, мен ертең қозғала аламын.
Dialogue: 0,0:55:04.44,0:55:06.84,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:55:09.21,0:55:13.45,Default,,0,0,0,,Шу мырза, бұл қиын! Қасиетті императордың үлкен әскері шабуыл жасады!
Dialogue: 0,0:55:13.45,0:55:15.45,Default,,0,0,0,,Сіз бұл жерді таптыңыз ба?
Dialogue: 0,0:55:15.45,0:55:18.25,Default,,0,0,0,,Кен Бұл қиын! Оян!
Dialogue: 0,0:55:20.22,0:55:22.82,Default,,0,0,0,,Жарқанат Менің бір жақсылығым бар.
Dialogue: 0,0:55:38.34,0:55:42.07,Default,,0,0,0,,Кен оянғанда, маған бұл жұдырық туралы хабарлаңыз.
Dialogue: 0,0:55:42.07,0:55:45.98,Default,,0,0,0,,Бақытсыз заманда өмір сүріп жатқан балалардың шынайы тілектері қауіп төндіреді.
Dialogue: 0,0:55:45.98,0:55:48.25,Default,,0,0,0,,Иә
Dialogue: 0,0:55:48.25,0:55:54.12,Default,,0,0,0,,Кен, мен сенің есейген жүзіңді бір көргім келді.
Dialogue: 0,0:55:54.12,0:55:58.62,Default,,0,0,0,,Өлсек те, біз, ата-ана мен бала, Оңтүстік жұлдыздың жұлдызына айналамыз.
Dialogue: 0,0:55:58.62,0:56:01.53,Default,,0,0,0,,Мен сені бақылап тұрамын
Dialogue: 0,0:56:01.53,0:56:03.63,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:56:08.17,0:56:11.07,Default,,0,0,0,,Шу! Өлме!
Dialogue: 0,0:56:11.07,0:56:13.17,Default,,0,0,0,,Өлме!
Dialogue: 0,0:56:15.37,0:56:19.98,Default,,0,0,0,,Сәлем! Кепілге алынғандар, осында сапқа тұрыңдар!
Dialogue: 0,0:56:19.98,0:56:22.98,Default,,0,0,0,,Шу шығармаңыз!
Dialogue: 0,0:56:22.98,0:56:25.62,Default,,0,0,0,,Ах! аа! Анашым! Өтінемін тоқта!
Dialogue: 0,0:56:25.62,0:56:28.62,Default,,0,0,0,,И-хэ-хэ... Балаға көмектескіңіз келсе
Dialogue: 0,0:56:28.62,0:56:31.92,Default,,0,0,0,,Менің айтқанымды істе... Иә?
Dialogue: 0,0:56:37.16,0:56:39.36,Default,,0,0,0,,Ол сәл қорқынышты емес пе?
Dialogue: 0,0:56:41.43,0:56:43.84,Default,,0,0,0,,А, Шу-сама.
Dialogue: 0,0:56:43.84,0:56:47.71,Default,,0,0,0,,Анашым! Анашым! Анашым!
Dialogue: 0,0:56:47.71,0:56:50.24,Default,,0,0,0,,Оңтүстік!
Dialogue: 0,0:56:50.24,0:56:53.91,Default,,0,0,0,,Қоңыр егеуқұйрықтардың бастығы ақыры шықты ма?
Dialogue: 0,0:56:53.91,0:56:57.78,Default,,0,0,0,,Мен сені жеңе алмасам да, Асура болып күресемін.
Dialogue: 0,0:56:57.78,0:57:00.69,Default,,0,0,0,,Өмірімнің соңына дейін!
Dialogue: 0,0:57:00.69,0:57:06.63,Default,,0,0,0,,Жарайды, мен Нанто Ширасаги Кенді соңына дейін көремін.
Dialogue: 0,0:57:06.63,0:57:10.13,Default,,0,0,0,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:57:21.97,0:57:24.51,Default,,0,0,0,,Оңтүстік! Дайын болыңыз!
Dialogue: 0,0:57:24.51,0:57:26.81,Default,,0,0,0,,Чуооа!
Dialogue: 0,0:57:35.22,0:57:38.12,Default,,0,0,0,,Мм, қандай ұят.
Dialogue: 0,0:57:43.73,0:57:46.77,Default,,0,0,0,,Енді тағы бір рет көріңіз.
Dialogue: 0,0:57:46.77,0:57:49.87,Default,,0,0,0,,Мен қарсы болмаймын Не?
Dialogue: 0,0:57:49.87,0:57:54.47,Default,,0,0,0,,Бірақ сіз олардың өмірінен бас тарта аласыз ба?
Dialogue: 0,0:57:56.48,0:57:59.48,Default,,0,0,0,,Мені жеңуге деген шын ниетіңіз.
Dialogue: 0,0:57:59.48,0:58:04.18,Default,,0,0,0,,Бұл сенің мені жеңудің тамаша мүмкіндігің.
Dialogue: 0,0:58:04.18,0:58:07.09,Default,,0,0,0,,Құрметті Шу! Оңтүстікті жеңіңіз!
Dialogue: 0,0:58:07.09,0:58:12.86,Default,,0,0,0,,Оңтүстікті жеңіңіз! Қарсы емеспін, Шу мырза!
Dialogue: 0,0:58:12.86,0:58:16.46,Default,,0,0,0,,Өзі үшін өмір сүре алмайтын адамның құны жоқ!
Dialogue: 0,0:58:22.43,0:58:27.74,Default,,0,0,0,,Мен аяғымның сіңірін кесіп алдым. Енді Ширасаги жұдырығын қайта қолдана алмаймын.
Dialogue: 0,0:58:27.74,0:58:33.51,Default,,0,0,0,,Егер бұл оларға көмектессе,
Dialogue: 0,0:58:33.51,0:58:36.02,Default,,0,0,0,,Хамф, олардың бәрін өлтір.
Dialogue: 0,0:58:36.02,0:58:38.92,Default,,0,0,0,,Не? Күте тұрыңыз! Міне, уәде!
Dialogue: 0,0:58:38.92,0:58:40.89,Default,,0,0,0,,Дұрыс емес уәде!
Dialogue: 0,0:58:40.89,0:58:43.56,Default,,0,0,0,,Әлидің бүлігін кешірмеймін.
Dialogue: 0,0:58:43.56,0:58:47.43,Default,,0,0,0,,Кім мойынсұнбаса, өлім ғана бар.
Dialogue: 0,0:58:47.43,0:58:50.40,Default,,0,0,0,,Оларға көмектескің келсе, мен сенің жаныңды аламын.
Dialogue: 0,0:58:50.40,0:58:53.07,Default,,0,0,0,,Джинсей - қайғылы жұлдыз.
Dialogue: 0,0:58:53.07,0:58:55.87,Default,,0,0,0,,Ешкім көмектесе алмайды
Dialogue: 0,0:58:57.90,0:59:01.37,Default,,0,0,0,,Мен сізге өлу үшін қолайлы жол дайындадым.
Dialogue: 0,0:59:01.37,0:59:03.37,Default,,0,0,0,,Мені ал!
Dialogue: 0,0:59:11.55,0:59:15.99,Default,,0,0,0,,Кенширо, жанымның зарын тыңда!
Dialogue: 0,0:59:15.99,0:59:24.59,Default,,0,0,0,,Кенширо!
Dialogue: 0,0:59:40.21,0:59:43.15,Default,,0,0,0,,Жүр, мүмкін Кеншироны жақында қуып жететін шығармыз.
Dialogue: 0,0:59:43.15,0:59:45.55,Default,,0,0,0,,Ах! Әке!
Dialogue: 0,0:59:47.62,0:59:52.32,Default,,0,0,0,,Мұндай жерде қашу жолы бар. Балалар сендер не істейсіңдер?
Dialogue: 0,0:59:52.32,0:59:55.12,Default,,0,0,0,,Бұл өте қиын, сондықтан мені өлтіріңіз.
Dialogue: 0,1:00:14.18,1:00:17.08,Default,,0,0,0,,Жоқ! Апыр-ай!
Dialogue: 0,1:00:17.08,1:00:20.69,Default,,0,0,0,,Уф, бұл жиіркенішті, тоқта...
Dialogue: 0,1:00:20.69,1:00:22.89,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:30.46,1:00:35.06,Default,,0,0,0,,Шу... Шу шақырып жатыр.
Dialogue: 0,1:01:01.43,1:01:05.86,Default,,0,0,0,,Шу Кенді оятып жіберді.
Dialogue: 0,1:01:05.86,1:01:09.96,Default,,0,0,0,,Кенді енді ешкім тоқтата алмайды.
Dialogue: 0,1:01:13.91,1:01:22.31,Default,,0,0,0,,Ооо!
Dialogue: 0,1:01:28.42,1:01:30.42,Default,,0,0,0,,Құрметті Шу!
Dialogue: 0,1:01:33.26,1:01:35.23,Default,,0,0,0,,Бұл ирониялық, Шу.
Dialogue: 0,1:01:35.23,1:01:38.66,Default,,0,0,0,,Қолыңмен маған қарсы шықтың.
Dialogue: 0,1:01:38.66,1:01:42.23,Default,,0,0,0,,Осы қасиетті императордың кесенесін аяқтаңыз.
Dialogue: 0,1:01:42.23,1:01:45.83,Default,,0,0,0,,Га Га Га!
Dialogue: 0,1:01:47.87,1:01:51.38,Default,,0,0,0,,Жүр, Нанто Сейкенмен бірге жүр.
Dialogue: 0,1:01:51.38,1:01:55.91,Default,,0,0,0,,Полярлық Император Оңтүстіктің ұлылығын құрметтейтін Қасиетті Император Крест кесенесі
Dialogue: 0,1:01:55.91,1:01:58.81,Default,,0,0,0,,Сол қасиетті ескерткішті үйіп таста.
Dialogue: 0,1:02:03.96,1:02:08.49,Default,,0,0,0,,Кеңсей антиимпериялық күштерінің Шуды Оңтүстіктер өлтіретін сияқты.
Dialogue: 0,1:02:08.49,1:02:13.00,Default,,0,0,0,,Оны құтқару үшін Кенширо жалғыз өзі Қасиетті императордың крест кесенесіне бет алды.
Dialogue: 0,1:02:13.00,1:02:16.37,Default,,0,0,0,,Біз ақымақ Оңтүстіктің жұмбағын шешуіміз керек.
Dialogue: 0,1:02:16.37,1:02:19.67,Default,,0,0,0,,Қазіргі Кенширо ол жігітті жеңе алмайды.
Dialogue: 0,1:02:19.67,1:02:24.21,Default,,0,0,0,,Әсіресе жалғыз?
Dialogue: 0,1:02:24.21,1:02:26.65,Default,,0,0,0,,Токи, мұны қалай істедің?
Dialogue: 0,1:02:26.65,1:02:30.38,Default,,0,0,0,,Біз Солтүстік Жұлдыздың адамдары үшін ешбір қамалдың мәні жоқ.
Dialogue: 0,1:02:30.38,1:02:33.75,Default,,0,0,0,,Мен саған не үшін керекпін? Кеншираға қосылыңыз
Dialogue: 0,1:02:33.75,1:02:36.66,Default,,0,0,0,,Мұны істеу мүмкін емес! Жеңілу қарсыласы бір болғанымен
Dialogue: 0,1:02:36.66,1:02:40.26,Default,,0,0,0,,Кенширо мен менің жолдарым қиылысқан емес
Dialogue: 0,1:02:40.26,1:02:43.23,Default,,0,0,0,,Ол менің көмегімді қаламайды.
Dialogue: 0,1:02:43.23,1:02:46.37,Default,,0,0,0,,Ал Сауттердің жұмбағы әлі шешілген жоқ.
Dialogue: 0,1:02:46.37,1:02:48.43,Default,,0,0,0,,Жұмбақ болса мен білемін.
Dialogue: 0,1:02:48.43,1:02:51.67,Default,,0,0,0,,Не? Сонда Кенширо да солай істей ме?
Dialogue: 0,1:02:51.67,1:02:54.57,Default,,0,0,0,,Жоқ, Кенширо бас тартты.
Dialogue: 0,1:02:54.57,1:02:57.48,Default,,0,0,0,,Ақымақ... неге?
Dialogue: 0,1:02:57.48,1:03:00.71,Default,,0,0,0,,Кенширо тіпті сіз қорқатын жұмбақтарды алады.
Dialogue: 0,1:03:00.71,1:03:02.65,Default,,0,0,0,,Тек сізден асып түсу үшін
Dialogue: 0,1:03:02.65,1:03:06.25,Default,,0,0,0,,Хехехе... Менен асып түсу үшін
Dialogue: 0,1:03:06.25,1:03:09.49,Default,,0,0,0,,Хокуто Шинкеннің мұрагері болған Кенширо үшін
Dialogue: 0,1:03:09.49,1:03:12.83,Default,,0,0,0,,Сіз енді Хокутоның үлкен ағасысыз, одан асып түсуіңіз керек.
Dialogue: 0,1:03:12.83,1:03:15.16,Default,,0,0,0,,Король Кен Рейна
Dialogue: 0,1:03:15.16,1:03:19.96,Default,,0,0,0,,Ол Кеншироны құтқару үшін СС-ті басқарды.
Dialogue: 0,1:03:22.80,1:03:24.74,Default,,0,0,0,,Барлық әскерлерге айт
Dialogue: 0,1:03:24.74,1:03:28.04,Default,,0,0,0,,Оңтүстік пен Оңтүстіктің арасында шешім қабылдайтын кез келді.
Dialogue: 0,1:03:28.04,1:03:31.74,Default,,0,0,0,,Хаха! Раох
Dialogue: 0,1:03:31.74,1:03:35.48,Default,,0,0,0,,Жарайсыз ба? Бұл Кенширо мен Рейна үшін емес.
Dialogue: 0,1:03:35.48,1:03:37.42,Default,,0,0,0,,Бұл менің Шу алдындағы парызым.
Dialogue: 0,1:03:37.42,1:03:41.89,Default,,0,0,0,,Шуды өлім жазасына кесетін болса, мен тым болмаса, қадағалаймын.
Dialogue: 0,1:03:41.89,1:03:45.39,Default,,0,0,0,,Ол Нанто Джунин-гумиге қарыз.
Dialogue: 0,1:03:45.39,1:03:47.66,Default,,0,0,0,,Қарыз алу? Мен ол кезде болдым
Dialogue: 0,1:03:47.66,1:03:50.93,Default,,0,0,0,,Мен өмірімді берсем де, Кеншироны құтқаруға дайын едім.
Dialogue: 0,1:03:50.93,1:03:53.67,Default,,0,0,0,,Мен Шуға өмірім үшін қарыздармын.
Dialogue: 0,1:03:53.67,1:03:58.37,Default,,0,0,0,,Бүгін сіз Нанто халқын жоясыз!
Dialogue: 0,1:04:00.51,1:04:05.14,Default,,0,0,0,,Бұл жігіттерді қанша жеңсең де, құрттай қайтады.
Dialogue: 0,1:04:05.14,1:04:09.01,Default,,0,0,0,,Бат, сен қаш, мен жалғыз барамын.
Dialogue: 0,1:04:09.01,1:04:12.89,Default,,0,0,0,,Бұл дұрыс емес, мен сені тозаққа апарамын.
Dialogue: 0,1:04:12.89,1:04:16.42,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:16.42,1:04:19.82,Default,,0,0,0,,Ха! Сондай-ақ! Тория!
Dialogue: 0,1:04:26.77,1:04:29.10,Default,,0,0,0,,Қасиетті императордың крест кесенесіне тез осы атқа мініңіз
Dialogue: 0,1:04:29.10,1:04:32.37,Default,,0,0,0,,Сіз...
Dialogue: 0,1:04:32.37,1:04:34.57,Default,,0,0,0,,Мен мұнымен айналысамын.
Dialogue: 0,1:04:38.81,1:04:42.28,Default,,0,0,0,,Мен түсінбеймін. Неліктен Рейна Кеншироны жақтайды?
Dialogue: 0,1:04:42.28,1:04:44.22,Default,,0,0,0,,Кенширо үшін емес
Dialogue: 0,1:04:44.22,1:04:46.49,Default,,0,0,0,,Бұл сізге не?
Dialogue: 0,1:04:46.49,1:04:50.22,Default,,0,0,0,,Рейна сіздің Кеншираға деген сезімдеріңізді көрді.
Dialogue: 0,1:04:50.22,1:04:52.82,Default,,0,0,0,,Себебі мен сені жақсы көремін
Dialogue: 0,1:05:07.74,1:05:11.14,Default,,0,0,0,,Қасиетті император әскерінің негізгі күші келген сияқты.
Dialogue: 0,1:05:11.14,1:05:13.64,Default,,0,0,0,,Бұл капитан! Иә?
Dialogue: 0,1:05:18.88,1:05:21.79,Default,,0,0,0,,Раох
Dialogue: 0,1:05:21.79,1:05:25.79,Default,,0,0,0,,Жарайды ма? Біздің гвардияның Кенохқа деген ерлігі
Dialogue: 0,1:05:25.79,1:05:28.16,Default,,0,0,0,,Мен саған көрсетемін!
Dialogue: 0,1:05:28.16,1:05:30.36,Default,,0,0,0,,Жалғастырыңыз!
Dialogue: 0,1:05:36.30,1:05:38.60,Default,,0,0,0,,Ха! Алақай!
Dialogue: 0,1:05:43.58,1:05:51.78,Default,,0,0,0,,Ал, жақсы...
Dialogue: 0,1:05:56.82,1:05:58.89,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,1:05:58.89,1:06:02.19,Default,,0,0,0,,Е! Эх!
Dialogue: 0,1:06:04.50,1:06:06.70,Default,,0,0,0,,Бұлардың бәрі алдын ала дайындалған.
Dialogue: 0,1:06:19.81,1:06:22.41,Default,,0,0,0,,Ахаха
Dialogue: 0,1:06:22.41,1:06:26.11,Default,,0,0,0,,Бұл... Жарайды.
Dialogue: 0,1:06:29.99,1:06:32.39,Default,,0,0,0,,Рейна, ақымақ нәрсе
Dialogue: 0,1:06:34.33,1:06:36.33,Default,,0,0,0,,Раох
Dialogue: 0,1:06:40.43,1:06:42.43,Default,,0,0,0,,Рейна
Dialogue: 0,1:06:44.74,1:06:48.94,Default,,0,0,0,,Ра... Раох Қоштасып жатқан сияқтымыз.
Dialogue: 0,1:06:48.94,1:06:51.21,Default,,0,0,0,,Сіз бұл көрсеткімен не істеп жатырсыз?
Dialogue: 0,1:06:51.21,1:06:53.71,Default,,0,0,0,,Бірақ мен еш өкінбеймін.
Dialogue: 0,1:06:56.01,1:06:59.72,Default,,0,0,0,,Балалардың болашағы бар
Dialogue: 0,1:06:59.72,1:07:04.22,Default,,0,0,0,,Туған жеріміз Шура елі балаларына.
Dialogue: 0,1:07:10.26,1:07:13.36,Default,,0,0,0,,Уәде етілген сүйкімділік
Dialogue: 0,1:07:16.74,1:07:22.44,Default,,0,0,0,,Мен мәңгілік сенікі боламын
Dialogue: 0,1:07:22.44,1:07:25.84,Default,,0,0,0,,Сіздің жағыңызда...
Dialogue: 0,1:07:28.25,1:07:32.15,Default,,0,0,0,,Куу…
Dialogue: 0,1:07:40.49,1:07:45.03,Default,,0,0,0,,Бұл мені өлтірмейді, бірақ біраз уақыт дұрыс жүре алмайтын шығармын.
Dialogue: 0,1:07:45.03,1:07:49.60,Default,,0,0,0,,Олардың біреуін де тірі қалдырмаңыз!
Dialogue: 0,1:07:49.60,1:07:52.20,Default,,0,0,0,,Уау!
Dialogue: 0,1:08:12.89,1:08:17.43,Default,,0,0,0,,Шу киелі ескерткіш – айқыш кесененің төбесі
Dialogue: 0,1:08:17.43,1:08:19.40,Default,,0,0,0,,Жерді ұстамаңыз
Dialogue: 0,1:08:19.40,1:08:23.10,Default,,0,0,0,,Жерге түссе, барымтадағылар өледі.
Dialogue: 0,1:08:26.17,1:08:29.47,Default,,0,0,0,,Нуах... уф...
Dialogue: 0,1:08:32.38,1:08:34.31,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,1:08:34.31,1:08:38.05,Default,,0,0,0,,Бұл жартасты өз өмірің деп ойласаң, ол ауыр емес.
Dialogue: 0,1:08:38.05,1:08:43.35,Default,,0,0,0,,Өмірім бітсе де жаныммен сені қолдаймын.
Dialogue: 0,1:08:48.33,1:08:50.83,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:29.10,1:09:31.40,Default,,0,0,0,,Не болды? Шу
Dialogue: 0,1:09:31.40,1:09:35.24,Default,,0,0,0,,Ол жақта күш-қуатым таусылып қалса да, барымтадағыларға аямаймын.
Dialogue: 0,1:09:35.24,1:09:40.74,Default,,0,0,0,,Нуу! Ах... Шуу-сама
Dialogue: 0,1:09:54.59,1:09:57.59,Default,,0,0,0,,Мен сезінемін...
Dialogue: 0,1:10:02.67,1:10:05.67,Default,,0,0,0,,Кенширо келе жатыр.
Dialogue: 0,1:10:10.11,1:10:14.21,Default,,0,0,0,,Нуваа!
Dialogue: 0,1:10:21.12,1:10:23.32,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,1:10:40.84,1:10:44.64,Default,,0,0,0,,Шу, қазір барайық.
Dialogue: 0,1:10:44.64,1:10:47.28,Default,,0,0,0,,Бала! Шуға қолыңды қойсаң
Dialogue: 0,1:10:47.28,1:10:49.58,Default,,0,0,0,,Кепілдегі барлық баланы өлтіріңіз.
Dialogue: 0,1:10:51.62,1:10:53.85,Default,,0,0,0,,Кенширо!
Dialogue: 0,1:10:53.85,1:10:57.69,Default,,0,0,0,,Мен! Бұл ескерткішті салу керек!
Dialogue: 0,1:10:57.69,1:11:02.39,Default,,0,0,0,,Бұл тас барымтаның өмірі.
Dialogue: 0,1:11:02.39,1:11:06.70,Default,,0,0,0,,Ал Нанто бұзылуының алдын алу мүмкін болмады.
Dialogue: 0,1:11:06.70,1:11:09.33,Default,,0,0,0,,Менің жаным!
Dialogue: 0,1:11:09.33,1:11:13.43,Default,,0,0,0,,Ооо!
Dialogue: 0,1:11:18.94,1:11:23.72,Default,,0,0,0,,Шу, сенің Нанто қаның гипске айналады.
Dialogue: 0,1:11:23.72,1:11:26.55,Default,,0,0,0,,Кресттің қабірі толық болады.
Dialogue: 0,1:11:26.55,1:11:31.39,Default,,0,0,0,,Жарайсың, Оңтүстік! Бірақ!
Dialogue: 0,1:11:31.39,1:11:35.66,Default,,0,0,0,,Бұл Қасиетті императордың крест кесенесі ақырында құлап қалады!
Dialogue: 0,1:11:35.66,1:11:39.66,Default,,0,0,0,,Хокуто Шинкеннің ізбасарларының қолымен!
Dialogue: 0,1:11:39.66,1:11:42.73,Default,,0,0,0,,Бұл Нантоның тағдыры!
Dialogue: 0,1:11:42.73,1:11:47.73,Default,,0,0,0,,Нанто императордың жұлдызындай жарқырамайды!
Dialogue: 0,1:11:49.64,1:11:51.64,Default,,0,0,0,,Гах...
Dialogue: 0,1:11:56.28,1:11:58.58,Default,,0,0,0,,Хехе...
Dialogue: 0,1:12:00.69,1:12:03.69,Default,,0,0,0,,Гуоа...
Dialogue: 0,1:12:06.26,1:12:10.86,Default,,0,0,0,,Шу!
Dialogue: 0,1:12:20.91,1:12:24.51,Default,,0,0,0,,Кенширо Шамасы
Dialogue: 0,1:12:24.51,1:12:27.21,Default,,0,0,0,,Менің өмірім осында аяқталады
Dialogue: 0,1:12:31.12,1:12:33.32,Default,,0,0,0,,Хехе...
Dialogue: 0,1:12:37.42,1:12:39.82,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,1:12:48.47,1:12:50.77,Default,,0,0,0,,Шу! Хаха!
Dialogue: 0,1:12:50.77,1:12:55.61,Default,,0,0,0,,Шу! Кен... Широ!
Dialogue: 0,1:12:55.61,1:13:00.25,Default,,0,0,0,,Көремін... Көремін.
Dialogue: 0,1:13:00.25,1:13:02.35,Default,,0,0,0,,Сіздің бетіңіз
Dialogue: 0,1:13:04.78,1:13:07.15,Default,,0,0,0,,Шу
Dialogue: 0,1:13:07.15,1:13:13.59,Default,,0,0,0,,Құдай маған соңғы бір тілегімді берді.
Dialogue: 0,1:13:13.59,1:13:18.86,Default,,0,0,0,,Менің Джинсей қаным қателеспеді.
Dialogue: 0,1:13:18.86,1:13:21.20,Default,,0,0,0,,Енді өкінбеймін
Dialogue: 0,1:13:21.20,1:13:25.50,Default,,0,0,0,,Юк Кенширо
Dialogue: 0,1:13:25.50,1:13:28.51,Default,,0,0,0,,Дәуірді ашу
Dialogue: 0,1:13:28.51,1:13:32.31,Default,,0,0,0,,Мен әрқашан
Dialogue: 0,1:13:32.31,1:13:35.18,Default,,0,0,0,,Саған қарап
Dialogue: 0,1:13:35.18,1:13:37.28,Default,,0,0,0,,Спидвегон, мен мұнда келдім —
Dialogue: 0,1:13:59.30,1:14:03.70,Default,,0,0,0,,Шу!
Dialogue: 0,1:14:12.85,1:14:16.95,Default,,0,0,0,,Менің ішімде өмір сүр, Цзиньсейдің Шуы
Dialogue: 0,1:14:19.42,1:14:22.66,Default,,0,0,0,,Оңтүстік!
Dialogue: 0,1:14:22.66,1:14:25.60,Default,,0,0,0,,Тіпті бір шашың да
Dialogue: 0,1:14:25.60,1:14:28.50,Default,,0,0,0,,Бұл дүниеде енді қалмады!
Dialogue: 0,1:14:32.67,1:14:36.67,Default,,0,0,0,,Бұл айқай сенің соңғы еркі болады.
Dialogue: 0,1:14:46.85,1:14:49.65,Default,,0,0,0,,Кепілге алудың қажеті жоқ
Dialogue: 0,1:14:49.65,1:14:53.96,Default,,0,0,0,,Қазір Нанто мен Хокуто арасындағы кездесудің уақыты.
Dialogue: 0,1:14:53.96,1:14:57.30,Default,,0,0,0,,Мына тас баспалдақ Шудың мұңы
Dialogue: 0,1:14:57.30,1:15:00.90,Default,,0,0,0,,Әр қадамды ұстап, жоғары көтеріліңіз.
Dialogue: 0,1:15:05.34,1:15:07.74,Default,,0,0,0,,Қасиетті императордың қолы да мені мазалайды...
Dialogue: 0,1:15:07.74,1:15:10.14,Default,,0,0,0,,Вабебо! Уау
Dialogue: 0,1:15:15.25,1:15:19.25,Default,,0,0,0,,Бұл кім? Міне!
Dialogue: 0,1:15:38.17,1:15:41.07,Default,,0,0,0,,Осы сіріңкенің жолында тұрғандар
Dialogue: 0,1:15:41.07,1:15:44.41,Default,,0,0,0,,Бұл Хокутоның үлкені мен екінші ағасы мені кешір.
Dialogue: 0,1:15:44.41,1:15:48.91,Default,,0,0,0,,Оңтүстік! Сіздің амбицияларыңыз осымен аяқталады.
Dialogue: 0,1:15:48.91,1:15:50.85,Default,,0,0,0,,Хун дұрыс
Dialogue: 0,1:15:50.85,1:15:55.69,Default,,0,0,0,,Мен үшеуіңді бірге Қасиетті императордың крест кесенесінің негізін саламын.
Dialogue: 0,1:15:55.69,1:16:00.16,Default,,0,0,0,,Кенширо, Құдай сені осы қасиетті императорға берді, Оңтүстік.
Dialogue: 0,1:16:00.16,1:16:02.76,Default,,0,0,0,,Мен ет алдында жеңілемін.
Dialogue: 0,1:16:16.34,1:16:19.44,Default,,0,0,0,,Өлді, Хокуто Шинкен
Dialogue: 0,1:16:32.59,1:16:36.29,Default,,0,0,0,,Хехехе... Сен, Шудың Нанто Ширасаги жұдырығы.
Dialogue: 0,1:16:41.27,1:16:44.04,Default,,0,0,0,,Денеңізде кем дегенде бір жара бар
Dialogue: 0,1:16:44.04,1:16:46.57,Default,,0,0,0,,Мен сені Шудың жұдырығымен жаудырғым келді
Dialogue: 0,1:16:46.57,1:16:50.97,Default,,0,0,0,,Бірақ сені жеңетін жалғыз нәрсе – аласапыран дүниенің жұдырығы.
Dialogue: 0,1:16:55.35,1:16:57.45,Default,,0,0,0,,Хокуто Шинкен
Dialogue: 0,1:17:03.59,1:17:06.19,Default,,0,0,0,,Фухахахаха...
Dialogue: 0,1:17:06.19,1:17:11.43,Default,,0,0,0,,Ақымақ, Хокуто Шинкеннің бұл Қасиетті Императорға әсері жоқ.
Dialogue: 0,1:17:11.43,1:17:14.33,Default,,0,0,0,,Келіңіздер! Кел, Кенширо!
Dialogue: 0,1:17:14.33,1:17:16.73,Default,,0,0,0,,Тарту!
Dialogue: 0,1:17:16.73,1:17:19.63,Default,,0,0,0,,Howataa!
Dialogue: 0,1:17:21.61,1:17:26.01,Default,,0,0,0,,Уау, жылы...
Dialogue: 0,1:17:26.01,1:17:29.21,Default,,0,0,0,,Ата!
Dialogue: 0,1:17:34.55,1:17:38.99,Default,,0,0,0,,Фухахаха... Жұдырығыңнан қан төгілсе де
Dialogue: 0,1:17:38.99,1:17:43.23,Default,,0,0,0,,Бұл императордың байланысын үзу мүмкін емес.
Dialogue: 0,1:17:43.23,1:17:46.63,Default,,0,0,0,,Мұның бәрі көңіл көтеру үшін, Кенширо!
Dialogue: 0,1:17:55.74,1:17:59.74,Default,,0,0,0,,Хехехехе...
Dialogue: 0,1:17:59.74,1:18:03.82,Default,,0,0,0,,Фухахаха! Тыңдамаңыз
Dialogue: 0,1:18:03.82,1:18:05.82,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,1:18:18.33,1:18:20.73,Default,,0,0,0,,Ха! бұл!
Dialogue: 0,1:18:20.73,1:18:23.93,Default,,0,0,0,,Пайдасы жоқ, өл, Кенширо!
Dialogue: 0,1:18:32.08,1:18:35.58,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,1:18:37.58,1:18:39.68,Default,,0,0,0,,Ну!
Dialogue: 0,1:18:41.52,1:18:43.89,Default,,0,0,0,,Өлім алдында тұрған жаман жігіт
Dialogue: 0,1:18:43.89,1:18:46.79,Default,,0,0,0,,Бауырларыңның алдында көрге барыңдар!
Dialogue: 0,1:18:51.63,1:18:54.33,Default,,0,0,0,,Құпия тесік ше?
Dialogue: 0,1:18:56.90,1:19:01.37,Default,,0,0,0,,Жүрегіңнің соғуы мен қанның ағысы мені жұмбақ шешуге мәжбүр етті!
Dialogue: 0,1:19:01.37,1:19:03.47,Default,,0,0,0,,Хм, сен қандай бос сөз айтып тұрсың?
Dialogue: 0,1:19:05.58,1:19:09.88,Default,,0,0,0,,Nu? Ооо!
Dialogue: 0,1:19:11.88,1:19:17.12,Default,,0,0,0,,Жүректің орны да, жасырын тесігінің орны да өзгереді.
Dialogue: 0,1:19:17.12,1:19:22.02,Default,,0,0,0,,Бұл сенің жұмбағың. Сіз оны білгеннен кейін, бұл үлкен мәселе емес.
Dialogue: 0,1:19:25.96,1:19:30.54,Default,,0,0,0,,Хокуто Шинкеннің мұрагері күткендей, сіз оны көрдіңіз.
Dialogue: 0,1:19:30.54,1:19:33.94,Default,,0,0,0,,Бірақ мұның өзі менің жұмбағымды түсінгеніңді білдірмейді.
Dialogue: 0,1:19:49.62,1:19:51.92,Default,,0,0,0,,Нанто Феникс жұдырықтарының құпия техникасы
Dialogue: 0,1:19:51.92,1:19:54.92,Default,,0,0,0,,Теншо Кросс Феникс
Dialogue: 0,1:20:03.00,1:20:05.80,Default,,0,0,0,,Нанто Феникс жұдырығына дайын! ?
Dialogue: 0,1:20:05.80,1:20:10.41,Default,,0,0,0,,Императордың жұдырығы Нанто Феникс Фисттің ұстанымы жоқ.
Dialogue: 0,1:20:10.41,1:20:13.34,Default,,0,0,0,,Барлық жаулар бейбақ!
Dialogue: 0,1:20:13.34,1:20:16.05,Default,,0,0,0,,Тең жау пайда болған кезде
Dialogue: 0,1:20:16.05,1:20:18.95,Default,,0,0,0,,Біз бос әурешіліктен бас тартып, тұруымыз керек.
Dialogue: 0,1:20:18.95,1:20:23.15,Default,,0,0,0,,Императордың мақтанышына айналған жеңілмеген жұдырықпен!
Dialogue: 0,1:20:25.59,1:20:28.19,Default,,0,0,0,,Олай болса мен сенің алғысыңды қайтарамын.
Dialogue: 0,1:20:46.88,1:20:51.72,Default,,0,0,0,,Бұл Хокуто Шинкеннің құпия техникасы: Тенха жоқ ұстаным
Dialogue: 0,1:20:51.72,1:20:54.45,Default,,0,0,0,,Бір-біріне жұдырықтардың құпия тәсілдерін қолданды.
Dialogue: 0,1:20:54.45,1:20:59.16,Default,,0,0,0,,Екі адамның жеңісті немесе жеңілісті анықтау қабілеті ғана қалды.
Dialogue: 0,1:20:59.16,1:21:03.76,Default,,0,0,0,,Хехехе... Аспан да толқып тұр.
Dialogue: 0,1:21:14.17,1:21:16.67,Default,,0,0,0,,Бұл! Бұршақ
Dialogue: 0,1:21:19.14,1:21:23.74,Default,,0,0,0,,Кеттік, Кенширо, бізге аспандағы екі полярлық жұлдыз керек емес!
Dialogue: 0,1:21:35.43,1:21:42.00,Default,,0,0,0,,Аспанда билеген қанатты ешкім сындыра алмайды!
Dialogue: 0,1:21:42.00,1:21:45.20,Default,,0,0,0,,Жылы...фухахахаха...
Dialogue: 0,1:21:47.67,1:21:49.97,Default,,0,0,0,,Уау! Кен!
Dialogue: 0,1:21:52.51,1:21:58.05,Default,,0,0,0,,Хокуто Шинкеннің 1800 жылдық тарихы осында аяқталады.
Dialogue: 0,1:21:58.05,1:22:03.85,Default,,0,0,0,,Бір ғана поляр жұлдыз бар, ал аспанда жарқыраған император - Оңтүстік крест
Dialogue: 0,1:22:03.85,1:22:07.12,Default,,0,0,0,,Ол осы Қасиетті Император Оңтүстіктің генералы.
Dialogue: 0,1:22:07.12,1:22:09.12,Default,,0,0,0,,Аяқта, Кенширо!
Dialogue: 0,1:22:13.56,1:22:15.80,Default,,0,0,0,,Хокуто Шинкеннің құпия техникасы
Dialogue: 0,1:22:15.80,1:22:19.10,Default,,0,0,0,,Тенханың өмірі мен өлімі
Dialogue: 0,1:22:25.21,1:22:28.31,Default,,0,0,0,,Не? Менің артымдағы тас!
Dialogue: 0,1:22:30.65,1:22:32.58,Default,,0,0,0,,Өмір мен өлімнің жұмбағы
Dialogue: 0,1:22:32.58,1:22:37.19,Default,,0,0,0,,Құпия тесікке қол тигізбей, жауынгерлік рухпен тесіп өту туралы.
Dialogue: 0,1:22:37.19,1:22:39.89,Default,,0,0,0,,Жалпы құлау керек
Dialogue: 0,1:22:42.59,1:22:45.50,Default,,0,0,0,,Құпия тесігім төңкерілсе де
Dialogue: 0,1:22:45.50,1:22:48.00,Default,,0,0,0,,Құпия тесіктің нақты орны белгісіз.
Dialogue: 0,1:22:48.00,1:22:50.40,Default,,0,0,0,,Құрыш әлдеқашан жұлынған.
Dialogue: 0,1:22:50.40,1:22:53.14,Default,,0,0,0,,Уау! ? Мынау... мынау! ?
Dialogue: 0,1:22:53.14,1:22:55.97,Default,,0,0,0,,Құпия тесік ашылды
Dialogue: 0,1:22:55.97,1:22:59.98,Default,,0,0,0,,О... Мен Нанто Сейкендегі ең күшті адаммын.
Dialogue: 0,1:22:59.98,1:23:02.65,Default,,0,0,0,,Сен мені жеңе алмайсың
Dialogue: 0,1:23:02.65,1:23:06.55,Default,,0,0,0,,Ха!
Dialogue: 0,1:23:08.92,1:23:10.89,Default,,0,0,0,,Қанатты Нанто Феникс жұдырығы
Dialogue: 0,1:23:10.89,1:23:14.79,Default,,0,0,0,,Сіз оған өлімші жұдырық тигізе алмайсыз.
Dialogue: 0,1:23:14.79,1:23:18.26,Default,,0,0,0,,Ха! Не?
Dialogue: 0,1:23:18.26,1:23:20.20,Default,,0,0,0,,Ах... аяқтар!
Dialogue: 0,1:23:20.20,1:23:22.87,Default,,0,0,0,,Феникс ұшуын тоқтатты.
Dialogue: 0,1:23:22.87,1:23:24.97,Default,,0,0,0,,Қанаттарыңнан айырылдыңдар.
Dialogue: 0,1:23:28.44,1:23:32.24,Default,,0,0,0,,Қанаттарым жоғалса да
Dialogue: 0,1:23:34.81,1:23:38.62,Default,,0,0,0,,Мен Оңтүстік императорымын
Dialogue: 0,1:23:38.62,1:23:42.19,Default,,0,0,0,,Оңтүстік Айнақтың императоры
Dialogue: 0,1:23:42.19,1:23:46.42,Default,,0,0,0,,Шегінме! Жеңілдетіңіз! Ұмытпа!
Dialogue: 0,1:23:46.42,1:23:49.93,Default,,0,0,0,,Император қашпайды!
Dialogue: 0,1:23:49.93,1:23:51.86,Default,,0,0,0,,Нуах!
Dialogue: 0,1:23:51.86,1:23:53.86,Default,,0,0,0,,Ха!
Dialogue: 0,1:23:53.86,1:23:58.74,Default,,0,0,0,,Ах та та та та та та…
Dialogue: 0,1:23:58.74,1:24:05.54,Default,,0,0,0,,Гухаа!
Dialogue: 0,1:24:08.68,1:24:11.58,Default,,0,0,0,,Бұл Хокуто Юджоның қатты ұшуы.
Dialogue: 0,1:24:11.58,1:24:13.98,Default,,0,0,0,,Ол жігіт, сіздің техникаңыз.
Dialogue: 0,1:24:16.32,1:24:19.32,Default,,0,0,0,,ешкімге достықты мәжбүрлеп таңушы емеспін.
Dialogue: 0,1:24:19.32,1:24:22.43,Default,,0,0,0,,Ауыртпайтын сезімтал жұдырық
Dialogue: 0,1:24:22.43,1:24:26.40,Default,,0,0,0,,Тіпті өлім де мені ауыртпайды.
Dialogue: 0,1:24:26.40,1:24:30.17,Default,,0,0,0,,Сіз оны аяғандықтан жібересіз бе?
Dialogue: 0,1:24:30.17,1:24:35.97,Default,,0,0,0,,Сол күні Шу сені құтқарғанын енді білемін.
Dialogue: 0,1:24:35.97,1:24:38.88,Default,,0,0,0,,Саған сеніп тапсырған сезімдерім
Dialogue: 0,1:24:38.88,1:24:42.31,Default,,0,0,0,,Бірақ аяудың қажеті жоқ.
Dialogue: 0,1:24:42.31,1:24:47.01,Default,,0,0,0,,Мен Оңтүстік императорымын! Сіз Хокуто Шинкеннен өлмейсіз!
Dialogue: 0,1:24:50.89,1:24:53.42,Default,,0,0,0,,Адамдар махаббаттың кесірінен зардап шегеді
Dialogue: 0,1:24:53.42,1:24:57.23,Default,,0,0,0,,Сол себепті мен мейірімсіздіктің маскасын киемін
Dialogue: 0,1:24:57.23,1:25:03.03,Default,,0,0,0,,Бірақ сіз бұл азапты да жеңесіз.
Dialogue: 0,1:25:03.03,1:25:09.43,Default,,0,0,0,,Кенширо, сенің соңғы қарсыласың сен болғаныңа қуаныштымын.
Dialogue: 0,1:26:10.84,1:26:14.14,Default,,0,0,0,,Қарашы, Раох, менің жүрегім бір кісідей елжіреп кетті.
Dialogue: 0,1:26:17.14,1:26:20.64,Default,,0,0,0,,Ал Шудың Джинсейі де жылап отыр.
Dialogue: 0,1:26:23.91,1:26:26.11,Default,,0,0,0,,Шу
Dialogue: 0,1:26:33.59,1:26:37.39,Default,,0,0,0,,Раох, әлем енді сенікі.
Dialogue: 0,1:26:37.39,1:26:40.30,Default,,0,0,0,,Бірақ қорқыныш адамдарды байланыстырмайды.
Dialogue: 0,1:26:40.30,1:26:43.50,Default,,0,0,0,,Жоқ, жаулау әлі аяқталған жоқ.
Dialogue: 0,1:26:43.50,1:26:45.77,Default,,0,0,0,,Мен енді түсіндім
Dialogue: 0,1:26:45.77,1:26:48.07,Default,,0,0,0,,Мен сені мен Кеншироны жеңбесем.
Dialogue: 0,1:26:48.07,1:26:50.67,Default,,0,0,0,,Аспан нені ұстай алмайды
Dialogue: 0,1:27:11.63,1:27:13.56,Default,,0,0,0,,Бауырым!
Dialogue: 0,1:27:13.56,1:27:17.36,Default,,0,0,0,,Бат... Бат-нии-чан!
Dialogue: 0,1:27:21.17,1:27:23.14,Default,,0,0,0,,Бұл не, кемпір?
Dialogue: 0,1:27:23.14,1:27:26.38,Default,,0,0,0,,Кен мен Рин қайда кетті?
Dialogue: 0,1:27:26.38,1:27:31.05,Default,,0,0,0,,Сен мені қиналып жатырсың, сондықтан мен оған шыдап жүрмін.
Dialogue: 0,1:27:31.05,1:27:35.29,Default,,0,0,0,,Сіз қазір кетесіз бе? О
Dialogue: 0,1:27:35.29,1:27:39.46,Default,,0,0,0,,үшінн мазаламаңыз. Сен не туралы айтып тұрсың?
Dialogue: 0,1:27:39.46,1:27:42.09,Default,,0,0,0,,Олар менсіз ештеңе істей алмайды.
Dialogue: 0,1:27:42.09,1:27:44.56,Default,,0,0,0,,Бұл Рин Чан болса, Токидің орнына барыңыз.
Dialogue: 0,1:27:44.56,1:27:47.36,Default,,0,0,0,,Сонша шуламаңыз! Мен білемін
Dialogue: 0,1:27:47.36,1:27:50.70,Default,,0,0,0,,Олай болса асығыңыз, біз бос емеспіз.
Dialogue: 0,1:27:50.70,1:27:54.64,Default,,0,0,0,,Білемін, көріскенше, әже.
Dialogue: 0,1:27:54.64,1:27:57.31,Default,,0,0,0,,Ең көбі ұзақ өмір сүріңіз
Dialogue: 0,1:27:57.31,1:27:59.91,Default,,0,0,0,,Жарғанат! Мынаны әкел!
Dialogue: 0,1:27:59.91,1:28:03.45,Default,,0,0,0,,А? а!
Dialogue: 0,1:28:03.45,1:28:06.35,Default,,0,0,0,,Қажет емес! ммм...
Dialogue: 0,1:28:06.35,1:28:10.96,Default,,0,0,0,,Жарайды, қай кезде келсең де, жақсы болғаныңды қалаймын.
Dialogue: 0,1:28:10.96,1:28:14.46,Default,,0,0,0,,Ол әркім өңдейтін егістікте жасалған.
Dialogue: 0,1:28:18.36,1:28:21.27,Default,,0,0,0,,Әй, қарашы, ғажап емес пе?
Dialogue: 0,1:28:21.27,1:28:23.63,Default,,0,0,0,,Рахмет
Dialogue: 0,1:28:23.63,1:28:26.03,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:28:30.17,1:28:32.27,Default,,0,0,0,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,1:28:45.46,1:28:48.36,Default,,0,0,0,,Рейна мырза, мен...
Dialogue: 0,1:28:48.36,1:28:51.86,Default,,0,0,0,,Токи, бұл сен бола аласың ба?
Dialogue: 0,1:28:54.03,1:28:55.97,Default,,0,0,0,,Мен емес
Dialogue: 0,1:28:55.97,1:29:00.30,Default,,0,0,0,,Раоның жасырын тесік техникасы сізді өмірге қайтарды.
Dialogue: 0,1:29:00.30,1:29:02.77,Default,,0,0,0,,Рао ше? Раох қайда?
Dialogue: 0,1:29:02.77,1:29:08.35,Default,,0,0,0,,«Мен міндетті түрде қайтамын, сондықтан қайтуыңды Шура жерінде күт».
Dialogue: 0,1:29:08.35,1:29:11.18,Default,,0,0,0,,Раох осылай деді ме?
Dialogue: 0,1:29:11.18,1:29:14.85,Default,,0,0,0,,Иә! Рэйна Саузер қайтыс болды.
Dialogue: 0,1:29:14.85,1:29:17.45,Default,,0,0,0,,Сіз де осы уақытқа дейін.
Dialogue: 0,1:29:17.45,1:29:21.46,Default,,0,0,0,,Қолдарыңыз енді қанға боялмайды.
Dialogue: 0,1:29:21.46,1:29:24.19,Default,,0,0,0,,Раох оны бірінші рет көрсетті
Dialogue: 0,1:29:24.19,1:29:26.26,Default,,0,0,0,,Мейірімді жүрек
Dialogue: 0,1:29:26.26,1:29:28.67,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,1:29:28.67,1:29:32.34,Default,,0,0,0,,Ол кісі әрқашан солай болған.
Dialogue: 0,1:29:32.34,1:29:35.01,Default,,0,0,0,,Басқалардан да күшті
Dialogue: 0,1:29:35.01,1:29:37.31,Default,,0,0,0,,Оның жүрегі басқаларға қарағанда жылырақ.
Dialogue: 0,1:29:39.58,1:29:41.68,Default,,0,0,0,,Уф...
Dialogue: 0,1:29:51.59,1:29:56.49,Default,,0,0,0,,Суга: Біз шығыс елге барамыз.
Dialogue: 0,1:29:56.49,1:30:00.30,Default,,0,0,0,,Джукей шебері осылай деп бұйырды. Сіз жалғызсыз ба? Раох
Dialogue: 0,1:30:00.30,1:30:03.67,Default,,0,0,0,,Жоқ, Токи мен Кенширо бірдей.
Dialogue: 0,1:30:03.67,1:30:07.54,Default,,0,0,0,,Рюкен жекпе-жекпен қарияның орнында жаттығады.
Dialogue: 0,1:30:07.54,1:30:10.81,Default,,0,0,0,,Бұл тамаша. Кенподағы жаттығу туралы не айтасыз?
Dialogue: 0,1:30:10.81,1:30:14.78,Default,,0,0,0,,Жоқ, мен бұл елден кете аламын.
Dialogue: 0,1:30:14.78,1:30:18.52,Default,,0,0,0,,Бұл ел қазірдің өзінде соғыс салдарынан күйреуде.
Dialogue: 0,1:30:18.52,1:30:24.12,Default,,0,0,0,,Ол жерде әлі қауіпсіз сияқты. Саған жақсы, Раох.
Dialogue: 0,1:30:24.12,1:30:27.83,Default,,0,0,0,,Жарайсың ба? Суга: Мен өлсем түсінбеймін.
Dialogue: 0,1:30:27.83,1:30:33.26,Default,,0,0,0,,Біз бәрінен де күшті болып, бір күні бұл елге қайтамыз.
Dialogue: 0,1:30:33.26,1:30:35.67,Default,,0,0,0,,Ал мен бәріңді қорғаймын.
Dialogue: 0,1:30:35.67,1:30:39.94,Default,,0,0,0,,Мен сенімдімін... ммм.
Dialogue: 0,1:30:39.94,1:30:42.24,Default,,0,0,0,,Уайымдама, Рейна.
Dialogue: 0,1:30:45.18,1:30:48.91,Default,,0,0,0,,үшінн қорғау? Рау керемет.
Dialogue: 0,1:30:48.91,1:30:53.11,Default,,0,0,0,,Керемет емес, мүлде керемет емес
Dialogue: 0,1:30:56.49,1:31:00.69,Default,,0,0,0,,Бұл сенің бойтұмарың, Рейна, мен міндетті түрде қайтамын.
Dialogue: 0,1:31:04.56,1:31:08.66,Default,,0,0,0,,Уәде беремін бе? Хехе...
Dialogue: 0,1:31:25.62,1:31:30.72,Default,,0,0,0,,Раох маған бұны енді ешқашан тастама деді.
Dialogue: 0,1:32:41.66,1:32:45.83,Default,,0,0,0,,Қызғылт түске айналу
Dialogue: 0,1:32:45.83,1:32:49.70,Default,,0,0,0,,Шинономды қуу
Dialogue: 0,1:32:49.70,1:32:53.87,Default,,0,0,0,,Шапшаң қалау машинасы
Dialogue: 0,1:32:53.87,1:32:57.41,Default,,0,0,0,,Сізді сапарға шығарып салыңыз
Dialogue: 0,1:32:57.41,1:33:01.78,Default,,0,0,0,,Хош иісті шаш желде билейді
Dialogue: 0,1:33:01.78,1:33:05.65,Default,,0,0,0,,Мен бір-бірімді көбірек құшақтағым келеді
Dialogue: 0,1:33:05.65,1:33:09.62,Default,,0,0,0,,Әлгі жігіт қанды екен
Dialogue: 0,1:33:09.62,1:33:12.72,Default,,0,0,0,,Жалындаған өшпенділік
Dialogue: 0,1:33:12.72,1:33:16.59,Default,,0,0,0,,Жердің шетіне қашу
Dialogue: 0,1:33:16.59,1:33:20.53,Default,,0,0,0,,Барлық қорқынышты нәрселерді сүртіңіз
Dialogue: 0,1:33:20.53,1:33:24.64,Default,,0,0,0,,үшін жаңа сәт
Dialogue: 0,1:33:24.64,1:33:29.84,Default,,0,0,0,,Артыңызға қарамаңыз
Dialogue: 0,1:33:33.21,1:33:37.45,Default,,0,0,0,,Құбыжықтарға арналған жүрек
Dialogue: 0,1:33:37.45,1:33:41.32,Default,,0,0,0,,Қатты жеу
Dialogue: 0,1:33:41.32,1:33:45.32,Default,,0,0,0,,Мен сені ойламай тұра алмаймын
Dialogue: 0,1:33:45.32,1:33:49.06,Default,,0,0,0,,Мен оны ұрлап алдым.
Dialogue: 0,1:33:49.06,1:33:53.40,Default,,0,0,0,,Осы кең әлемде
Dialogue: 0,1:33:53.40,1:33:57.23,Default,,0,0,0,,Екі адам ғана бар сияқты.
Dialogue: 0,1:33:57.23,1:34:01.10,Default,,0,0,0,,Жалғыздықтың дәмін тат
Dialogue: 0,1:34:01.10,1:34:04.07,Default,,0,0,0,,Кеудеңізді тырнаңыз
Dialogue: 0,1:34:04.07,1:34:08.28,Default,,0,0,0,,Жердің шетіне қашу
Dialogue: 0,1:34:08.28,1:34:12.15,Default,,0,0,0,,Сол жардан ұшсаң, көк аспан
Dialogue: 0,1:34:12.15,1:34:16.09,Default,,0,0,0,,Өмір мен өлімнің күшті иісі
Dialogue: 0,1:34:16.09,1:34:21.29,Default,,0,0,0,,Толқып кеткендей дауысыңды көтер.
Dialogue: 0,1:34:21.29,1:34:25.13,Default,,0,0,0,,Мен мұны жаңа ғана алдым.
Dialogue: 0,1:34:25.13,1:34:29.83,Default,,0,0,0,,Бостандық Мен бұрын-соңды көрмегенмін
Dialogue: 0,1:34:43.88,1:34:47.78,Default,,0,0,0,,Қашып кету Мен сайқымазақпын
Dialogue: 0,1:34:47.78,1:34:51.76,Default,,0,0,0,,Арнаулы және әзілқой қашқын
Dialogue: 0,1:34:51.76,1:34:55.83,Default,,0,0,0,,Көз жасын төкпе
Dialogue: 0,1:34:55.83,1:34:59.70,Default,,0,0,0,,Өмір мұңды, бірақ әдемі
Dialogue: 0,1:34:59.70,1:35:03.60,Default,,0,0,0,,Мен енді қараңғы болашақты салмаймын
Dialogue: 0,1:35:03.60,1:35:11.40,Default,,0,0,0,,Армандардың жылдамдығы енді бәсеңдей алмайды
Dialogue: 0,1:35:12.90,1:35:18.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
