Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.07,0:00:09.24,Default,,0,0,0,,1-том: Шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:00.86,0:00:04.48,Default,,0,0,0,,Азур Лейн
Dialogue: 0,0:00:05.70,0:00:09.03,Default,,0,0,0,,Командир, біраз уақыт болды. Қалайсың?
Dialogue: 0,0:00:09.49,0:00:12.90,Default,,0,0,0,,Иә, біз? Біз...
Dialogue: 0,0:00:12.90,0:00:14.24,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:00:14.58,0:00:16.75,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:00:17.21,0:00:18.62,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:00:18.62,0:00:21.75,Default,,0,0,0,,Бұл сіздің үй портыңыз емес сияқты...
Dialogue: 0,0:00:22.09,0:00:25.26,Default,,0,0,0,,Бұндай жағдайда мен бірінші кезекте жақын маңдағы ауылға барамын.
Dialogue: 0,0:00:25.59,0:00:27.88,Default,,0,0,0,,Сонда ауыл қайда?
Dialogue: 0,0:00:29.92,0:00:31.39,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:00:33.17,0:00:35.71,Default,,0,0,0,,Сіз шынымен жақсысыз ба?
Dialogue: 0,0:00:35.71,0:00:39.25,Default,,0,0,0,,Бұл туралы уайымдаудың пайдасы жоқ, сондықтан ары қарай жүрейік.
Dialogue: 0,0:00:39.25,0:00:41.77,Default,,0,0,0,,Бірақ бұл Акаши туралы.
Dialogue: 0,0:00:42.73,0:00:44.65,Default,,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,0:00:44.65,0:00:47.03,Default,,0,0,0,,Аяқталды
Dialogue: 0,0:00:47.03,0:00:48.34,Default,,0,0,0,,О
Dialogue: 0,0:00:48.34,0:00:50.56,Default,,0,0,0,,Жаңа VR ойыны
Dialogue: 0,0:00:50.56,0:00:51.59,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:00:51.59,0:00:54.91,Default,,0,0,0,,Мен барлығына алдымен ойнауға ерекше мүмкіндік беремін деп ойладым.
Dialogue: 0,0:00:57.11,0:00:59.29,Default,,0,0,0,,Бұл қаншалықты ыңғайлы?
Dialogue: 0,0:00:59.29,0:01:00.68,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:01:00.68,0:01:02.92,Default,,0,0,0,,Мен мұны ешкім жасайды деп айтпаймын.
Dialogue: 0,0:01:03.09,0:01:03.97,Default,,0,0,0,,Шпион
Dialogue: 0,0:01:04.79,0:01:08.30,Default,,0,0,0,,Жарайды, ойынды бастайық.
Dialogue: 0,0:01:11.02,0:01:11.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:12.26,0:01:13.30,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:13.57,0:01:15.85,Default,,0,0,0,,Жарайды...онда мен барайын.
Dialogue: 0,0:01:15.85,0:01:17.54,Default,,0,0,0,,Эй...эй...
Dialogue: 0,0:01:18.54,0:01:21.06,Default,,0,0,0,,Акашидің «а» белгісі қандай болды?
Dialogue: 0,0:01:21.27,0:01:24.44,Default,,0,0,0,,Күрсін, мен жаттығуға уақытында үйге барғым келеді.
Dialogue: 0,0:01:24.76,0:01:26.94,Default,,0,0,0,,Қайту оңай емес.
Dialogue: 0,0:01:26.94,0:01:27.87,Default,,0,0,0,,Акаши?
Dialogue: 0,0:01:27.87,0:01:29.69,Default,,0,0,0,,Қайтуға болмайды дегеніңіз не?
Dialogue: 0,0:01:30.03,0:01:32.11,Default,,0,0,0,,Шындығында, аздап қиындық болды.
Dialogue: 0,0:01:32.11,0:01:34.70,Default,,0,0,0,,Мен енді ойынды аяқтай алмаймын.
Dialogue: 0,0:01:34.70,0:01:36.95,Default,,0,0,0,,Иә
Dialogue: 0,0:01:34.70,0:01:36.95,Default,,0,0,0,,Иә
Dialogue: 0,0:01:36.95,0:01:39.15,Default,,0,0,0,,Бірақ ойынның өзінде ешқандай проблема жоқ.
Dialogue: 0,0:01:39.15,0:01:41.67,Default,,0,0,0,,Бұл шешілгенше сізге ұнайды деп үміттенемін.
Dialogue: 0,0:01:41.67,0:01:43.06,Default,,0,0,0,,Олай болса, бар күшіңді сал.
Dialogue: 0,0:01:43.06,0:01:44.71,Default,,0,0,0,,Сәлем, Акаши
Dialogue: 0,0:01:44.71,0:01:48.87,Default,,0,0,0,,Әйтеуір, Акаши бірдеңе істегенше ойыннан ләззат аламын.
Dialogue: 0,0:01:48.87,0:01:50.72,Default,,0,0,0,,Көңілді сияқты
Dialogue: 0,0:01:54.07,0:01:55.36,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:55.90,0:01:57.68,Default,,0,0,0,,Офуняға қауіп төніп тұр
Dialogue: 0,0:01:57.68,0:01:58.85,Default,,0,0,0,,Маған көмек керек
Dialogue: 0,0:01:58.85,0:02:01.73,Default,,0,0,0,,Жүр, тоқта!
Dialogue: 0,0:02:01.95,0:02:04.25,Default,,0,0,0,,Сіз мені тыңдайсыз деп ойлаймын.
Dialogue: 0,0:02:04.25,0:02:04.94,Default,,0,0,0,,Кеттік
Dialogue: 0,0:02:19.18,0:02:20.87,Default,,0,0,0,,...
Dialogue: 0,0:02:22.33,0:02:25.43,Default,,0,0,0,,Барлау…Жылдамдық
Dialogue: 0,0:02:31.98,0:02:33.22,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:02:35.38,0:02:36.97,Default,,0,0,0,,Деңгейді көтеру
Dialogue: 0,0:02:38.12,0:02:39.47,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:02:40.21,0:02:42.87,Default,,0,0,0,,Не айтқың келеді, бала?
Dialogue: 0,0:02:43.20,0:02:46.04,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:02:46.04,0:02:47.72,Default,,0,0,0,,Лаффи-чан, мен түсіндім.
Dialogue: 0,0:02:47.72,0:02:49.36,Default,,0,0,0,,Себебі мен деңгейге көтерілдім
Dialogue: 0,0:02:50.46,0:02:53.78,Default,,0,0,0,,Сонымен қатар мен сенің жақын маңдағы ауылға келгеніңді қалаймын.
Dialogue: 0,0:02:54.14,0:02:55.88,Default,,0,0,0,,Лаффи керемет
Dialogue: 0,0:02:55.88,0:02:58.68,Default,,0,0,0,,Олай болса, мен сені ауылға апарайын.
Dialogue: 0,0:03:02.17,0:03:04.04,Default,,0,0,0,,Точааку Датте
Dialogue: 0,0:03:04.34,0:03:07.04,Default,,0,0,0,,Уау, үй портындағылардың бәрі де осында.
Dialogue: 0,0:03:07.42,0:03:10.55,Default,,0,0,0,,Менде қандай да бір оқиға болғалы тұрғандай сезім бар.
Dialogue: 0,0:03:12.08,0:03:15.93,Default,,0,0,0,,Қиындыққа тап болған адамдар бар, сондықтан оларды тыңдаңыз.
Dialogue: 0,0:03:16.42,0:03:19.24,Default,,0,0,0,,Қиындыққа тап болған адамдар кімдер?
Dialogue: 0,0:03:19.24,0:03:21.18,Default,,0,0,0,,Ититай
Dialogue: 0,0:03:21.91,0:03:23.59,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:03:23.59,0:03:25.01,Default,,0,0,0,,Ливерпуль мырза
Dialogue: 0,0:03:25.36,0:03:28.10,Default,,0,0,0,,Офняға көмектескеніңіз үшін рахмет.
Dialogue: 0,0:03:28.10,0:03:31.69,Default,,0,0,0,,Мүмкін қиындыққа тап болған адам Ливерпуль шығар.
Dialogue: 0,0:03:31.69,0:03:34.57,Default,,0,0,0,,Дұрыс, сіздің күш-қуатыңызды күтумен.
Dialogue: 0,0:03:34.96,0:03:37.12,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:03:37.12,0:03:39.24,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:03:39.24,0:03:40.59,Default,,0,0,0,,Рафи де
Dialogue: 0,0:03:40.83,0:03:43.33,Default,,0,0,0,,Сәлем, Ливерпуль мырза.
Dialogue: 0,0:03:41.02,0:03:43.99,Default,,0,0,0,,Әдеттегідей біз қашықтықты тез жауып жатырмыз.
Dialogue: 0,0:03:43.99,0:03:46.71,Default,,0,0,0,,Сонда мәселе неде?
Dialogue: 0,0:03:46.71,0:03:48.96,Default,,0,0,0,,Мен тым алыс кеткен сияқтымын.
Dialogue: 0,0:03:48.96,0:03:51.26,Default,,0,0,0,,Девоншир жын патшасы болды.
Dialogue: 0,0:03:51.26,0:03:52.76,Default,,0,0,0,,Девоншир мырза
Dialogue: 0,0:03:52.76,0:03:53.96,Default,,0,0,0,,Даркнесс?
Dialogue: 0,0:03:54.29,0:03:56.71,Default,,0,0,0,,Шаңға ұқсайтын көздер режимі ҚОСУЛЫ
Dialogue: 0,0:03:56.71,0:03:59.69,Default,,0,0,0,,Бетімді менсінбей, етегімнің ішін көрсетуімді өтіндіңіз.
Dialogue: 0,0:03:59.69,0:04:01.10,Default,,0,0,0,,Бұл соншалықты хентай.
Dialogue: 0,0:04:01.51,0:04:05.35,Default,,0,0,0,,Өтінемін, сіздің көмегіңізбен Девонширді есі дұрыс қалпына келтіріңіз.
Dialogue: 0,0:04:05.81,0:04:07.73,Default,,0,0,0,,Квест ақыры басталды.
Dialogue: 0,0:04:07.73,0:04:10.61,Default,,0,0,0,,Бұлай қимылдаудың қажеті жоқ.
Dialogue: 0,0:04:12.98,0:04:14.61,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, өйткені
Dialogue: 0,0:04:14.98,0:04:16.36,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:04:17.36,0:04:20.36,Default,,0,0,0,,Шытырман оқиғалы саяхат
Dialogue: 0,0:04:20.58,0:04:21.76,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:04:21.76,0:04:24.12,Default,,0,0,0,,Өйткені біз қандай құбыжықтар шығатынын білмейміз.
Dialogue: 0,0:04:24.12,0:04:25.24,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:04:25.24,0:04:26.09,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:04:26.09,0:04:27.37,Default,,0,0,0,,Бұл құбыжық
Dialogue: 0,0:04:27.57,0:04:29.07,Default,,0,0,0,,Сәлем Лаффи
Dialogue: 0,0:04:29.07,0:04:31.10,Default,,0,0,0,,Мұндай жерде ұйықтама
Dialogue: 0,0:04:31.10,0:04:34.69,Default,,0,0,0,,Оны абайлап алып жүр, Шпи
Dialogue: 0,0:04:34.69,0:04:36.63,Default,,0,0,0,,Мен ұйықтасам да өзімшілмін
Dialogue: 0,0:04:36.63,0:04:38.07,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:04:38.07,0:04:40.42,Default,,0,0,0,,Бұл сирек кездесетін зат.
Dialogue: 0,0:04:40.68,0:04:42.21,Default,,0,0,0,,Керемет көрінеді
Dialogue: 0,0:04:42.21,0:04:44.89,Default,,0,0,0,,Эй, біреу маған көмектесші
Dialogue: 0,0:04:48.03,0:04:49.27,Default,,0,0,0,,Мен оны көремін
Dialogue: 0,0:04:49.27,0:04:51.43,Default,,0,0,0,,Біз де жеттік
Dialogue: 0,0:04:51.43,0:04:53.63,Default,,0,0,0,,Девоншир мырзаны есін жиғызыңыз.
Dialogue: 0,0:04:53.63,0:04:56.06,Default,,0,0,0,,Осы әлемге тыныштық орнатайық
Dialogue: 0,0:04:56.06,0:04:57.23,Default,,0,0,0,,Девоншир мырза
Dialogue: 0,0:04:57.53,0:04:59.02,Default,,0,0,0,,Өздеріңізге оралыңыз.
Dialogue: 0,0:04:59.02,0:05:00.38,Default,,0,0,0,,«Ливерпуль» аздап істеп жатыр...
Dialogue: 0,0:05:00.38,0:05:01.28,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:05:01.90,0:05:03.71,Default,,0,0,0,,Demon Lord режимі ҚОСУЛЫ
Dialogue: 0,0:05:05.58,0:05:08.16,Default,,0,0,0,,Ливерпуль мырза не істеді?
Dialogue: 0,0:05:08.50,0:05:10.51,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:10.78,0:05:15.17,Default,,0,0,0,,Мен... сақтықпен сақтаған пончикті өзім жедім.
Dialogue: 0,0:05:15.77,0:05:17.52,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:05:17.52,0:05:20.17,Default,,0,0,0,,Бұл аз болуы мүмкін.
Dialogue: 0,0:05:20.17,0:05:23.18,Default,,0,0,0,,Оны маған командир сатып алды.
Dialogue: 0,0:05:24.49,0:05:27.74,Default,,0,0,0,,Ендеше мына дүниені құрт
Dialogue: 0,0:05:27.74,0:05:30.18,Default,,0,0,0,,Мен қайтадан пончик аламын
Dialogue: 0,0:05:30.53,0:05:31.97,Default,,0,0,0,,Бәріміз кеттік
Dialogue: 0,0:05:31.97,0:05:33.06,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:31.97,0:05:33.06,Default,,0,0,0,,Иә
Dialogue: 0,0:05:35.70,0:05:37.61,Default,,0,0,0,,Ал, мені күте тұрыңыз.
Dialogue: 0,0:05:37.61,0:05:38.78,Default,,0,0,0,,Акаши?
Dialogue: 0,0:05:38.78,0:05:42.07,Default,,0,0,0,,Жүйе мәселесі шешілді, сондықтан мен қазір үйге бара аламын.
Dialogue: 0,0:05:42.07,0:05:43.61,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:05:43.61,0:05:45.95,Default,,0,0,0,,Күте тұрыңыз, мен сізді бірден жеңемін.
Dialogue: 0,0:05:45.95,0:05:48.33,Default,,0,0,0,,Ня Үйге барғың келмей ме?
Dialogue: 0,0:05:48.33,0:05:51.61,Default,,0,0,0,,Енді осы жын иесін тоқтата аламыз ба?
Dialogue: 0,0:05:53.42,0:05:55.59,Default,,0,0,0,,Ikkee
Dialogue: 0,0:06:00.03,0:06:03.84,Default,,0,0,0,,Мен мұндай шабуыл режимі туралы естіген жоқпын.
Dialogue: 0,0:06:06.97,0:06:08.35,Default,,0,0,0,,Бітті.
Dialogue: 0,0:06:08.71,0:06:10.69,Default,,0,0,0,,Әсерлі аяқталу
Dialogue: 0,0:06:10.69,0:06:12.35,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:06:12.35,0:06:13.35,Default,,0,0,0,,Жаман болса да...
Dialogue: 0,0:06:13.35,0:06:15.69,Default,,0,0,0,,Бұл эмоцияға батып кететін уақыт емес.
Dialogue: 0,0:06:15.69,0:06:19.10,Default,,0,0,0,,Қайтадан қиындықтың қашан болатынын білмейсіз...
Dialogue: 0,0:06:19.10,0:06:20.36,Default,,0,0,0,,Себебі мен түсінемін
Dialogue: 0,0:06:23.32,0:06:24.86,Default,,0,0,0,,Ау, ау, ау…
Dialogue: 0,0:06:25.11,0:06:26.76,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:06:26.76,0:06:29.44,Default,,0,0,0,,Ойын енді анық.
Dialogue: 0,0:06:29.44,0:06:31.12,Default,,0,0,0,,Клирингпен құттықтаймыз
Dialogue: 0,0:06:31.46,0:06:34.51,Default,,0,0,0,,Мен әркімнің қолынан келетініне әрқашан сенетінмін.
Dialogue: 0,0:06:34.51,0:06:36.88,Default,,0,0,0,,Акаши
Dialogue: 0,0:06:37.63,0:06:39.92,Default,,0,0,0,,Бейқам болмаңыз
Dialogue: 0,0:06:40.52,0:06:43.69,Default,,0,0,0,,Егер ұстап алсаңыз, ұстап көріңіз.
Dialogue: 0,0:06:41.16,0:06:45.64,Default,,0,0,0,,Әр күн әдеттегідей, бірақ бәріміз бірге көңіл көтереміз.
Dialogue: 0,0:06:45.90,0:06:48.37,Default,,0,0,0,,Найза Сіз де көмектесе аласыз
Dialogue: 0,0:06:49.24,0:06:50.39,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:50.92,0:06:54.57,Default,,0,0,0,,Найза, мен бар күшімді саламын.
Dialogue: 0,0:07:02.36,0:07:10.66,Default,,0,0,0,,Бұл субтитрді Мэн Чая жазған және коммерциялық алмасу мақсаттарына арналған.
Dialogue: 0,0:07:02.36,0:07:10.66,Default,,0,0,0,,...
Dialogue: 0,0:07:02.36,0:07:10.66,Default,,0,0,0,,Бұл субтитрді Мо Чая жазған. Жабдықтаушы алмасу сынағы және мониторингі арқылы шығарылған. Коммерциялық мақсатта пайдаланылады Аударма: Шамисен Постер: Оджи әзірлеу: MIR WebRip: LoliHouse
