Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:04.98,Default,,0,0,0,,Бұл субтитрді Мэн Чая жазған және коммерциялық алмасу мақсаттарына арналған.
Dialogue: 0,0:00:00.00,0:00:04.98,Default,,0,0,0,,...
Dialogue: 0,0:00:00.00,0:00:04.98,Default,,0,0,0,,Бұл субтитрді Мо Чая жазған. Жеткізушінің алмасу сынағы және мониторингі шығарған. Коммерциялық мақсатта пайдаланылады Аударма: Шамисен Постер: Оджи әзірлеу: MIR WebRip: LoliHouse
Dialogue: 0,0:00:05.07,0:00:09.74,Default,,0,0,0,,3-том Бұл ересектер әлемі...
Dialogue: 0,0:00:00.81,0:00:04.48,Default,,0,0,0,,Азур-Лейн
Dialogue: 0,0:00:07.95,0:00:09.74,Default,,0,0,0,,Ақыры келді
Dialogue: 0,0:00:09.74,0:00:11.99,Default,,0,0,0,,Осынша уақыт өтті
Dialogue: 0,0:00:12.26,0:00:13.87,Default,,0,0,0,,Мен бұл туралы тіпті армандадым.
Dialogue: 0,0:00:14.20,0:00:16.12,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:16.72,0:00:19.50,Default,,0,0,0,,Жаңа мысық кафесі
Dialogue: 0,0:00:19.74,0:00:22.49,Default,,0,0,0,,Мен бұл күнді асыға күттім.
Dialogue: 0,0:00:22.49,0:00:24.50,Default,,0,0,0,,Иә, иә, дұрыс.
Dialogue: 0,0:00:24.72,0:00:27.10,Default,,0,0,0,,Мен шаршадым, ұйықтайын деп жатырмын
Dialogue: 0,0:00:27.10,0:00:29.63,Default,,0,0,0,,Сен енді онша көп жүрмейсің, солай ма?
Dialogue: 0,0:00:30.52,0:00:32.21,Default,,0,0,0,,Мен ақыры жеттім.
Dialogue: 0,0:00:32.21,0:00:34.39,Default,,0,0,0,,Бізбен бірге келгендеріңізге рахмет.
Dialogue: 0,0:00:34.39,0:00:35.70,Default,,0,0,0,,Алжир мырза
Dialogue: 0,0:00:36.13,0:00:40.14,Default,,0,0,0,,Қош келдіңіз. Мен сіздің өтінішіңізді жоққа шығара алмаймын.
Dialogue: 0,0:00:40.54,0:00:43.02,Default,,0,0,0,,Сіз мұндай дүкенге жиі келесіз бе?
Dialogue: 0,0:00:43.45,0:00:45.70,Default,,0,0,0,,Менің хоббиім - мысық кафелеріне бару.
Dialogue: 0,0:00:47.06,0:00:49.31,Default,,0,0,0,,Раффи Мен жақында қосылғым келеді.
Dialogue: 0,0:00:49.31,0:00:50.53,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:00:51.09,0:00:52.28,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:00:52.65,0:00:54.62,Default,,0,0,0,,Менің артымнан ерме
Dialogue: 0,0:00:54.62,0:00:55.99,Default,,0,0,0,,Иә
Dialogue: 0,0:00:55.99,0:00:58.29,Default,,0,0,0,,Балабақша тәрбиешісі
Dialogue: 0,0:01:02.54,0:01:05.10,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:01:05.97,0:01:07.97,Default,,0,0,0,,Оффя көп
Dialogue: 0,0:01:07.97,0:01:11.43,Default,,0,0,0,,Ойыншықтар мен тамақ, бәрінің болуы ғажап.
Dialogue: 0,0:01:16.56,0:01:18.80,Default,,0,0,0,,Қол тигізуге болады
Dialogue: 0,0:01:18.80,0:01:22.44,Default,,0,0,0,,Балаңызды тамақтанып жатқанда ұстамаңыз, еркелеткенде жұмсақ болыңыз.
Dialogue: 0,0:01:22.44,0:01:23.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:23.87,0:01:25.65,Default,,0,0,0,,Алжир мырза күткендей
Dialogue: 0,0:01:26.19,0:01:29.53,Default,,0,0,0,,Енді маған көп еркелетіңіз.
Dialogue: 0,0:01:29.53,0:01:31.70,Default,,0,0,0,,Қараңыз, жарайды.
Dialogue: 0,0:01:31.91,0:01:34.01,Default,,0,0,0,,Мен сені қатты жақсы көремін
Dialogue: 0,0:01:34.01,0:01:36.70,Default,,0,0,0,,Мен Офф-няға жындымын.
Dialogue: 0,0:01:36.70,0:01:40.09,Default,,0,0,0,,Мен барлық сүйкімді қыздарға ризамын...
Dialogue: 0,0:01:40.09,0:01:41.08,Default,,0,0,0,,О.
Dialogue: 0,0:01:41.32,0:01:43.61,Default,,0,0,0,,Мұнда да сүйкімді қыз бар
Dialogue: 0,0:01:44.08,0:01:45.73,Default,,0,0,0,,Мұнда да
Dialogue: 0,0:01:46.21,0:01:50.83,Default,,0,0,0,,Жарайды, жарайды, жарайды, жарайды, жарайды...
Dialogue: 0,0:01:46.36,0:01:50.00,Default,,0,0,0,,Мен бейтаныс емеспін.
Dialogue: 0,0:01:50.83,0:01:53.59,Default,,0,0,0,,Сүйкімді болса, бәрі жақсы деп ойлаймын.
Dialogue: 0,0:01:55.58,0:01:57.60,Default,,0,0,0,,А... Алжир мырза?
Dialogue: 0,0:02:04.34,0:02:06.77,Default,,0,0,0,,Бұл бақытты сәт болды.
Dialogue: 0,0:02:06.77,0:02:09.36,Default,,0,0,0,,Көңілді болды, Аянами-чан.
Dialogue: 0,0:02:09.36,0:02:10.99,Default,,0,0,0,,Бұл үлпілдек болды
Dialogue: 0,0:02:10.99,0:02:14.49,Default,,0,0,0,,Соңында Лаффи есеңгіреп қалды.
Dialogue: 0,0:02:14.87,0:02:17.62,Default,,0,0,0,,Бұдан кейін Алжир мырза не істейді?
Dialogue: 0,0:02:17.79,0:02:21.62,Default,,0,0,0,,Кешке мен Дункерк пен Фошпен барға барамын.
Dialogue: 0,0:02:21.97,0:02:24.19,Default,,0,0,0,,Бұл сөзсіз стильді орын.
Dialogue: 0,0:02:24.19,0:02:25.38,Default,,0,0,0,,Жолақ…
Dialogue: 0,0:02:30.46,0:02:34.35,Default,,0,0,0,,Айристен келген Мастер қызыл шарабы...
Dialogue: 0,0:02:34.35,0:02:38.10,Default,,0,0,0,,Иә, қос графинде.
Dialogue: 0,0:02:40.22,0:02:44.48,Default,,0,0,0,,Менің ойымша, Лаффи де барғысы келмейді.
Dialogue: 0,0:02:44.67,0:02:48.23,Default,,0,0,0,,Мен мұндай жерде ешқашан болған емеспін, сондықтан оны асыға күтемін.
Dialogue: 0,0:02:49.36,0:02:51.08,Default,,0,0,0,,(Нисимура) Цубасаның кеудесі өте үлкен, сондықтан ол жүгіргенде әр жаққа секіріп тұрады.
Dialogue: 0,0:02:51.08,0:02:54.84,Default,,0,0,0,,Бірақ енді ересектер уақыты.
Dialogue: 0,0:02:55.11,0:02:58.95,Default,,0,0,0,,Мен...Мен де осылай тағы біраз жасаймын...
Dialogue: 0,0:02:58.95,0:03:01.12,Default,,0,0,0,,Мен бұл мәселеде емес деп ойлаймын.
Dialogue: 0,0:03:01.61,0:03:03.24,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:03:04.17,0:03:08.01,Default,,0,0,0,,Мен одан да жетілген атмосфера болғанын қалаймын.
Dialogue: 0,0:03:08.01,0:03:10.53,Default,,0,0,0,,Zara Сіз бұл туралы көп білетін сияқтысыз.
Dialogue: 0,0:03:11.32,0:03:12.76,Default,,0,0,0,,үшінна Ciao
Dialogue: 0,0:03:12.76,0:03:15.65,Default,,0,0,0,,Сырттан сендердің жүздеріңді көремін.
Dialogue: 0,0:03:15.65,0:03:17.26,Default,,0,0,0,,Зара-сан Паула-сан
Dialogue: 0,0:03:18.88,0:03:20.83,Default,,0,0,0,,Раффи Бұл сәл жақсы.
Dialogue: 0,0:03:21.87,0:03:26.43,Default,,0,0,0,,Мен біраз уақыт ойланып қалдым, бірақ киім өлшемі дұрыс емес шығар.
Dialogue: 0,0:03:26.43,0:03:28.90,Default,,0,0,0,,Енді мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:03:29.08,0:03:31.13,Default,,0,0,0,,Бұл ысырап болар еді.
Dialogue: 0,0:03:31.62,0:03:32.65,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:33.09,0:03:36.27,Default,,0,0,0,,Киіміңді әдемі етіп көрсетейін бе?
Dialogue: 0,0:03:36.27,0:03:37.78,Default,,0,0,0,,Иә, жақсы ма?
Dialogue: 0,0:03:38.18,0:03:41.23,Default,,0,0,0,,Уайымдама, менің киім талғамым кең.
Dialogue: 0,0:03:41.23,0:03:43.31,Default,,0,0,0,,Өте сүйкімділері де бар.
Dialogue: 0,0:03:43.31,0:03:45.41,Default,,0,0,0,,Сен оны неге алып жүрсің?
Dialogue: 0,0:03:45.41,0:03:49.53,Default,,0,0,0,,Менің естуімше, бәрі ересек болғысы келеді.
Dialogue: 0,0:03:49.53,0:03:50.42,Default,,0,0,0,,Иә
Dialogue: 0,0:03:49.53,0:03:50.42,Default,,0,0,0,,Иә
Dialogue: 0,0:03:52.17,0:03:53.92,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:04:00.87,0:04:04.18,Default,,0,0,0,,Ересек болғың келсе, сәнден баста.
Dialogue: 0,0:04:04.96,0:04:06.93,Default,,0,0,0,,Керемет дүкен
Dialogue: 0,0:04:07.16,0:04:09.49,Default,,0,0,0,,Бұны қалай киесің?
Dialogue: 0,0:04:09.49,0:04:12.32,Default,,0,0,0,,Жарайды, қалауыңызша киіп көріңіз.
Dialogue: 0,0:04:12.68,0:04:14.10,Default,,0,0,0,,Жоқ, бірақ Йор-чан менің байқамай тұрғанымда үйленіп кеткеніне сенбеймін.
Dialogue: 0,0:04:14.10,0:04:15.19,Default,,0,0,0,,Сәлем, Лаффи-чан
Dialogue: 0,0:04:16.49,0:04:18.56,Default,,0,0,0,,Рұқсатсыз ашпаңыз
Dialogue: 0,0:04:21.02,0:04:24.04,Default,,0,0,0,,Менің ойымша, бұл сәл қарапайым болды.
Dialogue: 0,0:04:24.04,0:04:25.83,Default,,0,0,0,,Бұл көптеген жағынан таң қалдырады.
Dialogue: 0,0:04:26.06,0:04:29.21,Default,,0,0,0,,Енді олай киініп шығуға болмайды.
Dialogue: 0,0:04:29.58,0:04:30.80,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:04:30.80,0:04:33.18,Default,,0,0,0,,Командир де қуанбайды деп ойлаймын.
Dialogue: 0,0:04:33.18,0:04:34.59,Default,,0,0,0,,Ересек адамға ұқсайды
Dialogue: 0,0:04:34.97,0:04:38.34,Default,,0,0,0,,Зарадан күткендей, менің көзім соған ауды.
Dialogue: 0,0:04:38.76,0:04:39.72,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:41.23,0:04:44.60,Default,,0,0,0,,Өлшемі дұрыс па, соны өлшеймін.
Dialogue: 0,0:04:44.60,0:04:47.85,Default,,0,0,0,,КАН-СЕНнің денесі енді өзгермейді, солай ма?
Dialogue: 0,0:04:48.16,0:04:50.49,Default,,0,0,0,,Жарайды, мен саған қол тигізгім келді.
Dialogue: 0,0:04:48.60,0:04:50.49,Default,,0,0,0,,Командирге еліктеу
Dialogue: 0,0:04:50.49,0:04:54.30,Default,,0,0,0,,Қараңдаршы, сен барға киім таңдап жатырсың, ендеше бастайық.
Dialogue: 0,0:04:56.42,0:04:59.34,Default,,0,0,0,,Сіз қалай ойлайсыз? Сізге жарасады ма?
Dialogue: 0,0:04:59.34,0:05:02.45,Default,,0,0,0,,Бұл жақсы емес. Бұл ханшайым сияқты.
Dialogue: 0,0:05:03.38,0:05:07.02,Default,,0,0,0,,Бұл көйлек мен ойлағаннан да оңайырақ.
Dialogue: 0,0:05:07.02,0:05:09.15,Default,,0,0,0,,Иә, сен ересек адам сияқтысың.
Dialogue: 0,0:05:09.15,0:05:10.83,Default,,0,0,0,,Сіз әдеттегіден де тартымдысыз.
Dialogue: 0,0:05:11.85,0:05:15.27,Default,,0,0,0,,Арқам қышиды, тыныштала алмаймын.
Dialogue: 0,0:05:15.27,0:05:18.13,Default,,0,0,0,,О, бұл қандай сүйкімді?
Dialogue: 0,0:05:19.15,0:05:20.99,Default,,0,0,0,,Мм...күте тұрыңыз...
Dialogue: 0,0:05:20.99,0:05:23.56,Default,,0,0,0,,Бұл көп әсер ету.
Dialogue: 0,0:05:23.56,0:05:26.64,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл қалыпты жағдай.
Dialogue: 0,0:05:26.89,0:05:29.24,Default,,0,0,0,,Иә, иә, олардың бәрі жақсы.
Dialogue: 0,0:05:29.24,0:05:31.02,Default,,0,0,0,,Бірақ егер мүмкін болса...
Dialogue: 0,0:05:31.02,0:05:33.90,Default,,0,0,0,,Иә, мен басқаларын сынап көруім керек.
Dialogue: 0,0:05:34.56,0:05:36.18,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:05:36.18,0:05:38.90,Default,,0,0,0,,Эй... сәл сүйкімді емес пе?
Dialogue: 0,0:05:39.77,0:05:41.73,Default,,0,0,0,,Сәнді болу жақсы
Dialogue: 0,0:05:41.73,0:05:44.16,Default,,0,0,0,,Аянами тұтынушыларға қызмет көрсетеді.
Dialogue: 0,0:05:44.56,0:05:46.60,Default,,0,0,0,,Үлпілдек және жағымды сезім
Dialogue: 0,0:05:46.60,0:05:47.91,Default,,0,0,0,,Бірақ олар пижамалар.
Dialogue: 0,0:05:48.56,0:05:49.62,Default,,0,0,0,,Бұл сізге сәйкес келеді.
Dialogue: 0,0:05:49.62,0:05:52.16,Default,,0,0,0,,Барға бару үшін киінбеген.
Dialogue: 0,0:05:53.09,0:05:55.17,Default,,0,0,0,,Олай болса, мұндай нәрсе туралы не айтуға болады?
Dialogue: 0,0:05:56.25,0:05:58.05,Default,,0,0,0,,Бұл жақсы нәрсе емес пе?
Dialogue: 0,0:05:58.35,0:06:01.05,Default,,0,0,0,,Сонда ол былай болар еді
Dialogue: 0,0:06:03.48,0:06:06.55,Default,,0,0,0,,Жұмыс біткеннен кейін маған қоңырау шалыңыз, Татымды...
Dialogue: 0,0:06:10.98,0:06:13.23,Default,,0,0,0,,Бұл ересек адамға ұқсайды ма?
Dialogue: 0,0:06:13.23,0:06:14.81,Default,,0,0,0,,Иә, өте
Dialogue: 0,0:06:16.15,0:06:18.96,Default,,0,0,0,,Қарашы, Лаффи, сен әдемісің.
Dialogue: 0,0:06:19.54,0:06:21.69,Default,,0,0,0,,Мен өзім емес сияқтымын
Dialogue: 0,0:06:21.69,0:06:24.07,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:06:24.07,0:06:26.20,Default,,0,0,0,,Бұл көйлек тамаша болар еді.
Dialogue: 0,0:06:26.53,0:06:28.61,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:06:28.61,0:06:31.34,Default,,0,0,0,,Қазірден бастап үлкендерге кезек келді.
Dialogue: 0,0:06:37.09,0:06:38.15,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:39.01,0:06:41.66,Default,,0,0,0,,Бұл үлкендер әлемі...
Dialogue: 0,0:06:44.78,0:06:47.82,Default,,0,0,0,,Бұл жер де нағыз жұмақ.
Dialogue: 0,0:06:48.84,0:06:50.71,Default,,0,0,0,,Жолақ – жолақ...
Dialogue: 0,0:06:50.71,0:06:52.00,Default,,0,0,0,,Off-nyabar… Бұл
Dialogue: 0,0:06:52.00,0:06:53.63,Default,,0,0,0,,болды
Dialogue: 0,0:06:55.13,0:07:01.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
