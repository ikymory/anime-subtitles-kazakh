Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.21,0:00:06.38,Default,,0,0,0,,Туылғаннан кейін көп ұзамай ата-анасынан айырылды
Dialogue: 0,0:00:06.46,0:00:08.17,Default,,0,0,0,,Өрт шыққан сияқты.
Dialogue: 0,0:00:09.75,0:00:12.88,Default,,0,0,0,,Туыстарының жанынан өту
Dialogue: 0,0:00:14.22,0:00:18.18,Default,,0,0,0,,Қонақүйде қызметші болып күн көретінмін.
Dialogue: 0,0:00:19.35,0:00:20.97,Default,,0,0,0,,Жалғыз ләззат
Dialogue: 0,0:00:21.06,0:00:23.89,Default,,0,0,0,,Тауарды тұтынушыларға жеткізу кезінде
Dialogue: 0,0:00:23.98,0:00:26.06,Default,,0,0,0,,Қайықпен өзеннен төмен түсу
Dialogue: 0,0:00:27.52,0:00:29.98,Default,,0,0,0,,Мен әрқашан жалғыз болдым
Dialogue: 0,0:00:30.86,0:00:34.53,Default,,0,0,0,,Мен сол күні Йотаромен кездескенше...
Dialogue: 0,0:00:35.61,0:00:40.95,Default,,0,0,0,,♪～
Dialogue: 0,0:01:58.86,0:02:03.87,Default,,0,0,0,,～♪
Dialogue: 0,0:02:05.58,0:02:11.92,Default,,0,0,0,,(Нагидің қайғылы дауысы)
Dialogue: 0,0:02:13.09,0:02:14.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:14.50,0:02:20.39,Default,,0,0,0,,(Нагидің мазасыз дауысы)
Dialogue: 0,0:02:20.47,0:02:24.10,Default,,0,0,0,,Жағдай тынышталғаннан кейін, жақын арада келесі толқын келеді.
Dialogue: 0,0:02:24.18,0:02:27.35,Default,,0,0,0,,Жарайды, Наги-сан, терең дем ал.
Dialogue: 0,0:02:27.43,0:02:28.35,Default,,0,0,0,,Құсу
Dialogue: 0,0:02:28.43,0:02:30.19,Default,,0,0,0,,Басы шықса жеңіл болады.
Dialogue: 0,0:02:30.27,0:02:31.35,Default,,0,0,0,,Жай демалыңыз
Dialogue: 0,0:02:31.44,0:02:34.19,Default,,0,0,0,,Сәбилер табиғи жолмен шыққысы келеді.
Dialogue: 0,0:02:34.27,0:02:36.28,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:36.36,0:02:38.95,Default,,0,0,0,,Босану ваннасы салқындап барады.
Dialogue: 0,0:02:39.03,0:02:41.49,Default,,0,0,0,,Нәресте шошып кетті. Біраз ыстық су қосыңыз.
Dialogue: 0,0:02:41.99,0:02:43.37,Default,,0,0,0,,Иә
Dialogue: 0,0:02:44.74,0:02:48.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:48.20,0:02:50.50,Default,,0,0,0,,Иә, бұл баяу.
Dialogue: 0,0:02:50.58,0:02:55.50,Default,,0,0,0,,Ууууууууууууууу...
Dialogue: 0,0:02:56.59,0:02:57.96,Default,,0,0,0,,Бұл дүниеде еш жерде жоқ
Dialogue: 0,0:02:59.59,0:03:01.47,Default,,0,0,0,,Қандық туыс болған жоқ.
Dialogue: 0,0:03:06.26,0:03:08.35,Default,,0,0,0,,Бұл қуыршақ сияқты.
Dialogue: 0,0:03:08.43,0:03:10.60,Default,,0,0,0,,Аздап ашуланса ше?
Dialogue: 0,0:03:10.69,0:03:12.73,Default,,0,0,0,,Қорқынышты қоқыс
Dialogue: 0,0:03:12.81,0:03:14.06,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:03:17.57,0:03:19.07,Default,,0,0,0,,Гарандо
Dialogue: 0,0:03:20.19,0:03:21.32,Default,,0,0,0,,Бостық
Dialogue: 0,0:03:22.24,0:03:23.32,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:24.24,0:03:27.29,Default,,0,0,0,,Өткенде немесе болашақта ештеңе жоқ
Dialogue: 0,0:03:28.08,0:03:30.79,Default,,0,0,0,,Оны қалама, қарсылық көрсетпе
Dialogue: 0,0:03:31.62,0:03:34.29,Default,,0,0,0,,Алып бара жатқанда тыныштықты сақтаңыз
Dialogue: 0,0:03:34.88,0:03:36.75,Default,,0,0,0,,Міне осылай өмір сүру керек
Dialogue: 0,0:03:37.55,0:03:38.80,Default,,0,0,0,,Маған...
Dialogue: 0,0:03:40.13,0:03:41.67,Default,,0,0,0,,Біз қайтадан кездестік.
Dialogue: 0,0:03:41.76,0:03:43.26,Default,,0,0,0,,Ах
Dialogue: 0,0:03:45.64,0:03:47.81,Default,,0,0,0,,Мен декейкомын.
Dialogue: 0,0:03:47.89,0:03:49.68,Default,,0,0,0,,Өзен Саған ұнады ма?
Dialogue: 0,0:03:49.77,0:03:50.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:50.93,0:03:52.94,Default,,0,0,0,,Жоқ, мен оны үнемі көремін.
Dialogue: 0,0:03:58.02,0:04:01.24,Default,,0,0,0,,Күтпеген даму күтіп тұрды
Dialogue: 0,0:04:04.91,0:04:06.45,Default,,0,0,0,,Ол қызметші қыз болды, солай ма?
Dialogue: 0,0:04:06.95,0:04:09.12,Default,,0,0,0,,Самурайға үйлену деген нені білдіреді?
Dialogue: 0,0:04:09.20,0:04:11.00,Default,,0,0,0,,Инкогнито
Dialogue: 0,0:04:12.08,0:04:13.62,Default,,0,0,0,,Бұл тұрарлық, солай емес пе?
Dialogue: 0,0:04:13.71,0:04:15.25,Default,,0,0,0,,Тынш! Мен оны естимін
Dialogue: 0,0:04:15.88,0:04:16.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:16.92,0:04:18.54,Default,,0,0,0,,Наги мырза, Наги мырза
Dialogue: 0,0:04:18.63,0:04:19.46,Default,,0,0,0,,Ах
Dialogue: 0,0:04:20.13,0:04:21.38,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:26.09,0:04:28.51,Default,,0,0,0,,Менің бойым жетпейді
Dialogue: 0,0:04:30.01,0:04:32.48,Default,,0,0,0,,Бірақ қайын енем осылай деді.
Dialogue: 0,0:04:33.27,0:04:37.48,Default,,0,0,0,,Иә, бұл дәмді. Мен Киото стиліндегі дәмді жақсы білемін.
Dialogue: 0,0:04:38.19,0:04:40.07,Default,,0,0,0,,Мен оны қонақүйде білдім.
Dialogue: 0,0:04:40.15,0:04:42.65,Default,,0,0,0,,Мен де шаруаның қызы болдым.
Dialogue: 0,0:04:42.74,0:04:43.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:43.65,0:04:45.15,Default,,0,0,0,,Оның үстіне екінші әйелім.
Dialogue: 0,0:04:45.24,0:04:46.11,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:04:46.20,0:04:48.03,Default,,0,0,0,,Иотаро да.
Dialogue: 0,0:04:48.12,0:04:50.87,Default,,0,0,0,,Баяғыда кеткен қайным...
Dialogue: 0,0:04:50.95,0:04:54.25,Default,,0,0,0,,Қандық қатынас мүлде жоқ.
Dialogue: 0,0:04:54.33,0:04:59.38,Default,,0,0,0,,Бірақ әйелі мен күйеуі, ене мен қызы
Dialogue: 0,0:04:59.46,0:05:01.05,Default,,0,0,0,,Ха...
Dialogue: 0,0:05:01.92,0:05:05.43,Default,,0,0,0,,Ең бастысы - үйіңізді қорғау
Dialogue: 0,0:05:06.43,0:05:11.10,Default,,0,0,0,,(Нагидің ауыр тыныс алуы)
Dialogue: 0,0:05:11.18,0:05:13.77,Default,,0,0,0,,Қайын ағаларының тілін алмаған.
Dialogue: 0,0:05:13.85,0:05:15.85,Default,,0,0,0,,Мен бұл үйге қайтып келдім...
Dialogue: 0,0:05:16.56,0:05:18.35,Default,,0,0,0,,Қаншама қан
Dialogue: 0,0:05:18.44,0:05:19.90,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:05:19.98,0:05:22.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:22.11,0:05:24.32,Default,,0,0,0,,Осы баланы дүниеге әкелу үшін бәрі
Dialogue: 0,0:05:25.07,0:05:27.11,Default,,0,0,0,,Иә, шықты.
Dialogue: 0,0:05:27.20,0:05:30.37,Default,,0,0,0,,Сәттілік Наги-сан, жақындап қалдың!
Dialogue: 0,0:05:30.45,0:05:32.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:33.70,0:05:39.38,Default,,0,0,0,,Туыстық байланыстар кейде қаннан да күшті болады.
Dialogue: 0,0:05:42.92,0:05:46.09,Default,,0,0,0,,Мен сені жалғаймын, Мен сені қалаймын
Dialogue: 0,0:05:46.17,0:05:49.14,Default,,0,0,0,,Артымда бірдеңе қалдырсам, бос болмас едім.
Dialogue: 0,0:05:50.26,0:05:51.64,Default,,0,0,0,,Мен оны қалдырамын!
Dialogue: 0,0:05:55.73,0:05:59.02,Default,,0,0,0,,Наги-сан, менің үйіме келші.
Dialogue: 0,0:06:02.11,0:06:04.53,Default,,0,0,0,,Тірі дәлел!
Dialogue: 0,0:06:04.61,0:06:09.53,Default,,0,0,0,,Ааааааааааааааааааааааа!
Dialogue: 0,0:06:09.61,0:06:10.78,Default,,0,0,0,,Бірақ қызық емес пе?
Dialogue: 0,0:06:14.37,0:06:17.54,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз. Бұл керемет, Наги-сан.
Dialogue: 0,0:06:17.62,0:06:20.17,Default,,0,0,0,,Иә! Мен дүниеге келдім
Dialogue: 0,0:06:20.25,0:06:21.83,Default,,0,0,0,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:06:22.63,0:06:24.13,Default,,0,0,0,,Жылау
Dialogue: 0,0:06:26.09,0:06:29.13,Default,,0,0,0,,-Ах... -Ах...
Dialogue: 0,0:06:29.22,0:06:31.64,Default,,0,0,0,,Тамағыңа бірдеңе тығылып қалды ма?
Dialogue: 0,0:06:31.72,0:06:33.64,Default,,0,0,0,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:06:33.72,0:06:35.60,Default,,0,0,0,,Маған қарызға бер!
Dialogue: 0,0:06:36.22,0:06:39.14,Default,,0,0,0,,Неліктен?Неліктен?
Dialogue: 0,0:06:39.23,0:06:40.98,Default,,0,0,0,,Бізге…
Dialogue: 0,0:06:46.44,0:06:47.90,Default,,0,0,0,,Бізге…
Dialogue: 0,0:06:50.86,0:06:52.12,Default,,0,0,0,,Жылау
Dialogue: 0,0:06:53.24,0:06:55.66,Default,,0,0,0,,Жыла!
Dialogue: 0,0:06:56.45,0:06:58.16,Default,,0,0,0,,зұлым қылмыстарды болдырмау үшін, бірақ —
Dialogue: 0,0:06:59.00,0:07:00.62,Default,,0,0,0,,Қосылыңыз!
Dialogue: 0,0:07:05.80,0:07:12.97,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:07:13.05,0:07:14.14,Default,,0,0,0,,Мен жыладым...
Dialogue: 0,0:07:14.22,0:07:17.18,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:07:17.27,0:07:19.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:22.85,0:07:24.69,Default,,0,0,0,,Менің қазынам
Dialogue: 0,0:07:25.73,0:07:27.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:27.28,0:07:31.61,Default,,0,0,0,,Жұмсақ Өте жылы
Dialogue: 0,0:07:32.74,0:07:34.70,Default,,0,0,0,,Йотаро-сан
Dialogue: 0,0:07:34.78,0:07:37.20,Default,,0,0,0,,Қайын ата Қайын ене...
Dialogue: 0,0:07:37.95,0:07:39.70,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:07:40.20,0:07:41.37,Default,,0,0,0,,Туған!
Dialogue: 0,0:07:41.46,0:07:42.71,Default,,0,0,0,,Туылды!
Dialogue: 0,0:07:45.29,0:07:48.21,Default,,0,0,0,,Жақсы, жақсы...
Dialogue: 0,0:07:51.55,0:07:55.60,Default,,0,0,0,,Наги жасады.
Dialogue: 0,0:08:03.81,0:08:09.23,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:08:15.82,0:08:18.66,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:18.74,0:08:20.83,Default,,0,0,0,,Сіз дүниеге келдіңіз бе? Бұл рас па?
Dialogue: 0,0:08:20.91,0:08:22.37,Default,,0,0,0,,Сіз ер адамсыз ба?Әйел бе?
Dialogue: 0,0:08:22.46,0:08:24.12,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:08:24.21,0:08:26.00,Default,,0,0,0,,Мен де сені ұстап алайын
Dialogue: 0,0:08:26.08,0:08:29.38,Default,,0,0,0,,Маған да көрсет. Маған да көрсет!
Dialogue: 0,0:08:29.46,0:08:32.38,Default,,0,0,0,,Хахахаха ау менің
Dialogue: 0,0:08:32.47,0:08:34.76,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:08:34.84,0:08:38.60,Default,,0,0,0,,Хи хи хи сондай сүйкімді
Dialogue: 0,0:08:40.85,0:08:44.85,Default,,0,0,0,,Ой, енді ойлап қарасам, сен ше? Сіз әлі оралмадыңыз ба?
Dialogue: 0,0:08:44.94,0:08:46.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:46.94,0:08:51.36,Default,,0,0,0,,Наги-сан бақытты болуы керек. тойлайық.
Dialogue: 0,0:08:54.49,0:08:55.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:58.62,0:08:59.87,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:09:02.45,0:09:04.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:18.68,0:09:22.14,Default,,0,0,0,,Көрдім, бұл азапты аяқталды.
Dialogue: 0,0:09:22.85,0:09:25.14,Default,,0,0,0,,Болған оқиғаға қатысты ештеңе істей алмайсыз.
Dialogue: 0,0:09:25.94,0:09:27.65,Default,,0,0,0,,Дана
Dialogue: 0,0:09:27.73,0:09:32.40,Default,,0,0,0,,Мен біреуді шынымен құтқара алсам деп ойлаймын...
Dialogue: 0,0:09:34.11,0:09:36.90,Default,,0,0,0,,Тек шын жүректен қиналғандар
Dialogue: 0,0:09:40.03,0:09:42.74,Default,,0,0,0,,Тек жүрегі жаралылар
Dialogue: 0,0:09:50.50,0:09:54.92,Default,,0,0,0,,Содан бері бір күн өтті, мен мәңгілікке жылауымды тоқтата алмаймын.
Dialogue: 0,0:09:55.88,0:09:57.88,Default,,0,0,0,,Дәрігер де солай деді.
Dialogue: 0,0:09:58.80,0:10:01.43,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмадым.
Dialogue: 0,0:10:04.52,0:10:08.23,Default,,0,0,0,,Қалай болғанда да, мен сізді жігерлендіруім керек.
Dialogue: 0,0:10:08.31,0:10:09.94,Default,,0,0,0,,Ах Сакура-сан
Dialogue: 0,0:10:10.48,0:10:11.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:11.40,0:10:13.44,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:13.52,0:10:16.28,Default,,0,0,0,,Бүгін тағы да қылышқа қарайсың ба?
Dialogue: 0,0:10:16.36,0:10:18.28,Default,,0,0,0,,Таңертеңнен ерен еңбектеріңізге рахмет!
Dialogue: 0,0:10:18.36,0:10:19.91,Default,,0,0,0,,О?
Dialogue: 0,0:10:19.99,0:10:23.20,Default,,0,0,0,,О, Сакура, сен дұрыс жерге келдің.
Dialogue: 0,0:10:23.28,0:10:24.62,Default,,0,0,0,,Хиджиката-сан
Dialogue: 0,0:10:25.79,0:10:28.87,Default,,0,0,0,,Мен сәл қисық қылышты түзетпек болғанымда, мен соқтым.
Dialogue: 0,0:10:28.96,0:10:30.29,Default,,0,0,0,,Инахоға қараңыз.
Dialogue: 0,0:10:30.37,0:10:34.38,Default,,0,0,0,,Гах! Мен мұны қалай істей аламын!?
Dialogue: 0,0:10:34.46,0:10:35.96,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:10:36.63,0:10:38.92,Default,,0,0,0,,! Менің қарыным ашты!
Dialogue: 0,0:10:39.01,0:10:42.26,Default,,0,0,0,,Таңғы ас ішетін уақыт. Мен саған көмектесемін.
Dialogue: 0,0:10:43.30,0:10:46.77,Default,,0,0,0,,Қызық, сіз бұған қалай қарайсыз?
Dialogue: 0,0:10:46.85,0:10:49.23,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:10:49.31,0:10:52.23,Default,,0,0,0,,Сіз күткендей, кеше көп сөйлеген жоқсыз.
Dialogue: 0,0:10:52.31,0:10:55.90,Default,,0,0,0,,Мен бала болғандықтан тез ауыса аламын деп ойлаймын.
Dialogue: 0,0:10:55.98,0:10:58.74,Default,,0,0,0,,Оны қорыта білгендіктен бе?
Dialogue: 0,0:10:58.82,0:11:02.24,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:11:02.32,0:11:05.49,Default,,0,0,0,,Кетіңіз! Мен өтіп кетемін!
Dialogue: 0,0:11:06.54,0:11:11.12,Default,,0,0,0,,Қаншалықты үлкен жұмыс жасасаңыз да, бәрі өзгерген жоқ.
Dialogue: 0,0:11:11.96,0:11:14.25,Default,,0,0,0,,Ешкім бұрынғы қалпында қалмайды.
Dialogue: 0,0:11:14.34,0:11:16.13,Default,,0,0,0,,және Тодо мырза
Dialogue: 0,0:11:16.59,0:11:17.42,Default,,0,0,0,,Тапсырма
Dialogue: 0,0:11:17.51,0:11:20.42,Default,,0,0,0,,- (Тодо) Гат - (Нагакура) Татами төсенішінің шетіне баспаңыз
Dialogue: 0,0:11:20.51,0:11:23.93,Default,,0,0,0,,Мм, мм, бұл кім болды?
Dialogue: 0,0:11:24.01,0:11:27.43,Default,,0,0,0,,Бұл Шинпачи. Шинпачи есінен танып қалды.
Dialogue: 0,0:11:27.52,0:11:31.14,Default,,0,0,0,,Самурай ретінде бәрін дұрыс орындау керек.
Dialogue: 0,0:11:31.23,0:11:33.94,Default,,0,0,0,,А, сақалыңды қырдың.
Dialogue: 0,0:11:34.02,0:11:37.82,Default,,0,0,0,,Өзіңізге өтірік айтпаңыз. Самурай - самурай.
Dialogue: 0,0:11:37.90,0:11:39.28,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:11:39.36,0:11:41.20,Default,,0,0,0,,Ажыратқыш әсерлі.
Dialogue: 0,0:11:41.28,0:11:43.28,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:11:43.36,0:11:46.28,Default,,0,0,0,,Бұл жолы менде жағымсыз дәм бар.
Dialogue: 0,0:11:46.37,0:11:48.87,Default,,0,0,0,,Жанашырлық танытпаңыз! Оны ауыстырыңыз!
Dialogue: 0,0:11:48.95,0:11:50.50,Default,,0,0,0,,Өз үлгіңізді орындаңыз
Dialogue: 0,0:11:50.58,0:11:52.21,Default,,0,0,0,,Еденді сүрту аяқталды!
Dialogue: 0,0:11:52.29,0:11:54.71,Default,,0,0,0,,А, мен де көкөністерді жууым керек.
Dialogue: 0,0:11:54.79,0:11:57.46,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:11:57.55,0:11:59.17,Default,,0,0,0,,Ах ха ха!
Dialogue: 0,0:11:59.26,0:12:03.47,Default,,0,0,0,,Серизава-сенсей күткендей, ол жау генералын жеңіп, жеңе алды.
Dialogue: 0,0:12:03.55,0:12:05.47,Default,,0,0,0,,Иә! әлемге әйгілі тұлға
Dialogue: 0,0:12:05.55,0:12:07.76,Default,,0,0,0,,Менің алдымда тұрма!
Dialogue: 0,0:12:07.76,0:12:08.14,Default,,0,0,0,,Менің алдымда тұрма!
Dialogue: 0,0:12:07.76,0:12:08.14,Default,,0,0,0,,Буха!
Dialogue: 0,0:12:08.14,0:12:09.47,Default,,0,0,0,,Буха!
Dialogue: 0,0:12:09.56,0:12:10.77,Default,,0,0,0,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:12:10.85,0:12:13.14,Default,,0,0,0,,Хираманың жігіті мүлде санасыз...
Dialogue: 0,0:12:13.23,0:12:15.02,Default,,0,0,0,,Қарама!
Dialogue: 0,0:12:15.10,0:12:16.15,Default,,0,0,0,,Тек қарау арқылы?
Dialogue: 0,0:12:16.23,0:12:18.07,Default,,0,0,0,,Агага...
Dialogue: 0,0:12:18.15,0:12:19.65,Default,,0,0,0,,Чи Хун
Dialogue: 0,0:12:19.73,0:12:22.11,Default,,0,0,0,,Серизава дөрекі.
Dialogue: 0,0:12:22.19,0:12:23.15,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:12:23.99,0:12:25.28,Default,,0,0,0,,Бұл мәселе
Dialogue: 0,0:12:25.36,0:12:28.78,Default,,0,0,0,,Маған баяндаманы мүмкіндігінше дөңгелектеп жазу керектігін айтты.
Dialogue: 0,0:12:28.87,0:12:31.50,Default,,0,0,0,,Мен дереу қағаз бен суспензияны дайындаймын.
Dialogue: 0,0:12:32.54,0:12:34.12,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:12:35.50,0:12:38.21,Default,,0,0,0,,Бұл мәселенің салдары қандай?
Dialogue: 0,0:12:38.29,0:12:40.34,Default,,0,0,0,,Мүмкін сіз дұрыс тыңдауға тырыспайсыз ба?
Dialogue: 0,0:12:40.42,0:12:43.13,Default,,0,0,0,,Жақсы, оны естігің келмейді.
Dialogue: 0,0:12:43.22,0:12:46.26,Default,,0,0,0,,Тамақтанып, ұйықтасаң, үш күнде ұмытып кетесің деп ойлаймын.
Dialogue: 0,0:12:46.34,0:12:48.89,Default,,0,0,0,,Осындай істерді дұрыс орындау керек.
Dialogue: 0,0:12:48.97,0:12:52.98,Default,,0,0,0,,Маңыздысы адамның өзін қалай сезінуі.
Dialogue: 0,0:12:53.06,0:12:55.81,Default,,0,0,0,,Егін өңдесем ұмытып қаламын ба?
Dialogue: 0,0:12:55.90,0:12:56.85,Default,,0,0,0,,Содан кейін олар жоғалады
Dialogue: 0,0:12:57.69,0:12:59.65,Default,,0,0,0,,Сәлем Хиджиката-сан
Dialogue: 0,0:13:01.19,0:13:04.57,Default,,0,0,0,,Кондо мырзаға қалдыра аламын ба?
Dialogue: 0,0:13:04.65,0:13:05.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:05.70,0:13:06.95,Default,,0,0,0,,Иә
Dialogue: 0,0:13:08.82,0:13:12.58,Default,,0,0,0,,Бұндай жағдайда қылыштың жалғыз жолы!
Dialogue: 0,0:13:14.12,0:13:15.46,Default,,0,0,0,,теріңіз!
Dialogue: 0,0:13:15.54,0:13:16.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:17.17,0:13:19.38,Default,,0,0,0,,Иә, Кондо мырза?
Dialogue: 0,0:13:20.25,0:13:21.46,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:13:21.55,0:13:23.88,Default,,0,0,0,,-(Todo) Мен қатты уайымдап тұрмын -Иә!?
Dialogue: 0,0:13:24.67,0:13:28.30,Default,,0,0,0,,Осындай кезде көп ойланбаған дұрыс.
Dialogue: 0,0:13:34.02,0:13:36.81,Default,,0,0,0,,Маған оны теру керек, солай ма?
Dialogue: 0,0:13:36.89,0:13:39.19,Default,,0,0,0,,Дұрыс, қолыңнан келгенше кел!
Dialogue: 0,0:13:40.73,0:13:42.07,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:13:42.15,0:13:43.78,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:43.86,0:13:45.65,Default,,0,0,0,,Келесі жолы демалмаңыз!
Dialogue: 0,0:13:45.74,0:13:47.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:49.32,0:13:51.20,Default,,0,0,0,,- (Кондо) Әлі жоқ! -иә!
Dialogue: 0,0:13:51.28,0:13:52.58,Default,,0,0,0,,Толығырақ!
Dialogue: 0,0:13:52.66,0:13:53.74,Default,,0,0,0,,- Иә! -(Кондо) Жүр!
Dialogue: 0,0:13:55.50,0:13:58.25,Default,,0,0,0,,Мен жай ғана жазып жатырмын.
Dialogue: 0,0:13:58.33,0:14:02.75,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:14:03.84,0:14:08.26,Default,,0,0,0,,Наги-дононың денесі туысы жоқ Будда ретінде Нагеми-джи храмында жерленген.
Dialogue: 0,0:14:08.34,0:14:09.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.34,0:14:12.35,Default,,0,0,0,,Бастапқыда менің туыстарым болған жоқ.
Dialogue: 0,0:14:12.43,0:14:16.14,Default,,0,0,0,,Мен бұл оқиға болмай тұрып ажырасқанмын.
Dialogue: 0,0:14:16.23,0:14:17.77,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:14:17.85,0:14:20.73,Default,,0,0,0,,Не? Кенеттен бе?
Dialogue: 0,0:14:20.81,0:14:21.65,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:14:22.31,0:14:23.90,Default,,0,0,0,,-Ei - (Кондо) әлсіз
Dialogue: 0,0:14:23.98,0:14:25.44,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:26.36,0:14:27.86,Default,,0,0,0,,Хахаха
Dialogue: 0,0:14:28.70,0:14:31.32,Default,,0,0,0,,Йотаро-дононы мен өлтірдім.
Dialogue: 0,0:14:31.41,0:14:32.37,Default,,0,0,0,,Өлтірілді
Dialogue: 0,0:14:32.45,0:14:33.99,Default,,0,0,0,,Ха...
Dialogue: 0,0:14:35.16,0:14:38.87,Default,,0,0,0,,Оны өлтірмей тоқтату мүмкін емес еді.
Dialogue: 0,0:14:39.42,0:14:41.46,Default,,0,0,0,,Наозумиді Серизава мырза өлтірді
Dialogue: 0,0:14:41.54,0:14:43.13,Default,,0,0,0,,Тоқтатыңыз...
Dialogue: 0,0:14:43.71,0:14:47.13,Default,,0,0,0,,Екі дене қылмыскер ретінде жойылады.
Dialogue: 0,0:14:47.72,0:14:50.13,Default,,0,0,0,,Оны тоқтатыңыз.
Dialogue: 0,0:14:50.84,0:14:54.14,Default,,0,0,0,,Киохачидің үйі, соның ішінде дохжо толығымен қирап қалды.
Dialogue: 0,0:14:54.22,0:14:56.64,Default,,0,0,0,,Отбасы, оның ішінде салалық отбасы да бөлінеді.
Dialogue: 0,0:14:57.77,0:14:59.64,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:14:59.73,0:15:01.15,Default,,0,0,0,,Гррр…
Dialogue: 0,0:15:07.82,0:15:11.66,Default,,0,0,0,,Білемін, білемін...
Dialogue: 0,0:15:14.03,0:15:15.66,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:15.74,0:15:17.75,Default,,0,0,0,,Себебі бұл жеткіліксіз болды
Dialogue: 0,0:15:19.08,0:15:20.08,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:15:20.16,0:15:21.67,Default,,0,0,0,,Себебі мен оны елемей қалдым.
Dialogue: 0,0:15:22.67,0:15:25.00,Default,,0,0,0,,Себебі мен сәтсіздікке ұшырадым.
Dialogue: 0,0:15:25.67,0:15:29.42,Default,,0,0,0,,Өйткені мен әлсіз болдым
Dialogue: 0,0:15:32.51,0:15:33.89,Default,,0,0,0,,Барлығы…
Dialogue: 0,0:15:36.35,0:15:38.43,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:15:39.98,0:15:41.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:43.23,0:15:46.61,Default,,0,0,0,,Босану – өз өміріне қауіп төндіреді.
Dialogue: 0,0:15:46.69,0:15:50.28,Default,,0,0,0,,Жаңа туған нәресте белгілі бір қайырымды адамға тапсырылды.
Dialogue: 0,0:15:51.65,0:15:53.91,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:15:55.49,0:15:57.24,Default,,0,0,0,,Мүмкін мен де байқап көрермін.
Dialogue: 0,0:15:57.33,0:15:59.24,Default,,0,0,0,,Бұл аздап асыра сілтеу...
Dialogue: 0,0:15:59.33,0:16:00.91,Default,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:16:01.54,0:16:05.17,Default,,0,0,0,,Сен алдымен шындықты қабылдамайынша алға жылжи алмайсың.
Dialogue: 0,0:16:06.04,0:16:08.17,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:08.25,0:16:10.59,Default,,0,0,0,,Әй, Нии-кун!
Dialogue: 0,0:16:14.59,0:16:15.84,Default,,0,0,0,,Қатты қызба
Dialogue: 0,0:16:15.93,0:16:17.01,Default,,0,0,0,,Не!?
Dialogue: 0,0:16:17.10,0:16:21.48,Default,,0,0,0,,Неліктен ешкім байқамайды? Өзіңді тым зорлап жатырсың, ақымақ!
Dialogue: 0,0:16:21.56,0:16:22.98,Default,,0,0,0,,Ыңғайсыз...
Dialogue: 0,0:16:29.07,0:16:31.99,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:34.74,0:16:36.78,Default,,0,0,0,,Кіріспе Мен не істеуім керек?
Dialogue: 0,0:16:36.87,0:16:39.99,Default,,0,0,0,,Сіз жай ғана шаршадыңыз. Ұйқы сіздің денеңізді емдейді.
Dialogue: 0,0:16:40.08,0:16:42.12,Default,,0,0,0,,Дене туралы не деуге болады?
Dialogue: 0,0:16:42.20,0:16:44.04,Default,,0,0,0,,Сонымен, мәселе неде?
Dialogue: 0,0:16:44.12,0:16:45.00,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:16:45.08,0:16:47.00,Default,,0,0,0,,Әй, қайда барасың!
Dialogue: 0,0:16:47.08,0:16:47.92,Default,,0,0,0,,Бизнес
Dialogue: 0,0:16:48.00,0:16:50.80,Default,,0,0,0,,Иә? Менің достарым қиналып жатыр
Dialogue: 0,0:16:50.88,0:16:52.51,Default,,0,0,0,,Хитоденаши!
Dialogue: 0,0:16:53.22,0:16:55.93,Default,,0,0,0,,О...\NМаған
Dialogue: 0,0:16:57.59,0:16:59.14,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:16:59.22,0:17:02.02,Default,,0,0,0,,туралы хабарлағаныңыз үшін рахмет
Dialogue: 0,0:17:02.64,0:17:05.56,Default,,0,0,0,,Бұл мен үшін не?
Dialogue: 0,0:17:05.64,0:17:08.52,Default,,0,0,0,,Мен сені кездестіргім келетін адам - ​​Онноя Хажиме.
Dialogue: 0,0:17:09.02,0:17:10.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:10.86,0:17:13.36,Default,,0,0,0,,-Әже Біраз уақыт болды! -Уау
Dialogue: 0,0:17:13.44,0:17:16.32,Default,,0,0,0,,О, тағы да киініп ал
Dialogue: 0,0:17:16.41,0:17:17.66,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:17:18.32,0:17:20.20,Default,,0,0,0,,Сіз Хаджиме-чансыз!
Dialogue: 0,0:17:20.28,0:17:22.66,Default,,0,0,0,,Қажы...ме...чан?
Dialogue: 0,0:17:24.25,0:17:26.67,Default,,0,0,0,,Танысқаныма қуаныштымын Ироха Учиха
Dialogue: 0,0:17:26.75,0:17:28.42,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:17:28.50,0:17:30.00,Default,,0,0,0,,Менің әпкем
Dialogue: 0,0:17:30.09,0:17:31.55,Default,,0,0,0,,Әпке!?
Dialogue: 0,0:17:31.63,0:17:34.42,Default,,0,0,0,,Асыл адамға берілген нәрсе сияқты ма?
Dialogue: 0,0:17:34.97,0:17:36.18,Default,,0,0,0,,Эххе
Dialogue: 0,0:17:36.26,0:17:38.05,Default,,0,0,0,,Мибро мен Хаджиме-чан ше?
Dialogue: 0,0:17:38.14,0:17:40.43,Default,,0,0,0,,Мен әжемнің хатынан білдім.
Dialogue: 0,0:17:40.51,0:17:42.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:42.26,0:17:45.06,Default,,0,0,0,,Менің Хаджиме-чанға өтінішім бар.
Dialogue: 0,0:17:45.14,0:17:47.44,Default,,0,0,0,,Өтінемін? Бұл не?
Dialogue: 0,0:17:47.52,0:17:50.40,Default,,0,0,0,,«Менімен ойнау» сияқты нәрсе емес деп ойлаймын.
Dialogue: 0,0:17:50.48,0:17:54.69,Default,,0,0,0,,Жалпы айтқанда, баланың түн ортасында сарайдан жалғыз шығуы қауіпті.
Dialogue: 0,0:17:54.78,0:17:57.86,Default,,0,0,0,,Хехе, ол хат сияқты.
Dialogue: 0,0:17:57.95,0:17:58.95,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:59.03,0:18:00.20,Default,,0,0,0,,Әй, сен не жаздың?
Dialogue: 0,0:18:00.82,0:18:02.99,Default,,0,0,0,,Әрине бір адам емес.
Dialogue: 0,0:18:03.08,0:18:04.66,Default,,0,0,0,,О? (аяқ дыбыстары)
Dialogue: 0,0:18:04.75,0:18:05.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:06.75,0:18:09.21,Default,,0,0,0,,Хохохохохо
Dialogue: 0,0:18:10.04,0:18:11.79,Default,,0,0,0,,Қараңдар, құлап жатқан жоқ, құлап жатқан жоқ.
Dialogue: 0,0:18:11.88,0:18:14.71,Default,,0,0,0,,Бұл құлпынай кемари
Dialogue: 0,0:18:15.42,0:18:16.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:16.80,0:18:19.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:19.18,0:18:23.72,Default,,0,0,0,,Хаджиме-чан, бұл Анеякожи-сама деп қорқамын.
Dialogue: 0,0:18:27.31,0:18:28.44,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:18:28.52,0:18:31.48,Default,,0,0,0,,Өз елін қорғауға ұмтылған сатсума патриоттарынан
Dialogue: 0,0:18:31.56,0:18:34.11,Default,,0,0,0,,Көсем ретінде сүйсінген асыл
Dialogue: 0,0:18:34.19,0:18:36.19,Default,,0,0,0,,Оны 23-ке өзгертіңіз
Dialogue: 0,0:18:36.28,0:18:39.61,Default,,0,0,0,,Император сарайының Джой фракциясын басқаратын пионер!
Dialogue: 0,0:18:39.70,0:18:43.62,Default,,0,0,0,,Кочи Анеякожи деген кім?
Dialogue: 0,0:18:43.70,0:18:45.87,Default,,0,0,0,,Хо-хо-хо
Dialogue: 0,0:18:45.95,0:18:48.33,Default,,0,0,0,,Жаман болған сияқты.
Dialogue: 0,0:18:48.41,0:18:50.62,Default,,0,0,0,,Абырой мен мақтау.
Dialogue: 0,0:18:50.71,0:18:54.25,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:18:54.34,0:18:56.96,Default,,0,0,0,,Мен оны бір рет ұрсам бола ма?
Dialogue: 0,0:18:57.05,0:18:57.88,Default,,0,0,0,,Неге!
Dialogue: 0,0:18:59.01,0:19:03.39,Default,,0,0,0,,Негізі мен Хаджиме-чанның Анеякоджи-саманы қорғағанын қалаймын.
Dialogue: 0,0:19:03.47,0:19:05.43,Default,,0,0,0,,Хо-хо-хо
Dialogue: 0,0:19:05.51,0:19:08.14,Default,,0,0,0,,Мен сені қорғайын, бақытты бол, бастау
Dialogue: 0,0:19:08.23,0:19:09.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:10.60,0:19:12.65,Default,,0,0,0,,Тек 3 күнге
Dialogue: 0,0:19:12.73,0:19:17.15,Default,,0,0,0,,Бұл күні бойы емес, сарайдан бекініске дейінгі қысқа жол ғана болды.
Dialogue: 0,0:19:17.73,0:19:20.65,Default,,0,0,0,,Күзетшілер мен оққағарлар көп.
Dialogue: 0,0:19:20.74,0:19:25.28,Default,,0,0,0,,Егер устрица фестивалі болса, бәрі жеңер еді...
Dialogue: 0,0:19:25.37,0:19:29.66,Default,,0,0,0,,Неге екені белгісіз, мен таңдаулы адам болғандықтан үлгермедім.
Dialogue: 0,0:19:29.75,0:19:32.96,Default,,0,0,0,,Негізі ағаңнан да сұрайын деп едім.
Dialogue: 0,0:19:33.04,0:19:35.29,Default,,0,0,0,,Олай емес сияқты.
Dialogue: 0,0:19:35.38,0:19:38.30,Default,,0,0,0,,Хиджиката мырза мен Окита мырза көзге түседі.
Dialogue: 0,0:19:38.38,0:19:41.68,Default,,0,0,0,,Мибродан сұрағанда қиындай түседі...
Dialogue: 0,0:19:41.76,0:19:45.64,Default,,0,0,0,,Ол күрделене ме? Бұл не?
Dialogue: 0,0:19:45.72,0:19:48.06,Default,,0,0,0,,Дәлірек айтсақ, бірінші кезекте осындай тамаша жігіт
Dialogue: 0,0:19:48.14,0:19:49.93,Default,,0,0,0,,Кімге және неліктен нысанаға алынды?
Dialogue: 0,0:19:50.64,0:19:51.94,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:56.52,0:20:00.11,Default,,0,0,0,,Ха, айтқың келмесе, жарайды.
Dialogue: 0,0:20:00.19,0:20:02.45,Default,,0,0,0,,Мен сені үш күн қорғауым керек, солай ма?
Dialogue: 0,0:20:02.53,0:20:04.95,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:20:05.03,0:20:08.24,Default,,0,0,0,,Мен мұны істеймін, мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:20:08.33,0:20:09.45,Default,,0,0,0,,Біз...
Dialogue: 0,0:20:10.08,0:20:11.96,Default,,0,0,0,,Біз?
Dialogue: 0,0:20:12.04,0:20:14.21,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:20:14.29,0:20:16.21,Default,,0,0,0,,Хаджиме-чанға рахмет!
Dialogue: 0,0:20:16.29,0:20:17.21,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:17.29,0:20:19.21,Default,,0,0,0,,Жұмысты бастау
Dialogue: 0,0:20:19.30,0:20:20.71,Default,,0,0,0,,Уф, келме, хаг!
Dialogue: 0,0:20:26.09,0:20:28.22,Default,,0,0,0,,Бұл шынымен де аз қашықтық.
Dialogue: 0,0:20:28.31,0:20:32.81,Default,,0,0,0,,Император сарайындағы таңғы жиналысқа бару, тек сонда барып қайту.
Dialogue: 0,0:20:32.89,0:20:36.73,Default,,0,0,0,,Сарай аумағына бірінші рет кірсеңіз де, қозғалмағаныңызға таң қалдым.
Dialogue: 0,0:20:37.23,0:20:40.73,Default,,0,0,0,,Хмф, айналаға қарасам күдікті болар еді.
Dialogue: 0,0:20:41.32,0:20:42.69,Default,,0,0,0,,Хун
Dialogue: 0,0:20:44.82,0:20:45.78,Default,,0,0,0,,Күнделік?
Dialogue: 0,0:20:45.86,0:20:48.74,Default,,0,0,0,,Асыл адамның маңызды жұмысының бірі
Dialogue: 0,0:20:48.83,0:20:51.20,Default,,0,0,0,,Күнделікті есеп жүргізу
Dialogue: 0,0:20:51.29,0:20:54.08,Default,,0,0,0,,Сонда келесі жолы еш қиындық көрмейсіз.
Dialogue: 0,0:20:54.16,0:20:55.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:55.08,0:20:58.25,Default,,0,0,0,,Өткенді, бүгінді және болашақты байланыстыру
Dialogue: 0,0:20:58.34,0:21:00.75,Default,,0,0,0,,Дәстүрді осылай сақтайсың.
Dialogue: 0,0:21:01.80,0:21:04.59,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ қиын сияқты.
Dialogue: 0,0:21:05.18,0:21:06.51,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,0:21:06.59,0:21:09.18,Default,,0,0,0,,Сіз мені тыңдамайсыз ба?
Dialogue: 0,0:21:09.26,0:21:10.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:10.56,0:21:12.81,Default,,0,0,0,,Менің ойымша, сіз жағдай туралы аздап білетін шығарсыз.
Dialogue: 0,0:21:14.85,0:21:16.23,Default,,0,0,0,,Бұл менің әпкем.
Dialogue: 0,0:21:16.31,0:21:19.77,Default,,0,0,0,,Әр нәрсенің қамы отбасы емес пе?
Dialogue: 0,0:21:19.86,0:21:21.78,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:21.86,0:21:22.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:23.03,0:21:26.15,Default,,0,0,0,,Хаджиме-чан Бұл өте тесігі.
Dialogue: 0,0:21:26.24,0:21:28.62,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:30.62,0:21:33.04,Default,,0,0,0,,Сіз өз отбасыңыздан айта аласыз.
Dialogue: 0,0:21:39.29,0:21:42.38,Default,,0,0,0,,Мен сенің ағаң екеніне сенімдімін...
Dialogue: 0,0:21:50.97,0:21:55.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:11.55,0:23:16.56,Default,,0,0,0,,～♪
Dialogue: 0,0:23:23.19,0:23:26.07,Default,,0,0,0,,Уақыттың күшеюі
Dialogue: 0,0:23:26.15,0:23:32.49,Default,,0,0,0,,Хаос үдей түседі, ал Мибро үлкен бетбұрыс жасауға мәжбүр болады.
Dialogue: 0,0:23:32.99,0:23:35.37,Default,,0,0,0,,Ал жас кеткенде
Dialogue: 0,0:23:35.45,0:23:40.91,Default,,0,0,0,,Жас қасқырлар қайғы мен қиындықты жеңеді
Dialogue: 0,0:23:41.00,0:23:44.17,Default,,0,0,0,,Мен шын көңілімді табуға тырыстым.
Dialogue: 0,0:23:45.29,0:23:48.05,Default,,0,0,0,,Келесі жолы «Көк ант»
Dialogue: 0,0:23:48.13,0:23:50.34,Default,,0,0,0,,Бізбен болыңыз
Dialogue: 0,0:23:51.84,0:23:57.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
