Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.84,0:00:09.67,Default,,0,0,0,,Сіз келесідесіз
Dialogue: 0,0:00:09.75,0:00:12.05,Default,,0,0,0,,Біз бұрын кездескенбіз.
Dialogue: 0,0:00:12.13,0:00:13.43,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:00:13.51,0:00:14.93,Default,,0,0,0,,Кіріспе
Dialogue: 0,0:00:15.01,0:00:16.43,Default,,0,0,0,,Хаджиме Сайто
Dialogue: 0,0:00:17.26,0:00:18.89,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:00:18.97,0:00:21.81,Default,,0,0,0,,Маған әсіресе қанішер жауынгерлік рух ұнайды.
Dialogue: 0,0:00:23.39,0:00:24.31,Default,,0,0,0,,Кіріспе
Dialogue: 0,0:00:24.39,0:00:26.69,Default,,0,0,0,,- (Аяме) Сен де Рисшиданға қосылсаң... -Мен бас тартамын.
Dialogue: 0,0:00:28.06,0:00:29.82,Default,,0,0,0,,- (Аяме) Мибро арқылы өту... - Бас тарту
Dialogue: 0,0:00:34.61,0:00:39.95,Default,,0,0,0,,♪～
Dialogue: 0,0:01:57.86,0:02:02.87,Default,,0,0,0,,～♪
Dialogue: 0,0:02:07.50,0:02:09.17,Default,,0,0,0,,-(Студент) Уф -(Аяме) А?
Dialogue: 0,0:02:09.25,0:02:11.79,Default,,0,0,0,,Не, сен мені өлтірген жоқсың ба?
Dialogue: 0,0:02:12.63,0:02:15.67,Default,,0,0,0,,Бұл балалар екеуміздің өнеріміз тым бөлек.
Dialogue: 0,0:02:15.76,0:02:17.30,Default,,0,0,0,,Мені өлтіруге жетпейді
Dialogue: 0,0:02:17.38,0:02:22.01,Default,,0,0,0,,Аа... Көңілім қалды. Бұл Чанбараның ойыны.
Dialogue: 0,0:02:22.10,0:02:24.06,Default,,0,0,0,,Не айтсаң да
Dialogue: 0,0:02:24.14,0:02:25.77,Default,,0,0,0,,Жақында сен де солай боласың.
Dialogue: 0,0:02:31.90,0:02:32.77,Default,,0,0,0,,Уф
Dialogue: 0,0:02:33.82,0:02:35.28,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:37.19,0:02:40.32,Default,,0,0,0,,Уф... қарғыс атсын...
Dialogue: 0,0:02:40.41,0:02:43.91,Default,,0,0,0,,Бала екен деп сақылдап жібердім... Уа
Dialogue: 0,0:02:43.99,0:02:48.04,Default,,0,0,0,,Қозғалма, ұйықтап жатқандай кейіп таныт.
Dialogue: 0,0:02:48.87,0:02:50.42,Default,,0,0,0,,Ниими
Dialogue: 0,0:02:51.12,0:02:55.67,Default,,0,0,0,,Мен сенің не ойлайтыныңды білмеймін, бірақ сен өз жұмысыңды жақсы орындайтыныңа сенімдімін.
Dialogue: 0,0:02:55.75,0:02:58.42,Default,,0,0,0,,Хиджикатаның көзі жақсы.
Dialogue: 0,0:02:59.34,0:03:01.80,Default,,0,0,0,,Сіз менің серіктесім ретінде ең жақсысыз.
Dialogue: 0,0:03:03.01,0:03:04.76,Default,,0,0,0,,Келмейсің бе?
Dialogue: 0,0:03:05.22,0:03:09.43,Default,,0,0,0,,Иә, бұл сіздің қолыңыздан келетіндіктен.
Dialogue: 0,0:03:10.10,0:03:12.90,Default,,0,0,0,,Бұл оғаш сенім деген не?
Dialogue: 0,0:03:12.98,0:03:14.94,Default,,0,0,0,,Менде бір нәрсе туралы жағымсыз сезім бар.
Dialogue: 0,0:03:15.77,0:03:17.19,Default,,0,0,0,,Мен де сол кезде біртүрлі болдым.
Dialogue: 0,0:03:19.15,0:03:22.57,Default,,0,0,0,,Бет әлпеті? Мінез бе?
Dialogue: 0,0:03:22.66,0:03:25.07,Default,,0,0,0,,Ха, аты?
Dialogue: 0,0:03:25.91,0:03:28.41,Default,,0,0,0,,«ақылсыз ақыл» «арандату»
Dialogue: 0,0:03:25.91,0:03:28.41,Default,,0,0,0,,Олардың есімдерінде бір қызық нәрсе бар...
Dialogue: 0,0:03:28.41,0:03:28.49,Default,,0,0,0,,Олардың есімдерінде бір қызық нәрсе бар...
Dialogue: 0,0:03:28.49,0:03:28.95,Default,,0,0,0,,Олардың есімдерінде бір қызық нәрсе бар...
Dialogue: 0,0:03:28.49,0:03:28.95,Default,,0,0,0,,«Самурай» «Ит»…
Dialogue: 0,0:03:28.95,0:03:29.04,Default,,0,0,0,,«Самурай» «Ит»…
Dialogue: 0,0:03:29.04,0:03:31.08,Default,,0,0,0,,«Самурай» «Таз»…
Dialogue: 0,0:03:29.04,0:03:31.08,Default,,0,0,0,,Ерекше атау болды.
Dialogue: 0,0:03:31.16,0:03:33.08,Default,,0,0,0,,Цк, мен ұмытып қалдым.
Dialogue: 0,0:03:33.92,0:03:36.46,Default,,0,0,0,,Ол бірдеңені анықтай алатын шығар...
Dialogue: 0,0:03:36.54,0:03:39.55,Default,,0,0,0,,Кіріспе Бұл жақсы.
Dialogue: 0,0:03:39.63,0:03:41.97,Default,,0,0,0,,Мұнда келсең, адамдарды өлтіруге болады.
Dialogue: 0,0:03:43.05,0:03:45.47,Default,,0,0,0,,Сіз күшті бола аласыз
Dialogue: 0,0:03:49.47,0:03:52.02,Default,,0,0,0,,Адам өлтіруден басқа жұмыс жоқ.
Dialogue: 0,0:03:53.23,0:03:55.23,Default,,0,0,0,,А? Түсінесіз бе?
Dialogue: 0,0:03:55.31,0:04:00.11,Default,,0,0,0,,Мәйітті бөлшектеп, сүйектері мен ішкі мүшелерін тексеру.
Dialogue: 0,0:04:00.19,0:04:02.49,Default,,0,0,0,,Медициналық зерттеулерге арналған
Dialogue: 0,0:04:03.11,0:04:07.49,Default,,0,0,0,,Қылмыскердің мәйітін пайдалану үшін сегунаттың рұқсаты қажет.
Dialogue: 0,0:04:07.58,0:04:11.25,Default,,0,0,0,,Мен мұндай нәрсені ала алмаймын. Бұл медицина ғалымының өтініші.
Dialogue: 0,0:04:11.33,0:04:13.25,Default,,0,0,0,,Қабір тонау?
Dialogue: 0,0:04:13.33,0:04:17.17,Default,,0,0,0,,10 көлік қалдықтарды тасымалдауға және оларды алып жүруге көмектеседі
Dialogue: 0,0:04:17.25,0:04:19.67,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:04:19.75,0:04:22.88,Default,,0,0,0,,Білсеңіз, түрмеде боласыз
Dialogue: 0,0:04:23.34,0:04:25.68,Default,,0,0,0,,Адам өлтіру болмаса, бәрі жақсы.
Dialogue: 0,0:04:25.76,0:04:27.55,Default,,0,0,0,,Не!? 10 көлік?
Dialogue: 0,0:04:27.64,0:04:30.85,Default,,0,0,0,,Иә? Өйткені, бұл жігіттен қанның иісі бар.
Dialogue: 0,0:04:30.93,0:04:31.81,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:04:34.60,0:04:38.73,Default,,0,0,0,,Егер сіз ештеңе сұрамасаңыз, бұл сенесіз деген сөз, солай емес пе?
Dialogue: 0,0:04:41.03,0:04:42.57,Default,,0,0,0,,Мен өлтірмеймін
Dialogue: 0,0:04:43.49,0:04:47.07,Default,,0,0,0,,Егер сізде күшті күш болса, оны өлтірмей-ақ басып алуға болады.
Dialogue: 0,0:04:47.16,0:04:51.16,Default,,0,0,0,,Мен Мибромын, мен Киото қаласын қорғаймын.
Dialogue: 0,0:04:51.24,0:04:52.83,Default,,0,0,0,,Осылайша бағытталған
Dialogue: 0,0:04:53.41,0:04:56.21,Default,,0,0,0,,Хмф, бұл тым тәтті.
Dialogue: 0,0:04:56.29,0:04:58.08,Default,,0,0,0,,Бұл өкінішті.
Dialogue: 0,0:04:58.17,0:05:00.63,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:05:03.38,0:05:07.76,Default,,0,0,0,,Сол кезде оң қолыммен сазанның аузын әдейі кесіп алдым.
Dialogue: 0,0:05:10.35,0:05:12.02,Default,,0,0,0,,Пайдаланылмаған сол қол
Dialogue: 0,0:05:13.98,0:05:15.02,Default,,0,0,0,,Біртүрлі сенімділік
Dialogue: 0,0:05:16.31,0:05:20.15,Default,,0,0,0,,Дұрыс айтасың, оның сол қолында бірдеңе бар.
Dialogue: 0,0:05:20.23,0:05:22.28,Default,,0,0,0,,Кішкентай қара қару шығар
Dialogue: 0,0:05:24.40,0:05:27.78,Default,,0,0,0,,Өмірді алу – күш
Dialogue: 0,0:05:29.53,0:05:33.54,Default,,0,0,0,,Біріншіден, мен сені өлтіруден басқа тоқтата алмаймын.
Dialogue: 0,0:05:33.62,0:05:35.00,Default,,0,0,0,,Мен оны… есептей алмаймын.
Dialogue: 0,0:05:43.13,0:05:44.30,Default,,0,0,0,,Егер оны жоймасам ше?
Dialogue: 0,0:05:44.38,0:05:45.42,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:05:46.05,0:05:48.01,Default,,0,0,0,,Менің сол қолым алыс.
Dialogue: 0,0:05:50.60,0:05:51.43,Default,,0,0,0,,Не!?
Dialogue: 0,0:05:52.89,0:05:54.27,Default,,0,0,0,,Қолдар жоқ
Dialogue: 0,0:05:56.23,0:05:58.14,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:58.23,0:06:00.61,Default,,0,0,0,,Ха! Уф!
Dialogue: 0,0:06:00.69,0:06:02.82,Default,,0,0,0,,О, сен қашып кеттің бе?
Dialogue: 0,0:06:02.90,0:06:05.61,Default,,0,0,0,,Мен оның бір қолы бар деп ешқашан ойламаппын.
Dialogue: 0,0:06:05.69,0:06:07.78,Default,,0,0,0,,Ғұн қауіпі
Dialogue: 0,0:06:07.86,0:06:09.82,Default,,0,0,0,,Бірақ қайта құрудың уақыты келді.
Dialogue: 0,0:06:09.91,0:06:11.66,Default,,0,0,0,,Жоқ, басы
Dialogue: 0,0:06:11.74,0:06:13.33,Default,,0,0,0,,Жеңіске жету уақыты келді.
Dialogue: 0,0:06:13.41,0:06:14.83,Default,,0,0,0,,Не?
Dialogue: 0,0:06:17.66,0:06:19.33,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:06:19.42,0:06:21.58,Default,,0,0,0,,Бұл шыбын аулағыш деп ойлайсың ба?
Dialogue: 0,0:06:21.67,0:06:23.80,Default,,0,0,0,,Жоқ, бұл тәтті.
Dialogue: 0,0:06:24.92,0:06:27.38,Default,,0,0,0,,Менің ойым... шықты...
Dialogue: 0,0:06:27.47,0:06:29.59,Default,,0,0,0,,Біртүрлі есім...
Dialogue: 0,0:06:30.51,0:06:33.76,Default,,0,0,0,,Не істесең де жеңе аласың.
Dialogue: 0,0:06:34.26,0:06:37.85,Default,,0,0,0,,Сузуран… Улы гүл
Dialogue: 0,0:06:39.64,0:06:42.36,Default,,0,0,0,,Анау боқ... улы ма?
Dialogue: 0,0:06:43.61,0:06:45.11,Default,,0,0,0,,Мен жеңілемін бе...
Dialogue: 0,0:06:46.48,0:06:49.61,Default,,0,0,0,,Қария, мен...
Dialogue: 0,0:06:51.53,0:06:54.37,Default,,0,0,0,,Джиро, сен әлсізсің.
Dialogue: 0,0:06:54.45,0:06:56.74,Default,,0,0,0,,Мен әлсіз болсам ше?
Dialogue: 0,0:06:57.41,0:06:59.21,Default,,0,0,0,,Иә, әлсіз
Dialogue: 0,0:07:01.42,0:07:03.25,Default,,0,0,0,,Мен мұны білемін!
Dialogue: 0,0:07:03.33,0:07:06.42,Default,,0,0,0,,Сондықтан әкем мен шешемді қарақшылар өлтірді.
Dialogue: 0,0:07:06.50,0:07:07.76,Default,,0,0,0,,Себебі мен әлсізмін
Dialogue: 0,0:07:08.59,0:07:09.80,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:10.34,0:07:11.76,Default,,0,0,0,,Қарт адам сияқты
Dialogue: 0,0:07:11.84,0:07:14.39,Default,,0,0,0,,Күшті болғың келетінін айтпайсың ба?
Dialogue: 0,0:07:14.47,0:07:17.01,Default,,0,0,0,,Қарашы, сол күннен бері шашым ағарған.
Dialogue: 0,0:07:17.68,0:07:19.77,Default,,0,0,0,,Маған да қылышты үйрет.
Dialogue: 0,0:07:19.85,0:07:22.69,Default,,0,0,0,,Мен де қарттай күшті бола аламын.
Dialogue: 0,0:07:22.77,0:07:25.44,Default,,0,0,0,,- (Сайто) Әйтеуір - (Джиро) Неге!?
Dialogue: 0,0:07:25.52,0:07:28.48,Default,,0,0,0,,Джиро, маған шындықты айт.
Dialogue: 0,0:07:28.57,0:07:29.40,Default,,0,0,0,,Ах
Dialogue: 0,0:07:30.28,0:07:34.16,Default,,0,0,0,,Нені жасыруым керек? Мен де әлсізмін.
Dialogue: 0,0:07:34.24,0:07:35.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:36.49,0:07:38.20,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:07:38.29,0:07:41.29,Default,,0,0,0,,Мен шынымен де кедей баламын.
Dialogue: 0,0:07:41.37,0:07:45.17,Default,,0,0,0,,Ата-анам өлтірілді, туған-туыстарым жоқ, жетім қалдым...
Dialogue: 0,0:07:45.25,0:07:47.30,Default,,0,0,0,,Уф Қарау
Dialogue: 0,0:07:47.38,0:07:48.59,Default,,0,0,0,,Не!?
Dialogue: 0,0:07:50.38,0:07:51.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:51.88,0:07:55.01,Default,,0,0,0,,Айтсаңыз жақсы болмас па еді?
Dialogue: 0,0:07:55.89,0:07:57.43,Default,,0,0,0,,Кетинбо!
Dialogue: 0,0:07:58.06,0:08:00.06,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:01.64,0:08:04.15,Default,,0,0,0,,Қария шынында да мықты екен
Dialogue: 0,0:08:04.23,0:08:06.77,Default,,0,0,0,,Өйткені сіз сол қарақшыларды әп-сәтте өлтірдіңіз.
Dialogue: 0,0:08:06.86,0:08:09.07,Default,,0,0,0,,Жоқ, әлсіз
Dialogue: 0,0:08:09.15,0:08:11.94,Default,,0,0,0,,Адамдардың бәрі әлсіз. Ең бастысы...
Dialogue: 0,0:08:12.03,0:08:13.49,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:08:15.87,0:08:18.28,Default,,0,0,0,,Не деген...
Dialogue: 0,0:08:20.91,0:08:22.46,Default,,0,0,0,,тамақ ішейік
Dialogue: 0,0:08:26.33,0:08:28.29,Default,,0,0,0,,Жүр, алайық.
Dialogue: 0,0:08:30.25,0:08:32.63,Default,,0,0,0,,Такуан тағы да?
Dialogue: 0,0:08:36.14,0:08:37.39,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:08:37.47,0:08:40.39,Default,,0,0,0,,Алдымен тамақтан, бұл өмірдің негізі.
Dialogue: 0,0:08:43.06,0:08:44.19,Default,,0,0,0,,Бұл!?
Dialogue: 0,0:08:45.73,0:08:47.90,Default,,0,0,0,,Қолдарыңызды біріктіруді ұмытпаңыз
Dialogue: 0,0:08:47.98,0:08:49.73,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:57.20,0:09:00.66,Default,,0,0,0,,Қартайғандай қайратты бол.
Dialogue: 0,0:09:03.25,0:09:05.67,Default,,0,0,0,,Бұл өте күшті болды
Dialogue: 0,0:09:06.33,0:09:08.21,Default,,0,0,0,,Менің әлсіз болуым мүмкін емес
Dialogue: 0,0:09:09.88,0:09:11.17,Default,,0,0,0,,Қылыш, айтшы.
Dialogue: 0,0:09:11.25,0:09:12.80,Default,,0,0,0,,Алайда операция бастапқы сәттен бастап сәтсіздікке ұшыраудың аз-ақ алдында болды.
Dialogue: 0,0:09:12.88,0:09:16.68,Default,,0,0,0,,Хмф, жақсы, мен мұны өз қалауымша жасаймын.
Dialogue: 0,0:09:16.76,0:09:18.01,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:19.05,0:09:19.97,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,0:09:21.26,0:09:22.18,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:23.47,0:09:25.18,Default,,0,0,0,,Жуынуға келу
Dialogue: 0,0:09:25.27,0:09:29.06,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:29.15,0:09:30.52,Default,,0,0,0,,Ах
Dialogue: 0,0:09:34.07,0:09:35.32,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:09:35.40,0:09:38.20,Default,,0,0,0,,Не... Уф, шықпайды... Неге!?
Dialogue: 0,0:09:38.28,0:09:39.24,Default,,0,0,0,,(сықырлаған еден)
Dialogue: 0,0:09:39.32,0:09:40.95,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:09:44.66,0:09:48.46,Default,,0,0,0,,Кола! Бұл Қаппарай!
Dialogue: 0,0:09:48.54,0:09:49.83,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:51.25,0:09:52.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:54.17,0:09:55.46,Default,,0,0,0,,Мұны қайталама
Dialogue: 0,0:09:57.17,0:09:58.47,Default,,0,0,0,,Иә
Dialogue: 0,0:09:59.14,0:10:00.51,Default,,0,0,0,,Менің шашым ұзарып кетті.
Dialogue: 0,0:10:00.60,0:10:02.51,Default,,0,0,0,,Иә? Аа!?
Dialogue: 0,0:10:02.60,0:10:03.85,Default,,0,0,0,,Оны кесіп алайық
Dialogue: 0,0:10:03.93,0:10:05.27,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:10:09.65,0:10:12.52,Default,,0,0,0,,Тамырлардың түсі сәл оралды ма?
Dialogue: 0,0:10:17.82,0:10:19.91,Default,,0,0,0,,Сайтоның күйеуі
Dialogue: 0,0:10:19.99,0:10:21.03,Default,,0,0,0,,Бұл Аю
Dialogue: 0,0:10:23.20,0:10:24.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:24.74,0:10:26.29,Default,,0,0,0,,Сіздің жұмысыңыз бар ма?
Dialogue: 0,0:10:26.37,0:10:28.08,Default,,0,0,0,,Иә
Dialogue: 0,0:10:28.58,0:10:29.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:29.50,0:10:30.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:31.29,0:10:32.92,Default,,0,0,0,,Хи хи
Dialogue: 0,0:10:34.67,0:10:35.92,Default,,0,0,0,,Қастандық?
Dialogue: 0,0:10:36.67,0:10:39.34,Default,,0,0,0,,Ол бір адамды өлтіріп, Эдодан қашып кетті.
Dialogue: 0,0:10:39.43,0:10:41.68,Default,,0,0,0,,Сізді тығырықтан құтқарған.
Dialogue: 0,0:10:43.22,0:10:45.43,Default,,0,0,0,,Менің қолымнан адам өлтіруден басқа ештеңе келмейді.
Dialogue: 0,0:10:48.14,0:10:49.60,Default,,0,0,0,,Джиро
Dialogue: 0,0:10:49.69,0:10:51.85,Default,,0,0,0,,Өйткені, басқа жаққа бару керек.
Dialogue: 0,0:10:52.61,0:10:54.98,Default,,0,0,0,,Менімен бірге болғанның жақсылығы жоқ.
Dialogue: 0,0:10:55.07,0:10:56.19,Default,,0,0,0,,(жеңді тартып алу дыбысы)
Dialogue: 0,0:10:58.69,0:11:03.70,Default,,0,0,0,,Мен енді ешкімнің жоғалғанын қаламаймын.
Dialogue: 0,0:11:07.04,0:11:08.45,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:11:15.38,0:11:16.59,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:18.55,0:11:20.05,Default,,0,0,0,,Старлинг
Dialogue: 0,0:11:20.13,0:11:21.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:21.43,0:11:24.10,Default,,0,0,0,,Жұлдызшалардың құйрық қозғалысы
Dialogue: 0,0:11:24.18,0:11:27.10,Default,,0,0,0,,О? Құйрық қозғалысы?
Dialogue: 0,0:11:27.18,0:11:28.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:29.43,0:11:32.44,Default,,0,0,0,,Мынау бөтелке.
Dialogue: 0,0:11:32.52,0:11:37.69,Default,,0,0,0,,Қылыш сазанның аузынан өткенде, қынаның ұшын сол қолыңызбен жылжытыңыз.
Dialogue: 0,0:11:37.78,0:11:38.86,Default,,0,0,0,,Оны қараңыз
Dialogue: 0,0:11:47.62,0:11:49.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:51.29,0:11:53.50,Default,,0,0,0,,Міне, сол қозғалыс.
Dialogue: 0,0:11:54.17,0:11:56.42,Default,,0,0,0,,Төлеу кезінде де осы қағида қолданылады.
Dialogue: 0,0:11:56.50,0:11:58.67,Default,,0,0,0,,Жұлдызшалар екі рет ән айтады
Dialogue: 0,0:11:58.75,0:12:00.26,Default,,0,0,0,,Балалар үшін әлі мүмкін емес
Dialogue: 0,0:12:00.34,0:12:03.01,Default,,0,0,0,,Жұлдыздай Жұлдызша сияқты
Dialogue: 0,0:12:03.09,0:12:04.39,Default,,0,0,0,,Жұлдыз сияқты...
Dialogue: 0,0:12:08.81,0:12:09.64,Default,,0,0,0,,На
Dialogue: 0,0:12:13.06,0:12:14.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:14.35,0:12:16.90,Default,,0,0,0,,Тек бақшада
Dialogue: 0,0:12:17.77,0:12:18.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:19.78,0:12:22.70,Default,,0,0,0,,Қалай мен қарт сияқты самурай боламын?
Dialogue: 0,0:12:22.78,0:12:24.20,Default,,0,0,0,,Мен осыны ғана ойладым
Dialogue: 0,0:12:24.28,0:12:25.49,Default,,0,0,0,,“A” – “nu”
Dialogue: 0,0:12:25.57,0:12:26.41,Default,,0,0,0,,Нунуну
Dialogue: 0,0:12:26.99,0:12:29.91,Default,,0,0,0,,Эй таааааааааааааааааааааа
Dialogue: 0,0:12:32.50,0:12:34.92,Default,,0,0,0,,(Джироның ұйқысы)
Dialogue: 0,0:12:37.50,0:12:38.84,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:38.92,0:12:39.80,Default,,0,0,0,,Күшті болыңыз
Dialogue: 0,0:12:40.75,0:12:43.05,Default,,0,0,0,,Қарттай самурай бол
Dialogue: 0,0:12:53.35,0:12:54.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:56.73,0:12:58.56,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:13:00.40,0:13:02.15,Default,,0,0,0,,(Сайтоның жөтелі)
Dialogue: 0,0:13:07.24,0:13:09.41,Default,,0,0,0,,Уақыты келген жоқ па?
Dialogue: 0,0:13:16.25,0:13:17.79,Default,,0,0,0,,Жұмысқа барыңыз
Dialogue: 0,0:13:17.88,0:13:19.13,Default,,0,0,0,,Мені ал
Dialogue: 0,0:13:19.21,0:13:21.96,Default,,0,0,0,,Мен күшейіп, пайдалырақ болдым.
Dialogue: 0,0:13:22.05,0:13:23.13,Default,,0,0,0,,Менің артымнан ермеңіз
Dialogue: 0,0:13:23.21,0:13:24.30,Default,,0,0,0,,Неліктен!?
Dialogue: 0,0:13:25.01,0:13:27.68,Default,,0,0,0,,Джиро сен әлсізсің
Dialogue: 0,0:13:28.39,0:13:30.30,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:13:35.85,0:13:38.44,Default,,0,0,0,,Сіз жұмыс жасай алмайсыз ба?
Dialogue: 0,0:13:38.52,0:13:40.31,Default,,0,0,0,,Басың айналып тұрған жоқ па?
Dialogue: 0,0:13:40.40,0:13:42.19,Default,,0,0,0,,Мен саған артымнан ерме дедім.
Dialogue: 0,0:13:42.27,0:13:44.53,Default,,0,0,0,,Хаааахх
Dialogue: 0,0:13:44.61,0:13:45.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:45.90,0:13:48.49,Default,,0,0,0,,Үйге барма, мен пайдалымын.
Dialogue: 0,0:13:48.57,0:13:51.74,Default,,0,0,0,,Мен саған үйіңе бар демеймін. Ұстаңыз.
Dialogue: 0,0:13:51.83,0:13:52.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:53.33,0:13:56.16,Default,,0,0,0,,Бұл жұмыс қақпан болса керек.
Dialogue: 0,0:13:56.79,0:13:58.71,Default,,0,0,0,,Қазірдің өзінде қоршалған
Dialogue: 0,0:13:58.79,0:13:59.67,Default,,0,0,0,,Га
Dialogue: 0,0:13:59.75,0:14:02.17,Default,,0,0,0,,Бұл сан тым көп.
Dialogue: 0,0:14:02.25,0:14:05.76,Default,,0,0,0,,Сайто, атыңды тым көп саттың.
Dialogue: 0,0:14:05.84,0:14:08.30,Default,,0,0,0,,Оны табу оңай болды.
Dialogue: 0,0:14:09.22,0:14:11.05,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:14:11.14,0:14:13.31,Default,,0,0,0,,Осы жараның реніші
Dialogue: 0,0:14:13.39,0:14:14.93,Default,,0,0,0,,Қазір тазалаңыз!
Dialogue: 0,0:14:15.02,0:14:17.10,Default,,0,0,0,,Джиро, мені тастама.
Dialogue: 0,0:14:17.18,0:14:18.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:22.77,0:14:24.53,Default,,0,0,0,,(Бұзақылар айқайлайды)
Dialogue: 0,0:14:24.61,0:14:26.40,Default,,0,0,0,,Келіңдер, егеуқұйрықтар.
Dialogue: 0,0:14:26.49,0:14:27.78,Default,,0,0,0,,Какаре!
Dialogue: 0,0:14:27.86,0:14:30.53,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:30.61,0:14:32.45,Default,,0,0,0,,Алдымен Гаки!
Dialogue: 0,0:14:32.53,0:14:33.91,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:14:33.99,0:14:35.37,Default,,0,0,0,,Бетті жалама
Dialogue: 0,0:14:35.45,0:14:36.50,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:14:36.58,0:14:38.58,Default,,0,0,0,,О, жоқ болып кетті.
Dialogue: 0,0:14:40.67,0:14:43.13,Default,,0,0,0,,Мен саған бұл жігітке тиісуге рұқсат бермеймін.
Dialogue: 0,0:14:43.96,0:14:45.25,Default,,0,0,0,,Қария
Dialogue: 0,0:14:45.34,0:14:46.76,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:14:48.67,0:14:49.59,Default,,0,0,0,,Уф
Dialogue: 0,0:14:49.68,0:14:51.93,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:14:52.01,0:14:53.43,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:14:54.05,0:14:56.14,Default,,0,0,0,,Сіз оны тоқтата аласыз ба?
Dialogue: 0,0:14:56.22,0:14:58.89,Default,,0,0,0,,Қатты азаппен өткен өмірім
Dialogue: 0,0:14:58.98,0:15:00.77,Default,,0,0,0,,Мен оны жоғалтқым келмейді
Dialogue: 0,0:15:01.73,0:15:03.02,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:15:05.36,0:15:06.53,Default,,0,0,0,,Ах
Dialogue: 0,0:15:06.61,0:15:08.44,Default,,0,0,0,,Оны іске кіріссе, барын салып кіріседі деуге болады, немесе бәлкім абайсыз.
Dialogue: 0,0:15:09.11,0:15:10.53,Default,,0,0,0,,Hmph, бұл таяз.
Dialogue: 0,0:15:10.61,0:15:14.28,Default,,0,0,0,,Ал... Хаджиме Сайто, оны түсір!
Dialogue: 0,0:15:14.37,0:15:16.16,Default,,0,0,0,,Әй, қария! Қарт адам!
Dialogue: 0,0:15:17.24,0:15:20.87,Default,,0,0,0,,Жетеді! Жабу, жақын!
Dialogue: 0,0:15:23.25,0:15:24.29,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:15:24.38,0:15:26.96,Default,,0,0,0,,Неге қылышыңды суырмадың?
Dialogue: 0,0:15:27.05,0:15:29.38,Default,,0,0,0,,Дәрігерге жеткенше шыдамды болыңыз.
Dialogue: 0,0:15:29.47,0:15:30.76,Default,,0,0,0,,шайқастан барынша аулақ болуға тырысқанымызға қарамастан, әскеріміздің шамамен жиырма пайызын жоғалттық.
Dialogue: 0,0:15:30.84,0:15:34.18,Default,,0,0,0,,Оның денесі ұзақ болған жоқ.
Dialogue: 0,0:15:34.26,0:15:36.06,Default,,0,0,0,,Не айттың!
Dialogue: 0,0:15:36.14,0:15:39.81,Default,,0,0,0,,Керісінше... Мибуға барыңыз...
Dialogue: 0,0:15:39.89,0:15:41.98,Default,,0,0,0,,Мибу? Неліктен?
Dialogue: 0,0:15:42.06,0:15:43.81,Default,,0,0,0,,Жарайды, жүр.
Dialogue: 0,0:15:44.81,0:15:45.69,Default,,0,0,0,,Ах
Dialogue: 0,0:15:49.32,0:15:50.69,Default,,0,0,0,,Сайто мырза
Dialogue: 0,0:15:50.78,0:15:52.32,Default,,0,0,0,,Не болды!?
Dialogue: 0,0:15:52.40,0:15:55.16,Default,,0,0,0,,Кондо-кун, саған жақсы...
Dialogue: 0,0:15:55.24,0:15:57.45,Default,,0,0,0,,Маған көмектесіңізші, қарт өліп жатыр.
Dialogue: 0,0:15:58.58,0:16:02.00,Default,,0,0,0,,Мен тыңдайын, Кондо-кун.
Dialogue: 0,0:16:02.08,0:16:04.88,Default,,0,0,0,,Балалар, Киотоға не үшін келдіңдер?
Dialogue: 0,0:16:06.67,0:16:07.75,Default,,0,0,0,,Әлеуметтік реформа
Dialogue: 0,0:16:09.05,0:16:10.97,Default,,0,0,0,,Хэхехе... Уф
Dialogue: 0,0:16:11.05,0:16:12.76,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:16:12.84,0:16:14.97,Default,,0,0,0,,Қария, енді сөйлеме.
Dialogue: 0,0:16:15.05,0:16:16.22,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:16:16.30,0:16:18.81,Default,,0,0,0,,Өлме
Dialogue: 0,0:16:18.89,0:16:22.10,Default,,0,0,0,,Мен сені бұл кісіге сеніп тапсырғанша
Dialogue: 0,0:16:23.10,0:16:24.98,Default,,0,0,0,,Бұл менің балам.
Dialogue: 0,0:16:25.06,0:16:29.27,Default,,0,0,0,,Адам өзінен маңыздырақ нәрсеге қол жеткізгенде
Dialogue: 0,0:16:29.36,0:16:30.99,Default,,0,0,0,,Мен күшейетінімді білдім
Dialogue: 0,0:16:31.07,0:16:33.78,Default,,0,0,0,,Бұл өте айналма жол болды, бірақ...
Dialogue: 0,0:16:34.53,0:16:36.24,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:16:36.32,0:16:38.37,Default,,0,0,0,,Сен өмір сүргенше
Dialogue: 0,0:16:39.49,0:16:42.37,Default,,0,0,0,,Джиро, мықты бол
Dialogue: 0,0:16:45.21,0:16:46.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:48.21,0:16:49.42,Default,,0,0,0,,Сеніп тапсырылған
Dialogue: 0,0:16:50.50,0:16:54.63,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:16:56.39,0:16:58.26,Default,,0,0,0,,Ата-анамның қасында?
Dialogue: 0,0:16:59.18,0:17:01.22,Default,,0,0,0,,Ваппаның аты кім?
Dialogue: 0,0:17:02.31,0:17:03.48,Default,,0,0,0,,Кіріспе
Dialogue: 0,0:17:03.56,0:17:04.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:05.35,0:17:07.40,Default,,0,0,0,,Мен Хаджиме Сайтомын
Dialogue: 0,0:17:07.90,0:17:09.73,Default,,0,0,0,,Қарт әлсіз емес.
Dialogue: 0,0:17:10.61,0:17:12.74,Default,,0,0,0,,Мен оны дәлелдеймін.
Dialogue: 0,0:17:12.82,0:17:16.61,Default,,0,0,0,,Қарттың қылышын, жүрегін енші аламын.
Dialogue: 0,0:17:17.82,0:17:21.12,Default,,0,0,0,,Қасқыр сияқты.
Dialogue: 0,0:17:23.45,0:17:25.87,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:17:25.96,0:17:27.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:28.46,0:17:31.09,Default,,0,0,0,,Мен екінші ұрпақпын...
Dialogue: 0,0:17:31.17,0:17:32.88,Default,,0,0,0,,Хаджиме Сайто
Dialogue: 0,0:17:32.96,0:17:35.63,Default,,0,0,0,,Ақымақ, бұл өте улы.
Dialogue: 0,0:17:35.72,0:17:38.14,Default,,0,0,0,,Ол адам әлсіз емес.
Dialogue: 0,0:17:38.22,0:17:39.89,Default,,0,0,0,,Өлме
Dialogue: 0,0:17:39.97,0:17:42.64,Default,,0,0,0,,Мен тірі болғанша
Dialogue: 0,0:17:43.77,0:17:45.60,Default,,0,0,0,,Қарт өлді
Dialogue: 0,0:17:45.68,0:17:47.69,Default,,0,0,0,,Аурудан зардап шеккен
Dialogue: 0,0:17:47.77,0:17:51.61,Default,,0,0,0,,Ақтық шайқас Қарт әлсіз...
Dialogue: 0,0:17:52.23,0:17:55.07,Default,,0,0,0,,Жоқ, мен айттым.
Dialogue: 0,0:17:55.15,0:17:56.65,Default,,0,0,0,,«Мен айналма жолмен жүрдім»
Dialogue: 0,0:17:57.57,0:18:00.99,Default,,0,0,0,,Әрқашан «Мен әлсізмін» деп ойлаңыз
Dialogue: 0,0:18:01.07,0:18:04.37,Default,,0,0,0,,Бірақ сол күнгі қарт басқаша еді.
Dialogue: 0,0:18:05.41,0:18:06.66,Default,,0,0,0,,Бұл мен болуым керек.
Dialogue: 0,0:18:07.83,0:18:10.92,Default,,0,0,0,,Себебі мен біреуді кесіп алғанымды көргім келмеді.
Dialogue: 0,0:18:11.00,0:18:12.54,Default,,0,0,0,,Қылышты суырған жоқ
Dialogue: 0,0:18:13.71,0:18:16.01,Default,,0,0,0,,Өйткені қорғайтын адам болды
Dialogue: 0,0:18:16.09,0:18:19.72,Default,,0,0,0,,Күш дегеннің мәнін сол кездегі қария түсінген болар.
Dialogue: 0,0:18:21.76,0:18:24.22,Default,,0,0,0,,Оларды жіберсек, өлім болады.
Dialogue: 0,0:18:25.56,0:18:28.85,Default,,0,0,0,,Сіз тіпті танымайтын адамға көмектесу міндетті емес.
Dialogue: 0,0:18:28.94,0:18:30.90,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,0:18:30.98,0:18:31.98,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:18:32.77,0:18:35.61,Default,,0,0,0,,Аз ғана өмір сүру
Dialogue: 0,0:18:35.69,0:18:38.49,Default,,0,0,0,,Тіркеме сияқты нәрсе де ойнайды.
Dialogue: 0,0:18:39.66,0:18:40.49,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:43.16,0:18:45.24,Default,,0,0,0,,Мен жеңіле алмаймын
Dialogue: 0,0:18:46.25,0:18:48.75,Default,,0,0,0,,Iaido-ны орындау мүмкін емес.
Dialogue: 0,0:18:48.83,0:18:49.87,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:18:49.96,0:18:53.00,Default,,0,0,0,,Бірден есін жоғалту және өлім
Dialogue: 0,0:18:53.09,0:18:56.00,Default,,0,0,0,,Ешқандай күш шықпайды
Dialogue: 0,0:18:56.63,0:19:00.01,Default,,0,0,0,,Iai күш туралы емес, техника туралы.
Dialogue: 0,0:19:00.09,0:19:02.51,Default,,0,0,0,,Жұлдызшаның құйрығы сияқты
Dialogue: 0,0:19:03.26,0:19:06.68,Default,,0,0,0,,Қариядан үйрендім, Мыңдаған, мыңдаған долларды тастадым.
Dialogue: 0,0:19:06.77,0:19:08.52,Default,,0,0,0,,Бұл денеге ойылған
Dialogue: 0,0:19:09.56,0:19:13.27,Default,,0,0,0,,Тіпті бұл күйде де оған күмәндануға негіз жоқ.
Dialogue: 0,0:19:15.23,0:19:17.28,Default,,0,0,0,,Бұл тұр ма?
Dialogue: 0,0:19:17.36,0:19:19.90,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:19.99,0:19:21.61,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:19:23.16,0:19:24.32,Default,,0,0,0,,Құт
Dialogue: 0,0:19:24.41,0:19:27.33,Default,,0,0,0,,Мен сені жеңемін
Dialogue: 0,0:19:27.41,0:19:29.04,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:19:29.12,0:19:31.71,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:19:33.29,0:19:36.46,Default,,0,0,0,,Қарғыс атсын, жоқ, қозғалма.
Dialogue: 0,0:19:37.00,0:19:37.96,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:38.05,0:19:39.21,Default,,0,0,0,,Ах
Dialogue: 0,0:19:39.30,0:19:40.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:43.76,0:19:44.85,Default,,0,0,0,,Уф
Dialogue: 0,0:19:45.76,0:19:48.64,Default,,0,0,0,,- (Ниими) Кеттік - (Оқушы) Эй, эй!
Dialogue: 0,0:19:49.98,0:19:52.48,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:19:54.73,0:19:55.98,Default,,0,0,0,,Жарайды, болды.
Dialogue: 0,0:19:56.06,0:19:57.98,Default,,0,0,0,,Бұл антидот шығар.
Dialogue: 0,0:19:58.90,0:20:01.15,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:01.24,0:20:02.28,Default,,0,0,0,,Ішіңіз
Dialogue: 0,0:20:02.91,0:20:03.74,Default,,0,0,0,,(алғашқы жөтел)
Dialogue: 0,0:20:03.82,0:20:06.07,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:06.16,0:20:09.37,Default,,0,0,0,,Ойынға кедергі келтіргені өкінішті.
Dialogue: 0,0:20:09.45,0:20:10.41,Default,,0,0,0,,Хун
Dialogue: 0,0:20:11.25,0:20:13.62,Default,,0,0,0,,Жоқ, мен құтқарылдым.
Dialogue: 0,0:20:14.08,0:20:16.42,Default,,0,0,0,,У дегеніміз не? Мен оған сүріндім.
Dialogue: 0,0:20:17.13,0:20:19.17,Default,,0,0,0,,Бұл тән емес реакция.
Dialogue: 0,0:20:20.34,0:20:22.26,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:20:22.34,0:20:24.80,Default,,0,0,0,,Жарайды, әзірше осы.
Dialogue: 0,0:20:26.43,0:20:29.56,Default,,0,0,0,,Мен әлсізмін, мен жетпеймін
Dialogue: 0,0:20:29.64,0:20:31.85,Default,,0,0,0,,Жүрек және күш
Dialogue: 0,0:20:32.60,0:20:36.27,Default,,0,0,0,,Аға, мен мұны байқадым.
Dialogue: 0,0:20:36.36,0:20:37.56,Default,,0,0,0,,Күлесіз бе?
Dialogue: 0,0:20:38.15,0:20:41.82,Default,,0,0,0,,Адамдардың бәрі әлсіз. Ең бастысы...
Dialogue: 0,0:20:43.70,0:20:48.74,Default,,0,0,0,,Келесі сөздер қандай болды?
Dialogue: 0,0:20:51.91,0:20:56.25,Default,,0,0,0,,Мен де кіреберіске жеткендей болдым.
Dialogue: 0,0:21:00.92,0:21:04.55,Default,,0,0,0,,Сенің де себептерің бар екеніне сенімдімін.
Dialogue: 0,0:21:04.63,0:21:07.09,Default,,0,0,0,,Кез келген адам тірі бола алады.
Dialogue: 0,0:21:07.97,0:21:11.85,Default,,0,0,0,,Бірақ бұған қатысы жоқ адамдарды тартпаңыз.
Dialogue: 0,0:21:15.14,0:21:17.52,Default,,0,0,0,,Қала өртеніп жатқан жоқ.
Dialogue: 0,0:21:17.60,0:21:19.23,Default,,0,0,0,,Сіз оны қорғадыңыз.
Dialogue: 0,0:21:22.90,0:21:24.99,Default,,0,0,0,,Эй, ақымақ.
Dialogue: 0,0:21:25.61,0:21:27.11,Default,,0,0,0,,Үзіліс жасаңыз
Dialogue: 0,0:21:29.49,0:21:32.24,Default,,0,0,0,,Әй, қалғанын сұрадым.
Dialogue: 0,0:21:33.12,0:21:34.12,Default,,0,0,0,,Келгеніңе қуаныштымын.
Dialogue: 0,0:21:34.83,0:21:37.25,Default,,0,0,0,,Сен осында кел
Dialogue: 0,0:21:37.33,0:21:39.13,Default,,0,0,0,,Мен солай сезіндім.
Dialogue: 0,0:21:50.97,0:21:55.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:11.55,0:23:16.56,Default,,0,0,0,,～♪
Dialogue: 0,0:23:25.65,0:23:27.44,Default,,0,0,0,,Бұл Чиринуни.
Dialogue: 0,0:23:27.53,0:23:30.86,Default,,0,0,0,,Мен жүкті Наги-сан үшін уайымдап, Киохачиканға асығатынмын, бірақ...
Dialogue: 0,0:23:31.99,0:23:35.49,Default,,0,0,0,,Йотаро-сан, неге?
Dialogue: 0,0:23:35.58,0:23:37.74,Default,,0,0,0,,Өтінемін, қазір Наги-санның қасында болыңыз.
Dialogue: 0,0:23:39.37,0:23:42.33,Default,,0,0,0,,Кондо мырза, екеуің де тынышталыңдар.
Dialogue: 0,0:23:42.42,0:23:44.58,Default,,0,0,0,,Ол қылышты тартпа
Dialogue: 0,0:23:46.04,0:23:48.05,Default,,0,0,0,,Келесі жолы «Дайын бол»
Dialogue: 0,0:23:49.55,0:23:55.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
