Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.75,0:00:03.54,Default,,0,0,0,,Менің атым Таза
Dialogue: 0,0:00:03.62,0:00:06.42,Default,,0,0,0,,Жануарды аулайтындар самурай деп аталады
Dialogue: 0,0:00:06.50,0:00:08.17,Default,,0,0,0,,Жүр, қаруларыңды алыңдар!
Dialogue: 0,0:00:08.80,0:00:13.93,Default,,0,0,0,,Қызық, Шинпачи Нагакураның басы найзаны орнында ұстай ала ма?
Dialogue: 0,0:00:14.01,0:00:15.93,Default,,0,0,0,,Сізге сәттілік жетіспеді.
Dialogue: 0,0:00:16.01,0:00:17.68,Default,,0,0,0,,Қарғыс атсын, брат!
Dialogue: 0,0:00:19.26,0:00:21.31,Default,,0,0,0,,Мен Шинпачи сияқты тәтті емеспін.
Dialogue: 0,0:00:22.35,0:00:26.19,Default,,0,0,0,,Сіздің жағдайыңыз маңызды емес. Мен өлтіргенде, мен оны шынымен жасаймын.
Dialogue: 0,0:00:28.77,0:00:30.19,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:00:30.28,0:00:32.24,Default,,0,0,0,,Қылыш та жаман емес.
Dialogue: 0,0:00:32.32,0:00:35.24,Default,,0,0,0,,Өйткені, бұл маған көбірек жарасады.
Dialogue: 0,0:00:35.78,0:00:39.83,Default,,0,0,0,,Бізді қабылдамау мүмкін, бірақ Миброда бізде орын бар.
Dialogue: 0,0:00:40.33,0:00:41.58,Default,,0,0,0,,Сол әмияны—
Dialogue: 0,0:00:41.66,0:00:44.79,Default,,0,0,0,,Менің үйіме де келсең болды.
Dialogue: 0,0:00:47.42,0:00:48.29,Default,,0,0,0,,Иә
Dialogue: 0,0:00:48.79,0:00:49.96,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:00:50.05,0:00:52.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:55.55,0:00:57.55,Default,,0,0,0,,Хаха
Dialogue: 0,0:00:57.64,0:00:59.97,Default,,0,0,0,,Мен оны қартайған шығар деп ойладым.
Dialogue: 0,0:01:00.06,0:01:00.97,Default,,0,0,0,,Ха...
Dialogue: 0,0:01:04.52,0:01:06.23,Default,,0,0,0,,Пайдасыз
Dialogue: 0,0:01:10.11,0:01:11.98,Default,,0,0,0,,Қария! Мықты болыңыз!
Dialogue: 0,0:01:12.82,0:01:16.49,Default,,0,0,0,,Яша... Сен...
Dialogue: 0,0:01:16.57,0:01:18.99,Default,,0,0,0,,Қарғыс атсын... уф...
Dialogue: 0,0:01:20.41,0:01:21.83,Default,,0,0,0,,Саносуке
Dialogue: 0,0:01:22.37,0:01:23.91,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:01:24.58,0:01:29.92,Default,,0,0,0,,♪～
Dialogue: 0,0:02:47.83,0:02:52.83,Default,,0,0,0,,～♪
Dialogue: 0,0:02:58.51,0:02:59.38,Default,,0,0,0,,Мен көрдім
Dialogue: 0,0:02:59.47,0:03:01.89,Default,,0,0,0,,Бұл қақпада.
Dialogue: 0,0:03:01.97,0:03:03.14,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:03.68,0:03:04.89,Default,,0,0,0,,Қақпа ашық
Dialogue: 0,0:03:05.56,0:03:09.18,Default,,0,0,0,,Ой... Мен Курояға осылай жүгіруім керек сияқты.
Dialogue: 0,0:03:09.27,0:03:12.27,Default,,0,0,0,,Иә, Айзу халқынан қолдау сұраңыз!
Dialogue: 0,0:03:12.35,0:03:16.44,Default,,0,0,0,,Менің айтқандарыма сенбейсіз деп ойлаймын.
Dialogue: 0,0:03:16.52,0:03:18.82,Default,,0,0,0,,Өтінемін, бұл өзіңе байланысты, Таро.
Dialogue: 0,0:03:18.90,0:03:20.03,Default,,0,0,0,,Шулы
Dialogue: 0,0:03:20.11,0:03:22.49,Default,,0,0,0,,Қарғыс атсын! Мен жасаймын!
Dialogue: 0,0:03:22.57,0:03:25.41,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:03:27.87,0:03:30.79,Default,,0,0,0,,Наги-сан... аман болыңыз.
Dialogue: 0,0:03:39.96,0:03:40.80,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:42.88,0:03:44.80,Default,,0,0,0,,Таа! Ах...
Dialogue: 0,0:03:48.22,0:03:49.39,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:03:49.47,0:03:51.94,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:03:53.90,0:03:55.90,Default,,0,0,0,,Мен олардың бәрін ұрып-соқтым.
Dialogue: 0,0:03:55.98,0:03:57.48,Default,,0,0,0,,Тамаша жұмыс
Dialogue: 0,0:03:57.57,0:04:00.15,Default,,0,0,0,,Олай болса мұндағы бас менікі.
Dialogue: 0,0:04:03.78,0:04:04.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.74,0:04:07.99,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:04:08.08,0:04:10.79,Default,,0,0,0,,8 басшы және 7 көпір бар!
Dialogue: 0,0:04:10.87,0:04:12.66,Default,,0,0,0,,Маған бір адам керек!
Dialogue: 0,0:04:12.75,0:04:14.08,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:04:14.17,0:04:16.54,Default,,0,0,0,,Ол басқа жаққа кеткен жоқ па?
Dialogue: 0,0:04:16.63,0:04:18.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:23.51,0:04:26.14,Default,,0,0,0,,- (Таз) Уф... - (Харада) Жарайсың ба, қария!
Dialogue: 0,0:04:26.22,0:04:27.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:28.05,0:04:29.89,Default,,0,0,0,,Қария Сәлем!
Dialogue: 0,0:04:29.97,0:04:31.18,Default,,0,0,0,,Саносуке
Dialogue: 0,0:04:31.27,0:04:32.39,Default,,0,0,0,,Ах
Dialogue: 0,0:04:33.06,0:04:34.98,Default,,0,0,0,,Мен саған айтамын жолдан кет!
Dialogue: 0,0:04:39.69,0:04:40.53,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:41.86,0:04:42.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:45.82,0:04:47.41,Default,,0,0,0,,Қысқа қылыш?
Dialogue: 0,0:04:47.49,0:04:48.87,Default,,0,0,0,,Жоқ, бұл біртүрлі.
Dialogue: 0,0:04:48.95,0:04:51.24,Default,,0,0,0,,Сөзсіз ауқымнан шығып кеткен болуы керек
Dialogue: 0,0:04:52.12,0:04:54.46,Default,,0,0,0,,Ұзын семсер де кеспейді
Dialogue: 0,0:04:55.83,0:04:57.58,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:04:58.08,0:04:59.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:59.59,0:05:03.01,Default,,0,0,0,,Мибу Рошигуми Нагакура Шинпачи
Dialogue: 0,0:05:03.09,0:05:04.51,Default,,0,0,0,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,0:05:06.72,0:05:07.76,Default,,0,0,0,,Иә
Dialogue: 0,0:05:07.84,0:05:10.76,Default,,0,0,0,,Не? Сіз дуэль өткізуді жоспарлап отырсыз ба?
Dialogue: 0,0:05:22.53,0:05:23.36,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:05:23.44,0:05:24.61,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:05:25.82,0:05:26.70,Default,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:05:27.91,0:05:29.20,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:05:29.99,0:05:32.04,Default,,0,0,0,,Асықпасаңыз, соққы аласыз.
Dialogue: 0,0:05:33.49,0:05:35.12,Default,,0,0,0,,Самурай ретінде
Dialogue: 0,0:05:35.20,0:05:38.71,Default,,0,0,0,,Мен самурай болып өмір сүретініме күмәнданбадым.
Dialogue: 0,0:05:39.71,0:05:42.09,Default,,0,0,0,,Мацумэ руының Эдо үйлері
Dialogue: 0,0:05:42.17,0:05:45.09,Default,,0,0,0,,Канджи Нагакураның екінші ұлы болып дүниеге келген
Dialogue: 0,0:05:45.17,0:05:48.22,Default,,0,0,0,,Мен Эдода ыңғайсыздықсыз өстім.
Dialogue: 0,0:05:48.30,0:05:51.22,Default,,0,0,0,,О, Нагакура мырзасы.
Dialogue: 0,0:05:51.93,0:05:54.72,Default,,0,0,0,,Расымен де, жүзіңіз әдемі екен.
Dialogue: 0,0:05:54.81,0:05:57.56,Default,,0,0,0,,Бұл әсерлі көрсеткіш.
Dialogue: 0,0:05:57.64,0:06:00.23,Default,,0,0,0,,Ол байсалды, әдепті сияқты.
Dialogue: 0,0:06:00.31,0:06:02.23,Default,,0,0,0,,Бұл самурай.
Dialogue: 0,0:06:02.77,0:06:06.15,Default,,0,0,0,,Мен оқуға онша құмар емес едім, бірақ
Dialogue: 0,0:06:06.24,0:06:08.24,Default,,0,0,0,,Тек қылыш басқаша болды.
Dialogue: 0,0:06:08.70,0:06:11.99,Default,,0,0,0,,Синто Мунен-рюге толық лицензия не болды?
Dialogue: 0,0:06:12.08,0:06:14.24,Default,,0,0,0,,18
Dialogue: 0,0:06:14.83,0:06:20.50,Default,,0,0,0,,Мен жай ғана күш іздедім және жауынгерлік жаттығуларымда бір догжодан екіншісіне саяхат жасадым.
Dialogue: 0,0:06:21.33,0:06:23.88,Default,,0,0,0,,Шиейкандағы Кондомен кездесу
Dialogue: 0,0:06:23.96,0:06:26.96,Default,,0,0,0,,Мен демалып, айналып өткенше...
Dialogue: 0,0:06:28.93,0:06:31.76,Default,,0,0,0,,Семсерші ретінде патша жолы, былайша айтқанда.
Dialogue: 0,0:06:33.47,0:06:36.39,Default,,0,0,0,,Ешбір ойланбастан, ойланбастан
Dialogue: 0,0:06:36.47,0:06:38.64,Default,,0,0,0,,Жай ғана
Dialogue: 0,0:06:39.48,0:06:42.48,Default,,0,0,0,,Мен қылыштың жолын жалғастырдым.
Dialogue: 0,0:06:50.07,0:06:50.91,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:06:51.74,0:06:54.16,Default,,0,0,0,,мәңгі
Dialogue: 0,0:06:54.95,0:06:57.91,Default,,0,0,0,,Hikyou? Хаха білмеймін
Dialogue: 0,0:06:58.58,0:07:01.83,Default,,0,0,0,,Менің ескі досымды өлтіру не үшін қажет болды?
Dialogue: 0,0:07:01.92,0:07:04.59,Default,,0,0,0,,Бұл да арттан күтпеген шабуыл.
Dialogue: 0,0:07:04.67,0:07:06.17,Default,,0,0,0,,Ащы
Dialogue: 0,0:07:06.25,0:07:10.09,Default,,0,0,0,,Әлсіз өледі, күшті тірі қалады.
Dialogue: 0,0:07:10.17,0:07:12.18,Default,,0,0,0,,Самурайдың логикасы солай
Dialogue: 0,0:07:14.10,0:07:15.18,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:15.76,0:07:18.22,Default,,0,0,0,,Онда сен осы жерде өлесің.
Dialogue: 0,0:07:18.31,0:07:19.60,Default,,0,0,0,,Бұл шындық
Dialogue: 0,0:07:20.69,0:07:23.48,Default,,0,0,0,,Жоқ... (ит жөтелі)
Dialogue: 0,0:07:23.56,0:07:25.36,Default,,0,0,0,,Ата, жақсысыз ба?
Dialogue: 0,0:07:25.44,0:07:27.86,Default,,0,0,0,,Я... Оның техникасы...
Dialogue: 0,0:07:27.94,0:07:29.86,Default,,0,0,0,,Сәлем! Сізге сөйлесудің қажеті жоқ
Dialogue: 0,0:07:29.94,0:07:32.24,Default,,0,0,0,,Оның техникасы
Dialogue: 0,0:07:32.32,0:07:35.37,Default,,0,0,0,,Яшаның орағы сияқты Иайдо
Dialogue: 0,0:07:35.45,0:07:38.41,Default,,0,0,0,,Олар сіздің уақытыңызды алуына жол бермеңіз...
Dialogue: 0,0:07:38.49,0:07:39.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:43.92,0:07:45.38,Default,,0,0,0,,Маған қазір өлуге рұқсат етіңіз
Dialogue: 0,0:07:46.46,0:07:48.09,Default,,0,0,0,,- (Харада) Шинпачи! -(Нагакура) Иә?
Dialogue: 0,0:07:49.55,0:07:52.51,Default,,0,0,0,,Бұл сіздің қызметшілеріңіздің ұзын қылыштары. Оны қолданыңыз!
Dialogue: 0,0:07:53.05,0:07:54.26,Default,,0,0,0,,Иә
Dialogue: 0,0:08:05.86,0:08:08.69,Default,,0,0,0,,Отбасыма…
Dialogue: 0,0:08:10.90,0:08:15.78,Default,,0,0,0,,Қылыш оның иесінің шынайы болмысын көрсетеді.
Dialogue: 0,0:08:15.87,0:08:17.66,Default,,0,0,0,,Жеңіл
Dialogue: 0,0:08:18.37,0:08:20.04,Default,,0,0,0,,Иілгіш
Dialogue: 0,0:08:22.12,0:08:27.50,Default,,0,0,0,,Аспанда ұшқан құстай жеңіл, еркін
Dialogue: 0,0:08:28.88,0:08:30.05,Default,,0,0,0,,Дәл…
Dialogue: 0,0:08:40.14,0:08:41.39,Default,,0,0,0,,Хиен
Dialogue: 0,0:08:50.40,0:08:53.11,Default,,0,0,0,,Хаха, түсіндім.
Dialogue: 0,0:08:53.74,0:08:55.78,Default,,0,0,0,,Өте жаман... (Қан құсу дыбысы)
Dialogue: 0,0:08:55.86,0:08:57.57,Default,,0,0,0,,Сіз жеңдіңіз...
Dialogue: 0,0:09:03.62,0:09:06.08,Default,,0,0,0,,Осындай самурай...
Dialogue: 0,0:09:06.87,0:09:10.13,Default,,0,0,0,,Самурай болған
Dialogue: 0,0:09:16.05,0:09:18.55,Default,,0,0,0,,Ол қайтыс болды, қария.
Dialogue: 0,0:09:24.31,0:09:27.48,Default,,0,0,0,,Сіз керемет самурайсыз.
Dialogue: 0,0:09:30.69,0:09:32.48,Default,,0,0,0,,Мен сені кейін жоқтаймын.
Dialogue: 0,0:09:32.57,0:09:34.03,Default,,0,0,0,,Саносуке
Dialogue: 0,0:09:41.08,0:09:44.00,Default,,0,0,0,,Қош келдің, бұл тағдырдың көпірі.
Dialogue: 0,0:09:45.08,0:09:46.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.12,0:09:49.75,Default,,0,0,0,,Тағдыр көпірі?
Dialogue: 0,0:09:49.83,0:09:53.00,Default,,0,0,0,,Иә, бұл сіздің тағдырыңызды шешетін көпір.
Dialogue: 0,0:09:53.59,0:09:55.42,Default,,0,0,0,,Бізбен бірге жүресіз бе?
Dialogue: 0,0:09:55.51,0:09:58.01,Default,,0,0,0,,Әлде өміріңізді белгісіздікпен аяқтайсыз ба?
Dialogue: 0,0:09:58.59,0:09:59.80,Default,,0,0,0,,Шулы
Dialogue: 0,0:10:01.10,0:10:02.81,Default,,0,0,0,,-(Ынталандыру) Бар -(Студент) А?
Dialogue: 0,0:10:03.64,0:10:04.52,Default,,0,0,0,,Бару
Dialogue: 0,0:10:04.60,0:10:05.52,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:10:06.23,0:10:07.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:12.27,0:10:13.90,Default,,0,0,0,,Уууу!
Dialogue: 0,0:10:15.07,0:10:15.90,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:16.90,0:10:18.90,Default,,0,0,0,,Уау... қандай күшті!
Dialogue: 0,0:10:18.99,0:10:21.03,Default,,0,0,0,,- (Хиджиката) Хмм - (Оқушы) Уау.
Dialogue: 0,0:10:22.62,0:10:23.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:24.79,0:10:26.08,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:10:27.58,0:10:29.75,Default,,0,0,0,,Тосизо Хиджиката
Dialogue: 0,0:10:29.83,0:10:34.34,Default,,0,0,0,,Мен оны жақсы танымаймын, өйткені ол әдетте Серизава мырзаның соңынан ереді.
Dialogue: 0,0:10:35.71,0:10:37.34,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:10:37.92,0:10:40.34,Default,,0,0,0,,Ешқашан қылыш ұстамаңыз
Dialogue: 0,0:10:40.43,0:10:43.60,Default,,0,0,0,,Бір... Күшті! және мейірімділік жоқ
Dialogue: 0,0:10:43.68,0:10:47.10,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:10:48.14,0:10:49.35,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:10:50.94,0:10:55.36,Default,,0,0,0,,Бірақ сойыл сияқты дөрекі ұстамаңыз.
Dialogue: 0,0:10:55.44,0:10:56.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:56.69,0:11:01.03,Default,,0,0,0,,Пышақ тез бұзылып немесе майысып, оны жарамсыз етеді.
Dialogue: 0,0:11:03.82,0:11:06.12,Default,,0,0,0,,Түсіндің бе? Бұл «Канеи»
Dialogue: 0,0:11:06.20,0:11:09.91,Default,,0,0,0,,Бұл жылтырлық, осы жарықтық және терең пышақ үлгісі
Dialogue: 0,0:11:10.00,0:11:12.12,Default,,0,0,0,,Көрерменді қызықтыру
Dialogue: 0,0:11:12.21,0:11:16.38,Default,,0,0,0,,Камакураның соңғы кезеңінде жасалған асыл тас.
Dialogue: 0,0:11:16.46,0:11:18.88,Default,,0,0,0,,Сенің қылышың қандай?
Dialogue: 0,0:11:18.96,0:11:20.80,Default,,0,0,0,,Бұл қалыпты көрінеді, бірақ
Dialogue: 0,0:11:21.43,0:11:22.39,Default,,0,0,0,,Жазу дегеніміз не?
Dialogue: 0,0:11:24.72,0:11:26.97,Default,,0,0,0,,Анонимді әйел жасаған
Dialogue: 0,0:11:27.47,0:11:30.48,Default,,0,0,0,,Жазу мынау... Дұрыс.
Dialogue: 0,0:11:30.56,0:11:32.65,Default,,0,0,0,,Оны «анонимді» деп атаймыз
Dialogue: 0,0:11:35.56,0:11:37.27,Default,,0,0,0,,Тақырыпты өзгертеміз бе?
Dialogue: 0,0:11:37.36,0:11:39.65,Default,,0,0,0,,Маған байланыстарыңыз туралы айтып бере аласыз ба?
Dialogue: 0,0:11:39.74,0:11:41.74,Default,,0,0,0,,Адам... Импульс?
Dialogue: 0,0:11:41.82,0:11:43.20,Default,,0,0,0,,Мен сені білемін.
Dialogue: 0,0:11:43.28,0:11:46.78,Default,,0,0,0,,Танымал адамдармен қаншалықты байланыстысыз?
Dialogue: 0,0:11:46.87,0:11:49.66,Default,,0,0,0,,Желілер Бұл адамның құндылығы
Dialogue: 0,0:11:50.25,0:11:53.00,Default,,0,0,0,,Сіз Джентаро Огакуды білесіз, солай ма?
Dialogue: 0,0:11:53.08,0:11:55.46,Default,,0,0,0,,Мен онымен кесе бөлісемін
Dialogue: 0,0:11:55.54,0:11:58.92,Default,,0,0,0,,Бір кездері біз өгей ағайындар, былайша айтқанда.
Dialogue: 0,0:11:59.55,0:12:01.17,Default,,0,0,0,,-(Хиджиката) Білмеймін -(Ынталандыру) Ха!
Dialogue: 0,0:12:01.26,0:12:02.59,Default,,0,0,0,,Білмейсіз бе?
Dialogue: 0,0:12:02.68,0:12:06.18,Default,,0,0,0,,Сіз Чошу феодалының атақты ұстазы Гентаро Дараку туралы білмейсіз бе?
Dialogue: 0,0:12:06.26,0:12:08.97,Default,,0,0,0,,Қазір әлемнің патриоты деп аталды
Dialogue: 0,0:12:09.06,0:12:11.73,Default,,0,0,0,,Бұл Тенчу-буки Сусаб қастандық дәуірін тудырды.
Dialogue: 0,0:12:11.81,0:12:13.73,Default,,0,0,0,,Бұл Джентаро Дайраку.
Dialogue: 0,0:12:14.27,0:12:15.69,Default,,0,0,0,,Мен оның кім екенін білмеймін
Dialogue: 0,0:12:17.27,0:12:20.23,Default,,0,0,0,,Жоқ, солай болуы мүмкін.
Dialogue: 0,0:12:20.32,0:12:22.24,Default,,0,0,0,,Саған басқа ат бере аламын ба?
Dialogue: 0,0:12:22.86,0:12:26.95,Default,,0,0,0,,Чошу байланыстары туралы айтатын болсақ, Катсура Когоро ше?
Dialogue: 0,0:12:27.03,0:12:28.12,Default,,0,0,0,,Катсура?
Dialogue: 0,0:12:28.20,0:12:30.83,Default,,0,0,0,,Бірде мен онымен ұрысып қалдым.
Dialogue: 0,0:12:31.50,0:12:33.29,Default,,0,0,0,,Немесе Кусака-доно
Dialogue: 0,0:12:33.37,0:12:35.83,Default,,0,0,0,,Мен онымен бірге шомылатынмын.
Dialogue: 0,0:12:37.00,0:12:41.34,Default,,0,0,0,,Тоса доменінде мен Такеичи Мизузаннан да өттім.
Dialogue: 0,0:12:41.96,0:12:45.72,Default,,0,0,0,,Мен бірде Сацумадағы үлкен есім Сайгоды көрдім.
Dialogue: 0,0:12:48.10,0:12:49.72,Default,,0,0,0,,Барлығы бірдей біле бермейді!
Dialogue: 0,0:12:49.81,0:12:51.77,Default,,0,0,0,,Не!?
Dialogue: 0,0:12:52.85,0:12:53.73,Default,,0,0,0,,Білімсіз…
Dialogue: 0,0:12:53.81,0:12:57.86,Default,,0,0,0,,Немесе… Катсура Когоро да Эдо бұрғылау залында танымал болған…
Dialogue: 0,0:12:57.94,0:12:59.73,Default,,0,0,0,,Білмеймін, маған қызық емес.
Dialogue: 0,0:13:02.40,0:13:03.24,Default,,0,0,0,,Қышу
Dialogue: 0,0:13:03.32,0:13:04.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:04.90,0:13:07.49,Default,,0,0,0,,Қышыма Қышыма Қышыма
Dialogue: 0,0:13:07.57,0:13:12.08,Default,,0,0,0,,Әңгімелескенімізде одан бетер қыши бастады.
Dialogue: 0,0:13:14.00,0:13:16.00,Default,,0,0,0,,Жетеді, кес
Dialogue: 0,0:13:16.58,0:13:18.00,Default,,0,0,0,,Я...
Dialogue: 0,0:13:18.08,0:13:20.84,Default,,0,0,0,,Аты-жөніңізді қалдырмайсыз.
Dialogue: 0,0:13:20.92,0:13:23.01,Default,,0,0,0,,Мен оны түсінбеймін.
Dialogue: 0,0:13:23.59,0:13:25.51,Default,,0,0,0,,Шулы тәртіпсіздік
Dialogue: 0,0:13:25.59,0:13:27.80,Default,,0,0,0,,Бұл көтеріліс сәтті болса...
Dialogue: 0,0:13:27.89,0:13:30.72,Default,,0,0,0,,Жоқ, айтпасаң да әбігер болады.
Dialogue: 0,0:13:30.80,0:13:32.77,Default,,0,0,0,,Рисшиданның аты бірден көтеріледі.
Dialogue: 0,0:13:33.52,0:13:35.02,Default,,0,0,0,,Сол жерден
Dialogue: 0,0:13:35.10,0:13:38.27,Default,,0,0,0,,Кек оты жағылса, ол ешқашан сөнбейді.
Dialogue: 0,0:13:38.35,0:13:42.40,Default,,0,0,0,,Тоса, Сацума және Чошуға сіңіп, қобалжыды.
Dialogue: 0,0:13:42.48,0:13:44.40,Default,,0,0,0,,Біз міндетті түрде уақытты өзгертеміз!
Dialogue: 0,0:13:44.49,0:13:46.11,Default,,0,0,0,,Иә! Менің атым...
Dialogue: 0,0:13:46.20,0:13:48.03,Default,,0,0,0,,(Хиджиката шұңқыры)
Dialogue: 0,0:13:48.70,0:13:50.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:50.12,0:13:52.03,Default,,0,0,0,,Бұл өте қызық болды.
Dialogue: 0,0:13:55.25,0:13:58.54,Default,,0,0,0,,Не, сіздің атыңыз да жоқ па?
Dialogue: 0,0:14:02.13,0:14:04.34,Default,,0,0,0,,Бля, сен тек сөйлейсің.
Dialogue: 0,0:14:06.84,0:14:08.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:11.22,0:14:12.51,Default,,0,0,0,,Ах
Dialogue: 0,0:14:13.89,0:14:15.27,Default,,0,0,0,,Авдол мен басқалар… келе жатыр…
Dialogue: 0,0:14:15.35,0:14:18.02,Default,,0,0,0,,Сіз мұның бәрі әңгіме деп ойладыңыз ба?
Dialogue: 0,0:14:18.10,0:14:21.02,Default,,0,0,0,,Сенің жағың жақсы болмаса, адамдар саған ермейді.
Dialogue: 0,0:14:21.11,0:14:23.11,Default,,0,0,0,,Синто Мунен-рю
Dialogue: 0,0:14:23.19,0:14:24.86,Default,,0,0,0,,Хокушин Итто-рю
Dialogue: 0,0:14:24.94,0:14:26.99,Default,,0,0,0,,Кагамишин Акечи-рю
Dialogue: 0,0:14:27.07,0:14:29.53,Default,,0,0,0,,Дыбыста естігендерің көбіне тістеу.
Dialogue: 0,0:14:32.62,0:14:35.54,Default,,0,0,0,,Ал... бұл жаман. Бұл жігіт күшті.
Dialogue: 0,0:14:35.62,0:14:37.08,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:14:37.16,0:14:40.54,Default,,0,0,0,,Көп нәрсеге қолыңнан келгенше есімдерге неліктен мән бересің?
Dialogue: 0,0:14:41.21,0:14:43.04,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:14:44.17,0:14:45.46,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:14:45.55,0:14:46.80,Default,,0,0,0,,Ештеңе.
Dialogue: 0,0:14:47.46,0:14:50.88,Default,,0,0,0,,Әр нәрсенің себебі бар болғандықтан әрекет етеміз деп шешу
Dialogue: 0,0:14:50.97,0:14:52.80,Default,,0,0,0,,Сіздің таяздығыңыз.
Dialogue: 0,0:14:53.89,0:14:55.10,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:14:55.18,0:14:56.81,Default,,0,0,0,,Сізге бір кеңес айтайын.
Dialogue: 0,0:14:57.68,0:15:00.35,Default,,0,0,0,,Аяқ бағыты Көздің бағыты
Dialogue: 0,0:15:00.44,0:15:04.82,Default,,0,0,0,,Сіз сәл оңға қарай еңкейесіз, бірақ қылыш сызықтарыңызды түсіну өте оңай.
Dialogue: 0,0:15:09.99,0:15:11.91,Default,,0,0,0,,Бұл қашан болды?
Dialogue: 0,0:15:11.99,0:15:14.07,Default,,0,0,0,,Сирек кездесетін қарлығаш пайда болды.
Dialogue: 0,0:15:14.87,0:15:17.33,Default,,0,0,0,,Мені екі-үш таудан асып қу
Dialogue: 0,0:15:17.41,0:15:20.08,Default,,0,0,0,,Әпкем мені жиі сөгетін.
Dialogue: 0,0:15:20.83,0:15:23.33,Default,,0,0,0,,Сізге рахмет, менің біртүрлі лақап атым бар.
Dialogue: 0,0:15:28.34,0:15:29.97,Default,,0,0,0,,- (Хиджиката) Ониаши - (Ынталандыру) Ха...
Dialogue: 0,0:15:30.05,0:15:31.09,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:15:31.18,0:15:35.10,Default,,0,0,0,,Қылыш шеберлігі дойдомен ғана шектеледі деп ойламағаныңыз абзал.
Dialogue: 0,0:15:36.76,0:15:37.60,Default,,0,0,0,,Ах
Dialogue: 0,0:15:39.18,0:15:40.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:42.44,0:15:43.85,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:15:44.44,0:15:45.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:46.40,0:15:47.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:48.94,0:15:51.24,Default,,0,0,0,,Ku… Желілік пошта?
Dialogue: 0,0:15:52.32,0:15:53.74,Default,,0,0,0,,Цк
Dialogue: 0,0:15:53.82,0:15:55.24,Default,,0,0,0,,(бамбук қылыштың дыбысы)
Dialogue: 0,0:15:56.49,0:15:57.74,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:01.71,0:16:03.25,Default,,0,0,0,,- (Хиджиката) Қарғыс атсын - (Кондо) Тоши
Dialogue: 0,0:16:04.12,0:16:06.25,Default,,0,0,0,,Сенің қылышыңды түсіну өте оңай.
Dialogue: 0,0:16:07.96,0:16:10.01,Default,,0,0,0,,Иә, тоқтат, тоқта!
Dialogue: 0,0:16:13.47,0:16:17.26,Default,,0,0,0,,Менде талант жоқ, балалар, сендерге қарап айта аламын.
Dialogue: 0,0:16:18.64,0:16:21.27,Default,,0,0,0,,Бұл оңай өзгермейді.
Dialogue: 0,0:16:21.85,0:16:26.77,Default,,0,0,0,,Есірткі сатып жүріп, анда-санда төбелесіп жүрген дұрыс.
Dialogue: 0,0:16:26.86,0:16:28.77,Default,,0,0,0,,Мұң басылады.
Dialogue: 0,0:16:29.40,0:16:31.28,Default,,0,0,0,,- (Кондо) Тоши, бұл дұрыс емес - (Хиджиката) Иә?
Dialogue: 0,0:16:31.94,0:16:36.03,Default,,0,0,0,,Ұстау сізге оралғандай жұмсақ болуы керек.
Dialogue: 0,0:16:36.62,0:16:38.28,Default,,0,0,0,,- (Окита) Жақында өлемін - (Хиджиката) А?
Dialogue: 0,0:16:38.37,0:16:41.29,Default,,0,0,0,,Мен мұны істесем, олар маған назар аударады деп ойлаймын.
Dialogue: 0,0:16:41.37,0:16:43.79,Default,,0,0,0,,Аузыңды жап, Соудзи!
Dialogue: 0,0:16:43.87,0:16:46.54,Default,,0,0,0,,Бұл рух жақсы емес пе?
Dialogue: 0,0:16:46.63,0:16:49.04,Default,,0,0,0,,Шу, мен түсінемін.
Dialogue: 0,0:16:49.13,0:16:52.05,Default,,0,0,0,,Бірақ мен не істеуім керек?
Dialogue: 0,0:16:52.13,0:16:53.72,Default,,0,0,0,,Мен қалай күшті бола аламын?
Dialogue: 0,0:16:53.80,0:16:55.18,Default,,0,0,0,,Дереу сұраңыз
Dialogue: 0,0:16:55.26,0:16:57.72,Default,,0,0,0,,Егер мен мұны істесем, сіз маған айта аласыз деп ойлаймын.
Dialogue: 0,0:16:57.80,0:16:58.93,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:59.51,0:17:00.35,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:00.43,0:17:03.18,Default,,0,0,0,,Тоши, сен жеткілікті күштісің.
Dialogue: 0,0:17:03.27,0:17:05.85,Default,,0,0,0,,Мен ешқашан жеке жекпе-жектен жеңілген емеспін.
Dialogue: 0,0:17:05.94,0:17:07.44,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:17:08.19,0:17:11.48,Default,,0,0,0,,Теннен Ришин-рюден кейін ештеңе жоқ.
Dialogue: 0,0:17:11.57,0:17:14.70,Default,,0,0,0,,Осындай күресудің басқа да жолдары бар екенін біліңіз.
Dialogue: 0,0:17:15.36,0:17:17.61,Default,,0,0,0,,Сіз мұны өзіңіз жасай аласыз.
Dialogue: 0,0:17:17.70,0:17:19.62,Default,,0,0,0,,Хиджиката стилі жақсы, солай ма?
Dialogue: 0,0:17:21.54,0:17:23.83,Default,,0,0,0,,Басқаша айтқанда, анонимді стиль
Dialogue: 0,0:17:25.00,0:17:26.71,Default,,0,0,0,,Жоқ, Хиджиката-сан!
Dialogue: 0,0:17:27.29,0:17:29.71,Default,,0,0,0,,Оны шығарып, қайта құрастырыңыз...
Dialogue: 0,0:17:29.79,0:17:31.46,Default,,0,0,0,,Енді кеш қалды.
Dialogue: 0,0:17:31.55,0:17:33.21,Default,,0,0,0,,Анонимді түрде ұйықтаңыз!
Dialogue: 0,0:17:36.88,0:17:38.47,Default,,0,0,0,,Бұл жұмыс істемейтінін айтады
Dialogue: 0,0:17:40.51,0:17:44.22,Default,,0,0,0,,Тоши, сенің бірінші қылышыңды түсіну оңай.
Dialogue: 0,0:17:46.31,0:17:49.35,Default,,0,0,0,,Бұл маған оны қайтаруымды сұрау сияқты.
Dialogue: 0,0:17:49.98,0:17:52.23,Default,,0,0,0,,Мен сізге оқып жатқанымды айттым.
Dialogue: 0,0:17:53.57,0:17:55.61,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:17:55.69,0:17:57.36,Default,,0,0,0,,Иә, бұл оңай.
Dialogue: 0,0:17:57.99,0:17:59.99,Default,,0,0,0,,Бұған дейін екінші жебені атыңыз.
Dialogue: 0,0:18:01.83,0:18:02.74,Default,,0,0,0,,Не!?
Dialogue: 0,0:18:03.58,0:18:04.50,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,0:18:04.58,0:18:07.25,Default,,0,0,0,,Үшінші көрсеткі Төртінші көрсеткі
Dialogue: 0,0:18:09.92,0:18:10.75,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:10.83,0:18:12.75,Default,,0,0,0,,- (Хиджиката) Куу - (Игілеу) Арғх
Dialogue: 0,0:18:12.84,0:18:15.17,Default,,0,0,0,,Жабайы соққыдан кейін дұрыс емес соққы
Dialogue: 0,0:18:15.26,0:18:18.01,Default,,0,0,0,,Сіздің турбулентті табиғатыңыз үшін қолайлы
Dialogue: 0,0:18:18.09,0:18:20.43,Default,,0,0,0,,Бұл Хиджиката стилі
Dialogue: 0,0:18:20.51,0:18:23.89,Default,,0,0,0,,О, ау! Ха!
Dialogue: 0,0:18:24.47,0:18:25.47,Default,,0,0,0,,Уф
Dialogue: 0,0:18:27.77,0:18:28.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:29.73,0:18:31.36,Default,,0,0,0,,Қара бұлт сияқты
Dialogue: 0,0:18:31.44,0:18:32.90,Default,,0,0,0,,Бұзық емес пе?
Dialogue: 0,0:18:32.98,0:18:34.40,Default,,0,0,0,,Кондо мырза
Dialogue: 0,0:18:35.23,0:18:36.15,Default,,0,0,0,,Хун
Dialogue: 0,0:18:36.24,0:18:37.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:37.69,0:18:40.16,Default,,0,0,0,,Сіз оны жаңа ғана тептіңіз бе? Сіз мұны қалай жасадыңыз?
Dialogue: 0,0:18:40.24,0:18:43.33,Default,,0,0,0,,Түбі жоқ сараңдық пен еңбекқорлық
Dialogue: 0,0:18:43.41,0:18:45.24,Default,,0,0,0,,Және кішіпейілділік
Dialogue: 0,0:18:45.33,0:18:47.12,Default,,0,0,0,,Дүние дүние болса, даймио
Dialogue: 0,0:18:47.20,0:18:51.04,Default,,0,0,0,,Мүмкін сен де осы дүниеде атыңды қалдырарсың.
Dialogue: 0,0:18:53.71,0:18:55.55,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:18:55.63,0:18:57.63,Default,,0,0,0,,Сізге тағы да соққы болды ма?
Dialogue: 0,0:18:57.71,0:19:01.59,Default,,0,0,0,,Соуджидің жігіті бір күні кенеттен өмірге келді.
Dialogue: 0,0:19:02.09,0:19:03.93,Default,,0,0,0,,Бірақ Теме данышпан.
Dialogue: 0,0:19:04.01,0:19:06.77,Default,,0,0,0,,Айтпақшы, мен жаңа әдістеме жасадым.
Dialogue: 0,0:19:06.85,0:19:08.06,Default,,0,0,0,,Қарап жібере аласыз ба?
Dialogue: 0,0:19:08.68,0:19:11.02,Default,,0,0,0,,Жаңа мектеп құру керек пе?
Dialogue: 0,0:19:11.10,0:19:14.94,Default,,0,0,0,,Немесе одан да үлкен гүлдер гүлдейді.
Dialogue: 0,0:19:15.44,0:19:17.57,Default,,0,0,0,,Мен оны тағатсыздана күтемін.
Dialogue: 0,0:19:18.40,0:19:20.03,Default,,0,0,0,,Сонда мен ше?
Dialogue: 0,0:19:20.70,0:19:22.45,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:19:22.53,0:19:24.53,Default,,0,0,0,,Қаншалықты қарқынды...
Dialogue: 0,0:19:25.03,0:19:27.24,Default,,0,0,0,,Қарғыс атсын мына жігітті
Dialogue: 0,0:19:27.33,0:19:29.20,Default,,0,0,0,,Сіз қанша уақыт тербелесіз?
Dialogue: 0,0:19:31.29,0:19:35.38,Default,,0,0,0,,Жеңіл және ыңғайлы, бірақ берік
Dialogue: 0,0:19:36.46,0:19:38.71,Default,,0,0,0,,Төгілген пышақ? Сынған пышақ?
Dialogue: 0,0:19:39.46,0:19:40.80,Default,,0,0,0,,Маңызды емес!
Dialogue: 0,0:19:42.30,0:19:43.43,Default,,0,0,0,,Сакура
Dialogue: 0,0:19:44.80,0:19:47.68,Default,,0,0,0,,Ей, сен данышпансың.
Dialogue: 0,0:19:50.89,0:19:51.89,Default,,0,0,0,,Ах
Dialogue: 0,0:19:57.19,0:19:59.40,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:19:59.48,0:20:02.86,Default,,0,0,0,,Менің айналама көптеген таңғажайып адамдар жиналады.
Dialogue: 0,0:20:02.95,0:20:06.41,Default,,0,0,0,,Ал... күтіңіз, дұрыс, тыңдайық.
Dialogue: 0,0:20:06.49,0:20:07.87,Default,,0,0,0,,Алдымен сіздің атыңыз...
Dialogue: 0,0:20:08.74,0:20:11.12,Default,,0,0,0,,Аты-жөніңізді қалдыру өз еркіңізде.
Dialogue: 0,0:20:11.71,0:20:12.87,Default,,0,0,0,,Мен емес
Dialogue: 0,0:20:14.17,0:20:16.13,Default,,0,0,0,,Мен топырақ адаммын
Dialogue: 0,0:20:16.96,0:20:20.01,Default,,0,0,0,,Бұл ел, осы топырақ
Dialogue: 0,0:20:21.26,0:20:23.72,Default,,0,0,0,,Біреудің жемісін беруі үшін
Dialogue: 0,0:20:23.80,0:20:26.01,Default,,0,0,0,,Бір дән бидай жеткілікті.
Dialogue: 0,0:20:28.14,0:20:29.10,Default,,0,0,0,,Уф
Dialogue: 0,0:20:29.64,0:20:31.39,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:20:31.48,0:20:33.06,Default,,0,0,0,,Менің атым!
Dialogue: 0,0:20:35.65,0:20:36.48,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:37.06,0:20:37.90,Default,,0,0,0,,Бейне
Dialogue: 0,0:20:41.99,0:20:43.15,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:20:43.24,0:20:44.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:44.57,0:20:45.41,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:20:45.49,0:20:49.49,Default,,0,0,0,,Биде… Бұл… Забуро
Dialogue: 0,0:20:49.58,0:20:50.91,Default,,0,0,0,,Аты
Dialogue: 0,0:20:51.75,0:20:54.41,Default,,0,0,0,,Мұндай нәрсе қанша тұрады?
Dialogue: 0,0:20:54.50,0:20:55.87,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:20:55.96,0:20:59.38,Default,,0,0,0,,Мені құтқарған жігіттер мен Ичирен Тацуо.
Dialogue: 0,0:20:59.46,0:21:00.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:00.50,0:21:04.17,Default,,0,0,0,,Көптеген басқалары мен бұл туралы жақсымын.
Dialogue: 0,0:21:04.26,0:21:06.97,Default,,0,0,0,,Не...
Dialogue: 0,0:21:07.84,0:21:08.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:10.47,0:21:11.68,Default,,0,0,0,,Мен өзімді ессіз сезінемін...
Dialogue: 0,0:21:11.77,0:21:12.68,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:13.48,0:21:14.69,Default,,0,0,0,,Мен сондай болғым келеді
Dialogue: 0,0:21:15.35,0:21:17.69,Default,,0,0,0,,Ногучи! неге жылайсың
Dialogue: 0,0:21:17.77,0:21:20.02,Default,,0,0,0,,Тосизо Хиджиката~!
Dialogue: 0,0:21:20.11,0:21:21.69,Default,,0,0,0,,Шу шығарыңыз!
Dialogue: 0,0:21:21.78,0:21:24.49,Default,,0,0,0,,Қалғандарын тез құртайық!
Dialogue: 0,0:21:24.57,0:21:25.70,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:34.37,0:21:35.21,Default,,0,0,0,,Ha
Dialogue: 0,0:21:37.92,0:21:39.84,Default,,0,0,0,,Оған үйренбе
Dialogue: 0,0:21:40.54,0:21:41.84,Default,,0,0,0,,Фуфу
Dialogue: 0,0:21:43.96,0:21:45.26,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:21:51.05,0:21:56.06,Default,,0,0,0,,♪～
Dialogue: 0,0:23:11.64,0:23:16.64,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.44,0:23:24.15,Default,,0,0,0,,Хаджиме Сайто
Dialogue: 0,0:23:24.90,0:23:27.61,Default,,0,0,0,,Менің қарсыласым Аяме деген жігіт пе?
Dialogue: 0,0:23:27.69,0:23:30.20,Default,,0,0,0,,Бұл біртүрлі қорқынышты сезінеді.
Dialogue: 0,0:23:30.70,0:23:33.37,Default,,0,0,0,,Біз қаланы қандай жағдайда да қорғауымыз керек.
Dialogue: 0,0:23:34.41,0:23:36.91,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:23:37.49,0:23:40.00,Default,,0,0,0,,Мен ешкімнен жеңілгім келмейді
Dialogue: 0,0:23:40.62,0:23:42.62,Default,,0,0,0,,Тек күштірек болыңыз
Dialogue: 0,0:23:43.63,0:23:45.34,Default,,0,0,0,,Мен осылай уәде бердім.
Dialogue: 0,0:23:45.96,0:23:48.13,Default,,0,0,0,,Келесі жолы «Мұрагер»
Dialogue: 0,0:23:48.71,0:23:50.17,Default,,0,0,0,,Көру керек
Dialogue: 0,0:23:51.67,0:23:57.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
