Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:04.67,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:07.38,0:00:09.42,Default,,0,0,0,,Жібер...монка
Dialogue: 0,0:00:10.76,0:00:14.05,Default,,0,0,0,,Мені жіберме! Мен жеңілуге ​​шыдай алмаймын!
Dialogue: 0,0:00:15.43,0:00:17.55,Default,,0,0,0,,Сіз әлі де айтасыз ба?
Dialogue: 0,0:00:19.39,0:00:22.10,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:22.18,0:00:23.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:26.65,0:00:28.36,Default,,0,0,0,,А... ана жақта.
Dialogue: 0,0:00:28.98,0:00:30.44,Default,,0,0,0,,Егер сіз сол жаққа бұрылсаңыз...
Dialogue: 0,0:00:33.53,0:00:34.36,Default,,0,0,0,,Ах
Dialogue: 0,0:00:34.95,0:00:37.37,Default,,0,0,0,,Мен Ниджо қамалын көрдім.
Dialogue: 0,0:00:37.45,0:00:40.20,Default,,0,0,0,,Ахаха...
Dialogue: 0,0:00:51.46,0:00:54.84,Default,,0,0,0,,Осы жерден тура жүріңіз және бірінші бұрыштан оңға бұрылыңыз.
Dialogue: 0,0:00:54.92,0:00:56.34,Default,,0,0,0,,Ойке көшесі болыңыз
Dialogue: 0,0:00:56.43,0:01:00.06,Default,,0,0,0,,Егер сіз Хорикаваға дейін сонда жүрсеңіз, оң жағыңызда Ниджо қамалын көресіз.
Dialogue: 0,0:01:00.14,0:01:01.51,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:01.60,0:01:03.56,Default,,0,0,0,,-да не істейсіз?
Dialogue: 0,0:01:03.64,0:01:07.10,Default,,0,0,0,,Наозуми-санды тоқтату үшін уақыт ұтамын.
Dialogue: 0,0:01:07.19,0:01:10.27,Default,,0,0,0,,Жоқ, бұл дұрыс емес. Ол тым қауіпті.
Dialogue: 0,0:01:10.36,0:01:12.03,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:12.11,0:01:14.53,Default,,0,0,0,,Мен де Мибромын ғой!
Dialogue: 0,0:01:17.11,0:01:19.41,Default,,0,0,0,,Маған ұнамайды, ұнамайды, жалғыз қалудан қорқамын
Dialogue: 0,0:01:19.49,0:01:21.62,Default,,0,0,0,,Өзімшіл болма!
Dialogue: 0,0:01:21.70,0:01:24.62,Default,,0,0,0,,Кикучио мырза өлтірілсе, оның баласы болмайды.
Dialogue: 0,0:01:25.83,0:01:27.71,Default,,0,0,0,,Біраз уақыт қажет болса да
Dialogue: 0,0:01:27.79,0:01:30.38,Default,,0,0,0,,Бар болғаны қолдауға шақырып, асықтыру.
Dialogue: 0,0:01:31.21,0:01:33.05,Default,,0,0,0,,Мен мұны да білемін.
Dialogue: 0,0:01:34.01,0:01:35.51,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:01:37.80,0:01:40.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:41.01,0:01:44.06,Default,,0,0,0,,Егер ол әлі жұмыс істемесе, мені кешіріңіз.
Dialogue: 0,0:01:45.39,0:01:50.40,Default,,0,0,0,,♪～
Dialogue: 0,0:03:09.89,0:03:14.90,Default,,0,0,0,,～♪
Dialogue: 0,0:03:15.94,0:03:17.90,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:03:17.98,0:03:22.49,Default,,0,0,0,,Тұрақты! иә! Жібер, балам!
Dialogue: 0,0:03:22.57,0:03:23.41,Default,,0,0,0,,Мені жіберме!
Dialogue: 0,0:03:24.62,0:03:25.70,Default,,0,0,0,,Наозуми!
Dialogue: 0,0:03:26.20,0:03:27.41,Default,,0,0,0,,Не?
Dialogue: 0,0:03:30.50,0:03:32.92,Default,,0,0,0,,Енді тоқтайық.
Dialogue: 0,0:03:34.04,0:03:35.92,Default,,0,0,0,,Кикучио мырза
Dialogue: 0,0:03:37.09,0:03:38.42,Default,,0,0,0,,Хо…
Dialogue: 0,0:03:38.50,0:03:40.59,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:03:40.67,0:03:43.43,Default,,0,0,0,,Өйткені, мен жалғыз қаша алмаймын.
Dialogue: 0,0:03:43.51,0:03:48.56,Default,,0,0,0,,Бұндай зат басқалардан жоғары тұратын ыдыс емес.
Dialogue: 0,0:03:50.14,0:03:51.81,Default,,0,0,0,,Өйткені, сіз
Dialogue: 0,0:03:53.60,0:03:55.31,Default,,0,0,0,,Жалпы
Dialogue: 0,0:03:55.40,0:03:58.82,Default,,0,0,0,,Хехе, оның өлу үшін келгеніне сене алар емеспін.
Dialogue: 0,0:03:58.90,0:04:01.19,Default,,0,0,0,,Мені іздеу қиындығынан құтқарды.
Dialogue: 0,0:04:05.11,0:04:08.49,Default,,0,0,0,,Бұлай көрінсе де, мен ұлы генералмын
Dialogue: 0,0:04:09.12,0:04:13.50,Default,,0,0,0,,Мен... Мен де белгілі бір дәрежеде қылышқа шебермін.
Dialogue: 0,0:04:15.00,0:04:18.96,Default,,0,0,0,,Поо! Вахахаха! Мен дірілдеп жатырмын
Dialogue: 0,0:04:19.05,0:04:21.63,Default,,0,0,0,,Ол әбден босаңсыған.
Dialogue: 0,0:04:24.34,0:04:27.76,Default,,0,0,0,,То... Қаш, Кикучио-сан.
Dialogue: 0,0:04:27.85,0:04:31.47,Default,,0,0,0,,Жарайды... олай болуы мүмкін емес.
Dialogue: 0,0:04:31.56,0:04:34.52,Default,,0,0,0,,Ка...ка... маған қоңырау шалыңыз
Dialogue: 0,0:04:34.60,0:04:35.77,Default,,0,0,0,,- (Хиджиката) Жоқ - (Кикучиё) Ах.
Dialogue: 0,0:04:36.81,0:04:38.98,Default,,0,0,0,,Бұл жеткілікті, сэр.
Dialogue: 0,0:04:39.86,0:04:42.03,Default,,0,0,0,,Иә, Ием...
Dialogue: 0,0:04:42.11,0:04:43.28,Default,,0,0,0,,Хмм?
Dialogue: 0,0:04:43.36,0:04:44.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:47.24,0:04:49.20,Default,,0,0,0,,Хиджиката-сан!
Dialogue: 0,0:04:52.25,0:04:55.00,Default,,0,0,0,,Уаххаха!
Dialogue: 0,0:04:55.08,0:04:58.17,Default,,0,0,0,,Сізге аздап көңіл көтеретіндей көрінетін біреу келді ме?
Dialogue: 0,0:04:58.25,0:04:59.46,Default,,0,0,0,,- Уф... - (Наозуми) Әй?
Dialogue: 0,0:04:59.96,0:05:01.55,Default,,0,0,0,,- (Наозуми) Жібер! -Мен оны ұнатпаймын!
Dialogue: 0,0:05:01.63,0:05:03.34,Default,,0,0,0,,- (Наозуми) Босатыңызшы! -Мен оны ұнатпаймын!
Dialogue: 0,0:05:03.42,0:05:05.84,Default,,0,0,0,,-Маған ұнамайды! -(Наозуми) Уф
Dialogue: 0,0:05:06.47,0:05:08.47,Default,,0,0,0,,Иә, орындаңыз!
Dialogue: 0,0:05:08.55,0:05:09.39,Default,,0,0,0,,Гухаа
Dialogue: 0,0:05:09.47,0:05:10.89,Default,,0,0,0,,Бұл Мибро.
Dialogue: 0,0:05:13.77,0:05:16.39,Default,,0,0,0,,Жоо...
Dialogue: 0,0:05:16.48,0:05:19.11,Default,,0,0,0,,Хаха! Сіз кенеттен келесіз бе?
Dialogue: 0,0:05:19.19,0:05:21.86,Default,,0,0,0,,Мен естігендей жабайысың.
Dialogue: 0,0:05:24.32,0:05:26.90,Default,,0,0,0,,Ой! Хаха
Dialogue: 0,0:05:28.91,0:05:31.58,Default,,0,0,0,,Ол қайдан шыққан? Жасың нешеде?
Dialogue: 0,0:05:31.66,0:05:35.79,Default,,0,0,0,,Не! Не, ашулысың ба?
Dialogue: 0,0:05:35.87,0:05:37.42,Default,,0,0,0,,Сіздің мектебіңіз қандай?
Dialogue: 0,0:05:38.71,0:05:40.00,Default,,0,0,0,,Хамф!
Dialogue: 0,0:05:41.67,0:05:43.05,Default,,0,0,0,,Nuo…
Dialogue: 0,0:05:53.10,0:05:56.14,Default,,0,0,0,,Қандай керемет күш!
Dialogue: 0,0:05:56.23,0:05:59.15,Default,,0,0,0,,Ал... Хиджиката-сан күткендей.
Dialogue: 0,0:05:59.23,0:06:02.11,Default,,0,0,0,,Бітім-ау, шіркін.
Dialogue: 0,0:06:02.19,0:06:04.40,Default,,0,0,0,,Менің сізбен сөйлесетін ештеңем жоқ.
Dialogue: 0,0:06:10.37,0:06:11.41,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:11.49,0:06:12.78,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:12.87,0:06:14.54,Default,,0,0,0,,Хэхехе... Уф...
Dialogue: 0,0:06:15.75,0:06:18.33,Default,,0,0,0,,Менің жаман әдетім болғым келмейді.
Dialogue: 0,0:06:19.08,0:06:21.38,Default,,0,0,0,,Маған қызық көрінген адаммен танысқаныма көп болды.
Dialogue: 0,0:06:21.46,0:06:24.30,Default,,0,0,0,,Күлімсірегенімді баса алмадым.
Dialogue: 0,0:06:24.38,0:06:26.46,Default,,0,0,0,,-ге көшуге болады ма?
Dialogue: 0,0:06:26.55,0:06:27.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:27.59,0:06:30.05,Default,,0,0,0,,Лордты Ниджо қамалына жіберіңіз.
Dialogue: 0,0:06:30.68,0:06:31.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:32.39,0:06:33.89,Default,,0,0,0,,Айта...
Dialogue: 0,0:06:35.10,0:06:35.93,Default,,0,0,0,,Қол ұшын созайық
Dialogue: 0,0:06:36.02,0:06:39.10,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:06:39.19,0:06:40.98,Default,,0,0,0,,Маған түсіндіріп бересің бе, сонда мен үйренемін?
Dialogue: 0,0:06:41.06,0:06:42.48,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:44.65,0:06:45.61,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:06:46.15,0:06:47.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:48.32,0:06:49.70,Default,,0,0,0,,Осы жерден айналып шығайық.
Dialogue: 0,0:06:49.78,0:06:50.61,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:51.45,0:06:53.91,Default,,0,0,0,,Ол адам жақсы бола ма?
Dialogue: 0,0:06:53.99,0:06:55.45,Default,,0,0,0,,Көмек шақыру керек емес пе?
Dialogue: 0,0:06:56.12,0:06:57.95,Default,,0,0,0,,Егер ол тимесе, онда біреу сол зұлымдықты әділ бағалауы тиіс.
Dialogue: 0,0:06:58.04,0:07:01.87,Default,,0,0,0,,Қашып кетіп, достарыңды шақырмасаң, кейін үлкен көзге ұрынасың.
Dialogue: 0,0:07:03.29,0:07:06.71,Default,,0,0,0,,Хиджикатаның жеңілетінін елестете алмаймын.
Dialogue: 0,0:07:12.97,0:07:15.10,Default,,0,0,0,,Нуо, әлі жоқ!
Dialogue: 0,0:07:17.47,0:07:18.68,Default,,0,0,0,,Хаха!
Dialogue: 0,0:07:18.77,0:07:20.18,Default,,0,0,0,,Уф
Dialogue: 0,0:07:20.27,0:07:22.98,Default,,0,0,0,,Хохоу сотының үкімі
Dialogue: 0,0:07:23.06,0:07:26.69,Default,,0,0,0,,Ол күшті болуымен қатар, епті де.
Dialogue: 0,0:07:26.77,0:07:29.53,Default,,0,0,0,,Техника сызықтық.
Dialogue: 0,0:07:29.61,0:07:33.20,Default,,0,0,0,,Сол ғажап қылышпен, бұл тар жолдың таңқаларлық емес.
Dialogue: 0,0:07:33.28,0:07:37.95,Default,,0,0,0,,Мен таптым. Сіз қарапайым адам емессіз ғой.
Dialogue: 0,0:07:38.04,0:07:39.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:40.12,0:07:43.50,Default,,0,0,0,,Одан жақсы ма? Олар оңай кетсін
Dialogue: 0,0:07:43.58,0:07:45.54,Default,,0,0,0,,Кішкентай нәрсе
Dialogue: 0,0:07:45.63,0:07:50.01,Default,,0,0,0,,Біз сөзсіз сөйлесуіміз керек.
Dialogue: 0,0:07:50.09,0:07:51.47,Default,,0,0,0,,Не?
Dialogue: 0,0:07:51.55,0:07:55.34,Default,,0,0,0,,Айтар ештеңем жоқ дедіңіз. Олай айтпа.
Dialogue: 0,0:07:55.43,0:07:57.76,Default,,0,0,0,,Өзіңіз туралы айтып беріңізші
Dialogue: 0,0:07:57.85,0:07:59.22,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:07:59.31,0:08:02.98,Default,,0,0,0,,Кішкентай әңгімелерімнен бастайық.
Dialogue: 0,0:08:03.73,0:08:04.73,Default,,0,0,0,,Уау
Dialogue: 0,0:08:05.35,0:08:06.69,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:08:06.77,0:08:08.44,Default,,0,0,0,,Уф
Dialogue: 0,0:08:09.07,0:08:10.15,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:08:10.23,0:08:13.40,Default,,0,0,0,,Сенің мінезің мені қызықтырмайды.
Dialogue: 0,0:08:13.49,0:08:16.57,Default,,0,0,0,,Хахаха, бұл шағып тұр.
Dialogue: 0,0:08:16.66,0:08:18.03,Default,,0,0,0,,Көңілді сияқты
Dialogue: 0,0:08:18.12,0:08:19.49,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:08:19.58,0:08:23.08,Default,,0,0,0,,Мибуро дегеніміз не? Мибу ауылында тұратын Ронин жауынгерлері
Dialogue: 0,0:08:23.16,0:08:26.54,Default,,0,0,0,,Мен бұл Эдодан келген рониннің жиналуы деп естідім.
Dialogue: 0,0:08:26.63,0:08:27.96,Default,,0,0,0,,Иә
Dialogue: 0,0:08:28.04,0:08:29.96,Default,,0,0,0,,сонда түсінесіз
Dialogue: 0,0:08:30.05,0:08:31.96,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:08:32.05,0:08:33.51,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:35.59,0:08:39.10,Default,,0,0,0,,Атын шығару үшін, Қылышпен атын шығару.
Dialogue: 0,0:08:39.18,0:08:43.23,Default,,0,0,0,,Сіз бұл қалаға бар екеніңізді дәлелдеу үшін келдіңіз бе?
Dialogue: 0,0:08:44.89,0:08:47.48,Default,,0,0,0,,Ондай адамдар бар.
Dialogue: 0,0:08:48.06,0:08:50.61,Default,,0,0,0,,Бірақ, кем дегенде, мен емес.
Dialogue: 0,0:08:50.69,0:08:51.73,Default,,0,0,0,,Не?
Dialogue: 0,0:08:51.82,0:08:55.24,Default,,0,0,0,,Сонымен не үшін келдің?
Dialogue: 0,0:08:58.24,0:09:00.03,Default,,0,0,0,,3 жасқа дейін
Dialogue: 0,0:09:00.12,0:09:03.25,Default,,0,0,0,,Сіз ата-анаңызға өмір бойы қарызыңызды өтей алатыныңызды білесіз бе?
Dialogue: 0,0:09:03.33,0:09:04.25,Default,,0,0,0,,Білмеймін!
Dialogue: 0,0:09:04.83,0:09:07.17,Default,,0,0,0,,Сәбилер сүйкімді.
Dialogue: 0,0:09:07.25,0:09:10.25,Default,,0,0,0,,Менің ойымша, сізге жеңіл қарау керек.
Dialogue: 0,0:09:10.34,0:09:13.76,Default,,0,0,0,,Бұл маған қатысты емес.
Dialogue: 0,0:09:13.84,0:09:15.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:15.47,0:09:18.26,Default,,0,0,0,,Мен 10 ағайындының кенжесімін.
Dialogue: 0,0:09:18.34,0:09:19.93,Default,,0,0,0,,(Ағайындылардың күлкісі)
Dialogue: 0,0:09:20.01,0:09:23.43,Default,,0,0,0,,Сіз маған өте жақсы болдыңыз.
Dialogue: 0,0:09:27.35,0:09:33.78,Default,,0,0,0,,(Ағайындылардың күлкісі)
Dialogue: 0,0:09:34.86,0:09:36.28,Default,,0,0,0,,Ата-аналар ғана емес
Dialogue: 0,0:09:36.36,0:09:39.82,Default,,0,0,0,,Менің ағам мен әпкем, нағашыларым мен нағашыларым, ауылдастарым.
Dialogue: 0,0:09:39.91,0:09:42.29,Default,,0,0,0,,Ол мені кім болса да жақсы көрді.
Dialogue: 0,0:09:43.91,0:09:46.29,Default,,0,0,0,,А... махаббат?
Dialogue: 0,0:09:46.37,0:09:50.29,Default,,0,0,0,,Менің жағдайым бойынша мен алған жақсылығым тым үлкен болды.
Dialogue: 0,0:09:50.38,0:09:52.30,Default,,0,0,0,,Мен оны қайтарғым келеді
Dialogue: 0,0:09:52.38,0:09:53.50,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:54.09,0:09:58.26,Default,,0,0,0,,Киотода сен сияқты адамдар көбейіп кетті.
Dialogue: 0,0:09:58.34,0:10:00.64,Default,,0,0,0,,Кейбір адамдар қиындыққа тап болуы мүмкін.
Dialogue: 0,0:10:00.72,0:10:03.31,Default,,0,0,0,,Кейбір адамдар жылап жатқан болуы мүмкін.
Dialogue: 0,0:10:03.39,0:10:07.27,Default,,0,0,0,,Қайда немесе кім болса да, мен бұл туралы бірдеңе жасағым келеді.
Dialogue: 0,0:10:07.35,0:10:08.56,Default,,0,0,0,,Мен Тога. Тога Химико
Dialogue: 0,0:10:10.94,0:10:13.90,Default,,0,0,0,,Жарайды, күнде солай айтсаң да.
Dialogue: 0,0:10:13.98,0:10:17.07,Default,,0,0,0,,Мен Мибродағы адамдардың ешқайсысына сенбеймін.
Dialogue: 0,0:10:17.95,0:10:19.86,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:10:20.82,0:10:24.12,Default,,0,0,0,,Себебі менде де сен сияқты жаман жағым бар.
Dialogue: 0,0:10:25.41,0:10:27.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:27.12,0:10:31.04,Default,,0,0,0,,Кухахаха! Түсінемін, түсінемін
Dialogue: 0,0:10:31.13,0:10:35.25,Default,,0,0,0,,Әлсіздер үшін күресу - самурайдың тағы бір қыры
Dialogue: 0,0:10:35.34,0:10:37.88,Default,,0,0,0,,Бұл сіздің Бушидоңыз.
Dialogue: 0,0:10:38.51,0:10:39.84,Default,,0,0,0,,Бушидо?
Dialogue: 0,0:10:40.47,0:10:43.05,Default,,0,0,0,,Тыңдайық, жолдастар.
Dialogue: 0,0:10:43.14,0:10:45.89,Default,,0,0,0,,Сіз оған жауап бере алуыңыз керек.
Dialogue: 0,0:10:45.97,0:10:50.14,Default,,0,0,0,,Жекпе-жек сіз үшін нені білдіреді? Маған тыңдауға рұқсат етіңіз
Dialogue: 0,0:10:50.23,0:10:52.90,Default,,0,0,0,,Такеши? Бұл самурайдың жекпе-жек өнері ме?
Dialogue: 0,0:10:52.98,0:10:57.40,Default,,0,0,0,,Иә, бұл біздің мақсат етіп отырған түпкі оқиға. Ха...
Dialogue: 0,0:10:57.49,0:10:58.32,Default,,0,0,0,,Біріншіден, қарсыласты гайка кілтесімен есінен тандырарлықтай ұрудың қаталдығы
Dialogue: 0,0:10:59.99,0:11:01.07,Default,,0,0,0,,Гррр…
Dialogue: 0,0:11:05.53,0:11:07.29,Default,,0,0,0,,Алдау
Dialogue: 0,0:11:08.66,0:11:13.71,Default,,0,0,0,,(Ниото Кикучионың ауыр тыныс алуы)
Dialogue: 0,0:11:13.79,0:11:15.92,Default,,0,0,0,,Сіз өз бастықыңызды әлі таппадыңыз ба?
Dialogue: 0,0:11:16.00,0:11:17.84,Default,,0,0,0,,Оны кез келген бағамен табыңыз!
Dialogue: 0,0:11:17.92,0:11:18.92,Default,,0,0,0,,Хаха!
Dialogue: 0,0:11:19.01,0:11:22.76,Default,,0,0,0,,Мен Ниджо қамалына келдім.
Dialogue: 0,0:11:22.84,0:11:25.18,Default,,0,0,0,,Мен... аман қалдым.
Dialogue: 0,0:11:27.56,0:11:29.18,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:11:29.27,0:11:32.35,Default,,0,0,0,,Генерал Ниомори да әлі келген жоқ.
Dialogue: 0,0:11:32.44,0:11:33.52,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:11:33.60,0:11:35.69,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:11:35.77,0:11:36.52,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:11:36.52,0:11:36.98,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:11:36.52,0:11:36.98,Default,,0,0,0,,Хиджиката да бір жерге кетіп қалды.
Dialogue: 0,0:11:36.98,0:11:38.23,Default,,0,0,0,,Хиджиката да бір жерге кетіп қалды.
Dialogue: 0,0:11:38.32,0:11:41.20,Default,,0,0,0,,Ол өлді! Ол аяқтады!
Dialogue: 0,0:11:41.28,0:11:43.61,Default,,0,0,0,,Шатаспа, Таро!
Dialogue: 0,0:11:43.70,0:11:44.87,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:11:44.95,0:11:46.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.45,0:11:49.20,Default,,0,0,0,,үшін осында.
Dialogue: 0,0:11:49.29,0:11:51.37,Default,,0,0,0,,Мен қайтып келдім.
Dialogue: 0,0:11:51.46,0:11:53.62,Default,,0,0,0,,! Генерал да
Dialogue: 0,0:11:53.71,0:11:54.88,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:11:54.96,0:11:56.00,Default,,0,0,0,,Мен тірі едім
Dialogue: 0,0:11:56.09,0:11:57.13,Default,,0,0,0,,(Сора) Хмм… (Жибрил) Угх… Хехехе…
Dialogue: 0,0:11:57.71,0:11:58.63,Default,,0,0,0,,Міне, дәл осылай мүлдем әлсіз болу дегенді айтады, иә, Польнарефф?
Dialogue: 0,0:11:58.71,0:12:02.51,Default,,0,0,0,,Ой... Мен мүлде уайымдамаймын.
Dialogue: 0,0:12:02.59,0:12:03.47,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:12:03.55,0:12:07.22,Default,,0,0,0,,Бірақ мен ештеңе болмағанына қуаныштымын...
Dialogue: 0,0:12:07.30,0:12:08.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:08.22,0:12:12.27,Default,,0,0,0,,Иә, менде ештеңе болмағанына өте қуаныштымын.
Dialogue: 0,0:12:12.35,0:12:14.65,Default,,0,0,0,,Хмм, бұл үлкен мәселе емес еді.
Dialogue: 0,0:12:14.73,0:12:18.36,Default,,0,0,0,,Уау! Ол құлап жатқан жоқ па?
Dialogue: 0,0:12:18.44,0:12:19.90,Default,,0,0,0,,Ұрған жоқ па?
Dialogue: 0,0:12:20.53,0:12:21.61,Default,,0,0,0,,Бұл адам ба?
Dialogue: 0,0:12:21.69,0:12:23.95,Default,,0,0,0,,Иә, Наозуми-сан мені тапты.
Dialogue: 0,0:12:24.53,0:12:26.95,Default,,0,0,0,,Жауларыңды атама!
Dialogue: 0,0:12:27.03,0:12:28.78,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:12:28.87,0:12:30.49,Default,,0,0,0,,Уайымсыз бейбақ!
Dialogue: 0,0:12:31.08,0:12:32.20,Default,,0,0,0,,Лорд Иемо!
Dialogue: 0,0:12:32.29,0:12:33.71,Default,,0,0,0,,Сіз қайтып келдіңіз!
Dialogue: 0,0:12:33.79,0:12:35.25,Default,,0,0,0,,Жақсысыз ба, сэр?
Dialogue: 0,0:12:35.33,0:12:38.25,Default,,0,0,0,,Дау-дамай, тырнап қана қалды
Dialogue: 0,0:12:38.34,0:12:41.38,Default,,0,0,0,,Гах! Мені қанға батып кетіңіз!
Dialogue: 0,0:12:41.46,0:12:42.84,Default,,0,0,0,,Әй, ұры!
Dialogue: 0,0:12:42.92,0:12:44.76,Default,,0,0,0,,Бұл сізді табысты етеді!
Dialogue: 0,0:12:44.84,0:12:45.76,Default,,0,0,0,,Жалпы
Dialogue: 0,0:12:45.84,0:12:47.05,Default,,0,0,0,,Не! Дөрекі адам...
Dialogue: 0,0:12:47.14,0:12:48.01,Default,,0,0,0,,Әйелі\NСіз
Dialogue: 0,0:12:48.10,0:12:49.89,Default,,0,0,0,,жұмыс істедіңіз бе?
Dialogue: 0,0:12:50.81,0:12:52.93,Default,,0,0,0,,Өте көп.
Dialogue: 0,0:12:53.02,0:12:54.77,Default,,0,0,0,,Бұл тамаша жұмыс істеді.
Dialogue: 0,0:12:54.85,0:12:56.40,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:12:57.35,0:13:01.03,Default,,0,0,0,,Қандай үлкен мәселе! Бұл ер адам
Dialogue: 0,0:13:01.11,0:13:03.28,Default,,0,0,0,,Ауырды, ауырады, әже.
Dialogue: 0,0:13:03.36,0:13:05.95,Default,,0,0,0,,Мен сені мұны істейтін адам деп ойладым.
Dialogue: 0,0:13:06.03,0:13:08.70,Default,,0,0,0,,Хмф, бұл табиғи нәрсе.
Dialogue: 0,0:13:08.78,0:13:13.04,Default,,0,0,0,,Жоқ, бірақ, генерал, егер сіз өлсеңіз, бәріміз...
Dialogue: 0,0:13:13.12,0:13:15.58,Default,,0,0,0,,Оның басын алды Ахахахха!
Dialogue: 0,0:13:15.66,0:13:18.83,Default,,0,0,0,,! сен батырсың
Dialogue: 0,0:13:18.92,0:13:21.50,Default,,0,0,0,,Хахаха бәрі асыра айтып жатыр.
Dialogue: 0,0:13:21.59,0:13:23.01,Default,,0,0,0,,Жоқ, ол батыр.
Dialogue: 0,0:13:23.09,0:13:25.76,Default,,0,0,0,,Айтпақшы, Хиджикатаны көрмедің бе?
Dialogue: 0,0:13:25.84,0:13:28.01,Default,,0,0,0,,Мен сендерді іздедім.
Dialogue: 0,0:13:28.09,0:13:30.26,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:30.35,0:13:32.77,Default,,0,0,0,,Хиджиката-сан Наозуми-санмен соғысып жатыр.
Dialogue: 0,0:13:32.85,0:13:33.68,Default,,0,0,0,,Қайда?
Dialogue: 0,0:13:33.77,0:13:35.77,Default,,0,0,0,,Қазір...
Dialogue: 0,0:13:35.85,0:13:37.02,Default,,0,0,0,,- (Окита) Ах - (Таро) Ха
Dialogue: 0,0:13:37.81,0:13:40.65,Default,,0,0,0,,Сәлем! Қай жерде ұрысып жатырсың?
Dialogue: 0,0:13:40.73,0:13:43.86,Default,,0,0,0,,Тым болмаса, есін жимастан бұрын тұрған жерді айт.
Dialogue: 0,0:13:43.94,0:13:47.28,Default,,0,0,0,,Ұрыс алаңы Оике көшесінде, Мибро, өтінемін.
Dialogue: 0,0:13:47.36,0:13:48.36,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:48.45,0:13:50.28,Default,,0,0,0,,Бұл әлі жалғасып жатыр ма?
Dialogue: 0,0:13:50.37,0:13:52.03,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:13:52.70,0:13:55.87,Default,,0,0,0,,Мен сені кіргіземін, қақпаны аш!
Dialogue: 0,0:13:56.79,0:13:59.04,Default,,0,0,0,,Көшеде екі күзетші өлтірілді.
Dialogue: 0,0:13:59.12,0:13:59.96,Default,,0,0,0,,Біреуді жібер!
Dialogue: 0,0:14:00.04,0:14:00.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:00.96,0:14:02.96,Default,,0,0,0,,Және дереу дәрігерді шақырыңыз!
Dialogue: 0,0:14:03.05,0:14:03.88,Default,,0,0,0,,Хаха!
Dialogue: 0,0:14:03.96,0:14:07.22,Default,,0,0,0,,Жарайды... Жарайды, бәрі де, қолыңнан келгеннің бәрін жаса, жеңілме.
Dialogue: 0,0:14:07.30,0:14:08.80,Default,,0,0,0,,- (Әже) Хамф - (Таро) Тататата!
Dialogue: 0,0:14:08.88,0:14:10.76,Default,,0,0,0,,Сен де бару керек, Таро!
Dialogue: 0,0:14:10.85,0:14:14.43,Default,,0,0,0,,Достарым төбелесіп жатыр, қолымыздан келгенді бірге жасайық!
Dialogue: 0,0:14:14.52,0:14:16.43,Default,,0,0,0,,Hiiii~
Dialogue: 0,0:14:16.52,0:14:19.81,Default,,0,0,0,,Кеттік, олар жай адамдар емес.
Dialogue: 0,0:14:21.81,0:14:23.82,Default,,0,0,0,,Такеши алаяқ па?
Dialogue: 0,0:14:23.90,0:14:25.32,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:14:26.32,0:14:28.95,Default,,0,0,0,,F… Аспаз аспаз
Dialogue: 0,0:14:29.03,0:14:30.28,Default,,0,0,0,,- (Наозуми) Нуах! -(Хиджиката) Иә
Dialogue: 0,0:14:34.79,0:14:35.62,Default,,0,0,0,,Хмм?
Dialogue: 0,0:14:37.50,0:14:38.62,Default,,0,0,0,,Арзан заттар!
Dialogue: 0,0:14:38.71,0:14:42.13,Default,,0,0,0,,Жарайсыңдар, әңгімені жалғастырайық.
Dialogue: 0,0:14:42.21,0:14:43.84,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:43.92,0:14:47.38,Default,,0,0,0,,Неліктен сіз, самурай, мұндай сөзді айтасыз?
Dialogue: 0,0:14:49.63,0:14:53.72,Default,,0,0,0,,Сіз бір нәрсені дұрыс түсінбей жатқан сияқтысыз, бірақ мен самурай емеспін.
Dialogue: 0,0:14:53.80,0:14:54.64,Default,,0,0,0,,Не?
Dialogue: 0,0:14:57.73,0:15:00.02,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:15:00.10,0:15:02.15,Default,,0,0,0,,Бұл жай ғана шаруаның өтініші.
Dialogue: 0,0:15:02.23,0:15:06.44,Default,,0,0,0,,ше? Ақымақ! Егер сіз фермер болсаңыз ...
Dialogue: 0,0:15:06.53,0:15:10.36,Default,,0,0,0,,Сіз? Бұл өтірік. Өтірік айтпа!
Dialogue: 0,0:15:10.45,0:15:11.49,Default,,0,0,0,,(Хиджикатаның күрсінуі)
Dialogue: 0,0:15:13.24,0:15:16.54,Default,,0,0,0,,Вакизаши? Жалғастыруды жоспарлайсыз ба?
Dialogue: 0,0:15:16.62,0:15:19.41,Default,,0,0,0,,Мұндай ойыншықпен не істеуге болады?
Dialogue: 0,0:15:20.25,0:15:21.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:22.46,0:15:24.08,Default,,0,0,0,,Уф…
Dialogue: 0,0:15:25.21,0:15:28.13,Default,,0,0,0,,Хаха Бұл күш бәсекесі ме?
Dialogue: 0,0:15:28.21,0:15:31.88,Default,,0,0,0,,Сіз мені түкірген матчта жеңе аласыз деп ойлайсыз ба?
Dialogue: 0,0:15:32.72,0:15:35.14,Default,,0,0,0,,Не? Нуоооо
Dialogue: 0,0:15:35.22,0:15:36.89,Default,,0,0,0,,Buo
Dialogue: 0,0:15:40.10,0:15:43.90,Default,,0,0,0,,Жұдырық ше? Бұл ұрыс стилі қандай?
Dialogue: 0,0:15:43.98,0:15:46.90,Default,,0,0,0,,Сіздің алдыңызда матч деп қате түсінбеңіз.
Dialogue: 0,0:15:47.52,0:15:49.40,Default,,0,0,0,,Бұл жай ғана ұрыс
Dialogue: 0,0:15:50.74,0:15:52.53,Default,,0,0,0,,Ұрыс?
Dialogue: 0,0:15:56.41,0:15:57.24,Default,,0,0,0,,Аға!
Dialogue: 0,0:15:57.87,0:15:58.70,Default,,0,0,0,,Гего!
Dialogue: 0,0:16:01.66,0:16:02.96,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:03.04,0:16:04.33,Default,,0,0,0,,Куу…
Dialogue: 0,0:16:04.96,0:16:07.13,Default,,0,0,0,,(Екі адамның ауыр дауысы)
Dialogue: 0,0:16:07.21,0:16:09.38,Default,,0,0,0,,Жібер!
Dialogue: 0,0:16:09.46,0:16:11.01,Default,,0,0,0,,Босатыңыз!
Dialogue: 0,0:16:11.09,0:16:13.01,Default,,0,0,0,,Жарайды онда
Dialogue: 0,0:16:13.09,0:16:15.72,Default,,0,0,0,,Жалғастырғыңыз келе ме?
Dialogue: 0,0:16:19.01,0:16:21.14,Default,,0,0,0,,Бұл жігіт қашан келді?
Dialogue: 0,0:16:30.78,0:16:32.65,Default,,0,0,0,,Бұл әдемі емес.
Dialogue: 0,0:16:33.28,0:16:35.78,Default,,0,0,0,,Әдемі емес
Dialogue: 0,0:16:35.86,0:16:37.78,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:38.91,0:16:40.29,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:16:41.50,0:16:45.67,Default,,0,0,0,,Наозуми, әлгі күшті қылыш мұнда аман қалмайды.
Dialogue: 0,0:16:45.75,0:16:46.67,Default,,0,0,0,,Мұндай жағдайлар бола ма?
Dialogue: 0,0:16:46.75,0:16:48.04,Default,,0,0,0,,(Жаңа атқарушы)
Dialogue: 0,0:16:48.13,0:16:51.05,Default,,0,0,0,,Аяме мырза
Dialogue: 0,0:16:51.76,0:16:54.13,Default,,0,0,0,,Мен сені өлтіретін адаммын
Dialogue: 0,0:16:54.88,0:16:58.55,Default,,0,0,0,,Сіз! Неліктен тік формаңызды кимейсіз?
Dialogue: 0,0:16:58.64,0:17:02.81,Default,,0,0,0,,Иә? Солай киініп шықсаң көзге түсесің, солай ма?
Dialogue: 0,0:17:02.89,0:17:04.06,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:17:05.14,0:17:07.02,Default,,0,0,0,,Түсіндің бе? бұл гүл
Dialogue: 0,0:17:07.10,0:17:10.07,Default,,0,0,0,,Бұл Руз. Оның тікендері бар.
Dialogue: 0,0:17:11.07,0:17:12.82,Default,,0,0,0,,Мен сияқты.
Dialogue: 0,0:17:12.90,0:17:15.32,Default,,0,0,0,,Бұл әлдеқайда байқалады!
Dialogue: 0,0:17:15.40,0:17:17.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:17.28,0:17:21.62,Default,,0,0,0,,Материал жақсы, бірақ өкінішке орай лай.
Dialogue: 0,0:17:21.70,0:17:23.16,Default,,0,0,0,,Балалар сендерге не болып жатыр?
Dialogue: 0,0:17:23.25,0:17:24.08,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:17:24.66,0:17:25.58,Default,,0,0,0,,Неше адам бар?
Dialogue: 0,0:17:25.66,0:17:28.25,Default,,0,0,0,,Нихон Шоки бойынша
Dialogue: 0,0:17:28.33,0:17:32.59,Default,,0,0,0,,Ұлы жылан Ямата но Орочидің сегіз басы бар дейді.
Dialogue: 0,0:17:33.17,0:17:34.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:34.17,0:17:39.09,Default,,0,0,0,,Сегіз бас, яғни «Сузуран»
Dialogue: 0,0:17:39.18,0:17:43.85,Default,,0,0,0,,«ақылсыз ақыл» «арандату» «ит»
Dialogue: 0,0:17:43.93,0:17:49.35,Default,,0,0,0,,«Үнсіз» «Якша» «Отшашу шебері» және
Dialogue: 0,0:17:50.36,0:17:51.61,Default,,0,0,0,,«Самурай»
Dialogue: 0,0:17:53.11,0:17:54.40,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:17:54.49,0:17:56.36,Default,,0,0,0,,тыңдағандарыңызға рахмет.
Dialogue: 0,0:17:56.45,0:17:58.49,Default,,0,0,0,,Менің қаным Рисшидан...
Dialogue: 0,0:17:58.57,0:18:00.87,Default,,0,0,0,,- (Тодо) О, бұл болды - (Наозуми) Ах...
Dialogue: 0,0:18:00.95,0:18:03.37,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:18:05.16,0:18:07.12,Default,,0,0,0,,Нашар...
Dialogue: 0,0:18:07.21,0:18:08.83,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:18:08.92,0:18:10.13,Default,,0,0,0,,О, ау
Dialogue: 0,0:18:10.75,0:18:12.63,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:18:12.71,0:18:14.63,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:18:14.71,0:18:17.63,Default,,0,0,0,,Сіз қиын кезде кездейсоқ кездесіп жүрсіз бе?
Dialogue: 0,0:18:17.72,0:18:19.47,Default,,0,0,0,,Сәлем, өтінемін
Dialogue: 0,0:18:19.55,0:18:20.59,Default,,0,0,0,,Уау
Dialogue: 0,0:18:20.68,0:18:22.89,Default,,0,0,0,,Оны неге тез өлтірмедің?
Dialogue: 0,0:18:24.97,0:18:27.39,Default,,0,0,0,,-(Наозуми) Бұл Мибро -(Аяме) Хмм...
Dialogue: 0,0:18:27.48,0:18:30.15,Default,,0,0,0,,Хиджиката, мен саған кез келген уақытта көмектесемін.
Dialogue: 0,0:18:30.23,0:18:33.15,Default,,0,0,0,,Бұл сіздің әлі де жеткілікті түрде жаттыға алмағаныңыздың дәлелі.
Dialogue: 0,0:18:33.23,0:18:36.19,Default,,0,0,0,,Сәлем, жаңа адамдар көбірек.
Dialogue: 0,0:18:36.28,0:18:38.15,Default,,0,0,0,,Бірдеңе істе, Хиджиката!
Dialogue: 0,0:18:38.99,0:18:40.24,Default,,0,0,0,,Шу!
Dialogue: 0,0:18:40.32,0:18:43.28,Default,,0,0,0,,Уау, сені ұрып-соғып жатыр!
Dialogue: 0,0:18:43.37,0:18:48.54,Default,,0,0,0,,Хехехе, мынау, мынау, достар.
Dialogue: 0,0:18:51.88,0:18:55.38,Default,,0,0,0,,Осы жерден кірсең, соғыс басталады.
Dialogue: 0,0:18:55.46,0:18:58.55,Default,,0,0,0,,Осы жерде және қазір орындағыңыз келе ме? Сіз мұны істегіңіз келе ме?
Dialogue: 0,0:18:58.63,0:19:00.05,Default,,0,0,0,,Не?
Dialogue: 0,0:19:05.39,0:19:09.06,Default,,0,0,0,,Жарайды... Жарайды, кеттік олардан құтылайық.
Dialogue: 0,0:19:10.31,0:19:12.77,Default,,0,0,0,,Жоқ, бүгін тоқталайық.
Dialogue: 0,0:19:15.86,0:19:17.11,Default,,0,0,0,,Иә
Dialogue: 0,0:19:17.19,0:19:20.61,Default,,0,0,0,,Иә, бүгін күн жақсы емес.
Dialogue: 0,0:19:24.74,0:19:26.08,Default,,0,0,0,,Кеттік, Наозуми
Dialogue: 0,0:19:26.16,0:19:27.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:27.20,0:19:29.12,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:19:29.20,0:19:31.62,Default,,0,0,0,,Өзіңіз шешім қабылдамаңыз!
Dialogue: 0,0:19:31.71,0:19:34.21,Default,,0,0,0,,Сол қылыш қисық.
Dialogue: 0,0:19:34.29,0:19:35.13,Default,,0,0,0,,Не?
Dialogue: 0,0:19:35.21,0:19:37.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:39.05,0:19:40.92,Default,,0,0,0,,- (Наозуми) Цк - (Хиджиката) Эй
Dialogue: 0,0:19:42.59,0:19:44.64,Default,,0,0,0,,Ұрыс әлі біткен жоқ.
Dialogue: 0,0:19:47.68,0:19:50.64,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:19:51.56,0:19:53.65,Default,,0,0,0,,Тосизо Хиджиката
Dialogue: 0,0:19:54.56,0:19:56.65,Default,,0,0,0,,Наозуми Киохачи
Dialogue: 0,0:19:57.27,0:19:59.36,Default,,0,0,0,,...
Dialogue: 0,0:20:00.49,0:20:04.41,Default,,0,0,0,,Біздің мақсатымыз туралы ақ шаштан сұраңыз.
Dialogue: 0,0:20:04.49,0:20:07.66,Default,,0,0,0,,Осы жерде қалғаным дұрыс емес пе еді?
Dialogue: 0,0:20:07.74,0:20:11.50,Default,,0,0,0,,Дұрыс! Мен оны осылай жібере аламын ба?
Dialogue: 0,0:20:11.58,0:20:13.17,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:20:13.25,0:20:15.17,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:20:15.25,0:20:18.67,Default,,0,0,0,,Бірақ Наозуми қатал сияқты.
Dialogue: 0,0:20:18.75,0:20:21.67,Default,,0,0,0,,Мен ол жігітпен ісімді аяқтаймын.
Dialogue: 0,0:20:21.76,0:20:23.30,Default,,0,0,0,,- (Хиджиката) Дәлірек айтқанда, Соудзи - (Окита) Иә?
Dialogue: 0,0:20:23.97,0:20:26.30,Default,,0,0,0,,Көп уайымдамаңыз
Dialogue: 0,0:20:26.39,0:20:28.72,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:28.81,0:20:30.27,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:20:31.31,0:20:36.27,Default,,0,0,0,,Сол Хиджиката адамы өте маңызды адам.
Dialogue: 0,0:20:36.36,0:20:37.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:37.31,0:20:42.24,Default,,0,0,0,,Негізі, мен мұны істедім бе, жоқ па, бәрібір.
Dialogue: 0,0:20:42.32,0:20:45.95,Default,,0,0,0,,Егер мен мұны істесем, Хиджиката сол күйде өліп кетер еді, солай ма?
Dialogue: 0,0:20:46.03,0:20:47.24,Default,,0,0,0,,Хмм…
Dialogue: 0,0:20:47.32,0:20:50.87,Default,,0,0,0,,Бізді ұрыстырып, қолға түсірейік.
Dialogue: 0,0:20:50.95,0:20:53.62,Default,,0,0,0,,Әлгі мырза мұны істемеуді жөн көрді.
Dialogue: 0,0:20:54.54,0:20:57.25,Default,,0,0,0,,Басқа жігіттер мұны істегісі келген сияқты.
Dialogue: 0,0:20:58.13,0:21:03.01,Default,,0,0,0,,Хиджиката – менің олжам. Маған тиіссең, мен сені өлтіремін.
Dialogue: 0,0:21:03.09,0:21:04.97,Default,,0,0,0,,О, қорқынышты
Dialogue: 0,0:21:05.05,0:21:06.01,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:21:14.10,0:21:18.19,Default,,0,0,0,,Наозуми-сан, сен әлсізсің.
Dialogue: 0,0:21:18.27,0:21:21.19,Default,,0,0,0,,Хмф... хехехехе
Dialogue: 0,0:21:21.27,0:21:22.48,Default,,0,0,0,,Не?
Dialogue: 0,0:21:23.07,0:21:27.82,Default,,0,0,0,,Хаха, бірақ бұл ақ шаш күлкілі болды.
Dialogue: 0,0:21:27.91,0:21:30.16,Default,,0,0,0,,Қызық екен, балалар.
Dialogue: 0,0:21:30.66,0:21:31.95,Default,,0,0,0,,Иә
Dialogue: 0,0:21:32.91,0:21:34.25,Default,,0,0,0,,Мибро
Dialogue: 0,0:21:36.29,0:21:37.37,Default,,0,0,0,,О
Dialogue: 0,0:21:40.13,0:21:45.01,Default,,0,0,0,,Олар міндетті түрде фестивальдің жұлдыздары болады.
Dialogue: 0,0:21:50.97,0:21:55.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:14.18,0:23:19.18,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.35,0:23:24.86,Default,,0,0,0,,Бір күні бұл сөзсіз болады
Dialogue: 0,0:23:24.94,0:23:27.90,Default,,0,0,0,,Мибро мен қанды Рисшидан арасындағы шайқас
Dialogue: 0,0:23:27.98,0:23:34.28,Default,,0,0,0,,Осы уақытта лорд Иемочиді қорғаған инелік Ниджо қамалына әкелінді.
Dialogue: 0,0:23:34.37,0:23:37.54,Default,,0,0,0,,Күтпеген тәжірибе алыңыз
Dialogue: 0,0:23:37.62,0:23:40.62,Default,,0,0,0,,Бұл Mibro-ға да қатысты.
Dialogue: 0,0:23:40.71,0:23:44.88,Default,,0,0,0,,Бұл жаңа бірлікке мүмкіндік болды.
Dialogue: 0,0:23:44.96,0:23:48.96,Default,,0,0,0,,Келесі жолы «Бір арманды салу»
Dialogue: 0,0:23:49.05,0:23:50.55,Default,,0,0,0,,Бізбен болыңыз
Dialogue: 0,0:23:52.05,0:23:58.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
