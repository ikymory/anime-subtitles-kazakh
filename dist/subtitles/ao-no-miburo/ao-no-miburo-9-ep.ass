Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.58,0:00:03.83,Default,,0,0,0,,Осылайша, біз Мибро
Dialogue: 0,0:00:03.92,0:00:06.92,Default,,0,0,0,,Айзу руының қарауында қалды.
Dialogue: 0,0:00:07.00,0:00:09.59,Default,,0,0,0,,Керемет! Шинсенгуми күшті!
Dialogue: 0,0:00:09.67,0:00:11.72,Default,,0,0,0,,Біз барлық жаман адамдарды ұстадық!
Dialogue: 0,0:00:11.80,0:00:13.84,Default,,0,0,0,,Сәлем, Нагакура мырза
Dialogue: 0,0:00:13.93,0:00:16.64,Default,,0,0,0,,- (Ұлдар) Иә? -(Нагакура) Иә? Бұл не?
Dialogue: 0,0:00:16.72,0:00:20.06,Default,,0,0,0,,Шинсенгуми тобының ең күшті мүшесі кім болды?
Dialogue: 0,0:00:20.14,0:00:22.98,Default,,0,0,0,,Ең күштісі ме...
Dialogue: 0,0:00:23.52,0:00:27.19,Default,,0,0,0,,Иә, солай емес пе...
Dialogue: 0,0:00:29.86,0:00:32.32,Default,,0,0,0,,Миброда кім шынымен күшті?
Dialogue: 0,0:00:33.03,0:00:35.61,Default,,0,0,0,,Ең соңғы болып кім қалады?
Dialogue: 0,0:00:36.20,0:00:39.95,Default,,0,0,0,,1-ші Мибро ішу турнирі!
Dialogue: 0,0:00:40.04,0:00:42.37,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:00:42.45,0:00:47.46,Default,,0,0,0,,♪～
Dialogue: 0,0:02:06.91,0:02:11.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:12.50,0:02:15.96,Default,,0,0,0,,(Сарбаздардың күлкісі)
Dialogue: 0,0:02:16.05,0:02:19.72,Default,,0,0,0,,Түннің бір уағында, дауысыңызды сәл бәсеңдетіңіз.
Dialogue: 0,0:02:19.80,0:02:21.64,Default,,0,0,0,,(Нагакураның күлкісі)
Dialogue: 0,0:02:21.72,0:02:23.60,Default,,0,0,0,,Маған қарыздар Яги мырзадан
Dialogue: 0,0:02:23.68,0:02:27.06,Default,,0,0,0,,Маған қамқор болғаныңыз үшін құттықтау ретінде сусын берді...
Dialogue: 0,0:02:27.68,0:02:30.15,Default,,0,0,0,,Бұл осындай дүрбелең тудырды.
Dialogue: 0,0:02:30.65,0:02:33.23,Default,,0,0,0,,Қорытындыны профессор Серизава жасады.
Dialogue: 0,0:02:33.31,0:02:34.44,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:34.52,0:02:36.53,Default,,0,0,0,,Ондо – Кондо мырза
Dialogue: 0,0:02:36.99,0:02:38.03,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:39.78,0:02:41.99,Default,,0,0,0,,Максималды сақтау орны
Dialogue: 0,0:02:42.07,0:02:44.53,Default,,0,0,0,,Сақтау…
Dialogue: 0,0:02:44.62,0:02:46.29,Default,,0,0,0,,Бұл... Кондо мырза!
Dialogue: 0,0:02:46.37,0:02:48.12,Default,,0,0,0,,Кім соңына дейін қалады?
Dialogue: 0,0:02:48.20,0:02:50.21,Default,,0,0,0,,- (Харада) Бұл менмін! -(Серизава) Болды!
Dialogue: 0,0:02:51.54,0:02:53.21,Default,,0,0,0,,Бұл адам өте төмен.
Dialogue: 0,0:02:53.29,0:02:55.04,Default,,0,0,0,,Неге оны тоқтатпайсың!
Dialogue: 0,0:02:58.51,0:03:00.97,Default,,0,0,0,,Мәйітті қасыңа лақтыр.
Dialogue: 0,0:03:01.05,0:03:02.34,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:03:02.43,0:03:05.47,Default,,0,0,0,,- (Тодо) Әйтеуір, ән ғой! -(Харада) Іш!
Dialogue: 0,0:03:07.56,0:03:10.23,Default,,0,0,0,,Әкем ішсе жайдары көрінеді...
Dialogue: 0,0:03:10.31,0:03:11.48,Default,,0,0,0,,(Нагакураның ықыласы)
Dialogue: 0,0:03:11.56,0:03:12.52,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:03:12.60,0:03:13.98,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:03:14.06,0:03:17.19,Default,,0,0,0,,Бұл жара сеппуку тыртығы.
Dialogue: 0,0:03:17.28,0:03:18.65,Default,,0,0,0,,Бұл кальмар~
Dialogue: 0,0:03:18.74,0:03:20.74,Default,,0,0,0,,Неге барлық киімдеріңді шешіп жатырсыңдар?
Dialogue: 0,0:03:20.82,0:03:23.24,Default,,0,0,0,,Арзан саке
Dialogue: 0,0:03:23.32,0:03:25.45,Default,,0,0,0,,Мас болғанша бәрі жақсы.
Dialogue: 0,0:03:25.53,0:03:26.49,Default,,0,0,0,,- (Яманан) Сондықтан да! -о?
Dialogue: 0,0:03:26.58,0:03:28.16,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:03:28.24,0:03:30.62,Default,,0,0,0,,Дайынсың ба деп сұрадым!
Dialogue: 0,0:03:30.71,0:03:31.87,Default,,0,0,0,,Иә? Эй!
Dialogue: 0,0:03:31.96,0:03:35.29,Default,,0,0,0,,Яманами мырза, қабырғаға не айтып тұрсыз?
Dialogue: 0,0:03:35.38,0:03:37.34,Default,,0,0,0,,Мен қалдырдым, қалдырдым!
Dialogue: 0,0:03:37.42,0:03:39.42,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:03:40.76,0:03:41.67,Default,,0,0,0,,Иә
Dialogue: 0,0:03:41.76,0:03:43.72,Default,,0,0,0,,Хмф, бұл қоқыс.
Dialogue: 0,0:03:44.76,0:03:46.43,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:03:47.51,0:03:48.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:48.77,0:03:50.93,Default,,0,0,0,,Тек иіс мені басып жатыр!
Dialogue: 0,0:03:51.02,0:03:56.44,Default,,0,0,0,,(Сарбаздардың ұйықтауы)
Dialogue: 0,0:03:56.52,0:03:58.52,Default,,0,0,0,,(Хараданың қорылдауы)
Dialogue: 0,0:04:02.03,0:04:06.20,Default,,0,0,0,,Аяқтауға жақын. Бұл енді қайталанбайды деп үміттенемін.
Dialogue: 0,0:04:06.99,0:04:07.95,Default,,0,0,0,,Не қалды...
Dialogue: 0,0:04:08.66,0:04:11.96,Default,,0,0,0,,Хиджиката мен Серизава мырзаның арасындағы жалғыз шайқас
Dialogue: 0,0:04:13.21,0:04:14.21,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:17.00,0:04:18.67,Default,,0,0,0,,О...
Dialogue: 0,0:04:18.75,0:04:19.96,Default,,0,0,0,,Хиджиката
Dialogue: 0,0:04:20.05,0:04:24.51,Default,,0,0,0,,Сізбен бір рет отырып, сөйлесу жақсы идея болуы мүмкін.
Dialogue: 0,0:04:24.59,0:04:25.72,Default,,0,0,0,,Хо
Dialogue: 0,0:04:26.68,0:04:29.10,Default,,0,0,0,,Мысалы, сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:29.18,0:04:31.47,Default,,0,0,0,,Миброның болашағы
Dialogue: 0,0:04:33.69,0:04:36.90,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:04:37.61,0:04:40.90,Default,,0,0,0,,Алдағы Айзу қамқорлығы туралы
Dialogue: 0,0:04:40.98,0:04:44.49,Default,,0,0,0,,Сіз бұл туралы көп ойламайтын сияқтысыз.
Dialogue: 0,0:04:46.36,0:04:47.78,Default,,0,0,0,,Бөлек
Dialogue: 0,0:04:47.87,0:04:51.24,Default,,0,0,0,,Мен бұл шынымен қажет пе деп ойлаймын.
Dialogue: 0,0:04:51.33,0:04:53.91,Default,,0,0,0,,Қолдау қажет
Dialogue: 0,0:04:54.41,0:04:55.25,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:04:55.83,0:04:59.00,Default,,0,0,0,,Егер сіз зорлық-зомбылық жасасаңыз да, сізге аздап қисынсыз болуға рұқсат етіледі.
Dialogue: 0,0:04:59.88,0:05:01.00,Default,,0,0,0,,(Хиджикатаның күрсінуі)
Dialogue: 0,0:05:01.75,0:05:02.88,Default,,0,0,0,,Серизава мырза
Dialogue: 0,0:05:03.38,0:05:05.59,Default,,0,0,0,,Біз өзімшіл болып қала береміз
Dialogue: 0,0:05:05.68,0:05:08.14,Default,,0,0,0,,Мен мұнда қалағанымды істеу үшін келген жоқпын.
Dialogue: 0,0:05:08.22,0:05:10.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:10.22,0:05:13.39,Default,,0,0,0,,Мен өзім қалаған нәрсені істеу үшін туғанмын!
Dialogue: 0,0:05:13.47,0:05:15.23,Default,,0,0,0,,Әрине!
Dialogue: 0,0:05:16.56,0:05:18.73,Default,,0,0,0,,Мұны істеуге не мәжбүр етеді?
Dialogue: 0,0:05:20.36,0:05:22.11,Default,,0,0,0,,Не?
Dialogue: 0,0:05:27.99,0:05:29.24,Default,,0,0,0,,Тасбақаны алмаңыз...
Dialogue: 0,0:05:29.32,0:05:30.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:31.41,0:05:35.58,Default,,0,0,0,,Ағам бүркіттің тасбақасын басып қалды.
Dialogue: 0,0:05:35.66,0:05:37.33,Default,,0,0,0,,А... неге?
Dialogue: 0,0:05:37.42,0:05:39.75,Default,,0,0,0,,Мен аудармасын білмеймін!
Dialogue: 0,0:05:39.83,0:05:44.63,Default,,0,0,0,,Мен сені ұрдым, жынды мета!
Dialogue: 0,0:05:44.71,0:05:50.26,Default,,0,0,0,,Бет... БУХАХАХАХАХА! Оның көлемі екі есеге жуық өсті!
Dialogue: 0,0:05:50.35,0:05:53.68,Default,,0,0,0,,Бірақ оған көмектесу мүмкін емес деп ойлаймын...
Dialogue: 0,0:05:53.77,0:05:56.02,Default,,0,0,0,,Мен Серизава-санның сезімін толық түсінемін.
Dialogue: 0,0:05:56.77,0:05:57.85,Default,,0,0,0,,Иә
Dialogue: 0,0:05:57.94,0:06:03.61,Default,,0,0,0,,Бөлмемде үш күн тамақсыз қалуға бұйрық берген мен едім.
Dialogue: 0,0:06:03.69,0:06:05.69,Default,,0,0,0,,Өйткені ол төртінші ұл болды
Dialogue: 0,0:06:07.03,0:06:11.62,Default,,0,0,0,,Мен бұл дұрыс емес деп ойладым. Мен бұл ақылға қонымсыз деп ойладым.
Dialogue: 0,0:06:12.49,0:06:15.29,Default,,0,0,0,,Бірақ қыран күшті болды.
Dialogue: 0,0:06:15.37,0:06:18.87,Default,,0,0,0,,Сондықтан мен бәрін алуды шештім.
Dialogue: 0,0:06:18.96,0:06:23.13,Default,,0,0,0,,Мен сарайды қалайтын ең жақсы әйелді қалаймын
Dialogue: 0,0:06:23.84,0:06:26.42,Default,,0,0,0,,Мен қырандар елін қалаймын
Dialogue: 0,0:06:28.22,0:06:30.89,Default,,0,0,0,,Бұл оқиға күлкілі ме?
Dialogue: 0,0:06:30.97,0:06:32.72,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:06:34.47,0:06:36.52,Default,,0,0,0,,Мысалы, қамал
Dialogue: 0,0:06:36.60,0:06:38.64,Default,,0,0,0,,Кез келген жерде құрылыс салуға болады ма?
Dialogue: 0,0:06:38.73,0:06:41.52,Default,,0,0,0,,Хмм, сіз нені айтып тұрсыз?
Dialogue: 0,0:06:41.60,0:06:44.57,Default,,0,0,0,,Егер мен құрастыратын болсам, ол Хино болар еді.
Dialogue: 0,0:06:44.65,0:06:46.61,Default,,0,0,0,,Эдоның шетіндегі ауылдық жер
Dialogue: 0,0:06:48.36,0:06:52.16,Default,,0,0,0,,Мен Токугава сегунатының Тенрио деген Тамада өстім.
Dialogue: 0,0:06:52.24,0:06:55.37,Default,,0,0,0,,Бәрі қанағаттандырылмаса да
Dialogue: 0,0:06:55.45,0:06:57.08,Default,,0,0,0,,Бұл жаман болған жоқ.
Dialogue: 0,0:06:57.16,0:06:58.12,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:06:58.62,0:07:01.04,Default,,0,0,0,,Мен өскен қаланы мен шынымен түсінемін
Dialogue: 0,0:07:01.12,0:07:02.17,Default,,0,0,0,,үшінн қайта әкелу – басты мақсат.
Dialogue: 0,0:07:02.25,0:07:05.67,Default,,0,0,0,,Бүркіт ауылдан шығып, босатылды.
Dialogue: 0,0:07:05.75,0:07:07.80,Default,,0,0,0,,Менде ешқандай алғыс жоқ!
Dialogue: 0,0:07:08.84,0:07:11.05,Default,,0,0,0,,Туған жеріңе байланып қалма!
Dialogue: 0,0:07:11.13,0:07:15.30,Default,,0,0,0,,Қай жерде болсаңыз да күресуді жалғастырыңыз
Dialogue: 0,0:07:15.39,0:07:18.56,Default,,0,0,0,,Мен осындамын деп айқайлай бер
Dialogue: 0,0:07:18.64,0:07:20.06,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:07:20.85,0:07:23.56,Default,,0,0,0,,Ол Хан деп аталады.
Dialogue: 0,0:07:24.15,0:07:26.65,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:31.90,0:07:33.24,Default,,0,0,0,,Бұл
Dialogue: 0,0:07:33.32,0:07:37.83,Default,,0,0,0,,Мен осы өскен қаланы қорғағым келеді...
Dialogue: 0,0:07:38.45,0:07:40.54,Default,,0,0,0,,Қаланы қорғағың келе ме?
Dialogue: 0,0:07:40.62,0:07:42.87,Default,,0,0,0,,Бір адам мұны істей ала ма?
Dialogue: 0,0:07:42.96,0:07:44.58,Default,,0,0,0,,Тәкаппар болма
Dialogue: 0,0:07:45.84,0:07:49.67,Default,,0,0,0,,Уф... Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:07:49.76,0:07:50.80,Default,,0,0,0,,Ұйқы!
Dialogue: 0,0:07:56.39,0:07:58.35,Default,,0,0,0,,Мен сендерге елестетулеріңді айтып отырмын.
Dialogue: 0,0:07:59.39,0:08:02.73,Default,,0,0,0,,Сенің бұл қалаға көңіл бөлетініңді білемін.
Dialogue: 0,0:08:03.23,0:08:05.86,Default,,0,0,0,,Бірақ егер сізді қаладан қуып жіберсе ше?
Dialogue: 0,0:08:06.44,0:08:08.11,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:08:09.65,0:08:13.36,Default,,0,0,0,,Серизава осылай айтқан шығар.
Dialogue: 0,0:08:14.41,0:08:15.78,Default,,0,0,0,,Ойланып көрші.
Dialogue: 0,0:08:16.53,0:08:17.87,Default,,0,0,0,,- (Хиджиката) Мен де ұйықтаймын - Ах.
Dialogue: 0,0:08:25.58,0:08:27.04,Default,,0,0,0,,Қаладан кетсем ше?
Dialogue: 0,0:08:27.54,0:08:30.17,Default,,0,0,0,,Білмеймін, не істеуім керек?
Dialogue: 0,0:08:30.25,0:08:31.46,Default,,0,0,0,,(шодзи ашу дыбысы)
Dialogue: 0,0:08:31.55,0:08:33.97,Default,,0,0,0,,үшін ұйықтады ма?
Dialogue: 0,0:08:34.05,0:08:36.43,Default,,0,0,0,,Күн шығуға жақын
Dialogue: 0,0:08:36.93,0:08:38.80,Default,,0,0,0,,Саған бұл қала ұнай ма, Таро?
Dialogue: 0,0:08:38.89,0:08:42.35,Default,,0,0,0,,Сен мені сүйе алмайсың! Мен талай рет өлгім келді
Dialogue: 0,0:08:42.43,0:08:43.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:44.56,0:08:47.36,Default,,0,0,0,,Маған бұл қала неліктен ұнайды?
Dialogue: 0,0:08:47.86,0:08:48.69,Default,,0,0,0,,(Ироха мен әжемнің күлкісі)
Dialogue: 0,0:08:48.77,0:08:50.86,Default,,0,0,0,,Ироха әже
Dialogue: 0,0:08:51.53,0:08:54.11,Default,,0,0,0,,Мен біреуді жыныссыз түрде кездестіргім келетінін сеземін.
Dialogue: 0,0:08:54.20,0:08:56.11,Default,,0,0,0,,- (Инуэ) Ух... - (Таро) Ах.
Dialogue: 0,0:08:57.57,0:09:00.12,Default,,0,0,0,,Әй, бір адам әлі ояу!
Dialogue: 0,0:09:02.20,0:09:03.62,Default,,0,0,0,,Инуэ мырза!
Dialogue: 0,0:09:03.70,0:09:07.17,Default,,0,0,0,,Мен... жеңдім...
Dialogue: 0,0:09:07.71,0:09:12.88,Default,,0,0,0,,Ішімдік ішу сайысының жеңімпазы - Гензабуро Инуэ
Dialogue: 0,0:09:12.96,0:09:16.80,Default,,0,0,0,,Бірақ ол тарихта қалмайды.
Dialogue: 0,0:09:20.47,0:09:23.27,Default,,0,0,0,,Бүгін ештеңе болмайды.
Dialogue: 0,0:09:23.35,0:09:25.14,Default,,0,0,0,,Бұдан артық ештеңе жоқ.
Dialogue: 0,0:09:25.23,0:09:28.40,Default,,0,0,0,,Иә, бірақ... Әй?
Dialogue: 0,0:09:30.48,0:09:34.40,Default,,0,0,0,,Бұл сенің әжеңнің тұшпара дүкені емес пе?
Dialogue: 0,0:09:34.49,0:09:35.65,Default,,0,0,0,,Иә
Dialogue: 0,0:09:35.74,0:09:38.32,Default,,0,0,0,,Күтілгендей, ол қазір жабық.
Dialogue: 0,0:09:44.91,0:09:46.58,Default,,0,0,0,,Келейік
Dialogue: 0,0:09:46.66,0:09:48.25,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:09:48.33,0:09:52.00,Default,,0,0,0,,Ха~ Мен оданго жегім келеді~
Dialogue: 0,0:09:52.96,0:09:55.38,Default,,0,0,0,,Мибро жалаушасын жасайық
Dialogue: 0,0:09:55.46,0:09:56.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:57.51,0:09:58.97,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:09:59.05,0:10:01.22,Default,,0,0,0,,Жақсы идея болуы мүмкін
Dialogue: 0,0:10:01.30,0:10:05.14,Default,,0,0,0,,Жалау көргендердің жаман істерден тыйылар.
Dialogue: 0,0:10:05.22,0:10:07.56,Default,,0,0,0,,Жоқ, бұл керемет.
Dialogue: 0,0:10:07.64,0:10:10.65,Default,,0,0,0,,Мен әрқашан Ако Ронинді ұнататынмын.
Dialogue: 0,0:10:12.06,0:10:13.15,Default,,0,0,0,,Жалау?
Dialogue: 0,0:10:13.23,0:10:16.40,Default,,0,0,0,,Менің ойымша, бәрімізде сәйкес хаори болса жақсы болар еді.
Dialogue: 0,0:10:16.49,0:10:18.11,Default,,0,0,0,,Мен солай ойладым...
Dialogue: 0,0:10:18.20,0:10:19.78,Default,,0,0,0,,- (Окита және басқалар) Міне! -Апыр-ай!
Dialogue: 0,0:10:21.57,0:10:22.87,Default,,0,0,0,,Мен қандай хаори киюім керек?
Dialogue: 0,0:10:22.95,0:10:24.66,Default,,0,0,0,,Ол стильді және әдемі жігіт!
Dialogue: 0,0:10:24.74,0:10:26.25,Default,,0,0,0,,Жоқ, жалау...
Dialogue: 0,0:10:26.33,0:10:27.75,Default,,0,0,0,,- (Хиджиката) Күте тұрыңыз - (Окита және т.б.) Иә?
Dialogue: 0,0:10:28.58,0:10:31.92,Default,,0,0,0,,Сәнді киімдер туралы ойлау Бір кемпір тұшпара цехын басқарады.
Dialogue: 0,0:10:33.21,0:10:36.76,Default,,0,0,0,,Бұл сенің әжең ғой, солай ма?
Dialogue: 0,0:10:36.84,0:10:39.05,Default,,0,0,0,,Сіз бұл қызметке әбден лайықсыз деп ойлаймын.
Dialogue: 0,0:10:39.13,0:10:40.76,Default,,0,0,0,,Хиджиката мырза...
Dialogue: 0,0:10:40.84,0:10:41.68,Default,,0,0,0,,Иә
Dialogue: 0,0:10:44.01,0:10:45.93,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:10:46.02,0:10:47.81,Default,,0,0,0,,Серизава мырза
Dialogue: 0,0:10:47.89,0:10:51.94,Default,,0,0,0,,Біз сәйкес хаориді әскери киімге айналдыру туралы айтып отырмыз.
Dialogue: 0,0:10:52.02,0:10:53.23,Default,,0,0,0,,Әскери форма?
Dialogue: 0,0:10:53.31,0:10:54.15,Default,,0,0,0,,Жалау…
Dialogue: 0,0:10:54.23,0:10:56.65,Default,,0,0,0,,Сізге қалдырсам, қарсысыз ба?
Dialogue: 0,0:10:58.36,0:10:59.82,Default,,0,0,0,,Түсі Асаги...
Dialogue: 0,0:10:59.90,0:11:02.41,Default,,0,0,0,,Ах, кешегі ішімдік тойы.
Dialogue: 0,0:11:02.49,0:11:04.37,Default,,0,0,0,,Жеңімпаз Инуэ мырза болды.
Dialogue: 0,0:11:04.45,0:11:05.28,Default,,0,0,0,,Иә
Dialogue: 0,0:11:05.37,0:11:07.91,Default,,0,0,0,,Жоқ... кір!
Dialogue: 0,0:11:08.00,0:11:10.83,Default,,0,0,0,,Мұның бұған еш қатысы жоқ!
Dialogue: 0,0:11:10.92,0:11:12.12,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:13.42,0:11:17.25,Default,,0,0,0,,Бірақ оның ерекше екеніне көз жеткізіңіз.
Dialogue: 0,0:11:18.26,0:11:19.51,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:19.59,0:11:21.76,Default,,0,0,0,,-(Хиджиката)-ға өтіңіз -Иә.
Dialogue: 0,0:11:22.72,0:11:24.64,Default,,0,0,0,,Таро, сен де бар.
Dialogue: 0,0:11:24.72,0:11:25.76,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:11:25.85,0:11:27.77,Default,,0,0,0,,Алдымен сіз де баруыңыз керек.
Dialogue: 0,0:11:27.85,0:11:28.72,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:11:28.81,0:11:31.27,Default,,0,0,0,,Бұл тамаша. Балалар командасы ретінде.
Dialogue: 0,0:11:31.35,0:11:34.27,Default,,0,0,0,,Маған бала сияқты қарама!
Dialogue: 0,0:11:35.27,0:11:36.40,Default,,0,0,0,,Үш митараши
Dialogue: 0,0:11:36.48,0:11:37.53,Default,,0,0,0,,Мен қарсыласымды өлтіру үшін келген жоқпын
Dialogue: 0,0:11:37.61,0:11:40.95,Default,,0,0,0,,Әй, кемпір, мына дсензай әлі осында ма?
Dialogue: 0,0:11:41.03,0:11:42.32,Default,,0,0,0,,Жарты сағаттай күтіңіз...
Dialogue: 0,0:11:42.41,0:11:43.53,Default,,0,0,0,,Шулы
Dialogue: 0,0:11:43.61,0:11:46.37,Default,,0,0,0,,Жәй ғана шағымданбай, аз да болса көмектес!
Dialogue: 0,0:11:46.45,0:11:47.33,Default,,0,0,0,,-Әже - (Әже) А?
Dialogue: 0,0:11:47.41,0:11:49.37,Default,,0,0,0,,Мен қазір оралдым.
Dialogue: 0,0:11:50.83,0:11:52.50,Default,,0,0,0,,Мен осы құдай таңдаған ессіз ғалыммын…
Dialogue: 0,0:11:52.58,0:11:53.71,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:11:54.50,0:11:56.79,Default,,0,0,0,,О... сен
Dialogue: 0,0:11:56.88,0:11:57.80,Default,,0,0,0,,Әже
Dialogue: 0,0:11:58.46,0:11:59.59,Default,,0,0,0,,Кім?
Dialogue: 0,0:11:59.67,0:12:02.09,Default,,0,0,0,,niodayo ni! Ұмытып қалдыңыз ба?
Dialogue: 0,0:12:02.17,0:12:03.30,Default,,0,0,0,,Сіз бұлыңғырсыз ба?
Dialogue: 0,0:12:03.38,0:12:07.30,Default,,0,0,0,,Кім ақымақ? Мен сенің не айтып тұрғаныңды білемін
Dialogue: 0,0:12:07.39,0:12:10.14,Default,,0,0,0,,Бірақ сенің көздерің...
Dialogue: 0,0:12:10.22,0:12:11.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:11.14,0:12:12.35,Default,,0,0,0,,- (Таро) Ии... - (Әже) Бұл кім?
Dialogue: 0,0:12:12.44,0:12:15.40,Default,,0,0,0,,Таро-кун мен Хаджиме-кун бір Мибродан.
Dialogue: 0,0:12:15.86,0:12:16.69,Default,,0,0,0,,Хун
Dialogue: 0,0:12:17.27,0:12:19.07,Default,,0,0,0,,О...
Dialogue: 0,0:12:19.78,0:12:22.15,Default,,0,0,0,,Жұмысшылар саны өсті.
Dialogue: 0,0:12:22.24,0:12:23.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:23.99,0:12:27.83,Default,,0,0,0,,Йо... Окошиясу Чиринуяға қош келдіңіз
Dialogue: 0,0:12:27.91,0:12:29.66,Default,,0,0,0,,Бастапқыда менің даусым баяу шықты.
Dialogue: 0,0:12:29.74,0:12:32.96,Default,,0,0,0,,Әй... Мен самураймын. Мен мұны істей аламын ба?
Dialogue: 0,0:12:33.04,0:12:34.71,Default,,0,0,0,,Оның самурайға қатысы жоқ.
Dialogue: 0,0:12:35.83,0:12:37.33,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:12:37.42,0:12:40.80,Default,,0,0,0,,Екеуіңізге де данго қосылды. Сізге көп рахмет.
Dialogue: 0,0:12:40.88,0:12:41.96,Default,,0,0,0,,Гочисусан
Dialogue: 0,0:12:42.05,0:12:43.22,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:43.30,0:12:45.89,Default,,0,0,0,,үшінн бірден жіберсеңіз, 60 сөйлем болады.
Dialogue: 0,0:12:45.97,0:12:48.72,Default,,0,0,0,,Таро: Иә, сен қиылып қалдың!
Dialogue: 0,0:12:48.80,0:12:51.22,Default,,0,0,0,,Бұл қандай да бір жақсы сезінеді.
Dialogue: 0,0:12:51.31,0:12:53.48,Default,,0,0,0,,Түсіндім, орында!
Dialogue: 0,0:12:53.56,0:12:55.35,Default,,0,0,0,,Кешіріңіз, Данго...
Dialogue: 0,0:12:55.44,0:12:58.19,Default,,0,0,0,,Тұшпара же, қалдырма.
Dialogue: 0,0:12:58.27,0:12:59.73,Default,,0,0,0,,Сені қорқытудың мәні неде?
Dialogue: 0,0:12:59.82,0:13:02.11,Default,,0,0,0,,Тароға еріңіз
Dialogue: 0,0:13:03.03,0:13:05.49,Default,,0,0,0,,Бұл менің тиесілі жерім!
Dialogue: 0,0:13:05.57,0:13:06.91,Default,,0,0,0,,Гочисусан
Dialogue: 0,0:13:06.99,0:13:08.49,Default,,0,0,0,,Қалғандары жақсы ілгерілеп жатыр ма екен?
Dialogue: 0,0:13:08.57,0:13:10.99,Default,,0,0,0,,Иә, бүгін дүкен жабық.
Dialogue: 0,0:13:11.08,0:13:13.33,Default,,0,0,0,,Егер ол бізбен бірге қалса, қауіп-қатерде болады.
Dialogue: 0,0:13:13.41,0:13:14.37,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:13:14.46,0:13:17.12,Default,,0,0,0,,Таро, сен іскерсің.
Dialogue: 0,0:13:17.21,0:13:19.63,Default,,0,0,0,,Әйтеуір жылауымды тыя алмаймын.
Dialogue: 0,0:13:19.71,0:13:20.63,Default,,0,0,0,,Хмм…
Dialogue: 0,0:13:20.71,0:13:22.63,Default,,0,0,0,,-(Әже) Жүр, жинап алайық. -Не?
Dialogue: 0,0:13:22.71,0:13:24.30,Default,,0,0,0,,Тез орындайық~
Dialogue: 0,0:13:24.38,0:13:25.63,Default,,0,0,0,,- (Таро) Иә - Уфуфу
Dialogue: 0,0:13:30.05,0:13:30.93,Default,,0,0,0,,Жылы…
Dialogue: 0,0:13:31.01,0:13:34.48,Default,,0,0,0,,Әженің арқасы сәл кішірейіп кетті.
Dialogue: 0,0:13:35.14,0:13:36.23,Default,,0,0,0,,Күшті
Dialogue: 0,0:13:36.31,0:13:38.35,Default,,0,0,0,,Не? Әже?
Dialogue: 0,0:13:38.44,0:13:41.23,Default,,0,0,0,,Аа, мен залдамын деп ойлаймын.
Dialogue: 0,0:13:42.11,0:13:46.07,Default,,0,0,0,,Әдетте мұндай кемпір өз бетімен бәрін реттей алмайды.
Dialogue: 0,0:13:46.15,0:13:48.45,Default,,0,0,0,,Бұл дүкен өте кең.
Dialogue: 0,0:13:48.53,0:13:50.53,Default,,0,0,0,,Шинигами қалай өледі екен.
Dialogue: 0,0:13:50.62,0:13:52.28,Default,,0,0,0,,Бұл күшті
Dialogue: 0,0:13:52.37,0:13:55.50,Default,,0,0,0,,Бұл жай ғана әскери күш емес, бұл осындай күш.
Dialogue: 0,0:13:56.25,0:13:59.88,Default,,0,0,0,,Күнделікті өміріңізді үнсіз жалғастыра беріңіз
Dialogue: 0,0:13:59.96,0:14:01.50,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:14:04.55,0:14:08.47,Default,,0,0,0,,Бұл дүкен бір кездері өртеніп кеткен.
Dialogue: 0,0:14:09.09,0:14:12.68,Default,,0,0,0,,Бірақ біз мұнда-мұнда ақшаны қарызға алып, оны қалпына келтірсек те.
Dialogue: 0,0:14:12.76,0:14:14.06,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:14:14.64,0:14:17.27,Default,,0,0,0,,Сөйтіп мені әпкем Ирохая қабылдады.
Dialogue: 0,0:14:17.35,0:14:18.94,Default,,0,0,0,,Ол мені өсірді.
Dialogue: 0,0:14:20.27,0:14:23.61,Default,,0,0,0,,Мұндай күш қайдан келеді?
Dialogue: 0,0:14:24.32,0:14:25.94,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:14:26.53,0:14:28.20,Default,,0,0,0,,Мен де кемпір сияқтымын
Dialogue: 0,0:14:28.28,0:14:31.70,Default,,0,0,0,,Мен біреуді қорғай алатын мықты адам болғым келеді.
Dialogue: 0,0:14:31.78,0:14:33.53,Default,,0,0,0,,Сол жігіттің байланыс мәліметтері қандай?
Dialogue: 0,0:14:35.45,0:14:39.37,Default,,0,0,0,,Енді мен үйден кетіп, оны Миброда оқимын.
Dialogue: 0,0:14:39.46,0:14:41.88,Default,,0,0,0,,Хмф, сол кемпірден қалған.
Dialogue: 0,0:14:41.96,0:14:42.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:43.46,0:14:46.30,Default,,0,0,0,,Мен сіздің ерсілігіңіздің себебін түсіндім деп ойлаймын.
Dialogue: 0,0:14:46.38,0:14:47.63,Default,,0,0,0,,Ах... Ахахха
Dialogue: 0,0:14:47.72,0:14:50.97,Default,,0,0,0,,Тезірек ішке кіріңіз!\NМен
Dialogue: 0,0:14:51.05,0:14:51.89,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:51.97,0:14:52.80,Default,,0,0,0,,Иә
Dialogue: 0,0:14:54.43,0:14:56.43,Default,,0,0,0,,туралы ұмытып қалдым
Dialogue: 0,0:14:56.52,0:14:57.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:57.52,0:14:59.52,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:14:59.60,0:15:03.19,Default,,0,0,0,,Оның көзі мен беті әлдеқайда жетілген.
Dialogue: 0,0:15:06.32,0:15:08.32,Default,,0,0,0,,(Экипаж мүшесі 1) Жұмысты жалғастырып, қазынаны көрсекші.
Dialogue: 0,0:15:08.90,0:15:10.90,Default,,0,0,0,,Иә, мен үйдемін!
Dialogue: 0,0:15:11.41,0:15:12.45,Default,,0,0,0,,Қайтып кел
Dialogue: 0,0:15:13.16,0:15:15.03,Default,,0,0,0,,Әженің жүзі көрінді
Dialogue: 0,0:15:15.53,0:15:16.74,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:15:16.83,0:15:19.71,Default,,0,0,0,,Бүгін менің үйімде үшеуіңіз қонақтасыздар.
Dialogue: 0,0:15:19.79,0:15:20.71,Default,,0,0,0,,Ха~!
Dialogue: 0,0:15:20.79,0:15:22.71,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:15:22.79,0:15:23.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:23.79,0:15:26.71,Default,,0,0,0,,Сіз мені ертең де жұмысқа тұрғызуды жоспарлайсыз ба?
Dialogue: 0,0:15:26.80,0:15:30.22,Default,,0,0,0,,♪ Түнеу түнде тұру
Dialogue: 0,0:15:30.30,0:15:32.80,Default,,0,0,0,,Сәйкес хаори?
Dialogue: 0,0:15:30.30,0:15:32.80,Default,,0,0,0,,♪ Мен өте қуаныштымын.
Dialogue: 0,0:15:32.89,0:15:36.43,Default,,0,0,0,,♪ Ұйқыға барғанына бәрі қуанады.
Dialogue: 0,0:15:32.89,0:15:36.43,Default,,0,0,0,,Иә, Хиджиката әжесінен бұл туралы ойлануын өтінді.
Dialogue: 0,0:15:36.43,0:15:36.51,Default,,0,0,0,,Иә, Хиджиката мырза әжесінен бұл туралы ойлануын өтінді.
Dialogue: 0,0:15:36.51,0:15:37.22,Default,,0,0,0,,Иә, Хиджиката мырза әжесінен бұл туралы ойлануын өтінді.
Dialogue: 0,0:15:36.51,0:15:37.22,Default,,0,0,0,,♪ Мен үйге бармаймын
Dialogue: 0,0:15:37.22,0:15:37.31,Default,,0,0,0,,♪ Мен үйге бармаймын
Dialogue: 0,0:15:37.31,0:15:38.14,Default,,0,0,0,,♪ Мен үйге бармаймын
Dialogue: 0,0:15:37.31,0:15:38.14,Default,,0,0,0,,Еркек сұраса мен бас тарта алмаймын...
Dialogue: 0,0:15:38.14,0:15:38.22,Default,,0,0,0,,Еркек сұраса мен бас тарта алмаймын...
Dialogue: 0,0:15:38.22,0:15:41.73,Default,,0,0,0,,Жарайды, еркек сұраса мен бас тарта алмаймын...
Dialogue: 0,0:15:38.22,0:15:41.73,Default,,0,0,0,,♪ үшін күлімдеп, түнеп жатыр
Dialogue: 0,0:15:41.81,0:15:47.40,Default,,0,0,0,,♪ Бәріміз әженің үйінде түнеп жатырмыз.
Dialogue: 0,0:15:47.48,0:15:49.23,Default,,0,0,0,,Өте шу болды!
Dialogue: 0,0:15:49.32,0:15:51.28,Default,,0,0,0,,Тароның көзінде нұр бар!
Dialogue: 0,0:15:52.32,0:15:55.87,Default,,0,0,0,,Хахахахаха Бұл қызық, Мибро.
Dialogue: 0,0:15:55.95,0:15:59.45,Default,,0,0,0,,Мен таң қалдым, бәрі ақымақ ішеді.
Dialogue: 0,0:15:59.54,0:16:00.79,Default,,0,0,0,,Олар ақымақ.
Dialogue: 0,0:16:01.62,0:16:03.87,Default,,0,0,0,,Дәмді! Бұл шын болу үшін тым жақсы, әже!
Dialogue: 0,0:16:03.96,0:16:06.54,Default,,0,0,0,,Қанша жақсы айтсаң да, бұл жай ғана мақсат.
Dialogue: 0,0:16:07.25,0:16:09.76,Default,,0,0,0,,Бірақ бұл Миброның жұмысы.
Dialogue: 0,0:16:09.84,0:16:12.55,Default,,0,0,0,,Жаман адамдарды өлтіріңіз
Dialogue: 0,0:16:12.63,0:16:15.47,Default,,0,0,0,,Балаңыздың жақсы екеніне сенімдісіз бе?
Dialogue: 0,0:16:15.55,0:16:17.30,Default,,0,0,0,,Егер сіз шатассаңыз, мен сізді қимаймын.
Dialogue: 0,0:16:18.06,0:16:19.43,Default,,0,0,0,,Біздің жұмысымыз
Dialogue: 0,0:16:19.52,0:16:22.77,Default,,0,0,0,,Киото халқы тыныш өмір сүруі үшін еңбек ет
Dialogue: 0,0:16:22.85,0:16:24.31,Default,,0,0,0,,Бұл қаланы қорғау туралы.
Dialogue: 0,0:16:25.44,0:16:27.06,Default,,0,0,0,,Қаланы қорғайсыз ба?
Dialogue: 0,0:16:27.98,0:16:31.32,Default,,0,0,0,,Біріншісі Эдодан шыққан Токугава Сёгунның қорғанысы болды.
Dialogue: 0,0:16:31.40,0:16:32.82,Default,,0,0,0,,Иә, бұл да маңызды.
Dialogue: 0,0:16:33.40,0:16:35.16,Default,,0,0,0,,Қаланы қорғаңыз...
Dialogue: 0,0:16:35.24,0:16:37.70,Default,,0,0,0,,Иә, бұл өте дұрыс.
Dialogue: 0,0:16:39.12,0:16:40.33,Default,,0,0,0,,Иә
Dialogue: 0,0:16:40.95,0:16:43.41,Default,,0,0,0,,Айтпақшы, Ироханың жағдайы қалай?
Dialogue: 0,0:16:43.50,0:16:46.83,Default,,0,0,0,,А, қалайсың? Маған анда-санда хаттар келеді.
Dialogue: 0,0:16:46.92,0:16:50.21,Default,,0,0,0,,Ироха осылай жазуды жек көретін.
Dialogue: 0,0:16:51.00,0:16:52.34,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін істеп жатырсыз.
Dialogue: 0,0:16:52.42,0:16:53.84,Default,,0,0,0,,Хехехе
Dialogue: 0,0:16:54.76,0:16:55.59,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:56.22,0:16:58.14,Default,,0,0,0,,Тамақ ішкеннен кейін келесі қадам - ​​ваннаға түсу.
Dialogue: 0,0:16:58.22,0:17:00.39,Default,,0,0,0,,Мен ваннаны жек көремін.
Dialogue: 0,0:17:00.47,0:17:04.69,Default,,0,0,0,,Иә, иә, мен кейінірек бос емеспін, тезірек кіруіңізді өтінемін.
Dialogue: 0,0:17:05.27,0:17:06.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:07.35,0:17:08.94,Default,,0,0,0,,Бұлай етпе, Нозокун
Dialogue: 0,0:17:09.02,0:17:10.19,Default,,0,0,0,,- Қараңыз ба? -Ахаха
Dialogue: 0,0:17:13.28,0:17:16.20,Default,,0,0,0,,Футонды көршімнен қарызға алдым.
Dialogue: 0,0:17:16.28,0:17:17.61,Default,,0,0,0,,Тар
Dialogue: 0,0:17:17.70,0:17:19.62,Default,,0,0,0,,Уау, иә!
Dialogue: 0,0:17:21.99,0:17:23.12,Default,,0,0,0,,Мен мұнда жақсымын
Dialogue: 0,0:17:23.20,0:17:25.08,Default,,0,0,0,,Олай болса, жақсы ұйықтай аласыз.
Dialogue: 0,0:17:25.16,0:17:27.71,Default,,0,0,0,,Самурайлар терең ұйықтамайды.
Dialogue: 0,0:17:27.79,0:17:29.71,Default,,0,0,0,,Түсіндім, бірінші!
Dialogue: 0,0:17:29.79,0:17:32.71,Default,,0,0,0,,Толқып кеткенім сонша, ұйықтай алмаймын.
Dialogue: 0,0:17:32.80,0:17:34.47,Default,,0,0,0,,Қазір ұйықтаңыз!
Dialogue: 0,0:17:38.22,0:17:39.26,Default,,0,0,0,,Әже
Dialogue: 0,0:17:39.85,0:17:41.47,Default,,0,0,0,,Не?
Dialogue: 0,0:17:41.56,0:17:44.14,Default,,0,0,0,,Кенеттен келгенім үшін кешіріңіз.
Dialogue: 0,0:17:44.22,0:17:45.23,Default,,0,0,0,,Мазасыздық тудырды ма?
Dialogue: 0,0:17:45.31,0:17:47.39,Default,,0,0,0,,Олай болмайтындай жағдай жоқ.
Dialogue: 0,0:17:47.48,0:17:49.23,Default,,0,0,0,,Сіз бұлай айту мүмкін емес.
Dialogue: 0,0:17:50.86,0:17:51.73,Default,,0,0,0,,Иә
Dialogue: 0,0:17:55.82,0:17:57.99,Default,,0,0,0,,Мені қаладан қуып жіберсе ше?
Dialogue: 0,0:17:58.61,0:18:00.16,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:18:01.24,0:18:02.66,Default,,0,0,0,,Егер осында...
Dialogue: 0,0:18:03.16,0:18:06.08,Default,,0,0,0,,Киотода бұдан былай тұру мүмкін болмаса, не істейсің?
Dialogue: 0,0:18:06.16,0:18:07.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:07.71,0:18:10.21,Default,,0,0,0,,Бұл не? Сіз қалжындап тұрсыз ба?
Dialogue: 0,0:18:10.29,0:18:11.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:12.00,0:18:13.09,Default,,0,0,0,,Маңызды әңгіме
Dialogue: 0,0:18:16.92,0:18:18.09,Default,,0,0,0,,Өлу
Dialogue: 0,0:18:18.18,0:18:20.34,Default,,0,0,0,,Кәрі қаңбақ осында өледі.
Dialogue: 0,0:18:20.43,0:18:23.60,Default,,0,0,0,,Егер сіз Киотода тұра алмасаңыз
Dialogue: 0,0:18:23.68,0:18:25.10,Default,,0,0,0,,Кәрі қаңбақ осында өледі.
Dialogue: 0,0:18:26.10,0:18:27.68,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:18:28.19,0:18:29.14,Default,,0,0,0,,Иә
Dialogue: 0,0:18:29.65,0:18:32.02,Default,,0,0,0,,Әжем осылай айтады деп ойладым.
Dialogue: 0,0:18:32.11,0:18:35.11,Default,,0,0,0,,Маған да бұл жер ұнайды, сондықтан мен де солай сезінемін.
Dialogue: 0,0:18:35.94,0:18:37.28,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:18:37.82,0:18:40.07,Default,,0,0,0,,Неліктен сіз бұған ерекше назар аударасыз?
Dialogue: 0,0:18:40.16,0:18:42.87,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:18:43.70,0:18:46.12,Default,,0,0,0,,Мен сізді шынымен бақылап жүрдім.
Dialogue: 0,0:18:46.83,0:18:47.87,Default,,0,0,0,,Қосылды ма?
Dialogue: 0,0:18:48.96,0:18:52.63,Default,,0,0,0,,ни Ироха, мен сенімен бірге тұра аламын.
Dialogue: 0,0:18:53.17,0:18:54.00,Default,,0,0,0,,Ах
Dialogue: 0,0:18:55.09,0:18:58.38,Default,,0,0,0,,Жалғыз болғандықтан мен шынымен солай ойлаймын.
Dialogue: 0,0:19:00.47,0:19:03.64,Default,,0,0,0,,Әже, мен бір нәрсе үшін кешірім сұрағым келеді...
Dialogue: 0,0:19:04.47,0:19:05.51,Default,,0,0,0,,Не?
Dialogue: 0,0:19:06.10,0:19:11.23,Default,,0,0,0,,Мен мұнда алғаш келгенімде Жаңа жылдық қонаққа баруды немесе фестивальге баруды ойладым.
Dialogue: 0,0:19:11.31,0:19:14.82,Default,,0,0,0,,Сіз мені талай рет шақырдыңыз, бірақ бас тарттыңыз.
Dialogue: 0,0:19:14.90,0:19:17.53,Default,,0,0,0,,Аа, сен басында солай істедің.
Dialogue: 0,0:19:17.61,0:19:19.74,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:19:19.82,0:19:22.36,Default,,0,0,0,,Сізді мақтайды деп ойлағаныңыз үшін.
Dialogue: 0,0:19:22.45,0:19:24.20,Default,,0,0,0,,Егер сіз ұстансаңыз немесе тартынсаңыз
Dialogue: 0,0:19:24.28,0:19:25.62,Default,,0,0,0,,Мен оны білдім.
Dialogue: 0,0:19:25.70,0:19:27.37,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:27.45,0:19:30.58,Default,,0,0,0,,Қалай ойлайсыңдар, қарт қанша жыл өмір сүреді?
Dialogue: 0,0:19:30.66,0:19:35.00,Default,,0,0,0,,Көзімді жұмсам да есімде
Dialogue: 0,0:19:35.09,0:19:38.09,Default,,0,0,0,,Бала екенсің, түсінбейсің.
Dialogue: 0,0:19:39.13,0:19:42.84,Default,,0,0,0,,Бала тәрбиесі біртүрлі.
Dialogue: 0,0:19:42.93,0:19:48.72,Default,,0,0,0,,Өмірімді қайта бастағандай болдым.
Dialogue: 0,0:19:50.68,0:19:54.94,Default,,0,0,0,,Кәрі қартты Ироха екеуің тірі қалдырған.
Dialogue: 0,0:19:55.69,0:19:58.11,Default,,0,0,0,,Қандық туыс болмаса да
Dialogue: 0,0:19:59.94,0:20:03.28,Default,,0,0,0,,Адамдармен кездесу – қазына
Dialogue: 0,0:20:07.74,0:20:11.91,Default,,0,0,0,,Өзің үшін емес, басқа біреу үшін өмір сүру
Dialogue: 0,0:20:12.00,0:20:15.96,Default,,0,0,0,,Ал, мен көп қызық істер жасадым.
Dialogue: 0,0:20:19.96,0:20:22.34,Default,,0,0,0,,Мынау сондай жер.
Dialogue: 0,0:20:23.93,0:20:25.22,Default,,0,0,0,,Келгеніңе қуаныштымын.
Dialogue: 0,0:20:25.30,0:20:27.89,Default,,0,0,0,,Көптеген адамдармен танысыңыз
Dialogue: 0,0:20:27.97,0:20:30.14,Default,,0,0,0,,Көп нәрсені үйреніңіз
Dialogue: 0,0:20:30.56,0:20:32.23,Default,,0,0,0,,(Әжемнің күлкісі)
Dialogue: 0,0:20:32.23,0:20:32.94,Default,,0,0,0,,(Әженің күлуі)
Dialogue: 0,0:20:32.23,0:20:32.94,Default,,0,0,0,,Бұл адам ба?
Dialogue: 0,0:20:32.94,0:20:34.27,Default,,0,0,0,,Бұл адам ба?
Dialogue: 0,0:20:35.48,0:20:39.15,Default,,0,0,0,,Кәрі қаңбақ естеліктерін сақтап, осында өледі.
Dialogue: 0,0:20:39.23,0:20:41.15,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:20:41.24,0:20:44.66,Default,,0,0,0,,Мен енді басқа жерде тұра алмаймын.
Dialogue: 0,0:20:47.99,0:20:49.53,Default,,0,0,0,,Өйткені, бұл менмін
Dialogue: 0,0:20:49.62,0:20:52.91,Default,,0,0,0,,Киотодағы шайқастың нақты себебі бар.
Dialogue: 0,0:20:54.33,0:20:56.17,Default,,0,0,0,,Жоқ, ол әлі өлген жоқ!
Dialogue: 0,0:20:56.96,0:20:58.79,Default,,0,0,0,,Енді ұйықта
Dialogue: 0,0:20:58.88,0:21:00.63,Default,,0,0,0,,​​Иә, қайырлы түн.
Dialogue: 0,0:21:03.92,0:21:06.97,Default,,0,0,0,,Өйткені мұнда мен үшін маңызды адам бар.
Dialogue: 0,0:21:09.05,0:21:12.47,Default,,0,0,0,,Ендеше, бүгін де ерінбей еңбек етейік!
Dialogue: 0,0:21:12.56,0:21:16.06,Default,,0,0,0,,Данго қосылған, яғни өрік дәндері.
Dialogue: 0,0:21:16.14,0:21:17.98,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:21:19.40,0:21:20.98,Default,,0,0,0,,Әжем айтқандай
Dialogue: 0,0:21:24.07,0:21:26.57,Default,,0,0,0,,Егер кездесулер қазына болса
Dialogue: 0,0:21:27.57,0:21:28.78,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:21:28.87,0:21:29.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:30.74,0:21:32.66,Default,,0,0,0,,Сол кезде мен таныстым
Dialogue: 0,0:21:33.91,0:21:35.37,Default,,0,0,0,,Менің өмірімде
Dialogue: 0,0:21:39.88,0:21:42.67,Default,,0,0,0,,Бұл ең үлкен қазына болса керек.
Dialogue: 0,0:21:50.89,0:21:55.89,Default,,0,0,0,,♪～
Dialogue: 0,0:23:14.10,0:23:19.10,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.31,0:23:24.19,Default,,0,0,0,,Бұл Чиринуни.
Dialogue: 0,0:23:24.27,0:23:27.98,Default,,0,0,0,,Әй, үй тыныш.
Dialogue: 0,0:23:28.07,0:23:32.45,Default,,0,0,0,,Пісіру дангосының иісі, ескі татами төсеніштері және бәрінен бұрын
Dialogue: 0,0:23:32.53,0:23:35.03,Default,,0,0,0,,Әже бұрынғыдай
Dialogue: 0,0:23:35.12,0:23:38.29,Default,,0,0,0,,Ол мен үшін қазынадай маңызды.
Dialogue: 0,0:23:38.37,0:23:40.29,Default,,0,0,0,,Мен оны қайтадан сезіндім
Dialogue: 0,0:23:40.96,0:23:44.84,Default,,0,0,0,,Алда бұдан да маңызды қазыналар болатынына сенімдімін.
Dialogue: 0,0:23:45.88,0:23:47.96,Default,,0,0,0,,Келесі жолы «Ең әлсіз генерал»
Dialogue: 0,0:23:48.63,0:23:49.80,Default,,0,0,0,,Бізбен бірге болыңыз!
Dialogue: 0,0:23:51.30,0:23:57.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
