Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.50,0:00:05.42,Default,,0,0,0,,Бұл сіз екеніңізге сене алар емеспін
Dialogue: 0,0:00:05.92,0:00:07.67,Default,,0,0,0,,Генерал Токугава Иемочи?
Dialogue: 0,0:00:07.75,0:00:09.46,Default,,0,0,0,,Шо... Генерал?
Dialogue: 0,0:00:11.72,0:00:16.72,Default,,0,0,0,,Біз генералды Ниджо қамалына аман-есен жеткіземіз.
Dialogue: 0,0:00:17.93,0:00:19.60,Default,,0,0,0,,Менің бір ойым бар.
Dialogue: 0,0:00:27.44,0:00:28.40,Default,,0,0,0,,Не? Секонд-хенд?
Dialogue: 0,0:00:29.11,0:00:30.36,Default,,0,0,0,,Қайсысы Иемо?
Dialogue: 0,0:00:30.44,0:00:32.94,Default,,0,0,0,,Екеуіңіз де қашып кетпеңіздер! Қуда, қу!
Dialogue: 0,0:00:39.41,0:00:40.41,Default,,0,0,0,,Мен бардым
Dialogue: 0,0:00:40.49,0:00:42.91,Default,,0,0,0,,Түсіндім, бұл тамаша идея.
Dialogue: 0,0:00:43.00,0:00:45.17,Default,,0,0,0,,Жалпы! Генерал!
Dialogue: 0,0:00:45.79,0:00:48.25,Default,,0,0,0,,- (Тодо) Охохохохо - (Окита) Сенің күлуің әдемі~
Dialogue: 0,0:00:48.33,0:00:52.76,Default,,0,0,0,,30-ға дейін санағаннан кейін, артқы жолдар арқылы Ниджо қамалына қарай бет алайық.
Dialogue: 0,0:00:52.84,0:00:53.67,Default,,0,0,0,,Иә (есіктің ашылған дыбысы)
Dialogue: 0,0:00:53.76,0:00:54.88,Default,,0,0,0,,- (Кикучиё) Ах - Ха!
Dialogue: 0,0:00:54.97,0:00:56.51,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:00:56.59,0:01:00.39,Default,,0,0,0,,Мен көремін. Бұл екі топ алаяқ па?
Dialogue: 0,0:01:01.18,0:01:04.18,Default,,0,0,0,,Бұл шынымен сәтсіздік болды.
Dialogue: 0,0:01:04.85,0:01:05.69,Default,,0,0,0,,Кикучио-сан!
Dialogue: 0,0:01:06.73,0:01:07.56,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:01:07.65,0:01:09.40,Default,,0,0,0,,Ичи
Dialogue: 0,0:01:09.48,0:01:13.90,Default,,0,0,0,,Нии-сан...
Dialogue: 0,0:01:15.99,0:01:21.41,Default,,0,0,0,,Фуфухахаха... Қаш! Жүгіріп кету!
Dialogue: 0,0:01:23.37,0:01:28.37,Default,,0,0,0,,♪～
Dialogue: 0,0:02:47.95,0:02:52.96,Default,,0,0,0,,～♪
Dialogue: 0,0:02:53.54,0:02:55.71,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:56.67,0:02:57.71,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:03:01.05,0:03:02.34,Default,,0,0,0,,Кие!
Dialogue: 0,0:03:02.43,0:03:04.93,Default,,0,0,0,,Ой!
Dialogue: 0,0:03:06.26,0:03:07.64,Default,,0,0,0,,Хмм... ха
Dialogue: 0,0:03:10.94,0:03:13.35,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:03:13.44,0:03:14.77,Default,,0,0,0,,Артқы жақта, айналайын!
Dialogue: 0,0:03:14.86,0:03:15.82,Default,,0,0,0,,(Амон) Нагачика? (Хайд) Ах, Амон-сан.
Dialogue: 0,0:03:15.90,0:03:16.94,Default,,0,0,0,,Цк
Dialogue: 0,0:03:22.86,0:03:24.62,Default,,0,0,0,,Жарайды, мен сені бұрышқа қойдым.
Dialogue: 0,0:03:24.70,0:03:25.70,Default,,0,0,0,,Имодзи: Дайын болыңыз!
Dialogue: 0,0:03:27.24,0:03:29.75,Default,,0,0,0,,Сіз өзіңізге жеткілікті уақыт сатып алдыңыз, Хиджиката.
Dialogue: 0,0:03:29.83,0:03:31.41,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:03:31.50,0:03:34.21,Default,,0,0,0,,Кешіріңіз, генералды сізге беруге болмайды.
Dialogue: 0,0:03:35.25,0:03:37.38,Default,,0,0,0,,Уфу генералы.
Dialogue: 0,0:03:37.46,0:03:38.59,Default,,0,0,0,,Әй, ақымақ!
Dialogue: 0,0:03:38.67,0:03:39.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:39.84,0:03:43.22,Default,,0,0,0,,Шүкір, біз жеңіліп қалдық па? Мен арғы бетті қуамын.
Dialogue: 0,0:03:43.30,0:03:44.55,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:03:47.68,0:03:49.56,Default,,0,0,0,,Мен сенімен айналысамын.
Dialogue: 0,0:03:49.64,0:03:52.06,Default,,0,0,0,,Біріншіден, мұндай нәрсе менің жынысыма сәйкес келмейді.
Dialogue: 0,0:03:52.14,0:03:53.35,Default,,0,0,0,,Гакига
Dialogue: 0,0:03:53.44,0:03:55.02,Default,,0,0,0,,Бір Жокер бар; карталар мінсіз рет-ретімен тұрған сияқты.
Dialogue: 0,0:03:55.10,0:03:57.82,Default,,0,0,0,,Үлкен кісі семсерді қалай қолдану керектігін үйретеді
Dialogue: 0,0:03:58.52,0:04:01.82,Default,,0,0,0,,Алдымен қылышты сол жамбаңызға қойыңыз.
Dialogue: 0,0:04:01.90,0:04:02.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.82,0:04:07.03,Default,,0,0,0,,Бірден өтіңіз, хахахаха
Dialogue: 0,0:04:12.62,0:04:14.29,Default,,0,0,0,,Доваа
Dialogue: 0,0:04:16.46,0:04:18.50,Default,,0,0,0,,О... сен!
Dialogue: 0,0:04:21.97,0:04:23.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:26.80,0:04:30.14,Default,,0,0,0,,Кім кімге нені үйретеді?
Dialogue: 0,0:04:31.77,0:04:35.19,Default,,0,0,0,,Оны жұлып алсаң, бітті.
Dialogue: 0,0:04:35.27,0:04:36.15,Default,,0,0,0,,Хун
Dialogue: 0,0:04:36.23,0:04:39.02,Default,,0,0,0,,Одан құтыл, қарғыс атқыр бала!
Dialogue: 0,0:04:39.11,0:04:41.53,Default,,0,0,0,,Ах! Сіз қазір қашып жатырсыз ба?
Dialogue: 0,0:04:41.61,0:04:43.95,Default,,0,0,0,,Кодачимен келіңіз! а?
Dialogue: 0,0:04:44.03,0:04:44.99,Default,,0,0,0,,Бастауды күту
Dialogue: 0,0:04:45.07,0:04:46.91,Default,,0,0,0,,Цк, бұл не, Хиджиката?
Dialogue: 0,0:04:47.53,0:04:49.41,Default,,0,0,0,,Ол адам сонда болды ма?
Dialogue: 0,0:04:49.49,0:04:50.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:51.45,0:04:52.54,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:04:52.62,0:04:53.96,Default,,0,0,0,,Енді...
Dialogue: 0,0:04:54.04,0:04:55.87,Default,,0,0,0,,Қияаа~
Dialogue: 0,0:04:55.96,0:04:57.54,Default,,0,0,0,,Не, ақымақ!
Dialogue: 0,0:04:57.63,0:05:02.55,Default,,0,0,0,,- (Әже) Мен қорықтым! - (Хиджиката) Менен кет, мына кусоба-баа!
Dialogue: 0,0:05:02.63,0:05:04.30,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:05:05.84,0:05:07.64,Default,,0,0,0,,О! Жалтарып кетті
Dialogue: 0,0:05:07.72,0:05:09.60,Default,,0,0,0,,Эй уау~
Dialogue: 0,0:05:09.68,0:05:12.22,Default,,0,0,0,,О... Окита! Оларды жеңіңіз
Dialogue: 0,0:05:12.31,0:05:15.23,Default,,0,0,0,,Балалар, Ниджо қамалына жеткенше
Dialogue: 0,0:05:15.31,0:05:17.98,Default,,0,0,0,,Мен сізге мүмкіндігінше көп уақыт сатып алуға уәде беремін.
Dialogue: 0,0:05:18.06,0:05:19.36,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:05:19.44,0:05:21.36,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:05:21.44,0:05:23.57,Default,,0,0,0,,Мен генералмын.
Dialogue: 0,0:05:23.65,0:05:25.19,Default,,0,0,0,,Сіз мұны қанша уақыттан бері істеп жүрсіз?
Dialogue: 0,0:05:25.28,0:05:26.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.20,0:05:28.70,Default,,0,0,0,,А, бұл жалған!
Dialogue: 0,0:05:28.78,0:05:30.03,Default,,0,0,0,,Iemo емес!
Dialogue: 0,0:05:30.12,0:05:31.41,Default,,0,0,0,,Анықталды
Dialogue: 0,0:05:31.49,0:05:35.00,Default,,0,0,0,,... оларды тез өлтіріңіз.
Dialogue: 0,0:05:35.08,0:05:37.42,Default,,0,0,0,,Мен генералмын, төбелеспеймін.
Dialogue: 0,0:05:37.50,0:05:39.67,Default,,0,0,0,,Мықты болсаң да, не айтып тұрсың!
Dialogue: 0,0:05:39.75,0:05:43.17,Default,,0,0,0,,А, менде басқа амал жоқ.
Dialogue: 0,0:05:43.25,0:05:45.17,Default,,0,0,0,,Сіз мені құстырасыз ба?
Dialogue: 0,0:05:45.26,0:05:47.68,Default,,0,0,0,,Не? Ей, кем дегенде шамдар
Dialogue: 0,0:05:47.76,0:05:50.43,Default,,0,0,0,,Өзіңді жалап өлме!
Dialogue: 0,0:05:59.77,0:06:02.40,Default,,0,0,0,,Гваа
Dialogue: 0,0:06:02.48,0:06:04.32,Default,,0,0,0,,Ахаха
Dialogue: 0,0:06:04.40,0:06:07.40,Default,,0,0,0,,Мен сіңірді кесіп тастадым, сондықтан мен енді қозғала алмаймын.
Dialogue: 0,0:06:07.49,0:06:11.41,Default,,0,0,0,,Мен Эдода болғанымда тек жіліншіктерді ғана нысанаға алатын бір жігіт болды.
Dialogue: 0,0:06:11.99,0:06:14.83,Default,,0,0,0,,Мен оны өзімше жетілдірдім.
Dialogue: 0,0:06:14.91,0:06:19.42,Default,,0,0,0,,Яманами мырза маған мұндай жазалардың бұрын болғанын үйретті.
Dialogue: 0,0:06:19.50,0:06:22.92,Default,,0,0,0,,Мен бұл әдісті «ашикири» деп атадым.
Dialogue: 0,0:06:23.96,0:06:24.92,Default,,0,0,0,,Шайтан!
Dialogue: 0,0:06:25.00,0:06:26.51,Default,,0,0,0,,Hiii~
Dialogue: 0,0:06:26.59,0:06:27.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:27.63,0:06:31.01,Default,,0,0,0,,Менің досым қашып кетті. Бұл қорқынышты.
Dialogue: 0,0:06:31.09,0:06:31.93,Default,,0,0,0,,Боқ...
Dialogue: 0,0:06:32.51,0:06:33.85,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:33.93,0:06:37.43,Default,,0,0,0,,Мен сенен кім екеніңді айтуыңды өтінемін.
Dialogue: 0,0:06:37.52,0:06:39.31,Default,,0,0,0,,- (Ассасин) Уф - (Окита) Ах!
Dialogue: 0,0:06:39.39,0:06:40.60,Default,,0,0,0,,Ах
Dialogue: 0,0:06:40.69,0:06:43.69,Default,,0,0,0,,Мына жігіт тілін тістеп алды.
Dialogue: 0,0:06:43.77,0:06:44.98,Default,,0,0,0,,Бір нәрсені орау
Dialogue: 0,0:06:45.07,0:06:46.36,Default,,0,0,0,,Жоқ, мен уақытында үлгере алмаймын.
Dialogue: 0,0:06:46.44,0:06:50.57,Default,,0,0,0,,Жоқ... бұл не? бұл адамдар
Dialogue: 0,0:06:51.07,0:06:53.53,Default,,0,0,0,,Бұл қалыпты емес
Dialogue: 0,0:06:53.62,0:06:56.99,Default,,0,0,0,,Бұл балалар қауіпті.
Dialogue: 0,0:06:58.41,0:07:01.00,Default,,0,0,0,,Ниджо қамалына жақындап қалды.
Dialogue: 0,0:07:01.08,0:07:02.04,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:04.42,0:07:07.88,Default,,0,0,0,,А, ұнамайды, ұнамайды, шаршадым! Себет дайындаңыз
Dialogue: 0,0:07:07.96,0:07:09.76,Default,,0,0,0,,Сіз жай ғана «хмм» дедіңіз бе?
Dialogue: 0,0:07:09.84,0:07:10.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:10.84,0:07:11.47,Default,,0,0,0,,Хмм, не? ше?
Dialogue: 0,0:07:11.47,0:07:12.72,Default,,0,0,0,,Хмм, не? ше?
Dialogue: 0,0:07:11.47,0:07:12.72,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:07:12.72,0:07:13.72,Default,,0,0,0,,Хмм, не? ше?
Dialogue: 0,0:07:13.72,0:07:14.30,Default,,0,0,0,,Хмм, не? ше?
Dialogue: 0,0:07:13.72,0:07:14.30,Default,,0,0,0,,Мұнда емес!
Dialogue: 0,0:07:14.30,0:07:14.39,Default,,0,0,0,,Мұнда емес!
Dialogue: 0,0:07:14.39,0:07:15.01,Default,,0,0,0,,Мұнда емес!
Dialogue: 0,0:07:14.39,0:07:15.01,Default,,0,0,0,,Мен біреудің дауысын естимін
Dialogue: 0,0:07:15.01,0:07:15.85,Default,,0,0,0,,Мен біреудің дауысын естимін
Dialogue: 0,0:07:15.93,0:07:16.76,Default,,0,0,0,,Не?
Dialogue: 0,0:07:17.35,0:07:18.93,Default,,0,0,0,,Басшы қайда?
Dialogue: 0,0:07:19.02,0:07:20.60,Default,,0,0,0,,- (Вассал) Барлық жерден ізде! -(вассаль) га
Dialogue: 0,0:07:20.69,0:07:22.69,Default,,0,0,0,,А, мен сарайданмын.
Dialogue: 0,0:07:22.77,0:07:25.65,Default,,0,0,0,,Жақсы, көмек осында.
Dialogue: 0,0:07:25.73,0:07:28.78,Default,,0,0,0,,Сәлем! Мінеки!
Dialogue: 0,0:07:29.36,0:07:31.90,Default,,0,0,0,,О, сен менің басымсың ба?
Dialogue: 0,0:07:31.99,0:07:34.03,Default,,0,0,0,,Сіз қауіпсізсіз бе?
Dialogue: 0,0:07:34.12,0:07:36.03,Default,,0,0,0,,Мен маңызды емеспін
Dialogue: 0,0:07:36.12,0:07:37.29,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:07:37.37,0:07:39.12,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:07:41.37,0:07:43.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:56.01,0:07:57.51,Default,,0,0,0,,Кешіріңіз, бес порция алайын ба?
Dialogue: 0,0:08:00.22,0:08:02.64,Default,,0,0,0,,Мен сенің басыңды аламын, Иемо.
Dialogue: 0,0:08:03.90,0:08:06.40,Default,,0,0,0,,Қашып кетші, Кикучио-сан.
Dialogue: 0,0:08:07.52,0:08:08.52,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:09.65,0:08:11.03,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:08:12.15,0:08:14.78,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:08:17.07,0:08:18.28,Default,,0,0,0,,Наозуми
Dialogue: 0,0:08:19.08,0:08:20.29,Default,,0,0,0,,Наозуми
Dialogue: 0,0:08:21.00,0:08:23.04,Default,,0,0,0,,Мұны не үшін жасаймыз?
Dialogue: 0,0:08:23.12,0:08:25.04,Default,,0,0,0,,Сіз экстерминаторсыз ба?
Dialogue: 0,0:08:26.00,0:08:30.05,Default,,0,0,0,,Менің басымды алсаң да, бұл елдің қазіргі жағдайы өзгермейді.
Dialogue: 0,0:08:30.13,0:08:33.80,Default,,0,0,0,,Кухахахахаха! Джой!
Dialogue: 0,0:08:33.88,0:08:36.80,Default,,0,0,0,,Джой, бұл не?
Dialogue: 0,0:08:38.14,0:08:40.06,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:08:40.64,0:08:43.94,Default,,0,0,0,,Хмф, мені мүлдем қызықтырмайды.
Dialogue: 0,0:08:44.73,0:08:46.81,Default,,0,0,0,,Мақсат Джойды жою емес пе?
Dialogue: 0,0:08:47.98,0:08:49.32,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:08:49.94,0:08:53.07,Default,,0,0,0,,Енді мен сізден сұрайын, сіздің мақсатыңыз қандай?
Dialogue: 0,0:08:59.08,0:09:01.20,Default,,0,0,0,,Самурайлар әлемінің жандануы
Dialogue: 0,0:09:01.29,0:09:02.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:02.33,0:09:03.70,Default,,0,0,0,,Қайта тірілу?
Dialogue: 0,0:09:05.04,0:09:08.21,Default,,0,0,0,,Сен оны бізден алдың.
Dialogue: 0,0:09:09.29,0:09:10.71,Default,,0,0,0,,Токугава!
Dialogue: 0,0:09:13.63,0:09:15.30,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:15.38,0:09:18.34,Default,,0,0,0,,Токугава алды ма? Сізден
Dialogue: 0,0:09:18.43,0:09:19.76,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:20.26,0:09:22.35,Default,,0,0,0,,Нені алып кеттің?
Dialogue: 0,0:09:23.18,0:09:25.35,Default,,0,0,0,,Ұрыс алаңы
Dialogue: 0,0:09:28.19,0:09:33.48,Default,,0,0,0,,Токугава сегунатының негізін қалаушы Иэясу Сенгоку кезеңін аяқтады.
Dialogue: 0,0:09:33.57,0:09:37.11,Default,,0,0,0,,Біз самурайлардан ұрыс алаңын тартып алдық.
Dialogue: 0,0:09:37.91,0:09:40.12,Default,,0,0,0,,Сіз бейбітшілікке шағымданасыз ба?
Dialogue: 0,0:09:40.20,0:09:43.12,Default,,0,0,0,,Куфуфуфуфуфу…
Dialogue: 0,0:09:44.41,0:09:45.54,Default,,0,0,0,,Ах
Dialogue: 0,0:09:45.62,0:09:47.04,Default,,0,0,0,,(қылыш сермеу)
Dialogue: 0,0:09:49.88,0:09:51.17,Default,,0,0,0,,Ах
Dialogue: 0,0:09:51.25,0:09:52.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:52.71,0:09:53.67,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:09:53.75,0:09:54.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:57.93,0:09:58.88,Default,,0,0,0,,Мен қанағаттанбаймын.
Dialogue: 0,0:10:01.47,0:10:05.89,Default,,0,0,0,,Қанды көрудің қажеті жоқ болса, бұл жақсы емес пе?
Dialogue: 0,0:10:10.56,0:10:13.15,Default,,0,0,0,,Сонда самурайларды неге тастап кеттің?
Dialogue: 0,0:10:14.03,0:10:16.03,Default,,0,0,0,,Мен өте күштімін
Dialogue: 0,0:10:16.11,0:10:18.36,Default,,0,0,0,,Күшті болып туылған
Dialogue: 0,0:10:18.45,0:10:20.87,Default,,0,0,0,,Күшті болу үшін күн сайын жаттығу жасаңыз
Dialogue: 0,0:10:20.95,0:10:24.54,Default,,0,0,0,,Дүние жүзіне саяхаттаңыз, жаттығуларды жалғастырыңыз және күшті болыңыз
Dialogue: 0,0:10:25.66,0:10:27.75,Default,,0,0,0,,Күнде қан құсамыз
Dialogue: 0,0:10:27.83,0:10:31.54,Default,,0,0,0,,Ақыл мен денені жаттықтырудың мақсаты қандай?
Dialogue: 0,0:10:31.63,0:10:35.05,Default,,0,0,0,,Дағдарыс кезінде халықты қорғау
Dialogue: 0,0:10:36.21,0:10:37.55,Default,,0,0,0,,Уф
Dialogue: 0,0:10:37.63,0:10:39.76,Default,,0,0,0,,Бұл қашан?
Dialogue: 0,0:10:39.84,0:10:41.84,Default,,0,0,0,,Біз ұрпақтар бойы самурай болдық.
Dialogue: 0,0:10:41.93,0:10:44.68,Default,,0,0,0,,Менің қариям мен оның қариясы
Dialogue: 0,0:10:44.76,0:10:49.56,Default,,0,0,0,,Самурайға өзінің қандай екенін көрсететін жер болмады, ол күріш крекер футонында қайтыс болды.
Dialogue: 0,0:10:50.56,0:10:54.86,Default,,0,0,0,,260 жыл бойы сіз Токугава халқы самурайлар класының жоғарғы жағында тұрдыңыз.
Dialogue: 0,0:10:54.94,0:10:57.99,Default,,0,0,0,,Олар бізді өлтіріп жатыр.
Dialogue: 0,0:10:58.53,0:10:59.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:59.49,0:11:01.78,Default,,0,0,0,,Гаки, айтшы.
Dialogue: 0,0:11:01.86,0:11:03.70,Default,,0,0,0,,Жауынгерлік өнер дегеніміз не?
Dialogue: 0,0:11:05.28,0:11:07.95,Default,,0,0,0,,Мен... түсінбеймін.
Dialogue: 0,0:11:08.04,0:11:09.04,Default,,0,0,0,,Хун
Dialogue: 0,0:11:10.66,0:11:12.38,Default,,0,0,0,,Иемочи, жауап.
Dialogue: 0,0:11:12.46,0:11:14.50,Default,,0,0,0,,Жекпе-жек сіз үшін нені білдіреді?
Dialogue: 0,0:11:16.42,0:11:17.76,Default,,0,0,0,,Take дегеніміз не?
Dialogue: 0,0:11:20.59,0:11:22.51,Default,,0,0,0,,Бұл жай ғана безендіру
Dialogue: 0,0:11:22.59,0:11:25.01,Default,,0,0,0,,Ха, егер солай айтсаң...
Dialogue: 0,0:11:26.60,0:11:30.02,Default,,0,0,0,,Жекпе-жек – төтенше жағдайларға дайындық.
Dialogue: 0,0:11:31.35,0:11:32.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:35.36,0:11:37.69,Default,,0,0,0,,Самурай - қан!
Dialogue: 0,0:11:37.78,0:11:42.53,Default,,0,0,0,,Генпейден бері үздіксіз иірілген қанды білдіреді.
Dialogue: 0,0:11:43.20,0:11:45.53,Default,,0,0,0,,Неге ұрысуға тырыспайсың?
Dialogue: 0,0:11:45.62,0:11:48.99,Default,,0,0,0,,Неліктен өз күшіңді көрсетуге тырыспайсың?
Dialogue: 0,0:11:51.29,0:11:54.29,Default,,0,0,0,,«Ұрыс» «өлу» сөзінің синонимі.
Dialogue: 0,0:11:55.71,0:11:58.50,Default,,0,0,0,,Сөз қанша әдемі болса да,
Dialogue: 0,0:11:58.59,0:12:02.09,Default,,0,0,0,,Егер сіз «жекпе-жек» деп ойласаңыз, алдымен оған күмәндану керек.
Dialogue: 0,0:12:02.17,0:12:03.26,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:03.93,0:12:05.39,Default,,0,0,0,,Иә
Dialogue: 0,0:12:05.47,0:12:08.56,Default,,0,0,0,,Бұл самурайдың шыңы емес...
Dialogue: 0,0:12:08.64,0:12:09.93,Default,,0,0,0,,Адамдарды күлдіріңіз
Dialogue: 0,0:12:10.02,0:12:13.48,Default,,0,0,0,,Жоғарыдағылар шірігендіктен, төменгі жақтағылар көшеде адасқан.
Dialogue: 0,0:12:14.06,0:12:16.94,Default,,0,0,0,,Үлкен шайқас басталғалы тұр.
Dialogue: 0,0:12:17.02,0:12:20.23,Default,,0,0,0,,Біз, «Қан Рисшидан», сені оятамыз.
Dialogue: 0,0:12:20.99,0:12:23.24,Default,,0,0,0,,Қан... Рисшидан?
Dialogue: 0,0:12:23.32,0:12:27.16,Default,,0,0,0,,Иэмодзи, мойын дұрыс.
Dialogue: 0,0:12:27.24,0:12:31.50,Default,,0,0,0,,Алдағы фестивальдің микоши болыңыз.
Dialogue: 0,0:12:31.58,0:12:35.62,Default,,0,0,0,,Өлсең, қала хаос, ел ойран болады.
Dialogue: 0,0:12:35.71,0:12:38.29,Default,,0,0,0,,Сенгоку дәуірі қайта оралды
Dialogue: 0,0:12:38.79,0:12:41.76,Default,,0,0,0,,Міне, біз өз орнымызды таба аламыз.
Dialogue: 0,0:12:42.42,0:12:46.01,Default,,0,0,0,,Біл... жоқ! бұл адам ауыр
Dialogue: 0,0:12:46.09,0:12:47.76,Default,,0,0,0,,Тыңдаңыз! Наозуми
Dialogue: 0,0:12:47.85,0:12:49.10,Default,,0,0,0,,Хмм?
Dialogue: 0,0:12:49.60,0:12:52.43,Default,,0,0,0,,Сонда да мен соғысқа жол бермеймін
Dialogue: 0,0:12:52.52,0:12:56.02,Default,,0,0,0,,Бұл менің самурайлар отбасының басшысы ретіндегі пайымдауым.
Dialogue: 0,0:12:57.61,0:12:59.57,Default,,0,0,0,,Мен өлмеймін
Dialogue: 0,0:12:59.65,0:13:01.78,Default,,0,0,0,,Мен енді өле алмаймын.
Dialogue: 0,0:13:02.36,0:13:03.61,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:13:04.11,0:13:06.03,Default,,0,0,0,,Сен өлесің
Dialogue: 0,0:13:07.45,0:13:10.37,Default,,0,0,0,,Дәл осы жерде және қазір.
Dialogue: 0,0:13:12.45,0:13:14.71,Default,,0,0,0,,О!
Dialogue: 0,0:13:18.33,0:13:21.46,Default,,0,0,0,,Қаш, Кикучио-сан, өтінемін, жүгір!
Dialogue: 0,0:13:25.80,0:13:27.68,Default,,0,0,0,,Бұл әлсіз.
Dialogue: 0,0:13:28.59,0:13:30.43,Default,,0,0,0,,Спектакль аяқталды
Dialogue: 0,0:13:32.43,0:13:33.52,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:13:33.60,0:13:35.02,Default,,0,0,0,,Менің бір ойым бар.
Dialogue: 0,0:13:48.95,0:13:50.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:56.79,0:13:59.50,Default,,0,0,0,,Қылышыңды қойып, берілесің бе?
Dialogue: 0,0:14:03.42,0:14:04.96,Default,,0,0,0,,Га
Dialogue: 0,0:14:13.22,0:14:14.43,Default,,0,0,0,,Наозуми-сан
Dialogue: 0,0:14:17.10,0:14:18.98,Default,,0,0,0,,Сіз әлсізсіз
Dialogue: 0,0:14:20.44,0:14:21.98,Default,,0,0,0,,Iemo қайда орналасқан?
Dialogue: 0,0:14:22.73,0:14:24.02,Default,,0,0,0,,Сол адам
Dialogue: 0,0:14:24.98,0:14:26.28,Default,,0,0,0,,Оны бермеңіз!
Dialogue: 0,0:14:33.58,0:14:35.58,Default,,0,0,0,,Олардың соңынан ергендердің қатарында
Dialogue: 0,0:14:35.66,0:14:37.71,Default,,0,0,0,,Ақ киімді адам болған жоқ па?
Dialogue: 0,0:14:37.79,0:14:39.50,Default,,0,0,0,,Келме
Dialogue: 0,0:14:39.58,0:14:43.21,Default,,0,0,0,,Осындай сұмдықтың келмегеніне көңілім толды.
Dialogue: 0,0:14:43.29,0:14:45.55,Default,,0,0,0,,Бірақ ең қорқыныштысы - Окита.
Dialogue: 0,0:14:45.63,0:14:47.63,Default,,0,0,0,,Қоштасудың бір ауыз сөзін айтпай-ақ,
Dialogue: 0,0:14:48.26,0:14:52.51,Default,,0,0,0,,Бірақ бұлай болса, мен сіз бен генерал үшін алаңдаймын.
Dialogue: 0,0:14:52.60,0:14:55.68,Default,,0,0,0,,Не істеу керек? Мен тұшпара дүкеніне қайта баруым керек пе?
Dialogue: 0,0:14:55.76,0:14:58.31,Default,,0,0,0,,Ой... мен енді үйге бара аламын ба?
Dialogue: 0,0:14:58.39,0:15:01.06,Default,,0,0,0,,Таро! Сіз аяныштысыз!
Dialogue: 0,0:15:01.15,0:15:04.52,Default,,0,0,0,,Себебі әжем менің бизнесте жақсы екенімді айтты.
Dialogue: 0,0:15:04.61,0:15:07.28,Default,,0,0,0,,Кәсіпкердің аты-жөні
Dialogue: 0,0:15:07.36,0:15:09.53,Default,,0,0,0,,Өзіңізді қатты итермеңіз!
Dialogue: 0,0:15:09.61,0:15:11.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:11.20,0:15:12.03,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:14.53,0:15:15.78,Default,,0,0,0,,Ниджо қамалына барайық
Dialogue: 0,0:15:15.87,0:15:17.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:17.83,0:15:22.04,Default,,0,0,0,,Ақ киімділер қашқандармен қосылып, озып кеткен болуы мүмкін.
Dialogue: 0,0:15:22.12,0:15:25.88,Default,,0,0,0,,Иә, бұл өте ықтимал.
Dialogue: 0,0:15:25.96,0:15:30.17,Default,,0,0,0,,Генералдың соңғы баратын жері сонда ғана.
Dialogue: 0,0:15:30.26,0:15:32.09,Default,,0,0,0,,Ниджо қамалының айналасында
Dialogue: 0,0:15:32.18,0:15:35.47,Default,,0,0,0,,Мен тұтқынға түсуі мүмкін жердің бәрін аралап шығамын.
Dialogue: 0,0:15:35.55,0:15:36.76,Default,,0,0,0,,Йошикита
Dialogue: 0,0:15:36.85,0:15:39.14,Default,,0,0,0,,Хагқа да көмектес! Хехе!
Dialogue: 0,0:15:39.22,0:15:42.14,Default,,0,0,0,,Қара, Таро! Қытырлақ!
Dialogue: 0,0:15:42.23,0:15:43.90,Default,,0,0,0,,Иә~
Dialogue: 0,0:15:43.98,0:15:44.90,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:15:44.98,0:15:45.81,Default,,0,0,0,,О
Dialogue: 0,0:15:47.73,0:15:52.24,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:15:52.32,0:15:56.87,Default,,0,0,0,,Жарайды, мен сені уайымдаймын, бірақ мен осында болсам да...
Dialogue: 0,0:15:56.95,0:15:59.08,Default,,0,0,0,,Мен үйге бара аламын ба?
Dialogue: 0,0:15:59.16,0:16:00.41,Default,,0,0,0,,Эй Хиджиката...
Dialogue: 0,0:16:00.50,0:16:02.37,Default,,0,0,0,,Хахаха
Dialogue: 0,0:16:02.46,0:16:04.04,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:16:04.12,0:16:06.29,Default,,0,0,0,,Сәлем! Хиджиката кетіп қалды.
Dialogue: 0,0:16:06.88,0:16:10.63,Default,,0,0,0,,Сіз бірінші болдыңыз, солай ма? Біз де жетеміз.
Dialogue: 0,0:16:11.38,0:16:14.30,Default,,0,0,0,,Иә? О, қазірдің өзінде
Dialogue: 0,0:16:16.35,0:16:20.06,Default,,0,0,0,,Ху, сен сондай қусың, Хиджиката-сан.
Dialogue: 0,0:16:26.48,0:16:28.65,Default,,0,0,0,,Иемоны келесіде не күтіп тұр?
Dialogue: 0,0:16:32.90,0:16:34.45,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:16:34.53,0:16:38.08,Default,,0,0,0,,Тыңдамасам, әлсіз екенімді еститінмін.
Dialogue: 0,0:16:38.16,0:16:39.45,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:39.54,0:16:42.83,Default,,0,0,0,,Кикучио-сан, ол адам күштірек!
Dialogue: 0,0:16:42.91,0:16:44.04,Default,,0,0,0,,На
Dialogue: 0,0:16:44.12,0:16:47.58,Default,,0,0,0,,Осы өте күшті мені ұстаңыз
Dialogue: 0,0:16:48.34,0:16:49.59,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:16:49.67,0:16:52.05,Default,,0,0,0,,Адамдар сіздің эмоцияларыңызбен жеңіліп жатқаныңызды байқайды.
Dialogue: 0,0:16:52.67,0:16:55.34,Default,,0,0,0,,Қорқыныштан жынды болдыңыз ба?
Dialogue: 0,0:16:55.43,0:16:58.05,Default,,0,0,0,,Себебі мен Мибродағы адамдарды үнемі бақылап отырамын
Dialogue: 0,0:16:58.14,0:16:59.85,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:16:59.93,0:17:03.85,Default,,0,0,0,,Бұл адам қаншалықты қауіпті және қорқынышты күшті?
Dialogue: 0,0:17:04.98,0:17:07.02,Default,,0,0,0,,Басынан бір мақсат
Dialogue: 0,0:17:07.56,0:17:09.61,Default,,0,0,0,,Менде бар қарумен шайқас!
Dialogue: 0,0:17:11.73,0:17:13.78,Default,,0,0,0,,Сіз төбелескіңіз келеді дейсіз
Dialogue: 0,0:17:13.86,0:17:14.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:14.90,0:17:16.28,Default,,0,0,0,,Бұл самурай
Dialogue: 0,0:17:16.36,0:17:17.41,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:17.49,0:17:21.45,Default,,0,0,0,,Майданда шайқасып өл, бұл самурай
Dialogue: 0,0:17:21.54,0:17:23.20,Default,,0,0,0,,Сол себепті әлсіз
Dialogue: 0,0:17:24.00,0:17:25.62,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:17:25.71,0:17:28.04,Default,,0,0,0,,Бұл өзімшілдік емес пе?
Dialogue: 0,0:17:28.13,0:17:30.13,Default,,0,0,0,,Қатысқан адамдармен не болады?
Dialogue: 0,0:17:31.30,0:17:32.50,Default,,0,0,0,,Әйелдер ше?
Dialogue: 0,0:17:33.01,0:17:34.59,Default,,0,0,0,,Ата мен әже ше?
Dialogue: 0,0:17:35.09,0:17:37.01,Default,,0,0,0,,Ауруға байланысты кім жатыр?
Dialogue: 0,0:17:37.72,0:17:39.14,Default,,0,0,0,,Балалар ше?
Dialogue: 0,0:17:40.97,0:17:44.52,Default,,0,0,0,,Кикучио мырза әртүрлі адамдардың ұстанымдарын қарастырады.
Dialogue: 0,0:17:44.60,0:17:48.15,Default,,0,0,0,,Қалай жақсара аламын? Не істеу керек?
Dialogue: 0,0:17:48.23,0:17:50.90,Default,,0,0,0,,Дүниені кеңірек көзбен көру
Dialogue: 0,0:17:50.98,0:17:53.98,Default,,0,0,0,,Наозуми самурай болуды ұстанады.
Dialogue: 0,0:17:54.07,0:17:56.07,Default,,0,0,0,,Сол адамнан әлсіз
Dialogue: 0,0:17:56.15,0:17:57.91,Default,,0,0,0,,Ол адамды жеңе алмайсың!
Dialogue: 0,0:17:59.20,0:18:01.74,Default,,0,0,0,,Тілектеріңіз жеткілікті.
Dialogue: 0,0:18:02.74,0:18:05.91,Default,,0,0,0,,Салмағы? Бұл шынжырлы орақ па?
Dialogue: 0,0:18:06.00,0:18:07.92,Default,,0,0,0,,Ха, бұл блеф.
Dialogue: 0,0:18:08.00,0:18:10.25,Default,,0,0,0,,Бұл баланың қолынан келетін нәрсе емес.
Dialogue: 0,0:18:11.50,0:18:13.84,Default,,0,0,0,,Алайда, ол шынымен де қылышын лақтырып жіберді.
Dialogue: 0,0:18:13.92,0:18:16.92,Default,,0,0,0,,Одан жақсы қару ойлап табу заңды.
Dialogue: 0,0:18:19.22,0:18:20.84,Default,,0,0,0,,Әрине
Dialogue: 0,0:18:20.93,0:18:24.47,Default,,0,0,0,,Екеуміз қайта кездескеннен бері мен сол жағымды жарты денеммен жасырып келемін.
Dialogue: 0,0:18:25.85,0:18:28.73,Default,,0,0,0,,Не керек, мен бұл қараңғыда жақсы көре алмаймын.
Dialogue: 0,0:18:30.44,0:18:33.48,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:18:33.57,0:18:36.28,Default,,0,0,0,,Бұл қылыш сізге жетеді.
Dialogue: 0,0:18:37.57,0:18:38.74,Default,,0,0,0,,Һм? Ә… Не? Неге?
Dialogue: 0,0:18:38.82,0:18:39.74,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:18:39.82,0:18:41.24,Default,,0,0,0,,-Дэй - (Наозуми) Иә?
Dialogue: 0,0:18:41.32,0:18:42.49,Default,,0,0,0,,Тас?
Dialogue: 0,0:18:42.57,0:18:43.66,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:45.83,0:18:49.12,Default,,0,0,0,,Тас! Ол тас па?
Dialogue: 0,0:18:49.21,0:18:51.42,Default,,0,0,0,,Уақытты сатып алу блеф пе?
Dialogue: 0,0:18:51.50,0:18:54.25,Default,,0,0,0,,Оның батылдығы мені таң қалдырды.
Dialogue: 0,0:18:54.92,0:18:57.26,Default,,0,0,0,,Бұл тар аллея.
Dialogue: 0,0:18:57.34,0:19:00.88,Default,,0,0,0,,Бұл ұзын қылышты пайдалану өте қиын.
Dialogue: 0,0:19:00.97,0:19:03.26,Default,,0,0,0,,Сіз көп нәрсені ойлап отырсыз, солай емес пе?
Dialogue: 0,0:19:05.85,0:19:07.14,Default,,0,0,0,,Бірақ
Dialogue: 0,0:19:08.23,0:19:10.89,Default,,0,0,0,,Оны жай ғана сермеу керек
Dialogue: 0,0:19:10.98,0:19:12.77,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:19:20.74,0:19:22.61,Default,,0,0,0,,Мен мұны күттім!
Dialogue: 0,0:19:22.70,0:19:24.03,Default,,0,0,0,,Түсірілді!
Dialogue: 0,0:19:24.70,0:19:27.54,Default,,0,0,0,,Енді сіз семсерді пайдалана алмайсыз.
Dialogue: 0,0:19:29.16,0:19:31.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:31.96,0:19:33.50,Default,,0,0,0,,Кикучио күштірек!
Dialogue: 0,0:19:33.58,0:19:35.04,Default,,0,0,0,,Гаха
Dialogue: 0,0:19:35.63,0:19:37.05,Default,,0,0,0,,Не?
Dialogue: 0,0:19:39.13,0:19:40.30,Default,,0,0,0,,Бұл ауырмайды
Dialogue: 0,0:19:40.38,0:19:41.51,Default,,0,0,0,,- (Наозуми) Хмф! -Гаха
Dialogue: 0,0:19:41.59,0:19:44.47,Default,,0,0,0,,Оны неге алдың?
Dialogue: 0,0:19:44.55,0:19:46.05,Default,,0,0,0,,Бұл жұмыс істемейді!
Dialogue: 0,0:19:46.76,0:19:48.56,Default,,0,0,0,,Бұл жұмыс істейді!
Dialogue: 0,0:19:48.64,0:19:50.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:50.39,0:19:55.81,Default,,0,0,0,,(Наозумидің күшті дауысы)
Dialogue: 0,0:19:57.11,0:19:59.53,Default,,0,0,0,,Мен осылай өлуім керек пе?
Dialogue: 0,0:19:59.61,0:20:02.20,Default,,0,0,0,,Алдымен жіберіп, кесіп алған дұрыс па?
Dialogue: 0,0:20:03.03,0:20:04.82,Default,,0,0,0,,Мен жіберуім керек пе?
Dialogue: 0,0:20:04.91,0:20:06.20,Default,,0,0,0,,Мені жіберме!
Dialogue: 0,0:20:06.28,0:20:07.70,Default,,0,0,0,,Ура!
Dialogue: 0,0:20:07.78,0:20:09.66,Default,,0,0,0,,Хаха
Dialogue: 0,0:20:11.00,0:20:13.17,Default,,0,0,0,,Мен сенің санаңды жинаймын
Dialogue: 0,0:20:13.92,0:20:15.17,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:15.25,0:20:16.92,Default,,0,0,0,,- (Наозуми) Тей! -Гах!
Dialogue: 0,0:20:19.38,0:20:21.67,Default,,0,0,0,,Жібер...монка
Dialogue: 0,0:20:23.01,0:20:26.30,Default,,0,0,0,,Мені жіберме! Мен жеңілуге ​​шыдай алмаймын!
Dialogue: 0,0:20:27.64,0:20:29.81,Default,,0,0,0,,Сіз әлі де айтасыз ба?
Dialogue: 0,0:20:30.89,0:20:32.10,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:34.31,0:20:36.10,Default,,0,0,0,,Сен мықтысың
Dialogue: 0,0:20:38.23,0:20:39.90,Default,,0,0,0,,Мен емес
Dialogue: 0,0:20:40.86,0:20:42.53,Default,,0,0,0,,Сіз ешқашан жеңе алмайсыз
Dialogue: 0,0:20:43.82,0:20:44.66,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:20:46.07,0:20:48.58,Default,,0,0,0,,Осы жерде қолымды жіберсем
Dialogue: 0,0:20:50.24,0:20:52.66,Default,,0,0,0,,Дәлелдеу мүмкін болмай қалады
Dialogue: 0,0:20:54.00,0:20:55.71,Default,,0,0,0,,Бұл күшті
Dialogue: 0,0:20:55.79,0:20:59.67,Default,,0,0,0,,Бұл жай ғана әскери күш емес, бұл осындай күш.
Dialogue: 0,0:21:01.51,0:21:04.68,Default,,0,0,0,,Сіз солай ойлайсыз, солай емес пе? Хаджиме-кун
Dialogue: 0,0:21:05.38,0:21:07.43,Default,,0,0,0,,Мен шынымен солай ойлаймын.
Dialogue: 0,0:21:08.89,0:21:11.77,Default,,0,0,0,,Өйткені ол әлсіз және қабілетсіз генерал.
Dialogue: 0,0:21:11.85,0:21:14.56,Default,,0,0,0,,Менің ойымша, сіз жасай алатын нәрселер бар.
Dialogue: 0,0:21:18.31,0:21:20.44,Default,,0,0,0,,Кикучионың күші
Dialogue: 0,0:21:21.02,0:21:25.28,Default,,0,0,0,,Менің тамырым әжемге ұқсайтын сияқты.
Dialogue: 0,0:21:26.15,0:21:28.45,Default,,0,0,0,,Сонда да мен соғысқа жол бермеймін
Dialogue: 0,0:21:28.95,0:21:32.49,Default,,0,0,0,,Бұл менің самурайлар отбасының басшысы ретіндегі пайымдауым.
Dialogue: 0,0:21:33.54,0:21:35.87,Default,,0,0,0,,Дәлелдеу керек
Dialogue: 0,0:21:38.42,0:21:40.54,Default,,0,0,0,,Кім шынымен күшті?
Dialogue: 0,0:21:43.17,0:21:45.34,Default,,0,0,0,,Бұл Кикучио!
Dialogue: 0,0:21:51.10,0:21:56.10,Default,,0,0,0,,♪～
Dialogue: 0,0:23:14.30,0:23:19.31,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.48,0:23:24.44,Default,,0,0,0,,Хиджиката Тосизо
Dialogue: 0,0:23:24.52,0:23:27.65,Default,,0,0,0,,Әйтеуір қуғыншыны жеңіп шықтым.
Dialogue: 0,0:23:28.32,0:23:30.78,Default,,0,0,0,,Бірақ ақ киімді адам жоқ.
Dialogue: 0,0:23:32.03,0:23:35.58,Default,,0,0,0,,Лорд Иемочиді Ниониге неге қалдырғаныңыз маған да қызық.
Dialogue: 0,0:23:35.66,0:23:38.66,Default,,0,0,0,,Қалай болғанда да, Ниджо қамалына барған дұрыс.
Dialogue: 0,0:23:39.54,0:23:41.12,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:23:41.62,0:23:44.46,Default,,0,0,0,,Өкінішті, Соуджи, мен...
Dialogue: 0,0:23:45.71,0:23:48.13,Default,,0,0,0,,Келесі жолы «Сегіз бас»
Dialogue: 0,0:23:48.21,0:23:50.17,Default,,0,0,0,,Қараңызшы, солай.
Dialogue: 0,0:23:51.67,0:23:57.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
