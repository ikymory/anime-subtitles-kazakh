Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:05.54,Default,,0,0,0,,Уау, бұл болғанына біраз уақыт болды.
Dialogue: 0,0:00:05.63,0:00:09.42,Default,,0,0,0,,Егер сіз осында болсаңыз, сізге ақша керек.
Dialogue: 0,0:00:11.26,0:00:14.05,Default,,0,0,0,,Кімді өлтірмексің, Джиро?
Dialogue: 0,0:00:14.76,0:00:15.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:15.84,0:00:19.51,Default,,0,0,0,,Енді екінші ұрпақ, бұл Хаджиме Сайто болды ма?
Dialogue: 0,0:00:19.60,0:00:20.81,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:00:20.89,0:00:24.94,Default,,0,0,0,,Осы есіммен аталған қандай сезім?
Dialogue: 0,0:00:25.60,0:00:26.69,Default,,0,0,0,,Бөлек
Dialogue: 0,0:00:26.77,0:00:30.07,Default,,0,0,0,,Мен өз атымнан әлдеқашан бас тарттым. Мен ол туралы ештеңе ойламаймын.
Dialogue: 0,0:00:30.15,0:00:31.99,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:00:32.07,0:00:34.90,Default,,0,0,0,,Сіз шынымен олай ойламайсыз.
Dialogue: 0,0:00:34.99,0:00:38.95,Default,,0,0,0,,Ата-ананың баласына ең бірінші беретіні есім.
Dialogue: 0,0:00:40.45,0:00:43.12,Default,,0,0,0,,Жылан болсаң да, көп сөйлейсің.
Dialogue: 0,0:00:43.20,0:00:45.33,Default,,0,0,0,,Сіз ашушаңсыз.
Dialogue: 0,0:00:45.42,0:00:48.59,Default,,0,0,0,,Бұл бірінші ұрпақтан алыс.
Dialogue: 0,0:00:48.67,0:00:49.59,Default,,0,0,0,,Цк
Dialogue: 0,0:00:49.67,0:00:52.80,Default,,0,0,0,,Ол бұрынғыдай доссыз.
Dialogue: 0,0:00:52.88,0:00:57.64,Default,,0,0,0,,Бұл бірінші ұрпақтан қалған нәрсе, хахахаха...
Dialogue: 0,0:00:57.72,0:00:58.60,Default,,0,0,0,,Хун
Dialogue: 0,0:00:58.68,0:01:00.68,Default,,0,0,0,,Бұл жұмыс туралы.
Dialogue: 0,0:01:00.76,0:01:01.60,Default,,0,0,0,,Иә.
Dialogue: 0,0:01:02.43,0:01:03.85,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:01:05.85,0:01:08.23,Default,,0,0,0,,Бүркіт мұрын 10 рё
Dialogue: 0,0:01:08.31,0:01:09.86,Default,,0,0,0,,Акаме 5 машинасы
Dialogue: 0,0:01:09.94,0:01:12.19,Default,,0,0,0,,Aogaeru 20 автомобиль
Dialogue: 0,0:01:12.28,0:01:14.82,Default,,0,0,0,,Әйел ұры 30 рё
Dialogue: 0,0:01:14.90,0:01:17.28,Default,,0,0,0,,100 көлікті зақымдау
Dialogue: 0,0:01:18.53,0:01:21.37,Default,,0,0,0,,Бұл сыйлықты әскери күш деп санай аламыз ба?
Dialogue: 0,0:01:21.45,0:01:23.04,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:01:23.12,0:01:26.66,Default,,0,0,0,,Бұл таза күш пе, әлде терең реніш пе?
Dialogue: 0,0:01:26.75,0:01:29.71,Default,,0,0,0,,Сома клиентпен анықталады.
Dialogue: 0,0:01:29.79,0:01:34.67,Default,,0,0,0,,Бірақ 100 рио ерекше емес.
Dialogue: 0,0:01:34.76,0:01:37.93,Default,,0,0,0,,Кәне, екінші ұрпақ, енді шешіңдер.
Dialogue: 0,0:01:38.68,0:01:40.43,Default,,0,0,0,,Сіз кімді өлтірмексіз?
Dialogue: 0,0:01:49.60,0:01:54.94,Default,,0,0,0,,♪～
Dialogue: 0,0:03:12.85,0:03:17.86,Default,,0,0,0,,～♪
Dialogue: 0,0:03:27.49,0:03:28.49,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:28.58,0:03:30.50,Default,,0,0,0,,Мен мүлдем жұмыс таба алмаймын.
Dialogue: 0,0:03:30.58,0:03:31.54,Default,,0,0,0,,Боқ~
Dialogue: 0,0:03:31.62,0:03:34.50,Default,,0,0,0,,Сіз осы жердегі адамдарды ұрлап жұмыс істейсіз бе?
Dialogue: 0,0:03:34.58,0:03:35.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:35.50,0:03:37.75,Default,,0,0,0,,Иә? Бала қашан!
Dialogue: 0,0:03:37.84,0:03:38.67,Default,,0,0,0,,Ах
Dialogue: 0,0:03:41.34,0:03:42.51,Default,,0,0,0,,Фунакура мырза!
Dialogue: 0,0:03:42.59,0:03:44.84,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:03:44.93,0:03:47.35,Default,,0,0,0,,Сол кезде маған қамқорлық жасалды.
Dialogue: 0,0:03:47.43,0:03:49.89,Default,,0,0,0,,Сіздің арқаңызда қызым екеуміз әйтеуір үлгеріп жатырмыз.
Dialogue: 0,0:03:49.97,0:03:51.85,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:03:51.94,0:03:54.52,Default,,0,0,0,,Бұл кім? Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:03:54.60,0:03:55.48,Default,,0,0,0,,Иә
Dialogue: 0,0:03:55.56,0:03:56.52,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:56.61,0:03:59.90,Default,,0,0,0,,Сіз жұмыс іздеп жүрсіз бе?
Dialogue: 0,0:03:59.98,0:04:01.53,Default,,0,0,0,,Біреуі дұрыс.
Dialogue: 0,0:04:01.61,0:04:03.74,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:13.54,0:04:17.54,Default,,0,0,0,,А... Фуназо-сан, сен жаңа әйелсің бе?
Dialogue: 0,0:04:17.63,0:04:20.80,Default,,0,0,0,,Жоқ! Сізге таныс ретінде сәттілік
Dialogue: 0,0:04:20.88,0:04:22.47,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:04:23.93,0:04:24.84,Default,,0,0,0,,...
Dialogue: 0,0:04:25.39,0:04:27.10,Default,,0,0,0,,Кеспеге ұқсайды
Dialogue: 0,0:04:27.18,0:04:28.76,Default,,0,0,0,,Әдемі шаш.
Dialogue: 0,0:04:28.85,0:04:30.97,Default,,0,0,0,,Ахаха рахмет
Dialogue: 0,0:04:31.06,0:04:34.23,Default,,0,0,0,,Бұл Наги-сан, құрметті самурайлар отбасының әйелі.
Dialogue: 0,0:04:34.31,0:04:36.02,Default,,0,0,0,,-Ох~ -Эхехе
Dialogue: 0,0:04:36.10,0:04:37.98,Default,,0,0,0,,Неге шапалақтау!
Dialogue: 0,0:04:38.06,0:04:39.82,Default,,0,0,0,,Сіздің балаңыз бар, солай ма?
Dialogue: 0,0:04:39.90,0:04:41.40,Default,,0,0,0,,Сіз қашан дүниеге келесіз?
Dialogue: 0,0:04:41.48,0:04:44.36,Default,,0,0,0,,Білмеймін, жақын арада болатынына сенімдімін.
Dialogue: 0,0:04:44.45,0:04:45.41,Default,,0,0,0,,Сәйкес~!
Dialogue: 0,0:04:45.49,0:04:48.41,Default,,0,0,0,,Наги-сан өзенге қайықпен түскісі келеді.
Dialogue: 0,0:04:48.49,0:04:51.41,Default,,0,0,0,,Маған көмектессеңдер, мен саған аздап қалталы ақша беремін.
Dialogue: 0,0:04:51.49,0:04:53.54,Default,,0,0,0,,Мен сізге көмектесемін, өтінемін!
Dialogue: 0,0:04:53.62,0:04:55.67,Default,,0,0,0,,Арзан мәмілелер жасамаңыз!
Dialogue: 0,0:04:59.75,0:05:01.75,Default,,0,0,0,,Аяқ астынан абай болыңыз.
Dialogue: 0,0:05:01.84,0:05:02.67,Default,,0,0,0,,Иә
Dialogue: 0,0:05:02.76,0:05:06.13,Default,,0,0,0,,Неліктен өзенге түскіңіз келеді?
Dialogue: 0,0:05:06.22,0:05:07.34,Default,,0,0,0,,Құпия
Dialogue: 0,0:05:07.43,0:05:09.39,Default,,0,0,0,,Артық ақша үшін кешірім сұраймыз.
Dialogue: 0,0:05:09.47,0:05:10.68,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:10.76,0:05:12.64,Default,,0,0,0,,Мынау... осылай ма?
Dialogue: 0,0:05:12.72,0:05:14.56,Default,,0,0,0,,Жақсы идея, Таро бала!
Dialogue: 0,0:05:14.64,0:05:16.19,Default,,0,0,0,,Хехехе, мені көбірек мақта.
Dialogue: 0,0:05:16.81,0:05:17.94,Default,,0,0,0,,Міне, келдіңіз.
Dialogue: 0,0:05:18.02,0:05:19.02,Default,,0,0,0,,Иә
Dialogue: 0,0:05:20.31,0:05:21.19,Default,,0,0,0,,Ах
Dialogue: 0,0:05:21.27,0:05:25.32,Default,,0,0,0,,Наги-сан, бұл өзен! мұнда
Dialogue: 0,0:05:25.40,0:05:26.95,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:05:27.03,0:05:30.53,Default,,0,0,0,,Бұл мені таң қалдырды... Сақ болыңыз.
Dialogue: 0,0:05:30.62,0:05:32.54,Default,,0,0,0,,О... эй, эй.
Dialogue: 0,0:05:32.62,0:05:33.45,Default,,0,0,0,,Не?
Dialogue: 0,0:05:33.54,0:05:34.95,Default,,0,0,0,,Наги-сан, абай болу керек...
Dialogue: 0,0:05:35.04,0:05:36.58,Default,,0,0,0,,Әлгі ханым күдіктенеді.
Dialogue: 0,0:05:36.66,0:05:38.29,Default,,0,0,0,,А... күдікті ме?
Dialogue: 0,0:05:38.37,0:05:41.75,Default,,0,0,0,,Біріншіден, жүкті болсам да өзенге түскім келді...
Dialogue: 0,0:05:41.84,0:05:44.17,Default,,0,0,0,,Сіз өзіңізді лақтыруды ойлайсыз ба?
Dialogue: 0,0:05:44.26,0:05:46.84,Default,,0,0,0,,Өзіңізді тастаңыз ба? Амал жоқ
Dialogue: 0,0:05:51.01,0:05:54.31,Default,,0,0,0,,Әй, өте керемет.
Dialogue: 0,0:05:54.39,0:05:56.14,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:05:56.23,0:05:59.48,Default,,0,0,0,,Қараңдар, судың беті де жарқырап тұр, Мен сорып жатқандай сезінемін.
Dialogue: 0,0:05:59.56,0:06:00.77,Default,,0,0,0,,Уау, тоқташы өтінемін!
Dialogue: 0,0:06:00.86,0:06:01.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:04.11,0:06:05.69,Default,,0,0,0,,Алдан қайық келе жатыр!
Dialogue: 0,0:06:05.78,0:06:07.24,Default,,0,0,0,,Жарайды, осылай ұста!
Dialogue: 0,0:06:07.32,0:06:10.28,Default,,0,0,0,,Ол аздап шайқалады.
Dialogue: 0,0:06:13.87,0:06:14.99,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:15.08,0:06:16.83,Default,,0,0,0,,Өтінемін... қатты ұстаңыз!
Dialogue: 0,0:06:17.54,0:06:18.83,Default,,0,0,0,,Ұсталды ма?
Dialogue: 0,0:06:22.00,0:06:24.84,Default,,0,0,0,,Хе... қайықта! Бұл сияқты!
Dialogue: 0,0:06:24.92,0:06:26.92,Default,,0,0,0,,О, қайықта.
Dialogue: 0,0:06:28.59,0:06:30.72,Default,,0,0,0,,Мен бұған байыппен қарадым...
Dialogue: 0,0:06:31.64,0:06:33.81,Default,,0,0,0,,-Аа... анау Наги-сан -Хм?
Dialogue: 0,0:06:33.89,0:06:38.06,Default,,0,0,0,,Қиындық болса, қарсы болмасаң сұраймын.
Dialogue: 0,0:06:38.14,0:06:39.73,Default,,0,0,0,,Мазасыз ба?
Dialogue: 0,0:06:39.81,0:06:41.19,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:41.27,0:06:43.69,Default,,0,0,0,,Шатасып жатқан нәрселер көп.
Dialogue: 0,0:06:43.77,0:06:46.07,Default,,0,0,0,,Ха! А... бұл
Dialogue: 0,0:06:46.15,0:06:49.65,Default,,0,0,0,,Балаңыз дүниеге келеді, сондықтан оны ертерек жасамағаныңыз дұрыс...
Dialogue: 0,0:06:49.74,0:06:53.83,Default,,0,0,0,,Бала кезімде адамдар мені «Ранду, Рандо» деп атайтын.
Dialogue: 0,0:06:53.91,0:06:56.33,Default,,0,0,0,,Бұл не? Мен мұны естідім
Dialogue: 0,0:06:56.41,0:07:01.21,Default,,0,0,0,,Наги аң-таң, сондықтан «гарандо»
Dialogue: 0,0:07:01.29,0:07:04.09,Default,,0,0,0,,Мен сізді жақсы нәрсе айтты деп ойладым.
Dialogue: 0,0:07:04.17,0:07:07.34,Default,,0,0,0,,Гарандо? Бұл оның бос екенін білдіре ме?
Dialogue: 0,0:07:08.46,0:07:09.84,Default,,0,0,0,,Бұл көпір.
Dialogue: 0,0:07:10.68,0:07:12.59,Default,,0,0,0,,Өзен тамаша.
Dialogue: 0,0:07:20.43,0:07:21.60,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:07:22.31,0:07:24.15,Default,,0,0,0,,Мүлдем жоқ
Dialogue: 0,0:07:24.23,0:07:26.23,Default,,0,0,0,,Иә! Солай ма?
Dialogue: 0,0:07:26.32,0:07:29.03,Default,,0,0,0,,Ата-анасы ол туылғаннан кейін көп ұзамай қайтыс болды.
Dialogue: 0,0:07:29.11,0:07:31.78,Default,,0,0,0,,Мен жай ғана жақсы адамды кездестірдім.
Dialogue: 0,0:07:31.86,0:07:36.33,Default,,0,0,0,,Ол самурай емес, ол өте жақсы емес және ол үнемі қиындық тудырады.
Dialogue: 0,0:07:36.41,0:07:37.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:38.29,0:07:39.83,Default,,0,0,0,,Бірақ менің ойымша
Dialogue: 0,0:07:40.33,0:07:41.21,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:07:41.29,0:07:43.67,Default,,0,0,0,,Әй, жарты ай
Dialogue: 0,0:07:44.58,0:07:46.67,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:07:46.75,0:07:51.92,Default,,0,0,0,,Бір қызығы, барлық әдемі нәрселерге бірдеңе жетіспейді.
Dialogue: 0,0:07:53.89,0:07:56.68,Default,,0,0,0,,Мүмкін біз де солай шығармыз.
Dialogue: 0,0:07:57.39,0:07:58.68,Default,,0,0,0,,Мына өзен сияқты
Dialogue: 0,0:07:59.27,0:08:03.94,Default,,0,0,0,,Мен әлсіз болсам да, дөрекі болсам да, Мен күтпеген жерге сыпырылып кетсем де
Dialogue: 0,0:08:04.02,0:08:06.02,Default,,0,0,0,,Кейде бұлтты болса да
Dialogue: 0,0:08:06.11,0:08:10.94,Default,,0,0,0,,Сыйластық, берілу, кішіпейілділік, Таоякани
Dialogue: 0,0:08:13.03,0:08:16.45,Default,,0,0,0,,Ағып жатқандай өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:08:20.54,0:08:21.83,Default,,0,0,0,,Бұл
Dialogue: 0,0:08:21.91,0:08:24.62,Default,,0,0,0,,Балалы болудан қорықпайсыз ба?
Dialogue: 0,0:08:24.71,0:08:26.04,Default,,0,0,0,,Ауырсынатын көрінеді.
Dialogue: 0,0:08:26.13,0:08:27.96,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:08:28.04,0:08:29.96,Default,,0,0,0,,Бірақ баяу.
Dialogue: 0,0:08:30.05,0:08:30.96,Default,,0,0,0,,Бос па?
Dialogue: 0,0:08:31.05,0:08:35.47,Default,,0,0,0,,Ал, ертең мен мұнымен айналысамын.
Dialogue: 0,0:08:37.39,0:08:38.51,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:08:38.60,0:08:42.60,Default,,0,0,0,,Не? оғаш? Біртүрлі ма?
Dialogue: 0,0:08:42.68,0:08:44.39,Default,,0,0,0,,Бұл адам күшті
Dialogue: 0,0:08:44.48,0:08:46.40,Default,,0,0,0,,Ондай күш бар ма?
Dialogue: 0,0:08:47.02,0:08:48.31,Default,,0,0,0,,- (Йотаро) Эй! -(Наги) Ой.
Dialogue: 0,0:08:48.40,0:08:50.36,Default,,0,0,0,,Наги-сан!
Dialogue: 0,0:08:50.44,0:08:52.11,Default,,0,0,0,,Мен оны таптым!
Dialogue: 0,0:08:52.19,0:08:53.28,Default,,0,0,0,,Ах
Dialogue: 0,0:08:53.36,0:08:54.74,Default,,0,0,0,,Күйеуі
Dialogue: 0,0:08:57.82,0:08:59.41,Default,,0,0,0,,Кешіріңіз, Фунакура мырза.
Dialogue: 0,0:08:59.49,0:09:01.79,Default,,0,0,0,,Менің ойымша, сіз тағы да дөрекі сөйлеп жатырсыз.
Dialogue: 0,0:09:01.87,0:09:02.75,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:09:02.83,0:09:05.71,Default,,0,0,0,,Жарайды, мен ақылсыз ештеңе айтып тұрған жоқпын.
Dialogue: 0,0:09:05.79,0:09:08.17,Default,,0,0,0,,Бұл балалар да маған көмектесті.
Dialogue: 0,0:09:08.25,0:09:09.34,Default,,0,0,0,,Хаха мен көрдім.
Dialogue: 0,0:09:09.42,0:09:11.46,Default,,0,0,0,,-Нио десу -(Таро) Бұл... Таро.
Dialogue: 0,0:09:11.55,0:09:14.01,Default,,0,0,0,,Жоқ, мен шыдай алмаймын.
Dialogue: 0,0:09:14.09,0:09:17.30,Default,,0,0,0,,Мен Санджо Охаши көпірінің арғы жағында дойдо ойнап жатырмын.
Dialogue: 0,0:09:17.39,0:09:18.47,Default,,0,0,0,,Менің атым Йотаро.
Dialogue: 0,0:09:18.55,0:09:22.10,Default,,0,0,0,,Егер сіз осы аймақта болсаңыз, тоқтаңыз.
Dialogue: 0,0:09:22.18,0:09:23.52,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:09:24.27,0:09:25.77,Default,,0,0,0,,Қараңғы түскенше үйге қайтайық.
Dialogue: 0,0:09:25.85,0:09:27.14,Default,,0,0,0,,Иә
Dialogue: 0,0:09:28.19,0:09:29.31,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:29.40,0:09:30.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:30.40,0:09:33.11,Default,,0,0,0,,Мен Наги сияқты қалай күшті боламын?
Dialogue: 0,0:09:36.86,0:09:39.49,Default,,0,0,0,,Сіз жеткілікті күштісіз.
Dialogue: 0,0:09:40.53,0:09:41.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:41.45,0:09:44.08,Default,,0,0,0,,Жоқ! Мен тофу сатып алуым керек
Dialogue: 0,0:09:44.16,0:09:45.37,Default,,0,0,0,,Секір!!
Dialogue: 0,0:09:48.12,0:09:49.79,Default,,0,0,0,,-Уау - (Йотаро) А, бұл қауіпті.
Dialogue: 0,0:09:49.88,0:09:52.09,Default,,0,0,0,,- (Йотаро) Абайлаңыз - Уухоу
Dialogue: 0,0:09:53.13,0:09:54.21,Default,,0,0,0,,-Хмф! -(Таро) А?
Dialogue: 0,0:09:54.30,0:09:56.59,Default,,0,0,0,,Жоқ, бұл мүлдем күшті емес сияқты!
Dialogue: 0,0:09:57.17,0:09:58.84,Default,,0,0,0,,-Эй - (Таро) Уау! Ол қауіп төніп тұр
Dialogue: 0,0:09:58.93,0:10:00.47,Default,,0,0,0,,Таро-кун, мықты бол!
Dialogue: 0,0:10:00.55,0:10:03.06,Default,,0,0,0,,Жоқ, олай емес, сіз ақша тауып жатырсыз!
Dialogue: 0,0:10:03.64,0:10:04.89,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:10:04.97,0:10:07.02,Default,,0,0,0,,Ойлан, өйткені сен білмейсің
Dialogue: 0,0:10:08.27,0:10:10.31,Default,,0,0,0,,Таро-кун! Ендеше ақша табайық
Dialogue: 0,0:10:10.40,0:10:11.90,Default,,0,0,0,,«Күшті» деген нені білдіреді?
Dialogue: 0,0:10:12.48,0:10:14.65,Default,,0,0,0,,Кішкене жақындайық
Dialogue: 0,0:10:14.73,0:10:16.11,Default,,0,0,0,,-Фуназо-сан - (Фуназо) Иә?
Dialogue: 0,0:10:16.19,0:10:18.07,Default,,0,0,0,,Мен сізге қайықты қайтаруға көмектесемін.
Dialogue: 0,0:10:18.15,0:10:20.41,Default,,0,0,0,,Маған балық сатуға көмектесе аласыз ба?
Dialogue: 0,0:10:20.49,0:10:21.74,Default,,0,0,0,,Мен ақшаны аламын.
Dialogue: 0,0:10:21.82,0:10:23.66,Default,,0,0,0,,Әй, олай айтпа хахаха
Dialogue: 0,0:10:24.24,0:10:25.95,Default,,0,0,0,,Мына жігіт мықты...
Dialogue: 0,0:10:29.96,0:10:33.75,Default,,0,0,0,,Мен қалада балық сатамын деп ешқашан ойламадым...
Dialogue: 0,0:10:33.84,0:10:35.71,Default,,0,0,0,,Бірақ Фунакура мырза қуанып қалды, солай емес пе?
Dialogue: 0,0:10:35.80,0:10:37.21,Default,,0,0,0,,- (Тодо) Уа - (Окита) Эй!
Dialogue: 0,0:10:37.30,0:10:38.63,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:39.51,0:10:40.76,Default,,0,0,0,,үшінна!
Dialogue: 0,0:10:42.47,0:10:43.55,Default,,0,0,0,,Кешіктіріңіз
Dialogue: 0,0:10:43.64,0:10:45.97,Default,,0,0,0,,Хажиме-кун, сен бірінші қайттың, солай ма?
Dialogue: 0,0:10:47.60,0:10:48.64,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:10:48.73,0:10:51.15,Default,,0,0,0,,Саған бірдеңе берейік, тоз-тоз болып қалдың.
Dialogue: 0,0:10:51.23,0:10:52.73,Default,,0,0,0,,Шу жасаңыз! Қарғыс атқыр маймыл
Dialogue: 0,0:10:52.81,0:10:54.07,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,0:10:57.03,0:10:58.99,Default,,0,0,0,,Тағы бір тозығы жеткен!
Dialogue: 0,0:10:59.07,0:11:01.36,Default,,0,0,0,,(Серизаваның күлкісі)
Dialogue: 0,0:11:01.45,0:11:04.24,Default,,0,0,0,,Мен қазір оралдым! Ui~
Dialogue: 0,0:11:04.33,0:11:05.83,Default,,0,0,0,,Сіз мас екенсіз.
Dialogue: 0,0:11:05.91,0:11:07.62,Default,,0,0,0,,Сіз ақша таптыңыз ба?
Dialogue: 0,0:11:07.70,0:11:10.12,Default,,0,0,0,,Бұл ақымақ сұрақ!
Dialogue: 0,0:11:10.21,0:11:13.63,Default,,0,0,0,,Хаха! Ересектер қандай сенімді!
Dialogue: 0,0:11:13.71,0:11:14.92,Default,,0,0,0,,(қол соғу дыбысы)
Dialogue: 0,0:11:15.00,0:11:16.09,Default,,0,0,0,,Ах
Dialogue: 0,0:11:16.84,0:11:19.17,Default,,0,0,0,,Аяқталды!
Dialogue: 0,0:11:19.26,0:11:21.76,Default,,0,0,0,,Ақша жинау аяқталды.
Dialogue: 0,0:11:23.30,0:11:26.26,Default,,0,0,0,,Енді барлығы осында, есептеп көрейік.
Dialogue: 0,0:11:26.93,0:11:30.39,Default,,0,0,0,,Хаори жасау үшін мақсатты сома қандай? Жақсы!
Dialogue: 0,0:11:30.48,0:11:32.02,Default,,0,0,0,,250 автомобиль
Dialogue: 0,0:11:32.10,0:11:35.11,Default,,0,0,0,,Енді тапқан ақшаңызды салыңыз!
Dialogue: 0,0:11:35.61,0:11:36.61,Default,,0,0,0,,О!
Dialogue: 0,0:11:36.69,0:11:38.03,Default,,0,0,0,,- (Хираяма) Йошикита - (Хирама) Маған қалдырыңыз.
Dialogue: 0,0:11:38.11,0:11:39.36,Default,,0,0,0,,Мен де
Dialogue: 0,0:11:39.44,0:11:40.28,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:11:40.36,0:11:41.61,Default,,0,0,0,,Жарайсыңдар бәріңе!
Dialogue: 0,0:11:41.70,0:11:43.28,Default,,0,0,0,,- (Таро) Керемет - (Серизава) Шығар!
Dialogue: 0,0:11:43.36,0:11:45.28,Default,,0,0,0,,Соңы
Dialogue: 0,0:11:45.37,0:11:48.16,Default,,0,0,0,,Сонымен, сен қанша жинадың?
Dialogue: 0,0:11:48.24,0:11:50.66,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:53.75,0:11:56.29,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:11:56.38,0:11:57.67,Default,,0,0,0,,8 сөйлем?
Dialogue: 0,0:11:57.75,0:11:59.80,Default,,0,0,0,,Бұл не?!
Dialogue: 0,0:11:59.88,0:12:02.05,Default,,0,0,0,,Балалар! Шыққан сияқты болмаңыз!
Dialogue: 0,0:12:02.13,0:12:03.55,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:12:03.63,0:12:06.18,Default,,0,0,0,,Сонымен, бұл екі тиын кімдікі?
Dialogue: 0,0:12:06.26,0:12:08.26,Default,,0,0,0,,Бұл мен және Тарокун.
Dialogue: 0,0:12:08.35,0:12:10.31,Default,,0,0,0,,Мен балық сатуға көмектестім.
Dialogue: 0,0:12:10.39,0:12:12.94,Default,,0,0,0,,Торғайдың көз жасындай болғанына өкінемін.
Dialogue: 0,0:12:13.02,0:12:16.56,Default,,0,0,0,,А...кешірім сұрама! Не істеп жатсыңдар!?
Dialogue: 0,0:12:16.65,0:12:18.61,Default,,0,0,0,,Мен Бакучиден жеңілдім, бұл Суккаракан.
Dialogue: 0,0:12:18.69,0:12:21.32,Default,,0,0,0,,Мен кепілге қойған қылышты да қайтару керек.
Dialogue: 0,0:12:21.40,0:12:23.32,Default,,0,0,0,,Енді самурай емес
Dialogue: 0,0:12:23.40,0:12:24.70,Default,,0,0,0,,Оған өзің кінәлісің.
Dialogue: 0,0:12:24.78,0:12:26.24,Default,,0,0,0,,Окита-сан және басқалар ше?
Dialogue: 0,0:12:26.32,0:12:27.32,Default,,0,0,0,,Мен жұмыс істедім
Dialogue: 0,0:12:27.41,0:12:30.08,Default,,0,0,0,,Сүйкімді жасырын түрде қадағалаңыз және оның күзетшісі ретінде әрекет етіңіз.
Dialogue: 0,0:12:30.16,0:12:31.00,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:12:31.08,0:12:33.62,Default,,0,0,0,,Дегенмен бала жақсы үйдің қызы болды.
Dialogue: 0,0:12:33.71,0:12:36.75,Default,,0,0,0,,Мен әкеме ризашылығымды білдіргім келеді...
Dialogue: 0,0:12:36.83,0:12:38.59,Default,,0,0,0,,Иә, бұл керемет емес пе?
Dialogue: 0,0:12:38.67,0:12:40.34,Default,,0,0,0,,Өте жақсы шунга!
Dialogue: 0,0:12:40.42,0:12:41.34,Default,,0,0,0,,Зуко!
Dialogue: 0,0:12:41.42,0:12:42.34,Default,,0,0,0,,Неге!
Dialogue: 0,0:12:42.42,0:12:43.84,Default,,0,0,0,,Кондо мырза ше?
Dialogue: 0,0:12:43.92,0:12:44.76,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:45.55,0:12:48.47,Default,,0,0,0,,Мысықты ұстай алмау – нағыз азғындықтың шыңы
Dialogue: 0,0:12:48.55,0:12:50.26,Default,,0,0,0,,Бұл шынымен де пайдасыз!
Dialogue: 0,0:12:50.35,0:12:52.43,Default,,0,0,0,,Мен далаға көмектестім.
Dialogue: 0,0:12:52.52,0:12:53.89,Default,,0,0,0,,О! Ген-сан
Dialogue: 0,0:12:53.98,0:12:56.35,Default,,0,0,0,,«Рахмет» Алғыс сөзін алдым.
Dialogue: 0,0:12:56.44,0:12:57.52,Default,,0,0,0,,Ақша алыңыз!
Dialogue: 0,0:12:57.61,0:12:59.40,Default,,0,0,0,,Серизава және басқалары ше?
Dialogue: 0,0:12:59.48,0:13:01.98,Default,,0,0,0,,Дұрыс, Доджоны бұзыңыз!
Dialogue: 0,0:13:02.07,0:13:03.74,Default,,0,0,0,,Әрине, қатарынан жеңістер
Dialogue: 0,0:13:03.82,0:13:06.45,Default,,0,0,0,,Ақша табу өте оңай
Dialogue: 0,0:13:06.53,0:13:09.49,Default,,0,0,0,,Олар маған белгі үшін ақша ұсынды!
Dialogue: 0,0:13:09.58,0:13:10.41,Default,,0,0,0,,О!
Dialogue: 0,0:13:10.49,0:13:12.08,Default,,0,0,0,,Жоқ, мен өзімді жақсы сезінемін.
Dialogue: 0,0:13:12.16,0:13:13.58,Default,,0,0,0,,Мен өзімді жақсы сезінемін
Dialogue: 0,0:13:13.66,0:13:17.46,Default,,0,0,0,,Мен оның бәрін сусындарға жұмсадым! Хахахаха!
Dialogue: 0,0:13:17.54,0:13:19.46,Default,,0,0,0,,Жоқ... не істеуіміз керек?
Dialogue: 0,0:13:19.54,0:13:21.96,Default,,0,0,0,,Бұл мүлдем ақша жинау емес!
Dialogue: 0,0:13:23.80,0:13:25.22,Default,,0,0,0,,Ах
Dialogue: 0,0:13:26.43,0:13:27.43,Default,,0,0,0,,10 автомобиль
Dialogue: 0,0:13:27.51,0:13:29.35,Default,,0,0,0,,Не!? 10 көлік?
Dialogue: 0,0:13:29.43,0:13:30.68,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:30.76,0:13:33.22,Default,,0,0,0,,Сіз бакучимен жеңдіңіз, солай ма? Бақытты жігіт!
Dialogue: 0,0:13:33.31,0:13:34.93,Default,,0,0,0,,Менімен ұйықтама!
Dialogue: 0,0:13:35.02,0:13:37.65,Default,,0,0,0,,Иә? Өйткені, бұл жігіттен қанның иісі бар.
Dialogue: 0,0:13:37.73,0:13:38.56,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:13:38.65,0:13:40.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:46.15,0:13:48.82,Default,,0,0,0,,Әлі де жетпейді... Пиен
Dialogue: 0,0:13:48.91,0:13:51.78,Default,,0,0,0,,Тек балалар ғана ақша табады деген шындық
Dialogue: 0,0:13:51.87,0:13:53.04,Default,,0,0,0,,Хаори ше...
Dialogue: 0,0:13:53.12,0:13:55.00,Default,,0,0,0,,Мен оны ешқашан жасай алмаймын.
Dialogue: 0,0:13:55.50,0:13:56.58,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:57.21,0:13:58.83,Default,,0,0,0,,Мен оны Айзу руынан алғанмын.
Dialogue: 0,0:13:58.92,0:14:00.46,Default,,0,0,0,,Дәл 250 рио
Dialogue: 0,0:14:00.54,0:14:02.96,Default,,0,0,0,,Яманами мырза! Ниими мырза!
Dialogue: 0,0:14:06.05,0:14:07.80,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:14:08.55,0:14:09.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:10.68,0:14:12.56,Default,,0,0,0,,Енді сіз хаори жасай аласыз!
Dialogue: 0,0:14:12.64,0:14:14.97,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,0:14:15.64,0:14:16.64,Default,,0,0,0,,Сіз тапқырсыз.
Dialogue: 0,0:14:16.73,0:14:17.77,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:17.85,0:14:20.44,Default,,0,0,0,,Пайызсыз және белгісіз мерзім
Dialogue: 0,0:14:20.52,0:14:23.02,Default,,0,0,0,,Генералдың ұлылығы жұмыста болған сияқты.
Dialogue: 0,0:14:23.11,0:14:23.94,Default,,0,0,0,,Иә
Dialogue: 0,0:14:24.86,0:14:26.94,Default,,0,0,0,,көремін.
Dialogue: 0,0:14:27.03,0:14:30.91,Default,,0,0,0,,Бірақ құмарханада кездестірген әлгі қарт жақсы жігіт еді.
Dialogue: 0,0:14:30.99,0:14:32.37,Default,,0,0,0,,Ол маған сусын сатып алды.
Dialogue: 0,0:14:32.45,0:14:35.58,Default,,0,0,0,,Хмм, бұл өте жақсы құрмет болды.
Dialogue: 0,0:14:35.66,0:14:38.12,Default,,0,0,0,,Мен сені тағы көремін деп үміттенемін!
Dialogue: 0,0:14:44.80,0:14:47.59,Default,,0,0,0,,Әйтеуір, отырыңыз, қария.
Dialogue: 0,0:14:47.67,0:14:50.05,Default,,0,0,0,,Жоқ, Қойой – өрлеу жыры.
Dialogue: 0,0:14:50.13,0:14:53.10,Default,,0,0,0,,үшін сонда болғанша күту мағынасы бар.
Dialogue: 0,0:14:53.18,0:14:55.97,Default,,0,0,0,,Қалғандары баяуырақ болады.
Dialogue: 0,0:14:56.06,0:14:57.85,Default,,0,0,0,,Алдымен бастайық.
Dialogue: 0,0:14:57.93,0:15:00.52,Default,,0,0,0,,Хухахаха! ашулы
Dialogue: 0,0:15:00.60,0:15:02.48,Default,,0,0,0,,Түні бойы ішейік!
Dialogue: 0,0:15:02.56,0:15:04.15,Default,,0,0,0,,Мен ішіп жүрмін
Dialogue: 0,0:15:04.23,0:15:07.44,Default,,0,0,0,,Мен мас балыққа қызық әңгіме айтамын.
Dialogue: 0,0:15:11.74,0:15:15.12,Default,,0,0,0,,Біздің қан Рисшидан, мақсатымыз Мибро.
Dialogue: 0,0:15:16.37,0:15:17.62,Default,,0,0,0,,Хо
Dialogue: 0,0:15:17.70,0:15:20.08,Default,,0,0,0,,Тыңдаңыздар, менде бір ой бар.
Dialogue: 0,0:15:20.16,0:15:21.37,Default,,0,0,0,,Міне, жоспар
Dialogue: 0,0:15:21.46,0:15:23.29,Default,,0,0,0,,Иә? Ол кім?
Dialogue: 0,0:15:27.67,0:15:30.05,Default,,0,0,0,,Наозуми, менің жездем, Наги.
Dialogue: 0,0:15:30.13,0:15:31.55,Default,,0,0,0,,Наги?
Dialogue: 0,0:15:31.63,0:15:35.26,Default,,0,0,0,,Менің ағамның әйелі болса да, тыңдау нені білдіреді?
Dialogue: 0,0:15:35.35,0:15:38.72,Default,,0,0,0,,Мен жақсы тофу сатып алдым. Сізге ұнайды, солай ма?
Dialogue: 0,0:15:38.81,0:15:40.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:40.31,0:15:41.98,Default,,0,0,0,,Мен... Маған қазір керек емес!
Dialogue: 0,0:15:42.06,0:15:43.31,Default,,0,0,0,,О.
Dialogue: 0,0:15:44.31,0:15:46.69,Default,,0,0,0,,Әйелдерге дохжоға жақындауға жол бермеңіз!
Dialogue: 0,0:15:46.77,0:15:48.69,Default,,0,0,0,,Субару-кун?
Dialogue: 0,0:15:49.32,0:15:52.15,Default,,0,0,0,,Хмм, мен қиналып қалдым.
Dialogue: 0,0:15:52.24,0:15:54.11,Default,,0,0,0,,- (Йотаро) Наги-сан - Ха!
Dialogue: 0,0:15:54.20,0:15:56.91,Default,,0,0,0,,Бұл жақсы емес пе? Мен кенеттен футоннан сырғып түстім.
Dialogue: 0,0:15:56.99,0:15:58.95,Default,,0,0,0,,Бұл құрсақтағы балаңызға зиян тигізеді.
Dialogue: 0,0:15:59.45,0:16:00.87,Default,,0,0,0,,Йотаро-сан
Dialogue: 0,0:16:00.96,0:16:03.71,Default,,0,0,0,,Сол доджода менің қайын ағаларым...
Dialogue: 0,0:16:03.79,0:16:04.71,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:04.79,0:16:07.50,Default,,0,0,0,,Бауырларыңды жайына қалдыр.
Dialogue: 0,0:16:18.10,0:16:19.60,Default,,0,0,0,,- (Йотаро) Әй... - Қалай болды?
Dialogue: 0,0:16:19.68,0:16:21.23,Default,,0,0,0,,Наги-сан қозғалмайды.
Dialogue: 0,0:16:21.31,0:16:23.23,Default,,0,0,0,,Орындалды, енді бәрі жақсы.
Dialogue: 0,0:16:23.31,0:16:24.52,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:24.60,0:16:27.52,Default,,0,0,0,,Иә, ұйықтайық, кеш болып қалды.
Dialogue: 0,0:16:31.32,0:16:33.28,Default,,0,0,0,,Менде бір нәрсе бар.
Dialogue: 0,0:16:33.36,0:16:34.95,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:16:35.03,0:16:36.03,Default,,0,0,0,,Мазасыз ба?
Dialogue: 0,0:16:36.12,0:16:40.29,Default,,0,0,0,,Қайын атаңның кенет жоғалып кеткеніне екі ай болды.
Dialogue: 0,0:16:40.37,0:16:41.83,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:16:41.91,0:16:43.50,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:16:43.58,0:16:46.71,Default,,0,0,0,,Мені күнде дожода көретін болса да.
Dialogue: 0,0:16:46.79,0:16:48.29,Default,,0,0,0,,Әкем туралы.
Dialogue: 0,0:16:48.38,0:16:52.05,Default,,0,0,0,,Бәлкім, ол кенеттен елдің түкпір-түкпіріне оқу-жаттығу сапарына кеткен шығар.
Dialogue: 0,0:16:52.13,0:16:53.76,Default,,0,0,0,,Тағы да бар
Dialogue: 0,0:16:53.84,0:16:57.14,Default,,0,0,0,,Доджо шәкірттері Йотароға осылай қарайды.
Dialogue: 0,0:16:57.22,0:16:58.05,Default,,0,0,0,,Көздер?
Dialogue: 0,0:16:58.14,0:16:59.64,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:16:59.72,0:17:01.93,Default,,0,0,0,,Аздап мазақ еткендей болдым.
Dialogue: 0,0:17:02.02,0:17:04.69,Default,,0,0,0,,Менің ойымша, сіз ол ақымақ сияқты әрекет етеді деп айта аласыз ...
Dialogue: 0,0:17:04.77,0:17:06.44,Default,,0,0,0,,Түсіндім, Наги-сан.
Dialogue: 0,0:17:06.52,0:17:08.27,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:17:08.36,0:17:10.19,Default,,0,0,0,,5 адам емес, 4 адам
Dialogue: 0,0:17:10.27,0:17:14.36,Default,,0,0,0,,Тіпті біз білмейтін адамдарға да бұрынғы адамдар ұнайды.
Dialogue: 0,0:17:14.45,0:17:16.78,Default,,0,0,0,,Мен көп кіріп-шығамын.
Dialogue: 0,0:17:16.86,0:17:17.70,Default,,0,0,0,,Иә
Dialogue: 0,0:17:17.78,0:17:21.12,Default,,0,0,0,,Барлық Наозуми ел аралап шықты
Dialogue: 0,0:17:21.20,0:17:23.08,Default,,0,0,0,,Мен қайтып келгеннен кейін болды.
Dialogue: 0,0:17:24.04,0:17:25.21,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:25.29,0:17:27.67,Default,,0,0,0,,Көңіл көтеріп жүрген сияқтысың, аға.
Dialogue: 0,0:17:27.75,0:17:29.84,Default,,0,0,0,,Мен де кіре аламын ба?
Dialogue: 0,0:17:29.92,0:17:31.55,Default,,0,0,0,,Сізге пайда жоқ!
Dialogue: 0,0:17:31.63,0:17:32.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:32.84,0:17:36.09,Default,,0,0,0,,Цк, кет, ақ болып барасың.
Dialogue: 0,0:17:37.38,0:17:40.80,Default,,0,0,0,,Бүгін қайта бастайтын шығармын~ Хахаха...
Dialogue: 0,0:17:42.64,0:17:44.43,Default,,0,0,0,,Э? Хмм…
Dialogue: 0,0:17:44.52,0:17:46.81,Default,,0,0,0,,Ағаңмен дұрыс сөйлесіп көр.
Dialogue: 0,0:17:46.89,0:17:50.44,Default,,0,0,0,,Ендеше, Наги-сан, көп уайымдамай, сау бала туып берші.
Dialogue: 0,0:17:53.23,0:17:54.07,Default,,0,0,0,,Иә
Dialogue: 0,0:17:55.03,0:17:57.95,Default,,0,0,0,,Ей! Оу!
Dialogue: 0,0:17:58.03,0:18:00.95,Default,,0,0,0,,Ей! Оу!
Dialogue: 0,0:18:01.03,0:18:03.70,Default,,0,0,0,,Иә, жақсы, дауыстап айт!
Dialogue: 0,0:18:03.79,0:18:06.25,Default,,0,0,0,,Ей! Оу!
Dialogue: 0,0:18:09.04,0:18:12.09,Default,,0,0,0,,Нишимура мырза, білегіңізге не болды?
Dialogue: 0,0:18:12.17,0:18:13.21,Default,,0,0,0,,Я...
Dialogue: 0,0:18:13.30,0:18:16.22,Default,,0,0,0,,Сіз ұрысып қалдыңыз ба? Жоқ.
Dialogue: 0,0:18:16.30,0:18:20.22,Default,,0,0,0,,Нишимура мырза мықты, сондықтан қылышыңды қажетсіз жұлып алма.
Dialogue: 0,0:18:21.93,0:18:22.76,Default,,0,0,0,,Хун
Dialogue: 0,0:18:22.85,0:18:26.23,Default,,0,0,0,,Сіз... Кешіріңіз? Мен сені ренжіттім бе?
Dialogue: 0,0:18:26.81,0:18:27.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:30.81,0:18:35.23,Default,,0,0,0,,Хмм, бұл қиын жол алда.
Dialogue: 0,0:18:36.94,0:18:40.91,Default,,0,0,0,,Біз бұл Киото қаласын ұрыс алаңына айналдырамыз.
Dialogue: 0,0:18:42.07,0:18:46.50,Default,,0,0,0,,Жалғыз нәрсе - Йотароны мұны қалай істеуге итермелеу.
Dialogue: 0,0:18:51.83,0:18:55.00,Default,,0,0,0,,Ене, мені қорғашы.
Dialogue: 0,0:18:55.09,0:18:56.21,Default,,0,0,0,,О... ханым!
Dialogue: 0,0:18:56.30,0:18:57.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:57.21,0:18:59.97,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:19:00.59,0:19:03.14,Default,,0,0,0,,Өлгенімнің жылдығы болғандықтан осында деп ойладым.
Dialogue: 0,0:19:04.39,0:19:06.56,Default,,0,0,0,,Не істеп жатырсың сонша асығыс?
Dialogue: 0,0:19:06.64,0:19:10.73,Default,,0,0,0,,Кеше түнде мен Ниджо қамалының жанында әбігерге түстім.
Dialogue: 0,0:19:10.81,0:19:13.06,Default,,0,0,0,,Ер адам тілін тістеп, өз-өзіне қол жұмсады.
Dialogue: 0,0:19:13.15,0:19:15.65,Default,,0,0,0,,Магистратура оның менің шәкіртім екенін сұрады.
Dialogue: 0,0:19:15.73,0:19:16.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:20.15,0:19:23.07,Default,,0,0,0,,Әй, ханым! Жүгірмегені дұрыс...
Dialogue: 0,0:19:23.16,0:19:25.08,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:19:30.12,0:19:32.54,Default,,0,0,0,,Мақсат - Мибро
Dialogue: 0,0:19:33.13,0:19:34.79,Default,,0,0,0,,Mibro дегеніміз не?
Dialogue: 0,0:19:36.38,0:19:39.55,Default,,0,0,0,,Наги-сан, үйге келші.
Dialogue: 0,0:19:41.88,0:19:44.60,Default,,0,0,0,,Бірдеңе болғалы тұр.
Dialogue: 0,0:19:45.10,0:19:46.89,Default,,0,0,0,,Өте жаман нәрсе болды.
Dialogue: 0,0:19:49.73,0:19:52.06,Default,,0,0,0,,Кешіріңіз, көрейін.
Dialogue: 0,0:19:52.77,0:19:54.94,Default,,0,0,0,,Йотаро-сан, кеше қалай өтті?
Dialogue: 0,0:19:55.02,0:19:56.19,Default,,0,0,0,,Ах
Dialogue: 0,0:19:56.27,0:19:58.03,Default,,0,0,0,,Мен қуаныштымын.
Dialogue: 0,0:19:58.11,0:20:00.15,Default,,0,0,0,,Нии-кун келгеніңізге рахмет
Dialogue: 0,0:20:00.24,0:20:02.40,Default,,0,0,0,,Наги-сан үйде ме?
Dialogue: 0,0:20:02.49,0:20:04.87,Default,,0,0,0,,Мен бүгін қабірге баратын шығармын.
Dialogue: 0,0:20:04.95,0:20:06.28,Default,,0,0,0,,Менің ойымша, ол жақында оралады.
Dialogue: 0,0:20:06.99,0:20:08.12,Default,,0,0,0,,Нии-кун...
Dialogue: 0,0:20:08.62,0:20:11.25,Default,,0,0,0,,Кеше әйелім қамқорлық жасады.
Dialogue: 0,0:20:11.33,0:20:13.54,Default,,0,0,0,,Мен көремін. Бұл жақсы.
Dialogue: 0,0:20:13.62,0:20:16.08,Default,,0,0,0,,Кенеттен келгенім үшін кешіріңіз.
Dialogue: 0,0:20:16.17,0:20:19.38,Default,,0,0,0,,Негізі мен Конкай Комиджи храмының Айзу руынан қарызға ақша алдым.
Dialogue: 0,0:20:19.46,0:20:21.38,Default,,0,0,0,,Мен сізге алғыс айту үшін келдім.
Dialogue: 0,0:20:21.47,0:20:24.30,Default,,0,0,0,,Хо, сендер Айзудансыңдар ма?
Dialogue: 0,0:20:24.38,0:20:26.51,Default,,0,0,0,,О, жоқ, бұл дұрыс емес.
Dialogue: 0,0:20:26.60,0:20:28.18,Default,,0,0,0,,Біз Мибромыз
Dialogue: 0,0:20:28.26,0:20:30.68,Default,,0,0,0,,Ха! Мибро?
Dialogue: 0,0:20:30.77,0:20:34.39,Default,,0,0,0,,Бірақ Додзо бәрібір жақсы.
Dialogue: 0,0:20:34.48,0:20:35.65,Default,,0,0,0,,Сізге ұнайды ма?
Dialogue: 0,0:20:35.73,0:20:36.69,Default,,0,0,0,,Иә
Dialogue: 0,0:20:37.27,0:20:38.90,Default,,0,0,0,,Кешігу үшін кешірім сұраймыз.
Dialogue: 0,0:20:38.98,0:20:43.45,Default,,0,0,0,,Менің атым Йотаро Киохачи, осы Киохачи мектебінің жетекшісі.
Dialogue: 0,0:20:43.53,0:20:45.74,Default,,0,0,0,,Доджо осындай жаста!
Dialogue: 0,0:20:45.82,0:20:46.78,Default,,0,0,0,,29
Dialogue: 0,0:20:46.87,0:20:47.95,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:20:48.03,0:20:50.29,Default,,0,0,0,,Мен сондай-ақ Эдода дойдомен айналысамын.
Dialogue: 0,0:20:50.37,0:20:51.87,Default,,0,0,0,,О! Солай ма?
Dialogue: 0,0:20:51.95,0:20:53.62,Default,,0,0,0,,Мен сізге бір жақсылық сұрағым келеді.
Dialogue: 0,0:20:53.71,0:20:56.21,Default,,0,0,0,,Бұл жақсы. Мен оны зерттегім келеді.
Dialogue: 0,0:20:56.29,0:20:59.59,Default,,0,0,0,,Наозуми ол менің інім болса да
Dialogue: 0,0:20:59.67,0:21:02.67,Default,,0,0,0,,Йотароны Рисшиданның басына қоюдың қажеті жоқ.
Dialogue: 0,0:21:03.34,0:21:07.59,Default,,0,0,0,,Ағам мен әйеліме анық сөйлей алмай, шәкірттерім сынға алып жатыр.
Dialogue: 0,0:21:10.68,0:21:11.97,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:21:12.06,0:21:15.10,Default,,0,0,0,,Балалар сендер нағыз Йотароны білмейсіңдер.
Dialogue: 0,0:21:15.19,0:21:19.31,Default,,0,0,0,,Ол жекпе-жек өнерінің бейнесі, Рисшиданның басшысы болуға лайық.
Dialogue: 0,0:21:20.15,0:21:22.07,Default,,0,0,0,,Шынымен Соғыс Құдайы
Dialogue: 0,0:21:22.15,0:21:23.90,Default,,0,0,0,,Жоғалту мүмкін емес
Dialogue: 0,0:21:24.40,0:21:27.32,Default,,0,0,0,,Мен ұтылсам ше?
Dialogue: 0,0:21:28.41,0:21:29.24,Default,,0,0,0,,Хун
Dialogue: 0,0:21:29.83,0:21:31.99,Default,,0,0,0,,Егер мұндай адам бар болса
Dialogue: 0,0:21:32.74,0:21:35.29,Default,,0,0,0,,Бұл біздің қолымыздан келмейді.
Dialogue: 0,0:21:51.05,0:21:56.06,Default,,0,0,0,,♪～
Dialogue: 0,0:23:11.64,0:23:16.64,Default,,0,0,0,,～♪
Dialogue: 0,0:23:25.15,0:23:26.94,Default,,0,0,0,,Исаму Кондо!
Dialogue: 0,0:23:27.65,0:23:29.44,Default,,0,0,0,,Додзо әлі де жақсы
Dialogue: 0,0:23:29.53,0:23:31.91,Default,,0,0,0,,Мықты адаммен мәміле одан да жақсы.
Dialogue: 0,0:23:32.91,0:23:34.12,Default,,0,0,0,,Шиейкан Эдода ашылды
Dialogue: 0,0:23:34.74,0:23:39.41,Default,,0,0,0,,Ал Мибро үшін мен жолды зерттеуім керек.
Dialogue: 0,0:23:39.50,0:23:43.75,Default,,0,0,0,,Дағдыларыңызды шыңдап, күш-қуатыңызды шыңдап, ақыл-ойыңызды жаттықтырыңыз!
Dialogue: 0,0:23:44.21,0:23:46.13,Default,,0,0,0,,Келесі жолы «Шығу»
Dialogue: 0,0:23:46.21,0:23:48.13,Default,,0,0,0,,Көруге міндетті!
Dialogue: 0,0:23:49.63,0:23:55.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
