Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.10,0:00:26.44,Default,,0,0,0,,(жоғары электронды дыбыс)
Dialogue: 0,0:00:30.98,0:00:34.40,Default,,0,0,0,,(♪ ~Ашық ән)
Dialogue: 0,0:00:51.46,0:00:53.88,Default,,0,0,0,,♪ Мен оны кесіп тастаймын
Dialogue: 0,0:00:53.97,0:00:57.93,Default,,0,0,0,,♪ Сенің ауыртпалығыңның көзі
Dialogue: 0,0:00:58.01,0:01:01.31,Default,,0,0,0,,♪ Мен оны азайтқым келді, сондықтан оны қайталадым.
Dialogue: 0,0:01:01.39,0:01:03.85,Default,,0,0,0,,♪ Жолдар
Dialogue: 0,0:01:03.93,0:01:07.81,Default,,0,0,0,,♪ Мен шамды ұстаймын
Dialogue: 0,0:01:07.90,0:01:11.27,Default,,0,0,0,,♪ Мен сені құтқарғандай болдым.
Dialogue: 0,0:01:11.36,0:01:14.99,Default,,0,0,0,,♪ Сүйіспеншілікті білдіру
Dialogue: 0,0:01:15.07,0:01:17.99,Default,,0,0,0,,♪ Жоқ, бірдеңе бұрмаланған.
Dialogue: 0,0:01:18.07,0:01:20.70,Default,,0,0,0,,♪ Бірдеңе өтірік сияқты
Dialogue: 0,0:01:21.33,0:01:25.25,Default,,0,0,0,,♪ Мен өзім екенімді білемін
Dialogue: 0,0:01:25.33,0:01:26.54,Default,,0,0,0,,♪ Ғашық болу үшін
Dialogue: 0,0:01:26.62,0:01:29.04,Default,,0,0,0,,♪ Мен сені пайдаландым.
Dialogue: 0,0:01:29.13,0:01:29.96,Default,,0,0,0,,♪ Мен сонда болдым
Dialogue: 0,0:01:30.04,0:01:34.92,Default,,0,0,0,,♪ Көкжиектен тыс ештеңе болмаса да
Dialogue: 0,0:01:35.01,0:01:37.30,Default,,0,0,0,,♪ Кеттік, қолымды жіберме
Dialogue: 0,0:01:37.38,0:01:39.84,Default,,0,0,0,,♪ Енді айта аламын ба?
Dialogue: 0,0:01:39.93,0:01:42.22,Default,,0,0,0,,♪ Мен сенің әлсіздігіңмен қоректенемін
Dialogue: 0,0:01:42.31,0:01:44.85,Default,,0,0,0,,♪ Мықты болған қорқақ
Dialogue: 0,0:01:44.93,0:01:47.81,Default,,0,0,0,,♪ Мен саған өзімнің әлсіз жерімді көрсетемін
Dialogue: 0,0:01:47.89,0:01:49.90,Default,,0,0,0,,♪ Барлығы осыдан басталады
Dialogue: 0,0:01:53.44,0:01:56.28,Default,,0,0,0,,♪ Аа, бұл қайдан шыққан.
Dialogue: 0,0:02:05.33,0:02:05.83,Default,,0,0,0,,«Музыка бөлімі»
Dialogue: 0,0:02:05.83,0:02:06.62,Default,,0,0,0,,«Музыка бөлімі»
Dialogue: 0,0:02:05.83,0:02:06.62,Default,,0,0,0,,Сіз қарап отырған деректер
Dialogue: 0,0:02:06.62,0:02:08.12,Default,,0,0,0,,Ал, сіз қарап отырған деректер
Dialogue: 0,0:02:08.21,0:02:12.34,Default,,0,0,0,,Бұл музыка бөлімінің swot талдауы негізінде жасалған жоспар.
Dialogue: 0,0:02:12.42,0:02:15.46,Default,,0,0,0,,Біз мұны осы маусымның бизнес кестесінің негізі ретінде қолданамыз.
Dialogue: 0,0:02:15.55,0:02:18.38,Default,,0,0,0,,Қызыл түсте болған оқиғалар мен жанды қойылымдар
Dialogue: 0,0:02:18.47,0:02:19.05,Default,,0,0,0,,Аутсорсинг…
Dialogue: 0,0:02:19.13,0:02:19.63,Default,,0,0,0,,Келесі!
Dialogue: 0,0:02:19.72,0:02:22.01,Default,,0,0,0,,Біздің баспа бөлімі
Dialogue: 0,0:02:22.10,0:02:23.89,Default,,0,0,0,,Ақпарат құралдарының өзгеруіне байланысты
Dialogue: 0,0:02:23.97,0:02:26.02,Default,,0,0,0,,Біз шығындарды айтарлықтай қысқартқанымызға қарамастан,
Dialogue: 0,0:02:26.77,0:02:28.35,Default,,0,0,0,,Әлі күткен сюжетке жете алмай жатыр...
Dialogue: 0,0:02:28.43,0:02:29.10,Default,,0,0,0,,Келесі!
Dialogue: 0,0:02:29.19,0:02:30.23,Default,,0,0,0,,（）
Dialogue: 0,0:02:29.19,0:02:30.23,Default,,0,0,0,,«Баспа бөлімі»
Dialogue: 0,0:02:30.23,0:02:30.31,Default,,0,0,0,,«Баспа бөлімі»
Dialogue: 0,0:02:30.31,0:02:32.31,Default,,0,0,0,,«Баспа бөлімі»
Dialogue: 0,0:02:30.31,0:02:32.31,Default,,0,0,0,,Иә! А... иә...
Dialogue: 0,0:02:32.31,0:02:32.40,Default,,0,0,0,,Иә! А... иә...
Dialogue: 0,0:02:32.40,0:02:33.31,Default,,0,0,0,,Иә! А... иә...
Dialogue: 0,0:02:32.40,0:02:33.31,Default,,0,0,0,,«Батыр бизнес бөлімі»
Dialogue: 0,0:02:33.31,0:02:33.40,Default,,0,0,0,,«Батыр бизнес бөлімі»
Dialogue: 0,0:02:33.40,0:02:35.36,Default,,0,0,0,,«Батыр бизнес бөлімі»
Dialogue: 0,0:02:33.40,0:02:35.36,Default,,0,0,0,,Батыр бизнес бөлімі
Dialogue: 0,0:02:35.36,0:02:35.44,Default,,0,0,0,,«Батыр бизнес бөлімі»
Dialogue: 0,0:02:35.44,0:02:37.90,Default,,0,0,0,,Ал... ең алдымен.
Dialogue: 0,0:02:38.49,0:02:39.74,Default,,0,0,0,,Қысқа болыңыз
Dialogue: 0,0:02:39.82,0:02:43.32,Default,,0,0,0,,Иә! Біз кірістер мен шығыстар есебіне сәйкеспіз.
Dialogue: 0,0:02:43.41,0:02:45.62,Default,,0,0,0,,Біз профицитті жазуды күтеміз.
Dialogue: 0,0:02:45.70,0:02:49.29,Default,,0,0,0,,Бұл «Hero TV» күшті өнімділігіне байланысты болуы мүмкін
Dialogue: 0,0:02:49.37,0:02:50.54,Default,,0,0,0,,Иә
Dialogue: 0,0:02:50.62,0:02:51.50,Default,,0,0,0,,Тек...
Dialogue: 0,0:02:51.58,0:02:56.38,Default,,0,0,0,,Біздің компаниямен келісім-шартқа отырған екінші бөліктегі екі кейіпкерге қатысты,
Dialogue: 0,0:02:56.46,0:02:58.67,Default,,0,0,0,,Дефицит балансы әлі де сақталады...
Dialogue: 0,0:02:59.80,0:03:01.80,Default,,0,0,0,,Жыл! Ол кім?
Dialogue: 0,0:03:01.89,0:03:03.43,Default,,0,0,0,,Жолдан кет! О, менің! (Өтіп бара жатқан ер адам) Ах!
Dialogue: 0,0:03:06.39,0:03:09.56,Default,,0,0,0,,Жоқ! Маған қашып кетуіме жол берме!
Dialogue: 0,0:03:09.64,0:03:11.94,Default,,0,0,0,,Нува! (Қарақшы) Шопи!
Dialogue: 0,0:03:12.85,0:03:16.40,Default,,0,0,0,,(Sumo Thunder-тің үрейлі дауысы)
Dialogue: 0,0:03:17.48,0:03:18.90,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:03:18.99,0:03:19.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:21.28,0:03:22.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:23.45,0:03:24.37,Default,,0,0,0,,Ой! (жарылған дыбыс)
Dialogue: 0,0:03:24.45,0:03:25.58,Default,,0,0,0,,(Chopman Sumo Thunder үрейленді дауыс)
Dialogue: 0,0:03:25.66,0:03:27.87,Default,,0,0,0,,Келіңіздер! Бұл осылай!
Dialogue: 0,0:03:28.83,0:03:29.95,Default,,0,0,0,,(Екі рет)
Dialogue: 0,0:03:30.62,0:03:31.79,Default,,0,0,0,,(маска ішіндегі тыныс алу дыбыстары)
Dialogue: 0,0:03:31.87,0:03:34.13,Default,,0,0,0,,Сіз мені тоқтата алмайсыз ба?
Dialogue: 0,0:03:37.46,0:03:38.38,Default,,0,0,0,,(ыңылдау)
Dialogue: 0,0:03:38.46,0:03:40.17,Default,,0,0,0,,Сол умен...
Dialogue: 0,0:03:40.26,0:03:41.38,Default,,0,0,0,,Кай...
Dialogue: 0,0:03:41.47,0:03:42.88,Default,,0,0,0,,Бостандық...
Dialogue: 0,0:03:43.38,0:03:45.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:46.76,0:03:48.31,Default,,0,0,0,,Таку… Мықты болыңыз!
Dialogue: 0,0:03:48.39,0:03:49.97,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:03:51.48,0:03:53.27,Default,,0,0,0,,Тег ойыны аяқталуға жақын!
Dialogue: 0,0:03:53.35,0:03:54.65,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:03:54.73,0:03:57.77,Default,,0,0,0,,Олай болса жабайы айқайлайық!
Dialogue: 0,0:04:00.69,0:04:01.99,Default,,0,0,0,,тек Рука-ко лайықты иесін сезгенде ғана шынайы күшін көрсетеді.
Dialogue: 0,0:04:02.86,0:04:03.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:03.61,0:04:05.28,Default,,0,0,0,,Уау, нәтиже жақсы!
Dialogue: 0,0:04:05.37,0:04:06.32,Default,,0,0,0,,Жібер!
Dialogue: 0,0:04:06.41,0:04:08.28,Default,,0,0,0,,Тыныш бол, болды, болды!
Dialogue: 0,0:04:09.91,0:04:10.79,Default,,0,0,0,,Не!
Dialogue: 0,0:04:10.87,0:04:11.96,Default,,0,0,0,,(қарақшының күшті дауысы)
Dialogue: 0,0:04:12.04,0:04:15.42,Default,,0,0,0,,Нууааа! Ооооо!
Dialogue: 0,0:04:16.46,0:04:19.05,Default,,0,0,0,,(үйінділерге соғылған дыбыс)
Dialogue: 0,0:04:20.71,0:04:22.47,Default,,0,0,0,,Бақытты…
Dialogue: 0,0:04:25.97,0:04:27.14,Default,,0,0,0,,(Жабайы жолбарыстың ыңылдауы)
Dialogue: 0,0:04:27.22,0:04:29.31,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұл аянышты.
Dialogue: 0,0:04:29.39,0:04:30.68,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:04:31.27,0:04:32.52,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:04:32.60,0:04:35.52,Default,,0,0,0,,Мен кешігудің орнын толтырамын (бастау дыбысы)
Dialogue: 0,0:04:35.60,0:04:38.56,Default,,0,0,0,,(жоғары ырғақты музыка)
Dialogue: 0,0:04:41.36,0:04:42.61,Default,,0,0,0,,Хаа!
Dialogue: 0,0:04:43.15,0:04:44.32,Default,,0,0,0,,(қарақшының айқайы)
Dialogue: 0,0:04:47.66,0:04:50.24,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:04:50.33,0:04:52.12,Default,,0,0,0,,Барнаби мырза күткендей!
Dialogue: 0,0:04:52.20,0:04:54.37,Default,,0,0,0,,Сіз мұны қайтадан жасадыңыз!
Dialogue: 0,0:04:55.08,0:04:56.75,Default,,0,0,0,,Аа... (Әйелдердің шаттануы)
Dialogue: 0,0:04:56.83,0:04:59.42,Default,,0,0,0,,Әй, Котецу! (2-бала) Котецу көбірек тырысыңыз!
Dialogue: 0,0:05:00.00,0:05:01.96,Default,,0,0,0,,Котецу емес, жабайы жолбарыс!
Dialogue: 0,0:05:02.67,0:05:04.72,Default,,0,0,0,,Ол бұрыннан белгілі, сондықтан жақсы.
Dialogue: 0,0:05:04.80,0:05:07.34,Default,,0,0,0,,Батырлар өздерінің шынайы болмысын ашпайды!
Dialogue: 0,0:05:07.43,0:05:09.14,Default,,0,0,0,,Мұндай саясаттан
Dialogue: 0,0:05:09.22,0:05:12.31,Default,,0,0,0,,Егер біз қылмыскерді қалай қорғауға назар аударсақ ше?
Dialogue: 0,0:05:12.39,0:05:14.14,Default,,0,0,0,,О? (Барлығы) Жақсы, жақсы…
Dialogue: 0,0:05:14.23,0:05:15.81,Default,,0,0,0,,(Музыка бірте-бірте аяқталады)
Dialogue: 0,0:05:14.23,0:05:15.81,Default,,0,0,0,,«Әділет фестивалі»
Dialogue: 0,0:05:15.81,0:05:16.31,Default,,0,0,0,,(Музыка бірте-бірте аяқталады)
Dialogue: 0,0:05:21.27,0:05:23.90,Default,,0,0,0,,Мен драманы кеше көрдім.
Dialogue: 0,0:05:23.99,0:05:27.41,Default,,0,0,0,,Әлсіз батыр қыз, ілініп қалдың.
Dialogue: 0,0:05:27.49,0:05:28.66,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:28.74,0:05:31.08,Default,,0,0,0,,Ол кісі де қарап тұрса жақсы болар еді.
Dialogue: 0,0:05:31.16,0:05:32.49,Default,,0,0,0,,Сақалды адам
Dialogue: 0,0:05:32.58,0:05:33.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:33.62,0:05:35.08,Default,,0,0,0,,Оны жасырудың қажеті жоқ.
Dialogue: 0,0:05:35.16,0:05:37.54,Default,,0,0,0,,Мен де сұлу болуды сағындым.
Dialogue: 0,0:05:37.62,0:05:39.08,Default,,0,0,0,,Оны араластырмаңыз!
Dialogue: 0,0:05:39.17,0:05:40.08,Default,,0,0,0,,Бұл жаман болды!
Dialogue: 0,0:05:40.17,0:05:41.42,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:41.50,0:05:43.13,Default,,0,0,0,,Мұны істеуді доғарыңыз.
Dialogue: 0,0:05:43.21,0:05:44.59,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:44.67,0:05:45.84,Default,,0,0,0,,Неліктен бұлай істедің?
Dialogue: 0,0:05:45.92,0:05:47.84,Default,,0,0,0,,Менің стилім еліктеді
Dialogue: 0,0:05:47.93,0:05:50.35,Default,,0,0,0,,Бұл менің компаниямда қызу тақырыпқа айналды.
Dialogue: 0,0:05:47.93,0:05:50.35,Default,,0,0,0,,«Атақты позаны көшірген рок бизон!»
Dialogue: 0,0:05:50.35,0:05:50.39,Default,,0,0,0,,«Атақты позаны көшірген рок бизон!»
Dialogue: 0,0:05:50.85,0:05:53.51,Default,,0,0,0,,Бұл жай ғана кездейсоқтық па...
Dialogue: 0,0:05:53.60,0:05:55.85,Default,,0,0,0,,Сіз шарасызсыз, бизон мырза.
Dialogue: 0,0:05:55.93,0:05:57.27,Default,,0,0,0,,Жолбарыс мырза екінші бөлікке кетті.
Dialogue: 0,0:05:57.35,0:06:00.27,Default,,0,0,0,,Мен оның көзге көрінбейтін танымал емес екеніне қынжыладым.
Dialogue: 0,0:06:00.36,0:06:02.65,Default,,0,0,0,,Ересек болу қиын.
Dialogue: 0,0:06:02.73,0:06:04.03,Default,,0,0,0,,(Барлығы дем алады)
Dialogue: 0,0:06:04.11,0:06:06.53,Default,,0,0,0,,Бонжур батыры! (көтеретін музыка)
Dialogue: 0,0:06:06.61,0:06:09.41,Default,,0,0,0,,Бастет көшесінде банк тонау болды!
Dialogue: 0,0:06:09.49,0:06:11.12,Default,,0,0,0,,Бүгін де көңіл көтерейік!
Dialogue: 0,0:06:09.49,0:06:11.12,Default,,0,0,0,,«Банк»
Dialogue: 0,0:06:11.12,0:06:11.20,Default,,0,0,0,,«Банк»
Dialogue: 0,0:06:11.20,0:06:11.28,Default,,0,0,0,,«Банк»
Dialogue: 0,0:06:11.20,0:06:11.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:11.28,0:06:12.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:12.16,0:06:13.74,Default,,0,0,0,,Ас болсын!!
Dialogue: 0,0:06:13.83,0:06:16.08,Default,,0,0,0,,О! Көбірек жеп қойыңыз!
Dialogue: 0,0:06:17.29,0:06:20.25,Default,,0,0,0,,Сәлем! Тұздалған қиярларды артта қалдырмаңыз!
Dialogue: 0,0:06:20.33,0:06:22.63,Default,,0,0,0,,Шаршағанға сірке суы... (Барнаби) Өтінемін, мені жайына қалдыр.
Dialogue: 0,0:06:22.71,0:06:23.21,Default,,0,0,0,,Ах! Мен істеп жатырмын! Мен істеп жатырмын!
Dialogue: 0,0:06:23.21,0:06:24.42,Default,,0,0,0,,Ах! Мен істеп жатырмын! Мен істеп жатырмын!
Dialogue: 0,0:06:23.21,0:06:24.42,Default,,0,0,0,,«Бастет көшесіндегі банк қарулы тонау...»
Dialogue: 0,0:06:24.42,0:06:24.50,Default,,0,0,0,,«Бастет көшесіндегі банк қарулы тонау...»
Dialogue: 0,0:06:24.50,0:06:25.92,Default,,0,0,0,,«Бастет көшесіндегі банк қарулы тонау...»
Dialogue: 0,0:06:24.50,0:06:25.92,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:06:25.92,0:06:26.01,Default,,0,0,0,,«Бастет көшесіндегі банк қарулы тонау...»
Dialogue: 0,0:06:26.01,0:06:28.34,Default,,0,0,0,,«Бастет көшесіндегі банк қарулы тонау...»
Dialogue: 0,0:06:26.01,0:06:28.34,Default,,0,0,0,,Батырлар банкке кіріп кетті!
Dialogue: 0,0:06:28.42,0:06:30.89,Default,,0,0,0,,Балалар! Жақсы оқы!
Dialogue: 0,0:06:30.97,0:06:31.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:32.30,0:06:35.43,Default,,0,0,0,,Котецу-сан, аздап оқы.
Dialogue: 0,0:06:35.52,0:06:37.52,Default,,0,0,0,,Қабілеттерді ойланбастан пайдалану
Dialogue: 0,0:06:37.60,0:06:39.89,Default,,0,0,0,,Қылмыскердің қашып кетуіне әрқашан кім мүмкіндік береді?
Dialogue: 0,0:06:39.98,0:06:40.98,Default,,0,0,0,,Оған көмектесу мүмкін емес!
Dialogue: 0,0:06:41.06,0:06:43.02,Default,,0,0,0,,Ол бір минутқа ғана созылады.
Dialogue: 0,0:06:43.11,0:06:44.98,Default,,0,0,0,,Олай болса, оны іске қосу уақыты...
Dialogue: 0,0:06:45.07,0:06:46.32,Default,,0,0,0,,Ал, жақсы...
Dialogue: 0,0:06:46.40,0:06:48.99,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:06:49.78,0:06:51.70,Default,,0,0,0,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,0:06:51.78,0:06:52.95,Default,,0,0,0,,(қарақшының үрейлі дауысы)
Dialogue: 0,0:06:53.03,0:06:53.91,Default,,0,0,0,,(Дауыс жігерлендіреді)
Dialogue: 0,0:06:57.83,0:06:58.96,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:00.62,0:07:02.46,Default,,0,0,0,,Ха! (найзағайдың дыбысы)
Dialogue: 0,0:07:05.04,0:07:05.34,Default,,0,0,0,,«Тікелей эфирдегі кейіпкер теледидар»
Dialogue: 0,0:07:05.34,0:07:06.67,Default,,0,0,0,,«Тікелей эфирдегі кейіпкер теледидар»
Dialogue: 0,0:07:05.34,0:07:06.67,Default,,0,0,0,,Найзағай сияқты!
Dialogue: 0,0:07:06.67,0:07:06.75,Default,,0,0,0,,Найзағай сияқты!
Dialogue: 0,0:07:06.75,0:07:07.05,Default,,0,0,0,,Найзағай сияқты!
Dialogue: 0,0:07:06.75,0:07:07.05,Default,,0,0,0,,«Қылмыскерді қорғаудың өрт эмблемасы плюс 200»
Dialogue: 0,0:07:07.05,0:07:07.13,Default,,0,0,0,,«Қылмыскерді қорғаудың өрт эмблемасы плюс 200»
Dialogue: 0,0:07:07.13,0:07:08.26,Default,,0,0,0,,«Қылмыскерді қорғаудың өрт эмблемасы плюс 200»
Dialogue: 0,0:07:07.13,0:07:08.26,Default,,0,0,0,,3-орынға таласатын екі адам бір уақытта қамтамасыз етіледі!
Dialogue: 0,0:07:08.26,0:07:08.34,Default,,0,0,0,,3-орынға таласатын екі адам бір уақытта қамтамасыз етілді!
Dialogue: 0,0:07:08.34,0:07:09.51,Default,,0,0,0,,3-орынға таласатын екі адам бір уақытта қамтамасыз етіледі!
Dialogue: 0,0:07:08.34,0:07:09.51,Default,,0,0,0,,«Қылмыскерді қорғайтын айдаһар бала плюс 200»
Dialogue: 0,0:07:09.59,0:07:10.88,Default,,0,0,0,,(ауырсыну сияқты)
Dialogue: 0,0:07:10.97,0:07:12.30,Default,,0,0,0,,Сәлем! (әйел айқайлайды)
Dialogue: 0,0:07:12.39,0:07:13.72,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:07:13.80,0:07:14.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:15.72,0:07:18.10,Default,,0,0,0,,Готцуанде... (Қарақшы) Міне, келдің!
Dialogue: 0,0:07:18.18,0:07:19.39,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:07:19.48,0:07:20.23,Default,,0,0,0,,Оригами циклоны
Dialogue: 0,0:07:20.31,0:07:20.69,Default,,0,0,0,,Мимика әдістерімен ұпай жинаңыз!
Dialogue: 0,0:07:20.69,0:07:22.56,Default,,0,0,0,,Мимика әдістерімен ұпай жинаңыз! «Origami Cyclone Criminal Securing Plus 200»
Dialogue: 0,0:07:22.65,0:07:24.73,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:24.81,0:07:25.94,Default,,0,0,0,,Бұлай болса ше!
Dialogue: 0,0:07:28.69,0:07:29.57,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:33.24,0:07:35.99,Default,,0,0,0,,Менің мұзым сәл салқын
Dialogue: 0,0:07:36.49,0:07:39.08,Default,,0,0,0,,Жаман істеріңді толық ұстаңдар!
Dialogue: 0,0:07:39.16,0:07:40.04,Default,,0,0,0,,Шешілді! Көк раушан!
Dialogue: 0,0:07:40.04,0:07:41.91,Default,,0,0,0,,Шешілді! Көк раушан! «Көк раушанның қылмыскері +200 қамтамасыз етілді»
Dialogue: 0,0:07:42.00,0:07:44.29,Default,,0,0,0,,«Көк раушан қылмыскері қорғалды, 200 ұпай жинады!»
Dialogue: 0,0:07:44.38,0:07:47.21,Default,,0,0,0,,Сіз рок бизонын сағындыңыз ба?
Dialogue: 0,0:07:47.30,0:07:49.01,Default,,0,0,0,,Стелс мырза студияда?
Dialogue: 0,0:07:49.09,0:07:50.09,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:07:50.88,0:07:54.34,Default,,0,0,0,,Соңғы кездері ол кейіпкерінің бағытын анықтауға тырысатын сияқты.
Dialogue: 0,0:07:54.43,0:07:55.85,Default,,0,0,0,,(адамдар күледі)
Dialogue: 0,0:07:55.93,0:07:57.76,Default,,0,0,0,,Ол... (қатты жарылыс)
Dialogue: 0,0:07:59.22,0:07:59.85,Default,,0,0,0,,Ах! Бұл қиын!
Dialogue: 0,0:07:59.85,0:08:01.68,Default,,0,0,0,,Ах! Бұл қиын! «Банк ғимаратының сыртында жарылыс болды»
Dialogue: 0,0:08:01.68,0:08:01.77,Default,,0,0,0,,«Банк ғимаратының сыртында жарылыс болды»
Dialogue: 0,0:08:01.77,0:08:03.81,Default,,0,0,0,,«Банк ғимаратының сыртында жарылыс болды» Қарақшылар банкті жарып жіберді!
Dialogue: 0,0:08:03.81,0:08:03.90,Default,,0,0,0,,«Банк ғимаратының сыртында жарылыс болды»
Dialogue: 0,0:08:03.90,0:08:05.94,Default,,0,0,0,,«Банк ғимаратының сыртында жарылыс болды» Олар қашуға тырысқан сияқты!
Dialogue: 0,0:08:06.94,0:08:08.32,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін!
Dialogue: 0,0:08:09.73,0:08:12.49,Default,,0,0,0,,Биік аспан!
Dialogue: 0,0:08:17.28,0:08:19.45,Default,,0,0,0,,(қарақшының айқайы)
Dialogue: 0,0:08:21.75,0:08:24.00,Default,,0,0,0,,Батырлар патшасы күткендей!
Dialogue: 0,0:08:24.08,0:08:24.79,Default,,0,0,0,,Чемпионның қадір-қасиетін көрсету!
Dialogue: 0,0:08:24.79,0:08:25.79,Default,,0,0,0,,Чемпионның қадір-қасиетін көрсету! «Биік аспан: екі қылмыскер қорғалды»
Dialogue: 0,0:08:25.79,0:08:26.63,Default,,0,0,0,,Чемпионның қадір-қасиетін көрсету!
Dialogue: 0,0:08:27.50,0:08:29.63,Default,,0,0,0,,Күткендей, бірінші бөлім керемет.
Dialogue: 0,0:08:30.21,0:08:31.63,Default,,0,0,0,,Әртүрлі шкалалар
Dialogue: 0,0:08:31.71,0:08:33.30,Default,,0,0,0,,Жарты жыл қалды...
Dialogue: 0,0:08:33.38,0:08:35.68,Default,,0,0,0,,Біз одан да қатал болуымыз керек.
Dialogue: 0,0:08:35.76,0:08:37.76,Default,,0,0,0,,Уақытты жақсы өткізу жақсы.
Dialogue: 0,0:08:37.85,0:08:41.35,Default,,0,0,0,,Сіз қалай тырыссаңыз да, келесі маусымға дейін қатыса алмайсыз.
Dialogue: 0,0:08:41.43,0:08:44.02,Default,,0,0,0,,Сондай-ақ, менің бірінші дивизионға көтерілетінімді растауым бар...
Dialogue: 0,0:08:44.60,0:08:46.40,Default,,0,0,0,,Сіздің практикалық сезіміңіз күннен-күнге күңгірттене береді.
Dialogue: 0,0:08:47.48,0:08:48.94,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:08:49.02,0:08:51.40,Default,,0,0,0,,Егер сіз азаматтарды қорғай алсаңыз, 1 немесе 2 бөлім
Dialogue: 0,0:08:53.07,0:08:55.45,Default,,0,0,0,,Сіз көңіліңізден шықпайсыз ба? 2-бөлім
Dialogue: 0,0:08:56.36,0:08:56.95,Default,,0,0,0,,(Станция ішіндегі жүйелік дыбыс)
Dialogue: 0,0:08:57.03,0:08:58.45,Default,,0,0,0,,Бұл ыңғайсыз деп ойламайсыз ба?
Dialogue: 0,0:08:58.95,0:09:02.66,Default,,0,0,0,,Ешбір іске араласа алмаймын.
Dialogue: 0,0:09:02.75,0:09:04.41,Default,,0,0,0,,Оның үстіне... екінші бөлімнің ақысы бар...
Dialogue: 0,0:09:05.71,0:09:06.79,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:09:08.75,0:09:10.67,Default,,0,0,0,,Уа... иә, сәлем!
Dialogue: 0,0:09:11.38,0:09:12.80,Default,,0,0,0,,Сіз Барнабисіз бе?
Dialogue: 0,0:09:13.42,0:09:14.55,Default,,0,0,0,,Бұл сәл тым серпінді.
Dialogue: 0,0:09:14.63,0:09:15.88,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:09:15.97,0:09:17.05,Default,,0,0,0,,Сен…
Dialogue: 0,0:09:17.13,0:09:20.01,Default,,0,0,0,,Жолбарыс па? Ол раконға ұқсайды.
Dialogue: 0,0:09:20.56,0:09:21.14,Default,,0,0,0,,(Котецудың ащы күлкісі)
Dialogue: 0,0:09:21.22,0:09:23.14,Default,,0,0,0,,Марк Шнайдер
Dialogue: 0,0:09:23.22,0:09:24.56,Default,,0,0,0,,Жаңа иесі ретінде
Dialogue: 0,0:09:24.64,0:09:26.98,Default,,0,0,0,,Банкроттықтың алдында тұрған кәсіпорынымызды қайта құру.
Dialogue: 0,0:09:27.06,0:09:29.15,Default,,0,0,0,,Оны сатып алып, маған берді.
Dialogue: 0,0:09:29.23,0:09:30.52,Default,,0,0,0,,Солай ма!
Dialogue: 0,0:09:30.61,0:09:32.07,Default,,0,0,0,,Маверик оқиғасынан кейін
Dialogue: 0,0:09:32.15,0:09:35.53,Default,,0,0,0,,Керісінше, Аполлонды бизнес мүмкіндігі ретінде қарастырыңыз.
Dialogue: 0,0:09:35.61,0:09:37.11,Default,,0,0,0,,Біраздан бері қауесеттер болды.
Dialogue: 0,0:09:37.20,0:09:39.45,Default,,0,0,0,,Гаргойл Техниканы жас кезінде ояту
Dialogue: 0,0:09:40.07,0:09:42.87,Default,,0,0,0,,Әлемдік деңгейдегі IT-империяға айналды
Dialogue: 0,0:09:42.95,0:09:44.54,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:09:44.62,0:09:47.04,Default,,0,0,0,,Осы уақытқа дейін сатып алынған барлық компаниялар
Dialogue: 0,0:09:47.12,0:09:49.54,Default,,0,0,0,,Ол әдемі қайта салынған.
Dialogue: 0,0:09:49.63,0:09:50.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:51.00,0:09:53.13,Default,,0,0,0,,Сонымен... неге біз бүгін?
Dialogue: 0,0:09:53.21,0:09:56.55,Default,,0,0,0,,Негізі, сендер маған қалай қарайсыңдар деп алаңдаймын.
Dialogue: 0,0:09:56.63,0:09:59.76,Default,,0,0,0,,Өйткені... бұл тапшылықты арттырып жатыр.
Dialogue: 0,0:09:59.84,0:10:01.76,Default,,0,0,0,,Мен жұмыстан шығуды ойладым, бірақ...
Dialogue: 0,0:10:01.85,0:10:02.68,Default,,0,0,0,,А...
Dialogue: 0,0:10:02.76,0:10:04.85,Default,,0,0,0,,Кері оймен
Dialogue: 0,0:10:04.93,0:10:06.85,Default,,0,0,0,,Мен оны 1-ші бөлімге көшіремін! (крекер дыбысы)
Dialogue: 0,0:10:06.93,0:10:07.94,Default,,0,0,0,,О? (Барнаби) Иә?
Dialogue: 0,0:10:08.02,0:10:09.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:09.56,0:10:11.11,Default,,0,0,0,,Реакция баяу емес пе?
Dialogue: 0,0:10:11.19,0:10:13.94,Default,,0,0,0,,Бұл ертең 1-бөлімге қайта оралатыныңызды білдіре ме?
Dialogue: 0,0:10:14.03,0:10:15.36,Default,,0,0,0,,А... жоқ, бірақ...
Dialogue: 0,0:10:15.44,0:10:18.61,Default,,0,0,0,,Бірінші дивизионға маусымның ортасында да қатыса аласыз.
Dialogue: 0,0:10:18.70,0:10:21.07,Default,,0,0,0,,Сен мені құшақтайсың.
Dialogue: 0,0:10:21.16,0:10:22.70,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:10:22.78,0:10:24.79,Default,,0,0,0,,Қалай болғанда да, құттықтаймыз!
Dialogue: 0,0:10:24.87,0:10:26.50,Default,,0,0,0,,О! рақмет сізге!
Dialogue: 0,0:10:26.58,0:10:27.96,Default,,0,0,0,,Жарайсың банни!
Dialogue: 0,0:10:28.04,0:10:29.37,Default,,0,0,0,,Сонымен шарттар туралы не деуге болады?
Dialogue: 0,0:10:29.46,0:10:32.54,Default,,0,0,0,,Бәрі де болады! Сіз мұны 1 бөлімде жасай аласыз.
Dialogue: 0,0:10:32.63,0:10:34.55,Default,,0,0,0,,Бірақ... (Шнайдер) Уайымдама.
Dialogue: 0,0:10:34.63,0:10:35.92,Default,,0,0,0,,Вирджил!
Dialogue: 0,0:10:36.01,0:10:37.67,Default,,0,0,0,,Сіз өзіңізге ұнайтын кез келген соманы жаза аласыз.
Dialogue: 0,0:10:37.76,0:10:38.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:38.63,0:10:40.80,Default,,0,0,0,,Мен оны осылай бағалаймын.
Dialogue: 0,0:10:40.89,0:10:42.93,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:43.55,0:10:44.56,Default,,0,0,0,,Айтпақшы, сіз...
Dialogue: 0,0:10:45.14,0:10:46.43,Default,,0,0,0,,Оның батырлық тарихы ұзақ?
Dialogue: 0,0:10:46.52,0:10:47.43,Default,,0,0,0,,А... жақсы...
Dialogue: 0,0:10:47.52,0:10:49.81,Default,,0,0,0,,Осыдан кейін тыңдауға рұқсат етіңіз.
Dialogue: 0,0:10:49.89,0:10:51.31,Default,,0,0,0,,"сол күшті басқа біреуге береді, ол да оны дамытады, және т.б.…"
Dialogue: 0,0:10:51.40,0:10:52.52,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:10:52.61,0:10:54.73,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:10:55.23,0:10:59.65,Default,,0,0,0,,Иә? Бұл қорқынышты (қорқынышты айқай)
Dialogue: 0,0:11:00.95,0:11:04.20,Default,,0,0,0,,(қорқынышты айқай)
Dialogue: 0,0:11:04.28,0:11:05.83,Default,,0,0,0,,Шыу!
Dialogue: 0,0:11:05.91,0:11:06.74,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:11:06.83,0:11:09.91,Default,,0,0,0,,«Күн – тіршілік көзі»
Dialogue: 0,0:11:10.00,0:11:12.71,Default,,0,0,0,,«Бұл орындалу және еркіндік сәтін қамтамасыз етеді».
Dialogue: 0,0:11:13.50,0:11:18.51,Default,,0,0,0,,«Иә, екі феникс менің көз алдымда билей бергенше».
Dialogue: 0,0:11:19.17,0:11:20.09,Default,,0,0,0,,Сіз қалай ойлайсыз? әке
Dialogue: 0,0:11:20.17,0:11:22.80,Default,,0,0,0,,Хмм... тамаша өлең екен.
Dialogue: 0,0:11:22.89,0:11:24.80,Default,,0,0,0,,Әке, мен жылай бастадым. (Кэде) Иә?
Dialogue: 0,0:11:24.89,0:11:27.81,Default,,0,0,0,,Қайда? Бұл жұмбақ! Бұл жұмбақ! (Котецу) Иә?
Dialogue: 0,0:11:27.89,0:11:30.52,Default,,0,0,0,,Бұл мұғалімнің сүйікті өлеңі!
Dialogue: 0,0:11:30.60,0:11:32.56,Default,,0,0,0,,Бірақ мен оны мүлдем түсінбеймін.
Dialogue: 0,0:11:32.65,0:11:34.36,Default,,0,0,0,,Бұл сөзсіз жұмбақ.
Dialogue: 0,0:11:34.44,0:11:36.90,Default,,0,0,0,,Иә? Сіз айттыңыз, бұл сізді жылатты!
Dialogue: 0,0:11:36.98,0:11:38.78,Default,,0,0,0,,Мәтінге реакция жасадыңыз ба?
Dialogue: 0,0:11:38.86,0:11:40.40,Default,,0,0,0,,Жоқ, жоқ, жоқ... жоқ!
Dialogue: 0,0:11:40.49,0:11:43.20,Default,,0,0,0,,Дәлірек айтсақ, күн туралы өлең жаз.
Dialogue: 0,0:11:43.28,0:11:45.07,Default,,0,0,0,,Күрделі үй тапсырмасы болады.
Dialogue: 0,0:11:45.16,0:11:48.04,Default,,0,0,0,,Бастауыш сынып оқушыларына қиын.
Dialogue: 0,0:11:48.12,0:11:49.20,Default,,0,0,0,,-де? Бұл туралы ше?
Dialogue: 0,0:11:49.79,0:11:51.41,Default,,0,0,0,,Барнабимен жақсы араласасыз ба?
Dialogue: 0,0:11:51.91,0:11:54.08,Default,,0,0,0,,О! Іс жақсы жүріп жатыр!
Dialogue: 0,0:11:54.79,0:11:57.29,Default,,0,0,0,,(Көңілсіз фортепиано музыкасы)
Dialogue: 0,0:11:59.21,0:12:01.34,Default,,0,0,0,,(Сөйлесіп жатқан адамдардың дауыстары)
Dialogue: 0,0:12:01.84,0:12:05.93,Default,,0,0,0,,Ах! Бұл бір шыныаяқ үшін 30 доллар, бәрі ...
Dialogue: 0,0:12:06.01,0:12:07.64,Default,,0,0,0,,Сәлем! Телефонда!
Dialogue: 0,0:12:07.72,0:12:09.47,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:12:09.56,0:12:10.81,Default,,0,0,0,,Сәлеметсіз бе? мыс?
Dialogue: 0,0:12:10.89,0:12:12.98,Default,,0,0,0,,Үйге бара алмаймын деп ойлаймын.
Dialogue: 0,0:12:13.06,0:12:16.94,Default,,0,0,0,,Біз Некояшикидегі мысықтың бес нәрестені дүниеге әкелгені туралы тағы бір оқиға туралы хабарламақпыз...
Dialogue: 0,0:12:17.02,0:12:20.28,Default,,0,0,0,,Осындай жүрекке жылы тиетін жергілікті жаңалықтарды жай қалдырыңыз!
Dialogue: 0,0:12:20.36,0:12:22.03,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:12:22.11,0:12:24.70,Default,,0,0,0,,Персоналды қысқартудың әртүрлі салдары бар...
Dialogue: 0,0:12:24.78,0:12:26.20,Default,,0,0,0,,Ах... (Мэри) А, Агнес!
Dialogue: 0,0:12:26.28,0:12:27.20,Default,,0,0,0,,Жетеді! (Телефонның өшіп тұрған дыбысы)
Dialogue: 0,0:12:27.28,0:12:28.83,Default,,0,0,0,,(музыка аяқталады)
Dialogue: 0,0:12:28.91,0:12:30.75,Default,,0,0,0,,Бұдан былай Apollo Media
Dialogue: 0,0:12:30.83,0:12:33.21,Default,,0,0,0,,Біз Combi Hero-ны жаңғыртуға арналған баспасөз хабарламасын бастаймыз.
Dialogue: 0,0:12:33.21,0:12:34.75,Default,,0,0,0,,Біз Combi Hero-ны жаңғыртуға арналған баспасөз хабарламасын бастаймыз.
Dialogue: 0,0:12:33.21,0:12:34.75,Default,,0,0,0,,«Аполлон Медиа»
Dialogue: 0,0:12:34.75,0:12:34.83,Default,,0,0,0,,«Аполлон Медиа»
Dialogue: 0,0:12:34.83,0:12:36.54,Default,,0,0,0,,«Аполломедия»
Dialogue: 0,0:12:34.83,0:12:36.54,Default,,0,0,0,,Алдымен мына адамды таныстырып өтейін! (Экран жүйесінің дыбысы)
Dialogue: 0,0:12:36.54,0:12:37.79,Default,,0,0,0,,Алдымен мына адамды таныстырып өтейін! (экран жүйесінің дыбысы)
Dialogue: 0,0:12:37.88,0:12:39.17,Default,,0,0,0,,Жаңа иесі Марк Шнайдер
Dialogue: 0,0:12:39.17,0:12:40.84,Default,,0,0,0,,Жаңа иесі Марк Шнайдер
Dialogue: 0,0:12:39.17,0:12:40.84,Default,,0,0,0,,«Марк Шнайдер Президент»
Dialogue: 0,0:12:40.84,0:12:41.38,Default,,0,0,0,,«Марк Шнайдер Президент»
Dialogue: 0,0:12:41.38,0:12:42.09,Default,,0,0,0,,«Марк Шнайдер Президент»
Dialogue: 0,0:12:41.38,0:12:42.09,Default,,0,0,0,,(аудитория шуы)
Dialogue: 0,0:12:42.09,0:12:43.26,Default,,0,0,0,,(аудитория шуы)
Dialogue: 0,0:12:43.34,0:12:46.47,Default,,0,0,0,,Сәлеметсіз бе! Барлығына жақсы!
Dialogue: 0,0:12:46.55,0:12:49.18,Default,,0,0,0,,Сонда біз қайтадан бірге жұмыс істей аламыз ба?
Dialogue: 0,0:12:49.26,0:12:50.26,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:12:50.35,0:12:51.64,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:51.72,0:12:53.77,Default,,0,0,0,,Барыңды істе, Котецу-кун!
Dialogue: 0,0:12:53.85,0:12:55.39,Default,,0,0,0,,Үлкендерге дөрекі болма.
Dialogue: 0,0:12:55.48,0:12:57.98,Default,,0,0,0,,Сізге қоңырау шалуым керек пе?
Dialogue: 0,0:12:58.06,0:12:59.86,Default,,0,0,0,,ше? неге мен
Dialogue: 0,0:12:59.94,0:13:00.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:00.86,0:13:04.28,Default,,0,0,0,,Олай болса, оны тамашалау үшін арнайы орындық алайық.
Dialogue: 0,0:13:04.36,0:13:05.99,Default,,0,0,0,,Уау! (Барлығының қатты дауыстары)
Dialogue: 0,0:13:06.07,0:13:08.37,Default,,0,0,0,,Оны үрлемеңіз. Сөйлеу
Dialogue: 0,0:13:08.45,0:13:09.41,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:13:09.49,0:13:12.75,Default,,0,0,0,,Ой! Мұның бәрі менің әңгімем үшін.
Dialogue: 0,0:13:12.83,0:13:16.04,Default,,0,0,0,,Кейіпкеріміз бірден көрінсін.
Dialogue: 0,0:13:16.12,0:13:18.17,Default,,0,0,0,,Біріншісі сол жігіт!
Dialogue: 0,0:13:19.08,0:13:20.84,Default,,0,0,0,,Ата-анасы жас кезінде өлтірілген.
Dialogue: 0,0:13:20.92,0:13:24.76,Default,,0,0,0,,Кек үшін қаһарманға айналған қасіретті сұлу адам
Dialogue: 0,0:13:24.84,0:13:27.97,Default,,0,0,0,,Осы қаланы дүр сілкіндірген маңызды оқиға: Джейктің көтерілісін шешу.
Dialogue: 0,0:13:28.05,0:13:29.01,Default,,0,0,0,,«Оуроборос» жұмбақ ұйымын қадағалау кезінде
Dialogue: 0,0:13:29.01,0:13:30.76,Default,,0,0,0,,«Оуроборос» жұмбақ ұйымын қадағалау кезінде
Dialogue: 0,0:13:29.01,0:13:30.76,Default,,0,0,0,,«Оуроборос»
Dialogue: 0,0:13:30.85,0:13:32.81,Default,,0,0,0,,Ата-ананың жауына жету
Dialogue: 0,0:13:32.89,0:13:36.10,Default,,0,0,0,,Кек алған супер қаһарман!
Dialogue: 0,0:13:36.19,0:13:36.94,Default,,0,0,0,,Кіші Барнаби Брукс!
Dialogue: 0,0:13:36.94,0:13:38.98,Default,,0,0,0,,Кіші Барнаби Брукс!
Dialogue: 0,0:13:36.94,0:13:38.98,Default,,0,0,0,,«Кіші Барнаби Брукс»
Dialogue: 0,0:13:38.98,0:13:40.36,Default,,0,0,0,,Кіші Барнаби Брукс!
Dialogue: 0,0:13:40.94,0:13:42.57,Default,,0,0,0,,Алдымен барайық (Котецу)!
Dialogue: 0,0:13:43.86,0:13:47.20,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:13:49.28,0:13:50.12,Default,,0,0,0,,мен зұлымдарды әділ сотқа тартуға тырысар ма едім?
Dialogue: 0,0:13:50.20,0:13:52.45,Default,,0,0,0,,Әрі қарай Барнаби-кунмен топтасыңыз.
Dialogue: 0,0:13:52.54,0:13:54.58,Default,,0,0,0,,Мен сендерді батырлармен таныстырып өтейін.
Dialogue: 0,0:13:54.66,0:13:56.25,Default,,0,0,0,,Батырдың тәжірибесі де тамаша
Dialogue: 0,0:13:56.33,0:13:58.58,Default,,0,0,0,,Біз әртүрлі істерді шештік...
Dialogue: 0,0:13:58.67,0:14:00.42,Default,,0,0,0,,Бұл адам!
Dialogue: 0,0:14:00.50,0:14:02.29,Default,,0,0,0,,Онда Жолбарыс-сан бар ма?
Dialogue: 0,0:14:02.38,0:14:03.92,Default,,0,0,0,,Керемет орындау!
Dialogue: 0,0:14:04.00,0:14:07.17,Default,,0,0,0,,Шық, суперқаһарман!
Dialogue: 0,0:14:07.26,0:14:08.34,Default,,0,0,0,,(шарлардың жарылған дыбысы)
Dialogue: 0,0:14:08.84,0:14:12.76,Default,,0,0,0,,Алтын Райан!
Dialogue: 0,0:14:13.85,0:14:16.02,Default,,0,0,0,,(Барлығы дем алады)
Dialogue: 0,0:14:16.60,0:14:17.89,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:17.98,0:14:20.06,Default,,0,0,0,,(Көрермендердің шатастырылған дауыстары)
Dialogue: 0,0:14:21.56,0:14:24.65,Default,,0,0,0,,Бұл не? Мен шықтым және жасадым.
Dialogue: 0,0:14:24.73,0:14:25.90,Default,,0,0,0,,Қараңдар, назар аударыңдар!
Dialogue: 0,0:14:26.86,0:14:29.15,Default,,0,0,0,,(механикалық дыбысты түрлендіру)
Dialogue: 0,0:14:29.24,0:14:30.53,Default,,0,0,0,,(Күшті музыка)
Dialogue: 0,0:14:30.61,0:14:32.78,Default,,0,0,0,,Доддон!
Dialogue: 0,0:14:32.87,0:14:33.83,Default,,0,0,0,,(әйнек сынған дыбыс)
Dialogue: 0,0:14:35.41,0:14:39.12,Default,,0,0,0,,Қараңыз! Бұл... кезбе гравитация князі.
Dialogue: 0,0:14:39.21,0:14:40.54,Default,,0,0,0,,Алтын Райан…
Dialogue: 0,0:14:42.29,0:14:45.25,Default,,0,0,0,,Дүние менің аяғыма тағзым етеді
Dialogue: 0,0:14:45.34,0:14:46.21,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:14:47.80,0:14:49.55,Default,,0,0,0,,Ауырлық күшін күшейту
Dialogue: 0,0:14:49.63,0:14:51.93,Default,,0,0,0,,Белгілі бір аралықта қозғалысты тоқтату мүмкіндігі.
Dialogue: 0,0:14:52.01,0:14:53.72,Default,,0,0,0,,Бұл пайдалы болуы керек.
Dialogue: 0,0:14:53.80,0:14:57.77,Default,,0,0,0,,Континенттік аймақта белсенділік танытқан батыр.
Dialogue: 0,0:14:57.85,0:14:59.48,Default,,0,0,0,,Қожайын мені барлап шықты.
Dialogue: 0,0:15:00.06,0:15:01.19,Default,,0,0,0,,Эй, Котецу ше?
Dialogue: 0,0:15:01.27,0:15:03.23,Default,,0,0,0,,Жолбарыстың да қайтып келуі керек емес пе еді?
Dialogue: 0,0:15:03.31,0:15:05.73,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:15:05.82,0:15:08.40,Default,,0,0,0,,(Тыныс алу дауысы)
Dialogue: 0,0:15:10.20,0:15:12.57,Default,,0,0,0,,Менің етігімнен сүй
Dialogue: 0,0:15:15.16,0:15:16.58,Default,,0,0,0,,«Алтын Райан келесі күшті пайдаланады»
Dialogue: 0,0:15:18.16,0:15:19.37,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:15:19.46,0:15:23.71,Default,,0,0,0,,Барнабимен бірігіп жатқан кейіпкер сізге қарағанда болашағы зор.
Dialogue: 0,0:15:23.79,0:15:25.71,Default,,0,0,0,,Бірақ... онда, сөйлесейік!
Dialogue: 0,0:15:25.79,0:15:28.84,Default,,0,0,0,,Екеуіңді қайтарамын деп қашан айттым?
Dialogue: 0,0:15:29.51,0:15:32.22,Default,,0,0,0,,Бізге құлдырай бастаған адамдар керек емес.
Dialogue: 0,0:15:33.14,0:15:34.35,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:15:34.43,0:15:36.26,Default,,0,0,0,,Бүгін мен Барнабидің өзін жақсы сезінгенін қалаймын⸺
Dialogue: 0,0:15:36.35,0:15:39.27,Default,,0,0,0,,Оған қол қою үшін келіңіз.
Dialogue: 0,0:15:40.02,0:15:41.52,Default,,0,0,0,,Жексұрын нәрселер
Dialogue: 0,0:15:41.60,0:15:43.98,Default,,0,0,0,,Мен де жеуге тырыстым.
Dialogue: 0,0:15:44.06,0:15:45.40,Default,,0,0,0,,Котецу оны тоқтатты.
Dialogue: 0,0:15:45.48,0:15:47.27,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:47.36,0:15:48.48,Default,,0,0,0,,Баршаңыз!
Dialogue: 0,0:15:48.57,0:15:52.36,Default,,0,0,0,,Райан мен Барнабидің табысын күтіңіздер!
Dialogue: 0,0:15:52.45,0:15:54.20,Default,,0,0,0,,Сен мені алдадың.
Dialogue: 0,0:15:54.28,0:15:57.24,Default,,0,0,0,,Иә? Сіз келісімшартқа қол қойдыңыз, солай ма?
Dialogue: 0,0:15:57.33,0:15:57.95,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:15:58.04,0:16:00.37,Default,,0,0,0,,Серіктестерді өзгерту туралы...
Dialogue: 0,0:16:00.45,0:16:02.41,Default,,0,0,0,,Әй, сен мені не деп әзілдейсің?
Dialogue: 0,0:16:02.50,0:16:05.08,Default,,0,0,0,,Бұл жақсы... Жаман әңгіме емес, солай ма?
Dialogue: 0,0:16:05.17,0:16:06.84,Default,,0,0,0,,Сіз үндемеуіңіз керек
Dialogue: 0,0:16:06.92,0:16:08.17,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:08.25,0:16:09.46,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:16:09.55,0:16:11.88,Default,,0,0,0,,Әңгіме әлі біткен жоқ... (Котецу) Оны сонда қалдыр!
Dialogue: 0,0:16:12.38,0:16:13.34,Default,,0,0,0,,Котецу мырза!
Dialogue: 0,0:16:13.43,0:16:14.97,Default,,0,0,0,,Бұл қауесет пе?
Dialogue: 0,0:16:15.59,0:16:17.93,Default,,0,0,0,,Өйткені, сіз көпшіліктің назарындасыз...
Dialogue: 0,0:16:18.01,0:16:19.47,Default,,0,0,0,,Керемет болды
Dialogue: 0,0:16:20.18,0:16:21.02,Default,,0,0,0,,(иіскеу)
Dialogue: 0,0:16:25.06,0:16:27.23,Default,,0,0,0,,Келісесіз бе, Котецу-сан?
Dialogue: 0,0:16:27.31,0:16:29.02,Default,,0,0,0,,О, бұл дұрыс болды.
Dialogue: 0,0:16:30.23,0:16:32.78,Default,,0,0,0,,Сіз 2-бөлім боласыз, өйткені мен сияқты адаммен бірігетін боласыз.
Dialogue: 0,0:16:33.65,0:16:36.62,Default,,0,0,0,,Мен енді кедергі болғым келмейді.
Dialogue: 0,0:16:36.70,0:16:37.91,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:16:38.41,0:16:40.54,Default,,0,0,0,,Жарайды, ол үшін уайымдама.
Dialogue: 0,0:16:41.04,0:16:42.71,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:43.21,0:16:45.67,Default,,0,0,0,,Мен өзім туралы ғана білемін
Dialogue: 0,0:16:45.75,0:16:47.63,Default,,0,0,0,,Бірақ мен Котецу-санмен біргемін!
Dialogue: 0,0:16:48.54,0:16:50.55,Default,,0,0,0,,Шынымды айтсам, екінші бөлім ыңғайлырақ.
Dialogue: 0,0:16:51.30,0:16:53.01,Default,,0,0,0,,Уақыт икемді тарақ
Dialogue: 0,0:16:53.09,0:16:55.05,Default,,0,0,0,,Мен де Каэдемен уақыт өткізе аламын.
Dialogue: 0,0:16:55.13,0:16:58.30,Default,,0,0,0,,Маған екінші бөлім сәйкес келеді.
Dialogue: 0,0:16:58.93,0:17:00.76,Default,,0,0,0,,Сіз байсалдысыз ба? ол
Dialogue: 0,0:17:00.85,0:17:01.93,Default,,0,0,0,,О
Dialogue: 0,0:17:02.02,0:17:03.27,Default,,0,0,0,,Бұл оның көлемі болды ма?
Dialogue: 0,0:17:03.85,0:17:05.89,Default,,0,0,0,,Батырларыңыз туралы не ойлайсыз?
Dialogue: 0,0:17:07.77,0:17:10.19,Default,,0,0,0,,Екінші бөлім батыр емес дейсіз бе?
Dialogue: 0,0:17:12.11,0:17:13.61,Default,,0,0,0,,Ақша ғой...
Dialogue: 0,0:17:14.70,0:17:16.78,Default,,0,0,0,,Бірінші бөлік үшін төлем әртүрлі.
Dialogue: 0,0:17:16.86,0:17:17.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:18.20,0:17:19.82,Default,,0,0,0,,Мен сені кінәламаймын.
Dialogue: 0,0:17:20.32,0:17:22.95,Default,,0,0,0,,Бұл жай... сенің ойың менен басқаша.
Dialogue: 0,0:17:23.04,0:17:24.46,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:24.54,0:17:26.96,Default,,0,0,0,,Басқа жолды таңдайтын кез келді
Dialogue: 0,0:17:27.04,0:17:28.46,Default,,0,0,0,,Жаман емес, солай ма?
Dialogue: 0,0:17:30.96,0:17:32.25,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:17:32.34,0:17:33.84,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:17:40.05,0:17:41.68,Default,,0,0,0,,(Батыр теледидардың ашылу әні)
Dialogue: 0,0:17:41.68,0:17:43.31,Default,,0,0,0,,(Батыр теледидардың ашылу әні)
Dialogue: 0,0:17:41.68,0:17:43.31,Default,,0,0,0,,...
Dialogue: 0,0:17:43.31,0:17:44.14,Default,,0,0,0,,...
Dialogue: 0,0:17:46.10,0:17:47.23,Default,,0,0,0,,Төтенше жағдай орын алды!
Dialogue: 0,0:17:47.31,0:17:48.06,Default,,0,0,0,,Аметист мұнарасында жарықшақ бар сияқты!
Dialogue: 0,0:17:48.06,0:17:49.61,Default,,0,0,0,,Аметист мұнарасында жарықшақ бар сияқты! «Шұғыл жаңалық!»
Dialogue: 0,0:17:49.61,0:17:49.69,Default,,0,0,0,,«Шұғыл жаңалықтар!»
Dialogue: 0,0:17:49.69,0:17:49.94,Default,,0,0,0,,«Шұғыл жаңалықтар!» Оның себебі әлі белгісіз. Ол кез келген сәтте құлау қаупі бар!
Dialogue: 0,0:17:49.94,0:17:52.86,Default,,0,0,0,,Себеп әлі белгісіз. Ол кез келген сәтте құлау қаупі бар!
Dialogue: 0,0:17:52.94,0:17:55.53,Default,,0,0,0,,Батырдың тезірек келуін күту. «Аметист мұнарасына қауіп төніп тұр...»
Dialogue: 0,0:17:55.61,0:17:59.03,Default,,0,0,0,,Нухо! Жарқыраған жақсы! Бұл апат!
Dialogue: 0,0:17:59.11,0:18:01.53,Default,,0,0,0,,Олар дебюттік матчтан бері сәттілікке ие болды!
Dialogue: 0,0:18:08.75,0:18:10.08,Default,,0,0,0,,Мен неге мұндамын?
Dialogue: 0,0:18:10.17,0:18:11.63,Default,,0,0,0,,Бұл сізге сәйкес келеді.
Dialogue: 0,0:18:15.13,0:18:16.47,Default,,0,0,0,,Дайын!
Dialogue: 0,0:18:16.55,0:18:18.13,Default,,0,0,0,,(қозғалтқышты іске қосу дыбысы)
Dialogue: 0,0:18:18.22,0:18:19.09,Default,,0,0,0,,Біз сонда барамыз ба?
Dialogue: 0,0:18:19.68,0:18:20.59,Default,,0,0,0,,Шағымдарыңыз бар ма?
Dialogue: 0,0:18:20.68,0:18:23.06,Default,,0,0,0,,Жоқ, мен бұл дұрыс деп ойладым.
Dialogue: 0,0:18:23.89,0:18:26.06,Default,,0,0,0,,Ах... Оңай.
Dialogue: 0,0:18:26.56,0:18:28.23,Default,,0,0,0,,Тезірек жүр, Джуниор-кун!
Dialogue: 0,0:18:28.85,0:18:30.10,Default,,0,0,0,,Егер қателеспесем...
Dialogue: 0,0:18:30.73,0:18:33.11,Default,,0,0,0,,Сіз мені қазір кіші деп атайсыз ба?
Dialogue: 0,0:18:33.19,0:18:35.69,Default,,0,0,0,,(қорқынышты айқай)
Dialogue: 0,0:18:36.65,0:18:38.49,Default,,0,0,0,,Әй, сен оғаш дыбыстар естімейсің бе?
Dialogue: 0,0:18:38.57,0:18:39.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:39.95,0:18:41.37,Default,,0,0,0,,(мұздың жарылған дыбысы)
Dialogue: 0,0:18:41.45,0:18:43.20,Default,,0,0,0,,Уау! қауіпті! «Мұнараның жарықтар салдарынан құлау қаупі бар...»
Dialogue: 0,0:18:43.20,0:18:44.83,Default,,0,0,0,,«Мұнара жарықтар салдарынан құлау қаупінде...»
Dialogue: 0,0:18:44.91,0:18:47.20,Default,,0,0,0,,(Тұрақты фирманың дауысы)
Dialogue: 0,0:18:58.67,0:19:00.55,Default,,0,0,0,,Қазір барсаң да, табысқа жете алмайсың!
Dialogue: 0,0:19:00.63,0:19:01.84,Default,,0,0,0,,Мәселе бұл емес!
Dialogue: 0,0:19:01.93,0:19:03.30,Default,,0,0,0,,Ішінде біреу бар!
Dialogue: 0,0:19:04.01,0:19:05.14,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:19:07.43,0:19:08.98,Default,,0,0,0,,(механикалық дыбысты түрлендіру)
Dialogue: 0,0:19:10.19,0:19:11.48,Default,,0,0,0,,Доддон!
Dialogue: 0,0:19:12.19,0:19:13.81,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:19:13.90,0:19:14.82,Default,,0,0,0,,Эй... не...
Dialogue: 0,0:19:14.90,0:19:15.73,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:15.82,0:19:17.36,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:19:17.44,0:19:18.74,Default,,0,0,0,,Шыу!
Dialogue: 0,0:19:19.74,0:19:20.03,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:19:20.03,0:19:21.57,Default,,0,0,0,,Бұл нені білдіреді? «Алтын Райан»
Dialogue: 0,0:19:21.57,0:19:21.66,Default,,0,0,0,,«Алтын Райан»
Dialogue: 0,0:19:21.66,0:19:21.70,Default,,0,0,0,,«Алтын Райан» Алтын Райан
Dialogue: 0,0:19:21.70,0:19:21.78,Default,,0,0,0,,Алтын Райан
Dialogue: 0,0:19:21.78,0:19:22.70,Default,,0,0,0,,Алтын Райан «басқа қаһармандардың қимылдарына тосқауыл қойды».
Dialogue: 0,0:19:22.70,0:19:22.78,Default,,0,0,0,,«Басқа батырлардың қозғалысы бөгелді».
Dialogue: 0,0:19:22.78,0:19:23.62,Default,,0,0,0,,«Басқа батырлардың қимылына тосқауыл қойдым» Достарымның қимылын бөгеп тастадым!
Dialogue: 0,0:19:23.62,0:19:24.99,Default,,0,0,0,,Мен жолдасымның қимылын бөгеп қойдым!
Dialogue: 0,0:19:25.08,0:19:26.37,Default,,0,0,0,,Енді батырлар...
Dialogue: 0,0:19:27.62,0:19:28.70,Default,,0,0,0,,Райан!
Dialogue: 0,0:19:28.79,0:19:31.17,Default,,0,0,0,,Әріптестердің қозғалуын әдейі тоқтату - бұл тәртіп бұзушылық!
Dialogue: 0,0:19:31.25,0:19:32.92,Default,,0,0,0,,Амансың ба? иә?
Dialogue: 0,0:19:33.00,0:19:35.29,Default,,0,0,0,,Ғимарат құласа да!
Dialogue: 0,0:19:35.38,0:19:37.84,Default,,0,0,0,,(ғимараттың сықырлауы)
Dialogue: 0,0:19:37.92,0:19:40.92,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:19:43.01,0:19:45.35,Default,,0,0,0,,О, құдай! Радио мұнарасын пайдалану «Алтын Райан блогы радио мұнарасымен!»
Dialogue: 0,0:19:45.35,0:19:45.43,Default,,0,0,0,,«Алтын Райан радио мұнарасымен блоктау!»
Dialogue: 0,0:19:45.43,0:19:47.31,Default,,0,0,0,,«Алтын Райан радио мұнарасын жауып тастайды!» Райан ғимаратты жауып тастайды!
Dialogue: 0,0:19:47.39,0:19:49.52,Default,,0,0,0,,Жарайсыңдар! Блоктау!
Dialogue: 0,0:19:49.60,0:19:52.10,Default,,0,0,0,,Бірақ... бұл жерден не істеуді жоспарлайсыз?
Dialogue: 0,0:19:52.19,0:19:55.77,Default,,0,0,0,,Басыңды пайдалан! Кенже, сіз қозғала аласыз, солай ма?
Dialogue: 0,0:19:59.40,0:20:01.45,Default,,0,0,0,,(қатты айқайлаған дауыс)
Dialogue: 0,0:20:01.53,0:20:02.74,Default,,0,0,0,,Ой! (Шнайдер) Жарайды, жүр!
Dialogue: 0,0:20:03.61,0:20:05.87,Default,,0,0,0,,Барнаби де оның қабілетін белсендіреді!
Dialogue: 0,0:20:06.78,0:20:08.12,Default,,0,0,0,,Қашпа! Тікелей айтшы!
Dialogue: 0,0:20:08.20,0:20:10.16,Default,,0,0,0,,Комбинация ретінде белсенді болмаудың мәні жоқ.
Dialogue: 0,0:20:10.25,0:20:11.25,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:20:11.33,0:20:13.46,Default,,0,0,0,,Мұны осылай жасау керек
Dialogue: 0,0:20:14.50,0:20:16.75,Default,,0,0,0,,Ұпай алатынымыз жақсы емес пе?
Dialogue: 0,0:20:16.84,0:20:18.00,Default,,0,0,0,,(Қатты дыбыс)
Dialogue: 0,0:20:18.09,0:20:19.09,Default,,0,0,0,,(Барлығы дем алады)
Dialogue: 0,0:20:23.38,0:20:26.35,Default,,0,0,0,,(Адамдардың дүрбелең дауысы)
Dialogue: 0,0:20:26.43,0:20:27.93,Default,,0,0,0,,(адамның үрейлі дауысы)
Dialogue: 0,0:20:28.51,0:20:30.14,Default,,0,0,0,,(Әйелдің айқайы)
Dialogue: 0,0:20:30.22,0:20:31.98,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:20:32.06,0:20:33.48,Default,,0,0,0,,Жарайды ма? ток
Dialogue: 0,0:20:33.56,0:20:35.02,Default,,0,0,0,,Бұл жағымсыз тик.
Dialogue: 0,0:20:36.27,0:20:37.36,Default,,0,0,0,,Енді уайымдамаңыз
Dialogue: 0,0:20:37.44,0:20:38.82,Default,,0,0,0,,Мен көрдім!
Dialogue: 0,0:20:38.90,0:20:40.98,Default,,0,0,0,,Құбыжық ғимаратты бүлдіріп жатыр!
Dialogue: 0,0:20:41.07,0:20:41.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:41.90,0:20:44.32,Default,,0,0,0,,Мен үлкен көлеңке көрдім деп ойладым...
Dialogue: 0,0:20:44.40,0:20:45.86,Default,,0,0,0,,Кенет... (Өрт сөндіруші) Тынышталыңыз.
Dialogue: 0,0:20:48.12,0:20:49.95,Default,,0,0,0,,Жақсы жұмыс! Жарайсың!
Dialogue: 0,0:20:50.04,0:20:52.91,Default,,0,0,0,,Оқиға орнында тұрған кенже өте керемет!
Dialogue: 0,0:20:54.37,0:20:56.50,Default,,0,0,0,,Бір кезде «Райан мен Барнабиді бірінші құтқару!» болатын сияқты көрінді.
Dialogue: 0,0:20:56.50,0:20:56.58,Default,,0,0,0,,«Райан мен Барнабиді бірінші құтқару!»
Dialogue: 0,0:20:56.58,0:20:57.50,Default,,0,0,0,,«Райан мен Барнабидің алғашқы құтқаруы!» Құтқарушы!
Dialogue: 0,0:20:57.50,0:20:57.58,Default,,0,0,0,,«Райан мен Барнабиді бірінші құтқару!»
Dialogue: 0,0:20:57.58,0:20:58.09,Default,,0,0,0,,«Райан мен Барнабиді бірінші құтқару!»
Dialogue: 0,0:20:57.58,0:20:58.09,Default,,0,0,0,,Мәселені жаңа дуэт шешті: Райан мен Барнаби!
Dialogue: 0,0:20:58.09,0:21:02.01,Default,,0,0,0,,Мәселені жаңа дуэт шешті: Райан мен Барнаби!
Dialogue: 0,0:21:02.09,0:21:03.76,Default,,0,0,0,,Керемет үйлестіру ойыны
Dialogue: 0,0:21:03.84,0:21:05.72,Default,,0,0,0,,Мен бірінші рет бірігіп отырғаныма сене алар емеспін!
Dialogue: 0,0:21:05.80,0:21:09.10,Default,,0,0,0,,Құттықтаймын... 2-ші бөлімде де бар күшімді саламын.
Dialogue: 0,0:21:12.52,0:21:14.89,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:21:15.48,0:21:16.35,Default,,0,0,0,,(қоңыр музыка)
Dialogue: 0,0:21:16.35,0:21:17.15,Default,,0,0,0,,(қоңыр музыка)
Dialogue: 0,0:21:16.35,0:21:17.15,Default,,0,0,0,,«Әділет фестивалі»
Dialogue: 0,0:21:17.15,0:21:18.02,Default,,0,0,0,,«Әділет фестивалі»
Dialogue: 0,0:21:21.61,0:21:24.03,Default,,0,0,0,,Жануар мен батыр арасындағы тартыс қандай ауыр.
Dialogue: 0,0:21:24.11,0:21:25.74,Default,,0,0,0,,Қызықты жоба, солай ма?
Dialogue: 0,0:21:25.82,0:21:28.37,Default,,0,0,0,,КЕЛЕСІ дегенді адам деп атауға болмайды.
Dialogue: 0,0:21:28.45,0:21:30.83,Default,,0,0,0,,Осыны көп істеу керек.
Dialogue: 0,0:21:32.24,0:21:33.58,Default,,0,0,0,,Не? сол көздер
Dialogue: 0,0:21:34.08,0:21:35.21,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:35.29,0:21:38.08,Default,,0,0,0,,Hero TV басқаратын OBC, Apollon еншілес компаниясы болып табылады.
Dialogue: 0,0:21:35.29,0:21:38.08,Default,,0,0,0,,«Батыр бизнес бөлімі»
Dialogue: 0,0:21:38.08,0:21:39.13,Default,,0,0,0,,Hero TV басқаратын OBC, Apollon еншілес компаниясы болып табылады.
Dialogue: 0,0:21:39.21,0:21:40.04,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:21:40.13,0:21:42.96,Default,,0,0,0,,Тіпті 7 ірі компанияның да үнін өшіруге болады.
Dialogue: 0,0:21:43.05,0:21:45.67,Default,,0,0,0,,Қалғаны сізге, Сот бюросына байланысты.
Dialogue: 0,0:21:45.76,0:21:48.22,Default,,0,0,0,,Маған рұқсат бересіз бе деп ойлаймын.
Dialogue: 0,0:21:48.30,0:21:50.60,Default,,0,0,0,,Жарайды, талқылайық.
Dialogue: 0,0:21:50.68,0:21:51.89,Default,,0,0,0,,(Шнайдердің ысқырығы)
Dialogue: 0,0:21:51.97,0:21:53.43,Default,,0,0,0,,Мен сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:21:53.52,0:21:54.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:55.02,0:21:57.77,Default,,0,0,0,,Екінші бөлімнің кейіпкерін айтуды ұмытып кетіпсіз.
Dialogue: 0,0:21:57.85,0:21:59.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:00.44,0:22:02.61,Default,,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:22:02.69,0:22:05.28,Default,,0,0,0,,Күні кеше, жұмыстан бұрын мен жолдан шығып кеттім
Dialogue: 0,0:22:05.36,0:22:08.53,Default,,0,0,0,,Жоқ, мен мұны жақсы көргендіктен істеп жатырмын.
Dialogue: 0,0:22:09.36,0:22:10.82,Default,,0,0,0,,Баяғыда
Dialogue: 0,0:22:10.91,0:22:14.41,Default,,0,0,0,,Әділдік деген сөзді әлі білмеген заманда.
Dialogue: 0,0:22:14.49,0:22:15.70,Default,,0,0,0,,Богиня
Dialogue: 0,0:22:15.79,0:22:19.25,Default,,0,0,0,,Мен Штернбилд жерінде шағын қалашық салдым.
Dialogue: 0,0:22:19.33,0:22:20.67,Default,,0,0,0,,Жақында
Dialogue: 0,0:22:20.75,0:22:22.09,Default,,0,0,0,,Әділет күні дегеніміз не?
Dialogue: 0,0:22:22.59,0:22:23.46,Default,,0,0,0,,Фестивальде?
Dialogue: 0,0:22:24.80,0:22:26.97,Default,,0,0,0,,Мен сені өзіммен бірге алғым келеді.
Dialogue: 0,0:22:27.05,0:22:28.47,Default,,0,0,0,,Қала халқы⸺ «Ауыл адамдары ашкөздіктің жетегінде кеткен».
Dialogue: 0,0:22:28.47,0:22:28.55,Default,,0,0,0,,Қала тұрғындары⸺
Dialogue: 0,0:22:28.55,0:22:28.63,Default,,0,0,0,,«Жеке пайда үшін күрескен»
Dialogue: 0,0:22:28.63,0:22:29.84,Default,,0,0,0,,«Олар өздерінің жеке мүдделері үшін күресті».
Dialogue: 0,0:22:29.84,0:22:29.93,Default,,0,0,0,,Өз қалауыңыз бойынша тонауды қайталамаңыз
Dialogue: 0,0:22:29.93,0:22:31.18,Default,,0,0,0,,Өз қалауыңыз бойынша тонауды қайталасаңыз, «жаман істеріңізге құдайы елші жіберді».
Dialogue: 0,0:22:31.18,0:22:31.26,Default,,0,0,0,,«Тәңірі сол зұлымдық үшін хабаршы жіберді».
Dialogue: 0,0:22:31.26,0:22:32.72,Default,,0,0,0,,«Құдай олардың зұлымдықтарына жауап ретінде хабаршы жіберді». Олар бір-бірін ренжітті.
Dialogue: 0,0:22:32.72,0:22:32.76,Default,,0,0,0,,«Тәңірі сол зұлымдық үшін хабаршы жіберді».
Dialogue: 0,0:22:32.80,0:22:34.68,Default,,0,0,0,,Көре алмаған құдай
Dialogue: 0,0:22:34.77,0:22:36.89,Default,,0,0,0,,Оларға аян беру.
Dialogue: 0,0:22:36.98,0:22:39.73,Default,,0,0,0,,Шаянды жібер
Dialogue: 0,0:22:40.52,0:22:42.06,Default,,0,0,0,,Шаян айтты
Dialogue: 0,0:22:42.15,0:22:44.48,Default,,0,0,0,,«Істеріңе өкін»
Dialogue: 0,0:22:44.57,0:22:47.65,Default,,0,0,0,,«Әйтпесе құдайдың жазасы болады».
Dialogue: 0,0:22:47.74,0:22:51.91,Default,,0,0,0,,Алайда адамдар ол сөздерді тыңдамайды.
Dialogue: 0,0:22:51.99,0:22:55.20,Default,,0,0,0,,Мен күткендей, маған жіберілген шаянды жедім.
Dialogue: 0,0:22:55.29,0:22:57.45,Default,,0,0,0,,Тәңірі мұңнан қалтырап қалса,
Dialogue: 0,0:22:57.54,0:22:59.16,Default,,0,0,0,,Айқайлау
Dialogue: 0,0:22:59.25,0:23:02.00,Default,,0,0,0,,Аспанда пайда болады
Dialogue: 0,0:23:02.08,0:23:03.75,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:23:03.84,0:23:06.21,Default,,0,0,0,,Аспаннан түскен болат қылыштан да қатты
Dialogue: 0,0:23:06.30,0:23:08.59,Default,,0,0,0,,Жарық жаңбыр жауады
Dialogue: 0,0:23:08.67,0:23:11.84,Default,,0,0,0,,Сиырлар мен жылқылар шошып, теңізге секірді.
Dialogue: 0,0:23:11.93,0:23:16.06,Default,,0,0,0,,Ұйқы ауруы одан да көп адамдарға әсер етеді
Dialogue: 0,0:23:16.14,0:23:18.31,Default,,0,0,0,,Олар түнгі түндерді аралап жүре береді...
Dialogue: 0,0:23:18.39,0:23:20.23,Default,,0,0,0,,Сондай сағыныш
Dialogue: 0,0:23:20.31,0:23:21.60,Default,,0,0,0,,Баяғыда ата-анам...
Dialogue: 0,0:23:21.69,0:23:23.65,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:23:24.94,0:23:26.48,Default,,0,0,0,,Мен оны қабылдай алмаймын.
Dialogue: 0,0:23:24.94,0:23:26.48,Default,,0,0,0,,«Соңғы жаңалықтар 2-бөлім кейіпкері уақытша тоқтатылды...»
Dialogue: 0,0:23:26.57,0:23:28.57,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:23:28.65,0:23:30.86,Default,,0,0,0,,Басқарма отырысында ұсынылған меншік иесі
Dialogue: 0,0:23:30.95,0:23:33.41,Default,,0,0,0,,«Оңай өтті».
Dialogue: 0,0:23:33.49,0:23:34.83,Default,,0,0,0,,«Дасу десу» нені білдіреді?
Dialogue: 0,0:23:35.41,0:23:37.29,Default,,0,0,0,,Маған сізбен тікелей сөйлесуге рұқсат етіңіз!
Dialogue: 0,0:23:37.37,0:23:40.29,Default,,0,0,0,,Иесі онымен кездесуге ниеті жоқ екенін айтады.
Dialogue: 0,0:23:40.37,0:23:41.75,Default,,0,0,0,,Сонымен!
Dialogue: 0,0:23:41.83,0:23:43.46,Default,,0,0,0,,Соңында барлығына бір ауыз сөз...
Dialogue: 0,0:23:44.33,0:23:45.96,Default,,0,0,0,,«Сау бол»
Dialogue: 0,0:23:46.04,0:23:48.17,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:23:52.18,0:23:55.01,Default,,0,0,0,,Еңбегіңізге рахмет, иесі
Dialogue: 0,0:23:56.18,0:23:58.97,Default,,0,0,0,,Сәлем! Дүрбелең емес, асығыңыз және жіберіңіз.
Dialogue: 0,0:23:59.98,0:24:02.56,Default,,0,0,0,,Сен, бәрі жақсы! Мынадай нәрсе
Dialogue: 0,0:24:02.64,0:24:03.15,Default,,0,0,0,,Иә...?
Dialogue: 0,0:24:03.23,0:24:05.48,Default,,0,0,0,,Сіз күдіктісіз.
Dialogue: 0,0:24:06.19,0:24:09.48,Default,,0,0,0,,Мен ондай адамдардың маған жақындауына жол бермеуді шештім.
Dialogue: 0,0:24:09.57,0:24:11.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:11.74,0:24:14.03,Default,,0,0,0,,Әрқашан ойлағандай болмайтын нәрселер болады.
Dialogue: 0,0:24:14.11,0:24:14.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:15.03,0:24:16.24,Default,,0,0,0,,Мен де...
Dialogue: 0,0:24:15.03,0:24:16.24,Default,,0,0,0,,«2-ші бөлік батыр жойылды!»
Dialogue: 0,0:24:16.32,0:24:19.08,Default,,0,0,0,,Мен жаңа әдістерді жақсы орындай алмаймын...
Dialogue: 0,0:24:19.16,0:24:20.00,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:24:20.08,0:24:22.46,Default,,0,0,0,,Найзағайдың пішінін беріп, оны қозғалта алсаң
Dialogue: 0,0:24:22.54,0:24:24.00,Default,,0,0,0,,Мен бұл ыңғайлы деп ойладым.
Dialogue: 0,0:24:24.08,0:24:26.71,Default,,0,0,0,,Бірақ... қанша тырыссам да шықпайды.
Dialogue: 0,0:24:26.79,0:24:29.21,Default,,0,0,0,,Кешіріңіз... Нені айтып тұрсыз?
Dialogue: 0,0:24:29.80,0:24:32.22,Default,,0,0,0,,Тіпті мен қалағандай болмаса да,
Dialogue: 0,0:24:32.30,0:24:34.72,Default,,0,0,0,,Басқа адамдарды немесе компанияларды жылжыту?
Dialogue: 0,0:24:34.80,0:24:36.72,Default,,0,0,0,,Одан да қиын болар деп ойладым.
Dialogue: 0,0:24:36.80,0:24:37.97,Default,,0,0,0,,Жолбарыс мырза
Dialogue: 0,0:24:38.05,0:24:39.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:40.18,0:24:44.48,Default,,0,0,0,,Қазірдің өзінде! Қараңғы түскенде не істейміз?
Dialogue: 0,0:24:44.56,0:24:46.48,Default,,0,0,0,,Күлімсіреу Күлімсіре! (Карина) Жарайды.
Dialogue: 0,0:24:46.56,0:24:48.61,Default,,0,0,0,,Өрт эмблемасы әрқашан жарық
Dialogue: 0,0:24:49.48,0:24:52.28,Default,,0,0,0,,Өйткені менің уайымым жоқ.
Dialogue: 0,0:24:52.36,0:24:54.32,Default,,0,0,0,,Мен күн сайын бақыттымын!
Dialogue: 0,0:24:54.40,0:24:55.61,Default,,0,0,0,,Бұл ертегі.
Dialogue: 0,0:24:56.20,0:24:57.03,Default,,0,0,0,,Бұл таңқаларлық болуы керек.
Dialogue: 0,0:24:57.12,0:24:58.24,Default,,0,0,0,,Мистер Уайлд
Dialogue: 0,0:24:58.33,0:25:01.87,Default,,0,0,0,,Аа, "Hero TV"-ге көп үлес қоссаңыз да.
Dialogue: 0,0:25:02.91,0:25:05.71,Default,,0,0,0,,Егер мен сияқты танымал емес адам сізді алаңдатса.
Dialogue: 0,0:25:06.42,0:25:08.00,Default,,0,0,0,,Бұл қажет емес позиция емес пе?
Dialogue: 0,0:25:08.08,0:25:09.96,Default,,0,0,0,,Бұл дұрыс емес, иә?
Dialogue: 0,0:25:10.05,0:25:11.92,Default,,0,0,0,,Бұл, әрине, танымал емес
Dialogue: 0,0:25:12.01,0:25:14.47,Default,,0,0,0,,Бизон қылмыскермен бетпе-бет келеді.
Dialogue: 0,0:25:14.55,0:25:16.76,Default,,0,0,0,,Ол ортадағы батыр!
Dialogue: 0,0:25:16.84,0:25:18.47,Default,,0,0,0,,(дартты соғу дыбысы)
Dialogue: 0,0:25:18.55,0:25:19.39,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:25:19.47,0:25:21.85,Default,,0,0,0,,Осымен салыстырғанда мен мимиканы қолданамын⸺
Dialogue: 0,0:25:21.93,0:25:23.73,Default,,0,0,0,,Сіз жасай алатын жалғыз нәрсе - артыңыздан шабуыл жасау ...
Dialogue: 0,0:25:24.31,0:25:27.31,Default,,0,0,0,,Сондай қорқақ батыр
Dialogue: 0,0:25:27.40,0:25:29.98,Default,,0,0,0,,Мен Жолбарыс-сан үшін алаңдаймын. Менің біліктілігім жоқ...
Dialogue: 0,0:25:30.07,0:25:32.57,Default,,0,0,0,,Мен сені танимын, ә...
Dialogue: 0,0:25:33.15,0:25:34.82,Default,,0,0,0,,Қабылданды! Сіз!
Dialogue: 0,0:25:34.90,0:25:36.49,Default,,0,0,0,,(Антонио мен Иванның күлкісі)
Dialogue: 0,0:25:36.57,0:25:40.37,Default,,0,0,0,,Биік аспан бұл туралы айтудың біртүрлі тәсілі, солай емес пе?
Dialogue: 0,0:25:40.45,0:25:41.49,Default,,0,0,0,,Сіз соған ұмтыласыз ба?
Dialogue: 0,0:25:41.58,0:25:43.70,Default,,0,0,0,,Бір жақсысы көздегенім жоқ.
Dialogue: 0,0:25:44.29,0:25:46.04,Default,,0,0,0,,Мен соны мақсат етіп отырмын.
Dialogue: 0,0:25:46.12,0:25:46.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:47.00,0:25:50.21,Default,,0,0,0,,Тіпті мен күн сайын өз сезімімді жеткізуге тырысамын.
Dialogue: 0,0:25:50.29,0:25:51.67,Default,,0,0,0,,Нақты мақсат қою
Dialogue: 0,0:25:51.75,0:25:55.05,Default,,0,0,0,,Бірақ... неге екені белгісіз, бәрі маған күледі.
Dialogue: 0,0:25:55.13,0:25:56.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:25:56.38,0:25:58.84,Default,,0,0,0,,Кешіріңіз... Мен күлдім.
Dialogue: 0,0:25:58.93,0:26:02.18,Default,,0,0,0,,Жоқ, бұл үлкен мәселе емес, менің қиындықтарым
Dialogue: 0,0:26:02.85,0:26:04.39,Default,,0,0,0,,Мистер Уайлдпен салыстырғанда
Dialogue: 0,0:26:05.27,0:26:07.19,Default,,0,0,0,,(қара музыка)
Dialogue: 0,0:26:07.27,0:26:08.10,Default,,0,0,0,,Зұлымдық
Dialogue: 0,0:26:08.69,0:26:10.61,Default,,0,0,0,,Ағамды да қиналдым.
Dialogue: 0,0:26:10.69,0:26:13.11,Default,,0,0,0,,Менің ойымша, бұл жаңалық емес.
Dialogue: 0,0:26:14.78,0:26:16.90,Default,,0,0,0,,Каэде ше? (Мұрамаса) Ұйықтап қалды.
Dialogue: 0,0:26:16.99,0:26:20.20,Default,,0,0,0,,Менің ойымша, сіз жұмыстан босатыламын деген әбігерден шаршаған шығарсыз.
Dialogue: 0,0:26:20.28,0:26:21.99,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:26:22.49,0:26:25.45,Default,,0,0,0,,Әй, неге мұнда қайтып келмейсің?
Dialogue: 0,0:26:26.58,0:26:27.54,Default,,0,0,0,,Иә...
Dialogue: 0,0:26:28.79,0:26:30.46,Default,,0,0,0,,Ал, асықпай, шешім қабылда.
Dialogue: 0,0:26:31.08,0:26:33.21,Default,,0,0,0,,Рахмет, мен сізге қайта қоңырау шаламын.
Dialogue: 0,0:26:33.80,0:26:34.63,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:26:53.86,0:26:55.28,Default,,0,0,0,,«Қоян»
Dialogue: 0,0:27:02.37,0:27:03.78,Default,,0,0,0,,«Котецу»
Dialogue: 0,0:27:03.87,0:27:06.45,Default,,0,0,0,,(Қызық әуен)
Dialogue: 0,0:27:09.37,0:27:11.29,Default,,0,0,0,,«Жабайы жолбарыс ақыры атылды ма?»
Dialogue: 0,0:27:12.63,0:27:14.84,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:27:15.96,0:27:16.80,Default,,0,0,0,,Субару-кун?
Dialogue: 0,0:27:16.88,0:27:19.13,Default,,0,0,0,,Мм... сіз Көк раушан мырзасыз ба?
Dialogue: 0,0:27:19.22,0:27:19.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:19.97,0:27:22.64,Default,,0,0,0,,Мен Каэдемін, жабайы жолбарыс...
Dialogue: 0,0:27:22.72,0:27:24.80,Default,,0,0,0,,Каэде-чан? (Кэде) Иә
Dialogue: 0,0:27:22.72,0:27:24.80,Default,,0,0,0,,«Қабураги»
Dialogue: 0,0:27:24.80,0:27:24.89,Default,,0,0,0,,«Кабураги»
Dialogue: 0,0:27:24.89,0:27:25.35,Default,,0,0,0,,«Қабураги»
Dialogue: 0,0:27:24.89,0:27:25.35,Default,,0,0,0,,Сіз маған бірдеңе болса хабарласыңыз деп бұрын айттыңыз ғой, солай ма?
Dialogue: 0,0:27:25.35,0:27:27.72,Default,,0,0,0,,Сіз маған бірдеңе болса хабарласыңыз деп бұрын айтқансыз, солай ма?
Dialogue: 0,0:27:27.81,0:27:28.85,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:27:29.39,0:27:30.64,Default,,0,0,0,,Мазасыздық тудырды ма?
Dialogue: 0,0:27:30.73,0:27:34.15,Default,,0,0,0,,Мүлде жоқ! Сіз өте кеш тұрасыз.
Dialogue: 0,0:27:34.65,0:27:35.65,Default,,0,0,0,,Әкем…
Dialogue: 0,0:27:35.73,0:27:38.53,Default,,0,0,0,,Сіз шынымен депрессияға түскен сияқтысыз.
Dialogue: 0,0:27:39.57,0:27:40.74,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:27:40.82,0:27:42.82,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:27:44.74,0:27:48.16,Default,,0,0,0,,♪ Сіз маған бағынасыз
Dialogue: 0,0:27:48.24,0:27:50.54,Default,,0,0,0,,♪ Тағзым ет
Dialogue: 0,0:27:50.62,0:27:51.25,Default,,0,0,0,,♪ Менің сұлулық ақылым
Dialogue: 0,0:27:51.25,0:27:54.00,Default,,0,0,0,,♪ Менің сұлулық ақылым
Dialogue: 0,0:27:51.25,0:27:54.00,Default,,0,0,0,,««КЕЛЕСІ ӨТ!» Көк раушан»
Dialogue: 0,0:27:54.08,0:27:56.54,Default,,0,0,0,,♪ Кристалдан да жарқыраған
Dialogue: 0,0:27:56.63,0:27:58.34,Default,,0,0,0,,Раушан!
Dialogue: 0,0:27:58.42,0:28:00.38,Default,,0,0,0,,(қорқынышты айқай)
Dialogue: 0,0:28:00.47,0:28:01.63,Default,,0,0,0,,(Жүк көлігінің соғылған дыбысы)
Dialogue: 0,0:28:05.10,0:28:06.10,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:28:08.14,0:28:10.02,Default,,0,0,0,,(Сайтоның дауысы сонша, мен оны естімеймін)
Dialogue: 0,0:28:10.10,0:28:11.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:11.18,0:28:13.06,Default,,0,0,0,,Бұл мен жасаған костюм.
Dialogue: 0,0:28:13.60,0:28:16.31,Default,,0,0,0,,Мынау сіз киген арзан костюм.
Dialogue: 0,0:28:16.40,0:28:18.07,Default,,0,0,0,,Костюм дегеніміз не?
Dialogue: 0,0:28:18.15,0:28:18.73,Default,,0,0,0,,«Бастау»
Dialogue: 0,0:28:18.73,0:28:19.15,Default,,0,0,0,,«Бастау»
Dialogue: 0,0:28:18.73,0:28:19.15,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:28:19.15,0:28:19.73,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:28:19.82,0:28:22.11,Default,,0,0,0,,(ісіну дыбысы)
Dialogue: 0,0:28:25.74,0:28:26.83,Default,,0,0,0,,(Күлімдеген дауыс)
Dialogue: 0,0:28:27.33,0:28:29.29,Default,,0,0,0,,Бұл мүлде ақылға сыймайды
Dialogue: 0,0:28:29.37,0:28:32.00,Default,,0,0,0,,Мен костюм кигенше бәрі жақсы.
Dialogue: 0,0:28:32.08,0:28:33.16,Default,,0,0,0,,Мен мұны Жолбарысқа көрсеткенімде
Dialogue: 0,0:28:33.25,0:28:34.83,Default,,0,0,0,,Бұл жақсырақ жауап болды.
Dialogue: 0,0:28:34.92,0:28:36.79,Default,,0,0,0,,ше? Не?
Dialogue: 0,0:28:36.88,0:28:38.17,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:28:38.25,0:28:39.96,Default,,0,0,0,,Стернбридждегі үлкен апат!
Dialogue: 0,0:28:40.05,0:28:41.55,Default,,0,0,0,,Қазір құтқаруға барыңыз!
Dialogue: 0,0:28:41.63,0:28:43.84,Default,,0,0,0,,(Мотоциклдің жүгіру дыбысы)
Dialogue: 0,0:28:47.14,0:28:47.76,Default,,0,0,0,,«Қауіп»
Dialogue: 0,0:28:47.76,0:28:48.85,Default,,0,0,0,,«Қауіп»
Dialogue: 0,0:28:47.76,0:28:48.85,Default,,0,0,0,,Йотто!
Dialogue: 0,0:28:48.85,0:28:49.14,Default,,0,0,0,,«Қауіп»
Dialogue: 0,0:28:59.77,0:29:01.03,Default,,0,0,0,,«Оңтүстік жасыл…»
Dialogue: 0,0:29:01.11,0:29:01.94,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:29:02.03,0:29:03.07,Default,,0,0,0,,«Оңтүстік Жасыл WK Іздеу нәтижелері жоқ»
Dialogue: 0,0:29:03.07,0:29:04.24,Default,,0,0,0,,«Оңтүстік Жасыл WK Іздеу нәтижелері жоқ»
Dialogue: 0,0:29:03.07,0:29:04.24,Default,,0,0,0,,Иә? (қате дыбысы)
Dialogue: 0,0:29:04.32,0:29:07.07,Default,,0,0,0,,Эй, сен маған асығуың керек.
Dialogue: 0,0:29:07.16,0:29:08.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:29:08.37,0:29:10.45,Default,,0,0,0,,Мен бәрібір мұндай нәрсемен таныс емеспін.
Dialogue: 0,0:29:10.54,0:29:12.66,Default,,0,0,0,,Жетер, жігітім!
Dialogue: 0,0:29:12.75,0:29:14.25,Default,,0,0,0,,Тұтынушы...?
Dialogue: 0,0:29:14.33,0:29:15.96,Default,,0,0,0,,(Полиция көлігінің сиренасының дыбысы)
Dialogue: 0,0:29:17.25,0:29:19.59,Default,,0,0,0,,Міне, «Батырды құтқару операциясы...» көрінісі.
Dialogue: 0,0:29:19.59,0:29:20.09,Default,,0,0,0,,«Батырды құтқару әрекеттері...»
Dialogue: 0,0:29:20.09,0:29:20.67,Default,,0,0,0,,«Батырды құтқару операциясы...» Кенеттен көптеген көліктер
Dialogue: 0,0:29:20.67,0:29:20.75,Default,,0,0,0,,Көптеген машиналар кенеттен
Dialogue: 0,0:29:20.75,0:29:21.84,Default,,0,0,0,,Көптеген көліктер кенеттен «Стернбриджден бірнеше көлік құлады»
Dialogue: 0,0:29:21.84,0:29:21.92,Default,,0,0,0,,«Стернбриджден бірнеше көлік құлады»
Dialogue: 0,0:29:21.92,0:29:24.26,Default,,0,0,0,,«Стерн көпірінен бірнеше көлік құлады» Көпірден көліктер құлаған дейді.
Dialogue: 0,0:29:24.34,0:29:25.84,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,0:29:25.93,0:29:27.51,Default,,0,0,0,,Артқа тұрыңыз! Қайтыңыз!
Dialogue: 0,0:29:27.59,0:29:30.10,Default,,0,0,0,,Сәлем! Не болды?
Dialogue: 0,0:29:30.18,0:29:31.06,Default,,0,0,0,,Жоқ, сен!
Dialogue: 0,0:29:31.64,0:29:34.10,Default,,0,0,0,,Ой! Бұл мен!
Dialogue: 0,0:29:34.85,0:29:36.39,Default,,0,0,0,,Тіпті жабайы жолбарыс!
Dialogue: 0,0:29:36.90,0:29:37.73,Default,,0,0,0,,Не...?
Dialogue: 0,0:29:37.81,0:29:39.31,Default,,0,0,0,,Сіз енді батыр емессіз
Dialogue: 0,0:29:39.40,0:29:40.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:40.52,0:29:43.19,Default,,0,0,0,,Ереже болғандықтан, жалпы жұртшылыққа кіруге болмайды...
Dialogue: 0,0:29:43.28,0:29:45.24,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:29:45.32,0:29:46.03,Default,,0,0,0,,«Жедел жәрдем»
Dialogue: 0,0:29:46.03,0:29:46.86,Default,,0,0,0,,«Жедел жәрдем»
Dialogue: 0,0:29:46.03,0:29:46.86,Default,,0,0,0,,қуыршақтай киімінен мүлде алшақ еді—
Dialogue: 0,0:29:46.95,0:29:49.74,Default,,0,0,0,,Иә, кенет секіріп кетті.
Dialogue: 0,0:29:49.82,0:29:51.58,Default,,0,0,0,,Руль дөңгелегін бұрғанда...
Dialogue: 0,0:29:52.08,0:29:53.50,Default,,0,0,0,,Теңізге... (Мазасыз күлкі дыбысы)
Dialogue: 0,0:29:53.58,0:29:55.50,Default,,0,0,0,,Сонда бұл ханым ше?
Dialogue: 0,0:29:55.58,0:29:58.63,Default,,0,0,0,,А... Маған тиді деп ойладым.
Dialogue: 0,0:29:58.71,0:30:01.25,Default,,0,0,0,,Мен сені еш жерден көре алмаймын... Өтірік айтпа.
Dialogue: 0,0:30:01.34,0:30:02.71,Default,,0,0,0,,Жазатайым оқиға болғанын жасыруға тырысу!
Dialogue: 0,0:30:02.80,0:30:03.30,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:30:03.38,0:30:05.17,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:30:05.26,0:30:06.93,Default,,0,0,0,,Мен ойлағанымда, біртүрлі гүрілдеген дыбыс естідім
Dialogue: 0,0:30:07.01,0:30:09.30,Default,,0,0,0,,Кенет алдымнан бір әйел шықты...
Dialogue: 0,0:30:09.39,0:30:10.76,Default,,0,0,0,,Гурылдады?
Dialogue: 0,0:30:10.85,0:30:13.52,Default,,0,0,0,,Өткенде шырылдаған осы ма?
Dialogue: 0,0:30:13.60,0:30:16.56,Default,,0,0,0,,Қараңдар! Мен оны ғимарат құламай тұрып естідім.
Dialogue: 0,0:30:16.64,0:30:18.19,Default,,0,0,0,,«Ой, уау»!
Dialogue: 0,0:30:18.27,0:30:19.65,Default,,0,0,0,,Манга ма? Ах, мен де бәрібір адам сияқты оқимын ғой, болар.
Dialogue: 0,0:30:19.73,0:30:21.65,Default,,0,0,0,,Бұл солай естіледі (Көк раушан) Иә?
Dialogue: 0,0:30:21.73,0:30:24.03,Default,,0,0,0,,Сонымен, бұл оқиға және өткен күнгі апат
Dialogue: 0,0:30:24.11,0:30:25.94,Default,,0,0,0,,Қалай ойлайсыңдар, олар бір-бірімен байланысты ма?
Dialogue: 0,0:30:26.53,0:30:27.82,Default,,0,0,0,,Богиня туралы аңыз...
Dialogue: 0,0:30:27.90,0:30:29.41,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:30:29.49,0:30:33.03,Default,,0,0,0,,Жоқ... Жазатайым оқиғалар тізбегі аңызға өте ұқсас сияқты.
Dialogue: 0,0:30:33.12,0:30:34.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:34.62,0:30:38.00,Default,,0,0,0,,Тәңір айқайлайды, Жарық жаңбыр жауады.
Dialogue: 0,0:30:38.08,0:30:42.00,Default,,0,0,0,,Ғимараттар қирап, сиырлар мен жылқылар теңізге құлады.
Dialogue: 0,0:30:42.67,0:30:43.67,Default,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:30:43.75,0:30:45.92,Default,,0,0,0,,Біреу аңызға еліктеп, оқиға тудырды...
Dialogue: 0,0:30:46.01,0:30:47.38,Default,,0,0,0,,Сіз тым көп ойлайсыз ба?
Dialogue: 0,0:30:47.47,0:30:48.30,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:30:48.38,0:30:50.84,Default,,0,0,0,,100 қадамнан бас тартсаңыз да
Dialogue: 0,0:30:50.93,0:30:52.97,Default,,0,0,0,,Ешбір құдай пайда болмайды.
Dialogue: 0,0:30:53.05,0:30:54.97,Default,,0,0,0,,Мм... барлығы.
Dialogue: 0,0:30:55.06,0:30:57.18,Default,,0,0,0,,Бұл құдай туралы әңгіме.
Dialogue: 0,0:30:57.27,0:31:00.98,Default,,0,0,0,,Расында, кеше мен сұхбат берген Некояшики кемпір осылай деді.
Dialogue: 0,0:31:01.56,0:31:03.06,Default,,0,0,0,,«Қорқынышты дыбыс жаңғырық»
Dialogue: 0,0:31:03.15,0:31:04.98,Default,,0,0,0,,«Терезе әйнегі сынғанда»
Dialogue: 0,0:31:05.07,0:31:06.57,Default,,0,0,0,,«Мен құдайдың көлеңкесін көрдім»
Dialogue: 0,0:31:07.24,0:31:10.49,Default,,0,0,0,,Мен сене алмадым, сондықтан мен оған мән бермедім.
Dialogue: 0,0:31:10.57,0:31:12.24,Default,,0,0,0,,Богиняның көлеңкесі?
Dialogue: 0,0:31:12.32,0:31:15.37,Default,,0,0,0,,Сонымен, әйнек сынған жарық жаңбыры ма?
Dialogue: 0,0:31:15.45,0:31:17.58,Default,,0,0,0,,Ойлап қарасам, ғимарат құлаған кезде⸺
Dialogue: 0,0:31:17.66,0:31:20.25,Default,,0,0,0,,Адам үлкен құбыжықтың көлеңкесін көрдім дейді.
Dialogue: 0,0:31:20.33,0:31:22.21,Default,,0,0,0,,Богиня деген осы ма?
Dialogue: 0,0:31:22.29,0:31:23.08,Default,,0,0,0,,Эй
Dialogue: 0,0:31:23.17,0:31:25.25,Default,,0,0,0,,Аңыздарға келгенде...
Dialogue: 0,0:31:25.34,0:31:27.13,Default,,0,0,0,,Ұйқы ауруы кең тарағанына сенімдімін...
Dialogue: 0,0:31:27.21,0:31:27.96,Default,,0,0,0,,Ой ой!
Dialogue: 0,0:31:28.05,0:31:30.34,Default,,0,0,0,,Осыны тоқтатайық, бұл күлкілі.
Dialogue: 0,0:31:30.43,0:31:32.55,Default,,0,0,0,,Бұл дыбыс!
Dialogue: 0,0:31:32.64,0:31:34.80,Default,,0,0,0,,(Шернеуді арттыратын музыка)
Dialogue: 0,0:31:34.89,0:31:36.89,Default,,0,0,0,,Барлығына! Дереу дереккөзді табыңыз!
Dialogue: 0,0:31:36.97,0:31:40.14,Default,,0,0,0,,(қорқынышты айқай)
Dialogue: 0,0:31:45.65,0:31:47.53,Default,,0,0,0,,Мен кенеттен есту қабілетімнен айырылдым.
Dialogue: 0,0:31:47.61,0:31:48.78,Default,,0,0,0,,...Сонымен бітті.
Dialogue: 0,0:31:50.19,0:31:51.03,Default,,0,0,0,,Балалар, сендер қалай ойлайсыңдар?
Dialogue: 0,0:31:51.74,0:31:53.16,Default,,0,0,0,,Ертедегі құдайдың әңгімесі
Dialogue: 0,0:31:53.24,0:31:55.16,Default,,0,0,0,,Мен әлі шешкен жоқпын...
Dialogue: 0,0:31:55.24,0:31:57.74,Default,,0,0,0,,Бұл аздап оккультизм.
Dialogue: 0,0:31:57.83,0:32:00.83,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:32:00.91,0:32:02.08,Default,,0,0,0,,Бұл ол!
Dialogue: 0,0:32:06.29,0:32:08.88,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:32:13.34,0:32:14.18,Default,,0,0,0,,(қанағаттанып иіскеу)
Dialogue: 0,0:32:19.81,0:32:22.39,Default,,0,0,0,,Уф! Керемет жел!
Dialogue: 0,0:32:22.48,0:32:23.52,Default,,0,0,0,,Мұны байыппен орындаңыз
Dialogue: 0,0:32:25.19,0:32:27.82,Default,,0,0,0,,(Тұрақты фирманың дауысы)
Dialogue: 0,0:32:27.90,0:32:29.03,Default,,0,0,0,,Бұл қауіпті! Ой!
Dialogue: 0,0:32:32.70,0:32:33.57,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:32:38.45,0:32:40.62,Default,,0,0,0,,Ой ой! Бестіктер?
Dialogue: 0,0:32:40.70,0:32:42.62,Default,,0,0,0,,Жоқ... бұл КЕЛЕСІ қабілет.
Dialogue: 0,0:32:43.21,0:32:45.88,Default,,0,0,0,,Қалжыңдап тұр Уау, мен байсалдымын!
Dialogue: 0,0:32:52.05,0:32:53.01,Default,,0,0,0,,Сіз қалай ойлайсыз? Сол
Dialogue: 0,0:32:53.09,0:32:54.76,Default,,0,0,0,,Мен үшін ештеңе жоқ
Dialogue: 0,0:32:54.84,0:32:57.10,Default,,0,0,0,,Мен де осыны сағынып жүрген сияқтымын.
Dialogue: 0,0:32:57.18,0:32:58.81,Default,,0,0,0,,Неге біз бір рет кездеспейміз?
Dialogue: 0,0:32:58.89,0:33:00.06,Default,,0,0,0,,Иә (Көк раушан) Жарайды!
Dialogue: 0,0:33:00.14,0:33:03.52,Default,,0,0,0,,Қазірдің өзінде! Маған итеріп кеткені ұнамайды!
Dialogue: 0,0:33:03.60,0:33:06.85,Default,,0,0,0,,Әйтеуір тербелген дұрыс... А?
Dialogue: 0,0:33:06.94,0:33:08.82,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:33:08.90,0:33:09.90,Default,,0,0,0,,Бұл зейінімді басқа жаққа бұрады, сондықтан кетші.
Dialogue: 0,0:33:09.98,0:33:12.57,Default,,0,0,0,,(ауыр музыка)
Dialogue: 0,0:33:15.36,0:33:17.03,Default,,0,0,0,,Не болды? Ата!
Dialogue: 0,0:33:17.12,0:33:19.78,Default,,0,0,0,,Мынау...
Dialogue: 0,0:33:19.87,0:33:22.04,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:33:22.12,0:33:24.83,Default,,0,0,0,,Күрсін... (Джонни) Бұл ұят.
Dialogue: 0,0:33:24.91,0:33:28.17,Default,,0,0,0,,Мен сені жаңа ғана кездестірдім.
Dialogue: 0,0:33:34.80,0:33:36.72,Default,,0,0,0,,(қорқынышты күлкі)
Dialogue: 0,0:33:36.80,0:33:37.80,Default,,0,0,0,,Саа!
Dialogue: 0,0:33:39.10,0:33:41.01,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:33:41.10,0:33:42.89,Default,,0,0,0,,Сен менімен ойнадың...
Dialogue: 0,0:33:43.64,0:33:45.89,Default,,0,0,0,,Сіздің достарыңыз маңызды.
Dialogue: 0,0:33:47.10,0:33:48.23,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:33:49.48,0:33:51.15,Default,,0,0,0,,Эй... Эй!
Dialogue: 0,0:33:55.99,0:33:58.91,Default,,0,0,0,,Осындай жарқыраған сезім
Dialogue: 0,0:33:58.99,0:34:00.49,Default,,0,0,0,,Мен оны жек көрмеймін.
Dialogue: 0,0:34:00.58,0:34:03.41,Default,,0,0,0,,Онда да кемшіліктер болды ма?
Dialogue: 0,0:34:03.49,0:34:06.54,Default,,0,0,0,,Аа, мен сәлем бердім.
Dialogue: 0,0:34:06.62,0:34:08.50,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:34:11.59,0:34:13.55,Default,,0,0,0,,(терезені қағу)
Dialogue: 0,0:34:13.63,0:34:14.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:14.38,0:34:16.17,Default,,0,0,0,,12-ші көшеге дейін
Dialogue: 0,0:34:16.26,0:34:17.42,Default,,0,0,0,,Иә.
Dialogue: 0,0:34:18.13,0:34:20.85,Default,,0,0,0,,О? Ройс мырза! а?
Dialogue: 0,0:34:22.85,0:34:25.18,Default,,0,0,0,,Бен мені сенімен таныстырды.
Dialogue: 0,0:34:25.27,0:34:27.85,Default,,0,0,0,,Екінші бөлім қайта жалғасқанша өту ретінде
Dialogue: 0,0:34:27.94,0:34:30.44,Default,,0,0,0,,Екінші бөлімді қайта бастауға үміт жоқ.
Dialogue: 0,0:34:30.52,0:34:34.44,Default,,0,0,0,,Кем дегенде 7 ірі компания сізбен келісімшартқа отырмайды.
Dialogue: 0,0:34:34.53,0:34:35.36,Default,,0,0,0,,(Котецудың ащы күлкісі)
Dialogue: 0,0:34:35.44,0:34:36.53,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:34:36.61,0:34:40.03,Default,,0,0,0,,Қазір дүние жүзінде «Hero TV» сияқты бағдарламалар бар.
Dialogue: 0,0:34:40.11,0:34:41.37,Default,,0,0,0,,Жарайды, төтенше жағдайда... аз да болса...
Dialogue: 0,0:34:42.03,0:34:44.62,Default,,0,0,0,,Шындықты қабылдаған дұрыс емес пе?
Dialogue: 0,0:34:45.41,0:34:47.66,Default,,0,0,0,,Мәңгілік армандама
Dialogue: 0,0:34:47.75,0:34:49.54,Default,,0,0,0,,Шындықта ымыраға келу жақсы
Dialogue: 0,0:34:50.12,0:34:52.29,Default,,0,0,0,,Менің ойымша, бұл сізге арналған.
Dialogue: 0,0:34:54.30,0:34:56.92,Default,,0,0,0,,Қараңызшы, бұл сыйлық!
Dialogue: 0,0:34:57.01,0:34:57.55,Default,,0,0,0,,(Балалардың қуаныш дауыстары)
Dialogue: 0,0:34:57.63,0:35:00.01,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:35:00.09,0:35:01.18,Default,,0,0,0,,Жұмысыңыз қалай болды?
Dialogue: 0,0:35:01.26,0:35:02.51,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:35:03.18,0:35:05.52,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:35:15.78,0:35:17.03,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:35:25.37,0:35:28.16,Default,,0,0,0,,Күтілгендей! Сыбыс шындыққа айналды
Dialogue: 0,0:35:29.04,0:35:31.96,Default,,0,0,0,,Сен жиіркеніштісің, Натан!
Dialogue: 0,0:35:32.58,0:35:34.79,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:35:34.88,0:35:36.21,Default,,0,0,0,,(гипервентиляциялық дауыс)
Dialogue: 0,0:35:39.55,0:35:41.30,Default,,0,0,0,,Сонда ол мәңгілікке осылай қалады ма?
Dialogue: 0,0:35:41.38,0:35:45.26,Default,,0,0,0,,Ми толқындары таяз гипноздық күйге ұқсайды.
Dialogue: 0,0:35:45.35,0:35:48.35,Default,,0,0,0,,Ояну-оянбау өз еркіңізде деп ойлаймын.
Dialogue: 0,0:35:48.98,0:35:52.23,Default,,0,0,0,,Басқа құрбандарда Өрт эмблемасы сияқты белгілер бар.
Dialogue: 0,0:35:52.31,0:35:55.11,Default,,0,0,0,,Әлі ешкім есін жиған жоқ.
Dialogue: 0,0:35:55.19,0:35:56.44,Default,,0,0,0,,(ауырсыну сияқты)
Dialogue: 0,0:35:56.52,0:35:57.86,Default,,0,0,0,,Ұйқы ауруы...
Dialogue: 0,0:35:57.94,0:36:00.86,Default,,0,0,0,,Енді бұл аңыз сияқты.
Dialogue: 0,0:36:00.95,0:36:02.36,Default,,0,0,0,,Олар қандай?
Dialogue: 0,0:36:02.95,0:36:04.20,Default,,0,0,0,,Сіз нені мақсат етесіз?
Dialogue: 0,0:36:04.28,0:36:06.12,Default,,0,0,0,,Сіз әлемді түзетуге тырысасыз ба?
Dialogue: 0,0:36:06.20,0:36:07.45,Default,,0,0,0,,Әлеуметтік реформа?
Dialogue: 0,0:36:07.95,0:36:09.25,Default,,0,0,0,,Аңызда құдай
Dialogue: 0,0:36:09.33,0:36:13.08,Default,,0,0,0,,Адамдарды тәубеге келтіру үшін апаттар туғызды.
Dialogue: 0,0:36:13.17,0:36:16.42,Default,,0,0,0,,Оқиғалар қатарында адам өлімі болмағанын ескере отырып,
Dialogue: 0,0:36:17.09,0:36:18.42,Default,,0,0,0,,Қылмыскер деп ойладыңыз ба?
Dialogue: 0,0:36:18.92,0:36:20.42,Default,,0,0,0,,Ей, тыңда—
Dialogue: 0,0:36:20.51,0:36:23.34,Default,,0,0,0,,Сонда бұл құдай не істейді?
Dialogue: 0,0:36:23.43,0:36:24.39,Default,,0,0,0,,Аңыз бойынша
Dialogue: 0,0:36:24.47,0:36:27.01,Default,,0,0,0,,ше? Сіз білмейсіз бе?
Dialogue: 0,0:36:27.10,0:36:28.64,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:36:28.72,0:36:31.14,Default,,0,0,0,,Мен бұл қаладан емеспін.
Dialogue: 0,0:36:31.23,0:36:32.14,Default,,0,0,0,,-де? не?
Dialogue: 0,0:36:35.02,0:36:35.90,Default,,0,0,0,,Богинядан⸺
Dialogue: 0,0:36:35.98,0:36:37.90,Default,,0,0,0,,Көптеген илаһи жазалар берілсе де
Dialogue: 0,0:36:38.73,0:36:41.65,Default,,0,0,0,,Әлі күнге дейін дұрыс ақылға ие болудан бас тартатын адамдар
Dialogue: 0,0:36:42.24,0:36:45.03,Default,,0,0,0,,Ақырында құдай бәрін жоққа шығаруға ұмтылады.
Dialogue: 0,0:36:45.11,0:36:48.74,Default,,0,0,0,,Біз үлкен шұңқыр қазамыз, ол қараңғы және бүкіл қаланы жауып алатындай терең.
Dialogue: 0,0:36:49.49,0:36:51.58,Default,,0,0,0,,Қала тұрғындарын қараңғылық басты.
Dialogue: 0,0:36:51.66,0:36:55.25,Default,,0,0,0,,Сол жерде мен алғаш рет өзімнің ұсқынсыз әрекеттеріме өкіндім.
Dialogue: 0,0:36:55.33,0:36:57.67,Default,,0,0,0,,Менде әділдік жүрегім пайда бола бастады.
Dialogue: 0,0:36:57.75,0:36:58.84,Default,,0,0,0,,Бұл не өзі! Олар кішірейіп кеткен—
Dialogue: 0,0:36:58.92,0:37:02.22,Default,,0,0,0,,Сонда келесі жолы қалашықта тесік болады ма?
Dialogue: 0,0:37:02.30,0:37:03.84,Default,,0,0,0,,Куу!
Dialogue: 0,0:37:03.93,0:37:05.64,Default,,0,0,0,,(қатты дыбыс)
Dialogue: 0,0:37:06.68,0:37:09.64,Default,,0,0,0,,Жұмбақ қарияның адамдарды ұйықтататын қасиеті бар дейді.
Dialogue: 0,0:37:09.72,0:37:12.64,Default,,0,0,0,,Боксшыға ұқсайтын жігіт дыбыспен айналысты, солай ма?
Dialogue: 0,0:37:12.73,0:37:13.77,Default,,0,0,0,,О
Dialogue: 0,0:37:13.85,0:37:16.60,Default,,0,0,0,,Бұл дыбыс қатары сөзсіз сол жігіт.
Dialogue: 0,0:37:17.19,0:37:19.23,Default,,0,0,0,,Әйелдің қабілеті клон ба?
Dialogue: 0,0:37:19.82,0:37:21.86,Default,,0,0,0,,Бәйбішенің көлеңкесі ғана жұмбақ.
Dialogue: 0,0:37:22.57,0:37:24.36,Default,,0,0,0,,Бұл шынымен әлемді реформалау туралы ма?
Dialogue: 0,0:37:24.86,0:37:25.99,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:37:26.07,0:37:28.74,Default,,0,0,0,,Ертең бәрі түсінікті болады
Dialogue: 0,0:37:29.33,0:37:32.45,Default,,0,0,0,,Ертең құдайы қалаға үлкен шұңқыр жасады делінетін күн.
Dialogue: 0,0:37:32.95,0:37:34.41,Default,,0,0,0,,Өйткені бұл әділет күні.
Dialogue: 0,0:37:37.50,0:37:38.46,Default,,0,0,0,,«Әділет фестивалі»
Dialogue: 0,0:37:38.46,0:37:40.00,Default,,0,0,0,,«Әділет фестивалі»
Dialogue: 0,0:37:38.46,0:37:40.00,Default,,0,0,0,,Міне, биыл да әділет күні.
Dialogue: 0,0:37:40.00,0:37:40.46,Default,,0,0,0,,Міне, биыл да әділет күні.
Dialogue: 0,0:37:40.54,0:37:42.13,Default,,0,0,0,,Неше түрлі заттар бар.
Dialogue: 0,0:37:42.21,0:37:43.05,Default,,0,0,0,,Иә
Dialogue: 0,0:37:43.13,0:37:46.38,Default,,0,0,0,,Бұл аңызға айналған күнді тойлайтын үлкен оқиға.
Dialogue: 0,0:37:46.47,0:37:48.43,Default,,0,0,0,,Мен де баяғыда кездесуге бардым.
Dialogue: 0,0:37:49.22,0:37:50.05,Default,,0,0,0,,Баршаңыз!
Dialogue: 0,0:37:50.14,0:37:53.18,Default,,0,0,0,,Осы жылы бізге тағы да келіңіз!
Dialogue: 0,0:37:53.27,0:37:53.81,Default,,0,0,0,,«Батыр бизнес бөлімі»
Dialogue: 0,0:37:53.81,0:37:54.93,Default,,0,0,0,,«Батыр бизнес бөлімі»
Dialogue: 0,0:37:53.81,0:37:54.93,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:37:54.93,0:37:55.02,Default,,0,0,0,,«Батыр бизнес бөлімі»
Dialogue: 0,0:37:55.02,0:37:56.06,Default,,0,0,0,,«Батыр бизнес бөлімі»
Dialogue: 0,0:37:55.02,0:37:56.06,Default,,0,0,0,,Иә, әлі де этикалық мәселелер бар.
Dialogue: 0,0:37:56.06,0:37:58.56,Default,,0,0,0,,Иә, әлі де этикалық мәселелер бар.
Dialogue: 0,0:37:59.15,0:38:00.56,Default,,0,0,0,,иесіне айтыңыз
Dialogue: 0,0:38:01.07,0:38:03.23,Default,,0,0,0,,Қосымша сұрақтарыңыз болса, көмектесіңіз.
Dialogue: 0,0:38:03.32,0:38:05.07,Default,,0,0,0,,Біреуін қалайсыз ба? (Виргили) Иә?
Dialogue: 0,0:38:05.95,0:38:07.57,Default,,0,0,0,,Барлық қызметкерлер
Dialogue: 0,0:38:07.66,0:38:09.95,Default,,0,0,0,,Шнайдер мырзаның басқару философиясына күмәніңіз бар ма?
Dialogue: 0,0:38:09.95,0:38:11.24,Default,,0,0,0,,Шнайдер мырзаның басқару философиясына күмәніңіз бар ма?
Dialogue: 0,0:38:09.95,0:38:11.24,Default,,0,0,0,,«Марк Шнайдер»
Dialogue: 0,0:38:11.99,0:38:14.25,Default,,0,0,0,,Ең дұрысы, соңы болмайды.
Dialogue: 0,0:38:22.30,0:38:25.09,Default,,0,0,0,,"Ей! Артыңызда маринадталған қиярды қалдырмаңыз!"
Dialogue: 0,0:38:26.55,0:38:28.47,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:38:28.55,0:38:30.97,Default,,0,0,0,,Әрбір жаңалық фестиваль ерекшелігі болып табылады
Dialogue: 0,0:38:31.05,0:38:33.93,Default,,0,0,0,,Олай болса, ертең көрермендердің рейтингі көтеріледі.
Dialogue: 0,0:38:34.02,0:38:35.35,Default,,0,0,0,,Аудитория рейтингтері алдында
Dialogue: 0,0:38:35.43,0:38:38.31,Default,,0,0,0,,Біздің батыр екенімізді ұмытпа.
Dialogue: 0,0:38:38.39,0:38:40.02,Default,,0,0,0,,Бұл тағы да осында
Dialogue: 0,0:38:40.10,0:38:42.11,Default,,0,0,0,,Кіші, сен жассың.
Dialogue: 0,0:38:42.19,0:38:44.78,Default,,0,0,0,,Сен кейде қарт адамдай сөйлейсің.
Dialogue: 0,0:38:44.86,0:38:46.24,Default,,0,0,0,,ше? Мүмкін
Dialogue: 0,0:38:46.32,0:38:47.74,Default,,0,0,0,,Бұрынғы серіктестің әсері?
Dialogue: 0,0:38:49.24,0:38:51.49,Default,,0,0,0,,Өзіңді ол жігітпен салыстырма.
Dialogue: 0,0:38:51.57,0:38:53.95,Default,,0,0,0,,Мен менмін! Алтын Райан!
Dialogue: 0,0:38:54.54,0:38:56.25,Default,,0,0,0,,Мен салыстырып отырған жоқпын.
Dialogue: 0,0:38:56.33,0:38:59.54,Default,,0,0,0,,Енді ол адам мен менің арамызда ешқандай қатынас жоқ.
Dialogue: 0,0:39:00.17,0:39:01.54,Default,,0,0,0,,жақсы болар еді, бірақ...
Dialogue: 0,0:39:04.38,0:39:05.21,Default,,0,0,0,,«Жабайы жолбарыстың басты беті»
Dialogue: 0,0:39:05.30,0:39:06.13,Default,,0,0,0,,"Батыр керек пе? Бізге қазір қоңырау шалыңыз!"
Dialogue: 0,0:39:06.21,0:39:07.05,Default,,0,0,0,,«Хабарларды тексеру»
Dialogue: 0,0:39:08.38,0:39:09.63,Default,,0,0,0,,«Жаңа хабарламалар жоқ»
Dialogue: 0,0:39:09.72,0:39:10.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:11.47,0:39:12.72,Default,,0,0,0,,(үлкен күрсіну)
Dialogue: 0,0:39:14.89,0:39:16.47,Default,,0,0,0,,Бірақ мені мазалайтыны сол
Dialogue: 0,0:39:16.56,0:39:19.31,Default,,0,0,0,,Өрт эмблемасы әлі ессіз.
Dialogue: 0,0:39:19.39,0:39:20.81,Default,,0,0,0,,Не? (Кастер) Тезірек⸺
Dialogue: 0,0:39:20.90,0:39:23.31,Default,,0,0,0,,Мен сені жақсы көргім келеді.
Dialogue: 0,0:39:23.40,0:39:25.73,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:39:39.83,0:39:42.46,Default,,0,0,0,,(бөлшектелген дыбыс)
Dialogue: 0,0:39:51.51,0:39:52.80,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:39:53.51,0:39:54.35,Default,,0,0,0,,Міне, осында!
Dialogue: 0,0:39:55.22,0:39:56.89,Default,,0,0,0,,Сіз қалай ойлайсыз? жағдай
Dialogue: 0,0:39:56.97,0:39:58.35,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:40:00.10,0:40:01.89,Default,,0,0,0,,Сіз қазір такси жүргізесіз бе?
Dialogue: 0,0:40:02.44,0:40:04.73,Default,,0,0,0,,Не? (Карина) Бұл интернетте жазылған.
Dialogue: 0,0:40:04.81,0:40:08.03,Default,,0,0,0,,А-а... а-а, бәлеге қаларсың.
Dialogue: 0,0:40:08.11,0:40:10.99,Default,,0,0,0,,Мен қазірдің өзінде барлығы туралы жазып жатырмын.
Dialogue: 0,0:40:11.57,0:40:14.57,Default,,0,0,0,,Өлгенше батыр боламын дедім.
Dialogue: 0,0:40:14.66,0:40:16.99,Default,,0,0,0,,Оны жұртшылық қабылдамайды.
Dialogue: 0,0:40:17.08,0:40:19.12,Default,,0,0,0,,Дүние... бәрібір.
Dialogue: 0,0:40:19.91,0:40:22.12,Default,,0,0,0,,Мен кішкентай кезімде солай ойлайтынмын.
Dialogue: 0,0:40:22.62,0:40:25.42,Default,,0,0,0,,Шындық кешірмейді.
Dialogue: 0,0:40:26.63,0:40:27.96,Default,,0,0,0,,Мына қоян жігіт...
Dialogue: 0,0:40:28.46,0:40:30.76,Default,,0,0,0,,«ақша, ақша» деп айтуды жалғастырыңыз
Dialogue: 0,0:40:30.84,0:40:32.30,Default,,0,0,0,,Батыр ретінде мұндай нәрсе
Dialogue: 0,0:40:32.38,0:40:34.22,Default,,0,0,0,,Мен басқаша болуы мүмкін деп ойладым.
Dialogue: 0,0:40:34.80,0:40:38.56,Default,,0,0,0,,Маған қарағанда, сіз шындықты дұрыс көріп тұрсыз.
Dialogue: 0,0:40:38.64,0:40:40.77,Default,,0,0,0,,Мен мүлде түсінбеймін! (Котецу) Иә?
Dialogue: 0,0:40:40.85,0:40:43.81,Default,,0,0,0,,Сіз ол туралы не байқадыңыз?
Dialogue: 0,0:40:43.89,0:40:46.81,Default,,0,0,0,,Барнаби өз мұраттарына ұмтылуда!
Dialogue: 0,0:40:47.40,0:40:49.82,Default,,0,0,0,,Әділет фестивалінің кеңсесінде...
Dialogue: 0,0:40:49.90,0:40:50.44,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:40:50.53,0:40:52.45,Default,,0,0,0,,Бұл парадқа билет.
Dialogue: 0,0:40:52.95,0:40:53.78,Default,,0,0,0,,Иә
Dialogue: 0,0:40:53.86,0:40:55.66,Default,,0,0,0,,Көк раушан да сыйлық па?
Dialogue: 0,0:40:55.74,0:40:58.53,Default,,0,0,0,,Батырлардың бәрі мейірімді, солай емес пе?
Dialogue: 0,0:40:58.62,0:40:59.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:59.91,0:41:01.16,Default,,0,0,0,,Шындығында, өткен күні
Dialogue: 0,0:41:01.25,0:41:04.58,Default,,0,0,0,,Барнаби мырза балалар үйінің балаларын шақырғысы келеді.
Dialogue: 0,0:41:06.75,0:41:08.34,Default,,0,0,0,,Маверик оқиғасынан кейін
Dialogue: 0,0:41:08.42,0:41:11.55,Default,,0,0,0,,Мен сияқты ата-анасы жоқ балаларға көмектескім келеді.
Dialogue: 0,0:41:11.63,0:41:13.09,Default,,0,0,0,,Сіз көп нәрсені істеп жатқан сияқтысыз.
Dialogue: 0,0:41:13.17,0:41:16.76,Default,,0,0,0,,Қоян неге ақшаға ерекше көңіл бөлді...
Dialogue: 0,0:41:17.60,0:41:19.39,Default,,0,0,0,,Неге үндемедің?
Dialogue: 0,0:41:20.93,0:41:23.73,Default,,0,0,0,,Сенің ең жасыратын нәрсең осы.
Dialogue: 0,0:41:24.94,0:41:28.44,Default,,0,0,0,,Ол маған қатты ұқсай бастады.
Dialogue: 0,0:41:30.32,0:41:31.57,Default,,0,0,0,,Жаман Кішкене...
Dialogue: 0,0:41:33.90,0:41:36.32,Default,,0,0,0,,Мен шынымен ақымақпын.
Dialogue: 0,0:41:42.37,0:41:44.66,Default,,0,0,0,,Бірінші бөлік үшін төлем әртүрлі.
Dialogue: 0,0:41:44.75,0:41:46.83,Default,,0,0,0,,Сенің ойың менен басқаша.
Dialogue: 0,0:41:46.92,0:41:49.04,Default,,0,0,0,,Басқа жолды таңдайтын кез келді
Dialogue: 0,0:41:49.13,0:41:50.67,Default,,0,0,0,,Жаман емес, солай ма?
Dialogue: 0,0:41:56.76,0:41:58.51,Default,,0,0,0,,(Тыныс алу дауысы)
Dialogue: 0,0:42:02.97,0:42:05.60,Default,,0,0,0,,Сенің есі дұрыс па? Қандай патруль
Dialogue: 0,0:42:05.68,0:42:08.69,Default,,0,0,0,,Көп адамдар ертеңгі күнді асыға күтеді.
Dialogue: 0,0:42:08.77,0:42:10.65,Default,,0,0,0,,Ештеңе етпейді, мұны мен жалғыз істеп жатырмын.
Dialogue: 0,0:42:11.23,0:42:13.07,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:42:13.15,0:42:15.74,Default,,0,0,0,,Тек Джуниордың ұнамдылығы артады.
Dialogue: 0,0:42:15.82,0:42:16.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:16.78,0:42:19.70,Default,,0,0,0,,Бір ғана адамның жақсы сезімге ие болуына жол бермеңіз.
Dialogue: 0,0:42:19.78,0:42:20.99,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:42:21.08,0:42:23.16,Default,,0,0,0,,«Мен азаматтарды қорғағым келеді!»
Dialogue: 0,0:42:23.83,0:42:24.66,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:42:25.87,0:42:26.62,Default,,0,0,0,,(жеңіл күрсіну)
Dialogue: 0,0:42:27.92,0:42:29.54,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:42:32.80,0:42:35.17,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:42:37.05,0:42:38.47,Default,,0,0,0,,(ауырсыну сияқты)
Dialogue: 0,0:42:44.39,0:42:46.73,Default,,0,0,0,,Майданнан... әділетті!
Dialogue: 0,0:42:56.07,0:42:58.90,Default,,0,0,0,,«IP Town 9 көшесі»
Dialogue: 0,0:43:01.07,0:43:02.16,Default,,0,0,0,,Әке! (Котецу) Әй?
Dialogue: 0,0:43:02.83,0:43:05.66,Default,,0,0,0,,О! Үйеңкі!
Dialogue: 0,0:43:05.74,0:43:06.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:07.16,0:43:08.83,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:43:08.91,0:43:10.54,Default,,0,0,0,,Мұны істеуді доғарыңыз.
Dialogue: 0,0:43:10.62,0:43:13.09,Default,,0,0,0,,Каэде...!
Dialogue: 0,0:43:13.17,0:43:14.92,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:43:15.00,0:43:17.88,Default,,0,0,0,,Рас! Сіз мен ойлағаннан да жақсы көрінесіз.
Dialogue: 0,0:43:17.97,0:43:21.26,Default,,0,0,0,,Жоқ, мен таң қалдым. Сіз кенеттен келемін дедіңіз.
Dialogue: 0,0:43:21.34,0:43:23.89,Default,,0,0,0,,Иә? Бұл тітіркендіргіш болды ма?
Dialogue: 0,0:43:24.51,0:43:26.39,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес, бірақ...
Dialogue: 0,0:43:26.47,0:43:29.02,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:43:29.10,0:43:30.02,Default,,0,0,0,,(естілмейтін әңгіме)
Dialogue: 0,0:43:36.03,0:43:38.15,Default,,0,0,0,,(көңілді музыка)
Dialogue: 0,0:43:42.74,0:43:43.91,Default,,0,0,0,,«Баста!»
Dialogue: 0,0:43:43.99,0:43:45.41,Default,,0,0,0,,«Сіздің жоғалтуыңыз»
Dialogue: 0,0:43:54.25,0:43:55.96,Default,,0,0,0,,Кеш болды! (Залдағы хабарландыру) Құрметті келушілер
Dialogue: 0,0:43:56.59,0:43:59.47,Default,,0,0,0,,Жақында Әділет шеруі басталады.
Dialogue: 0,0:44:00.72,0:44:01.55,Default,,0,0,0,,Қарап тұрғандар үшін... (Котецу) Эй!
Dialogue: 0,0:44:01.63,0:44:03.72,Default,,0,0,0,,Тез бармасаң, орныңды алады.
Dialogue: 0,0:44:03.80,0:44:06.60,Default,,0,0,0,,Жарайды! Асықпа
Dialogue: 0,0:44:06.68,0:44:09.35,Default,,0,0,0,,Бірақ... (Кэде) Джажаан!
Dialogue: 0,0:44:09.43,0:44:10.27,Default,,0,0,0,,«Әділет фестивалі»
Dialogue: 0,0:44:10.27,0:44:10.89,Default,,0,0,0,,«Әділет фестивалі»
Dialogue: 0,0:44:10.27,0:44:10.89,Default,,0,0,0,,Трибуна?
Dialogue: 0,0:44:10.89,0:44:10.98,Default,,0,0,0,,Трибуна?
Dialogue: 0,0:44:10.98,0:44:12.10,Default,,0,0,0,,Трибуна?
Dialogue: 0,0:44:10.98,0:44:12.10,Default,,0,0,0,,«Трибуна»
Dialogue: 0,0:44:12.77,0:44:14.98,Default,,0,0,0,,Көк раушан мырза мен үшін алды.
Dialogue: 0,0:44:15.48,0:44:16.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:17.19,0:44:18.57,Default,,0,0,0,,Шынымды айтсам
Dialogue: 0,0:44:19.07,0:44:22.78,Default,,0,0,0,,Әкемді осылай қарсы ал деп айтқан кісі.
Dialogue: 0,0:44:23.28,0:44:24.37,Default,,0,0,0,,Мен...
Dialogue: 0,0:44:24.95,0:44:26.99,Default,,0,0,0,,Сонымен, оның кеңсесіне...
Dialogue: 0,0:44:32.79,0:44:33.71,Default,,0,0,0,,А... енді ойлап қарасам
Dialogue: 0,0:44:34.29,0:44:37.04,Default,,0,0,0,,Үйге тапсырма Не болды? күн өлеңі
Dialogue: 0,0:44:37.54,0:44:38.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:39.21,0:44:41.38,Default,,0,0,0,,Сізде талант жоқ, солай ма?
Dialogue: 0,0:44:41.88,0:44:43.26,Default,,0,0,0,,Қанша еліктесең де
Dialogue: 0,0:44:43.34,0:44:46.64,Default,,0,0,0,,Мен мұғалімнің жоғарғы ұсынысы сияқты күрделі нәрсені жаза алмаймын.
Dialogue: 0,0:44:47.22,0:44:49.56,Default,,0,0,0,,Еліктейтін ештеңе жоқ.
Dialogue: 0,0:44:49.64,0:44:52.31,Default,,0,0,0,,Бірақ осылайша жақсырақ баға ала аласыз.
Dialogue: 0,0:44:53.60,0:44:55.44,Default,,0,0,0,,Мен не жазғым келеді
Dialogue: 0,0:44:55.52,0:44:58.19,Default,,0,0,0,,Адал жазған дұрыс емес пе?
Dialogue: 0,0:44:58.94,0:45:01.32,Default,,0,0,0,,Қолыңнан келгенін істе
Dialogue: 0,0:45:01.40,0:45:03.40,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:45:04.20,0:45:06.20,Default,,0,0,0,,Әкем мұны көптен бері істеп жүр.
Dialogue: 0,0:45:07.03,0:45:09.24,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:45:09.99,0:45:11.12,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:45:11.20,0:45:12.45,Default,,0,0,0,,Не?
Dialogue: 0,0:45:12.96,0:45:15.12,Default,,0,0,0,,Қазір өзіңіз қалаған нәрсені істеп жатырсыз ба?
Dialogue: 0,0:45:15.21,0:45:17.46,Default,,0,0,0,,Сіз қолыңыздан келгенін істеп жатырсыз ба?
Dialogue: 0,0:45:17.54,0:45:18.88,Default,,0,0,0,,Іс жүзінде бүгін де
Dialogue: 0,0:45:18.96,0:45:21.42,Default,,0,0,0,,Батырлар туралы ойланбадың ба?
Dialogue: 0,0:45:23.17,0:45:26.43,Default,,0,0,0,,Жарқын болуға мәжбүрлесең де, бұл анық болмайды.
Dialogue: 0,0:45:26.51,0:45:27.39,Default,,0,0,0,,А...
Dialogue: 0,0:45:27.47,0:45:30.31,Default,,0,0,0,,Бұл қиын, мен білмеймін.
Dialogue: 0,0:45:30.39,0:45:32.68,Default,,0,0,0,,Батыр Егер сіз мұны істегіңіз келсе, оны жасаңыз.
Dialogue: 0,0:45:33.18,0:45:35.98,Default,,0,0,0,,Менің ойымша, бұл ең әкеге ұқсайтын нәрсе.
Dialogue: 0,0:45:36.60,0:45:37.86,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:45:38.48,0:45:40.27,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:45:40.77,0:45:43.49,Default,,0,0,0,,Бірдеңе болып қалса да, бәрі жақсы, себебі ол КЕЛЕСІ.
Dialogue: 0,0:45:44.49,0:45:46.24,Default,,0,0,0,,Тез жүр!
Dialogue: 0,0:45:51.41,0:45:53.87,Default,,0,0,0,,Сіз анаңызға ұқсай бастадыңыз. (Кэде) Иә?
Dialogue: 0,0:45:55.33,0:45:58.50,Default,,0,0,0,,Томо да әкемді осылай қолдады.
Dialogue: 0,0:45:59.59,0:46:00.50,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:46:01.21,0:46:02.25,Default,,0,0,0,,Рақмет.
Dialogue: 0,0:46:02.34,0:46:03.55,Default,,0,0,0,,Ооо... ой...!
Dialogue: 0,0:46:03.63,0:46:05.13,Default,,0,0,0,,Ах! Егер сізге бірдеңе керек болса, маған қоңырау шалыңыз ...
Dialogue: 0,0:46:05.22,0:46:07.01,Default,,0,0,0,,Алға! (Котецу) Иә.
Dialogue: 0,0:46:10.60,0:46:13.56,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:46:21.15,0:46:22.07,Default,,0,0,0,,«Әділет күні»
Dialogue: 0,0:46:25.03,0:46:26.57,Default,,0,0,0,,(аудитория тобы)
Dialogue: 0,0:46:34.37,0:46:35.70,Default,,0,0,0,,«Қауіп»
Dialogue: 0,0:46:39.08,0:46:41.54,Default,,0,0,0,,Барлығы сондай көңілді.
Dialogue: 0,0:46:41.63,0:46:43.00,Default,,0,0,0,,Зейінді болыңыз
Dialogue: 0,0:46:46.76,0:46:48.68,Default,,0,0,0,,Ей, бұл керемет!
Dialogue: 0,0:46:49.18,0:46:50.18,Default,,0,0,0,,Уау! (Мурамаса) Мүлдем...
Dialogue: 0,0:46:50.80,0:46:53.60,Default,,0,0,0,,Сіз не істемексіз? Котецудың жігіті
Dialogue: 0,0:46:53.68,0:46:57.14,Default,,0,0,0,,Олар ресми түрде батыр деп танылған жоқ па?
Dialogue: 0,0:46:57.23,0:46:58.31,Default,,0,0,0,,...
Dialogue: 0,0:46:58.89,0:47:00.44,Default,,0,0,0,,Егер сіздің әкеңіз
Dialogue: 0,0:47:02.36,0:47:04.82,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:47:14.37,0:47:16.25,Default,,0,0,0,,Ой! Қайдан кірді... Уау!
Dialogue: 0,0:47:16.33,0:47:19.21,Default,,0,0,0,,(Кашаның мазақ еткен дауысы)
Dialogue: 0,0:47:19.29,0:47:20.87,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:47:21.88,0:47:23.38,Default,,0,0,0,,Сен қандайсың!
Dialogue: 0,0:47:30.30,0:47:31.51,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:47:31.59,0:47:32.43,Default,,0,0,0,,Бонжур батыры!
Dialogue: 0,0:47:32.51,0:47:33.80,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:47:34.64,0:47:36.39,Default,,0,0,0,,Табылған жағдайда оны дереу бекітіңіз!
Dialogue: 0,0:47:36.47,0:47:37.64,Default,,0,0,0,,Жарылыспен шешіңіз!
Dialogue: 0,0:47:39.35,0:47:40.52,Default,,0,0,0,,О! (Барнаби) Иә!
Dialogue: 0,0:47:40.60,0:47:42.02,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:47:42.10,0:47:44.02,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:47:52.61,0:47:55.03,Default,,0,0,0,,(Әйелдердің таңданған дауыстары)
Dialogue: 0,0:47:58.75,0:48:00.12,Default,,0,0,0,,(Адамдардың қорқып тұрған дыбысы)
Dialogue: 0,0:48:06.84,0:48:08.63,Default,,0,0,0,,(Адамдардың дүрбелең дауысы)
Dialogue: 0,0:48:21.35,0:48:22.64,Default,,0,0,0,,Барлығына! тыныштал!
Dialogue: 0,0:48:24.15,0:48:26.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:48:28.19,0:48:29.99,Default,,0,0,0,,Олар қайда?
Dialogue: 0,0:48:30.07,0:48:32.15,Default,,0,0,0,,Мұнда асығыңыз! (Кэде) Иә!
Dialogue: 0,0:48:35.41,0:48:37.91,Default,,0,0,0,,Каэде!
Dialogue: 0,0:48:43.00,0:48:45.08,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:48:50.34,0:48:51.97,Default,,0,0,0,,Жер асты басқару бөлмесіне шабуыл жасалды.
Dialogue: 0,0:48:52.05,0:48:54.43,Default,,0,0,0,,Жерде пайда болған жерді көздеп, ату.
Dialogue: 0,0:48:57.97,0:49:00.68,Default,,0,0,0,,Ой! Жоқ, продюсер!
Dialogue: 0,0:49:00.77,0:49:02.10,Default,,0,0,0,,Барнаби?
Dialogue: 0,0:49:03.35,0:49:04.65,Default,,0,0,0,,Каэде-чан!
Dialogue: 0,0:49:04.73,0:49:06.65,Default,,0,0,0,,Сен мұнда не үшін келдің? (Алтын Райан) Жас ханым
Dialogue: 0,0:49:06.73,0:49:08.40,Default,,0,0,0,,Сіз күдікті адамдарды көрдіңіз бе?
Dialogue: 0,0:49:08.48,0:49:09.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:09.90,0:49:11.90,Default,,0,0,0,,Иә! Бұл жерде өте күдікті нәрсе бар!
Dialogue: 0,0:49:12.86,0:49:14.57,Default,,0,0,0,,Мен сені сағындым!
Dialogue: 0,0:49:14.66,0:49:17.07,Default,,0,0,0,,Қауіпсіз жерге тез жетіңіз!
Dialogue: 0,0:49:20.33,0:49:22.04,Default,,0,0,0,,Күтілгендей, бұл жақсы.
Dialogue: 0,0:49:23.75,0:49:27.21,Default,,0,0,0,,Эй, сен маған күмәндандың, солай ма?
Dialogue: 0,0:49:27.29,0:49:28.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:28.13,0:49:31.21,Default,,0,0,0,,Шыны керек, мен қаладағы шұңқырды жарып жіберемін бе деп қорқамын.
Dialogue: 0,0:49:31.30,0:49:32.30,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:49:32.38,0:49:34.88,Default,,0,0,0,,Эй, абай бол.
Dialogue: 0,0:49:34.97,0:49:37.89,Default,,0,0,0,,Сіз оны бетіңізде аздап көрсететін типсіз.
Dialogue: 0,0:49:37.97,0:49:40.01,Default,,0,0,0,,Райан мен Барнаби қылмыскерді табады
Dialogue: 0,0:49:40.60,0:49:42.39,Default,,0,0,0,,Барлығына ілесіңіз!
Dialogue: 0,0:49:42.98,0:49:43.64,Default,,0,0,0,,Міне!
Dialogue: 0,0:49:43.73,0:49:46.31,Default,,0,0,0,,Міне, кейіпкер теледидарының тікелей эфирі басталды!
Dialogue: 0,0:49:46.40,0:49:49.11,Default,,0,0,0,,Кейіпкер қазірдің өзінде қылмыскерді аңдып жүр!
Dialogue: 0,0:49:49.19,0:49:50.65,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:49:51.27,0:49:53.57,Default,,0,0,0,,Міне, қылмыстық топ ыдырады!
Dialogue: 0,0:49:53.65,0:49:56.20,Default,,0,0,0,,Батырлар бөлініп, бірін-бірі қуып кететін сияқты!
Dialogue: 0,0:49:56.70,0:49:58.45,Default,,0,0,0,,Бірақ Көк раушан әлі еш жерде көрінбейді.
Dialogue: 0,0:49:58.45,0:49:59.99,Default,,0,0,0,,Бірақ Көк раушан әлі еш жерде көрінбейді.
Dialogue: 0,0:49:58.45,0:49:59.99,Default,,0,0,0,,«Көк раушанның қолы жоқ»
Dialogue: 0,0:49:59.99,0:50:00.58,Default,,0,0,0,,Бірақ Көк раушан әлі еш жерде көрінбейді.
Dialogue: 0,0:50:01.41,0:50:03.58,Default,,0,0,0,,Барлығыңызды өтінемін!
Dialogue: 0,0:50:03.66,0:50:05.71,Default,,0,0,0,,(Қатты дауыс)
Dialogue: 0,0:50:05.79,0:50:07.67,Default,,0,0,0,,Өтірік! күте тұрыңыз!
Dialogue: 0,0:50:07.75,0:50:09.75,Default,,0,0,0,,Өтінемін... тынышталыңыз!
Dialogue: 0,0:50:09.84,0:50:11.00,Default,,0,0,0,,(жарылыс дыбысы)
Dialogue: 0,0:50:13.59,0:50:14.76,Default,,0,0,0,,Сіз!
Dialogue: 0,0:50:14.84,0:50:17.34,Default,,0,0,0,,Бұны маған қалдыр да, қылмыскерге асығыңыз!
Dialogue: 0,0:50:17.43,0:50:19.85,Default,,0,0,0,,Мен бұлай ұстай алмаймын!
Dialogue: 0,0:50:19.93,0:50:21.68,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:50:21.76,0:50:23.72,Default,,0,0,0,,Мен біраз уақыт өмір сүре аламын.
Dialogue: 0,0:50:24.39,0:50:25.60,Default,,0,0,0,,Бұл қалай болды...
Dialogue: 0,0:50:26.18,0:50:27.94,Default,,0,0,0,,Көк раушан сізге көп рахмет!
Dialogue: 0,0:50:28.02,0:50:28.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:29.77,0:50:31.82,Default,,0,0,0,,Сізге рахмет, мен ояндым.
Dialogue: 0,0:50:33.65,0:50:35.65,Default,,0,0,0,,Қараңдар! Тез жүріңіз!
Dialogue: 0,0:50:36.15,0:50:37.78,Default,,0,0,0,,Қандай бастық!
Dialogue: 0,0:50:38.28,0:50:39.53,Default,,0,0,0,,Ішің аздап шығып жатқан жоқ па?
Dialogue: 0,0:50:40.78,0:50:41.70,Default,,0,0,0,,Шу шығарыңыз!
Dialogue: 0,0:50:41.78,0:50:43.20,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:50:47.37,0:50:48.83,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:50:48.92,0:50:51.63,Default,,0,0,0,,Мына жақта, ана жақта... А?
Dialogue: 0,0:50:51.71,0:50:53.63,Default,,0,0,0,,(мазақ еткен дауыс)
Dialogue: 0,0:50:53.71,0:50:54.34,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:50:55.26,0:50:57.84,Default,,0,0,0,,Әдеттегідей, мен мұны толқумен орындауға рұқсат етіңіз.
Dialogue: 0,0:51:01.76,0:51:03.81,Default,,0,0,0,,Мен сенің қашуыңа ешқашан жол бермеймін!
Dialogue: 0,0:51:03.89,0:51:05.60,Default,,0,0,0,,(мазақ еткен дауыс)
Dialogue: 0,0:51:05.68,0:51:07.31,Default,,0,0,0,,Сен батыл баласың.
Dialogue: 0,0:51:07.39,0:51:10.56,Default,,0,0,0,,Мені жалғыз сынауға қалай дәтің бар?
Dialogue: 0,0:51:10.65,0:51:11.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:12.11,0:51:13.82,Default,,0,0,0,,Мен де сондамын ба?
Dialogue: 0,0:51:13.90,0:51:17.07,Default,,0,0,0,,(велосипедтің қону дыбысы)
Dialogue: 0,0:51:17.15,0:51:20.20,Default,,0,0,0,,Ой! Көк раушан осында!
Dialogue: 0,0:51:17.15,0:51:20.20,Default,,0,0,0,,«Тікелей эфирдегі кейіпкер теледидар»
Dialogue: 0,0:51:21.41,0:51:23.37,Default,,0,0,0,,Мен ол жігітті асығыстықпен жеңемін!
Dialogue: 0,0:51:23.45,0:51:24.49,Default,,0,0,0,,Иә
Dialogue: 0,0:51:25.79,0:51:26.87,Default,,0,0,0,,(ынталы дауыс)
Dialogue: 0,0:51:28.29,0:51:31.83,Default,,0,0,0,,Енді саған ұнайтын нәрсені істеуге рұқсат бермеймін!
Dialogue: 0,0:51:33.21,0:51:36.34,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:51:39.42,0:51:41.34,Default,,0,0,0,,Менің жүрегім құлыптаулы!
Dialogue: 0,0:51:42.09,0:51:44.85,Default,,0,0,0,,Сіздің зұлым істеріңіз толығымен жабылды!
Dialogue: 0,0:51:45.47,0:51:46.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:46.18,0:51:47.43,Default,,0,0,0,,Бұған рұқсат етілмейді
Dialogue: 0,0:51:46.18,0:51:47.43,Default,,0,0,0,,«Көк раушан»
Dialogue: 0,0:51:47.43,0:51:47.52,Default,,0,0,0,,«Көк раушан»
Dialogue: 0,0:51:47.52,0:51:47.93,Default,,0,0,0,,«Көк раушан»
Dialogue: 0,0:51:47.52,0:51:47.93,Default,,0,0,0,,Рок Бизон Көк раушанның қолтаңбасын көшіріп алды!
Dialogue: 0,0:51:47.93,0:51:48.02,Default,,0,0,0,,Рок бизон Көк раушанның қолтаңбасын көшіріп алды!
Dialogue: 0,0:51:48.02,0:51:50.10,Default,,0,0,0,,Рок Бизон Көк раушанның қолтаңбасын көшіріп алды!
Dialogue: 0,0:51:48.02,0:51:50.10,Default,,0,0,0,,«Мен қол қою жолын көшіріп алдым».
Dialogue: 0,0:51:50.10,0:51:51.10,Default,,0,0,0,,Рок бизон Көк раушанның қолтаңбасын көшіріп алды!
Dialogue: 0,0:51:51.19,0:51:54.15,Default,,0,0,0,,Мұндай адамдар жақсы, сондықтан бізге көбірек көрсетіңіз!
Dialogue: 0,0:51:54.23,0:51:55.36,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:51:55.44,0:51:57.48,Default,,0,0,0,,Барлық батырларға бірдей қарайтын код...
Dialogue: 0,0:51:57.57,0:52:00.65,Default,,0,0,0,,Менің барлық шешімдерді қабылдауға құқығым бар.
Dialogue: 0,0:52:00.74,0:52:02.61,Default,,0,0,0,,Менің не айтқым келгенін түсіндіңіз бе?
Dialogue: 0,0:52:03.12,0:52:05.28,Default,,0,0,0,,Бірден сұрау бойынша
Dialogue: 0,0:52:11.83,0:52:14.29,Default,,0,0,0,,Ой! Райан мен Барнаби
Dialogue: 0,0:52:14.38,0:52:16.29,Default,,0,0,0,,Кінәлі бұрышқа қамалды! «Райн мен Барнаби, күдіктілердің бірі қамауға алынды»
Dialogue: 0,0:52:16.96,0:52:18.71,Default,,0,0,0,,Қазір қашып құтыла алмайсың.
Dialogue: 0,0:52:18.80,0:52:19.97,Default,,0,0,0,,Уфуфу…
Dialogue: 0,0:52:20.05,0:52:23.30,Default,,0,0,0,,Бұл оңай... Барғың келе ме?
Dialogue: 0,0:52:32.31,0:52:33.90,Default,,0,0,0,,Бұл қауіпті «Райан мен Барнаби қылмыскермен кескілескен шайқасқа қосылады»
Dialogue: 0,0:52:33.90,0:52:33.98,Default,,0,0,0,,«Райан мен Барнаби қылмыскермен кескілескен шайқасқа қосылады»
Dialogue: 0,0:52:33.98,0:52:36.65,Default,,0,0,0,,«Райан мен Барнаби қылмыскермен кескілескен шайқасқа қатысады» Дөңгелек пышақ нысанды кесіп өтті!
Dialogue: 0,0:52:37.27,0:52:39.53,Default,,0,0,0,,Сүйкімді жүз ғана емес пе?
Dialogue: 0,0:52:39.61,0:52:41.03,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,0:52:41.11,0:52:42.32,Default,,0,0,0,,Мен құрметке бөлендім
Dialogue: 0,0:52:42.40,0:52:44.74,Default,,0,0,0,,Керемет ханзада...
Dialogue: 0,0:52:44.82,0:52:47.20,Default,,0,0,0,,Екеуіңнің маған серік болатыныңа сене алар емеспін.
Dialogue: 0,0:52:51.12,0:52:52.33,Default,,0,0,0,,Охо!
Dialogue: 0,0:52:52.41,0:52:53.96,Default,,0,0,0,,Кіші, сен қай балаға барасың?
Dialogue: 0,0:52:54.04,0:52:55.54,Default,,0,0,0,,Көп сөйлесу!
Dialogue: 0,0:53:06.14,0:53:07.47,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:53:07.55,0:53:11.22,Default,,0,0,0,,Әйелді жеңгіңіз келсе, оған мұқият қарау керек.
Dialogue: 0,0:53:11.31,0:53:14.06,Default,,0,0,0,,Онда мен оны тастаймын.
Dialogue: 0,0:53:14.14,0:53:15.48,Default,,0,0,0,,Екі мағынада!
Dialogue: 0,0:53:17.31,0:53:18.32,Default,,0,0,0,,Доддон!
Dialogue: 0,0:53:25.53,0:53:29.41,Default,,0,0,0,,Уф... Мен бұл жерге жете алмаймын.
Dialogue: 0,0:53:30.29,0:53:34.41,Default,,0,0,0,,Әйелдер жақсы көретін адамдарын зерттейді.
Dialogue: 0,0:53:34.50,0:53:35.46,Default,,0,0,0,,Бакуго-кунға қарсы қандай жоспары барын сұрамақ едім.
Dialogue: 0,0:53:35.54,0:53:38.21,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:53:44.76,0:53:47.05,Default,,0,0,0,,(сыбырлайды)
Dialogue: 0,0:53:51.89,0:53:55.48,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:54:00.07,0:54:01.07,Default,,0,0,0,,Иә! Ах...!
Dialogue: 0,0:54:02.32,0:54:04.78,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:54:06.86,0:54:08.07,Default,,0,0,0,,Ал ол мақтаныш – шайқас мақтанышы, зорлық-зомбылық мақтанышы.
Dialogue: 0,0:54:08.16,0:54:09.74,Default,,0,0,0,,Не болды? Не болды?
Dialogue: 0,0:54:10.49,0:54:13.58,Default,,0,0,0,,Тітіркендіргіш қабілет, оны нашар қолдану
Dialogue: 0,0:54:13.66,0:54:15.83,Default,,0,0,0,,Аспан Сәлем!
Dialogue: 0,0:54:16.75,0:54:18.92,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:54:21.96,0:54:24.63,Default,,0,0,0,,Уф! Модам да!
Dialogue: 0,0:54:24.71,0:54:26.13,Default,,0,0,0,,Менің дыбысымды өшіре алмайсың!
Dialogue: 0,0:54:28.22,0:54:30.35,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:54:33.56,0:54:35.48,Default,,0,0,0,,А, арт жақтан ба?
Dialogue: 0,0:54:35.56,0:54:38.06,Default,,0,0,0,,Қандай лас жігіт.
Dialogue: 0,0:54:43.15,0:54:44.15,Default,,0,0,0,,Сәлем! Йо!
Dialogue: 0,0:54:45.74,0:54:46.74,Default,,0,0,0,,(Ричардтың мазақ еткен күлкісі)
Dialogue: 0,0:54:52.28,0:54:53.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:53.74,0:54:54.58,Default,,0,0,0,,Фу…
Dialogue: 0,0:54:58.04,0:55:01.54,Default,,0,0,0,,Келіңдер, сендерге ештеңе қалмады!
Dialogue: 0,0:55:03.71,0:55:04.88,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:55:04.96,0:55:07.55,Default,,0,0,0,,Сіздің достарыңыз қашып кетеді.
Dialogue: 0,0:55:08.88,0:55:11.72,Default,,0,0,0,,Бұл... бұрын соңды болмаған жағдай.
Dialogue: 0,0:55:11.80,0:55:14.06,Default,,0,0,0,,Origami Cyclone жойылды!
Dialogue: 0,0:55:17.27,0:55:18.27,Default,,0,0,0,,Хмф!
Dialogue: 0,0:55:19.39,0:55:20.40,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:55:34.62,0:55:36.12,Default,,0,0,0,,Енді дайындал!
Dialogue: 0,0:55:36.20,0:55:38.12,Default,,0,0,0,,(Джоннидің қорқынышты күлкісі)
Dialogue: 0,0:55:38.20,0:55:41.71,Default,,0,0,0,,Дайын болу керек адам сен бе?
Dialogue: 0,0:55:42.83,0:55:45.09,Default,,0,0,0,,Міне!
Dialogue: 0,0:55:47.38,0:55:48.76,Default,,0,0,0,,Сааа!
Dialogue: 0,0:55:51.68,0:55:55.14,Default,,0,0,0,,Олар бас тартуда нашар.
Dialogue: 0,0:55:58.02,0:55:59.35,Default,,0,0,0,,Егер сіз қашып кетсеңіз⸺
Dialogue: 0,0:55:59.43,0:56:02.40,Default,,0,0,0,,Сіз мені ұстай алмайсыз
Dialogue: 0,0:56:02.48,0:56:05.52,Default,,0,0,0,,Шулы! Мен сені міндетті түрде ұстаймын!
Dialogue: 0,0:56:05.61,0:56:08.78,Default,,0,0,0,,Иә! Мен Өрт эмблемасы үшін кек аламын!
Dialogue: 0,0:56:08.86,0:56:11.74,Default,,0,0,0,,Жау – жаман тыңдаушы.
Dialogue: 0,0:56:11.82,0:56:14.87,Default,,0,0,0,,Мен ол адам жеңуі керек жарақатмын⸺
Dialogue: 0,0:56:14.95,0:56:16.91,Default,,0,0,0,,Мен сені жаңа ғана ояттым.
Dialogue: 0,0:56:16.99,0:56:19.25,Default,,0,0,0,,ше? (Джонни) Мені жеңгеннен басқа⸺
Dialogue: 0,0:56:19.87,0:56:23.00,Default,,0,0,0,,Оянуға жол жоқ
Dialogue: 0,0:56:23.08,0:56:25.92,Default,,0,0,0,,Енді қашуды доғар!
Dialogue: 0,0:56:26.50,0:56:28.34,Default,,0,0,0,,Сааа!
Dialogue: 0,0:56:28.42,0:56:29.67,Default,,0,0,0,,(кішкентай айқай)
Dialogue: 0,0:56:29.76,0:56:31.80,Default,,0,0,0,,(Тыныссыз дауыс)
Dialogue: 0,0:56:31.88,0:56:33.68,Default,,0,0,0,,Енді жоқ! Маған көмектесіңізші
Dialogue: 0,0:56:34.39,0:56:36.22,Default,,0,0,0,,Маған ешкім көмектеспейді
Dialogue: 0,0:56:36.81,0:56:38.81,Default,,0,0,0,,Сіз жалғыз болуға үйреніп қалдыңыз, солай ма?
Dialogue: 0,0:56:38.89,0:56:40.06,Default,,0,0,0,,(қорқыныш дауысы)
Dialogue: 0,0:56:40.64,0:56:43.14,Default,,0,0,0,,Сіз бәрін шақырдыңыз, солай емес пе?
Dialogue: 0,0:56:43.23,0:56:44.15,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:56:44.23,0:56:46.56,Default,,0,0,0,,Мен оны қамқорлықпен өсірсем де
Dialogue: 0,0:56:46.65,0:56:48.90,Default,,0,0,0,,Сен бізге опасыздық жасадың.
Dialogue: 0,0:56:48.98,0:56:50.15,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:56:50.24,0:56:52.53,Default,,0,0,0,,Сіз неден қатты ұяласыз?
Dialogue: 0,0:56:52.61,0:56:54.03,Default,,0,0,0,,Өзіңіз емес пе?
Dialogue: 0,0:56:55.41,0:56:57.16,Default,,0,0,0,,Олай болса, неге өлмейсің?
Dialogue: 0,0:56:57.24,0:56:58.95,Default,,0,0,0,,(Бір нәрсенің дыбысы)
Dialogue: 0,0:56:59.74,0:57:01.87,Default,,0,0,0,,(қатты айқай)
Dialogue: 0,0:57:01.96,0:57:04.29,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:57:04.37,0:57:06.42,Default,,0,0,0,,Барған сайын күшейіп жатқан жоқ па?
Dialogue: 0,0:57:06.50,0:57:07.71,Default,,0,0,0,,Эй...!
Dialogue: 0,0:57:07.79,0:57:08.50,Default,,0,0,0,,Батырлар: «Бізде әлі күдікті жоқ» дейді.
Dialogue: 0,0:57:08.50,0:57:08.59,Default,,0,0,0,,«Ешбір күдікті әлі қамауға алынған жоқ».
Dialogue: 0,0:57:08.59,0:57:09.84,Default,,0,0,0,,«Бізде әлі күдікті жоқ.» Біз олардың мейіріміне бөленеміз!
Dialogue: 0,0:57:09.84,0:57:09.92,Default,,0,0,0,,«Ешбір күдікті әлі қамауға алынған жоқ».
Dialogue: 0,0:57:09.92,0:57:11.34,Default,,0,0,0,,«Бізде әлі күдікті жоқ». Қылмыскерді әлі де ұстай алмадық.
Dialogue: 0,0:57:11.34,0:57:12.34,Default,,0,0,0,,Қылмыскерді әлі де ұстай алмадық.
Dialogue: 0,0:57:12.84,0:57:16.34,Default,,0,0,0,,Бұл балалар өте көңілді.
Dialogue: 0,0:57:16.85,0:57:18.85,Default,,0,0,0,,Не болды? Жоқ...
Dialogue: 0,0:57:18.93,0:57:22.23,Default,,0,0,0,,Мен ұстандым...
Dialogue: 0,0:57:22.93,0:57:26.23,Default,,0,0,0,,Мен қылмыскерді батыр әдейі қуғандай сезінемін...
Dialogue: 0,0:57:26.81,0:57:29.23,Default,,0,0,0,,Иә? Бұл не үшін?
Dialogue: 0,0:57:29.32,0:57:30.82,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:57:30.90,0:57:32.61,Default,,0,0,0,,Алдаушы болайық
Dialogue: 0,0:57:33.11,0:57:34.90,Default,,0,0,0,,Батырды ұстап тұру
Dialogue: 0,0:57:34.99,0:57:35.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:35.78,0:57:38.12,Default,,0,0,0,,Сонымен не? Бұл жігіттер
Dialogue: 0,0:57:38.20,0:57:41.58,Default,,0,0,0,,Аңызға еліктегіңіз келмей ме?
Dialogue: 0,0:57:42.29,0:57:43.66,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:57:44.25,0:57:46.33,Default,,0,0,0,,Агнеске хабарлаңыз.
Dialogue: 0,0:57:46.42,0:57:48.25,Default,,0,0,0,,Содан мен полицияға бардым.
Dialogue: 0,0:57:48.33,0:57:50.46,Default,,0,0,0,,Ал, көңілдерің көтеріледі деп үміттенемін.
Dialogue: 0,0:57:50.55,0:57:52.38,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:57:52.46,0:57:54.13,Default,,0,0,0,,«Шнайдер»
Dialogue: 0,0:57:54.22,0:57:55.30,Default,,0,0,0,,(кіші ызылдаған дыбыс)
Dialogue: 0,0:57:56.63,0:57:58.30,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:58:01.47,0:58:02.97,Default,,0,0,0,,(Шнайдердің таңданған дауысы)
Dialogue: 0,0:58:06.85,0:58:09.19,Default,,0,0,0,,Не... не? сен...!
Dialogue: 0,0:58:12.11,0:58:13.78,Default,,0,0,0,,Эй... Вирджил! Бен!
Dialogue: 0,0:58:13.86,0:58:16.07,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:58:22.12,0:58:24.54,Default,,0,0,0,,Біреу! Эй! біреу!
Dialogue: 0,0:58:25.29,0:58:26.75,Default,,0,0,0,,Ол туралы бірдеңе жасаңыз!
Dialogue: 0,0:58:27.58,0:58:28.75,Default,,0,0,0,,(Құлау дауысы)
Dialogue: 0,0:58:30.54,0:58:31.67,Default,,0,0,0,,«Ретинальды идентификаторды сканерлеу»
Dialogue: 0,0:58:31.75,0:58:32.75,Default,,0,0,0,,«Жеке куәлік расталған Марк Шнайдер»
Dialogue: 0,0:58:35.05,0:58:36.67,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:58:36.76,0:58:39.26,Default,,0,0,0,,Қазірдің өзінде! Не деген осындай уақытта!
Dialogue: 0,0:58:39.84,0:58:42.14,Default,,0,0,0,,Не болды? (Шнайдер) Агнес!
Dialogue: 0,0:58:42.22,0:58:44.18,Default,,0,0,0,,Батырларды дереу осы жерге жібер!
Dialogue: 0,0:58:44.27,0:58:46.77,Default,,0,0,0,,Иә? (Шнайдер) Маған шабуыл жасалып жатыр.
Dialogue: 0,0:58:46.85,0:58:49.60,Default,,0,0,0,,Кім? (Шнайдер) Бұл менмін! мен!
Dialogue: 0,0:58:49.69,0:58:52.98,Default,,0,0,0,,Мен олардың нысанасы болдым!
Dialogue: 0,0:58:53.07,0:58:54.44,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:58:55.24,0:58:57.36,Default,,0,0,0,,Менің айтқанымды істе!
Dialogue: 0,0:58:57.45,0:59:00.66,Default,,0,0,0,,Мен сені шоудан алып тастауыма қарсы емеспін!
Dialogue: 0,0:59:00.74,0:59:01.74,Default,,0,0,0,,асығыңыз
Dialogue: 0,0:59:01.82,0:59:03.87,Default,,0,0,0,,(рок бизонның мазасыз дауысы)
Dialogue: 0,0:59:04.83,0:59:06.41,Default,,0,0,0,,Не? Шнайдер мырза?
Dialogue: 0,0:59:06.50,0:59:08.33,Default,,0,0,0,,Дұрыс, қазір бас!
Dialogue: 0,0:59:08.92,0:59:10.21,Default,,0,0,0,,Соны айтсаң да
Dialogue: 0,0:59:10.29,0:59:11.83,Default,,0,0,0,,Бұл жағдайда...
Dialogue: 0,0:59:11.92,0:59:13.09,Default,,0,0,0,,(шоктан зардап шегетін дауыс)
Dialogue: 0,0:59:13.67,0:59:15.42,Default,,0,0,0,,Біздің де қолымыздан келмейді!
Dialogue: 0,0:59:20.59,0:59:21.80,Default,,0,0,0,,Мен мұны сізге қалдырамын!
Dialogue: 0,0:59:22.30,0:59:24.68,Default,,0,0,0,,Сәлем! Сен не туралы айтып тұрсың?
Dialogue: 0,0:59:25.27,0:59:26.85,Default,,0,0,0,,Сіз оны дәл қазір естідіңіз бе?
Dialogue: 0,0:59:26.93,0:59:27.73,Default,,0,0,0,,Иесі!
Dialogue: 0,0:59:27.81,0:59:29.19,Default,,0,0,0,,Онда мен барамын!
Dialogue: 0,0:59:29.27,0:59:31.44,Default,,0,0,0,,Бұл өз қорыңызды көтеруге мүмкіндік!
Dialogue: 0,0:59:31.52,0:59:34.61,Default,,0,0,0,,Мен алдауға шыдамаймын!
Dialogue: 0,0:59:40.32,0:59:42.57,Default,,0,0,0,,(Соқтығысқан дыбыс)
Dialogue: 0,0:59:42.66,0:59:43.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:44.53,0:59:47.08,Default,,0,0,0,,Бұл жерден бір адам кетсе де, мен...
Dialogue: 0,0:59:47.16,0:59:48.91,Default,,0,0,0,,Азаматқа қалжың болуы мүмкін
Dialogue: 0,0:59:53.38,0:59:56.17,Default,,0,0,0,,Жоқ... сіздің мақсатыңыз
Dialogue: 0,0:59:56.25,0:59:59.63,Default,,0,0,0,,Эй, Агнес, не болып жатыр? Әзірше емес?
Dialogue: 0,0:59:59.72,1:00:00.97,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:01.05,1:00:03.05,Default,,0,0,0,,Мен де асығып тұрмын.
Dialogue: 0,1:00:03.14,1:00:05.97,Default,,0,0,0,,Не істесең де, асығыс!
Dialogue: 0,1:00:06.06,1:00:08.27,Default,,0,0,0,,Сонда менде бір ой бар.
Dialogue: 0,1:00:08.35,1:00:11.10,Default,,0,0,0,,Жақсы Жақсы! Мен бәрін саған қалдырамын!
Dialogue: 0,1:00:11.19,1:00:12.69,Default,,0,0,0,,Бірдеңе істе!
Dialogue: 0,1:00:11.19,1:00:12.69,Default,,0,0,0,,«Демалыс аймағы»
Dialogue: 0,1:00:12.77,1:00:14.19,Default,,0,0,0,,Иесі…
Dialogue: 0,1:00:15.86,1:00:16.69,Default,,0,0,0,,(Кішкене күрсіну)
Dialogue: 0,1:00:21.11,1:00:21.99,Default,,0,0,0,,Шыу!
Dialogue: 0,1:00:23.24,1:00:24.20,Default,,0,0,0,,(Котецудың табанды дауысы)
Dialogue: 0,1:00:26.16,1:00:28.70,Default,,0,0,0,,(металл прокаттау дыбысы)
Dialogue: 0,1:00:28.79,1:00:29.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:29.75,1:00:31.00,Default,,0,0,0,,Сәлем Жолбарыс? «Агнес Жубер»
Dialogue: 0,1:00:31.08,1:00:33.33,Default,,0,0,0,,Сот бюросының жолдамасы шықты.
Dialogue: 0,1:00:33.42,1:00:35.79,Default,,0,0,0,,2-бөлімнің кейіпкерлері бір күнге ғана оралды!
Dialogue: 0,1:00:35.88,1:00:38.13,Default,,0,0,0,,ше? Неліктен кенеттен? (көтеретін музыка)
Dialogue: 0,1:00:38.21,1:00:41.09,Default,,0,0,0,,Иесі маған бәрін маған қалдыратынын айтты!
Dialogue: 0,1:00:41.17,1:00:42.43,Default,,0,0,0,,Шынымен бе? ?
Dialogue: 0,1:00:42.51,1:00:44.14,Default,,0,0,0,,Мен саған осы жерде жақсы нәрсе көрсетсем
Dialogue: 0,1:00:44.22,1:00:45.97,Default,,0,0,0,,Екінші бөлімнің қайта жандануы мүмкін.
Dialogue: 0,1:00:46.05,1:00:47.35,Default,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,1:00:47.85,1:00:49.89,Default,,0,0,0,,Мен қазір жібере алмаймын
Dialogue: 0,1:00:49.97,1:00:52.19,Default,,0,0,0,,Мұны бізге қалдырыңыз!
Dialogue: 0,1:00:52.27,1:00:53.85,Default,,0,0,0,,Иә? (Sumo Thunder) Сенпай!
Dialogue: 0,1:00:53.94,1:00:55.86,Default,,0,0,0,,Маған оқуға рұқсат етіңіз!
Dialogue: 0,1:00:55.94,1:00:57.73,Default,,0,0,0,,Өтінемін, асығыңыз!
Dialogue: 0,1:01:00.65,1:01:02.78,Default,,0,0,0,,Мен мұны сұрадым! (2-бөлім кейіпкерлері) Иә!
Dialogue: 0,1:01:03.49,1:01:05.62,Default,,0,0,0,,Айтыңызшы, не болды?
Dialogue: 0,1:01:05.70,1:01:07.58,Default,,0,0,0,,Сіз Жолбарысқа сенесіз.
Dialogue: 0,1:01:07.66,1:01:08.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:08.66,1:01:11.50,Default,,0,0,0,,Екінші бөлім мен жоспарлаған жоба!
Dialogue: 0,1:01:11.58,1:01:14.29,Default,,0,0,0,,Оңай езілген болуы керек... Шаку, солай ма?
Dialogue: 0,1:01:15.63,1:01:17.63,Default,,0,0,0,,(Көлік сигналы дыбысы)
Dialogue: 0,1:01:18.96,1:01:20.55,Default,,0,0,0,,О! Бұл болды!
Dialogue: 0,1:01:21.80,1:01:23.68,Default,,0,0,0,,Асығыңыз! Жолбарыс!
Dialogue: 0,1:01:23.76,1:01:25.13,Default,,0,0,0,,Сайто мырза!
Dialogue: 0,1:01:25.22,1:01:27.43,Default,,0,0,0,,(Динамикалық музыка)
Dialogue: 0,1:01:44.82,1:01:45.74,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:01:47.32,1:01:49.37,Default,,0,0,0,,Жабайы үреді!
Dialogue: 0,1:01:50.08,1:01:51.08,Default,,0,0,0,,Барлығың тыңдаңдар!
Dialogue: 0,1:01:51.16,1:01:54.08,Default,,0,0,0,,Мен Жолбарысты бір күнге ғана қайтардым.
Dialogue: 0,1:01:54.16,1:01:56.33,Default,,0,0,0,,Біреудің дәмді нәрсені алып кеткенін қаламасаңыз
Dialogue: 0,1:01:56.42,1:01:58.79,Default,,0,0,0,,Алдыңыздағы нысананы толығымен тазалаңыз!
Dialogue: 0,1:01:58.88,1:02:00.92,Default,,0,0,0,,Жақсы! о!
Dialogue: 0,1:02:01.00,1:02:02.26,Default,,0,0,0,,Мен көптен күттім! Котецу
Dialogue: 0,1:02:02.34,1:02:03.34,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:02:03.42,1:02:04.88,Default,,0,0,0,,Қайтадан қош келдіңіз! жолбарыс
Dialogue: 0,1:02:04.97,1:02:06.76,Default,,0,0,0,,Менің жолымдағы жалғыз нәрсе...
Dialogue: 0,1:02:06.84,1:02:07.84,Default,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,1:02:09.10,1:02:10.64,Default,,0,0,0,,Мен білемін!
Dialogue: 0,1:02:11.39,1:02:13.56,Default,,0,0,0,,Уф... Болды!
Dialogue: 0,1:02:14.18,1:02:16.56,Default,,0,0,0,,Менің көңілімді қалдырыңыз!
Dialogue: 0,1:02:17.31,1:02:20.61,Default,,0,0,0,,Ақша? Қалағанымша ақша дайындаймын
Dialogue: 0,1:02:21.52,1:02:23.36,Default,,0,0,0,,Бар!
Dialogue: 0,1:02:24.99,1:02:27.28,Default,,0,0,0,,Эй, міне!
Dialogue: 0,1:02:28.28,1:02:29.78,Default,,0,0,0,,Тез көмектесіңіз!
Dialogue: 0,1:02:32.79,1:02:33.62,Default,,0,0,0,,Ммм, дәмді!
Dialogue: 0,1:02:34.58,1:02:36.41,Default,,0,0,0,,(Тұрақты фирманың дауысы)
Dialogue: 0,1:02:46.47,1:02:48.55,Default,,0,0,0,,(Котецудың айқайлаған дауысы)
Dialogue: 0,1:02:48.63,1:02:51.55,Default,,0,0,0,,Мұндай қарт не істей алады?
Dialogue: 0,1:02:51.64,1:02:53.81,Default,,0,0,0,,(қатты ыңылдау)
Dialogue: 0,1:02:55.56,1:02:58.56,Default,,0,0,0,,Нокауттың уақыты келді ме?
Dialogue: 0,1:02:58.64,1:03:00.94,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,1:03:01.02,1:03:04.61,Default,,0,0,0,,Ах... сен мені өлтіресің.
Dialogue: 0,1:03:04.69,1:03:06.82,Default,,0,0,0,,Жолбарыс мені мазақ етеді!
Dialogue: 0,1:03:06.90,1:03:09.07,Default,,0,0,0,,(Рух дауысы)
Dialogue: 0,1:03:09.16,1:03:11.16,Default,,0,0,0,,(Көк раушанның кішкентай айқайы)
Dialogue: 0,1:03:13.24,1:03:15.08,Default,,0,0,0,,Орта жастағы адамдар тынымсыз еңбек етсе де
Dialogue: 0,1:03:15.58,1:03:17.58,Default,,0,0,0,,Мен үзіліс жасай алмаймын.
Dialogue: 0,1:03:17.66,1:03:18.96,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,1:03:19.04,1:03:20.50,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,1:03:20.58,1:03:23.25,Default,,0,0,0,,Жүріңдер, сендер де ұйықтаңдар.
Dialogue: 0,1:03:24.00,1:03:29.22,Default,,0,0,0,,Еркек немесе әйел бола алмайтын анау қорқақ сияқты.
Dialogue: 0,1:03:29.30,1:03:31.64,Default,,0,0,0,,Бұл не...?
Dialogue: 0,1:03:31.72,1:03:33.05,Default,,0,0,0,,(мазақ еткен дауыс)
Dialogue: 0,1:03:33.14,1:03:34.72,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,1:03:34.81,1:03:37.31,Default,,0,0,0,,Ата-анасына (анасына) қарамайтындар
Dialogue: 0,1:03:37.39,1:03:39.77,Default,,0,0,0,,Мен соншалықты жаманмын ба?
Dialogue: 0,1:03:39.85,1:03:41.65,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:42.23,1:03:44.15,Default,,0,0,0,,Енді жоқ... жоқ!
Dialogue: 0,1:03:44.23,1:03:47.03,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,1:03:47.11,1:03:50.24,Default,,0,0,0,,Ештеңе... білмесем де!
Dialogue: 0,1:03:50.32,1:03:53.16,Default,,0,0,0,,От мырза туралы жаман сөз айтпа!
Dialogue: 0,1:03:53.74,1:03:54.91,Default,,0,0,0,,Сол сияқты...
Dialogue: 0,1:03:54.99,1:03:56.91,Default,,0,0,0,,Ер адамдай күшті
Dialogue: 0,1:03:57.54,1:04:00.08,Default,,0,0,0,,Әйел сияқты мейірімді, жылы адам.
Dialogue: 0,1:04:00.16,1:04:03.58,Default,,0,0,0,,От-саннан басқа мен ешкімді танымаймын!
Dialogue: 0,1:04:03.67,1:04:04.84,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:04:05.42,1:04:08.09,Default,,0,0,0,,Оған ұқсайтын ешкім жоқ!
Dialogue: 0,1:04:12.55,1:04:14.89,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,1:04:14.97,1:04:16.85,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,1:04:17.68,1:04:20.35,Default,,0,0,0,,Мен қазір не туралы алаңдадым?
Dialogue: 0,1:04:21.10,1:04:23.31,Default,,0,0,0,,Иә, иә! Ол аяқтады!
Dialogue: 0,1:04:23.40,1:04:24.86,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,1:04:24.94,1:04:27.11,Default,,0,0,0,,Өйткені бұл менмін.
Dialogue: 0,1:04:29.15,1:04:32.20,Default,,0,0,0,,Мен сенен туғаныма қуаныштымын.
Dialogue: 0,1:04:34.87,1:04:36.33,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:04:37.58,1:04:39.41,Default,,0,0,0,,Мен менмін!
Dialogue: 0,1:04:40.20,1:04:42.71,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:04:44.83,1:04:46.21,Default,,0,0,0,,Трамы басқан адам
Dialogue: 0,1:04:46.79,1:04:48.46,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:04:48.55,1:04:51.76,Default,,0,0,0,,Сәлем! Неліктен қабілеттеріңізді пайдалана алмайсыз?
Dialogue: 0,1:04:51.84,1:04:54.22,Default,,0,0,0,,Негізгі дененің не екенін білмесем, қалай қозғалуға болады?
Dialogue: 0,1:04:54.84,1:04:56.60,Default,,0,0,0,,Қалай болғанда да, мен қазір шабуылдардан жалтарып жатырмын.
Dialogue: 0,1:04:56.68,1:04:57.93,Default,,0,0,0,,Шығудың жолын іздеуден басқа амалымыз жоқ...
Dialogue: 0,1:04:58.01,1:04:59.35,Default,,0,0,0,,Егер мен сигнал берсем
Dialogue: 0,1:04:59.43,1:05:01.14,Default,,0,0,0,,Сол жаққа жүгір!
Dialogue: 0,1:05:01.23,1:05:02.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:02.18,1:05:04.85,Default,,0,0,0,,Досыңыздың айтқанын тыңдаңыз.
Dialogue: 0,1:05:04.94,1:05:07.27,Default,,0,0,0,,Жүр!
Dialogue: 0,1:05:07.36,1:05:09.03,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,1:05:09.11,1:05:11.36,Default,,0,0,0,,Ах! Оригами циклонынан кейін «Райан мен Барнаби күдіктіні тартады»
Dialogue: 0,1:05:11.36,1:05:11.44,Default,,0,0,0,,«Райан мен Барнаби күдіктілерді тартады»
Dialogue: 0,1:05:11.44,1:05:13.28,Default,,0,0,0,,«Райан мен Барнаби күдіктілерді тартады» Барнаби оқиға орнын тастап кетті ме?
Dialogue: 0,1:05:14.16,1:05:17.95,Default,,0,0,0,,Мен сені жібермеймін дедім ғой!
Dialogue: 0,1:05:20.58,1:05:22.29,Default,,0,0,0,,Келіңіздер...!
Dialogue: 0,1:05:22.87,1:05:25.75,Default,,0,0,0,,Доддон!
Dialogue: 0,1:05:25.83,1:05:28.42,Default,,0,0,0,,Мұндай жағдайда оны белсендірудің қажеті жоқ!
Dialogue: 0,1:05:30.05,1:05:31.26,Default,,0,0,0,,Жаса-істей-істей-істей-жаса...!
Dialogue: 0,1:05:31.34,1:05:32.30,Default,,0,0,0,,(Кашаның мазақ еткен дауысы)
Dialogue: 0,1:05:32.38,1:05:33.72,Default,,0,0,0,,Істей-істей-істей-істей-істей-жаса...!
Dialogue: 0,1:05:33.80,1:05:36.51,Default,,0,0,0,,(Кашаның мазақ еткен дауысы)
Dialogue: 0,1:05:36.59,1:05:38.80,Default,,0,0,0,,Жасау-істеу-істеу-істеу...!
Dialogue: 0,1:05:39.39,1:05:40.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:40.31,1:05:43.06,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,1:05:45.27,1:05:45.77,Default,,0,0,0,,«Райанның гравитациялық толқындары тігінен созылып жатыр!»
Dialogue: 0,1:05:45.77,1:05:47.65,Default,,0,0,0,,«Райанның гравитациялық толқындары тігінен созылып жатыр!» Міне осы! Не айтқың келеді?
Dialogue: 0,1:05:47.65,1:05:47.73,Default,,0,0,0,,«Райанның гравитациялық толқындары тігінен созылып жатыр!»
Dialogue: 0,1:05:47.73,1:05:50.19,Default,,0,0,0,,«Райанның гравитациялық толқындары тігінен созылып жатыр!» Райанның гравитациялық өрісі тігінен созылып жатыр.
Dialogue: 0,1:05:52.07,1:05:55.40,Default,,0,0,0,,Мені қазір ұста, Кіші!
Dialogue: 0,1:05:55.49,1:05:57.74,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,1:06:03.91,1:06:05.67,Default,,0,0,0,,Мен жасадым! (адамдар қолдайды)
Dialogue: 0,1:06:03.91,1:06:05.67,Default,,0,0,0,,«Райн мен Барнаби, бізде кінәлі!»
Dialogue: 0,1:06:05.67,1:06:05.75,Default,,0,0,0,,«Райн мен Барнаби, бізде кінәлі!»
Dialogue: 0,1:06:05.75,1:06:08.38,Default,,0,0,0,,«Райан мен Барнаби, бізде кінәлі!»
Dialogue: 0,1:06:05.75,1:06:08.38,Default,,0,0,0,,Райан мен Барнаби ауыр шайқастан кейін қылмыскерді тұтқындады!
Dialogue: 0,1:06:08.38,1:06:09.59,Default,,0,0,0,,Райан мен Барнаби ауыр шайқастан кейін қылмыскерді тұтқындады!
Dialogue: 0,1:06:12.71,1:06:14.67,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:06:17.26,1:06:19.01,Default,,0,0,0,,Батырлар патшасы да
Dialogue: 0,1:06:19.10,1:06:21.56,Default,,0,0,0,,Бұл жай ғана сөз.
Dialogue: 0,1:06:25.14,1:06:25.98,Default,,0,0,0,,Хмм...
Dialogue: 0,1:06:27.77,1:06:28.73,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,1:06:28.81,1:06:30.48,Default,,0,0,0,,Бұлай болуы мүмкін емес!
Dialogue: 0,1:06:30.56,1:06:33.99,Default,,0,0,0,,Қалай! Origami Cyclone қайтып келді!
Dialogue: 0,1:06:34.07,1:06:36.45,Default,,0,0,0,,Оригами-кун, сен...
Dialogue: 0,1:06:36.53,1:06:40.03,Default,,0,0,0,,Мен достарымды тастап қашпаймын!
Dialogue: 0,1:06:40.12,1:06:41.99,Default,,0,0,0,,Керемет тамаша!
Dialogue: 0,1:06:42.58,1:06:45.71,Default,,0,0,0,,Бірақ сіз не істей аласыз? Иә?
Dialogue: 0,1:06:45.79,1:06:48.29,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,1:07:02.35,1:07:05.14,Default,,0,0,0,,Жерде не бар? Мен түсінбеймін
Dialogue: 0,1:07:06.43,1:07:10.10,Default,,0,0,0,,Сәлем! Мені оған ұшыр
Dialogue: 0,1:07:10.19,1:07:11.48,Default,,0,0,0,,Не? Бұл нақты не...
Dialogue: 0,1:07:12.82,1:07:13.98,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,1:07:16.90,1:07:19.99,Default,,0,0,0,,Аспан Сәлем!
Dialogue: 0,1:07:23.20,1:07:24.95,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,1:07:30.04,1:07:31.67,Default,,0,0,0,,«Оригами Cyclone Sky High»
Dialogue: 0,1:07:31.67,1:07:33.09,Default,,0,0,0,,«Оригами Циклон Аспан жоғары» Ухохохо!
Dialogue: 0,1:07:33.09,1:07:33.13,Default,,0,0,0,,«Оригами Cyclone Sky High»
Dialogue: 0,1:07:33.17,1:07:33.21,Default,,0,0,0,,Жалпы осы маусым⸺
Dialogue: 0,1:07:33.21,1:07:34.46,Default,,0,0,0,,Осы маусымда мүлдем⸺ «Рок бизонға күдікті қорғалды»
Dialogue: 0,1:07:34.46,1:07:34.55,Default,,0,0,0,,«Рок бизонға күдікті ұсталды»
Dialogue: 0,1:07:34.55,1:07:36.30,Default,,0,0,0,,«Рок бизонына күдікті қамауға алынды» Ештеңені көрсетпейтін рок бизоны
Dialogue: 0,1:07:36.38,1:07:39.22,Default,,0,0,0,,Ол жасады! (адамдар қолдайды)
Dialogue: 0,1:07:40.59,1:07:41.72,Default,,0,0,0,,«Тамаша ұжымдық жұмысымен...»
Dialogue: 0,1:07:41.72,1:07:42.97,Default,,0,0,0,,«Таңғажайып ұжымдық жұмысымен...» (Тыныс алу)
Dialogue: 0,1:07:44.39,1:07:46.81,Default,,0,0,0,,(Көк раушан мен айдаһар баланың айқайы)
Dialogue: 0,1:07:53.40,1:07:55.78,Default,,0,0,0,,Бұл босқа, қыз!
Dialogue: 0,1:08:02.82,1:08:03.49,Default,,0,0,0,,«Күдікті Айдаһар Балаға жақындап келеді».
Dialogue: 0,1:08:03.49,1:08:04.08,Default,,0,0,0,,«Айдаһар балаға күдікті жақындап келеді» О, бұл қауіпті!
Dialogue: 0,1:08:04.08,1:08:04.16,Default,,0,0,0,,«Күдікті Айдаһар Балаға жақындап келеді».
Dialogue: 0,1:08:04.16,1:08:06.62,Default,,0,0,0,,«Күдікті Айдаһар Балаға жақындап келеді» Айдаһар бала қылмыскердің қолында!
Dialogue: 0,1:08:08.91,1:08:13.04,Default,,0,0,0,,Ең алдымен ұйықтау керек.
Dialogue: 0,1:08:17.30,1:08:18.30,Default,,0,0,0,,Уф!
Dialogue: 0,1:08:18.80,1:08:19.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:26.93,1:08:28.10,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:08:30.27,1:08:32.52,Default,,0,0,0,,Қалай! Өрт эмблемасы!
Dialogue: 0,1:08:32.60,1:08:34.52,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:08:32.60,1:08:34.52,Default,,0,0,0,,«От эмблемасы шайқаста»
Dialogue: 0,1:08:34.60,1:08:37.57,Default,,0,0,0,,Жақсы болды... Ояндым.
Dialogue: 0,1:08:37.65,1:08:39.36,Default,,0,0,0,,Себебі мен уайымдадым
Dialogue: 0,1:08:39.44,1:08:41.36,Default,,0,0,0,,Эмоциялық кездесу кейінірек келеді
Dialogue: 0,1:08:41.95,1:08:45.12,Default,,0,0,0,,Алдымен анау қарттың қамын алайық.
Dialogue: 0,1:08:46.70,1:08:47.74,Default,,0,0,0,,Қауіпті!
Dialogue: 0,1:08:47.83,1:08:49.50,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,1:08:50.75,1:08:54.04,Default,,0,0,0,,Енді менің жүрегімде бір тыртық жоқ!
Dialogue: 0,1:08:54.13,1:08:55.29,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:08:55.88,1:08:58.38,Default,,0,0,0,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,1:09:05.55,1:09:08.72,Default,,0,0,0,,Ерлерде батыл, әйелде сүйкімділік бар дейді.
Dialogue: 0,1:09:09.35,1:09:11.93,Default,,0,0,0,,Ендеше, сіз фрагменттің не екенін білесіз бе?
Dialogue: 0,1:09:13.43,1:09:15.31,Default,,0,0,0,,Ең күшті!
Dialogue: 0,1:09:20.07,1:09:21.19,Default,,0,0,0,,Өрт мырза!
Dialogue: 0,1:09:21.28,1:09:21.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:28.66,1:09:30.24,Default,,0,0,0,,(ауырсыну сияқты)
Dialogue: 0,1:09:30.33,1:09:31.62,Default,,0,0,0,,Аурудан айыққаннан кейін «Өрт эмблемасына шабуыл жасалды!»
Dialogue: 0,1:09:31.62,1:09:31.70,Default,,0,0,0,,«Өрт эмблемасына шабуыл жасалды!»
Dialogue: 0,1:09:31.70,1:09:32.58,Default,,0,0,0,,«Өрт эмблемасына шабуыл жасалды!» Қатты болды ма?
Dialogue: 0,1:09:32.66,1:09:34.96,Default,,0,0,0,,(қатты айқайлаған дауыс)
Dialogue: 0,1:09:37.46,1:09:38.38,Default,,0,0,0,,(кішкентай айқай)
Dialogue: 0,1:09:40.21,1:09:41.92,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,1:09:43.01,1:09:45.80,Default,,0,0,0,,(екпінді дауыс)
Dialogue: 0,1:09:46.64,1:09:48.60,Default,,0,0,0,,(екпінді дауыс)
Dialogue: 0,1:09:54.10,1:09:57.10,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:09:58.65,1:09:59.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:08.03,1:10:09.78,Default,,0,0,0,,А...? Қазір...
Dialogue: 0,1:10:12.33,1:10:13.66,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,1:10:15.37,1:10:17.50,Default,,0,0,0,,(қатты айқай)
Dialogue: 0,1:10:18.50,1:10:19.50,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,1:10:21.00,1:10:22.21,Default,,0,0,0,,Бар!
Dialogue: 0,1:10:23.88,1:10:24.38,Default,,0,0,0,,Мүлдем...
Dialogue: 0,1:10:24.97,1:10:26.59,Default,,0,0,0,,Маған қашып кетуге жол берме!
Dialogue: 0,1:10:30.10,1:10:32.22,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:10:34.60,1:10:35.94,Default,,0,0,0,,(Музыка кенет аяқталады)
Dialogue: 0,1:10:37.44,1:10:38.73,Default,,0,0,0,,(Жеңілдену дауысы)
Dialogue: 0,1:10:40.27,1:10:41.94,Default,,0,0,0,,Шешілді! (адамдар қолдайды)
Dialogue: 0,1:10:42.02,1:10:43.82,Default,,0,0,0,,Қайта тірілген өрт эмблемалары
Dialogue: 0,1:10:43.90,1:10:44.40,Default,,0,0,0,,Үш адамның біріккен техникасы жарылды!
Dialogue: 0,1:10:44.40,1:10:45.61,Default,,0,0,0,,Үш адамның біріккен техникасы жарылды! «Үш батыр техниканы біріктіреді»
Dialogue: 0,1:10:45.61,1:10:45.69,Default,,0,0,0,,Үш адамның біріккен техникасы жарылды!
Dialogue: 0,1:10:45.69,1:10:47.70,Default,,0,0,0,,Үш адамның біріккен техникасы жарылды! «Күдіктіні жою үшін бірге жұмыс істеңіз».
Dialogue: 0,1:10:47.70,1:10:48.32,Default,,0,0,0,,«Күдіктіні жеңу үшін бірге жұмыс жасаңыз».
Dialogue: 0,1:10:48.41,1:10:50.78,Default,,0,0,0,,(қатты жарылыс дыбысы)
Dialogue: 0,1:10:50.87,1:10:52.74,Default,,0,0,0,,(Шнайдердің айқайы)
Dialogue: 0,1:10:52.83,1:10:55.16,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,1:11:03.67,1:11:04.88,Default,,0,0,0,,Не? Не?!
Dialogue: 0,1:11:05.71,1:11:07.63,Default,,0,0,0,,Шыу!
Dialogue: 0,1:11:11.85,1:11:13.76,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:11:16.02,1:11:17.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:21.40,1:11:25.15,Default,,0,0,0,,Қоян! Апыр-ай...! Сонымен...
Dialogue: 0,1:11:25.65,1:11:27.28,Default,,0,0,0,,Жүр!
Dialogue: 0,1:11:27.36,1:11:28.90,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:11:28.99,1:11:31.99,Default,,0,0,0,,Сіз қате қабілетті қайтадан пайдаланған боларсыз, солай ма?
Dialogue: 0,1:11:32.07,1:11:34.74,Default,,0,0,0,,Оны маған айтқаныңыз үшін қолданбаңыз.
Dialogue: 0,1:11:35.83,1:11:38.75,Default,,0,0,0,,Сендердің арқаларыңда қолдарым ұйып қалды.
Dialogue: 0,1:11:45.00,1:11:45.71,Default,,0,0,0,,Эй, эй!
Dialogue: 0,1:11:45.80,1:11:47.84,Default,,0,0,0,,Ол адамды жайына қалдырыңыз!
Dialogue: 0,1:11:47.92,1:11:49.38,Default,,0,0,0,,олжа қашады!
Dialogue: 0,1:11:50.93,1:11:51.76,Default,,0,0,0,,Иә
Dialogue: 0,1:11:54.56,1:11:55.89,Default,,0,0,0,,Не? (Барнаби) А...
Dialogue: 0,1:11:55.97,1:11:58.10,Default,,0,0,0,,Мен оны көремін Мен оны көремін!
Dialogue: 0,1:11:58.60,1:12:00.44,Default,,0,0,0,,Иә? (мазасыз музыка)
Dialogue: 0,1:12:02.56,1:12:04.23,Default,,0,0,0,,Бұл жігіт... неге?
Dialogue: 0,1:12:04.32,1:12:05.86,Default,,0,0,0,,Бұл...
Dialogue: 0,1:12:07.03,1:12:08.36,Default,,0,0,0,,Жынды!
Dialogue: 0,1:12:08.44,1:12:09.24,Default,,0,0,0,,Соңында камера
Dialogue: 0,1:12:09.32,1:12:10.86,Default,,0,0,0,,Барнаби мен оның достарын ұстау
Dialogue: 0,1:12:10.95,1:12:13.82,Default,,0,0,0,,Онда жынды адам бар!
Dialogue: 0,1:12:13.91,1:12:15.91,Default,,0,0,0,,Сіз нені айтасыз? Ол тек қанішерлерді ғана нысанаға алуы керек еді.
Dialogue: 0,1:12:15.91,1:12:17.58,Default,,0,0,0,,Сіз нені айтасыз? Ол тек қанішерлерді ғана нысанаға алуы керек еді.
Dialogue: 0,1:12:15.91,1:12:17.58,Default,,0,0,0,,«Жынды пайда болады»
Dialogue: 0,1:12:17.66,1:12:19.16,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,1:12:19.25,1:12:21.62,Default,,0,0,0,,Ол жиіркенішті.
Dialogue: 0,1:12:21.71,1:12:24.13,Default,,0,0,0,,Балалар, мына механикалық мыңжапырақтың соңынан жүріңдер!
Dialogue: 0,1:12:25.96,1:12:27.34,Default,,0,0,0,,Котецу мырза!
Dialogue: 0,1:12:30.51,1:12:33.26,Default,,0,0,0,,Бұл жігіт... Мен оған қамқор боламын!
Dialogue: 0,1:12:34.01,1:12:35.97,Default,,0,0,0,,Сәлем! Тез барайық!
Dialogue: 0,1:12:37.01,1:12:38.10,Default,,0,0,0,,Эй!
Dialogue: 0,1:12:39.60,1:12:40.60,Default,,0,0,0,,Қалағаныңды істе!
Dialogue: 0,1:12:53.03,1:12:54.66,Default,,0,0,0,,Тез жүр!
Dialogue: 0,1:12:54.74,1:12:56.45,Default,,0,0,0,,Әртүрлі комбинациялардың пайдасы жоқ!
Dialogue: 0,1:12:56.53,1:12:57.33,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:12:57.41,1:12:58.33,Default,,0,0,0,,Қоян!
Dialogue: 0,1:13:04.42,1:13:06.96,Default,,0,0,0,,Жабу! Менің саған пайдасы жоқ
Dialogue: 0,1:13:07.04,1:13:10.46,Default,,0,0,0,,Менің иесім сол машинада тұрып қалды.
Dialogue: 0,1:13:10.55,1:13:13.30,Default,,0,0,0,,Мен Темидің менімен араласуына жол бере алмаймын!
Dialogue: 0,1:13:13.38,1:13:16.80,Default,,0,0,0,,Нағыз зұлымдықты көре алмау қандай ақымақтық.
Dialogue: 0,1:13:16.89,1:13:18.26,Default,,0,0,0,,Әй?
Dialogue: 0,1:13:18.35,1:13:22.18,Default,,0,0,0,,Танатос әрқашан шындықты айтады
Dialogue: 0,1:13:22.27,1:13:22.77,Default,,0,0,0,,«Жабайы жолбарысты тоқтатуға бола ма?»
Dialogue: 0,1:13:22.77,1:13:25.23,Default,,0,0,0,,«Жабайы жолбарысты тоқтатуға бола ма?»
Dialogue: 0,1:13:22.77,1:13:25.23,Default,,0,0,0,,Жалғыз жабайы жолбарыс Лунатикті тоқтата ала ма?
Dialogue: 0,1:13:25.23,1:13:26.15,Default,,0,0,0,,Жалғыз жабайы жолбарыс Лунатикті тоқтата ала ма?
Dialogue: 0,1:13:26.23,1:13:27.23,Default,,0,0,0,,Әкем…
Dialogue: 0,1:13:28.40,1:13:29.61,Default,,0,0,0,,Сәлем! Бұл не?
Dialogue: 0,1:13:35.70,1:13:37.83,Default,,0,0,0,,Бұл не? Сіз не істемексіз?
Dialogue: 0,1:13:46.79,1:13:47.67,Default,,0,0,0,,Шыу!
Dialogue: 0,1:13:54.80,1:13:57.68,Default,,0,0,0,,Барлық Sternbild азаматтарына ескерту
Dialogue: 0,1:13:58.55,1:14:01.43,Default,,0,0,0,,Аңызға айналған құдайдың көрсеткен әділдігі
Dialogue: 0,1:14:01.52,1:14:04.69,Default,,0,0,0,,Бүгін кешке тағы көрсетейік.
Dialogue: 0,1:14:04.77,1:14:06.65,Default,,0,0,0,,Және көзге
Dialogue: 0,1:14:06.73,1:14:09.48,Default,,0,0,0,,Мына кісінің өлімін өрте!
Dialogue: 0,1:14:10.86,1:14:12.03,Default,,0,0,0,,(айқайлаған дауыс)
Dialogue: 0,1:14:21.66,1:14:22.66,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,1:14:25.83,1:14:27.96,Default,,0,0,0,,(Шнайдердің айқайы)
Dialogue: 0,1:14:28.04,1:14:29.13,Default,,0,0,0,,Райан!
Dialogue: 0,1:14:32.50,1:14:35.34,Default,,0,0,0,,Маған нұсқау беруге батылы барма!
Dialogue: 0,1:14:43.56,1:14:45.10,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,1:14:45.60,1:14:46.81,Default,,0,0,0,,Міне, осындай сезім!
Dialogue: 0,1:14:46.89,1:14:49.73,Default,,0,0,0,,Бұл орындалады! Райан мен Барнаби!
Dialogue: 0,1:14:49.81,1:14:52.23,Default,,0,0,0,,Бұл менің бүгінгі екінші қойылымым.
Dialogue: 0,1:14:52.90,1:14:54.15,Default,,0,0,0,,Не?
Dialogue: 0,1:14:54.23,1:14:56.07,Default,,0,0,0,,Бұл қандай машина?
Dialogue: 0,1:14:56.65,1:14:59.57,Default,,0,0,0,,Бұл құдайдың шынайы тұлғасы ма?
Dialogue: 0,1:15:02.12,1:15:03.37,Default,,0,0,0,,Егер бұл Бірінші нөмірлі Батырға жақындауға көмектессе, мен бәрін жасауға дайынмын
Dialogue: 0,1:15:04.62,1:15:05.91,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:15:06.00,1:15:09.21,Default,,0,0,0,,Сонымен, сіз барлық жіптерді тартып алдыңыз ба?
Dialogue: 0,1:15:09.29,1:15:11.34,Default,,0,0,0,,Вирджил мырза.
Dialogue: 0,1:15:11.42,1:15:13.42,Default,,0,0,0,,Амансың ба? Эй!
Dialogue: 0,1:15:13.96,1:15:14.84,Default,,0,0,0,,О
Dialogue: 0,1:15:14.92,1:15:16.84,Default,,0,0,0,,Иә...
Dialogue: 0,1:15:17.47,1:15:19.51,Default,,0,0,0,,Жерде не...?
Dialogue: 0,1:15:21.05,1:15:23.01,Default,,0,0,0,,Сол бейбақ...
Dialogue: 0,1:15:23.10,1:15:24.35,Default,,0,0,0,,Бұл Эндрю.
Dialogue: 0,1:15:24.43,1:15:25.27,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:25.77,1:15:27.27,Default,,0,0,0,,Эндрю Скотт
Dialogue: 0,1:15:27.77,1:15:29.06,Default,,0,0,0,,Бұл менің атым
Dialogue: 0,1:15:29.14,1:15:30.69,Default,,0,0,0,,Хмм... Скотт?
Dialogue: 0,1:15:32.52,1:15:34.86,Default,,0,0,0,,Сіз Скотт жүйесі туралы естідіңіз бе?
Dialogue: 0,1:15:34.94,1:15:35.82,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:35.90,1:15:37.74,Default,,0,0,0,,Әрине жоқ
Dialogue: 0,1:15:38.24,1:15:39.40,Default,,0,0,0,,Менің әкемнің компаниясы...
Dialogue: 0,1:15:39.99,1:15:41.62,Default,,0,0,0,,Өйткені ол өте кішкентай болды
Dialogue: 0,1:15:41.70,1:15:43.99,Default,,0,0,0,,(сағаттың секунд тілінің дыбысы)
Dialogue: 0,1:15:44.83,1:15:46.45,Default,,0,0,0,,Ол жақсы әке болды.
Dialogue: 0,1:15:47.25,1:15:49.33,Default,,0,0,0,,Мені бір адамның қолымен көтер
Dialogue: 0,1:15:49.41,1:15:52.96,Default,,0,0,0,,Қанша жұмыс істесе де, ол ешқашан шағымданбады.
Dialogue: 0,1:15:53.63,1:15:55.75,Default,,0,0,0,,Еңбекқор әкеме рахмет
Dialogue: 0,1:15:55.84,1:15:58.38,Default,,0,0,0,,Компания банкротқа ұшыраудан құтылды.
Dialogue: 0,1:15:58.47,1:16:00.80,Default,,0,0,0,,Мен тіпті жас болсам да түсінетінмін.
Dialogue: 0,1:16:00.88,1:16:02.14,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:16:00.88,1:16:02.14,Default,,0,0,0,,«А. Скотт, Скотт System Co.»
Dialogue: 0,1:16:02.14,1:16:02.22,Default,,0,0,0,,...
Dialogue: 0,1:16:02.22,1:16:02.80,Default,,0,0,0,,«А. Скотт, Скотт Жүйе компаниясы»
Dialogue: 0,1:16:02.22,1:16:02.80,Default,,0,0,0,,Әкемнің ісімен келіскен адам пайда болғанда,
Dialogue: 0,1:16:02.80,1:16:05.56,Default,,0,0,0,,Әкемнің ісімен келіскен адам пайда болғанда,
Dialogue: 0,1:16:05.64,1:16:07.60,Default,,0,0,0,,Қуанғаным сонша секірдім.
Dialogue: 0,1:16:07.68,1:16:09.85,Default,,0,0,0,,Бұл Шнайдер
Dialogue: 0,1:16:09.94,1:16:10.56,Default,,0,0,0,,...
Dialogue: 0,1:16:10.56,1:16:12.65,Default,,0,0,0,,...
Dialogue: 0,1:16:10.56,1:16:12.65,Default,,0,0,0,,Компания тез өседі
Dialogue: 0,1:16:12.65,1:16:12.73,Default,,0,0,0,,...
Dialogue: 0,1:16:12.73,1:16:14.06,Default,,0,0,0,,...
Dialogue: 0,1:16:12.73,1:16:14.06,Default,,0,0,0,,Шнайдер - құтқарушы
Dialogue: 0,1:16:14.15,1:16:17.28,Default,,0,0,0,,Мен бұл адамға өмір бойы шыдай алмаймын.
Dialogue: 0,1:16:17.36,1:16:19.07,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,1:16:19.15,1:16:21.32,Default,,0,0,0,,Әкем өз-өзіне қол жұмсағанға дейін
Dialogue: 0,1:16:23.03,1:16:25.20,Default,,0,0,0,,Ант етемін
Dialogue: 0,1:16:25.28,1:16:28.50,Default,,0,0,0,,Менің әкем өз өмірін қиатын адам емес.
Dialogue: 0,1:16:28.58,1:16:30.25,Default,,0,0,0,,Амалсыздан
Dialogue: 0,1:16:30.33,1:16:33.42,Default,,0,0,0,,Мен әкемнің өлімінің астарында шындықты іздедім.
Dialogue: 0,1:16:33.50,1:16:36.46,Default,,0,0,0,,Ал мен... шындықты білдім!
Dialogue: 0,1:16:37.09,1:16:37.92,Default,,0,0,0,,Менің әкем...
Dialogue: 0,1:16:38.01,1:16:41.26,Default,,0,0,0,,Алданғаннан кейін компанияны күштеп сатып алды.
Dialogue: 0,1:16:42.26,1:16:43.47,Default,,0,0,0,,Шнайдердің алаяқтық салымдары
Dialogue: 0,1:16:43.55,1:16:45.89,Default,,0,0,0,,Менің әкем бір нәрсені жасыруға дағдыланған!
Dialogue: 0,1:16:47.56,1:16:49.06,Default,,0,0,0,,Барлығын жариялау
Dialogue: 0,1:16:49.14,1:16:50.81,Default,,0,0,0,,Шнайдерге балға беріңіз
Dialogue: 0,1:16:50.89,1:16:53.44,Default,,0,0,0,,Дәл осы себепті, соңғы бірнеше жыл
Dialogue: 0,1:16:53.52,1:16:56.11,Default,,0,0,0,,Хатшы болып қалтаға кіріп, бәрін барлап шықтым.
Dialogue: 0,1:16:56.61,1:16:58.82,Default,,0,0,0,,Ал уақыт келді
Dialogue: 0,1:16:58.90,1:17:00.36,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,1:17:00.44,1:17:03.95,Default,,0,0,0,,Фестиваль күні басқа қауіпсіздік шаралары жұқа болады.
Dialogue: 0,1:17:04.03,1:17:07.28,Default,,0,0,0,,Тек батырлар оларды тоқтата алса болды.
Dialogue: 0,1:17:07.37,1:17:09.83,Default,,0,0,0,,Ендеше құдай туралы аңызды қолданыңыз!
Dialogue: 0,1:17:09.91,1:17:11.79,Default,,0,0,0,,Тек осы мақсат үшін емес
Dialogue: 0,1:17:11.87,1:17:15.38,Default,,0,0,0,,Әділдік сезімін жоғалтқан бұл шайтанның жеңілетініне сенемін.
Dialogue: 0,1:17:15.46,1:17:17.67,Default,,0,0,0,,Мен оны адамдарға көрсетемін деп ойладым.
Dialogue: 0,1:17:17.75,1:17:21.05,Default,,0,0,0,,Сонымен, сіз келесілерді жұмысқа алдыңыз ба?
Dialogue: 0,1:17:21.13,1:17:22.76,Default,,0,0,0,,Жалдады ма?
Dialogue: 0,1:17:25.47,1:17:29.06,Default,,0,0,0,,Біз Шнайдерден кек алуға ант берген жолдастармыз.
Dialogue: 0,1:17:29.14,1:17:31.10,Default,,0,0,0,,Олар да құрбандар
Dialogue: 0,1:17:33.06,1:17:34.10,Default,,0,0,0,,(сөздерді жоғалтқан дауыс)
Dialogue: 0,1:17:35.02,1:17:36.44,Default,,0,0,0,,Барнаби мырза
Dialogue: 0,1:17:36.94,1:17:40.19,Default,,0,0,0,,Сіз де кек алу үшін қаһарман ретінде бастадыңыз.
Dialogue: 0,1:17:41.57,1:17:42.69,Default,,0,0,0,,Тағы да...
Dialogue: 0,1:17:43.32,1:17:45.70,Default,,0,0,0,,Біраз уақыттан кейін бәрі бітеді.
Dialogue: 0,1:17:46.62,1:17:47.45,Default,,0,0,0,,Әлі де...
Dialogue: 0,1:17:48.28,1:17:49.99,Default,,0,0,0,,Сіз мені тоқтатасыз ба?
Dialogue: 0,1:17:52.29,1:17:55.42,Default,,0,0,0,,Сонда сіз маған кек алуға көмектесу үшін келдіңіз бе?
Dialogue: 0,1:17:55.50,1:17:58.17,Default,,0,0,0,,Жамандықтан қорғау – ауыр күнә
Dialogue: 0,1:17:58.25,1:18:00.59,Default,,0,0,0,,Олай болса, ол түзетілгенше.
Dialogue: 0,1:18:00.67,1:18:02.09,Default,,0,0,0,,Бұл кек алу ма?
Dialogue: 0,1:18:02.17,1:18:03.97,Default,,0,0,0,,Адам өлтіру дұрыс емес!
Dialogue: 0,1:18:04.05,1:18:06.51,Default,,0,0,0,,Сіз кісі өлтіруді жоққа шығарасыз.
Dialogue: 0,1:18:06.59,1:18:09.85,Default,,0,0,0,,Сіздің серіктесіңіз қайтыс болды, өйткені ата-анаңыздың жауы өлді.
Dialogue: 0,1:18:09.93,1:18:12.72,Default,,0,0,0,,Демалу уақытыңызды таппадыңыз ба?
Dialogue: 0,1:18:13.35,1:18:14.23,Default,,0,0,0,,Әрине
Dialogue: 0,1:18:14.31,1:18:16.48,Default,,0,0,0,,Менің де кек алғым келген кез болды.
Dialogue: 0,1:18:17.27,1:18:18.11,Default,,0,0,0,,Егер солай істесем…
Dialogue: 0,1:18:18.61,1:18:22.23,Default,,0,0,0,,Әке мен ана, бізден ұрланған болашақты қайтарамыз деп сенемін.
Dialogue: 0,1:18:22.32,1:18:26.11,Default,,0,0,0,,Олай болса, сен неге адамды құтқармақсың?
Dialogue: 0,1:18:26.70,1:18:28.20,Default,,0,0,0,,Менің сақтағаным...
Dialogue: 0,1:18:29.20,1:18:30.12,Default,,0,0,0,,Оларға тез хабарлауың керек…
Dialogue: 0,1:18:31.91,1:18:33.04,Default,,0,0,0,,Сол жігіт
Dialogue: 0,1:18:33.12,1:18:34.83,Default,,0,0,0,,Мен әлі қиналып жүрмін.
Dialogue: 0,1:18:34.91,1:18:36.67,Default,,0,0,0,,Барлық өткеніңізді қабылдаңыз
Dialogue: 0,1:18:36.75,1:18:39.08,Default,,0,0,0,,Мен алға ұмтылуға тырыстым!
Dialogue: 0,1:18:39.17,1:18:41.34,Default,,0,0,0,,Қазіргіні қабылдау арқылы өмір сүру
Dialogue: 0,1:18:42.25,1:18:44.17,Default,,0,0,0,,Ол маған осылай деді
Dialogue: 0,1:18:44.67,1:18:46.88,Default,,0,0,0,,Мені тоқтатқан біреу болды
Dialogue: 0,1:18:47.47,1:18:49.64,Default,,0,0,0,,Соның арқасында мен бүгінгідеймін.
Dialogue: 0,1:18:49.72,1:18:51.85,Default,,0,0,0,,Менің қалатын ойым жоқ.
Dialogue: 0,1:18:51.93,1:18:54.22,Default,,0,0,0,,Сонда... не болса да
Dialogue: 0,1:18:54.31,1:18:56.27,Default,,0,0,0,,Мен сені тоқтатамын!
Dialogue: 0,1:18:58.85,1:19:00.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:19:06.70,1:19:09.57,Default,,0,0,0,,Мен сізді тым көп сатып алған сияқтымын.
Dialogue: 0,1:19:09.66,1:19:12.08,Default,,0,0,0,,Адамдарды өлтіруді талап ететін әділдік жоқ.
Dialogue: 0,1:19:12.16,1:19:13.91,Default,,0,0,0,,Мен осы жерден тілек айтып жатырмын!
Dialogue: 0,1:19:14.41,1:19:15.83,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,1:19:15.91,1:19:19.25,Default,,0,0,0,,Сонда сенің мағынасыз әділдігің
Dialogue: 0,1:19:19.33,1:19:23.75,Default,,0,0,0,,Мұнда және қазір, ол зұлымдықпен жойылғанға дейін
Dialogue: 0,1:19:27.22,1:19:29.55,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,1:19:37.43,1:19:39.48,Default,,0,0,0,,Бұл жақсы қабілет.
Dialogue: 0,1:19:39.56,1:19:41.56,Default,,0,0,0,,Бірақ сен менің жауым емессің!
Dialogue: 0,1:19:41.65,1:19:43.57,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:19:43.65,1:19:45.15,Default,,0,0,0,,Доддон!
Dialogue: 0,1:19:50.49,1:19:51.32,Default,,0,0,0,,Барнаби!
Dialogue: 0,1:19:54.41,1:19:56.83,Default,,0,0,0,,Райан шабуыл жасайды! Барнабиді қорғаңыз!
Dialogue: 0,1:19:56.91,1:19:59.12,Default,,0,0,0,,Құрама ойын мұнда да жарқырайды!
Dialogue: 0,1:19:56.91,1:19:59.12,Default,,0,0,0,,«Райн мен Барнаби, керемет топтық жұмыс!»
Dialogue: 0,1:20:02.54,1:20:04.04,Default,,0,0,0,,(Шнайдердің айқайы)
Dialogue: 0,1:20:08.05,1:20:09.22,Default,,0,0,0,,(қорқыныш пен діріл дауысы)
Dialogue: 0,1:20:15.18,1:20:19.23,Default,,0,0,0,,Ол... Ол маған дәмді тамақ әкелді.
Dialogue: 0,1:20:19.81,1:20:20.64,Default,,0,0,0,,Эй...
Dialogue: 0,1:20:20.73,1:20:21.90,Default,,0,0,0,,Бір минут күтіңіз...
Dialogue: 0,1:20:21.98,1:20:23.15,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,1:20:23.23,1:20:25.48,Default,,0,0,0,,Не болды? (Ер аудитория мүшесі) Бұл бұзылған.
Dialogue: 0,1:20:23.23,1:20:25.48,Default,,0,0,0,,«Әділет фестивалі»
Dialogue: 0,1:20:25.57,1:20:27.57,Default,,0,0,0,,Не болды? А... жоқ
Dialogue: 0,1:20:27.65,1:20:28.78,Default,,0,0,0,,Камера алып бара жатқан тікұшақ...
Dialogue: 0,1:20:28.86,1:20:29.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:30.45,1:20:32.49,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,1:20:33.70,1:20:34.99,Default,,0,0,0,,Райан!
Dialogue: 0,1:20:38.83,1:20:43.25,Default,,0,0,0,,Келіңіздер! Кет ол жерден, Барнаби!
Dialogue: 0,1:20:52.34,1:20:55.35,Default,,0,0,0,,Қапшыққа айналған әділдік ешкімді құтқара алмайды.
Dialogue: 0,1:20:55.43,1:20:57.39,Default,,0,0,0,,Жамандықты жоюдан басқа
Dialogue: 0,1:20:57.47,1:20:59.43,Default,,0,0,0,,Өткеннің қарғысынан құтыла алмайсың.
Dialogue: 0,1:20:59.52,1:21:03.19,Default,,0,0,0,,Темиге, сен ол туралы не білесің?
Dialogue: 0,1:21:05.56,1:21:07.69,Default,,0,0,0,,Ол әлі қалпына келтірілмеген бе? Мен қазір кетемін!
Dialogue: 0,1:21:09.69,1:21:11.49,Default,,0,0,0,,Иә? бұл!
Dialogue: 0,1:21:15.99,1:21:19.37,Default,,0,0,0,,Сіз бұл шынымен сіз екеніңізді білмейсіз бе!
Dialogue: 0,1:21:23.42,1:21:26.63,Default,,0,0,0,,Мұндай әрекетпен ештеңе шешілмейді!
Dialogue: 0,1:21:26.71,1:21:27.59,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,1:21:28.50,1:21:30.05,Default,,0,0,0,,Кек алсаң да
Dialogue: 0,1:21:30.13,1:21:32.13,Default,,0,0,0,,Әкең үйге келмейді
Dialogue: 0,1:21:32.22,1:21:33.59,Default,,0,0,0,,Бұл шындық!
Dialogue: 0,1:21:51.28,1:21:52.61,Default,,0,0,0,,Шыу!
Dialogue: 0,1:22:01.62,1:22:02.83,Default,,0,0,0,,Да...!
Dialogue: 0,1:22:02.91,1:22:04.46,Default,,0,0,0,,Ой! (Шұғылдық сезімі бар музыка)
Dialogue: 0,1:22:04.54,1:22:05.54,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:10.92,1:22:14.88,Default,,0,0,0,,Сіз насихаттайтын әділдік - бұл үстірт әділдік.
Dialogue: 0,1:22:14.97,1:22:17.34,Default,,0,0,0,,Нағыз зұлымдықты елемеу.
Dialogue: 0,1:22:17.43,1:22:20.68,Default,,0,0,0,,Мен мұндай батырларды қаламаймын.
Dialogue: 0,1:22:20.76,1:22:23.31,Default,,0,0,0,,Мен біреуге керек болғым келеді
Dialogue: 0,1:22:23.39,1:22:24.56,Default,,0,0,0,,Мен батырды ойнамаймын.
Dialogue: 0,1:22:24.64,1:22:26.77,Default,,0,0,0,,Батыр болып көріну т.б.
Dialogue: 0,1:22:26.85,1:22:29.23,Default,,0,0,0,,Жамандықты соттамайтын сен не істей аласың?
Dialogue: 0,1:22:29.31,1:22:30.23,Default,,0,0,0,,Ең алдымен, сен—
Dialogue: 0,1:22:30.94,1:22:34.11,Default,,0,0,0,,Егер біреуге көмек керек болса, хабарласыңыз.
Dialogue: 0,1:22:34.19,1:22:36.53,Default,,0,0,0,,Міне!
Dialogue: 0,1:22:34.19,1:22:36.53,Default,,0,0,0,,«Әділет фестивалі»
Dialogue: 0,1:22:42.16,1:22:43.33,Default,,0,0,0,,(оттың құлаған дыбысы)
Dialogue: 0,1:22:47.04,1:22:48.21,Default,,0,0,0,,Уф…
Dialogue: 0,1:22:48.96,1:22:50.96,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,1:22:55.97,1:22:57.01,Default,,0,0,0,,Аһ!
Dialogue: 0,1:22:58.55,1:23:00.47,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:23:00.55,1:23:03.47,Default,,0,0,0,,Жағдай мені үнсіз қалдырады...
Dialogue: 0,1:23:09.60,1:23:11.40,Default,,0,0,0,,Мен сені жібермеймін...
Dialogue: 0,1:23:11.48,1:23:14.53,Default,,0,0,0,,Ешқашан... мені жіберме.
Dialogue: 0,1:23:14.61,1:23:17.11,Default,,0,0,0,,Ол сонда—сол жақта~
Dialogue: 0,1:23:21.91,1:23:23.28,Default,,0,0,0,,Мұны қазірдің өзінде аяқтайық.
Dialogue: 0,1:23:23.37,1:23:24.62,Default,,0,0,0,,Барнаби мырза
Dialogue: 0,1:23:24.70,1:23:27.29,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,1:23:27.37,1:23:32.42,Default,,0,0,0,,(Шнайдердің айқайы)
Dialogue: 0,1:23:33.04,1:23:34.55,Default,,0,0,0,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,1:23:35.59,1:23:36.67,Default,,0,0,0,,Мен оны қадағалаймын.
Dialogue: 0,1:23:37.38,1:23:40.76,Default,,0,0,0,,Жеңілісті қабылдайсыз деп үміттенемін.
Dialogue: 0,1:23:40.84,1:23:46.18,Default,,0,0,0,,Күте тұрыңыз! Эй! Барнаби!
Dialogue: 0,1:23:46.81,1:23:49.60,Default,,0,0,0,,Осымен бәрі ақыры ештеңеге оралады.
Dialogue: 0,1:23:50.90,1:23:54.02,Default,,0,0,0,,(Жабайы жолбарыстың айқайы)
Dialogue: 0,1:23:54.11,1:23:57.40,Default,,0,0,0,,Те...! Апыр-ай! Желтоқсан…
Dialogue: 0,1:23:58.82,1:24:01.28,Default,,0,0,0,,Келіңіздер! (Барнаби) Котецу мырза?
Dialogue: 0,1:24:01.36,1:24:02.32,Default,,0,0,0,,Қоян?
Dialogue: 0,1:24:02.41,1:24:05.08,Default,,0,0,0,,Сонымен... (жақындап келе жатқан машинаның дыбысы)
Dialogue: 0,1:24:05.16,1:24:07.33,Default,,0,0,0,,Бұл ыңғайсыздық! (Жабайы жолбарыс) О!
Dialogue: 0,1:24:08.08,1:24:11.33,Default,,0,0,0,,(ренжіген дауыс)
Dialogue: 0,1:24:19.30,1:24:20.68,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:24:20.76,1:24:23.14,Default,,0,0,0,,Сіз көмектесуге келдіңіз бе?
Dialogue: 0,1:24:23.22,1:24:25.31,Default,,0,0,0,,Не? А... иә жақсы
Dialogue: 0,1:24:25.39,1:24:26.85,Default,,0,0,0,,Сіз мұны жалғыз жасай алмайсыз.
Dialogue: 0,1:24:26.93,1:24:28.81,Default,,0,0,0,,Олай болса, көмектесіңізші!
Dialogue: 0,1:24:32.06,1:24:35.36,Default,,0,0,0,,Айтпасаң да айтып тұрмын!
Dialogue: 0,1:24:35.44,1:24:36.69,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,1:24:36.78,1:24:39.69,Default,,0,0,0,,Жабайы жолбарыс пен Барнаби
Dialogue: 0,1:24:45.20,1:24:48.24,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,1:24:52.58,1:24:54.63,Default,,0,0,0,,(екпінді дауыс)
Dialogue: 0,1:25:04.68,1:25:07.93,Default,,0,0,0,,(Көңілсіз дауыс)
Dialogue: 0,1:25:09.52,1:25:11.18,Default,,0,0,0,,Ол жаман адам.
Dialogue: 0,1:25:11.27,1:25:13.90,Default,,0,0,0,,Бірнеше рет шабуыл жасаудан басқа амалыңыз жоқ.
Dialogue: 0,1:25:17.11,1:25:18.98,Default,,0,0,0,,(екпінді дауыс)
Dialogue: 0,1:25:21.57,1:25:22.82,Default,,0,0,0,,Дау...!
Dialogue: 0,1:25:24.70,1:25:25.74,Default,,0,0,0,,Котецу мырза!
Dialogue: 0,1:25:34.67,1:25:35.58,Default,,0,0,0,,(тұрақты фирманың дауысы)
Dialogue: 0,1:25:35.67,1:25:38.71,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,1:25:39.30,1:25:43.13,Default,,0,0,0,,(Жабайы жолбарыстың айқайы)
Dialogue: 0,1:25:47.10,1:25:48.30,Default,,0,0,0,,Котецу мырза!
Dialogue: 0,1:25:49.31,1:25:51.35,Default,,0,0,0,,(Тұрақты фирманың дауысы)
Dialogue: 0,1:25:51.43,1:25:53.56,Default,,0,0,0,,Қоян Сіздің қабілеттеріңіз қандай?
Dialogue: 0,1:25:53.64,1:25:55.40,Default,,0,0,0,,Әлі де қалпына келуде...!
Dialogue: 0,1:25:56.27,1:25:57.69,Default,,0,0,0,,Мен көмектесе алмаймын ...
Dialogue: 0,1:25:59.82,1:26:01.69,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,1:26:05.24,1:26:06.11,Default,,0,0,0,,Эй!
Dialogue: 0,1:26:08.66,1:26:11.54,Default,,0,0,0,,(қатты айқай)
Dialogue: 0,1:26:13.96,1:26:15.33,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:26:15.96,1:26:18.84,Default,,0,0,0,,(екпінді дауыс)
Dialogue: 0,1:26:26.22,1:26:27.43,Default,,0,0,0,,Сааа!
Dialogue: 0,1:26:28.72,1:26:31.39,Default,,0,0,0,,Сааааа!
Dialogue: 0,1:26:31.97,1:26:33.89,Default,,0,0,0,,(Ринраку) Бұл тек бір теория ғана, бірақ адам еті мен қанын жеудің орнына, Незуко…
Dialogue: 0,1:26:33.98,1:26:36.39,Default,,0,0,0,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,1:26:42.98,1:26:45.24,Default,,0,0,0,,Сондай-ақ!
Dialogue: 0,1:26:53.04,1:26:54.83,Default,,0,0,0,,Мен сенен үндемеуіңді сұраймын!
Dialogue: 0,1:26:56.92,1:26:58.00,Default,,0,0,0,,Иә! (адамдар қолдайды)
Dialogue: 0,1:26:58.08,1:27:00.46,Default,,0,0,0,,Батырлар жиналды
Dialogue: 0,1:27:00.54,1:27:02.59,Default,,0,0,0,,Балалар!
Dialogue: 0,1:27:04.13,1:27:06.34,Default,,0,0,0,,Қоян әлі де бар ма?
Dialogue: 0,1:27:06.42,1:27:07.63,Default,,0,0,0,,Әдемі…
Dialogue: 0,1:27:07.72,1:27:08.89,Default,,0,0,0,,Барнаби мырза!
Dialogue: 0,1:27:08.97,1:27:10.01,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:27:10.09,1:27:12.18,Default,,0,0,0,,Уайлд мырза! (Көк раушан) Жолбарыс!
Dialogue: 0,1:27:12.26,1:27:14.02,Default,,0,0,0,,Ой! (Жабайы жолбарыс) Әлі де?
Dialogue: 0,1:27:14.10,1:27:15.27,Default,,0,0,0,,«Жүз қуатты қайта зарядтау»
Dialogue: 0,1:27:16.85,1:27:18.31,Default,,0,0,0,,(Батырлар айқайы)
Dialogue: 0,1:27:23.98,1:27:26.69,Default,,0,0,0,,Дододон!
Dialogue: 0,1:27:28.61,1:27:31.32,Default,,0,0,0,,Менің етігімнен сүй!
Dialogue: 0,1:27:31.41,1:27:34.20,Default,,0,0,0,,Міне, гравитацияның ханзадасы!
Dialogue: 0,1:27:31.41,1:27:34.20,Default,,0,0,0,,«Князь Гравити қайтадан шайқаста!»
Dialogue: 0,1:27:34.29,1:27:35.16,Default,,0,0,0,,«Зарядтау аяқталды»
Dialogue: 0,1:27:36.33,1:27:38.33,Default,,0,0,0,,Котецу мырза! (Жабайы жолбарыс) Жарайды!
Dialogue: 0,1:27:38.96,1:27:40.12,Default,,0,0,0,,Кеттік! (Барнаби) Иә!
Dialogue: 0,1:27:40.21,1:27:44.13,Default,,0,0,0,,(көтеретін музыка)
Dialogue: 0,1:27:51.72,1:27:53.39,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,1:27:53.47,1:27:56.64,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,1:27:58.89,1:27:59.89,Default,,0,0,0,,(музыка аяқталады)
Dialogue: 0,1:27:59.98,1:28:02.02,Default,,0,0,0,,(қатты айқайлаған дауыс)
Dialogue: 0,1:28:20.16,1:28:21.17,Default,,0,0,0,,(жекпе-жек дауысы)
Dialogue: 0,1:28:31.76,1:28:33.93,Default,,0,0,0,,Қабілеттің аяқталуына 10 секунд қалғанда
Dialogue: 0,1:28:34.01,1:28:36.06,Default,,0,0,0,,Қоян! (Барнаби) Мен білемін!
Dialogue: 0,1:28:44.19,1:28:47.40,Default,,0,0,0,,Оля!
Dialogue: 0,1:28:49.44,1:28:50.90,Default,,0,0,0,,(Екі адам айқайлайды)
Dialogue: 0,1:28:50.99,1:28:52.03,Default,,0,0,0,,«Жолбарыс пен қоян»
Dialogue: 0,1:28:52.03,1:28:54.91,Default,,0,0,0,,«Жолбарыс пен қоян»
Dialogue: 0,1:28:52.03,1:28:54.91,Default,,0,0,0,,Жолбарыс пен қоянның үстінде және сыртында
Dialogue: 0,1:28:55.99,1:28:58.75,Default,,0,0,0,,(шықыру дыбысы)
Dialogue: 0,1:28:59.75,1:29:02.67,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,1:29:17.43,1:29:19.77,Default,,0,0,0,,(Тыныс алу дауысы)
Dialogue: 0,1:29:33.28,1:29:35.11,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:29:35.20,1:29:37.16,Default,,0,0,0,,Ой! Хаха...
Dialogue: 0,1:29:39.99,1:29:42.08,Default,,0,0,0,,Мен кеттім! (Котецу) А... Уф...
Dialogue: 0,1:29:43.04,1:29:45.67,Default,,0,0,0,,Иә... у...
Dialogue: 0,1:29:47.04,1:29:47.92,Default,,0,0,0,,(күлімсіреген дауыс)
Dialogue: 0,1:29:49.84,1:29:50.67,Default,,0,0,0,,(ұялған күлген дауыс)
Dialogue: 0,1:29:55.55,1:29:57.64,Default,,0,0,0,,Сіз тағы да бірдеңе жасадыңыз.
Dialogue: 0,1:29:57.72,1:30:00.52,Default,,0,0,0,,Мен бұл жолы жұмыс істемейтін шығар деп ойладым.
Dialogue: 0,1:30:01.10,1:30:03.31,Default,,0,0,0,,Соғыс кезінде сіз бұл туралы ойладыңыз ба?
Dialogue: 0,1:30:03.39,1:30:04.44,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:04.52,1:30:07.27,Default,,0,0,0,,Оригами-сан шынымен теріс, солай емес пе?
Dialogue: 0,1:30:07.36,1:30:08.48,Default,,0,0,0,,Хмм, жарай…
Dialogue: 0,1:30:08.56,1:30:11.53,Default,,0,0,0,,Ол сондай, соның ішінде осындай нәрселер.
Dialogue: 0,1:30:11.61,1:30:14.90,Default,,0,0,0,,Мен... оның ішінде өзім де көремін.
Dialogue: 0,1:30:15.41,1:30:18.41,Default,,0,0,0,,Бұл дұрыс па? Бұл жақсы ма?
Dialogue: 0,1:30:18.49,1:30:19.66,Default,,0,0,0,,ше? Не?
Dialogue: 0,1:30:19.74,1:30:21.54,Default,,0,0,0,,А, жоқ... жақсы.
Dialogue: 0,1:30:21.62,1:30:23.45,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,1:30:23.54,1:30:25.08,Default,,0,0,0,,Аха ахаха... (Барлығы күледі)
Dialogue: 0,1:30:25.16,1:30:28.92,Default,,0,0,0,,О, мен шошып кеттім! Бұл жолы сәттілік!
Dialogue: 0,1:30:29.00,1:30:31.00,Default,,0,0,0,,Барлық кейіпкерлерден күткендей!
Dialogue: 0,1:30:31.09,1:30:33.26,Default,,0,0,0,,Ең ностальгиялық Жолбарыс пен Барнаби⸺
Dialogue: 0,1:30:33.34,1:30:35.30,Default,,0,0,0,,Комбинациялық ойын жарқырап тұрды!
Dialogue: 0,1:30:35.38,1:30:37.80,Default,,0,0,0,,Дуэт... иә?
Dialogue: 0,1:30:37.89,1:30:38.85,Default,,0,0,0,,Иә... иә
Dialogue: 0,1:30:38.93,1:30:40.97,Default,,0,0,0,,Кішіпейіл болма!
Dialogue: 0,1:30:41.06,1:30:43.81,Default,,0,0,0,,Өте жақсы болды! Сіз қалай ойлайсыз?
Dialogue: 0,1:30:43.89,1:30:46.14,Default,,0,0,0,,Осы уақытта трио құру туралы не айтуға болады?
Dialogue: 0,1:30:46.23,1:30:47.27,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:47.35,1:30:50.02,Default,,0,0,0,,Райан және Барнаби Виз Жолбарыс
Dialogue: 0,1:30:50.11,1:30:51.32,Default,,0,0,0,,Ах! Ерекшелік?
Dialogue: 0,1:30:51.40,1:30:52.78,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:30:52.86,1:30:55.65,Default,,0,0,0,,Жоқ, комбинация ретінде жанданған дұрыс.
Dialogue: 0,1:30:56.24,1:30:56.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:56.95,1:30:58.66,Default,,0,0,0,,Сәлем! камера!
Dialogue: 0,1:30:59.70,1:31:01.78,Default,,0,0,0,,Дахаха! Шын мәнінде, бұл дұрыс!
Dialogue: 0,1:31:01.87,1:31:04.79,Default,,0,0,0,,Негізі, мен оны әу бастан білетінмін.
Dialogue: 0,1:31:04.87,1:31:06.29,Default,,0,0,0,,Бұл балалар керемет!
Dialogue: 0,1:31:06.37,1:31:07.50,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:07.58,1:31:10.71,Default,,0,0,0,,Ендеше, балалар жақсы рөлде белсенді рөл атқара аласыздар деп үміттенемін...
Dialogue: 0,1:31:10.79,1:31:12.17,Default,,0,0,0,,Камера!
Dialogue: 0,1:31:12.25,1:31:17.05,Default,,0,0,0,,Мен саған гүл алып келдім, рахмет!
Dialogue: 0,1:31:17.13,1:31:18.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:18.22,1:31:21.30,Default,,0,0,0,,Тыңдаңыз! Бұл Райанның кеңесі.
Dialogue: 0,1:31:22.22,1:31:24.68,Default,,0,0,0,,Бұл жігітке керек жалғыз серіктес - сен.
Dialogue: 0,1:31:25.73,1:31:26.77,Default,,0,0,0,,Аа...!
Dialogue: 0,1:31:28.02,1:31:30.44,Default,,0,0,0,,Екеуің не істейсіңдер?
Dialogue: 0,1:31:30.52,1:31:33.94,Default,,0,0,0,,Бірақ өзіміз шеше алмаймыз...
Dialogue: 0,1:31:34.03,1:31:36.24,Default,,0,0,0,,Мен мақұлдаймын
Dialogue: 0,1:31:36.32,1:31:38.49,Default,,0,0,0,,Барлығыңызға жақсылық жасаңыз
Dialogue: 0,1:31:38.57,1:31:41.12,Default,,0,0,0,,Бұрын мен, Агнес Жубер,
Dialogue: 0,1:31:41.20,1:31:44.87,Default,,0,0,0,,Барлық билік Шнайдер мырзаға тапсырылды!
Dialogue: 0,1:31:44.95,1:31:46.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:46.66,1:31:49.92,Default,,0,0,0,,Жарайды, иесі осы күйде.
Dialogue: 0,1:31:50.00,1:31:53.21,Default,,0,0,0,,Сіздің өкіл ретінде мен екеуінің қайтарылуын мақұлдаймын!
Dialogue: 0,1:31:53.29,1:31:54.88,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:31:54.96,1:31:56.51,Default,,0,0,0,,Эй... Эй... Бір минут күте тұрыңыз!
Dialogue: 0,1:31:56.59,1:31:58.88,Default,,0,0,0,,Әлі дайын емессіз бе?
Dialogue: 0,1:31:58.97,1:32:01.14,Default,,0,0,0,,О... жоқ, өйткені
Dialogue: 0,1:32:01.97,1:32:04.72,Default,,0,0,0,,Мен бұрынғыдан ерекшемін дейсіз бе?
Dialogue: 0,1:32:04.81,1:32:06.64,Default,,0,0,0,,Қабілет бір минутқа ғана созылады...
Dialogue: 0,1:32:06.72,1:32:07.89,Default,,0,0,0,,Жолбарыс
Dialogue: 0,1:32:13.02,1:32:15.27,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,1:32:19.20,1:32:20.99,Default,,0,0,0,,Жабайы жолбарыс шыбындары
Dialogue: 0,1:32:21.07,1:32:24.08,Default,,0,0,0,,Қиындыққа тап болдым, көмектестің.
Dialogue: 0,1:32:24.16,1:32:27.79,Default,,0,0,0,,Сондықтан Жабайы жолбарыс батыр!
Dialogue: 0,1:32:28.29,1:32:32.38,Default,,0,0,0,,Иә! Саған қарау маған қуат береді.
Dialogue: 0,1:32:32.46,1:32:34.21,Default,,0,0,0,,Бір минуттың өзі жақсы!
Dialogue: 0,1:32:34.29,1:32:36.59,Default,,0,0,0,,Мен сенің ақымақ сияқты әрекет еткеніңді көргім келеді!
Dialogue: 0,1:32:36.67,1:32:38.67,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,1:32:38.76,1:32:40.93,Default,,0,0,0,,Жолбарыс! (Көрермендердегі әйел) Иә, солай!
Dialogue: 0,1:32:41.01,1:32:43.43,Default,,0,0,0,,Біздің үлкендер - біздің кумиріміз!
Dialogue: 0,1:32:43.51,1:32:49.43,Default,,0,0,0,,Жолбарыс жолбарысы! Жолбарыс Жолбарыс Жолбарыс!
Dialogue: 0,1:32:52.02,1:32:55.06,Default,,0,0,0,,Бұл керемет, Жолбарыс-сан.
Dialogue: 0,1:32:55.15,1:32:57.94,Default,,0,0,0,,Мен қаншама адамды ауыстырдым.
Dialogue: 0,1:32:58.03,1:33:00.95,Default,,0,0,0,,Қараңызшы, бәрі айтып жатыр!
Dialogue: 0,1:33:01.03,1:33:05.28,Default,,0,0,0,,Уф...
Dialogue: 0,1:33:05.37,1:33:06.70,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:33:13.42,1:33:15.42,Default,,0,0,0,,Мен бұл ағыннан бас тарта алмаймын.
Dialogue: 0,1:33:16.04,1:33:17.42,Default,,0,0,0,,L өліпті
Dialogue: 0,1:33:17.50,1:33:19.80,Default,,0,0,0,,Себебі сен мені ерекше етіп көрсетесің
Dialogue: 0,1:33:20.84,1:33:24.68,Default,,0,0,0,,Фу…
Dialogue: 0,1:33:25.93,1:33:29.68,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:33:33.89,1:33:36.02,Default,,0,0,0,,Енді міне...
Dialogue: 0,1:33:36.11,1:33:39.07,Default,,0,0,0,,Жолбарыс пен Барнаби оралды!
Dialogue: 0,1:33:39.15,1:33:42.32,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:33:50.37,1:33:53.21,Default,,0,0,0,,Содан кейін, келесі Кабураги (Каэде), жарайды.
Dialogue: 0,1:33:54.04,1:33:56.71,Default,,0,0,0,,«Сүн Каэде Кабураги»
Dialogue: 0,1:33:57.59,1:33:58.71,Default,,0,0,0,,«Бұл күн».
Dialogue: 0,1:33:58.79,1:34:02.09,Default,,0,0,0,,«Бұл аспанда жарқыраған күн ғана емес».
Dialogue: 0,1:34:02.17,1:34:04.47,Default,,0,0,0,,«Бұл жай ғана жүгіріп келе жатқан жолбарыс».
Dialogue: 0,1:34:04.55,1:34:06.84,Default,,0,0,0,,«Бұл қоян жоғары-төмен секіреді».
Dialogue: 0,1:34:06.93,1:34:09.22,Default,,0,0,0,,«Бұл жарқыраған мұз».
Dialogue: 0,1:34:09.85,1:34:11.72,Default,,0,0,0,,«Жел соғып тұрғандай».
Dialogue: 0,1:34:12.39,1:34:14.23,Default,,0,0,0,,«Бұл жанып тұрған жалын»
Dialogue: 0,1:34:14.31,1:34:16.48,Default,,0,0,0,,«Бұл сиыр моо-му деп айқайлайды».
Dialogue: 0,1:34:17.06,1:34:18.73,Default,,0,0,0,,«Бұл дрон сияқты өзгеретін көлеңке».
Dialogue: 0,1:34:19.32,1:34:21.65,Default,,0,0,0,,«Тіпті жарқыраған найзағай»
Dialogue: 0,1:34:22.15,1:34:23.90,Default,,0,0,0,,«Әркім әртүрлі».
Dialogue: 0,1:34:23.99,1:34:26.70,Default,,0,0,0,,«Барлығы күнді жағады»
Dialogue: 0,1:34:26.78,1:34:27.99,Default,,0,0,0,,«Кейде қайғылы»
Dialogue: 0,1:34:28.78,1:34:32.20,Default,,0,0,0,,«Бұл өте ауыр және мен өзімді депрессия сезінемін».
Dialogue: 0,1:34:32.29,1:34:35.87,Default,,0,0,0,,«Бір күні бәрінің күні шығады».
Dialogue: 0,1:34:35.96,1:34:38.50,Default,,0,0,0,,«Күн шыққан сайын»
Dialogue: 0,1:34:39.46,1:34:41.13,Default,,0,0,0,,«Күн кез келген уақытта шығады»
Dialogue: 0,1:34:41.71,1:34:43.01,Default,,0,0,0,,«Бүгін және ертең»
Dialogue: 0,1:34:43.09,1:34:44.88,Default,,0,0,0,,«Күн шығады»
Dialogue: 0,1:34:48.09,1:34:51.10,Default,,0,0,0,,(♪ ~Соңындағы ән)
Dialogue: 0,1:35:09.45,1:35:11.62,Default,,0,0,0,,♪ Мен сені сағындым
Dialogue: 0,1:35:11.70,1:35:14.08,Default,,0,0,0,,♪ Қанша?
Dialogue: 0,1:35:14.58,1:35:16.75,Default,,0,0,0,,♪ Бар еркіңізбен бір нәрсені жасаңыз
Dialogue: 0,1:35:16.83,1:35:19.96,Default,,0,0,0,,♪ Мен мұны істеймін.
Dialogue: 0,1:35:20.04,1:35:22.25,Default,,0,0,0,,♪ Мені төмендік комплексі қызықтырмайды
Dialogue: 0,1:35:22.34,1:35:24.59,Default,,0,0,0,,♪ Бұл анық
Dialogue: 0,1:35:25.17,1:35:27.43,Default,,0,0,0,,♪ Мен сені қуамын
Dialogue: 0,1:35:27.51,1:35:29.89,Default,,0,0,0,,♪ Мүмкін мен өлгенше
Dialogue: 0,1:35:30.47,1:35:31.60,Default,,0,0,0,,♪ Өте көп
Dialogue: 0,1:35:31.68,1:35:35.89,Default,,0,0,0,,♪ Менде мақтанатын ештеңе жоқ.
Dialogue: 0,1:35:35.98,1:35:38.14,Default,,0,0,0,,♪ Бүгін де
Dialogue: 0,1:35:38.23,1:35:40.98,Default,,0,0,0,,♪ Бірте-бірте жүру
Dialogue: 0,1:35:41.06,1:35:43.57,Default,,0,0,0,,♪ Күдік пен ұят)
Dialogue: 0,1:35:43.65,1:35:46.44,Default,,0,0,0,,♪ Егер сіз байланған болсаңыз
Dialogue: 0,1:35:46.53,1:35:48.78,Default,,0,0,0,,♪ Мен сурет саламын декорацияға
Dialogue: 0,1:35:48.86,1:35:51.78,Default,,0,0,0,,♪ Ол келмейді.
Dialogue: 0,1:35:51.87,1:35:53.49,Default,,0,0,0,,♪ Үйлестірілген финал
Dialogue: 0,1:35:53.58,1:35:56.50,Default,,0,0,0,,♪ Шоқжұлдызға айналу
Dialogue: 0,1:35:57.12,1:36:01.92,Default,,0,0,0,,♪ Көп тілектерді арқау
Dialogue: 0,1:36:02.00,1:36:04.55,Default,,0,0,0,,♪ Біреуді құтқарғыңыз келе ме?
Dialogue: 0,1:36:04.63,1:36:07.26,Default,,0,0,0,,♪ Мен сені күлдіргім келеді
Dialogue: 0,1:36:07.34,1:36:12.89,Default,,0,0,0,,♪ Уақыт сағатында тым жылдам
Dialogue: 0,1:36:12.97,1:36:17.64,Default,,0,0,0,,♪ Мәңгілік болса екен деп тілеймін
Dialogue: 0,1:36:18.14,1:36:19.27,Default,,0,0,0,,♪ Соңы
Dialogue: 0,1:36:19.35,1:36:23.56,Default,,0,0,0,,♪Мен оның жақындағанын көріп тұрмын
Dialogue: 0,1:36:23.65,1:36:25.52,Default,,0,0,0,,♪ Маңызды сөз болса
Dialogue: 0,1:36:25.61,1:36:28.53,Default,,0,0,0,,♪ Қалтаңда тыныш күтіп отырмын
Dialogue: 0,1:36:28.61,1:36:31.20,Default,,0,0,0,,♪ Қош бол сау бол
Dialogue: 0,1:36:31.28,1:36:33.41,Default,,0,0,0,,♪ Тағы да осы жерден
Dialogue: 0,1:36:33.49,1:36:35.53,Default,,0,0,0,,♪ Басталып жатыр
Dialogue: 0,1:36:35.62,1:36:40.25,Default,,0,0,0,,♪ Бір мезгілде туындайтын мәселелер туралы алаңдауға тырысу
Dialogue: 0,1:36:40.75,1:36:41.25,Default,,0,0,0,,♪ Екіжүзді болып көрінбе
Dialogue: 0,1:36:41.25,1:36:42.25,Default,,0,0,0,,♪ Екіжүзді сияқты әрекет ету «Оқиға ұсынысы Hero TV Spring»
Dialogue: 0,1:36:42.25,1:36:42.33,Default,,0,0,0,,♪ Екіжүзді болып көрінбе
Dialogue: 0,1:36:42.33,1:36:43.13,Default,,0,0,0,,♪ Екіжүзді болып көріну – «арнайы бағдарламалау»
Dialogue: 0,1:36:43.21,1:36:45.17,Default,,0,0,0,,♪ Жүректі ауыртатын «Жабайы жолбарыстың арнайы оралуы»
Dialogue: 0,1:36:45.17,1:36:46.00,Default,,0,0,0,,♪ Жүрегім ауырады
Dialogue: 0,1:36:46.09,1:36:48.42,Default,,0,0,0,,♪ Барлық адамдар көреді
Dialogue: 0,1:36:48.51,1:36:51.30,Default,,0,0,0,,♪ Менің ойымша, бұл солай.
Dialogue: 0,1:36:51.38,1:36:56.64,Default,,0,0,0,,♪ Мен де сонда өмір сүріп жатырмын.
Dialogue: 0,1:36:56.72,1:37:00.35,Default,,0,0,0,,♪ Әдемі және әдемі көрініңіз
Dialogue: 0,1:37:00.43,1:37:01.98,Default,,0,0,0,,♪ Безендіруден кейін
Dialogue: 0,1:37:02.06,1:37:05.77,Default,,0,0,0,,♪ Керемет әдемі жауап
Dialogue: 0,1:37:05.86,1:37:07.15,Default,,0,0,0,,♪ Ол шығады, бірақ
Dialogue: 0,1:37:07.23,1:37:09.78,Default,,0,0,0,,♪ Үлкен босқа
Dialogue: 0,1:37:09.86,1:37:12.57,Default,,0,0,0,,♪ Мен қанағаттанудан көбірек қорқамын
Dialogue: 0,1:37:12.66,1:37:17.99,Default,,0,0,0,,♪ Өзіңіз салған декорацияны кездейсоқ бұзбаңыз.
Dialogue: 0,1:37:18.08,1:37:19.95,Default,,0,0,0,,♪ Үйлестірілген финал
Dialogue: 0,1:37:20.04,1:37:22.83,Default,,0,0,0,,Қосылу
Dialogue: 0,1:37:23.33,1:37:27.92,Default,,0,0,0,,♪ Көп әуендер ойға оралады
Dialogue: 0,1:37:28.00,1:37:30.84,Default,,0,0,0,,♪ Кейде ол музыкалық партитураға айналады
Dialogue: 0,1:37:30.92,1:37:33.51,Default,,0,0,0,,♪ Жүрегіңізге ақырын ойып жазыңыз
Dialogue: 0,1:37:33.59,1:37:39.10,Default,,0,0,0,,♪ Ешқашан өшпейтін тұрақты фотосурет сияқты
Dialogue: 0,1:37:39.18,1:37:44.35,Default,,0,0,0,,♪ Дұрыс, сізге де жетеді.
Dialogue: 0,1:37:44.44,1:37:48.23,Default,,0,0,0,,♪ Екеуміз бөлек болсақ та жарайды
Dialogue: 0,1:37:48.32,1:37:49.73,Default,,0,0,0,,♪ Ән айт
Dialogue: 0,1:37:49.82,1:37:51.86,Default,,0,0,0,,♪ Маңызды сөздер де
Dialogue: 0,1:37:51.94,1:37:54.66,Default,,0,0,0,,♪ Саған кездейсоқ көлік ұсынсам болады ма?
Dialogue: 0,1:37:54.74,1:37:57.37,Default,,0,0,0,,♪ Рахмет Рахмет
Dialogue: 0,1:37:57.45,1:37:59.41,Default,,0,0,0,,♪ Біз қайта кездескенше
Dialogue: 0,1:37:59.49,1:38:01.83,Default,,0,0,0,,♪ Біз кездесетін күнге дейін
Dialogue: 0,1:38:02.71,1:38:06.13,Default,,0,0,0,,Маған мұхиттың арғы жағындағы миллионерден ұсыныс түсті.
Dialogue: 0,1:38:06.21,1:38:07.29,Default,,0,0,0,,Қараңыз!
Dialogue: 0,1:38:07.38,1:38:07.88,Default,,0,0,0,,(Сіз естімейтін жұмсақ дауыс)
Dialogue: 0,1:38:07.96,1:38:08.67,Default,,0,0,0,,Өте көп!
Dialogue: 0,1:38:09.25,1:38:10.80,Default,,0,0,0,,Осындай ақымақ жерде
Dialogue: 0,1:38:10.88,1:38:12.76,Default,,0,0,0,,Неліктен мен мұны істей алмаймын?
Dialogue: 0,1:38:12.84,1:38:14.30,Default,,0,0,0,,Сонымен! Сонда кездескенше!
Dialogue: 0,1:38:14.38,1:38:16.18,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:38:17.14,1:38:19.51,Default,,0,0,0,,Өкініштісі, бұл жаман компания болды!
Dialogue: 0,1:38:20.01,1:38:21.43,Default,,0,0,0,,Сәлем? (Бен Сайто) Иә.
Dialogue: 0,1:38:21.52,1:38:23.39,Default,,0,0,0,,♪ Үйлестірілген финал
Dialogue: 0,1:38:23.48,1:38:26.52,Default,,0,0,0,,♪ Шоқжұлдызға айналу
Dialogue: 0,1:38:27.02,1:38:31.69,Default,,0,0,0,,♪ Бортта көптеген тілектермен
Dialogue: 0,1:38:31.78,1:38:34.40,Default,,0,0,0,,♪ Мен біреуді жақсы көргім келеді
Dialogue: 0,1:38:34.49,1:38:37.11,Default,,0,0,0,,♪ Мен сенімен бірге күлгім келеді
Dialogue: 0,1:38:37.20,1:38:42.66,Default,,0,0,0,,♪ Нұрға оранған қалада
Dialogue: 0,1:38:42.75,1:38:47.50,Default,,0,0,0,,♪ Себепсіз көз жасы бар
Dialogue: 0,1:38:48.00,1:38:50.59,Default,,0,0,0,,♪ Осыны ойлай берсең
Dialogue: 0,1:38:50.67,1:38:53.42,Default,,0,0,0,,♪ Қайта кездесетінімізге сенімдімін
Dialogue: 0,1:38:53.51,1:38:55.63,Default,,0,0,0,,♪ Қазір маңызды сөздер
Dialogue: 0,1:38:55.72,1:38:58.34,Default,,0,0,0,,♪ Жақсы болмасам да, айтуым керек
Dialogue: 0,1:38:58.43,1:39:03.68,Default,,0,0,0,,♪ Біреуді байланыстыратын жұлдызды аспан астында
Dialogue: 0,1:39:03.77,1:39:06.35,Default,,0,0,0,,♪ Рахмет Рахмет
Dialogue: 0,1:39:06.44,1:39:08.44,Default,,0,0,0,,♪ Тағы да осы жерден
Dialogue: 0,1:39:08.52,1:39:11.65,Default,,0,0,0,,♪ Басталып жатыр
Dialogue: 0,1:39:11.73,1:39:13.98,Default,,0,0,0,,♪ О~
Dialogue: 0,1:39:14.07,1:39:16.61,Default,,0,0,0,,♪ Бүгін - бүгін
Dialogue: 0,1:39:16.70,1:39:21.58,Default,,0,0,0,,♪ Бұл жалғасады деп үміттенемін
Dialogue: 0,1:39:30.63,1:39:32.84,Default,,0,0,0,,♪ Сізбен бірге болыңыз
Dialogue: 0,1:39:32.92,1:39:35.63,Default,,0,0,0,,♪ Қанша?
Dialogue: 0,1:39:35.71,1:39:38.05,Default,,0,0,0,,♪ Жаңа дәуірге қарай
Dialogue: 0,1:39:38.13,1:39:41.10,Default,,0,0,0,,♪ Көпір салынады
Dialogue: 0,1:39:41.18,1:39:43.35,Default,,0,0,0,,♪ Қанша рет жақсы болсам да
Dialogue: 0,1:39:43.43,1:39:46.23,Default,,0,0,0,,♪ Мен әлі де тұра аламын.
Dialogue: 0,1:39:46.31,1:39:48.69,Default,,0,0,0,,♪ Мен сені қуамын
Dialogue: 0,1:39:48.77,1:39:51.31,Default,,0,0,0,,♪ Сол болашаққа дейін
Dialogue: 0,1:39:51.40,1:39:54.65,Default,,0,0,0,,(Соңғы ән ~♪ )
Dialogue: 0,1:40:05.79,1:40:08.21,Default,,0,0,0,,Әй, мен сонда барамын...
Dialogue: 0,1:40:08.29,1:40:09.25,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:40:20.47,1:40:23.26,Default,,0,0,0,,(Мотоциклдің кетіп бара жатқан дыбысы)
Dialogue: 0,1:40:24.76,1:40:30.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory