Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.02,0:00:25.35,Default,,0,0,0,,Менің атым Фридли.
Dialogue: 0,0:00:25.35,0:00:28.86,Default,,0,0,0,,Тауық асыл герцог Фридли!
Dialogue: 0,0:00:28.86,0:00:31.86,Default,,0,0,0,,Болашақ жойылудан аулақ болғаннан кейін➨
Dialogue: 0,0:00:31.86,0:00:35.03,Default,,0,0,0,,Ол жарқын болашақты билейді.
Dialogue: 0,0:00:35.03,0:00:37.03,Default,,0,0,0,,Коккоккококо….
Dialogue: 0,0:00:37.03,0:00:41.70,Default,,0,0,0,,Раку-сан тауық ақсүйегі! ? Қарғыс атқыр...Биік жағаны түсінбеймін!
Dialogue: 0,0:00:41.70,0:00:43.71,Default,,0,0,0,,Бұл не үлкен нәрсе? ?
Dialogue: 0,0:00:43.71,0:00:45.87,Default,,0,0,0,,Куродама жатақханасы қирады!
Dialogue: 0,0:00:45.87,0:00:49.88,Default,,0,0,0,,Рождестволық мереке де үйінді астында қалды...
Dialogue: 0,0:00:49.88,0:00:52.21,Default,,0,0,0,,Сізді алаңдататын тағы бір нәрсе бар ма?
Dialogue: 0,0:00:52.21,0:00:54.72,Default,,0,0,0,,Бірінші кезекте тауық сөйлейді...
Dialogue: 0,0:00:54.72,0:00:57.72,Default,,0,0,0,,өте қалыпты ма? null?
Dialogue: 0,0:00:57.72,0:01:01.89,Default,,0,0,0,,Ракуай Коишикава Мастер лагерінің иесі...! ?
Dialogue: 0,0:01:01.89,0:01:04.83,Default,,0,0,0,,Раббым! неге мұндасың?
Dialogue: 0,0:01:04.83,0:01:08.33,Default,,0,0,0,,Әрине, уәде етілген күнді қарсы алу үшін.
Dialogue: 0,0:01:08.33,0:01:11.67,Default,,0,0,0,,Тарихтағы ауысу нүктесі: Торадер бұрылыс нүктесі➨
Dialogue: 0,0:01:11.67,0:01:14.34,Default,,0,0,0,,Тайшо дәуірінде бұл қас қалада!
Dialogue: 0,0:01:14.34,0:01:18.17,Default,,0,0,0,,Уәде етілген күн? Трейдер бұрылыс нүктесі?
Dialogue: 0,0:01:18.17,0:01:22.34,Default,,0,0,0,,Иә! Бүгінгі күні жойылу болашағы жойылады!
Dialogue: 0,0:01:22.34,0:01:25.01,Default,,0,0,0,,Балалар сендер жақсы биледіңдер.
Dialogue: 0,0:01:25.01,0:01:28.02,Default,,0,0,0,,Алақанымда.
Dialogue: 0,0:01:28.02,0:01:30.02,Default,,0,0,0,,Пальма?
Dialogue: 0,0:01:30.02,0:01:32.52,Default,,0,0,0,,Кококкококококо….
Dialogue: 0,0:01:32.52,0:01:34.52,Default,,0,0,0,,Кококкококококо…. Сізге ше?
Dialogue: 0,0:01:34.52,0:01:36.53,Default,,0,0,0,,Олар бізге шабуыл жасады. Кококкококококо...
Dialogue: 0,0:01:36.53,0:01:38.53,Default,,0,0,0,,Біз оны болдырмау үшін осылай істеуіміз керек➨
Dialogue: 0,0:01:38.53,0:01:41.36,Default,,0,0,0,,Жоюдың болашағы қандай? ? Кококкококококо...
Dialogue: 0,0:01:41.36,0:01:44.03,Default,,0,0,0,,Алыс болашақ...
Dialogue: 0,0:01:44.03,0:01:46.03,Default,,0,0,0,,Жердің билеушісі➨
Dialogue: 0,0:01:46.03,0:01:49.54,Default,,0,0,0,,Кукко жоғары дамыған жануарларға айналды!
Dialogue: 0,0:01:49.54,0:01:51.54,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:01:51.54,0:01:53.88,Default,,0,0,0,,Жануарлардың ақыл-ойы керемет➨
Dialogue: 0,0:01:53.88,0:01:56.04,Default,,0,0,0,,Ол қоғамды басқарды.
Dialogue: 0,0:01:56.04,0:01:59.55,Default,,0,0,0,,Жануарлар бұл жердің билеушісі ме?
Dialogue: 0,0:01:59.55,0:02:02.65,Default,,0,0,0,,Жоюдың болашағы қандай болуы керек, оны болдырмау керек➨
Dialogue: 0,0:02:02.65,0:02:05.65,Default,,0,0,0,,Адамзаттың жойылуы! ? (5 адам) Не! ?
Dialogue: 0,0:02:05.65,0:02:08.49,Default,,0,0,0,,Адамзат жақсы жұмыс істейді. сурет?
Dialogue: 0,0:02:08.49,0:02:12.49,Default,,0,0,0,,Иә, өткені мен болашағы, бүкіл адамзат➨
Dialogue: 0,0:02:12.49,0:02:15.00,Default,,0,0,0,,Бізді сүрте бересің, еркексің.
Dialogue: 0,0:02:15.00,0:02:17.50,Default,,0,0,0,,Ха! ?
Dialogue: 0,0:02:17.50,0:02:21.00,Default,,0,0,0,,Жетілдірілген интеллектпен жерді басқар➨
Dialogue: 0,0:02:21.00,0:02:24.34,Default,,0,0,0,,Қоғамды құратын біздің қызметшілеріміз➨
Dialogue: 0,0:02:24.34,0:02:27.01,Default,,0,0,0,,Адам нәсілі. (Барлығы) Ха! ?
Dialogue: 0,0:02:27.01,0:02:29.01,Default,,0,0,0,,Иә, адамшылық деген не➨
Dialogue: 0,0:02:29.01,0:02:31.51,Default,,0,0,0,,Күнделікті өмірімізге көңіл бөліңіз➨
Dialogue: 0,0:02:31.51,0:02:35.18,Default,,0,0,0,,Шаршағаныңды сауықтырып, нәр аласың.
Dialogue: 0,0:02:35.18,0:02:38.85,Default,,0,0,0,,Ха! ? Адамдар жануарлардың қызметшісі...
Dialogue: 0,0:02:38.85,0:02:43.19,Default,,0,0,0,,Иә? Мүмкін бұл жаман емес шығар? сөзсіз!
Dialogue: 0,0:02:43.19,0:02:45.19,Default,,0,0,0,,Сүйкімді жануарларға қамқорлық жасаңыз➨
Dialogue: 0,0:02:45.19,0:02:49.20,Default,,0,0,0,,Күріш жеу өте жақсы болар еді!
Dialogue: 0,0:02:49.20,0:02:51.20,Default,,0,0,0,,Егер бұл болашақ жойылу болса...
Dialogue: 0,0:02:51.20,0:02:56.37,Default,,0,0,0,,Ақымақ! Төменгі адамдар үшін бізге қызмет ету - бұл бата.
Dialogue: 0,0:02:56.37,0:02:59.21,Default,,0,0,0,,Шынайы жойылудың болашағы Яғни...
Dialogue: 0,0:02:59.21,0:03:01.21,Default,,0,0,0,,Гүлп….
Dialogue: 0,0:03:01.21,0:03:07.15,Default,,0,0,0,,Қоғамда ит пен мысық тұрған болашақ!
Dialogue: 0,0:03:07.15,0:03:09.15,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:03:09.15,0:03:11.15,Default,,0,0,0,,Жерді басқаратын өкіл –➨
Dialogue: 0,0:03:11.15,0:03:13.66,Default,,0,0,0,,Адамзаттың дауыс беруімен таңдалған.
Dialogue: 0,0:03:13.66,0:03:15.99,Default,,0,0,0,,Ал таңдалғаны➨
Dialogue: 0,0:03:15.99,0:03:17.99,Default,,0,0,0,,Бұл мысық пен ит болды!
Dialogue: 0,0:03:17.99,0:03:23.50,Default,,0,0,0,,Адамзаттың үлкен қолдауымен мысықтар мен иттер нағыз таңдалған тіршілік иелері.
Dialogue: 0,0:03:23.50,0:03:27.67,Default,,0,0,0,,Оның артында мен мәңгілік 3-ші болып қалуға қанағаттанамын➨
Dialogue: 0,0:03:27.67,0:03:30.34,Default,,0,0,0,,Қайғылы жарыс Бұл...
Dialogue: 0,0:03:30.34,0:03:32.64,Default,,0,0,0,,Біз құспыз!
Dialogue: 0,0:03:35.18,0:03:38.51,Default,,0,0,0,,Адамдар... аяқтарыңыздағы әжімдерде қорқынышты нәрсе бар➨
Dialogue: 0,0:03:38.51,0:03:42.02,Default,,0,0,0,,Басыма нәжіс түсіп кеткенін түсінсем, басамын ба деп қорқамын➨
Dialogue: 0,0:03:42.02,0:03:45.02,Default,,0,0,0,,Шыдамның шегіне жеттім!
Dialogue: 0,0:03:45.02,0:03:47.36,Default,,0,0,0,,Неліктен мысықтар мен иттерді ғана жақсы көреді? ?
Dialogue: 0,0:03:47.36,0:03:49.36,Default,,0,0,0,,Адамзатты мақтауға маманданған➨
Dialogue: 0,0:03:49.36,0:03:52.19,Default,,0,0,0,,Оның айлакер аң екенін неге түсінбейсің! ?
Dialogue: 0,0:03:52.19,0:03:54.20,Default,,0,0,0,,Аа….
Dialogue: 0,0:03:54.20,0:03:58.87,Default,,0,0,0,,Мен мысықтарға, иттерге және адамзатқа көтерілуді шештім!
Dialogue: 0,0:03:58.87,0:04:01.70,Default,,0,0,0,,Өткенге оралып, тарихты қайта қарастырыңыз!
Dialogue: 0,0:04:01.70,0:04:05.14,Default,,0,0,0,,Осы мақсатта құстар туралы ғылымнан алынған ұпайлар➨
Dialogue: 0,0:04:05.14,0:04:07.98,Default,,0,0,0,,Бұл трейдер торабы.
Dialogue: 0,0:04:07.98,0:04:12.65,Default,,0,0,0,,Ал жоспарлау үшін сегіз тұмсық, сегіз қанатым бар➨
Dialogue: 0,0:04:12.65,0:04:15.65,Default,,0,0,0,,Мысық пен ит агенті ретінде жіберілгені➨
Dialogue: 0,0:04:15.65,0:04:18.49,Default,,0,0,0,,Олардың екеуі бар. null? Болады! ?
Dialogue: 0,0:04:18.49,0:04:21.66,Default,,0,0,0,,Екеуі де бастығының құс екенін білмеді➨
Dialogue: 0,0:04:21.66,0:04:24.16,Default,,0,0,0,,Сіз өте жақсы биледіңіз.
Dialogue: 0,0:04:24.16,0:04:28.00,Default,,0,0,0,,Нуруру Бұл алынды.
Dialogue: 0,0:04:28.00,0:04:30.50,Default,,0,0,0,,Дұрысы, менің бастығым неге құс?
Dialogue: 0,0:04:30.50,0:04:33.84,Default,,0,0,0,,Сіз байқамадыңыз ба? Уау, нағыз иесімен кездесу➨
Dialogue: 0,0:04:33.84,0:04:36.17,Default,,0,0,0,,Негізі, бұл менің кемпингке бірінші рет шығуым.
Dialogue: 0,0:04:36.17,0:04:42.18,Default,,0,0,0,,Қашықтағы камера өшірілген, сондықтан мен тек дауысты ести алдым.
Dialogue: 0,0:04:42.18,0:04:47.02,Default,,0,0,0,,Сіздің жанжал, былайша айтқанда, мысықтар мен иттер арасындағы прокси соғысы.
Dialogue: 0,0:04:47.02,0:04:50.69,Default,,0,0,0,,Сол ақымақ шайқастың өршуіне жол беру арқылы➨
Dialogue: 0,0:04:50.69,0:04:55.69,Default,,0,0,0,,Мысықтар мен иттермен күресу ақымақтық екенін Treader Junction бетіне ойып жазыңыз➨
Dialogue: 0,0:04:55.69,0:04:59.69,Default,,0,0,0,,Ал бұл құс мұнарасы құстардың радиотолқындарын шығарады➨
Dialogue: 0,0:04:59.69,0:05:01.70,Default,,0,0,0,,Жерге және адамзаттың жанына➨
Dialogue: 0,0:05:01.70,0:05:05.63,Default,,0,0,0,,Құстардың ең биік екенін ойып жаз!
Dialogue: 0,0:05:05.63,0:05:10.31,Default,,0,0,0,,Болашақ құстар билеген үміт әлемі болады!
Dialogue: 0,0:05:10.31,0:05:12.81,Default,,0,0,0,,Бұл не?! ?
Dialogue: 0,0:05:12.81,0:05:16.31,Default,,0,0,0,,Ал бүгін құстардың радиотолқындарына ең көп әсер етеді➨
Dialogue: 0,0:05:16.31,0:05:18.31,Default,,0,0,0,,Уәде етілген күн.
Dialogue: 0,0:05:18.31,0:05:21.65,Default,,0,0,0,,Сондықтан екеуіңді де өлтіруді мақсат еттім.
Dialogue: 0,0:05:21.65,0:05:26.49,Default,,0,0,0,,Ха! ? Сонда мені Синкуро Унзенге қатысты бірдеңемен арандатқан кім?
Dialogue: 0,0:05:26.49,0:05:31.16,Default,,0,0,0,,Бұл менің жоспарым. Қорғаныс министрлігі күйреу алдында тұрды...
Dialogue: 0,0:05:31.16,0:05:37.33,Default,,0,0,0,,Бұл менің де жоспарым. Төраға мен вице-төрағаға қарсы шыққаным...
Dialogue: 0,0:05:37.33,0:05:40.17,Default,,0,0,0,,Әрине, мұның бәрі менің жоспарым.
Dialogue: 0,0:05:40.17,0:05:43.67,Default,,0,0,0,,Біз шынымен де...
Dialogue: 0,0:05:43.67,0:05:47.01,Default,,0,0,0,,Ха! ? Сосын, қылыш соқпайды...
Dialogue: 0,0:05:47.01,0:05:49.51,Default,,0,0,0,,Оре-чан тым әдемі...
Dialogue: 0,0:05:49.51,0:05:51.85,Default,,0,0,0,,Мен жазаланғанда да...
Dialogue: 0,0:05:51.85,0:05:57.19,Default,,0,0,0,,Менің де қарным ашты... Биік жағам да биік жаға...
Dialogue: 0,0:05:57.19,0:05:59.19,Default,,0,0,0,,Мен бұл туралы білмеймін ...
Dialogue: 0,0:05:59.19,0:06:01.86,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:06:01.86,0:06:04.63,Default,,0,0,0,,Балалар, мен елестететін жаңа болашақсыңдар➨
Dialogue: 0,0:06:04.63,0:06:07.13,Default,,0,0,0,,Аузыңдағы қауырсынмен қара.
Dialogue: 0,0:06:07.13,0:06:09.80,Default,,0,0,0,,Коккокококококо….
Dialogue: 0,0:06:09.80,0:06:13.80,Default,,0,0,0,,Жоқ, ол ұшып кетпейді. Өйткені бұл тауық.
Dialogue: 0,0:06:13.80,0:06:17.97,Default,,0,0,0,,Алайда, қандай да бір себептермен, менің денем зақымданғандықтан әлі қозғала алмайды.
Dialogue: 0,0:06:17.97,0:06:22.48,Default,,0,0,0,,Биік жаға жеткіліксіз! Мұны бізге қалдырыңыз.
Dialogue: 0,0:06:22.48,0:06:26.82,Default,,0,0,0,,Енді мұны еркін сезініңіз. Қарғыс атқыр... сорғыз!
Dialogue: 0,0:06:26.82,0:06:29.52,Default,,0,0,0,,Мысық сорып жатыр Мысық сорып жатыр....
Dialogue: 0,0:06:31.49,0:06:34.59,Default,,0,0,0,,Нуруру~. Болады!
Dialogue: 0,0:06:36.83,0:06:39.66,Default,,0,0,0,,Жоғары жағаға оралыңыз!
Dialogue: 0,0:06:39.66,0:06:43.00,Default,,0,0,0,,Нуруру мысықтары - панацея.
Dialogue: 0,0:06:43.00,0:06:46.84,Default,,0,0,0,,Сондай-ақ, магистратура. Көктегі құшақ!
Dialogue: 0,0:06:46.84,0:06:49.17,Default,,0,0,0,,Аң….
Dialogue: 0,0:06:49.17,0:06:51.17,Default,,0,0,0,,Енді мен не істеуім керек...?
Dialogue: 0,0:06:51.17,0:06:55.34,Default,,0,0,0,,Оны осылай мүк етіп қалдыру дұрыс емес.
Dialogue: 0,0:06:55.34,0:06:57.51,Default,,0,0,0,,Дұрыс. Бұл әдемі емес.
Dialogue: 0,0:06:57.51,0:07:01.52,Default,,0,0,0,,Менің де қарным ашты! Бұған ашуланыңыз.
Dialogue: 0,0:07:01.52,0:07:03.95,Default,,0,0,0,,Әрине. Бұл да.
Dialogue: 0,0:07:03.95,0:07:06.79,Default,,0,0,0,,Жарайды, биік жағаға қарсы күресейік!
Dialogue: 0,0:07:06.79,0:07:09.29,Default,,0,0,0,,Бұл күлкілі... (Үнзен және басқалар) А...
Dialogue: 0,0:07:09.29,0:07:12.63,Default,,0,0,0,,Болашақ жойылуға қарсы тұру үшін билеуге мәжбүрлеу➨
Dialogue: 0,0:07:12.63,0:07:15.46,Default,,0,0,0,,Бұл жай ғана сайқымазақ!
Dialogue: 0,0:07:15.46,0:07:18.30,Default,,0,0,0,,Сот?
Dialogue: 0,0:07:18.30,0:07:20.50,Default,,0,0,0,,Мырза! төраға!
Dialogue: 0,0:07:24.97,0:07:27.98,Default,,0,0,0,,Сьюді маған қалдырыңыз. (Сукаю және т.б.) Ха...
Dialogue: 0,0:07:27.98,0:07:31.15,Default,,0,0,0,,Маған сеніңіз, мен сізді міндетті түрде қайтарамын!
Dialogue: 0,0:07:31.15,0:07:35.05,Default,,0,0,0,,Аа, неге бәрі осылай көрінеді?
Dialogue: 0,0:07:40.16,0:07:43.99,Default,,0,0,0,,Бұл не? Куродама жатақханасының айналасы емес пе?
Dialogue: 0,0:07:43.99,0:07:45.99,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:07:50.67,0:07:52.67,Default,,0,0,0,,Коккоккококо….
Dialogue: 0,0:07:52.67,0:07:57.01,Default,,0,0,0,,Мысықтар мен иттерге деген өшпенділік энергиясы да толығымен зарядталуға жақын!
Dialogue: 0,0:07:57.01,0:08:01.18,Default,,0,0,0,,Жоюдың болашағы енді үміттің болашағы...
Dialogue: 0,0:08:01.18,0:08:03.11,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:03.11,0:08:07.45,Default,,0,0,0,,Мен саған қалағаныңды істеуге рұқсат бермеймін! Хехе... келдің бе?
Dialogue: 0,0:08:07.45,0:08:10.79,Default,,0,0,0,,Сайып келгенде, сіз де болашақ адамдармен бірдей боласыз➨
Dialogue: 0,0:08:10.79,0:08:13.46,Default,,0,0,0,,Сонымен сіз мысықтар мен иттерді таңдадыңыз ба?
Dialogue: 0,0:08:13.46,0:08:16.29,Default,,0,0,0,,Жоқ, бұл маған бәрібір.
Dialogue: 0,0:08:16.29,0:08:19.29,Default,,0,0,0,,ше? Осындай ақымақ үлкен мұнара болса ➨
Dialogue: 0,0:08:19.29,0:08:22.30,Default,,0,0,0,,Көршіңіздің кірі кептірмейді!
Dialogue: 0,0:08:22.30,0:08:25.97,Default,,0,0,0,,ше? Маянан қаласының әдемі пейзажы бұзылады!
Dialogue: 0,0:08:25.97,0:08:30.31,Default,,0,0,0,,Жаңа жыл кешін қайда өткізуіміз керек? ? Крипа мерекесі!
Dialogue: 0,0:08:30.31,0:08:32.64,Default,,0,0,0,,Иә? Бұл себеп пе?
Dialogue: 0,0:08:32.64,0:08:35.14,Default,,0,0,0,,Біз де өз қалауымызша жасай аламыз.
Dialogue: 0,0:08:35.14,0:08:37.81,Default,,0,0,0,,Мырзаға шабуыл жасағаныңызды кешіремін!
Dialogue: 0,0:08:37.81,0:08:39.81,Default,,0,0,0,,Коккоккококо….
Dialogue: 0,0:08:39.81,0:08:43.15,Default,,0,0,0,,Бізден тамақ алғылары келетін ақымақ пенделер.
Dialogue: 0,0:08:43.15,0:08:46.15,Default,,0,0,0,,Хмф….
Dialogue: 0,0:08:46.15,0:08:48.32,Default,,0,0,0,,Жоқ... Емшек ет! ?
Dialogue: 0,0:08:48.32,0:08:51.99,Default,,0,0,0,,Жаңа болашаққа үмітсіздікті ұсыныңыз!
Dialogue: 0,0:08:51.99,0:08:55.00,Default,,0,0,0,,Кококкоккоко...ко!
Dialogue: 0,0:08:55.00,0:08:57.00,Default,,0,0,0,,Уау….
Dialogue: 0,0:08:57.00,0:09:00.10,Default,,0,0,0,,Сіз мені күтуге мәжбүр еттіңіз, Сью мырза.
Dialogue: 0,0:09:02.10,0:09:04.61,Default,,0,0,0,,Болашақ соншалықты жарқын болмайтын сияқты.➨
Dialogue: 0,0:09:04.61,0:09:06.61,Default,,0,0,0,,Сондықтан Сью менімен бірге... (үстелді түрту дыбысы)
Dialogue: 0,0:09:06.61,0:09:08.61,Default,,0,0,0,,Уа... ауызыңды жап.
Dialogue: 0,0:09:08.61,0:09:11.28,Default,,0,0,0,,Болашақ қандай болмақ! Маған енді бұл бәрібір!
Dialogue: 0,0:09:11.28,0:09:15.78,Default,,0,0,0,,Бірақ Сью, сен болашақта бірдеңе істеуге тырыстың.
Dialogue: 0,0:09:15.78,0:09:18.45,Default,,0,0,0,,Мен жай ғана алданып қалдым!
Dialogue: 0,0:09:18.45,0:09:20.46,Default,,0,0,0,,Мысық? ит? құс?
Dialogue: 0,0:09:20.46,0:09:22.46,Default,,0,0,0,,Қалағаныңды істе! (үстелді түрту дыбысы)
Dialogue: 0,0:09:22.46,0:09:27.80,Default,,0,0,0,,Маған жақсы көрінетін сөздерге алданып, алданып, сатқындық жасай бердім...
Dialogue: 0,0:09:27.80,0:09:30.63,Default,,0,0,0,,Бір кездері сен маған жасағандай. Уф...
Dialogue: 0,0:09:30.63,0:09:33.64,Default,,0,0,0,,Мен өзімнің ақымақтығымды жек көремін!
Dialogue: 0,0:09:33.64,0:09:36.47,Default,,0,0,0,,Өткенді ұмытқан менің кінәм болды.
Dialogue: 0,0:09:36.47,0:09:39.31,Default,,0,0,0,,Бірақ бұл мен биік жағаларды тым жақсы көретіндіктен...
Dialogue: 0,0:09:39.31,0:09:42.98,Default,,0,0,0,,Мен саған аузыңды жабуды айтып тұрмын! Аузыңды ашсаң биік жағалы жаға киесің ➨
Dialogue: 0,0:09:42.98,0:09:45.81,Default,,0,0,0,,Биік жағаның не екенін білмесем де!
Dialogue: 0,0:09:45.81,0:09:48.82,Default,,0,0,0,,Аа... Ештеңені ойламаңыз➨
Dialogue: 0,0:09:48.82,0:09:53.15,Default,,0,0,0,,Ол жай ғана айтып тұрған шығар. Оның несі қымбат? Бұл күлкілі.
Dialogue: 0,0:09:53.15,0:09:57.99,Default,,0,0,0,,Бұл жерде ақымақ ештеңе жоқ! Өйткені биік жаға – болашақ!
Dialogue: 0,0:09:57.99,0:10:01.33,Default,,0,0,0,,Болашақ? Жерде не...?
Dialogue: 0,0:10:01.33,0:10:05.00,Default,,0,0,0,,Сью мырза, сіз ұмыттыңыз ба? Эх...
Dialogue: 0,0:10:05.00,0:10:07.34,Default,,0,0,0,,⸨Үнзен: Бұл биік жаға ма?
Dialogue: 0,0:10:07.34,0:10:11.34,Default,,0,0,0,,Дұрыс, Жапонияны өзгертетін жаңа мәдениет пен ғылым➨
Dialogue: 0,0:10:11.34,0:10:14.34,Default,,0,0,0,,Бұл биік жаға.
Dialogue: 0,0:10:14.34,0:10:18.35,Default,,0,0,0,,Бұл сарайға, автокөліктерге және электр құрылғыларына да қатысты.
Dialogue: 0,0:10:18.35,0:10:20.85,Default,,0,0,0,,Шынымен! ? Ал болашақта➨
Dialogue: 0,0:10:20.85,0:10:24.85,Default,,0,0,0,,Сізді тағы да таңғажайып биік жағалар күтуде. Көңіліңіз көтеріңкі емес пе?
Dialogue: 0,0:10:24.85,0:10:30.02,Default,,0,0,0,,Болашақ керемет! Биік жағасы керемет...⸩
Dialogue: 0,0:10:30.02,0:10:33.53,Default,,0,0,0,,Бар болғаны... Мен үшін солай➨
Dialogue: 0,0:10:33.53,0:10:36.20,Default,,0,0,0,,Бұл өте қызықты және болашақ болды.
Dialogue: 0,0:10:36.20,0:10:38.20,Default,,0,0,0,,Сол себепті, өткен оқиғалар➨
Dialogue: 0,0:10:38.20,0:10:41.04,Default,,0,0,0,,Мен біраз ұмытшақ болып кеттім. аздап! ?
Dialogue: 0,0:10:41.04,0:10:43.54,Default,,0,0,0,,Кешіріңіз. жарық!
Dialogue: 0,0:10:43.54,0:10:47.38,Default,,0,0,0,,Сен мені қаншалықты қиналғанын білесің бе? ?
Dialogue: 0,0:10:47.38,0:10:49.38,Default,,0,0,0,,Мен сені Крипаға➨ шақырғанымда
Dialogue: 0,0:10:49.38,0:10:51.55,Default,,0,0,0,,Бұл есіме Сью мырза маған ашуланғанда түсті.
Dialogue: 0,0:10:51.55,0:10:53.88,Default,,0,0,0,,Бұл! Бұл не?
Dialogue: 0,0:10:53.88,0:10:55.88,Default,,0,0,0,,Бұл мен және Сью.
Dialogue: 0,0:10:55.88,0:10:59.89,Default,,0,0,0,,Бұл мен және сен бе? Бірақ неге мұндай нәрсе ...
Dialogue: 0,0:10:59.89,0:11:03.32,Default,,0,0,0,,Қазір! Мен түні бойы оны жасауға жұмсадым.
Dialogue: 0,0:11:03.32,0:11:05.83,Default,,0,0,0,,Қазіргі... Ха! ?
Dialogue: 0,0:11:05.83,0:11:10.00,Default,,0,0,0,,⸨Қайырлы таң Сью Сан, кешегі күн үшін кешірім сұраймын.
Dialogue: 0,0:11:10.00,0:11:13.17,Default,,0,0,0,,Сонымен...⸩
Dialogue: 0,0:11:13.17,0:11:16.00,Default,,0,0,0,,Мен мұның сол күннен бастап екеніне сене алмадым...
Dialogue: 0,0:11:16.00,0:11:19.17,Default,,0,0,0,,Мен саған айтқым келді, Сью.
Dialogue: 0,0:11:19.17,0:11:22.58,Default,,0,0,0,,Тіпті жоғары дәрежелі болашақта да біз бірге боламыз.
Dialogue: 0,0:11:25.35,0:11:27.85,Default,,0,0,0,,Бірдей...
Dialogue: 0,0:11:27.85,0:11:30.15,Default,,0,0,0,,Бүгінге дейін ұмытып кетсем де.
Dialogue: 0,0:11:33.19,0:11:35.36,Default,,0,0,0,,Хмф, мүлде емес...
Dialogue: 0,0:11:35.36,0:11:40.19,Default,,0,0,0,,Шинкуро, сен шынымен менімен өзімшіл ойнап жүрсің.
Dialogue: 0,0:11:40.19,0:11:42.36,Default,,0,0,0,,Сот….
Dialogue: 0,0:11:42.36,0:11:45.03,Default,,0,0,0,,Олай болса, оны бірге қорғаймыз ба?
Dialogue: 0,0:11:45.03,0:11:48.87,Default,,0,0,0,,Бәріміз бірге бөлісетін сол жарқын болашақ.
Dialogue: 0,0:11:48.87,0:11:50.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:52.87,0:11:54.88,Default,,0,0,0,,Ой~!
Dialogue: 0,0:11:54.88,0:11:56.88,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:11:56.88,0:11:59.21,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:11:59.21,0:12:03.32,Default,,0,0,0,,Барлығы жақсы ма? Сіз оны қайтадан сорып аласыз ба?
Dialogue: 0,0:12:03.32,0:12:08.32,Default,,0,0,0,,А, қазірдің өзінде ыстық! Қарғыс атқыр... Қандай әдемі шабуыл...
Dialogue: 0,0:12:08.32,0:12:11.16,Default,,0,0,0,,Анау төс етін жұлып жейсің бе?
Dialogue: 0,0:12:11.16,0:12:13.10,Default,,0,0,0,,Тауықтың шикі етін жеу қауіпті, Ушио.
Dialogue: 0,0:12:13.10,0:12:16.83,Default,,0,0,0,,Қарғыс атқыр, мен жіңішке сызықтан құтылдым...
Dialogue: 0,0:12:16.83,0:12:19.33,Default,,0,0,0,,Сіз қалыпты өмір сүрдіңіз, солай емес пе?
Dialogue: 0,0:12:19.33,0:12:21.50,Default,,0,0,0,,Бұл адам үшін өте жабысқақ.
Dialogue: 0,0:12:21.50,0:12:25.51,Default,,0,0,0,,Бірақ бас тартып, жаңа болашаққа көшетін кез келді!
Dialogue: 0,0:12:25.51,0:12:31.18,Default,,0,0,0,,Адамдар құстарды таңдайтын, табынатын және қызмет ететін жарқын және әдемі болашақ.
Dialogue: 0,0:12:31.18,0:12:33.18,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:12:33.18,0:12:36.08,Default,,0,0,0,,Маған мұндай бұлыңғыр болашақ керек емес!
Dialogue: 0,0:12:38.52,0:12:40.52,Default,,0,0,0,,(Думеки мен Унзенді шақыратын дауыс)
Dialogue: 0,0:12:40.52,0:12:42.86,Default,,0,0,0,,Жеңілген адам не істеу үшін келді?
Dialogue: 0,0:12:42.86,0:12:45.86,Default,,0,0,0,,Əрине сенің мазақ еткен қорлығыңның өшін аламын➨
Dialogue: 0,0:12:45.86,0:12:50.70,Default,,0,0,0,,аз нәрсе емес! не! ?
Dialogue: 0,0:12:50.70,0:12:53.70,Default,,0,0,0,,Біз айқындайтын нәрсе – болашақ! өйткені….
Dialogue: 0,0:12:53.70,0:12:56.87,Default,,0,0,0,,Болашағы биік!
Dialogue: 0,0:12:56.87,0:12:59.87,Default,,0,0,0,,Иә? Биік жаға – болашақ!
Dialogue: 0,0:12:59.87,0:13:02.81,Default,,0,0,0,,Бұлтты болашақты тазартыңыз!
Dialogue: 0,0:13:02.81,0:13:05.31,Default,,0,0,0,,Бұл биік жаға!
Dialogue: 0,0:13:05.31,0:13:07.65,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:07.65,0:13:10.99,Default,,0,0,0,,Түсінбейсіз бе? Шин Чанның айтқаны➨
Dialogue: 0,0:13:10.99,0:13:12.99,Default,,0,0,0,,Бұл көп нәрсені білдірмейді!
Dialogue: 0,0:13:12.99,0:13:15.82,Default,,0,0,0,,Мені үнемі осындай үлкен кісі итеріп жібереді...
Dialogue: 0,0:13:15.82,0:13:20.33,Default,,0,0,0,,Осындай ақымақ жағдайда ақымақ болу қызық.
Dialogue: 0,0:13:20.33,0:13:24.67,Default,,0,0,0,,Нуруру Мысық жақсы көретін еркіндік.
Dialogue: 0,0:13:24.67,0:13:29.00,Default,,0,0,0,,Мырза, мен сендім! Біз таңдаған адам күткендей!
Dialogue: 0,0:13:29.00,0:13:32.51,Default,,0,0,0,,Ю Самон... Сіздің адалдығыңызға рахмет.
Dialogue: 0,0:13:32.51,0:13:35.68,Default,,0,0,0,,Және Мастер Кан. Болады! ?
Dialogue: 0,0:13:35.68,0:13:37.85,Default,,0,0,0,,Екеуміз де өлтірілдік, бірақ...
Dialogue: 0,0:13:37.85,0:13:41.35,Default,,0,0,0,,Сонда да сіз айтып отырған идеал әдемі.
Dialogue: 0,0:13:41.35,0:13:43.35,Default,,0,0,0,,Мүмкін….
Dialogue: 0,0:13:43.35,0:13:47.36,Default,,0,0,0,,Кел, болашақты өзгертейік! (4 адам) О!
Dialogue: 0,0:13:47.36,0:13:50.02,Default,,0,0,0,,Біз Хикара романтикалық тобымыз!
Dialogue: 0,0:13:50.02,0:13:53.53,Default,,0,0,0,,Мен болашақты оңай өзгертемін!
Dialogue: 0,0:13:53.53,0:13:56.33,Default,,0,0,0,,Біз тәртіп пен тәртіп сақшыларымыз...
Dialogue: 0,0:14:00.03,0:14:03.47,Default,,0,0,0,,Хмф, маған қанша келсеңіз де, мені жеңе алмайсыз!
Dialogue: 0,0:14:03.47,0:14:05.97,Default,,0,0,0,,Әтеш! (Барлығы) Туу!
Dialogue: 0,0:14:08.48,0:14:12.31,Default,,0,0,0,,Не, аспан! ? Сізде ондай күш жоқ!
Dialogue: 0,0:14:12.31,0:14:14.32,Default,,0,0,0,,Биік жаға – еркіндік.
Dialogue: 0,0:14:14.32,0:14:16.65,Default,,0,0,0,,Бұл дәл қазір болашақ емес пе еді?
Dialogue: 0,0:14:16.65,0:14:19.99,Default,,0,0,0,,Біз қазіргі уақытта өмір сүріп жатырмыз, Шин Чан.
Dialogue: 0,0:14:19.99,0:14:25.33,Default,,0,0,0,,Мына менсінбей, мені менсінбей қарайсың! Мен өзімді сол денеммен құтқарамын!
Dialogue: 0,0:14:25.33,0:14:27.66,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:14:27.66,0:14:33.67,Default,,0,0,0,,♬～
Dialogue: 0,0:14:33.67,0:14:38.51,Default,,0,0,0,,Қорқақ еліктеу! Арнайы Tori Slugger!
Dialogue: 0,0:14:38.51,0:14:41.68,Default,,0,0,0,,Кеттік, Сью. Оны жина, Шинкуро.
Dialogue: 0,0:14:41.68,0:14:44.35,Default,,0,0,0,,Жүр!
Dialogue: 0,0:14:44.35,0:14:47.15,Default,,0,0,0,,Ақымақ... Арх!
Dialogue: 0,0:14:50.69,0:14:52.69,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:14:52.69,0:14:55.02,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:14:55.02,0:14:59.86,Default,,0,0,0,,Ақымақ адамдар, құстардан неге сонша бас тартасыңдар?
Dialogue: 0,0:14:59.86,0:15:02.30,Default,,0,0,0,,Олай болса, құстар сенің билеушілерің болатын болашақ➨
Dialogue: 0,0:15:02.30,0:15:04.47,Default,,0,0,0,,Көріңіз!
Dialogue: 0,0:15:04.47,0:15:06.47,Default,,0,0,0,,Күте тұрыңыз!Тоқта!
Dialogue: 0,0:15:06.47,0:15:12.77,Default,,0,0,0,,тым кеш! Қираған болашақпен қоштас, үміт келешегімен кел...
Dialogue: 0,0:15:16.98,0:15:19.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:19.15,0:15:21.65,Default,,0,0,0,,Неліктен радиотолқындар шығарылмайды? ?
Dialogue: 0,0:15:21.65,0:15:25.49,Default,,0,0,0,,Жабдық мінсіз, мысықтар мен иттерді жек көру энергиясы да жеткілікті!
Dialogue: 0,0:15:25.49,0:15:28.99,Default,,0,0,0,,Бірақ неге...? ?
Dialogue: 0,0:15:28.99,0:15:31.49,Default,,0,0,0,,Не болды! ?
Dialogue: 0,0:15:31.49,0:15:36.50,Default,,0,0,0,,Нуруру Сіз бір ғана қателік жібердіңіз.
Dialogue: 0,0:15:36.50,0:15:38.83,Default,,0,0,0,,Не! ?
Dialogue: 0,0:15:38.83,0:15:42.34,Default,,0,0,0,,Бұл адам Кян дала иті ме?
Dialogue: 0,0:15:42.34,0:15:45.34,Default,,0,0,0,,Болады! ? Бұған не болды?
Dialogue: 0,0:15:45.34,0:15:49.18,Default,,0,0,0,,Далалық ит ит емес.
Dialogue: 0,0:15:49.18,0:15:52.18,Default,,0,0,0,,Ол бір мектептің формасын киген екен.
Dialogue: 0,0:15:52.18,0:15:56.35,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:15:56.35,0:15:59.02,Default,,0,0,0,,Бұл не?! ?
Dialogue: 0,0:15:59.02,0:16:01.86,Default,,0,0,0,,Сондықтан энергия балансы бұзылады➨
Dialogue: 0,0:16:01.86,0:16:04.13,Default,,0,0,0,,Менің ойымша, бұл сәтсіз аяқталды.
Dialogue: 0,0:16:04.13,0:16:06.29,Default,,0,0,0,,Жоқ, бірақ аты ит! ?
Dialogue: 0,0:16:06.29,0:16:10.47,Default,,0,0,0,,Оның қабығы иттікіне ұқсайтындықтан осылай аталса керек➨
Dialogue: 0,0:16:10.47,0:16:13.13,Default,,0,0,0,,Бұл шын мәнінде тиін тұқымдасының мүшесі.
Dialogue: 0,0:16:13.13,0:16:15.47,Default,,0,0,0,,Киан ит емес еді...
Dialogue: 0,0:16:15.47,0:16:17.64,Default,,0,0,0,,Мастер мүмкін!
Dialogue: 0,0:16:17.64,0:16:21.81,Default,,0,0,0,,Құстардың көптен күткен тілегі осылай аяқтала ма?
Dialogue: 0,0:16:21.81,0:16:25.65,Default,,0,0,0,,Ақырында құс болашақта қайта сайланбайды...
Dialogue: 0,0:16:25.65,0:16:28.15,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:16:28.15,0:16:32.15,Default,,0,0,0,,Шақыру…. (жердің шуылдауы)
Dialogue: 0,0:16:32.15,0:16:36.66,Default,,0,0,0,,Бұл қысым... Бұл бір діріл.
Dialogue: 0,0:16:36.66,0:16:39.66,Default,,0,0,0,,Бұл құс мұнарасы сол адамның рухы шығар➨
Dialogue: 0,0:16:39.66,0:16:42.66,Default,,0,0,0,,Байланысты ма деп ойлаймын... Жер бетінде не болып жатыр ➨
Dialogue: 0,0:16:42.66,0:16:45.50,Default,,0,0,0,,Сіз оны құлаған жерге дейін итеріп жіберген болуыңыз керек.
Dialogue: 0,0:16:45.50,0:16:48.00,Default,,0,0,0,,Бұл жігіт шынымен жауапсыз!
Dialogue: 0,0:16:48.00,0:16:51.17,Default,,0,0,0,,Бұлай жалғаса берсе, мұнара құлап, қала...
Dialogue: 0,0:16:51.17,0:16:53.51,Default,,0,0,0,,Келесі орын – оңтүстік-оңтүстік-шығыс!
Dialogue: 0,0:16:53.51,0:16:55.51,Default,,0,0,0,,Биік жағамен мүмкін емес ештеңе жоқ!
Dialogue: 0,0:16:55.51,0:16:59.18,Default,,0,0,0,,Біз бұл қаланы және оның болашағын қорғаймыз!
Dialogue: 0,0:16:59.18,0:17:02.78,Default,,0,0,0,,Шинкуро... Хе, қарсылығым жоқ! (2 адам) Иә!
Dialogue: 0,0:17:02.78,0:17:04.95,Default,,0,0,0,,Соңына дейін шынымен стильді.
Dialogue: 0,0:17:04.95,0:17:08.79,Default,,0,0,0,,Ақыр аяғында, мұнша биік жағалы деген не? Ол әлі үлпілдек.
Dialogue: 0,0:17:08.79,0:17:13.63,Default,,0,0,0,,Бұл Шинкуро-сенпай. Жарайды, жасайық, Шинкун!
Dialogue: 0,0:17:13.63,0:17:18.63,Default,,0,0,0,,Бұлтты жүрек те, бұлтты аспан да ашық, ашық!
Dialogue: 0,0:17:18.63,0:17:20.64,Default,,0,0,0,,Бұл биік жаға!
Dialogue: 0,0:17:20.64,0:17:22.80,Default,,0,0,0,,Тұрсаң, сенде пион болады. Сіз отырсаңыз, сізде пион болады.
Dialogue: 0,0:17:22.80,0:17:24.97,Default,,0,0,0,,Қызыл жүзді биік жағалы бала➨
Dialogue: 0,0:17:24.97,0:17:27.64,Default,,0,0,0,,Жарқыраған қызыл жоғары түс!
Dialogue: 0,0:17:27.64,0:17:30.14,Default,,0,0,0,,Не! ? Ол кенеттен қосылды! ?
Dialogue: 0,0:17:30.14,0:17:32.81,Default,,0,0,0,,Бұл жоғары түстің күші ме? Жоқ, бұл тым ыңғайлы.
Dialogue: 0,0:17:32.81,0:17:37.99,Default,,0,0,0,,Бұл болашақты сақтайтын жоғары түсті пішін! Мен Кян туралы бірінші рет естідім.
Dialogue: 0,0:17:37.99,0:17:41.66,Default,,0,0,0,,Әдемі қасы, суы тамшылаған биік жағалы бала➨
Dialogue: 0,0:17:41.66,0:17:44.83,Default,,0,0,0,,Меланхолик теңіз флотының жоғары түсі!
Dialogue: 0,0:17:44.83,0:17:48.33,Default,,0,0,0,,Yamashisuimei Талғампаз және әдемі биік жағалы бала➨
Dialogue: 0,0:17:48.33,0:17:51.33,Default,,0,0,0,,Ностальгиялық жасыл жоғары түс!
Dialogue: 0,0:17:51.33,0:17:54.84,Default,,0,0,0,,Харуки Уки Табиғи материалдан жасалған биік жағалы бала➨
Dialogue: 0,0:17:54.84,0:17:57.34,Default,,0,0,0,,Қазіргі сары жоғары түс!
Dialogue: 0,0:17:57.34,0:18:00.84,Default,,0,0,0,,Шіденнің жарқылы, биік жағалы баланың жарқылы➨
Dialogue: 0,0:18:00.84,0:18:04.45,Default,,0,0,0,,Эмоциялық күлгін жоғары түс!
Dialogue: 0,0:18:04.45,0:18:09.95,Default,,0,0,0,,Күшті семсер Муракумо Хайкара!
Dialogue: 0,0:18:09.95,0:18:14.79,Default,,0,0,0,,Сегіз қырлы Рейрон айна Шинкейцу Жоғары түсті!
Dialogue: 0,0:18:14.79,0:18:19.79,Default,,0,0,0,,Құдайдың есептеуі жын моншақ Хасшаку Ционг Жоғары түсті!
Dialogue: 0,0:18:19.79,0:18:22.63,Default,,0,0,0,,Біз Super Hikara романтикалық тобымыз!
Dialogue: 0,0:18:22.63,0:18:34.31,Default,,0,0,0,,♬～
Dialogue: 0,0:18:34.31,0:18:40.15,Default,,0,0,0,,Жоғары жаға - биік жаға!
Dialogue: 0,0:18:40.15,0:18:43.05,Default,,0,0,0,,Ko! ? Коко!
Dialogue: 0,0:18:46.49,0:18:49.49,Default,,0,0,0,,Ах, қандай әдемі...
Dialogue: 0,0:19:03.94,0:19:06.77,Default,,0,0,0,,Мен қандай ақымақпын...
Dialogue: 0,0:19:06.77,0:19:10.44,Default,,0,0,0,,Мен ит пен мысық сияқты таңдалғым келді...
Dialogue: 0,0:19:10.44,0:19:12.78,Default,,0,0,0,,Бұл болды...
Dialogue: 0,0:19:12.78,0:19:15.12,Default,,0,0,0,,Болашақ қазір басталады.
Dialogue: 0,0:19:15.12,0:19:18.62,Default,,0,0,0,,Кян енді ит емес, дала иті болады➨
Dialogue: 0,0:19:18.62,0:19:21.96,Default,,0,0,0,,Лагер таңдау үшін барын салуда. Мен және басқалар➨
Dialogue: 0,0:19:21.96,0:19:26.46,Default,,0,0,0,,Өйткені мен жай ғана адамзат маған қамқор болатын өмір сүргім келеді➨
Dialogue: 0,0:19:26.46,0:19:29.96,Default,,0,0,0,,Барлық құстарға сәттілік тілеймін...
Dialogue: 0,0:19:29.96,0:19:31.97,Default,,0,0,0,,Балалар...
Dialogue: 0,0:19:31.97,0:19:34.47,Default,,0,0,0,,Сіз қателесесіз.
Dialogue: 0,0:19:34.47,0:19:39.14,Default,,0,0,0,,Құстарды ит пен мысық сияқты жақсы көреді.
Dialogue: 0,0:19:39.14,0:19:41.48,Default,,0,0,0,,Жоқ... иә.
Dialogue: 0,0:19:41.48,0:19:43.98,Default,,0,0,0,,Шындығында, ит пен мысықтан гөрі адамдарға қажет, солай емес пе?
Dialogue: 0,0:19:43.98,0:19:45.98,Default,,0,0,0,,《Тауық Нанбан…》
Dialogue: 0,0:19:45.98,0:19:49.15,Default,,0,0,0,,Әй, құстар болмаса, адамзаттың тіршілігіне қауіп төнер еді.
Dialogue: 0,0:19:49.15,0:19:51.15,Default,,0,0,0,,《Отбасы үшін қолайлы…》
Dialogue: 0,0:19:51.15,0:19:54.66,Default,,0,0,0,,Мен өзіме сенімдірек болғанын қалаймын. Негізі мен құстарды жақсы көремін.
Dialogue: 0,0:19:54.66,0:19:56.66,Default,,0,0,0,,《Аа, тауық мизутаки...》
Dialogue: 0,0:19:56.66,0:19:59.49,Default,,0,0,0,,Иә, біз сенсіз өмір сүре алмаймыз.
Dialogue: 0,0:19:59.49,0:20:01.50,Default,,0,0,0,,《Терияки тауық еті...》
Dialogue: 0,0:20:01.50,0:20:04.83,Default,,0,0,0,,Ол мені жеңе алмайды, бірақ мұқият қарасаңыз, ол үлпілдек және сүйкімді.
Dialogue: 0,0:20:04.83,0:20:06.83,Default,,0,0,0,,《Якитори…》
Dialogue: 0,0:20:06.83,0:20:08.84,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:20:08.84,0:20:10.84,Default,,0,0,0,,《Қуырылған тұтас...》
Dialogue: 0,0:20:10.84,0:20:13.17,Default,,0,0,0,,Қуырылған тауық еті сәнді және дәмді!
Dialogue: 0,0:20:13.17,0:20:15.34,Default,,0,0,0,,Хаха... Мен қатты айттым, балам.
Dialogue: 0,0:20:15.34,0:20:18.18,Default,,0,0,0,,Құстар керек және таңдалған.
Dialogue: 0,0:20:18.18,0:20:23.35,Default,,0,0,0,,Мен ешқашан мұндай бақытты болған емеспін! Рахмет, рахмет….
Dialogue: 0,0:20:23.35,0:20:26.52,Default,,0,0,0,,Біз адамдар алмастырылмасын➨
Dialogue: 0,0:20:26.52,0:20:29.19,Default,,0,0,0,,Мен барынша тырысуым керек. О, болашақ менің қолымда➨
Dialogue: 0,0:20:29.19,0:20:31.36,Default,,0,0,0,,Оны стильді етіп жасаңыз!
Dialogue: 0,0:20:31.36,0:20:33.69,Default,,0,0,0,,Қалай болғанда да, мәселе осы ма?
Dialogue: 0,0:20:33.69,0:20:38.03,Default,,0,0,0,,Ах. (Асо) Сен не істейсің? Бұл тесік.
Dialogue: 0,0:20:38.03,0:20:40.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.04,0:20:44.04,Default,,0,0,0,,Эх! ?
Dialogue: 0,0:20:46.21,0:20:48.21,Default,,0,0,0,,Рождество мерекесімен!
Dialogue: 0,0:20:48.21,0:20:51.71,Default,,0,0,0,,Куродама жатақханасынан ыстық бұлақ шығады деп ойламаппын.
Dialogue: 0,0:20:51.71,0:20:53.71,Default,,0,0,0,,Мына жігіттің жағасы биік!
Dialogue: 0,0:20:53.71,0:20:57.22,Default,,0,0,0,,Ашық аспан астындағы моншада шырша тойын өткізу де әдемі.
Dialogue: 0,0:20:57.22,0:21:00.22,Default,,0,0,0,,Бұл комбинация, ол жаман идея емес сияқты, бірақ...
Dialogue: 0,0:21:00.22,0:21:02.16,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:21:02.16,0:21:05.49,Default,,0,0,0,,Біз де жасай аламыз ба? Олар бір жатақханадан шығар.
Dialogue: 0,0:21:05.49,0:21:07.50,Default,,0,0,0,,Ұялмаңыз!
Dialogue: 0,0:21:09.50,0:21:12.00,Default,,0,0,0,,Дұрыс, Сью, бәріміз Рождествоны тойлайық➨
Dialogue: 0,0:21:12.00,0:21:14.00,Default,,0,0,0,,Сіз торт пен қуырылған тауық дедіңіз!
Dialogue: 0,0:21:14.00,0:21:16.30,Default,,0,0,0,,Бұл қуырылған тауық емес, күркетауық.
Dialogue: 0,0:21:18.84,0:21:21.01,Default,,0,0,0,,Бірақ... Иә, жақсы.
Dialogue: 0,0:21:21.01,0:21:23.51,Default,,0,0,0,,А, бұл өте дәмді!
Dialogue: 0,0:21:23.51,0:21:25.85,Default,,0,0,0,,Күтілгендей, қуырылған тауық еті ең жақсы, Раку-сан.
Dialogue: 0,0:21:25.85,0:21:28.85,Default,,0,0,0,,Құстарды ең жақсы деп атауға дейін барар ма едіңіз?
Dialogue: 0,0:21:28.85,0:21:31.85,Default,,0,0,0,,Рахмет сізге Шинкуро!
Dialogue: 0,0:21:31.85,0:21:35.02,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:21:35.02,0:21:40.36,Default,,0,0,0,,Әр адамның, әр құстың, әр мысықтың бақыты әртүрлі.
Dialogue: 0,0:21:40.36,0:21:43.20,Default,,0,0,0,,Сех! Хахаха….
Dialogue: 0,0:21:43.20,0:21:47.20,Default,,0,0,0,,Батыста Рождествода отынды торт ретінде жейтін көрінеді.
Dialogue: 0,0:21:47.20,0:21:50.87,Default,,0,0,0,,Отын керемет! Хахаха….
Dialogue: 0,0:21:50.87,0:21:54.38,Default,,0,0,0,,Готемба жатақханасының меңгерушісі, жер иесі Хаконе-санға үйленген➨
Dialogue: 0,0:21:54.38,0:21:57.55,Default,,0,0,0,,Бұл жерде қоғамдық монша ашпақшы.
Dialogue: 0,0:21:57.55,0:22:00.21,Default,,0,0,0,,Табиғи ыстық бұлақ суы үшін ағаш кесу керек пе?
Dialogue: 0,0:22:00.21,0:22:03.15,Default,,0,0,0,,Осы жағдайға қарамастан, болашақ қауіпсіз бе?
Dialogue: 0,0:22:03.15,0:22:06.49,Default,,0,0,0,,Осы орайда біз... алаңдаймыз.
Dialogue: 0,0:22:06.49,0:22:08.82,Default,,0,0,0,,Содан кейін, ең алдымен, тамақтануды тоқтатыңыз.
Dialogue: 0,0:22:08.82,0:22:12.13,Default,,0,0,0,,Жарайды, уайымдайтын ештеңе жоқ!
Dialogue: 0,0:22:15.00,0:22:18.67,Default,,0,0,0,,Ертеңгі күнді уайымдасаңыз да, бәрібір!
Dialogue: 0,0:22:18.67,0:22:21.17,Default,,0,0,0,,Өйткені болашақ...
